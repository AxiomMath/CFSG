private theorem Dg_bit_chk_0 : (List.finRange 8).all (fun j => (List.finRange 16).all fun v =>
    (List.finRange 4).all fun c =>
      decide ((Dg j v).val.testBit c.val =
        xor (xor (xor (Mj j c.val 0 && v.val.testBit 0) (Mj j c.val 1 && v.val.testBit 1))
          (Mj j c.val 2 && v.val.testBit 2)) (Mj j c.val 3 && v.val.testBit 3))) = true := by
  decide +kernel

private def forceN {α : Sort _} (y : ℕ) (k : ℕ → α) : α :=
  Nat.rec (motive := fun _ => α) (k 0) (fun n _ => k (Nat.succ n)) y

private theorem forceN_eq {α : Sort _} (y : ℕ) (k : ℕ → α) : forceN y k = k y := by
  cases y <;> rfl

private def xorS (a b : ℕ) : ℕ := forceN a fun a => forceN b fun b => a ^^^ b

private theorem xorS_eq (a b : ℕ) : xorS a b = a ^^^ b := by
  simp only [xorS, forceN_eq]

private def redFS (B : List (ℕ × ℕ)) (m : ℕ) : ℕ :=
  B.foldl (fun m pr => forceN m fun m => cond (m.testBit pr.1) (xorS m pr.2) m) m

private theorem redFS_eq : redFS = redF := by
  funext B m
  simp only [redFS, redF, forceN_eq, xorS_eq]

private def addRowS (B : List (ℕ × ℕ)) (e : ℕ) : List (ℕ × ℕ) :=
  forceN (redFS B e) fun r => cond (r == 0) B (forceN (Nat.log2 r) fun l =>
    (l, r) :: B.map fun pr => cond (pr.2.testBit l) (pr.1, xorS pr.2 r) pr)

private theorem addRowS_eq : addRowS = addRow := by
  funext B e
  simp only [addRowS, addRow, forceN_eq, xorS_eq, redFS_eq]

private def dFS (j k l : Fin 8) (c : ℕ) : ℕ :=
  xorS (xorS (xorS (tm (Mj j c 0) (2 ^ vi k.val l.val 0)) (tm (Mj j c 1) (2 ^ vi k.val l.val 1)))
    (tm (Mj j c 2) (2 ^ vi k.val l.val 2))) (tm (Mj j c 3) (2 ^ vi k.val l.val 3))

private def cocEqS (j k l : Fin 8) (c : ℕ) : ℕ :=
  xorS (xorS (xorS (2 ^ vi j.val k.val c) (2 ^ vi (mulIdx j k).val l.val c)) (dFS j k l c))
    (2 ^ vi j.val (mulIdx k l).val c)

private def cocEqsS : List ℕ :=
  ((List.finRange 8).flatMap fun j => (List.finRange 8).flatMap fun k =>
    (List.finRange 8).flatMap fun l => (List.finRange 4).map fun c => cocEqS j k l c.val) ++
  ((List.finRange 8).flatMap fun k => (List.finRange 4).flatMap fun c =>
    [2 ^ vi 0 k.val c.val, 2 ^ vi k.val 0 c.val])

private def forceL {β : Sort _} : List (ℕ × ℕ) → (List (ℕ × ℕ) → β) → β
  | [], k => k []
  | p :: l, k => forceN p.1 fun a => forceN p.2 fun b => forceL l fun l' => k ((a, b) :: l')

private theorem forceL_eq {β : Sort _} :
    ∀ (l : List (ℕ × ℕ)) (k : List (ℕ × ℕ) → β), forceL l k = k l
  | [], _ => rfl
  | p :: l, k => by
    rw [forceL, forceN_eq, forceN_eq, forceL_eq l]

private def basisGo : List ℕ → List (ℕ × ℕ) → List (ℕ × ℕ)
  | [], B => B
  | e :: E, B => forceL (addRowS B e) fun B' => basisGo E B'

private theorem basisGo_eq : ∀ (E : List ℕ) (B : List (ℕ × ℕ)), basisGo E B = E.foldl addRow B
  | [], _ => rfl
  | e :: E, B => by
    simp only [basisGo, forceL_eq, basisGo_eq E, addRowS_eq, List.foldl_cons]

private def cocBasisS : List (ℕ × ℕ) := basisGo cocEqsS []

private theorem cocBasisS_eq : cocBasisS = cocBasis := by
  simp only [cocBasisS, cocBasis, basisOf, basisGo_eq, cocEqsS, cocEqs, cocEqS, cocEq, dFS, dF,
    xorS_eq]

private def rhsFormS (c1 : Fin 8 → Fin 8 → Fin 16) (eF : ℕ) (bF : List ℕ) (j k : Fin 8)
    (c : ℕ) : ℕ :=
  xorS (xorS (xorS (tm ((c1 j k).val.testBit c) eF) (bF.getD (j.val * 4 + c) 0))
    (xorS (xorS (xorS (tm (Mj j c 0) (bF.getD (k.val * 4 + 0) 0))
      (tm (Mj j c 1) (bF.getD (k.val * 4 + 1) 0))) (tm (Mj j c 2) (bF.getD (k.val * 4 + 2) 0)))
      (tm (Mj j c 3) (bF.getD (k.val * 4 + 3) 0))))
    (bF.getD ((mulIdx j k).val * 4 + c) 0)

private def fsCheckB (B : List (ℕ × ℕ)) (c1 : Fin 8 → Fin 8 → Fin 16) (eF : ℕ) (bF : List ℕ) :
    Bool :=
  (List.finRange 8).all fun j => (List.finRange 8).all fun k => (List.finRange 4).all fun c =>
    redFS B (xorS (2 ^ vi j.val k.val c.val) (rhsFormS c1 eF bF j k c.val)) == 0

private def fsCheckS (c1 : Fin 8 → Fin 8 → Fin 16) (eF : ℕ) (bF : List ℕ) : Bool :=
  fsCheckB cocBasisS c1 eF bF

private theorem fsCheck_eq (c1 : Fin 8 → Fin 8 → Fin 16) (eF : ℕ) (bF : List ℕ) :
    fsCheck c1 eF bF = fsCheckS c1 eF bF := by
  simp only [fsCheckS, fsCheckB, fsCheck, rhsFormS, rhsForm, redFS_eq, cocBasisS_eq, xorS_eq]

