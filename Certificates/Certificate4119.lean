    ∧ (octE1.hypDCheck gR = true)
    ∧ (octE2.hypDCheck gR = true)
    ∧ (octE3.hypDCheck gR = true)
    ∧ (octE4.hypDCheck gR = true)
    ∧ ((xPow X 5 == 1 && X != 1) = true)
    ∧ ((hexE.Ns gR).contains X = true)
    ∧ ((octE1.Ns gR).contains X = true)
    ∧ ((octE2.Ns gR).contains X = true)
    ∧ ((octE3.Ns gR).contains X = true)
    ∧ ((octE4.Ns gR).contains X = true)
    ∧ (subgroupCheck gR pW pDepth 1024 = true)
    ∧ (conjClosed (enc m24a) (enc m24b) (enc m24a⁻¹) (enc m24b⁻¹) Iset = true)
    ∧ ((invSeeds Ps).all (fun x => Iset.contains x) = true)
    ∧ (Iset.toList.all (yCheck X (hexE.Es gR) (octE1.Es gR) (octE2.Es gR) (octE3.Es gR)
          (octE4.Es gR)) = true) := by
  have s0 := sp_of hexE kH
  have s1 := sp_of octE1 kO1
  have s2 := sp_of octE2 kO2
  have s3 := sp_of octE3 kO3
  have s4 := sp_of octE4 kO4
  have hV : hexE.hypVCheck gR omW = true := by
    open CFSG.KD.LQT.C4119hexE CFSG.KD.LQT.C4119x CFSG.KD.LQT.C4119w in
    have hw : wordEqK 24 (gl.map codeP) hexE.nW omN omW = true := by rw [hG]; exact oH
    have hω := mem_of_wordEq (by norm_num) gl hexE.nW omN omW hw
    have hv := imgV_sound (by norm_num) _ _ s0.le 13 _ hω (by rw [codes_of]; exact hE) (by
      rw [codes_of, codes_of, ← evalWK_codeP (by norm_num), hG]; exact vH)
    rw [hgR]
    exact hypV_of_img hexE gl s0 omW hω hv
  have hx0 : (xPow X 5 == 1 && X != 1) = true := by
    rw [X, hgR]
    exact x0_sound (by norm_num) gl xW (by rw [hG]; exact CFSG.KD.LQT.C4119x.x0)
  have hsub : subgroupCheck gR pW pDepth 1024 = true := by
    rw [hgR]
    exact sub_sound (by norm_num) gl pW pDepth 1024 (by rw [hG]; exact CFSG.KD.LQT.C4119x.sub)
      (by decide)
  open CFSG.KD.LQT.C4119x CFSG.KD.LQT.C4119w in
  exact ⟨kH, kO1, kO2, kO3, kO4, hV,
    hypD_of octE1 s1 _ _ eN_octE1 CFSG.KD.LQT.C4119img.C_octE1 CFSG.KD.LQT.C4119img.W_octE1 43
      rfl rfl rfl CFSG.KD.LQT.C4119octE1.hE e1 d1,
    hypD_of octE2 s2 _ _ eN_octE2 CFSG.KD.LQT.C4119img.C_octE2 CFSG.KD.LQT.C4119img.W_octE2 42
      rfl rfl rfl CFSG.KD.LQT.C4119octE2.hE e2 d2,
    hypD_of octE3 s3 _ _ eN_octE3 CFSG.KD.LQT.C4119img.C_octE3 CFSG.KD.LQT.C4119img.W_octE3 44
      rfl rfl rfl CFSG.KD.LQT.C4119octE3.hE e3 d3,
    hypD_of octE4 s4 _ _ eN_octE4 CFSG.KD.LQT.C4119img.C_octE4 CFSG.KD.LQT.C4119img.W_octE4 43
      rfl rfl rfl CFSG.KD.LQT.C4119octE4.hE e4 d4,
    hx0, xN_of hexE s0 xN_hexE _ rfl xH, xN_of octE1 s1 xN_octE1 _ rfl x1,
    xN_of octE2 s2 xN_octE2 _ rfl x2, xN_of octE3 s3 xN_octE3 _ rfl x3,
