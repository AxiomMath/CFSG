private theorem sp_of (c : ECert) (h : c.coreCheckT gR 244823040 = true) : SoundP c gl := by
  refine soundP c gl ?_
  rw [hgR] at h
  simp only [ECert.coreCheckT, Bool.and_eq_true] at h
  simp only [h.1.1.1, h.1.1.2, Bool.and_self]

private theorem xN_of (c : ECert) (hs : SoundP c gl) (w : List ℕ) (nWL : List (List ℕ))
    (hn : c.nW = nWL) (h : wordEqK 24 GL nWL w CFSG.KD.LQT.C4119w.xWL = true) :
    (c.Ns gR).contains X = true := by
  have hw : wordEqK 24 (gl.map codeP) c.nW w xW = true := by rw [hG, hn]; exact h
  have hX : X = RN.enc (evalW gl xW) := by
    rw [X, hgR]
    exact (enc_evalW (rawIsEnc 24) gl xW).symm
  rw [hX, hgR, Std.HashSet.contains_iff_mem]
  exact (hs.memN _).1 (mem_of_wordEq (by norm_num) gl c.nW w xW hw)

private theorem codes_of (ws : List (List ℕ)) :
