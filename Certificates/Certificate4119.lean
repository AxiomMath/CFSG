private theorem hypD_of (c : ECert) (hs : SoundP c gl) (eWL nWL : List (List ℕ))
    (eN : List (List ℕ)) (C : List Lvl) (W : List (List (List ℕ))) (d : ℕ) (he : c.eW = eWL)
    (hn : c.nW = nWL) (ho : c.nOrd = 322560)
    (hE : CFSG.KC.LQT.Syl.eK 24 (eWL.map (evalWK 24 GL)) = true)
    (hw : allZ eWL eN (fun v w => wordEqK 24 GL nWL w v) = true)
    (hi : imgCK 24 (eWL.map (evalWK 24 GL)) (nWL.map (evalWK 24 GL)) C W d 20160 = true) :
    c.hypDCheck gR = true := by
  have hEN : Subgroup.closure {g | g ∈ c.eW.map (evalW gl)} ≤
      Subgroup.closure {g | g ∈ c.nW.map (evalW gl)} := by
    rw [Subgroup.closure_le]
    intro g hg
    obtain ⟨v, hv, rfl⟩ := List.mem_map.1 hg
    rw [he] at hv
    obtain ⟨w, -, hvw⟩ := allZ_spec hw v hv
    have hvw' : wordEqK 24 (gl.map codeP) c.nW w v = true := by rw [hG, hn]; exact hvw
    exact mem_of_wordEq (by norm_num) gl c.nW w v hvw'
  have hcard : Nat.card (conjHom _ _ hs.le).range = 20160 := by
    refine imgD_sound (by norm_num) _ _ hs.le C W d 20160 ?_ ?_
    · rw [codes_of, he]; exact hE
    · rw [codes_of, codes_of, he, hn]; exact hi
  rw [hgR]
  exact hypD_of_card c gl hs hEN (by rw [hcard, ho]) (by rw [ho])

