  have h := iset_sound (by norm_num) gl ((m24a : _) : Perm (Fin 24)) ((m24b : _) : Perm (Fin 24))
    ((m24a⁻¹ : _) : Perm (Fin 24)) ((m24b⁻¹ : _) : Perm (Fin 24)) pW pDepth 30 xW hexE octE1 octE2
