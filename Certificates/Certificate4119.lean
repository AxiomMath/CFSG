    [El_hexE, El_octE1, El_octE2, El_octE3, El_octE4] S chs hss (by rw [hG]; exact es)
    (by rw [hG]; exact pre) inS rfl (by
      obtain ⟨c0, c1, c2, c3⟩ := codes4
      rw [c0, c1, c2, c3, hG]
      intro j hj
