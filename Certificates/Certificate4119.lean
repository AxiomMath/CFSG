theorem certificate4119 : (hexE.coreCheckT gR 244823040 = true)
    ∧ (octE1.coreCheckT gR 244823040 = true)
    ∧ (octE2.coreCheckT gR 244823040 = true)
    ∧ (octE3.coreCheckT gR 244823040 = true)
