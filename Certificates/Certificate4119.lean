private theorem core_of (c : ECert) (eWL nWL : List (List ℕ)) (rTL : List ℕ) (C : List Lvl)
    (W : List (List (List ℕ))) (d nOrd : ℕ) (cs : List Char) (he : c.eW = eWL)
    (hn : c.nW = nWL) (hr : c.rT = parseNats (String.ofList cs)) (hd : c.depth = d)
    (ho : c.nOrd = nOrd) (hR : CFSG.KC.LQT.NP.natsOK cs rTL = true)
    (hE : CFSG.KC.LQT.Syl.eK 24 (eWL.map (evalWK 24 GL)) = true) (hC : chainOK 24 C = true)
    (hI : chainInj 24 C = true)
    (hP : CFSG.KC.LQT.P.allL (nWL.map (evalWK 24 GL)) (CFSG.KC.LQT.P.permK 24) = true)
    (hS : CFSG.KC.LQT.PH.grpS 24 C (chainF C) (nWL.map (evalWK 24 GL)) W d = true)
    (hL : chainF C = nOrd)
    (hN : CFSG.KC.LQT.Syl.normK 24 (eWL.map (evalWK 24 GL)) (nWL.map (evalWK 24 GL)) = true)
    (hO : CFSG.KC.LQT.Syl.orbN 24 GL (eWL.map (evalWK 24 GL)) rTL nOrd 244823040 = true) :
    c.coreCheckT gR 244823040 = true := by
  have hrT : c.rT = rTL := by rw [hr]; exact CFSG.KC.LQT.NP.nats_sound cs rTL hR
  rw [hgR]
  refine CFSG.KC.LQT.Syl.coreR_sound gl hG c 244823040 C W ?_ hC hI ?_ ?_ ?_ ?_
  · rw [he]; exact hE
  · rw [hn, hd]; exact CFSG.KC.LQT.PH.grpS_imp (by norm_num) hC hP hS
  · rw [ho]; exact hL
  · rw [he, hn]; exact hN
  · rw [he, hrT, ho]; exact hO

