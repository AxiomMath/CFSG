@[expose] noncomputable def repCode (i : Nat) : Nat :=
  Nat.land (Nat.shiftRight invRepT (Nat.mul 9 i)) 511

@[expose] noncomputable def chk : Bool :=
  (List.range 512).all fun c => !(mulS c c == 0 && c != 0) ||
    (decide ((witL.getD c (0, 0)).1 < 9) && decide ((witL.getD c (0, 0)).2 < 512) &&
      mulS (mulS (invK (witL.getD c (0, 0)).2) c) (witL.getD c (0, 0)).2 ==
        repCode (witL.getD c (0, 0)).1)

set_option maxRecDepth 100000 in
theorem chk_ok : chk = true := by decide +kernel

theorem conjRep : ∀ s : SE, s * s = 1 → s ≠ 1 → ∃ i : Fin 9, ∃ g : SE, g⁻¹ * s * g = SE.invRep i := by
  intro s hs hne
  have hc := List.all_eq_true.1 chk_ok s.enc (List.mem_range.2 (SE.enc_lt s))
  have h1 : mulS s.enc s.enc = 0 := by rw [← enc_mulS, hs, enc_one]
  have h2 : s.enc ≠ 0 := fun h => hne (enc_inj (h.trans enc_one.symm))
  have hab : (mulS s.enc s.enc == 0 && s.enc != 0) = true := by simp [h1, h2]
  rw [hab, Bool.not_true, Bool.false_or] at hc
  simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hc
  obtain ⟨⟨hi, hd⟩, he⟩ := hc
  refine ⟨⟨(witL.getD s.enc (0, 0)).1, hi⟩, SE.dec (witL.getD s.enc (0, 0)).2, ?_⟩
  rw [se_eq_iff, enc_mulS, enc_mulS, enc_inv, enc_dec, Nat.mod_eq_of_lt hd, enc_invRep]
  exact he

end C22600

open CFSG.ComponentClassification.GHarris.SCert in
theorem check22600 : (∀ s : SE, s * s = 1 → s ≠ 1 → ∃ i : Fin 9, ∃ g : SE, g⁻¹ * s * g = SE.invRep i)
    ∧ (∀ i j : Fin 9, ∀ g : SE, g⁻¹ * SE.invRep i * g = SE.invRep j → i = j)
    ∧ (∀ s : SE, (∀ g : SE, g * s = s * g) → s = 1 ∨ s = SE.gen 0) := by
  refine ⟨C22600.conjRep, ?_⟩
  repeat' apply And.intro
  all_goals
    simp only [CFSG.KC.GHFus.forall_se, CFSG.KC.GHFus.exists_se, Fin.forall_iff, Fin.exists_iff,
      SE.O4E, SE.O4F, SE.commZ, SE.comm, CFSG.KC.GHFus.se_eq_iff, CFSG.KC.GHFus.predE_iff,
      CFSG.KC.GHFus.predF_iff, CFSG.KC.GHFus.enc_mulS, CFSG.KC.GHFus.enc_inv,
      CFSG.KC.GHFus.enc_dec, CFSG.KC.GHFus.enc_one, CFSG.KC.GHFus.enc_invRep,
      CFSG.KC.GHFus.enc_gen0, ne_eq]
    decide +kernel

