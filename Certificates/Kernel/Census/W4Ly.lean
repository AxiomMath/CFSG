variable {V : Type} (O : Ops Nat V)

noncomputable def runD : List Op → List Nat → List Nat
  | [], R => R
  | .mul i j t :: p, R => runD p (R.set t (O.mul (getN R i) (getN R j)))
  | .pow e i t :: p, R => runD p (R.set t (powN O (Nat.succ e) (getN R i) e))

theorem lyForceB_eq (y : Nat) (k : Nat → Bool) : forceB y k = k y := by
  cases y <;> rfl

theorem lyForceL_eq (xs : List Nat) (k : List Nat → Bool) : forceL xs k = k xs := by
  induction xs generalizing k with
  | nil => rfl
  | cons x xs ih =>
    change forceB x (fun x' => forceL xs (fun l => k (x' :: l))) = _
    rw [lyForceB_eq, ih]

theorem runN_eq_runD (prog : List Op) (R : List Nat) (k : List Nat → Bool) :
    runN O prog R k = k (runD O prog R) := by
  induction prog generalizing R with
  | nil => rfl
  | cons op p ih =>
    cases op with
    | mul i j t =>
      change forceB (O.mul (getN R i) (getN R j)) (fun a => forceL (R.set t a)
        (fun R' => runN O p R' k)) = _
      rw [lyForceB_eq, lyForceL_eq, ih]
      rfl
    | pow e i t =>
      change forceB (powN O (Nat.succ e) (getN R i) e) (fun a => forceL (R.set t a)
        (fun R' => runN O p R' k)) = _
      rw [lyForceB_eq, lyForceL_eq, ih]
      rfl

theorem w4N_of_vals (A B : Nat) (D : Data) (inv : Nat) (xsL : List Nat) (TL : Nat)
    (hx : D.outs.map (getN (runD O D.prog (initN O A B D.nregs))) = xsL)
    (hT : getN (runD O D.prog (initN O A B D.nregs)) inv = TL) :
    w4N O A B D inv = (decide (2 ≤ D.nregs) && D.prog.all (Op.lt D.nregs) &&
      D.outs.all (decide <| · < D.nregs) && decide (inv < D.nregs) && w4OK O D.tests xsL TL) := by
  unfold w4N regsN
  rw [runN_eq_runD, lyForceL_eq, lyForceB_eq, hx, hT]

@[expose] def lyOpReads : Op → List Nat
  | .mul i j _ => [i, j]
  | .pow _ i _ => [i]

@[expose] def lyOpDst : Op → Nat
  | .mul _ _ t => t
  | .pow _ _ t => t

@[expose] def lyClosedP (S : List Nat) : List Op → Bool
  | [] => true
  | op :: q => (lyOpReads op).all (fun i => S.contains i) && lyClosedP (lyOpDst op :: S) q

def LyAgree (S : List Nat) (R R' : List Nat) : Prop :=
  R.length = R'.length ∧ ∀ i ∈ S, getN R i = getN R' i

theorem lyGetN_set (R : List Nat) (t a i : Nat) :
    getN (R.set t a) i = if t = i then (if i < R.length then a else 0) else getN R i := by
  simp only [getN, List.getD_eq_getElem?_getD, List.getElem?_set]
  by_cases hti : t = i
  · subst hti
    by_cases hl : t < R.length <;> simp [hl]
  · simp [hti]

theorem agree_set {S : List Nat} {R R' : List Nat} (h : LyAgree S R R') (t a : Nat) :
    LyAgree (t :: S) (R.set t a) (R'.set t a) := by
  refine ⟨by simp [h.1], fun i hi => ?_⟩
  rw [lyGetN_set, lyGetN_set, h.1]
  by_cases hti : t = i
  · simp [hti]
  · simp only [hti, ite_false]
    exact h.2 i ((List.mem_cons.1 hi).resolve_left (Ne.symm hti))

theorem agree_mono {S S' : List Nat} {R R' : List Nat} (h : LyAgree S R R')
    (hs : ∀ i ∈ S', i ∈ S) : LyAgree S' R R' :=
  ⟨h.1, fun i hi => h.2 i (hs i hi)⟩

theorem runD_agree (q : List Op) : ∀ (S R R' : List Nat), lyClosedP S q = true → LyAgree S R R' →
    LyAgree (S ++ q.map lyOpDst) (runD O q R) (runD O q R') := by
  induction q with
  | nil => intro S R R' _ h; simpa [runD] using h
  | cons op q ih =>
    intro S R R' hc h
    simp only [lyClosedP, Bool.and_eq_true, List.all_eq_true] at hc
    obtain ⟨hr, hc⟩ := hc
    have key : ∀ a, LyAgree (S ++ (op :: q).map lyOpDst) (runD O q (R.set (lyOpDst op) a))
        (runD O q (R'.set (lyOpDst op) a)) := fun a =>
      agree_mono (ih (lyOpDst op :: S) _ _ hc (agree_set h (lyOpDst op) a))
        (fun i hi => by simp at hi ⊢; tauto)
    have hS : ∀ i ∈ lyOpReads op, getN R i = getN R' i := fun i hi =>
      h.2 i (by simpa using hr i hi)
    cases op with
    | mul i j t =>
      have hi := hS i (by simp [lyOpReads])
      have hj := hS j (by simp [lyOpReads])
      simp only [runD, hi, hj]
      exact key _
    | pow e i t =>
      have hi := hS i (by simp [lyOpReads])
      simp only [runD, hi]
      exact key _

@[expose] noncomputable def agreeB (S R R' : List Nat) : Bool :=
  Nat.beq R.length R'.length && S.all fun i => Nat.beq (getN R i) (getN R' i)

theorem agree_of_agreeB {S R R' : List Nat} (h : agreeB S R R' = true) : LyAgree S R R' := by
  simp only [agreeB, Bool.and_eq_true, List.all_eq_true, Nat.beq_eq] at h
  exact h

theorem runD_append (p q : List Op) (R : List Nat) :
    runD O (p ++ q) R = runD O q (runD O p R) := by
  induction p generalizing R with
  | nil => rfl
  | cons op p ih => cases op <;> exact ih _

theorem agree_chunk (p q : List Op) (S S' cutR0 R Rn : List Nat) (h : LyAgree S (runD O p cutR0) R)
    (hc : lyClosedP S q = true) (hk : runN O q R (fun R' => agreeB S' R' Rn) = true)
    (hs : (S'.all fun i => (S ++ q.map lyOpDst).contains i) = true) :
    LyAgree S' (runD O (p ++ q) cutR0) Rn := by
  rw [runN_eq_runD] at hk
  have a1 := runD_agree O q S _ R hc h
  have a2 := agree_of_agreeB hk
  simp only [List.all_eq_true, List.contains_iff_mem] at hs
  rw [runD_append]
  exact ⟨a1.1.trans a2.1, fun i hi => (a1.2 i (hs i hi)).trans (a2.2 i hi)⟩

end

