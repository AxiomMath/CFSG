theorem lyRegs_eq (r : Nat) (hr : r ∈ cutS6) :
    getN (runD (opsFpK 5 12 1332 111 8 L H CM RM ONE) lyW3.base.prog (initN (opsFpK 5 12 1332 111 8 L H CM RM ONE) LyBS.A LyBS.B 497)) r = getN cutR6 r := by
