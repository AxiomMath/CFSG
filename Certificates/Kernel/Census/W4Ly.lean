theorem outs_eq : lyW3.base.outs.map (getN (runD (opsFpK 5 12 1332 111 8 L H CM RM ONE) lyW3.base.prog (initN (opsFpK 5 12 1332 111 8 L H CM RM ONE) LyBS.A LyBS.B 497))) =
    [getN cutR6 247, getN cutR6 383, getN cutR6 496] := by
  have ho : lyW3.base.outs = [247, 383, 496] := rfl
  rw [ho, List.map_cons, List.map_cons, List.map_cons, List.map_nil,
    lyRegs_eq 247 (by simp [cutS6]), lyRegs_eq 383 (by simp [cutS6]), lyRegs_eq 496 (by simp [cutS6])]

theorem ly_K : w4N (opsFpK 5 12 1332 111 8 L H CM RM ONE) LyBS.A LyBS.B lyW3.base lyW3.inv =
    true := by
  rw [w4N_of_vals (opsFpK 5 12 1332 111 8 L H CM RM ONE) LyBS.A LyBS.B lyW3.base lyW3.inv _ _ outs_eq (lyRegs_eq 22 (by simp [cutS6]))]
  quickRfl

def lyRep : Data := { lyW3.base with outs := [247, 247, 496] }

theorem ly_neg : (!w4N (opsFpK 5 12 1332 111 8 L H CM RM ONE) LyBS.A LyBS.B lyRep lyW3.inv) =
    true := by
  have hx : lyRep.outs.map (getN (runD (opsFpK 5 12 1332 111 8 L H CM RM ONE) lyRep.prog (initN (opsFpK 5 12 1332 111 8 L H CM RM ONE) LyBS.A LyBS.B lyRep.nregs))) =
      [getN cutR6 247, getN cutR6 247, getN cutR6 496] := by
    have ho : lyRep.outs = [247, 247, 496] := rfl
    have hp : lyRep.prog = lyW3.base.prog := rfl
    have hn : lyRep.nregs = 497 := rfl
    rw [ho, hp, hn, List.map_cons, List.map_cons, List.map_cons, List.map_nil,
      lyRegs_eq 247 (by simp [cutS6]), lyRegs_eq 496 (by simp [cutS6])]
  have hT : getN (runD (opsFpK 5 12 1332 111 8 L H CM RM ONE) lyRep.prog (initN (opsFpK 5 12 1332 111 8 L H CM RM ONE) LyBS.A LyBS.B lyRep.nregs)) lyW3.inv =
      getN cutR6 22 := lyRegs_eq 22 (by simp [cutS6])
  rw [w4N_of_vals (opsFpK 5 12 1332 111 8 L H CM RM ONE) LyBS.A LyBS.B lyRep lyW3.inv _ _ hx hT]
  quickRfl

theorem ly_neg_inv : (!w4N (opsFpK 5 12 1332 111 8 L H CM RM ONE) LyBS.A LyBS.B lyW3.base 247) =
    true := by
  rw [w4N_of_vals (opsFpK 5 12 1332 111 8 L H CM RM ONE) LyBS.A LyBS.B lyW3.base 247 _ _ outs_eq (lyRegs_eq 247 (by simp [cutS6]))]
  quickRfl

