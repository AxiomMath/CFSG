theorem consts : constsOK 3 6 36 (3 + 3) 3 L H CM RM ONE LV HV = true := by decide +kernel

theorem gens_valid : ∀ j < 3, validM 3 ((3 + 3) * 36) L H (gk j) = true := by decide +kernel

noncomputable def Jm : Matrix (Fin (3 + 3)) (Fin (3 + 3)) (ZMod 3) :=
  Matrix.of fun i j => if i.val + 3 = j.val then -1 else if j.val + 3 = i.val then 1 else 0

theorem JFin_eq : JFin 3 (ZMod 3) = Jm := by
  ext i j
  rw [JFin_apply_p]
  rfl

theorem gens_sympl_m : ∀ j < 3,
    (ordMat 3 (3 + 3) 6 36 (gk j))ᵀ * Jm * ordMat 3 (3 + 3) 6 36 (gk j) = Jm := by
  decide +kernel

theorem gens_sympl (j : ℕ) (hj : j < 3) :
    (ordMat 3 (3 + 3) 6 36 (gk j))ᵀ * JFin 3 (ZMod 3) * ordMat 3 (3 + 3) 6 36 (gk j) =
      JFin 3 (ZMod 3) := by
  rw [JFin_eq]
  exact gens_sympl_m j hj

noncomputable def gS (j : ℕ) : SpJP 3 3 :=
  if h : j < 3 then (exists_of_symplP (p := 3) (r := 3) (gens_sympl j h)).choose else 1

theorem gens_spec : ∀ j < 3, validM 3 ((3 + 3) * 36) L H (gk j) = true ∧
    ordMat 3 (3 + 3) 6 36 (gk j) = matJP 3 3 (gS j) := by
  intro j hj
  refine ⟨gens_valid j hj, ?_⟩
  unfold gS
  rw [dif_pos hj, (exists_of_symplP (p := 3) (r := 3) (gens_sympl j hj)).choose_spec]

