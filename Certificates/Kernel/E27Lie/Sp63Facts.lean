  have hfac : (Nat.card (SpJP 3 3)).factorization 3 = 9 :=
    factorization_three_of_eq card_spJP_three (by norm_num)
  exact sylow_of (G := SpJP 3 3) (n := 19683) consts rfl (matJP_injective 3 3) gens_spec
    (fun i hi => ((CFSG.KS.bAnd_iff _ _).1 (hb i hi)).1)
    (fun i hi j hj => CFSG.KS.allN_spec ((CFSG.KS.bAnd_iff _ _).1 (hb i hi)).2 j hj)
