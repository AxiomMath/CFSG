theorem t1_eq :
    T1 = (List.range (rcnt (PJ2.LR 1))).map (trK 315 (Nat.mul 315 9) PJ2.LR PJ2.TR 1) := by
  have h1 : Nat.beq (rcnt (PJ2.LR 1)) 160 = true := by quickRfl
  have hl' : T1.length = 160 := Nat.eq_of_beq_eq_true t1len
  rw [Nat.eq_of_beq_eq_true h1]
  refine List.ext_getElem (by rw [hl', List.length_map, List.length_range]) fun k hk _ => ?_
  have e := Nat.eq_of_beq_eq_true (allN_spec t1ok k (hl' ▸ hk))
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hk, Option.getD_some] at e
  rw [List.getElem_map, List.getElem_range]
  exact e

@[expose] noncomputable def foldT (L : List Nat) (f : Nat → Nat → Nat) (s : Nat) : Nat :=
  List.rec (motive := fun _ => Nat → Nat) (fun s => s) (fun t _ ih s => strictN (f t s) ih) L s

@[expose] noncomputable def cntM (n w : Nat) (LR TR : Nat → Nat) (bs T1 : List Nat) (x0 x1 : Nat)
    (k0 : Nat) : Nat :=
  strictN (Nat.mul n w) (fun nw => strictN (List.headD bs 0) (fun b0 =>
  strictN (trK n nw LR TR 0 k0) (fun t0 => strictN (pg w (mask w) t0 b0) (fun a =>
  foldUp (rcnt (LR 2)) (fun k2 s => strictN (trK n nw LR TR 2 k2) (fun t2 =>
    strictN (pg w (mask w) t2 a) (fun e =>
    foldT T1 (fun t1 s =>
      strictN (evRK w [t1, t0] e) (fun a2 =>
      stepM 1099511627776 1152922604118474752 1208925819614629174706176
        1267651809154049016125877911552
        (bAnd(Nat.beq a2 b0, ordB0 w bs [t2, t1, t0] 2))
        (bAnd(Nat.beq (evRK w [t2, t1, t0] a2) b0, ordB0 w bs [t2, t1, t0] 3))
        (condsJ w bs x0 t2 t1 t0) (condsJ w bs x1 t2 t1 t0) s)) s)))
    (nat_lit 0)))))

