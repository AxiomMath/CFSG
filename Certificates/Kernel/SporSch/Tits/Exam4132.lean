@[expose] noncomputable def fP : Nat :=
  pc (pc (pc (pc (pc (TitsD.S 0) (TitsD.S 1)) (TitsD.S 1)) (TitsD.S 1)) (TitsD.S 0)) (TitsD.S 0)

@[expose] noncomputable def fIP : Nat :=
  pc (pc (pc (pc (pc (TitsD.SI 0) (TitsD.SI 0)) (TitsD.SI 1)) (TitsD.SI 1)) (TitsD.SI 1))
    (TitsD.SI 0)

theorem fI : invEqK 1755 11 (mask 11) (1755 * 11) fP fIP = true := by quickRfl
theorem wK : Nat.beq (pc (pc fP TitsZ) fIP) TitsEW = true := by quickRfl

theorem cf : C fP := cc (cc (cc (cc (cc s0 s1) s1) s1) s0) s0
theorem cfi : C fIP := cc (cc (cc (cc (cc i0 i0) i1) i1) i1) i0

theorem f_eq : conjFArr = unpack 1755 11 fP := by
  unfold conjFArr conjD1 conjD0
  rw [der_eq (j := 0) (by norm_num), der_eq (j := 1) (by norm_num), cu s0 s1, cu (cc s0 s1) s1,
    cu (cc (cc s0 s1) s1) s1, cu (cc (cc (cc s0 s1) s1) s1) s0,
    cu (cc (cc (cc (cc s0 s1) s1) s1) s0) s0]
  rfl

theorem fi_eq : conjFInvArr = unpack 1755 11 fIP := by
  unfold conjFInvArr
  rw [f_eq]
  exact (invEqK_sound fI).1

theorem w_eq : conjWArr = unpack 1755 11 TitsEW := by
  unfold conjWArr
  rw [fi_eq, f_eq, z_eq, cu cf canonZ, cu (cc cf canonZ) cfi, Nat.eq_of_beq_eq_true wK]

theorem cw : C TitsEW := by quickRfl

theorem sw : siftK 1755 11 (mask 11) (1755 * 11) (pidn 1755 11) TitsS.LR TitsS.TRI TitsS.BP 5 0
    TitsEW = true := by quickRfl
theorem pwx : Nat.beq (pg 11 (mask 11) (pc TitsEW TitsQX) 12) 78 = true := by quickRfl
theorem pxw : Nat.beq (pg 11 (mask 11) (pc TitsQX TitsEW) 12) 101 = true := by quickRfl
theorem pwy : Nat.beq (pg 11 (mask 11) (pc TitsEW TitsQY) 12) 38 = true := by quickRfl
theorem pyw : Nat.beq (pg 11 (mask 11) (pc TitsQY TitsEW) 12) 34 = true := by quickRfl

theorem facts : isInvA 1755 conjFArr conjFInvArr = true ∧
    siftA 1755 titsSLevels (baseArr 1755 titsSBase) 0 conjWArr = true ∧
    (compA 1755 conjWArr conjXArr)[12]! = 78 ∧ (compA 1755 conjXArr conjWArr)[12]! = 101 ∧
    (compA 1755 conjWArr conjYArr)[12]! = 38 ∧ (compA 1755 conjYArr conjWArr)[12]! = 34 := by
  refine ⟨?_, siftK_sound bindsS permS TitsS.hl w_eq (range_of_canonK cw) sw, ?_, ?_, ?_, ?_⟩
  · rw [fi_eq, f_eq]
    exact (invEqK_sound fI).2
  · rw [w_eq, x_eq, cu cw cx, unpack_get (by norm_num)]
    exact Nat.eq_of_beq_eq_true pwx
  · rw [w_eq, x_eq, cu cx cw, unpack_get (by norm_num)]
    exact Nat.eq_of_beq_eq_true pxw
  · rw [w_eq, y_eq, cu cw cy, unpack_get (by norm_num)]
    exact Nat.eq_of_beq_eq_true pwy
  · rw [w_eq, y_eq, cu cy cw, unpack_get (by norm_num)]
    exact Nat.eq_of_beq_eq_true pyw

