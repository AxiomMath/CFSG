theorem lane_of_shift {P w m n i : Nat} (hP : Nat.shiftRight P (Nat.mul w n) = 0) (hi : n ≤ i) :
    lane P w m i = 0 := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hi
  change (P >>> (w * (n + k))) &&& m = 0
  change P >>> (w * n) = 0 at hP
  rw [Nat.mul_add, Nat.shiftRight_add, hP, Nat.zero_shiftRight, Nat.zero_and]

theorem lane_zero (w m i : Nat) : lane 0 w m i = 0 := by
  change (0 >>> (w * i)) &&& m = 0
  rw [Nat.zero_shiftRight, Nat.zero_and]

theorem arr_get {α : Type} [Inhabited α] [BEq α] [LawfulBEq α] {a : Array α} {f : Nat → α} {n : Nat}
    (h : (a.toList == (List.range n).map f) = true) (hf : ∀ i, n ≤ i → f i = default) (i : Nat) :
    a[i]! = f i := by
  have hL : a.toList = (List.range n).map f := beq_iff_eq.1 h
  have hs : a.size = n := by rw [← Array.length_toList, hL, List.length_map, List.length_range]
  by_cases hi : i < n
  · rw [getElem!_pos a i (by omega), ← Array.getElem_toList]
    simp [hL]
  · rw [getElem!_neg a i (by omega), hf i (by omega)]

theorem tab_get {T : Array (Array Nat)} {R : Nat → Nat} {w m n k : Nat}
    (h : ((List.range k).all fun j => (T[j]!.toList == (List.range n).map (lane (R j) w m)) &&
      Nat.beq (Nat.shiftRight (R j) (Nat.mul w n)) 0) = true)
    (hs : T.size = k) (hR : ∀ j, k ≤ j → R j = 0) (j i : Nat) : (T[j]!)[i]! = lane (R j) w m i := by
  by_cases hj : j < k
  · have hj' := List.all_eq_true.1 h j (List.mem_range.2 hj)
    rw [Bool.and_eq_true] at hj'
    exact arr_get hj'.1 (fun i hi => lane_of_shift (Nat.eq_of_beq_eq_true hj'.2) hi) i
  · rw [hR j (by omega), getElem!_neg T j (by omega), lane_zero]
    rfl

theorem conjP : ((List.range 6).all fun j =>
    (SylowData.conj[j]!.toList == (List.range 729).map (lane (CPt j) 10 1023)) &&
      Nat.beq (Nat.shiftRight (CPt j) (Nat.mul 10 729)) 0) = true := by quickRfl

theorem leftP : ((List.range 6).all fun j =>
    (FAData.pLeft[j]!.toList == (List.range 729).map (lane (LPt j) 10 1023)) &&
      Nat.beq (Nat.shiftRight (LPt j) (Nat.mul 10 729)) 0) = true := by quickRfl

theorem conj_size : SylowData.conj.size = 6 := by decide +kernel

theorem left_size : FAData.pLeft.size = 6 := by decide +kernel

theorem CPt_zero (j : Nat) (hj : 6 ≤ j) : CPt j = 0 := by
  unfold CPt
  have h : [CP0, CP1, CP2, CP3, CP4, CP5].length ≤ j := by
    simp only [List.length_cons, List.length_nil]
    omega
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none h, Option.getD_none]

theorem LPt_zero (j : Nat) (hj : 6 ≤ j) : LPt j = 0 := by
  unfold LPt
  have h : [LP0, LP1, LP2, LP3, LP4, LP5].length ≤ j := by
    simp only [List.length_cons, List.length_nil]
    omega
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none h, Option.getD_none]

theorem conj_get (j i : Nat) : (SylowData.conj[j]!)[i]! = lane (CPt j) 10 1023 i :=
  tab_get conjP conj_size CPt_zero j i

theorem left_get (j i : Nat) : (FAData.pLeft[j]!)[i]! = lane (LPt j) 10 1023 i :=
  tab_get leftP left_size LPt_zero j i

