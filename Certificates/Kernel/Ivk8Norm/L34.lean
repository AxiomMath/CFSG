  quickRfl

theorem ch5247_klein : kleinOK A B = true := by quickRfl

theorem ch5247_conj : conjOK r pairs = true := by quickRfl

theorem ch5247_chk : chk A B cs (enumV kStrong #v[13, 11, 5]) = true := by quickRfl

