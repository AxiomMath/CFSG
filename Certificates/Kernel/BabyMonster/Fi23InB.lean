section Phi

variable {G : Type*} [Group G] (φ : G →* Mat)

theorem phi_inv_mul (a : G) : φ a⁻¹ * φ a = 1 := by rw [← map_mul, inv_mul_cancel, map_one]

theorem phi_mul_inv (a : G) : φ a * φ a⁻¹ = 1 := by rw [← map_mul, mul_inv_cancel, map_one]

theorem forall2_phi {R : G → List Nat → Prop} (hR : ∀ g M, R g M → φ g = sm M ∧ wfMat M = true) :
    ∀ {gs : List G} {Ms : List (List Nat)}, List.Forall₂ R gs Ms →
      gs.map φ = Ms.map stripMat ∧ ∀ W ∈ Ms, wfMat W = true
  | _, _, .nil => ⟨rfl, by simp⟩
  | _, _, .cons h hs => by
    obtain ⟨e, hw⟩ := forall2_phi hR hs
    obtain ⟨h1, h2⟩ := hR _ _ h
    refine ⟨by rw [List.map_cons, List.map_cons, h1, e], ?_⟩
    intro W hW
    rcases List.mem_cons.1 hW with rfl | hW
    · exact h2
    · exact hw W hW

theorem foldl_map_hom (a : G) : ∀ gs : List G,
    φ (gs.foldl (· * ·) a) = (gs.map φ).foldl (· * ·) (φ a)
  | [] => rfl
  | g :: gs => by
    rw [List.foldl_cons, foldl_map_hom (a * g) gs, List.map_cons, List.foldl_cons, map_mul]

theorem phiL {a : G} {A C : List Nat} (ha : φ a = sm A) (wA : wfMat A = true) (gs : List G)
    (Ms : List (List Nat)) (hs : List.Forall₂ (fun g M => φ g = sm M ∧ wfMat M = true) gs Ms)
    (h : AllStrips2 Ms [] A C) : φ (gs.foldl (· * ·) a) = sm C := by
  obtain ⟨e, hw⟩ := forall2_phi φ (fun _ _ h => h) hs
  rw [foldl_map_hom, e, ha]
  exact stripMat_mul_of_allStrips hw wA (allStrips_of_nil h)

theorem phi_mul {a b : G} {A B C : List Nat} (ha : φ a = sm A) (hb : φ b = sm B)
    (wA : wfMat A = true) (wB : wfMat B = true) (h : AllStrips2 [B] [] A C) : φ (a * b) = sm C :=
  phiL φ ha wA [b] [B] (.cons ⟨hb, wB⟩ .nil) h

theorem phi_conj {r c : G} {R C X : List Nat} (hr : φ r = sm R) (hc : φ c = sm C)
    (wR : wfMat R = true) (wX : wfMat X = true) (wC : wfMat C = true)
    (h : AllStrips2 [X] [R] R C) : φ (r⁻¹ * c * r) = sm X := by
  have e := stripMat_mul_eq_of_allStrips2 (Ws := [X]) (Ds := [R]) (by simp [wX]) (by simp [wR])
    wR wC h
  simp only [List.map_cons, List.map_nil, List.foldl_cons, List.foldl_nil] at e
  rw [map_mul, map_mul, hc, hr, mul_assoc, ← e, ← mul_assoc, ← hr, phi_inv_mul, one_mul]

theorem eq_one_of_phiL (hφ : Function.Injective φ) {a : G} {A : List Nat} (ha : φ a = sm A)
    (wA : wfMat A = true) (gs : List G) (Ms : List (List Nat))
    (hs : List.Forall₂ (fun g M => φ g = sm M ∧ wfMat M = true) gs Ms)
    (h : AllStrips2 Ms [] A idStrips) : gs.foldl (· * ·) a = 1 := by
  obtain ⟨e, hw⟩ := forall2_phi φ (fun _ _ h => h) hs
  refine hφ ?_
  rw [foldl_map_hom, e, ha, map_one]
  exact stripMat_mul_eq_one hw wA (allStrips_of_nil h)

theorem signedWord_flatten (U V : G) (a : List ℤ) : ∀ ps : List (List ℤ),
    signedWord U V (a ++ ps.flatten) = (ps.map (signedWord U V)).foldl (· * ·) (signedWord U V a)
  | [] => by rw [List.flatten_nil, List.append_nil, List.map_nil, List.foldl_nil]
  | w :: ps => by
    rw [List.flatten_cons, ← List.append_assoc, signedWord_flatten U V (a ++ w) ps,
      List.map_cons, List.foldl_cons, signedWord_append]

theorem phiW {U V : G} {a : List ℤ} {A C : List Nat} (ha : φ (signedWord U V a) = sm A)
    (wA : wfMat A = true) (ps : List (List ℤ)) (Ms : List (List Nat))
    (hs : List.Forall₂ (fun g M => φ g = sm M ∧ wfMat M = true) (ps.map (signedWord U V)) Ms)
    (h : AllStrips2 Ms [] A C) : φ (signedWord U V (a ++ ps.flatten)) = sm C := by
  rw [signedWord_flatten]
  exact phiL φ ha wA _ Ms hs h

theorem phi_img {U V : G} {p d : List ℤ} {P Dm I : List Nat}
    (hp : φ (signedWord U V p) = sm P) (hd : φ (signedWord U V d) = sm Dm)
    (hpl : ∀ l ∈ p, l = 1 ∨ l = 2) (wP : wfMat P = true) (wD : wfMat Dm = true)
    (wI : wfMat I = true) (h : AllStrips2 [P] [Dm] I P) :
    φ (signedWord U V (p ++ d ++ invWord p)) = sm I := by
  have e := stripMat_mul_eq_of_allStrips2 (Ws := [P]) (Ds := [Dm]) (by simp [wP]) (by simp [wD])
    wI wP h
  simp only [List.map_cons, List.map_nil, List.foldl_cons, List.foldl_nil] at e
  rw [signedWord_conj U V p d hpl, map_mul, map_mul, hp, hd, ← e, mul_assoc, ← hp, phi_mul_inv,
    mul_one]

end Phi

section Regs

variable {G : Type*} [Group G] (φ : G →* Mat)

theorem regs_phi {x y : G} (hx : φ x = sm Seeds.A1) (hy : φ y = sm Seeds.A2) :
    φ (runProg (initRegs x y) slp 1) = sm Fi23.U ∧ φ (runProg (initRegs x y) slp 2) = sm Fi23.V := by
  let f0 := x * y
  let f1 := f0 * y
  let r2 := f0 * f1
  let r3 := f0 * r2
  let r4 := r3 * f0
  let r5 := r4 * r4
  let r6 := r5 * r5
  let r7 := r2 * r2
  let r8 := r2 * r7
  let r9 := r7 * r8
  let r10 := r9 * r9
  let r11 := r10 * r10
  let r12 := f1 * f1
  let r13 := r12 * r12
  let r14 := r13 * r13
  let r15 := f1 * r14
  let f2 := f0 * f0
  let r20 := f0 * f2
  let r21 := f2 * r20
  let r22 := r21 * r21
  have e1 : runProg (initRegs x y) slp 1 = r22⁻¹ * r11 * r22 := rfl
  have e2 : runProg (initRegs x y) slp 2 = r15⁻¹ * r6 * r15 := rfl
  have h0 : φ f0 = sm Five.f0 :=
    phi_mul φ hx hy Seeds.wf_A1 Seeds.wf_A2 (by bm_strips2 CFSG.KC.BM.Five.cf0 69)
  have h1 : φ f1 = sm Five.f1 :=
    phi_mul φ h0 hy Five.wf_f0 Seeds.wf_A2 (by bm_strips2 CFSG.KC.BM.Five.cf1 69)
  have h2 : φ r2 = sm Fi23.r2 :=
    phi_mul φ h0 h1 Five.wf_f0 Five.wf_f1 (by bm_strips2 CFSG.KC.BM.Fi23.slp2 69)
  have h3 : φ r3 = sm Fi23.r3 :=
    phi_mul φ h0 h2 Five.wf_f0 Fi23.wf_r2 (by bm_strips2 CFSG.KC.BM.Fi23.slp3 69)
  have h4 : φ r4 = sm Fi23.r4 :=
    phi_mul φ h3 h0 Fi23.wf_r3 Five.wf_f0 (by bm_strips2 CFSG.KC.BM.Fi23.slp4 69)
  have h5 : φ r5 = sm Fi23.r5 :=
    phi_mul φ h4 h4 Fi23.wf_r4 Fi23.wf_r4 (by bm_strips2 CFSG.KC.BM.Fi23.slp5 69)
  have h6 : φ r6 = sm Fi23.r6 :=
    phi_mul φ h5 h5 Fi23.wf_r5 Fi23.wf_r5 (by bm_strips2 CFSG.KC.BM.Fi23.slp6 69)
  have h7 : φ r7 = sm Fi23.r7 :=
    phi_mul φ h2 h2 Fi23.wf_r2 Fi23.wf_r2 (by bm_strips2 CFSG.KC.BM.Fi23.slp7 69)
  have h8 : φ r8 = sm Fi23.r8 :=
    phi_mul φ h2 h7 Fi23.wf_r2 Fi23.wf_r7 (by bm_strips2 CFSG.KC.BM.Fi23.slp8 69)
  have h9 : φ r9 = sm Fi23.r9 :=
    phi_mul φ h7 h8 Fi23.wf_r7 Fi23.wf_r8 (by bm_strips2 CFSG.KC.BM.Fi23.slp9 69)
  have h10 : φ r10 = sm Fi23.r10 :=
    phi_mul φ h9 h9 Fi23.wf_r9 Fi23.wf_r9 (by bm_strips2 CFSG.KC.BM.Fi23.slp10 69)
  have h11 : φ r11 = sm Fi23.r11 :=
    phi_mul φ h10 h10 Fi23.wf_r10 Fi23.wf_r10 (by bm_strips2 CFSG.KC.BM.Fi23.slp11 69)
  have h12 : φ r12 = sm Fi23.r12 :=
    phi_mul φ h1 h1 Five.wf_f1 Five.wf_f1 (by bm_strips2 CFSG.KC.BM.Fi23.slp12 69)
  have h13 : φ r13 = sm Fi23.r13 :=
    phi_mul φ h12 h12 Fi23.wf_r12 Fi23.wf_r12 (by bm_strips2 CFSG.KC.BM.Fi23.slp13 69)
  have h14 : φ r14 = sm Fi23.r14 :=
    phi_mul φ h13 h13 Fi23.wf_r13 Fi23.wf_r13 (by bm_strips2 CFSG.KC.BM.Fi23.slp14 69)
  have h15 : φ r15 = sm Fi23.r15 :=
    phi_mul φ h1 h14 Five.wf_f1 Fi23.wf_r14 (by bm_strips2 CFSG.KC.BM.Fi23.slp15 69)
  have hf2 : φ f2 = sm Five.f2 :=
    phi_mul φ h0 h0 Five.wf_f0 Five.wf_f0 (by bm_strips2 CFSG.KC.BM.Five.cf2 69)
  have h20 : φ r20 = sm Fi23.r20 :=
    phi_mul φ h0 hf2 Five.wf_f0 Five.wf_f2 (by bm_strips2 CFSG.KC.BM.Fi23.slp20 69)
  have h21 : φ r21 = sm Fi23.r21 :=
    phi_mul φ hf2 h20 Five.wf_f2 Fi23.wf_r20 (by bm_strips2 CFSG.KC.BM.Fi23.slp21 69)
  have h22 : φ r22 = sm Fi23.r22 :=
    phi_mul φ h21 h21 Fi23.wf_r21 Fi23.wf_r21 (by bm_strips2 CFSG.KC.BM.Fi23.slp22 69)
  rw [e1, e2]
  exact ⟨phi_conj φ h22 h11 Fi23.wf_r22 Fi23.wf_U Fi23.wf_r11
      (by bm_strips2 CFSG.KC.BM.Fi23.slp25 69),
    phi_conj φ h15 h6 Fi23.wf_r15 Fi23.wf_V Fi23.wf_r6 (by bm_strips2 CFSG.KC.BM.Fi23.slp18 69)⟩

end Regs

section Images

variable {G : Type*} [Group G]

theorem wordProd_cons_true (x : ℕ → G) (i : ℕ) (w : List (ℕ × Bool)) :
    wordProd x ((i, true) :: w) = x i * wordProd x w := by
  simp [wordProd]

theorem wordProd_nil (x : ℕ → G) : wordProd x [] = 1 := rfl

theorem wordProd_append (x : ℕ → G) (u v : List (ℕ × Bool)) :
    wordProd x (u ++ v) = wordProd x u * wordProd x v := by
  simp only [wordProd, List.map_append, List.prod_append]

theorem wordProd_powWord (x : ℕ → G) (w : List (ℕ × Bool)) :
    ∀ n, wordProd x (powWord w n) = wordProd x w ^ n
  | 0 => by simp [powWord, wordProd]
  | n + 1 => by
    have e : powWord w (n + 1) = w ++ powWord w n := by
      simp only [powWord, List.replicate_succ, List.flatten_cons]
    rw [e, wordProd_append, wordProd_powWord x w n, pow_succ']

theorem pair_relator (x : ℕ → G) (r s n : ℕ) (h : (x r * x s) ^ n = 1) :
    wordProd x (powWord [(r, true), (s, true)] n) = 1 := by
  rw [wordProd_powWord, wordProd_cons_true, wordProd_cons_true, wordProd_nil, mul_one, h]

variable (φ : G →* Mat)

theorem fi23ImgFacts_of_phi (hφ : Function.Injective φ) {U V : G} (hU : φ U = sm Fi23.U)
    (hV : φ V = sm Fi23.V) : Fi23ImgFacts U V := by
  unfold Fi23ImgFacts
