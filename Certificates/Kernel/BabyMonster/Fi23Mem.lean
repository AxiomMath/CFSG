local notation "sm" => stripMat

local notation "S0" => Submonoid.closure {sm Seeds.A1, sm Seeds.A2}

theorem isUnit_of_mem_seeds {X : Matrix (Fin 4370) (Fin 4370) (ZMod 2)} (hX : X ∈ S0) :
    IsUnit X := by
  have h1 : sm Seeds.A1 * sm Seeds.A1 = 1 := by
    have e := stripMat_mul_eq_one (Ws := [Seeds.A1]) (by simp [Seeds.wf_A1]) Seeds.wf_A1
      (allStrips_of_nil (by bm_strips2 CFSG.KC.BM.Seeds.a1sq 69))
    simpa using e
  have h2 : sm Seeds.A2 * sm Seeds.A2 * sm Seeds.A2 = 1 := by
    have e := stripMat_mul_eq_one (Ws := [Seeds.A2, Seeds.A2]) (by simp [Seeds.wf_A2])
      Seeds.wf_A2 (allStrips_of_nil (by bm_strips2 CFSG.KC.BM.Seeds.a2cube 69))
    simpa using e
  induction hX using Submonoid.closure_induction with
  | mem x hx =>
    rcases hx with rfl | hx
    · exact ⟨⟨_, _, h1, h1⟩, rfl⟩
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨⟨_, sm Seeds.A2 * sm Seeds.A2, by rw [← mul_assoc]; exact h2, h2⟩, rfl⟩
  | one => exact isUnit_one
  | mul x y _ _ hx hy => exact hx.mul hy

theorem mem_of_conj {R C X : Matrix (Fin 4370) (Fin 4370) (ZMod 2)} (hR : R ∈ S0) (hC : C ∈ S0)
    (h : R * X = C * R) : X ∈ S0 := by
  obtain ⟨u, hu⟩ := isUnit_of_mem_seeds hR
  have hinv : ((u⁻¹ : (Matrix (Fin 4370) (Fin 4370) (ZMod 2))ˣ) : Matrix _ _ _) ∈ S0 :=
    mem_of_mul_eq_one hR (by rw [← hu]; exact u.mul_inv)
  have hX : X = ((u⁻¹ : (Matrix (Fin 4370) (Fin 4370) (ZMod 2))ˣ) : Matrix _ _ _) * (C * R) := by
    rw [← h, ← hu, Units.inv_mul_cancel_left]
  rw [hX]
  exact Submonoid.mul_mem _ hinv (Submonoid.mul_mem _ hC hR)

theorem conj1 {A B C D : List Nat} (wA : wfMat A = true) (wB : wfMat B = true)
    (wC : wfMat C = true) (wD : wfMat D = true) (h : AllStrips2 [B] [D] A C) :
    sm A * sm B = sm C * sm D := by
  simpa using stripMat_mul_eq_of_allStrips2 (Ws := [B]) (Ds := [D]) (by simp [wB]) (by simp [wD])
    wA wC h

theorem fi23_mem_seeds : sm Fi23.U ∈ S0 ∧ sm Fi23.V ∈ S0 := by
  have hA1 : sm Seeds.A1 ∈ S0 := Submonoid.subset_closure (Set.mem_insert _ _)
  have hA2 : sm Seeds.A2 ∈ S0 :=
    Submonoid.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  have m_f0 : sm Five.f0 ∈ S0 := mem1 Seeds.wf_A1 Seeds.wf_A2 Five.wf_f0 hA1 hA2
    (by bm_strips2 CFSG.KC.BM.Five.cf0 69)
  have m_f1 : sm Five.f1 ∈ S0 := mem1 Five.wf_f0 Seeds.wf_A2 Five.wf_f1 m_f0 hA2
    (by bm_strips2 CFSG.KC.BM.Five.cf1 69)
  have m_f2 : sm Five.f2 ∈ S0 := mem1 Five.wf_f0 Five.wf_f0 Five.wf_f2 m_f0 m_f0
    (by bm_strips2 CFSG.KC.BM.Five.cf2 69)
  have m_r2 : sm Fi23.r2 ∈ S0 := mem1 Five.wf_f0 Five.wf_f1 Fi23.wf_r2 m_f0 m_f1
    (by bm_strips2 CFSG.KC.BM.Fi23.slp2 69)
  have m_r3 : sm Fi23.r3 ∈ S0 := mem1 Five.wf_f0 Fi23.wf_r2 Fi23.wf_r3 m_f0 m_r2
    (by bm_strips2 CFSG.KC.BM.Fi23.slp3 69)
  have m_r4 : sm Fi23.r4 ∈ S0 := mem1 Fi23.wf_r3 Five.wf_f0 Fi23.wf_r4 m_r3 m_f0
    (by bm_strips2 CFSG.KC.BM.Fi23.slp4 69)
  have m_r5 : sm Fi23.r5 ∈ S0 := mem1 Fi23.wf_r4 Fi23.wf_r4 Fi23.wf_r5 m_r4 m_r4
    (by bm_strips2 CFSG.KC.BM.Fi23.slp5 69)
  have m_r6 : sm Fi23.r6 ∈ S0 := mem1 Fi23.wf_r5 Fi23.wf_r5 Fi23.wf_r6 m_r5 m_r5
    (by bm_strips2 CFSG.KC.BM.Fi23.slp6 69)
  have m_r7 : sm Fi23.r7 ∈ S0 := mem1 Fi23.wf_r2 Fi23.wf_r2 Fi23.wf_r7 m_r2 m_r2
    (by bm_strips2 CFSG.KC.BM.Fi23.slp7 69)
  have m_r8 : sm Fi23.r8 ∈ S0 := mem1 Fi23.wf_r2 Fi23.wf_r7 Fi23.wf_r8 m_r2 m_r7
    (by bm_strips2 CFSG.KC.BM.Fi23.slp8 69)
  have m_r9 : sm Fi23.r9 ∈ S0 := mem1 Fi23.wf_r7 Fi23.wf_r8 Fi23.wf_r9 m_r7 m_r8
    (by bm_strips2 CFSG.KC.BM.Fi23.slp9 69)
  have m_r10 : sm Fi23.r10 ∈ S0 := mem1 Fi23.wf_r9 Fi23.wf_r9 Fi23.wf_r10 m_r9 m_r9
    (by bm_strips2 CFSG.KC.BM.Fi23.slp10 69)
  have m_r11 : sm Fi23.r11 ∈ S0 := mem1 Fi23.wf_r10 Fi23.wf_r10 Fi23.wf_r11 m_r10 m_r10
    (by bm_strips2 CFSG.KC.BM.Fi23.slp11 69)
  have m_r12 : sm Fi23.r12 ∈ S0 := mem1 Five.wf_f1 Five.wf_f1 Fi23.wf_r12 m_f1 m_f1
    (by bm_strips2 CFSG.KC.BM.Fi23.slp12 69)
  have m_r13 : sm Fi23.r13 ∈ S0 := mem1 Fi23.wf_r12 Fi23.wf_r12 Fi23.wf_r13 m_r12 m_r12
    (by bm_strips2 CFSG.KC.BM.Fi23.slp13 69)
  have m_r14 : sm Fi23.r14 ∈ S0 := mem1 Fi23.wf_r13 Fi23.wf_r13 Fi23.wf_r14 m_r13 m_r13
    (by bm_strips2 CFSG.KC.BM.Fi23.slp14 69)
  have m_r15 : sm Fi23.r15 ∈ S0 := mem1 Five.wf_f1 Fi23.wf_r14 Fi23.wf_r15 m_f1 m_r14
    (by bm_strips2 CFSG.KC.BM.Fi23.slp15 69)
  have m_r20 : sm Fi23.r20 ∈ S0 := mem1 Five.wf_f0 Five.wf_f2 Fi23.wf_r20 m_f0 m_f2
    (by bm_strips2 CFSG.KC.BM.Fi23.slp20 69)
  have m_r21 : sm Fi23.r21 ∈ S0 := mem1 Five.wf_f2 Fi23.wf_r20 Fi23.wf_r21 m_f2 m_r20
    (by bm_strips2 CFSG.KC.BM.Fi23.slp21 69)
  have m_r22 : sm Fi23.r22 ∈ S0 := mem1 Fi23.wf_r21 Fi23.wf_r21 Fi23.wf_r22 m_r21 m_r21
    (by bm_strips2 CFSG.KC.BM.Fi23.slp22 69)
  refine ⟨mem_of_conj m_r22 m_r11 ?_, mem_of_conj m_r15 m_r6 ?_⟩
  · exact conj1 Fi23.wf_r22 Fi23.wf_U Fi23.wf_r11 Fi23.wf_r22
      (by bm_strips2 CFSG.KC.BM.Fi23.slp25 69)
  · exact conj1 Fi23.wf_r15 Fi23.wf_V Fi23.wf_r6 Fi23.wf_r15
      (by bm_strips2 CFSG.KC.BM.Fi23.slp18 69)

theorem fi23_mem {S : Submonoid (Matrix (Fin 4370) (Fin 4370) (ZMod 2))} (hA1 : sm Seeds.A1 ∈ S)
    (hA2 : sm Seeds.A2 ∈ S) : sm Fi23.U ∈ S ∧ sm Fi23.V ∈ S := by
  have hle : S0 ≤ S := Submonoid.closure_le.2 (by
    rintro _ (rfl | hx)
    · exact hA1
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      exact hA2)
  exact ⟨hle fi23_mem_seeds.1, hle fi23_mem_seeds.2⟩

end CFSG.KC.BM.Fi23Mem

