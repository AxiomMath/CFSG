abbrev Mt := Matrix (Fin 4370) (Fin 4370) (ZMod 2)

local notation "sm" => stripMat

@[expose] def threeM : List (List ℕ) :=
  [[0, 1, 0, 1, 1, 0, 0, 0], [2, 0, 2, 2, 2, 0, 2, 2], [0, 1, 0, 2, 2, 2, 0, 1],
   [2, 1, 1, 0, 2, 1, 0, 1], [2, 1, 1, 1, 0, 1, 1, 1], [0, 0, 1, 2, 2, 0, 2, 1],
   [0, 1, 0, 0, 2, 1, 0, 1], [0, 1, 2, 2, 2, 2, 2, 0]]

@[expose] def threeD (i j : ℕ) : ℕ := (threeM.getD i []).getD j 0

@[expose] def TX : ℕ → List ℕ
  | 0 => [1]
  | 1 => [3]
  | 2 => [5]
  | 3 => [7]
  | 4 => [1, 3, 4, 6, 7]
  | 5 => [0, 0, 1, 2, 2, 3, 6, 6, 7, 7, 8, 8]
  | 6 => [0, 1, 1, 3, 3, 4, 4, 5, 7, 8, 8]
  | 7 => [0, 1, 2, 4, 4, 5, 6, 7, 8]
  | 8 => [8, 8]
  | _ => []

@[expose] def TH : ℕ → List ℕ
  | 0 => [2]
  | 1 => [4]
  | 2 => [6]
  | 3 => [0, 0, 1, 2, 2, 3, 5, 5, 6, 6, 7, 8, 8]
  | 4 => [0, 1, 2, 3, 4, 5, 5, 6, 7, 7, 8, 8]
  | 5 => [0, 2, 2, 3, 4, 6, 6, 7, 7]
  | 6 => [0, 2, 2]
  | 7 => [0, 1, 1, 3, 4, 4, 5, 5]
  | 8 => [8, 8]
  | _ => []

@[expose] def TT (k : ℕ) : ℕ → List ℕ := if k = 0 then TX else TH

@[expose] def Xw : ℕ → List ℕ
  | 0 => [0, 2, 6]
  | 1 => [1, 2, 3, 4, 7, 7]
  | 2 => [0, 0, 1, 3, 3, 4, 6, 6, 7, 7, 8]
  | 3 => [2, 5, 5, 8]
  | _ => []

@[expose] def Yw : ℕ → List ℕ
  | 0 => [1, 4, 4, 5, 5, 6, 8, 8]
  | 1 => [1, 5]
  | 2 => [0, 0, 1, 3, 4, 5, 7, 7, 8, 8]
  | 3 => [1, 1, 5]
  | _ => []

@[expose] def rep (k : ℕ) (w : List ℕ) : List ℕ := (List.replicate k w).flatten

@[expose] def nfw (e : List ℕ) : List ℕ :=
  rep (e.getD 0 0) (Xw 0) ++ rep (e.getD 1 0) (Xw 1) ++ rep (e.getD 2 0) (Xw 2) ++
    rep (e.getD 3 0) (Xw 3) ++ rep (e.getD 4 0) (Yw 0) ++ rep (e.getD 5 0) (Yw 1) ++
    rep (e.getD 6 0) (Yw 2) ++ rep (e.getD 7 0) (Yw 3) ++ rep (e.getD 8 0) [8]

abbrev nfE (u v : List ℕ) : Bool := nfEq 8 3 threeD u v

theorem dec_heis : ∀ i : Fin 4,
    nfE (rep 3 (Xw i.val)) [] = true ∧ nfE (rep 3 (Yw i.val)) [] = true ∧
    nfE (Xw i.val ++ [8]) ([8] ++ Xw i.val) = true ∧ nfE (Yw i.val ++ [8]) ([8] ++ Yw i.val) = true ∧
    nfE (Xw i.val ++ Yw i.val) (Yw i.val ++ Xw i.val ++ [8]) = true := by
  decide +kernel

theorem dec_xx : ∀ i j : Fin 4, nfE (Xw i.val ++ Xw j.val) (Xw j.val ++ Xw i.val) = true := by
  decide +kernel

theorem dec_yy : ∀ i j : Fin 4, i ≠ j →
    nfE (Yw i.val ++ Yw j.val) (Yw j.val ++ Yw i.val) = true ∧
      nfE (Xw i.val ++ Yw j.val) (Yw j.val ++ Xw i.val) = true := by
  decide +kernel

theorem dec_actX : ∀ (k : Fin 2) (j : Fin 4),
    nfE (Xw j.val) (subst (TT k.val) (nfw (nfXData.getD (4 * k.val + j.val) []))) = true := by
  decide +kernel

theorem dec_actY : ∀ (k : Fin 2) (j : Fin 4),
    nfE (Yw j.val) (subst (TT k.val) (nfw (nfYData.getD (4 * k.val + j.val) []))) = true := by
  decide +kernel

theorem neg_xy : nfE (Xw 0 ++ Yw 0) (Yw 0 ++ Xw 0) = false := by decide +kernel

theorem neg_actX : nfE (Xw 0) (subst TX (nfw [2, 2, 2, 2, 0, 0, 2, 2, 0])) = false := by
  decide +kernel

section Mat

theorem p10 {A B C : List Nat} (wA : wfMat A = true) (wB : wfMat B = true) (wC : wfMat C = true)
    (h : AllStrips2 [B] [] A C) : sm A * sm B = sm C := by
  simpa using stripMat_mul_eq_of_allStrips2 (Ws := [B]) (Ds := []) (by simp [wB]) (by simp) wA wC h

theorem p20 {A B B' C : List Nat} (wA : wfMat A = true) (wB : wfMat B = true)
    (wB' : wfMat B' = true) (wC : wfMat C = true) (h : AllStrips2 [B, B'] [] A C) :
    sm A * sm B * sm B' = sm C := by
  simpa using stripMat_mul_eq_of_allStrips2 (Ws := [B, B']) (Ds := []) (by simp [wB, wB'])
    (by simp) wA wC h

theorem p11 {A B C D : List Nat} (wA : wfMat A = true) (wB : wfMat B = true) (wC : wfMat C = true)
    (wD : wfMat D = true) (h : AllStrips2 [B] [D] A C) : sm A * sm B = sm C * sm D := by
  simpa using stripMat_mul_eq_of_allStrips2 (Ws := [B]) (Ds := [D]) (by simp [wB]) (by simp [wD])
    wA wC h

theorem p12 {A B C D D' : List Nat} (wA : wfMat A = true) (wB : wfMat B = true)
    (wC : wfMat C = true) (wD : wfMat D = true) (wD' : wfMat D' = true)
    (h : AllStrips2 [B] [D, D'] A C) : sm A * sm B = sm C * sm D * sm D' := by
  simpa using stripMat_mul_eq_of_allStrips2 (Ws := [B]) (Ds := [D, D']) (by simp [wB])
    (by simp [wD, wD']) wA wC h

theorem p21 {A B B' C D : List Nat} (wA : wfMat A = true) (wB : wfMat B = true)
    (wB' : wfMat B' = true) (wC : wfMat C = true) (wD : wfMat D = true)
    (h : AllStrips2 [B, B'] [D] A C) : sm A * sm B * sm B' = sm C * sm D := by
  simpa using stripMat_mul_eq_of_allStrips2 (Ws := [B, B']) (Ds := [D]) (by simp [wB, wB'])
    (by simp [wD]) wA wC h

theorem p1I {A B : List Nat} (wA : wfMat A = true) (wB : wfMat B = true)
    (h : AllStrips2 [B] [] A idStrips) : sm A * sm B = 1 := by
  simpa using stripMat_mul_eq_one (Ws := [B]) (by simp [wB]) wA (MemChain.allStrips_of_nil h)

