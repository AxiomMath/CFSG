variable {S : Submonoid Mt}

theorem val_conj {u a : Sˣ} {U A B : Mt} (hu : valHom S u = U) (ha : valHom S a = A)
    (h : U * B = A * U) : valHom S (u⁻¹ * a * u) = B := by
  have hi : valHom S u⁻¹ * U = 1 := by rw [← hu, ← map_mul, inv_mul_cancel, map_one]
  rw [map_mul, map_mul, ha, hu, mul_assoc, ← h, ← mul_assoc, hi, one_mul]

theorem val_ldiv {a b : Sˣ} {A B W : Mt} (ha : valHom S a = A) (hb : valHom S b = B)
    (h : A * W = B) : valHom S (a⁻¹ * b) = W := by
  have hi : valHom S a⁻¹ * A = 1 := by rw [← ha, ← map_mul, inv_mul_cancel, map_one]
  rw [map_mul, hb, ← h, ← mul_assoc, hi, one_mul]

theorem conj_pow3 {u a : Sˣ} (h : a ^ 3 = 1) : (u⁻¹ * a * u) ^ 3 = 1 := by
  have := conj_pow (a := u⁻¹) (b := a) (i := 3)
  rw [inv_inv] at this
  rw [this, h, mul_one, inv_mul_cancel]

theorem conj_of {g x N : Sˣ} (h : x = g⁻¹ * N * g) : g * x * g⁻¹ = N := by
  rw [h]
  simp only [mul_assoc, mul_inv_cancel_left, mul_inv_cancel, mul_one]

