@[expose] noncomputable def u3 : Sˣ := (uH hH)⁻¹ * u1 hT hH * uH hH
@[expose] noncomputable def u4 : Sˣ := (uT hT)⁻¹ * u2 hT hH * uT hT
@[expose] noncomputable def u5 : Sˣ := (uH hH)⁻¹ * u2 hT hH * uH hH
@[expose] noncomputable def u6 : Sˣ := (uT hT)⁻¹ * u3 hT hH * uT hT
@[expose] noncomputable def u7 : Sˣ := (uH hH)⁻¹ * u3 hT hH * uH hH
@[expose] noncomputable def u8 : Sˣ := (uT hT)⁻¹ * u4 hT hH * uT hT
@[expose] noncomputable def uz : Sˣ := (u2 hT hH * u1 hT hH)⁻¹ * (u1 hT hH * u2 hT hH)

@[expose] noncomputable def qq : ℕ → Sˣ
  | 0 => u1 hT hH
  | 1 => u2 hT hH
  | 2 => u3 hT hH
  | 3 => u4 hT hH
  | 4 => u5 hT hH
  | 5 => u6 hT hH
  | 6 => u7 hT hH
  | 7 => u8 hT hH
  | 8 => uz hT hH
  | _ => 1

theorem v1 : valHom S (u1 hT hH) = sm Three.Q1 := by
  have a : valHom S (uT hT ^ 20) = sm Three.Y20 := by rw [map_pow, vT, t79_pow20]
  rw [u1, map_mul, a, val_conj (vH hH) a y20h, q1]

theorem v2 : valHom S (u2 hT hH) = sm Three.Q2 := val_conj (vT hT) (v1 hT hH) q2
theorem v3 : valHom S (u3 hT hH) = sm Three.Q3 := val_conj (vH hH) (v1 hT hH) q3
theorem v4 : valHom S (u4 hT hH) = sm Three.Q4 := val_conj (vT hT) (v2 hT hH) q4
theorem v5 : valHom S (u5 hT hH) = sm Three.Q5 := val_conj (vH hH) (v2 hT hH) q5
theorem v6 : valHom S (u6 hT hH) = sm Three.Q6 := val_conj (vT hT) (v3 hT hH) q6
theorem v7 : valHom S (u7 hT hH) = sm Three.Q7 := val_conj (vH hH) (v3 hT hH) q7
theorem v8 : valHom S (u8 hT hH) = sm Three.Q8 := val_conj (vT hT) (v4 hT hH) q8

theorem vz : valHom S (uz hT hH) = sm Three.Z :=
  val_ldiv (by rw [map_mul, v2, v1]) (by rw [map_mul, v1, v2]) zdef

theorem vq : ∀ l, valHom S (qq hT hH l) = mq l
  | 0 => v1 hT hH
  | 1 => v2 hT hH
  | 2 => v3 hT hH
  | 3 => v4 hT hH
  | 4 => v5 hT hH
  | 5 => v6 hT hH
  | 6 => v7 hT hH
  | 7 => v8 hT hH
  | 8 => vz hT hH
  | _ + 9 => map_one _

theorem vev (w : List ℕ) : valHom S (ev (qq hT hH) w) = ev mq w := by
  rw [map_ev]
  exact congrArg (ev · w) (funext (vq hT hH))

theorem u1_pow : u1 hT hH ^ 3 = 1 :=
  valHom_injective S (by rw [map_pow, v1, map_one, pow_succ, pow_succ, pow_one, oq1, oq2])

theorem uz_pow : uz hT hH ^ 3 = 1 :=
  valHom_injective S (by rw [map_pow, vz, map_one, pow_succ, pow_succ, pow_one, oz1, oz2])

theorem cfg : Cfg 8 3 threeD (qq hT hH) where
  p_pos := by norm_num
  pow i hi := by
    have h2 := conj_pow3 (u := uT hT) (u1_pow hT hH)
    have h3 := conj_pow3 (u := uH hH) (u1_pow hT hH)
    have h4 := conj_pow3 (u := uT hT) h2
    interval_cases i
    · exact u1_pow hT hH
    · exact h2
    · exact h3
    · exact h4
    · exact conj_pow3 h2
    · exact conj_pow3 h3
    · exact conj_pow3 h3
    · exact conj_pow3 h4
    · exact uz_pow hT hH
  cen i hi := valHom_injective S (by simp only [map_mul, vq]; exact mcen i hi)
  rel i j hij hj := valHom_injective S (by simp only [map_mul, map_pow, vq]; exact mrel i j hij hj)

theorem conjT : ∀ l, (uT hT)⁻¹ * qq hT hH l * uT hT = ev (qq hT hH) (TX l)
  | 0 => by simp only [TX, ev, mul_one]; rfl
  | 1 => by simp only [TX, ev, mul_one]; rfl
  | 2 => by simp only [TX, ev, mul_one]; rfl
  | 3 => by simp only [TX, ev, mul_one]; rfl
  | 4 => valHom_injective S (by rw [vev, wTx4]; exact val_conj (vT hT) (vq hT hH 4) ax4)
  | 5 => valHom_injective S (by rw [vev, wTx5]; exact val_conj (vT hT) (vq hT hH 5) ax5)
  | 6 => valHom_injective S (by rw [vev, wTx6]; exact val_conj (vT hT) (vq hT hH 6) ax6)
  | 7 => valHom_injective S (by rw [vev, wTx7]; exact val_conj (vT hT) (vq hT hH 7) ax7)
  | 8 => valHom_injective S (by rw [vev, wTx8]; exact val_conj (vT hT) (vq hT hH 8) axz)
  | n + 9 => by
    have e1 : qq hT hH (n + 9) = 1 := rfl
    have e2 : TX (n + 9) = [] := rfl
    rw [e1, e2, mul_one, inv_mul_cancel]
    rfl

theorem conjH : ∀ l, (uH hH)⁻¹ * qq hT hH l * uH hH = ev (qq hT hH) (TH l)
  | 0 => by simp only [TH, ev, mul_one]; rfl
  | 1 => by simp only [TH, ev, mul_one]; rfl
  | 2 => by simp only [TH, ev, mul_one]; rfl
  | 3 => valHom_injective S (by rw [vev, wTh3]; exact val_conj (vH hH) (vq hT hH 3) ah3)
  | 4 => valHom_injective S (by rw [vev, wTh4]; exact val_conj (vH hH) (vq hT hH 4) ah4)
  | 5 => valHom_injective S (by rw [vev, wTh5]; exact val_conj (vH hH) (vq hT hH 5) ah5)
  | 6 => valHom_injective S (by rw [vev, wTh6]; exact val_conj (vH hH) (vq hT hH 6) ah6)
  | 7 => valHom_injective S (by rw [vev, wTh7]; exact val_conj (vH hH) (vq hT hH 7) ah7)
  | 8 => valHom_injective S (by rw [vev, wTh8]; exact val_conj (vH hH) (vq hT hH 8) ahz)
  | n + 9 => by
    have e1 : qq hT hH (n + 9) = 1 := rfl
    have e2 : TH (n + 9) = [] := rfl
    rw [e1, e2, mul_one, inv_mul_cancel]
    rfl

@[expose] noncomputable def xs (i : Fin 4) : Sˣ := ev (qq hT hH) (Xw i.val)
@[expose] noncomputable def ys (i : Fin 4) : Sˣ := ev (qq hT hH) (Yw i.val)
@[expose] noncomputable def gs (k : Fin 2) : Sˣ := if k.val = 0 then uT hT else uH hH

theorem ev8 : ev (qq hT hH) [8] = qq hT hH 8 := by simp [ev]

theorem ev_rep (k : ℕ) (w : List ℕ) : ev (qq hT hH) (rep k w) = ev (qq hT hH) w ^ k :=
  ev_flatten_replicate _ _ _

theorem eqw {u v : List ℕ} (h : nfE u v = true) : ev (qq hT hH) u = ev (qq hT hH) v :=
  (cfg hT hH).ev_eq_of_nfEq h

theorem uz_ne : qq hT hH 8 ≠ 1 := fun e => z_ne_one (by
  have h := vq hT hH 8
  rw [e, map_one] at h
  exact h.symm)

theorem heisCfg : HeisCfg 3 4 (xs hT hH) (ys hT hH) (qq hT hH 8) where
  xp i := by rw [xs, ← ev_rep, eqw hT hH (dec_heis i).1]; rfl
  zp := (cfg hT hH).pow 8 le_rfl
  zx i := by
    have := eqw hT hH (dec_heis i).2.2.1
    rwa [ev_append, ev_append, ev8] at this
  zy i := by
    have := eqw hT hH (dec_heis i).2.2.2.1
    rwa [ev_append, ev_append, ev8] at this
  yx i := by
    have h := eqw hT hH (dec_heis i).2.2.2.2
    rw [ev_append, ev_append, ev_append, ev8] at h
    simp only [xs, ys]
    rw [mul_assoc, h, ← mul_assoc, ← mul_assoc, inv_mul_cancel, one_mul]
  xx i j := by
    have := eqw hT hH (dec_xx i j)
    rwa [ev_append, ev_append] at this
  yy i j hij := by
    have := eqw hT hH (dec_yy i j hij).1
    rwa [ev_append, ev_append] at this
  xy i j hij := by
    have := eqw hT hH (dec_yy i j hij).2
    rwa [ev_append, ev_append] at this
  z1 := uz_ne hT hH

theorem ys_pow (i : Fin 4) : ys hT hH i ^ 3 = 1 := by
  rw [ys, ← ev_rep, eqw hT hH (dec_heis i).2.1]
  rfl

theorem nfProd_eq (e : List ℕ) :
    nfProd (xs hT hH) (ys hT hH) (qq hT hH 8) e = ev (qq hT hH) (nfw e) := by
  simp only [nfProd, nfw, ev_append, ev_rep, ev8, xs, ys] <;> rfl

theorem conjG (k : Fin 2) (w : List ℕ) :
    (gs hT hH k)⁻¹ * ev (qq hT hH) w * gs hT hH k = ev (qq hT hH) (subst (TT k.val) w) := by
  rw [conj_ev, ev_subst]
  refine congrArg (ev · w) (funext fun l => ?_)
  by_cases hk : k.val = 0
  · rw [gs, TT, if_pos hk, if_pos hk]
    exact conjT hT hH l
  · rw [gs, TT, if_neg hk, if_neg hk]
    exact conjH hT hH l

theorem actX (k : Fin 2) (j : Fin 4) : gs hT hH k * xs hT hH j * (gs hT hH k)⁻¹ =
    nfProd (xs hT hH) (ys hT hH) (qq hT hH 8) (nfXData.getD (4 * k.val + j.val) []) := by
  refine conj_of ?_
  rw [nfProd_eq, conjG]
  exact eqw hT hH (dec_actX k j)

theorem actY (k : Fin 2) (j : Fin 4) : gs hT hH k * ys hT hH j * (gs hT hH k)⁻¹ =
    nfProd (xs hT hH) (ys hT hH) (qq hT hH 8) (nfYData.getD (4 * k.val + j.val) []) := by
  refine conj_of ?_
  rw [nfProd_eq, conjG]
  exact eqw hT hH (dec_actY k j)

theorem actZ (k : Fin 2) : gs hT hH k * qq hT hH 8 * (gs hT hH k)⁻¹ = qq hT hH 8 ^ 2 := by
  have h8 := conjG hT hH k [8]
  have hw : subst (TT k.val) [8] = [8, 8] := by
    by_cases hk : k.val = 0 <;> simp [TT, hk, subst, TX, TH]
  rw [hw, ev8] at h8
  have hz3 := (cfg hT hH).pow 8 le_rfl
  refine conj_of ?_
  have e : ev (qq hT hH) [8, 8] = qq hT hH 8 ^ 2 := by simp [ev, sq]
  rw [e] at h8
  calc qq hT hH 8 = qq hT hH 8 ^ 3 * qq hT hH 8 := by rw [hz3, one_mul]
    _ = ((gs hT hH k)⁻¹ * qq hT hH 8 * gs hT hH k) ^ 2 := by
        rw [h8, ← pow_mul, ← pow_succ]
    _ = (gs hT hH k)⁻¹ * qq hT hH 8 ^ 2 * gs hT hH k := by
        rw [sq, sq]
        simp only [mul_assoc, mul_inv_cancel_left]

end Units

