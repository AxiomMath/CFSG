theorem g2_12 : stripMat Max2.G2 ^ 12 = stripMat CTIB.H6 := by
  have h2 : stripMat Max2.G2 ^ 2 = stripMat CTIB.G2_sq1 := by
    rw [sq]
    exact sm1 Max2.wf_G2 Max2.wf_G2 (by bm_strips CFSG.KC.BM.CTIB.cG2_sq1 69)
  have h4 : stripMat Max2.G2 ^ 4 = stripMat CTIB.G2_sq2 :=
    sq_step h2 (sm1 (C := CTIB.G2_sq2) CTIB.wf_G2_sq1 CTIB.wf_G2_sq1
      (by bm_strips CFSG.KC.BM.CTIB.cG2_sq2 69)) rfl
  have h8 : stripMat Max2.G2 ^ 8 = stripMat CTIB.G2_sq3 :=
    sq_step h4 (sm1 (C := CTIB.G2_sq3) CTIB.wf_G2_sq2 CTIB.wf_G2_sq2
      (by bm_strips CFSG.KC.BM.CTIB.cG2_sq3 69)) rfl
  rw [(by norm_num : (12 : ℕ) = 4 + 8), pow_add, h4, h8]
  exact sm1 CTIB.wf_G2_sq3 CTIB.wf_G2_sq2 (by bm_strips CFSG.KC.BM.CTIB.cH6 69)

theorem seed_list : [1, 1, 1, 0, 1, 0, 1, 1, 1, 1, 1, 1, 1].map
    (fun l : ℕ => if l = 0 then G1K else G2K) =
    [G2K, G2K, G2K, G1K, G2K, G1K, G2K, G2K, G2K, G2K, G2K, G2K, G2K] := by
  simp only [List.map_cons, List.map_nil, one_ne_zero, ↓reduceIte]

theorem seedc0 : stripMat Max2.G2 * stripMat Max2.G2 * stripMat Max2.G2 = stripMat CTIB.Sd_0 :=
  sm2 Max2.wf_G2 Max2.wf_G2 Max2.wf_G2 (by bm_strips CFSG.KC.BM.CTIB.cSd_0 69)

theorem seedc1 : stripMat CTIB.Sd_0 * stripMat Max2.G1 * stripMat Max2.G2 = stripMat CTIB.Sd_1 :=
  sm2 Max2.wf_G1 Max2.wf_G2 CTIB.wf_Sd_0 (by bm_strips CFSG.KC.BM.CTIB.cSd_1 69)

theorem seedc2 : stripMat CTIB.Sd_1 * stripMat Max2.G1 * stripMat Max2.G2 = stripMat CTIB.Sd_2 :=
  sm2 Max2.wf_G1 Max2.wf_G2 CTIB.wf_Sd_1 (by bm_strips CFSG.KC.BM.CTIB.cSd_2 69)

theorem seedc3 : stripMat CTIB.Sd_2 * stripMat Max2.G2 * stripMat Max2.G2 = stripMat CTIB.Sd_3 :=
  sm2 Max2.wf_G2 Max2.wf_G2 CTIB.wf_Sd_2 (by bm_strips CFSG.KC.BM.CTIB.cSd_3 69)

theorem seedc4 : stripMat CTIB.Sd_3 * stripMat Max2.G2 * stripMat Max2.G2 = stripMat CTIB.Sd_4 :=
  sm2 Max2.wf_G2 Max2.wf_G2 CTIB.wf_Sd_3 (by bm_strips CFSG.KC.BM.CTIB.cSd_4 69)

theorem seedc5 : stripMat CTIB.Sd_4 * stripMat Max2.G2 * stripMat Max2.G2 = stripMat CTIB.Sd :=
  sm2 Max2.wf_G2 Max2.wf_G2 CTIB.wf_Sd_4 (by bm_strips CFSG.KC.BM.CTIB.cSd 69)

theorem seed_prod : stripMat Max2.G2 * stripMat Max2.G2 * stripMat Max2.G2 * stripMat Max2.G1 *
      stripMat Max2.G2 * stripMat Max2.G1 * stripMat Max2.G2 * stripMat Max2.G2 *
      stripMat Max2.G2 * stripMat Max2.G2 * stripMat Max2.G2 * stripMat Max2.G2 *
      stripMat Max2.G2 = stripMat CTIB.Sd :=
  ch2 (ch2 (ch2 (ch2 (ch2 seedc0 seedc1) seedc2) seedc3) seedc4) seedc5

theorem seed_eq : seedK = stripMat CTIB.Sd := by
  rw [seedK, seed_list]
  simp only [prodK, G1K, G2K, Matrix.mul_one, ← Matrix.mul_assoc]
  exact seed_prod

theorem sd_10 : stripMat CTIB.Sd ^ 10 = stripMat CTIB.H10 := by
  have h2 : stripMat CTIB.Sd ^ 2 = stripMat CTIB.Sd_sq1 := by
    rw [sq]
    exact sm1 CTIB.wf_Sd CTIB.wf_Sd (by bm_strips CFSG.KC.BM.CTIB.cSd_sq1 69)
  have h4 : stripMat CTIB.Sd ^ 4 = stripMat CTIB.Sd_sq2 :=
    sq_step h2 (sm1 (C := CTIB.Sd_sq2) CTIB.wf_Sd_sq1 CTIB.wf_Sd_sq1
      (by bm_strips CFSG.KC.BM.CTIB.cSd_sq2 69)) rfl
  have h8 : stripMat CTIB.Sd ^ 8 = stripMat CTIB.Sd_sq3 :=
    sq_step h4 (sm1 (C := CTIB.Sd_sq3) CTIB.wf_Sd_sq2 CTIB.wf_Sd_sq2
      (by bm_strips CFSG.KC.BM.CTIB.cSd_sq3 69)) rfl
  rw [(by norm_num : (10 : ℕ) = 2 + 8), pow_add, h2, h8]
  exact sm1 CTIB.wf_Sd_sq3 CTIB.wf_Sd_sq1 (by bm_strips CFSG.KC.BM.CTIB.cH10 69)

theorem hK_six : hK 6 = stripMat CTIB.H6 := by
  rw [hK, ite_eq_left rfl]
  exact g2_12

theorem hK_eight : hK 8 = G1K := by
  rw [hK, ite_eq_right (by decide), ite_eq_left rfl]

theorem hK_ten : hK 10 = stripMat CTIB.H10 := by
  rw [hK, ite_eq_right (by decide), ite_eq_right (by decide), ite_eq_left rfl, seed_eq]
  exact sd_10

theorem hK_zero : hK 0 = 1 := by
  rw [hK, ite_eq_right (by decide), ite_eq_right (by decide), ite_eq_right (by decide)]

