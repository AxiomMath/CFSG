local notation "MatB" => Matrix (Fin 4370) (Fin 4370) (ZMod 2)

set_option maxRecDepth 100000

theorem sm2 {A W V C : List Nat} (hW : wfMat W = true) (hV : wfMat V = true)
    (hA : wfMat A = true) (h : AllStrips [W, V] A C) :
    stripMat A * stripMat W * stripMat V = stripMat C := by
  have e := stripMat_mul_of_allStrips (wf2 hW hV) hA h
  rwa [List.map_cons, List.map_cons, List.map_nil, List.foldl_cons, List.foldl_cons,
    List.foldl_nil] at e

theorem ch1 {X Y A C : MatB} (h : X = Y) (h2 : Y * A = C) : X * A = C := by
  rw [h]
  exact h2

theorem ch2 {X Y A B C : MatB} (h : X = Y) (h2 : Y * A * B = C) : X * A * B = C := by
  rw [h]
  exact h2

theorem prod_ite_filter (f : ℕ → MatB) (p : ℕ → Bool) :
    ∀ L : List ℕ, prodK (L.map fun j => if p j = true then f j else 1) =
      prodK ((L.filter p).map f)
  | [] => rfl
  | j :: L => by
    rw [List.map_cons, prodK, prod_ite_filter f p L, List.filter_cons]
    by_cases h : p j = true
    · rw [ite_eq_left h, ite_eq_left h, List.map_cons, prodK]
    · rw [ite_eq_right h, ite_eq_right h, Matrix.one_mul]

theorem qK_of {m : ℕ} {L : List ℕ} (h22 : m.testBit 22 = false)
    (hL : (List.range 22).filter (fun j => m.testBit j) = L) : qK m = prodK (L.map EK) := by
  rw [qK, ite_eq_right (by rw [h22]; decide), Matrix.one_mul,
    prod_ite_filter EK (fun j => m.testBit j), hL]

theorem qK_x : qK 4194304 = XK := by
  have e : (List.range 22).filter (fun j => (4194304 : ℕ).testBit j) = [] := by decide
  rw [qK, ite_eq_left (by decide), prod_ite_filter EK (fun j => (4194304 : ℕ).testBit j), e,
    List.map_nil, prodK, Matrix.mul_one]

