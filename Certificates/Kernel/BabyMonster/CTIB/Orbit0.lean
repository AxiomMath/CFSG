@[expose] def o0w : List ℕ := o0w0 ++ o0w1 ++ o0w2 ++ o0w3 ++ o0w4 ++ o0w5 ++ o0w6 ++ o0w7

@[expose] noncomputable def incK (L : List ℕ) : ℕ → Bool :=
  List.rec (motive := fun _ => ℕ → Bool) (fun _ => true)
    (fun e _ ih prev => Nat.blt prev (eV e) && Nat.beq (eRec e) 0 && ih (eV e)) L

theorem incK_sound : ∀ (L : List ℕ) (prev : ℕ), incK L prev = true →
    (∀ e ∈ L, eRec e = 0) ∧ (L.map eV).Pairwise (· < ·) ∧ ∀ x ∈ L.map eV, prev < x
  | [], _, _ => ⟨fun _ h => absurd h List.not_mem_nil, List.Pairwise.nil,
      fun _ h => absurd h List.not_mem_nil⟩
  | e :: L, prev, h => by
    change (Nat.blt prev (eV e) && Nat.beq (eRec e) 0 && incK L (eV e)) = true at h
    simp only [Bool.and_eq_true, Nat.blt_eq, Nat.beq_eq] at h
    obtain ⟨⟨h1, h2⟩, h3⟩ := h
    obtain ⟨r, p, b⟩ := incK_sound L (eV e) h3
    refine ⟨fun x hx => ?_, ?_, fun x hx => ?_⟩
    · rcases List.mem_cons.1 hx with rfl | hx
      · exact h2
      · exact r x hx
    · rw [List.map_cons, List.pairwise_cons]
      exact ⟨b, p⟩
    · rw [List.map_cons, List.mem_cons] at hx
      rcases hx with rfl | hx
      · exact h1
      · exact lt_trans h1 (b x hx)

theorem o0_w0 : walksOK o0w0 = true := by quickRfl
theorem o0_w1 : walksOK o0w1 = true := by quickRfl
theorem o0_w2 : walksOK o0w2 = true := by quickRfl
theorem o0_w3 : walksOK o0w3 = true := by quickRfl
theorem o0_w4 : walksOK o0w4 = true := by quickRfl
theorem o0_w5 : walksOK o0w5 = true := by quickRfl
theorem o0_w6 : walksOK o0w6 = true := by quickRfl
theorem o0_w7 : walksOK o0w7 = true := by quickRfl

theorem o0_inc : incK o0w 0 = true := by quickRfl

theorem o0_len : o0w.length = 2300 := by decide +kernel

theorem o0_neg_walk : walksOK (o0w0.map (· ^^^ 1)) = false := by decide +kernel

theorem o0_neg_inc : incK (o0w1 ++ o0w0) 0 = false := by decide +kernel

theorem o0_walks : ∀ e ∈ o0w, walkOK e = true := by
  intro e he
  simp only [o0w, List.mem_append] at he
  rcases he with ((((((he | he) | he) | he) | he) | he) | he) | he
  · exact walksOK_mem o0_w0 e he
  · exact walksOK_mem o0_w1 e he
  · exact walksOK_mem o0_w2 e he
  · exact walksOK_mem o0_w3 e he
  · exact walksOK_mem o0_w4 e he
  · exact walksOK_mem o0_w5 e he
  · exact walksOK_mem o0_w6 e he
  · exact walksOK_mem o0_w7 e he

theorem o0_mem (hC : CensusLists) {u : ℕ} (hu : Reach censusAct 2 (rootOf 0) u) :
    u ∈ o0w.map eV := by
  obtain ⟨r, p, -⟩ := incK_sound o0w 0 o0_inc
  exact orbit_complete hC (by omega) (fun e he => ⟨o0_walks e he, r e he⟩)
    (p.imp (fun h => Nat.ne_of_lt h)) (by rw [o0_len]; rfl) hu

theorem o0_of_ty (hC : CensusLists) {n : ℕ} (h : innerTy innerTab n = 1) :
    n % 2 ^ 22 ∈ o0w.map eV := by
  by_cases h0 : n % 2 ^ 22 = 0
  · simp only [innerTy, h0, ↓reduceIte] at h
    split at h <;> omega
  · simp only [innerTy, h0, ↓reduceIte] at h
    exact o0_mem hC (reach_of_tab hC (by omega) h)

