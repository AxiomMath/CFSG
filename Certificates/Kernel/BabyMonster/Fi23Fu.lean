@[expose] def Good (M : List Nat) : Prop := wfMat M = true ∧ ∃ g : G, φ g = sm M

inductive Goods : List (List Nat) → Prop
  | nil : Goods []
  | cons {M : List Nat} {Ms : List (List Nat)} : Good φ M → Goods Ms → Goods (M :: Ms)

variable {φ}

theorem exists_foldl {Ms : List (List Nat)} (h : Goods φ Ms) :
    ∀ a : G, ∃ g : G, φ g = (Ms.map stripMat).foldl (· * ·) (φ a) := by
  induction h with
  | nil => exact fun a => ⟨a, rfl⟩
  | cons hM _ ih =>
    intro a
    obtain ⟨b, hb⟩ := hM.2
    obtain ⟨g, hg⟩ := ih (a * b)
    refine ⟨g, ?_⟩
    rw [hg, List.map_cons, List.foldl_cons, map_mul, hb]

theorem forall_wf {Ms : List (List Nat)} (h : Goods φ Ms) : ∀ W ∈ Ms, wfMat W = true := by
  induction h with
  | nil => simp
  | cons hM _ ih =>
    intro W hW
    rcases List.mem_cons.1 hW with rfl | hW
    · exact hM.1
    · exact ih W hW

theorem good_mul {A C : List Nat} {Ms : List (List Nat)} (hA : Good φ A)
    (hs : Goods φ Ms) (h : AllStrips2 Ms [] A C) (wC : wfMat C = true) :
    Good φ C := by
  obtain ⟨a, ha⟩ := hA.2
  obtain ⟨g, hg⟩ := exists_foldl hs a
  refine ⟨wC, g, ?_⟩
  rw [hg, ha]
  exact stripMat_mul_of_allStrips (forall_wf hs) hA.1 (allStrips_of_nil h)

theorem good_mulS {A C : List Nat} {Ms : List (List Nat)} (hA : Good φ A)
    (hs : Goods φ Ms) (h : AllStrips Ms A C) (wC : wfMat C = true) :
    Good φ C := by
  obtain ⟨a, ha⟩ := hA.2
  obtain ⟨g, hg⟩ := exists_foldl hs a
  refine ⟨wC, g, ?_⟩
  rw [hg, ha]
  exact stripMat_mul_of_allStrips (forall_wf hs) hA.1 h

theorem good_mul1 {A B C : List Nat} (hA : Good φ A) (hB : Good φ B) (h : AllStrips2 [B] [] A C)
    (wC : wfMat C = true) : Good φ C :=
  good_mul hA (.cons hB .nil) h wC

theorem good_mulS1 {A B C : List Nat} (hA : Good φ A) (hB : Good φ B) (h : AllStrips [B] A C)
    (wC : wfMat C = true) : Good φ C :=
  good_mulS hA (.cons hB .nil) h wC

theorem good_inv {A Ai : List Nat} (hA : Good φ A) (wAi : wfMat Ai = true)
    (h : AllStrips2 [Ai] [] A idStrips) : Good φ Ai := by
  obtain ⟨a, ha⟩ := hA.2
  have e := stripMat_mul_eq_one (Ws := [Ai]) (by simp [wAi]) hA.1 (allStrips_of_nil h)
  simp only [List.map_cons, List.map_nil, List.foldl_cons, List.foldl_nil] at e
  refine ⟨wAi, a⁻¹, ?_⟩
  calc φ a⁻¹ = φ a⁻¹ * (sm A * sm Ai) := by rw [e, mul_one]
    _ = sm Ai := by rw [← ha, ← mul_assoc, ← map_mul, inv_mul_cancel, map_one, one_mul]

theorem good_conj {Z R X : List Nat} (hR : Good φ R) (hX : Good φ X) (wZ : wfMat Z = true)
    (h : AllStrips2 [R] [X] Z R) : Good φ Z := by
  obtain ⟨r, hr⟩ := hR.2
  obtain ⟨x, hx⟩ := hX.2
  have e := stripMat_mul_eq_of_allStrips2 (Ws := [R]) (Ds := [X]) (by simp [hR.1])
    (by simp [hX.1]) wZ hR.1 h
  simp only [List.map_cons, List.map_nil, List.foldl_cons, List.foldl_nil] at e
  refine ⟨wZ, r * x * r⁻¹, ?_⟩
  calc φ (r * x * r⁻¹) = sm R * sm X * φ r⁻¹ := by rw [map_mul, map_mul, hr, hx]
    _ = sm Z * (φ r * φ r⁻¹) := by rw [← e, hr, mul_assoc]
    _ = sm Z := by rw [← map_mul, mul_inv_cancel, map_one, mul_one]

theorem eq_of_two_sided (hφ : Function.Injective φ) {k e x : G} {K E X : List Nat}
    (hk : φ k = sm K) (he : φ e = sm E) (hx : φ x = sm X) (wK : wfMat K = true)
    (wE : wfMat E = true) (wX : wfMat X = true) (h : AllStrips2 [E] [K] K X) : k * e = x * k := by
  have e' := stripMat_mul_eq_of_allStrips2 (Ws := [E]) (Ds := [K]) (by simp [wE]) (by simp [wK])
    wK wX h
  simp only [List.map_cons, List.map_nil, List.foldl_cons, List.foldl_nil] at e'
  exact hφ (by rw [map_mul, map_mul, hk, he, hx, e'])

end Phi

