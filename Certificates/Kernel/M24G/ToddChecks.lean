theorem toddUniq_ok : toddUniqF = true := by
  unfold toddUniqF uniqLoopF
  rw [toddCS_eq, toddBad_eq]
  exact SliceGlue.all_of_slices _ 256 8 _ (Nat.le_of_ble_eq_true (by quickRfl)) fun j hj =>
    match j, hj with
    | 0, _ => toddUniq_p0
    | 1, _ => toddUniq_p1
    | 2, _ => toddUniq_p2
    | 3, _ => toddUniq_p3
    | 4, _ => toddUniq_p4
    | 5, _ => toddUniq_p5
    | 6, _ => toddUniq_p6
    | 7, _ => toddUniq_p7
    | _ + 8, h => absurd h (by omega)

