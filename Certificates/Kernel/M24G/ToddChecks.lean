  eq_of_beq (by quickRfl)

theorem toddCS_eq : toddVals.map (colsOf 11) = toddCS :=
  SliceGlue.map_eq_of_getD _ [] [] _ _ (Nat.eq_of_beq_eq_true (by quickRfl)) fun i hi => by
    have hl : toddVals.length = 5 := Nat.eq_of_beq_eq_true (by quickRfl)
    exact match i, hi with
      | 0, _ => toddCS_c0
      | 1, _ => toddCS_c1
      | 2, _ => toddCS_c2
      | 3, _ => toddCS_c3
      | 4, _ => toddCS_c4
      | _ + 5, h => absurd h (by rw [hl]; omega)

theorem toddBad_eq : badMask (Native.octsT Native.baseTrio) = toddBad :=
