@[expose] noncomputable def wK (wd : List Nat) : Nat := wordTabK 35 6 (mask 6) (pidn 35 6) MXE.G wd

@[expose] noncomputable def ltAll (b : Nat) (w : List Nat) : Bool :=
  List.rec (motive := fun _ => Bool) true (fun j _ ih => bAnd(Nat.blt j b, ih)) w

@[expose] noncomputable def wKI (wd : List Nat) : Nat := wordTabK 35 6 (mask 6) (pidn 35 6) MXI wd

@[expose] noncomputable def nclY (x : Nat) (u : List Nat) : Nat :=
  pcomp 35 6 (mask 6) (pcomp 35 6 (mask 6) (wK u) x) (wKI u.reverse)

@[expose] noncomputable def nclK (x c : Nat) : Bool :=
  bAnd(allN 5 (fun i => bAnd(ltAll 2 (lget2 nclCW (Nat.add (Nat.mul 5 c) i)),
      Nat.beq (pcomp 35 6 (mask 6) (wKI (List.reverse (lget2 nclCW (Nat.add (Nat.mul 5 c) i))))
        (wK (lget2 nclCW (Nat.add (Nat.mul 5 c) i)))) (pidn 35 6))),
    allN 2 (fun j => bAnd(ltAll 5 (lget2 nclWW (Nat.add (Nat.mul 2 c) j)),
      Nat.beq (wordTabK 35 6 (mask 6) (pidn 35 6)
        (fun i => nclY x (lget2 nclCW (Nat.add (Nat.mul 5 c) i)))
        (lget2 nclWW (Nat.add (Nat.mul 2 c) j)))
        (MXE.G j))))

@[expose] noncomputable def sylK (cnt p : Nat) (T : Nat → Nat) (I : List Nat) : Bool :=
  allN cnt (fun k => bIf(Nat.beq (T k) (pidn 35 6), true,
    bIf(Nat.beq (wordTabK 35 6 (mask 6) (pidn 35 6) (fun _ => T k) (List.replicate p 0))
      (pidn 35 6), nclK (T k) (nget I k), true)))

