@[expose] noncomputable def nWitQ (V : List ℕ) (w : ℕ) : Bool :=
  Nat.blt w 1024 && (List.range 9).all fun i => V.getD i 0 == MK (w % 128) (sAutData.P (w / 128) i)

theorem nWit_exists {α : Type} (Q : α → ℕ → Bool) : ∀ (L : List α) (W : List ℕ),
    L.length = W.length → (L.zip W).all (fun p => Q p.1 p.2) = true → ∀ a ∈ L, ∃ w, Q a w = true
  | [], _, _, _, a, ha => absurd ha List.not_mem_nil
  | _ :: _, [], h, _, _, _ => absurd h (by simp)
  | x :: t, w :: W, h, hz, a, ha => by
    rw [List.zip_cons_cons, List.all_cons, Bool.and_eq_true] at hz
    rcases List.mem_cons.1 ha with rfl | ha
    · exact ⟨w, hz.1⟩
    · exact nWit_exists Q t W (by simpa using h) hz.2 a ha

