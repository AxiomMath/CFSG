set_option maxHeartbeats 0 in
theorem check2_n : ((nSearch 9 7 sAutData.M sAutData.cb sAutData.olen).all fun V =>
    (List.range 8).any fun k => (List.range 128).any fun e =>
      (List.range 9).all fun i => V.getD i 0 == sAutData.M e (sAutData.P k i)) = true := by
  rw [nSearch_eq, List.all_map, M_eq, List.all_eq_true]
  intro st hst
  obtain ⟨w, hw⟩ := nWit_exists (fun st w => nWitQ st.1 w) (nSt 9) nWit
    (by decide +kernel) nWit_ok st hst
  rw [nWitQ, Bool.and_eq_true, Nat.blt_eq] at hw
  exact List.any_eq_true.2 ⟨w / 128, List.mem_range.2 (by omega), List.any_eq_true.2
    ⟨w % 128, List.mem_range.2 (Nat.mod_lt _ (by norm_num)), hw.2⟩⟩

