    (List.range 136).map fun i => fget (permAt 136 8 PMinus 0) i 8 := by decide +kernel
theorem pArr1 : (Model.pArr .minus 1).toList =
    (List.range 136).map fun i => fget (permAt 136 8 PMinus 1) i 8 := by decide +kernel
