theorem e32_stepOKK {k : Nat} {A B : List (List Tab)} {I : List Tab} {W : List Nat}
    (hA : elemLevel s0Tabs k = A) (hB : elemLevel s0Tabs (k + 1) = B) (hI : invTabs s0Tabs = I)
    (hs : B.all e32Asc = true) (h : e32StepW B I A W = true)
    (hl : ∀ L ∈ B, L.length = 2 ^ (k + 2)) : StepOKK s0Tabs k := by
  unfold StepOKK
  rw [hA, hB, hI]
  exact ⟨e32_stepW_sound (e32_all_asc hs) A W h, hl⟩

