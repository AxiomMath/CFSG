def e32NormG (G L : List Tab) : Bool :=
  G.all fun g => L.all fun l => L.any fun l' => decide (tmul g l = tmul l' g)

def e32Asc : List Tab → Bool
  | a :: b :: l => tabLE a b && !tabLE b a && e32Asc (b :: l)
  | _ => true

theorem e32_asc_lt : ∀ (a : Tab) (l : List Tab), e32Asc (a :: l) = true →
    ∀ c ∈ l, tabLE a c = true ∧ tabLE c a = false
  | _, [], _, _, hc => by simp at hc
  | a, b :: l, h, c, hc => by
    simp only [e32Asc, Bool.and_eq_true, Bool.not_eq_true'] at h
    rcases List.mem_cons.1 hc with rfl | hc'
    · exact h.1
    · have ih := e32_asc_lt b l h.2 c hc'
      refine ⟨tabLE_trans _ _ _ h.1.1 ih.1, ?_⟩
      cases hca : tabLE c a
      · rfl
      · have hba := tabLE_trans _ _ _ ih.1 hca
        rw [h.1.2] at hba
        exact absurd hba Bool.false_ne_true

theorem e32_asc_sound : ∀ l : List Tab, e32Asc l = true → l.Pairwise tabR ∧ l.Nodup
  | [], _ => ⟨List.Pairwise.nil, List.nodup_nil⟩
  | a :: l, h => by
    have hl : e32Asc l = true := by
      cases l with
      | nil => rfl
      | cons b l =>
        simp only [e32Asc, Bool.and_eq_true] at h
        exact h.2
    have ih := e32_asc_sound l hl
    have hlt := e32_asc_lt a l h
    refine ⟨List.Pairwise.cons (fun c hc => (hlt c hc).1) ih.1, List.Nodup.cons ?_ ih.2⟩
    intro ha
    exact Bool.false_ne_true ((hlt a ha).2.symm.trans (hlt a ha).1)

theorem e32_all_asc {B : List (List Tab)} (h : B.all e32Asc = true) :
    ∀ M ∈ B, M.Pairwise tabR ∧ M.Nodup :=
  fun M hM => e32_asc_sound M (List.all_eq_true.1 h M hM)

noncomputable def e32At (L : List Tab) (x m : Tab) (r : Nat) : Bool :=
  Bool.rec (decide ((L[Nat.sub r L.length]?).map (tmul x) = some m)) (decide (L[r]? = some m))
    (Nat.blt r L.length)

theorem e32_at_sound {L : List Tab} {x m : Tab} {r : Nat} (h : e32At L x m r = true) :
    m ∈ ext L x := by
  unfold e32At at h
  rw [ext, List.mem_append]
  cases hr : Nat.blt r L.length
  · rw [hr] at h
    obtain ⟨l, hl, he⟩ := Option.map_eq_some_iff.1 (of_decide_eq_true h)
    exact Or.inr (List.mem_map.2 ⟨l, List.mem_of_getElem? hl, he⟩)
  · rw [hr] at h
    exact Or.inl (List.mem_of_getElem? (of_decide_eq_true h))

noncomputable def e32Sub (L : List Tab) (x : Tab) (M : List Tab) : Nat → Bool :=
  M.rec (fun _ => true) fun m _ r P =>
    Bool.rec false (r (Nat.div P 64)) (e32At L x m (Nat.mod P 64))

theorem e32_sub_sound {L : List Tab} {x : Tab} :
    ∀ (M : List Tab) (P : Nat), e32Sub L x M P = true → ∀ m ∈ M, m ∈ ext L x
  | [], _, _, m, hm => by simp at hm
  | m' :: M, P, h, m, hm => by
    have h' : (e32At L x m' (Nat.mod P 64) && e32Sub L x M (Nat.div P 64)) = true := h
    rw [Bool.and_eq_true] at h'
    rcases List.mem_cons.1 hm with rfl | hm'
    · exact e32_at_sound h'.1
    · exact e32_sub_sound M _ h'.2 m hm'

noncomputable def e32Cand (L : List Tab) (B : List (List Tab)) (x : Tab) (i P : Nat) : Bool :=
  Nat.blt i B.length && Nat.beq (B.getD i []).length (L.length + L.length) &&
    e32Sub L x (B.getD i []) P

theorem e32_cand_sound {L : List Tab} {B : List (List Tab)} {x : Tab} {i P : Nat}
    (hB : ∀ M ∈ B, M.Pairwise tabR ∧ M.Nodup) (h : e32Cand L B x i P = true) :
    isortK (ext L x) ∈ B := by
  simp only [e32Cand, Bool.and_eq_true, Nat.blt_eq, Nat.beq_eq] at h
  obtain ⟨⟨hi, hl⟩, hs⟩ := h
  have hM : B.getD i [] ∈ B := by
    rw [List.getD_eq_getElem _ _ hi]
    exact List.getElem_mem hi
  have hp : (B.getD i []).Perm (ext L x) := by
    refine ((hB _ hM).2.subperm (e32_sub_sound _ P hs)).perm_of_length_le ?_
    rw [hl, ext, List.length_append, List.length_map]
  have he : isortK (ext L x) = B.getD i [] := by
    rw [isortK_eq]
    exact List.Perm.eq_of_pairwise' (List.pairwise_insertionSort tabR _) (hB _ hM).1
      ((List.perm_insertionSort tabR _).trans hp.symm)
  rw [he]
  exact hM

noncomputable def e32Code (L : List Tab) (B : List (List Tab)) (x : Tab) (c P : Nat) : Bool :=
  Bool.rec
    (Bool.rec (e32Cand L B x (Nat.sub c 34) P)
      (Bool.rec false (!comm x (L.getD (Nat.sub c 2) [])) (decide (Nat.sub c 2 < L.length)))
      (Nat.blt c 34))
    (decide (x ∈ L)) (Nat.beq c 1)

noncomputable def e32Walk (L : List Tab) (B : List (List Tab)) (I : List Tab) : Nat → Bool :=
  I.rec (fun _ => true) fun x _ r c =>
    Bool.rec false
      (r (Nat.div c (Bool.rec 128 (Nat.mul 128 (Nat.pow 64 (L.length + L.length)))
        (Nat.blt 33 (Nat.mod c 128)))))
      (e32Code L B x (Nat.mod c 128) (Nat.div c 128))

noncomputable def e32StepW (B : List (List Tab)) (I : List Tab) (A : List (List Tab)) :
    List Nat → Bool :=
  A.rec (fun _ => true) fun L _ r W => Bool.rec false (r W.tail) (e32Walk L B I (W.headD 0))

theorem e32_code_sound {L : List Tab} {B : List (List Tab)} {x : Tab} {c P : Nat}
    (hB : ∀ M ∈ B, M.Pairwise tabR ∧ M.Nodup)
    (h : e32Code L B x c P = true) (hx : x ∉ L) (hc : L.all (comm x) = true) :
    isortK (ext L x) ∈ B := by
  unfold e32Code at h
  cases h1 : Nat.beq c 1
  · rw [h1] at h
    cases h2 : Nat.blt c 34
    · rw [h2] at h
      exact e32_cand_sound hB h
    · rw [h2] at h
      have h' : (decide (Nat.sub c 2 < L.length) && !comm x (L.getD (Nat.sub c 2) [])) = true := h
      rw [Bool.and_eq_true, decide_eq_true_eq] at h'
      obtain ⟨hl, hn⟩ := h'
      have hm : L.getD (Nat.sub c 2) [] ∈ L := by
        rw [List.getD_eq_getElem _ _ hl]
        exact List.getElem_mem hl
      rw [List.all_eq_true] at hc
      rw [hc _ hm] at hn
      exact absurd hn (by decide)
  · rw [h1] at h
    exact absurd (of_decide_eq_true h) hx

theorem e32_walk_sound {L : List Tab} {B : List (List Tab)}
    (hB : ∀ M ∈ B, M.Pairwise tabR ∧ M.Nodup) :
    ∀ (I : List Tab) (c : Nat), e32Walk L B I c = true →
      ∀ x ∈ I, x ∉ L → L.all (comm x) = true → isortK (ext L x) ∈ B
  | [], _, _, x, hx => by simp at hx
  | y :: I, c, h, x, hx => by
    have h' : (e32Code L B y (Nat.mod c 128) (Nat.div c 128) &&
        e32Walk L B I (Nat.div c (Bool.rec 128 (Nat.mul 128 (Nat.pow 64 (L.length + L.length)))
          (Nat.blt 33 (Nat.mod c 128))))) = true := h
    rw [Bool.and_eq_true] at h'
    rcases List.mem_cons.1 hx with rfl | hx'
    · exact e32_code_sound hB h'.1
    · exact e32_walk_sound hB I _ h'.2 x hx'

theorem e32_stepW_sound {B : List (List Tab)} {I : List Tab}
    (hB : ∀ M ∈ B, M.Pairwise tabR ∧ M.Nodup) :
    ∀ (A : List (List Tab)) (W : List Nat), e32StepW B I A W = true →
      ∀ L ∈ A, ∀ x ∈ extCands I L, isortK (ext L x) ∈ B
  | [], _, _, _, hL, _, _ => by simp at hL
  | L' :: A, W, h, L, hL, x, hx => by
    have h' : (e32Walk L' B I (W.headD 0) && e32StepW B I A W.tail) = true := h
    rw [Bool.and_eq_true] at h'
    rcases List.mem_cons.1 hL with rfl | hL'
    · rw [extCands, List.mem_filter, Bool.and_eq_true, decide_eq_true_eq] at hx
      exact e32_walk_sound hB I _ h'.1 x hx.1 hx.2.1 hx.2.2
    · exact e32_stepW_sound hB A W.tail h'.2 L hL' x hx

def e32RestL (J G F L : List Tab) : Bool :=
  decide L.Nodup && (decide (4 < (L.filter fun l => decide (l ∈ J)).length ∨ ∀ l ∈ L, l ∈ F) ||
    !e32NormG G L)

theorem e32_restL {J G F : List Tab} {A : List (List Tab)} (h : A.all (e32RestL J G F) = true) :
    ∀ L ∈ A, L.Nodup ∧ (e32NormG G L = true →
      4 < (L.filter fun l => decide (l ∈ J)).length ∨ ∀ l ∈ L, l ∈ F) := by
  intro L hL
  have h1 := List.all_eq_true.1 h L hL
  simp only [e32RestL, Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq,
    Bool.not_eq_true'] at h1
  refine ⟨h1.1, fun hn => ?_⟩
  rcases h1.2 with h2 | h2
  · exact h2
  · rw [hn] at h2
    exact absurd h2 (by decide)

