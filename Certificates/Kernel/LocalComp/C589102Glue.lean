theorem centK_pt {n w N r m : Nat} {T I CT : Nat → Nat} (h : centK n w N T r m I CT = true) :
    ∀ k < m, ∃ j < N, CT k = T j := by
  intro k hk
  unfold centK at h
  rw [CFSG.KC.BfsPin.strictB_app] at h
  have h1 := CFSG.KS.Raw.Orb.allN_iff.1 (CFSG.KC.L34KSnd.andB_iff.1 h).2 k hk
  rw [CFSG.KC.BfsPin.strictB_app] at h1
  obtain ⟨h2, h3⟩ := CFSG.KC.L34KSnd.andB_iff.1 h1
  obtain ⟨-, h5⟩ := CFSG.KC.L34KSnd.andB_iff.1 h3
  obtain ⟨-, h7⟩ := CFSG.KC.L34KSnd.andB_iff.1 h5
  exact ⟨I k, Nat.blt_eq.mp h2, Nat.eq_of_beq_eq_true h7⟩

