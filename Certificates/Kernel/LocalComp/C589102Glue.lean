theorem ktOrbitS_facts :
    orbitOK 42 gensS (gensS.map (invTab 42)) (ktR1 ()) (ktOrbitS ()) = true ∧
      (ktOrbitS ()).tabs.size = 315 := by
  have h := orbitS_ok
  unfold Certificates.Data.S1277Kt.ktOrbitSOK at h
  simpa only [Bool.and_eq_true, beq_iff_eq] using h

theorem orbitS_sub_orbitR
    {t : Tab} (ht : t ∈ (ktOrbitS ()).tabs.toList) : t ∈ (orbitR r₁T).tabs.toList := by
  obtain ⟨hs, -, -⟩ := conj_orbit gensS_cover gensS_tabs tabRep_r₁ ktOrbitS_facts.1
  obtain ⟨c, hc, hrep⟩ := hs t ht
  have hcR : c ∈ R := S_le_R hc
  have hyR : c * r₁ * c⁻¹ ∈ R := R.mul_mem (R.mul_mem hcR r₁_mem_R) (R.inv_mem hcR)
  have hconj : IsConj (⟨c * r₁ * c⁻¹, hyR⟩ : ↥R) r₁R := by
    refine IsConj.symm (isConj_iff.2 ⟨⟨c, hcR⟩, ?_⟩)
    exact Subtype.ext (by simp [r₁R, mul_assoc])
  obtain ⟨t', ht', hrep'⟩ := (conjClass₁.1 _).1 hconj
  have htt : t = t' := hrep.tab_eq hrep'
  rw [htt]
  exact ht'

theorem orbitR_sub_orbitS
    {t : Tab} (ht : t ∈ (orbitR r₁T).tabs.toList) : t ∈ (ktOrbitS ()).tabs.toList := by
  obtain ⟨-, -, hnS⟩ := conj_orbit gensS_cover gensS_tabs tabRep_r₁ ktOrbitS_facts.1
  obtain ⟨-, -, hnR⟩ := conj_orbit gTabs_cover gTabs_tabs tabRep_r₁ certFacts.orbit₁
  have hlenR : (orbitR r₁T).tabs.toList.toFinset.card = 315 := by
    rw [List.toFinset_card_of_nodup hnR, Array.length_toList, certFacts.size₁]
  have hlenS : (ktOrbitS ()).tabs.toList.toFinset.card = 315 := by
    rw [List.toFinset_card_of_nodup hnS, Array.length_toList, ktOrbitS_facts.2]
  have hsub : (ktOrbitS ()).tabs.toList.toFinset ⊆ (orbitR r₁T).tabs.toList.toFinset :=
    fun x hx => List.mem_toFinset.2 (orbitS_sub_orbitR (List.mem_toFinset.1 hx))
  have heq := Finset.eq_of_subset_of_card_le hsub (by rw [hlenR, hlenS])
  have : t ∈ (ktOrbitS ()).tabs.toList.toFinset := by
    rw [heq]
    exact List.mem_toFinset.2 ht
  exact List.mem_toFinset.1 this

theorem model_inv
    {x y : Equiv.Perm (Fin 42)} (hx : x ∈ S) (hy : y ∈ S) (hx2 : x * x = 1) (hx1 : x ≠ 1)
    (hy2 : y * y = 1) (hy1 : y ≠ 1) : ∃ g ∈ S, g * x * g⁻¹ = y := by
  have key : ∀ z : Equiv.Perm (Fin 42), z ∈ S → z * z = 1 → z ≠ 1 →
      ∃ c ∈ S, c * r₁ * c⁻¹ = z := by
    intro z hz hz2 hz1
    let zR : ↥R := ⟨z, S_le_R hz⟩
    have hsq : zR ^ 2 = 1 := Subtype.ext (by simpa [pow_two] using hz2)
    have hne : zR ≠ 1 := fun h => hz1 (congrArg Subtype.val h)
    have hord : orderOf zR = 2 := orderOf_eq_prime hsq hne
    rcases (orderOf_eq_two_iff zR).1 hord with h | h | h | h
    · obtain ⟨t, htL, htz⟩ := (conjClass₁.1 zR).1 h
      obtain ⟨hs, -, -⟩ := conj_orbit gensS_cover gensS_tabs tabRep_r₁ ktOrbitS_facts.1
      obtain ⟨c, hc, hrep⟩ := hs t (orbitR_sub_orbitS htL)
      exact ⟨c, hc, hrep.perm_eq htz⟩
    · exact absurd hz (not_mem_S_of_isConj h not_mem_S_r₂)
    · exact absurd hz (not_mem_S_of_isConj h not_mem_S_r₃)
    · exact absurd hz (not_mem_S_of_isConj h not_mem_S_r₄)
  obtain ⟨c, hc, hcz⟩ := key x hx hx2 hx1
  obtain ⟨d, hd, hdy⟩ := key y hy hy2 hy1
  refine ⟨d * c⁻¹, S.mul_mem hd (S.inv_mem hc), ?_⟩
  rw [← hcz, ← hdy]
  group

theorem model_inv_sub
    (a b : ↥S) (ha2 : a ^ 2 = 1) (ha1 : a ≠ 1) (hb2 : b ^ 2 = 1) (hb1 : b ≠ 1) :
    ∃ g : ↥S, g * a * g⁻¹ = b := by
  have h1 : (a : Equiv.Perm (Fin 42)) * a = 1 := by
    have h := congrArg Subtype.val ha2
    simpa [pow_two] using h
  have h2 : (b : Equiv.Perm (Fin 42)) * b = 1 := by
    have h := congrArg Subtype.val hb2
    simpa [pow_two] using h
  have h3 : (a : Equiv.Perm (Fin 42)) ≠ 1 := fun h => ha1 (Subtype.ext h)
  have h4 : (b : Equiv.Perm (Fin 42)) ≠ 1 := fun h => hb1 (Subtype.ext h)
  obtain ⟨g, hg, hgab⟩ := model_inv a.2 b.2 h1 h3 h2 h4
  exact ⟨⟨g, hg⟩, Subtype.ext (by simpa using hgab)⟩

theorem ktSInv_model : KtSInv := by
  intro G0 _ _ hG0 a b ha2 ha1 hb2 hb1
  obtain ⟨e⟩ := nonempty_equiv_of_stated G0 hG0
  have h1 : e a ^ 2 = 1 := by rw [← map_pow, ha2, map_one]
  have h2 : e a ≠ 1 := fun h => ha1 (e.injective (by rw [h, map_one]))
  have h3 : e b ^ 2 = 1 := by rw [← map_pow, hb2, map_one]
  have h4 : e b ≠ 1 := fun h => hb1 (e.injective (by rw [h, map_one]))
  obtain ⟨g', hg'⟩ := model_inv_sub (e a) (e b) h1 h2 h3 h4
  refine ⟨e.symm g', ?_⟩
  apply e.injective
  simpa [map_mul, map_inv] using hg'

abbrev E16Body (G : Type) [Group G] (A : Subgroup G) : Prop :=
  ∃ B : Subgroup G, IsElemAbelian 2 B ∧ Nat.card ↥B = 16 ∧ Nat.card ↥(B ⊓ A) = 4 ∧
    B ≤ Subgroup.normalizer (A : Set G) ∧
    ∃ k : Fin 5 → G, k 0 = 1 ∧ (∀ i, k i ∈ Subgroup.normalizer (B : Set G)) ∧
      ∀ i j, i ≠ j → ∀ x ∈ B, (∃ a ∈ A, x = k i * a * (k i)⁻¹) →
        (∃ a ∈ A, x = k j * a * (k j)⁻¹) → x = 1

theorem comm_of_isElemAbelian {G : Type} [Group G] {p : ℕ} {E : Subgroup G}
    (hE : IsElemAbelian p E) {x y : G} (hx : x ∈ E) (hy : y ∈ E) : x * y = y * x :=
  congrArg Subtype.val (hE.1.is_comm.comm ⟨x, hx⟩ ⟨y, hy⟩)

theorem isElemAbelian_of_comm_pow {G : Type} [Group G] (p : ℕ) (E : Subgroup G)
    (hc : ∀ x ∈ E, ∀ y ∈ E, x * y = y * x) (hp : ∀ x ∈ E, x ^ p = 1) : IsElemAbelian p E :=
  ⟨⟨⟨fun a b => Subtype.ext (hc a a.2 b b.2)⟩⟩, hp⟩

theorem isElemAbelian_map_hom {G H : Type} [Group G] [Group H] {p : ℕ} {E : Subgroup G}
    (f : G →* H) (hE : IsElemAbelian p E) : IsElemAbelian p (E.map f) := by
  apply isElemAbelian_of_comm_pow
  · intro x hx y hy
    obtain ⟨x', hx', rfl⟩ := Subgroup.mem_map.mp hx
    obtain ⟨y', hy', rfl⟩ := Subgroup.mem_map.mp hy
    rw [← map_mul, ← map_mul, comm_of_isElemAbelian hE hx' hy']
  · intro x hx
    obtain ⟨x', hx', rfl⟩ := Subgroup.mem_map.mp hx
    rw [← map_pow, hE.2 x' hx', map_one]

theorem E16Body.of_equiv {G H : Type} [Group G] [Group H] (e : G ≃* H) {A : Subgroup G}
    (h : E16Body H (A.map e.toMonoidHom)) : E16Body G A := by
  obtain ⟨B, hB, hBc, hBA, hBN, k, hk0, hkN, hk⟩ := h
  have hAe : ∀ g : G, g ∈ A ↔ e g ∈ A.map e.toMonoidHom := fun g => by
    rw [Subgroup.mem_map_equiv]
    simp
  have hBe : ∀ g : G, g ∈ B.map e.symm.toMonoidHom ↔ e g ∈ B := fun g => by
    rw [Subgroup.mem_map_equiv]
    simp
  refine ⟨B.map e.symm.toMonoidHom, isElemAbelian_map_hom _ hB, ?_, ?_, ?_,
    fun i => e.symm (k i), ?_, ?_, ?_⟩
  · rw [Subgroup.card_map_of_injective e.symm.injective]
    exact hBc
  · have hmap1 : (B.map e.symm.toMonoidHom).map e.toMonoidHom = B := by
      rw [Subgroup.map_map]
      have h1 : e.toMonoidHom.comp e.symm.toMonoidHom = MonoidHom.id H := by
        ext x
        simp
      rw [h1, Subgroup.map_id]
    have h2 := Subgroup.card_map_of_injective (K := B.map e.symm.toMonoidHom ⊓ A)
      (f := e.toMonoidHom) e.injective
    rw [Subgroup.map_inf_eq _ _ _ e.injective, hmap1] at h2
    rw [← h2]
    exact hBA
  · intro x hx
    rw [Subgroup.mem_normalizer_iff]
    intro h
    have hx' : e x ∈ B := (hBe x).1 hx
    have key := Subgroup.mem_normalizer_iff.1 (hBN hx') (e h)
    have hconj : e (x * h * x⁻¹) = e x * e h * (e x)⁻¹ := by simp
    rw [hAe h, hAe (x * h * x⁻¹), hconj]
    exact key
  · change e.symm (k 0) = 1
    rw [hk0, map_one]
  · intro i
    rw [Subgroup.mem_normalizer_iff]
    intro h
    have hkey := Subgroup.mem_normalizer_iff.1 (hkN i) (e h)
    have hconj : e (e.symm (k i) * h * (e.symm (k i))⁻¹) = k i * e h * (k i)⁻¹ := by simp
    rw [hBe h, hBe (e.symm (k i) * h * (e.symm (k i))⁻¹), hconj]
    exact hkey
  · intro i j hij x hx ⟨a, ha, hxa⟩ ⟨b, hb, hxb⟩
    have hex : e x ∈ B := (hBe x).1 hx
    have hxa' : e x = k i * e a * (k i)⁻¹ := by
      rw [hxa]
      simp
    have hxb' : e x = k j * e b * (k j)⁻¹ := by
      rw [hxb]
      simp
    have h1 := hk i j hij (e x) hex ⟨e a, (hAe a).1 ha, hxa'⟩ ⟨e b, (hAe b).1 hb, hxb'⟩
    exact e.injective (by rw [h1, map_one])

abbrev Cn (p : Nat) : Prop := canonK 42 6 (mask 6) (42 * 6) p = true

theorem mem_pts {N : Nat} {T : Nat → Nat} {t : Tab} :
    t ∈ (pts 42 6 N T).toList ↔ ∃ i < N, unpack 42 6 (T i) = t := by
  unfold pts
  rw [Array.mem_toList_iff, Array.mem_ofFn]
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨i.1, i.2, rfl⟩
  · rintro ⟨i, hi, rfl⟩
    exact ⟨⟨i, hi⟩, rfl⟩

theorem rep_pc {p q : Nat} {g h : Equiv.Perm (Fin 42)} (hp : Cn p) (hq : Cn q)
    (hg : TabRep (unpack 42 6 p) g) (hh : TabRep (unpack 42 6 q) h) :
    TabRep (unpack 42 6 (pc42 p q)) (g * h) := by
  unfold pc42
  rw [← CFSG.KC.L34KSnd.comp_unpack' hp hq]
  exact hg.comp hh

theorem cn_pc {p q : Nat} (hp : Cn p) (hq : Cn q) : Cn (pc42 p q) :=
  CFSG.KC.BfsPin.canonK_pcomp hp hq

theorem rep_eq {p q : Nat} {g h : Equiv.Perm (Fin 42)} (hp : Cn p) (hq : Cn q)
    (hg : TabRep (unpack 42 6 p) g) (hh : TabRep (unpack 42 6 q) h) : p = q ↔ g = h := by
  constructor
  · rintro rfl
    exact hg.perm_eq hh
  · rintro rfl
    exact CFSG.KC.L34KSnd.unpack_inj' hp hq (hg.tab_eq hh)

theorem pc_eq_iff {p q r s : Nat} {g h k l : Equiv.Perm (Fin 42)} (hp : Cn p) (hq : Cn q)
    (hr : Cn r) (hs : Cn s) (hg : TabRep (unpack 42 6 p) g) (hh : TabRep (unpack 42 6 q) h)
    (hk : TabRep (unpack 42 6 r) k) (hl : TabRep (unpack 42 6 s) l) :
    pc42 p q = pc42 r s ↔ g * h = k * l :=
  rep_eq (cn_pc hp hq) (cn_pc hr hs) (rep_pc hp hq hg hh) (rep_pc hr hs hk hl)

