theorem comp_idTab {t : Tab} (ht : t.size = 42) : comp 42 t (idTab 42) = t := by
  apply Array.ext (by rw [ht]; exact Array.size_ofFn)
  intro i h1 h2
  have hi : i < 42 := by simpa [comp] using h1
  simp only [comp, Array.getElem_ofFn]
  rw [show (idTab 42)[i]! = i by
    simp only [idTab]
    rw [getElem!_pos _ i (by simpa using hi), Array.getElem_ofFn], getElem!_pos t i h2]

theorem enumerates_of_sub {K : Subgroup (Equiv.Perm (Fin 42))} {L M : List Tab}
    (hK : Enumerates K L) (hM : M.Nodup) (hLM : ∀ t ∈ L, t ∈ M) (hlen : L.length = M.length) :
    Enumerates K M := by
  have hML : ∀ t ∈ M, t ∈ L := by
    have hsub : L.toFinset ⊆ M.toFinset := fun t ht =>
      List.mem_toFinset.2 (hLM t (List.mem_toFinset.1 ht))
    have hcardL : L.toFinset.card = M.toFinset.card := by
      rw [List.toFinset_card_of_nodup hK.nodup, List.toFinset_card_of_nodup hM, hlen]
    have heq := Finset.eq_of_subset_of_card_le hsub (le_of_eq hcardL.symm)
    intro t ht
    have : t ∈ L.toFinset := by
      rw [heq]
      exact List.mem_toFinset.2 ht
    exact List.mem_toFinset.1 this
  refine ⟨fun t ht => hK.sound t (hML t ht), fun g hg => ?_, hM⟩
  obtain ⟨t, ht, hr⟩ := hK.complete g hg
  exact ⟨t, hLM t ht, hr⟩

theorem enumerates_of_complete {K : Subgroup (Equiv.Perm (Fin 42))} {M : List Tab}
    (hM : M.Nodup) (hc : ∀ g ∈ K, ∃ t ∈ M, TabRep t g) (hcard : Nat.card ↥K = M.length) :
    Enumerates K M := by
  classical
  have hF : Enumerates K (M.filter fun t => decide (∃ g ∈ K, TabRep t g)) := by
    refine ⟨fun t ht => ?_, fun g hg => ?_, hM.filter _⟩
    · exact of_decide_eq_true (List.mem_filter.1 ht).2
    · obtain ⟨t, ht, hr⟩ := hc g hg
      exact ⟨t, List.mem_filter.2 ⟨ht, decide_eq_true ⟨g, hg, hr⟩⟩, hr⟩
  refine enumerates_of_sub hF hM (fun t ht => (List.mem_filter.1 ht).1) ?_
  rw [← hF.card, hcard]

theorem cn_E1 {i : Nat} (hi : i < 16) : Cn (K589E1.T i) :=
  CFSG.KC.BfsPin.bfsK_canon K589E1.ok i hi

theorem cn_E2 {i : Nat} (hi : i < 16) : Cn (K589E2.T i) :=
  CFSG.KC.BfsPin.bfsK_canon K589E2.ok i hi

theorem pin_facts {G : Array Tab} {T : Nat → Nat}
    (h : enumOK 42 G (enumBFS 42 G 16) = true ∧ (enumBFS 42 G 16).tabs = pts 42 6 16 T) :
    (pts 42 6 16 T).toList.Nodup ∧ idTab 42 ∈ (pts 42 6 16 T).toList ∧
      ∀ j < G.size, comp 42 G[j]! (idTab 42) ∈ (pts 42 6 16 T).toList := by
  have h1 := h.1
  unfold enumOK at h1
  obtain ⟨hpos, h0, hnd, hcl, -⟩ := treeOK_spec h1
  rw [h.2] at hpos h0 hnd hcl
  refine ⟨hnd, ?_, fun j hj => ?_⟩
  · rw [← h0]
    exact getElem!_mem hpos
  · have := hcl 0 hpos j hj
    rw [h0] at this
    exact this

theorem classify_E16
    {E : Subgroup (Equiv.Perm (Fin 42))} (hES : E ≤ S)
    (hcomm : ∀ x ∈ E, ∀ y ∈ E, x * y = y * x) (hsq : ∀ x ∈ E, x * x = 1)
    (hcard : Nat.card ↥E = 16) (hr : r₁ ∈ E) :
    Enumerates E (pts 42 6 16 K589E1.T).toList ∨ Enumerates E (pts 42 6 16 K589E2.T).toList := by
  obtain ⟨hcA, hcB⟩ := clsK_sound k589102cls
  obtain ⟨hnd1, hid1, -⟩ := pin_facts hE1
  obtain ⟨hnd2, hid2, -⟩ := pin_facts hE2
  have hmem : ∀ g ∈ E, (∃ i < 16, TabRep (unpack 42 6 (K589E1.T i)) g) ∨
      ∃ i < 16, TabRep (unpack 42 6 (K589E2.T i)) g := by
    intro g hg
    by_cases h1 : g = 1
    · subst h1
      obtain ⟨i, hi, e⟩ := mem_pts.1 hid1
      exact Or.inl ⟨i, hi, e ▸ TabRep.idTab⟩
    have hgC : g ∈ C₁ := Subgroup.mem_inf.2 ⟨Subgroup.mem_centralizer_iff.2 (fun h hh => by
      rw [Set.mem_singleton_iff.1 hh]
      exact (hcomm g hg r₁ hr).symm), hES hg⟩
    obtain ⟨t, ht, hrep⟩ := enumerates_C₁.complete g hgC
    rw [centS_r1] at ht
    obtain ⟨c, hc, rfl⟩ := mem_pts.1 ht
    have hsq' : pcomp 42 6 (mask 6) (L34C1.P c) (L34C1.P c) = pidn 42 6 :=
      (rep_eq (cn_pc (cn_C1 hc) (cn_C1 hc)) cn_id (rep_pc (cn_C1 hc) (cn_C1 hc) hrep hrep)
        rep_id).2 (hsq g hg)
    have hne : L34C1.P c ≠ pidn 42 6 := fun e => h1 ((rep_eq (cn_C1 hc) cn_id hrep rep_id).1 e)
    rcases hcA c hc hsq' hne with ⟨a, ha, e⟩ | ⟨b, hb, e⟩
    · exact Or.inl ⟨a, ha, e ▸ hrep⟩
    · exact Or.inr ⟨b, hb, e ▸ hrep⟩
  have hside : (∀ g ∈ E, ∃ i < 16, TabRep (unpack 42 6 (K589E1.T i)) g) ∨
      ∀ g ∈ E, ∃ i < 16, TabRep (unpack 42 6 (K589E2.T i)) g := by
    by_contra hcon
    push Not at hcon
    obtain ⟨⟨x, hxE, hx1⟩, ⟨y, hyE, hy2⟩⟩ := hcon
    obtain ⟨b, hb, hxb⟩ := (hmem x hxE).resolve_left (fun ⟨i, hi, h⟩ => hx1 i hi h)
    obtain ⟨a, ha, hya⟩ := (hmem y hyE).resolve_right (fun ⟨i, hi, h⟩ => hy2 i hi h)
    refine hcB a ha b hb ?_ ?_ ?_
    · rintro ⟨b', hb', e⟩
      exact hy2 b' hb' (by rw [e]; exact hya)
    · rintro ⟨a', ha', e⟩
      exact hx1 a' ha' (by rw [e]; exact hxb)
    · exact (pc_eq_iff (cn_E1 ha) (cn_E2 hb) (cn_E2 hb) (cn_E1 ha) hya hxb hxb hya).2
        (hcomm y hyE x hxE)
  have hlen : (pts 42 6 16 K589E1.T).toList.length = 16 := by
    rw [Array.length_toList, size_pts]
  have hlen2 : (pts 42 6 16 K589E2.T).toList.length = 16 := by
    rw [Array.length_toList, size_pts]
  rcases hside with h | h
  · refine Or.inl (enumerates_of_complete hnd1 (fun g hg => ?_) (by rw [hcard, hlen]))
    obtain ⟨i, hi, hr⟩ := h g hg
    exact ⟨_, mem_pts.2 ⟨i, hi, rfl⟩, hr⟩
  · refine Or.inr (enumerates_of_complete hnd2 (fun g hg => ?_) (by rw [hcard, hlen2]))
    obtain ⟨i, hi, hr⟩ := h g hg
    exact ⟨_, mem_pts.2 ⟨i, hi, rfl⟩, hr⟩

theorem conj_mem_of_rel {H : Subgroup (Equiv.Perm (Fin 42))} {P : Nat → Equiv.Perm (Fin 42)}
    (hH : ∀ g, g ∈ H ↔ ∃ i < 16, g = P i) {x : Equiv.Perm (Fin 42)}
    (h1 : ∀ e < 16, ∃ y < 16, x * P e = P y * x) (h2 : ∀ e < 16, ∃ y < 16, P e * x = x * P y)
    (h : Equiv.Perm (Fin 42)) : h ∈ H ↔ x * h * x⁻¹ ∈ H := by
  constructor
  · intro hh
    obtain ⟨e, he, rfl⟩ := (hH h).1 hh
    obtain ⟨y, hy, hxy⟩ := h1 e he
    refine (hH _).2 ⟨y, hy, ?_⟩
    rw [hxy]
    group
  · intro hh
    obtain ⟨e, he, hxe⟩ := (hH _).1 hh
    obtain ⟨y, hy, hxy⟩ := h2 e he
    refine (hH h).2 ⟨y, hy, ?_⟩
    have h3 : x * h = x * P y := by
      rw [← hxy, ← hxe]
      group
    exact mul_left_cancel h3

theorem E16Body.of_packed {ET BT K : Nat → Nat} {BG : Array Tab}
    (hET : ∀ i < 16, Cn (ET i))
    (hB : enumOK 42 BG (enumBFS 42 BG 16) = true ∧ (enumBFS 42 BG 16).tabs = pts 42 6 16 BT)
    (hBG : ∀ j < BG.size, BG[j]!.size = 42) (hchk : e16K 16 ET BT K 20160 L34S.T = true)
    (A : Subgroup ↥S) (hA : Enumerates (A.map S.subtype) (pts 42 6 16 ET).toList) :
    E16Body ↥S A := by
  obtain ⟨hK0, hKS, hBS, hBc, hBsq, hcnt, hN1, hN2, hK1, hK2, hsp⟩ := e16K_sound hchk
  have hBT : ∀ a < 16, Cn (BT a) := fun a ha => by
    obtain ⟨s, hs, e⟩ := hBS a ha
    rw [← e]
    exact cn_S hs
  have hKc : ∀ i < 5, Cn (K i) := fun i hi => by
    obtain ⟨s, hs, e⟩ := hKS i hi
    rw [← e]
    exact cn_S hs
  have hAp : ∀ a < 16, ∃ g ∈ A.map S.subtype, TabRep (unpack 42 6 (ET a)) g :=
    fun a ha => hA.sound _ (mem_pts.2 ⟨a, ha, rfl⟩)
  choose! eP heP heR using hAp
  have hAiff : ∀ g, g ∈ A.map S.subtype ↔ ∃ e < 16, g = eP e := by
    intro g
    constructor
    · intro hg
      obtain ⟨t, ht, hr⟩ := hA.complete g hg
      obtain ⟨e, he, rfl⟩ := mem_pts.1 ht
      exact ⟨e, he, hr.perm_eq (heR e he)⟩
    · rintro ⟨e, he, rfl⟩
      exact heP e he
  have hKp : ∀ i < 5, ∃ g ∈ S, TabRep (unpack 42 6 (K i)) g := fun i hi => by
    obtain ⟨s, hs, e⟩ := hKS i hi
    rw [← e]
    exact rep_S hs
  choose! kP hkPS hkPr using hKp
  obtain ⟨-, -, hgen⟩ := pin_facts hB
  have hBGp : ∀ j < BG.size, ∃ g ∈ S, TabRep BG[j]! g := fun j hj => by
    have h := hgen j hj
    rw [comp_idTab (hBG j hj)] at h
    obtain ⟨a, ha, e⟩ := mem_pts.1 h
    obtain ⟨s, hs, e'⟩ := hBS a ha
    rw [← e, ← e']
    exact rep_S hs
  choose! gB hgBS hgBr using hBGp
  have hA0 : ∀ a ∈ {x : Equiv.Perm (Fin 42) | ∃ j < BG.size, x = gB j},
      ∃ j < BG.size, TabRep BG[j]! a := by
    rintro a ⟨j, hj, rfl⟩
    exact ⟨j, hj, hgBr j hj⟩
  have hgens0 : ∀ j < BG.size, ∃ a ∈ {x : Equiv.Perm (Fin 42) | ∃ j < BG.size, x = gB j},
      TabRep BG[j]! a := fun j hj => ⟨gB j, ⟨j, hj, rfl⟩, hgBr j hj⟩
  have hB0e := enumerates_closure hA0 hgens0 hB.1
  rw [hB.2] at hB0e
  obtain ⟨B0, hB0def⟩ : ∃ B0 : Subgroup (Equiv.Perm (Fin 42)),
      B0 = Subgroup.closure {x : Equiv.Perm (Fin 42) | ∃ j < BG.size, x = gB j} := ⟨_, rfl⟩
  rw [← hB0def] at hB0e
  have hB0S : B0 ≤ S := by
    rw [hB0def]
    apply (Subgroup.closure_le S).2
    rintro x ⟨j, hj, rfl⟩
    exact hgBS j hj
  have hBp : ∀ a < 16, ∃ g ∈ B0, TabRep (unpack 42 6 (BT a)) g :=
    fun a ha => hB0e.sound _ (mem_pts.2 ⟨a, ha, rfl⟩)
  choose! bP hbP hbR using hBp
  have hBiff : ∀ g, g ∈ B0 ↔ ∃ e < 16, g = bP e := by
    intro g
    constructor
    · intro hg
      obtain ⟨t, ht, hr⟩ := hB0e.complete g hg
      obtain ⟨e, he, rfl⟩ := mem_pts.1 ht
      exact ⟨e, he, hr.perm_eq (hbR e he)⟩
    · rintro ⟨e, he, rfl⟩
      exact hbP e he
  obtain ⟨B, hBdef⟩ : ∃ B : Subgroup ↥S, B = B0.subgroupOf S := ⟨_, rfl⟩
  have hBmem : ∀ x : ↥S, x ∈ B ↔ (x : Equiv.Perm (Fin 42)) ∈ B0 := fun x => by
    rw [hBdef, Subgroup.mem_subgroupOf]
  have hBmap : B.map S.subtype = B0 := by
    rw [hBdef, Subgroup.subgroupOf_map_subtype, inf_eq_left.2 hB0S]
  have hAmem : ∀ x : ↥S, x ∈ A ↔ (x : Equiv.Perm (Fin 42)) ∈ A.map S.subtype := fun x => by
    constructor
    · intro hx
      exact Subgroup.mem_map_of_mem S.subtype hx
    · intro hx
      obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
      have hyx' : y = x := Subtype.ext hyx
      rw [← hyx']
      exact hy
  obtain ⟨k, hkcoe⟩ : ∃ k : Fin 5 → ↥S, ∀ i : Fin 5, (k i : Equiv.Perm (Fin 42)) = kP i.val :=
    ⟨fun i => ⟨kP i.val, hkPS i.val i.isLt⟩, fun i => rfl⟩
  have hlenB : (pts 42 6 16 BT).toList.length = 16 := by
    rw [Array.length_toList, size_pts]
  have hcap : Nat.card ↥(A.map S.subtype ⊓ B0) = 4 := by
    classical
    have hf := hB0e.filter (K := A.map S.subtype)
      (fun t => decide (∃ g ∈ A.map S.subtype, TabRep t g)) (fun t g ht => by
        rw [decide_eq_true_iff]
        constructor
        · rintro ⟨g', hg', hr⟩
          rw [ht.perm_eq hr]
          exact hg'
        · intro hg
          exact ⟨g, hg, ht⟩)
    rw [hf.card]
    unfold pts
    rw [CFSG.KC.BfsPin.pts_toList (fun i => unpack 42 6 (BT i)), List.filter_map, List.length_map,
      ← hcnt]
    congr 1
    apply List.filter_congr
    intro a ha
    have ha' := List.mem_range.1 ha
    rw [Function.comp_apply, Bool.eq_iff_iff, decide_eq_true_iff, inK_iff]
    constructor
    · rintro ⟨g, hg, hr⟩
      obtain ⟨e, he, rfl⟩ := (hAiff g).1 hg
      exact ⟨e, he, ((rep_eq (hET e he) (hBT a ha') (heR e he) hr).2 rfl)⟩
    · rintro ⟨e, he, hea⟩
      refine ⟨eP e, heP e he, ?_⟩
      rw [← hea]
      exact heR e he
  refine ⟨B, ?_, ?_, ?_, ?_, k, ?_, ?_, ?_⟩
  ·
    apply isElemAbelian_of_comm_pow
    · intro x hx y hy
      apply Subtype.ext
      obtain ⟨a, ha, hxa⟩ := (hBiff _).1 ((hBmem x).1 hx)
      obtain ⟨b, hb, hyb⟩ := (hBiff _).1 ((hBmem y).1 hy)
      simp only [Subgroup.coe_mul, hxa, hyb]
      exact (pc_eq_iff (hBT a ha) (hBT b hb) (hBT b hb) (hBT a ha) (hbR a ha) (hbR b hb)
        (hbR b hb) (hbR a ha)).1 (hBc a ha b hb)
    · intro x hx
      apply Subtype.ext
      obtain ⟨a, ha, hxa⟩ := (hBiff _).1 ((hBmem x).1 hx)
      simp only [pow_two, Subgroup.coe_mul, Subgroup.coe_one, hxa]
      exact (rep_eq (cn_pc (hBT a ha) (hBT a ha)) cn_id
        (rep_pc (hBT a ha) (hBT a ha) (hbR a ha) (hbR a ha)) rep_id).1 (hBsq a ha)
  ·
    have h1 := Subgroup.card_map_of_injective (K := B) (f := S.subtype) S.subtype_injective
    rw [hBmap, hB0e.card, hlenB] at h1
    omega
  ·
    have h1 := Subgroup.card_map_of_injective (K := B ⊓ A) (f := S.subtype) S.subtype_injective
    rw [Subgroup.map_inf_eq _ _ _ S.subtype_injective, hBmap] at h1
    rw [← h1, inf_comm]
    exact hcap
  ·
    intro x hx
    rw [Subgroup.mem_normalizer_iff]
    intro h
    obtain ⟨b, hb, hxb⟩ := (hBiff _).1 ((hBmem x).1 hx)
    have key := conj_mem_of_rel hAiff (x := (x : Equiv.Perm (Fin 42)))
      (fun e he => by
        obtain ⟨y, hy, ey⟩ := hN1 b hb e he
        refine ⟨y, hy, ?_⟩
        rw [hxb]
        exact (pc_eq_iff (hBT b hb) (hET e he) (hET y hy) (hBT b hb) (hbR b hb) (heR e he)
          (heR y hy) (hbR b hb)).1 ey)
      (fun e he => by
        obtain ⟨y, hy, ey⟩ := hN2 b hb e he
        refine ⟨y, hy, ?_⟩
        rw [hxb]
        exact (pc_eq_iff (hET e he) (hBT b hb) (hBT b hb) (hET y hy) (heR e he) (hbR b hb)
          (hbR b hb) (heR y hy)).1 ey)
      (h : Equiv.Perm (Fin 42))
    have hcoe : ((x * h * x⁻¹ : ↥S) : Equiv.Perm (Fin 42)) =
        (x : Equiv.Perm (Fin 42)) * (h : Equiv.Perm (Fin 42)) * (x : Equiv.Perm (Fin 42))⁻¹ := by
      simp
    rw [hAmem h, hAmem (x * h * x⁻¹), hcoe]
    exact key
  ·
    apply Subtype.ext
    rw [hkcoe]
    exact (rep_eq (hKc 0 (by norm_num)) cn_id (hkPr 0 (by norm_num)) rep_id).1 hK0
  ·
    intro i
    rw [Subgroup.mem_normalizer_iff]
    intro h
    have key := conj_mem_of_rel hBiff (x := kP (i : ℕ))
      (fun e he => by
        obtain ⟨y, hy, ey⟩ := hK1 i i.isLt e he
        exact ⟨y, hy, (pc_eq_iff (hKc i i.isLt) (hBT e he) (hBT y hy) (hKc i i.isLt)
          (hkPr i i.isLt) (hbR e he) (hbR y hy) (hkPr i i.isLt)).1 ey⟩)
      (fun e he => by
        obtain ⟨y, hy, ey⟩ := hK2 i i.isLt e he
        exact ⟨y, hy, (pc_eq_iff (hBT e he) (hKc i i.isLt) (hKc i i.isLt) (hBT y hy)
          (hbR e he) (hkPr i i.isLt) (hkPr i i.isLt) (hbR y hy)).1 ey⟩)
      (h : Equiv.Perm (Fin 42))
    have hcoe : ((k i * h * (k i)⁻¹ : ↥S) : Equiv.Perm (Fin 42)) =
        kP (i : ℕ) * (h : Equiv.Perm (Fin 42)) * (kP (i : ℕ))⁻¹ := by
      simp [hkcoe]
    rw [hBmem h, hBmem (k i * h * (k i)⁻¹), hcoe]
    exact key
  ·
    intro i j hij x hx ⟨a, ha, hxa⟩ ⟨b, hb, hxb⟩
    have hxP : (x : Equiv.Perm (Fin 42)) * kP (i : ℕ) = kP (i : ℕ) * (a : Equiv.Perm (Fin 42)) := by
      have h := congrArg (fun y : ↥S => (y : Equiv.Perm (Fin 42))) hxa
      simp only [Subgroup.coe_mul, Subgroup.coe_inv, hkcoe] at h
      rw [h]
      group
    have hxP' :
        (x : Equiv.Perm (Fin 42)) * kP (j : ℕ) = kP (j : ℕ) * (b : Equiv.Perm (Fin 42)) := by
      have h := congrArg (fun y : ↥S => (y : Equiv.Perm (Fin 42))) hxb
      simp only [Subgroup.coe_mul, Subgroup.coe_inv, hkcoe] at h
      rw [h]
      group
    obtain ⟨c, hc, hxc⟩ := (hBiff _).1 ((hBmem x).1 hx)
    obtain ⟨e, he, hae⟩ := (hAiff _).1 ((hAmem a).1 ha)
    obtain ⟨e', he', hbe⟩ := (hAiff _).1 ((hAmem b).1 hb)
    rw [hxc, hae] at hxP
    rw [hxc, hbe] at hxP'
    by_contra hx1
    have hij' : (i : ℕ) ≠ (j : ℕ) := fun h => hij (Fin.ext h)
    refine hsp i i.isLt j j.isLt hij' c hc ?_ ⟨e, he, ?_⟩ ⟨e', he', ?_⟩
    · intro h0
      apply hx1
      apply Subtype.ext
      rw [hxc]
      exact (rep_eq (hBT c hc) cn_id (hbR c hc) rep_id).1 h0
    · exact (pc_eq_iff (hBT c hc) (hKc i i.isLt) (hKc i i.isLt) (hET e he) (hbR c hc)
        (hkPr i i.isLt) (hkPr i i.isLt) (heR e he)).2 hxP
    · exact (pc_eq_iff (hBT c hc) (hKc j j.isLt) (hKc j j.isLt) (hET e' he') (hbR c hc)
        (hkPr j j.isLt) (hkPr j j.isLt) (heR e' he')).2 hxP'

theorem bsz_of_bind {BG : Array Tab} {ng : Nat} {G : Nat → Nat}
    (h : BG.size = ng ∧ ∀ k < ng, BG[k]! = unpack 42 6 (G k)) : ∀ j < BG.size, BG[j]!.size = 42 :=
  fun j hj => by
    rw [h.2 j (h.1 ▸ hj)]
    exact CFSG.KC.L34KSnd.size_unpack _

theorem E16Body_model
    (A : Subgroup ↥S) (hA : IsElemAbelian 2 A) (hc : Nat.card ↥A = 16) : E16Body ↥S A := by
  have hAne : ∃ a ∈ A, a ≠ 1 := by
    by_contra hcon
    push Not at hcon
    have hle : A ≤ ⊥ := fun a ha => Subgroup.mem_bot.2 (hcon a ha)
    have h2 := Subgroup.card_le_of_le hle
    rw [Subgroup.card_bot] at h2
    omega
  obtain ⟨a, haA, ha1⟩ := hAne
  have ha2 : a ^ 2 = 1 := hA.2 a haA
  have hr2P : r₁ ^ 2 = 1 := by
    have h := pow_orderOf_eq_one r₁R
    rw [orderOf_r₁R] at h
    have h' := congrArg Subtype.val h
    simpa [r₁R] using h'
  have hr1P : r₁ ≠ 1 := by
    intro h
    have h2 : orderOf r₁R = 1 := by
      have : r₁R = 1 := Subtype.ext h
      rw [this, orderOf_one]
    rw [orderOf_r₁R] at h2
