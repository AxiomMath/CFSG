  invsL.all fun x => x == one4 || !relA5K (blk x) (blk y0) || (findConjK x y0 modelsA5).isSome

theorem s5CheckK_of (h : invsK = invsL) (hs : s5CheckL = true) : s5CheckK = true := by
  unfold s5CheckK
  rw [h]
  exact hs

theorem a5CheckK_of (h : invsK = invsL) (ha : a5CheckL = true) : a5CheckK = true := by
