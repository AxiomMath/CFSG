@[expose] def slpRecChk (S : List (List Nat)) : List (Nat × Nat) → Nat → Bool
  | [], _ => true
  | p :: l, m => (Nat.blt p.1 m && Nat.blt p.2 m &&
      S.getD m [] == (S.getD p.2 []).map fun j => (S.getD p.1 []).getD j 0) && slpRecChk S l (m + 1)

theorem slpRec_size : ∀ (l : List (Nat × Nat)) (arr : Array (Array Nat)),
    (l.foldl slpStepA arr).size = arr.size + l.length
  | [], _ => rfl
  | p :: l, arr => by
    rw [List.foldl_cons, slpRec_size l, List.length_cons]
    simp [slpStepA]
    omega

theorem compArr_toArray (s t : List Nat) :
    compArr s.toArray t.toArray = (t.map fun j => s.getD j 0).toArray := by
  simp only [compArr, List.map_toArray, getElem!_def, List.getElem?_toArray,
    List.getD_eq_getElem?_getD]
  congr 1

theorem slpRecChk_sound (S : List (List Nat)) : ∀ (l : List (Nat × Nat)) (arr : Array (Array Nat)),
    slpRecChk S l arr.size = true → (∀ j < arr.size, arr[j]! = (S.getD j []).toArray) →
    ∀ j < (l.foldl slpStepA arr).size, (l.foldl slpStepA arr)[j]! = (S.getD j []).toArray
  | [], _, _, ha => ha
  | p :: l, arr, h, ha => by
    simp only [slpRecChk, Bool.and_eq_true, Nat.blt_eq, beq_iff_eq] at h
    obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := h
    rw [List.foldl_cons]
    have hs : (slpStepA arr p).size = arr.size + 1 := by simp [slpStepA]
    apply slpRecChk_sound S l
    · rw [hs]
      exact h4
    · intro j hj
      rw [hs] at hj
      unfold slpStepA
      rcases Nat.lt_or_ge j arr.size with hjk | hjk
      · rw [getElem!_pos _ j (by simp; omega), Array.getElem_push_lt hjk, ← getElem!_pos arr j hjk]
        exact ha j hjk
      · have e : j = arr.size := by omega
        subst e
        rw [getElem!_pos _ arr.size (by simp), Array.getElem_push_eq, ha _ h1, ha _ h2, h3,
          compArr_toArray]

theorem slpD0 : (m24SLPd.getD 0 [] == m24ta) = true := by
  quickRfl

theorem slpD1 : (m24SLPd.getD 1 [] == m24tb) = true := by
  quickRfl

theorem slpDC : slpRecChk m24SLPd m24Prog 2 = true := by
  quickRfl

theorem slpDE : ∀ j < 232, m24SLP[j]! = (m24SLPd.getD j []).toArray := by
  intro j hj
  have hl : m24Prog.length = 230 := rfl
  have h2 : (#[m24ta.toArray, m24tb.toArray] : Array (Array Nat)).size = 2 := rfl
  have hs := slpRec_size m24Prog #[m24ta.toArray, m24tb.toArray]
  rw [hl, h2] at hs
  unfold m24SLP slpTabsA
  refine slpRecChk_sound m24SLPd m24Prog _ (by rw [h2]; exact slpDC) ?_ j (by omega)
  intro i hi
  rw [h2] at hi
  match i, hi with
  | 0, _ => rw [eq_of_beq slpD0]; rfl
  | 1, _ => rw [eq_of_beq slpD1]; rfl
  | _ + 2, h => omega

theorem tabsB : (J.tabs == [m24ta, m24tb, (m24SLP[180]!).toList, (m24SLP[187]!).toList,
    (m24SLP[196]!).toList, (m24SLP[211]!).toList, (m24SLP[218]!).toList, (m24SLP[223]!).toList,
    (m24SLP[228]!).toList, (m24SLP[231]!).toList]) = true := by
  rw [slpDE 180 (by omega), slpDE 187 (by omega), slpDE 196 (by omega), slpDE 211 (by omega),
    slpDE 218 (by omega), slpDE 223 (by omega), slpDE 228 (by omega), slpDE 231 (by omega)]
  quickRfl

end CFSG.KD.M24Dc

