theorem mems : (List.range 13).all memOK = true := by
  rw [List.all_eq_true]
  intro j hj
  rw [List.mem_range] at hj
  match j, hj with
  | 0, _ => exact mem0
  | 1, _ => exact mem1
  | 2, _ => exact mem2
  | 3, _ => exact mem3
  | 4, _ => exact mem4
  | 5, _ => exact mem5
  | 6, _ => exact mem6
  | 7, _ => exact mem7
  | 8, _ => exact mem8
  | 9, _ => exact mem9
  | 10, _ => exact mem10
  | 11, _ => exact mem11
  | 12, _ => exact mem12
  | _ + 13, h => omega

@[expose] noncomputable def otOKR (j : Nat) : Bool :=
  Nat.beq (Rs j).length 4 &&
    allRc (fun r => Nat.ble (Om j).lbl.size r.length && allRc (fun x => Nat.blt x 512) r) (Rs j) &&
    otIdxR 9 (Om j).lbl.size ((Rs j).map (CFSG.KC.LQT.PP.codeK 9)) (OtI j)

theorem otOKR_otOK (j : Nat) (h : otOKR j = true) : otOK j = true := by
  unfold otOKR at h
  unfold otOK
  simp only [allRc_eq, Bool.and_eq_true] at h ⊢
  exact ⟨⟨h.1.1, h.1.2⟩, otIdxR_otIdxOK h.2⟩

theorem otsR : (List.range 13).all otOKR = true := by
  quickRfl

theorem ots : (List.range 13).all otOK = true := by
  have h := otsR
  rw [List.all_eq_true] at h ⊢
  exact fun j hj => otOKR_otOK j (h j hj)

theorem tabs : tabsOK = true := by
  quickRfl

theorem invs : invOK = true := by
  quickRfl

theorem mws : mwOK = true := by
  quickRfl

theorem fix : fixOK = true := by
  quickRfl

theorem moveR : (List.range' 1 12).all (fun j => (J.mw.getD j []).any fun w => Δc.any fun c =>
    !Δc.contains (codeAT 24 (wordTabL #[T 0, T 1] 24 w) c)) = true := by
  quickRfl

theorem move : moveOK = true := by
  have h := moveR
  unfold moveOK
  rw [List.all_eq_true] at h ⊢
  intro j hj
  have h1 := h j hj
  rw [List.any_eq_true] at h1 ⊢
  obtain ⟨w, hw, h2⟩ := h1
  rw [List.any_eq_true] at h2
  obtain ⟨c, hc, h3⟩ := h2
  exact ⟨w, hw, codeSetT_ne_of hc h3⟩

theorem top : topOK = true := by
  quickRfl

