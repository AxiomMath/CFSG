theorem hU : uPts = UL.toArray := by kernelRfl

theorem mem_uPts (x : Nat) : uPts.contains x = true ↔
    x < 4096 ∧ (x != 0 && hermC x x == 0 && normC x == x) = true := by
  simp [uPts]

theorem gE : tvGens = (UL.filter fun c => weightC c == 2).toArray.push 85 := by
  rw [tvGens, hU]
  simp

theorem getE (i : Nat) : UL.toArray[i]! = UL.getD i 0 := by
  simp only [getElem!_def, List.getD_eq_getElem?_getD, List.getElem?_toArray]
  cases UL[i]? <;> rfl

theorem size_ok : (uPts.size == 693) = true := by
  rw [hU]
  quickRfl

theorem gens_size_ok : (tvGens.size == 46) = true := by
  rw [gE, Array.size_push, List.size_toArray]
  quickRfl

theorem sorted_ok : ((List.range 692).all fun i => decide (uPts[i]! < uPts[i + 1]!)) = true := by
  simp only [hU, getE]
  quickRfl

theorem gens_ok : (tvGens.all fun v => uPts.contains v) = true := by
  rw [gE, Array.all_push, List.all_toArray, Bool.and_eq_true, mem_uPts]
  refine ⟨?_, by decide, by quickRfl⟩
  rw [List.all_eq_true]
  intro v hv
  simpa [hU] using (List.mem_filter.1 hv).1

theorem norm_check : ((List.range 4096).all fun c => c == 0 || hermC c c != 0 ||
    (decide (normC c < 4096) && (normC c != 0 && hermC (normC c) (normC c) == 0 &&
      normC (normC c) == normC c))) = true := by
  quickRfl

theorem norm_ok :
    ((List.range 4096).all fun c => c == 0 || hermC c c != 0 || uPts.contains (normC c)) = true := by
  have h0 := norm_check
  rw [List.all_eq_true] at h0 ⊢
  intro c hc
  have h := h0 c hc
  simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq] at h ⊢
  rcases h with h | ⟨h1, h2⟩
  · exact Or.inl h
  · exact Or.inr ((mem_uPts _).2 ⟨h1, by simpa only [Bool.and_eq_true] using h2⟩)

theorem uPtsOK_true : uPtsOK = true := by
  unfold uPtsOK
  simp only [Bool.and_eq_true]
  exact ⟨⟨⟨⟨size_ok, gens_size_ok⟩, sorted_ok⟩, norm_ok⟩, gens_ok⟩

