@[expose] def f0Lit : List ℕ :=
  [6643, 2466, 7617, 9109, 10083, 16726, 18463, 6154, 8594, 15752, 11820, 3688, 977]

theorem hcv : coverMask = coverLit := Nat.eq_of_beq_eq_true (by quickRfl)

theorem hnf : nfMask = nfLit := Nat.eq_of_beq_eq_true (by quickRfl)

theorem hf0 : f0Codes = f0Lit := eq_of_beq (by quickRfl)

theorem hsl : slCovered slLit = true := by
  have h : allR 0 19683 (fun c => ndet c != 1 || slLit.testBit c) = true := by quickRfl
  rw [slCovered, List.all_eq_true]
  intro c hc
  exact (allR_iff _ _ _).1 h c (Nat.zero_le _) (List.mem_range.1 hc)

theorem q1 : (rpowR cR 13 == rone && cR != rone) = true := by quickRfl

theorem q2 : (nf0Pairs.all fun p => rmul p.1 p.2 == rone &&
    f0R.contains (rmul (rmul p.1 cR) p.2) && rdet p.1 != 0) = true := by quickRfl

theorem q3 : decide (nf0Pairs.map Prod.fst).Nodup = true := by quickRfl

theorem q4 : (reps13.all fun r => rdet r != 0 && rpowR r 13 == rone) = true := by quickRfl

theorem q5 : (reps13.length == 7) = true := by quickRfl

theorem tree0 : bloom13Tree 0 = true := by
  have hT : treeOKP [code cR, code (reps13.getD 0 rone)] bl13C0 bl13P0 bl13L0 5616 =
      true := by quickRfl
  have hM : treeMask bl13C0 5616 = slLit := Nat.eq_of_beq_eq_true (by quickRfl)
  change slCoverP [code cR, code (reps13.getD 0 rone)] bl13C0 bl13P0 bl13L0 5616 = true
  rw [slCoverP, hT, hM, hsl, Bool.and_self]

