@[expose] def mvd (v : Vector (Fin 6) 6) : ℕ := ((List.finRange 6).filter fun x => v[x] ≠ x).length

@[expose] def invV (v : Vector (Fin 6) 6) : Bool :=
  invCheckOfKron (kronOfTabs (heartTab v) (heartTab (totalVec v)))

@[expose] def selV (v : Vector (Fin 6) 6) : Vector (Vector FieldFour 16) 16 :=
  if mvd v = 5 then selectOmega (kronOfTabs (heartTab v) (heartTab (totalVec v))) else zeroTab16

@[expose] def stepV (v : Vector (Fin 6) 6) (acc : Vector (Vector FieldFour 16) 16) :
    Vector (Vector FieldFour 16) 16 :=
  addTab (selV v) acc

instance : LeftCommutative stepV := ⟨fun _ _ _ => addTab_left_comm _ _ _⟩

theorem allFlat {α : Type*} {p : α → Prop} {L : List (List α)} (h : ∀ l ∈ L, ∀ v ∈ l, p v) :
    ∀ v ∈ L.flatten, p v := fun v hv => by
  obtain ⟨l, hl, hv⟩ := List.mem_flatten.1 hv
  exact h l hl v hv

theorem allFlatB {α : Type*} {f : α → Bool} {L : List (List α)} (h : ∀ l ∈ L, l.all f = true) :
    ∀ v ∈ L.flatten, f v = true :=
  allFlat fun l hl => List.all_eq_true.1 (h l hl)


