@[expose] noncomputable def slLane2 (T : Nat) (R : List Nat) (N w m k i : Nat) : Nat :=
  cond (Nat.blt (Nat.shiftRight i k) N)
    (lane (slRowAt R (Nat.shiftRight i k)) w m (Nat.land i (Nat.sub (Nat.shiftLeft 1 k) 1)))
    (lane T w m i)

theorem slLane_split (T w k i : Nat) :
    lane T w (2 ^ w - 1) i =
      lane (lane T (w * 2 ^ k) (2 ^ (w * 2 ^ k) - 1) (i >>> k)) w (2 ^ w - 1) (i % 2 ^ k) := by
  have hl : ∀ T w m i, lane T w m i = (T >>> (w * i)) &&& m := fun _ _ _ _ => rfl
  rw [Nat.shiftRight_eq_div_pow i k, hl, hl, hl]
  apply Nat.eq_of_testBit_eq
  intro j
  simp only [Nat.testBit_and, Nat.testBit_shiftRight, Nat.testBit_two_pow_sub_one]
  by_cases hj : j < w
  · have hm := Nat.mod_lt i (Nat.two_pow_pos k)
    have h1 : w * (i % 2 ^ k) + j < w * 2 ^ k := by
      have : w * (i % 2 ^ k) + w ≤ w * 2 ^ k := by
        rw [← Nat.mul_succ]
        exact Nat.mul_le_mul_left _ hm
      omega
    have h2 : w * 2 ^ k * (i / 2 ^ k) + (w * (i % 2 ^ k) + j) = w * i + j := by
      have e : w * i = w * 2 ^ k * (i / 2 ^ k) + w * (i % 2 ^ k) := by
        rw [Nat.mul_assoc, ← Nat.mul_add, Nat.div_add_mod]
      omega
    simp only [hj, h1, decide_true, Bool.and_true]
    rw [h2]
  · simp [hj]

theorem slLane2_eq {T : Nat} {R : List Nat} {N w k : Nat}
    (h : allB N (fun r => Nat.beq (slRowAt R r) (lane T (w * 2 ^ k) (2 ^ (w * 2 ^ k) - 1) r)) =
      true)
    (i : Nat) : slLane2 T R N w (2 ^ w - 1) k i = lane T w (2 ^ w - 1) i := by
  unfold slLane2
  cases hb : Nat.blt (Nat.shiftRight i k) N
  · rfl
  · have hr := (allB_true_iff.mp h) _ (Nat.blt_eq.mp hb)
    have hr' := Nat.eq_of_beq_eq_true hr
    have hmask : Nat.land i (Nat.sub (Nat.shiftLeft 1 k) 1) = i % 2 ^ k := by
      change i &&& (1 <<< k - 1) = _
      rw [Nat.one_shiftLeft, Nat.and_two_pow_sub_one_eq_mod]
    change lane (slRowAt R (Nat.shiftRight i k)) w (2 ^ w - 1)
      (Nat.land i (Nat.sub (Nat.shiftLeft 1 k) 1)) = _
    rw [hmask, hr']
    exact (slLane_split T w k i).symm

theorem slAllFrom_two {a k₁ k₂ : Nat} {p : Nat → Bool} (h₁ : allFrom a k₁ p = true)
    (h₂ : allFrom (a + k₁) k₂ p = true) : allFrom a (k₁ + k₂) p = true := by
  refine allB_true_iff.2 fun i hi => ?_
  by_cases h : i < k₁
  · exact allB_true_iff.1 h₁ i h
  · have := allB_true_iff.1 h₂ (i - k₁) (by omega)
    change p (a + k₁ + (i - k₁)) = true at this
    change p (a + i) = true
    rwa [Nat.add_assoc, Nat.add_sub_cancel' (by omega)] at this

