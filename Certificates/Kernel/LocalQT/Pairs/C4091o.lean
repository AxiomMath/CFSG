theorem o2E_eq : O2E = O2Lit := by decide +kernel

@[expose] noncomputable def ofPts (P : List Nat) : Nat :=
  List.rec (motive := fun _ => Nat) (nat_lit 0) (fun i _ acc => Nat.lor (Nat.shiftLeft 1 i) acc) P

@[expose] noncomputable def imgPts (w g : Nat) (P : List Nat) : Nat :=
  List.rec (motive := fun _ => Nat) (nat_lit 0)
    (fun i _ acc => Nat.lor (Nat.shiftLeft 1 (imgW w g i)) acc) P

@[expose] noncomputable def closedMP (G : List Nat) (L : List (List Nat)) : Bool :=
  nilK (CFSG.KC.LQT.Syl.diffS (CFSG.KC.LQT.Syl.dedupS (CFSG.KC.LQT.Syl.sortN (List.flatten
    (List.map (fun P => List.map (fun g => imgPts 9 g P) G) L)))) (CFSG.KC.LQT.Syl.sortN
      (List.map ofPts L)))

theorem testBit_ofPts (P : List Nat) (i : Nat) : (ofPts P).testBit i = true ↔ i ∈ P := by
  induction P with
  | nil =>
    change (0 : Nat).testBit i = true ↔ _
    simp
  | cons a P ih =>
    change ((1 <<< a) ||| ofPts P).testBit i = true ↔ _
    rw [Nat.testBit_lor, Bool.or_eq_true, ih, Nat.one_shiftLeft, Nat.testBit_two_pow,
      decide_eq_true_iff, List.mem_cons]
    exact or_congr_left eq_comm

theorem testBit_imgPts (w g : Nat) (P : List Nat) (j : Nat) :
    (imgPts w g P).testBit j = true ↔ ∃ i ∈ P, imgW w g i = j := by
  induction P with
  | nil =>
    change (0 : Nat).testBit j = true ↔ _
    simp
  | cons a P ih =>
    change ((1 <<< imgW w g a) ||| imgPts w g P).testBit j = true ↔ _
    rw [Nat.testBit_lor, Bool.or_eq_true, ih, Nat.one_shiftLeft, Nat.testBit_two_pow,
      decide_eq_true_iff]
    constructor
    · rintro (h | ⟨i, hi, h⟩)
      · exact ⟨a, List.mem_cons_self, h⟩
      · exact ⟨i, List.mem_cons_of_mem _ hi, h⟩
    · rintro ⟨i, hi, h⟩
      rcases List.mem_cons.1 hi with rfl | hi
      · exact Or.inl h
      · exact Or.inr ⟨i, hi, h⟩

theorem testBit_imgMaskW (n w g m j : Nat) :
    (imgMaskW n w g m).testBit j = true ↔ ∃ i < n, m.testBit i = true ∧ imgW w g i = j := by
  induction n with
  | zero =>
    change (0 : Nat).testBit j = true ↔ _
    simp
  | succ k ih =>
    have key : Nat.beq (Nat.land (Nat.shiftRight m k) 1) 1 = m.testBit k := by
      have hs : (m >>> k).testBit 0 = m.testBit k := by
        rw [Nat.testBit_shiftRight, Nat.add_zero]
      rw [← hs, Nat.testBit_zero]
      change Nat.beq ((m >>> k) &&& 1) 1 = _
      rw [Nat.and_one_is_mod]
      rcases Nat.mod_two_eq_zero_or_one (m >>> k) with h | h <;> rw [h] <;> rfl
    have e : imgMaskW (k + 1) w g m = Bool.rec (motive := fun _ => Nat) (imgMaskW k w g m)
        (Nat.lor (imgMaskW k w g m) (Nat.shiftLeft 1 (imgW w g k)))
        (Nat.beq (Nat.land (Nat.shiftRight m k) 1) 1) := rfl
    rw [e, key]
    cases hb : m.testBit k
    · change (imgMaskW k w g m).testBit j = true ↔ _
      rw [ih]
      constructor
      · rintro ⟨i, hi, h1, h2⟩
        exact ⟨i, by omega, h1, h2⟩
      · rintro ⟨i, hi, h1, h2⟩
        have hik : i ≠ k := by
          rintro rfl
          rw [hb] at h1
          cases h1
        exact ⟨i, by omega, h1, h2⟩
    · change (imgMaskW k w g m ||| 1 <<< imgW w g k).testBit j = true ↔ _
      rw [Nat.testBit_lor, Bool.or_eq_true, ih, Nat.one_shiftLeft, Nat.testBit_two_pow,
        decide_eq_true_iff]
      constructor
      · rintro (⟨i, hi, h1, h2⟩ | h)
        · exact ⟨i, by omega, h1, h2⟩
        · exact ⟨k, by omega, hb, h⟩
      · rintro ⟨i, hi, h1, h2⟩
        by_cases hik : i = k
        · subst hik
          exact Or.inr h2
        · exact Or.inl ⟨i, by omega, h1, h2⟩

theorem imgMaskW_ofPts (n w g : Nat) (P : List Nat) (hP : ∀ i ∈ P, i < n) :
    imgMaskW n w g (ofPts P) = imgPts w g P := by
  refine Nat.eq_of_testBit_eq fun j => Bool.eq_iff_iff.2 ?_
  rw [testBit_imgMaskW, testBit_imgPts]
  constructor
  · rintro ⟨i, -, hi, h⟩
    exact ⟨i, (testBit_ofPts P i).1 hi, h⟩
  · rintro ⟨i, hi, h⟩
    exact ⟨i, hP i hi, (testBit_ofPts P i).2 hi, h⟩

theorem closedM_pts {G : List Nat} {L : List (List Nat)} (h : ∀ P ∈ L, ∀ i ∈ P, i < 315) :
    closedM G (L.map ofPts) = closedMP G L := by
  have hm : (L.map ofPts).map (fun m => G.map fun g => imgMaskW 315 9 g m) =
      L.map (fun P => G.map fun g => imgPts 9 g P) := by
    rw [List.map_map]
    exact List.map_congr_left fun P hP =>
      List.map_congr_left fun g _ => imgMaskW_ofPts 315 9 g P (h P hP)
  unfold CFSG.KC.LQT.PW.closedM closedMP
  rw [hm]

