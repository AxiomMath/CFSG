variable {G Ω : Type*} [Group G] [MulAction G Ω] [Fintype Ω] [DecidableEq Ω]

@[expose] def fixS (g : G) : Finset Ω := Finset.univ.filter fun i => g • i = i

theorem mem_fixS {g : G} {i : Ω} : i ∈ (fixS g : Finset Ω) ↔ g • i = i := by simp [fixS]

theorem card_fixS_conj (c g : G) :
    (fixS (c * g * c⁻¹) : Finset Ω).card = (fixS g : Finset Ω).card := by
  refine Finset.card_bij (fun i _ => c⁻¹ • i) ?_ ?_ ?_
  · intro i hi
    rw [mem_fixS] at hi ⊢
    have h2 : c • g • c⁻¹ • i = i := by simpa [mul_smul] using hi
    calc g • c⁻¹ • i = c⁻¹ • (c • g • c⁻¹ • i) := (inv_smul_smul c _).symm
      _ = c⁻¹ • i := by rw [h2]
  · intro i _ j _ h
    simpa using h
  · intro j hj
    refine ⟨c • j, ?_, by simp⟩
    rw [mem_fixS] at hj ⊢
    calc ((c * g * c⁻¹) • c • j) = c • g • j := by simp [mul_smul]
      _ = c • j := by rw [hj]

theorem card_modEq_filter {p : ℕ} [Fact p.Prime] {y : G} (hy : y ^ p = 1) (S : Finset Ω)
    (hS : ∀ i ∈ S, y • i ∈ S) :
    S.card ≡ (S.filter fun i => y • i = i).card [MOD p] := by
  let f : Function.End S := fun i => ⟨y • i.1, hS i.1 i.2⟩
  have hfk : ∀ k : ℕ, ∀ i : S, ((f ^ k) i).1 = (y ^ k) • i.1 := by
    intro k
    induction k with
    | zero => intro i; rw [pow_zero, pow_zero, one_smul]; rfl
    | succ k ih =>
      intro i
      rw [pow_succ', Function.End.mul_def]
      change y • ((f ^ k) i).1 = _
      rw [ih, pow_succ', mul_smul]
  have hf : f ^ p ^ 1 = 1 := by
    funext i
    apply Subtype.ext
    rw [pow_one, hfk, hy, one_smul]
    rfl
  have h := Equiv.Perm.card_fixedPoints_modEq hf
  rw [Fintype.card_coe] at h
  convert h using 1
  rw [Fintype.card_subtype]
  refine (Finset.card_bij (fun (x : S) _ => x.1) ?_ ?_ ?_).symm
  · intro x hx
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Function.mem_fixedPoints,
      Function.IsFixedPt] at hx
    exact Finset.mem_filter.2 ⟨x.2, congrArg Subtype.val hx⟩
  · intro a _ b _ h
    exact Subtype.ext h
  · intro i hi
    obtain ⟨hiS, hiy⟩ := Finset.mem_filter.1 hi
    refine ⟨⟨i, hiS⟩, ?_, rfl⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Function.mem_fixedPoints,
      Function.IsFixedPt]
    exact Subtype.ext hiy

theorem smul_mem_fixS {x s : G} (hxs : x * s = s * x) {i : Ω}
    (hi : i ∈ (fixS s : Finset Ω)) : x • i ∈ (fixS s : Finset Ω) := by
  rw [mem_fixS] at hi ⊢
  rw [← mul_smul, ← hxs, mul_smul, hi]

theorem not_twentyfive_dvd [Finite G] {e f x : G} (he : e ^ 5 = 1) (hf : f ^ 5 = 1)
    (hef : Commute e f) (h25 : 5 ^ (Nat.card G).factorization 5 = 25)
    (hQ : Nat.card (Subgroup.closure ({e, f} : Set G)) = 25)
    (h1 : ((fixS e : Finset Ω).filter fun i => f • i = i).card = 1)
    (hx : (fixS x : Finset Ω).card % 5 ≠ 1) :
    ¬ 25 ∣ Nat.card (Subgroup.centralizer ({x} : Set G)) := by
  intro h
  have : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  obtain ⟨K, hK⟩ := Sylow.exists_subgroup_card_pow_prime
    (G := ↥(Subgroup.centralizer ({x} : Set G))) 5 (n := 2) (by norm_num; exact h)
  let R : Subgroup G := K.map (Subgroup.centralizer ({x} : Set G)).subtype
  have hRcard : Nat.card R = 5 ^ (Nat.card G).factorization 5 := by
    rw [Subgroup.card_map_of_injective (Subgroup.centralizer ({x} : Set G)).subtype_injective, hK,
      h25]
    norm_num
  have hRC : ∀ r ∈ R, r * x = x * r := by
    rintro _ ⟨c, -, rfl⟩
    exact (Subgroup.mem_centralizer_singleton_iff (g := x) (k := (c : G))).1 c.2
  let SQ : Sylow 5 G := Sylow.ofCard (Subgroup.closure ({e, f} : Set G)) (by rw [hQ, h25])
  let SR : Sylow 5 G := Sylow.ofCard R hRcard
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G SQ SR
  have hconj : ∀ q ∈ Subgroup.closure ({e, f} : Set G), g * q * g⁻¹ ∈ R := by
    intro q hq
    have hqS : q ∈ (SQ : Subgroup G) := by rw [Sylow.coe_ofCard]; exact hq
    have h1 : g * q * g⁻¹ ∈ ((g • SQ : Sylow 5 G) : Subgroup G) := by
      rw [Sylow.coe_subgroup_smul, Subgroup.mem_pointwise_smul_iff_inv_smul_mem, ← map_inv,
        MulAut.smul_def, MulAut.conj_apply, inv_inv]
      have e1 : g⁻¹ * (g * q * g⁻¹) * g = q := by group
      rw [e1]
      exact hqS
    rw [hg, Sylow.coe_ofCard] at h1
    exact h1
  set x' := g⁻¹ * x * g with hx'
  have hcomm : ∀ q ∈ Subgroup.closure ({e, f} : Set G), x' * q = q * x' := by
    intro q hq
    have h := hRC _ (hconj q hq)
    calc x' * q = g⁻¹ * (x * (g * q * g⁻¹)) * g := by rw [hx']; group
      _ = g⁻¹ * ((g * q * g⁻¹) * x) * g := by rw [← h]
      _ = q * x' := by rw [hx']; group
  have hex : x' * e = e * x' := hcomm e (Subgroup.subset_closure (Set.mem_insert _ _))
  have hfx : x' * f = f * x' := hcomm f (Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl))
  have m1 := card_modEq_filter (p := 5) he (fixS x' : Finset Ω)
    (fun i hi => smul_mem_fixS (s := x') hex.symm hi)
  have hS2 : ∀ i ∈ (fixS x' : Finset Ω).filter (fun i => e • i = i), f • i ∈
      (fixS x' : Finset Ω).filter (fun i => e • i = i) := by
    intro i hi
    obtain ⟨hi1, hi2⟩ := Finset.mem_filter.1 hi
    refine Finset.mem_filter.2 ⟨smul_mem_fixS (s := x') hfx.symm hi1, ?_⟩
    rw [← mul_smul, hef.eq, mul_smul, hi2]
  have m2 := card_modEq_filter (p := 5) hf _ hS2
  obtain ⟨p, hp⟩ := Finset.card_eq_one.1 h1
  have hpmem : p ∈ (fixS e : Finset Ω).filter fun i => f • i = i := by
    rw [hp]; exact Finset.mem_singleton_self p
  obtain ⟨hp1, hp2⟩ := Finset.mem_filter.1 hpmem
  have hxp : x' • p = p := by
    have : x' • p ∈ (fixS e : Finset Ω).filter fun i => f • i = i := by
      refine Finset.mem_filter.2 ⟨smul_mem_fixS (s := e) hex hp1, ?_⟩
      rw [← mul_smul, ← hfx, mul_smul, hp2]
    rw [hp] at this
    exact Finset.mem_singleton.1 this
  have hS3 : ((fixS x' : Finset Ω).filter (fun i => e • i = i)).filter
      (fun i => f • i = i) = {p} := by
    ext i
    simp only [Finset.mem_filter, Finset.mem_singleton]
    constructor
    · rintro ⟨⟨_, hi2⟩, hi3⟩
      have : i ∈ (fixS e : Finset Ω).filter fun i => f • i = i :=
        Finset.mem_filter.2 ⟨mem_fixS.2 hi2, hi3⟩
      rw [hp] at this
      exact Finset.mem_singleton.1 this
    · rintro rfl
      exact ⟨⟨mem_fixS.2 hxp, mem_fixS.1 hp1⟩, hp2⟩
  rw [hS3, Finset.card_singleton] at m2
  have hcx : (fixS x' : Finset Ω).card = (fixS x : Finset Ω).card := by
    have := card_fixS_conj (Ω := Ω) g⁻¹ x
    rwa [inv_inv] at this
  rw [hcx] at m1
  unfold Nat.ModEq at m1 m2
  omega

end General

