theorem fix_iff {g : J} {r : ℕ} {L : List ℕ} (hg : ∀ x < 31671, idx 31671 g x = wv CFSG.KD.Fi23Five.H [r] x)
    (hL : (List.range 31671).filter (fun x => Nat.beq (wv CFSG.KD.Fi23Five.H [r] x) x) = L) (i : Fin 31671) :
    g • i = i ↔ i.val ∈ L := by
  rw [← hL, List.mem_filter, List.mem_range, ← hg i.val i.2, idx_of_lt g i.2]
  constructor
  · intro h
    exact ⟨i.2, by rw [h]; exact Nat.beq_refl _⟩
  · rintro ⟨-, h⟩
