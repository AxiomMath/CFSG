@[expose] noncomputable def wE (w : List ℕ) : J := (w.map regE).prod

theorem y1R_ok : ∀ r ∈ y1R, RegOK r := by
  have h : ∀ r ∈ y1R, r < 10 ∨ (52 ≤ r ∧ r < 76) := by decide
  exact h

theorem y2R_ok : ∀ r ∈ y2R, RegOK r := by
  have h : ∀ r ∈ y2R, r < 10 ∨ (52 ≤ r ∧ r < 76) := by decide
  exact h

theorem t2R_prod : wE t2R = t3 2 := by
  have h := t3R_prod (c := 2) (by norm_num)
  exact h

theorem t2R_ok : ∀ r ∈ t2R, RegOK r := t3R_ok (c := 2) (by norm_num)

theorem powW_ok {w : List ℕ} (hw : ∀ r ∈ w, RegOK r) (e : ℕ) :
    ∀ r ∈ CFSG.KC.Fi23R.powW e w, RegOK r := by
  intro r hr
  unfold CFSG.KC.Fi23R.powW at hr
  obtain ⟨l, hl, hrl⟩ := List.mem_flatten.1 hr
  rw [List.eq_of_mem_replicate hl] at hrl
  exact hw r hrl

theorem wE_powW (w : List ℕ) (e : ℕ) : wE (CFSG.KC.Fi23R.powW e w) = wE w ^ e := by
  unfold wE CFSG.KC.Fi23R.powW
  rw [List.map_flatten, List.prod_flatten, List.map_replicate, List.map_replicate,
    List.prod_replicate]

theorem ok_append {u v : List ℕ} (hu : ∀ r ∈ u, RegOK r) (hv : ∀ r ∈ v, RegOK r) :
    ∀ r ∈ u ++ v, RegOK r := fun r hr => (List.mem_append.1 hr).elim (hu r) (hv r)

theorem wE_append (u v : List ℕ) : wE (u ++ v) = wE u * wE v := by
  unfold wE
  rw [List.map_append, List.prod_append]

theorem y_facts {w : List ℕ} (hw : ∀ r ∈ w, RegOK r) (h : CFSG.KC.Fi23Pump.yK G w t2R = true) :
    orderOf (wE w) = 5 ∧ wE w * t3 2 = t3 2 * wE w := by
  obtain ⟨h1, h2, h3⟩ := yK_spec h
  have : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  have h5 : wE w ^ 5 = 1 := by
    rw [← wE_powW]
    refine eq_of_base fun t ht => ?_
    rw [idx_one]
    unfold wE
    rw [← wvG_eq _ (powW_ok hw 5) t (by omega), h1 t ht]
    rfl
  have hne : wE w ≠ 1 := by
    intro h1'
    refine h2 fun b hb => ?_
    rw [wvG_eq w hw b (by omega)]
    change idx 31671 (wE w) b = b
    rw [h1', idx_one]
  refine ⟨orderOf_eq_prime h5 hne, ?_⟩
  rw [← t2R_prod, ← wE_append, ← wE_append]
  refine eq_of_base fun t ht => ?_
  unfold wE
  rw [← wvG_eq _ (ok_append hw t2R_ok) t (by omega), ← wvG_eq _ (ok_append t2R_ok hw) t (by omega)]
  exact h3 t ht

@[expose] def InOrb (K : Subgroup J) (x : ℕ) : Prop := ∃ g ∈ K, idx 31671 g 1 = x

theorem inOrb_step {K : Subgroup J} {w : List ℕ} (hw : ∀ r ∈ w, RegOK r) (hy : wE w ∈ K) :
    ∀ q < 31671, InOrb K q → InOrb K (wv G w q) := by
  rintro q hq ⟨g, hg, hgq⟩
  refine ⟨wE w * g, K.mul_mem hy hg, ?_⟩
  rw [idx_mul, hgq, wvG_eq w hw q hq]
  rfl

theorem card_ge_of_orb (K : Subgroup J) (N : ℕ) (pt : ℕ → ℕ) (hR : ∀ i < N, InOrb K (pt i))
    (hinc : ∀ i j, i < j → j < N → pt i < pt j) : N ≤ Nat.card K := by
  have : Finite J := Nat.finite_of_card_ne_zero (by rw [card_J]; norm_num)
  choose! g hg hgp using hR
  let φ : Fin N → K := fun k => ⟨g k.1, hg k.1 k.2⟩
  have hφ : Function.Injective φ := by
    intro a b hab
    have h' : g a.1 = g b.1 := congrArg Subtype.val hab
    have e : pt a.1 = pt b.1 := by rw [← hgp a.1 a.2, ← hgp b.1 b.2, h']
    rcases lt_trichotomy a.1 b.1 with h | h | h
    · exact absurd e (hinc _ _ h b.2).ne
    · exact Fin.ext h
    · exact absurd e (hinc _ _ h a.2).ne'
  have := Nat.card_le_card_of_injective φ hφ
  rwa [Nat.card_eq_fintype_card, Fintype.card_fin] at this

theorem card_closure_y : 1080 < Nat.card (Subgroup.closure ({wE y1R, wE y2R} : Set J)) := by
  have hok : orbK G y1R y2R P 1081 1 = true := by
    have h := orbOK_ok
    unfold orbOK at h
    exact h
  obtain ⟨hR, hinc⟩ := orbK_spec hok (InOrb (Subgroup.closure ({wE y1R, wE y2R} : Set J)))
    ⟨1, Subgroup.one_mem _, idx_one 1⟩
    (inOrb_step y1R_ok (Subgroup.subset_closure (Set.mem_insert _ _)))
    (inOrb_step y2R_ok (Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)))
  have := card_ge_of_orb _ 1081 (fun i => ptE (recP P i)) (fun i hi => (hR i hi).2) hinc
  omega

