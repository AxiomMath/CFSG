theorem f_acts {x : ℕ} (hx : x < 31671) : idx 31671 fFive x = wv CFSG.KD.Fi23Five.H [1] x := by
  have h := rep_fFive x hx
  rw [orb_eq, CertificateChecks.KernelFi23Five.path_eq,
    CertificateChecks.KernelFi23Five.rw_f.ap hx] at h
