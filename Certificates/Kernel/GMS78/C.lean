module

public import CFSG.Certificates.Kernel.GMS78RuSound
public import Certificates.Kernel.GMS78.Gen
public import Certificates.Kernel.GMS78.Q
import CFSG.Certificates.Kernel.Common.Harness
import CFSG.Certificates.Kernel.Common.EachUnfold
import CFSG.Certificates.Kernel.Common.EachUnfoldKeyed
import Mathlib.Tactic.IntervalCases
import Batteries.Tactic.Init

public section

namespace CertificateChecks.KernelGMS78

open CFSG.KC.GMS

@[expose] noncomputable def WT1 : Nat := nat_lit 

@[expose] noncomputable def WT2 : Nat := nat_lit 

@[expose] noncomputable def WT3 : Nat := nat_lit 

@[expose] noncomputable def WT4 : Nat := nat_lit 

@[expose] noncomputable def WT5 : Nat := nat_lit 

@[expose] noncomputable def WT6 : Nat := nat_lit 

@[expose] noncomputable def WT7 : Nat := nat_lit 

@[expose] noncomputable def WT (c : Nat) : Nat :=
  nIf(Nat.beq c (nat_lit 1), WT1, nIf(Nat.beq c (nat_lit 2), WT2, nIf(Nat.beq c (nat_lit 3), WT3, nIf(Nat.beq c (nat_lit 4), WT4, nIf(Nat.beq c (nat_lit 5), WT5, nIf(Nat.beq c (nat_lit 6), WT6, nIf(Nat.beq c (nat_lit 7), WT7, nat_lit 0)))))))

@[expose] noncomputable def c1F (c : Nat) : Bool := kC1 c (WT c)

@[expose] noncomputable def c2F (c : Nat) : Bool := kC2 c

@[expose] noncomputable def c3F (i : Nat) : Bool := c3Pair (i / 7) (i % 7)

@[expose] def c3K (i : Nat) : Nat := i / 7

#kc_each_unfold c1F 1 8 as CertificateChecks.KernelGMS78.c1_
#kc_each_unfold c2F 1 8 as CertificateChecks.KernelGMS78.c2_
#kc_each_unfold_keyed c3F 0 56 as CertificateChecks.KernelGMS78.c3_ key c3K eval

theorem c1Check_eq : CFSG.GMS78Ru.c1Check = true := by
  rw [c1_eq]
  refine c1_sound _ (WT := WT) bindMul_ok pairs_ok fun c h1 h2 => ?_
  interval_cases c
  exacts [c1_1, c1_2, c1_3, c1_4, c1_5, c1_6, c1_7]

theorem c2Check_eq : CFSG.GMS78Ru.c2Check = true := by
  rw [c2_eq]
  refine c2_sound _ _ bindMul_ok pairs_ok bindSpec_ok fun c h1 h2 => ?_
  interval_cases c
  exacts [c2_1, c2_2, c2_3, c2_4, c2_5, c2_6, c2_7]

theorem c3Check_eq : CFSG.GMS78Ru.c3Check = true := by
  rw [c3_eq]
  refine c3_sound _ bindMul_ok mul_ok pairs_ok fun c hc k hk => ?_
  interval_cases c <;> interval_cases k
  exacts [c3_0_0, c3_0_1, c3_0_2, c3_0_3, c3_0_4, c3_0_5, c3_0_6, c3_1_0, c3_1_1, c3_1_2, c3_1_3, c3_1_4, c3_1_5, c3_1_6, c3_2_0, c3_2_1, c3_2_2, c3_2_3, c3_2_4, c3_2_5, c3_2_6, c3_3_0, c3_3_1, c3_3_2, c3_3_3, c3_3_4, c3_3_5, c3_3_6, c3_4_0, c3_4_1, c3_4_2, c3_4_3, c3_4_4, c3_4_5, c3_4_6, c3_5_0, c3_5_1, c3_5_2, c3_5_3, c3_5_4, c3_5_5, c3_5_6, c3_6_0, c3_6_1, c3_6_2, c3_6_3, c3_6_4, c3_6_5, c3_6_6, c3_7_0, c3_7_1, c3_7_2, c3_7_3, c3_7_4, c3_7_5, c3_7_6]

end CertificateChecks.KernelGMS78

end
