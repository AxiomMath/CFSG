@[expose] noncomputable def mT (a b : Nat) : Nat := fld(MT, Nat.mul 6 (Nat.add (Nat.mul 64 a) b), 63)

@[expose] noncomputable def c8T (a : Nat) : Nat := fld(C8T, Nat.mul 6 a, 63)

@[expose] noncomputable def iT (a : Nat) : Nat := fld(IT, Nat.mul 6 a, 63)

@[expose] noncomputable def memB (c : Nat) : Bool := Nat.beq fld(CB, c, 1) 1

@[expose] noncomputable def zK (x y z : Nat) : Bool := bAnd(Nat.beq x 0, bAnd(Nat.beq y 0, Nat.beq z 0))

@[expose] noncomputable def isoK (x y z : Nat) : Bool :=
  Nat.beq (Nat.mod (Nat.xor (Nat.mod (Nat.xor (mT (c8T x) z) (mT (c8T y) y)) 64) (mT (c8T z) x)) 64) 0

@[expose] noncomputable def codeK (x y z : Nat) : Nat :=
  nIf(Nat.beq x 0, nIf(Nat.beq y 0, 1, 64 + mT (iT y) z), 4096 + 64 * mT (iT x) y + mT (iT x) z)

@[expose] noncomputable def eltK (x y z : Nat) : Bool :=
  bIf(zK x y z, true, bIf(isoK x y z, memB (codeK x y z), true))

@[expose] noncomputable def ptsChkK (x0 n : Nat) : Bool :=
  allK n fun i => allK 64 fun y => allK 64 fun z => eltK (Nat.add x0 i) y z

theorem mulOK : allK 64 (fun a => allK 64 fun b => Nat.beq (mulNat a b) (mT a b)) = true := by
  quickRfl

theorem c8TOK : allK 64 (fun a => Nat.beq (c8L.getD a 0) (c8T a)) = true := by quickRfl

theorem invOK : allK 64 (fun a => Nat.beq ((ofNat' a)⁻¹).toNat (iT a)) = true := by quickRfl

theorem codesPc : (((List.range 513).map fun i => vcode (ptsVc i)) == codesLit) = true := by
