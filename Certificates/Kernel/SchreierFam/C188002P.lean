theorem chk1 : ptsChk 16 16 = true := ptsChk_of (by decide) chkK1

theorem chk2 : ptsChk 32 16 = true := ptsChk_of (by decide) chkK2

theorem chk3 : ptsChk 48 16 = true := ptsChk_of (by decide) chkK3

