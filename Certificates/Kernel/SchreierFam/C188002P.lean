theorem cbHi : Nat.beq (CB >>> 8192) 0 = true := by quickRfl

theorem fld_lt (n : Nat) : Nat.land n 63 < 64 := Nat.lt_succ_of_le Nat.and_le_right

theorem toNat_lt (a : GF64) : a.toNat < 64 := a.val.isLt

theorem eq_ofNat (a : GF64) : a = ofNat' a.toNat := by
  cases a with
  | mk v => exact congrArg GF64.mk (Fin.ext (Nat.mod_eq_of_lt v.2).symm)

theorem beq_eq (a b : GF64) : (a == b) = (a.toNat == b.toNat) := by
  rw [Bool.eq_iff_iff, beq_iff_eq, beq_iff_eq]
  exact ⟨congrArg toNat, fun h => by rw [eq_ofNat a, eq_ofNat b, h]⟩

theorem tn_mul (a b : GF64) : (a * b).toNat = mT a.toNat b.toNat := by
  have h := Nat.eq_of_beq_eq_true
    (allK_sound (allK_sound mulOK a.toNat (toNat_lt a)) b.toNat (toNat_lt b))
  change mulNat a.toNat b.toNat % 64 = _
  rw [h]
  exact Nat.mod_eq_of_lt (fld_lt _)

theorem tn_add (a b : GF64) : (a + b).toNat = (a.toNat ^^^ b.toNat) % 64 := rfl

theorem tn_c8 (a : GF64) : (c8 a).toNat = c8T a.toNat := by
  have h := Nat.eq_of_beq_eq_true (allK_sound c8TOK a.toNat (toNat_lt a))
  change c8L.getD a.toNat 0 % 64 = _
  rw [h]
  exact Nat.mod_eq_of_lt (fld_lt _)

theorem tn_inv (a : GF64) : (a⁻¹).toNat = iT a.toNat := by
  have h := Nat.eq_of_beq_eq_true (allK_sound invOK a.toNat (toNat_lt a))
  rw [← eq_ofNat a] at h
  exact h

theorem tn_zero : (0 : GF64).toNat = 0 := rfl

theorem tn_one : (1 : GF64).toNat = 1 := rfl

theorem ofNat'_eq_zero {x : Nat} (hx : x < 64) : ofNat' x = 0 ↔ x = 0 := by
  constructor
  · intro e
    exact (Nat.mod_eq_of_lt hx).symm.trans (congrArg toNat e)
  · rintro rfl
    rfl

theorem beq_false {x y : Nat} (h : x ≠ y) : Nat.beq x y = false := by
  cases e : Nat.beq x y
  · rfl
  · exact absurd (Nat.eq_of_beq_eq_true e) h

theorem isoB_eq {x y z : Nat} (hx : x < 64) (hy : y < 64) (hz : z < 64) :
    isoB (ofNat' x) (ofNat' y) (ofNat' z) = isoK x y z := by
  have ha : (ofNat' x).toNat = x := Nat.mod_eq_of_lt hx
  have hb : (ofNat' y).toNat = y := Nat.mod_eq_of_lt hy
  have hc : (ofNat' z).toNat = z := Nat.mod_eq_of_lt hz
  rw [isoB, beq_eq, tn_add, tn_add, tn_mul, tn_mul, tn_mul, tn_c8, tn_c8, tn_c8, ha, hb, hc,
    tn_zero, isoK, Bool.eq_iff_iff, beq_iff_eq, Nat.beq_eq]
  exact Iff.rfl

theorem memB_lt {c : Nat} (h : memB c = true) : c < 8192 := by
  refine Nat.lt_of_not_le fun hge => ?_
  have e : c = 8192 + (c - 8192) := by omega
  have h0 : CB >>> c = 0 := by
    rw [e, Nat.shiftRight_add, Nat.eq_of_beq_eq_true cbHi, Nat.zero_shiftRight]
  have h1 : memB c = Nat.beq ((CB >>> c) &&& 1) 1 := rfl
  rw [h1, h0] at h
  exact absurd h (by decide)

theorem memB_sound {c : Nat} (h : memB c = true) : codesL.contains c = true := by
  have hc := memB_lt h
  have hm := allK_sound (allK_sound memOK (c / 64) (by omega)) (c % 64) (Nat.mod_lt _ (by decide))
  have e : Nat.add (Nat.mul 64 (c / 64)) (c % 64) = c := Nat.div_add_mod c 64
  beta_reduce at hm
  rw [e, h] at hm
  rw [codesL_eq]
  exact hm

theorem code_eq {x y z : Nat} (hx : x < 64) (hy : y < 64) (hz : z < 64) :
    vcode (normV3 (ofNat' x) (ofNat' y) (ofNat' z)) = codeK x y z := by
  have hb : (ofNat' y).toNat = y := Nat.mod_eq_of_lt hy
  have hc : (ofNat' z).toNat = z := Nat.mod_eq_of_lt hz
  by_cases hx0 : x = 0
  · subst hx0
    have h0 : ofNat' 0 = 0 := rfl
    by_cases hy0 : y = 0
    · subst hy0
      rw [normV3, if_neg (by simp [h0]), if_neg (by simp [h0])]
      rfl
    · have hne : ofNat' y ≠ 0 := fun e => hy0 ((ofNat'_eq_zero hy).1 e)
      rw [normV3, if_neg (by simp [h0]), if_pos hne, codeK, Nat.beq_refl, beq_false hy0]
      simp only [vcode, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        Matrix.head_cons, Matrix.tail_cons, tn_zero, tn_one, tn_mul, tn_inv, hb, hc]
  · have ha : (ofNat' x).toNat = x := Nat.mod_eq_of_lt hx
    have hne : ofNat' x ≠ 0 := fun e => hx0 ((ofNat'_eq_zero hx).1 e)
    rw [normV3, if_pos hne, codeK, beq_false hx0]
    simp only [vcode, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, tn_one, tn_mul, tn_inv, ha, hb, hc]

theorem elt_sound {x y z : Nat} (hx : x < 64) (hy : y < 64) (hz : z < 64)
    (h : eltK x y z = true) :
    ((ofNat' x == 0 && ofNat' y == 0 && ofNat' z == 0) || !isoB (ofNat' x) (ofNat' y) (ofNat' z) ||
      codesL.contains (vcode (normV3 (ofNat' x) (ofNat' y) (ofNat' z)))) = true := by
  by_cases h0 : x = 0 ∧ y = 0 ∧ z = 0
  · obtain ⟨rfl, rfl, rfl⟩ := h0
    rfl
  have hzK : zK x y z = false := by
    unfold zK
    cases e1 : Nat.beq x 0 <;> cases e2 : Nat.beq y 0 <;> cases e3 : Nat.beq z 0 <;>
      first
      | rfl
      | exact absurd ⟨Nat.eq_of_beq_eq_true e1, Nat.eq_of_beq_eq_true e2,
          Nat.eq_of_beq_eq_true e3⟩ h0
  rw [isoB_eq hx hy hz]
  cases hi : isoK x y z
  · simp only [Bool.not_false, Bool.or_true, Bool.true_or]
  · have hm : memB (codeK x y z) = true := by
      rw [eltK, hzK, hi] at h
      exact h
    rw [code_eq hx hy hz, memB_sound hm, Bool.or_true]

theorem ptsChk_of {x0 n : Nat} (hn : x0 + n ≤ 64) (h : ptsChkK x0 n = true) :
    ptsChk x0 n = true := by
  rw [ptsChk, List.all_eq_true]
  intro x hx
  rw [List.mem_range'_1] at hx
  rw [List.all_eq_true]
  intro y hy
  rw [List.mem_range] at hy
  rw [List.all_eq_true]
  intro z hz
  rw [List.mem_range] at hz
  have h1 := allK_sound (allK_sound (allK_sound h (x - x0) (by omega)) y hy) z hz
  have e : Nat.add x0 (x - x0) = x := Nat.add_sub_cancel' hx.1
  beta_reduce at h1
  rw [e] at h1
  exact elt_sound (by omega) hy hz h1

