  apply List.map_congr_left
  intro i hi
  rw [ptsVn_eq (List.mem_range.1 hi)]

@[expose] noncomputable def ascK (l : List Nat) : Nat → Bool :=
  List.rec (motive := fun _ => Nat → Bool) (fun _ => true) (fun a _ ih p => bAnd(Nat.blt p a, ih a)) l

theorem ascK_sound : ∀ {l : List Nat} {p : Nat}, ascK l p = true →
    (∀ x ∈ l, p < x) ∧ l.Pairwise (· < ·)
  | [], _, _ => ⟨fun _ hx => absurd hx List.not_mem_nil, List.Pairwise.nil⟩
  | a :: t, p, h => by
    have e : ascK (a :: t) p = (Nat.blt p a && ascK t a) := by
      change Bool.rec (motive := fun _ => Bool) false (ascK t a) (Nat.blt p a) = _
      generalize Nat.blt p a = b
      cases b <;> rfl
    rw [e, Bool.and_eq_true] at h
    have hpa : p < a := Nat.le_of_ble_eq_true h.1
    obtain ⟨hall, hpw⟩ := ascK_sound h.2
    refine ⟨fun x hx => ?_, List.pairwise_cons.2 ⟨hall, hpw⟩⟩
    rcases List.mem_cons.1 hx with rfl | hx
    · exact hpa
    · exact Nat.lt_trans hpa (hall x hx)

