@[expose] noncomputable def allK (n : Nat) (f : Nat → Bool) : Bool :=
  Nat.rec (motive := fun _ => Bool) true (fun i ih => bAnd(f i, ih)) n

theorem allK_sound {f : Nat → Bool} : ∀ {n : Nat}, allK n f = true → ∀ i < n, f i = true
  | 0, _, i, hi => absurd hi (Nat.not_lt_zero i)
  | n + 1, h, i, hi => by
    have e : allK (n + 1) f = (f n && allK n f) := by
      change Bool.rec (motive := fun _ => Bool) false (allK n f) (f n) = _
      generalize f n = b
      cases b <;> rfl
    rw [e, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.1 hi with hi | rfl
    · exact allK_sound h.2 i hi
    · exact h.1

