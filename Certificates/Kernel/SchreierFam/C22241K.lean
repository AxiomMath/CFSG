@[expose] def prRe (a d : Nat) : Nat := a / 3 * (d / 3) + 2 * (a % 3) * (d % 3)

@[expose] def prIm (a d : Nat) : Nat := a / 3 * (d % 3) + a % 3 * (d / 3)

@[expose] def u43MCode (k i l : Nat) : Nat := k / 9 ^ (4 * i + l) % 9

@[expose] def u43DCode (j l : Nat) : Nat :=
  if j < 729 then
    (if l = 0 then 3 else if l = 1 then j / 81 else if l = 2 then j / 9 % 9 else j % 9)
  else if j < 810 then
    (if l = 0 then 0 else if l = 1 then 3 else if l = 2 then (j - 729) / 9 else (j - 729) % 9)
  else if j < 819 then (if l = 0 then 0 else if l = 1 then 0 else if l = 2 then 3 else j - 810)
  else if l = 3 then 3 else 0

@[expose] def u43Lead (j : Nat) : Nat :=
  if j < 729 then 0 else if j < 810 then 1 else if j < 819 then 2 else 3

@[expose] def wRe (k j i : Nat) : Nat :=
  prRe (u43MCode k i 0) (u43DCode j 0) + prRe (u43MCode k i 1) (u43DCode j 1) +
    prRe (u43MCode k i 2) (u43DCode j 2) + prRe (u43MCode k i 3) (u43DCode j 3)

@[expose] def wIm (k j i : Nat) : Nat :=
  prIm (u43MCode k i 0) (u43DCode j 0) + prIm (u43MCode k i 1) (u43DCode j 1) +
    prIm (u43MCode k i 2) (u43DCode j 2) + prIm (u43MCode k i 3) (u43DCode j 3)

@[expose] def u43FixAt (k j i : Nat) : Bool :=
  wRe k j i % 3 ==
      (wRe k j (u43Lead j) * (u43DCode j i / 3) +
        2 * wIm k j (u43Lead j) * (u43DCode j i % 3)) % 3 &&
    wIm k j i % 3 ==
      (wRe k j (u43Lead j) * (u43DCode j i % 3) + wIm k j (u43Lead j) * (u43DCode j i / 3)) % 3

@[expose] def u43Fix (k j : Nat) : Bool :=
  u43FixAt k j 0 && u43FixAt k j 1 && u43FixAt k j 2 && u43FixAt k j 3

@[expose] def onlyFixN (b c₁ c₂ : Nat) : Bool :=
  (List.range 820).all fun j => j == b || !u43Fix c₁ j || !u43Fix c₂ j

