namespace CFSG.KC.HeisN.Fast8

open CFSG.LieType.SeitzGeneration.HeisSmall CFSG.KC.HeisN

@[expose] def mulTab : Nat :=
  

@[expose] def powTab : Nat :=
  35033932947109091605909601340055701672450223426970060427036788566302439174594045779973167371575639800462969838248000

@[expose] def mulT (x y : Nat) : Nat :=
  cond (Nat.blt x 64 && Nat.blt y 64)
    (Nat.land (Nat.shiftRight mulTab (Nat.mul 6 (Nat.add (Nat.mul 64 x) y))) 63) (fk8.eMul x y)

@[expose] def addT (x y : Nat) : Nat :=
  cond (Nat.blt x 64 && Nat.blt y 64) (Nat.xor x y) (fk8.eAdd x y)

@[expose] def pow8T (x : Nat) : Nat :=
  cond (Nat.blt x 64) (Nat.land (Nat.shiftRight powTab (Nat.mul 6 x)) 63) (fk8.ePow x 8)

theorem mulTab_ok : (List.range 64).all (fun x => (List.range 64).all fun y =>
    Nat.beq (fk8.eMul x y)
      (Nat.land (Nat.shiftRight mulTab (Nat.mul 6 (Nat.add (Nat.mul 64 x) y))) 63)) = true := by
  decide +kernel

theorem addTab_ok : (List.range 64).all (fun x => (List.range 64).all fun y =>
    Nat.beq (fk8.eAdd x y) (Nat.xor x y)) = true := by
  decide +kernel

theorem powTab_ok : (List.range 64).all (fun x =>
    Nat.beq (fk8.ePow x 8) (Nat.land (Nat.shiftRight powTab (Nat.mul 6 x)) 63)) = true := by
  decide +kernel

theorem mulT_eq (x y : Nat) : fk8.eMul x y = mulT x y := by
  unfold mulT
  by_cases h : (Nat.blt x 64 && Nat.blt y 64) = true
  · rw [h, Bool.cond_true]
    simp only [Bool.and_eq_true, Nat.blt_eq] at h
    have t := mulTab_ok
    simp only [List.all_eq_true, List.mem_range, Nat.beq_eq] at t
    exact t x h.1 y h.2
  · rw [Bool.not_eq_true] at h
    rw [h, Bool.cond_false]

theorem addT_eq (x y : Nat) : fk8.eAdd x y = addT x y := by
  unfold addT
  by_cases h : (Nat.blt x 64 && Nat.blt y 64) = true
  · rw [h, Bool.cond_true]
    simp only [Bool.and_eq_true, Nat.blt_eq] at h
    have t := addTab_ok
    simp only [List.all_eq_true, List.mem_range, Nat.beq_eq] at t
    exact t x h.1 y h.2
  · rw [Bool.not_eq_true] at h
    rw [h, Bool.cond_false]

theorem pow8T_eq (x : Nat) : fk8.ePow x 8 = pow8T x := by
  unfold pow8T
  by_cases h : Nat.blt x 64 = true
  · rw [h, Bool.cond_true]
    rw [Nat.blt_eq] at h
    have t := powTab_ok
    simp only [List.all_eq_true, List.mem_range, Nat.beq_eq] at t
    exact t x h
  · rw [Bool.not_eq_true] at h
    rw [h, Bool.cond_false]

@[expose] def ipT (c d : ColN) : Nat :=
  addT (addT (mulT (pow8T c.1) d.1) (mulT (pow8T c.2.1) d.2.1)) (mulT (pow8T c.2.2) d.2.2)

theorem ipT_eq (c d : ColN) : fk8.ipN c d = ipT c d := by
  simp only [FK.ipN, ipT, mulT_eq, addT_eq, pow8T_eq]

@[expose] def stage1T (c₀ : ColN) : Bool := Nat.beq (ipT c₀ c₀) 1

@[expose] def stage2T (c₀ c₁ : ColN) : Bool := Nat.beq (ipT c₁ c₁) 1 && Nat.beq (ipT c₀ c₁) 0

@[expose] def stage3T (c₀ c₁ c₂ : ColN) : Bool :=
  Nat.beq (ipT c₂ c₂) 1 && Nat.beq (ipT c₀ c₂) 0 && Nat.beq (ipT c₁ c₂) 0

@[expose] def forallUnitaryT (P : M3 Nat → Bool) : Bool :=
  (fk8.cols4N 8).all fun c₀ => !(stage1T c₀) || (fk8.cols4N 8).all fun c₁ => !(stage2T c₀ c₁) ||
    (fk8.cols4N 8).all fun c₂ => !(stage3T c₀ c₁ c₂) || P (ofColsN c₀ c₁ c₂)

theorem forallUnitaryT_eq : forallUnitaryT = fk8.forallUnitaryN 8 := by
  funext P
  simp only [forallUnitaryT, FK.forallUnitaryN, stage1T, stage2T, stage3T, FK.stage1N, FK.stage2N,
    FK.stage3N, ipT_eq]

@[expose] def guListT : List (M3 Nat) :=
  (fk8.cols4N 8).flatMap fun c₀ => if stage1T c₀ then
    (fk8.cols4N 8).flatMap fun c₁ => if stage2T c₀ c₁ then
      (fk8.cols4N 8).filterMap fun c₂ => if stage3T c₀ c₁ c₂ then some (ofColsN c₀ c₁ c₂) else none
    else [] else []

theorem guListT_eq : guListT = fk8.guListN 8 := by
  simp only [guListT, FK.guListN, stage1T, stage2T, stage3T, FK.stage1N, FK.stage2N, FK.stage3N,
    ipT_eq]
  try rfl

@[expose] def mMulT (A B : M3 Nat) : M3 Nat :=
  ⟨addT (addT (mulT A.a00 B.a00) (mulT A.a01 B.a10)) (mulT A.a02 B.a20),
    addT (addT (mulT A.a00 B.a01) (mulT A.a01 B.a11)) (mulT A.a02 B.a21),
    addT (addT (mulT A.a00 B.a02) (mulT A.a01 B.a12)) (mulT A.a02 B.a22),
    addT (addT (mulT A.a10 B.a00) (mulT A.a11 B.a10)) (mulT A.a12 B.a20),
    addT (addT (mulT A.a10 B.a01) (mulT A.a11 B.a11)) (mulT A.a12 B.a21),
    addT (addT (mulT A.a10 B.a02) (mulT A.a11 B.a12)) (mulT A.a12 B.a22),
    addT (addT (mulT A.a20 B.a00) (mulT A.a21 B.a10)) (mulT A.a22 B.a20),
    addT (addT (mulT A.a20 B.a01) (mulT A.a21 B.a11)) (mulT A.a22 B.a21),
    addT (addT (mulT A.a20 B.a02) (mulT A.a21 B.a12)) (mulT A.a22 B.a22)⟩

theorem mMulT_eq (A B : M3 Nat) : fk8.mMul A B = mMulT A B := by
  simp only [FK.mMul, mMulT, mulT_eq, addT_eq]

@[expose] def mPowTr8T (A : M3 Nat) : M3 Nat :=
  ⟨pow8T A.a00, pow8T A.a10, pow8T A.a20, pow8T A.a01, pow8T A.a11,
    pow8T A.a21, pow8T A.a02, pow8T A.a12, pow8T A.a22⟩

theorem mPowTr8T_eq (A : M3 Nat) : fk8.mPowTr 8 A = mPowTr8T A := by
  simp only [FK.mPowTr, mPowTr8T, pow8T_eq]

@[expose] def mSmulT (c : Nat) (A : M3 Nat) : M3 Nat :=
  ⟨mulT c A.a00, mulT c A.a01, mulT c A.a02, mulT c A.a10, mulT c A.a11,
    mulT c A.a12, mulT c A.a20, mulT c A.a21, mulT c A.a22⟩

theorem mSmulT_eq (c : Nat) (A : M3 Nat) : fk8.mSmul c A = mSmulT c A := by
  simp only [FK.mSmul, mSmulT, mulT_eq]

@[expose] def orbitT (gu : List (M3 Nat)) (Y : M3 Nat) : List (M3 Nat) :=
  gu.map fun g => mMulT (mMulT g Y) (mPowTr8T g)

theorem orbitT_eq : orbitT = fk8.orbitN := by
  funext gu Y
  simp only [orbitT, FK.orbitN, mMulT_eq, mPowTr8T_eq]

@[expose] def classOkT (bits : Nat) (A : M3 Nat) : Bool :=
  isScalarN A || !(isScalarN (mMulT (mMulT A A) A)) ||
    (fk8.f4nzN 8).any fun l =>
      match fk8.keyF4 8 (mSmulT l A) with
      | some k => bits.testBit (k + 64)
      | none => false

theorem classOkT_eq : classOkT = fk8.classOkN 8 := by
  funext bits A
  simp only [classOkT, FK.classOkN, mMulT_eq, mSmulT_eq]
  try rfl

