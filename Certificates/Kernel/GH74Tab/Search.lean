theorem c5042_data : dataOK dat = true := by decide +kernel

section Pieces

variable (D : CFSG.KC.GH74Tab.Dat) (img : Nat → Nat → Nat → Nat → Nat)

@[expose] def leafI (h0 h1 h2 h3 : Nat) : List (Nat × Nat) :=
  bif D.rel.foldl (fun r k => mul D r (hk h0 h1 h2 h3 k)) D.one == D.one then
    (let a := img h0 h1 h2 h3
     bif g6 a D.x0 != D.x0 then pairsOf D a else [])
  else []

@[expose] def searchFromI (hs : List Nat) : List (Nat × Nat) :=
  let NM := fun q x => (D.NM.getD q []).getD x 0
  let NL := fun q x => (D.NL.getD q []).getD x []
  hs.flatMap fun h0 =>
    bif mul D h0 h0 == D.x0 then [] else
    (NL 0 h0).flatMap fun h1 =>
      let m2 := NM 1 h0
      let m3 := NM 3 h0 &&& NM 4 h1
      (NL 2 h1).flatMap fun h2 =>
        bif bit m2 h2 then
          (NL 5 h2).flatMap fun h3 => bif bit m3 h3 then leafI D img h0 h1 h2 h3 else []
        else []

theorem search_eq_searchFromI : search D = searchFromI D (ofImg D) (D.L.getD 0 []) := rfl

theorem searchFromI_append (xs ys : List Nat) :
    searchFromI D img (xs ++ ys) = searchFromI D img xs ++ searchFromI D img ys := by
  simp only [searchFromI, List.flatMap_append]

end Pieces

