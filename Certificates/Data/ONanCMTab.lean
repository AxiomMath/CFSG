@[expose] def allBelow (n : Nat) (p : Nat → Bool) : Bool := (List.range n).all p

@[expose] def cmLettersOK : Bool :=
  ((List.range 12).all fun c => allBelow 480 (fun p => ap cmLetters[c]! p < 480)) &&
    (List.range 6).all fun i =>
      compTab 480 cmLetters[2 * i + 1]! cmLetters[2 * i]! == idTab 480 &&
        compTab 480 cmLetters[2 * i]! cmLetters[2 * i + 1]! == idTab 480

@[expose] def cmRelCodes : List (List Nat) :=
  cmRelWords.map fun w => w.map fun l => 2 * l.1.val + (if l.2 then 0 else 1)

@[expose] def cmRelOK : Bool :=
  cmRelCodes.all fun w => wordTab 480 cmLetters w == idTab 480

structure ChainLevel where
  base : Nat
  words : List (Nat × List Nat)

@[expose] def levelOK (letters : Array Tab) (prev : List Nat) (L : ChainLevel) : Bool :=
  (L.words.all fun qw =>
    let t := wordTab 480 letters qw.2
    (prev.all fun b => ap t b == b) && ap t L.base == qw.1 && qw.2.all (· < 12)) &&
  decide ((L.words.map Prod.fst).Nodup)

@[expose] def chainOK (letters : Array Tab) : List Nat → List ChainLevel → Bool
  | _, [] => true
  | prev, L :: rest => levelOK letters prev L && chainOK letters (prev ++ [L.base]) rest

@[expose] def chainProd (c : List ChainLevel) : Nat := (c.map fun L => L.words.length).prod

