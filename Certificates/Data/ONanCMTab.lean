@[expose] def cmLetters : Array Tab :=
  #[cmGenTabs[0]!, cmGenTabs[0]!, cmGenTabs[1]!, cmGenTabs[1]!, cmGenTabs[2]!, cmGenTabs[2]!,
    cmGenTabs[3]!, cmGenTabs[3]!, cmGenTabs[4]!, cmGenTabs[4]!, cmGenTabs[5]!,
