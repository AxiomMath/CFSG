@[inline, expose] def ap (t : Tab) (i : Nat) : Nat := t[i]!

@[expose] def idTab (n : Nat) : Tab := Array.ofFn (n := n) fun i => i.val

@[expose] def compTab (n : Nat) (s t : Tab) : Tab :=
  Array.ofFn (n := n) fun i => ap s (ap t i.val)

@[expose] def wordTab (n : Nat) (letters : Array Tab) (w : List Nat) : Tab :=
  w.foldr (fun c T => compTab n letters[c]! T) (idTab n)

