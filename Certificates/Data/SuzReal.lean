@[expose] def suzWordArr (w : List ℕ) : Array ℕ :=
  w.foldr (fun l T => compA 1782 (if l = 0 then CFSG.Sporadic.SuzOddCore.b0Arr
    else CFSG.Sporadic.SuzOddCore.b1Arr) T) (idA 1782)

@[expose] def invertsOK (w : List ℕ) (x : Array ℕ) : Bool :=
  let g := suzWordArr w
  w.all (fun l => decide (l < 2)) && eqA 1782 (compA 1782 g x) (compA 1782 (compA 1782 x x) g)

@[expose] def suzRealOK (_ : Unit := ()) : Bool :=
  let L := levels ()
  invertsOK suzRealWA (xAArr L) && invertsOK suzRealWB (xBArr L) && invertsOK suzRealWY (yArr L)

