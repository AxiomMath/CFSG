@[expose] def modes : List Nat := [1, 0, 0, 0]

@[expose] def starts : List Nat := [13, 8602166, 6009710, 6989722]

@[expose] def pairWords (_ : Unit := ()) : List (List (List Nat)) :=
  (pairText.splitOn "\n").map fun l => (l.splitOn "|").map fun w => parseHex w.toList

structure VTree where
  pts : Array Nat
  par : Array Nat
  lab : Array Nat
deriving Inhabited

def vtBFS (G : Array Rows) (v0 cap : Nat) : VTree :=
  Id.run do
    let mut pts : Array Nat := #[v0]
    let mut par : Array Nat := #[0]
    let mut lab : Array Nat := #[0]
    let mut seen : Std.HashSet Nat := ({} : Std.HashSet Nat).insert v0
    let mut h := 0
    while h < pts.size && pts.size < cap do
      for l in [0:G.size] do
        let y := act G[l]! pts[h]!
        if !seen.contains y then
          seen := seen.insert y
          pts := pts.push y
          par := par.push h
          lab := lab.push l
      h := h + 1
    return ⟨pts, par, lab⟩

@[expose] def vtOK (G : Array Rows) (v0 : Nat) (T : VTree) : Bool :=
  decide (0 < T.pts.size) && T.par.size == T.pts.size && T.lab.size == T.pts.size &&
    T.pts[0]! == v0 &&
    allIn 0 T.pts.size (fun i => decide (T.pts[i]! < 2 ^ 24) &&
      (i == 0 || (decide (T.par[i]! < i) && decide (T.lab[i]! < G.size) &&
        T.pts[i]! == act G[T.lab[i]!]! T.pts[T.par[i]!]!))) &&
    distinctKeys T.pts.toList &&
    (let ks : Std.HashSet Nat := Std.HashSet.ofList T.pts.toList
     allIn 0 T.pts.size fun i => allIn 0 G.size fun l => ks.contains (act G[l]! T.pts[i]!))

@[expose] def entryOrbit (r A B : Rows) (q cap v0 : Nat) : Bool :=
  let G : Array Rows := #[A, B]
  let T := vtBFS G v0 cap
  mul A r == mul r A && mul B r == mul r B && pow A q == one () && pow B q == one () &&
    A != one () && B != one () && validRows A && validRows B &&
    vtOK G v0 T && decide (81 ∣ T.pts.size)

@[expose] def entryProd (r A B : Rows) (q d : Nat) : Bool :=
  mul A r == mul r A && mul B r == mul r B && pow A q == one () && pow B q == one () &&
    A != one () && B != one () && validRows A && validRows B &&
    pow (mul A B) d == one () && mul A B != one () && validRows (mul A B)

@[expose] def entryOK (r : Rows) (q mode cap v0 : Nat) (wa wb : List Nat) : Bool :=
  if mode = 0 then entryOrbit r (wv (lRows ()) (lInvs ()) wa) (wv (lRows ()) (lInvs ()) wb) q cap v0
  else entryProd r (wv (lRows ()) (lInvs ()) wa) (wv (lRows ()) (lInvs ()) wb) q v0

@[expose] def threeOK (r : Rows) : Bool := pow r 3 == one () && r != one () && validRows r

@[expose] def pairsOK (_ : Unit := ()) : Bool :=
  let E := Timmesfeld.Co1Leaf.eltsOf (aGens ())
  let reps : List Rows := [E[243]!, E[81]!, E[324]!,
    wv (lRows ()) (lInvs ()) (rootWords.getD 2 [])]
  let qs : List Nat := [7, 7, 5, 7]
  let pw := pairWords ()
  decide (pw.length = 4) && decide (starts.length = 4) && decide (modes.length = 4) &&
    (List.range 4).all fun i => threeOK (reps.getD i (one ())) &&
      decide ((pw.getD i []).length = 2) &&
      entryOK (reps.getD i (one ())) (qs.getD i 0) (modes.getD i 0) 400000 (starts.getD i 0)
        ((pw.getD i []).getD 0 []) ((pw.getD i []).getD 1 [])

end CFSG.HardMathSupport.Solomon.Coordinator.Co1PairSize
