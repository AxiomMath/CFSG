@[expose] def ofCode4 (c : ℕ) : FieldFour := ⟨c.testBit 0, c.testBit 1⟩

@[expose] def boolWord (w : List ℕ) : List Bool := w.map (· == 2)

@[expose] def boolProg (p : List (ℕ × ℕ)) : List (ℕ × Bool) := p.map fun e => (e.1, e.2 == 2)

@[expose] def spinF4 (n : ℕ) (tw : List (List ℕ)) (tc : List ℕ) (Q Qi R Si Ti w : List ℕ)
    (spin dual : List (ℕ × ℕ)) : SpinData FieldFour n where
  terms := (tw.zip tc).map fun p => (boolWord p.1, ofCode4 p.2)
  Q := decF4L n n Q
  Qi := decF4L n n Qi
  R := decF4L n n R
  spin := boolProg spin
  Si := decF4L n n Si
  w := decVecF4L n w
  dual := boolProg dual
  Ti := decF4L n n Ti

