open CFSG.GH74.KGroups

abbrev Elt : Type := GF4 × GF4 × GF4 × Fin 3

@[expose] def one : Elt := (⟨0⟩, ⟨0⟩, ⟨0⟩, 0)

@[expose] def tk (k : Fin 3) : GF4 := GF4.ofNat' ([1, 3, 2].getD k.val 0)

@[expose] def sk (k : Fin 3) : GF4 := GF4.ofNat' ([1, 2, 3].getD k.val 0)

@[expose] def mulE (x y : Elt) : Elt :=
  (x.1 + tk x.2.2.2 * y.1, x.2.1 + tk x.2.2.2 * y.2.1,
    x.2.2.1 + sk x.2.2.2 * y.2.2.1 + tk x.2.2.2 * y.1 * x.2.1, x.2.2.2 + y.2.2.2)

@[expose] def elt (i : Fin 192) : Elt :=
  (⟨⟨(i.val / 16) % 4, Nat.mod_lt _ (by norm_num)⟩⟩, ⟨⟨(i.val / 4) % 4, Nat.mod_lt _ (by norm_num)⟩⟩,
    ⟨⟨i.val % 4, Nat.mod_lt _ (by norm_num)⟩⟩, ⟨i.val / 64, by have := i.isLt; omega⟩)

@[expose] def idxN (x : Elt) : Nat :=
  64 * x.2.2.2.val + 16 * x.1.val.val + 4 * x.2.1.val.val + x.2.2.1.val.val

@[expose] def idx (x : Elt) : Fin 192 := ⟨idxN x % 192, Nat.mod_lt _ (by norm_num)⟩

@[expose] def evalW (w : List (Fin 3)) (g : Fin 3 → Elt) : Elt :=
  w.foldl (fun acc l => mulE acc (g l)) one

@[expose] def gStd (_ : Unit := ()) : Fin 3 → Elt := ![elt 64, elt 16, elt 4]

