@[expose] def word (W : Array (List (Fin 3))) (i : Fin 192) : List (Fin 3) := W.getD i.val []

@[expose] def wordsOK (_ : Unit := ()) : Bool :=
  let W := wordArr ()
  let g0 := gStd ()
  (List.finRange 192).all fun i => evalW (word W i) g0 == elt i

