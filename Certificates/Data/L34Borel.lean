@[expose] def conjU (t : Tab) : Tab := conjTab 42 u0T u0iT t

@[expose] def sylEnum (j : Nat) : Enum := enumBFS 42 sylGens[j]! 64

@[expose] def sylOK (idxS : Std.HashMap Tab Nat) (ES : Array Tab) (j : Nat) : Bool :=
  let E := sylEnum j
  let idx := indexOf E.tabs
  (allBelow sylGens[j]!.size fun i => found idxS ES sylGens[j]![i]!) &&
    enumOK 42 sylGens[j]! E && E.tabs.size == 64 &&
    allBelow E.tabs.size fun k => found idx E.tabs (conjU E.tabs[k]!)

@[expose] def coverScan (ES : Array Tab) (Es : Array (Array Tab))
    (idxs : Array (Std.HashMap Tab Nat)) : Bool :=
  allBelow ES.size fun k =>
    let t := ES[k]!
    let t1 := conjU t
    let t2 := conjU t1
    t == idTab 42 || !(comp 42 t t == idTab 42) || !(comp 42 t t1 == comp 42 t1 t) ||
      let C := centTabs 42 (centTabs 42 (centTabs 42 ES t) t1) t2
      anyBelow 6 fun j => allBelow C.size fun i => found idxs[j]! Es[j]! C[i]!

@[expose] def normScan (ES : Array Tab) (Es : Array (Array Tab))
    (idxs : Array (Std.HashMap Tab Nat)) : Bool :=
  allBelow 6 fun j =>
    allBelow ES.size fun k =>
      let s := ES[k]!
      let si := invTab 42 s
      si.size == 42 && comp 42 si s == idTab 42 &&
        (!(allBelow sylGens[j]!.size fun i =>
            found idxs[j]! Es[j]! (conjTab 42 s si sylGens[j]![i]!)) ||
          found idxs[j]! Es[j]! s || found idxs[j]! Es[j]! (comp 42 u0iT s) ||
          found idxs[j]! Es[j]! (comp 42 u0iT (comp 42 u0iT s)))

@[expose] def l34BorelCheck (ES : Array Tab) : Bool :=
  let idxS := indexOf ES
  let Es : Array (Array Tab) := (Array.range 6).map fun j => (sylEnum j).tabs
  let idxs := Es.map indexOf
  found idxS ES u0T && comp 42 u0iT u0T == idTab 42 && u0iT.size == 42 &&
    !(u0T == idTab 42) && comp 42 u0T (comp 42 u0T u0T) == idTab 42 && sylGens.size == 6 &&
    (allBelow 6 fun j => sylOK idxS ES j) && coverScan ES Es idxs && normScan ES Es idxs

end Certificates.L34Borel
