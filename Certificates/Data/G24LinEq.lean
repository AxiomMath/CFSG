@[expose] def quad1Check (_ : Unit := ()) : Bool :=
  let p1 := ofBits pQuad1
  let y1 := ofBits yQuad1
  let qk1c : Mono 8 × Fin 2 → ℕ := fun u => quadColKey u
  let qk1r : Fin 3 × Mono 8 × Fin 2 → ℕ := fun r => quadRowKey r
  let m1 := quadM matV1 matZ1
  let t1 := ent (tab (quadRows 8 2) (quadCols 8 2) fun r u => m1 r u) qk1r qk1c
  let k1 := quadK sqV1 cmV1 om
  spanOK m1 t1 k1 (ent p1 (fun i : Fin 2 => i.val) qk1c) (ent y1 qk1c qk1r)

@[expose] def quad2Check (_ : Unit := ()) : Bool :=
  let p2 := ofBits pQuad2
  let y2 := ofBits yQuad2
  let qk2c : Mono 6 × Fin 4 → ℕ := fun u => quadColKey u
  let qk2r : Fin 3 × Mono 6 × Fin 4 → ℕ := fun r => quadRowKey r
  let m2 := quadM matV2 matZ2
  let t2 := ent (tab (quadRows 6 4) (quadCols 6 4) fun r u => m2 r u) qk2r qk2c
  let k2 := quadK sqV2 cmV2 omegaN
  spanOK m2 t2 k2 (ent p2 (fun i : Fin 2 => i.val) qk2c) (ent y2 qk2c qk2r)

@[expose] def commCheck (_ : Unit := ()) : Bool :=
  let pc := ofBits pComm
  let yc := ofBits yComm
  let mc := commM
  let tc := ent (tab commRows commCols fun r u => mc r u)
    (fun r : Fin 2 × Fin 4 × Fin 4 => commRowKey r) (fun u : Fin 4 × Fin 4 => commColKey u)
  let kc := commK
  spanOK mc tc kc (ent pc (fun i : Fin 2 => i.val) (fun u => commColKey u))
    (ent yc (fun u => commColKey u) (fun r => commRowKey r))

@[expose] def ext2Check (_ : Unit := ()) : Bool :=
  let pe := ofBits pExt2
  let ye := ofBits yExt2
  let me := ext2M
  let te := ent (tab ext2Rows ext2Cols fun r u => me r u)
    (fun r : Fin 6 × Fin 2 × Fin 4 => ext2RowKey r)
    (fun u : Fin 3 × Fin 2 × Fin 4 => ext2ColKey u)
  let ke := ext2K
  let pek : ((Fin 2 × Fin 4) ⊕ Fin 2) → ℕ := fun c => ext2KKey c
  spanOK me te ke (ent pe pek (fun u => ext2ColKey u))
    (ent ye (fun u => ext2ColKey u) (fun r => ext2RowKey r))

@[expose] def linEqCheck (_ : Unit := ()) : Bool :=
