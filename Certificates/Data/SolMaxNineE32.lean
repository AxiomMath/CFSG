@[expose] def uCols (u : List ℕ) : List ℕ :=
  let imgs := t₀N :: u.map fun i => oListN.getD i 0
  bInvN.map (applyCols imgs)

@[expose] def letter (cols : List ℕ) (l : ℕ) : List ℕ := if l < 4 then gColsN.getD l [] else cols

@[expose] def evalWord (cols : List ℕ) (w : List ℕ) (v : ℕ) : ℕ :=
  w.foldr (fun l acc => applyCols (letter cols l) acc) v

@[expose] def candOK (u : List ℕ) : Bool :=
  let cols := uCols u
  let imgs := oListN.map (applyCols cols)
  imgs.all (fun x => oListN.contains x) && decide imgs.Nodup

@[expose] def entryOK (u : List ℕ) (e : List ℕ × ℕ) : Bool :=
  let cols := uCols u
  evalWord cols e.1 t₀N == t₀N &&
    (List.range 4).all fun i => evalWord cols e.1 (2 ^ i) == (oddColsN.getD e.2 []).getD i 0

@[expose] def lookup (u : List ℕ) : List ℕ × ℕ :=
  ((table.find? fun e => e.1 == u).map (·.2)).getD ([], 0)

@[expose] def digits (n : ℕ) : List ℕ := [n % 10, n / 10 % 10, n / 100 % 10, n / 1000 % 10]

@[expose] def checkOne (n : ℕ) : Bool :=
  let u := digits n
  !(candOK u) || entryOK u (lookup u)

@[expose] def check (_ : Unit := ()) : Bool := (List.range 10000).all checkOne

