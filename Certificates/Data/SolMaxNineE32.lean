@[expose] def aPerm : Fin 4 → Perm (Fin 9) :=
  ![swap 0 1 * swap 2 3, swap 0 2 * swap 1 3, swap 4 5 * swap 6 7, swap 4 6 * swap 5 7]

@[expose] def permOf (l : List (Fin 9 × Fin 9)) : Perm (Fin 9) :=
  (l.map fun p => swap p.1 p.2).prod

