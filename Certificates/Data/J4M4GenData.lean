inductive Line where
  | gen (k : Nat)
  | mul (i j : Nat)
  | inv (i : Nat)
  | pow (i e : Nat)

@[expose] def natOfChars (cs : List Char) : Nat :=
  cs.foldl (fun n c => 10 * n + (if '0' ≤ c && c ≤ '9' then c.toNat - '0'.toNat else 0)) 0

@[expose] def Line.ofToken : List Char → Line
  | 'g' :: r => .gen (natOfChars r)
  | 'i' :: r => .inv (natOfChars r)
  | 'm' :: r =>
    let p := r.splitOnP (· == '.')
    .mul (natOfChars (p.getD 0 [])) (natOfChars (p.getD 1 []))
  | 'p' :: r =>
    let p := r.splitOnP (· == '.')
    .pow (natOfChars (p.getD 0 [])) (natOfChars (p.getD 1 []))
  | _ => .gen 0

@[expose] def parseSlp (s : String) : List Line :=
  ((s.toList.splitOnP Char.isWhitespace).filter fun t => !t.isEmpty).map Line.ofToken

