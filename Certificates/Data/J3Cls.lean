@[expose] def clsTbl (k : Nat) : Table := hexT 4 6156 (6156 * k) j3ClsHex

@[expose] def eB : List Table := [j3CentTbl 9, clsTbl 0, clsTbl 1, clsTbl 2]

@[expose] def omT : Table := clsTbl 3

@[expose] def scT : Table := clsTbl 4

@[expose] def mGens : List Table := [clsTbl 5, clsTbl 6]

@[expose] def nGens : List Table := [clsTbl 5, clsTbl 6, clsTbl 3]

@[expose] def sGens : List Table := [clsTbl 7, clsTbl 8, clsTbl 9]

@[expose] def cGens : List Table :=
  [j3CentTbl 10, j3CentTbl 11, j3CentTbl 12, j3CentTbl 13, j3CentTbl 14]

@[expose] def allTbls : List Table := eB ++ [omT, scT] ++ mGens ++ sGens ++ cGens

@[expose] def tblsOK : Bool := allTbls.all fun T => permOK 6156 T && j3Sift T

@[expose] def normPred (bs : List Table) : Table → Bool :=
  let sp := spanTabs 6156 bs
  fun T => bs.all fun b => sp.any (tblEq 6156 (conjT 6156 T (invT 6156 T) b))

@[expose] def normCount : Nat :=
  (mulClosureH 6156 cGens.toArray 3000).1.toList.countP (normPred eB)

@[expose] def invComm (x y : Table) : Bool :=
  tblEq 6156 (compT 6156 y y) (idT 6156) && commTT 6156 y x

@[expose] def inConj (sp : List Table) (s x : Table) : Bool :=
  sp.any fun u => tblEq 6156 (compT 6156 s u) (compT 6156 x s)

@[expose] def clsOK : Bool :=
  let L := (mulClosureH 6156 sGens.toArray 3000).1
  let sp := spanTabs 6156 eB
  let s := scT
  L.all fun x => !(tblEq 6156 (compT 6156 x x) (idT 6156)) || sp.any (tblEq 6156 x) ||
    inConj sp s x || decide (L.toList.countP (invComm x) < 16)

