@[expose] def f4sq (x : Nat) : Nat := ((x &&& 1) ^^^ (x >>> 1)) ||| ((x >>> 1) <<< 1)

@[expose] def f4mulW (x : Nat) : Nat := (x >>> 1) ||| (((x &&& 1) ^^^ (x >>> 1)) <<< 1)

@[expose] def f4mul (s x : Nat) : Nat := if s == 1 then x else f4mulW x

@[expose] def addL (a b : List Int) : List Int := List.zipWith (· + ·) a b

@[expose] def srcT (γ : List Int) : List Nat :=
  (List.range 20).map fun i =>
    ((List.range 20).find? fun j => addL (w2.getD j []) γ == w2.getD i []).getD 20

@[expose] def modelFactor (γ : List Int) (s : Nat) (X : List Nat) : List Nat :=
  let S := srcT γ
  (List.range 20).map fun i =>
    let j := S.getD i 20
    X.getD i 0 ^^^ (if j < 20 then f4mul s (X.getD j 0) else 0)

@[expose] def expandV (v : Nat) : List Nat :=
  (List.range 20).map fun i =>
    let a := (v >>> (2 * (i / 2))) &&& 3
    if i % 2 == 0 then a else f4sq a

@[expose] def compressV (X : List Nat) : Nat :=
  (List.range 10).foldl (fun acc k => acc ||| ((X.getD (2 * k) 0) <<< (2 * k))) 0

@[expose] def genFac (g : Nat) : List (List Int × Nat) :=
  let t := triples.getD (g % 4) []
  let γ₁ := t.getD 0 []
  let γ₂ := t.getD 1 []
  let γ₃ := t.getD 2 []
  if g < 4 then [(γ₁, 1), (γ₂, 1), (γ₃, 2)] else [(γ₃, 2), (γ₂, 1), (γ₁, 1)]

@[expose] def modelGen (g : Nat) (X : List Nat) : List Nat :=
  (genFac g).foldr (fun p acc => modelFactor p.1 p.2 acc) X

@[expose] def gcol (g j : Nat) : Nat := compressV (modelGen g (expandV (1 <<< j)))

@[expose] def gcols (g : Nat) : List Nat := (List.range 20).map (gcol g)

@[expose] def gmats (_ : Unit := ()) : List (List Nat) := (List.range 8).map gcols

@[expose] def applyCols (cols : List Nat) (v : Nat) : Nat :=
  (List.range 20).foldl (fun acc j => if v.testBit j then acc ^^^ cols.getD j 0 else acc) 0

@[expose] def applyWord (M : List (List Nat)) (w : List Nat) (v : Nat) : Nat :=
  w.foldr (fun g acc => applyCols (M.getD g []) acc) v

@[expose] def compCols (M : List (List Nat)) (w : List Nat) : List Nat :=
  (List.range 20).map fun j => applyWord M w (1 <<< j)

@[expose] def stdVecs (_ : Unit := ()) : List Nat :=
  stdRep.flatMap fun k => [1 <<< (2 * k), 2 <<< (2 * k), 3 <<< (2 * k)]

@[expose] def ratOk (_ : Unit := ()) : Bool :=
  (List.range 8).all fun g => (List.range 20).all fun j =>
    expandV (gcol g j) == modelGen g (expandV (1 <<< j))

@[expose] def bfsOk (_ : Unit := ()) : Bool :=
  let M := gmats ()
  (List.range bfsTab.length).all fun e =>
    let t := bfsTab.getD e (0, 0, 0)
    ((List.range 10).any fun k => ((t.1 >>> (2 * k)) &&& 3) != 0) &&
      (if t.2.1 == 1000 then (stdVecs ()).contains t.1
        else (t.2.1 < e) && (t.2.2 < 8) &&
          (t.1 == applyCols (M.getD t.2.2 []) (bfsTab.getD t.2.1 (0, 0, 0)).1))

@[expose] def colsOk (_ : Unit := ()) : Bool :=
  (gmats ()).all fun cols => cols.all (· < 2 ^ 20)

@[expose] def wordsOk (_ : Unit := ()) : Bool :=
  transWords.all fun w => w.all (· < 8)

@[expose] def oSet (_ : Unit := ()) : Array Bool :=
  bfsTab.foldl (fun a e => a.set! e.1 true) (Array.replicate (2 ^ 20) false)

@[expose] def hasTrans (T : List (List Nat)) (O : Array Bool) (m : Nat) : Bool :=
  T.any fun c => O.getD (applyCols c m ^^^ m) false

@[expose] def allBelow (f : Nat → Bool) : Nat → Bool
  | 0 => true
  | k + 1 => if f (k + 1) then allBelow f k else false

@[expose] def e8TenTwoCheck (_ : Unit := ()) : Bool :=
  let M := gmats ()
  let T := transWords.map (compCols M)
  let O := oSet ()
  ratOk () && colsOk () && wordsOk () && bfsOk () && allBelow (hasTrans T O) (2 ^ 20 - 1)

end E8TenTwo
