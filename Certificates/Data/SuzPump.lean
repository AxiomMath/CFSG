@[expose] def fuseRow (j : Nat) : Array Nat := hexLine fuseText.toUTF8 3 14 j

@[expose] def fuseTab (_ : Unit := ()) : Array (Array Nat) :=
  Array.ofFn (n := 300) fun j => fuseRow j.val

@[expose] def okP (L : Array Level) (g : Array Nat) : Bool := validA 1782 g && inP L g

@[expose] def repOf (xA y : Array Nat) (r : Nat) : Array Nat := if r == 0 then xA else y

@[expose] def fuseCheckG (L : Array Level) (tab ts ns : Array (Array Nat)) (xA y x1 : Array Nat)
    (cs : Nat → ArrCert) : Bool :=
  okP L xA && eqA 1782 (powArr 1782 xA 3) (idA 1782) && !(eqA 1782 xA (idA 1782)) &&
  allLt tab.size (fun j => okP L ts[j]! && okP L ns[j]! &&
    eqA 1782 (conjA 1782 ns[j]! ts[j]!) (repOf xA y (tab[j]!)[13]!)) &&
  allLt 6 (fun i =>
    let c := cs i
    allLt c.pts.size (fun k =>
      let p := c.pts[k]!
      !(eqA 1782 (powArr 1782 p 3) (idA 1782)) || eqA 1782 p (idA 1782) ||
        (anyLt tab.size (fun j => (tab[j]!)[0]! == i && eqA 1782 p ts[j]!) &&
          (i != 0 || !(commA 1782 p x1)))))

@[expose] def fuseCheck (_ : Unit := ()) : Bool :=
  let L := levels ()
  let tab := fuseTab ()
  fuseCheckG L tab (tab.map fun r => rebuild L (r.extract 1 7))
    (tab.map fun r => rebuild L (r.extract 7 13)) (rebuild L xAβ) (yArr L) (suzFiveLineArr 1)
    suzFiveCCert

@[expose] def pairCheckG (L : Array Level) (xA : Array Nat) (gs : Array (Array Nat)) (fuel : Nat) :
    Bool :=
  gs.size == 2 &&
  allLt 2 (fun i => okP L gs[i]! && commA 1782 gs[i]! xA &&
    eqA 1782 (powArr 1782 gs[i]! 5) (idA 1782) && !(eqA 1782 gs[i]! (idA 1782))) &&
  let c := enumBfs 1782 gs suzFiveKeys fuel
  enumOK 1782 gs suzFiveKeys c && decide (1080 < c.pts.size)

@[expose] def pairCheck (_ : Unit := ()) : Bool :=
  let L := levels ()
  pairCheckG L (rebuild L xAβ) #[rebuild L g1β, rebuild L g2β] 8000

@[expose] def yCheckG (L : Array Level) (y : Array Nat) (ts : Array (Array Nat)) (a b g : Array Nat)
    (fuel : Nat) : Bool :=
  ts.size == 2 &&
  allLt 2 (fun i => okP L ts[i]! && commA 1782 ts[i]! y &&
    eqA 1782 (powArr 1782 ts[i]! 10) (idA 1782)) &&
  let c := enumBfs 1782 ts suzFiveKeys fuel
  enumOK 1782 ts suzFiveKeys c && c.pts.size == 360 &&
  okP L a && okP L b && okP L g &&
  c.pts.toList.any (eqA 1782 a) && c.pts.toList.any (eqA 1782 b) &&
  eqA 1782 (powArr 1782 a 3) (idA 1782) && !(eqA 1782 a (idA 1782)) &&
  eqA 1782 (powArr 1782 b 3) (idA 1782) && !(eqA 1782 b (idA 1782)) &&
  commA 1782 a b && !(eqA 1782 b a) && !(eqA 1782 b (powArr 1782 a 2)) &&
  eqA 1782 (conjA 1782 g a) a && eqA 1782 (conjA 1782 g b) (powArr 1782 b 2)

@[expose] def yCheck (_ : Unit := ()) : Bool :=
  let L := levels ()
  yCheckG L (yArr L) #[rebuild L uβ, rebuild L vβ] (rebuild L aβ) (rebuild L bβ) (rebuild L gβ) 400

