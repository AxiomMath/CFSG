@[expose] def regGens (α : ℕ) : Array Tab :=
  if α = 0 then regGens0 else if α = 1 then regGens1 else regGens2

@[expose] def regN (α : ℕ) : ℕ := if α = 2 then 128 else 256

@[expose] def regRelWords (α : ℕ) : List (List (Fin 7 × Bool)) :=
  if α = 2 then relWords2 else relWords4 α

@[expose] def wordPermTab (n : ℕ) (gens ginv : Array Tab) (w : List (Fin 7 × Bool)) : Tab :=
  w.foldl (fun acc l => comp n acc (if l.2 then gens[l.1.val]! else ginv[l.1.val]!)) (idTab n)

@[expose] def regRelOK (α : ℕ) : Bool :=
  let n := regN α
  let g := regGens α
  let gi := g.map (invTab n)
  g.size == 7 && invsOK n g gi && (regRelWords α).all fun w => wordPermTab n g gi w == idTab n

@[noinline, expose] def regEnum (α : ℕ) : Enum := enumBFS (regN α) (regGens α) (regN α)

@[expose] def regOrderOK (α : ℕ) : Bool :=
  enumOK (regN α) (regGens α) (regEnum α) && (regEnum α).tabs.size == regN α &&
    ((regEnum α).tabs.map fun t => t[0]!).toList.eraseDups.length == regN α

@[noinline, expose] def chPresOK : Bool :=
  pres4OK && pres2OK && regRelOK 0 && regRelOK 1 && regRelOK 2 && regOrderOK 0 &&
    regOrderOK 1 && regOrderOK 2

end CFSG.OddStandard.ChengHeldData
