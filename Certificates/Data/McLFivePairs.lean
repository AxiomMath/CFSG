@[expose] def hasInv (t : Tab) : Bool :=
  (invTab 275 t).size == 275 && comp 275 (invTab 275 t) t == idTab 275

@[expose] def gensOK (gs : Array Tab) : Bool := invsOK 275 gs (gs.map (invTab 275))

@[expose] def conjBy (g x : Tab) : Tab := comp 275 (comp 275 (invTab 275 g) x) g

@[expose] def wordIn (gs : Array Tab) (w : List Int) : Tab :=
  wordT 275 gs (gs.map (invTab 275)) w

@[expose] def pairGens (u v r : Tab) : Array Tab := #[u, v, conjBy r u, conjBy r v]

@[expose] def pairOK (u v : Tab) (reps : Array Tab) (e : Nat × List Int × List Int) : Bool :=
  let r := reps.getD e.1 (idTab 275)
  let gs := pairGens u v r
  hasInv r && gensOK gs && wordIn gs e.2.1 == mclTabA && wordIn gs e.2.2 == mclTabB

@[expose] def conjTabs (ns nsi : Array Tab) : Array Tab :=
  (conjWords.map (wordT 275 ns nsi)).toArray

@[expose] def blockGens (b : Array Tab) (h : Tab) : Array Tab := b.map (conjBy h)

@[expose] def actOK (blocks : Array (Array Tab)) (ns : Array Tab)
    (e : Nat × Nat × Nat × List (List Int)) : Bool :=
  let gi := blocks.getD e.1 #[]
  let gk := blocks.getD e.2.2.1 #[]
  let n := ns.getD e.2.1 (idTab 275)
  decide (e.2.2.1 < 3) && hasInv n && e.2.2.2.length == 4 &&
    allBelow 4 fun l => wordIn gk (e.2.2.2.getD l []) == conjBy n (gi.getD l (idTab 275))

@[expose] def joinOK (blocks : Array (Array Tab)) (e : Nat × Nat × List Int × List Int) : Bool :=
  let gs := blocks.getD e.1 #[] ++ blocks.getD e.2.1 #[]
  gensOK gs && wordIn gs e.2.2.1 == mclTabA && wordIn gs e.2.2.2 == mclTabB

@[expose] def strongTabs (b : Array Tab) : Array Tab := (sgsWords.map (wordIn b)).toArray

@[expose] def chainOK (b : Array Tab) : Bool :=
  let S := strongTabs b
  gensOK b && rawChainOK 275 (S.extract 0 4) S chainBase sgsWords.toArray 4 &&
    rawOrbitSizes 275 S chainBase == orbitLengths

@[expose] def check (_ : Unit := ()) : Bool :=
  let D := mclFiveDataP
  let u := (rGens D)[0]!
  let v := (rGens D)[1]!
  let reps := repT D
  let r := reps.getD excIdx (idTab 275)
  let b0 := pairGens u v r
  let hs := conjTabs (nGens D) (nGensI D)
  let blocks := hs.map (blockGens b0)
  invsOK 275 (nGens D) (nGensI D) &&
    pairWords.map (·.1) == (List.range 114).filter (fun i => i != 0 && i != excIdx) &&
    pairWords.all (pairOK u v reps) &&
    hasInv r && gensOK b0 &&
    hs.size == 3 && allBelow 3 (fun k => hasInv (hs.getD k (idTab 275))) &&
    allBelow 3 (fun k => gensOK (blocks.getD k #[])) &&
    actWords.map (fun e => (e.1, e.2.1)) == actIndex &&
    actWords.all (actOK blocks (nGens D)) &&
    joinWords.map (fun e => (e.1, e.2.1)) == joinIndex &&
    joinWords.all (joinOK blocks) &&
    chainOK b0

end Certificates.McLFivePairs
