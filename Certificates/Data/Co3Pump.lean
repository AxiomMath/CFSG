@[expose] def fuseGens (_ : Unit := ()) : Array (Array Nat) :=
  Array.ofFn (n := 2) fun i => pumpPerm i.val

@[expose] def pairGensA (_ : Unit := ()) : Array (Array Nat) :=
  Array.ofFn (n := 2) fun i => pumpPerm (2 + i.val)

@[expose] def pairGensB (_ : Unit := ()) : Array (Array Nat) :=
  Array.ofFn (n := 2) fun i => pumpPerm (4 + i.val)

@[expose] def fuseCheck (_ : Unit := ()) : Bool :=
  let L := levels ()
  let ng := fuseGens ()
  let E := dElts ()
  allLt 2 (fun i => validA 276 ng[i]! && inP L ng[i]!) &&
  allLt 243 (fun k => k == 0 || (tPar[k]! == k && (k == kA || k == kB)) ||
    (decide (tPar[k]! < 243) && decide (tPar[k]! ≠ 0) && decide (tGen[k]! < 2) &&
      decide (tDep[tPar[k]!]! < tDep[k]!) &&
      eqA 276 E[k]! (conjA 276 ng[tGen[k]!]! E[tPar[k]!]!)))

@[expose] def pairCheck (c : Array Nat) (gs : Array (Array Nat)) (fuel : Nat) : Bool :=
  let L := levels ()
  gs.size == 2 &&
  allLt 2 (fun i => validA 276 gs[i]! && inP L gs[i]! && commA 276 gs[i]! c &&
    eqA 276 (powArr 276 gs[i]! 5) (idA 276) && !(eqA 276 gs[i]! (idA 276))) &&
  let c := enumBfs 276 gs keys fuel
  enumOK 276 gs keys c && decide (1080 < c.pts.size)

@[expose] def pairACheck (_ : Unit := ()) : Bool :=
  pairCheck (dElts ())[kA]! (pairGensA ()) 2000

@[expose] def pairBCheck (_ : Unit := ()) : Bool :=
  pairCheck (dElts ())[kB]! (pairGensB ()) 20000

@[expose] def fiveCheck (_ : Unit := ()) : Bool :=
  let C := co3FiveC25Cert.pts
  let Q := co3FiveQCert.pts
  allLt C.size fun i =>
    let t := C[i]!
    !(eqA 276 (powArr 276 t 3) (idA 276)) || eqA 276 t (idA 276) ||
      decide (((List.range Q.size).filter fun j => commA 276 Q[j]! t).length < 25)

