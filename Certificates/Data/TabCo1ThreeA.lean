@[expose] def threeACheck (_ : Unit := ()) : Bool :=
  let D := kDag ext
  let xR := nd D 95
  let uR := nd D 96
  let wR := nd D 97
  let uI := ndI D 96
  let wI := ndI D 97
  let g0 := nd D 88
  let g1 := nd D 89
  let idx := [88, 89, 90, 91, 92, 93, 94]
  D.2.2 && wf xR && wf (one ()) && xR == rootRows3A () && xR != one () &&
    pow xR 3 == one () &&
    idx.all (fun i => mul xR (nd D i) == mul (nd D i) xR) &&
    mul xR uR == mul uR xR && mul xR wR == mul wR xR &&
    wf (mul g0 g1) && wf (mul g1 g0) && mul g0 g1 != mul g1 g0 &&
    relsS.all (fun w =>
      evalW D idx w == one () || evalW D idx w == xR || evalW D idx w == pow xR 2) &&
    mul (mul uI wI) (mul uR wR) == xR &&
    boundOK (colsOf (powList xR 3)) 3 base conds cnts span comb &&
    decide (cnts.prod ≤ 1345036492800)

