namespace CFSG.OPlusFourTwo

@[expose] def q0 (v : Fin 4 → ZMod 2) : ZMod 2 := v 0 * v 1 + v 3 * v 2

@[expose] def PreservesQ0 (M : Matrix (Fin 4) (Fin 4) (ZMod 2)) : Prop :=
  ∀ v : Fin 4 → ZMod 2, q0 (M.mulVec v) = q0 v

instance : DecidablePred PreservesQ0 := fun M => by
  unfold PreservesQ0
  infer_instance

