@[expose] def tritAt (b : ByteArray) (k : Nat) : Nat := digit27 (b.get! (k / 3)) / 3 ^ (k % 3) % 3

@[expose] def vecOfCode (s : String) : V := V.ofFn 154 fun j => tritAt s.toUTF8 j

@[expose] def addM (X Y : Array V) : Array V :=
  Array.ofFn (n := 154) fun i => X[i.val]!.add Y[i.val]!

@[expose] def negM (X : Array V) : Array V := X.map V.neg

@[expose] def outerRows (v u : V) : Array V :=
  Array.ofFn (n := 154) fun i => if v.get i.val = 1 then u else if v.get i.val = 2 then u.neg
    else V.zero

@[expose] def mulVecRow (M : Array V) (x : V) : V := comb 154 (transpose 154 M) x

@[expose] def wRows : Array V :=
  addM (addM (idM 154) (mul 154 rowsA rowsB)) (negM (mul 154 (mul 154 rowsA rowsB) rowsB))

