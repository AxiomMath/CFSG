@[expose] def letM : Array (Array V2) := g5Mats ()

@[expose] def letInv : Array (Array V2) := g5Invs ()

@[expose] def letT : Array (Array V2) := letM.map frTable

@[expose] def letInvT : Array (Array V2) := letInv.map frTable

@[expose] def mulT (X T : Array V2) : Array V2 := X.map (frApply T)

@[expose] def idT : Array V2 := frTable idRows

@[expose] def wordT (w : List Int) : Array V2 :=
  w.foldl (fun (acc : Array V2) (l : Int) =>
    mulT acc (if 0 < l then letT[l.toNat - 1]?.getD idT else letInvT[(-l).toNat - 1]?.getD idT))
    idRows

@[expose] def powWord (w : List Int) : Nat → List Int
  | 0 => []
  | e + 1 => w ++ powWord w e

@[expose] def genWord (n : Nat) : List Int :=
  if n < 12 then qGenW.getD n []
  else if n = 12 then aDw
  else if n = 13 then bDw
  else if n = 14 then powWord y5w y5e
  else if n = 15 then powWord y7w y7e
  else if n = 16 then powWord y11w y11e
  else if n < 28 then uWord (n - 17)
  else kWords.getD (n - 28) []

@[expose] def gmats : Array (Array V2) :=
  ((List.range 32).map fun n => wordT (genWord n)).toArray

@[expose] def gtabs : Array (Array V2) := gmats.map frTable

@[expose] def uTabs : Array (Array V2) :=
  ((List.range 11).map fun j => frTable (wordT (uWord j))).toArray

@[expose] def etaM (c : Nat) : Array V2 :=
  (List.range 11).foldl (fun acc j => if c.testBit j then mulT acc uTabs[j]! else acc) idRows

@[expose] def zM : Array V2 := etaM 1131

@[expose] def zT : Array V2 := frTable zM

@[expose] def natToV2 (n : Nat) : V2 := ⟨UInt64.ofNat (n % 2 ^ 64), UInt64.ofNat (n / 2 ^ 64)⟩

