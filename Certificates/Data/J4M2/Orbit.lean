@[expose] def vecs : Array V2 := (vecData.map natToV2).toArray

instance : Hashable V2 := ⟨V2.hash⟩

@[expose] def chkGens : Bool :=
  (List.range 32).all fun n =>
    wfR gmats[n]! && eqRows (mulT gmats[n]! zT) (mulT zM gtabs[n]!)

@[expose] def chkOrbit : Bool :=
  vecs.size == 77 && vecs.all V2.wf && V2.beq vecs[0]! rootV &&
    (List.range 77).all (fun i => i == 0 ||
      (decide (parData[i]! < i) && decide (genData[i]! < 32) &&
        V2.beq (frApply gtabs[genData[i]!]! vecs[i]!) vecs[parData[i]!]!)) &&
    (List.range 77).all (fun i => (List.range i).all fun j => !V2.beq vecs[i]! vecs[j]!) &&
    (List.range 32).all fun n => (List.range 77).all fun i =>
      decide (sigData[n]![i]! < 77) &&
        V2.beq (frApply gtabs[n]! vecs[sigData[n]![i]!]!) vecs[i]!

@[expose] def tMats : Array (Array V2) :=
  (List.range 77).foldl (fun acc i =>
    acc.push (if i == 0 then idRows else mulT gmats[genData[i]!]! (frTable acc[parData[i]!]!))) #[]

@[expose] def eSet : Std.HashSet (Array V2) :=
  (List.range 2048).foldl (fun S c => S.insert (etaM c)) ∅

@[expose] def v0Tabs : List (Array V2) := [frTable (etaM 422), frTable (etaM 553), zT]

@[expose] def invOK (i : Nat) : Bool :=
  eqRows (mulT tMats[i]! (frTable (invRows tMats[i]!))) idRows

@[expose] def inI5 (i : Nat) : Bool :=
  let ti := invRows tMats[i]!
  let tT := frTable tMats[i]!
  v0Tabs.all fun vT => eSet.contains (mulT (mulT ti vT) tT)

@[expose] def chkV0 : Bool :=
  (List.range 77).all fun i => invOK i && (inI5 i == i5List.contains i)

@[expose] def cMat : Array V2 :=
  mulT (mulT (mulT gmats[12]! gtabs[13]!) (frTable (invRows gmats[12]!)))
    (frTable (invRows gmats[13]!))

@[expose] def chkC : Bool :=
  eqRows (mulT gmats[12]! (frTable (invRows gmats[12]!))) idRows &&
    eqRows (mulT gmats[13]! (frTable (invRows gmats[13]!))) idRows &&
    wfR cMat && !eqRows cMat idRows &&
    eqRows (mulT (mulT cMat (frTable cMat)) (frTable cMat)) idRows &&
    (List.range 77).all fun i => V2.beq (frApply (frTable cMat) vecs[i]!) vecs[i]!

