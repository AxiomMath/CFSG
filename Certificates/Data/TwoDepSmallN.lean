set_option compiler.extract_closed false

@[expose] def ggTWDGen (p N : Nat) (news : List GGDepANPair) (g : Nat) : GGDepANPair :=
  if g + 1 < N then (ggDepANH p N g, ggDepANA p N g) else news.getD (g + 1 - N) ([], [])

@[expose] def ggTWDWord (p N : Nat) (news : List GGDepANPair) (q : GGDepANPair) (w : List Nat) :
    GGDepANPair :=
  w.foldr (fun g acc => ggDepANConj p acc (ggTWDGen p N news g)) q

@[expose] def ggTWDWitTest (p N : Nat) (news : List GGDepANPair) (w : GGDepANWit) : Bool :=
  ggDepANTestPair p (ggTWDWord p N news (ggTWDGen p N news w.g1) w.w1)
    (ggTWDWord p N news (ggTWDGen p N news w.g2) w.w2)

@[expose] def ggTWDWitValid (G : Nat) (w : GGDepANWit) : Bool :=
  decide (w.g1 < G) && decide (w.g2 < G) && w.w1.all (fun g => decide (g < G)) &&
    w.w2.all fun g => decide (g < G)

@[expose] def ggTWDSolH (p N pos : Nat) (tgt : Nat → Nat) : List (List Nat) :=
  let As := (List.range (N - 1)).map fun c => ggDepANA p N c
  (List.range (p ^ N)).filterMap fun k =>
    let v := ggTWNDecode p N k
    if (List.range (N - 1)).all (fun c =>
        !ggTWNInJ N pos c || ggDepANDot p (As.getD c []) v == tgt c % p) then some v else none

@[expose] def ggTWDSolA (p N pos : Nat) (tgt : Nat → Nat) : List (List Nat) :=
  let Hs := (List.range (N - 1)).map fun c => ggDepANH p N c
  (List.range (p ^ N)).filterMap fun k =>
    let v := ggTWNDecode p N k
    if (List.range (N - 1)).all (fun c =>
        !ggTWNInJ N pos c || ggDepANDot p v (Hs.getD c []) == tgt c % p) then some v else none

@[expose] def ggTWDCases1 (p N pos c0 mi ni : Nat) (wits : List GGDepANWit) : Bool :=
  let X := ggDepANX N
  let has := ggTWDSolH p N pos fun c => if c = c0 then (p - ni % p) % p else 0
  let aas := ggTWDSolA p N pos fun c => if c = c0 then (p - mi % p) % p else 0
  has.all fun ha => aas.all fun aa =>
    if ggDepANDot p aa ha == 2 % p && ggDepANDot p aa X != 0 then
      wits.any fun w => ggTWDWitTest p N [(ha, aa)] w
    else true

@[expose] def ggTWDRes (p N pos c : Nat) (swits rwits : List GGDepANWit) : Bool :=
  let X := ggDepANX N
  let nb := (p - 1) % p
  let h1s := ggTWDSolH p N pos fun c' => if c' = c then (p - 1) % p else 0
  let a1s := ggTWDSolA p N pos fun c' => if c' = c then (p - 1) % p else 0
  let h2s := ggTWDSolH p N pos fun _ => 0
  let a2s := ggTWDSolA p N pos fun _ => 0
  h1s.all fun h1 => a1s.all fun a1 =>
    if ggDepANDot p a1 h1 == 2 % p && ggDepANDot p a1 X == 0 then
      h2s.all fun h2 =>
        if ggDepANDot p a1 h2 == nb then
          a2s.all fun a2 =>
            if ggDepANDot p a2 h2 == 2 % p && ggDepANDot p a2 h1 == nb &&
                ggDepANDot p a2 X != 0 then
              (swits ++ rwits).any fun w => ggTWDWitTest p N [(h1, a1), (h2, a2)] w
            else true
        else true
    else true

structure GGTWDData where
  single : List ((Nat × Nat × Nat × Nat) × List GGDepANWit)
  res : List ((Nat × Nat) × List GGDepANWit)

@[expose] def ggTWDCheck (p N : Nat) (d : GGTWDData) : Bool :=
  d.single.all (fun e => e.2.all (ggTWDWitValid N)) &&
  d.res.all (fun e => e.2.all (ggTWDWitValid (N + 1))) &&
  [0, 1].all fun pos =>
    ((List.range (N - 1)).all fun c0 => [1, 2].all fun mi => [1, 2].all fun ni =>
      if ggTWNPat1B N pos c0 mi ni then
        match d.single.lookup (pos, c0, mi, ni) with
        | none => false
        | some wits => ggTWDCases1 p N pos c0 mi ni wits
      else true) &&
    ((List.range (N - 1)).all fun c =>
      if ggTWNPat2B N pos c none then
        match d.single.lookup (pos, c, 1, 1), d.res.lookup (pos, c) with
        | some swits, some rwits => ggTWDRes p N pos c swits rwits
        | _, _ => false
      else true)

