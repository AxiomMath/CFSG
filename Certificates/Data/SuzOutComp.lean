@[expose] def textWords (s : String) : Array (List Int) :=
  ((((s.splitOn "\n").drop 1).dropLast).map parseInts).toArray

@[expose] def blockArr (lab rep : Array Nat) (m : Nat) (t : Array Nat) : Array Nat :=
  Array.ofFn (n := m) fun j => lab[t[rep[j.val]!]!]!

@[expose] def blocksOK (n m : Nat) (lab rep : Array Nat) : Bool :=
  allLt m fun j => decide (rep[j]! < n) && lab[rep[j]!]! == j

@[expose] def blockOK (n m : Nat) (lab rep t : Array Nat) : Bool :=
  allLt n (fun x => decide (lab[x]! < m) == decide (lab[t[x]!]! < m)) &&
    allLt n (fun x => !decide (lab[x]! < m) || lab[t[x]!]! == (blockArr lab rep m t)[lab[x]!]!) &&
    isInvA m (blockArr lab rep m t) (invCand m (blockArr lab rep m t))

@[expose] def reachCheck (n : Nat) (S : Array (Array Nat)) (x : Nat) (labels roots : Array Nat)
    (k : Nat) (tw rw : Array (List Int)) : Bool :=
  allLt k fun j => j == labels[x]! || (
    let g := wordA n S (rawInvs n S) tw[roots[j]!]!
    isInvA n g (invCand n g) && allLt n fun p =>
      let w := rw[j * n + p]!
      lettersOK (S.push g).size w &&
        w.all (fun l => l.natAbs == (S.push g).size || (S[l.natAbs - 1]!)[x]! == x) &&
        (wordA n (S.push g) (rawInvs n (S.push g)) w)[x]! == p)

@[expose] def t2Lab : Array Nat := parseNats t2LabText

@[expose] def t2Rep : Array Nat := parseNats t2RepText

@[expose] def t2Gens : Array (Array Nat) := (invInnerGenArrs 2).map (blockArr t2Lab t2Rep 396)

@[expose] def t2Ab : Array (List Int) := textWords t2AbText

@[expose] def t2A : Array Nat := wordA 396 t2Gens (rawInvs 396 t2Gens) t2Ab[0]!

@[expose] def t2B : Array Nat := wordA 396 t2Gens (rawInvs 396 t2Gens) t2Ab[1]!

