module

public import Certificates.Data.F4TwoSeitz
public import Certificates.Data.ThreeWitness

public section

namespace CFSG.RankThree.PartOne.F106

open CFSG.LieType.Simplicity.TitsBits CFSG.RankThree.PartOne.SEITZX

@[expose] def pathBits (GB p : List ℕ) : ℕ := (p.map fun k => GB.getD k 0).foldr mul oneBits

structure F4SylowCert where
  gens : List (List ℕ)
  paths : List (List ℕ)
  rt : List ℕ
  inv : List ℕ
  zl : List ℕ
  wit : List Wit

namespace F4SylowCert

variable (c : F4SylowCert)

@[expose] def genBits (k : ℕ) : ℕ := codeBits (c.gens.getD k [])

@[expose] def gbList : List ℕ := (List.range 6).map c.genBits

@[expose] def tabList (GB : List ℕ) : List ℕ := c.paths.map (pathBits GB)

@[expose] def rtv (i g : ℕ) : ℕ := c.rt.getD (6 * i + g) 0

@[expose] def invv (i : ℕ) : ℕ := c.inv.getD i 0

@[expose] def conjBits (T : List ℕ) (i u : ℕ) : ℕ :=
  mul (mul (T.getD u 0) (T.getD i 0)) (T.getD (c.invv u) 0) % 2 ^ 2704

@[expose] def commB (T : List ℕ) (i j : ℕ) : Bool :=
  decide (mul (T.getD i 0) (T.getD j 0) % 2 ^ 2704 = mul (T.getD j 0) (T.getD i 0) % 2 ^ 2704)

@[expose] def witOK (T : List ℕ) (i : ℕ) : Wit → Bool
  | .exc => decide (i ∈ c.zl)
  | .conj4 u₀ u₁ u₂ u₃ =>
      decide (u₀ < 729 ∧ u₁ < 729 ∧ u₂ < 729 ∧ u₃ < 729) &&
        decide ([u₀, u₁, u₂, u₃].map (c.conjBits T i)).Nodup
  | .pair z x y =>
      decide (z < 729 ∧ x < 729 ∧ y < 729) && !commB T z i && commB T x i && commB T y i &&
        !commB T x y
  | .cube z x =>
      decide (z < 729 ∧ x < 729) && !commB T z i && commB T x i &&
        decide (mul (mul (T.getD x 0) (T.getD x 0)) (T.getD x 0) % 2 ^ 2704 ≠
          oneBits % 2 ^ 2704)

@[expose] def checkWith (GB T : List ℕ) : Bool :=
  decide (c.paths.length = 729) && decide (c.paths.getD 0 [] = []) &&
  c.paths.all (fun p => p.all (fun k => decide (k < 6))) &&
  decide (T.map (· % 2 ^ 2704)).Nodup &&
  (List.range 729).all (fun i => (List.range 6).all (fun g =>
    decide (c.rtv i g < 729) &&
      decide (mul (T.getD i 0) (GB.getD g 0) % 2 ^ 2704 = T.getD (c.rtv i g) 0 % 2 ^ 2704))) &&
  (List.range 729).all (fun i =>
    decide (c.invv i < 729) &&
      decide (mul (T.getD i 0) (T.getD (c.invv i) 0) % 2 ^ 2704 = oneBits % 2 ^ 2704)) &&
  decide (c.zl.length < 243) &&
  (List.range 729).all (fun i => c.witOK T i (c.wit.getD i .exc))

@[expose] def check : Bool :=
  let GB := c.gbList
  c.checkWith GB (c.tabList GB)

end F4SylowCert

