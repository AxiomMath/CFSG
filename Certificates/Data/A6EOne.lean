section Checks

variable (g : Grp)

@[expose] def Grp.m : Nat := g.rep.length

@[expose] def Grp.Sc : List (List Nat) := codes g.S

@[expose] def Grp.Ec (j : Nat) : List (List Nat) := codes (g.inv.getD j [])

@[expose] def Grp.inU (u : List Bool) (j : Nat) : Bool :=
  decide (g.cls.getD j 0 < g.m) && u.getD (g.cls.getD j 0) false

@[expose] def Grp.gens : List (List Nat) :=
  pslGenC ++ (g.I.filter (· != 0)).map fun i => autReps.getD i cid

@[expose] def Grp.chkX : Bool := decide (xList g.I).Nodup

@[expose] def Grp.chkS : Bool :=
  isSubC g.Sc && decide g.Sc.Nodup && g.Sc.all (inX g.I) && g.Sc.length == 8 * g.I.length &&
    isPow2 g.Sc.length

@[expose] def Grp.chkInv : Bool :=
  g.inv.all (fun E => isSubC (codes E) && decide (codes E).Nodup && (codes E).all g.Sc.contains) &&
    g.inv.any (fun E => setEqC (codes E) [cid]) &&
    (List.range g.inv.length).all fun j =>
      decide ((g.Ec j).length < 2) || decide (g.cls.getD j 0 < g.m)

@[expose] def Grp.chkClose : Bool :=
  (List.range g.inv.length).all fun j => g.Sc.all fun c =>
    (g.Ec j).contains c || cmul c c != cid || !commutesAll c (g.Ec j) ||
      g.inv.any fun F => setEqC (codes F) (g.Ec j ++ (g.Ec j).map (cmul c))

@[expose] def Grp.chkCls : Bool :=
  (List.range g.inv.length).all fun j => !decide (g.cls.getD j 0 < g.m) ||
    (inX g.I (dc (g.cj.getD j 0)) &&
      setEqC ((g.Ec j).map (conjC (dc (g.cj.getD j 0)))) (g.Ec (g.rep.getD (g.cls.getD j 0) 0)))

@[expose] def Grp.chkW (w : Wit) : Bool :=
  let Kc := codes w.K
  let Qc := codes w.Q
  let Pc := codes w.P
  let Ac := g.Ec w.A
  let sk := (g.Sc.filter Kc.contains).length
  decide (w.A < g.inv.length) && decide (g.cls.getD w.A 0 < g.m) &&
    isSubC Kc && isSubC Qc && isSubC Pc && decide Kc.Nodup && decide Qc.Nodup && decide Pc.Nodup &&
    Kc.all (inX g.I) && Ac.all Kc.contains &&
    g.Sc.all (fun s => !commutesAll s Ac || Kc.contains s) &&
    decide (0 < sk) && Kc.length % sk == 0 && (Kc.length / sk) % 2 == 1 &&
    Qc.all g.Sc.contains && Qc.all Kc.contains &&
    Kc.all (fun k => Qc.all fun q => Qc.contains (conjC k q)) &&
    g.Sc.all (fun s => !Kc.contains s || Qc.contains s ||
      Kc.any fun k => !g.Sc.contains (conjC (invC k) s)) &&
    Qc.all Pc.contains && Pc.all Kc.contains &&
    Kc.all (fun k => Pc.all fun x => Pc.contains (conjC k x)) &&
    (w.p == 3 || w.p == 5) && Pc.length == Qc.length * w.p &&
    Kc.length % Pc.length == 0 && isPow2 (Kc.length / Pc.length) &&
    Ac.length == 2 * (Ac.filter Qc.contains).length &&
    g.Sc.all (fun s => !Kc.contains s || Ac.all fun a => Qc.contains (commC s a)) &&
    Pc.any fun x => Ac.any fun a => !Qc.contains (commC x a)

@[expose] def Grp.chkWit : Bool := g.wit.all g.chkW

@[expose] def Grp.normU (u : List Bool) (x : List Nat) : Bool :=
  (List.range g.inv.length).all fun j => !g.inU u j ||
    (List.range g.inv.length).any fun j' => g.inU u j' && setEqC ((g.Ec j).map (conjC x)) (g.Ec j')

@[expose] def Grp.letterOK (u : List Bool) (l : Nat) : Bool :=
  g.wit.any (fun w => g.inU u w.A && (codes w.K).contains (dc l)) ||
    (inX g.I (dc l) && g.normU u (dc l))

@[expose] def Grp.chkWords : Bool :=
  g.words.length == (allBoolVecs g.m).length &&
    ((allBoolVecs g.m).zip g.words).all fun uw =>
      uw.2.length == g.gens.length &&
        (g.gens.zip uw.2).all fun gw =>
          gw.2.foldl (fun acc l => cmul acc (dc l)) cid == gw.1 && gw.2.all (g.letterOK uw.1)

@[expose] def Grp.check : Bool :=
  g.chkX && g.chkS && g.chkInv && g.chkClose && g.chkCls && g.chkWit && g.chkWords

end Checks

@[expose] def cosetOK : Bool :=
  autReps.getD 0 cid == cid &&
    [(1, 2, 3), (2, 1, 3), (1, 3, 2), (3, 1, 2), (2, 3, 1), (3, 2, 1)].all fun t =>
      pslLit.contains (cmul (cmul (autReps.getD t.1 cid) (autReps.getD t.2.1 cid))
        (autRepsInv.getD t.2.2 cid))

@[expose] def checkAll : Bool :=
  cosetOK && grp0.check && grp1.check && grp2.check && grp3.check && grp4.check

end CFSG.Quasithin.H13.A6EOne
