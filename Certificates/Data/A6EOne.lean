open CFSG.QuasithinUnique.A6Facts.Core
open CFSG.QuasithinUnique.Setup.X3Aut (invC)

@[expose] def dc (n : Nat) : List Nat := autL.getD n cid

@[expose] def codes (L : List Nat) : List (List Nat) := L.map dc

@[expose] def conjC (x e : List Nat) : List Nat := cmul (cmul x e) (invC x)

@[expose] def commC (x y : List Nat) : List Nat := cmul (cmul (cmul x y) (invC x)) (invC y)

@[expose] def inX (I : List Nat) (c : List Nat) : Bool :=
  I.any fun i => pslLit.contains (cmul c (autRepsInv.getD i cid))

@[expose] def xList (I : List Nat) : List (List Nat) :=
  I.flatMap fun i => pslLit.map fun y => cmul y (autReps.getD i cid)

@[expose] def isSubC (L : List (List Nat)) : Bool :=
  L.contains cid && L.all (fun a => L.all fun b => L.contains (cmul a b)) &&
    L.all fun a => L.contains (invC a)

@[expose] def setEqC (L M : List (List Nat)) : Bool := L.all M.contains && M.all L.contains

@[expose] def commutesAll (c : List Nat) (E : List (List Nat)) : Bool :=
  E.all fun e => cmul c e == cmul e c

@[expose] def isPow2 (n : Nat) : Bool := (List.range 7).any fun b => n == 2 ^ b

@[expose] def allBoolVecs : Nat → List (List Bool)
  | 0 => [[]]
  | m + 1 => (allBoolVecs m).flatMap fun v => [false :: v, true :: v]

