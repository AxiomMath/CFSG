@[expose] def sp62PeelOK (d : ℕ) : List (List ℕ) → List (List ℕ) → Bool
  | _, [] => true
  | R, v :: rest =>
    R.contains v && decide ((R.filter fun w => !(w == v) && commutes6 v w).length < d) &&
      sp62PeelOK d (R.erase v) rest

@[expose] def sp62PeelRes : List (List ℕ) → List (List ℕ) → List (List ℕ)
  | R, [] => R
  | R, v :: rest => sp62PeelRes (R.erase v) rest

@[expose] def sp62YOK (T : Array (List ℕ)) (y : List ℕ) : Bool :=
  pairCheck (y, y) && found T (indexMap T) y &&
    (sp62PeelRes sp62Invs sp62PeelSeq).all fun w => commutes6 w y

@[expose] def sp62X1OK : Bool :=
  sp62AGens.all pairCheck && sp62AGens.all (fun cc => sylowT.contains cc.1) &&
    closureOK (sp62AGens.map Prod.fst) sp62ATab 64 &&
    sp62ATab.all (fun c => mul6 c c == one6 && sp62ATab.all fun c' => commutes6 c c') &&
    sp62PeelOK 62 sp62Invs sp62PeelSeq && sp62YOK orbit0 sp62Y0 && sp62YOK orbit1 sp62Y1 &&
    sp62YOK orbit2 sp62Y2 && sp62YOK orbit3 sp62Y3

