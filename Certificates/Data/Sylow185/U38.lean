@[expose] def ps : List ℕ := [0, 1]

@[expose] def rGens (_ : Unit := ()) : Array (Array ℕ) :=
  Array.ofFn (n := 3) fun j => hexTable 3 513 (513 * j.val) dataHex

@[expose] def hList (_ : Unit := ()) : Array (Array ℕ) :=
  Array.ofFn (n := 9) fun j => hexTable 3 513 (513 * (3 + j.val)) dataHex

@[expose] def rCert (_ : Unit := ()) : ArrCert := enumBfs 513 (rGens ()) ps 800

@[expose] def keyProd (E : Array (Array ℕ)) (i j : ℕ) : ℕ :=
  Nat.ofDigits 513 (ps.map fun p => (E[i]!)[(E[j]!)[p]!]!)

@[expose] def mulTab (E : Array (Array ℕ)) : Array (Array ℕ) :=
  let idx : Std.HashMap ℕ ℕ :=
    (List.range E.size).foldl (fun m i => m.insert (keyA 513 ps E[i]!) i) (∅ : Std.HashMap ℕ ℕ)
  Array.ofFn (n := E.size) fun i => Array.ofFn (n := E.size) fun j => idx.getD (keyProd E i j) 0

@[expose] def mulI (T : Array (Array ℕ)) (i j : ℕ) : ℕ := (T[i]!)[j]!

@[expose] def tabOK (E T : Array (Array ℕ)) : Bool :=
  allLt E.size fun i => allLt E.size fun j =>
    decide (mulI T i j < E.size) && keyA 513 ps E[mulI T i j]! == keyProd E i j

@[expose] def commI (T : Array (Array ℕ)) (i j : ℕ) : Bool := mulI T i j == mulI T j i

@[expose] def cubeI (T : Array (Array ℕ)) (i : ℕ) : Bool := mulI T i (mulI T i i) == 0

@[expose] def genOK (gs : Array (Array ℕ)) : Bool :=
  let lev1 := rawLevels 513 strong1 base1
  allLt gs.size fun k => validA 513 gs[k]! && siftA 513 lev1 base1 0 gs[k]!

@[expose] def inXArr (lev3 : Array Level) (E : Array (Array ℕ)) : Array Bool :=
  E.map fun a => siftA 513 lev3 base3 0 a

@[expose] def flagged (ix : Array Bool) (N : ℕ) : List ℕ := (List.range N).filter fun i => ix[i]!

@[expose] def hsOK (lev3 : Array Level) (hs : Array (Array ℕ)) : Bool :=
  allLt hs.size fun k => validA 513 hs[k]! && siftA 513 lev3 base3 0 hs[k]!

@[expose] def d1OK (T : Array (Array ℕ)) (ix : Array Bool) (N : ℕ) : Bool :=
  let S0 := flagged ix N
  allLt N fun j => ix[j]! || S0.any fun s => !commI T j s

@[expose] def belems (T : Array (Array ℕ)) (i1 i2 : ℕ) : List ℕ :=
  let s1 := mulI T i1 i1
  let s2 := mulI T i2 i2
  [0, i1, s1, i2, mulI T i1 i2, mulI T s1 i2, s2, mulI T i1 s2, mulI T s1 s2]

@[expose] def cenOf (T : Array (Array ℕ)) (N i1 i2 : ℕ) : List ℕ :=
  (List.range N).filter fun x => commI T x i1 && commI T x i2

@[expose] def refD2 (T : Array (Array ℕ)) (cen bel : List ℕ) (j : ℕ) : Bool :=
  bel.any fun b => cen.all fun x => mulI T x j != mulI T (mulI T b j) x

@[expose] def wLetters : List ℕ := [247, 263, 282]

@[expose] def wPairs : List (ℕ × ℕ) :=
  [(702, 0), (402, 0), (250, 1), (418, 1), (393, 2), (356, 2), (310, 3), (345, 3), (307, 4), (370, 4), (337, 5), (705, 5), (313, 6), (707, 6), (388, 7), (713, 7), (297, 8), (369, 8)]

@[expose] def witOK (E hs : Array (Array ℕ)) (hi j : ℕ) : Bool :=
  let h := hs[hi]!
  let z1 := compA 513 (conjA 513 h E[247]!) E[263]!
  let z2 := compA 513 E[247]! (compA 513 (conjA 513 h E[263]!) E[282]!)
  let p := compA 513 z1 z2
  decide (hi < hs.size) && eqA 513 (compA 513 h E[j]!) (compA 513 E[j]! h) &&
    eqA 513 (compA 513 (compA 513 z1 z1) (compA 513 z1 z1)) (idA 513) &&
    eqA 513 (compA 513 (compA 513 z2 z2) (compA 513 z2 z2)) (idA 513) &&
    eqA 513 (compA 513 p (compA 513 p p)) (idA 513) && !eqA 513 p (idA 513)

@[expose] def omegaOK (E hs : Array (Array ℕ)) (bel : List ℕ) (j : ℕ) : Bool :=
  wPairs.any fun w => w.1 == j && wLetters.all (fun l => bel.contains l) && witOK E hs w.2 j

@[expose] def triplesOK (E hs T : Array (Array ℕ)) (ix : Array Bool) : Bool :=
  let N := E.size
  let S3 := (List.range N).filter fun i => ix[i]! && i != 0 && cubeI T i
  let C3 := (List.range N).filter fun j => !ix[j]! && cubeI T j
  S3.all fun i1 => S3.all fun i2 =>
    !(commI T i1 i2 && i2 != i1 && i2 != mulI T i1 i1) ||
      (let cen := cenOf T N i1 i2
       let bel := belems T i1 i2
       C3.all fun j => !(commI T j i1 && commI T j i2) || refD2 T cen bel j || omegaOK E hs bel j)

@[expose] def checkWith (gs : Array (Array ℕ)) (cR : ArrCert) (hs : Array (Array ℕ)) : Bool :=
  let E := cR.pts
  let T := mulTab E
  let lev3 := rawLevels 513 strong3 base3
  let ix := inXArr lev3 E
  enumOK 513 gs ps cR && E.size == 729 && genOK gs && tabOK E T &&
    (flagged ix E.size).length == 81 && hsOK lev3 hs && d1OK T ix E.size && triplesOK E hs T ix

@[expose] def check (_ : Unit := ()) : Bool := checkWith (rGens ()) (rCert ()) (hList ())

