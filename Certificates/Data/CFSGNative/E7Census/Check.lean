@[expose] def cartanN (i j : Nat) : Int := cartanArr[i]![j]!

@[expose] def posRootN (i k : Nat) : Int := posRootArr[i]![k]!

@[expose] def sum7 (f : Nat → Int) : Int := f 0 + f 1 + f 2 + f 3 + f 4 + f 5 + f 6

@[expose] def dig (c k : Nat) : Nat := c / 3 ^ k % 3

@[expose] def rcN (i j : Nat) : Int := sum7 fun k => posRootN i k * cartanN k j

@[expose] def alphaN (i c : Nat) : Int := (sum7 fun j => rcN i j * (dig c j : Int)) % 3

@[expose] def pairP (i j : Nat) : Int := sum7 fun k => rcN i k * posRootN j k

@[expose] def corootN (i c : Nat) : Int := (sum7 fun k => (dig c k : Int) * posRootN i k) % 3

@[expose] def dotN (c d : Nat) : Int := (sum7 fun k => (dig c k : Int) * (dig d k : Int)) % 3

@[expose] def inSpan1 (c d : Nat) : Bool :=
  Nat.any 3 fun a _ => Nat.all 7 fun k _ => dig c k == a * dig d k % 3

@[expose] def inSpan2 (c d e : Nat) : Bool :=
  Nat.any 3 fun a _ => Nat.any 3 fun b _ => Nat.all 7 fun k _ => dig c k == (a * dig d k + b * dig e k) % 3

@[expose] def projRepN (c : Nat) : Bool :=
  Nat.any 7 fun k _ => dig c k == 1 && Nat.all k fun j _ => dig c j == 0

@[expose] def mkMask (n : Nat) (p : Nat → Bool) : Nat :=
  Nat.fold n (fun i _ acc => if p i then acc ||| 2 ^ i else acc) 0

@[expose] def zmaskTab (_ : Unit := ()) : Array Nat :=
  Array.ofFn (n := 2187) fun c => mkMask 63 fun i => alphaN i c.val == 0

@[expose] def hmaskTab (_ : Unit := ()) : Array Nat :=
  Array.ofFn (n := 2187) fun c => mkMask 63 fun i => corootN i c.val == 0

@[expose] def adjTab (_ : Unit := ()) : Array Nat :=
  Array.ofFn (n := 63) fun i => mkMask 63 fun j => i.val != j && pairP i.val j != 0

@[expose] def grow (A : Array Nat) (S C : Nat) : Nat :=
  C ||| (S &&& Nat.fold 63 (fun a _ acc => if C.testBit a then acc ||| A[a]! else acc) 0)

@[expose] def growIter (A : Array Nat) (S : Nat) : Nat → Nat → Nat
  | 0, C => C
  | n + 1, C => let g := grow A S C; if g == C then C else growIter A S n g

@[expose] def comp (A : Array Nat) (S i : Nat) : Nat := growIter A S 63 (2 ^ i)

@[expose] def fixIn1 (Z : Array Nat) (X d : Nat) : Bool :=
  Nat.all 2187 fun c _ => !(X &&& Z[c]! == X) || inSpan1 c d

@[expose] def fixIn2 (Z : Array Nat) (X d e : Nat) : Bool :=
  Nat.all 2187 fun c _ => !(X &&& Z[c]! == X) || inSpan2 c d e

@[expose] def torTest (H : Array Nat) (L d : Nat) : Bool :=
  Nat.all 2187 fun c _ => !(L &&& H[c]! == L) || dotN c d == 0

@[expose] def popcount (X : Nat) : Nat :=
  Nat.fold 63 (fun i _ acc => if X.testBit i then acc + 1 else acc) 0

@[expose] def srootN (s k : Nat) : Int := if s < 63 then posRootN s k else -posRootN (s - 63) k

@[expose] def pairS (s t : Nat) : Int :=
  sum7 fun a => sum7 fun b => srootN s a * cartanN a b * srootN t b

@[expose] def reflN (s t k : Nat) : Int := srootN t k - pairS s t * srootN s k

@[expose] def sIndex (f : Nat → Int) : Nat :=
  ((List.range 126).find? fun u => (List.range 7).all fun k => srootN u k == f k).getD 126

@[expose] def reflTab (_ : Unit := ()) : Array Nat :=
  Array.ofFn (n := 126 * 126) fun t =>
    let s := t.val / 126
    let u := t.val % 126
    let p := pairS s u
    sIndex fun k => srootN u k - p * srootN s k

@[expose] def reflTabOK (R : Array Nat) : Bool :=
  Nat.all 126 fun s _ => Nat.all 126 fun t _ =>
    R[126 * s + t]! < 126 && Nat.all 7 fun k _ => srootN R[126 * s + t]! k == reflN s t k

@[expose] def smem (T : Nat × Nat) (s : Nat) : Bool :=
  if s < 63 then T.1.testBit s else T.2.testBit (s - 63)

@[expose] def sins (T : Nat × Nat) (s : Nat) : Nat × Nat :=
  if s < 63 then (T.1 ||| 2 ^ s, T.2) else (T.1, T.2 ||| 2 ^ (s - 63))

@[expose] def cstep (R : Array Nat) (gens : List Nat) (T : Nat × Nat) : Nat × Nat :=
  gens.foldl (fun acc g => Nat.fold 126 (fun t _ a => if smem T t then sins a R[126 * g + t]! else a) acc) T

@[expose] def citer (R : Array Nat) (gens : List Nat) : Nat → Nat × Nat → Nat × Nat
  | 0, T => T
  | n + 1, T => let T' := cstep R gens T; if T' == T then T else citer R gens n T'

@[expose] def genOK (R : Array Nat) (gens : List Nat) (X : Nat) : Bool :=
  gens.all (fun g => g < 126 && smem (X, X) g) &&
  gens.all (fun g => Nat.all 126 fun t _ => !smem (X, X) t || smem (X, X) R[126 * g + t]!) &&
  (let T := citer R gens 126 (gens.foldl sins (0, 0))
   Nat.all 126 fun t _ => !smem (X, X) t || smem T t)

@[expose] def detN : Nat → (Nat → Nat → Int) → Int
  | 0, _ => 1
  | n + 1, M => Nat.fold (n + 1) (fun j _ acc => if M 0 j == 0 then acc else
      acc + (-1) ^ j * M 0 j * detN n fun r c => M (r + 1) (if c < j then c else c + 1)) 0

structure Rec where
  x : Nat
  L : Nat
  J : Nat
  y : Nat
  K : Nat
  w : List Nat
  σ : List Nat

@[expose] def candOK (Z A : Array Nat) (r : Rec) : Bool :=
  r.x < 2187 && r.y < 2187 && projRepN r.y && r.y != r.x && (r.J &&& Z[r.y]! == r.J) &&
  (Nat.any 63 fun i _ => r.K.testBit i && Z[r.y]!.testBit i && comp A Z[r.y]! i == r.K) &&
  grow A Z[r.y]! r.K == r.K && (r.J &&& r.K == r.J) &&
  (Nat.any 63 fun i _ => r.K.testBit i && !Z[r.x]!.testBit i) &&
  (r.K &&& Z[r.y]! == r.K) && fixIn1 Z r.K r.y

@[expose] def gramArr (w : List Nat) : Array Int :=
  Array.ofFn (n := 49) fun t => pairS (w.getD (t.val / 7) 0) (w.getD (t.val % 7) 0)

@[expose] def witOK (R : Array Nat) (r : Rec) : Bool :=
  let w := fun k => r.w.getD k 0
  let σ := fun k => r.σ.getD k 0
  let G := gramArr r.w
  let g := fun i j => G[7 * i + j]!
  r.w.length == 7 && r.w.all (· < 126) &&
  genOK R [w 0, w 1, w 2, w 3, w 4] r.J && genOK R [w 0, w 1, w 2, w 3, w 4, w 5] r.L &&
  genOK R [w 0, w 1, w 2, w 3, w 4, w 6] r.K &&
  (Nat.all 7 fun i _ => σ i < 7 && Nat.all 7 fun j _ => i == j || σ i != σ j) &&
  (Nat.all 7 fun i _ => Nat.all 7 fun j _ => g (σ i) (σ j) == cartanN i j) &&
  (Nat.any 6 fun j _ => g 6 j != 0 && Nat.all 6 fun j' _ => j' == j || g 6 j' == 0) &&
  g 6 5 == 0 && detN 6 g == 3 &&
  (let gK := fun i j => g (if i < 5 then i else 6) (if j < 5 then j else 6)
   (popcount r.K == 21 && detN 6 gK == 7) || (popcount r.K == 30 && detN 6 gK == 4))

@[expose] def rowsOK (Z H A : Array Nat) (recs : List Rec) : Bool :=
  Nat.all 2187 fun cx _ => !projRepN cx || Nat.all 63 fun i _ => !Z[cx]!.testBit i ||
    (let L := comp A Z[cx]! i
     grow A Z[cx]! L == L &&
      (!(L % 2 ^ i == 0 && fixIn1 Z L cx && torTest H L cx) ||
        Nat.all 2187 fun cv _ => inSpan1 cv cx ||
          (let S := L &&& Z[cv]!
           Nat.all 63 fun j _ => !S.testBit j ||
            (let J := comp A S j
             grow A S J == J &&
              (!(J % 2 ^ j == 0 && fixIn2 Z J cx cv) ||
                recs.any fun r => r.x == cx && r.L == L && r.J == J)))))

@[expose] def simpleIdx (i : Nat) : Nat := [30, 15, 10, 6, 3, 1, 0].getD i 0

@[expose] def normV (c : Nat) : Nat :=
  if dig c (((List.range 7).find? fun k => dig c k != 0).getD 0) == 2 then
    (List.range 7).foldl (fun acc k => acc + 2 * dig c k % 3 * 3 ^ k) 0
  else c

@[expose] def actV (i c : Nat) : Nat :=
  normV (c - dig c i * 3 ^ i +
    (((dig c i : Int) - (sum7 fun j => cartanN i j * (dig c j : Int))) % 3).toNat * 3 ^ i)

@[expose] def actMask (R : Array Nat) (i X : Nat) : Nat :=
  Nat.fold 63 (fun j _ acc => if X.testBit j then acc ||| 2 ^ (R[126 * simpleIdx i + j]! % 63) else acc) 0

@[expose] def actRec (R : Array Nat) (r : Rec) (i : Nat) : Rec :=
  ⟨actV i r.x, actMask R i r.L, actMask R i r.J, actV i r.y, actMask R i r.K,
    r.w.map fun s => R[126 * simpleIdx i + s]!, r.σ⟩

