@[expose] def chainBase : Array Nat := #[0, 4, 3]

@[expose] def chainQ : Array Nat := #[0, 4, 3, 1, 2, 6, 7, 8, 10, 11, 12, 13, 15, 17]

@[expose] def chainQb : Array Nat := #[0, 1, 2]

@[expose] def orbitData (_ : Unit) : Orb := orbBFS 5 id mA mB root 400

@[expose] def chainLetters (O : Orb) : Array Table := buildLetters 315 (genTables O) chainWords

@[expose] def qVecs (O : Orb) : List (List Nat) := chainQ.toList.map fun q => O.pts[q]!

@[expose] def qMat (O : Orb) : List (List Nat) := colMat 14 (qVecs O)

@[expose] def matrixChecks (_ : Unit := ()) : Bool :=
  wfM 14 mA && wfM 14 mB && mulL 5 14 mA mA == idL 14 && powL 5 14 mB 3 == idL 14 &&
    powL 5 14 (mulL 5 14 mA mB) 7 == idL 14

@[expose] def actionChecks (O : Orb) (chunks : Nat) : Bool :=
  let L := chainLetters O
  let T := chainTrees 315 L chainBase
  let P := qMat O
  let Pi := gaussInv 5 14 P
  orbOK 5 14 eqRel mA mB root O && O.pts.size == 315 && vecSep O.pts &&
    invOK 315 O.alpha (invT 315 O.alpha) && invOK 315 O.beta (invT 315 O.beta) &&
    chainOK 315 L chainBase chainQ chainQb T chunks && orbitSizes T == [315, 160, 12] &&
    wfM 14 P && wfM 14 Pi && mulL 5 14 Pi P == idL 14 &&
    ap O.alpha 0 != 0 && ap O.beta 0 != 0 && ap O.alpha (ap O.beta 0) != 0 &&
    primOK 315 L (levelLetters L chainBase 1) T[0]!
      (primData 315 L (levelLetters L chainBase 1) T[0]!)

@[expose] def j2Certificate (chunks : Nat) : Bool :=
  matrixChecks && actionChecks (orbitData ()) chunks

