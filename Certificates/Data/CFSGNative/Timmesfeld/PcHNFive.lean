@[expose] def hnFiveOK (_ : Unit := ()) : Bool :=
  let P := parTree 5 6
  let L := leftTables 5 6 pw cwR
  let pl := pcLab 5 6 pw cwR
  pcRegOK 5 6 pw cw cwR && centerOK 5 6 P L && pcClassOK 5 6 P L pl.lab pl.wit pl.rep &&
    fusOK 5 6 P L pl.lab pl.rep #[] #[] (Array.range pl.rep.size)
      (Array.replicate pl.rep.size (0, 0)) (Array.replicate pl.rep.size 0) &&
    e3OK 5 6 P L pl.rep hnE3A hnE3B

