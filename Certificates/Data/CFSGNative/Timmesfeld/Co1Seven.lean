@[expose] def orbMatsT (b : Rows) : Array Rows :=
  Array.ofFn (n := 7) fun t => transposeRows 24 (pow b t.val)

structure Leaf7 where
  us : List Nat
  own : List Plan
  joint : List Plan
  slots : List (Nat × Nat)
  uinv : Rows
deriving Inhabited

@[expose] def finalsOf (X : Array Nat) (b : Rows) (L : Leaf7) : List (List (Array Nat)) :=
  stages (xsOf X) (X.toList.map (orbImg (orbMatsT b))) L.own L.joint

@[expose] def solsOf (X : Array Nat) (b : Rows) (L : Leaf7) : List Rows :=
  (finalsOf X b L).map (phiRows L.slots L.uinv)

@[expose] def uIOf (b : Rows) (L : Leaf7) : List (Array Nat) :=
  L.us.map (orbImg (orbMatsT b))

@[expose] def leafOK (X : Array Nat) (b : Rows) (L : Leaf7) : Bool :=
  validRows b && validRows L.uinv && L.us.all (fun u => (xsOf X).contains u) &&
    decide (L.own.length = L.us.length) && decide (L.joint.length = L.us.length) &&
    (List.range L.us.length).all
      (fun j => planOK (xsOf X) (fun _ => orbImg (orbMatsT b) (L.us.getD j 0))
        (L.own.getD j default)) &&
    (List.range L.us.length).all
      (fun j => planOK (xsOf X) (tupImgs ((uIOf b L).take (j + 1)))
        (L.joint.getD j default)) &&
    mul (colsToRows (slotCols L.slots (uIOf b L))) L.uinv == one ()

@[expose] def treeOf (gens : List Rows) : GTree := gtBFS gens.toArray 100000

@[expose] def ptsSet (T : GTree) : Std.HashSet Rows := Std.HashSet.ofList T.pts.toList

@[expose] def gensOK (b : Rows) (gens : List Rows) : Bool :=
  gens.all fun g => validRows g && mul g b == mul b g

@[expose] def cenOK (X : Array Nat) (b : Rows) (gens : List Rows) (T : GTree) (L : Leaf7)
    (N : Nat) : Bool :=
  leafOK X b L && gensOK b gens && gtOK gens.toArray T && decide (T.pts.size = N) &&
    (let S := ptsSet T
     (solsOf X b L).all fun m => S.contains m)

@[expose] def isTarget (qs : List Nat) (w : Rows) : Bool :=
  w != one () && qs.any fun q => pow w q == one ()

@[expose] def fusData (pts : Array Rows) (gs : List Rows) (good : Rows → Bool) :
    Array (Nat × Nat) := Id.run do
  let N := pts.size
  let mut pos : Std.HashMap Rows Nat := ∅
  for k in [0:N] do
    pos := pos.insert pts[k]! k
  let mut res : Array (Nat × Nat) := Array.replicate N (0, 0)
  let mut done : Array Bool := Array.replicate N false
  let ga := gs.toArray
  let gi := ga.map inv
  for k0 in [0:N] do
    if good pts[k0]! && !done[k0]! then
      done := done.set! k0 true
      res := res.set! k0 (k0, 0)
      let mut queue : Array Nat := #[k0]
      let mut qi := 0
      for _ in [0:N] do
        if qi < queue.size then
          let k := queue[qi]!
          qi := qi + 1
          let c := (res[k]!).2
          let kr := (res[k]!).1
          for j in [0:ga.size] do
            let y := mul (mul ga[j]! pts[k]!) gi[j]!
            match pos.get? y with
            | none => pure ()
            | some ky =>
              if !done[ky]! then
                match pos.get? (mul ga[j]! pts[c]!) with
                | none => pure ()
                | some kc =>
                  done := done.set! ky true
                  res := res.set! ky (kr, kc)
                  queue := queue.push ky
  return res

@[expose] def conjCand (a ai r : Rows) : Rows := mul (mul a r) ai

@[expose] def repWit (pts : Array Rows) (r : Rows) : Bool :=
  pts.any fun a =>
    let ai := inv a
    mul a ai == one () &&
      pts.any fun b =>
        let bi := inv b
        mul b bi == one () &&
          (let y := mul (mul r (conjCand a ai r)) (conjCand b bi r)
           validRows y && y != one () && pow y 7 == one ())

@[expose] def repOKs (pts : Array Rows) (F : Array (Nat × Nat)) (good : Rows → Bool) :
    Array Bool :=
  (List.range pts.size).toArray.map fun k =>
    good pts[k]! && (F[k]!).1 == k && repWit pts pts[k]!

@[expose] def closureOK (pts : Array Rows) (gs : List Rows) (qs : List Nat) : Bool :=
  let good := isTarget qs
  let F := fusData pts gs good
  let R := repOKs pts F good
  (List.range pts.size).all fun k =>
    !(good pts[k]!) ||
      (decide ((F[k]!).1 < pts.size) && decide ((F[k]!).2 < pts.size) &&
        mul pts[k]! pts[(F[k]!).2]! == mul pts[(F[k]!).2]! pts[(F[k]!).1]! &&
        R[(F[k]!).1]!)

@[expose] def qsList : List Nat := [2, 3, 5]

@[expose] def rowAt (rs : List Rows) (k : Nat) : Rows := rs.getD k (one ())


