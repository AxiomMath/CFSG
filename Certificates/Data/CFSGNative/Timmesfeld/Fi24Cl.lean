  img : Array Nat
  L : Array (Array Nat)
  H : Std.HashMap UInt64 Nat

@[expose] def stepImg (T : Table) (img : Array Nat) (s : Nat) : Array Nat :=
  #[ap T img[s]!, ap T img[s + 1]!, ap T img[s + 2]!, ap T img[s + 3]!, ap T img[s + 4]!,
    ap T img[s + 5]!]

@[expose] def pEnum (G : Array Table) : QEnum := Id.run do
  let m := G.size
  let mut par : Array (Nat × Nat) := Array.emptyWithCapacity (pN + 1)
  par := par.push (0, 0)
  let mut img : Array Nat := Array.emptyWithCapacity (6 * pN + 6)
  for t in [0:6] do
    img := img.push chainBase[t]!
  let mut L : Array (Array Nat) := Array.replicate m (Array.emptyWithCapacity (pN + 1))
  let mut H : Std.HashMap UInt64 Nat := Std.HashMap.emptyWithCapacity (2 * pN)
  H := H.insert (keyAt img 0) 0
  for i in [0:pN] do
    if i < par.size then
      for j in [0:m] do
        let nb := stepImg G[j]! img (6 * i)
        let k := keyAt nb 0
        match H.get? k with
        | some idx => L := L.modify j (·.push idx)
        | none =>
          let idx := par.size
          H := H.insert k idx
          img := (((((img.push nb[0]!).push nb[1]!).push nb[2]!).push nb[3]!).push nb[4]!).push
            nb[5]!
          par := par.push (i, j)
          L := L.modify j (·.push idx)
  return { par, img, L, H }

@[expose] def pInvIdx (G : Array Table) (E : QEnum) : Array Nat :=
  G.map fun T =>
    (E.H.get? (keyAt (Array.ofFn (n := 6) fun t => ap (invT 306936 T) chainBase[t.val]!) 0)).getD 0

structure QLab where
  lab : Array Nat
  wit : Array Nat
  rep : Array Nat

@[expose] def pRepIdx (H : Std.HashMap UInt64 Nat) : Array Nat :=
  (Array.range (repKeys.size / 6)).map fun l => (H.get? (keyAt repKeys (6 * l))).getD pN

@[expose] def pLabels (P : Array (Nat × Nat)) (L : Array (Array Nat)) (H : Std.HashMap UInt64 Nat)
    (inv : Array Nat) (m : Nat) : QLab := Id.run do
  let N := pN
  let rep := pRepIdx H
  let mut lab : Array Nat := Array.replicate N N
  let mut wit : Array Nat := Array.replicate N 0
  for l in [0:rep.size] do
    let r := rep[l]!
    if r < N && lab[r]! == N then
      lab := lab.set! r l
      wit := wit.set! r 0
      let mut q : Array Nat := #[r]
      let mut h := 0
      for _ in [0:N] do
        if h < q.size then
          let u := q[h]!
          for j in [0:m] do
            let v := (L[j]!)[tabMul P L u inv[j]!]!
            if lab[v]! == N then
              lab := lab.set! v l
              wit := wit.set! v (tabMul P L wit[u]! inv[j]!)
              q := q.push v
          h := h + 1
        else
          break
  return { lab, wit, rep }

@[expose] def pTreeOK (G : Array Table) (P : Array (Nat × Nat)) (img : Array Nat) (N : Nat) :
    Bool :=
  allIn 0 6 (fun t => img[t]! == chainBase[t]!) &&
    parAll N 63 fun i => i == 0 || (decide ((P[i]!).1 < i) && decide ((P[i]!).2 < G.size) &&
      allIn 0 6 fun t => img[6 * i + t]! == ap G[(P[i]!).2]! img[6 * (P[i]!).1 + t]!)

@[expose] def pLeftOK (G : Array Table) (L : Array (Array Nat)) (img : Array Nat) (N : Nat) :
    Bool :=
  allIn 0 G.size fun j => parAll N 63 fun i => decide ((L[j]!)[i]! < N) &&
    allIn 0 6 fun t => img[6 * (L[j]!)[i]! + t]! == ap G[j]! img[6 * i + t]!

@[expose] def pInjOK (H : Std.HashMap UInt64 Nat) (img : Array Nat) (N : Nat) : Bool :=
  parAll N 63 fun i => (H.get? (keyAt img (6 * i))).getD N == i

@[expose] def pClassOK (P : Array (Nat × Nat)) (L : Array (Array Nat)) (N : Nat)
    (lab wit rep : Array Nat) : Bool :=
  parAll N 63 fun i => i == 0 || tabMul P L i (tabMul P L i i) != 0 ||
    (decide (lab[i]! < rep.size) && decide (wit[i]! < N) && decide (rep[lab[i]!]! < N) &&
      tabMul P L wit[i]! i == tabMul P L rep[lab[i]!]! wit[i]!)

@[expose] def pActPt (P : Array (Nat × Nat)) (G : Array Table) (r x : Nat) : Nat :=
  if _h : (P[r]!).1 < r then ap G[(P[r]!).2]! (pActPt P G (P[r]!).1 x) else x
termination_by r
decreasing_by exact _h

@[expose] def pTransOK (letters G : Array Table) (P : Array (Nat × Nat)) (N : Nat)
    (rep : Array Nat) : Bool :=
  decide (repTgt.size = rep.size) && decide (repTrans.size = rep.size) &&
    allIn 0 rep.size fun l => decide (rep[l]! < N) && decide (repTgt[l]! < targetWords.size) &&
      allIn 0 6 fun t =>
        apWord letters repTrans[l]! (pActPt P G rep[l]! (apWord letters (invWord repTrans[l]!)
          chainBase[t]!)) == apWord letters targetWords[repTgt[l]!]! chainBase[t]!

@[expose] def lettersOK (letters : Array Table) : Bool :=
  pWords.all (fun w => w.all fun z => decide (z < letters.size)) &&
    repTrans.all (fun w => w.all fun z => decide (z < letters.size)) &&
    targetWords.all (fun w => w.all fun z => decide (z < letters.size))

@[expose] def pCore (letters G : Array Table) (E : QEnum) (lb : QLab) : Bool :=
  pWords.size == 4 && lettersOK letters && G.size == 4 && E.par.size == pN &&
    pTreeOK G E.par E.img pN && pLeftOK G E.L E.img pN && pInjOK E.H E.img pN &&
    pClassOK E.par E.L pN lb.lab lb.wit lb.rep && pTransOK letters G E.par pN lb.rep

@[expose] def pLabelsOK (letters G : Array Table) (E : QEnum) : Bool :=
  pCore letters G E (pLabels E.par E.L E.H (pInvIdx G E) G.size)

@[expose] def pEnumOK (letters G : Array Table) : Bool := pLabelsOK letters G (pEnum G)

@[expose] def pOK (O : Enum) : Bool :=
  let letters := chainLetters O
  pEnumOK letters (pGens letters)

end Timmesfeld.Fi24Cl
