        decide (O.beta[i]! < n) &&
        decide (O.pts[O.beta[i]!]! = pairCode (B[O.pts[i]! / 100]!) (B[O.pts[i]! % 100]!))) &&
    allIn 1 n (fun i =>
      decide (O.par[i]! < i) &&
        ((decide (O.lab[i]! = 1) && decide (O.alpha[O.par[i]!]! = i)) ||
          (decide (O.lab[i]! = 2) && decide (O.beta[O.par[i]!]! = i)))) &&
    allIn 0 10000 (fun p => decide (O.pos[p]! < n) → decide (O.pts[O.pos[p]!]! = p)) &&
    allIn 0 100 fun x => allIn 0 100 fun y => !cov x y || decide (O.pos[pairCode x y]! < n)

@[expose] def covAdj (x y : Nat) : Bool := adjB x y

@[expose] def covNon (x y : Nat) : Bool := x != y && !adjB x y

end CFSG.Sporadic.Recognition.HSPinned.Native
