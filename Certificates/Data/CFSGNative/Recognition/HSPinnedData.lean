@[expose] def starsClosedOK (alpha beta : Table) : Bool :=
  decide (stars.size = 100) && decide (vtxA.size = 100) && decide (vtxB.size = 100) &&
    allIn 0 100 fun i =>
      decide (vtxA[i]! < 100) && decide (vtxB[i]! < 100) &&
        allIn 0 1100 fun x =>
          decide (x ∈ stars[i]! ↔ ap alpha x ∈ stars[vtxA[i]!]!) &&
            decide (x ∈ stars[i]! ↔ ap beta x ∈ stars[vtxB[i]!]!)

@[expose] def adjRows (_ : Unit := ()) : Array Nat :=
  (Array.range 100).map fun x =>
    (List.range 100).foldl
      (fun m y => if x != y && (stars[x]!).any (fun t => (stars[y]!).contains t) then
        m ||| (1 <<< y) else m) 0

@[inline, expose] def adjB (x y : Nat) : Bool := (adjRows[x]!).testBit y

@[inline, expose] def pairCode (x y : Nat) : Nat := 100 * x + y

structure POrbit where
  pts : Array Nat
  alpha : Array Nat
  beta : Array Nat
  par : Array Nat
  lab : Array Nat
  pos : Array Nat

@[expose] def pairBFS (A B : Array Nat) (root : Nat) : POrbit := Id.run do
  let mut pos : Array Nat := Array.replicate 10000 10000
  let mut pts : Array Nat := #[root]
  let mut alpha : Array Nat := #[]
  let mut beta : Array Nat := #[]
  let mut par : Array Nat := #[0]
  let mut lab : Array Nat := #[0]
  pos := pos.set! root 0
  for h in [0:10000] do
    if h < pts.size then
      let p := pts[h]!
      let q := pairCode (A[p / 100]!) (A[p % 100]!)
      if pos[q]! == 10000 then
        pos := pos.set! q pts.size
        pts := pts.push q
        par := par.push h
        lab := lab.push 1
      alpha := alpha.push pos[q]!
      let r := pairCode (B[p / 100]!) (B[p % 100]!)
      if pos[r]! == 10000 then
        pos := pos.set! r pts.size
        pts := pts.push r
        par := par.push h
        lab := lab.push 2
      beta := beta.push pos[r]!
    else break
  return ⟨pts, alpha, beta, par, lab, pos⟩

