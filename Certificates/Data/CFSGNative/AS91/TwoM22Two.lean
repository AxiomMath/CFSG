@[expose] def mulIdx (k : Fin 512) (g : Fin 10) : Fin 512 :=
  fin512 (mulIdxCode.getD (k.val * 10 + g.val) 0)

@[expose] def genTab (_ : Unit := ()) : Fin 10 → Table
  | 0 => sTab 0
  | 1 => sTab 1
  | 2 => sTab 2
  | 3 => sTab 3
  | 4 => tabT0 ()
  | 5 => sInvTab 0
  | 6 => sInvTab 1
  | 7 => sInvTab 2
  | 8 => sInvTab 3
  | 9 => tabT0 ()

@[expose] def genTab22 (_ : Unit := ()) : Fin 10 → Table
  | 0 => sTab22 0
  | 1 => sTab22 1
  | 2 => sTab22 2
  | 3 => sTab22 3
  | 4 => tabT0_22 ()
  | 5 => sInvTab22 0
  | 6 => sInvTab22 1
  | 7 => sInvTab22 2
  | 8 => sInvTab22 3
  | 9 => tabT0_22 ()

@[expose] def zetaTab (_ : Unit := ()) : Table :=
  wordT 660 (gen2_660 ()) (List.replicate 11 2)

@[expose] def zetaSqTab (_ : Unit := ()) : Table :=
  wordT 660 (gen2_660 ()) (List.replicate 22 2)

@[expose] def tabs512 (_ : Unit := ()) : List Table := List.ofFn tab512

@[expose] def permCheck (n : Nat) (T : Table) : Bool :=
  allIn 0 n (fun i => decide (ap T i < n)) &&
    allIn 0 n (fun i => allIn 0 n (fun j => decide (ap T i = ap T j → i = j)))

@[expose] def signOdd (n : Nat) (T : Table) : Bool := Id.run do
  let mut seen : Array Bool := Array.replicate n false
  let mut odd := false
  for i in [0:n] do
    if !seen[i]! then
      let mut j := i
      let mut len := 0
      while !seen[j]! do
        seen := seen.set! j true
        j := ap T j
        len := len + 1
      if len % 2 == 0 then odd := !odd
  return odd

@[expose] def trCheck (n : Nat) (gens : Int → Table) (len : Nat)
    (ws : List (List Int)) : Bool :=
  allIn 0 len fun p => ap (wordT n gens (ws.getD p [])) 0 == p

@[expose] def hCheck (h : Table) : Bool :=
  allIn 0 660 fun i => (ap h i == i) == (i == 0 || i == 635)

@[expose] def kCheck (ts : List Table) : Bool :=
  allIn 0 22 fun i => (ts.all fun T => ap T i == i) == (i == 0)

@[expose] def mulIdxCheck (_ : Unit := ()) : Bool :=
  let gt := genTab ()
  let gt22 := genTab22 ()
  (List.finRange 512).all fun k =>
    (List.finRange 10).all fun g =>
      (tab512 (mulIdx k g) == compT 660 (tab512 k) (gt g)) &&
      (tab512_22 (mulIdx k g) == compT 22 (tab512_22 k) (gt22 g))


@[expose] def tabS0Check1 (_ : Unit := ()) : Bool := tabS0 1 == sTab 0

@[expose] def tabS0Check2 (_ : Unit := ()) : Bool := tabS0 2 == sTab 1

@[expose] def tabS0Check3 (_ : Unit := ()) : Bool := tabS0 3 == sTab 2

@[expose] def tabS0Check4 (_ : Unit := ()) : Bool := tabS0 4 == sTab 3

@[expose] def tabS0_22Check1 (_ : Unit := ()) : Bool := tabS0_22 1 == sTab22 0

@[expose] def tabS0_22Check2 (_ : Unit := ()) : Bool := tabS0_22 2 == sTab22 1

@[expose] def tabS0_22Check3 (_ : Unit := ()) : Bool := tabS0_22 3 == sTab22 2

@[expose] def tabS0_22Check4 (_ : Unit := ()) : Bool := tabS0_22 4 == sTab22 3


@[expose] def tabT0SqCheck660 (_ : Unit := ()) : Bool := compT 660 (tabT0 ()) (tabT0 ()) == idT 660

@[expose] def tabT0SqCheck22 (_ : Unit := ()) : Bool := compT 22 (tabT0_22 ()) (tabT0_22 ()) == idT 22


@[expose] def powT_b660_zetaCheck (_ : Unit := ()) : Bool := powT 660 11 b660 == zetaTab ()

@[expose] def sqNeCheck (_ : Unit := ()) : Bool :=
  let y := tabT0 ()
  let z := zetaTab ()
  (List.finRange 256).all fun i =>
    let x := tabS0 i
    compT 660 (compT 660 x y) (compT 660 x y) != z

@[expose] def twoM22CheckParts (_ : Unit := ()) : List Bool :=
  [permCheck 660 a660, permCheck 660 b660, permCheck 660 t660,
    permCheck 22 L0, permCheck 22 L1, permCheck 22 t22,
    (L0 == wordTab 22 tabA tabA tabB tabBi (m22GenWord.getD 0 [])),
    (L1 == wordTab 22 tabA tabA tabB tabBi (m22GenWord.getD 1 [])),
    invOK 660 a660 ai660, invOK 660 b660 bi660, invOK 660 t660 ti660,
    invOK 22 L0 L0i, invOK 22 L1 L1i, invOK 22 t22 t22i,
    relCheck 660 a660 ai660 b660 bi660 coverWords,
    relCheck 22 L0 L0i L1 L1i coverWords,
    (ap (zetaTab ()) 0 == 635), (ap (zetaTab ()) 635 == 0), (zetaSqTab () == idT 660),
    (compT 660 t660 t660 == idT 660), (compT 22 t22 t22 == idT 22), tabT0SqCheck660, tabT0SqCheck22, powT_b660_zetaCheck, sqNeCheck,
    (powT 22 11 L1 == idT 22), (powT 660 22 b660 == idT 660),
    (compT 660 (compT 660 t660 a660) ti660 ==
      wordT 660 (gen2_660 ()) WA),
    (compT 660 (compT 660 t660 b660) ti660 ==
      wordT 660 (gen2_660 ()) WB),
    (compT 22 (compT 22 t22 L0) t22i == wordT 22 (gen2_22 ()) WA),
    (compT 22 (compT 22 t22 L1) t22i == wordT 22 (gen2_22 ()) WB),
    signOdd 22 t22,
    trCheck 660 (gen2_660 ()) 660 (TR660 ()), trCheck 22 (gen2_22 ()) 22 TR22,
    hCheck (wordT 660 (gen2_660 ()) H660),
    kCheck (K22.map (wordT 22 (gen2_22 ()))),
    invOK 660 (sTab 0) (sInvTab 0), invOK 660 (sTab 1) (sInvTab 1),
    invOK 660 (sTab 2) (sInvTab 2), invOK 660 (sTab 3) (sInvTab 3),
    invOK 22 (sTab22 0) (sInvTab22 0), invOK 22 (sTab22 1) (sInvTab22 1),
    invOK 22 (sTab22 2) (sInvTab22 2), invOK 22 (sTab22 3) (sInvTab22 3),
    (tabS0 ⟨0, by decide⟩ == idT 660), (tabS0_22 ⟨0, by decide⟩ == idT 22),
    decide ((List.ofFn tabS0).Nodup), decide ((List.ofFn tab512).Nodup),
    mulIdxCheck (),
    tabS0Check1, tabS0Check2, tabS0Check3, tabS0Check4,
    tabS0_22Check1, tabS0_22Check2, tabS0_22Check3, tabS0_22Check4,
    ]

@[expose] def twoM22Check (_ : Unit := ()) : Bool := (twoM22CheckParts ()).all id

