@[expose] def dData (i : Nat) : List (List (List Nat) × List (Nat × List Nat)) :=
  if i = 0 then dData0 else dData1

@[expose] def evalWord (A : List (Array Nat)) (w : List Nat) : Array Nat :=
  w.foldl (fun acc k => Native.mulR acc A[k]!) Native.idR

abbrev DSt : Type := List Nat × Array Nat × Array Nat

@[expose] def stepD (p : Array Nat × Array Nat) (s : DSt) : DSt :=
  (s.1.map (Native.appN p.1), Native.mulR p.1 s.2.1, Native.mulR s.2.2 p.2)

@[expose, noinline] def dTr (_ : Unit := ()) : List DSt :=
  Native.bfsClosure (fun s : DSt => Native.keyD s.1) ((withInv Native.saGens).map stepD) 5000 [(Native.d0, Native.idR, Native.idR)]
    ((∅ : Std.HashSet (List Nat)).insert (Native.keyD Native.d0)) []

@[expose, noinline] def dCoverOK (T : List DSt) : Bool :=
  let K := Std.HashSet.ofList (T.map fun s => Native.keyD s.1)
  (Native.closureD Native.d0).all fun s => K.contains (Native.keyD s)

@[expose, noinline] def repsCoverOK (N : List (Array Nat)) (R : List (Nat × Array Nat)) : Bool :=
  let C := Std.HashSet.ofList (Native.bfsClosure (fun x : Nat => x) (N.map Native.appN) 4096 (R.map Prod.fst)
    (Std.HashSet.ofList (R.map Prod.fst)) [])
  (List.range 4096).all fun n => n == 0 || Native.q0b n || C.contains n

@[expose, noinline] def frameTest (i x : Nat) (w wi : Array Nat) (NW CW : List (Array Nat × Array Nat))
    (Cc : List (Array Nat)) : Bool :=
  (x == Native.a0 &&
      (let C' := Cc.map fun f => Native.mulR w (Native.mulR f wi)
       let L := Native.compOf i
       C'.all L.contains && L.all C'.contains)) ||
    violCheckW (NW ++ CW.map fun p => (Native.mulR w (Native.mulR p.1 wi), Native.mulR w (Native.mulR p.2 wi)))
      (Native.compOf i) (Native.compGens i) (Native.idR :: hyp10 i) true

@[expose, noinline] def pointCheck (T : List DSt) (CS : List (List (Array Nat × Array Nat) × List (Array Nat)))
    (i : Nat) (N : List (Array Nat)) (A : List (Array Nat)) (NW : List (Array Nat × Array Nat))
    (xg : Nat × Array Nat) (BW : List (List Nat) × List (Nat × List Nat)) : Bool :=
  let g := xg.2
  let gi := invR g
  let B := BW.1
  let WK := BW.2.map fun rw =>
    let M := evalWord A rw.2
    (rw.1 < B.length && rw.2.all (· < A.length) && Native.appN M xg.1 == xg.1,
      Native.keyD ((B[rw.1]!).map (Native.appN M)))
  B.all (fun b => b.all (· < 4096)) && Native.gammaUN g && Native.appN g Native.a0 == xg.1 && pairOK (g, gi) &&
    T.all (fun t =>
      let k := Native.keyD (t.1.map (Native.appN g))
      WK.any fun mk => mk.1 && mk.2 == k) &&
    B.all fun b =>
      let kb := Native.keyD b
      (T.find? (fun t => Native.keyD (t.1.map (Native.appN g)) == kb)).any fun t =>
        let w := Native.mulR g t.2.1
        let wi := Native.mulR t.2.2 gi
        CS.all fun cc => frameTest i xg.1 w wi NW cc.1 cc.2

@[expose, noinline] def frameCheckAt (T : List DSt) (CS : List (List (Array Nat × Array Nat) × List (Array Nat)))
    (i : Nat) : Bool :=
  let N := n2Gens i
  let A := N ++ N.map invR
  let NW := withInv N
  N.all Native.gammaUN && (withInv N).all pairOK && repsCoverOK N (pointReps i) &&
    (pointReps i).length == (dData i).length &&
    ((pointReps i).zip (dData i)).all fun p => pointCheck T CS i N A NW p.1 p.2

@[expose] def frameCheck (_ : Unit := ()) : Bool :=
  let T := dTr ()
  let CS := (List.range 32).map fun c => (withInv (Native.compGens c), Native.compOf c)
  Native.saGens.all Native.gammaUN && T.all (fun t => pairOK (t.2.1, t.2.2)) && dCoverOK T &&
    CS.all (fun cc => cc.1.all fun p => cc.2.contains p.1) &&
    frameCheckAt T CS 0 && frameCheckAt T CS 1

end CFSG.GammaU.NativeFrame
