namespace CFSG.GammaU.NativeFrame

@[expose] def invR (r : Array Nat) : Array Nat :=
  ((List.range 12).map fun j =>
    ((List.range 4096).find? fun n => Native.appN r n == 2 ^ j).getD 0).toArray

abbrev St : Type := Nat × Array Nat × Array Nat

@[expose] def stepOf (p : Array Nat × Array Nat) (s : St) : St :=
  (Native.appN p.1 s.1, Native.mulR p.1 s.2.1, Native.mulR s.2.2 p.2)

@[expose] def withInv (gs : List (Array Nat)) : List (Array Nat × Array Nat) :=
  gs.map fun g => (g, invR g)

@[expose, noinline] def orbitTr (W : List (Array Nat × Array Nat)) : List St :=
  Native.bfsClosure (fun s : St => s.1) (W.map stepOf) 4096 [(Native.a0, Native.idR, Native.idR)]
    ((∅ : Std.HashSet Nat).insert Native.a0) []

@[expose] def okRows (r : Array Nat) : Bool := r.size == 12 && r.all (· < 4096)

@[expose, noinline] def d1Check (W : List (Array Nat × Array Nat)) (O : List St) (Lc Lg : List (Array Nat)) :
    Bool :=
  O.any fun s => W.any fun p =>
    let y := Native.appN p.1 s.1
    match O.find? (fun t => t.1 == y) with
    | none => false
    | some t =>
      let h := Native.mulR t.2.2 (Native.mulR p.1 s.2.1)
      let hi := Native.mulR s.2.2 (Native.mulR p.2 t.2.1)
      Native.appN h Native.a0 == Native.a0 && Lg.any fun l => !(Lc.contains (Native.mulR h (Native.mulR l hi)))

@[expose] def ptsOf (O : List St) (Lc : List (Array Nat)) (s : Array Nat) : List Nat :=
  O.filterMap fun t => if Lc.contains (Native.mulR t.2.2 (Native.mulR s t.2.1)) then some (Native.appN t.2.1 Native.a0)
    else none

@[expose] def f4Indep (x y : Nat) : Bool :=
  x != 0 && y != 0 && y != x && y != Native.theta0N x && y != (x ^^^ Native.theta0N x)

@[expose] def f2Indep3 (x y w : Nat) : Bool :=
  x != 0 && y != 0 && y != x && w != 0 && w != x && w != y && w != (x ^^^ y)

@[expose, noinline] def d2uCheck (O : List St) (Lc H : List (Array Nat)) : Bool :=
  Lc.any fun s => Native.unitaryN s && !(H.contains s) &&
    let P := ptsOf O Lc s
    P.any fun x => P.any fun y => f4Indep x y

@[expose, noinline] def d2aCheck (O : List St) (Lc : List (Array Nat)) : Bool :=
  Lc.any fun s => Native.antiN s &&
    let P := ptsOf O Lc s
    P.any fun x => P.any fun y => P.any fun w => f2Indep3 x y w

@[expose] def pairOK (p : Array Nat × Array Nat) : Bool :=
  okRows p.1 && okRows p.2 && Native.mulR p.1 p.2 == Native.idR && Native.mulR p.2 p.1 == Native.idR

@[expose, noinline] def violCheckW (W : List (Array Nat × Array Nat)) (Lc Lg H : List (Array Nat))
    (d1First : Bool) : Bool :=
  W.all pairOK && Lc.all okRows && Lg.all Lc.contains &&
    let O := orbitTr W
    if d1First then d1Check W O Lc Lg || d2uCheck O Lc H || d2aCheck O Lc
    else d2uCheck O Lc H || d2aCheck O Lc || d1Check W O Lc Lg

@[expose] def violCheck (gs Lc Lg H : List (Array Nat)) : Bool :=
  violCheckW (withInv gs) Lc Lg H false

