@[inline, expose] def mul (m : Array Nat) (a b : Nat) : Nat := m[1024 * a + b]!

@[expose] def treeOK (par lab nxt : Array Nat) : Bool :=
  par.size == 1024 && lab.size == 1024 && nxt.size == 4096 &&
    (Nat.all 1023 fun b _ => par[b + 1]! < b + 1 && lab[b + 1]! < 4) &&
    Nat.all 4096 fun j _ => nxt[j]! < 1024

@[expose] def mulTab (par lab nxt : Array Nat) : Array Nat := Id.run do
  let mut m : Array Nat := Array.replicate 1048576 0
  for a in [0:1024] do
    m := m.set! (1024 * a) a
    for b in [1:1024] do
      m := m.set! (1024 * a + b) nxt[4 * m[1024 * a + par[b]!]! + lab[b]!]!
  return m

@[expose] def mulOK (par lab nxt m : Array Nat) : Bool :=
  m.size == 1048576 && Nat.all 1024 fun a _ => mul m a 0 == a &&
    Nat.all 1023 fun b _ => mul m a (b + 1) == nxt[4 * mul m a par[b + 1]! + lab[b + 1]!]!

@[inline, expose] def isInv (m : Array Nat) (t : Nat) : Bool := t != 0 && mul m t t == 0

@[expose] def invList (m : Array Nat) : List Nat := (List.range 1024).filter (isInv m)

@[expose] def eligible (m : Array Nat) (X : List Nat) (t : Nat) : Bool :=
  !X.contains t && X.all fun x => mul m x t == mul m t x

@[expose] def extend (m : Array Nat) (X : List Nat) (t : Nat) : List Nat :=
  (X ++ X.map (mul m t)).mergeSort

@[expose] def subsBFS (m : Array Nat) (cap : Nat) : Array (List Nat) := Id.run do
  let invs := invList m
  let mut seen : Std.HashSet (List Nat) := (∅ : Std.HashSet (List Nat)).insert [0]
  let mut out : Array (List Nat) := #[[0]]
  for h in [0:cap] do
    if h < out.size then
      let X := out[h]!
      for t in invs do
        if eligible m X t then
          let Z := extend m X t
          if !seen.contains Z then
            seen := seen.insert Z
            out := out.push Z
    else break
  return out

@[expose] def subsIndex (subs : Array (List Nat)) : Std.HashMap (List Nat) Nat := Id.run do
  let mut mp : Std.HashMap (List Nat) Nat := ∅
  for i in [0:subs.size] do
    mp := mp.insert subs[i]! i
  return mp

@[expose] def listed (subs : Array (List Nat)) (mp : Std.HashMap (List Nat) Nat) (Z : List Nat) :
    Bool :=
  match mp.get? Z with
  | some j => j < subs.size && subs[j]! == Z
  | none => false

@[expose] def subsOK (subs : Array (List Nat)) : Bool :=
  subs[0]! == [0] &&
    subs.all fun X => X.head? == some 0 && strictlyIncreasing X && X.all (· < 1024)

@[expose] def extOK (m : Array Nat) (subs : Array (List Nat)) : Bool :=
  let invs := invList m
  let mp := subsIndex subs
  subs.all fun X => invs.all fun t => !eligible m X t || listed subs mp (extend m X t)

structure Cert where
  inner : Bool
  elts : List Nat
  gWords : List (List Nat)
  w0 : List Nat
  w1 : List Nat
deriving Inhabited

@[expose] def gTokOK (inn : Array Bool) (c : Cert) (v : Nat) : Bool :=
  v == 1024 || (v < 1024 && (!c.inner || inn[v]!))

@[expose] def yTokOK (inn : Array Bool) (c : Cert) (v : Nat) : Bool :=
  if v < 1024 then !c.inner || inn[v]! else
    2048 ≤ v && (v - 2048) / 1024 < c.gWords.length && c.elts.contains ((v - 2048) % 1024)

@[expose] def certIdxOK (inn : Array Bool) (c : Cert) : Bool :=
  strictlyIncreasing c.elts && c.elts.all (· < 1024) && c.gWords.all (·.all (gTokOK inn c)) &&
    c.w0.all (yTokOK inn c) && c.w1.all (yTokOK inn c)

@[expose] def conjOK (m : Array Nat) (X Y : List Nat) (s : Nat) : Bool :=
  (X.map (mul m s)).mergeSort == (Y.map fun y => mul m y s).mergeSort

@[expose] def classOK (m : Array Nat) (inn : Array Bool) (certs : Array Cert) (X : List Nat)
    (d : Nat × Nat) : Bool :=
  d.1 < 1024 && d.2 < certs.size && conjOK m X certs[d.2]!.elts d.1 &&
    (if certs[d.2]!.inner then inn[d.1]! else X.any fun x => !inn[x]!)

@[expose] def clsOK (m : Array Nat) (inn : Array Bool) (certs : Array Cert)
    (subs : Array (List Nat)) (cls : List (Nat × Nat)) : Bool :=
  let big := subs.toList.filter fun X => 8 ≤ X.length
  big.length == cls.length && (big.zip cls).all fun p => classOK m inn certs p.1 p.2

@[expose] def natsOf (s : String) : List Nat := (s.splitOn " ").filterMap String.toNat?

@[expose] def pairsOf : List Nat → List (Nat × Nat)
  | a :: b :: l => (a, b) :: pairsOf l
  | _ => []

@[expose] def takeList : List Nat → List Nat × List Nat
  | k :: l => (l.take k, l.drop k)
  | [] => ([], [])

@[expose] def takeLists : Nat → List Nat → List (List Nat) × List Nat
  | 0, l => ([], l)
  | k + 1, l =>
    let p := takeList l
    let q := takeLists k p.2
    (p.1 :: q.1, q.2)

@[expose] def takeCert : List Nat → Cert × List Nat
  | i :: r =>
    let e := takeList r
    match e.2 with
    | k :: r' =>
      let ws := takeLists (k + 2) r'
      ({ inner := i == 1, elts := e.1, gWords := ws.1.take k, w0 := ws.1.getD k [],
         w1 := ws.1.getD (k + 1) [] }, ws.2)
    | [] => (default, [])
  | [] => (default, [])

@[expose] def takeCerts : Nat → List Nat → List Cert
  | 0, _ => []
  | k + 1, l =>
    let p := takeCert l
    p.1 :: takeCerts k p.2

