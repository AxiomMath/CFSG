@[expose] def clsData (_ : Unit := ()) : List (Nat × Nat) := pairsOf (natsOf clsStr)

@[expose] def certData (_ : Unit := ()) : Array Cert :=
  match natsOf certStr with
  | k :: l => (takeCerts k l).toArray
  | [] => #[]

@[expose] def indexCheck (par lab nxt : Array Nat) (inn : Array Bool) : Bool :=
  let m := mulTab par lab nxt
  let subs := subsBFS m 4000
  let certs := certData ()
  treeOK par lab nxt && inn.size == 1024 && mulOK par lab nxt m && subsOK subs &&
    extOK m subs && certs.all (certIdxOK inn) && clsOK m inn certs subs (clsData ())

