module

public import Certificates.Data.CFSGNative.D42Over.Basic

public section

namespace CFSG.D42Over.Native

set_option compiler.extract_closed false

@[expose] def parseWords (s : String) : List (List Int) :=
  (s.splitOn ";").map fun t => if t.isEmpty then [] else (t.splitOn ",").map String.toInt!

@[expose] def parseNatWords (s : String) : List (List Nat) := (parseWords s).map (·.map Int.toNat)

@[expose] def parseGens (s : String) : List (List Int × List Int) :=
  (s.splitOn ";").map fun t => match t.splitOn "|" with
    | [a, b] => ((parseWords a).headD [], (parseWords b).headD [])
    | _ => ([], [])

structure ClassData where
  kW : List Nat
  s0 : List (List Nat)
  roots : List (List Nat)
  gens : List (List Int × List Int)
  n : Nat

@[expose] def gxW : List Nat := [14, 16, 17]

@[expose] def gyW : List Nat := [15, 12, 15, 5]

@[expose] def tT (_ : Unit := ()) : Array NMat := #[nWord gxW, nWord gyW]

@[expose] def tT' (_ : Unit := ()) : Array NMat := #[nWord gxW.reverse, nWord gyW.reverse]

@[expose] def xyPairs (_ : Unit := ()) : Array (NMat × NMat) :=
  #[(nWord gxW, nWord gxW.reverse), (nWord gyW, nWord gyW.reverse)]

@[expose] def ClassData.k (c : ClassData) : NMat := nWord c.kW

@[expose] def ClassData.S (c : ClassData) : Array NMat := (c.s0.map nWord).toArray

@[expose] def ClassData.S' (c : ClassData) : Array NMat :=
  (c.s0.map fun w => nWord w.reverse).toArray

@[expose] def ClassData.R (c : ClassData) : Array NMat :=
  (c.roots.map fun d => nConj (nWord d) c.k (nWord d.reverse)).toArray

@[expose] def ClassData.genPairs (c : ClassData) (j : Nat) : Array (NMat × NMat) :=
  ((c.s0 ++ [c.roots.getD j []]).map fun w => (nWord w, nWord w.reverse)).toArray

@[expose] def ClassData.genOK (c : ClassData) : Bool :=
  c.gens.length + 2 == c.roots.length &&
  (List.range c.roots.length).all fun j => j < 2 ||
    (evalSyms (c.genPairs j) (c.gens.getD (j - 2) ([], [])).1 == nWord gxW &&
      evalSyms (c.genPairs j) (c.gens.getD (j - 2) ([], [])).2 == nWord gyW)

@[expose] def ClassData.check (c : ClassData) : Bool :=
  let F := bfs c.R c.S c.S' (c.n + 1)
  (c.R.getD 0 nOne == c.k) && (c.R.getD 1 nOne == nMul c.k c.k) &&
  (c.S.toList.all fun s => nMul s c.k == nMul c.k s) &&
  forestOK c.R c.S c.S' (tT ()) (tT' ()) F.1 F.2 c.n && c.genOK

