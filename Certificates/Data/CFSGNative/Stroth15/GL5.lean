module

public import Std.Data.HashMap

public section

namespace CFSG.CGT.Stroth77.GL5

set_option compiler.extract_closed false

@[expose] def N : Nat := 33554432

@[expose] def r0 (c : Nat) : Nat := c % 32
@[expose] def r1 (c : Nat) : Nat := c / 32 % 32
@[expose] def r2 (c : Nat) : Nat := c / 1024 % 32
@[expose] def r3 (c : Nat) : Nat := c / 32768 % 32
@[expose] def r4 (c : Nat) : Nat := c / 1048576 % 32

@[expose] def ofRows (a b c d e : Nat) : Nat := a + 32 * b + 1024 * c + 32768 * d + 1048576 * e

@[expose] def vm5 (v m0 m1 m2 m3 m4 : Nat) : Nat :=
  (if v.testBit 0 then m0 else 0) ^^^ (if v.testBit 1 then m1 else 0) ^^^
    (if v.testBit 2 then m2 else 0) ^^^ (if v.testBit 3 then m3 else 0) ^^^
    (if v.testBit 4 then m4 else 0)

@[expose] def vm (v c : Nat) : Nat := vm5 v (r0 c) (r1 c) (r2 c) (r3 c) (r4 c)

@[expose] def mulC (a b : Nat) : Nat :=
  let a0 := r0 a
  let a1 := r1 a
  let a2 := r2 a
  let a3 := r3 a
  let a4 := r4 a
  ofRows (vm5 (r0 b) a0 a1 a2 a3 a4) (vm5 (r1 b) a0 a1 a2 a3 a4) (vm5 (r2 b) a0 a1 a2 a3 a4)
    (vm5 (r3 b) a0 a1 a2 a3 a4) (vm5 (r4 b) a0 a1 a2 a3 a4)

@[expose] def idC : Nat := 17043521
@[expose] def uvC : Nat := 20224065
@[expose] def tC : Nat := 18191425
@[expose] def uC : Nat := 16916514
@[expose] def rhoC : Nat := 17178722

@[expose] def genC (i : Nat) : Nat :=
  if i = 0 then uvC else if i = 1 then tC else if i = 2 then uC else if i = 3 then rhoC else idC

@[expose] def powC (h : Nat) : Nat → Nat
  | 0 => idC
  | k + 1 => mulC h (powC h k)

@[expose] def evalList : List Nat → Nat
  | [] => idC
  | i :: l => mulC (genC i) (evalList l)

@[expose] def x0Words : Array (List Nat) :=
  #[[], [0], [1], [2], [3], [0, 1], [0, 2], [0, 3], [1, 2], [1, 3], [2, 1], [2, 3], [3, 1], [3, 2],
    [3, 3], [0, 2, 3], [0, 3, 2], [0, 3, 3], [1, 2, 3], [1, 3, 2], [1, 3, 3], [2, 1, 3], [3, 1, 2],
    [3, 1, 3]]

@[expose] def x0Codes (_ : Unit := ()) : Array Nat := x0Words.map evalList

@[expose] def x0 (X : Array Nat) (i : Nat) : Nat := X.getD i idC

@[expose] def vCodes : List Nat := [idC, uvC, tC, 19209281]

@[expose] def dCodes : List Nat :=
  [16916514, 17043521, 18000930, 18191425, 19114018, 19209281, 20128802, 20224065]

@[expose] def span5 (a b c d e : Nat) : Bool :=
  let ab_ := a ^^^ b
  let ac_ := a ^^^ c
  let bc_ := b ^^^ c
  let ad_ := a ^^^ d
  let bd_ := b ^^^ d
  let cd_ := c ^^^ d
  let ae_ := a ^^^ e
  let be_ := b ^^^ e
  let ce_ := c ^^^ e
  let de_ := d ^^^ e
  let abc_ := ab_ ^^^ c
  let abd_ := ab_ ^^^ d
  let acd_ := ac_ ^^^ d
  let bcd_ := bc_ ^^^ d
  let abe_ := ab_ ^^^ e
  let ace_ := ac_ ^^^ e
  let bce_ := bc_ ^^^ e
  let ade_ := ad_ ^^^ e
  let bde_ := bd_ ^^^ e
  let cde_ := cd_ ^^^ e
  let abcd_ := abc_ ^^^ d
  let abce_ := abc_ ^^^ e
  let abde_ := abd_ ^^^ e
  let acde_ := acd_ ^^^ e
  let bcde_ := bcd_ ^^^ e
  let abcde_ := abcd_ ^^^ e
  a != 0 && b != 0 && ab_ != 0 && c != 0 && ac_ != 0 && bc_ != 0 && abc_ != 0 && d != 0 &&
    ad_ != 0 && bd_ != 0 && abd_ != 0 && cd_ != 0 && acd_ != 0 && bcd_ != 0 && abcd_ != 0 &&
    e != 0 && ae_ != 0 && be_ != 0 && abe_ != 0 && ce_ != 0 && ace_ != 0 && bce_ != 0 &&
    abce_ != 0 && de_ != 0 && ade_ != 0 && bde_ != 0 && abde_ != 0 && cde_ != 0 && acde_ != 0 &&
    bcde_ != 0 && abcde_ != 0

@[expose] def nonsing (c : Nat) : Bool := span5 (r0 c) (r1 c) (r2 c) (r3 c) (r4 c)

@[expose] def stabW4 (c : Nat) : Bool :=
  decide (r0 c < 16) && decide (r1 c < 16) && decide (r2 c < 16) && decide (r3 c < 16)

@[expose] def good (h : Nat) : Bool :=
  mulC h uvC == mulC uvC h && mulC h tC == mulC tC h && !vCodes.contains h

@[expose] def normD (c : Nat) : Bool :=
  [uvC, tC, uC].all fun d => dCodes.any fun d' => mulC c d == mulC d' c

@[expose] def normV (c : Nat) : Bool :=
  [uvC, tC].all fun d => vCodes.any fun d' => mulC c d == mulC d' c

@[expose] def checkG12 (c : Nat) : Bool :=
  !(mulC c uvC == mulC uvC c) ||
    ((!(mulC c tC == mulC tC c) || powC c 64 == idC) && (!normD c || normV c))

structure Cert where
  kind : Nat
  x : Nat
  k : Nat
  z : Nat
  a : Nat
  b : Nat
  d : Nat
deriving Inhabited

@[expose] def ok0 (X : Array Nat) (r : Nat) (c : Cert) : Bool :=
  good (mulC (x0 X c.z) (powC (mulC (x0 X c.x) r) c.k))

@[expose] def okRep (X : Array Nat) (reps : Array Nat) (certs : Array Cert) (i : Nat) : Bool :=
  let c := certs.getD i default
  let r := reps.getD i 0
  if c.kind = 0 then ok0 X r c
  else if c.kind = 1 then
    decide (c.d < reps.size) && (certs.getD c.d default).kind == 0 &&
      mulC (mulC (x0 X c.a) (powC (mulC (x0 X c.x) r) c.k)) (x0 X c.b) == reps.getD c.d 0 &&
      ok0 X (reps.getD c.d 0) (certs.getD c.d default)
  else false

@[expose] def x0Tabs (X : Array Nat) : Array (Array Nat) :=
  X.map fun x => (Array.range 32).map fun v => vm v x

@[expose] def minTab (T : Array (Array Nat)) : Array (Nat × Array Nat) :=
  (Array.range 32).map fun v =>
    let m := T.foldl (fun acc t => min acc t[v]!) 32
    (m, (Array.range T.size).filter fun i => T[i]![v]! == m)

@[expose] def keyArg (T : Array (Array Nat)) (M : Array (Nat × Array Nat)) (g : Nat) :
    Nat × Nat := Id.run do
  let g0 := r0 g
  let g1 := r1 g
  let g2 := r2 g
  let g3 := r3 g
  let mm := M[r4 g]!
  let m4 := mm.1
  let mut best := N
  let mut arg := 0
  for i in mm.2 do
    let t := T[i]!
    let k := ofRows t[g0]! t[g1]! t[g2]! t[g3]! m4
    if k < best then
      best := k
      arg := i
  return (best, arg)

structure Scan where
  reps : Array Nat
  tbl : Std.HashMap Nat (Nat × Nat × Nat)

@[expose] def scanStep (X : Array Nat) (T : Array (Array Nat)) (M : Array (Nat × Array Nat))
    (st : Scan) (c : Nat) : Scan :=
  if nonsing c then
    match st with
    | ⟨reps, tbl⟩ =>
      let k := (keyArg T M c).1
      if tbl.contains k then ⟨reps, tbl⟩
      else
        let i := reps.size
        let tbl := Id.run do
          let mut tb := tbl
          for j in [0:X.size] do
            let m := mulC c X[j]!
            let km := keyArg T M m
            if !tb.contains km.1 then
              tb := tb.insert km.1 (i, km.2, j)
          return tb
        ⟨reps.push c, tbl⟩
  else st

@[expose] def scanAll (X : Array Nat) (T : Array (Array Nat)) (M : Array (Nat × Array Nat)) :
    Scan :=
  Nat.fold N (fun c _ st => scanStep X T M st c) ⟨#[], {}⟩

