@[expose, noinline] def parseReps (s : String) : Array Nat :=
  let cs := s.toList.toArray
  (Array.range (cs.size / 5)).map fun i =>
    digit32 cs[5 * i]! + 32 * digit32 cs[5 * i + 1]! + 1024 * digit32 cs[5 * i + 2]! +
      32768 * digit32 cs[5 * i + 3]! + 1048576 * digit32 cs[5 * i + 4]!

@[expose] def storedReps (_ : Unit := ()) : Array Nat := parseReps repsData

@[expose] def scanReps (X : Array Nat) (T : Array (Array Nat)) (M : Array (Nat × Array Nat))
    (reps : Array Nat) : Scan :=
  reps.foldl (fun st c =>
    match st with
    | ⟨rs, tbl⟩ =>
      let i := rs.size
      let tbl := Id.run do
        let mut tb := tbl
        for j in [0:X.size] do
          let km := keyArg T M (mulC c X[j]!)
          if !tb.contains km.1 then
            tb := tb.insert km.1 (i, km.2, j)
        return tb
      ⟨rs.push c, tbl⟩) ⟨#[], {}⟩

@[expose] def idxOf (X : Array Nat) (c : Nat) : Nat := (X.idxOf? c).getD 0

@[expose] def find0 (X : Array Nat) (r : Nat) : Option Cert := Id.run do
  for x in [0:X.size] do
    let h := mulC X[x]! r
    let mut p := h
    for k in [1:65] do
      if p == idC then break
      if r0 p < 4 && r1 p < 4 && normV p && !X.contains p then
        for z in [0:X.size] do
          if good (mulC X[z]! p) then
            return some ⟨0, x, k, z, 0, 0, 0⟩
      p := mulC h p
  return none

@[expose] def invIdx (X : Array Nat) : Array Nat :=
  X.map fun x => (X.findIdx? fun y => mulC y x == idC).getD 0

@[expose] def prodIdx (X : Array Nat) : Array (Array Nat) :=
  X.map fun x => X.map fun y => idxOf X (mulC x y)

@[expose] def find1 (X : Array Nat) (T : Array (Array Nat)) (M : Array (Nat × Array Nat))
    (I : Array Nat) (P : Array (Array Nat)) (sc : Scan) (c0 : Array (Option Cert)) (r : Nat) :
    Option Cert := Id.run do
  for x in [0:X.size] do
    let h := mulC X[x]! r
    let mut p := h
    for k in [1:65] do
      if p == idC then break
      let kp := keyArg T M p
      match sc.tbl[kp.1]? with
      | some (d, xm, j) =>
        if (c0.getD d none).isSome then
          return some ⟨1, x, k, 0, (P.getD (I.getD xm 0) #[]).getD kp.2 0, I.getD j 0, d⟩
      | none => pure ()
      p := mulC h p
  return none

structure Data where
  X : Array Nat
  T : Array (Array Nat)
  M : Array (Nat × Array Nat)
  sc : Scan
  certs : Array Cert
  I : Array Nat
  P : Array (Array Nat)

@[expose, noinline] def certsOf (X : Array Nat) (T : Array (Array Nat))
    (M : Array (Nat × Array Nat)) (I : Array Nat) (P : Array (Array Nat)) (sc : Scan) :
    Array Cert :=
  let c0 := sc.reps.map (find0 X)
  sc.reps.mapIdx fun i r =>
    match c0.getD i none with
    | some c => c
    | none => (find1 X T M I P sc c0 r).getD ⟨2, 0, 0, 0, 0, 0, 0⟩

@[expose, noinline] def buildDataWith (X R : Array Nat) : Data :=
  let T := x0Tabs X
  let M := minTab T
  let I := invIdx X
  let P := prodIdx X
  let sc := scanReps X T M R
  ⟨X, T, M, sc, certsOf X T M I P sc, I, P⟩

@[expose] def buildData (_ : Unit := ()) : Data := buildDataWith (x0Codes ()) (storedReps ())

@[expose] def checkG3 (D : Data) (ok : Array Bool) (c : Nat) : Bool :=
  stabW4 c ||
    (let kg := keyArg D.T D.M c
    match D.sc.tbl[kg.1]? with
    | some (i, xm, j) =>
      let a := (D.P.getD (D.I.getD xm 0) #[]).getD kg.2 0
      let b := D.I.getD j 0
      decide (i < D.sc.reps.size) && ok.getD i false &&
        mulC (mulC (x0 D.X a) c) (x0 D.X b) == D.sc.reps.getD i 0
    | none => false)

@[expose, noinline] def glCheckWith (D : Data) : Bool :=
  let ok := (Array.range D.sc.reps.size).map (okRep D.X D.sc.reps D.certs)
  D.X == x0Codes () && Nat.allLTTR N fun c _ => !nonsing c || (checkG12 c && checkG3 D ok c)

@[expose] def glCheck (_ : Unit := ()) : Bool := glCheckWith (buildData ())

end CFSG.CGT.Stroth77.GL5
