@[expose] def fIdx (_ : Unit := ()) : Nat := 17

@[expose] def letterOf (c : Char) : Int := if c = '1' then 1 else if c = '2' then 2 else -2

@[expose] def parseWord (s : String) : List Int := s.toList.map letterOf

@[expose] def parseWords (s : String) : Array (List Int) :=
  ((s.splitOn ",").map parseWord).toArray

@[expose] def invLetter (z : Int) : Int :=
  if z = 1 then -1 else if z = -1 then 1 else if z = 2 then -2 else 2

@[expose] def invWord (w : List Int) : List Int := w.reverse.map invLetter

@[expose] def tabEq (n : Nat) (P Q : Table) : Bool := allIn 0 n fun i => ap P i == ap Q i

@[expose] def conjT (n : Nat) (gens : Int → Table) (bT : Table) (w : List Int) : Table :=
  compT n (wordT n gens w) (compT n bT (wordT n gens (invWord w)))

@[noinline, expose] def share {α : Type} (a : α) : α := a

@[noinline, expose] def pairCheck (n : Nat) (X X2 : Array Table) : Bool :=
  allIn 0 2926 (fun p => allIn (p + 1) 2926 fun q =>
    !tabEq n X[p]! X[q]! && !tabEq n X[p]! X2[q]!)

@[noinline, expose] def normCheck (n : Nat) (bT b2T : Table) (V Vi : Array Table) : Bool :=
  allIn 0 60 (fun i =>
    tabEq n (compT n V[i]! (compT n bT Vi[i]!)) bT ||
      tabEq n (compT n V[i]! (compT n bT Vi[i]!)) b2T) &&
    allIn 0 60 (fun i => allIn (i + 1) 60 fun j => !tabEq n V[i]! V[j]!)

@[noinline, expose] def fCheck (n : Nat) (f fi : Table) (X X2 : Array Table) : Bool :=
  tabEq n (powT n 5 f) (idT n) && !tabEq n f (idT n) &&
    allIn 1 2926 (fun p =>
      !tabEq n (compT n f (compT n X[p]! fi)) X[p]! &&
        !tabEq n (compT n f (compT n X[p]! fi)) X2[p]!)

@[noinline, expose] def bCheck (n : Nat) (bT b2T : Table) (X X2 : Array Table) : Bool :=
  allIn 1 2926 (fun p =>
    !tabEq n (compT n bT (compT n X[p]! b2T)) X[p]! &&
      !tabEq n (compT n bT (compT n X[p]! b2T)) X2[p]!)

@[expose] def sylowCheck (O : Orb) : Bool :=
  let n := O.pts.size
  let gens := genTables O
  let bT := share (gens 2)
  let b2T := share (compT n bT bT)
  let tw := share (parseWords (tWordsStr ()))
  let nw := share (parseWords (nWordsStr ()))
  let X := share (tw.map (conjT n gens bT))
  let X2 := share (X.map fun t => compT n t t)
  let V := share (nw.map (wordT n gens))
  let Vi := share (nw.map fun w => wordT n gens (invWord w))
  let f := share V[fIdx ()]!
  let fi := share Vi[fIdx ()]!
  n == 1540 && tw.size == 2926 && nw.size == 60 && fIdx () < 60 && tw[0]! == [] &&
    pairCheck n X X2 && normCheck n bT b2T V Vi && fCheck n f fi X X2 && bCheck n bT b2T X X2

@[expose] def j1SylowCertificate (_ : Unit := ()) : Bool := sylowCheck (orbitData ())

