@[expose] def alignPermsOK (_ : Unit) : Bool :=
  alignKeys.size == 12 && alignPerms.size == 12 && alignEtaSrc.size == 12 &&
  alignEtaDual.size == 12 &&
  (List.range 12).all fun k => permOK alignPerms[k]! && dOf alignEtaSrc[k]! == alignEtaDual[k]!

@[expose] def alignLiftOK (_ : Unit) : Bool :=
  alignLiftImgs.size == 12 &&
  (List.range 12).all fun k =>
    alignLiftImgs[k]!.size == 12 &&
    (List.range 12).all fun i =>
      alignLiftImgs[k]![i]! < 4096 && jOf alignLiftImgs[k]![i]! == permCN alignPerms[k]! jEnc[i]!

@[expose] def alignBetaSrcTab (k : Nat) : Array Bool :=
  Array.ofFn (n := 144) fun ij =>
    thetaBit jEnc[ij.val / 12]! jEnc[ij.val % 12]! ^^
      thetaBit (jOf alignLiftImgs[k]![ij.val / 12]!) (jOf alignLiftImgs[k]![ij.val % 12]!)

@[expose] def alignHSrc (k : Nat) (bt : Array Bool) (q : Nat) : Bool :=
  xorSum (fun i => (q.testBit i && alignLiftImgs[k]![i]! / 4096 % 2 == 1) ^^
    xorSum (fun j => decide (j < i) && q.testBit i && q.testBit j && bt[12 * i + j]!) 12) 12

@[expose] def alignPhaseOK (_ : Unit) : Bool :=
  (List.range 12).all fun k =>
    let p := alignPerms[k]!
    let bt := betaTabP p
    let bs := alignBetaSrcTab k
    (List.range 12).all (fun i => kappaTab bt jEnc[i]! == kappaN p jEnc[i]!) &&
    (List.range 16).all (fun q => kappaTab bt (jOf q) == kappaN p (jOf q)) &&
    (List.range 4096).all fun q =>
      alignHSrc k bs q == (kappaTab bt (jOf q) ^^ pairN (jOf q) alignEtaDual[k]!)

@[expose] def alignRowOK (r : Array Nat) : Bool :=
  r.size == 6 &&
  (match r[0]! with
    | 0 | 1 => r[1]! < 8192 && r[2]! == jOf r[1]! && r[3]! == r[1]! / 4096 % 2 &&
        r[4]! == thetaN r[2]! && r[5]! == 0
    | 2 => r[1]! < 4096 && r[2]! == 0 && r[3]! == 0 && r[4]! == dOf r[1]! && r[5]! == 0
    | 3 => r[5]! < 12 && alignKeys[r[5]!]! == r[1]! && r[2]! == 0 && r[3]! == 0 &&
        r[4]! == alignEtaDual[r[5]!]!
    | 4 | 5 => (r[1]! == 1 || r[1]! == 2) && r[2]! == 0 && r[3]! == 0 && r[4]! == 0 && r[5]! == 0
    | _ => false)

@[expose] def alignDecodedOK (_ : Unit) : Bool :=
  alignAtoms.size == alignDecoded.size &&
  (List.range alignAtoms.size).all fun t =>
    alignRowOK alignDecoded[t]! && alignDecoded[t]![0]! == alignAtoms[t]!.1 &&
      alignDecoded[t]![1]! == alignAtoms[t]!.2

@[expose] def alignAllOK (_ : Unit) : Bool :=
  alignPermsOK () && alignLiftOK () && alignPhaseOK () && alignDecodedOK ()

