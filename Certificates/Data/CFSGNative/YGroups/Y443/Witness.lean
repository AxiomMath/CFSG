@[expose] def aV (_ : Unit) : DVec :=
  ⟨0, Array.ofFn (n := 196884) fun k => if k.val < 300 then aTab[k.val]! else 0⟩

@[expose] def bV (_ : Unit) : DVec :=
  ⟨0, Array.ofFn (n := 196884) fun k => if 300 ≤ k.val ∧ k.val < 98580 then 1 else 0⟩

@[expose] def wV (_ : Unit) : DVec :=
  ⟨0, Array.ofFn (n := 196884) fun k => if k.val = 98580 then 1 else 0⟩

@[expose] def shortVecN (p : Nat) : Array Int :=
  if p < 552 then
    let t := pairTab[p / 2]!
    let s : Int := if p % 2 = 0 then -4 else 4
    Array.ofFn (n := 24) fun k => (if k.val = t.1 then 4 else 0) + (if k.val = t.2 then s else 0)
  else if p < 49704 then
    let w := wordN (2 * ((p - 552) / 24))
    let i := (p - 552) % 24
    Array.ofFn (n := 24) fun k =>
      (if w.testBit k.val then -1 else 1) * (if k.val = i then -3 else 1)
  else
    let w := wordN octTab[(p - 49704) / 64]!
    let d := spreadG w evenTab[(p - 49704) % 64]!
    Array.ofFn (n := 24) fun k =>
      (if w.testBit k.val then 2 else 0) - (if d.testBit k.val then 4 else 0)

@[expose] def qfN (A u : Array Int) : Int :=
  ((List.range 24).map fun i =>
    ((List.range 24).map fun j => A[24 * i + j]! * (u[i]! * u[j]!)).sum).sum

@[expose] def shortValsN (A : Array Int) : Array Int :=
  (Array.range 98280).map fun p => qfN A (shortVecN p)

@[expose] def sortPerm (vals : Array Int) : Array Nat :=
  (Array.range vals.size).qsort fun a b => vals[a]! < vals[b]!

@[expose] def invTable (perm : Array Nat) : Array Nat :=
  (List.range perm.size).foldl (fun (acc : Array Nat) i => acc.set! perm[i]! i)
    (Array.replicate perm.size 0)

@[expose] def distinctCheck (vals : Array Int) : Bool :=
  let n := vals.size
  let perm := sortPerm vals
  let inv := invTable perm
  (List.range n).all (fun p => inv[p]! < n && perm[inv[p]!]! == p) &&
  (List.range (n - 1)).all fun i => decide (vals[perm[i]!]! < vals[perm[i + 1]!]!)

@[expose] def shortValsOK (_ : Unit) : Bool :=
  distinctCheck (shortValsN (aFull (aV ()).D))

