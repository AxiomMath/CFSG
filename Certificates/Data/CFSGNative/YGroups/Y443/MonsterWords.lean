    | 0 | 1 => r[1]! < 8192 && r[2]! == jOf r[1]! && r[3]! == r[1]! / 4096 % 2 &&
        r[4]! == thetaN r[2]! && r[5]! == 0
    | 2 => r[1]! < 4096 && r[2]! == 0 && r[3]! == 0 && r[4]! == dOf r[1]! && r[5]! == 0
    | 3 => r[5]! < 15 && keys[r[5]!]! == r[1]! && r[2]! == 0 && r[3]! == 0 &&
        r[4]! == etaDual[r[5]!]!
    | 4 | 5 => (r[1]! == 1 || r[1]! == 2) && r[2]! == 0 && r[3]! == 0 && r[4]! == 0 && r[5]! == 0
    | _ => false)

@[expose] def decodedOK (_ : Unit) : Bool :=
  words.size == 11 && decoded.size == 11 && wordNames.size == 11 &&
  (List.range 11).all fun w =>
    words[w]!.size == decoded[w]!.size &&
    (List.range words[w]!.size).all fun t =>
      rowOK decoded[w]![t]! && decoded[w]![t]![0]! == words[w]![t]!.1 &&
        decoded[w]![t]![1]! == words[w]![t]!.2

@[expose] def allOK (_ : Unit) : Bool :=
  jBasisOK () && dualOK () && thetaOK () && permsOK () && liftOK () && phaseOK () && decodedOK ()

end CFSG.YGroups.Y443Native
