  match r[0]! with
  | 0 => [#[0, r[3]!, r[2]!, r[4]!]]
  | 1 => [#[3, 0, 0, 0], #[3, 0, 0, 0], #[0, r[3]!, r[2]!, r[4]!], #[3, 0, 0, 0]]
  | 2 => [#[0, 0, 0, r[4]!]]
  | 3 => [#[0, 0, 0, r[4]!], #[1, 0, r[5]!, 0]]
  | 4 => List.replicate r[1]! #[3, 0, 0, 0]
  | _ => List.replicate r[1]! #[2, 0, 0, 0]

