@[expose] def parseWords (s : String) : Array (List Int) :=
  ((s.splitOn ";").map fun w => (w.splitOn ",").map fun z => z.toInt?.getD 0).toArray

@[expose] def aux (_ : Unit := ()) : Array (List Int) := parseWords auxText

@[expose] def SubChain.words (S : SubChain) (A : Array (List Int)) : Array (List Int) :=
  A ++ (S.idx.map fun i : Nat => [(i : Int) + 3]).toArray ++ S.deeper

@[expose] def SubChain.allOrds (S : SubChain) : Array Nat := auxOrds ++ S.ords

@[expose] def levelNestOK (words : Array (List Int)) (starts : Array Nat) : Bool :=
  allIn 1 (starts.size - 1) fun i => allIn starts[i]! starts[i + 1]! fun j =>
    words[j]!.all fun z => decide (starts[i - 1]! + 3 ≤ z.natAbs) &&
      decide (z.natAbs < starts[i]! + 3)

@[expose] def subChainOK (S : SubChain) (chunks : Nat) : Bool :=
  let D := co1Data ()
  let O := D.orbit ()
  let A := aux ()
  let W := S.words A
  let L := slpLetters D.n (genT D.n O) W
  let T := levelTrees D.n L S.starts S.base
  slpOK W && S.idx.all (· < A.size) && S.starts.size == S.base.size + 1 &&
    decide (2 ≤ S.starts.size) && S.starts[0]! == A.size &&
    S.starts[1]! == A.size + S.idx.length && levelNestOK W S.starts &&
    levelChainOK D.n L S.starts S.allOrds S.base D.basis S.qb T chunks &&
    orbitSizes T == S.orbSizes

@[expose] def genWords (A : Array (List Int)) : Array (List Int) :=
  A ++ (hIdx.map fun i : Nat => [(i : Int) + 3]).toArray ++ (genDeeper ++ #[wordA, wordB])

@[expose] def genOK (_ : Unit := ()) : Bool :=
  let D := co1Data ()
  let O := D.orbit ()
  let A := aux ()
  let W := genWords A
  let L := slpLetters D.n (genT D.n O) W
  let m := W.size
  slpOK W && hIdx.all (· < A.size) &&
    allIn (A.size + hIdx.length) m (fun j => W[j]!.all fun z => decide (A.size + 3 ≤ z.natAbs)) &&
    allIn 0 m (fun j => invOK D.n L[2 * j]! L[2 * j + 1]!) && decide (2 ≤ m) &&
    L[2 * (m - 2)]! == O.alpha && L[2 * (m - 1)]! == O.beta

