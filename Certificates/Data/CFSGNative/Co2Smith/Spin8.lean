@[expose] def wordZ (w : List Nat) : Array Int := w.foldr (fun k acc => mulZ spinMats[k]! acc) idZ

@[expose] def spinCheck (_ : Unit := ()) : Bool :=
  (List.range 8).all (fun i => wordZ [2 * i, 2 * i + 1] == idZ) &&
    sp6CoverR.all (fun r => wordZ (r.map sCode) == idZ) && wordZ [0, 0] == negIdZ

