@[expose] def mulZ (A B : Array Int) : Array Int :=
  Array.ofFn (n := 64) fun k =>
    A[8 * (k.val / 8)]! * B[k.val % 8]! + A[8 * (k.val / 8) + 1]! * B[8 + k.val % 8]! +
      A[8 * (k.val / 8) + 2]! * B[16 + k.val % 8]! + A[8 * (k.val / 8) + 3]! * B[24 + k.val % 8]! +
      A[8 * (k.val / 8) + 4]! * B[32 + k.val % 8]! + A[8 * (k.val / 8) + 5]! * B[40 + k.val % 8]! +
      A[8 * (k.val / 8) + 6]! * B[48 + k.val % 8]! + A[8 * (k.val / 8) + 7]! * B[56 + k.val % 8]!

@[expose] def idZ (_ : Unit := ()) : Array Int :=
  Array.ofFn (n := 64) fun k => if k.val / 8 = k.val % 8 then 1 else 0

@[expose] def negIdZ (_ : Unit := ()) : Array Int :=
  Array.ofFn (n := 64) fun k => if k.val / 8 = k.val % 8 then -1 else 0

