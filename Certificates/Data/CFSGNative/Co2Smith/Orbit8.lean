@[expose] def orbitOK (base : Nat) (data : List (Nat × List Nat)) : Bool :=
  data.all fun p => colAct8 (wRows9 p.2) base == p.1 && p.2.all (· < 9)

@[expose] def coverOK (data : List (Nat × List Nat)) (good : Nat → Bool) : Bool :=
  (List.range 256).all fun u => !good u || data.any (·.1 == u)

@[expose] def singOK (_ : Unit := ()) : Bool :=
  orbitOK 1 singWords && coverOK singWords fun u => u != 0 && !qf8 u

@[expose] def nsOK (_ : Unit := ()) : Bool := orbitOK 129 nsWords && coverOK nsWords fun u => qf8 u

