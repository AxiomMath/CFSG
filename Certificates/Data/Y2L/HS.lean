@[expose] def y2l_hsW (_ : Unit := ()) : List (List (ℕ × Bool)) :=
  (y2l_hsCodes ()).map fun w => w.map fun c => (c / 2, c % 2 == 0)

@[expose] def y2l_hsCheck (_ : Unit := ()) : Bool :=
  let D := CFSG.Sporadic.HS.Native.hsData ()
  let O := D.orbit ()
  let ai := invT D.n O.alpha
  let bi := invT D.n O.beta
  let W := y2l_hsW ()
  relCheck D.n O.alpha ai O.beta bi ((y2l_ws26 2 false).map (y2l_subst W)) &&
    ((y2l_ws7 2).map (y2l_subst W)).all fun v =>
      let T := wordTab D.n O.alpha ai O.beta bi v
      (List.range D.n).any fun i => ap T i != i

end CFSG.OddStandard.HigherRank.G2Three.Sec2
