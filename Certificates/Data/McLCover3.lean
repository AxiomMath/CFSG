@[expose] def mclCovArr (k : ℕ) : Array ℕ := hexTable 3 275 (275 * k) mclCovHex

@[expose] def mclCovSift (x : Array ℕ) : Bool :=
  isInvA 275 x (invCand 275 x) &&
    siftA 275 CFSG.Sporadic.Schreier.PairMcL.levels CFSG.Sporadic.Schreier.PairMcL.baseArr 0 x

@[expose] def mclCovConj (q t : Array ℕ) : Array ℕ := compA 275 (compA 275 q t) (invCand 275 q)

@[expose] def mclCovProd (u : ℕ) : Array ℕ := pN 275 (mclCovArr 1) (mclCovArr 2) (u % 3, u / 3)

@[expose] def mclCovDistinct : Bool :=
  (List.range 9).all fun u => (List.range 9).all fun v =>
    u == v || !eqA 275 (mclCovProd u) (mclCovProd v)

