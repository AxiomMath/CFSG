@[expose] def hc (c0 c2 c4 : ℕ) : List ℕ := [c0, mact omc c0, c2, mact omc c2, c4, mact omc c4]

@[expose] def injC (m : List ℕ) : Bool := (List.range 63).all fun c => mact m (c + 1) != 0

@[expose] def powC (m : List ℕ) : ℕ → List ℕ
  | 0 => idc
  | n + 1 => mmul m (powC m n)

@[expose] def inZ (m : List ℕ) : Bool := m == idc || m == omc || m == mmul omc omc

@[expose] def invHyp (m : List ℕ) : Bool := injC m && mmul m m == idc && m != idc

@[expose] def genHyp (m : List ℕ) : Bool :=
  injC m && powC m 4 == idc && inZ (powC (mmul a0c m) 5) && inZ (powC (mmul a0c (mmul m m)) 5)

@[expose] def pairB (m m' : List ℕ) : Bool :=
  decide (InvPair m m') && m.length == 6 && m'.length == 6

@[expose] def invOK (m : List ℕ) : Bool :=
  invTab.any fun e => e.1 == m && pairB e.2.1 e.2.2 && mmul e.2.1 omc == mmul omc e.2.1 &&
    mmul e.2.1 (mmul a0c e.2.2) == m

@[expose] def conjOK : Bool :=
  conjTab.all fun e => pairB e.1 e.2.1 && wval e.2.2 == mmul e.2.1 (mmul a0c e.1) &&
    e.2.2.all (· < 2)

@[expose] def genOK (m : List ℕ) : Bool :=
  genTab.any fun e => e.1 == m && (match conjTab[e.2.1]? with
    | some c => wval e.2.2 == mmul c.2.1 (mmul m c.1) && e.2.2.all (· < 2)
    | none => false)

@[expose] def g0OK : Bool :=
  g0List.contains idc && g0List.length == 1080 &&
    g0List.all fun m => g0List.contains (mmul g1c m) && g0List.contains (mmul g2c m) &&
      g0List.contains (mmul g1i m) && g0List.contains (mmul g2i m)

@[expose] def allCodes (f : List ℕ → Bool) : Bool :=
  (List.range 64).all fun c0 => (List.range 64).all fun c2 => (List.range 64).all fun c4 =>
    f (hc c0 c2 c4)

