@[expose] def closeIdx (k i : ℕ) : ℕ := (closeTable.getD k []).getD i 0

@[expose] def wordProd (gens : List M4c) (w : List ℕ) : M4c :=
  w.foldl (fun A i => A.mul (gens.getD i M4c.one)) M4c.one

abbrev IsOrder4 (x : M4c) : Prop := (x.mul x).mul (x.mul x) = M4c.one ∧ x.mul x ≠ M4c.one

@[expose] def WitP (C : List M4c) : Wit → Prop
  | .norm => SetEq C e0c
  | .word w => IsOrder4 (wordProd (e0c ++ C) w)
  | .comm n => M4c.ofCode n ∈ C ∧ M4c.ofCode n ∉ e0c ∧
      (M4c.ofCode n).mul (M4c.ofCode n) = M4c.one ∧
      ∀ e ∈ e0c, e.mul (M4c.ofCode n) = (M4c.ofCode n).mul e
  | .orbit ws => (∀ v ∈ V4c.all, v = V4c.zero ∨ ∃ p ∈ ws, V4c.ofCode p.1 = v) ∧
      ∀ p ∈ ws, (wordProd (e0c ++ C) p.2).mulVec V4c.v0 = V4c.ofCode p.1

instance (C : List M4c) : ∀ w : Wit, Decidable (WitP C w)
  | .norm => inferInstanceAs (Decidable (SetEq C e0c))
  | .word w => inferInstanceAs (Decidable (IsOrder4 (wordProd (e0c ++ C) w)))
  | .comm n => inferInstanceAs (Decidable (M4c.ofCode n ∈ C ∧ M4c.ofCode n ∉ e0c ∧
      (M4c.ofCode n).mul (M4c.ofCode n) = M4c.one ∧
      ∀ e ∈ e0c, e.mul (M4c.ofCode n) = (M4c.ofCode n).mul e))
  | .orbit ws => inferInstanceAs (Decidable ((∀ v ∈ V4c.all, v = V4c.zero ∨
      ∃ p ∈ ws, V4c.ofCode p.1 = v) ∧
      ∀ p ∈ ws, (wordProd (e0c ++ C) p.2).mulVec V4c.v0 = V4c.ofCode p.1))

end CFSG.ComponentClassification.GHarris.GL42
