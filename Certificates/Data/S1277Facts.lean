variable {G : Type} [Group G]

@[expose] def CodQ (Q : Subgroup G) (w : G → ℕ) (d : ℕ) : Prop :=
  (∀ x ∈ Q, w x < 2 ^ d) ∧ (∀ x ∈ Q, ∀ y ∈ Q, w (x * y) = w x ^^^ w y) ∧
    (∀ e < 2 ^ d, ∃ x ∈ Q, w x = e) ∧ ∀ x ∈ Q, w x = 0 ↔ x ∈ Phi' Q

@[expose] def LabInv (H Q : Subgroup G) (w : G → ℕ) (φ : ℕ → ℕ) : Prop :=
  ∀ h ∈ H, ∀ x ∈ Q, φ (w (h * x * h⁻¹)) = φ (w x)

@[expose] def VFacts (G0 : List B6) (Q : Subgroup G) (κ : G → ℕ) : Prop :=
  (∀ c < 64, ∃ q ∈ Q, κ q = (mkTab G0).idB * 64 + c) ∧
    ∃ bp : List ℕ, (∀ q ∈ Q, κ q / 64 ∈ bp) ∧ (∀ i ∈ bp, i < G0.length) ∧
      (bp.map (G0.getD · B6.id)).length ≤ 8 ∧
      (∀ B ∈ bp.map (G0.getD · B6.id), isInvB B = true → (fixCode B).length ≤ 16) ∧
      ∀ B₁ ∈ bp.map (G0.getD · B6.id), ∀ B₂ ∈ bp.map (G0.getD · B6.id), B₁ ≠ B₂ →
        isInvB B₁ = true → isInvB B₂ = true → B₁.comp B₂ = B₂.comp B₁ →
          (fixInterL B₁ B₂).length < 8

@[expose] def NFFacts (K Q : Subgroup G) : Prop :=
  ∃ k ∈ K, k ∉ Q ∧ ∀ y ∈ Q, k * y * k⁻¹ * y⁻¹ ∈ Phi' Q

@[expose] def NCFacts (K Q : Subgroup G) (z : G) : Prop :=
  z ∉ Q ∨ ∃ x ∈ K, x ∉ Q ∧ ∀ y ∈ Q, x * y = y * x

@[expose] def SigFacts (H K Q : Subgroup G) : Prop :=
  ∃ (d : ℕ) (w : G → ℕ) (φ : ℕ → ℕ) (b k : ℕ), CodQ Q w d ∧ LabInv H Q w φ ∧
    Nat.card (Sig d φ) = Nat.card K / Nat.card Q * (b * 2 ^ k) ∧
    ((b = 3 ∧ ∃ O : Subgroup G, O ≤ K ∧ (∀ g ∈ K, ∀ o ∈ O, g * o * g⁻¹ ∈ O) ∧ IsPGroup 2 ↥O ∧
        4 * Nat.card Q ≤ Nat.card O) ∨
      (b = 7 ∧ k < 3 ∧ ∃ X : Subgroup (Equiv.Perm (Fin (2 ^ d))), X ≤ Sig d φ ∧
        (∀ τ ∈ Sig d φ, ∀ x ∈ X, τ * x * τ⁻¹ ∈ X) ∧ IsPGroup 2 ↥X ∧ 8 ≤ Nat.card X))

@[expose] def comb (u : Fin 3 → ℕ) (e : Fin 3 → ZMod 2) : ℕ :=
  u 0 * (e 0).val ^^^ u 1 * (e 1).val ^^^ u 2 * (e 2).val

@[expose] def InSpan (u : Fin 3 → ℕ) (x : ℕ) : Prop := ∃ e, comb u e = x

@[expose] def Basis3 (u : Fin 3 → ℕ) : Prop := (∀ i, u i < 2 ^ 6) ∧ Function.Injective (comb u)

@[expose] def SpanInv (R : Subgroup (Equiv.Perm (Fin (2 ^ 6)))) (u : Fin 3 → ℕ) : Prop :=
  ∀ σ ∈ R, ∀ x (hx : x < 2 ^ 6), InSpan u x → InSpan u (σ ⟨x, hx⟩).1

@[expose] def PreFacts (Q : Subgroup G) (w : G → ℕ) (u : Fin 3 → ℕ) : Prop :=
  (∀ x ∈ Q, ∀ y ∈ Q, InSpan u (w x) → InSpan u (w y) → x * y = y * x ∧ x * x = 1) ∧
    {x | x ∈ Q ∧ InSpan u (w x)}.ncard = 16

@[expose] def ImFacts (Q : Subgroup G) (w : G → ℕ) (R : Subgroup (Equiv.Perm (Fin (2 ^ 6)))) :
    Prop :=
  Nat.card R = 168 ∧ ∃ u v : Fin 3 → ℕ, Basis3 u ∧ Basis3 v ∧
    (∀ x, InSpan u x → InSpan v x → x = 0) ∧ (∀ c < 2 ^ 6, ∃ x, InSpan u x ∧ InSpan v (x ^^^ c)) ∧
    SpanInv R u ∧ SpanInv R v ∧
    (∀ σ ∈ R, (∀ i (hi : u i < 2 ^ 6), (σ ⟨u i, hi⟩).1 = u i) → σ = 1) ∧
    PreFacts Q w u ∧ PreFacts Q w v

@[expose] def SurvFacts (H K Q : Subgroup G) (z : G) : Prop :=
  ∃ (w : G → ℕ) (φ : ℕ → ℕ), CodQ Q w 6 ∧ LabInv H Q w φ ∧ Nat.card Q = 2 ^ 7 ∧
    z ∈ Phi' Q ∧ (∀ r ∈ Phi' Q, r = 1 ∨ r = z) ∧ z ≠ 1 ∧
    (∀ x ∈ Q, (∀ y ∈ Q, x * y = y * x) → x = 1 ∨ x = z) ∧
    (∃ a ∈ Q, ∃ b ∈ Q, a * b * a⁻¹ * b⁻¹ = z) ∧
    ∀ D : FrData H Q (Phi' Q) 6, (∀ x, D.wc x = w x) → ∀ m,
      Nat.card Q * Nat.card D.rho.range = Nat.card K * m → ¬ 2 ∣ m → m ≠ 1 →
        ImFacts Q w D.rho.range

@[expose] def ModelFacts1277 (Γ : List B6) : Prop :=
  (stabL Γ 5).Nodup ∧
  ∀ {G : Type} [Group G] [Finite G] {H K Q : Subgroup G} {κ : G → ℕ} {z : G},
    KCod K (mkTab (stabL Γ 5)) κ → K ≤ H → Q ≤ K → (∀ h ∈ H, ∀ x ∈ Q, h * x * h⁻¹ ∈ Q) →
    IsPGroup 2 ↥Q →
    (∀ X : Subgroup G, X ≤ H → (∀ h ∈ H, ∀ x ∈ X, h * x * h⁻¹ ∈ X) → IsPGroup 2 ↥X → X ≤ Q) →
    (∀ h ∈ H, (∀ x ∈ Q, h * x = x * h) → h ∈ Q) → (∀ h ∈ H, h * z * h⁻¹ = z) → z ∈ K →
    κ z = (mkTab (stabL Γ 5)).idB * 64 + 5 →
    VFacts (stabL Γ 5) Q κ ∨ NFFacts K Q ∨ NCFacts K Q z ∨ SigFacts H K Q ∨ SurvFacts H K Q z

