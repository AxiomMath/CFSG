@[expose] def genA (k : Nat) : Array Nat := if k = 0 then autStrong[0]! else autStrong[1]!

@[expose] def wordA (w : List Nat) : Array Nat :=
  w.foldr (fun k acc => compA 315 (genA k) acc) (idA 315)

@[expose] def conjY (i : Nat) : Array Nat := conjA 315 (wordA words[i]!) zArr

@[expose] def sameLine (t y : Array Nat) : Bool := eqA 315 t y || eqA 315 t (compA 315 y y)

@[expose] def tabOf (k : Nat) : Array Nat := if k = 0 then tA else tB

@[expose] def tab (u : List Nat) (i : Nat) : Nat := u.foldr (fun k j => (tabOf k)[j]!) i

@[expose] def uOf (j : Nat) : List Nat := uWords[uIdx[j]!]!

@[expose] def rel (c : Nat) : List Nat := [reps[c]!, tZ[reps[c]!]!, tZ[tZ[reps[c]!]!]!]

@[expose] def relMu (m : List Bool) (c : Nat) : List Nat :=
  rel c ++ if m.getD c false then [0] else []

@[expose] def combList (m : List Bool) (ts : List (Nat × Nat)) : List Nat :=
  ts.flatMap fun t => (relMu m cls[t.2]!).map (tab (words[t.1]! ++ uOf t.2))

@[expose] def parityOK (l : List Nat) : Bool :=
  (List.range 280).all fun x => l.count x % 2 == if x = 0 then 1 else 0

@[expose] def permEq (l₁ l₂ : List Nat) : Bool :=
  (l₁ ++ l₂).all fun x => l₁.count x == l₂.count x

@[expose] def checkA (_ : Unit := ()) : Bool :=
