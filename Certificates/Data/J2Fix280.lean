        sameLine (conjA 315 (genA 1) Ys[i]!) Ys[tB[i]!]! &&
        sameLine (conjA 315 zArr Ys[i]!) Ys[tZ[i]!]!

@[expose] def checkB (_ : Unit := ()) : Bool :=
