@[expose] def decF4 (m n : ℕ) (rows : List ℕ) : Vector (Vector FieldFour n) m :=
  (Vector.ofFn fun i : Fin m => rows.getD i 0).map fun r =>
    Vector.ofFn fun j : Fin n => ⟨r.testBit (2 * j), r.testBit (2 * j + 1)⟩

@[expose] def limbEntry (a : Array ℕ) (n i j : ℕ) : FieldFour :=
  let x := a.getD (i * ((n + 29) / 30) + j / 30) 0
  ⟨x.testBit (2 * (j % 30)), x.testBit (2 * (j % 30) + 1)⟩

@[expose] def decF4L (m n : ℕ) (limbs : List ℕ) : Vector (Vector FieldFour n) m :=
  let a := limbs.toArray
  Vector.ofFn fun i : Fin m => Vector.ofFn fun j : Fin n => limbEntry a n i j

@[expose] def decVecF4L (n : ℕ) (limbs : List ℕ) : Vector FieldFour n :=
  let a := limbs.toArray
  Vector.ofFn fun j : Fin n => limbEntry a n 0 j

