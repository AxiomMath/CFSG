@[expose] def betaWord : List Nat :=
  [5, 13, 21, 2, 3, 5, 13, 21, 2, 3, 5, 13, 21, 2, 3, 5, 13, 21, 2, 3, 5, 13, 21, 2, 3]

@[expose] def betaArr : Array Nat := innerWordArr 0 betaWord

@[expose] def tBetaArr : Array Nat := compA 1782 (tArr 0) betaArr

@[expose] def betaConjOK (e : Array Nat) : Bool :=
  eqA 1782 (compA 1782 e betaArr) (compA 1782 betaArr e) ||
    eqA 1782 (compA 1782 e betaArr) (compA 1782 tBetaArr e)

@[expose] def betaOK : Bool :=
  (betaWord.all fun h => decide (1 ≤ h ∧ h ≤ (invInnerGenArrs 0).size)) &&
    (fixList 0).all (fun x => betaArr[x]! == x) &&
    !eqA 1782 betaArr (idA 1782) && !eqA 1782 betaArr (tArr 0) &&
    allBelow (invInnerGenArrs 0).size (fun k => betaConjOK (invInnerGenArrs 0)[k]!) &&
    !eqA 1782 (compA 1782 (invInnerGenArrs 0)[4]! betaArr)
      (compA 1782 betaArr (invInnerGenArrs 0)[4]!)

@[expose] def outerArr : Array Nat := (invFullGenArrs 0)[6]!

@[expose] def outerOK : Bool :=
  decide (6 < (invFullGenArrs 0).size) && !inM outerArr &&
    notInOK (enumOf 42 (kGens 0) 40320).tabs (restrictArr (fixList 0) outerArr)

