@[expose] def n0Bytes : ByteArray := n0Code.toUTF8

@[expose] def n0Entry (k : Nat) : Nat := digit27 (n0Bytes.get! (k / 3)) / 3 ^ (k % 3) % 3

@[expose] def n0Rows : Array V :=
  Array.ofFn (n := 154) fun i => V.ofFn 154 fun j => n0Entry (154 * i.val + j)

@[expose] def n0InvRows : Array V := invV 154 n0Rows

@[expose] def okRows (X : Array V) : Bool := X.size == 154 && wfM X

@[expose] def letterRows (S Si : Array (Array V)) (l : Int) : Array V :=
  if 0 < l then S[l.toNat - 1]! else Si[(-l).toNat - 1]!

@[expose] def wordRows (S Si : Array (Array V)) : List Int → Array V
  | [] => idM 154
  | l :: w => mul 154 (letterRows S Si l) (wordRows S Si w)

@[expose] def sR0 : Array V := rowsA
@[expose] def sR1 : Array V := rowsB
@[expose] def sI0 : Array V := invV 154 sR0
@[expose] def sI1 : Array V := invV 154 sR1
@[expose] def sR2 : Array V := wordRows #[sR0, sR1] #[sI0, sI1] CFSG.ONSchreier.Data.strongWords[2]!
@[expose] def sI2 : Array V := invV 154 sR2
@[expose] def sR3 : Array V :=
  wordRows #[sR0, sR1, sR2] #[sI0, sI1, sI2] CFSG.ONSchreier.Data.strongWords[3]!
@[expose] def sI3 : Array V := invV 154 sR3
@[expose] def sR4 : Array V :=
  wordRows #[sR0, sR1, sR2, sR3] #[sI0, sI1, sI2, sI3] CFSG.ONSchreier.Data.strongWords[4]!
@[expose] def sI4 : Array V := invV 154 sR4
@[expose] def sR5 : Array V :=
  wordRows #[sR0, sR1, sR2, sR3, sR4] #[sI0, sI1, sI2, sI3, sI4]
    CFSG.ONSchreier.Data.strongWords[5]!
@[expose] def sI5 : Array V := invV 154 sR5
@[expose] def sR6 : Array V :=
  wordRows #[sR0, sR1, sR2, sR3, sR4, sR5] #[sI0, sI1, sI2, sI3, sI4, sI5]
    CFSG.ONSchreier.Data.strongWords[6]!
@[expose] def sI6 : Array V := invV 154 sR6

@[expose] def sRows : Array (Array V) := #[sR0, sR1, sR2, sR3, sR4, sR5, sR6]
@[expose] def sIRows : Array (Array V) := #[sI0, sI1, sI2, sI3, sI4, sI5, sI6]

@[expose] def wA : List Int := [2, -6, -3, 6, -4, 2, 5, -4, 5, 4, 4, -7]
@[expose] def wB : List Int := [-6, -4, 1, 7, 1, 3, -4, 5, -6, -3, 7]

@[expose] def zRows : Array V := wordRows sRows sIRows CFSG.ONSchreier.Data.zWord

@[expose] def n0SqRows : Array V := mul 154 n0Rows n0Rows

end CFSG.ComponentClassification.SolMax.ONOut
