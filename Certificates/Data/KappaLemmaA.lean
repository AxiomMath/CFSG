@[expose] def maskTab (_ : Unit := ()) : Array (Array (ZMod 2)) :=
  Array.ofFn (n := 211) fun n => Array.ofFn (eqnMask n.val)

@[expose] def comboOK (_ : Unit := ()) : Bool :=
  let M := maskTab ()
  (List.finRange 64).all fun v => v == 1 ||
    ((combo[v.val]!).all (· < 211) &&
      (List.finRange 64).all (fun w =>
        decide (((combo[v.val]!).map fun n => (M[n]!)[w.val]!).sum =
          (Pi.single v 1 : Fin 64 → ZMod 2) w + tDir v * (Pi.single 1 1 : Fin 64 → ZMod 2) w)) &&
      decide (((combo[v.val]!).map eqnRhs).sum = tBase1 v))

@[expose] def table0OK (_ : Unit := ()) : Bool :=
  decide (∀ μ x y z : ZMod 2, betaT (kapTc 0 μ) ![x, y, z, 0] b0 = μ • ![y + z, z, 0, 0])

@[expose] def table1OK (_ : Unit := ()) : Bool :=
  decide (∀ μ : ZMod 2, betaT (kapTc 1 μ) ![0, 0, 1, 0] b0 2 = 1)

@[expose] def check (_ : Unit) : Bool := modelOK () && comboOK () && table0OK () && table1OK ()

