@[expose] def pairOK (E : List (Array ℕ)) (m₁ m₂ : ℕ) : Bool :=
  let a := E.getD m₁ #[]
  let b := E.getD m₂ #[]
  eqA 1755 a (idA 1755) || eqA 1755 a (vA 12) || eqA 1755 b (idA 1755) || eqA 1755 b (vA 12) ||
    eqA 1755 b a || eqA 1755 b (compA 1755 a (vA 12)) ||
    pairTbl.any fun e => e.1 == m₁ % 16 && e.2.1 == m₂ % 16 && jLetters e.2.2 &&
      commA (jArr e.2.2) a && conjToA (jArr e.2.2) b (compA 1755 b (vA 12))

@[expose] def pairCheck (_ : Unit) : Bool :=
  let E := eArrs ()
  (List.range 32).all fun m₁ => (List.range 32).all fun m₂ => pairOK E m₁ m₂

