@[expose] def witK : Nat := 2

@[expose] def witJ : Nat := 0

@[expose] def idxAct (l : Int) (k : Nat) : Nat :=
  if 0 < l then (kwSig.getD (l.toNat - 1) []).getD k 0
  else (kwSig.getD ((-l).toNat + 1) []).getD k 0

@[expose] def wordAct (w : List Int) (k : Nat) : Nat := w.foldr idxAct k

@[expose] def schWord (i : Nat) : List Int :=
  invW (tWords.getD ((kwSig.getD (i % 2) []).getD (i / 2) 0) []) ++ [((i % 2 : Nat) : Int) + 1] ++
    tWords.getD (i / 2) []

@[expose] def chkT (_ : Unit := ()) : Bool :=
  (List.range 31).all (fun x => wordAct (tWords.getD x []) 0 == x) &&
    (List.range 62).all fun i => wordAct (schWord i) 0 == 0

@[expose] def xorMasks (ms : List Nat) (c : Nat) : Nat :=
  (List.range 11).foldl (fun acc k => if c.testBit k then acc ^^^ ms.getD k 0 else acc) 0

@[expose] def psiArr (i : Nat) : Array Nat :=
  Array.ofFn (n := 2048) fun c => xorMasks (maskTab.getD i []) c

@[expose] def psiOrig (_ : Unit := ()) : Array (Array Nat) := ((List.range 62).map psiArr).toArray

@[expose] def psiS (_ : Unit := ()) : Array (Array Nat) :=
  psiOrig () ++ ((List.range 9).map fun j =>
    wordA 2048 (psiOrig ()) (rawInvs 2048 (psiOrig ())) (psiW.getD (62 + j) [])).toArray

@[expose] def gRows (_ : Unit := ()) : Array V2 := wordRows baseMats baseInvs gWord

@[expose] def gInvRows (_ : Unit := ()) : Array V2 := wordRows baseMats baseInvs (invW gWord)

@[expose] def hRows (i : Nat) : Array V2 :=
  mulRows (mulRows (gRows ()) (wordRows (m4Mats ()) (m4Invs ()) (schWord i))) (gInvRows ())

@[expose] def hInvRows (i : Nat) : Array V2 :=
  mulRows (mulRows (gRows ()) (wordRows (m4Mats ()) (m4Invs ()) (invW (schWord i)))) (gInvRows ())

@[expose] def chkMasksWith (T : Array (Array V2)) : Bool :=
  (List.range 62).all fun i =>
    (List.range 11).all fun k =>
      eqRows (mulRows (mulRows (hRows i) (etaRows T 11 (2 ^ k))) (hInvRows i))
        (etaRows T 11 ((maskTab.getD i []).getD k 0))

@[expose] def chkMasks (_ : Unit := ()) : Bool := chkMasksWith (uTab (locMats ()) (locInvs ()))

@[expose] def rowsDiffer (A B : Array V2) : Bool :=
  (List.range 112).any fun i => differs (A[i]?.getD V2.zero) (B[i]?.getD V2.zero)

@[expose] def wRowsWith (T : Array (Array V2)) : Array V2 :=
  mulRows (mulRows (gInvRows ()) (etaRows T 11 (2 ^ witK))) (gRows ())

@[expose] def chkWitWith (T : Array (Array V2)) : Bool :=
  (List.range 1024).all fun c =>
    rowsDiffer (mulRows (mulRows (wRowsWith T) ((fTab ())[witJ]?.getD idRows)) (wRowsWith T))
      (fRows (fTab ()) c)

@[expose] def chkWit (_ : Unit := ()) : Bool := chkWitWith (uTab (locMats ()) (locInvs ()))

@[expose] def chkDistinct (_ : Unit := ()) : Bool :=
  (List.range 31).all fun k => (List.range 31).all fun k' =>
    k == k' || differs (kwVecs.getD k V2.zero) (kwVecs.getD k' V2.zero)

@[expose] def chkPsi (_ : Unit := ()) : Bool :=
  rawChainOK 2048 ((psiS ()).extract 0 62) (psiS ()) psiBase.toArray psiW 1 &&
    rawOrbitSizes 2048 (psiS ()) psiBase.toArray == [120, 84, 16, 2] &&
    (List.range 62).all fun i => eqA 2048 (psiS ())[i]! (psiArr i)

@[expose] def geRowsWith (T : Array (Array V2)) (c : Nat) : Array V2 :=
  mulRows (mulRows (gInvRows ()) (etaRows T 11 c)) (gRows ())

@[expose] def chkKEWith (T : Array (Array V2)) : Bool :=
  (List.range 10).all fun j =>
    eqRows (wordRows (m4Mats ()) (m4Invs ()) (keWords.getD j [])) (geRowsWith T (keMasks.getD j 0))

@[expose] def chkKE (_ : Unit := ()) : Bool := chkKEWith (uTab (locMats ()) (locInvs ()))

end CFSG.Quasithin.J4M4Card
