@[expose] def xAArr (L : Array Level) : Array Nat := rebuild L xATuple

@[expose] def xBArr (L : Array Level) : Array Nat := rebuild L xBTuple

@[expose] def fuseArr (L : Array Level) (k : Nat) : Array Nat := rebuild L fuseTuples[k]!

@[expose] def fuseCheck (_ : Unit := ()) : Bool :=
  let L := levels ()
  let E := dElts ()
  let xa := xAArr L
  let xb := xBArr L
  validA 1782 xa && inP L xa && eqA 1782 (powArr 1782 xa 3) (idA 1782) &&
    !(eqA 1782 xa (idA 1782)) &&
  validA 1782 xb && inP L xb && eqA 1782 (powArr 1782 xb 3) (idA 1782) &&
    !(eqA 1782 xb (idA 1782)) &&
  fuseTuples.size == 243 && fuseCls.size == 243 &&
  allLt 243 fun k =>
    k == 0 || (validA 1782 (fuseArr L k) && inP L (fuseArr L k) &&
      eqA 1782 (conjA 1782 (fuseArr L k) E[k]!) (if fuseCls[k]! == 0 then xa else xb))

