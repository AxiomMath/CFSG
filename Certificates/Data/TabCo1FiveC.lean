@[expose] def fiveCCheck (_ : Unit := ()) : Bool :=
  let D := kDag ext
  let zR := nd D 88
  let t1R := nd D 89
  let t2R := nd D 90
  let s1R := nd D 91
  let s2R := nd D 92
  let t1I := ndI D 89
  let t2I := ndI D 90
  let s1I := ndI D 91
  let s2I := ndI D 92
  let TG := [t1R, t2R].toArray
  let Tt := gtBFS TG 200
  let CG := [s1R, s2R].toArray
  let Ct := gtBFS CG 20000
  D.2.2 && wf zR && wf (one ()) && zR == repZ && pow zR 5 == one () && zR != one () &&
    mul zR t1R == mul t1R zR && mul zR t2R == mul t2R zR &&
    mul zR s1R == mul s1R zR && mul zR s2R == mul s2R zR &&
    zR == mul (mul t1R t2R) (mul t1I t2I) &&
    gtOK TG Tt && decide (Tt.pts.size = 125) &&
    Tt.pts.contains (mul (mul s1R t1R) s1I) && Tt.pts.contains (mul (mul s1R t2R) s1I) &&
    Tt.pts.contains (mul (mul s2R t1R) s2I) && Tt.pts.contains (mul (mul s2R t2R) s2I) &&
    Tt.pts.contains (mul (mul s1I t1R) s1R) && Tt.pts.contains (mul (mul s1I t2R) s1R) &&
    Tt.pts.contains (mul (mul s2I t1R) s2R) && Tt.pts.contains (mul (mul s2I t2R) s2R) &&
    gtOK CG Ct && decide (Ct.pts.size = 15000) &&
    boundOK (colsOf (powList zR 5)) 5 base conds cnts span comb && decide (cnts.prod ≤ 15000) &&
    boundOK (colsOf (ptRows zR t1R t2R)) 7 base2 conds2 cnts2 span2 comb2 &&
    decide (cnts2.prod ≤ 5)

