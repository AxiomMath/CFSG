@[expose] def psiArr (g : Equiv.Perm (Fin 22)) : Array ℕ :=
  let ga : Array ℕ := Array.ofFn fun i : Fin 22 => (g i : ℕ)
  Array.ofFn fun m : Fin 24 => if (m : ℕ) < 2 then m else jCatArr[ga[jInvArr[(m : ℕ)]!]!]!

@[expose] def maskTab (n : ℕ) (f : ℕ → ℕ) : Vector (Vector (ZMod 2) n) n :=
  let cols : Vector ℕ n := Vector.ofFn fun j => f (2 ^ (j : ℕ))
  Vector.ofFn fun i => Vector.ofFn fun j => if cols[j].testBit i then 1 else 0

@[expose] def tab10a (g : G22) : Vector (Vector (ZMod 2) 10) 10 :=
