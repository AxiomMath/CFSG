@[expose] noncomputable def ptQ (Q t : Nat) : Nat := fld(Q, Nat.mul (nat_lit 5) t, nat_lit 31)

@[expose] noncomputable def spreadOctT (Q m : Nat) : Nat :=
  Nat.rec (motive := fun _ => Nat) (nat_lit 0)
    (fun t acc => Nat.xor acc (selB (bitN m t) (Nat.shiftLeft (nat_lit 1) (ptQ Q t)))) (nat_lit 8)

@[expose] noncomputable def pairScanT (P BT : Nat) : Int :=
  strictZ (thetaT (nat_lit 0)) (fun t0 => strictZ (thetaT (nat_lit 63)) (fun t63 =>
    sumZ (nat_lit 276) (fun q => strictZ (dualT (Nat.lor (Nat.shiftLeft (nat_lit 1) (pairI q))
        (Nat.shiftLeft (nat_lit 1) (pairJ q)))) (fun d =>
      Int.add (xTermT P BT (nat_lit 0) (Nat.xor t0 d)) (xTermT P BT (nat_lit 63) (Nat.xor t63 d))))))

@[expose] noncomputable def octRowT (P BT a₀ Q : Nat) : Int :=
  sumZ (nat_lit 64) (fun m => strictZ (spreadOctT Q (evenT m)) (fun s =>
    strictZ (Nat.xor a₀ (selB (bitN (popcT (nat_lit 24) s) (nat_lit 1)) (nat_lit 63))) (fun a =>
      xTermT P BT a (dualT s))))

@[expose] noncomputable def octScanT (P BT o₀ n : Nat) : Int :=
  sumZ n (fun j => strictZ (Nat.add o₀ j) (fun o =>
    strictZ (octT o) (fun a₀ => strictZ (octQ o) (fun Q => octRowT P BT a₀ Q))))

@[expose] noncomputable def wSel (e c' kc r : Nat) : Int :=
  selZ (Nat.beq (e * 2048 + (c' ^^^ selB (bitN c' 0) 63) / 2 % 2048) r)
    (sgnZ (Nat.beq (kc ^^^ (e &&& bitN c' 0)) 1))

@[expose] noncomputable def wRowT (P BT k63 r : Nat) : Int :=
  strictZ (2 * (r % 2048)) (fun c => strictZ (permCT P c) (fun c' =>
    strictZ (r / 2048 ^^^ k63) (fun e => wSel e c' (kappaT BT c) r)))

@[expose] noncomputable def wScanT (P BT : Nat) : Int :=
  strictZ (kappaT BT (nat_lit 63)) (fun k63 =>
    sumZ (nat_lit 64) (fun h => sumZ (nat_lit 64) (fun l =>
      wRowT P BT k63 (h * 64 + l))))

