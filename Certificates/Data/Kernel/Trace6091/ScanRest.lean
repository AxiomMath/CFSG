@[expose] noncomputable def PAIRS : Nat :=
  nat_lit 

@[expose] noncomputable def pairI (q : Nat) : Nat := fld(PAIRS, Nat.mul (nat_lit 10) q, nat_lit 31)

@[expose] noncomputable def pairJ (q : Nat) : Nat :=
  fld(PAIRS, Nat.add (Nat.mul (nat_lit 10) q) (nat_lit 5), nat_lit 31)

@[expose] noncomputable def OCTPOS : Nat :=
  nat_lit 

@[expose] noncomputable def octQ (o : Nat) : Nat :=
