inductive FWit where
  | c1 (w w' : V4)
  | c3
  | c4two (w w' : V4)
  | c4four (w w' : V4)
  | triv
  | w (a b : V4)

def c4aB (c : CfgD) (k : ℕ) : Bool :=
  nonzeroD.all fun w => !memOmD c w || decide (M16.pow (M16.mul T0D (rCD c w)) k = M16.one)

def c4bFail (c : CfgD) (k : ℕ) (w w' : V4) : Bool :=
  memOmD c w && memOmD c w' && !decide (M16.pow (M16.mul (rCD c w) (rCD c w')) k = M16.one)

def fwitOK (c : CfgD) : FWit → Bool
  | .c1 w w' => memOmD c w && memOmD c w' &&
      !(memOmD c ((rCD c w).mulV w') &&
        decide (psiCD c ((rCD c w).mulV w') = (psiCD c w').vmul (rCD c w)))
  | .c3 => nonzeroD.all fun v => !(memOmD c v && decide (v.x0 = 0))
  | .c4two w w' => c4aB c 2 && c4bFail c 2 w w'
  | .c4four w w' => c4aB c 4 && c4bFail c 4 w w'
  | .triv => decide (c.1 = mA ∨ c.1 = mD ∨ c.1 = mE)
  | .w a b => decide (c.1 = mB ∨ c.1 = mC) && memOmD c a && memOmD c b &&
      decide (M16.mul (M16.mul (rCD c a) (rCD c b)) Sig01D ∈ H0D)

def fwitsOK : List CfgD → List FWit → Bool
  | [], _ => true
  | c :: cs, w :: ws => fwitOK c w && fwitsOK cs ws
  | _ :: _, [] => false

def cfgsD : List CfgD :=
  [false, true].flatMap fun m₁ => [false, true].flatMap fun m₂ => [false, true].flatMap fun m₄ =>
    [false, true].flatMap fun m₅ => [false, true].flatMap fun m₆ =>
    (optLD 1 m₁).flatMap fun p₁ => (optLD 2 m₂).flatMap fun p₂ => (optLD 4 m₄).flatMap fun p₄ =>
    (optLD 5 m₅).flatMap fun p₅ => (optLD 6 m₆).map fun p₆ => mkCfgD m₁ m₂ m₄ m₅ m₆ p₁ p₂ p₄ p₅ p₆

