@[expose] def actN (d w : Nat) : Nat := (actP >>> (4 * (16 * d + w))) % 16

@[expose] def m8N (d e : Nat) : Nat := (m8P >>> (4 * (8 * d + e))) % 16

@[expose] def m0N (i j : Nat) : Nat := 8 * ((i / 8) ^^^ actN (i % 8) (j / 8)) + m8N (i % 8) (j % 8)

@[expose] def gamN (ty j : Nat) : Nat := ([gamP0, gamP0, gamP2, gamP2].getD ty 0 >>> (8 * j)) % 256

@[expose] def ssN (ty : Nat) : Nat := [0, 32, 0, 32].getD ty 0

@[expose] def mulN (ty a b : Nat) : Nat :=
  if a % 2 = 0 then 2 * m0N (a / 2) (b / 2) + b % 2
  else if b % 2 = 0 then 2 * m0N (a / 2) (gamN ty (b / 2)) + 1
  else 2 * m0N (m0N (a / 2) (gamN ty (b / 2))) (ssN ty)

@[expose] def invN (ty a : Nat) : Nat := ([invP0, invP1, invP2, invP3].getD ty 0 >>> (8 * a)) % 256

@[expose] def mulI (ty : Nat) (a b : Idx 256) : Idx 256 :=
  ⟨⟨mulN ty a.v b.v % 256, Nat.mod_lt _ (by decide)⟩⟩

@[expose] def invI (ty : Nat) (a : Idx 256) : Idx 256 := ⟨⟨invN ty a.v, Nat.mod_lt _ (by decide)⟩⟩

@[expose] def oneI : Idx 256 := ⟨⟨0, by decide⟩⟩

