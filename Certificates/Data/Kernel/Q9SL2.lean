@[expose] def mul9 (x y : ℕ) : ℕ :=
  (x / 3 * (y / 3) + 2 * (x % 3 * (y % 3))) % 3 * 3 + (x / 3 * (y % 3) + x % 3 * (y / 3)) % 3

@[expose] def neg9 (x : ℕ) : ℕ := (3 - x / 3) % 3 * 3 + (3 - x % 3) % 3

@[expose] def dotT : ℕ :=
  

@[expose] def lkD (i : ℕ) : ℕ := Nat.land (Nat.shiftRight dotT (Nat.mul 4 i)) 15

@[expose] def mulK (x y : ℕ) : ℕ :=
  let r0 := x / 81
  let r1 := x % 81
  let c0 := 9 * (y / 729) + y / 9 % 9
  let c1 := 9 * (y / 81 % 9) + y % 9
  729 * lkD (81 * r0 + c0) + 81 * lkD (81 * r0 + c1) + 9 * lkD (81 * r1 + c0) +
    lkD (81 * r1 + c1)

@[expose] def sigK (x : ℕ) : ℕ :=
  729 * (x % 9) + 81 * mul9 4 (x / 9 % 9) + 9 * mul9 7 (x / 81 % 9) + x / 729

@[expose] def invK (x : ℕ) : ℕ :=
  729 * (x % 9) + 81 * neg9 (x / 81 % 9) + 9 * neg9 (x / 9 % 9) + x / 729

@[expose] def q16K (x : ℕ) : Bool :=
  (x / 81 % 9 == 0 && x / 9 % 9 == 0) || (x / 729 == 0 && x % 9 == 0)

@[expose] def ordAuxK (m : ℕ) : ℕ → ℕ → ℕ → ℕ
  | 0, _, _ => 0
  | k + 1, p, n => if p = 2190 then n else ordAuxK m k (mulK p m) (n + 1)

@[expose] def ordK (m : ℕ) : ℕ := ordAuxK m 16 m 1

@[expose] def centK (m : ℕ) : List ℕ := codes.filter fun n => mulK m n == mulK n m

@[expose] def chkSqOneK : Bool :=
  codes.all fun m => impB (mulK m m == 2190) (m == 2190 || m == 4380)

@[expose] def chkCenterK : Bool :=
  codes.all fun m => impB (codes.all fun n => mulK m n == mulK n m) (m == 2190 || m == 4380)

@[expose] def chkQ8K : Bool :=
  codes.all fun p => impB (mulK p p == 4380) <|
    codes.all fun q => impB (mulK q q == 4380) <| impB (mulK q p == mulK (mulK p 4380) q) <|
      codes.any fun r => (mulK r p == mulK q r || mulK r p == mulK (mulK q 4380) r) &&
        (mulK r q == mulK (mulK p q) r || mulK r q == mulK (mulK (mulK p q) 4380) r)

@[expose] def chkConjFixed5K : Bool :=
  codes.all fun m => impB (ordK m == 5) <|
    codes.any fun k => sigK (mulK (mulK k m) (invK k)) == mulK (mulK k m) (invK k)

@[expose] def chkCent5K : Bool :=
  codes.all fun m => impB (ordK m == 5) ((centK m).length == 10)

@[expose] def chkCent3K : Bool :=
  codes.all fun m => impB (ordK m == 3) ((centK m).length == 18)

@[expose] def chkCentOdd5K : Bool :=
  codes.all fun m => impB (ordK m == 5) <|
    (centK m).all fun n => ordK n % 2 == 0 || n == 2190 || n == m || n == mulK m m ||
      n == mulK (mulK m m) m || n == mulK (mulK (mulK m m) m) m

@[expose] def chkCentOdd3K : Bool :=
  codes.all fun m => impB (ordK m == 3) <|
    (centK m).all fun n => ordK n % 2 == 0 || ordK n == 1 || ordK n == 3

@[expose] def chkSigmaNotConjK : Bool :=
  codes.all fun m => impB (ordK m == 3) <|
    codes.all fun k => !(mulK k (sigK m) == mulK m k)

@[expose] def chkInvert3K : Bool :=
  codes.all fun m => impB (ordK m == 3) <|
    codes.any fun k => mulK k k == 4380 && mulK k m == mulK (invK m) k

@[expose] def chkNo16K : Bool := codes.all fun m => !(ordK m == 16)

@[expose] def chkQ16K : Bool :=
  codes.all fun s => impB (q16K s) <|
    impB (codes.all fun w => impB (q16K w) (mulK s w == mulK w s)) (s == 2190 || s == 4380)

@[expose] def chkQ16cardK : Bool := (codes.filter q16K).length == 16

