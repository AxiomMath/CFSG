@[expose] def wordAct (w : List Nat) (v : Nat) : Nat := w.foldl (fun v g => Cover.cvImg gens g v) v

@[expose] def frameWord (w : List Nat) (v : Nat) : Nat :=
  w.foldl (fun v g => Cover.actRows (CFSG.Monster.VisCert.Native.frameRows ())[g]! v) v

