@[expose] def frameWordOK (j : Nat) : Bool :=
  (words.getD j []).all (· < 2) && (List.range 24).all fun i =>
    wordAct (words.getD j []) (2 ^ i) ==
      Cover.actRows (CFSG.Monster.VisCert.Native.frameRows ())[j + 1]! (2 ^ i)

@[expose] def frameGensOK : Bool :=
  (List.range 24).all fun i =>
    Cover.actRows gen0.toArray (2 ^ i) == frameWord [1, 2, 3] (2 ^ i) &&
      Cover.actRows gen1.toArray (2 ^ i) == frameWord [2, 3] (2 ^ i)

@[expose] def frameWordsOK : Bool := (List.range 14).all frameWordOK && frameGensOK

