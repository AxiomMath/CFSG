@[expose] noncomputable def letN (y : Nat) (k : Nat → Nat) : Nat :=
  Nat.rec (motive := fun _ => Nat) (k 0) (fun n _ => k (Nat.succ n)) y

@[expose] noncomputable def letB (y : Nat) (k : Nat → Bool) : Bool :=
  Nat.rec (motive := fun _ => Bool) (k 0) (fun n _ => k (Nat.succ n)) y

@[expose] noncomputable def fld (x o m : Nat) : Nat :=
  Nat.land (Nat.shiftRight x o) (Nat.sub (Nat.shiftLeft 1 m) 1)

@[expose] noncomputable def codeL (m : List Nat) : Nat :=
  List.rec (motive := fun _ => Nat) 0 (fun r _ ih => Nat.lor r (Nat.shiftLeft ih 3)) m

@[expose] noncomputable def codeP (A : Array Nat) : Nat := codeL A.toList

@[expose] def lowM : Nat := 139079380139325740049924008818395

@[expose] def highM : Nat := 185439173519100986733232011757860

@[expose] noncomputable def mxL (l h : Nat) : Nat :=
  Nat.xor (Nat.shiftLeft l 1) (Nat.xor (Nat.shiftRight h 2) (Nat.shiftRight h 1))

@[expose] noncomputable def mx (r : Nat) : Nat := mxL (Nat.land r lowM) (Nat.land r highM)

@[expose] noncomputable def sel (a p v : Nat) : Nat :=
  Bool.rec (motive := fun _ => Nat) 0 v (Nat.blt 0 (Nat.land a (Nat.shiftLeft 1 p)))

@[expose] noncomputable def rowP (a b0 b1 b2 i : Nat) : Nat :=
  Nat.rec (motive := fun _ => Nat) 0
    (fun k acc => Nat.xor acc
      (Nat.xor (sel a (Nat.add (Nat.mul 18 i) (Nat.mul 3 k)) (fld b0 (Nat.mul 18 k) 18))
        (Nat.xor (sel a (Nat.add (Nat.add (Nat.mul 18 i) (Nat.mul 3 k)) 1) (fld b1 (Nat.mul 18 k) 18))
          (sel a (Nat.add (Nat.add (Nat.mul 18 i) (Nat.mul 3 k)) 2) (fld b2 (Nat.mul 18 k) 18))))) 6

@[expose] noncomputable def mulQ (a b0 b1 b2 : Nat) : Nat :=
  Nat.rec (motive := fun _ => Nat) 0
    (fun i acc => Nat.lor acc (Nat.shiftLeft (rowP a b0 b1 b2 i) (Nat.mul 18 i))) 6

@[expose] noncomputable def mulP (a b : Nat) : Nat :=
  letN a fun a => letN b fun b => letN (mx b) fun b1 => letN (mx b1) fun b2 => mulQ a b b1 b2

@[expose] def idP : Nat := 40564838550125678058396201254913

@[expose] def letterTab : Nat :=
  

@[expose] noncomputable def letterP (n : Nat) : Nat := fld letterTab (Nat.mul 108 (Nat.mod n 96)) 108

@[expose] noncomputable def wordP (w : List Nat) : Nat := w.foldl (fun A n => mulP A (letterP n)) idP

@[expose] noncomputable def powP (A : Nat) (k : Nat) : Nat :=
  Nat.rec (motive := fun _ => Nat) idP (fun _ acc => mulP acc A) k

@[expose] noncomputable def genOKP (u z : Nat) (gw : List (List Nat)) (tn : List Nat)
    (ts : List (List Nat)) : Bool :=
  !(Nat.beq u idP) && !(Nat.beq z idP) && Nat.beq gw.length 30 &&
  (List.range 14).all (fun k => letB (wordP (gw.getD k [])) fun g =>
    Nat.beq (mulP g z) (mulP z g)) &&
  (List.range 16).all (fun k => letB (wordP (gw.getD (14 + k) [])) fun g =>
    Nat.beq (mulP g u) (mulP u g)) &&
  Nat.beq tn.length ts.length &&
  (List.range ts.length).all fun m => (ts.getD m []).all (fun i => Nat.blt i 30) &&
    Nat.beq (wordP ((ts.getD m []).flatMap fun i => gw.getD i [])) (letterP (tn.getD m 0))

