@[expose] def HS08DRecOK (R : List (Nat × Nat)) : Prop :=
  ∀ i : Fin 15, ∀ k : Fin 9,
    (R.getD (9 * i.val + k.val) (0, 0)).1 < 256 ∧ (R.getD (9 * i.val + k.val) (0, 0)).2 < 15 ∧
    tmul (dReps.getD i.val []) (dGens.getD k.val []) =
      tmul (s0Tabs.getD (R.getD (9 * i.val + k.val) (0, 0)).1 [])
        (dReps.getD (R.getD (9 * i.val + k.val) (0, 0)).2 [])

instance (R : List (Nat × Nat)) : Decidable (HS08DRecOK R) := by
  unfold HS08DRecOK
  infer_instance

@[expose] def hs08DKey (t : Tab) : Nat := CFSG.Decide.listKey 22 [0, 1, 2, 3] t

