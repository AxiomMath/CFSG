@[expose] noncomputable def twAt (c j : Nat) : Nat :=
  bif Nat.beq (Nat.land (Nat.shiftRight c j) 1) 1 then mulP K0P (nthD 0 CBP j) else nthD 0 CBP j

@[expose] noncomputable def twG (c : Nat) : List Nat :=
  [twAt c 0, twAt c 1, twAt c 2, twAt c 3, twAt c 4]

@[expose] noncomputable def mapD (g : Nat) : Bool :=
  List.rec (motive := fun _ => Bool) true (fun d _ ih => memN (ap12 g d) SD0 && ih)
    CFSG.GF2Type.Smith1979.GammaU.StepA.d0

@[expose] noncomputable def clsAt (TH c i v vi : Nat) (ms ns : List Nat) : Bool :=
  Nat.blt i 2 && Nat.beq (mulP v vi) idP && guOK TH v && Nat.beq (ap12 v 3072) 3072 && mapD v &&
    mapD vi && cjOK v vi (twG c) (twG i) ms && cjOK vi v (twG i) (twG c) ns

@[expose] noncomputable def clsRec (TH c : Nat) (e : List Nat) : Bool :=
  clsAt TH c (nthD 0 e 0) (nthD 0 e 1) (nthD 0 e 2) (takeN 5 (dropN 3 e)) (dropN 8 e)

@[expose] noncomputable def clsBlk (TH : Nat) (E : List (List Nat)) (b : Nat) : Bool :=
  allBelow 8 fun k => clsRec TH (Nat.add (Nat.mul 8 b) k) (nthD [] E (Nat.add (Nat.mul 8 b) k))

