@[expose] def tf (t : Tab) (i : Fin 22) : Fin 22 := Fin.ofNat 22 (t.getD i.val 0)

@[expose] def xsL : List Tab :=
  [[3, 1, 2, 0, 15, 9, 6, 12, 18, 5, 19, 11, 7, 13, 20, 4, 16, 21, 8, 10, 14, 17],
   [4, 1, 2, 15, 0, 18, 6, 10, 9, 8, 7, 11, 19, 13, 17, 3, 16, 14, 5, 12, 21, 20],
   [5, 1, 2, 9, 18, 0, 6, 14, 15, 3, 17, 11, 20, 13, 7, 8, 16, 10, 4, 21, 12, 19],
   [7, 1, 2, 12, 10, 14, 6, 0, 21, 20, 4, 11, 3, 13, 5, 19, 16, 18, 17, 15, 9, 8]]

@[expose] def xf (k : Nat) : Fin 22 → Fin 22 := tf (xsL.getD k [])

@[expose] def pw (b : Bool) (f : Fin 22 → Fin 22) (i : Fin 22) : Fin 22 := if b then f i else i

@[expose] def fe (e : Nat) (i : Fin 22) : Fin 22 :=
  pw (e.testBit 0) (xf 0) (pw (e.testBit 1) (xf 1) (pw (e.testBit 2) (xf 2)
    (pw (e.testBit 3) (xf 3) i)))

