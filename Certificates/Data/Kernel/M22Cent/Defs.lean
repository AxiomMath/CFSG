@[expose] def presB (f : Fin 22 → Fin 22) : Bool :=
  hexads.all fun B => hexads.any fun B' => B.all fun i => B'.contains (f i)

@[expose] def mv (c : Fin 22) : Bool := xf 0 c != c

@[expose] def uniqB (B : List (Fin 22)) : Bool :=
  hexads.all fun B' => !(B.all fun c => !mv c || B'.contains c) || B' == B

@[expose] def witL : List (Fin 22 × List (Fin 22) × List (Fin 22)) :=
  [(1, [0, 1, 2, 9, 17, 19], [0, 1, 3, 6, 14, 20]), (2, [0, 1, 2, 9, 17, 19], [0, 2, 3, 7, 12, 13]),
   (6, [0, 1, 3, 6, 14, 20], [0, 2, 5, 6, 8, 15]),
   (11, [0, 1, 10, 11, 12, 15], [0, 2, 4, 11, 20, 21]),
   (13, [0, 1, 4, 5, 13, 18], [0, 2, 3, 7, 12, 13]),
   (16, [0, 1, 7, 8, 16, 21], [0, 2, 10, 14, 16, 18])]

@[expose] def witB (p : Fin 22) (B₁ B₂ : List (Fin 22)) : Bool :=
  hexads.contains B₁ && hexads.contains B₂ && uniqB B₁ && uniqB B₂ && B₁.contains p &&
    B₂.contains p && B₁.all fun q => !B₂.contains q || q == p || mv q

