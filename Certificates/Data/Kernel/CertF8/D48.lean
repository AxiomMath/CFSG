@[expose] def oneQ : Nat × Nat := (oneK, 0)

@[expose] def eqQ (p q : Nat × Nat) : Bool := Nat.beq p.1 q.1 && Nat.beq p.2 q.2

@[expose] def symQ (s : Nat) : Nat × Nat := if s < 24 then (letK.getD s oneK, 0) else (oneK, 1)

@[expose] noncomputable def wordQ (w : List Nat) : Nat × Nat :=
  w.foldr (fun s p => mulPr (symQ s) p) oneQ

@[expose] noncomputable def powQ (p : Nat × Nat) (n : Nat) : Nat × Nat :=
  Nat.rec (motive := fun _ => Nat × Nat) oneQ (fun _ acc => mulPr p acc) n

@[expose] noncomputable def ePQ (i : Nat) : Nat × Nat := wordQ (d48E.getD i [])

@[expose] noncomputable def hypXQ (e0 e1 : Nat × Nat) (h : Nat) : Nat × Nat :=
  if h = 0 ∨ h = 1 then e0 else if h = 2 then e1 else if h = 3 then mulPr e0 e1
  else mulPr e0 (powQ e1 2)

@[expose] def hypYQ (e1 e2 : Nat × Nat) (h : Nat) : Nat × Nat := if h = 0 then e1 else e2

@[expose] noncomputable def chkEQ (e0 e1 e2 : Nat × Nat) : Bool :=
  eqQ (powQ e0 3) oneQ && eqQ (powQ e1 3) oneQ && eqQ (powQ e2 3) oneQ &&
    eqQ (mulPr e0 e1) (mulPr e1 e0) && eqQ (mulPr e0 e2) (mulPr e2 e0) &&
    eqQ (mulPr e1 e2) (mulPr e2 e1) &&
    (List.range 3).all fun a => (List.range 3).all fun b => (List.range 3).all fun c =>
      (a == 0 && b == 0 && c == 0) ||
        !eqQ (mulPr (mulPr (powQ e0 a) (powQ e1 b)) (powQ e2 c)) oneQ

@[expose] noncomputable def hypChkQ (x y : Nat × Nat) : Bool :=
  eqQ (powQ x 3) oneQ && eqQ (powQ y 3) oneQ && eqQ (mulPr x y) (mulPr y x) &&
    (List.range 3).all fun a => (List.range 3).all fun b =>
      (a == 0 && b == 0) || !eqQ (mulPr (powQ x a) (powQ y b)) oneQ

@[expose] noncomputable def chkHypQ (e0 e1 e2 : Nat × Nat) : Bool :=
  (List.range 5).all fun h =>
    letQ (hypXQ e0 e1 h) fun x => letQ (hypYQ e1 e2 h) fun y => hypChkQ x y

@[expose] noncomputable def nChkQ (n ni x y : Nat × Nat) : Bool :=
  eqQ (mulPr n ni) oneQ && [x, y].all fun g =>
    (List.range 3).any fun s => (List.range 3).any fun t =>
      eqQ (mulPr (mulPr n g) ni) (mulPr (powQ x s) (powQ y t))

@[expose] noncomputable def chkNQ (e0 e1 e2 : Nat × Nat) : Bool :=
  (List.range numN).all fun j =>
    letQ (wordQ (nWord j)) fun n => letQ (wordQ (invWord (nWord j))) fun ni =>
      letQ (hypXQ e0 e1 (nHyp j)) fun x => letQ (hypYQ e1 e2 (nHyp j)) fun y => nChkQ n ni x y

@[expose] noncomputable def d48EQ : Bool :=
  letQ (ePQ 0) fun e0 => letQ (ePQ 1) fun e1 => letQ (ePQ 2) fun e2 => chkEQ e0 e1 e2

@[expose] noncomputable def d48HypQ : Bool :=
  letQ (ePQ 0) fun e0 => letQ (ePQ 1) fun e1 => letQ (ePQ 2) fun e2 => chkHypQ e0 e1 e2

@[expose] noncomputable def d48NQ : Bool :=
  letQ (ePQ 0) fun e0 => letQ (ePQ 1) fun e1 => letQ (ePQ 2) fun e2 => chkNQ e0 e1 e2

@[expose] noncomputable def nListQ : List (Nat × Nat) := (List.range numN).map fun j => wordQ (nWord j)

@[expose] noncomputable def nInvListQ : List (Nat × Nat) :=
  (List.range numN).map fun j => wordQ (invWord (nWord j))

@[expose] noncomputable def slpEltQ (i : Nat) : Nat × Nat :=
  if i < 2 * numN then
    (if i % 2 = 0 then nListQ.getD (i / 2) oneQ else nInvListQ.getD (i / 2) oneQ)
  else (letK.getD (i - 2 * numN) oneK, 0)

@[expose] noncomputable def slpPQ (ids : List Nat) : Nat × Nat :=
  ids.foldl (fun acc i => mulPr acc (slpEltQ i)) oneQ

@[expose] noncomputable def d48SlpQ : Bool :=
  d48Slp1.all (fun x => eqQ (slpPQ x.2) (letK.getD x.1 oneK, 0)) &&
    d48Slp2.all (fun x => eqQ (slpPQ x.2) (letK.getD x.1 oneK, 0))

