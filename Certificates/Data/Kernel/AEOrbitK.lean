@[expose] def kchkM (m : ℕ) (CT : List (List ℕ)) (n : ℕ) : Bool :=
  (masks4 m).all fun a => (masks4 m).all fun b => a == b ||
    (masks4 m).all fun c => decide (c ∈ (reachM (movesT CT a ++ movesT CT b) a n).1)

