@[expose] def tab {m : ℕ} (σ : Equiv.Perm (Fin m)) : List ℕ :=
  (List.finRange m).map fun i => (σ i : ℕ)

@[expose] def imgM : List ℕ → ℕ → ℕ
  | [], _ => 0
  | a :: t, M => (if M % 2 = 1 then 2 ^ a else 0) ||| imgM t (M / 2)

@[expose] def movesT (CT : List (List ℕ)) (a : ℕ) : List (List ℕ) :=
  CT.filter fun t => imgM t a == a

@[expose] def addM (L : List (List ℕ)) (st : List ℕ × List ℕ) (x : ℕ) : List ℕ × List ℕ :=
  L.foldl (fun st t => if imgM t x ∈ st.1 then st else (imgM t x :: st.1, imgM t x :: st.2)) st

@[expose] def growM (L : List (List ℕ)) (st : List ℕ × List ℕ) : List ℕ × List ℕ :=
  st.2.foldl (addM L) (st.1, [])

@[expose] def reachM (L : List (List ℕ)) (a n : ℕ) : List ℕ × List ℕ :=
  Nat.rec ([a], [a]) (fun _ st => growM L st) n

@[expose] def dec (m M : ℕ) : Finset (Fin m) := Finset.univ.filter fun i => M.testBit i

@[expose] def masks4 (m : ℕ) : List ℕ :=
  ((List.range m).sublistsLen 4).map fun l => (l.map (2 ^ ·)).sum

