module

public import Certificates.Data.Kernel.M24Dc.Defs

public noncomputable section

namespace CFSG.KD.M24Dc

open CFSG.KC.SLDc CFSG.KC.LQT.PW

@[expose] def Lk : List Nat := [
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ]

@[expose] def LkOK : Bool :=
  (List.range 10).all fun l => (List.range 576).all fun p => imgW 10 (Lk.getD l 0) p == L l p

theorem Lk_ok : LkOK = true := by decide +kernel

@[expose] def LF (l p : Nat) : Nat :=
  bif Nat.blt l 10 && Nat.blt p 576 then imgW 10 (Lk.getD l 0) p else L l p

theorem LF_eq : LF = L := by
  funext l p
  unfold LF
  cases h : (Nat.blt l 10 && Nat.blt p 576) with
  | false => rfl
  | true =>
    rw [Bool.and_eq_true, Nat.blt_eq, Nat.blt_eq] at h
    have hk := Lk_ok
    unfold LkOK at hk
    rw [List.all_eq_true] at hk
    have hl := hk l (List.mem_range.2 h.1)
    rw [List.all_eq_true] at hl
    exact beq_iff_eq.1 (hl p (List.mem_range.2 h.2))

@[expose] def CF : DcCtx := ⟨576, J.delta, LF, 8, 4, 10, 239085⟩

theorem C_eq : C = CF := by
  rw [C, CF, LF_eq]

end CFSG.KD.M24Dc

end
