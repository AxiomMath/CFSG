@[expose] def fd6 (r i : Nat) : Nat := Nat.land (Nat.shiftRight r (Nat.mul 6 i)) 63

@[expose] def T (j i : Nat) : Nat := fd6 (rowsT.getD j 0) i

@[expose] def allB (P : Nat → Bool) : Bool := (List.range 45).all P

@[expose] def pinB : Bool :=
  (List.finRange 45).all fun j => (List.finRange 45).all fun i =>
    Nat.beq (tauFun j i).val (T j.val i.val)

@[expose] def pinYB : Bool := (List.finRange 45).all fun i => Nat.beq (y45 i).val (fd6 yRow i.val)

@[expose] def conjT (g : Nat → Nat) : Bool :=
  allB fun j => allB fun i => Nat.beq (g (T j i)) (T (g j) (g i))

@[expose] def idT (f : Nat → Nat) : Bool := allB fun i => Nat.beq (f i) i

@[expose] def ord3T : Bool :=
  allB fun j => idT (fun i => T 0 (T j i)) || idT (fun i => T 0 (T j (T 0 (T j i)))) ||
    idT (fun i => T 0 (T j (T 0 (T j (T 0 (T j i))))))

@[expose] def movesT : Bool := (List.range 45).any fun i => !Nat.beq (T 0 i) i

