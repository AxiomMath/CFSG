@[expose] def graft (G T : Nat) : Nat :=
  Nat.add (Nat.land G (2 ^ 2368 - 1)) (Nat.shiftLeft (Nat.shiftRight T 2368) 2368)

@[expose] def schT1 : List (Nat × List Nat) := sch.take 6

@[expose] def schT2 : List (Nat × List Nat) := (sch.drop 6).take 15

@[expose] def schT3 : List (Nat × List Nat) := (sch.drop 21).take 20

@[expose] def schT4 : List (Nat × List Nat) := sch.drop 41

@[expose] def rOKE6 (p a : Nat) : Bool := wkRho.all fun b => Nat.blt (lane p (lane a b)) 72

@[expose] def okVT (RT p T3 a3 v : Nat) : Bool :=
  (lane v 0 == lane a3 0 && lane v 2 == lane a3 2 && lane v 3 == lane a3 3) &&
    okD (absK (lnT (stepS (graft (tabA RT p v) T3) schT4) 135))

@[expose] def chkTr (RT p : Nat) (g1 : List (List (List Nat))) : Bool :=
  letN (((g1.headD []).headD []).headD 0) fun a1 =>
  rOKE6 p a1 && letN (stepS (tabA RT p a1) schT1) fun T1 =>
  g1.all fun g2 => letN ((g2.headD []).headD 0) fun a2 =>
    (lane a2 0 == lane a1 0 && rOKE6 p a2) &&
    letN (stepS (graft (tabA RT p a2) T1) schT2) fun T2 =>
    g2.all fun g3 => letN (g3.headD 0) fun a3 =>
      (lane a3 0 == lane a2 0 && lane a3 2 == lane a2 2 && rOKE6 p a3) &&
      letN (stepS (graft (tabA RT p a3) T2) schT3) fun T3 =>
      g3.all fun v => okVT RT p T3 a3 v

@[expose] def chkAtT (RT : Nat) (up : List Nat) (vt : List (List (List (List Nat)))) (i : Nat) :
    Bool :=
  letN RT fun RT => letN (up.getD (i / 16) 0) fun p => chkTr RT p (vt.getD (i % 16) [])

@[expose] def memVT (c : Nat) (vt : List (List (List (List Nat)))) : Bool :=
  vt.any fun g1 => lane (((g1.headD []).headD []).headD 0) 0 == lane c 0 &&
    g1.any fun g2 => lane ((g2.headD []).headD 0) 2 == lane c 2 && g2.any fun g3 => g3.contains c

@[expose] def covVT (vk : List Nat) (vt : List (List (List (List Nat)))) : Bool :=
  vk.all fun c => memVT c vt

