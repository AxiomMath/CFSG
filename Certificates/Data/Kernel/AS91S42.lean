@[expose] def wordP (L w : List ℕ) : ℕ := (w.map fun i => L.getD i oneQ).foldr mulQ oneQ

@[expose] def sqQ (x : ℕ) : ℕ := mulQ x x

@[expose] def pow256Q (x : ℕ) : ℕ := sqQ (sqQ (sqQ (sqQ (sqQ (sqQ (sqQ (sqQ x)))))))

@[expose] def bnd : ℕ := nat_lit 22300745198530623141535718272648361505980416

@[expose] def pairsOK (G : List (ℕ × ℕ)) : Bool :=
  G.all fun p => Nat.blt p.1 bnd && Nat.blt p.2 bnd && invOKQ p.1 p.2

@[expose] def closedS (gs X : List ℕ) (S : NT ℕ) : Bool :=
  X.all fun x => gs.all fun g => memP S (mulQ x g)

@[expose] def twoTest (W : List (ℕ × ℕ)) (Ps : NT ℕ) (x : ℕ) : Bool :=
  !Nat.beq (pow256Q x) oneQ || memP Ps x ||
    W.any fun w => !Nat.beq (pow256Q (mulQ x (mulQ w.1 (mulQ x w.2)))) oneQ

@[expose] def stabCore (v : ℕ) (G Pp W : List (ℕ × ℕ)) (X P : List ℕ) (Xs Ps : NT ℕ)
    (nS nP : ℕ) : Bool :=
  pairsOK G && pairsOK Pp && pairsOK W &&
    G.all (fun p => Nat.beq (mvNR (unpackQ p.1) v) v) &&
    memP Xs oneQ && closedS (G.map Prod.fst) X Xs && nodupP X && Nat.beq X.length nS &&
    memP Ps oneQ && closedS (Pp.map Prod.fst) P Ps && nodupP P && Nat.beq P.length nP &&
    Pp.all (fun p => memP Xs p.1) &&
    G.all (fun t => Pp.all fun p => memP Ps (mulQ t.1 (mulQ p.1 t.2))) &&
    W.all (fun w => memP Xs w.1) &&
    X.all (twoTest W Ps)

@[expose] def stabAt (v : ℕ) (G Pp W : List (ℕ × ℕ)) (X P : List ℕ) (nS nP : ℕ) : Bool :=
  stabCore v G Pp W X P (ofListP X) (ofListP P) nS nP

@[expose] def stabQ (v : ℕ) (G Pp W : List (ℕ × ℕ)) (nS nP : ℕ) : Bool :=
  stabAt v G Pp W (enumQ (G.map Prod.fst)) (enumQ (Pp.map Prod.fst)) nS nP

