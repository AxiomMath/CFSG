@[expose] noncomputable def cmK (j i : Nat) : Nat :=
  Nat.land (Nat.shiftRight cmP (Nat.mul (nat_lit 25) (Nat.add (Nat.mul (nat_lit 25) j) i)))
    (nat_lit 33554431)

@[expose] noncomputable def lowK (m : Nat) : Nat :=
  Nat.log2 (Nat.land m (Nat.xor m (Nat.sub m (nat_lit 1))))

@[expose] noncomputable def dropK (m : Nat) : Nat := Nat.land m (Nat.sub m (nat_lit 1))

@[expose] noncomputable def mwLoop (g : Nat → Nat → Nat) (f : Nat) : Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat) (fun E _ => E)
    (fun _ ih E w => nIf(Nat.beq w (nat_lit 0), E,
      strictN (g E (lowK w)) fun E' => ih E' (dropK w))) f

@[expose] noncomputable def mwR (g : Nat → Nat → Nat) (E w : Nat) : Nat := mwLoop g w E w

@[expose] noncomputable def tlLoop (cm : Nat → Nat → Nat) (g : Nat → Nat → Nat) (i f : Nat) :
    Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat) (fun r _ => r)
    (fun _ ih r t => nIf(Nat.beq t (nat_lit 0), r,
      strictN (mwR g (g r (lowK t)) (cm (lowK t) i)) fun r' => ih r' (dropK t))) f

@[expose] noncomputable def tlR (cm : Nat → Nat → Nat) (g : Nat → Nat → Nat) (i r t : Nat) : Nat :=
  tlLoop cm g i t r t

@[expose] noncomputable def mgR (cm : Nat → Nat → Nat) (f : Nat) : Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat) (fun E _ => E)
    (fun _ ih E i => tlR cm ih i
      (Nat.lor (Nat.mod E (Nat.pow (nat_lit 2) i))
        (Nat.land (Nat.xor E (Nat.pow (nat_lit 2) i)) (Nat.pow (nat_lit 2) i)))
      (Nat.shiftLeft (Nat.shiftRight E (Nat.succ i)) (Nat.succ i))) f

@[expose] noncomputable def mulR (E F : Nat) : Nat := mwR (mgR cmK (nat_lit 25)) E F

@[expose] noncomputable def invLoop (cm : Nat → Nat → Nat) (n f : Nat) : Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat) (fun _ => nat_lit 0)
    (fun _ ih E => nIf(Nat.beq E (nat_lit 0), nat_lit 0,
      strictN (ih (dropK E)) fun x => mgR cm n x (lowK E))) f

@[expose] noncomputable def invG (cm : Nat → Nat → Nat) (n E : Nat) : Nat := invLoop cm n E E

