@[expose] def dtl (a b c d : Fin 8) : List (Perm (Fin 8)) :=
  [swap a b * swap c d, swap a c * swap b d, swap a d * swap b c]

@[expose] def maskF (s : Finset (Fin 8)) : ℕ := ∑ x ∈ s, 2 ^ (x : ℕ)

@[expose] def m4 (a b c d : Fin 8) : ℕ :=
  Nat.add (Nat.pow 2 a.val) (Nat.add (Nat.pow 2 b.val) (Nat.add (Nat.pow 2 c.val)
    (Nat.pow 2 d.val)))

