@[expose] def sixL : List (Fin 8 × Fin 8 × Fin 8 × Fin 8) :=
  [(0, 1, 2, 3), (4, 5, 6, 7), (0, 1, 4, 5), (2, 3, 6, 7), (2, 3, 4, 5), (0, 1, 6, 7)]

@[expose] def q4 (q : Fin 8 × Fin 8 × Fin 8 × Fin 8) : Finset (Fin 8) :=
  {q.1, q.2.1, q.2.2.1, q.2.2.2}

@[expose] def RowOK (e : List (Fin 8) × ℕ × List (Fin 8 × Fin 8)) : Prop :=
  e.2.1 < 6 ∧ inS0 (swapsPerm e.2.2) = true ∧ codeOf ((swapsPerm e.2.2)⁻¹ * tau e.2.1) = e.1

instance (e : List (Fin 8) × ℕ × List (Fin 8 × Fin 8)) : Decidable (RowOK e) := by
  unfold RowOK; infer_instance

@[expose] def sixB (a b c d : Fin 8) : Bool :=
  decide (a < b) && decide (b < c) && decide (c < d) && inS0 (swap a b * swap c d) &&
    inS0 (swap a c * swap b d) && inS0 (swap a d * swap b c)

@[expose] def meets2 (a b c d : Fin 8) : Bool :=
  decide ((({0, 1, 2, 3} : Finset (Fin 8)) ∩ {a, b, c, d}).card = 2)

@[expose] def inC (c : List (Fin 8)) (T : List (List (Fin 8))) : Bool :=
  T.any fun x => decide (x = c)

@[expose] def inN (m : ℕ) (M : List ℕ) : Bool := M.any fun y => Nat.beq y m

@[expose] def allIn (T : List (List (Fin 8))) (a b c d : Fin 8) : Bool :=
  inC (codeOf (swap a b * swap c d)) T && inC (codeOf (swap a c * swap b d)) T &&
    inC (codeOf (swap a d * swap b c)) T

@[expose] def quadB (a b c d : Fin 8) : Bool :=
  inN (m4 a b c d) tab1M && (!meets2 a b c d || inN (m4 a b c d) tab2M) &&
    (!allIn t0L a b c d || inN (m4 a b c d) affM) && (!allIn t1L a b c d || inN (m4 a b c d) p2M)

@[expose] def ptabB (T : List (List (Fin 8))) (e : Finset (Fin 8) × List (Fin 8 × Fin 8)) :
    Bool :=
  decide (Perm.sign (swapsPerm e.2) = 1) && inC (codeOf (swapsPerm e.2)) T &&
    decide (d0.map (swapsPerm e.2).toEmbedding = e.1)

