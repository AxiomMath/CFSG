@[expose] def shiftW (k : Nat) (w : List (Nat × Bool)) : List (Nat × Bool) :=
  w.map fun x => (x.1 + k, x.2)

@[expose] def wordAt (ws : List (List (Nat × Bool))) (i : Nat) : List (Nat × Bool) := ws.getD i []

@[expose] def rels : List (List (Nat × Bool)) :=
  ((List.range 7).map fun k => wordAt imgWords k ++ [(k + 2, false)]) ++
    ((List.range 2).map fun j => shiftW 2 (wordAt surjWords j) ++ [(j, false)]) ++
      suzRels.map (shiftW 2)

