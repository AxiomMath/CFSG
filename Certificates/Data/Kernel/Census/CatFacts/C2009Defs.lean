@[expose] def cA1 : CA where
  __ := cA0
  lQQ := mkLv lQQN
  lQH := mkLv lQHN
  lQR := mkLv lQRN
  lQE := mkLv lQEN
  lQP := mkLv lQPN
  tA := tAL
  tP := (mkLv lQPN).map fun l => transV l.2

@[expose] def forceA1 {β : Sort _} (k : CA → β) : β :=
  forceL cA1.q0 fun q0 => forceL cA1.h fun h => forceL cA1.e fun e => forceV cA1.g0i fun g0i =>
  forceLv cA1.lQQ fun lQQ => forceLv cA1.lQH fun lQH => forceLv cA1.lQR fun lQR =>
  forceLv cA1.lQE fun lQE => forceLL cA1.tA fun tA =>
    k { cA1 with q0, h, e, g0i, lQQ, lQH, lQR, lQE, tA }

@[expose] def forceA2 {β : Sort _} (k : CA → β) : β :=
  forceLL cA1.cls1 fun cls1 => forceLL cA1.cls2 fun cls2 => forceLv cA1.lQP fun lQP =>
  forceLL cA1.tA fun tA => k { cA1 with cls1, cls2, lQP, tA }

@[expose] def forceIC {β : Sort _} (k : CA → β) : β :=
  forceLL cA1.icls1 fun icls1 => forceLL cA1.icls2 fun icls2 => k { cA1 with icls1, icls2 }

@[expose] def pA1 (C : CA) (w : List V45) : Bool :=
  (!(C.q0.all fun q => siftW C.lQQ (conjW w q)) || siftW C.lQQ w || siftW C.lQQ (C.g0i :: w)) &&
    (!(C.h.all fun h => siftW C.lQH (conjW w h)) || siftW C.lQR w) &&
    (!(C.e.all fun e => eqW (e :: w) (w ++ [e])) || siftW C.lQE w)

@[expose] def pA2 (C : CA) (w : List V45) : Bool :=
  !isOneW (w ++ w) || siftW C.lQP w || memW w C.cls1 || memW w C.cls2

@[expose] def chunkA (j : Nat) : Bool := forceA1 fun C => (blockW C.tA j).all (pA1 C)

@[expose] def chunkI (j : Nat) : Bool := forceA2 fun C => (blockW C.tA j).all (pA2 C)

