@[expose] def keyV45 (a : V45) : Nat :=
  ((List.range 45).map fun i => imgW [a] i).foldr (fun d acc => acc * 64 + d) 0

@[expose] def clOK45 (S O : List V45) (cl : List (List Nat)) : Bool :=
  (List.range O.length).all fun i => (List.range S.length).all fun k =>
    Nat.blt ((cl.getD i []).getD k 0) O.length &&
      eqW [invV (S.getD k (oneV 45)), O.getD i (oneV 45), S.getD k (oneV 45)]
        [O.getD ((cl.getD i []).getD k 0) (oneV 45)]

@[expose] def trOK45 (n m : Nat) (cl : List (List Nat)) (tr : List (Nat × Nat)) : Bool :=
  (List.range n).all fun i => Nat.beq i 0 ||
    (Nat.blt (tr.getD i (0, 0)).1 i && Nat.blt (tr.getD i (0, 0)).2 m &&
      Nat.beq ((cl.getD (tr.getD i (0, 0)).1 []).getD (tr.getD i (0, 0)).2 0) i)

@[expose] def orbOK45 (S O : List V45) (cl : List (List Nat)) (tr : List (Nat × Nat))
    (K : List Nat) (x : V45) : Bool :=
  Nat.blt 0 O.length && eqW [x] [O.getD 0 (oneV 45)] && clOK45 S O cl &&
    trOK45 O.length S.length cl tr && O.map keyV45 == K

