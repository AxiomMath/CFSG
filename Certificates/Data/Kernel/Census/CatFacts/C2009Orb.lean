@[expose] def OrbCertL {G : Type*} [Group G] (S : List G) (x : G) (O : List G) : Prop :=
  O.Nodup ∧ 0 < O.length ∧ O.getD 0 1 = x ∧ (∀ o ∈ O, ∀ g ∈ S, g⁻¹ * o * g ∈ O) ∧
    ∀ i < O.length, 0 < i → ∃ p < i, ∃ g ∈ S, O.getD i 1 = g⁻¹ * O.getD p 1 * g

