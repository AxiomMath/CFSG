@[expose] noncomputable def blkC (X b : Nat) : Nat := (X >>> (400 * b)) % 2 ^ 400

@[expose] noncomputable def gathC (Bpk : Nat) (n : Nat) : Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat) (fun _ => 0)
    (fun _ ih r => blkC Bpk (r % 1024) + (ih (r >>> 10) <<< 400)) n

@[expose] noncomputable def fldsC (n : Nat) : Nat → Bool :=
  Nat.rec (motive := fun _ => Nat → Bool) (fun r => r == 0)
    (fun _ ih r => decide (r % 1024 < 693) && ih (r >>> 10)) n

@[expose] noncomputable def rowC (ONE REP ID Bpk : Nat) (Qs : List Nat) (A : List Nat)
    (Ap Rj : Nat) : Bool :=
  lmulP ONE A Ap == ID && fldsC 693 Rj &&
    lmulP ONE A (bmulP ONE Qs (REP * Ap)) == gathC Bpk 693 Rj

@[expose] noncomputable def rowsC (ONE REP ID Bpk : Nat) (Qs : List Nat) (R : Nat → Nat) :
    List (List Nat) → List Nat → Nat → Bool :=
  fun Cr => List.rec (motive := fun _ => List Nat → Nat → Bool) (fun _ _ => true)
    (fun A _ ih Pr j => rowC ONE REP ID Bpk Qs A (Pr.headD 0) (R j) && ih Pr.tail (j + 1)) Cr

@[expose] noncomputable def cctFld (X i : Nat) : Nat := Nat.mod (Nat.shiftRight X (Nat.mul 10 i)) 1024

@[expose] noncomputable def cctBit (K i : Nat) : Bool := Nat.blt 0 (Nat.land K (Nat.shiftLeft 1 i))

@[expose] noncomputable def cctCmp (Rg Rp : Nat) (n : Nat) : Nat → Nat → Bool :=
  Nat.rec (motive := fun _ => Nat → Nat → Bool) (fun _ _ => true)
    (fun _ ih X Y => Nat.beq (Nat.mod X 1024) (cctFld Rg (cctFld Rp (Nat.mod Y 1024))) &&
      ih (Nat.shiftRight X 10) (Nat.shiftRight Y 10)) n

@[expose] noncomputable def cctTree (R : Nat → Nat) :
    List Nat → List Nat → List Nat → Nat → Bool :=
  fun J => List.rec (motive := fun _ => List Nat → List Nat → Nat → Bool)
    (fun _ _ K => Nat.beq K (Nat.sub (Nat.shiftLeft 1 693) 1))
    (fun j _ ih G P K => (cctBit K (G.headD 0) && cctBit K (P.headD 0) &&
      Nat.beq (cctFld (R (G.headD 0)) (P.headD 0)) j &&
      cctCmp (R (G.headD 0)) (R (P.headD 0)) 693 (R j) (R (G.headD 0))) &&
      ih G.tail P.tail (Nat.lor K (Nat.shiftLeft 1 j))) J

@[expose] noncomputable def cctMask : List Nat → Nat :=
  fun Gs => List.rec (motive := fun _ => Nat) 0 (fun g _ ih => Nat.lor (Nat.shiftLeft 1 g) ih) Gs

@[expose] noncomputable def cctGen (ONE REP ID Bpk : Nat) (Qs : List Nat) (C : List (List Nat))
    (R : Nat → Nat) : List Nat → Bool :=
  fun Gs => List.rec (motive := fun _ => Bool) true
    (fun g _ ih => (Nat.blt g 693 &&
      rowC ONE REP ID Bpk Qs (C.getD g []) (pkW 20 (C.getD g [])) (R g)) && ih) Gs

