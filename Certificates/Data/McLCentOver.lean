@[expose] def cGens (D : Data) : Array Tab :=
  (cW.map (wordT D.n (nGens D) (nGensI D))).toArray

@[expose] def cGensI (D : Data) : Array Tab := (cGens D).map (invTab D.n)

@[expose] def xT (D : Data) (i β : Nat) : Tab :=
  comp D.n (repT D)[i + 1]! (powT D.n (wT D D.tW) β)

@[expose] def checkCentOver (D : Data) : Bool :=
  let n := D.n
  let bT := D.gT[1]!
  let tT := wT D D.tW
  let cs := cGens D
  let csI := cGensI D
  checkInv D && invsOK n (nGens D) (nGensI D) && invsOK n cs csI && cs.size == 5 &&
    (allBelow cs.size fun i => comp n cs[i]! bT == comp n bT cs[i]!) &&
    powT n bT 5 == idTab n && !(bT == idTab n) && cs[0]! == bT && checkHR D &&
    found (indexOf (hrEnum D).tabs) (hrEnum D).tabs bT &&
    commutesUV n (rGens D)[0]! (rGens D)[1]! bT &&
    comp n tT bT == comp n (powT n bT 2) tT &&
    (allBelow (nGens D).size fun i =>
      anyBelow 5 fun k => comp n (nGens D)[i]! bT == comp n (powT n bT k) (nGens D)[i]!) &&
    aW.length == 4 * D.repW.length && D.gT.size == 2 &&
    allBelow D.repW.length fun i => allBelow 4 fun β =>
      let x := xT D i β
      let xi := invTab n x
      invsOK n #[x] #[xi] && genOK D (cs ++ #[x]) (csI ++ #[xi]) [aW[4 * i + β]!, [1]]

end Certificates.MclCentOver
