def heCodeW (c : Nat) : List Gen :=
  if c = 0 then heA else if c = 1 then heB else if c = 2 then heBi else heMacW.getD (c - 3) []

def heProdW (L : List Nat) : List Gen :=
  (L.map heCodeW).reverse.flatten

def heWordList (_ : Unit := ()) : List (List Gen) :=
  [heUi ++ heU, heBi ++ heB, heA ++ heD ++ heA ++ heD6, heU ++ heD ++ heUi ++ heD6] ++
    (List.range heMacW.length).map (fun i => heMacW.getD i [] ++ heProdW (heMacC.getD i [])) ++
    heRelC.map heProdW

def heChunk (ks : List Nat) : List (List Gen) :=
  let W := heWordList ()
  ks.map fun k => W.getD k []

