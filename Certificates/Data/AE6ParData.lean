@[expose] def genElt (g : ℕ) : Perm (Fin 8) := swapsPerm ((gens.getD g (∅, [])).2)

@[expose] def vkPred (δ : Finset (Fin 8)) (σ : Perm (Fin 8)) : Bool :=
  decide ((∀ x, x ∉ δ → σ x = x) ∧ (∀ x ∈ δ, σ x ∈ δ) ∧ σ * σ = 1 ∧ (σ = 1 ∨ ∀ x ∈ δ, σ x ≠ x))

@[expose] def dts (δ : Finset (Fin 8)) : List (Perm (Fin 8)) :=
  match δ.sort (· ≤ ·) with
  | [a, b, c, d] => [swap a b * swap c d, swap a c * swap b d, swap a d * swap b c]
  | _ => []

