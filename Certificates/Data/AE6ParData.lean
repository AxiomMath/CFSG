@[expose] def chkAgl (_ : Unit := ()) : Bool :=
  decide ((Finset.univ.filter fun σ : Perm (Fin 8) => inS0 σ = true).card = 192) &&
    decide ((Finset.univ.filter fun σ : Perm (Fin 8) =>
      stabB AE.affinePlanes σ = true).card = 1344) &&
    decide ((Finset.univ.filter fun σ : Perm (Fin 8) => stabB planes2 σ = true).card = 1344) &&
    decide (∀ σ : Perm (Fin 8), inS0 σ = true →
      stabB AE.affinePlanes σ = true ∧ stabB planes2 σ = true)

@[expose] def chkDc (_ : Unit := ()) : Bool :=
  decide (∀ σ : Perm (Fin 8), Perm.sign σ = 1 → inS0 σ = true ∨ dcWit σ = true) &&
    decide (∀ σ : Perm (Fin 8), stabB AE.affinePlanes σ = true →
      inS0 σ = true ∨ dcWitJ 0 σ = true) &&
    decide (∀ σ : Perm (Fin 8), stabB planes2 σ = true → inS0 σ = true ∨ dcWitJ 1 σ = true)

@[expose] def chkWords (_ : Unit := ()) : Bool :=
  decide (stabB AE.affinePlanes (tau 0) = true ∧ stabB planes2 (tau 1) = true ∧
    ∀ j ∈ List.range 6, Perm.sign (tau j) = 1) &&
    decide (∀ l ∈ List.range 4, WordOK [0, 1] (tau (l + 2)) (w12.getD l [])) &&
    decide (∀ l ∈ List.range 4, WordOK [l + 2] (tau 0) ((wj.getD l []).getD 0 []) ∧
      WordOK [l + 2] (tau 1) ((wj.getD l []).getD 1 []))

@[expose] def chkTree (_ : Unit := ()) : Bool :=
  decide (treeElt 0 = 1 ∧ treeP.length = 191 ∧ ∀ i ∈ List.range 191, (treeP.getD i (0, 0)).2 ≤ i ∧
    (treeP.getD i (0, 0)).1 < gens.length ∧
    treeElt (i + 1) = genElt (treeP.getD i (0, 0)).1 * treeElt (treeP.getD i (0, 0)).2) &&
    decide (∀ σ : Perm (Fin 8), inS0 σ = true → ∃ i ∈ List.range 192, treeElt i = σ)

@[expose] def chkVK (_ : Unit := ()) : Bool :=
  decide (∀ g ∈ gens, g.1 ∈ six ∧ vkPred g.1 (swapsPerm g.2) = true) &&
    decide (∀ δ ∈ six, ∀ σ : Perm (Fin 8), vkPred δ σ = true → inS0 σ = true) &&
    decide (∀ x y : Fin 8, x ≠ y → ∃ δ ∈ six, x ∈ δ ∧ y ∈ δ)

@[expose] def chkPlanes (_ : Unit := ()) : Bool :=
  decide (∀ δ ∈ fours (), (dts δ).length = 3 ∧ ∀ σ ∈ dts δ, vkPred δ σ = true) &&
    decide (∀ δ ∈ fours (), (∀ σ ∈ dts δ, stabB AE.affinePlanes σ = true) →
      δ ∈ AE.affinePlanes) &&
    decide (∀ δ ∈ fours (), (∀ σ ∈ dts δ, stabB planes2 σ = true) → δ ∈ planes2) &&
    decide (∀ δ ∈ AE.affinePlanes, ∃ e ∈ ptab1, e.1 = δ ∧
      stabB AE.affinePlanes (swapsPerm e.2) = true ∧ d0.map (swapsPerm e.2).toEmbedding = δ) &&
    decide (∀ δ ∈ planes2, ∃ e ∈ ptab2, e.1 = δ ∧
      stabB planes2 (swapsPerm e.2) = true ∧ d0.map (swapsPerm e.2).toEmbedding = δ)

@[expose] def chkSym (_ : Unit := ()) : Bool :=
  let F := fours ()
  decide (∀ α ∈ F, ∃ e ∈ tab1, d0.map (swapsPerm e).toEmbedding = α) &&
    decide (∀ β ∈ F, (d0 ∩ β).card = 2 → ∃ e ∈ tab2,
      d0.map (swapsPerm e).toEmbedding = d0 ∧ b0.map (swapsPerm e).toEmbedding = β) &&
    decide (∀ α ∈ F, ∀ β ∈ F, (symmDiff α β).card = 4 → (α ∩ β).card = 2)

