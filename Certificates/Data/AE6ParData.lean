@[expose] def swapsPerm (l : List (Fin 8 × Fin 8)) : Perm (Fin 8) :=
  (l.map fun p => swap p.1 p.2).prod

@[expose] def pt (i : Fin 8) : Fin 8 := i ^^^ 1

@[expose] def inS0 (σ : Perm (Fin 8)) : Bool :=
  decide ((∀ i : Fin 8, σ (pt i) = pt (σ i)) ∧ Perm.sign σ = 1)

@[expose] def stabB (F : List (Finset (Fin 8))) (σ : Perm (Fin 8)) : Bool :=
  decide (∀ s ∈ F, s.map σ.toEmbedding ∈ F ∧ s.map σ⁻¹.toEmbedding ∈ F)

