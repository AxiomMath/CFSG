@[expose] def dcWit (σ : Perm (Fin 8)) : Bool :=
  let c := codeOf σ
  dcTable.any fun e => e.1 == c && decide (e.2.1 < 6) && inS0 (swapsPerm e.2.2) &&
    inS0 ((tau e.2.1)⁻¹ * swapsPerm e.2.2 * σ)

@[expose] def dcWitJ (j : ℕ) (σ : Perm (Fin 8)) : Bool :=
  let c := codeOf σ
  dcTable.any fun e => e.1 == c && e.2.1 == j && inS0 (swapsPerm e.2.2) &&
    inS0 ((tau e.2.1)⁻¹ * swapsPerm e.2.2 * σ)

@[expose] def letterVal (a : ℕ × ℕ × List (Fin 8 × Fin 8)) : Perm (Fin 8) :=
  if a.1 = 0 then swapsPerm a.2.2 else if a.1 = 1 then tau a.2.1 else (tau a.2.1)⁻¹

@[expose] def letterOK (allowed : List ℕ) (a : ℕ × ℕ × List (Fin 8 × Fin 8)) : Prop :=
  (a.1 = 0 ∧ inS0 (swapsPerm a.2.2) = true) ∨ ((a.1 = 1 ∨ a.1 = 2) ∧ a.2.1 ∈ allowed)

instance (allowed : List ℕ) (a : ℕ × ℕ × List (Fin 8 × Fin 8)) :
    Decidable (letterOK allowed a) := by
  unfold letterOK; infer_instance

@[expose] def WordOK (allowed : List ℕ) (g : Perm (Fin 8))
    (w : List (ℕ × ℕ × List (Fin 8 × Fin 8))) : Prop :=
  (∀ a ∈ w, letterOK allowed a) ∧ (w.map letterVal).prod = g

instance (allowed : List ℕ) (g : Perm (Fin 8)) (w : List (ℕ × ℕ × List (Fin 8 × Fin 8))) :
    Decidable (WordOK allowed g w) := by
  unfold WordOK; infer_instance

