@[expose] def tau (j : ℕ) : Perm (Fin 8) := swapsPerm (tauSw.getD j [])

@[expose] def codeOf (σ : Perm (Fin 8)) : List (Fin 8) :=
  (List.finRange 8).map fun x => σ (pt (σ⁻¹ x))

