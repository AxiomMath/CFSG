@[expose] def twinPerfCheck (_ : Unit) : Bool :=
  let L := L0 ()
  let L' := L1 ()
  let W := ws ()
  let C8 := ((enumeration sp6CentQ2).map tab).filter fun g => commAll g L && commAll g L'
  let lay := C8.filter fun c => !decide (c = 1) &&
    !((List.range W.length).all fun k => k == 0 || k == 11 || !commAll c (memberElems L (W.getD k 1)))
  !lay.isEmpty &&
    lay.all fun c => (List.range W.length).all fun k =>
      !commAll c (memberElems L (W.getD k 1)) ||
        (memberElems L (W.getD k 1)).all fun x => perfWords.any fun e =>
          e.getD 0 0 == k && commAll c (memberElems L (W.getD (e.getD 1 0) 1)) &&
            commAll c (memberElems L (W.getD (e.getD 2 0) 1)) &&
            (memberElems L (W.getD (e.getD 1 0) 1)).any fun y =>
              (memberElems L (W.getD (e.getD 2 0) 1)).any fun z => decide (y * z * y⁻¹ * z⁻¹ = x)

end CFSG.ClassicalInvolution.Q3.TL4.E4Sp6
