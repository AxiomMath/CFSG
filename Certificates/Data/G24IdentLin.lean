abbrev ZMat := Array (Array (ZMod 2))

@[expose] def zent (A : ZMat) (i j : ℕ) : ZMod 2 := (A.getD i #[]).getD j 0

@[expose] def zmk (r c : ℕ) (f : ℕ → ℕ → ZMod 2) : ZMat :=
  (Array.range r).map fun i => (Array.range c).map (f i)

@[expose] def zmul (r k c : ℕ) (A B : ZMat) : ZMat :=
  zmk r c fun i j => (List.range k).foldl (fun s l => s + zent A i l * zent B l j) 0

@[expose] def zadd (r c : ℕ) (A B : ZMat) : ZMat := zmk r c fun i j => zent A i j + zent B i j

@[expose] def zone (n : ℕ) : ZMat := zmk n n fun i j => if i = j then 1 else 0

@[expose] def zzero (r c : ℕ) : ZMat := zmk r c fun _ _ => 0

@[expose] def zinvs (n : ℕ) (G : Array ZMat) : Array ZMat :=
  #[G.getD 0 #[], zmul n n n (G.getD 1 #[]) (G.getD 1 #[]),
    zmul n n n (G.getD 2 #[]) (G.getD 2 #[])]

@[expose] def zevalRel (n : ℕ) (G : Array ZMat) (r : List (Fin 3 × Bool)) : ZMat :=
  let Gi := zinvs n G
  r.foldl (fun A l => zmul n n n A (if l.2 then G.getD l.1.val #[] else Gi.getD l.1.val #[]))
    (zone n)

@[expose] def bits (s : String) : Array (ZMod 2) :=
  s.toList.toArray.map fun c => if c = '1' then 1 else 0

@[expose] def ofBits (rows : List String) : ZMat := (rows.map bits).toArray

@[expose] def gV1 (_ : Unit := ()) : Array ZMat := #[ofMat rho1a, ofMat rho1b, ofMat rho1c]

@[expose] def gZ1 (_ : Unit := ()) : Array ZMat := #[ofMat rhoZ1a, ofMat rhoZ1b, ofMat rhoZ1c]

@[expose] def gV2 (_ : Unit := ()) : Array ZMat := #[ofMat rho2a, ofMat rho2b, ofMat rho2c]

@[expose] def gZ2 (_ : Unit := ()) : Array ZMat := #[ofMat rhoZ2a, ofMat rhoZ2b, ofMat rhoZ2c]

@[expose] def gU2 (_ : Unit := ()) : Array ZMat := #[ofMat rhoU2a, ofMat rhoU2b, ofMat rhoU2c]

@[expose] def gN2 (_ : Unit := ()) : Array ZMat :=
  (gV2 ()).map fun A => zmk 4 4 fun i j => zent A (i + 2) (j + 2)

@[expose] def gX0 (_ : Unit := ()) : Array ZMat :=
  (gV2 ()).map fun A => zmk 2 4 fun i j => zent A i (j + 2)

@[expose] def mComm (A₀ A₁ : ZMat) : ZMat :=
  zmk 32 16 fun row x =>
    let A := if row / 16 = 0 then A₀ else A₁
    let i := row % 16 / 4
    let j := row % 4
    (if x / 4 = i then zent A (x % 4) j else 0) + (if x % 4 = j then zent A i (x / 4) else 0)

@[expose] def kComm (W : ZMat) : ZMat :=
  zmk 16 2 fun x c => if c = 0 then (if x / 4 = x % 4 then 1 else 0) else zent W (x / 4) (x % 4)

@[expose] def monos (n : ℕ) : Array (List ℕ) :=
  (((List.range n).map fun i => [i]) ++ (List.range n).flatMap fun i =>
    ((List.range n).filter fun j => decide (i < j)).map fun j => [i, j]).toArray

@[expose] def aCoef (R : ZMat) (μ ν : List ℕ) : ZMod 2 :=
  match μ, ν with
  | [i], [k] => zent R k i
  | [i], [k, l] => zent R k i * zent R l i
  | [i, j], [k, l] => zent R k i * zent R l j + zent R k j * zent R l i
  | _, _ => 0

@[expose] def mQuad (n d : ℕ) (Rs Ss : Array ZMat) : ZMat :=
  let ms := monos n
  let N := ms.size
  zmk (3 * N * d) (N * d) fun row col =>
    let g := row / (N * d)
    let μ := row % (N * d) / d
    let k := row % d
    let ν := col / d
    let k' := col % d
    (if k = k' then aCoef (Rs.getD g #[]) (ms.getD μ []) (ms.getD ν []) else 0) +
      (if ν = μ then zent (Ss.getD g #[]) k k' else 0)

@[expose] def qVec (n d : ℕ) (qlin : List (List Bool)) (qc : List (List (List Bool))) :
    Array (ZMod 2) :=
  let ms := monos n
  (Array.range (ms.size * d)).map fun x =>
    let b := match ms.getD (x / d) [] with
      | [i] => (qlin.getD i []).getD (x % d) false
      | [i, j] => ((qc.getD i []).getD j []).getD (x % d) false
      | _ => false
    if b then 1 else 0

@[expose] def kQuad (d : ℕ) (q : Array (ZMod 2)) (W : ZMat) : ZMat :=
  zmk q.size 2 fun x c =>
    if c = 0 then q.getD x 0
    else (List.range d).foldl (fun s k' => s + zent W (x % d) k' * q.getD (d * (x / d) + k') 0) 0

@[expose] def foxTerm (dV dZ t : ℕ) (SP RPi : ZMat) : ZMat :=
  zmk (dZ * dV) (3 * (dZ * dV)) fun row col =>
    if col / (dZ * dV) = t then
      zent SP (row / dV) (col % (dZ * dV) / dV) * zent RPi (col % dV) (row % dV)
    else 0

@[expose] def foxRel (dV dZ : ℕ) (Rs Ss : Array ZMat) (r : List (Fin 3 × Bool)) : ZMat :=
  let nb := dZ * dV
  let Ri := zinvs dV Rs
  let Si := zinvs dZ Ss
  let step := fun (st : ZMat × ZMat × ZMat) (l : Fin 3 × Bool) =>
    let t := l.1.val
    if l.2 then
      (zadd nb (3 * nb) st.1 (foxTerm dV dZ t st.2.1 st.2.2),
        zmul dZ dZ dZ st.2.1 (Ss.getD t #[]), zmul dV dV dV (Ri.getD t #[]) st.2.2)
    else
      let SP := zmul dZ dZ dZ st.2.1 (Si.getD t #[])
      let RPi := zmul dV dV dV (Rs.getD t #[]) st.2.2
      (zadd nb (3 * nb) st.1 (foxTerm dV dZ t SP RPi), SP, RPi)
  (r.foldl step (zzero nb (3 * nb), zone dZ, zone dV)).1

@[expose] def mFox (dV dZ : ℕ) (Rs Ss : Array ZMat) : ZMat :=
  relsA.foldl (fun acc r => acc ++ foxRel dV dZ Rs Ss r) #[]

@[expose] def kFox (dV dZ : ℕ) (Rs Ss : Array ZMat) : ZMat :=
  let nb := dZ * dV
  let Ri := zinvs dV Rs
  zmk (3 * nb) nb fun row col =>
    let t := row / nb
    let μ := row % nb / dV
    let ν := row % dV
    zent (Ss.getD t #[]) μ (col / dV) * zent (Ri.getD t #[]) (col % dV) ν +
      (if μ = col / dV ∧ ν = col % dV then 1 else 0)

@[expose] def extLetter (Us Ns Ui Ni : Array ZMat) (l : Fin 3 × Bool) : ZMat × ZMat × ZMat :=
  let t := l.1.val
  if l.2 then
    (Us.getD t #[], zmk 8 24 (fun row x => if x = 8 * t + row then 1 else 0), Ns.getD t #[])
  else
    (Ui.getD t #[], zmk 8 24 (fun row x =>
      if x / 8 = t then
        zent (Ui.getD t #[]) (row / 4) (x % 8 / 4) * zent (Ni.getD t #[]) (x % 4) (row % 4)
      else 0), Ni.getD t #[])

@[expose] def extMul (B C : ZMat × ZMat × ZMat) : ZMat × ZMat × ZMat :=
  (zmul 2 2 2 B.1 C.1,
    zmk 8 24 (fun row x =>
      (List.range 2).foldl
          (fun s m => s + zent B.1 (row / 4) m * zent C.2.1 (4 * m + row % 4) x) 0 +
        (List.range 4).foldl
          (fun s m => s + zent B.2.1 (4 * (row / 4) + m) x * zent C.2.2 m (row % 4)) 0),
    zmul 4 4 4 B.2.2 C.2.2)

@[expose] def mExt (Us Ns : Array ZMat) : ZMat :=
  let Ui := zinvs 2 Us
  let Ni := zinvs 4 Ns
  relsA.foldl (fun acc r =>
    acc ++ (r.foldl (fun B l => extMul B (extLetter Us Ns Ui Ni l))
      (zone 2, zzero 8 24, zone 4)).2.1) #[]

@[expose] def kExt (Us Ns X0 : Array ZMat) : ZMat :=
  zmk 24 10 fun row c =>
    let t := row / 8
    let μ := row % 8 / 4
    let ν := row % 4
    if c < 8 then
      (if μ = c / 4 then zent (Ns.getD t #[]) (c % 4) ν else 0) +
        (if ν = c % 4 then zent (Us.getD t #[]) μ (c / 4) else 0)
    else if c = 8 then zent (X0.getD t #[]) μ ν
    else (List.range 2).foldl (fun s m => s + zent (Us.getD 2 #[]) μ m * zent (X0.getD t #[]) m ν) 0

