@[expose] def ae6C3 (_ : Unit := ()) : Bool :=
  let PL := allTables (plQ ())
  let z := z0 ()
  let H := (c3Perms ()).map fun h => toTable (h⁻¹ * z * h)
  (allTables (wQ ())).all fun Y => memT 360 PL Y || H.any fun T => tblEq 360 (compT 360 Y Y) T

@[expose] def ae6C1 (_ : Unit := ()) : Bool :=
  let PL := allTables (plQ ())
  let z := z0 ()
  let G := curtisPerms ()
  let H := c1Perms ()
  H.length == 8 && (List.range 8).all fun i =>
    let h := H.getD i 1
    memT 360 PL (toTable (h⁻¹ * z * h)) && memT 360 PL (toTable (h⁻¹ * G.getD i 1 * h))

@[expose] def ae6C1i (_ : Unit := ()) : Bool :=
  let PL := allTables (plQ ())
  let z := z0 ()
  let G := curtisPerms ()
  let H := c1iPerms ()
  H.length == 8 && (List.range 8).all fun i =>
    let h := H.getD i 1
    memT 360 PL (toTable (h⁻¹ * z * h)) && memT 360 PL (toTable (h * G.getD i 1 * h⁻¹))

