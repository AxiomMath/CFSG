@[expose] def prodN (n : ℕ) (gs : Array (Array ℕ)) : List ℕ → Array ℕ
  | [] => idA n
  | j :: w => compA n gs[j]! (prodN n gs w)

@[expose] def e9Pairs : List (ℕ × ℕ) :=
  [(0, 1), (0, 2), (1, 0), (1, 1), (1, 2), (2, 0), (2, 1), (2, 2)]

@[expose] def gen5Check (n : ℕ) (a b : Array ℕ) (e1W e2W : List ℕ) (cls : List (ℕ × ℕ × ℕ × List ℕ))
    (wW : List (List ℕ)) (wP : List (ℕ × ℕ)) (aW bW : List ℕ) : Bool :=
  let gs : Array (Array ℕ) := #[a, b]
  let e₁ := prodN n gs e1W
  let e₂ := prodN n gs e2W
  let ws : Array (Array ℕ) := (wW.map (prodN n gs)).toArray
  isInvA n a (invCand n a) && isInvA n b (invCand n b) &&
    (e1W ++ e2W).all (fun j => decide (j < 2)) && e9Check n e₁ e₂ &&
    cls.map (fun t => (t.1, t.2.1)) == e9Pairs &&
    cls.all (fun t => t.2.2.2.all (fun j => decide (j < 2)) && (t.2.2.1 == 1 || t.2.2.1 == 2) &&
      eqA n (compA n (prodN n gs t.2.2.2) (powN n e₁ t.2.2.1))
        (compA n (pN n e₁ e₂ (t.1, t.2.1)) (prodN n gs t.2.2.2))) &&
    wW.all (fun w => w.all (fun j => decide (j < 2))) && wP.length == wW.length &&
    sigCheck n ws (wW.map fun _ => 5) wP e₁ e₂ &&
    (aW ++ bW).all (fun j => decide (j < wW.length)) &&
    eqA n (prodN n ws aW) a && eqA n (prodN n ws bW) b

