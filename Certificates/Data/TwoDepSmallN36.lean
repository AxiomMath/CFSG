@[expose] def ggTWDRefVec (p : Nat) (q : GGDepANPair) (v : List Nat) : List Nat :=
  ggDepANSub p v (ggDepANSmul p (ggDepANDot p q.2 v) q.1)

@[expose] def ggTWDWordVec (p : Nat) (qs : List GGDepANPair) (w : List Nat) (v : List Nat) :
    List Nat :=
  w.foldr (fun g acc => ggTWDRefVec p (qs.getD g ([], [])) acc) v

@[expose] def ggTWDBasis (N k : Nat) : List Nat :=
  (List.range N).map fun j => if j = k then 1 else 0

@[expose] def ggTWDE6M (i j : Nat) : Nat :=
  if i = j then 1
  else if (i, j) ∈ [(0, 2), (2, 0), (1, 3), (3, 1), (2, 3), (3, 2), (3, 4), (4, 3), (4, 5), (5, 4)]
    then 3 else 2

@[expose] def ggTWDPowVec (p : Nat) (qi qj : GGDepANPair) (m : Nat) (v : List Nat) : List Nat :=
  (List.range m).foldl (fun acc _ => ggTWDRefVec p qi (ggTWDRefVec p qj acc)) v

structure GGTWDOut where
  sw : List (Nat × List Nat)
  gw : List (Nat × List Nat)
  ot : List (Nat × Nat)

@[expose] def ggTWDGenList (p N : Nat) (news : List GGDepANPair) : List GGDepANPair :=
  (List.range (N - 1)).map (fun g => (ggDepANH p N g, ggDepANA p N g)) ++ news

@[expose] def ggTWDOutS (p N : Nat) (news : List GGDepANPair) (O : GGTWDOut) : List GGDepANPair :=
  O.sw.map fun e => ggTWDWord p N news (ggTWDGen p N news e.1) e.2

@[expose] def ggTWDOrbit (p N : Nat) (news : List GGDepANPair) (ot : List (Nat × Nat)) :
    List (List Nat) :=
  ot.foldl (fun acc e =>
    acc ++ [ggTWDRefVec p ((ggTWDGenList p N news).getD e.2 ([], [])) (acc.getD e.1 [])])
    [ggDepANX N]

@[expose] def ggTWDOutValid (G : Nat) (O : GGTWDOut) : Bool :=
  decide (O.sw.length = 6) &&
    O.sw.all (fun e => decide (e.1 < G) && e.2.all fun g => decide (g < G)) &&
    decide (O.gw.length = G) &&
    O.gw.all (fun e => decide (e.1 < 6) && e.2.all fun i => decide (i < 6)) &&
    decide (O.ot.length = 71) &&
    (List.range O.ot.length).all fun t =>
      decide ((O.ot.getD t (0, 0)).1 ≤ t) && decide ((O.ot.getD t (0, 0)).2 < G)

@[expose] def ggTWDOutOK (p N : Nat) (news : List GGDepANPair) (O : GGTWDOut) : Bool :=
  let gs := ggTWDGenList p N news
  let ss := ggTWDOutS p N news O
  ggTWDOutValid gs.length O &&
    (List.range 6).all (fun i => (List.range 6).all fun j => (List.range N).all fun k =>
      ggTWDPowVec p (ss.getD i ([], [])) (ss.getD j ([], [])) (ggTWDE6M i j) (ggTWDBasis N k) ==
        ggTWDBasis N k) &&
    (List.range gs.length).all (fun g =>
      let e := O.gw.getD g (0, [])
      (List.range N).all fun k =>
        ggTWDRefVec p (gs.getD g ([], [])) (ggTWDBasis N k) ==
          ggTWDWordVec p ss (e.2 ++ e.1 :: e.2.reverse) (ggTWDBasis N k)) &&
    let vs := ggTWDOrbit p N news O.ot
    decide (vs.length = 72) && decide vs.Nodup

@[expose] def ggTWDCases1Or (p N pos c0 mi ni : Nat) (wits : List GGDepANWit)
    (outs : List (List (List Nat) × GGTWDOut)) : Bool :=
  let X := ggDepANX N
  let has := ggTWDSolH p N pos fun c => if c = c0 then (p - ni % p) % p else 0
  let aas := ggTWDSolA p N pos fun c => if c = c0 then (p - mi % p) % p else 0
  has.all fun ha => aas.all fun aa =>
    if ggDepANDot p aa ha == 2 % p && ggDepANDot p aa X != 0 then
      wits.any (fun w => ggTWDWitTest p N [(ha, aa)] w) ||
        match outs.lookup [ha, aa] with
        | some O => ggTWDOutOK p N [(ha, aa)] O
        | none => false
    else true

@[expose] def ggTWDCases2Or (p N pos c : Nat) (c2 : Option Nat) (wits : List GGDepANWit)
    (outs : List (List (List Nat) × GGTWDOut)) : Bool :=
  let X := ggDepANX N
  let nb := if c2.isNone then (p - 1) % p else 0
  let t1 : Nat → Nat := fun c' => if c' = c then (p - 1) % p else 0
  let t2 : Nat → Nat := fun c' => if some c' = c2 then (p - 1) % p else 0
  let h1s := ggTWDSolH p N pos t1
  let a1s := ggTWDSolA p N pos t1
  let h2s := ggTWDSolH p N pos t2
  let a2s := ggTWDSolA p N pos t2
  h1s.all fun h1 => a1s.all fun a1 =>
    if ggDepANDot p a1 h1 == 2 % p then
      h2s.all fun h2 =>
        if ggDepANDot p a1 h2 == nb then
          a2s.all fun a2 =>
            if ggDepANDot p a2 h2 == 2 % p && ggDepANDot p a2 h1 == nb &&
                (ggDepANDot p a1 X != 0 || ggDepANDot p a2 X != 0) then
              wits.any (fun w => ggTWDWitTest p N [(h1, a1), (h2, a2)] w) ||
                match outs.lookup [h1, a1, h2, a2] with
                | some O => ggTWDOutOK p N [(h1, a1), (h2, a2)] O
                | none => false
            else true
        else true
    else true

structure GGTWDData36 where
  one : List ((Nat × Nat × Nat × Nat) × List GGDepANWit)
  two : List ((Nat × Nat × Nat) × List GGDepANWit)
  oneOut : List (List (List Nat) × GGTWDOut)
  twoOut : List (List (List Nat) × GGTWDOut)

@[expose] def ggTWDCheck36 (d : GGTWDData36) : Bool :=
  d.one.all (fun e => e.2.all (ggTWDWitValid 6)) &&
  d.two.all (fun e => e.2.all (ggTWDWitValid 7)) &&
  [0, 1].all fun pos =>
    ((List.range 5).all fun c0 => [1, 2].all fun mi => [1, 2].all fun ni =>
      if ggTWNPat1B 6 pos c0 mi ni then
        match d.one.lookup (pos, c0, mi, ni) with
        | none => false
        | some wits => ggTWDCases1Or 3 6 pos c0 mi ni wits d.oneOut
      else true) &&
    ((List.range 5).all fun c => (none :: (List.range 5).map some).all fun c2 =>
      if ggTWNPat2B 6 pos c c2 then
        match d.two.lookup (pos, c, ggTWNCode c2) with
        | none => false
        | some wits => ggTWDCases2Or 3 6 pos c c2 wits d.twoOut
      else true)

