@[expose] def tOff : List Nat := [
  0, 0, 0, 0, 0, 0, 0, 0, 2137, 2137, 2137, 2137, 2137, 2137, 2137, 4243, 6323, 6323, 8477,
  10565, 10565, 10565, 10565, 10565, 12679]

@[expose] def tCoeffs : List Nat := [
  2, 4, 1, 8, 16, 32, 64, 10, 4, 128, 256, 1, 8, 512, 880, 419, 32, 446, 428, 1024, 2048, 64,
  1024, 3549]

@[expose] def mulCols (cols : List Nat) (x : Nat) : Nat :=
  (List.finRange 12).foldl
    (fun acc (c : Fin 12) => if x.testBit c.val then acc ^^^ cols.getD c.val 0 else acc) 0

@[expose] def colsJ (j : Nat) : List Nat := if j = 0 then aCols else bCols

@[expose] def wordAct (w : List Nat) (i : Nat) : Nat := w.foldl (fun k j => actT j k) i

@[expose] def xAct (i : Nat) : Nat := wordAct x0Word i

@[expose] def basisPt (l : Nat) : Nat := basisList.getD l 0

@[expose] def basisCols : List Nat := (List.range 12).map fun l => psiData[basisPt l]!

@[expose] def psiCheck (_ : Unit := ()) : Bool :=
  allLt 4725 fun i => allLt 2 fun j => mulCols (colsJ j) psiData[actT j i]! == psiData[i]!

@[expose] def orbitCheck (_ : Unit := ()) : Bool :=
  allLt 4725 fun i => (psiData[i]! ^^^ psiData[xAct i]! ^^^ psiData[xAct (xAct i)]!) == 0

@[expose] def basisCheck (_ : Unit := ()) : Bool :=
  basisPt 0 == 0 && allLt 12 (fun l => decide (basisPt l < 4725)) &&
    allLt 12 (fun c => mulCols basisCols (binvCols.getD c 0) == 2 ^ c) &&
    allLt 12 (fun c => mulCols binvCols (basisCols.getD c 0) == 2 ^ c)

@[expose] def keptTri (_ : Unit := ()) : Array (Nat × Nat × Nat) := Id.run do
  let mut t : Array (Nat × Nat × Nat) := #[]
  for n in [0:4713] do
    let r := keptCodes[n]!
    if r % 3 = 0 then
      let a := r / 3
      let b := xAct a
      t := t.push (a, b, xAct b)
    else
      let p := t[r / 3]!
      let j := r % 3 - 1
      t := t.push (actT j p.1, actT j p.2.1, actT j p.2.2)
  return t

@[expose] def keptCheck (_ : Unit := ()) : Bool :=
  let T := keptTri ()
  T.size == 4713 && allLt 4713 fun n =>
    let r := keptCodes[n]!
    let t := T[n]!
    if r % 3 = 0 then
      decide (r / 3 < 4725) && t.1 == r / 3 && t.2.1 == xAct t.1 && t.2.2 == xAct t.2.1
    else
      let p := T[r / 3]!
      let j := r % 3 - 1
      decide (r / 3 < n) && t.1 == actT j p.1 && t.2.1 == actT j p.2.1 && t.2.2 == actT j p.2.2

@[expose] def triBits (t : Nat × Nat × Nat) : Nat := 2 ^ t.1 ^^^ 2 ^ t.2.1 ^^^ 2 ^ t.2.2

@[expose] def xorTri (T : Array (Nat × Nat × Nat)) (l : List Nat) : Nat :=
  l.foldl (fun acc n => acc ^^^ triBits T[n]!) 0

@[expose] def coeffXor (c : Nat) : Nat :=
  (List.range 12).foldl (fun acc l => if c.testBit l then acc ^^^ 2 ^ basisPt l else acc) 0

@[expose] def maskList (t : Nat) : List Nat :=
  (List.range' (tOff.getD t 0) (tOff.getD (t + 1) 0 - tOff.getD t 0)).map fun k => tMaskAll[k]!

@[expose] def targetCheck (_ : Unit := ()) : Bool :=
  let T := keptTri ()
  allLt 12 fun l => allLt 2 fun j =>
    (maskList (2 * l + j)).all (· < 4713) &&
      xorTri T (maskList (2 * l + j)) ==
        (2 ^ actT j (basisPt l) ^^^ coeffXor (tCoeffs.getD (2 * l + j) 0))

@[expose] def conjCheck (_ : Unit := ()) : Bool :=
  let g := wordArr gWord
  let x := wordArr x0Word
  eqA 315 (compA 315 g CFSG.RankThree.PartTwo.Sec4.Sporadic.J2.zArr) (compA 315 x g) &&
    eqA 315 (compA 315 x (compA 315 x x)) (idA 315)

end CFSG.RankThree.PartTwo.J2Residue.C4725
