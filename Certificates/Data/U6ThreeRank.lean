module

public import Certificates.Data.ThreeWitness
public import Mathlib.Data.ZMod.Basic
public import Mathlib.GroupTheory.Perm.Basic
public import Mathlib.Logic.Equiv.Fin.Basic

public section

namespace CFSG.RankThree.PartOne.F106

@[expose] def u6Idx : Fin 6 ≃ Fin 2 × ZMod 3 := (finProdFinEquiv (m := 2) (n := 3)).symm

@[expose] def u6Perm (t : Fin 2 → ZMod 3) : Equiv.Perm (Fin 6) :=
  u6Idx.trans ((Equiv.prodShear (Equiv.refl (Fin 2)) fun s => Equiv.addRight (t s)).trans
    u6Idx.symm)

structure U6Mon where
  d0 : ZMod 3
  d1 : ZMod 3
  d2 : ZMod 3
  d3 : ZMod 3
  d4 : ZMod 3
  d5 : ZMod 3
  t0 : ZMod 3
  t1 : ZMod 3
  deriving DecidableEq

namespace U6Mon

@[expose] def d (x : U6Mon) : Fin 6 → ZMod 3 := ![x.d0, x.d1, x.d2, x.d3, x.d4, x.d5]

@[expose] def t (x : U6Mon) : Fin 2 → ZMod 3 := ![x.t0, x.t1]

@[expose] def ofFun (f : Fin 6 → ZMod 3) (s : Fin 2 → ZMod 3) : U6Mon :=
  ⟨f 0, f 1, f 2, f 3, f 4, f 5, s 0, s 1⟩

@[expose] def raw (x y : U6Mon) : Fin 6 → ZMod 3 := fun i => x.d i + y.d (u6Perm (-x.t) i)

@[expose] def mul (x y : U6Mon) : U6Mon :=
  ofFun (fun i => x.raw y i - x.raw y 0) (x.t + y.t)

@[expose] def one : U6Mon := ofFun (fun _ => 0) (fun _ => 0)

@[expose] def gen (k : ℕ) : U6Mon :=
  if k < 4 then
    ofFun (fun i => (if i.val = k + 1 then 1 else 0) - (if i.val = 5 then 1 else 0)) fun _ => 0
  else if k = 4 then ofFun (fun _ => 0) fun s => if s.val = 0 then 1 else 0
  else if k = 5 then ofFun (fun _ => 0) fun s => if s.val = 1 then 1 else 0
  else one

@[expose] def evalWord (w : List ℕ) : U6Mon := (w.map gen).foldl mul one

end U6Mon

structure U6SylowCert where
  paths : List (List ℕ)
  rt : List ℕ
  inv : List ℕ
  zl : List ℕ
  wit : List Wit

namespace U6SylowCert

variable (c : U6SylowCert)

@[expose] def tab (i : ℕ) : U6Mon := U6Mon.evalWord (c.paths.getD i [])

@[expose] def rtv (i g : ℕ) : ℕ := c.rt.getD (6 * i + g) 0

@[expose] def invv (i : ℕ) : ℕ := c.inv.getD i 0

@[expose] def conjC (i u : ℕ) : U6Mon := ((c.tab u).mul (c.tab i)).mul (c.tab (c.invv u))

@[expose] def commB (i j : ℕ) : Bool := decide ((c.tab i).mul (c.tab j) = (c.tab j).mul (c.tab i))

@[expose] def witOK (i : ℕ) : Wit → Bool
  | .exc => decide (i ∈ c.zl)
  | .conj4 u₀ u₁ u₂ u₃ =>
      decide (u₀ < 729 ∧ u₁ < 729 ∧ u₂ < 729 ∧ u₃ < 729) &&
        decide ([u₀, u₁, u₂, u₃].map (c.conjC i)).Nodup
  | .pair z x y =>
      decide (z < 729 ∧ x < 729 ∧ y < 729) && !c.commB z i && c.commB x i && c.commB y i &&
        !c.commB x y
  | .cube z x =>
      decide (z < 729 ∧ x < 729) && !c.commB z i && c.commB x i &&
        decide (((c.tab x).mul (c.tab x)).mul (c.tab x) ≠ U6Mon.one)

@[expose] def check : Bool :=
  decide (c.paths.length = 729) && decide (c.paths.getD 0 [] = []) &&
  c.paths.all (fun p => p.all (fun k => decide (k < 6))) &&
  decide ((List.range 729).map c.tab).Nodup &&
  (List.range 729).all (fun i => (List.range 6).all (fun g =>
    decide (c.rtv i g < 729) &&
      decide ((c.tab i).mul (U6Mon.gen g) = c.tab (c.rtv i g)))) &&
  (List.range 729).all (fun i =>
    decide (c.invv i < 729) && decide ((c.tab i).mul (c.tab (c.invv i)) = U6Mon.one)) &&
  decide (c.zl.length < 243) &&
  (List.range 729).all (fun i => c.witOK i (c.wit.getD i .exc))

end U6SylowCert

