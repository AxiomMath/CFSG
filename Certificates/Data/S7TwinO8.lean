@[expose] def genArr (i : ℕ) : Array ℕ := copy0Arr genArrs[i]!

@[expose] def gens1c (_ : Unit := ()) : List (Equiv.Perm (Fin 120)) :=
  (List.range 8).map fun i => permOfInv 120 (genArr i) (invCand 120 (genArr i))

@[expose] def sylWords : List (List ℤ) :=
  [[-1], [-3], [-5], [-7]]

@[expose] def sylGens (_ : Unit := ()) : List (Equiv.Perm (Fin 120)) :=
  let G := gens1c ()
  sylWords.map fun w => tab (evalCodes G w)

@[expose] def sylDerive : List (List ℤ) :=
  [[-2, 3, 2], [-5, 4, 5], [-4, -2, 4, 2]]

@[expose] def sylQ (_ : Unit := ()) : RawSchreierDatum 120 :=
  certificate (by decide) (sylGens ()) sylDerive #v[0, 2, 4, 24, 8] (by decide)

