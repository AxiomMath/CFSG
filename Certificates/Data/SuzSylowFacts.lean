@[expose] def waWord : List Int := [-3, -9, -5, -2, 5, 2, 5, -4, -3, -5, -3, -2, -5, -1, -5, -3, -7, -5, 10, -3, 5, -9, -2, -3, -1, -9, 3, -10]

@[expose] def wbWord : List Int := [-9, -5, -1, -9, -1, -9, -4, -2, -1, -3, -5, -1, -5, -1, -5, -1, -5, -9, -4, -2, 4, 5, -3, 5, -3, -9, 3, -10]

@[expose] def ev (w : List Int) : Array Nat := wordA 1782 suzTriple suzTripleInv w

@[expose] def commA (u v : Array Nat) : Array Nat :=
  compA 1782 (compA 1782 (compA 1782 u v) (invCand 1782 u)) (invCand 1782 v)

@[expose] def rArrs (_ : Unit := ()) : Array (Array Nat) :=
  Array.ofFn (n := 4) fun i => ev (rWords[i.val]!)

@[expose] def g2uArrs (_ : Unit := ()) : Array (Array Nat) :=
  Array.ofFn (n := 7) fun i => ev (g2uWords[i.val]!)

@[expose] def g2vArrs (_ : Unit := ()) : Array (Array Nat) :=
  Array.ofFn (n := 7) fun i => ev (g2vWords[i.val]!)

@[expose] def n2ArrOf (u v : Array (Array Nat)) : Array (Array Nat) :=
  Array.ofFn (n := 7) fun j => commA (u[j.val]!) (v[j.val]!)

@[expose] def n2Arrs (_ : Unit := ()) : Array (Array Nat) :=
  n2ArrOf (g2uArrs ()) (g2vArrs ())

@[expose] def g3uArrs (_ : Unit := ()) : Array (Array Nat) :=
  Array.ofFn (n := 5) fun i => ev (g3uWords[i.val]!)

@[expose] def g3vArrs (_ : Unit := ()) : Array (Array Nat) :=
  Array.ofFn (n := 5) fun i => ev (g3vWords[i.val]!)

@[expose] def n3ArrOf (u v : Array (Array Nat)) : Array (Array Nat) :=
  Array.ofFn (n := 5) fun k => commA (u[k.val]!) (v[k.val]!)

@[expose] def n3Arrs (_ : Unit := ()) : Array (Array Nat) :=
  n3ArrOf (g3uArrs ()) (g3vArrs ())

@[expose] def qArrs (_ : Unit := ()) : Array (Array Nat) :=
  Array.ofFn (n := 3) fun i => ev (suzQWords[i.val]!)

@[expose] def cArrs (_ : Unit := ()) : Array (Array Nat) :=
  Array.ofFn (n := 6) fun i => ev (cWords[i.val]!)

@[expose] def tenArrs (r c : Array (Array Nat)) : Array (Array Nat) :=
  Array.ofFn (n := 10) fun j => if j.val < 4 then r[j.val]! else c[j.val - 4]!

@[expose] def rEnum (_ : Unit := ()) : Enum := enumBFS 1782 (rArrs ()) 8192

@[expose] def idxR (_ : Unit := ()) : Std.HashMap Tab Nat := indexOf (rEnum ()).tabs

@[expose] def n2Enum (_ : Unit := ()) : Enum := enumBFS 1782 (n2Arrs ()) 512

@[expose] def idxN2 (_ : Unit := ()) : Std.HashMap Tab Nat := indexOf (n2Enum ()).tabs

@[expose] def n3Enum (_ : Unit := ()) : Enum := enumBFS 1782 (n3Arrs ()) 64

@[expose] def idxN3 (_ : Unit := ()) : Std.HashMap Tab Nat := indexOf (n3Enum ()).tabs

@[expose] def qEnum (_ : Unit := ()) : Enum := enumBFS 1782 (qArrs ()) 8

@[expose] def n3Commutes (g : Array (Array Nat)) (t : Array Nat) : Bool :=
  allBelow 5 fun k => comp 1782 t g[k]! == comp 1782 g[k]! t

@[expose] def zFilter (g : Array (Array Nat)) (e : Enum) : Array (Array Nat) :=
  e.tabs.filter (n3Commutes g)

@[expose] def zTabs (_ : Unit := ()) : Array (Array Nat) :=
  zFilter (n3Arrs ()) (n3Enum ())

@[expose] def rWordOK (_ : Unit := ()) : Bool :=
  allBelow 4 fun i => lettersOK 3 (rWords[i]!) && lettersOK 2 (rWords[i]!)

@[expose] def g2WordOK (_ : Unit := ()) : Bool :=
  allBelow 7 fun j => lettersOK 3 (g2uWords[j]!) && lettersOK 3 (g2vWords[j]!)

@[expose] def g3WordOK (_ : Unit := ()) : Bool :=
  allBelow 5 fun k => lettersOK 3 (g3uWords[k]!) && lettersOK 3 (g3vWords[k]!)

@[expose] def qWordOK (_ : Unit := ()) : Bool :=
  allBelow 3 fun i => lettersOK 3 (suzQWords[i]!)

@[expose] def cWordOK (_ : Unit := ()) : Bool :=
  allBelow 6 fun i => lettersOK 3 (cWords[i]!) && lettersOK 2 (cWords[i]!)

@[expose] def wWordOK (_ : Unit := ()) : Bool :=
  lettersOK 10 waWord && lettersOK 10 wbWord

@[expose] def rCheck (rA : Array (Array Nat)) (eR : Enum) : Bool :=
  allBelow 4 (fun i => permOK 1782 rA[i]!) &&
    (enumOK 1782 rA eR &&
      (eR.tabs.size == 8192))

@[expose] def n2Check (rA rI g2u g2v g2 : Array (Array Nat)) (eR : Enum)
    (ir : Std.HashMap Tab Nat) (e2 : Enum) : Bool :=
  allBelow 7 (fun j => permOK 1782 g2u[j]! && permOK 1782 g2v[j]!) &&
    (allBelow 7 (fun j => found ir eR.tabs g2u[j]! && found ir eR.tabs g2v[j]!) &&
      (allBelow 7 (fun j => permOK 1782 g2[j]!) &&
        (enumOK 1782 g2 e2 &&
          (e2.tabs.size == 512 &&
            (normalOK 1782 e2.tabs rA rI g2 &&
              (allBelow 4 (fun i => allBelow 4 (fun j => found (indexOf e2.tabs) e2.tabs (commA rA[i]! rA[j]!)))))))))

@[expose] def n3Check (rA rI g2 g3u g3v g3 : Array (Array Nat)) (eR e2 : Enum)
    (ir i2 : Std.HashMap Tab Nat) (e3 : Enum) : Bool :=
  allBelow 5 (fun k => permOK 1782 g3u[k]! && permOK 1782 g3v[k]!) &&
    (allBelow 5 (fun k => found ir eR.tabs g3u[k]! && found i2 e2.tabs g3v[k]!) &&
      (allBelow 5 (fun k => permOK 1782 g3[k]!) &&
        (enumOK 1782 g3 e3 &&
          (e3.tabs.size == 64 &&
            (normalOK 1782 e3.tabs rA rI g3 &&
              (allBelow 7 (fun i => allBelow 4 (fun j => found (indexOf e3.tabs) e3.tabs (commA g2[i]! rA[j]!)))))))))

@[expose] def zCheck (zT : Array (Array Nat)) : Bool :=
  zT.size == 16 && allBelow zT.size (fun k => comp 1782 zT[k]! zT[k]! == idTab 1782)

@[expose] def qCheck (rA qA cA : Array (Array Nat)) (eR : Enum)
    (ir : Std.HashMap Tab Nat) (eQ : Enum) : Bool :=
  allBelow 3 (fun i => permOK 1782 qA[i]!) &&
    (allBelow 3 (fun i => found ir eR.tabs qA[i]!) &&
      (allBelow 3 (fun i => comp 1782 qA[i]! qA[i]! == idTab 1782) &&
        (allBelow 3 (fun i => allBelow 3 (fun j => comp 1782 qA[i]! qA[j]! == comp 1782 qA[j]! qA[i]!)) &&
          (enumOK 1782 qA eQ &&
            (eQ.tabs.size == 8 &&
              (allBelow eQ.tabs.size (fun k => comp 1782 eQ.tabs[k]! eQ.tabs[k]! == idTab 1782) &&
                (allBelow 6 (fun i => permOK 1782 cA[i]!) &&
                  (allBelow 6 (fun i => allBelow 3 (fun j => comp 1782 qA[j]! cA[i]! == comp 1782 cA[i]! qA[j]!))))))))))

@[expose] def genCheck (rA cA : Array (Array Nat)) (wA wB : List Int) : Bool :=
  let t := tenArrs rA cA
  let ti := t.map (invCand 1782)
  eqA 1782 (wordA 1782 t ti wA) b0Arr && eqA 1782 (wordA 1782 t ti wB) b1Arr

@[expose] def sylowFactsCheck (_ : Unit := ()) : Bool :=
  let rA := rArrs ()
  let rI := rA.map (invCand 1782)
  let eR := rEnum ()
  let ir := idxR ()
  let g2u := g2uArrs ()
  let g2v := g2vArrs ()
  let g2 := n2Arrs ()
  let e2 := n2Enum ()
  let i2 := idxN2 ()
  let g3u := g3uArrs ()
  let g3v := g3vArrs ()
  let g3 := n3Arrs ()
  let e3 := n3Enum ()
  let i3 := idxN3 ()
  let qA := qArrs ()
  let cA := cArrs ()
  let eQ := qEnum ()
  let zT := zTabs ()
  rWordOK () &&
    (g2WordOK () &&
      (g3WordOK () &&
        (qWordOK () &&
          (cWordOK () &&
            (wWordOK () &&
              (rCheck rA eR &&
                (n2Check rA rI g2u g2v g2 eR ir e2 &&
                  (n3Check rA rI g2 g3u g3v g3 eR e2 ir i2 e3 &&
                    (zCheck zT &&
                      (qCheck rA qA cA eR ir eQ &&
                        (genCheck rA cA waWord wbWord)))))))))))

