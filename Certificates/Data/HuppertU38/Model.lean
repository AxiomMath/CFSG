@[expose] def ptsV (i : Fin 513) : Fin 3 → GF64 := ptsVn i.val

@[expose] def vcode (v : Fin 3 → GF64) : ℕ := 4096 * (v 0).toNat + 64 * (v 1).toNat + (v 2).toNat

@[expose] def ptIdx (n : ℕ) : Fin 513 := ⟨n % 513, Nat.mod_lt _ (by norm_num)⟩

@[expose] def idxTable : Array ℕ :=
  (List.range 513).foldl (fun t i => t.set! (vcode (ptsVn i)) i) (Array.replicate 262144 0)

@[expose] def rootA (k : Fin 6) : GF64 := GF64.ofNat' (#[1, 2, 4, 8, 16, 32] : Array ℕ)[k.val]!

@[expose] def rootB (k : Fin 6) : GF64 := GF64.ofNat' (#[34, 36, 32, 2, 38, 6] : Array ℕ)[k.val]!

@[expose] def Iso3 (a b c : GF64) : Prop := a.conj8 * c + b.conj8 * b + c.conj8 * a = 0

instance (a b c : GF64) : Decidable (Iso3 a b c) :=
  inferInstanceAs (Decidable (a.conj8 * c + b.conj8 * b + c.conj8 * a = 0))

@[expose] def normV3 (a b c : GF64) : Fin 3 → GF64 :=
  if a ≠ 0 then ![1, a⁻¹ * b, a⁻¹ * c] else if b ≠ 0 then ![0, 1, b⁻¹ * c] else ![0, 0, 1]

@[expose] def NormalizedV (v : Fin 3 → GF64) : Prop :=
  v 0 = 1 ∨ (v 0 = 0 ∧ v 1 = 1) ∨ (v 0 = 0 ∧ v 1 = 0 ∧ v 2 = 1)

instance (v : Fin 3 → GF64) : Decidable (NormalizedV v) :=
  inferInstanceAs (Decidable (v 0 = 1 ∨ (v 0 = 0 ∧ v 1 = 1) ∨ (v 0 = 0 ∧ v 1 = 0 ∧ v 2 = 1)))

@[expose] def rootMat (a b : GF64) : Fin 3 → Fin 3 → GF64 :=
  ![![1, a, b], ![0, 1, a.conj8], ![0, 0, 1]]

@[expose] def weylMat : Fin 3 → Fin 3 → GF64 := ![![0, 0, 1], ![0, 1, 0], ![1, 0, 0]]

@[expose] def genMat (k : Fin 7) : Fin 3 → Fin 3 → GF64 :=
  if h : k.val < 6 then rootMat (rootA ⟨k.val, h⟩) (rootB ⟨k.val, h⟩) else weylMat

@[expose] def gramMat : Fin 3 → Fin 3 → GF64 := ![![0, 0, 1], ![0, 1, 0], ![1, 0, 0]]

@[expose] def SpecialUnitaryM (M : Fin 3 → Fin 3 → GF64) : Prop :=
  (∀ i j : Fin 3, (M 0 i).conj8 * M 2 j + (M 1 i).conj8 * M 1 j + (M 2 i).conj8 * M 0 j =
      gramMat i j) ∧
    M 0 0 * M 1 1 * M 2 2 + M 0 0 * M 1 2 * M 2 1 + M 0 1 * M 1 0 * M 2 2 + M 0 1 * M 1 2 * M 2 0 +
      M 0 2 * M 1 0 * M 2 1 + M 0 2 * M 1 1 * M 2 0 = 1

instance (M : Fin 3 → Fin 3 → GF64) : Decidable (SpecialUnitaryM M) :=
  inferInstanceAs (Decidable ((∀ i j : Fin 3, (M 0 i).conj8 * M 2 j + (M 1 i).conj8 * M 1 j +
      (M 2 i).conj8 * M 0 j = gramMat i j) ∧
    M 0 0 * M 1 1 * M 2 2 + M 0 0 * M 1 2 * M 2 1 + M 0 1 * M 1 0 * M 2 2 + M 0 1 * M 1 2 * M 2 0 +
      M 0 2 * M 1 0 * M 2 1 + M 0 2 * M 1 1 * M 2 0 = 1))

@[expose] def mulVec3 (M : Fin 3 → Fin 3 → GF64) (v : Fin 3 → GF64) : Fin 3 → GF64 :=
  fun i => M i 0 * v 0 + M i 1 * v 1 + M i 2 * v 2

@[expose] def GenAct (k : Fin 7) (j : Fin 513) : Prop :=
  (mulVec3 (genMat k) (ptsV j) 0 ≠ 0 ∨ mulVec3 (genMat k) (ptsV j) 1 ≠ 0 ∨
      mulVec3 (genMat k) (ptsV j) 2 ≠ 0) ∧
    ∃ t : Fin 513, (t : ℕ) = (gensO[k.val]!)[j.val]! ∧
      normV3 (mulVec3 (genMat k) (ptsV j) 0) (mulVec3 (genMat k) (ptsV j) 1)
        (mulVec3 (genMat k) (ptsV j) 2) = ptsV t

instance (k : Fin 7) (j : Fin 513) : Decidable (GenAct k j) := by unfold GenAct; infer_instance

