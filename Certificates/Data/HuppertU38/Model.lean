structure GF64 where
  val : Fin 64

instance : DecidableEq GF64 := fun a b =>
  if h : a.val = b.val then isTrue (by cases a; cases b; simp_all)
  else isFalse (fun e => h (e ▸ rfl))

namespace GF64

@[expose] def ofNat' (n : ℕ) : GF64 := ⟨⟨n % 64, Nat.mod_lt n (by norm_num)⟩⟩

@[expose] def toNat (a : GF64) : ℕ := a.val.val

@[expose] def mulNat (a b : ℕ) : ℕ :=
  let r := (if b &&& 1 = 1 then a else 0) ^^^ (if b &&& 2 = 2 then a <<< 1 else 0) ^^^
    (if b &&& 4 = 4 then a <<< 2 else 0) ^^^ (if b &&& 8 = 8 then a <<< 3 else 0) ^^^
    (if b &&& 16 = 16 then a <<< 4 else 0) ^^^ (if b &&& 32 = 32 then a <<< 5 else 0)
  let r := if r &&& 1024 = 1024 then r ^^^ 1072 else r
  let r := if r &&& 512 = 512 then r ^^^ 536 else r
  let r := if r &&& 256 = 256 then r ^^^ 268 else r
  let r := if r &&& 128 = 128 then r ^^^ 134 else r
  if r &&& 64 = 64 then r ^^^ 67 else r

instance : Zero GF64 := ⟨ofNat' 0⟩
instance : One GF64 := ⟨ofNat' 1⟩
instance : Add GF64 := ⟨fun a b => ofNat' (a.toNat ^^^ b.toNat)⟩
instance : Neg GF64 := ⟨fun a => a⟩
instance : Mul GF64 := ⟨fun a b => ofNat' (mulNat a.toNat b.toNat)⟩
instance : Inv GF64 :=
  ⟨fun a =>
    let a2 := mulNat a.toNat a.toNat
    let a4 := mulNat a2 a2
    let a8 := mulNat a4 a4
    let a16 := mulNat a8 a8
    let a32 := mulNat a16 a16
    ofNat' (mulNat a32 (mulNat a16 (mulNat a8 (mulNat a4 a2))))⟩
instance : Fintype GF64 :=
  Fintype.ofEquiv (Fin 64) ⟨GF64.mk, GF64.val, fun _ => rfl, fun _ => rfl⟩

@[expose] def conj8 (a : GF64) : GF64 := a * a * a * a * a * a * a * a

end GF64

