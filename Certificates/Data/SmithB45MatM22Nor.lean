open CFSG.CharacterTheory.SteinbergBY FieldFour

@[expose] def decVecF2 (n r : ℕ) : Vector (ZMod 2) n :=
  Vector.ofFn fun j => if r.testBit j then 1 else 0

@[expose] def decVecF4 (n r : ℕ) : Vector FieldFour n :=
  Vector.ofFn fun j => ⟨r.testBit (2 * j), r.testBit (2 * j + 1)⟩

@[expose] def ofCode4 (c : ℕ) : FieldFour := ⟨c.testBit 0, c.testBit 1⟩

@[expose] def boolWord (w : List ℕ) : List Bool := w.map (· == 2)

@[expose] def boolProg (p : List (ℕ × ℕ)) : List (ℕ × Bool) := p.map fun e => (e.1, e.2 == 2)

@[expose] def spinF2 (n : ℕ) (tw : List (List ℕ)) (tc : List ℕ) (Q Qi R Si Ti : List ℕ) (w : ℕ)
    (spin dual : List (ℕ × ℕ)) : SpinData (ZMod 2) n where
  terms := (tw.zip tc).map fun p => (boolWord p.1, (p.2 : ZMod 2))
  Q := decF2 n n Q
  Qi := decF2 n n Qi
  R := decF2 n n R
  spin := boolProg spin
  Si := decF2 n n Si
  w := decVecF2 n w
  dual := boolProg dual
  Ti := decF2 n n Ti

@[expose] def spinF4 (n : ℕ) (tw : List (List ℕ)) (tc : List ℕ) (Q Qi R Si Ti : List ℕ) (w : ℕ)
    (spin dual : List (ℕ × ℕ)) : SpinData FieldFour n where
  terms := (tw.zip tc).map fun p => (boolWord p.1, ofCode4 p.2)
  Q := decF4 n n Q
  Qi := decF4 n n Qi
  R := decF4 n n R
  spin := boolProg spin
  Si := decF4 n n Si
  w := decVecF4 n w
  dual := boolProg dual
  Ti := decF4 n n Ti


