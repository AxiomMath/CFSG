@[expose] def conjA (g x : Array ℕ) : Array ℕ := mulA (mulA g x) (invA g)

@[expose] def conjInvA (g x : Array ℕ) : Array ℕ := mulA (mulA (invA g) x) g

@[expose] def jArr : Array ℕ := conjA a1Arr eArr

@[expose] def v1Arr : Array ℕ := conjInvA a1Arr titsZArr

@[expose] def v2Arr : Array ℕ := conjA eArr v1Arr

