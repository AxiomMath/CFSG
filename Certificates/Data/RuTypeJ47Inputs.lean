    eqA 1755 (mulA abArr uArr) (mulA uArr abArr) && normB aaArr && normB abArr &&
    (allLt 16 fun p => allLt 16 fun q => p == q || !(eqA 1755 (prodI p) (prodI q))) &&
    allLt 16 fun p => !(eqA 1755 (mulA (prodI p) (prodI p)) (idA 1755)) ||
      eqA 1755 (prodI p) (idA 1755) || eqA 1755 (prodI p) titsZArr || eqA 1755 (prodI p) uArr ||
      eqA 1755 (prodI p) tArr

@[expose] def checkFix : Bool := ptFixCount uArr == 91 && ptFixCount tArr == 27

@[expose] def checkBall : Bool :=
  onLine 0 0 && onLine 1 0 && onLine 1 5 && onLine 10 5 && ballFixed uArr 10 &&
