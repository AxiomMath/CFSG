@[expose] def j3CovSift (x : Array ℕ) : Bool :=
  isInvA 6156 x (invCand 6156 x) &&
    siftA 6156 CFSG.Sporadic.Schreier.PairJ3.levels CFSG.Sporadic.Schreier.PairJ3.baseArr 0 x

@[expose] def j3CovConj (q t : Array ℕ) : Array ℕ := compA 6156 (compA 6156 q t) (invCand 6156 q)

@[expose] def j3CovInQ (t q : Array ℕ) : Bool :=
  eqA 6156 (j3CovConj t q) (j3CovArr 0) || eqA 6156 (j3CovConj t q) (j3CovArr 1) ||
    eqA 6156 (j3CovConj t q) (compA 6156 (j3CovArr 0) (j3CovArr 1))

@[expose] def j3CovProd (u : ℕ) : Array ℕ := pN 6156 (j3CovArr 2) (j3CovArr 3) (u % 3, u / 3)

@[expose] def j3CovDistinct : Bool :=
  (List.range 9).all fun u => (List.range 9).all fun v =>
    u == v || !eqA 6156 (j3CovProd u) (j3CovProd v)

