@[expose] def entR (m : List (List ℕ)) (i j : ℕ) : ℕ :=
  (m.getD i []).getD j 0

@[expose] def decR (m : List (List ℕ)) : Matrix (Fin 21) (Fin 21) (ZMod 3) :=
  Matrix.of fun i j => ((entR m i j : ℕ) : ZMod 3)

@[expose] def mulR (a b : List (List ℕ)) : List (List ℕ) :=
  (List.range 21).map fun i => (List.range 21).map fun j =>
    ((List.range 21).map fun k => entR a i k * entR b k j).sum % 3

@[expose] def oneR : List (List ℕ) :=
  (List.range 21).map fun i => (List.range 21).map fun j => if i = j then 1 else 0

@[expose] def colR (v : List ℕ) : List (List ℕ) :=
  (List.range 21).map fun i => (List.range 21).map fun j => if j = 0 then v.getD i 0 else 0

