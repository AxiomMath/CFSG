@[expose] def L (_ : Unit := ()) : Array (Array Nat) :=
  let a := parseNats LStr
  Array.ofFn (n := 3) fun j => Array.ofFn (n := nS) fun i => a[j.val * nS + i.val]!

@[expose] def aRows (_ : Unit := ()) : Rows := CFSG.Sporadic.Co1.Native.co1Data.rowsA

@[expose] def bRows (_ : Unit := ()) : Rows := CFSG.Sporadic.Co1.Native.co1Data.rowsB

@[expose] def biRows (_ : Unit := ()) : Rows := mul bRows bRows

@[expose] def regsM (_ : Unit := ()) : Array Rows :=
  buildN #[aRows, bRows, biRows]
    (fun acc k => mul (acc[(ops[k - 3]!).1]!) (acc[(ops[k - 3]!).2]!)) ops.size

@[expose] def genM (j : Nat) : Rows := regsM[gens[j]!]!

@[expose] def eltsM (_ : Unit := ()) : Array Rows :=
  buildN #[one] (fun acc i => mul (genM (par[i]!).2) (acc[(par[i]!).1]!)) (nS - 1)

@[expose] def invOK (_ : Unit := ()) : Bool := mul bRows biRows == one

@[expose] def shapeOK (_ : Unit := ()) : Bool :=
  ops.size == 1153 && gens.size == 3 && par.size == nS && L.size == 3 &&
  (List.range ops.size).all (fun t => (ops[t]!).1 < t + 3 && (ops[t]!).2 < t + 3) &&
  (List.range gens.size).all (fun j => gens[j]! < ops.size + 3) &&
  (List.range nS).all (fun i => i == 0 || ((par[i]!).1 < i && (par[i]!).2 < 3))

@[expose] def leftOK (_ : Unit := ()) : Bool :=
  (List.range 3).all fun j => (List.range nS).all fun i =>
    (L[j]!)[i]! < nS && mul (genM j) (eltsM[i]!) == eltsM[(L[j]!)[i]!]!

@[expose] def canonOK (_ : Unit := ()) : Bool :=
  eltsM.size == nS && (List.range nS).all fun i => wf (eltsM[i]!)

@[expose] def distinctOK (_ : Unit := ()) : Bool :=
  (List.range nS).all fun i => (List.range i).all fun k => eltsM[i]! != eltsM[k]!

@[expose] def killOK (_ : Unit := ()) : Bool :=
  (List.range nS).all fun a =>
    a == 0 || tabMul par L a (tabMul par L a a) != 0 || 81 ≤ tabComm par L nS a

@[expose] def co1S0Check (_ : Unit := ()) : Bool :=
  invOK && shapeOK && killOK && canonOK && leftOK && distinctOK

end CFSG.Sporadic.Co1.S0
