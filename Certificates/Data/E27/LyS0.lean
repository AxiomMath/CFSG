@[expose] def L (_ : Unit := ()) : Array (Array Nat) :=
  let a := parseNats LStr
  Array.ofFn (n := 5) fun j => Array.ofFn (n := nS) fun i => a[j.val * nS + i.val]!

@[expose] def regsM (_ : Unit := ()) : Array (Array (Array Nat)) :=
  buildN #[matA, matB]
    (fun acc k => mulM 5 111 (acc[(ops[k - 2]!).1]!) (acc[(ops[k - 2]!).2]!)) ops.size

@[expose] def genM (j : Nat) : Array (Array Nat) := regsM[gens[j]!]!

@[expose] def eltsM (_ : Unit := ()) : Array (Array (Array Nat)) :=
  buildN #[idM 111]
    (fun acc i => mulM 5 111 (genM (par[i]!).2) (acc[(par[i]!).1]!)) (nS - 1)

@[expose] def shapeOK (_ : Unit := ()) : Bool :=
  ops.size == 745 && gens.size == 5 && par.size == nS && L.size == 5 &&
  (List.range ops.size).all (fun t => (ops[t]!).1 < t + 2 && (ops[t]!).2 < t + 2) &&
  (List.range gens.size).all (fun j => gens[j]! < ops.size + 2) &&
  (List.range nS).all (fun i => i == 0 || ((par[i]!).1 < i && (par[i]!).2 < 5))

@[expose] def leftOK (_ : Unit := ()) : Bool :=
  (List.range 5).all fun j => (List.range nS).all fun i =>
    (L[j]!)[i]! < nS && matEqB 5 111 (mulM 5 111 (genM j) (eltsM[i]!)) (eltsM[(L[j]!)[i]!]!)

@[expose] def distinctOK (_ : Unit := ()) : Bool :=
  (List.range nS).all fun i => (List.range i).all fun k =>
    !matEqB 5 111 (eltsM[i]!) (eltsM[k]!)

@[expose] def killOK (_ : Unit := ()) : Bool :=
  (List.range nS).all fun a =>
    a == 0 || tabMul par L a (tabMul par L a a) != 0 || 81 ≤ tabComm par L nS a

@[expose] def lyS0Check (_ : Unit := ()) : Bool :=
  shapeOK && killOK && leftOK && distinctOK

end CFSG.Sporadic.Ly.S0
