@[expose] def L (_ : Unit := ()) : Array (Array Nat) :=
  let a := parseNats LStr
  Array.ofFn (n := 3) fun j => Array.ofFn (n := nS) fun i => a[j.val * nS + i.val]!

@[expose] def regsM (_ : Unit := ()) : Array (Array V) :=
  buildN #[matA, matB, matBi]
    (fun acc k => mul 77 (acc[(ops[k - 3]!).1]!) (acc[(ops[k - 3]!).2]!)) ops.size

@[expose] def genM (j : Nat) : Array V := regsM[gens[j]!]!

@[expose] def eltsM (_ : Unit := ()) : Array (Array V) :=
  buildN #[idM 77] (fun acc i => mul 77 (genM (par[i]!).2) (acc[(par[i]!).1]!)) (nS - 1)

@[expose] def shapeOK (_ : Unit := ()) : Bool :=
  ops.size == 567 && gens.size == 3 && par.size == nS && L.size == 3 &&
  (List.range ops.size).all (fun t => (ops[t]!).1 < t + 3 && (ops[t]!).2 < t + 3) &&
  (List.range gens.size).all (fun j => gens[j]! < ops.size + 3) &&
  (List.range nS).all (fun i => i == 0 || ((par[i]!).1 < i && (par[i]!).2 < 3))

@[expose] def leftOK (_ : Unit := ()) : Bool :=
  (List.range 3).all fun j => (List.range nS).all fun i =>
    (L[j]!)[i]! < nS && eqM 77 (mul 77 (genM j) (eltsM[i]!)) (eltsM[(L[j]!)[i]!]!)

@[expose] def canonOK (_ : Unit := ()) : Bool :=
  eltsM.size == nS && (List.range nS).all fun i => canonM 77 (eltsM[i]!)

@[expose] def distinctOK (_ : Unit := ()) : Bool :=
  (List.range nS).all fun i => (List.range i).all fun k =>
    !eqM 77 (eltsM[i]!) (eltsM[k]!)

@[expose] def killOK (_ : Unit := ()) : Bool :=
  (List.range nS).all fun a =>
    a == 0 || tabMul par L a (tabMul par L a a) != 0 || 81 ≤ tabComm par L nS a

@[expose] def fi22S0Check (_ : Unit := ()) : Bool :=
  shapeOK && killOK && canonOK && leftOK && distinctOK

end CFSG.Sporadic.Fi22.S0
