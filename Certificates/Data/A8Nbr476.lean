@[expose] def ofRows (r : List (List (ZMod 7))) : M4 :=
  Matrix.of fun i j => (r.getD i.val []).getD j.val 0

@[expose] def A8Claim : Prop :=
  allCases.length = 516 ∧
  (∀ c ∈ allCases, bas c * basInv c = 1 ∧ basInv c * bas c = 1 ∧ psi c * psiInv c = 1 ∧
    psiInv c * psi c = 1) ∧
  (∀ c ∈ allCases, c ∉ excCases → c ∈ wordData.map Prod.fst) ∧
  (∀ e ∈ wordData, IsTransv ((e.2.map (gens e.1)).prod)) ∧
  monData.map Prod.fst = excCases ∧ (∀ c ∈ excCases, c ∈ allCases) ∧
  ∀ e ∈ monData, ofRows e.2.1 * ofRows e.2.2 = 1 ∧
    ∀ k : Fin 6, IsMonCube (ofRows e.2.1 * gens e.1 k * ofRows e.2.2)

abbrev Arr := Array (Array (ZMod 7))

@[expose] def toMat (T : Arr) : M4 := Matrix.of fun i j => (T.getD i.val #[]).getD j.val 0

@[expose] def tab (A : M4) : Arr := Array.ofFn fun i : Fin 4 => Array.ofFn fun j : Fin 4 => A i j

theorem toMat_tab (A : M4) : toMat (tab A) = A := by
  ext i j
  simp [toMat, tab, Array.getD_eq_getD_getElem?]

@[expose] def amul (A B : Arr) : Arr := tab (toMat A * toMat B)

theorem toMat_amul (A B : Arr) : toMat (amul A B) = toMat A * toMat B := toMat_tab _

@[expose] def aprod : List Arr → Arr
  | [] => tab 1
  | a :: l => amul a (aprod l)

theorem toMat_aprod (l : List Arr) : toMat (aprod l) = (l.map toMat).prod := by
  induction l with
  | nil => exact toMat_tab 1
  | cons a l ih => simp [aprod, toMat_amul, ih]

@[expose] def gensA (c : Case) (k : Fin 6) : Arr := tab (gens c k)

theorem toMat_gensA (c : Case) (k : Fin 6) : toMat (gensA c k) = gens c k := toMat_tab _

@[expose] def A8ClaimA : Prop :=
  allCases.length = 516 ∧
  (∀ c ∈ allCases, bas c * basInv c = 1 ∧ basInv c * bas c = 1 ∧ psi c * psiInv c = 1 ∧
    psiInv c * psi c = 1) ∧
  (∀ c ∈ allCases, c ∉ excCases → c ∈ wordData.map Prod.fst) ∧
  (∀ e ∈ wordData, IsTransv (toMat (aprod (e.2.map (gensA e.1))))) ∧
  monData.map Prod.fst = excCases ∧ (∀ c ∈ excCases, c ∈ allCases) ∧
  ∀ e ∈ monData, ofRows e.2.1 * ofRows e.2.2 = 1 ∧
    ∀ k : Fin 6, IsMonCube (toMat (aprod [tab (ofRows e.2.1), gensA e.1 k, tab (ofRows e.2.2)]))

set_option synthInstance.maxSize 2048 in
instance : Decidable A8ClaimA := by unfold A8ClaimA; infer_instance

theorem a8ClaimA_iff : A8ClaimA ↔ A8Claim := by
  rw [A8Claim, A8ClaimA]
  simp only [toMat_aprod, List.map_map, Function.comp_def, toMat_gensA, List.map_cons,
    List.map_nil, List.prod_cons, List.prod_nil, mul_one, toMat_tab, mul_assoc]

@[expose] def check (_ : Unit := ()) : Bool := decide A8ClaimA

theorem a8Claim_of_check (h : check () = true) : A8Claim :=
  a8ClaimA_iff.mp (of_decide_eq_true h)

