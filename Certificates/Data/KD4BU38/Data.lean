@[expose] def pgu38Arr (k : ℕ) : Array ℕ := hexTable 3 513 (513 * k) pgu38Hex

@[expose] def pgu38SylowGens : Array (Array ℕ) := Array.ofFn fun j : Fin 3 => pgu38Arr j.val

@[expose] def pgu38SylowExp : Array ℕ := #[1, 2, 0]

@[expose] def pgu38ClassReps : Array (Array ℕ) := Array.ofFn fun j : Fin 10 => pgu38Arr (3 + j.val)

@[expose] def pgu38RepConj : Array (Array ℕ) := Array.ofFn fun j : Fin 10 => pgu38Arr (13 + j.val)

@[expose] def pgu38RepConjExp : Array ℕ := #[0, 2, 0, 0, 0, 2, 1, 0, 0, 1]

@[expose] def pgu38RepIdx : Array ℕ := #[7, 8, 2, 0, 3]

@[expose] def pgu38FrobConj : Array (Array ℕ) := Array.ofFn fun j : Fin 5 => pgu38Arr (23 + j.val)

@[expose] def pgu38FrobConjExp : Array ℕ := #[2, 2, 2, 1, 2]

@[expose] def pgu38Key : List ℕ := [0, 167, 270]

@[expose] def pgu38SylowEnum (_ : Unit := ()) : ArrCert := enumBfs 513 pgu38SylowGens pgu38Key 300

@[expose] def pgu38SiftX (t : Array ℕ) : Bool :=
  siftA 513 (rawLevels 513 strong3 (base3L.map Fin.val).toArray) (base3L.map Fin.val).toArray 0 t

@[expose] def pgu38ClassCheck (L : Array (Array ℕ)) : Bool :=
  allLt L.size fun i =>
    !(eqA 513 (CFSG.Monster.B.Mathieu.powArr 513 L[i]! 3) (idA 513) && !eqA 513 L[i]! (idA 513)) ||
      (List.range L.size).any fun h => (List.range 10).any fun j =>
        eqA 513 (conjA 513 L[h]! L[i]!) pgu38ClassReps[j]!

end CFSG.LocalAnalysis.GLTheoremA.KD264Lie.PGU38Classes
