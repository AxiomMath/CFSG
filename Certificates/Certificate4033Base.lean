section Congr

variable {Lab : Type} [DecidableEq Lab] [Hashable Lab] [Inhabited Lab]
  {act : Array ℕ → Lab → Lab} {D D' : LatData Lab}

theorem membersOK_of {n : ℕ} {ta tb : Array ℕ} {Δ : Lab} (h1 : D.mw = D'.mw) (h2 : D.mt = D'.mt)
    (h3 : D.Om = D'.Om) (h4 : D.sTabs = D'.sTabs) (h : MembersOK act n ta tb Δ D) :
    MembersOK act n ta tb Δ D' := by
  unfold MembersOK at h ⊢
  rw [← h1, ← h2, ← h3, ← h4]
  exact h

theorem o2OK_of {Ot Ot' : Array (OmegaData (List Lab))} (h1 : D.mw = D'.mw) (h3 : D.Om = D'.Om)
    (h4 : D.sTabs = D'.sTabs) (h5 : Ot = Ot') (h : O2OK act D Ot) : O2OK act D' Ot' := by
  unfold O2OK at h ⊢
  rw [← h1, ← h3, ← h4, ← h5]
  exact h

end Congr

theorem om_eq : He.heLatK.Om = CFSG.KD.HeDc.heLatK.Om := rfl

theorem ot_eq : CFSG.KD.HeDc.heOtK = He.heOtK := rfl

