@[expose] def invL (l : PL) : PL := (List.range 45).map fun i => ((List.range 45).find? fun j => l.getD j 0 == i).getD 0

@[expose] def c3pow : Nat → PL
  | 0 => idL
  | n+1 => comp c3L (c3pow n)

@[expose] def letterL (r : PL) (i : Nat) : PL :=
  if i < 5 then gTL i else if i = 5 then r else if i = 6 then invL r else invL (gTL (i - 7))

@[expose] def wordL (r : PL) (w : List Nat) : PL := w.foldl (fun acc i => comp acc (letterL r i)) idL

