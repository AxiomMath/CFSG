@[expose] def chkLatT : Bool :=
  latTData.length == 54 && latTData.all fun (j, a, b, w) =>
    let r := comp (comp (c3pow a) (DL j)) (c3pow b)
    (r.getD 0 0 != 0) && (wordL r w == c3L)

theorem chkLatT_true : chkLatT = true := by decide +kernel

