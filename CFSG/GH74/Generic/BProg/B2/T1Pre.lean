variable {G : Type} [Group G]

structure Stage2Concl1Pre (x : G) (K M Q H : Subgroup G) : Prop where
  K_le : K ≤ M
  Q_le : Q ≤ M
  Q_syl : IsSylowOf 2 Q (M ⊓ centralizerSection K (pPrimeCoreOf 2 K))
  H_min : IsMinSubnormalIn K M H
  H_tri : HTri x K M H

theorem Stage2Concl1Pre.toCore {x : G} {K M Q H : Subgroup G} (h : Stage2Concl1Pre x K M Q H)
    (hG2 : ∀ L : Subgroup (Mbar M), IsComponent L → L ≤ barIn M H → GLS.InG2 ↥L)
    (hO : pPrimeCoreOf 2 M ≠ ⊥) : Stage2Concl1Core x K M Q H :=
  ⟨h.K_le, h.Q_le, h.Q_syl, h.H_min, hG2, h.H_tri, hO⟩

end Pre

variable {G : Type} [Group G] [Finite G] {x : G} {K A M P Q : Subgroup G}

theorem components_c1_pre (hs : Stage2Setup G x K A M P Q) {H : Subgroup G}
    (h1 : Stage2Concl1Pre x K M Q H) (hc1 : barIn M H = barIn M K) :
    IsComponent (barIn M K) ∧ ∀ J : Subgroup (Mbar M), IsComponent J → J ≠ barIn M K →
      J ≤ SD.centBarK M K := by
  have hHsub : (barIn M H).IsSubnormal :=
    Subgroup.IsSubnormal.map (QuotientGroup.mk'_surjective _) h1.H_min.2.1.2
  have hKc : IsComponent (barIn M K) :=
    isComponent_barIn_of_isSubnormal hs h1.K_le (hc1 ▸ hHsub)
  refine ⟨hKc, fun J hJ hJK => ?_⟩
  rcases CFSG.LocalCores.distinct_components_commute hJ hKc with h | h
  · exact absurd h hJK
  · exact Subgroup.commutator_eq_bot_iff_le_centralizer.1 h

theorem shapeInCent_of_simple_pre (hB : B_B2_g4) (hs : Stage2Setup G x K A M P Q) {H : Subgroup G}
    (h1 : Stage2Concl1Pre x K M Q H) (hF : barIn M H = generalizedFitting (Mbar M))
    (hsimple : IsSimpleGroup ↥(barIn M H)) :
    ∃ hxM : x ∈ M,
      ShapeInCent (barIn M H) (QuotientGroup.mk (⟨x, hxM⟩ : ↥M) : Mbar M) (barIn M K) := by
  have hxM : x ∈ M := h1.Q_le (x_mem_Q hs)
  have hcomp := barIn_K_isCompIn hB hs h1.K_le hxM
  have hKH : K ≤ H := h1.H_min.1
  have hbarKH : barIn M K ≤ barIn M H := by
    rintro _ ⟨m, hm, rfl⟩
    exact ⟨m, hKH hm, rfl⟩
  have hnonab := Thm2AssemblyC2.barIn_nonabelian_of_simple hs h1.K_le hF hsimple
  refine ⟨hxM, ?_⟩
  exact
    { normal := by
        rw [hF]
        exact (CFSG.LocalCores.generalized_fitting_characteristic).2
      simple := hsimple
      faithful := Thm2AssemblyC2.faithful_of_simple hF hsimple hnonab
      inv := Prop31.orderOf_mk_involution hxM hs.pair.1.1.1.1
      comp := Prop31.isCompIn_of_le (le_inf hbarKH hcomp.1) inf_le_right hcomp
      shape := Prop31.exists_shape hs h1.K_le (Prop31.isQuasisimple_of_isCompIn hcomp) }

theorem ghList_of_simple_pre (hs : Stage2Setup G x K A M P Q) {H : Subgroup G}
    (h1 : Stage2Concl1Pre x K M Q H) (hF : barIn M H = generalizedFitting (Mbar M))
    (hsimple : IsSimpleGroup ↥(barIn M H)) : GHList ↥(barIn M H) :=
  GLS.IVK.ghList_of_subgroup_of_quotient hs.hyp.kgh hs.maxM.1
    (QuotientGroup.mk' (pPrimeCore 2 ↥M)) (QuotientGroup.mk'_surjective _) (barIn M H)
    hsimple (Thm2AssemblyC2.barIn_nonabelian_of_simple hs h1.K_le hF hsimple)

theorem puTargetG4_of_c2_pre (hL4m : TA7.RefinePuL4) (hG2 : TA7.RefinePuG2) (hB : B_B2_g4)
    (hPump : PumpupTableU) (hs : Stage2Setup G x K A M P Q) {H : Subgroup G}
    (h1 : Stage2Concl1Pre x K M Q H) (hF : barIn M H = generalizedFitting (Mbar M))
    (hsimple : IsSimpleGroup ↥(barIn M H)) : PuTargetG4 ↥(barIn M H) := by
  obtain ⟨hxM, hSh⟩ := shapeInCent_of_simple_pre hB hs h1 hF hsimple
  rcases hPump (Mbar M) (barIn M H) _ (barIn M K) hSh
      (ghList_of_simple_pre hs h1 hF hsimple) with h5 | h4 | h3 | hg
  · exact Or.inl h5
  · exact Or.inr (Or.inl
      (hL4m (Mbar M) (barIn M H) _ (barIn M K) hSh (sectionalTwoRankLE_Mbar hs) h4))
  · exact Or.inr (Or.inr (Or.inl h3))
  · exact Or.inr (Or.inr (Or.inr (hG2 (Mbar M) (barIn M H) _ (barIn M K) hSh hg)))

theorem qShapeNS_of_swap_pre (hB : B_B2_g4) (hs : Stage2Setup G x K A M P Q) {H : Subgroup G}
    (h1 : Stage2Concl1Pre x K M Q H) (hxM : x ∈ M) {L₁ L₂ : Subgroup (Mbar M)}
    (hL₁ : IsComponent L₁) (hL₂ : IsComponent L₂) (hne : L₁ ≠ L₂) (hs₁ : IsSimpleGroup ↥L₁)
    (hsup : barIn M H = L₁ ⊔ L₂)
    (h12 : ∀ a ∈ L₁, (QuotientGroup.mk (⟨x, hxM⟩ : ↥M) : Mbar M) * a *
      (QuotientGroup.mk (⟨x, hxM⟩ : ↥M) : Mbar M)⁻¹ ∈ L₂)
    (h21 : ∀ b ∈ L₂, (QuotientGroup.mk (⟨x, hxM⟩ : ↥M) : Mbar M) * b *
      (QuotientGroup.mk (⟨x, hxM⟩ : ↥M) : Mbar M)⁻¹ ∈ L₁) : QShapeNS ↥L₁ := by
  have := hs₁
  set t : Mbar M := (QuotientGroup.mk (⟨x, hxM⟩ : ↥M) : Mbar M) with htdef
  have ht2 : orderOf t = 2 := Prop31.orderOf_mk_involution hxM hs.pair.1.1.1.1
  have ht : t * t = 1 := by
    have := pow_orderOf_eq_one t
    rwa [ht2, pow_two] at this
  have hc : ∀ a ∈ L₁, ∀ b ∈ L₂, a * b = b * a := by
    intro a ha b hb
    have hle : L₁ ≤ centralizer (L₂ : Set (Mbar M)) :=
      Subgroup.commutator_eq_bot_iff_le_centralizer.1
        ((CFSG.LocalCores.distinct_components_commute hL₁ hL₂).resolve_left hne)
    exact (Subgroup.mem_centralizer_iff.1 (hle ha) b hb).symm
  have hZ1 : center ↥L₁ = ⊥ :=
    Thm2AssemblyC3.center_eq_bot_of_simple_quasisimple hL₁.1 hs₁
  have hcap : L₁ ⊓ L₂ = ⊥ := by
    rw [eq_bot_iff]
    intro z hz
    have hzc : (⟨z, hz.1⟩ : ↥L₁) ∈ center ↥L₁ := by
      rw [Subgroup.mem_center_iff]
      intro g
      exact Subtype.ext (hc g g.2 z hz.2)
    rw [hZ1, Subgroup.mem_bot] at hzc
    exact Subgroup.mem_bot.2 (congrArg Subtype.val hzc)
  obtain ⟨e⟩ := Thm2AssemblyC3.mulEquiv_centralizer_of_swap ht hc hcap h12 h21
  set N : Subgroup (Mbar M) := (L₁ ⊔ L₂) ⊓ centralizer ({t} : Set (Mbar M)) with hN
  have hNsimple : IsSimpleGroup ↥N := e.symm.isSimpleGroup
  have hcomp := barIn_K_isCompIn hB hs h1.K_le hxM
  have hKH : K ≤ H := h1.H_min.1
  have hbarKH : barIn M K ≤ L₁ ⊔ L₂ := by
    rw [← hsup]
    rintro _ ⟨m, hm, rfl⟩
    exact ⟨m, hKH hm, rfl⟩
  have hcomp' : IsCompIn N (barIn M K) :=
    Prop31.isCompIn_of_le (le_inf hbarKH hcomp.1) inf_le_right hcomp
  have hKN : barIn M K = N := Thm2AssemblyC3.eq_of_isCompIn_of_simple hNsimple hcomp'
  have hKq : IsQuasisimple ↥(barIn M K) := Prop31.isQuasisimple_of_isCompIn hcomp
  let e' : ↥(barIn M K) ≃* ↥L₁ := (MulEquiv.subgroupCongr hKN).trans e.symm
  have hKsimple : IsSimpleGroup ↥(barIn M K) := e'.isSimpleGroup
  obtain ⟨Z, hZc, -, hZn, hZshape⟩ := Prop31.exists_shape hs h1.K_le hKq
  have hZbot : Z = ⊥ := by
    have := Thm2AssemblyC3.center_eq_bot_of_simple_quasisimple hKq hKsimple
    rw [this] at hZc
    exact le_bot_iff.1 hZc
  subst hZbot
  exact QShapeNS.of_mulEquiv e'
    (QShapeNS.of_mulEquiv (QuotientGroup.quotientBot (G := ↥(barIn M K))) hZshape)

theorem listedK_of_c3_pre (hB : B_B2_g4) (hs : Stage2Setup G x K A M P Q) {H : Subgroup G}
    (h1 : Stage2Concl1Pre x K M Q H) (hxM : x ∈ M) {L₁ L₂ : Subgroup (Mbar M)}
    (hL₁ : IsComponent L₁) (hL₂ : IsComponent L₂) (hne : L₁ ≠ L₂) (hs₁ : IsSimpleGroup ↥L₁)
    (hs₂ : IsSimpleGroup ↥L₂) (hsup : barIn M H = L₁ ⊔ L₂)
    (hconj : L₁.map (MulAut.conj (QuotientGroup.mk (⟨x, hxM⟩ : ↥M) : Mbar M)).toMonoidHom = L₂) :
    ListedK ↥L₁ ∧ ListedK ↥L₂ := by
  set t : Mbar M := (QuotientGroup.mk (⟨x, hxM⟩ : ↥M) : Mbar M) with htdef
  have ht2 : orderOf t = 2 := Prop31.orderOf_mk_involution hxM hs.pair.1.1.1.1
  have ht : t * t = 1 := by
    have := pow_orderOf_eq_one t
    rwa [ht2, pow_two] at this
  have htinv : t⁻¹ = t := inv_eq_of_mul_eq_one_right ht
  have h12 : ∀ a ∈ L₁, t * a * t⁻¹ ∈ L₂ := by
    intro a ha
    have := Subgroup.mem_map_of_mem (MulAut.conj t).toMonoidHom ha
    rw [hconj] at this
    simpa using this
  have h21 : ∀ b ∈ L₂, t * b * t⁻¹ ∈ L₁ := by
    intro b hb
    rw [← hconj] at hb
    obtain ⟨a, ha, rfl⟩ := hb
    have e : t * ((MulAut.conj t).toMonoidHom a) * t⁻¹ = a := by
      show t * (t * a * t⁻¹) * t⁻¹ = a
      rw [htinv]
      calc t * (t * a * t) * t = (t * t) * a * (t * t) := by group
        _ = a := by rw [ht]; simp
    rw [e]; exact ha
  refine ⟨qShapeNS_of_swap_pre hB hs h1 hxM hL₁ hL₂ hne hs₁ hsup h12 h21,
    qShapeNS_of_swap_pre hB hs h1 hxM hL₂ hL₁ hne.symm hs₂ (by rw [hsup, sup_comm]) h21 h12⟩

theorem listedPair_of_c3_pre (hB : B_B2_g4) (hs : Stage2Setup G x K A M P Q) {H : Subgroup G}
    (h1 : Stage2Concl1Pre x K M Q H) (hxM : x ∈ M)
    {L₁ L₂ : Subgroup (Mbar M)} (hL₁ : IsComponent L₁) (hL₂ : IsComponent L₂) (hne : L₁ ≠ L₂)
    (hs₁ : IsSimpleGroup ↥L₁) (hs₂ : IsSimpleGroup ↥L₂) (hsup : barIn M H = L₁ ⊔ L₂)
    (hconj : L₁.map (MulAut.conj (QuotientGroup.mk (⟨x, hxM⟩ : ↥M) : Mbar M)).toMonoidHom = L₂) :
    ListedPair ↥L₁ ∧ ListedPair ↥L₂ := by
  obtain ⟨h₁, h₂⟩ := listedK_of_c3_pre hB hs h1 hxM hL₁ hL₂ hne hs₁ hs₂ hsup hconj
  exact ⟨listedPair_of_qShapeNS hL₁.1 hs₁ h₁, listedPair_of_qShapeNS hL₂.1 hs₂ h₂⟩

theorem stage2Concl1Pre_of (hB : B_B2_g4) (h1 : GenConj QShape1 8) (h3 : ShapeGenFor QShape3 4)
    (h4 : ShapeGenFor QShape4 4) (h5 : ShapeGenFor QShape5 4)
    (hs : Stage2Setup G x K A M P Q) : ∃ H : Subgroup G, Stage2Concl1Pre x K M Q H := by
  have hKM : K ≤ M := K_le_M h1 h3 h4 h5 hs
  have hQM : Q ≤ M := Q_le_M hs
  obtain ⟨H, hH⟩ := exists_isMinSubnormalIn hKM
  exact ⟨H, hKM, hQM, Q_syl_M hs hKM hQM, hH, lemma119 hB hs hKM hQM hH⟩

section Proved

theorem stage2Concl1Pre_of_proved (hB : B_B2_g4) (hs : Stage2Setup G x K A M P Q) :
    ∃ H : Subgroup G, Stage2Concl1Pre x K M Q H :=
  stage2Concl1Pre_of hB genConj_1_proved ShapeGenS13.shapeGen_3 shapeGen_4 shapeGen_5 hs

end Proved

