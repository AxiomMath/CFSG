theorem sigX_le_centralizer_of_c23_g5 (hL4m : TA7.RefinePuL4) (hG2 : TA7.RefinePuG2)
    (hB : B_B2_g4) (hPump : PumpupTableU)
    (hH : ∀ (J : Type) [Group J] [Finite J], IsQuasisimple J → ListedHG J → WeakSig2NormG4 J)
    (hP : ∀ (J : Type) [Group J] [Finite J], IsQuasisimple J → ListedPair J → WeakSig2TwoG4 J)
    {G : Type} [Group G] [Finite G] {x : G} {K A M P Q H : Subgroup G}
    (hs : Stage2Setup G x K A M P Q) (h1 : Stage2Concl1Core x K M Q H)
    {B : Subgroup G} {h : G} (S : Sym8A M B h) (hne : barIn M H ≠ barIn M K)
    {J : Subgroup (Mbar M)} (hJ : IsComponent J) :
    barIn M (sigX M h) ≤ centralizer (J : Set (Mbar M)) := by
  have hnot := normalizer_pPrimeCoreOf_ne_top hs.hyp.simple S.maxM S.O_ne
  have hY4 := sectionalTwoRankLE_Mbar hs
  rcases h1.H_tri with hc1 | ⟨hF, hsimple⟩ | ⟨hF, hx, L₁, L₂, hL₁, hL₂, hne', hs₁, hs₂, hsup, hconj, hall⟩
  · exact absurd hc1 hne
  ·
    have hJH := Thm2AssemblyBasic.components_c2 hF hsimple J hJ
    have hHt := puTargetG4_of_c2 hL4m hG2 hB hPump hs h1 hF hsimple
    subst hJH
    exact sigX_le_centralizer_of_weakNormG4 S hnot hY4 hJ (hH ↥(barIn M H) hJ.1 hHt)
      fun d _ => mem_normalizer_of_conjugate_eq
        (Thm2AssemblyBasic.components_c2 hF hsimple _ (Thm2AssemblyBasic.isComponent_conjugate hJ d))
  ·
    obtain ⟨hP₁, hP₂⟩ := listedPair_of_c3 hB hs h1 hx hL₁ hL₂ hne' hs₁ hs₂ hsup hconj
    rcases hall J hJ with rfl | rfl
    · exact sigX_le_centralizer_of_weakTwoG4 S hnot hY4 hJ (hP ↥J hJ.1 hP₁) ⟨L₂, fun d _ => by
        rcases hall _ (Thm2AssemblyBasic.isComponent_conjugate hJ d) with h | h
        · exact Or.inl h
        · exact Or.inr h⟩
    · exact sigX_le_centralizer_of_weakTwoG4 S hnot hY4 hJ (hP ↥J hJ.1 hP₂) ⟨L₁, fun d _ => by
        rcases hall _ (Thm2AssemblyBasic.isComponent_conjugate hJ d) with h | h
        · exact Or.inr h
        · exact Or.inl h⟩

namespace SD2

theorem c23Kill_of_inputs_g5 (hL4m : TA7.RefinePuL4) (hG2 : TA7.RefinePuG2)
    (hB : B_B2_g4) (hPump : PumpupTableU)
    (hH : ∀ (J : Type) [Group J] [Finite J], IsQuasisimple J → ListedHG J → WeakSig2NormG4 J)
    (hP : ∀ (J : Type) [Group J] [Finite J], IsQuasisimple J → ListedPair J → WeakSig2TwoG4 J) :
    C23Kill := by
  intro G _ _ x K A M P Q H B h hs h1 S hne
  have hnot := normalizer_pPrimeCoreOf_ne_top hs.hyp.simple S.maxM S.O_ne
  obtain ⟨J, hJ, hnc⟩ := exists_component_Mbar S hnot
  exact hnc (sigX_le_centralizer_of_c23_g5 hL4m hG2 hB hPump hH hP hs h1 S hne hJ)

theorem c23Kill_of_min_g5 (hL4m : TA7.RefinePuL4) (hG2 : TA7.RefinePuG2)
    (hB : B_B2_g4) (hPump : PumpupTableU) (hWS : ListedWeakSigMinG5) : C23Kill :=
  c23Kill_of_inputs_g5 hL4m hG2 hB hPump (fun J _ _ hq hL => hWS.1 J hq (Or.inl hL)) hWS.2

end SD2

theorem sigX_le_centralizer_of_component_g5 (hL4m : TA7.RefinePuL4) (hG2 : TA7.RefinePuG2)
    (hB : B_B2_g4) (hPump : PumpupTableU)
    (hWS : ListedWeakSigMinG5) (hRank1 : RankOneRecog) (hK : SD.TwoA7TermG.PumpupTwoA7GH)
    {G : Type} [Group G] [Finite G] {x : G} {K A M P Q H : Subgroup G}
    (hs : Stage2Setup G x K A M P Q) (h1 : Stage2Concl1Core x K M Q H)
    (hr : pRank 2 ↥(CxK x K) ≤ 1) {B : Subgroup G} {h : G} (S : Sym8A M B h)
    {J : Subgroup (Mbar M)} (hJ : IsComponent J) :
    barIn M (sigX M h) ≤ centralizer (J : Set (Mbar M)) := by
  by_cases hc1 : barIn M H = barIn M K
  ·
    have hnot := normalizer_pPrimeCoreOf_ne_top hs.hyp.simple S.maxM S.O_ne
    have hY4 := sectionalTwoRankLE_Mbar hs
    obtain ⟨hKc, hother⟩ := Thm2AssemblyBasic.components_c1 hs h1 hc1
    have hnorm := Thm2AssemblyC1.conjugate_eq_of_c1 hs h1 hc1 hr hKc hother hJ
    have hN : barIn M (conjugate B h) ≤ normalizer (J : Set (Mbar M)) := fun d _ =>
      mem_normalizer_of_conjugate_eq (hnorm d)
    by_cases hJK : J = barIn M K
    · subst hJK
      exact sigX_le_centralizer_of_weakNormG4 S hnot hY4 hJ
        (hWS.1 ↥(barIn M K) hJ.1
          (Or.inr (Or.inl (Thm2AssemblyC1.qShapeNS_barIn_K hs h1.K_le hKc)))) hN
    · have hJr : pRank 2 ↥J ≤ 1 := SD.pRank_component_le_one_of_c1 hs h1 hc1 hr hJ hJK
      rcases Thm2AssemblyC1.listedRankOne_or_A7 hRank1 hJ.1 hJr with hL | ⟨hA7, hZ⟩
      · exact sigX_le_centralizer_of_weakNormG4 S hnot hY4 hJ
          (hWS.1 ↥J hJ.1 (Or.inr (Or.inr hL))) hN
      · exact SD.TwoA7G.twoA7_centralized hs h1
          (qbarSylow_of_isSylowOf h1.K_le (isSylowOf_CMbar_of_c1 hs h1 hc1)) hK S J hJ hA7 hZ
  ·
    exact sigX_le_centralizer_of_c23_g5 hL4m hG2 hB hPump
      (fun J _ _ hq hL => hWS.1 J hq (Or.inl hL)) hWS.2 hs h1 S hc1 hJ

theorem stage2Concl2C_of_rank_le_one_min_g5 (hL4m : TA7.RefinePuL4) (hG2 : TA7.RefinePuG2)
    (hB : B_B2_g4) (hPump : PumpupTableU)
    (hWS : ListedWeakSigMinG5) (hRank1 : RankOneRecog) (hK : SD.TwoA7TermG.PumpupTwoA7GH)
    {G : Type} [Group G] [Finite G] {x : G} {K A M P Q H : Subgroup G}
    (hs : Stage2Setup G x K A M P Q) (h1 : Stage2Concl1Core x K M Q H)
    (hr : pRank 2 ↥(CxK x K) ≤ 1) : Stage2Concl2C M := by
  intro B hBU g hg
  by_contra hgM
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨hBM, hBel, -⟩ := hBU.1
  have hB2 : IsPGroup 2 ↥B := CFSG.IsElementaryAbelian.isPGroup 2 ↥B
  obtain ⟨h, hhM, hD, hBh⟩ := exists_two_sided_of_isPGroup hB2 hBM hg hgM
  let S : Sym8A M B h := ⟨hs.maxM, h1.O_ne, hBU, hhM, hD, hBh⟩
  have hnot := normalizer_pPrimeCoreOf_ne_top hs.hyp.simple hs.maxM h1.O_ne
  obtain ⟨J, hJ, hnc⟩ := exists_component_Mbar S hnot
  exact hnc (sigX_le_centralizer_of_component_g5 hL4m hG2 hB hPump hWS hRank1 hK hs h1 hr S hJ)

theorem stage2Thm2C_of_inputs_min_g5 (hL4m : TA7.RefinePuL4) (hG2 : TA7.RefinePuG2)
    (hB : B_B2_g4) (hNo : NoJPrimeNonSD) (hPump : PumpupTableU)
    (hWS : ListedWeakSigMinG5) (hRank1 : RankOneRecog) (hK : SD.TwoA7TermG.PumpupTwoA7GH)
    (hSD : SD.Thm2CaseSDJ) : Stage2Thm2C := by
  intro G _ _ x K A M P Q H hs h1
  by_cases hr : pRank 2 ↥(CxK x K) ≤ 1
  · exact stage2Concl2C_of_rank_le_one_min_g5 hL4m hG2 hB hPump hWS hRank1 hK hs h1 hr
  · rcases pRank_CxK_le_one_or_sd hNo hs with h | hsd
    · exact absurd h hr
    · exact hSD G x K A M P Q H hs h1 hsd (by omega)

theorem stage2Thm2C_of_min_fam_g5 (hL4m : TA7.RefinePuL4) (hG2 : TA7.RefinePuG2)
    (hB : B_B2_g4) (hNo : NoJPrimeNonSD) (hPump : PumpupTableU)
    (hFam : ListedWeakSigMinFamG5) (hRank1 : RankOneRecog) (hK : SD.TwoA7TermG.PumpupTwoA7GH)
    (hSD : SD.Thm2CaseSDJ) : Stage2Thm2C :=
  stage2Thm2C_of_inputs_min_g5 hL4m hG2 hB hNo hPump (ListedWeakSigMinG5.of_fam hFam) hRank1 hK
    hSD

