theorem barK_centralized {x : G} {K A M P Q H B : Subgroup G} {h : G}
    (hs : Stage2Setup G x K A M P Q) (h1 : Stage2Concl1Core x K M Q H) (S : Sym8A M B h)
    (h3 : QShape3 (↥K ⧸ pPrimeCore 2 ↥K)) (hc1 : barIn M H = barIn M K)
    (hWK : ∀ (J : Type) [Group J] [Finite J], IsQuasisimple J → IsSimpleGroup J →
      QShape3 J → WeakSig2TwoG4 J) :
    barIn M (sigX M h) ≤ centralizer ((barIn M K : Subgroup (Mbar M)) : Set (Mbar M)) := by
  classical
  obtain ⟨hKc, -⟩ := Thm2AssemblyBasic.components_c1 hs h1 hc1
  obtain ⟨e⟩ := SDCheap.exists_equiv_barIn h1.K_le hKc
  have hsimp : IsSimpleGroup ↥(barIn M K) := by
    have := B1.PilotS3.isSimpleGroup_of_qShape3 h3
    exact e.symm.isSimpleGroup
  have hq3 : QShape3 ↥(barIn M K) := isL3OddGt3_of_mulEquiv e h3
  have hnot := normalizer_pPrimeCoreOf_ne_top hs.hyp.simple S.maxM S.O_ne
  obtain ⟨hO, hDel, hrk, hWodd, -, hDW, hgam⟩ := sym8A_bar S hnot
  have horb : ∃ L' : Subgroup (Mbar M), ∀ d ∈ barIn M (conjugate B h),
      conjugate (barIn M K) d = barIn M K ∨ conjugate (barIn M K) d = L' := by
    by_cases hall : ∀ d ∈ barIn M (conjugate B h), conjugate (barIn M K) d = barIn M K
    · exact ⟨barIn M K, fun d hd => Or.inl (hall d hd)⟩
    · obtain ⟨d₀, hne₀⟩ := not_forall.1 hall
      obtain ⟨-, hne₀⟩ := not_imp.1 hne₀
      refine ⟨conjugate (barIn M K) d₀, fun d _ => ?_⟩
      by_cases hd' : conjugate (barIn M K) d = barIn M K
      · exact Or.inl hd'
      · exact Or.inr (component_eq_of_ne_barK hs h1 h3 hc1
          (Thm2AssemblyBasic.isComponent_conjugate hKc d)
          (Thm2AssemblyBasic.isComponent_conjugate hKc d₀) hd' hne₀)
  exact hWK ↥(barIn M K) hKc.1 hsimp hq3 (Mbar M) hO (SDCheap.sectionalTwoRankLE_Mbar hs)
    (barIn M K) hKc ⟨MulEquiv.refl _⟩ (barIn M (conjugate B h)) (barIn M (sigX M h)) hDel hrk
    hWodd hDW hgam horb

theorem normalizer_sigX_inv_of_le_conjugate {x : G}
    {K A M P Q H B : Subgroup G} {h : G}
    (hs : Stage2Setup G x K A M P Q) (_h1 : Stage2Concl1Core x K M Q H) (S : Sym8A M B h)
    (h3 : B1.QShape3SD (↥K ⧸ pPrimeCore 2 ↥K)) (hKh : K ≤ conjugate M h)
    (J : Subgroup (Mbar M)) (hJ : IsComponent J) (hJn : J.Normal) (hJs : SmallAut ↥J) :
    J ≤ normalizer ((barIn M (sigX M h⁻¹) : Subgroup (Mbar M)) : Set (Mbar M)) := by
  classical
  have : J.Normal := hJn
  obtain ⟨ρ, hρ⟩ := SDCheap.exists_autQuot ↥J
  let f : ↥K →* ↥M := ((MulAut.conj h).toMonoidHom.comp K.subtype).codRestrict M
    (fun k => mem_conjugate_iff'.1 (hKh k.2))
  let ψ₁ : ↥K →* Mbar M := (QuotientGroup.mk' (pPrimeCore 2 ↥M)).comp f
  let ψ : ↥K →* MulAut (↥J ⧸ center ↥J) :=
    ρ.comp ((MulAut.conjNormal : Mbar M →* MulAut ↥J).comp ψ₁)
  have hψ : ψ = 1 := SDOrders.eq_one_of_smallAut (SDUnique.perfect_of_setup hs)
    (B1.PilotS3.isSimpleGroup_of_qShape3 h3.qShape3) h3 hJs ψ
  have hcomm : ∀ k : ↥K, ∀ j ∈ J, j * ψ₁ k = ψ₁ k * j := fun k =>
    SDCheap.commute_of_trivial_action J (Subgroup.isPerfect_iff.mp hJ.1.1) ρ hρ (q := ψ₁ k)
      (DFunLike.congr_fun hψ k)
  set E : Subgroup G := A ⊓ K with hE
  set E' : Subgroup G := conjugate E h⁻¹ with hE'
  have hEK : E ≤ K := inf_le_right
  have hmemE' : ∀ e : G, e ∈ E' ↔ h⁻¹ * e * h ∈ E := by
    intro e
    rw [hE', mem_conjugate_iff']
    simp only [inv_inv]
  have hE'M : E' ≤ M := by
    intro e he
    have haK : h⁻¹ * e * h ∈ K := hEK ((hmemE' e).1 he)
    have := mem_conjugate_iff'.1 (hKh haK)
    rwa [show h * (h⁻¹ * e * h) * h⁻¹ = e by group] at this
  have hE2 : IsPGroup 2 ↥E := (isE_inf_K hs).2.1.isPGroup 2 _
  have hE'2 : IsPGroup 2 ↥E' := isPGroup_conjugate' hE2 h⁻¹
  have hJc : J ≤ centralizer ((barIn M E' : Subgroup (Mbar M)) : Set (Mbar M)) := by
    intro j hj
    rw [mem_centralizer_iff]
    intro y hy
    obtain ⟨m, hmE, rfl⟩ := Lemma83Bar.mem_barIn_iff.1 hy
    have haK : h⁻¹ * (m : G) * h ∈ K := hEK ((hmemE' m).1 hmE)
    have hmk : QuotientGroup.mk' (pPrimeCore 2 ↥M) m = ψ₁ ⟨h⁻¹ * (m : G) * h, haK⟩ := by
      simp only [ψ₁, f, MonoidHom.comp_apply]
      congr 1
      apply Subtype.ext
      simp [MulAut.conj_apply]
      group
    rw [hmk]
    exact (hcomm _ j hj).symm
  have hC : centralizer (E' : Set G) ≤ conjugate M h⁻¹ := by
    apply Lemma82.centralizer_le_conjugate (E := E') (Z := M) h⁻¹
    rw [hE', conjugate_inv_conjugate']
    exact (Subgroup.centralizer_le_normalizer _).trans (SD.TwoA7.normalizer_inf_K_le_M hs)
  rw [SDGen.centralizer_barIn_eq_barIn hE'M hE'2] at hJc
  intro y hy
  obtain ⟨m, ⟨hmM, hmc⟩, rfl⟩ := Lemma83Bar.mem_barIn_iff.1 (hJc hy)
  exact Lemma83Bar.mk_mem_normalizer_barIn ((lemma82_core (sym8A_inv S)).2.2.2.1 ⟨hmM, hC hmc⟩)

theorem false_of_smallAut {x : G} {K A M P Q H B : Subgroup G}
    {h : G} (hs : Stage2Setup G x K A M P Q) (h1 : Stage2Concl1Core x K M Q H) (S : Sym8A M B h)
    (h3 : B1.QShape3SD (↥K ⧸ pPrimeCore 2 ↥K)) (hc1 : barIn M H = barIn M K)
    (hGen : ∀ (J : Type) [Group J] [Finite J], B1.QShape3SD J → GenProp J)
    (hWK : ∀ (J : Type) [Group J] [Finite J], IsQuasisimple J → IsSimpleGroup J →
      QShape3 J → WeakSig2TwoG4 J)
    (J : Subgroup (Mbar M)) (hJ : IsComponent J) (hJK : J ≠ barIn M K) (hJs : SmallAut ↥J) :
    False := by
  classical
  have hJn : J.Normal := normal_of_smallAut hs h1 h3.qShape3 hc1 hJ hJK hJs
  obtain ⟨hKc, -⟩ := Thm2AssemblyBasic.components_c1 hs h1 hc1
  have hKM : K ≤ M := h1.K_le
  obtain ⟨e⟩ := SDCheap.exists_equiv_barIn hKM hKc
  have hDK : barIn M (conjugate B h) ≤
      normalizer ((barIn M K : Subgroup (Mbar M)) : Set (Mbar M)) := by
    intro d _
    apply SDCheap.mem_normalizer_of_conjugate_eq'
    by_contra hne
    have hdJ : conjugate (barIn M K) d = J :=
      component_eq_of_ne_barK hs h1 h3.qShape3 hc1
        (Thm2AssemblyBasic.isComponent_conjugate hKc d) hJ hne hJK
    have hback : conjugate (conjugate (barIn M K) d) d⁻¹ = barIn M K :=
      conjugate_inv_conjugate' _ _
    rw [hdJ, SDCheap.conjugate_eq_of_normal hJn] at hback
    exact hJK hback
  have hGP : GenProp ↥(barIn M K) := hGen _ (B1.QShape3SD.of_mulEquiv e h3)
  have hKh : K ≤ conjugate M h := le_conjugate_of_gen S hKM (gen_of_genProp S hDK hGP)
  have hcent := normalizer_sigX_inv_of_le_conjugate hs h1 S h3 hKh J hJ hJn hJs
  have hX'odd : Odd (Nat.card ↥(barIn M (sigX M h⁻¹))) :=
    Lemma83Bar.odd_card_barIn (lemma82_core (sym8A_inv S)).2.2.2.2.1
  have hX'J : barIn M (sigX M h⁻¹) ≤ centralizer (J : Set (Mbar M)) :=
