theorem mem_normalizer_of_conjugate_eq' {Y : Type} [Group Y] {L : Subgroup Y} {d : Y}
    (h : conjugate L d = L) : d ∈ normalizer (L : Set Y) := by
  rw [mem_normalizer_iff]
  intro y
  have := mem_conjugate_iff' (H := L) (g := d) (x := y)
  rw [h] at this
  exact this

theorem conjugate_eq_of_normal {Y : Type} [Group Y] {J : Subgroup Y} (hJ : J.Normal) (d : Y) :
    conjugate J d = J := by
  ext y
  rw [mem_conjugate_iff']
  refine ⟨fun hy => ?_, fun hy => hJ.conj_mem _ hy d⟩
  have := hJ.conj_mem _ hy d⁻¹
  rwa [show d⁻¹ * (d * y * d⁻¹) * d⁻¹⁻¹ = y by group] at this

theorem exists_autQuot (J : Type) [Group J] :
    ∃ ρ : MulAut J →* MulAut (J ⧸ center J), ∀ (φ : MulAut J) (j : J),
      ρ φ (QuotientGroup.mk j) = QuotientGroup.mk (φ j) := by
  have hcen : ∀ φ : MulAut J, (center J).map φ.toMonoidHom = center J := fun φ =>
    Subgroup.characteristic_iff_map_eq.1 inferInstance φ
  refine ⟨{ toFun := fun φ => QuotientGroup.congr (center J) (center J) φ (hcen φ)
            map_one' := ?_, map_mul' := ?_ }, fun φ j => rfl⟩
  · ext y
    induction y using QuotientGroup.induction_on
    rfl
  · intro a b
    ext y
    induction y using QuotientGroup.induction_on
    rfl

theorem commute_of_trivial_action {Y : Type} [Group Y] (J : Subgroup Y) [J.Normal]
    (hJp : ⁅J, J⁆ = J) (ρ : MulAut J →* MulAut (J ⧸ center J))
    (hρ : ∀ (φ : MulAut J) (j : J), ρ φ (QuotientGroup.mk j) = QuotientGroup.mk (φ j))
    {q : Y} (hq : ρ (MulAut.conjNormal q) = 1) : ∀ j ∈ J, j * q = q * j := by
  have hz : ∀ k ∈ J, ∀ k' ∈ J, ⁅k, q⁆ * k' = k' * ⁅k, q⁆ := by
    intro k hk k' hk'
    have h1 := hρ (MulAut.conjNormal q) ⟨k, hk⟩
    rw [hq, MulAut.one_apply, QuotientGroup.eq] at h1
    have hzc := Subgroup.mem_center_iff.1 h1
    have hk1 := congrArg Subtype.val (hzc ⟨k, hk⟩)
    have hk2 := congrArg Subtype.val (hzc ⟨k', hk'⟩)
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, MulAut.conjNormal_apply] at hk1 hk2
    have h' : q * k * q⁻¹ = k⁻¹ * (q * k * q⁻¹) * k := by
      rw [mul_inv_cancel_left] at hk1
      exact hk1
    have hc : k * (q * k * q⁻¹) = (q * k * q⁻¹) * k := by
      calc k * (q * k * q⁻¹) = k * (k⁻¹ * (q * k * q⁻¹) * k) := by rw [← h']
        _ = (q * k * q⁻¹) * k := by group
    have hc' : k * (q * k * q⁻¹)⁻¹ = (q * k * q⁻¹)⁻¹ * k :=
      (Commute.inv_right (show Commute k (q * k * q⁻¹) from hc)).eq
    have e : ⁅k, q⁆ = (k⁻¹ * (q * k * q⁻¹))⁻¹ := by
      have e1 : ⁅k, q⁆ = k * (q * k * q⁻¹)⁻¹ := by simp only [commutatorElement_def]; group
      rw [e1, hc']
      group
    rw [e]
    exact (Commute.inv_right (show Commute k' (k⁻¹ * (q * k * q⁻¹)) from hk2)).eq.symm
  exact Thm2Comp.commute_of_commutator_central hJp
    (fun k hk => by
      have : ⁅k, q⁆ = k * (q * k⁻¹ * q⁻¹) := by simp only [commutatorElement_def]; group
      rw [this]
      exact J.mul_mem hk (Subgroup.Normal.conj_mem inferInstance _ (J.inv_mem hk) q)) hz

theorem two_dvd_card_of_isQuasisimple {J : Type} [Group J] [Finite J] (hq : IsQuasisimple J) :
    2 ∣ Nat.card J := by
  by_contra hn
  have hodd : Odd (Nat.card J) := Nat.odd_iff.2 (by omega)
  have hsolv := CFSG.FeitThompson.isSolvable_of_odd_natCard _ hodd
  have : Group.IsPerfect J := hq.1
  have := CFSG.LocalCores.isQuasisimple_nontrivial hq
  exact Group.IsPerfect.not_isSolvable J hsolv

