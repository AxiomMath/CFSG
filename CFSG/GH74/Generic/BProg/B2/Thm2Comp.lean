theorem isComponent_barIn_of_isSubnormal {x : G} {K A M P Q : Subgroup G}
    (hs : Stage2Setup G x K A M P Q) (hKM : K ≤ M) (hsub : (barIn M K).IsSubnormal) :
    IsComponent (barIn M K) := by
  have hq : IsQuasisimple (↥K ⧸ pPrimeCore 2 ↥K) := TwoThin.isQuasisimple_hat hs.pair.1.1.1.2.2
  obtain ⟨e⟩ := TwoThin.hat_equiv_subgroupOf hKM
  have hq' : IsQuasisimple (↥(K.subgroupOf M) ⧸ pPrimeCore 2 ↥(K.subgroupOf M)) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv e hq
  exact ⟨isQuasisimple_map_of_isSubnormal_map hq' hsub, hsub⟩

