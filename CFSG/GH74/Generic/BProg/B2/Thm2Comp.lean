theorem map_pPrimeCore_le_of_isSubnormal_map {C : Type} [Group C] [Finite C] {K : Subgroup C}
    (hsub : (K.map (QuotientGroup.mk' (pPrimeCore 2 C))).IsSubnormal) :
    (pPrimeCore 2 ↥K).map K.subtype ≤ pPrimeCore 2 C := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set O := pPrimeCore 2 C with hO
  set π := QuotientGroup.mk' O with hπ
  set g' : ↥K →* C ⧸ O := π.comp K.subtype with hg'
  have hrange : g'.range = K.map π := by
    rw [hg', MonoidHom.range_comp, Subgroup.range_subtype]
  have hrsub : g'.range.IsSubnormal := by rw [hrange]; exact hsub
  have hcore : pPrimeCore 2 (C ⧸ O) = ⊥ := CFSG.pPrimeCore_quotient_pPrimeCore_eq_bot 2
  set N : Subgroup (C ⧸ O) := (pPrimeCore 2 ↥K).map g' with hN
  have hNle : N ≤ g'.range := by
    rintro _ ⟨k, -, rfl⟩
    exact ⟨k, rfl⟩
  have hNnorm : (N.subgroupOf g'.range).Normal := by
    refine ⟨fun n hn r => ?_⟩
    rw [Subgroup.mem_subgroupOf] at hn ⊢
    obtain ⟨k₀, hk₀, hk₀n⟩ := hn
    obtain ⟨k, hk⟩ := r.2
    refine ⟨k * k₀ * k⁻¹, Subgroup.Normal.conj_mem inferInstance k₀ hk₀ k, ?_⟩
    simp only [map_mul, map_inv, hk₀n, hk]
    rfl
  have hNsub : N.IsSubnormal := Subgroup.IsSubnormal.trans hNle hNnorm.isSubnormal hrsub
  have hNodd : Odd (Nat.card N) := by
    have h1 : Nat.card N ∣ Nat.card (pPrimeCore 2 ↥K) := Subgroup.card_map_dvd _ _
    exact Odd.of_dvd_nat (Nat.coprime_two_left.1 CFSG.pPrimeCore_coprime_card) h1
  have hNbot : N = ⊥ := CFSG.Walter.eq_bot_of_isSubnormal_of_odd hcore hNsub hNodd
  rintro _ ⟨k, hk, rfl⟩
  have : g' k ∈ N := Subgroup.mem_map_of_mem _ hk
  rw [hNbot, Subgroup.mem_bot] at this
  exact (QuotientGroup.eq_one_iff (k : C)).1 this

theorem isQuasisimple_map_of_isSubnormal_map {C : Type} [Group C] [Finite C] {K : Subgroup C}
    (hK : IsQuasisimple (↥K ⧸ pPrimeCore 2 ↥K))
    (hsub : (K.map (QuotientGroup.mk' (pPrimeCore 2 C))).IsSubnormal) :
    IsQuasisimple ↥(K.map (QuotientGroup.mk' (pPrimeCore 2 C))) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set O := pPrimeCore 2 C with hO
  set π := QuotientGroup.mk' O with hπ
  set g' : ↥K →* C ⧸ O := π.comp K.subtype with hg'
  have hrange : g'.range = K.map π := by
    rw [hg', MonoidHom.range_comp, Subgroup.range_subtype]
  have hker : pPrimeCore 2 ↥K ≤ g'.ker := fun k hk =>
    (QuotientGroup.eq_one_iff (k : C)).2 (map_pPrimeCore_le_of_isSubnormal_map hsub ⟨k, hk, rfl⟩)
  let f : ↥K ⧸ pPrimeCore 2 ↥K →* C ⧸ O := QuotientGroup.lift (pPrimeCore 2 ↥K) g' hker
  have hfrange : f.range = g'.range := by
    ext w
    constructor
    · rintro ⟨q, rfl⟩
      obtain ⟨k, rfl⟩ := QuotientGroup.mk_surjective q
      exact ⟨k, rfl⟩
    · rintro ⟨k, rfl⟩
      exact ⟨(k : ↥K ⧸ pPrimeCore 2 ↥K), rfl⟩
  rcases CFSG.LocalAnalysis.ComponentInitial.quasisimple_homomorphic_images hK f with h | h
  · exfalso
    rw [hfrange, hrange] at h
    have hKO : K ≤ O := by
      intro c hc
      have : π c ∈ K.map π := Subgroup.mem_map_of_mem _ hc
      rw [h, Subgroup.mem_bot] at this
      exact (QuotientGroup.eq_one_iff c).1 this
    have hOsolv : Group.IsSolvable ↥O :=
      CFSG.FeitThompson.isSolvable_of_odd_natCard _ (Nat.coprime_two_left.1 CFSG.pPrimeCore_coprime_card)
    have hsolv : Group.IsSolvable ↥K :=
      Group.isSolvable_of_isSolvable_injective (Subgroup.inclusion_injective hKO)
    have hsolv' : Group.IsSolvable (↥K ⧸ pPrimeCore 2 ↥K) :=
      Group.isSolvable_of_surjective (QuotientGroup.mk'_surjective (pPrimeCore 2 ↥K))
    have : Nontrivial (↥K ⧸ pPrimeCore 2 ↥K) := CFSG.LocalCores.isQuasisimple_nontrivial hK
    have : Group.IsPerfect (↥K ⧸ pPrimeCore 2 ↥K) := hK.1
    exact Group.IsPerfect.not_isSolvable _ hsolv'
  · rw [hfrange, hrange] at h
    exact h

