omit [Finite G] in
theorem mem_normalizer_of_forall {S : Subgroup G} {g : G} (h1 : ∀ n ∈ S, g * n * g⁻¹ ∈ S)
    (h2 : ∀ n ∈ S, g⁻¹ * n * g ∈ S) : g ∈ normalizer (S : Set G) := by
  rw [mem_normalizer_iff]
  intro n
  refine ⟨h1 n, fun hn => ?_⟩
  have := h2 _ hn
  rwa [show g⁻¹ * (g * n * g⁻¹) * g = n by group] at this

omit [Finite G] in
theorem comm_mem_pPrimeCoreOf_iff {M : Subgroup G} (k g : ↥M) :
    (⁅(k : G), (g : G)⁆ ∈ pPrimeCoreOf 2 M) ↔
      ⁅QuotientGroup.mk' (pPrimeCore 2 ↥M) k, QuotientGroup.mk' (pPrimeCore 2 ↥M) g⁆ = 1 := by
  have hcoe : ((⁅k, g⁆ : ↥M) : G) = ⁅(k : G), (g : G)⁆ := by simp [commutatorElement_def]
  rw [← hcoe]
  constructor
  · rintro ⟨y, hy, hyc⟩
    have hy' : y = ⁅k, g⁆ := Subtype.ext hyc
    subst hy'
    rw [← map_commutatorElement]
    exact (QuotientGroup.eq_one_iff _).2 hy
  · intro h
    rw [← map_commutatorElement] at h
    exact ⟨⁅k, g⁆, (QuotientGroup.eq_one_iff _).1 h, rfl⟩

omit [Finite G] in
theorem conj_mem_sup_of_mem_centBarK {K M : Subgroup G} (hKM : K ≤ M) {m : ↥M}
    (hm : QuotientGroup.mk' (pPrimeCore 2 ↥M) m ∈ centBarK M K) :
    ∀ n ∈ K ⊔ pPrimeCoreOf 2 M, (m : G) * n * (m : G)⁻¹ ∈ K ⊔ pPrimeCoreOf 2 M := by
  have hcK : ∀ k ∈ K, ⁅k, (m : G)⁆ ∈ pPrimeCoreOf 2 M := by
    intro k hk
    have hkM : k ∈ M := hKM hk
    have hmem : QuotientGroup.mk' (pPrimeCore 2 ↥M) ⟨k, hkM⟩ ∈ barIn M K :=
      ⟨⟨k, hkM⟩, hk, rfl⟩
    have := Subgroup.mem_centralizer_iff.1 hm _ hmem
    exact (comm_mem_pPrimeCoreOf_iff ⟨k, hkM⟩ m).2 (commutatorElement_eq_one_iff_mul_comm.2 this)
  have hAN : K ≤ normalizer (pPrimeCoreOf 2 M : Set G) := fun a ha =>
    TwoThin.mem_normalizer_pPrimeCoreOf (Subgroup.le_normalizer (hKM ha))
  have hmN : (m : G) ∈ normalizer (pPrimeCoreOf 2 M : Set G) :=
    TwoThin.mem_normalizer_pPrimeCoreOf (Subgroup.le_normalizer m.2)
  have hcomm : ∀ k ∈ K ⊔ pPrimeCoreOf 2 M, ⁅k, (m : G)⁆ ∈ pPrimeCoreOf 2 M :=
    Th2.comm_mem_sup (O := pPrimeCoreOf 2 M) (A := K) (B := pPrimeCoreOf 2 M) (c := (m : G)) hAN
      (fun b hb => Subgroup.le_normalizer hb) hcK (fun b hb => by
        have : ⁅b, (m : G)⁆ = b * ((m : G) * b⁻¹ * (m : G)⁻¹) := by
          simp only [commutatorElement_def]; group
        rw [this]
        exact (pPrimeCoreOf 2 M).mul_mem hb
          ((mem_normalizer_iff.1 hmN _).1 ((pPrimeCoreOf 2 M).inv_mem hb)))
  intro n hn
  have hc := hcomm n hn
  have : (m : G) * n * (m : G)⁻¹ = (⁅n, (m : G)⁆)⁻¹ * n := by
    simp only [commutatorElement_def]; group
  rw [this]
  exact (K ⊔ pPrimeCoreOf 2 M).mul_mem
    ((K ⊔ pPrimeCoreOf 2 M).inv_mem (Subgroup.mem_sup_right hc)) hn

omit [Finite G] in
theorem mem_CMbar_iff {K M : Subgroup G} (hKM : K ≤ M) (m : ↥M) :
    (m : G) ∈ CMbar M K ↔ QuotientGroup.mk' (pPrimeCore 2 ↥M) m ∈ centBarK M K := by
  constructor
  · rintro ⟨hmM, hN1, hN2, hcomm⟩
    refine Subgroup.mem_centralizer_iff.2 fun y hy => ?_
    obtain ⟨k, hk, rfl⟩ := Subgroup.mem_map.1 hy
    have hkK : (k : G) ∈ K := Subgroup.mem_subgroupOf.1 hk
    have := (comm_mem_pPrimeCoreOf_iff k m).1 (hcomm (k : G) (Subgroup.mem_sup_left hkK))
    exact commutatorElement_eq_one_iff_mul_comm.1 this
  · intro hm
    have hmN : (m : G) ∈ normalizer (pPrimeCoreOf 2 M : Set G) :=
      TwoThin.mem_normalizer_pPrimeCoreOf (Subgroup.le_normalizer m.2)
    have hm' : QuotientGroup.mk' (pPrimeCore 2 ↥M) m⁻¹ ∈ centBarK M K := by
      rw [map_inv]; exact inv_mem hm
    have hcK : ∀ k ∈ K, ⁅k, (m : G)⁆ ∈ pPrimeCoreOf 2 M := by
      intro k hk
      have hkM : k ∈ M := hKM hk
      have hmem : QuotientGroup.mk' (pPrimeCore 2 ↥M) ⟨k, hkM⟩ ∈ barIn M K :=
        ⟨⟨k, hkM⟩, hk, rfl⟩
      have := Subgroup.mem_centralizer_iff.1 hm _ hmem
      exact (comm_mem_pPrimeCoreOf_iff ⟨k, hkM⟩ m).2 (commutatorElement_eq_one_iff_mul_comm.2 this)
    refine ⟨m.2, ?_, hmN, ?_⟩
    · refine mem_normalizer_of_forall (conj_mem_sup_of_mem_centBarK hKM hm) fun n hn => ?_
      have := conj_mem_sup_of_mem_centBarK hKM hm' n hn
      simpa using this
    · have hAN : K ≤ normalizer (pPrimeCoreOf 2 M : Set G) := fun a ha =>
        TwoThin.mem_normalizer_pPrimeCoreOf (Subgroup.le_normalizer (hKM ha))
      exact Th2.comm_mem_sup (O := pPrimeCoreOf 2 M) (A := K) (B := pPrimeCoreOf 2 M)
        (c := (m : G)) hAN (fun b hb => Subgroup.le_normalizer hb) hcK (fun b hb => by
          have : ⁅b, (m : G)⁆ = b * ((m : G) * b⁻¹ * (m : G)⁻¹) := by
            simp only [commutatorElement_def]; group
          rw [this]
          exact (pPrimeCoreOf 2 M).mul_mem hb
            ((mem_normalizer_iff.1 hmN _).1 ((pPrimeCoreOf 2 M).inv_mem hb)))

theorem eq_one_of_isPGroup {M : Subgroup G} {E : Subgroup ↥M} (hE : IsPGroup 2 ↥E) :
    ∀ x ∈ E, QuotientGroup.mk' (pPrimeCore 2 ↥M) x = 1 → x = 1 := by
  obtain ⟨n, hn⟩ := hE.exists_card_eq
  have hcop : Nat.Coprime (Nat.card ↥E) (Nat.card ↥(pPrimeCore 2 ↥M)) := by
    rw [hn]
    exact Nat.Coprime.pow_left n pPrimeCore_coprime_card
  intro x hx hx1
  rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at hx1
  have hdisj := Subgroup.disjoint_of_coprime_natCard hcop
  have : x ∈ E ⊓ pPrimeCore 2 ↥M := ⟨hx, hx1⟩
  rw [hdisj.eq_bot, Subgroup.mem_bot] at this
  exact this

theorem le_pRank_of_isElementaryAbelian {H : Type*} [Group H] [Finite H] {E : Subgroup H}
    (hE : IsElementaryAbelian 2 ↥E) {k : ℕ} (hk : Nat.card ↥E = 2 ^ k) : k ≤ pRank 2 H := by
  refine le_csSup ⟨Nat.card H, ?_⟩ ⟨E, hE, hk⟩
  rintro r ⟨B, -, hB⟩
  calc r ≤ 2 ^ r := (Nat.lt_pow_self (by norm_num)).le
    _ = Nat.card B := hB.symm
    _ ≤ Nat.card H := Subgroup.card_le_card_group B

theorem pRank_centBarK_le_pRank_CMbar {K M : Subgroup G} (hKM : K ≤ M) :
    pRank 2 ↥(centBarK M K) ≤ pRank 2 ↥(CMbar M K) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine csSup_le' ?_
  rintro r ⟨A, hA, hAcard⟩
  set Ē : Subgroup (Mbar M) := A.map (centBarK M K).subtype with hĒ
  have hĒel : IsElementaryAbelian 2 ↥Ē := IsElementaryAbelian.map_subtype
  have hĒcard : Nat.card ↥Ē = 2 ^ r := by
    rw [hĒ, Subgroup.card_map_of_injective (centBarK M K).subtype_injective, hAcard]
  set ρ : ↥M →* Mbar M := QuotientGroup.mk' (pPrimeCore 2 ↥M) with hρ
  have hker : ¬ 2 ∣ Nat.card ρ.ker := by
    rw [hρ, QuotientGroup.ker_mk']
    exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).1 CFSG.pPrimeCore_coprime_card
  have hĒr : Ē ≤ ρ.range := by
    rw [hρ, MonoidHom.range_eq_top.2 (QuotientGroup.mk'_surjective _)]
    exact le_top
  obtain ⟨E₀, hE₀el, hE₀card, hE₀map⟩ :=
    B1.PilotS1.exists_lift_elementaryAbelian_pow ρ Nat.prime_two hker Ē hĒr hĒcard
  set E : Subgroup G := E₀.map M.subtype with hE
  have hEel : IsElementaryAbelian 2 ↥E := IsElementaryAbelian.map_subtype
  have hEcard : Nat.card ↥E = 2 ^ r := by
    rw [hE, Subgroup.card_map_of_injective M.subtype_injective, hE₀card]
  have hEle : E ≤ CMbar M K := by
    rintro _ ⟨e, he, rfl⟩
    refine (mem_CMbar_iff hKM e).2 ?_
    have : ρ e ∈ Ē := hE₀map ▸ Subgroup.mem_map_of_mem ρ he
    obtain ⟨a, -, ha⟩ := Subgroup.mem_map.1 this
    rw [← ha]
    exact a.2
  have hE' : IsElementaryAbelian 2 ↥(E.subgroupOf (CMbar M K)) :=
    IsElementaryAbelian.subgroupOf hEle
  refine le_pRank_of_isElementaryAbelian hE' ?_
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hEle).toEquiv, hEcard]

theorem pRank_eq_pRank_sylow {Q R : Subgroup G} (h : IsSylowOf 2 Q R) :
    pRank 2 ↥R = pRank 2 ↥Q := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨S, hS⟩ := h.exists_sylow_eq_subgroupOf
  have h1 : pRank 2 ↥(S : Subgroup ↥R) = pRank 2 ↥R := (CFSG.SectionRank.pRank_sylow S).2
  rw [← h1, hS]
  exact CFSG.RankThree.PartOne.Quotient36.pRank_congr_mulEquiv one_lt_two
    (Subgroup.subgroupOfEquivOfLe h.le)

theorem inf_eq_bot_of_odd {Y : Type} [Group Y] [Finite Y] (hcore : pPrimeCore 2 Y = ⊥)
    {S N : Subgroup Y} (hS : IsComponent S) (hNodd : Odd (Nat.card ↥N))
    (hSN : ∀ s ∈ S, ∀ n ∈ N, s * n * s⁻¹ ∈ N) : S ⊓ N = ⊥ := by
  have hnorm : ((S ⊓ N).subgroupOf S).Normal := by
    refine ⟨fun n hn g => ?_⟩
    rw [Subgroup.mem_subgroupOf] at hn ⊢
    exact ⟨S.mul_mem (S.mul_mem g.2 hn.1) (S.inv_mem g.2), hSN _ g.2 _ hn.2⟩
  have hsub : (S ⊓ N).IsSubnormal :=
    Subgroup.IsSubnormal.trans inf_le_left hnorm.isSubnormal hS.2
  have hodd : Odd (Nat.card ↥(S ⊓ N)) :=
    Odd.of_dvd_nat hNodd (Subgroup.card_dvd_of_le inf_le_right)
  exact CFSG.Walter.eq_bot_of_isSubnormal_of_odd hcore hsub hodd

theorem centralizes_of_comm_mem_odd {Y : Type} [Group Y] [Finite Y] (hcore : pPrimeCore 2 Y = ⊥)
    {S N : Subgroup Y} (hS : IsComponent S) (hNodd : Odd (Nat.card ↥N))
    (hSN : ∀ s ∈ S, ∀ n ∈ N, s * n * s⁻¹ ∈ N) {t : Y}
    (ht : ∀ w ∈ S, w * t * w⁻¹ * t⁻¹ ∈ N) : ∀ w ∈ S, t * w * t⁻¹ = w := by
  have hSbot : S ⊓ N = ⊥ := inf_eq_bot_of_odd hcore hS hNodd hSN
  have hconj : ∀ w ∈ S, t * w * t⁻¹ ∈ S := by
    by_contra hcon
    push Not at hcon
    obtain ⟨w₀, hw₀S, hw₀⟩ := hcon
    set S' : Subgroup Y := S.map (MulAut.conj t).toMonoidHom with hS'
    have hS'c : IsComponent S' := CFSG.LocalCores.isComponent_map_mulEquiv (MulAut.conj t) hS
    have hne : S ≠ S' := by
      intro h
      apply hw₀
      rw [h]
      exact ⟨w₀, hw₀S, by simp [MulAut.conj_apply]⟩
    have hcomm : ⁅S, S'⁆ = ⊥ :=
      (CFSG.LocalCores.distinct_components_commute hS hS'c).resolve_left hne
    have hle : S ≤ centralizer (S' : Set Y) := Subgroup.commutator_eq_bot_iff_le_centralizer.1 hcomm
    have hcentral : ∀ w ∈ S, ∀ s ∈ S, w * s = s * w := by
      intro w hw s hs
      set c : Y := w * t * w⁻¹ * t⁻¹ with hc
      have hcN : c ∈ N := ht w hw
      have hs'mem : t * w * t⁻¹ ∈ S' := ⟨w, hw, by simp [MulAut.conj_apply]⟩
      have h1 : (t * w * t⁻¹) * s = s * (t * w * t⁻¹) :=
        Subgroup.mem_centralizer_iff.1 (hle hs) _ hs'mem
      have hs'eq : t * w * t⁻¹ = c⁻¹ * w := by rw [hc]; group
      rw [hs'eq] at h1
      have h2 : w * s * w⁻¹ = c * s * c⁻¹ := by
        have : w * s = c * s * c⁻¹ * w := by
          calc w * s = c * (c⁻¹ * w * s) := by group
            _ = c * (s * (c⁻¹ * w)) := by rw [h1]
            _ = c * s * c⁻¹ * w := by group
        calc w * s * w⁻¹ = c * s * c⁻¹ * w * w⁻¹ := by rw [this]
          _ = c * s * c⁻¹ := by group
      have hn1N : s⁻¹ * c * s * c⁻¹ ∈ N := by
        have := hSN s⁻¹ (S.inv_mem hs) c hcN
        simp only [inv_inv] at this
        exact N.mul_mem this (N.inv_mem hcN)
      have hn1S : s⁻¹ * c * s * c⁻¹ ∈ S := by
        have : s⁻¹ * c * s * c⁻¹ = s⁻¹ * (w * s * w⁻¹) := by rw [h2]; group
        rw [this]
        exact S.mul_mem (S.inv_mem hs) (S.mul_mem (S.mul_mem hw hs) (S.inv_mem hw))
      have hn1 : s⁻¹ * c * s * c⁻¹ = 1 := by
        have : s⁻¹ * c * s * c⁻¹ ∈ S ⊓ N := ⟨hn1S, hn1N⟩
        rw [hSbot, Subgroup.mem_bot] at this
        exact this
      have h3 : c * s * c⁻¹ = s := by
        have : c * s * c⁻¹ = s * (s⁻¹ * c * s * c⁻¹) := by group
        rw [this, hn1, mul_one]
      have h4 : w * s * w⁻¹ = s := h2.trans h3
      calc w * s = (w * s * w⁻¹) * w := by group
        _ = s * w := by rw [h4]
    obtain ⟨a, b, hab⟩ := hS.1.2.2
    obtain ⟨a', rfl⟩ := QuotientGroup.mk_surjective a
    obtain ⟨b', rfl⟩ := QuotientGroup.mk_surjective b
    apply hab
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul]
    congr 1
    exact Subtype.ext (hcentral a'.1 a'.2 b'.1 b'.2)
  intro w hw
  have hcN : w * t * w⁻¹ * t⁻¹ ∈ N := ht w hw
  have hcS : w * t * w⁻¹ * t⁻¹ ∈ S := by
    have : w * t * w⁻¹ * t⁻¹ = w * (t * w⁻¹ * t⁻¹) := by group
    rw [this]
    exact S.mul_mem hw (hconj _ (S.inv_mem hw))
  have h1 : w * t * w⁻¹ * t⁻¹ = 1 := by
    have : w * t * w⁻¹ * t⁻¹ ∈ S ⊓ N := ⟨hcS, hcN⟩
    rw [hSbot, Subgroup.mem_bot] at this
    exact this
  have h2 : w * t = t * w := by
    have : w * t * w⁻¹ = t := mul_inv_eq_one.1 h1
    calc w * t = (w * t * w⁻¹) * w := by group
      _ = t * w := by rw [this]
  calc t * w * t⁻¹ = (w * t) * t⁻¹ := by rw [h2]
    _ = w := by group

open CFSG.GH74.GLS.C3.Layer1 CFSG.GH74.GLS.TwoThin

theorem mem_CxK_of_comm_mem_O {y r : G} {M Kc Λ : Subgroup G}
    (hKc : IsPCompIn 2 (centralizer ({y} : Set G)) Kc) (hr : r ∈ centralizer ({y} : Set G))
    (hΛM : Λ ≤ M) (hbar : PumpCalc.bar y Λ = PumpCalc.bar y Kc)
    (hcomm : ∀ l ∈ Λ, ⁅l, r⁆ ∈ pPrimeCoreOf 2 M) : r ∈ CxK y Kc := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set Y' := centralizer ({y} : Set G) with hY'
  have hcore : pPrimeCore 2 (barQ ↥Y') = ⊥ := CFSG.pPrimeCore_quotient_pPrimeCore_eq_bot 2
  have hSc : IsComponent (PumpCalc.bar y Kc) := PumpCalc.isComponent_bar hKc
  set Ñ : Subgroup ↥Y' := (pPrimeCoreOf 2 M ⊓ Y').subgroupOf Y' with hÑ
  set N : Subgroup (barQ ↥Y') := Ñ.map (barMk ↥Y') with hN
  have hNodd : Odd (Nat.card ↥N) := by
    have h1 : Nat.card ↥N ∣ Nat.card ↥Ñ := Subgroup.card_map_dvd Ñ _
    have h2 : Nat.card ↥Ñ = Nat.card ↥(pPrimeCoreOf 2 M ⊓ Y' : Subgroup G) :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe inf_le_right).toEquiv
    have h3 : Nat.card ↥(pPrimeCoreOf 2 M ⊓ Y' : Subgroup G) ∣ Nat.card ↥(pPrimeCoreOf 2 M) :=
      Subgroup.card_dvd_of_le inf_le_left
    rw [h2] at h1
    exact Odd.of_dvd_nat (card_pPrimeCoreOf_odd M) (h1.trans h3)
  have hSN : ∀ s ∈ PumpCalc.bar y Kc, ∀ n ∈ N, s * n * s⁻¹ ∈ N := by
    intro s hs n hn
    rw [← hbar] at hs
    obtain ⟨m, hm, rfl⟩ := hs
    obtain ⟨ñ, hñ, rfl⟩ := hn
    refine ⟨m * ñ * m⁻¹, ?_, by simp only [map_mul, map_inv]; rfl⟩
    have hmΛ : (m : G) ∈ Λ := Subgroup.mem_subgroupOf.mp hm
    have hmM : (m : G) ∈ M := hΛM hmΛ
    have hñO : (ñ : G) ∈ pPrimeCoreOf 2 M ∧ (ñ : G) ∈ Y' :=
      Subgroup.mem_inf.1 (Subgroup.mem_subgroupOf.mp hñ)
    show m * ñ * m⁻¹ ∈ Ñ
    rw [hÑ, Subgroup.mem_subgroupOf]
    refine Subgroup.mem_inf.2 ⟨?_, (m * ñ * m⁻¹).2⟩
    have := (Subgroup.mem_normalizer_iff.1
      (TwoThin.mem_normalizer_pPrimeCoreOf (Subgroup.le_normalizer hmM)) (ñ : G)).1 hñO.1
    simpa using this
  have ht : ∀ w ∈ PumpCalc.bar y Kc, w * PumpCalc.sbar r hr * w⁻¹ * (PumpCalc.sbar r hr)⁻¹ ∈ N := by
    intro w hw
    rw [← hbar] at hw
    obtain ⟨m, hm, rfl⟩ := hw
    have hmΛ : (m : G) ∈ Λ := Subgroup.mem_subgroupOf.mp hm
    have hc : ⁅(m : G), r⁆ ∈ pPrimeCoreOf 2 M := hcomm _ hmΛ
    have hcY : ⁅(m : G), r⁆ ∈ Y' := by
      have h1 : (m : G) * r * (m : G)⁻¹ * r⁻¹ ∈ Y' :=
        Y'.mul_mem (Y'.mul_mem (Y'.mul_mem m.2 hr) (Y'.inv_mem m.2)) (Y'.inv_mem hr)
      simpa [commutatorElement_def] using h1
    have heq : (⟨⁅(m : G), r⁆, hcY⟩ : ↥Y') = m * ⟨r, hr⟩ * m⁻¹ * ⟨r, hr⟩⁻¹ :=
      Subtype.ext (by simp [commutatorElement_def])
    refine ⟨⟨⁅(m : G), r⁆, hcY⟩, ?_, ?_⟩
    · show (⟨⁅(m : G), r⁆, hcY⟩ : ↥Y') ∈ Ñ
      rw [hÑ, Subgroup.mem_subgroupOf]
      exact ⟨hc, hcY⟩
    · rw [heq]
      simp [PumpCalc.sbar, map_mul, map_inv]; rfl
  refine PumpRigid.mem_CxK_of_centralizes hKc hr (fun w hw => ?_)
  exact centralizes_of_comm_mem_odd hcore hSc hNodd hSN ht w hw

open SD in
theorem pPrimeCoreOf_le_of_isSubnormal_barIn {K M : Subgroup G} (hKM : K ≤ M)
    (hsub : (barIn M K).IsSubnormal) : pPrimeCoreOf 2 K ≤ pPrimeCoreOf 2 M := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have key := map_pPrimeCore_le_of_isSubnormal_map (K := K.subgroupOf M) hsub
  let e : ↥K ≃* ↥(K.subgroupOf M) := (Subgroup.subgroupOfEquivOfLe hKM).symm
  have hmap : (pPrimeCore 2 ↥K).map e.toMonoidHom = pPrimeCore 2 ↥(K.subgroupOf M) :=
    pPrimeCore_map_iso 2 e
  rintro _ ⟨k, hk, rfl⟩
  have h1 : e k ∈ pPrimeCore 2 ↥(K.subgroupOf M) := by
    rw [← hmap]; exact Subgroup.mem_map_of_mem _ hk
  have h2 := key ⟨e k, h1, rfl⟩
  exact ⟨_, h2, rfl⟩

open SD in
theorem Q_le_CMbar_of_c1 {x : G} {K A M P Q H : Subgroup G} (hs : Stage2Setup G x K A M P Q)
    (h1 : Stage2Concl1Core x K M Q H) (hc1 : barIn M H = barIn M K) : Q ≤ CMbar M K := by
  have hKM : K ≤ M := h1.K_le
  have hHsub : (barIn M H).IsSubnormal :=
    Subgroup.IsSubnormal.map (QuotientGroup.mk'_surjective _) h1.H_min.2.1.2
  have hOK : pPrimeCoreOf 2 K ≤ pPrimeCoreOf 2 M :=
    pPrimeCoreOf_le_of_isSubnormal_barIn hKM (hc1 ▸ hHsub)
  intro q hq
  have hqM : q ∈ M := h1.Q_le hq
  refine (mem_CMbar_iff hKM ⟨q, hqM⟩).2 (Subgroup.mem_centralizer_iff.2 fun y hy => ?_)
  obtain ⟨k, hk, rfl⟩ := Subgroup.mem_map.1 hy
  have hkK : (k : G) ∈ K := Subgroup.mem_subgroupOf.1 hk
  have hqC : q ∈ CxK x K := hs.sylowQ.le hq
  have hcomm : ⁅(k : G), q⁆ ∈ pPrimeCoreOf 2 K := (Subgroup.mem_inf.1 hqC).2.2.2 (k : G) hkK
  have := (comm_mem_pPrimeCoreOf_iff k ⟨q, hqM⟩).1 (hOK hcomm)
  exact commutatorElement_eq_one_iff_mul_comm.1 this

theorem exists_involution_mem_center {R : Subgroup G} (hR : IsPGroup 2 ↥R) {x : G} (hxR : x ∈ R)
    (hx1 : x ≠ 1) : ∃ u ∈ R, orderOf u = 2 ∧ ∀ r ∈ R, u * r = r * u := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Nontrivial ↥R := ⟨⟨⟨x, hxR⟩, 1, fun h => hx1 (congrArg Subtype.val h)⟩⟩
  have := hR.center_nontrivial
  have hC : IsPGroup 2 ↥(center ↥R) := hR.of_injective (center ↥R).subtype (center ↥R).subtype_injective
  obtain ⟨n, hn⟩ := hC.exists_card_eq
  have hn0 : n ≠ 0 := by
    rintro rfl
    have h1 : 1 < Nat.card ↥(center ↥R) := Finite.one_lt_card
    rw [hn] at h1
    simp at h1
  have hdvd : 2 ∣ Nat.card ↥(center ↥R) := by rw [hn]; exact dvd_pow_self 2 hn0
  obtain ⟨a, ha⟩ := exists_prime_orderOf_dvd_card' 2 hdvd
  refine ⟨((a : ↥R) : G), (a : ↥R).2, ?_, fun r hr => ?_⟩
  · rw [Subgroup.orderOf_coe, Subgroup.orderOf_coe]
    exact ha
  · have := Subgroup.mem_center_iff.1 a.2 ⟨r, hr⟩
    exact (congrArg Subtype.val this).symm

omit [Finite G] in
theorem commutator_mul_commuting {a b r s : G} (hrb : r * b = b * r)
    (hrs : r * s = s * r) (hsa : s * a = a * s) :
    ⁅a * r, b * s⁆ = ⁅a, b⁆ := by
  have hrb' : r * b⁻¹ = b⁻¹ * r := by
    calc r * b⁻¹ = b⁻¹ * (b * r) * b⁻¹ := by group
      _ = b⁻¹ * (r * b) * b⁻¹ := by rw [hrb]
      _ = b⁻¹ * r := by group
  have hsa' : s * a⁻¹ = a⁻¹ * s := by
    calc s * a⁻¹ = a⁻¹ * (a * s) * a⁻¹ := by group
      _ = a⁻¹ * (s * a) * a⁻¹ := by rw [hsa]
      _ = a⁻¹ * s := by group
  simp only [commutatorElement_def, mul_inv_rev]
  calc a * r * (b * s) * (r⁻¹ * a⁻¹) * (s⁻¹ * b⁻¹)
      = a * (r * b) * s * r⁻¹ * a⁻¹ * s⁻¹ * b⁻¹ := by group
    _ = a * (b * r) * s * r⁻¹ * a⁻¹ * s⁻¹ * b⁻¹ := by rw [hrb]
    _ = a * b * (r * s) * r⁻¹ * a⁻¹ * s⁻¹ * b⁻¹ := by group
    _ = a * b * (s * r) * r⁻¹ * a⁻¹ * s⁻¹ * b⁻¹ := by rw [hrs]
    _ = a * b * s * a⁻¹ * s⁻¹ * b⁻¹ := by group
    _ = a * b * (s * a⁻¹) * s⁻¹ * b⁻¹ := by group
    _ = a * b * (a⁻¹ * s) * s⁻¹ * b⁻¹ := by rw [hsa']
    _ = a * b * a⁻¹ * b⁻¹ := by group

omit [Finite G] in
theorem commute_of_commutator_central {K : Subgroup G} (hK : ⁅K, K⁆ = K) {q : G}
    (hqK : ∀ k ∈ K, ⁅k, q⁆ ∈ K) (hcen : ∀ k ∈ K, ∀ k' ∈ K, ⁅k, q⁆ * k' = k' * ⁅k, q⁆) :
    ∀ k ∈ K, k * q = q * k := by
  have hT : ⁅K, K⁆ ≤ K ⊓ centralizer ({q} : Set G) := by
    rw [Subgroup.commutator_def, Subgroup.closure_le]
    rintro _ ⟨a, ha, b, hb, rfl⟩
    refine ⟨hK ▸ Subgroup.commutator_mem_commutator ha hb, Subgroup.mem_centralizer_singleton_iff.2 ?_⟩
    have hαK : ⁅a, q⁆ ∈ K := hqK a ha
    have hβK : ⁅b, q⁆ ∈ K := hqK b hb
    have h1 : q * a * q⁻¹ = a * (⁅a, q⁆)⁻¹ := by
      have hαa : (⁅a, q⁆)⁻¹ * a = a * (⁅a, q⁆)⁻¹ := (Commute.inv_left (hcen a ha a ha)).eq
      rw [← hαa]
      simp only [commutatorElement_def]; group
    have h2 : q * b * q⁻¹ = b * (⁅b, q⁆)⁻¹ := by
      have hβb : (⁅b, q⁆)⁻¹ * b = b * (⁅b, q⁆)⁻¹ := (Commute.inv_left (hcen b hb b hb)).eq
      rw [← hβb]
      simp only [commutatorElement_def]; group
    have hαb : (⁅a, q⁆)⁻¹ * b = b * (⁅a, q⁆)⁻¹ := (Commute.inv_left (hcen a ha b hb)).eq
    have hαβ : (⁅a, q⁆)⁻¹ * (⁅b, q⁆)⁻¹ = (⁅b, q⁆)⁻¹ * (⁅a, q⁆)⁻¹ :=
      (Commute.inv_left (Commute.inv_right (hcen a ha _ hβK))).eq
    have hβa : (⁅b, q⁆)⁻¹ * a = a * (⁅b, q⁆)⁻¹ := (Commute.inv_left (hcen b hb a ha)).eq
    have key : q * ⁅a, b⁆ * q⁻¹ = ⁅a, b⁆ := by
      calc q * ⁅a, b⁆ * q⁻¹ = ⁅q * a * q⁻¹, q * b * q⁻¹⁆ := by
            simp only [commutatorElement_def]; group
        _ = ⁅a * (⁅a, q⁆)⁻¹, b * (⁅b, q⁆)⁻¹⁆ := by rw [h1, h2]
        _ = ⁅a, b⁆ := commutator_mul_commuting hαb hαβ hβa
    calc ⁅a, b⁆ * q = (q * ⁅a, b⁆ * q⁻¹) * q := by rw [key]
      _ = q * ⁅a, b⁆ := by group
  intro k hk
  have hk' : k ∈ ⁅K, K⁆ := by rw [hK]; exact hk
  exact Subgroup.mem_centralizer_singleton_iff.1 (hT hk').2

end Thm2Comp

open Thm2Comp SD in
theorem isSylowOf_CMbar_of_le {x : G} {K A M P Q : Subgroup G} (hs : Stage2Setup G x K A M P Q)
    (hKM : K ≤ M) (hQR : Q ≤ CMbar M K) : IsSylowOf 2 Q (CMbar M K) := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hxo : orderOf x = 2 := hs.pair.1.1.1.1
  have hKc : IsPCompIn 2 (centralizer ({x} : Set G)) K := hs.pair.1.1.1.2.2
  have hILo : IsILo 2 x K := hs.pair.1.1.1
  have hterm : IsTwoTerminal x K := hs.pair.1.2.2
  have hQsyl : IsSylowOf 2 Q (CxK x K) := hs.sylowQ
  have hxQ : x ∈ Q := x_mem_Q hs
  have hx1 : x ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hxo
    omega
  obtain ⟨R, hRsyl, hQR'⟩ : ∃ R : Subgroup G, IsSylowOf 2 R (CMbar M K) ∧ Q ≤ R := by
    have hQp : IsPGroup 2 ↥(Q.subgroupOf (CMbar M K)) := hQsyl.isPGroup.comap_subtype
    obtain ⟨P', hP'⟩ := hQp.exists_le_sylow
    refine ⟨(P' : Subgroup ↥(CMbar M K)).map (CMbar M K).subtype, ⟨P', rfl⟩, fun q hq => ?_⟩
    exact ⟨⟨q, hQR hq⟩, hP' (Subgroup.mem_subgroupOf.2 hq), rfl⟩
  suffices hRQ : R ≤ Q from by
    have : R = Q := le_antisymm hRQ hQR'
    rw [← this]
    exact hRsyl
  have hRp : IsPGroup 2 ↥R := hRsyl.isPGroup
  have hRcomm : ∀ r ∈ R, ∀ k ∈ K, ⁅k, r⁆ ∈ pPrimeCoreOf 2 M := fun r hr k hk =>
    (hRsyl.le hr).2.2.2 k (Subgroup.mem_sup_left hk)
  have hRx : ∀ c ∈ R, c ∈ centralizer ({x} : Set G) → c ∈ CxK x K := fun c hcR hcx =>
    mem_CxK_of_comm_mem_O (M := M) (Kc := K) (Λ := K) hKc hcx hKM rfl
      (fun l hl => hRcomm c hcR l hl)
  have hCRQ : R ⊓ centralizer ({x} : Set G) = Q :=
    hQsyl.eq_of_le (le_inf hQR' (hQsyl.le.trans inf_le_left)) (fun c hc => hRx c hc.1 hc.2)
      hRp.to_inf_left
  obtain ⟨u, huR, hu2, huc⟩ := exists_involution_mem_center hRp (hQR' hxQ) hx1
  have hux : u ∈ centralizer ({x} : Set G) :=
    Subgroup.mem_centralizer_singleton_iff.2 (huc x (hQR' hxQ))
  have huQ : u ∈ Q := by
    rw [← hCRQ]
    exact ⟨huR, hux⟩
  have huQc : ∀ q ∈ Q, u * q = q * u := fun q hq => huc q (hQR' hq)
  have hucs : u ∈ centralizerSection K (pPrimeCoreOf 2 K) :=
    (Subgroup.mem_inf.1 (hQsyl.le huQ)).2
  have hR3 : 3 ≤ pRank 2 ↥(centralizer ({u} : Set G)) := by
    have h3 : 3 ≤ pRank 2 G := by
      rw [pRank_two_eq_twoRank]
      exact hs.hyp.rank
    exact TwoThin.rankThreeCentralizers G hs.hyp.simple hs.hyp.nonab h3 u hu2
  obtain ⟨K_u, hltu⟩ := TwoThin.exists_pumpup_of_involution hxo hu2 hKc hux hucs hILo hR3
  obtain ⟨hxKu, ⟨e⟩⟩ := hterm.2.1 u K_u hltu
  have hQu : IsSylowOf 2 Q (CxK u K_u) := hterm.2.2 Q hQsyl u K_u hltu huQ huQc
  have hKuc : IsPCompIn 2 (centralizer ({u} : Set G)) K_u := hltu.2.1.2.2
  have hle : TwoThin.hatCard K_u ≤ TwoThin.hatCard K := (Nat.card_congr e.toEquiv).le
  obtain ⟨Λ, hΛ, -, -, -, -, hcases⟩ :=
    C3.Layer1.PumpRigid.rigid_step hltu (TwoThin.mem_centralizer_symm hux) hle
  have hbar : C3.Layer1.PumpCalc.bar u Λ = C3.Layer1.PumpCalc.bar u K_u :=
    (hcases.resolve_right (fun h => h.1 hxKu)).2
  have hΛK : Λ ≤ K := fun l hl => (hΛ.le hl).1
  have hRle : R ≤ CxK u K_u := fun r hr =>
    mem_CxK_of_comm_mem_O hKuc (Subgroup.mem_centralizer_singleton_iff.2 (huc r hr).symm)
      (hΛK.trans hKM) hbar (fun l hl => hRcomm r hr l (hΛK hl))
  exact (hQu.eq_of_le hQR' hRle hRp).le

open Thm2Comp in
theorem isSylowOf_CMbar_of_c1 {x : G} {K A M P Q H : Subgroup G} (hs : Stage2Setup G x K A M P Q)
    (h1 : Stage2Concl1Core x K M Q H) (hc1 : barIn M H = barIn M K) :
    IsSylowOf 2 Q (CMbar M K) :=
  isSylowOf_CMbar_of_le hs h1.K_le (Q_le_CMbar_of_c1 hs h1 hc1)

namespace SD

open Thm2Comp

theorem pRank_centBarK_le_of_isSylowOf {K M Q : Subgroup G} (hKM : K ≤ M)
    (hQ : IsSylowOf 2 Q (CMbar M K)) : pRank 2 ↥(centBarK M K) ≤ pRank 2 ↥Q :=
  (pRank_centBarK_le_pRank_CMbar hKM).trans (pRank_eq_pRank_sylow hQ).le

theorem pRank_centBarK_le_one_of_isSylowOf {x : G} {K A M P Q H : Subgroup G}
    (hs : Stage2Setup G x K A M P Q) (h1 : Stage2Concl1Core x K M Q H)
    (hQ : IsSylowOf 2 Q (CMbar M K)) (hr : pRank 2 ↥(CxK x K) ≤ 1) :
    pRank 2 ↥(centBarK M K) ≤ 1 :=
  (pRank_centBarK_le_of_isSylowOf h1.K_le hQ).trans
    ((C3.Layer1.Back.pRank_mono' hs.sylowQ.le).trans hr)

theorem pRank_centBarK_le_one_of_c1 {x : G} {K A M P Q H : Subgroup G}
    (hs : Stage2Setup G x K A M P Q) (h1 : Stage2Concl1Core x K M Q H)
    (hc1 : barIn M H = barIn M K) (hr : pRank 2 ↥(CxK x K) ≤ 1) :
    pRank 2 ↥(centBarK M K) ≤ 1 :=
  pRank_centBarK_le_one_of_isSylowOf hs h1 (isSylowOf_CMbar_of_c1 hs h1 hc1) hr

theorem pRank_component_le_one_of_c1 {x : G} {K A M P Q H : Subgroup G}
    (hs : Stage2Setup G x K A M P Q) (h1 : Stage2Concl1Core x K M Q H)
    (hc1 : barIn M H = barIn M K) (hr : pRank 2 ↥(CxK x K) ≤ 1) {J : Subgroup (Mbar M)}
    (hJ : IsComponent J) (hJK : J ≠ barIn M K) : pRank 2 ↥J ≤ 1 := by
  have hHsub : (barIn M H).IsSubnormal :=
    Subgroup.IsSubnormal.map (QuotientGroup.mk'_surjective _) h1.H_min.2.1.2
  have hKc : IsComponent (barIn M K) := isComponent_barIn_of_isSubnormal hs h1.K_le (hc1 ▸ hHsub)
  have hJc : J ≤ centBarK M K :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.1
      ((CFSG.LocalCores.distinct_components_commute hJ hKc).resolve_left hJK)
  exact (C3.Layer1.Back.pRank_mono' hJc).trans (pRank_centBarK_le_one_of_c1 hs h1 hc1 hr)

