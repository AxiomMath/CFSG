omit [Finite G] in
theorem exists_mul_of_mem_sup {H K : Subgroup G} (hc : ∀ h ∈ H, ∀ k ∈ K, h * k = k * h) {g : G}
    (hg : g ∈ H ⊔ K) : ∃ h ∈ H, ∃ k ∈ K, g = h * k := by
  let S : Subgroup G :=
    { carrier := {g | ∃ h ∈ H, ∃ k ∈ K, g = h * k}
      one_mem' := ⟨1, one_mem _, 1, one_mem _, by simp⟩
      mul_mem' := by
        rintro _ _ ⟨h₁, hh₁, k₁, hk₁, rfl⟩ ⟨h₂, hh₂, k₂, hk₂, rfl⟩
        refine ⟨h₁ * h₂, mul_mem hh₁ hh₂, k₁ * k₂, mul_mem hk₁ hk₂, ?_⟩
        calc h₁ * k₁ * (h₂ * k₂) = h₁ * (k₁ * h₂) * k₂ := by group
          _ = h₁ * (h₂ * k₁) * k₂ := by rw [← hc h₂ hh₂ k₁ hk₁]
          _ = h₁ * h₂ * (k₁ * k₂) := by group
      inv_mem' := by
        rintro _ ⟨h, hh, k, hk, rfl⟩
        refine ⟨h⁻¹, inv_mem hh, k⁻¹, inv_mem hk, ?_⟩
        calc (h * k)⁻¹ = (k * h)⁻¹ := by rw [hc h hh k hk]
          _ = h⁻¹ * k⁻¹ := by group }
  have hle : H ⊔ K ≤ S := sup_le (fun h hh => ⟨h, hh, 1, one_mem _, by simp⟩)
    (fun k hk => ⟨1, one_mem _, k, hk, by simp⟩)
  exact hle hg

omit [Finite G] in
theorem card_sup_of_commute {H K : Subgroup G} (hc : ∀ h ∈ H, ∀ k ∈ K, h * k = k * h)
    (hi : H ⊓ K = ⊥) : Nat.card ↥(H ⊔ K) = Nat.card ↥H * Nat.card ↥K := by
  let f : ↥H × ↥K → ↥(H ⊔ K) := fun p =>
    ⟨(p.1 : G) * p.2, mul_mem (Subgroup.mem_sup_left p.1.2) (Subgroup.mem_sup_right p.2.2)⟩
  have hinj : Function.Injective f := by
    rintro ⟨⟨h₁, hh₁⟩, ⟨k₁, hk₁⟩⟩ ⟨⟨h₂, hh₂⟩, ⟨k₂, hk₂⟩⟩ hf
    have hf' : h₁ * k₁ = h₂ * k₂ := congrArg Subtype.val hf
    have h1 : h₂⁻¹ * h₁ = k₂ * k₁⁻¹ := by
      calc h₂⁻¹ * h₁ = h₂⁻¹ * (h₁ * k₁) * k₁⁻¹ := by group
        _ = h₂⁻¹ * (h₂ * k₂) * k₁⁻¹ := by rw [hf']
        _ = k₂ * k₁⁻¹ := by group
    have hmem : h₂⁻¹ * h₁ ∈ H ⊓ K :=
      Subgroup.mem_inf.2 ⟨mul_mem (inv_mem hh₂) hh₁, h1 ▸ mul_mem hk₂ (inv_mem hk₁)⟩
    rw [hi, Subgroup.mem_bot] at hmem
    have e1 : h₁ = h₂ := by
      have := congrArg (h₂ * ·) hmem
      simpa using this
    have e2 : k₁ = k₂ := by
      rw [hmem] at h1
      have : k₂ * k₁⁻¹ = 1 := h1.symm
      exact (mul_inv_eq_one.1 this).symm
    subst e1
    subst e2
    rfl
  have hsurj : Function.Surjective f := by
    rintro ⟨g, hg⟩
    obtain ⟨h, hh, k, hk, rfl⟩ := exists_mul_of_mem_sup hc hg
    exact ⟨(⟨h, hh⟩, ⟨k, hk⟩), rfl⟩
  rw [← Nat.card_prod]
  exact (Nat.card_congr (Equiv.ofBijective f ⟨hinj, hsurj⟩)).symm

omit [Finite G] in
theorem isElementaryAbelian_sup {H K : Subgroup G} (hH : CFSG.IsElementaryAbelian 2 ↥H)
    (hK : CFSG.IsElementaryAbelian 2 ↥K) (hc : ∀ h ∈ H, ∀ k ∈ K, h * k = k * h) :
    CFSG.IsElementaryAbelian 2 ↥(H ⊔ K) := by
  have hHc : ∀ a ∈ H, ∀ b ∈ H, a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (mul_comm' (⟨a, ha⟩ : ↥H) ⟨b, hb⟩)
  have hKc : ∀ a ∈ K, ∀ b ∈ K, a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (mul_comm' (⟨a, ha⟩ : ↥K) ⟨b, hb⟩)
  have hHs : ∀ a ∈ H, a * a = 1 := fun a ha => by
    rw [← sq]; exact CFSG.elemPow_eq_one_of_isElementaryAbelian (p := 2) (A := H) a ha
  have hKs : ∀ a ∈ K, a * a = 1 := fun a ha => by
    rw [← sq]; exact CFSG.elemPow_eq_one_of_isElementaryAbelian (p := 2) (A := K) a ha
  refine C3.Layer1.Back.isElementaryAbelian_of_forall ?_ ?_
  · intro u hu v hv
    obtain ⟨h, hh, k, hk, rfl⟩ := exists_mul_of_mem_sup hc hu
    obtain ⟨h', hh', k', hk', rfl⟩ := exists_mul_of_mem_sup hc hv
    calc h * k * (h' * k') = h * (k * h') * k' := by group
      _ = h * (h' * k) * k' := by rw [← hc h' hh' k hk]
      _ = h * h' * (k * k') := by group
      _ = h' * h * (k' * k) := by rw [hHc h hh h' hh', hKc k hk k' hk']
      _ = h' * (h * k') * k := by group
      _ = h' * (k' * h) * k := by rw [hc h hh k' hk']
      _ = h' * k' * (h * k) := by group
  · intro u hu
    obtain ⟨h, hh, k, hk, rfl⟩ := exists_mul_of_mem_sup hc hu
    calc h * k * (h * k) = h * (k * h) * k := by group
      _ = h * (h * k) * k := by rw [← hc h hh k hk]
      _ = h * h * (k * k) := by group
      _ = 1 := by rw [hHs h hh, hKs k hk, one_mul]

theorem eq_one_of_mem_of_mem_pPrimeCoreOf {T K : Subgroup G} (hT : IsPGroup 2 ↥T) {g : G}
    (hgT : g ∈ T) (hgO : g ∈ pPrimeCoreOf 2 K) : g = 1 := by
  obtain ⟨n, hn⟩ := hT ⟨g, hgT⟩
  have h1 : g ^ (2 ^ n) = 1 := congrArg Subtype.val hn
  have h2 : orderOf g ∣ 2 ^ n := orderOf_dvd_of_pow_eq_one h1
  have h3 : orderOf g ∣ Nat.card ↥(pPrimeCoreOf 2 K) := Subgroup.orderOf_dvd_natCard _ hgO
  have hcop : Nat.Coprime (2 ^ n) (Nat.card ↥(pPrimeCoreOf 2 K)) :=
    (Nat.coprime_two_left.2 (TwoThin.card_pPrimeCoreOf_odd K)).pow_left n
  have h4 : orderOf g ∣ Nat.gcd (2 ^ n) (Nat.card ↥(pPrimeCoreOf 2 K)) := Nat.dvd_gcd h2 h3
  rw [hcop] at h4
  exact orderOf_eq_one_iff.1 (Nat.dvd_one.1 h4)

