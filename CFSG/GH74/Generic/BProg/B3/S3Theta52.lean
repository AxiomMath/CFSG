@[expose] def IsExtSource2 (x : G) (K A B : Subgroup G) : Prop :=
  A ≤ B ∧ x ∈ B ∧ B ≤ centralizer ({x} : Set G) ∧ CFSG.IsElementaryAbelian 2 ↥B ∧ 4 ≤ pRank 2 ↥B ∧
    pRank 2 ↥B ≤ 6 ∧ B = A ⊔ (B ⊓ centralizerSection K (pPrimeCoreOf 2 K))

@[expose] def IsBAdmPair (x : G) (K B : Subgroup G) (y : G) (Lb : Subgroup (CentralizerBar x)) :
    Prop :=
  IsSubtermPair x K y Lb ∧ ∃ (F : Subgroup G) (Ib : Subgroup (CentralizerBar x)),
    F ≤ B ∧ 2 * Nat.card ↥F = Nat.card ↥B ∧ NonsolvAdm x y K F Lb Ib

@[expose] noncomputable def thetaPrime52 (B : Subgroup G) : Subgroup G :=
  ⨆ (F : Subgroup G) (_ : F ≤ B) (_ : 2 * Nat.card ↥F = Nat.card ↥B), thetaHalf 2 F

