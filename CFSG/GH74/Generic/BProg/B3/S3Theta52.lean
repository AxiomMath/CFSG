theorem pRank_hyperplane {B F : Subgroup G} (hBel : CFSG.IsElementaryAbelian 2 ↥B) (hFB : F ≤ B)
    (hF : 2 * Nat.card ↥F = Nat.card ↥B) : pRank 2 ↥F + 1 = pRank 2 ↥B := by
  have hFel : CFSG.IsElementaryAbelian 2 ↥F := Th2Sig6.isElementaryAbelian_of_le hBel hFB
  have hB := C3.Layer1.Back.card_eq_two_pow_pRank hBel
  have hF' := C3.Layer1.Back.card_eq_two_pow_pRank hFel
  rw [hB, hF', ← pow_succ'] at hF
  exact Nat.pow_right_injective le_rfl hF

theorem thetaHalf_eq_of_isE {B F : Subgroup G} (hB : IsE 4 ⊤ B) (hbal : IsKBal 3 B)
    (hweak : IsWeakKBal 2 B) (hF : IsE 3 B F) : thetaHalf 2 F = thetaHalf 2 B :=
  b_ig_21_10 G 2 (by norm_num) B F hB hbal hweak hF

theorem normalizer_le_normalizer_thetaHalf_two {B Q : Subgroup G} (hB : IsE 4 ⊤ B)
    (hbal : IsKBal 3 B) (hweak : IsWeakKBal 2 B) (hQ : IsE 3 B Q) :
    normalizer (Q : Set G) ≤ normalizer (thetaHalf 2 B : Set G) := by
  intro n hn
  have hEq : thetaHalf 2 Q = thetaHalf 2 B := thetaHalf_eq_of_isE hB hbal hweak hQ
  have hQn : Q.map (MulAut.conj n).toMonoidHom = Q := Th2.cj_eq_of_mem_normalizer hn
  refine Th2.mem_normalizer_of_cj_eq ?_
  show (thetaHalf 2 B).map (MulAut.conj n).toMonoidHom = thetaHalf 2 B
  calc (thetaHalf 2 B).map (MulAut.conj n).toMonoidHom
      = (thetaHalf 2 Q).map (MulAut.conj n).toMonoidHom := by rw [hEq]
    _ = thetaHalf 2 (Q.map (MulAut.conj n).toMonoidHom) := (thetaHalf_map_conj 2 n Q).symm
    _ = thetaHalf 2 Q := by rw [hQn]
    _ = thetaHalf 2 B := hEq

end S3Theta52

