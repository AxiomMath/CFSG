theorem exists_Q {x : G} {K A E : Subgroup G} (hK : IsPCompIn 2 (centralizer ({x} : Set G)) K)
    (hZ : ∀ z : ↥K ⧸ pPrimeCore 2 ↥K, (∀ g, g * z = z * g) → z = 1) (hEK : E ≤ K)
    (hAE : A = E ⊔ zpowers x) (hAel : CFSG.IsElementaryAbelian 2 ↥A) :
    ∃ Q : Subgroup G, Q ≤ CxK x K ∧ IsPGroup 2 ↥Q ∧ x ∈ Q ∧ (∀ e ∈ E, ∀ q ∈ Q, e * q = q * e) ∧
      (∀ e ∈ E, e ∈ Q → e = 1) ∧
      ∀ F : Subgroup G, F ≤ CxK x K → CFSG.IsElementaryAbelian 2 ↥F →
        ∃ F' : Subgroup G, F' ≤ Q ∧ CFSG.IsElementaryAbelian 2 ↥F' ∧
          Nat.card ↥F' = Nat.card ↥F := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hKC : K ≤ centralizer ({x} : Set G) := hK.1
  have hxC : x ∈ CxK x K := mem_CxK_self hKC
  have hxA : x ∈ A := hAE ▸ Subgroup.mem_sup_right (Subgroup.mem_zpowers x)
  have hAN : A ≤ centralizer ({x} : Set G) ⊓ normalizer (K : Set G) := by
    rw [hAE]
    refine sup_le (fun e he => Subgroup.mem_inf.2
      ⟨hKC (hEK he), Subgroup.le_normalizer (hEK he)⟩) ?_
    rw [Subgroup.zpowers_le]
    exact Subgroup.mem_inf.2 ⟨Subgroup.mem_centralizer_singleton_iff.2 rfl,
      mem_normalizer_of_le_centralizer hKC⟩
  have hAnorm : A ≤ normalizer ((CxK x K : Subgroup G) : Set G) := by
    intro a ha
    obtain ⟨hax, haK⟩ := Subgroup.mem_inf.1 (hAN ha)
    rw [Subgroup.mem_normalizer_iff]
    intro c
    refine ⟨fun hc => conj_mem_CxK hax haK hc, fun hc => ?_⟩
    have hax' : a⁻¹ ∈ centralizer ({x} : Set G) := (centralizer ({x} : Set G)).inv_mem hax
    have haK' : a⁻¹ ∈ normalizer (K : Set G) := (normalizer (K : Set G)).inv_mem haK
    have := conj_mem_CxK hax' haK' hc
    rwa [show a⁻¹ * (a * c * a⁻¹) * a⁻¹⁻¹ = c by group] at this
  obtain ⟨T, hT, hAT⟩ := exists_isSylowOf_ge (le_sup_left : A ≤ A ⊔ CxK x K)
    (CFSG.IsElementaryAbelian.isPGroup 2 ↥A)
  have hMN : A ⊔ CxK x K ≤ normalizer ((CxK x K : Subgroup G) : Set G) :=
    sup_le hAnorm Subgroup.le_normalizer
  have hQ : IsSylowOf 2 (T ⊓ CxK x K) (CxK x K) := hT.inf_of_le_normalizer le_sup_right hMN
  have hTp : IsPGroup 2 ↥T := hT.isPGroup
  have hEA : E ≤ A := hAE ▸ le_sup_left
  have hcomm : ∀ e ∈ E, ∀ q ∈ T ⊓ CxK x K, e * q = q * e := by
    intro e he q hq
    obtain ⟨hqT, hqC⟩ := Subgroup.mem_inf.1 hq
    have hmemO : ⁅e, q⁆ ∈ pPrimeCoreOf 2 K := (Subgroup.mem_inf.1 hqC).2.2.2 e (hEK he)
    have hmemT : ⁅e, q⁆ ∈ T := by
      rw [commutatorElement_def]
      exact T.mul_mem (T.mul_mem (T.mul_mem (hAT (hEA he)) hqT) (T.inv_mem (hAT (hEA he))))
        (T.inv_mem hqT)
    exact commutatorElement_eq_one_iff_mul_comm.1
      (eq_one_of_mem_of_mem_pPrimeCoreOf hTp hmemT hmemO)
  refine ⟨T ⊓ CxK x K, inf_le_right, hQ.isPGroup, Subgroup.mem_inf.2 ⟨hAT hxA, hxC⟩, hcomm, ?_, ?_⟩
  · intro e he heQ
    obtain ⟨heT, heC⟩ := Subgroup.mem_inf.1 heQ
    set e' : ↥K := ⟨e, hEK he⟩ with he'
    have hcent : ∀ g : ↥K ⧸ pPrimeCore 2 ↥K,
        g * (QuotientGroup.mk e') = (QuotientGroup.mk e') * g := by
      intro g
      obtain ⟨k', rfl⟩ := QuotientGroup.mk_surjective g
      have hO : ⁅(k' : G), e⁆ ∈ pPrimeCoreOf 2 K := (Subgroup.mem_inf.1 heC).2.2.2 k' k'.2
      obtain ⟨o, ho, hoe⟩ := hO
      have hoeq : o = ⁅k', e'⁆ := Subtype.ext hoe
      have h1 : QuotientGroup.mk' (pPrimeCore 2 ↥K) ⁅k', e'⁆ = 1 := by
        rw [← hoeq]; exact (QuotientGroup.eq_one_iff o).2 ho
      rw [map_commutatorElement] at h1
      exact commutatorElement_eq_one_iff_mul_comm.1 h1
    have h2 : (QuotientGroup.mk e' : ↥K ⧸ pPrimeCore 2 ↥K) = 1 := hZ _ hcent
    have h3 : e' ∈ pPrimeCore 2 ↥K := (QuotientGroup.eq_one_iff e').1 h2
    exact eq_one_of_mem_of_mem_pPrimeCoreOf hTp heT ⟨e', h3, rfl⟩
  · intro F hFC hFel
    have hFp : IsPGroup 2 ↥F := CFSG.IsElementaryAbelian.isPGroup 2 ↥F
    obtain ⟨S, hS, hFS⟩ := exists_isSylowOf_ge hFC hFp
    obtain ⟨k, hkC, hk⟩ := hQ.exists_mem_conj hS
    refine ⟨F.map (MulAut.conj k⁻¹).toMonoidHom, ?_, ?_, ?_⟩
    · rintro _ ⟨f, hf, rfl⟩
      have := (hk f).1 (hFS hf)
      simpa [MulAut.conj_apply, mul_assoc] using this
    · exact CFSG.IsElementaryAbelian.map (p := 2) (A := F) (MulAut.conj k⁻¹).toMonoidHom
    · exact Subgroup.card_map_of_injective (MulAut.conj k⁻¹).injective

theorem le_of_isPCompIn {X : Type} [Group X] [Finite X] {F : Type} [Field F] [Finite F] {u : X}
    {J H L' : Subgroup X} (h : B1.PilotS3.IsSplit3 F u J H) (hL' : IsPCompIn 2 H L') : L' ≤ J := by
  have hperf : Group.IsPerfect ↥(L'.subgroupOf H) :=
    CFSG.ComponentClassification.CatalogueBAlternating.pComponent_perfect hL'.2
  have h1 : L'.subgroupOf H ≤ J.subgroupOf H := by
    have h2 : ⁅L'.subgroupOf H, L'.subgroupOf H⁆ ≤ J.subgroupOf H := by
      rw [Subgroup.commutator_le]
      intro g₁ _ g₂ _
      rw [Subgroup.mem_subgroupOf]
      exact h.comm g₁ g₁.2 g₂ g₂.2
    have := hperf
    rwa [Subgroup.commutator_eq_self] at h2
  exact fun g hg => Subgroup.mem_subgroupOf.1
    (h1 (Subgroup.mem_subgroupOf.2 hg : (⟨g, hL'.1 hg⟩ : ↥H) ∈ L'.subgroupOf H))

theorem card_le_two_mul_of_cover {B CB : Subgroup G} {a' : G} (ha' : a' ∈ B) (hCB : CB ≤ B)
    (hcov : ∀ b ∈ B, b ∈ CB ∨ a' * b ∈ CB) : Nat.card ↥B ≤ 2 * Nat.card ↥CB := by
  classical
  let g : ↥CB × Bool → ↥B := fun p =>
    if p.2 then ⟨a'⁻¹ * (p.1 : G), B.mul_mem (B.inv_mem ha') (hCB p.1.2)⟩ else ⟨p.1, hCB p.1.2⟩
  have hg : Function.Surjective g := by
    rintro ⟨b, hb⟩
    rcases hcov b hb with h | h
    · exact ⟨(⟨b, h⟩, false), by simp [g]⟩
    · refine ⟨(⟨a' * b, h⟩, true), ?_⟩
      apply Subtype.ext
      simp [g]
  have := Nat.card_le_card_of_surjective g hg
  rw [Nat.card_prod] at this
  simpa [mul_comm] using this

omit [Finite G] in
theorem exists_coset_rep {E : Subgroup G} {y : G} (hE4 : Nat.card ↥E = 4) (hyE : y ∈ E)
    (hy2 : orderOf y = 2) : ∃ a' ∈ E, ∀ e ∈ E, e ∈ zpowers y ∨ e * a' ∈ zpowers y := by
  have hle : zpowers y ≤ E := Subgroup.zpowers_le.2 hyE
  set H : Subgroup ↥E := (zpowers y).subgroupOf E with hH
  have hHcard : Nat.card ↥H = 2 := by
    rw [← hy2, ← Nat.card_zpowers]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv
  have hidx : H.index = 2 := by
    have := Subgroup.card_mul_index H
    rw [hE4, hHcard] at this
    omega
  obtain ⟨a', -, ha'⟩ := Subgroup.index_eq_two_iff_exists_notMem_and.1 hidx
  refine ⟨a', a'.2, fun e he => ?_⟩
  rcases ha' ⟨e, he⟩ with h | h
  · right; exact h
  · left; exact h

end S3Theta52

section SD2

variable {G : Type} [Group G] [Finite G]

theorem exists_B29H {x a : G} {K A D J : Subgroup G} (hc : Ctx21 G x K A a D J)
    (hSD : B1.QShape3SD (↥K ⧸ pPrimeCore 2 ↥K)) (hC : 1 < pRank 2 ↥(CxK x K)) :
    pRank 2 ↥(CxK x K) = 2 ∧ ∃ B : Subgroup G, IsExtSource2 x K A B ∧ pRank 2 ↥B = 4 ∧
      B ⊓ centralizerSection K (pPrimeCoreOf 2 K) ≤ CxK x K := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hx : orderOf x = 2 := hc.circ.1.1.1.1
  have hK : IsPCompIn 2 (centralizer ({x} : Set G)) K := hc.circ.1.1.1.2.2
  have hKC : K ≤ centralizer ({x} : Set G) := hK.1
  have hZ := B1.PilotS3.center_trivial_of_shape3 hK hSD.qShape3
  obtain ⟨E, hEK, hAE, hxE, hEel, hE4⟩ := S3Theta52.exists_E_of_src hc.src hZ
  have hAel : CFSG.IsElementaryAbelian 2 ↥A := hc.src.2.1
  obtain ⟨Q, hQC, hQp, hxQ, hEc, hEQ1, hconj⟩ := S3Theta52.exists_Q hK hZ hEK hAE hAel
  have hEA : E ≤ A := hAE ▸ le_sup_left
  obtain ⟨F, hFC, hFel, hFr⟩ := Th2.exists_elemAbelian_pRank (CxK x K)
  obtain ⟨F₀, hF₀Q, hF₀el, hF₀card⟩ := hconj F hFC hFel
  set r := pRank 2 ↥(CxK x K) with hr
  have hF₀r : Nat.card ↥F₀ = 2 ^ r := by
    rw [hF₀card, C3.Layer1.Back.card_eq_two_pow_pRank hFel, hFr]
  have hEF₀c : ∀ e ∈ E, ∀ f ∈ F₀, e * f = f * e := fun e he f hf => hEc e he f (hF₀Q hf)
  have hEF : E ⊓ F₀ = ⊥ := by
    rw [eq_bot_iff]
    intro e he
    exact Subgroup.mem_bot.2 (hEQ1 e (Subgroup.mem_inf.1 he).1 (hF₀Q (Subgroup.mem_inf.1 he).2))
  have hP := S3Theta52.isElementaryAbelian_sup hEel hF₀el hEF₀c
  have hPcard : Nat.card ↥(E ⊔ F₀) = 2 ^ (r + 2) := by
    rw [S3Theta52.card_sup_of_commute hEF₀c hEF, hE4, hF₀r, pow_add]
    ring
  have hPr : pRank 2 ↥(E ⊔ F₀) = r + 2 := by
    have := hP
    exact CFSG.pRank_eq_of_card_eq_pow one_lt_two hPcard
  have hle4 : pRank 2 ↥(E ⊔ F₀) ≤ 4 := Gen4.pRank_two_le (Gen4.subgroup _ hc.hyp.gen4)
  have hr2 : r = 2 := by omega
  refine ⟨hr2, ?_⟩
  have hx2 : x ^ 2 = 1 := by rw [← hx]; exact pow_orderOf_eq_one x
  have hxQ' : zpowers x ≤ Q := Subgroup.zpowers_le.2 hxQ
  have hB₀Q : F₀ ⊔ zpowers x ≤ Q := sup_le hF₀Q hxQ'
  have hxF : ∀ f ∈ F₀, ∀ k ∈ zpowers x, f * k = k * f := by
    intro f hf k hk
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 hk
    have hfx : f * x = x * f :=
      Subgroup.mem_centralizer_singleton_iff.1 (Subgroup.mem_inf.1 (hQC (hF₀Q hf))).1
    exact (Commute.zpow_right (show Commute f x from hfx) n).eq
  have hB₀el : CFSG.IsElementaryAbelian 2 ↥(F₀ ⊔ zpowers x) :=
    S3Theta52.isElementaryAbelian_sup hF₀el (CFSG.IsElementaryAbelian.zpowers_of_pow_eq_one hx2) hxF
  have hB₀C : F₀ ⊔ zpowers x ≤ CxK x K := hB₀Q.trans hQC
  have hB₀card : Nat.card ↥(F₀ ⊔ zpowers x) = 4 := by
    have h1 : Nat.card ↥F₀ ≤ Nat.card ↥(F₀ ⊔ zpowers x) := Subgroup.card_le_of_le le_sup_left
    have h2 : Nat.card ↥(F₀ ⊔ zpowers x) = 2 ^ pRank 2 ↥(F₀ ⊔ zpowers x) :=
      C3.Layer1.Back.card_eq_two_pow_pRank hB₀el
    have h3 : pRank 2 ↥(F₀ ⊔ zpowers x) ≤ r := C3.Layer1.Back.pRank_mono' hB₀C
    rw [hF₀r, hr2] at h1
    rw [hr2] at h3
    have h4 : 2 ^ pRank 2 ↥(F₀ ⊔ zpowers x) ≤ 2 ^ 2 := Nat.pow_le_pow_right (by norm_num) h3
    omega
  have hEB₀ : ∀ e ∈ E, ∀ b ∈ F₀ ⊔ zpowers x, e * b = b * e := fun e he b hb => hEc e he b (hB₀Q hb)
  have hEB₀1 : E ⊓ (F₀ ⊔ zpowers x) = ⊥ := by
    rw [eq_bot_iff]
    intro e he
    exact Subgroup.mem_bot.2 (hEQ1 e (Subgroup.mem_inf.1 he).1 (hB₀Q (Subgroup.mem_inf.1 he).2))
  have hBel := S3Theta52.isElementaryAbelian_sup hEel hB₀el hEB₀
  have hBcard : Nat.card ↥(E ⊔ (F₀ ⊔ zpowers x)) = 2 ^ 4 := by
    rw [S3Theta52.card_sup_of_commute hEB₀ hEB₀1, hE4, hB₀card]
    norm_num
  have hBr : pRank 2 ↥(E ⊔ (F₀ ⊔ zpowers x)) = 4 := by
    have := hBel
    exact CFSG.pRank_eq_of_card_eq_pow one_lt_two hBcard
  have hxB₀ : x ∈ F₀ ⊔ zpowers x := Subgroup.mem_sup_right (Subgroup.mem_zpowers x)
  have hAB : A ≤ E ⊔ (F₀ ⊔ zpowers x) := by
    rw [hAE]
    exact sup_le le_sup_left ((Subgroup.zpowers_le.2 hxB₀).trans le_sup_right)
  have hBC : E ⊔ (F₀ ⊔ zpowers x) ≤ centralizer ({x} : Set G) :=
    sup_le (fun e he => hKC (hEK he)) (fun b hb => (Subgroup.mem_inf.1 (hB₀C hb)).1)
  refine ⟨E ⊔ (F₀ ⊔ zpowers x),
    ⟨hAB, Subgroup.mem_sup_right hxB₀, hBC, hBel, by omega, by omega, ?_⟩,
    hBr, fun g hg => Subgroup.mem_inf.2 ⟨hBC (Subgroup.mem_inf.1 hg).1, (Subgroup.mem_inf.1 hg).2⟩⟩
  apply le_antisymm
  · refine sup_le (hEA.trans le_sup_left) (le_sup_of_le_right ?_)
    intro b hb
    exact Subgroup.mem_inf.2 ⟨Subgroup.mem_sup_right hb, (Subgroup.mem_inf.1 (hB₀C hb)).2⟩
  · exact sup_le hAB inf_le_left

