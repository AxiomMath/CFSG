variable {G : Type} [Group G] [Finite G]

theorem adm29E_of_pComp {x y : G} {K A B : Subgroup G} {Lb : Subgroup (CentralizerBar x)}
    (hK : IsPCompIn 2 (centralizer ({x} : Set G)) K) (hsrc : IsSource2 x K A)
    (h3 : QShape3 (↥K ⧸ pPrimeCore 2 ↥K)) (hyE : y ∈ A ⊓ K) (hadm : IsAdmPair x K A y Lb)
    (hext : IsExtSource2 x K A B) (hB4 : pRank 2 ↥B = 4) : IsBAdmPair x K B y Lb := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hsub := hadm.sub
  have hKC : K ≤ centralizer ({x} : Set G) := hK.1
  have hZ := B1.PilotS3.center_trivial_of_shape3 hK h3
  obtain ⟨E, hEK, hAE, hxE, hEel, hE4⟩ := S3Theta52.exists_E_of_src hsrc hZ
  obtain ⟨hAB, hxB, hBC, hBel, -, -, hBeq⟩ := hext
  have hyA : y ∈ A := (Subgroup.mem_inf.1 hyE).1
  have hyK : y ∈ K := (Subgroup.mem_inf.1 hyE).2
  have hy2 := hsub.y_ord
  have hyC := hsub.y_mem
  have hEA : E ≤ A := hAE ▸ le_sup_left
  have hxA : x ∈ A := hAE ▸ Subgroup.mem_sup_right (Subgroup.mem_zpowers x)
  have hAel : CFSG.IsElementaryAbelian 2 ↥A := hsrc.2.1
  have hx2 : x ^ 2 = 1 := CFSG.elemPow_eq_one_of_isElementaryAbelian (p := 2) (A := A) x hxA
  have hx : orderOf x = 2 := orderOf_eq_prime hx2 fun h => hxE (h ▸ one_mem E)
  have hxK : x ∉ K := B1.PilotS5.not_mem_of_center_trivial hx hKC hZ
  have hBc : ∀ u ∈ B, ∀ v ∈ B, u * v = v * u := fun u hu v hv =>
    congrArg Subtype.val (mul_comm' (⟨u, hu⟩ : ↥B) ⟨v, hv⟩)
  have hEc : ∀ a ∈ E, ∀ b ∈ E, a * b = b * a := fun a ha b hb =>
    hBc a (hAB (hEA ha)) b (hAB (hEA hb))
  have hExc : ∀ e ∈ E, ∀ z ∈ zpowers x, e * z = z * e := by
    intro e he z hz
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 hz
    exact (Commute.zpow_right (show Commute e x from
      Subgroup.mem_centralizer_singleton_iff.1 (hKC (hEK he))) n).eq
  have hyE' : y ∈ E := by
    obtain ⟨e, he, z, hz, hyez⟩ :=
      S3Theta52.exists_mul_of_mem_sup hExc (hAE ▸ hyA : y ∈ E ⊔ zpowers x)
    rcases B1.PilotS5.mem_zpowers_of_two hx hz with hz1 | hz1
    · rw [hz1, mul_one] at hyez
      exact hyez ▸ he
    · exfalso
      apply hxK
      have : x = e⁻¹ * y := by rw [hyez, hz1]; group
      rw [this]
      exact K.mul_mem (K.inv_mem (hEK he)) hyK
  obtain ⟨a', ha'E, hcos⟩ := S3Theta52.exists_coset_rep hE4 hyE' hy2
  obtain ⟨hbmem, hbne, hb2⟩ := B1.PilotS5.bar_facts hKC hyK hy2
  obtain ⟨eK⟩ := B1.PilotS5.hat_equiv_imgBar hK
  obtain ⟨F, _, _, P, _, ⟨e⟩, hP⟩ := B1.PilotS3.exists_equiv_grpS3_of_qShape3 h3
  have hY : B1.PilotS3.Split3Like F (S3.imgBar x K) :=
    B1.PilotS3.Split3Like.of_equiv (eK.symm.trans e) hP (B1.PilotS3.center_trivial_of_equiv eK hZ)
  obtain ⟨J, hJY, hJ⟩ := hY.split (bar x y) hbmem hb2
  have hlayer := hJ.pLayerOf_ne_bot
  obtain ⟨hLb, hmax⟩ := hsub.maximal hlayer
  have hcardJ : Nat.card ↥J ≤ Nat.card ↥Lb := hmax J hJ.isPCompIn (hY.subtermRel hbmem hJY hJ)
  have hLbeq : Lb = J := Subgroup.eq_of_le_of_card_ge (S3Theta52.le_of_isPCompIn hJ hLb) hcardJ
  have hLself : IsPCompIn 2 Lb Lb := by rw [hLbeq]; exact hJ.isPCompIn_self
  set QL : Subgroup G := ((centralizer (Lb : Set (CentralizerBar x))).comap (proj x)).map
    (centralizer ({x} : Set G)).subtype with hQL
  have hSg : ∀ g : G, g ∈ QL ↔ ∃ hg : g ∈ centralizer ({x} : Set G),
      proj x ⟨g, hg⟩ ∈ centralizer (Lb : Set (CentralizerBar x)) := by
    intro g
    constructor
    · rintro ⟨g', hg', rfl⟩
      exact ⟨g'.2, hg'⟩
    · rintro ⟨hg, hg'⟩
      exact ⟨⟨g, hg⟩, hg', rfl⟩
  have hxC : x ∈ centralizer ({x} : Set G) := Subgroup.mem_centralizer_singleton_iff.2 rfl
  have hxQ : x ∈ QL := (hSg x).2 ⟨hxC, Subgroup.mem_centralizer_iff.2 fun l _ =>
    (Subgroup.mem_center_iff.1 (L5U5.xbar_mem_center x)) l⟩
  have hyQ : y ∈ QL := (hSg y).2 ⟨hyC, by
    rw [← bar_of_mem hyC]
    exact Subgroup.mem_centralizer_iff.2 fun l hl =>
      Subgroup.mem_centralizer_singleton_iff.1 (hLb.1 hl).1⟩
  set X : Subgroup G := B ⊓ centralizerSection K (pPrimeCoreOf 2 K) with hX
  have hXQ : X ≤ QL := by
    intro c hc
    obtain ⟨hcB, hcS⟩ := Subgroup.mem_inf.1 hc
    have hcC : c ∈ centralizer ({x} : Set G) := hBC hcB
    refine (hSg c).2 ⟨hcC, Subgroup.mem_centralizer_iff.2 fun l hl => ?_⟩
    exact (Obs.piBar_commute_of_mem_centralizerSection hK (z := ⟨c, hcC⟩) hcS l (hLb.1 hl).2).symm
  set CB : Subgroup G := B ⊓ QL with hCB
  have hyB : y ∈ B := hAB hyA
  have hyCB : y ∈ CB := Subgroup.mem_inf.2 ⟨hyB, hyQ⟩
  have hxCB : x ∈ CB := Subgroup.mem_inf.2 ⟨hxB, hxQ⟩
  have hXCB : X ≤ CB := fun c hc => Subgroup.mem_inf.2 ⟨(Subgroup.mem_inf.1 hc).1, hXQ hc⟩
  have hcov : ∀ b ∈ B, b ∈ CB ∨ a' * b ∈ CB := by
    intro b hb
    have hXc : ∀ u ∈ A, ∀ v ∈ X, u * v = v * u := fun u hu v hv =>
      hBc u (hAB hu) v (Subgroup.mem_inf.1 hv).1
    have hb' : b ∈ A ⊔ X := by rw [hBeq] at hb; exact hb
    obtain ⟨α, hα, c, hc, rfl⟩ := S3Theta52.exists_mul_of_mem_sup hXc hb'
    obtain ⟨e, he, z, hz, rfl⟩ := S3Theta52.exists_mul_of_mem_sup hExc
      (by rw [hAE] at hα; exact hα : α ∈ E ⊔ zpowers x)
    have hzCB : z ∈ CB := (Subgroup.zpowers_le.2 hxCB) hz
    have hcCB := hXCB hc
    rcases hcos e he with h | h
    · left
      exact CB.mul_mem (CB.mul_mem ((Subgroup.zpowers_le.2 hyCB) h) hzCB) hcCB
    · right
      have h' : a' * (e * z * c) = e * a' * z * c := by
        calc a' * (e * z * c) = a' * e * z * c := by group
          _ = e * a' * z * c := by rw [hEc a' ha'E e he]
      rw [h']
      exact CB.mul_mem (CB.mul_mem ((Subgroup.zpowers_le.2 hyCB) h) hzCB) hcCB
  have hCBB : CB ≤ B := inf_le_left
  have hBcard : Nat.card ↥B = 2 ^ 4 := by
    rw [C3.Layer1.Back.card_eq_two_pow_pRank hBel, hB4]
  have hcard2 : Nat.card ↥B ≤ 2 * Nat.card ↥CB :=
    S3Theta52.card_le_two_mul_of_cover (hAB (hEA ha'E)) hCBB hcov
  have hCBel : CFSG.IsElementaryAbelian 2 ↥CB := Th2Sig6.isElementaryAbelian_of_le hBel hCBB
  have hr3 : 3 ≤ pRank 2 ↥CB := by
    have h1 := C3.Layer1.Back.card_eq_two_pow_pRank hCBel
    rw [hBcard] at hcard2
    have h8 : 2 ^ 3 ≤ Nat.card ↥CB := by norm_num at hcard2 ⊢; omega
    rw [h1] at h8
    exact (Nat.pow_le_pow_iff_right (by norm_num)).1 h8
  obtain ⟨F₁, hF₁CB, hF₁card⟩ := Th2Sig6.exists_sub_card hCBel hr3
  have hF₁B : F₁ ≤ B := hF₁CB.trans hCBB
  have hF₁el : CFSG.IsElementaryAbelian 2 ↥F₁ := Th2Sig6.isElementaryAbelian_of_le hBel hF₁B
  have hDB : (closure ({x, y} : Set G) : Subgroup G) ≤ B := by
    rw [Subgroup.closure_le]
    intro d hd
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hd
    rcases hd with hd | hd
    · rw [hd]; exact hxB
    · rw [hd]; exact hyB
  have hFle : F₁ ≤ centralizer ((closure ({x, y} : Set G) : Subgroup G) : Set G) := fun f hf =>
    Subgroup.mem_centralizer_iff.2 fun d hd => hBc d (hDB hd) f (hF₁B hf)
  have hF₁r : pRank 2 ↥F₁ = 3 := by
    have := hF₁el
    exact CFSG.pRank_eq_of_card_eq_pow one_lt_two hF₁card
  have hsetup : Setup1E x y F₁ :=
    ⟨hyC, hy2, hsub.y_ne, fun f hf => hBC (hF₁B hf), hF₁el,
      fun d hd => Subgroup.centralizer_le_normalizer (F₁ : Set G)
        (Subgroup.mem_centralizer_iff.2 fun f hf => hBc f (hF₁B hf) d (hDB hd)),
      by rw [inf_eq_left.2 hFle, hF₁r]; norm_num⟩
  have hLe : Lb ≤ centralizer ((S3.imgBar x F₁ : Subgroup (CentralizerBar x)) :
      Set (CentralizerBar x)) := by
    intro l hl
    refine Subgroup.mem_centralizer_iff.2 fun g hg => ?_
    obtain ⟨f, hfF, rfl⟩ := S3.mem_imgBar.1 hg
    obtain ⟨hf, hfc⟩ := (hSg f.1).1 (Subgroup.mem_inf.1 (hF₁CB hfF)).2
    exact (Subgroup.mem_centralizer_iff.1 hfc l hl).symm
  refine ⟨hsub, F₁, Lb, hF₁B, ?_, ⟨hsetup, Subgroup.le_normalizer hyK, hlayer, hLb, ?_⟩⟩
  · rw [hF₁card, hBcard]
    norm_num
  · rw [inf_eq_right.2 hLe]
    have hself : pLayerOf 2 Lb = Lb :=
      le_antisymm (sSup_le fun L' hL' => hL'.1) (le_sSup hLself)
    rw [hself]
    exact hLself

theorem adm29E_of_ctx {x a : G} {K A D J B : Subgroup G} (hc : Ctx21 G x K A a D J)
