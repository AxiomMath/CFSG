theorem kgAut_of_xform {T : Type} [Group T] [Finite T] (hs : IsSimpleGroup T)
    (hna : ∃ a b : T, a * b ≠ b * a)
    (hY : ∀ (X : Type) [Group X] [Finite X] (S : Subgroup X) [S.Normal], Nonempty (S ≃* T) →
      centralizer (S : Set X) = ⊥ → ∀ t : X, orderOf t = 2 →
        CFSG.oddCore ↥(centralizer ({t} : Set X)) = ⊥) : KGAut T :=
  kgAut_of_oddCoreIn_eq_bot fun B hB t htB ht =>
    oddCoreIn_eq_bot_of_xform (center_eq_bot_of_simple hs hna) hY B hB t htB ht

theorem eq_top_of_allInner {X : Type} [Group X] (S : Subgroup X) [S.Normal]
    (hA : ∀ φ : MulAut S, ∃ g : S, φ = MulAut.conj g) (hC : centralizer (S : Set X) = ⊥) :
    S = ⊤ := by
  rw [eq_top_iff]
  intro x _
  obtain ⟨s, hs'⟩ := hA (MulAut.conjNormal x)
  have hcomm : ∀ y : S, (x : X) * (y : X) * x⁻¹ = (s : X) * (y : X) * (s : X)⁻¹ := by
    intro y
    have := congrArg (fun φ : MulAut S => ((φ y : S) : X)) hs'
    simpa [MulAut.conjNormal_apply, MulAut.conj_apply] using this
  have hmem : (s : X)⁻¹ * x ∈ centralizer (S : Set X) := by
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    have := hcomm ⟨y, hy⟩
    calc y * ((s : X)⁻¹ * x) = (s : X)⁻¹ * ((s : X) * y * (s : X)⁻¹) * x := by group
      _ = (s : X)⁻¹ * (x * y * x⁻¹) * x := by rw [← this]
      _ = (s : X)⁻¹ * x * y := by group
  rw [hC, Subgroup.mem_bot] at hmem
  have : x = s := by
    have h1 : (s : X)⁻¹ * x = 1 := hmem
    exact (inv_mul_eq_one.mp h1).symm
  rw [this]
  exact s.2

theorem oddCoreCyclic_alternating {n : ℕ} (hn : 5 ≤ n) (hn6 : n ≠ 6) :
    OddCoreCyclic (alternatingGroup (Fin n)) := by
  intro B hB t htB ht
  let Φ : Perm (Fin n) ≃* MulAut (alternatingGroup (Fin n)) :=
    MulEquiv.ofBijective (MulAut.conjNormal (H := alternatingGroup (Fin n)))
      (CFSG.GroupTheory.AutAlternating.aut_alternatingGroup_bijective_conj n hn hn6)
  set H : Subgroup (Perm (Fin n)) := B.map Φ.symm.toMonoidHom with hH
  have hHB : H.map Φ.toMonoidHom = B := by
    rw [hH, Subgroup.map_map]
    convert Subgroup.map_id B
    ext x
    simp
  have hAH : alternatingGroup (Fin n) ≤ H := by
    intro a ha
    refine ⟨Φ a, hB ⟨⟨a, ha⟩, ?_⟩, by simp⟩
    ext x
    simp [Φ, MulAut.conjNormal_apply, MulAut.conj_apply]
  set t' : Perm (Fin n) := Φ.symm t with ht'
  have ht'2 : orderOf t' = 2 := by rw [ht', MulEquiv.orderOf_eq]; exact ht
  have hΦt : Φ t' = t := by rw [ht', MulEquiv.apply_symm_apply]
  have hmap := oddCoreIn_map Φ H t'
  rw [hHB, hΦt] at hmap
  rw [← hmap]
  set C : Subgroup (Perm (Fin n)) := H ⊓ centralizer ({t'} : Set (Perm (Fin n))) with hC
  have hcore := ComponentClassification.SymmetricLocal.involution_permutation_centralizer_odd_core
    hAH ht'2
  have hle : pPrimeCore 2 ↥C ≤ CFSG.oddCore ↥C :=
    CFSG.ABGLocalTools.le_oddCore_of_normal pPrimeCore_normal
      (Nat.coprime_two_left.1 pPrimeCore_coprime_card)
  have hcyc : IsCyclic ↥(CFSG.oddCore ↥C) := by
    by_cases h3 : Nat.card {ω // t' ω = ω} = 3
    · have hc3 := (hcore.2 h3).2.1
      have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
      exact isCyclic_of_prime_card hc3
    · rw [hcore.1 h3]
      exact inferInstance
  have hcyc' : IsCyclic ↥(pPrimeCore 2 ↥C) :=
    isCyclic_of_surjective (Subgroup.subgroupOfEquivOfLe hle).toMonoidHom
      (Subgroup.subgroupOfEquivOfLe hle).surjective
  have hcyc'' : IsCyclic ↥(oddCoreIn H t') :=
    isCyclic_of_surjective (Subgroup.equivMapOfInjective _ _ (Subgroup.subtype_injective C)).toMonoidHom
      (Subgroup.equivMapOfInjective _ _ (Subgroup.subtype_injective C)).surjective
  exact isCyclic_of_surjective (Subgroup.equivMapOfInjective _ _ Φ.injective).toMonoidHom
    (Subgroup.equivMapOfInjective _ _ Φ.injective).surjective

