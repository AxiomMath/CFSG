theorem xform_of_fitting {T : Type} [Group T] [Finite T] (hs : IsSimpleGroup T)
    (hna : ∃ a b : T, a * b ≠ b * a)
    (hY : ∀ (X : Type) [Group X] [Finite X] [IsSimpleGroup (CFSG.generalizedFitting X)],
      (∃ a b : CFSG.generalizedFitting X, a * b ≠ b * a) →
      Nonempty (CFSG.generalizedFitting X ≃* T) → ∀ t : X, orderOf t = 2 →
        CFSG.oddCore ↥(centralizer ({t} : Set X)) = ⊥) :
    ∀ (X : Type) [Group X] [Finite X] (S : Subgroup X) [S.Normal], Nonempty (S ≃* T) →
      centralizer (S : Set X) = ⊥ → ∀ t : X, orderOf t = 2 →
        CFSG.oddCore ↥(centralizer ({t} : Set X)) = ⊥ := by
  intro X _ _ S _ hSY hC t ht
  obtain ⟨ψ⟩ := hSY
  have hSs : IsSimpleGroup S := by
    have := hs
    exact MulEquiv.isSimpleGroup ψ
  have hSna : ∃ a b : S, a * b ≠ b * a := by
    obtain ⟨a, b, hab⟩ := hna
    exact ⟨ψ.symm a, ψ.symm b, fun h => hab (by simpa using congrArg ψ h)⟩
  have hF : CFSG.generalizedFitting X = S :=
    CFSG.Semidihedral.CoreFreeDihedral.generalizedFitting_eq_of_normal_simple_centralizer_eq_bot S
      hSna hC
  have : IsSimpleGroup (CFSG.generalizedFitting X) := by rw [hF]; exact hSs
  refine hY X ?_ ⟨(MulEquiv.subgroupCongr hF).trans ψ⟩ t ht
  obtain ⟨a, b, hab⟩ := hSna
  refine ⟨(MulEquiv.subgroupCongr hF).symm a, (MulEquiv.subgroupCongr hF).symm b, fun h => hab ?_⟩
  simpa using congrArg (MulEquiv.subgroupCongr hF) h

theorem kgAut_linear_two
    {T : Type} [Group T] [Finite T] (hs : IsSimpleGroup T)
    (hna : ∃ a b : T, a * b ≠ b * a) {f : ℕ} (hf : 3 ≤ f) (h : LieModel T .PSL 2 2 f) :
    KGAut T := by
  refine kgAut_of_xform hs hna (xform_of_fitting hs hna fun X _ _ _ hnonab hFY t ht => ?_)
  obtain ⟨e⟩ := hFY
  have hmodel : CFSG.Assembly.LowTwoRank.StatedClassicalModel (CFSG.generalizedFitting X) .PSL 2 2 f :=
    LieType.CurtisTits.statedClassicalModel_of_mulEquiv e.symm
      (LieType.Steinberg.statedClassicalModel_of_lieModel (by decide) h)
  obtain ⟨-, hiff, -⟩ :=
    ComponentClassification.UnbalancedCatalog.even_linear_two_almost_simple_unbalanced_outcome
      hnonab hmodel
  by_contra hne
  have := ((hiff t ht).mp hne).1
  omega

theorem kgAut_unitary_three_four {T : Type} [Group T] [Finite T] (hs : IsSimpleGroup T)
    (hna : ∃ a b : T, a * b ≠ b * a) (h : LieModel T .PSU 3 2 2) : KGAut T := by
  refine kgAut_of_xform hs hna (xform_of_fitting hs hna fun X _ _ _ hnonab hFY t ht => ?_)
  obtain ⟨e⟩ := hFY
  have hmodel : CFSG.Assembly.LowTwoRank.StatedClassicalModel (CFSG.generalizedFitting X) .PSU 3 2 2 :=
    LieType.CurtisTits.statedClassicalModel_of_mulEquiv e.symm
      (LieType.Steinberg.statedClassicalModel_of_lieModel (by decide) h)
  exact (ComponentClassification.UnbalancedCatalog.even_unitary_almost_simple_odd_core_vanishing
    hnonab hmodel).2 t ht

theorem kgAut_suzuki_eight
    {T : Type} [Group T] [Finite T] (hs : IsSimpleGroup T)
    (hna : ∃ a b : T, a * b ≠ b * a) (h : LieModel T .twistedB2 0 2 3) : KGAut T := by
  refine kgAut_of_xform hs hna (xform_of_fitting hs hna fun X _ _ hsF hnonab hFY t ht => ?_)
  obtain ⟨e⟩ := hFY
  have hSz : SuzukiModel T 2 3 := by
    rcases h with ⟨ht, -⟩ | ⟨-, ht, -⟩ | ⟨-, ht, -⟩ | ⟨-, -, hSz⟩
    · exact absurd ht (by decide)
    · exact absurd ht (by decide)
    · exact absurd ht (by decide)
    · exact hSz
  have hSzF : SuzukiModel (CFSG.generalizedFitting X) 2 3 := by
    obtain ⟨hp, a, ha, K, hK, hKf, hf, hcard, ⟨e'⟩⟩ := hSz
    exact ⟨hp, a, ha, K, hK, hKf, hf, hcard, ⟨e.trans e'⟩⟩
  exact (ComponentClassification.UnbalancedGS.catalog_suzuki_almost_simple_odd_core_vanishing
    hsF hnonab hSzF t ht).2.2

theorem kgAut_ghList
    {T : Type} [Group T] [Finite T] (hs : IsSimpleGroup T)
    (hna : ∃ a b : T, a * b ≠ b * a) (hGH : GHList T) (hL34 : ¬ LieModel T .PSL 3 2 2) :
    KGAut T := by
  rcases ghList_cases hGH with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h
  · exact kgAut_alt h
  · rcases h with h | h | h | h | h | h | h
    · exact kgAut_mathieu hs hna (Or.inl h)
    · exact kgAut_mathieu hs hna (Or.inr (Or.inl h))
    · exact kgAut_mathieu hs hna (Or.inr (Or.inr (Or.inl h)))
    · exact kgAut_mathieu hs hna (Or.inr (Or.inr (Or.inr h)))
    · exact kgAut_j1 hs hna h
    · exact kgAut_j2 hs hna h
    · exact kgAut_j3 hs hna h
  · rcases h with h | h
    · exact kgAut_mcl hs hna h
    · exact kgAut_ly hs hna h
  · rcases h with h | h | h | h | h
    · exact kgAut_linear_two hs hna (f := 3) (by norm_num) h
    · exact kgAut_linear_two hs hna (f := 4) (by norm_num) h
    · exact absurd h hL34
    · exact kgAut_unitary_three_four hs hna h
    · exact kgAut_suzuki_eight hs hna h
  · exact kgAut_fl2 h
  · obtain ⟨p, f, hp, hf, hp2, hL⟩ := h
    exact kgAut_psl (by norm_num) hp2 hL hp hf
  · obtain ⟨p, f, -, -, hp2, hL⟩ := h
    exact kgAut_psu (by norm_num) hp2 hL
  · obtain ⟨p, f, -, -, hp2, hL⟩ := h
    exact kgAut_psp le_rfl hp2 hL
  · exact kgAut_g2 h
  · exact kgAut_d4 h
  · obtain ⟨p, f, hp, hf, hp2, -, hL⟩ := h
    exact kgAut_psl (by norm_num) hp2 hL hp hf
  · obtain ⟨p, f, -, -, hp2, -, hL⟩ := h
    exact kgAut_psu (by norm_num) hp2 hL
  · obtain ⟨p, f, hp, hf, hq, hL⟩ := h
    have hp2 : p ≠ 2 := by
      rintro rfl
      have : 2 ∣ 2 ^ f := dvd_pow_self 2 (by omega)
      omega
    exact kgAut_psl (by norm_num) hp2 hL hp hf
  · obtain ⟨p, f, -, hf, hq, hL⟩ := h
    have hp2 : p ≠ 2 := by
      rintro rfl
      have : 2 ∣ 2 ^ f := dvd_pow_self 2 (by omega)
      omega
    exact kgAut_psu (by norm_num) hp2 hL
  · exact kgAut_ree h

end SolvKG

