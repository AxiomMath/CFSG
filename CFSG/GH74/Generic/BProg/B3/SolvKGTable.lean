theorem kgAut_mathieu
    {T : Type} [Group T] [Finite T] (hs : IsSimpleGroup T)
    (hna : ∃ a b : T, a * b ≠ b * a)
    (h : Nonempty (T ≃* NativeSporadic.M11) ∨ Nonempty (T ≃* NativeSporadic.M12) ∨
      Nonempty (T ≃* NativeSporadic.M22) ∨ Nonempty (T ≃* NativeSporadic.M23)) : KGAut T := by
  refine kgAut_of_xform hs hna fun X _ _ S _ hSY hC t ht => ?_
  obtain ⟨ψ⟩ := hSY
  refine Sporadic.Schreier.ctuc_mathieu_almost_simple_involution_centralizer_odd_core_trivial
    S ?_ hC t ht
  rcases h with ⟨⟨e⟩⟩ | ⟨⟨e⟩⟩ | ⟨⟨e⟩⟩ | ⟨⟨e⟩⟩
  · exact Or.inl ⟨ψ.trans e⟩
  · exact Or.inr (Or.inl ⟨ψ.trans e⟩)
  · exact Or.inr (Or.inr (Or.inl ⟨ψ.trans e⟩))
  · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨ψ.trans e⟩)))

theorem kgAut_j1
    {T : Type} [Group T] [Finite T] (hs : IsSimpleGroup T)
    (hna : ∃ a b : T, a * b ≠ b * a) (h : Nonempty (T ≃* NativeSporadic.J1)) : KGAut T := by
  refine kgAut_of_xform hs hna fun X _ _ S _ hSY hC t ht => ?_
  obtain ⟨ψ⟩ := hSY
  obtain ⟨e⟩ := h
  have hAJ : ∀ φ : MulAut NativeSporadic.J1, ∃ g, φ = MulAut.conj g :=
    fun φ => Sporadic.Schreier.at_j1_schreier.2.1 φ
  have hA : ∀ φ : MulAut S, ∃ g : S, φ = MulAut.conj g := by
    intro φ
    set ε : S ≃* NativeSporadic.J1 := ψ.trans e
    obtain ⟨g, hg⟩ := hAJ (MulAut.congr ε φ)
    refine ⟨ε.symm g, ?_⟩
    have h1 : φ = (MulAut.congr ε).symm (MulAut.conj g) := by
      rw [← hg, MulEquiv.symm_apply_apply]
    rw [h1]
    ext x
    simp [MulAut.conj_apply]
  have hSX := eq_top_of_allInner S hA hC
  let eX : X ≃* S := (Subgroup.topEquiv (G := X)).symm.trans (MulEquiv.subgroupCongr hSX.symm)
  exact (Sporadic.Schreier.ctugs_j1_involution_centralizer_odd_core_free
    ⟨(eX.trans ψ).trans e⟩ t ht).2.2.2

