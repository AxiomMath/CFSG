variable {G : Type} [Group G] [Finite G] {x : G} {K : Subgroup (CentralizerBar x)}

omit [Finite G] in
theorem le_pRank_of_card' {p : ℕ} (hp : 1 < p) {H : Type*} [Group H] [Finite H] (E : Subgroup H)
    (hE : IsElementaryAbelian p E) {k : ℕ} (hk : Nat.card E = p ^ k) : k ≤ CFSG.pRank p H := by
  refine le_csSup ⟨Nat.card H, ?_⟩ ⟨E, hE, hk⟩
  rintro r ⟨B, -, hB⟩
  calc r ≤ p ^ r := (Nat.lt_pow_self hp).le
    _ = Nat.card B := hB.symm
    _ ≤ Nat.card H := Subgroup.card_le_card_group B

omit [Finite G] in
theorem inG2Depth_d2_of_ne_zero {K : Type} [Group K] (h : d2 K ≠ 0) : InG2Depth (d2 K) K := by
  have hne : {i : ℕ | InG2Depth i K}.Nonempty := by
    by_contra hemp
    rw [Set.not_nonempty_iff_eq_empty] at hemp
    exact h (by unfold d2; rw [hemp]; exact Nat.sInf_empty)
  exact Nat.sInf_mem hne

theorem g2pair_of_iloG2 {y : G} {M' : Subgroup G} (h : IsILoG2 y M') :
    ∃ L : Subgroup (CentralizerBar y), G2Pair y L ∧
      Nonempty ((↥M' ⧸ pPrimeCore 2 ↥M') ≃* ↥L) := by
  have hPC : IsPCompIn 2 (centralizer ({y} : Set G)) M' := h.1.2.2
  obtain ⟨e⟩ := C3.Layer1.PumpCalc.kBar_equiv_bar hPC
  exact ⟨C3.Layer1.PumpCalc.bar y M', ⟨h.1.1, C3.Layer1.PumpCalc.isComponent_bar hPC,
    inG2_of_mulEquiv e h.2⟩, ⟨e⟩⟩

