section Pre

variable {G : Type} [Group G] [Finite G]

omit [Finite G] in
theorem mem_normalizer_Pre {x : G} {K : Subgroup (CentralizerBar x)} (hKn : K.Normal) {g : G}
    (hg : g ∈ centralizer ({x} : Set G)) : g ∈ normalizer (Pre x K : Set G) := by
  rw [mem_normalizer_iff]
  intro h
  constructor
  · rintro ⟨hh, hhK⟩
    refine ⟨mul_mem (mul_mem hg hh) (inv_mem hg), ?_⟩
    rw [piC_mul x (mul_mem hg hh) (inv_mem hg), piC_mul x hg hh, piC_inv x hg]
    exact hKn.conj_mem _ hhK _
  · rintro ⟨hh, hhK⟩
    have hhC : h ∈ centralizer ({x} : Set G) := by
      have := mul_mem (mul_mem (inv_mem hg) hh) hg
      simpa [mul_assoc] using this
    refine ⟨hhC, ?_⟩
    have e : piC x h = (piC x g)⁻¹ * piC x (g * h * g⁻¹) * piC x g := by
      rw [piC_mul x (mul_mem hg hhC) (inv_mem hg), piC_mul x hg hhC, piC_inv x hg]
      group
    rw [e]
    have := hKn.conj_mem _ hhK ((piC x g)⁻¹)
    simpa using this

open CFSG.RankThreeCoreUniqueness.Helpers in
theorem exists_perfect_lift {x : G} {K : Subgroup (CentralizerBar x)} (hKn : K.Normal)
    (hKp : Group.IsPerfect ↥K) :
    ∃ K₂ : Subgroup G, K₂ ≤ Pre x K ∧ ⁅K₂, K₂⁆ = K₂ ∧
      (∀ g ∈ centralizer ({x} : Set G), ∀ k ∈ K₂, g * k * g⁻¹ ∈ K₂) ∧
      (∀ z ∈ K, ∃ k ∈ K₂, piC x k = z) := by
  refine ⟨perfectResidualOf (Pre x K), Subgroup.map_subtype_le _,
    Subgroup.isPerfect_iff.1 (finite_perfectResidualOf_isPerfect _), ?_, ?_⟩
  · intro g hg k hk
    have hgn := perfectResidualOf_normalizer_contains (Pre x K) (mem_normalizer_Pre hKn hg)
    exact (mem_normalizer_iff.1 hgn k).1 hk
  · let πH : ↥(Pre x K) →* ↥K :=
      { toFun := fun h => ⟨piC x h, h.2.2⟩
        map_one' := Subtype.ext (piC_one x)
        map_mul' := fun a b => Subtype.ext (piC_mul x a.2.1 b.2.1) }
    have hs : Function.Surjective πH := by
      intro z
      obtain ⟨c, hc⟩ := QuotientGroup.mk'_surjective (pPrimeCore 2 ↥(centralizer ({x} : Set G))) z.1
      refine ⟨⟨(c : G), c.2, ?_⟩, Subtype.ext ?_⟩
      · rw [piC_of_mem x c.2]
        have : proj x c = z.1 := hc
        rw [this]
        exact z.2
      · show piC x (c : G) = z.1
        rw [piC_of_mem x c.2]
        exact hc
    have := hKp
    have hall := finite_perfectResidual_surjects_to_perfect_image πH hs
    intro z hz
    have hz' : (⟨z, hz⟩ : ↥K) ∈
        Subgroup.map πH (CFSG.RankThreeCoreUniqueness.Helpers.perfectResidual ↥(Pre x K)) := by
      rw [hall]
      trivial
    obtain ⟨w, hw, hwz⟩ := hz'
    exact ⟨w, ⟨w, hw, rfl⟩, congrArg Subtype.val hwz⟩

end Pre

@[expose] def NoCentralCover (X : Type) [Group X] : Prop :=
  ∀ (E : Type) [Group E] [Finite E], Group.IsPerfect E → ∀ q : E →* X, Function.Surjective q →
    q.ker ≤ center E → q.ker = ⊥

theorem NoCentralCover.of_mulEquiv {X Y : Type} [Group X] [Group Y] (e : X ≃* Y)
    (h : NoCentralCover X) : NoCentralCover Y := by
  intro E _ _ hE q hs hk
  have hker : (e.symm.toMonoidHom.comp q).ker = q.ker := by
    ext z
    simp only [MonoidHom.mem_ker, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      map_eq_one_iff e.symm e.symm.injective]
  have := h E hE (e.symm.toMonoidHom.comp q) (e.symm.surjective.comp hs) (hker ▸ hk)
  rwa [hker] at this

theorem noCentralCover_walterJ1 : NoCentralCover ↥CFSG.Open.walterJ1 :=
  fun _ _ _ hE q hs hk => CFSG.Walter.J1Props.J3_multiplier q hs hk hE.commutator_eq_top

open CFSG.Blueprint.Multiplier CFSG.RankThree.PerfectCover CFSG.ComponentClassification.TBLit in
theorem card_hopfMultiplier_ree
    {X : Type} [Group X] (hGA : GriessMultipliersAllModels) {f : ℕ}
    (hm : CFSG.Blueprint.LieModel X .twistedG2 0 3 f) : Nat.card (hopfMultiplier X) = 1 := by
  have hm' : CFSG.Models.LieModel X .twistedG2 0 3 f :=
    CFSG.GH74.Generic.models_of_blueprint_exceptional CFSG.TauCetiBridge.typewiseBridges
      Nat.prime_three (by norm_num) (Or.inr (Or.inr rfl)) hm
  rw [CFSG.GH74.Generic.card_hopfMultiplier_of_griess hGA hm']
  have hexc : exceptionalOrders .twistedG2 0 3 f = (1, 1) := by
    unfold exceptionalOrders
    split <;> simp_all
  rw [hexc]
  unfold genericOrders
  simp

open CFSG.ComponentClassification.TBLit in
theorem noCentralCover_of_isJ1OrRee
    (hGA : GriessMultipliersAllModels) {K : Type} [Group K]
    (h : IsJ1OrRee K) : NoCentralCover K := by
  rcases h with h1 | ⟨f, hf⟩
  · obtain ⟨e⟩ := h1
    exact NoCentralCover.of_mulEquiv (CFSG.Walter.walterJ1EquivNative.trans e.symm)
      noCentralCover_walterJ1
  · intro E _ _ hE q hs hk
    have h1 := CFSG.GH74.Generic.card_ker_dvd_hopfMultiplier hE q hs hk
    rw [card_hopfMultiplier_ree hGA hf] at h1
    exact (Subgroup.card_eq_one).1 (Nat.dvd_one.1 h1)

section Inj

variable {G : Type} [Group G]

theorem piC_injOn_of_noCentralCover {x : G} {K : Subgroup (CentralizerBar x)}
    (hK : NoCentralCover ↥K) [Finite G] {K₂ : Subgroup G} (hle : K₂ ≤ Pre x K)
    (hperf : ⁅K₂, K₂⁆ = K₂) (hsurj : ∀ z ∈ K, ∃ k ∈ K₂, piC x k = z)
    (hcent : ∀ z ∈ K₂, piC x z = 1 → ∀ g ∈ K₂, z * g = g * z) :
    ∀ a ∈ K₂, ∀ b ∈ K₂, piC x a = piC x b → a = b := by
  let φ : ↥K₂ →* ↥K :=
    { toFun := fun k => ⟨piC x k, (hle k.2).2⟩
      map_one' := Subtype.ext (piC_one x)
      map_mul' := fun a b => Subtype.ext (piC_mul x (hle a.2).1 (hle b.2).1) }
  have hs : Function.Surjective φ := by
    intro z
    obtain ⟨k, hk, hkz⟩ := hsurj z z.2
    exact ⟨⟨k, hk⟩, Subtype.ext hkz⟩
  have hker : φ.ker ≤ center ↥K₂ := by
    intro k hk
    rw [Subgroup.mem_center_iff]
    intro g
    have h1 : piC x (k : G) = 1 := congrArg Subtype.val (MonoidHom.mem_ker.1 hk)
    exact Subtype.ext (hcent k k.2 h1 g g.2).symm
  have hperf' : Group.IsPerfect ↥K₂ := Subgroup.isPerfect_iff.2 hperf
  have hbot := hK ↥K₂ hperf' φ hs hker
  have hinj : Function.Injective φ := (MonoidHom.ker_eq_bot_iff φ).1 hbot
  intro a ha b hb hab
  have h2 : φ ⟨a, ha⟩ = φ ⟨b, hb⟩ := Subtype.ext hab
  exact congrArg Subtype.val (hinj h2)

end Inj

@[expose] def B_S45_liftCentral : Prop :=
  ∀ (G : Type) [Group G] [Finite G], IsSimpleGroup G → (∃ a b : G, a * b ≠ b * a) → Gen4 G → KGH G →
    ∀ x : G, orderOf x = 2 → ∀ K : Subgroup (CentralizerBar x), IsComponent K → IsJ1OrRee ↥K →
      xbar x ∉ K → ∀ T : Subgroup G, S45Conf x K T →
      ∀ P : Subgroup G, P ≤ Pre x K → ⁅P, P⁆ = P → (∀ z ∈ K, ∃ p ∈ P, piC x p = z) →
        ∀ z ∈ P, piC x z = 1 → ∀ g ∈ P, z * g = g * z

open CFSG.ComponentClassification.TBLit in
theorem b_S45_lift_of_central
    (hc : B_S45_liftCentral) (hGA : GriessMultipliersAllModels) :
    B_S45_lift := by
  intro G _ _ hs hn hgen hKGH x hx K hKc hj hnot T hT
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hd : KData (CentralizerBar x) K (xbar x) :=
    { gen4 := gen4_centralizerBar hgen x
      oddcore := pPrimeCore_quotient_pPrimeCore_eq_bot _ 2
      central := fun g => xbar_comm x g
      sq := xbar_mul_self hx
      ne := xbar_ne_one hx
      comp := hKc
      notin := hnot
      facts := b_S45_KFacts ↥K hj }
  obtain ⟨K₂, hle, hperf, hnorm, hsurj⟩ := exists_perfect_lift hd.normal hKc.1.1
  have hcent := hc G hs hn hgen hKGH x hx K hKc hj hnot T hT K₂ hle hperf hsurj
  have hinj := piC_injOn_of_noCentralCover (noCentralCover_of_isJ1OrRee hGA hj) hle hperf hsurj hcent
  exact ⟨K₂, fun k hk => (hle hk).1, hnorm, fun k hk => (hle hk).2, hsurj, hinj⟩

open CFSG.ComponentClassification.TBLit in
theorem b_S45_pumpStruct_of_central
    (hc : B_S45_liftCentral) (hGA : GriessMultipliersAllModels)
    (hs : B_S45_semisimple) : B_S45_pumpStruct :=
  b_S45_pumpStruct_of_leaves (b_S45_lift_of_central hc hGA) hs

