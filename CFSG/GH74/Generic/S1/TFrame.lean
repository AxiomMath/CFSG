@[expose] def S1FrameExists : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (x : G) (K : Subgroup (CentralizerBar x)), S1Setup G x K →
    S1Front G x K →
      ∃ (u : Fin 4 → G) (hu : ∀ i, u i ∈ centralizer ({x} : Set G)), S1Frame x K u hu

theorem s1FrameExists_of_explicit (hExo : S1ExoticExcludedExplicit) : S1FrameExists := by
  intro G _ _ x K hset hfront
  obtain ⟨-, v, hv, hconj, hvx, hv2, hvbK, α, hα, hnotA, hRG⟩ :=
    s1_front (s1OuterClassification_of_native linClassify uniClassify) hset.simple hset.nonab hset.gen4
      hset.inv hset.comp hset.shape
  have : K.Normal := normal_of_layer_eq hfront.layer_eq
  rcases hRG with hR | hGr
  · exact s1_frame hset.inv hset.shape.2 hv hconj hv2 hvbK hα hR
  · exact ((s1ExoticExcluded_of_explicit graphLinRefine graphUniRefine hExo) G x K hset hfront v hv
      hconj hvx hv2 hvbK α hα hGr hnotA).elim

variable {G : Type} [Group G] [Finite G]

theorem s1_symFrame_dual (hExact : S1LiftExactProp) {x : G} {K : Subgroup (CentralizerBar x)}
    [K.Normal] (hset : S1Setup G x K) (hfront : S1Front G x K) {u : Fin 4 → G}
    {hu : ∀ i, u i ∈ centralizer ({x} : Set G)} (hf : S1Frame x K u hu) : S1SymFrame x u := by
  have hmodel := hf.2.2.2.2
  rcases hmodel with ⟨F, _, _, e, hF, hact⟩ | ⟨q, F, _, _, e, hF, hq, hact⟩
  · exact Or.inl ⟨F, inferInstance, inferInstance, hF,
      s1_symFrame_lin_dual hExact hset hfront hf hF e hact⟩
  · exact Or.inr ⟨q, F, inferInstance, inferInstance, hF, hq,
      s1_symFrame_uni_dual hExact hset hfront hf hF hq e hact⟩

theorem s1_shapeCase_of_frame_leaf (hExact : S1LiftExactProp) (hFrame : S1FrameExists)
    (hNbhd : S1NbhdSym) (hE : S1LevelE) : S_shapeCaseMaxNT @ShapeS1 := by
  intro G _ _ hs hn hr hgen hK hnab hL x hx K hKc _ hP
  obtain ⟨hthin, hmax, hsh⟩ := hP
  have hset : S1Setup G x K := ⟨hs, hn, hr, hgen, hK, hnab, hL, hx, hKc, hsh, hmax, hthin⟩
  obtain ⟨hfront, -⟩ := s1_front (s1OuterClassification_of_native linClassify uniClassify) hs hn hgen hx hKc hsh
  obtain ⟨u, hu, hf⟩ := hFrame G x K hset hfront
  have : K.Normal := normal_of_layer_eq hfront.layer_eq
  obtain ⟨J, hJ⟩ := hNbhd G x K hset hfront u hu hf (s1_symFrame_dual hExact hset hfront hf)
  exact catalog_of_isS1A4 hJ (hE G x K hset J hJ) hs

theorem s1_shapeCase_final_griess_q3_frame
    (hFrame : S1FrameExists)
    (hGriess : CFSG.ComponentClassification.TBLit.GriessMultipliersAllModels)
    (hCentral : S1LiftCentralProp) (hY : S1NormalizerYClause) (hY3 : S1NormalizerYClause3)
    (hBad : S1NbhdQ3Bad) : S_shapeCaseMaxNT @ShapeS1 :=
  s1_shapeCase_of_frame_leaf (s1LiftExact_of_central_schur hCentral (s1SchurOdd_of_griess hGriess)) hFrame
    (s1NbhdSym_of_yclause_lin (s1LiftExact_of_central_schur hCentral (s1SchurOdd_of_griess hGriess)) hY
      (s1NbhdQ3Lin_of_cases hBad (s1NbhdQ3Good_of_yclause3 hY3)))
    s1LevelE

theorem s1_shapeCase_final_comp2
    (hFrame : S1FrameExists)
    (hGriess : CFSG.ComponentClassification.TBLit.GriessMultipliersAllModels)
    (hCentral : S1LiftCentralProp) (hC : S1CompNormal) (hC3 : S1CompNormal3)
    (hBad : S1NbhdQ3Bad) : S_shapeCaseMaxNT @ShapeS1 :=
  s1_shapeCase_final_griess_q3_frame hFrame hGriess hCentral
    (s1NormalizerYClause_of_comp (s1LiftExact_of_central_schur hCentral (s1SchurOdd_of_griess hGriess)) hC)
    (s1NormalizerYClause3_of_comp3 hC3) hBad

