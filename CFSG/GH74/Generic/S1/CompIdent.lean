theorem card_of_model {ε : ℤ} {p f : ℕ} {X : Type} [Group X] (hp : p.Prime) (hf : 1 ≤ f)
    (h : (ε = 1 ∧ StatedClassicalModel X .PSL 3 p f) ∨ (ε = -1 ∧ StatedClassicalModel X .PSU 3 p f)) :
    Nat.card X = l3Card ε (p ^ f) := by
  rcases h with ⟨rfl, -, K, _, _, hK, ⟨e⟩⟩ | ⟨rfl, -, K, _, _, hK, ⟨e⟩⟩
  · rw [Nat.card_congr e.toEquiv, card_stated_psl3, hK]
    simp [l3Card]
  · rw [Nat.card_congr e.toEquiv, card_stated_psu3 hp hf hK]
    simp [l3Card]

theorem isLnEps_of_model {ε : ℤ} {p f : ℕ} {X : Type} [Group X]
    (h : (ε = 1 ∧ StatedClassicalModel X .PSL 3 p f) ∨ (ε = -1 ∧ StatedClassicalModel X .PSU 3 p f)) :
    CFSG.GH74.GLS.IVK.IsLnEps 3 X ε (p ^ f) := by
  rcases h with ⟨h1, -, K, _, _, hK, e⟩ | ⟨h1, -, K, _, _, hK, e⟩
  · exact Or.inl ⟨h1, K, inferInstance, inferInstance, hK, e⟩
  · exact Or.inr ⟨h1, K, inferInstance, inferInstance, hK, e⟩

theorem card_center_dvd_of_surjective {Q E : Type} [Group Q] [Group E] [Finite Q]
    (hQ : IsQuasisimple Q) (hE : IsQuasisimple E) (α : Q →* E) (hα : Function.Surjective α) :
    Nat.card (center E) ∣ Nat.card (center Q) := by
  have hker : α.ker ≤ center Q := by
    rcases CFSG.LocalCores.quasisimple_normal_subgroups hQ (inferInstance : α.ker.Normal) with h | h
    · exfalso
      have htriv : ∀ e : E, e = 1 := by
        intro e
        obtain ⟨g, rfl⟩ := hα e
        have : g ∈ α.ker := by rw [h]; trivial
        exact this
      obtain ⟨a, b, hab⟩ := hE.2.2
      obtain ⟨a', rfl⟩ := QuotientGroup.mk_surjective a
      obtain ⟨b', rfl⟩ := QuotientGroup.mk_surjective b
      apply hab
      rw [htriv a', htriv b']
    · exact h
  have hZ := CFSG.LieType.CurtisTits.center_eq_map_center_of_isQuasisimple hQ hα hker
  let g : ↥(center Q) →* ↥(center E) := (α.comp (center Q).subtype).codRestrict (center E) (by
    intro z
    rw [hZ]
    exact ⟨z, z.2, rfl⟩)
  have hg : Function.Surjective g := by
    intro z
    have hz : (z : E) ∈ (center Q).map α := by rw [← hZ]; exact z.2
    obtain ⟨y, hy, hyz⟩ := hz
    exact ⟨⟨y, hy⟩, Subtype.ext hyz⟩
  exact Subgroup.card_dvd_of_surjective hg

theorem odd_center_of_l3Cover (hGA : CFSG.ComponentClassification.TBLit.GriessMultipliersAllModels)
    {M S : Type} [Group M] [Finite M] [Group S] [Finite S] (hM : IsQuasisimple M) {δ : ℤ} {p f : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) (hδ : δ = 1 ∨ δ = -1) (h5 : 5 ≤ p ^ f)
    (hS : CFSG.GH74.GLS.IVK.IsLnEps 3 S δ (p ^ f)) (mk : M →* S) (hmk : Function.Surjective mk)
    (hker : mk.ker ≤ center M) : Odd (Nat.card (center M)) := by
  have hf : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with rfl | h
    · simp at h5
    · exact h
  obtain ⟨hlin, huni⟩ := CFSG.GH74.GLS.LU.Local.l3Cover hGA S δ p f hp hp2 hδ h5 hS M hM.1 mk hmk hker
  have hodd : Odd (p ^ f) := (hp.odd_of_ne_two hp2).pow
  rcases hδ with rfl | rfl
  · obtain ⟨F, _, _, hF, α, hα⟩ := hlin rfl
    have hQ : IsQuasisimple SL(3, F) :=
      CFSG.ComponentClassification.CatalogueBGeneralLinear.specialLinear_quasisimple 3 F
        (by norm_num) (Or.inl (by norm_num)) (Or.inl (by norm_num))
    exact Odd.of_dvd_nat odd_card_center_lin3 (card_center_dvd_of_surjective hQ hM α hα)
  · obtain ⟨F, _, _, hF, α, hα⟩ := huni rfl
    have : Fact p.Prime := ⟨hp⟩
    have hdq : ((3 : ℕ), p ^ f) ≠ (3, 2) := fun h' => by
      have : p ^ f = 2 := (Prod.mk.inj h').2
      omega
    have hQ : IsQuasisimple (StatedSU 3 (p ^ f) F) :=
      (CFSG.LieType.Universal.Unitary.isQuasisimple_statedSU_of_card hF (by norm_num) hdq).1
    exact Odd.of_dvd_nat (odd_card_center_uni3 hF hodd) (card_center_dvd_of_surjective hQ hM α hα)

theorem card_quot_center_dvd_range {A S : Type} [Group A] [Group S] [Finite A] (g : A →* S)
    (hker : g.ker ≤ center A) : Nat.card (A ⧸ center A) ∣ Nat.card g.range := by
  let q : A ⧸ g.ker →* A ⧸ center A := QuotientGroup.map g.ker (center A) (MonoidHom.id _) hker
  have hq : Function.Surjective q := by
    intro x
    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective x
    exact ⟨a, rfl⟩
  rw [← Nat.card_congr (QuotientGroup.quotientKerEquivRange g).toEquiv]
  exact Subgroup.card_dvd_of_surjective hq

theorem commutator_mul_central {M : Type} [Group M] (a b z₁ z₂ : M) (h₁ : z₁ ∈ center M)
    (h₂ : z₂ ∈ center M) : ⁅a * z₁, b * z₂⁆ = ⁅a, b⁆ := by
  have e1 : ∀ x : M, z₁ * x = x * z₁ := fun x => (Subgroup.mem_center_iff.1 h₁ x).symm
  have e2 : ∀ x : M, z₂ * x = x * z₂ := fun x => (Subgroup.mem_center_iff.1 h₂ x).symm
  rw [commutatorElement_def, commutatorElement_def]
  calc a * z₁ * (b * z₂) * (a * z₁)⁻¹ * (b * z₂)⁻¹
      = a * (z₁ * b) * z₂ * z₁⁻¹ * a⁻¹ * z₂⁻¹ * b⁻¹ := by group
    _ = a * (b * z₁) * z₂ * z₁⁻¹ * a⁻¹ * z₂⁻¹ * b⁻¹ := by rw [e1 b]
    _ = a * b * (z₁ * z₂ * z₁⁻¹) * a⁻¹ * z₂⁻¹ * b⁻¹ := by group
    _ = a * b * (z₂ * z₁ * z₁⁻¹) * a⁻¹ * z₂⁻¹ * b⁻¹ := by rw [e1 z₂]
    _ = a * b * (z₂ * a⁻¹) * z₂⁻¹ * b⁻¹ := by group
    _ = a * b * (a⁻¹ * z₂) * z₂⁻¹ * b⁻¹ := by rw [e2 a⁻¹]
    _ = a * b * a⁻¹ * b⁻¹ := by group

theorem exists_q8_of_hasSL2Model {X : Type} [Group X] {V : Subgroup X} {q : ℕ} (hq : Odd q)
    (hV : CFSG.GH74.GLS.HasSL2Model ↥V (fun q' => q' = q)) :
    ∃ ψ : Q8 →* X, Function.Injective ψ ∧ ∀ g, ψ g ∈ V := by
  obtain ⟨F, _, _, hFq, ⟨e⟩⟩ := hV
  have hodd : Odd (Nat.card F) := hFq ▸ hq
  have h2 : (2 : F) ≠ 0 := CFSG.ABGLocalTools.two_ne_zero_of_odd_card hodd
  have hF2 : ringChar F ≠ 2 := by
    intro h
    apply h2
    have : CharP F 2 := h ▸ ringChar.charP F
    exact CharTwo.two_eq_zero
  obtain ⟨a, b, hab⟩ := (CFSG.LocalAnalysis.ComponentInitial.QuaternionMatrices.odd_field_two_dimensional_quaternion_matrices hF2).1
  let qh : Q8 →* SL(2, F) := CFSG.LocalAnalysis.ComponentInitial.QuaternionMatrices.quatHom hab
  let eV : SL(2, F) ≃* ↥V := (specialLinearGroupEquivStatedSL 2 F).trans e.symm
  refine ⟨V.subtype.comp (eV.toMonoidHom.comp qh), ?_, fun g => (eV (qh g)).2⟩
  exact V.subtype_injective.comp (eV.injective.comp
    (CFSG.LocalAnalysis.ComponentInitial.QuaternionMatrices.quatHom_injective hF2 hab))

theorem component_eq_of_sl3_pair
    (hGA : CFSG.ComponentClassification.TBLit.GriessMultipliersAllModels)
    {H : Type} [Group H] [Finite H] (hH : Gen4 H) {M : Subgroup H} (hM : IsQuasisimple ↥M)
    (φ : Q8 →* H) (hφ : Function.Injective φ) (hcent : ∀ a : Q8, ∀ m ∈ M, φ a * m = m * φ a)
    {ε : ℤ} {p f : ℕ} {A V : Subgroup H} (hA : SL3Pair ε p f A V) (hAM : A ≤ M)
    {y : H} (hyV : y ∈ V) (hy2 : y * y = 1)
    (hVn : ∀ g : H, g * y = y * g → ∀ v ∈ V, g * v * g⁻¹ ∈ V) : A = M := by
  have hqodd : Odd (p ^ f) := (hA.prime.odd_of_ne_two hA.ne_two).pow
  obtain ⟨ψ, hψ, hψV⟩ := exists_q8_of_hasSL2Model hqodd hA.sl2
  have hψA : ∀ g, ψ g ∈ A := fun g => hA.le (hψV g)
  have hcardA : Nat.card (↥A ⧸ center ↥A) = l3Card ε (p ^ f) :=
    card_of_model hA.prime hA.one_le hA.model
  have hlarge : 62400 < l3Card ε (p ^ f) := l3Card_large hA.five_le
  have hbig : 62400 < Nat.card (↥A ⧸ center ↥A) := hcardA ▸ hlarge
  have htype := component_type_of_gen4 hH hM φ hφ hcent hAM hA.center_odd ψ hψ hψA hbig
  obtain ⟨δ, p', f', hp', hp'2, hf', hδ, hS⟩ : ∃ (δ : ℤ) (p' f' : ℕ), p'.Prime ∧ p' ≠ 2 ∧ 1 ≤ f' ∧
      (δ = 1 ∨ δ = -1) ∧ ((δ = 1 ∧ StatedClassicalModel (↥M ⧸ center ↥M) .PSL 3 p' f') ∨
        (δ = -1 ∧ StatedClassicalModel (↥M ⧸ center ↥M) .PSU 3 p' f')) := by
    rcases htype with ⟨p', f', hp', hp'2, hf', h⟩ | ⟨p', f', hp', hp'2, hf', h⟩
    · exact ⟨1, p', f', hp', hp'2, hf', Or.inl rfl, Or.inl ⟨rfl, h⟩⟩
    · exact ⟨-1, p', f', hp', hp'2, hf', Or.inr rfl, Or.inr ⟨rfl, h⟩⟩
  have hcardS : Nat.card (↥M ⧸ center ↥M) = l3Card δ (p' ^ f') := card_of_model hp' hf' hS
  have hodd' : Odd (p' ^ f') := (hp'.odd_of_ne_two hp'2).pow
  have hle : l3Card ε (p ^ f) ≤ Nat.card (↥M ⧸ center ↥M) := hcardA ▸ card_quot_center_le hAM
  have h5r : 5 ≤ p' ^ f' := by
    by_contra hlt
    have hlt' : p' ^ f' < 5 := not_le.mp hlt
    have hp'3 : 3 ≤ p' := by
      have := hp'.two_le
      omega
    have h3 : 3 ≤ p' ^ f' := hp'3.trans (Nat.le_self_pow (by omega) p')
    have h3' : p' ^ f' = 3 := by
      obtain ⟨k, hk⟩ := hodd'
      omega
    rw [hcardS, h3'] at hle
    have := l3Card_three_le δ
    omega
  let mkM : ↥M →* ↥M ⧸ center ↥M := QuotientGroup.mk' (center ↥M)
  have hmkM : Function.Surjective mkM := QuotientGroup.mk'_surjective _
  have hkerM : mkM.ker = center ↥M := QuotientGroup.ker_mk' _
  have hZodd : Odd (Nat.card (center ↥M)) :=
    odd_center_of_l3Cover hGA hM hp' hp'2 hδ h5r (isLnEps_of_model hS) mkM hmkM hkerM.le
  have hkodd : Odd (Nat.card mkM.ker) := by rw [hkerM]; exact hZodd
  have hVM : V ≤ M := hA.le.trans hAM
  let g : ↥V →* ↥M ⧸ center ↥M := mkM.comp (Subgroup.inclusion hVM)
  have hVcen : ∀ v : ↥V, v ∈ center ↥V → v ^ 2 = 1 := by
    obtain ⟨F₃, _, _, hF₃, ⟨e₃⟩⟩ := hA.sl2
    let e' : SL(2, F₃) ≃* ↥V := (specialLinearGroupEquivStatedSL 2 F₃).trans e₃.symm
    intro v hv
    have hw : e'.symm v ∈ center SL(2, F₃) := by
      rw [Subgroup.mem_center_iff]
      intro x
      apply e'.injective
      rw [map_mul, map_mul, MulEquiv.apply_symm_apply]
      exact Subgroup.mem_center_iff.1 hv (e' x)
    have hw2 : e'.symm v ^ 2 = 1 := by
      rcases CFSG.GH74.KGroups.L3Eps.sl2c_center_eq hw with h | h
      · rw [h]; simp
      · rw [h]; ext i j; fin_cases i <;> fin_cases j <;> simp [pow_two]
    have := congrArg e' hw2
    rwa [map_pow, MulEquiv.apply_symm_apply, map_one] at this
  have hginj : Function.Injective g := by
    rw [injective_iff_map_eq_one]
    intro v hv
    have hv' : Subgroup.inclusion hVM v ∈ center ↥M := (QuotientGroup.eq_one_iff _).1 hv
    have hvc : v ∈ center ↥V := by
      rw [Subgroup.mem_center_iff]
      intro w
      apply Subgroup.inclusion_injective hVM
      have := Subgroup.mem_center_iff.1 hv' (Subgroup.inclusion hVM w)
      simpa using this
    have hsq := hVcen v hvc
    have h1 : orderOf (Subgroup.inclusion hVM v) ∣ Nat.card (center ↥M) :=
      Subgroup.orderOf_dvd_natCard _ hv'
    have h2 : orderOf v ∣ 2 := orderOf_dvd_of_pow_eq_one hsq
    have h3 : orderOf (Subgroup.inclusion hVM v) = orderOf v :=
      orderOf_injective (Subgroup.inclusion hVM) (Subgroup.inclusion_injective hVM) v
    rw [h3] at h1
    rcases (Nat.dvd_prime Nat.prime_two).1 h2 with h | h
    · exact orderOf_eq_one_iff.1 h
    · exfalso
      rw [h] at h1
      obtain ⟨k, hk⟩ := hZodd
      obtain ⟨j, hj⟩ := h1
      omega
  obtain ⟨F₂, _, _, hF₂, ⟨e⟩⟩ := hA.sl2
  have hJh : CFSG.GH74.GLS.HasSL2Model ↥g.range (fun q => q = p ^ f) :=
    ⟨F₂, inferInstance, inferInstance, hF₂, ⟨(MonoidHom.ofInjective hginj).symm.trans e⟩⟩
  have hF₂odd : Odd (Nat.card F₂) := hF₂ ▸ hqodd
  have h2F₂ : (2 : F₂) ≠ 0 := CFSG.ABGLocalTools.two_ne_zero_of_odd_card hF₂odd
  have hF₂2 : ringChar F₂ ≠ 2 := by
    intro h
    apply h2F₂
    have : CharP F₂ 2 := h ▸ ringChar.charP F₂
    exact CharTwo.two_eq_zero
  let e' : SL(2, F₂) ≃* ↥V := (specialLinearGroupEquivStatedSL 2 F₂).trans e.symm
  obtain ⟨t, htV, ht2, hty, hVn'⟩ : ∃ t : H, t ∈ V ∧ orderOf t = 2 ∧ (y = 1 ∨ y = t) ∧
      (∀ g : H, g * t = t * g → ∀ v ∈ V, g * v * g⁻¹ ∈ V) := by
    have hneg : (-1 : SL(2, F₂)) * (-1) = 1 := by ext i j; fin_cases i <;> fin_cases j <;> simp
    have hne : (-1 : SL(2, F₂)) ≠ 1 := CFSG.GH74.KGroups.L3Eps.neg_one_ne_one h2F₂
    have hord : orderOf (e' (-1) : H) = 2 := by
      rw [Subgroup.orderOf_coe, MulEquiv.orderOf_eq e']
      exact orderOf_eq_prime (by rw [sq]; exact hneg) hne
    have hy' : y = 1 ∨ y = (e' (-1) : H) := by
      have hw : e'.symm ⟨y, hyV⟩ * e'.symm ⟨y, hyV⟩ = 1 := by
        rw [← map_mul]
        have : (⟨y, hyV⟩ : ↥V) * ⟨y, hyV⟩ = 1 := Subtype.ext hy2
        rw [this, map_one]
      rcases CFSG.GH74.KGroups.L3Eps.sl2c_sq_eq_one hF₂2 hw with h | h
      · left
        have : (⟨y, hyV⟩ : ↥V) = 1 := by
          have := congrArg e' h
          simpa using this
        exact congrArg Subtype.val this
      · right
        have : (⟨y, hyV⟩ : ↥V) = e' (-1) := by
          have := congrArg e' h
          simpa using this
        exact congrArg Subtype.val this
    refine ⟨(e' (-1) : H), (e' (-1)).2, hord, hy', fun g hg v hv => ?_⟩
    rcases hy' with h | h
    · exact hVn g (by rw [h]; simp) v hv
    · exact hVn g (by rw [h]; exact hg) v hv
  have htM : t ∈ M := hVM htV
  let tM : ↥M := ⟨t, htM⟩
  have htM2 : orderOf tM = 2 := by rw [Subgroup.orderOf_mk]; exact ht2
  have hz2 : orderOf (mkM tM) = 2 :=
    OddKernelInvolutions.image_order mkM hkodd tM htM2
  have hzJ : mkM tM ∈ g.range := ⟨⟨t, htV⟩, rfl⟩
  have hCK : ∀ c : ↥M ⧸ center ↥M, c * mkM tM = mkM tM * c → ∀ k ∈ g.range, c * k * c⁻¹ ∈ g.range := by
    intro c hc k hk
    have hcc : c ∈ centralizer ({mkM tM} : Set (↥M ⧸ center ↥M)) :=
      Subgroup.mem_centralizer_singleton_iff.2 hc
    rw [← OddKernelInvolutions.image_centralizer mkM hmkM hkodd tM htM2] at hcc
    obtain ⟨m, hm, rfl⟩ := hcc
    obtain ⟨v, rfl⟩ := hk
    have hmt : (m : H) * t = t * m := by
      have := Subgroup.mem_centralizer_singleton_iff.1 hm
      exact congrArg Subtype.val this
    refine ⟨⟨(m : H) * v * (m : H)⁻¹, hVn' (m : H) hmt v v.2⟩, ?_⟩
    simp only [g, MonoidHom.comp_apply, ← map_inv, ← map_mul]
    rfl
  have hr : p' ^ f' = p ^ f := by
    have hE := isLnEps_of_model hS
    have h3 : 3 ≤ p ^ f := by have := hA.five_le; omega
    rcases hS with ⟨rfl, hSL⟩ | ⟨rfl, hSU⟩
    · exact CFSG.GH74.GLS.Stage4.Rest.field_eq_of_component_L3 hp' hp'2 hE hA.prime hA.ne_two hJh h3
        hzJ hz2 hCK
    · exact CFSG.GH74.GLS.Stage4.Rest.field_eq_of_component_U3 hp' hp'2 hE hA.prime hA.ne_two hJh h3
        hzJ hz2 hCK
  let gA : ↥A →* ↥M ⧸ center ↥M := mkM.comp (Subgroup.inclusion hAM)
  have hkerA : gA.ker ≤ center ↥A := by
    intro a ha
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at ha
    rw [Subgroup.mem_center_iff]
    intro b
    apply Subgroup.inclusion_injective hAM
    have := Subgroup.mem_center_iff.1 ha (Subgroup.inclusion hAM b)
    simpa using this
  have hd1 : Nat.card (↥A ⧸ center ↥A) ∣ Nat.card gA.range := card_quot_center_dvd_range gA hkerA
  have hd2 : Nat.card gA.range ∣ Nat.card (↥M ⧸ center ↥M) := Subgroup.card_subgroup_dvd_card _
  have hεδ : ε = δ := by
    apply eq_of_l3Card_dvd hA.eps hδ hA.five_le
    have := hd1.trans hd2
    rwa [hcardA, hcardS, hr] at this
  subst hεδ
  have hAeq : Nat.card gA.range = Nat.card (↥M ⧸ center ↥M) := by
    apply le_antisymm (Nat.le_of_dvd Nat.card_pos hd2)
    calc Nat.card (↥M ⧸ center ↥M) = l3Card ε (p' ^ f') := hcardS
      _ = l3Card ε (p ^ f) := by rw [hr]
      _ = Nat.card (↥A ⧸ center ↥A) := hcardA.symm
      _ ≤ Nat.card gA.range := Nat.le_of_dvd Nat.card_pos hd1
  have htop : gA.range = ⊤ := Subgroup.eq_top_of_card_eq _ hAeq
  have hMA : M ≤ A := by
    have hcomm : ∀ m₁ m₂ : ↥M, ⁅m₁, m₂⁆ ∈ A.subgroupOf M := by
      intro m₁ m₂
      have h1 : mkM m₁ ∈ gA.range := htop ▸ Subgroup.mem_top _
      have h2 : mkM m₂ ∈ gA.range := htop ▸ Subgroup.mem_top _
      obtain ⟨a₁, ha₁⟩ := h1
      obtain ⟨a₂, ha₂⟩ := h2
      have hz₁ : (Subgroup.inclusion hAM a₁)⁻¹ * m₁ ∈ center ↥M :=
        QuotientGroup.eq.1 ha₁
      have hz₂ : (Subgroup.inclusion hAM a₂)⁻¹ * m₂ ∈ center ↥M :=
        QuotientGroup.eq.1 ha₂
      have e₁ : m₁ = Subgroup.inclusion hAM a₁ * ((Subgroup.inclusion hAM a₁)⁻¹ * m₁) := by group
      have e₂ : m₂ = Subgroup.inclusion hAM a₂ * ((Subgroup.inclusion hAM a₂)⁻¹ * m₂) := by group
      rw [e₁, e₂, commutator_mul_central _ _ _ _ hz₁ hz₂, ← map_commutatorElement]
      refine (Subgroup.mem_subgroupOf).2 ?_
      exact (⁅a₁, a₂⁆ : ↥A).2
    have : Group.IsPerfect ↥M := hM.1
    have hperf : commutator ↥M = ⊤ := Group.IsPerfect.commutator_eq_top (G := ↥M)
    have : (⊤ : Subgroup ↥M) ≤ A.subgroupOf M := by
      rw [← hperf]
      exact Subgroup.commutator_le.2 fun a _ b _ => hcomm a b
    intro m hm
    have := this (Subgroup.mem_top (⟨m, hm⟩ : ↥M))
    exact (Subgroup.mem_subgroupOf).1 this
  exact le_antisymm hAM hMA

