theorem b_thm2_p85_of_B2_g4
    (hL34 : B_gen4_noL34_elem) (h102 : B_ivk_10_2) (hA7 : B_thm2_A7_exc)
    (hB2 : B_B2) (h73 : IVK.IVK_7_3_g4)
    (halt : B_thm2_p85_alt) (hspor : B_thm2_p85_spor) : B_thm2_p85 := by
  intro G _ _ hG x y K T S M hchoice hKM hQ L hL
  have hstd := hchoice.std
  have hLM : L ≤ M := hL.2.1.1
  have hQM : T ⊓ CxK x K ≤ M := hQ.le.trans inf_le_left
  have hxM : x ∈ M := hQM ⟨hstd.x_mem_T, hstd.x_mem_CxK⟩
  by_cases hne : imgM M K = imgM M L
  · have hLeq := eq_sup_of_imgM_eq hLM hL.1 hne
    refine ⟨isPCompIn_of_eq_sup hKM ?_ (TwoThin.isQuasisimple_hat hstd.comp) hL hLeq, hLeq⟩
    exact commutator_self_of_isTwoComponent (TwoThin.isPCompIn_two_iff.1 hstd.comp).1
      (TwoThin.isPCompIn_two_iff.1 hstd.comp).2
  · exfalso
    have hsetup : P85Setup x y K T S M L := ⟨hG, hchoice, hKM, hQ, hL, hne⟩
    have hMtop : M ≠ ⊤ := hchoice.maximal.1
    have hterm : IsTerminalSub (imgM M K) := Th2.IV26.isTerminalSub_imgM_of_B2 hB2 hG hchoice hKM hQ
    have hrk : 2 ≤ pRank 2 ↥(T ⊓ CxK x K) := hstd.two_le_pRank_Q hA7 hG
    have hsocle : IsSimpleSocle (imgM M L) ⊤ := b_thm2_p86_proved G x y K T S M L hsetup hrk hterm
    have hQ2 : IsPGroup 2 ↥(T ⊓ CxK x K) := hstd.T_pGroup.to_le inf_le_left
    obtain ⟨eQ⟩ := equiv_imgM hQM hQ2
    have hU2 : InU2 (kBar K) := h102 G hG x y K hstd.v2ss.isV2Triple.1
    have hno34 : ¬ IsL34Quotient (kBar K) := fun hl34 =>
      hL34 G hG.gen4 x K hstd.orderOf_x hstd.comp ⟨hl34, (inU2_center hU2).1, (inU2_center hU2).2⟩
    obtain ⟨eK⟩ := kBar_equiv_imgM hKM
    have hU2' : InU2 (↥(imgM M K) ⧸ pPrimeCore 2 ↥(imgM M K)) := inU2_of_mulEquiv eK.symm hU2
    have hx2 : orderOf (⟨x, hxM⟩ : ↥M) = 2 := (Subgroup.orderOf_mk x hxM).trans hstd.orderOf_x
    have hxb2 : orderOf (barMk ↥M ⟨x, hxM⟩) = 2 := orderOf_barMk hx2
    have hxbc : ∀ k ∈ imgM M K, barMk ↥M ⟨x, hxM⟩ * k = k * barMk ↥M ⟨x, hxM⟩ := by
      intro k hk
      obtain ⟨m, hm, rfl⟩ := mem_imgM_iff.1 hk
      rw [← map_mul, ← map_mul]
      congr 1
      apply Subtype.ext
      exact (mem_centralizer_singleton_iff.1 (hstd.K_le_C hm)).symm
    have hKcomp := hterm _ hxb2 hxbc
    have hKq : IsQuasisimple ↥(imgM M K) :=
      CFSG.LocalCores.isQuasisimple_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hKcomp.1)
        hKcomp.2.1
    have hrk' : 2 ≤ pRank 2 ↥(imgM M (T ⊓ CxK x K)) := by
      rw [← Stage1.Thm2.Recip.pRank_eq_of_mulEquiv' eQ]
      exact hrk
    have hSyl : IsSylowOf 2 (imgM M (T ⊓ CxK x K))
        (centralizer ((imgM M K : Subgroup (Mb M)) : Set (Mb M)) ⊓ ⊤) := by
      rw [inf_top_eq]
      exact isSylowOf_imgM_cmbar hKM hQ
    have hterm' : ∀ z ∈ (⊤ : Subgroup (Mb M)), orderOf z = 2 →
        z ∈ centralizer ((imgM M K : Subgroup (Mb M)) : Set (Mb M)) →
        IsCompIn (centralizer ({z} : Set (Mb M)) ⊓ ⊤) (imgM M K) := by
      intro z _ hz2 hzc
      rw [inf_top_eq]
      exact hterm z hz2 (fun k hk => (Subgroup.mem_centralizer_iff.1 hzc k hk).symm)
    have hnat : IsKGroupNative ↥(⊤ : Subgroup (Mb M)) :=
      SectionRank.IsKGroupCat.of_mulEquiv (isKGroupNative_Mb hG.kproper hMtop)
        Subgroup.topEquiv
    have hgen4 : Gen4 ↥(⊤ : Subgroup (Mb M)) :=
      Gen4.of_mulEquiv Subgroup.topEquiv.symm (Gen4.quotient _ (Gen4.subgroup M hG.gen4))
    have hGH : GHList ↥(imgM M L) :=
      IVK.ghList_of_subgroup_of_quotient hG.kgh hMtop (barMk ↥M) barMk_surjective (imgM M L)
        hsocle.simple (IVK.exists_noncomm_of_le_isQuasisimple (imgM_mono hL.1) hKq)
    obtain ⟨hel, hcard, hcase⟩ := h73 (Mb M) ⊤ (imgM M L) (imgM M K) (imgM M (T ⊓ CxK x K)) hgen4 hGH
      hnat ⟨hsocle.le, hsocle.normal, hsocle.simple, hsocle.centralizer_trivial⟩
      (imgM_mono hL.1) hKq hU2' hSyl hrk' hterm'
    have hstruct : P85Struct x y K T S M L :=
      ⟨hsetup, hterm, hsocle, isElementaryAbelian_of_mulEquiv' eQ hel,
        (Nat.card_congr eQ.toEquiv).trans hcard⟩
    rcases hcase with ⟨h5, hs, hc⟩ | ⟨h5, hs, hc⟩ | ⟨hN, n, hn, hK, hL'⟩ | ⟨hl34, -⟩ | ⟨hl34, -⟩
    · exact hspor G x y K T S M L hstruct
        ⟨h5, Or.inl ⟨hs, by rwa [Subgroup.card_top] at hc⟩⟩
    · refine hspor G x y K T S M L hstruct ⟨h5, Or.inr ⟨hs, ?_⟩⟩
      rcases hc with hc | hc
      · exact Or.inl hc.symm
      · exact Or.inr (by rwa [Subgroup.card_top] at hc)
    · exact halt G x y K T S M L hstruct ⟨hN.symm, n, hn, hK, hL'⟩
    · exact hno34 (isL34Quotient_of_mulEquiv eK hl34)
    · exact hno34 (isL34Quotient_of_mulEquiv eK hl34)

end CFSG.GH74.GLS
