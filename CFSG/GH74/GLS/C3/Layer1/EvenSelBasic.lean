variable {G : Type} [Group G] [Finite G]

omit [Finite G] in
theorem TermK.pPrimeCore_eq_bot {K : Subgroup G} (hK : TermK K) : pPrimeCore 2 ↥K = ⊥ :=
  (Subgroup.map_eq_bot_iff_of_injective _ K.subtype_injective).1 hK.oddCore

noncomputable def kBarEquiv {K : Subgroup G} (hK : pPrimeCore 2 ↥K = ⊥) : kBar K ≃* ↥K :=
  (QuotientGroup.quotientMulEquivOfEq hK).trans QuotientGroup.quotientBot

theorem isPCompIn_of_terminalPair {x : G} {K : Subgroup G} (h : IsTerminalPair 2 x K) :
    IsPCompIn 2 (centralizer ({x} : Set G)) K := by
  obtain ⟨-, hKcomp, hev, -⟩ := h
  have hKC : K ≤ centralizer ({x} : Set G) := hKcomp.1
  refine ⟨hKC, CFSG.LocalAnalysis.ComponentInitial.isPComponent_of_isComponent_of_not_le 2
    hKcomp.2 fun hle => ?_⟩
  have h1 : Nat.card ↥(K.subgroupOf (centralizer ({x} : Set G))) ∣
      Nat.card ↥(pPrimeCore 2 ↥(centralizer ({x} : Set G))) := Subgroup.card_dvd_of_le hle
  have h2 : Nat.card ↥(K.subgroupOf (centralizer ({x} : Set G))) = Nat.card ↥K :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hKC).toEquiv
  rw [h2] at h1
  have h3 := Nat.Coprime.coprime_dvd_right h1 CFSG.pPrimeCore_coprime_card
  have h4 := Nat.Coprime.eq_one_of_dvd h3 hev
  omega

theorem termK_of_terminalPair
    (hOdd : ∀ t : G, orderOf t = 2 → pPrimeCore 2 ↥(centralizer ({t} : Set G)) = ⊥)
    {x : G} {K : Subgroup G} (h : IsTerminalPair 2 x K) : TermK K := by
  have hKc := isPCompIn_of_terminalPair h
  have hOx := hOdd x h.1
  have hKsub : (K.subgroupOf (centralizer ({x} : Set G))).IsSubnormal :=
    Components.mathlib_subnormal_of_chain (TwoThin.isPCompIn_two_iff.mp hKc).2.1
      Subgroup.IsSubnormal.top
  have hOK : pPrimeCore 2 ↥K = ⊥ := pPrimeCore_eq_bot_of_subnormal hKc.1 hKsub hOx
  refine ⟨Th2.P72c.isQuasisimple_of_isPCompIn hKc hOx, ?_, h.2.2.1, h.2.2.2⟩
  unfold pPrimeCoreOf
  rw [hOK, Subgroup.map_bot]

theorem hasL2Model_fm9 (hClass : FM9Class) {x : G} {K : Subgroup G}
    (hG : C3Hyp G) (hE : IsEvenType G) (hx : orderOf x = 2)
    (hK : IsPCompIn 2 (centralizer ({x} : Set G)) K) {p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hL : LieModel (kBar K) .PSL 2 p f) : HasL2Model (kBar K) IsFM9 := by
  have hq : IsQuasisimple (kBar K) := TwoThin.isQuasisimple_hat hK
  have hU2 : InU2 (kBar K) :=
    ⟨hq, Or.inl (hasL2Model_of_lieModel' hp hp2 (hp.odd_of_ne_two hp2).pow hL)⟩
  have hno : ¬ IsL34Quotient (kBar K) := not_isL34Quotient_of_lieModel hp hp2 hL
  obtain ⟨eb⟩ := PumpCalc.kBar_equiv_bar hK
  have hP : TwoThin.Gen4Comp ↥(PumpCalc.bar x K) :=
    TwoThin.gen4Comp_of_gen4Cen (TwoThin.gen4Cen_barQ hG.gen4 hx) _
  have hC : InC2 ↥(PumpCalc.bar x K) := hE.1 x hx _ (PumpCalc.isComponent_bar hK)
  have hL2b : HasL2Model ↥(PumpCalc.bar x K) IsFM9 :=
    hClass _ hP hC (inU2_of_mulEquiv eb hU2)
      (fun hl => hno (TwoThin.isL34Quotient_of_mulEquiv eb.symm hl))
  exact TwoThin.hasL2Model_of_mulEquiv eb.symm hL2b

theorem isPGroup_two_center_of_pPrimeCore_eq_bot' {X : Type*} [Group X] [Finite X]
    (hO : pPrimeCore 2 X = ⊥) : IsPGroup 2 (center X) := by
  intro z
  obtain ⟨i, m, hm, him⟩ := Nat.exists_eq_two_pow_mul_odd (orderOf_pos z).ne'
  refine ⟨i, ?_⟩
  set w := z ^ 2 ^ i with hw
  have hwo : orderOf w = m := by
    rw [hw, orderOf_pow_of_dvd (by positivity) (by rw [him]; exact dvd_mul_right _ _), him,
      Nat.mul_div_cancel_left _ (by positivity)]
  have hwN : (zpowers ((w : center X) : X)).Normal := by
    constructor
    intro n hn g
    obtain ⟨k, rfl⟩ := mem_zpowers_iff.mp hn
    have hc := Subgroup.mem_center_iff.mp (zpow_mem w.2 k) g
    rw [hc, mul_inv_cancel_right]
    exact zpow_mem (mem_zpowers _) k
  have hcop : Nat.Coprime 2 (Nat.card (zpowers ((w : center X) : X))) := by
    rw [Nat.card_zpowers, Subgroup.orderOf_coe, hwo, Nat.coprime_two_left]
    exact hm
  have hle : zpowers ((w : center X) : X) ≤ CFSG.pPrimeCore 2 X := le_sSup ⟨hwN, hcop⟩
  rw [hO] at hle
  exact Subtype.ext (mem_bot.mp (hle (mem_zpowers _)))

theorem false_of_terminal_l34
    (hG : C3Hyp G) (hE : IsEvenType G) {x : G} {K : Subgroup G} (h : IsTerminalPair 2 x K)
    (hL34 : IsL34Quotient ↥K) : False := by
  have hK : TermK K := termK_of_terminalPair hE.2.1 h
  have hKc := isPCompIn_of_terminalPair h
  have hO := hK.pPrimeCore_eq_bot
  let e : kBar K ≃* ↥K := kBarEquiv hO
  have hL34' : IsL34Quotient (kBar K) := TwoThin.isL34Quotient_of_mulEquiv e.symm hL34
  have hZ2 : IsPGroup 2 ↥(center (kBar K)) :=
    (isPGroup_two_center_of_pPrimeCore_eq_bot' hO).of_equiv (Subgroup.centerCongr e).symm
  by_cases hZ : center (kBar K) = ⊥
  · exact Bk.false_of_l34_trivial_center hG.gen4 h.1 hKc hL34' hZ
  · exact Stage1.Main.l34_cover_any (kBar K) (TwoThin.isQuasisimple_hat hKc) hZ2 hL34' hZ
      (Gen4.quotient (pPrimeCore 2 ↥K) (Gen4.subgroup K hG.gen4))

theorem mem_of_isSylowOf_centralizer {x : G} (hx2 : orderOf x = 2) {T : Subgroup G}
    (hT : IsSylowOf 2 T (centralizer ({x} : Set G))) : x ∈ T := by
  have hxC : x ∈ centralizer ({x} : Set G) := mem_centralizer_singleton_iff.2 rfl
  have hxel : CFSG.IsElementaryAbelian 2 ↥(zpowers x) :=
    Th2.isElementaryAbelian_zpowers_of_orderOf_two hx2
  have hxp : IsPGroup 2 ↥(zpowers x) := CFSG.IsElementaryAbelian.isPGroup 2 _
  obtain ⟨g, hgC, hgW⟩ := Th2.exists_cj_le_of_isSylowOf hT (zpowers_le.2 hxC) hxp
  have hgx : g * x = x * g := mem_centralizer_singleton_iff.1 hgC
  have : g⁻¹ * x * g = x := by
    calc g⁻¹ * x * g = g⁻¹ * (x * g) := by group
      _ = g⁻¹ * (g * x) := by rw [hgx]
      _ = x := by group
  exact hgW ((Th2.mem_cj_iff g _ x).2 (by rw [this]; exact mem_zpowers x))

theorem exists_good_x {K T' : Subgroup G} (hT' : IsSylowOf 2 T' (normalizer (K : Set G)))
    (hex : ∃ u : G, orderOf u = 2 ∧ u ∈ centralizer (K : Set G)) :
    ∃ x : G, x ∈ T' ∧ x ∈ centralizer (K : Set G) ∧ orderOf x = 2 ∧ ∀ t ∈ T', t * x = x * t := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hCN : centralizer (K : Set G) ≤ normalizer (K : Set G) :=
    Subgroup.centralizer_le_normalizer (K : Set G)
  have hQsyl : IsSylowOf 2 (T' ⊓ centralizer (K : Set G)) (centralizer (K : Set G)) :=
    hT'.inf_of_le_normalizer hCN (normalizer_le_normalizer_centralizer' K)
  obtain ⟨u, hu2, huC⟩ := hex
  have h2 : 2 ∣ Nat.card ↥(T' ⊓ centralizer (K : Set G)) := by
    rw [hQsyl.card_eq]
    have hdvd : 2 ∣ Nat.card ↥(centralizer (K : Set G)) := by
      have := Subgroup.orderOf_dvd_natCard _ huC
      rwa [hu2] at this
    have hf : 1 ≤ (Nat.card ↥(centralizer (K : Set G))).factorization 2 :=
      (Nat.Prime.dvd_iff_one_le_factorization Nat.prime_two Nat.card_pos.ne').1 hdvd
    exact dvd_pow_self 2 (by omega)
  obtain ⟨z, hzQ, hz2, hzc⟩ := Back.exists_central_involution_of_normal hT'.isPGroup
    (inf_le_left : T' ⊓ centralizer (K : Set G) ≤ T') (fun t ht p hp => by
      refine ⟨T'.mul_mem (T'.mul_mem ht hp.1) (T'.inv_mem ht), ?_⟩
      exact (mem_normalizer_iff.1 (normalizer_le_normalizer_centralizer' K (hT'.le ht)) p).1 hp.2)
    h2
  exact ⟨z, hzQ.1, hzQ.2, hz2, fun t ht => (hzc t ht).symm⟩

theorem isSylowOf_top' (S : Sylow 2 G) : IsSylowOf 2 (S : Subgroup G) ⊤ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine isSylowOf_of_card le_top ?_
  rw [Subgroup.card_top, Sylow.card_eq_multiplicity]

