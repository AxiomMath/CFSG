section Models

theorem lieModel_of_violates {G : Type} [Group G] [Finite G] {x : G} {K : Subgroup G}
    (h : EvenViolates x K) : ∃ p f : ℕ, p.Prime ∧ p ≠ 2 ∧ LieModel ↥K .PSL 2 p f := by
  rcases h with ⟨p, f, hp, hp2, hL, -⟩ | h
  · exact ⟨p, f, hp, hp2, hL⟩
  · unfold EvenBCond at h
    push Not at h
    obtain ⟨p, f, hp, hp2, hL, -⟩ := h
    exact ⟨p, f, hp, hp2, hL⟩

variable {K : Type} [Group K]

theorem exists_l2Field_of_lieModel' {p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hL : LieModel K .PSL 2 p f) :
    ∃ (F : Type) (_ : Field F) (_ : Finite F) (_ : K ≃* L2 F), L2Field F ∧ Nat.card F = p ^ f :=
  Th2.Bal.exists_l2Field_of_lieModel (hp.odd_of_ne_two hp2).pow hL

theorem isSimpleGroup_of_lieModel' {p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hL : LieModel K .PSL 2 p f) : IsSimpleGroup K := by
  obtain ⟨F, _, _, e, hF, -⟩ := exists_l2Field_of_lieModel' hp hp2 hL
  exact isSimpleGroup_of_l2 hF e

theorem hasL2Model_of_lieModel' {P : ℕ → Prop} {p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hP : P (p ^ f)) (hL : LieModel K .PSL 2 p f) : HasL2Model K P := by
  obtain ⟨F, _, _, e, hF, hFq⟩ := exists_l2Field_of_lieModel' hp hp2 hL
  have hf : 1 ≤ f := by
    by_contra h0
    have h0' : f = 0 := by omega
    have := hF.2
    rw [hFq, h0', pow_zero] at this
    omega
  exact ⟨p, f, hp, hf, hP, hL⟩

theorem card_of_lieModel_psl2' {p f : ℕ} (hL : LieModel K .PSL 2 p f) :
    Nat.card K = ordA 1 (p ^ f) := by
  simpa using card_of_lieModel_PSL (n := 2) (by norm_num) hL

theorem eq_of_ordA_one_eq {q q' : ℕ} (hq : Odd q) (hq' : Odd q') (h : ordA 1 q = ordA 1 q') :
    q = q' := by
  obtain ⟨k, rfl⟩ := hq
  obtain ⟨k', rfl⟩ := hq'
  rw [PumpClass.ordA_one_odd, PumpClass.ordA_one_odd] at h
  have hkk : k = k' := by
    by_contra hne
    rcases lt_or_gt_of_ne hne with hlt | hlt
    · have h1 : 2 * k * (k + 1) * (2 * k + 1) < 2 * k' * (k' + 1) * (2 * k' + 1) := by
        have hk1 : k + 1 ≤ k' := hlt
        have h2 : 2 * k + 1 < 2 * k' + 1 := by omega
        calc 2 * k * (k + 1) * (2 * k + 1) ≤ 2 * k' * (k + 1) * (2 * k + 1) := by gcongr
          _ ≤ 2 * k' * (k' + 1) * (2 * k + 1) := by gcongr
          _ < 2 * k' * (k' + 1) * (2 * k' + 1) := by
            apply Nat.mul_lt_mul_of_pos_left h2
            have : 0 < k' := by omega
            positivity
      omega
    · have h1 : 2 * k' * (k' + 1) * (2 * k' + 1) < 2 * k * (k + 1) * (2 * k + 1) := by
        have hk1 : k' + 1 ≤ k := hlt
        have h2 : 2 * k' + 1 < 2 * k + 1 := by omega
        calc 2 * k' * (k' + 1) * (2 * k' + 1) ≤ 2 * k * (k' + 1) * (2 * k' + 1) := by gcongr
          _ ≤ 2 * k * (k + 1) * (2 * k' + 1) := by gcongr
          _ < 2 * k * (k + 1) * (2 * k + 1) := by
            apply Nat.mul_lt_mul_of_pos_left h2
            have : 0 < k := by omega
            positivity
      omega
  rw [hkk]

theorem pow_eq_of_lieModel {p f p' f' : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp' : p'.Prime)
    (hp2' : p' ≠ 2) (h1 : LieModel K .PSL 2 p f) (h2 : LieModel K .PSL 2 p' f') :
    p ^ f = p' ^ f' := by
  have c1 := card_of_lieModel_psl2' h1
  have c2 := card_of_lieModel_psl2' h2
  exact eq_of_ordA_one_eq (hp.odd_of_ne_two hp2).pow (hp'.odd_of_ne_two hp2').pow (c1.symm.trans c2)

theorem ordA_one_ne_20160' {q : ℕ} (hq : Odd q) : ordA 1 q ≠ 20160 := by
  obtain ⟨k, rfl⟩ := hq
  rw [PumpClass.ordA_one_odd]
  intro h
  have hk : k ≤ 35 := by
    by_contra hk
    have hk36 : 36 ≤ k := by omega
    have : 2 * 36 * (36 + 1) * (2 * 36 + 1) ≤ 2 * k * (k + 1) * (2 * k + 1) := by gcongr
    omega
  interval_cases k <;> omega

theorem not_isL34Quotient_of_lieModel {p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) [Finite K]
    (hL : LieModel K .PSL 2 p f) : ¬ IsL34Quotient K := by
  intro hl
  have hs : IsSimpleGroup K := isSimpleGroup_of_lieModel' hp hp2 hL
  have hc : Nat.card (K ⧸ center K) = 20160 := by
    rw [card_of_lieModel_PSL (n := 3) (by norm_num) hl]
    decide
  rcases hs.eq_bot_or_eq_top_of_normal (center K) with hZ | hZ
  · have hcS : Nat.card K = 20160 := by
      rw [← hc]
      exact (Nat.card_congr
        ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).toEquiv).symm
    rw [card_of_lieModel_psl2' hL] at hcS
    exact ordA_one_ne_20160' (hp.odd_of_ne_two hp2).pow hcS
  · have h1 : Nat.card (K ⧸ center K) = 1 := by
      rw [hZ]
      have : Subsingleton (K ⧸ (⊤ : Subgroup K)) := QuotientGroup.subsingleton_quotient_top
      exact Nat.card_of_subsingleton (1 : K ⧸ (⊤ : Subgroup K))
    omega

