variable {G : Type} [Group G] {x y : G} {K T S : Subgroup G}

theorem Th2.centerlessBar_of_equiv {M : Subgroup G} (hK : CenterlessBar K) (e : kBar M ≃* kBar K) :
    CenterlessBar M := by
  intro a ha
  have h1 : e a = 1 := hK (e a) fun b => by
    obtain ⟨c, rfl⟩ := e.surjective b
    rw [← map_mul, ← map_mul, ha c]
  exact e.injective (by rw [h1, map_one])

theorem Th2Std.pumpup_data [Finite G] (h : Th2Std x y K T S) {u : G} (hu : u ∈ T ⊓ CxK x K)
    (huc : ∀ t ∈ T, u * t = t * u) {M : Subgroup G} (hlt : PumpUpLT 2 x K u M) :
    x ∈ normalizer (M : Set G) ∧ Nonempty (kBar M ≃* kBar K) ∧
      IsSylowOf 2 (T ⊓ CxK x K) (CxK u M) := by
  have hterm : IsTwoTerminal x K := h.v2ss.isV2Triple.2.1
  obtain ⟨hxM, he⟩ := hterm.2.1 u M hlt
  exact ⟨hxM, he, hterm.2.2 (T ⊓ CxK x K) h.sylow_Q u M hlt hu fun q hq => huc q hq.1⟩

theorem Th2Std.pumpup_normal [Finite G] (hG : C3Hyp G) (h : Th2Std x y K T S)
    (hcen : CenterlessBar K) (hP : 2 ≤ pRank 2 ↥(T ⊓ K)) {u : G} (hu2 : orderOf u = 2)
    {M : Subgroup G} (hM : IsPCompIn 2 (centralizer ({u} : Set G)) M) (hcenM : CenterlessBar M)
    (hrM : 2 ≤ pRank 2 ↥M) (hQ : IsSylowOf 2 (T ⊓ CxK x K) (CxK u M)) :
    ∀ c ∈ centralizer ({u} : Set G), ∀ k ∈ M, c * k * c⁻¹ ∈ M := by
  intro c hc k hk
  by_contra hkc
  have hM' : IsPCompIn 2 (centralizer ({u} : Set G)) (cj c M) := by
    have := Stage1.Thm2.Recip.isPCompIn_map_conj hM c
    rwa [C3.Layer1.Thm1.map_conj_eq_self_of_mem hc] at this
  have hne : cj c M ≠ M := by
    intro h0
    apply hkc
    have hmem : c * k * c⁻¹ ∈ cj c M := ⟨k, hk, by simp [MulAut.conj_apply]⟩
    rwa [h0] at hmem
  have hle : cj c M ≤ CxK u M := le_inf hM'.1 (Stage1.Thm2.Recip.le_cSec_of_ne hM' hM hne)
  obtain ⟨E, hEM, hEel, hErk⟩ := exists_elemAbelian_pRank M
  have hE2 : 2 ≤ pRank 2 ↥E := hErk ▸ hrM
  have hE'M : cj c E ≤ cj c M := Subgroup.map_mono hEM
  have hE'el := isElementaryAbelian_cj c hEel
  have hE'rk : pRank 2 ↥(cj c E) = pRank 2 ↥E := pRank_cj c E
  have huE' : u ∉ cj c E := by
    intro huE
    have hu1 : c⁻¹ * u * c ∈ M := (mem_cj_iff c M u).1 (hE'M huE)
    have hcu : c⁻¹ * u * c = u := by
      have := mem_centralizer_singleton_iff.1 hc
      calc c⁻¹ * u * c = c⁻¹ * (u * c) := by group
        _ = c⁻¹ * (c * u) := by rw [this]
        _ = u := by group
    rw [hcu] at hu1
    have huO : u ∈ pPrimeCoreOf 2 M := by
      refine mem_pPrimeCoreOf_of_commutators hcenM hu1 (fun k' hk' => ?_)
      have hk'u : k' * u = u * k' := mem_centralizer_singleton_iff.1 (hM.1 hk')
      rw [commutatorElement_def, hk'u]
      simp
    have hodd2 : Odd (orderOf u) :=
      Odd.of_dvd_nat (TwoThin.card_pPrimeCoreOf_odd M) (Subgroup.orderOf_dvd_natCard _ huO)
    rw [hu2] at hodd2
    exact absurd hodd2 (by decide)
  have hxel : CFSG.IsElementaryAbelian 2 ↥(zpowers u) := isElementaryAbelian_zpowers_of_orderOf_two hu2
  have hcd : CommDisj (cj c E) (zpowers u) := by
    refine ⟨fun e he t ht => ?_, ?_⟩
    · obtain ⟨m, rfl⟩ := mem_zpowers_iff.1 ht
      have : e ∈ centralizer ({u} : Set G) := hM'.1 (hE'M he)
      exact (Commute.zpow_right (mem_centralizer_singleton_iff.1 this) m).symm.eq.symm
    · refine eq_bot_iff.2 fun z hz => ?_
      rcases mem_zpowers_two hu2 hz.2 with h0 | h0
      · simp [h0]
      · exact absurd (h0 ▸ hz.1) huE'
  have hFel := hcd.isElementaryAbelian_sup' hE'el hxel le_rfl le_rfl
  have hFrk : pRank 2 ↥(cj c E ⊔ zpowers u) = pRank 2 ↥E + 1 := by
    rw [hcd.pRank_sup hE'el hxel le_rfl le_rfl, hE'rk, pRank_zpowers_of_orderOf_two hu2]
  have huCxKuM : u ∈ CxK u M := by
    refine ⟨mem_centralizer_singleton_iff.2 rfl,
      C3.Layer1.Back.mem_centralizerSection_of_centralizes ?_ ?_⟩
    · intro k' hk'
      exact (mem_centralizer_singleton_iff.1 (hM.1 hk')).symm
    · unfold pPrimeCoreOf
      intro z hz
      obtain ⟨z', -, rfl⟩ := hz
      exact z'.2
  have hFC : cj c E ⊔ zpowers u ≤ CxK u M := sup_le (hE'M.trans hle) (zpowers_le.2 huCxKuM)
  have hFp : IsPGroup 2 ↥(cj c E ⊔ zpowers u) := CFSG.IsElementaryAbelian.isPGroup 2 _
  obtain ⟨g, hgC, hgF⟩ := Th2.exists_cj_le_of_isSylowOf hQ hFC hFp
  have hWel := isElementaryAbelian_cj g hFel
  have hWrk : pRank 2 ↥(cj g (cj c E ⊔ zpowers u)) = pRank 2 ↥E + 1 := by
    rw [pRank_cj, hFrk]
  have hPQ := h.commDisj hcen
  obtain ⟨Ep, hEpP, hEpel, hEprk⟩ := exists_elemAbelian_pRank (T ⊓ K)
  have hEp2 : 2 ≤ pRank 2 ↥Ep := hEprk ▸ hP
  have hsup := hPQ.pRank_sup hEpel hWel hEpP hgF
  have h4 := pRank_le_top' (Ep ⊔ cj g (cj c E ⊔ zpowers u))
  have h5 := hG.pRank_eq_four
  omega

end Pump

@[expose] def B_thm2_pump_terminal : Prop :=
  ∀ (G : Type) [Group G] [Finite G], C3Hyp G → ∀ (x y : G) (K T S : Subgroup G),
    Th2Std x y K T S → 2 ≤ pRank 2 ↥(CxK x K) → ∀ u ∈ T ⊓ CxK x K, (∀ t ∈ T, u * t = t * u) →
      orderOf u = 2 → ∀ M : Subgroup G, PumpUpLT 2 x K u M →
        (∀ c ∈ centralizer ({u} : Set G), ∀ m ∈ M, c * m * c⁻¹ ∈ M) → IsTwoTerminal u M

@[expose] def B_thm2_pump_unbal : Prop :=
  ∀ (G : Type) [Group G] [Finite G], C3Hyp G → ∀ (x y : G) (K T S : Subgroup G),
    Th2Std x y K T S → 2 ≤ pRank 2 ↥(CxK x K) → InC2 (kBar K) → ∀ u ∈ T ⊓ CxK x K,
      (∀ t ∈ T, u * t = t * u) → orderOf u = 2 → ∀ M : Subgroup G, PumpUpLT 2 x K u M →
        (∀ c ∈ centralizer ({u} : Set G), ∀ m ∈ M, c * m * c⁻¹ ∈ M) →
          ∃ y' : G, IsLocallyUnbalancing u y' M

@[expose] def B_thm2_pump_v2 : Prop :=
  ∀ (G : Type) [Group G] [Finite G], C3Hyp G → ∀ (x y : G) (K T S : Subgroup G),
    Th2Std x y K T S → 2 ≤ pRank 2 ↥(CxK x K) → ∀ u ∈ T ⊓ CxK x K, (∀ t ∈ T, u * t = t * u) →
      orderOf u = 2 → ∃ (K' : Subgroup G) (y' : G), IsV2Triple u y' K' ∧
        (∀ c ∈ centralizer ({u} : Set G), ∀ k ∈ K', c * k * c⁻¹ ∈ K') ∧
        Nonempty (kBar K' ≃* kBar K) ∧ IsSylowOf 2 (T ⊓ CxK x K) (CxK u K')

theorem b_thm2_pump_v2_of (hL34 : B_gen4_noL34_elem) (h102 : B_ivk_10_2) (h103 : B_ivk_10_3)
    (hterm : B_thm2_pump_terminal) (hunbal : B_thm2_pump_unbal) : B_thm2_pump_v2 := by
  intro G _ _ hG x y K T S h hrk2 u hu huc hu2
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨hcen, hshape⟩ := h.centerless_and_shape hG hL34 h102
  have hP : 2 ≤ pRank 2 ↥(T ⊓ K) := by
    obtain ⟨U, hU⟩ := exists_isFourSub_of_rankTwoShape hshape
    have := C3.Layer1.Back.pRank_mono' hU.1
    rw [pRank_of_isFourSub hU] at this
    exact this
  have hv : IsV2Triple x y K := h.v2ss.isV2Triple
  have hKil : IsILo 2 x K := hv.2.1.1
  have hux : u ∈ centralizer ({x} : Set G) := hu.2.1
  have hucs : u ∈ centralizerSection K (pPrimeCoreOf 2 K) := hu.2.2
  have hR : 3 ≤ pRank 2 ↥(centralizer ({u} : Set G)) := by
    have h1 : 3 ≤ pRank 2 ↥(centralizer ({x} : Set G)) := by simpa [oBound] using hKil.2.1
    have h2 : pRank 2 ↥T = pRank 2 ↥(centralizer ({x} : Set G)) :=
      pRank_eq_of_isSylowOf h.setup.sylowT
    have hTu : T ≤ centralizer ({u} : Set G) := fun t ht =>
      mem_centralizer_singleton_iff.2 (huc t ht).symm
    have h3 := C3.Layer1.Back.pRank_mono' hTu
    omega
  obtain ⟨M, hlt⟩ := TwoThin.exists_pumpup_of_involution h.orderOf_x hu2 h.comp hux hucs hKil hR
  obtain ⟨hxM, ⟨e⟩, hQ'⟩ := h.pumpup_data hu huc hlt
  have hM : IsPCompIn 2 (centralizer ({u} : Set G)) M := hlt.2.1.2.2
  have hcenM : CenterlessBar M := centerlessBar_of_equiv hcen e
  have hrM : 2 ≤ pRank 2 ↥M := by
    have h1 : pRank 2 (kBar M) = pRank 2 ↥M := by
      have hN : ¬ 2 ∣ Nat.card ↥(pPrimeCore 2 ↥M) := fun h2 =>
        (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).1
          (CFSG.pPrimeCore_coprime_card (p := 2) (G := ↥M)) h2
      exact CFSG.GroupTheory.PRankCoprimeQuotient.pRank_quotient_eq_of_not_dvd Nat.prime_two _ hN
    have h2 : pRank 2 (kBar K) = pRank 2 ↥K := by
      have hN : ¬ 2 ∣ Nat.card ↥(pPrimeCore 2 ↥K) := fun h2 =>
        (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).1
          (CFSG.pPrimeCore_coprime_card (p := 2) (G := ↥K)) h2
      exact CFSG.GroupTheory.PRankCoprimeQuotient.pRank_quotient_eq_of_not_dvd Nat.prime_two _ hN
    have h3 : pRank 2 (kBar M) = pRank 2 (kBar K) :=
      CFSG.RankThree.PartOne.Quotient36.pRank_congr_mulEquiv one_lt_two e
    have h4 : pRank 2 ↥(T ⊓ K) ≤ pRank 2 ↥K := C3.Layer1.Back.pRank_mono' inf_le_right
    omega
  have hnorm := h.pumpup_normal hG hcen hP hu2 hM hcenM hrM hQ'
  have hterm' : IsTwoTerminal u M := hterm G hG x y K T S h hrk2 u hu huc hu2 M hlt hnorm
  obtain ⟨y', hy'⟩ : ∃ y' : G, IsLocallyUnbalancing u y' M := by
    by_cases hC2 : InC2 (kBar K)
    · exact hunbal G hG x y K T S h hrk2 hC2 u hu huc hu2 M hlt hnorm
    · have hU2 : InU2 (kBar K) := h102 G hG x y K hv.1
      exact h103 G hG u M ⟨hu2, hM⟩ (inU2_of_mulEquiv e.symm hU2)
        (fun hMC => hC2 (CFSG.GH74.E2.inC2_of_mulEquiv e hMC))
  refine ⟨M, y', ⟨hy', hterm', Or.inl ?_, fun hL => ?_⟩, hnorm, ⟨e⟩, hQ'⟩
  · rw [← pRank_eq_of_isSylowOf hQ', pRank_eq_of_isSylowOf h.sylow_Q]
    exact hrk2
  · exfalso
    have hc : center (kBar M) = ⊥ := by
      rw [eq_bot_iff]
      intro a ha
      rw [Subgroup.mem_bot]
      exact hcenM a fun b => (Subgroup.mem_center_iff.1 ha b).symm
    refine hL34 G hG.gen4 u M hu2 hM ⟨hL, ?_, ?_⟩
    · rw [hc]; exact isElementaryAbelian_bot'
    · rw [hc]; simp

theorem b_thm2_cent5_of_pump_v2 (hpump : B_thm2_pump_v2) : B_thm2_cent5 := by
  intro G _ _ hG x y K T S h u hu huc hu2
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hv := h.v2ss.1
  have hQ := h.sylow_Q
  by_cases hrk2 : 2 ≤ pRank 2 ↥(CxK x K)
  swap
  · have hxQ : x ∈ T ⊓ CxK x K := ⟨h.x_mem_T, h.x_mem_CxK⟩
    have hux : u = x := by
      by_contra hne
      have hc : x * u = u * x := (huc x h.x_mem_T).symm
      have hcd : CommDisj (zpowers u) (zpowers x) := by
        refine ⟨fun a ha b hb => ?_, ?_⟩
        · obtain ⟨m, rfl⟩ := mem_zpowers_iff.1 ha
          obtain ⟨n, rfl⟩ := mem_zpowers_iff.1 hb
          exact (Commute.zpow_zpow (show Commute u x from hc.symm) m n).eq
        · refine eq_bot_iff.2 fun z hz => ?_
          rcases mem_zpowers_two hu2 hz.1 with h0 | h0
          · simp [h0]
          · rcases mem_zpowers_two h.orderOf_x hz.2 with h1 | h1
            · simp [h1]
            · exact absurd (h0.symm.trans h1) hne
      have hW := hcd.pRank_sup (isElementaryAbelian_zpowers_of_orderOf_two hu2)
        (isElementaryAbelian_zpowers_of_orderOf_two h.orderOf_x) le_rfl le_rfl
      have hWC : zpowers u ⊔ zpowers x ≤ CxK x K :=
        sup_le (zpowers_le.2 hu.2) (zpowers_le.2 h.x_mem_CxK)
      have := C3.Layer1.Back.pRank_mono' hWC
      rw [hW, pRank_zpowers_of_orderOf_two hu2, pRank_zpowers_of_orderOf_two h.orderOf_x] at this
      exact hrk2 this
    rw [hux]
    exact h.setup.sylowT
  obtain ⟨K', y', hV, hnorm, ⟨e⟩, hQ'⟩ := hpump G hG x y K T S h hrk2 u hu huc hu2
  have hM1 : V2Max1 u y' K' := ⟨hV, fun x' y'' K'' h'' hsucc =>
    hv.1.1.1.2 x' y'' K'' h'' (U2Succ_congr_right e hsucc)⟩
  have hrk : pRank 2 ↥(CxK x K) = pRank 2 ↥(CxK u K') := by
    rw [← pRank_eq_of_isSylowOf hQ, ← pRank_eq_of_isSylowOf hQ']
  have hcard : twoPartCard (CxK x K) = twoPartCard (CxK u K') := by
    rw [twoPartCard_eq_card_of_isSylowOf hQ, twoPartCard_eq_card_of_isSylowOf hQ']
  have hM2 : V2Max2 u y' K' := ⟨hM1, fun x' y'' K'' h'' => hrk ▸ hv.1.1.2 x' y'' K'' h''⟩
  have hM3 : V2Max3 u y' K' := ⟨hM2, fun x' y'' K'' h'' => hcard ▸ hv.1.2 x' y'' K'' h''⟩
  have hmax := hv.2 u y' K' hM3
  have hN : NxK u K' = centralizer ({u} : Set G) := by
    refine le_antisymm inf_le_left (le_inf le_rfl fun c hc => ?_)
    rw [Subgroup.mem_normalizer_iff]
    intro k
    refine ⟨hnorm c hc k, fun hk => ?_⟩
    have := hnorm c⁻¹ (Subgroup.inv_mem _ hc) _ hk
    simpa [mul_assoc] using this
  rw [hN] at hmax
  have hT0 := h.setup.sylowT0
  have h1 : twoPartCard (NxK x K) ≤ Nat.card ↥T := by
    rw [twoPartCard_eq_card_of_isSylowOf hT0]
    exact Nat.card_le_card_of_injective (Subgroup.inclusion inf_le_left)
      (Subgroup.inclusion_injective _)
  have hTC : T ≤ centralizer ({u} : Set G) := fun t ht =>
    mem_centralizer_singleton_iff.2 (huc t ht).symm
  refine isSylowOf_of_card hTC ?_
  have hle : Nat.card ↥T ≤ twoPartCard (centralizer ({u} : Set G)) := by
    obtain ⟨n, hn⟩ := (IsPGroup.iff_card).1 h.T_pGroup
    have hdvd : Nat.card ↥T ∣ Nat.card ↥(centralizer ({u} : Set G)) :=
      Subgroup.card_dvd_of_le hTC
    have hne : Nat.card ↥(centralizer ({u} : Set G)) ≠ 0 := Nat.card_pos.ne'
    rw [hn] at hdvd ⊢
    have := (Nat.Prime.pow_dvd_iff_le_factorization Nat.prime_two hne).1 hdvd
    exact Nat.pow_le_pow_right (by norm_num) this
  exact le_antisymm hle (hmax.trans h1)

end CFSG.GH74.GLS
