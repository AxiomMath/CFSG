variable {Z : Type} [Group Z] [Finite Z]

theorem Bad.toInU2
    {S : Type} [Group S] (h : Bad S) : InU2 S := by
  have hs : IsSimpleGroup S := Bad.simple h
  obtain ⟨hq, -⟩ := CFSG.LocalCores.isQuasisimple_of_isSimpleGroup (Q := S) (Bad.nonabelian h)
  refine ⟨hq, ?_⟩
  rcases h with ⟨p, f, hp, hf, ⟨hodd, -⟩, hL⟩ | ⟨⟨e⟩⟩
  · exact Or.inl ⟨p, f, hp, hf, hodd, hL⟩
  · exact Or.inr (Or.inl ⟨e⟩)

theorem Bad.not_isL34Quotient
    {S : Type} [Group S] [Finite S] (h : Bad S) : ¬ IsL34Quotient S := by
  intro hl
  have hs : IsSimpleGroup S := Bad.simple h
  obtain ⟨-, hZ⟩ := CFSG.LocalCores.isQuasisimple_of_isSimpleGroup (Q := S) (Bad.nonabelian h)
  have hc : Nat.card (S ⧸ center S) = 20160 := by
    rw [card_of_lieModel_PSL (n := 3) (by norm_num) hl]
    decide
  have hcS : Nat.card S = 20160 := by
    rw [← hc, Nat.card_congr ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).toEquiv]
  rcases h with ⟨p, f, hp, hf, ⟨hodd, -⟩, hL⟩ | ⟨⟨e⟩⟩
  · rw [card_of_lieModel_PSL (n := 2) (by norm_num) hL] at hcS
    exact ordA_one_ne_20160 hodd hcS
  · rw [Nat.card_congr e.toEquiv, card_alt7] at hcS
    exact absurd hcS (by norm_num)

theorem Bad.of_pPrimeCore_eq_bot {M : Type} [Group M] (hO : pPrimeCore 2 M = ⊥)
    (h : Bad (M ⧸ pPrimeCore 2 M)) : Bad M :=
  Bad.of_mulEquiv ((QuotientGroup.quotientMulEquivOfEq hO).trans QuotientGroup.quotientBot) h

theorem false_of_central
    (hG : Generic.GenericKnownFacts) (hF : E2.E2ComponentFacts)
    {L : Subgroup Z} (hL : InC2 ↥L) (hL4 : Gen4Comp ↥L) {s : Z}
    (hcen : ∀ l ∈ L, s * l = l * s) (M : Subgroup ↥(L ⊓ centralizer ({s} : Set Z)))
    (hM : M.IsSubnormal) (hbad : Bad (↥M ⧸ pPrimeCore 2 ↥M)) : False := by
  have hLC : L ≤ centralizer ({s} : Set Z) := fun l hl =>
    Subgroup.mem_centralizer_singleton_iff.mpr (hcen l hl).symm
  have hT : L ⊓ centralizer ({s} : Set Z) = L := inf_eq_left.mpr hLC
  let eT : ↥(L ⊓ centralizer ({s} : Set Z)) ≃* ↥L := MulEquiv.subgroupCongr hT
  have hqT : IsQuasisimple ↥(L ⊓ centralizer ({s} : Set Z)) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv eT.symm hL.1
  rcases isSubnormal_eq_top_or_le_center hqT hM with hMtop | hMc
  ·
    let eM : ↥M ≃* ↥(L ⊓ centralizer ({s} : Set Z)) :=
      (MulEquiv.subgroupCongr hMtop).trans Subgroup.topEquiv
    let eML : ↥M ≃* ↥L := eM.trans eT
    have hZ2 : IsPGroup 2 ↥(center ↥L) := by
      have h := hL.2.1
      rw [h]
      exact CFSG.pCore_isPGroup
    have hOL : pPrimeCore 2 ↥L = ⊥ := quasisimple_pPrimeCore_eq_bot hL.1 hZ2
    have hOM : pPrimeCore 2 ↥M = ⊥ := by
      have h1 := pPrimeCore_map_iso 2 eML
      rw [hOL] at h1
      exact (Subgroup.map_eq_bot_iff_of_injective _ eML.injective).1 h1
    have hBM : Bad ↥M := Bad.of_pPrimeCore_eq_bot hOM hbad
    have hBL : Bad ↥L := Bad.of_mulEquiv eML hBM
    have hU : InU2 ↥L := Bad.toInU2 hBL
    obtain ⟨p, f, hp, hf, hfm, hL2⟩ :=
      PumpClass.c2_u2_fm9 hG hF hL4 hL hU (Bad.not_isL34Quotient hBL)
    have hcardL : Nat.card ↥L = ordA 1 (p ^ f) := card_of_lieModel_PSL (n := 2) (by norm_num) hL2
    have hodd : Odd (p ^ f) := isFM9_odd hfm
    rcases hBL with ⟨p', f', hp', hf', ⟨hodd', hnfm⟩, hL2'⟩ | ⟨⟨e⟩⟩
    · have hcardL' : Nat.card ↥L = ordA 1 (p' ^ f') :=
        card_of_lieModel_PSL (n := 2) (by norm_num) hL2'
      have := ordA_one_inj hodd hodd' (hcardL.symm.trans hcardL')
      exact hnfm (this ▸ hfm)
    · rw [Nat.card_congr e.toEquiv, card_alt7] at hcardL
      exact ordA_one_ne_2520 hodd hcardL.symm
  ·
    obtain ⟨a, b, hab⟩ := Bad.nonabelian hbad
    obtain ⟨a', rfl⟩ := QuotientGroup.mk_surjective a
    obtain ⟨b', rfl⟩ := QuotientGroup.mk_surjective b
    apply hab
    have h1 : ((a' : ↥(L ⊓ centralizer ({s} : Set Z))) * (b' : ↥(L ⊓ centralizer ({s} : Set Z)))) =
        (b' : ↥(L ⊓ centralizer ({s} : Set Z))) * a' :=
      (Subgroup.mem_center_iff.1 (hMc a'.2) b').symm
    have h2 : a' * b' = b' * a' := Subtype.ext h1
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, h2]

end Central

section ConjAut

variable {Z : Type} [Group Z]

theorem conjAut_apply' {L : Subgroup Z} {s : Z} (hss : s * s = 1) (hsN : s ∈ normalizer (L : Set Z))
    (l : ↥L) : ((conjAut hsN l : ↥L) : Z) = s * l * s := by
  have hsinv : s⁻¹ = s := (eq_inv_of_mul_eq_one_left hss).symm
  show s * (l : Z) * s⁻¹ = _
  rw [hsinv]

theorem conjAut_involutive {L : Subgroup Z} {s : Z} (hss : s * s = 1)
    (hsN : s ∈ normalizer (L : Set Z)) (l : ↥L) : conjAut hsN (conjAut hsN l) = l := by
  apply Subtype.ext
  rw [conjAut_apply' hss hsN, conjAut_apply' hss hsN]
  calc s * (s * (l : Z) * s) * s = (s * s) * (l : Z) * (s * s) := by group
    _ = l := by rw [hss]; group

theorem conjAut_ne_one {L : Subgroup Z} {s : Z} (hss : s * s = 1)
    (hsN : s ∈ normalizer (L : Set Z)) (hnc : ¬ ∀ l ∈ L, s * l = l * s) :
    ∃ l : ↥L, conjAut hsN l ≠ l := by
  push Not at hnc
  obtain ⟨l, hl, hne⟩ := hnc
  refine ⟨⟨l, hl⟩, fun h => hne ?_⟩
  have := congrArg Subtype.val h
  rw [conjAut_apply' hss hsN] at this
  calc s * l = (s * l * s) * s := by rw [mul_assoc, mul_assoc, hss, mul_one]
    _ = l * s := by rw [show s * l * s = l from this]

theorem conjAut_fixed {L : Subgroup Z} {s : Z} (hss : s * s = 1)
    (hsN : s ∈ normalizer (L : Set Z)) (x : ↥(L ⊓ centralizer ({s} : Set Z))) :
    conjAut hsN (Subgroup.inclusion (inf_le_left : L ⊓ centralizer ({s} : Set Z) ≤ L) x) =
      Subgroup.inclusion (inf_le_left : L ⊓ centralizer ({s} : Set Z) ≤ L) x := by
  apply Subtype.ext
  rw [conjAut_apply' hss hsN]
  have hx : (x : Z) * s = s * x := Subgroup.mem_centralizer_singleton_iff.mp x.2.2
  show s * (x : Z) * s = x
  rw [← hx, mul_assoc, hss, mul_one]

end ConjAut

section Noncentral

variable {Z : Type} [Group Z] [Finite Z]

theorem false_of_fm9_noncentral
    {L : Subgroup Z} (hfm : HasL2Model ↥L IsFM9) {s : Z} (hss : s * s = 1)
    (hsN : s ∈ normalizer (L : Set Z)) (hnc : ¬ ∀ l ∈ L, s * l = l * s)
    (M : Subgroup ↥(L ⊓ centralizer ({s} : Set Z))) (hbad : Bad (↥M ⧸ pPrimeCore 2 ↥M)) : False := by
  have hF : ∀ l ∈ fixedSubgroup ↥L (conjAut hsN), (conjAut hsN) l = l := fun l hl => hl
  have hsolv := PumpL2.solvable_of_fixed_fm9 hfm (conjAut hsN) (conjAut_involutive hss hsN)
    (conjAut_ne_one hss hsN hnc) (fixedSubgroup ↥L (conjAut hsN)) hF
  let ψ : ↥(L ⊓ centralizer ({s} : Set Z)) →* ↥(fixedSubgroup ↥L (conjAut hsN)) :=
    (Subgroup.inclusion (inf_le_left : L ⊓ centralizer ({s} : Set Z) ≤ L)).codRestrict
      (fixedSubgroup ↥L (conjAut hsN)) (fun x => conjAut_fixed hss hsN x)
  have hψ : Function.Injective ψ := by
    intro a b hab
    have := congrArg (fun y : ↥(fixedSubgroup ↥L (conjAut hsN)) => (y : ↥L)) hab
    exact Subgroup.inclusion_injective _ this
  have hT : Group.IsSolvable ↥(L ⊓ centralizer ({s} : Set Z)) :=
    Group.isSolvable_of_isSolvable_injective hψ
  have hMs : Group.IsSolvable ↥M := Group.isSolvable_of_isSolvable_injective M.subtype_injective
  have hMb : Group.IsSolvable (↥M ⧸ pPrimeCore 2 ↥M) :=
    Group.isSolvable_of_surjective (QuotientGroup.mk'_surjective (pPrimeCore 2 ↥M))
  exact Bad.not_solvable hbad hMb

end Noncentral

section Shapes

variable {Z : Type} [Group Z] [Finite Z]

theorem false_of_shapes7_noncentral
    (hLB : Prop27LocalBalance) (hP : PumpUpData)
    {L : Subgroup Z} (hL : InC2 ↥L) (hS : Shapes7 ↥L) {s : Z} (hss : s * s = 1)
    (hsN : s ∈ normalizer (L : Set Z)) (hnc : ¬ ∀ l ∈ L, s * l = l * s)
    (M : Subgroup ↥(L ⊓ centralizer ({s} : Set Z))) (hM : M.IsSubnormal)
    (hbad : Bad (↥M ⧸ pPrimeCore 2 ↥M)) : False := by
  have hLY : L ≤ L ⊔ zpowers s := le_sup_left
  have hsY : s ∈ L ⊔ zpowers s := Subgroup.mem_sup_right (Subgroup.mem_zpowers s)
  have hY₀N : L ⊔ zpowers s ≤ normalizer (L : Set Z) :=
    sup_le Subgroup.le_normalizer ((Subgroup.zpowers_le).2 hsN)
  have hKn : (L.subgroupOf (L ⊔ zpowers s)).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hLY).2 hY₀N
  let eLY : ↥(L.subgroupOf (L ⊔ zpowers s)) ≃* ↥L := Subgroup.subgroupOfEquivOfLe hLY
  have hqK : IsQuasisimple ↥(L.subgroupOf (L ⊔ zpowers s)) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv eLY.symm hL.1
  have hSK : Shapes7 ↥(L.subgroupOf (L ⊔ zpowers s)) := Iv102.shapes7_of_mulEquiv eLY.symm hS
  have hZ2L : IsPGroup 2 ↥(center ↥L) := by
    have h := hL.2.1
    rw [h]
    exact CFSG.pCore_isPGroup
  have hZ2K : IsPGroup 2 ↥(center ↥(L.subgroupOf (L ⊔ zpowers s))) :=
    hZ2L.of_injective (Subgroup.centerCongr eLY).toMonoidHom (Subgroup.centerCongr eLY).injective
  have hZc : Nat.card (center ↥(L.subgroupOf (L ⊔ zpowers s))) ≤ 2 :=
    Shapes7.card_center_le_two hSK
  have hZY := center_component_central (K := L.subgroupOf (L ⊔ zpowers s)) hZc
  have hLBK := locBal2_of_shapes7 hLB hSK
  have hs1 : s ≠ 1 := by
    intro h
    apply hnc
    intro l _
    rw [h, one_mul, mul_one]
  have hs2 : orderOf s = 2 := orderOf_eq_prime (by rw [sq]; exact hss) hs1
  let v : ↥(L ⊔ zpowers s) := ⟨s, hsY⟩
  have hv2 : orderOf v = 2 := by rw [Subgroup.orderOf_mk]; exact hs2
  have hcent := component_centralized (L.subgroupOf (L ⊔ zpowers s)) hqK hZ2K hZY hLBK hv2
  have hW : pPrimeCoreOf 2 (L ⊓ centralizer ({s} : Set Z)) = ⊥ := by
    refine eq_bot_iff.2 fun w hw => ?_
    rw [Subgroup.mem_bot]
    have hwT : w ∈ L ⊓ centralizer ({s} : Set Z) :=
      TwoThin.pPrimeCoreOf_le (L ⊓ centralizer ({s} : Set Z)) hw
    have hwL : w ∈ L := hwT.1
    have hwY : w ∈ L ⊔ zpowers s := hLY hwL
    have hWle : pPrimeCoreOf 2 (L ⊓ centralizer ({s} : Set Z)) ≤ L ⊔ zpowers s :=
      (TwoThin.pPrimeCoreOf_le _).trans (inf_le_left.trans hLY)
    have hWC : (pPrimeCoreOf 2 (L ⊓ centralizer ({s} : Set Z))).subgroupOf (L ⊔ zpowers s) ≤
        centralizer ({v} : Set ↥(L ⊔ zpowers s)) := by
      intro x hx
      have hx1 : (x : Z) ∈ pPrimeCoreOf 2 (L ⊓ centralizer ({s} : Set Z)) :=
        Subgroup.mem_subgroupOf.mp hx
      have hx2 : (x : Z) ∈ centralizer ({s} : Set Z) := (TwoThin.pPrimeCoreOf_le _ hx1).2
      rw [Subgroup.mem_centralizer_singleton_iff]
      exact Subtype.ext (Subgroup.mem_centralizer_singleton_iff.mp hx2)
    have hWn : ∀ c ∈ centralizer ({v} : Set ↥(L ⊔ zpowers s)),
        ∀ x ∈ (pPrimeCoreOf 2 (L ⊓ centralizer ({s} : Set Z))).subgroupOf (L ⊔ zpowers s),
        c * x * c⁻¹ ∈ (pPrimeCoreOf 2 (L ⊓ centralizer ({s} : Set Z))).subgroupOf (L ⊔ zpowers s) := by
      intro c hc x hx
      have hcs : (c : Z) * s = s * c := by
        have := Subgroup.mem_centralizer_singleton_iff.mp hc
        exact congrArg Subtype.val this
      have hcL : (c : Z) ∈ normalizer (L : Set Z) := hY₀N c.2
      have hcN : (c : Z) ∈ normalizer ((L ⊓ centralizer ({s} : Set Z) : Subgroup Z) : Set Z) := by
        rw [Subgroup.mem_normalizer_iff]
        intro h
        have hcsc : (c : Z) * s * (c : Z)⁻¹ = s := by
          rw [hcs]; group
        have hconj : ∀ g : Z, g ∈ centralizer ({s} : Set Z) ↔
            (c : Z) * g * (c : Z)⁻¹ ∈ centralizer ({s} : Set Z) := by
          intro g
          rw [Subgroup.mem_centralizer_singleton_iff, Subgroup.mem_centralizer_singleton_iff]
          constructor
          · intro hg
            calc (c : Z) * g * (c : Z)⁻¹ * s = (c : Z) * g * (c : Z)⁻¹ * ((c : Z) * s * (c : Z)⁻¹) := by
                  rw [hcsc]
              _ = (c : Z) * (g * s) * (c : Z)⁻¹ := by group
              _ = (c : Z) * (s * g) * (c : Z)⁻¹ := by rw [hg]
              _ = ((c : Z) * s * (c : Z)⁻¹) * ((c : Z) * g * (c : Z)⁻¹) := by group
              _ = s * ((c : Z) * g * (c : Z)⁻¹) := by rw [hcsc]
          · intro hg
            have h1 : (c : Z) * (g * s) * (c : Z)⁻¹ = (c : Z) * (s * g) * (c : Z)⁻¹ := by
              calc (c : Z) * (g * s) * (c : Z)⁻¹
                  = ((c : Z) * g * (c : Z)⁻¹) * ((c : Z) * s * (c : Z)⁻¹) := by group
                _ = ((c : Z) * g * (c : Z)⁻¹) * s := by rw [hcsc]
                _ = s * ((c : Z) * g * (c : Z)⁻¹) := hg
                _ = ((c : Z) * s * (c : Z)⁻¹) * ((c : Z) * g * (c : Z)⁻¹) := by rw [hcsc]
                _ = (c : Z) * (s * g) * (c : Z)⁻¹ := by group
            exact mul_left_cancel (mul_right_cancel h1)
        constructor
        · intro hh
          exact ⟨(Subgroup.mem_normalizer_iff.mp hcL h).mp hh.1, (hconj h).mp hh.2⟩
        · intro hh
          exact ⟨(Subgroup.mem_normalizer_iff.mp hcL h).mpr hh.1, (hconj h).mpr hh.2⟩
      have hx1 : (x : Z) ∈ pPrimeCoreOf 2 (L ⊓ centralizer ({s} : Set Z)) :=
        Subgroup.mem_subgroupOf.mp hx
      exact Subgroup.mem_subgroupOf.mpr
        (TwoThin.mul_mem_pPrimeCoreOf_of_mem_normalizer hcN hx1)
    have hWodd : Odd (Nat.card
        ↥((pPrimeCoreOf 2 (L ⊓ centralizer ({s} : Set Z))).subgroupOf (L ⊔ zpowers s))) := by
      rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hWle).toEquiv]
      exact TwoThin.card_pPrimeCoreOf_odd _
    have hwO : (⟨w, hwY⟩ : ↥(L ⊔ zpowers s)) ∈ involutionOddCore v :=
      le_involutionOddCore_of_normalized hWC hWn hWodd (Subgroup.mem_subgroupOf.mpr hw)
    have hwcen : (⟨w, hwL⟩ : ↥L) ∈ center ↥L := by
      rw [Subgroup.mem_center_iff]
      intro g
      have := hcent _ hwO ⟨g, hLY g.2⟩ (Subgroup.mem_subgroupOf.mpr g.2)
      exact Subtype.ext (congrArg Subtype.val this).symm
    have hodd : Odd (orderOf w) :=
      Odd.of_dvd_nat (TwoThin.card_pPrimeCoreOf_odd _) (Subgroup.orderOf_dvd_natCard _ hw)
    obtain ⟨n, hn⟩ := hZ2L ⟨⟨w, hwL⟩, hwcen⟩
    have hwn : w ^ (2 ^ n) = 1 := by
      have := congrArg (fun y : ↥(center ↥L) => (((y : ↥L)) : Z)) hn
      simpa using this
    exact eq_one_of_pow_two_pow hodd hwn
  have hOT : pPrimeCore 2 ↥(L ⊓ centralizer ({s} : Set Z)) = ⊥ :=
    (Subgroup.map_eq_bot_iff_of_injective _ (Subgroup.subtype_injective _)).1 hW
  have hOM : pPrimeCore 2 ↥M = ⊥ := by
    have h1 := CFSG.Walter.map_pPrimeCore_le_of_isSubnormal hM
    rw [hOT, le_bot_iff] at h1
    exact (Subgroup.map_eq_bot_iff_of_injective _ (Subgroup.subtype_injective _)).1 h1
  have hBM : Bad ↥M := Bad.of_pPrimeCore_eq_bot hOM hbad
  have hMs : IsSimpleGroup ↥M := Bad.simple hBM
  obtain ⟨hqM, -⟩ := CFSG.LocalCores.isQuasisimple_of_isSimpleGroup (Q := ↥M) (Bad.nonabelian hBM)
  let incl : ↥(L ⊓ centralizer ({s} : Set Z)) →* ↥L :=
    Subgroup.inclusion (inf_le_left : L ⊓ centralizer ({s} : Set Z) ≤ L)
  have hincl : Function.Injective incl := Subgroup.inclusion_injective _
  let M'' : Subgroup ↥L := M.map incl
  have hfix : ∀ x ∈ M'', (conjAut hsN) x = x := by
    rintro _ ⟨y, -, rfl⟩
    exact conjAut_fixed hss hsN y
  have hqM'' : IsQuasisimple ↥M'' :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv (M.equivMapOfInjective incl hincl) hqM
  have hσ2 : (conjAut hsN) ^ 2 = 1 := by
    ext l
    simp only [pow_two, MulAut.mul_apply, MulAut.one_apply]
    exact congrArg (fun y : ↥L => (y : Z)) (conjAut_involutive hss hsN l)
  have hσ1 : (conjAut hsN) ≠ 1 := by
    intro h
    obtain ⟨l, hl⟩ := conjAut_ne_one hss hsN hnc
    apply hl
    have := DFunLike.congr_fun h l
    simpa using this
  have hcard := hP.card_quasisimple_fixed ↥L (k0Shape_of_shapes7 hS) (conjAut hsN) hσ2 hσ1 M'' hfix hqM''
  have hcardM : Nat.card ↥M'' = Nat.card (↥M ⧸ pPrimeCore 2 ↥M) := by
    rw [Nat.card_congr (M.equivMapOfInjective incl hincl).symm.toEquiv,
      Nat.card_congr ((QuotientGroup.quotientMulEquivOfEq hOM).trans
        QuotientGroup.quotientBot).toEquiv]
  obtain ⟨h60, h120⟩ := Bad.card_ne hbad
  rw [hcardM] at hcard
  rcases hcard with h | h
  · exact h60 h
  · exact h120 h

end Shapes

section Top

variable {Z : Type} [Group Z] [Finite Z]

theorem false_of_c2g
    (hG : Generic.GenericKnownFacts) (hF : E2.E2ComponentFacts)
    (hLB : Prop27LocalBalance) (hP : PumpUpData)
    {L : Subgroup Z} (hL : InC2 ↥L) (hL4 : Gen4Comp ↥L) {s : Z} (hss : s * s = 1)
    (hsN : s ∈ normalizer (L : Set Z)) (M : Subgroup ↥(L ⊓ centralizer ({s} : Set Z)))
    (hM : M.IsSubnormal) (hbad : Bad (↥M ⧸ pPrimeCore 2 ↥M)) : False := by
  by_cases hcen : ∀ l ∈ L, s * l = l * s
  · exact false_of_central hG hF hL hL4 hcen M hM hbad
  · rcases c2Shape_of_inC2 hG hF hL hL4 with ⟨hz, hsimple⟩ | h2m | h2s
    · rcases hsimple with ⟨p, f, hp, -, hfm, hL2⟩ | h28 | h33 | hU | hSz | hM11
      · exact false_of_fm9_noncentral
          ⟨p, f, hp, (Generic.stated_of_lieModel_PSL hL2).1.2.1, hfm, hL2⟩ hss hsN hcen M hbad
      · exact false_of_shapes7_noncentral hLB hP hL (Or.inl ⟨hz, Or.inl h28⟩) hss hsN hcen M hM hbad
      · exact false_of_shapes7_noncentral hLB hP hL
          (Or.inl ⟨hz, Or.inr (Or.inl h33)⟩) hss hsN hcen M hM hbad
      · exact false_of_shapes7_noncentral hLB hP hL
          (Or.inl ⟨hz, Or.inr (Or.inr (Or.inl hU))⟩) hss hsN hcen M hM hbad
      · exact false_of_shapes7_noncentral hLB hP hL
          (Or.inl ⟨hz, Or.inr (Or.inr (Or.inr (Or.inl hSz)))⟩) hss hsN hcen M hM hbad
      · exact false_of_shapes7_noncentral hLB hP hL
          (Or.inl ⟨hz, Or.inr (Or.inr (Or.inr (Or.inr hM11)))⟩) hss hsN hcen M hM hbad
    · exact false_of_shapes7_noncentral hLB hP hL (Or.inr (Or.inl h2m)) hss hsN hcen M hM hbad
    · exact false_of_shapes7_noncentral hLB hP hL (Or.inr (Or.inr h2s)) hss hsN hcen M hM hbad

end Top

