section Utilities

theorem isSubnormal_eq_top_or_le_center {Q : Type*} [Group Q] (hq : IsQuasisimple Q)
    {H : Subgroup Q} (hH : H.IsSubnormal) : H = ⊤ ∨ H ≤ center Q := by
  induction hH with
  | top => exact Or.inl rfl
  | step H K hle hK hN ih =>
    rcases ih with rfl | hKc
    · have hHn : H.Normal := by
        refine ⟨fun n hn g => ?_⟩
        have := (Subgroup.normal_subgroupOf_iff (H := H) (K := ⊤) hle).1 hN n g hn (Subgroup.mem_top g)
        exact this
      exact CFSG.LocalCores.quasisimple_normal_subgroups hq hHn
    · exact Or.inr (hle.trans hKc)

theorem quasisimple_pPrimeCore_eq_bot {Q : Type} [Group Q] [Finite Q] (hq : IsQuasisimple Q)
    (hZ : IsPGroup 2 ↥(center Q)) : pPrimeCore 2 Q = ⊥ := by
  have hn : (pPrimeCore 2 Q).Normal := inferInstance
  have hodd : Odd (Nat.card (pPrimeCore 2 Q)) := Nat.coprime_two_left.mp pPrimeCore_coprime_card
  rcases CFSG.LocalCores.quasisimple_normal_subgroups hq hn with h | h
  · exfalso
    have h1 : Nat.card (pPrimeCore 2 Q) = Nat.card Q := by rw [h]; exact Subgroup.card_top
    have h2 := even_card_of_quasisimple hq
    rw [← h1] at h2
    exact (Nat.not_even_iff_odd.mpr hodd) h2
  · have hP : IsPGroup 2 ↥(pPrimeCore 2 Q) :=
      hZ.of_injective (Subgroup.inclusion h) (Subgroup.inclusion_injective h)
    ext x
    simp only [Subgroup.mem_bot]
    constructor
    · intro hx
      have := eq_one_of_isPGroup_two_of_odd hP hodd ⟨x, hx⟩
      exact congrArg Subtype.val this
    · rintro rfl; exact Subgroup.one_mem _

end Utilities

section BadLemmas

abbrev Bad (S : Type) [Group S] : Prop :=
  HasL2Model S (fun q => Odd q ∧ ¬ IsFM9 q) ∨ Nonempty (S ≃* alternatingGroup (Fin 7))

theorem card_alt7 : Nat.card (alternatingGroup (Fin 7)) = 2520 := by
  rw [Nat.card_eq_fintype_card, card_alternatingGroup, Fintype.card_fin]
  decide

theorem ordA_one_not_prime {q : ℕ} (hq : Odd q) : ¬ (ordA 1 q).Prime := by
  obtain ⟨k, rfl⟩ := hq
  rw [ordA_one_odd]
  intro hp
  have h2 : 2 ∣ 2 * k * (k + 1) * (2 * k + 1) := ⟨k * (k + 1) * (2 * k + 1), by ring⟩
  have h := (Nat.prime_dvd_prime_iff_eq Nat.prime_two hp).mp h2
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · omega
  · have : 2 * 1 * (1 + 1) * (2 * 1 + 1) ≤ 2 * k * (k + 1) * (2 * k + 1) := by gcongr <;> omega
    omega

theorem Bad.simple
    {S : Type} [Group S] (h : Bad S) : IsSimpleGroup S := by
  rcases h with ⟨p, f, hp, hf, hP, hL⟩ | ⟨⟨e⟩⟩
  · exact (CFSG.LieType.Catalog.lieModel_finite_simple _ _ _ _ _ hL).2.2
  · have : IsSimpleGroup (alternatingGroup (Fin 7)) := alternatingGroup.isSimpleGroup (by simp)
    exact e.isSimpleGroup

theorem Bad.nonabelian
    {S : Type} [Group S] (h : Bad S) : ∃ a b : S, a * b ≠ b * a := by
  have hsimple : IsSimpleGroup S := Bad.simple h
  by_contra hc
  push Not at hc
  have hcomm : ∀ a b : S, a * b = b * a := hc
  have : IsMulCommutative S := ⟨⟨hcomm⟩⟩
  have hprime := hsimple.prime_card
  rcases h with ⟨p, f, hp, hf, ⟨hodd, hfm⟩, hL⟩ | ⟨⟨e⟩⟩
  · rw [card_of_lieModel_PSL (n := 2) (by norm_num) hL] at hprime
    exact ordA_one_not_prime hodd hprime
  · rw [Nat.card_congr e.toEquiv, card_alt7] at hprime
    exact absurd hprime (by norm_num)

theorem Bad.not_solvable
    {S : Type} [Group S] (h : Bad S) : ¬ Group.IsSolvable S := by
  have := Bad.simple h
  intro hs
  obtain ⟨a, b, hab⟩ := h.nonabelian
  exact hab ((IsSimpleGroup.comm_iff_isSolvable (G := S)).2 hs a b)

theorem Bad.of_mulEquiv {S S' : Type} [Group S] [Group S'] (e : S ≃* S') (h : Bad S) : Bad S' := by
  rcases h with h | ⟨⟨f⟩⟩
  · exact Or.inl (hasL2Model_of_mulEquiv e h)
  · exact Or.inr ⟨e.symm.trans f⟩

theorem Bad.card_ne {S : Type} [Group S] (h : Bad S) : Nat.card S ≠ 60 ∧ Nat.card S ≠ 120 := by
  rcases h with ⟨p, f, hp, hf, ⟨hodd, hfm⟩, hL⟩ | ⟨⟨e⟩⟩
  · rw [card_of_lieModel_PSL (n := 2) (by norm_num) hL]
    obtain ⟨k, hk⟩ := hodd
    rw [hk, ordA_one_odd]
    constructor
    · intro h60
      have hk3 : k ≤ 3 := by
        by_contra hk3
        have : 2 * 4 * (4 + 1) * (2 * 4 + 1) ≤ 2 * k * (k + 1) * (2 * k + 1) := by gcongr <;> omega
        omega
      interval_cases k
      · omega
      · omega
      · exact hfm (by rw [hk]; right; exact ⟨by norm_num, Or.inl ⟨1, by norm_num⟩⟩)
      · omega
    · intro h120
      have hk3 : k ≤ 3 := by
        by_contra hk3
        have : 2 * 4 * (4 + 1) * (2 * 4 + 1) ≤ 2 * k * (k + 1) * (2 * k + 1) := by gcongr <;> omega
        omega
      interval_cases k <;> omega
  · rw [Nat.card_congr e.toEquiv, card_alt7]
    exact ⟨by norm_num, by norm_num⟩


theorem ordA_one_strictMono : StrictMono (fun k : ℕ => 2 * k * (k + 1) * (2 * k + 1)) := by
  apply strictMono_nat_of_lt_succ
  intro n
  show 2 * n * (n + 1) * (2 * n + 1) < 2 * (n + 1) * (n + 1 + 1) * (2 * (n + 1) + 1)
  nlinarith [Nat.zero_le n, sq_nonneg n]

theorem ordA_one_inj {q q' : ℕ} (hq : Odd q) (hq' : Odd q') (h : ordA 1 q = ordA 1 q') : q = q' := by
  obtain ⟨k, rfl⟩ := hq
  obtain ⟨k', rfl⟩ := hq'
  rw [ordA_one_odd, ordA_one_odd] at h
  have := ordA_one_strictMono.injective h
  omega

theorem ordA_one_ne_2520 {q : ℕ} (hq : Odd q) : ordA 1 q ≠ 2520 := by
  obtain ⟨k, rfl⟩ := hq
  rw [ordA_one_odd]
  intro h
  have hk : k ≤ 10 := by
    by_contra hk
    have : 2 * 11 * (11 + 1) * (2 * 11 + 1) ≤ 2 * k * (k + 1) * (2 * k + 1) := by gcongr <;> omega
    omega
  interval_cases k <;> omega

theorem ordA_one_ne_20160 {q : ℕ} (hq : Odd q) : ordA 1 q ≠ 20160 := by
  obtain ⟨k, rfl⟩ := hq
  rw [ordA_one_odd]
  intro h
  have hk : k ≤ 20 := by
    by_contra hk
    have : 2 * 21 * (21 + 1) * (2 * 21 + 1) ≤ 2 * k * (k + 1) * (2 * k + 1) := by gcongr <;> omega
    omega
  interval_cases k <;> omega

end BadLemmas

