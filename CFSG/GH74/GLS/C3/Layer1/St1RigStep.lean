variable {G : Type} [Group G] [Finite G]

theorem step_core {x t : G} {K K' : Subgroup G} (hlt : PumpUpLT 2 x K t K')
    (hxY : x ∈ centralizer ({t} : Set G)) :
    ∃ Λ : Subgroup G, IsLam x t K Λ ∧ IsPCompIn 2 (centralizer ({t} : Set G)) K' ∧
      (∃ L : Subgroup (barQ ↥(centralizer ({t} : Set G))), CFSG.IsComponent L ∧
        (bar t K' = L ∨ bar t K' = conjSub (sbar x hxY)⁻¹ L) ∧
        ((conjSub (sbar x hxY)⁻¹ L = L ∧ bar t Λ ≤ L) ∨
          (conjSub (sbar x hxY)⁻¹ L ≠ L ∧ ∃ hAB : ⁅L, conjSub (sbar x hxY)⁻¹ L⁆ = ⊥,
            bar t Λ ≤ (swapDiag hAB).range))) ∧
      hatCard K ≤ Nat.card ↥(bar t Λ) ∧ Nat.card ↥(bar t Λ) ≤ hatCard K' ∧
      (Nat.card ↥(bar t Λ) ≤ hatCard K →
        Nonempty (kBar K ≃* ↥(bar t Λ)) ∧
        (∀ (a : G) (haY : a ∈ centralizer ({t} : Set G)), a ∈ pPrimeCoreOf 2 Λ →
          barMk ↥(centralizer ({t} : Set G)) ⟨a, haY⟩ = 1) ∧
        ∀ (q : G) (hq : q ∈ centralizer ({t} : Set G)), q ∈ CxK x K →
          ∀ w ∈ bar t Λ, sbar q hq * w * (sbar q hq)⁻¹ = w) := by
  have hxo : orderOf x = 2 := hlt.1.1
  have hto : orderOf t = 2 := hlt.2.1.1
  have hKc : IsPCompIn 2 (centralizer ({x} : Set G)) K := hlt.1.2.2
  have htK : t ∈ centralizerSection K (pPrimeCoreOf 2 K) := hlt.2.2.2.1
  have hK'p : IsPCompIn 2 (pumpUp 2 K t) K' := hlt.2.2.2.2
  obtain ⟨Λ, hΛ⟩ := exists_isLam (z := x) hto hKc htK
  set Y' := centralizer ({t} : Set G) with hY'
  have hso : orderOf (⟨x, hxY⟩ : ↥Y') = 2 := orderOf_mk_centralizer hxY hxo
  have hΛC := le_centralizer_mk (isPCompIn_two_iff.mp hΛ.pcW).1 hxY
  have hΛ2 := isTwoComponent_centralizer_mk hΛ.pcW hxY
  obtain ⟨hΛE, hJsub, L, hL, hcases, hLJ, hLsJ, hiff⟩ := pumpupY_structure hso hΛC hΛ2
  obtain ⟨hK'2, hK'J⟩ := isTwoComponent_of_isPCompIn_pumpUp hΛ.layer hΛE hK'p
  have himg := (hiff _ hK'2).mp hK'J
  have hΛK : Λ ≤ K := hΛ.le.trans inf_le_left
  have hΛY : Λ ≤ Y' := hΛ.le.trans inf_le_right
  obtain ⟨φ, hφs, hφo, hφρ⟩ := exists_phi hΛK hΛY hΛ.cover
  have hKI : hatCard K ≤ Nat.card ↥(bar t Λ) := Nat.card_le_card_of_surjective φ hφs
  have hK'Y : K' ≤ Y' := hK'p.1.trans (pumpUp_le_centralizer K t)
  have hK'c : IsPCompIn 2 Y' K' := isPCompIn_two_iff.mpr ⟨hK'Y, hK'2⟩
  have hss : sbar x hxY * sbar x hxY = 1 := by
    have h1 := pow_orderOf_eq_one (sbar x hxY)
    rwa [orderOf_sbar hxo hxY, sq] at h1
  obtain ⟨e1⟩ := kBar_equiv_bar hK'c
  have hK'card : hatCard K' = Nat.card ↥(bar t K') := Nat.card_congr e1.toEquiv
  have hL1 : Nat.card ↥(bar t K') = Nat.card ↥L := by
    rcases himg with h | h
    · have h' : bar t K' = L := h
      rw [h']
    · have h' : bar t K' = conjSub (sbar x hxY)⁻¹ L := h
      rw [h', card_conjSub]
  have hIL : Nat.card ↥(bar t Λ) ≤ Nat.card ↥L := by
    rcases hcases with ⟨-, hAL⟩ | ⟨-, hAB, hAD⟩
    · exact Subgroup.card_le_of_le hAL
    · exact (Subgroup.card_le_of_le hAD).trans
        (Nat.card_le_card_of_surjective _ (MonoidHom.rangeRestrict_surjective _))
  have hIK' : Nat.card ↥(bar t Λ) ≤ hatCard K' := hIL.trans (hL1.symm.le.trans hK'card.symm.le)
  refine ⟨Λ, hΛ, hK'c, ⟨L, hL, himg, hcases⟩, hKI, hIK', fun hle => ?_⟩
  have hφb : Function.Bijective φ := hφs.bijective_of_nat_card_le hle
  have hker : ∀ (a : G) (haY : a ∈ centralizer ({t} : Set G)),
      a ∈ pPrimeCoreOf 2 Λ → barMk ↥(centralizer ({t} : Set G)) ⟨a, haY⟩ = 1 := by
    intro a haY hao
    have ha : a ∈ Λ := pPrimeCoreOf_le Λ hao
    have hkh := ker_hatMap_eq_pPrimeCore hΛK hΛ.cover
    have hmem : (⟨a, ha⟩ : ↥Λ) ∈ pPrimeCore 2 ↥Λ := by
      obtain ⟨o, ho, hoa⟩ := hao
      have : o = ⟨a, ha⟩ := Subtype.ext hoa
      rwa [← this]
    rw [← hkh, MonoidHom.mem_ker] at hmem
    have h2 := hφρ a ha
    rw [hmem] at h2
    have h3 : (⟨barMk ↥Y' ⟨a, hΛY ha⟩, ⟨⟨a, hΛY ha⟩, Subgroup.mem_subgroupOf.mpr ha, rfl⟩⟩ :
        ↥(bar t Λ)) = 1 := hφb.1 (h2.trans (map_one φ).symm)
    exact congrArg Subtype.val h3
  refine ⟨⟨(MulEquiv.ofBijective φ hφb).symm⟩, hker, ?_⟩
  intro q hq hqC w hw
  have hqs : q ∈ centralizerSection K (pPrimeCoreOf 2 K) := hqC.2
  have hqX : q ∈ normalizer ((K ⊓ Y' : Subgroup G) : Set G) :=
    TwoThin.mem_normalizer_inf hqs.1 (Subgroup.le_normalizer hq)
  have hΛq : ∀ a ∈ Λ, q * a * q⁻¹ ∈ Λ := fun a ha =>
    conj_mem_of_unique_isPCompIn hΛ.pc hΛ.uniq hqX ha
  have hstar : ∀ (a : G) (ha : a ∈ Λ), barMk ↥Y' (⟨q, hq⟩ * ⟨a, hΛY ha⟩ * ⟨q, hq⟩⁻¹) =
      barMk ↥Y' ⟨a, hΛY ha⟩ := by
    intro a ha
    have haq : q * a * q⁻¹ ∈ Λ := hΛq a ha
    have hbΛ : q * a * q⁻¹ * a⁻¹ ∈ Λ := mul_mem haq (inv_mem ha)
    have hbO : q * a * q⁻¹ * a⁻¹ ∈ pPrimeCoreOf 2 K := by
      have := inv_mem (hqs.2.2 a (hΛK ha))
      simpa [commutatorElement_def, mul_assoc] using this
    have h1 : hatMap hΛK ⟨q * a * q⁻¹ * a⁻¹, hbΛ⟩ = 1 := (hatMap_eq_one_iff hΛK _).mpr hbO
    have h2 := hφρ _ hbΛ
    rw [h1] at h2
    have h3 : (⟨barMk ↥Y' ⟨q * a * q⁻¹ * a⁻¹, hΛY hbΛ⟩,
        ⟨⟨_, hΛY hbΛ⟩, Subgroup.mem_subgroupOf.mpr hbΛ, rfl⟩⟩ : ↥(bar t Λ)) = 1 :=
      hφb.1 (h2.trans (map_one φ).symm)
    have h4 : barMk ↥Y' ⟨q * a * q⁻¹ * a⁻¹, hΛY hbΛ⟩ = 1 := congrArg Subtype.val h3
    have h5 : (⟨q * a * q⁻¹ * a⁻¹, hΛY hbΛ⟩ : ↥Y') =
        ⟨q, hq⟩ * ⟨a, hΛY ha⟩ * ⟨q, hq⟩⁻¹ * ⟨a, hΛY ha⟩⁻¹ := rfl
    rw [h5, map_mul, mul_eq_one_iff_eq_inv, ← map_inv] at h4
    rw [h4]
    simp
  obtain ⟨m, hm, rfl⟩ := hw
  have hmΛ : (m : G) ∈ Λ := Subgroup.mem_subgroupOf.mp hm
  have := hstar m hmΛ
  simpa [sbar, map_mul, map_inv] using this

omit [Finite G] in
theorem card_conjSub {Z : Type} [Group Z] (g : Z) (L : Subgroup Z) :
    Nat.card ↥(conjSub g L) = Nat.card ↥L :=
  Subgroup.card_map_of_injective (MulAut.conj g).injective

omit [Finite G] in
theorem injective_of_card_range_eq {A B : Type} [Group A] [Group B] [Finite A] (f : A →* B)
    (h : Nat.card ↥f.range = Nat.card A) : Function.Injective f := by
  rw [← MonoidHom.ker_eq_bot_iff]
  have h1 := Subgroup.card_eq_card_quotient_mul_card_subgroup f.ker
  rw [Nat.card_congr (QuotientGroup.quotientKerEquivRange f).toEquiv, h] at h1
  have h2 : Nat.card ↥f.ker = 1 := by
    have hpos : 0 < Nat.card A := Nat.card_pos
    have : Nat.card A * Nat.card ↥f.ker = Nat.card A * 1 := by rw [← h1, mul_one]
    exact Nat.eq_of_mul_eq_mul_left hpos this
  exact Subgroup.card_eq_one.mp h2

omit [Finite G] in
theorem range_swapDiag_conj {Z : Type} [Group Z] {L : Subgroup Z} {s : Z} (hss : s * s = 1)
    (hAB : ⁅L, conjSub s⁻¹ L⁆ = ⊥)
    (hAB' : ⁅conjSub s⁻¹ L, conjSub s⁻¹ (conjSub s⁻¹ L)⁆ = ⊥) :
    (swapDiag hAB').range = (swapDiag hAB).range := by
  have hsinv : s⁻¹ = s := inv_eq_of_mul_eq_one_left hss
  have hmem : ∀ c : Z, c ∈ conjSub s⁻¹ L ↔ s * c * s ∈ L := by
    intro c
    rw [TwoThin.mem_conjSub_iff', inv_inv, hsinv]
  have hss3 : ∀ b : Z, s * (s * b * s) * s = b := by
    intro b
    calc s * (s * b * s) * s = (s * s) * b * (s * s) := by group
      _ = b := by rw [hss]; group
  have key : ∀ b : ↥L, ∃ b' : ↥(conjSub s⁻¹ L), (b' : Z) = s * b * s ∧
      swapDiag hAB' b' = swapDiag hAB b := by
    intro b
    have hb' : s * (b : Z) * s ∈ conjSub s⁻¹ L := by
      rw [hmem, hss3]
      exact b.2
    refine ⟨⟨s * b * s, hb'⟩, rfl, ?_⟩
    have hcb : (s * (b : Z) * s) * b = b * (s * b * s) := by
      have h1 : (b : Z) ∈ centralizer ((conjSub s⁻¹ L : Subgroup Z) : Set Z) :=
        Subgroup.commutator_eq_bot_iff_le_centralizer.mp hAB b.2
      exact Subgroup.mem_centralizer_iff.mp h1 (s * b * s) hb'
    rw [swapDiag_apply, swapDiag_apply]
    change s * b * s * (s⁻¹ * (s * b * s) * s) = b * (s⁻¹ * b * s)
    rw [hsinv, hss3, hcb]
  ext z
  constructor
  · rintro ⟨b', rfl⟩
    have hb : s * (b' : Z) * s ∈ L := (hmem b').mp b'.2
    obtain ⟨c, hc1, hc2⟩ := key ⟨s * b' * s, hb⟩
    refine ⟨⟨s * b' * s, hb⟩, ?_⟩
    rw [← hc2]
    have : c = b' := Subtype.ext (by rw [hc1]; exact hss3 b')
    rw [this]
  · rintro ⟨b, rfl⟩
    obtain ⟨c, -, hc⟩ := key b
    exact ⟨c, hc⟩


theorem rigid_step {x t : G} {K K' : Subgroup G} (hlt : PumpUpLT 2 x K t K')
    (hxY : x ∈ centralizer ({t} : Set G)) (hle : hatCard K' ≤ hatCard K) :
    ∃ Λ : Subgroup G, IsLam x t K Λ ∧ IsPCompIn 2 (centralizer ({t} : Set G)) K' ∧
      Nonempty (kBar K ≃* ↥(bar t Λ)) ∧
      (∀ (a : G) (haY : a ∈ centralizer ({t} : Set G)), a ∈ pPrimeCoreOf 2 Λ →
        barMk ↥(centralizer ({t} : Set G)) ⟨a, haY⟩ = 1) ∧
      (∀ (q : G) (hq : q ∈ centralizer ({t} : Set G)), q ∈ CxK x K →
        ∀ w ∈ bar t Λ, sbar q hq * w * (sbar q hq)⁻¹ = w) ∧
      ((x ∈ normalizer (K' : Set G) ∧ bar t Λ = bar t K') ∨
        (x ∉ normalizer (K' : Set G) ∧
          ∃ hAB : ⁅bar t K', conjSub (sbar x hxY)⁻¹ (bar t K')⁆ = ⊥,
            Function.Injective (swapDiag hAB) ∧ bar t Λ = (swapDiag hAB).range)) := by
  obtain ⟨Λ, hΛ, hK'c, ⟨L, hL, himg, hcases⟩, hKI, hIK', hrest⟩ := step_core hlt hxY
  have hxo : orderOf x = 2 := hlt.1.1
  have hs2 : orderOf (sbar x hxY) = 2 := orderOf_sbar hxo hxY
  have hss : sbar x hxY * sbar x hxY = 1 := by
    have := pow_orderOf_eq_one (sbar x hxY)
    rwa [hs2, sq] at this
  have hsinv : (sbar x hxY)⁻¹ = sbar x hxY := inv_eq_of_mul_eq_one_left hss
  obtain ⟨e1⟩ := kBar_equiv_bar hK'c
  have hK'card : hatCard K' = Nat.card ↥(bar t K') := Nat.card_congr e1.toEquiv
  have hL1 : Nat.card ↥(bar t K') = Nat.card ↥L := by
    rcases himg with h | h
    · have h' : bar t K' = L := h
      rw [h']
    · have h' : bar t K' = conjSub (sbar x hxY)⁻¹ L := h
      rw [h', card_conjSub]
  have hIL : Nat.card ↥(bar t Λ) ≤ Nat.card ↥L := by
    rcases hcases with ⟨-, hAL⟩ | ⟨-, hAB, hAD⟩
    · exact Subgroup.card_le_of_le hAL
    · exact (Subgroup.card_le_of_le hAD).trans
        (Nat.card_le_card_of_surjective _ (MonoidHom.rangeRestrict_surjective _))
  have hΛcard : Nat.card ↥(bar t Λ) ≤ hatCard K := hIK'.trans hle
  obtain ⟨hiso, hker, hcent⟩ := hrest hΛcard
  have hLeq : Nat.card ↥L = Nat.card ↥(bar t Λ) :=
    le_antisymm (hL1.symm.le.trans (hK'card.symm.le.trans (hle.trans hKI))) hIL
  refine ⟨Λ, hΛ, hK'c, hiso, hker, hcent, ?_⟩
  have hK'Y : K' ≤ centralizer ({t} : Set G) := hK'c.1
  have hK'2 : TwoComponents.IsTwoComponent (K'.subgroupOf (centralizer ({t} : Set G))) :=
    (isPCompIn_two_iff.mp hK'c).2
  rcases hcases with ⟨hstab, hAL⟩ | ⟨hne, hAB, hAD⟩
  ·
    have hbarK' : bar t K' = L := by
      rcases himg with h | h
      · exact h
      · rw [h, hstab]
    have hstab' : L.map (MulAut.conj (sbar x hxY)).toMonoidHom = L := by
      have := hstab
      rw [hsinv] at this
      exact this
    left
    refine ⟨?_, ?_⟩
    · apply mem_normalizer_of_map_normalizes hK'Y hK'2 hxY
      show (bar t K').map (MulAut.conj (sbar x hxY)).toMonoidHom = bar t K'
      rw [hbarK']
      exact hstab'
    · rw [hbarK']
      exact Subgroup.eq_of_le_of_card_ge hAL hLeq.le
  ·
    have hD : bar t Λ = (swapDiag hAB).range := by
      refine Subgroup.eq_of_le_of_card_ge hAD ?_
      rw [← hLeq]
      exact Nat.card_le_card_of_surjective _ (MonoidHom.rangeRestrict_surjective _)
    have hinj : Function.Injective (swapDiag hAB) := by
      refine injective_of_card_range_eq _ ?_
      rw [← hD, ← hLeq]
    right
    refine ⟨?_, ?_⟩
    · intro hxN
      have h1 := map_conj_bar_of_normalizes (u := t) (X := K') hxY hxN
      apply hne
      rcases himg with h | h
      · rw [h] at h1
        rw [hsinv]
        exact h1
      · rw [h] at h1
        exact ((conjSub_conjSub_inv (sbar x hxY) L).symm.trans h1).symm
    · rcases himg with h | h
      · subst h
        exact ⟨hAB, hinj, hD⟩
      · rw [h]
        have hconj2 : conjSub (sbar x hxY)⁻¹ (conjSub (sbar x hxY)⁻¹ L) = L := by
          have h3 : conjSub (sbar x hxY)⁻¹ (conjSub (sbar x hxY)⁻¹ L) =
              conjSub (sbar x hxY) (conjSub (sbar x hxY)⁻¹ L) :=
            congrArg (fun g => conjSub g (conjSub (sbar x hxY)⁻¹ L)) hsinv
          rw [h3]
          exact conjSub_conjSub_inv _ L
        have hcomm' : ⁅conjSub (sbar x hxY)⁻¹ L, L⁆ = ⊥ := by
          rw [Subgroup.commutator_comm]
          exact hAB
        have hAB1 : ⁅conjSub (sbar x hxY)⁻¹ L, conjSub (sbar x hxY)⁻¹ (conjSub (sbar x hxY)⁻¹ L)⁆
            = ⊥ := by
          rw [hconj2]
          exact hcomm'
        have hrange := range_swapDiag_conj hss hAB hAB1
        refine ⟨hAB1, ?_, ?_⟩
        · refine injective_of_card_range_eq _ ?_
          have h1 : Nat.card ↥(swapDiag hAB1).range = Nat.card ↥(bar t Λ) := by
            rw [hrange, ← hD]
          rw [h1, ← hLeq, card_conjSub]
        · rw [hrange]
          exact hD

theorem hat_le_of_pumpUpLT {x t : G} {K K' : Subgroup G} (hlt : PumpUpLT 2 x K t K') :
    hatCard K ≤ hatCard K' := by
  obtain ⟨Λ, -, -, -, hKI, hIK', -⟩ := step_core hlt (mem_centralizer_symm hlt.2.2.1)
  exact hKI.trans hIK'

theorem hat_equiv_of_pumpUpLT {x t : G} {K K' : Subgroup G} (hlt : PumpUpLT 2 x K t K')
    (hle : hatCard K' ≤ hatCard K) : Nonempty (kBar K' ≃* kBar K) := by
  have hxY : x ∈ centralizer ({t} : Set G) := mem_centralizer_symm hlt.2.2.1
  obtain ⟨Λ, hΛ, hK'c, hiso, -, -, hcases⟩ := rigid_step hlt hxY hle
  obtain ⟨e1⟩ := kBar_equiv_bar hK'c
  obtain ⟨e0⟩ := hiso
  rcases hcases with ⟨-, hD⟩ | ⟨-, hAB, hinj, hD⟩
  · refine ⟨e1.trans ?_ |>.trans e0.symm⟩
    exact MulEquiv.subgroupCongr hD.symm
  · refine ⟨e1.trans ?_ |>.trans e0.symm⟩
    exact (MonoidHom.ofInjective hinj).trans (MulEquiv.subgroupCongr hD.symm)

end Step

