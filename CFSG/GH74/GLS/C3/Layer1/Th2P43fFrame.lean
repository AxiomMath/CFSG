variable {G : Type} [Group G]

structure Frame (x : G) (K T S : Subgroup G) (a z : G) (psi : G → Perm (Fin 7)) : Prop where
  x_sq : x * x = 1
  x_ne : x ≠ 1
  x_mem_T : x ∈ T
  x_mem_CxK : x ∈ CxK x K
  core : Sec4Core a (T ⊓ K) (T ⊓ CxK x K) T S
  T_eq : T = (T ⊓ K) ⊔ conjugate (T ⊓ K) a
  S_cases : ∀ s ∈ S, s ∈ T ∨ a⁻¹ * s ∈ T
  T_le_C : T ≤ centralizer ({x} : Set G)
  K_le : K ≤ centralizer ({x} : Set G)
  K_norm : ∀ c ∈ centralizer ({x} : Set G), ∀ k ∈ K, c * k * c⁻¹ ∈ K
  Q_el : CFSG.IsElementaryAbelian 2 ↥(T ⊓ CxK x K)
  z_mem : z ∈ T ⊓ K
  z_ne : z ≠ 1
  z_sq : z * z = 1
  z_central : ∀ p ∈ T ⊓ K, p * z = z * p
  x_mem : x ∈ conjugate (T ⊓ K) a
  a_x : a * x * a⁻¹ = z
  psi_mul : ∀ g ∈ centralizer ({x} : Set G), ∀ h ∈ centralizer ({x} : Set G),
    psi (g * h) = psi g * psi h
  psi_ker : ∀ g ∈ centralizer ({x} : Set G), psi g = 1 ↔ g ∈ CxK x K
  psi_K_ker : ∀ k ∈ K, psi k = 1 ↔ k ∈ pPrimeCoreOf 2 K
  psi_surj : ∀ h : Perm (Fin 7), sign h = 1 → ∃ k ∈ K, psi k = h
  psi_P : ∀ u ∈ T ⊓ K, ∃ i : Fin 8, psi u = a7P i
  psi_P_surj : ∀ i : Fin 8, ∃ u ∈ T ⊓ K, psi u = a7P i

theorem exists_frame [Finite G] (hc5 : B_thm2_cent5) (hG : C3Hyp G) {x y : G}
    {K T S : Subgroup G} (hs : Th2Std x y K T S) (e7 : kBar K ≃* alternatingGroup (Fin 7))
    (hQ4 : Nat.card ↥(T ⊓ CxK x K) = 4) (hTS : T < S) (hP2 : 2 ≤ pRank 2 ↥(T ⊓ K))
    (hQel : CFSG.IsElementaryAbelian 2 ↥(T ⊓ CxK x K)) :
    ∃ (a z : G) (psi : G → Perm (Fin 7)), Frame x K T S a z psi := by
  classical
  have hT2 : IsPGroup 2 ↥T := hs.T_pGroup
  have hTC : T ≤ centralizer ({x} : Set G) := hs.T_le_C
  have hcen : CenterlessBar K := centerlessBar_of_A7 ⟨e7⟩
  have hKN : ∀ c ∈ centralizer ({x} : Set G), ∀ k ∈ K, c * k * c⁻¹ ∈ K :=
    hs.K_normal (by rw [hG.pRank_eq_four]) hcen hP2
  obtain ⟨a, hcore, hT64⟩ := sec4Core_th2_A7 hc5 hG hs e7 hQ4 hTS hP2
  have hTeq := hcore.T_eq_sup_of_card_le hT64
  have hxQ : x ∈ T ⊓ CxK x K := ⟨hs.x_mem_T, hs.x_mem_CxK⟩
  have hx2 : orderOf x = 2 := hs.orderOf_x
  have hx1 : x ≠ 1 := by
    intro h1
    rw [h1, orderOf_one] at hx2
    omega
  have hxx : x * x = 1 := by
    have h1 : x ^ 2 = 1 := by rw [← hx2]; exact pow_orderOf_eq_one x
    rwa [sq] at h1
  have hxT : ∀ t ∈ T, x * t = t * x := fun t ht =>
    (Subgroup.mem_centralizer_singleton_iff.1 (hs.T_le_C ht)).symm
  obtain ⟨z, hzP, hz1, hzc, hxPa, hza⟩ := hcore.exists_swap_of_card_le hT64 hxQ hx1 hxT
  have hcentx : ∀ s ∈ S, s * x = x * s → s ∈ T := hcore.cent6 x hxQ hx1 hxT
  have hS1 : ∀ n ∈ S, n ∈ normalizer (T : Set G) → n ∈ T ∨ a⁻¹ * n ∈ T := fun n hn hnN =>
    hcore.mem_T_or_of_normalizer hTeq hzP hz1 hzc hxPa hx1 hxx hxT hza hcentx hn hnN
  have hScases := hcore.S_cases hTeq hS1
  have hzz : z * z = 1 := by
    calc z * z = (a * x * a⁻¹) * (a * x * a⁻¹) := by rw [hza]
      _ = a * (x * x) * a⁻¹ := by group
      _ = 1 := by rw [hxx]; group
  obtain ⟨ψ, hker, hψK⟩ := lemma113d_alt hs.K_le_C hKN (n := 7) (by norm_num) (by norm_num) e7
  have hker' : ψ.ker = (CMK (centralizer ({x} : Set G)) K).subgroupOf (centralizer ({x} : Set G)) :=
    hker
  obtain ⟨ι, hιinj, hιcard, hι⟩ := inf_embeds_alt7 hT2 hs.sylow_P e7
  obtain ⟨c, hc1, hc2⟩ := exists_conj_model (X := ι.range) hιcard
  obtain ⟨cP, hcP⟩ : ∃ cP : Perm (Fin 7), cP = (c : Perm (Fin 7)) := ⟨_, rfl⟩
  let psi : G → Perm (Fin 7) := fun g =>
    if hg : g ∈ centralizer ({x} : Set G) then cP⁻¹ * (ψ ⟨g, hg⟩ : Perm (Fin 7)) * cP else 1
  have hpsiC : ∀ g (hg : g ∈ centralizer ({x} : Set G)),
      psi g = cP⁻¹ * (ψ ⟨g, hg⟩ : Perm (Fin 7)) * cP := fun g hg => by simp only [psi, hg, dite_true]
  have hpsimul : ∀ g ∈ centralizer ({x} : Set G), ∀ h ∈ centralizer ({x} : Set G),
      psi (g * h) = psi g * psi h := by
    intro g hg h hh
    rw [hpsiC _ ((centralizer ({x} : Set G)).mul_mem hg hh), hpsiC g hg, hpsiC h hh]
    have : ψ ⟨g * h, (centralizer ({x} : Set G)).mul_mem hg hh⟩ = ψ ⟨g, hg⟩ * ψ ⟨h, hh⟩ :=
      map_mul ψ ⟨g, hg⟩ ⟨h, hh⟩
    rw [this]
    group
  have hpsiker : ∀ g ∈ centralizer ({x} : Set G), psi g = 1 ↔ g ∈ CxK x K := by
    intro g hg
    rw [hpsiC g hg]
    have h1 : cP⁻¹ * (ψ ⟨g, hg⟩ : Perm (Fin 7)) * cP = 1 ↔ ψ ⟨g, hg⟩ = 1 := by
      constructor
      · intro h
        have h2 : (ψ ⟨g, hg⟩ : Perm (Fin 7)) = 1 := by
          calc (ψ ⟨g, hg⟩ : Perm (Fin 7)) = cP * (cP⁻¹ * (ψ ⟨g, hg⟩ : Perm (Fin 7)) * cP) * cP⁻¹ := by
                group
            _ = 1 := by rw [h]; group
        exact h2
      · intro h
        rw [h]
        group
    rw [h1, ← MonoidHom.mem_ker, hker', Subgroup.mem_subgroupOf]
    rfl
  have hpsiKker : ∀ k ∈ K, psi k = 1 ↔ k ∈ pPrimeCoreOf 2 K := by
    intro k hk
    have hkC : k ∈ centralizer ({x} : Set G) := hs.K_le_C hk
    rw [hpsiC k hkC]
    have h1 : cP⁻¹ * (ψ ⟨k, hkC⟩ : Perm (Fin 7)) * cP = 1 ↔ ψ ⟨k, hkC⟩ = 1 := by
      constructor
      · intro h
        have h2 : (ψ ⟨k, hkC⟩ : Perm (Fin 7)) = 1 := by
          calc (ψ ⟨k, hkC⟩ : Perm (Fin 7)) = cP * (cP⁻¹ * (ψ ⟨k, hkC⟩ : Perm (Fin 7)) * cP) * cP⁻¹ := by
                group
            _ = 1 := by rw [h]; group
        exact h2
      · intro h
        rw [h]
        group
    rw [h1, hψK k hk]
    constructor
    · intro h
      have h2' : e7 (QuotientGroup.mk (⟨k, hk⟩ : ↥K) : kBar K) = 1 := Subtype.ext h
      have h2 : (QuotientGroup.mk (⟨k, hk⟩ : ↥K) : kBar K) = 1 :=
        e7.injective (h2'.trans (map_one e7).symm)
      exact Setup91.mem_pPrimeCoreOf_iff.2 ⟨hk, (QuotientGroup.eq_one_iff _).1 h2⟩
    · intro h
      obtain ⟨hk', h2⟩ := Setup91.mem_pPrimeCoreOf_iff.1 h
      have h3 : (QuotientGroup.mk (⟨k, hk⟩ : ↥K) : kBar K) = 1 := (QuotientGroup.eq_one_iff _).2 h2
      rw [h3, map_one]
      rfl
  have hpsisurj : ∀ h : Perm (Fin 7), sign h = 1 → ∃ k ∈ K, psi k = h := by
    intro h hh
    have hh' : cP * h * cP⁻¹ ∈ alternatingGroup (Fin 7) := by
      rw [mem_alternatingGroup, map_mul, map_mul, hh, map_inv]
      have : sign cP = 1 := by rw [hcP]; exact mem_alternatingGroup.1 c.2
      rw [this]
      simp
    obtain ⟨q, hq⟩ := QuotientGroup.mk_surjective (e7.symm ⟨cP * h * cP⁻¹, hh'⟩)
    refine ⟨(q : G), q.2, ?_⟩
    have hqC : (q : G) ∈ centralizer ({x} : Set G) := hs.K_le_C q.2
    rw [hpsiC _ hqC]
    have h1 : ψ ⟨(q : G), hqC⟩ = ((e7 (QuotientGroup.mk q) : alternatingGroup (Fin 7)) : Perm (Fin 7)) :=
      hψK (q : G) q.2
    rw [h1, hq, MulEquiv.apply_symm_apply]
    simp only
    group
  have hιψ : ∀ p : ↥(T ⊓ K), ((ι p : alternatingGroup (Fin 7)) : Perm (Fin 7)) =
      ψ ⟨(p : G), hTC p.2.1⟩ := by
    intro p
    rw [hι p]
    exact (hψK p p.2.2).symm
  have hpsiP : ∀ u ∈ T ⊓ K, ∃ i : Fin 8, psi u = a7P i := by
    intro u hu
    have hmem : ι ⟨u, hu⟩ ∈ ι.range := ⟨⟨u, hu⟩, rfl⟩
    obtain ⟨i, hi⟩ := hc2 _ hmem
    refine ⟨i, ?_⟩
    rw [hpsiC u (hTC hu.1), ← hιψ ⟨u, hu⟩]
    have hi' : a7P i = cP⁻¹ * ((ι ⟨u, hu⟩ : alternatingGroup (Fin 7)) : Perm (Fin 7)) * cP := by
      rw [hcP]
      simpa using hi
    exact hi'.symm
  have hpsiPsurj : ∀ i : Fin 8, ∃ u ∈ T ⊓ K, psi u = a7P i := by
    intro i
    have hy : (⟨a7P i, mem_alternatingGroup.2 (a7P_sign i)⟩ : alternatingGroup (Fin 7)) ∈
        CFSG.LieType.SteinbergBR.SmallAlt.finSubgroup a7P a7P_mul a7P_inv a7P_one := ⟨i, rfl⟩
    obtain ⟨p, hp⟩ := hc1 _ hy
    refine ⟨(p : G), p.2, ?_⟩
    rw [hpsiC _ (hTC p.2.1), ← hιψ p, hp]
    have hp' : (((c * ⟨a7P i, mem_alternatingGroup.2 (a7P_sign i)⟩ * c⁻¹ : alternatingGroup (Fin 7)) :
        alternatingGroup (Fin 7)) : Perm (Fin 7)) = cP * a7P i * cP⁻¹ := by
      rw [hcP]
      simp
    rw [hp']
    group
  refine ⟨a, z, psi, ?_⟩
  exact
    { x_sq := hxx
      x_ne := hx1
      x_mem_T := hs.x_mem_T
      x_mem_CxK := hs.x_mem_CxK
      core := hcore
      T_eq := hTeq
      S_cases := hScases
      T_le_C := hTC
      K_le := hs.K_le_C
      K_norm := hKN
      Q_el := hQel
      z_mem := hzP
      z_ne := hz1
      z_sq := hzz
      z_central := fun p hp => hzc p hp
      x_mem := hxPa
      a_x := hza
      psi_mul := hpsimul
      psi_ker := hpsiker
      psi_K_ker := hpsiKker
      psi_surj := hpsisurj
      psi_P := hpsiP
      psi_P_surj := hpsiPsurj }

end CFSG.GH74.GLS.Th2.P43f

