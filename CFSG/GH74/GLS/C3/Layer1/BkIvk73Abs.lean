variable {Y : Type} [Group Y] [Finite Y]

theorem isPCompIn_two_of_isCompIn_of_even {C K : Subgroup Y} (hK : IsCompIn C K)
    (hev : 2 ∣ Nat.card ↥K) : IsPCompIn 2 C K := by
  refine ⟨hK.1, CFSG.LocalAnalysis.ComponentInitial.isPComponent_of_isComponent_of_not_le 2
    hK.2 fun hle => ?_⟩
  have h1 : Nat.card ↥(K.subgroupOf C) ∣ Nat.card ↥(pPrimeCore 2 ↥C) := Subgroup.card_dvd_of_le hle
  have h2 : Nat.card ↥(K.subgroupOf C) = Nat.card ↥K :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hK.1).toEquiv
  rw [h2] at h1
  have h3 := Nat.Coprime.coprime_dvd_right h1 CFSG.pPrimeCore_coprime_card
  have h4 := Nat.Coprime.eq_one_of_dvd h3 hev
  omega

omit [Finite Y] in
theorem isCompIn_centralizer_conj {K : Subgroup Y} {u c : Y} (hc : c ∈ centralizer (K : Set Y))
    (h : IsCompIn (centralizer ({u} : Set Y)) K) :
    IsCompIn (centralizer ({c * u * c⁻¹} : Set Y)) K := by
  have h1 := CFSG.GH74.GLS.LU.Local.isCompIn_map_conj h c
  have hK : K.map (MulAut.conj c).toMonoidHom = K := by
    ext y
    rw [mem_map_conjHom_iff]
    constructor
    · intro hy
      have hk : (c⁻¹ * y * c) * c = c * (c⁻¹ * y * c) := (mem_centralizer_iff.1 hc) _ hy
      have : y = c⁻¹ * y * c := by
        calc y = (c * (c⁻¹ * y * c)) * c⁻¹ := by group
          _ = ((c⁻¹ * y * c) * c) * c⁻¹ := by rw [hk]
          _ = c⁻¹ * y * c := by group
      rw [this]
      exact hy
    · intro hy
      have hk : y * c = c * y := (mem_centralizer_iff.1 hc) _ hy
      have : c⁻¹ * y * c = y := by
        calc c⁻¹ * y * c = c⁻¹ * (y * c) := by group
          _ = c⁻¹ * (c * y) := by rw [hk]
          _ = y := by group
      rw [this]
      exact hy
  have hC : (centralizer ({u} : Set Y)).map (MulAut.conj c).toMonoidHom =
      centralizer ({c * u * c⁻¹} : Set Y) := by
    ext y
    rw [mem_map_conjHom_iff, mem_centralizer_singleton_iff, mem_centralizer_singleton_iff]
    constructor
    · intro h0
      calc y * (c * u * c⁻¹) = c * ((c⁻¹ * y * c) * u) * c⁻¹ := by group
        _ = c * (u * (c⁻¹ * y * c)) * c⁻¹ := by rw [h0]
        _ = c * u * c⁻¹ * y := by group
    · intro h0
      calc c⁻¹ * y * c * u = c⁻¹ * (y * (c * u * c⁻¹)) * c := by group
        _ = c⁻¹ * ((c * u * c⁻¹) * y) * c := by rw [h0]
        _ = u * (c⁻¹ * y * c) := by group
  rwa [hK, hC] at h1

end Apply

