variable {Y : Type} [Group Y] [Finite Y]

omit [Finite Y] in
theorem perfect_ne_bot_of_isQuasisimple {K : Subgroup Y} (hK : IsQuasisimple ↥K) :
    ⁅K, K⁆ = K ∧ K ≠ ⊥ := by
  refine ⟨Subgroup.isPerfect_iff.mp hK.1, ?_⟩
  have : Nontrivial ↥K := CFSG.LocalCores.isQuasisimple_nontrivial hK
  exact (Subgroup.nontrivial_iff_ne_bot K).1 this

theorem eq_of_component_le {K L : Subgroup Y} (hK : IsComponent K) (hL : IsComponent L)
    (hKL : K ≤ L) : K = L := by
  rcases CFSG.LocalCores.distinct_components_commute hK hL with h | h
  · exact h
  · exfalso
    have hle : ⁅K, K⁆ ≤ ⁅K, L⁆ := Subgroup.commutator_mono le_rfl hKL
    rw [h, le_bot_iff] at hle
    exact (perfect_ne_bot_of_isQuasisimple hK.1).2 ((perfect_ne_bot_of_isQuasisimple hK.1).1 ▸ hle)

theorem false_of_component_lt {C K L : Subgroup Y} (hKC : IsCompIn C K) (hLC : L ≤ C)
    (hL : IsComponent L) (hKL : K ≤ L) (hne : K ≠ L) : False := by
  have hLc : IsComponent (L.subgroupOf C) := CFSG.LocalCores.component_overgroup hL hLC
  have hle : K.subgroupOf C ≤ L.subgroupOf C := fun k hk => hKL hk
  have heq := eq_of_component_le hKC.2 hLc hle
  have h := Subgroup.subgroupOf_inj.1 heq
  rw [inf_eq_left.2 hKC.1, inf_eq_left.2 hLC] at h
  exact hne h

theorem not_le_centralizer_of_term {K Q L : Subgroup Y}
    (hterm : ∀ u ∈ Q, orderOf u = 2 → IsCompIn (centralizer ({u} : Set Y)) K)
    (hL : IsComponent L) (hKL : K ≤ L) (hne : K ≠ L) {b : Y} (hbQ : b ∈ Q) (hb2 : orderOf b = 2) :
    ¬ L ≤ centralizer ({b} : Set Y) :=
  fun hLb => false_of_component_lt (hterm b hbQ hb2) hLb hL hKL hne

omit [Finite Y] in
theorem mem_map_conjHom_iff {X : Subgroup Y} {g y : Y} :
    y ∈ X.map (MulAut.conj g).toMonoidHom ↔ g⁻¹ * y * g ∈ X := by
  constructor
  · rintro ⟨x, hx, rfl⟩
    simpa [MulAut.conj_apply, mul_assoc] using hx
  · intro h
    exact ⟨g⁻¹ * y * g, h, by simp [MulAut.conj_apply, mul_assoc]⟩

theorem ivk73_socle {K Q L : Subgroup Y} (hO : pPrimeCore 2 Y = ⊥) (hKq : IsQuasisimple ↥K)
    (hQS : IsSylowOf 2 Q (centralizer (K : Set Y)))
    (hterm : ∀ u ∈ Q, orderOf u = 2 → IsCompIn (centralizer ({u} : Set Y)) K)
    (hL : IsComponent L) (hKL : K ≤ L) (hne : K ≠ L) :
    L.Normal ∧ IsSimpleGroup ↥L ∧ ∀ y : Y, (∀ l ∈ L, y * l = l * y) → y = 1 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hno : ∀ b ∈ Q, orderOf b = 2 → ¬ L ≤ centralizer ({b} : Set Y) := fun b hb hb2 =>
    not_le_centralizer_of_term hterm hL hKL hne hb hb2
  have hall : ∀ M : Subgroup Y, IsComponent M → M = L := by
    intro M hM
    by_contra hMne
    have hcomm : ⁅M, L⁆ = ⊥ :=
      (CFSG.LocalCores.distinct_components_commute hM hL).resolve_left hMne
    obtain ⟨b, hbM, hb2⟩ := EvenCore.exists_involution_of_isComponent hM
    have hbC : b ∈ centralizer (K : Set Y) := by
      rw [mem_centralizer_iff]
      intro k hk
      have := Subgroup.commutator_mem_commutator hbM (hKL hk)
      rw [hcomm, Subgroup.mem_bot] at this
      exact (commutatorElement_eq_one_iff_mul_comm.1 this).symm
    obtain ⟨c, hc, hcQ⟩ := EvenCore.exists_conj_mem_Q hQS hbC hb2
    set σ : Y ≃* Y := MulAut.conj c⁻¹ with hσ
    have hσapply : ∀ y : Y, σ y = c⁻¹ * y * c := fun y => by simp [hσ]
    have hσK : ∀ k ∈ K, σ k = k := fun k hk => by
      have hkc : k * c = c * k := (mem_centralizer_iff.1 hc) k hk
      rw [hσapply]
      calc c⁻¹ * k * c = c⁻¹ * (k * c) := by group
        _ = c⁻¹ * (c * k) := by rw [hkc]
        _ = k := by group
    have hLσc : IsComponent (L.map σ.toMonoidHom) :=
      CFSG.LocalCores.isComponent_map_mulEquiv σ hL
    have hKσ : K ≤ L.map σ.toMonoidHom := fun k hk =>
      ⟨k, hKL hk, by simpa using hσK k hk⟩
    have hLσ : L.map σ.toMonoidHom = L := by
      by_contra hne'
      have h1 : ⁅L, L.map σ.toMonoidHom⁆ = ⊥ :=
        (CFSG.LocalCores.distinct_components_commute hL hLσc).resolve_left (Ne.symm hne')
      have hle : ⁅K, K⁆ ≤ ⁅L, L.map σ.toMonoidHom⁆ := Subgroup.commutator_mono hKL hKσ
      rw [h1, le_bot_iff] at hle
      exact (perfect_ne_bot_of_isQuasisimple hKq).2 ((perfect_ne_bot_of_isQuasisimple hKq).1 ▸ hle)
    have hMσc : IsComponent (M.map σ.toMonoidHom) := CFSG.LocalCores.isComponent_map_mulEquiv σ hM
    have hMσne : M.map σ.toMonoidHom ≠ L := by
      intro h
      apply hMne
      rw [← hLσ] at h
      exact Subgroup.map_injective σ.injective h
    have hcomm3 : ⁅M.map σ.toMonoidHom, L⁆ = ⊥ :=
      (CFSG.LocalCores.distinct_components_commute hMσc hL).resolve_left hMσne
    have hord : orderOf (c⁻¹ * b * c) = 2 := by
      have := MulEquiv.orderOf_eq (MulAut.conj c⁻¹) b
      simpa [MulAut.conj_apply] using this.trans hb2
    refine hno _ hcQ hord ?_
    intro l hl
    rw [mem_centralizer_singleton_iff]
    have hmem : σ b ∈ M.map σ.toMonoidHom := ⟨b, hbM, rfl⟩
    have hc1 : ⁅σ b, l⁆ = 1 := by
      have := Subgroup.commutator_mem_commutator hmem hl
      rw [hcomm3, Subgroup.mem_bot] at this
      exact this
    have h2 := commutatorElement_eq_one_iff_mul_comm.1 hc1
    rw [hσapply] at h2
    exact h2.symm
  have hlayer : CFSG.layer Y = L := by
    simp only [CFSG.layer.eq_sSup]
    have hset : {M : Subgroup Y | CFSG.IsComponent M} = {L} := by
      ext M
      exact ⟨fun hM => hall M hM, fun h => by rw [Set.mem_singleton_iff] at h; rw [h]; exact hL⟩
    rw [hset, sSup_singleton]
  have hLn : L.Normal := by
    rw [← hlayer]
    have := CFSG.LocalCores.layer_characteristic (G := Y)
    infer_instance
  have hF : fittingSubgroup Y = ⊥ := by
    by_contra hne'
    set F := fittingSubgroup Y with hFdef
    have hFn : F.Normal := inferInstance
    have hFp : IsPGroup 2 ↥F := isPGroup_of_nilpotent_normal F hFn inferInstance hO
    have hcomm : ⁅F, CFSG.layer Y⁆ = ⊥ := CFSG.LocalCores.fitting_layer_commute
    have hFC : F ≤ centralizer (K : Set Y) := fun f hf => by
      rw [mem_centralizer_iff]
      intro k hk
      have hk' : k ∈ CFSG.layer Y := hlayer ▸ hKL hk
      have := Subgroup.commutator_mem_commutator hf hk'
      rw [hcomm, Subgroup.mem_bot] at this
      exact (commutatorElement_eq_one_iff_mul_comm.1 this).symm
    obtain ⟨c, hc, hcQ⟩ := C3.Layer1.Thm1.exists_conj_le_of_isSylowOf hQS hFC hFp
    have hFQ : F ≤ Q := fun y hy => by
      have h1 := hcQ (c * y * c⁻¹) (hFn.conj_mem y hy c)
      simpa [mul_assoc] using h1
    obtain ⟨b, hbF, hb2⟩ := Th2.exists_involution_mem hFp hne'
    refine hno b (hFQ hbF) hb2 ?_
    intro l hl
    rw [mem_centralizer_singleton_iff]
    have hl' : l ∈ CFSG.layer Y := hlayer ▸ hl
    have := Subgroup.commutator_mem_commutator hbF hl'
    rw [hcomm, Subgroup.mem_bot] at this
    exact (commutatorElement_eq_one_iff_mul_comm.1 this).symm
  have hZ : center ↥L = ⊥ := by
    have := hLn
    have hnormal : ((center ↥L).map L.subtype).Normal := inferInstance
    have : Group.IsNilpotent ↥((center ↥L).map L.subtype) :=
      Group.nilpotent_of_mulEquiv ((center ↥L).equivMapOfInjective L.subtype L.subtype_injective)
    have hle : (center ↥L).map L.subtype ≤ fittingSubgroup Y := le_sSup ⟨hnormal, inferInstance⟩
    rw [hF, le_bot_iff] at hle
    exact (Subgroup.map_eq_bot_iff_of_injective _ L.subtype_injective).mp hle
  have hLsimple : IsSimpleGroup ↥L := by
    have hs : IsSimpleGroup (↥L ⧸ center ↥L) := hL.1.2.1
    let e : ↥L ≃* (↥L ⧸ center ↥L) :=
      (QuotientGroup.quotientBot (G := ↥L)).symm.trans
        (QuotientGroup.quotientMulEquivOfEq hZ.symm)
    exact e.isSimpleGroup
  have hFstar : CFSG.Open.genFittingFStar Y = L := by
    have h1 : CFSG.Open.genFittingFitting Y = ⊥ := by
      have : CFSG.Open.genFittingFitting Y = fittingSubgroup Y := rfl
      rw [this, hF]
    have h2 : CFSG.Open.genFittingLayer Y = L := by
      simp only [CFSG.Open.genFittingLayer.eq_sSup]
      apply le_antisymm
      · refine sSup_le fun M hM => ?_
        exact (hall M ((CFSG.isComponent_iff_open M).mpr hM)).le
      · exact le_sSup ((CFSG.isComponent_iff_open L).mp hL)
    simp only [CFSG.Open.genFittingFStar.eq_sup]
    rw [h1, h2, bot_sup_eq]
  refine ⟨hLn, hLsimple, fun y hy => ?_⟩
  have hmem : y ∈ centralizer (CFSG.Open.genFittingFStar Y : Set Y) := by
    rw [hFstar, mem_centralizer_iff]
    intro l hl
    exact (hy l hl).symm
  have hyL : y ∈ L := by
    have := CFSG.Adapters.generalized_fitting_self_centralizing Y hmem
    rwa [hFstar] at this
  have hyz : (⟨y, hyL⟩ : ↥L) ∈ center ↥L := by
    rw [Subgroup.mem_center_iff]
    intro g
    exact Subtype.ext (hy g g.2).symm
  rw [hZ, Subgroup.mem_bot] at hyz
  exact congrArg Subtype.val hyz

end Socle

