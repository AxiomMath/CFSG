variable {G : Type} [Group G] [Finite G]

noncomputable def kBarConjEquiv (g : G) (M : Subgroup G) : kBar M ≃* kBar (cj g M) :=
  QuotientGroup.congr (pPrimeCore 2 ↥M) (pPrimeCore 2 ↥(cj g M)) ((MulAut.conj g).subgroupMap M)
    (CFSG.pPrimeCore_map_iso 2 _)

omit [Finite G] in
theorem map_conj_centralizer_singleton (g q : G) :
    (centralizer ({q} : Set G)).map (MulAut.conj g).toMonoidHom =
      centralizer ({g * q * g⁻¹} : Set G) := by
  ext z
  constructor
  · rintro ⟨y, hy, rfl⟩
    have hy' : y * q = q * y := mem_centralizer_singleton_iff.1 hy
    show g * y * g⁻¹ ∈ centralizer ({g * q * g⁻¹} : Set G)
    refine mem_centralizer_singleton_iff.2 ?_
    calc g * y * g⁻¹ * (g * q * g⁻¹) = g * (y * q) * g⁻¹ := by group
      _ = g * (q * y) * g⁻¹ := by rw [hy']
      _ = g * q * g⁻¹ * (g * y * g⁻¹) := by group
  · intro hz
    have hz' : z * (g * q * g⁻¹) = g * q * g⁻¹ * z := mem_centralizer_singleton_iff.1 hz
    refine ⟨g⁻¹ * z * g, ?_, by simp [MulAut.conj_apply]; group⟩
    refine mem_centralizer_singleton_iff.2 ?_
    calc g⁻¹ * z * g * q = g⁻¹ * (z * (g * q * g⁻¹)) * g := by group
      _ = g⁻¹ * (g * q * g⁻¹ * z) * g := by rw [hz']
      _ = q * (g⁻¹ * z * g) := by group

theorem not_conj_invol_CxK (hG : C3Hyp G) {x : G} {K : Subgroup G} (hxo : orderOf x = 2)
    (hKc : IsPCompIn 2 (centralizer ({x} : Set G)) K) (hterm : IsTwoTerminal x K)
    (hL2 : HasL2Model (kBar K) Odd) {b : G} {J : Subgroup G}
    (hJ : IsPCompIn 2 (centralizer ({b} : Set G)) J)
    (hA : Nonempty (kBar J ≃* alternatingGroup (Fin 7))) (hN2 : twoPartCard (CxK b J) = 2) :
    ∀ q ∈ CxK x K, orderOf q = 2 → ∀ g : G, g * q * g⁻¹ ≠ b := by
  intro q hq hq2 g hgq
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hr4 : pRank 2 G = 4 := hG.pRank_eq_four
  have hR : 3 ≤ pRank 2 ↥(centralizer ({q} : Set G)) :=
    rankThreeCentralizers G hG.kproper.1 hG.kproper.2.1 (by rw [hr4]; norm_num) q hq2
  obtain ⟨M, hlt⟩ := exists_pumpup_of_involution hxo hq2 hKc hq.1 hq.2 hterm.1 hR
  obtain ⟨-, ⟨eMK⟩⟩ := hterm.2.1 q M hlt
  have hM : IsPCompIn 2 (centralizer ({q} : Set G)) M := hlt.2.1.2.2
  have hMc : IsPCompIn 2 (centralizer ({b} : Set G)) (cj g M) := by
    have h1 := Stage1.Thm2.Recip.isPCompIn_map_conj hM g
    rwa [map_conj_centralizer_singleton, hgq] at h1
  have eMM : kBar M ≃* kBar (cj g M) := kBarConjEquiv g M
  have hne : cj g M ≠ J := by
    rintro rfl
    obtain ⟨eJ⟩ := hA
    exact not_nonempty_A7_of_hasL2Model hL2 ⟨eMK.symm.trans (eMM.trans eJ)⟩
  have hle : cj g M ≤ CxK b J := le_inf hMc.1 (Stage1.Thm2.Recip.le_cSec_of_ne hMc hJ hne)
  have h2M : 2 ≤ pRank 2 ↥M :=
    C3.Layer1.Thm1.two_le_pRank_of_shape (Or.inl (TwoThin.hasL2Model_of_mulEquiv eMK.symm hL2))
  have h2 : 2 ≤ pRank 2 ↥(cj g M) := by rw [pRank_cj]; exact h2M
  obtain ⟨E, hEM, hEel, hErk⟩ := exists_elemAbelian_pRank (cj g M)
  have hcard : Nat.card ↥E = 2 ^ pRank 2 ↥E := C3.Layer1.Back.card_eq_two_pow_pRank hEel
  have hle2 := Th2.L627.card_le_twoPartCard (CFSG.IsElementaryAbelian.isPGroup 2 ↥E) (hEM.trans hle)
  rw [hN2, hcard] at hle2
  have h4 : 2 ^ 2 ≤ 2 ^ pRank 2 ↥E := Nat.pow_le_pow_right (by norm_num) (hErk ▸ h2)
  omega

