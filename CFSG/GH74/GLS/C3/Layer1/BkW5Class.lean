theorem exists_mul_mem_normalizer_of_sylow {M S₀ : Subgroup G} (hS : IsSylow2In S₀ M) {n : G}
    (hn : ∀ u ∈ M, n * u * n⁻¹ ∈ M) : ∃ u ∈ M, n * u ∈ normalizer (S₀ : Set G) := by
  have hnN : n ∈ normalizer (M : Set G) := L5.mem_normalizer_of_conj_le hn
  have hM : Hconj n M = M := by
    ext a
    rw [mem_Hconj]
    exact (mem_normalizer_iff.1 hnN a).symm
  have hS' : IsSylow2In (Hconj n S₀) M := by
    have := sylow2_conj hS n
    rwa [hM] at this
  obtain ⟨c, hcM, hc⟩ := sylow2_exists_conj hS' hS
  refine ⟨c, hcM, mem_normalizer_iff.2 fun a => ?_⟩
  have h1 : a ∈ S₀ ↔ a ∈ Hconj c (Hconj n S₀) := by rw [← hc]
  rw [h1, mem_Hconj, mem_Hconj]
  have e : n * c * a * (n * c)⁻¹ = n * (c * a * c⁻¹) * n⁻¹ := by group
  rw [e]

