theorem class1_rho_mem
    (hF : C1Facts2) (hRed : c.Red)
    (hNo : ¬ ∃ γ : ↥S0subP1 ≃* ↥S0subP1, ∀ (s : ↥S0subP1) (i : Fin 16),
      (s : Perm (Fin 16)) = tr1 i → ((γ s : ↥S0subP1) : Perm (Fin 16)) = tr1 (cHat i))
    (Ψ : c.ModelIso hS Sh1 tr1 yHat1) (n : ↥c.N) : c.rhoG n ∈ n24L := by
  by_contra hn
  have hcH : cHat ∈ c.rhoG.range := by
    apply hF.cHat_gen c.rhoG.range
    · rintro m ⟨n', rfl⟩
      exact ⟨(rho_stable hRed n').1, hRed.pres n', (rho_stable hRed n').2⟩
    · intro A hA
      obtain ⟨n', hn'⟩ := hRed.nbar A hA
      exact ⟨n', hn'⟩
    · exact ⟨c.rhoG n, ⟨n, rfl⟩, hn⟩
  obtain ⟨n₀, hn₀⟩ := hcH
  have hov : ∀ (s : G) (hs : s ∈ S₁), ((Ψ.ψ ⟨s, hs⟩ : ↥Sh1) : Perm (Fin 16)) ∈ S0subP1 ↔
      c.rhoG ⟨s, hS.hN hs⟩ ∈ v4L := by
    intro s hs
    rw [mem_S0subP1]
    unfold S0L1
    rw [List.mem_filter]
    have hmem : ((Ψ.ψ ⟨s, hs⟩ : ↥Sh1) : Perm (Fin 16)) ∈ Sh1L := mem_Sh1.1 (Ψ.ψ ⟨s, hs⟩).2
    simp only [hmem, true_and]
    unfold overV4
    simp only [List.any_eq_true, List.all_eq_true, decide_eq_true_eq, List.mem_finRange,
      true_implies]
    constructor
    · rintro ⟨d, hd, hdi⟩
      have : d = c.rhoG ⟨s, hS.hN hs⟩ :=
        Equiv.ext fun i => by rw [hdi i, Ψ.rhoF_eq Glue.tr1_injective hs i]
      rw [← this]
      exact hd
    · intro hmem2
      exact ⟨_, hmem2, fun i => by rw [Ψ.rhoF_eq Glue.tr1_injective hs i]⟩
  let S0sub : Subgroup ↥S₁ := S0subP1.comap (Sh1.subtype.comp Ψ.ψ.toMonoidHom)
  have hmemS0 : ∀ s : ↥S₁, s ∈ S0sub ↔ c.rhoG ⟨s.1, hS.hN s.2⟩ ∈ v4L := fun s => hov s.1 s.2
  let S₀ : Subgroup G := S0sub.map S₁.subtype
  have hmemS₀ : ∀ s : G, s ∈ S₀ ↔ ∃ hs : s ∈ S₁, c.rhoG ⟨s, hS.hN hs⟩ ∈ v4L := by
    intro s
    constructor
    · rintro ⟨z, hz, rfl⟩
      exact ⟨z.2, (hmemS0 z).1 hz⟩
    · rintro ⟨hs, hv⟩
      exact ⟨⟨s, hs⟩, (hmemS0 ⟨s, hs⟩).2 hv, rfl⟩
  have hS₀S₁ : S₀ ≤ S₁ := by
    rintro _ ⟨z, -, rfl⟩
    exact z.2
  have hp₁ : IsPGroup 2 ↥S₁ := IsPGroup.of_card (n := 7) (by rw [hS.card]; norm_num)
  have hp₀ : IsPGroup 2 ↥S₀ := hp₁.to_le hS₀S₁
  let V4 : Subgroup (Perm (Fin 16)) := S0sub.map (c.rhoS1 hS.hN)
  have hV4 : ∀ d, d ∈ V4 ↔ d ∈ v4L := by
    intro d
    constructor
    · rintro ⟨s, hs, rfl⟩
      exact (hmemS0 s).1 hs
    · intro hd
      obtain ⟨s, hs, hsd⟩ := hS.surj d (hF.v4_sub_d8 d hd)
      rw [rhoT_of_mem (hS.hN hs)] at hsd
      refine ⟨⟨s, hs⟩, (hmemS0 ⟨s, hs⟩).2 (by rw [hsd]; exact hd), ?_⟩
      exact hsd
  have h1v4 : (1 : Perm (Fin 16)) ∈ v4L := (hV4 1).1 V4.one_mem
  let M : Subgroup G := (V4.comap c.rhoG).map c.N.subtype
  have hmemM : ∀ u : G, u ∈ M ↔ ∃ hu : u ∈ c.N, c.rhoG ⟨u, hu⟩ ∈ V4 := by
    intro u
    constructor
    · rintro ⟨m, hm, rfl⟩
      exact ⟨m.2, hm⟩
    · rintro ⟨hu, hv⟩
      exact ⟨⟨u, hu⟩, hv, rfl⟩
  have hS₀M : S₀ ≤ M := by
    intro s hs
    obtain ⟨hs1, hv⟩ := (hmemS₀ s).1 hs
    exact (hmemM s).2 ⟨hS.hN hs1, (hV4 _).2 hv⟩
  have hRS₀ : c.lift Rm ≤ S₀ := by
    intro r hr
    refine (hmemS₀ r).2 ⟨R_le_S1 hS hr, ?_⟩
    rw [rhoG_R_eq_one hr]
    exact h1v4
  have hSyl : IsSylow2In S₀ M := by
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    refine isSylowOf_iff.1 (isSylowOf_of_maximal hp₀ hS₀M (fun B hSB hBM hB2 => ?_))
    refine le_antisymm ?_ hSB
    intro b hb
    obtain ⟨hbN, hbV⟩ := (hmemM b).1 (hBM hb)
    obtain ⟨s, hs0, hsρ⟩ := hbV
    have hsS₀ : (s : G) ∈ S₀ := ⟨s, hs0, rfl⟩
    have hsB : (s : G) ∈ B := hSB hsS₀
    have h1 : (s : G)⁻¹ * b ∈ c.N := mul_mem (inv_mem (hS.hN s.2)) hbN
    have hρ1 : c.rhoG ⟨(s : G)⁻¹ * b, h1⟩ = 1 := by
      have e : (⟨(s : G)⁻¹ * b, h1⟩ : ↥c.N) = ⟨(s : G), hS.hN s.2⟩⁻¹ * ⟨b, hbN⟩ := rfl
      rw [e, map_mul, map_inv]
      have e2 : c.rhoG ⟨(s : G), hS.hN s.2⟩ = c.rhoG ⟨b, hbN⟩ := hsρ
      rw [e2, inv_mul_cancel]
    have hsb : (s : G)⁻¹ * b ∈ c.lift Rm :=
      mem_R_of_rho_one c hB2 (hRS₀.trans hSB) (B.mul_mem (B.inv_mem hsB) hb) h1 hρ1
    have e3 : b = (s : G) * ((s : G)⁻¹ * b) := by group
    rw [e3]
    exact S₀.mul_mem hsS₀ (hRS₀ hsb)
  have hn₀M : ∀ u ∈ M, n₀.1 * u * n₀.1⁻¹ ∈ M := by
    intro u hu
    obtain ⟨huN, hV⟩ := (hmemM u).1 hu
    have hNN : n₀.1 * u * n₀.1⁻¹ ∈ c.N := mul_mem (mul_mem n₀.2 huN) (inv_mem n₀.2)
    refine (hmemM _).2 ⟨hNN, ?_⟩
    have hρ : c.rhoG ⟨n₀.1 * u * n₀.1⁻¹, hNN⟩ = cHat * c.rhoG ⟨u, huN⟩ * cHat⁻¹ := by
      have e : (⟨n₀.1 * u * n₀.1⁻¹, hNN⟩ : ↥c.N) = n₀ * ⟨u, huN⟩ * n₀⁻¹ := rfl
      rw [e, map_mul, map_mul, map_inv, hn₀]
    rw [hρ]
    exact (hV4 _).2 (hF.cHat_v4 _ ((hV4 _).1 hV))
  obtain ⟨n₁, hn₁, hn₁S₀⟩ : ∃ n₁ : ↥c.N, c.rhoG n₁ = cHat ∧ n₁.1 ∈ normalizer (S₀ : Set G) := by
    obtain ⟨u, huM, hnu⟩ := exists_mul_mem_normalizer_of_sylow hSyl hn₀M
    obtain ⟨huN, huV⟩ := (hmemM u).1 huM
    obtain ⟨s, hs0, hsρ⟩ := huV
    have hsS₀ : (s : G) ∈ S₀ := ⟨s, hs0, rfl⟩
    have hn₃N : n₀.1 * u * (s : G)⁻¹ ∈ c.N :=
      mul_mem (mul_mem n₀.2 huN) (inv_mem (hS.hN s.2))
    refine ⟨⟨n₀.1 * u * (s : G)⁻¹, hn₃N⟩, ?_, ?_⟩
    · have e : (⟨n₀.1 * u * (s : G)⁻¹, hn₃N⟩ : ↥c.N) =
          n₀ * ⟨u, huN⟩ * ⟨(s : G), hS.hN s.2⟩⁻¹ := rfl
      rw [e, map_mul, map_mul, map_inv, hn₀]
      have e2 : c.rhoG ⟨(s : G), hS.hN s.2⟩ = c.rhoG ⟨u, huN⟩ := hsρ
      rw [e2, mul_assoc, mul_inv_cancel, mul_one]
    · exact mul_mem hnu (inv_mem (Subgroup.le_normalizer hsS₀))
  have hconj : ∀ (s : G) (hs : s ∈ S₁), c.rhoG ⟨s, hS.hN hs⟩ ∈ v4L →
      ∃ ht : n₁.1 * s * n₁.1⁻¹ ∈ S₁, c.rhoG ⟨n₁.1 * s * n₁.1⁻¹, hS.hN ht⟩ ∈ v4L := by
    intro s hs hv
    have htN : n₁.1 * s * n₁.1⁻¹ ∈ c.N := mul_mem (mul_mem n₁.2 (hS.hN hs)) (inv_mem n₁.2)
    have hρt : c.rhoG ⟨n₁.1 * s * n₁.1⁻¹, htN⟩ = cHat * c.rhoG ⟨s, hS.hN hs⟩ * cHat⁻¹ := by
      have e : (⟨n₁.1 * s * n₁.1⁻¹, htN⟩ : ↥c.N) = n₁ * ⟨s, hS.hN hs⟩ * n₁⁻¹ := rfl
      rw [e, map_mul, map_mul, map_inv, hn₁]
    have hv4 : c.rhoG ⟨n₁.1 * s * n₁.1⁻¹, htN⟩ ∈ v4L := by
      rw [hρt]
      exact hF.cHat_v4 _ hv
    have hsS₀ : s ∈ S₀ := (hmemS₀ s).2 ⟨hs, hv⟩
    have htS : n₁.1 * s * n₁.1⁻¹ ∈ S₁ :=
      hS₀S₁ ((mem_normalizer_iff.1 hn₁S₀ s).1 hsS₀)
    exact ⟨htS, hv4⟩
  let e : ↥S0subP1 →* ↥S₁ := Ψ.ψ.symm.toMonoidHom.comp (Subgroup.inclusion Glue.S0subP1_le_Sh1)
  have he : ∀ m : ↥S0subP1, Ψ.ψ (e m) = Subgroup.inclusion Glue.S0subP1_le_Sh1 m := fun m => by
    simp [e]
  have hein : Function.Injective e := fun m m' hmm' => by
    have h1 : Subgroup.inclusion Glue.S0subP1_le_Sh1 m = Subgroup.inclusion Glue.S0subP1_le_Sh1 m' := by
      rw [← he m, ← he m', hmm']
    exact Subgroup.inclusion_injective _ h1
  have hev : ∀ m : ↥S0subP1, c.rhoG ⟨(e m : G), hS.hN (e m).2⟩ ∈ v4L := by
    intro m
    have hm : ((Ψ.ψ ⟨(e m : G), (e m).2⟩ : ↥Sh1) : Perm (Fin 16)) ∈ S0subP1 := by
      have h1 : (⟨(e m : G), (e m).2⟩ : ↥S₁) = e m := rfl
      rw [h1, he m, Subgroup.coe_inclusion]
      exact m.2
    exact (hov _ (e m).2).1 hm
  obtain ⟨Dfun, hDfun⟩ : ∃ D : ↥S0subP1 → ↥S₁, ∀ m, (D m : G) = n₁.1 * (e m : G) * n₁.1⁻¹ :=
    ⟨fun m => ⟨n₁.1 * (e m : G) * n₁.1⁻¹, (hconj (e m) (e m).2 (hev m)).1⟩, fun m => rfl⟩
  have hD_mul : ∀ m m' : ↥S0subP1, Dfun (m * m') = Dfun m * Dfun m' := fun m m' => by
    apply Subtype.ext
    rw [hDfun, Subgroup.coe_mul, hDfun, hDfun, map_mul, Subgroup.coe_mul]
    group
  have hDmem : ∀ m : ↥S0subP1, ((Ψ.ψ (Dfun m) : ↥Sh1) : Perm (Fin 16)) ∈ S0subP1 := fun m => by
    have h1 := hconj (e m) (e m).2 (hev m)
    have h2 : Dfun m = ⟨n₁.1 * (e m : G) * n₁.1⁻¹, h1.1⟩ := Subtype.ext (hDfun m)
    rw [h2]
    exact (hov _ h1.1).2 h1.2
  obtain ⟨γ, hγ⟩ : ∃ γ : ↥S0subP1 →* ↥S0subP1, ∀ m,
      ((γ m : ↥S0subP1) : Perm (Fin 16)) = ((Ψ.ψ (Dfun m) : ↥Sh1) : Perm (Fin 16)) :=
    ⟨MonoidHom.mk' (fun m => ⟨((Ψ.ψ (Dfun m) : ↥Sh1) : Perm (Fin 16)), hDmem m⟩) (fun m m' =>
      Subtype.ext (by
        show ((Ψ.ψ (Dfun (m * m')) : ↥Sh1) : Perm (Fin 16)) =
          ((Ψ.ψ (Dfun m) : ↥Sh1) : Perm (Fin 16)) * ((Ψ.ψ (Dfun m') : ↥Sh1) : Perm (Fin 16))
        rw [hD_mul, map_mul, Subgroup.coe_mul])), fun m => by
        simp only [MonoidHom.mk'_apply, Subtype.coe_mk]⟩
  have hγinj : Function.Injective γ := by
    intro m m' hmm'
    have h0 : ((Ψ.ψ (Dfun m) : ↥Sh1) : Perm (Fin 16)) = ((Ψ.ψ (Dfun m') : ↥Sh1) : Perm (Fin 16)) := by
      rw [← hγ m, ← hγ m', hmm']
    have h2 : Dfun m = Dfun m' := Ψ.ψ.injective (Subtype.ext h0)
    have h3 : n₁.1 * (e m : G) * n₁.1⁻¹ = n₁.1 * (e m' : G) * n₁.1⁻¹ := by
      rw [← hDfun, ← hDfun, h2]
    have h4 : (e m : G) = (e m' : G) := by simpa using h3
    exact hein (Subtype.ext h4)
  have hγbij : Function.Bijective γ :=
    ⟨hγinj, Finite.injective_iff_surjective.1 hγinj⟩
  apply hNo
  refine ⟨MulEquiv.ofBijective γ hγbij, fun s i hs => ?_⟩
  rw [MulEquiv.ofBijective_apply, hγ]
  have h1 : e s = ⟨c.liftEl i, R_le_S1 hS (c.liftEl_mem i)⟩ := by
    apply Ψ.ψ.injective
    apply Subtype.ext
    rw [he s, Subgroup.coe_inclusion, hs, Ψ.liftEl]
  have h2 : Dfun s = ⟨c.liftEl (cHat i), R_le_S1 hS (c.liftEl_mem _)⟩ := by
    apply Subtype.ext
    rw [hDfun, h1]
    show n₁.1 * c.liftEl i * n₁.1⁻¹ = c.liftEl (cHat i)
    rw [← rhoG_spec c n₁ i, hn₁]
  rw [h2, Ψ.liftEl]

theorem class1_RExact
    (hS : c.S1Data S₁) (hSyl : IsSylow2In S₁ ⊤)
    (hweak : ∀ g : G, (c.lift Rm).map (MulAut.conj g).toMonoidHom ≤ S₁ →
      (c.lift Rm).map (MulAut.conj g).toMonoidHom = c.lift Rm)
    (hrho : ∀ n : ↥c.N, c.rhoG n ∈ n24L) (i j : Fin 16)
    (hij : ∃ g : G, g * c.liftEl i * g⁻¹ = c.liftEl j) : ∃ A ∈ n24L, A i = j := by
  obtain ⟨g, hg⟩ := hij
  have hab : ∀ a ∈ c.lift Rm, ∀ b ∈ c.lift Rm, a * b = b * a := fun a ha b hb =>
    lift_comm (c := c) (M := Rm) (fun p hp q hq => Rm_comm p hp q hq) ha hb
  have hmem : (g⁻¹)⁻¹ * c.liftEl i * g⁻¹ ∈ c.lift Rm := by
    rw [inv_inv, hg]
    exact c.liftEl_mem j
  obtain ⟨n, hn, hnr⟩ := burnside_weak S₁ (c.lift Rm) hSyl.2.1 hSyl (R_le_S1 hS) hab hweak
    (c.liftEl i) (c.liftEl_mem i) g⁻¹ hmem
  rw [inv_inv, hg] at hnr
  have hnN : n ∈ c.N := hn
  have hn'N : n⁻¹ ∈ c.N := inv_mem hnN
  refine ⟨c.rhoG ⟨n⁻¹, hn'N⟩, hrho _, ?_⟩
  apply liftEl_inj c
  rw [rhoG_spec]
  simpa using hnr

theorem class1_sylow
    (hF : C1Facts2) (hRed : c.Red)
    (hAut : ∀ γ : ↥Sh1 ≃* ↥Sh1, ∀ r : ↥Sh1, (r : Perm (Fin 16)) ∈ RsubP1 →
      ((γ r : ↥Sh1) : Perm (Fin 16)) ∈ RsubP1)
    (Ψ : c.ModelIso hS Sh1 tr1 yHat1) : IsSylow2In S₁ ⊤ := by
  by_contra hns
  have hp : IsPGroup 2 ↥S₁ := IsPGroup.of_card (n := 7) (by rw [hS.card]; norm_num)
  obtain ⟨S', hS', hS₁S'⟩ := exists_sylow2_ge hp (le_top : S₁ ≤ ⊤)
  have hne : S₁ ≠ S' := fun heq => hns (heq ▸ hS')
  obtain ⟨b, hbS', hbN, hbS₁⟩ := exists_normalizer_gt hS'.2.1 hS₁S' hne
  have hbR := class1_normalizer_R hAut Ψ hbN
  exact hbS₁ (mem_of_sylow_normalizes (S1_sylow hF hRed hS) hS'.2.1 hS₁S' hbS' hbR)

