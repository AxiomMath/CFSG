theorem u33_outCent3 :
    ∀ τ ∈ U33.QA.originalSubgroup, τ ^ 2 = 1 → τ ∉ U33.QP.originalSubgroup →
      ∀ ψ ∈ U33.QA.originalSubgroup, (∀ c ∈ U33.QP.originalSubgroup, c ^ 3 = 1 →
        c * τ = τ * c → ψ * c = c * ψ) → ψ = 1 ∨ ψ = τ :=
  Certificates.certificate5002.1

theorem u33_bang :
    ∀ τ ∈ U33.QA.originalSubgroup, τ ^ 2 = 1 → τ ∉ U33.QP.originalSubgroup →
      ∃ l ∈ U33.QP.originalSubgroup, ∃ c₁ ∈ U33.QP.originalSubgroup,
        ∃ c₂ ∈ U33.QP.originalSubgroup, c₁ ^ 3 = 1 ∧ c₂ ^ 3 = 1 ∧ c₁ ≠ 1 ∧ c₂ ≠ 1 ∧
          c₁ * τ = τ * c₁ ∧ c₂ * τ = τ * c₂ ∧ (c₁ * c₂) ^ 2 = 1 ∧ c₁ * c₂ ≠ 1 ∧
          τ * l * τ⁻¹ * l⁻¹ = c₁ * c₂ :=
  Certificates.certificate5002.2.1

theorem u33_innerSq :
    ∀ v ∈ U33.QP.originalSubgroup, v ^ 2 = 1 → v ≠ 1 → ∀ ψ ∈ U33.QA.originalSubgroup,
      (∀ c ∈ U33.QP.originalSubgroup, c ^ 3 = 1 → c * v = v * c → ψ * c = c * ψ) →
      (ψ ^ 2 = 1 ∨ ψ ^ 2 = v) ∧
        (ψ ∈ U33.QP.originalSubgroup → ψ ^ 2 = 1 → ψ = 1 ∨ ψ = v) :=
  Certificates.certificate5002.2.2.1

theorem u33_sylCent :
    ∀ ψ ∈ U33.QA.originalSubgroup, (∀ q ∈ U33.QS.originalSubgroup, q * ψ = ψ * q) →
      ψ ∈ U33.QS.originalSubgroup :=
  Certificates.certificate5002.2.2.2.1

theorem u33_word :
    ∃ a ∈ U33.QP.originalSubgroup, ∃ b ∈ U33.QP.originalSubgroup, a ^ 3 = 1 ∧ b ^ 3 = 1 ∧
      a ≠ 1 ∧ b ≠ 1 ∧ a * U33.s0 = U33.s0 * a ∧ b * U33.s0 = U33.s0 * b ∧
      (a * b) ^ 3 = U33.s0 :=
  Certificates.certificate5002.2.2.2.2.1

theorem u33_sylSq :
    ∀ ψ ∈ U33.QA.originalSubgroup, ψ ∉ U33.QP.originalSubgroup →
      (∀ q ∈ U33.QS.originalSubgroup, ψ * q * ψ⁻¹ ∈ U33.QS.originalSubgroup) →
      ∀ v ∈ U33.QS.originalSubgroup, v ^ 2 = 1 → v ≠ 1 →
      (∀ c ∈ U33.QP.originalSubgroup, c ^ 3 = 1 → c * v = v * c → ψ * c = c * ψ) →
      ψ ^ 2 = v → ∀ q ∈ U33.QS.originalSubgroup, q * v = v * q :=
  Certificates.certificate5002.2.2.2.2.2.1

theorem u33_conj4 :
    ∀ a ∈ U33.QS.originalSubgroup, a ^ 4 = 1 → a ^ 2 ≠ 1 →
      (∀ c ∈ U33.QP.originalSubgroup, c ^ 3 = 1 → c * a ^ 2 = a ^ 2 * c → c * a = a * c) →
      ∃ k ∈ U33.QP.originalSubgroup, k⁻¹ * a * k ∈ U33.QS.originalSubgroup ∧
        ∀ y ∈ U33.QS.originalSubgroup, y * (k⁻¹ * a * k) = (k⁻¹ * a * k) * y :=
  Certificates.certificate5002.2.2.2.2.2.2.1

theorem u33_le : U33.QP.originalSubgroup ≤ U33.QA.originalSubgroup := by
  rw [U33.QP_closure, U33.QA_closure]
  exact U33.P_le_A

theorem u33_exists3 :
    U33.t0 ∈ U33.QP.originalSubgroup ∧ U33.t0 ≠ 1 ∧ U33.t0 ^ 2 = 1 ∧
      ∃ c ∈ U33.QP.originalSubgroup, c ^ 3 = 1 ∧ c ≠ 1 ∧ c * U33.t0 = U33.t0 * c :=
  Certificates.certificate5002.2.2.2.2.2.2.2.1

theorem u33_exp :
    ∀ x ∈ U33.QP.originalSubgroup, x ^ 27 = 1 → x ^ 3 = 1 :=
  Certificates.certificate5002.2.2.2.2.2.2.2.2.1

theorem u33_inner3 :
    ∀ g ∈ U33.QA.originalSubgroup, g ^ 3 = 1 → g ∈ U33.QP.originalSubgroup :=
  Certificates.certificate5002.2.2.2.2.2.2.2.2.2

theorem u33_model
    {K : Type} [Group K] (hK : ShapeU33 K) :
    ∃ M : AutModel K (Equiv.Perm (Fin 28)), M.P = U33.QP.originalSubgroup ∧
      M.A = U33.QA.originalSubgroup ∧ M.P ≤ M.A ∧ Nonempty (K ≃* U33.QP.originalSubgroup) := by
  obtain ⟨e⟩ := U33.equiv_of_lieModel hK
  obtain ⟨M, hP, hA⟩ := U33.autModel e
  refine ⟨M, hP, hA, ?_, ⟨e⟩⟩
  rw [hP, hA]
  exact u33_le

theorem outerTable_U33
    {K : Type} [Group K] (hK : ShapeU33 K) : OuterTable K := by
  obtain ⟨M, hP, hA, hPA, -⟩ := u33_model hK
  refine outerTable_of_model M hPA ?_ ?_ ?_
  · rw [hA, hP]
    exact u33_outCent3
  · rw [hA, hP]
    exact u33_bang
  · rw [hA, hP]
    exact u33_innerSq

theorem outerSylowTable_U33
    {K : Type} [Group K] (hK : ShapeU33 K) (Q : Subgroup K)
    (hQ : IsPGroup 2 Q) (hQi : ¬ 2 ∣ Q.index) : OuterSylowTable K Q := by
  obtain ⟨M, hP, hA, hPA, ⟨e⟩⟩ := u33_model hK
  have : Finite K := U33.finite_K' e
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hSP : U33.QS.originalSubgroup ≤ M.P := by
    rw [hP]
    exact U33.QS_le
  obtain ⟨e', he'⟩ := exists_iso_of_sylow M.P M.e U33.QS.originalSubgroup hSP U33.card_S
    (U33.card_K e) (by decide) (hQ.toSylow hQi)
  have hs := smallCheck_sound U33.QS U33.QS_ok U33.small_ok
  have hcent : ∀ ψ ∈ M.A, (∀ q ∈ U33.QS.originalSubgroup, q * ψ = ψ * q) →
      ψ ∈ U33.QS.originalSubgroup := by
    rw [hA]
    exact u33_sylCent
  have hword : ∃ a ∈ M.P, ∃ b ∈ M.P, a ^ 3 = 1 ∧ b ^ 3 = 1 ∧ a ≠ 1 ∧ b ≠ 1 ∧
      a * U33.s0 = U33.s0 * a ∧ b * U33.s0 = U33.s0 * b ∧ (a * b) ^ 3 = U33.s0 := by
    rw [hP]
    exact u33_word
  have hsq : ∀ ψ ∈ M.A, ψ ∉ M.P →
      (∀ q ∈ U33.QS.originalSubgroup, ψ * q * ψ⁻¹ ∈ U33.QS.originalSubgroup) →
      ∀ v ∈ U33.QS.originalSubgroup, v ^ 2 = 1 → v ≠ 1 →
      (∀ c ∈ M.P, c ^ 3 = 1 → c * v = v * c → ψ * c = c * ψ) → ψ ^ 2 = v →
      ∀ q ∈ U33.QS.originalSubgroup, q * v = v * q := by
    rw [hA, hP]
    exact u33_sylSq
  have hconj4 : ∀ a ∈ U33.QS.originalSubgroup, a ^ 4 = 1 → a ^ 2 ≠ 1 →
      (∀ c ∈ M.P, c ^ 3 = 1 → c * a ^ 2 = a ^ 2 * c → c * a = a * c) →
      ∃ k ∈ M.P, k⁻¹ * a * k ∈ U33.QS.originalSubgroup ∧
        ∀ y ∈ U33.QS.originalSubgroup, y * (k⁻¹ * a * k) = (k⁻¹ * a * k) * y := by
    rw [hP]
    exact u33_conj4
  exact outerSylowTable_of_model (AM.twist M e') hPA hSP he'
    ⟨U33.s0, hs.1, hs.2.1, hs.2.2.1, hs.2.2.2.1, hs.2.2.2.2.2, hcent, hword⟩ hsq hconj4

theorem rank3Data_U33 :
    Rank3Data ShapeU33 := by
  intro K _ _ hK
  obtain ⟨M, hP, hA, hPA, ⟨e⟩⟩ := u33_model hK
  have : Finite K := U33.finite_K' e
  obtain ⟨htP, ht1, ht2, hex⟩ := u33_exists3
  refine ⟨rank3Table_of_model U33.QP.originalSubgroup e U33.t0 htP ht2 ht1 (U33.one_class e) hex
    ?_ u33_exp, ?_⟩
  · intro S
    have : Fact (Nat.Prime 3) := ⟨by norm_num⟩
    have hcard : Nat.card K = 3 ^ 3 * 224 := by rw [U33.card_K e]; norm_num
    rw [sylow_card_of hcard (by norm_num) S]
    norm_num
  · intro φ hφ
    exact M.inner3 (fun g hg h3 => by rw [hP]; rw [hA] at hg; exact u33_inner3 g hg h3) φ hφ

theorem noPairU33O_of
    (hZD : S_CorZD) (hD3 : K0Data3) (hS : SmallData ShapeU33) : NoPairU33O := by
  intro G _ _ T z L hcfg hterm hsh _
  have hZ : Subgroup.center ↥L = ⊥ := hD3.center_bot ↥L (Or.inr (Or.inl hsh))
  obtain ⟨U, hU, hr⟩ := hD3.rank_ge3 ↥L (Or.inr (Or.inl hsh))
  have hR3 : Rank3Sub L := Rank3Sub.of_table (rank3Data_U33 ↥L hsh).1 (rank3Data_U33 ↥L hsh).2
  have hO : OuterSub L := OuterSub.of_table (outerTable_U33 hsh)
  have hSyl : OuterSylow L ((T : Subgroup G) ⊓ L) := by
    have hsyl := hcfg.isSylowOf_inf
    rw [CFSG.ABGLocalTools.isSylowOf_iff] at hsyl
    exact OuterSylow.of_table inf_le_right
      (outerSylowTable_U33 hsh _ hsyl.2.1.comap_subtype hsyl.2.2)
  exact hcfg.false_of_outer hZD hterm hZ hR3 hO (hcfg.smallTable hS hsh) hSyl
    (Or.inl (hcfg.tC_cyclic hZ hU hr))

