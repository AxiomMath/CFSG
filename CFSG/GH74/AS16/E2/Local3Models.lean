namespace CFSG.GH74.AS16.E2

open CFSG.Certificates CFSG.Sporadic.Schreier CFSG.Blueprint CFSG.GH74.KGroups
open CFSG.GH74.E2 hiding Hyp

theorem m11_local3_ok :
    local3Check (elemsT M11.Q) M11.t0 = true :=
  Certificates.certificate5000.1

theorem m11_exp_ok :
    expCheck (elemsT M11.Q) 27 3 = true :=
  Certificates.certificate5000.2.1

theorem l33_local3_ok :
    local3Check (elemsT L33.QP) L33.t0 = true :=
  Certificates.certificate5000.2.2.1

theorem l33_exp_ok :
    expCheck (elemsT L33.QP) 27 3 = true :=
  Certificates.certificate5000.2.2.2

theorem local3Data_M11 :
    Local3Data ShapeM11 := by
  intro K _ _ hK
  obtain ⟨e⟩ := M11.equiv_of_sporadic hK
  obtain ⟨htP, ht1, ht2, hex, hcent⟩ := local3Check_sound M11.Q M11.Q_ok m11_local3_ok
  refine local3Table_of_model M11.Q.originalSubgroup e M11.t0 htP ht2 ht1 (M11.one_class e) hex
    hcent ?_ (expCheck_sound M11.Q M11.Q_ok m11_exp_ok)
  intro S
  have : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have hcard : Nat.card K = 3 ^ 2 * 880 := by rw [M11.card_K e]; norm_num
  rw [sylow_card_of hcard (by norm_num) S]
  norm_num

theorem local3Data_L33 :
    Local3Data ShapeL33 := by
  intro K _ _ hK
  obtain ⟨e⟩ := L33.equiv_of_lieModel hK
  obtain ⟨htP, ht1, ht2, hex, hcent⟩ := local3Check_sound L33.QP L33.QP_ok l33_local3_ok
  refine local3Table_of_model L33.QP.originalSubgroup e L33.t0 htP ht2 ht1 (L33.one_class e) hex
    hcent ?_ (expCheck_sound L33.QP L33.QP_ok l33_exp_ok)
  intro S
  have : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have hcard : Nat.card K = 3 ^ 3 * 208 := by rw [L33.card_K e]; norm_num
  rw [sylow_card_of hcard (by norm_num) S]
  norm_num

end CFSG.GH74.AS16.E2
