@[expose] def tmul (s t : List Nat) : List Nat := t.map fun j => s.getD j 0

@[expose] def tid : List Nat := List.range 12

@[expose] def tinv (s : List Nat) : List Nat := (List.range 12).map fun j => s.idxOf j

@[expose] def tpow (s : List Nat) : Nat → List Nat
  | 0 => tid
  | n + 1 => tmul s (tpow s n)

@[expose] def tcomm (s t : List Nat) : List Nat := tmul (tinv (tmul s t)) (tmul t s)

@[expose] def ET : List Nat := [1, 3, 0, 2, 5, 11, 4, 6, 10, 8, 7, 9]

@[expose] def NT : List Nat := [3, 1, 2, 0, 4, 6, 5, 11, 8, 10, 9, 7]

@[expose] def FT : List Nat := [0, 2, 1, 3, 5, 7, 4, 9, 10, 8, 11, 6]

@[expose] def XT : List Nat := tmul (tmul (tmul (tinv ET) FT) ET) (tinv FT)

@[expose] def JT : List Nat := [0, 1, 2, 3, 8, 10, 9, 11, 4, 6, 5, 7]

@[expose] def g1T : List Nat := [2, 1, 0, 3, 8, 11, 6, 10, 4, 9, 7, 5]

@[expose] def g2T : List Nat := [1, 2, 0, 3, 9, 10, 11, 8, 6, 7, 5, 4]

@[expose] def g3T : List Nat := [1, 3, 2, 0, 10, 11, 6, 4, 5, 9, 7, 8]

@[expose] def gensT : List (List Nat) := [g1T, g2T, g3T]

