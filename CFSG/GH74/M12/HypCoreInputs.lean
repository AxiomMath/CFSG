@[expose] def bfT (i j k m : Nat) : List Nat :=
  tmul (tmul (tpow ET i) (tpow NT j)) (tmul (tpow XT k) (tpow FT m))

@[expose] def BT : List (List Nat) :=
  (List.range 64).map fun n => bfT (n / 32) ((n / 16) % 2) ((n / 8) % 2) (n % 8)

