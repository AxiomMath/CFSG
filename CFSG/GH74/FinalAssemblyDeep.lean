theorem GLS.Stage12.specialOdd_of_stages_StdG5
    (hSUS : S_SUS_KGH) (hC3 : S_C3_gen4)
    (hP27 : Prop27.S_prop27G) (hTT : S_twoThinOfB2G) (hS4 : Stage12.S_stage4_Std)
    (hCh6 : Stage12.S_ch6_Std) (hS5 : Stage12.S_C2starFour_Std) (hAsc : M12.S_Asc03_simple) :
    S_specialOdd := by
  intro G _ _ hs hnonab hrank hgen hK hsyl _ hSO
  have hG := isKProperSimple_of_kgh hs hnonab hK
  have h3 : 3 ≤ pRank 2 G := by
    rw [pRank_two_eq_twoRank]
    exact hrank
  have h4 : pRank 2 G ≤ 4 := hgen.pRank_two_le
  exact c23List_of_lb2_branch_gen4 hG hgen hK hSO hC3 fun hLB =>
    Stage12.c23List_of_isLB2Type_rank34_StdG hSUS hP27 hTT hS4 hCh6 hS5 hAsc hgen hK hsyl hG h3 h4
      hLB

