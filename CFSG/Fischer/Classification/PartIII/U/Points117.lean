@[expose] def enc6 (w : Fin 6 → ZMod 3) : ℕ :=
  (w 0).val + 3 * ((w 1).val + 3 * ((w 2).val + 3 * ((w 3).val + 3 * ((w 4).val +
    3 * (w 5).val))))

@[expose] def idx6 (w : Fin 6 → ZMod 3) : Fin 117 := tab6.getD (enc6 w) 0

theorem dot6_pt6 : ∀ i : Fin 117, dot6 2 (pt6 i) (pt6 i) = 1 := by
  decide +kernel

theorem pt6_idx6 : ∀ a b c d e g : ZMod 3,
    dot6 2 ![a, b, c, d, e, g] ![a, b, c, d, e, g] = 1 →
      pt6 (idx6 ![a, b, c, d, e, g]) = ![a, b, c, d, e, g] ∨
        pt6 (idx6 ![a, b, c, d, e, g]) = -![a, b, c, d, e, g] := by
  decide +kernel

theorem idx6_pt6 : ∀ i : Fin 117, idx6 (pt6 i) = i ∧ idx6 (-pt6 i) = i := by
  decide +kernel

theorem vec6_eq (w : Fin 6 → ZMod 3) : w = ![w 0, w 1, w 2, w 3, w 4, w 5] := by
  ext i
  fin_cases i <;> rfl

theorem diagF3_six_apply (δ : ZMod 3) (x y : Fin 6 → ZMod 3) :
    diagF3 6 δ x y = dot6 δ x y := by
  rw [diagF3_apply, Fin.sum_univ_six, dot6]
  simp only [diagF3Entry]
  norm_num

theorem ncard_D3_diagF3_six_two : (D3 (diagF3 6 2)).ncard = 117 := by
  have hb := Beta.bijective_reflBar_of_reps (isF3Form_diagF3 (m := 6) (δ := 2) (by decide))
    (by norm_num) pt6 idx6 (fun i => by rw [diagF3_six_apply]; exact dot6_pt6 i) idx6_pt6
    fun w hw => by
      rw [diagF3_six_apply, vec6_eq w] at hw
      rw [vec6_eq w]
      exact pt6_idx6 _ _ _ _ _ _ hw
  rw [← Nat.card_coe_set_eq, ← Nat.card_eq_of_bijective _ hb, Nat.card_eq_fintype_card,
    Fintype.card_fin]

