@[expose] def encU (v : Fin 4 → F4) : ℕ :=
  (v 0).code.val + 4 * ((v 1).code.val + 4 * ((v 2).code.val + 4 * (v 3).code.val))

@[expose] def encO (w : Fin 5 → ZMod 3) : ℕ :=
  (w 0).val + 3 * ((w 1).val + 3 * ((w 2).val + 3 * ((w 3).val + 3 * (w 4).val)))

@[expose] def uIdx (v : Fin 4 → F4) : Fin 45 := uTab.getD (encU v) 0

@[expose] def oIdx (w : Fin 5 → ZMod 3) : Fin 45 := oTab.getD (encO w) 0

@[expose] def qIdx (w : Fin 5 → ZMod 3) : Fin 36 := qTab.getD (encO w) 0

@[expose] def hU (x y : Fin 4 → F4) : F4 :=
  x 0 * x 0 * y 0 + x 1 * x 1 * y 1 + x 2 * x 2 * y 2 + x 3 * x 3 * y 3

@[expose] def tU (a b : Fin 4 → F4) : Fin 4 → F4 := b + hU a b • a

@[expose] def dot5 (δ : ZMod 3) (x y : Fin 5 → ZMod 3) : ZMod 3 :=
  x 0 * y 0 + x 1 * y 1 + x 2 * y 2 + x 3 * y 3 + δ * x 4 * y 4

@[expose] def rO (w v : Fin 5 → ZMod 3) : Fin 5 → ZMod 3 := v + dot5 1 v w • w

theorem uPt_spec : ∀ i : Fin 45, uPt i ≠ 0 ∧ hU (uPt i) (uPt i) = 0 := by
  decide +kernel

theorem dot5_oPt : ∀ i : Fin 45, dot5 1 (oPt i) (oPt i) = 1 := by
  decide +kernel

theorem dot5_qPt : ∀ i : Fin 36, dot5 2 (qPt i) (qPt i) = 1 := by
  decide +kernel

theorem exists_eq_smul_uPt : ∀ a b c d : F4, ![a, b, c, d] ≠ 0 →
    hU ![a, b, c, d] ![a, b, c, d] = 0 →
      ∃ t : F4, ![a, b, c, d] = t • uPt (uIdx ![a, b, c, d]) := by
  decide +kernel

theorem uIdx_smul_uPt : ∀ i : Fin 45, ∀ t : F4, t ≠ 0 → uIdx (t • uPt i) = i := by
  decide +kernel

theorem oPt_oIdx : ∀ a b c d e : ZMod 3, dot5 1 ![a, b, c, d, e] ![a, b, c, d, e] = 1 →
    oPt (oIdx ![a, b, c, d, e]) = ![a, b, c, d, e] ∨
      oPt (oIdx ![a, b, c, d, e]) = -![a, b, c, d, e] := by
  decide +kernel

theorem oIdx_oPt : ∀ i : Fin 45, oIdx (oPt i) = i ∧ oIdx (-oPt i) = i := by
  decide +kernel

theorem qPt_qIdx : ∀ a b c d e : ZMod 3, dot5 2 ![a, b, c, d, e] ![a, b, c, d, e] = 1 →
    qPt (qIdx ![a, b, c, d, e]) = ![a, b, c, d, e] ∨
      qPt (qIdx ![a, b, c, d, e]) = -![a, b, c, d, e] := by
  decide +kernel

theorem qIdx_qPt : ∀ i : Fin 36, qIdx (qPt i) = i ∧ qIdx (-qPt i) = i := by
  decide +kernel

theorem oPt_uIdx_tU : ∀ i j : Fin 45, oPt (uIdx (tU (uPt i) (uPt j))) = rO (oPt i) (oPt j) ∨
    oPt (uIdx (tU (uPt i) (uPt j))) = -rO (oPt i) (oPt j) := by
  decide +kernel

