local instance (priority := high) decEqF4 : DecidableEq F4 := fun a b =>
  decidable_of_iff (a.code = b.code) (by cases a; cases b; simp)

@[expose] def u4 (a b c d : Fin 4) : Fin 4 → F4 := ![⟨a⟩, ⟨b⟩, ⟨c⟩, ⟨d⟩]

