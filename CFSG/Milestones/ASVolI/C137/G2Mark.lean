@[expose] noncomputable def burnsideC137_projOQ : ModO →* ModQ :=
  QuotientGroup.map
    ((⊥ : Subgroup (Multiplicative (quasithinZorn (ZMod 2)))).subgroupOf (zornO0 (ZMod 2)))
    ((zornR (ZMod 2)).subgroupOf (zornO0 (ZMod 2))) (MonoidHom.id _) (by
      rw [Subgroup.bot_subgroupOf]
      exact bot_le)

theorem burnsideC137_projOQ_surjective : Function.Surjective burnsideC137_projOQ := by
  intro q
  obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective q
  exact ⟨QuotientGroup.mk x, rfl⟩

theorem burnsideC137_projOQ_act (γ : ↥(quasithinG2 (ZMod 2))) (m : ModO) :
    burnsideC137_projOQ (g2OAct (ZMod 2) γ m) = g2QAct (ZMod 2) γ (burnsideC137_projOQ m) := by
  obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective m
  rfl

theorem burnsideC137_act_eq_of_projOQ (γ : ↥(quasithinG2 (ZMod 2))) {m : ModO}
    (hm : burnsideC137_projOQ m = 1) : g2OAct (ZMod 2) γ m = m := by
  obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective m
  set y : ↥(zornO0 (ZMod 2)) := x with hy
  have hm' : (QuotientGroup.mk (s := (zornR (ZMod 2)).subgroupOf (zornO0 (ZMod 2))) y : ModQ) = 1 :=
    hm
  obtain ⟨c, hc⟩ : (y : Multiplicative (quasithinZorn (ZMod 2))) ∈ zornR (ZMod 2) :=
    (QuotientGroup.eq_one_iff y).1 hm'
  change (QuotientGroup.mk _ : ModO) = QuotientGroup.mk x
  congr 1
  apply Subtype.ext
  change Multiplicative.ofAdd ((γ : quasithinZorn (ZMod 2) ≃ₗ[ZMod 2] quasithinZorn (ZMod 2))
    (Multiplicative.toAdd (y : Multiplicative (quasithinZorn (ZMod 2))))) = y
  have hx : Multiplicative.toAdd (y : Multiplicative (quasithinZorn (ZMod 2))) =
      c • (H13.Orbit.zornOne : quasithinZorn (ZMod 2)) := by
    rw [show Multiplicative.toAdd (y : Multiplicative (quasithinZorn (ZMod 2))) = (c, 0, 0, c)
      from hc]
    ext <;> simp [H13.Orbit.zornOne]
  rw [hx, LinearEquiv.map_smul, H13.Orbit.quasithinG2_one γ.2, ← hx]
  rfl

theorem burnsideC137_frame_eq {W M : Type} [CommGroup W] [CommGroup M] [Finite W] [Finite M]
    (e : W ≃* M) {X₀ L₀ : Subgroup (MulAut W)} {Gm Lm : Subgroup (MulAut M)}
    (hL : L₀.map (cg e) = Lm) (hXle : X₀.map (cg e) ≤ Gm) (hLX : L₀ ≤ X₀)
    (hcard : Nat.card ↥L₀ = 6048) (hoff : ∃ A, IsFFStarOffender X₀ A) (h : G2Facts Gm Lm) :
    X₀.map (cg e) = Gm := by
  have hL' : Lm ≤ X₀.map (cg e) := hL ▸ Subgroup.map_mono hLX
  have hGL : Nat.card ↥Gm = 2 * Nat.card ↥Lm := by
    rw [h.card_X, ← hL, card_map_cg, hcard]
  have hne : ¬ X₀.map (cg e) ≤ Lm := by
    intro hle
    obtain ⟨A, hAX, hA1, hAe, hbest⟩ := hoff
    have hAm : A.map (cg e) ≤ Lm := (Subgroup.map_mono hAX).trans hle
    refine h.no_off (A.map (cg e)) hAm
      (fun h0 => hA1 ((Subgroup.map_eq_bot_iff_of_injective A (cg_injective e)).1 h0))
      ((isElemAbelian2_map_cg_iff e).2 hAe) ?_
    have h0 := hbest ⊥ bot_le
    rw [Subgroup.card_bot, B1.fixV_bot, Subgroup.card_top, one_mul] at h0
    rw [card_map_cg, card_fixV_map_cg, ← Nat.card_congr e.toEquiv]
    exact h0
  exact eq_of_sandwich hL' hXle hGL hne

@[expose] def burnsideC137_G2Marking {W : Type} [CommGroup W] (X₀ : Subgroup (MulAut W))
    (Z : Subgroup W) : Prop :=
  ∃ f : W →* ModQ, Function.Surjective f ∧ (∀ w, f w = 1 ↔ w ∈ Z) ∧
    (∀ h ∈ X₀, (∀ w, f (h w) = f w) → h = 1) ∧
    (∀ h ∈ X₀, ∃ δ, ∀ w, f (h w) = g2QAct (ZMod 2) δ (f w)) ∧
    (∀ δ, ∃ h ∈ X₀, ∀ w, f (h w) = g2QAct (ZMod 2) δ (f w))

theorem burnsideC137_g2Marking (hcov : G2NaturalCover) (hnorm : G2DerivedNormalizerZorn)
    (hfacts : U33G2Facts) {W : Type} [CommGroup W] [Finite W] (hW : ∀ w : W, w ^ 2 = 1)
    {X₀ L₀ : Subgroup (MulAut W)} (hLX : L₀ ≤ X₀)
    (hXN : X₀ ≤ normalizer (L₀ : Set (MulAut W)))
    (hcomm : commV L₀ = ⊤) (hnat : G2NaturalDerived L₀ ⊤ (fixV L₀) 1)
    (hcard : Nat.card ↥L₀ = 6048) (hoff : ∃ A, IsFFStarOffender X₀ A) :
    burnsideC137_G2Marking X₀ (fixV L₀) := by
  rcases hcov W hW L₀ (fixV L₀) le_rfl hcomm hnat with hZ | ⟨hZ2, hW7, hWeyl⟩
  ·
    have hnat' := hnat
    rw [hZ] at hnat'
    obtain ⟨K, _, _, hK, hR⟩ := hnat'
    have hK2 : Nat.card K = 2 := by rw [hK, pow_one]
    have := charP_two_of_natCard_two hK2
    obtain ⟨π, β, hβ⟩ := (realizes_iff _ L₀ ⊤ ⊥).1 hR
    let e : W ≃* (FFModel.zornQ (quasithinG2 K)).Mod :=
      realizeEquiv (D := FFModel.zornQ ⁅quasithinG2 K, quasithinG2 K⁆) hβ
    have hL := map_congr_eq_of_equivariant e π hβ.1 (g2QAct K)
      (fun γ => ⟨γ.1, Subgroup.commutator_le_self _ γ.2⟩) (realizeEquiv_zornQ hβ) _
      (mem_map_g2Derived_iff (g2QAct K))
    have : Finite (FFModel.zornQ (quasithinG2 K)).Mod := Finite.of_equiv W e.toEquiv
    have hX := burnsideC137_frame_eq e hL (map_le_of_normalizer e hXN _ _ hL (hnorm K hK2).1)
      hLX hcard hoff (hfacts K hK2).1
    let e₂ : W ≃* ModQ := e.trans (modQEquivK hK2).symm
    have hcg : ∀ g : ↥(quasithinG2 K), ∀ (h : MulAut W), cg e h = g2QAct K g →
        ∀ w, e₂ (h w) = g2QAct (ZMod 2) (conjF2Hom hK2 g) (e₂ w) := by
      intro g h hh w
      rw [conjF2Hom_apply, ← congr_modQEquivK_symm hK2 g, ← hh]
      simp [e₂, cg, MulAut.congr_apply]
    refine ⟨e₂.toMonoidHom, e₂.surjective, fun w => ?_, fun h _ hh => ?_, fun h hh => ?_,
      fun δ => ?_⟩
    · rw [hZ, Subgroup.mem_bot]
      exact ⟨fun h1 => e₂.injective (by rw [map_one]; exact h1), fun h1 => by
        rw [h1]
        exact map_one e₂.toMonoidHom⟩
    · ext w
      exact e₂.injective (hh w)
    · have hmem : cg e h ∈ (g2QAct K).range := hX ▸ ⟨h, hh, rfl⟩
      obtain ⟨g, hg⟩ := hmem
      exact ⟨conjF2Hom hK2 g, hcg g h hg.symm⟩
    · obtain ⟨g, rfl⟩ := conjF2Hom_surjective hK2 δ
      have hmem : g2QAct K g ∈ X₀.map (cg e) := hX ▸ ⟨g, rfl⟩
      obtain ⟨h, hh, hhg⟩ := hmem
      exact ⟨h, hh, hcg g h hhg⟩
  ·
    obtain ⟨K, _, _, hK2, hR⟩ := hWeyl
    have := charP_two_of_natCard_two hK2
    obtain ⟨π, β, hβ⟩ := (realizes_iff _ L₀ ⊤ ⊥).1 hR
    let e : W ≃* (zornO0Model (quasithinG2 K)).Mod :=
      realizeEquiv (D := zornO0Model ⁅quasithinG2 K, quasithinG2 K⁆) hβ
    have hL := map_congr_eq_of_equivariant e π hβ.1 (g2OAct K)
      (fun γ => ⟨γ.1, Subgroup.commutator_le_self _ γ.2⟩) (realizeEquiv_zornO0 hβ) _
      (mem_map_g2Derived_iff (g2OAct K))
    have : Finite (zornO0Model (quasithinG2 K)).Mod := Finite.of_equiv W e.toEquiv
    have hX := burnsideC137_frame_eq e hL (map_le_of_normalizer e hXN _ _ hL (hnorm K hK2).2)
      hLX hcard hoff (hfacts K hK2).2
    let e₂ : W ≃* ModO := e.trans (modOEquivK hK2).symm
    have hcg : ∀ g : ↥(quasithinG2 K), ∀ (h : MulAut W), cg e h = g2OAct K g →
        ∀ w, e₂ (h w) = g2OAct (ZMod 2) (conjF2Hom hK2 g) (e₂ w) := by
      intro g h hh w
      rw [conjF2Hom_apply, ← congr_modOEquivK_symm hK2 g, ← hh]
      simp [e₂, cg, MulAut.congr_apply]
    let f : W →* ModQ := burnsideC137_projOQ.comp e₂.toMonoidHom
    have hfs : Function.Surjective f :=
      burnsideC137_projOQ_surjective.comp e₂.surjective
    have hfX : ∀ h ∈ X₀, ∃ γ : ↥(quasithinG2 (ZMod 2)), ∀ w, e₂ (h w) = g2OAct (ZMod 2) γ (e₂ w) := by
      intro h hh
      have hmem : cg e h ∈ (g2OAct K).range := hX ▸ ⟨h, hh, rfl⟩
      obtain ⟨g, hg⟩ := hmem
      exact ⟨conjF2Hom hK2 g, hcg g h hg.symm⟩
    have hker : ∀ w, f w = 1 → w ∈ fixV L₀ := by
      intro w hw l hl
      obtain ⟨γ, hγ⟩ := hfX l (hLX hl)
      apply e₂.injective
      rw [hγ]
      exact burnsideC137_act_eq_of_projOQ γ hw
    have hkcard : Nat.card ↥f.ker = 2 := by
      have h1 := Subgroup.card_eq_card_quotient_mul_card_subgroup f.ker
      rw [Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective f hfs).toEquiv, card_ModQ,
        hW7] at h1
      omega
    have hkeq : f.ker = fixV L₀ :=
      Subgroup.eq_of_le_of_card_ge (fun w hw => hker w hw) (by rw [hkcard, hZ2])
    refine ⟨f, hfs, fun w => ?_, fun h hh hfix => ?_, fun h hh => ?_, fun δ => ?_⟩
    · rw [← hkeq, MonoidHom.mem_ker]
    · obtain ⟨γ, hγ⟩ := hfX h hh
      have hγ1 : g2QAct (ZMod 2) γ = 1 := by
        ext q
        obtain ⟨w, rfl⟩ := hfs q
        have h1 := hfix w
        simp only [f, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom] at h1 ⊢
        rw [MulAut.one_apply, ← burnsideC137_projOQ_act, ← hγ]
        exact h1
      have hγ1' : γ = 1 := g2QAct_injective (by rw [hγ1, map_one])
      ext w
      apply e₂.injective
      rw [hγ, hγ1', map_one, MulAut.one_apply, MulAut.one_apply]
    · obtain ⟨γ, hγ⟩ := hfX h hh
      refine ⟨γ, fun w => ?_⟩
      simp only [f, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom]
      rw [hγ, burnsideC137_projOQ_act]
    · obtain ⟨g, rfl⟩ := conjF2Hom_surjective hK2 δ
      have hmem : g2OAct K g ∈ X₀.map (cg e) := hX ▸ ⟨g, rfl⟩
      obtain ⟨h, hh, hhg⟩ := hmem
      refine ⟨h, hh, fun w => ?_⟩
      simp only [f, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom]
      rw [hcg g h hhg, burnsideC137_projOQ_act]

