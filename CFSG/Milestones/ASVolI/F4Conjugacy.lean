theorem burnsideF4gG2Two_polygon_derived {E : Type} [Group E] {Gp M₁ M₂ : Subgroup E}
    (hyp : CFSG.ASVolI.ChF.HypF_4_4 .G2d 2 1 Gp M₁ M₂) :
