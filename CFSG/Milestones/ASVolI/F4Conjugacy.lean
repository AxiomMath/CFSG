section PCoreNormalizer

variable {G : Type} [Group G] [Finite G]

theorem burnsideF4gD4Inv_pCoreOf_normalizer {U : Subgroup G}
    (hU : CFSG.QuasithinUnique.IsSylowTwoOf U ⊤) :
    pCoreOf 2 (Subgroup.normalizer (U : Set G)) = U := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set N := Subgroup.normalizer (U : Set G) with hN
  have hUN : U ≤ N := Subgroup.le_normalizer
  have hUp : IsPGroup 2 U := hU.2.1
  have hodd : ¬ 2 ∣ U.index := by
    have h := hU.2.2
    rwa [← Subgroup.relIndex, Subgroup.relIndex_top_right] at h
  have hU'p : IsPGroup 2 (U.subgroupOf N) := hUp.comap_subtype
  have hodd' : ¬ 2 ∣ (U.subgroupOf N).index := fun h =>
    hodd (h.trans (Subgroup.relIndex_dvd_index_of_le hUN))
  have hnorm : (U.subgroupOf N).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hUN).2 le_rfl
  apply le_antisymm
  · rintro _ ⟨y, hy, rfl⟩
    have hle := IsPGroup.le_sylow_of_normal (CFSG.pCore_isPGroup (p := 2) (G := ↥N))
      (hU'p.toSylow hodd')
    exact hle hy
  · intro u hu
    have h1 : (⟨u, hUN hu⟩ : ↥N) ∈ CFSG.pCore 2 ↥N :=
      le_sSup (show U.subgroupOf N ∈ {K : Subgroup ↥N | K.Normal ∧ IsPGroup 2 K} from
        ⟨hnorm, hU'p⟩) (show (⟨u, hUN hu⟩ : ↥N) ∈ U.subgroupOf N from hu)
    exact ⟨⟨u, hUN hu⟩, h1, rfl⟩

theorem burnsideF4gD4Inv_le_pCoreOf {K N : Subgroup G} (hNK : N ≤ K)
    (hnorm : ∀ k ∈ K, ∀ n ∈ N, k * n * k⁻¹ ∈ N) (hp : IsPGroup 2 N) : N ≤ pCoreOf 2 K := by
  have hn : (N.subgroupOf K).Normal := ⟨fun n hn k => by
    rw [Subgroup.mem_subgroupOf] at hn ⊢
    exact hnorm k.1 k.2 n.1 hn⟩
  have hp' : IsPGroup 2 (N.subgroupOf K) := hp.comap_subtype
  intro u hu
  have h1 : (⟨u, hNK hu⟩ : ↥K) ∈ CFSG.pCore 2 ↥K :=
    le_sSup (show N.subgroupOf K ∈ {L : Subgroup ↥K | L.Normal ∧ IsPGroup 2 L} from ⟨hn, hp'⟩)
      (show (⟨u, hNK hu⟩ : ↥K) ∈ N.subgroupOf K from hu)
  exact ⟨⟨u, hNK hu⟩, h1, rfl⟩

end PCoreNormalizer

section OPPrime

open CFSG.ASVolI.ChF

variable {G : Type} [Group G]

theorem burnsideF4gD4Inv_orderOf_of_isPGroup {H : Subgroup G} (hH : IsPGroup 2 H) {x : G}
    (hx : x ∈ H) : ∃ k : ℕ, orderOf x = 2 ^ k := by
  obtain ⟨n, hn⟩ := hH ⟨x, hx⟩
  have h1 : x ^ (2 ^ n) = 1 := by simpa using congrArg Subtype.val hn
  obtain ⟨k, -, hk⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 (orderOf_dvd_of_pow_eq_one h1)
  exact ⟨k, hk⟩

theorem burnsideF4gD4Inv_le_oPPrime {P Q : Subgroup G} (hQP : Q ≤ P) (hQ : IsPGroup 2 Q) :
    Q ≤ oPPrime 2 P := fun x hx =>
  Subgroup.subset_closure ⟨hQP hx, burnsideF4gD4Inv_orderOf_of_isPGroup hQ hx⟩

theorem burnsideF4gD4Inv_isSylowTwoOf_of_le {U P : Subgroup G}
    (hU : CFSG.QuasithinUnique.IsSylowTwoOf U ⊤) (hUP : U ≤ P) :
    CFSG.QuasithinUnique.IsSylowTwoOf U P := by
  refine ⟨hUP, hU.2.1, fun h => hU.2.2 ?_⟩
  have h1 := Subgroup.relIndex_mul_relIndex U P ⊤ hUP le_top
  have h' : 2 ∣ U.relIndex P := h
  have h2 := Dvd.dvd.mul_right h' (P.relIndex ⊤)
  rw [h1] at h2
  exact h2

theorem burnsideF4gD4Inv_oPPrime_le_of_sylow [Finite G] {P N S : Subgroup G} (hNP : N ≤ P)
    (hnorm : ∀ g ∈ P, ∀ n ∈ N, g * n * g⁻¹ ∈ N)
    (hS : CFSG.QuasithinUnique.IsSylowTwoOf S P) (hSN : S ≤ N) : oPPrime 2 P ≤ N := by
  have hodd : ¬ 2 ∣ N.relIndex P := fun h =>
    hS.2.2 (h.trans (Subgroup.relIndex_dvd_of_le_left P hSN))
  haveI : (N.subgroupOf P).Normal := ⟨fun n hn k => by
    rw [Subgroup.mem_subgroupOf] at hn ⊢
    exact hnorm k.1 k.2 n.1 hn⟩
  refine (Subgroup.closure_le _).2 ?_
  rintro x ⟨hxP, k, hk⟩
  have h1 : (⟨x, hxP⟩ : ↥P) ^ (2 ^ k) = 1 :=
    Subtype.ext (by simpa [← hk] using pow_orderOf_eq_one x)
  have hq : (QuotientGroup.mk (⟨x, hxP⟩ : ↥P) : ↥P ⧸ N.subgroupOf P) ^ (2 ^ k) = 1 := by
    rw [← QuotientGroup.mk_pow, h1, QuotientGroup.mk_one]
  have hd1 := orderOf_dvd_of_pow_eq_one hq
  have hd2 : orderOf (QuotientGroup.mk (⟨x, hxP⟩ : ↥P) : ↥P ⧸ N.subgroupOf P) ∣
      Nat.card (↥P ⧸ N.subgroupOf P) := orderOf_dvd_natCard _
  rw [← Subgroup.index_eq_card] at hd2
  have hcop : Nat.Coprime (2 ^ k) (N.subgroupOf P).index :=
    ((Nat.Prime.coprime_iff_not_dvd Nat.prime_two).2 hodd).pow_left k
  have h2 : orderOf (QuotientGroup.mk (⟨x, hxP⟩ : ↥P) : ↥P ⧸ N.subgroupOf P) = 1 :=
    Nat.dvd_one.1 (hcop ▸ Nat.dvd_gcd hd1 hd2)
  rw [orderOf_eq_one_iff, QuotientGroup.eq_one_iff] at h2
  exact h2

theorem burnsideF4gD4Inv_mem_oPPrime_subgroupOf {C N : Subgroup G} (hN : N ≤ C) (x : ↥C) :
    x ∈ oPPrime 2 (N.subgroupOf C) ↔ (x : G) ∈ oPPrime 2 N := by
  have h1 := burnsideF4gD4Inv_map_oPPrime C.subtype C.subtype_injective (N.subgroupOf C)
  rw [Subgroup.map_subgroupOf_eq_of_le hN] at h1
  rw [h1]
  exact (Subgroup.mem_map_iff_mem C.subtype_injective).symm

end OPPrime

