  have hm : octR2 K a ∈ (octSystemOf (octRGD2 hK)).N := (octRGD2 hK).r₂_mem_N
  rw [burnsideF4gF4Inv_reeParabolic_zero]
  have hP := burnsideF4gF4Inv_P_eq_sup (octSystemOf (octRGD2 hK)) false (m := octR2 K a) hm rfl
  show y ∈ P (octSystemOf (octRGD2 hK)) false ↔ _
  rw [hP]
  exact burnsideF4gF4Inv_mem_sup_iff y (octR2 K a)

theorem burnsideF4gF4Inv_exists_quotEquiv {G : Type} [Group G] (hz : Subgroup.center G = ⊥) :
    ∃ e : G ≃* (G ⧸ Subgroup.center G), ∀ x : G, e x = (x : G ⧸ Subgroup.center G) := by
  refine ⟨MulEquiv.ofBijective (QuotientGroup.mk' (Subgroup.center G))
    ⟨(MonoidHom.ker_eq_bot_iff _).1 (by rw [QuotientGroup.ker_mk', hz]),
      QuotientGroup.mk'_surjective _⟩, fun x => rfl⟩

open CFSG.GH74.BNPair CFSG.Quasithin.H13.F431.BN in
theorem burnsideF4gF4Inv_center_trivial (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1)) :
    Subgroup.center ↥(reeGroup K a) = ⊥ := by
  haveI : IsSimpleGroup (Gm K a) := isSimpleGroup_gm ha hK
  let e0 : Gm K a ≃* ↥(reeGroup K a) := MulEquiv.subgroupCongr burnsideF4gF4Inv_reeGroup_eq.symm
  have hcen : Subgroup.center (Gm K a) = ⊥ := by
    rcases (inferInstance : (Subgroup.center (Gm K a)).Normal).eq_bot_or_eq_top with h | h
    · exact h
    · exfalso
      obtain ⟨x, y, hxy⟩ := not_comm (octSystemOf (octRGD2 hK))
      have hx : x ∈ Subgroup.center (Gm K a) := by rw [h]; exact Subgroup.mem_top x
      exact hxy (Subgroup.mem_center_iff.1 hx y).symm
  rw [← Subgroup.map_center_eq e0, hcen, Subgroup.map_bot]

end Main

section Abstract

open CFSG.ASVolI.ChF

variable {E : Type} [Group E]

@[expose] def burnsideF4gF4Inv_RI (L S : Subgroup E) (short : Bool) (x : E) : Prop :=
  x ≠ 1 ∧ x * x = 1 ∧ ∃ c : E, c * x * c⁻¹ ∈ (if short then S else L)

structure burnsideF4gF4Inv_Datum (M₁ M₂ L S : Subgroup E) (z t : E) : Prop where
  z_ne : z ≠ 1
  z_sq : z * z = 1
  t_ne : t ≠ 1
  t_sq : t * t = 1
  cls : ∀ x : E, x ≠ 1 → x * x = 1 → IsConj z x ∨ IsConj t x
  not_conj : ¬ IsConj z t
  z_ctr : z ∈ ctr (pCoreOf 2 (M₁ ⊓ M₂))
  ctr_conj : ∀ w ∈ ctr (pCoreOf 2 (M₁ ⊓ M₂)), w ≠ 1 → IsConj z w
  L_le : L ≤ ctr (pCoreOf 2 (M₁ ⊓ M₂))
  z_L : z ∈ L
  t_S : t ∈ S
  S_conj : ∀ y ∈ S, y ≠ 1 → IsConj t y
  oP : oPPrime 2 M₁ = Subgroup.centralizer ({z} : Set E)
  cz_le : Subgroup.centralizer ({z} : Set E) ≤ M₁
  oP_ctr : ∀ x ∈ ctr (oPPrime 2 M₁), x ≠ 1 → ∃ h ∈ M₁, h * z * h⁻¹ = x
  t_core : t ∈ pCoreOf 2 M₂
  ct_le : Subgroup.centralizer ({t} : Set E) ≤ M₂

theorem burnsideF4gF4Inv_oPPrime_idem (P : Subgroup E) : oPPrime 2 (oPPrime 2 P) = oPPrime 2 P :=
  le_antisymm ((Subgroup.closure_le _).2 fun _ hx => hx.1)
    (Subgroup.closure_mono fun _ hx => ⟨Subgroup.subset_closure hx, hx.2⟩)

theorem burnsideF4gF4Inv_oPPrime_le (p : ℕ) (P : Subgroup E) : oPPrime p P ≤ P :=
  (Subgroup.closure_le _).2 fun _ hx => hx.1

theorem burnsideF4gF4Inv_oPPrime_map {A B : Type} [Group A] [Group B] (e : A ≃* B) (p : ℕ)
    (X : Subgroup A) : oPPrime p (X.map e.toMonoidHom) = (oPPrime p X).map e.toMonoidHom := by
  unfold oPPrime
  rw [MonoidHom.map_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨⟨x, hx, rfl⟩, k, hk⟩
    exact ⟨x, ⟨hx, k, by rwa [orderOf_injective e.toMonoidHom e.injective x] at hk⟩, rfl⟩
  · rintro ⟨x, ⟨hx, k, hk⟩, rfl⟩
    exact ⟨⟨x, hx, rfl⟩, k, by rw [orderOf_injective e.toMonoidHom e.injective x]; exact hk⟩

theorem burnsideF4gF4Inv_ctr_map {A B : Type} [Group A] [Group B] (e : A ≃* B) (X : Subgroup A) :
    ctr (X.map e.toMonoidHom) = (ctr X).map e.toMonoidHom := by
  ext y
  obtain ⟨x, rfl⟩ := e.surjective y
  simp only [ctr, Subgroup.mem_inf, Subgroup.mem_map, Subgroup.mem_centralizer_iff]
  constructor
  · rintro ⟨⟨x', hx', hx'e⟩, hc⟩
    have hx : x' = x := e.injective hx'e
    subst hx
    refine ⟨x', ⟨hx', fun g hg => ?_⟩, rfl⟩
    have := hc (e g) ⟨g, hg, rfl⟩
    exact e.injective (by simpa using this)
  · rintro ⟨x', ⟨hx', hc⟩, hx'e⟩
    have hx : x' = x := e.injective hx'e
    subst hx
    refine ⟨⟨x', hx', rfl⟩, ?_⟩
    rintro _ ⟨g, hg, rfl⟩
    have := hc g hg
    simpa using congrArg e this

theorem burnsideF4gF4Inv_centralizer_map {A B : Type} [Group A] [Group B] (e : A ≃* B) (a : A) :
    Subgroup.centralizer ({e a} : Set B) = (Subgroup.centralizer ({a} : Set A)).map e.toMonoidHom := by
  ext y
  obtain ⟨x, rfl⟩ := e.surjective y
  simp only [Subgroup.mem_centralizer_iff, Set.mem_singleton_iff, forall_eq, Subgroup.mem_map]
  constructor
  · intro h
    refine ⟨x, ?_, rfl⟩
    have : e a * e x = e x * e a := h
    exact e.injective (by simpa using this)
  · rintro ⟨x', hx', hx'e⟩
    have hx : x' = x := e.injective hx'e
    subst hx
    have : a * x' = x' * a := hx'
    simpa using congrArg e this

theorem burnsideF4gF4Inv_isConj_map {A B : Type} [Group A] [Group B] (e : A ≃* B) {a b : A} :
    IsConj (e a) (e b) ↔ IsConj a b :=
  ⟨fun h => by simpa using e.symm.toMonoidHom.map_isConj h,
    fun h => e.toMonoidHom.map_isConj h⟩

end Abstract

section Clauses

open CFSG.ASVolI.ChF

variable {E : Type} [Group E] {M₁ M₂ L S : Subgroup E} {z t : E}
  (D : burnsideF4gF4Inv_Datum M₁ M₂ L S z t)

include D in
theorem burnsideF4gF4Inv_invClasses_eq : InvClasses E = {ConjClasses.mk z, ConjClasses.mk t} := by
  ext C
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨x, hx, hx1, hx2⟩
    rw [ConjClasses.mem_carrier_iff_mk_eq] at hx
    rcases D.cls x hx1 hx2 with h | h
    · left
      rw [← hx]
      exact ConjClasses.mk_eq_mk_iff_isConj.2 h.symm
    · right
      rw [← hx]
      exact ConjClasses.mk_eq_mk_iff_isConj.2 h.symm
  · rintro (rfl | rfl)
    · exact ⟨z, ConjClasses.mem_carrier_mk, D.z_ne, D.z_sq⟩
    · exact ⟨t, ConjClasses.mem_carrier_mk, D.t_ne, D.t_sq⟩

include D in
theorem burnsideF4gF4Inv_ncard : Set.ncard (InvClasses E) = 2 := by
  rw [burnsideF4gF4Inv_invClasses_eq D]
  exact Set.ncard_pair fun h => D.not_conj (ConjClasses.mk_eq_mk_iff_isConj.1 h)

include D in
theorem burnsideF4gF4Inv_unique : ∃! C : ConjClasses E,
    C ∈ InvClasses E ∧ ClassMeetsCenter (pCoreOf 2 (M₁ ⊓ M₂)) C := by
  refine ⟨ConjClasses.mk z, ⟨⟨z, ConjClasses.mem_carrier_mk, D.z_ne, D.z_sq⟩, z,
    ConjClasses.mem_carrier_mk, D.z_ctr⟩, ?_⟩
  rintro C ⟨⟨x, hx, hx1, -⟩, w, hw, hwc⟩
  rw [ConjClasses.mem_carrier_iff_mk_eq] at hx hw
  have hxw : IsConj x w := ConjClasses.mk_eq_mk_iff_isConj.1 (hx.trans hw.symm)
  have hw1 : w ≠ 1 := by
    rintro rfl
    exact hx1 (isConj_one_left.1 hxw)
  exact hw.symm.trans (ConjClasses.mk_eq_mk_iff_isConj.2 (D.ctr_conj w hwc hw1).symm)

include D in
theorem burnsideF4gF4Inv_cover (x : E) (hx1 : x ≠ 1) (hx2 : x * x = 1) :
    burnsideF4gF4Inv_RI L S false x ∨ burnsideF4gF4Inv_RI L S true x := by
  rcases D.cls x hx1 hx2 with h | h
  · obtain ⟨c, hc⟩ := isConj_iff.1 h
    left
    refine ⟨hx1, hx2, c⁻¹, ?_⟩
    have e : c⁻¹ * x * c⁻¹⁻¹ = z := by rw [← hc]; group
    rw [e]
    simpa using D.z_L
  · obtain ⟨c, hc⟩ := isConj_iff.1 h
    right
    refine ⟨hx1, hx2, c⁻¹, ?_⟩
    have e : c⁻¹ * x * c⁻¹⁻¹ = t := by rw [← hc]; group
    rw [e]
    simpa using D.t_S

include D in
theorem burnsideF4gF4Inv_iff_ctr (x : E) (hx1 : x ≠ 1) (hx2 : x * x = 1) :
    burnsideF4gF4Inv_RI L S false x ↔
      ∃ c : E, c * x * c⁻¹ ∈ ctr (pCoreOf 2 (M₁ ⊓ M₂)) := by
  constructor
  · rintro ⟨-, -, c, hc⟩
    exact ⟨c, D.L_le hc⟩
  · rintro ⟨c, hc⟩
    have hw1 : c * x * c⁻¹ ≠ 1 := by
      intro h
      apply hx1
      have : x = c⁻¹ * (c * x * c⁻¹) * c := by group
      rw [this, h]
      group
    obtain ⟨d, hd⟩ := isConj_iff.1 (D.ctr_conj _ hc hw1)
    refine ⟨hx1, hx2, (c⁻¹ * d)⁻¹, ?_⟩
    have : (c⁻¹ * d)⁻¹ * x * ((c⁻¹ * d)⁻¹)⁻¹ = z := by
      have h2 : d * z * d⁻¹ = c * x * c⁻¹ := hd
      calc (c⁻¹ * d)⁻¹ * x * ((c⁻¹ * d)⁻¹)⁻¹ = d⁻¹ * (c * x * c⁻¹) * d := by group
        _ = d⁻¹ * (d * z * d⁻¹) * d := by rw [h2]
        _ = z := by group
    rw [this]
    exact D.z_L

include D in
theorem burnsideF4gF4Inv_not_both (x : E) :
    ¬ (burnsideF4gF4Inv_RI L S false x ∧ burnsideF4gF4Inv_RI L S true x) := by
  rintro ⟨⟨hx1, -, c, hc⟩, ⟨-, -, c', hc'⟩⟩
  have hy1 : c * x * c⁻¹ ≠ 1 := by
    intro h
    apply hx1
    have : x = c⁻¹ * (c * x * c⁻¹) * c := by group
    rw [this, h]
    group
  have hy1' : c' * x * c'⁻¹ ≠ 1 := by
    intro h
    apply hx1
    have : x = c'⁻¹ * (c' * x * c'⁻¹) * c' := by group
    rw [this, h]
    group
  have h1 : IsConj z (c * x * c⁻¹) := D.ctr_conj _ (D.L_le hc) hy1
  have h2 : IsConj t (c' * x * c'⁻¹) := D.S_conj _ hc' hy1'
  have hxc : IsConj x (c * x * c⁻¹) := isConj_iff.2 ⟨c, rfl⟩
  have hxc' : IsConj x (c' * x * c'⁻¹) := isConj_iff.2 ⟨c', rfl⟩
  exact D.not_conj ((h1.trans hxc.symm).trans (hxc'.trans h2.symm))

include D in
theorem burnsideF4gF4Inv_clause4a (x : E) (hx : x ∈ ctr (oPPrime 2 M₁)) (hx1 : x ≠ 1) :
    burnsideF4gF4Inv_RI L S false x ∧ Subgroup.centralizer ({x} : Set E) ≤ M₁ ∧
      oPPrime 2 M₁ = oPPrime 2 (Subgroup.centralizer ({x} : Set E)) ∧
      oPPrime 2 M₁ = Subgroup.centralizer ({x} : Set E) := by
  obtain ⟨h, hh, rfl⟩ := D.oP_ctr x hx hx1
  have hconj : (MulAut.conj h) z = h * z * h⁻¹ := rfl
  have hC : Subgroup.centralizer ({h * z * h⁻¹} : Set E) = oPPrime 2 M₁ := by
    rw [← hconj, burnsideF4gF4Inv_centralizer_map (MulAut.conj h) z, ← D.oP,
      ← burnsideF4gF4Inv_oPPrime_map (MulAut.conj h) 2 M₁]
    congr 1
    ext y
    constructor
    · rintro ⟨u, hu, rfl⟩
      exact M₁.mul_mem (M₁.mul_mem hh hu) (M₁.inv_mem hh)
    · intro hy
      refine ⟨h⁻¹ * y * h, M₁.mul_mem (M₁.mul_mem (M₁.inv_mem hh) hy) hh, ?_⟩
      show h * (h⁻¹ * y * h) * h⁻¹ = y
      group
  refine ⟨⟨hx1, ?_, h⁻¹, ?_⟩, ?_, ?_, hC.symm⟩
  · calc h * z * h⁻¹ * (h * z * h⁻¹) = h * (z * z) * h⁻¹ := by group
      _ = 1 := by rw [D.z_sq]; group
  · have : h⁻¹ * (h * z * h⁻¹) * h⁻¹⁻¹ = z := by group
    rw [if_neg (by decide), this]
    exact D.z_L
  · rw [hC]
    exact burnsideF4gF4Inv_oPPrime_le 2 M₁
  · rw [hC, burnsideF4gF4Inv_oPPrime_idem]

include D in
theorem burnsideF4gF4Inv_clause4b :
    ∃ x ∈ pCoreOf 2 M₂, burnsideF4gF4Inv_RI L S true x ∧
      Subgroup.centralizer ({x} : Set E) ≤ M₂ :=
  ⟨t, D.t_core, ⟨D.t_ne, D.t_sq, 1, by simpa using D.t_S⟩, D.ct_le⟩

end Clauses

section MapDatum

open CFSG.ASVolI.ChF

variable {G E : Type} [Group G] [Group E] (Φ : G ≃* E)

theorem burnsideF4gF4Inv_ctr_pCoreOf_map (M₁ M₂ : Subgroup G) :
    ctr (pCoreOf 2 (M₁.map Φ.toMonoidHom ⊓ M₂.map Φ.toMonoidHom)) =
      (ctr (pCoreOf 2 (M₁ ⊓ M₂))).map Φ.toMonoidHom := by
  rw [← Subgroup.map_inf _ _ _ Φ.injective,
    CFSG.LieType.BorelTits.pCoreOf_map_mulEquiv 2 Φ, burnsideF4gF4Inv_ctr_map]

theorem burnsideF4gF4Inv_Datum.map {M₁ M₂ L S : Subgroup G} {z t : G}
    (D : burnsideF4gF4Inv_Datum M₁ M₂ L S z t) :
    burnsideF4gF4Inv_Datum (M₁.map Φ.toMonoidHom) (M₂.map Φ.toMonoidHom) (L.map Φ.toMonoidHom)
      (S.map Φ.toMonoidHom) (Φ z) (Φ t) where
  z_ne h := D.z_ne (Φ.injective (by simpa using h))
  z_sq := by rw [← map_mul, D.z_sq, map_one]
  t_ne h := D.t_ne (Φ.injective (by simpa using h))
  t_sq := by rw [← map_mul, D.t_sq, map_one]
  cls := by
    intro x hx1 hx2
    obtain ⟨y, rfl⟩ := Φ.surjective x
    have hy1 : y ≠ 1 := fun h => hx1 (by rw [h, map_one])
    have hy2 : y * y = 1 := Φ.injective (by rw [map_mul, hx2, map_one])
    rcases D.cls y hy1 hy2 with h | h
    · exact Or.inl ((burnsideF4gF4Inv_isConj_map Φ).2 h)
    · exact Or.inr ((burnsideF4gF4Inv_isConj_map Φ).2 h)
  not_conj h := D.not_conj ((burnsideF4gF4Inv_isConj_map Φ).1 h)
  z_ctr := by
    rw [burnsideF4gF4Inv_ctr_pCoreOf_map]
    exact Subgroup.mem_map_of_mem _ D.z_ctr
  ctr_conj := by
    intro w hw hw1
    rw [burnsideF4gF4Inv_ctr_pCoreOf_map] at hw
    obtain ⟨w', hw', rfl⟩ := hw
    have : w' ≠ 1 := fun h => hw1 (by rw [h]; exact map_one _)
    exact (burnsideF4gF4Inv_isConj_map Φ).2 (D.ctr_conj w' hw' this)
  L_le := by
    rw [burnsideF4gF4Inv_ctr_pCoreOf_map]
    exact Subgroup.map_mono D.L_le
  z_L := Subgroup.mem_map_of_mem _ D.z_L
  t_S := Subgroup.mem_map_of_mem _ D.t_S
  S_conj := by
    intro y hy hy1
    obtain ⟨y', hy', rfl⟩ := hy
    have : y' ≠ 1 := fun h => hy1 (by rw [h]; exact map_one _)
    exact (burnsideF4gF4Inv_isConj_map Φ).2 (D.S_conj y' hy' this)
  oP := by
    rw [burnsideF4gF4Inv_oPPrime_map Φ, burnsideF4gF4Inv_centralizer_map Φ, D.oP]
  cz_le := by
    rw [burnsideF4gF4Inv_centralizer_map Φ]
    exact Subgroup.map_mono D.cz_le
  oP_ctr := by
    intro x hx hx1
    rw [burnsideF4gF4Inv_oPPrime_map Φ, burnsideF4gF4Inv_ctr_map] at hx
    obtain ⟨x', hx', rfl⟩ := hx
    have : x' ≠ 1 := fun h => hx1 (by rw [h]; exact map_one _)
    obtain ⟨h, hh, hhx⟩ := D.oP_ctr x' hx' this
    refine ⟨Φ h, Subgroup.mem_map_of_mem _ hh, ?_⟩
    show Φ h * Φ z * (Φ h)⁻¹ = Φ x'
    rw [← map_inv, ← map_mul, ← map_mul, hhx]
  t_core := by
    rw [CFSG.LieType.BorelTits.pCoreOf_map_mulEquiv 2 Φ]
    exact Subgroup.mem_map_of_mem _ D.t_core
  ct_le := by
    rw [burnsideF4gF4Inv_centralizer_map Φ]
    exact Subgroup.map_mono D.ct_le

end MapDatum

section GLevel

open CFSG.Blueprint CFSG.Blueprint.Chevalley CFSG.ASVolI.ChF.ExceptionalRoots
  CFSG.LieType.Chevalley CFSG.LieType.Ree CFSG.LieType.Ree.ReeTag
  CFSG.LieType.Ree.LargeReeInvolution CFSG.Quasithin.H13.F431.TwoF4

set_option linter.unusedSectionVars false

variable
  {K : Type} [Field K] [Finite K] [CharP K F4.prime] {a : ℕ}

theorem burnsideF4gF4Inv_reeLocalParabolic_one :
    F4.reeLocalParabolic K a ⟨1, by decide⟩ =
      F4.reeFixedBorel K a ⊔ Subgroup.zpowers (weylTwo K) := by
  rw [← F4.reeParabolic_singleton (K := K) (a := a) (j := ⟨1, by decide⟩)]
  unfold ReeTag.reeParabolic
  rw [Set.image_singleton, ← Subgroup.zpowers_eq_closure]

theorem burnsideF4gF4Inv_reeLocalParabolic_zero :
    F4.reeLocalParabolic K a ⟨0, by decide⟩ =
      F4.reeFixedBorel K a ⊔ Subgroup.zpowers (weylOne K) := by
  rw [← F4.reeParabolic_singleton (K := K) (a := a) (j := ⟨0, by decide⟩)]
  unfold ReeTag.reeParabolic
  rw [Set.image_singleton, ← Subgroup.zpowers_eq_closure]

theorem burnsideF4gF4Inv_reeParabolic_one_eq :
    reeParabolic K a 1 = F4.reeLocalParabolic K a ⟨1, by decide⟩ := by
  rw [burnsideF4gF4Inv_reeParabolic_one, burnsideF4gF4Inv_reeLocalParabolic_one]

theorem burnsideF4gF4Inv_reeParabolic_zero_eq :
    reeParabolic K a 0 = F4.reeLocalParabolic K a ⟨0, by decide⟩ := by
  rw [burnsideF4gF4Inv_reeParabolic_zero, burnsideF4gF4Inv_reeLocalParabolic_zero]

end GLevel

section Helpers

open CFSG.ASVolI.ChF

theorem burnsideF4gF4Inv_oPPrime_map_inj {A B : Type} [Group A] [Group B] (f : A →* B)
    (hf : Function.Injective f) (p : ℕ) (X : Subgroup A) :
    oPPrime p (X.map f) = (oPPrime p X).map f := by
  unfold oPPrime
  rw [MonoidHom.map_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨⟨x, hx, rfl⟩, k, hk⟩
    exact ⟨x, ⟨hx, k, by rwa [orderOf_injective f hf x] at hk⟩, rfl⟩
  · rintro ⟨x, ⟨hx, k, hk⟩, rfl⟩
    exact ⟨⟨x, hx, rfl⟩, k, by rw [orderOf_injective f hf x]; exact hk⟩

theorem burnsideF4gF4Inv_oPPrime_conj {E : Type} [Group E] (p : ℕ) {P : Subgroup E} {g : E}
    (hg : g ∈ P) {x : E} (hx : x ∈ oPPrime p P) : g * x * g⁻¹ ∈ oPPrime p P := by
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
    refine Subgroup.subset_closure ⟨P.mul_mem (P.mul_mem hg hy.1) (P.inv_mem hg), ?_⟩
    obtain ⟨k, hk⟩ := hy.2
    refine ⟨k, ?_⟩
    rw [← hk]
    exact (orderOf_injective (MulAut.conj g).toMonoidHom (MulAut.conj g).injective y)
  | one => simpa using (oPPrime p P).one_mem
  | mul y z _ _ hy hz =>
    have e : g * (y * z) * g⁻¹ = (g * y * g⁻¹) * (g * z * g⁻¹) := by group
    rw [e]
    exact (oPPrime p P).mul_mem hy hz
  | inv y _ hy =>
