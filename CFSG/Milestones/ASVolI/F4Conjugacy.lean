open CFSG.Open CFSG.Quasithin CFSG.Sporadic.Schreier.Tits


theorem burnsideF4gF4Two_complete (α : MulAut ↥twoF4M) :
    ∃ m : ↥twoF4M, ∀ x : ↥twoF4M, α x = m * x * m⁻¹ := by
  haveI hchar : (titsD.subgroupOf twoF4M).Characteristic := by
    rw [burnsideF4gF4Two_Dm_eq_commutator]
    infer_instance
  haveI : (titsD.subgroupOf twoF4M).Normal := twoF4D_normal
  let e0 : ↥(titsD.subgroupOf twoF4M) ≃* ↥titsD := Subgroup.subgroupOfEquivOfLe titsD_le_twoF4M
  obtain ⟨m, hm⟩ := (twoF4ConjD_bijective titsOutBound).2
    (MulAut.congr e0 (burnsideF4gF4Two_restrict (titsD.subgroupOf twoF4M) α))
  have hD : ∀ d : ↥twoF4M, d ∈ titsD.subgroupOf twoF4M → α d = m * d * m⁻¹ := by
    intro d hd
    have h1 := congrArg (fun β : MulAut ↥titsD =>
      ((β (e0 ⟨d, hd⟩) : ↥titsD) : Equiv.Perm (Fin 1755))) hm
    apply Subtype.ext
    exact h1.symm
  refine ⟨m, fun x => ?_⟩
  have hbx : ∀ d : ↥twoF4M, d ∈ titsD.subgroupOf twoF4M →
      (m⁻¹ * α x * m) * d * (m⁻¹ * α x * m)⁻¹ = x * d * x⁻¹ := by
    intro d hd
    have e1 : α (x * d * x⁻¹) = α x * (m * d * m⁻¹) * (α x)⁻¹ := by
      rw [map_mul, map_mul, map_inv, hD d hd]
    have e2 : α (x * d * x⁻¹) = m * (x * d * x⁻¹) * m⁻¹ :=
      hD _ ((inferInstance : (titsD.subgroupOf twoF4M).Normal).conj_mem d hd x)
    calc (m⁻¹ * α x * m) * d * (m⁻¹ * α x * m)⁻¹
        = m⁻¹ * (α x * (m * d * m⁻¹) * (α x)⁻¹) * m := by group
      _ = m⁻¹ * (m * (x * d * x⁻¹) * m⁻¹) * m := by rw [← e1, e2]
      _ = x * d * x⁻¹ := by group
  have hy : x⁻¹ * (m⁻¹ * α x * m) = 1 := by
    apply twoF4_centD
    intro d hd
    calc x⁻¹ * (m⁻¹ * α x * m) * d
        = x⁻¹ * ((m⁻¹ * α x * m) * d * (m⁻¹ * α x * m)⁻¹) * (m⁻¹ * α x * m) := by group
      _ = x⁻¹ * (x * d * x⁻¹) * (m⁻¹ * α x * m) := by rw [hbx d hd]
      _ = d * (x⁻¹ * (m⁻¹ * α x * m)) := by group
  have hz : m⁻¹ * α x * m = x := by
    calc m⁻¹ * α x * m = x * (x⁻¹ * (m⁻¹ * α x * m)) := by group
      _ = x := by rw [hy, mul_one]
  calc α x = m * (m⁻¹ * α x * m) * m⁻¹ := by group
    _ = m * x * m⁻¹ := by rw [hz]

theorem burnsideF4gF4Two_eq_top {E : Type} [Group E] {Gp : Subgroup E} [Gp.Normal]
    (hcen : Subgroup.centralizer (Gp : Set E) = ⊥) (Ψ : ↥Gp ≃* ↥twoF4M) : Gp = ⊤ := by
  rw [eq_top_iff]
  intro e _
  obtain ⟨m, hm⟩ := burnsideF4gF4Two_complete
    ((Ψ.symm.trans (MulAut.conjNormal (H := Gp) e)).trans Ψ)
  set g : ↥Gp := Ψ.symm m with hg
  have hx : ∀ x : ↥Gp, e * (x : E) * e⁻¹ = (g : E) * x * (g : E)⁻¹ := by
    intro x
    have h1 := hm (Ψ x)
    simp only [MulEquiv.trans_apply, MulEquiv.symm_apply_apply] at h1
    have h2 := congrArg Ψ.symm h1
    rw [MulEquiv.symm_apply_apply] at h2
    have h3 := congrArg (fun z : ↥Gp => (z : E)) h2
    simp only [map_mul, map_inv, MulEquiv.symm_apply_apply] at h3
    simpa [MulAut.conjNormal_apply, hg] using h3
  have hmem : (g : E)⁻¹ * e ∈ Subgroup.centralizer (Gp : Set E) := by
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    have := hx ⟨h, hh⟩
    calc h * ((g : E)⁻¹ * e) = (g : E)⁻¹ * ((g : E) * h * (g : E)⁻¹) * e := by group
      _ = (g : E)⁻¹ * (e * h * e⁻¹) * e := by rw [← this]
      _ = ((g : E)⁻¹ * e) * h := by group
  rw [hcen, Subgroup.mem_bot] at hmem
  have : e = (g : E) := by
    calc e = (g : E) * ((g : E)⁻¹ * e) := by group
      _ = (g : E) := by rw [hmem, mul_one]
  rw [this]
  exact g.2

end Complete

