theorem burnsideF4gG2TwoInv_oPPrime_P₂ (h2 : (2 : K) = 0) (hk2 : ∀ c : K, c = 0 ∨ c = 1) :
    oPPrime 2 (lat h2 hk2).P₂ = (lat h2 hk2).P₂ := by
  have D := g2IndexTwoData h2 hk2
  apply le_antisymm
  · exact (Subgroup.closure_le _).2 (fun x hx => hx.1)
  · have hP₂ : (lat h2 hk2).P₂ = D.ext u33Data.B CFSG.Quasithin.u33Phi'_B := rfl
    have hρP : g2RhoC h2 ∈ (lat h2 hk2).P₂ := by
      rw [hP₂]; exact D.rho_mem_ext _
    have hρ1 : g2RhoC h2 ≠ 1 := fun h => D.rho_not_mem ⟨1, by rw [map_one, h]⟩
    have hρ2 : g2RhoC h2 ^ 2 = 1 := by rw [pow_two]; exact D.sq
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    have hρo : orderOf (g2RhoC h2) = 2 := orderOf_eq_prime hρ2 hρ1
    have hρ : g2RhoC h2 ∈ oPPrime 2 (lat h2 hk2).P₂ :=
      Subgroup.subset_closure ⟨hρP, 1, by rw [hρo]; norm_num⟩
    have hB : u33Data.B.map (g2HomC h2) ≤ oPPrime 2 (lat h2 hk2).P₂ := by
      rw [← burnsideF4gG2TwoInv_oPPrime_B, oPPrime, MonoidHom.map_closure]
      refine (Subgroup.closure_le _).2 ?_
      rintro _ ⟨b, ⟨hbB, k, hk⟩, rfl⟩
      refine Subgroup.subset_closure ⟨?_, k, ?_⟩
      · rw [hP₂]; exact D.map_le_ext _ ⟨b, hbB, rfl⟩
      · rw [orderOf_injective _ D.inj, hk]
    intro g hg
    rw [hP₂] at hg
    rcases D.mem_ext.1 hg with h | h
    · exact hB h
    · have e : g = (g * g2RhoC h2) * g2RhoC h2 := by
        rw [mul_assoc]; rw [show g2RhoC h2 * g2RhoC h2 = 1 from D.sq, mul_one]
      rw [e]
      exact Subgroup.mul_mem _ (hB h) hρ

theorem burnsideF4gG2TwoInv_rho_mem_pCore (h2 : (2 : K) = 0) (hk2 : ∀ c : K, c = 0 ∨ c = 1) :
