  have h : ([1, 2, 1, 2, 0, 3, 1, 2, 1, 2] : List (Fin Tag.F4.rank)) =
      [1, 2, 1, 2] ++ [0, 3] ++ [1, 2, 1, 2] := rfl
  rw [h, burnsideF4gF4TwoInv_wordUnit_append, burnsideF4gF4TwoInv_wordUnit_append,
    burnsideF4gF4Two_wordUnit_zero, burnsideF4gF4Two_wordUnit_one, mul_assoc]
  rfl

theorem burnsideF4gF4TwoInv_reeLongRoot_eq :
    reeLongRoot K a = (reeMiddleCentralRoot K a).map
      (MulAut.conj (weylOne K * weylTwo K * weylOne K)).toMonoidHom := by
  unfold ChF.ExceptionalRoots.reeLongRoot
  refine burnsideF4gF4TwoInv_fixedWeylConjugate_eq _ _ _ _ ?_ ?_
  · exact mul_mem (mul_mem burnsideF4gF4TwoInv_weylOne_mem burnsideF4gF4TwoInv_weylTwo_mem)
