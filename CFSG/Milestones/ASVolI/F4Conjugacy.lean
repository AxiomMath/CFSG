  · intro hx
    exact ⟨⟨x, hx⟩, rfl⟩

theorem burnsideF4gF4Two_mem_range_φ2 {G : Type*} [Group G] (P1 P2 G0 : Subgroup G)
    (h : P1 ⊔ P2 = G0) (x : ↥G0) :
    x ∈ (RankTwoAmalgam.inclusionCompletion P1 P2 G0 h).φ2.range ↔ (x : G) ∈ P2 := by
  constructor
  · rintro ⟨a, rfl⟩
    exact a.2
  · intro hx
