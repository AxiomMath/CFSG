theorem burnsideF4gF4Inv_pCoreOf_B {X : Type} [Group X] [Finite X] {n : ℕ}
    (D : RankTwoSystem X n) (hU : IsSylowTwoOf D.U ⊤) : pCoreOf 2 D.B = D.U := by
