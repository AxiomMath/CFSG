  have := h.charP
  unfold oPPrime
  refine (Subgroup.closure_le _).mpr ?_
  rintro x ⟨hxP, k, hk⟩
  refine ⟨hxP, ?_⟩
  have hpow : ∀ n : ℕ, chi h (x ^ n) = chi h x ^ n := by
    intro n
    induction n with
    | zero => simpa using chi_one h
    | succ n ih => rw [pow_succ, chi_mul h hxP, ih, pow_succ]
  have h1 : x ^ 2 ^ k = 1 := by rw [← hk]; exact pow_orderOf_eq_one x
  have h2 : chi h x ^ 2 ^ k = 1 := by rw [← hpow, h1, chi_one]
  have h3 : (chi h x - 1) ^ 2 ^ k = 0 := by rw [sub_pow_char_pow, h2, one_pow, sub_self]
  exact sub_eq_zero.mp ((pow_eq_zero_iff (by positivity)).mp h3)

