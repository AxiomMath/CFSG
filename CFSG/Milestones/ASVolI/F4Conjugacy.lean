open Matrix CFSG.ClassicalGroups.UnitaryFlag CFSG.LocalAnalysis.ComponentInitial
  CFSG.ASVolI.ChF CFSG.ASVolI.ChF.ClassicalRoots CFSG.Quasithin.H13.U4Par

variable {f : ℕ} {H : Type} [Group H] (marking : Marking .U4 2 f H)

theorem burnsideF4gU4Inv_nativeRoot_long :
    nativeRoot .U4 (2 ^ f) marking.basis .longOne false =
      (zRad (burnsideF4gU4_fieldData marking)).map (burnsideF4gU4_T marking).toMonoidHom := by
  have hfd := burnsideF4gU4_fieldData marking
  have := hfd.charP
  apply le_antisymm
  · unfold nativeRoot
    refine (Subgroup.closure_le _).mpr ?_
    rintro actor ⟨-, a, central, hparam, hact⟩
    have ha : a + a ^ 2 ^ f = 0 := hparam
    have hbar : hfd.bar a = a := by
      rw [hfd.bar_apply]
      have : a ^ 2 ^ f = -a := eq_neg_of_add_eq_zero_right ha
      rw [this, CharTwo.neg_eq]
    refine ⟨sElt hfd ((sAdm_zero_zero_iff hfd).mpr hbar), ⟨a, hbar, coe_sElt hfd _⟩, ?_⟩
    apply Subtype.ext
    apply Units.ext
    show (((burnsideF4gU4_T marking) (sElt hfd ((sAdm_zero_zero_iff hfd).mpr hbar)) :
      nativeGroup .U4 (2 ^ f) marking.field) : GL (Coord .U4) marking.field).val = _
    rw [burnsideF4gU4Inv_coe_T, coe_sElt, burnsideF4gU4Inv_submatrix_zRad, hact]
    rfl
  · rintro _ ⟨z, ⟨c, hc, hz⟩, rfl⟩
    have hz' : z = sElt hfd ((sAdm_zero_zero_iff hfd).mpr hc) := hypSU_ext hfd hz
    subst hz'
    refine Subgroup.subset_closure ⟨Or.inr (Or.inr (Or.inl rfl)), c, 0, ?_, ?_⟩
    · show c + c ^ 2 ^ f = 0
      have : c ^ 2 ^ f = c := by rw [← hfd.bar_apply, hc]
      rw [this, CharTwo.add_self_eq_zero]
    · show (((burnsideF4gU4_T marking) (sElt hfd ((sAdm_zero_zero_iff hfd).mpr hc)) :
        nativeGroup .U4 (2 ^ f) marking.field) : GL (Coord .U4) marking.field).val = _
      rw [burnsideF4gU4Inv_coe_T, coe_sElt, burnsideF4gU4Inv_submatrix_zRad]
      rfl

theorem burnsideF4gU4Inv_nativeRoot_short :
    nativeRoot .U4 (2 ^ f) marking.basis .sum false =
      (burnsideF4gU4Inv_short (burnsideF4gU4_fieldData marking)).map
        (burnsideF4gU4_T marking).toMonoidHom := by
  have hfd := burnsideF4gU4_fieldData marking
  have := hfd.charP
  apply le_antisymm
  · unfold nativeRoot
    refine (Subgroup.closure_le _).mpr ?_
    rintro actor ⟨-, a, central, -, hact⟩
    have hx : hfd.bar (hfd.bar a) = a := hfd.bar_bar a
    refine ⟨sElt hfd (sAdm_x_zero hfd (hfd.bar a)), ⟨hfd.bar a, coe_sElt hfd _⟩, ?_⟩
    apply Subtype.ext
    apply Units.ext
    show (((burnsideF4gU4_T marking) (sElt hfd (sAdm_x_zero hfd (hfd.bar a))) :
      nativeGroup .U4 (2 ^ f) marking.field) : GL (Coord .U4) marking.field).val = _
    rw [burnsideF4gU4Inv_coe_T, coe_sElt, burnsideF4gU4Inv_submatrix_short, hx, hact]
    rfl
  · rintro _ ⟨z, ⟨x, hz⟩, rfl⟩
    have hz' : z = sElt hfd (sAdm_x_zero hfd x) := hypSU_ext hfd hz
    subst hz'
    refine Subgroup.subset_closure ⟨Or.inr (Or.inl rfl), hfd.bar x, 0, trivial, ?_⟩
    show (((burnsideF4gU4_T marking) (sElt hfd (sAdm_x_zero hfd x)) :
        nativeGroup .U4 (2 ^ f) marking.field) : GL (Coord .U4) marking.field).val = _
    rw [burnsideF4gU4Inv_coe_T, coe_sElt, burnsideF4gU4Inv_submatrix_short]
