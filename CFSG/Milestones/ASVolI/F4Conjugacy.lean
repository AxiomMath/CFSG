      CFSG.ASVolI.ChF.GLKind.Sp4.m := by
  haveI := hyp.finite
  haveI := hyp.normal
  obtain ⟨marking, h1, h2⟩ := burnsideF4gSpOne_marking hyp
  have hK : Nat.card marking.field = 2 ^ f := by
    have := marking.field_card
    simpa using this
  haveI : CharP marking.field 2 := burnsideF4gSpOne_charP_of_card hK
  obtain ⟨θ, hθU⟩ := burnsideF4gSpOne_exists_iso hK
  obtain ⟨e, he⟩ := burnsideF4gSpOne_parabolic_eq marking
  let Ψ : antiSp marking.field →* E := Gp.subtype.comp (e.toMonoidHom.comp θ.toMonoidHom)
  have hΨinj : Function.Injective Ψ :=
    Gp.subtype_injective.comp (e.injective.comp θ.injective)
  have hrange : Ψ.range = Gp := by
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact (e (θ y)).2
    · intro hx
      obtain ⟨z, hz⟩ := e.surjective ⟨x, hx⟩
      obtain ⟨y, rfl⟩ := θ.surjective z
      exact ⟨y, congrArg Subtype.val hz⟩
  have gen : ∀ (b : Bool) (M : Subgroup E) (N : Subgroup (antiSp marking.field)),
      M.subgroupOf Gp = marking.parabolic b →
      N.map θ.toMonoidHom =
        (Q2 marking.field (if b then 1 else 0)).map (proj 2 marking.field) →
      ∀ y, Ψ y ∈ M ↔ y ∈ N := by
    intro b M N hM hN y
    have h3 : Ψ y ∈ M ↔ e (θ y) ∈ M.subgroupOf Gp := Iff.rfl
    rw [h3, hM, he b, Subgroup.mem_map_equiv]
    simp only [MulEquiv.symm_apply_apply]
    rw [← hN, Subgroup.mem_map_equiv]
    simp
  obtain ⟨V, hact, Γ, hgact, p, l, hF⟩ := spGeomProp marking.field
  have fp := hF.base_p.flag hF.three_p hF.adj
  have fl := hF.base_l.flag hF.three_l hF.adj.symm
  rcases burnsideF4gSpOne_parabolic_cases θ hθU with ⟨hA1, hA2⟩ | ⟨hB1, hB2⟩
  · obtain ⟨φ⟩ := burnsideF4gSpOne_incl_graph_iso hyp.gen hyp.normal hyp.split Ψ hΨinj hrange Γ l p
      (fun y => (gen false M₁ _ h1 hA1 y).trans (hF.stab_l y).symm)
      (fun y => (gen true M₂ _ h2 hA2 y).trans (hF.stab_p y).symm)
      (fun y z => (hF.disj z y).symm) hF.noadj_l hF.noadj_p hF.adj.symm
      (cov_of_flags hF.poly.connected fl fp) fl
    exact IsGenPolygon.of_iso φ hF.poly
  · obtain ⟨φ⟩ := burnsideF4gSpOne_incl_graph_iso hyp.gen hyp.normal hyp.split Ψ hΨinj hrange Γ p l
      (fun y => (gen false M₁ _ h1 hB2 y).trans (hF.stab_p y).symm)
      (fun y => (gen true M₂ _ h2 hB1 y).trans (hF.stab_l y).symm)
      hF.disj hF.noadj_p hF.noadj_l hF.adj
      (cov_of_flags hF.poly.connected fp fl) fp
    exact IsGenPolygon.of_iso φ hF.poly

theorem burnsideF4gSpOne_polygon {E : Type} [Group E] {Gp M₁ M₂ : Subgroup E}
    (hyp : CFSG.ASVolI.ChF.HypF_4_4g .Sp4 2 1 Gp M₁ M₂) :
