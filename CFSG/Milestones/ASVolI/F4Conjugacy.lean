  QuotientGroup.lift (Subgroup.center (G2Native.Derived K))
    ((QuotientGroup.mk' (Subgroup.center (G2Native.Parent K))).comp (G2Native.derivedInclusion K))
    (by
      rw [burnsideF4gG2Two_center_derived hK]
      intro x hx
      rw [Subgroup.mem_bot] at hx
