  have hM₁ : ∀ y : ↥Gp, (y : E) ∈ M₁ ↔
      (e1 (Ψ0.symm y) : Gm K 0) ∈ (burnsideF4gF4Two_system hK).P₁ := fun y =>
    (burnsideF4gF4Two_mem_centralImage marking q hq h1 y).trans
      (burnsideF4gF4Two_mem_P₁_iff hK (e1 (Ψ0.symm y))).symm
  have hM₂ : ∀ y : ↥Gp, (y : E) ∈ M₂ ↔
