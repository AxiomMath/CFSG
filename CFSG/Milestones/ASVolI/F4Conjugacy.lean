theorem burnsideF4gU5Inv_pow_two_eq_one {f : ℕ} (hF : Nat.card F = (2 ^ f) ^ 2) {x : F} {k : ℕ}
    (hx : x ^ (2 ^ k) = 1) : x = 1 := by
  have hx0 : x ≠ 0 := by
    rintro rfl
    simp at hx
  have hf : 1 ≤ f := by
    by_contra h
    have : f = 0 := by omega
    have h1 : Nat.card F = 1 := by rw [hF, this]; simp
    exact absurd h1 (Finite.one_lt_card (α := F)).ne'
  obtain ⟨u, hux⟩ : ∃ u : Fˣ, (u : F) = x := ⟨Units.mk0 x hx0, rfl⟩
  have hu : u ^ (2 ^ k) = 1 := Units.ext (by rw [Units.val_pow_eq_pow_val, hux, hx]; rfl)
  have hodd : Odd (Nat.card Fˣ) := by
    rw [Nat.card_units, hF]
    have h2 : 2 ∣ (2 ^ f) ^ 2 := by
      exact dvd_pow (dvd_pow_self 2 (by omega)) (by norm_num)
    have h1 : 1 ≤ (2 ^ f) ^ 2 := Nat.one_le_pow _ _ (Nat.one_le_two_pow)
    rcases h2 with ⟨m, hm⟩
    refine ⟨m - 1, ?_⟩
    omega
  have hcop : Nat.Coprime (2 ^ k) (Nat.card Fˣ) :=
    Nat.Coprime.pow_left k (Nat.coprime_two_left.mpr hodd)
  have h1 : orderOf u ∣ 2 ^ k := orderOf_dvd_of_pow_eq_one hu
  have h2 : orderOf u ∣ Nat.card Fˣ := orderOf_dvd_natCard u
  have h3 : orderOf u = 1 := Nat.eq_one_of_dvd_coprimes hcop h1 h2
  have := orderOf_eq_one_iff.mp h3
  rw [← hux, this]
  rfl

theorem burnsideF4gU5Inv_matrix_ext {M N : Matrix (Fin 5) (Fin 5) F}
    (h : ∀ x, M *ᵥ x = N *ᵥ x) : M = N := by
  ext i j
  have := congrFun (h (Pi.single j 1)) i
  simpa [Matrix.mulVec_single_one] using this

@[expose] def burnsideF4gU5Inv_e0 : Fin 5 → F := Pi.single 0 1

theorem burnsideF4gU5Inv_eq_smul_e0 {v : Fin 5 → F} (hv : v ∈ burnsideF4gU5_flag F 1) :
    v = v 0 • (burnsideF4gU5Inv_e0 : Fin 5 → F) := by
  funext a
  simp only [burnsideF4gU5_flag, Set.mem_setOf_eq] at hv
  fin_cases a
  · simp [burnsideF4gU5Inv_e0]
  all_goals
    simp [burnsideF4gU5Inv_e0, Pi.single_apply]
    exact hv _ (by decide)

theorem burnsideF4gU5Inv_xl04_mulVec (c : F) (hc : c + σ c = 0) (x : Fin 5 → F) :
    SUExtras.mat σ 5 (burnsideF4gU5Inv_xl04 σ c hc) *ᵥ x =
      x + (c * x 4) • (burnsideF4gU5Inv_e0 : Fin 5 → F) := by
  funext a
  rw [burnsideF4gU5Inv_xl04_mat, Matrix.add_mulVec, Matrix.one_mulVec]
  simp only [Pi.add_apply, burnsideF4gU5_single_mulVec, burnsideF4gU5Inv_e0, Pi.smul_apply,
    Pi.single_apply, smul_eq_mul]
  by_cases h : a = 0
  · subst h
    simp
  · simp [h]

theorem burnsideF4gU5Inv_hh_e0_left (x : Fin 5 → F) :
    burnsideF4gU5Inv_hh σ (burnsideF4gU5Inv_e0 : Fin 5 → F) x = x 4 := by
  simp [burnsideF4gU5Inv_hh, burnsideF4gU5Inv_e0, Pi.single_apply, burnsideF4gU5_rev_zero,
    burnsideF4gU5Inv_rev_four]

theorem burnsideF4gU5Inv_commute_xl04_of_fix (c : F) (hc : c + σ c = 0) {g : SU σ 5}
    (hg : SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F) = burnsideF4gU5Inv_e0) :
    g * burnsideF4gU5Inv_xl04 σ c hc = burnsideF4gU5Inv_xl04 σ c hc * g := by
  apply SUExtras.mat_injective
  rw [map_mul, map_mul]
  apply burnsideF4gU5Inv_matrix_ext
  intro x
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, burnsideF4gU5Inv_xl04_mulVec,
    burnsideF4gU5Inv_xl04_mulVec, Matrix.mulVec_add, Matrix.mulVec_smul, hg]
  congr 2
  have := burnsideF4gU5Inv_hh_mulVec σ g (burnsideF4gU5Inv_e0 : Fin 5 → F) x
  rw [hg, burnsideF4gU5Inv_hh_e0_left, burnsideF4gU5Inv_hh_e0_left] at this
  rw [this]

@[expose] def burnsideF4gU5Inv_e1 : Fin 5 → F := Pi.single 1 1

theorem burnsideF4gU5Inv_smul_e0_mem_flag (c : F) :
    c • (burnsideF4gU5Inv_e0 : Fin 5 → F) ∈ burnsideF4gU5_flag F 1 := by
  intro a ha
  simp only [burnsideF4gU5Inv_e0, Pi.smul_apply, Pi.single_apply, smul_eq_mul]
  have : a ≠ 0 := by
    intro h
    subst h
