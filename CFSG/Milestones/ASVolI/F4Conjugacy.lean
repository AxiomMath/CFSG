    exact Finset.sum_congr rfl fun k _ => by ring
  ext i a
  rw [hXG i a, congrFun (hX a) i, Matrix.mul_apply, sum_ix]
  simp only [hg, sMat_apply]
  rcases ix_cases a with rfl | rfl | rfl | rfl <;>
    simp [one_apply, ie1, ie2, if1, if2] <;> ring

theorem burnsideF4gU4InvW_rank_one (N : (Ix → K) →ₗ[K] (Ix → K))
    (hNN : ∀ v, N (N v) = 0)
    (hsa : ∀ u v, hypForm h 2 0 (N u) v = hypForm h 2 0 u (N v))
    (hr : Module.finrank K (LinearMap.range N) = 1) :
    ∃ (v : Ix → Ix → K) (c : K), (∀ a b, hypForm h 2 0 (v a) (v b) = hypGram 2 0 K a b) ∧
      h.bar c = c ∧ ∀ a, N (v a) = if a = if1 then c • v ie1 else 0 := by
  classical
  have hB : (hypForm h 2 0).IsSymm := hypForm_isSymm h
  have hBl : (hypForm h 2 0).SeparatingLeft := hypForm_separatingLeft h
  have hH : ∀ u v, h.bar (hypForm h 2 0 u v) = hypForm h 2 0 v u := fun u v => hB.eq u v
  obtain ⟨w₀, hw₀, hspan⟩ := finrank_eq_one_iff'.mp hr
  set w : Ix → K := (w₀ : Ix → K) with hw
  have hw0 : w ≠ 0 := fun h0 => hw₀ (Subtype.ext h0)
  obtain ⟨u₀, hu₀⟩ := w₀.2
  have hu₀' : N u₀ = w := hu₀
  have hww : hypForm h 2 0 w w = 0 := by
    rw [← hu₀', hsa, hNN, map_zero]
  have hex : ∀ v, ∃ c : K, N v = c • w := fun v => by
    obtain ⟨c, hc⟩ := hspan ⟨N v, LinearMap.mem_range_self N v⟩
    exact ⟨c, (congrArg Subtype.val hc).symm⟩
  choose coef hcoef using hex
  obtain ⟨v₀, hv₀⟩ : ∃ v₀, hypForm h 2 0 w v₀ ≠ 0 := by
    by_contra! hz
    exact hw0 (hBl w hz)
  have hβ0 : h.bar (hypForm h 2 0 w v₀) ≠ 0 := (h.bar_eq_zero_iff).not.mpr hv₀
  have key : ∀ u v, h.bar (coef u) * hypForm h 2 0 w v =
      coef v * h.bar (hypForm h 2 0 w u) := by
    intro u v
    have h1 := hsa u v
    rw [hcoef u, hcoef v] at h1
    simp only [map_smulₛₗ, LinearMap.smul_apply, smul_eq_mul, map_smul, RingHom.id_apply] at h1
    rw [← hH w u] at h1
    exact h1
  set μ : K := h.bar (coef v₀) / h.bar (hypForm h 2 0 w v₀) with hμ
  have hμv : ∀ v, coef v = μ * hypForm h 2 0 w v := by
    intro v
    have h1 := key v₀ v
    rw [hμ, div_mul_eq_mul_div, eq_div_iff hβ0]
    linear_combination (-1 : K) * h1
  have hμ0 : μ ≠ 0 := by
    intro h0
    apply hw0
    have h1 := hcoef u₀
    rw [hu₀', hμv u₀, h0, zero_mul, zero_smul] at h1
    exact h1
  have hμbar : h.bar μ = μ := by
    have h1 := hsa v₀ v₀
    rw [hcoef v₀, hμv v₀] at h1
    simp only [map_smulₛₗ, LinearMap.smul_apply, smul_eq_mul, map_smul, RingHom.id_apply] at h1
    rw [← hH w v₀, map_mul] at h1
    have h2 : (h.bar μ - μ) * (h.bar (hypForm h 2 0 w v₀) * hypForm h 2 0 w v₀) = 0 := by
      linear_combination h1
    rcases mul_eq_zero.mp h2 with h3 | h3
    · exact sub_eq_zero.mp h3
    · exact absurd h3 (mul_ne_zero hβ0 hv₀)
  have hfin : Module.finrank K (Ix → K) = 2 * 2 + 0 := by simp [Ix, HypIndex]
  obtain ⟨⟨b, hwb, hbb⟩, -⟩ :=
    CFSG.LinearGroups.hermitian_hyperbolic_splitting h hB hBl hw0 hww
  obtain ⟨W, hWgram, hW1, -⟩ := exists_hypBasis_of_pair h hB hBl (r := 2) (ε := 0) hfin
    (by norm_num) hww hbb hwb
  have hWe1 : W ie1 = w := hW1
  refine ⟨fun a => W a, μ, hWgram, hμbar, fun a => ?_⟩
  show N (W a) = _
  rw [hcoef (W a), hμv (W a), ← hWe1, hWgram, hypGram_apply, hypPartner_ie1]
  by_cases hca : a = if1
  · simp [hca]
  · simp [hca]

theorem burnsideF4gU4InvW_adjust (a₁ a₂ u₁ u₂ : Ix → K)
    (h11 : hypForm h 2 0 a₁ a₁ = 0) (h12 : hypForm h 2 0 a₁ a₂ = 0)
    (h22 : hypForm h 2 0 a₂ a₂ = 0)
    (g11 : hypForm h 2 0 a₁ u₁ = 1) (g12 : hypForm h 2 0 a₁ u₂ = 0)
    (g21 : hypForm h 2 0 a₂ u₁ = 0) (g22 : hypForm h 2 0 a₂ u₂ = 1) :
    ∃ v : Ix → Ix → K, (∀ a b, hypForm h 2 0 (v a) (v b) = hypGram 2 0 K a b) ∧
      v ie1 = a₁ ∧ v ie2 = a₂ ∧ ∃ c₁ c₂ d₁ d₂ : K, v if1 = u₁ + c₁ • a₁ + c₂ • a₂ ∧
        v if2 = u₂ + d₁ • a₁ + d₂ • a₂ := by
  classical
  have hB : (hypForm h 2 0).IsSymm := hypForm_isSymm h
  have hH : ∀ u v, h.bar (hypForm h 2 0 u v) = hypForm h 2 0 v u := fun u v => hB.eq u v
  have := h.charP
  have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
  have h21 : hypForm h 2 0 a₂ a₁ = 0 := by rw [← hH a₁ a₂, h12, map_zero]
  have f11 : hypForm h 2 0 u₁ a₁ = 1 := by rw [← hH a₁ u₁, g11, map_one]
  have f12 : hypForm h 2 0 u₂ a₁ = 0 := by rw [← hH a₁ u₂, g12, map_zero]
  have f21 : hypForm h 2 0 u₁ a₂ = 0 := by rw [← hH a₂ u₁, g21, map_zero]
  have f22 : hypForm h 2 0 u₂ a₂ = 1 := by rw [← hH a₂ u₂, g22, map_one]
  obtain ⟨γ₁, hγ₁⟩ : ∃ γ : K, γ + h.bar γ = hypForm h 2 0 u₁ u₁ :=
    let ⟨t, ht⟩ := h.traceLin_surjective ⟨hypForm h 2 0 u₁ u₁, (h.mem_fixedField).mpr (hH u₁ u₁)⟩
    ⟨t, congrArg Subtype.val ht⟩
  obtain ⟨γ₂, hγ₂⟩ : ∃ γ : K, γ + h.bar γ = hypForm h 2 0 u₂ u₂ :=
    let ⟨t, ht⟩ := h.traceLin_surjective ⟨hypForm h 2 0 u₂ u₂, (h.mem_fixedField).mpr (hH u₂ u₂)⟩
    ⟨t, congrArg Subtype.val ht⟩
  have hR : hypForm h 2 0 u₂ u₁ = h.bar (hypForm h 2 0 u₁ u₂) := (hH u₁ u₂).symm
  set P := hypForm h 2 0 u₁ u₁ with hP
  set Q := hypForm h 2 0 u₂ u₂ with hQ
  set R := hypForm h 2 0 u₁ u₂ with hRdef
  let w₁ : Ix → K := u₁ + γ₁ • a₁ + (0 : K) • a₂
  let w₂ : Ix → K := u₂ + R • a₁ + γ₂ • a₂
  have k11 : hypForm h 2 0 a₁ w₁ = 1 := by
    simp only [w₁, map_add, map_smulₛₗ, map_smul, LinearMap.add_apply, LinearMap.smul_apply,
      smul_eq_mul, RingHom.id_apply, map_zero, h11, h12, h22, h21, g11, g12, g21, g22, f11, f12,
      f21, f22]
    ring
  have k12 : hypForm h 2 0 a₁ w₂ = 0 := by
    simp only [w₂, map_add, map_smulₛₗ, map_smul, LinearMap.add_apply, LinearMap.smul_apply,
      smul_eq_mul, RingHom.id_apply, map_zero, h11, h12, h22, h21, g11, g12, g21, g22, f11, f12,
      f21, f22]
    ring
  have k21 : hypForm h 2 0 a₂ w₁ = 0 := by
    simp only [w₁, map_add, map_smulₛₗ, map_smul, LinearMap.add_apply, LinearMap.smul_apply,
      smul_eq_mul, RingHom.id_apply, map_zero, h11, h12, h22, h21, g11, g12, g21, g22, f11, f12,
      f21, f22]
    ring
  have k22 : hypForm h 2 0 a₂ w₂ = 1 := by
    simp only [w₂, map_add, map_smulₛₗ, map_smul, LinearMap.add_apply, LinearMap.smul_apply,
      smul_eq_mul, RingHom.id_apply, map_zero, h11, h12, h22, h21, g11, g12, g21, g22, f11, f12,
      f21, f22]
    ring
  have l11 : hypForm h 2 0 w₁ a₁ = 1 := by rw [← hH a₁ w₁, k11, map_one]
  have l12 : hypForm h 2 0 w₂ a₁ = 0 := by rw [← hH a₁ w₂, k12, map_zero]
  have l21 : hypForm h 2 0 w₁ a₂ = 0 := by rw [← hH a₂ w₁, k21, map_zero]
  have l22 : hypForm h 2 0 w₂ a₂ = 1 := by rw [← hH a₂ w₂, k22, map_one]
  have m11 : hypForm h 2 0 w₁ w₁ = 0 := by
    simp only [w₁, map_add, map_smulₛₗ, map_smul, LinearMap.add_apply, LinearMap.smul_apply,
      smul_eq_mul, RingHom.id_apply, map_zero, h11, h12, h22, h21, g11, g12, g21, g22, f11, f12,
      f21, f22]
    linear_combination hγ₁ + P * h2
  have m12 : hypForm h 2 0 w₁ w₂ = 0 := by
    simp only [w₁, w₂, map_add, map_smulₛₗ, map_smul, LinearMap.add_apply, LinearMap.smul_apply,
      smul_eq_mul, RingHom.id_apply, map_zero, h11, h12, h22, h21, g11, g12, g21, g22, f11, f12,
      f21, f22]
    linear_combination R * h2
  have m21 : hypForm h 2 0 w₂ w₁ = 0 := by rw [← hH w₁ w₂, m12, map_zero]
  have m22 : hypForm h 2 0 w₂ w₂ = 0 := by
    simp only [w₂, map_add, map_smulₛₗ, map_smul, LinearMap.add_apply, LinearMap.smul_apply,
      smul_eq_mul, RingHom.id_apply, map_zero, h11, h12, h22, h21, g11, g12, g21, g22, f11, f12,
      f21, f22]
    linear_combination hγ₂ + Q * h2
  refine ⟨fun a => if a = ie1 then a₁ else if a = ie2 then a₂ else if a = if1 then w₁ else w₂,
    ?_, by simp, by simp, γ₁, 0, R, γ₂, by simp [w₁], by simp [w₂]⟩
  intro a b
  rcases ix_cases a with rfl | rfl | rfl | rfl <;> rcases ix_cases b with rfl | rfl | rfl | rfl <;>
    simp [hypGram_apply, h11, h12, h22, h21, k11, k12, k21, k22, l11, l12, l21, l22, m11, m12, m21,
      m22]

theorem burnsideF4gU4InvW_beta_pair (N : (Ix → K) →ₗ[K] (Ix → K))
    (hsa : ∀ u v, hypForm h 2 0 (N u) v = hypForm h 2 0 u (N v))
    (hr : Module.finrank K (LinearMap.range N) = 2) :
    ∃ u₁ u₂ : Ix → K, hypForm h 2 0 u₁ (N u₁) = 0 ∧ hypForm h 2 0 u₂ (N u₂) = 0 ∧
      hypForm h 2 0 u₁ (N u₂) = 1 := by
  classical
  have hB : (hypForm h 2 0).IsSymm := hypForm_isSymm h
  have hBl : (hypForm h 2 0).SeparatingLeft := hypForm_separatingLeft h
  obtain ⟨C, hC⟩ := (LinearMap.ker N).exists_isCompl
  have hrn := LinearMap.finrank_range_add_finrank_ker N
  have hcompl := Submodule.finrank_add_eq_of_isCompl hC
  have h4 : Module.finrank K (Ix → K) = 4 := by simp [Ix, HypIndex]
  have hCdim : Module.finrank K C = 2 := by omega
  let βC : C →ₛₗ[h.bar] C →ₗ[K] K := ((hypForm h 2 0).compl₂ N).domRestrict₁₂ C C
  have hβC_apply : ∀ x y : C, βC x y = hypForm h 2 0 (x : Ix → K) (N (y : Ix → K)) :=
    fun x y => rfl
  have hβC : βC.IsSymm := by
    refine ⟨fun x y => ?_⟩
    rw [hβC_apply, hβC_apply, hB.eq, hsa]
  have hβsep : βC.SeparatingLeft := by
    intro c hc
    have h1 : ∀ v : Ix → K, hypForm h 2 0 (c : Ix → K) (N v) = 0 := by
      intro v
      have hv : v ∈ (⊤ : Submodule K (Ix → K)) := Submodule.mem_top
      rw [← hC.sup_eq_top] at hv
      obtain ⟨k, hk, y, hy, rfl⟩ := Submodule.mem_sup.mp hv
      rw [map_add, map_add, LinearMap.mem_ker.mp hk, map_zero, zero_add]
      exact hc ⟨y, hy⟩
    have h2 : N (c : Ix → K) = 0 := hBl _ fun v => by rw [hsa]; exact h1 v
    exact Subtype.ext (Submodule.disjoint_def.mp hC.1 _ (LinearMap.mem_ker.mpr h2) c.2)
  obtain ⟨u₁, u₂, h11, h22, h12, -⟩ :=
    (hermitian_witt_basis h hβC hβsep hCdim).2.2.1 rfl
  exact ⟨u₁, u₂, h11, h22, h12⟩

theorem burnsideF4gU4InvW_rank_two (N : (Ix → K) →ₗ[K] (Ix → K))
    (hNN : ∀ v, N (N v) = 0)
    (hsa : ∀ u v, hypForm h 2 0 (N u) v = hypForm h 2 0 u (N v))
    (hr : Module.finrank K (LinearMap.range N) = 2) :
    ∃ v : Ix → Ix → K, (∀ a b, hypForm h 2 0 (v a) (v b) = hypGram 2 0 K a b) ∧
      N (v ie1) = 0 ∧ N (v ie2) = 0 ∧ N (v if1) = v ie2 ∧ N (v if2) = v ie1 := by
  classical
  have hB : (hypForm h 2 0).IsSymm := hypForm_isSymm h
  have hH : ∀ u v, h.bar (hypForm h 2 0 u v) = hypForm h 2 0 v u := fun u v => hB.eq u v
  obtain ⟨u₁, u₂, h11, h22, h12⟩ := burnsideF4gU4InvW_beta_pair h N hsa hr
  have haa : ∀ x y, hypForm h 2 0 (N x) (N y) = 0 := fun x y => by rw [hsa, hNN, map_zero]
  have hA1 : hypForm h 2 0 (N u₂) u₁ = 1 := by
    rw [hsa u₂ u₁, ← hH (N u₁) u₂, hsa u₁ u₂, h12, map_one]
  have hA2 : hypForm h 2 0 (N u₂) u₂ = 0 := by rw [hsa u₂ u₂, h22]
  have hA3 : hypForm h 2 0 (N u₁) u₁ = 0 := by rw [hsa u₁ u₁, h11]
  have hA4 : hypForm h 2 0 (N u₁) u₂ = 1 := by rw [hsa u₁ u₂, h12]
  obtain ⟨v, hv, hv1, hv2, c₁, c₂, d₁, d₂, hv3, hv4⟩ := burnsideF4gU4InvW_adjust h (N u₂) (N u₁)
    u₁ u₂ (haa u₂ u₂) (haa u₂ u₁) (haa u₁ u₁) hA1 hA2 hA3 hA4
  refine ⟨v, hv, ?_, ?_, ?_, ?_⟩
  · rw [hv1, hNN]
  · rw [hv2, hNN]
  · rw [hv3, hv2]
    simp [hNN]
  · rw [hv4, hv1]
    simp [hNN]

theorem burnsideF4gU4InvW_invol_cases {x : hypSU h 2 0} (hx1 : x ≠ 1) (hx2 : x * x = 1) :
    (∃ g : hypSU h 2 0, g * x * g⁻¹ ∈ zRad h) ∨
      ∃ g : hypSU h 2 0, g * x * g⁻¹ ∈ burnsideF4gU4InvW_shortRad h := by
  classical
  have := h.charP
  have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
  set X : Matrix Ix Ix K := ((x : GL Ix K) : Matrix Ix Ix K) with hXdef
  have hXX : X * X = 1 := congrArg (fun g : hypSU h 2 0 => ((g : GL Ix K) : Matrix Ix Ix K)) hx2
  have hXne : X ≠ 1 := fun h1 => hx1 (hypSU_ext h h1)
  have hiso : ∀ u v, hypForm h 2 0 (X *ᵥ u) (X *ᵥ v) = hypForm h 2 0 u v :=
    (mem_gramSU_iff_isometry.mp x.2).1
  have hsw : ∀ u v, hypForm h 2 0 (X *ᵥ u) v = hypForm h 2 0 u (X *ᵥ v) := by
    intro u v
    have h1 := hiso u (X *ᵥ v)
    rw [mulVec_mulVec, hXX, one_mulVec] at h1
    exact h1
  let N : (Ix → K) →ₗ[K] (Ix → K) := Matrix.mulVecLin X - LinearMap.id
  have hNv : ∀ v, N v = X *ᵥ v - v := fun v => rfl
  have hNN : ∀ v, N (N v) = 0 := by
    intro v
    rw [hNv, hNv, Matrix.mulVec_sub, mulVec_mulVec, hXX, one_mulVec]
    ext i
    simp only [Pi.sub_apply, Pi.zero_apply]
    linear_combination (v i - (X *ᵥ v) i) * h2
  have hsa : ∀ u v, hypForm h 2 0 (N u) v = hypForm h 2 0 u (N v) := by
    intro u v
    simp only [hNv, map_sub, LinearMap.sub_apply, hsw]
  have hker : LinearMap.range N ≤ LinearMap.ker N := by
    rintro _ ⟨v, rfl⟩
    exact LinearMap.mem_ker.mpr (hNN v)
  have hrn := LinearMap.finrank_range_add_finrank_ker N
  have hle := Submodule.finrank_mono hker
  have h4 : Module.finrank K (Ix → K) = 4 := by simp [Ix, HypIndex]
  have hr0 : Module.finrank K (LinearMap.range N) ≠ 0 := by
    intro h0
    have hN0 : N = 0 := LinearMap.range_eq_bot.mp (Submodule.finrank_eq_zero.mp h0)
    apply hXne
    ext i j
    have h1 : X *ᵥ Pi.single j 1 - Pi.single j 1 = 0 := by rw [← hNv, hN0]; rfl
    have h3 := congrFun h1 i
    rw [mulVec_single_one] at h3
    simpa [Matrix.col_apply, Matrix.one_apply, Pi.single_apply, sub_eq_zero] using h3
  have hcases : Module.finrank K (LinearMap.range N) = 1 ∨
      Module.finrank K (LinearMap.range N) = 2 := by omega
  rcases hcases with hr | hr
  · obtain ⟨v, c, hv, hc, hNv'⟩ := burnsideF4gU4InvW_rank_one h N hNN hsa hr
    have hadm : SAdm h 0 0 c := (sAdm_zero_zero_iff h).mpr hc
    obtain ⟨g, hg⟩ := burnsideF4gU4InvW_conj_sElt h x v hv hadm (fun a => by
      have h1 : X *ᵥ v a = v a + N (v a) := by rw [hNv]; abel
      rw [h1, hNv']
      by_cases ha : a = if1 <;> simp [ha])
    left
    refine ⟨g⁻¹, ?_⟩
    rw [inv_inv, hg]
    exact ⟨c, hc, rfl⟩
  · obtain ⟨v, hv, hN1, hN2, hN3, hN4⟩ := burnsideF4gU4InvW_rank_two h N hNN hsa hr
    have hadm : SAdm h 1 0 0 := sAdm_x_zero h 1
    obtain ⟨g, hg⟩ := burnsideF4gU4InvW_conj_sElt h x v hv hadm (fun a => by
      have h1 : X *ᵥ v a = v a + N (v a) := by rw [hNv]; abel
      rw [h1]
      rcases ix_cases a with rfl | rfl | rfl | rfl <;> simp [hN1, hN2, hN3, hN4])
    right
    refine ⟨g⁻¹, ?_⟩
    rw [inv_inv, hg]
    exact ⟨1, rfl⟩

end Witt



section InvP

open Matrix CFSG.ClassicalGroups.UnitaryFlag CFSG.LocalAnalysis.ComponentInitial
  CFSG.Quasithin.H13.U4Par CFSG.Quasithin CFSG.ASVolI.ChF

variable {m : ℕ} {K : Type} [Field K] (h : UnitaryFieldData 2 m K)

theorem burnsideF4gU4Inv_parP_inf_parP2 : parP h ⊓ parP2 h = hypBorel h 2 0 := by
  ext g
  simp only [Subgroup.mem_inf, UnitaryHigher.mem_isoStabilizer, mem_hypBorel]
  constructor
  · rintro ⟨h1, h2⟩ i hi1 hi2
    interval_cases i <;> assumption
  · intro H
    exact ⟨H 1 le_rfl (by norm_num), H 2 (by norm_num) le_rfl⟩

theorem burnsideF4gU4Inv_pCore_borel :
    pCoreOf 2 (parP h ⊓ parP2 h) = hypUnitriangular h 2 0 := by
  have := CFSG.Quasithin.H13.U4Par.finite_hypSU h
  have hN : Subgroup.normalizer (hypUnitriangular h 2 0 : Set (hypSU h 2 0)) = hypBorel h 2 0 :=
    UnitaryHigher.normalizer_hypUnitriangular h (by norm_num) (by norm_num)
  have hUB : hypUnitriangular h 2 0 ≤ hypBorel h 2 0 := hypUnitriangular_le_hypBorel h
  rw [burnsideF4gU4Inv_parP_inf_parP2]
  refine burnsideF4f_pCoreOf_eq hUB ?_ (isSylowTwoOf_hypUnitriangular h).2.1 ?_
  · intro b hb u hu
    have hb' : b ∈ Subgroup.normalizer (hypUnitriangular h 2 0 : Set (hypSU h 2 0)) := hN ▸ hb
    exact (Subgroup.mem_normalizer_iff.mp hb' u).mp hu
  · intro x hx k hxk
    exact le_of_isPGroup_of_sylow_le hUB (hN ▸ le_rfl) le_rfl (isSylowTwoOf_hypUnitriangular h)
      (isPGroup_zpowers_of_pow hxk) ((Subgroup.zpowers_le (H := hypBorel h 2 0)).mpr hx)
      (Subgroup.mem_zpowers x)

theorem burnsideF4gU4Inv_radQ_le_U : radQ h ≤ hypUnitriangular h 2 0 := by
  rintro g ⟨x, y, c, -, hg⟩
  rw [mem_hypUnitriangular, hg]
  refine ⟨?_, fun a => ?_⟩
  · intro i j hij
    rcases ix_cases i with rfl | rfl | rfl | rfl <;>
      rcases ix_cases j with rfl | rfl | rfl | rfl <;>
      simp [sMat_apply, one_apply, ie1, ie2, if1, if2] at hij ⊢
  · rcases ix_cases a with rfl | rfl | rfl | rfl <;>
      simp [sMat_apply, one_apply, ie1, ie2, if1, if2]

theorem burnsideF4gU4Inv_mem_zRad_of_comm {z : hypSU h 2 0} (hz : z ∈ parP h)
    (hchi : chi h z = 1) (hcomm : ∀ g ∈ radQ h, z * g = g * z) : z ∈ zRad h := by
  have := h.charP
  obtain ⟨ω, hω⟩ := h.exists_bar_ne
  obtain ⟨hrow, hdiag⟩ := row_if1_of_col h z ((mem_parP_iff h z).mp hz)
  have hcol := (mem_parP_iff h z).mp hz
  set Z : Matrix Ix Ix K := ((z : GL Ix K) : Matrix Ix Ix K) with hZ
  have c2 : Z ie2 ie1 = 0 := hcol ie2 ie2_ne_ie1
  have c3 : Z if1 ie1 = 0 := hcol if1 if1_ne_ie1
  have c4 : Z if2 ie1 = 0 := hcol if2 if2_ne_ie1
  have r1 : Z if1 ie2 = 0 := hrow ie2 ie2_ne_if1
  have r2 : Z if1 if2 = 0 := hrow if2 if2_ne_if1
  have hc11 : Z ie1 ie1 = 1 := hchi
  have hf11 : Z if1 if1 = 1 := by
    rw [hc11, map_one, one_mul] at hdiag
    exact hdiag
  have hX : ∀ t : K, Z * sMat h t 0 0 = sMat h t 0 0 * Z := fun t => by
    have := congrArg (fun g : hypSU h 2 0 => ((g : GL Ix K) : Matrix Ix Ix K))
      (hcomm _ (sElt_mem_radQ h (sAdm_x_zero h t)))
    simpa only [coe_mul_hypSU, coe_sElt] using this
  have hY : ∀ t : K, Z * sMat h 0 t 0 = sMat h 0 t 0 * Z := fun t => by
    have := congrArg (fun g : hypSU h 2 0 => ((g : GL Ix K) : Matrix Ix Ix K))
      (hcomm _ (sElt_mem_radQ h (sAdm_zero_y h t)))
    simpa only [coe_mul_hypSU, coe_sElt] using this
  have e12 : ∀ t : K, Z ie1 ie2 * t = h.bar t * Z if2 if1 := fun t => by
    have := congrFun (congrFun (hX t) ie1) if1
    rw [mul_apply, mul_apply, sum_ix, sum_ix] at this
    simp [sMat_apply, one_apply, hc11, hf11, c2, c3, c4, r1, r2] at this
    linear_combination this
  have e22 : ∀ t : K, Z ie2 ie2 * t = t := fun t => by
    have := congrFun (congrFun (hX t) ie2) if1
    rw [mul_apply, mul_apply, sum_ix, sum_ix] at this
    simp [sMat_apply, one_apply, hc11, hf11, c2, c3, c4, r1, r2] at this
    linear_combination this
  have e33 : ∀ t : K, Z if2 if2 * h.bar t = h.bar t := fun t => by
    have := congrFun (congrFun (hX t) ie1) if2
    rw [mul_apply, mul_apply, sum_ix, sum_ix] at this
    simp [sMat_apply, one_apply, hc11, hf11, c2, c3, c4, r1, r2] at this
    linear_combination -this
  have m21 : Z if2 ie2 = 0 := by
    have := congrFun (congrFun (hX 1) if2) if1
    rw [mul_apply, mul_apply, sum_ix, sum_ix] at this
    simpa [sMat_apply, one_apply, hc11, hf11, c2, c3, c4, r1, r2] using this
  have f12 : ∀ t : K, Z ie1 if2 * t = h.bar t * Z ie2 if1 := fun t => by
    have := congrFun (congrFun (hY t) ie1) if1
    rw [mul_apply, mul_apply, sum_ix, sum_ix] at this
    simp [sMat_apply, one_apply, hc11, hf11, c2, c3, c4, r1, r2] at this
    linear_combination this
  have m12 : Z ie2 if2 = 0 := by
    have := congrFun (congrFun (hY 1) ie2) if1
    rw [mul_apply, mul_apply, sum_ix, sum_ix] at this
    simpa [sMat_apply, one_apply, hc11, hf11, c2, c3, c4, r1, r2] using this
  have hne : ω - h.bar ω ≠ 0 := fun e => hω (sub_eq_zero.mp e).symm
  have hp : Z ie1 ie2 = 0 ∧ Z if2 if1 = 0 := by
    have h1 := e12 1
    have h2 := e12 ω
    simp only [mul_one, map_one, one_mul] at h1
    rw [← h1] at h2
    have : Z ie1 ie2 * (ω - h.bar ω) = 0 := by linear_combination h2
    have h0 := (mul_eq_zero.mp this).resolve_right hne
    exact ⟨h0, by rw [← h1, h0]⟩
  have hr : Z ie1 if2 = 0 ∧ Z ie2 if1 = 0 := by
    have h1 := f12 1
    have h2 := f12 ω
    simp only [mul_one, map_one, one_mul] at h1
    rw [← h1] at h2
    have : Z ie1 if2 * (ω - h.bar ω) = 0 := by linear_combination h2
    have h0 := (mul_eq_zero.mp this).resolve_right hne
    exact ⟨h0, by rw [← h1, h0]⟩
  have m11 : Z ie2 ie2 = 1 := by simpa using e22 1
  have m22 : Z if2 if2 = 1 := by simpa using e33 1
  have hgram := (mem_gramSU.mp z.2).1
  have entry : ∀ i j, ∑ k, h.bar (Z (hypPartner k) i) * Z k j = hypGram 2 0 K i j := by
    intro i j
    have := congrFun (congrFun hgram i) j
    rw [mul_apply] at this
    simpa only [mul_hypGram_apply, transpose_apply, map_apply] using this
  have hbar : h.bar (Z ie1 if1) = Z ie1 if1 := by
    have := entry if1 if1
    rw [sum_ix, hypGram_apply] at this
    simp [hf11, hp.2, hr.2] at this
    have e : Z ie1 if1 + h.bar (Z ie1 if1) = 0 := by linear_combination this
    have e2 : h.bar (Z ie1 if1) = -Z ie1 if1 := by linear_combination e
    rw [e2, CharTwo.neg_eq]
  refine ⟨Z ie1 if1, hbar, ?_⟩
  rw [← hZ]
  ext i j
  rcases ix_cases i with rfl | rfl | rfl | rfl <;> rcases ix_cases j with rfl | rfl | rfl | rfl <;>
    simp [sMat_apply, one_apply, hc11, hf11, c2, c3, c4, r1, r2, hp.1, hp.2, hr.1, hr.2,
      m11, m22, m21, m12]

theorem burnsideF4gU4Inv_U_entries {g : hypSU h 2 0} (hg : g ∈ hypUnitriangular h 2 0) :
