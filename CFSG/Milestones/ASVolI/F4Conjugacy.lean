  refine ⟨CFSG.Quasithin.H13.F431.G2Two.Tab.mulT
    (CFSG.Quasithin.H13.F431.G2Two.Tab.mulT m 32) (CFSG.Quasithin.H13.F431.G2Two.Tab.invT m),
    ?_, ?_⟩
  · exact (by decide +kernel : ∀ m < 64, CFSG.Quasithin.H13.F431.G2Two.Tab.mulT
      (CFSG.Quasithin.H13.F431.G2Two.Tab.mulT m 32) (CFSG.Quasithin.H13.F431.G2Two.Tab.invT m) ∈
      [32, 40, 44, 58]) m hm
  · rw [← burnsideF4gG2TwoInv_sEl32 h2]
    exact CFSG.Quasithin.H13.F431.G2Two.Model.sEl_conj h2 hk2 hm (by norm_num)

theorem burnsideF4gG2TwoInv_cent_rho_le_P₁ (h2 : (2 : K) = 0) (hk2 : ∀ c : K, c = 0 ∨ c = 1)
    {c : G2Group K} (hc : c * g2RhoC h2 = g2RhoC h2 * c) : c ∈ (lat h2 hk2).P₁ := by
  have D := g2IndexTwoData h2 hk2
  have hS : (lat h2 hk2).S = D.ext u33Data.T CFSG.Quasithin.u33Phi'_T := rfl
  have hP₁ : (lat h2 hk2).P₁ = D.ext u33Data.A CFSG.Quasithin.u33Phi'_A := rfl
  obtain ⟨x, ε, hcx⟩ := exists_rep h2 hk2 c
  obtain ⟨j, i₁, i₂, hx⟩ := u33Data.cover x
  have hρS : g2RhoC h2 ∈ (lat h2 hk2).S := by
    rw [hS]; exact D.rho_mem_ext _
  have hs₁ : g2HomC h2 (u33Data.Tel i₁) ∈ (lat h2 hk2).S := by
    rw [hS]; exact D.map_le_ext _ ⟨_, u33Data.Tel_mem_T i₁, rfl⟩
  have hs₂ : g2HomC h2 (u33Data.Tel i₂) * rhoPow h2 ε ∈ (lat h2 hk2).S := by
    refine Subgroup.mul_mem _ ?_ ?_
    · rw [hS]; exact D.map_le_ext _ ⟨_, u33Data.Tel_mem_T i₂, rfl⟩
    · cases ε
      · exact Subgroup.one_mem _
      · exact hρS
  have hcd : c = g2HomC h2 (u33Data.Tel i₁) * g2HomC h2 (u33Data.D j) *
      (g2HomC h2 (u33Data.Tel i₂) * rhoPow h2 ε) := by
    rw [hcx, hx, map_mul, map_mul]
    group
  set s₁ := g2HomC h2 (u33Data.Tel i₁) with hs₁def
  set d := g2HomC h2 (u33Data.D j) with hddef
  set s₂ := g2HomC h2 (u33Data.Tel i₂) * rhoPow h2 ε with hs₂def
  have hcρ : s₁ * d * s₂ * g2RhoC h2 = g2RhoC h2 * (s₁ * d * s₂) := by rw [← hcd]; exact hc
  have hconj : d * (s₂ * g2RhoC h2 * s₂⁻¹) * d⁻¹ = s₁⁻¹ * g2RhoC h2 * s₁ := by
    calc d * (s₂ * g2RhoC h2 * s₂⁻¹) * d⁻¹
        = s₁⁻¹ * (s₁ * d * s₂ * g2RhoC h2) * s₂⁻¹ * d⁻¹ := by group
      _ = s₁⁻¹ * (g2RhoC h2 * (s₁ * d * s₂)) * s₂⁻¹ * d⁻¹ := by rw [hcρ]
      _ = s₁⁻¹ * g2RhoC h2 * s₁ := by group
  obtain ⟨k₂, hk₂, e₂⟩ := burnsideF4gG2TwoInv_S_conj_rho h2 hk2 hs₂
  obtain ⟨k₁, hk₁, e₁⟩ := burnsideF4gG2TwoInv_S_conj_rho h2 hk2 ((lat h2 hk2).S.inv_mem hs₁)
  rw [inv_inv] at e₁
  rw [e₂, e₁] at hconj
  have hperm := congrArg (psi h2 hk2) hconj
  rw [map_mul, map_mul, map_inv, hddef, psi_f, burnsideF4gG2TwoInv_psi_sEl,
    burnsideF4gG2TwoInv_psi_sEl] at hperm
  have hD : u33PresHom (u33Data.D j) = CFSG.Quasithin.u33D u33GenP (j : ℕ) :=
    CFSG.Quasithin.u33D_hom j
  rw [hD] at hperm
  have hj2 := burnsideF4gG2TwoInv_double_coset_perm j k₁ hk₁ k₂ hk₂ hperm
  have hjA : u33Data.D j ∈ u33Data.A := by
    have : (j : ℕ) = 0 ∨ (j : ℕ) = 1 := by omega
    rcases this with h | h
    · have hj0 : j = u33Data.j0 := Fin.ext h
      rw [hj0, u33Data.D_zero]; exact Subgroup.one_mem _
    · have hja : j = u33Data.ja := Fin.ext h
      rw [hja]; exact u33Data.D_ja
  have hdP : d ∈ (lat h2 hk2).P₁ := by
    rw [hP₁]; exact D.map_le_ext _ ⟨_, hjA, rfl⟩
  rw [hcd]
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ ((lat h2 hk2).S_le_P₁ hs₁) hdP)
    ((lat h2 hk2).S_le_P₁ hs₂)

@[expose] noncomputable def burnsideF4gG2TwoInv_letter (h2 : (2 : K) = 0) (c : ℕ) : G2Group K :=
  if c < 5 then g2HomC h2 (u33GenPG c) else if c < 10 then (g2HomC h2 (u33GenPG (c - 5)))⁻¹
  else g2RhoC h2

@[expose] noncomputable def burnsideF4gG2TwoInv_evalW (h2 : (2 : K) = 0) :
    List ℕ → G2Group K
  | [] => 1
  | c :: w => burnsideF4gG2TwoInv_letter h2 c * burnsideF4gG2TwoInv_evalW h2 w

theorem burnsideF4gG2TwoInv_evalW_rep (h2 : (2 : K) = 0) (hk2 : ∀ c : K, c = 0 ∨ c = 1)
    (w : List ℕ) (hw : ∀ c ∈ w, c ≤ 10) :
    CFSG.Quasithin.RepL (burnsideF4gG2TwoInv_evalL w)
      (psi h2 hk2 (burnsideF4gG2TwoInv_evalW h2 w)) := by
  induction w with
  | nil => exact reprN_one h2 hk2
  | cons c w ih =>
    have hc := hw c (by simp)
    have ih' := ih (fun c' hc' => hw c' (by simp [hc']))
    have hl : CFSG.Quasithin.RepL (burnsideF4gG2TwoInv_letterL c)
        (psi h2 hk2 (burnsideF4gG2TwoInv_letter h2 c)) := by
      unfold burnsideF4gG2TwoInv_letterL burnsideF4gG2TwoInv_letter
      split_ifs with h5 h10
      · exact reprN_gen h2 hk2 c h5
      · exact reprN_genInv h2 hk2 (c - 5) (by omega)
      · exact reprN_rho h2 hk2
    exact reprN_mul h2 hk2 hl ih'

theorem burnsideF4gG2TwoInv_fusion (h2 : (2 : K) = 0) (hk2 : ∀ c : K, c = 0 ∨ c = 1) {i : ℕ}
    (hi : i < 64) (hi32 : 32 ≤ i) (hsq : sEl h2 i * sEl h2 i = 1) :
    IsConj (sEl h2 i) (g2RhoC h2) := by
  have hmul : CFSG.Quasithin.H13.F431.G2Two.Tab.mulT i i = 0 :=
    (CFSG.Quasithin.H13.F431.G2Two.Model.sEl_sq h2 hk2 hi).1 hsq
  set w := burnsideF4gG2TwoInv_fusWord i
  have hrep := burnsideF4gG2TwoInv_evalW_rep h2 hk2 w (burnsideF4gG2TwoInv_fusWord_le i hi)
  have h := burnsideF4gG2TwoInv_fusion_check i hi hi32 hmul
  have e : burnsideF4gG2TwoInv_evalW h2 w * sEl h2 i =
      sEl h2 32 * burnsideF4gG2TwoInv_evalW h2 w :=
    eqN h2 hk2 (reprN_mul h2 hk2 hrep (CFSG.Quasithin.F6.G22Perm.repL_psi_sEl h2 hk2 i hi))
      (h ▸ reprN_mul h2 hk2 (CFSG.Quasithin.F6.G22Perm.repL_psi_sEl h2 hk2 32 (by norm_num)) hrep)
  rw [burnsideF4gG2TwoInv_sEl32 h2] at e
  refine isConj_iff.2 ⟨burnsideF4gG2TwoInv_evalW h2 w, ?_⟩
  rw [e]
  group

theorem burnsideF4gG2TwoInv_outer_inv_conj [Finite K] (h2 : (2 : K) = 0)
    (hk2 : ∀ c : K, c = 0 ∨ c = 1) {v : G2Group K} (hvJ : v ∉ (g2HomC h2).range)
    (hv : v * v = 1) : IsConj v (g2RhoC h2) := by
  haveI : Finite (G2Group K) := CFSG.Quasithin.finite_g2Group
  obtain ⟨g, hg⟩ := burnsideF4gG2TwoInv_exists_conj_mem_sylow (lat h2 hk2).sylow hv
  obtain ⟨i, hi, hvi⟩ := (mem_S_iff h2 hk2).1 hg
  have hnotJ : g⁻¹ * v * g ∉ (g2HomC h2).range := fun h => hvJ (by
    have := (burnsideF4gG2TwoInv_J_normal h2 hk2).conj_mem _ h g
    have e : g * (g⁻¹ * v * g) * g⁻¹ = v := by group
    rwa [e] at this)
  have hi32 : 32 ≤ i := by
    by_contra hlt
    have hlt' : i < 32 := by omega
    apply hnotJ
    rw [hvi]
    refine ⟨u33Tel u33GenPG i, ?_⟩
    simp [sEl, hlt']
  have hsq : sEl h2 i * sEl h2 i = 1 := by
    rw [← hvi]
    calc g⁻¹ * v * g * (g⁻¹ * v * g) = g⁻¹ * (v * v) * g := by group
      _ = 1 := by rw [hv]; group
  have h1 := burnsideF4gG2TwoInv_fusion h2 hk2 hi hi32 hsq
  have h0 : IsConj v (sEl h2 i) := isConj_iff.2 ⟨g⁻¹, by rw [← hvi]; group⟩
  exact h0.trans h1

theorem burnsideF4gG2TwoInv_inner_inv_conj (h2 : (2 : K) = 0) {v : G2Group K}
    (hvJ : v ∈ (g2HomC h2).range) (hv1 : v ≠ 1) (hv2 : v * v = 1) :
