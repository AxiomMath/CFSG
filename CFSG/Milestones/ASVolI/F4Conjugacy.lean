@[expose] noncomputable def burnsideF4gU5_Y1 (hσ : ∀ c, σ (σ c) = c) : SU σ 5 :=
  rootHom σ hσ (i := (1 : Fin 5)) (j := (0 : Fin 5)) (by decide) (by decide) (by decide)
    (Multiplicative.ofAdd 1)

