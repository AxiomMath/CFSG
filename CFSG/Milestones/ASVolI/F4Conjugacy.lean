open CFSG.Quasithin CFSG.Quasithin.RankTwoAmalgam CFSG.Quasithin.RankTwoAmalgam.Completion

theorem burnsideF4gF4Two_cosetGeom_swap {G : Type*} [Group G] (G₀ G₁ G₂ : Subgroup G) :
    Nonempty (CosetGeom.graph G₀ G₁ G₂ ≃g CosetGeom.graph G₀ G₂ G₁) := by
  refine ⟨{ toEquiv := Equiv.sumComm _ _, map_rel_iff' := ?_ }⟩
  intro a b
  rcases a with x | y <;> rcases b with x' | y'
  · exact iff_of_false CosetGeom.not_adj_inr_inr CosetGeom.not_adj_inl_inl
  · show (CosetGeom.graph G₀ G₂ G₁).Adj (Sum.inl y') (Sum.inr x) ↔
      (CosetGeom.graph G₀ G₁ G₂).Adj (Sum.inl x) (Sum.inr y')
    rw [CosetGeom.adj_inl_inr, CosetGeom.adj_inl_inr]
    exact ⟨fun ⟨g, h1, h2⟩ => ⟨g, h2, h1⟩, fun ⟨g, h1, h2⟩ => ⟨g, h2, h1⟩⟩
  · show (CosetGeom.graph G₀ G₂ G₁).Adj (Sum.inr x') (Sum.inl y) ↔
      (CosetGeom.graph G₀ G₁ G₂).Adj (Sum.inr y) (Sum.inl x')
    rw [CosetGeom.adj_inr_inl, CosetGeom.adj_inr_inl]
    exact ⟨fun ⟨g, h1, h2⟩ => ⟨g, h2, h1⟩, fun ⟨g, h1, h2⟩ => ⟨g, h2, h1⟩⟩
  · exact iff_of_false CosetGeom.not_adj_inl_inl CosetGeom.not_adj_inr_inr

theorem burnsideF4gF4Two_mem_range_φ1 {G : Type*} [Group G] (P1 P2 G0 : Subgroup G)
    (h : P1 ⊔ P2 = G0) (x : ↥G0) :
