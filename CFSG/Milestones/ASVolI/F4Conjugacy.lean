open CFSG.ASVolI.ChF CFSG.ASVolI.ChF.ClassicalRoots CFSG.Assembly.LowTwoRank

theorem burnsideF4gU5_antidiag_eq (K : Type) [Field K] :
    (antidiag 5 : Matrix (Fin 5) (Fin 5) K) = hermitianGram 5 K := by
  ext i j
  simp only [antidiag, hermitianGram, Matrix.of_apply]
  have hi := i.isLt
  have hj := j.isLt
  by_cases h : (i : ℕ) + j + 1 = 5
  · have : j = Fin.rev i := Fin.ext (by rw [Fin.val_rev]; omega)
    rw [if_pos this, if_pos h]
  · have : j ≠ Fin.rev i := fun hh => h (by rw [hh, Fin.val_rev]; omega)
    rw [if_neg this, if_neg h]

theorem burnsideF4gU5_basis_gram {f : ℕ} {H : Type} [Group H]
    (marking : Marking .U5 2 f H) [CharP marking.field 2] :
    conjTr (unitaryInvolution marking.field 2 f)
        ((marking.basis : GL (Fin 5) marking.field) : Matrix (Fin 5) (Fin 5) marking.field) *
      ((marking.basis : GL (Fin 5) marking.field) : Matrix (Fin 5) (Fin 5) marking.field) =
      antidiag 5 := by
  have h := marking.basis_compatible
  rw [burnsideF4gU5_antidiag_eq, ← h]
  congr 1

theorem burnsideF4gU5_coordinateSpace_flag (K : Type) [Field K] (b : Bool) :
    coordinateSpace (if b then flagTwo .U5 else flagOne .U5 : Set (Coord .U5)) =
      (burnsideF4gU5_flag K (if b then 2 else 1) : Set (Fin 5 → K)) := by
  cases b
  · ext v
    simp only [coordinateSpace, flagOne, burnsideF4gU5_flag, Set.mem_setOf_eq, Bool.false_eq_true,
      if_false, Set.mem_singleton_iff]
    constructor
    · intro h a ha
      exact h a (by intro h0; subst h0; simp at ha)
    · intro h a ha
      exact h a (by
        have : a ≠ 0 := ha
        have := Fin.val_ne_iff.mpr this
        simp at this
        omega)
  · ext v
    simp only [coordinateSpace, flagTwo, burnsideF4gU5_flag, Set.mem_setOf_eq, if_true,
      Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · intro h a ha
      exact h a (by
        rintro (h0 | h0) <;> subst h0 <;> simp at ha)
    · intro h a ha
      exact h a (by
        by_contra hc
        apply ha
        have : (a : ℕ) < 2 := by omega
        have : (a : ℕ) = 0 ∨ (a : ℕ) = 1 := by omega
        rcases this with h0 | h0
        · left; exact Fin.ext h0
        · right; exact Fin.ext h0)

noncomputable def burnsideF4gU5_Φn {K : Type} [Field K] [Finite K] [CharP K 2] {f : ℕ}
    (hF : Nat.card K = (2 ^ f) ^ 2) (B : GL (Coord .U5) K)
    (hB : conjTr (unitaryInvolution K 2 f) (B : Matrix (Fin 5) (Fin 5) K) *
      (B : Matrix (Fin 5) (Fin 5) K) = antidiag 5) :
    SU (unitaryInvolution K 2 f) 5 ≃* nativeGroup .U5 (2 ^ f) K :=
  burnsideF4gU5_Φ hF B hB

theorem burnsideF4gU5_nativeParabolic_comap {K : Type} [Field K] [Finite K] [CharP K 2] {f : ℕ}
    (hF : Nat.card K = (2 ^ f) ^ 2) (B : GL (Coord .U5) K)
    (hB : conjTr (unitaryInvolution K 2 f) (B : Matrix (Fin 5) (Fin 5) K) *
      (B : Matrix (Fin 5) (Fin 5) K) = antidiag 5) (b : Bool) :
    (nativeParabolic .U5 (2 ^ f) K B b).comap (burnsideF4gU5_Φn hF B hB).toMonoidHom =
      burnsideF4gU5_stab (unitaryInvolution K 2 f) (if b then 2 else 1) := by
  ext A
  have h1 : burnsideF4gU5_Φn hF B hB A ∈ nativeParabolic .U5 (2 ^ f) K B b ↔
      ((burnsideF4gU5_Φn hF B hB A : nativeGroup .U5 (2 ^ f) K) : GL (Coord .U5) K) ∈
        rawStabilizer ((fun v => (B : Matrix (Coord .U5) (Coord .U5) K).mulVec v) ''
          coordinateSpace (if b then flagTwo .U5 else flagOne .U5)) := Iff.rfl
  have h2 : ((burnsideF4gU5_Φn hF B hB A : nativeGroup .U5 (2 ^ f) K) : GL (Coord .U5) K) =
      B * ((A : GL (Fin 5) K) : GL (Coord .U5) K) * B⁻¹ := rfl
  rw [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, h1, burnsideF4f_mem_rawStabilizer, h2,
    burnsideF4gU5_conj_stab_iff, burnsideF4gU5_coordinateSpace_flag]
  exact Iff.rfl

theorem burnsideF4gU5_ker_compn {K : Type} [Field K] [Finite K] [CharP K 2] {f : ℕ}
    (hF : Nat.card K = (2 ^ f) ^ 2) {H : Type} [Group H] (B : GL (Coord .U5) K)
    (hB : conjTr (unitaryInvolution K 2 f) (B : Matrix (Fin 5) (Fin 5) K) *
      (B : Matrix (Fin 5) (Fin 5) K) = antidiag 5) (τ : nativeGroup .U5 (2 ^ f) K →* H)
    (hτ : ∀ g : nativeGroup .U5 (2 ^ f) K,
      τ g = 1 ↔ (g : GL (Coord .U5) K) ∈ StatedScalars (Coord .U5) K) :
    (τ.comp (burnsideF4gU5_Φn hF B hB).toMonoidHom).ker =
      Subgroup.center (SU (unitaryInvolution K 2 f) 5) :=
  burnsideF4gU5_ker_comp hF B hB τ hτ

theorem burnsideF4gU5_yam_of_marking {f : ℕ} {H : Type} [Group H]
    (marking : CFSG.ASVolI.ChF.ClassicalRoots.Marking .U5 2 f H) :
    ∃ TD : Subgroup H, CFSG.Quasithin.IsYAmalgamPair TD (marking.parabolic false)
      (marking.parabolic true) := by
  have hcard : Nat.card marking.field = (2 ^ f) ^ 2 := by
    have := marking.field_card
    simpa using this
  haveI : CharP marking.field 2 := by
    have h2 : Nat.card marking.field = 2 ^ (f * 2) := by rw [hcard, ← pow_mul]
    exact burnsideF4f_charP_of_card (by have := marking.exponent_pos; omega) h2
  have hB := burnsideF4gU5_basis_gram marking
  let Φ := burnsideF4gU5_Φn hcard marking.basis hB
  let θ : SU (unitaryInvolution marking.field 2 f) 5 →* H :=
    marking.transport.comp Φ.toMonoidHom
  have hθ : Function.Surjective θ :=
    (burnsideF4f_transport_surjective marking).comp Φ.surjective
  have hker : θ.ker = Subgroup.center (SU (unitaryInvolution marking.field 2 f) 5) :=
    burnsideF4gU5_ker_compn hcard marking.basis hB marking.transport
      (burnsideF4f_transport_eq_one_iff marking)
  obtain ⟨TD, hTD⟩ := burnsideF4gU5_yam_of_ker hcard θ hθ hker
  have hpar : ∀ b : Bool, marking.parabolic b =
      (burnsideF4gU5_stab (unitaryInvolution marking.field 2 f) (if b then 2 else 1)).map θ := by
    intro b
    have h1 := burnsideF4gU5_nativeParabolic_comap hcard marking.basis hB b
    have h2 : marking.parabolic b =
        (nativeParabolic .U5 (2 ^ f) marking.field marking.basis b).map marking.transport := rfl
    have hΦs : Function.Surjective Φ.toMonoidHom := Φ.surjective
    rw [h2, ← Subgroup.map_comap_eq_self_of_surjective hΦs
      (nativeParabolic .U5 (2 ^ f) marking.field marking.basis b), h1, Subgroup.map_map]
  refine ⟨TD, ?_⟩
  rw [hpar false, hpar true]
  exact hTD

end Marking

