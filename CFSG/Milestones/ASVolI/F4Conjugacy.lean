section Stated

open CFSG.Quasithin CFSG.QuasithinUnique CFSG.QuasithinUnique.Borel252
  CFSG.QuasithinUnique.Setup.X7a CFSG.QuasithinUnique.Setup.X7b
  CFSG.LocalAnalysis.ComponentInitial.SymplecticFlag
  CFSG.ComponentClassification.UnbalancedCatalog.SpChain

theorem burnsideF4gSp_exists_iso {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ}
    (hK : Nat.card K = 2 ^ n) :
    ∃ θ : antiSp K ≃* StatedProj (StatedSp 2 K),
      (antiUnipotent K).map θ.toMonoidHom = projUnipotent 2 K := by
  obtain ⟨P, hP⟩ := exists_sylow_projUnipotent (K := K) 2 (r := 2) (by norm_num)
  have hU₀ : IsSylowTwoOf (projUnipotent 2 K) ⊤ := hP ▸ CFSG.QuasithinUnique.isSylowTwoOf_top_of_sylow P
  obtain ⟨θ, hθU, -⟩ := (symplectic_two_residualOvergroupsAt ⟨n, hK⟩).exists_iso_of_isSylow
    (antiProjEquiv K) hU₀ card_and_isSylowTwoOf_antiUnipotent.2
  exact ⟨θ, hθU⟩

theorem burnsideF4gSp_borelData {K : Type} [Field K] [Finite K] [CharP K 2]
    (θ : antiSp K ≃* StatedProj (StatedSp 2 K))
    (hθ : (antiUnipotent K).map θ.toMonoidHom = projUnipotent 2 K) :
    BorelData (antiSp K) (antiUnipotent K) (radA1 K) (radA2 K) := by
  have hov := (Borel252.Sp4.overgroupData_Sp K).map θ.symm
  have hU' : (projUnipotent 2 K).map θ.symm.toMonoidHom = antiUnipotent K := by
    rw [← hθ, Subgroup.map_map]
    ext x
    simp
  rw [hU'] at hov
  exact
    { center_trivial := Fin257.Sp4.center_trivial_Sp
      sylow := card_and_isSylowTwoOf_antiUnipotent.2
      le₁ := radA1_le_antiUnipotent
      le₂ := radA2_le_antiUnipotent
      sup := antiUnipotent_eq_radA1_sup_radA2.symm
      cent₁ := fun g hg => Fin257.Sp4.cent_radA1 hg
      cent₂ := fun g hg => Fin257.Sp4.cent_radA2 hg
      lt₁ := Fin257.Sp4.lt_normalizer_radA1
      lt₂ := Fin257.Sp4.lt_normalizer_radA2
      lt_top₁ := Fin257.Sp4.normalizer_radA1_lt_top
      lt_top₂ := Fin257.Sp4.normalizer_radA2_lt_top
      core₁ := Fin257.Sp4.core_radA1
      core₂ := Fin257.Sp4.core_radA2
      only := fun _ h1 h2 =>
        only_of_overgroupData hov Fin257.Sp4.lt_normalizer_radA1
          Fin257.Sp4.normalizer_radA1_lt_top Fin257.Sp4.lt_normalizer_radA2
          Fin257.Sp4.normalizer_radA2_lt_top
          (ne_normalizer_of_sup antiUnipotent_eq_radA1_sup_radA2.symm
            Fin257.Sp4.lt_normalizer_radA1) h1 h2 }

theorem burnsideF4gSp_noNormalTwo {K : Type} [Field K] [Finite K] [CharP K 2] :
    ∀ P : Subgroup (antiSp K), P.Normal → IsPGroup 2 P → P = ⊥ := by
  intro P hP hp
  have hSyl : IsSylowTwoOf (antiUnipotent K) ⊤ := card_and_isSylowTwoOf_antiUnipotent.2
  have hN : Subgroup.normalizer (P : Set (antiSp K)) = ⊤ :=
    Subgroup.normalizer_eq_top_iff.mpr hP
  have hPU : P ≤ antiUnipotent K := by
    have h1 : P ≤ pCoreOf 2 (⊤ : Subgroup (antiSp K)) :=
      CFSG.LieType.BorelTits.le_pCoreOf_of_le_normalizer 2 le_top (by rw [hN]) hp
    exact h1.trans (EscapingLocal.pCoreOf_le_of_isSylowTwoOf hSyl)
  have hP1 : P ≤ radA1 K := by
    have h1 := CFSG.LieType.BorelTits.le_pCoreOf_of_le_normalizer 2
      (hPU.trans Fin257.Sp4.U_le_normalizer_radA1) (by rw [hN]; exact le_top) hp
    rwa [Fin257.Sp4.core_radA1] at h1
  have hP2 : P ≤ radA2 K := by
    have h1 := CFSG.LieType.BorelTits.le_pCoreOf_of_le_normalizer 2
      (hPU.trans Fin257.Sp4.U_le_normalizer_radA2) (by rw [hN]; exact le_top) hp
    rwa [Fin257.Sp4.core_radA2] at h1
  refine (Subgroup.eq_bot_iff_forall P).2 fun x hx => ?_
  obtain ⟨b, c, d, rfl⟩ := hP1 hx
  obtain ⟨a', b', c', h⟩ := hP2 hx
  obtain ⟨-, -, -, hd⟩ := uElt_inj h
  subst hd
  have hx1 := hP.conj_mem _ hx (Fin257.Sp4.wT : antiSp K)
  rw [Fin257.Sp4.wT_conj_uElt_zero] at hx1
  obtain ⟨b₁, c₁, d₁, h1⟩ := hP1 hx1
  obtain ⟨hb, -, -, -⟩ := uElt_inj h1
  subst hb
  have hx2 := hP.conj_mem _ hx (Fin257.Sp4.wS : antiSp K)
  rw [Fin257.Sp4.wS_conj_uElt_zero] at hx2
  obtain ⟨a₂, b₂, c₂, h2⟩ := hP2 hx2
  obtain ⟨-, -, -, hc⟩ := uElt_inj h2
  subst hc
  exact uElt_zero_eq_one

theorem burnsideF4gSp_yam_stated {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ}
    (hK : Nat.card K = 2 ^ n) :
    IsYAmalgamPair (projUnipotent 2 K) ((Q2 K 0).map (proj 2 K)) ((Q2 K 1).map (proj 2 K)) := by
  obtain ⟨θ, hθU⟩ := burnsideF4gSp_exists_iso hK
  have hBD := burnsideF4gSp_borelData θ hθU
  have hY0 := CFSG.GH74.QTGen4.DSGen4.L34.isYAmalgamPair_of_borelData hBD
    burnsideF4gSp_noNormalTwo
  have hY1 := IsYAmalgamPair.map θ hY0
  rw [hθU] at hY1
  have hOG := Borel252.Sp4.overgroupData_Sp K
  have hlt : ∀ R : Subgroup (antiSp K),
      Subgroup.normalizer (antiUnipotent K : Set (antiSp K)) <
        Subgroup.normalizer (R : Set (antiSp K)) →
      Subgroup.normalizer (R : Set (antiSp K)) < ⊤ →
      Subgroup.normalizer (projUnipotent 2 K : Set (StatedProj (StatedSp 2 K))) <
        (Subgroup.normalizer (R : Set (antiSp K))).map θ.toMonoidHom ∧
      (Subgroup.normalizer (R : Set (antiSp K))).map θ.toMonoidHom < ⊤ := by
    intro R h1 h2
    refine ⟨?_, ?_⟩
    · rw [← hθU, ← Subgroup.map_equiv_normalizer_eq]
      exact (Subgroup.map_lt_map_iff_of_injective θ.injective).2 h1
    · rw [← Subgroup.map_top_of_surjective θ.toMonoidHom θ.surjective]
      exact (Subgroup.map_lt_map_iff_of_injective θ.injective).2 h2
  obtain ⟨a1, b1⟩ := hlt _ hBD.lt₁ hBD.lt_top₁
  obtain ⟨a2, b2⟩ := hlt _ hBD.lt₂ hBD.lt_top₂
  have e1 := hOG.eq_of_between a1 b1
  have e2 := hOG.eq_of_between a2 b2
  have hne := hY1.2.1
  rcases e1 with e1 | e1 <;> rcases e2 with e2 | e2
  · exact absurd (e1.trans e2.symm) hne
  · rw [e1, e2] at hY1
    exact hY1
  · rw [e1, e2] at hY1
    exact ⟨hY1.1, hY1.2.1.symm, fun M => (hY1.2.2 M).trans or_comm⟩
  · exact absurd (e1.trans e2.symm) hne

end Stated

section Marking

open CFSG.ASVolI.ChF CFSG.ASVolI.ChF.ClassicalRoots CFSG.QuasithinUnique.Setup.X7a
  CFSG.LocalAnalysis.ComponentInitial.SymplecticFlag

theorem burnsideF4gSp_mem_rawStabilizer {index : Type} [Fintype index] [DecidableEq index]
    {K : Type} [Field K] (space : Set (index → K)) (g : GL index K) :
    g ∈ rawStabilizer space ↔
      ∀ vector : index → K, (g : Matrix index index K).mulVec vector ∈ space ↔ vector ∈ space := by
  let S : Subgroup (GL index K) :=
    { carrier := {actor | ∀ vector : index → K,
        (actor : Matrix index index K).mulVec vector ∈ space ↔ vector ∈ space}
      one_mem' := by
        intro vector
        simp
      mul_mem' := by
        intro a b ha hb vector
        have h1 := ha ((b : Matrix index index K).mulVec vector)
        have h2 := hb vector
        rw [Units.val_mul, ← Matrix.mulVec_mulVec]
        exact h1.trans h2
      inv_mem' := by
        intro a ha vector
        have h1 := ha (((a⁻¹ : GL index K) : Matrix index index K).mulVec vector)
        rw [Matrix.mulVec_mulVec, Units.mul_inv, Matrix.one_mulVec] at h1
        exact h1.symm }
  have hS : rawStabilizer space = S := Subgroup.closure_eq S
  rw [hS]
  exact Iff.rfl

theorem burnsideF4gSp_mem_stabilizer_iff {r : ℕ} {K : Type} [Field K]
    (W : Submodule K (Fin r ⊕ Fin r → K)) (g : StatedSp r K) :
    g ∈ stabilizer r K W ↔
      ∀ v : Fin r ⊕ Fin r → K,
        ((g : GL (Fin r ⊕ Fin r) K) : Matrix (Fin r ⊕ Fin r) (Fin r ⊕ Fin r) K).mulVec v ∈ W ↔
          v ∈ W := by
  set A : Matrix (Fin r ⊕ Fin r) (Fin r ⊕ Fin r) K :=
    ((g : GL (Fin r ⊕ Fin r) K) : Matrix (Fin r ⊕ Fin r) (Fin r ⊕ Fin r) K) with hA
  set B : Matrix (Fin r ⊕ Fin r) (Fin r ⊕ Fin r) K :=
    (((g : GL (Fin r ⊕ Fin r) K)⁻¹ : GL (Fin r ⊕ Fin r) K) :
      Matrix (Fin r ⊕ Fin r) (Fin r ⊕ Fin r) K) with hB
  have hBA : B * A = 1 := by rw [hA, hB, ← Units.val_mul, inv_mul_cancel, Units.val_one]
  have hAB : A * B = 1 := by rw [hA, hB, ← Units.val_mul, mul_inv_cancel, Units.val_one]
  rw [mem_stabilizer]
  constructor
  · intro h v
    constructor
    · intro hv
      rw [← h] at hv
      obtain ⟨w, hw, hwv⟩ := hv
      have h2 : A.mulVec w = A.mulVec v := hwv
      have : w = v := by
        calc w = B.mulVec (A.mulVec w) := by rw [Matrix.mulVec_mulVec, hBA, Matrix.one_mulVec]
          _ = B.mulVec (A.mulVec v) := by rw [h2]
          _ = v := by rw [Matrix.mulVec_mulVec, hBA, Matrix.one_mulVec]
      rw [this] at hw
      exact hw
    · intro hv
      rw [← h]
      exact ⟨v, hv, rfl⟩
  · intro h
    ext x
    constructor
    · rintro ⟨w, hw, rfl⟩
      exact (h w).2 hw
    · intro hx
      have hv : B.mulVec x ∈ W := by
        refine (h _).1 ?_
        rw [Matrix.mulVec_mulVec, hAB, Matrix.one_mulVec]
        exact hx
      refine ⟨_, hv, ?_⟩
      show A.mulVec (B.mulVec x) = x
      rw [Matrix.mulVec_mulVec, hAB, Matrix.one_mulVec]

theorem burnsideF4gSp_coordinateSpace_flag {K : Type} [Field K] (v : Fin 2 ⊕ Fin 2 → K) :
    (v ∈ coordinateSpace ({Sum.inl 0} : Set (Fin 2 ⊕ Fin 2)) ↔ v ∈ flag 2 K 1) ∧
      (v ∈ coordinateSpace ({Sum.inl 0, Sum.inl 1} : Set (Fin 2 ⊕ Fin 2)) ↔
        v ∈ flag 2 K 2) := by
  rw [mem_flag_of_le (by norm_num), mem_flag_of_le (by norm_num), mem_isoFlag, mem_isoFlag]
  simp only [coordinateSpace, Set.mem_setOf_eq]
  constructor
  · constructor
    · intro h
      refine ⟨fun j => h (Sum.inr j) (by simp), fun j hj => h (Sum.inl j) ?_⟩
      fin_cases j <;> simp_all
    · rintro ⟨h1, h2⟩ pos hpos
      rcases pos with j | j
      · apply h2 j
        fin_cases j <;> simp_all
      · exact h1 j
  · constructor
    · intro h
      refine ⟨fun j => h (Sum.inr j) (by simp), fun j hj => ?_⟩
      exact absurd hj (by have := j.isLt; omega)
    · rintro ⟨h1, -⟩ pos hpos
      rcases pos with j | j
      · exfalso
        apply hpos
        fin_cases j <;> simp
      · exact h1 j

theorem burnsideF4gSp_image_one {index : Type} [Fintype index] [DecidableEq index] {K : Type}
    [Field K] (S : Set (index → K)) :
    (fun vector => ((1 : GL index K) : Matrix index index K).mulVec vector) '' S = S := by
  simp

theorem burnsideF4gSp_charP_of_card {K : Type} [Field K] [Finite K] {f : ℕ}
    (hK : Nat.card K = 2 ^ f) : CharP K 2 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have := Fintype.ofFinite K
  exact charP_of_card_eq_prime_pow (p := 2) (f := f)
    (by rw [← Nat.card_eq_fintype_card]; exact hK)

theorem burnsideF4gSp_yam_of_marking_ge {f : ℕ} {H : Type} [Group H]
    (marking : ClassicalRoots.Marking .Sp4 2 f H) :
    ∃ TD : Subgroup H, CFSG.Quasithin.IsYAmalgamPair TD (marking.parabolic false)
      (marking.parabolic true) := by
  have hK : Nat.card marking.field = 2 ^ f := by
    have := marking.field_card
    simpa using this
  haveI : CharP marking.field 2 := burnsideF4gSp_charP_of_card hK
  have hbasis : marking.basis = 1 := marking.basis_compatible
  have hY := burnsideF4gSp_yam_stated hK
  have keyS : ∀ (S : Set (Fin 2 ⊕ Fin 2))
      (W : Submodule marking.field (Fin 2 ⊕ Fin 2 → marking.field))
      (A : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) marking.field),
      (∀ v, v ∈ coordinateSpace S ↔ v ∈ W) →
      ((∀ v : Fin 2 ⊕ Fin 2 → marking.field, A.mulVec v ∈ coordinateSpace S ↔
          v ∈ coordinateSpace S) ↔
        ∀ v : Fin 2 ⊕ Fin 2 → marking.field, A.mulVec v ∈ W ↔ v ∈ W) := by
    intro S W A hS
    simp only [hS]
  have key : ∀ b : Bool, nativeParabolic .Sp4 (2 ^ f) marking.field marking.basis b =
      Q2 marking.field (if b then 1 else 0) := by
    intro b
    rw [hbasis]
    ext g
    have h1 : g ∈ nativeParabolic .Sp4 (2 ^ f) marking.field 1 b ↔
        (g : GL (Coord .Sp4) marking.field) ∈ rawStabilizer ((fun vector =>
            ((1 : GL (Coord .Sp4) marking.field) : Matrix (Coord .Sp4) (Coord .Sp4)
              marking.field).mulVec vector) ''
          coordinateSpace (if b then flagTwo .Sp4 else flagOne .Sp4 : Set (Coord .Sp4))) :=
      Iff.rfl
    rw [h1, burnsideF4gSp_mem_rawStabilizer, burnsideF4gSp_image_one, Q2]
    refine Iff.trans ?_
      (burnsideF4gSp_mem_stabilizer_iff (r := 2) (K := marking.field) _ g).symm
    cases b
    · exact keyS _ _ _ (fun v => (burnsideF4gSp_coordinateSpace_flag v).1)
    · exact keyS _ _ _ (fun v => (burnsideF4gSp_coordinateSpace_flag v).2)
  have hpar : ∀ b : Bool, marking.parabolic b =
      ((Q2 marking.field (if b then 1 else 0)).map (proj 2 marking.field)).map
        marking.identification.toMonoidHom := by
    intro b
    have e1 : marking.parabolic b =
        (Q2 marking.field (if b then 1 else 0)).map marking.transport :=
      congrArg (Subgroup.map marking.transport) (key b)
    refine e1.trans ?_
    exact (Subgroup.map_map _ _ _).symm
  refine ⟨(projUnipotent 2 marking.field).map marking.identification.toMonoidHom, ?_⟩
  have h0 := hpar false
  have h1 := hpar true
  simp only [Bool.false_eq_true, if_false, if_true] at h0 h1
  rw [h0, h1]
  exact CFSG.Quasithin.IsYAmalgamPair.map marking.identification hY

theorem burnsideF4gSp_yam_of_marking {f : ℕ} (hf : 2 ≤ f) {H : Type} [Group H]
    (marking : CFSG.ASVolI.ChF.ClassicalRoots.Marking .Sp4 2 f H) :
    ∃ TD : Subgroup H, CFSG.Quasithin.IsYAmalgamPair TD (marking.parabolic false)
      (marking.parabolic true) := by
  exact burnsideF4gSp_yam_of_marking_ge marking

