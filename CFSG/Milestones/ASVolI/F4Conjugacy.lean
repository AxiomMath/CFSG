section Borel

open CFSG.Quasithin.H13.F431.Un CFSG.LieType.Steinberg CFSG.LieType.Universal.Unitary.SUExtras
  CFSG.LieType.RootSystem

variable {F : Type} [Field F] [Finite F] {f : ℕ} [CharP F 2] (hF : Nat.card F = (2 ^ f) ^ 2)

theorem burnsideF4gU5_unB_le_UT :
    unB hF 5 ≤ burnsideF4gU5_UT (unitaryInvolution F 2 f) := by
  have hσ := unitaryInvolution_involutive hF
  refine sup_le ?_ ?_
  · refine iSup_le fun i => ?_
    intro A hA
    obtain ⟨t, ht⟩ := levelTorus_le_diagSubgroup i hA
    show ((A : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F).BlockTriangular id
    rw [ht]
    exact Matrix.blockTriangular_diagonal t
  · intro A hA
    have h := idBelow_of_mem_iSup hσ 1
      {γ | γ ∈ roots (isFiniteType_cartan 5) (divisible 5) ∧ 0 < ht γ}
      (fun γ hγ => by have := hγ.2; omega) hA
    show ((A : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F).BlockTriangular id
    intro a b hab
    have hab' : lvl 1 b - lvl 1 a < 1 := by
      simp only [lvl, one_mul]
      have : (b : ℕ) < a := hab
      omega
    have := h a b hab'
    rw [mat_apply] at this
    rw [this]
    exact Matrix.one_apply_ne (Fin.ne_of_gt hab)

