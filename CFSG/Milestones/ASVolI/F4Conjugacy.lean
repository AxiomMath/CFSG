      simp
    · right
      apply Subtype.ext
      rw [hs, burnsideF4gF4TwoInv_coe_tg hK]
      exact weyl_conj_sylowA_one (m := a) (K := K)
  · rintro (rfl | rfl)
    · rw [Subgroup.coe_one]
      exact one_mem _
    · rw [burnsideF4gF4TwoInv_coe_tg hK]
      exact burnsideF4gF4TwoInv_sylowL_mem_reeShortRoot hK

theorem burnsideF4gF4TwoInv_reeLocalParabolic_zero :
    F4.reeLocalParabolic K a ⟨0, by decide⟩ =
