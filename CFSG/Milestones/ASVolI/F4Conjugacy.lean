theorem burnsideF4gSpInv_anti_inv_cases (x : antiSp K) (hx1 : x ≠ 1) (hx2 : x * x = 1) :
    ∃ k : Fin 3, IsConj x (iRep K k) := by
  have hSyl : IsSylowTwoOf (antiUnipotent K) ⊤ := card_and_isSylowTwoOf_antiUnipotent.2
  have hx2' : x ^ 2 = 1 := by rwa [sq]
  have hp : IsPGroup 2 (Subgroup.zpowers x) := by
    refine IsPGroup.of_card (n := 1) ?_
    rw [Nat.card_zpowers, orderOf_eq_prime hx2' hx1]
    norm_num
  obtain ⟨m, -, hm⟩ := EscapingLocal.exists_conj_mem_of_isPGroup (M := ⊤)
    (T := antiUnipotent K) (S := Subgroup.zpowers x) le_top hSyl.2.1 hSyl.2.2 le_top hp
  have hy := hm x (Subgroup.mem_zpowers x)
  have hconj : IsConj x (m * x * m⁻¹) := isConj_iff.2 ⟨m, rfl⟩
  have hy1 : m * x * m⁻¹ ≠ 1 := by
    intro h
    apply hx1
    have := congrArg (fun z => m⁻¹ * z * m) h
    simpa [mul_assoc] using this
  have hy2 : (m * x * m⁻¹) * (m * x * m⁻¹) = 1 := by
    calc (m * x * m⁻¹) * (m * x * m⁻¹) = m * (x * x) * m⁻¹ := by group
      _ = 1 := by rw [hx2]; group
  obtain ⟨a, b, c, d, hy'⟩ := hy
  rw [hy'] at hy1 hy2 hconj
  rw [uElt_mul_self, ← uElt_zero_eq_one] at hy2
  have had : a * d = 0 := (uElt_inj hy2).2.1
  rcases mul_eq_zero.mp had with ha | hd
  · subst ha
    obtain ⟨k, m', -, hm'⟩ := Quasithin.H13.F431.SpModel.fus_radA1
      (⟨b, c, d, rfl⟩ : (uElt (0 : K) b c d : antiSp K) ∈ radA1 K) hy1
    exact ⟨k, hconj.trans (isConj_iff.2 ⟨m', hm'⟩)⟩
  · subst hd
    obtain ⟨k, m', -, hm'⟩ := Quasithin.H13.F431.SpModel.fus_radA2
      (⟨a, b, c, rfl⟩ : (uElt a b c (0 : K) : antiSp K) ∈ radA2 K) hy1
    exact ⟨k, hconj.trans (isConj_iff.2 ⟨m', hm'⟩)⟩

