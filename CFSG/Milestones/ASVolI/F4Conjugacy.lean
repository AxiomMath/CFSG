theorem burnsideF4gSpOne_incl_graph_iso {E : Type} [Group E] [Finite E] {Gp M₁ M₂ : Subgroup E}
    (hgen : M₁ ⊔ M₂ = ⊤) (hN : Gp.Normal)
    (hsplit : ∀ e : E, ∃ n ∈ Gp, ∃ h ∈ M₁ ⊓ M₂, e = n * h)
    {X : Type} [Group X] (Ψ : X →* E) (hΨ : Function.Injective Ψ) (hrange : Ψ.range = Gp)
    {V : Type} [MulAction X V] (Γ : SimpleGraph V) [GraphAction X Γ] (v₁ v₂ : V)
    (hs1 : ∀ y : X, Ψ y ∈ M₁ ↔ y • v₁ = v₁) (hs2 : ∀ y : X, Ψ y ∈ M₂ ↔ y • v₂ = v₂)
    (disj : ∀ y z : X, y • v₁ ≠ z • v₂)
    (noadj1 : ∀ y z : X, ¬ Γ.Adj (y • v₁) (z • v₁))
    (noadj2 : ∀ y z : X, ¬ Γ.Adj (y • v₂) (z • v₂)) (adj12 : Γ.Adj v₁ v₂)
    (hcov : ∀ a : V, ∃ y : X, y • v₁ = a ∨ y • v₂ = a)
    (hflag : ∀ a, Γ.Adj v₁ a → ∃ y : X, y • v₁ = v₁ ∧ y • v₂ = a) :
    Nonempty ((incl M₁ M₂).graph ≃g Γ) := by
  classical
  let c := incl M₁ M₂
  let τ : c.G0 →* E := (M₁ ⊔ M₂).subtype.comp (c.φ1.range ⊔ c.φ2.range).subtype
  have τinj : Function.Injective τ := fun a b h => Subtype.ext (Subtype.ext h)
  have τsurj : Function.Surjective τ := fun e =>
    ⟨⟨⟨e, by rw [hgen]; exact Subgroup.mem_top e⟩, by rw [c.gen]; exact Subgroup.mem_top _⟩, rfl⟩
  let τe : c.G0 ≃* E := MulEquiv.ofBijective τ ⟨τinj, τsurj⟩
  let S : LieSetting.{0, 0} :=
    { α := RankTwoAmalgam.ofSubgroups M₁ M₂
      Yb := ↥(M₁ ⊔ M₂)
      ι := c
      hι := incl_faithful M₁ M₂
      N := Gp.comap τ
      hN := hN.comap τ
      p := 2
      hp := Nat.prime_two
      m := 4
      hm := by norm_num }
  let Φ : X →* S.ι.G0 := τe.symm.toMonoidHom.comp Ψ
  have hτΦ : ∀ y : X, τ (Φ y) = Ψ y := fun y => τe.apply_symm_apply (Ψ y)
  have hφ1 : ∀ k : c.G0, ((k : ↥(M₁ ⊔ M₂)) ∈ c.φ1.range ↔ τ k ∈ M₁) := by
    intro k
    constructor
    · rintro ⟨a, ha⟩
      have := congrArg Subtype.val ha
      show ((k : ↥(M₁ ⊔ M₂)) : E) ∈ M₁
      rw [← this]
      exact a.2
    · intro h
      exact ⟨⟨τ k, h⟩, Subtype.ext rfl⟩
  have hφ2 : ∀ k : c.G0, ((k : ↥(M₁ ⊔ M₂)) ∈ c.φ2.range ↔ τ k ∈ M₂) := by
    intro k
    constructor
    · rintro ⟨a, ha⟩
      have := congrArg Subtype.val ha
      show ((k : ↥(M₁ ⊔ M₂)) : E) ∈ M₂
      rw [← this]
      exact a.2
    · intro h
      exact ⟨⟨τ k, h⟩, Subtype.ext rfl⟩
  have D : XDatum S Φ Γ v₁ v₂ :=
    { inj := fun a b h => hΨ ((hτΦ a).symm.trans ((congrArg τ h).trans (hτΦ b)))
      N_eq := by
        ext z
        rw [Subgroup.mem_comap, MonoidHom.mem_range]
        constructor
        · intro hz
          rw [← hrange] at hz
          obtain ⟨y, hy⟩ := hz
          exact ⟨y, τinj ((hτΦ y).trans hy)⟩
        · rintro ⟨y, rfl⟩
          rw [hτΦ, ← hrange]
          exact ⟨y, rfl⟩
      dec := by
        intro g
        obtain ⟨n, hn, h, hh, hnh⟩ := hsplit (τ g)
        rw [← hrange] at hn
        obtain ⟨y, rfl⟩ := hn
        refine ⟨y, τe.symm h, ?_, ?_, ?_⟩
        · refine (smul_xv_iff c _).mpr ((hφ1 _).mpr ?_)
          have : τ (τe.symm h) = h := τe.apply_symm_apply h
          rw [this]
          exact hh.1
        · refine (smul_lv_iff c _).mpr ((hφ2 _).mpr ?_)
          have : τ (τe.symm h) = h := τe.apply_symm_apply h
          rw [this]
          exact hh.2
        · apply τinj
          rw [map_mul, hτΦ]
          have : τ (τe.symm h) = h := τe.apply_symm_apply h
          rw [this]
          exact hnh
      stab1 := fun y => (smul_xv_iff c (Φ y)).trans
        ((hφ1 (Φ y)).trans (by rw [hτΦ]; exact hs1 y))
      stab2 := fun y => (smul_lv_iff c (Φ y)).trans
        ((hφ2 (Φ y)).trans (by rw [hτΦ]; exact hs2 y))
      disj := disj
      noadj1 := noadj1
      noadj2 := noadj2
      adj12 := adj12 }
  obtain ⟨e, -, -, -, hadj⟩ := D.exists_equiv hcov hflag
  exact ⟨⟨e, fun {a b} => (hadj a b).symm⟩⟩

end Transfer

