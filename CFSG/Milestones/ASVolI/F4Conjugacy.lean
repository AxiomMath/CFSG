    have hab' : a⁻¹ * b ∈ pgen D.B D.N D.w₁ D.w₂ i := QuotientGroup.leftRel_apply.1 hab
    exact (vt_eq_vt_iff i b⁻¹ a⁻¹).2 (by simpa using hab'))

theorem burnsideF4gG2Two_vtxMap_mk (i : Bool) (g : X) :
    burnsideF4gG2Two_vtxMap D i (g : X ⧸ pgen D.B D.N D.w₁ D.w₂ i) = vt D i g⁻¹ := rfl

theorem burnsideF4gG2Two_vtxMap_injective (i : Bool) :
    Function.Injective (burnsideF4gG2Two_vtxMap D i) := by
