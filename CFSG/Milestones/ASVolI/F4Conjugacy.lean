@[expose] def burnsideF4gU4Inv_chiKer : Subgroup (hypSU h 2 0) where
  carrier := {g | g ∈ parP h ∧ chi h g = 1}
  mul_mem' {a b} ha hb := ⟨(parP h).mul_mem ha.1 hb.1, by rw [chi_mul h hb.1, ha.2, hb.2, one_mul]⟩
  one_mem' := ⟨(parP h).one_mem, chi_one h⟩
