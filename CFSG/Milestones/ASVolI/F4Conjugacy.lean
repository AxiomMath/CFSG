      ψ (un5Proj (F := F) (f := f) A) = θ A := fun A => rfl
  have hmap : ∀ S : Subgroup (SU (unitaryInvolution F 2 f) 5),
      (S.map (un5Proj (F := F) (f := f))).map ψ.toMonoidHom = S.map θ := by
    intro S
