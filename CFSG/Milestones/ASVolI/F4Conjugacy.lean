      CFSG.Quasithin.F6.g22_R1_lt_chk (fun _ => Iff.rfl) CFSG.Quasithin.F6.g22_R1_norm_chk)
    ((lat h2 hk2).sylow.1.to_le (CFSG.Quasithin.F6.G22Shape.R1_le_S h2 hk2))
