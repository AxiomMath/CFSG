  simp only [Matrix.mul_apply, Matrix.single_apply]
  rw [Finset.sum_eq_single a]
  · by_cases hj : j = b
    · subst hj
      simp
    · have : ¬ b = j := fun h => hj h.symm
      simp [hj, this]
  · intro k _ hk
    have : ¬ a = k := fun h => hk h.symm
    simp [this]
  · simp

theorem burnsideF4gU5Inv_single_mul_apply (G : Matrix (Fin 5) (Fin 5) F) (a b : Fin 5) (c : F)
    (i j : Fin 5) : (Matrix.single a b c * G) i j = (if i = a then c else 0) * G b j := by
  simp only [Matrix.mul_apply, Matrix.single_apply]
  rw [Finset.sum_eq_single b]
  · by_cases hi : i = a
    · subst hi
