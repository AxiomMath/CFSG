section U4Transport

open Matrix CFSG.ClassicalGroups.UnitaryFlag CFSG.LocalAnalysis.ComponentInitial

variable {K : Type} [Field K] {f : ℕ}

@[expose] noncomputable def burnsideF4gU4_R (B : Matrix (Fin 4) (Fin 4) K) :
    Matrix (Fin (2 * 2 + 0)) (HypIndex 2 0) K :=
  B.submatrix id burnsideF4gU4_equiv

theorem burnsideF4gU4_R_mulVec (B : Matrix (Fin 4) (Fin 4) K) (w : HypIndex 2 0 → K) :
    burnsideF4gU4_R B *ᵥ w = B *ᵥ (w ∘ burnsideF4gU4_equiv.symm) :=
  submatrix_mulVec_equiv B w id burnsideF4gU4_equiv

theorem burnsideF4gU4_isHypTransport (h : UnitaryFieldData 2 f K) (B : Matrix (Fin 4) (Fin 4) K)
    (hB : ∀ i j : Fin 4, ((B.map h.bar)ᵀ * B) i j = if i.val + j.val + 1 = 4 then 1 else 0) :
    IsHypTransport h (burnsideF4gU4_R B) := by
  ext a b
  have h1 : (((burnsideF4gU4_R B).map h.bar)ᵀ * burnsideF4gU4_R B) a b =
      ((B.map h.bar)ᵀ * B) (burnsideF4gU4_equiv a) (burnsideF4gU4_equiv b) := by
    simp [Matrix.mul_apply, burnsideF4gU4_R]
  show (((burnsideF4gU4_R B).map h.bar)ᵀ * burnsideF4gU4_R B) a b = hypGram 2 0 K a b
  rw [h1, hB, hypGram_apply, burnsideF4gU4_equiv_val, burnsideF4gU4_equiv_val]
  rcases a with i | k | i <;> rcases b with j | l | j
  all_goals first | exact k.elim0 | exact l.elim0 | skip
  all_goals fin_cases i <;> fin_cases j <;> simp [fullPos]

end U4Transport

section U4Stab

open Matrix CFSG.ClassicalGroups.UnitaryFlag CFSG.LocalAnalysis.ComponentInitial
open scoped Pointwise

variable {K : Type} [Field K] {f : ℕ} (h : UnitaryFieldData 2 f K)

theorem burnsideF4gU4_smul_eq_iff {ι : Type} [Fintype ι] [DecidableEq ι] (g : GL ι K)
    (W : Submodule K (ι → K)) :
    g • W = W ↔ ∀ v, (g : Matrix ι ι K) *ᵥ v ∈ W ↔ v ∈ W := by
  constructor
  · intro hgW v
    constructor
    · intro hgv
      rw [← hgW] at hgv
      obtain ⟨b, hb, hbv⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ W).mp hgv
      have : b = v := by
        have h1 : (g : Matrix ι ι K) *ᵥ b = (g : Matrix ι ι K) *ᵥ v := hbv
        have h2 := congrArg (fun x => ((g⁻¹ : GL ι K) : Matrix ι ι K) *ᵥ x) h1
        simpa only [mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one,
          one_mulVec] using h2
      rw [← this]
      exact hb
    · intro hv
      have : g • v ∈ g • W := Submodule.smul_mem_pointwise_smul v g W hv
      rw [hgW] at this
      exact this
  · intro H
    refine smul_eq_of_mulVec_mem (fun v hv => (H v).2 hv) (fun v hv => ?_)
    refine (H _).1 ?_
    rw [mulVec_mulVec, ← Units.val_mul, mul_inv_cancel, Units.val_one, one_mulVec]
    exact hv

variable {R : Matrix (Fin (2 * 2 + 0)) (HypIndex 2 0) K}

theorem burnsideF4gU4_mem_image_iff (hR : IsHypTransport h R) (W : Set (HypIndex 2 0 → K))
    (v : Fin (2 * 2 + 0) → K) :
    v ∈ (fun w => R *ᵥ w) '' W ↔ transportInv h R *ᵥ v ∈ W := by
  constructor
  · rintro ⟨w, hw, rfl⟩
    rw [mulVec_mulVec, transportInv_mul hR, one_mulVec]
    exact hw
  · intro hv
    exact ⟨_, hv, by
      show R *ᵥ (transportInv h R *ᵥ v) = v
      rw [mulVec_mulVec, mul_transportInv hR, one_mulVec]⟩

theorem burnsideF4gU4_transportInv_mulVec (hR : IsHypTransport h R) (g : hypSU h 2 0)
    (v : Fin (2 * 2 + 0) → K) :
    transportInv h R *ᵥ (((hypTransport h hR g : GL (Fin (2 * 2 + 0)) K) :
        Matrix (Fin (2 * 2 + 0)) (Fin (2 * 2 + 0)) K) *ᵥ v) =
      ((g : GL (HypIndex 2 0) K) : Matrix (HypIndex 2 0) (HypIndex 2 0) K) *ᵥ
        (transportInv h R *ᵥ v) := by
  rw [coe_hypTransport, mulVec_mulVec, mulVec_mulVec]
  congr 1
  rw [show transportInv h R * (R * ((g : GL (HypIndex 2 0) K) :
      Matrix (HypIndex 2 0) (HypIndex 2 0) K) * transportInv h R) =
    (transportInv h R * R) * ((g : GL (HypIndex 2 0) K) :
      Matrix (HypIndex 2 0) (HypIndex 2 0) K) * transportInv h R by
    simp only [Matrix.mul_assoc], transportInv_mul hR, Matrix.one_mul]

theorem burnsideF4gU4_stab_iff (hR : IsHypTransport h R) (W : Set (HypIndex 2 0 → K))
    (g : hypSU h 2 0) :
    (∀ v, ((hypTransport h hR g : GL (Fin (2 * 2 + 0)) K) :
        Matrix (Fin (2 * 2 + 0)) (Fin (2 * 2 + 0)) K) *ᵥ v ∈ (fun w => R *ᵥ w) '' W ↔
          v ∈ (fun w => R *ᵥ w) '' W) ↔
      ∀ w, ((g : GL (HypIndex 2 0) K) : Matrix (HypIndex 2 0) (HypIndex 2 0) K) *ᵥ w ∈ W ↔
        w ∈ W := by
  simp only [burnsideF4gU4_mem_image_iff h hR, burnsideF4gU4_transportInv_mulVec h hR]
  constructor
  · intro H w
    have e : transportInv h R *ᵥ (R *ᵥ w) = w := by
      rw [mulVec_mulVec, transportInv_mul hR, one_mulVec]
    have := H (R *ᵥ w)
    rwa [e] at this
  · intro H v
    exact H _

theorem burnsideF4gU4_image_posFlag (B : Matrix (Fin 4) (Fin 4) K) (i : ℕ) (S : Set (Fin 4))
    (hS : ∀ j : Fin 4, j ∉ S ↔ i ≤ (j : ℕ)) (v : Fin 4 → K) :
    v ∈ (fun w => burnsideF4gU4_R B *ᵥ w) ''
        ((posFlag 2 0 K i : Submodule K (HypIndex 2 0 → K)) : Set (HypIndex 2 0 → K)) ↔
      v ∈ (fun u => B *ᵥ u) '' {u : Fin 4 → K | ∀ j, j ∉ S → u j = 0} := by
  constructor
  · rintro ⟨w, hw, rfl⟩
    refine ⟨w ∘ burnsideF4gU4_equiv.symm, fun j hj => ?_,
      (burnsideF4gU4_R_mulVec B w).symm⟩
    exact hw (burnsideF4gU4_equiv.symm j) (by rw [burnsideF4gU4_fullPos_symm]; exact (hS j).1 hj)
  · rintro ⟨u, hu, rfl⟩
    refine ⟨u ∘ burnsideF4gU4_equiv, fun a ha => ?_, ?_⟩
    · exact hu _ ((hS _).2 ha)
    · show burnsideF4gU4_R B *ᵥ (u ∘ burnsideF4gU4_equiv) = B *ᵥ u
      rw [burnsideF4gU4_R_mulVec]
      congr 1
      ext j
      simp

theorem burnsideF4gU4_mem_isoStabilizer_iff (B : Matrix (Fin 4) (Fin 4) K)
    (hR : IsHypTransport h (burnsideF4gU4_R B)) (i : ℕ) (hi : i ≤ 4) (S : Set (Fin 4))
    (hS : ∀ j : Fin 4, j ∉ S ↔ i ≤ (j : ℕ)) (g : hypSU h 2 0) :
    g ∈ UnitaryHigher.isoStabilizer h 2 0 (hypFlag h 2 0 i) ↔
      ∀ v : Fin 4 → K, ((hypTransport h hR g : GL (Fin (2 * 2 + 0)) K) :
          Matrix (Fin (2 * 2 + 0)) (Fin (2 * 2 + 0)) K) *ᵥ v ∈
            (fun u => B *ᵥ u) '' {u : Fin 4 → K | ∀ j, j ∉ S → u j = 0} ↔
          v ∈ (fun u => B *ᵥ u) '' {u : Fin 4 → K | ∀ j, j ∉ S → u j = 0} := by
  rw [UnitaryHigher.mem_isoStabilizer, hypFlag_eq_posFlag h (by norm_num) (by omega),
    Subgroup.smul_def, burnsideF4gU4_smul_eq_iff]
  have := burnsideF4gU4_stab_iff h hR
    ((posFlag 2 0 K i : Submodule K (HypIndex 2 0 → K)) : Set (HypIndex 2 0 → K)) g
  simp only [burnsideF4gU4_image_posFlag B i S hS, SetLike.mem_coe] at this
  exact this.symm

end U4Stab

section U4Marking

open Matrix CFSG.ClassicalGroups.UnitaryFlag CFSG.LocalAnalysis.ComponentInitial
