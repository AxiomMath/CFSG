variable {F : Type} [Field F] [Finite F] {f : ℕ} [CharP F 2] (hF : Nat.card F = (2 ^ f) ^ 2)

theorem burnsideF4gU5_eq_of_map_eq {X Y : Type} [Group X] [Group Y] (π : X →* Y)
    {S T : Subgroup X} (hS : π.ker ≤ S) (hT : π.ker ≤ T) (h : S.map π = T.map π) : S = T := by
  have h1 := congrArg (Subgroup.comap π) h
  rw [Subgroup.comap_map_eq, Subgroup.comap_map_eq, sup_eq_left.mpr hS, sup_eq_left.mpr hT] at h1
  exact h1

include hF in
theorem burnsideF4gU5_map_eq_P (ζ : traceZero (unitaryInvolution F 2 f))
    [hζ : Fact ((ζ : F) ≠ 0)] {S : Subgroup (SU (unitaryInvolution F 2 f) 5)}
    (hBS : unB hF 5 ≤ S) (hne : S ≠ unB hF 5) (hne' : S ≠ ⊤) :
    ∃ i : Bool, S.map (un5Proj (F := F) (f := f)) = P (un5System hF ζ) i := by
  have hker : (un5Proj (F := F) (f := f)).ker ≤ unB hF 5 := by
    rw [ker_un5Proj]
    exact (un5_center_le_unT hF).trans le_sup_left
  have hDB : (un5System hF ζ).B = (unB hF 5).map (un5Proj (F := F) (f := f)) := rfl
  have hBA : (un5System hF ζ).B ≤ S.map (un5Proj (F := F) (f := f)) := by
    rw [hDB]
    exact Subgroup.map_mono hBS
  rcases eq_B_or_P_or_top (un5System hF ζ) hBA with h | ⟨i, h⟩ | h
  · exfalso
    rw [hDB] at h
    exact hne (burnsideF4gU5_eq_of_map_eq _ (hker.trans hBS) hker h)
  · exact ⟨i, h⟩
  · exfalso
    have htop : (⊤ : Subgroup (SU (unitaryInvolution F 2 f) 5)).map
        (un5Proj (F := F) (f := f)) = ⊤ := by
      rw [Subgroup.map_top, MonoidHom.range_eq_top]
      exact un5Proj_surjective
    exact hne' (burnsideF4gU5_eq_of_map_eq _ (hker.trans hBS) le_top (h.trans htop.symm))

include hF in
theorem burnsideF4gU5_yam_core :
    ∃ TD : Subgroup (SU (unitaryInvolution F 2 f) 5 ⧸
        Subgroup.center (SU (unitaryInvolution F 2 f) 5)),
      CFSG.Quasithin.IsYAmalgamPair TD
        ((burnsideF4gU5_stab (unitaryInvolution F 2 f) 1).map (un5Proj (F := F) (f := f)))
        ((burnsideF4gU5_stab (unitaryInvolution F 2 f) 2).map (un5Proj (F := F) (f := f))) := by
  obtain ⟨ζ, hζ⟩ := exists_traceZero_ne_zero hF
  haveI : Fact ((ζ : F) ≠ 0) := ⟨hζ⟩
  haveI := isSimpleGroup_un5 hF
  have hU := isSylowTwoOf_un5System hF ζ
  have hY := CFSG.Quasithin.H13.F431.BN.isYAmalgamPair (un5System hF ζ) hU
  have hσ : ∀ c, unitaryInvolution F 2 f (unitaryInvolution F 2 f c) = c :=
    unitaryInvolution_involutive hF
  have h1 : (1 : F) + unitaryInvolution F 2 f 1 = 0 := by
    rw [map_one, one_add_one_eq_two]
    exact CharTwo.two_eq_zero
  have hUB := burnsideF4gU5_unB_le_UT hF
  have hB1 : unB hF 5 ≤ burnsideF4gU5_stab (unitaryInvolution F 2 f) 1 :=
