section CosetGraph

open CFSG.Quasithin

@[expose] def burnsideF4gG2Two_cgRel {G : Type*} [Group G] (G₁ G₂ : Subgroup G) :
    (G ⧸ G₁) ⊕ (G ⧸ G₂) → (G ⧸ G₁) ⊕ (G ⧸ G₂) → Prop
  | Sum.inl x, Sum.inr y => ∃ g : G, (g : G ⧸ G₁) = x ∧ (g : G ⧸ G₂) = y
  | Sum.inr y, Sum.inl x => ∃ g : G, (g : G ⧸ G₁) = x ∧ (g : G ⧸ G₂) = y
  | _, _ => False

@[expose] def burnsideF4gG2Two_cg {G : Type*} [Group G] (G₁ G₂ : Subgroup G) :
    SimpleGraph ((G ⧸ G₁) ⊕ (G ⧸ G₂)) where
  Adj := burnsideF4gG2Two_cgRel G₁ G₂
  symm := ⟨by
    intro a b h
    cases a <;> cases b <;> exact h⟩
  loopless := ⟨by
    intro a h
    cases a <;> exact h⟩

theorem burnsideF4gG2Two_cg_adj {G : Type*} [Group G] {G₁ G₂ : Subgroup G} {x : G ⧸ G₁}
    {y : G ⧸ G₂} :
    (burnsideF4gG2Two_cg G₁ G₂).Adj (Sum.inl x) (Sum.inr y) ↔
      ∃ g : G, (g : G ⧸ G₁) = x ∧ (g : G ⧸ G₂) = y := Iff.rfl

theorem burnsideF4gG2Two_cg_adj' {G : Type*} [Group G] {G₁ G₂ : Subgroup G} {x : G ⧸ G₁}
    {y : G ⧸ G₂} :
    (burnsideF4gG2Two_cg G₁ G₂).Adj (Sum.inr y) (Sum.inl x) ↔
      ∃ g : G, (g : G ⧸ G₁) = x ∧ (g : G ⧸ G₂) = y := Iff.rfl

theorem burnsideF4gG2Two_cg_not_adj_inl {G : Type*} [Group G] {G₁ G₂ : Subgroup G}
    {x x' : G ⧸ G₁} : ¬ (burnsideF4gG2Two_cg G₁ G₂).Adj (Sum.inl x) (Sum.inl x') := fun h => h

theorem burnsideF4gG2Two_cg_not_adj_inr {G : Type*} [Group G] {G₁ G₂ : Subgroup G}
    {y y' : G ⧸ G₂} : ¬ (burnsideF4gG2Two_cg G₁ G₂).Adj (Sum.inr y) (Sum.inr y') := fun h => h

theorem burnsideF4gG2Two_exists_quotEquiv {S Q : Type*} [Group S] [Group Q] (ι : S →* Q)
    {S₁ : Subgroup S} {Q₁ : Subgroup Q} (h : S₁ = Q₁.comap ι)
    (hcov : ∀ q : Q, ∃ s : S, (ι s)⁻¹ * q ∈ Q₁) :
    ∃ e : S ⧸ S₁ ≃ Q ⧸ Q₁, ∀ s : S, e (s : S ⧸ S₁) = ((ι s : Q) : Q ⧸ Q₁) := by
  subst h
  have hm : ∀ a b : S, a⁻¹ * b ∈ Q₁.comap ι ↔ (ι a)⁻¹ * ι b ∈ Q₁ := fun a b => by
    rw [Subgroup.mem_comap, map_mul, map_inv]
  refine ⟨Equiv.ofBijective (Quotient.map' ι (fun a b hab => ?_)) ⟨?_, ?_⟩, fun s => rfl⟩
  · rw [QuotientGroup.leftRel_apply] at hab ⊢
    exact (hm a b).1 hab
  · intro x y
    induction x using QuotientGroup.induction_on with
    | H a =>
      induction y using QuotientGroup.induction_on with
      | H b =>
        intro hab
        have hab' : ((ι a : Q) : Q ⧸ Q₁) = ((ι b : Q) : Q ⧸ Q₁) := hab
        rw [QuotientGroup.eq] at hab'
        exact QuotientGroup.eq.2 ((hm a b).2 hab')
  · intro y
    induction y using QuotientGroup.induction_on with
    | H q =>
      obtain ⟨s, hs⟩ := hcov q
      refine ⟨(s : S ⧸ Q₁.comap ι), ?_⟩
      exact QuotientGroup.eq.2 hs

theorem burnsideF4gG2Two_cg_iso {S Q : Type*} [Group S] [Group Q] (ι : S →* Q)
    {S₁ S₂ : Subgroup S} {Q₁ Q₂ : Subgroup Q} (h1 : S₁ = Q₁.comap ι) (h2 : S₂ = Q₂.comap ι)
    (hcov : ∀ q : Q, ∃ s : S, ∃ b ∈ Q₁ ⊓ Q₂, q = ι s * b) :
    Nonempty (burnsideF4gG2Two_cg S₁ S₂ ≃g burnsideF4gG2Two_cg Q₁ Q₂) := by
  have hc1 : ∀ q : Q, ∃ s : S, (ι s)⁻¹ * q ∈ Q₁ := fun q => by
    obtain ⟨s, b, hb, rfl⟩ := hcov q
    exact ⟨s, by simpa using hb.1⟩
  have hc2 : ∀ q : Q, ∃ s : S, (ι s)⁻¹ * q ∈ Q₂ := fun q => by
    obtain ⟨s, b, hb, rfl⟩ := hcov q
    exact ⟨s, by simpa using hb.2⟩
  obtain ⟨e1, he1⟩ := burnsideF4gG2Two_exists_quotEquiv ι h1 hc1
  obtain ⟨e2, he2⟩ := burnsideF4gG2Two_exists_quotEquiv ι h2 hc2
  have step : ∀ (x : S ⧸ S₁) (y : S ⧸ S₂),
      (∃ g' : Q, (g' : Q ⧸ Q₁) = e1 x ∧ (g' : Q ⧸ Q₂) = e2 y) ↔
        ∃ g : S, (g : S ⧸ S₁) = x ∧ (g : S ⧸ S₂) = y := by
    intro x y
    constructor
    · rintro ⟨g', hg1, hg2⟩
      obtain ⟨s, b, hb, rfl⟩ := hcov g'
      have e0 : (ι s * b)⁻¹ * ι s = b⁻¹ := by group
      have k1 : ((ι s * b : Q) : Q ⧸ Q₁) = ((ι s : Q) : Q ⧸ Q₁) :=
        QuotientGroup.eq.2 (by rw [e0]; exact Q₁.inv_mem hb.1)
      have k2 : ((ι s * b : Q) : Q ⧸ Q₂) = ((ι s : Q) : Q ⧸ Q₂) :=
        QuotientGroup.eq.2 (by rw [e0]; exact Q₂.inv_mem hb.2)
      refine ⟨s, e1.injective ?_, e2.injective ?_⟩
      · rw [he1, ← k1, hg1]
      · rw [he2, ← k2, hg2]
    · rintro ⟨g, hg1, hg2⟩
      exact ⟨ι g, by rw [← hg1, he1], by rw [← hg2, he2]⟩
  refine ⟨{ toEquiv := Equiv.sumCongr e1 e2, map_rel_iff' := ?_ }⟩
  intro a b
  rcases a with x | y <;> rcases b with x' | y'
  · exact iff_of_false burnsideF4gG2Two_cg_not_adj_inl burnsideF4gG2Two_cg_not_adj_inl
  · show (burnsideF4gG2Two_cg Q₁ Q₂).Adj (Sum.inl (e1 x)) (Sum.inr (e2 y')) ↔
      (burnsideF4gG2Two_cg S₁ S₂).Adj (Sum.inl x) (Sum.inr y')
    rw [burnsideF4gG2Two_cg_adj, burnsideF4gG2Two_cg_adj]
    exact step x y'
  · show (burnsideF4gG2Two_cg Q₁ Q₂).Adj (Sum.inr (e2 y)) (Sum.inl (e1 x')) ↔
      (burnsideF4gG2Two_cg S₁ S₂).Adj (Sum.inr y) (Sum.inl x')
    rw [burnsideF4gG2Two_cg_adj', burnsideF4gG2Two_cg_adj']
    exact step x' y
  · exact iff_of_false burnsideF4gG2Two_cg_not_adj_inr burnsideF4gG2Two_cg_not_adj_inr

end CosetGraph


section BuildingIso

open CFSG.Quasithin CFSG.Quasithin.H13.F431.BN CFSG.GH74.BNPair

variable {X : Type*} [Group X] {n : ℕ} (D : RankTwoSystem X n)

@[expose] def burnsideF4gG2Two_vtxMap (i : Bool) : X ⧸ pgen D.B D.N D.w₁ D.w₂ i → V D :=
