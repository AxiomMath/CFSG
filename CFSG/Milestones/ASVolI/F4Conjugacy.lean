theorem burnsideF4gSpInv_mem_Xs {g : StatedSp 2 K} :
    g ∈ burnsideF4gSpInv_Xs K ↔ ∃ t : K, burnsideF4gSpInv_xs t = g := by
  constructor
  · rintro ⟨x, rfl⟩
