set_option linter.unusedSectionVars false


theorem burnsideF4gF4_yam {K : Type} [Field K] [Finite K] [CharP K 2] {a : ℕ} (ha : 1 ≤ a)
    (hK : CFSG.ASVolI.ChF.ExceptionalRoots.ReeScope K a)
    {H : Type} [Group H]
    (marking : (CFSG.ASVolI.ChF.ExceptionalRoots.reeGroup K a ⧸
      Subgroup.center (CFSG.ASVolI.ChF.ExceptionalRoots.reeGroup K a)) ≃* H) :
    ∃ TD : Subgroup H, CFSG.Quasithin.IsYAmalgamPair TD
      ((CFSG.ASVolI.ChF.ExceptionalRoots.centralImage
        (CFSG.ASVolI.ChF.ExceptionalRoots.reeGroup K a)
        (CFSG.ASVolI.ChF.ExceptionalRoots.reeParabolic K a 1)).map marking.toMonoidHom)
      ((CFSG.ASVolI.ChF.ExceptionalRoots.centralImage
        (CFSG.ASVolI.ChF.ExceptionalRoots.reeGroup K a)
        (CFSG.ASVolI.ChF.ExceptionalRoots.reeParabolic K a 0)).map marking.toMonoidHom) := by
  haveI : CharP K F4.prime := inferInstanceAs (CharP K 2)
  have hK' : Nat.card K = 2 ^ (2 * a + 1) := hK
  haveI : IsSimpleGroup (Gm K a) := isSimpleGroup_gm ha hK'
  haveI : Finite (Gm K a) := Subtype.finite
  have hY := CFSG.Quasithin.H13.F431.BN.isYAmalgamPair (octSystemOf (octRGD2 hK'))
    (isSylowTwoOf_Ug hK')
  obtain ⟨q, hq⟩ := burnsideF4gF4_exists_quotEquiv (burnsideF4gF4_center_trivial ha hK')
  let e0 : Gm K a ≃* ↥(reeGroup K a) := MulEquiv.subgroupCongr burnsideF4gF4_reeGroup_eq.symm
  let Φ : Gm K a ≃* H := (e0.trans q).trans marking
  have key : ∀ (P : Subgroup (Gm K a)) (R : Subgroup (ModGL F4.tag K)),
      (∀ y : Gm K a, y ∈ P ↔ (y : ModGL F4.tag K) ∈ R) →
      (centralImage (reeGroup K a) R).map marking.toMonoidHom = P.map Φ.toMonoidHom := by
    intro P R hPR
    ext z
    constructor
    · rintro ⟨_, ⟨g, hg, rfl⟩, rfl⟩
      refine ⟨e0.symm g, (hPR _).2 hg, ?_⟩
      show marking (q (e0 (e0.symm g))) = marking (QuotientGroup.mk' _ g)
      rw [MulEquiv.apply_symm_apply, hq]
      rfl
    · rintro ⟨y, hy, rfl⟩
      refine ⟨_, ⟨e0 y, (hPR y).1 hy, rfl⟩, ?_⟩
      show marking (QuotientGroup.mk' _ (e0 y)) = marking (q (e0 y))
      rw [hq]
      rfl
  rw [key _ _ (burnsideF4gF4_mem_P₁_iff hK'), key _ _ (burnsideF4gF4_mem_P₂_iff hK')]
  exact ⟨_, CFSG.Quasithin.IsYAmalgamPair.map Φ hY⟩

end Final

