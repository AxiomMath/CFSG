open CFSG.GH74.BNPair CFSG.Quasithin.H13.F431.BN in
theorem burnsideF4gF4_mem_P₁_iff (hK : Nat.card K = 2 ^ (2 * a + 1)) [IsSimpleGroup (Gm K a)]
    (y : Gm K a) :
    y ∈ (octSystemOf (octRGD2 hK)).P₁ ↔
      (y : ModGL F4.tag K) ∈ ChF.ExceptionalRoots.reeParabolic K a 1 := by
  have hm : octR1 K a ∈ (octSystemOf (octRGD2 hK)).N := (octRGD2 hK).r₁_mem_N
  rw [burnsideF4gF4_reeParabolic_one]
  have hP := burnsideF4gF4_P_eq_sup (octSystemOf (octRGD2 hK)) true (m := octR1 K a) hm rfl
  show y ∈ P (octSystemOf (octRGD2 hK)) true ↔ _
