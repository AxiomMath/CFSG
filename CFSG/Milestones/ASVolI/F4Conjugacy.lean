      apply hz1
      rw [← hi']
      apply u33PresHom_injective
      rw [u33Tel_hom, h, map_one])
  apply key
  have := congrArg u33PresHom hx'
  simpa only [map_mul, u33Tel_hom, u33PresHom_genPG, ← hi'] using this.symm

