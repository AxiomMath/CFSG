theorem burnsideF4gU5Inv_flag_smul {k : ℕ} {v : Fin 5 → F} (hv : v ∈ burnsideF4gU5_flag F k)
    (c : F) : c • v ∈ burnsideF4gU5_flag F k := by
  intro a ha
  simp [hv a ha]

theorem burnsideF4gU5Inv_mem_stab_one_of {g : SU σ 5}
    (h1 : SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F) ∈ burnsideF4gU5_flag F 1)
    (h2 : SUExtras.mat σ 5 g⁻¹ *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F) ∈
      burnsideF4gU5_flag F 1) : g ∈ burnsideF4gU5_stab σ 1 := by
  intro v
  constructor
  · intro hv
    have hw := burnsideF4gU5Inv_eq_smul_e0 hv
    have hv' : v = SUExtras.mat σ 5 g⁻¹ *ᵥ (SUExtras.mat σ 5 g *ᵥ v) := by
      rw [Matrix.mulVec_mulVec, ← map_mul, inv_mul_cancel, map_one, Matrix.one_mulVec]
    have e : SUExtras.mat σ 5 g⁻¹ *ᵥ (SUExtras.mat σ 5 g *ᵥ v) =
        (SUExtras.mat σ 5 g *ᵥ v) 0 • (SUExtras.mat σ 5 g⁻¹ *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F)) := by
      rw [← Matrix.mulVec_smul]
      exact congrArg _ hw
    rw [hv'.trans e]
    exact burnsideF4gU5Inv_flag_smul h2 _
  · intro hv
    rw [burnsideF4gU5Inv_eq_smul_e0 hv, Matrix.mulVec_smul]
    exact burnsideF4gU5Inv_flag_smul h1 _

theorem burnsideF4gU5Inv_mem_stab_two_of {g : SU σ 5}
    (h1 : SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F) ∈ burnsideF4gU5_flag F 2)
    (h1' : SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e1 : Fin 5 → F) ∈ burnsideF4gU5_flag F 2)
    (h2 : SUExtras.mat σ 5 g⁻¹ *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F) ∈ burnsideF4gU5_flag F 2)
    (h2' : SUExtras.mat σ 5 g⁻¹ *ᵥ (burnsideF4gU5Inv_e1 : Fin 5 → F) ∈ burnsideF4gU5_flag F 2) :
    g ∈ burnsideF4gU5_stab σ 2 := by
  have add_mem : ∀ {x y : Fin 5 → F}, x ∈ burnsideF4gU5_flag F 2 → y ∈ burnsideF4gU5_flag F 2 →
      x + y ∈ burnsideF4gU5_flag F 2 := by
    intro x y hx hy a ha
    simp [hx a ha, hy a ha]
  intro v
  constructor
  · intro hv
    have hw := burnsideF4gU5Inv_eq_of_mem_flag_two hv
    have hv' : v = SUExtras.mat σ 5 g⁻¹ *ᵥ (SUExtras.mat σ 5 g *ᵥ v) := by
      rw [Matrix.mulVec_mulVec, ← map_mul, inv_mul_cancel, map_one, Matrix.one_mulVec]
    have e : SUExtras.mat σ 5 g⁻¹ *ᵥ (SUExtras.mat σ 5 g *ᵥ v) =
        (SUExtras.mat σ 5 g *ᵥ v) 0 • (SUExtras.mat σ 5 g⁻¹ *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F)) +
        (SUExtras.mat σ 5 g *ᵥ v) 1 • (SUExtras.mat σ 5 g⁻¹ *ᵥ (burnsideF4gU5Inv_e1 : Fin 5 → F)) := by
      rw [← Matrix.mulVec_smul, ← Matrix.mulVec_smul, ← Matrix.mulVec_add]
      exact congrArg _ hw
    rw [hv'.trans e]
    exact add_mem (burnsideF4gU5Inv_flag_smul h2 _) (burnsideF4gU5Inv_flag_smul h2' _)
  · intro hv
    rw [burnsideF4gU5Inv_eq_of_mem_flag_two hv, Matrix.mulVec_add, Matrix.mulVec_smul,
      Matrix.mulVec_smul]
    exact add_mem (burnsideF4gU5Inv_flag_smul h1 _) (burnsideF4gU5Inv_flag_smul h1' _)

theorem burnsideF4gU5Inv_apply_e0_of_comm (c : F) (hc : c + σ c = 0) (hc0 : c ≠ 0) {g : SU σ 5}
    (hg : g * burnsideF4gU5Inv_xl04 σ c hc = burnsideF4gU5Inv_xl04 σ c hc * g) :
    SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F) ∈ burnsideF4gU5_flag F 1 := by
  have h := congrArg (fun A : SU σ 5 => SUExtras.mat σ 5 A *ᵥ (Pi.single 4 1 : Fin 5 → F)) hg
  simp only [map_mul, ← Matrix.mulVec_mulVec, burnsideF4gU5Inv_xl04_mulVec] at h
  rw [Matrix.mulVec_add, Matrix.mulVec_smul] at h
  have h2 : c • (SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F)) =
      (c * (SUExtras.mat σ 5 g *ᵥ (Pi.single 4 1 : Fin 5 → F)) 4) • (burnsideF4gU5Inv_e0 : Fin 5 → F) := by
    have h3 := add_left_cancel h
    simpa using h3
  have h4 : SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F) =
      (SUExtras.mat σ 5 g *ᵥ (Pi.single 4 1 : Fin 5 → F)) 4 • (burnsideF4gU5Inv_e0 : Fin 5 → F) := by
    have h5 : c • (SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F)) =
        c • ((SUExtras.mat σ 5 g *ᵥ (Pi.single 4 1 : Fin 5 → F)) 4 •
          (burnsideF4gU5Inv_e0 : Fin 5 → F)) := by
      rw [h2, smul_smul]
    exact smul_right_injective (Fin 5 → F) hc0 h5
  rw [h4]
  exact burnsideF4gU5Inv_smul_e0_mem_flag _

theorem burnsideF4gU5Inv_centralizer_xl04_le_stab (c : F) (hc : c + σ c = 0) (hc0 : c ≠ 0)
    {g : SU σ 5} (hg : g * burnsideF4gU5Inv_xl04 σ c hc = burnsideF4gU5Inv_xl04 σ c hc * g) :
    g ∈ burnsideF4gU5_stab σ 1 :=
  burnsideF4gU5Inv_mem_stab_one_of σ (burnsideF4gU5Inv_apply_e0_of_comm σ c hc hc0 hg)
    (burnsideF4gU5Inv_apply_e0_of_comm σ c hc hc0 (Commute.inv_left (show Commute g _ from hg)))

theorem burnsideF4gU5Inv_fix_e0_of_two_power {f : ℕ} (hF : Nat.card F = (2 ^ f) ^ 2) {g : SU σ 5}
    (hg : g ∈ burnsideF4gU5_stab σ 1) {k : ℕ} (hk : g ^ (2 ^ k) = 1) :
    SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F) = burnsideF4gU5Inv_e0 := by
  have he0 : (burnsideF4gU5Inv_e0 : Fin 5 → F) ∈ burnsideF4gU5_flag F 1 := by
    simpa using burnsideF4gU5Inv_smul_e0_mem_flag (F := F) 1
  have hGe : SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F) ∈ burnsideF4gU5_flag F 1 :=
    (hg (burnsideF4gU5Inv_e0 : Fin 5 → F)).mpr he0
  have hl : SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F) =
      (SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F)) 0 •
        (burnsideF4gU5Inv_e0 : Fin 5 → F) := burnsideF4gU5Inv_eq_smul_e0 hGe
  set l := (SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F)) 0 with hl_def
  have hpow : ∀ n : ℕ, SUExtras.mat σ 5 (g ^ n) *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F) =
      (l ^ n) • (burnsideF4gU5Inv_e0 : Fin 5 → F) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ', map_mul, ← Matrix.mulVec_mulVec, ih, Matrix.mulVec_smul, hl, smul_smul,
        pow_succ]
  have h1 : l ^ (2 ^ k) = 1 := by
    have := hpow (2 ^ k)
    rw [hk, map_one, Matrix.one_mulVec] at this
    have h0 := congrFun this 0
    simpa [burnsideF4gU5Inv_e0] using h0.symm
  have h2 : l = 1 := burnsideF4gU5Inv_pow_two_eq_one hF h1
  rw [hl, h2, one_smul]

theorem burnsideF4gU5Inv_commute_xl04_of_two_power {f : ℕ} (hF : Nat.card F = (2 ^ f) ^ 2)
    (c : F) (hc : c + σ c = 0) {g : SU σ 5} (hg : g ∈ burnsideF4gU5_stab σ 1) {k : ℕ}
    (hk : g ^ (2 ^ k) = 1) :
    g * burnsideF4gU5Inv_xl04 σ c hc = burnsideF4gU5Inv_xl04 σ c hc * g :=
  burnsideF4gU5Inv_commute_xl04_of_fix σ c hc
    (burnsideF4gU5Inv_fix_e0_of_two_power σ hF hg hk)

theorem burnsideF4gU5Inv_x03_mulVec (hσ : ∀ c, σ (σ c) = c) (a : F) (x : Fin 5 → F) :
    SUExtras.mat σ 5 (burnsideF4gU5Inv_x03 σ hσ a) *ᵥ x =
      x + (a * x 3) • (burnsideF4gU5Inv_e0 : Fin 5 → F) -
        (σ a * x 4) • (burnsideF4gU5Inv_e1 : Fin 5 → F) := by
  funext i
  rw [burnsideF4gU5Inv_x03_mat, Matrix.sub_mulVec, Matrix.add_mulVec, Matrix.one_mulVec]
  simp only [Pi.add_apply, Pi.sub_apply, burnsideF4gU5_single_mulVec, burnsideF4gU5Inv_e0,
    burnsideF4gU5Inv_e1, Pi.smul_apply, Pi.single_apply, smul_eq_mul]
  fin_cases i <;> simp

theorem burnsideF4gU5Inv_apply_e01_of_comm (hσ : ∀ c, σ (σ c) = c) {g : SU σ 5}
    (hg : g * burnsideF4gU5Inv_x03 σ hσ 1 = burnsideF4gU5Inv_x03 σ hσ 1 * g) :
    SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F) ∈ burnsideF4gU5_flag F 2 ∧
    SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e1 : Fin 5 → F) ∈ burnsideF4gU5_flag F 2 := by
  have hflag : ∀ (a b : F), a • (burnsideF4gU5Inv_e0 : Fin 5 → F) +
      b • (burnsideF4gU5Inv_e1 : Fin 5 → F) ∈ burnsideF4gU5_flag F 2 := by
    intro a b i hi
    simp only [burnsideF4gU5Inv_e0, burnsideF4gU5Inv_e1, Pi.add_apply, Pi.smul_apply,
      Pi.single_apply, smul_eq_mul]
    have h0 : i ≠ 0 := by
      intro h; subst h; exact absurd hi (by decide)
    have h1 : i ≠ 1 := by
      intro h; subst h; exact absurd hi (by decide)
    simp [h0, h1]
  have h3 := congrArg (fun A : SU σ 5 => SUExtras.mat σ 5 A *ᵥ (Pi.single 3 1 : Fin 5 → F)) hg
  have h4 := congrArg (fun A : SU σ 5 => SUExtras.mat σ 5 A *ᵥ (Pi.single 4 1 : Fin 5 → F)) hg
  simp only [map_mul, ← Matrix.mulVec_mulVec, burnsideF4gU5Inv_x03_mulVec] at h3 h4
  simp only [Matrix.mulVec_sub, Matrix.mulVec_add, Matrix.mulVec_smul] at h3 h4
  have e33 : (Pi.single 3 1 : Fin 5 → F) 3 = 1 := by simp
  have e34 : (Pi.single 3 1 : Fin 5 → F) 4 = 0 := by simp [Pi.single_apply]
  have e43 : (Pi.single 4 1 : Fin 5 → F) 3 = 0 := by simp [Pi.single_apply]
  have e44 : (Pi.single 4 1 : Fin 5 → F) 4 = 1 := by simp
  rw [e33, e34, map_one] at h3
  rw [e43, e44, map_one] at h4
  constructor
  · have h5 : SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e0 : Fin 5 → F) =
        ((SUExtras.mat σ 5 g *ᵥ (Pi.single 3 1 : Fin 5 → F)) 3) •
          (burnsideF4gU5Inv_e0 : Fin 5 → F) +
        (-((SUExtras.mat σ 5 g *ᵥ (Pi.single 3 1 : Fin 5 → F)) 4)) •
          (burnsideF4gU5Inv_e1 : Fin 5 → F) := by
      linear_combination (norm := module) h3
    rw [h5]
    exact hflag _ _
  · have h5 : SUExtras.mat σ 5 g *ᵥ (burnsideF4gU5Inv_e1 : Fin 5 → F) =
        (-((SUExtras.mat σ 5 g *ᵥ (Pi.single 4 1 : Fin 5 → F)) 3)) •
          (burnsideF4gU5Inv_e0 : Fin 5 → F) +
        ((SUExtras.mat σ 5 g *ᵥ (Pi.single 4 1 : Fin 5 → F)) 4) •
          (burnsideF4gU5Inv_e1 : Fin 5 → F) := by
      linear_combination (norm := module) (-1 : F) • h4
    rw [h5]
    exact hflag _ _

theorem burnsideF4gU5Inv_centralizer_x03_le_stab (hσ : ∀ c, σ (σ c) = c) {g : SU σ 5}
    (hg : g * burnsideF4gU5Inv_x03 σ hσ 1 = burnsideF4gU5Inv_x03 σ hσ 1 * g) :
    g ∈ burnsideF4gU5_stab σ 2 :=
  burnsideF4gU5Inv_mem_stab_two_of σ (burnsideF4gU5Inv_apply_e01_of_comm σ hσ hg).1
    (burnsideF4gU5Inv_apply_e01_of_comm σ hσ hg).2
    (burnsideF4gU5Inv_apply_e01_of_comm σ hσ (Commute.inv_left (show Commute g _ from hg))).1
    (burnsideF4gU5Inv_apply_e01_of_comm σ hσ (Commute.inv_left (show Commute g _ from hg))).2

theorem burnsideF4gU5Inv_hh_e1_left (x : Fin 5 → F) :
    burnsideF4gU5Inv_hh σ (burnsideF4gU5Inv_e1 : Fin 5 → F) x = x 3 := by
  simp [burnsideF4gU5Inv_hh, burnsideF4gU5Inv_e1, Pi.single_apply, burnsideF4gU5_rev_one,
    burnsideF4gU5_rev_three]

theorem burnsideF4gU5Inv_mem_flag_three_iff (v : Fin 5 → F) :
    v ∈ burnsideF4gU5_flag F 3 ↔ ∀ w ∈ burnsideF4gU5_flag F 2, burnsideF4gU5Inv_hh σ w v = 0 := by
  constructor
  · intro hv w hw
    rw [burnsideF4gU5Inv_eq_of_mem_flag_two hw, burnsideF4gU5Inv_hh_add_left,
      burnsideF4gU5Inv_hh_smul_left, burnsideF4gU5Inv_hh_smul_left,
      burnsideF4gU5Inv_hh_e0_left, burnsideF4gU5Inv_hh_e1_left, hv 3 (by decide),
      hv 4 (by decide)]
    simp
  · intro hv a ha
    have h0 := hv _ burnsideF4gU5Inv_e0_mem_flag_two
    have h1 := hv _ burnsideF4gU5Inv_e1_mem_flag_two
    rw [burnsideF4gU5Inv_hh_e0_left] at h0
    rw [burnsideF4gU5Inv_hh_e1_left] at h1
    fin_cases a
    · exact absurd ha (by decide)
    · exact absurd ha (by decide)
    · exact absurd ha (by decide)
    · exact h1
    · exact h0

theorem burnsideF4gU5Inv_stab_two_flag_three {g : SU σ 5} (hg : g ∈ burnsideF4gU5_stab σ 2)
    {v : Fin 5 → F} (hv : v ∈ burnsideF4gU5_flag F 3) :
    SUExtras.mat σ 5 g *ᵥ v ∈ burnsideF4gU5_flag F 3 := by
  rw [burnsideF4gU5Inv_mem_flag_three_iff σ] at hv ⊢
  intro w hw
  have hg' : g⁻¹ ∈ burnsideF4gU5_stab σ 2 := (burnsideF4gU5_stab σ 2).inv_mem hg
  have hw' : SUExtras.mat σ 5 g⁻¹ *ᵥ w ∈ burnsideF4gU5_flag F 2 := (hg' w).mpr hw
  have hww : SUExtras.mat σ 5 g *ᵥ (SUExtras.mat σ 5 g⁻¹ *ᵥ w) = w := by
    rw [Matrix.mulVec_mulVec, ← map_mul, mul_inv_cancel, map_one, Matrix.one_mulVec]
  have := burnsideF4gU5Inv_hh_mulVec σ g (SUExtras.mat σ 5 g⁻¹ *ᵥ w) v
  rw [hww] at this
  rw [this]
  exact hv _ hw'

theorem burnsideF4gU5Inv_flag_add {k : ℕ} {x y : Fin 5 → F} (hx : x ∈ burnsideF4gU5_flag F k)
    (hy : y ∈ burnsideF4gU5_flag F k) : x + y ∈ burnsideF4gU5_flag F k := by
