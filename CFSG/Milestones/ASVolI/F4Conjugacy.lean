theorem burnsideF4g_lieModel_Sp4 {f : ℕ} (hf : 2 ≤ f) {H : Type} [Group H]
    (h : IsGenLie H .Sp4 2 f) :
    CFSG.Blueprint.LieModel H CFSG.Assembly.LowTwoRank.StatedLieTag.PSp 2 2 f := by
  obtain ⟨hp, hf1, K, hK, hKfin, hcard, he⟩ := h
  refine (CFSG.Blueprint.LieModel.classical_iff
    (t := CFSG.Assembly.LowTwoRank.StatedLieTag.PSp) (by decide)).2 ?_
  refine ⟨⟨hp, hf1, le_rfl, ?_⟩, K, hK, hKfin, hcard, he⟩
  intro hne
  have h2 := (Prod.mk.inj hne).2
  have : 2 ^ 2 ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf
  omega

theorem burnsideF4g_lieModel_U4 {f : ℕ} {H : Type} [Group H] (h : IsGenLie H .U4 2 f) :
    CFSG.Blueprint.LieModel H CFSG.Assembly.LowTwoRank.StatedLieTag.PSU 4 2 f := by
  obtain ⟨hp, hf1, K, hK, hKfin, hcard, he⟩ := h
  refine (CFSG.Blueprint.LieModel.classical_iff
    (t := CFSG.Assembly.LowTwoRank.StatedLieTag.PSU) (by decide)).2 ?_
