  have hi' : u33Tel u33GenPG i = z := hi
  have ha : z * u33GenPG 0 = u33GenPG 0 * z := hcomm _ u33Data.a_mem_T
  have hb : z * u33GenPG 1 = u33GenPG 1 * z := hcomm _ u33Data.b_mem_T
