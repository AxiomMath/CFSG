variable {τ : Tag} {K : Type} [Field K]

@[expose] noncomputable def burnsideF4gD4_wordUnit (τ : Tag) (K : Type) [Field K]
    (word : List (Fin τ.rank)) : ModGL τ K :=
  ((word.map fun i => weylElt τ K i 1).reverse).prod

theorem burnsideF4gD4_coe_wordUnit (word : List (Fin τ.rank)) :
    (burnsideF4gD4_wordUnit τ K word : Module.End K (RootModule τ K)) =
      weylWordOperator τ K word := by
  have h := map_list_prod (Units.coeHom (Module.End K (RootModule τ K)))
    ((word.map fun i => weylElt τ K i 1).reverse)
  simp only [Units.coeHom_apply, List.map_reverse, List.map_map] at h
  exact h

theorem burnsideF4gD4_eq_wordUnit_iff (word : List (Fin τ.rank)) (g : ModGL τ K) :
    (g : Module.End K (RootModule τ K)) = weylWordOperator τ K word ↔
      g = burnsideF4gD4_wordUnit τ K word := by
  rw [← burnsideF4gD4_coe_wordUnit]
  exact ⟨fun h => Units.ext h, fun h => by rw [h]⟩

theorem burnsideF4gD4_wordUnit_cons (i : Fin τ.rank) (word : List (Fin τ.rank)) :
    burnsideF4gD4_wordUnit τ K (i :: word) =
      burnsideF4gD4_wordUnit τ K word * weylElt τ K i 1 := by
  simp [burnsideF4gD4_wordUnit]

theorem burnsideF4gD4_absoluteTorus_eq : absoluteTorus τ K = torusGroup τ K := by
  unfold absoluteTorus torusGroup
  congr 1
  ext g
  constructor
  · rintro ⟨i, t, hg⟩
    exact ⟨(i, t), Units.ext hg.symm⟩
  · rintro ⟨⟨i, t⟩, rfl⟩
    exact ⟨i, t, rfl⟩

theorem burnsideF4gD4_relativeWeyl_eq (word : List (Fin Tag.D4.rank)) :
    relativeWeyl Tag.D4 K word = Subgroup.closure {burnsideF4gD4_wordUnit Tag.D4 K word} := by
  unfold relativeWeyl
  congr 1
  ext g
  exact burnsideF4gD4_eq_wordUnit_iff word g

end Weyl

section RootGroups

open CFSG.Blueprint CFSG.Blueprint.Chevalley CFSG.LieType.Chevalley
  CFSG.ASVolI.ChF.ExceptionalRoots

variable {τ : Tag} {K : Type} [Field K]

theorem burnsideF4gD4_conj_mem_rootSubgroup (word : List (Fin τ.rank)) :
    ∀ {β : Fin τ.rank → ℤ}, IsRoot τ β → ∀ {g : ModGL τ K}, g ∈ rootSubgroup τ K β →
      burnsideF4gD4_wordUnit τ K word * g * (burnsideF4gD4_wordUnit τ K word)⁻¹ ∈
        rootSubgroup τ K (word.foldl (fun root index => reflect τ index root) β) := by
  induction word with
  | nil =>
    intro β hβ g hg
    simpa [burnsideF4gD4_wordUnit] using hg
  | cons i w ih =>
    intro β hβ g hg
    have h1 : weylElt τ K i 1 * g * (weylElt τ K i 1)⁻¹ ∈ rootSubgroup τ K (reflect τ i β) := by
      rw [← map_conj_weylElt_rootSubgroup K i hβ]
      exact ⟨g, hg, rfl⟩
    have h2 := ih (IsRoot.reflect i hβ) h1
    rw [List.foldl_cons, burnsideF4gD4_wordUnit_cons]
    have e : burnsideF4gD4_wordUnit τ K w * weylElt τ K i 1 * g *
        (burnsideF4gD4_wordUnit τ K w * weylElt τ K i 1)⁻¹ =
        burnsideF4gD4_wordUnit τ K w * (weylElt τ K i 1 * g * (weylElt τ K i 1)⁻¹) *
          (burnsideF4gD4_wordUnit τ K w)⁻¹ := by
      group
    rw [e]
    exact h2

theorem burnsideF4gD4_absoluteRoot_eq {α : Fin τ.rank → ℤ} (hα : IsRoot τ α) :
    absoluteRoot τ K α = rootSubgroup τ K α := by
  apply le_antisymm
  · refine (Subgroup.closure_le _).2 ?_
    rintro e ⟨c, seed, word, actor, hfold, hactor, helem⟩
    have hact : actor = burnsideF4gD4_wordUnit τ K word :=
      (burnsideF4gD4_eq_wordUnit_iff word actor).1 hactor
    have he : e = burnsideF4gD4_wordUnit τ K word * xUnit τ K seed c *
        (burnsideF4gD4_wordUnit τ K word)⁻¹ := by
      refine Units.ext ?_
      rw [helem, hact]
      rfl
    have hx : xUnit τ K seed c ∈ rootSubgroup τ K (Pi.single seed 1) := by
      rw [← pinnedX_single]
      exact Subgroup.subset_closure ⟨c, rfl⟩
    have h := burnsideF4gD4_conj_mem_rootSubgroup word (IsRoot.basis seed) hx
    rw [hfold] at h
    rw [he]
    exact h
  · refine (Subgroup.closure_le _).2 ?_
    rintro _ ⟨c, rfl⟩
    refine Subgroup.subset_closure ⟨(pinnedData τ α).2.2 • c, (pinnedData τ α).1,
      (pinnedData τ α).2.1.map τ.idx, pinnedWeyl τ K α, ?_, ?_, ?_⟩
    · rw [List.foldl_map]
      exact foldl_reflect_pinnedData hα
    · rw [← burnsideF4gD4_coe_wordUnit]
      simp [pinnedWeyl, burnsideF4gD4_wordUnit, List.map_map, Function.comp_def]
    · rfl

theorem burnsideF4gD4_absoluteBorel_eq : absoluteBorel τ K = borelGroup τ K := by
  have hpos : absolutePositive τ K = posUnipotent τ K := by
    unfold absolutePositive posUnipotent rootSpan
    refine iSup_congr fun α => iSup_congr fun hα => ?_
    exact burnsideF4gD4_absoluteRoot_eq hα.1
  unfold absoluteBorel borelGroup
  rw [hpos, burnsideF4gD4_absoluteTorus_eq, sup_comm]

end RootGroups

