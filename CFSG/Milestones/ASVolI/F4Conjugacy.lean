  have hnt1 : burnsideF4gU5_stab (unitaryInvolution F 2 f) 1 ≠ ⊤ := fun h =>
    burnsideF4gU5_Y1_not_mem_stab_one (unitaryInvolution F 2 f) hσ (h ▸ Subgroup.mem_top _)
  have hnt2 : burnsideF4gU5_stab (unitaryInvolution F 2 f) 2 ≠ ⊤ := fun h =>
    burnsideF4gU5_Y0_not_mem_stab_two (unitaryInvolution F 2 f) h1 (h ▸ Subgroup.mem_top _)
