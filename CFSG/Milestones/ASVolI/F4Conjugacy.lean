theorem burnsideF4gF4Inv_Cz_le_oPPrime (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1)) :
    centralizerZ K a ≤ oPPrime 2 (F4.reeLocalParabolic K a ⟨1, by decide⟩) := by
  have hCP := burnsideF4gF4Inv_Cz_le_P1 (a := a) hK
  have hU2 : IsPGroup 2 (F4.reeFixedPosUnipotent K a) := isPGroup_reeFixedPosUnipotent ha hK
  refine sup_le ?_ ?_
  · exact burnsideF4gF4Inv_mem_oPPrime_of_isPGroup (le_sup_left.trans hCP)
      (hU2.to_le (reeFixedOrbitComplementUnipotent_le ⟨1, by decide⟩))
  · set P := F4.reeLocalParabolic K a ⟨1, by decide⟩ with hP
    have hRP : rankOneGroupTwo K a ≤ P := le_sup_right.trans hCP
    have hsimple := (isSimpleGroup_rankOneGroupTwo ha hK).1
    let N : Subgroup ↥(rankOneGroupTwo K a) := (oPPrime 2 P).subgroupOf (rankOneGroupTwo K a)
    have hNn : N.Normal := ⟨fun x hx g => by
      refine Subgroup.mem_subgroupOf.2 ?_
      have hx' : (x : ModGL F4.tag K) ∈ oPPrime 2 P := Subgroup.mem_subgroupOf.1 hx
      have := burnsideF4gF4Inv_oPPrime_conj 2 (hRP g.2) hx'
      simpa using this⟩
    rcases hNn.eq_bot_or_eq_top with h | h
    · exfalso
      have hu : largeReeCoord a K 1 0 ∈ F4.reeFixedOrbitUnipotent K a ⟨1, by decide⟩ :=
        largeReeCoord_mem hK 1 0
      have huR : largeReeCoord a K 1 0 ∈ rankOneGroupTwo K a :=
        Subgroup.subset_closure (Or.inl (Or.inl hu))
      have huU : largeReeCoord a K 1 0 ∈ F4.reeFixedPosUnipotent K a :=
        reeFixedOrbitUnipotent_le _ hu
      have huO : largeReeCoord a K 1 0 ∈ oPPrime 2 P := by
        refine Subgroup.subset_closure ⟨hRP huR, ?_⟩
        obtain ⟨k, hk⟩ := IsPGroup.iff_orderOf.1 hU2 ⟨_, huU⟩
        exact ⟨k, (Subgroup.orderOf_coe (⟨_, huU⟩ : ↥(F4.reeFixedPosUnipotent K a))).trans hk⟩
      have hmem : (⟨largeReeCoord a K 1 0, huR⟩ : ↥(rankOneGroupTwo K a)) ∈ N :=
        Subgroup.mem_subgroupOf.2 huO
      rw [h, Subgroup.mem_bot] at hmem
      have h1 : largeReeCoord a K 1 0 = 1 := congrArg Subtype.val hmem
      have h2 : largeReeP K 1 (largeReeSigma a 1) 0 (largeReeSigma a 0 + 1 ^ 2 * largeReeSigma a 1) =
          largeReeP K 0 0 0 0 := by
        have e : largeReeP K 0 0 0 0 = (1 : ModGL F4.tag K) := by
          simp [largeReeP, largeReeX, pinnedX_zero]
          rfl
        rw [e]
        exact h1
      obtain ⟨h3, -, -, -⟩ := largeReeP_injective h2
      exact one_ne_zero h3
    · intro r hr
      have : (⟨r, hr⟩ : ↥(rankOneGroupTwo K a)) ∈ N := by rw [h]; exact Subgroup.mem_top _
      exact Subgroup.mem_subgroupOf.1 this

