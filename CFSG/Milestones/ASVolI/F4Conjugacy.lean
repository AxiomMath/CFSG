      exact QuotientGroup.eq.2 (by simpa using this)

theorem burnsideF4gG2Two_building_adj (g h : X) :
    (Γ D).Adj (vt D true g⁻¹) (vt D false h⁻¹) ↔ ∃ z : X, z * g ∈ D.P₁ ∧ z * h ∈ D.P₂ := by
  constructor
  · rintro ⟨-, z, hz1, hz2⟩
    refine ⟨z, ?_, ?_⟩
    · have := (mem_vt_iff D).1 hz1
      simpa [pgen_true] using this
    · have := (mem_vt_iff D).1 hz2
      simpa [pgen_false] using this
  · rintro ⟨z, hz1, hz2⟩
    refine ⟨vt_ne_of_ne true false (by simp) _ _, z, ?_, ?_⟩
    · exact (mem_vt_iff D).2 (by simpa [pgen_true] using hz1)
    · exact (mem_vt_iff D).2 (by simpa [pgen_false] using hz2)

theorem burnsideF4gG2Two_cg_building : Nonempty (burnsideF4gG2Two_cg D.P₁ D.P₂ ≃g Γ D) := by
  let f : (X ⧸ D.P₁) ⊕ (X ⧸ D.P₂) → V D :=
    Sum.elim (burnsideF4gG2Two_vtxMap D true) (burnsideF4gG2Two_vtxMap D false)
  have hinj : Function.Injective f := by
    intro a b hab
    rcases a with x | y <;> rcases b with x' | y'
    · exact congrArg Sum.inl (burnsideF4gG2Two_vtxMap_injective D true hab)
    · exfalso
      induction x using QuotientGroup.induction_on with
      | H a =>
        induction y' using QuotientGroup.induction_on with
        | H b => exact vt_ne_of_ne true false (by simp) _ _ hab
    · exfalso
      induction y using QuotientGroup.induction_on with
      | H a =>
        induction x' using QuotientGroup.induction_on with
        | H b => exact vt_ne_of_ne true false (by simp) _ _ hab.symm
    · exact congrArg Sum.inr (burnsideF4gG2Two_vtxMap_injective D false hab)
  have hsurj : Function.Surjective f := by
    intro v
    obtain ⟨i, x, rfl⟩ := exists_vtx v
    cases i
    · refine ⟨Sum.inr ((x⁻¹ : X) : X ⧸ D.P₂), ?_⟩
      show vt D false (x⁻¹)⁻¹ = _
      rw [inv_inv]
      rfl
    · refine ⟨Sum.inl ((x⁻¹ : X) : X ⧸ D.P₁), ?_⟩
      show vt D true (x⁻¹)⁻¹ = _
      rw [inv_inv]
      rfl
  refine ⟨{ toEquiv := Equiv.ofBijective f ⟨hinj, hsurj⟩, map_rel_iff' := ?_ }⟩
  have hcg : ∀ g h : X, (burnsideF4gG2Two_cg D.P₁ D.P₂).Adj (Sum.inl (g : X ⧸ D.P₁))
      (Sum.inr (h : X ⧸ D.P₂)) ↔ ∃ z : X, z * g ∈ D.P₁ ∧ z * h ∈ D.P₂ := by
    intro g h
    rw [burnsideF4gG2Two_cg_adj]
    constructor
    · rintro ⟨k, hk1, hk2⟩
      refine ⟨k⁻¹, ?_, ?_⟩
      · exact QuotientGroup.eq.1 hk1
      · exact QuotientGroup.eq.1 hk2
    · rintro ⟨z, hz1, hz2⟩
      refine ⟨z⁻¹, QuotientGroup.eq.2 ?_, QuotientGroup.eq.2 ?_⟩
      · simpa using hz1
      · simpa using hz2
  intro a b
  rcases a with x | y <;> rcases b with x' | y'
  · refine iff_of_false ?_ burnsideF4gG2Two_cg_not_adj_inl
    intro h
    exact adj_iff_vtype D _ _ h (by
      induction x using QuotientGroup.induction_on with
      | H a =>
        induction x' using QuotientGroup.induction_on with
        | H b =>
          change vtype D.B D.N D.w₁ D.w₂ (vt D true a⁻¹) = vtype D.B D.N D.w₁ D.w₂ (vt D true b⁻¹)
          rw [vtype_vt, vtype_vt])
  · induction x using QuotientGroup.induction_on with
    | H a =>
      induction y' using QuotientGroup.induction_on with
      | H b =>
        show (Γ D).Adj (vt D true a⁻¹) (vt D false b⁻¹) ↔ _
        rw [burnsideF4gG2Two_building_adj, hcg]
  · induction y using QuotientGroup.induction_on with
    | H a =>
      induction x' using QuotientGroup.induction_on with
      | H b =>
        show (Γ D).Adj (vt D false a⁻¹) (vt D true b⁻¹) ↔ _
        rw [SimpleGraph.adj_comm, burnsideF4gG2Two_building_adj, burnsideF4gG2Two_cg_adj',
          ← hcg, burnsideF4gG2Two_cg_adj]
  · refine iff_of_false ?_ burnsideF4gG2Two_cg_not_adj_inr
    intro h
    exact adj_iff_vtype D _ _ h (by
      induction y using QuotientGroup.induction_on with
      | H a =>
        induction y' using QuotientGroup.induction_on with
        | H b =>
          change vtype D.B D.N D.w₁ D.w₂ (vt D false a⁻¹) =
