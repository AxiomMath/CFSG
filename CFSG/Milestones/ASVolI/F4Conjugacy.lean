theorem burnsideF4gF4Inv_le_normalizer_of_commute {G : Type*} [Group G] {H K : Subgroup G}
    (h : ∀ x ∈ H, ∀ y ∈ K, Commute x y) : H ≤ Subgroup.normalizer (K : Set G) := by
  intro x hx
  rw [Subgroup.mem_normalizer_iff]
  intro y
  constructor
  · intro hy
    have e : x * y * x⁻¹ = y := by
      rw [(h x hx y hy).eq, mul_assoc, mul_inv_cancel, mul_one]
    rw [e]
    exact hy
  · intro hy
    have h2 := (h x⁻¹ (H.inv_mem hx) _ hy).eq
    have e : y = x * y * x⁻¹ := by
      calc y = x⁻¹ * (x * y * x⁻¹) * x := by group
        _ = (x * y * x⁻¹) * x⁻¹ * x := by rw [h2]
        _ = x * y * x⁻¹ := by group
    rw [e]
    exact hy

