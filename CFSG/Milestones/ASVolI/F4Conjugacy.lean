theorem burnsideF4gF4Two_mem_centralImage {E : Type} [Group E] {K : Type} [Field K] {a : ℕ}
    {Gp M : Subgroup E} {P : Subgroup (ModGL Tag.F4 K)}
    (marking : (reeGroup K a ⧸ Subgroup.center (reeGroup K a)) ≃* ↥Gp)
