theorem burnsideF4gF4TwoInv_tg_core (hK : Nat.card K = 2) (hKa : Nat.card K = 2 ^ (2 * 0 + 1)) :
    tg hKa ∈ pCoreOf 2 (burnsideF4gF4Two_system hK).P₂ := by
  rw [← burnsideF4gF4TwoInv_Pg_zero_eq hK]
  have hV : tg hKa ∈ (F4.reeFixedOrbitComplementUnipotent K 0 ⟨0, by decide⟩).subgroupOf
      (F4.reeGamma K 0) := by
    refine Subgroup.mem_subgroupOf.2 ?_
    rw [burnsideF4gF4TwoInv_coe_tg]
    exact (blocks_mem hKa 0 0 0 0 0 0 1).2.2.2.2.2.2.1
  have hle : (F4.reeFixedOrbitComplementUnipotent K 0 ⟨0, by decide⟩).subgroupOf
      (F4.reeGamma K 0) ≤ Pg K 0 ⟨0, by decide⟩ := by
    intro y hy
    refine Subgroup.mem_subgroupOf.2 ?_
    have hy' := Subgroup.mem_subgroupOf.1 hy
    rw [burnsideF4gF4TwoInv_reeLocalParabolic_zero]
