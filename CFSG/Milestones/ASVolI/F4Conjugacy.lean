theorem burnsideF4gF4Inv_oPPrime_P1_le (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1)) :
    oPPrime 2 (F4.reeLocalParabolic K a ⟨1, by decide⟩) ≤ centralizerZ K a := by
  haveI : CharP K 2 := inferInstanceAs (CharP K F4.prime)
  refine (Subgroup.closure_le _).2 ?_
  rintro x ⟨hxP, k, hk⟩
  obtain ⟨τ, hτ, s, hs, rfl⟩ := exists_mul_of_mem_reeLocalParabolic hK hxP
  obtain ⟨u, rfl⟩ := hτ
  set τ := pairedTorusHom a (f4i 0) (f4i 3) u with hτdef
  set lam : K := (u : K) ^ 2 ^ a with hlam
  have hact : ∀ c : K, τ * s * centralZ K a c * (τ * s)⁻¹ = centralZ K a (lam * c) := by
    intro c
    have hc := Subgroup.mem_centralizer_singleton_iff.1 (centralizerZ_le_centralizer ha hK c hs)
    have h1 : s * centralZ K a c * s⁻¹ = centralZ K a c := by
      rw [hc, mul_assoc, mul_inv_cancel, mul_one]
    calc τ * s * centralZ K a c * (τ * s)⁻¹ = τ * (s * centralZ K a c * s⁻¹) * τ⁻¹ := by group
      _ = τ * centralZ K a c * τ⁻¹ := by rw [h1]
      _ = centralZ K a (lam * c) := by
        rw [hτdef, ← rankOneTorusPair_left]
        exact torusPair_conj_centralZ hK u 1 c
  have hit : ∀ n : ℕ, ∀ c : K, (τ * s) ^ n * centralZ K a c * ((τ * s) ^ n)⁻¹ =
      centralZ K a (lam ^ n * c) := by
    intro n
    induction n with
    | zero => intro c; simp
    | succ n ih =>
      intro c
      have e0 : ∀ (y z : ModGL F4.tag K), y ^ (n + 1) * z * (y ^ (n + 1))⁻¹ =
          y * (y ^ n * z * (y ^ n)⁻¹) * y⁻¹ := by
        intro y z
        rw [pow_succ', mul_inv_rev]
        simp only [mul_assoc]
      rw [e0, ih, hact]
      congr 1
      ring
  have hxk : (τ * s) ^ 2 ^ k = 1 := by
    rw [← hk]
    exact pow_orderOf_eq_one _
  have h1 := hit (2 ^ k) 1
  rw [hxk, one_mul, inv_one, mul_one, mul_one] at h1
  have hlam1 : lam = 1 := by
    have := burnsideF4gF4Inv_eq_one_of_pow (l := lam) (k := k) (by
      have h2 := centralZ_injective (K := K) (a := a) h1
      exact h2.symm)
    exact this
  have hx1 : (τ * s) * centralZ K a 1 * (τ * s)⁻¹ = centralZ K a 1 := by
    rw [hact, hlam1, one_mul]
  have hΓ : τ * s ∈ F4.reeGamma K a := (Subgroup.mem_inf.1 hxP).1
  have hcomm : centralZ K a 1 * (τ * s) = (τ * s) * centralZ K a 1 :=
    (mul_inv_eq_iff_eq_mul.1 hx1).symm
  have hcent : τ * s ∈ Subgroup.centralizer ({centralZ K a 1} : Set (ModGL F4.tag K)) := by
    refine Subgroup.mem_centralizer_iff.2 fun h hh => ?_
    rw [Set.mem_singleton_iff] at hh
    rw [hh]
    exact hcomm
  have hmem : τ * s ∈ F4.reeGamma K a ⊓ Subgroup.centralizer ({centralZ K a 1} : Set (ModGL F4.tag K)) :=
    ⟨hΓ, hcent⟩
  exact (reeGamma_inf_centralizer_eq ha hK).le hmem

theorem burnsideF4gF4Inv_mem_oPPrime_of_isPGroup {E : Type} [Group E] {P Q : Subgroup E}
