theorem burnsideF4gG2TwoInv_exists_conj_mem_sylow {N : Type} [Group N] [Finite N]
    {S : Subgroup N} (hS : IsPGroup 2 S ∧ ¬ 2 ∣ S.index) {v : N} (hv : v * v = 1) :
    ∃ g : N, g⁻¹ * v * g ∈ S := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let S₀ : Sylow 2 N := hS.1.toSylow hS.2
  obtain ⟨Q, hQ⟩ :=
    (CFSG.Quasithin.H13.F431.G2Two.isPGroup_zpowers_of_sq hv).exists_le_sylow
  obtain ⟨k, hk⟩ := MulAction.exists_smul_eq N S₀ Q
  have hvQ : v ∈ (Q : Subgroup N) := hQ (Subgroup.mem_zpowers v)
  rw [← hk, Sylow.coe_subgroup_smul, Subgroup.mem_smul_pointwise_iff_exists] at hvQ
  obtain ⟨t, ht, htv⟩ := hvQ
  refine ⟨k, ?_⟩
  have : t = k⁻¹ * v * k := by
    rw [← htv]
    simp [MulAut.conj_apply]
    group
  rw [← this]
  exact ht

end Sylow


