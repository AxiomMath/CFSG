theorem burnsideF4gG2Inv_rootInv_false_iff {f : ℕ} {E : Type} [Group E]
    (chart : NativeChart .G2 2 f (⊤ : Subgroup E)) (x : E) :
    chart.RootInvolution false x ↔
      x ≠ 1 ∧ x * x = 1 ∧ ∃ c : E, c * x * c⁻¹ ∈ chart.longRoot := by
  unfold NativeChart.RootInvolution
  constructor
  · rintro ⟨-, h1, h2, -, c, -, h3⟩
    exact ⟨h1, h2, c, by simpa using h3⟩
  · rintro ⟨h1, h2, c, h3⟩
    exact ⟨Subgroup.mem_top _, h1, h2, fun h => absurd h (by decide), c, Subgroup.mem_top _,
      by simpa using h3⟩

