@[expose] noncomputable def burnsideF4g_quotEquiv {G G' : Type*} [Group G] [Group G'] (e : G ≃* G')
    (H : Subgroup G) (H' : Subgroup G') (h : H.map e.toMonoidHom = H') : G ⧸ H ≃ G' ⧸ H' :=
  Quotient.congr e.toEquiv (fun a b => by
    rw [QuotientGroup.leftRel_apply, QuotientGroup.leftRel_apply]
    show a⁻¹ * b ∈ H ↔ (e a)⁻¹ * e b ∈ H'
    rw [← h, ← map_inv, ← map_mul]
    constructor
    · intro hab
      exact ⟨_, hab, rfl⟩
    · rintro ⟨x, hx, hxe⟩
      have : x = a⁻¹ * b := e.injective (by simpa using hxe)
      rw [← this]
      exact hx)

theorem burnsideF4g_quotEquiv_mk {G G' : Type*} [Group G] [Group G'] (e : G ≃* G')
    (H : Subgroup G) (H' : Subgroup G') (h : H.map e.toMonoidHom = H') (g : G) :
    burnsideF4g_quotEquiv e H H' h (g : G ⧸ H) = ((e g : G') : G' ⧸ H') := rfl

theorem burnsideF4g_map_range {A Y Y' : Type*} [Group A] [Group Y] [Group Y'] (f : A →* Y)
    (θ : Y ≃* Y') (f' : A →* Y') (h : ∀ g, θ (f g) = f' g) :
    f.range.map θ.toMonoidHom = f'.range := by
  ext y
  constructor
  · rintro ⟨_, ⟨a, rfl⟩, rfl⟩
    exact ⟨a, (h a).symm⟩
  · rintro ⟨a, rfl⟩
    exact ⟨f a, ⟨a, rfl⟩, h a⟩

theorem burnsideF4g_cosetGeom_iso {G G' : Type*} [Group G] [Group G'] (θ : G ≃* G')
    {G₀ G₁ G₂ : Subgroup G} {G₀' G₁' G₂' : Subgroup G'}
    (h0 : G₀.map θ.toMonoidHom = G₀') (h1 : G₁.map θ.toMonoidHom = G₁')
    (h2 : G₂.map θ.toMonoidHom = G₂') :
    Nonempty (CosetGeom.graph G₀ G₁ G₂ ≃g CosetGeom.graph G₀' G₁' G₂') := by
  let θ0 : ↥G₀ ≃* ↥G₀' := (θ.subgroupMap G₀).trans (MulEquiv.subgroupCongr h0)
  have hθ0 : ∀ g : ↥G₀, ((θ0 g : ↥G₀') : G') = θ (g : G) := fun g => rfl
  have key : ∀ (K : Subgroup G) (K' : Subgroup G'), K.map θ.toMonoidHom = K' →
      (K.subgroupOf G₀).map θ0.toMonoidHom = K'.subgroupOf G₀' := by
    intro K K' hK
    ext y
    rw [Subgroup.mem_map, Subgroup.mem_subgroupOf]
    constructor
    · rintro ⟨x, hx, rfl⟩
      have hx' : (x : G) ∈ K := Subgroup.mem_subgroupOf.mp hx
      rw [← hK]
      exact ⟨(x : G), hx', hθ0 x⟩
    · intro hy
      rw [← hK] at hy
      obtain ⟨x, hx, hxy⟩ := hy
      have hyG : (y : G') ∈ G₀.map θ.toMonoidHom := by rw [h0]; exact y.2
      obtain ⟨x', hx', hx'y⟩ := hyG
      have hxx' : x' = x := θ.injective (hx'y.trans hxy.symm)
      have hxG₀ : x ∈ G₀ := hxx' ▸ hx'
      exact ⟨⟨x, hxG₀⟩, Subgroup.mem_subgroupOf.mpr hx, Subtype.ext ((hθ0 ⟨x, hxG₀⟩).trans hxy)⟩
  have m1 := key G₁ G₁' h1
  have m2 := key G₂ G₂' h2
  let e1 := burnsideF4g_quotEquiv θ0 (G₁.subgroupOf G₀) (G₁'.subgroupOf G₀') m1
  let e2 := burnsideF4g_quotEquiv θ0 (G₂.subgroupOf G₀) (G₂'.subgroupOf G₀') m2
  have step1 : ∀ (x : ↥G₀ ⧸ G₁.subgroupOf G₀) (y : ↥G₀ ⧸ G₂.subgroupOf G₀),
      (∃ g' : ↥G₀', (g' : ↥G₀' ⧸ G₁'.subgroupOf G₀') = e1 x ∧
        (g' : ↥G₀' ⧸ G₂'.subgroupOf G₀') = e2 y) ↔
      ∃ g : ↥G₀, (g : ↥G₀ ⧸ G₁.subgroupOf G₀) = x ∧ (g : ↥G₀ ⧸ G₂.subgroupOf G₀) = y := by
    intro x y
    constructor
    · rintro ⟨g', hg1, hg2⟩
      refine ⟨θ0.symm g', ?_, ?_⟩
      · apply e1.injective
        rw [burnsideF4g_quotEquiv_mk, MulEquiv.apply_symm_apply]
        exact hg1
      · apply e2.injective
        rw [burnsideF4g_quotEquiv_mk, MulEquiv.apply_symm_apply]
        exact hg2
    · rintro ⟨g, hg1, hg2⟩
      refine ⟨θ0 g, ?_, ?_⟩
      · rw [← hg1]; rfl
      · rw [← hg2]; rfl
  refine ⟨{ toEquiv := Equiv.sumCongr e1 e2, map_rel_iff' := ?_ }⟩
  intro a b
  rcases a with x | y <;> rcases b with x' | y'
  · exact iff_of_false CosetGeom.not_adj_inl_inl CosetGeom.not_adj_inl_inl
  · show (CosetGeom.graph G₀' G₁' G₂').Adj (Sum.inl (e1 x)) (Sum.inr (e2 y')) ↔
      (CosetGeom.graph G₀ G₁ G₂).Adj (Sum.inl x) (Sum.inr y')
    rw [CosetGeom.adj_inl_inr, CosetGeom.adj_inl_inr]
    exact step1 x y'
  · show (CosetGeom.graph G₀' G₁' G₂').Adj (Sum.inr (e2 y)) (Sum.inl (e1 x')) ↔
      (CosetGeom.graph G₀ G₁ G₂).Adj (Sum.inr y) (Sum.inl x')
    rw [CosetGeom.adj_inr_inl, CosetGeom.adj_inr_inl]
    exact step1 x' y
  · exact iff_of_false CosetGeom.not_adj_inr_inr CosetGeom.not_adj_inr_inr

theorem burnsideF4g_completion_graph_iso {α α' : RankTwoAmalgam.{0}} {Y Y' : Type} [Group Y]
    [Group Y'] (c : α.Completion Y) (c' : α'.Completion Y') (θ : Y ≃* Y')
    (h1 : c.φ1.range.map θ.toMonoidHom = c'.φ1.range)
    (h2 : c.φ2.range.map θ.toMonoidHom = c'.φ2.range) :
    Nonempty (c.graph ≃g c'.graph) :=
  burnsideF4g_cosetGeom_iso θ (by rw [Subgroup.map_sup, h1, h2]) h1 h2

end GraphIso

