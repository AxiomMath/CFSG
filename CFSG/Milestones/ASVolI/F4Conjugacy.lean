  set a : StatedSp 2 K := burnsideF4gSpInv_xl 1 with ha
  set b : StatedSp 2 K := burnsideF4gSpInv_xs 1 with hb
  set c : StatedSp 2 K := burnsideF4gSpInv_xl 1 * burnsideF4gSpInv_xs 1 with hc
