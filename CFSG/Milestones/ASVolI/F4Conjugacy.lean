theorem burnsideF4gU5_yam_of_ker {H : Type} [Group H]
    (θ : SU (unitaryInvolution F 2 f) 5 →* H) (hθ : Function.Surjective θ)
    (hker : θ.ker = Subgroup.center (SU (unitaryInvolution F 2 f) 5)) :
    ∃ TD : Subgroup H, CFSG.Quasithin.IsYAmalgamPair TD
