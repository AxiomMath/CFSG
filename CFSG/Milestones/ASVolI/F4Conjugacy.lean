section ChartExtract

open CFSG.ASVolI.ChF CFSG.Quasithin.H13.F431.G2


theorem burnsideF4gG2Inv_chart {f : ℕ} (hf : 1 ≤ f) {E : Type} [Group E] {M₁ M₂ : Subgroup E}
    (chart : NativeChart .G2 2 f (⊤ : Subgroup E)) (hm : chart.Matches M₁ M₂) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (_ : CharP K 2), Nat.card K = 2 ^ f ∧
      ∃ Ψ : G2Native.Parent K ≃* E,
        M₁ = (G2Native.pointParabolic K).map Ψ.toMonoidHom ∧
        M₂ = (G2Native.lineParabolic K).map Ψ.toMonoidHom ∧
        chart.longRoot = (G2Native.longRoot K).map Ψ.toMonoidHom ∧
        chart.shortRoot = (G2Native.shortRoot K).map Ψ.toMonoidHom := by
  rcases chart.coordinates with
    ⟨c, hk, marking, h1, h2, h3, h4, h5⟩ |
    ⟨hk, hp, hd, K, fK, finK, hcard, marking, h1, h2, h3, h4, h5⟩ |
    ⟨hk, -⟩ | ⟨hk, -⟩ | ⟨-, exponent, K, fK, finK, charK, scope, ⟨hk, -⟩ | ⟨hk, -⟩⟩
  · exact absurd hk (by cases c <;> decide)
  · have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    haveI : Fintype K := Fintype.ofFinite K
    haveI charK : CharP K 2 := charP_of_card_eq_prime_pow (p := 2) (f := f)
      (by rw [← Nat.card_eq_fintype_card]; exact hcard)
    let Ψ : G2Native.Parent K ≃* E := ((mk K).trans marking).trans Subgroup.topEquiv
    have hΨ : ∀ L : Subgroup (G2Native.Parent K),
        (G2Native.fullImage K marking L).map (⊤ : Subgroup E).subtype = L.map Ψ.toMonoidHom := by
      intro L
      unfold G2Native.fullImage G2Native.fullLocal
      rw [Subgroup.map_map, Subgroup.map_map]
      exact congrArg (fun φ => Subgroup.map φ L) (MonoidHom.ext fun y => rfl)
    refine ⟨K, fK, finK, charK, hcard, Ψ, ?_, ?_, ?_, ?_⟩
    · have h := hm.2.1
      rw [top_inf_eq] at h
      rw [h, h2, hΨ]
    · have h := hm.2.2
      rw [top_inf_eq] at h
      rw [h, h3, hΨ]
    · rw [h4, hΨ]
    · rw [h5, hΨ]
  · exact absurd hk (by decide)
  · exact absurd hk (by decide)
  · exact absurd hk (by decide)
  · exact absurd hk (by decide)

end ChartExtract

section Main

open CFSG.ASVolI.ChF CFSG.Quasithin.H13.F431.G2


theorem burnsideF4gG2Inv_main {f : ℕ} (hf : 2 ≤ f) {E : Type} [Group E] {M₁ M₂ : Subgroup E}
    (chart : NativeChart .G2 2 f (⊤ : Subgroup E)) (hm : chart.Matches M₁ M₂) :
    (Set.ncard (InvClasses E) = 2 ∧
      (∃! C : ConjClasses E, C ∈ InvClasses E ∧ ClassMeetsCenter (pCoreOf 2 (M₁ ⊓ M₂)) C) ∧
      (∀ element : E, element ≠ 1 → element * element = 1 →
        chart.RootInvolution false element ∨ chart.RootInvolution true element) ∧
      (∀ element : E, element ≠ 1 → element * element = 1 →
        (chart.RootInvolution false element ↔
          ∃ conjugator ∈ (⊤ : Subgroup E), conjugator * element * conjugator⁻¹ ∈
            ctr (pCoreOf 2 (M₁ ⊓ M₂)))) ∧
      (∀ element : E, ¬ (chart.RootInvolution false element ∧
        chart.RootInvolution true element))) ∧
    (∀ element ∈ ctr (oPPrime 2 M₁), element ≠ 1 →
        chart.RootInvolution false element ∧
        Subgroup.centralizer ({element} : Set E) ≤ M₁ ∧
        oPPrime 2 M₁ = oPPrime 2 (Subgroup.centralizer ({element} : Set E)) ∧
        oPPrime 2 M₁ = Subgroup.centralizer ({element} : Set E)) ∧
    (∃ element ∈ pCoreOf 2 M₂, chart.RootInvolution true element ∧
        Subgroup.centralizer ({element} : Set E) ≤ M₂) := by
  obtain ⟨K, fK, finK, charK, hcard, Ψ, hM₁, hM₂, hLong, hShort⟩ :=
    burnsideF4gG2Inv_chart (by omega) chart hm
  have hK3 : 3 ≤ Nat.card K := by
    rw [hcard]
    calc 3 ≤ 2 ^ 2 := by norm_num
      _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf
  rw [burnsideF4gG2Inv_point_eq] at hM₁
  rw [burnsideF4gG2Inv_line_eq] at hM₂
  rw [burnsideF4gG2Inv_longRoot_eq] at hLong
  rw [burnsideF4gG2Inv_shortRoot_eq] at hShort
  subst hM₁ hM₂
  have hB : pCoreOf 2 ((Cent.Pr K).map Ψ.toMonoidHom ⊓ (Cent.Pa K).map Ψ.toMonoidHom) =
      (U K).map Ψ.toMonoidHom := by
    rw [← Subgroup.map_inf_eq _ _ Ψ.toMonoidHom Ψ.injective,
      CFSG.LieType.BorelTits.pCoreOf_map_mulEquiv 2 Ψ, burnsideF4gG2Inv_pCoreOf_borel hK3]
  have hctr : ctr (pCoreOf 2 ((Cent.Pr K).map Ψ.toMonoidHom ⊓ (Cent.Pa K).map Ψ.toMonoidHom)) =
      (Xc K).map Ψ.toMonoidHom := by
    rw [hB, burnsideF4gG2Inv_ctr_map, burnsideF4gG2Inv_ctr_U]
  refine ⟨⟨burnsideF4gG2Inv_ncard_InvClasses Ψ, ?_, ?_, ?_, ?_⟩, ?_, ?_⟩
  ·
    refine ⟨ConjClasses.mk (Ψ (xc 1)), ⟨?_, ?_⟩, ?_⟩
    · rw [burnsideF4gG2Inv_InvClasses Ψ]
      exact Set.mem_insert _ _
    · refine ⟨Ψ (xc 1), ConjClasses.mem_carrier_iff_mk_eq.2 rfl, ?_⟩
      rw [hctr]
      exact ⟨xc 1, xc_mem_Xc 1, rfl⟩
    · rintro C ⟨hC, z, hz, hzc⟩
      rw [burnsideF4gG2Inv_InvClasses Ψ] at hC
      rw [hctr] at hzc
      obtain ⟨y, hy, rfl⟩ := hzc
      obtain ⟨s, rfl⟩ := mem_Xc_iff.1 hy
      have hCz : C = ConjClasses.mk (Ψ.toMonoidHom (xc s)) :=
        (ConjClasses.mem_carrier_iff_mk_eq.1 hz).symm
      rcases hC with hC | hC
      · exact hC
