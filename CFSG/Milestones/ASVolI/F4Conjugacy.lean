theorem burnsideF4gSpInv_clause2 {f : ℕ}
    (Ψ : StatedSp 2 K ≃* E) {M₁ M₂ : Subgroup E}
    (chart : NativeChart .Sp4 2 f (⊤ : Subgroup E))
    (hM₁ : M₁ = (Q2 K 0).map Ψ.toMonoidHom) (hM₂ : M₂ = (Q2 K 1).map Ψ.toMonoidHom)
    (hlong : ∀ x : E, x ∈ chart.longRoot ↔ ∃ t : K, x = Ψ (burnsideF4gSpInv_xl t))
    (hshort : ∀ x : E, x ∈ chart.shortRoot ↔ ∃ t : K, x = Ψ (burnsideF4gSpInv_xs t)) :
    Set.ncard (InvClasses E) = 3 ∧
    (∀ C ∈ InvClasses E, ClassMeetsCenter (pCoreOf 2 (M₁ ⊓ M₂)) C) ∧
    ∃ long short mixed : E,
      chart.RootInvolution false long ∧ chart.RootInvolution true short ∧
      mixed ∈ (⊤ : Subgroup E) ∧ mixed ≠ 1 ∧ mixed * mixed = 1 ∧
      (∃ conjugator ∈ (⊤ : Subgroup E), ∃ a ∈ chart.longRoot, ∃ b ∈ chart.shortRoot,
        a ≠ 1 ∧ b ≠ 1 ∧ conjugator * mixed * conjugator⁻¹ = a * b) ∧
      ¬ IsConj long short ∧ ¬ IsConj long mixed ∧ ¬ IsConj short mixed ∧
      (∀ element : E, element ≠ 1 → element * element = 1 →
        IsConj element long ∨ IsConj element short ∨ IsConj element mixed) ∧
      (∀ element : E, chart.RootInvolution false element ↔ IsConj element long) ∧
      (∀ element : E, chart.RootInvolution true element ↔ IsConj element short) ∧
      (∀ element : E, chart.C2Involution element ↔ IsConj element mixed) := by
  have hexh : ∀ x : E, x ≠ 1 → x * x = 1 → IsConj x (Ψ (burnsideF4gSpInv_xl 1)) ∨
      IsConj x (Ψ (burnsideF4gSpInv_xs 1)) ∨
      IsConj x (Ψ (burnsideF4gSpInv_xl 1 * burnsideF4gSpInv_xs 1)) := by
    intro x hx1 hx2
    obtain ⟨y, rfl⟩ := Ψ.surjective x
    have hy1 : y ≠ 1 := (burnsideF4gSpInv_ne_one_iff Ψ y).1 hx1
    have hy2 : y * y = 1 := (burnsideF4gSpInv_mul_self_iff Ψ y).1 hx2
    rcases burnsideF4gSpInv_inv_exhaust y hy1 hy2 with h | h | h
    · exact Or.inl ((burnsideF4gSpInv_isConj_equiv Ψ).2 h)
    · exact Or.inr (Or.inl ((burnsideF4gSpInv_isConj_equiv Ψ).2 h))
    · exact Or.inr (Or.inr ((burnsideF4gSpInv_isConj_equiv Ψ).2 h))
  have hl1 : Ψ (burnsideF4gSpInv_xl (1 : K)) ≠ 1 :=
    (burnsideF4gSpInv_ne_one_iff Ψ _).2 (burnsideF4gSpInv_xl_ne_one one_ne_zero)
  have hs1 : Ψ (burnsideF4gSpInv_xs (1 : K)) ≠ 1 :=
    (burnsideF4gSpInv_ne_one_iff Ψ _).2 (burnsideF4gSpInv_xs_ne_one one_ne_zero)
  have hm1 : Ψ (burnsideF4gSpInv_xl (1 : K) * burnsideF4gSpInv_xs 1) ≠ 1 := by
    rw [burnsideF4gSpInv_ne_one_iff]
    intro h
    exact burnsideF4gSpInv_not_Rk1_mixed (s := (1 : K)) (t := (1 : K)) one_ne_zero
      (by rw [h]; exact burnsideF4gSpInv_Rk1_one)
  have hl2 : Ψ (burnsideF4gSpInv_xl (1 : K)) * Ψ (burnsideF4gSpInv_xl 1) = 1 := by
    rw [← map_mul, burnsideF4gSpInv_xl_sq, map_one]
  have hs2 : Ψ (burnsideF4gSpInv_xs (1 : K)) * Ψ (burnsideF4gSpInv_xs 1) = 1 := by
    rw [← map_mul, burnsideF4gSpInv_xs_sq, map_one]
  have hm2 : Ψ (burnsideF4gSpInv_xl (1 : K) * burnsideF4gSpInv_xs 1) *
      Ψ (burnsideF4gSpInv_xl 1 * burnsideF4gSpInv_xs 1) = 1 := by
    rw [← map_mul, burnsideF4gSpInv_mixed_sq, map_one]
  have hls : ¬ IsConj (Ψ (burnsideF4gSpInv_xl (1 : K))) (Ψ (burnsideF4gSpInv_xs 1)) := fun h =>
    burnsideF4gSpInv_not_conj_xl_xs ((burnsideF4gSpInv_isConj_equiv Ψ).1 h)
  have hlm : ¬ IsConj (Ψ (burnsideF4gSpInv_xl (1 : K)))
      (Ψ (burnsideF4gSpInv_xl 1 * burnsideF4gSpInv_xs 1)) := fun h =>
    burnsideF4gSpInv_not_conj_xl_mixed ((burnsideF4gSpInv_isConj_equiv Ψ).1 h)
  have hsm : ¬ IsConj (Ψ (burnsideF4gSpInv_xs (1 : K)))
      (Ψ (burnsideF4gSpInv_xl 1 * burnsideF4gSpInv_xs 1)) := fun h =>
    burnsideF4gSpInv_not_conj_xs_mixed ((burnsideF4gSpInv_isConj_equiv Ψ).1 h)
  refine ⟨?_, ?_, Ψ (burnsideF4gSpInv_xl 1), Ψ (burnsideF4gSpInv_xs 1),
    Ψ (burnsideF4gSpInv_xl 1 * burnsideF4gSpInv_xs 1), ?_, ?_, Subgroup.mem_top _, hm1, hm2, ?_,
    hls, hlm, hsm, hexh, ?_, ?_, ?_⟩
  ·
    have hset : InvClasses E = {ConjClasses.mk (Ψ (burnsideF4gSpInv_xl 1)),
        ConjClasses.mk (Ψ (burnsideF4gSpInv_xs 1)),
        ConjClasses.mk (Ψ (burnsideF4gSpInv_xl 1 * burnsideF4gSpInv_xs 1))} := by
      ext C
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
      constructor
      · rintro ⟨x, hxC, hx1, hx2⟩
        have hCx : ConjClasses.mk x = C := ConjClasses.mem_carrier_iff_mk_eq.1 hxC
        rcases hexh x hx1 hx2 with h | h | h
        · exact Or.inl (hCx.symm.trans (ConjClasses.mk_eq_mk_iff_isConj.2 h))
        · exact Or.inr (Or.inl (hCx.symm.trans (ConjClasses.mk_eq_mk_iff_isConj.2 h)))
        · exact Or.inr (Or.inr (hCx.symm.trans (ConjClasses.mk_eq_mk_iff_isConj.2 h)))
      · rintro (rfl | rfl | rfl)
        · exact ⟨_, ConjClasses.mem_carrier_iff_mk_eq.2 rfl, hl1, hl2⟩
        · exact ⟨_, ConjClasses.mem_carrier_iff_mk_eq.2 rfl, hs1, hs2⟩
        · exact ⟨_, ConjClasses.mem_carrier_iff_mk_eq.2 rfl, hm1, hm2⟩
    rw [hset]
    refine Set.ncard_eq_three.2 ⟨_, _, _, ?_, ?_, ?_, rfl⟩
    · exact fun h => hls (ConjClasses.mk_eq_mk_iff_isConj.1 h)
    · exact fun h => hlm (ConjClasses.mk_eq_mk_iff_isConj.1 h)
    · exact fun h => hsm (ConjClasses.mk_eq_mk_iff_isConj.1 h)
  ·
    have hbor : M₁ ⊓ M₂ = (borelSubgroup 2 K).map Ψ.toMonoidHom := by
      rw [hM₁, hM₂, ← Subgroup.map_inf_eq _ _ _ Ψ.injective, burnsideF4gSpInv_Q2_inf_eq_borel]
    have hctr : ctr (pCoreOf 2 (M₁ ⊓ M₂)) = (ctr (unipotent 2 K)).map Ψ.toMonoidHom := by
      rw [hbor, burnsideF4gSpInv_pCoreOf_map, burnsideF4gSpInv_pCoreOf_borel,
        burnsideF4gSpInv_ctr_map]
    rintro C ⟨x, hxC, hx1, hx2⟩
    have hCx : ConjClasses.mk x = C := ConjClasses.mem_carrier_iff_mk_eq.1 hxC
    rcases hexh x hx1 hx2 with h | h | h
    · refine ⟨Ψ (burnsideF4gSpInv_xl 1), ?_, ?_⟩
      · exact ConjClasses.mem_carrier_iff_mk_eq.2
          ((ConjClasses.mk_eq_mk_iff_isConj.2 h).symm.trans hCx)
      · rw [hctr]
        exact ⟨_, burnsideF4gSpInv_xl_mem_ctr 1, rfl⟩
    · refine ⟨Ψ (burnsideF4gSpInv_xs 1), ?_, ?_⟩
      · exact ConjClasses.mem_carrier_iff_mk_eq.2
          ((ConjClasses.mk_eq_mk_iff_isConj.2 h).symm.trans hCx)
      · rw [hctr]
        exact ⟨_, burnsideF4gSpInv_xs_mem_ctr 1, rfl⟩
    · refine ⟨Ψ (burnsideF4gSpInv_xl 1 * burnsideF4gSpInv_xs 1), ?_, ?_⟩
      · exact ConjClasses.mem_carrier_iff_mk_eq.2
          ((ConjClasses.mk_eq_mk_iff_isConj.2 h).symm.trans hCx)
      · rw [hctr]
        exact ⟨_, (ctr (unipotent 2 K)).mul_mem (burnsideF4gSpInv_xl_mem_ctr 1)
          (burnsideF4gSpInv_xs_mem_ctr 1), rfl⟩
  ·
    rw [burnsideF4gSpInv_RootInvolution_iff]
    refine ⟨hl1, hl2, 1, ?_⟩
    simp only [Bool.false_eq_true, if_false, one_mul, inv_one, mul_one]
    exact (hlong _).2 ⟨1, rfl⟩
  ·
    rw [burnsideF4gSpInv_RootInvolution_iff]
    refine ⟨hs1, hs2, 1, ?_⟩
    simp only [if_true, one_mul, inv_one, mul_one]
    exact (hshort _).2 ⟨1, rfl⟩
  ·
    refine ⟨1, Subgroup.mem_top _, Ψ (burnsideF4gSpInv_xl 1), (hlong _).2 ⟨1, rfl⟩,
      Ψ (burnsideF4gSpInv_xs 1), (hshort _).2 ⟨1, rfl⟩, hl1, hs1, ?_⟩
    rw [one_mul, inv_one, mul_one, map_mul]
  · intro x
    rw [burnsideF4gSpInv_RootInvolution_iff, ← burnsideF4gSpInv_long_iff_E Ψ x]
    simp only [Bool.false_eq_true, if_false]
    constructor
    · rintro ⟨h1, h2, c, hc⟩
      obtain ⟨t, ht⟩ := (hlong _).1 hc
      exact ⟨h1, h2, c, t, ht⟩
    · rintro ⟨h1, h2, c, t, ht⟩
      exact ⟨h1, h2, c, (hlong _).2 ⟨t, ht⟩⟩
  · intro x
    rw [burnsideF4gSpInv_RootInvolution_iff, ← burnsideF4gSpInv_short_iff_E Ψ x]
    simp only [if_true]
    constructor
    · rintro ⟨h1, h2, c, hc⟩
      obtain ⟨t, ht⟩ := (hshort _).1 hc
      exact ⟨h1, h2, c, t, ht⟩
    · rintro ⟨h1, h2, c, t, ht⟩
      exact ⟨h1, h2, c, (hshort _).2 ⟨t, ht⟩⟩
  · intro x
    rw [burnsideF4gSpInv_C2Involution_iff, ← burnsideF4gSpInv_mixed_iff_E Ψ x]
    constructor
    · rintro ⟨h1, h2, c, a, ha, b, hb, ha1, hb1, hab⟩
      obtain ⟨s, rfl⟩ := (hlong _).1 ha
      obtain ⟨t, rfl⟩ := (hshort _).1 hb
      refine ⟨h1, h2, c, s, t, ?_, ?_, by rw [hab, map_mul]⟩
      · rintro rfl
        exact ha1 (by rw [burnsideF4gSpInv_xl_zero, map_one])
      · rintro rfl
        exact hb1 (by rw [burnsideF4gSpInv_xs_zero, map_one])
    · rintro ⟨h1, h2, c, s, t, hs, ht, h⟩
      refine ⟨h1, h2, c, Ψ (burnsideF4gSpInv_xl s), (hlong _).2 ⟨s, rfl⟩,
        Ψ (burnsideF4gSpInv_xs t), (hshort _).2 ⟨t, rfl⟩, ?_, ?_, by rw [h, map_mul]⟩
      · exact (burnsideF4gSpInv_ne_one_iff Ψ _).2 (burnsideF4gSpInv_xl_ne_one hs)
      · exact (burnsideF4gSpInv_ne_one_iff Ψ _).2 (burnsideF4gSpInv_xs_ne_one ht)

