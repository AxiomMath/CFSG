section MulVec

variable {F : Type} [Field F]

theorem burnsideF4gU5_single_mulVec {n : ℕ} (i j : Fin n) (c : F) (v : Fin n → F) (a : Fin n) :
    ((Matrix.single i j c : Matrix (Fin n) (Fin n) F).mulVec v) a =
      if a = i then c * v j else 0 := by
  simp [Matrix.mulVec, dotProduct, Matrix.single_apply]
  by_cases h : i = a
  · subst h
    simp
  · simp [h, Ne.symm h]

theorem burnsideF4gU5_rootMatrix_mulVec (σ : F ≃+* F) {n : ℕ} (i j : Fin n) (c : F)
    (v : Fin n → F) (a : Fin n) :
    ((rootMatrix σ i j c).mulVec v) a =
      v a + (if a = i then c * v j else 0) -
        (if a = Fin.rev j then σ c * v (Fin.rev i) else 0) := by
  simp only [rootMatrix, Matrix.sub_mulVec, Matrix.add_mulVec, Matrix.one_mulVec, Pi.sub_apply,
    Pi.add_apply, burnsideF4gU5_single_mulVec]

theorem burnsideF4gU5_longRootMatrix_mulVec {n : ℕ} (i : Fin n) (c : F) (v : Fin n → F)
    (a : Fin n) :
    ((longRootMatrix i c).mulVec v) a = v a + (if a = i then c * v (Fin.rev i) else 0) := by
  simp only [longRootMatrix, Matrix.add_mulVec, Matrix.one_mulVec, Pi.add_apply,
    burnsideF4gU5_single_mulVec]

end MulVec

section Stab

variable {F : Type} [Field F] (σ : F ≃+* F)

@[expose] def burnsideF4gU5_stab (k : ℕ) : Subgroup (SU σ 5) where
  carrier := {A | ∀ v : Fin 5 → F,
    ((A : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F).mulVec v ∈ burnsideF4gU5_flag F k ↔
      v ∈ burnsideF4gU5_flag F k}
  mul_mem' := by
    intro A B hA hB v
    show (((A * B : SU σ 5) : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F).mulVec v ∈ _ ↔ _
    rw [show (((A * B : SU σ 5) : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F) =
      ((A : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F) *
        ((B : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F) from rfl, ← Matrix.mulVec_mulVec]
    exact (hA _).trans (hB v)
  one_mem' := by
    intro v
    show (((1 : SU σ 5) : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F).mulVec v ∈ _ ↔ _
    rw [show (((1 : SU σ 5) : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F) = 1 from rfl,
      Matrix.one_mulVec]
  inv_mem' := by
    intro A hA v
    show (((A⁻¹ : SU σ 5) : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F).mulVec v ∈ _ ↔ _
    have h1 := hA ((((A⁻¹ : SU σ 5) : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F).mulVec v)
    rw [Matrix.mulVec_mulVec, show ((A : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F) *
      (((A⁻¹ : SU σ 5) : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F) = 1 from by
        rw [← Units.val_mul]; simp, Matrix.one_mulVec] at h1
    exact h1.symm

theorem burnsideF4gU5_UT_le_stab (k : ℕ) :
    burnsideF4gU5_UT σ ≤ burnsideF4gU5_stab σ k := by
  intro A hA v
  refine ⟨fun hv => ?_, fun hv => burnsideF4gU5_mulVec_mem_flag hA k hv⟩
  have hA' : A⁻¹ ∈ burnsideF4gU5_UT σ := (burnsideF4gU5_UT σ).inv_mem hA
  have h := burnsideF4gU5_mulVec_mem_flag hA' k hv
  rwa [Matrix.mulVec_mulVec, show (((A⁻¹ : SU σ 5) : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F) *
      ((A : GL (Fin 5) F) : Matrix (Fin 5) (Fin 5) F) = 1 from by
        rw [← Units.val_mul]; simp, Matrix.one_mulVec] at h

end Stab

