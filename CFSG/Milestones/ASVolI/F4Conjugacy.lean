theorem burnsideF4gF4TwoInv_centralZ_eq (c : K) :
    centralZ K a c = f4x K 44 c * f4x K 47 (c ^ (2 * 2 ^ a)) := by
  rw [CFSG.ComponentClassification.UnbalancedCatalog.LargeReeCatalog.f4x_44,
    CFSG.ComponentClassification.UnbalancedCatalog.LargeReeCatalog.f4x_47]
  rfl

theorem burnsideF4gF4TwoInv_commute_mul {G : Type*} [Group G] {u x y : G}
    (hx : u * x = x * u) (hy : u * y = y * u) : u * (x * y) = x * y * u := by
  rw [← mul_assoc, hx, mul_assoc, hy, mul_assoc]

theorem burnsideF4gF4TwoInv_commute_centralZ {u : ModGL F4.tag K}
    (hu : u ∈ F4.reeFixedPosUnipotent K a) (c : K) :
    u * centralZ K a c = centralZ K a c * u := by
  haveI : CharP K 2 := ‹CharP K F4.prime›
  have hu' : u ∈ posUnipotent .F4 K := (Subgroup.mem_inf.1 hu).1
  rw [burnsideF4gF4TwoInv_centralZ_eq]
  exact burnsideF4gF4TwoInv_commute_mul (f4x_central (k := 44) (Or.inl rfl) c hu')
    (f4x_central (k := 47) (Or.inr rfl) _ hu')

theorem burnsideF4gF4TwoInv_borel_commute_centralZ (hK : Nat.card K = 2 ^ (2 * a + 1))
    (hK2 : Nat.card K = 2) {b : ModGL F4.tag K} (hb : b ∈ F4.reeFixedBorel K a) (c : K) :
    b * centralZ K a c = centralZ K a c * b := by
  have hb' : b ∈ (F4.reeFixedBorel K a : Set (ModGL F4.tag K)) := hb
  rw [reeFixedBorel_eq_mul] at hb'
  obtain ⟨h, hh, x, hx, rfl⟩ := hb'
  obtain ⟨u, v, rfl⟩ := rankOne_exists_torusPair_eq hK hh
  haveI := burnsideF4gF4TwoInv_units_subsingleton hK2
  have hu : u = 1 := Subsingleton.elim _ _
  subst hu
  have h1 := torusPair_conj_centralZ hK 1 v c
  rw [Units.val_one, one_pow, one_mul] at h1
  have hT : torusPair a (1, v) * centralZ K a c = centralZ K a c * torusPair a (1, v) := by
    calc torusPair a (1, v) * centralZ K a c
        = torusPair a (1, v) * centralZ K a c * (torusPair a (1, v))⁻¹ * torusPair a (1, v) := by
          group
      _ = centralZ K a c * torusPair a (1, v) := by rw [h1]
  have hxz := burnsideF4gF4TwoInv_commute_centralZ hx c
  calc torusPair a (1, v) * x * centralZ K a c
      = torusPair a (1, v) * (x * centralZ K a c) := by rw [mul_assoc]
    _ = torusPair a (1, v) * (centralZ K a c * x) := by rw [hxz]
    _ = (torusPair a (1, v) * centralZ K a c) * x := by rw [mul_assoc]
    _ = (centralZ K a c * torusPair a (1, v)) * x := by rw [hT]
    _ = centralZ K a c * (torusPair a (1, v) * x) := by rw [mul_assoc]

theorem burnsideF4gF4TwoInv_reeParabolic_one_le (hK : Nat.card K = 2 ^ (2 * a + 1))
    (hK2 : Nat.card K = 2) (c : K) :
    ChF.ExceptionalRoots.reeParabolic K a 1 ≤ Subgroup.centralizer {centralZ K a c} := by
  rw [burnsideF4gF4Two_reeParabolic_one]
  refine sup_le (fun b hb => ?_) ?_
  · exact Subgroup.mem_centralizer_singleton_iff.2
      (burnsideF4gF4TwoInv_borel_commute_centralZ hK hK2 hb c)
  · refine Subgroup.zpowers_le.2 ?_
    refine Subgroup.mem_centralizer_singleton_iff.2 ?_
    have h : weylTwo K * centralZ K a c * (weylTwo K)⁻¹ = centralZ K a c :=
      canonicalRep_conj_centralZ (K := K) (a := a) c
    calc weylTwo K * centralZ K a c
        = weylTwo K * centralZ K a c * (weylTwo K)⁻¹ * weylTwo K := by group
      _ = centralZ K a c * weylTwo K := by rw [h]

theorem burnsideF4gF4TwoInv_zg_ctr (hK : Nat.card K = 2 ^ (2 * a + 1)) :
    zg hK ∈ ctr (Ug K a) := by
  refine Subgroup.mem_inf.2 ⟨zg_mem_Ug hK, Subgroup.mem_centralizer_iff.2 fun u hu => ?_⟩
  have hu' : (u : ModGL F4.tag K) ∈ F4.reeFixedPosUnipotent K a := Subgroup.mem_subgroupOf.1 hu
  apply Subtype.ext
