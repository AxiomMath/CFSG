theorem burnsideF4gSpInv_conj_eq_iff {G E : Type} [Group G] [Group E] (Ψ : G ≃* E) (c y z : G) :
    Ψ c * Ψ y * (Ψ c)⁻¹ = Ψ z ↔ c * y * c⁻¹ = z := by
  rw [← map_inv, ← map_mul, ← map_mul]
  exact Ψ.injective.eq_iff

theorem burnsideF4gSpInv_ne_one_iff {G E : Type} [Group G] [Group E] (Ψ : G ≃* E) (y : G) :
    Ψ y ≠ 1 ↔ y ≠ 1 := by
  rw [Ne, Ne, ← map_one Ψ, Ψ.injective.eq_iff]

theorem burnsideF4gSpInv_mul_self_iff {G E : Type} [Group G] [Group E] (Ψ : G ≃* E) (y : G) :
    Ψ y * Ψ y = 1 ↔ y * y = 1 := by
  rw [← map_mul, ← map_one Ψ, Ψ.injective.eq_iff]

