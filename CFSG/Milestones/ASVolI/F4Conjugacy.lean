theorem burnsideF4gSpInv_marking_of_chart {f : ℕ} {E : Type} [Group E] {core : Subgroup E}
    (chart : NativeChart .Sp4 2 f core) :
    ∃ marking : Marking .Sp4 2 f core,
      chart.points = (marking.parabolic false).map core.subtype ∧
      chart.lines = (marking.parabolic true).map core.subtype ∧
      chart.longRoot = (marking.root .longOne false).map core.subtype ∧
      chart.shortRoot = (marking.root .sum false).map core.subtype := by
  rcases chart.coordinates with ⟨c, hk, marking, h1, h2, h3, h4, h5⟩ | ⟨hk, _⟩ | ⟨hk, _⟩ |
    ⟨hk, _⟩ | ⟨_, _, _, _, _, _, _, ⟨hk, _⟩ | ⟨hk, _⟩⟩
  · cases c
    · exact absurd hk (by simp [classicalKind])
    · exact ⟨marking, h2, h3, by simpa using h4, by simpa using h5⟩
    · exact absurd hk (by simp [classicalKind])
    · exact absurd hk (by simp [classicalKind])
  all_goals exact absurd hk (by simp)

