theorem burnsideF4gD4_yam {K : Type} [Field K] [Finite K] (sigma : K →+* K) {f : ℕ}
    (hscope : TrialityScope K sigma 2 f) {H : Type} [Group H]
    (marking : DerivedCentralQuotient (twistedFixedGroup .D4 K sigma) ≃* H) :
    ∃ TD : Subgroup H, CFSG.Quasithin.IsYAmalgamPair TD
      ((derivedImage (twistedFixedGroup .D4 K sigma)
        (trialityParabolic K sigma 0)).map marking.toMonoidHom)
      ((derivedImage (twistedFixedGroup .D4 K sigma)
        (trialityParabolic K sigma 1)).map marking.toMonoidHom) := by
  obtain ⟨-, hf, hK, hσ⟩ := hscope
  obtain ⟨σ, rfl⟩ : ∃ σ : K ≃+* K, σ.toRingHom = sigma :=
    ⟨RingEquiv.ofBijective sigma ⟨sigma.injective, Finite.surjective_of_injective sigma.injective⟩,
      rfl⟩
  have hσ' : ∀ c, σ c = c ^ (2 ^ f) := hσ
  have hσ3 : ∀ c, σ (σ (σ c)) = c := ringEquiv_cube_apply_eq hK hσ'
  have hK3 : Nat.card K = 2 ^ (3 * f) := by rw [hK, ← pow_mul, mul_comm]
  have hCharP : CharP K 2 :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic Nat.prime_two
      (by omega) hK3
  have hchar : ringChar K = 2 := ringChar.eq K 2
  have hΓ := twistedFixedGroup_eq_graphFixedRootGroup_triality σ hσ3 (Or.inl hchar)
  obtain ⟨-, -, -, -, -, hD, hZ, -⟩ := even_triality_exact_automorphism_normal_form hf K hK σ hσ'
  obtain ⟨e, he⟩ := burnsideF4gD4_exists_derivedEquiv _ _ hD hZ
  have hY := (CFSG.Quasithin.H13.F431.D4q.Hex.d4_yamStd σ hf hK hσ').isYAmalgamPair
  have hmap : ∀ P : Subgroup (ModGL TwistTag.D4.tag K),
      ((derivedImage (twistedFixedGroup TwistTag.D4 K σ.toRingHom) P).map marking.toMonoidHom) =
        (P.subgroupOf (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)).map
          (e.symm.trans marking).toMonoidHom := by
    intro P
    have hcomp : (e.symm.trans marking).toMonoidHom.comp e.toMonoidHom = marking.toMonoidHom := by
      refine MonoidHom.ext fun q => ?_
      simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.trans_apply,
        MulEquiv.symm_apply_apply]
    rw [← burnsideF4gD4_map_derivedImage _ _ P hD e he, Subgroup.map_map, hcomp]
  have h0 := burnsideF4gD4_trialityParabolic_zero σ.toRingHom hΓ
  have h1 := burnsideF4gD4_trialityParabolic_one σ.toRingHom hΓ
  have key0 := (hmap (trialityParabolic K σ.toRingHom 0)).trans
    (congrArg (fun P : Subgroup (ModGL TwistTag.D4.tag K) =>
      (P.subgroupOf (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)).map
        (e.symm.trans marking).toMonoidHom) h0)
  have key1 := (hmap (trialityParabolic K σ.toRingHom 1)).trans
    (congrArg (fun P : Subgroup (ModGL TwistTag.D4.tag K) =>
      (P.subgroupOf (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)).map
        (e.symm.trans marking).toMonoidHom) h1)
  refine ⟨((graphFixedPosUnipotent TwistTag.D4 K σ.toRingHom).subgroupOf
    (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)).map (e.symm.trans marking).toMonoidHom, ?_⟩
  rw [key0, key1]
  exact CFSG.Quasithin.IsYAmalgamPair.map (e.symm.trans marking) hY

end Main

