variable {K : Type} [Field K] {ι : Type} [Fintype ι] [DecidableEq ι]

theorem burnsideF4gU5_image_mem_iff (B : GL ι K) (C : Set (ι → K)) (w : ι → K) :
    (B : Matrix ι ι K).mulVec w ∈ (fun v => (B : Matrix ι ι K).mulVec v) '' C ↔ w ∈ C := by
  constructor
  · rintro ⟨x, hx, hxw⟩
    have h1 := congrArg ((((B⁻¹ : GL ι K)) : Matrix ι ι K).mulVec) hxw
    rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel,
      Units.val_one, Matrix.one_mulVec, Matrix.one_mulVec] at h1
    rwa [h1] at hx
  · intro h
    exact ⟨w, h, rfl⟩

theorem burnsideF4gU5_conj_stab_iff (B A : GL ι K) (C : Set (ι → K)) :
    (∀ v : ι → K, ((B * A * B⁻¹ : GL ι K) : Matrix ι ι K).mulVec v ∈
        (fun v => (B : Matrix ι ι K).mulVec v) '' C ↔
      v ∈ (fun v => (B : Matrix ι ι K).mulVec v) '' C) ↔
    ∀ w : ι → K, (A : Matrix ι ι K).mulVec w ∈ C ↔ w ∈ C := by
  have key : ∀ w : ι → K, ((B * A * B⁻¹ : GL ι K) : Matrix ι ι K).mulVec
      ((B : Matrix ι ι K).mulVec w) = (B : Matrix ι ι K).mulVec ((A : Matrix ι ι K).mulVec w) := by
    intro w
    have hinv : ((B⁻¹ : GL ι K) : Matrix ι ι K) * (B : Matrix ι ι K) = 1 := by
      rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
    have h : ((B : Matrix ι ι K) * (A : Matrix ι ι K) * ((B⁻¹ : GL ι K) : Matrix ι ι K)) *
        (B : Matrix ι ι K) = (B : Matrix ι ι K) * (A : Matrix ι ι K) := by
      rw [Matrix.mul_assoc, hinv, Matrix.mul_one]
    rw [Units.val_mul, Units.val_mul, Matrix.mulVec_mulVec, h, ← Matrix.mulVec_mulVec]
  constructor
  · intro h w
    have := h ((B : Matrix ι ι K).mulVec w)
    rw [key, burnsideF4gU5_image_mem_iff, burnsideF4gU5_image_mem_iff] at this
    exact this
  · intro h v
    have hv : v = (B : Matrix ι ι K).mulVec ((((B⁻¹ : GL ι K)) : Matrix ι ι K).mulVec v) := by
      rw [Matrix.mulVec_mulVec, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.one_mulVec]
    rw [hv, key, burnsideF4gU5_image_mem_iff, burnsideF4gU5_image_mem_iff]
    exact h _

end Conj

