        _ = (x : ModGL Tag.G2 K) * gX rC (l ^ n * t) * (x : ModGL Tag.G2 K)⁻¹ := by rw [ih]
        _ = gX rC (l * (l ^ n * t)) := hconj _
        _ = gX rC (l ^ (n + 1) * t) := by rw [pow_succ]; ring_nf
  have hpow : (x : ModGL Tag.G2 K) ^ (2 ^ k) = 1 := by
    have h1 := pow_orderOf_eq_one x
    rw [hk] at h1
    have h2 := congrArg (fun y : C K => (y : ModGL Tag.G2 K)) h1
    simpa using h2
  have hl1 : l ^ (2 ^ k) = 1 := by
    have h1 := hiter (2 ^ k) 1
    rw [hpow] at h1
    simp only [one_mul, inv_one, mul_one] at h1
    exact (pinnedX_injective Tag.G2 K rC h1).symm
  have hl2 : l = 1 := by
    have h3 : (l - 1) ^ (2 ^ k) = 0 := by
      rw [sub_pow_char_pow, one_pow, hl1, sub_self]
    exact sub_eq_zero.1 ((pow_eq_zero_iff (pow_ne_zero _ two_ne_zero)).1 h3)
  have h4 := hconj s
  rw [hl2, one_mul] at h4
  exact Subtype.ext (by
    show (x : ModGL Tag.G2 K) * gX rC s = gX rC s * (x : ModGL Tag.G2 K)
    exact mul_inv_eq_iff_eq_mul.1 h4)

theorem burnsideF4gG2Inv_oPPrime_le_centralizer :
    ChF.oPPrime 2 (Cent.Pr K) ≤ Subgroup.centralizer (Xc K : Set (C K)) := by
  refine (Subgroup.closure_le _).2 ?_
  rintro x ⟨hx, k, hk⟩
  rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
  rintro _ ⟨s, rfl⟩
  exact (burnsideF4gG2Inv_two_elt_commutes hx hk s).symm

theorem burnsideF4gG2Inv_U_le_oPPrime : U K ≤ ChF.oPPrime 2 (Cent.Pr K) := by
  intro g hg
  obtain ⟨k, hk⟩ := (IsPGroup.iff_orderOf.1 Cent.isSylowTwoOf_U_top.2.1) ⟨g, hg⟩
  exact burnsideF4gG2Inv_mem_oPPrime (burnsideF4gG2Inv_U_le_Pr hg) (k := k) (by simpa using hk)

theorem burnsideF4gG2Inv_ctr_oPPrime_le {f : ℕ} (hK : Nat.card K = 2 ^ f) (hf : 2 ≤ f) :
    ChF.ctr (ChF.oPPrime 2 (Cent.Pr K)) ≤ Xc K := by
  intro z hz
  obtain ⟨hzD, hzC⟩ := hz
  have hzP : (z : ModGL Tag.G2 K) ∈ parabolicSubgroup Tag.G2 K {i1} :=
    Cent.mem_Pr_iff.1 (burnsideF4gG2Inv_oPPrime_le _ hzD)
  have hzQ : (z : ModGL Tag.G2 K) ∈
      Subgroup.centralizer (parabolicRadical Tag.G2 K {i1} : Set (ModGL Tag.G2 K)) := by
    rw [Subgroup.mem_centralizer_iff]
    intro q hq
    have hqU : q ∈ posUnipotent Tag.G2 K := parabolicRadical_le_posUnipotent {i1} hq
    have hqA : q ∈ adjointGroup Tag.G2 K := borelGroup_le_adjointGroup' (Subgroup.mem_sup_right hqU)
    have hq' : (⟨q, hqA⟩ : C K) ∈ U K := hqU
    have := Subgroup.mem_centralizer_iff.1 hzC ⟨q, hqA⟩
      (burnsideF4gG2Inv_U_le_oPPrime hq')
    exact congrArg Subtype.val this
  have hQ := (QuasithinUnique.Vol2Native.L239.Lie.G2.parabolicFacts_one hK hf).selfCentralizing
    ⟨hzP, hzQ⟩
  obtain ⟨t, ht⟩ := CFSG.Quasithin.H13.Sec53F.G2.centerQ1 hQ hzQ
  exact ⟨t, Subtype.ext ht.symm⟩

@[expose] def burnsideF4gG2Inv_nC (K : Type) [Field K] (i : Fin Tag.G2.rank) (t : Kˣ) : C K :=
  ⟨weylElt Tag.G2 K i t, weylElt_mem_adjointGroup i t⟩

theorem burnsideF4gG2Inv_nC_mem_Pr (t : Kˣ) : burnsideF4gG2Inv_nC K i1 t ∈ Cent.Pr K := by
  rw [Cent.mem_Pr_iff]
  show weylElt Tag.G2 K i1 t ∈ parabolicSubgroup Tag.G2 K {i1}
  rw [weylElt_eq_torusElt_mul_weylElt_one]
  exact mul_mem (borelGroup_le_parabolicSubgroup _
    (Subgroup.mem_sup_left (torusElt_mem_torusGroup i1 t)))
    (weylElt_mem_parabolicSubgroup (Set.mem_singleton i1))

theorem burnsideF4gG2Inv_nC_sq (i : Fin Tag.G2.rank) (t : Kˣ) :
    burnsideF4gG2Inv_nC K i t * burnsideF4gG2Inv_nC K i t = 1 := by
  apply Subtype.ext
  show weylElt Tag.G2 K i t * weylElt Tag.G2 K i t = 1
  have h : (weylElt Tag.G2 K i t)⁻¹ = weylElt Tag.G2 K i t := by
    rw [weylElt_inv]
    congr 1
    exact Units.ext (by simp [CharTwo.neg_eq])
  calc weylElt Tag.G2 K i t * weylElt Tag.G2 K i t
      = weylElt Tag.G2 K i t * (weylElt Tag.G2 K i t)⁻¹ := by rw [h]
    _ = 1 := mul_inv_cancel _

theorem burnsideF4gG2Inv_nC_mem (t : Kˣ) :
    burnsideF4gG2Inv_nC K i1 t ∈ ChF.oPPrime 2 (Cent.Pr K) := by
  have hord : orderOf (burnsideF4gG2Inv_nC K i1 t) ∣ 2 ^ 1 := by
    rw [pow_one]
    exact orderOf_dvd_of_pow_eq_one (by rw [sq]; exact burnsideF4gG2Inv_nC_sq i1 t)
  obtain ⟨m, -, hm⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hord
  exact burnsideF4gG2Inv_mem_oPPrime (burnsideF4gG2Inv_nC_mem_Pr t) hm

theorem burnsideF4gG2Inv_torus_i1_mem (t : Kˣ) :
    (⟨torusElt Tag.G2 K i1 t, torusElt_mem_adjointGroup i1 t⟩ : C K) ∈
      ChF.oPPrime 2 (Cent.Pr K) := by
  have h : (⟨torusElt Tag.G2 K i1 t, torusElt_mem_adjointGroup i1 t⟩ : C K) =
      burnsideF4gG2Inv_nC K i1 t * burnsideF4gG2Inv_nC K i1 (-1) := Subtype.ext rfl
  rw [h]
  exact mul_mem (burnsideF4gG2Inv_nC_mem t) (burnsideF4gG2Inv_nC_mem (-1))

theorem burnsideF4gG2Inv_Pr_le_sup :
    Cent.Pr K ≤ ChF.oPPrime 2 (Cent.Pr K) ⊔ torus (τ := Tag.G2) K i0 := by
  intro g hg
  have hgm : (g : ModGL Tag.G2 K) ∈ parabolicSubgroup Tag.G2 K {i1} := Cent.mem_Pr_iff.1 hg
  have key : parabolicSubgroup Tag.G2 K {i1} ≤
      (ChF.oPPrime 2 (Cent.Pr K) ⊔ torus (τ := Tag.G2) K i0).map
        (adjointGroup Tag.G2 K).subtype := by
    refine sup_le (sup_le ?_ ?_) ((Subgroup.closure_le _).2 ?_)
    · refine (Subgroup.closure_le _).2 ?_
      rintro _ ⟨⟨i, t⟩, rfl⟩
      rcases fin_two_cases i with rfl | rfl
      · exact ⟨torusElement Tag.G2 K i0 t, Subgroup.mem_sup_right ⟨t, rfl⟩, rfl⟩
      · exact ⟨⟨torusElt Tag.G2 K i1 t, torusElt_mem_adjointGroup i1 t⟩,
          Subgroup.mem_sup_left (burnsideF4gG2Inv_torus_i1_mem t), rfl⟩
    · intro y hy
      have hyA : y ∈ adjointGroup Tag.G2 K :=
        borelGroup_le_adjointGroup' (Subgroup.mem_sup_right hy)
      exact ⟨⟨y, hyA⟩, Subgroup.mem_sup_left (burnsideF4gG2Inv_U_le_oPPrime hy), rfl⟩
    · rintro _ ⟨j, hj, rfl⟩
      rw [Set.mem_singleton_iff] at hj
      subst hj
      exact ⟨burnsideF4gG2Inv_nC K i1 1, Subgroup.mem_sup_left (burnsideF4gG2Inv_nC_mem 1), rfl⟩
  obtain ⟨j, hj, hjg⟩ := key hgm
  have : j = g := Subtype.ext hjg
  exact this ▸ hj

theorem burnsideF4gG2Inv_Pr_le_normalizer :
    Cent.Pr K ≤ Subgroup.normalizer (ChF.oPPrime 2 (Cent.Pr K) : Set (C K)) := by
  intro p hp
  rw [Subgroup.mem_normalizer_iff]
  intro h
  constructor
  · intro hh
    exact burnsideF4gG2Inv_oPPrime_conj _ hp hh
  · intro hh
    have := burnsideF4gG2Inv_oPPrime_conj _ (inv_mem hp) hh
    have e : p⁻¹ * (p * h * p⁻¹) * p⁻¹⁻¹ = h := by group
    rwa [e] at this

theorem burnsideF4gG2Inv_conj_xc (τ : Kˣ) (s : K) :
    torusHom K i0 τ * xc s * (torusHom K i0 τ)⁻¹ = xc ((τ : K) * s) := by
  apply Subtype.ext
  show torusElt Tag.G2 K i0 τ * gX rC s * (torusElt Tag.G2 K i0 τ)⁻¹ = gX rC ((τ : K) * s)
  rw [CFSG.Quasithin.H13.Sec53F.G2.conj_torus i0 CFSG.Quasithin.H13.Sec53F.G2.isRoot_rC τ s,
    show (∑ j, Tag.G2.cartan i0 j * rC j) = 1 by decide, zpow_one]

theorem burnsideF4gG2Inv_centralizer_le {s : K} (hs : s ≠ 0) :
    Subgroup.centralizer ({xc s} : Set (C K)) ≤ ChF.oPPrime 2 (Cent.Pr K) := by
  intro g hg
  have hgP : g ∈ Cent.Pr K := Cent.cz hs hg
  have hsup := burnsideF4gG2Inv_Pr_le_sup hgP
  have hTa : torus (τ := Tag.G2) K i0 ≤
      Subgroup.normalizer (ChF.oPPrime 2 (Cent.Pr K) : Set (C K)) := by
    rintro _ ⟨τ, rfl⟩
    refine burnsideF4gG2Inv_Pr_le_normalizer ?_
    rw [Cent.mem_Pr_iff]
    show torusElt Tag.G2 K i0 τ ∈ parabolicSubgroup Tag.G2 K {i1}
    exact borelGroup_le_parabolicSubgroup _
      (Subgroup.mem_sup_left (torusElt_mem_torusGroup i0 τ))
  rw [← SetLike.mem_coe, Subgroup.coe_mul_of_right_le_normalizer_left _ _ hTa] at hsup
  obtain ⟨d, hd, a, ha, rfl⟩ := hsup
  obtain ⟨τ, rfl⟩ := ha
  have hcomm : ∀ s' : K, xc s' * d = d * xc s' := fun s' =>
    Subgroup.mem_centralizer_iff.1 (burnsideF4gG2Inv_oPPrime_le_centralizer hd) (xc s')
      (xc_mem_Xc s')
  have hg' : (d * torusHom K i0 τ) * xc s = xc s * (d * torusHom K i0 τ) :=
    Subgroup.mem_centralizer_singleton_iff.1 hg
  have hconj := burnsideF4gG2Inv_conj_xc (K := K) τ s
  have h1 : torusHom K i0 τ * xc s = xc ((τ : K) * s) * torusHom K i0 τ := by
    rw [← hconj]; group
  have h2 : xc s * (d * torusHom K i0 τ) = xc ((τ : K) * s) * (d * torusHom K i0 τ) := by
    calc xc s * (d * torusHom K i0 τ) = (d * torusHom K i0 τ) * xc s := hg'.symm
      _ = d * (torusHom K i0 τ * xc s) := by rw [mul_assoc]
      _ = d * (xc ((τ : K) * s) * torusHom K i0 τ) := by rw [h1]
      _ = (d * xc ((τ : K) * s)) * torusHom K i0 τ := by rw [mul_assoc]
      _ = (xc ((τ : K) * s) * d) * torusHom K i0 τ := by rw [← hcomm]
      _ = xc ((τ : K) * s) * (d * torusHom K i0 τ) := by rw [mul_assoc]
  have h3 : xc s = xc ((τ : K) * s) := mul_right_cancel h2
  have h4 : s = (τ : K) * s := xc_injective h3
  have h5 : (τ : K) = 1 := by
    have : ((τ : K) - 1) * s = 0 := by linear_combination -h4
    rcases mul_eq_zero.1 this with h | h
    · exact sub_eq_zero.1 h
    · exact absurd h hs
  have h6 : τ = 1 := Units.ext h5
  show d * torusHom K i0 τ ∈ ChF.oPPrime 2 (Cent.Pr K)
  rw [h6, map_one, mul_one]
  exact hd

theorem burnsideF4gG2Inv_oPPrime_eq_centralizer {s : K} (hs : s ≠ 0) :
    ChF.oPPrime 2 (Cent.Pr K) = Subgroup.centralizer ({xc s} : Set (C K)) := by
  refine le_antisymm (fun x hx => ?_) (burnsideF4gG2Inv_centralizer_le hs)
  rw [Subgroup.mem_centralizer_singleton_iff]
  exact (Subgroup.mem_centralizer_iff.1 (burnsideF4gG2Inv_oPPrime_le_centralizer hx) (xc s)
    (xc_mem_Xc s)).symm

theorem burnsideF4gG2Inv_pCoreOf_Pa (hK : 3 ≤ Nat.card K) : pCoreOf 2 (Cent.Pa K) = Q2 K := by
  have h1 := Q_false_eq (K := K) hK
  have h2 : CFSG.Quasithin.H13.F431.BN.Q (GH74.GLS.Stage4.Hex.g2ModelSystem K hK) false =
      (pCoreOf 2 (Cent.Pa K)).map (mk K).toMonoidHom := by
    unfold CFSG.Quasithin.H13.F431.BN.Q
    rw [CFSG.Quasithin.H13.F431.BN.P_false, ← map_Pmin_zero hK]
    exact CFSG.LieType.BorelTits.pCoreOf_map_mulEquiv 2 (mk K) _
  exact Subgroup.map_injective (mk K).injective (h2.symm.trans h1)

theorem burnsideF4gG2Inv_conj_mem {E : Type} [Group E] (Ψ : C K ≃* E) {y z : C K}
    {X : Subgroup (C K)} (hz : z ∈ X) (h : IsConj z y) :
    ∃ c : E, c * Ψ y * c⁻¹ ∈ X.map Ψ.toMonoidHom := by
  obtain ⟨c, hc⟩ := isConj_iff.1 h
  refine ⟨Ψ c⁻¹, z, hz, ?_⟩
  have e : c⁻¹ * y * c⁻¹⁻¹ = z := by rw [← hc]; group
  rw [MulEquiv.coe_toMonoidHom, ← e]
  simp

theorem burnsideF4gG2Inv_isConj_of_mem {E : Type} [Group E] (Ψ : C K ≃* E) {y : C K}
    {X : Subgroup (C K)} (c : E) (h : c * Ψ y * c⁻¹ ∈ X.map Ψ.toMonoidHom) :
    ∃ z ∈ X, IsConj z y := by
  obtain ⟨z, hz, hzc⟩ := h
  obtain ⟨c', rfl⟩ := Ψ.surjective c
  refine ⟨z, hz, isConj_iff.2 ⟨c'⁻¹, ?_⟩⟩
  apply Ψ.injective
  have : Ψ z = Ψ c' * Ψ y * (Ψ c')⁻¹ := by simpa using hzc
  rw [map_mul, map_mul, map_inv, this]
  group

