theorem burnsideF4gSpInv_scalar_eq_one [CharP K 2] {g : GL (Fin 2 ⊕ Fin 2) K}
    (hs : g ∈ StatedScalars (Fin 2 ⊕ Fin 2) K) (hg : g ∈ StatedSp 2 K) : g = 1 := by
  have h2 : (2 : K) = 0 := CharTwo.two_eq_zero
  obtain ⟨c, rfl⟩ := hs
  have hc : c ^ 2 = 1 := (CFSG.Open.StatedAPI.scalar_mem_statedSp_iff (by norm_num) c).1 hg
  have hc' : (c : K) ^ 2 = 1 := by
    have := congrArg (fun u : Kˣ => (u : K)) hc
    simpa using this
  have : ((c : K) - 1) ^ 2 = 0 := by linear_combination hc' + (1 - (c : K)) * h2
  have h1 : (c : K) = 1 := sub_eq_zero.1 (pow_eq_zero_iff two_ne_zero |>.1 this)
  have hc1 : c = 1 := Units.ext h1
  rw [hc1, map_one]

