      have := congrArg u33PresHom (hi'.trans rfl ▸ ha)
      simpa only [map_mul, u33Tel_hom, u33PresHom_genPG, ← hi'] using this)
    (by
      have := congrArg u33PresHom (hi'.trans rfl ▸ hb)
      simpa only [map_mul, u33Tel_hom, u33PresHom_genPG, ← hi'] using this)
    (by
      have := congrArg u33PresHom (hi'.trans rfl ▸ hs)
      simpa only [map_mul, u33Tel_hom, u33PresHom_genPG, ← hi'] using this)
    (by
