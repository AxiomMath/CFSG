      exact ⟨c, hc ▸ F.z_ctr⟩
    · rintro ⟨c, hc⟩
      have hxw : IsConj x (c * x * c⁻¹) := isConj_iff.2 ⟨c, rfl⟩
      have hw1 : c * x * c⁻¹ ≠ 1 := fun h => hx1 (burnsideF4gD4Inv_eq_one_of_isConj hxw h)
      exact (F.ctr_conj _ hc hw1).trans hxw.symm
