      exact Subgroup.one_mem _)

theorem burnsideF4gG2Two_smallToFull_mk (hK : Nat.card K = 2) (d : G2Native.Derived K) :
    burnsideF4gG2Two_smallToFull hK (d : G2Native.SmallModel K) =
      ((G2Native.derivedInclusion K d : G2Native.Parent K) : G2Native.FullModel K) := rfl

theorem burnsideF4gG2Two_smallToFull_mem (hK : Nat.card K = 2) (L : Subgroup (G2Native.Parent K))
    (s : G2Native.SmallModel K) :
    burnsideF4gG2Two_smallToFull hK s ∈ G2Native.fullLocal K L ↔
      s ∈ G2Native.smallLocal K L := by
  have hP : Subgroup.center (G2Native.Parent K) = ⊥ := center_adjointGroup_eq_bot
  have hD := burnsideF4gG2Two_center_derived hK
  induction s using QuotientGroup.induction_on with
  | H d =>
    rw [burnsideF4gG2Two_smallToFull_mk]
    unfold G2Native.fullLocal G2Native.smallLocal G2Native.derivedLocal
    constructor
    · rintro ⟨p, hp, hpd⟩
      rw [QuotientGroup.mk'_apply] at hpd
      have h1 := QuotientGroup.eq.1 hpd
      rw [hP, Subgroup.mem_bot] at h1
      have h2 : p = G2Native.derivedInclusion K d := by
        have := congrArg (fun z => p * z) h1
        simpa using this.symm
      refine ⟨d, ?_, rfl⟩
      show G2Native.derivedInclusion K d ∈ L
      rw [← h2]
      exact hp
    · rintro ⟨d', hd', hd'd⟩
      rw [QuotientGroup.mk'_apply] at hd'd
      have h1 := QuotientGroup.eq.1 hd'd
      rw [hD, Subgroup.mem_bot] at h1
      have h2 : d' = d := by
        have := congrArg (fun z => d' * z) h1
        simpa using this.symm
      refine ⟨G2Native.derivedInclusion K d, ?_, rfl⟩
      rw [← h2]
      exact hd'

theorem burnsideF4gG2Two_smallToFull_cover (hK : Nat.card K = 2) (q : G2Native.FullModel K) :
