  have h2 : (X.map θ.toMonoidHom).subtype.comp e.toMonoidHom = θ.toMonoidHom.comp X.subtype := by
    ext x
    rfl
  unfold pCoreOf
  rw [← h1, Subgroup.map_map, h2, ← Subgroup.map_map]

end G2General




