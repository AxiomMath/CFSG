section InvAbstract

open CFSG.ASVolI.ChF

structure burnsideF4gU4Inv_Data {E : Type} [Group E] (M₁ M₂ L S : Subgroup E) : Prop where
  sq_long : ∀ x ∈ L, x * x = 1
  sq_short : ∀ x ∈ S, x * x = 1
  long_ne : ∃ z ∈ L, z ≠ 1
  short_ne : ∃ t ∈ S, t ≠ 1
  cases : ∀ x : E, x ≠ 1 → x * x = 1 → (∃ c : E, c * x * c⁻¹ ∈ L) ∨ (∃ c : E, c * x * c⁻¹ ∈ S)
  conj_long : ∀ z ∈ L, z ≠ 1 → ∀ z' ∈ L, z' ≠ 1 → IsConj z z'
  conj_short : ∀ t ∈ S, t ≠ 1 → ∀ t' ∈ S, t' ≠ 1 → IsConj t t'
  not_conj : ∀ z ∈ L, z ≠ 1 → ∀ t ∈ S, t ≠ 1 → ¬ IsConj z t
  ctr_pCore : ctr (pCoreOf 2 (M₁ ⊓ M₂)) = L
  ctr_oPPrime : ctr (oPPrime 2 M₁) ≤ L
  centralizer_long : ∀ z ∈ L, z ≠ 1 → Subgroup.centralizer ({z} : Set E) ≤ M₁
  short_pCore : ∃ t ∈ S, t ≠ 1 ∧ t ∈ pCoreOf 2 M₂ ∧ Subgroup.centralizer ({t} : Set E) ≤ M₂

variable {E : Type} [Group E] {M₁ M₂ L S : Subgroup E}

theorem burnsideF4gU4Inv_conj_sq {x y : E} (hxy : IsConj x y) (hx : x * x = 1) : y * y = 1 := by
  obtain ⟨c, hc⟩ := isConj_iff.mp hxy
  rw [← hc]
  have : c * x * c⁻¹ * (c * x * c⁻¹) = c * (x * x) * c⁻¹ := by group
  rw [this, hx]
  group

theorem burnsideF4gU4Inv_ncard (D : burnsideF4gU4Inv_Data M₁ M₂ L S) :
    Set.ncard (InvClasses E) = 2 := by
  obtain ⟨z₁, hz₁, hz₁1⟩ := D.long_ne
  obtain ⟨t₁, ht₁, ht₁1⟩ := D.short_ne
  have hne : ConjClasses.mk z₁ ≠ ConjClasses.mk t₁ := fun e =>
    D.not_conj z₁ hz₁ hz₁1 t₁ ht₁ ht₁1 (ConjClasses.mk_eq_mk_iff_isConj.mp e)
  have hset : InvClasses E = {ConjClasses.mk z₁, ConjClasses.mk t₁} := by
    ext C
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨x, hxC, hx1, hx2⟩
      rw [← ConjClasses.mem_carrier_iff_mk_eq.mp hxC]
      rcases D.cases x hx1 hx2 with ⟨c, hc⟩ | ⟨c, hc⟩
      · left
        have hcx : c * x * c⁻¹ ≠ 1 := by
          intro e
          apply hx1
          have := congrArg (fun y => c⁻¹ * y * c) e
          simpa [mul_assoc] using this
        have h1 := D.conj_long _ hc hcx z₁ hz₁ hz₁1
        have h2 : IsConj x (c * x * c⁻¹) := isConj_iff.mpr ⟨c, rfl⟩
        exact ConjClasses.mk_eq_mk_iff_isConj.mpr (h2.trans h1)
      · right
        have hcx : c * x * c⁻¹ ≠ 1 := by
          intro e
          apply hx1
          have := congrArg (fun y => c⁻¹ * y * c) e
          simpa [mul_assoc] using this
        have h1 := D.conj_short _ hc hcx t₁ ht₁ ht₁1
        have h2 : IsConj x (c * x * c⁻¹) := isConj_iff.mpr ⟨c, rfl⟩
        exact ConjClasses.mk_eq_mk_iff_isConj.mpr (h2.trans h1)
    · rintro (rfl | rfl)
      · exact ⟨z₁, ConjClasses.mem_carrier_iff_mk_eq.mpr rfl, hz₁1, D.sq_long z₁ hz₁⟩
      · exact ⟨t₁, ConjClasses.mem_carrier_iff_mk_eq.mpr rfl, ht₁1, D.sq_short t₁ ht₁⟩
  rw [hset]
  exact Set.ncard_pair hne

theorem burnsideF4gU4Inv_unique_class (D : burnsideF4gU4Inv_Data M₁ M₂ L S) :
    ∃! C : ConjClasses E, C ∈ InvClasses E ∧ ClassMeetsCenter (pCoreOf 2 (M₁ ⊓ M₂)) C := by
  obtain ⟨z₁, hz₁, hz₁1⟩ := D.long_ne
  refine ⟨ConjClasses.mk z₁, ⟨⟨z₁, ConjClasses.mem_carrier_iff_mk_eq.mpr rfl, hz₁1,
    D.sq_long z₁ hz₁⟩, ⟨z₁, ConjClasses.mem_carrier_iff_mk_eq.mpr rfl, D.ctr_pCore ▸ hz₁⟩⟩, ?_⟩
  rintro C ⟨⟨x, hxC, hx1, hx2⟩, ⟨z, hzC, hzc⟩⟩
  rw [D.ctr_pCore] at hzc
  have hxz : IsConj x z := by
    have := ConjClasses.mem_carrier_iff_mk_eq.mp hxC
    have h2 := ConjClasses.mem_carrier_iff_mk_eq.mp hzC
    exact ConjClasses.mk_eq_mk_iff_isConj.mp (this.trans h2.symm)
  have hz1 : z ≠ 1 := by
    rintro rfl
    exact hx1 (isConj_one_left.mp hxz)
  rw [← ConjClasses.mem_carrier_iff_mk_eq.mp hzC]
  exact (ConjClasses.mk_eq_mk_iff_isConj.mpr (D.conj_long z hzc hz1 z₁ hz₁ hz₁1)).symm.symm

theorem burnsideF4gU4Inv_not_both (D : burnsideF4gU4Inv_Data M₁ M₂ L S) {x : E} (hx1 : x ≠ 1)
    (hL : ∃ c : E, c * x * c⁻¹ ∈ L) (hS : ∃ c : E, c * x * c⁻¹ ∈ S) : False := by
  obtain ⟨c, hc⟩ := hL
  obtain ⟨d, hd⟩ := hS
  have key : ∀ e : E, e * x * e⁻¹ ≠ 1 := by
    intro e he
    apply hx1
    have := congrArg (fun y => e⁻¹ * y * e) he
    simpa [mul_assoc] using this
  have h1 : IsConj (c * x * c⁻¹) (d * x * d⁻¹) := by
    refine isConj_iff.mpr ⟨d * c⁻¹, ?_⟩
    group
  exact D.not_conj _ hc (key c) _ hd (key d) h1

theorem burnsideF4gU4Inv_oPPrime_eq {z : E} (hz : z ∈ ctr (oPPrime 2 M₁))
    (hC : Subgroup.centralizer ({z} : Set E) ≤ M₁) :
    oPPrime 2 M₁ = oPPrime 2 (Subgroup.centralizer ({z} : Set E)) := by
  apply le_antisymm
  · unfold oPPrime
    refine (Subgroup.closure_le _).mpr ?_
    rintro x ⟨hxM, k, hk⟩
    refine Subgroup.subset_closure ⟨?_, k, hk⟩
    rw [Subgroup.mem_centralizer_singleton_iff]
    have hxO : x ∈ oPPrime 2 M₁ := Subgroup.subset_closure ⟨hxM, k, hk⟩
    exact (Subgroup.mem_centralizer_iff.mp hz.2 x hxO)
  · unfold oPPrime
    refine (Subgroup.closure_le _).mpr ?_
    rintro x ⟨hxC, k, hk⟩
    exact Subgroup.subset_closure ⟨hC hxC, k, hk⟩

end InvAbstract

section InvMap

open CFSG.ASVolI.ChF CFSG.Quasithin.H13.U4Par

variable {Y E : Type} [Group Y] [Group E]

theorem burnsideF4gU4Inv_oPPrime_map {ψ : Y →* E} (hψ : Function.Injective ψ) (X : Subgroup Y) :
    oPPrime 2 (X.map ψ) = (oPPrime 2 X).map ψ := by
  unfold oPPrime
  rw [MonoidHom.map_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨⟨x, hx, rfl⟩, k, hk⟩
    exact ⟨x, ⟨hx, k, by rwa [orderOf_injective ψ hψ x] at hk⟩, rfl⟩
  · rintro ⟨x, ⟨hx, k, hk⟩, rfl⟩
    exact ⟨⟨x, hx, rfl⟩, k, by rwa [orderOf_injective ψ hψ x]⟩

theorem burnsideF4gU4Inv_isConj_equiv (Ψ : Y ≃* E) {a b : Y} :
    IsConj (Ψ a) (Ψ b) ↔ IsConj a b := by
  constructor
  · intro h
    have := Ψ.symm.toMonoidHom.map_isConj h
    simpa using this
  · exact fun h => Ψ.toMonoidHom.map_isConj h

theorem burnsideF4gU4Inv_Data_map (Ψ : Y ≃* E) {P P₂ L S : Subgroup Y}
    (D : burnsideF4gU4Inv_Data P P₂ L S) :
    burnsideF4gU4Inv_Data (P.map Ψ.toMonoidHom) (P₂.map Ψ.toMonoidHom) (L.map Ψ.toMonoidHom)
      (S.map Ψ.toMonoidHom) where
  sq_long := by
    rintro _ ⟨y, hy, rfl⟩
    rw [← map_mul, D.sq_long y hy, map_one]
  sq_short := by
    rintro _ ⟨y, hy, rfl⟩
    rw [← map_mul, D.sq_short y hy, map_one]
  long_ne := by
    obtain ⟨z, hz, hz1⟩ := D.long_ne
    exact ⟨Ψ z, ⟨z, hz, rfl⟩, fun e => hz1 (Ψ.injective (by simpa using e))⟩
  short_ne := by
    obtain ⟨z, hz, hz1⟩ := D.short_ne
    exact ⟨Ψ z, ⟨z, hz, rfl⟩, fun e => hz1 (Ψ.injective (by simpa using e))⟩
  cases := by
    intro x hx1 hx2
    obtain ⟨y, rfl⟩ := Ψ.surjective x
    have hy1 : y ≠ 1 := fun e => hx1 (by rw [e, map_one])
    have hy2 : y * y = 1 := Ψ.injective (by rw [map_mul, hx2, map_one])
    rcases D.cases y hy1 hy2 with ⟨c, hc⟩ | ⟨c, hc⟩
    · left
      exact ⟨Ψ c, ⟨c * y * c⁻¹, hc, by simp⟩⟩
    · right
      exact ⟨Ψ c, ⟨c * y * c⁻¹, hc, by simp⟩⟩
  conj_long := by
    rintro _ ⟨a, ha, rfl⟩ h1 _ ⟨b, hb, rfl⟩ h2
    have ha1 : a ≠ 1 := fun e => h1 (by rw [e, map_one])
    have hb1 : b ≠ 1 := fun e => h2 (by rw [e, map_one])
    exact (burnsideF4gU4Inv_isConj_equiv Ψ).mpr (D.conj_long a ha ha1 b hb hb1)
  conj_short := by
    rintro _ ⟨a, ha, rfl⟩ h1 _ ⟨b, hb, rfl⟩ h2
    have ha1 : a ≠ 1 := fun e => h1 (by rw [e, map_one])
    have hb1 : b ≠ 1 := fun e => h2 (by rw [e, map_one])
    exact (burnsideF4gU4Inv_isConj_equiv Ψ).mpr (D.conj_short a ha ha1 b hb hb1)
  not_conj := by
    rintro _ ⟨a, ha, rfl⟩ h1 _ ⟨b, hb, rfl⟩ h2
    have ha1 : a ≠ 1 := fun e => h1 (by rw [e, map_one])
    have hb1 : b ≠ 1 := fun e => h2 (by rw [e, map_one])
    exact fun hc => D.not_conj a ha ha1 b hb hb1 ((burnsideF4gU4Inv_isConj_equiv Ψ).mp hc)
  ctr_pCore := by
    rw [← Subgroup.map_inf P P₂ Ψ.toMonoidHom Ψ.injective,
      pCoreOf_map_of_inj (ψ := Ψ.toMonoidHom) Ψ.injective]
    exact (centerOf_map_of_inj (ψ := Ψ.toMonoidHom) Ψ.injective _).trans
      (by rw [← D.ctr_pCore]; rfl)
  ctr_oPPrime := by
    rw [burnsideF4gU4Inv_oPPrime_map Ψ.injective]
    intro z hz
    have hz' : z ∈ Quasithin.centerOf ((oPPrime 2 P).map Ψ.toMonoidHom) := hz
    rw [centerOf_map_of_inj (ψ := Ψ.toMonoidHom) Ψ.injective] at hz'
    obtain ⟨x, hx, rfl⟩ := hz'
    exact ⟨x, D.ctr_oPPrime hx, rfl⟩
  centralizer_long := by
    rintro _ ⟨a, ha, rfl⟩ h1 x hx
    obtain ⟨b, rfl⟩ := Ψ.surjective x
    have ha1 : a ≠ 1 := fun e => h1 (by rw [e, map_one])
    refine ⟨b, D.centralizer_long a ha ha1 ?_, rfl⟩
    rw [Subgroup.mem_centralizer_singleton_iff] at hx ⊢
    exact Ψ.injective (by simpa using hx)
  short_pCore := by
    obtain ⟨t, ht, ht1, htp, htc⟩ := D.short_pCore
    refine ⟨Ψ t, ⟨t, ht, rfl⟩, fun e => ht1 (Ψ.injective (by simpa using e)), ?_, ?_⟩
    · rw [pCoreOf_map_of_inj (ψ := Ψ.toMonoidHom) Ψ.injective]
      exact ⟨t, htp, rfl⟩
    · intro x hx
      obtain ⟨b, rfl⟩ := Ψ.surjective x
      refine ⟨b, htc ?_, rfl⟩
      rw [Subgroup.mem_centralizer_singleton_iff] at hx ⊢
      exact Ψ.injective (by simpa using hx)

end InvMap

section InvChart

open CFSG.ASVolI.ChF CFSG.ASVolI.ChF.ClassicalRoots

theorem burnsideF4gU4Inv_marking {f : ℕ} {E : Type} [Group E] {Gp : Subgroup E}
    (chart : NativeChart .U4 2 f Gp) :
    ∃ marking : Marking .U4 2 f Gp,
      chart.points = (marking.parabolic false).map Gp.subtype ∧
      chart.lines = (marking.parabolic true).map Gp.subtype ∧
      chart.longRoot = (marking.root .longOne false).map Gp.subtype ∧
      chart.shortRoot = (marking.root .sum false).map Gp.subtype := by
  rcases chart.coordinates with
    ⟨c, hk, marking, h1, h2, h3, h4, h5⟩ | ⟨hk, -⟩ | ⟨hk, -⟩ | ⟨hk, -⟩ |
    ⟨-, exponent, K, fK, finK, charK, scope, ⟨hk, -⟩ | ⟨hk, -⟩⟩
  · cases c
    · exact absurd hk (by decide)
    · exact absurd hk (by decide)
    · exact ⟨marking, h2, h3, by simpa using h4, by simpa using h5⟩
    · exact absurd hk (by decide)
  all_goals exact absurd hk (by decide)

theorem burnsideF4gU4Inv_rootInvolution_iff {f : ℕ} {E : Type} [Group E] {Gp : Subgroup E}
    (hGp : Gp = ⊤) (chart : NativeChart .U4 2 f Gp) (b : Bool) {x : E} :
    chart.RootInvolution b x ↔ x ≠ 1 ∧ x * x = 1 ∧
      ∃ c : E, c * x * c⁻¹ ∈ (if b then chart.shortRoot else chart.longRoot) := by
  constructor
  · rintro ⟨-, h1, h2, -, c, -, hc⟩
    exact ⟨h1, h2, c, hc⟩
  · rintro ⟨h1, h2, c, hc⟩
    refine ⟨by rw [hGp]; exact Subgroup.mem_top x, h1, h2, fun e => absurd e (by decide), c,
      by rw [hGp]; exact Subgroup.mem_top c, hc⟩

end InvChart

section InvDataY

open Matrix CFSG.ClassicalGroups.UnitaryFlag CFSG.LocalAnalysis.ComponentInitial
  CFSG.Quasithin.H13.U4Par CFSG.Quasithin CFSG.ASVolI.ChF

variable {m : ℕ} {K : Type} [Field K] (h : UnitaryFieldData 2 m K)

theorem burnsideF4gU4Inv_long_ne : ∃ z ∈ zRad h, z ≠ 1 := by
  refine ⟨sElt h ((sAdm_zero_zero_iff h).mpr (map_one h.bar)), ⟨1, map_one h.bar, rfl⟩, ?_⟩
  intro e
  have := congrFun (congrFun (congrArg (fun g : hypSU h 2 0 => ((g : GL Ix K) : Matrix Ix Ix K)) e)
    ie1) if1
  rw [coe_sElt, sMat_ie1_if1] at this
  simp [one_apply] at this

theorem burnsideF4gU4Inv_short_ne : ∃ t ∈ burnsideF4gU4Inv_short h, t ≠ 1 :=
  ⟨sElt h (sAdm_x_zero h 1), ⟨1, rfl⟩,
    burnsideF4gU4Inv_short_ne_one h (coe_sElt h _) one_ne_zero⟩

theorem burnsideF4gU4Inv_Data_Y
    (hcases : ∀ x : hypSU h 2 0, x ≠ 1 → x * x = 1 →
      (∃ g : hypSU h 2 0, g * x * g⁻¹ ∈ zRad h) ∨
        (∃ g : hypSU h 2 0, g * x * g⁻¹ ∈ burnsideF4gU4Inv_short h))
    (hconjL : ∀ z ∈ zRad h, z ≠ 1 → ∀ z' ∈ zRad h, z' ≠ 1 → IsConj z z')
    (hconjS : ∀ t ∈ burnsideF4gU4Inv_short h, t ≠ 1 → ∀ t' ∈ burnsideF4gU4Inv_short h, t' ≠ 1 →
