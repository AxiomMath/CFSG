theorem burnsideF4gD4Inv_Facts.part4 (F : burnsideF4gD4Inv_Facts E M₁ M₂ L S z t) :
    (∀ w ∈ ctr (oPPrime 2 M₁), w ≠ 1 → burnsideF4gD4Inv_RI L w ∧
      Subgroup.centralizer ({w} : Set E) ≤ M₁ ∧
      oPPrime 2 M₁ = oPPrime 2 (Subgroup.centralizer ({w} : Set E)) ∧
      oPPrime 2 M₁ = Subgroup.centralizer ({w} : Set E)) ∧
    ∃ x ∈ pCoreOf 2 M₂, burnsideF4gD4Inv_RI S x ∧ Subgroup.centralizer ({x} : Set E) ≤ M₂ := by
  refine ⟨?_, ?_⟩
  · intro w hw hw1
    obtain ⟨h, hh, hhw⟩ := F.pos_conj w hw hw1
    have hcz : ∀ g : E, g ∈ Subgroup.centralizer ({w} : Set E) ↔
        h⁻¹ * g * h ∈ Subgroup.centralizer ({z} : Set E) := by
      intro g
      rw [Subgroup.mem_centralizer_singleton_iff, Subgroup.mem_centralizer_singleton_iff, ← hhw]
      constructor
      · intro hg
        calc h⁻¹ * g * h * z = h⁻¹ * (g * (h * z * h⁻¹)) * h := by group
          _ = h⁻¹ * (h * z * h⁻¹ * g) * h := by rw [hg]
          _ = z * (h⁻¹ * g * h) := by group
      · intro hg
        calc g * (h * z * h⁻¹) = h * ((h⁻¹ * g * h) * z) * h⁻¹ := by group
          _ = h * (z * (h⁻¹ * g * h)) * h⁻¹ := by rw [hg]
          _ = h * z * h⁻¹ * g := by group
    have hOcz : ∀ g : E, g ∈ Subgroup.centralizer ({w} : Set E) ↔ g ∈ oPPrime 2 M₁ := by
      intro g
      rw [hcz, ← F.oPP_eq]
      constructor
      · intro hg
        have := burnsideF4gD4Inv_oPPrime_conj_mem M₁ hh hg
        simpa [mul_assoc] using this
      · intro hg
        have := burnsideF4gD4Inv_oPPrime_conj_mem M₁ (M₁.inv_mem hh) hg
        simpa [mul_assoc] using this
    have hEq : oPPrime 2 M₁ = Subgroup.centralizer ({w} : Set E) :=
      Subgroup.ext fun g => (hOcz g).symm
    refine ⟨(F.RI_L_iff w).2 (isConj_iff.2 ⟨h, hhw⟩), ?_, ?_, hEq⟩
    · intro g hg
      have hg' := (hcz g).1 hg
      have := M₁.mul_mem (M₁.mul_mem hh (F.cent_z hg')) (M₁.inv_mem hh)
      simpa [mul_assoc] using this
    · rw [← hEq, burnsideF4gD4Inv_oPPrime_oPPrime]
  · refine ⟨t, F.t_core, (F.RI_S_iff t).2 (IsConj.refl t), F.cent_t⟩

