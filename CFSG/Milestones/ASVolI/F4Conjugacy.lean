theorem burnsideF4gF4TwoInv_LR_char (hK : Nat.card K = 2 ^ (2 * a + 1)) (hK2 : Nat.card K = 2)
    (y : Gm K a) : (y : ModGL F4.tag K) ∈ reeLongRoot K a ↔ y = 1 ∨ y = zg hK := by
  constructor
  · intro hy
    obtain ⟨v, hv⟩ := burnsideF4gF4TwoInv_reeLongRoot_coord hK hy
    rcases burnsideF4gF4TwoInv_eq_zero_or_one hK2 v with rfl | rfl
    · left
      exact Subtype.ext (hv.trans centralZ_zero)
    · right
      exact Subtype.ext (hv.trans (burnsideF4gF4TwoInv_coe_zg hK).symm)
  · rintro (rfl | rfl)
    · rw [Subgroup.coe_one]
      exact one_mem _
    · rw [burnsideF4gF4TwoInv_coe_zg hK]
      exact burnsideF4gF4TwoInv_centralZ_mem_reeLongRoot hK 1

theorem burnsideF4gF4TwoInv_SR_char (hK : Nat.card K = 2 ^ (2 * a + 1)) (hK2 : Nat.card K = 2)
    (y : Gm K a) : (y : ModGL F4.tag K) ∈ reeShortRoot K a ↔ y = 1 ∨ y = tg hK := by
  constructor
