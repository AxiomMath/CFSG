theorem burnsideF4gF4Inv_oPPrime_subgroupOf {E : Type} [Group E] (p : ℕ) {Γ P : Subgroup E}
    (h : P ≤ Γ) : oPPrime p (P.subgroupOf Γ) = (oPPrime p P).subgroupOf Γ := by
