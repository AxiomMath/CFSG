theorem burnsideF4gF4TwoInv_units_subsingleton {L : Type} [Field L] [Finite L]
    (hL : Nat.card L = 2) : Subsingleton Lˣ := by
  have h2 : Nat.card Lˣ = 1 := by rw [Nat.card_units, hL]
  exact (Nat.card_eq_one_iff_unique.1 h2).1

theorem burnsideF4gF4TwoInv_eq_zero_or_one {L : Type} [Field L] [Finite L]
    (hL : Nat.card L = 2) (v : L) : v = 0 ∨ v = 1 := by
  by_cases hv : v = 0
  · exact Or.inl hv
  · right
    haveI := burnsideF4gF4TwoInv_units_subsingleton hL
    exact congrArg Units.val (Subsingleton.elim (Units.mk0 v hv) 1)

theorem burnsideF4gF4TwoInv_coe_zg (hK : Nat.card K = 2 ^ (2 * a + 1)) :
    (zg hK : ModGL F4.tag K) = centralZ K a 1 :=
  (CFSG.LocalAnalysis.EvenBN.TwoF4.invE_eq_centralZ (K := K) (a := a)).1

theorem burnsideF4gF4TwoInv_coe_tg (hK : Nat.card K = 2 ^ (2 * a + 1)) :
    (tg hK : ModGL F4.tag K) = sylowL a K 1 :=
