  have hac : ¬ IsConj a c := fun h =>
    burnsideF4gSpInv_not_Rk1_mixed (s := (1 : K)) one_ne_zero
      ((burnsideF4gSpInv_isConj_Rk1 h).1 (burnsideF4gSpInv_Rk1_xl 1))
