  · rw [F.invClasses_eq]
    exact Set.ncard_pair (fun h => F.not_conj (ConjClasses.mk_eq_mk_iff_isConj.1 h))
  · refine ⟨ConjClasses.mk z, ⟨?_, z, ConjClasses.mem_carrier_mk, F.z_ctr⟩, ?_⟩
    · exact ⟨z, ConjClasses.mem_carrier_mk, F.z_ne, F.z_sq⟩
    · rintro C ⟨⟨x, hx, hx1, -⟩, w, hw, hwc⟩
      have hxC : ConjClasses.mk x = C := ConjClasses.mem_carrier_iff_mk_eq.1 hx
      have hwC : ConjClasses.mk w = C := ConjClasses.mem_carrier_iff_mk_eq.1 hw
      have hw1 : w ≠ 1 := fun h => hx1 (burnsideF4gD4Inv_eq_one_of_isConj
        (ConjClasses.mk_eq_mk_iff_isConj.1 (hxC.trans hwC.symm)) h)
