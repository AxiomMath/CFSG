    intro P z
    rw [Subgroup.mem_map_equiv, MulEquiv.symm_apply_apply]
  have hpoly : IsGenPolygon (RuType.subCompletion twoF4H twoF4N).graph 8 :=
    CFSG.Quasithin.H13.F45Ru.f45TwoF4.poly
  rcases hΦ with ⟨hp1, hp2⟩ | ⟨hp1, hp2⟩
  · refine burnsideF4gF4Two_polygon_of_equiv (A := twoF4H) (B := twoF4N) θ
      (fun x => (hM₁ (MulEquiv.subgroupCongr hsup x)).trans ?_)
      (fun x => (hM₂ (MulEquiv.subgroupCongr hsup x)).trans ?_) hpoly
    · rw [← hz _ , hp1]
