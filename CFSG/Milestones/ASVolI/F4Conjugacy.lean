    Subgroup.map_subgroupOf_eq_of_le ((burnsideF4gF4Inv_oPPrime_le p P).trans h)
  rw [← burnsideF4gF4Inv_oPPrime_map_inj Γ.subtype Γ.subtype_injective, h1, h2]

theorem burnsideF4gF4Inv_mem_centralizer_zg_iff (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1))
    (y : Gm K a) :
    y ∈ Subgroup.centralizer ({zg hK} : Set (Gm K a)) ↔
      (y : ModGL F4.tag K) ∈ centralizerZ K a := by
  have hCz := reeGamma_inf_centralizer_eq ha hK
  constructor
  · intro h
    have h1 : zg hK * y = y * zg hK := by
      exact Subgroup.mem_centralizer_iff.1 h (zg hK) (Set.mem_singleton _)
    have h2 : centralZ K a 1 * (y : ModGL F4.tag K) = (y : ModGL F4.tag K) * centralZ K a 1 := by
      have h3 := congrArg Subtype.val h1
      rw [Subgroup.coe_mul, Subgroup.coe_mul, burnsideF4gF4Inv_coe_zg] at h3
      exact h3
    have hy : (y : ModGL F4.tag K) ∈ F4.reeGamma K a ⊓
        Subgroup.centralizer ({centralZ K a 1} : Set (ModGL F4.tag K)) := by
      refine ⟨y.2, Subgroup.mem_centralizer_iff.2 fun g hg => ?_⟩
      rw [Set.mem_singleton_iff] at hg
      rw [hg]
      exact h2
    exact (SetLike.ext_iff.1 hCz _).1 hy
  · intro h
    have hy := (SetLike.ext_iff.1 hCz _).2 h
    have h2 := Subgroup.mem_centralizer_iff.1 (Subgroup.mem_inf.1 hy).2 (centralZ K a 1)
      (Set.mem_singleton _)
    refine Subgroup.mem_centralizer_iff.2 fun g hg => ?_
    rw [Set.mem_singleton_iff] at hg
    rw [hg]
    apply Subtype.ext
    show (zg hK : ModGL F4.tag K) * (y : ModGL F4.tag K) =
      (y : ModGL F4.tag K) * (zg hK : ModGL F4.tag K)
    rw [burnsideF4gF4Inv_coe_zg]
    exact h2

theorem burnsideF4gF4Inv_ctr_Cz_le (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1))
    {x : ModGL F4.tag K} (hxCz : x ∈ centralizerZ K a)
    (hcomm : ∀ y ∈ centralizerZ K a, y * x = x * y) :
    x ∈ F4.reeFixedPosUnipotent K a ∧ ∀ u ∈ F4.reeFixedPosUnipotent K a, u * x = x * u := by
  obtain ⟨hN, hN2, hC, hO, hOdd⟩ := centralizerZ_kernel ha hK
  have hxV : x ∈ F4.reeFixedOrbitComplementUnipotent K a ⟨1, by decide⟩ := by
    have hmem : (⟨x, hxCz⟩ : centralizerZ K a) ∈ Subgroup.centralizer
        (((F4.reeFixedOrbitComplementUnipotent K a ⟨1, by decide⟩).subgroupOf
          (centralizerZ K a) : Subgroup (centralizerZ K a)) : Set (centralizerZ K a)) := by
      refine Subgroup.mem_centralizer_iff.2 fun v hv => ?_
      apply Subtype.ext
      exact (hcomm v v.2)
    exact Subgroup.mem_subgroupOf.1 (hC hmem)
  have hU2 : ∀ y ∈ F4.reeFixedOrbitUnipotent K a ⟨1, by decide⟩, y ∈ centralizerZ K a := by
    intro y hy
    exact Subgroup.mem_sup_right (Subgroup.subset_closure (Or.inl (Or.inl hy)))
  refine ⟨reeFixedOrbitComplementUnipotent_le _ hxV, fun u hu => ?_⟩
  obtain ⟨v, hv, y, hy, rfl⟩ := exists_mul_eq_of_mem_reeFixedPosUnipotent ⟨1, by decide⟩ hu
  have h1 := hcomm v (Subgroup.mem_sup_left hv)
  have h2 := hcomm y (hU2 y hy)
  calc v * y * x = v * (y * x) := by rw [mul_assoc]
    _ = v * (x * y) := by rw [h2]
    _ = (v * x) * y := by rw [mul_assoc]
    _ = (x * v) * y := by rw [h1]
    _ = x * (v * y) := by rw [mul_assoc]

