    intro word
    induction word with
    | nil => intro init; simp [burnsideF4gG2_wordUnit]
    | cons i ω ih =>
      intro init
      rw [List.foldl_cons, ih]
      simp only [burnsideF4gG2_wordUnit, List.reverse_cons, List.map_append, List.map_cons,
        List.map_nil, List.prod_append, List.prod_cons, List.prod_nil, mul_one, Units.val_mul,
        mul_assoc]
      rfl
  rw [burnsideF4gG2_weylWordOperator_eq_weylWord]
  unfold burnsideF4gG2_weylWord
