      CFSG.ASVolI.ChF.GLKind.G2d.m := by
  have hGp : Gp = ⊤ := hyp.canonical (Or.inl rfl)
  obtain ⟨K, fK, finK, hK, marking, h1, h2⟩ := burnsideF4gG2Two_chart_G2d hyp.toHypF_4_4g
  letI := fK
  haveI := finK
  let π : E →* G2Native.SmallModel K :=
    marking.symm.toMonoidHom.comp
      (MonoidHom.codRestrict (MonoidHom.id E) Gp (fun e => hGp ▸ Subgroup.mem_top e))
  let ι : E →* AdjointQuotient .G2 K := (burnsideF4gG2Two_smallToFull hK).comp π
  have hπ : ∀ (e : E) (he : e ∈ Gp), π e = marking.symm ⟨e, he⟩ := fun e he => rfl
  have k1 : M₁ = (burnsideF4gG2Two_sys hK).P₁.comap ι := by
    rw [← burnsideF4gG2Two_fullLocal_point hK]
    ext e
    have he : e ∈ Gp := hGp ▸ Subgroup.mem_top e
    rw [Subgroup.mem_comap]
    show _ ↔ burnsideF4gG2Two_smallToFull hK (π e) ∈ _
    rw [burnsideF4gG2Two_smallToFull_mem, hπ e he]
    have h1' : (⟨e, he⟩ : ↥Gp) ∈ M₁.subgroupOf Gp ↔ e ∈ M₁ := Iff.rfl
    rw [← h1', h1]
    unfold G2Native.smallImage
    exact Subgroup.mem_map_equiv
  have k2 : M₂ = (burnsideF4gG2Two_sys hK).P₂.comap ι := by
    rw [← burnsideF4gG2Two_fullLocal_line hK]
    ext e
    have he : e ∈ Gp := hGp ▸ Subgroup.mem_top e
    rw [Subgroup.mem_comap]
    show _ ↔ burnsideF4gG2Two_smallToFull hK (π e) ∈ _
    rw [burnsideF4gG2Two_smallToFull_mem, hπ e he]
    have h2' : (⟨e, he⟩ : ↥Gp) ∈ M₂.subgroupOf Gp ↔ e ∈ M₂ := Iff.rfl
    rw [← h2', h2]
    unfold G2Native.smallImage
    exact Subgroup.mem_map_equiv
  have hcov : ∀ q : AdjointQuotient .G2 K, ∃ e : E,
      ∃ b ∈ (burnsideF4gG2Two_sys hK).P₁ ⊓ (burnsideF4gG2Two_sys hK).P₂, q = ι e * b := by
    intro q
