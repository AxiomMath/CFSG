    · have : Gp ⊓ M₁ = (G2Native.smallImage K marking (G2Native.pointParabolic K)).map Gp.subtype :=
        hpts.trans h2
      rw [← Subgroup.inf_subgroupOf_left M₁ Gp, this]
      exact Subgroup.comap_map_eq_self_of_injective Gp.subtype_injective _
    · have : Gp ⊓ M₂ = (G2Native.smallImage K marking (G2Native.lineParabolic K)).map Gp.subtype :=
