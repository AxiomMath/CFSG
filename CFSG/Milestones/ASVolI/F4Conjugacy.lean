variable {E : Type} [Group E] {Gp M₁ M₂ : Subgroup E} {κ : GLKind} {p f : ℕ}

theorem burnsideF4g_incl_graph_iso [Finite E] (hyp : HypF_4_4g κ p f Gp M₁ M₂) {TD : Subgroup ↥Gp}
    (hyam : IsYAmalgamPair TD (M₁.subgroupOf Gp) (M₂.subgroupOf Gp)) (hfin : Finite ↥Gp)
    (pm : ℕ) (hpm : 3 ≤ pm) :
    Nonempty ((incl M₁ M₂).graph ≃g
      ((burnsideF4d_lieExtE hyp hyam).toLieAmalgamExt.setting hfin pm hpm).ι.graph) := by
  haveI := hyp.normal
  let X := burnsideF4d_lieExtE hyp hyam
  have hinj : Function.Injective (burnsideF4d_rho Gp) :=
    burnsideF4d_rho_injective hyp.centralizer_trivial
  have hN1 : X.N1 = M₁.map (burnsideF4d_rho Gp) := burnsideF4d_N1_eq hyp hyam
  have hN2 : X.N2 = M₂.map (burnsideF4d_rho Gp) := burnsideF4d_N2_eq hyp hyam
  have hK : (M₁ ⊔ M₂).map (burnsideF4d_rho Gp) = X.K := by
    rw [Subgroup.map_sup]
    show _ = X.N1 ⊔ X.N2
    rw [hN1, hN2]
  let θ : ↥(M₁ ⊔ M₂) ≃* ↥X.K :=
    ((M₁ ⊔ M₂).equivMapOfInjective (burnsideF4d_rho Gp) hinj).trans (MulEquiv.subgroupCongr hK)
  let c := incl M₁ M₂
  let ι0 := ((X.toLieAmalgamExt).setting hfin pm hpm).ι
  have h1 : c.φ1.range.map θ.toMonoidHom = ι0.φ1.range := by
    have := burnsideF4g_map_range c.φ1 θ (ι0.φ1.comp X.iso.φ1.toMonoidHom) (fun g => rfl)
    rw [this]
    exact U42.Am.range_comp_mulEquiv ι0.φ1 X.iso.φ1
  have h2 : c.φ2.range.map θ.toMonoidHom = ι0.φ2.range := by
    have := burnsideF4g_map_range c.φ2 θ (ι0.φ2.comp X.iso.φ2.toMonoidHom) (fun g => rfl)
    rw [this]
    exact U42.Am.range_comp_mulEquiv ι0.φ2 X.iso.φ2
  exact burnsideF4g_completion_graph_iso c ι0 θ h1 h2

theorem burnsideF4g_polygon_of_facts [Finite E] (hyp : HypF_4_4g κ p f Gp M₁ M₂)
    {TD : Subgroup ↥Gp} (hyam : IsYAmalgamPair TD (M₁.subgroupOf Gp) (M₂.subgroupOf Gp))
    (hfin : Finite ↥Gp) {pm : ℕ} (hpm : 3 ≤ pm) (hm : κ.m = pm)
    (hS : ((burnsideF4d_lieExtE hyp hyam).toLieAmalgamExt.setting hfin pm hpm).Facts45L) :
    IsGenPolygon (incl M₁ M₂).graph κ.m := by
  obtain ⟨φ⟩ := burnsideF4g_incl_graph_iso hyp hyam hfin pm hpm
  rw [hm]
  exact IsGenPolygon.of_iso φ hS.poly

end Bridge

