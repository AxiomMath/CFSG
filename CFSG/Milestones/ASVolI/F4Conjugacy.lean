variable {f : ℕ} {H : Type} [Group H] (marking : Marking .U4 2 f H)

theorem burnsideF4gU4_fieldData : UnitaryFieldData 2 f marking.field :=
  ⟨Nat.prime_two, marking.exponent_pos, by
    have := marking.field_card
    simp only [true_or, if_true] at this
    rw [this, ← pow_mul, mul_comm]⟩

theorem burnsideF4gU4_basis_gram (i j : Fin 4) :
    (((marking.basis : Matrix (Fin 4) (Fin 4) marking.field).map
        (burnsideF4gU4_fieldData marking).bar)ᵀ *
      (marking.basis : Matrix (Fin 4) (Fin 4) marking.field)) i j =
      if i.val + j.val + 1 = 4 then 1 else 0 := by
  have h1 := congrFun (congrFun marking.basis_compatible i) j
  have hbar : (⇑(burnsideF4gU4_fieldData marking).bar : marking.field → marking.field) =
      fun e => e ^ 2 ^ f := funext (burnsideF4gU4_fieldData marking).bar_apply
  rw [hbar]
  exact h1

theorem burnsideF4gU4_marking_isHypTransport :
    IsHypTransport (burnsideF4gU4_fieldData marking)
      (burnsideF4gU4_R (marking.basis : Matrix (Fin 4) (Fin 4) marking.field)) :=
  burnsideF4gU4_isHypTransport _ _ (burnsideF4gU4_basis_gram marking)

noncomputable def burnsideF4gU4_T :
    hypSU (burnsideF4gU4_fieldData marking) 2 0 ≃* nativeGroup .U4 (2 ^ f) marking.field :=
  hypTransport (burnsideF4gU4_fieldData marking) (burnsideF4gU4_marking_isHypTransport marking)

theorem burnsideF4gU4_coe_T (g : hypSU (burnsideF4gU4_fieldData marking) 2 0) :
    (((burnsideF4gU4_T marking g : nativeGroup .U4 (2 ^ f) marking.field) :
        GL (Coord .U4) marking.field) : Matrix (Fin 4) (Fin 4) marking.field) =
      burnsideF4gU4_R (marking.basis : Matrix (Fin 4) (Fin 4) marking.field) *
        ((g : GL (HypIndex 2 0) marking.field) :
          Matrix (HypIndex 2 0) (HypIndex 2 0) marking.field) *
        transportInv (burnsideF4gU4_fieldData marking)
          (burnsideF4gU4_R (marking.basis : Matrix (Fin 4) (Fin 4) marking.field)) :=
  coe_hypTransport (burnsideF4gU4_marking_isHypTransport marking) g

theorem burnsideF4gU4_parabolic_false :
    nativeParabolic .U4 (2 ^ f) marking.field marking.basis false =
      (CFSG.Quasithin.H13.U4Par.parP (burnsideF4gU4_fieldData marking)).map
        (burnsideF4gU4_T marking).toMonoidHom := by
  ext x
  rw [Subgroup.mem_map_equiv]
  have key := burnsideF4gU4_mem_isoStabilizer_iff (burnsideF4gU4_fieldData marking)
    (marking.basis : Matrix (Fin 4) (Fin 4) marking.field)
    (burnsideF4gU4_marking_isHypTransport marking) 1 (by norm_num) {0}
    (by intro j; fin_cases j <;> simp) ((burnsideF4gU4_T marking).symm x)
  have e : hypTransport (burnsideF4gU4_fieldData marking)
      (burnsideF4gU4_marking_isHypTransport marking)
      ((burnsideF4gU4_T marking).symm x) = x := (burnsideF4gU4_T marking).apply_symm_apply x
  rw [e] at key
  show (x : GL (Coord .U4) marking.field) ∈ rawStabilizer _ ↔ _
  rw [burnsideF4f_mem_rawStabilizer]
  exact key.symm

theorem burnsideF4gU4_parabolic_true :
    nativeParabolic .U4 (2 ^ f) marking.field marking.basis true =
      (CFSG.Quasithin.H13.U4Par.parP2 (burnsideF4gU4_fieldData marking)).map
        (burnsideF4gU4_T marking).toMonoidHom := by
  ext x
  rw [Subgroup.mem_map_equiv]
  have key := burnsideF4gU4_mem_isoStabilizer_iff (burnsideF4gU4_fieldData marking)
    (marking.basis : Matrix (Fin 4) (Fin 4) marking.field)
    (burnsideF4gU4_marking_isHypTransport marking) 2 (by norm_num) {0, 1}
    (by intro j; fin_cases j <;> simp) ((burnsideF4gU4_T marking).symm x)
  have e : hypTransport (burnsideF4gU4_fieldData marking)
      (burnsideF4gU4_marking_isHypTransport marking)
      ((burnsideF4gU4_T marking).symm x) = x := (burnsideF4gU4_T marking).apply_symm_apply x
  rw [e] at key
  show (x : GL (Coord .U4) marking.field) ∈ rawStabilizer _ ↔ _
  rw [burnsideF4f_mem_rawStabilizer]
  exact key.symm

theorem burnsideF4gU4_transport_injective : Function.Injective marking.transport := by
  have hfd := burnsideF4gU4_fieldData marking
  haveI : Finite marking.field := hfd.finite
  haveI : CharP marking.field 2 := hfd.charP
  have hcard : Nat.card marking.field = (2 ^ f) ^ 2 := by
    rw [hfd.card, ← pow_mul, mul_comm]
  rw [injective_iff_map_eq_one]
  intro g hg
  rw [burnsideF4f_transport_eq_one_iff] at hg
  have h0 := CFSG.Quasithin.H13.F431.Un.statedScalars_inf_eq_bot (F := marking.field) (f := f)
    hcard
  have hmem : g ∈ (StatedScalars (Fin 4) marking.field).subgroupOf
      (StatedSU 4 (2 ^ f) marking.field) := hg
  rw [h0] at hmem
  exact hmem

noncomputable def burnsideF4gU4_Phi : hypSU (burnsideF4gU4_fieldData marking) 2 0 ≃* H :=
  (burnsideF4gU4_T marking).trans
    (MulEquiv.ofBijective marking.transport
      ⟨burnsideF4gU4_transport_injective marking, burnsideF4f_transport_surjective marking⟩)

theorem burnsideF4gU4_Phi_toMonoidHom :
    (burnsideF4gU4_Phi marking).toMonoidHom =
      marking.transport.comp (burnsideF4gU4_T marking).toMonoidHom := by
  ext g
  rfl

theorem burnsideF4gU4_exists_equiv :
    ∃ Φ : hypSU (burnsideF4gU4_fieldData marking) 2 0 ≃* H,
      marking.parabolic false =
        (CFSG.Quasithin.H13.U4Par.parP (burnsideF4gU4_fieldData marking)).map Φ.toMonoidHom ∧
      marking.parabolic true =
        (CFSG.Quasithin.H13.U4Par.parP2 (burnsideF4gU4_fieldData marking)).map Φ.toMonoidHom := by
  refine ⟨burnsideF4gU4_Phi marking, ?_, ?_⟩
  · show (nativeParabolic .U4 (2 ^ f) marking.field marking.basis false).map marking.transport = _
    rw [burnsideF4gU4_parabolic_false, Subgroup.map_map, burnsideF4gU4_Phi_toMonoidHom]
  · show (nativeParabolic .U4 (2 ^ f) marking.field marking.basis true).map marking.transport = _
    rw [burnsideF4gU4_parabolic_true, Subgroup.map_map, burnsideF4gU4_Phi_toMonoidHom]

theorem burnsideF4gU4_yam_of_marking {f : ℕ} {H : Type} [Group H]
    (marking : CFSG.ASVolI.ChF.ClassicalRoots.Marking .U4 2 f H) :
    ∃ TD : Subgroup H, CFSG.Quasithin.IsYAmalgamPair TD (marking.parabolic false)
      (marking.parabolic true) := by
  obtain ⟨Φ, e0, e1⟩ := burnsideF4gU4_exists_equiv marking
  refine ⟨(hypUnitriangular (burnsideF4gU4_fieldData marking) 2 0).map Φ.toMonoidHom, ?_⟩
  rw [e0, e1]
  exact CFSG.Quasithin.IsYAmalgamPair.map Φ
    (CFSG.Quasithin.H13.U4Par.isYAmalgamPair_parP_parP2 _)

end U4Marking

