open CFSG.Quasithin CFSG.QuasithinUnique CFSG.QuasithinUnique.Borel252
  CFSG.QuasithinUnique.Setup.X7a CFSG.QuasithinUnique.Setup.X7b
  CFSG.LocalAnalysis.ComponentInitial.SymplecticFlag
  CFSG.ComponentClassification.UnbalancedCatalog.SpChain

theorem burnsideF4gSpOne_parabolic_cases {K : Type} [Field K] [Finite K] [CharP K 2]
    (θ : antiSp K ≃* StatedProj (StatedSp 2 K))
    (hθ : (antiUnipotent K).map θ.toMonoidHom = projUnipotent 2 K) :
    ((Subgroup.normalizer (radA1 K : Set (antiSp K))).map θ.toMonoidHom =
        (Q2 K 0).map (proj 2 K) ∧
      (Subgroup.normalizer (radA2 K : Set (antiSp K))).map θ.toMonoidHom =
        (Q2 K 1).map (proj 2 K)) ∨
    ((Subgroup.normalizer (radA1 K : Set (antiSp K))).map θ.toMonoidHom =
        (Q2 K 1).map (proj 2 K) ∧
      (Subgroup.normalizer (radA2 K : Set (antiSp K))).map θ.toMonoidHom =
        (Q2 K 0).map (proj 2 K)) := by
  have hBD := burnsideF4gSpOne_borelData θ hθ
  have hOG := Borel252.Sp4.overgroupData_Sp K
  have hlt : ∀ R : Subgroup (antiSp K),
      Subgroup.normalizer (antiUnipotent K : Set (antiSp K)) <
        Subgroup.normalizer (R : Set (antiSp K)) →
      Subgroup.normalizer (R : Set (antiSp K)) < ⊤ →
      Subgroup.normalizer (projUnipotent 2 K : Set (StatedProj (StatedSp 2 K))) <
        (Subgroup.normalizer (R : Set (antiSp K))).map θ.toMonoidHom ∧
      (Subgroup.normalizer (R : Set (antiSp K))).map θ.toMonoidHom < ⊤ := by
    intro R h1 h2
    refine ⟨?_, ?_⟩
    · rw [← hθ, ← Subgroup.map_equiv_normalizer_eq]
      exact (Subgroup.map_lt_map_iff_of_injective θ.injective).2 h1
    · rw [← Subgroup.map_top_of_surjective θ.toMonoidHom θ.surjective]
      exact (Subgroup.map_lt_map_iff_of_injective θ.injective).2 h2
  obtain ⟨a1, b1⟩ := hlt _ hBD.lt₁ hBD.lt_top₁
  obtain ⟨a2, b2⟩ := hlt _ hBD.lt₂ hBD.lt_top₂
  have e1 := hOG.eq_of_between a1 b1
  have e2 := hOG.eq_of_between a2 b2
  have hne : Subgroup.normalizer (radA1 K : Set (antiSp K)) ≠
      Subgroup.normalizer (radA2 K : Set (antiSp K)) := hBD.ne_norm
  rcases e1 with e1 | e1 <;> rcases e2 with e2 | e2
  · exact absurd (Subgroup.map_injective θ.injective (e1.trans e2.symm)) hne
  · exact Or.inl ⟨e1, e2⟩
  · exact Or.inr ⟨e1, e2⟩
  · exact absurd (Subgroup.map_injective θ.injective (e1.trans e2.symm)) hne

end Parabolics

section Native

open CFSG.ASVolI.ChF CFSG.ASVolI.ChF.ClassicalRoots CFSG.QuasithinUnique.Setup.X7a
  CFSG.LocalAnalysis.ComponentInitial.SymplecticFlag

theorem burnsideF4gSpOne_parabolic_eq {f : ℕ} {H : Type} [Group H]
    (marking : ClassicalRoots.Marking .Sp4 2 f H) :
    ∃ e : StatedProj (StatedSp 2 marking.field) ≃* H, ∀ b : Bool, marking.parabolic b =
      ((Q2 marking.field (if b then 1 else 0)).map (proj 2 marking.field)).map
        e.toMonoidHom := by
  have hbasis : marking.basis = 1 := marking.basis_compatible
  have keyS : ∀ (S : Set (Fin 2 ⊕ Fin 2))
      (W : Submodule marking.field (Fin 2 ⊕ Fin 2 → marking.field))
      (A : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) marking.field),
      (∀ v, v ∈ coordinateSpace S ↔ v ∈ W) →
      ((∀ v : Fin 2 ⊕ Fin 2 → marking.field, A.mulVec v ∈ coordinateSpace S ↔
          v ∈ coordinateSpace S) ↔
