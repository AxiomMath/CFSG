  rw [burnsideF4gF4_reeParabolic_zero]
  have hP := burnsideF4gF4_P_eq_sup (octSystemOf (octRGD2 hK)) false (m := octR2 K a) hm rfl
  show y ∈ P (octSystemOf (octRGD2 hK)) false ↔ _
