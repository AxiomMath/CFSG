theorem burnsideF4gSpInv_mem_Xl {g : StatedSp 2 K} :
    g ∈ burnsideF4gSpInv_Xl K ↔ ∃ t : K, burnsideF4gSpInv_xl t = g := by
  constructor
  · rintro ⟨x, rfl⟩
    exact ⟨x.toAdd, rfl⟩
