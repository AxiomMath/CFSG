theorem burnsideF4gF4Two_polygon_of_equiv {E : Type} [Group E] {M₁ M₂ : Subgroup E} {X : Type}
    [Group X] {A B : Subgroup X} (θ : ↥(M₁ ⊔ M₂) ≃* ↥(A ⊔ B))
    (h1 : ∀ x : ↥(M₁ ⊔ M₂), (x : E) ∈ M₁ ↔ ((θ x : ↥(A ⊔ B)) : X) ∈ A)
    (h2 : ∀ x : ↥(M₁ ⊔ M₂), (x : E) ∈ M₂ ↔ ((θ x : ↥(A ⊔ B)) : X) ∈ B) {m : ℕ}
    (hpoly : IsGenPolygon (RuType.subCompletion A B).graph m) :
    IsGenPolygon (ChF.incl M₁ M₂).graph m := by
  have hr1 : (ChF.incl M₁ M₂).φ1.range.map θ.toMonoidHom =
      (RuType.subCompletion A B).φ1.range := by
    ext z
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact (burnsideF4gF4Two_mem_range_φ1 A B (A ⊔ B) rfl _).2
        ((h1 x).1 ((burnsideF4gF4Two_mem_range_φ1 M₁ M₂ (M₁ ⊔ M₂) rfl x).1 hx))
    · intro hz
      refine ⟨θ.symm z, ?_, by simp⟩
      refine (burnsideF4gF4Two_mem_range_φ1 M₁ M₂ (M₁ ⊔ M₂) rfl _).2 ((h1 (θ.symm z)).2 ?_)
      simpa using (burnsideF4gF4Two_mem_range_φ1 A B (A ⊔ B) rfl z).1 hz
  have hr2 : (ChF.incl M₁ M₂).φ2.range.map θ.toMonoidHom =
      (RuType.subCompletion A B).φ2.range := by
    ext z
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact (burnsideF4gF4Two_mem_range_φ2 A B (A ⊔ B) rfl _).2
        ((h2 x).1 ((burnsideF4gF4Two_mem_range_φ2 M₁ M₂ (M₁ ⊔ M₂) rfl x).1 hx))
    · intro hz
      refine ⟨θ.symm z, ?_, by simp⟩
      refine (burnsideF4gF4Two_mem_range_φ2 M₁ M₂ (M₁ ⊔ M₂) rfl _).2 ((h2 (θ.symm z)).2 ?_)
      simpa using (burnsideF4gF4Two_mem_range_φ2 A B (A ⊔ B) rfl z).1 hz
  obtain ⟨φ⟩ := burnsideF4gF4Two_completion_graph_iso (ChF.incl M₁ M₂) (RuType.subCompletion A B)
    θ hr1 hr2
  exact IsGenPolygon.of_iso φ hpoly

theorem burnsideF4gF4Two_polygon_of_equiv_swap {E : Type} [Group E] {M₁ M₂ : Subgroup E} {X : Type}
    [Group X] {A B : Subgroup X} (θ : ↥(M₁ ⊔ M₂) ≃* ↥(A ⊔ B))
    (h1 : ∀ x : ↥(M₁ ⊔ M₂), (x : E) ∈ M₁ ↔ ((θ x : ↥(A ⊔ B)) : X) ∈ B)
    (h2 : ∀ x : ↥(M₁ ⊔ M₂), (x : E) ∈ M₂ ↔ ((θ x : ↥(A ⊔ B)) : X) ∈ A) {m : ℕ}
    (hpoly : IsGenPolygon (RuType.subCompletion A B).graph m) :
    IsGenPolygon (ChF.incl M₁ M₂).graph m := by
  have hr1 : (ChF.incl M₁ M₂).φ1.range.map θ.toMonoidHom =
      (RuType.subCompletion A B).φ2.range := by
    ext z
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact (burnsideF4gF4Two_mem_range_φ2 A B (A ⊔ B) rfl _).2
        ((h1 x).1 ((burnsideF4gF4Two_mem_range_φ1 M₁ M₂ (M₁ ⊔ M₂) rfl x).1 hx))
    · intro hz
      refine ⟨θ.symm z, ?_, by simp⟩
      refine (burnsideF4gF4Two_mem_range_φ1 M₁ M₂ (M₁ ⊔ M₂) rfl _).2 ((h1 (θ.symm z)).2 ?_)
      simpa using (burnsideF4gF4Two_mem_range_φ2 A B (A ⊔ B) rfl z).1 hz
  have hr2 : (ChF.incl M₁ M₂).φ2.range.map θ.toMonoidHom =
      (RuType.subCompletion A B).φ1.range := by
    ext z
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact (burnsideF4gF4Two_mem_range_φ1 A B (A ⊔ B) rfl _).2
        ((h2 x).1 ((burnsideF4gF4Two_mem_range_φ2 M₁ M₂ (M₁ ⊔ M₂) rfl x).1 hx))
    · intro hz
      refine ⟨θ.symm z, ?_, by simp⟩
      refine (burnsideF4gF4Two_mem_range_φ2 M₁ M₂ (M₁ ⊔ M₂) rfl _).2 ((h2 (θ.symm z)).2 ?_)
      simpa using (burnsideF4gF4Two_mem_range_φ1 A B (A ⊔ B) rfl z).1 hz
  have h0 : ((ChF.incl M₁ M₂).φ1.range ⊔ (ChF.incl M₁ M₂).φ2.range).map θ.toMonoidHom =
      (RuType.subCompletion A B).φ1.range ⊔ (RuType.subCompletion A B).φ2.range := by
    rw [Subgroup.map_sup, hr1, hr2]
    exact sup_comm _ _
  obtain ⟨φ⟩ := burnsideF4gF4Two_cosetGeom_iso θ h0 hr1 hr2
  obtain ⟨ψ⟩ := burnsideF4gF4Two_cosetGeom_swap ((RuType.subCompletion A B).φ1.range ⊔
    (RuType.subCompletion A B).φ2.range) (RuType.subCompletion A B).φ2.range
    (RuType.subCompletion A B).φ1.range
  exact IsGenPolygon.of_iso (φ.trans ψ) hpoly

end GraphLemmas

