theorem burnsideF4gSpOne_marking {f : ℕ} {E : Type} [Group E] {Gp M₁ M₂ : Subgroup E}
    (h : HypF_4_4g .Sp4 2 f Gp M₁ M₂) :
    ∃ marking : ClassicalRoots.Marking .Sp4 2 f Gp,
      M₁.subgroupOf Gp = marking.parabolic false ∧ M₂.subgroupOf Gp = marking.parabolic true := by
  obtain ⟨chart, -, hpts, hlines⟩ := h.lie_amalgam
  rcases chart.coordinates with
    ⟨c', hk, marking, h1, h2, h3, h4, h5⟩ | ⟨hk, -⟩ | ⟨hk, -⟩ | ⟨hk, -⟩ |
    ⟨-, exponent, K, fK, finK, charK, scope, ⟨hk, -⟩ | ⟨hk, -⟩⟩
  · have hc : c' = .Sp4 := by
      cases c' <;> first | rfl | exact absurd hk (by decide)
    subst hc
    refine ⟨marking, ?_, ?_⟩
    · have : Gp ⊓ M₁ = (marking.parabolic false).map Gp.subtype := hpts.trans h2
      rw [← Subgroup.inf_subgroupOf_left M₁ Gp, this]
      exact Subgroup.comap_map_eq_self_of_injective Gp.subtype_injective _
    · have : Gp ⊓ M₂ = (marking.parabolic true).map Gp.subtype := hlines.trans h3
      rw [← Subgroup.inf_subgroupOf_left M₂ Gp, this]
      exact Subgroup.comap_map_eq_self_of_injective Gp.subtype_injective _
  all_goals exact absurd hk (by decide)

theorem burnsideF4gSpOne_mem_rawStabilizer {index : Type} [Fintype index] [DecidableEq index]
    {K : Type} [Field K] (space : Set (index → K)) (g : GL index K) :
    g ∈ rawStabilizer space ↔
      ∀ vector : index → K, (g : Matrix index index K).mulVec vector ∈ space ↔ vector ∈ space := by
  let S : Subgroup (GL index K) :=
    { carrier := {actor | ∀ vector : index → K,
        (actor : Matrix index index K).mulVec vector ∈ space ↔ vector ∈ space}
      one_mem' := by
        intro vector
        simp
      mul_mem' := by
        intro a b ha hb vector
        have h1 := ha ((b : Matrix index index K).mulVec vector)
        have h2 := hb vector
        rw [Units.val_mul, ← Matrix.mulVec_mulVec]
        exact h1.trans h2
      inv_mem' := by
        intro a ha vector
        have h1 := ha (((a⁻¹ : GL index K) : Matrix index index K).mulVec vector)
        rw [Matrix.mulVec_mulVec, Units.mul_inv, Matrix.one_mulVec] at h1
        exact h1.symm }
  have hS : rawStabilizer space = S := Subgroup.closure_eq S
  rw [hS]
  exact Iff.rfl

theorem burnsideF4gSpOne_mem_stabilizer_iff {r : ℕ} {K : Type} [Field K]
    (W : Submodule K (Fin r ⊕ Fin r → K)) (g : StatedSp r K) :
    g ∈ stabilizer r K W ↔
      ∀ v : Fin r ⊕ Fin r → K,
        ((g : GL (Fin r ⊕ Fin r) K) : Matrix (Fin r ⊕ Fin r) (Fin r ⊕ Fin r) K).mulVec v ∈ W ↔
          v ∈ W := by
  set A : Matrix (Fin r ⊕ Fin r) (Fin r ⊕ Fin r) K :=
    ((g : GL (Fin r ⊕ Fin r) K) : Matrix (Fin r ⊕ Fin r) (Fin r ⊕ Fin r) K) with hA
  set B : Matrix (Fin r ⊕ Fin r) (Fin r ⊕ Fin r) K :=
    (((g : GL (Fin r ⊕ Fin r) K)⁻¹ : GL (Fin r ⊕ Fin r) K) :
      Matrix (Fin r ⊕ Fin r) (Fin r ⊕ Fin r) K) with hB
  have hBA : B * A = 1 := by rw [hA, hB, ← Units.val_mul, inv_mul_cancel, Units.val_one]
  have hAB : A * B = 1 := by rw [hA, hB, ← Units.val_mul, mul_inv_cancel, Units.val_one]
  rw [mem_stabilizer]
  constructor
  · intro h v
    constructor
    · intro hv
      rw [← h] at hv
      obtain ⟨w, hw, hwv⟩ := hv
      have h2 : A.mulVec w = A.mulVec v := hwv
      have : w = v := by
        calc w = B.mulVec (A.mulVec w) := by rw [Matrix.mulVec_mulVec, hBA, Matrix.one_mulVec]
          _ = B.mulVec (A.mulVec v) := by rw [h2]
          _ = v := by rw [Matrix.mulVec_mulVec, hBA, Matrix.one_mulVec]
      rw [this] at hw
      exact hw
    · intro hv
      rw [← h]
      exact ⟨v, hv, rfl⟩
  · intro h
    ext x
    constructor
    · rintro ⟨w, hw, rfl⟩
      exact (h w).2 hw
    · intro hx
      have hv : B.mulVec x ∈ W := by
        refine (h _).1 ?_
        rw [Matrix.mulVec_mulVec, hAB, Matrix.one_mulVec]
        exact hx
      refine ⟨_, hv, ?_⟩
      show A.mulVec (B.mulVec x) = x
      rw [Matrix.mulVec_mulVec, hAB, Matrix.one_mulVec]

theorem burnsideF4gSpOne_coordinateSpace_flag {K : Type} [Field K] (v : Fin 2 ⊕ Fin 2 → K) :
    (v ∈ coordinateSpace ({Sum.inl 0} : Set (Fin 2 ⊕ Fin 2)) ↔ v ∈ flag 2 K 1) ∧
      (v ∈ coordinateSpace ({Sum.inl 0, Sum.inl 1} : Set (Fin 2 ⊕ Fin 2)) ↔
        v ∈ flag 2 K 2) := by
  rw [mem_flag_of_le (by norm_num), mem_flag_of_le (by norm_num), mem_isoFlag, mem_isoFlag]
  simp only [coordinateSpace, Set.mem_setOf_eq]
  constructor
  · constructor
    · intro h
      refine ⟨fun j => h (Sum.inr j) (by simp), fun j hj => h (Sum.inl j) ?_⟩
      fin_cases j <;> simp_all
    · rintro ⟨h1, h2⟩ pos hpos
      rcases pos with j | j
      · apply h2 j
        fin_cases j <;> simp_all
      · exact h1 j
  · constructor
    · intro h
      refine ⟨fun j => h (Sum.inr j) (by simp), fun j hj => ?_⟩
      exact absurd hj (by have := j.isLt; omega)
    · rintro ⟨h1, -⟩ pos hpos
      rcases pos with j | j
      · exfalso
        apply hpos
        fin_cases j <;> simp
      · exact h1 j

theorem burnsideF4gSpOne_image_one {index : Type} [Fintype index] [DecidableEq index] {K : Type}
    [Field K] (S : Set (index → K)) :
    (fun vector => ((1 : GL index K) : Matrix index index K).mulVec vector) '' S = S := by
  simp

theorem burnsideF4gSpOne_charP_of_card {K : Type} [Field K] [Finite K] {f : ℕ}
    (hK : Nat.card K = 2 ^ f) : CharP K 2 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have := Fintype.ofFinite K
