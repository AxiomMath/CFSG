  constructor
  · intro hx
    obtain ⟨e, he, h | h⟩ := mem_sup_zpowers (E := E.subgroupOf Λ) (x := s)
      (Subtype.ext (by simpa using hs2)) (fun e he => Subtype.ext (hsE e he)) hx
    · rw [h]
      exact Subgroup.mem_sup_left he
    · rw [h]
      exact Subgroup.mul_mem _ (Subgroup.mem_sup_left he)
        (Subgroup.mem_sup_right (Subgroup.mem_zpowers _))
  · intro hx
    obtain ⟨e, he, h | h⟩ := mem_sup_zpowers hs2 hsE hx
    · have : x = ⟨e, hE he⟩ := Subtype.ext h
      rw [this]
      exact Subgroup.mem_sup_left (show (⟨e, hE he⟩ : ↥Λ) ∈ E.subgroupOf Λ from he)
    · have : x = ⟨e, hE he⟩ * s := Subtype.ext h
      rw [this]
      exact Subgroup.mul_mem _
        (Subgroup.mem_sup_left (show (⟨e, hE he⟩ : ↥Λ) ∈ E.subgroupOf Λ from he))
        (Subgroup.mem_sup_right (Subgroup.mem_zpowers _))

theorem burnsideC6h_c64c_mem_normalizer_iff {G : Type} [Group G] {Λ S : Subgroup G}
    {S' : Subgroup ↥Λ} (hSΛ : S ≤ Λ) (hS : ∀ x : ↥Λ, x ∈ S' ↔ (x : G) ∈ S) (g : ↥Λ) :
    g ∈ Subgroup.normalizer (S' : Set ↥Λ) ↔ (g : G) ∈ Subgroup.normalizer (S : Set G) := by
