    intro a haA haE b hb
    by_cases hbE : b ∈ E
    · exact Or.inl hbE
    · right
      obtain ⟨e, he, i, hai⟩ := d.refl_of_sq (hAP haA) (hA2 a haA) haE
      obtain ⟨e', he', j, hbj⟩ := d.refl_of_sq (hAP hb) (hA2 b hb) hbE
      have hab : a * b = e * e' * (s * t) ^ (j - i) := by
        rw [hai, hbj]
        exact hprod e e' he he' i j
      have hba : b * a = e' * e * (s * t) ^ (i - j) := by
        rw [hai, hbj]
        exact hprod e' e he' he j i
