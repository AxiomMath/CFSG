    have hx' : p₀ * l * p₀⁻¹ ∈ LV := (Subgroup.mem_normalizer_iff.1 (hPN hp₀) l).1 hl
    have hord : Odd (orderOf (y⁻¹ * l * y)) := by
      have := burnsideC6h_c64d_orderOf_conj y⁻¹ l
      rw [inv_inv] at this
