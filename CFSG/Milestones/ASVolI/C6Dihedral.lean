    have hlyN : l * y * l⁻¹ ∈ Subgroup.normalizer (P : Set G) :=
      Subgroup.mul_mem _ (Subgroup.mul_mem _ (hLN l hl) hyN) (Subgroup.inv_mem _ (hLN l hl))
    have hp₀ : y⁻¹ * (l * y * l⁻¹) ∈ P := by
      by_cases hyP : y ∈ P
      · exact P.mul_mem (P.inv_mem hyP) (hLP l hl y hyP)
      · have hlyP : l * y * l⁻¹ ∉ P := by
