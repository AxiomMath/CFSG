      _ = e * s * (e' * (s * t) ^ i) * s * (s * t) ^ j := by rw [nf.zpow_comm i e' he']
      _ = e * (s * e') * (s * t) ^ i * s * (s * t) ^ j := by group
      _ = e * (e' * s) * (s * t) ^ i * s * (s * t) ^ j := by rw [d.sE e' he']
      _ = e * e' * (s * (s * t) ^ i * s) * (s * t) ^ j := by group
      _ = e * e' * (s * t) ^ (-i) * (s * t) ^ j := by rw [nf.s_zpow_s i]
