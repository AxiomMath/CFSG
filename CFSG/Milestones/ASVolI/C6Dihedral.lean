theorem burnsideC6h_c64c_mem_sup_zpowers_iff {G : Type} [Group G] {Λ E : Subgroup G}
    (hE : E ≤ Λ) {s : ↥Λ} (hs2 : (s : G) * s = 1) (hsE : ∀ x ∈ E, (s : G) * x = x * s)
    (x : ↥Λ) :
