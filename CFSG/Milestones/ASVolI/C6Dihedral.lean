  constructor
  · intro hg h
    by_cases hh : h ∈ Λ
    · have h1 := hg ⟨h, hh⟩
      rw [hS, hS] at h1
      exact h1
    · have h1 : h ∉ S := fun h' => hh (hSΛ h')
      have h2 : (g : G) * h * (g : G)⁻¹ ∉ S := by
        intro h'
        apply hh
        have h3 := Λ.mul_mem (Λ.mul_mem (Λ.inv_mem g.2) (hSΛ h')) g.2
        simpa [mul_assoc] using h3
      exact ⟨fun h' => absurd h' h1, fun h' => absurd h' h2⟩
  · intro hg h'
    rw [hS, hS]
    exact hg h'

