theorem burnsideC6h_c63_mem_rconj {G : Type} [Group G] {x y : G} {K : Subgroup G} :
    y ∈ ChC.rconj x K ↔ x * y * x⁻¹ ∈ K := by
  unfold ChC.rconj
  rw [CFSG.Quasithin.mem_conjByElt]
  simp

theorem burnsideC6h_c63_rconj_rconj {G : Type} [Group G] (x y : G) (K : Subgroup G) :
    ChC.rconj y (ChC.rconj x K) = ChC.rconj (x * y) K :=
  CFSG.Quasithin.conjSubgroup_conjSubgroup K x y

theorem burnsideC6h_c63_rconj_one {G : Type} [Group G] (K : Subgroup G) : ChC.rconj 1 K = K :=
  CFSG.Quasithin.conjSubgroup_one K

theorem burnsideC6h_c63_rconj_inf {G : Type} [Group G] (A B : Subgroup G) (x : G) :
    ChC.rconj x (A ⊓ B) = ChC.rconj x A ⊓ ChC.rconj x B :=
  CFSG.QuasithinUnique.C5.conjSubgroup_inf A B x

theorem burnsideC6h_c63_rconj_le_iff {G : Type} [Group G] {A B : Subgroup G} {x : G} :
    ChC.rconj x A ≤ ChC.rconj x B ↔ A ≤ B :=
  CFSG.QuasithinUnique.C5.conjSubgroup_le_iff

theorem burnsideC6h_c63_rconj_lt_iff {G : Type} [Group G] {A B : Subgroup G} {x : G} :
    ChC.rconj x A < ChC.rconj x B ↔ A < B := by
  constructor
  · intro h
    refine lt_of_le_of_ne (burnsideC6h_c63_rconj_le_iff.1 h.le) fun heq => h.ne ?_
    rw [heq]
  · intro h
    refine lt_of_le_of_ne (burnsideC6h_c63_rconj_le_iff.2 h.le) fun heq => h.ne ?_
    exact le_antisymm h.le (burnsideC6h_c63_rconj_le_iff.1 heq.ge)

theorem burnsideC6h_c63_rconj_centralizer {G : Type} [Group G] (A : Subgroup G) (x : G) :
    ChC.rconj x (Subgroup.centralizer (A : Set G)) =
      Subgroup.centralizer ((ChC.rconj x A : Subgroup G) : Set G) :=
  CFSG.QuasithinUnique.C5.conjSubgroup_centralizer A x

theorem burnsideC6h_c63_rconj_eq_self {G : Type} [Group G] {K : Subgroup G} {x : G}
    (hx : x ∈ Subgroup.normalizer (K : Set G)) : ChC.rconj x K = K :=
  CFSG.QuasithinUnique.C5.conjSubgroup_eq_self hx

theorem burnsideC6h_c63_relIndex_rconj {G : Type} [Group G] (A B : Subgroup G) (x : G) :
    (ChC.rconj x A).relIndex (ChC.rconj x B) = A.relIndex B :=
  CFSG.QuasithinUnique.C5.relIndex_conjSubgroup A B x

theorem burnsideC6h_c63_finite_of_le {G : Type} [Group G] {A B : Subgroup G} (h : A ≤ B)
    [Finite B] : Finite A :=
  Finite.of_injective (Subgroup.inclusion h) (Subgroup.inclusion_injective h)

theorem burnsideC6h_c63_relIndex_ne_zero {G : Type} [Group G] {H K : Subgroup G} [Finite K] :
    H.relIndex K ≠ 0 :=
  Subgroup.index_ne_zero_of_finite

theorem burnsideC6h_c63_two_pow_le_relIndex {G : Type} [Group G] {R U A : Subgroup G}
    [Finite U] (hU2 : IsPGroup 2 U) (hA : A ≤ U)
    (hlt : R ⊓ Subgroup.centralizer (U : Set G) < R ⊓ Subgroup.centralizer (A : Set G)) :
    2 ^ ChC.mRU R U ≤ A.relIndex U := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨k, hk⟩ := hU2.index (A.subgroupOf U)
  have hk' : A.relIndex U = 2 ^ k := hk
  have hmem : k ∈ {k : ℕ | ∃ A : Subgroup G, A ≤ U ∧ R ⊓ Subgroup.centralizer (U : Set G) <
      R ⊓ Subgroup.centralizer (A : Set G) ∧ A.relIndex U = 2 ^ k} := ⟨A, hA, hlt, hk'⟩
  have hle : ChC.mRU R U ≤ k := Nat.sInf_le hmem
  rw [hk']
  exact Nat.pow_le_pow_right (by norm_num) hle

theorem burnsideC6h_c63_exists_mul_of_relIndex_le {G : Type} [Group G] {U C R : Subgroup G}
    [Finite R] (hU : U ≤ R) (h : C.relIndex R ≤ C.relIndex U) :
    ∀ r ∈ R, ∃ u ∈ U, ∃ c ∈ C, r = u * c := by
  intro r hr
  have hinj := (Subgroup.quotientSubgroupOfEmbeddingOfLE C hU).injective
  have e1 : Nat.card (↥R ⧸ C.subgroupOf R) = C.relIndex R := (Subgroup.index_eq_card _).symm
  have e2 : Nat.card (↥U ⧸ C.subgroupOf U) = C.relIndex U := (Subgroup.index_eq_card _).symm
  have hbij : Function.Bijective (Subgroup.quotientSubgroupOfEmbeddingOfLE C hU) :=
    hinj.bijective_of_nat_card_le (by rw [e1, e2]; exact h)
  obtain ⟨a, ha⟩ := hbij.2 (QuotientGroup.mk ⟨r, hr⟩)
  obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective a
  rw [Subgroup.quotientSubgroupOfEmbeddingOfLE_apply_mk, QuotientGroup.eq] at ha
  refine ⟨u, u.2, (u : G)⁻¹ * r, ?_, by simp⟩
  simpa [Subgroup.mem_subgroupOf] using ha

theorem burnsideC6h_c63_relIndex_sup_eq {G : Type} [Group G] {X T : Subgroup G}
    (hT : T ≤ Subgroup.normalizer (X : Set G)) : T.relIndex (X ⊔ T) = T.relIndex X := by
  have hXW : X ≤ X ⊔ T := le_sup_left
  have hsurj : Function.Surjective (Subgroup.quotientSubgroupOfEmbeddingOfLE T hXW) := by
    intro q
    obtain ⟨w, rfl⟩ := QuotientGroup.mk_surjective q
    have hw : (w : G) ∈ ((X ⊔ T : Subgroup G) : Set G) := w.2
    rw [Subgroup.coe_mul_of_right_le_normalizer_left X T hT] at hw
    obtain ⟨a, ha, t, ht, hat⟩ := hw
    refine ⟨QuotientGroup.mk ⟨a, ha⟩, ?_⟩
    rw [Subgroup.quotientSubgroupOfEmbeddingOfLE_apply_mk, QuotientGroup.eq]
    have : a⁻¹ * (w : G) = t := by rw [← hat]; simp
    simpa [Subgroup.mem_subgroupOf, this] using ht
  have hbij : Function.Bijective (Subgroup.quotientSubgroupOfEmbeddingOfLE T hXW) :=
    ⟨(Subgroup.quotientSubgroupOfEmbeddingOfLE T hXW).injective, hsurj⟩
  have := Nat.card_congr (Equiv.ofBijective _ hbij)
  rw [Subgroup.relIndex, Subgroup.relIndex, Subgroup.index_eq_card, Subgroup.index_eq_card]
  exact this.symm

theorem burnsideC6h_c63_relIndex_of_quotHas {G : Type} [Group G] {R Q : Subgroup G} {n : ℕ}
    (h : ChC.QuotHas R Q (fun Y _ => CFSG.Quasithin.IsE2 n Y)) : Q.relIndex R = 2 ^ n := by
  obtain ⟨Y, _, φ, hφ, hker, ⟨e⟩⟩ := h
  have h1 : Q.relIndex R = Nat.card Y := by
    rw [Subgroup.relIndex, ← hker, Subgroup.index_eq_card]
    exact Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective φ hφ).toEquiv
  rw [h1, Nat.card_congr e.toEquiv]
  simp [Nat.card_eq_fintype_card]

theorem burnsideC6h_c63_inf_centralizer_rconj {G : Type} [Group G] {R : Subgroup G} {x : G}
    (hx : x ∈ Subgroup.normalizer (R : Set G)) (B : Subgroup G) :
    R ⊓ Subgroup.centralizer ((ChC.rconj x B : Subgroup G) : Set G) =
      ChC.rconj x (R ⊓ Subgroup.centralizer (B : Set G)) := by
  rw [burnsideC6h_c63_rconj_inf, burnsideC6h_c63_rconj_eq_self hx,
    burnsideC6h_c63_rconj_centralizer]

theorem burnsideC6h_c63_mRU_set_subset {G : Type} [Group G] {R U : Subgroup G} {x : G}
    (hx : x ∈ Subgroup.normalizer (R : Set G)) {k : ℕ}
    (hk : k ∈ {k : ℕ | ∃ A : Subgroup G, A ≤ U ∧ R ⊓ Subgroup.centralizer (U : Set G) <
      R ⊓ Subgroup.centralizer (A : Set G) ∧ A.relIndex U = 2 ^ k}) :
    k ∈ {k : ℕ | ∃ A : Subgroup G, A ≤ ChC.rconj x U ∧
      R ⊓ Subgroup.centralizer ((ChC.rconj x U : Subgroup G) : Set G) <
        R ⊓ Subgroup.centralizer (A : Set G) ∧ A.relIndex (ChC.rconj x U) = 2 ^ k} := by
  obtain ⟨A, hA, hlt, hidx⟩ := hk
  refine ⟨ChC.rconj x A, burnsideC6h_c63_rconj_le_iff.2 hA, ?_, ?_⟩
  · rw [burnsideC6h_c63_inf_centralizer_rconj hx, burnsideC6h_c63_inf_centralizer_rconj hx]
    exact burnsideC6h_c63_rconj_lt_iff.2 hlt
  · rw [burnsideC6h_c63_relIndex_rconj]
    exact hidx

theorem burnsideC6h_c63_mRU_rconj {G : Type} [Group G] {R U : Subgroup G} {x : G}
    (hx : x ∈ Subgroup.normalizer (R : Set G)) :
    ChC.mRU R (ChC.rconj x U) = ChC.mRU R U := by
  unfold ChC.mRU
  congr 1
  ext k
  constructor
  · intro hk
    have := burnsideC6h_c63_mRU_set_subset (R := R) (U := ChC.rconj x U) (x := x⁻¹)
      (inv_mem hx) hk
    rwa [burnsideC6h_c63_rconj_rconj, mul_inv_cancel, burnsideC6h_c63_rconj_one] at this
  · exact burnsideC6h_c63_mRU_set_subset hx

theorem burnsideC6h_c63_rconj_le_of_normalizer {G : Type} [Group G] {R U : Subgroup G} {x : G}
    (hx : x ∈ Subgroup.normalizer (R : Set G)) (hU : U ≤ R) : ChC.rconj x U ≤ R := by
  have := burnsideC6h_c63_rconj_le_iff (x := x).2 hU
  rwa [burnsideC6h_c63_rconj_eq_self hx] at this

theorem burnsideC6h_c63_isPGroup_rconj {G : Type} [Group G] {U : Subgroup G} (x : G)
    (hU : IsPGroup 2 U) : IsPGroup 2 (ChC.rconj x U) :=
  hU.map (MulAut.conj x⁻¹).toMonoidHom

theorem burnsideC6h_c63_part2_pow {G : Type} [Group G] {R U Q : Subgroup G} {x : G}
    [Finite R] (hxR : x ∈ Subgroup.normalizer (R : Set G)) (hUR : U ≤ R) (hU2 : IsPGroup 2 U)
    (hCQ : R ⊓ Subgroup.centralizer (U : Set G) ≤ Q) (hxQ : ¬ ChC.rconj x U ≤ Q) :
    2 ^ ChC.mRU R U ≤
      (ChC.rconj x U ⊓ Subgroup.centralizer (U : Set G)).relIndex (ChC.rconj x U) := by
  have hVR : ChC.rconj x U ≤ R := burnsideC6h_c63_rconj_le_of_normalizer hxR hUR
  haveI : Finite (ChC.rconj x U) := burnsideC6h_c63_finite_of_le hVR
  have hV2 : IsPGroup 2 (ChC.rconj x U) := burnsideC6h_c63_isPGroup_rconj x hU2
  have hA'V : ChC.rconj x U ⊓ Subgroup.centralizer (U : Set G) ≤ ChC.rconj x U := inf_le_left
  have hlt : R ⊓ Subgroup.centralizer ((ChC.rconj x U : Subgroup G) : Set G) <
      R ⊓ Subgroup.centralizer ((ChC.rconj x U ⊓ Subgroup.centralizer (U : Set G) : Subgroup G) :
        Set G) := by
    refine lt_of_le_of_ne (inf_le_inf_left R (Subgroup.centralizer_le
      (SetLike.coe_subset_coe.mpr hA'V))) fun heq => ?_
    have hU1 : U ≤ R ⊓ Subgroup.centralizer ((ChC.rconj x U ⊓ Subgroup.centralizer (U : Set G) :
        Subgroup G) : Set G) := by
      refine le_inf hUR fun u hu => ?_
      rw [Subgroup.mem_centralizer_iff]
      intro a ha
      exact ((Subgroup.mem_centralizer_iff.1 ha.2) u hu).symm
    rw [← heq] at hU1
    apply hxQ
    refine le_trans (le_inf hVR fun v hv => ?_) hCQ
    rw [Subgroup.mem_centralizer_iff]
    intro u hu
    exact ((Subgroup.mem_centralizer_iff.1 (hU1 hu).2) v hv).symm
  have h1 := burnsideC6h_c63_two_pow_le_relIndex (R := R) hV2 hA'V hlt
  rwa [burnsideC6h_c63_mRU_rconj hxR] at h1

theorem burnsideC6h_c63_part2 {G : Type} [Group G] {R U Q : Subgroup G} {x : G}
    [Finite R] (hxR : x ∈ Subgroup.normalizer (R : Set G)) (hUR : U ≤ R) (hU2 : IsPGroup 2 U)
    (hCQ : R ⊓ Subgroup.centralizer (U : Set G) ≤ Q) (hxQ : ¬ ChC.rconj x U ≤ Q) :
    ChC.mRU R U ≤
      Nat.log 2 ((ChC.rconj x U ⊓ Subgroup.centralizer (U : Set G)).relIndex (ChC.rconj x U)) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hVR : ChC.rconj x U ≤ R := burnsideC6h_c63_rconj_le_of_normalizer hxR hUR
  haveI : Finite (ChC.rconj x U) := burnsideC6h_c63_finite_of_le hVR
  have hV2 : IsPGroup 2 (ChC.rconj x U) := burnsideC6h_c63_isPGroup_rconj x hU2
  have h1 := burnsideC6h_c63_part2_pow hxR hUR hU2 hCQ hxQ
