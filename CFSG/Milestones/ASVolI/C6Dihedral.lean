theorem burnsideC6h_c64c_dih_iff {G : Type} [Group G] {Λ E : Subgroup G} (hE : E ≤ Λ)
    {s t u : ↥Λ} {k : ℕ} :
    DihData (E.subgroupOf Λ) s t u k ↔ DihData E (s : G) (t : G) (u : G) k := by
  constructor
  · intro d
    refine ⟨fun x hx => ?_, fun x hx x' hx' => ?_, ?_, ?_, fun x hx => ?_, fun x hx => ?_, ?_, ?_,
      ?_⟩
    · exact congrArg Subtype.val (d.sq ⟨x, hE hx⟩ hx)
    · exact congrArg Subtype.val (d.comm ⟨x, hE hx⟩ hx ⟨x', hE hx'⟩ hx')
    · exact congrArg Subtype.val d.s2
    · exact congrArg Subtype.val d.t2
    · exact congrArg Subtype.val (d.sE ⟨x, hE hx⟩ hx)
    · exact congrArg Subtype.val (d.tE ⟨x, hE hx⟩ hx)
    · simpa using congrArg Subtype.val d.pow
    · exact d.uE
    · intro h
      exact d.u1 (Subtype.ext h)
  · intro d
    refine ⟨fun x hx => ?_, fun x hx x' hx' => ?_, ?_, ?_, fun x hx => ?_, fun x hx => ?_, ?_, ?_,
      ?_⟩
    · exact Subtype.ext (by simpa using d.sq x hx)
    · exact Subtype.ext (d.comm x hx x' hx')
    · exact Subtype.ext d.s2
    · exact Subtype.ext d.t2
    · exact Subtype.ext (d.sE x hx)
    · exact Subtype.ext (d.tE x hx)
    · exact Subtype.ext (by simpa using d.pow)
    · exact d.uE
    · intro h
      exact d.u1 (congrArg Subtype.val h)

