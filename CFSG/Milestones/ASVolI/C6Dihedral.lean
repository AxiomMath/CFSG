theorem burnsideC6h_c64c_card_le_of_le {K : Type} [Group K] [Finite K] {E A : Subgroup K}
    {s t u : K} {k : ℕ} (d : DihData E s t u k) (hA2 : ∀ a ∈ A, a * a = 1)
