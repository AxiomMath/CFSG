open CFSG.Quasithin CFSG.Quasithin.A38c15 CFSG.QuasithinUnique CFSG.QuasithinUnique.Vol2Native.A312L in
private theorem burnsideA318_c9c10_of_sylowCore {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {X : Type}
    [Group X] [Finite X] (hq : CFSG.IsQuasisimple X) (hX : IsPSL 3 p 1 X ∨ IsSL3 p X)
    (hc : SylowCore p X) {T B : Subgroup X} (hT : IsSylowTwoOf T ⊤) (hB : B ∈ lFamily T)
    (hBtop : B ≠ ⊤) : A312C9 B ⊤ ∨ A312C10 B ⊤ := by
  have : Fact p.Prime := ⟨hp⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hB' : B ∈ cComp (B ⊔ T) := hB
  have hMne : B ⊔ T ≠ ⊤ := by
    intro htop
    rw [htop] at hB'
    exact hBtop (A321.cComp_eq_top_of_quasisimple hq hB')
  have hodd : Odd (B ⊔ T).index := odd_index_of_le_isSylowTwoOf hT le_sup_right
  rcases hc (B ⊔ T) hodd hMne with hsolv | hLevi
  · exfalso
    exact not_isSolvable_of_mem_cComp hB'
      (Group.isSolvable_of_isSolvable_injective
        (f := Subgroup.inclusion (le_of_mem_cComp hB' : B ≤ B ⊔ T))
        (Subgroup.inclusion_injective _))
  · have hperf : Group.IsPerfect ↥(perfectCore (B ⊔ T)) :=
      Subgroup.isPerfect_iff.mpr (perfectCore_perfect (B ⊔ T))
    have hp3 : p ≠ 3 := ne_three_of_leviBlock hLevi
    have hp5 : 3 < p := by
      have := hp.two_le
      omega
    obtain ⟨f, hf, hker⟩ := exists_hom_psl2_of_leviBlock hLevi
    have hS : IsSimpleGroup (Matrix.ProjectiveSpecialLinearGroup (Fin 2) (ZMod p)) :=
      CFSG.ComponentClassification.CatalogueBGeneralLinear.projectiveSpecialLinear_simple 2
        (ZMod p) le_rfl (Or.inr (by rw [Nat.card_zmod]; omega))
        (Or.inr (by rw [Nat.card_zmod]; omega))
    have hnab : ∃ a b : Matrix.ProjectiveSpecialLinearGroup (Fin 2) (ZMod p), a * b ≠ b * a :=
      CFSG.ComponentClassification.CatalogueBSmallRee.projectiveSpecialLinear_two_nonabelian
        (ZMod p) (by rw [Nat.card_zmod]; omega) (by rw [Nat.card_zmod]; omega)
    have hBeq : B = perfectCore (B ⊔ T) := lFamily_eq_perfectCore hB hnab f hf hker
    have hBLevi : IsLeviBlock p ↥B :=
      IsLeviBlock.of_mulEquiv (MulEquiv.subgroupCongr hBeq.symm) hLevi
    have hLtop : IsPSL 3 p 1 ↥(⊤ : Subgroup X) ∨ IsSL3 p ↥(⊤ : Subgroup X) := by
      rcases hX with h | h
      · exact Or.inl (IsPSL.of_mulEquiv Subgroup.topEquiv.symm h)
      · exact Or.inr (IsSL3.of_mulEquiv Subgroup.topEquiv.symm h)
    rcases hBLevi with h | h
    · left
      left
      refine ⟨true, p, hp, hp5, h, ?_⟩
      rcases hLtop with h' | h'
      · exact Or.inl h'
      · exact Or.inr h'
    · right
      exact ⟨p, hp, hp5, h, hLtop⟩

open CFSG.Quasithin CFSG.Quasithin.A312U3 CFSG.Quasithin.A38c15 CFSG.QuasithinUnique CFSG.QuasithinUnique.Vol2Native.A312L in
private theorem burnsideA318_c9_of_su (hirr : SU3OddIrr) {p : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) {X : Type} [Group X] [Finite X] (hq : CFSG.IsQuasisimple X)
    (hX : IsSU3 p X) {T B : Subgroup X} (hT : IsSylowTwoOf T ⊤) (hB : B ∈ lFamily T)
    (hBtop : B ≠ ⊤) : A312C9 B ⊤ ∨ A312C10 B ⊤ := by
  have : Fact p.Prime := ⟨hp⟩
  have hc : ∀ M : Subgroup X, Odd M.index → M ≠ ⊤ → Group.IsSolvable ↥M ∨
      IsSL2 p ↥(perfectCore M) ∨
        (p = 5 ∧ IsHat ↥(perfectCore M) (alternatingGroup (Fin 6))) := by
    obtain ⟨K, _, _, hK, ⟨e⟩⟩ := id hX
    have hpow : StatedSU 3 (p ^ 1) K = StatedSU 3 p K := by rw [pow_one]
    let e1 : X ≃* ↥(CFSG.ClassicalGroups.UnitaryFlag.unitarySU p 1 K 3) :=
      e.trans (MulEquiv.subgroupCongr hpow.symm)
    intro M hodd hne
    obtain ⟨hodd', hne'⟩ := odd_ne_top_map e1 hodd hne
    have hC := coreC_of_odd hirr hp2 hK (M.map e1.toMonoidHom) hodd' hne'
    have h' : Group.IsSolvable ↥(M.map e1.toMonoidHom) ∨
        (IsSL2 p ↥(perfectCore (M.map e1.toMonoidHom)) ∨
          (p = 5 ∧ IsHat ↥(perfectCore (M.map e1.toMonoidHom)) (alternatingGroup (Fin 6)))) := by
      rcases hC with hs | hSL | ⟨hp5, hHat, -⟩
      · exact Or.inl hs
      · exact Or.inr (Or.inl hSL)
      · exact Or.inr (Or.inr ⟨hp5, hHat⟩)
    exact core_of_equiv e1
      (P := fun K _ => IsSL2 p K ∨ (p = 5 ∧ IsHat K (alternatingGroup (Fin 6))))
      (fun K L _ _ f h => by
        rcases h with h | ⟨h5, h6⟩
        · exact Or.inl (IsSL2.of_mulEquiv f h)
        · exact Or.inr ⟨h5, IsHat.of_mulEquiv f h6⟩) h'
  have hLtop : IsSU3 p ↥(⊤ : Subgroup X) := IsSU3.of_mulEquiv Subgroup.topEquiv.symm hX
  obtain ⟨hBeq, hcore⟩ := lFamily_block hq hp hp2
    (blocks := fun K _ => p = 5 ∧ IsHat K (alternatingGroup (Fin 6)))
    (fun K _ h => exists_hom_alt6_of_isHat h.2) hc hT hB hBtop
  rcases hcore with ⟨hSL, hp3⟩ | ⟨hp5, hHat⟩
  · have hBSL : IsSL2 p ↥B := IsSL2.of_mulEquiv (MulEquiv.subgroupCongr hBeq.symm) hSL
    exact Or.inl (Or.inl ⟨false, p, hp, hp3, hBSL, Or.inr hLtop⟩)
  · subst hp5
    have hBHat : IsHat ↥B (alternatingGroup (Fin 6)) :=
      IsHat.of_mulEquiv (MulEquiv.subgroupCongr hBeq.symm) hHat
    exact Or.inl (Or.inr (Or.inr ⟨hBHat, hLtop⟩))

open CFSG.Quasithin CFSG.Quasithin.A312U3 CFSG.Quasithin.A38c15 CFSG.QuasithinUnique CFSG.QuasithinUnique.Vol2Native.A312L in
private theorem burnsideA318_c9_of_psu (hirr : SU3OddIrr) {p : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) {X : Type} [Group X] [Finite X] (hq : CFSG.IsQuasisimple X)
    (hX : IsPSU 3 p 1 X) {T B : Subgroup X} (hT : IsSylowTwoOf T ⊤) (hB : B ∈ lFamily T)
    (hBtop : B ≠ ⊤) : A312C9 B ⊤ ∨ A312C10 B ⊤ := by
  have : Fact p.Prime := ⟨hp⟩
  have hc : ∀ M : Subgroup X, Odd M.index → M ≠ ⊤ → Group.IsSolvable ↥M ∨
      IsSL2 p ↥(perfectCore M) ∨ (p = 5 ∧ IsAlt 6 ↥(perfectCore M)) := by
    obtain ⟨-, K, _, _, hK, ⟨e⟩⟩ := id hX
    have hF : Nat.card K = p ^ 2 := by simpa [pow_one] using hK
    intro M hodd hne
    obtain ⟨hodd', hne'⟩ := odd_ne_top_map e hodd hne
    have hC := coreProj_of_coreC hp2 hF (fun M hodd hne => coreC_of_odd hirr hp2 hF M hodd hne)
      (M.map e.toMonoidHom) hodd' hne'
    exact core_of_equiv e (P := fun K _ => IsSL2 p K ∨ (p = 5 ∧ IsAlt 6 K))
      (fun K L _ _ f h => by
        rcases h with h | ⟨h5, h6⟩
        · exact Or.inl (IsSL2.of_mulEquiv f h)
        · exact Or.inr ⟨h5, IsAlt.of_mulEquiv f h6⟩) hC
  have hLtop : IsPSU 3 p 1 ↥(⊤ : Subgroup X) := IsPSU.of_mulEquiv Subgroup.topEquiv.symm hX
  obtain ⟨hBeq, hcore⟩ := lFamily_block hq hp hp2
    (blocks := fun K _ => p = 5 ∧ IsAlt 6 K)
    (fun K _ h => by
      obtain ⟨-, ⟨φ⟩⟩ := h
      exact ⟨φ.toMonoidHom, φ.surjective, by
        have : φ.toMonoidHom.ker = ⊥ := (MonoidHom.ker_eq_bot_iff _).mpr φ.injective
        rw [this]
        infer_instance⟩) hc hT hB hBtop
  rcases hcore with ⟨hSL, hp3⟩ | ⟨hp5, hAlt⟩
  · have hBSL : IsSL2 p ↥B := IsSL2.of_mulEquiv (MulEquiv.subgroupCongr hBeq.symm) hSL
    exact Or.inl (Or.inl ⟨false, p, hp, hp3, hBSL, Or.inl hLtop⟩)
  · subst hp5
    have hBAlt : IsAlt 6 ↥B := IsAlt.of_mulEquiv (MulEquiv.subgroupCongr hBeq.symm) hAlt
    exact Or.inl (Or.inr (Or.inl ⟨hBAlt, hLtop⟩))

private theorem burnsideA318_section_of_central {H : Type} [Group H]
    (hodd : ∀ (E : Type) [Group E] [Finite E] (π : E →* H), Function.Surjective π →
      π.ker ≤ Subgroup.center E → Odd (Nat.card π.ker) → ∃ s : H →* E, ∀ g, π (s g) = g)
    (htwo : ∀ (E : Type) [Group E] [Finite E] (π : E →* H), Function.Surjective π →
      π.ker ≤ Subgroup.center E → IsPGroup 2 π.ker → ∃ s : H →* E, ∀ g, π (s g) = g)
    {E : Type} [Group E] [Finite E] (π : E →* H) (hπ : Function.Surjective π)
    (hcen : π.ker ≤ Subgroup.center E) : ∃ s : H →* E, ∀ g, π (s g) = g := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨Q⟩ := (inferInstance : Nonempty (Sylow 2 ↥π.ker))
  set P : Subgroup E := (Q : Subgroup ↥π.ker).map π.ker.subtype with hPdef
  have hPK : P ≤ π.ker := Subgroup.map_subtype_le _
  have hP2 : IsPGroup 2 ↥P := Q.isPGroup'.map π.ker.subtype
  have hPn : P.Normal := Subgroup.normal_of_le_center (hPK.trans hcen)
  let π₁ : E ⧸ P →* H :=
    QuotientGroup.lift P π (fun x hx => MonoidHom.mem_ker.mp (hPK hx))
  have hπ₁ : Function.Surjective π₁ := fun h => by
    obtain ⟨e, rfl⟩ := hπ h
    exact ⟨QuotientGroup.mk e, rfl⟩
  have hker₁ : π₁.ker ≤ Subgroup.center (E ⧸ P) := by
    intro q hq
    obtain ⟨e, rfl⟩ := QuotientGroup.mk_surjective q
    have he : e ∈ π.ker := hq
    have hec := hcen he
    rw [Subgroup.mem_center_iff]
    intro g'
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective g'
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, Subgroup.mem_center_iff.1 hec g]
  have hodd₁ : Odd (Nat.card π₁.ker) := by
    let g : ↥π.ker →* E ⧸ P := (QuotientGroup.mk' P).comp π.ker.subtype
    have hgrange : g.range = π₁.ker := by
      ext x
      constructor
      · rintro ⟨k, rfl⟩
        exact k.2
      · intro hx
        obtain ⟨e, rfl⟩ := QuotientGroup.mk_surjective x
        exact ⟨⟨e, hx⟩, rfl⟩
    have hgker : g.ker = (Q : Subgroup ↥π.ker) := by
      ext k
      constructor
      · intro hk
        obtain ⟨y, hy, hyk⟩ := (QuotientGroup.eq_one_iff (k : E)).mp hk
        have : y = k := Subtype.ext hyk
        exact this ▸ hy
      · intro hk
        exact (QuotientGroup.eq_one_iff (k : E)).mpr ⟨k, hk, rfl⟩
    have hcard : Nat.card π₁.ker = (Q : Subgroup ↥π.ker).index := by
      rw [← hgrange, ← hgker, Subgroup.index_eq_card]
      exact (Nat.card_congr (QuotientGroup.quotientKerEquivRange g).toEquiv).symm
    rw [hcard]
    exact Nat.odd_iff.mpr (by have := Q.not_dvd_index; omega)
  obtain ⟨σ₁, hσ₁⟩ := hodd (E ⧸ P) π₁ hπ₁ hker₁ hodd₁
  let M : Subgroup E := σ₁.range.comap (QuotientGroup.mk' P)
  let πM : ↥M →* H := π.comp M.subtype
  have hπM : Function.Surjective πM := fun h => by
    obtain ⟨e, he⟩ := QuotientGroup.mk_surjective (σ₁ h)
    refine ⟨⟨e, ⟨h, he.symm⟩⟩, ?_⟩
    change π e = h
    have h1 : π₁ (QuotientGroup.mk e) = h := by rw [he, hσ₁]
    exact h1
  have hkerM : πM.ker ≤ Subgroup.center ↥M := by
    intro m hm
    rw [Subgroup.mem_center_iff]
    intro m'
    apply Subtype.ext
    exact Subgroup.mem_center_iff.mp (hcen (hm : π (m : E) = 1)) (m' : E)
  have hgP : ∀ m : ↥πM.ker, ((m : ↥M) : E) ∈ P := by
    intro m
    obtain ⟨h, hh⟩ := m.1.2
    have h1 : h = 1 := by
      have h2 : π₁ (QuotientGroup.mk ((m : ↥M) : E)) = 1 := m.2
      have h3 : σ₁ h = QuotientGroup.mk ((m : ↥M) : E) := hh
      rw [← h3, hσ₁] at h2
      exact h2
    rw [h1, map_one] at hh
    exact (QuotientGroup.eq_one_iff _).mp hh.symm
  have hPM : IsPGroup 2 ↥πM.ker := fun g => by
    obtain ⟨k, hk⟩ := hP2 ⟨((g : ↥M) : E), hgP g⟩
    exact ⟨k, Subtype.ext (Subtype.ext (by simpa using congrArg Subtype.val hk))⟩
  obtain ⟨s, hs⟩ := htwo ↥M πM hπM hkerM hPM
  exact ⟨M.subtype.comp s, fun g => hs g⟩

private theorem burnsideA318_cover_map {H L : Type} [Group H] [Finite H] [Group L] [Finite L]
    [Group.IsPerfect L] {D : Subgroup H} [D.Normal]
    (e : L ⧸ Subgroup.center L ≃* H ⧸ D)
    (hsplit : ∀ (E : Type) [Group E] [Finite E] (π : E →* H), Function.Surjective π →
      π.ker ≤ Subgroup.center E → ∃ s : H →* E, ∀ g, π (s g) = g) :
    ∃ φ : H →* L, Function.Surjective φ ∧ φ.ker ≤ D ∧ D.map φ = Subgroup.center L := by
  obtain ⟨hsurj, hcen, -⟩ := CFSG.SectionRank.EvenCover.pullbackFst_centralQuotientMap e
  obtain ⟨σ, hσ⟩ := hsplit _ _ hsurj hcen
  exact CFSG.SectionRank.EvenCover.perfect_cover_map_of_section e σ hσ

private theorem burnsideA318_iso_of_cover {H L : Type} [Group H] [Finite H] [Group L] [Finite L]
    {D : Subgroup H} [D.Normal] (hD : Nat.card D ∣ 3) {φ : H →* L} (hφ : Function.Surjective φ)
    (hker : φ.ker ≤ D) (hmap : D.map φ = Subgroup.center L) :
    Nonempty (L ≃* H ⧸ D) ∨ Nonempty (L ≃* H) := by
  by_cases hZ : Subgroup.center L = ⊥
  · left
    have hDle : D ≤ φ.ker := by
      intro x hx
      have : φ x ∈ D.map φ := ⟨x, hx, rfl⟩
      rw [hmap, hZ, Subgroup.mem_bot] at this
      exact this
    have hDeq : φ.ker = D := le_antisymm hker hDle
    exact ⟨((QuotientGroup.quotientKerEquivOfSurjective φ hφ).symm).trans
      (QuotientGroup.quotientMulEquivOfEq hDeq)⟩
  · right
    have hker1 : φ.ker = ⊥ := by
      by_contra hne
      have hkc : Nat.card φ.ker ∣ 3 := (Subgroup.card_dvd_of_le hker).trans hD
      have hk1 : Nat.card φ.ker ≠ 1 := fun h => hne (Subgroup.eq_bot_of_card_eq _ h)
      have hk3 : Nat.card φ.ker = 3 := by
        rcases (Nat.dvd_prime Nat.prime_three).mp hkc with h | h
        · exact absurd h hk1
        · exact h
      have hD3 : Nat.card D = 3 := by
        have h1 : 3 ∣ Nat.card D := hk3 ▸ Subgroup.card_dvd_of_le hker
        exact Nat.dvd_antisymm hD h1
      have hDeq : φ.ker = D := Subgroup.eq_of_le_of_card_ge hker (by rw [hk3, hD3])
      apply hZ
      rw [← hmap, ← hDeq]
      exact (Subgroup.map_eq_bot_iff _).mpr le_rfl
    exact ⟨(MulEquiv.ofBijective φ ⟨(MonoidHom.ker_eq_bot_iff φ).mp hker1, hφ⟩).symm⟩

open CFSG.Quasithin CFSG.QuasithinUnique.Ch1 in
private theorem burnsideA318_reduction_psl {L : Type} [Group L] [Finite L]
    (hq : CFSG.IsQuasisimple L) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (h : IsPSL 3 p 1 (L ⧸ Subgroup.center L)) : IsPSL 3 p 1 L ∨ IsSL3 p L := by
  have : Fact p.Prime := ⟨hp⟩
  have : Group.IsPerfect L := hq.1
  obtain ⟨hadm, K, _, _, hK, ⟨e⟩⟩ := id h
  have hK' : Nat.card K = p := by rw [hK, pow_one]
  have := Fintype.ofFinite K
  have : CharP K p := charP_of_card_eq_prime_pow (f := 1) (by
    rw [← Nat.card_eq_fintype_card, hK])
  have hk : ringChar K ≠ 2 := by
    rw [ringChar.eq K p]
    exact hp2
  have hsplit : ∀ (E : Type) [Group E] [Finite E] (π : E →* ↥(StatedSL 3 K)),
      Function.Surjective π → π.ker ≤ Subgroup.center E →
        ∃ s : ↥(StatedSL 3 K) →* E, ∀ g, π (s g) = g := by
    intro E _ _ π hπ hC
    refine burnsideA318_section_of_central ?_ ?_ π hπ hC
    · intro E' _ _ π' hπ' hC' hodd
      obtain ⟨⟨s, hs, -⟩, -⟩ :=
        CFSG.SectionRank.OddCover.prime_classical_three_central_odd_extension_splitting hp hp2
          (Or.inl ⟨rfl, hK', rfl⟩) π' hπ' hC' hodd
      exact ⟨s, fun g => DFunLike.congr_fun hs g⟩
    · intro E' _ _ π' hπ' hC' h2
      let ι := CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 3 K
      let π'' : E' →* Matrix.SpecialLinearGroup (Fin (2 + 1)) K := ι.symm.toMonoidHom.comp π'
      have hπ'' : Function.Surjective π'' := ι.symm.surjective.comp hπ'
      have hker : π''.ker = π'.ker := by
        ext x
        rw [MonoidHom.mem_ker, MonoidHom.mem_ker]
        change ι.symm (π' x) = 1 ↔ _
        rw [MulEquiv.map_eq_one_iff]
      obtain ⟨σ, hσ, -⟩ := CFSG.LieType.Steinberg.sl_central_two_extension_splitting 2 hk hπ''
        (hker ▸ hC') (hker ▸ h2)
      refine ⟨σ.comp ι.symm.toMonoidHom, fun x => ?_⟩
      have := hσ (ι.symm x)
      change ι.symm (π' (σ (ι.symm x))) = ι.symm x at this
      exact ι.symm.injective this
  obtain ⟨φ, hφ, hker, hmap⟩ := burnsideA318_cover_map e hsplit
  have hD := card_scalars_dvd_three (F := K) (p := p) (f := 1) (Or.inl ⟨hK, rfl⟩)
  rcases burnsideA318_iso_of_cover hD hφ hker hmap with ⟨⟨e'⟩⟩ | ⟨⟨e'⟩⟩
  · exact Or.inl ⟨hadm, K, inferInstance, inferInstance, hK, ⟨e'⟩⟩
  · exact Or.inr ⟨K, inferInstance, inferInstance, hK', ⟨e'⟩⟩

open CFSG.Quasithin CFSG.QuasithinUnique.Ch1 in
private theorem burnsideA318_reduction_psu {L : Type} [Group L] [Finite L]
    (hq : CFSG.IsQuasisimple L) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (h : IsPSU 3 p 1 (L ⧸ Subgroup.center L)) : IsPSU 3 p 1 L ∨ IsSU3 p L := by
  have : Fact p.Prime := ⟨hp⟩
  have : Group.IsPerfect L := hq.1
  obtain ⟨hadm, K, _, _, hK, ⟨e⟩⟩ := id h
  have hK2 : Nat.card K = p ^ 2 := by rw [hK, pow_one]
  have := Fintype.ofFinite K
  have : CharP K p := charP_of_card_eq_prime_pow (f := 2) (by
    rw [← Nat.card_eq_fintype_card, hK2])
  have hsplit : ∀ (E : Type) [Group E] [Finite E] (π : E →* ↥(StatedSU 3 (p ^ 1) K)),
      Function.Surjective π → π.ker ≤ Subgroup.center E →
        ∃ s : ↥(StatedSU 3 (p ^ 1) K) →* E, ∀ g, π (s g) = g := by
    intro E _ _ π hπ hC
    refine burnsideA318_section_of_central ?_ ?_ π hπ hC
    · have key : ∀ q : ℕ, q = p → ∀ (E : Type) [Group E] [Finite E] (π : E →* ↥(StatedSU 3 q K)),
          Function.Surjective π → π.ker ≤ Subgroup.center E → Odd (Nat.card π.ker) →
            ∃ s : ↥(StatedSU 3 q K) →* E, ∀ g, π (s g) = g := by
        rintro q rfl E _ _ π hπ hC hodd
        obtain ⟨⟨s, hs, -⟩, -⟩ :=
          CFSG.SectionRank.OddCover.prime_classical_three_central_odd_extension_splitting hp hp2
            (Or.inr ⟨rfl, hK2, rfl⟩) π hπ hC hodd
        exact ⟨s, fun g => DFunLike.congr_fun hs g⟩
      exact key (p ^ 1) (pow_one p)
    · intro E' _ _ π' hπ' hC' h2
      let ι := CFSG.LieType.Universal.Unitary.equivStatedSU hK 3
      let π'' : E' →* CFSG.LieType.Universal.Unitary.SU
          (CFSG.LieType.BorelTits.unitaryInvolution K p 1) 3 := ι.symm.toMonoidHom.comp π'
      have hπ'' : Function.Surjective π'' := ι.symm.surjective.comp hπ'
      have hker : π''.ker = π'.ker := by
        ext x
        rw [MonoidHom.mem_ker, MonoidHom.mem_ker]
        change ι.symm (π' x) = 1 ↔ _
        rw [MulEquiv.map_eq_one_iff]
      obtain ⟨σ, hσ, -⟩ := CFSG.LieType.Steinberg.su_central_two_extension_splitting hK hp2
        (n := 3) (by omega) hπ'' (hker ▸ hC') (hker ▸ h2)
      refine ⟨σ.comp ι.symm.toMonoidHom, fun x => ?_⟩
      have := hσ (ι.symm x)
      change ι.symm (π' (σ (ι.symm x))) = ι.symm x at this
      exact ι.symm.injective this
  obtain ⟨φ, hφ, hker, hmap⟩ := burnsideA318_cover_map e hsplit
  have hD := card_scalars_dvd_three (F := K) (p := p) (f := 1) (Or.inr ⟨hK, rfl⟩)
  rcases burnsideA318_iso_of_cover hD hφ hker hmap with ⟨⟨e'⟩⟩ | ⟨⟨e'⟩⟩
  · exact Or.inl ⟨hadm, K, inferInstance, inferInstance, hK, ⟨e'⟩⟩
  · have hpow : StatedSU 3 (p ^ 1) K = StatedSU 3 p K := by rw [pow_one]
    exact Or.inr ⟨K, inferInstance, inferInstance, hK2, ⟨e'.trans (MulEquiv.subgroupCongr hpow)⟩⟩

end BurnsideA318

section

theorem as_A_3_21 : A_3_21 := by
  intro L _ _ hq hL T hT B hB hBtop
  obtain ⟨s, p, hp, hp2, hs⟩ := hL
  have : Fact p.Prime := ⟨hp⟩
  have hBne : B ≠ ⊤ := hBtop.ne
  cases s with
  | true =>
    rcases burnsideA318_reduction_psl hq hp hp2 hs with hX | hX
    · exact burnsideA318_c9c10_of_sylowCore hp hp2 hq (Or.inl hX)
        (CFSG.Quasithin.A38c15.sylowCore_of_isPSL3 CFSG.Quasithin.A38c15.gl2OddIndex
          CFSG.Quasithin.A38c15.sl3OddIrr hp2 hX) hT hB hBne
    · exact burnsideA318_c9c10_of_sylowCore hp hp2 hq (Or.inr hX)
        (CFSG.Quasithin.A38c15.sylowCore_of_isSL3 CFSG.Quasithin.A38c15.gl2OddIndex
          CFSG.Quasithin.A38c15.sl3OddIrr hp2 hX) hT hB hBne
  | false =>
    rcases burnsideA318_reduction_psu hq hp hp2 hs with hX | hX
    · exact burnsideA318_c9_of_psu CFSG.Quasithin.A312U3.su3OddIrr_holds hp hp2 hq hX hT hB hBne
    · exact burnsideA318_c9_of_su CFSG.Quasithin.A312U3.su3OddIrr_holds hp hp2 hq hX hT hB hBne

end

