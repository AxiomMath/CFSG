    : A_3_14 := by
  intro G _ _ hG T hT B hB hA L hL hBL
  have hG' := CFSG.Quasithin.sqtkHyp_of_cat (burnsideA314_toCat hG)
  exact burnsideA314_bridge
    (CFSG.Quasithin.a314 CFSG.Quasithin.H13.NQCat.A314D.a314Facts_holds hG'
      (CFSG.Quasithin.a36 CFSG.SectionRank.QTK.CentreFact.a36Facts_holds hG')
      (CFSG.Quasithin.H13.a312ForSQTK_proved G hG') hT hB hA hL hBL) hB

