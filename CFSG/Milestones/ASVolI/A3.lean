@[expose] def burnsideA35_isH (x : Fin 22) : Prop := burnsideA35_linesTab x = []

instance burnsideA35_instDecidablePredIsH : DecidablePred burnsideA35_isH := fun x => by
  unfold burnsideA35_isH; infer_instance

theorem burnsideA35_pos_pt : ∀ i, burnsideA35_pos (burnsideA35_pt i) = i := by
  decide +kernel

theorem burnsideA35_pt_pos : ∀ x, burnsideA35_isH x →
    burnsideA35_pt (burnsideA35_pos x) = x := by decide +kernel

private theorem burnsideA35_isH_pt : ∀ i, burnsideA35_isH (burnsideA35_pt i) := by decide +kernel

private theorem burnsideA35_lines_sub : ∀ q : Fin 22, ∀ l ∈ burnsideA35_linesTab q,
