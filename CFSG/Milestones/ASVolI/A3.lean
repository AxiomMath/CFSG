    Subgroup.subset_closure (by simp [burnsideA35_gensT])
  have he1α : e1 ⟨_, hα⟩ = ⟨burnsideA35_a1, burnsideA35_a1_even⟩ :=
    Subtype.ext (burnsideA35_psi_α)
  have he1β : e1 ⟨_, hβ⟩ = ⟨burnsideA35_a2, burnsideA35_a2_even⟩ :=
    Subtype.ext (burnsideA35_psi_β)
  refine ⟨K, e1.symm.trans e2, ?_, ?_, ?_⟩
