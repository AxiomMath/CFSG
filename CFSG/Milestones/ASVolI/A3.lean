private theorem burnsideA35_closure_eq : Subgroup.closure ({burnsideA35_a1, burnsideA35_a2,
    burnsideA35_a3} : Set (Equiv.Perm (Fin 7))) = alternatingGroup (Fin 7) := by
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro _ (rfl | rfl | rfl)
    · exact burnsideA35_a1_even
    · exact burnsideA35_a2_even
    · exact burnsideA35_a3_even
  · rw [← Equiv.Perm.closure_three_cycles_eq_alternating, Subgroup.closure_le]
    intro σ hσ
    have hσ3 : σ.IsThreeCycle := hσ
    obtain ⟨a, ha⟩ := hσ3.isCycle.nonempty_support
    have hnd := hσ3.nodup_iff_mem_support.2 ha
    have hσeq := hσ3.eq_swap_mul_swap_iff_mem_support.2 ha
    obtain ⟨⟨hab, hac⟩, -⟩ : (¬a = σ a ∧ ¬a = σ (σ a)) ∧ ¬a = σ a := by
      simpa [List.nodup_cons, List.mem_cons] using hnd
    have hbc : σ a ≠ σ (σ a) := fun h => hab (σ.injective h)
