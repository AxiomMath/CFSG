@[expose] def IsQ8D8 (V : Type) [Group V] : Prop :=
  ∃ Q E : Subgroup V, Nonempty (↥Q ≃* QuaternionGroup 2) ∧ Nonempty (↥E ≃* DihedralGroup 4) ∧
    (∀ q ∈ Q, ∀ e ∈ E, q * e = e * q) ∧ Q ⊔ E = ⊤ ∧ Nat.card ↥(Q ⊓ E) = 2

@[expose] def IsZ4StarQ8D8 (V : Type) [Group V] : Prop :=
  ∃ Z E : Subgroup V, Nat.card Z = 4 ∧ IsCyclic ↥Z ∧ IsQ8D8 ↥E ∧
    Z ≤ Subgroup.center V ∧ Z ⊔ E = ⊤ ∧ Nat.card ↥(Z ⊓ E) = 2

