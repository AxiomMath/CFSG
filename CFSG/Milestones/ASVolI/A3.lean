  | (i, e) :: w => g i ^ e * burnsideA35_pw g w

private theorem burnsideA35_pw_mem {M : Type*} [Group M] {H : Subgroup M} {g : Fin 2 → M}
    (h : ∀ i, g i ∈ H) : ∀ w : List (Fin 2 × ℕ), burnsideA35_pw g w ∈ H
  | [] => H.one_mem
  | (i, e) :: w => H.mul_mem (H.pow_mem (h i) e) (burnsideA35_pw_mem h w)

private theorem burnsideA35_map_pw {M N : Type*} [Monoid M] [Monoid N] (f : M →* N) (g : Fin 2
    → M) :
    ∀ w : List (Fin 2 × ℕ), f (burnsideA35_pw g w) = burnsideA35_pw (fun i => f (g i)) w
  | [] => by simp [burnsideA35_pw]
  | (i, e) :: w => by simp [burnsideA35_pw, map_pow, burnsideA35_map_pw f g w]

