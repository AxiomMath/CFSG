    simp only [burnsideA35_gensT, Set.image_insert_eq, Set.image_singleton, burnsideA35_psi_α,
      burnsideA35_psi_β, burnsideA35_psi_γ]
  let ψA : ↥A' →* Equiv.Perm (Fin 7) := burnsideA35_psi.comp A'.subtype
