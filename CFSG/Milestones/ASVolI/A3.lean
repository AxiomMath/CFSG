private theorem burnsideA314_q8_hom {W : Type} [Group W] {z x y : W} (hzz : z * z = 1) (hz1 : z ≠ 1)
    (hx : x * x = z) (hy : y * y = z) (hxy : x * y = z * (y * x)) :
    ∃ f : QuaternionGroup 2 →* W, Function.Injective f ∧
      (∀ k : ZMod 4, f (QuaternionGroup.a k) = x ^ k.val) ∧
      (∀ k : ZMod 4, f (QuaternionGroup.xa k) = y * x ^ k.val) := by
  have hx4 : x ^ 4 = 1 := by
    rw [show x ^ 4 = (x * x) * (x * x) by rw [show (4 : ℕ) = 2 + 2 from rfl, pow_add, sq], hx, hzz]
  have hy2 : y ^ 2 = x ^ 2 := by rw [sq, sq, hx, hy]
  have hxinv : x⁻¹ = z * x := by
    have h : z * x * x = 1 := by rw [mul_assoc, hx, hzz]
    exact (eq_inv_of_mul_eq_one_left h).symm
  have hyx' : y * x = z * (x * y) := by
    calc y * x = (z * z) * (y * x) := by rw [hzz, one_mul]
      _ = z * (z * (y * x)) := mul_assoc _ _ _
      _ = z * (x * y) := by rw [← hxy]
  have hyx : y * x * y⁻¹ = x⁻¹ := by
    rw [hxinv, hyx', mul_assoc, mul_inv_cancel_right]
  refine ⟨quaternionLift hx4 hyx hy2, ?_, fun k => rfl, fun k => rfl⟩
  · rw [injective_iff_map_eq_one]
    rintro (k | k) hk
    · have hk' : x ^ k.val = 1 := (quaternionLift_a hx4 hyx hy2 k).symm.trans hk
      rw [burnsideA314_pow_val_eq_one hzz hz1 hx hk']
      exact QuaternionGroup.one_def.symm
    · exfalso
      have hk' : y * x ^ k.val = 1 := (quaternionLift_xa hx4 hyx hy2 k).symm.trans hk
      have hy' : y = (x ^ k.val)⁻¹ := eq_inv_of_mul_eq_one_left hk'
      have hc : y * x = x * y := by
        rw [hy']
        exact ((Commute.pow_self x k.val).inv_left).eq
      exact hz1 (burnsideA314_eq_one_of_commute hxy hc)

private theorem burnsideA314_uv_sq {W : Type} [Group W] {z u v : W} (hzz : z * z = 1)
    (hzu : z * u = u * z) (hu : u * u = 1) (hv : v * v = 1) (huv : u * v = z * (v * u)) :
    u * v * (u * v) = z := by
  have hvu : v * u = z * (u * v) := by
    calc v * u = (z * z) * (v * u) := by rw [hzz, one_mul]
      _ = z * (z * (v * u)) := mul_assoc _ _ _
      _ = z * (u * v) := by rw [← huv]
  calc u * v * (u * v) = u * (v * u) * v := by simp only [mul_assoc]
    _ = u * (z * (u * v)) * v := by rw [hvu]
    _ = (u * z) * (u * v) * v := by simp only [mul_assoc]
    _ = (z * u) * (u * v) * v := by rw [← hzu]
    _ = z * (u * u) * (v * v) := by simp only [mul_assoc]
    _ = z := by rw [hu, hv, mul_one, mul_one]

open CFSG.GH74.Uniqueness.Section15GL32 in
private theorem burnsideA314_d8_hom {W : Type} [Group W] {z u v : W} (hzz : z * z = 1) (hz1 : z ≠ 1)
    (hzu : z * u = u * z) (hu : u * u = 1) (hv : v * v = 1) (huv : u * v = z * (v * u)) :
    ∃ f : DihedralGroup 4 →* W, Function.Injective f ∧
      (∀ k : ZMod 4, f (DihedralGroup.r k) = (u * v) ^ k.val) ∧
      (∀ k : ZMod 4, f (DihedralGroup.sr k) = u * (u * v) ^ k.val) := by
  have hr2 : u * v * (u * v) = z := burnsideA314_uv_sq hzz hzu hu hv huv
  have ha4 : (u * v) ^ 4 = 1 := by
    rw [show (u * v) ^ 4 = (u * v * (u * v)) * (u * v * (u * v)) by
      rw [show (4 : ℕ) = 2 + 2 from rfl, pow_add, sq], hr2, hzz]
  have hba : u * (u * v) * u = (u * v)⁻¹ := by
    have hu' : u⁻¹ = u := inv_eq_of_mul_eq_one_right hu
    have hv' : v⁻¹ = v := inv_eq_of_mul_eq_one_right hv
    rw [mul_inv_rev, hu', hv']
    calc u * (u * v) * u = (u * u) * v * u := by simp only [mul_assoc]
      _ = v * u := by rw [hu, one_mul]
  refine ⟨dihedralLift (u * v) u ha4 hu hba, ?_, fun k => rfl, fun k => rfl⟩
  · rw [injective_iff_map_eq_one]
    rintro (k | k) hk
    · have hk' : (u * v) ^ k.val = 1 := (dihedralLift_r (u * v) u ha4 hu hba k).symm.trans hk
      rw [burnsideA314_pow_val_eq_one hzz hz1 hr2 hk']
      exact DihedralGroup.one_def.symm
    · exfalso
      have hk' : u * (u * v) ^ k.val = 1 :=
        (dihedralLift_sr (u * v) u ha4 hu hba k).symm.trans hk
      have hy' : u = ((u * v) ^ k.val)⁻¹ := eq_inv_of_mul_eq_one_left hk'
      have hc : Commute u (u * v) := by
        have h := (Commute.pow_self (u * v) k.val).inv_left
        rw [← hy'] at h
        exact h
      have hvu' : v * u = u * v := by
        have h1 : u * (u * v) = (u * v) * u := hc.eq
        calc v * u = (u * u) * v * u := by rw [hu, one_mul]
          _ = u * (u * v) * u := by simp only [mul_assoc]
          _ = (u * v) * u * u := by rw [h1]
          _ = u * v := by rw [mul_assoc, hu, mul_one]
      exact hz1 (burnsideA314_eq_one_of_commute huv hvu')

private theorem burnsideA314_q8_central :
    ∀ q : QuaternionGroup 2, (∀ r : QuaternionGroup 2, r * q = q * r) →
      q = 1 ∨ q = QuaternionGroup.a 2 := by decide

private theorem burnsideA314_gens {W : Type} [Group W] {z x y u v : W}
    (hzz : z * z = 1) (hz1 : z ≠ 1)
    (hx : x * x = z) (hy : y * y = z) (hxy : x * y = z * (y * x))
    (hu : u * u = 1) (hv : v * v = 1) (huv : u * v = z * (v * u))
    (hxu : x * u = u * x) (hxv : x * v = v * x) (hyu : y * u = u * y) (hyv : y * v = v * y) :
    ∃ Q E : Subgroup W, Nonempty (↥Q ≃* QuaternionGroup 2) ∧ Nonempty (↥E ≃* DihedralGroup 4) ∧
      (∀ q ∈ Q, ∀ e ∈ E, q * e = e * q) ∧ Nat.card ↥(Q ⊓ E) = 2 ∧
      x ∈ Q ∧ y ∈ Q ∧ u ∈ E ∧ v ∈ E ∧ z ∈ Q ∧ z ∈ E := by
  have hzu : z * u = u * z := by
    calc z * u = x * (x * u) := by rw [← hx, mul_assoc]
      _ = x * (u * x) := by rw [hxu]
      _ = (u * x) * x := by rw [← mul_assoc, hxu]
      _ = u * z := by rw [mul_assoc, hx]
  obtain ⟨fQ, hQinj, hfQa, hfQxa⟩ := burnsideA314_q8_hom hzz hz1 hx hy hxy
  obtain ⟨fD, hDinj, hfDr, hfDsr⟩ := burnsideA314_d8_hom hzz hz1 hzu hu hv huv
  have hr2 : u * v * (u * v) = z := burnsideA314_uv_sq hzz hzu hu hv huv
  have cxu : Commute x u := hxu
  have cxv : Commute x v := hxv
  have cyu : Commute y u := hyu
  have cyv : Commute y v := hyv
  have cxr : Commute x (u * v) := cxu.mul_right cxv
  have cyr : Commute y (u * v) := cyu.mul_right cyv
  have hcomm : ∀ q d, Commute (fQ q) (fD d) := by
    intro q d
    rcases q with k | k <;> rcases d with m | m
    · rw [hfQa, hfDr]
      exact cxr.pow_pow _ _
    · rw [hfQa, hfDsr]
      exact (cxu.pow_left _).mul_right (cxr.pow_pow _ _)
    · rw [hfQxa, hfDr]
      exact (cyr.pow_right _).mul_left (cxr.pow_pow _ _)
    · rw [hfQxa, hfDsr]
      exact (cyu.mul_left (cxu.pow_left _)).mul_right
        ((cyr.pow_right _).mul_left (cxr.pow_pow _ _))
  have hzQ : z ∈ fQ.range :=
    ⟨QuaternionGroup.a 2, by rw [hfQa, show (2 : ZMod 4).val = 2 from rfl, sq, hx]⟩
  have hzE : z ∈ fD.range :=
    ⟨DihedralGroup.r 2, by rw [hfDr, show (2 : ZMod 4).val = 2 from rfl, sq, hr2]⟩
  have hw : ∀ w ∈ fQ.range ⊓ fD.range, w = 1 ∨ w = z := by
    intro w hw
    obtain ⟨⟨q, rfl⟩, ⟨d, hd⟩⟩ := Subgroup.mem_inf.mp hw
    have hq : ∀ r : QuaternionGroup 2, r * q = q * r := by
      intro r
      apply hQinj
      rw [map_mul, map_mul, ← hd]
      exact (hcomm r d).eq
    rcases burnsideA314_q8_central q hq with rfl | rfl
    · left
      exact map_one fQ
    · right
      rw [hfQa, show (2 : ZMod 4).val = 2 from rfl, sq, hx]
  refine ⟨fQ.range, fD.range, ⟨(MonoidHom.ofInjective hQinj).symm⟩,
    ⟨(MonoidHom.ofInjective hDinj).symm⟩, ?_, ?_, ?_, ?_, ?_, ?_, hzQ, hzE⟩
  · rintro _ ⟨q, rfl⟩ _ ⟨d, rfl⟩
    exact (hcomm q d).eq
  · rw [Nat.card_eq_two_iff' (1 : ↥(fQ.range ⊓ fD.range))]
    refine ⟨⟨z, Subgroup.mem_inf.mpr ⟨hzQ, hzE⟩⟩, fun h => hz1 (congrArg Subtype.val h),
      fun w hw1 => ?_⟩
    exact Subtype.ext ((hw w.1 w.2).resolve_left fun h => hw1 (Subtype.ext h))
  · exact ⟨QuaternionGroup.a 1, by
      rw [hfQa, show (1 : ZMod 4).val = 1 from rfl, pow_one]⟩
  · exact ⟨QuaternionGroup.xa 0, by rw [hfQxa, ZMod.val_zero, pow_zero, mul_one]⟩
  · exact ⟨DihedralGroup.sr 0, by rw [hfDsr, ZMod.val_zero, pow_zero, mul_one]⟩
  · refine ⟨DihedralGroup.sr 1, ?_⟩
    rw [hfDsr, show (1 : ZMod 4).val = 1 from rfl, pow_one]
    calc u * (u * v) = (u * u) * v := by rw [mul_assoc]
      _ = v := by rw [hu, one_mul]

private theorem burnsideA314_center_two {S : Type} [Group S] (h : Nat.card (Subgroup.center S)
    = 2) :
    ∃ z : S, z ≠ 1 ∧ Subgroup.center S = Subgroup.zpowers z ∧
      ∀ w ∈ Subgroup.center S, w = 1 ∨ w = z := by
  obtain ⟨y, hy1, hyu⟩ := (Nat.card_eq_two_iff' (1 : ↥(Subgroup.center S))).mp h
  have hw : ∀ w ∈ Subgroup.center S, w = 1 ∨ w = (y : S) := by
    intro w hw
    by_cases hw1 : w = 1
    · exact Or.inl hw1
    · right
      exact congrArg Subtype.val (hyu ⟨w, hw⟩ (fun h' => hw1 (congrArg Subtype.val h')))
  refine ⟨(y : S), fun h' => hy1 (Subtype.ext h'), ?_, hw⟩
  apply le_antisymm
  · intro w hwc
    rcases hw w hwc with rfl | rfl
    · exact one_mem _
    · exact Subgroup.mem_zpowers _
  · exact Subgroup.zpowers_le.mpr y.2

private theorem burnsideA314_card_inf_centralizer {Bg : Type} [Group Bg] [Finite Bg] (V :
    Subgroup Bg)
    [V.Normal] (hcard : Nat.card ↥V = 32) (hS : CFSG.IsExtraspecialPGroup 2 ↥V)
    (hs : IsSimpleGroup (Bg ⧸ V)) (hperf : commutator Bg = ⊤) {c : Bg} (hc5 : c ^ 5 = 1)
    (hcV : c ∉ V) {z : ↥V} (hz1 : z ≠ 1) (hz : Subgroup.center ↥V = Subgroup.zpowers z)
    (hZ : ∀ w ∈ Subgroup.center ↥V, w = 1 ∨ w = z) :
    (∀ s : ↥V, c * (s : Bg) * c⁻¹ = (s : Bg) → s ∈ Subgroup.center ↥V) ∧
      ∀ w ∈ Subgroup.center ↥V, c * (w : Bg) * c⁻¹ = (w : Bg) := by
  have hzc : z ∈ Subgroup.center ↥V := hz ▸ Subgroup.mem_zpowers z
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  have hV2 : IsPGroup 2 ↥V := IsPGroup.of_card (n := 5) (hcard.trans (by norm_num))
  have hcn : c ∈ Subgroup.normalizer (V : Set Bg) := by
    rw [Subgroup.normalizer_eq_top_iff.mpr inferInstance]
    exact Subgroup.mem_top c
  have hmod := CFSG.Quasithin.Q16.card_modEq_card_inf_centralizer (p := 5) (n := 1) V hcn
    (by simpa using hc5)
  rw [hcard] at hmod
  have hzfix : c * (z : Bg) * c⁻¹ = (z : Bg) := by
    let α : MulAut ↥V := MulAut.conjNormal c
    have hαz : α z ∈ Subgroup.center ↥V := by
      rw [Subgroup.mem_center_iff]
      intro g
      obtain ⟨g', rfl⟩ := α.surjective g
      rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.mp hzc g']
    have hα1 : α z ≠ 1 := fun h => hz1 (α.injective (h.trans (map_one α).symm))
    have : α z = z := (hZ _ hαz).resolve_left hα1
    have h2 := congrArg Subtype.val this
    rwa [MulAut.conjNormal_apply] at h2
  have hz2 : orderOf (z : Bg) = 2 := by
    have hzo : orderOf z = 2 := by
      have hcz : Nat.card (Subgroup.center ↥V) = 2 := hS.natCard_center
      have hdvd : orderOf z ∣ 2 := hcz ▸ (Subgroup.orderOf_mk (z : ↥V) hzc ▸ orderOf_dvd_natCard
        (⟨z, hzc⟩ : ↥(Subgroup.center ↥V)))
      rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h | h
      · exact absurd (orderOf_eq_one_iff.mp h) hz1
      · exact h
    rw [Subgroup.orderOf_coe, hzo]
  have hZle : Subgroup.zpowers (z : Bg) ≤ V ⊓ Subgroup.centralizer ({c} : Set Bg) := by
    rw [Subgroup.zpowers_le]
    refine Subgroup.mem_inf.mpr ⟨z.2, ?_⟩
    rw [Subgroup.mem_centralizer_singleton_iff]
    calc (z : Bg) * c = c * (z : Bg) * c⁻¹ * c := by rw [hzfix]
      _ = c * z := by group
  have hdvd : Nat.card ↥(V ⊓ Subgroup.centralizer ({c} : Set Bg)) ∣ 32 :=
    hcard ▸ Subgroup.card_dvd_of_le inf_le_left
  have h2dvd : 2 ∣ Nat.card ↥(V ⊓ Subgroup.centralizer ({c} : Set Bg)) := by
    have := Subgroup.card_dvd_of_le hZle
    rwa [Nat.card_zpowers, hz2] at this
  have hwfix : ∀ w ∈ Subgroup.center ↥V, c * (w : Bg) * c⁻¹ = (w : Bg) := by
    intro w hw
    rcases hZ w hw with rfl | rfl
    · simp
    · exact hzfix
  refine ⟨?_, hwfix⟩
  rcases CFSG.Quasithin.Q16.eq_two_or_eq_thirtyTwo_of_modEq_five hdvd h2dvd hmod with h | h
  · intro s hs'
    have hsC : (s : Bg) ∈ V ⊓ Subgroup.centralizer ({c} : Set Bg) := by
      refine Subgroup.mem_inf.mpr ⟨s.2, ?_⟩
      rw [Subgroup.mem_centralizer_singleton_iff]
      calc (s : Bg) * c = c * s * c⁻¹ * c := by rw [hs']
        _ = c * s := by group
    have hEq : Subgroup.zpowers (z : Bg) = V ⊓ Subgroup.centralizer ({c} : Set Bg) :=
      Subgroup.eq_of_le_of_card_ge hZle (by rw [Nat.card_zpowers, hz2, h])
    rw [← hEq] at hsC
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hsC
    rw [hz]
    refine Subgroup.mem_zpowers_iff.mpr ⟨k, Subtype.ext ?_⟩
    rw [Subgroup.coe_zpow]
    exact hk
  · exfalso
    have hVC : V ⊓ Subgroup.centralizer ({c} : Set Bg) = V :=
      Subgroup.eq_of_le_of_card_ge inf_le_left (by rw [hcard, h])
    have hVle : V ≤ Subgroup.centralizer ({c} : Set Bg) := inf_eq_left.mp hVC
    have hcc : c ∈ Subgroup.centralizer (V : Set Bg) := by
      rw [Subgroup.mem_centralizer_iff]
      intro h' hh'
      exact Subgroup.mem_centralizer_singleton_iff.mp (hVle hh')
    have htop := CFSG.Quasithin.Q16.centralizer_eq_top_of_perfect V hV2 hs hperf hcV hcc
    have hcen : Subgroup.center ↥V = ⊤ := by
      rw [eq_top_iff]
      intro g _
      rw [Subgroup.mem_center_iff]
      intro g'
      have hg : (g : Bg) ∈ Subgroup.centralizer (V : Set Bg) := by
        rw [htop]
        exact Subgroup.mem_top _
      exact Subtype.ext (Subgroup.mem_centralizer_iff.mp hg g' g'.2)
    have h32 := hS.natCard_center
    rw [hcen, Subgroup.card_top, hcard] at h32
    omega

private theorem burnsideA314_closure_top {S : Type} [Group S] {x y u v z : S}
    (hzK : z ∈ Subgroup.closure ({x, y, u, v} : Set S))
    (hZ : ∀ w ∈ Subgroup.center S, w = 1 ∨ w = z)
    (hbij : Function.Bijective (fun c : Fin 4 → ZMod 2 =>
      ((x ^ (c 0).val * y ^ (c 1).val * u ^ (c 2).val * v ^ (c 3).val : S) :
        S ⧸ Subgroup.center S))) :
    Subgroup.closure ({x, y, u, v} : Set S) = ⊤ := by
  set K := Subgroup.closure ({x, y, u, v} : Set S)
  have hxK : x ∈ K := Subgroup.subset_closure (by simp)
  have hyK : y ∈ K := Subgroup.subset_closure (by simp)
  have huK : u ∈ K := Subgroup.subset_closure (by simp)
  have hvK : v ∈ K := Subgroup.subset_closure (by simp)
  rw [eq_top_iff]
  intro s _
  obtain ⟨c, hc⟩ := hbij.2 (s : S ⧸ Subgroup.center S)
  set p := x ^ (c 0).val * y ^ (c 1).val * u ^ (c 2).val * v ^ (c 3).val
  have hpK : p ∈ K := mul_mem (mul_mem (mul_mem (pow_mem hxK _) (pow_mem hyK _))
    (pow_mem huK _)) (pow_mem hvK _)
  have hw : p⁻¹ * s ∈ Subgroup.center S := QuotientGroup.eq.mp hc
  have hs : s = p * (p⁻¹ * s) := by group
  rw [hs]
  refine mul_mem hpK ?_
  rcases hZ _ hw with h | h
  · rw [h]
    exact one_mem _
  · rw [h]
    exact hzK

open scoped commutatorElement in
private theorem burnsideA314_isQ8D8 {Bg : Type} [Group Bg] [Finite Bg] (V : Subgroup Bg) [V.Normal]
    (hV : CFSG.Quasithin.IsExtraspecial2 2 ↥V) (hA : CFSG.Quasithin.IsAlt 5 (Bg ⧸ V))
    (hperf : commutator Bg = ⊤) : ChA.IsQ8D8 ↥V := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  obtain ⟨hVe, hVc⟩ := hV
  have hcard : Nat.card ↥V = 32 := by rw [hVc]; norm_num
  have hS : CFSG.IsExtraspecialPGroup 2 ↥V := CFSG.isExtraspecialPGroup_iff_isExtraspecial.mpr hVe
  have hs : IsSimpleGroup (Bg ⧸ V) := by
    obtain ⟨e⟩ := hA
    exact e.isSimpleGroup
  obtain ⟨z, hz1, hz, hZ⟩ := burnsideA314_center_two hS.natCard_center
  have hzc : z ∈ Subgroup.center ↥V := hz ▸ Subgroup.mem_zpowers z
  obtain ⟨hz2, -⟩ := CFSG.RankThree.GroupTheory.extraspecial_commutator_eq_one_or hS hz
  have hzz : z * z = 1 := by rw [← sq, ← hz2, pow_orderOf_eq_one]
  have h5 : 5 ∣ Nat.card Bg := by
    have h60 : Nat.card (Bg ⧸ V) = 60 := CFSG.Quasithin.A314.card_isAlt_five hA
    have h := Subgroup.card_eq_card_quotient_mul_card_subgroup V
    rw [h60, hcard] at h
    exact ⟨384, by omega⟩
  obtain ⟨c, hc5⟩ := exists_prime_orderOf_dvd_card' (G := Bg) 5 h5
  have hc : c ^ 5 = 1 := hc5 ▸ pow_orderOf_eq_one c
  have hcV : c ∉ V := fun h => by
    have := orderOf_dvd_natCard (⟨c, h⟩ : ↥V)
    rw [Subgroup.orderOf_mk, hc5, hcard] at this
    omega
  obtain ⟨hCV, hwfix⟩ := burnsideA314_card_inf_centralizer V hcard hS hs hperf hc hcV hz1 hz hZ
  let α : MulAut ↥V := MulAut.conjNormal c
  have hαapp : ∀ s : ↥V, ((α s : ↥V) : Bg) = c * (s : Bg) * c⁻¹ := fun s =>
    MulAut.conjNormal_apply c s
  have hαfix : ∀ s : ↥V, α s = s → s ∈ Subgroup.center ↥V := fun s h =>
    hCV s (by rw [← hαapp, h])
  have hαz : α z = z := Subtype.ext (by rw [hαapp]; exact hwfix z hzc)
  have hα5 : α ^ 5 = 1 := by
    rw [← map_pow, hc, map_one]
  have hα1 : α ≠ 1 := by
    intro h
    have hcen : Subgroup.center ↥V = ⊤ := by
      rw [eq_top_iff]
      intro s _
      exact hαfix s (by rw [h]; rfl)
    have h32 := hS.natCard_center
    rw [hcen, Subgroup.card_top, hcard] at h32
    omega
  have hα : orderOf α = 5 := orderOf_eq_prime hα5 hα1
  have hfix : ∀ s : ↥V, ((α s : ↥V) : ↥V ⧸ Subgroup.center ↥V) = (s : ↥V ⧸ Subgroup.center ↥V) →
      s ∈ Subgroup.center ↥V := by
    intro s hsq
    have hw : (α s)⁻¹ * s ∈ Subgroup.center ↥V := QuotientGroup.eq.mp hsq
    rcases hZ _ hw with h1 | h1
    · apply hαfix
      exact inv_mul_eq_one.mp h1
    · exfalso
      have hαs : α s = s * z := by
        have h2 : s = α s * z := by
          calc s = α s * ((α s)⁻¹ * s) := by group
            _ = α s * z := by rw [h1]
        calc α s = α s * z * z := by rw [mul_assoc, hzz, mul_one]
          _ = s * z := by rw [← h2]
      have hpow : ∀ n : ℕ, (α ^ n) s = s * z ^ n := by
        intro n
        induction n with
        | zero => simp
        | succ n ih =>
          rw [pow_succ', MulAut.mul_apply, ih, map_mul, hαs, map_pow, hαz, mul_assoc, ← pow_succ']
      have h5s := hpow 5
      rw [hα5, MulAut.one_apply] at h5s
      have hz5 : z ^ 5 = z := by
        calc z ^ 5 = (z * z) * (z * z) * z := by
              rw [show (5 : ℕ) = 2 + 2 + 1 from rfl, pow_succ, pow_add, sq]
          _ = z := by rw [hzz, one_mul, one_mul]
      rw [hz5] at h5s
      have : z = 1 := by
        have h3 : s * z = s * 1 := by rw [mul_one, ← h5s]
        exact mul_left_cancel h3
      exact hz1 this
  obtain ⟨-, x, y, u, v, hbij, hx2, hy2, hu2, hv2, hxy, huv, hxu, hxv, hyu, hyv, -⟩ :=
    CFSG.RankThree.GroupTheory.SteinbergBM.extraspecial_thirty_two_five_recognition hS hcard hz α
      hα hfix
  have hgen : Subgroup.closure ({x, y, u, v} : Set ↥V) = ⊤ :=
    burnsideA314_closure_top (by
      rw [← hx2]
      exact pow_mem (Subgroup.subset_closure (by simp)) 2) hZ hbij
  have hxx : x * x = z := by rw [← sq, hx2]
  have hyy : y * y = z := by rw [← sq, hy2]
  have huu : u * u = 1 := by rw [← sq, hu2]
  have hvv : v * v = 1 := by rw [← sq, hv2]
  have hcom : ∀ a b : ↥V, ⁅a, b⁆ = z → a * b = z * (b * a) := fun a b h => by
    calc a * b = ⁅a, b⁆ * (b * a) := by rw [commutatorElement_def]; group
      _ = z * (b * a) := by rw [h]
  obtain ⟨Q, E, hQ, hE, hQE, hn, hxQ, hyQ, huE, hvE, -, -⟩ := burnsideA314_gens hzz hz1 hxx hyy
    (hcom x y hxy) huu hvv (hcom u v huv)
    (commutatorElement_eq_one_iff_mul_comm.mp hxu) (commutatorElement_eq_one_iff_mul_comm.mp hxv)
    (commutatorElement_eq_one_iff_mul_comm.mp hyu) (commutatorElement_eq_one_iff_mul_comm.mp hyv)
  refine ⟨Q, E, hQ, hE, hQE, ?_, hn⟩
  rw [eq_top_iff, ← hgen, Subgroup.closure_le]
  rintro w (rfl | rfl | rfl | rfl)
  · exact Subgroup.mem_sup_left hxQ
  · exact Subgroup.mem_sup_left hyQ
  · exact Subgroup.mem_sup_right huE
  · exact Subgroup.mem_sup_right hvE

open Subgroup CFSG CFSG.RankThree.GroupTheory CFSG.RankThree.GroupTheory.SteinbergBY CFSG.RankThree.GroupTheory.SteinbergBM CFSG.LocalAnalysis.ComponentInitial in
open scoped commutatorElement in
attribute [-instance] instCommGroupOfIsSimpleGroupOfIsNilpotent
  instAddCommGroupOfIsSimpleAddGroupOfIsNilpotent in
private theorem burnsideA314_basis {S : Type} [Group S] [Finite S] (hS : IsExtraspecialPGroup 2 S)
    (hcard : Nat.card S = 32) {z : S} (hz : center S = zpowers z) :
    ∃ x y u v : S, closure ({x, y, u, v} : Set S) = ⊤ ∧ ⁅x, y⁆ = z ∧ ⁅u, v⁆ = z ∧ ⁅x, u⁆ = 1 ∧
      ⁅x, v⁆ = 1 ∧ ⁅y, u⁆ = 1 ∧ ⁅y, v⁆ = 1 ∧ u * u = 1 ∧ v * v = 1 ∧
      ((x * x = z ∧ y * y = z) ∨ (x * x = 1 ∧ y * y = 1)) := by
  obtain ⟨hz2, hcomm⟩ := extraspecial_commutator_eq_one_or hS hz
  have hzz : z * z = 1 := by rw [← pow_two, ← hz2, pow_orderOf_eq_one]
  have hzc : z ∈ center S := hz ▸ mem_zpowers z
  have hz1 : z ≠ 1 := fun h => by rw [h, orderOf_one] at hz2; omega
  have hZ : ∀ w ∈ center S, w = 1 ∨ w = z := fun w hw =>
    (mem_zpowers_of_orderOf_eq_two hz2).mp (hz ▸ hw)
  have hcen : ∀ s t : S, ⁅s, t⁆ ∈ center S := fun s t => by
    rcases hcomm s t with h | h <;> rw [h]
    · exact one_mem _
    · exact hzc
  have hsq : ∀ g : S, g * g ∈ center S := fun g => by
    rw [← hS.2.2.1, ← pow_two]
    exact CFSG.OrderReductions.FrattiniElementary.pow_mem_frattini 2 hS.1 g
  have hww : ∀ w ∈ center S, w * w = 1 := fun w hw => by
    rcases hZ w hw with rfl | rfl
    · exact mul_one 1
    · exact hzz
  let ι : center S ≃* Multiplicative (ZMod 2) :=
    mulEquivOfPrimeCardEq hS.2.2.2 (by rw [Nat.card_eq_fintype_card]; rfl)
  let sq : S → ZMod 2 := fun s => Multiplicative.toAdd (ι ⟨s * s, hsq s⟩)
  let cm : S → S → ZMod 2 := fun s t => Multiplicative.toAdd (ι ⟨⁅s, t⁆, hcen s t⟩)
  have hι0 : ∀ (w : S) (hw : w ∈ center S), Multiplicative.toAdd (ι ⟨w, hw⟩) = 0 ↔ w = 1 :=
    fun w hw => by rw [toAdd_eq_zero, MulEquiv.map_eq_one_iff, mk_eq_one]
  have hsq0 : ∀ s, sq s = 0 ↔ s * s = 1 := fun s => hι0 _ _
  have hcm0 : ∀ s t, cm s t = 0 ↔ ⁅s, t⁆ = 1 := fun s t => hι0 _ _
  have hsq1 : ∀ s, sq s = 1 → s * s = z := fun s h =>
    (hZ _ (hsq s)).resolve_left fun h' => by rw [(hsq0 s).mpr h'] at h; exact zero_ne_one h
  have hcm1 : ∀ s t, cm s t = 1 → ⁅s, t⁆ = z := fun s t h =>
    (hZ _ (hcen s t)).resolve_left fun h' => by rw [(hcm0 s t).mpr h'] at h; exact zero_ne_one h
  have hP1 : ∀ s t, sq (s * t) = cm t s + sq s + sq t := by
    intro s t
    have e1 : t * s = ⁅t, s⁆ * (s * t) := by rw [commutatorElement_def]; group
    have e : (⟨s * t * (s * t), hsq (s * t)⟩ : center S) =
        ⟨⁅t, s⁆, hcen t s⟩ * ⟨s * s, hsq s⟩ * ⟨t * t, hsq t⟩ := by
      apply Subtype.ext
      change s * t * (s * t) = ⁅t, s⁆ * (s * s) * (t * t)
      calc s * t * (s * t) = s * (t * s) * t := by group
        _ = s * (⁅t, s⁆ * (s * t)) * t := by rw [e1]
        _ = (s * ⁅t, s⁆) * s * t * t := by group
        _ = (⁅t, s⁆ * s) * s * t * t := by rw [mem_center_iff.mp (hcen t s) s]
        _ = ⁅t, s⁆ * (s * s) * (t * t) := by group
    change Multiplicative.toAdd (ι ⟨s * t * (s * t), _⟩) = _
    rw [e, map_mul ι, map_mul ι, toAdd_mul, toAdd_mul]
  have hP2 : ∀ s s' t, cm (s * s') t = cm s t + cm s' t := by
    intro s s' t
    have e : (⟨⁅s * s', t⁆, hcen (s * s') t⟩ : center S) =
        ⟨⁅s', t⁆, hcen s' t⟩ * ⟨⁅s, t⁆, hcen s t⟩ := by
      apply Subtype.ext
      change ⁅s * s', t⁆ = ⁅s', t⁆ * ⁅s, t⁆
      calc ⁅s * s', t⁆ = s * ⁅s', t⁆ * (t * s⁻¹ * t⁻¹) := by
            simp only [commutatorElement_def]
            group
        _ = ⁅s', t⁆ * s * (t * s⁻¹ * t⁻¹) := by rw [mem_center_iff.mp (hcen s' t) s]
        _ = ⁅s', t⁆ * ⁅s, t⁆ := by rw [commutatorElement_def s t]; group
    change Multiplicative.toAdd (ι ⟨⁅s * s', t⁆, _⟩) = _
    rw [e, map_mul ι, toAdd_mul, add_comm]
  have hP3 : ∀ s t, cm t s = cm s t := by
    intro s t
    have e : (⟨⁅t, s⁆, hcen t s⟩ : center S) = (⟨⁅s, t⁆, hcen s t⟩)⁻¹ :=
      Subtype.ext (commutatorElement_inv s t).symm
    change Multiplicative.toAdd (ι ⟨⁅t, s⁆, _⟩) = _
    rw [e, map_inv ι, toAdd_inv]
    exact ZMod.neg_eq_self_mod_two _
  have hcmz : ∀ w ∈ center S, ∀ t, cm w t = 0 := fun w hw t =>
    (hcm0 w t).mpr (commutatorElement_eq_one_iff_mul_comm.mpr (mem_center_iff.mp hw t).symm)
  have hsqz : ∀ w ∈ center S, sq w = 0 := fun w hw => (hsq0 w).mpr (hww w hw)
  have hP5 : ∀ s, ∀ w ∈ center S, sq (s * w) = sq s := fun s w hw => by
    rw [hP1, hcmz w hw, hsqz w hw, zero_add, add_zero]
  have hP5' : ∀ s t, ∀ w ∈ center S, cm (s * w) t = cm s t := fun s t w hw => by
    rw [hP2, hcmz w hw, add_zero]
  have hautz : ∀ β : MulAut S, ∀ w ∈ center S, β w = w := by
    intro β w hw
    have hβz : β z ∈ center S := by
      have h := characteristic_iff_map_eq.mp (inferInstance : (center S).Characteristic) β
      rw [← h]
      exact mem_map_of_mem _ hzc
    have hβz' : β z = z := (hZ _ hβz).resolve_left fun h =>
      hz1 (β.injective (h.trans (map_one β).symm))
    rcases hZ w hw with rfl | rfl
    · exact map_one β
    · exact hβz'
  have hP6 : ∀ β : MulAut S, ∀ s, sq (β s) = sq s := by
    intro β s
    have e : (⟨β s * β s, hsq (β s)⟩ : center S) = ⟨s * s, hsq s⟩ :=
      Subtype.ext (show β s * β s = s * s by rw [← map_mul]; exact hautz β _ (hsq s))
    exact congrArg (fun w => Multiplicative.toAdd (ι w)) e
  have hVcomm : ∀ a b : S ⧸ center S, a * b = b * a := by
    intro a b
    obtain ⟨s, rfl⟩ := QuotientGroup.mk_surjective a
    obtain ⟨t, rfl⟩ := QuotientGroup.mk_surjective b
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
    have : (s * t)⁻¹ * (t * s) = ⁅t⁻¹, s⁻¹⁆ := by rw [commutatorElement_def]; group
    rw [this]
    exact hcen _ _
  let : CommGroup (S ⧸ center S) := { (inferInstance : Group (S ⧸ center S)) with
    mul_comm := hVcomm }
  have h2V : ∀ w : Additive (S ⧸ center S), 2 • w = 0 := by
    intro w
    obtain ⟨s, hs⟩ := QuotientGroup.mk_surjective (Additive.toMul w)
    have hw : w = Additive.ofMul (s : S ⧸ center S) := by rw [hs]; rfl
    rw [hw, ← ofMul_pow, ← QuotientGroup.mk_pow, pow_two, (QuotientGroup.eq_one_iff _).mpr (hsq s)]
    rfl
  let : Module (ZMod 2) (Additive (S ⧸ center S)) := AddCommGroup.zmodModule h2V
  have hsmul_def : ∀ (c : ZMod 2) (w : Additive (S ⧸ center S)), c • w = c.val • w :=
    fun _ _ => rfl
  let qbar : S ⧸ center S → ZMod 2 := Quotient.lift sq (fun a b hab => by
    have hw : a⁻¹ * b ∈ center S := QuotientGroup.leftRel_apply.mp hab
    have hb : b = a * (a⁻¹ * b) := by group
    rw [hb, hP5 a _ hw])
  have hqbar : ∀ s : S, qbar (s : S ⧸ center S) = sq s := fun _ => rfl
  let f : Additive (S ⧸ center S) → ZMod 2 := fun w => qbar (Additive.toMul w)
  have hf : ∀ s : S, f (Additive.ofMul (s : S ⧸ center S)) = sq s := fun _ => rfl
  have hlift : ∀ w : Additive (S ⧸ center S), ∃ s : S, w = Additive.ofMul (s : S ⧸ center S) := by
    intro w
    obtain ⟨s, hs⟩ := QuotientGroup.mk_surjective (Additive.toMul w)
    exact ⟨s, by rw [hs]; rfl⟩
  have hadd : ∀ s t : S, Additive.ofMul (s : S ⧸ center S) + Additive.ofMul (t : S ⧸ center S) =
      Additive.ofMul ((s * t : S) : S ⧸ center S) := fun _ _ => rfl
  have hf0 : f 0 = 0 := by
    change sq 1 = 0
    exact (hsq0 1).mpr (mul_one 1)
  have hP2r : ∀ s s' t, cm t (s * s') = cm t s + cm t s' := fun s s' t => by
    rw [hP3 (s * s') t, hP3 s t, hP3 s' t, hP2]
  have hpolar : ∀ s t : S, QuadraticMap.polar f (Additive.ofMul (s : S ⧸ center S))
      (Additive.ofMul (t : S ⧸ center S)) = cm t s := by
    intro s t
    rw [QuadraticMap.polar, hadd, hf, hf, hf, hP1]
    ring
  have hsmulf : ∀ (a : ZMod 2) (w : Additive (S ⧸ center S)), f (a • w) = (a * a) • f w := by
    intro a w
    rcases zmod_two_eq_zero_or_eq_one a with rfl | rfl
    · rw [zero_smul, hf0, zero_mul, zero_smul]
    · rw [one_smul, one_mul, one_smul]
  have hpadd : ∀ w w' w'' : Additive (S ⧸ center S), QuadraticMap.polar f (w + w') w'' =
      QuadraticMap.polar f w w'' + QuadraticMap.polar f w' w'' := by
    intro w w' w''
    obtain ⟨s, rfl⟩ := hlift w
    obtain ⟨s', rfl⟩ := hlift w'
    obtain ⟨t, rfl⟩ := hlift w''
    rw [hadd, hpolar, hpolar, hpolar, hP2r]
  have hpsmul : ∀ (a : ZMod 2) (w w' : Additive (S ⧸ center S)),
      QuadraticMap.polar f (a • w) w' = a • QuadraticMap.polar f w w' := by
    intro a w w'
    rcases zmod_two_eq_zero_or_eq_one a with rfl | rfl
    · rw [zero_smul, zero_smul, QuadraticMap.polar, zero_add, hf0, sub_zero, sub_self]
    · rw [one_smul, one_smul]
  let Q : QuadraticForm (ZMod 2) (Additive (S ⧸ center S)) :=
    QuadraticMap.ofPolar f hsmulf hpadd hpsmul
  have hQ : ∀ w, Q w = f w := fun _ => rfl
  have hnd : ∀ w : Additive (S ⧸ center S), (∀ w', Q (w + w') + Q w + Q w' = 0) → w = 0 := by
    intro w hw
    obtain ⟨s, rfl⟩ := hlift w
    have hsc : s ∈ center S := by
      rw [mem_center_iff]
      intro t
      have h := hw (Additive.ofMul (t : S ⧸ center S))
      rw [hQ, hQ, hQ, hadd, hf, hf, hf, hP1] at h
      have h' : cm t s = 0 := by rw [← zmod_two_add_add_add_add (cm t s) (sq s) (sq t)]; exact h
      exact commutatorElement_eq_one_iff_mul_comm.mp ((hcm0 t s).mp h')
    change Additive.ofMul (s : S ⧸ center S) = Additive.ofMul 1
    rw [(QuotientGroup.eq_one_iff s).mpr hsc]
  have hcardV : Nat.card (S ⧸ center S) = 16 := by
    have h := card_eq_card_quotient_mul_card_subgroup (center S)
    rw [hcard, hS.2.2.2] at h
    omega
  have : Finite (Additive (S ⧸ center S)) := inferInstanceAs (Finite (S ⧸ center S))
  have : FiniteDimensional (ZMod 2) (Additive (S ⧸ center S)) := Module.Finite.of_finite
  have hfin : Module.finrank (ZMod 2) (Additive (S ⧸ center S)) = 4 := by
    have : Fintype (Additive (S ⧸ center S)) := Fintype.ofFinite _
    have hpow := Module.card_eq_pow_finrank (K := ZMod 2) (V := Additive (S ⧸ center S))
    rw [ZMod.card, ← Nat.card_eq_fintype_card] at hpow
    have h16 : Nat.card (Additive (S ⧸ center S)) = 16 := hcardV
    rw [h16, show (16 : ℕ) = 2 ^ 4 by norm_num] at hpow
    exact (Nat.pow_right_injective le_rfl hpow).symm
  have hnf := CFSG.RankThree.Classical.binary_quadratic_four_normal_forms hfin Q hnd
  obtain ⟨b, ε, hε, hb⟩ : ∃ (b : Module.Basis (Fin 4) (ZMod 2) (Additive (S ⧸ center S)))
      (ε : ZMod 2), (ε = 0 ∨ ε = 1) ∧ ∀ a₀ a₁ a₂ a₃ : ZMod 2,
      Q (a₀ • b 0 + a₁ • b 1 + a₂ • b 2 + a₃ • b 3) =
        ε * a₀ ^ 2 + a₀ * a₁ + ε * a₁ ^ 2 + a₂ * a₃ := by
    rcases hnf with ⟨⟨⟨b, hb⟩, -⟩, -⟩ | ⟨⟨⟨b, hb⟩, -⟩, -⟩
    · refine ⟨b, 0, Or.inl rfl, fun a₀ a₁ a₂ a₃ => ?_⟩
      have h := hb ![a₀, a₁, a₂, a₃]
      rw [Fin.sum_univ_four] at h
      simpa using h
    · refine ⟨b, 1, Or.inr rfl, fun a₀ a₁ a₂ a₃ => ?_⟩
      have h := hb ![a₀, a₁, a₂, a₃]
      rw [Fin.sum_univ_four] at h
      simpa using h
  obtain ⟨x, hbx⟩ := hlift (b 0)
  obtain ⟨y, hby⟩ := hlift (b 1)
  obtain ⟨u, hbu⟩ := hlift (b 2)
  obtain ⟨v, hbv⟩ := hlift (b 3)
  have hQ1 : ∀ (a₀ a₁ a₂ a₃ : ZMod 2) (w : Additive (S ⧸ center S)),
      w = a₀ • b 0 + a₁ • b 1 + a₂ • b 2 + a₃ • b 3 →
        Q w = ε * a₀ ^ 2 + a₀ * a₁ + ε * a₁ ^ 2 + a₂ * a₃ :=
    fun a₀ a₁ a₂ a₃ w hw => hw ▸ hb a₀ a₁ a₂ a₃
  have ex : sq x = ε := by
    have h := hQ1 1 0 0 0 (b 0) (by simp)
    rw [hbx] at h
    have h1 : sq x = ε * 1 ^ 2 + 1 * 0 + ε * 0 ^ 2 + 0 * 0 := h
    rw [h1]
    ring
  have ey : sq y = ε := by
    have h := hQ1 0 1 0 0 (b 1) (by simp)
    rw [hby] at h
    have h1 : sq y = ε * 0 ^ 2 + 0 * 1 + ε * 1 ^ 2 + 0 * 0 := h
    rw [h1]
    ring
  have eu : sq u = 0 := by
    have h := hQ1 0 0 1 0 (b 2) (by simp)
    rw [hbu] at h
    have h1 : sq u = ε * 0 ^ 2 + 0 * 0 + ε * 0 ^ 2 + 1 * 0 := h
    rw [h1]
    ring
  have ev : sq v = 0 := by
    have h := hQ1 0 0 0 1 (b 3) (by simp)
    rw [hbv] at h
    have h1 : sq v = ε * 0 ^ 2 + 0 * 0 + ε * 0 ^ 2 + 0 * 1 := h
    rw [h1]
    ring
  have exy : sq (x * y) = 1 := by
    have h := hQ1 1 1 0 0 (b 0 + b 1) (by simp)
    rw [hbx, hby, hadd] at h
    refine h.trans ?_
    rcases hε with rfl | rfl <;> decide
  have euv : sq (u * v) = 1 := by
    have h := hQ1 0 0 1 1 (b 2 + b 3) (by simp)
    rw [hbu, hbv, hadd] at h
    refine h.trans ?_
    rcases hε with rfl | rfl <;> decide
  have exu : sq (x * u) = ε := by
    have h := hQ1 1 0 1 0 (b 0 + b 2) (by simp)
    rw [hbx, hbu, hadd] at h
    refine h.trans ?_
    ring
  have exv : sq (x * v) = ε := by
    have h := hQ1 1 0 0 1 (b 0 + b 3) (by simp)
    rw [hbx, hbv, hadd] at h
    refine h.trans ?_
    ring
  have eyu : sq (y * u) = ε := by
    have h := hQ1 0 1 1 0 (b 1 + b 2) (by simp)
    rw [hby, hbu, hadd] at h
    refine h.trans ?_
    ring
  have eyv : sq (y * v) = ε := by
    have h := hQ1 0 1 0 1 (b 1 + b 3) (by simp)
    rw [hby, hbv, hadd] at h
    refine h.trans ?_
    ring
  have z1 : ∀ c : ZMod 2, c + ε + ε = 1 → c = 1 := by
    rcases hε with rfl | rfl <;> decide
  have z0 : ∀ c : ZMod 2, c + ε + 0 = ε → c = 0 := by
    rcases hε with rfl | rfl <;> decide
  rw [hP1, ex, ey] at exy
  rw [hP1, eu, ev] at euv
  rw [hP1, ex, eu] at exu
  rw [hP1, ex, ev] at exv
  rw [hP1, ey, eu] at eyu
  rw [hP1, ey, ev] at eyv
  have hxy : ⁅x, y⁆ = z := hcm1 x y (by rw [← hP3]; exact z1 _ exy)
  have huv : ⁅u, v⁆ = z := hcm1 u v (by rw [← hP3]; exact zmod_two_eq_one_of_add_zero_add_zero euv)
  have hxu : ⁅x, u⁆ = 1 := (hcm0 x u).mp (by rw [← hP3]; exact z0 _ exu)
  have hxv : ⁅x, v⁆ = 1 := (hcm0 x v).mp (by rw [← hP3]; exact z0 _ exv)
  have hyu : ⁅y, u⁆ = 1 := (hcm0 y u).mp (by rw [← hP3]; exact z0 _ eyu)
  have hyv : ⁅y, v⁆ = 1 := (hcm0 y v).mp (by rw [← hP3]; exact z0 _ eyv)
  have hcoord : (fun c : Fin 4 → ZMod 2 =>
      ((x ^ (c 0).val * y ^ (c 1).val * u ^ (c 2).val * v ^ (c 3).val : S) : S ⧸ center S)) =
      Additive.toMul ∘ b.equivFun.symm := by
    funext c
    rw [Function.comp_apply, Module.Basis.equivFun_symm_apply, Fin.sum_univ_four, hbx, hby, hbu,
      hbv]
    simp only [hsmul_def, toMul_add, toMul_nsmul, toMul_ofMul, QuotientGroup.mk_mul,
      QuotientGroup.mk_pow]
  have hbij : Function.Bijective (fun c : Fin 4 → ZMod 2 =>
      ((x ^ (c 0).val * y ^ (c 1).val * u ^ (c 2).val * v ^ (c 3).val : S) : S ⧸ center S)) := by
    rw [hcoord]
    exact Additive.toMul.bijective.comp b.equivFun.symm.bijective
  have hgen : closure ({x, y, u, v} : Set S) = ⊤ := by
    refine burnsideA314_closure_top ?_ hZ hbij
    rw [← hxy, commutatorElement_def]
    exact mul_mem (mul_mem (mul_mem (subset_closure (by simp)) (subset_closure (by simp)))
      (inv_mem (subset_closure (by simp)))) (inv_mem (subset_closure (by simp)))
  refine ⟨x, y, u, v, hgen, hxy, huv, hxu, hxv, hyu, hyv, (hsq0 u).mp eu, (hsq0 v).mp ev, ?_⟩
  rcases hε with rfl | rfl
  · exact Or.inr ⟨(hsq0 x).mp ex, (hsq0 y).mp ey⟩
  · exact Or.inl ⟨hsq1 x ex, hsq1 y ey⟩

private theorem burnsideA314_card_sup {Γ : Type} [Group Γ] {A B : Subgroup Γ}
    (hc : ∀ a ∈ A, ∀ b ∈ B, a * b = b * a) :
    Nat.card ↥(A ⊔ B) * Nat.card ↥(A ⊓ B) = Nat.card ↥A * Nat.card ↥B := by
  have hcomm : ∀ (a : ↥A) (b : ↥B), Commute (A.subtype a) (B.subtype b) :=
    fun a b => hc a a.2 b b.2
  let φ := MonoidHom.noncommCoprod A.subtype B.subtype hcomm
  have hrange : φ.range = A ⊔ B := by
    simp only [φ, MonoidHom.noncommCoprod_range, Subgroup.range_subtype]
  have hker : Nat.card φ.ker = Nat.card ↥(A ⊓ B) := by
    refine Nat.card_congr
      { toFun := fun k => ⟨(k.1.1 : Γ), k.1.1.2, ?_⟩
        invFun := fun x => ⟨(⟨x.1, x.2.1⟩, ⟨x.1⁻¹, B.inv_mem x.2.2⟩), ?_⟩
        left_inv := ?_
        right_inv := ?_ }
    · have hk := k.2
      rw [MonoidHom.mem_ker] at hk
      have : (k.1.1 : Γ) * (k.1.2 : Γ) = 1 := by simpa [φ] using hk
      have h2 : (k.1.1 : Γ) = (k.1.2 : Γ)⁻¹ := eq_inv_of_mul_eq_one_left this
      rw [h2]; exact B.inv_mem k.1.2.2
    · simp [φ]
    · rintro ⟨⟨a, b⟩, hk⟩
      rw [MonoidHom.mem_ker] at hk
      have : (a : Γ) * (b : Γ) = 1 := by simpa [φ] using hk
      have h2 : (a : Γ) = (b : Γ)⁻¹ := eq_inv_of_mul_eq_one_left this
      apply Subtype.ext
      apply Prod.ext
      · rfl
      · apply Subtype.ext
        simp [h2]
    · intro x; rfl
  have := Subgroup.card_ker_mul_card_range φ
  rw [hrange, hker] at this
  rw [mul_comm, this, Nat.card_prod]

private theorem burnsideA314_isQ8D8_sup {W : Type} [Group W] {Q E : Subgroup W}
    (hQ : Nonempty (↥Q ≃* QuaternionGroup 2)) (hE : Nonempty (↥E ≃* DihedralGroup 4))
    (hc : ∀ q ∈ Q, ∀ e ∈ E, q * e = e * q) (hn : Nat.card ↥(Q ⊓ E) = 2) :
    ChA.IsQ8D8 ↥(Q ⊔ E) := by
  obtain ⟨eQ⟩ := hQ
  obtain ⟨eE⟩ := hE
  have hQN : Q ≤ Subgroup.normalizer (E : Set W) := by
    refine le_trans (fun q hq => ?_) (Subgroup.centralizer_le_normalizer (E : Set W))
    rw [Subgroup.mem_centralizer_iff]
    intro e he
    exact (hc q hq e he).symm
  refine ⟨Q.subgroupOf (Q ⊔ E), E.subgroupOf (Q ⊔ E),
    ⟨(Subgroup.subgroupOfEquivOfLe le_sup_left).trans eQ⟩,
    ⟨(Subgroup.subgroupOfEquivOfLe le_sup_right).trans eE⟩, ?_, ?_, ?_⟩
  · intro q hq e he
    exact Subtype.ext (hc q hq e he)
  · rw [eq_top_iff]
    intro w _
    have hmem : (w : W) ∈ ((Q ⊔ E : Subgroup W) : Set W) := w.2
    rw [Subgroup.coe_mul_of_left_le_normalizer_right Q E hQN] at hmem
    obtain ⟨q, hq, e, he, hqe⟩ := Set.mem_mul.mp hmem
    have hw : w = (⟨q, Subgroup.mem_sup_left hq⟩ : ↥(Q ⊔ E)) * ⟨e, Subgroup.mem_sup_right he⟩ :=
      Subtype.ext hqe.symm
    rw [hw]
    exact Subgroup.mul_mem_sup (Subgroup.mem_subgroupOf.mpr hq) (Subgroup.mem_subgroupOf.mpr he)
  · have h1 : Q.subgroupOf (Q ⊔ E) ⊓ E.subgroupOf (Q ⊔ E) = (Q ⊓ E).subgroupOf (Q ⊔ E) := by
      ext w
      simp [Subgroup.mem_subgroupOf]
    rw [h1, ← hn]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe (inf_le_left.trans le_sup_left)).toEquiv

open scoped commutatorElement in
private theorem burnsideA314_isZ4StarQ8D8 {W : Type} [Group W] [Finite W]
    (h : CFSG.Quasithin.IsZ4StarExtra2 W) : ChA.IsZ4StarQ8D8 W := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨Z, E, hZ4, hZc, ⟨hEe, hEc⟩, hZcen, hZE, hZEi⟩ := h
  have hEcard : Nat.card ↥E = 32 := by rw [hEc]; norm_num
  have hS : CFSG.IsExtraspecialPGroup 2 ↥E := CFSG.isExtraspecialPGroup_iff_isExtraspecial.mpr hEe
  obtain ⟨g, hg⟩ := hZc.exists_generator
  set i : W := (g : W)
  have hiZ : i ∈ Z := g.2
  have hZi : Z = Subgroup.zpowers i := by
    apply le_antisymm
    · intro w hw
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hg ⟨w, hw⟩)
      exact Subgroup.mem_zpowers_iff.mpr ⟨k, by simpa using congrArg Subtype.val hk⟩
    · exact Subgroup.zpowers_le.mpr hiZ
  have hord : orderOf i = 4 := by
    have h1 := Nat.card_zpowers i
    rw [← hZi, hZ4] at h1
    exact h1.symm
  have hi4 : i ^ 4 = 1 := hord ▸ pow_orderOf_eq_one i
  have hicen : ∀ w : W, i * w = w * i := fun w =>
    (Subgroup.mem_center_iff.mp (hZcen hiZ) w).symm
  set z : W := i * i with hzdef
  have hzz : z * z = 1 := by
    rw [hzdef, show i * i * (i * i) = i ^ 4 by rw [show (4 : ℕ) = 2 + 2 from rfl, pow_add, sq]]
    exact hi4
  have hz1 : z ≠ 1 := fun h' => by
    have : orderOf i ∣ 2 := orderOf_dvd_of_pow_eq_one (by rw [sq]; exact h')
    rw [hord] at this
    omega
  have hiE : i ∉ E := fun h' => by
    have hle : Z ≤ E := by rw [hZi]; exact Subgroup.zpowers_le.mpr h'
    rw [inf_eq_left.mpr hle, hZ4] at hZEi
    omega
  have hzE : z ∈ E := by
    obtain ⟨w, hwZ, hwE, hw1⟩ : ∃ w : W, w ∈ Z ∧ w ∈ E ∧ w ≠ 1 := by
      obtain ⟨y, hy1, -⟩ := (Nat.card_eq_two_iff' (1 : ↥(Z ⊓ E))).mp hZEi
      exact ⟨y, (Subgroup.mem_inf.mp y.2).1, (Subgroup.mem_inf.mp y.2).2,
        fun h' => hy1 (Subtype.ext h')⟩
    rw [hZi, mem_zpowers_iff_mem_range_orderOf, Finset.mem_image, hord] at hwZ
    obtain ⟨r, hr, hrw⟩ := hwZ
    rw [Finset.mem_range] at hr
    interval_cases r
    · exact absurd (by rw [← hrw]; simp) hw1
    · rw [pow_one] at hrw
      exact absurd (hrw ▸ hwE) hiE
    · rw [sq] at hrw
      rw [hzdef, hrw]
      exact hwE
    · exfalso
      apply hiE
      have h3 : w⁻¹ = i := by
        rw [← hrw]
        apply inv_eq_of_mul_eq_one_right
        rw [← pow_succ, hi4]
      rw [← h3]
      exact E.inv_mem hwE
  set zE : ↥E := ⟨z, hzE⟩
  have hzEc : zE ∈ Subgroup.center ↥E := by
    rw [Subgroup.mem_center_iff]
    intro e
    apply Subtype.ext
    show (e : W) * (i * i) = (i * i) * (e : W)
    calc (e : W) * (i * i) = (e * i) * i := (mul_assoc _ _ _).symm
      _ = (i * e) * i := by rw [← hicen e]
      _ = i * (e * i) := mul_assoc _ _ _
      _ = i * (i * e) := by rw [← hicen e]
      _ = (i * i) * e := (mul_assoc _ _ _).symm
  have hzE1 : zE ≠ 1 := fun h' => hz1 (congrArg Subtype.val h')
  obtain ⟨z₀, -, hz₀, hZ₀⟩ := burnsideA314_center_two hS.natCard_center
  have hzEeq : zE = z₀ := (hZ₀ zE hzEc).resolve_left hzE1
  have hcenE : Subgroup.center ↥E = Subgroup.zpowers zE := by rw [hzEeq]; exact hz₀
  obtain ⟨x, y, u, v, hgen, hxy, huv, hxu, hxv, hyu, hyv, hu2, hv2, hxy2⟩ :=
    burnsideA314_basis hS hEcard hcenE
  have hcomW : ∀ a b : ↥E, ⁅a, b⁆ = zE → (a : W) * b = z * ((b : W) * a) := by
    intro a b hab
    have h1 : a * b = zE * (b * a) := by
      calc a * b = ⁅a, b⁆ * (b * a) := by rw [commutatorElement_def]; group
        _ = zE * (b * a) := by rw [hab]
    exact congrArg Subtype.val h1
  have hcommW : ∀ a b : ↥E, ⁅a, b⁆ = 1 → (a : W) * b = b * a := fun a b hab =>
    congrArg Subtype.val (commutatorElement_eq_one_iff_mul_comm.mp hab)
  have hsqW : ∀ a : ↥E, a * a = zE → (a : W) * a = z := fun a ha => congrArg Subtype.val ha
  have hsq1W : ∀ a : ↥E, a * a = 1 → (a : W) * a = 1 := fun a ha => congrArg Subtype.val ha
  have hcc : ∀ a b : W, i * a * (i * b) = z * (a * b) := by
    intro a b
    calc i * a * (i * b) = i * (a * i) * b := by simp only [mul_assoc]
      _ = i * (i * a) * b := by rw [← hicen a]
      _ = z * (a * b) := by simp only [mul_assoc, hzdef]
  have hci : ∀ a b : W, a * b = b * a → (i * a) * b = b * (i * a) := by
    intro a b hab
    calc i * a * b = i * (a * b) := mul_assoc _ _ _
      _ = i * (b * a) := by rw [hab]
      _ = (i * b) * a := (mul_assoc _ _ _).symm
      _ = (b * i) * a := by rw [← hicen b]
      _ = b * (i * a) := by rw [mul_assoc]
  have hi3 : ∀ a : W, i ^ 3 * (i * a) = a := by
    intro a
    calc i ^ 3 * (i * a) = (i ^ 3 * i) * a := (mul_assoc _ _ _).symm
      _ = a := by rw [← pow_succ, hi4, one_mul]
  obtain ⟨x', y', hx'x, hy'y, hxx', hyy', hx'y', hx'u, hx'v, hy'u, hy'v⟩ :
      ∃ x' y' : W, ((x : W) = x' ∨ (x : W) = i ^ 3 * x') ∧ ((y : W) = y' ∨ (y : W) = i ^ 3 * y') ∧
        x' * x' = z ∧ y' * y' = z ∧ x' * y' = z * (y' * x') ∧ x' * (u : W) = u * x' ∧
        x' * (v : W) = v * x' ∧ y' * (u : W) = u * y' ∧ y' * (v : W) = v * y' := by
    rcases hxy2 with ⟨hx2, hy2⟩ | ⟨hx2, hy2⟩
    · exact ⟨x, y, Or.inl rfl, Or.inl rfl, hsqW x hx2, hsqW y hy2, hcomW x y hxy, hcommW x u hxu,
        hcommW x v hxv, hcommW y u hyu, hcommW y v hyv⟩
    · have hx1 := hsq1W x hx2
      have hy1 := hsq1W y hy2
      have hxyc := hcomW x y hxy
      refine ⟨i * x, i * y, Or.inr (hi3 x).symm, Or.inr (hi3 y).symm, ?_, ?_, ?_,
        hci _ _ (hcommW x u hxu), hci _ _ (hcommW x v hxv), hci _ _ (hcommW y u hyu),
        hci _ _ (hcommW y v hyv)⟩
      · rw [hcc, hx1, mul_one]
      · rw [hcc, hy1, mul_one]
      · rw [hcc, hcc, hxyc]
  have hu2' : (u : W) * u = 1 := hsq1W u hu2
  have hv2' : (v : W) * v = 1 := hsq1W v hv2
  obtain ⟨Q, E', hQ, hE', hQE, hn, hxQ, hyQ, huE, hvE, hzQ, hzE'⟩ :=
    burnsideA314_gens hzz hz1 hxx' hyy' hx'y' hu2' hv2' (hcomW u v huv) hx'u hx'v hy'u hy'v
  have hQ8 : Nat.card ↥Q = 8 := by
    obtain ⟨e⟩ := hQ
    rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card, QuaternionGroup.card]
  have hE8 : Nat.card ↥E' = 8 := by
    obtain ⟨e⟩ := hE'
    rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card, DihedralGroup.card]
  have hW'card : Nat.card ↥(Q ⊔ E') = 32 := by
    have h1 := burnsideA314_card_sup hQE
    rw [hn, hQ8, hE8] at h1
    omega
  have hEle : E ≤ Z ⊔ (Q ⊔ E') := by
    have h1 : (⊤ : Subgroup ↥E) ≤ (Z ⊔ (Q ⊔ E')).comap E.subtype := by
      rw [← hgen, Subgroup.closure_le]
      rintro w (rfl | rfl | rfl | rfl)
      · show (w : W) ∈ Z ⊔ (Q ⊔ E')
        rcases hx'x with h' | h'
        · rw [h']
          exact Subgroup.mem_sup_right (Subgroup.mem_sup_left hxQ)
        · rw [h']
          exact Subgroup.mul_mem_sup (pow_mem hiZ 3) (Subgroup.mem_sup_left hxQ)
      · show (w : W) ∈ Z ⊔ (Q ⊔ E')
        rcases hy'y with h' | h'
        · rw [h']
          exact Subgroup.mem_sup_right (Subgroup.mem_sup_left hyQ)
        · rw [h']
          exact Subgroup.mul_mem_sup (pow_mem hiZ 3) (Subgroup.mem_sup_left hyQ)
      · exact Subgroup.mem_sup_right (Subgroup.mem_sup_right huE)
      · exact Subgroup.mem_sup_right (Subgroup.mem_sup_right hvE)
    intro e he
    exact h1 (Subgroup.mem_top (⟨e, he⟩ : ↥E))
  refine ⟨Z, Q ⊔ E', hZ4, hZc, burnsideA314_isQ8D8_sup hQ hE' hQE hn, hZcen, ?_, ?_⟩
  · rw [eq_top_iff, ← hZE]
    exact sup_le le_sup_left hEle
  · have hzZ : z ∈ Z := mul_mem hiZ hiZ
    have hzT : Subgroup.zpowers z ≤ Z ⊓ (Q ⊔ E') :=
      Subgroup.zpowers_le.mpr (Subgroup.mem_inf.mpr ⟨hzZ, Subgroup.mem_sup_left hzQ⟩)
    have hzo : orderOf z = 2 := orderOf_eq_prime (by rw [sq]; exact hzz) hz1
    have hdvd : Nat.card ↥(Z ⊓ (Q ⊔ E')) ∣ 4 := hZ4 ▸ Subgroup.card_dvd_of_le inf_le_left
    have h2dvd : 2 ∣ Nat.card ↥(Z ⊓ (Q ⊔ E')) := by
      have := Subgroup.card_dvd_of_le hzT
      rwa [Nat.card_zpowers, hzo] at this
    have hle4 : Nat.card ↥(Z ⊓ (Q ⊔ E')) ≤ 4 := Nat.le_of_dvd (by norm_num) hdvd
    have hpos : 0 < Nat.card ↥(Z ⊓ (Q ⊔ E')) := Nat.card_pos
    by_contra hne
    have h4 : Nat.card ↥(Z ⊓ (Q ⊔ E')) = 4 := by
      interval_cases hc : Nat.card ↥(Z ⊓ (Q ⊔ E')) <;> first | rfl | omega
    have hZT : Z ⊓ (Q ⊔ E') = Z :=
      Subgroup.eq_of_le_of_card_ge inf_le_left (by rw [hZ4, h4])
    have hZle : Z ≤ Q ⊔ E' := inf_eq_left.mp hZT
    have hE' : E ≤ Q ⊔ E' := by
      refine hEle.trans (sup_le hZle le_rfl)
    have hEeq : E = Q ⊔ E' := Subgroup.eq_of_le_of_card_ge hE' (by rw [hW'card, hEcard])
    exact hiE (hEeq ▸ hZle hiZ)

private theorem burnsideA314_block_self {G : Type} [Group G] {T B : Subgroup G}
    (h : CFSG.QuasithinUnique.IsBlock2 (B ⊔ T) B) : CFSG.QuasithinUnique.IsBlock2 B B := by
  refine ⟨h.1, le_rfl, ?_⟩
  rw [Subgroup.subgroupOf_self]
  exact CFSG.Open.IsSubnormal.top_iff.mp (CFSG.Open.IsSubnormal.refl _)

private theorem burnsideA314_toCat {G : Type} [Group G] [Finite G] (h : ChA.HypA_3_4 G) :
    CFSG.QuasithinUnique.Vol2Native.SQTKHypCat G :=
  { finite := inferInstance
    sqt := h.sqt
    kgroup := h.kgroup
    o2 := h.o2 }

private theorem burnsideA314_commutator_top {G : Type} [Group G] {K : Subgroup G} (h : ⁅K, K⁆ = K) :
    commutator ↥K = ⊤ := by
  have htop : (⊤ : Subgroup ↥K).map K.subtype = K := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  apply Subgroup.map_injective K.subtype_injective
  rw [commutator_def, Subgroup.map_commutator, htop, h]

private theorem burnsideA314_bridge {G : Type} [Group G] [Finite G] {T B L : Subgroup G}
    (h : CFSG.Quasithin.A314Statement T B L) (hB : B ∈ CFSG.Quasithin.lFamily T) :
    ChA.A314Conclusion T B L := by
  have hperf : commutator ↥B = ⊤ :=
    burnsideA314_commutator_top (CFSG.Quasithin.perfect_of_mem_cComp hB)
  unfold CFSG.Quasithin.A314Statement at h
  unfold ChA.A314Conclusion
  rcases h with h | h | h | h | h | h | h | h | h | h | h | h | h | h
  · exact Or.inl h
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr (Or.inl h))
  · iterate 3 right
    left
    exact h
  · iterate 4 right
    left
    exact h
  · iterate 5 right
    left
    exact ⟨h.1, burnsideA314_block_self h.2.1, h.2.2⟩
  · iterate 6 right
    left
    exact ⟨h.1, burnsideA314_block_self h.2.1, h.2.2⟩
  · iterate 7 right
    left
    exact h
  · iterate 8 right
    left
    obtain ⟨⟨V, hVn, hV, hA⟩, hJ, hz⟩ := h
    haveI := hVn
    exact ⟨⟨V, hVn, burnsideA314_isQ8D8 V hV hA hperf, hA⟩, hJ, hz⟩
  · iterate 9 right
    left
    exact h
  · iterate 10 right
    left
    obtain ⟨⟨V, hVn, hV, hA⟩, hHS, hz⟩ := h
    exact ⟨⟨V, hVn, burnsideA314_isZ4StarQ8D8 hV, hA⟩, hHS, hz⟩
  · iterate 11 right
    left
    exact h
  · iterate 12 right
    left
    exact h
  · iterate 13 right
    exact h

end BurnsideA314

