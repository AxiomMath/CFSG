@[expose] def burnsideA35_lines (q : Fin 22) : Finset (Finset (Fin 22)) :=
  ((burnsideA35_linesTab q).map List.toFinset).toFinset

@[expose] def burnsideA35_Fwd (g : Equiv.Perm (Fin 22)) : Prop :=
  ∀ q, ∀ L ∈ burnsideA35_lines q, L.image g ∈ burnsideA35_lines (g q)

instance burnsideA35_instDecidableFwd (g : Equiv.Perm (Fin 22)) :
    Decidable (burnsideA35_Fwd g) := by
  unfold burnsideA35_Fwd; infer_instance

def burnsideA35_T : Subgroup (Equiv.Perm (Fin 22)) where
  carrier := {g | burnsideA35_Fwd g ∧ burnsideA35_Fwd g⁻¹}
  mul_mem' := by
    rintro g h ⟨hg, hg'⟩ ⟨hh, hh'⟩
    refine ⟨fun q L hL => ?_, fun q L hL => ?_⟩
    · have h2 := hg (h q) _ (hh q L hL)
      rwa [Finset.image_image] at h2
    · have h2 := hh' (g⁻¹ q) _ (hg' q L hL)
      rw [mul_inv_rev]
      rwa [Finset.image_image] at h2
  one_mem' := ⟨fun q L hL => by simpa using hL, fun q L hL => by simpa using hL⟩
  inv_mem' := by
    rintro g ⟨hg, hg'⟩
    exact ⟨by simpa using hg', by simpa using hg⟩

private theorem burnsideA35_Fwd_of_tab {g : Equiv.Perm (Fin 22)}
    (h : ∀ q, ∀ l ∈ burnsideA35_linesTab q,
      l.toFinset.image g ∈ burnsideA35_lines (g q)) : burnsideA35_Fwd g := by
  intro q L hL
  simp only [burnsideA35_lines, Finset.mem_val, List.mem_toFinset, List.mem_map] at hL
  obtain ⟨l, hl, rfl⟩ := hL
  exact h q l hl

theorem burnsideA35_α_mem_T : burnsideA35_α ∈ burnsideA35_T :=
  ⟨burnsideA35_Fwd_of_tab (by decide +kernel), burnsideA35_Fwd_of_tab (by decide +kernel)⟩

theorem burnsideA35_β_mem_T : burnsideA35_β ∈ burnsideA35_T :=
  ⟨burnsideA35_Fwd_of_tab (by decide +kernel), burnsideA35_Fwd_of_tab (by decide +kernel)⟩

theorem burnsideA35_γ_mem_T : burnsideA35_γ ∈ burnsideA35_T :=
