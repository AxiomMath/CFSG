@[expose] def HasPinnedSylowFieldAction {S M : Type} [Group S] [Group M]
    (identification : S ≃* M) (U : Subgroup S) (F : Subgroup (MulAut S))
    (entrywiseAction : MulAut M → Prop) : Prop :=
  ∃ (modelSylow : Subgroup M) (modelGenerator : MulAut M),
    U.map identification.toMonoidHom = modelSylow ∧
    CFSG.Quasithin.A315.IsSylowOf 2 modelSylow ⊤ ∧
    F.map (MulAut.congr identification).toMonoidHom = Subgroup.zpowers modelGenerator ∧
    entrywiseAction modelGenerator ∧
    ∀ automorphism ∈ Subgroup.zpowers modelGenerator,
      modelSylow.map automorphism.toMonoidHom = modelSylow

@[expose] def A315PinnedFieldGroup (n : ℕ) (S : Type) [Group S]
    (U : Subgroup S) (F : Subgroup (MulAut S)) : Prop :=
  (∃ (K : Type) (_ : Field K) (_ : Finite K) (identification : S ≃* StatedProj (StatedSL 2 K))
      (fieldGenerator : RingAut K), Nat.card K = 2 ^ n ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator => IsProjFieldAut (StatedSL 2 K) fieldGenerator modelGenerator)) ∨
  (∃ (K : Type) (_ : Field K) (_ : Finite K) (identification : S ≃* StatedProj (StatedSL 3 K))
      (fieldGenerator : RingAut K), Nat.card K = 2 ^ n ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator => IsProjFieldAut (StatedSL 3 K) fieldGenerator modelGenerator)) ∨
  (∃ (K : Type) (_ : Field K) (_ : Finite K)
      (identification : S ≃* StatedProj (StatedSU 3 (2 ^ n) K)) (fieldGenerator : RingAut K), Nat.card K = (2 ^ n) ^ 2 ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator =>
        Nat.Coprime (orderOf fieldGenerator) 2 ∧ IsProjFieldAut (StatedSU 3 (2 ^ n) K) fieldGenerator modelGenerator)) ∨
  (∃ (K : Type) (_ : Field K) (_ : Finite K) (identification : S ≃* StatedProj (StatedSp 2 K))
      (fieldGenerator : RingAut K), Nat.card K = 2 ^ n ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator => IsProjFieldAut (StatedSp 2 K) fieldGenerator modelGenerator)) ∨
  (∃ (a : ℕ) (K : Type) (_ : Field K) (_ : Finite K) (identification : S ≃* ↥(suzukiGroup a K))
      (fieldGenerator : RingAut K), n = 2 * a + 1 ∧ Nat.card K = 2 ^ n ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator =>
        ∀ g : ↥(suzukiGroup a K), ∃ g' : ↥(suzukiGroup a K),
          (g' : GL (Fin 4) K) = glMapAut fieldGenerator (g : GL (Fin 4) K) ∧ modelGenerator g = g')) ∨
  (∃ (K : Type) (_ : Field K) (_ : Finite K) (identification : S ≃* AdjointQuotient Tag.G2 K)
      (fieldGenerator : RingAut K), Nat.card K = 2 ^ n ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator =>
        ∀ g : ↥(adjointGroup Tag.G2 K), ∃ g' : ↥(adjointGroup Tag.G2 K),
          (g' : ModGL Tag.G2 K) = Units.map (entrywiseHom (fieldGenerator : K →+* K)) (g : ModGL Tag.G2 K) ∧
          modelGenerator (QuotientGroup.mk g) = QuotientGroup.mk g')) ∨
  (∃ (K : Type) (_ : Field K) (_ : Finite K) (σq : K →+* K)
      (identification : S ≃* DerivedCentralQuotient (twistedFixedGroup TwistTag.D4 K σq)) (fieldGenerator : RingAut K),
      Nat.card K = (2 ^ n) ^ 3 ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator => (∀ c, σq c = c ^ 2 ^ n) ∧ Nat.Coprime (orderOf fieldGenerator) 3 ∧
        ∀ g : ↥⁅twistedFixedGroup TwistTag.D4 K σq, twistedFixedGroup TwistTag.D4 K σq⁆,
          ∃ g' : ↥⁅twistedFixedGroup TwistTag.D4 K σq, twistedFixedGroup TwistTag.D4 K σq⁆,
            (g' : ModGL TwistTag.D4.tag K) =
              Units.map (entrywiseHom (fieldGenerator : K →+* K)) (g : ModGL TwistTag.D4.tag K) ∧
            modelGenerator (QuotientGroup.mk g) = QuotientGroup.mk g')) ∨
  (∃ (a : ℕ) (K : Type) (_ : Field K) (_ : Finite K)
      (identification : S ≃* DerivedCentralQuotient
        (reeFixedGroup Tag.F4 K reeF4Perm fun i => if i ∈ reeF4Long then 2 ^ a else 2 ^ (a + 1)))
      (fieldGenerator : RingAut K), n = 2 * a + 1 ∧ Nat.card K = 2 ^ n ∧
      HasPinnedSylowFieldAction identification U F (fun modelGenerator =>
        ∀ g : ↥⁅reeFixedGroup Tag.F4 K reeF4Perm
            (fun i => if i ∈ reeF4Long then 2 ^ a else 2 ^ (a + 1)),
            reeFixedGroup Tag.F4 K reeF4Perm
            (fun i => if i ∈ reeF4Long then 2 ^ a else 2 ^ (a + 1))⁆,
          ∃ g' : ↥⁅reeFixedGroup Tag.F4 K reeF4Perm
            (fun i => if i ∈ reeF4Long then 2 ^ a else 2 ^ (a + 1)),
            reeFixedGroup Tag.F4 K reeF4Perm
            (fun i => if i ∈ reeF4Long then 2 ^ a else 2 ^ (a + 1))⁆,
            (g' : ModGL Tag.F4 K) =
              Units.map (entrywiseHom (fieldGenerator : K →+* K)) (g : ModGL Tag.F4 K) ∧
            modelGenerator (QuotientGroup.mk g) = QuotientGroup.mk g'))

@[expose] def A315Case5Concrete {G : Type} [Group G] (L T B : Subgroup G) : Prop :=
  ∃ (_ : L.Normal) (n : ℕ), 2 ≤ n ∧ CFSG.Quasithin.A315.IsLieChar2 n ↥L ∧
    ∃ F H : Subgroup (MulAut ↥L),
      IsCyclic ↥F ∧ Nat.card ↥F ∣ n ∧
      A315PinnedFieldGroup n ↥L ((T ⊓ L).subgroupOf L) F ∧
      F ≤ Subgroup.normalizer
        (CFSG.Quasithin.A315.autImage L (T ⊓ L) : Set (MulAut ↥L)) ∧
      F ≤ Subgroup.normalizer (H : Set (MulAut ↥L)) ∧
      CFSG.Quasithin.A315.IsCartan 2 (CFSG.Quasithin.A315.autImage L (T ⊓ L))
        ((F ⊔ CFSG.Quasithin.A315.autImage L B ⊔ CFSG.Quasithin.A315.autImage L L) ⊓
          innDiagSubgroup ↥L) H ∧
      F ⊔ CFSG.Quasithin.A315.autImage L B ⊔ CFSG.Quasithin.A315.autImage L L =
        H ⊔ CFSG.Quasithin.A315.autImage L B ⊔ CFSG.Quasithin.A315.autImage L L ∧
      CFSG.Quasithin.A315.autImage L B ≤ F ⊔ H

end ChA

@[expose] def A_3_3 : Prop :=
  ∀ (G : Type) [Group G] [Finite G],
    (∀ L ∈ CFSG.Quasithin.cComp (⊤ : Subgroup G),
      (Maximal (fun K : Subgroup G => CFSG.Open.IsSubnormal K L ∧ K ≠ L)
          (CFSG.Quasithin.solvRad L) ∧
        ∀ M : Subgroup G, Maximal (fun K : Subgroup G => CFSG.Open.IsSubnormal K L ∧ K ≠ L) M →
          M = CFSG.Quasithin.solvRad L) ∧
      (IsSimpleGroup (↥L ⧸ (CFSG.Quasithin.solvRad L).subgroupOf L) ∧
        ∃ a b : ↥L ⧸ (CFSG.Quasithin.solvRad L).subgroupOf L, a * b ≠ b * a) ∧
      CFSG.Quasithin.cComp L = {L}) ∧
    (∀ H : Subgroup G,
      (CFSG.Quasithin.cCompInter (⊤ : Subgroup G) H ⊆ CFSG.Quasithin.cComp H) ∧
      (CFSG.Open.IsSubnormal H ⊤ →
        CFSG.Quasithin.cCompInter (⊤ : Subgroup G) H = CFSG.Quasithin.cComp H)) ∧
    (∀ L ∈ CFSG.Quasithin.cComp (⊤ : Subgroup G), ∀ N : Subgroup G, Group.IsSolvable N →
      L ≤ ChA.normalizerOf N →
      ⁅L, N⁆ ≤ L ∧ CFSG.Quasithin.perfectCore (L ⊔ N) = L) ∧
    (∀ (N : Subgroup G) [N.Normal], Group.IsSolvable N →
      Set.BijOn (fun L : Subgroup G => L.map (QuotientGroup.mk' N))
        (CFSG.Quasithin.cComp (⊤ : Subgroup G))
        (CFSG.Quasithin.cComp (⊤ : Subgroup (G ⧸ N)))) ∧
    (CFSG.Quasithin.cComp (⊤ : Subgroup (G ⧸ CFSG.solvableRadical G)) =
        {K | CFSG.IsComponent K} ∧
      CFSG.Quasithin.cCompSpan (⊤ : Subgroup G) =
        CFSG.Quasithin.perfectCore (CFSG.Quasithin.oInftyE G)) ∧
    (∀ L ∈ CFSG.Quasithin.cComp (⊤ : Subgroup G),
      L ≤ CFSG.Quasithin.cCompSpan (⊤ : Subgroup G) ∧
        (L.subgroupOf (CFSG.Quasithin.cCompSpan (⊤ : Subgroup G))).Normal) ∧
    (∀ X : Subgroup G, ∀ L ∈ CFSG.Quasithin.cComp (⊤ : Subgroup G),
      (⁅L, X⁆ ≤ CFSG.Quasithin.solvRad (⊤ : Subgroup G) ∧ Group.IsSolvable ↥⁅L, X⁆) ∨
        ⁅L, X⁆ = CFSG.Quasithin.conjClosure L X)

theorem as_A_3_3 : A_3_3 := by
  intro G _ _
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro L hL
    exact CFSG.Quasithin.cComp_structure hL
  · intro H
    obtain ⟨h1, h2⟩ := CFSG.Quasithin.cCompInter_subset_and_eq (⊤ : Subgroup G) H
    exact ⟨h1 le_top, h2⟩
  · intro L hL N hN hLN
    exact CFSG.Quasithin.cComp_commutator_perfectCore hL le_top hN hLN
  · intro N _ hN
    exact CFSG.Quasithin.cComp_quotient_bijOn N hN
  · exact CFSG.Quasithin.cComp_part_five
  · intro L hL
    exact CFSG.Quasithin.cComp_normal_span hL
  · intro X L hL
    have h := CFSG.Quasithin.cComp_commutator_dichotomy hL X
    rwa [CFSG.Quasithin.A3.solvableRadical_eq_solvRad_top] at h

@[expose] def A_3_5 : Prop :=
  ∀ (S : Type) [Group S],
    (CFSG.Quasithin.IsAlt 6 S ∨ CFSG.Quasithin.IsAlt 7 S ∨ CFSG.Quasithin.IsSporadic .M22 S) →
    (∃ (X : Type) (_ : Group X), CFSG.Quasithin.IsHat X S) ∧
    ∀ (X Y : Type) [Group X] [Group Y], CFSG.Quasithin.IsHat X S → CFSG.Quasithin.IsHat Y S →
      Nonempty (X ≃* Y)

section BurnsideA35

open scoped commutatorElement in
private theorem burnsideA35_comm_mul_central_left {M : Type*} [Group M] {n z : M}
    (hz : z ∈ Subgroup.center M) (m : M) : ⁅n * z, m⁆ = ⁅n, m⁆ := by
  have hz' := Subgroup.mem_center_iff.1 hz
  rw [commutatorElement_def, commutatorElement_def]
  have h : z * m * z⁻¹ = m := by
    rw [← hz' m]
    simp
  calc n * z * m * (n * z)⁻¹ * m⁻¹ = n * (z * m * z⁻¹) * n⁻¹ * m⁻¹ := by group
    _ = n * m * n⁻¹ * m⁻¹ := by rw [h]

open scoped commutatorElement in
private theorem burnsideA35_commutator_le {M : Type*} [Group M] {P N : Subgroup M}
    (h : ∀ p ∈ P, ∃ n ∈ N, ∃ z ∈ Subgroup.center M, p = n * z) : ⁅P, P⁆ ≤ ⁅N, N⁆ := by
  rw [Subgroup.commutator_le]
  intro p hp q hq
  obtain ⟨n, hn, z, hz, rfl⟩ := h p hp
  obtain ⟨m, hm, y, hy, rfl⟩ := h q hq
  have e : ⁅n * z, m * y⁆ = ⁅n, m⁆ := by
    rw [burnsideA35_comm_mul_central_left hz, ← commutatorElement_inv,
      burnsideA35_comm_mul_central_left hy, commutatorElement_inv]
  rw [e]
  exact Subgroup.commutator_mem_commutator hn hm

open scoped commutatorElement in
private theorem burnsideA35_commutator_le_self {M : Type*} [Group M] (N : Subgroup M) : ⁅N, N⁆
    ≤ N := by
  rw [Subgroup.commutator_le]
  intro a ha b hb
  rw [commutatorElement_def]
  exact N.mul_mem (N.mul_mem (N.mul_mem ha hb) (N.inv_mem ha)) (N.inv_mem hb)

open scoped commutatorElement in
private theorem burnsideA35_cover_unique {S X Y : Type} [Group S] [Group X] [Group Y] [Finite X]
    [Finite Y] [Group.IsPerfect X] [Group.IsPerfect Y] (πX : X →* S) (πY : Y →* S)
    (hX : Function.Surjective πX) (hY : Function.Surjective πY)
    (hXc : πX.ker ≤ Subgroup.center X) (hYc : πY.ker ≤ Subgroup.center Y)
    (hXn : Nat.card πX.ker = 3) (hYn : Nat.card πY.ker = 3)
    (hbound : ∀ (W : Type) [Group W] [Finite W] [Group.IsPerfect W] (π : W →* S),
      Function.Surjective π → π.ker ≤ Subgroup.center W → Odd (Nat.card π.ker) →
      Nat.card π.ker = 1 ∨ Nat.card π.ker = 3) :
    Nonempty (X ≃* Y) := by
  classical
  haveI : Group.IsPerfect S := Group.IsPerfect.ofSurjective hX
  let f : X × Y →* S := πX.comp (MonoidHom.fst X Y)
  let P : Subgroup (X × Y) := (πX.comp (MonoidHom.fst X Y)).eqLocus (πY.comp (MonoidHom.snd X Y))
  have hP : ∀ p : X × Y, p ∈ P ↔ πX p.1 = πY p.2 := fun p => Iff.rfl
  let W' : Subgroup (X × Y) := ⁅P, P⁆
  let K : Subgroup (X × Y) := πX.ker.prod πY.ker
  have hKc : K ≤ Subgroup.center (X × Y) := by
    intro k hk
    rw [Subgroup.mem_center_iff]
    intro g
    refine Prod.ext ?_ ?_
    · exact Subgroup.mem_center_iff.1 (hXc hk.1) g.1
    · exact Subgroup.mem_center_iff.1 (hYc hk.2) g.2
  have hmapP : P.map f = ⊤ := by
    rw [eq_top_iff]
    intro s _
    obtain ⟨x, rfl⟩ := hX s
    obtain ⟨y, hy⟩ := hY (πX x)
    exact ⟨(x, y), (hP _).2 hy.symm, rfl⟩
  have hF1 : ∀ s : S, ∃ w ∈ W', πX w.1 = s := by
    intro s
    have h1 : W'.map f = ⊤ := by
      rw [show W' = ⁅P, P⁆ from rfl, Subgroup.map_commutator, hmapP,
        ← _root_.commutator_def, Group.IsPerfect.commutator_eq_top]
    have : s ∈ W'.map f := h1 ▸ Subgroup.mem_top s
    obtain ⟨w, hw, rfl⟩ := this
    exact ⟨w, hw, rfl⟩
  have hWP : W' ≤ P := burnsideA35_commutator_le_self P
  have hdec : ∀ p ∈ P, ∃ w ∈ W', ∃ z ∈ Subgroup.center (X × Y), p = w * z := by
    intro p hp
    obtain ⟨w, hw, hwp⟩ := hF1 (πX p.1)
    have hwP : w ∈ P := hWP hw
    refine ⟨w, hw, w⁻¹ * p, hKc ⟨?_, ?_⟩, by simp⟩
    · change πX (w.1⁻¹ * p.1) = 1
      rw [map_mul, map_inv, hwp, inv_mul_cancel]
    · change πY (w.2⁻¹ * p.2) = 1
      have h1 : πX w.1 = πY w.2 := (hP w).1 hwP
      have h2 : πX p.1 = πY p.2 := (hP p).1 hp
      rw [map_mul, map_inv, ← h1, hwp, h2, inv_mul_cancel]
  have hW'perf : ⁅W', W'⁆ = W' :=
    le_antisymm (burnsideA35_commutator_le_self W') (burnsideA35_commutator_le hdec)
  haveI : Group.IsPerfect W' := Subgroup.isPerfect_iff.2 hW'perf
  let pX : W' →* X := (MonoidHom.fst X Y).comp W'.subtype
  let pY : W' →* Y := (MonoidHom.snd X Y).comp W'.subtype
  let πW : W' →* S := πX.comp pX
  have hπW : ∀ w : W', πW w = πY (pY w) := fun w => (hP w.1).1 (hWP w.2)
  have hπWsurj : Function.Surjective πW := by
    intro s
    obtain ⟨w, hw, hws⟩ := hF1 s
    exact ⟨⟨w, hw⟩, hws⟩
  have hπWc : πW.ker ≤ Subgroup.center W' := by
    intro w hw
    rw [Subgroup.mem_center_iff]
    intro g
    apply Subtype.ext
    have hwK : w.1 ∈ K := by
      refine ⟨hw, ?_⟩
      show πY (pY w) = 1
      rw [← hπW w]
      exact MonoidHom.mem_ker.1 hw
    exact Subgroup.mem_center_iff.1 (hKc hwK) g.1
  have hodd : Odd (Nat.card πW.ker) := by
    let f1 : πW.ker →* πX.ker := (pX.comp πW.ker.subtype).codRestrict πX.ker (fun w => w.2)
    let f2 : πW.ker →* πY.ker := (pY.comp πW.ker.subtype).codRestrict πY.ker (fun w => by
      show πY (pY w.1) = 1
      rw [← hπW w.1]
      exact w.2)
    have hinj : Function.Injective (f1.prod f2) := by
      intro a b hab
      have h1 := congrArg (fun t => (t.1 : X)) hab
      have h2 := congrArg (fun t => (t.2 : Y)) hab
      apply Subtype.ext
      apply Subtype.ext
      exact Prod.ext h1 h2
    have hdvd := Subgroup.card_dvd_of_injective _ hinj
    rw [Nat.card_prod, hXn, hYn] at hdvd
    exact Odd.of_dvd_nat (by decide : Odd (3 * 3)) hdvd
  have hb := hbound W' πW hπWsurj hπWc hodd
  haveI : Finite S := Finite.of_surjective πX hX
  have hSpos : 0 < Nat.card S := Nat.card_pos
  have hcardW : Nat.card W' = Nat.card S * Nat.card πW.ker := by
    rw [πW.ker.card_eq_card_quotient_mul_card_subgroup,
      Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective πW hπWsurj).toEquiv]
  have hcardX : Nat.card X = Nat.card S * 3 := by
    rw [πX.ker.card_eq_card_quotient_mul_card_subgroup,
      Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective πX hX).toEquiv, hXn]
  have hcardY : Nat.card Y = Nat.card S * 3 := by
    rw [πY.ker.card_eq_card_quotient_mul_card_subgroup,
      Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective πY hY).toEquiv, hYn]
  have hpXsurj : Function.Surjective pX := by
    let N : Subgroup X := W'.map (MonoidHom.fst X Y)
    have hN : ∀ p ∈ (⊤ : Subgroup X), ∃ n ∈ N, ∃ z ∈ Subgroup.center X, p = n * z := by
      intro x _
      obtain ⟨w, hw, hwx⟩ := hF1 (πX x)
      refine ⟨w.1, ⟨w, hw, rfl⟩, w.1⁻¹ * x, hXc ?_, by simp⟩
      rw [MonoidHom.mem_ker, map_mul, map_inv, hwx, inv_mul_cancel]
    have h1 : ⁅(⊤ : Subgroup X), (⊤ : Subgroup X)⁆ ≤ ⁅N, N⁆ := burnsideA35_commutator_le hN
    have h2 : (⊤ : Subgroup X) ≤ N := by
      have : ⁅(⊤ : Subgroup X), (⊤ : Subgroup X)⁆ = ⊤ := by
        rw [← _root_.commutator_def]
        exact Group.IsPerfect.commutator_eq_top
      rw [← this]
      exact h1.trans (burnsideA35_commutator_le_self N)
    intro x
    obtain ⟨w, hw, rfl⟩ := h2 (Subgroup.mem_top x)
    exact ⟨⟨w, hw⟩, rfl⟩
  have hpYsurj : Function.Surjective pY := by
    let N : Subgroup Y := W'.map (MonoidHom.snd X Y)
    have hN : ∀ p ∈ (⊤ : Subgroup Y), ∃ n ∈ N, ∃ z ∈ Subgroup.center Y, p = n * z := by
      intro y _
      obtain ⟨w, hw, hwy⟩ := hF1 (πY y)
      have hwy' : πY w.2 = πY y := ((hP w).1 (hWP hw)).symm.trans hwy
      refine ⟨w.2, ⟨w, hw, rfl⟩, w.2⁻¹ * y, hYc ?_, by simp⟩
      rw [MonoidHom.mem_ker, map_mul, map_inv, hwy', inv_mul_cancel]
    have h1 : ⁅(⊤ : Subgroup Y), (⊤ : Subgroup Y)⁆ ≤ ⁅N, N⁆ := burnsideA35_commutator_le hN
    have h2 : (⊤ : Subgroup Y) ≤ N := by
      have : ⁅(⊤ : Subgroup Y), (⊤ : Subgroup Y)⁆ = ⊤ := by
        rw [← _root_.commutator_def]
        exact Group.IsPerfect.commutator_eq_top
      rw [← this]
      exact h1.trans (burnsideA35_commutator_le_self N)
    intro y
    obtain ⟨w, hw, rfl⟩ := h2 (Subgroup.mem_top y)
    exact ⟨⟨w, hw⟩, rfl⟩
  have h3 : Nat.card πW.ker = 3 := by
    have hle : Nat.card X ≤ Nat.card W' := Nat.card_le_card_of_surjective pX hpXsurj
    rw [hcardX, hcardW] at hle
    have := Nat.le_of_mul_le_mul_left hle hSpos
    omega
  have hbX : Function.Bijective pX :=
    hpXsurj.bijective_of_nat_card_le (by rw [hcardW, hcardX, h3])
  have hbY : Function.Bijective pY :=
    hpYsurj.bijective_of_nat_card_le (by rw [hcardW, hcardY, h3])
  exact ⟨(MulEquiv.ofBijective pX hbX).symm.trans (MulEquiv.ofBijective pY hbY)⟩

private theorem burnsideA35_hat_cover {X S : Type} [Group X] [Group S] (h :
    CFSG.Quasithin.IsHat X S) :
    ∃ π : X →* S, Function.Surjective π ∧ π.ker = Subgroup.center X := by
  obtain ⟨-, -, ⟨e⟩⟩ := h
  refine ⟨e.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center X)),
    e.surjective.comp (QuotientGroup.mk'_surjective _), ?_⟩
  ext x
  rw [MonoidHom.mem_ker]
  change e (QuotientGroup.mk' (Subgroup.center X) x) = 1 ↔ _
  rw [map_eq_one_iff _ e.injective, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]

private theorem burnsideA35_hat_finite {X S : Type} [Group X] [Group S] [Finite S]
    (h : CFSG.Quasithin.IsHat X S) : Finite X := by
  obtain ⟨-, hc, ⟨e⟩⟩ := h
  apply Nat.finite_of_card_ne_zero
  rw [(Subgroup.center X).card_eq_card_quotient_mul_card_subgroup, hc,
    Nat.card_congr e.toEquiv]
  have : 0 < Nat.card S := Nat.card_pos
  omega

private theorem burnsideA35_hat_unique {S X Y : Type} [Group S] [Finite S] [Group X] [Group Y]
    (hX : CFSG.Quasithin.IsHat X S) (hY : CFSG.Quasithin.IsHat Y S)
    (hbound : ∀ (W : Type) [Group W] [Finite W] [Group.IsPerfect W] (π : W →* S),
      Function.Surjective π → π.ker ≤ Subgroup.center W → Odd (Nat.card π.ker) →
      Nat.card π.ker = 1 ∨ Nat.card π.ker = 3) :
    Nonempty (X ≃* Y) := by
  haveI := burnsideA35_hat_finite hX
  haveI := burnsideA35_hat_finite hY
  obtain ⟨πX, hπX, hkX⟩ := burnsideA35_hat_cover hX
  obtain ⟨πY, hπY, hkY⟩ := burnsideA35_hat_cover hY
  haveI : Group.IsPerfect X := hX.1.1
  haveI : Group.IsPerfect Y := hY.1.1
  exact burnsideA35_cover_unique πX πY hπX hπY hkX.le hkY.le (by rw [hkX]; exact hX.2.1)
    (by rw [hkY]; exact hY.2.1) hbound

open scoped commutatorElement in
private theorem burnsideA35_isPerfect_of_simple {S : Type} [Group S] (hS : IsSimpleGroup S)
    (hnab : ∃ a b : S, a * b ≠ b * a) : Group.IsPerfect S := by
  rw [Group.isPerfect_def]
  rcases hS.eq_bot_or_eq_top_of_normal (commutator S) with h | h
  · exfalso
    obtain ⟨a, b, hab⟩ := hnab
    apply hab
    have h1 : ⁅a, b⁆ ∈ commutator S :=
      Subgroup.commutator_mem_commutator (Subgroup.mem_top a) (Subgroup.mem_top b)
    rw [h, Subgroup.mem_bot] at h1
    exact commutatorElement_eq_one_iff_mul_comm.1 h1
  · exact h

private theorem burnsideA35_center_eq_bot {S : Type} [Group S] (hS : IsSimpleGroup S)
    (hnab : ∃ a b : S, a * b ≠ b * a) : Subgroup.center S = ⊥ := by
  rcases hS.eq_bot_or_eq_top_of_normal (Subgroup.center S) with h | h
  · exact h
  · exfalso
    obtain ⟨a, b, hab⟩ := hnab
    have : a ∈ Subgroup.center S := h ▸ Subgroup.mem_top a
    exact hab (Subgroup.mem_center_iff.1 this b).symm

private theorem burnsideA35_isHat_of_cover {G S : Type} [Group G] [Group S] (hS : IsSimpleGroup S)
    (hnab : ∃ a b : S, a * b ≠ b * a) (π : G →* S) (hπ : Function.Surjective π)
    (hperf : Group.IsPerfect G) (hker : π.ker ≤ Subgroup.center G)
    (hcard : Nat.card π.ker = 3) : CFSG.Quasithin.IsHat G S := by
  have hcenter : Subgroup.center G = π.ker := by
    refine le_antisymm ?_ hker
    intro g hg
    rw [MonoidHom.mem_ker]
    have hc : π g ∈ Subgroup.center S := by
      rw [Subgroup.mem_center_iff]
      intro s
      obtain ⟨t, rfl⟩ := hπ s
      rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.1 hg t]
    rw [burnsideA35_center_eq_bot hS hnab] at hc
    exact Subgroup.mem_bot.1 hc
  let e : G ⧸ Subgroup.center G ≃* S :=
    (QuotientGroup.quotientMulEquivOfEq hcenter).trans
      (QuotientGroup.quotientKerEquivOfSurjective π hπ)
  haveI := hS
  refine ⟨⟨hperf, e.isSimpleGroup, ?_⟩, by rw [hcenter]; exact hcard, ⟨e⟩⟩
  obtain ⟨a, b, hab⟩ := hnab
  exact ⟨e.symm a, e.symm b, fun h => hab (by simpa using congrArg e h)⟩

open scoped commutatorElement in
private theorem burnsideA35_perfect_of_nonsplit {G S : Type} [Group G] [Group S] [Group.IsPerfect S]
    (π : G →* S) (hπ : Function.Surjective π) (hker : π.ker ≤ Subgroup.center G)
    (hcard : Nat.card π.ker = 3) {x y : G} (hc : π x * π y = π y * π x)
    (hn : x * y ≠ y * x) : Group.IsPerfect G := by
  have : Fact (Nat.card π.ker).Prime := ⟨by rw [hcard]; exact Nat.prime_three⟩
  let C : Subgroup G := commutator G
  have hdec : ∀ g : G, ∃ c ∈ C, ∃ z ∈ π.ker, g = c * z := by
    intro g
    have h1 : C.map π = ⊤ := by
      rw [show C = ⁅(⊤ : Subgroup G), (⊤ : Subgroup G)⁆ from _root_.commutator_def G,
        Subgroup.map_commutator, ← MonoidHom.range_eq_map,
        MonoidHom.range_eq_top_of_surjective π hπ, ← _root_.commutator_def,
        Group.IsPerfect.commutator_eq_top]
    have : π g ∈ C.map π := h1 ▸ Subgroup.mem_top _
    obtain ⟨c, hcC, hcg⟩ := this
    refine ⟨c, hcC, c⁻¹ * g, ?_, by simp⟩
    rw [MonoidHom.mem_ker, map_mul, map_inv, hcg, inv_mul_cancel]
  rcases (C.subgroupOf π.ker).eq_bot_or_eq_top_of_prime_card with h | h
  ·
    exfalso
    have hdis : Disjoint C π.ker := Subgroup.subgroupOf_eq_bot.1 h
    obtain ⟨c, hcC, z, hz, rfl⟩ := hdec x
    obtain ⟨d, hdC, z', hz', rfl⟩ := hdec y
    have e : ⁅c * z, d * z'⁆ = ⁅c, d⁆ := by
      rw [burnsideA35_comm_mul_central_left (hker hz), ← commutatorElement_inv,
        burnsideA35_comm_mul_central_left (hker hz'), commutatorElement_inv]
    apply hn
    rw [← commutatorElement_eq_one_iff_mul_comm, e]
    have h1 : ⁅c, d⁆ ∈ C := by
      rw [commutatorElement_def]
      exact C.mul_mem (C.mul_mem (C.mul_mem hcC hdC) (C.inv_mem hcC)) (C.inv_mem hdC)
    have h2 : ⁅c, d⁆ ∈ π.ker := by
      rw [MonoidHom.mem_ker, map_commutatorElement]
      have hz1 : π z = 1 := hz
      have hz1' : π z' = 1 := hz'
      rw [map_mul, map_mul, hz1, hz1', mul_one, mul_one] at hc
      rw [commutatorElement_eq_one_iff_mul_comm]
      exact hc
    exact (Subgroup.disjoint_def.1 hdis) h1 h2
  ·
    have hle : π.ker ≤ C := Subgroup.subgroupOf_eq_top.1 h
    rw [Group.isPerfect_def, eq_top_iff]
    intro g _
    obtain ⟨c, hcC, z, hz, rfl⟩ := hdec g
    exact C.mul_mem hcC (hle hz)

private theorem burnsideA35_hat_congr_right {X S S' : Type} [Group X] [Group S] [Group S']
    (e : S ≃* S') (h : CFSG.Quasithin.IsHat X S) : CFSG.Quasithin.IsHat X S' :=
  ⟨h.1, h.2.1, h.2.2.map fun f => f.trans e⟩

open CFSG.Quasithin.HatM22 in
private theorem burnsideA35_card_ker_hatM22Act : Nat.card hatM22Act.ker = 3 := by
  have hset : ((hatM22Act.ker : Subgroup ↥hatM22Γ₀) : Set ↥hatM22Γ₀) =
      {1, hatM22Z, hatM22Z ^ 2} := by
    ext g
    simp only [SetLike.mem_coe, mem_ker_hatM22Act_iff, Set.mem_insert_iff,
      Set.mem_singleton_iff]
  show Nat.card ↑((hatM22Act.ker : Subgroup ↥hatM22Γ₀) : Set ↥hatM22Γ₀) = 3
  rw [hset, Nat.card_coe_set_eq, Set.ncard_eq_three]
  exact ⟨1, hatM22Z, hatM22Z ^ 2, hatM22Z_ne_one.symm, hatM22Z_sq_ne_one.symm, hatM22Z_ne_sq,
    rfl⟩

open CFSG.Quasithin.HatM22 in
private theorem burnsideA35_ker_hatM22Act_le_center :
    hatM22Act.ker ≤ Subgroup.center ↥hatM22Γ₀ := by
  intro g hg
  rcases (mem_ker_hatM22Act_iff g).1 hg with rfl | rfl | rfl
  · exact one_mem _
  · exact hatM22Z_mem_center
  · exact Subgroup.pow_mem _ hatM22Z_mem_center 2

open CFSG.Quasithin.HatM22 in
private theorem burnsideA35_isHat_preimage {S : Type} [Group S] (hS : IsSimpleGroup S)
    (hnab : ∃ a b : S, a * b ≠ b * a) {K : Subgroup (Equiv.Perm (Fin 22))}
    (hK : K ≤ CFSG.Blueprint.NativeSporadic.M22) (e : S ≃* K) {x y : ↥hatM22Γ₀}
    (hx : hatM22Act x ∈ K) (hy : hatM22Act y ∈ K)
    (hc : hatM22Act x * hatM22Act y = hatM22Act y * hatM22Act x) (hn : x * y ≠ y * x) :
    CFSG.Quasithin.IsHat ↥(K.comap hatM22Act) S := by
  haveI := hS
  haveI hKs : IsSimpleGroup K := e.symm.isSimpleGroup
  have hKnab : ∃ a b : K, a * b ≠ b * a := by
    obtain ⟨a, b, hab⟩ := hnab
    exact ⟨e a, e b, fun h => hab (by simpa using congrArg e.symm h)⟩
  haveI hKperf : Group.IsPerfect K := burnsideA35_isPerfect_of_simple hKs hKnab
  let X : Subgroup ↥hatM22Γ₀ := K.comap hatM22Act
  let πK : ↥X →* K := (hatM22Act.comp X.subtype).codRestrict K (fun g => g.2)
  have hsurj : Function.Surjective πK := by
    intro k
    have hk : (k : Equiv.Perm (Fin 22)) ∈ hatM22Act.range := by
      rw [range_hatM22Act]
      exact hK k.2
    obtain ⟨g, hg⟩ := hk
    exact ⟨⟨g, by rw [Subgroup.mem_comap, hg]; exact k.2⟩, Subtype.ext hg⟩
  have hkerle : πK.ker ≤ Subgroup.center ↥X := by
    intro g hg
    rw [Subgroup.mem_center_iff]
    intro h
    apply Subtype.ext
    have hg' : (g : ↥hatM22Γ₀) ∈ hatM22Act.ker := by
      rw [MonoidHom.mem_ker]
      have := MonoidHom.mem_ker.1 hg
      exact congrArg Subtype.val this
    exact Subgroup.mem_center_iff.1 (burnsideA35_ker_hatM22Act_le_center hg') h.1
  have hkerEq : πK.ker = hatM22Act.ker.subgroupOf X := by
    ext g
    simp only [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
    exact ⟨fun h => congrArg Subtype.val h, fun h => Subtype.ext h⟩
  have hkercard : Nat.card πK.ker = 3 := by
    have hle : hatM22Act.ker ≤ X := fun g hg => by
      rw [MonoidHom.mem_ker] at hg
      show hatM22Act g ∈ K
      rw [hg]
      exact K.one_mem
    rw [hkerEq, Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv]
    exact burnsideA35_card_ker_hatM22Act
  have hperf : Group.IsPerfect ↥X := by
    refine burnsideA35_perfect_of_nonsplit πK hsurj hkerle hkercard
      (x := ⟨x, hx⟩) (y := ⟨y, hy⟩) ?_ ?_
    · apply Subtype.ext
      exact hc
    · intro h
      exact hn (congrArg Subtype.val h)
  exact burnsideA35_hat_congr_right e.symm
    (burnsideA35_isHat_of_cover hKs hKnab πK hsurj hperf hkerle hkercard)

private theorem burnsideA35_bound_of_equiv {S S' : Type} [Group S] [Group S'] (e : S ≃* S')
    (h : ∀ (W : Type) [Group W] [Finite W] [Group.IsPerfect W] (π : W →* S'),
      Function.Surjective π → π.ker ≤ Subgroup.center W → Odd (Nat.card π.ker) →
      Nat.card π.ker = 1 ∨ Nat.card π.ker = 3) :
    ∀ (W : Type) [Group W] [Finite W] [Group.IsPerfect W] (π : W →* S),
      Function.Surjective π → π.ker ≤ Subgroup.center W → Odd (Nat.card π.ker) →
      Nat.card π.ker = 1 ∨ Nat.card π.ker = 3 := by
  intro W _ _ _ π hπ hc hodd
  have hk : ((e : S →* S').comp π).ker = π.ker := MonoidHom.ker_mulEquiv_comp π e
  have := h W ((e : S →* S').comp π) (e.surjective.comp hπ) (hk ▸ hc) (hk ▸ hodd)
  rwa [hk] at this

private theorem burnsideA35_bound_alt {n : ℕ} (hn : n = 6 ∨ n = 7) :
    ∀ (W : Type) [Group W] [Finite W] [Group.IsPerfect W]
      (π : W →* ↥(alternatingGroup (Fin n))),
      Function.Surjective π → π.ker ≤ Subgroup.center W → Odd (Nat.card π.ker) →
      Nat.card π.ker = 1 ∨ Nat.card π.ker = 3 := by
  intro W _ _ _ π hπ hc hodd
  exact (CFSG.SectionRank.alternating_small_odd_cover_bound (by omega) (by omega) π hπ hc
    hodd).2 hn

private theorem burnsideA35_not_sq_dvd {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) (hq3 : q ≠ 3) :
    ¬ q ^ 2 ∣ 443520 := by
  intro h
  have hle : q ^ 2 ≤ 443520 := Nat.le_of_dvd (by norm_num) h
  have hlt : q < 666 := by nlinarith
  have key : ∀ r < 666, r.Prime → r ^ 2 ∣ 443520 → r ≤ 3 := by decide +kernel
  have h1 := key q hlt hq h
  have h2 := hq.two_le
  omega

open CFSG.Blueprint in
private theorem burnsideA35_M22_sylow3 :
    ∀ Q : Sylow 3 ↥NativeSporadic.M22,
      CFSG.Open.IsElemAbelian 3 (Q : Subgroup ↥NativeSporadic.M22) ∧
        Nat.card (Q : Subgroup ↥NativeSporadic.M22) = 9 := by
  intro Q
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hcard : Nat.card ↥NativeSporadic.M22 = 9 * 49280 := by
    rw [CFSG.Sporadic.Mathieu.card_M22]
  have hm3 : ¬ 3 ∣ 49280 := by norm_num
  obtain ⟨P₀, hP₀, hP₀el, -⟩ := CFSG.Quasithin.A318P.exists_irr_perm NativeSporadic.M22
    (a := CFSG.RankThree.Asc83Table.M22.x) (b := CFSG.RankThree.Asc83Table.M22.y)
    (n := CFSG.RankThree.Asc83Table.M22.gI) CFSG.RankThree.Asc83Table.M22.x_mem
    CFSG.RankThree.Asc83Table.M22.y_mem CFSG.RankThree.Asc83Table.M22.gI_mem
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel)
  have hQ : Nat.card (Q : Subgroup ↥NativeSporadic.M22) = 9 := by
    rw [Sylow.card_eq_multiplicity, hcard, Nat.factorization_mul (by norm_num) (by norm_num),
      Finsupp.add_apply, Nat.factorization_eq_zero_of_not_dvd hm3, add_zero,
      show (9 : ℕ) = 3 ^ 2 by norm_num, Nat.Prime.factorization_pow Nat.prime_three]
    simp
  obtain ⟨g, hg⟩ := CFSG.Quasithin.A318P.exists_conj_of_card_nine hcard hm3 hP₀ hQ
  refine ⟨?_, hQ⟩
  rw [hg]
  exact CFSG.SectionRank.isElemAbelian_map hP₀el _

open CFSG.Blueprint in
private theorem burnsideA35_bound_M22 :
    ∀ (W : Type) [Group W] [Finite W] [Group.IsPerfect W] (π : W →* ↥NativeSporadic.M22),
      Function.Surjective π → π.ker ≤ Subgroup.center W → Odd (Nat.card π.ker) →
      Nat.card π.ker = 1 ∨ Nat.card π.ker = 3 := by
  intro W _ _ _ π hπ hc hodd
  haveI : Finite ↥NativeSporadic.M22 := inferInstance
  have hcard : Nat.card ↥NativeSporadic.M22 = 443520 := CFSG.Sporadic.Mathieu.card_M22
  refine CFSG.QuasithinUnique.Ch1.card_ker_eq_one_or_three ?_ (burnsideA35_M22_sylow3) π hπ hc
    hodd
  intro q hq hq2 hq3 Q
  haveI : Fact q.Prime := ⟨hq⟩
  exact CFSG.SectionRank.sylow_isCyclic_of_not_sq_dvd (by
    rw [hcard]; exact burnsideA35_not_sq_dvd hq hq2 hq3) Q

