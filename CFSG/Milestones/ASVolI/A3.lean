private theorem burnsideA35_lines_inj : ∀ q q' : Fin 22, ¬ burnsideA35_isH q →
    (∀ l ∈ burnsideA35_linesTab q, l.toFinset ∈ burnsideA35_lines q') → q = q' := by
  decide +kernel

private theorem burnsideA35_lines_eq_empty {x : Fin 22} (h : burnsideA35_isH x) :
    burnsideA35_lines x = ∅ := by
  simp [burnsideA35_lines, show burnsideA35_linesTab x = [] from h]

private theorem burnsideA35_exists_mem_lines {x : Fin 22} (h : ¬ burnsideA35_isH x) :
    ∃ L, L ∈ burnsideA35_lines x := by
  unfold burnsideA35_isH at h
  cases hx : burnsideA35_linesTab x with
  | nil => exact absurd hx h
  | cons l t => exact ⟨l.toFinset, by simp [burnsideA35_lines, hx]⟩

theorem burnsideA35_inv_apply {α : Type*} (g : Equiv.Perm α) (x : α) : g⁻¹ (g x) = x :=
  g.symm_apply_apply x

theorem burnsideA35_apply_inv {α : Type*} (g : Equiv.Perm α) (x : α) : g (g⁻¹ x) = x :=
  g.apply_symm_apply x

theorem burnsideA35_T_isH {g : Equiv.Perm (Fin 22)} (hg : g ∈ burnsideA35_T) (i : Fin 7) :
    burnsideA35_isH (g (burnsideA35_pt i)) := by
  by_contra hne
  obtain ⟨L, hL⟩ := burnsideA35_exists_mem_lines hne
  have h := hg.2 (g (burnsideA35_pt i)) L hL
  rw [burnsideA35_inv_apply, burnsideA35_lines_eq_empty (burnsideA35_isH_pt i)] at h
  exact Finset.notMem_empty _ h

@[expose] def burnsideA35_psiPerm (g : Equiv.Perm (Fin 22)) (hg : g ∈ burnsideA35_T) :
    Equiv.Perm (Fin 7) where
  toFun i := burnsideA35_pos (g (burnsideA35_pt i))
  invFun i := burnsideA35_pos (g⁻¹ (burnsideA35_pt i))
  left_inv i := by
    show burnsideA35_pos (g⁻¹ (burnsideA35_pt (burnsideA35_pos (g (burnsideA35_pt i))))) = i
    rw [burnsideA35_pt_pos _ (burnsideA35_T_isH hg i), burnsideA35_inv_apply, burnsideA35_pos_pt]
  right_inv i := by
    show burnsideA35_pos (g (burnsideA35_pt (burnsideA35_pos (g⁻¹ (burnsideA35_pt i))))) = i
    have h1 := burnsideA35_T_isH (burnsideA35_T.inv_mem hg) i
    rw [burnsideA35_pt_pos _ h1, burnsideA35_apply_inv, burnsideA35_pos_pt]

@[expose] def burnsideA35_psi : burnsideA35_T →* Equiv.Perm (Fin 7) where
  toFun g := burnsideA35_psiPerm g.1 g.2
  map_one' := by
    refine Equiv.ext fun i => ?_
    exact burnsideA35_pos_pt i
  map_mul' g h := by
    refine Equiv.ext fun i => ?_
    show burnsideA35_pos ((g.1 * h.1) (burnsideA35_pt i)) =
      burnsideA35_pos (g.1 (burnsideA35_pt (burnsideA35_pos (h.1 (burnsideA35_pt i)))))
    rw [burnsideA35_pt_pos _ (burnsideA35_T_isH h.2 i)]
    rfl

private theorem burnsideA35_psi_apply (g : burnsideA35_T) (i : Fin 7) :
    burnsideA35_psi g i = burnsideA35_pos (g.1 (burnsideA35_pt i)) := rfl

private theorem burnsideA35_psi_injective : Function.Injective burnsideA35_psi := by
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro g hg
  rw [MonoidHom.mem_ker] at hg
  rw [Subgroup.mem_bot]
  have hfixpt : ∀ i : Fin 7, g.1 (burnsideA35_pt i) = burnsideA35_pt i := by
    intro i
    have h1 : burnsideA35_pos (g.1 (burnsideA35_pt i)) = i := by
      have := congrArg (fun σ : Equiv.Perm (Fin 7) => σ i) hg
      exact this
    have h2 := burnsideA35_pt_pos _ (burnsideA35_T_isH g.2 i)
    rw [h1] at h2
    exact h2.symm
  have hfix : ∀ x : Fin 22, burnsideA35_isH x → g.1 x = x := by
    intro x hx
    have h1 := burnsideA35_pt_pos x hx
    rw [← h1]
    exact hfixpt _
  apply Subtype.ext
  refine Equiv.ext fun x => ?_
  by_cases hx : burnsideA35_isH x
  · exact hfix x hx
  · refine (burnsideA35_lines_inj x (g.1 x) hx fun l hl => ?_).symm
    have hFwd := g.2.1 x l.toFinset (by
      simp only [burnsideA35_lines, Finset.mem_val, List.mem_toFinset, List.mem_map]
      exact ⟨l, hl, rfl⟩)
    have himg : l.toFinset.image g.1 = l.toFinset := by
      ext y
      simp only [Finset.mem_image, List.mem_toFinset]
      constructor
      · rintro ⟨z, hz, rfl⟩
        rw [hfix z (burnsideA35_lines_sub x l hl z hz)]
        exact hz
      · intro hy
        exact ⟨y, hy, hfix y (burnsideA35_lines_sub x l hl y hy)⟩
    rw [himg] at hFwd
    exact hFwd

