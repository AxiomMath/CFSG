@[expose] def burnsideC121_valHom {Ω : Type} [Group Ω] {M : Subgroup Ω} (hM : IsElemAbelian 2 M) :
    IntMod M hM →* Ω where
  toFun := IntMod.val
  map_one' := rfl
  map_mul' := IntMod.val_mul

theorem burnsideC121_commV_autI_eq_top {Ω : Type} [Group Ω] {M Y : Subgroup Ω}
    (hM : IsElemAbelian 2 M) (hYN : Y ≤ Subgroup.normalizer (M : Set Ω)) (hMY : ⁅M, Y⁆ = M) :
    commV (autI hM Y) = ⊤ := by
  rw [eq_top_iff]
  intro v _
  set K : Subgroup Ω := (commV (autI hM Y)).map (burnsideC121_valHom hM) with hK
  have hle : ⁅M, Y⁆ ≤ K := by
    rw [Subgroup.commutator_le]
    intro m hm y hy
    have hx : convI hM ⟨y, hYN hy⟩ ∈ autI hM Y := convI_mem_autI hM hy (hYN hy)
    refine ⟨(convI hM ⟨y, hYN hy⟩ (IntMod.mk hM ⟨m, hm⟩) * (IntMod.mk hM ⟨m, hm⟩)⁻¹)⁻¹,
      (commV (autI hM Y)).inv_mem (G6.mem_commV_of_mem hx _), ?_⟩
    show IntMod.val ((convI hM ⟨y, hYN hy⟩ (IntMod.mk hM ⟨m, hm⟩) *
      (IntMod.mk hM ⟨m, hm⟩)⁻¹)⁻¹) = ⁅m, y⁆
    rw [IntMod.val_inv, IntMod.val_mul, IntMod.val_inv, convI_apply_val, commutatorElement_def]
    show (y * m * y⁻¹ * m⁻¹)⁻¹ = m * y * m⁻¹ * y⁻¹
    group
  have hv : v.val ∈ K := hle (hMY.symm ▸ v.val_mem)
  obtain ⟨w, hw, hwv⟩ := hv
  have : w = v := IntMod.val_injective hwv
  rwa [← this]

theorem burnsideC121_fixV_autI_invariant {Ω : Type} [Group Ω] {M Y H : Subgroup Ω}
    (hM : IsElemAbelian 2 M) (hHY : H ≤ Subgroup.normalizer (Y : Set Ω)) :
    ∀ g ∈ autI hM H, ∀ w ∈ fixV (autI hM Y), g w ∈ fixV (autI hM Y) := by
  intro g hg w hw x hx
  obtain ⟨h, hhH, rfl⟩ := (mem_autI hM).1 hg
  obtain ⟨y, hyY, rfl⟩ := (mem_autI hM).1 hx
  have hy' : (h : Ω)⁻¹ * y * h ∈ Y := by
    have := (Subgroup.mem_normalizer_iff.1 (hHY (Subgroup.inv_mem _ hhH)) y).1 hyY
    simpa using this
  have key : convI hM y * convI hM h = convI hM h * convI hM (h⁻¹ * y * h) := by
    rw [← map_mul, ← map_mul]
    congr 1
    group
  have h1 : (convI hM y) ((convI hM h) w) = (convI hM h) ((convI hM (h⁻¹ * y * h)) w) := by
    rw [← MulAut.mul_apply, key, MulAut.mul_apply]
  have hmem : convI hM (h⁻¹ * y * h) ∈ autI hM Y :=
    (mem_autI hM).2 ⟨h⁻¹ * y * h, by simpa [mul_assoc] using hy', rfl⟩
  rw [h1, hw _ hmem]

namespace burnsideC121_YCtx

variable {Ω : Type} [Group Ω] [Finite Ω] {X R T Y W : Subgroup Ω}
  (c : burnsideC121_YCtx X R T Y W) {n : ℕ} {F : Type} [Field F] [Fintype F]
  (D : burnsideC121_NatD Y W n F)

include c D

theorem isQuasisimple_quot (hn : 2 ≤ n) : CFSG.IsQuasisimple (↥Y ⧸ CFSG.pCore 2 ↥Y) := by
  have h4 : 4 ≤ Nat.card F := by
    rw [Nat.card_eq_fintype_card, D.card]
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
  have hpc : CFSG.pCore 2 ↥Y = D.α.ker := by
    rw [D.αk]
    ext x
    rw [Subgroup.mem_subgroupOf, CFSG.mem_openPCoreOf_iff]
  let e : (↥Y ⧸ CFSG.pCore 2 ↥Y) ≃* SL(2, F) :=
    (QuotientGroup.quotientMulEquivOfEq hpc).trans
      (QuotientGroup.quotientKerEquivOfSurjective D.α (c.alpha_surjective D hn))
  exact CFSG.LocalCores.isQuasisimple_of_mulEquiv e.symm
    (CFSG.Quasithin.C126.Nat.isQuasisimple_sl2 h4)

theorem commutator_commW_ne_bot : ⁅⁅W, Y⁆, Y⁆ ≠ ⊥ := by
  rw [c.commutator_commutator_W]
  intro h
  apply c.not_le_centralizer_W D
  exact Subgroup.le_centralizer_iff.1 (Subgroup.commutator_eq_bot_iff_le_centralizer.1 h)

theorem exists_fixed_commW (h123 : I_2_3) (hn : 2 ≤ n) :
    ∃ u ∈ ⁅W, Y⁆, u ∈ Subgroup.centralizer (burnsideC121_P X R T Y : Set Ω) ∧
      u ∉ Subgroup.centralizer (Y : Set Ω) := by
  classical
  set M : Subgroup Ω := ⁅W, Y⁆ with hMdef
  have hM : IsElemAbelian 2 M := c.commW_elem
  have hHN : burnsideC121_H X T Y ≤ Subgroup.normalizer (M : Set Ω) := c.H_le_normalizer_commW
  have hred : IsTwoReducedIn (burnsideC121_H X T Y) M := c.isTwoReducedIn_commW D
  have hYN : Y ≤ Subgroup.normalizer (M : Set Ω) := c.Y_le_H.trans hHN
  have hPN : burnsideC121_P X R T Y ≤ Subgroup.normalizer (M : Set Ω) := c.P_le_H.trans hHN
  have hCY : Y ⊓ Subgroup.centralizer (M : Set Ω) = pCoreOf 2 Y := c.inf_centralizer_commW D
  have hαs := c.alpha_surjective D hn
  have hMY : ⁅M, Y⁆ = M := c.commutator_commutator_W
  obtain ⟨-, -, hFstar, -⟩ := C124.B2_10_2 hM hred c.pCore_H_le_P le_rfl c.P_sylow c.Y_le_H
    c.H_le_normalizer c.H_prod (c.commutator_commW_ne_bot D) (Or.inl (c.isQuasisimple_quot D hn))
  obtain ⟨e, he⟩ := burnsideC121_exists_autIEquiv hM hYN D.α hαs (by rw [hCY, D.αk])
  let ε := CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 2 F
  let marking : ↥(StatedSL 2 F) →* ↥(autI hM Y) := e.symm.toMonoidHom.comp ε.symm.toMonoidHom
  let ιM : IntMod M hM →* ↥W :=
    { toFun := fun v => ⟨v.val, c.commW_le_W v.val_mem⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
  let φ : IntMod M hM →* ↥(FFModel.nat (StatedSL 2 F)).sec :=
    { toFun := fun v => ⟨D.β (ιM v), Subgroup.mem_top _⟩
      map_one' := by apply Subtype.ext; exact map_one D.β
      map_mul' := fun a b => by apply Subtype.ext; exact map_mul D.β (ιM a) (ιM b) }
  let β : IntMod M hM →* ↥(FFModel.nat (StatedSL 2 F)).sec ⧸
      (FFModel.nat (StatedSL 2 F)).ker.subgroupOf (FFModel.nat (StatedSL 2 F)).sec :=
    (QuotientGroup.mk' _).comp φ
  have hβ : ∀ v, β v = QuotientGroup.mk (φ v) := fun v => rfl
  have hmk : ∀ a b : ↥(FFModel.nat (StatedSL 2 F)).sec,
      (QuotientGroup.mk a : ↥(FFModel.nat (StatedSL 2 F)).sec ⧸
        (FFModel.nat (StatedSL 2 F)).ker.subgroupOf (FFModel.nat (StatedSL 2 F)).sec) =
        QuotientGroup.mk b ↔ a = b := by
    intro a b
    rw [QuotientGroup.eq, Subgroup.mem_subgroupOf]
    show ((a⁻¹ * b : ↥(FFModel.nat (StatedSL 2 F)).sec) : (FFModel.nat (StatedSL 2 F)).Amb) ∈
      (⊥ : Subgroup (FFModel.nat (StatedSL 2 F)).Amb) ↔ a = b
    rw [Subgroup.mem_bot, Subgroup.coe_mul, Subgroup.coe_inv, inv_mul_eq_one]
    exact Subtype.ext_iff.symm
  have hsec : I23SectionMap (FFModel.nat (StatedSL 2 F)) (autI hM Y) (fixV (autI hM Y))
      marking β := by
    refine ⟨?_, ?_, ?_, bot_le, fun _ _ _ => Subgroup.mem_top _, ?_, ?_⟩
    · exact e.symm.surjective.comp ε.symm.surjective
    · intro q
      obtain ⟨⟨x, -⟩, rfl⟩ := QuotientGroup.mk_surjective q
      obtain ⟨u, hu, hβu⟩ := D.exists_commutator_beta c.Y_le_normalizer_W hn
        (Multiplicative.toAdd x)
      refine ⟨IntMod.mk hM ⟨u, hu⟩, ?_⟩
      rw [hβ, hmk]
      apply Subtype.ext
      show D.β (ιM (IntMod.mk hM ⟨u, hu⟩)) = x
      have : ιM (IntMod.mk hM ⟨u, hu⟩) = u := rfl
      rw [this]
      exact Multiplicative.toAdd.injective hβu
    · ext v
      rw [MonoidHom.mem_ker, mem_fixV_autI hM hYN, ← QuotientGroup.mk_one, hβ, hmk]
      have h1 : φ v = 1 ↔ D.β (ιM v) = 1 :=
        ⟨fun h => congrArg Subtype.val h, fun h => Subtype.ext h⟩
      rw [h1, ← MonoidHom.mem_ker, D.βk, Subgroup.mem_subgroupOf, Subgroup.mem_inf]
      exact ⟨fun h => h.2, fun h => ⟨c.commW_le_W v.val_mem, h⟩⟩
    · intro γ vec hvec
      have h1 : vec = 1 := Subgroup.mem_bot.1 hvec
      subst h1
      show natAct (StatedSL 2 F) γ 1 ∈ (⊥ : Subgroup (Multiplicative (Fin 2 → F)))
      rw [Subgroup.mem_bot]
      show Multiplicative.ofAdd _ = 1
      simp [Matrix.mulVec_zero]
    · intro γ vec native hNative hvn
      rw [hβ, hmk] at hvn
      obtain ⟨y, hy⟩ := hαs (ε.symm γ)
      have hmark : ((e.symm (ε.symm γ) : ↥(autI hM Y)) : MulAut (IntMod M hM)) =
          convHom hM Y hYN y := by
        rw [← hy]
        exact congrArg Subtype.val ((MulEquiv.symm_apply_eq e).2 (he y).symm)
      rw [hβ, hmk]
      apply Subtype.ext
      show D.β (ιM (((e.symm (ε.symm γ) : ↥(autI hM Y)) : MulAut (IntMod M hM)) vec)) =
        natAct (StatedSL 2 F) γ (native : (FFModel.nat (StatedSL 2 F)).Amb)
      rw [hmark]
      have hval : ((ιM (convHom hM Y hYN y vec) : ↥W) : Ω) =
          (y : Ω) * (ιM vec : Ω) * (y : Ω)⁻¹ := by
        show IntMod.val ((convHom hM Y hYN y) vec) = _
        rw [convHom_apply, convI_apply_val]
        rfl
      apply Multiplicative.toAdd.injective
      rw [D.βe y (ιM vec) _ hval]
      have hn' : D.β (ιM vec) = (native : (FFModel.nat (StatedSL 2 F)).Amb) :=
        congrArg Subtype.val hvn
      rw [hn']
      show _ = Multiplicative.toAdd (Multiplicative.ofAdd
        (((Subtype.val (show ↥(StatedSL 2 F) from γ) : GL (Fin 2) F) :
          Matrix (Fin 2) (Fin 2) F).mulVec
          (Multiplicative.toAdd (native : (FFModel.nat (StatedSL 2 F)).Amb))))
      rw [toAdd_ofAdd, hy]
      congr 1
      exact (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL_coe 2 F (ε.symm γ)).symm.trans
        (congrArg (fun g : ↥(StatedSL 2 F) => ((g : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F))
          (ε.apply_symm_apply γ))
  have hsup : autI hM (burnsideC121_H X T Y) = autI hM Y ⊔ autI hM (burnsideC121_P X R T Y) := by
    rw [c.H_eq]
    exact autI_sup hM hYN hPN
  have hFn : Nat.card F = 2 ^ n := by rw [Nat.card_eq_fintype_card, D.card]
  have h2 := h123 (IntMod M hM) (fun v => IntMod.sq_eq_one v) (autI hM (burnsideC121_H X T Y))
    (autI hM Y) (autI hM (burnsideC121_P X R T Y)) (fixV (autI hM Y)) 1 n hFstar.symm hsup
    (B2F.isSylowTwoOf_autI hM hHN c.P_sylow)
    (burnsideC121_fixV_autI_invariant hM c.H_le_normalizer) le_rfl
    (burnsideC121_commV_autI_eq_top hM hYN hMY) (Or.inl ⟨rfl, by omega⟩) F hFn marking β hsec
  obtain ⟨V1, -, -, -, -, -, S', -, -, -, ⟨hfix, -⟩, -⟩ := h2
  obtain ⟨v, ⟨hvT, -⟩, hvL⟩ := Set.not_subset.1 hfix
  refine ⟨v.val, v.val_mem, (mem_fixV_autI hM hPN v).1 hvT, fun h => hvL ?_⟩
  exact (mem_fixV_autI hM hYN v).2 h

