theorem burnsideI31_main {H : Type} [Group H] [Finite H]
    (h36 : CFSG.QuasithinUnique.Vol2Native.A36CoreForSQTKCat)
    (h38 : CFSG.QuasithinUnique.Vol2Native.A38ForSQTKCat)
    (hSch : CFSG.ComponentClassification.CatalogueRelativeB.CatalogueSchreier)
    (hElt : burnsideI31_EltTwo) (hKG : CFSG.Open.lBalanceIsKGroup H)
    (P : Subgroup H) (hP : IsPGroup 2 P) (L : Subgroup H)
    (hL : CFSG.ASVolI.ChIJK.IsTwoComponentIn L (Subgroup.centralizer (P : Set H))) :
    ∃ K : Subgroup H,
      (CFSG.ASVolI.ChIJK.IsTwoComponentIn K ⊤ ∧
        CFSG.ASVolI.ChIJK.conjClosure L (CFSG.ASVolI.ChIJK.oddCoreE H) =
          CFSG.ASVolI.ChIJK.conjClosure K P) ∧
      (L ≤ Subgroup.centralizer (CFSG.oddCore H : Set H) →
        CFSG.ASVolI.ChIJK.IsComponentIn L (Subgroup.centralizer (P : Set H)) ∧
          CFSG.ASVolI.ChIJK.IsComponentIn K ⊤) ∧
      (CFSG.SectionRank.IsSQTKCat H → CFSG.pRank 3 ↥L = 2 →
        L ≤ K ∧ K.Normal ∧ CFSG.IsQuasisimple ↥L ∧ CFSG.IsQuasisimple ↥K) := by
  obtain ⟨hLC, hL2⟩ := burnsideI31_twoComponent_of hL
  have hQ : L ≤ Subgroup.centralizer (CFSG.oddCore H : Set H) → CFSG.IsQuasisimple ↥L :=
    fun hLO => burnsideI31_quasisimple hSch hElt hKG hP hLC hL2 hLO
  obtain ⟨J, hJ, hJeq⟩ := CFSG.Quasithin.VolI.I31.abstract_I31 hP rfl hLC hL2
  refine ⟨J, ⟨burnsideI31_isTwoComponentIn_top hJ, ?_⟩, ?_, ?_⟩
  · rw [burnsideI31_conjClosure_eq, hJeq]
    rfl
