theorem burnsideI31_catalogueBp_He
    (hHeFix : ∀ {S : Type} [Group S], Nonempty (S ≃* CFSG.Blueprint.NativeSporadic.He) →
      ∀ α : MulAut S, orderOf α = 2 →
        ∀ L : Subgroup (CFSG.ComponentClassification.FixedCommutingProduct.fixedSubgroup α),
          CFSG.IsPComponent 2 L → CFSG.IsQuasisimple ↥L)
    (hcar : Nonempty (CFSG.Blueprint.NativeSporadic.Carrier .He ≃*
      (TauCeti.CFSGIndex.sporadic .He).Group)) :
    CatalogueBp 2 (TauCeti.CFSGIndex.sporadic .He) := by
  intro S _ _ hS hnc ⟨e⟩
  obtain ⟨e'⟩ := hcar
  have hS' : Nonempty (S ≃* CFSG.Blueprint.NativeSporadic.He) := ⟨e.trans e'.symm⟩
  refine CFSG.HardMathSupport.Dickson.OddLieB2.simpleBp_two_of_fixedTwoComponentsQuasisimple hnc ?_
  intro α hαα hα1 L hL
  have hord : orderOf α = 2 := orderOf_eq_prime (by rw [sq]; exact hαα) hα1
  exact hHeFix hS' α hord L hL

open CFSG.Yardstones.Md42047359a2a in
theorem burnsideI31_hElt
    (hSch : CFSG.ComponentClassification.CatalogueRelativeB.CatalogueSchreier)
    (h01 : AlternatingTwoBp) (h10 : LieClassicalOddCharTwoBp) (h11 : LieExceptionalOddCharTwoBp)
    (h12 : LieEvenCharTwoBp)
    (hSpor : ∀ name : TauCeti.SporadicName, name ≠ .He →
      CatalogueBp 2 (TauCeti.CFSGIndex.sporadic name))
    (hHe : CatalogueBp 2 (TauCeti.CFSGIndex.sporadic .He)) (h13 : ElementCaseBp) :
    burnsideI31_EltTwo := by
  intro Z _ _ hZ hZcore x hx hxc
  have hSZ := CFSG.ComponentClassification.LBalance.schreierSections_of_kGroup hSch hZ
  refine h13 Z 2 Nat.prime_two hZcore (fun K hK => ⟨hSZ.outer_component K hK, ?_⟩) x hx hxc
    (fun K hK => core_normalizes_components Nat.prime_two hZcore hx hK)
  have : IsSimpleGroup (K ⧸ Subgroup.center K) := hK.1.2.1
  exact burnsideI31_simpleBp_two hK.1.2.2 (inCatalog_center_quotient hZ K hK) h01 h10 h11 h12
    hSpor hHe

