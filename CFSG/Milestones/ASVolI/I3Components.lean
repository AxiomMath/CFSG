theorem burnsideI31_simpleBp_two {S : Type} [Group S] [Finite S] [IsSimpleGroup S]
    (hnc : ∃ a b : S, a * b ≠ b * a) (hcat : CFSG.Assembly.InCatalog S)
    (h01 : AlternatingTwoBp) (h10 : LieClassicalOddCharTwoBp) (h11 : LieExceptionalOddCharTwoBp)
    (h12 : LieEvenCharTwoBp)
    (hSpor : ∀ name : TauCeti.SporadicName, name ≠ .He →
      CatalogueBp 2 (TauCeti.CFSGIndex.sporadic name))
    (hHe : CatalogueBp 2 (TauCeti.CFSGIndex.sporadic .He)) : SimpleBp 2 S := by
  obtain ⟨i, ⟨e⟩⟩ := hcat
  have hs : IsSimpleGroup S := inferInstance
  cases i with
  | cyclic _q _hq =>
    exfalso
    obtain ⟨a, b, hab⟩ := hnc
    exact hab (e.injective (by rw [map_mul, map_mul]; exact mul_comm _ _))
  | alternating n hn => exact h01 n hn S hs hnc ⟨e⟩
  | sporadic name =>
    by_cases hHe' : name = .He
    · subst hHe'
      exact hHe S hs hnc ⟨e⟩
    · exact hSpor name hHe' S hs hnc ⟨e⟩
  | lie idx =>
    by_cases hc : idx.1.characteristic = 2
    · exact h12 idx hc S hs hnc ⟨e⟩
    · cases hf : lieFamily idx.1
      · exact h10 idx (.inl hf) hc S hs hnc ⟨e⟩
      · exact h10 idx (.inr hf) hc S hs hnc ⟨e⟩
      · exact h11 idx (.inl hf) hc S hs hnc ⟨e⟩
      · exact h11 idx (.inr hf) hc S hs hnc ⟨e⟩

