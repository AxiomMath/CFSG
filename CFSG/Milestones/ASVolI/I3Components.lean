  rfl

theorem burnsideI31_conjClosure_eq {H : Type} [Group H] (L : Subgroup H) :
    CFSG.ASVolI.ChIJK.conjClosure L (CFSG.ASVolI.ChIJK.oddCoreE H) =
      CFSG.QuasithinUnique.I32.normalClosureLayer L := by
  unfold CFSG.ASVolI.ChIJK.conjClosure CFSG.QuasithinUnique.I32.normalClosureLayer
  rw [burnsideI31_oddCoreE_eq]

theorem burnsideI31_conjugate_le {G : Type} [Group G] {L K : Subgroup G} {g : G}
    (hLK : L ≤ K) (hg : g ∈ Subgroup.normalizer (K : Set G)) : CFSG.conjugate L g ≤ K := by
  rintro _ ⟨y, hy, rfl⟩
  have h := (Subgroup.mem_normalizer_iff.mp (inv_mem hg) y).mp (hLK hy)
  simpa [MulAut.conj_apply] using h

theorem burnsideI31_oddCore_eq (G : Type*) [Group G] : CFSG.oddCore G = CFSG.pPrimeCore 2 G := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact (CFSG.oddCore_eq_piCore G).trans (CFSG.pPrimeCore_eq_piCore G 2).symm

@[expose] def burnsideI31_EltTwo : Prop :=
  ∀ (Z : Type) [Group Z] [Finite Z], CFSG.Open.lBalanceIsKGroup Z →
    CFSG.Open.lBalancePrimeCore 2 (⊤ : Subgroup Z) = ⊥ →
    ∀ x : Z, (∃ n : ℕ, x ^ 2 ^ n = 1) → x ^ 2 ∈ Subgroup.center Z →
      ∀ a ∈ CFSG.Open.lBalancePLayer 2 (Subgroup.centralizer ({x} : Set Z)),
        ∀ b ∈ CFSG.Open.lBalancePrimeCore 2 (Subgroup.centralizer ({x} : Set Z)),
          a * b = b * a

theorem burnsideI31_quasisimple {X : Type} [Group X] [Finite X]
    (hSch : CFSG.ComponentClassification.CatalogueRelativeB.CatalogueSchreier)
    (hElt : burnsideI31_EltTwo) (hK : CFSG.Open.lBalanceIsKGroup X)
    {P : Subgroup X} (hP : IsPGroup 2 P) {L : Subgroup X}
    (hLC : L ≤ Subgroup.centralizer (P : Set X))
    (hL : CFSG.ComponentClassification.TwoComponents.IsTwoComponent
      (L.subgroupOf (Subgroup.centralizer (P : Set X))))
    (hLO : L ≤ Subgroup.centralizer (CFSG.oddCore X : Set X)) :
    CFSG.IsQuasisimple ↥L := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set C : Subgroup X := Subgroup.centralizer (P : Set X) with hC
  let O : Subgroup X := CFSG.Open.componentClassificationOddCore X
  let π : X →* X ⧸ O := QuotientGroup.mk' O
  have hker : Odd (Nat.card π.ker) := by
    rw [show π.ker = O from QuotientGroup.ker_mk' O]
    exact CFSG.ComponentClassification.OddCore.odd_card X
  have hcore : CFSG.Open.componentClassificationOddCore (X ⧸ O) = ⊥ :=
    CFSG.ComponentClassification.OddCore.quotient_corefree X
  let Pb : Subgroup (X ⧸ O) := P.map π
  have hPb : IsPGroup 2 Pb := hP.map π
  let Cb : Subgroup (X ⧸ O) := Subgroup.centralizer (Pb : Set (X ⧸ O))
  have hCmap : C.map π = Cb := by
    have : Fact (IsPGroup 2 P) := ⟨hP⟩
    rw [hC]
    exact Eq.symm (CFSG.centralizer_map_quotient_eq_map_centralizer 2 P O inferInstance
      (Nat.coprime_two_left.mpr (CFSG.ComponentClassification.OddCore.odd_card X)))
  let φ : ↥C →* ↥Cb := (π.comp C.subtype).codRestrict Cb (fun c => by
    rw [← hCmap]
    exact Subgroup.mem_map_of_mem π c.2)
  have hφsurj : Function.Surjective φ := by
    intro y
    have hy : (y : X ⧸ O) ∈ C.map π := by rw [hCmap]; exact y.2
    obtain ⟨c, hc, hcy⟩ := Subgroup.mem_map.mp hy
    exact ⟨⟨c, hc⟩, Subtype.ext hcy⟩
  have hφker : Odd (Nat.card φ.ker) := by
    have hkerEq : φ.ker = (π.domRestrict C).ker := by
      ext element
      change φ element = 1 ↔ π element.val = 1
      exact ⟨fun h => congrArg Subtype.val h, fun h => Subtype.ext h⟩
    rw [hkerEq]
    exact CFSG.ComponentClassification.OddKernel.odd_card_restriction_kernel π hker C
  let L' : Subgroup ↥C := L.subgroupOf C
  let Lc : Subgroup ↥Cb := L'.map φ
  have hLc : CFSG.ComponentClassification.TwoComponents.IsTwoComponent Lc :=
    CFSG.ComponentClassification.OddKernelTwoComponents.image φ hφsurj hφker L' hL
  have hKb : CFSG.Open.lBalanceIsKGroup (X ⧸ O) :=
    CFSG.CGT.PushingUpLit.CGT6.openIsKGroup_of_isKGroup
      ((CFSG.HardMathSupport.Solomon.LocalBalance.Lemma27Ns.s1t_isKGroup_of_open hK).quotient O)
  have hcoreb : CFSG.Open.lBalancePrimeCore 2 (⊤ : Subgroup (X ⧸ O)) = ⊥ := by
    rw [CFSG.ComponentClassification.LBalance.primeCore_top,
      ← burnsideI31_oddCore_eq (X ⧸ O)]
    exact hcore
  have hbal := CFSG.Yardstones.Md42047359a2a.centralizer_case (p := 2) hSch hElt hKb hcoreb Pb hPb
  have hLcPC : CFSG.IsPComponent 2 Lc :=
    (CFSG.ComponentClassification.CatalogueBAlternating.pComponent_two_iff Lc).mpr hLc
  have hLcle : Lc ≤ CFSG.pLayer ↥Cb 2 := le_sSup hLcPC
  have hLayer : ∀ a : ↥Lc, ((a : ↥Cb) : X ⧸ O) ∈ CFSG.Open.lBalancePLayer 2 Cb := by
    intro a
    rw [CFSG.ComponentClassification.LBalance.Asm.lBalancePLayer_eq_map]
    exact ⟨(a : ↥Cb), hLcle a.2, rfl⟩
  have hOc : CFSG.Open.componentClassificationOddCore ↥Lc ≤ Subgroup.center ↥Lc := by
    intro b hb
    rw [Subgroup.mem_center_iff]
    intro a
    rw [CFSG.ComponentClassification.OddCore.subnormal_intersection Lc hLc.1,
      Subgroup.mem_subgroupOf] at hb
    have hb' : (b : ↥Cb) ∈ CFSG.pPrimeCore 2 ↥Cb := by
      rw [← burnsideI31_oddCore_eq]
      exact hb
    have hb'' : ((b : ↥Cb) : X ⧸ O) ∈ CFSG.Open.lBalancePrimeCore 2 Cb := by
      rw [CFSG.ComponentClassification.LBalance.primeCore_eq_map]
      exact ⟨(b : ↥Cb), hb', rfl⟩
    exact Subtype.ext (Subtype.ext (hbal _ (hLayer a) _ hb''))
  have hperfLc : Group.IsPerfect ↥Lc := ⟨CFSG.ComponentClassification.TwoComponents.perfect hLc⟩
  have hqLc : CFSG.IsQuasisimple ↥Lc := by
    refine (CFSG.LocalCores.isQuasisimple_iff_of_surjective hperfLc
      (QuotientGroup.mk' (CFSG.Open.componentClassificationOddCore ↥Lc))
      (QuotientGroup.mk'_surjective _) ?_).mpr ?_
    · rw [QuotientGroup.ker_mk']
      exact hOc
    · exact CFSG.Quasithin.A3.isQuasisimple_iff_open.mpr
        (CFSG.ComponentClassification.TwoComponents.quasisimple_quotient hLc)
  have hperfC : Group.IsPerfect ↥(L.subgroupOf C) :=
    ⟨CFSG.ComponentClassification.TwoComponents.perfect hL⟩
  have hperfL : Group.IsPerfect ↥L :=
    Group.IsPerfect.ofSurjective (f := (Subgroup.subgroupOfEquivOfLe hLC).toMonoidHom)
      (Subgroup.subgroupOfEquivOfLe hLC).surjective
  let ψ : ↥L →* ↥Lc := (φ.comp (Subgroup.inclusion hLC)).codRestrict Lc
    (fun x => Subgroup.mem_map_of_mem φ (Subgroup.mem_subgroupOf.mpr x.2))
  have hψsurj : Function.Surjective ψ := by
    intro y
    obtain ⟨l, hl, hly⟩ := Subgroup.mem_map.mp y.2
    refine ⟨⟨(l : X), Subgroup.mem_subgroupOf.mp hl⟩, Subtype.ext ?_⟩
    exact hly
  have hψker : ψ.ker ≤ Subgroup.center ↥L := by
    intro x hx
    have h1 : π (x : X) = 1 := by
      have := congrArg (fun y : ↥Lc => ((y : ↥Cb) : X ⧸ O)) (MonoidHom.mem_ker.mp hx)
      exact this
    have h2 : (x : X) ∈ CFSG.oddCore X := (QuotientGroup.eq_one_iff _).mp h1
    rw [Subgroup.mem_center_iff]
    intro g
    exact Subtype.ext (Subgroup.mem_centralizer_iff.mp (hLO g.2) _ h2).symm
  exact (CFSG.LocalCores.isQuasisimple_iff_of_surjective hperfL ψ hψsurj hψker).mpr hqLc

