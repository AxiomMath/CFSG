theorem burnsideI31_mem_cComp_iff {G : Type} [Group G] [Finite G] {L X : Subgroup G} :
    L ∈ CFSG.Quasithin.cComp X ↔ L ≤ X ∧ CFSG.IsCComponent (L.subgroupOf X) := by
  constructor
  · intro h
    exact ⟨CFSG.Quasithin.le_of_mem_cComp h,
      CFSG.Quasithin.mem_cComp_top_iff_isCComponent.mp (CFSG.Quasithin.subgroupOf_mem_cComp h)⟩
  · rintro ⟨hLX, h⟩
    have := CFSG.Quasithin.map_subtype_mem_cComp
      (CFSG.Quasithin.mem_cComp_top_iff_isCComponent.mpr h)
    rwa [Subgroup.map_subgroupOf_eq_of_le hLX] at this

theorem burnsideI31_isTwoComponentIn_iff {G : Type} [Group G] [Finite G] {L X : Subgroup G} :
    CFSG.ASVolI.ChIJK.IsTwoComponentIn L X ↔
      CFSG.QuasithinUnique.Id2519.IsTwoComponentIn L X := by
  unfold CFSG.ASVolI.ChIJK.IsTwoComponentIn CFSG.ASVolI.ChIJK.IsCComponentIn
    CFSG.QuasithinUnique.Id2519.IsTwoComponentIn
  rw [burnsideI31_mem_cComp_iff]

theorem burnsideI31_twoComponent_of {G : Type} [Group G] [Finite G] {L X : Subgroup G}
    (h : CFSG.ASVolI.ChIJK.IsTwoComponentIn L X) :
    L ≤ X ∧ CFSG.ComponentClassification.TwoComponents.IsTwoComponent (L.subgroupOf X) := by
  have h' := burnsideI31_isTwoComponentIn_iff.mp h
  have hle := CFSG.Quasithin.le_of_mem_cComp h'.1
  exact ⟨hle, (CFSG.QuasithinUnique.I32.isTwoComponentIn_iff hle).mp h'⟩

theorem burnsideI31_isTwoComponentIn_top {G : Type} [Group G] [Finite G] {K : Subgroup G}
    (h : CFSG.ComponentClassification.TwoComponents.IsTwoComponent K) :
    CFSG.ASVolI.ChIJK.IsTwoComponentIn K ⊤ := by
  rw [burnsideI31_isTwoComponentIn_iff]
  let e : G ≃* (⊤ : Subgroup G) := Subgroup.topEquiv.symm
  have h1 := (CFSG.ComponentClassification.TwoComponentTransport.equiv_iff e K).mpr h
  have h2 := (CFSG.QuasithinUnique.I32.isTwoComponentIn_map (H := (⊤ : Subgroup G)) _).mpr h1
  have h3 : (K.map e.toMonoidHom).map (⊤ : Subgroup G).subtype = K := by
    rw [Subgroup.map_map]
    ext x
    simp [e]
  rwa [h3] at h2

theorem burnsideI31_oddCoreE_eq (H : Type) [Group H] :
    CFSG.ASVolI.ChIJK.oddCoreE H = CFSG.QuasithinUnique.I32.oddLayerOf H := by
  unfold CFSG.ASVolI.ChIJK.oddCoreE CFSG.QuasithinUnique.I32.oddLayerOf
