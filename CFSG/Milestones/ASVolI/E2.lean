      alternatingGroup (Fin 6))

private theorem e25_commutator_iso {Γ : Type} [Group Γ] (S : Subgroup Γ)
    (e : ↥S ≃* Equiv.Perm (Fin 6)) :
    Nonempty (↥⁅S, S⁆ ≃* alternatingGroup (Fin 6)) := by
  have hTop : (⊤ : Subgroup ↥S).map S.subtype = S := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  have hmap : (⁅(⊤ : Subgroup ↥S), (⊤ : Subgroup ↥S)⁆).map S.subtype = ⁅S, S⁆ := by
    rw [Subgroup.map_commutator, hTop]
  have hK : (⁅(⊤ : Subgroup ↥S), (⊤ : Subgroup ↥S)⁆).map (e : ↥S →* Equiv.Perm (Fin 6)) =
      alternatingGroup (Fin 6) := by
    rw [Subgroup.map_commutator,
      Subgroup.map_top_of_surjective (e : ↥S →* Equiv.Perm (Fin 6)) e.surjective]
    exact alternatingGroup.commutator_perm_eq (by simp)
  exact ⟨(MulEquiv.subgroupCongr hmap.symm).trans
    ((Subgroup.equivMapOfInjective (⁅(⊤ : Subgroup ↥S), (⊤ : Subgroup ↥S)⁆) S.subtype
        (Subgroup.subtype_injective S)).symm.trans
      ((MulEquiv.subgroupMap e (⁅(⊤ : Subgroup ↥S), (⊤ : Subgroup ↥S)⁆)).trans
        (MulEquiv.subgroupCongr hK)))⟩

