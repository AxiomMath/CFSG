@[expose] def E_2_6 : Prop :=
  ∀ (F : Type) [Field F] [Finite F] [CharP F 2] (t : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F)),
    IsInSp4 t → (∀ v, t (t v) = v) → t ≠ LinearEquiv.refl F (Fin 4 → F) →
      (IsRootInvolution4 t ↔ (IsSuzukiTypeB sympForm4 t 1 ∨ IsSuzukiTypeA sympForm4 t 2)) ∧
      (¬ IsRootInvolution4 t ↔ IsSuzukiTypeC sympForm4 t 2)

section E266

variable {F : Type} [Field F]

theorem e266_sympForm4_apply (x y : Fin 4 → F) :
    sympForm4 x y = x 0 * y 3 + x 1 * y 2 + x 2 * y 1 + x 3 * y 0 := by
  simp [sympForm4, Matrix.toBilin'_apply', dotProduct, Matrix.mulVec, Fin.sum_univ_four]

theorem e266_sympForm4_self [CharP F 2] (x : Fin 4 → F) : sympForm4 x x = 0 := by
  rw [e266_sympForm4_apply]
  have h2 : (2 : F) = 0 := CharTwo.two_eq_zero
  linear_combination (x 0 * x 3 + x 1 * x 2) * h2

theorem e266_sympForm4_symm (x y : Fin 4 → F) : sympForm4 x y = sympForm4 y x := by
  rw [e266_sympForm4_apply, e266_sympForm4_apply]; ring

theorem e266_nondeg_left (x : Fin 4 → F) (h : ∀ y : Fin 4 → F, sympForm4 x y = 0) : x = 0 := by
  have h0 := h (Pi.single 0 1)
  have h1 := h (Pi.single 1 1)
  have h2 := h (Pi.single 2 1)
  have h3 := h (Pi.single 3 1)
  simp [e266_sympForm4_apply] at h0 h1 h2 h3
  funext i
  fin_cases i <;> simp_all

theorem e266_nondeg_right (y : Fin 4 → F) (h : ∀ x : Fin 4 → F, sympForm4 x y = 0) : y = 0 :=
  e266_nondeg_left y fun x => by rw [e266_sympForm4_symm]; exact h x

theorem e266_gram_equiv [CharP F 2] (u : Fin 4 → Fin 4 → F)
    (hu : ∀ i j, sympForm4 (u i) (u j) = sympForm4 (Pi.single i 1) (Pi.single j 1)) :
    ∃ g : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F), IsInSp4 g ∧ ∀ i, g (Pi.single i 1) = u i := by
  set L : (Fin 4 → F) →ₗ[F] (Fin 4 → F) := (Pi.basisFun F (Fin 4)).constr F u with hLdef
  have hL : ∀ i, L (Pi.single i 1) = u i := by
    intro i
    simp [hLdef]
  have hLx : ∀ x : Fin 4 → F, L x = x 0 • u 0 + x 1 • u 1 + x 2 • u 2 + x 3 • u 3 := by
    intro x
    have hx : x = x 0 • Pi.single 0 1 + x 1 • Pi.single 1 1 + x 2 • Pi.single 2 1 +
        x 3 • Pi.single 3 1 := by
      funext i
      fin_cases i <;> simp
    conv_lhs => rw [hx]
    simp only [map_add, map_smul, hL]
  have hiso : ∀ x y, sympForm4 (L x) (L y) = sympForm4 x y := by
    intro x y
    rw [hLx x, hLx y]
    simp only [map_add, map_smul, LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul]
    simp only [hu]
    simp [e266_sympForm4_apply, Pi.single_apply]
    ring
  have hinj : Function.Injective L := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    apply e266_nondeg_left
    intro y
    rw [← hiso x y, hx]
    simp
  refine ⟨LinearEquiv.ofInjectiveEndo L hinj, ?_, ?_⟩
  · intro x y
    exact hiso x y
  · intro i
    exact hL i

theorem e266_exists_sp4_apply_zero [CharP F 2] {w : Fin 4 → F} (hw : w ≠ 0) :
    ∃ g : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F), IsInSp4 g ∧ g (Pi.single 0 1) = w := by
  have hB : (sympForm4 : LinearMap.BilinForm F (Fin 4 → F)).IsAlt :=
    fun x => e266_sympForm4_self x
  have hnd : (sympForm4 : LinearMap.BilinForm F (Fin 4 → F)).Nondegenerate :=
    ⟨fun x hx => e266_nondeg_left x hx, fun y hy => e266_nondeg_right y hy⟩
  obtain ⟨m, b, hb, hbw⟩ :=
    LinearMap.BilinForm.IsAlt.exists_basis_apply_eq_J_inl_zero_eq hB hnd hw
  have hcard : Fintype.card (Fin (m + 1) ⊕ Fin (m + 1)) = 4 := by
    rw [← Module.finrank_eq_card_basis b, Module.finrank_fin_fun]
  simp only [Fintype.card_sum, Fintype.card_fin] at hcard
  obtain rfl : m = 1 := by omega
  let σ : Fin 4 → Fin (1 + 1) ⊕ Fin (1 + 1) := ![Sum.inl 0, Sum.inl 1, Sum.inr 1, Sum.inr 0]
  have hu : ∀ i j, sympForm4 (b (σ i)) (b (σ j)) = sympForm4 (Pi.single i 1) (Pi.single j 1) := by
    intro i j
    rw [hb]
    fin_cases i <;> fin_cases j <;>
      simp [σ, Matrix.J, e266_sympForm4_apply, Pi.single_apply, CharTwo.neg_eq]
  obtain ⟨g, hg, hgi⟩ := e266_gram_equiv (fun i => b (σ i)) hu
  exact ⟨g, hg, by rw [hgi 0]; simpa [σ] using hbw⟩

theorem e266_exists_sp4_frame [CharP F 2] {w₀ w₁ : Fin 4 → F} (h₀ : w₀ ≠ 0)
    (h01 : sympForm4 w₀ w₁ = 0) (hind : ∀ c : F, w₁ ≠ c • w₀) :
    ∃ g : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F), IsInSp4 g ∧ g (Pi.single 0 1) = w₀ ∧
      ∃ c : F, g (Pi.single 1 1) = w₁ + c • w₀ := by
  obtain ⟨g₁, hg₁, hg₁0⟩ := e266_exists_sp4_apply_zero h₀
  obtain ⟨y, hgy⟩ : ∃ y : Fin 4 → F, g₁ y = w₁ := ⟨g₁.symm w₁, by simp⟩
  have hy3 : y 3 = 0 := by
    have h := hg₁ (Pi.single 0 1) y
    have key : sympForm4 (Pi.single 0 1) y = y 3 := by simp [e266_sympForm4_apply]
    rw [hg₁0, hgy, h01, key] at h
    exact h.symm
  have hyy : y = y 0 • Pi.single 0 1 + ![0, y 1, y 2, 0] := by
    funext i
    fin_cases i <;> simp [hy3]
  have hsplit : w₁ = y 0 • w₀ + g₁ ![0, y 1, y 2, 0] := by
    calc w₁ = g₁ y := hgy.symm
      _ = g₁ (y 0 • Pi.single 0 1 + ![0, y 1, y 2, 0]) := by rw [← hyy]
      _ = y 0 • w₀ + g₁ ![0, y 1, y 2, 0] := by rw [map_add, map_smul, hg₁0]
  have hy12 : y 1 ≠ 0 ∨ y 2 ≠ 0 := by
    by_contra hcon
    push Not at hcon
    apply hind (y 0)
    have h0 : (![0, y 1, y 2, 0] : Fin 4 → F) = 0 := by
      funext i
      fin_cases i <;> simp [hcon.1, hcon.2]
    rw [hsplit, h0, map_zero, add_zero]
  obtain ⟨c, d, hcd⟩ : ∃ c d : F, y 1 * d + y 2 * c = 1 := by
    rcases hy12 with h1 | h2
    · exact ⟨0, (y 1)⁻¹, by simp [mul_inv_cancel₀ h1]⟩
    · exact ⟨(y 2)⁻¹, 0, by simp [mul_inv_cancel₀ h2]⟩
  obtain ⟨h, hh, hh'⟩ := e266_gram_equiv
    ![Pi.single 0 1, ![0, y 1, y 2, 0], ![0, c, d, 0], Pi.single 3 1] (by
      intro i j
      fin_cases i <;> fin_cases j <;>
        first
        | rw [e266_sympForm4_self, e266_sympForm4_self]
        | (simp [e266_sympForm4_apply, Pi.single_apply] <;> first | linear_combination hcd | ring))
  refine ⟨h.trans g₁, ?_, ?_, -y 0, ?_⟩
  · intro a b
    simp only [LinearEquiv.trans_apply]
    rw [hg₁ (h a) (h b), hh a b]
  · simp only [LinearEquiv.trans_apply]
    rw [hh' 0]
    simpa using hg₁0
  · simp only [LinearEquiv.trans_apply]
    rw [hh' 1]
    simp only [Matrix.cons_val_one, Matrix.cons_val_zero, Matrix.head_cons]
    calc g₁ ![0, y 1, y 2, 0] = (y 0 • w₀ + g₁ ![0, y 1, y 2, 0]) - y 0 • w₀ := by abel
      _ = w₁ - y 0 • w₀ := by rw [← hsplit]
      _ = w₁ + (-y 0) • w₀ := by rw [neg_smul, sub_eq_add_neg]

theorem e266_longRoot4_apply (a : F) (x : Fin 4 → F) :
    longRoot4 a x = x + a • (x 3 • Pi.single 0 1) := by
  simp [longRoot4]

theorem e266_shortRoot4_apply (a : F) (x : Fin 4 → F) :
    shortRoot4 a x = x + a • (x 2 • Pi.single 0 1 + x 3 • Pi.single 1 1) := by
  simp [shortRoot4]

theorem e266_sq [CharP F 2] (t : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F)) (hsq : ∀ v, t (t v) = v)
    (v : Fin 4 → F) : t (t v - v) - (t v - v) = 0 := by
  rw [map_sub, hsq]
  have h : v - t v - (t v - v) = (2 : F) • (v - t v) := by module
  rw [h, CharTwo.two_eq_zero, zero_smul]

theorem e266_polar [CharP F 2] (t : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F))
    (hA : ∀ v, sympForm4 v (t v) = 0) (x y : Fin 4 → F) :
    sympForm4 x (t y - y) + sympForm4 y (t x - x) = 0 := by
  have h1 := hA (x + y)
  have hxy := e266_sympForm4_self (x + y)
  have hx := hA x
  have hy := hA y
  have hx' := e266_sympForm4_self x
  have hy' := e266_sympForm4_self y
  simp only [map_add, LinearMap.add_apply, map_sub, LinearMap.sub_apply] at h1 hxy ⊢
  linear_combination h1 - hx - hy - hxy + hx' + hy'

theorem e266_range_iso [CharP F 2] (t : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F))
    (ht : IsInSp4 t) (hA : ∀ v, sympForm4 v (t v) = 0) (x y : Fin 4 → F) :
    sympForm4 (t x - x) (t y - y) = 0 := by
  have hs := ht x y
  have ex : x + (t x - x) = t x := by abel
  have ey : y + (t y - y) = t y := by abel
  rw [← ex, ← ey] at hs
  simp only [map_add, LinearMap.add_apply] at hs
  have hp := e266_polar t hA x y
  have hsym := e266_sympForm4_symm (t x - x) y
  linear_combination hs - hp - hsym

theorem e266_root_of_rank_one [CharP F 2] (t : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F))
    (ht : IsInSp4 t)
    (hr : Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) = 1) :
    IsRootInvolution4 t := by
  obtain ⟨w, hwN, hw0, hwspan⟩ : ∃ w ∈ LinearMap.range (t.toLinearMap - LinearMap.id),
      w ≠ 0 ∧ ∀ x ∈ LinearMap.range (t.toLinearMap - LinearMap.id), ∃ c : F, x = c • w := by
    let b := Module.finBasisOfFinrankEq F (LinearMap.range (t.toLinearMap - LinearMap.id)) hr
    refine ⟨(b 0 : Fin 4 → F), (b 0).2, fun h => b.ne_zero 0 (Subtype.ext h), fun x hx => ?_⟩
    refine ⟨b.repr ⟨x, hx⟩ 0, ?_⟩
    have h2 := congrArg Subtype.val (b.sum_repr ⟨x, hx⟩)
    simpa [Fin.sum_univ_one] using h2.symm
  have hNv : ∀ v, t v - v ∈ LinearMap.range (t.toLinearMap - LinearMap.id) :=
    fun v => ⟨v, by simp⟩
  obtain ⟨u0, hu0⟩ : ∃ u0, t u0 - u0 = w := by
    obtain ⟨u0, hu0⟩ := hwN
    exact ⟨u0, by simpa using hu0⟩
  have hrel : ∀ v c, t v - v = c • w → c * sympForm4 w u0 = -(sympForm4 w v) := by
    intro v c hc
    have hs := ht u0 v
    have e1 : t u0 = u0 + w := by rw [← hu0]; abel
    have e2 : t v = v + c • w := by rw [← hc]; abel
    rw [e1, e2] at hs
    have hw' := e266_sympForm4_self w
    have hsy := e266_sympForm4_symm u0 w
    simp only [map_add, LinearMap.add_apply, map_smul, LinearMap.smul_apply, smul_eq_mul]
      at hs
    linear_combination hs - c * hw' - c * hsy
  have hlam : sympForm4 w u0 ≠ 0 := by
    intro h0
    apply hw0
    apply e266_nondeg_left
    intro y
    obtain ⟨c, hc⟩ := hwspan _ (hNv y)
    have := hrel y c hc
    rw [h0, mul_zero] at this
    exact neg_eq_zero.mp this.symm
  have hNform : ∀ v, t v - v = (-(sympForm4 w u0)⁻¹ * sympForm4 w v) • w := by
    intro v
    obtain ⟨c, hc⟩ := hwspan _ (hNv v)
    have hr' := hrel v c hc
    have hc' : c = -(sympForm4 w v) * (sympForm4 w u0)⁻¹ := by
      calc c = c * sympForm4 w u0 * (sympForm4 w u0)⁻¹ :=
            (mul_inv_cancel_right₀ hlam c).symm
        _ = -(sympForm4 w v) * (sympForm4 w u0)⁻¹ := by rw [hr']
    rw [hc, hc']
    congr 1
    ring
  obtain ⟨g, hg, hg0⟩ := e266_exists_sp4_apply_zero hw0
  have hx3 : ∀ v, (g.symm v) 3 = sympForm4 w v := by
    intro v
    have h := hg (Pi.single 0 1) (g.symm v)
    rw [hg0, LinearEquiv.apply_symm_apply] at h
    rw [h, e266_sympForm4_apply]
    simp
  refine ⟨g, -(sympForm4 w u0)⁻¹, hg, neg_ne_zero.mpr (inv_ne_zero hlam), Or.inl fun v => ?_⟩
  rw [e266_longRoot4_apply, map_add, map_smul, map_smul, hg0, LinearEquiv.apply_symm_apply,
    hx3]
  have h := hNform v
  rw [mul_smul, sub_eq_iff_eq_add] at h
  rw [h, add_comm]

theorem e266_finrank_conj (g : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F))
    (z : (Fin 4 → F) →ₗ[F] (Fin 4 → F)) (t : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F))
    (ht : ∀ v, t v = g (z (g.symm v))) :
    Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) =
      Module.finrank F (LinearMap.range (z - LinearMap.id)) := by
  have hM : t.toLinearMap - LinearMap.id =
      (g.toLinearMap ∘ₗ (z - LinearMap.id)) ∘ₗ g.symm.toLinearMap := by
    ext v
    simp [ht]
  rw [hM, LinearMap.range_comp, LinearEquiv.range, Submodule.map_top, LinearMap.range_comp,
    LinearEquiv.finrank_map_eq]

theorem e266_pi_single_ne_zero (i : Fin 4) : (Pi.single i 1 : Fin 4 → F) ≠ 0 := by
  intro h
  have := congrFun h i
  simp at this

theorem e266_finrank_long {a : F} (ha : a ≠ 0) :
    Module.finrank F (LinearMap.range (longRoot4 a - LinearMap.id)) = 1 := by
  have hrange : LinearMap.range (longRoot4 a - LinearMap.id) =
      Submodule.span F {(Pi.single 0 1 : Fin 4 → F)} := by
    ext x
    constructor
    · rintro ⟨v, rfl⟩
      have hv : (longRoot4 a - LinearMap.id : (Fin 4 → F) →ₗ[F] (Fin 4 → F)) v =
          (a * v 3) • (Pi.single 0 1 : Fin 4 → F) := by
        simp [e266_longRoot4_apply, smul_smul]
      rw [hv]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
    · intro hx
      obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hx
      refine ⟨(c * a⁻¹) • (Pi.single 3 1 : Fin 4 → F), ?_⟩
      have hac : c * a⁻¹ * a = c := by field_simp
      simp [e266_longRoot4_apply, smul_smul, hac]
  rw [hrange, finrank_span_singleton (e266_pi_single_ne_zero 0)]

theorem e266_short_sub (a : F) (v : Fin 4 → F) :
    (shortRoot4 a - LinearMap.id : (Fin 4 → F) →ₗ[F] (Fin 4 → F)) v =
      a • (v 2 • (Pi.single 0 1 : Fin 4 → F) + v 3 • Pi.single 1 1) := by
  simp [e266_shortRoot4_apply]

theorem e266_finrank_short {a : F} (ha : a ≠ 0) :
    Module.finrank F (LinearMap.range (shortRoot4 a - LinearMap.id)) = 2 := by
  have hli : LinearIndependent F ![(Pi.single 0 1 : Fin 4 → F), Pi.single 1 1] := by
    rw [Fintype.linearIndependent_iff]
    intro g hg i
    have h0 : g 0 = 0 := by
      have := congrFun hg 0
      simpa [Fin.sum_univ_two, Pi.single_apply] using this
    have h1 : g 1 = 0 := by
      have := congrFun hg 1
      simpa [Fin.sum_univ_two, Pi.single_apply] using this
    fin_cases i <;> simp [h0, h1]
  have hrange : LinearMap.range (shortRoot4 a - LinearMap.id) =
      Submodule.span F {(Pi.single 0 1 : Fin 4 → F), Pi.single 1 1} := by
    ext x
    constructor
    · rintro ⟨v, rfl⟩
      have hv : (shortRoot4 a - LinearMap.id : (Fin 4 → F) →ₗ[F] (Fin 4 → F)) v =
          a • (v 2 • (Pi.single 0 1 : Fin 4 → F) + v 3 • Pi.single 1 1) := by
        simp [e266_shortRoot4_apply]
      rw [hv]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_pair.mpr ⟨v 2, v 3, rfl⟩)
    · intro hx
      obtain ⟨c0, c1, rfl⟩ := Submodule.mem_span_pair.mp hx
      refine ⟨(c0 * a⁻¹) • Pi.single 2 1 + (c1 * a⁻¹) • Pi.single 3 1, ?_⟩
      have h0 : a * (c0 * a⁻¹) = c0 := by field_simp
      have h1 : a * (c1 * a⁻¹) = c1 := by field_simp
      have hv2 : ((c0 * a⁻¹) • Pi.single 2 1 + (c1 * a⁻¹) • Pi.single 3 1 : Fin 4 → F) 2 =
          c0 * a⁻¹ := by simp [Pi.single_apply]
      have hv3 : ((c0 * a⁻¹) • Pi.single 2 1 + (c1 * a⁻¹) • Pi.single 3 1 : Fin 4 → F) 3 =
          c1 * a⁻¹ := by simp [Pi.single_apply]
      rw [e266_short_sub, hv2, hv3, smul_add, smul_smul, smul_smul, h0, h1]
  rw [hrange, ← Matrix.range_cons_cons_empty _ _ ![], finrank_span_eq_card hli, Fintype.card_fin]

theorem e266_L4 [CharP F 2] (t : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F))
    (hroot : IsRootInvolution4 t) :
    Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) = 1 ∨
      (Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) = 2 ∧
        ∀ v, sympForm4 v (t v) = 0) := by
  obtain ⟨g, a, hg, ha, hcase⟩ := hroot
  rcases hcase with hz | hz
  · left
    rw [e266_finrank_conj g (longRoot4 a) t hz, e266_finrank_long ha]
  · right
    refine ⟨by rw [e266_finrank_conj g (shortRoot4 a) t hz, e266_finrank_short ha], ?_⟩
    intro v
    obtain ⟨y, rfl⟩ : ∃ y, v = g y := ⟨g.symm v, (g.apply_symm_apply v).symm⟩
    have h2 : (2 : F) = 0 := CharTwo.two_eq_zero
    rw [hz, LinearEquiv.symm_apply_apply, hg y (shortRoot4 a y), e266_shortRoot4_apply,
      e266_sympForm4_apply]
    simp [Pi.single_apply]
    linear_combination (y 0 * y 3 + y 1 * y 2 + a * y 2 * y 3) * h2

theorem e266_rank_bounds [CharP F 2] (t : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F))
    (hsq : ∀ v, t (t v) = v) (hne : t ≠ LinearEquiv.refl F (Fin 4 → F)) :
    1 ≤ Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) ∧
      Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) ≤ 2 := by
  have hrk := LinearMap.finrank_range_add_finrank_ker (t.toLinearMap - LinearMap.id)
  have hV : Module.finrank F (Fin 4 → F) = 4 := by simp
  have hle : LinearMap.range (t.toLinearMap - LinearMap.id) ≤
      LinearMap.ker (t.toLinearMap - LinearMap.id) := by
    rintro x ⟨v, rfl⟩
    rw [LinearMap.mem_ker]
    have := e266_sq t hsq v
    simpa using this
  have hmono := Submodule.finrank_mono hle
  have hpos : Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) ≠ 0 := by
    intro h0
    rw [Submodule.finrank_eq_zero, LinearMap.range_eq_bot] at h0
    apply hne
    apply LinearEquiv.ext
    intro v
    have := LinearMap.congr_fun h0 v
    simpa [sub_eq_zero] using this
  constructor
  · omega
  · omega

theorem e266_root_of_lagrangian [CharP F 2] (t : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F))
    (ht : IsInSp4 t) (hsq : ∀ v, t (t v) = v) (hA : ∀ v, sympForm4 v (t v) = 0)
    (hr : Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) = 2) :
    IsRootInvolution4 t := by
  obtain ⟨w0, w1, hw0N, hw1N, hw0ne, hspan, hind⟩ : ∃ w0 w1 : Fin 4 → F,
      w0 ∈ LinearMap.range (t.toLinearMap - LinearMap.id) ∧
      w1 ∈ LinearMap.range (t.toLinearMap - LinearMap.id) ∧ w0 ≠ 0 ∧
      (∀ x ∈ LinearMap.range (t.toLinearMap - LinearMap.id), ∃ α β : F, x = α • w0 + β • w1) ∧
      ∀ c : F, w1 ≠ c • w0 := by
    let b := Module.finBasisOfFinrankEq F (LinearMap.range (t.toLinearMap - LinearMap.id)) hr
    refine ⟨(b 0 : Fin 4 → F), (b 1 : Fin 4 → F), (b 0).2, (b 1).2,
      fun h => b.ne_zero 0 (Subtype.ext h), fun x hx => ?_, fun c hc => ?_⟩
    · have h2 := congrArg Subtype.val (b.sum_repr ⟨x, hx⟩)
      refine ⟨b.repr ⟨x, hx⟩ 0, b.repr ⟨x, hx⟩ 1, ?_⟩
      rw [Fin.sum_univ_two, Submodule.coe_add, Submodule.coe_smul, Submodule.coe_smul] at h2
      exact h2.symm
    · have hli := b.linearIndependent
      rw [Fintype.linearIndependent_iff] at hli
      have key := hli ![-c, 1] (by
        apply Subtype.ext
        simp [Fin.sum_univ_two, hc])
      have h1 := key 1
      simp at h1
  obtain ⟨x0, hx0⟩ : ∃ x0, t x0 - x0 = w0 := by
    obtain ⟨x0, hx0⟩ := hw0N
    exact ⟨x0, by simpa using hx0⟩
  obtain ⟨x1, hx1⟩ : ∃ x1, t x1 - x1 = w1 := by
    obtain ⟨x1, hx1⟩ := hw1N
    exact ⟨x1, by simpa using hx1⟩
  have h01 : sympForm4 w0 w1 = 0 := by
    rw [← hx0, ← hx1]
    exact e266_range_iso t ht hA x0 x1
  obtain ⟨g, hg, hg0, c, hgc⟩ := e266_exists_sp4_frame hw0ne h01 hind
  let T' : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F) := (g.trans t).trans g.symm
  have hT' : ∀ v, T' v = g.symm (t (g v)) := fun v => rfl
  have hsqT : ∀ v, T' (T' v) = v := by
    intro v
    simp only [hT', LinearEquiv.apply_symm_apply, hsq, LinearEquiv.symm_apply_apply]
  have hAT : ∀ x, sympForm4 x (T' x) = 0 := by
    intro x
    rw [← hg x (T' x), hT' x, LinearEquiv.apply_symm_apply]
    exact hA (g x)
  have hcoord : ∀ v, ∃ α β : F,
      T' v = v + (α • (Pi.single 0 1 : Fin 4 → F) + β • (Pi.single 1 1 - c • Pi.single 0 1)) := by
    intro v
    obtain ⟨α, β, hab⟩ := hspan _ (show t (g v) - g v ∈
      LinearMap.range (t.toLinearMap - LinearMap.id) from ⟨g v, by simp⟩)
    refine ⟨α, β, ?_⟩
    have hX : g (α • (Pi.single 0 1 : Fin 4 → F) + β • (Pi.single 1 1 - c • Pi.single 0 1)) =
        t (g v) - g v := by
      rw [map_add, map_smul, map_smul, map_sub, map_smul, hg0, hgc, add_sub_cancel_right, hab]
    have ht' : t (g v) = g (v + (α • (Pi.single 0 1 : Fin 4 → F) +
        β • (Pi.single 1 1 - c • Pi.single 0 1))) := by
      rw [map_add, hX]
      abel
    rw [hT', ht', LinearEquiv.symm_apply_apply]
  have hcoord2 : ∀ v, (T' v - v) 2 = 0 ∧ (T' v - v) 3 = 0 := by
    intro v
    obtain ⟨α, β, h⟩ := hcoord v
    rw [h, add_sub_cancel_left]
    simp [Pi.single_apply]
  have hy0 : ∃ y, T' y - y = Pi.single 0 1 := ⟨g.symm x0, by
    rw [hT', LinearEquiv.apply_symm_apply, ← map_sub, hx0, ← hg0, LinearEquiv.symm_apply_apply]⟩
  have hy1 : ∃ y, T' y - y = Pi.single 1 1 := by
    have hmem : w1 + c • w0 ∈ LinearMap.range (t.toLinearMap - LinearMap.id) :=
      Submodule.add_mem _ hw1N (Submodule.smul_mem _ c hw0N)
    obtain ⟨x2, hx2⟩ := hmem
    have hx2' : t x2 - x2 = w1 + c • w0 := by simpa using hx2
    refine ⟨g.symm x2, ?_⟩
    rw [hT', LinearEquiv.apply_symm_apply, ← map_sub, hx2', ← hgc,
      LinearEquiv.symm_apply_apply]
  have hT0 : T' (Pi.single 0 1) - Pi.single 0 1 = 0 := by
    obtain ⟨y, hy⟩ := hy0
    have := e266_sq T' hsqT y
    rw [hy] at this
    exact this
  have hT1 : T' (Pi.single 1 1) - Pi.single 1 1 = 0 := by
    obtain ⟨y, hy⟩ := hy1
    have := e266_sq T' hsqT y
    rw [hy] at this
    exact this
  have hA2 : T' (Pi.single 2 1) 1 = 0 := by
    have := hAT (Pi.single 2 1)
    rw [e266_sympForm4_apply] at this
    simpa using this
  have hA3 : T' (Pi.single 3 1) 0 = 0 := by
    have := hAT (Pi.single 3 1)
    rw [e266_sympForm4_apply] at this
    simpa using this
  have hpol := e266_polar T' hAT (Pi.single 3 1) (Pi.single 2 1)
  have hpol' : (T' (Pi.single 2 1) - Pi.single 2 1 : Fin 4 → F) 0 +
      (T' (Pi.single 3 1) - Pi.single 3 1 : Fin 4 → F) 1 = 0 := by
    simpa [e266_sympForm4_apply] using hpol
  obtain ⟨a, ha⟩ : ∃ a : F, (T' (Pi.single 2 1) - Pi.single 2 1 : Fin 4 → F) 0 = a := ⟨_, rfl⟩
  have hneg : (T' (Pi.single 3 1) - Pi.single 3 1 : Fin 4 → F) 1 = a := by
    rw [ha] at hpol'
    have h3 : (T' (Pi.single 3 1) - Pi.single 3 1 : Fin 4 → F) 1 = -a := by linear_combination hpol'
    rw [h3, CharTwo.neg_eq]
  have hs_eq : T' (Pi.single 2 1) - Pi.single 2 1 = a • (Pi.single 0 1 : Fin 4 → F) := by
    have c2 := hcoord2 (Pi.single 2 1)
    funext j
    fin_cases j
    · simp [ha]
    · simp [hA2]
    · simpa using c2.1
    · simpa using c2.2
  have hr_eq : T' (Pi.single 3 1) - Pi.single 3 1 = a • (Pi.single 1 1 : Fin 4 → F) := by
    have c3 := hcoord2 (Pi.single 3 1)
    funext j
    fin_cases j
    · simp [hA3]
    · simp [hneg]
    · simpa using c3.1
    · simpa using c3.2
  have hb0 : (T'.toLinearMap - LinearMap.id : (Fin 4 → F) →ₗ[F] (Fin 4 → F))
      (Pi.single 0 1) = (shortRoot4 a - LinearMap.id : (Fin 4 → F) →ₗ[F] (Fin 4 → F))
      (Pi.single 0 1) := by
    rw [LinearMap.sub_apply, LinearMap.sub_apply, e266_shortRoot4_apply]
    simpa using hT0
  have hb1 : (T'.toLinearMap - LinearMap.id : (Fin 4 → F) →ₗ[F] (Fin 4 → F))
      (Pi.single 1 1) = (shortRoot4 a - LinearMap.id : (Fin 4 → F) →ₗ[F] (Fin 4 → F))
      (Pi.single 1 1) := by
    rw [LinearMap.sub_apply, LinearMap.sub_apply, e266_shortRoot4_apply]
    simpa using hT1
  have hb2 : (T'.toLinearMap - LinearMap.id : (Fin 4 → F) →ₗ[F] (Fin 4 → F))
      (Pi.single 2 1) = (shortRoot4 a - LinearMap.id : (Fin 4 → F) →ₗ[F] (Fin 4 → F))
      (Pi.single 2 1) := by
    rw [LinearMap.sub_apply, LinearMap.sub_apply, e266_shortRoot4_apply]
    simpa using hs_eq
  have hb3 : (T'.toLinearMap - LinearMap.id : (Fin 4 → F) →ₗ[F] (Fin 4 → F))
      (Pi.single 3 1) = (shortRoot4 a - LinearMap.id : (Fin 4 → F) →ₗ[F] (Fin 4 → F))
      (Pi.single 3 1) := by
    rw [LinearMap.sub_apply, LinearMap.sub_apply, e266_shortRoot4_apply]
    simpa using hr_eq
  have hlin : (T'.toLinearMap - LinearMap.id : (Fin 4 → F) →ₗ[F] (Fin 4 → F)) =
      (shortRoot4 a - LinearMap.id : (Fin 4 → F) →ₗ[F] (Fin 4 → F)) := by
    refine (Pi.basisFun F (Fin 4)).ext fun i => ?_
    fin_cases i
    · simpa using hb0
    · simpa using hb1
    · simpa using hb2
    · simpa using hb3
  have hTsh : ∀ v, T' v = shortRoot4 a v := by
    intro v
    have := LinearMap.congr_fun hlin v
    simpa using this
  have ha0 : a ≠ 0 := by
    intro h0
    obtain ⟨y, hy⟩ := hy0
    apply e266_pi_single_ne_zero (F := F) 0
    rw [← hy, hTsh, e266_shortRoot4_apply, h0]
    simp
  refine ⟨g, a, hg, ha0, Or.inr fun v => ?_⟩
  have h := hTsh (g.symm v)
  rw [hT', LinearEquiv.apply_symm_apply] at h
  rw [← h, LinearEquiv.apply_symm_apply]

theorem e266_main [CharP F 2] (t : (Fin 4 → F) ≃ₗ[F] (Fin 4 → F)) (ht : IsInSp4 t)
    (hsq : ∀ v, t (t v) = v) (hne : t ≠ LinearEquiv.refl F (Fin 4 → F)) :
    (IsRootInvolution4 t ↔ (IsSuzukiTypeB sympForm4 t 1 ∨ IsSuzukiTypeA sympForm4 t 2)) ∧
      (¬ IsRootInvolution4 t ↔ IsSuzukiTypeC sympForm4 t 2) := by
  obtain ⟨hr1, hr2⟩ := e266_rank_bounds t hsq hne
  have key : IsRootInvolution4 t ↔
      (Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) = 1 ∨
        (Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) = 2 ∧
          ∀ v, sympForm4 v (t v) = 0)) := by
    constructor
    · exact e266_L4 t
    · rintro (h | ⟨h, hA⟩)
      · exact e266_root_of_rank_one t ht h
      · exact e266_root_of_lagrangian t ht hsq hA h
  have hB : IsSuzukiTypeB sympForm4 t 1 ↔
      Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) = 1 := by
    simp [IsSuzukiTypeB, suzukiDim]
  have hA : IsSuzukiTypeA sympForm4 t 2 ↔
      (Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) = 2 ∧
        ∀ v, sympForm4 v (t v) = 0) := by
    simp [IsSuzukiTypeA, suzukiDim]
  have hC : IsSuzukiTypeC sympForm4 t 2 ↔
      (Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) = 2 ∧
        ∃ v, sympForm4 v (t v) ≠ 0) := by
    simp [IsSuzukiTypeC, suzukiDim]
  refine ⟨?_, ?_⟩
  · rw [key, hB, hA]
  · rw [hC]
    constructor
    · intro hnP
      have hne1 : Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) ≠ 1 :=
        fun h1 => hnP (key.mpr (Or.inl h1))
      have hr2' : Module.finrank F (LinearMap.range (t.toLinearMap - LinearMap.id)) = 2 := by
        omega
      refine ⟨hr2', ?_⟩
      by_contra hcon
      push Not at hcon
      exact hnP (key.mpr (Or.inr ⟨hr2', hcon⟩))
    · rintro ⟨h2, v, hv⟩ hP
      rcases key.mp hP with h1 | ⟨_, hA'⟩
      · omega
      · exact hv (hA' v)

theorem as_E_2_6 : E_2_6 := by
  intro F _ _ _ t ht hsq hne
  exact e266_main t ht hsq hne

end E266

