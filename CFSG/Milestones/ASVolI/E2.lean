@[expose] def E_2_1 : Prop :=
  ∀ (Γ : Type) [Group Γ] [Finite Γ] (H T M : Subgroup Γ), MinParabolic H T M → SQTKGroup ↥H →
    Group.IsSolvable ↥H →
    (¬ pCoreOf 2 M ≤ pCoreOf 2 H ∨
      ∃ t ∈ T, (∀ j ∈ kerIn M H, t * j * t⁻¹ * j⁻¹ ∈ pCoreOf 2 (kerIn M H)) ∧
        t ∉ pCoreOf 2 H) →
    ∃ p : ℕ, p.Prime ∧ p ≠ 2 ∧
      (Nonempty (twoResidual (⊤ : Subgroup (↥H ⧸ CFSG.pCore 2 ↥H)) ≃* Multiplicative (ZMod p)) ∨
        IsElemAbelianOfRank p 2 (twoResidual (⊤ : Subgroup (↥H ⧸ CFSG.pCore 2 ↥H))) ∨
        IsPOnePlusTwo p (twoResidual (⊤ : Subgroup (↥H ⧸ CFSG.pCore 2 ↥H))))

private theorem e21_map_pCoreOf_subgroupOf {Γ : Type} [Group Γ] {H K : Subgroup Γ} (hKH : K ≤ H) :
    (pCoreOf 2 (K.subgroupOf H)).map H.subtype = pCoreOf 2 K := by
  let e : ↥(K.subgroupOf H) ≃* ↥K := Subgroup.subgroupOfEquivOfLe hKH
  have h1 := CFSG.pCore_map_iso 2 e
  unfold pCoreOf
  rw [Subgroup.map_map, ← h1, Subgroup.map_map]
  congr 1

private theorem e21_mem_pCoreOf_subgroupOf {Γ : Type} [Group Γ] {H K : Subgroup Γ} (hKH : K ≤ H)
    (x : ↥H) : x ∈ pCoreOf 2 (K.subgroupOf H) ↔ (x : Γ) ∈ pCoreOf 2 K := by
  rw [← e21_map_pCoreOf_subgroupOf hKH]
  exact (Subgroup.mem_map_iff_mem H.subtype_injective).symm

private theorem e21_pCoreOf_le_of_subgroupOf {Γ : Type} [Group Γ] {H M : Subgroup Γ}
    (hMH : M ≤ H) (hle : pCoreOf 2 (M.subgroupOf H) ≤ CFSG.Open.pCore 2 ↥H) :
    pCoreOf 2 M ≤ pCoreOf 2 H := by
  rw [← e21_map_pCoreOf_subgroupOf hMH]
  exact Subgroup.map_mono hle

private theorem e21_hR_transport {Γ : Type} [Group Γ] {H T M : Subgroup Γ}
    (h : MinParabolic H T M)
    (hR : ¬ pCoreOf 2 M ≤ pCoreOf 2 H ∨
      ∃ t ∈ T, (∀ j ∈ kerIn M H, t * j * t⁻¹ * j⁻¹ ∈ pCoreOf 2 (kerIn M H)) ∧
        t ∉ pCoreOf 2 H) :
    ¬ pCoreOf 2 (M.subgroupOf H) ≤ CFSG.Open.pCore 2 ↥H ∨
      ∃ t ∈ T.subgroupOf H, (∀ j ∈ kerIn (M.subgroupOf H) ⊤,
        t * j * t⁻¹ * j⁻¹ ∈ pCoreOf 2 (kerIn (M.subgroupOf H) ⊤)) ∧
        t ∉ CFSG.Open.pCore 2 ↥H := by
  have hMH : M ≤ H := h.maximal.1.le
  have hTH : T ≤ H := h.le.trans hMH
  have hKH : kerIn M H ≤ H := (CFSG.Quasithin.kerIn_le).trans hMH
  rcases hR with hA | ⟨t, ht, hJ, htH⟩
  · left
    intro hle
    exact hA (e21_pCoreOf_le_of_subgroupOf hMH hle)
  · right
    refine ⟨⟨t, hTH ht⟩, Subgroup.mem_subgroupOf.2 ht, fun j hj => ?_, fun ht' => ?_⟩
    · rw [CFSG.Quasithin.B6.kerIn_subgroupOf_top] at hj ⊢
      rw [e21_mem_pCoreOf_subgroupOf hKH]
      have hj' : (j : Γ) ∈ kerIn M H := Subgroup.mem_subgroupOf.1 hj
      simpa using hJ (j : Γ) hj'
    · apply htH
      unfold pCoreOf
      exact Subgroup.mem_map.2 ⟨⟨t, hTH ht⟩, ht', rfl⟩

theorem as_E_2_1 : E_2_1 := by
  intro Γ _ _ H T M h hSQ hsolv hR
  have hSQT : ∀ p : ℕ, p.Prime → p ≠ 2 → CFSG.Open.pRank p H ≤ 2 := by
    intro p hp hp2
