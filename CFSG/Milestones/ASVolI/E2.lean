    refine (Subgroup.closure_le _).mpr ?_
    intro a ha
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
    rintro b hb
    rw [Set.mem_singleton_iff.mp hb]
    rcases ha with rfl | ha
    · exact hxz.symm
    · rw [Set.mem_singleton_iff.mp ha]; exact hyz.symm
  intro g hg
  have := Subgroup.mem_centralizer_iff.mp (h hg) z (Set.mem_singleton z)
  exact this.symm

private theorem e216_centerOf_of_equiv {Γ G : Type} [Group Γ] [Group G] {S : Subgroup Γ}
    {z : Γ} (hzS : z ∈ S) (hz1 : z ≠ 1) (hzc : ∀ g ∈ S, g * z = z * g)
    (e : ↥S ≃* G) {c : G} (hc : ∀ u : G, (∀ v : G, v * u = u * v) → u = 1 ∨ u = c) :
    CFSG.Quasithin.centerOf S = Subgroup.zpowers z := by
  have hzz : (⟨z, hzS⟩ : ↥S) ≠ 1 := fun h => hz1 (congrArg Subtype.val h)
  have hcen_of : ∀ w : ↥S, (∀ v : ↥S, v * w = w * v) → (e w = 1 ∨ e w = c) := by
    intro w hw
    apply hc
    intro v
    obtain ⟨v', rfl⟩ := e.surjective v
    rw [← map_mul, ← map_mul, hw v']
  have hzcen : ∀ v : ↥S, v * ⟨z, hzS⟩ = ⟨z, hzS⟩ * v := by
    intro v
    apply Subtype.ext
    exact hzc v.1 v.2
  have hez : e ⟨z, hzS⟩ = c := by
    rcases hc (e ⟨z, hzS⟩) (by
      intro v
      obtain ⟨v', rfl⟩ := e.surjective v
      rw [← map_mul, ← map_mul, hzcen v']) with h | h
    · exact absurd (e.injective (h.trans (map_one e).symm)) hzz
    · exact h
  have hzcent : z ∈ Subgroup.centralizer (S : Set Γ) :=
    Subgroup.mem_centralizer_iff.mpr hzc
  have hzmem : z ∈ CFSG.Quasithin.centerOf S := Subgroup.mem_inf.mpr ⟨hzS, hzcent⟩
  ext g
  constructor
  · rintro ⟨hgS, hgc⟩
    have hcomm : ∀ v : ↥S, v * ⟨g, hgS⟩ = ⟨g, hgS⟩ * v := by
      intro v
      apply Subtype.ext
      exact Subgroup.mem_centralizer_iff.mp hgc v.1 v.2
    rcases hcen_of ⟨g, hgS⟩ hcomm with h | h
    · have : (⟨g, hgS⟩ : ↥S) = 1 := e.injective (h.trans (map_one e).symm)
      have hg1 : g = 1 := congrArg Subtype.val this
      rw [hg1]; exact Subgroup.one_mem _
    · have : (⟨g, hgS⟩ : ↥S) = ⟨z, hzS⟩ := e.injective (h.trans hez.symm)
      have hgz : g = z := congrArg Subtype.val this
      rw [hgz]; exact Subgroup.mem_zpowers z
  · intro hg
    exact (Subgroup.zpowers_le.mpr hzmem) hg

private theorem e216_sq_eq_one {Γ : Type} [Group Γ] {z : Γ} (hz2 : orderOf z = 2) : z ^ 2 = 1 := by
  rw [← hz2]; exact pow_orderOf_eq_one z

private theorem e216_ne_one {Γ : Type} [Group Γ] {z : Γ} (hz2 : orderOf z = 2) : z ≠ 1 := by
  intro h; rw [h, orderOf_one] at hz2; exact absurd hz2 (by norm_num)

private theorem e216_dih_aux {Γ : Type} [Group Γ] [Finite Γ] {x y z : Γ} (hz2 : orderOf z = 2)
    (hcomm : ⁅x, y⁆ = z) (hx : x ^ 2 = 1) (hy : y ^ 2 = z) :
    Nonempty (↥(Subgroup.closure ({x, y} : Set Γ)) ≃* DihedralGroup 4) := by
  have hz1 : z ≠ 1 := e216_ne_one hz2
  have hzz : z ^ 2 = 1 := e216_sq_eq_one hz2
  have h0 : x * y * x⁻¹ = z * y := by
    rw [← hcomm, commutatorElement_def]; group
  have hrel : x * y * x⁻¹ = y⁻¹ := by
    rw [h0, ← hy, eq_inv_iff_mul_eq_one]
    calc y ^ 2 * y * y = y ^ 4 := by group
      _ = 1 := by rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, hy, hzz]
  have hsn : x ∉ Subgroup.zpowers y := by
    intro hmem
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hmem
    have hc : ⁅x, y⁆ = 1 := by
      rw [commutatorElement_eq_one_iff_mul_comm, ← hk]
      exact ((Commute.refl y).zpow_left k).eq
    rw [hcomm] at hc
    exact hz1 hc
  have hord : orderOf y = 4 := by
    have h4 : orderOf y = 2 ^ (1 + 1) := orderOf_eq_prime_pow (p := 2) (n := 1) (by
        rw [pow_one, hy]; exact hz1) (by
        rw [show 2 ^ (1 + 1) = 2 * 2 from rfl, pow_mul, hy, hzz])
    rw [h4]; norm_num
  obtain ⟨e⟩ := CFSG.RankThree.Literature.nonempty_closure_mulEquiv_dihedralGroup
    (ρ := y) (σ := x) hx hrel hsn
  rw [Set.pair_comm, hord] at e
  exact ⟨e⟩

private theorem e216_dih_one {Γ : Type} [Group Γ] [Finite Γ] {x y z : Γ} (hz2 : orderOf z = 2)
    (hcomm : ⁅x, y⁆ = z) (hx : x ^ 2 = 1) (hy : y ^ 2 = 1) :
    Nonempty (↥(Subgroup.closure ({x, y} : Set Γ)) ≃* DihedralGroup 4) := by
  have hz1 : z ≠ 1 := e216_ne_one hz2
  have hxi : x⁻¹ = x := inv_eq_of_mul_eq_one_right (by rw [← sq, hx])
  have hyi : y⁻¹ = y := inv_eq_of_mul_eq_one_right (by rw [← sq, hy])
  have hxyz : (x * y) ^ 2 = z := by
    rw [← hcomm, commutatorElement_def, hxi, hyi, sq]; simp only [mul_assoc]
  have hrel : x * (x * y) * x⁻¹ = (x * y)⁻¹ := by
    rw [mul_inv_rev, hyi, hxi]
    calc x * (x * y) * x = (x * x) * y * x := by group
      _ = y * x := by rw [← sq, hx, one_mul]
  have hsn : x ∉ Subgroup.zpowers (x * y) := by
    intro hmem
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hmem
    have h1 : Commute ((x * y) ^ k) (x * y) := (Commute.refl (x * y)).zpow_left k
    rw [hk] at h1
    have hcm : Commute x (x * y) := h1
    have hc2 : x * y = y * x := mul_left_cancel (a := x) (by rw [hcm.eq, mul_assoc])
    have hc : ⁅x, y⁆ = 1 := commutatorElement_eq_one_iff_mul_comm.mpr hc2
    rw [hcomm] at hc
    exact hz1 hc
  have hord : orderOf (x * y) = 4 := by
    have h4 : orderOf (x * y) = 2 ^ (1 + 1) := orderOf_eq_prime_pow (p := 2) (n := 1) (by
        rw [pow_one, hxyz]; exact hz1) (by
        rw [show 2 ^ (1 + 1) = 2 * 2 from rfl, pow_mul, hxyz, e216_sq_eq_one hz2])
    rw [h4]; norm_num
  obtain ⟨e⟩ := CFSG.RankThree.Literature.nonempty_closure_mulEquiv_dihedralGroup
    (ρ := x * y) (σ := x) hx hrel hsn
  have hS : Subgroup.closure ({x * y, x} : Set Γ) = Subgroup.closure ({x, y} : Set Γ) := by
    apply le_antisymm
    · refine (Subgroup.closure_le _).mpr ?_
      intro a ha
      rcases ha with rfl | ha
      · exact Subgroup.mul_mem _ (Subgroup.subset_closure (by simp))
          (Subgroup.subset_closure (by simp))
      · rw [Set.mem_singleton_iff.mp ha]; exact Subgroup.subset_closure (by simp)
    · refine (Subgroup.closure_le _).mpr ?_
      intro a ha
      rcases ha with rfl | ha
      · exact Subgroup.subset_closure (by simp)
      · have hy' : y = x⁻¹ * (x * y) := by group
        rw [Set.mem_singleton_iff.mp ha, hy']
        exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (Subgroup.subset_closure (by simp)))
          (Subgroup.subset_closure (by simp))
  rw [hS, hord] at e
  exact ⟨e⟩

private theorem e216_pair {Γ : Type} [Group Γ] [Finite Γ] {x y z : Γ} (hz2 : orderOf z = 2)
    (hxz : x * z = z * x) (hyz : y * z = z * y) (hcomm : ⁅x, y⁆ = z)
    (hx2 : x ^ 2 = 1 ∨ x ^ 2 = z) (hy2 : y ^ 2 = 1 ∨ y ^ 2 = z) :
    (x ^ 2 = z ∧ y ^ 2 = z ∧ Nonempty (↥(Subgroup.closure ({x, y} : Set Γ)) ≃* QuaternionGroup 2)
        ∧ CFSG.Quasithin.centerOf (Subgroup.closure ({x, y} : Set Γ)) = Subgroup.zpowers z) ∨
    (¬ (x ^ 2 = z ∧ y ^ 2 = z) ∧
        Nonempty (↥(Subgroup.closure ({x, y} : Set Γ)) ≃* DihedralGroup 4) ∧
        CFSG.Quasithin.centerOf (Subgroup.closure ({x, y} : Set Γ)) = Subgroup.zpowers z) := by
  have hz1 : z ≠ 1 := e216_ne_one hz2
  have hzz : z * z = 1 := by rw [← sq]; exact e216_sq_eq_one hz2
  have hcS : ∀ g ∈ Subgroup.closure ({x, y} : Set Γ), g * z = z * g :=
    e216_comm_closure hxz hyz
  have hzS : z ∈ Subgroup.closure ({x, y} : Set Γ) := by
    rw [← hcomm, commutatorElement_def]
    have hx : x ∈ Subgroup.closure ({x, y} : Set Γ) := Subgroup.subset_closure (by simp)
    have hy : y ∈ Subgroup.closure ({x, y} : Set Γ) := Subgroup.subset_closure (by simp)
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hx hy)
      (Subgroup.inv_mem _ hx)) (Subgroup.inv_mem _ hy)
  by_cases hQ : x ^ 2 = z ∧ y ^ 2 = z
  · obtain ⟨hx, hy⟩ := hQ
    have hxx : x * x = z := by rw [← sq]; exact hx
    have hyy : y * y = z := by rw [← sq]; exact hy
    obtain ⟨e⟩ := CFSG.Quasithin.H13.Q8Pow.nonempty_closure_mulEquiv_q8 hxx hyy hz1 hzz hcomm
    exact Or.inl ⟨hx, hy, ⟨e⟩, e216_centerOf_of_equiv hzS hz1 hcS e
      (fun u hu => e216_q8_center u hu)⟩
  · have hD : ∀ e : ↥(Subgroup.closure ({x, y} : Set Γ)) ≃* DihedralGroup 4,
        CFSG.Quasithin.centerOf (Subgroup.closure ({x, y} : Set Γ)) = Subgroup.zpowers z := by
      intro e
      exact e216_centerOf_of_equiv hzS hz1 hcS e (fun u hu => e216_d8_center u hu)
    refine Or.inr ⟨hQ, ?_⟩
    rcases hx2 with hx | hx <;> rcases hy2 with hy | hy
    · obtain ⟨e⟩ := e216_dih_one hz2 hcomm hx hy
      exact ⟨⟨e⟩, hD e⟩
    · obtain ⟨e⟩ := e216_dih_aux hz2 hcomm hx hy
      exact ⟨⟨e⟩, hD e⟩
    · have hcomm' : ⁅y, x⁆ = z := by
        rw [← commutatorElement_inv, hcomm]; exact inv_eq_of_mul_eq_one_right hzz
      obtain ⟨e0⟩ := e216_dih_aux hz2 hcomm' hy hx
      have hS : Subgroup.closure ({y, x} : Set Γ) = Subgroup.closure ({x, y} : Set Γ) :=
        by rw [Set.pair_comm]
      rw [hS] at e0
      exact ⟨⟨e0⟩, hD (Classical.choice ⟨e0⟩)⟩
    · exact absurd ⟨hx, hy⟩ hQ

private theorem e216_mem_zpowers_two {Γ : Type} [Group Γ] {z g : Γ} (hz2 : orderOf z = 2)
    (hg : g ∈ Subgroup.zpowers z) : g = 1 ∨ g = z := by
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg
  have h2 : (k % ((orderOf z : ℕ) : ℤ)) = k % 2 := by rw [hz2]; norm_num
  rcases Int.emod_two_eq_zero_or_one k with h | h
  · left; rw [← zpow_mod_orderOf, h2, h, zpow_zero]
  · right; rw [← zpow_mod_orderOf, h2, h, zpow_one]

private theorem e216_comm_closure_gen {Γ : Type} [Group Γ] {x : Γ} {S : Set Γ}
    (hS : ∀ s ∈ S, s * x = x * s) : ∀ h ∈ Subgroup.closure S, h * x = x * h := by
  have h : Subgroup.closure S ≤ Subgroup.centralizer ({x} : Set Γ) :=
    (Subgroup.closure_le _).mpr (fun s hs =>
      Subgroup.mem_centralizer_iff.mpr (by
        rintro b hb
        rw [Set.mem_singleton_iff.mp hb]
        exact (hS s hs).symm))
  intro g hg
  exact (Subgroup.mem_centralizer_iff.mp (h hg) x (Set.mem_singleton x)).symm

private theorem e216_commutator_gen {Γ : Type} [Group Γ] {S T : Set Γ}
    (h : ∀ s ∈ S, ∀ t ∈ T, t * s = s * t) :
    ⁅Subgroup.closure S, Subgroup.closure T⁆ = ⊥ := by
  rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
  refine (Subgroup.closure_le _).mpr (fun s hs => ?_)
  rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
  exact e216_comm_closure_gen (fun t ht => h s hs t ht)

private theorem e216_centerOf_card {Γ : Type} [Group Γ] [Finite Γ] {X : Subgroup Γ}
    (h2 : Nat.card (CFSG.Quasithin.centerOf X) = 2) :
    ∃ z : Γ, z ∈ X ∧ orderOf z = 2 ∧ CFSG.Quasithin.centerOf X = Subgroup.zpowers z := by
  have hnt : Nontrivial (CFSG.Quasithin.centerOf X) := by
    rw [← Finite.one_lt_card_iff_nontrivial, h2]; norm_num
  obtain ⟨u, hu⟩ := exists_ne (1 : CFSG.Quasithin.centerOf X)
  have hzZ : (u : Γ) ∈ CFSG.Quasithin.centerOf X := u.2
  have hz1 : (u : Γ) ≠ 1 := fun h => hu (Subtype.ext h)
  have hord_dvd : orderOf (u : Γ) ∣ 2 := by
    have := orderOf_dvd_natCard (⟨(u : Γ), hzZ⟩ : CFSG.Quasithin.centerOf X)
    rwa [Subgroup.orderOf_mk, h2] at this
  have hz2 : orderOf (u : Γ) = 2 := by
    rcases (Nat.dvd_prime Nat.prime_two).mp hord_dvd with h | h
    · exact absurd (orderOf_eq_one_iff.mp h) hz1
    · exact h
  have hle : Subgroup.zpowers (u : Γ) ≤ CFSG.Quasithin.centerOf X := Subgroup.zpowers_le.mpr hzZ
  have hZeq : CFSG.Quasithin.centerOf X = Subgroup.zpowers (u : Γ) :=
    (Subgroup.eq_of_le_of_card_ge hle (by rw [Nat.card_zpowers, hz2, h2])).symm
  exact ⟨u, (Subgroup.mem_inf.mp hzZ).1, hz2, hZeq⟩

private theorem e216_sq_mem_frattiniIn {Γ : Type} [Group Γ] [Finite Γ] {X : Subgroup Γ}
    (hX : IsPGroup 2 X) (a : X) : (a : Γ) ^ 2 ∈ CFSG.Quasithin.frattiniIn X := by
  have h1 := (CFSG.GroupTheory.frattini_elementary_quotient (p := 2) hX).2.2.1
    (QuotientGroup.mk a : X ⧸ frattini X)
  rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff] at h1
  have h2 : ((a ^ 2 : X) : Γ) ∈ (frattini X).map X.subtype := Subgroup.mem_map_of_mem X.subtype h1
  rw [Subgroup.coe_pow] at h2
  exact h2

private theorem e216_gen {P : Type} [Group P] [Finite P] {z : P}
    (H : CFSG.LocalAnalysis.GorensteinLyons.CommPairHyp P z) :
    ∃ (m : ℕ) (L : Fin m ⊕ Fin m → P),
      (∀ k k', ⁅L k, L k'⁆ = z ^ (Matrix.J (Fin m) (ZMod 2) k k').val) ∧
      (∀ Y : Subgroup P, (∀ k, L k ∈ Y) → Y ⊔ Subgroup.center P = ⊤) := by
  classical
  haveI := H.isElementaryAbelian_quotient
  obtain ⟨m, bs, _, hJ⟩ := H.exists_symplectic_basis
  let L : Fin m ⊕ Fin m → P := fun k => Quotient.out (Additive.toMul (bs k))
  have hLq : ∀ k, ((L k : P) : P ⧸ Subgroup.center P) = Additive.toMul (bs k) :=
    fun k => QuotientGroup.out_eq' _
  refine ⟨m, L, ?_, ?_⟩
  · intro k k'
    have h := H.commutatorElement_eq_zpow (L k) (L k')
    rw [hLq, hLq] at h
    rw [h, ← H.commForm_apply, hJ]
  · intro Y hY
    let W : Subgroup (P ⧸ Subgroup.center P) := Y.map (QuotientGroup.mk' (Subgroup.center P))
    have hW : ∀ k, Additive.toMul (bs k) ∈ W := fun k =>
      Subgroup.mem_map.mpr ⟨L k, hY k, hLq k⟩
    let T : Submodule (ZMod 2) (Additive (P ⧸ Subgroup.center P)) :=
      { carrier := {v | Additive.toMul v ∈ W}
        add_mem' := fun {a b} ha hb => by
          show Additive.toMul (a + b) ∈ W
          exact W.mul_mem ha hb
        zero_mem' := W.one_mem
        smul_mem' := fun c v hv => by
          have hc : c = 0 ∨ c = 1 := by revert c; decide
          rcases hc with rfl | rfl
          · simp only [zero_smul]; exact W.one_mem
          · simp only [one_smul]; exact hv }
    have hTtop : T = ⊤ := by
      rw [eq_top_iff, ← bs.span_eq, Submodule.span_le]
      rintro _ ⟨k, rfl⟩
      exact hW k
    have hWtop : W = ⊤ := by
      ext g
      simp only [Subgroup.mem_top, iff_true]
      have hmem : Additive.ofMul g ∈ T := by rw [hTtop]; exact Submodule.mem_top
      exact hmem
    rw [eq_top_iff]
    intro g _
    have hg : (QuotientGroup.mk g : P ⧸ Subgroup.center P) ∈ W := by
      rw [hWtop]; exact Subgroup.mem_top _
    obtain ⟨y, hy, hyg⟩ := Subgroup.mem_map.mp hg
    have hyg' : y⁻¹ * g ∈ Subgroup.center P := (QuotientGroup.eq (s := Subgroup.center P)).mp hyg
    have := Subgroup.mul_mem_sup hy hyg'
    rwa [mul_inv_cancel_left] at this

private theorem e216_comm_mem {Γ : Type} [Group Γ] (x y : Γ) :
    ⁅x, y⁆ ∈ Subgroup.closure ({x, y} : Set Γ) := by
  rw [commutatorElement_def]
  have hx : x ∈ Subgroup.closure ({x, y} : Set Γ) := Subgroup.subset_closure (Set.mem_insert _ _)
  have hy : y ∈ Subgroup.closure ({x, y} : Set Γ) :=
    Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hx hy)
    (Subgroup.inv_mem _ hx)) (Subgroup.inv_mem _ hy)

private theorem e216_center_mem {Γ : Type} [Group Γ] {X : Subgroup Γ} (g : X)
    (hg : g ∈ Subgroup.center X) : (g : Γ) ∈ CFSG.Quasithin.centerOf X := by
  refine Subgroup.mem_inf.mpr ⟨g.2, Subgroup.mem_centralizer_iff.mpr (fun h hh => ?_)⟩
  have := Subgroup.mem_center_iff.mp hg ⟨h, hh⟩
  exact congrArg Subtype.val this

private theorem e216_commPair {Γ : Type} [Group Γ] [Finite Γ] {X : Subgroup Γ} {z : Γ}
    (hX : IsPGroup 2 X) (hzX : z ∈ X) (hz2 : orderOf z = 2)
    (hZ : CFSG.Quasithin.centerOf X = Subgroup.zpowers z)
    (hcomm : ⁅X, X⁆ = CFSG.Quasithin.frattiniIn X)
    (hfr : CFSG.Quasithin.frattiniIn X = CFSG.Quasithin.centerOf X) :
    CFSG.LocalAnalysis.GorensteinLyons.CommPairHyp X ⟨z, hzX⟩ := by
  have hzZ : z ∈ CFSG.Quasithin.centerOf X := by rw [hZ]; exact Subgroup.mem_zpowers z
  have hzc : z ∈ Subgroup.centralizer (X : Set Γ) := (Subgroup.mem_inf.mp hzZ).2
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [Subgroup.mem_center_iff]
    intro g
    apply Subtype.ext
    exact Subgroup.mem_centralizer_iff.mp hzc g.1 g.2
  · rw [Subgroup.orderOf_mk]; exact hz2
  · intro a b
    have hmem : ⁅(a : Γ), (b : Γ)⁆ ∈ Subgroup.zpowers z := by
      have := Subgroup.commutator_mem_commutator a.2 b.2
      rw [hcomm, hfr, hZ] at this
      exact this
    rcases e216_mem_zpowers_two hz2 hmem with h | h
    · left
      apply Subtype.ext
      simp only [commutatorElement_def, Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_one] at h ⊢
      exact h
    · right
      apply Subtype.ext
      simp only [commutatorElement_def, Subgroup.coe_mul, Subgroup.coe_inv] at h ⊢
      exact h
  · intro a
    rw [Subgroup.mem_center_iff]
    intro g
    apply Subtype.ext
    have hsq : (a : Γ) ^ 2 ∈ CFSG.Quasithin.centerOf X := by
      rw [← hfr]; exact e216_sq_mem_frattiniIn hX a
    have hc := (Subgroup.mem_inf.mp hsq).2
    simp only [Subgroup.coe_mul, Subgroup.coe_pow]
    exact Subgroup.mem_centralizer_iff.mp hc g.1 g.2

private theorem e216_main {Γ : Type} [Group Γ] [Finite Γ] {X : Subgroup Γ} (hX : IsPGroup 2 X)
    (hcomm : ⁅X, X⁆ = CFSG.Quasithin.frattiniIn X)
    (hfr : CFSG.Quasithin.frattiniIn X = CFSG.Quasithin.centerOf X)
    (h2 : Nat.card (CFSG.Quasithin.centerOf X) = 2) :
    ∃ m n : ℕ, ChE.IsCentralProductQ8D8 X m n := by
  classical
  obtain ⟨z, hzX, hz2, hZ⟩ := e216_centerOf_card h2
  have hzZ : z ∈ CFSG.Quasithin.centerOf X := by rw [hZ]; exact Subgroup.mem_zpowers z
  have hzc : z ∈ Subgroup.centralizer (X : Set Γ) := (Subgroup.mem_inf.mp hzZ).2
  have H := e216_commPair hX hzX hz2 hZ hcomm hfr
  obtain ⟨m, L, hLc, hLg⟩ := e216_gen H
  have hLc' : ∀ k k', ⁅((L k : X) : Γ), ((L k' : X) : Γ)⁆ =
      z ^ (Matrix.J (Fin m) (ZMod 2) k k').val := by
    intro k k'
    have h := congrArg Subtype.val (hLc k k')
    simp only [commutatorElement_def, Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_pow] at h ⊢
    exact h
  obtain ⟨a, ha⟩ : ∃ a : Fin m → Γ, ∀ i, a i = ((L (Sum.inl i) : X) : Γ) :=
    ⟨fun i => ((L (Sum.inl i) : X) : Γ), fun i => rfl⟩
  obtain ⟨c, hc⟩ : ∃ c : Fin m → Γ, ∀ i, c i = ((L (Sum.inr i) : X) : Γ) :=
    ⟨fun i => ((L (Sum.inr i) : X) : Γ), fun i => rfl⟩
  have haX : ∀ i, a i ∈ X := fun i => by rw [ha]; exact (L _).2
  have hcX : ∀ i, c i ∈ X := fun i => by rw [hc]; exact (L _).2
  have hAA : ∀ i i', ⁅a i, a i'⁆ = 1 := fun i i' => by
    rw [ha, ha, hLc', J_inl_inl, ZMod.val_zero, pow_zero]
  have hCC : ∀ i i', ⁅c i, c i'⁆ = 1 := fun i i' => by
    rw [hc, hc, hLc', J_inr_inr, ZMod.val_zero, pow_zero]
  have hAC_diff : ∀ i i', i ≠ i' → ⁅a i, c i'⁆ = 1 := fun i i' hne => by
    rw [ha, hc, hLc', J_inl_inr, if_neg hne, ZMod.val_zero, pow_zero]
  have hCA_diff : ∀ i i', i ≠ i' → ⁅c i, a i'⁆ = 1 := fun i i' hne => by
    rw [hc, ha, hLc', J_inr_inl, if_neg hne, ZMod.val_zero, pow_zero]
  have hAC_same : ∀ i, ⁅a i, c i⁆ = z := fun i => by
    rw [ha, hc, hLc', J_inl_inr, if_pos rfl]
    have hv : (1 : ZMod 2).val = 1 := rfl
    rw [hv, pow_one]
  have hxz : ∀ i, a i * z = z * a i := fun i => Subgroup.mem_centralizer_iff.mp hzc (a i) (haX i)
  have hyz : ∀ i, c i * z = z * c i := fun i => Subgroup.mem_centralizer_iff.mp hzc (c i) (hcX i)
  have hsq : ∀ i, a i ^ 2 ∈ Subgroup.zpowers z ∧ c i ^ 2 ∈ Subgroup.zpowers z := by
    intro i
    have h1 := e216_center_mem _ (H.sq_mem_center (L (Sum.inl i)))
    have h2' := e216_center_mem _ (H.sq_mem_center (L (Sum.inr i)))
