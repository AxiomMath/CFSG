    (∀ L : Subgroup G, CFSG.Open.IsComponentOf L H → Nonempty (↥L ≃* ↥L₁) →
      L = L₁ ∨ L = L₂) ∧ CFSG.Quasithin.A134TypesCentral ↥L₁ := by
  obtain ⟨hA2, hA3⟩ := burnsideA134_X hF hG hK h₁ h₂ hne e
  let e₁ : ↥(L₁.subgroupOf H) ≃* ↥L₁ := Subgroup.subgroupOfEquivOfLe h₁.1
  refine ⟨fun L hL ⟨eL⟩ => ?_, ?_⟩
  · have hL' := burnsideA134_isComponent_subgroupOf hL
    let eL' : ↥(L.subgroupOf H) ≃* ↥L := Subgroup.subgroupOfEquivOfLe hL.1
    have := hA2 (L.subgroupOf H) hL' ⟨eL'.trans (eL.trans e₁.symm)⟩
    rcases this with h | h
    · left
      have := Subgroup.subgroupOf_inj.mp h
      rwa [inf_of_le_left hL.1, inf_of_le_left h₁.1] at this
    · right
      have := Subgroup.subgroupOf_inj.mp h
      rwa [inf_of_le_left hL.1, inf_of_le_left h₂.1] at this
  · obtain ⟨c⟩ := burnsideA134_centerQuotient_nonempty e₁
    exact CFSG.Quasithin.A38.A134Types.of_mulEquiv c.symm hA3

private theorem burnsideA134_mem_sup_of_commute {X : Type*} [Group X] {A B : Subgroup X}
    (hc : ∀ a ∈ A, ∀ b ∈ B, Commute a b) {x : X} (hx : x ∈ A ⊔ B) :
    ∃ a ∈ A, ∃ b ∈ B, x = a * b := by
  let P : Subgroup X :=
    { carrier := {x | ∃ a ∈ A, ∃ b ∈ B, x = a * b}
      one_mem' := ⟨1, A.one_mem, 1, B.one_mem, by simp⟩
      mul_mem' := by
        rintro _ _ ⟨a₁, ha₁, b₁, hb₁, rfl⟩ ⟨a₂, ha₂, b₂, hb₂, rfl⟩
        refine ⟨a₁ * a₂, A.mul_mem ha₁ ha₂, b₁ * b₂, B.mul_mem hb₁ hb₂, ?_⟩
        have h := (hc a₂ ha₂ b₁ hb₁).eq
        calc a₁ * b₁ * (a₂ * b₂) = a₁ * (b₁ * a₂) * b₂ := by group
          _ = a₁ * (a₂ * b₁) * b₂ := by rw [h]
          _ = a₁ * a₂ * (b₁ * b₂) := by group
      inv_mem' := by
        rintro _ ⟨a, ha, b, hb, rfl⟩
        refine ⟨a⁻¹, A.inv_mem ha, b⁻¹, B.inv_mem hb, ?_⟩
        rw [mul_inv_rev]
        exact ((hc a ha b hb).inv_inv).eq.symm }
  have hle : A ⊔ B ≤ P := sup_le (fun a ha => ⟨a, ha, 1, B.one_mem, by simp⟩)
    (fun b hb => ⟨1, A.one_mem, b, hb, by simp⟩)
  exact hle hx

private theorem burnsideA134_exists_pow_two_of_center {X : Type*} [Group X] {A : Subgroup X}
    (hZ : IsPGroup 2 (Subgroup.center ↥A)) {a : X} (ha : a ∈ A) (hc : ∀ g ∈ A, g * a = a * g) :
    ∃ k : ℕ, a ^ 2 ^ k = 1 := by
  have hmem : (⟨a, ha⟩ : ↥A) ∈ Subgroup.center ↥A :=
    Subgroup.mem_center_iff.mpr fun g => Subtype.ext (hc g g.2)
  obtain ⟨k, hk⟩ := hZ ⟨⟨a, ha⟩, hmem⟩
  refine ⟨k, ?_⟩
  have := congrArg (fun x : ↥(Subgroup.center ↥A) => ((x : ↥A) : X)) hk
  simpa using this

private theorem burnsideA134_exists_pow_two_of_mem_sup {X : Type*} [Group X] {A B : Subgroup X}
    (hc : ∀ a ∈ A, ∀ b ∈ B, Commute a b) (hZA : IsPGroup 2 (Subgroup.center ↥A))
    (hZB : IsPGroup 2 (Subgroup.center ↥B)) {z : X} (hz : z ∈ A ⊔ B)
    (hzc : z ∈ Subgroup.centralizer ((A ⊔ B : Subgroup X) : Set X)) : ∃ k : ℕ, z ^ 2 ^ k = 1 := by
  obtain ⟨a, ha, b, hb, rfl⟩ := burnsideA134_mem_sup_of_commute hc hz
  have hzc' : ∀ g ∈ A ⊔ B, g * (a * b) = (a * b) * g := fun g hg =>
    Subgroup.mem_centralizer_iff.mp hzc g hg
  have haA : ∀ g ∈ A, g * a = a * g := fun g hg => by
    have h1 := hzc' g (Subgroup.mem_sup_left hg)
    have h2 := (hc g hg b hb).eq
    have : g * a * b = a * g * b := by
      calc g * a * b = g * (a * b) := by group
        _ = (a * b) * g := h1
        _ = a * (b * g) := by group
        _ = a * (g * b) := by rw [← h2]
        _ = a * g * b := by group
    exact mul_right_cancel this
  have hbB : ∀ g ∈ B, g * b = b * g := fun g hg => by
    have h1 := hzc' g (Subgroup.mem_sup_right hg)
    have h2 := (hc a ha g hg).eq
    have : a * (g * b) = a * (b * g) := by
      calc a * (g * b) = (a * g) * b := by group
        _ = (g * a) * b := by rw [h2]
        _ = g * (a * b) := by group
        _ = a * b * g := h1
        _ = a * (b * g) := by group
    exact mul_left_cancel this
  obtain ⟨k₁, hk₁⟩ := burnsideA134_exists_pow_two_of_center hZA ha haA
  obtain ⟨k₂, hk₂⟩ := burnsideA134_exists_pow_two_of_center hZB hb hbB
  refine ⟨k₁ + k₂, ?_⟩
  rw [(hc a ha b hb).mul_pow, pow_add, pow_mul, hk₁, one_pow, mul_comm (2 ^ k₁), pow_mul, hk₂,
    one_pow, one_mul]

private theorem burnsideA134_false_of_triple {X : Type} [Group X] [Finite X]
    (he : CFSG.Open.evenRank X ≤ 2) {A B : Subgroup X}
    (hc : ∀ a ∈ A, ∀ b ∈ B, Commute a b) (hZA : IsPGroup 2 (Subgroup.center ↥A))
    {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2)
    {S : Subgroup X} (hS : S ≠ ⊥) (hS2 : IsPGroup 2 S) (hSA : S ≤ A) {a c z : X} (haA : a ∈ A)
    (haS : a ∈ Subgroup.normalizer (S : Set X)) (ha : orderOf a = r) (hcB : c ∈ B)
    (hcr : orderOf c = r) (hzS : z ∈ Subgroup.normalizer (S : Set X)) (hzr : orderOf z = r)
    (hzAB : z ∉ A ⊔ B) (hza : z * a = a * z) (hzc : z * c = c * z) : False := by
  have hno2 : ∀ w : X, orderOf w = r → ∀ k : ℕ, w ^ 2 ^ k = 1 → False := by
    intro w hw k hk
    have h1 : r ∣ 2 ^ k := hw ▸ orderOf_dvd_of_pow_eq_one hk
    exact hr2 ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).1 (hr.dvd_of_dvd_pow h1))
  have haB' : ∀ g ∈ S, c * g = g * c := fun g hg => ((hc g (hSA hg) c hcB).eq).symm
  have hcN : c ∈ Subgroup.normalizer (S : Set X) :=
    Subgroup.centralizer_le_normalizer (S : Set X)
      (Subgroup.mem_centralizer_iff.mpr fun g hg => (haB' g hg).symm)
  have hapow : a ^ r = 1 := by rw [← ha]; exact pow_orderOf_eq_one a
  have hcpow : c ^ r = 1 := by rw [← hcr]; exact pow_orderOf_eq_one c
  have hzpow : z ^ r = 1 := by rw [← hzr]; exact pow_orderOf_eq_one z
  have haAB : a ∈ A ⊔ B := Subgroup.mem_sup_left haA
  have hcAB : c ∈ A ⊔ B := Subgroup.mem_sup_right hcB
  have hE₁ : CFSG.Open.IsElemAbelian r (Subgroup.zpowers a) :=
    CFSG.Open.isElemAbelian_zpowers hapow
  have hE₁c : Nat.card (Subgroup.zpowers a) = r ^ 1 := by rw [Nat.card_zpowers, ha, pow_one]
  have hE₁K : Subgroup.zpowers a ≤ Subgroup.normalizer (S : Set X) ⊓ (A ⊔ B) ⊓
      Subgroup.centralizer ({z} : Set X) :=
    le_inf (le_inf (Subgroup.zpowers_le.2 haS) (Subgroup.zpowers_le.2 haAB))
      (Subgroup.zpowers_le.2 (Subgroup.mem_centralizer_singleton_iff.mpr hza.symm))
  have hcnE : c ∉ Subgroup.zpowers a := by
    intro hmem
    have hcA : c ∈ A := (Subgroup.zpowers_le.2 haA) hmem
    obtain ⟨k, hk⟩ := burnsideA134_exists_pow_two_of_center hZA hcA fun g hg =>
      ((hc g hg c hcB).eq)
    exact hno2 c hcr k hk
  obtain ⟨F₂, hF₂, hF₂c, hF₂K⟩ := CFSG.SectionRank.QTK.CoverB.exists_elemAbelian_sup hr hE₁ hE₁c
    hcpow (fun e he => (hc e ((Subgroup.zpowers_le.2 haA) he) c hcB).symm) hcnE
    (K := Subgroup.normalizer (S : Set X) ⊓ (A ⊔ B) ⊓ Subgroup.centralizer ({z} : Set X))
    ⟨⟨hcN, hcAB⟩, Subgroup.mem_centralizer_singleton_iff.mpr hzc.symm⟩ hE₁K
  have hznF₂ : z ∉ F₂ := fun hmem => hzAB (hF₂K hmem).1.2
  obtain ⟨F₃, hF₃, hF₃c, hF₃K⟩ := CFSG.SectionRank.QTK.CoverB.exists_elemAbelian_sup hr hF₂ hF₂c
    hzpow (fun e he => (Subgroup.mem_centralizer_singleton_iff.mp (hF₂K he).2).symm) hznF₂
    (K := Subgroup.normalizer (S : Set X)) hzS (fun e he => (hF₂K he).1.1)
  have := CFSG.SectionRank.QTK.le_two_of_evenRank_le_two he hS hS2 hr hr2 hF₃ hF₃K hF₃c
  omega

private theorem burnsideA134_false_of_centralizer_element {X : Type} [Group X] [Finite X]
    (he : CFSG.Open.evenRank X ≤ 2) {A B : Subgroup X}
    (hc : ∀ a ∈ A, ∀ b ∈ B, Commute a b) (hZA : IsPGroup 2 (Subgroup.center ↥A))
    (hZB : IsPGroup 2 (Subgroup.center ↥B)) {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2)
    {S : Subgroup X} (hS : S ≠ ⊥) (hS2 : IsPGroup 2 S) (hSA : S ≤ A) {a c z : X} (haA : a ∈ A)
    (haS : a ∈ Subgroup.normalizer (S : Set X)) (ha : orderOf a = r) (hcB : c ∈ B)
    (hcr : orderOf c = r)
    (hz : z ∈ Subgroup.centralizer ((A ⊔ B : Subgroup X) : Set X)) (hzr : orderOf z = r) :
    False := by
  have hzS : ∀ g ∈ S, z * g = g * z := fun g hg =>
    (Subgroup.mem_centralizer_iff.mp hz g (Subgroup.mem_sup_left (hSA hg))).symm
  have hzAB : z ∉ A ⊔ B := by
    intro hmem
    obtain ⟨k, hk⟩ := burnsideA134_exists_pow_two_of_mem_sup hc hZA hZB hmem hz
    have h1 : r ∣ 2 ^ k := hzr ▸ orderOf_dvd_of_pow_eq_one hk
    exact hr2 ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).1 (hr.dvd_of_dvd_pow h1))
  exact burnsideA134_false_of_triple he hc hZA hr hr2 hS hS2 hSA haA haS ha hcB hcr
    (Subgroup.centralizer_le_normalizer (S : Set X)
      (Subgroup.mem_centralizer_iff.mpr fun g hg => (hzS g hg).symm)) hzr hzAB
    (Subgroup.mem_centralizer_iff.mp hz a (Subgroup.mem_sup_left haA)).symm
    (Subgroup.mem_centralizer_iff.mp hz c (Subgroup.mem_sup_right hcB)).symm

private theorem burnsideA134_rElement_mem_sup {X : Type} [Group X] [Finite X]
    (he : CFSG.Open.evenRank X ≤ 2) {A B : Subgroup X}
    (hc : ∀ a ∈ A, ∀ b ∈ B, Commute a b) (hZA : IsPGroup 2 (Subgroup.center ↥A))
    (hZB : IsPGroup 2 (Subgroup.center ↥B)) {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2)
    {S : Subgroup X} (hS : S ≠ ⊥) (hS2 : IsPGroup 2 S) (hSA : S ≤ A) {a c : X} (haA : a ∈ A)
    (haS : a ∈ Subgroup.normalizer (S : Set X)) (ha : orderOf a = r) (hcB : c ∈ B)
    (hcr : orderOf c = r) {y : X} (hy : ∃ k : ℕ, y ^ r ^ k = 1)
    (hfac : ∃ a₀ ∈ A, ∃ b₀ ∈ B, ∃ z ∈ Subgroup.centralizer ((A ⊔ B : Subgroup X) : Set X),
      y = a₀ * b₀ * z) : y ∈ A ⊔ B := by
  haveI : Fact r.Prime := ⟨hr⟩
  obtain ⟨a₀, ha₀, b₀, hb₀, z, hz, rfl⟩ := hfac
  set C : Subgroup X := Subgroup.centralizer ((A ⊔ B : Subgroup X) : Set X) with hC
  have hCr : ¬ r ∣ Nat.card C := by
    intro h
    obtain ⟨w, hw⟩ := exists_prime_orderOf_dvd_card' (G := ↥C) r h
    exact burnsideA134_false_of_centralizer_element he hc hZA hZB hr hr2 hS hS2 hSA haA haS ha
      hcB hcr w.2 (by rw [← Subgroup.orderOf_coe] at hw; exact hw)
  have hw : a₀ * b₀ ∈ A ⊔ B := Subgroup.mul_mem_sup ha₀ hb₀
  have hcomm : Commute (a₀ * b₀) z := (Subgroup.mem_centralizer_iff.mp hz _ hw)
  obtain ⟨k, hk⟩ := hy
  have hcop : Nat.Coprime (Nat.card C) (orderOf (a₀ * b₀ * z)) := by
    have h1 : orderOf (a₀ * b₀ * z) ∣ r ^ k := orderOf_dvd_of_pow_eq_one hk
    exact Nat.Coprime.coprime_dvd_right h1
      (Nat.Coprime.pow_right k ((Nat.Prime.coprime_iff_not_dvd hr).2 hCr).symm)
  obtain ⟨m, hm⟩ := exists_pow_eq_self_of_coprime hcop
  have hzC : z ^ Nat.card C = 1 := by
    have h := pow_card_eq_one' (G := ↥C) (x := ⟨z, hz⟩)
    have h2 := congrArg (fun w : ↥C => (w : X)) h
    simp only [SubgroupClass.coe_pow, OneMemClass.coe_one] at h2
    exact h2
  rw [← hm, hcomm.mul_pow, hzC, mul_one]
  exact Subgroup.pow_mem _ (Subgroup.pow_mem _ hw _) _

noncomputable def burnsideA134_theta {X : Type} [Group X] (A : Subgroup X) :
    Subgroup.normalizer (A : Set X) →* MulAut (↥A ⧸ Subgroup.center ↥A) :=
  (CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom ↥A).comp
    A.normalizerMonoidHom

private theorem burnsideA134_theta_mk {X : Type} [Group X] (A : Subgroup X)
    (y : Subgroup.normalizer (A : Set X)) (a : ↥A) :
    burnsideA134_theta A y (QuotientGroup.mk a) =
      QuotientGroup.mk ⟨(y : X) * a * (y : X)⁻¹, (y.2 a).mp a.2⟩ := by
  unfold burnsideA134_theta
  change CFSG.ComponentClassification.PerfectAutomorphisms.onCenterQuotient
    (A.normalizerMonoidHom y) ((QuotientGroup.mk' (Subgroup.center ↥A)) a) = _
  rw [CFSG.ComponentClassification.PerfectAutomorphisms.onCenterQuotient_apply_mk]
  rfl

private theorem burnsideA134_theta_of_mem {X : Type} [Group X] (A : Subgroup X)
    {a₀ : X} (ha₀ : a₀ ∈ A) :
    burnsideA134_theta A ⟨a₀, Subgroup.le_normalizer ha₀⟩ =
      MulAut.conj (QuotientGroup.mk (⟨a₀, ha₀⟩ : ↥A) : ↥A ⧸ Subgroup.center ↥A) := by
  apply MulEquiv.ext
  intro x
  obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective x
  rw [burnsideA134_theta_mk, MulAut.conj_apply]
  rfl

private theorem burnsideA134_conj_of_theta {X : Type} [Group X] (A : Subgroup X)
    [Group.IsPerfect ↥A]
    {y : X} (hy : y ∈ Subgroup.normalizer (A : Set X)) {a₀ : X} (ha₀ : a₀ ∈ A)
    (h : burnsideA134_theta A ⟨y, hy⟩ = MulAut.conj (QuotientGroup.mk (⟨a₀, ha₀⟩ : ↥A) :
      ↥A ⧸ Subgroup.center ↥A)) : ∀ a ∈ A, y * a * y⁻¹ = a₀ * a * a₀⁻¹ := by
  have h1 : CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom ↥A
      (A.normalizerMonoidHom ⟨y, hy⟩) =
      CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom ↥A
        (MulAut.conj (⟨a₀, ha₀⟩ : ↥A)) := by
    rw [CFSG.ComponentClassification.OuterAutomorphisms.centerQuotient_conj]
    exact h
  have h2 := CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom_injective ↥A h1
  intro a ha
  have h3 := congrArg (fun φ : MulAut ↥A => ((φ ⟨a, ha⟩ : ↥A) : X)) h2
  simpa using h3

private theorem burnsideA134_factor_of_inner {X : Type} [Group X] {A B : Subgroup X}
    [Group.IsPerfect ↥A] [Group.IsPerfect ↥B] (hc : ∀ a ∈ A, ∀ b ∈ B, Commute a b) {y : X}
    (hyA : y ∈ Subgroup.normalizer (A : Set X)) (hyB : y ∈ Subgroup.normalizer (B : Set X))
    (hA : ∃ (a₀ : X) (ha₀ : a₀ ∈ A), burnsideA134_theta A ⟨y, hyA⟩ =
      MulAut.conj (QuotientGroup.mk (⟨a₀, ha₀⟩ : ↥A) : ↥A ⧸ Subgroup.center ↥A))
    (hB : ∃ (b₀ : X) (hb₀ : b₀ ∈ B), burnsideA134_theta B ⟨y, hyB⟩ =
      MulAut.conj (QuotientGroup.mk (⟨b₀, hb₀⟩ : ↥B) : ↥B ⧸ Subgroup.center ↥B)) :
    ∃ a₀ ∈ A, ∃ b₀ ∈ B, ∃ z ∈ Subgroup.centralizer ((A ⊔ B : Subgroup X) : Set X),
      y = a₀ * b₀ * z := by
  obtain ⟨a₀, ha₀, hAa⟩ := hA
  obtain ⟨b₀, hb₀, hBb⟩ := hB
  have hyA' := burnsideA134_conj_of_theta A hyA ha₀ hAa
  have hyB' := burnsideA134_conj_of_theta B hyB hb₀ hBb
  refine ⟨a₀, ha₀, b₀, hb₀, b₀⁻¹ * a₀⁻¹ * y, ?_, by group⟩
  have hzA : ∀ a ∈ A, (b₀⁻¹ * a₀⁻¹ * y) * a = a * (b₀⁻¹ * a₀⁻¹ * y) := by
    intro a ha
    have h1 := hyA' a ha
    have h2 := (hc a ha b₀ hb₀).eq
    have h3 : y * a = a₀ * a * a₀⁻¹ * y := by
      calc y * a = (y * a * y⁻¹) * y := by group
        _ = a₀ * a * a₀⁻¹ * y := by rw [h1]
    calc b₀⁻¹ * a₀⁻¹ * y * a = b₀⁻¹ * a₀⁻¹ * (y * a) := by group
      _ = b₀⁻¹ * a₀⁻¹ * (a₀ * a * a₀⁻¹ * y) := by rw [h3]
      _ = b₀⁻¹ * a * a₀⁻¹ * y := by group
      _ = a * b₀⁻¹ * a₀⁻¹ * y := by
        have : b₀⁻¹ * a = a * b₀⁻¹ := by
          calc b₀⁻¹ * a = b₀⁻¹ * (a * b₀) * b₀⁻¹ := by group
            _ = b₀⁻¹ * (b₀ * a) * b₀⁻¹ := by rw [h2]
            _ = a * b₀⁻¹ := by group
        rw [this]
      _ = a * (b₀⁻¹ * a₀⁻¹ * y) := by group
  have hzB : ∀ b ∈ B, (b₀⁻¹ * a₀⁻¹ * y) * b = b * (b₀⁻¹ * a₀⁻¹ * y) := by
    intro b hb
    have h1 := hyB' b hb
    have h2 := (hc a₀ ha₀ b hb).eq
    have h2' := (hc a₀ ha₀ b₀ hb₀).eq
    have h3 : y * b = b₀ * b * b₀⁻¹ * y := by
      calc y * b = (y * b * y⁻¹) * y := by group
        _ = b₀ * b * b₀⁻¹ * y := by rw [h1]
    have h4 : a₀⁻¹ * b = b * a₀⁻¹ := by
      calc a₀⁻¹ * b = a₀⁻¹ * (b * a₀) * a₀⁻¹ := by group
        _ = a₀⁻¹ * (a₀ * b) * a₀⁻¹ := by rw [← h2]
        _ = b * a₀⁻¹ := by group
    have h5 : a₀⁻¹ * b₀ = b₀ * a₀⁻¹ := by
      calc a₀⁻¹ * b₀ = a₀⁻¹ * (b₀ * a₀) * a₀⁻¹ := by group
        _ = a₀⁻¹ * (a₀ * b₀) * a₀⁻¹ := by rw [← h2']
        _ = b₀ * a₀⁻¹ := by group
    calc b₀⁻¹ * a₀⁻¹ * y * b = b₀⁻¹ * a₀⁻¹ * (y * b) := by group
      _ = b₀⁻¹ * a₀⁻¹ * (b₀ * b * b₀⁻¹ * y) := by rw [h3]
      _ = b₀⁻¹ * (a₀⁻¹ * b₀) * b * b₀⁻¹ * y := by group
      _ = b₀⁻¹ * (b₀ * a₀⁻¹) * b * b₀⁻¹ * y := by rw [h5]
      _ = a₀⁻¹ * b * b₀⁻¹ * y := by group
      _ = b * a₀⁻¹ * b₀⁻¹ * y := by rw [h4]
      _ = b * (b₀⁻¹ * a₀⁻¹ * y) := by
        have : a₀⁻¹ * b₀⁻¹ = b₀⁻¹ * a₀⁻¹ := by
          calc a₀⁻¹ * b₀⁻¹ = (b₀ * a₀)⁻¹ := by group
            _ = (a₀ * b₀)⁻¹ := by rw [h2']
            _ = b₀⁻¹ * a₀⁻¹ := by group
        calc b * a₀⁻¹ * b₀⁻¹ * y = b * (a₀⁻¹ * b₀⁻¹) * y := by group
          _ = b * (b₀⁻¹ * a₀⁻¹) * y := by rw [this]
          _ = b * (b₀⁻¹ * a₀⁻¹ * y) := by group
  rw [Subgroup.mem_centralizer_iff]
  intro g hg
  have hsup : A ⊔ B ≤ Subgroup.centralizer ({b₀⁻¹ * a₀⁻¹ * y} : Set X) := by
    refine sup_le (fun a ha => ?_) (fun b hb => ?_)
    · rw [Subgroup.mem_centralizer_singleton_iff]
      exact (hzA a ha).symm
    · rw [Subgroup.mem_centralizer_singleton_iff]
      exact (hzB b hb).symm
  have := Subgroup.mem_centralizer_singleton_iff.mp (hsup hg)
  exact this

@[expose] def burnsideA134_FAC {X : Type} [Group X] (A B : Subgroup X) (r : ℕ) : Prop :=
  ∀ y : X, y ∈ Subgroup.normalizer (A : Set X) → y ∈ Subgroup.normalizer (B : Set X) →
    (∃ k : ℕ, y ^ r ^ k = 1) →
    ∃ a₀ ∈ A, ∃ b₀ ∈ B, ∃ z ∈ Subgroup.centralizer ((A ⊔ B : Subgroup X) : Set X),
      y = a₀ * b₀ * z

@[expose] def burnsideA134_NoOuter (r : ℕ) (Y : Type*) [Group Y] : Prop :=
  ∀ φ : MulAut Y, (∃ k : ℕ, φ ^ r ^ k = 1) → ∃ g : Y, φ = MulAut.conj g

private theorem burnsideA134_inner_of_noOuter {X : Type} [Group X] (A : Subgroup X) {r : ℕ}
    (hout : burnsideA134_NoOuter r (↥A ⧸ Subgroup.center ↥A)) {y : X}
    (hy : y ∈ Subgroup.normalizer (A : Set X)) (hyr : ∃ k : ℕ, y ^ r ^ k = 1) :
    ∃ (a₀ : X) (ha₀ : a₀ ∈ A), burnsideA134_theta A ⟨y, hy⟩ =
      MulAut.conj (QuotientGroup.mk (⟨a₀, ha₀⟩ : ↥A) : ↥A ⧸ Subgroup.center ↥A) := by
  obtain ⟨k, hk⟩ := hyr
  have hpow : burnsideA134_theta A ⟨y, hy⟩ ^ r ^ k = 1 := by
    rw [← map_pow]
    have : (⟨y, hy⟩ : Subgroup.normalizer (A : Set X)) ^ r ^ k = 1 :=
      Subtype.ext (by simpa using hk)
    rw [this, map_one]
  obtain ⟨g, hg⟩ := hout _ ⟨k, hpow⟩
  obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective g
  exact ⟨a, a.2, hg⟩

private theorem burnsideA134_fac_of_noOuter {X : Type} [Group X] {A B : Subgroup X}
    [Group.IsPerfect ↥A] [Group.IsPerfect ↥B] (hc : ∀ a ∈ A, ∀ b ∈ B, Commute a b) {r : ℕ}
    (hoA : burnsideA134_NoOuter r (↥A ⧸ Subgroup.center ↥A))
    (hoB : burnsideA134_NoOuter r (↥B ⧸ Subgroup.center ↥B)) : burnsideA134_FAC A B r :=
  fun _ hyA hyB hyr => burnsideA134_factor_of_inner hc hyA hyB
    (burnsideA134_inner_of_noOuter A hoA hyA hyr) (burnsideA134_inner_of_noOuter B hoB hyB hyr)

private theorem burnsideA134_conj_mem {X : Type} [Group X] {A B : Subgroup X} (hA :
    CFSG.IsComponent A)
    (hB : CFSG.IsComponent B) (e : ↥A ≃* ↥B)
    (hA2 : ∀ L : Subgroup X, CFSG.IsComponent L → Nonempty (↥L ≃* ↥A) → L = A ∨ L = B)
    (t : X) :
    (A.map (MulAut.conj t).toMonoidHom = A ∨ A.map (MulAut.conj t).toMonoidHom = B) ∧
      (B.map (MulAut.conj t).toMonoidHom = A ∨ B.map (MulAut.conj t).toMonoidHom = B) :=
  ⟨hA2 _ (CFSG.Quasithin.A38.isComponent_conj hA)
      ⟨(CFSG.Quasithin.A38.conjEquiv t A).symm⟩,
    hA2 _ (CFSG.Quasithin.A38.isComponent_conj hB)
      ⟨(CFSG.Quasithin.A38.conjEquiv t B).symm.trans e.symm⟩⟩

private theorem burnsideA134_rElement_normalizes {X : Type} [Group X] {A B : Subgroup X}
    (hA : CFSG.IsComponent A) (hB : CFSG.IsComponent B) (hne : A ≠ B) (e : ↥A ≃* ↥B)
    (hA2 : ∀ L : Subgroup X, CFSG.IsComponent L → Nonempty (↥L ≃* ↥A) → L = A ∨ L = B)
    {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2) {y : X} (hy : ∃ k : ℕ, y ^ r ^ k = 1) :
    y ∈ Subgroup.normalizer (A : Set X) ∧ y ∈ Subgroup.normalizer (B : Set X) := by
  obtain ⟨k, hk⟩ := hy
  have hinj : ∀ (t : X) (K₁ K₂ : Subgroup X), K₁.map (MulAut.conj t).toMonoidHom =
      K₂.map (MulAut.conj t).toMonoidHom → K₁ = K₂ := fun t K₁ K₂ h =>
    Subgroup.map_injective (MulAut.conj t).injective h
  have hcop : Nat.Coprime 2 (orderOf y) := by
    have h1 : orderOf y ∣ r ^ k := orderOf_dvd_of_pow_eq_one hk
    exact Nat.Coprime.coprime_dvd_right h1
      (Nat.Coprime.pow_right k ((Nat.coprime_primes Nat.prime_two hr).2 (Ne.symm hr2)))
  obtain ⟨m, hm⟩ := exists_pow_eq_self_of_coprime hcop
  obtain ⟨hAy, hBy⟩ := burnsideA134_conj_mem hA hB e hA2 y
  have hA' : A.map (MulAut.conj y).toMonoidHom = A := by
    rcases hAy with h | h
    · exact h
    · exfalso
      rcases hBy with h' | h'
      · have hBm : ∀ x, y * x * y⁻¹ ∈ B ↔ x ∈ A := fun x => by
          rw [← h, CFSG.Quasithin.A38.mem_map_conj]
          simp [mul_assoc]
        have hAm : ∀ x, y * x * y⁻¹ ∈ A ↔ x ∈ B := fun x => by
          rw [← h', CFSG.Quasithin.A38.mem_map_conj]
          simp [mul_assoc]
        have hy2 : y * y ∈ Subgroup.normalizer (A : Set X) := by
          rw [Subgroup.mem_normalizer_iff]
          intro x
          have e1 : y * y * x * (y * y)⁻¹ = y * (y * x * y⁻¹) * y⁻¹ := by group
          rw [e1, hAm, hBm]
        have hyN : y ∈ Subgroup.normalizer (A : Set X) := by
          rw [← hm]
          exact Subgroup.pow_mem _ (by simpa [sq] using hy2) m
        exact hne ((CFSG.Quasithin.A38.map_conj_eq_iff.mpr hyN).symm.trans h)
      · exact hne (hinj y A B (h.trans h'.symm))
  have hB' : B.map (MulAut.conj y).toMonoidHom = B := by
    rcases hBy with h | h
    · exact absurd (hinj y B A (h.trans hA'.symm)) (Ne.symm hne)
    · exact h
  exact ⟨CFSG.Quasithin.A38.map_conj_eq_iff.mp hA', CFSG.Quasithin.A38.map_conj_eq_iff.mp hB'⟩

private theorem burnsideA134_part1_X {X : Type} [Group X] [Finite X]
    (he : CFSG.Open.evenRank X ≤ 2) {A B : Subgroup X}
    (hA : CFSG.IsComponent A) (hB : CFSG.IsComponent B) (hne : A ≠ B) (e : ↥A ≃* ↥B)
    (hA2 : ∀ L : Subgroup X, CFSG.IsComponent L → Nonempty (↥L ≃* ↥A) → L = A ∨ L = B)
    (hZA : IsPGroup 2 (Subgroup.center ↥A)) (hZB : IsPGroup 2 (Subgroup.center ↥B))
    {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2) {S : Subgroup X} (hS : S ≠ ⊥) (hS2 : IsPGroup 2 S)
    (hSA : S ≤ A) {a : X} (haA : a ∈ A) (haS : a ∈ Subgroup.normalizer (S : Set X))
    (ha : orderOf a = r) (hfac : burnsideA134_FAC A B r) :
    (A ⊔ B).Normal ∧ ∀ x : X, ∃ m : ℕ, 0 < m ∧ (∀ q : ℕ, q.Prime → q ∣ m → q ≠ r) ∧
      x ^ m ∈ A ⊔ B := by
  haveI : Fact r.Prime := ⟨hr⟩
  have hc := burnsideA134_components_commute hA hB hne
  let c : X := (e ⟨a, haA⟩ : ↥B)
  have hcB : c ∈ B := (e ⟨a, haA⟩).2
  have hcr : orderOf c = r := by
    rw [← ha]
    calc orderOf c = orderOf (e ⟨a, haA⟩) := Subgroup.orderOf_coe _
      _ = orderOf (⟨a, haA⟩ : ↥A) := MulEquiv.orderOf_eq e _
      _ = orderOf a := Subgroup.orderOf_mk _ _
  have hrel : ∀ y : X, (∃ k : ℕ, y ^ r ^ k = 1) → y ∈ A ⊔ B := by
    intro y hy
    obtain ⟨hyA, hyB⟩ := burnsideA134_rElement_normalizes hA hB hne e hA2 hr hr2 hy
    exact burnsideA134_rElement_mem_sup he hc hZA hZB hr hr2 hS hS2 hSA haA haS ha hcB hcr hy
      (hfac y hyA hyB hy)
  have hconjA : ∀ (g x : X), x ∈ A → g * x * g⁻¹ ∈ A ⊔ B := by
    intro g x hx
    have hmem : g * x * g⁻¹ ∈ A.map (MulAut.conj g).toMonoidHom :=
      ⟨x, hx, by simp [MulAut.conj_apply]⟩
    rcases (burnsideA134_conj_mem hA hB e hA2 g).1 with h | h
    · rw [h] at hmem
      exact Subgroup.mem_sup_left hmem
    · rw [h] at hmem
      exact Subgroup.mem_sup_right hmem
  have hconjB : ∀ (g x : X), x ∈ B → g * x * g⁻¹ ∈ A ⊔ B := by
    intro g x hx
    have hmem : g * x * g⁻¹ ∈ B.map (MulAut.conj g).toMonoidHom :=
      ⟨x, hx, by simp [MulAut.conj_apply]⟩
    rcases (burnsideA134_conj_mem hA hB e hA2 g).2 with h | h
    · rw [h] at hmem
      exact Subgroup.mem_sup_left hmem
    · rw [h] at hmem
      exact Subgroup.mem_sup_right hmem
  have hnorm : (A ⊔ B).Normal := by
    refine ⟨fun n hn g => ?_⟩
    obtain ⟨a', ha', b', hb', rfl⟩ := burnsideA134_mem_sup_of_commute hc hn
    have : g * (a' * b') * g⁻¹ = (g * a' * g⁻¹) * (g * b' * g⁻¹) := by group
    rw [this]
    exact Subgroup.mul_mem _ (hconjA g a' ha') (hconjB g b' hb')
  refine ⟨hnorm, fun x => ?_⟩
  have hdvd : ¬ r ∣ (A ⊔ B).index := by
    intro h
    let Q : Sylow r X := default
    have hQle : (Q : Subgroup X) ≤ A ⊔ B := fun q hq => hrel q (by
      obtain ⟨k, hk⟩ := (IsPGroup.iff_orderOf.mp Q.isPGroup') ⟨q, hq⟩
      refine ⟨k, ?_⟩
      have := pow_orderOf_eq_one (⟨q, hq⟩ : ↥(Q : Subgroup X))
      rw [hk] at this
      simpa using congrArg Subtype.val this)
    exact Q.not_dvd_index (h.trans (Subgroup.index_dvd_of_le hQle))
  refine ⟨(A ⊔ B).index, Nat.pos_of_ne_zero (Subgroup.index_ne_zero_of_finite), ?_,
    Subgroup.pow_index_mem _ x⟩
  intro q hq hqd hqr
  exact hdvd (hqr ▸ hqd)

private theorem burnsideA134_isTwoLocal_map {Y Y' : Type*} [Group Y] [Group Y'] (f : Y ≃* Y')
    {N : Subgroup Y} (hN : CFSG.Open.IsTwoLocal N) :
    CFSG.Open.IsTwoLocal (N.map f.toMonoidHom) ∧ Nat.card (N.map f.toMonoidHom) = Nat.card N := by
  obtain ⟨P, hP1, hP2, rfl⟩ := hN
  refine ⟨⟨P.map f.toMonoidHom, fun h => hP1 ((Subgroup.map_eq_bot_iff_of_injective P
    f.injective).mp h), hP2.map _, (Subgroup.map_equiv_normalizer_eq P f)⟩, ?_⟩
  exact Subgroup.card_map_of_injective f.injective

private theorem burnsideA134_lift_twoLocal {X : Type} [Group X] (A : Subgroup X)
    (hZ : IsPGroup 2 (Subgroup.center ↥A)) [Finite A] {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2)
    {N : Subgroup (↥A ⧸ Subgroup.center ↥A)} (hN : CFSG.Open.IsTwoLocal N)
    (hrN : r ∣ Nat.card N) :
    ∃ S : Subgroup X, S ≠ ⊥ ∧ IsPGroup 2 S ∧ S ≤ A ∧
      ∃ a ∈ A, a ∈ Subgroup.normalizer (S : Set X) ∧ orderOf a = r := by
  haveI : Fact r.Prime := ⟨hr⟩
  obtain ⟨R, hR1, hR2, rfl⟩ := hN
  let π := QuotientGroup.mk' (Subgroup.center ↥A)
  let S : Subgroup X := (R.comap π).map A.subtype
  have hmemS : ∀ h : X, h ∈ S ↔ ∃ x : ↥A, π x ∈ R ∧ (x : X) = h := fun h => by
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact ⟨x, hx, rfl⟩
    · rintro ⟨x, hx, rfl⟩
      exact ⟨x, hx, rfl⟩
  have hSne : S ≠ ⊥ := by
    intro hS
    apply hR1
    rw [eq_bot_iff]
    intro xq hxq
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective xq
    have hx : (x : X) ∈ S := (hmemS _).2 ⟨x, hxq, rfl⟩
    rw [hS, Subgroup.mem_bot] at hx
    have hx1 : x = 1 := Subtype.ext hx
    rw [hx1]
    exact Subgroup.one_mem _
  have hS2 : IsPGroup 2 S := by
    rintro ⟨s, hs⟩
    obtain ⟨x, hxR, rfl⟩ := (hmemS s).1 hs
    obtain ⟨k, hk⟩ := hR2 ⟨π x, hxR⟩
    have hk' : π (x ^ 2 ^ k) = 1 := by
      have := congrArg (fun z : ↥R => (z : ↥A ⧸ Subgroup.center ↥A)) hk
      simpa using this
    have hxz : x ^ 2 ^ k ∈ Subgroup.center ↥A := (QuotientGroup.eq_one_iff _).mp hk'
    obtain ⟨j, hj⟩ := hZ ⟨_, hxz⟩
    refine ⟨k + j, ?_⟩
    apply Subtype.ext
    have := congrArg (fun z : ↥(Subgroup.center ↥A) => ((z : ↥A) : X)) hj
    simp only [SubgroupClass.coe_pow, OneMemClass.coe_one] at this
    simpa [pow_add, pow_mul] using this
  obtain ⟨nn, hnn⟩ := exists_prime_orderOf_dvd_card' (G := ↥(Subgroup.normalizer (R : Set
    (↥A ⧸ Subgroup.center ↥A)))) r hrN
  obtain ⟨n, hn⟩ := QuotientGroup.mk_surjective (nn : ↥A ⧸ Subgroup.center ↥A)
  have hnnr : orderOf (nn : ↥A ⧸ Subgroup.center ↥A) = r := by
    rw [Subgroup.orderOf_coe]; exact hnn
  have hnN : (n : X) ∈ Subgroup.normalizer (S : Set X) := by
    rw [Subgroup.mem_normalizer_iff]
    have hnR := Subgroup.mem_normalizer_iff.mp nn.2
    intro h
    constructor
    · intro hh
      obtain ⟨x, hxR, rfl⟩ := (hmemS h).1 hh
      refine (hmemS _).2 ⟨n * x * n⁻¹, ?_, by simp⟩
      have := (hnR (π x)).1 hxR
      rw [← hn] at this
      rw [map_mul, map_mul, map_inv]
      exact this
    · intro hh
      obtain ⟨y, hyR, hy⟩ := (hmemS _).1 hh
      have hhA : h ∈ (A : Set X) := by
        have : h = (n : X)⁻¹ * ((n : X) * h * (n : X)⁻¹) * (n : X) := by group
        rw [this, ← hy]
        exact A.mul_mem (A.mul_mem (A.inv_mem n.2) y.2) n.2
      refine (hmemS _).2 ⟨⟨h, hhA⟩, ?_, rfl⟩
      have hyx : y = n * ⟨h, hhA⟩ * n⁻¹ := Subtype.ext (by simpa using hy)
      have h2 := (hnR (π ⟨h, hhA⟩)).2
      rw [← hn] at h2
      refine h2 ?_
      rw [hyx, map_mul, map_mul, map_inv] at hyR
      exact hyR
  obtain ⟨k, hk⟩ := (IsPGroup.iff_card).mp hZ
  refine ⟨S, hSne, hS2, fun x hx => ?_, ((n ^ Nat.card (Subgroup.center ↥A) : ↥A) : X), ?_, ?_, ?_⟩
  · obtain ⟨y, -, rfl⟩ := (hmemS x).1 hx
    exact y.2
  · exact (n ^ Nat.card (Subgroup.center ↥A)).2
  · rw [SubgroupClass.coe_pow]
    exact Subgroup.pow_mem _ hnN _
  · have hπn : π n = (nn : ↥A ⧸ Subgroup.center ↥A) := hn
    have hrn : (π n) ^ r = 1 := by
      rw [hπn, ← hnnr]
      exact pow_orderOf_eq_one _
    have hnr_mem : n ^ r ∈ Subgroup.center ↥A :=
      (QuotientGroup.eq_one_iff _).mp (by show π (n ^ r) = 1; rw [map_pow]; exact hrn)
    have hnrm : (n ^ r) ^ Nat.card (Subgroup.center ↥A) = 1 := by
      have h1 := pow_card_eq_one' (G := ↥(Subgroup.center ↥A)) (x := ⟨n ^ r, hnr_mem⟩)
      have h2 := congrArg (fun z : ↥(Subgroup.center ↥A) => (z : ↥A)) h1
      simp only [SubgroupClass.coe_pow, OneMemClass.coe_one] at h2
      exact h2
    have hpow : (n ^ Nat.card (Subgroup.center ↥A)) ^ r = 1 := by
      rw [← pow_mul, mul_comm, pow_mul, hnrm]
    refine orderOf_eq_prime ?_ ?_
    · rw [← SubgroupClass.coe_pow, hpow]
      rfl
    · intro h1
      have h3 : n ^ Nat.card (Subgroup.center ↥A) = 1 := Subtype.ext h1
      have h4 : (π n) ^ Nat.card (Subgroup.center ↥A) = 1 := by rw [← map_pow, h3, map_one]
      have h5 : r ∣ Nat.card (Subgroup.center ↥A) := by
        rw [← hnnr, ← hπn]
        exact orderOf_dvd_of_pow_eq_one h4
      rw [hk] at h5
      exact hr2 ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).1 (hr.dvd_of_dvd_pow h5))

private theorem burnsideA134_le_of_rPrime_quotient {X : Type} [Group X] {A : Subgroup X}
    (hq : CFSG.IsQuasisimple ↥A) {r : ℕ} (hr : r.Prime) {aq : ↥A ⧸ Subgroup.center ↥A}
    (haq : orderOf aq = r) {N : Subgroup X} [N.Normal]
    (hN : ∀ x : X, ∃ m : ℕ, 0 < m ∧ (∀ q : ℕ, q.Prime → q ∣ m → q ≠ r) ∧ x ^ m ∈ N) :
    A ≤ N := by
  by_contra hAN
  have hK : ¬ N.subgroupOf A = ⊤ := fun h => hAN (Subgroup.subgroupOf_eq_top.mp h)
  have hKc := (CFSG.LocalCores.quasisimple_normal_subgroups hq
    (N := N.subgroupOf A) inferInstance).resolve_left hK
  obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective aq
  obtain ⟨m, hm0, hmq, hmN⟩ := hN (a : X)
  have hamK : a ^ m ∈ N.subgroupOf A := by
    rw [Subgroup.mem_subgroupOf]
    simpa using hmN
  have hamZ : a ^ m ∈ Subgroup.center ↥A := hKc hamK
  have h1 : (QuotientGroup.mk a : ↥A ⧸ Subgroup.center ↥A) ^ m = 1 := by
    rw [← QuotientGroup.mk_pow]
    exact (QuotientGroup.eq_one_iff _).mpr hamZ
  have h2 : r ∣ m := haq ▸ orderOf_dvd_of_pow_eq_one h1
  exact hmq r hr h2 rfl

@[expose] def burnsideA134_FamFAC : Prop :=
  ∀ (X : Type) [Group X] [Finite X], CFSG.Open.evenRank X ≤ 2 → ∀ A B : Subgroup X,
    CFSG.IsQuasisimple ↥A → CFSG.IsQuasisimple ↥B → (∀ a ∈ A, ∀ b ∈ B, Commute a b) →
    Nonempty (↥A ≃* ↥B) → CFSG.Quasithin.A134TypesCentral ↥A →
    IsPGroup 2 (Subgroup.center ↥A) → IsPGroup 2 (Subgroup.center ↥B) →
    ∀ r : ℕ, r.Prime → r ≠ 2 →
    (∃ N : Subgroup (↥A ⧸ Subgroup.center ↥A), CFSG.Open.IsTwoLocal N ∧ r ∣ Nat.card N) →
    burnsideA134_FAC A B r

private theorem burnsideA134_noOuter_of_mulEquiv {r : ℕ} {Y Z : Type*} [Group Y] [Group Z] (e :
    Y ≃* Z)
    (h : burnsideA134_NoOuter r Z) : burnsideA134_NoOuter r Y := by
  rintro φ ⟨k, hk⟩
  have h1 : (MulAut.congr e φ) ^ r ^ k = 1 := by rw [← map_pow, hk, map_one]
  obtain ⟨g, hg⟩ := h _ ⟨k, h1⟩
  refine ⟨e.symm g, ?_⟩
  apply (MulAut.congr e).injective
  rw [hg, CFSG.ComponentClassification.OuterAutomorphisms.congr_conj, e.apply_symm_apply]

private theorem burnsideA134_noOuter_J1
    {Y : Type} [Group Y] (e : Y ≃* CFSG.Blueprint.NativeSporadic.Carrier .J1) (r : ℕ) :
    burnsideA134_NoOuter r Y :=
  burnsideA134_noOuter_of_mulEquiv e fun φ _ =>
    CFSG.Sporadic.Schreier.at_j1_schreier.2.1 φ

private theorem burnsideA134_noOuter_psl2 {K : Type} [Field K] [Finite K] {p k r : ℕ} (hp : p.Prime)
    (hK : Nat.card K = p ^ k) (hk : k = 1 ∨ k = 2) (hr : r.Prime) (hr2 : r ≠ 2) :
    burnsideA134_NoOuter r (CFSG.GorensteinWalter.PSL2 K) := by
  rintro φ ⟨m, hm⟩
  set γ := (CFSG.ComponentClassification.CatalogueSchreierLinearTwo.semilinearEquivAut K).symm φ
    with hγ
  have hγm : γ ^ r ^ m = 1 := by rw [hγ, ← map_pow, hm, map_one]
  have hψ : (SemidirectProduct.rightHom γ) ^ r ^ m = 1 := by rw [← map_pow, hγm, map_one]
  have hcard : Nat.card (RingAut K) = k :=
    (CFSG.LocalAnalysis.ComponentInitial.card_ringAut_and_isCyclic hp K hK).1
  have hcop : Nat.Coprime (r ^ m) k := by
    refine Nat.Coprime.pow_left m ?_
    rcases hk with rfl | rfl
    · exact Nat.coprime_one_right _
    · exact (Nat.coprime_primes hr Nat.prime_two).2 hr2
  have hord : orderOf (SemidirectProduct.rightHom γ) = 1 := by
    have h1 : orderOf (SemidirectProduct.rightHom γ) ∣ r ^ m := orderOf_dvd_of_pow_eq_one hψ
    have h2 : orderOf (SemidirectProduct.rightHom γ) ∣ k := hcard ▸ orderOf_dvd_natCard _
    exact Nat.eq_one_of_dvd_coprimes hcop h1 h2
  have hψ1 : SemidirectProduct.rightHom γ = 1 := orderOf_eq_one_iff.mp hord
  obtain ⟨g, hg⟩ := CFSG.RankThree.PartTwo.KFacts.mem_range_pglAction_of_rightHom_eq_one hψ1
  have hg' : g ^ r ^ m = 1 := by
    apply CFSG.RankThree.PartTwo.KFacts.pglAction_injective
    rw [map_pow, hg, hm, map_one]
  obtain ⟨x, hx⟩ := CFSG.RankThree.PartTwo.KFacts.exists_toPGL_eq_of_pow_odd
    (Odd.pow (hr.odd_of_ne_two hr2)) hg'
  refine ⟨x, ?_⟩
  rw [← hg, ← hx]
  exact CFSG.ComponentClassification.CatalogueSchreierLinearTwo.pglAction_toPGL K x

@[expose] def burnsideA134_FamBender : Prop :=
  ∀ (X : Type) [Group X] [Finite X], CFSG.Open.evenRank X ≤ 2 → ∀ A B : Subgroup X,
    CFSG.IsQuasisimple ↥A → CFSG.IsQuasisimple ↥B → (∀ a ∈ A, ∀ b ∈ B, Commute a b) →
    Nonempty (↥A ≃* ↥B) →
    ((∃ n : ℕ, CFSG.Open.StatedClassicalModel (↥A ⧸ Subgroup.center ↥A) .PSL 2 2 n) ∨
      (∃ n : ℕ, CFSG.Blueprint.SuzukiModel (↥A ⧸ Subgroup.center ↥A) 2 n)) →
    IsPGroup 2 (Subgroup.center ↥A) → IsPGroup 2 (Subgroup.center ↥B) →
    ∀ r : ℕ, r.Prime → r ≠ 2 →
    (∃ N : Subgroup (↥A ⧸ Subgroup.center ↥A), CFSG.Open.IsTwoLocal N ∧ r ∣ Nat.card N) →
    burnsideA134_FAC A B r

private theorem burnsideA134_famFAC_of_bender
    (hB : burnsideA134_FamBender) : burnsideA134_FamFAC := by
  intro X _ _ he A B hAq hBq hc ⟨eA⟩ hT hZA hZB r hr hr2 hN
  haveI : Group.IsPerfect ↥A := hAq.1
  haveI : Group.IsPerfect ↥B := hBq.1
  obtain ⟨cAB⟩ := burnsideA134_centerQuotient_nonempty eA.symm
  rcases hT with ⟨n, hn⟩ | ⟨n, hn⟩ | ⟨hn⟩ | ⟨p, k, hp, hp3, hk1, hk2, hn⟩
  · exact hB X he A B hAq hBq hc ⟨eA⟩ (Or.inl ⟨n, hn⟩) hZA hZB r hr hr2 hN
  · exact hB X he A B hAq hBq hc ⟨eA⟩ (Or.inr ⟨n, hn⟩) hZA hZB r hr hr2 hN
  · obtain ⟨eJ⟩ := hn
    exact burnsideA134_fac_of_noOuter hc (burnsideA134_noOuter_J1 eJ r)
      (burnsideA134_noOuter_J1 (cAB.trans eJ) r)
  · obtain ⟨-, K, _, _, hK, ⟨eK⟩⟩ := hn
    have hk : k = 1 ∨ k = 2 := by omega
    have hno := burnsideA134_noOuter_psl2 hp hK hk hr hr2
    let eP : (↥A ⧸ Subgroup.center ↥A) ≃* CFSG.GorensteinWalter.PSL2 K :=
      eK.trans (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj 2 K).symm
    exact burnsideA134_fac_of_noOuter hc (burnsideA134_noOuter_of_mulEquiv eP hno)
      (burnsideA134_noOuter_of_mulEquiv (cAB.trans eP) hno)

private theorem burnsideA134_complement {Γ : Type*} [Group Γ] (D S : Subgroup Γ)
    (hDS : D ⊓ S = ⊥) {ω : Γ} (hnorm : ∀ d' ∈ D, ω * d' * ω⁻¹ ∈ D) {r m : ℕ}
    (hωm : ω ^ r ^ m = 1) (hωD : ω ∉ D) {d : Γ} (hd : d ∈ D) (hg : d⁻¹ * ω ∈ S) :
    ∃ t : ℕ, (d⁻¹ * ω) ^ r ^ t ≠ 1 ∧ ((d⁻¹ * ω) ^ r ^ t) ^ r = 1 := by
  set g := d⁻¹ * ω with hgdef
  have hkey : ∀ k : ℕ, ∃ d' ∈ D, g ^ k = d' * ω ^ k := by
    intro k
    induction k with
    | zero => exact ⟨1, D.one_mem, by simp⟩
    | succ k ih =>
      obtain ⟨d', hd', hk⟩ := ih
      refine ⟨d⁻¹ * (ω * d' * ω⁻¹), D.mul_mem (D.inv_mem hd) (hnorm d' hd'), ?_⟩
      rw [pow_succ', hk, hgdef]
      group
  have hg1 : g ≠ 1 := by
    intro h
    apply hωD
    have : ω = d := by
      have h' : d⁻¹ * ω = 1 := h
      calc ω = d * (d⁻¹ * ω) := by group
        _ = d := by rw [h', mul_one]
    rw [this]
    exact hd
  have hgm : g ^ r ^ m = 1 := by
    obtain ⟨d', hd', hk⟩ := hkey (r ^ m)
    rw [hωm, mul_one] at hk
    have hmemS : g ^ r ^ m ∈ S := Subgroup.pow_mem _ hg _
    have hmemD : g ^ r ^ m ∈ D := hk ▸ hd'
    have : g ^ r ^ m ∈ D ⊓ S := ⟨hmemD, hmemS⟩
    rw [hDS] at this
    exact this
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hg1 (by simpa using hgm)
  obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
  have hex : ∃ t : ℕ, g ^ r ^ (t + 1) = 1 := ⟨m', hgm⟩
  classical
  refine ⟨Nat.find hex, ?_, ?_⟩
  · rcases Nat.eq_zero_or_pos (Nat.find hex) with h0 | hpos
    · rw [h0]
      simpa using hg1
    · obtain ⟨t', ht'⟩ : ∃ t', Nat.find hex = t' + 1 := ⟨Nat.find hex - 1, by omega⟩
      have := Nat.find_min hex (show t' < Nat.find hex by omega)
      rw [ht']
      exact this
  · rw [← pow_mul, ← pow_succ]
    exact Nat.find_spec hex

@[expose] def burnsideA134_Fixes {Y : Type*} [Group Y] (φ : MulAut Y) (T : Subgroup Y) : Prop :=
  ∀ t : Y, t ∈ T ↔ φ t ∈ T

@[expose] def burnsideA134_zT {Y : Type*} [Group Y] (T : Subgroup Y) : Subgroup Y :=
  (Subgroup.center ↥T).map T.subtype

private theorem burnsideA134_mem_zT {Y : Type*} [Group Y] {T : Subgroup Y} {x : Y} :
    x ∈ burnsideA134_zT T ↔ x ∈ T ∧ ∀ t ∈ T, t * x = x * t := by
  constructor
  · rintro ⟨⟨x', hx'⟩, hxc, rfl⟩
    refine ⟨hx', fun t ht => ?_⟩
    have := Subgroup.mem_center_iff.mp hxc ⟨t, ht⟩
    exact congrArg Subtype.val this
  · rintro ⟨hx, hc⟩
    exact ⟨⟨x, hx⟩, Subgroup.mem_center_iff.mpr fun t => Subtype.ext (hc t t.2), rfl⟩

private theorem burnsideA134_Fixes.zT {Y : Type*} [Group Y] {φ : MulAut Y} {T : Subgroup Y}
    (h : burnsideA134_Fixes φ T) {v : Y} (hv : v ∈ burnsideA134_zT T) :
    φ v ∈ burnsideA134_zT T := by
  rw [burnsideA134_mem_zT] at hv ⊢
  refine ⟨(h v).mp hv.1, fun t ht => ?_⟩
  obtain ⟨t', ht', rfl⟩ : ∃ t', t' ∈ T ∧ φ t' = t := by
    refine ⟨φ.symm t, ?_, by simp⟩
    rw [h]
    simpa using ht
  rw [← map_mul, ← map_mul, hv.2 t' ht']

private theorem burnsideA134_fixes_one {Y : Type*} [Group Y] (T : Subgroup Y) :
    burnsideA134_Fixes (1 : MulAut Y) T := fun _ => Iff.rfl

private theorem burnsideA134_fixes_mul {Y : Type*} [Group Y] {φ ψ : MulAut Y} {T : Subgroup Y}
    (hφ : burnsideA134_Fixes φ T) (hψ : burnsideA134_Fixes ψ T) :
    burnsideA134_Fixes (φ * ψ) T := fun t => (hψ t).trans (hφ (ψ t))

private theorem burnsideA134_fixes_inv {Y : Type*} [Group Y] {φ : MulAut Y} {T : Subgroup Y}
    (hφ : burnsideA134_Fixes φ T) : burnsideA134_Fixes φ⁻¹ T := fun t => by
  rw [hφ (φ⁻¹ t)]
  simp

private theorem burnsideA134_fixes_conj {Y : Type*} [Group Y] {T : Subgroup Y} {d : Y}
    (hd : d ∈ Subgroup.normalizer (T : Set Y)) :
    burnsideA134_Fixes (MulAut.conj d) T := fun t => by
  rw [MulAut.conj_apply]
  exact Subgroup.mem_normalizer_iff.mp hd t

@[expose] def burnsideA134_BenderFix (r : ℕ) (Y : Type*) [Group Y] (φ : MulAut Y) : Prop :=
  ∃ T₁ T₂ : Subgroup Y, IsPGroup 2 T₁ ∧ T₁ ≠ ⊥ ∧ burnsideA134_Fixes φ T₁ ∧
    burnsideA134_Fixes φ T₂ ∧
    r ∣ Nat.card ↥(Subgroup.normalizer (T₁ : Set Y) ⊓ Subgroup.normalizer (T₂ : Set Y)) ∧
    ∀ v ∈ burnsideA134_zT T₁, v ≠ 1 → ∀ w ∈ burnsideA134_zT T₁, w ≠ 1 →
      ∃! d : Y, d ∈ Subgroup.normalizer (T₁ : Set Y) ⊓ Subgroup.normalizer (T₂ : Set Y) ∧
        d * v * d⁻¹ = w

private theorem burnsideA134_exists_zT {Y : Type*} [Group Y] [Finite Y] {T : Subgroup Y}
    (h2 : IsPGroup 2 T) (hne : T ≠ ⊥) : ∃ v ∈ burnsideA134_zT T, v ≠ 1 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Nontrivial ↥T := (Subgroup.nontrivial_iff_ne_bot T).mpr hne
  haveI := h2.center_nontrivial
  obtain ⟨c, hc⟩ := exists_ne (1 : ↥(Subgroup.center ↥T))
  refine ⟨((c : ↥T) : Y), ⟨c, c.2, rfl⟩, fun h => hc ?_⟩
  apply Subtype.ext
  apply Subtype.ext
  simpa using h

private theorem burnsideA134_ap {Y₁ Y₂ : Type*} [Group Y₁] [Group Y₂] [Finite Y₁] [Finite Y₂]
    {r : ℕ}
    {Ĝ : Subgroup (MulAut Y₁ × MulAut Y₂)}
    (hI : ∀ (g₁ : Y₁) (g₂ : Y₂),
      ((MulAut.conj g₁, MulAut.conj g₂) : MulAut Y₁ × MulAut Y₂) ∈ Ĝ)
    {ω : MulAut Y₁ × MulAut Y₂} (hω : ω ∈ Ĝ) {m : ℕ} (hωm : ω ^ r ^ m = 1)
    (hωI : ¬ ∃ (g₁ : Y₁) (g₂ : Y₂), ω = (MulAut.conj g₁, MulAut.conj g₂))
    (h₁ : burnsideA134_BenderFix r Y₁ ω.1) (h₂ : burnsideA134_BenderFix r Y₂ ω.2) :
    ∃ τ ∈ Ĝ, τ ^ r = 1 ∧ (¬ ∃ (g₁ : Y₁) (g₂ : Y₂), τ = (MulAut.conj g₁, MulAut.conj g₂)) ∧
      ∃ T₁ T₂ : Subgroup Y₁, IsPGroup 2 T₁ ∧ T₁ ≠ ⊥ ∧ burnsideA134_Fixes τ.1 T₁ ∧
        burnsideA134_Fixes τ.1 T₂ ∧
        r ∣ Nat.card ↥(Subgroup.normalizer (T₁ : Set Y₁) ⊓ Subgroup.normalizer (T₂ : Set Y₁)) := by
  obtain ⟨T₁, T₂, hT₁2, hT₁ne, hT₁f, hT₂f, hrD₁, htr₁⟩ := h₁
  obtain ⟨U₁, U₂, hU₁2, hU₁ne, hU₁f, hU₂f, hrD₂, htr₂⟩ := h₂
  obtain ⟨v₁, hv₁, hv₁1⟩ := burnsideA134_exists_zT hT₁2 hT₁ne
  obtain ⟨v₂, hv₂, hv₂1⟩ := burnsideA134_exists_zT hU₁2 hU₁ne
  let 𝒩 : Subgroup (MulAut Y₁ × MulAut Y₂) :=
    { carrier := {γ | burnsideA134_Fixes γ.1 T₁ ∧ burnsideA134_Fixes γ.1 T₂ ∧
        burnsideA134_Fixes γ.2 U₁ ∧ burnsideA134_Fixes γ.2 U₂}
      one_mem' := ⟨burnsideA134_fixes_one _, burnsideA134_fixes_one _, burnsideA134_fixes_one _,
        burnsideA134_fixes_one _⟩
      mul_mem' := fun {a b} ha hb => ⟨burnsideA134_fixes_mul ha.1 hb.1,
        burnsideA134_fixes_mul ha.2.1 hb.2.1, burnsideA134_fixes_mul ha.2.2.1 hb.2.2.1,
        burnsideA134_fixes_mul ha.2.2.2 hb.2.2.2⟩
      inv_mem' := fun {a} ha => ⟨burnsideA134_fixes_inv ha.1, burnsideA134_fixes_inv ha.2.1,
        burnsideA134_fixes_inv ha.2.2.1, burnsideA134_fixes_inv ha.2.2.2⟩ }
  let 𝒮 : Subgroup (MulAut Y₁ × MulAut Y₂) :=
    { carrier := {γ | γ ∈ 𝒩 ∧ γ.1 v₁ = v₁ ∧ γ.2 v₂ = v₂}
      one_mem' := ⟨𝒩.one_mem, rfl, rfl⟩
      mul_mem' := fun {a b} ha hb => ⟨𝒩.mul_mem ha.1 hb.1, by
        change a.1 (b.1 v₁) = v₁
        rw [hb.2.1, ha.2.1], by
        change a.2 (b.2 v₂) = v₂
        rw [hb.2.2, ha.2.2]⟩
      inv_mem' := fun {a} ha => ⟨𝒩.inv_mem ha.1, by
        change a.1⁻¹ v₁ = v₁
        rw [MulAut.inv_def, MulEquiv.symm_apply_eq]
        exact ha.2.1.symm, by
        change a.2⁻¹ v₂ = v₂
        rw [MulAut.inv_def, MulEquiv.symm_apply_eq]
        exact ha.2.2.symm⟩ }
  let 𝕀 : Subgroup (MulAut Y₁ × MulAut Y₂) :=
    (CFSG.ComponentClassification.OuterAutomorphisms.inner Y₁).prod
      (CFSG.ComponentClassification.OuterAutomorphisms.inner Y₂)
  have hmemI : ∀ γ : MulAut Y₁ × MulAut Y₂, γ ∈ 𝕀 ↔
      ∃ (g₁ : Y₁) (g₂ : Y₂), γ = (MulAut.conj g₁, MulAut.conj g₂) := by
    intro γ
    constructor
    · rintro ⟨⟨g₁, hg₁⟩, ⟨g₂, hg₂⟩⟩
      exact ⟨g₁, g₂, Prod.ext hg₁.symm hg₂.symm⟩
    · rintro ⟨g₁, g₂, rfl⟩
      exact ⟨⟨g₁, rfl⟩, ⟨g₂, rfl⟩⟩
  let 𝒟 : Subgroup (MulAut Y₁ × MulAut Y₂) := 𝒩 ⊓ 𝕀
  have hωN : ω ∈ 𝒩 := ⟨hT₁f, hT₂f, hU₁f, hU₂f⟩
  have hωD : ω ∉ 𝒟 := fun h => hωI ((hmemI ω).mp h.2)
  have hnorm : ∀ d' ∈ 𝒟, ω * d' * ω⁻¹ ∈ 𝒟 := fun d' hd' =>
    ⟨𝒩.mul_mem (𝒩.mul_mem hωN hd'.1) (𝒩.inv_mem hωN),
      (inferInstance : 𝕀.Normal).conj_mem d' hd'.2 ω⟩
  have hDS : 𝒟 ⊓ 𝒮 = ⊥ := by
    rw [eq_bot_iff]
    rintro γ ⟨⟨hγN, hγI⟩, -, hγv₁, hγv₂⟩
    obtain ⟨g₁, g₂, rfl⟩ := (hmemI γ).mp hγI
    have hg₁ : g₁ ∈ Subgroup.normalizer (T₁ : Set Y₁) ⊓ Subgroup.normalizer (T₂ : Set Y₁) :=
      ⟨Subgroup.mem_normalizer_iff.mpr hγN.1, Subgroup.mem_normalizer_iff.mpr hγN.2.1⟩
    have hg₂ : g₂ ∈ Subgroup.normalizer (U₁ : Set Y₂) ⊓ Subgroup.normalizer (U₂ : Set Y₂) :=
      ⟨Subgroup.mem_normalizer_iff.mpr hγN.2.2.1, Subgroup.mem_normalizer_iff.mpr hγN.2.2.2⟩
    have hv₁fix : g₁ * v₁ * g₁⁻¹ = v₁ := by simpa [MulAut.conj_apply] using hγv₁
    have hv₂fix : g₂ * v₂ * g₂⁻¹ = v₂ := by simpa [MulAut.conj_apply] using hγv₂
    obtain ⟨d₁, -, hd₁⟩ := htr₁ v₁ hv₁ hv₁1 v₁ hv₁ hv₁1
    obtain ⟨d₂, -, hd₂⟩ := htr₂ v₂ hv₂ hv₂1 v₂ hv₂ hv₂1
    have e₁ : g₁ = 1 := (hd₁ g₁ ⟨hg₁, hv₁fix⟩).trans
      (hd₁ 1 ⟨⟨Subgroup.one_mem _, Subgroup.one_mem _⟩, by simp⟩).symm
    have e₂ : g₂ = 1 := (hd₂ g₂ ⟨hg₂, hv₂fix⟩).trans
      (hd₂ 1 ⟨⟨Subgroup.one_mem _, Subgroup.one_mem _⟩, by simp⟩).symm
    rw [Subgroup.mem_bot, e₁, e₂]
    simp
  have hω1 : ω.1 v₁ ∈ burnsideA134_zT T₁ := hT₁f.zT hv₁
  have hω2 : ω.2 v₂ ∈ burnsideA134_zT U₁ := hU₁f.zT hv₂
  obtain ⟨δ₁, ⟨hδ₁, hδ₁w⟩, -⟩ := htr₁ v₁ hv₁ hv₁1 (ω.1 v₁) hω1
    (fun h => hv₁1 (by simpa using h))
  obtain ⟨δ₂, ⟨hδ₂, hδ₂w⟩, -⟩ := htr₂ v₂ hv₂ hv₂1 (ω.2 v₂) hω2
    (fun h => hv₂1 (by simpa using h))
  let d : MulAut Y₁ × MulAut Y₂ := (MulAut.conj δ₁, MulAut.conj δ₂)
  have hdN : d ∈ 𝒩 := ⟨burnsideA134_fixes_conj hδ₁.1, burnsideA134_fixes_conj hδ₁.2,
    burnsideA134_fixes_conj hδ₂.1, burnsideA134_fixes_conj hδ₂.2⟩
  have hdI : d ∈ 𝕀 := (hmemI d).mpr ⟨δ₁, δ₂, rfl⟩
  have hdD : d ∈ 𝒟 := ⟨hdN, hdI⟩
  have hgS : d⁻¹ * ω ∈ 𝒮 := by
    refine ⟨𝒩.mul_mem (𝒩.inv_mem hdN) hωN, ?_, ?_⟩
    · change (d.1)⁻¹ (ω.1 v₁) = v₁
      rw [MulAut.inv_def, MulEquiv.symm_apply_eq]
      simpa [d, MulAut.conj_apply] using hδ₁w.symm
    · change (d.2)⁻¹ (ω.2 v₂) = v₂
      rw [MulAut.inv_def, MulEquiv.symm_apply_eq]
      simpa [d, MulAut.conj_apply] using hδ₂w.symm
  obtain ⟨t, ht1, htr⟩ := burnsideA134_complement 𝒟 𝒮 hDS hnorm hωm hωD hdD hgS
  refine ⟨(d⁻¹ * ω) ^ r ^ t, Ĝ.pow_mem (Ĝ.mul_mem (Ĝ.inv_mem (hI δ₁ δ₂)) hω) _, htr, ?_,
    T₁, T₂, hT₁2, hT₁ne, ?_, ?_, hrD₁⟩
  · intro hI'
    have hτS : (d⁻¹ * ω) ^ r ^ t ∈ 𝒮 := 𝒮.pow_mem hgS _
    have hτD : (d⁻¹ * ω) ^ r ^ t ∈ 𝒟 := ⟨hτS.1, (hmemI _).mpr hI'⟩
    have : (d⁻¹ * ω) ^ r ^ t ∈ 𝒟 ⊓ 𝒮 := ⟨hτD, hτS⟩
    rw [hDS] at this
    exact ht1 this
  · exact ((𝒮.pow_mem hgS _).1).1
  · exact ((𝒮.pow_mem hgS _).1).2.1

private theorem burnsideA134_exists_commuting {X : Type} [Group X] [Finite X] {P : Subgroup X}
    {y : X}
    (hy : y ∈ Subgroup.normalizer (P : Set X)) {r k : ℕ} (hr : r.Prime) (hyk : y ^ r ^ k = 1)
    (hrP : r ∣ Nat.card P) : ∃ a ∈ P, orderOf a = r ∧ y * a = a * y := by
  haveI : Fact r.Prime := ⟨hr⟩
  let z₀ : Subgroup.normalizer (P : Set X) := ⟨y, hy⟩
  let H₀ : Subgroup (Subgroup.normalizer (P : Set X)) := Subgroup.zpowers z₀
  have hH₀ : IsPGroup r H₀ := by
    refine IsPGroup.of_card_dvd_pow (n := k) ?_
    rw [Nat.card_zpowers]
    exact orderOf_dvd_of_pow_eq_one (Subtype.ext (by simpa using hyk))
  have hmod := hH₀.card_modEq_card_fixedPoints ↥P
  let K : Subgroup X := P ⊓ Subgroup.centralizer ({y} : Set X)
  have hfix : ∀ p : ↥P, p ∈ MulAction.fixedPoints H₀ ↥P ↔ y * (p : X) = (p : X) * y := by
    intro p
    constructor
    · intro hp
      have := hp ⟨z₀, Subgroup.mem_zpowers z₀⟩
      have h2 := congrArg Subtype.val this
      change y * (p : X) * y⁻¹ = (p : X) at h2
      calc y * (p : X) = y * (p : X) * y⁻¹ * y := by group
        _ = (p : X) * y := by rw [h2]
    · intro hp
      have hz : z₀ ∈ MulAction.stabilizer (Subgroup.normalizer (P : Set X)) p := by
        rw [MulAction.mem_stabilizer_iff]
        apply Subtype.ext
        change y * (p : X) * y⁻¹ = (p : X)
        calc y * (p : X) * y⁻¹ = (p : X) * y * y⁻¹ := by rw [hp]
          _ = (p : X) := by group
      intro g
      have hg : g.1 ∈ MulAction.stabilizer (Subgroup.normalizer (P : Set X)) p :=
        Subgroup.zpowers_le.2 hz g.2
      exact (MulAction.mem_stabilizer_iff.mp hg)
  have hcardK : Nat.card (MulAction.fixedPoints H₀ ↥P) = Nat.card K := by
    refine Nat.card_congr
      { toFun := fun p => ⟨(p.1 : X), p.1.2,
          Subgroup.mem_centralizer_singleton_iff.mpr (((hfix p.1).mp p.2).symm)⟩
        invFun := fun x => ⟨⟨x.1, x.2.1⟩, (hfix ⟨x.1, x.2.1⟩).mpr
          (Subgroup.mem_centralizer_singleton_iff.mp x.2.2).symm⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
  have hrK : r ∣ Nat.card K := by
    rw [← hcardK]
    exact (Nat.modEq_zero_iff_dvd.mp ((hmod.symm.trans (Nat.modEq_zero_iff_dvd.mpr hrP))))
  obtain ⟨w, hw⟩ := exists_prime_orderOf_dvd_card' (G := ↥K) r hrK
  refine ⟨(w : X), w.2.1, by rw [← Subgroup.orderOf_coe] at hw; exact hw, ?_⟩
  exact (Subgroup.mem_centralizer_singleton_iff.mp w.2.2).symm

private theorem burnsideA134_theta_of_centralizes {X : Type} [Group X] (A : Subgroup X) {y : X}
    (hy : y ∈ Subgroup.normalizer (A : Set X)) (h : ∀ a ∈ A, y * a * y⁻¹ = a) :
    burnsideA134_theta A ⟨y, hy⟩ = 1 := by
  apply MulEquiv.ext
  intro x
  obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective x
  rw [burnsideA134_theta_mk]
  change _ = QuotientGroup.mk a
  congr 1
  exact Subtype.ext (h a a.2)

private theorem burnsideA134_centralizes_of_theta_one {X : Type} [Group X] (A : Subgroup X)
    [Group.IsPerfect ↥A] {y : X} (hy : y ∈ Subgroup.normalizer (A : Set X))
    (h : burnsideA134_theta A ⟨y, hy⟩ = 1) : ∀ a ∈ A, y * a * y⁻¹ = a := by
  have h1 := burnsideA134_conj_of_theta A hy (A.one_mem) (by
    rw [h]
    have : (QuotientGroup.mk (⟨1, A.one_mem⟩ : ↥A) : ↥A ⧸ Subgroup.center ↥A) = 1 := rfl
    rw [this, map_one])
  intro a ha
  simpa using h1 a ha

private theorem burnsideA134_theta_eq_conj {X : Type} [Group X] (A : Subgroup X) {y : X}
    (hy : y ∈ Subgroup.normalizer (A : Set X)) {a₀ : X} (ha₀ : a₀ ∈ A)
    (h : ∀ a ∈ A, y * a * y⁻¹ = a₀ * a * a₀⁻¹) :
    burnsideA134_theta A ⟨y, hy⟩ =
      MulAut.conj (QuotientGroup.mk (⟨a₀, ha₀⟩ : ↥A) : ↥A ⧸ Subgroup.center ↥A) := by
  apply MulEquiv.ext
  intro x
  obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective x
  rw [burnsideA134_theta_mk, MulAut.conj_apply]
  change _ = QuotientGroup.mk (⟨a₀, ha₀⟩ * a * ⟨a₀, ha₀⟩⁻¹)
  congr 1
  exact Subtype.ext (h a a.2)

@[expose] def burnsideA134_preim {X : Type} [Group X] (A : Subgroup X)
    (T : Subgroup (↥A ⧸ Subgroup.center ↥A)) : Subgroup X :=
  (T.comap (QuotientGroup.mk' (Subgroup.center ↥A))).map A.subtype

private theorem burnsideA134_mem_preim {X : Type} [Group X] {A : Subgroup X}
    {T : Subgroup (↥A ⧸ Subgroup.center ↥A)} {h : X} :
    h ∈ burnsideA134_preim A T ↔
      ∃ x : ↥A, (QuotientGroup.mk x : ↥A ⧸ Subgroup.center ↥A) ∈ T ∧ (x : X) = h := by
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact ⟨x, hx, rfl⟩
  · rintro ⟨x, hx, rfl⟩
    exact ⟨x, hx, rfl⟩

private theorem burnsideA134_preim_le {X : Type} [Group X] {A : Subgroup X}
    {T : Subgroup (↥A ⧸ Subgroup.center ↥A)} : burnsideA134_preim A T ≤ A := by
  intro h hh
  obtain ⟨x, -, rfl⟩ := burnsideA134_mem_preim.mp hh
  exact x.2

private theorem burnsideA134_normalizes_preim {X : Type} [Group X] (A : Subgroup X)
    (T : Subgroup (↥A ⧸ Subgroup.center ↥A)) {y : X} (hy : y ∈ Subgroup.normalizer (A : Set X))
    (hf : burnsideA134_Fixes (burnsideA134_theta A ⟨y, hy⟩) T) :
    y ∈ Subgroup.normalizer ((burnsideA134_preim A T : Subgroup X) : Set X) := by
  rw [Subgroup.mem_normalizer_iff]
  intro h
  constructor
  · intro hh
    obtain ⟨x, hxT, rfl⟩ := burnsideA134_mem_preim.mp hh
    refine burnsideA134_mem_preim.mpr ⟨⟨y * x * y⁻¹, (hy x).mp x.2⟩, ?_, rfl⟩
    have := (hf _).mp hxT
    rwa [burnsideA134_theta_mk] at this
  · intro hh
    obtain ⟨x', hx'T, hx'⟩ := burnsideA134_mem_preim.mp hh
    have hhA : h ∈ A := (hy h).mpr (hx' ▸ x'.2)
    refine burnsideA134_mem_preim.mpr ⟨⟨h, hhA⟩, ?_, rfl⟩
    have h2 : burnsideA134_theta A ⟨y, hy⟩ (QuotientGroup.mk (⟨h, hhA⟩ : ↥A)) =
        QuotientGroup.mk x' := by
      rw [burnsideA134_theta_mk]
      congr 1
      exact Subtype.ext hx'.symm
    exact (hf _).mpr (h2 ▸ hx'T)

private theorem burnsideA134_preim_ne_bot {X : Type} [Group X] (A : Subgroup X)
    {T : Subgroup (↥A ⧸ Subgroup.center ↥A)} (hT : T ≠ ⊥) : burnsideA134_preim A T ≠ ⊥ := by
  intro hS
  apply hT
  rw [eq_bot_iff]
  intro xq hxq
  obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective xq
  have hx : (x : X) ∈ burnsideA134_preim A T := burnsideA134_mem_preim.mpr ⟨x, hxq, rfl⟩
  rw [hS, Subgroup.mem_bot] at hx
  have hx1 : x = 1 := Subtype.ext hx
  rw [hx1]
  exact Subgroup.one_mem _

private theorem burnsideA134_preim_isPGroup {X : Type} [Group X] (A : Subgroup X)
    (hZ : IsPGroup 2 (Subgroup.center ↥A)) {T : Subgroup (↥A ⧸ Subgroup.center ↥A)}
    (hT : IsPGroup 2 T) : IsPGroup 2 (burnsideA134_preim A T) := by
  rintro ⟨s, hs⟩
  obtain ⟨x, hxT, rfl⟩ := burnsideA134_mem_preim.mp hs
  obtain ⟨k, hk⟩ := hT ⟨QuotientGroup.mk x, hxT⟩
  have hk' : (QuotientGroup.mk (x ^ 2 ^ k) : ↥A ⧸ Subgroup.center ↥A) = 1 := by
    have := congrArg (fun z : ↥T => (z : ↥A ⧸ Subgroup.center ↥A)) hk
    simpa [QuotientGroup.mk_pow] using this
  have hxz : x ^ 2 ^ k ∈ Subgroup.center ↥A := (QuotientGroup.eq_one_iff _).mp hk'
  obtain ⟨j, hj⟩ := hZ ⟨_, hxz⟩
  refine ⟨k + j, ?_⟩
  apply Subtype.ext
  have := congrArg (fun z : ↥(Subgroup.center ↥A) => ((z : ↥A) : X)) hj
  simp only [SubgroupClass.coe_pow, OneMemClass.coe_one] at this
  simpa [pow_add, pow_mul] using this

private theorem burnsideA134_fixes_normalizer_mem {Y : Type*} [Group Y] {φ : MulAut Y} {T :
    Subgroup Y}
    (h : burnsideA134_Fixes φ T) {x : Y} (hx : x ∈ Subgroup.normalizer (T : Set Y)) :
    φ x ∈ Subgroup.normalizer (T : Set Y) := by
  rw [Subgroup.mem_normalizer_iff] at hx ⊢
  intro t
  obtain ⟨t', rfl⟩ : ∃ t', φ t' = t := ⟨φ.symm t, by simp⟩
  rw [← h t', hx t', ← map_inv, ← map_mul, ← map_mul, ← h]

private theorem burnsideA134_fixes_normalizer {Y : Type*} [Group Y] {φ : MulAut Y} {T : Subgroup Y}
    (h : burnsideA134_Fixes φ T) :
    burnsideA134_Fixes φ (Subgroup.normalizer (T : Set Y)) := fun x =>
  ⟨burnsideA134_fixes_normalizer_mem h, fun hx => by
    have := burnsideA134_fixes_normalizer_mem (burnsideA134_fixes_inv h) hx
    simpa using this⟩

private theorem burnsideA134_fixes_inf {Y : Type*} [Group Y] {φ : MulAut Y} {S T : Subgroup Y}
    (hS : burnsideA134_Fixes φ S) (hT : burnsideA134_Fixes φ T) :
    burnsideA134_Fixes φ (S ⊓ T) := fun x => and_congr (hS x) (hT x)

private theorem burnsideA134_exists_rElement_lift {G H : Type*} [Group G] [Finite G] [Group H]
    (Θ : G →* H) {τ : H} (hτ : τ ∈ Θ.range) {r : ℕ} (hr : r.Prime) (hτr : τ ^ r = 1) :
    ∃ x : G, Θ x = τ ∧ ∃ i : ℕ, x ^ r ^ i = 1 := by
  obtain ⟨x₀, rfl⟩ := hτ
  obtain ⟨i, s, hs, ho⟩ := Nat.exists_eq_pow_mul_and_not_dvd
    (orderOf_pos x₀).ne' r hr.ne_one
  have hcop : Nat.Coprime s (orderOf (Θ x₀)) := by
    have h1 : orderOf (Θ x₀) ∣ r := orderOf_dvd_of_pow_eq_one hτr
    exact Nat.Coprime.coprime_dvd_right h1 ((Nat.Prime.coprime_iff_not_dvd hr).2 hs).symm
  obtain ⟨m, hm⟩ := exists_pow_eq_self_of_coprime hcop
  refine ⟨(x₀ ^ s) ^ m, ?_, i, ?_⟩
  · rw [map_pow, map_pow, hm]
  · rw [← pow_mul, ← pow_mul]
    have : s * (m * r ^ i) = orderOf x₀ * m := by rw [ho]; ring
    rw [this, pow_mul, pow_orderOf_eq_one, one_pow]

private theorem burnsideA134_card_dvd_preim {X : Type} [Group X] (A : Subgroup X)
    (D : Subgroup (↥A ⧸ Subgroup.center ↥A)) :
    Nat.card D ∣ Nat.card (burnsideA134_preim A D) := by
  let π := QuotientGroup.mk' (Subgroup.center ↥A)
  let f : ↥(D.comap π) →* ↥D :=
    { toFun := fun x => ⟨π (x : ↥A), x.2⟩
      map_one' := Subtype.ext (map_one π)
      map_mul' := fun x y => Subtype.ext (map_mul π (x : ↥A) (y : ↥A)) }
  have hf : Function.Surjective f := by
    rintro ⟨d, hd⟩
    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective d
    exact ⟨⟨a, hd⟩, rfl⟩
  have h1 := Subgroup.card_dvd_of_surjective (f := f) hf
  have h2 : Nat.card ↥(burnsideA134_preim A D) = Nat.card ↥(D.comap π) :=
    Subgroup.card_map_of_injective A.subtype_injective
  rwa [h2]

noncomputable def burnsideA134_Theta {X : Type} [Group X] (A B : Subgroup X) :
    ↥(Subgroup.normalizer (A : Set X) ⊓ Subgroup.normalizer (B : Set X)) →*
      MulAut (↥A ⧸ Subgroup.center ↥A) × MulAut (↥B ⧸ Subgroup.center ↥B) :=
  ((burnsideA134_theta A).comp (Subgroup.inclusion inf_le_left)).prod
    ((burnsideA134_theta B).comp (Subgroup.inclusion inf_le_right))

private theorem burnsideA134_fac_of_benderFix {X : Type} [Group X] [Finite X]
    (he : CFSG.Open.evenRank X ≤ 2) {A B : Subgroup X}
    [Group.IsPerfect ↥A] [Group.IsPerfect ↥B] (hc : ∀ a ∈ A, ∀ b ∈ B, Commute a b)
    (e : ↥A ≃* ↥B) (hZA : IsPGroup 2 (Subgroup.center ↥A))
    (hZB : IsPGroup 2 (Subgroup.center ↥B)) {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2)
    {S : Subgroup X} (hS : S ≠ ⊥) (hS2 : IsPGroup 2 S) (hSA : S ≤ A) {a : X} (haA : a ∈ A)
    (haS : a ∈ Subgroup.normalizer (S : Set X)) (ha : orderOf a = r)
    (hbf : ∀ (y : X) (hyA : y ∈ Subgroup.normalizer (A : Set X))
      (hyB : y ∈ Subgroup.normalizer (B : Set X)), (∃ k : ℕ, y ^ r ^ k = 1) →
      burnsideA134_BenderFix r (↥A ⧸ Subgroup.center ↥A) (burnsideA134_theta A ⟨y, hyA⟩) ∧
      burnsideA134_BenderFix r (↥B ⧸ Subgroup.center ↥B) (burnsideA134_theta B ⟨y, hyB⟩)) :
    burnsideA134_FAC A B r := by
  haveI : Fact r.Prime := ⟨hr⟩
  let c : X := (e ⟨a, haA⟩ : ↥B)
  have hcB : c ∈ B := (e ⟨a, haA⟩).2
  have hcr : orderOf c = r := by
    rw [← ha]
    calc orderOf c = orderOf (e ⟨a, haA⟩) := Subgroup.orderOf_coe _
      _ = orderOf (⟨a, haA⟩ : ↥A) := MulEquiv.orderOf_eq e _
      _ = orderOf a := Subgroup.orderOf_mk _ _
  intro y hyA hyB hyr
  by_contra hfac
  have hCr : ∀ z ∈ Subgroup.centralizer ((A ⊔ B : Subgroup X) : Set X),
      (∃ k : ℕ, z ^ r ^ k = 1) → z = 1 := by
    intro z hz ⟨k, hk⟩
    by_contra hz1
    set C : Subgroup X := Subgroup.centralizer ((A ⊔ B : Subgroup X) : Set X) with hC
    have hdvd : r ∣ orderOf z := by
      have h1 : orderOf z ∣ r ^ k := orderOf_dvd_of_pow_eq_one hk
      obtain ⟨j, -, hjo⟩ := (Nat.dvd_prime_pow hr).1 h1
      have hj : j ≠ 0 := by
        rintro rfl
        rw [pow_zero] at hjo
        exact hz1 (orderOf_eq_one_iff.mp hjo)
      rw [hjo]
      exact dvd_pow_self r hj
    have hrC : r ∣ Nat.card C := hdvd.trans (by
      have := orderOf_dvd_natCard (⟨z, hz⟩ : ↥C)
      rwa [Subgroup.orderOf_mk] at this)
    obtain ⟨w, hw⟩ := exists_prime_orderOf_dvd_card' (G := ↥C) r hrC
    exact burnsideA134_false_of_centralizer_element he hc hZA hZB hr hr2 hS hS2 hSA haA haS ha
      hcB hcr w.2 (by rw [← Subgroup.orderOf_coe] at hw; exact hw)
  let Θ := burnsideA134_Theta A B
  let y₀ : ↥(Subgroup.normalizer (A : Set X) ⊓ Subgroup.normalizer (B : Set X)) :=
    ⟨y, hyA, hyB⟩
  have hI : ∀ (g₁ : ↥A ⧸ Subgroup.center ↥A) (g₂ : ↥B ⧸ Subgroup.center ↥B),
      ((MulAut.conj g₁, MulAut.conj g₂) :
        MulAut (↥A ⧸ Subgroup.center ↥A) × MulAut (↥B ⧸ Subgroup.center ↥B)) ∈ Θ.range := by
    intro g₁ g₂
    obtain ⟨⟨a₁, ha₁⟩, rfl⟩ := QuotientGroup.mk_surjective g₁
    obtain ⟨⟨b₁, hb₁⟩, rfl⟩ := QuotientGroup.mk_surjective g₂
    have hb₁A : b₁ ∈ Subgroup.normalizer (A : Set X) :=
      Subgroup.centralizer_le_normalizer (A : Set X)
        (Subgroup.mem_centralizer_iff.mpr fun g hg => (hc g hg b₁ hb₁).eq)
    have ha₁B : a₁ ∈ Subgroup.normalizer (B : Set X) :=
      Subgroup.centralizer_le_normalizer (B : Set X)
        (Subgroup.mem_centralizer_iff.mpr fun g hg => (hc a₁ ha₁ g hg).eq.symm)
    have hxA : a₁ * b₁ ∈ Subgroup.normalizer (A : Set X) :=
      Subgroup.mul_mem _ (Subgroup.le_normalizer ha₁) hb₁A
    have hxB : a₁ * b₁ ∈ Subgroup.normalizer (B : Set X) :=
      Subgroup.mul_mem _ ha₁B (Subgroup.le_normalizer hb₁)
    refine ⟨⟨a₁ * b₁, hxA, hxB⟩, ?_⟩
    apply Prod.ext
    · exact burnsideA134_theta_eq_conj A hxA ha₁ (fun a ha => by
        have h := (hc a ha b₁ hb₁).eq
        calc a₁ * b₁ * a * (a₁ * b₁)⁻¹ = a₁ * (b₁ * a) * b₁⁻¹ * a₁⁻¹ := by group
          _ = a₁ * (a * b₁) * b₁⁻¹ * a₁⁻¹ := by rw [← h]
          _ = a₁ * a * a₁⁻¹ := by group)
    · exact burnsideA134_theta_eq_conj B hxB hb₁ (fun b hb => by
        have hm : (b₁ * b * b₁⁻¹ : X) ∈ B := B.mul_mem (B.mul_mem hb₁ hb) (B.inv_mem hb₁)
        have h := (hc a₁ ha₁ _ hm).eq
        calc a₁ * b₁ * b * (a₁ * b₁)⁻¹ = a₁ * (b₁ * b * b₁⁻¹) * a₁⁻¹ := by group
          _ = (b₁ * b * b₁⁻¹) * a₁ * a₁⁻¹ := by rw [h]
          _ = b₁ * b * b₁⁻¹ := by group)
  have hωI : ¬ ∃ (g₁ : ↥A ⧸ Subgroup.center ↥A) (g₂ : ↥B ⧸ Subgroup.center ↥B),
      Θ y₀ = (MulAut.conj g₁, MulAut.conj g₂) := by
    rintro ⟨g₁, g₂, hg⟩
    obtain ⟨a₀, rfl⟩ := QuotientGroup.mk_surjective g₁
    obtain ⟨b₀, rfl⟩ := QuotientGroup.mk_surjective g₂
    exact hfac (burnsideA134_factor_of_inner hc hyA hyB ⟨a₀, a₀.2, congrArg Prod.fst hg⟩
      ⟨b₀, b₀.2, congrArg Prod.snd hg⟩)
  obtain ⟨h₁, h₂⟩ := hbf y hyA hyB hyr
  obtain ⟨k, hk⟩ := hyr
  have hωk : (Θ y₀) ^ r ^ k = 1 := by
    rw [← map_pow]
    have : y₀ ^ r ^ k = 1 := Subtype.ext (by simpa using hk)
    rw [this, map_one]
  obtain ⟨τ, hτG, hτr, hτI, T₁, T₂, hT₁2, hT₁ne, hT₁f, hT₂f, hrD⟩ :=
    burnsideA134_ap (Ĝ := Θ.range) hI ⟨y₀, rfl⟩ hωk hωI h₁ h₂
  obtain ⟨x, hx, i, hxi⟩ := burnsideA134_exists_rElement_lift Θ hτG hr hτr
  have hy₃A : (x : X) ∈ Subgroup.normalizer (A : Set X) := x.2.1
  have hy₃B : (x : X) ∈ Subgroup.normalizer (B : Set X) := x.2.2
  have hθA : burnsideA134_theta A ⟨(x : X), hy₃A⟩ = τ.1 := congrArg Prod.fst hx
  have hθB : burnsideA134_theta B ⟨(x : X), hy₃B⟩ = τ.2 := congrArg Prod.snd hx
  have hxi' : (x : X) ^ r ^ i = 1 := by
    have := congrArg (fun z : ↥(Subgroup.normalizer (A : Set X) ⊓
      Subgroup.normalizer (B : Set X)) => (z : X)) hxi
    simpa using this
  have hxr : (x : X) ^ r = 1 := by
    have h1 : Θ (x ^ r) = 1 := by rw [map_pow, hx, hτr]
    have hz1 : ((x ^ r : ↥(Subgroup.normalizer (A : Set X) ⊓ Subgroup.normalizer (B : Set X))) :
        X) = (x : X) ^ r := rfl
    have hcA := burnsideA134_centralizes_of_theta_one A (x ^ r).2.1 (congrArg Prod.fst h1)
    have hcB' := burnsideA134_centralizes_of_theta_one B (x ^ r).2.2 (congrArg Prod.snd h1)
    rw [hz1] at hcA hcB'
    have hz : (x : X) ^ r ∈ Subgroup.centralizer ((A ⊔ B : Subgroup X) : Set X) := by
      rw [Subgroup.mem_centralizer_iff]
      intro g hg
      have hsup : A ⊔ B ≤ Subgroup.centralizer ({(x : X) ^ r} : Set X) := by
        refine sup_le (fun a ha => ?_) (fun b hb => ?_)
        · rw [Subgroup.mem_centralizer_singleton_iff]
          have := hcA a ha
          have h2 : (x : X) ^ r * a = a * (x : X) ^ r :=
            calc (x : X) ^ r * a = (x : X) ^ r * a * ((x : X) ^ r)⁻¹ * (x : X) ^ r := by group
              _ = a * (x : X) ^ r := by rw [this]
          exact h2.symm
        · rw [Subgroup.mem_centralizer_singleton_iff]
          have := hcB' b hb
          have h2 : (x : X) ^ r * b = b * (x : X) ^ r :=
            calc (x : X) ^ r * b = (x : X) ^ r * b * ((x : X) ^ r)⁻¹ * (x : X) ^ r := by group
              _ = b * (x : X) ^ r := by rw [this]
          exact h2.symm
      exact (Subgroup.mem_centralizer_singleton_iff.mp (hsup hg))
    exact hCr _ hz ⟨i, by rw [← pow_mul, mul_comm, pow_mul, hxi', one_pow]⟩
  have hy₃AB : (x : X) ∉ A ⊔ B := by
    intro hmem
    obtain ⟨a', ha', b', hb', hab⟩ := burnsideA134_mem_sup_of_commute hc hmem
    apply hτI
    refine ⟨QuotientGroup.mk ⟨a', ha'⟩, QuotientGroup.mk ⟨b', hb'⟩, Prod.ext ?_ ?_⟩
    · refine hθA.symm.trans (burnsideA134_theta_eq_conj A hy₃A ha' (fun a ha => ?_))
      have h := (hc a ha b' hb').eq
      rw [hab]
      calc a' * b' * a * (a' * b')⁻¹ = a' * (b' * a) * b'⁻¹ * a'⁻¹ := by group
        _ = a' * (a * b') * b'⁻¹ * a'⁻¹ := by rw [← h]
        _ = a' * a * a'⁻¹ := by group
    · refine hθB.symm.trans (burnsideA134_theta_eq_conj B hy₃B hb' (fun b hb => ?_))
      rw [hab]
      have hm : (b' * b * b'⁻¹ : X) ∈ B := B.mul_mem (B.mul_mem hb' hb) (B.inv_mem hb')
      have h := (hc a' ha' _ hm).eq
      calc a' * b' * b * (a' * b')⁻¹ = a' * (b' * b * b'⁻¹) * a'⁻¹ := by group
        _ = (b' * b * b'⁻¹) * a' * a'⁻¹ := by rw [h]
        _ = b' * b * b'⁻¹ := by group
  have hy₃ne : (x : X) ≠ 1 := fun h => hy₃AB (h ▸ (A ⊔ B).one_mem)
  have hy₃ord : orderOf (x : X) = r := orderOf_eq_prime hxr hy₃ne
  have hS₁ne := burnsideA134_preim_ne_bot A hT₁ne
  have hS₁2 := burnsideA134_preim_isPGroup A hZA hT₁2
  have hS₁A : burnsideA134_preim A T₁ ≤ A := burnsideA134_preim_le
  have hy₃S : (x : X) ∈ Subgroup.normalizer ((burnsideA134_preim A T₁ : Subgroup X) : Set X) :=
    burnsideA134_normalizes_preim A T₁ hy₃A (by rw [hθA]; exact hT₁f)
  have hFD : burnsideA134_Fixes (burnsideA134_theta A ⟨(x : X), hy₃A⟩)
      (Subgroup.normalizer (T₁ : Set (↥A ⧸ Subgroup.center ↥A)) ⊓
        Subgroup.normalizer (T₂ : Set (↥A ⧸ Subgroup.center ↥A))) := by
    rw [hθA]
    exact burnsideA134_fixes_inf (burnsideA134_fixes_normalizer hT₁f)
      (burnsideA134_fixes_normalizer hT₂f)
  have hy₃P := burnsideA134_normalizes_preim A _ hy₃A hFD
  have hrP := hrD.trans (burnsideA134_card_dvd_preim A _)
  obtain ⟨a₁, ha₁P, ha₁r, ha₁c⟩ := burnsideA134_exists_commuting hy₃P hr hxi' hrP
  have ha₁A : a₁ ∈ A := burnsideA134_preim_le ha₁P
  have ha₁S : a₁ ∈ Subgroup.normalizer ((burnsideA134_preim A T₁ : Subgroup X) : Set X) := by
    obtain ⟨u, huD, hu⟩ := burnsideA134_mem_preim.mp ha₁P
    refine burnsideA134_normalizes_preim A T₁ (Subgroup.le_normalizer ha₁A) ?_
    have hth : burnsideA134_theta A ⟨a₁, Subgroup.le_normalizer ha₁A⟩ =
        MulAut.conj (QuotientGroup.mk (⟨(u : X), u.2⟩ : ↥A) : ↥A ⧸ Subgroup.center ↥A) :=
      burnsideA134_theta_eq_conj A _ u.2 (fun a ha => by rw [← hu])
    rw [hth]
    exact burnsideA134_fixes_conj huD.1
  have hrB : r ∣ Nat.card B := by
    have h1 : r ∣ Nat.card A := by
      have := orderOf_dvd_natCard (⟨a, haA⟩ : ↥A)
      rwa [Subgroup.orderOf_mk, ha] at this
    rwa [← Nat.card_congr e.toEquiv]
  obtain ⟨c₁, hc₁B, hc₁r, hc₁c⟩ := burnsideA134_exists_commuting hy₃B hr hxi' hrB
  exact burnsideA134_false_of_triple he hc hZA hr hr2 hS₁ne hS₁2 hS₁A ha₁A ha₁S ha₁r hc₁B hc₁r
    hy₃S hy₃ord hy₃AB ha₁c hc₁c

private theorem burnsideA134_zT_eq {Y : Type*} [Group Y] (T : Subgroup Y) :
    burnsideA134_zT T = CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter T := by
  ext x
  rw [burnsideA134_mem_zT, CFSG.ComponentClassification.AschbacherToolkit.Bender.mem_sylowCenter]

private theorem burnsideA134_card_normalizer_borel {Y : Type} [Group Y] [Finite Y] {T : Sylow 2 Y}
    {D : Subgroup Y} (h : CFSG.Goldschmidt.G3a.BorelSetup T D) :
    Nat.card (Subgroup.normalizer ((T : Subgroup Y) : Set Y)) =
      Nat.card (T : Subgroup Y) * Nat.card D := by
  rw [← h.sup]
  exact CFSG.GorensteinWalter.card_sup_eq_mul_of_disjoint_of_le_normalizer _ _ h.le
    (disjoint_iff.mpr h.inf)

private theorem burnsideA134_benderFix_of_borel {Y : Type} [Group Y] [Finite Y] [IsSimpleGroup Y]
    (hbor : ∀ T : Sylow 2 Y, ∃ D : Subgroup Y, CFSG.Goldschmidt.G3a.BorelSetup T D ∧
      Nat.card D + 1 =
        Nat.card (CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter
          (T : Subgroup Y)) ∧
      (Nat.card (T : Subgroup Y) =
          Nat.card (CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter
            (T : Subgroup Y)) ∨
        Nat.card (T : Subgroup Y) =
          Nat.card (CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter
            (T : Subgroup Y)) ^ 2))
    {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2)
    (hN : ∃ N : Subgroup Y, CFSG.Open.IsTwoLocal N ∧ r ∣ Nat.card N)
    (φ : MulAut Y) (hφ : ∃ k : ℕ, φ ^ r ^ k = 1) : burnsideA134_BenderFix r Y φ := by
  haveI : Fact r.Prime := ⟨hr⟩
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨k, hk⟩ := hφ
  obtain ⟨N, ⟨R₀, hR₀1, hR₀2, rfl⟩, hrN⟩ := hN
  obtain ⟨T₀, hT₀⟩ := hR₀2.exists_le_sylow
  obtain ⟨D₀, hB₀, hDq₀, hTq₀⟩ := hbor T₀
  have hNR : Subgroup.normalizer (R₀ : Set Y) ≤
      Subgroup.normalizer ((T₀ : Subgroup Y) : Set Y) := by
    intro g hg
    by_contra hgM
    set M := Subgroup.normalizer ((T₀ : Subgroup Y) : Set Y) with hM
    have hodd := hB₀.se.2.2 g hgM
    have hle : R₀ ≤ M ⊓ M.map (MulAut.conj g⁻¹).toMonoidHom := by
      intro x hx
      refine ⟨Subgroup.le_normalizer (hT₀ hx), g * x * g⁻¹,
        Subgroup.le_normalizer (hT₀ ?_), ?_⟩
      · exact (Subgroup.mem_normalizer_iff.mp hg x).mp hx
      · change g⁻¹ * (g * x * g⁻¹) * g⁻¹⁻¹ = x
        group
    have hdvd := Subgroup.card_dvd_of_le hle
    obtain ⟨a, ha⟩ := (IsPGroup.iff_card).mp hR₀2
    have ha0 : a ≠ 0 := by
      rintro rfl
      rw [pow_zero] at ha
      exact hR₀1 (Subgroup.eq_bot_of_card_eq _ ha)
    rw [ha] at hdvd
    exact (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr ((dvd_pow_self 2 ha0).trans hdvd))
  have hrNT₀ : r ∣ Nat.card (Subgroup.normalizer ((T₀ : Subgroup Y) : Set Y)) :=
    hrN.trans (Subgroup.card_dvd_of_le hNR)
  have hNcard : ∀ T : Sylow 2 Y, Nat.card (Subgroup.normalizer ((T : Subgroup Y) : Set Y)) =
      Nat.card (Subgroup.normalizer ((T₀ : Subgroup Y) : Set Y)) := by
    have e : ∀ T : Sylow 2 Y, Nat.card (Subgroup.normalizer ((T : Subgroup Y) : Set Y)) *
        Nat.card (Sylow 2 Y) = Nat.card Y := fun T => by
      rw [← Subgroup.card_mul_index (Subgroup.normalizer ((T : Subgroup Y) : Set Y))]
      congr 1
      exact Sylow.card_eq_index_normalizer T
    intro T
    exact Nat.eq_of_mul_eq_mul_right Nat.card_pos ((e T).trans (e T₀).symm)
  have hrD : ∀ (T : Sylow 2 Y) (D : Subgroup Y), CFSG.Goldschmidt.G3a.BorelSetup T D →
      r ∣ Nat.card D := by
    intro T D hB
    have h1 : r ∣ Nat.card (Subgroup.normalizer ((T : Subgroup Y) : Set Y)) :=
      (hNcard T) ▸ hrNT₀
    rw [burnsideA134_card_normalizer_borel hB] at h1
    obtain ⟨a, ha⟩ := (IsPGroup.iff_card).mp T.isPGroup'
    have hcop : Nat.Coprime r (Nat.card (T : Subgroup Y)) := by
      rw [ha]
      exact Nat.Coprime.pow_right a ((Nat.coprime_primes hr Nat.prime_two).2 hr2)
    exact hcop.dvd_of_dvd_mul_left h1
  have hmodSyl : Nat.card (Sylow 2 Y) ≡ 2 [MOD r] := by
    have h1 : Nat.card (Sylow 2 Y) = Nat.card (T₀ : Subgroup Y) + 1 := hB₀.card
    have hq : Nat.card (CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter
        (T₀ : Subgroup Y)) ≡ 1 [MOD r] := by
      rw [← hDq₀]
      have := hrD T₀ D₀ hB₀
      exact (Nat.ModEq.add_right 1 ((Nat.modEq_zero_iff_dvd).2 this)).trans (by simp [Nat.ModEq])
    have hT : Nat.card (T₀ : Subgroup Y) ≡ 1 [MOD r] := by
      rcases hTq₀ with h | h
      · rw [h]; exact hq
      · rw [h]; simpa using hq.pow 2
    rw [h1]
    exact hT.add_right 1
  let H₀ : Subgroup (MulAut Y) := Subgroup.zpowers φ
  have hH₀ : IsPGroup r H₀ := by
    refine IsPGroup.of_card_dvd_pow (n := k) ?_
    rw [Nat.card_zpowers]
    exact orderOf_dvd_of_pow_eq_one hk
  have hmod := hH₀.card_modEq_card_fixedPoints (Sylow 2 Y)
  have hfp : 1 < Nat.card (MulAction.fixedPoints H₀ (Sylow 2 Y)) := by
    by_contra hle
    have hle' : Nat.card (MulAction.fixedPoints H₀ (Sylow 2 Y)) ≤ 1 := not_lt.mp hle
    have h2 : (2 : ℕ) ≡ Nat.card (MulAction.fixedPoints H₀ (Sylow 2 Y)) [MOD r] :=
      hmodSyl.symm.trans hmod
    rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hle' with h0 | h1
    · rw [h0] at h2
      exact hr2 ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).1 (Nat.modEq_zero_iff_dvd.mp h2))
    · rw [h1] at h2
      have : r ∣ 2 - 1 := (Nat.modEq_iff_dvd' (by norm_num : 1 ≤ 2)).mp h2.symm
      exact hr.one_lt.ne' (Nat.dvd_one.mp this)
  have hfix : ∀ T : Sylow 2 Y, T ∈ MulAction.fixedPoints H₀ (Sylow 2 Y) →
      burnsideA134_Fixes φ (T : Subgroup Y) := by
    intro T hT t
    have h1 : φ • T = T := hT ⟨φ, Subgroup.mem_zpowers φ⟩
    have h2 := CFSG.ComponentClassification.AschbacherToolkit.Bender.Omega.mem_smul_iff
      (α := φ) (S := T) (g := φ t)
    rw [h1] at h2
    rw [h2]
    simp
  haveI := Finite.one_lt_card_iff_nontrivial.mp hfp
  obtain ⟨⟨T₁, hT₁fp⟩, ⟨T₂, hT₂fp⟩, hne12⟩ := exists_pair_ne
    ↥(MulAction.fixedPoints H₀ (Sylow 2 Y))
  have hne12' : T₂ ≠ T₁ := fun h => hne12 (Subtype.ext h.symm)
  obtain ⟨D, hB, hDq, hTq⟩ := hbor T₁
  obtain ⟨T', hT'ne, hDT'⟩ := hB.exists_fixed
  obtain ⟨t, htT, ht⟩ := hB.exists_smul hT'ne hne12'
  have htN : t ∈ Subgroup.normalizer ((T₁ : Subgroup Y) : Set Y) := Subgroup.le_normalizer htT
  have hpair : ∀ g : Y, g ∈ Subgroup.normalizer ((T₁ : Subgroup Y) : Set Y) ⊓
      Subgroup.normalizer ((T₂ : Subgroup Y) : Set Y) ↔ t⁻¹ * g * t ∈ D := by
    intro g
    have e2 :=
      CFSG.ComponentClassification.AschbacherToolkit.Bender.Omega.mem_normalizer_conj_smul_iff
        (x := t) (g := g) (S := T')
    rw [ht] at e2
    have e1 : g ∈ Subgroup.normalizer ((T₁ : Subgroup Y) : Set Y) ↔
        t⁻¹ * g * t ∈ Subgroup.normalizer ((T₁ : Subgroup Y) : Set Y) := by
      rw [mul_assoc, Subgroup.mul_mem_cancel_left _ ((Subgroup.normalizer _).inv_mem htN),
        Subgroup.mul_mem_cancel_right _ htN]
    rw [Subgroup.mem_inf, e2, e1, ← Subgroup.mem_inf, hB.normalizer_inf_eq hT'ne hDT']
  have hDfree : ∀ v ∈ CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter
      (T₁ : Subgroup Y), v ≠ 1 → ∀ e₁ ∈ D, ∀ e₂ ∈ D, e₁ * v * e₁⁻¹ = e₂ * v * e₂⁻¹ → e₁ = e₂ := by
    intro v hv hv1 e₁ he₁ e₂ he₂ h
    have hcom : (e₂⁻¹ * e₁) * v = v * (e₂⁻¹ * e₁) := by
      calc e₂⁻¹ * e₁ * v = e₂⁻¹ * (e₁ * v * e₁⁻¹) * e₁ := by group
        _ = e₂⁻¹ * (e₂ * v * e₂⁻¹) * e₁ := by rw [h]
        _ = v * (e₂⁻¹ * e₁) := by group
    have hcent := hB.mem_centralizer_center (D.mul_mem (D.inv_mem he₂) he₁) hv hv1 hcom
    have hcard := hB.card_eq_mul
    have hDcard : Nat.card D = Nat.card
        (CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter (T₁ : Subgroup Y)) - 1 :=
      by omega
    have hpos : 0 < Nat.card D := Nat.card_pos
    have h1 : Nat.card ↥(D ⊓ Subgroup.centralizer
        ((CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter
          (T₁ : Subgroup Y) : Subgroup Y) : Set Y)) = 1 := by
      rw [← hDcard] at hcard
      have : Nat.card D * 1 = Nat.card D * Nat.card ↥(D ⊓ Subgroup.centralizer
          ((CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter
            (T₁ : Subgroup Y) : Subgroup Y) : Set Y)) := by
        rw [mul_one]
        exact hcard
      exact (Nat.eq_of_mul_eq_mul_left hpos this).symm
    have hbot := Subgroup.eq_bot_of_card_eq _ h1
    have hmem : e₂⁻¹ * e₁ ∈ D ⊓ Subgroup.centralizer
        ((CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter
          (T₁ : Subgroup Y) : Subgroup Y) : Set Y) := ⟨D.mul_mem (D.inv_mem he₂) he₁, hcent⟩
    rw [hbot, Subgroup.mem_bot, inv_mul_eq_one] at hmem
    exact hmem.symm
  have hcomm : ∀ x ∈ CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter
      (T₁ : Subgroup Y), t⁻¹ * x * t = x ∧ t * x * t⁻¹ = x := by
    intro x hx
    have h := (CFSG.ComponentClassification.AschbacherToolkit.Bender.mem_sylowCenter.mp hx).2 t htT
    exact ⟨by calc t⁻¹ * x * t = t⁻¹ * (x * t) := by group
                 _ = t⁻¹ * (t * x) := by rw [h]
                 _ = x := by group,
      by calc t * x * t⁻¹ = (x * t) * t⁻¹ := by rw [h]
                 _ = x := by group⟩
  refine ⟨(T₁ : Subgroup Y), (T₂ : Subgroup Y), T₁.isPGroup', hB.ne_bot, hfix T₁ hT₁fp,
    hfix T₂ hT₂fp, ?_, ?_⟩
  · have hmap : Subgroup.normalizer ((T₁ : Subgroup Y) : Set Y) ⊓
        Subgroup.normalizer ((T₂ : Subgroup Y) : Set Y) = D.map (MulAut.conj t).toMonoidHom := by
      ext g
      rw [hpair]
      constructor
      · intro hg
        exact ⟨t⁻¹ * g * t, hg, by simp [MulAut.conj_apply, mul_assoc]⟩
      · rintro ⟨d, hd, rfl⟩
        simpa [MulAut.conj_apply, mul_assoc] using hd
    have hcard : Nat.card ↥(Subgroup.normalizer ((T₁ : Subgroup Y) : Set Y) ⊓
        Subgroup.normalizer ((T₂ : Subgroup Y) : Set Y)) = Nat.card D := by
      rw [hmap]
      exact Subgroup.card_map_of_injective (MulAut.conj t).injective
    rw [hcard]
    exact hrD T₁ D hB
  · intro v hv hv1 w hw hw1
    rw [burnsideA134_zT_eq] at hv hw
    obtain ⟨d', hd', hd'v⟩ := hB.trans hv hw hv1 hw1
    have hd₀ : d'⁻¹ ∈ D := D.inv_mem hd'
    have hd₀v : d'⁻¹ * v * d'⁻¹⁻¹ = w := by simpa using hd'v
    refine ⟨t * d'⁻¹ * t⁻¹, ⟨(hpair _).mpr (by simpa [mul_assoc] using hd₀), ?_⟩, ?_⟩
    · calc t * d'⁻¹ * t⁻¹ * v * (t * d'⁻¹ * t⁻¹)⁻¹
          = t * (d'⁻¹ * (t⁻¹ * v * t) * d'⁻¹⁻¹) * t⁻¹ := by group
        _ = t * (d'⁻¹ * v * d'⁻¹⁻¹) * t⁻¹ := by rw [(hcomm v hv).1]
        _ = t * w * t⁻¹ := by rw [hd₀v]
        _ = w := (hcomm w hw).2
    · rintro y ⟨hy, hyv⟩
      have hyD : t⁻¹ * y * t ∈ D := (hpair y).mp hy
      have hev : (t⁻¹ * y * t) * v * (t⁻¹ * y * t)⁻¹ = w := by
        calc (t⁻¹ * y * t) * v * (t⁻¹ * y * t)⁻¹
            = t⁻¹ * (y * (t * v * t⁻¹) * y⁻¹) * t := by group
          _ = t⁻¹ * (y * v * y⁻¹) * t := by rw [(hcomm v hv).2]
          _ = t⁻¹ * w * t := by rw [hyv]
          _ = w := (hcomm w hw).1
      have he := hDfree v hv hv1 _ hyD _ hd₀ (hev.trans hd₀v.symm)
      calc y = t * (t⁻¹ * y * t) * t⁻¹ := by group
        _ = t * d'⁻¹ * t⁻¹ := by rw [he]

open scoped MatrixGroups in
@[expose] def burnsideA134_BenderModel (Y : Type) [Group Y] : Prop :=
  (∃ n : ℕ, 2 ≤ n ∧ Nonempty (Y ≃* PSL(2, GaloisField 2 n))) ∨
    ∃ a : ℕ, 1 ≤ a ∧ Nonempty (Y ≃* CFSG.Open.Sz a)

open scoped MatrixGroups in
private theorem burnsideA134_hbor
    {Y : Type} [Group Y] [Finite Y] (h : burnsideA134_BenderModel Y) (T : Sylow 2 Y) :
    ∃ D : Subgroup Y, CFSG.Goldschmidt.G3a.BorelSetup T D ∧
      Nat.card D + 1 =
        Nat.card (CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter
          (T : Subgroup Y)) ∧
      (Nat.card (T : Subgroup Y) =
          Nat.card (CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter
            (T : Subgroup Y)) ∨
        Nat.card (T : Subgroup Y) =
          Nat.card (CFSG.ComponentClassification.AschbacherToolkit.Bender.sylowCenter
            (T : Subgroup Y)) ^ 2) := by
  rcases h with ⟨n, hn, ⟨e⟩⟩ | ⟨a, ha, ⟨e⟩⟩
  · obtain ⟨D, hD⟩ := CFSG.Goldschmidt.G3a.exists_borelSetup (Or.inl ⟨n, hn, ⟨e⟩⟩ :
      CFSG.Open.fusionIsBenderGroup Y) T
    obtain ⟨hT, hDc, hZ⟩ := hD.orders_psl2 hn e
    have h1 : 1 ≤ 2 ^ n := Nat.one_le_two_pow
    exact ⟨D, hD, by rw [hDc, hZ]; omega, Or.inl (hT.trans hZ.symm)⟩
  · obtain ⟨D, hD⟩ := CFSG.Goldschmidt.G3a.exists_borelSetup (Or.inr (Or.inr ⟨a, ha, ⟨e⟩⟩) :
      CFSG.Open.fusionIsBenderGroup Y) T
    obtain ⟨hZ, hT, hDc⟩ := hD.orders_sz ha e
    have h1 : 1 ≤ 2 ^ (2 * a + 1) := Nat.one_le_two_pow
    exact ⟨D, hD, by rw [hDc, hZ]; omega, Or.inr (by rw [hT, hZ])⟩

private theorem burnsideA134_benderModel_of_mulEquiv {Y Z : Type} [Group Y] [Group Z] (e : Y ≃* Z)
    (h : burnsideA134_BenderModel Z) : burnsideA134_BenderModel Y := by
  rcases h with ⟨n, hn, ⟨e'⟩⟩ | ⟨a, ha, ⟨e'⟩⟩
  · exact Or.inl ⟨n, hn, ⟨e.trans e'⟩⟩
  · exact Or.inr ⟨a, ha, ⟨e.trans e'⟩⟩

private theorem burnsideA134_benderModel_of_stated {Y : Type} [Group Y]
    (h : (∃ n : ℕ, CFSG.Open.StatedClassicalModel Y .PSL 2 2 n) ∨
      (∃ n : ℕ, CFSG.Blueprint.SuzukiModel Y 2 n)) : burnsideA134_BenderModel Y := by
  rcases h with ⟨n, hn⟩ | ⟨n, hn⟩
  · obtain ⟨hadm, K, _, _, hK, ⟨e⟩⟩ := hn
    obtain ⟨-, h1, -, h2, -⟩ := hadm
    have hn2 : 2 ≤ n := by
      by_contra hlt
      have h3 : n = 1 := by omega
      subst h3
      exact h2 (by simp)
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    exact Or.inl ⟨n, hn2, ⟨e.trans
      (CFSG.ClassicalModels.statedLinearModelEquivGaloisPSL K 2 2 n h1 hK)⟩⟩
  · obtain ⟨-, a, ha, K, _, _, rfl, hcard, ⟨e⟩⟩ := hn
    exact Or.inr ⟨a, ha, ⟨e.trans ((MulEquiv.subgroupCongr
      (CFSG.LieType.BorelTits.suzukiGroup_eq_glaSzGroup a K)).trans
        (CFSG.ShultStronglyClosedTI.glaSzEquivNative a ha hcard))⟩⟩

private theorem burnsideA134_famBender :
    burnsideA134_FamBender := by
  intro X _ _ he A B hAq hBq hc ⟨eAB⟩ hT hZA hZB r hr hr2 hN
  haveI : Group.IsPerfect ↥A := hAq.1
  haveI : Group.IsPerfect ↥B := hBq.1
  haveI : IsSimpleGroup (↥A ⧸ Subgroup.center ↥A) := hAq.2.1
  haveI : IsSimpleGroup (↥B ⧸ Subgroup.center ↥B) := hBq.2.1
  obtain ⟨cAB⟩ := burnsideA134_centerQuotient_nonempty eAB
  have hmA : burnsideA134_BenderModel (↥A ⧸ Subgroup.center ↥A) :=
    burnsideA134_benderModel_of_stated hT
  have hmB : burnsideA134_BenderModel (↥B ⧸ Subgroup.center ↥B) :=
    burnsideA134_benderModel_of_mulEquiv cAB.symm hmA
  obtain ⟨N, hN2, hrN⟩ := hN
  obtain ⟨S, hS1, hS2, hSA, a, haA, haS, ha⟩ :=
    burnsideA134_lift_twoLocal A hZA hr hr2 hN2 hrN
  obtain ⟨hNB, hNBc⟩ := burnsideA134_isTwoLocal_map cAB hN2
  refine burnsideA134_fac_of_benderFix he hc eAB hZA hZB hr hr2 hS1 hS2 hSA haA haS ha ?_
  intro y hyA hyB hyr
  have hpow : ∀ (Z : Subgroup X) (hyZ : y ∈ Subgroup.normalizer (Z : Set X)),
      (⟨y, hyZ⟩ : ↥(Subgroup.normalizer (Z : Set X))) ^ r ^ hyr.choose = 1 := fun Z hyZ =>
    Subtype.ext (by simpa using hyr.choose_spec)
  refine ⟨burnsideA134_benderFix_of_borel (burnsideA134_hbor hmA) hr hr2 ⟨N, hN2, hrN⟩ _
      ⟨hyr.choose, ?_⟩,
    burnsideA134_benderFix_of_borel (burnsideA134_hbor hmB) hr hr2
      ⟨_, hNB, hNBc ▸ hrN⟩ _ ⟨hyr.choose, ?_⟩⟩
  · rw [← map_pow, hpow A hyA, map_one]
  · rw [← map_pow, hpow B hyB, map_one]

private theorem burnsideA134_eq_oResidual {G : Type} [Group G] {H L₁ L₂ : Subgroup G} (hle₁ :
    L₁ ≤ H)
    (hle₂ : L₂ ≤ H) {r : ℕ} (hnorm : ((L₁ ⊔ L₂).subgroupOf H).Normal)
    (hP1 : ∀ x : ↥H, ∃ m : ℕ, 0 < m ∧ (∀ q : ℕ, q.Prime → q ∣ m → q ≠ r) ∧
      x ^ m ∈ (L₁ ⊔ L₂).subgroupOf H)
    (hP3 : ∀ N : Subgroup ↥H, N.Normal → (∀ x : ↥H, ∃ m : ℕ, 0 < m ∧
      (∀ q : ℕ, q.Prime → q ∣ m → q ≠ r) ∧ x ^ m ∈ N) →
      L₁.subgroupOf H ≤ N ∧ L₂.subgroupOf H ≤ N) :
    L₁ ⊔ L₂ = ChA.oResidual {q : ℕ | q ≠ r} H := by
  apply le_antisymm
  · refine le_iInf₂ fun N hN => ?_
    obtain ⟨hNH, hNn, hNm⟩ := hN
    haveI := hNn
    obtain ⟨h1, h2⟩ := hP3 (N.subgroupOf H) hNn (fun x => by
      obtain ⟨m, hm0, hmq, hmN⟩ := hNm x x.2
      refine ⟨m, hm0, fun q hq hqm hqr => hmq q hq hqm hqr, ?_⟩
      rw [Subgroup.mem_subgroupOf]
      simpa using hmN)
    refine sup_le (fun z hz => ?_) (fun z hz => ?_)
    · have := h1 (show (⟨z, hle₁ hz⟩ : ↥H) ∈ L₁.subgroupOf H from hz)
      exact this
    · have := h2 (show (⟨z, hle₂ hz⟩ : ↥H) ∈ L₂.subgroupOf H from hz)
      exact this
  · refine iInf₂_le (L₁ ⊔ L₂) ⟨sup_le hle₁ hle₂, hnorm, fun x hx => ?_⟩
    obtain ⟨m, hm0, hmq, hmN⟩ := hP1 ⟨x, hx⟩
    refine ⟨m, hm0, fun q hq hqm => hmq q hq hqm, ?_⟩
    rw [Subgroup.mem_subgroupOf] at hmN
    simpa using hmN

private theorem burnsideA134_part1 (hF : CFSG.Quasithin.A134Fact) (hM : CFSG.Quasithin.Mult2Fact)
    (hfam : burnsideA134_FamFAC) {G : Type} [Group G] [Finite G]
    (hG : CFSG.Open.evenRank G ≤ 2) {H L₁ L₂ : Subgroup G}
    (hK : CFSG.SectionRank.IsKGroupCat ↥H) (h₁ : CFSG.Open.IsComponentOf L₁ H)
    (h₂ : CFSG.Open.IsComponentOf L₂ H) (hne : L₁ ≠ L₂) (e : ↥L₁ ≃* ↥L₂) :
    (∃ r : ℕ, r.Prime ∧ r ≠ 2 ∧
        ∃ N : Subgroup (↥L₁ ⧸ Subgroup.center ↥L₁), CFSG.Open.IsTwoLocal N ∧ r ∣ Nat.card N) ∧
      ∀ r : ℕ, r.Prime → r ≠ 2 →
        (∃ N : Subgroup (↥L₁ ⧸ Subgroup.center ↥L₁), CFSG.Open.IsTwoLocal N ∧ r ∣ Nat.card N) →
          L₁ ⊔ L₂ = ChA.oResidual {q : ℕ | q ≠ r} H := by
  refine ⟨?_, ?_⟩
  · have hq := h₁.2.2
    haveI : IsSimpleGroup (↥L₁ ⧸ Subgroup.center ↥L₁) := hq.2
    obtain ⟨r, hr, hr2, R, hR1, hR2, x, hx, hxo⟩ :=
      CFSG.SectionRank.QTK.exists_odd_prime_mem_normalizer
        (CFSG.ComponentClassification.Helpers.quasisimple_central_quotient_nonabelian ↥L₁ hq)
    refine ⟨r, hr, hr2, Subgroup.normalizer (R : Set _), ⟨R, hR1, hR2, rfl⟩, ?_⟩
    have := orderOf_dvd_natCard (⟨x, hx⟩ : ↥(Subgroup.normalizer (R : Set _)))
    rwa [Subgroup.orderOf_mk, hxo] at this
  · intro r hr hr2 hN
    obtain ⟨N, hNl, hrN⟩ := hN
    haveI : Fact r.Prime := ⟨hr⟩
    obtain ⟨hA2, hA3⟩ := burnsideA134_X hF hG hK h₁ h₂ hne e
    have h₁' := burnsideA134_isComponent_subgroupOf h₁
    have h₂' := burnsideA134_isComponent_subgroupOf h₂
    have hne' : L₁.subgroupOf H ≠ L₂.subgroupOf H := fun h => hne (by
      have := Subgroup.subgroupOf_inj.mp h
      rwa [inf_of_le_left h₁.1, inf_of_le_left h₂.1] at this)
    let e₁ : ↥(L₁.subgroupOf H) ≃* ↥L₁ := Subgroup.subgroupOfEquivOfLe h₁.1
    let e₂ : ↥(L₂.subgroupOf H) ≃* ↥L₂ := Subgroup.subgroupOfEquivOfLe h₂.1
    let eA : ↥(L₁.subgroupOf H) ≃* ↥(L₂.subgroupOf H) := e₁.trans (e.trans e₂.symm)
    have hAq : CFSG.IsQuasisimple ↥(L₁.subgroupOf H) := h₁'.1
    have hBq : CFSG.IsQuasisimple ↥(L₂.subgroupOf H) := h₂'.1
    have hc := burnsideA134_components_commute h₁' h₂' hne'
    have hQT : CFSG.Open.evenRank ↥H ≤ 2 := burnsideA134_isQuasithin_subgroup H hG
    have hZA : IsPGroup 2 (Subgroup.center ↥(L₁.subgroupOf H)) := hM _ hAq hA3
    have hA3B : CFSG.Quasithin.A134TypesCentral ↥(L₂.subgroupOf H) := by
      obtain ⟨c⟩ := burnsideA134_centerQuotient_nonempty eA.symm
      exact CFSG.Quasithin.A38.A134Types.of_mulEquiv c hA3
    have hZB : IsPGroup 2 (Subgroup.center ↥(L₂.subgroupOf H)) := hM _ hBq hA3B
    obtain ⟨cL⟩ := burnsideA134_centerQuotient_nonempty e₁.symm
    obtain ⟨hNl', hcard'⟩ := burnsideA134_isTwoLocal_map cL hNl
    have hrN' : r ∣ Nat.card (N.map cL.toMonoidHom) := hcard' ▸ hrN
    have hfac := hfam ↥H hQT _ _ hAq hBq hc ⟨eA⟩ hA3 hZA hZB r hr hr2 ⟨_, hNl', hrN'⟩
    obtain ⟨S, hS, hS2, hSA, a, haA, haS, ha⟩ :=
      burnsideA134_lift_twoLocal (L₁.subgroupOf H) hZA hr hr2 hNl' hrN'
    obtain ⟨hnorm, hP1⟩ := burnsideA134_part1_X hQT h₁' h₂' hne' eA hA2 hZA hZB hr hr2 hS hS2
      hSA haA haS ha hfac
    have hsup : (L₁ ⊔ L₂).subgroupOf H = L₁.subgroupOf H ⊔ L₂.subgroupOf H :=
      Subgroup.subgroupOf_sup h₁.1 h₂.1
    refine burnsideA134_eq_oResidual h₁.1 h₂.1 (by rw [hsup]; exact hnorm)
      (fun x => by rw [hsup]; exact hP1 x) ?_
    intro N' hN'n hN'm
    haveI := hN'n
    obtain ⟨nn, hnn⟩ := exists_prime_orderOf_dvd_card' (G := ↥(N.map cL.toMonoidHom)) r hrN'
    have haq : orderOf (nn : ↥(L₁.subgroupOf H) ⧸ Subgroup.center ↥(L₁.subgroupOf H)) = r := by
      rw [Subgroup.orderOf_coe]
      exact hnn
    refine ⟨burnsideA134_le_of_rPrime_quotient hAq hr haq hN'm, ?_⟩
    obtain ⟨cAB⟩ := burnsideA134_centerQuotient_nonempty eA
    exact burnsideA134_le_of_rPrime_quotient hBq hr
      (aq := cAB (nn : ↥(L₁.subgroupOf H) ⧸ Subgroup.center ↥(L₁.subgroupOf H)))
      (by rw [MulEquiv.orderOf_eq]; exact haq) hN'm

end BurnsideA134

