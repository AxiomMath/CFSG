        (W ⊔ CFSG.Quasithin.modFix (Subgroup.zpowers (t * u)) (⊤ : Subgroup V) = ⊤ ∧
          W ⊓ CFSG.Quasithin.modFix (Subgroup.zpowers (t * u)) (⊤ : Subgroup V) = ⊥) ∧
        (CFSG.Quasithin.modComm (Subgroup.zpowers t) W ⊔
            CFSG.Quasithin.modComm (Subgroup.zpowers u) W = W ∧
          CFSG.Quasithin.modComm (Subgroup.zpowers t) W ⊓
            CFSG.Quasithin.modComm (Subgroup.zpowers u) W = ⊥) ∧
        CFSG.Quasithin.modFix (Subgroup.zpowers t) W =
          CFSG.Quasithin.modComm (Subgroup.zpowers t) W

theorem as_A_1_44 : A_1_44 := by
  intro G _ _ t u htu ht1 hu1 ht2 hu2 hgen hodd hev V _ _ _ hV _ W hW
  have hot : orderOf t = 2 := orderOf_eq_prime ht2 ht1
  have hou : orderOf u = 2 := orderOf_eq_prime hu2 hu1
  have hk : Nat.card G = 2 * (Nat.card G / 2) := (Nat.two_mul_div_two_of_even hev).symm
  obtain ⟨h1, ⟨h2, h3⟩, h4⟩ :=
    CFSG.Quasithin.dihedral_module_decomposition hV hot hou htu hgen hk hodd hW
  exact ⟨⟨h1.sup_eq_top, h1.inf_eq_bot⟩, ⟨h3, h2.eq_bot⟩, h4⟩

end CFSG.ASVolI
