theorem exists_surjective_ker_eq_of_isSL2 {X : Type} [Group X] (C : Subgroup X) [C.Normal]
    {q : ℕ} (h : CFSG.Quasithin.IsSL2 q (X ⧸ C)) :
    ∃ φ : X →* SL(2, ZMod q), Function.Surjective φ ∧ φ.ker = C := by
  obtain ⟨e⟩ := h
  refine ⟨e.toMonoidHom.comp (QuotientGroup.mk' C),
    e.surjective.comp (QuotientGroup.mk'_surjective C), ?_⟩
  ext g
  rw [MonoidHom.mem_ker]
  show e (g : X ⧸ C) = 1 ↔ g ∈ C
  rw [MulEquiv.map_eq_one_iff, QuotientGroup.eq_one_iff]

theorem actsTrivially_iff_commutator_mem {G : Type} [Group G] (P : Subgroup G) (x : G) :
    CFSG.Quasithin.ActsTriviallyOnFrattiniQuotient P x ↔ ∀ d ∈ P, ⁅x, d⁆ ∈ frattiniOf P := by
  have hconj : ∀ {a d : G}, a ∈ frattiniOf P → d ∈ P → d * a * d⁻¹ ∈ frattiniOf P := by
    rintro a d ⟨a', ha', rfl⟩ hd
    refine ⟨⟨d, hd⟩ * a' * ⟨d, hd⟩⁻¹,
      (inferInstance : (frattini ↥P).Normal).conj_mem a' ha' ⟨d, hd⟩, ?_⟩
    simp
  constructor
  · intro h d hd
    have h1 := hconj (h d hd) hd
    have e : d * (d⁻¹ * (x * d * x⁻¹)) * d⁻¹ = ⁅x, d⁆ := by
      rw [commutatorElement_def]; group
    rw [e] at h1
    exact h1
  · intro h d hd
    have h1 := hconj (h d hd) (P.inv_mem hd)
    have e : d⁻¹ * ⁅x, d⁆ * d⁻¹⁻¹ = d⁻¹ * (x * d * x⁻¹) := by
      rw [commutatorElement_def]; group
    rw [e] at h1
    exact h1

theorem normal_eq_top_or_le_center {Q : Type*} [Group Q] (hQ : CFSG.Open.IsQuasisimple Q)
    {N : Subgroup Q} (hN : N.Normal) : N = ⊤ ∨ N ≤ Subgroup.center Q := by
  obtain ⟨hp, hs⟩ := hQ
  have := hN.map (QuotientGroup.mk' (Subgroup.center Q)) (QuotientGroup.mk'_surjective _)
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal
    (N.map (QuotientGroup.mk' (Subgroup.center Q))) with h | h
  · right
    rwa [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at h
  · left
    have hsup : N ⊔ Subgroup.center Q = ⊤ := by
      have := Subgroup.comap_map_eq (QuotientGroup.mk' (Subgroup.center Q)) N
      rw [h, Subgroup.comap_top, QuotientGroup.ker_mk'] at this
      exact this.symm
    have hcomm : commutator Q ≤ N :=
      Subgroup.Normal.commutator_le_of_self_sup_commutative_eq_top hsup inferInstance
    exact eq_top_iff.mpr (hp ▸ hcomm)

theorem le_ker_of_odd_card {X : Type*} [Group X] [Finite X] {q : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q)
    (σ : X →* SL(2, ZMod q)) (hσ : Function.Surjective σ) {N : Subgroup X} [N.Normal]
    (hN : Odd (Nat.card N)) : N ≤ σ.ker := by
  have hq2 : q ≠ 2 := by omega
  have hnorm : (N.map σ).Normal := Subgroup.Normal.map ‹N.Normal› σ hσ
  have hodd : Odd (Nat.card (N.map σ)) := Odd.of_dvd_nat hN (Subgroup.card_map_dvd N σ)
  have hcen : Nat.card (Subgroup.center SL(2, ZMod q)) = 2 :=
    CFSG.Quasithin.A36B.card_center_sl2 hq hq2
  rcases CFSG.LocalCores.quasisimple_normal_subgroups
    (CFSG.Quasithin.A36B.isQuasisimple_sl2 hq hq5) hnorm with h | h
  · exfalso
    have h2 : Nat.card (Subgroup.center SL(2, ZMod q)) ∣ Nat.card SL(2, ZMod q) :=
      Subgroup.card_subgroup_dvd_card _
    rw [hcen] at h2
    rw [h, Subgroup.card_top] at hodd
    exact (Nat.not_even_iff_odd.2 hodd) (even_iff_two_dvd.2 h2)
  · have h1 : Nat.card (N.map σ) ∣ Nat.card (Subgroup.center SL(2, ZMod q)) :=
      Subgroup.card_dvd_of_le h
    rw [hcen] at h1
    have h2 : Nat.card (N.map σ) = 1 := by
      rcases (Nat.dvd_prime Nat.prime_two).1 h1 with h3 | h3
      · exact h3
      · rw [h3] at hodd
        exact absurd hodd (by decide)
    have h3 : N.map σ = ⊥ := Subgroup.eq_bot_of_card_eq _ h2
    intro x hx
    rw [MonoidHom.mem_ker]
    have h4 : σ x ∈ N.map σ := ⟨x, hx, rfl⟩
    rwa [h3, Subgroup.mem_bot] at h4

theorem injective_of_surjective_sl2 {Q : Type} [Group Q] [Finite Q]
    (hQ : CFSG.Open.IsQuasisimple Q) {q : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q)
    (τ : Q →* SL(2, ZMod q)) (hτ : Function.Surjective τ) : Function.Injective τ := by
  haveI : Fact q.Prime := ⟨hq⟩
  have hq2 : q ≠ 2 := by omega
  have hcen : Nat.card (Subgroup.center SL(2, ZMod q)) = 2 :=
    CFSG.Quasithin.A36B.card_center_sl2 hq hq2
  have hkerZ : τ.ker ≤ Subgroup.center Q := by
    rcases normal_eq_top_or_le_center hQ τ.normal_ker with h | h
    · exfalso
      obtain ⟨a, b, hab⟩ := exists_pair_ne (SL(2, ZMod q) ⧸ Subgroup.center SL(2, ZMod q))
      obtain ⟨a', rfl⟩ := QuotientGroup.mk_surjective a
      obtain ⟨b', rfl⟩ := QuotientGroup.mk_surjective b
      obtain ⟨x, rfl⟩ := hτ a'
      obtain ⟨y, rfl⟩ := hτ b'
      have h1 : τ x = 1 := by
        have : x ∈ τ.ker := h ▸ Subgroup.mem_top x
        exact this
      have h2 : τ y = 1 := by
        have : y ∈ τ.ker := h ▸ Subgroup.mem_top y
        exact this
      exact hab (by rw [h1, h2])
    · exact h
  have hZc : ∀ z ∈ Subgroup.center Q, τ z ∈ Subgroup.center SL(2, ZMod q) := by
    intro z hz
    rw [Subgroup.mem_center_iff] at hz ⊢
    intro s
    obtain ⟨y, rfl⟩ := hτ s
    rw [← map_mul, ← map_mul, hz y]
  let τ' : Q ⧸ Subgroup.center Q →* SL(2, ZMod q) ⧸ Subgroup.center SL(2, ZMod q) :=
    QuotientGroup.map (Subgroup.center Q) (Subgroup.center SL(2, ZMod q)) τ
      (fun z hz => hZc z hz)
  have hτ'surj : Function.Surjective τ' := by
    intro y
    obtain ⟨s, rfl⟩ := QuotientGroup.mk_surjective y
    obtain ⟨x, rfl⟩ := hτ s
    exact ⟨x, rfl⟩
  have hτ'inj : Function.Injective τ' := by
    rw [← MonoidHom.ker_eq_bot_iff]
    haveI := τ'.normal_ker
    rcases (hQ.2).eq_bot_or_eq_top_of_normal τ'.ker with h | h
    · exact h
    · exfalso
      obtain ⟨a, b, hab⟩ := exists_pair_ne (SL(2, ZMod q) ⧸ Subgroup.center SL(2, ZMod q))
      obtain ⟨x, rfl⟩ := hτ'surj a
      obtain ⟨y, rfl⟩ := hτ'surj b
      have h1 : τ' x = 1 := by
        have : x ∈ τ'.ker := h ▸ Subgroup.mem_top x
        exact this
      have h2 : τ' y = 1 := by
        have : y ∈ τ'.ker := h ▸ Subgroup.mem_top y
        exact this
      exact hab (by rw [h1, h2])
  let e : Q ⧸ Subgroup.center Q ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) (ZMod q) :=
    MulEquiv.ofBijective τ' ⟨hτ'inj, hτ'surj⟩
  have hPSL : CFSG.Quasithin.IsPSL 2 q 1 (Q ⧸ Subgroup.center Q) :=
    CFSG.Quasithin.A36B.isPSL_two_of_mulEquiv hq hq5 e
  have hZ2 : Nat.card (Subgroup.center Q) ≤ 2 :=
    CFSG.Quasithin.l2MultiplierFact q hq hq5 Q (Group.isPerfect_def.mpr hQ.1) (Subgroup.center Q)
      le_rfl hPSL
  have hrange : (Subgroup.center Q).map τ = Subgroup.center SL(2, ZMod q) := by
    apply le_antisymm
    · rintro _ ⟨z, hz, rfl⟩
      exact hZc z hz
    · intro c hc
      obtain ⟨x, rfl⟩ := hτ c
      have h1 : τ' (x : Q ⧸ Subgroup.center Q) = 1 := (QuotientGroup.eq_one_iff _).2 hc
      have h2 : (x : Q ⧸ Subgroup.center Q) = 1 := hτ'inj (h1.trans (map_one τ').symm)
      exact ⟨x, (QuotientGroup.eq_one_iff x).1 h2, rfl⟩
  let φ : ↥(Subgroup.center Q) →* SL(2, ZMod q) := τ.comp (Subgroup.center Q).subtype
  have hφr : φ.range = Subgroup.center SL(2, ZMod q) := by
    rw [MonoidHom.range_comp, Subgroup.range_subtype]
    exact hrange
  have hcard : Nat.card (Subgroup.center Q) = Nat.card φ.range * Nat.card φ.ker := by
    rw [← Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv]
    exact Subgroup.card_eq_card_quotient_mul_card_subgroup φ.ker
  rw [hφr, hcen] at hcard
  have hker1 : Nat.card φ.ker = 1 := by
    have hpos : 0 < Nat.card φ.ker := Nat.card_pos
    omega
  have hker2 : φ.ker = ⊥ := Subgroup.eq_bot_of_card_eq _ hker1
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro x hx
  have hxZ : x ∈ Subgroup.center Q := hkerZ hx
  have : (⟨x, hxZ⟩ : ↥(Subgroup.center Q)) ∈ φ.ker := hx
  rw [hker2, Subgroup.mem_bot] at this
  exact Subgroup.mem_bot.2 (congrArg Subtype.val this)

theorem pRank_two_eq_one_of_surjective_sl2 {X : Type*} [Group X] [Finite X] {q : ℕ}
    (hq : q.Prime) (hq2 : q ≠ 2) (σ : X →* SL(2, ZMod q)) (hσ : Function.Surjective σ)
    (hodd : Odd (Nat.card σ.ker)) : CFSG.pRank 2 X = 1 := by
  classical
  haveI : Fact q.Prime := ⟨hq⟩
  rw [CFSG.SectionRank.pRank_eq_open_pRank_top]
  have hp1 : 1 < 2 := by norm_num
  apply le_antisymm
  · refine CFSG.SectionRank.pRank_le hp1 fun E _ hE => ?_
    have hpm : ∀ e : E, (σ (e : X) : Matrix (Fin 2) (Fin 2) (ZMod q)) = 1 ∨
        (σ (e : X) : Matrix (Fin 2) (Fin 2) (ZMod q)) = -1 := by
      intro e
      refine CFSG.Quasithin.A1c.matrix_eq_one_or_neg_one_of_sq_eq_one
        (CFSG.SectionRank.Ccomm.two_ne_zero_zmod hq2) ?_ (σ (e : X)).2
      have h1 : σ (e : X) * σ (e : X) = 1 := by
        rw [← map_mul, ← pow_two, hE.2 e e.2, map_one]
      simpa using congrArg Subtype.val h1
    have hinjE : ∀ a b : E, σ (a : X) = σ (b : X) → a = b := by
      intro a b hab
      have hc : ((a : X)⁻¹ * (b : X)) ∈ σ.ker := by
        rw [MonoidHom.mem_ker, map_mul, map_inv, hab, inv_mul_cancel]
      have hcE : ((a : X)⁻¹ * (b : X)) ∈ E := E.mul_mem (E.inv_mem a.2) b.2
      have hc2 : ((a : X)⁻¹ * (b : X)) ^ 2 = 1 := hE.2 _ hcE
      have h1 : orderOf ((a : X)⁻¹ * (b : X)) ∣ 2 := orderOf_dvd_of_pow_eq_one hc2
      have h2 : orderOf ((a : X)⁻¹ * (b : X)) ∣ Nat.card σ.ker :=
        Subgroup.orderOf_dvd_natCard σ.ker hc
      have h3 : Odd (orderOf ((a : X)⁻¹ * (b : X))) := Odd.of_dvd_nat hodd h2
      have h4 : orderOf ((a : X)⁻¹ * (b : X)) = 1 := by
        rcases (Nat.dvd_prime Nat.prime_two).1 h1 with h | h
        · exact h
        · rw [h] at h3
          exact absurd h3 (by decide)
      have h5 : (a : X)⁻¹ * (b : X) = 1 := orderOf_eq_one_iff.1 h4
      exact Subtype.ext (inv_mul_eq_one.1 h5)
    have hf : Function.Injective (fun e : E =>
        (⟨(σ (e : X) : Matrix (Fin 2) (Fin 2) (ZMod q)), hpm e⟩ :
          ({1, -1} : Set (Matrix (Fin 2) (Fin 2) (ZMod q))))) := by
      intro a b hab
      have h := Subtype.ext_iff.1 hab
      exact hinjE a b (Subtype.ext h)
    have h1 := Nat.card_le_card_of_injective _ hf
    rw [Nat.card_coe_set_eq] at h1
    have h2 : ({1, -1} : Set (Matrix (Fin 2) (Fin 2) (ZMod q))).ncard ≤ 2 := by
      calc _ ≤ ({-1} : Set (Matrix (Fin 2) (Fin 2) (ZMod q))).ncard + 1 :=
            Set.ncard_insert_le _ _
        _ = 2 := by rw [Set.ncard_singleton]
    simpa using h1.trans h2
  · have h2 : 2 ∣ Nat.card X := by
      have hcen : Nat.card (Subgroup.center SL(2, ZMod q)) = 2 :=
        CFSG.Quasithin.A36B.card_center_sl2 hq hq2
      have h1 : Nat.card (Subgroup.center SL(2, ZMod q)) ∣ Nat.card SL(2, ZMod q) :=
        Subgroup.card_subgroup_dvd_card _
      rw [hcen] at h1
      exact h1.trans (Subgroup.card_dvd_of_surjective hσ)
    obtain ⟨t, ht⟩ := exists_prime_orderOf_dvd_card' (G := X) 2 h2
    have ht2 : t ^ 2 = 1 := by rw [← ht]; exact pow_orderOf_eq_one t
    refine CFSG.SectionRank.le_pRank hp1 (le_top : Subgroup.zpowers t ≤ ⊤)
      (CFSG.Open.isElemAbelian_zpowers ht2) (k := 1) ?_
    rw [Nat.card_zpowers, ht, pow_one]

