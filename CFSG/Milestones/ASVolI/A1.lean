  refine iInf_le_of_le N (iInf_le_of_le ⟨le_top, Subgroup.normal_subgroupOf, ?_⟩ le_rfl)
  intro x _
  obtain ⟨k, hk⟩ := hall x
  refine ⟨p ^ k, pow_pos hp.pos k, ?_, hk⟩
  intro q hq hqd
  exact (Nat.prime_dvd_prime_iff_eq hq hp).1 (hq.dvd_of_dvd_pow hqd)

