private theorem a1b4_isElemAbelianOfOrder {p n : ℕ} [Fact p.Prime] {X : Type*} [Group X]
    (h : CFSG.Quasithin.IsElemAbelianOfRank p n X) : ChA.IsElemAbelianOfOrder p n X := by
  obtain ⟨e⟩ := h
  refine ⟨fun x y => e.injective ?_, fun x => e.injective ?_, ?_⟩
  · rw [map_mul, map_mul, mul_comm]
  · rw [map_pow, map_one]
    ext i
