private theorem a111_isTwoReduced_iff {G : Type} [Group G] (M V : Subgroup G) :
    IsTwoReduced M V ↔ CFSG.Quasithin.IsTwoReducedIn M V := by
  constructor
  · rintro ⟨hVM, hVn, hel, hred⟩
    refine ⟨hVM, (Subgroup.normal_subgroupOf_iff_le_normalizer hVM).mp hVn, hel, ?_⟩
    intro D hDM hMD hD
    have hMV : M ≤ Subgroup.normalizer (V : Set G) :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer hVM).mp hVn
    have hMC : M ≤ Subgroup.normalizer ((M ⊓ Subgroup.centralizer (V : Set G) : Subgroup G) :
        Set G) :=
      CFSG.Quasithin.A1a.le_normalizer_inf Subgroup.le_normalizer
        (CFSG.Quasithin.A1a.le_normalizer_centralizer hMV)
    have hMN : M ≤ Subgroup.normalizer
        (((M ⊓ Subgroup.centralizer (V : Set G)) ⊔ D : Subgroup G) : Set G) :=
      CFSG.Quasithin.A1a.le_normalizer_sup hMC hMD
    have hset : (((M ⊓ Subgroup.centralizer (V : Set G)) ⊔ D : Subgroup G) : Set G) =
        ((M ⊓ Subgroup.centralizer (V : Set G) : Subgroup G) : Set G) * (D : Set G) :=
      Subgroup.coe_mul_of_right_le_normalizer_left _ _ (hDM.trans hMC)
    have hN := hred ((M ⊓ Subgroup.centralizer (V : Set G)) ⊔ D) le_sup_left
      (sup_le inf_le_left hDM)
      ((Subgroup.normal_subgroupOf_iff_le_normalizer (sup_le inf_le_left hDM)).mpr hMN)
      (by
        intro x hx
        rw [← SetLike.mem_coe, hset] at hx
        obtain ⟨c, hc, d, hd, rfl⟩ := hx
        obtain ⟨k, hk⟩ := hD d hd
        obtain ⟨l, hl, hlpow⟩ :=
          CFSG.Quasithin.A1a.exists_pow_mul_eq hc (hDM.trans hMC hd) (2 ^ k)
        refine ⟨k, ?_⟩
        rw [hlpow]
        exact Subgroup.mul_mem _ hl ⟨M.pow_mem (hDM hd) _, hk⟩)
    exact (le_sup_right.trans hN).trans inf_le_right
  · rintro ⟨hVM, hMV, hel, hred⟩
    refine ⟨hVM, (Subgroup.normal_subgroupOf_iff_le_normalizer hVM).mpr hMV, hel, ?_⟩
    intro N _ hNM hNn hN
    refine le_inf hNM (hred N hNM ((Subgroup.normal_subgroupOf_iff_le_normalizer hNM).mp hNn) ?_)
    intro d hd
    obtain ⟨k, hk⟩ := hN d hd
    exact ⟨k, hk.2⟩

