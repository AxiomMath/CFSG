theorem isNormalizerIrreducible_of_forall {G : Type} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hp2 : p ≠ 2) {P : Subgroup G} (hPp : IsPGroup p P) (hPΩ : omegaOne p P = P)
    (hPcl : ClassLeTwo P) (hPrk : CFSG.Open.pRank p P = 2)
    (hirr : ∀ U : Subgroup G, frattiniOf P ≤ U → U ≤ P →
      (∀ n ∈ ChA.normalizerOf P, ∀ u ∈ U, n * u * n⁻¹ ∈ U) → U = frattiniOf P ∨ U = P) :
    CFSG.Quasithin.A1c.IsNormalizerIrreducible P := by
  refine ⟨?_, fun U hU1 hU2 hUN => hirr U hU1 hU2 fun n hn u hu =>
    (Subgroup.mem_normalizer_iff.mp (hUN hn) u).mp hu⟩
  have hPΩ' := CFSG.Quasithin.A1c.closure_pow_eq_top_of_closure_eq hPΩ
  have hPclt := CFSG.Quasithin.classLeTwo_top_of hPcl
  have hPrk' : CFSG.Open.pRank p (⊤ : Subgroup ↥P) = 2 := by
    rw [CFSG.Quasithin.pRank_top_subtype]; exact hPrk
  have hΦ : (frattini ↥P).index = p ^ 2 :=
    CFSG.Quasithin.A1c.index_frattini_eq_sq hp2 hPp hPΩ' hPclt hPrk'
  intro h
  have h1 : frattini ↥P = ⊤ := by
    apply Subgroup.map_injective P.subtype_injective
    rw [Subgroup.map_top, Subgroup.range_subtype]
    exact h
  rw [h1, Subgroup.index_top] at hΦ
  have := (Fact.out : p.Prime).one_lt
  nlinarith

