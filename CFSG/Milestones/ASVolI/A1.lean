      refine ⟨q * a, b, Nat.mul_pos hq.pos ha, by rw [hab, mul_assoc], fun r hr hra => ?_, hb⟩
      rcases (Nat.Prime.dvd_mul hr).1 hra with h | h
      · exact ((Nat.prime_dvd_prime_iff_eq hr hq).1 h) ▸ hqn
      · exact haq r hr h

