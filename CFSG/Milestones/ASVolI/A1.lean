@[expose] def A_1_1 : Prop :=
  ∀ (G : Type) [Group G] (X Y Z : Subgroup G),
    ⁅⁅X, Y⁆, Z⁆ = ⊥ → ⁅⁅Y, Z⁆, X⁆ = ⊥ → ⁅⁅Z, X⁆, Y⁆ = ⊥

theorem as_A_1_1 : A_1_1 := fun _ _ _ _ _ h1 h2 =>
  Subgroup.commutator_commutator_eq_bot_of_rotate h1 h2

@[expose] def A_1_2 : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p : ℕ), p.Prime → ∀ X : Subgroup G, IsPGroup p X →
    (X ≤ pCore p G ∨ ∃ g : G, ¬ IsPGroup p ↥(X ⊔ conjSub X g)) ∧
    (Nat.card X = 2 → X ≤ pCore 2 G ∨
      ∃ y : G, y ≠ 1 ∧ Odd (orderOf y) ∧ ∀ x ∈ X, x ≠ 1 → x * y * x⁻¹ = y⁻¹)

theorem as_A_1_2 : A_1_2 := by
  intro G _ _ p hp X hX
  have : Fact p.Prime := ⟨hp⟩
  refine ⟨CFSG.Quasithin.baer_suzuki_subgroup hX, fun h2 => ?_⟩
  by_cases hc : X ≤ pCore 2 G
  · exact Or.inl hc
  · exact Or.inr (CFSG.Quasithin.baer_suzuki_involution h2 hc)

@[expose] def A_1_3 : Prop :=
  ∀ (p f : ℕ) [Fact p.Prime], 1 ≤ f → ∀ (H : Subgroup PSL(2, GaloisField p f)),
    (IsElemAbelian p H ∧ ∃ m : ℕ, m ≤ f ∧ Nat.card H = p ^ m) ∨
    (IsCyclic H ∧ (Nat.card H ∣ (p ^ f + 1) / Nat.gcd 2 (p ^ f - 1) ∨
      Nat.card H ∣ (p ^ f - 1) / Nat.gcd 2 (p ^ f - 1))) ∨
    (∃ z : ℕ, (z ∣ (p ^ f + 1) / Nat.gcd 2 (p ^ f - 1) ∨
      z ∣ (p ^ f - 1) / Nat.gcd 2 (p ^ f - 1)) ∧ Nonempty (H ≃* DihedralGroup z)) ∨
    ((p ≠ 2 ∨ Even f) ∧ Nonempty (H ≃* alternatingGroup (Fin 4))) ∨
    (16 ∣ p ^ (2 * f) - 1 ∧ Nonempty (H ≃* Equiv.Perm (Fin 4))) ∨
    ((p = 5 ∨ 5 ∣ p ^ (2 * f) - 1) ∧ Nonempty (H ≃* alternatingGroup (Fin 5))) ∨
    (∃ (m t : ℕ) (P : Subgroup H) (_ : P.Normal), IsElemAbelian p P ∧
      Nat.card P = p ^ m ∧ IsCyclic (H ⧸ P) ∧ Nat.card (H ⧸ P) = t ∧ t ∣ p ^ m - 1 ∧
      t ∣ (p ^ f - 1) / Nat.gcd 2 (p ^ f - 1)) ∨
    (∃ m : ℕ, m ∣ f ∧ Nonempty (H ≃* PSL(2, GaloisField p m))) ∨
    (∃ m : ℕ, 2 * m ∣ f ∧ Nonempty (H ≃* PGL(2, GaloisField p m)))

section BurnsideA1b8

section Cert43

private local instance : DecidableEq (Equiv.Perm (Fin 3)) := Fintype.decidableEqEquivFintype

private theorem burnside_certificate43 :
      ∀ s t : Equiv.Perm (Fin 3),
        (s ≠ 1 ∧ s ^ 2 = 1) → (t ≠ 1 ∧ t ^ 2 = 1) → s ≠ t →
          (s * t) ^ 3 = 1 ∧ s * t ≠ 1 := by
  decide +kernel

end Cert43



private theorem burnside_oddCoreIn_le_relPPrimeCore {G : Type} [Group G] (H : Subgroup G) :
    CFSG.QuasithinUnique.oddCoreIn H ≤ CFSG.Open.relPPrimeCore 2 H := by
  unfold CFSG.QuasithinUnique.oddCoreIn CFSG.Open.fusionOddCore
  rw [Subgroup.map_le_iff_le_comap]
  refine sSup_le fun N hN => ?_
  rw [← Subgroup.map_le_iff_le_comap]
  refine le_sSup ⟨Subgroup.map_subtype_le N, ?_, ?_⟩
  · have h : (N.map H.subtype).subgroupOf H = N :=
      Subgroup.comap_map_eq_self_of_injective H.subtype_injective N
    rw [h]
    exact hN.1
  · rw [Subgroup.card_map_of_injective H.subtype_injective]
    exact Nat.coprime_two_left.mpr hN.2

end BurnsideA1b8

theorem as_A_1_3 : A_1_3 := by
  haveI := burnside_certificate43
  exact CFSG.Quasithin.F6.dicksonPSL2_holds

@[expose] def A_1_4 : Prop :=
  ∀ (K : Type) [Group K] [Finite K], Group.IsSolvable K →
    (∀ p : ℕ, p.Prime → p ∣ Nat.card (CFSG.fittingSubgroup K) →
      oResidual {p} (⊤ : Subgroup K) ≤ centralizerOf (pCore p K)) →
    ChA.IsPiGroup {p : ℕ | p.Prime ∧ p ∣ Nat.card (CFSG.fittingSubgroup K)} K ∧
      CFSG.fittingSubgroup K = ⊤ ∧ Group.IsNilpotent K

private theorem burnside_pResidual_le_oResidual_singleton (p : ℕ) (K : Type) [Group K] :
    CFSG.Quasithin.pResidual p K ≤ ChA.oResidual {p} (⊤ : Subgroup K) := by
  refine le_iInf fun N => le_iInf fun hN => ?_
  obtain ⟨-, hNn, hN⟩ := hN
  haveI : N.Normal :=
    Subgroup.normalizer_eq_top_iff.mp
      (top_le_iff.mp ((Subgroup.normal_subgroupOf_iff_le_normalizer le_top).mp hNn))
  refine CFSG.Quasithin.pResidual_le fun x => ?_
  obtain ⟨m, hm0, hmp, hxm⟩ := hN x trivial
  refine ⟨m.primeFactorsList.length, ?_⟩
  rw [← Nat.eq_prime_pow_of_unique_prime_dvd hm0.ne' fun {q} hq hqm => hmp q hq hqm]
  exact hxm

theorem as_A_1_4 : A_1_4 := by
  intro K _ _ hsolv h
  haveI : Group.IsSolvable K := hsolv
  have h' : ∀ p : ℕ, p.Prime → p ∣ Nat.card (genFittingFitting K) →
      CFSG.Quasithin.pResidual p K ≤ Subgroup.centralizer (CFSG.Open.pCore p K : Set K) := by
    intro p hp hpF
    exact (burnside_pResidual_le_oResidual_singleton p K).trans (h p hp hpF)
  obtain ⟨h1, h2, h3⟩ := CFSG.Quasithin.isNilpotent_of_pResidual_le_centralizer h'
  exact ⟨fun q hq hqK => ⟨hq, h1 q hq hqK⟩, h2, h3⟩

@[expose] def A_1_5 : Prop :=
  ∀ (Γ : Type) [Group Γ] [Finite Γ] (X A : Subgroup Γ) (n : ℕ),
    Odd (Nat.card X) → A ≤ ChA.normalizerOf X → IsElemAbelian 2 A → Nat.card A = 2 ^ n →
    A ⊓ centralizerOf X = ⊥ →
    ∃ (Y : Fin n → Subgroup Γ) (p : Fin n → ℕ),
      A ≤ ⨆ i, Y i ∧ (⨆ i, Y i) ≤ A ⊔ X ∧
