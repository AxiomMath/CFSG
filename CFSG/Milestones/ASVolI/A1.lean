private theorem burnsideA134_false_of_isSU3_eight {H : Type} [Group H] [Finite H]
    (he : CFSG.Open.evenRank H ≤ 2) {L₁ L₂ : Subgroup H}
    (hc : ∀ a ∈ L₁, ∀ b ∈ L₂, Commute a b) (φ : ↥L₁ ≃* ↥L₂)
    (h : CFSG.Quasithin.IsSU3 8 ↥L₁) : False := by
  obtain ⟨K, hFld, hfin, hK, ⟨ψ⟩⟩ := h
  have hK' : Nat.card K = (2 ^ 3) ^ 2 := by rw [hK]; norm_num
  have hZ : Nat.card (Subgroup.center ↥L₁) = 3 := by
    have h3 := CFSG.Open.StatedCenterThree.card_center_statedSU_three (K := K) (q := 8) hK
      (by norm_num)
    rw [← h3, ← Nat.card_congr (Subgroup.centerCongr ψ).toEquiv]
  obtain ⟨x, t, e', ht2, ht1, hxt, hxe, he3, hx3c, hx3, hexω⟩ :=
    CFSG.SectionRank.QTK.CentreFact.LayerPair.exists_torus_data_su_three_eight (K := K) hK'
  let ψ' : StatedSU 3 (2 ^ 3) K ≃* ↥L₁ := ψ.symm
  refine CFSG.SectionRank.QTK.CentreFact.LayerPair.false_of_pair_torus_data he hc φ hZ
    (x := ψ' x) (t := ψ' t) (e := ψ' e') ?_ ?_ (hxt.map ψ') (hxe.map ψ') ?_ ?_ ?_ ?_
  · rw [← map_pow, ht2, map_one]
  · exact fun h => ht1 (ψ'.injective (by rw [h, map_one]))
  · rw [← map_pow, he3, map_one]
  · rw [← map_pow]
    refine Subgroup.mem_center_iff.2 fun g => ψ'.symm.injective ?_
    rw [map_mul, map_mul, MulEquiv.symm_apply_apply]
    exact Subgroup.mem_center_iff.1 hx3c (ψ'.symm g)
  · exact fun h => hx3 (ψ'.injective (by rw [map_pow, h, map_one]))
  · intro h
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp h
    refine hexω (Subgroup.mem_zpowers_iff.mpr ⟨m, ψ'.injective ?_⟩)
    rw [map_zpow, map_pow]
    exact hm

