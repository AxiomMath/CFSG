  · rw [Nat.card_congr e.toEquiv]
    show Nat.card (Fin n → ZMod p) = p ^ n
    rw [Nat.card_fun, Nat.card_zmod, Nat.card_eq_fintype_card, Fintype.card_fin]



private theorem a1b4_isExtraspecial_of_mulEquiv {p : ℕ} {A B : Type*} [Group A] [Group B] (e :
    A ≃* B)
    (h : CFSG.IsExtraspecial p A) : CFSG.IsExtraspecial p B := by
  have hcen : (Subgroup.center A).map (e : A →* B) = Subgroup.center B :=
    Subgroup.map_center_eq e
  let e' : A ⧸ Subgroup.center A ≃* B ⧸ Subgroup.center B := QuotientGroup.congr _ _ e hcen
  refine
    { center_order_p := ?_
      quotient_elementary_abelian := ?_
      quotient_nontrivial := ?_ }
  · rw [← hcen, Subgroup.card_map_of_injective e.injective]
    exact h.center_order_p
  · exact CFSG.IsElementaryAbelian.of_mulEquiv e' h.quotient_elementary_abelian
  · have := h.quotient_nontrivial
    exact e'.toEquiv.symm.nontrivial

private theorem a1b4_frattini_map_mulEquiv {A B : Type*} [Group A] [Group B] (e : A ≃* B) :
    (frattini A).map e.toMonoidHom = frattini B :=
  OrderIso.map_radical (MulEquiv.mapSubgroup e)

private theorem a1b4_isSupercritical_subgroupOf {G : Type} [Group G] {p : ℕ} {P X : Subgroup G}
    (hX : ChA.IsSupercritical p P X) :
    CFSG.Quasithin.IsSupercritical p (X.subgroupOf P) := by
  obtain ⟨hXP, hXchar, hXfr, hXcomm, hXpow, hXtop⟩ := hX
  let e : ↥(X.subgroupOf P) ≃* ↥X := Subgroup.subgroupOfEquivOfLe hXP
  have key : ∀ y : ↥P, (y : G) ∈ ChA.centerOf X →
      y ∈ CFSG.Quasithin.centerOf (X.subgroupOf P) := by
    intro y hy
    have hc : y ∈ Subgroup.centralizer ((X.subgroupOf P : Subgroup ↥P) : Set ↥P) := by
      refine Subgroup.mem_centralizer_iff.2 fun z hz => ?_
      have := Subgroup.mem_centralizer_iff.1 hy.2 (z : G) hz
      exact Subtype.ext this
    exact ⟨hy.1, hc⟩
  refine ⟨hXchar, ?_, ?_, ?_, ?_⟩
  · rintro _ ⟨y, hy, rfl⟩
    apply key
    have hy' : e y ∈ frattini ↥X := by
      rw [← a1b4_frattini_map_mulEquiv e]
      exact Subgroup.mem_map_of_mem _ hy
    exact hXfr ⟨e y, hy', rfl⟩
  · rw [Subgroup.commutator_le]
    intro a ha b _
    apply key
    exact hXcomm (Subgroup.commutator_mem_commutator ha b.2)
  · intro x hx
    exact Subtype.ext (hXpow (x : G) hx)
  · intro x hx hord
    have hxc : (x : G) ∈ ChA.centralizerOf X := by
      refine Subgroup.mem_centralizer_iff.2 fun z hz => ?_
      have := Subgroup.mem_centralizer_iff.1 hx (⟨z, hXP hz⟩ : ↥P) hz
      exact congrArg Subtype.val this
    have hxP : (x : G) ∈ P ⊓ ChA.centralizerOf X := ⟨x.2, hxc⟩
    exact hXtop (x : G) hxP (by rw [Subgroup.orderOf_coe]; exact hord)


private theorem a1b4_pCore_quotient_pCore_eq_bot {H : Type*} [Group H] {p : ℕ} :
    CFSG.pCore p (H ⧸ CFSG.pCore p H) = ⊥ := by
  set N : Subgroup H := CFSG.pCore p H with hN
  set K : Subgroup H := (CFSG.pCore p (H ⧸ N)).comap (QuotientGroup.mk' N) with hK
  have hKp : IsPGroup p K := by
    rintro ⟨k, hk⟩
    obtain ⟨a, ha⟩ := (CFSG.pCore_isPGroup (G := H ⧸ N) (p := p)) ⟨_, hk⟩
    have h1 : k ^ p ^ a ∈ N := by
      have := congrArg Subtype.val ha
      simp only [Subgroup.coe_pow, Subgroup.coe_one] at this
      rwa [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at this
    obtain ⟨b, hb⟩ := (CFSG.pCore_isPGroup (G := H) (p := p)) ⟨_, h1⟩
    refine ⟨a + b, Subtype.ext ?_⟩
    have := congrArg Subtype.val hb
    simp only [Subgroup.coe_pow, Subgroup.coe_one] at this ⊢
    rw [pow_add, pow_mul]
    exact this
  have hKN : K ≤ N := le_sSup ⟨inferInstance, hKp⟩
  rw [eq_bot_iff]
  intro x hx
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N x
  have hy : y ∈ N := hKN hx
  rw [Subgroup.mem_bot, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  exact hy

