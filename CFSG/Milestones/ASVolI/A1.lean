private theorem a119_isTwoReduced_top_iff {G : Type} [Group G] (V : Subgroup G) :
    ChA.IsTwoReduced (⊤ : Subgroup G) V ↔
      CFSG.Quasithin.IsTwoReducedIn (⊤ : Subgroup G) V := by
  constructor
  · rintro ⟨-, hVn, hVel, hred⟩
    have hVtop : (⊤ : Subgroup G) ≤ Subgroup.normalizer (V : Set G) :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer (le_top : V ≤ ⊤)).1 hVn
    have hVnorm : V.Normal := Subgroup.normalizer_eq_top_iff.1 (top_le_iff.1 hVtop)
    refine ⟨le_top, hVtop, hVel, fun D _ hD hDV => ?_⟩
    have hDnorm : D.Normal := Subgroup.normalizer_eq_top_iff.1 (top_le_iff.1 hD)
    have hCnorm : (Subgroup.centralizer (V : Set G)).Normal := inferInstance
    have hNnorm : (D ⊔ Subgroup.centralizer (V : Set G)).Normal := inferInstance
    have hN := hred (D ⊔ Subgroup.centralizer (V : Set G))
      (fun x hx => Subgroup.mem_sup_right hx.2) le_top
      ((Subgroup.normal_subgroupOf_iff_le_normalizer le_top).2 Subgroup.le_normalizer_of_normal)
      (by
        intro x hx
        obtain ⟨d, hd, c, hc, rfl⟩ := Subgroup.mem_sup_of_normal_left.1 hx
        obtain ⟨k, hk⟩ := hDV d hd
        refine ⟨k, Subgroup.mem_top _, ?_⟩
        show (d * c) ^ 2 ^ k ∈ Subgroup.centralizer (V : Set G)
        let π := QuotientGroup.mk' (Subgroup.centralizer (V : Set G))
        have hc1 : π c = 1 := (QuotientGroup.eq_one_iff c).2 hc
        have h1 : π (d * c) = π d := by rw [map_mul, hc1, mul_one]
        have h2 : π ((d * c) ^ 2 ^ k) = 1 := by
          rw [map_pow, h1, ← map_pow]
          exact (QuotientGroup.eq_one_iff _).2 hk
        exact (QuotientGroup.eq_one_iff _).1 h2)
    exact fun x hx => (hN (Subgroup.mem_sup_left hx)).2
  · rintro ⟨-, hVn, hVel, hred⟩
    refine ⟨le_top, (Subgroup.normal_subgroupOf_iff_le_normalizer le_top).2 hVn, hVel,
      fun N _ _ hNn hNk => ?_⟩
    have hNc : N ≤ Subgroup.centralizer (V : Set G) :=
      hred N le_top ((Subgroup.normal_subgroupOf_iff_le_normalizer le_top).1 hNn)
        (fun d hd => (hNk d hd).imp fun k hk => hk.2)
    exact fun x hx => ⟨Subgroup.mem_top x, hNc hx⟩

private theorem a119_twoReducedProduct_top_eq {G : Type} [Group G] :
    ChA.twoReducedProduct (⊤ : Subgroup G) =
      CFSG.Quasithin.twoReducedProduct (⊤ : Subgroup G) := by
  unfold ChA.twoReducedProduct CFSG.Quasithin.twoReducedProduct
  rw [sSup_eq_iSup]
  exact iSup_congr fun V => iSup_congr_Prop (a119_isTwoReduced_top_iff V) fun _ => rfl

private theorem a118_oResidual_singleton_eq {Γ : Type} [Group Γ] [Finite Γ] {p : ℕ} (hp : p.Prime)
    (A : Subgroup Γ) : ChA.oResidual {p} A = CFSG.Quasithin.opResidual p A := by
  haveI : Fact p.Prime := ⟨hp⟩
  apply le_antisymm
  · refine iInf₂_le_of_le (CFSG.Quasithin.opResidual p A)
      ⟨CFSG.Quasithin.opResidual_le p A, CFSG.Quasithin.opResidual_normal p A, fun x hx => ?_⟩
      le_rfl
    obtain ⟨k, hk⟩ := CFSG.Quasithin.exists_pow_mem_opResidual (p := p) hx
    refine ⟨p ^ k, pow_pos hp.pos k, fun q hq hqd => ?_, hk⟩
    exact (Nat.prime_dvd_prime_iff_eq hq hp).1 (hq.dvd_of_dvd_pow hqd)
  · refine le_iInf₂ fun N hN => ?_
    obtain ⟨-, -, hNm⟩ := hN
    refine CFSG.Quasithin.opResidual_le_of_pow_mem fun x hx => ?_
    obtain ⟨m, hm0, hmq, hxm⟩ := hNm x hx
    obtain ⟨k, hk⟩ : ∃ k : ℕ, m = p ^ k :=
      ⟨_, Nat.eq_prime_pow_of_unique_prime_dvd hm0.ne' fun {d} hd hdm => hmq d hd hdm⟩
    exact ⟨k, hk ▸ hxm⟩

private theorem a118_element {Γ : Type} [Group Γ] [Finite Γ] {p : ℕ} [Fact p.Prime] {A B G :
    Subgroup Γ}
    (hG : IsPGroup p G) (hAG : A ≤ Subgroup.normalizer (G : Set Γ))
    (hBG : B ≤ Subgroup.normalizer (G : Set Γ)) (hAB : ⁅A, B⁆ = ⊥) (hB : IsPGroup p B)
    {a : Γ} (haA : a ∈ A) (ha : (orderOf a).Coprime p)
    (h : ∀ x ∈ G ⊓ Subgroup.centralizer (B : Set Γ), a * x = x * a) :
    a ∈ Subgroup.centralizer (G : Set Γ) := by
  let ρ : Subgroup.normalizer (G : Set Γ) →* MulAut G := G.normalizerMonoidHom
  have hρ : ∀ (k : Subgroup.normalizer (G : Set Γ)) (u : G),
      ((ρ k u : G) : Γ) = (k : Γ) * u * (k : Γ)⁻¹ := fun k u => rfl
  have hBp : IsPGroup p (((B.subgroupOf (Subgroup.normalizer (G : Set Γ)))).map ρ) :=
    (hB.of_equiv (Subgroup.subgroupOfEquivOfLe hBG).symm).map ρ
  have haK : a ∈ Subgroup.normalizer (G : Set Γ) := hAG haA
  have hacop : (orderOf (⟨a, haK⟩ : Subgroup.normalizer (G : Set Γ))).Coprime p := by
    rw [Subgroup.orderOf_mk]
    exact ha
  have key := CFSG.Quasithin.thompson_AxB_element (p := p) hG ρ hBp (a := ⟨a, haK⟩) hacop ?_ ?_
  · rw [Subgroup.mem_centralizer_iff]
    intro g hg
    have h1 := congrArg (fun φ : MulAut G => ((φ ⟨g, hg⟩ : G) : Γ)) key
    simp only [hρ, MulAut.one_apply] at h1
    rw [mul_inv_eq_iff_eq_mul] at h1
    exact h1.symm
  · intro b hb
    have hbB : (b : Γ) ∈ B := Subgroup.mem_subgroupOf.1 hb
    have hcomm : a * (b : Γ) = (b : Γ) * a := by
      have := Subgroup.commutator_mem_commutator haA hbB
      rw [hAB, Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm] at this
      exact this
    ext u
    simp only [MulAut.mul_apply, hρ]
    calc a * ((b : Γ) * u * (b : Γ)⁻¹) * a⁻¹
        = (a * b) * u * (a * b)⁻¹ := by group
      _ = (b * a) * u * (b * a)⁻¹ := by rw [hcomm]
      _ = (b : Γ) * (a * u * a⁻¹) * (b : Γ)⁻¹ := by group
  · intro x hx
    have hxC : (x : Γ) ∈ Subgroup.centralizer (B : Set Γ) := by
      rw [Subgroup.mem_centralizer_iff]
      intro b hb
      have hbK : b ∈ Subgroup.normalizer (G : Set Γ) := hBG hb
      have h1 := congrArg Subtype.val (hx ⟨b, hbK⟩ (Subgroup.mem_subgroupOf.2 hb))
      change b * (x : Γ) * b⁻¹ = x at h1
      rw [mul_inv_eq_iff_eq_mul] at h1
      exact h1
    have h2 := h x ⟨x.2, hxC⟩
    apply Subtype.ext
    change a * (x : Γ) * a⁻¹ = x
    rw [mul_inv_eq_iff_eq_mul]
    exact h2

private theorem a117_fixed_map {Γ : Type} [Group Γ] {A G : Subgroup Γ}
    (hAG : A ≤ Subgroup.normalizer (G : Set Γ)) (B : Subgroup ↥A) :
    haveI : Subgroup.Normalizes A G := ⟨hAG⟩
    (CFSG.fixedPointSubgroup ↥B ↥G).map G.subtype =
      G ⊓ Subgroup.centralizer ((B.map A.subtype : Subgroup Γ) : Set Γ) := by
  haveI : Subgroup.Normalizes A G := ⟨hAG⟩
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    refine ⟨y.2, Subgroup.mem_centralizer_iff.2 ?_⟩
    rintro _ ⟨b, hb, rfl⟩
    have h1 := congrArg Subtype.val (hy ⟨b, hb⟩)
    change (b : Γ) * (y : Γ) * (b : Γ)⁻¹ = y at h1
    rw [mul_inv_eq_iff_eq_mul] at h1
    exact h1
  · rintro ⟨hxG, hxC⟩
    refine ⟨⟨x, hxG⟩, (FixedPoints.mem_subgroup (M := ↥B) (α := ↥G) _).2 fun b => ?_, rfl⟩
    apply Subtype.ext
    have h1 : ((b : A) : Γ) * x = x * ((b : A) : Γ) :=
      Subgroup.mem_centralizer_iff.1 hxC _ ⟨(b : A), b.2, rfl⟩
    change ((b : A) : Γ) * x * ((b : A) : Γ)⁻¹ = x
    rw [mul_inv_eq_iff_eq_mul]
    exact h1

private theorem a117_map_sup_zpowers {Γ : Type} [Group Γ] {A : Subgroup Γ} (B : Subgroup ↥A)
    (a₀ : ↥A) :
    (B ⊔ Subgroup.zpowers a₀).map A.subtype =
      B.map A.subtype ⊔ Subgroup.zpowers (a₀ : Γ) := by
  rw [Subgroup.map_sup, MonoidHom.map_zpowers]
  rfl

open scoped IsMulCommutative in
private theorem a117_mem_fam {Γ : Type} [Group Γ] {A G : Subgroup Γ} [IsMulCommutative A]
    (hAG : A ≤ Subgroup.normalizer (G : Set Γ)) (B : Subgroup ↥A) :
    haveI : Subgroup.Normalizes A G := ⟨hAG⟩
    (IsCyclic (↥A ⧸ B) ∧ CFSG.fixedPointSubgroup ↥B ↥G ≠ ⊥) ↔
      B.map A.subtype ∈ ChA.cyclicQuotientCentralizerFamily A G := by
  haveI : Subgroup.Normalizes A G := ⟨hAG⟩
  have hmap := a117_fixed_map hAG B
  have hne : CFSG.fixedPointSubgroup ↥B ↥G ≠ ⊥ ↔
      G ⊓ ChA.centralizerOf (B.map A.subtype) ≠ ⊥ := by
    have h := Subgroup.map_eq_bot_iff_of_injective (CFSG.fixedPointSubgroup ↥B ↥G)
      G.subtype_injective
    rw [hmap] at h
    exact not_congr h.symm
  constructor
  · rintro ⟨hcyc, hfix⟩
    refine ⟨Subgroup.map_subtype_le B, ?_, hne.1 hfix⟩
    obtain ⟨g, hg⟩ := hcyc.exists_generator
    obtain ⟨a₀, rfl⟩ := QuotientGroup.mk_surjective g
    refine ⟨a₀, a₀.2, fun x hx => ?_⟩
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 (hg (QuotientGroup.mk (⟨x, hx⟩ : ↥A)))
    have hmem : ((a₀ : ↥A) ^ k)⁻¹ * ⟨x, hx⟩ ∈ B := by
      rw [← QuotientGroup.eq, ← hk]
      exact (QuotientGroup.mk_zpow _ _ _).symm
    have hx' : (⟨x, hx⟩ : ↥A) = ((a₀ : ↥A) ^ k)⁻¹ * ⟨x, hx⟩ * (a₀ : ↥A) ^ k := by
      rw [mul_comm, mul_inv_cancel_left]
    have hxe : x = ((((a₀ : ↥A) ^ k)⁻¹ * ⟨x, hx⟩ : ↥A) : Γ) * ((a₀ : Γ) ^ k) := by
      exact congrArg Subtype.val hx'
    rw [hxe]
    exact Subgroup.mul_mem_sup (Subgroup.mem_map_of_mem _ hmem)
      (Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) _)
  · rintro ⟨-, ⟨a, ha, hsup⟩, hne'⟩
    refine ⟨⟨⟨QuotientGroup.mk ⟨a, ha⟩, fun q => ?_⟩⟩, hne.2 hne'⟩
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective q
    have hx : (x : Γ) ∈ B.map A.subtype ⊔ Subgroup.zpowers a := hsup x.2
    rw [← a117_map_sup_zpowers B ⟨a, ha⟩] at hx
    have hx' : x ∈ B ⊔ Subgroup.zpowers (⟨a, ha⟩ : ↥A) := by
      obtain ⟨y, hy, hyx⟩ := hx
      have : y = x := Subtype.ext hyx
      exact this ▸ hy
    obtain ⟨y, hy, z, hz, hyz⟩ := Subgroup.mem_sup.1 hx'
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hz
    refine ⟨k, ?_⟩
    rw [← hyz, QuotientGroup.mk_mul, (QuotientGroup.eq_one_iff y).2 hy, one_mul,
      QuotientGroup.mk_zpow]

open scoped IsMulCommutative in
private theorem a117_generation_le {Γ : Type} [Group Γ] [Finite Γ] {r : ℕ} [Fact r.Prime]
    {A G : Subgroup Γ} (hA : IsPGroup r A) [IsMulCommutative A]
    (hAG : A ≤ Subgroup.normalizer (G : Set Γ)) (hG : ¬ r ∣ Nat.card G) :
    G ≤ ⨆ B ∈ ChA.cyclicQuotientCentralizerFamily A G, G ⊓ ChA.centralizerOf B := by
  haveI : Subgroup.Normalizes A G := ⟨hAG⟩
  have h := CFSG.Quasithin.a117_generation (r := r) (A := ↥A) hA (G := ↥G) hG
  have h2 : (⊤ : Subgroup ↥G).map G.subtype ≤
      ⨆ B ∈ ChA.cyclicQuotientCentralizerFamily A G, G ⊓ ChA.centralizerOf B := by
    rw [← h, Subgroup.map_iSup]
    refine iSup_le fun B => ?_
    rw [Subgroup.map_iSup]
    refine iSup_le fun hB => ?_
    rw [a117_fixed_map hAG B]
    exact le_iSup₂_of_le (B.map A.subtype) ((a117_mem_fam hAG B).1 hB) le_rfl
  rwa [← MonoidHom.range_eq_map, Subgroup.range_subtype] at h2

private theorem a117_iSupIndep_map {Γ : Type} [Group Γ] {G : Subgroup Γ} {ι : Type*}
    {s : ι → Subgroup ↥G} (hs : iSupIndep s) : iSupIndep (fun i => (s i).map G.subtype) := by
  rw [iSupIndep_def] at hs ⊢
  intro i
  have h := hs i
  rw [disjoint_iff] at h ⊢
  have e : (⨆ (j) (_ : j ≠ i), (s j).map G.subtype) =
      (⨆ (j) (_ : j ≠ i), s j).map G.subtype := by
    simp only [Subgroup.map_iSup]
  rw [e, ← Subgroup.map_inf _ _ _ G.subtype_injective, h, Subgroup.map_bot]

private theorem a121_map_frattini_mulEquiv {H K : Type*} [Group H] [Group K] (e : H ≃* K) :
    (frattini H).map e.toMonoidHom = frattini K := by
  apply le_antisymm
  · rw [Subgroup.map_le_iff_le_comap]
    exact frattini_le_comap_frattini_of_surjective e.surjective
  · have h := frattini_le_comap_frattini_of_surjective (φ := e.symm.toMonoidHom) e.symm.surjective
    intro y hy
    exact ⟨e.symm y, h hy, by simp⟩

private theorem a121_frattiniOf_map {G : Type} [Group G] (P : Subgroup G) (X' : Subgroup ↥P) :
    ChA.frattiniOf (X'.map P.subtype) = (CFSG.Quasithin.frattiniIn X').map P.subtype := by
  let e : ↥X' ≃* ↥(X'.map P.subtype) :=
    Subgroup.equivMapOfInjective X' P.subtype P.subtype_injective
  have h1 := a121_map_frattini_mulEquiv e
  unfold ChA.frattiniOf CFSG.Quasithin.frattiniIn
  rw [← h1, Subgroup.map_map, Subgroup.map_map]
  congr 1

private theorem a121_mem_centerOf_iff {G : Type} [Group G] (P : Subgroup G) (X' : Subgroup ↥P)
    (y : ↥P) : y ∈ CFSG.Quasithin.centerOf X' ↔ (y : G) ∈ ChA.centerOf (X'.map P.subtype) := by
  constructor
  · rintro ⟨hy, hyc⟩
    refine ⟨Subgroup.mem_map_of_mem _ hy, Subgroup.mem_centralizer_iff.2 ?_⟩
    rintro _ ⟨z, hz, rfl⟩
    exact congrArg Subtype.val (Subgroup.mem_centralizer_iff.1 hyc z hz)
  · rintro ⟨hy, hyc⟩
    obtain ⟨y', hy', hyy'⟩ := hy
    have : y' = y := Subtype.ext hyy'
    subst this
    refine ⟨hy', Subgroup.mem_centralizer_iff.2 fun z hz => Subtype.ext ?_⟩
    exact Subgroup.mem_centralizer_iff.1 hyc (z : G) (Subgroup.mem_map_of_mem _ hz)

private theorem a121_isSupercritical_iff {G : Type} [Group G] (P : Subgroup G) {p : ℕ}
    (X' : Subgroup ↥P) :
    ChA.IsSupercritical p P (X'.map P.subtype) ↔ CFSG.Quasithin.IsSupercritical p X' := by
  have hsub : (X'.map P.subtype).subgroupOf P = X' :=
    Subgroup.comap_map_eq_self_of_injective P.subtype_injective X'
  have hcomm : (⁅X', (⊤ : Subgroup ↥P)⁆).map P.subtype = ⁅X'.map P.subtype, P⁆ := by
    rw [Subgroup.map_commutator, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  constructor
  · rintro ⟨-, hchar, hfr, hcom, hpow, hord⟩
    rw [hsub] at hchar
    refine ⟨hchar, fun y hy => ?_, fun y hy => ?_, fun x hx => ?_, fun x hx hxp => ?_⟩
    · have hy' : (y : G) ∈ ChA.frattiniOf (X'.map P.subtype) := by
        rw [a121_frattiniOf_map]
        exact Subgroup.mem_map_of_mem _ hy
      exact (a121_mem_centerOf_iff P X' y).2 (hfr hy')
    · have hy' : (y : G) ∈ ⁅X'.map P.subtype, P⁆ := by
        rw [← hcomm]
        exact Subgroup.mem_map_of_mem _ hy
      exact (a121_mem_centerOf_iff P X' y).2 (hcom hy')
    · exact Subtype.ext (hpow x (Subgroup.mem_map_of_mem _ hx))
    · have hx' : (x : G) ∈ P ⊓ ChA.centralizerOf (X'.map P.subtype) := by
        refine ⟨x.2, Subgroup.mem_centralizer_iff.2 ?_⟩
        rintro _ ⟨z, hz, rfl⟩
        exact congrArg Subtype.val (Subgroup.mem_centralizer_iff.1 hx z hz)
      have hxp' : orderOf (x : G) = p := by rwa [Subgroup.orderOf_coe]
      obtain ⟨z, hz, hzx⟩ := hord (x : G) hx' hxp'
      have : z = x := Subtype.ext hzx
      exact this ▸ hz
  · intro hX'
    refine ⟨Subgroup.map_subtype_le X', ?_, ?_, ?_, ?_, ?_⟩
    · rw [hsub]
      exact hX'.characteristic
    · rw [a121_frattiniOf_map]
      rintro _ ⟨y, hy, rfl⟩
      exact (a121_mem_centerOf_iff P X' y).1 (hX'.frattini_le hy)
    · intro z hz
      rw [← hcomm] at hz
      obtain ⟨y, hy, rfl⟩ := hz
      exact (a121_mem_centerOf_iff P X' y).1 (hX'.commutator_le hy)
    · rintro _ ⟨y, hy, rfl⟩
      exact congrArg Subtype.val (hX'.pow_eq_one y hy)
    · rintro x ⟨hxP, hxc⟩ hxp
      have hx'c : (⟨x, hxP⟩ : ↥P) ∈ Subgroup.centralizer (X' : Set ↥P) := by
        refine Subgroup.mem_centralizer_iff.2 fun z hz => Subtype.ext ?_
        exact Subgroup.mem_centralizer_iff.1 hxc (z : G) (Subgroup.mem_map_of_mem _ hz)
      have hxp' : orderOf (⟨x, hxP⟩ : ↥P) = p := by
        rw [← Subgroup.orderOf_coe]
        exact hxp
      exact Subgroup.mem_map_of_mem P.subtype (hX'.mem_of_orderOf_eq _ hx'c hxp')

private theorem a121_frattiniIn_conj_mem {P : Type*} [Group P] {X' : Subgroup P} {x w : P} (hx
    : x ∈ X')
    (hw : w ∈ CFSG.Quasithin.frattiniIn X') : x⁻¹ * w * x ∈ CFSG.Quasithin.frattiniIn X' := by
  obtain ⟨f, hf, rfl⟩ := hw
  have hf' : (⟨x, hx⟩ : ↥X')⁻¹ * f * ⟨x, hx⟩ ∈ frattini ↥X' :=
    (inferInstance : (frattini ↥X').Normal).conj_mem' f hf ⟨x, hx⟩
  exact ⟨_, hf', rfl⟩

theorem as_A_1_16 : A_1_16 := by
  intro G _ _ Y _ C D hYD
  have hq := CFSG.Quasithin.quotient_inf_eq Y (C := C) hYD
  refine ⟨⟨hq.2, hq.1⟩, fun hC hCD => ?_⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hidx : ¬ 2 ∣ C.index := by
    have h := hC.2.2
    rwa [← Subgroup.relIndex, Subgroup.relIndex_top_right] at h
  let S : Sylow 2 G := hC.2.1.toSylow hidx
  exact CFSG.Quasithin.isSylowIn_inf_of_quotient Y hYD S hCD

@[expose] def A_1_17 : Prop :=
  ∀ (Γ : Type) [Group Γ] [Finite Γ] (r : ℕ), r.Prime → ∀ (A G : Subgroup Γ),
    IsPGroup r A → IsMulCommutative A → A ≤ ChA.normalizerOf G → Nat.Coprime r (Nat.card G) →
    (G = ⨆ B ∈ cyclicQuotientCentralizerFamily A G, G ⊓ centralizerOf B) ∧
    (IsElemAbelian r A → IsMulCommutative G → ⁅G, A⁆ = G →
      iSupIndep (fun B : cyclicQuotientCentralizerFamily A G => G ⊓ centralizerOf (B : Subgroup Γ)) ∧
      (⨆ B ∈ cyclicQuotientCentralizerFamily A G, G ⊓ centralizerOf B) = G)

open scoped IsMulCommutative in
theorem as_A_1_17 : A_1_17 := by
  intro Γ _ _ r hr A G hAp hAc hAG hcop
  haveI : Fact r.Prime := ⟨hr⟩
  haveI := hAc
  haveI : Subgroup.Normalizes A G := ⟨hAG⟩
  have hG : ¬ r ∣ Nat.card G := (Nat.Prime.coprime_iff_not_dvd hr).1 hcop
  have hgen : G = ⨆ B ∈ ChA.cyclicQuotientCentralizerFamily A G, G ⊓ ChA.centralizerOf B :=
    le_antisymm (a117_generation_le hAp hAG hG) (iSup₂_le fun B _ => inf_le_left)
  refine ⟨hgen, fun hAel hGc hGA => ⟨?_, hgen.symm⟩⟩
  haveI := hGc
  have hA' : ∀ a : ↥A, a ^ r = 1 := fun a => Subtype.ext (hAel.2 a a.2)
  have hGA' : CFSG.commutatorAction (A := ↥A) (G := ↥G) = ⊤ := by
    have h := CFSG.commutatorAction_subgroup_conj_map_eq_commutator G A hAG
    rw [hGA] at h
    apply Subgroup.map_injective G.subtype_injective
    rw [h, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  have hdp := CFSG.Quasithin.a117_isIndexedDirectProduct (r := r) (A := ↥A) hA'
    (G := ↥G) hG hGA'
  have hind := a117_iSupIndep_map hdp.independent
  have hf : ∀ B : ChA.cyclicQuotientCentralizerFamily A G,
      (B.1.subgroupOf A) ∈ {B : Subgroup ↥A | IsCyclic (↥A ⧸ B) ∧
        CFSG.fixedPointSubgroup ↥B ↥G ≠ ⊥} := fun B =>
    (a117_mem_fam hAG _).2 (by rw [Subgroup.map_subgroupOf_eq_of_le B.2.1]; exact B.2)
  have hfinj : Function.Injective (fun B : ChA.cyclicQuotientCentralizerFamily A G =>
      (⟨B.1.subgroupOf A, hf B⟩ : {B : Subgroup ↥A | IsCyclic (↥A ⧸ B) ∧
        CFSG.fixedPointSubgroup ↥B ↥G ≠ ⊥})) := by
    intro B C h
    apply Subtype.ext
    have h' : B.1.subgroupOf A = C.1.subgroupOf A := congrArg Subtype.val h
    rw [← Subgroup.map_subgroupOf_eq_of_le B.2.1, ← Subgroup.map_subgroupOf_eq_of_le C.2.1, h']
  have hcomp := hind.comp hfinj
  convert hcomp using 1
  funext B
  simp only [Function.comp]
  rw [a117_fixed_map hAG, Subgroup.map_subgroupOf_eq_of_le B.2.1]
  rfl

@[expose] def A_1_18 : Prop :=
  ∀ (Γ : Type) [Group Γ] [Finite Γ] (p : ℕ), p.Prime → ∀ (A B G : Subgroup Γ),
    IsPGroup p G → A ≤ ChA.normalizerOf G → B ≤ ChA.normalizerOf G → ⁅A, B⁆ = ⊥ →
    IsPGroup p B → oResidual {p} A = A →
    (⁅G ⊓ centralizerOf B, A⁆ = ⊥ → ⁅G, A⁆ = ⊥) ∧
    (A ⊓ centralizerOf G = ⊥ → pCoreOf p A = ⊥ →
