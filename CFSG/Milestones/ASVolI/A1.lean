    intro ho
    by_cases hc : Nat.Coprime o n
    · refine ⟨1, o, one_pos, (one_mul o).symm, fun q hq hqa => ?_, hc⟩
      exact absurd (Nat.le_of_dvd one_pos hqa) (by have := hq.two_le; omega)
    · obtain ⟨q, hq, hqd⟩ := Nat.exists_prime_and_dvd (n := Nat.gcd o n) hc
      have hqo : q ∣ o := hqd.trans (Nat.gcd_dvd_left o n)
