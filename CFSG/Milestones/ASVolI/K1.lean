open CFSG.Quasithin CFSG.Quasithin.H in
theorem as_K_3_3 : K_3_3 := by
  intro V _ _ G L hK s hmodel
  obtain ⟨hV, hHyp, hq2⟩ := hK
  obtain ⟨hadm, K', _, _, hK', ⟨e'⟩⟩ := hmodel
  have hs2 : 2 ≤ s := by
    obtain ⟨-, h1, -, h3⟩ := hadm
    by_contra h
    have : s = 1 := by omega
    subst this
    exact h3 (by simp)
  obtain ⟨-, hperf, hirr, hLG, hGN⟩ := B45U3.b4Hyp_data hHyp
  obtain ⟨A, hA, -, hAr⟩ := kq_le_iff.mp hq2
  have hAV := (rAV_le_two_iff hV hA).mp hAr
  have hsmall := B45U3.exists_small_involution hV hHyp hs2 hK' e' hA hAV
  have hnat : BinaryNaturalSU3 L ⊤ ⊥ s :=
    u3NaturalOfSmallDisplacement_holds s hs2 K' hK' V (fun v => by rw [← pow_two]; exact hV v) L
      hperf hirr ⟨e'⟩ hsmall
  obtain ⟨hq, hqh⟩ := B45U3.qOf_qhatOf_eq_two hLG hGN hs2 hnat
  obtain ⟨K, _, _, hK, hreal⟩ := id hnat
  haveI : CharP K 2 := CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic
    Nat.prime_two (by omega : 1 ≤ 2 * s) (H.SU3.card_eq_two_pow hK)
  obtain ⟨π, hπ⟩ : ∃ π : ↥(CFSG.Open.StatedSU 3 (2 ^ s) K) →* ↥L,
      (FFModel.nat (CFSG.Open.StatedSU 3 (2 ^ s) K)).RealizesVia L ⊤ ⊥ π := id hreal
  obtain ⟨e, he⟩ := exists_mulEquiv_of_realizesVia (CFSG.Open.StatedSU 3 (2 ^ s) K) hπ
  have hγ : ∀ γ : ↥(CFSG.Open.StatedSU 3 (2 ^ s) K), congrHom e ((π γ : ↥L) : MulAut V) =
      natAut (CFSG.Open.StatedSU 3 (2 ^ s) K) γ := fun γ => by
    ext x
    rw [congrHom_apply, he, MulEquiv.apply_symm_apply]
    rfl
  have hLe := map_congrHom_eq_natImage (CFSG.Open.StatedSU 3 (2 ^ s) K) hπ.1 e he
  have hinj : Function.Injective π := fun γ γ' h => by
    apply natAut_injective (CFSG.Open.StatedSU 3 (2 ^ s) K)
    rw [← hγ, ← hγ, h]
  let πi : ↥(CFSG.Open.StatedSU 3 (2 ^ s) K) ≃* ↥L := MulEquiv.ofBijective π ⟨hinj, hπ.1⟩
  have hVcard : Nat.card V = 2 ^ (6 * s) := by
    rw [Nat.card_congr e.toEquiv, card_stdMod, hK, Fintype.card_fin]
    ring
  have hcenter : Nat.card ↥(Subgroup.center ↥L) = Nat.gcd 3 (2 ^ s + 1) := by
    have h1 : Subgroup.map πi.toMonoidHom (Subgroup.center ↥(CFSG.Open.StatedSU 3 (2 ^ s) K)) =
        Subgroup.center ↥L := Subgroup.map_center_eq πi
    rw [← burnsideKD_card_center_statedSU (by omega) hK, ← h1]
    exact (Nat.card_congr (MulEquiv.subgroupMap πi _).toEquiv).symm
  refine ⟨hs2, ⟨K, inferInstance, inferInstance, hK, ⟨πi.symm⟩⟩, fun hs => ?_, fun hs => ?_, hnat,
    hVcard, fun T hT => burnsideKD_K33_T hV hLG hGN hT hs2 hK e hLe, hq, hqh⟩
  ·
    have h1 : Nat.card ↥(Subgroup.center ↥L) = 1 := by
      rw [hcenter]
      exact (burnsideKD_gcd_three s).1 hs
    have hZ : Subgroup.center ↥L = ⊥ := Subgroup.eq_bot_of_card_eq _ h1
    have hq1 : CFSG.IsQuasisimple ↥L := hHyp.2.2.1
    haveI : IsSimpleGroup (↥L ⧸ Subgroup.center ↥L) := hq1.2.1
    let e₁ : ↥L ≃* ↥L ⧸ Subgroup.center ↥L :=
      QuotientGroup.quotientBot.symm.trans (QuotientGroup.quotientMulEquivOfEq hZ.symm)
    exact e₁.isSimpleGroup
  · rw [hcenter]
    exact (burnsideKD_gcd_three s).2 hs

end

@[expose] def K_3_4 : Prop :=
  ∀ (V : Type) [CommGroup V] [Finite V] (G L : Subgroup (MulAut V)), KSetup V G L →
    ∀ r : ℕ, 1 < r → IsPSp4 2 r (Lbar L) →
      IsSp4F (2 ^ r) ↥L ∧
      (BinaryNaturalSp4 L ⊤ ⊥ r ∨ ∃ s, r = 2 * s ∧ TwistedTensorSp4 L ⊤ ⊥ s)

