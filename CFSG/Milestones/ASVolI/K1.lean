open scoped commutatorElement in
private theorem burnsideKE_center_psu33 {X : Type} [Group X] [Finite X] (hq : CFSG.IsQuasisimple X)
    (hodd : Odd (Nat.card (Subgroup.center X))) (h : IsPSU 3 3 1 (X ⧸ Subgroup.center X)) :
    Subgroup.center X = ⊥ := by
  have hperf : Group.IsPerfect X := hq.1
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨-, F, _, _, hF, ⟨e⟩⟩ := h
  have hF9 : Nat.card F = 9 := by rw [hF]; norm_num
  let e2 : StatedProj (StatedSU 3 3 F) ≃* StatedSU 3 3 F :=
    (QuotientGroup.quotientMulEquivOfEq
      (CFSG.LinearGroups.UnitaryThreeOverNine.statedScalars_subgroupOf_statedSU_eq_bot hF9)).trans
      QuotientGroup.quotientBot
  let α : X ⧸ Subgroup.center X ≃* StatedSU 3 3 F := e.trans e2
  let π : X →* StatedSU 3 3 F := α.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center X))
  have hπ : Function.Surjective π := α.surjective.comp (QuotientGroup.mk'_surjective _)
  have hker : π.ker = Subgroup.center X := CFSG.SectionRank.center_eq_ker_of_mulEquiv α
  have hsplit := CFSG.SectionRank.OddCover.prime_classical_three_central_odd_extension_splitting
    Nat.prime_three (by norm_num) (Or.inr ⟨rfl, by rw [hF9]; norm_num, rfl⟩) π hπ hker.le
    (hker ▸ hodd)
  obtain ⟨⟨s, hs, -⟩, hs2⟩ := hsplit
  obtain ⟨hbot, htop, hcomm⟩ := hs2 s hs
  have hcent : ∀ c ∈ π.ker, ∀ x : X, x * c = c * x := fun c hc x =>
    Subgroup.mem_center_iff.mp (hker ▸ hc) x
  have hcl : ∀ c ∈ π.ker, ∀ g h : X, ⁅c * g, h⁆ = ⁅g, h⁆ := by
    intro c hc g h
    have e1 : c * (g * h * g⁻¹) * c⁻¹ = g * h * g⁻¹ := by
      rw [mul_inv_eq_iff_eq_mul]
      exact (hcent c hc _).symm
    calc ⁅c * g, h⁆ = (c * (g * h * g⁻¹) * c⁻¹) * h⁻¹ := by
          simp [commutatorElement_def, mul_assoc]
      _ = ⁅g, h⁆ := by rw [e1]; simp [commutatorElement_def]
  have hcr : ∀ c ∈ π.ker, ∀ g h : X, ⁅g, c * h⁆ = ⁅g, h⁆ := by
    intro c hc g h
    rw [← commutatorElement_inv, hcl c hc, commutatorElement_inv]
  have hcommle : commutator X ≤ s.range := by
    rw [commutator_def]
    refine Subgroup.commutator_le.2 fun a _ b _ => ?_
    obtain ⟨c₁, hc₁, g₁, hg₁, rfl⟩ := Subgroup.mem_sup_of_normal_left.1 (htop ▸ Subgroup.mem_top a)
    obtain ⟨c₂, hc₂, g₂, hg₂, rfl⟩ := Subgroup.mem_sup_of_normal_left.1 (htop ▸ Subgroup.mem_top b)
    rw [hcl c₁ hc₁, hcr c₂ hc₂, commutatorElement_def]
    exact s.range.mul_mem (s.range.mul_mem (s.range.mul_mem hg₁ hg₂) (s.range.inv_mem hg₁))
      (s.range.inv_mem hg₂)
  have hS : s.range = ⊤ := by
    rw [eq_top_iff]
    exact (by rw [hperf.1] : (⊤ : Subgroup X) ≤ commutator X).trans hcommle
  rw [hS, inf_top_eq] at hbot
  rw [← hker]
  exact hbot

