private theorem burnsideKD_planeUnipotent_eq_radical {K : Type} [Field K] :
    CFSG.ASVolI.ChIJK.planeUnipotent (StatedSp 2 K) (planeK K) = radical K := by
  unfold CFSG.ASVolI.ChIJK.planeUnipotent
  rw [← Subgroup.closure_eq (radical K)]
  congr 1
  ext g
  exact (burnsideKD_mem_radical_iff g).symm

open CFSG.Quasithin CFSG.Quasithin.H CFSG.Quasithin.B42Sp4 CFSG.Assembly.LowTwoRank in
open scoped Matrix in
private theorem burnsideKD_isQuadratic_radImage {K : Type} [Field K] : IsQuadratic (radImage K)
    := by
  unfold IsQuadratic commV
  rw [Subgroup.closure_le]
  rintro _ ⟨x, hx, v, rfl⟩ y hy
  obtain ⟨γ, hγ, rfl⟩ := hx
  obtain ⟨γ', hγ', rfl⟩ := hy
  have hw : Multiplicative.toAdd ((natAut (StatedSp 2 K) γ) v * v⁻¹) =
      (((γ : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) *ᵥ
        Multiplicative.toAdd v) - Multiplicative.toAdd v := by
    rw [toAdd_mul, toAdd_inv, sub_eq_add_neg]
    rfl
  have hwp : Multiplicative.toAdd ((natAut (StatedSp 2 K) γ) v * v⁻¹) ∈ planeK K := by
    rw [hw]
    exact ((burnsideKD_mem_radical_iff γ).mp hγ).2 _
  apply Multiplicative.toAdd.injective
  exact ((burnsideKD_mem_radical_iff γ').mp hγ').1 _ hwp

private theorem burnsideKD_isQuadratic_of_map {V W : Type*} [CommGroup V] [CommGroup W] (e : V ≃* W)
    {X : Subgroup (MulAut V)}
    (h : CFSG.Quasithin.IsQuadratic (X.map (CFSG.Quasithin.H.congrHom e))) :
    CFSG.Quasithin.IsQuadratic X := by
  unfold CFSG.Quasithin.IsQuadratic CFSG.Quasithin.commV at *
  rw [Subgroup.closure_le]
  rintro _ ⟨x, hx, v, rfl⟩ y hy
  have h1 : CFSG.Quasithin.H.congrHom e x (e v) * (e v)⁻¹ ∈
      Subgroup.closure {w | ∃ x ∈ X.map (CFSG.Quasithin.H.congrHom e), ∃ v : W, x v * v⁻¹ = w} :=
    Subgroup.subset_closure ⟨CFSG.Quasithin.H.congrHom e x, ⟨x, hx, rfl⟩, e v, rfl⟩
  have h2 := h h1 (CFSG.Quasithin.H.congrHom e y) ⟨y, hy, rfl⟩
  apply e.injective
  simpa [CFSG.Quasithin.H.congrHom_apply] using h2

open CFSG.Quasithin CFSG.Quasithin.H CFSG.Quasithin.B42Sp4 CFSG.Assembly.LowTwoRank in
private theorem burnsideKD_marked_props {V : Type} [CommGroup V] [Finite V] (hV : ∀ v : V, v ^
    2 = 1)
    {L : Subgroup (MulAut V)} {K : Type} [Field K] [Finite K] [CharP K 2] {r : ℕ}
    (hK : Nat.card K = 2 ^ r) {π' : ↥(StatedSp 2 K) →* ↥L}
    (e' : V ≃* StdMod (Fin 2 ⊕ Fin 2) K)
    (he' : ∀ (γ : ↥(StatedSp 2 K)) (v : V),
      e' (((π' γ : ↥L) : MulAut V) v) = natAct (StatedSp 2 K) γ (e' v))
    {X : Subgroup (MulAut V)}
    (hX : X = CFSG.ASVolI.ChIJK.markedPlaneImage L (StatedSp 2 K) π' (planeK K)) :
    X ≠ ⊥ ∧ IsElemAbelian2 X ∧ IsQuadratic X ∧ rk ↥X = 3 * r ∧ rk ↥(fixV X) = 2 * r ∧
      rAV X = 2 / 3 := by
  have hγ : ∀ γ : ↥(StatedSp 2 K), congrHom e' ((π' γ : ↥L) : MulAut V) =
      natAut (StatedSp 2 K) γ := fun γ => by
    ext x
    rw [congrHom_apply, he', MulEquiv.apply_symm_apply]
    rfl
  have hXm : X.map (congrHom e') = radImage K := by
    rw [hX, CFSG.ASVolI.ChIJK.markedPlaneImage, burnsideKD_planeUnipotent_eq_radical,
      Subgroup.map_map, Subgroup.map_map]
    have : ((congrHom e').comp L.subtype).comp π' = natAut (StatedSp 2 K) := MonoidHom.ext hγ
    rw [this]
  have hne : X ≠ ⊥ := fun h => radImage_ne_bot (K := K) (by rw [← hXm, h, Subgroup.map_bot])
  have hea : IsElemAbelian2 X :=
    (isElemAbelian2_map_congrHom e').1 (hXm ▸ isElemAbelian2_radImage)
  have hq : IsQuadratic X :=
    burnsideKD_isQuadratic_of_map e' (hXm ▸ burnsideKD_isQuadratic_radImage)
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hcard : Nat.card X = 2 ^ (3 * r) := by
    rw [← card_map_congrHom e' X, hXm, card_radImage, hK, ← pow_mul, mul_comm]
  have hrk : rk ↥X = 3 * r := by
    rw [rk, hcard]
    exact padicValNat.prime_pow _
  have hfixcard : Nat.card (fixV X) = 2 ^ (2 * r) := by
    have h1 := card_fixV_radImage (K := K)
    rw [← hXm, fixV_map_congrHom, Subgroup.card_map_of_injective e'.injective] at h1
    rw [h1, hK, ← pow_mul, mul_comm]
  have hrkfix : rk ↥(fixV X) = 2 * r := by
    rw [rk, hfixcard]
    exact padicValNat.prime_pow _
  have hVcard : Nat.card V = 2 ^ (4 * r) := by
    rw [Nat.card_congr e'.toEquiv, card_stdMod, hK, ← pow_mul]
    simp [mul_comm]
  have hrkV : rk V = 4 * r := by
    have h1 := card_eq_two_pow_rk hV
    rw [hVcard] at h1
    exact (Nat.pow_right_injective (le_refl 2) h1).symm
  have hidx : rkIdx (fixV X) = 2 * r := by
    have := rk_add_rkIdx (fixV X)
    omega
  have hr0 : r ≠ 0 := by
    rintro rfl
    have := Finite.one_lt_card_iff_nontrivial.mpr (inferInstance : Nontrivial K)
    rw [hK] at this
    simp at this
  refine ⟨hne, hea, hq, hrk, hrkfix, ?_⟩
  rw [rAV, hrk, hidx]
  have : (r : ℚ) ≠ 0 := by exact_mod_cast hr0
  push_cast
  field_simp

open CFSG.Quasithin CFSG.Quasithin.H CFSG.Quasithin.B42Sp4 CFSG.Assembly.LowTwoRank in
open CFSG.LocalAnalysis.ComponentInitial.SymplecticFour (radical) in
private theorem burnsideKD_marked_clause {V : Type} [CommGroup V] [Finite V] (hV : ∀ v : V, v ^
    2 = 1)
    {G L T : Subgroup (MulAut V)} (hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)))
    (hLG : L ≤ G) (hT : CFSG.QuasithinUnique.IsSylowTwoOf T G)
    {K : Type} [Field K] [Finite K] [CharP K 2] {r : ℕ} (hK : Nat.card K = 2 ^ r)
    {π : ↥(StatedSp 2 K) →* ↥L} (hπ : (FFModel.nat (StatedSp 2 K)).RealizesVia L ⊤ ⊥ π) :
    ∃ (π' : ↥(StatedSp 2 K) →* ↥L) (W : Submodule K ((Fin 2 ⊕ Fin 2) → K))
      (X : Subgroup (MulAut V)),
      (FFModel.nat (StatedSp 2 K)).RealizesVia L ⊤ ⊥ π' ∧
      CFSG.ASVolI.ChIJK.TrivialOnDynkinVia G L (StatedSp 2 K) π' ∧
      CFSG.ASVolI.ChIJK.IsSp4IsotropicPlane W ∧
      X = CFSG.ASVolI.ChIJK.markedPlaneImage L (StatedSp 2 K) π' W ∧ IsA2 T X ∧ IsQuadratic X ∧
      rk ↥X = 3 * r ∧ rk ↥(fixV X) = 2 * r ∧ rAV X = 2 / 3 := by
  classical
  obtain ⟨e, he⟩ := exists_mulEquiv_of_realizesVia (StatedSp 2 K) hπ
  have hγ : ∀ γ : ↥(StatedSp 2 K), congrHom e ((π γ : ↥L) : MulAut V) =
      natAut (StatedSp 2 K) γ := fun γ => by
    ext x
    rw [congrHom_apply, he, MulEquiv.apply_symm_apply]
    rfl
  set Rv : Subgroup (MulAut V) := (radical K).map (L.subtype.comp π) with hRv
  have hRvm : Rv.map (congrHom e) = radImage K := by
    rw [hRv, Subgroup.map_map]
    have : (congrHom e).comp (L.subtype.comp π) = natAut (StatedSp 2 K) := MonoidHom.ext hγ
    rw [this]
  have hRvea : IsElemAbelian2 Rv :=
    (isElemAbelian2_map_congrHom e).1 (hRvm ▸ isElemAbelian2_radImage)
  have hRvG : Rv ≤ G := by
    rintro _ ⟨γ, -, rfl⟩
    exact hLG (π γ).2
  obtain ⟨x, hxG, hx⟩ := burnsideKD_exists_conj_le_sylow hT hRvG hRvea.isPGroup
  have hxN : ∀ l : ↥L, x * (l : MulAut V) * x⁻¹ ∈ L := fun l =>
    (Subgroup.mem_normalizer_iff.mp (hGN hxG) _).mp l.2
  let π' : ↥(StatedSp 2 K) →* ↥L :=
    { toFun := fun γ => ⟨x * ((π γ : ↥L) : MulAut V) * x⁻¹, hxN _⟩
      map_one' := by
        apply Subtype.ext
        simp
      map_mul' := fun a b => by
        apply Subtype.ext
        simp only [map_mul, Subgroup.coe_mul]
        group }
  have hπ'c : ∀ γ, ((π' γ : ↥L) : MulAut V) = x * ((π γ : ↥L) : MulAut V) * x⁻¹ := fun γ => rfl
  let e' : V ≃* StdMod (Fin 2 ⊕ Fin 2) K := (x⁻¹ : MulAut V).trans e
  have he' : ∀ (γ : ↥(StatedSp 2 K)) (v : V),
      e' (((π' γ : ↥L) : MulAut V) v) = natAct (StatedSp 2 K) γ (e' v) := by
    intro γ v
    have h1 : (x⁻¹ : MulAut V) (((π' γ : ↥L) : MulAut V) v) =
        ((π γ : ↥L) : MulAut V) ((x⁻¹ : MulAut V) v) := by
      rw [hπ'c]
      simp [MulAut.mul_apply]
    show e ((x⁻¹ : MulAut V) (((π' γ : ↥L) : MulAut V) v)) = natAct (StatedSp 2 K) γ
      (e ((x⁻¹ : MulAut V) v))
    rw [h1, he]
  have hπsurj : Function.Surjective π := hπ.1
  have hπ's : Function.Surjective π' := by
    intro l
    obtain ⟨γ, hγl⟩ := hπsurj ⟨x⁻¹ * (l : MulAut V) * x, by
      have := (Subgroup.mem_normalizer_iff.mp (hGN (inv_mem hxG)) _).mp l.2
      simpa using this⟩
    refine ⟨γ, Subtype.ext ?_⟩
    rw [hπ'c, hγl]
    simp [mul_assoc]
  have hπ'rv : (FFModel.nat (StatedSp 2 K)).RealizesVia L ⊤ ⊥ π' := by
    refine CFSG.Quasithin.G64.realizesVia_nat_of hπ's le_top (fun _ _ _ => trivial)
      (fun h z hz => ?_) (e'.toMonoidHom.comp (⊤ : Subgroup V).subtype) ?_ ?_ ?_
    · rw [Subgroup.mem_bot] at hz ⊢
      rw [hz, map_one]
    · intro y
      exact ⟨⟨e'.symm y, trivial⟩, by simp⟩
    · intro u
      rw [Subgroup.mem_bot]
      constructor
      · intro h1
        have : e' (u : V) = 1 := h1
        simpa using e'.injective (this.trans (map_one e').symm)
      · intro h1
        have : (u : V) = 1 := h1
        show e' (u : V) = 1
        rw [this, map_one]
    · intro γ u hu
      exact he' γ u
  have hiso : CFSG.ASVolI.ChIJK.IsSp4IsotropicPlane (planeK K) := by
    refine ⟨?_, fun v hv w hw => ?_⟩
    · have h1 := card_planeK (K := K)
      have h2 : Nat.card ↥(planeK K) = Nat.card K ^ Module.finrank K ↥(planeK K) :=
        Module.natCard_eq_pow_finrank
      have h3 : 1 < Nat.card K := Finite.one_lt_card_iff_nontrivial.mpr inferInstance
      exact Nat.pow_right_injective h3 (h2.symm.trans h1)
    · have hv' : ∀ j, v (Sum.inr j) = 0 := hv
      have hw' : ∀ j, w (Sum.inr j) = 0 := hw
      simp [hv', hw']
  obtain ⟨hne, hea, hq, hrk, hrkfix, hrAV⟩ := burnsideKD_marked_props hV hK e' he'
    (X := CFSG.ASVolI.ChIJK.markedPlaneImage L (StatedSp 2 K) π' (planeK K)) rfl
  refine ⟨π', planeK K, _, hπ'rv, burnsideKD_trivialOnDynkinVia hGN hπ'rv, hiso, rfl,
    ⟨?_, hne, hea⟩, hq, hrk, hrkfix, hrAV⟩
  rw [CFSG.ASVolI.ChIJK.markedPlaneImage, burnsideKD_planeUnipotent_eq_radical]
  rintro _ ⟨_, ⟨γ, hγr, rfl⟩, rfl⟩
  show ((π' γ : ↥L) : MulAut V) ∈ T
  rw [hπ'c]
  exact hx _ ⟨γ, hγr, rfl⟩


private theorem burnsideKD_omegaOne_map {G H : Type} [Group G] [Group H] (f : G →* H)
    (hf : Function.Injective f) (P : Subgroup G) :
    CFSG.ASVolI.ChIJK.omegaOne (P.map f) = (CFSG.ASVolI.ChIJK.omegaOne P).map f := by
  unfold CFSG.ASVolI.ChIJK.omegaOne
  rw [MonoidHom.map_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨⟨x, hx, rfl⟩, hy⟩
    refine ⟨x, ⟨hx, hf ?_⟩, rfl⟩
    rw [map_pow, map_one]
    exact hy
  · rintro ⟨x, ⟨hx, hx2⟩, rfl⟩
    refine ⟨⟨x, hx, rfl⟩, ?_⟩
    rw [← map_pow, hx2, map_one]

private theorem burnsideKD_isSylowIn_map {G H : Type} [Group G] [Group H] (f : G →* H)
    (hf : Function.Injective f) {P X : Subgroup G} (h : CFSG.Quasithin.IsSylowIn 2 P X) :
    CFSG.Quasithin.IsSylowIn 2 (P.map f) (X.map f) :=
  ⟨Subgroup.map_mono h.1, h.2.1.map f, by
    rw [Subgroup.relIndex_map_map_of_injective _ _ hf]
    exact h.2.2⟩

open CFSG.Quasithin CFSG.Quasithin.B45U3 CFSG.Quasithin.H CFSG.Quasithin.H.SU3 in
private theorem burnsideKD_card_rootImage {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ}
    (hn : 1 ≤ n) (hK : Nat.card K = (2 ^ n) ^ 2) : Nat.card ↥(rootImage K n) = 2 ^ n := by
  rw [rootImage, Subgroup.card_map_of_injective (natAut_injective _)]
  refine Eq.trans (Nat.card_congr (Equiv.symm (Equiv.ofBijective
    (fun c : {b : K // bar n b = b} =>
      (⟨rootSU c.1 (by rw [← bar_apply]; exact c.2),
        ⟨c.1, by rw [← bar_apply]; exact c.2, coe_rootSU _ _⟩⟩ : ↥(rootSub K n))) ⟨?_, ?_⟩)))
    (card_fixed hn hK)
  · intro c d h
    have h1 := congrArg (fun g : ↥(rootSub K n) =>
      ((g.1 : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) 0 1) h
    simp only [coe_rootSU, rootMat] at h1
    apply Subtype.ext
    simpa using h1
  · rintro ⟨g, c, hc, hg⟩
    refine ⟨⟨c, by rw [bar_apply]; exact hc⟩, Subtype.ext (Subtype.ext (Units.ext ?_))⟩
    rw [coe_rootSU]
    exact hg.symm

open CFSG.Quasithin CFSG.Quasithin.B45U3 CFSG.Quasithin.H CFSG.Quasithin.H.SU3 in
open scoped Matrix in
private theorem burnsideKD_witt_conj {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ} (c : K) :
    (wittMat : Matrix (Fin 3) (Fin 3) K) * uJMat n 0 c * wittInv = rootMat c := by
  have h2 : (2 : K) = 0 := CharTwo.two_eq_zero
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [wittMat, wittInv, uJMat, rootMat, Matrix.mul_apply, Fin.sum_univ_three] <;>
    first | ring1 | linear_combination h2

open CFSG.Quasithin CFSG.Quasithin.B45U3 CFSG.Quasithin.H CFSG.Quasithin.H.SU3 in
open scoped Matrix in
private theorem burnsideKD_ujSub_form {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ}
    (hK : Nat.card K = (2 ^ n) ^ 2) {g : GL (Fin 3) K} (hg : g ∈ ujSub n K) :
    ∃ a b : K, (g : Matrix (Fin 3) (Fin 3) K) = uJMat n a b ∧ traceHom n b = a * bar n a := by
  have h2 : (2 : K) = 0 := CharTwo.two_eq_zero
  obtain ⟨⟨y, hy, hyg⟩, hu⟩ := hg
  obtain ⟨hlow, hdiag⟩ := Tri.uni3_entries hu
  have hyM : (y : Matrix (Fin 3) (Fin 3) K) =
      wittMat * (g : Matrix (Fin 3) (Fin 3) K) * wittInv := by
    have : y = wittGL * g * wittGL⁻¹ := by
      rw [← hyg]
      change y = wittGL * (wittGL⁻¹ * y * wittGL⁻¹⁻¹) * wittGL⁻¹
      group
    rw [this, Units.val_mul, Units.val_mul, coe_wittGL, coe_wittGL_inv]
  have hJ : IsUnitaryJ n (g : Matrix (Fin 3) (Fin 3) K) := by
    apply (isUnitaryM_conj_iff (n := n) _).mp
    rw [← hyM]
    exact isUnitaryM_of_mem hK hy
  set A := (g : Matrix (Fin 3) (Fin 3) K) with hA
  have hAexp : A = !![1, A 0 1, A 0 2; 0, 1, A 1 2; 0, 0, 1] := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      first | rfl | exact hdiag _ | exact hlow _ _ (by decide)
  unfold IsUnitaryJ at hJ
  rw [hAexp] at hJ
  have e12 := congrFun (congrFun hJ 1) 2
  have e21 := congrFun (congrFun hJ 2) 1
  have e22 := congrFun (congrFun hJ 2) 2
  simp [conjM, antiJ, Matrix.mul_apply, Fin.sum_univ_three] at e12 e21 e22
  have hz : A 1 2 = bar n (A 0 1) := by
    rwa [CharTwo.add_eq_zero] at e12
  refine ⟨A 0 1, A 0 2, ?_, ?_⟩
  · ext i j
    fin_cases i <;> fin_cases j <;> simp [uJMat] <;>
      first | exact hdiag _ | exact hlow _ _ (by decide) | exact hz
  · rw [traceHom_apply]
    rw [hz, bar_bar hK] at e22
    linear_combination e22 + (-(A 0 1 * bar n (A 0 1))) * h2

open CFSG.Quasithin CFSG.Quasithin.B45U3 CFSG.Quasithin.H CFSG.Quasithin.H.SU3 in
open scoped Matrix in
private theorem burnsideKD_conj_val {K : Type} [Field K] [CharP K 2] (g : GL (Fin 3) K) :
    ((((MulAut.conj (wittGL : GL (Fin 3) K)).toMonoidHom g : GL (Fin 3) K)) :
      Matrix (Fin 3) (Fin 3) K) = wittMat * (g : Matrix (Fin 3) (Fin 3) K) * wittInv := by
  change ((wittGL * g * wittGL⁻¹ : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) = _
  rw [Units.val_mul, Units.val_mul, coe_wittGL, coe_wittGL_inv]

open CFSG.Quasithin CFSG.Quasithin.B45U3 CFSG.Quasithin.H CFSG.Quasithin.H.SU3 in
open scoped Matrix in
private theorem burnsideKD_omegaOne_uiSub {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ}
    (hK : Nat.card K = (2 ^ n) ^ 2) :
    CFSG.ASVolI.ChIJK.omegaOne ((uiSub n K).map matHom) = rootImage K n := by
  have h2 : (2 : K) = 0 := CharTwo.two_eq_zero
  apply le_antisymm
  · unfold CFSG.ASVolI.ChIJK.omegaOne
    rw [Subgroup.closure_le]
    rintro _ ⟨⟨_, ⟨g, hg, rfl⟩, rfl⟩, hx2⟩
    obtain ⟨a, b, hgM, hab⟩ := burnsideKD_ujSub_form hK hg
    have hg2 : g ^ 2 = 1 := by
      have h1 : matHom ((MulAut.conj (wittGL : GL (Fin 3) K)).toMonoidHom g ^ 2) = 1 := by
        rw [map_pow]
        exact hx2
      have h3 : (MulAut.conj (wittGL : GL (Fin 3) K)).toMonoidHom g ^ 2 = 1 :=
        matHom_injective (h1.trans (map_one matHom).symm)
      apply (MulAut.conj (wittGL : GL (Fin 3) K)).injective
      rw [map_pow, map_one]
      exact h3
    have hM : (uJMat n a b : Matrix (Fin 3) (Fin 3) K) * uJMat n a b = 1 := by
      have := congrArg (fun z : GL (Fin 3) K => (z : Matrix (Fin 3) (Fin 3) K)) hg2
      simpa [pow_two, Units.val_mul, hgM] using this
    have ha : a = 0 := by
      have e02 := congrFun (congrFun hM 0) 2
      simp [uJMat, Matrix.mul_apply, Fin.sum_univ_three] at e02
      have : a * bar n a = 0 := by linear_combination e02 + (-b) * h2
      rcases mul_eq_zero.mp this with h | h
      · exact h
      · simpa using h
    have hb : bar n b = b := by
      rw [ha, map_zero, mul_zero] at hab
      exact traceHom_eq_zero_iff.mp hab
    refine mem_rootImage_iff.mpr ⟨b, by rw [← bar_apply]; exact hb, fun v => ?_⟩
    rw [matHom_apply, toAddMap_matAut, burnsideKD_conj_val, hgM, ha,
      burnsideKD_witt_conj (n := n) b]
  · intro x hx
    obtain ⟨γ, ⟨c, hc, hγ⟩, rfl⟩ := hx
    have hcb : bar n c = c := by rw [bar_apply]; exact hc
    refine Subgroup.subset_closure ⟨?_, ?_⟩
    · refine ⟨(γ : GL (Fin 3) K), ⟨uJGL n 0 c, uJGL_mem_ujSub hK (by
        rw [traceHom_eq_zero_iff.mpr hcb, map_zero, zero_mul]), ?_⟩, rfl⟩
      apply Units.ext
      rw [burnsideKD_conj_val, coe_uJGL, burnsideKD_witt_conj (n := n) c, hγ]
    · exact isElemAbelian2_rootImage.2 _ ⟨γ, ⟨c, hc, hγ⟩, rfl⟩

open CFSG.Quasithin CFSG.Quasithin.B45U3 CFSG.Quasithin.H CFSG.Quasithin.H.SU3 in
open scoped Matrix in
private theorem burnsideKD_omegaOne_sylow {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ}
    (hn : 1 ≤ n) (hK : Nat.card K = (2 ^ n) ^ 2)
    {Gh Th : Subgroup (MulAut (StdMod (Fin 3) K))}
    (hLG : natImage (StatedSU 3 (2 ^ n) K) ≤ Gh) (hGN : Gh ≤ natNorm (StatedSU 3 (2 ^ n) K))
    (hT : IsSylowIn 2 Th Gh) :
    ∃ x : MulAut (StdMod (Fin 3) K), x ∈ natImage (StatedSU 3 (2 ^ n) K) ∧
      CFSG.ASVolI.ChIJK.omegaOne (Th ⊓ natImage (StatedSU 3 (2 ^ n) K)) =
        (rootImage K n).map (congrHom x) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Finite (MulAut (StdMod (Fin 3) K)) := MulEquiv.finite_left
  have hN : ((natImage (StatedSU 3 (2 ^ n) K)).subgroupOf Gh).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hLG).mpr hGN
  have hTN : IsSylowIn 2 (Th ⊓ natImage (StatedSU 3 (2 ^ n) K))
      (natImage (StatedSU 3 (2 ^ n) K)) := hT.inf_normal hLG hN
  have hS₀ : IsSylowIn 2 ((uiSub n K).map matHom) (natImage (StatedSU 3 (2 ^ n) K)) := by
    have h1 := burnsideKD_isSylowIn_map matHom matHom_injective (isSylowIn_uiSub hn hK)
    rw [natImage_eq_map]
    exact h1
  obtain ⟨x, hxN, hx⟩ := burnsideKD_exists_conj_le_sylow (G := natImage (StatedSU 3 (2 ^ n) K))
    hTN hS₀.le hS₀.isPGroup
  have hle : ((uiSub n K).map matHom).map (congrHom x) ≤
      Th ⊓ natImage (StatedSU 3 (2 ^ n) K) := by
    rintro _ ⟨r, hr, rfl⟩
    exact hx r hr
  have hcard : Nat.card ↥(Th ⊓ natImage (StatedSU 3 (2 ^ n) K)) ≤
      Nat.card ↥(((uiSub n K).map matHom).map (congrHom x)) := by
    rw [hTN.card_eq, card_map_congrHom, hS₀.card_eq]
  have heq := Subgroup.eq_of_le_of_card_ge hle hcard
  refine ⟨x, hxN, ?_⟩
  rw [← heq, burnsideKD_omegaOne_map _ (congrHom_injective x), burnsideKD_omegaOne_uiSub hK]

private theorem burnsideKD_isQuadratic_map {V W : Type*} [CommGroup V] [CommGroup W] (e : V ≃* W)
    {X : Subgroup (MulAut V)} (h : CFSG.Quasithin.IsQuadratic X) :
    CFSG.Quasithin.IsQuadratic (X.map (CFSG.Quasithin.H.congrHom e)) := by
  unfold CFSG.Quasithin.IsQuadratic CFSG.Quasithin.commV at *
  rw [Subgroup.closure_le]
  rintro _ ⟨_, ⟨x, hx, rfl⟩, w, rfl⟩ y hy
  obtain ⟨y, hyX, rfl⟩ := hy
  have h1 : x (e.symm w) * (e.symm w)⁻¹ ∈
      Subgroup.closure {w | ∃ x ∈ X, ∃ v : V, x v * v⁻¹ = w} :=
    Subgroup.subset_closure ⟨x, hx, e.symm w, rfl⟩
  have h2 := h h1 y hyX
  apply e.symm.injective
  simpa [CFSG.Quasithin.H.congrHom_apply] using h2

private theorem burnsideKD_rAV_map {V W : Type*} [CommGroup V] [CommGroup W] [Finite V] (e : V ≃* W)
    (A : Subgroup (MulAut V)) :
    CFSG.Quasithin.rAV (A.map (CFSG.Quasithin.H.congrHom e)) = CFSG.Quasithin.rAV A := by
  unfold CFSG.Quasithin.rAV
  rw [CFSG.Quasithin.H.rk_map_congrHom, CFSG.Quasithin.H.rkIdx_fixV_map_congrHom]

open CFSG.Quasithin CFSG.Quasithin.B45U3 CFSG.Quasithin.H CFSG.Quasithin.H.SU3 CFSG.Assembly.LowTwoRank in
open scoped Matrix in
private theorem burnsideKD_uniq {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ}
    (hn : 2 ≤ n) (hK : Nat.card K = (2 ^ n) ^ 2)
    {Th Gh Xh : Subgroup (MulAut (StdMod (Fin 3) K))}
    (hTG : Th ≤ Gh) (hGN : Gh ≤ natNorm (StatedSU 3 (2 ^ n) K))
    (hX : Xh = CFSG.ASVolI.ChIJK.omegaOne (Th ⊓ natImage (StatedSU 3 (2 ^ n) K)))
    (hXcard : Nat.card Xh = 2 ^ n)
    {A : Subgroup (MulAut (StdMod (Fin 3) K))} (hAT : A ≤ Th) (hA1 : A ≠ ⊥)
    (hAel : IsElemAbelian2 A) (hr : rkIdx (fixV A) ≤ 2 * rk ↥A) : A = Xh := by
  have : Finite (MulAut (StdMod (Fin 3) K)) := MulEquiv.finite_left
  have hK' := card_eq_two_pow hK
  have hΓ := hasScalarCommutant' (by omega : 1 ≤ n) hK
  have hAN : A ≤ natNorm (StatedSU 3 (2 ^ n) K) := hAT.trans (hTG.trans hGN)
  have heq : rkIdx (fixV A) = 2 * rk ↥A :=
    le_antisymm hr (two_mul_rk_le_rkIdx hn hK hAN hA1 hAel)
  have hmono : ∀ a ∈ A, rkIdx (fixV (Subgroup.zpowers a)) ≤ rkIdx (fixV A) := fun a ha =>
    H.rkIdx_anti (fun v hv y hy => hv y ((Subgroup.zpowers_le).mpr ha hy))
  obtain ⟨a₀, ha₀A, ha₀1⟩ : ∃ a ∈ A, a ≠ 1 := by
    by_contra h
    push Not at h
    exact hA1 ((Subgroup.eq_bot_iff_forall A).2 h)
  have hcardA : Nat.card A = 2 ^ rk ↥A :=
    card_eq_two_pow_of_isPGroup (E3.isPGroup_of_isElemAbelian2 hAel)
  by_cases hlin : A ≤ linSub
  · have hAL : A ≤ natImage (StatedSU 3 (2 ^ n) K) := fun a ha =>
      mem_natImage_of_two_pow (by omega) hK (hAN ha) (hlin ha) (j := 1)
        (by simpa using hAel.2 a ha)
    have hAX : A ≤ Xh := by
      rw [hX]
      intro a ha
      exact Subgroup.subset_closure ⟨⟨hAT ha, hAL ha⟩, hAel.2 a ha⟩
    have hrk : rk ↥A ≤ n := by
      have h1 : Nat.card A ≤ Nat.card Xh := Subgroup.card_le_of_le hAX
      rw [hcardA, hXcard] at h1
      exact (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).mp h1
    have hoa : orderOf (a₀ : MulAut (StdMod (Fin 3) K)) = 2 :=
      orderOf_eq_prime (hAel.2 a₀ ha₀A) ha₀1
    have h2n := le_rkIdx_fixV_of_involution (by omega) hK hAN ha₀A hoa
    have h3 := hmono a₀ ha₀A
    have hrkA : rk ↥A = n := by omega
    refine Subgroup.eq_of_le_of_card_ge hAX ?_
    rw [hcardA, hXcard, hrkA]
  · exfalso
    obtain ⟨a, haA, ha⟩ : ∃ a ∈ A, a ∉ linSub := by
      by_contra h
      push Not at h
      exact hlin h
    have ha2 : a ^ 2 = 1 := hAel.2 a haA
    have ha1 : a ≠ 1 := fun h => ha (h ▸ linSub.one_mem)
    have hsl := isSemilinear_fieldAut hΓ ⟨a, hAN haA⟩
    set σ := fieldAut hΓ ⟨a, hAN haA⟩ with hσdef
    have hσ : σ ≠ RingEquiv.refl K := by
      intro h
      apply ha
      have := hsl
      rw [h] at this
      exact this
    have h3 : rkIdx (fixV (Subgroup.zpowers a)) = 3 * n :=
      rkIdx_fixV_of_semilinear_involution (by omega) hK hsl hσ ha2
    have hrkA : rk ↥A ≤ n + 1 := (rk_le_pRank le_rfl hAel).trans (pRank_le (by omega) hK hAN)
    have hm := hmono a haA
    have hn2 : n = 2 := by omega
    subst hn2
    have hrk3 : rk ↥A = 3 := by omega
    have hfix : fixV (Subgroup.zpowers a) = fixV A := by
      refine (eq_of_le_of_rk_le CFSG.Quasithin.FFC.Sp4Off.sq_eq_one_stdMod ?_ ?_).symm
      · intro v hv y hy
        exact hv y ((Subgroup.zpowers_le).mpr haA hy)
      · have h1 := rk_add_rkIdx (fixV A)
        have h2 := rk_add_rkIdx (fixV (Subgroup.zpowers a))
        omega
    obtain ⟨c, hcA, hc1⟩ : ∃ c ∈ A ⊓ linSub, c ≠ 1 := by
      have h1 := card_le_two_mul_card_inf_linSub hΓ (by omega) hK' hAN hAel.2
      by_contra h
      push Not at h
      have hbot : A ⊓ linSub = ⊥ := (Subgroup.eq_bot_iff_forall _).mpr h
      rw [hbot, Subgroup.card_bot, hcardA, hrk3] at h1
      omega
    have hσ2 : σ ^ 2 = 1 := by
      have h1 : IsSemilinear (a ^ 2) (σ.trans σ) := by
        rw [pow_two]
        exact hsl.mul hsl
      rw [ha2] at h1
      have := h1.unique isSemilinear_one
      ext x
      exact congrArg (fun τ : K ≃+* K => τ x) this
    have hσo : orderOf σ = 2 := orderOf_eq_prime hσ2 hσ
    obtain ⟨b, hb⟩ := exists_basis_fixed_of_semilinear (by omega) hK' hsl hσo ha2
    apply hc1
    refine eq_one_of_linear_of_fix_basis hcA.2 b fun i => ?_
    have hbi : Multiplicative.ofAdd (b i) ∈ fixV A := by
      rw [← hfix]
      exact H.mem_fixV_zpowers_iff.mpr (congrArg Multiplicative.ofAdd (hb i))
    exact congrArg Multiplicative.toAdd (hbi c hcA.1)

open CFSG.Quasithin CFSG.Quasithin.B45U3 CFSG.Quasithin.H CFSG.Quasithin.H.SU3 in
private theorem burnsideKD_K33_T {V : Type} [CommGroup V] [Finite V] (hV : ∀ v : V, v ^ 2 = 1)
    {G L T : Subgroup (MulAut V)} (hLG : L ≤ G)
    (hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)))
    (hT : CFSG.QuasithinUnique.IsSylowTwoOf T G)
    {K : Type} [Field K] [Finite K] [CharP K 2] {s : ℕ} (hs : 2 ≤ s)
    (hK : Nat.card K = (2 ^ s) ^ 2) (e : V ≃* StdMod (Fin 3) K)
    (hLe : L.map (congrHom e) = natImage (StatedSU 3 (2 ^ s) K)) :
    rk ↥(CFSG.ASVolI.ChIJK.omegaOne (T ⊓ L)) = s ∧
      rk ↥(fixV (CFSG.ASVolI.ChIJK.omegaOne (T ⊓ L))) = 4 * s ∧
      rAV (CFSG.ASVolI.ChIJK.omegaOne (T ⊓ L)) = 2 ∧
      Qset T = {CFSG.ASVolI.ChIJK.omegaOne (T ⊓ L)} := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Finite (MulAut (StdMod (Fin 3) K)) := MulEquiv.finite_left
  set X := CFSG.ASVolI.ChIJK.omegaOne (T ⊓ L) with hXdef
  have hGe : G.map (congrHom e) ≤ natNorm (StatedSU 3 (2 ^ s) K) := by
    have h1 : (Subgroup.normalizer (L : Set (MulAut V))).map (congrHom e) =
        Subgroup.normalizer ((L.map (congrHom e) : Subgroup (MulAut (StdMod (Fin 3) K))) :
          Set (MulAut (StdMod (Fin 3) K))) :=
      Subgroup.map_equiv_normalizer_eq L (MulAut.congr e)
    rw [natNorm, ← hLe, ← h1]
    exact Subgroup.map_mono hGN
  have hLGh : natImage (StatedSU 3 (2 ^ s) K) ≤ G.map (congrHom e) :=
    hLe ▸ Subgroup.map_mono hLG
  have hTh : IsSylowIn 2 (T.map (congrHom e)) (G.map (congrHom e)) :=
    burnsideKD_isSylowIn_map _ (congrHom_injective e) hT
  obtain ⟨x, -, hx⟩ := burnsideKD_omegaOne_sylow (by omega) hK hLGh hGe hTh
  have hXh : X.map (congrHom e) = CFSG.ASVolI.ChIJK.omegaOne
      (T.map (congrHom e) ⊓ natImage (StatedSU 3 (2 ^ s) K)) := by
    rw [← hLe, ← Subgroup.map_inf _ _ _ (congrHom_injective e),
      burnsideKD_omegaOne_map _ (congrHom_injective e)]
  have hXm : X.map (congrHom e) = (rootImage K s).map (congrHom x) := hXh.trans hx
  have hcard : Nat.card ↥X = 2 ^ s := by
    rw [← card_map_congrHom e X, hXm, card_map_congrHom x, burnsideKD_card_rootImage (by omega) hK]
  have hrk : rk ↥X = s := by
    rw [rk, hcard]
    exact padicValNat.prime_pow _
  have hidx : rkIdx (fixV X) = 2 * s := by
    rw [← rkIdx_fixV_map_congrHom e X, hXm, rkIdx_fixV_map_congrHom x,
      rkIdx_fixV_rootImage hK]
  have hVcard : Nat.card V = 2 ^ (6 * s) := by
    rw [Nat.card_congr e.toEquiv, card_stdMod, hK, Fintype.card_fin]
    ring
  have hrkV : rk V = 6 * s := by
    have h1 := card_eq_two_pow_rk hV
    rw [hVcard] at h1
    exact (Nat.pow_right_injective (le_refl 2) h1).symm
  have hrkfix : rk ↥(fixV X) = 4 * s := by
    have := rk_add_rkIdx (fixV X)
    omega
  have hrAV : rAV X = 2 := by
    rw [rAV, hrk, hidx]
    have : (s : ℚ) ≠ 0 := by exact_mod_cast (by omega : s ≠ 0)
    push_cast
    field_simp
  have hea : IsElemAbelian2 X :=
    (isElemAbelian2_map_congrHom e).1 (hXm ▸ (isElemAbelian2_map_congrHom x).2
      isElemAbelian2_rootImage)
  have hquad : IsQuadratic X :=
    burnsideKD_isQuadratic_of_map e (hXm ▸ burnsideKD_isQuadratic_map x isQuadratic_rootImage)
  have hne : X ≠ ⊥ := by
    intro h
    rw [h, Subgroup.card_bot] at hcard
    have : 2 ≤ 2 ^ s := by
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ s := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  have hXT : X ≤ T := (Subgroup.closure_le T).mpr fun y hy => hy.1.1
  refine ⟨hrk, hrkfix, hrAV, Set.ext fun A => ⟨fun hA => ?_, fun hA => ?_⟩⟩
  ·
    obtain ⟨⟨hA2, hAr⟩, -⟩ := hA
    have hrkpos := hA2.rk_pos
    have hA2' := (isA2_map_congrHom e).mpr hA2
    have hr : rkIdx (fixV (A.map (congrHom e))) ≤ 2 * rk ↥(A.map (congrHom e)) := by
      have h1 : (rkIdx (fixV A) : ℚ) / (rk ↥A : ℚ) ≤ 2 := hAr
      rw [div_le_iff₀ (by exact_mod_cast hrkpos)] at h1
      rw [rkIdx_fixV_map_congrHom, rk_map_congrHom]
      exact_mod_cast h1
    have h := burnsideKD_uniq hs hK (Th := T.map (congrHom e)) (Gh := G.map (congrHom e))
      (Subgroup.map_mono (hT.1)) hGe hXh (by rw [card_map_congrHom e X]; exact hcard)
      hA2'.1 hA2'.2.1 hA2'.2.2 hr
    exact Subgroup.map_injective (congrHom_injective e) h
  · rw [Set.mem_singleton_iff] at hA
    subst hA
    exact ⟨⟨⟨hXT, hne, hea⟩, hrAV.le⟩, (isQuadratic_iff_commSeries_two _).mp hquad⟩

open CFSG.Quasithin CFSG.Quasithin.H CFSG.Quasithin.H.SU3 CFSG.Assembly.LowTwoRank in
open scoped Matrix in
private theorem burnsideKD_card_center_statedSU {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ}
    (hn : 1 ≤ n) (hK : Nat.card K = (2 ^ n) ^ 2) :
    Nat.card ↥(Subgroup.center ↥(StatedSU 3 (2 ^ n) K)) = Nat.gcd 3 (2 ^ n + 1) := by
  have hsc := (CFSG.LinearGroups.unitary_scalar_kernel Nat.prime_two hK (n := 3)
    (by norm_num)).2.2
  rw [← hsc]
  suffices hcenter : Subgroup.center ↥(StatedSU 3 (2 ^ n) K) =
      (StatedScalars (Fin 3) K).subgroupOf (StatedSU 3 (2 ^ n) K) by rw [hcenter]
  ext z
  constructor
  · intro hz
    have hz' := Subgroup.mem_center_iff.mp hz
    let f : (Fin 3 → K) →+ (Fin 3 → K) :=
      AddMonoidHom.mk' (fun v => ((z : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) *ᵥ v)
        (Matrix.mulVec_add _)
    obtain ⟨c, hc⟩ := hasScalarCommutant' hn hK f fun γ hγ v => by
      have h1 := congrArg (fun g : ↥(StatedSU 3 (2 ^ n) K) =>
        ((g : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K)) (hz' ⟨γ, hγ⟩)
      simp only [Subgroup.coe_mul, Units.val_mul] at h1
      change ((z : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) *ᵥ
        (((γ : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) *ᵥ v) =
        ((γ : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) *ᵥ
          (((z : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) *ᵥ v)
      rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, h1]
    have hzM : ((z : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) =
        Matrix.scalar (Fin 3) c := by
      ext i j
      have := congrFun (hc (Pi.single j 1)) i
      simpa [f, Matrix.mulVec, dotProduct, Pi.single_apply, Matrix.scalar_apply,
        Matrix.diagonal_apply, eq_comm] using this
    have hc0 : c ≠ 0 := by
      rintro rfl
      have : ((z : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) = 0 := by
        rw [hzM]; simp
      exact Units.ne_zero _ this
    refine ⟨Units.mk0 c hc0, Units.ext ?_⟩
    rw [Matrix.GeneralLinearGroup.coe_scalar, Units.val_mk0]
    exact hzM.symm
  · intro hz
    obtain ⟨u, hu⟩ := hz
    rw [Subgroup.mem_center_iff]
    intro g
    apply Subtype.ext
    rw [Subgroup.coe_mul, Subgroup.coe_mul]
    have hu' : ((z : GL (Fin 3) K)) = Matrix.GeneralLinearGroup.scalar (Fin 3) u := hu.symm
    rw [hu']
    exact (Matrix.GeneralLinearGroup.scalar_commute u _).symm

private theorem burnsideKD_gcd_three (s : ℕ) :
    (Even s → Nat.gcd 3 (2 ^ s + 1) = 1) ∧ (Odd s → Nat.gcd 3 (2 ^ s + 1) = 3) := by
  have h4 : ∀ k : ℕ, 4 ^ k % 3 = 1 := fun k => by
    rw [Nat.pow_mod]
    simp
  constructor
  · rintro ⟨k, rfl⟩
    have h : (2 ^ (k + k) + 1) % 3 = 2 := by
      rw [← two_mul, pow_mul]
      norm_num [Nat.add_mod, h4]
    have : ¬ 3 ∣ 2 ^ (k + k) + 1 := by omega
    exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).2 this
  · rintro ⟨k, rfl⟩
    have h : (2 ^ (2 * k + 1) + 1) % 3 = 0 := by
      rw [pow_succ, pow_mul]
      norm_num [Nat.add_mod, Nat.mul_mod, h4]
    exact Nat.gcd_eq_left (Nat.dvd_of_mod_eq_zero h)

end BurnsideKD

