private theorem burnsideKC_card_two_subgroup_le {V : Type} [CommGroup V] [Finite V]
    {L : Subgroup (MulAut V)} {F : Type} [Field F] [Finite F] {f : ℕ} (hF : Nat.card F = 2 ^ f)
    (π₀ : SL(3, F) →* ↥L) (hsurj : Function.Surjective π₀) {R : Subgroup (MulAut V)}
    (hRL : R ≤ L) (hR : IsPGroup 2 R) : Nat.card R ≤ Nat.card F ^ 3 := by
  have hdvd : Nat.card ↥L ∣ Nat.card SL(3, F) := Subgroup.card_dvd_of_surjective hsurj
  have hcard : Nat.card SL(3, F) =
      Nat.card F ^ 3 * ((Nat.card F ^ 2 - 1) * (Nat.card F ^ 3 - 1)) :=
    (card_statedSL 3 F).symm.trans (card_statedSL_three F)
  obtain ⟨a, ha⟩ := IsPGroup.iff_card.mp hR
  have hRd : Nat.card R ∣ Nat.card ↥L := Subgroup.card_dvd_of_le hRL
  have hq2 : 2 ≤ Nat.card F := Finite.one_lt_card
  have hf1 : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with h0 | h0
    · rw [h0] at hF; omega
    · exact h0
  have heven : Even (Nat.card F) := by
    rw [hF]
    exact (Nat.even_pow.mpr ⟨even_two, by omega⟩)
  have hodd : Odd ((Nat.card F ^ 2 - 1) * (Nat.card F ^ 3 - 1)) := by
    refine Odd.mul ?_ ?_
    · obtain ⟨k, hk⟩ := heven
      have h2 : Nat.card F ^ 2 = 2 * (2 * k ^ 2) := by rw [hk]; ring
      have hk1 : 1 ≤ k := by omega
      have : 1 ≤ k ^ 2 := Nat.one_le_pow _ _ (by omega)
      exact Nat.odd_iff.mpr (by omega)
    · obtain ⟨k, hk⟩ := heven
      have h2 : Nat.card F ^ 3 = 2 * (4 * k ^ 3) := by rw [hk]; ring
      have hk1 : 1 ≤ k := by omega
      have : 1 ≤ k ^ 3 := Nat.one_le_pow _ _ (by omega)
      exact Nat.odd_iff.mpr (by omega)
  have hdvd' : 2 ^ a ∣ Nat.card F ^ 3 * ((Nat.card F ^ 2 - 1) * (Nat.card F ^ 3 - 1)) := by
    rw [← hcard, ← ha]
    exact hRd.trans hdvd
  have hcop : Nat.Coprime (2 ^ a) ((Nat.card F ^ 2 - 1) * (Nat.card F ^ 3 - 1)) :=
    Nat.Coprime.pow_left _ (Nat.coprime_two_left.mpr hodd)
  have h3 : 2 ^ a ∣ Nat.card F ^ 3 := hcop.dvd_of_dvd_mul_right hdvd'
  rw [ha]
  exact Nat.le_of_dvd (by positivity) h3

