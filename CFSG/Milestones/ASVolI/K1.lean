private theorem burnsideKD_trivialOnDynkinVia {V : Type} [CommGroup V] [Finite V]
    {G L : Subgroup (MulAut V)} (hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)))
    {K : Type} [Field K] [Finite K] [CharP K 2] {π : ↥(StatedSp 2 K) →* ↥L}
    (hπ : (FFModel.nat (StatedSp 2 K)).RealizesVia L ⊤ ⊥ π) :
    CFSG.ASVolI.ChIJK.TrivialOnDynkinVia G L (StatedSp 2 K) π := by
  obtain ⟨e, he⟩ := exists_mulEquiv_of_realizesVia (StatedSp 2 K) hπ
  have hγ : ∀ γ : ↥(StatedSp 2 K), congrHom e ((π γ : ↥L) : MulAut V) =
      natAut (StatedSp 2 K) γ := fun γ => by
    ext x
    rw [congrHom_apply, he, MulEquiv.apply_symm_apply]
    rfl
  have hLe := map_congrHom_eq_natImage (StatedSp 2 K) hπ.1 e he
  refine ⟨hπ.1, fun g hg => ?_⟩
  have hĝ : congrHom e g ∈ natNorm (StatedSp 2 K) := by
    have h1 : (Subgroup.normalizer (L : Set (MulAut V))).map (congrHom e) =
        Subgroup.normalizer ((L.map (congrHom e) : Subgroup (MulAut (StdMod (Fin 2 ⊕ Fin 2) K))) :
          Set (MulAut (StdMod (Fin 2 ⊕ Fin 2) K))) :=
      Subgroup.map_equiv_normalizer_eq L (MulAut.congr e)
    rw [natNorm, ← hLe, ← h1]
    exact ⟨g, hGN hg, rfl⟩
  obtain ⟨B, σ, D, hB, -⟩ := exists_eq_of_mem_natNorm hĝ
  refine ⟨(B : GL (Fin 2 ⊕ Fin 2) K), σ, fun x => ⟨conjHom (StatedSp 2 K) ⟨congrHom e g, hĝ⟩ x,
    ?_, ?_⟩⟩
  · rw [hB x, Subgroup.coe_mul, Subgroup.coe_mul, Units.val_mul, Units.val_mul, coe_fieldSp,
      Subgroup.coe_inv]
  · apply congrHom_injective e
    rw [hγ, natAut_conjHom]
    simp only [map_mul, map_inv, hγ]

open scoped Matrix in
private theorem burnsideKD_fromBlocks_one_mulVec {K : Type} [Field K] (C : Matrix (Fin 2) (Fin 2) K)
    (v : Fin 2 ⊕ Fin 2 → K) (i : Fin 2) :
    (Matrix.fromBlocks (1 : Matrix (Fin 2) (Fin 2) K) C (0 : Matrix (Fin 2) (Fin 2) K)
        (1 : Matrix (Fin 2) (Fin 2) K) *ᵥ v) (Sum.inl i) =
      v (Sum.inl i) + ∑ j, C i j * v (Sum.inr j) ∧
    (Matrix.fromBlocks (1 : Matrix (Fin 2) (Fin 2) K) C (0 : Matrix (Fin 2) (Fin 2) K)
        (1 : Matrix (Fin 2) (Fin 2) K) *ᵥ v) (Sum.inr i) = v (Sum.inr i) := by
  constructor <;>
  simp [Matrix.mulVec, dotProduct, Fintype.sum_sum_type, Matrix.one_apply]

