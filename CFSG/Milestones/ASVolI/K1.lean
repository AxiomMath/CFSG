    exact ⟨x, ⟨hx, hf (by rw [map_pow, hy2, map_one])⟩, rfl⟩
  · rintro ⟨x, ⟨hx, hx2⟩, rfl⟩
    exact ⟨⟨x, hx, rfl⟩, by rw [← map_pow, hx2, map_one]⟩

open CFSG.ASVolI.ChIJK in
private theorem burnsideKE_omegaOne_eq {G : Type} [Group G] (P : Subgroup G) :
    ChIJK.omegaOne P = Subgroup.closure {x | x ∈ P ∧ orderOf x = 2} := by
  unfold ChIJK.omegaOne
