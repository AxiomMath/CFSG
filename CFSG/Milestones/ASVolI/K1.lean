open CFSG.Quasithin CFSG.Quasithin.H Matrix in
private theorem burnsideKC_trivialOnDynkin_natural {V : Type} [CommGroup V] [Finite V]
    {G L : Subgroup (MulAut V)} (hLG : L ≤ G)
    (hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V))) {n : ℕ} (hn : 2 ≤ n) {K : Type}
    [Field K] [Finite K] {π : ↥(StatedSL n K) →* ↥L}
    (hπ : (FFModel.nat (StatedSL n K)).RealizesVia L ⊤ ⊥ π) :
    ChIJK.TrivialOnDynkin G L (StatedSL n K) := by
  classical
  obtain ⟨e, he⟩ := exists_mulEquiv_of_realizesVia (StatedSL n K) hπ
  have hLe := map_congrHom_eq_natImage (StatedSL n K) hπ.1 e he
  have hΓ : HasScalarCommutant (StatedSL n K) := hasScalarCommutant_statedSL hn
  have hcπ : ∀ γ : ↥(StatedSL n K),
      congrHom e ((π γ : ↥L) : MulAut V) = natAut (StatedSL n K) γ := fun γ => by
    ext x
    rw [congrHom_apply, he, MulEquiv.apply_symm_apply]
    rfl
  refine ⟨π, hπ.1, fun g hg => ?_⟩
  have hĝ : congrHom e g ∈ natNorm (StatedSL n K) := by
    have h1 : (Subgroup.normalizer (L : Set (MulAut V))).map (congrHom e) =
        Subgroup.normalizer ((L.map (congrHom e) : Subgroup (MulAut (StdMod (Fin n) K))) :
          Set (MulAut (StdMod (Fin n) K))) :=
      Subgroup.map_equiv_normalizer_eq L (MulAut.congr e)
    rw [natNorm, ← hLe, ← h1]
    exact ⟨g, hGN hg, rfl⟩
  haveI : Nonempty (Fin n) := ⟨⟨0, by omega⟩⟩
  obtain ⟨σ, hσ⟩ := exists_semilinear hΓ hĝ
  obtain ⟨A, hA⟩ := burnsideKC_exists_matrix_of_semilinear hσ
  refine ⟨A, σ, fun x => ?_⟩
  obtain ⟨xσ, hxσ⟩ : ∃ xσ : GL (Fin n) K, xσ = Units.map
      (σ.toRingHom.mapMatrix : Matrix (Fin n) (Fin n) K →+* Matrix (Fin n) (Fin n) K).toMonoidHom
      (x : GL (Fin n) K) := ⟨_, rfl⟩
  have hxσmat : (xσ : Matrix (Fin n) (Fin n) K) =
      ((x : GL (Fin n) K) : Matrix (Fin n) (Fin n) K).map σ := by
    rw [hxσ]
    simp only [Units.coe_map, MonoidHom.coe_coe, RingEquiv.toRingHom_eq_coe]
    rfl
  have hdet : (A * xσ * A⁻¹ : GL (Fin n) K) ∈ StatedSL n K := by
    rw [CFSG.Open.StatedAPI.mem_statedSL_iff]
    have hx1 : ((x : GL (Fin n) K) : Matrix (Fin n) (Fin n) K).det = 1 :=
      CFSG.Open.StatedAPI.mem_statedSL_iff.1 x.2
    have h1 : (xσ : Matrix (Fin n) (Fin n) K).det = 1 := by
      rw [hxσmat]
      have := RingHom.map_det σ.toRingHom ((x : GL (Fin n) K) : Matrix (Fin n) (Fin n) K)
      rw [hx1, map_one] at this
      exact this.symm
    have h2 : ((A : GL (Fin n) K) : Matrix (Fin n) (Fin n) K).det *
        ((A⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K).det = 1 := by
      rw [← Matrix.det_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.det_one]
    rw [Units.val_mul, Units.val_mul, Matrix.det_mul, Matrix.det_mul, h1, mul_one, h2]
  refine ⟨⟨A * xσ * A⁻¹, hdet⟩, ?_, ?_⟩
  · show ((A * xσ * A⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) = _
    rw [Units.val_mul, Units.val_mul, hxσmat]
  · apply congrHom_injective e
    rw [map_mul, map_mul, map_inv, hcπ, hcπ, hA]
    symm
    have h3 := burnsideKC_fieldAutom_conj (ι := Fin n) σ (x : GL (Fin n) K)
    rw [← hxσ] at h3
    have h4 : natAut (StatedSL n K) x = matAut (x : GL (Fin n) K) := rfl
    have h5 : natAut (StatedSL n K) ⟨A * xσ * A⁻¹, hdet⟩ =
        matAut A * matAut xσ * (matAut A)⁻¹ := by
      show matHom (A * xσ * A⁻¹) = _
      rw [map_mul, map_mul, map_inv]
      rfl
    rw [h4, h5, ← h3]
    group

open CFSG.Quasithin CFSG.Quasithin.B42SL3 CFSG.Quasithin.H CFSG.Assembly.LowTwoRank CFSG.QuasithinUnique in
private theorem burnsideKC_natural3 {V : Type} [CommGroup V] [Finite V] {G L : Subgroup (MulAut V)}
    {K : Type} [Field K] [Finite K] [CharP K 2] (hV : ∀ v : V, v ^ 2 = 1) (hHyp : B4Hyp G L)
    {n : ℕ} (hn : 1 ≤ n) (hK : Nat.card K = 2 ^ n) (π : ↥(StatedSL 3 K) →* ↥L)
    (hπ : Function.Surjective π) (e : V ≃* StdMod (Fin 3) K)
    (he : ∀ (γ : ↥(StatedSL 3 K)) (v : V),
      e (((π γ : ↥L) : MulAut V) v) = natAct (StatedSL 3 K) γ (e v)) :
    (∀ B, IsFFStarOffender G B → B ≤ L) ∧ qOf G = ((1 / 2 : ℚ) : WithTop ℚ) := by
  classical
  set c := natSecOf π hπ e he with hc
  have hLmap : L.map (congrHom e) = natImage (StatedSL 3 K) :=
    map_congrHom_eq_natImage (StatedSL 3 K) hπ e he
  have hle : ∀ B, IsFFStarOffender G B → B ≤ L := by
    intro B hB
    have hEN : B.map (congrHom e) ≤ natNorm (StatedSL 3 K) := by
      have h1 := Subgroup.map_mono (f := congrHom e)
        (hB.1.trans (B42L2.le_normalizer_of_b4Hyp hHyp))
      rwa [Subgroup.map_equiv_normalizer_eq L (MulAut.congr e), hLmap] at h1
    have hEl := (isElemAbelian2_map_congrHom e).2 hB.2.2.1
    have hoff : Nat.card (StdMod (Fin 3) K) ≤
        Nat.card (B.map (congrHom e)) * Nat.card (fixV (B.map (congrHom e))) := by
      rw [card_map_congrHom, fixV_map_congrHom,
        Subgroup.card_map_of_injective e.injective, ← Nat.card_congr e.toEquiv]
      exact B42L2.card_le_of_offender hB
    have h2 := le_natImage_of_offender hn hK hEN hEl hoff
    rw [← hLmap] at h2
    exact (map_congrHom_le_iff e).1 h2
  refine ⟨hle, ?_⟩
  have hstab : L ≤ stabSub (⊤ : Subgroup V) := fun _ _ _ => Iff.rfl
  have hVcard : Nat.card V = Nat.card K ^ 3 := by
    rw [Nat.card_congr e.toEquiv, card_stdMod, Fintype.card_fin]
  have hfix : ∀ {B : Subgroup (MulAut V)}, B ≤ L →
      Nat.card ↥(fixV B) = Nat.card (B5.fixK (c.pre B)) := by
    intro B hBL
    rw [← c.card_inf_fixV hstab hBL, top_inf_eq]
  refine qOf_eq_of_offenders hV (s := 1 / 2) (by norm_num) (fun B hB => ?_) ?_
  ·
    have hBL := hle B hB
    refine half_le_rAV_of_card hV hB.2.2.1 hB.2.1 ?_
    rw [hfix hBL, ← c.card_pre hBL, hVcard, ← pow_mul]
    exact B5.card_mul_card_fixK_sq_le (c.pre_ne_bot hBL hB.2.1) (c.pre_sq hB.2.2.1)
      (c.pre_comm hB.2.2.1)
  ·
    set D := B5.axisSub (plane K) with hD
    set B₀ : Subgroup (MulAut V) := D.map (L.subtype.comp π) with hB₀
    have hB₀L : B₀ ≤ L := by
      rintro _ ⟨γ, -, rfl⟩
      exact (π γ).2
    have hpre : c.pre B₀ = D := by
      ext γ
      constructor
      · intro hγ
        obtain ⟨δ, hδ, hδγ⟩ := hγ
        have hδγ' : π δ = π γ := Subtype.ext hδγ
        have : δ = γ := c.hπ.1 hδγ'
        exact this ▸ hδ
      · intro hγ
        exact ⟨γ, hγ, rfl⟩
    have hDcard : Nat.card D = Nat.card K ^ 2 := B5.card_axisSub finrank_plane
    have hcardB₀ : Nat.card B₀ = Nat.card K ^ 2 := by
      rw [← c.card_pre hB₀L, hpre, hDcard]
    have hB₀ne : B₀ ≠ ⊥ := by
      intro h0
      rw [h0, Subgroup.card_bot] at hcardB₀
      have : 1 < Nat.card K ^ 2 := Nat.one_lt_pow (by norm_num) Finite.one_lt_card
      omega
    have hB₀el : IsElemAbelian2 B₀ := by
      refine ⟨?_, ?_⟩
      · rintro _ ⟨γ, hγ, rfl⟩ _ ⟨δ, hδ, rfl⟩
        have := congrArg (fun g => ((π g : ↥L) : MulAut V)) (B5.axisSub_comm hγ hδ)
        simp only [map_mul, Subgroup.coe_mul] at this
        simpa only [MonoidHom.comp_apply, Subgroup.coe_subtype] using this
      · rintro _ ⟨γ, hγ, rfl⟩
        have := congrArg (fun g => ((π g : ↥L) : MulAut V)) (B5.axisSub_mul_self hγ)
        simp only [map_mul, map_one, Subgroup.coe_mul, Subgroup.coe_one] at this
        simp only [MonoidHom.comp_apply, Subgroup.coe_subtype]
        rw [pow_two]
        exact this
    have hfixB₀ : Nat.card ↥(fixV B₀) = Nat.card K ^ 2 := by
      rw [hfix hB₀L, hpre]
      have hne : D ≠ ⊥ := by
        intro h0
        rw [h0, Subgroup.card_bot] at hDcard
        have : 1 < Nat.card K ^ 2 := Nat.one_lt_pow (by norm_num) Finite.one_lt_card
        omega
      rw [B5.fixK_eq_of_le_axisSub finrank_plane le_rfl hne,
        Module.natCard_eq_pow_finrank (K := K) (V := plane K), finrank_plane]
    have hr : rAV B₀ = 1 / 2 := by
      have h1 := rk_add_rkIdx (fixV B₀)
      have hrkV : rk V = 3 * n := by
        unfold rk
        rw [hVcard, hK, ← pow_mul, padicValNat.prime_pow]
