open CFSG.ASVolI.ChIJK in
private theorem burnsideKE_omegaOne_map {G H : Type} [Group G] [Group H] (f : G →* H)
    (hf : Function.Injective f) (P : Subgroup G) :
    ChIJK.omegaOne (P.map f) = (ChIJK.omegaOne P).map f := by
