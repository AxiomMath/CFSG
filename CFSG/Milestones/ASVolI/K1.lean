private theorem burnsideKE_isG2Derived {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {f : ℕ}
    (h : G2NaturalDerived L ⊤ ⊥ f) : IsG2Derived f ↥L := by
  obtain ⟨K, hK, hf, hc, π, hπ⟩ := h
