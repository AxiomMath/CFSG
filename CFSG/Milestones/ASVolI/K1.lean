open CFSG.ASVolI.ChIJK CFSG.Quasithin CFSG.QuasithinUnique CFSG.Quasithin.HatA6 in
private theorem burnsideKA_hatA6_index {V : Type} [CommGroup V] [Finite V] {G L : Subgroup
    (MulAut V)}
    (hV : ∀ v : V, v ^ 2 = 1) (hHyp : B4Hyp G L) (hP : B42TypeHatA6 ↥L)
    (hcard : Nat.card V = 2 ^ 6) : (L.subgroupOf G).index ≤ 2 := by
  classical
  obtain ⟨zL, hcen, h3, hz1, hfp⟩ := exists_center_gen hHyp hP
  have hGN := le_normalizer_of_b4Hyp hHyp
  have hirr := irr_of_b4Hyp hHyp
  obtain ⟨hq, hZ, ⟨e⟩⟩ := hP
  set z : MulAut V := (zL : MulAut V) with hzdef
  have hzc : zL ∈ Subgroup.center ↥L := hcen ▸ Subgroup.mem_zpowers zL
  have hmem : ∀ g ∈ G, g ∈ L ↔ g * z = z * g := by
    intro g hg
    constructor
    · intro hgL
      exact congrArg Subtype.val (Subgroup.mem_center_iff.1 hzc ⟨g, hgL⟩)
    · intro hcomm
      refine mem_of_normalizes hV hcard hq.1 hZ e hirr
        (Subgroup.mem_normalizer_iff.1 (hGN hg)) ?_
      intro k hk
      rw [hcen] at hk
      obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 hk
      rw [Subgroup.coe_zpow]
      exact (Commute.zpow_right hcomm n).eq
  have hz3 : z * z * z = 1 := by rw [← pow_three']; exact h3
  have hinv : ∀ g ∈ G, g ∉ L → g * z = z * z * g := fun g hg hgL =>
    (conj_z_cases hcen h3 hz1 (hGN hg)).resolve_left (fun h => hgL ((hmem g hg).2 h))
  by_cases hall : ∀ g ∈ G, g ∈ L
  · have htop : L.subgroupOf G = ⊤ := by
      rw [eq_top_iff]
      intro g _
      exact Subgroup.mem_subgroupOf.2 (hall g g.2)
    rw [htop, Subgroup.index_top]
    norm_num
  · push Not at hall
    obtain ⟨a, haG, haL⟩ := hall
    refine le_of_eq (Subgroup.index_eq_two_iff.2 ⟨⟨a, haG⟩, fun b => ?_⟩)
    by_cases hbL : (b : MulAut V) ∈ L
    · refine Or.inr ⟨Subgroup.mem_subgroupOf.2 hbL, fun h => haL ?_⟩
      have h' : (b : MulAut V) * a ∈ L := Subgroup.mem_subgroupOf.1 h
      have := L.mul_mem (L.inv_mem hbL) h'
      simpa using this
    · refine Or.inl ⟨?_, fun h => hbL (Subgroup.mem_subgroupOf.1 h)⟩
      have haz := hinv a haG haL
      have hbz := hinv b b.2 hbL
      have hcomm : (b : MulAut V) * a * z = z * ((b : MulAut V) * a) := by
        calc (b : MulAut V) * a * z = (b : MulAut V) * (a * z) := by group
          _ = (b : MulAut V) * (z * z * a) := by rw [haz]
          _ = ((b : MulAut V) * z) * z * a := by group
          _ = (z * z * (b : MulAut V)) * z * a := by rw [hbz]
          _ = z * z * ((b : MulAut V) * z) * a := by group
          _ = z * z * (z * z * (b : MulAut V)) * a := by rw [hbz]
          _ = z * (z * z * z) * (b : MulAut V) * a := by group
          _ = z * ((b : MulAut V) * a) := by rw [hz3]; group
      exact Subgroup.mem_subgroupOf.2 ((hmem _ (G.mul_mem b.2 haG)).2 hcomm)

open CFSG.Quasithin CFSG.QuasithinUnique in
private theorem burnsideKA_exists_conj_le {V : Type} [CommGroup V] [Finite V] {G T A : Subgroup
    (MulAut V)}
    (hT : IsSylowTwoOf T G) (hA : IsPGroup 2 A) (hAG : A ≤ G) :
    ∃ g ∈ G, B1.conjAut g A ≤ T := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨hTG, hT2, hTidx⟩ := hT
  have hTs : IsPGroup 2 (T.subgroupOf G) :=
    IsPGroup.of_surjective hT2 (Subgroup.subgroupOfEquivOfLe hTG).symm.toMonoidHom
      (MulEquiv.surjective _)
  have hAs : IsPGroup 2 (A.subgroupOf G) :=
    IsPGroup.of_surjective hA (Subgroup.subgroupOfEquivOfLe hAG).symm.toMonoidHom
      (MulEquiv.surjective _)
  let P : Sylow 2 ↥G := hTs.toSylow hTidx
  obtain ⟨Q, hQ⟩ := IsPGroup.exists_le_sylow hAs
  obtain ⟨x, hx⟩ := MulAction.exists_smul_eq ↥G P Q
  refine ⟨((x⁻¹ : ↥G) : MulAut V), (x⁻¹).2, ?_⟩
  intro z hz
  have hz' := B1.mem_conjAut.1 hz
  set a : MulAut V := ((x⁻¹ : ↥G) : MulAut V)⁻¹ * z * ((x⁻¹ : ↥G) : MulAut V) with ha_def
  have haA : a ∈ A := hz'
  have hza : z = ((x⁻¹ : ↥G) : MulAut V) * a * ((x⁻¹ : ↥G) : MulAut V)⁻¹ := by
    rw [ha_def]; group
  have haQ : (⟨a, hAG haA⟩ : ↥G) ∈ (Q : Subgroup ↥G) := hQ (Subgroup.mem_subgroupOf.2 haA)
  rw [← hx, Sylow.coe_subgroup_smul, Subgroup.mem_pointwise_smul_iff_inv_smul_mem] at haQ
  have hinv : (MulAut.conj x)⁻¹ = MulAut.conj x⁻¹ := (map_inv MulAut.conj x).symm
  rw [hinv] at haQ
  have haP : x⁻¹ * (⟨a, hAG haA⟩ : ↥G) * x ∈ (P : Subgroup ↥G) := by
    simpa [MulAut.smul_def, MulAut.conj_apply] using haQ
  have hy' : x⁻¹ * (⟨a, hAG haA⟩ : ↥G) * x ∈ T.subgroupOf G := by
    simpa [P] using haP
  have h1 := Subgroup.mem_subgroupOf.1 hy'
  have h2 : (((x⁻¹ * (⟨a, hAG haA⟩ : ↥G) * x : ↥G)) : MulAut V) = z := by
    rw [hza]
    simp
  rw [h2] at h1
  exact h1

private theorem burnsideKA_comm_of_fix {V : Type} [CommGroup V] {W : Subgroup V} {x y : MulAut V}
    (hx : ∀ w ∈ W, x w = w) (hy : ∀ w ∈ W, y w = w)
    (hx' : ∀ v, x v * v⁻¹ ∈ W) (hy' : ∀ v, y v * v⁻¹ ∈ W) : x * y = y * x := by
  ext v
  show x (y v) = y (x v)
  have e1 : x (y v) = x v * y v * v⁻¹ := by
    have h : y v = v * (y v * v⁻¹) := by rw [mul_left_comm, mul_inv_cancel, mul_one]
    calc x (y v) = x (v * (y v * v⁻¹)) := by rw [← h]
      _ = x v * x (y v * v⁻¹) := map_mul x _ _
      _ = x v * (y v * v⁻¹) := by rw [hx _ (hy' v)]
      _ = x v * y v * v⁻¹ := by rw [mul_assoc]
  have e2 : y (x v) = y v * x v * v⁻¹ := by
    have h : x v = v * (x v * v⁻¹) := by rw [mul_left_comm, mul_inv_cancel, mul_one]
    calc y (x v) = y (v * (x v * v⁻¹)) := by rw [← h]
      _ = y v * y (x v * v⁻¹) := map_mul y _ _
      _ = y v * (x v * v⁻¹) := by rw [hy _ (hx' v)]
      _ = y v * x v * v⁻¹ := by rw [mul_assoc]
  rw [e1, e2, mul_comm (x v)]

open CFSG.ASVolI.ChIJK CFSG.Quasithin CFSG.QuasithinUnique CFSG.Quasithin.HatA6 in
private theorem burnsideKA_hatA6_unique {V : Type} [CommGroup V] [Finite V]
    {G L T A A' : Subgroup (MulAut V)} (hV : ∀ v : V, v ^ 2 = 1) (hHyp : B4Hyp G L)
    (hP : B42TypeHatA6 ↥L) (hcard : Nat.card V = 2 ^ 6) (hT2 : IsPGroup 2 T) (hTG : T ≤ G)
    (hAT : IsFFStarOffender T A) (hA'T : IsFFStarOffender T A') : A = A' := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hA : IsFFStarOffender G A := ⟨hAT.1.trans hTG, hAT.2⟩
  have hA' : IsFFStarOffender G A' := ⟨hA'T.1.trans hTG, hA'T.2⟩
  obtain ⟨hAL, hA4, hA16, hAcomm⟩ := offender_facts hV hHyp hP hA
  obtain ⟨hA'L, hA'4, hA'16, hA'comm⟩ := offender_facts hV hHyp hP hA'
  by_contra hne
  obtain ⟨zL, hcen, h3, hz1, hfp⟩ := exists_center_gen hHyp hP
  have hzc : zL ∈ Subgroup.center ↥L := hcen ▸ Subgroup.mem_zpowers zL
  have hP' := hP
  obtain ⟨hq, hZ, ⟨e⟩⟩ := hP'
  have hL1080 : Nat.card L = 1080 := (quasisimple_card hq.1 hZ e).2
  set P : Subgroup (MulAut V) := A ⊔ A' with hPdef
  have hPT : P ≤ T := sup_le hAT.1 hA'T.1
  have hPL : P ≤ L := sup_le hAL hA'L
  have hP2 : IsPGroup 2 ↥P := hT2.to_le hPT
  have hPdvd : Nat.card P ∣ 1080 := hL1080 ▸ Subgroup.card_dvd_of_le hPL
  obtain ⟨k, hk⟩ := (IsPGroup.iff_card).1 hP2
  have hk3 : k ≤ 3 := by
    by_contra hk4
    push Not at hk4
    have h16 : 2 ^ 4 ∣ 2 ^ k := Nat.pow_dvd_pow 2 hk4
    rw [← hk] at h16
    have := h16.trans hPdvd
    omega
  have hAP : A ≤ P := le_sup_left
  have hA'P : A' ≤ P := le_sup_right
  have hP8 : Nat.card P = 8 := by
    have h1 := Subgroup.card_le_of_le hAP
    rw [hA4] at h1
    interval_cases k
    · rw [pow_zero] at hk; omega
    · rw [pow_one] at hk; omega
    · exfalso
      apply hne
      have hP4 : Nat.card P = 4 := by rw [hk]; norm_num
      have e1 : A = P := Subgroup.eq_of_le_of_card_ge hAP (by rw [hP4, hA4])
      have e2 : A' = P := Subgroup.eq_of_le_of_card_ge hA'P (by rw [hP4, hA'4])
      rw [e1, e2]
    · rw [hk]; norm_num
  have hinf : A ⊓ A' ≠ ⊥ := by
    intro hbot
    let f : ↥A × ↥A' → ↥P := fun p =>
      ⟨(p.1 : MulAut V) * (p.2 : MulAut V), P.mul_mem (hAP p.1.2) (hA'P p.2.2)⟩
    have hf : Function.Injective f := by
      rintro ⟨a, b⟩ ⟨a', b'⟩ h
      have h1 : (a : MulAut V) * b = a' * b' := congrArg Subtype.val h
      have h2 : ((a' : MulAut V))⁻¹ * a = b' * (b : MulAut V)⁻¹ := by
        calc ((a' : MulAut V))⁻¹ * a = ((a' : MulAut V))⁻¹ * (a * b) * (b : MulAut V)⁻¹ := by
              group
          _ = ((a' : MulAut V))⁻¹ * (a' * b') * (b : MulAut V)⁻¹ := by rw [h1]
          _ = b' * (b : MulAut V)⁻¹ := by group
      have hmemA : ((a' : MulAut V))⁻¹ * a ∈ A := A.mul_mem (A.inv_mem a'.2) a.2
      have hmemA' : ((a' : MulAut V))⁻¹ * a ∈ A' := by
        rw [h2]; exact A'.mul_mem b'.2 (A'.inv_mem b.2)
      have h3 : ((a' : MulAut V))⁻¹ * a ∈ A ⊓ A' := ⟨hmemA, hmemA'⟩
      rw [hbot, Subgroup.mem_bot] at h3
      have haa : (a : MulAut V) = a' := by
        have := congrArg (fun y => (a' : MulAut V) * y) h3
        simpa using this
      have hbb : (b : MulAut V) = b' := by
        rw [haa] at h1
        exact mul_left_cancel h1
      exact Prod.ext (Subtype.ext haa) (Subtype.ext hbb)
    have := Nat.card_le_card_of_injective f hf
    rw [Nat.card_prod, hA4, hA'4, hP8] at this
    omega
  obtain ⟨⟨c, hc⟩, hc1⟩ := Subgroup.ne_bot_iff_exists_ne_one.1 hinf
  have hc1' : c ≠ 1 := fun h => hc1 (Subtype.ext h)
  have hcA : c ∈ A := hc.1
  have hcA' : c ∈ A' := hc.2
  have hc2 : c ^ 2 = 1 := hAT.2.2.1.2 c hcA
  have hcz : c * (zL : MulAut V) = (zL : MulAut V) * c :=
    congrArg Subtype.val (Subgroup.mem_center_iff.1 hzc ⟨c, hAL hcA⟩)
  have hzfix : ∀ v ∈ fixV (Subgroup.zpowers c), (zL : MulAut V) v ∈ fixV (Subgroup.zpowers c) := by
    intro v hv
    rw [HatA6.mem_fixV_zpowers_iff] at hv ⊢
    have := congrArg (fun y : MulAut V => y v) hcz
    change c ((zL : MulAut V) v) = (zL : MulAut V) (c v) at this
    rw [this, hv]
  have hcard2 : Nat.card (Subgroup.zpowers c) = 2 := by
    rw [Nat.card_zpowers]
    exact orderOf_eq_prime hc2 hc1'
  have hfixeq : ∀ B : Subgroup (MulAut V), IsFFStarOffender T B → c ∈ B →
      Nat.card (fixV B) = 16 → fixV B = fixV (Subgroup.zpowers c) := by
    intro B hB hcB hB16
    have hB4 : Nat.card B = 4 := by
      have hBG : IsFFStarOffender G B := ⟨hB.1.trans hTG, hB.2⟩
      exact (offender_facts hV hHyp hP hBG).2.1
    have hle : fixV B ≤ fixV (Subgroup.zpowers c) := by
      intro w hw
      exact (HatA6.mem_fixV_zpowers_iff).2 (hw c hcB)
    have hoff := hB.2.2.2 (Subgroup.zpowers c) ((Subgroup.zpowers_le).2 hcB)
    rw [hcard2, hB4, hB16] at hoff
    have hcases := card_cases_of_inv hcard h3 hfp hzfix
    have hge := Subgroup.card_le_of_le hle
    rw [hB16] at hge
    refine (Subgroup.eq_of_le_of_card_ge hle ?_)
    rcases hcases with h | h | h | h <;> omega
  have hW : fixV A = fixV A' :=
    (hfixeq A hAT hcA hA16).trans (hfixeq A' hA'T hcA' hA'16).symm
  have hcomm : ∀ x ∈ (A : Set (MulAut V)) ∪ (A' : Set (MulAut V)),
      ∀ y ∈ (A : Set (MulAut V)) ∪ (A' : Set (MulAut V)), x * y = y * x := by
    intro x hx y hy
    have hxy : ∀ x ∈ A, ∀ y ∈ A', x * y = y * x := by
      intro x hx y hy
      refine burnsideKA_comm_of_fix (W := fixV A) (fun w hw => hw x hx) ?_
        (fun v => hAcomm x hx v) ?_
      · intro w hw
        rw [hW] at hw
        exact hw y hy
      · intro v
        have := hA'comm y hy v
        rwa [← hW] at this
    rcases hx with hx | hx <;> rcases hy with hy | hy
    · exact hAT.2.2.1.1 x hx y hy
    · exact hxy x hx y hy
    · exact (hxy y hy x hx).symm
    · exact hA'T.2.2.1.1 x hx y hy
  have hPcl : P = Subgroup.closure ((A : Set (MulAut V)) ∪ (A' : Set (MulAut V))) := by
    rw [hPdef, Subgroup.sup_eq_closure]
  have h1 : P ≤ Subgroup.centralizer ((A : Set (MulAut V)) ∪ (A' : Set (MulAut V))) := by
    rw [hPcl, Subgroup.closure_le]
    intro x hx
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
    intro y hy
    exact hcomm y hy x hx
  have h2 : P ≤ Subgroup.centralizer (P : Set (MulAut V)) := by
    have hS : ((A : Set (MulAut V)) ∪ (A' : Set (MulAut V))) ⊆
        (Subgroup.centralizer (P : Set (MulAut V)) : Set (MulAut V)) := by
      intro x hx
      rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
      intro p hp
      exact (Subgroup.mem_centralizer_iff.1 (h1 hp) x hx).symm
    calc P = Subgroup.closure ((A : Set (MulAut V)) ∪ (A' : Set (MulAut V))) := hPcl
      _ ≤ Subgroup.centralizer (P : Set (MulAut V)) := (Subgroup.closure_le _).2 hS
  have hPcomm : ∀ p ∈ P, ∀ q ∈ P, p * q = q * p := fun p hp q hq =>
    (Subgroup.mem_centralizer_iff.1 (h2 hp) q hq).symm
  have hP2' : ∀ p ∈ P, p ^ 2 = 1 := by
    intro p hp
    rw [hPcl] at hp
    refine Subgroup.closure_induction (p := fun x _ => x ^ 2 = 1) ?_ ?_ ?_ ?_ hp
    · rintro x (hx | hx)
      · exact hAT.2.2.1.2 x hx
      · exact hA'T.2.2.1.2 x hx
    · simp
    · intro x y hx hy hx2 hy2
      have hxP : x ∈ P := by rw [hPcl]; exact hx
      have hyP : y ∈ P := by rw [hPcl]; exact hy
      rw [(show Commute x y from hPcomm x hxP y hyP).mul_pow, hx2, hy2, one_mul]
    · intro x hx hx2
      rw [inv_pow, hx2, inv_one]
  exact B45HatA6.false_of_eight hP hPL ⟨hPcomm, hP2'⟩ hP8

open CFSG.Quasithin in
