    ⟨F, inferInstance, inferInstance, by rw [Nat.card_eq_fintype_card, hF],
      ⟨θL.trans (specialLinearGroupEquivStatedSL 2 F)⟩⟩
  obtain ⟨W, _, _, _, ⟨θ⟩⟩ := exists_binModel_of_binary (V := V) hW
  have hclass : (Nat.card (EndRing (repOf θ θL)) = 2 ^ r ∧
        Module.finrank (EndRing (repOf θ θL)) W = 2) ∨
