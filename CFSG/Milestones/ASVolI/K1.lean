private theorem burnsideK3_hz {V : Type} [CommGroup V] [Finite V] {L : Subgroup (MulAut V)} {a : ℕ}
    (c : burnsideK3_Coord V L a) (hVcard : Nat.card V = 2 ^ (16 * a))
    (hdisp : ∀ l : ↥L, l * l = 1 → l ≠ 1 →
      2 ^ (6 * a) * Nat.card ↥(fixV (Subgroup.zpowers (l : MulAut V))) ≤ Nat.card V) :
    ∀ z : ↥(StatedSp 2 c.K), z * z = 1 → z ≠ 1 →
      Nat.card ↥(hermFix a (Fin 2 ⊕ Fin 2) c.K
        (spM '' ((Subgroup.zpowers z : Subgroup ↥(StatedSp 2 c.K)) :
          Set ↥(StatedSp 2 c.K)))) * Nat.card c.K ^ 3 ≤ Nat.card c.K ^ 8 := by
  intro z hz hz1
  set l : ↥L := c.δ.symm z with hl
  have hll : l * l = 1 := by
    rw [hl, ← map_mul, hz, map_one]
  have hl1 : l ≠ 1 := fun h => hz1 (by
    have := congrArg c.δ h
    rwa [hl, MulEquiv.apply_symm_apply, map_one] at this)
  have hd := hdisp l hll hl1
  set B : Subgroup (MulAut V) := (Subgroup.zpowers l).map L.subtype with hB
  have hB' : B = Subgroup.zpowers (l : MulAut V) := MonoidHom.map_zpowers L.subtype l
  have hBL : B ≤ L := by
    rintro _ ⟨x, -, rfl⟩
    exact x.2
  have hBsub : B.subgroupOf L = Subgroup.zpowers l := by
    rw [hB]
    exact Subgroup.comap_map_eq_self_of_injective L.subtype_injective _
  have hmapB : (B.subgroupOf L).map c.δ.toMonoidHom = Subgroup.zpowers z := by
    rw [hBsub, MonoidHom.map_zpowers]
    show Subgroup.zpowers (c.δ l) = _
    rw [hl, MulEquiv.apply_symm_apply]
  have hcard := burnsideK3_card_fixV c B hBL
  rw [hmapB] at hcard
  rw [← hcard]
  rw [← hB'] at hd
  have h6 : Nat.card c.K ^ 3 = 2 ^ (6 * a) := by
    rw [c.hK, ← pow_mul]
    ring_nf
  have h8 : Nat.card c.K ^ 8 = Nat.card V := by
    rw [hVcard, c.hK, ← pow_mul]
    ring_nf
  rw [h6, h8, mul_comm]
  exact hd

