@[expose] def burnsideK3_T0 {K : Type} [Field K] [CharP K 2] (a : ℕ) :
    ↥(hermA a (Fin 2 ⊕ Fin 2) K) ≃+ ↥(hermA a (Fin 2 ⊕ Fin 2) K) where
  toFun Y := ⟨(Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K)ᵀ, by
    have h := Y.2
    rw [mem_hermA] at h ⊢
    rw [frobPow_transpose, Matrix.transpose_transpose]
    have := congrArg Matrix.transpose h
    rw [Matrix.transpose_transpose] at this
    exact this⟩
  invFun Y := ⟨(Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K)ᵀ, by
    have h := Y.2
    rw [mem_hermA] at h ⊢
    rw [frobPow_transpose, Matrix.transpose_transpose]
    have := congrArg Matrix.transpose h
    rw [Matrix.transpose_transpose] at this
    exact this⟩
  left_inv Y := Subtype.ext (Matrix.transpose_transpose _)
  right_inv Y := Subtype.ext (Matrix.transpose_transpose _)
  map_add' Y Z := Subtype.ext (Matrix.transpose_add _ _)

private theorem burnsideK3_T0_apply {K : Type} [Field K] [CharP K 2] (a : ℕ)
    (Y : ↥(hermA a (Fin 2 ⊕ Fin 2) K)) :
    ((burnsideK3_T0 a Y : ↥(hermA a (Fin 2 ⊕ Fin 2) K)) :
      Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) =
      (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K)ᵀ := rfl

private theorem burnsideK3_tw_transpose {K : Type} [Field K] [CharP K 2] [Finite K] {a : ℕ}
    (hK : Nat.card K = 2 ^ (2 * a)) (g Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) :
    (tw a g Y)ᵀ = tw a (frobPow a g) Yᵀ := by
  rw [tw_apply, tw_apply, frobPow_frobPow a hK, Matrix.transpose_mul, Matrix.transpose_mul,
    Matrix.transpose_transpose, Matrix.mul_assoc]

private theorem burnsideK3_count_fix {K : Type} [Field K] [CharP K 2] [Finite K] {a : ℕ} (ha : 1 ≤ a)
    (z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) (hzz : z * z = 1) (hz1 : z ≠ 1)
    (hzk : frobPow a z = z) :
    Nat.card {Y : ↥(hermA a (Fin 2 ⊕ Fin 2) K) //
      (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K)ᵀ = Y ∧ tw a z Y = Y} ≤ 2 ^ (7 * a) := by
  classical
  set k : Subfield K := burnsideK3_fixF K a with hk
  have hkc : Nat.card ↥k ≤ 2 ^ a := burnsideK3_card_fixF ha
  have hι : Fintype.card (Fin 2 ⊕ Fin 2) = 4 := by simp
  have hzmem : ∀ i j, z i j ∈ k := fun i j => by
    rw [hk, burnsideK3_mem_fixF]
    have := congrFun (congrFun hzk i) j
    simpa [frobPow] using this
  let Zk : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) ↥k := Matrix.of fun i j => ⟨z i j, hzmem i j⟩
  have hZk : (RingHom.mapMatrix k.subtype) Zk = z := by
    ext i j
    rfl
  have hinj : Function.Injective (RingHom.mapMatrix (m := Fin 2 ⊕ Fin 2) k.subtype) := fun A B h => by
    ext i j
    exact congrFun (congrFun h i) j
  have hZZ : Zk * Zk = 1 := by
    apply hinj
    rw [map_mul, hZk, hzz, map_one]
  have hZ1 : Zk ≠ 1 := fun h => hz1 (by rw [← hZk, h, map_one])
  have hmem : ∀ Y : {Y : ↥(hermA a (Fin 2 ⊕ Fin 2) K) //
      (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K)ᵀ = Y ∧ tw a z Y = Y}, ∀ i j,
      (Y.1 : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) i j ∈ k := fun Y i j => by
    rw [hk, burnsideK3_mem_fixF]
    have h1 : (frobPow a (Y.1 : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K))ᵀ = Y.1 := Y.1.2
    have h2 : frobPow a (Y.1 : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) = Y.1 := by
      have := congrArg Matrix.transpose h1
      rw [Matrix.transpose_transpose] at this
      rw [this]
      exact Y.2.1
    have := congrFun (congrFun h2 i) j
    simpa [frobPow] using this
  let g : {Y : ↥(hermA a (Fin 2 ⊕ Fin 2) K) //
      (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K)ᵀ = Y ∧ tw a z Y = Y} →
      Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) ↥k :=
    fun Y => Matrix.of fun i j => ⟨(Y.1 : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) i j, hmem Y i j⟩
  have hgY : ∀ Y, (RingHom.mapMatrix k.subtype) (g Y) =
      (Y.1 : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) := fun Y => by
    ext i j
    rfl
  have hgT : ∀ Y, (g Y)ᵀ = g Y := fun Y => by
    ext i j
    have := congrFun (congrFun Y.2.1 i) j
    exact this
  have hgZ : ∀ Y, Zk * g Y * Zkᵀ = g Y := fun Y => by
    apply hinj
    have e : (RingHom.mapMatrix k.subtype) (Zkᵀ) = zᵀ := by
      rw [← hZk]
      ext i j
      rfl
    rw [map_mul, map_mul, hZk, hgY, e]
    have h2 := Y.2.2
    rw [tw_apply, hzk] at h2
    exact h2
  let f : {Y : ↥(hermA a (Fin 2 ⊕ Fin 2) K) //
      (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K)ᵀ = Y ∧ tw a z Y = Y} →
      {Y' : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) ↥k // Y'ᵀ = Y' ∧ Zk * Y' * Zkᵀ = Y'} :=
    fun Y => ⟨g Y, hgT Y, hgZ Y⟩
  have hf : Function.Injective f := fun Y Y' h => by
    apply Subtype.ext
    apply Subtype.ext
    have h1 : g Y = g Y' := congrArg Subtype.val h
    have h2 := congrArg (RingHom.mapMatrix k.subtype) h1
    rw [hgY, hgY] at h2
    exact h2
  calc Nat.card {Y : ↥(hermA a (Fin 2 ⊕ Fin 2) K) //
        (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K)ᵀ = Y ∧ tw a z Y = Y}
      ≤ Nat.card {Y' : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) ↥k // Y'ᵀ = Y' ∧ Zk * Y' * Zkᵀ = Y'} :=
        Nat.card_le_card_of_injective f hf
    _ ≤ Nat.card ↥k ^ 7 := burnsideK3_card_sym_fix hι hZZ hZ1
    _ ≤ (2 ^ a) ^ 7 := Nat.pow_le_pow_left hkc 7
    _ = 2 ^ (7 * a) := by rw [← pow_mul, mul_comm]

private theorem burnsideK3_conj_form {G : Type} [Group G] [Finite G] (Z : Subgroup G) (b s : G)
    (hbb : b * b = 1) (hss : s * s = 1) (hu : s⁻¹ * b ∈ Z)
    (hZ : ∀ v ∈ Z, v * v = 1 → v = 1) : ∃ y ∈ Z, b = y⁻¹ * s * y := by
  have hsinv : s⁻¹ = s := inv_eq_of_mul_eq_one_right hss
  set u : G := s⁻¹ * b with hu_def
  have hb : b = s * u := by rw [hu_def, hsinv, ← mul_assoc, hss, one_mul]
  have hsus : s * u * s⁻¹ = u⁻¹ := by
    have h1 : s * u * (s * u) = 1 := by rw [← hb]; exact hbb
    have h2 : s * u * s = u⁻¹ := by
      apply eq_inv_of_mul_eq_one_left
      calc s * u * s * u = s * u * (s * u) := by group
        _ = 1 := h1
    rw [hsinv]
    exact h2
  have hodd : Odd (orderOf u) := by
    by_contra h
    rw [Nat.not_odd_iff_even] at h
    obtain ⟨m, hm⟩ := h
    have hmpos : 0 < m := by
      have := orderOf_pos u
      omega
    have hvZ : u ^ m ∈ Z := Z.pow_mem hu m
    have hvv : u ^ m * u ^ m = 1 := by
      rw [← pow_add, ← hm]
      exact pow_orderOf_eq_one u
    have h1 : u ^ m = 1 := hZ _ hvZ hvv
    have h2 := orderOf_dvd_of_pow_eq_one h1
    have h3 := Nat.le_of_dvd hmpos h2
    omega
  obtain ⟨k, hk⟩ := hodd
  have hyZ : u ^ (k + 1) ∈ Z := Z.pow_mem hu _
  refine ⟨u ^ (k + 1), hyZ, ?_⟩
  have hy2 : u ^ (k + 1) * u ^ (k + 1) = u := by
    rw [← pow_add]
    have : k + 1 + (k + 1) = orderOf u + 1 := by omega
    rw [this, pow_succ, pow_orderOf_eq_one, one_mul]
  have hsy : s * u ^ (k + 1) = (u ^ (k + 1))⁻¹ * s := by
    have h1 : s * u ^ (k + 1) * s⁻¹ = (u ^ (k + 1))⁻¹ := by
      rw [← conj_pow, hsus, inv_pow]
    calc s * u ^ (k + 1) = (s * u ^ (k + 1) * s⁻¹) * s := by group
      _ = (u ^ (k + 1))⁻¹ * s := by rw [h1]
  calc b = s * u := hb
    _ = s * (u ^ (k + 1) * u ^ (k + 1)) := by rw [hy2]
    _ = (s * u ^ (k + 1)) * u ^ (k + 1) := by rw [← mul_assoc]
    _ = (u ^ (k + 1))⁻¹ * s * u ^ (k + 1) := by rw [hsy]

@[expose] noncomputable def burnsideK3_tau (C : burnsideK3_Ctx V L a) : C.W ≃ₗ[ZMod 2] C.W :=
  burnsideK3_zmodEquiv (C.φ.trans ((burnsideK3_T0 a).trans C.φ.symm))

private theorem burnsideK3_phi_tau (C : burnsideK3_Ctx V L a) (w : C.W) :
    ((C.φ (burnsideK3_tau C w) : ↥(hermA a (Fin 2 ⊕ Fin 2) C.K)) :
      Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) C.K) =
      ((C.φ w : ↥(hermA a (Fin 2 ⊕ Fin 2) C.K)) :
        Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) C.K)ᵀ := by
  show ((C.φ (C.φ.symm (burnsideK3_T0 a (C.φ w))) : ↥(hermA a (Fin 2 ⊕ Fin 2) C.K)) :
    Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) C.K) = _
  rw [AddEquiv.apply_symm_apply]
  rfl

private theorem burnsideK3_tau_sq (C : burnsideK3_Ctx V L a) : burnsideK3_tau C * burnsideK3_tau C = 1 := by
  ext w
  apply C.φ.injective
  apply Subtype.ext
  show ((C.φ (burnsideK3_tau C (burnsideK3_tau C w)) : ↥(hermA a (Fin 2 ⊕ Fin 2) C.K)) :
    Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) C.K) = _
  rw [burnsideK3_phi_tau, burnsideK3_phi_tau, Matrix.transpose_transpose]
  rfl

open CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher (fieldSp coe_fieldSp) in
private theorem burnsideK3_tau_pi (C : burnsideK3_Ctx V L a) (ha : 1 ≤ a) (g : antiSp C.K) :
    burnsideK3_tau C * burnsideK3_pi C.θ C.θL g =
      burnsideK3_pi C.θ C.θL ((minorAut C.K ^ (2 * a)) g) * burnsideK3_tau C := by
  have : Fintype C.K := Fintype.ofFinite C.K
  obtain ⟨Fr, hFr, -, -⟩ := exists_frobenius_data (by omega : 1 ≤ 2 * a) C.hK
  ext w
  apply C.φ.injective
  apply Subtype.ext
  show ((C.φ (burnsideK3_tau C (burnsideK3_pi C.θ C.θL g w)) : ↥(hermA a (Fin 2 ⊕ Fin 2) C.K)) :
      Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) C.K) =
    ((C.φ (burnsideK3_pi C.θ C.θL ((minorAut C.K ^ (2 * a)) g) (burnsideK3_tau C w)) :
      ↥(hermA a (Fin 2 ⊕ Fin 2) C.K)) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) C.K)
  rw [burnsideK3_phi_tau, C.hφ, C.hφ, burnsideK3_phi_tau, burnsideK3_tw_transpose C.hK]
  congr 1
  have e1 : (minorAut C.K ^ C.j) ((minorAut C.K ^ (2 * a)) g) =
      (minorAut C.K ^ (2 * a)) ((minorAut C.K ^ C.j) g) := by
    rw [← MulAut.mul_apply, ← MulAut.mul_apply, ← pow_add, ← pow_add, add_comm]
  rw [e1, burnsideK3_antiSpEquiv_pow hFr]
  ext i j
  show (spMat (antiSpEquiv C.K ((minorAut C.K ^ C.j) g)) i j) ^ 2 ^ a =
    (Fr ^ a) (spMat (antiSpEquiv C.K ((minorAut C.K ^ C.j) g)) i j)
  rw [frobenius_pow_apply hFr]

open CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher (fieldSp coe_fieldSp) in
open CFSG.ComponentClassification.OuterAutomorphisms (inner Outer) in
private theorem burnsideK3_heart (C : burnsideK3_Ctx V L a) (ha : 1 ≤ a)
    (b : C.W ≃ₗ[ZMod 2] C.W) (hbb : b * b = 1) (α : MulAut (antiSp C.K))
    (hα : ∀ x, burnsideK3_pi C.θ C.θL (α x) = b * burnsideK3_pi C.θ C.θL x * b⁻¹)
    (hαα : α * α = 1) (hαout : α ∉ inner (antiSp C.K))
    (z : antiSp C.K) (hzz : z * z = 1) (hz1 : z ≠ 1)
    (hcomm : b * burnsideK3_pi C.θ C.θL z = burnsideK3_pi C.θ C.θL z * b) :
    Nat.card {w : C.W // b w = w ∧ burnsideK3_pi C.θ C.θL z w = w} ≤ 2 ^ (7 * a) := by
  classical
  have : Fintype C.K := Fintype.ofFinite C.K
  set π := burnsideK3_pi C.θ C.θL with hπ
  have hπinj : Function.Injective π := burnsideK3_pi_injective C.θ C.θL
  set τ := burnsideK3_tau C with hτ
  obtain ⟨R, hR⟩ : ∃ R : MulAut (antiSp C.K), R = minorAut C.K ^ (2 * a) := ⟨_, rfl⟩
  have hττ : τ * τ = 1 := burnsideK3_tau_sq C
  have hτinv : τ⁻¹ = τ := inv_eq_of_mul_eq_one_right hττ
  have hτπ : ∀ g, τ * π g * τ⁻¹ = π (R g) := fun g => by
    rw [hR, burnsideK3_tau_pi C ha g, hτinv, mul_assoc, hττ, mul_one]
  obtain ⟨c₁, hc₁⟩ := outer_involution_conj (n := 2 * a) (by omega) C.hK α hαα hαout
  have hαx : ∀ x, α x = c₁ * R (c₁⁻¹ * x * c₁) * c₁⁻¹ := fun x => by
    rw [hc₁, hR]
    simp [MulAut.mul_apply, MulAut.conj_apply, map_inv]
  let s : C.W ≃ₗ[ZMod 2] C.W := π c₁ * τ * (π c₁)⁻¹
  have hss : s * s = 1 := by
    calc s * s = π c₁ * (τ * τ) * (π c₁)⁻¹ := by simp only [s]; group
      _ = 1 := by rw [hττ]; group
  have hsπ : ∀ x, s * π x * s⁻¹ = π (α x) := fun x => by
    have h1 : s * π x * s⁻¹ = π c₁ * (τ * π (c₁⁻¹ * x * c₁) * τ⁻¹) * (π c₁)⁻¹ := by
      simp only [s, map_mul, map_inv, mul_inv_rev, inv_inv]
      group
    rw [h1, hτπ, hαx]
    simp only [map_mul, map_inv]
  have hu : s⁻¹ * b ∈ Subgroup.centralizer (Set.range π) := by
    rw [Subgroup.mem_centralizer_iff]
    rintro _ ⟨x, rfl⟩
    have h1 : π x = s⁻¹ * π (α x) * s := by
      rw [← hsπ x]
      group
    have h2 : b * π x * b⁻¹ = π (α x) := (hα x).symm
    calc π x * (s⁻¹ * b) = (s⁻¹ * π (α x) * s) * (s⁻¹ * b) := by rw [← h1]
      _ = s⁻¹ * (π (α x) * b) := by group
      _ = s⁻¹ * ((b * π x * b⁻¹) * b) := by rw [h2]
      _ = s⁻¹ * b * π x := by group
  have hZ : ∀ v ∈ Subgroup.centralizer (Set.range π), v * v = 1 → v = 1 := by
    intro v hv hvv
    refine burnsideK3_noInvol C v hvv (fun x => ?_)
    exact (Subgroup.mem_centralizer_iff.mp hv (π x) ⟨x, rfl⟩).symm
  obtain ⟨y, hyZ, hby⟩ := burnsideK3_conj_form (Subgroup.centralizer (Set.range π)) b s hbb hss hu hZ
  have hyπ : ∀ x, π x * y = y * π x := fun x =>
    Subgroup.mem_centralizer_iff.mp hyZ (π x) ⟨x, rfl⟩
  have hyπ' : ∀ x, y⁻¹ * π x = π x * y⁻¹ := fun x => by
    calc y⁻¹ * π x = y⁻¹ * (π x * y) * y⁻¹ := by group
      _ = y⁻¹ * (y * π x) * y⁻¹ := by rw [hyπ x]
      _ = π x * y⁻¹ := by group
  have hsb : s = y * b * y⁻¹ := by rw [hby]; group
  have hzs : π z * s = s * π z := by
    rw [hsb]
    calc π z * (y * b * y⁻¹) = (π z * y) * b * y⁻¹ := by group
      _ = y * (π z * b) * y⁻¹ := by rw [hyπ z]; group
      _ = y * (b * π z) * y⁻¹ := by rw [hcomm]
      _ = y * b * (π z * y⁻¹) := by group
      _ = y * b * (y⁻¹ * π z) := by rw [hyπ' z]
      _ = y * b * y⁻¹ * π z := by group
  set z₀ : antiSp C.K := c₁⁻¹ * z * c₁ with hz₀
  have hπz₀ : π z₀ = (π c₁)⁻¹ * π z * π c₁ := by
    rw [hz₀]
    simp only [map_mul, map_inv]
  have hτs : τ = (π c₁)⁻¹ * s * π c₁ := by
    simp only [s]
    group
  have hz₀τ : π z₀ * τ = τ * π z₀ := by
    calc π z₀ * τ = (π c₁)⁻¹ * (π z * s) * π c₁ := by
          rw [hπz₀]
          conv_lhs => rw [hτs]
          group
      _ = (π c₁)⁻¹ * (s * π z) * π c₁ := by rw [hzs]
      _ = τ * π z₀ := by
          rw [hπz₀]
          conv_rhs => rw [hτs]
          group
  have hRz₀ : R z₀ = z₀ := by
    apply hπinj
    rw [← hτπ z₀, ← hz₀τ, mul_assoc, mul_inv_cancel, mul_one]
  have hz₀z₀ : z₀ * z₀ = 1 := by
    calc z₀ * z₀ = c₁⁻¹ * (z * z) * c₁ := by rw [hz₀]; group
      _ = 1 := by rw [hzz]; group
  have hz₀1 : z₀ ≠ 1 := fun h => hz1 (by
    have : z = c₁ * z₀ * c₁⁻¹ := by rw [hz₀]; group
    rw [this, h]
    group)
  obtain ⟨Fr, hFr, -, -⟩ := exists_frobenius_data (by omega : 1 ≤ 2 * a) C.hK
  set z' : StatedSp 2 C.K := antiSpEquiv C.K ((minorAut C.K ^ C.j) z₀) with hz'
  have hfrob : frobPow a (spMat z') = spMat z' := by
    have e1 : (minorAut C.K ^ (2 * a)) ((minorAut C.K ^ C.j) z₀) = (minorAut C.K ^ C.j) z₀ := by
      rw [← MulAut.mul_apply, ← pow_add, add_comm, pow_add, MulAut.mul_apply, ← hR, hRz₀]
    have e2 := burnsideK3_antiSpEquiv_pow hFr a ((minorAut C.K ^ C.j) z₀)
    rw [e1] at e2
    ext i j
    have := congrArg (fun g : StatedSp 2 C.K => spMat g i j) e2
    simp only [coe_fieldSp, Matrix.map_apply, frobenius_pow_apply hFr] at this
    show spMat z' i j ^ 2 ^ a = spMat z' i j
    exact this.symm
  have hz'z' : spMat z' * spMat z' = 1 := by
    have h1 : z' * z' = 1 := by
      rw [hz', ← map_mul, ← map_mul, hz₀z₀, map_one, map_one]
    calc spMat z' * spMat z' = spMat (z' * z') := rfl
      _ = spMat (1 : StatedSp 2 C.K) := by rw [h1]
      _ = 1 := rfl
  have hz'1 : spMat z' ≠ 1 := fun h => hz₀1 (by
    have h1 : z' = 1 := spM_injective (h.trans spM_one.symm)
    have h2 : (minorAut C.K ^ C.j) z₀ = 1 := by
      apply (antiSpEquiv C.K).injective
      rw [← hz', h1, map_one]
    have h3 : (minorAut C.K ^ C.j) z₀ = (minorAut C.K ^ C.j) 1 := by rw [h2, map_one]
    exact (minorAut C.K ^ C.j).injective h3)
  have hcount := burnsideK3_count_fix ha (spMat z') hz'z' hz'1 hfrob
  let F₁ : C.W ≃ₗ[ZMod 2] C.W := (π c₁)⁻¹ * y
  have hF : ∀ w : {w : C.W // b w = w ∧ π z w = w}, τ (F₁ w.1) = F₁ w.1 ∧ π z₀ (F₁ w.1) = F₁ w.1 := by
    rintro ⟨w, hbw, hzw⟩
    have hsw : s (y w) = y w := by
      have h1 : (y⁻¹ * s * y) w = w := by rw [← hby]; exact hbw
      have h2 : y * (y⁻¹ * s * y) = s * y := by group
      calc s (y w) = (s * y) w := rfl
        _ = (y * (y⁻¹ * s * y)) w := by rw [h2]
        _ = y ((y⁻¹ * s * y) w) := rfl
        _ = y w := by rw [h1]
    have hcc : ∀ (f : C.W ≃ₗ[ZMod 2] C.W) (x : C.W), f (f⁻¹ x) = x := fun f x => by
      have : f * f⁻¹ = 1 := mul_inv_cancel f
      exact congrArg (fun g : C.W ≃ₗ[ZMod 2] C.W => g x) this
    refine ⟨?_, ?_⟩
    · apply (π c₁).injective
      show (π c₁) (τ ((π c₁)⁻¹ (y w))) = (π c₁) ((π c₁)⁻¹ (y w))
      rw [hcc]
      exact hsw
    · rw [hπz₀]
      show (π c₁)⁻¹ (π z (π c₁ ((π c₁)⁻¹ (y w)))) = (π c₁)⁻¹ (y w)
      rw [hcc]
      have : π z (y w) = y w := by
        calc π z (y w) = (π z * y) w := rfl
          _ = (y * π z) w := by rw [hyπ z]
          _ = y (π z w) := rfl
          _ = y w := by rw [hzw]
      rw [this]
  have hmat : ∀ w : {w : C.W // b w = w ∧ π z w = w},
      ((C.φ (F₁ w.1) : ↥(hermA a (Fin 2 ⊕ Fin 2) C.K)) :
        Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) C.K)ᵀ = C.φ (F₁ w.1) ∧
      tw a (spMat z') ((C.φ (F₁ w.1) : ↥(hermA a (Fin 2 ⊕ Fin 2) C.K)) :
        Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) C.K) = C.φ (F₁ w.1) := by
    intro w
    obtain ⟨h1, h2⟩ := hF w
    refine ⟨?_, ?_⟩
    · rw [← burnsideK3_phi_tau, h1]
    · have := C.hφ z₀ (F₁ w.1)
      rw [h2] at this
      exact this.symm
  refine le_trans (Nat.card_le_card_of_injective
    (fun w : {w : C.W // b w = w ∧ π z w = w} =>
      (⟨C.φ (F₁ w.1), (hmat w).1, (hmat w).2⟩ :
        {Y : ↥(hermA a (Fin 2 ⊕ Fin 2) C.K) //
          (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) C.K)ᵀ = Y ∧ tw a (spMat z') Y = Y}))
    ?_) hcount
  intro w w' h
  have h1 : C.φ (F₁ w.1) = C.φ (F₁ w'.1) := congrArg Subtype.val h
  have h2 : F₁ w.1 = F₁ w'.1 := C.φ.injective h1
  exact Subtype.ext (F₁.injective h2)

open CFSG.ComponentClassification.OuterAutomorphisms (inner Outer) in
private theorem burnsideK3_out (hV : ∀ v : V, v ^ 2 = 1)
    {G : Subgroup (MulAut V)} (hHyp : B4Hyp G L) (ha : 1 ≤ a) (C : burnsideK3_Ctx V L a)
    (hVcard : Nat.card V = 2 ^ (16 * a)) :
    ∀ A : Subgroup (MulAut V), IsA2 G A → ¬ A ≤ L →
      Nat.card ↥A ^ 2 * Nat.card ↥(fixV A) < Nat.card V := by
  classical
  intro A hA hAL
  have : Fintype C.K := Fintype.ofFinite C.K
  have hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)) := B42L2.le_normalizer_of_b4Hyp hHyp
  set π := burnsideK3_pi C.θ C.θL with hπ
  have hπinj : Function.Injective π := burnsideK3_pi_injective C.θ C.θL
  have hf : 2 ≤ 2 * a := by omega
  have hKf : Fintype.card C.K = 2 ^ (2 * a) := by
    rw [← Nat.card_eq_fintype_card]
    exact C.hK
  set B : Subgroup (C.W ≃ₗ[ZMod 2] C.W) := A.map (binPsi C.θ).toMonoidHom with hB
  have hBe : CFSG.IsElementaryAbelian 2 ↥B := (isElemAbelian2_iff_map C.θ A).1 hA.isElemAbelian2
  have hB1 : B ≠ ⊥ := by
    rw [hB, Ne, Subgroup.map_eq_bot_iff_of_injective A (binPsi C.θ).injective]
    exact hA.ne_bot
  have hsq : ∀ x ∈ B, x * x = 1 := fun x hx => by
    have := CFSG.elemPow_eq_one_of_isElementaryAbelian (p := 2) (A := B) x hx
    rwa [_root_.sq] at this
  have hcomm : ∀ x ∈ B, ∀ y ∈ B, x * y = y * x := fun x hx y hy => by
    have := hBe
    exact congrArg Subtype.val ((IsMulCommutative.is_comm (M := B)).comm ⟨x, hx⟩ ⟨y, hy⟩)
  have hnorm : ∀ x ∈ B, ∀ g, ∃ y, x * π g * x⁻¹ = π y := fun x hx g =>
    burnsideK3_normMap hGN C.θ C.θL A hA.le x hx g
  have hπ'inj : Function.Injective (repOf π) := fun g g' hg =>
    hπinj (LinearEquiv.toLinearMap_injective hg)
  have hπ'nt : ∃ g, repOf π g ≠ 1 :=
    ⟨invX C.K, fun h1 => invX_ne_one (hπ'inj (h1.trans (map_one (repOf π)).symm))⟩
  obtain ⟨hnt, hirr⟩ := (CFSG.QuasithinUnique.Setup.X7.isIrreducible_iff (repOf π)).mp C.irr.out
  have hsum : SimpleSummandsStable π B := by
    obtain ⟨g, hg⟩ := hπ'nt
    obtain ⟨x, hx⟩ : ∃ x, repOf π g x ≠ x := by
      by_contra h
      push Not at h
      exact hg (LinearMap.ext fun x => by rw [h x]; rfl)
    refine ⟨Unit, fun _ => ⊤, iSupIndep_subsingleton _, iSup_const, fun _ =>
      ⟨top_ne_bot, ⟨x, Submodule.mem_top, g, hx⟩, fun _ _ _ => Submodule.mem_top,
        fun U _ hU => hirr U hU, fun _ _ _ _ => Submodule.mem_top⟩⟩
  have H : Offender π B := ⟨hπinj, hnorm, hsq, hcomm, hsum⟩
  obtain ⟨-, hcyc, hcard, hN24⟩ :=
    even_symplectic_four_outer_involution_rank_and_perfect_residual hf C.hK
  have : Finite (Outer (antiSp C.K)) := Nat.finite_of_card_ne_zero (by rw [hcard]; omega)
  set Ψ := outerHom π B H.inj H.norm with hΨ
  have hcardA := H.card_eq
  have hq := H.card_range_le_two hcyc
  set Ê : Subgroup (antiSp C.K) := B.comap π with hÊ
  have hÊsq : ∀ x ∈ Ê, x * x = 1 := fun x hx => by
    apply hπinj
    rw [map_mul, map_one]
    exact hsq _ hx
  have hÊB : ∀ x ∈ Ê, π x ∈ B := fun x hx => hx
  obtain ⟨x₀, hx₀A, hx₀L⟩ : ∃ x ∈ A, x ∉ L := by
    by_contra h
    push Not at h
    exact hAL h
