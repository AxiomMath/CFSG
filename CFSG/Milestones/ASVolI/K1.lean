open CFSG.Quasithin CFSG.Quasithin.H CFSG.Blueprint CFSG.LieType.Ree CFSG.ASVolI.ChIJK in
private theorem burnsideKE_sz_T_data {V : Type} [CommGroup V]
    {L : Subgroup (MulAut V)} {a : ℕ} {K : Type} [Field K] [Finite K]
    (hK : Nat.card K = 2 ^ (2 * a + 1)) (hreal : (FFModel.nat (suzukiGroup a K)).Realizes L ⊤ ⊥)
    {T : Subgroup (MulAut V)} (hT2 : IsPGroup 2 ↥T) (hTL : T ≤ L)
    (hTidx : ¬ 2 ∣ (T.subgroupOf L).index) :
    ∃ (e : V ≃* StdMod (Fin 4) K) (ρ : ↥(suzukiGroup a K) →* MulAut V)
      (g : ↥(suzukiGroup a K)), Function.Injective ρ ∧ ρ.range = L ∧
      (∀ γ, congrHom e (ρ γ) = natAut (suzukiGroup a K) γ) ∧
      ChIJK.omegaOne T = ((suzukiZ0 a K).map (MulAut.conj g).toMonoidHom).map ρ := by
  obtain ⟨π, hπ⟩ := hreal
  obtain ⟨e, he⟩ := exists_mulEquiv_of_realizesVia (suzukiGroup a K) hπ
  let θ : ↥(suzukiGroup a K) ≃* ↥L := FFC.equivOfRealizes (FFModel.nat_faithful _) hπ
  have hθπ : ∀ γ, θ γ = π γ := fun γ => rfl
  let ρ : ↥(suzukiGroup a K) →* MulAut V := L.subtype.comp θ.toMonoidHom
  have hρ : Function.Injective ρ := L.subtype_injective.comp θ.injective
  have hθr : θ.toMonoidHom.range = ⊤ := MonoidHom.range_eq_top.2 θ.surjective
  have hρr : ρ.range = L := by
    rw [MonoidHom.range_comp, hθr, Subgroup.map_top, Subgroup.range_subtype]
  have hρe : ∀ γ, congrHom e (ρ γ) = natAut (suzukiGroup a K) γ := by
    intro γ
    refine MulEquiv.ext fun x => ?_
    rw [congrHom_apply]
    have h1 := he γ (e.symm x)
    rw [MulEquiv.apply_symm_apply] at h1
    exact h1
  let Tc : Subgroup ↥(suzukiGroup a K) := T.comap ρ
  have hTcT : Tc.map ρ = T := Subgroup.map_comap_eq_self (hTL.trans hρr.ge)
  have hTc2 : IsPGroup 2 ↥Tc := hT2.comap_of_injective ρ hρ
  have hTcidx : ¬ 2 ∣ Tc.index := by
    have h1 : Tc = (T.subgroupOf L).comap θ.toMonoidHom := by
      ext x
      simp [Tc, ρ, Subgroup.mem_subgroupOf]
    rw [h1, Subgroup.index_comap_of_surjective (T.subgroupOf L) (f := θ.toMonoidHom) θ.surjective]
    exact hTidx
  obtain ⟨g, hg⟩ := burnsideKE_sylow_conj hK (hTc2.toSylow hTcidx)
  rw [IsPGroup.toSylow_coe] at hg
  refine ⟨e, ρ, g, hρ, hρr, hρe, ?_⟩
  have hTe : T = (suzukiU a K).map (ρ.comp (MulAut.conj g).toMonoidHom) := by
    rw [← hTcT, hg, Subgroup.map_map]
  rw [hTe, burnsideKE_omegaOne_map _ ?_, burnsideKE_omega_suzukiU hK, Subgroup.map_map]
  exact hρ.comp (MulAut.conj g).injective

