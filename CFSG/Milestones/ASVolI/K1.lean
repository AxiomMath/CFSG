private theorem burnsideKC_planeUnipotent_W0 (F : Type) [Field F] [CharP F 2] :
    planeUnipotent (StatedSL 3 F) (burnsideKC_W0 F) =
      (burnsideKC_Q1 F).map (specialLinearGroupEquivStatedSL 3 F).toMonoidHom := by
  apply le_antisymm
  · rw [planeUnipotent, Subgroup.closure_le]
    intro g hg
    obtain ⟨h1, h2⟩ := hg
    set M : Matrix (Fin 3) (Fin 3) F := ((g : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) with hMdef
    have e0 : M *ᵥ (Pi.single 0 1 : Fin 3 → F) = Pi.single 0 1 := h1 _ (by simp [burnsideKC_mem_W0])
    have e1 : M *ᵥ (Pi.single 1 1 : Fin 3 → F) = Pi.single 1 1 := h1 _ (by simp [burnsideKC_mem_W0])
    have e2 : ((M *ᵥ (Pi.single 2 1 : Fin 3 → F) - (Pi.single 2 1 : Fin 3 → F) : Fin 3 → F)) 2 = 0 :=
      h2 (Pi.single 2 1)
    have e00 := congrFun e0 0
    have e10 := congrFun e0 1
    have e20 := congrFun e0 2
    have e01 := congrFun e1 0
    have e11 := congrFun e1 1
    have e21 := congrFun e1 2
    simp [Matrix.mulVec, dotProduct, Pi.single_apply, Fin.sum_univ_three] at e00 e10 e20 e01 e11 e21 e2
    refine ⟨up3 (M 1 2) (M 0 2) 0, ⟨M 1 2, M 0 2, rfl⟩, ?_⟩
    apply Subtype.ext
    apply Units.ext
    show ((specialLinearGroupEquivStatedSL 3 F (up3 _ _ 0) : GL (Fin 3) F) :
      Matrix (Fin 3) (Fin 3) F) = M
    rw [specialLinearGroupEquivStatedSL_coe, up3_coe]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [upMat, e00, e10, e20, e01, e11, e21] <;> linear_combination -e2
  · rintro _ ⟨u, ⟨x, y, rfl⟩, rfl⟩
    refine Subgroup.subset_closure ⟨?_, ?_⟩
    · intro v hv
      rw [burnsideKC_mem_W0] at hv
      show (((specialLinearGroupEquivStatedSL 3 F (up3 x y 0) : GL (Fin 3) F) :
        Matrix (Fin 3) (Fin 3) F)) *ᵥ v = v
      rw [specialLinearGroupEquivStatedSL_coe, up3_coe]
