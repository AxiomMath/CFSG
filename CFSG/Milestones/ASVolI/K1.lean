private theorem burnsideKC_sqt_center_quotient
    {Ω : Type} [Group Ω] [Finite Ω] {G L : Subgroup Ω}
    (hS : SQTKGroup ↥G) (hLG : L ≤ G) (hq : CFSG.IsQuasisimple ↥L) :
    ∀ q : ℕ, q.Prime → q ≠ 2 →
      CFSG.Open.pRank q (⊤ : Subgroup (↥L ⧸ Subgroup.center ↥L)) ≤ 2 := by
  let e₀ : ↥(L.subgroupOf G) ≃* ↥L := Subgroup.subgroupOfEquivOfLe hLG
  let e : (↥L ⧸ Subgroup.center ↥L) ≃*
      (↥(L.subgroupOf G) ⧸ Subgroup.center ↥(L.subgroupOf G)) :=
    QuotientGroup.congr (Subgroup.center ↥L) (Subgroup.center ↥(L.subgroupOf G)) e₀.symm
      (Subgroup.map_center_eq e₀.symm)
  have : IsSimpleGroup (↥L ⧸ Subgroup.center ↥L) := hq.2.1
  have : IsSimpleGroup (↥(L.subgroupOf G) ⧸ Subgroup.center ↥(L.subgroupOf G)) :=
    e.symm.isSimpleGroup
  have hnonab : ∃ a b : ↥(L.subgroupOf G) ⧸ Subgroup.center ↥(L.subgroupOf G),
      a * b ≠ b * a := by
    obtain ⟨a, b, hab⟩ := hq.2.2
    refine ⟨e a, e b, fun h => hab (e.injective ?_)⟩
    rw [map_mul, map_mul]
    exact h
  obtain ⟨hSQT, -⟩ := CFSG.SectionRank.sqt_catalog_of_simple_section_of_sqtk
    (SQTKGroup.isSQTKCat hS) (L.subgroupOf G) (Subgroup.center ↥(L.subgroupOf G)) hnonab
  intro q hq1 hq2
  have h := CFSG.SectionRank.isStronglyQuasithin_iff.1 hSQT q hq1 hq2
  rwa [← CFSG.SectionRank.pRank_top_eq_of_mulEquiv hq1.one_lt e] at h

end

