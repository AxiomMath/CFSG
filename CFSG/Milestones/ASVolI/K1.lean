open scoped Matrix in
private theorem burnsideKC_K32_three_one {V : Type} [CommGroup V] [Finite V] (hV : ∀ v : V, v ^
    2 = 1)
    {G L : Subgroup (MulAut V)} (hHyp : B4Hyp G L) (hq2 : qhatOf G ≤ ((2 : ℚ) : WithTop ℚ))
    (hZ : Subgroup.center ↥L = ⊥)
    (hmodel : StatedClassicalModel (↥L ⧸ Subgroup.center ↥L) .PSL 3 2 1) :
    BinaryNaturalSL L ⊤ ⊥ 3 1 ∧ G = L := by
  classical
  have hq1 : qhatOf G ≤ ((1 : ℚ) : WithTop ℚ) := asB45L32_holds V hV G L hHyp ⟨hZ, hmodel⟩ hq2
  obtain ⟨A, hA⟩ := burnsideKC_exists_offender hV hq1
  obtain ⟨eL⟩ := exists_gl32_of_model hZ hmodel
  have hV' : ∀ v : V, v * v = 1 := fun v => by rw [← pow_two]; exact hV v
  obtain ⟨W, _, _, _, ⟨θ⟩⟩ := exists_binModel_of_binary hV'
  have hirr := Bridge.TypeList.irr_of_isIrrSec hHyp.2.2.2
  have hntW : Nontrivial W := by
    obtain ⟨v, -, hv⟩ := IsConcreteLE.exists_of_lt hHyp.2.2.2.1
    replace hv : v ≠ 1 := fun h => hv (h ▸ Subgroup.one_mem _)
    refine ⟨⟨Multiplicative.toAdd (θ v), 0, fun h => hv ?_⟩⟩
    have h1 : θ v = 1 := Multiplicative.toAdd.injective (by simpa using h)
    simpa using congrArg θ.symm h1
  have hGL : G = L := eq_of_l32 θ hHyp hZ eL hA
  have hoffL : ∀ B, IsFFStarOffender G B → IsFFStarOffender L B := fun B hB => hGL ▸ hB
  obtain ⟨h3, -⟩ := l32_offender_data θ hirr eL (hoffL A hA)
  obtain ⟨π', hπ's, f, hf⟩ := exists_natural_l32 θ hirr eL h3
  refine ⟨?_, hGL⟩
  set Γ := StatedSL 3 (ZMod 2) with hΓ
  let π : ↥Γ →* ↥L := π'.comp Γ.subtype
  have hπ : Function.Surjective π := by
    intro l
    obtain ⟨g, rfl⟩ := hπ's l
    exact ⟨⟨g, Subgroup.subset_closure (det_eq_one_GL32 g)⟩, rfl⟩
  refine ⟨ZMod 2, inferInstance, inferInstance, by rw [Nat.card_zmod]; norm_num, π, ?_⟩
  exact G64.realizesVia_nat_of hπ bot_le (fun _ _ _ => trivial) (fun h z hz => by
    rw [Subgroup.mem_bot] at hz ⊢
    rw [hz, map_one]) (f.toMonoidHom.comp (⊤ : Subgroup V).subtype)
    (fun x => ⟨⟨f.symm x, trivial⟩, by simp⟩)
    (fun u => by
      rw [Subgroup.mem_bot]
      simp only [MonoidHom.comp_apply, Subgroup.coe_subtype, MulEquiv.coe_toMonoidHom,
        MulEquivClass.map_eq_one_iff])
    (fun γ u _ => hf (γ : GL32) u)

open CFSG.Quasithin CFSG.Quasithin.H Matrix in
private theorem burnsideKC_nine_model {V : Type} [CommGroup V] [Finite V] {L : Subgroup (MulAut V)}
    {s : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2] (hF : Nat.card F = 2 ^ (2 * s))
    {π : ↥(StatedSL 3 F) →* ↥L}
    (hπ : (FFModel.twistTensor s (StatedSL 3 F)).RealizesVia L ⊤ ⊥ π) :
    ∃ (hK : Nat.card F = (2 ^ s) ^ 2) (E : V ≃* L3Nine.HMod s F),
      (∀ γ : ↥(StatedSL 3 F), congrHom E ((π γ : ↥L) : MulAut V) =
        L3Nine.rhoT hK (γ : GL (Fin 3) F)) ∧
      L.map (congrHom E) = L3Nine.img hK := by
  classical
  have hK : Nat.card F = (2 ^ s) ^ 2 := by rw [hF, ← pow_mul, mul_comm]
  obtain ⟨E, hE⟩ := G64.RealizesVia.exists_secEquiv
    (D := FFModel.twistTensor s (StatedSL 3 F)) rfl hπ
  let E' : V ≃* L3Nine.HMod s F := E
  have hcπ : ∀ γ : ↥(StatedSL 3 F),
      congrHom E' ((π γ : ↥L) : MulAut V) = L3Nine.rhoT hK (γ : GL (Fin 3) F) := by
    intro γ
    refine MulEquiv.ext fun X => L3Nine.mat_injective ?_
    have h1 := hE γ (E'.symm X)
    have h2 : E (E'.symm X) = X := E'.apply_symm_apply X
    rw [h2] at h1
    rw [L3Nine.mat_rhoT, congrHom_apply]
    refine (congrArg Multiplicative.toAdd h1).trans ?_
    change ((γ : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) * L3Nine.mat X *
      (frobPow s ((γ : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F))ᵀ = _
    rw [L3Nine.frobPow_eq_conjM]
    rfl
  have hLmap : L.map (congrHom E') = L3Nine.img hK := by
    rw [L3Nine.img_eq_map]
    ext y
    constructor
    · rintro ⟨l, hl, rfl⟩
      obtain ⟨γ₀, hγ⟩ := hπ.1 ⟨l, hl⟩
      let γ : ↥(StatedSL 3 F) := γ₀
      refine ⟨(γ : GL (Fin 3) F), γ.2, ?_⟩
      rw [← hcπ γ]
      exact congrArg (fun z : ↥L => congrHom E' (z : MulAut V)) hγ
    · rintro ⟨A, hA, rfl⟩
      exact ⟨(π ⟨A, hA⟩ : ↥L), (π ⟨A, hA⟩).2, hcπ ⟨A, hA⟩⟩
  exact ⟨hK, E', hcπ, hLmap⟩


open CFSG.Quasithin CFSG.Quasithin.H Matrix in
private theorem burnsideKC_trivialOnDynkinVia_nine {V : Type} [CommGroup V] [Finite V]
    {G L : Subgroup (MulAut V)} (hLG : L ≤ G)
    (hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V))) {s : ℕ} (hs : 1 ≤ s) {F : Type}
    [Field F] [Finite F] [CharP F 2] (hF : Nat.card F = 2 ^ (2 * s))
    {π : ↥(StatedSL 3 F) →* ↥L}
    (hπ : (FFModel.twistTensor s (StatedSL 3 F)).RealizesVia L ⊤ ⊥ π) :
    ChIJK.TrivialOnDynkinVia G L (StatedSL 3 F) π := by
  classical
  obtain ⟨hK, E', hcπ, hLmap⟩ := burnsideKC_nine_model hF hπ
  refine ⟨hπ.1, fun g hg => ?_⟩
  have hĝ : congrHom E' g ∈ L3Nine.norm hK := by
    have h1 : (Subgroup.normalizer (L : Set (MulAut V))).map (congrHom E') =
        Subgroup.normalizer ((L.map (congrHom E') :
          Subgroup (MulAut (L3Nine.HMod s F))) : Set (MulAut (L3Nine.HMod s F))) :=
      Subgroup.map_equiv_normalizer_eq L (MulAut.congr E')
    rw [L3Nine.norm, ← hLmap, ← h1]
    exact ⟨g, hGN hg, rfl⟩
  obtain ⟨A, σ, hAσ⟩ := L3Nine.exists_eq_rhoT_mul_fldAut hs hK hĝ
  refine ⟨A, σ, fun x => ?_⟩
  obtain ⟨xSL, hxSL⟩ : ∃ z : SpecialLinearGroup (Fin 3) F,
      SpecialLinearGroup.toGL z = (x : GL (Fin 3) F) := by
    exact (CFSG.Open.StatedAPI.statedSL_eq_range_toGL 3 F).le x.2
  obtain ⟨ySL, hySL⟩ : ∃ y : SpecialLinearGroup (Fin 3) F, y =
      CFSG.ComponentClassification.CatalogueBHigherLinearAction.slConjugation 3 F A
        (SpecialLinearGroup.map σ.toRingHom xSL) := ⟨_, rfl⟩
  have hyG : SpecialLinearGroup.toGL ySL ∈ StatedSL 3 F := by
    rw [CFSG.Open.StatedAPI.statedSL_eq_range_toGL]
    exact ⟨ySL, rfl⟩
  refine ⟨⟨SpecialLinearGroup.toGL ySL, hyG⟩, ?_, ?_⟩
  · show ((SpecialLinearGroup.toGL ySL : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) = _
    rw [hySL, CFSG.ComponentClassification.CatalogueBHigherLinearAction.toGL_slConjugation,
      Units.val_mul, Units.val_mul, ← hxSL]
    rfl
  · apply congrHom_injective E'
    rw [map_mul, map_mul, map_inv, hcπ, hcπ, hAσ]
    have h4 := L3Nine.conj_rho_eq hK A σ xSL
    rw [← hySL] at h4
    rw [← hxSL]
    exact h4.symm

