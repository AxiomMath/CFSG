open Equiv Equiv.Perm in
def burnsideKA_kl : List (Perm (Fin 7)) :=
  [swap 0 1 * swap 2 3, swap 0 2 * swap 1 3, swap 0 3 * swap 1 2, 1]

open Equiv Equiv.Perm in
private theorem burnsideKA_fs : ∀ a b c d : Fin 7, (a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ c ≠ d) →
    ((swap a b * swap c d ∈ burnsideKA_kl ∧ swap a c * swap b d ∈ burnsideKA_kl ∧
        swap a d * swap b c ∈ burnsideKA_kl) ∨
      ∃ k₁ ∈ burnsideKA_kl, ∃ k₂ ∈ [swap a b * swap c d, swap a c * swap b d, swap a d * swap b c],
        (k₁ * k₂) ^ 2 ≠ 1 ∧ (k₁ * k₂) ^ 6 = 1) := by
  unfold burnsideKA_kl
  decide +kernel

open Equiv Equiv.Perm in
private theorem burnsideKA_kl_mul : ∀ a ∈ burnsideKA_kl, ∀ b ∈ burnsideKA_kl, a * b ∈
    burnsideKA_kl := by
  intro a ha b hb
  simp only [burnsideKA_kl, List.mem_cons, List.not_mem_nil, or_false] at ha hb ⊢
  rcases ha with rfl | rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl | rfl <;>
    decide +kernel

open Equiv Equiv.Perm in
private theorem burnsideKA_kl_sq : ∀ a ∈ burnsideKA_kl, a * a = 1 := by
  intro a ha
  simp only [burnsideKA_kl, List.mem_cons, List.not_mem_nil, or_false] at ha
  rcases ha with rfl | rfl | rfl | rfl <;> decide +kernel

open CFSG.Quasithin Equiv Equiv.Perm in
private theorem burnsideKA_mem_kleinRegular7 (x : Perm (Fin 7)) : x ∈ kleinRegular7 ↔ x ∈
    burnsideKA_kl := by
  constructor
  · intro hx
    let KS : Subgroup (Perm (Fin 7)) :=
      { carrier := {x | x ∈ burnsideKA_kl}
        mul_mem' := fun {a b} ha hb => burnsideKA_kl_mul a ha b hb
        one_mem' := by simp [burnsideKA_kl]
        inv_mem' := fun {a} ha => by
          have : a⁻¹ = a := inv_eq_of_mul_eq_one_right (burnsideKA_kl_sq a ha)
          show a⁻¹ ∈ burnsideKA_kl
          rw [this]
          exact ha }
    have hle : kleinRegular7 ≤ KS := by
      unfold kleinRegular7
      rw [Subgroup.closure_le]
      rintro y (rfl | rfl)
      · simp [KS, burnsideKA_kl]
      · simp [KS, burnsideKA_kl]
    exact hle hx
  · intro hx
    have ha : swap (0 : Fin 7) 1 * swap 2 3 ∈ kleinRegular7 := Subgroup.subset_closure (by simp)
    have hb : swap (0 : Fin 7) 2 * swap 1 3 ∈ kleinRegular7 := Subgroup.subset_closure (by simp)
    have hab : swap (0 : Fin 7) 3 * swap 1 2 = (swap 0 1 * swap 2 3) * (swap 0 2 * swap 1 3) := by
      decide +kernel
    simp only [burnsideKA_kl, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact ha
    · exact hb
    · rw [hab]
      exact kleinRegular7.mul_mem ha hb
    · exact one_mem _

open CFSG.Quasithin Equiv Equiv.Perm in
private theorem burnsideKA_alt7_perm {Q P P' : Subgroup ↥(alternatingGroup (Fin 7))}
    (hQ : IsPGroup 2 ↥Q) (hPQ : P ≤ Q) (hP'Q : P' ≤ Q)
    (hP : AltConjTo 7 P kleinRegular7) (hP' : AltConjTo 7 P' kleinRegular7) : P = P' := by
  classical
  obtain ⟨c, hcA, hPc⟩ := hP
  obtain ⟨c', hc'A, hP'c'⟩ := hP'
  set τ : Perm (Fin 7) := c⁻¹ * c' with hτ
  have hc'τ : c' = c * τ := by rw [hτ]; group
  have hd : τ 0 ≠ τ 1 ∧ τ 0 ≠ τ 2 ∧ τ 0 ≠ τ 3 ∧ τ 1 ≠ τ 2 ∧ τ 1 ≠ τ 3 ∧ τ 2 ≠ τ 3 :=
    ⟨τ.injective.ne (by decide), τ.injective.ne (by decide), τ.injective.ne (by decide),
      τ.injective.ne (by decide), τ.injective.ne (by decide), τ.injective.ne (by decide)⟩
  have hconj1 : τ * (swap 0 1 * swap 2 3) * τ⁻¹ = swap (τ 0) (τ 1) * swap (τ 2) (τ 3) := by
    calc τ * (swap 0 1 * swap 2 3) * τ⁻¹ = (τ * swap 0 1 * τ⁻¹) * (τ * swap 2 3 * τ⁻¹) := by
          group
      _ = _ := by rw [← swap_apply_apply, ← swap_apply_apply]
  have hconj2 : τ * (swap 0 2 * swap 1 3) * τ⁻¹ = swap (τ 0) (τ 2) * swap (τ 1) (τ 3) := by
    calc τ * (swap 0 2 * swap 1 3) * τ⁻¹ = (τ * swap 0 2 * τ⁻¹) * (τ * swap 1 3 * τ⁻¹) := by
          group
      _ = _ := by rw [← swap_apply_apply, ← swap_apply_apply]
  have hconj3 : τ * (swap 0 3 * swap 1 2) * τ⁻¹ = swap (τ 0) (τ 3) * swap (τ 1) (τ 2) := by
    calc τ * (swap 0 3 * swap 1 2) * τ⁻¹ = (τ * swap 0 3 * τ⁻¹) * (τ * swap 1 2 * τ⁻¹) := by
          group
      _ = _ := by rw [← swap_apply_apply, ← swap_apply_apply]
  have hKl : ∀ k ∈ burnsideKA_kl, k = swap 0 1 * swap 2 3 ∨ k = swap 0 2 * swap 1 3 ∨
      k = swap 0 3 * swap 1 2 ∨ k = 1 := by
    intro k hk
    simpa [burnsideKA_kl] using hk
  rcases burnsideKA_fs (τ 0) (τ 1) (τ 2) (τ 3) hd with ⟨hg1, hg2, hg3⟩ | ⟨k₁, hk₁, k₂, hk₂, h2, h6⟩
  ·
    have hgood : ∀ k ∈ burnsideKA_kl, τ * k * τ⁻¹ ∈ burnsideKA_kl := by
      intro k hk
      rcases hKl k hk with rfl | rfl | rfl | rfl
      · rw [hconj1]; exact hg1
      · rw [hconj2]; exact hg2
      · rw [hconj3]; exact hg3
      · simp [burnsideKA_kl]
    have hle : kleinRegular7.map (MulAut.conj c').toMonoidHom ≤
        kleinRegular7.map (MulAut.conj c).toMonoidHom := by
      intro x hx
      obtain ⟨k, hk, rfl⟩ := Subgroup.mem_map.1 hx
      refine Subgroup.mem_map.2 ⟨τ * k * τ⁻¹, (burnsideKA_mem_kleinRegular7 _).2
        (hgood k ((burnsideKA_mem_kleinRegular7 k).1 hk)), ?_⟩
      rw [hc'τ]
      simp [MulAut.conj_apply, mul_assoc]
    have heq : kleinRegular7.map (MulAut.conj c').toMonoidHom =
        kleinRegular7.map (MulAut.conj c).toMonoidHom := by
      refine le_antisymm hle (Subgroup.eq_of_le_of_card_ge hle ?_).ge
      rw [Subgroup.card_map_of_injective (MulAut.conj c).injective,
        Subgroup.card_map_of_injective (MulAut.conj c').injective]
    exact Subgroup.map_injective (alternatingGroup (Fin 7)).subtype_injective
      (hPc.trans (heq.symm.trans hP'c'.symm))
  ·
    exfalso
    obtain ⟨k₂', hk₂', hk₂eq⟩ : ∃ k₂' ∈ burnsideKA_kl, k₂ = τ * k₂' * τ⁻¹ := by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hk₂
      rcases hk₂ with rfl | rfl | rfl
      · exact ⟨swap 0 1 * swap 2 3, by simp [burnsideKA_kl], hconj1.symm⟩
      · exact ⟨swap 0 2 * swap 1 3, by simp [burnsideKA_kl], hconj2.symm⟩
      · exact ⟨swap 0 3 * swap 1 2, by simp [burnsideKA_kl], hconj3.symm⟩
    have hx : c * k₁ * c⁻¹ ∈ kleinRegular7.map (MulAut.conj c).toMonoidHom :=
      Subgroup.mem_map.2 ⟨k₁, (burnsideKA_mem_kleinRegular7 _).2 hk₁, by simp [MulAut.conj_apply]⟩
    have hy : c' * k₂' * c'⁻¹ ∈ kleinRegular7.map (MulAut.conj c').toMonoidHom :=
      Subgroup.mem_map.2 ⟨k₂', (burnsideKA_mem_kleinRegular7 _).2 hk₂', by simp [MulAut.conj_apply]⟩
    rw [← hPc] at hx
    rw [← hP'c'] at hy
    obtain ⟨p, hp, hpx⟩ := hx
    obtain ⟨p', hp', hpy⟩ := hy
    obtain ⟨m, hm⟩ := hQ ⟨p * p', Q.mul_mem (hPQ hp) (hP'Q hp')⟩
    have hm' : ((p : Perm (Fin 7)) * (p' : Perm (Fin 7))) ^ (2 ^ m) = 1 := by
      have := congrArg (fun q : ↥Q => (((q : ↥(alternatingGroup (Fin 7))) : Perm (Fin 7)))) hm
      simpa using this
    have hpx' : (p : Perm (Fin 7)) = c * k₁ * c⁻¹ := hpx
    have hpy' : (p' : Perm (Fin 7)) = c' * k₂' * c'⁻¹ := hpy
    have hprod : (p : Perm (Fin 7)) * (p' : Perm (Fin 7)) = c * (k₁ * k₂) * c⁻¹ := by
      rw [hpx', hpy', hk₂eq, hc'τ]
      group
    rw [hprod, conj_pow] at hm'
    have hz : (k₁ * k₂) ^ (2 ^ m) = 1 := by
      have h1 : c * (k₁ * k₂) ^ (2 ^ m) * c⁻¹ = 1 := hm'
      calc (k₁ * k₂) ^ (2 ^ m) = c⁻¹ * (c * (k₁ * k₂) ^ (2 ^ m) * c⁻¹) * c := by group
        _ = 1 := by rw [h1]; group
    have hdvd6 : orderOf (k₁ * k₂) ∣ 6 := orderOf_dvd_of_pow_eq_one h6
    have hdvd2m : orderOf (k₁ * k₂) ∣ 2 ^ m := orderOf_dvd_of_pow_eq_one hz
    have hcop : Nat.Coprime (orderOf (k₁ * k₂)) 3 :=
      Nat.Coprime.coprime_dvd_left hdvd2m (Nat.Coprime.pow_left m (by norm_num))
    have hdvd2 : orderOf (k₁ * k₂) ∣ 2 :=
      Nat.Coprime.dvd_of_dvd_mul_right hcop (by simpa using hdvd6)
    exact h2 (orderOf_dvd_iff_pow_eq_one.1 hdvd2)

open Equiv Equiv.Perm CFSG.QuasithinUnique.Setup.X3E CFSG.QuasithinUnique.Setup.X3 CFSG.Quasithin.B45Alt7 CFSG.Quasithin in
private theorem burnsideKA_four_of_block {V : Type} [CommGroup V] [Finite V]
    [Module (ZMod 2) (Additive V)] {L : Subgroup (MulAut V)} (ι : ↥L ≃* A7) {i : ℕ} (hi : i < 2)
    (Ψ : Vec 4 ≃ₗ[ZMod 2] Additive V)
    (hΨ : ∀ b s, Ψ (lin 4 (indBlk true i b) s) = rho7 ι (gen7 b) (Ψ s)) :
    Nat.card V = 2 ^ 4 ∧ ∃ E : Subgroup (MulAut V), E ≤ L ∧ IsElemAbelian2 E ∧ Nat.card E = 4 ∧
      Nat.card V ≤ 4 * Nat.card (fixV E) := by
  refine ⟨?_, exists_four_offender ι hi Ψ hΨ⟩
  have h1 : Nat.card (Vec 4) = Nat.card (Additive V) := Nat.card_congr Ψ.toEquiv
  have h2 : Nat.card (Additive V) = Nat.card V := rfl
  rw [← h2, ← h1, Nat.card_fun, Nat.card_zmod, Nat.card_eq_fintype_card (α := Fin 4),
    Fintype.card_fin]

open Equiv Equiv.Perm CFSG.QuasithinUnique.Setup.X3E CFSG.QuasithinUnique.Setup.X3 CFSG.Quasithin.B45Alt7 CFSG.Quasithin in
private theorem burnsideKA_four_of_conj {V : Type} [CommGroup V] [Finite V]
    [Module (ZMod 2) (Additive V)] {L : Subgroup (MulAut V)} (ι : ↥L ≃* A7) {i r : ℕ}
    (h : (i, r) ∈ [(5, 0), (8, 0), (6, 2), (10, 2)]) (c : Bool) (hrc : rB c = r)
    (hirr : ∀ J : Subgroup V, (∀ l ∈ L, ∀ v ∈ J, l v ∈ J) → J = ⊥ ∨ J = ⊤)
    (hcard : Nat.card V ≤ 2 ^ 12) {ψ : Vec 4 →ₗ[ZMod 2] Additive V} (hψi : Function.Injective ψ)
    (hψ : ∀ b s, ψ (lin 4 (blkOf i b) s) = sigma6 ι (gen b) (ψ s)) :
    Nat.card V = 2 ^ 4 ∧ ∃ E : Subgroup (MulAut V), E ≤ L ∧ IsElemAbelian2 E ∧ Nat.card E = 4 ∧
      Nat.card V ≤ 4 * Nat.card (fixV E) := by
  have hψ' : ∀ b s, (ψ.comp (lin 4 (indQ i))) (lin 4 (blkOf (rB c) b) s) =
      sigma6 ι (gen b) ((ψ.comp (lin 4 (indQ i))) s) := by
    intro b s
    simp only [LinearMap.comp_apply]
    rw [hrc, ← lin_conj h, hψ]
  have hinj : Function.Injective (ψ.comp (lin 4 (indQ i))) := by
    intro s s' hs
    have h1 := hψi hs
    have h2 := congrArg (lin 4 (indP i)) h1
    rwa [lin_PQ h, lin_PQ h] at h2
  obtain ⟨j, hj, Ψ, hΨ⟩ := exists_four_block ι hirr hcard c hinj hψ'
  exact burnsideKA_four_of_block ι hj Ψ hΨ

open Equiv Equiv.Perm CFSG.QuasithinUnique.Setup.X3E CFSG.QuasithinUnique.Setup.X3 CFSG.Quasithin.B45Alt7 CFSG.Quasithin in
private theorem burnsideKA_classify {V : Type} [CommGroup V] [Finite V] [Module (ZMod 2)
    (Additive V)]
    {L : Subgroup (MulAut V)} (ι : ↥L ≃* A7)
    (hirr : ∀ J : Subgroup V, (∀ l ∈ L, ∀ v ∈ J, l v ∈ J) → J = ⊥ ∨ J = ⊤)
    (hfix : fixV L = ⊥) (hcard : Nat.card V ≤ 2 ^ 12) :
    (∃ β : V ≃* ↥(G6.coreMod 7), ∀ (γ : A7) (s : V),
      (β ((ι.symm γ : MulAut V) s) : G6.PermMod 7) = G6.permAct 7 (γ : Perm (Fin 7)) (β s)) ∨
    (Nat.card V = 2 ^ 4 ∧ ∃ E : Subgroup (MulAut V), E ≤ L ∧ IsElemAbelian2 E ∧ Nat.card E = 4 ∧
      Nat.card V ≤ 4 * Nat.card (fixV E)) := by
  classical
  have hne : (⊤ : Submodule (ZMod 2) (Additive V)) ≠ ⊥ := by
    intro h
    have hall : ∀ v : V, v = 1 := fun v => by
      have : Additive.ofMul v ∈ (⊤ : Submodule (ZMod 2) (Additive V)) := trivial
      rw [h, Submodule.mem_bot] at this
      exact this
    have h1 : ((ι.symm (gen7 false) : ↥L) : MulAut V) = 1 :=
      MulEquiv.ext fun v => (hall _).trans (hall v).symm
    have h2 : ι.symm (gen7 false) = 1 := Subtype.ext h1
    have h3 : gen7 false = 1 := by
      have := congrArg ι h2
      rwa [MulEquiv.apply_symm_apply, map_one] at this
    exact absurd h3 (by decide)
  obtain ⟨i, hi, ψ, hψi, hψ⟩ := exists_block_emb (sigma6 ι) hne
  have hone : ∀ (hi1 : i = 1 ∨ i = 3 ∨ i = 4 ∨ i = 7 ∨ i = 9),
      (∃ β : V ≃* ↥(G6.coreMod 7), ∀ (γ : A7) (s : V),
        (β ((ι.symm γ : MulAut V) s) : G6.PermMod 7) =
          G6.permAct 7 (γ : Perm (Fin 7)) (β s)) := by
    intro hi1
    have hd : eNs.getD (i + 1) 0 - eNs.getD i 0 = 1 := by
      rcases hi1 with rfl | rfl | rfl | rfl | rfl <;> decide
    set e0 : Vec (eNs.getD (i + 1) 0 - eNs.getD i 0) := Pi.single ⟨0, by omega⟩ 1 with he0
    have hv0 : ψ e0 ≠ 0 := by
      intro h
      have h1 : e0 = 0 := hψi (h.trans (map_zero ψ).symm)
      have h2 := congrFun h1 ⟨0, by omega⟩
      simp [he0] at h2
    refine exists_coreEquiv ι hirr hfix hv0 fun b => ?_
    have := hψ b e0
    rw [blkOf_one hi1, lin_one hd] at this
    exact this.symm
  interval_cases i
  · obtain ⟨j, hj, Ψ, hΨ⟩ := exists_four_block ι hirr hcard false hψi hψ
    exact Or.inr (burnsideKA_four_of_block ι hj Ψ hΨ)
  · exact Or.inl (hone (by omega))
  · obtain ⟨j, hj, Ψ, hΨ⟩ := exists_four_block ι hirr hcard true hψi hψ
    exact Or.inr (burnsideKA_four_of_block ι hj Ψ hΨ)
  · exact Or.inl (hone (by omega))
  · exact Or.inl (hone (by omega))
  · exact Or.inr (burnsideKA_four_of_conj (r := 0) ι (by simp) false (by decide) hirr hcard hψi hψ)
  · exact Or.inr (burnsideKA_four_of_conj (r := 2) ι (by simp) true (by decide) hirr hcard hψi hψ)
  · exact Or.inl (hone (by omega))
  · exact Or.inr (burnsideKA_four_of_conj (r := 0) ι (by simp) false (by decide) hirr hcard hψi hψ)
  · exact Or.inl (hone (by omega))
  · exact Or.inr (burnsideKA_four_of_conj (r := 2) ι (by simp) true (by decide) hirr hcard hψi hψ)
  · exfalso
    have h1 : Nat.card (Vec (eNs.getD (11 + 1) 0 - eNs.getD 11 0)) ≤ Nat.card (Additive V) :=
      Nat.card_le_card_of_injective ψ hψi
    have h16 : eNs.getD (11 + 1) 0 - eNs.getD 11 0 = 16 := by decide
    rw [h16, Nat.card_fun, Nat.card_zmod, Nat.card_eq_fintype_card (α := Fin 16),
      Fintype.card_fin] at h1
    have h2 : Nat.card (Additive V) = Nat.card V := rfl
    rw [h2] at h1
    have := h1.trans hcard
    norm_num at this

open CFSG.ASVolI.ChIJK CFSG.Quasithin in
