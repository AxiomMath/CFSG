@[expose] def K_0_star : Prop :=
  ∀ (V : Type) [CommGroup V] [Finite V], (∀ v : V, v ^ 2 = 1) →
    ∀ G : Subgroup (MulAut V), ∀ A : Subgroup (MulAut V), IsA2 G A →
      (rkIdx (fixV A) : ℚ) = rAV A * (rk ↥A : ℚ) ∧ (rAV A < (E3.mParam G : ℚ) → 1 < rk ↥A)

theorem as_K_0_star : K_0_star := by
  intro V _ _ hV G A hA
  refine ⟨(hA.rAV_mul).symm, fun hlt => ?_⟩
  have hpos := hA.rk_pos
  by_contra hle
  have h1 : rk ↥A = 1 := by omega
  have hcard : Nat.card ↥A = 2 := by
    have := card_eq_two_pow_of_isPGroup hA.isElemAbelian2.isPGroup
    rw [this, h1]; norm_num
  obtain ⟨a, haA, ha1⟩ : ∃ a ∈ A, a ≠ 1 := by
    by_contra hcon
    push Not at hcon
    exact hA.ne_bot ((Subgroup.eq_bot_iff_forall A).2 hcon)
  have hord : orderOf a = 2 := by
    have hdvd : orderOf a ∣ 2 := hcard ▸ Subgroup.orderOf_dvd_natCard A haA
    rcases (Nat.dvd_prime Nat.prime_two).1 hdvd with h | h
    · exact absurd (orderOf_eq_one_iff.1 h) ha1
    · exact h
  have hzA : Subgroup.zpowers a = A := by
    refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.2 haA) ?_
    rw [Nat.card_zpowers, hord, hcard]
  have hEven : Even (Nat.card ↥G) := by
    have := Subgroup.card_dvd_of_le hA.le
    rw [hcard] at this
    exact even_iff_two_dvd.2 this
  have hm : E3.mParam G ≤ rkIdx (fixV A) := by
    unfold E3.mParam
    simp only [hEven, ↓reduceIte]
    exact Nat.sInf_le ⟨a, hA.le haA, hord, by rw [hzA]⟩
  have hmq : (E3.mParam G : ℚ) ≤ (rkIdx (fixV A) : ℚ) := by exact_mod_cast hm
  have hr : rAV A * (rk ↥A : ℚ) = (rkIdx (fixV A) : ℚ) := hA.rAV_mul
  rw [h1] at hr
  simp at hr
  linarith

@[expose] def K_0_overview : Prop :=
  ∀ (V : Type) [CommGroup V] [Finite V], (∀ v : V, v ^ 2 = 1) →
    ∀ G : Subgroup (MulAut V),
      qhatOf G ≤ qOf G ∧ (IsFFModule G → qOf G ≤ qc 1) ∧ (qhatOf G ≤ qc 1 → qOf G ≤ qc 1)

theorem as_K_0_overview : K_0_overview := by
  intro V _ _ hV G
  have hFF : IsFFModule G → qOf G ≤ qc 1 := by
    intro h
    have := ((B1_4_5 hV G).out 1 3).1 h
    simpa [qc] using this
  refine ⟨qhatOf_le_qOf G, hFF, fun h => hFF ?_⟩
  have h1 : kq G 3 ≤ ((1 : ℚ) : WithTop ℚ) := h
  obtain ⟨A, hA, -, hr⟩ := kq_le_iff.1 h1
  exact (isFFModule_iff hV).2 ⟨A, hA, hr⟩

@[expose] def K_1 : Prop :=
  ∀ (V : Type) [CommGroup V] [Finite V] (G L : Subgroup (MulAut V)), KSetup V G L →
    (IsAlt 6 (Lbar L) ∨ IsAlt 7 (Lbar L)) →
    (IsAlt 6 ↥L ∨ IsHat ↥L ↥(alternatingGroup (Fin 6)) ∨ IsAlt 7 ↥L) ∧
    ((AlternatingNatural L ⊤ ⊥ 6 ∨ AlternatingNatural L ⊤ ⊥ 7) →
      (∀ A, IsFFStarOffender G A → B42Case3 G L ∨ B42Case5 G A ∨ B42Case6 G L A) ∧
      ((AlternatingNatural L ⊤ ⊥ 7 ∧ G = L) →
        qOf G = qc (3 / 2) ∧ qhatOf G = qc (3 / 2)))

section BurnsideKA

private theorem burnsideKA_center_of_isAlt {L : Type} [Group L] {n : ℕ} (hn : 4 ≤ n)
    (h : Nonempty (L ≃* alternatingGroup (Fin n))) :
    Subgroup.center L = ⊥ ∧ Nonempty ((L ⧸ Subgroup.center L) ≃* alternatingGroup (Fin n)) := by
  obtain ⟨e⟩ := h
  have h4 : 4 ≤ Nat.card (Fin n) := by rw [Nat.card_eq_fintype_card, Fintype.card_fin]; exact hn
  have hc := alternatingGroup.center_eq_bot h4
  have hcL : Subgroup.center L = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    have hx' : e x ∈ Subgroup.center (alternatingGroup (Fin n)) := by
      rw [Subgroup.mem_center_iff] at hx ⊢
      intro g
      obtain ⟨y, rfl⟩ := e.surjective g
      rw [← map_mul, ← map_mul, hx y]
    rw [hc, Subgroup.mem_bot] at hx'
    rw [Subgroup.mem_bot]
    exact e.injective (by rw [hx', map_one])
  refine ⟨hcL, ⟨?_⟩⟩
  exact ((QuotientGroup.quotientMulEquivOfEq hcL).trans QuotientGroup.quotientBot).trans e

open CFSG.ASVolI.ChIJK CFSG.Quasithin in
private theorem burnsideKA_typeAlt6_of_isAlt {L : Type} [Group L] (h : IsAlt 6 L) : B42TypeAlt6 L :=
  burnsideKA_center_of_isAlt (by norm_num) h

open CFSG.ASVolI.ChIJK CFSG.Quasithin CFSG.QuasithinUnique in
private theorem burnsideKA_alt6_model {V : Type} [CommGroup V] [Finite V] {G L : Subgroup
    (MulAut V)}
    (hK : KSetup V G L) (hL : IsAlt 6 ↥L) : Nonempty (B42Alt6.N6Model L) := by
  have hT := burnsideKA_typeAlt6_of_isAlt hL
  have C := B42Alt6.ctx_of_b4Hyp hK.hyp hT
  have hirr : XMod.IsIrrSec ↥L (⊥ : Subgroup V) ⊤ := hK.hyp.2.2.2
  have hS2 : ∀ s : V, s * s = 1 := fun s => by simpa [pow_two] using hK.elem2 s
  obtain ⟨A, hA, -, hidx⟩ := B45Alt.exists_cubic_of_qhatOf_le_two hK.elem2 hK.qhat
  obtain ⟨r, m, hr, -, -, hmr, hle⟩ := B42Alt6.card_le_index_pow C hirr hA.1 hA.2.1 hA.2.2
  have hlt : Nat.card V < 2 ^ 16 := by
    calc Nat.card V ≤ (fixV A).index ^ m := hle
      _ ≤ (Nat.card A ^ 2) ^ m := Nat.pow_le_pow_left hidx m
      _ = 2 ^ (2 * (m * r)) := by rw [hr, ← pow_mul, ← pow_mul]; ring_nf
      _ ≤ 2 ^ 12 := Nat.pow_le_pow_right (by norm_num) (by omega)
      _ < 2 ^ 16 := by norm_num
  exact B45Alt6.exists_n6Model_of_lt hS2 C hirr hlt

open CFSG.ASVolI.ChIJK CFSG.Quasithin CFSG.QuasithinUnique in
private theorem burnsideKA_alt6_cases {V : Type} [CommGroup V] [Finite V] {G L : Subgroup
    (MulAut V)}
    (hV : ∀ v : V, v ^ 2 = 1) (hB : B4Hyp G L) (hT : B42TypeAlt6 ↥L) (M : B42Alt6.N6Model L)
    {A : Subgroup (MulAut V)} (hA : IsFFStarOffender G A) : B42Case3 G L ∨ B42Case6 G L A := by
  have C := B42Alt6.ctx_of_b4Hyp hB hT
  have hirr : XMod.IsIrrSec ↥L (⊥ : Subgroup V) ⊤ := hB.2.2.2
  have hS2 : ∀ s : V, s * s = 1 := fun s => by simpa [pow_two] using hV s
  obtain ⟨ι⟩ := C.iso
  have hGρ : ∀ g ∈ G, ∃ σ, M.ρ σ = g := by
    intro g hg
    refine M.le_range hS2 ι ?_
    rw [Subgroup.mem_normalizer_iff]
    intro l
    refine ⟨fun hl => C.normal g hg l hl, fun hl => ?_⟩
    have := C.normal g⁻¹ (G.inv_mem hg) _ hl
    simpa [mul_assoc] using this
  by_cases hGL : G ≤ L
  · have hGL' : G = L := le_antisymm hGL C.le_G
    exact Or.inr (B42Alt6.case6 hV C hirr M hGL' hA)
  · obtain ⟨g, hg, hgL⟩ := Set.not_subset.1 hGL
    obtain ⟨σ₀, rfl⟩ := hGρ g hg
    have hσ₀ : σ₀ ∉ alternatingGroup (Fin 6) := fun h => hgL (M.ρ_mem_L h)
    have hG : ∀ σ, M.ρ σ ∈ G := by
      intro σ
      by_cases hσ : σ ∈ alternatingGroup (Fin 6)
      · exact C.le_G (M.ρ_mem_L hσ)
      · have h1 : σ * σ₀⁻¹ ∈ alternatingGroup (Fin 6) := by
          rw [Equiv.Perm.mem_alternatingGroup] at hσ hσ₀ ⊢
          rw [map_mul, map_inv]
          rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h
          · exact absurd h hσ
          rcases Int.units_eq_one_or (Equiv.Perm.sign σ₀) with h' | h'
          · exact absurd h' hσ₀
          rw [h, h']
          decide
        have h2 : σ = σ * σ₀⁻¹ * σ₀ := by group
        rw [h2, map_mul]
        exact G.mul_mem (C.le_G (M.ρ_mem_L h1)) hg
    exact Or.inl (B42Alt6.case3 hV C hirr M hG hGρ)


open CFSG.ASVolI.ChIJK CFSG.Quasithin CFSG.QuasithinUnique in
private theorem burnsideKA_hatA6_offender {V : Type} [CommGroup V] [Finite V] {G L : Subgroup
    (MulAut V)}
    (hK : KSetup V G L) (hP : B42TypeHatA6 ↥L) : ∃ A, IsFFStarOffender G A := by
  have h1 : qhatOf G ≤ ((1 : ℚ) : WithTop ℚ) :=
    asB45HatA6_holds V hK.elem2 G L hK.hyp hP hK.qhat
  exact B6.exists_isFFStarOffender (isFFModule_of_qhatOf_le_one hK.elem2 h1)

open CFSG.ASVolI.ChIJK CFSG.Quasithin CFSG.QuasithinUnique CFSG.Open CFSG.CharacterTheory.SteinbergBY CFSG.Quasithin.HatA6 in
private theorem burnsideKA_hatA6_case8 {V : Type} [CommGroup V] [Finite V] {G L A : Subgroup
    (MulAut V)}
    (hV : ∀ v : V, v ^ 2 = 1) (hHyp : B4Hyp G L) (hP : B42TypeHatA6 ↥L)
    (hA : IsFFStarOffender G A) : B42Case8 G L A := by
  have hcard := card_V hV hHyp hP hA
  have hfacts := fun B (hB : IsFFStarOffender G B) => offender_facts hV hHyp hP hB
