open CFSG.Quasithin CFSG.Quasithin.B42Ln in
private theorem burnsideKC_wedge4_of_card {V : Type} [CommGroup V] [Finite V]
    [Module (ZMod 2) (Additive V)] {G L : Subgroup (MulAut V)} (hHyp : B4HypCore G L)
    (e : ↥L ≃* ↥(StatedSL 4 (ZMod 2))) (hcard : Nat.card V = 2 ^ 6) :
    ∃ β : Additive V ≃ₗ[ZMod 2] (Fin 6 → ZMod 2),
      ∀ g w, β (repOf4 (phiOf4 e) g w) = wedgeRep4' g (β w) := by
  classical
  have : Nontrivial V := nontrivial_of_equiv4 e
  have hρ : SmithCurtis.IsSimpleRep (repOf4 (phiOf4 e)) :=
    isSimpleRep_repOf4 (phiOf4 e) (irr_of_isIrrSec hHyp.2.2)
  have hdim : Module.finrank (ZMod 2) (Additive V) = 6 := by
    have h := card_eq_two_pow_finrank (V := V)
    rw [hcard] at h
    exact (Nat.pow_right_injective le_rfl h).symm
  rcases l4Model_of_finrank_lt hρ (by omega) with htriv | ⟨κ, β, hβ⟩ | ⟨β, hβ⟩
  · exact (not_trivial4 e htriv).elim
  · exfalso
    have h4 : Nat.card V = 2 ^ 4 := by
      rw [show Nat.card V = Nat.card (Additive V) from rfl, Nat.card_congr β.toEquiv,
        Nat.card_eq_fintype_card, Fintype.card_fun, ZMod.card]
      rfl
    rw [hcard] at h4
    omega
  · exact ⟨β, hβ⟩

open CFSG.Quasithin CFSG.Quasithin.B42Ln CFSG.Quasithin.JonesParshall CFSG.Quasithin.JonesParshall.Curtis in
private theorem burnsideKC_wedge5_of_card
    {V : Type} [CommGroup V] [Finite V]
    [Module (ZMod 2) (Additive V)] {L : Subgroup (MulAut V)}
    (hirr : XMod.IsIrrSec ↥L (⊥ : Subgroup V) ⊤)
    (e : ↥L ≃* ↥(StatedSL 5 (ZMod 2))) (hcard : Nat.card V = 2 ^ 10) :
    ∃ (κ : G5 ≃* G5) (β : Additive V ≃ₗ[ZMod 2] (Fin 10 → ZMod 2)),
      ∀ g w, β (repOf (phiOf e) g w) = wedgeRep (κ g) (β w) := by
  classical
  have : Nontrivial V := nontrivial_of_equiv e
  have hρ : IsSimpleRep (repOf (phiOf e)) := isSimpleRep_repOf (phiOf e) (irr_of_isIrrSec hirr)
  have hdim : Module.finrank (ZMod 2) (Additive V) = 10 := by
    have h := card_eq_two_pow_finrank (V := V)
    rw [hcard] at h
    exact (Nat.pow_right_injective le_rfl h).symm
  rcases l5Model_of_finrank_le hρ (by omega) with htriv | ⟨κ, β, hβ⟩ | ⟨κ, β, hβ⟩
  · exact (not_trivial e htriv).elim
  · exfalso
    have h5 : Nat.card V = 2 ^ 5 := by
      rw [show Nat.card V = Nat.card (Additive V) from rfl, Nat.card_congr β.toEquiv,
        Nat.card_eq_fintype_card, Fintype.card_fun, ZMod.card]
      rfl
    rw [hcard] at h5
    omega
  · exact ⟨κ, β, hβ⟩

open CFSG.Quasithin CFSG.Quasithin.B42Ln CFSG.Quasithin.JonesParshall CFSG.Quasithin.JonesParshall.Curtis in
private theorem burnsideKC_endIsF2_wedge5
    {V : Type} [CommGroup V] [Finite V] [Module (ZMod 2) (Additive V)] {L : Subgroup (MulAut V)}
    (e : ↥L ≃* ↥(StatedSL 5 (ZMod 2))) {κ : G5 ≃* G5}
    {β : Additive V ≃ₗ[ZMod 2] (Fin 10 → ZMod 2)}
    (hβ : ∀ g w, β (repOf (phiOf e) g w) = wedgeRep (κ g) (β w)) : ChIJK.EndIsF2 L := by
  classical
  intro φ hφ
  let ψa : (Fin 10 → ZMod 2) →+ (Fin 10 → ZMod 2) :=
    β.toAddEquiv.toAddMonoidHom.comp
      ((MonoidHom.toAdditive φ).comp β.symm.toAddEquiv.toAddMonoidHom)
  let ψ : (Fin 10 → ZMod 2) →ₗ[ZMod 2] (Fin 10 → ZMod 2) := AddMonoidHom.toZModLinearMap 2 ψa
  have hψ : ∀ x, ψ x = β (Additive.ofMul (φ (Additive.toMul (β.symm x)))) := fun x => rfl
  have h2 : ∀ v : V, ψ (β (Additive.ofMul v)) = β (Additive.ofMul (φ v)) := by
    intro v
    rw [hψ, LinearEquiv.symm_apply_apply, toMul_ofMul]
  have hcomm : ∀ (g : G5) (x : Fin 10 → ZMod 2), ψ (wedgeRep g x) = wedgeRep g (ψ x) := by
    intro g x
    obtain ⟨g₀, rfl⟩ := κ.surjective g
    have h3 : ∀ v : V, wedgeRep (κ g₀) (β (Additive.ofMul v)) =
        β (Additive.ofMul ((((phiOf e).symm g₀ : ↥L) : MulAut V) v)) := by
      intro v
      rw [← hβ g₀ (Additive.ofMul v), repOf_apply]
    have hx : x = β (Additive.ofMul (Additive.toMul (β.symm x))) := by
      rw [ofMul_toMul, LinearEquiv.apply_symm_apply]
    generalize Additive.toMul (β.symm x) = v at hx
    subst hx
    rw [h3, h2, h2, h3]
    congr 2
    exact hφ _ ((phiOf e).symm g₀).2 v
  have hy : ψ e01 = 0 ∨ ψ e01 = e01 := by
    refine wedge_fix ?_
    intro u hu
    rw [← hcomm, e01_mem_fixU u hu]
  have hspan : ∀ (χ : (Fin 10 → ZMod 2) →ₗ[ZMod 2] (Fin 10 → ZMod 2)),
      (∀ g x, χ (wedgeRep g x) = wedgeRep g (χ x)) → χ e01 = 0 → ∀ x, χ x = 0 := by
    intro χ hχ h0 x
    have hle : CFSG.Quasithin.JonesParshall.Curtis.orbitSpan wedgeRep e01 ≤ LinearMap.ker χ := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨g, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker, hχ, h0, map_zero]
    have hx : x ∈ CFSG.Quasithin.JonesParshall.Curtis.orbitSpan wedgeRep e01 := by
      rw [CFSG.Quasithin.JonesParshall.Curtis.wedge_gen]
      trivial
    exact hle hx
  rcases hy with h0 | h1
  · left
    have hall := hspan ψ hcomm h0
    ext v
    have := hall (β (Additive.ofMul v))
    rw [h2] at this
    have h2' : Additive.ofMul (φ v) = 0 := β.injective (by rw [this, map_zero])
    exact Additive.ofMul.injective h2'
  · right
    have hall := hspan (ψ - LinearMap.id) (fun g x => by
      simp only [LinearMap.sub_apply, LinearMap.id_apply, map_sub, hcomm g x]) (by simp [h1])
    ext v
    have := hall (β (Additive.ofMul v))
    rw [LinearMap.sub_apply, LinearMap.id_apply, h2, sub_eq_zero] at this
    have h2' : Additive.ofMul (φ v) = Additive.ofMul v := β.injective this
    exact Additive.ofMul.injective h2'

set_option synthInstance.maxSize 1024 in
private theorem burnsideKC_exists_sep : ∀ ψ ψ' : Fin 5 → ZMod 2, ψ ≠ 0 → ψ' ≠ 0 → ψ ≠ ψ' →
    ∃ w : Fin 5 → ZMod 2, ψ ⬝ᵥ w = 0 ∧ ψ' ⬝ᵥ w = 1 := by
  decide +kernel

open CFSG.Quasithin CFSG.Quasithin.B42Ln CFSG.Quasithin.JonesParshall CFSG.Quasithin.JonesParshall.Curtis Matrix in
private theorem burnsideKC_exists_tv_conj_R4 (h : G5) (w : Fin 5 → ZMod 2)
    (hw : (Pi.single 4 1 ᵥ* ((h⁻¹ : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2))) ⬝ᵥ w = 0) :
    ∃ u ∈ R4.map (MulAut.conj h).toMonoidHom,
      ((u : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2)) =
        1 + vecMulVec w (Pi.single 4 1 ᵥ* ((h⁻¹ : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2))) := by
  have hhi : ((h : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2)) * ((h⁻¹ : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2)) = 1 :=
    coe_mul_inv h
  have hih : ((h⁻¹ : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2)) * ((h : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2)) = 1 :=
    coe_inv_mul h
  set w₀ : Fin 5 → ZMod 2 := ((h⁻¹ : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2)) *ᵥ w with hw₀
  have hw₄ : w₀ 4 = 0 := by
    calc w₀ 4 = Pi.single 4 1 ⬝ᵥ w₀ := by rw [single_dotProduct, one_mul]
      _ = 0 := by rw [hw₀, dotProduct_mulVec]; exact hw
  have hmem : ofMatInv (1 + vecMulVec w₀ (Pi.single 4 1)) (1 + vecMulVec w₀ (Pi.single 4 1))
      (tvR_mul_self w₀ hw₄) ∈ R4 := mem_R4_iff.2 ⟨w₀, hw₄, rfl⟩
  refine ⟨h * ofMatInv (1 + vecMulVec w₀ (Pi.single 4 1)) (1 + vecMulVec w₀ (Pi.single 4 1))
      (tvR_mul_self w₀ hw₄) * h⁻¹, ⟨_, hmem, rfl⟩, ?_⟩
  show ((h : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2)) * (1 + vecMulVec w₀ (Pi.single 4 1)) *
      ((h⁻¹ : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2)) = _
  rw [mul_add, mul_one, add_mul, hhi, mul_vecMulVec, vecMulVec_mul, hw₀, mulVec_mulVec, hhi,
    one_mulVec]

open Matrix in
private theorem burnsideKC_tv_mulVec (a b x : Fin 5 → ZMod 2) :
    (1 + vecMulVec a b) *ᵥ x = x + (b ⬝ᵥ x) • a := by
  rw [add_mulVec, one_mulVec]
  congr 1
  ext i
  simp [vecMulVec, mulVec, dotProduct, Finset.sum_mul, Finset.mul_sum, mul_comm, mul_left_comm]

open CFSG.Quasithin CFSG.Quasithin.B42Ln CFSG.Quasithin.JonesParshall CFSG.Quasithin.JonesParshall.Curtis Matrix in
private theorem burnsideKC_conj_R4_eq {T : Subgroup G5} (hT : IsPGroup 2 T) {h h' : G5}
    (hR : R4.map (MulAut.conj h).toMonoidHom ≤ T)
    (hR' : R4.map (MulAut.conj h').toMonoidHom ≤ T) :
    R4.map (MulAut.conj h).toMonoidHom = R4.map (MulAut.conj h').toMonoidHom := by
  classical
  have hne : ∀ g : G5, (Pi.single 4 1 ᵥ* ((g⁻¹ : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2))) ≠ 0 := by
    intro g h0
    have := congrArg (· ᵥ* ((g : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2))) h0
    simp only [vecMul_vecMul, coe_inv_mul, vecMul_one, zero_vecMul] at this
    exact absurd (congrFun this 4) (by simp)
  by_cases hEq : (Pi.single 4 1 ᵥ* ((h⁻¹ : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2))) =
      Pi.single 4 1 ᵥ* ((h'⁻¹ : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2))
  · ext u
    rw [mem_conj_R4_iff h, mem_conj_R4_iff h', hEq]
  · exfalso
    obtain ⟨w, hw0, hw1⟩ := burnsideKC_exists_sep _ _ (hne h) (hne h') hEq
    obtain ⟨w', hw'0, hw'1⟩ := burnsideKC_exists_sep _ _ (hne h') (hne h) (Ne.symm hEq)
    obtain ⟨t₁, ht₁, hm₁⟩ := burnsideKC_exists_tv_conj_R4 h w hw0
    obtain ⟨t₂, ht₂, hm₂⟩ := burnsideKC_exists_tv_conj_R4 h' w' hw'0
    generalize (Pi.single 4 1 ᵥ* ((h⁻¹ : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2))) = ψ at *
    generalize (Pi.single 4 1 ᵥ* ((h'⁻¹ : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2))) = ψ' at *
    have hprod : t₁ * t₂ ∈ T := T.mul_mem (hR ht₁) (hR' ht₂)
    obtain ⟨M, hM⟩ : ∃ M : Matrix (Fin 5) (Fin 5) (ZMod 2), M =
        ((t₁ : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2)) *
          ((t₂ : G5) : Matrix (Fin 5) (Fin 5) (ZMod 2)) := ⟨_, rfl⟩
    have hw'1' : ψ ⬝ᵥ w' = 1 := hw'1
    have hM1 : M *ᵥ w = w' := by
      rw [hM, ← mulVec_mulVec, hm₂, burnsideKC_tv_mulVec, hw1, one_smul, hm₁,
        burnsideKC_tv_mulVec, dotProduct_add, hw0, hw'1', zero_add, one_smul]
      ext i
      simp only [Pi.add_apply]
      generalize w i = a
      generalize w' i = b
      revert a b
      decide
    have hM2 : M *ᵥ w' = w + w' := by
      rw [hM, ← mulVec_mulVec, hm₂, burnsideKC_tv_mulVec, hw'0, zero_smul, add_zero, hm₁,
        burnsideKC_tv_mulVec, hw'1', one_smul]
      ext i
      simp only [Pi.add_apply]
      generalize w i = a
      generalize w' i = b
      revert a b
      decide
    have hM3 : M *ᵥ (w + w') = w := by
      rw [mulVec_add, hM1, hM2]
      ext i
      simp only [Pi.add_apply]
      generalize w i = a
      generalize w' i = b
      revert a b
      decide
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    have hM3w : M ^ 3 *ᵥ w = w := by
      rw [pow_succ', pow_succ', pow_one, ← mulVec_mulVec, ← mulVec_mulVec, hM1, hM2, hM3]
    have hMk : ∀ k : ℕ, (M ^ 3) ^ k *ᵥ w = w := by
      intro k
      induction k with
      | zero => simp
      | succ k ih => rw [pow_succ', ← mulVec_mulVec, ih, hM3w]
    have hww : w ≠ w' := by
      intro hh
      have := hw0
      rw [hh, hw'1'] at this
      exact absurd this (by decide)
    have hw'ne : w' ≠ 0 := by
      intro hh
      rw [hh, dotProduct_zero] at hw'1'
      exact absurd hw'1' (by decide)
    obtain ⟨k, hk⟩ := IsPGroup.iff_orderOf.1 hT ⟨t₁ * t₂, hprod⟩
    rw [Subgroup.orderOf_mk] at hk
    set d := orderOf (t₁ * t₂) with hd
    have hpow : M ^ d = 1 := by
      have h1 : (t₁ * t₂) ^ d = 1 := pow_orderOf_eq_one _
      have h2 := congrArg (fun g : G5 => (g : Matrix (Fin 5) (Fin 5) (ZMod 2))) h1
      simpa [Matrix.SpecialLinearGroup.coe_pow, hM] using h2
    have hmod : M ^ (d % 3) *ᵥ w = w := by
      have h1 : M ^ d *ᵥ w = w := by rw [hpow, one_mulVec]
      conv_lhs at h1 => rw [← Nat.mod_add_div d 3, pow_add, pow_mul, ← mulVec_mulVec, hMk]
      exact h1
    have h3 : 3 ∣ d := by
      have : d % 3 = 0 ∨ d % 3 = 1 ∨ d % 3 = 2 := by omega
      rcases this with h0 | h0 | h0
      · omega
      · rw [h0, pow_one, hM1] at hmod
        exact absurd hmod.symm hww
      · rw [h0, pow_two, ← mulVec_mulVec, hM1, hM2] at hmod
        exact absurd (by simpa using hmod) hw'ne
    rw [hk] at h3
    exact absurd (Nat.Prime.dvd_of_dvd_pow Nat.prime_three h3) (by norm_num)

private theorem burnsideKC_exists_conj_le_sylow {X : Type} [Group X] [Finite X] {S E : Subgroup X}
    (hS : IsPGroup 2 S) (hSi : ¬ 2 ∣ S.index) (hE : IsPGroup 2 E) :
    ∃ g : X, E.map (MulAut.conj g).toMonoidHom ≤ S := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨Q, hEQ⟩ := hE.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq X Q (hS.toSylow hSi)
  refine ⟨g, ?_⟩
  rintro _ ⟨x, hx, rfl⟩
  have h2 : (g • Q : Sylow 2 X) = hS.toSylow hSi := hg
  have h3 : ((g • Q : Sylow 2 X) : Subgroup X) = (hS.toSylow hSi : Subgroup X) := by rw [h2]
  rw [Sylow.coe_subgroup_smul] at h3
  have h4 : g • (Q : Subgroup X) = S := h3
  rw [← h4]
  exact Subgroup.smul_mem_pointwise_smul x (MulAut.conj g) _ (hEQ hx)

open CFSG.Quasithin CFSG.Quasithin.B42Ln CFSG.Quasithin.JonesParshall CFSG.Quasithin.JonesParshall.Curtis CFSG.QuasithinUnique CFSG.Assembly.LowTwoRank in
private theorem burnsideKC_sylow_offender5 {V : Type} [CommGroup V] [Finite V]
    [Module (ZMod 2) (Additive V)] {G L : Subgroup (MulAut V)}
    (e : ↥L ≃* ↥(StatedSL 5 (ZMod 2))) {κ : G5 ≃* G5}
    {β : Additive V ≃ₗ[ZMod 2] (Fin 10 → ZMod 2)}
    (hβ : ∀ g w, β (repOf (phiOf e) g w) = wedgeRep (κ g) (β w)) (hGL : G = L)
    {T : Subgroup (MulAut V)} (hT : IsSylowTwoOf T G) :
    ∃ X : Subgroup (MulAut V), IsFFStarOffender T X ∧ rk ↥X = 4 ∧ rk ↥(fixV X) = 6 ∧
      rAV X = 1 ∧ ∀ A, IsFFStarOffender T A → A = X := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hV10 : Nat.card V = 2 ^ 10 := card_V_eq β
  have hTL : T ≤ L := hGL ▸ hT.1
  have hexfLk : ∀ {x : MulAut V}, x ∈ L → ∃ g, fLk e κ g = x := by
    intro x hx
    obtain ⟨g, hg⟩ := exists_fL_eq e hx
    refine ⟨κ g, ?_⟩
    show fL e (κ.symm (κ g)) = x
    rw [MulEquiv.symm_apply_apply]
    exact hg
  have hfLkmem : ∀ g, fLk e κ g ∈ L := fun g => fL_mem e _
  obtain ⟨T5, hT5⟩ : ∃ T5 : Subgroup G5, T5 = T.comap (fLk e κ) := ⟨_, rfl⟩
  have hmemT5 : ∀ g, g ∈ T5 ↔ fLk e κ g ∈ T := fun g => by rw [hT5]; rfl
  have hT5p : IsPGroup 2 T5 := by
    rw [hT5]
    exact hT.2.1.comap_of_injective _ (fLk_injective e κ)
  have hcT5 : Nat.card T5 = Nat.card T := by
    refine Nat.card_congr (Equiv.ofBijective
      (fun g : T5 => (⟨fLk e κ g, (hmemT5 g).1 g.2⟩ : T)) ⟨?_, ?_⟩)
    · intro g g' h
      have h' : fLk e κ (g : G5) = fLk e κ (g' : G5) :=
        congrArg (fun z : ↥T => (z : MulAut V)) h
      exact Subtype.ext (fLk_injective e κ h')
    · rintro ⟨x, hx⟩
      obtain ⟨g, rfl⟩ := hexfLk (hTL hx)
      exact ⟨⟨g, (hmemT5 g).2 hx⟩, rfl⟩
  have hcG5 : Nat.card G5 = Nat.card G := by
    rw [hGL]
    exact (Nat.card_congr (phiOf e).toEquiv).symm
  have hidx : T5.index = (T.subgroupOf G).index := by
    have h1 := Subgroup.index_mul_card T5
    have h2 := Subgroup.index_mul_card (T.subgroupOf G)
    have h3 : Nat.card (T.subgroupOf G) = Nat.card T :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hT.1).toEquiv
    rw [h3, ← hcG5] at h2
    rw [hcT5] at h1
    exact Nat.eq_of_mul_eq_mul_right Nat.card_pos (h1.trans h2.symm)
  have hT5i : ¬ 2 ∣ T5.index := by rw [hidx]; exact hT.2.2
  have hR4p : IsPGroup 2 R4 := IsPGroup.of_card (n := 4) (by rw [card_R4]; norm_num)
  obtain ⟨g, hg⟩ := burnsideKC_exists_conj_le_sylow hT5p hT5i hR4p
  obtain ⟨Y, hY⟩ : ∃ Y : Subgroup G5, Y = R4.map (MulAut.conj g).toMonoidHom := ⟨_, rfl⟩
  have hYT : Y ≤ T5 := hY ▸ hg
  have hYc : ∀ a ∈ Y, ∀ b ∈ Y, a * b = b * a := by
    rw [hY]
    rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    calc g * a * g⁻¹ * (g * b * g⁻¹) = g * (a * b) * g⁻¹ := by group
      _ = g * (b * a) * g⁻¹ := by rw [comm_R4 a ha b hb]
      _ = g * b * g⁻¹ * (g * a * g⁻¹) := by group
  have hYs : ∀ a ∈ Y, a * a = 1 := by
    rw [hY]
    rintro _ ⟨a, ha, rfl⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    calc g * a * g⁻¹ * (g * a * g⁻¹) = g * (a * a) * g⁻¹ := by group
      _ = 1 := by rw [sq_R4 a ha]; group
  obtain ⟨X, hX⟩ : ∃ X : Subgroup (MulAut V), X = Y.map (fLk e κ) := ⟨_, rfl⟩
  have hXT : X ≤ T := by
    rw [hX]
    rintro _ ⟨y, hy, rfl⟩
    exact (hmemT5 y).1 (hYT hy)
  have hXL : X ≤ L := hXT.trans hTL
  have hXel : IsElemAbelian2 X := by
    rw [hX]
    refine ⟨?_, ?_⟩
    · rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
      rw [← map_mul, ← map_mul, hYc a ha b hb]
    · rintro _ ⟨a, ha, rfl⟩
      rw [← map_pow, pow_two, hYs a ha, map_one]
  have hYcard : Nat.card Y = 16 := by
    rw [hY, Subgroup.card_map_of_injective (f := (MulAut.conj g).toMonoidHom)
      (MulAut.conj g).injective, card_R4]
  have hXcard : Nat.card X = 16 := by
    rw [hX, Subgroup.card_map_of_injective (fLk_injective e κ), hYcard]
  have hbound := card_mul_fixV_le_of_le hβ hXL hXel
  have hfixX : Nat.card (fixV X) = 64 := by
    have h1 : 64 ≤ Nat.card (fixV X) := by
      rw [hX, card_fixV_map_fLk hβ Y, hY, card_fixW_conj]
      exact card_fixW_R4
    have h2 := hbound.1
    rw [hXcard] at h2
    omega
  have hXne : X ≠ ⊥ := by
    intro h0
    rw [h0, Subgroup.card_bot] at hXcard
    omega
  have hXoff : IsFFStarOffender T X := by
    refine ⟨hXT, hXne, hXel, fun B hBX => ?_⟩
    have hBel : IsElemAbelian2 B := ⟨fun a ha b hb => hXel.1 a (hBX ha) b (hBX hb),
      fun a ha => hXel.2 a (hBX ha)⟩
    have := (card_mul_fixV_le_of_le hβ (hBX.trans hXL) hBel).1
    rw [hXcard, hfixX]
    omega
  refine ⟨X, hXoff, ?_, ?_, ?_, fun A hA => ?_⟩
  · unfold rk
    rw [hXcard, show (16 : ℕ) = 2 ^ 4 by norm_num, padicValNat.prime_pow]
  · unfold rk
    rw [hfixX, show (64 : ℕ) = 2 ^ 6 by norm_num, padicValNat.prime_pow]
  · have h1 := rk_add_rkIdx (fixV X)
    have hrkV : rk V = 10 := by
      unfold rk
      rw [hV10, padicValNat.prime_pow]
    have hrk6 : rk ↥(fixV X) = 6 := by
      unfold rk
      rw [hfixX, show (64 : ℕ) = 2 ^ 6 by norm_num, padicValNat.prime_pow]
    have hrk4 : rk ↥X = 4 := by
      unfold rk
      rw [hXcard, show (16 : ℕ) = 2 ^ 4 by norm_num, padicValNat.prime_pow]
    have hidx4 : rkIdx (fixV X) = 4 := by omega
    unfold rAV
    rw [hidx4, hrk4]
    norm_num
  ·
    have hAL : A ≤ L := hA.1.trans hTL
    have hoff : 2 ^ 10 ≤ Nat.card A * Nat.card (fixV A) := by
      have := hA.card_le (bot_le : (⊥ : Subgroup (MulAut V)) ≤ A)
      rwa [B1.card_bot_mul_card_fixV, hV10] at this
    obtain ⟨h, hh⟩ := (card_mul_fixV_le_of_le hβ hAL hA.2.2.1).2 hoff hA.2.1
    have hAT5 : R4.map (MulAut.conj h).toMonoidHom ≤ T5 := by
      intro y hy
      refine (hmemT5 y).2 (hA.1 ?_)
      rw [hh]
      exact ⟨y, hy, rfl⟩
    have := burnsideKC_conj_R4_eq hT5p hAT5 (hY ▸ hYT)
    rw [hh, hX, hY, this]



