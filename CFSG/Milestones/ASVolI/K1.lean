      (s = 1 →
        (IsAlt 5 ↥G ∨ Nonempty (↥G ≃* Equiv.Perm (Fin 5))) ∧ AlternatingNatural L ⊤ ⊥ 5 ∧
        (Nonempty (↥G ≃* Equiv.Perm (Fin 5)) → ∀ A, IsFFStarOffender G A → B42Case5 G A) ∧
