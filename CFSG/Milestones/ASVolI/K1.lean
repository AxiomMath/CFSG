  · refine (Subgroup.closure_le _).2 ?_
    rintro x ⟨hxP, hx2⟩
    by_cases hx : x = 1
    · rw [hx]
      exact Subgroup.one_mem _
    · exact Subgroup.subset_closure ⟨hxP, orderOf_eq_prime hx2 hx⟩
  · refine (Subgroup.closure_le _).2 ?_
    rintro x ⟨hxP, hx2⟩
    exact Subgroup.subset_closure ⟨hxP, by rw [← hx2]; exact pow_orderOf_eq_one x⟩

private theorem burnsideKE_zpowers_cases {M : Type} [Group M] {x : M} (hx : x * x = 1) :
    ∀ y ∈ Subgroup.zpowers x, y = 1 ∨ y = x := by
  intro y hy
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
  have h2 : x ^ (2 : ℤ) = 1 := by rw [zpow_two, hx]
  obtain ⟨m, hm | hm⟩ := Int.even_or_odd' k
  · left
    rw [hm, zpow_mul, h2, one_zpow]
  · right
    rw [hm, zpow_add, zpow_mul, h2, one_zpow, one_mul, zpow_one]

open CFSG.Quasithin in
private theorem burnsideKE_commV_zpowers_le {V : Type} [CommGroup V] (hV : ∀ v : V, v ^ 2 = 1)
    {x : MulAut V} (hx : x * x = 1) :
    commV (Subgroup.zpowers x) ≤ fixV (Subgroup.zpowers x) := by
  have hx1 := burnsideKE_zpowers_cases hx
  have hvv : ∀ w : V, w⁻¹ = w := fun w => by
    have := hV w
    rw [pow_two, mul_eq_one_iff_eq_inv] at this
    exact this.symm
  unfold commV
  rw [Subgroup.closure_le]
  rintro _ ⟨y, hy, v, rfl⟩
  rw [SetLike.mem_coe, mem_fixV]
  intro z hz
  rcases hx1 z hz with rfl | rfl
  · simp
  · rcases hx1 y hy with rfl | rfl
    · simp
    · rw [map_mul, map_inv, ← MulAut.mul_apply, hx, MulAut.one_apply, hvv, hvv, mul_comm]

open CFSG.Quasithin in
private theorem burnsideKE_card_commV_mul {V : Type} [CommGroup V] [Finite V] {x : MulAut V}
    (hx : x * x = 1) :
    Nat.card (commV (Subgroup.zpowers x)) * Nat.card (fixV (Subgroup.zpowers x)) =
      Nat.card V := by
  have hx1 := burnsideKE_zpowers_cases hx
  let φ : V →* V := MonoidHom.mk' (fun v => x v * v⁻¹) (fun v w => by
    simp only [map_mul, mul_inv]
    exact mul_mul_mul_comm _ _ _ _)
  have hker : φ.ker = fixV (Subgroup.zpowers x) := by
    ext v
    rw [MonoidHom.mem_ker, mem_fixV]
    change x v * v⁻¹ = 1 ↔ _
    rw [mul_inv_eq_one]
    constructor
    · intro h y hy
      rcases hx1 y hy with rfl | rfl
      · exact MulAut.one_apply _ v
      · exact h
    · intro h
      exact h x (Subgroup.mem_zpowers x)
  have hrange : φ.range = commV (Subgroup.zpowers x) := by
    apply le_antisymm
    · rintro _ ⟨v, rfl⟩
      exact Subgroup.subset_closure ⟨x, Subgroup.mem_zpowers x, v, rfl⟩
    · unfold commV
      rw [Subgroup.closure_le]
      rintro _ ⟨y, hy, v, rfl⟩
      rcases hx1 y hy with rfl | rfl
      · exact ⟨1, by simp [φ]⟩
      · exact ⟨v, rfl⟩
  rw [← hker, ← hrange]
  have h := Subgroup.card_eq_card_quotient_mul_card_subgroup φ.ker
  rw [Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv] at h
  rw [h, mul_comm]

private theorem burnsideKE_congr_eq_conj {V : Type} [CommGroup V] (d v : MulAut V) :
    MulAut.congr (d : V ≃* V) v = d * v * d⁻¹ := by
  ext x
  simp [MulAut.congr_apply, MulAut.mul_apply, MulAut.inv_apply]

private theorem burnsideKE_odd_index_of_equiv {K G : Type*} [Group K] [Group G] (e : K ≃* G)
    (hodd : Odd (MulAut.conj : G →* MulAut G).range.index) :
    Odd (MulAut.conj : K →* MulAut K).range.index := by
  let φ : MulAut K ≃* MulAut G := MulAut.congr e
  have hmap : (MulAut.conj : K →* MulAut K).range.map φ.toMonoidHom =
      (MulAut.conj : G →* MulAut G).range := by
    ext x
    constructor
    · rintro ⟨y, ⟨k, rfl⟩, rfl⟩
      refine ⟨e k, ?_⟩
      ext g
      simp [φ, MulAut.congr_apply, MulAut.conj_apply]
    · rintro ⟨g, rfl⟩
      refine ⟨φ.symm (MulAut.conj g), ⟨e.symm g, ?_⟩, by simp⟩
      apply φ.injective
      ext g'
      simp [φ, MulAut.congr_apply, MulAut.conj_apply]
  rw [← Subgroup.index_map_of_bijective (f := φ.toMonoidHom) φ.bijective, hmap]
  exact hodd

open CFSG.Quasithin in
private theorem burnsideKE_commV_eq_fixV_of_rkIdx {V : Type} [CommGroup V] [Finite V]
    (hV : ∀ v : V, v ^ 2 = 1) {x : MulAut V} (hx : x * x = 1) {n : ℕ}
    (hVcard : Nat.card V = 2 ^ (2 * n)) (hidx : rkIdx (fixV (Subgroup.zpowers x)) = n) :
    commV (Subgroup.zpowers x) = fixV (Subgroup.zpowers x) ∧
      Nat.card (fixV (Subgroup.zpowers x)) = 2 ^ n := by
  have hmul := (fixV (Subgroup.zpowers x)).card_mul_index
  have hdvd : (fixV (Subgroup.zpowers x)).index ∣ 2 ^ (2 * n) := by
    rw [← hVcard]
    exact Subgroup.index_dvd_card _
  obtain ⟨m, -, hm⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hdvd
  have hmn : m = n := by
    rw [← hidx, rkIdx, hm]
    exact (padicValNat.prime_pow m).symm
  have hidx2 : (fixV (Subgroup.zpowers x)).index = 2 ^ n := hm.trans (by rw [hmn])
  have hpos : 0 < 2 ^ n := by positivity
  have hsq : 2 ^ (2 * n) = 2 ^ n * 2 ^ n := by rw [two_mul, pow_add]
  have hC : Nat.card (fixV (Subgroup.zpowers x)) = 2 ^ n := by
    rw [hidx2, hVcard, hsq] at hmul
    exact Nat.eq_of_mul_eq_mul_right hpos hmul
  refine ⟨?_, hC⟩
  have hcm := burnsideKE_card_commV_mul hx
  rw [hC, hVcard, hsq] at hcm
  have hcm2 : Nat.card (commV (Subgroup.zpowers x)) = 2 ^ n :=
    Nat.eq_of_mul_eq_mul_right hpos hcm
  exact Subgroup.eq_of_le_of_card_ge (burnsideKE_commV_zpowers_le hV hx) (by rw [hC, hcm2])

