theorem as_K_3_4 : K_3_4 := by
  intro V _ _ G L hK r hr hmodel
  obtain ⟨hV, hHyp, hq2⟩ := hK
  have hW : ∀ v : V, v * v = 1 := fun v => by rw [← pow_two]; exact hV v
  have hq : CFSG.IsQuasisimple ↥L := hHyp.2.2.1
  have hodd := CFSG.QuasithinUnique.Setup.Family.odd_card_center_of_irreducible hW
    (CFSG.QuasithinUnique.Bridge.TypeList.irr_of_isIrrSec hHyp.2.2.2)
  have hZ : Subgroup.center ↥L = ⊥ :=
    (CFSG.SectionRank.EvenCover.even_symplectic_odd_cover_catalog_step hq hodd hmodel).1
  obtain ⟨K, _, _, _, hK, ⟨θL⟩⟩ := CFSG.Quasithin.B42Sp4.exists_antiSp_equiv hZ hmodel
  refine ⟨⟨K, inferInstance, inferInstance, hK,
    ⟨θL.trans (CFSG.ComponentClassification.UnbalancedCatalog.SpChain.antiSpEquiv K)⟩⟩, ?_⟩
  rcases burnsideKD_sp4_dichotomy hV hHyp hZ (by omega) hmodel hq2 with h | ⟨s, hs, h⟩
  · exact Or.inl h
  · exact Or.inr ⟨s, hs, h⟩

end

