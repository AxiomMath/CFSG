variable {W : Type*} [CommGroup W]

open CFSG.Quasithin in
private theorem burnsideKC_commSub_map_conj (g : MulAut W) (J : Subgroup W) (A : Subgroup
    (MulAut W)) :
    commSub (J.map g.toMonoidHom) (A.map (MulAut.conj g).toMonoidHom) =
      (commSub J A).map g.toMonoidHom := by
  unfold commSub
  rw [MonoidHom.map_closure]
  congr 1
  ext c
  constructor
  · rintro ⟨x', ⟨x, hx, rfl⟩, w', ⟨w, hw, rfl⟩, rfl⟩
    refine ⟨x w * w⁻¹, ⟨x, hx, w, hw, rfl⟩, ?_⟩
    simp [MulAut.conj_apply, MulAut.mul_apply]
  · rintro ⟨c₀, ⟨x, hx, w, hw, rfl⟩, rfl⟩
    refine ⟨(MulAut.conj g).toMonoidHom x, ⟨x, hx, rfl⟩, g w, ⟨w, hw, rfl⟩, ?_⟩
    simp [MulAut.conj_apply, MulAut.mul_apply]

open CFSG.Quasithin in
private theorem burnsideKC_commIter_map_conj (g : MulAut W) (J : Subgroup W) (A : Subgroup
    (MulAut W))
    (k : ℕ) :
    commIter (J.map g.toMonoidHom) (A.map (MulAut.conj g).toMonoidHom) k =
      (commIter J A k).map g.toMonoidHom := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [commIter]
    rw [ih, burnsideKC_commSub_map_conj]

open CFSG.Quasithin in
private theorem burnsideKC_commSeries_map_conj (g : MulAut W) (A : Subgroup (MulAut W)) (k : ℕ) :
    commSeries (A.map (MulAut.conj g).toMonoidHom) k = (commSeries A k).map g.toMonoidHom := by
  unfold commSeries
  rw [← burnsideKC_commIter_map_conj]
  congr 1
  exact (Subgroup.map_top_of_surjective _ g.surjective).symm

end Conj

open CFSG.Quasithin CFSG.Quasithin.H in
private theorem burnsideKC_conj_props {V : Type} [CommGroup V] [Finite V] (g : MulAut V)
    (A : Subgroup (MulAut V)) :
    rk ↥(A.map (MulAut.conj g).toMonoidHom) = rk ↥A ∧
      rkIdx (fixV (A.map (MulAut.conj g).toMonoidHom)) = rkIdx (fixV A) ∧
      (IsElemAbelian2 (A.map (MulAut.conj g).toMonoidHom) ↔ IsElemAbelian2 A) ∧
      Nat.card ↥(A.map (MulAut.conj g).toMonoidHom) = Nat.card ↥A := by
  rw [burnsideKC_conj_eq_congrHom]
  exact ⟨rk_map_congrHom _ A, rkIdx_fixV_map_congrHom _ A, isElemAbelian2_map_congrHom _,
    card_map_congrHom _ A⟩
private theorem burnsideKC_map_conj_inv {Ω : Type} [Group Ω] (g : Ω) (A : Subgroup Ω) :
    (A.map (MulAut.conj g⁻¹).toMonoidHom).map (MulAut.conj g).toMonoidHom = A := by
  ext x
  constructor
  · rintro ⟨_, ⟨a, ha, rfl⟩, rfl⟩
    simpa [MulAut.conj_apply, mul_assoc] using ha
  · intro hx
    exact ⟨g⁻¹ * x * g, ⟨x, hx, by simp [MulAut.conj_apply]⟩, by simp [MulAut.conj_apply, mul_assoc]⟩

open CFSG.Quasithin in
private theorem burnsideKC_rAV_conj {V : Type} [CommGroup V] [Finite V] (g : MulAut V)
    (A : Subgroup (MulAut V)) : rAV (A.map (MulAut.conj g).toMonoidHom) = rAV A := by
  obtain ⟨h1, h2, -, -⟩ := burnsideKC_conj_props g A
  unfold rAV
  rw [h1, h2]

open CFSG.Quasithin CFSG.Quasithin.H CFSG.Quasithin.H.L3Nine CFSG.QuasithinUnique.Setup.X7a CFSG.LocalAnalysis.ComponentInitial.LinearFlag in
open scoped MatrixGroups in
private theorem burnsideKC_rAV_P2 {V : Type} [CommGroup V] [Finite V] (hV : ∀ v : V, v ^ 2 = 1)
    {L : Subgroup (MulAut V)} {s : ℕ} (hs : 1 ≤ s) {F : Type} [Field F] [Finite F] [CharP F 2]
    (hFcard : Nat.card F = 2 ^ (2 * s)) (hK : Nat.card F = (2 ^ s) ^ 2)
    (π₀ : SL(3, F) →* ↥L) (hker : ∀ x, π₀ x = 1 → x ∈ scalars 3 F) (E : V ≃* HMod s F)
    (hE : ∀ u : SL(3, F), congrHom E ((π₀ u : ↥L) : MulAut V) = rho hK u)
    (hVcard : Nat.card V = 2 ^ (9 * s)) :
    (2 : ℚ) ≤ rAV (((burnsideKC_Q2 F).map π₀).map L.subtype) := by
  have hcard : Nat.card (((burnsideKC_Q2 F).map π₀).map L.subtype) = 2 ^ (4 * s) := by
    rw [Subgroup.card_map_of_injective L.subtype_injective,
      burnsideKC_card_map_of_injOn π₀ _ (fun x hx h =>
        burnsideKC_pi0_injOn π₀ hker x (burnsideKC_Q2_le F hx) h),
      burnsideKC_card_Q2, hFcard, ← pow_mul]
    ring_nf
  have hrk : rk ↥(((burnsideKC_Q2 F).map π₀).map L.subtype) = 4 * s := by
    unfold rk
    rw [hcard, padicValNat.prime_pow]
  have hfix := burnsideKC_fixV_P2 hs hK π₀ E hE
  have hrkfix : rk ↥(fixV (((burnsideKC_Q2 F).map π₀).map L.subtype)) ≤ s := by
    rw [card_eq_two_pow hV] at hfix
    exact (Nat.pow_le_pow_iff_right (by norm_num)).mp hfix
  have hrkV : rk V = 9 * s := by
    unfold rk
    rw [hVcard, padicValNat.prime_pow]
  have hidx := rk_add_rkIdx (fixV (((burnsideKC_Q2 F).map π₀).map L.subtype))
  unfold rAV
  rw [hrk, le_div_iff₀ (by exact_mod_cast (by omega : 0 < 4 * s))]
  have h8 : 8 * s ≤ rkIdx (fixV (((burnsideKC_Q2 F).map π₀).map L.subtype)) := by omega
  have h8' : ((8 * s : ℕ) : ℚ) ≤
      (rkIdx (fixV (((burnsideKC_Q2 F).map π₀).map L.subtype)) : ℚ) := by exact_mod_cast h8
  push_cast at h8' ⊢
  linarith

end BurnsideKC

