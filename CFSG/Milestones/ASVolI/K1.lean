open CFSG.Quasithin CFSG.Assembly.LowTwoRank CFSG.QuasithinUnique CFSG.ASVolI.ChIJK in
theorem as_K_3_1_1 : K_3_1_1 := by
  classical
  intro V _ _ G L hK r _ hnat
  obtain ⟨hV, hHyp, -⟩ := hK
  obtain ⟨F, _, _, hF, θL, e, he⟩ := burnsideKB_natural_coords hnat
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : CharP F 2 := charP_of_card_eq_prime_pow hF
  have hn : 1 ≤ r := by
    by_contra h
    have h0 : r = 0 := by omega
    subst h0
    have := Fintype.one_lt_card (α := F)
    omega
  have hq2 : 2 ≤ 2 ^ r := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ r := Nat.pow_le_pow_right (by norm_num) hn
  have hcardF : Nat.card F = 2 ^ r := by rw [Nat.card_eq_fintype_card, hF]
  obtain ⟨hLG, -, -, -⟩ := FFC.b4hyp_data hHyp
  have hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)) := B42L2.le_normalizer_of_b4Hyp hHyp
  have hZ : Subgroup.center ↥L = ⊥ := by
    rw [Subgroup.eq_bot_iff_forall]
    intro x hx
    have hx' : θL x ∈ Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) F) := by
      rw [Subgroup.mem_center_iff] at hx ⊢
      intro g
      apply θL.symm.injective
      rw [map_mul, map_mul, MulEquiv.symm_apply_apply]
      exact hx (θL.symm g)
    rw [B42L2.center_sl2_eq_bot, Subgroup.mem_bot] at hx'
    exact θL.injective (hx'.trans (map_one θL).symm)
  have hVc : Nat.card V = 2 ^ r * 2 ^ r := by
    rw [Nat.card_congr e.toEquiv]
    show Nat.card (Fin 2 → F) = _
    rw [Nat.card_fun, Nat.card_fin, hcardF, sq]
  have hLc : Nat.card L = 2 ^ r * ((2 ^ r) ^ 2 - 1) := by
    rw [Nat.card_congr θL.toEquiv, CFSG.SL2MinimalFaithful.card_specialLinearGroup_fin_two,
      hcardF]
  have hoffinfo : ∀ B, IsFFStarOffender G B →
      B ≤ L ∧ Nat.card B = 2 ^ r ∧ Nat.card B * Nat.card (fixV B) = Nat.card V := by
    intro B hB
    have hBL := burnsideKB_offender_le hHyp hn hF θL e he hB
    have h1 := B42L2.card_le_of_offender hB
    have hBq := (B42L2.card_le_of_isPGroup hBL hB.2.2.1.isPGroup hn hLc).1
    have hfq := burnsideKB_card_fixV_le hF θL e he hBL hB.2.1
    have hw : Nat.card B * Nat.card (fixV B) = Nat.card V := by
      refine le_antisymm ?_ h1
      rw [hVc]
      exact Nat.mul_le_mul hBq hfq
    refine ⟨hBL, le_antisymm hBq ?_, hw⟩
    by_contra hlt
    push Not at hlt
    have h2 : Nat.card B * Nat.card (fixV B) < 2 ^ r * 2 ^ r :=
      calc Nat.card B * Nat.card (fixV B) ≤ Nat.card B * 2 ^ r := Nat.mul_le_mul_left _ hfq
        _ < 2 ^ r * 2 ^ r := Nat.mul_lt_mul_of_pos_right hlt (by positivity)
    omega
  have hSylow : ∀ T, IsSylowTwoOf T G → IsSylowTwoOf (T ⊓ L) L := by
    intro T hT
    have hnorm : (L.subgroupOf G).Normal :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer hLG).2 hGN
    exact CFSG.QuasithinUnique.RankOneRecog.isSylowTwoOf_inf_of_subnormal hT hLG
      hnorm.isSubnormal
  have hTL : ∀ T, IsSylowTwoOf T G → IsFFStarOffender T (T ⊓ L) := by
    intro T hT
    have hP2 : IsPGroup 2 ↥(T ⊓ L) := hT.2.1.to_le inf_le_left
    have hcard : Nat.card ↥(T ⊓ L) = 2 ^ r :=
      burnsideKB_card_eq_of_odd_index inf_le_right hP2 hn hLc (hSylow T hT).2.2
    have hfix : 2 ^ r ≤ Nat.card (fixV (T ⊓ L)) :=
      burnsideKB_card_fixV_ge hn hF θL e he inf_le_right hP2
    refine ⟨inf_le_left, ?_, burnsideKB_isElemAbelian2 hn hF θL e he inf_le_right hP2, ?_⟩
    · intro h
      rw [h, Subgroup.card_bot] at hcard
      omega
    · intro B hB
      by_cases hB1 : B = ⊥
      · subst hB1
        rw [B1.card_bot_mul_card_fixV, hVc, hcard]
        exact Nat.mul_le_mul_left _ hfix
      · have h1 : Nat.card B ≤ Nat.card ↥(T ⊓ L) := Subgroup.card_le_of_le hB
        have h2 := burnsideKB_card_fixV_le hF θL e he (hB.trans inf_le_right) hB1
        rw [hcard] at h1 ⊢
        exact (Nat.mul_le_mul h1 h2).trans (Nat.mul_le_mul_left _ hfix)
  have hw : ∀ B, IsFFStarOffender G B → Nat.card B * Nat.card (fixV B) = Nat.card V :=
    fun B hB => (hoffinfo B hB).2.2
  obtain ⟨T₀, hT₀⟩ : ∃ T, IsSylowTwoOf T G := by
    obtain ⟨P⟩ := (inferInstance : Nonempty (Sylow 2 ↥G))
    exact ⟨_, CFSG.QuasithinUnique.RankOneRecog.isSylowTwoOf_iff_exists.mpr ⟨P, rfl⟩⟩
  have hA₀ : IsFFStarOffender G (T₀ ⊓ L) :=
    ⟨inf_le_left.trans hT₀.1, (hTL T₀ hT₀).2.1, (hTL T₀ hT₀).2.2.1, (hTL T₀ hT₀).2.2.2⟩
  refine ⟨fun T hT => ⟨hTL T hT, fun A hA => ?_⟩, B42L2.qOf_eq_one_of_weight hV hA₀ hw,
    fun A hA => B42L2.case1_of_natural hV hHyp hZ hn hF θL e he hw hA⟩
  have hAG : IsFFStarOffender G A := ⟨hA.1.trans hT.1, hA.2.1, hA.2.2.1, hA.2.2.2⟩
  obtain ⟨hAL, hAc, -⟩ := hoffinfo A hAG
  have hP2 : IsPGroup 2 ↥(T ⊓ L) := hT.2.1.to_le inf_le_left
  have hcard : Nat.card ↥(T ⊓ L) = 2 ^ r :=
    burnsideKB_card_eq_of_odd_index inf_le_right hP2 hn hLc (hSylow T hT).2.2
  exact Subgroup.eq_of_le_of_card_ge (le_inf hA.1 hAL) (by rw [hcard, hAc])

@[expose] def K_3_1_2 : Prop :=
  ∀ (V : Type) [CommGroup V] [Finite V] (G L : Subgroup (MulAut V)), KSetup V G L →
    ∀ s : ℕ, IsPSL 2 2 (2 * s) (Lbar L) → BinaryOrthogonalFour L ⊤ ⊥ s →
      (∃ (F : Type) (_ : Field F) (_ : Finite F) (_ : CharP F 2)
          (coordinates : OrthogonalFourCoordinates L s F),
        0 < s ∧ Nat.card V = 2 ^ (4 * s) ∧
        (∃ singularPoint : Subgroup V, coordinates.IsPoint singularPoint ∧
          ∀ vector ∈ singularPoint, (coordinates.matrix vector).det = 0) ∧
        (∀ singularSpace : Subgroup V,
          (∀ vector ∈ singularSpace, (coordinates.matrix vector).det = 0) →
          (∀ scalar : F, OrthogonalFourCoordinates.IsFixedScalar s scalar →
            ∀ vector ∈ singularSpace, ∀ scalarVector : V,
              coordinates.matrix scalarVector = scalar • coordinates.matrix vector →
                scalarVector ∈ singularSpace) → Nat.card singularSpace ≤ 2 ^ s) ∧
        ∀ T, IsSylowTwoOf T G →
          (∃ t : MulAut V,
            t ∈ Subgroup.normalizer (L : Set (MulAut V)) ∧
            t ∈ Subgroup.normalizer ((T ⊓ L : Subgroup (MulAut V)) : Set (MulAut V)) ∧
            t ∉ L ∧ t ^ 2 = 1) ∧
        ∀ t : MulAut V,
          t ∈ Subgroup.normalizer (L : Set (MulAut V)) →
          t ∈ Subgroup.normalizer ((T ⊓ L : Subgroup (MulAut V)) : Set (MulAut V)) →
          t ∉ L → t ^ 2 = 1 →
          (∀ vector, (coordinates.matrix (t vector)).det = (coordinates.matrix vector).det) ∧
          (∀ scalar : F, OrthogonalFourCoordinates.IsFixedScalar s scalar →
            ∀ first second : V, coordinates.matrix second = scalar • coordinates.matrix first →
              coordinates.matrix (t second) = scalar • coordinates.matrix (t first)) ∧
          (∃ fieldMatrix : Matrix.GeneralLinearGroup (Fin 2) F,
            (∀ groupElement : ↥(StatedSL 2 F),
              ∃ imageElement : ↥(StatedSL 2 F),
                ((imageElement : Matrix.GeneralLinearGroup (Fin 2) F) :
                    Matrix (Fin 2) (Fin 2) F) =
                  (fieldMatrix : Matrix (Fin 2) (Fin 2) F) *
                    frobPow s ((groupElement : Matrix.GeneralLinearGroup (Fin 2) F) :
                      Matrix (Fin 2) (Fin 2) F) *
                    (fieldMatrix⁻¹ : Matrix (Fin 2) (Fin 2) F) ∧
                ((coordinates.group_equiv imageElement : ↥L) : MulAut V) =
                  t * ((coordinates.group_equiv groupElement : ↥L) : MulAut V) * t⁻¹) ∧
            ∀ vector : V, coordinates.matrix (t vector) =
              (fieldMatrix : Matrix (Fin 2) (Fin 2) F) *
                frobPow s (coordinates.matrix vector) *
                  Matrix.transpose (frobPow s (fieldMatrix : Matrix (Fin 2) (Fin 2) F))) ∧
