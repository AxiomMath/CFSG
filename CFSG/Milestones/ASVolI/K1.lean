  rcases hclass with ⟨hD, hdim⟩ | ⟨s, hs, hD, hdim⟩
  · refine ⟨hsimple, hSL, ?_, Or.inl ?_⟩
    · rw [hcardW, hD, hdim, ← pow_mul]
      ring_nf
    · have : Fact (repOf θ θL).IsIrreducible := ⟨repOf_isIrreducible θ θL hirr⟩
      obtain ⟨φ, hφ⟩ := exists_natural_iso (by omega : 1 ≤ r) hF (repOf θ θL)
