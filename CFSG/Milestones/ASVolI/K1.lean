open CFSG.LocalAnalysis.ComponentInitial.SymplecticFour (radical card_radical) in
private theorem burnsideKD_sp4_dichotomy
    {V : Type} [CommGroup V] [Finite V] (hV : ∀ v : V, v ^ 2 = 1)
    {G L : Subgroup (MulAut V)} (hHyp : B4Hyp G L)
    (hZ : Subgroup.center ↥L = ⊥) {f : ℕ} (hf2 : 2 ≤ f)
    (hmodel : StatedClassicalModel (↥L ⧸ Subgroup.center ↥L) .PSp 2 2 f)
    (hq2 : qhatOf G ≤ ((2 : ℚ) : WithTop ℚ)) :
    BinaryNaturalSp4 L ⊤ ⊥ f ∨ ∃ a, f = 2 * a ∧ TwistedTensorSp4 L ⊤ ⊥ a := by
  classical
  obtain ⟨K, _, _, _, hK, ⟨θL⟩⟩ := exists_antiSp_equiv hZ hmodel
  have hKf : Fintype.card K = 2 ^ f := by rw [← Nat.card_eq_fintype_card]; exact hK
  have hV' : ∀ v : V, v * v = 1 := fun v => by rw [← pow_two]; exact hV v
  obtain ⟨W, _, _, _, ⟨θ⟩⟩ := exists_binModel_of_binary hV'
  set ψ := binPsi θ with hψ
  let πW : antiSp K →* (W ≃ₗ[ZMod 2] W) :=
    ψ.toMonoidHom.comp (L.subtype.comp θL.symm.toMonoidHom)
  have hπW : ∀ g, πW g = ψ ((θL.symm g : ↥L) : MulAut V) := fun g => rfl
  have hπinj : Function.Injective πW := fun g g' h => by
    have h1 := ψ.injective h
    exact θL.symm.injective (Subtype.ext h1)
  have hirrV := Bridge.TypeList.irr_of_isIrrSec hHyp.2.2.2
  have hirr : ∀ U : Submodule (ZMod 2) W, (∀ g, ∀ u ∈ U, πW g u ∈ U) → U = ⊥ ∨ U = ⊤ := by
    intro U hU
    refine B42L2.irr_map θ hirrV U fun x hx u hu => ?_
    obtain ⟨l, hl, rfl⟩ := hx
    have h1 := hU (θL ⟨l, hl⟩) u hu
    rwa [hπW, MulEquiv.symm_apply_apply] at h1
  have hntW : Nontrivial W := by
    obtain ⟨v, -, hv⟩ := IsConcreteLE.exists_of_lt hHyp.2.2.2.1
    replace hv : v ≠ 1 := fun h => hv (h ▸ Subgroup.one_mem _)
    refine ⟨⟨Multiplicative.toAdd (θ v), 0, fun h => hv ?_⟩⟩
    have h1 : θ v = 1 := Multiplicative.toAdd.injective (by simpa using h)
    simpa using congrArg θ.symm h1
  have : Fact (repOf πW).IsIrreducible :=
    ⟨(CFSG.QuasithinUnique.Setup.X7.isIrreducible_iff (repOf πW)).mpr ⟨hntW, hirr⟩⟩
  have hπ'inj : Function.Injective (repOf πW) := fun g g' hg =>
    hπinj (LinearEquiv.toLinearMap_injective hg)
  have hπ'nt : ∃ g, repOf πW g ≠ 1 :=
    ⟨invX K, fun h1 => invX_ne_one (hπ'inj (h1.trans (map_one (repOf πW)).symm))⟩
  have hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)) := B42L2.le_normalizer_of_b4Hyp hHyp
  have hnormMap : ∀ B ≤ G, ∀ c ∈ B.map ψ.toMonoidHom, ∀ x, ∃ y, c * πW x * c⁻¹ = πW y := by
    rintro B hBG _ ⟨b, hb, rfl⟩ x
    have hl : b * ((θL.symm x : ↥L) : MulAut V) * b⁻¹ ∈ L :=
      (Subgroup.mem_normalizer_iff.mp (hGN (hBG hb)) _).mp (θL.symm x).2
    refine ⟨θL ⟨_, hl⟩, ?_⟩
    rw [hπW (θL _), MulEquiv.symm_apply_apply, hπW x]
    change ψ b * ψ ((θL.symm x : ↥L) : MulAut V) * (ψ b)⁻¹ =
      ψ (b * ((θL.symm x : ↥L) : MulAut V) * b⁻¹)
    rw [map_mul, map_mul, map_inv]
  have hcardMap : ∀ B : Subgroup (MulAut V), Nat.card ↥(B.map ψ.toMonoidHom) = Nat.card B :=
    fun B => Subgroup.card_map_of_injective ψ.injective
  have hfixMap : ∀ B : Subgroup (MulAut V),
      Nat.card {m : W // ∀ c ∈ B.map ψ.toMonoidHom, c m = m} = Nat.card ↥(fixV B) :=
    fun B => natCard_fixGL_map θ B
  have hcardVW : Nat.card V = Nat.card W := natCard_eq θ
  obtain ⟨A, hA2, -, hAr⟩ := kq_le_iff.mp hq2
  have hoffV := (rAV_le_two_iff' hV hA2).mp hAr
  have hA₀e := (isElemAbelian2_iff_map θ A).1 hA2.isElemAbelian2
  have hA₀1 : A.map ψ.toMonoidHom ≠ ⊥ := by
    rw [Ne, Subgroup.map_eq_bot_iff_of_injective A ψ.injective]
    exact hA2.ne_bot
  have hoff : Nat.card W ≤ Nat.card ↥(A.map ψ.toMonoidHom) ^ 2 *
      Nat.card {m : W // ∀ c ∈ A.map ψ.toMonoidHom, c m = m} := by
    rw [hcardMap, hfixMap, ← hcardVW]
    exact hoffV
  by_cases hdim : Module.finrank (EndRing (repOf πW)) W = 4
  · obtain ⟨i, φ, hφ⟩ := exists_natural_of_four hKf (by omega) πW hπ'nt hdim
    exact Or.inl (binaryNaturalSp4_of_coords θ hK θL i φ hφ)
  · obtain ⟨a, hfa, hD, hdim16⟩ :=
      twoF_label hf2 hK πW hπinj hdim _ (hnormMap A hA2.le) hA₀e hA₀1 hoff
    have ha : 1 ≤ a := by omega
    have hK2 : Nat.card K = 2 ^ (2 * a) := by rw [hK, hfa]
    have hKf2 : Fintype.card K = 2 ^ (2 * a) := by rw [hKf, hfa]
    obtain ⟨j, φ, hφ⟩ := exists_hermA_equiv ha hKf2 πW hπ'nt hD hdim16
    set δ : ↥L ≃* StatedSp 2 K := θL.trans (gam K j) with hδ
    have hφL : ∀ (l : ↥L) (w : W),
        (φ (binPsi θ (l : MulAut V) w)).1 = tw a (spMat (δ l)) (φ w).1 := by
      intro l w
      have h1 := hφ (θL l) w
      rw [hπW, MulEquiv.symm_apply_apply] at h1
      exact h1
    exact Or.inr ⟨a, hfa, twistedTensorSp4_of hK2 θ L δ φ hφL⟩



open CFSG.Quasithin CFSG.Quasithin.H CFSG.Quasithin.H.Sp4 CFSG.Assembly.LowTwoRank in
open scoped Matrix in
private theorem burnsideKD_center_eq_bot_of_nat {V : Type} [CommGroup V] [Finite V]
    {L : Subgroup (MulAut V)} {K : Type} [Field K] [Finite K] [CharP K 2]
    (hreal : (FFModel.nat (StatedSp 2 K)).Realizes L ⊤ ⊥) : Subgroup.center ↥L = ⊥ := by
  obtain ⟨π, hπ⟩ : ∃ π : ↥(StatedSp 2 K) →* ↥L, (FFModel.nat (StatedSp 2 K)).RealizesVia L ⊤ ⊥ π :=
    hreal
  obtain ⟨e, he⟩ := exists_mulEquiv_of_realizesVia (StatedSp 2 K) hπ
  have hγ : ∀ γ : ↥(StatedSp 2 K), congrHom e ((π γ : ↥L) : MulAut V) =
      natAut (StatedSp 2 K) γ := fun γ => by
    ext x
    rw [congrHom_apply, he, MulEquiv.apply_symm_apply]
    rfl
  have hLe := map_congrHom_eq_natImage (StatedSp 2 K) hπ.1 e he
  rw [eq_bot_iff]
  intro z hz
  rw [Subgroup.mem_bot]
  have hz' := Subgroup.mem_center_iff.mp hz
  obtain ⟨γ, hγz⟩ : congrHom e (z : MulAut V) ∈ natImage (StatedSp 2 K) := by
    rw [← hLe]
    exact ⟨z, z.2, rfl⟩
  have hcomm : ∀ γ' : ↥(StatedSp 2 K), congrHom e (z : MulAut V) * natAut (StatedSp 2 K) γ' =
      natAut (StatedSp 2 K) γ' * congrHom e (z : MulAut V) := by
    intro γ'
    have h1 := congrArg (fun g : ↥L => congrHom e (g : MulAut V)) (hz' (π γ'))
    simp only [Subgroup.coe_mul, map_mul, hγ] at h1
    exact h1.symm
  let F : (Fin 2 ⊕ Fin 2 → K) →+ (Fin 2 ⊕ Fin 2 → K) :=
    AddMonoidHom.mk' (toAddMap (congrHom e (z : MulAut V))) (toAddMap_add _)
  obtain ⟨c, hc⟩ := hasScalarCommutant_statedSp F fun γ hγ' v => by
    have := congrArg (fun y => toAddMap y v) (hcomm ⟨γ, hγ'⟩)
    simp only [toAddMap_mul, toAddMap_natAut] at this
    exact this
  have hcv : ∀ v, ((γ : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) *ᵥ v =
      c • v := fun v => by
    have := hc v
    change toAddMap (congrHom e (z : MulAut V)) v = c • v at this
    rw [← hγz, toAddMap_natAut] at this
    exact this
  have hc1 : c = 1 := by
    have h1 := CFSG.RankThree.SubgroupLists.spForm_mulVec γ.2 CFSG.RankThree.SubgroupLists.spE
      (Pi.single (Sum.inr 0) 1)
    simp only [hcv, map_smul, LinearMap.smul_apply, smul_eq_mul,
      CFSG.RankThree.SubgroupLists.spForm_spE_left, Pi.single_eq_same, mul_one] at h1
    apply eq_one_of_pow_four
    have h2 : c * c = 1 := h1
    calc c ^ 4 = (c * c) * (c * c) := by ring
      _ = 1 := by rw [h2, mul_one]
  have hz1 : congrHom e (z : MulAut V) = 1 := by
    apply toAddMap_injective
    intro v
    have := hc v
    change toAddMap (congrHom e (z : MulAut V)) v = c • v at this
    rw [this, hc1, one_smul, toAddMap_one]
  exact Subtype.ext (congrHom_injective e (hz1.trans (map_one (congrHom e)).symm))

private theorem burnsideKD_exists_conj_le_sylow {Ω : Type} [Group Ω] [Finite Ω]
    {G T R : Subgroup Ω} (hT : CFSG.QuasithinUnique.IsSylowTwoOf T G) (hRG : R ≤ G)
    (hR : IsPGroup 2 R) : ∃ x ∈ G, ∀ r ∈ R, x * r * x⁻¹ ∈ T := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hT2 : IsPGroup 2 (T.subgroupOf G) := hT.2.1.comap_subtype
  let P : Sylow 2 ↥G := hT2.toSylow hT.2.2
  have hR2 : IsPGroup 2 (R.subgroupOf G) := hR.comap_subtype
  obtain ⟨Q, hQ⟩ := hR2.exists_le_sylow
  obtain ⟨y, hy⟩ := MulAction.exists_smul_eq (↥G) Q P
  refine ⟨y, y.2, fun r hr => ?_⟩
  have hrQ : (⟨r, hRG hr⟩ : ↥G) ∈ Q := hQ (Subgroup.mem_subgroupOf.mpr hr)
  have h1 : y * ⟨r, hRG hr⟩ * y⁻¹ ∈ ((y • Q : Sylow 2 ↥G) : Subgroup ↥G) := by
    rw [Sylow.coe_subgroup_smul, Subgroup.mem_smul_pointwise_iff_exists]
    exact ⟨_, hrQ, by simp [MulAut.smul_def, MulAut.conj_apply]⟩
  rw [hy] at h1
  have h2 : y * ⟨r, hRG hr⟩ * y⁻¹ ∈ T.subgroupOf G := (IsPGroup.mem_toSylow hT2 hT.2.2).mp h1
  exact Subgroup.mem_subgroupOf.mp h2

