    have hs0 : (0 : ℚ) < ((4 * s : ℕ) : ℚ) := by exact_mod_cast (by omega : 0 < 4 * s)
    rw [div_eq_iff (ne_of_gt hs0)] at h1
    have h2 : (rkIdx (fixV A₀) : ℚ) = ((5 * s : ℕ) : ℚ) := by
      rw [h1]
      push_cast
      ring
    exact_mod_cast h2
  have hrkfix : rk ↥(fixV X) = 4 * s := by
    have h1 := rk_add_rkIdx (fixV X)
    rw [hXidx, hidx5, hrkV] at h1
    omega
  refine ⟨F, hFfield, hFfin, hFchar, π, burnsideKC_Wmat Ag, X, hFcard, hπ, hDyn,
    burnsideKC_finrank_Wmat Ag, hXmk, ⟨hh, ?_, hXel'⟩, hXrk', hrkfix, hrX, ?_, ?_⟩
  · intro h0
    rw [h0, rk_bot] at hXrk'
    omega
  · rw [hXdef, burnsideKC_commSeries_map_conj, hA₀3, Subgroup.map_bot]
  · intro A hA hAr
    have hAG : IsA2 G A := ⟨hA.1.trans hT.1, hA.2.1, hA.2.2⟩
    obtain ⟨hAL, hArk, hAr5⟩ := hinner A hAG hAr
    have hAP : A ≤ P' := by
      rw [← hTL]
      exact le_inf hA.1 hAL
    have hAcard : Nat.card F ^ 2 ≤ Nat.card A := by
      rw [hq2s, card_eq_two_pow_of_isPGroup hA.2.2.isPGroup, hArk]
    rcases hclass A hAP hA.2.2 hAcard with h1 | h2
    · rw [h1, hXcase]
    · exfalso
      have h3 := burnsideKC_rAV_conj g P₂
      rw [← h2] at h3
      linarith

@[expose] def K_3_3 : Prop :=
  ∀ (V : Type) [CommGroup V] [Finite V] (G L : Subgroup (MulAut V)), KSetup V G L →
    ∀ s : ℕ, IsPSU 3 2 s (Lbar L) →
      2 ≤ s ∧ CFSG.Quasithin.IsSU3 (2 ^ s) ↥L ∧ (Even s → IsSimpleGroup ↥L) ∧
      (Odd s → Nat.card (Subgroup.center ↥L) = 3) ∧
      BinaryNaturalSU3 L ⊤ ⊥ s ∧ Nat.card V = 2 ^ (6 * s) ∧
      (∀ T, IsSylowTwoOf T G →
        rk ↥(ChIJK.omegaOne (T ⊓ L)) = s ∧ rk ↥(fixV (ChIJK.omegaOne (T ⊓ L))) = 4 * s ∧
          rAV (ChIJK.omegaOne (T ⊓ L)) = 2 ∧ Qset T = {ChIJK.omegaOne (T ⊓ L)}) ∧
      qOf G = qc 2 ∧ qhatOf G = qc 2

