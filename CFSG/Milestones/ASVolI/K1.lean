private theorem burnsideK3_card_hermSub {F : Type} [Field F] [CharP F 2] (a : ℕ) :
    Nat.card ↥(hermSub a (Fin 2 ⊕ Fin 2) F) = Nat.card ↥(hermA a (Fin 2 ⊕ Fin 2) F) :=
  Nat.card_congr
    { toFun := fun x => ⟨Multiplicative.toAdd (x : Multiplicative (Matrix (Fin 2 ⊕ Fin 2)
        (Fin 2 ⊕ Fin 2) F)), x.2⟩
      invFun := fun y => ⟨Multiplicative.ofAdd (y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) F), y.2⟩
      left_inv := fun x => rfl
      right_inv := fun y => rfl }

open CFSG.Quasithin CFSG.Quasithin.B45Sp4 in
private theorem burnsideK3_card_of_twisted {V : Type} [CommGroup V] [Finite V]
    {L : Subgroup (MulAut V)} {s : ℕ} (hs : 1 ≤ s) (h : TwistedTensorSp4 L ⊤ ⊥ s) :
    Nat.card V = 2 ^ (16 * s) := by
  obtain ⟨K, _, _, _, hK, π, hπ⟩ := h
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨-, -, -, -, -, -, -, β, hβs, hβk, -⟩ := hπ
  have hinj : Function.Injective β := by
    rw [injective_iff_map_eq_one]
    intro u hu
    have := (hβk u).1 hu
    exact Subtype.ext (Subgroup.mem_bot.1 this)
  have hbij : Function.Bijective β := ⟨hinj, hβs⟩
  have h1 : Nat.card ↥(⊤ : Subgroup V) =
      Nat.card (↥(FFModel.twistTensor s (StatedSp 2 K)).sec ⧸
        (FFModel.twistTensor s (StatedSp 2 K)).ker.subgroupOf (FFModel.twistTensor s (StatedSp 2 K)).sec) :=
    Nat.card_congr (Equiv.ofBijective β hbij)
  rw [Subgroup.card_top] at h1
  have h2 : Nat.card (↥(FFModel.twistTensor s (StatedSp 2 K)).sec ⧸
        (FFModel.twistTensor s (StatedSp 2 K)).ker.subgroupOf (FFModel.twistTensor s (StatedSp 2 K)).sec) =
      Nat.card ↥(hermSub s (Fin 2 ⊕ Fin 2) K) := by
    show Nat.card (↥(hermSub s (Fin 2 ⊕ Fin 2) K) ⧸ (⊥ : Subgroup _).subgroupOf (hermSub s (Fin 2 ⊕ Fin 2) K)) = _
    rw [Subgroup.bot_subgroupOf]
    exact Nat.card_congr (QuotientGroup.quotientBot).toEquiv
  rw [h2, burnsideK3_card_hermSub, card_hermA_four hs hK] at h1
  exact h1


