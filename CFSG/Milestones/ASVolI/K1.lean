open CFSG.ASVolI.ChIJK CFSG.Quasithin CFSG.QuasithinUnique in
private theorem burnsideKA_alt7_unique {V : Type} [CommGroup V] [Finite V]
    {G L T A A' : Subgroup (MulAut V)} (hV : ∀ v : V, v ^ 2 = 1) (C : Bridge.Alt57.Ctx G L 7)
    (hirr : XMod.IsIrrSec ↥L (⊥ : Subgroup V) ⊤) (hcard : Nat.card V = 2 ^ 4) (hGL : G = L)
    (hT2 : IsPGroup 2 T) (hTG : T ≤ G) (hAT : IsFFStarOffender T A)
    (hA'T : IsFFStarOffender T A') : A = A' := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hA : IsFFStarOffender G A := ⟨hAT.1.trans hTG, hAT.2⟩
  have hA' : IsFFStarOffender G A' := ⟨hA'T.1.trans hTG, hA'T.2⟩
  have hTL : T ≤ L := hGL ▸ hTG
  have hAL : A ≤ L := hAT.1.trans hTL
  have hA'L : A' ≤ L := hA'T.1.trans hTL
  obtain ⟨ι⟩ := C.iso
  let π : ↥(alternatingGroup (Fin 7)) ≃* ↥L := ι.symm
  have hPA := QuasithinUnique.B42A57.asB42A7Four_holds V hV G L A C hirr hA hcard π
  have hPA' := QuasithinUnique.B42A57.asB42A7Four_holds V hV G L A' C hirr hA' hcard π
  have hTs : IsPGroup 2 (T.subgroupOf L) :=
    IsPGroup.of_surjective hT2 (Subgroup.subgroupOfEquivOfLe hTL).symm.toMonoidHom
      (MulEquiv.surjective _)
  have hQ : IsPGroup 2 ↥((T.subgroupOf L).comap π.toMonoidHom) :=
    IsPGroup.comap_of_injective hTs π.toMonoidHom π.injective
  have hle : ∀ B : Subgroup (MulAut V), B ≤ T →
      (B.subgroupOf L).comap π.toMonoidHom ≤ (T.subgroupOf L).comap π.toMonoidHom := by
    intro B hB x hx
    exact Subgroup.mem_subgroupOf.2 (hB (Subgroup.mem_subgroupOf.1 hx))
  have heq := burnsideKA_alt7_perm hQ (hle A hAT.1) (hle A' hA'T.1) hPA hPA'
  have h1 : A.subgroupOf L = A'.subgroupOf L :=
    Subgroup.comap_injective (f := π.toMonoidHom) π.surjective heq
  have h2 := Subgroup.subgroupOf_inj.1 h1
  rwa [inf_of_le_left hAL, inf_of_le_left hA'L] at h2


open CFSG.ASVolI.ChIJK CFSG.Quasithin CFSG.QuasithinUnique in
private theorem burnsideKA_isAlt6_or_isHat {V : Type} [CommGroup V] [Finite V]
    {G L : Subgroup (MulAut V)} (hK : KSetup V G L) (h : IsAlt 6 (Lbar L)) :
    IsAlt 6 ↥L ∨ IsHat ↥L ↥(alternatingGroup (Fin 6)) := by
  obtain ⟨e⟩ := h
  have hq : CFSG.IsQuasisimple ↥L := hK.hyp.2.2.1
  haveI : Group.IsPerfect ↥L := hq.1
  have hW : ∀ w : V, w * w = 1 := fun w => by simpa [pow_two] using hK.elem2 w
  have hodd := Setup.Family.odd_card_center_of_irreducible hW (HatA6.irr_of_b4Hyp hK.hyp)
  let π : ↥L →* alternatingGroup (Fin 6) :=
    e.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center ↥L))
  have hπ : Function.Surjective π := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hker : π.ker = Subgroup.center ↥L := by
    ext x
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      MulEquiv.map_eq_one_iff, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  have h13 := (CFSG.SectionRank.alternating_small_odd_cover_bound (n := 6) (by norm_num)
    (by norm_num) π hπ hker.le (by rw [hker]; exact hodd)).2 (Or.inl rfl)
  rw [hker] at h13
  rcases h13 with h1 | h3
  · left
    exact B42Alt7.nonempty_iso_of_center (Subgroup.eq_bot_of_card_eq _ h1) ⟨e⟩
  · right
    exact ⟨hq, h3, ⟨e⟩⟩

open CFSG.ASVolI.ChIJK CFSG.Quasithin CFSG.QuasithinUnique in
private theorem burnsideKA_isAlt7_of_lbar {V : Type} [CommGroup V] [Finite V]
    {G L : Subgroup (MulAut V)} (hK : KSetup V G L) (h : IsAlt 7 (Lbar L)) : IsAlt 7 ↥L := by
  obtain ⟨e⟩ := h
  have hq : CFSG.IsQuasisimple ↥L := hK.hyp.2.2.1
