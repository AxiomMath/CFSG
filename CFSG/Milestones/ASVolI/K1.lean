private theorem burnsideKE_oTwoPrimeRes {V : Type} [CommGroup V] {G L : Subgroup (MulAut V)}
    (hLG : L ≤ G) (hLs : IsSimpleGroup ↥L) (ht : ∃ t ∈ L, t * t = 1 ∧ t ≠ 1)
    (hP2 : ∀ P : Subgroup (MulAut V), IsPGroup 2 P → P ≤ G → P ≤ L) :
    L = oTwoPrimeRes G := by
  apply le_antisymm
  · obtain ⟨t, htL, ht2, ht1⟩ := ht
    let t' : ↥L := ⟨t, htL⟩
    have hnt : t' ≠ 1 := fun h => ht1 (congrArg Subtype.val h)
    have hN : Subgroup.normalClosure ({t'} : Set ↥L) = ⊤ := by
      rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal
        (Subgroup.normalClosure ({t'} : Set ↥L)) with h | h
      · exfalso
        apply hnt
        have h1 := Subgroup.subset_normalClosure (Set.mem_singleton t')
        rw [h] at h1
        exact Subgroup.mem_bot.1 h1
      · exact h
    intro x hx
    have hx' : (⟨x, hx⟩ : ↥L) ∈ Subgroup.normalClosure ({t'} : Set ↥L) := by
      rw [hN]
      trivial
    have hle : Subgroup.normalClosure ({t'} : Set ↥L) ≤ (oTwoPrimeRes G).comap L.subtype := by
      rw [Subgroup.normalClosure, Subgroup.closure_le]
      intro y hy
      obtain ⟨u, hu, hconj⟩ := Group.mem_conjugatesOfSet_iff.1 hy
      obtain ⟨c, rfl⟩ := isConj_iff.1 hconj
      rw [Set.mem_singleton_iff] at hu
      subst hu
      refine Subgroup.subset_closure ⟨?_, 1, ?_⟩
      · exact hLG (L.mul_mem (L.mul_mem c.2 htL) (L.inv_mem c.2))
      · change ((c : MulAut V) * t * (c : MulAut V)⁻¹) ^ (2 ^ 1) = 1
        have : ((c : MulAut V) * t * (c : MulAut V)⁻¹) ^ 2 =
            (c : MulAut V) * (t * t) * (c : MulAut V)⁻¹ := by
          rw [pow_two]
          group
        rw [pow_one, this, ht2]
        group
    exact hle hx'
  · refine (Subgroup.closure_le _).2 ?_
    rintro g ⟨hgG, k, hk⟩
    have hP : IsPGroup 2 (Subgroup.zpowers g) := by
      rintro ⟨y, hy⟩
      obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
      refine ⟨k, Subtype.ext ?_⟩
      simp only [Subgroup.coe_pow, Subgroup.coe_one]
      rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hk, one_zpow]
    exact hP2 _ hP (Subgroup.zpowers_le.2 hgG) (Subgroup.mem_zpowers g)

