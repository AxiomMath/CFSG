open CFSG.Quasithin CFSG.Assembly.LowTwoRank CFSG.QuasithinUnique in
private theorem burnsideKB_natural_coords {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {n : ℕ}
    (h : BinaryNaturalSL L ⊤ ⊥ 2 n) :
    ∃ (K : Type) (_ : Field K) (_ : Fintype K), Fintype.card K = 2 ^ n ∧
      ∃ (θL : ↥L ≃* Matrix.SpecialLinearGroup (Fin 2) K) (e : V ≃* Multiplicative (Fin 2 → K)),
        ∀ (l : ↥L) (v : V), e ((l : MulAut V) v) = Multiplicative.ofAdd
          ((θL l : Matrix (Fin 2) (Fin 2) K).mulVec (Multiplicative.toAdd (e v))) := by
  obtain ⟨K, _, hKfin, hK, π, hπ⟩ := h
  have : Fintype K := Fintype.ofFinite K
  refine ⟨K, inferInstance, inferInstance, by rw [← Nat.card_eq_fintype_card, hK], ?_⟩
  obtain ⟨θ, hθ⟩ := H.exists_mulEquiv_of_realizesVia (StatedSL 2 K) hπ
  have hinj : Function.Injective π := by
    rw [injective_iff_map_eq_one]
    intro (γ : ↥(StatedSL 2 K)) hγ
    have hmat : ((γ : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) = 1 := by
      rw [Matrix.ext_iff_mulVec]
      intro x
      obtain ⟨v, hv⟩ := θ.surjective (Multiplicative.ofAdd x)
      have h1 : θ (((π γ : ↥L) : MulAut V) v) = natAct (StatedSL 2 K) γ (θ v) := hθ γ v
      rw [hγ, Subgroup.coe_one, MulAut.one_apply, hv] at h1
      have h2 := congrArg Multiplicative.toAdd h1
      simp only [natAct, toAdd_ofAdd] at h2
      rw [Matrix.one_mulVec]
      exact h2.symm
    exact Subtype.ext (Units.ext hmat)
  let πe : ↥(StatedSL 2 K) ≃* ↥L := MulEquiv.ofBijective π ⟨hinj, hπ.1⟩
  let θL : ↥L ≃* Matrix.SpecialLinearGroup (Fin 2) K :=
    πe.symm.trans (specialLinearGroupEquivStatedSL 2 K).symm
  refine ⟨θL, θ, fun l v => ?_⟩
  obtain ⟨γ, rfl⟩ := πe.surjective l
  have h1 : (θL (πe γ) : Matrix (Fin 2) (Fin 2) K) =
      ((γ : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) := by
    show (((specialLinearGroupEquivStatedSL 2 K).symm (πe.symm (πe γ)) :
      Matrix.SpecialLinearGroup (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) = _
    rw [MulEquiv.symm_apply_apply]
    rw [← specialLinearGroupEquivStatedSL_coe 2 K, MulEquiv.apply_symm_apply]
  rw [h1]
  exact hθ γ v

open CFSG.Quasithin CFSG.Assembly.LowTwoRank CFSG.QuasithinUnique in
private theorem burnsideKB_realizes_natural {V : Type} [CommGroup V] {L : Subgroup (MulAut V)}
    {n : ℕ}
    {F : Type} [Field F] [Fintype F] (hF : Fintype.card F = 2 ^ n)
    (θL : ↥L ≃* Matrix.SpecialLinearGroup (Fin 2) F) (e : V ≃* Multiplicative (Fin 2 → F))
    (he : ∀ (l : ↥L) (v : V), e ((l : MulAut V) v) = Multiplicative.ofAdd
      ((θL l : Matrix (Fin 2) (Fin 2) F).mulVec (Multiplicative.toAdd (e v)))) :
    BinaryNaturalSL L ⊤ ⊥ 2 n := by
  classical
  have hcardF : Nat.card F = 2 ^ n := by rw [Nat.card_eq_fintype_card, hF]
  set Γ := StatedSL 2 F with hΓ
  let π : ↥Γ →* ↥L :=
    θL.symm.toMonoidHom.comp (specialLinearGroupEquivStatedSL 2 F).symm.toMonoidHom
  have hπ : Function.Surjective π :=
    θL.symm.surjective.comp (specialLinearGroupEquivStatedSL 2 F).symm.surjective
  have hπe : ∀ (γ : ↥Γ) (v : V), e (((π γ : ↥L) : MulAut V) v) = natAct Γ γ (e v) := by
    intro γ v
    obtain ⟨M, rfl⟩ := (specialLinearGroupEquivStatedSL 2 F).surjective γ
    rw [he]
    simp [π, natAct, specialLinearGroupEquivStatedSL_coe]
  have hReal : (FFModel.nat Γ).RealizesVia L ⊤ ⊥ π :=
    G64.realizesVia_nat_of hπ bot_le (fun _ _ _ => trivial) (fun h z hz => by
      rw [Subgroup.mem_bot] at hz ⊢
      rw [hz, map_one]) (e.toMonoidHom.comp (⊤ : Subgroup V).subtype)
      (fun x => ⟨⟨e.symm x, trivial⟩, by simp⟩)
      (fun u => by
        rw [Subgroup.mem_bot]
        simp only [MonoidHom.comp_apply, Subgroup.coe_subtype, MulEquiv.coe_toMonoidHom,
          MulEquivClass.map_eq_one_iff])
      (fun γ u _ => hπe γ u)
  exact ⟨F, inferInstance, inferInstance, hcardF, π, hReal⟩

open CFSG.Quasithin CFSG.Assembly.LowTwoRank CFSG.QuasithinUnique in
private theorem burnsideKB_offender_le {V : Type} [CommGroup V] [Finite V] {G L : Subgroup
    (MulAut V)}
    (hHyp : B4Hyp G L) {n : ℕ} (hn : 1 ≤ n) {F : Type} [Field F] [Fintype F]
    (hF : Fintype.card F = 2 ^ n) (θL : ↥L ≃* Matrix.SpecialLinearGroup (Fin 2) F)
    (e : V ≃* Multiplicative (Fin 2 → F))
    (he : ∀ (l : ↥L) (v : V), e ((l : MulAut V) v) = Multiplicative.ofAdd
      ((θL l : Matrix (Fin 2) (Fin 2) F).mulVec (Multiplicative.toAdd (e v))))
    {B : Subgroup (MulAut V)} (hB : IsFFStarOffender G B) : B ≤ L := by
  classical
  have hcardF : Nat.card F = 2 ^ n := by rw [Nat.card_eq_fintype_card, hF]
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : CharP F 2 := charP_of_card_eq_prime_pow hF
  set Γ := StatedSL 2 F with hΓ
  let π : ↥Γ →* ↥L :=
    θL.symm.toMonoidHom.comp (specialLinearGroupEquivStatedSL 2 F).symm.toMonoidHom
  have hπ : Function.Surjective π :=
    θL.symm.surjective.comp (specialLinearGroupEquivStatedSL 2 F).symm.surjective
  have hπe : ∀ (γ : ↥Γ) (v : V), e (((π γ : ↥L) : MulAut V) v) = natAct Γ γ (e v) := by
    intro γ v
    obtain ⟨M, rfl⟩ := (specialLinearGroupEquivStatedSL 2 F).surjective γ
    rw [he]
    simp [π, natAct, specialLinearGroupEquivStatedSL_coe]
  have hLmap : L.map (H.congrHom e) = H.natImage Γ := H.map_congrHom_eq_natImage Γ hπ e hπe
  have hEN : B.map (H.congrHom e) ≤ H.natNorm Γ := by
    have h1 := Subgroup.map_mono (f := H.congrHom e)
      (hB.1.trans (B42L2.le_normalizer_of_b4Hyp hHyp))
    rwa [Subgroup.map_equiv_normalizer_eq L (MulAut.congr e), hLmap] at h1
  have hEl := (H.isElemAbelian2_map_congrHom e).2 hB.2.2.1
  have hoff : Nat.card (H.StdMod (Fin 2) F) ≤
      Nat.card (B.map (H.congrHom e)) * Nat.card (fixV (B.map (H.congrHom e))) := by
    rw [H.card_map_congrHom, H.fixV_map_congrHom,
      Subgroup.card_map_of_injective e.injective, ← Nat.card_congr e.toEquiv]
    exact B42L2.card_le_of_offender hB
  have h2 := B69.le_natImage_of_offender hn hcardF hEN (fun x hx => hEl.2 x hx)
    (fun x hx y hy => hEl.1 x hx y hy) hoff
  rw [← hLmap] at h2
  exact (H.map_congrHom_le_iff e).1 h2

open CFSG.Quasithin CFSG.Assembly.LowTwoRank CFSG.QuasithinUnique in
private theorem burnsideKB_card_fixV_le {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {n : ℕ}
    {F : Type} [Field F] [Fintype F] (hF : Fintype.card F = 2 ^ n)
    (θL : ↥L ≃* Matrix.SpecialLinearGroup (Fin 2) F) (e : V ≃* Multiplicative (Fin 2 → F))
    (he : ∀ (l : ↥L) (v : V), e ((l : MulAut V) v) = Multiplicative.ofAdd
      ((θL l : Matrix (Fin 2) (Fin 2) F).mulVec (Multiplicative.toAdd (e v))))
    {A : Subgroup (MulAut V)} (hAL : A ≤ L) (hA : A ≠ ⊥) : Nat.card (fixV A) ≤ 2 ^ n := by
  classical
  have hcardF : Nat.card F = 2 ^ n := by rw [Nat.card_eq_fintype_card, hF]
  obtain ⟨⟨a, haA⟩, ha1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hA
  have ha1' : a ≠ 1 := fun h => ha1 (Subtype.ext h)
  set M : Matrix (Fin 2) (Fin 2) F := (θL ⟨a, hAL haA⟩ : Matrix (Fin 2) (Fin 2) F) with hMdef
  have hM : M ≠ 1 := by
    intro h
    have h1 : θL ⟨a, hAL haA⟩ = 1 := Subtype.ext h
    have h2 : (⟨a, hAL haA⟩ : ↥L) = 1 := θL.injective (h1.trans (map_one θL).symm)
    exact ha1' (congrArg Subtype.val h2)
  let f : ↥(fixV A) → {x : Fin 2 → F // M.mulVec x = x} := fun v =>
    ⟨Multiplicative.toAdd (e v), by
      have h1 := he ⟨a, hAL haA⟩ v
      rw [show ((⟨a, hAL haA⟩ : ↥L) : MulAut V) (v : V) = v from v.2 a haA] at h1
      exact (congrArg Multiplicative.toAdd h1).symm⟩
  have hf : Function.Injective f := by
    intro v w hvw
    have h1 : e v = e w := Multiplicative.toAdd.injective (congrArg Subtype.val hvw)
    exact Subtype.ext (e.injective h1)
  calc Nat.card (fixV A) ≤ Nat.card {x : Fin 2 → F // M.mulVec x = x} :=
        Nat.card_le_card_of_injective f hf
    _ ≤ Nat.card F := B42L2.card_fixed_le M hM
    _ = 2 ^ n := hcardF

private theorem burnsideKB_sq_eq_one_of_fix {F : Type} [Field F] [CharP F 2]
    (M : Matrix (Fin 2) (Fin 2) F) (hdet : M.det = 1) (x : Fin 2 → F) (hx : x ≠ 0)
    (hMx : M.mulVec x = x) : M * M = 1 := by
  have h2 : (2 : F) = 0 := CharTwo.two_eq_zero
  have hx0 : M 0 0 * x 0 + M 0 1 * x 1 = x 0 := by
    have := congrFun hMx 0
    simpa [Matrix.mulVec, dotProduct, Fin.sum_univ_two] using this
  have hx1 : M 1 0 * x 0 + M 1 1 * x 1 = x 1 := by
    have := congrFun hMx 1
    simpa [Matrix.mulVec, dotProduct, Fin.sum_univ_two] using this
  have hd : M 0 0 * M 1 1 - M 0 1 * M 1 0 = 1 := by
    simpa [Matrix.det_fin_two] using hdet
  have e0 : x 0 * ((M 0 0 - 1) * (M 1 1 - 1) - M 0 1 * M 1 0) = 0 := by
    linear_combination (M 1 1 - 1) * hx0 - M 0 1 * hx1
  have e1 : x 1 * ((M 0 0 - 1) * (M 1 1 - 1) - M 0 1 * M 1 0) = 0 := by
    linear_combination (M 0 0 - 1) * hx1 - M 1 0 * hx0
  have hdet0 : (M 0 0 - 1) * (M 1 1 - 1) - M 0 1 * M 1 0 = 0 := by
    by_contra hne
    apply hx
    ext i
    fin_cases i
    · exact (mul_eq_zero.mp e0).resolve_right hne
    · exact (mul_eq_zero.mp e1).resolve_right hne
  have htr : M 0 0 + M 1 1 = 0 := by linear_combination (hd - hdet0) + h2
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]
  · linear_combination M 0 0 * htr - hd - h2
  · linear_combination M 0 1 * htr
  · linear_combination M 1 0 * htr
  · linear_combination M 1 1 * htr - hd - h2

private theorem burnsideKB_exists_fixed {V : Type} [CommGroup V] [Finite V] (hV2 : 2 ∣ Nat.card V)
    {P : Subgroup (MulAut V)} (hP : IsPGroup 2 P) : ∃ v : V, v ≠ 1 ∧ ∀ x ∈ P, x v = v := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h1 : (1 : V) ∈ MulAction.fixedPoints P V := fun x => map_one (x : MulAut V)
  obtain ⟨b, hb, hb1⟩ := hP.exists_fixed_point_of_prime_dvd_card_of_fixed_point V hV2 h1
  exact ⟨b, fun h => hb1 h.symm, fun x hx => hb ⟨x, hx⟩⟩

open CFSG.Quasithin CFSG.Assembly.LowTwoRank CFSG.QuasithinUnique in
private theorem burnsideKB_card_fixV_ge {V : Type} [CommGroup V] [Finite V] {L : Subgroup
    (MulAut V)}
    {n : ℕ} (hn : 1 ≤ n) {F : Type} [Field F] [Fintype F] (hF : Fintype.card F = 2 ^ n)
    (θL : ↥L ≃* Matrix.SpecialLinearGroup (Fin 2) F) (e : V ≃* Multiplicative (Fin 2 → F))
    (he : ∀ (l : ↥L) (v : V), e ((l : MulAut V) v) = Multiplicative.ofAdd
      ((θL l : Matrix (Fin 2) (Fin 2) F).mulVec (Multiplicative.toAdd (e v))))
    {P : Subgroup (MulAut V)} (hPL : P ≤ L) (hP : IsPGroup 2 P) :
    2 ^ n ≤ Nat.card (fixV P) := by
  classical
  have hcardF : Nat.card F = 2 ^ n := by rw [Nat.card_eq_fintype_card, hF]
  have hV2 : 2 ∣ Nat.card V := by
    rw [Nat.card_congr e.toEquiv]
    show 2 ∣ Nat.card (Fin 2 → F)
    rw [Nat.card_fun, Nat.card_fin, hcardF]
    exact (dvd_pow_self 2 (by omega : n ≠ 0)).pow (by norm_num)
  obtain ⟨v, hv1, hv⟩ := burnsideKB_exists_fixed hV2 hP
  set x : Fin 2 → F := Multiplicative.toAdd (e v) with hxdef
  have hx : x ≠ 0 := by
    intro h
    apply hv1
    apply e.injective
    rw [map_one]
    exact Multiplicative.toAdd.injective (by simpa [hxdef] using h)
  have hMx : ∀ (y : MulAut V) (hy : y ∈ P),
      (θL ⟨y, hPL hy⟩ : Matrix (Fin 2) (Fin 2) F).mulVec x = x := by
    intro y hy
    have h1 := he ⟨y, hPL hy⟩ v
    have h2 : ((⟨y, hPL hy⟩ : ↥L) : MulAut V) v = v := hv y hy
    rw [h2] at h1
    exact (congrArg Multiplicative.toAdd h1).symm
  have hfix : ∀ c : F, e.symm (Multiplicative.ofAdd (c • x)) ∈ fixV P := by
    intro c y hy
    apply e.injective
    have h1 := he ⟨y, hPL hy⟩ (e.symm (Multiplicative.ofAdd (c • x)))
    rw [MulEquiv.apply_symm_apply, toAdd_ofAdd, Matrix.mulVec_smul, hMx y hy] at h1
    rw [h1, MulEquiv.apply_symm_apply]
  let f : F → ↥(fixV P) := fun c => ⟨e.symm (Multiplicative.ofAdd (c • x)), hfix c⟩
  have hf : Function.Injective f := by
    intro c d hcd
    have h1 : c • x = d • x := by
      have := congrArg (fun w : ↥(fixV P) => Multiplicative.toAdd (e (w : V))) hcd
      simpa [f] using this
    obtain ⟨i, hi⟩ : ∃ i, x i ≠ 0 := by
      by_contra hno
      push Not at hno
      exact hx (funext hno)
    have h2 := congrFun h1 i
    simp only [Pi.smul_apply, smul_eq_mul] at h2
    exact mul_right_cancel₀ hi h2
  have := Nat.card_le_card_of_injective f hf
  rwa [hcardF] at this

open CFSG.Quasithin CFSG.Assembly.LowTwoRank CFSG.QuasithinUnique in
private theorem burnsideKB_isElemAbelian2 {V : Type} [CommGroup V] [Finite V] {L : Subgroup
    (MulAut V)}
    {n : ℕ} (hn : 1 ≤ n) {F : Type} [Field F] [Fintype F] (hF : Fintype.card F = 2 ^ n)
    (θL : ↥L ≃* Matrix.SpecialLinearGroup (Fin 2) F) (e : V ≃* Multiplicative (Fin 2 → F))
    (he : ∀ (l : ↥L) (v : V), e ((l : MulAut V) v) = Multiplicative.ofAdd
      ((θL l : Matrix (Fin 2) (Fin 2) F).mulVec (Multiplicative.toAdd (e v))))
    {P : Subgroup (MulAut V)} (hPL : P ≤ L) (hP : IsPGroup 2 P) : IsElemAbelian2 P := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : CharP F 2 := charP_of_card_eq_prime_pow hF
  have hcardF : Nat.card F = 2 ^ n := by rw [Nat.card_eq_fintype_card, hF]
  have hV2 : 2 ∣ Nat.card V := by
    rw [Nat.card_congr e.toEquiv]
    show 2 ∣ Nat.card (Fin 2 → F)
    rw [Nat.card_fun, Nat.card_fin, hcardF]
    exact (dvd_pow_self 2 (by omega : n ≠ 0)).pow (by norm_num)
  obtain ⟨v, hv1, hv⟩ := burnsideKB_exists_fixed hV2 hP
  set x : Fin 2 → F := Multiplicative.toAdd (e v) with hxdef
  have hx : x ≠ 0 := by
    intro h
    apply hv1
    apply e.injective
    rw [map_one]
    exact Multiplicative.toAdd.injective (by simpa [hxdef] using h)
  have hsq : ∀ y ∈ P, y * y = 1 := by
    intro y hy
    have hMx : (θL ⟨y, hPL hy⟩ : Matrix (Fin 2) (Fin 2) F).mulVec x = x := by
      have h1 := he ⟨y, hPL hy⟩ v
      have h2 : ((⟨y, hPL hy⟩ : ↥L) : MulAut V) v = v := hv y hy
      rw [h2] at h1
      exact (congrArg Multiplicative.toAdd h1).symm
    have hMM := burnsideKB_sq_eq_one_of_fix (θL ⟨y, hPL hy⟩ : Matrix (Fin 2) (Fin 2) F)
      (θL ⟨y, hPL hy⟩).2 x hx hMx
    have h1 : θL (⟨y, hPL hy⟩ * ⟨y, hPL hy⟩) = 1 := by
      apply Subtype.ext
      rw [map_mul, Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_one]
      exact hMM
    have h2 : (⟨y, hPL hy⟩ * ⟨y, hPL hy⟩ : ↥L) = 1 := θL.injective (h1.trans (map_one θL).symm)
    exact congrArg Subtype.val h2
  have hinv : ∀ z ∈ P, z⁻¹ = z := fun z hz => inv_eq_of_mul_eq_one_right (hsq z hz)
  refine ⟨fun a ha b hb => ?_, fun a ha => by rw [sq]; exact hsq a ha⟩
  have h1 := hinv (a * b) (P.mul_mem ha hb)
  rw [mul_inv_rev, hinv a ha, hinv b hb] at h1
  exact h1.symm

private theorem burnsideKB_card_eq_of_odd_index {M : Type*} [Group M] {L A : Subgroup M} (hAL :
    A ≤ L)
    (hA : IsPGroup 2 A) {n : ℕ} (hn : 1 ≤ n) (hL : Nat.card L = 2 ^ n * ((2 ^ n) ^ 2 - 1))
    (hodd : ¬ 2 ∣ (A.subgroupOf L).index) : Nat.card A = 2 ^ n := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hq2 : 2 ≤ 2 ^ n := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
  have hLpos : Nat.card L ≠ 0 := by
    rw [hL]
    refine Nat.mul_ne_zero (by positivity) ?_
    have : 4 ≤ (2 ^ n) ^ 2 := by nlinarith
    omega
  have : Finite L := Nat.finite_of_card_ne_zero hLpos
  have : Finite A := Finite.of_injective (Subgroup.inclusion hAL) (Subgroup.inclusion_injective hAL)
  obtain ⟨k, hk⟩ := IsPGroup.iff_card.mp hA
  have h1 := Subgroup.card_mul_index (A.subgroupOf L)
  rw [show Nat.card (A.subgroupOf L) = Nat.card A from
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAL).toEquiv, hL, hk] at h1
  have hcop : Nat.Coprime (2 ^ n) (A.subgroupOf L).index :=
    Nat.Coprime.pow_left n ((Nat.Prime.coprime_iff_not_dvd Nat.prime_two).2 hodd)
  have hdvd : 2 ^ n ∣ 2 ^ k := hcop.dvd_of_dvd_mul_right ⟨_, h1⟩
  have hle : n ≤ k := (Nat.pow_dvd_pow_iff_le_right (by norm_num)).mp hdvd
  have hk' := (CFSG.Quasithin.B42L2.card_le_of_isPGroup hAL hA hn hL).1
  rw [hk] at hk' ⊢
  have : k ≤ n := (Nat.pow_le_pow_iff_right (by norm_num)).mp hk'
  rw [le_antisymm this hle]


private theorem burnsideKB_eq_bot_of_isPGroup_two_of_odd {X : Type*} [Group X] [Finite X] {H :
    Subgroup X}
    (h2 : IsPGroup 2 ↥H) (hodd : Odd (Nat.card ↥H)) : H = ⊥ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨k, hk⟩ := IsPGroup.iff_card.1 h2
  rcases Nat.eq_zero_or_pos k with rfl | hk0
  · exact Subgroup.eq_bot_of_card_eq H (by rw [hk, pow_zero])
  · rw [hk] at hodd
    exact absurd ((Nat.even_pow' hk0.ne').2 even_two) (Nat.not_even_iff_odd.2 hodd)

open CFSG.Quasithin CFSG.Assembly.LowTwoRank CFSG.QuasithinUnique CFSG.QuasithinUnique.Setup.SL2Modules CFSG.QuasithinUnique.Setup.Layer CFSG.QuasithinUnique.Setup.Layer.Actor CFSG.Quasithin.JonesParshall CFSG.Quasithin.B45L2 in
private theorem burnsideKB_class_four {V : Type} [CommGroup V] {F : Type} [Field F] [Fintype F]
    [CharP F 2] {L : Subgroup (MulAut V)} (hirr : XMod.IsIrrSec ↥L (⊥ : Subgroup V) ⊤)
    (hF : Fintype.card F = 2 ^ 2) (θL : ↥L ≃* Matrix.SpecialLinearGroup (Fin 2) F)
    {W : Type} [AddCommGroup W] [Module (ZMod 2) W] [Finite W] (θ : V ≃* Multiplicative W) :
    (Nat.card (EndRing (repOf θ θL)) = 2 ^ 2 ∧ Module.finrank (EndRing (repOf θ θL)) W = 2) ∨
      ∃ s, 2 = 2 * s ∧ Nat.card (EndRing (repOf θ θL)) = 2 ^ s ∧
        Module.finrank (EndRing (repOf θ θL)) W = 4 := by
  classical
  have hF4 : Fintype.card F = 4 := by rw [hF]; norm_num
  set ρ := repOf θ θL with hρ
  have hirr' : ρ.IsIrreducible := repOf_isIrreducible θ θL hirr
  have : Fact ρ.IsIrreducible := ⟨hirr'⟩
  have hnt := B45L2.repOf_nontrivial θ θL
  let _ : Fintype (Projectivization F (Fin 2 → F)) := Fintype.ofFinite _
  have hW16 : Nat.card W = 16 := by
    obtain ⟨hcases, -, -, -, -, h16a, h16b⟩ :=
      irreducible_binary_SL2_four_module_production hF4 ρ hirr'
    rcases hcases with ⟨φ, hφ⟩ | ⟨φ, -⟩ | ⟨φ, -⟩
    · exfalso
      obtain ⟨g, hg⟩ := hnt
      apply hg
      apply LinearMap.ext
      intro w
      exact φ.injective (hφ g w)
    · rw [Nat.card_congr φ.toEquiv, h16a]
    · rw [Nat.card_congr φ.toEquiv, h16b]
  obtain ⟨d, hd1, hDcard, hdesc⟩ :=
    binary_SL2_irreducible_Frobenius_descent (n := 2) (by norm_num) hF ρ hnt
  have hfinD : Finite (EndRing ρ) := finite_endRing ρ
  have : Module.Finite (EndRing ρ) W := Module.Finite.of_finite
  obtain ⟨E, hEF, hEfin, hEchar, ιF, ιD, J, hJne, hJn, -, -, hdim⟩ :=
    hdesc (Module.finBasis (EndRing ρ) W)
  have hJ2 : J.card ≤ 2 := by
    calc J.card ≤ (Finset.range 2).card :=
          Finset.card_le_card (fun i hi => Finset.mem_range.mpr (hJn i hi))
      _ = 2 := Finset.card_range 2
  have hJ1 : 1 ≤ J.card := Finset.card_pos.mpr hJne
  have hWd : 2 ^ (d * 2 ^ J.card) = 2 ^ 4 := by
    rw [pow_mul, ← hDcard, ← hdim, ← natCard_eq_pow_finrank (ρ := ρ), hW16]
    norm_num
  have hexp : d * 2 ^ J.card = 4 := Nat.pow_right_injective le_rfl hWd
  rcases (by omega : J.card = 1 ∨ J.card = 2) with hJ | hJ
  · rw [hJ] at hexp hdim
    exact Or.inl ⟨by rw [hDcard]; congr 1; omega, hdim⟩
  · rw [hJ] at hexp hdim
    exact Or.inr ⟨1, rfl, by rw [hDcard]; congr 1; omega, hdim⟩

end BurnsideKB

