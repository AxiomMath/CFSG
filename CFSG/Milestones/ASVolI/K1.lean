@[expose] def burnsideK3_pi {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {K : Type} [Field K]
    [CharP K 2] {W : Type} [AddCommGroup W] [Module (ZMod 2) W] (θ : V ≃* Multiplicative W)
    (θL : ↥L ≃* ↥(antiSp K)) : ↥(antiSp K) →* (W ≃ₗ[ZMod 2] W) :=
  (binPsi θ).toMonoidHom.comp (L.subtype.comp θL.symm.toMonoidHom)

private theorem burnsideK3_pi_apply {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {K : Type}
    [Field K] [CharP K 2] {W : Type} [AddCommGroup W] [Module (ZMod 2) W]
    (θ : V ≃* Multiplicative W) (θL : ↥L ≃* ↥(antiSp K)) (g : ↥(antiSp K)) :
    burnsideK3_pi θ θL g = binPsi θ ((θL.symm g : ↥L) : MulAut V) := rfl

structure burnsideK3_Ctx (V : Type) [CommGroup V] (L : Subgroup (MulAut V)) (a : ℕ) where
  K : Type
  [instField : Field K]
  [instFinite : Finite K]
  [instChar : CharP K 2]
  W : Type
  [instAC : AddCommGroup W]
  [instMod : Module (ZMod 2) W]
  [instFW : Finite W]
  hK : Nat.card K = 2 ^ (2 * a)
  θ : V ≃* Multiplicative W
  θL : ↥L ≃* ↥(antiSp K)
  [irr : Fact (repOf (burnsideK3_pi θ θL)).IsIrreducible]
  hD : Nat.card (EndRing (repOf (burnsideK3_pi θ θL))) = 2 ^ a
  hdim : Module.finrank (EndRing (repOf (burnsideK3_pi θ θL))) W = 16
  j : ℕ
  φ : W ≃+ ↥(hermA a (Fin 2 ⊕ Fin 2) K)
  hφ : ∀ (g : ↥(antiSp K)) (w : W),
    (φ (burnsideK3_pi θ θL g w) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) =
      tw a (spMat (antiSpEquiv K ((minorAut K ^ j) g))) (φ w)

attribute [instance] burnsideK3_Ctx.instField burnsideK3_Ctx.instFinite burnsideK3_Ctx.instChar
  burnsideK3_Ctx.instAC burnsideK3_Ctx.instMod burnsideK3_Ctx.instFW burnsideK3_Ctx.irr

open CFSG.Quasithin.B42Sp4 in
private theorem burnsideK3_ctx {V : Type} [CommGroup V] [Finite V]
    (hV : ∀ v : V, v ^ 2 = 1) {G L : Subgroup (MulAut V)} (hHyp : B4Hyp G L)
    (hZ : Subgroup.center ↥L = ⊥) {a : ℕ} (ha : 1 ≤ a)
    (hmodel : StatedClassicalModel (↥L ⧸ Subgroup.center ↥L) .PSp 2 2 (2 * a))
    (hq2 : qhatOf G ≤ ((2 : ℚ) : WithTop ℚ)) (hVcard : Nat.card V = 2 ^ (16 * a)) :
    Nonempty (burnsideK3_Ctx V L a) := by
  classical
  have hf2 : 2 ≤ 2 * a := by omega
  obtain ⟨K, _, _, _, hK, ⟨θL⟩⟩ := exists_antiSp_equiv hZ hmodel
  have : Fintype K := Fintype.ofFinite K
  have hKf : Fintype.card K = 2 ^ (2 * a) := by rw [← Nat.card_eq_fintype_card]; exact hK
  have hV' : ∀ v : V, v * v = 1 := fun v => by rw [← pow_two]; exact hV v
  obtain ⟨W, _, _, _, ⟨θ⟩⟩ := exists_binModel_of_binary hV'
  set ψ := binPsi θ with hψ
  let πW : antiSp K →* (W ≃ₗ[ZMod 2] W) :=
    ψ.toMonoidHom.comp (L.subtype.comp θL.symm.toMonoidHom)
  have hπW : ∀ g, πW g = ψ ((θL.symm g : ↥L) : MulAut V) := fun g => rfl
  have hπinj : Function.Injective πW := fun g g' h => by
    have h1 := ψ.injective h
    exact θL.symm.injective (Subtype.ext h1)
  have hirrV := Bridge.TypeList.irr_of_isIrrSec hHyp.2.2.2
  have hirr : ∀ U : Submodule (ZMod 2) W, (∀ g, ∀ u ∈ U, πW g u ∈ U) → U = ⊥ ∨ U = ⊤ := by
    intro U hU
    refine B42L2.irr_map θ hirrV U fun x hx u hu => ?_
    obtain ⟨l, hl, rfl⟩ := hx
    have h1 := hU (θL ⟨l, hl⟩) u hu
    rwa [hπW, MulEquiv.symm_apply_apply] at h1
  have hntW : Nontrivial W := by
    obtain ⟨v, -, hv⟩ := IsConcreteLE.exists_of_lt hHyp.2.2.2.1
    replace hv : v ≠ 1 := fun h => hv (h ▸ Subgroup.one_mem _)
    refine ⟨⟨Multiplicative.toAdd (θ v), 0, fun h => hv ?_⟩⟩
    have h1 : θ v = 1 := Multiplicative.toAdd.injective (by simpa using h)
    simpa using congrArg θ.symm h1
  have : Fact (repOf πW).IsIrreducible :=
    ⟨(CFSG.QuasithinUnique.Setup.X7.isIrreducible_iff (repOf πW)).mpr ⟨hntW, hirr⟩⟩
  have hπ'inj : Function.Injective (repOf πW) := fun g g' hg =>
    hπinj (LinearEquiv.toLinearMap_injective hg)
  have hπ'nt : ∃ g, repOf πW g ≠ 1 :=
    ⟨invX K, fun h1 => invX_ne_one (hπ'inj (h1.trans (map_one (repOf πW)).symm))⟩
  have hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)) := B42L2.le_normalizer_of_b4Hyp hHyp
  have hnormMap : ∀ B ≤ G, ∀ c ∈ B.map ψ.toMonoidHom, ∀ x, ∃ y, c * πW x * c⁻¹ = πW y := by
    rintro B hBG _ ⟨b, hb, rfl⟩ x
    have hl : b * ((θL.symm x : ↥L) : MulAut V) * b⁻¹ ∈ L :=
      (Subgroup.mem_normalizer_iff.mp (hGN (hBG hb)) _).mp (θL.symm x).2
    refine ⟨θL ⟨_, hl⟩, ?_⟩
    rw [hπW (θL _), MulEquiv.symm_apply_apply, hπW x]
    change ψ b * ψ ((θL.symm x : ↥L) : MulAut V) * (ψ b)⁻¹ =
      ψ (b * ((θL.symm x : ↥L) : MulAut V) * b⁻¹)
    rw [map_mul, map_mul, map_inv]
  have hcardMap : ∀ B : Subgroup (MulAut V), Nat.card ↥(B.map ψ.toMonoidHom) = Nat.card B :=
    fun B => Subgroup.card_map_of_injective ψ.injective
  have hfixMap : ∀ B : Subgroup (MulAut V),
      Nat.card {m : W // ∀ c ∈ B.map ψ.toMonoidHom, c m = m} = Nat.card ↥(fixV B) :=
    fun B => natCard_fixGL_map θ B
  have hcardVW : Nat.card V = Nat.card W := natCard_eq θ
  obtain ⟨A, hA2, -, hAr⟩ := kq_le_iff.mp hq2
  have hoffV := (rAV_le_two_iff' hV hA2).mp hAr
  have hA₀e := (isElemAbelian2_iff_map θ A).1 hA2.isElemAbelian2
  have hA₀1 : A.map ψ.toMonoidHom ≠ ⊥ := by
    rw [Ne, Subgroup.map_eq_bot_iff_of_injective A ψ.injective]
    exact hA2.ne_bot
  have hoff : Nat.card W ≤ Nat.card ↥(A.map ψ.toMonoidHom) ^ 2 *
      Nat.card {m : W // ∀ c ∈ A.map ψ.toMonoidHom, c m = m} := by
    rw [hcardMap, hfixMap, ← hcardVW]
    exact hoffV
  have hdim : Module.finrank (EndRing (repOf πW)) W ≠ 4 := by
    intro hdim
    obtain ⟨i, φ, hφ⟩ := exists_natural_of_four hKf (by omega) πW hπ'nt hdim
    have h1 : Nat.card W = Nat.card K ^ 4 := by
      rw [Nat.card_congr φ.toEquiv, Nat.card_fun, Nat.card_eq_fintype_card (α := Fin 4),
        Fintype.card_fin]
    rw [← hcardVW, hVcard, hK, ← pow_mul] at h1
    have h2 := Nat.pow_right_injective le_rfl h1
    omega
  obtain ⟨a', hfa, hD, hdim16⟩ :=
    twoF_label hf2 hK πW hπinj hdim _ (hnormMap A hA2.le) hA₀e hA₀1 hoff
  have haa : a' = a := by omega
  subst haa
  obtain ⟨j, φ, hφ⟩ := exists_hermA_equiv ha hKf πW hπ'nt hD hdim16
  have hirrπ : Fact (repOf (burnsideK3_pi θ θL)).IsIrreducible := this
  exact ⟨⟨K, W, hK, θ, θL, hD, hdim16, j, φ, hφ⟩⟩


private theorem burnsideK3_pi_injective {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {K : Type}
    [Field K] [CharP K 2] {W : Type} [AddCommGroup W] [Module (ZMod 2) W]
    (θ : V ≃* Multiplicative W) (θL : ↥L ≃* ↥(antiSp K)) :
    Function.Injective (burnsideK3_pi θ θL) := fun g g' h => by
  have h1 := (binPsi θ).injective h
  exact θL.symm.injective (Subtype.ext h1)

private theorem burnsideK3_normMap {V : Type} [CommGroup V] {G L : Subgroup (MulAut V)} {K : Type}
    [Field K] [CharP K 2] {W : Type} [AddCommGroup W] [Module (ZMod 2) W]
    (hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)))
    (θ : V ≃* Multiplicative W) (θL : ↥L ≃* ↥(antiSp K)) :
    ∀ B ≤ G, ∀ c ∈ B.map (binPsi θ).toMonoidHom, ∀ x : ↥(antiSp K),
      ∃ y, c * burnsideK3_pi θ θL x * c⁻¹ = burnsideK3_pi θ θL y := by
  rintro B hBG _ ⟨b, hb, rfl⟩ x
  have hl : b * ((θL.symm x : ↥L) : MulAut V) * b⁻¹ ∈ L :=
    (Subgroup.mem_normalizer_iff.mp (hGN (hBG hb)) _).mp (θL.symm x).2
  refine ⟨θL ⟨_, hl⟩, ?_⟩
  rw [burnsideK3_pi_apply, burnsideK3_pi_apply, MulEquiv.symm_apply_apply]
  change binPsi θ b * binPsi θ ((θL.symm x : ↥L) : MulAut V) * (binPsi θ b)⁻¹ =
    binPsi θ (b * ((θL.symm x : ↥L) : MulAut V) * b⁻¹)
  rw [map_mul, map_mul, map_inv]

open CFSG.Quasithin.B42Sp4 in
private theorem burnsideK3_hbd {V : Type} [CommGroup V] [Finite V]
    {G L : Subgroup (MulAut V)} (hHyp : B4Hyp G L) {a : ℕ} (ha : 1 ≤ a)
    (C : burnsideK3_Ctx V L a) :
    ∀ B : Subgroup (MulAut V), IsA2 G B →
      Nat.card B ^ 2 * Nat.card ↥(fixV B) ≤ Nat.card V ∧
        (IsQuadratic B → Nat.card B ^ 2 * Nat.card ↥(fixV B) < Nat.card V) := by
  classical
  intro B hB
  have : Fintype C.K := Fintype.ofFinite C.K
  have hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)) := B42L2.le_normalizer_of_b4Hyp hHyp
  have hBe := (isElemAbelian2_iff_map C.θ B).1 hB.isElemAbelian2
  have hB1 : B.map (binPsi C.θ).toMonoidHom ≠ ⊥ := by
    rw [Ne, Subgroup.map_eq_bot_iff_of_injective B (binPsi C.θ).injective]
    exact hB.ne_bot
  have hdim4 : Module.finrank (EndRing (repOf (burnsideK3_pi C.θ C.θL))) C.W ≠ 4 := by
    rw [C.hdim]
    norm_num
  obtain ⟨h1, h2⟩ := w_bounds ha C.hK (burnsideK3_pi C.θ C.θL)
    (burnsideK3_pi_injective C.θ C.θL) hdim4 C.j C.φ C.hφ _
    (burnsideK3_normMap hGN C.θ C.θL B hB.le) hBe hB1
  have hcardMap : Nat.card ↥(B.map (binPsi C.θ).toMonoidHom) = Nat.card B :=
    Subgroup.card_map_of_injective (binPsi C.θ).injective
  have hfixMap : Nat.card {m : C.W // ∀ c ∈ B.map (binPsi C.θ).toMonoidHom, c m = m} =
      Nat.card ↥(fixV B) := natCard_fixGL_map C.θ B
  have hcardVW : Nat.card V = Nat.card C.W := natCard_eq C.θ
  rw [hcardMap, hfixMap, ← hcardVW] at h1 h2
  exact ⟨h1, fun hQ => h2 (B42L2.quad_map C.θ hQ)⟩


open CFSG.Quasithin.B42Sp4 in
private theorem burnsideK3_one_lt_qhat {V : Type} [CommGroup V] [Finite V]
    (hV : ∀ v : V, v ^ 2 = 1) {G L : Subgroup (MulAut V)} (hHyp : B4Hyp G L) {a : ℕ}
    (ha : 1 ≤ a) (C : burnsideK3_Ctx V L a) : ((1 : ℚ) : WithTop ℚ) < qhatOf G := by
  show ((1 : ℚ) : WithTop ℚ) < kq G 3
  rw [lt_kq_iff]
  intro B hB _
  have h2 := (two_le_rAV_iff hV hB).mpr (burnsideK3_hbd hHyp ha C B hB).1
  linarith

private theorem burnsideK3_dispRank_conj {M : Type} [AddCommGroup M] [Module (ZMod 2) M]
    (b t : M ≃ₗ[ZMod 2] M) : dispRank (b * t * b⁻¹) = dispRank t := by
  unfold dispRank
  have h : (b * t * b⁻¹).toLinearMap - 1 =
      b.toLinearMap ∘ₗ (t.toLinearMap - 1) ∘ₗ b⁻¹.toLinearMap := by
    ext v
    simp
  have hr : LinearMap.range b⁻¹.toLinearMap = ⊤ := LinearEquiv.range b⁻¹
  rw [h, LinearMap.range_comp, LinearMap.range_comp_of_range_eq_top _ hr]
  exact LinearEquiv.finrank_map_eq b _

private theorem burnsideK3_rk_minorAut_pow_odd {F : Type} [Field F] [CharP F 2] [Fintype F] {f : ℕ}
    (hodd : Odd f) (z : antiSp F) :
    rk0 ((minorAut F ^ f) z) = rk1 z ∧ rk1 ((minorAut F ^ f) z) = rk0 z := by
  have h1 := rank_natRepS_parity z f
  have h2 := rank_natRepS_parity z (f + 1)
  rw [rank_natRepS_eq] at h1 h2
  have hf : f % 2 = 1 := Nat.odd_iff.mp hodd
  have hf1 : (f + 1) % 2 = 0 := by omega
  simp only [hf, hf1, one_ne_zero, ite_false, ite_true] at h1 h2
  refine ⟨h1, ?_⟩
  rw [← h2, rk1, pow_succ', MulAut.mul_apply, minorAut_apply]


private theorem burnsideK3_disp_formula {V : Type} [CommGroup V] [Finite V] {L : Subgroup (MulAut V)}
    {a : ℕ} (ha : 1 ≤ a) (C : burnsideK3_Ctx V L a) :
    ∃ p : ℕ, ∀ z : ↥(antiSp C.K), z * z = 1 →
      dispRank (burnsideK3_pi C.θ C.θL z) * 2 +
        a * (4 - 2 * (if p % 2 = 0 then rk0 z else rk1 z)) ^ 2 = a * 16 := by
  classical
  have : Fintype C.K := Fintype.ofFinite C.K
  set π := burnsideK3_pi C.θ C.θL with hπ
  have hKf : Fintype.card C.K = 2 ^ (2 * a) := by
    rw [← Nat.card_eq_fintype_card]
    exact C.hK
  have hπ'inj : Function.Injective (repOf π) := fun g g' hg =>
    burnsideK3_pi_injective C.θ C.θL (LinearEquiv.toLinearMap_injective hg)
  have hπ'nt : ∃ g, repOf π g ≠ 1 :=
    ⟨invX C.K, fun h1 => invX_ne_one (hπ'inj (h1.trans (map_one (repOf π)).symm))⟩
  obtain ⟨d, hd1, hDcard, hdesc⟩ := sp4_descent hKf (by omega : 1 ≤ 2 * a) hπ'nt
  have hda : d = a := by
    have h := C.hD
    rw [hDcard] at h
    exact Nat.pow_right_injective le_rfl h
  subst hda
  have : Module.Finite (EndRing (repOf π)) C.W := Module.Finite.of_finite
  obtain ⟨E, _, _, _, ιF, ιD, S, hSne, hS, ⟨Φ⟩, hshift, hdimW⟩ :=
    hdesc (Module.finBasis (EndRing (repOf π)) C.W)
  let _ : Algebra C.K E := ιF.toAlgebra
  have hSc : S.card = 2 := by
    have h : 4 ^ S.card = 4 ^ 2 := by
      rw [← hdimW, C.hdim]
      norm_num
    exact Nat.pow_right_injective (by norm_num : 2 ≤ 4) h
  obtain ⟨x, y, hxy, hSxy⟩ := Finset.card_eq_two.mp hSc
  have hxS : x ∈ S := by rw [hSxy]; simp
  have hyS : y ∈ S := by rw [hSxy]; simp
  have hxlt : x < 2 * (2 * d) := Finset.mem_range.mp (hS hxS)
  have hpar : ∀ i ∈ S, i % 2 = x % 2 := by
    intro i hi
    have hmem : (x + 2 * d) % (2 * (2 * d)) ∈ shiftSet (2 * d) (2 * d) S :=
      Finset.mem_image_of_mem _ hxS
    rw [hshift, hSxy] at hmem
    simp only [Finset.mem_insert, Finset.mem_singleton] at hmem
    have hyx : y % 2 = x % 2 := by
      rcases hmem with h | h
      · exfalso
        rcases lt_or_ge (x + 2 * d) (2 * (2 * d)) with h1 | h1
        · rw [Nat.mod_eq_of_lt h1] at h
          omega
        · rw [Nat.mod_eq_sub_mod h1, Nat.mod_eq_of_lt (by omega)] at h
          omega
      · rcases lt_or_ge (x + 2 * d) (2 * (2 * d)) with h1 | h1
        · rw [Nat.mod_eq_of_lt h1] at h
          omega
        · rw [Nat.mod_eq_sub_mod h1, Nat.mod_eq_of_lt (by omega)] at h
          omega
    rw [hSxy] at hi
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi
    rcases hi with rfl | rfl
    · rfl
    · exact hyx
  refine ⟨x, fun z hz => ?_⟩
  have hdisp : dispRank (π z) = d * (tensorRepS E S z - 1).rank :=
    finrank_range_eq hDcard _ ιF ιD S Φ hdimW z
  have h1 := rank_tensorRepS_sub_one E S hz
  have hprod : ∏ i : S, (4 - 2 * (natRepS E (i : ℕ) z - 1).rank) =
      (4 - 2 * (if x % 2 = 0 then rk0 z else rk1 z)) ^ 2 := by
    have e : ∀ i : S, 4 - 2 * (natRepS E (i : ℕ) z - 1).rank =
        4 - 2 * (if x % 2 = 0 then rk0 z else rk1 z) := fun i => by
      rw [rank_natRepS_sub_one_eq, hpar i i.2]
    simp_rw [e]
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_coe, hSc]
  rw [hprod, hSc] at h1
  rw [hdisp]
  have h16 : (4 : ℕ) ^ 2 = 16 := by norm_num
  rw [h16] at h1
  calc d * (tensorRepS E S z - 1).rank * 2 + d * (4 - 2 * (if x % 2 = 0 then rk0 z else rk1 z)) ^ 2
      = d * ((tensorRepS E S z - 1).rank * 2 + (4 - 2 * (if x % 2 = 0 then rk0 z else rk1 z)) ^ 2) := by ring
    _ = d * 16 := by rw [h1]


private theorem burnsideK3_dynkin {V : Type} [CommGroup V] [Finite V] {G L : Subgroup (MulAut V)}
    (hHyp : B4Hyp G L) {a : ℕ} (ha : 1 ≤ a) (C : burnsideK3_Ctx V L a) :
    ∀ g ∈ G, ∃ (h : ↥(antiSp C.K)) (k : ℕ), ∀ x : ↥(antiSp C.K),
      burnsideK3_pi C.θ C.θL ((MulAut.conj h * minorAut C.K ^ (2 * k)) x) =
        binPsi C.θ g * burnsideK3_pi C.θ C.θL x * (binPsi C.θ g)⁻¹ := by
  classical
  intro g hg
  have : Fintype C.K := Fintype.ofFinite C.K
  have hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)) := B42L2.le_normalizer_of_b4Hyp hHyp
  set π := burnsideK3_pi C.θ C.θL with hπ
  have hπinj := burnsideK3_pi_injective C.θ C.θL
  have h₁ : ∀ x, ∃ y, binPsi C.θ g * π x * (binPsi C.θ g)⁻¹ = π y := fun x =>
    burnsideK3_normMap hGN C.θ C.θL G le_rfl _ ⟨g, hg, rfl⟩ x
  have h₂ : ∀ x, ∃ y, (binPsi C.θ g)⁻¹ * π x * (binPsi C.θ g) = π y := fun x => by
    have := burnsideK3_normMap hGN C.θ C.θL G le_rfl _ ⟨g⁻¹, G.inv_mem hg, rfl⟩ x
    simpa using this
  set α := inducedAut π hπinj (binPsi C.θ g) h₁ h₂ with hα
  have hn : 1 ≤ 2 * a := by omega
  obtain ⟨h, j, hj, hαj⟩ := aut_eq_conj_mul_pow hn C.hK α
  obtain ⟨p, hp⟩ := burnsideK3_disp_formula ha C
  have hjeven : Even j := by
    by_contra hodd
    rw [Nat.not_even_iff_odd] at hodd
    set x := invX C.K with hx
    set y := α x with hy
    have hπy : π y = binPsi C.θ g * π x * (binPsi C.θ g)⁻¹ := π_inducedAut π hπinj _ h₁ h₂ x
    have hxx : x * x = 1 := invX_mul_self
    have hyy : y * y = 1 := by
      rw [hy, ← map_mul, hxx, map_one]
    have hdy : dispRank (π y) = dispRank (π x) := by
      rw [hπy]
      exact burnsideK3_dispRank_conj _ _
    have hyeq : y = h * (minorAut C.K ^ j) x * h⁻¹ := by
      rw [hy, hαj]
      simp [MulAut.mul_apply, MulAut.conj_apply]
    have hr := burnsideK3_rk_minorAut_pow_odd hodd x
    have hy0 : rk0 y = 2 := by
      rw [hyeq, (rk_conj h _).1, hr.1, hx]
      exact rk1_invX
    have hy1 : rk1 y = 1 := by
      rw [hyeq, (rk_conj h _).2, hr.2, hx]
      exact rk0_invX
    have hx0 : rk0 x = 1 := rk0_invX
    have hx1 : rk1 x = 2 := rk1_invX
    have hpx : dispRank (π x) * 2 +
        a * (4 - 2 * (if p % 2 = 0 then rk0 x else rk1 x)) ^ 2 = a * 16 := hp x hxx
    have hpy : dispRank (π y) * 2 +
        a * (4 - 2 * (if p % 2 = 0 then rk0 y else rk1 y)) ^ 2 = a * 16 := hp y hyy
    rw [hdy] at hpy
    by_cases hpe : p % 2 = 0
    · simp only [hpe, if_true, hx0, hy0] at hpx hpy
      norm_num at hpx hpy
      omega
    · simp only [hpe, if_false, hx1, hy1] at hpx hpy
      norm_num at hpx hpy
      omega
  obtain ⟨k, rfl⟩ := hjeven
  refine ⟨h, k, fun x => ?_⟩
  have : (MulAut.conj h * minorAut C.K ^ (k + k)) = α := by
    rw [hαj, ← two_mul]
  rw [two_mul, this]
  exact π_inducedAut π hπinj _ h₁ h₂ x


open CFSG.Quasithin.B42Sp4 CFSG.QuasithinUnique.Setup.Layer CFSG.QuasithinUnique.Setup.Layer.Actor in
private theorem burnsideK3_realizesVia {V : Type} [CommGroup V] {W : Type} [AddCommGroup W]
    [Module (ZMod 2) W] {K : Type} [Field K] [CharP K 2] [Finite K] {a : ℕ} (hK : Nat.card K = 2 ^ (2 * a)) (θ : V ≃* Multiplicative W)
    (L : Subgroup (MulAut V)) (δ : ↥L ≃* StatedSp 2 K) (φ : W ≃+ ↥(hermA a (Fin 2 ⊕ Fin 2) K))
    (hφ : ∀ (l : ↥L) (w : W), (φ (binPsi θ (l : MulAut V) w)).1 = tw a (spMat (δ l)) (φ w).1) :
    (FFModel.twistTensor a (StatedSp 2 K)).RealizesVia L ⊤ ⊥ δ.symm.toMonoidHom := by
  classical
  let e : V → ↥(hermSub a (Fin 2 ⊕ Fin 2) K) := fun v =>
    ⟨Multiplicative.ofAdd (φ (Multiplicative.toAdd (θ v))).1, (φ (Multiplicative.toAdd (θ v))).2⟩
  have he_mul : ∀ v w, e (v * w) = e v * e w := by
    intro v w
    apply Subtype.ext
    simp [e]
  have he_one : e 1 = 1 := by
    apply Subtype.ext
    simp [e]
  have he_inj : ∀ v, e v = 1 → v = 1 := by
    intro v hv
    have h0 := congrArg Subtype.val hv
    have h1 : (φ (Multiplicative.toAdd (θ v))).1 = 0 := by
      simpa [e] using congrArg Multiplicative.toAdd h0
    have h2 : φ (Multiplicative.toAdd (θ v)) = 0 := Subtype.ext h1
    rw [AddEquiv.map_eq_zero_iff] at h2
    have h3 : θ v = 1 := Multiplicative.toAdd.injective h2
    simpa using congrArg θ.symm h3
  have he_surj : ∀ m : ↥(hermSub a (Fin 2 ⊕ Fin 2) K), ∃ v, e v = m := by
    intro m
    refine ⟨θ.symm (Multiplicative.ofAdd (φ.symm ⟨Multiplicative.toAdd
      (m : Multiplicative (Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K)), m.2⟩)), ?_⟩
    apply Subtype.ext
    simp [e]
  have he_act : ∀ (γ : StatedSp 2 K) (v : V),
      e (((δ.symm γ : ↥L) : MulAut V) v) = ⟨twistAct a (StatedSp 2 K) γ (e v),
        twistAct_mem_hermSub a _ hK γ (e v).2⟩ := by
    intro γ v
    apply Subtype.ext
    show Multiplicative.ofAdd (φ (Multiplicative.toAdd (θ (((δ.symm γ : ↥L) : MulAut V) v)))).1
      = _
    rw [← B42L2.toAdd_binPsi, hφ, MulEquiv.apply_symm_apply]
    rfl
  let β : ↥(⊤ : Subgroup V) →* ↥(hermSub a (Fin 2 ⊕ Fin 2) K) ⧸
      ((⊥ : Subgroup (Multiplicative (Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K))).subgroupOf
        (hermSub a (Fin 2 ⊕ Fin 2) K)) :=
    { toFun := fun u => QuotientGroup.mk (e u)
      map_one' := by
        show QuotientGroup.mk (e 1) = 1
        rw [he_one]
        rfl
      map_mul' := fun u u' => by
        show QuotientGroup.mk (e ((u : V) * u')) = _
        rw [he_mul]
        rfl }
  have hmk : ∀ x y : ↥(hermSub a (Fin 2 ⊕ Fin 2) K),
      (QuotientGroup.mk x : ↥(hermSub a (Fin 2 ⊕ Fin 2) K) ⧸
        ((⊥ : Subgroup (Multiplicative (Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K))).subgroupOf
          (hermSub a (Fin 2 ⊕ Fin 2) K))) = QuotientGroup.mk y ↔ x = y := by
    intro x y
    rw [QuotientGroup.eq, Subgroup.mem_subgroupOf, Subgroup.mem_bot, Subgroup.coe_mul,
      Subgroup.coe_inv, inv_mul_eq_one]
    exact Subtype.ext_iff.symm
  refine ⟨δ.symm.surjective, bot_le, bot_le, fun _ _ _ => trivial, fun h z hz => ?_,
    fun γ m hm => twistAct_mem_hermSub a _ hK γ hm, fun γ m hm => ?_, β, ?_, fun u => ?_, ?_⟩
  · rw [Subgroup.mem_bot] at hz ⊢
    rw [hz, map_one]
  · have hm' : m = 1 := hm
    show twistAct a (StatedSp 2 K) γ m ∈ (⊥ : Subgroup _)
    rw [Subgroup.mem_bot, hm']
    exact act_map_one (twistAct a (StatedSp 2 K)) γ (twistAct_mul a _ γ)
  · intro q
    induction q using QuotientGroup.induction_on with
    | H m =>
      obtain ⟨v, hv⟩ := he_surj m
      exact ⟨⟨v, trivial⟩, by
        show QuotientGroup.mk (e v) = _
        rw [hv]
        rfl⟩
  · show (QuotientGroup.mk (e u) : ↥(hermSub a (Fin 2 ⊕ Fin 2) K) ⧸
        ((⊥ : Subgroup (Multiplicative (Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K))).subgroupOf
          (hermSub a (Fin 2 ⊕ Fin 2) K))) = 1 ↔ (u : V) ∈ ⊥
    rw [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf, Subgroup.mem_bot, Subgroup.mem_bot]
    constructor
    · intro h
      exact he_inj u (Subtype.ext h)
    · intro h
      rw [h, he_one]
      rfl
  · intro γ u m hu hm hum
    have hum' : e u = m := (hmk _ _).mp hum
    show (QuotientGroup.mk (e (((δ.symm γ : ↥L) : MulAut V) (u : V))) :
        ↥(hermSub a (Fin 2 ⊕ Fin 2) K) ⧸
          ((⊥ : Subgroup (Multiplicative (Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K))).subgroupOf
            (hermSub a (Fin 2 ⊕ Fin 2) K))) =
      QuotientGroup.mk (⟨twistAct a (StatedSp 2 K) γ m.1, hm⟩ : ↥(hermSub a (Fin 2 ⊕ Fin 2) K))
    rw [hmk]
    refine (he_act γ (u : V)).trans ?_
    apply Subtype.ext
    show twistAct a (StatedSp 2 K) γ (e u).1 = twistAct a (StatedSp 2 K) γ m.1
    rw [hum']



@[expose] noncomputable def burnsideK3_delta {V : Type} [CommGroup V] {L : Subgroup (MulAut V)}
    {a : ℕ} (C : burnsideK3_Ctx V L a) : ↥L ≃* ↥(StatedSp 2 C.K) :=
  C.θL.trans ((minorAut C.K ^ C.j).trans (antiSpEquiv C.K))

private theorem burnsideK3_delta_apply {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {a : ℕ}
    (C : burnsideK3_Ctx V L a) (l : ↥L) :
    burnsideK3_delta C l = antiSpEquiv C.K ((minorAut C.K ^ C.j) (C.θL l)) := rfl

theorem burnsideK3_hφL {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {a : ℕ}
    (C : burnsideK3_Ctx V L a) (l : ↥L) (w : C.W) :
    (C.φ (binPsi C.θ (l : MulAut V) w) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) C.K) =
      tw a (spMat (burnsideK3_delta C l)) (C.φ w) := by
  have h := C.hφ (C.θL l) w
  rw [burnsideK3_pi_apply, MulEquiv.symm_apply_apply] at h
  exact h

private theorem burnsideK3_realizes {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {a : ℕ}
    (C : burnsideK3_Ctx V L a) :
    (FFModel.twistTensor a (StatedSp 2 C.K)).RealizesVia L ⊤ ⊥
      (burnsideK3_delta C).symm.toMonoidHom :=
  burnsideK3_realizesVia C.hK C.θ L (burnsideK3_delta C) C.φ (burnsideK3_hφL C)

open CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher (fieldSp coe_fieldSp) in
private theorem burnsideK3_antiSpEquiv_pow {K : Type} [Field K] [CharP K 2] [Finite K] {Fr : K ≃+* K}
    (hFr : ∀ x, Fr x = x ^ 2) (k : ℕ) (w : ↥(antiSp K)) :
    antiSpEquiv K ((minorAut K ^ (2 * k)) w) = fieldSp 2 K (Fr ^ k) (antiSpEquiv K w) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [show 2 * (k + 1) = 2 + 2 * k by ring, pow_add, MulAut.mul_apply, minorAut_pow_two,
      antiSpEquiv_frobHom hFr, ih, pow_succ', map_mul]
    rfl


open CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher (fieldSp coe_fieldSp) in
@[expose] def burnsideK3_DynP {V : Type} [CommGroup V] (G L : Subgroup (MulAut V)) {K : Type}
    [Field K] [CharP K 2] [Finite K] (δ : ↥L ≃* ↥(StatedSp 2 K)) : Prop :=
  ∀ g ∈ G, ∃ (A : ↥(StatedSp 2 K)) (φ : K ≃+* K), ∀ (l : ↥L)
    (hmem : g * (l : MulAut V) * g⁻¹ ∈ L),
    δ ⟨g * (l : MulAut V) * g⁻¹, hmem⟩ = A * fieldSp 2 K φ (δ l) * A⁻¹

open CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher (fieldSp coe_fieldSp) in
private theorem burnsideK3_dynP {V : Type} [CommGroup V] [Finite V] {G L : Subgroup (MulAut V)}
    (hHyp : B4Hyp G L) {a : ℕ} (ha : 1 ≤ a) (C : burnsideK3_Ctx V L a) :
    burnsideK3_DynP G L (burnsideK3_delta C) := by
  classical
  have : Fintype C.K := Fintype.ofFinite C.K
  intro g hg
  obtain ⟨h, k, hk⟩ := burnsideK3_dynkin hHyp ha C g hg
  obtain ⟨Fr, hFr, -, -⟩ := exists_frobenius_data (by omega : 1 ≤ 2 * a) C.hK
  refine ⟨antiSpEquiv C.K ((minorAut C.K ^ C.j) h), Fr ^ k, fun l hmem => ?_⟩
  have hθ : C.θL ⟨g * (l : MulAut V) * g⁻¹, hmem⟩ =
      (MulAut.conj h * minorAut C.K ^ (2 * k)) (C.θL l) := by
    apply burnsideK3_pi_injective C.θ C.θL
    rw [hk, burnsideK3_pi_apply, burnsideK3_pi_apply, MulEquiv.symm_apply_apply,
      MulEquiv.symm_apply_apply]
    simp [map_mul]
  rw [burnsideK3_delta_apply, hθ]
  have e1 : (MulAut.conj h * minorAut C.K ^ (2 * k)) (C.θL l) =
      h * (minorAut C.K ^ (2 * k)) (C.θL l) * h⁻¹ := by
    simp [MulAut.mul_apply, MulAut.conj_apply]
  rw [e1, map_mul, map_mul, map_inv, map_mul, map_mul, map_inv]
  have e2 : (minorAut C.K ^ C.j) ((minorAut C.K ^ (2 * k)) (C.θL l)) =
      (minorAut C.K ^ (2 * k)) ((minorAut C.K ^ C.j) (C.θL l)) := by
    rw [← MulAut.mul_apply, ← MulAut.mul_apply, ← pow_add, ← pow_add, add_comm]
  rw [e2, burnsideK3_antiSpEquiv_pow hFr, ← burnsideK3_delta_apply]

open CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher (fieldSp coe_fieldSp) in
private theorem burnsideK3_dynP_conj {V : Type} [CommGroup V] {G L : Subgroup (MulAut V)} {K : Type}
    [Field K] [CharP K 2] [Finite K] {δ : ↥L ≃* ↥(StatedSp 2 K)}
    (hD : burnsideK3_DynP G L δ) (y : ↥(StatedSp 2 K)) :
    burnsideK3_DynP G L (δ.trans (MulAut.conj y)) := by
  intro g hg
  obtain ⟨A, φ, hA⟩ := hD g hg
  refine ⟨y * A * (fieldSp 2 K φ y)⁻¹, φ, fun l hmem => ?_⟩
  show y * δ ⟨g * (l : MulAut V) * g⁻¹, hmem⟩ * y⁻¹ = _
  rw [hA l hmem]
  show _ = _ * fieldSp 2 K φ (y * δ l * y⁻¹) * _
  rw [map_mul, map_mul, map_inv]
  group

open CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher (fieldSp coe_fieldSp) in
private theorem burnsideK3_trivialOnDynkinVia_of_dynP {V : Type} [CommGroup V] {G L : Subgroup (MulAut V)}
    (hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V))) {K : Type}
    [Field K] [CharP K 2] [Finite K] {δ : ↥L ≃* ↥(StatedSp 2 K)}
    (hD : burnsideK3_DynP G L δ) :
    CFSG.ASVolI.ChIJK.TrivialOnDynkinVia G L (StatedSp 2 K) δ.symm.toMonoidHom := by
  refine ⟨δ.symm.surjective, fun g hg => ?_⟩
  obtain ⟨A, φ, hA⟩ := hD g hg
  refine ⟨((A : ↥(StatedSp 2 K)) : GL (Fin 2 ⊕ Fin 2) K), φ, fun x => ?_⟩
  set l : ↥L := δ.symm x with hl
  have hmem : g * (l : MulAut V) * g⁻¹ ∈ L :=
    (Subgroup.mem_normalizer_iff.mp (hGN hg) _).mp l.2
  refine ⟨δ ⟨g * (l : MulAut V) * g⁻¹, hmem⟩, ?_, ?_⟩
  · rw [hA l hmem, hl, MulEquiv.apply_symm_apply]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, Units.val_mul, coe_fieldSp]
  · show (((δ.symm (δ ⟨g * (l : MulAut V) * g⁻¹, hmem⟩) : ↥L) : MulAut V)) =
      g * ((δ.symm x : ↥L) : MulAut V) * g⁻¹
    rw [MulEquiv.symm_apply_apply]

open CFSG.Quasithin.B45Sp4 in
@[expose] noncomputable def burnsideK3_twAdd {K : Type} [Field K] [CharP K 2] [Finite K] {a : ℕ}
    (hK : Nat.card K = 2 ^ (2 * a)) (y : ↥(StatedSp 2 K)) :
    ↥(hermA a (Fin 2 ⊕ Fin 2) K) ≃+ ↥(hermA a (Fin 2 ⊕ Fin 2) K) where
  toFun Y := ⟨tw a (spMat y) (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K),
    tw_mem_hermA hK _ Y.2⟩
  invFun Y := ⟨tw a (spMat y⁻¹) (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K),
    tw_mem_hermA hK _ Y.2⟩
  left_inv Y := by
    apply Subtype.ext
    show tw a (spM y⁻¹) (tw a (spM y) _) = _
    rw [← tw_mul, ← spM_mul, inv_mul_cancel, spM_one, tw_one]
  right_inv Y := by
    apply Subtype.ext
    show tw a (spM y) (tw a (spM y⁻¹) _) = _
    rw [← tw_mul, ← spM_mul, mul_inv_cancel, spM_one, tw_one]
  map_add' Y Z := by
    apply Subtype.ext
    exact tw_add a _ _ _

private theorem burnsideK3_twAdd_apply {K : Type} [Field K] [CharP K 2] [Finite K] {a : ℕ}
    (hK : Nat.card K = 2 ^ (2 * a)) (y : ↥(StatedSp 2 K)) (Y : ↥(hermA a (Fin 2 ⊕ Fin 2) K)) :
    ((burnsideK3_twAdd hK y Y : ↥(hermA a (Fin 2 ⊕ Fin 2) K)) :
      Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) =
      tw a (spMat y) (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) := rfl

structure burnsideK3_Coord (V : Type) [CommGroup V] (L : Subgroup (MulAut V)) (a : ℕ) where
  K : Type
  [instField : Field K]
  [instFinite : Finite K]
  [instChar : CharP K 2]
  W : Type
  [instAC : AddCommGroup W]
  [instMod : Module (ZMod 2) W]
  hK : Nat.card K = 2 ^ (2 * a)
  θ : V ≃* Multiplicative W
  δ : ↥L ≃* ↥(StatedSp 2 K)
  φ : W ≃+ ↥(hermA a (Fin 2 ⊕ Fin 2) K)
  hφL : ∀ (l : ↥L) (w : W),
    (φ (binPsi θ (l : MulAut V) w) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) =
      tw a (spMat (δ l)) (φ w)

attribute [instance] burnsideK3_Coord.instField burnsideK3_Coord.instFinite
  burnsideK3_Coord.instChar burnsideK3_Coord.instAC burnsideK3_Coord.instMod

@[reducible, expose] noncomputable def burnsideK3_Ctx.coord {V : Type} [CommGroup V] [Finite V]
    {L : Subgroup (MulAut V)} {a : ℕ} (C : burnsideK3_Ctx V L a) : burnsideK3_Coord V L a :=
  ⟨C.K, C.W, C.hK, C.θ, burnsideK3_delta C, C.φ, burnsideK3_hφL C⟩

@[reducible, expose] noncomputable def burnsideK3_Coord.conj {V : Type} [CommGroup V] {L : Subgroup (MulAut V)}
    {a : ℕ} (c : burnsideK3_Coord V L a) (y : ↥(StatedSp 2 c.K)) : burnsideK3_Coord V L a where
  K := c.K
  W := c.W
  hK := c.hK
  θ := c.θ
  δ := c.δ.trans (MulAut.conj y)
  φ := c.φ.trans (burnsideK3_twAdd c.hK y)
  hφL := fun l w => by
    show (tw a (spMat y) ((c.φ (binPsi c.θ (l : MulAut V) w) :
      ↥(hermA a (Fin 2 ⊕ Fin 2) c.K)) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) c.K)) =
      tw a (spMat (y * c.δ l * y⁻¹)) (tw a (spMat y) ((c.φ w : ↥(hermA a (Fin 2 ⊕ Fin 2) c.K)) :
        Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) c.K))
    rw [c.hφL, ← tw_mul, ← tw_mul]
    show tw a (spM y * spM (c.δ l)) _ = tw a (spM (y * c.δ l * y⁻¹) * spM y) _
    rw [← spM_mul, ← spM_mul, mul_assoc, inv_mul_cancel, mul_one]


open scoped Pointwise in
open CFSG.LocalAnalysis.ComponentInitial.SymplecticFlag (unipotent) in
open CFSG.LocalAnalysis.ComponentInitial.SymplecticFour (unique_symplectic_four_Sylow_center) in
private theorem burnsideK3_sylow {V : Type} [CommGroup V] [Finite V] {G L T : Subgroup (MulAut V)}
    (hLG : L ≤ G) (hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)))
    (hT : CFSG.QuasithinUnique.IsSylowTwoOf T G) {K : Type} [Field K] [CharP K 2] [Finite K]
    (δ : ↥L ≃* ↥(StatedSp 2 K)) :
    ∃ y : ↥(StatedSp 2 K), ∀ m : MulAut V, m ∈ T ⊓ L ↔
      ∃ u ∈ unipotent 2 K, ((δ.symm (y * u * y⁻¹) : ↥L) : MulAut V) = m := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hnorm : (L.subgroupOf G).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hLG).2 hGN
  obtain ⟨P₀, hP₀⟩ := CFSG.QuasithinUnique.RankOneRecog.exists_sylow_inf_of_subnormal hT hLG
    hnorm.isSubnormal
  obtain ⟨-, ⟨S, hS⟩, -⟩ := unique_symplectic_four_Sylow_center (K := K) (Nat.card K) rfl
  have hsurj : Function.Surjective δ.toMonoidHom := fun y => ⟨δ.symm y, δ.apply_symm_apply y⟩
  let P' : Sylow 2 ↥(StatedSp 2 K) := P₀.mapSurjective hsurj
  obtain ⟨h, hh⟩ := MulAction.exists_smul_eq (↥(StatedSp 2 K)) S P'
  have hP'eq : (P' : Subgroup ↥(StatedSp 2 K)) = (P₀ : Subgroup ↥L).map δ.toMonoidHom :=
    Sylow.coe_mapSurjective hsurj P₀
  have hP'h : (P' : Subgroup ↥(StatedSp 2 K)) =
      MulAut.conj h • (S : Subgroup ↥(StatedSp 2 K)) := by
    rw [← hh, Sylow.coe_subgroup_smul]
  refine ⟨h, fun m => ?_⟩
  constructor
  · intro hm
    rw [← hP₀] at hm
    obtain ⟨l, hl, rfl⟩ := hm
    have hδl : δ l ∈ (P' : Subgroup ↥(StatedSp 2 K)) := by
      rw [hP'eq]
      exact ⟨l, hl, rfl⟩
    rw [hP'h, Subgroup.mem_smul_pointwise_iff_exists] at hδl
    obtain ⟨u, hu, hu'⟩ := hδl
    refine ⟨u, by rw [← hS]; exact hu, ?_⟩
    have e : h * u * h⁻¹ = δ l := by
      simpa [MulAut.smul_def, MulAut.conj_apply] using hu'
    rw [e, MulEquiv.symm_apply_apply]
    rfl
  · rintro ⟨u, hu, rfl⟩
    rw [← hP₀]
    have hu' : u ∈ (S : Subgroup ↥(StatedSp 2 K)) := by rw [hS]; exact hu
    have hmem : h * u * h⁻¹ ∈ (P' : Subgroup ↥(StatedSp 2 K)) := by
      rw [hP'h, Subgroup.mem_smul_pointwise_iff_exists]
      exact ⟨u, hu', by simp [MulAut.smul_def, MulAut.conj_apply]⟩
    rw [hP'eq] at hmem
    obtain ⟨l, hl, hlu⟩ := hmem
    refine ⟨l, hl, ?_⟩
    have e : δ.symm (h * u * h⁻¹) = l := by
      rw [← hlu]
      exact δ.symm_apply_apply l
    rw [e]
    rfl


@[expose] def burnsideK3_eV {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {a : ℕ}
    (c : burnsideK3_Coord V L a) (v : V) : ↥(hermA a (Fin 2 ⊕ Fin 2) c.K) :=
  c.φ (Multiplicative.toAdd (c.θ v))

private theorem burnsideK3_eV_act {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {a : ℕ}
    (c : burnsideK3_Coord V L a) (l : ↥L) (v : V) :
    ((burnsideK3_eV c ((l : MulAut V) v) : ↥(hermA a (Fin 2 ⊕ Fin 2) c.K)) :
      Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) c.K) =
      tw a (spMat (c.δ l)) ((burnsideK3_eV c v : ↥(hermA a (Fin 2 ⊕ Fin 2) c.K)) :
        Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) c.K) := by
  have h := c.hφL l (Multiplicative.toAdd (c.θ v))
  rw [B42L2.toAdd_binPsi] at h
  exact h

private theorem burnsideK3_eV_injective {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {a : ℕ}
    (c : burnsideK3_Coord V L a) : Function.Injective (burnsideK3_eV c) := by
  intro v w h
  have h1 := c.φ.injective h
  have h2 := Multiplicative.toAdd.injective h1
  exact c.θ.injective h2

private theorem burnsideK3_eV_surjective {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {a : ℕ}
    (c : burnsideK3_Coord V L a) : Function.Surjective (burnsideK3_eV c) := by
  intro Y
  refine ⟨c.θ.symm (Multiplicative.ofAdd (c.φ.symm Y)), ?_⟩
  simp [burnsideK3_eV]

private theorem burnsideK3_eV_mul {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {a : ℕ}
    (c : burnsideK3_Coord V L a) (v w : V) :
    burnsideK3_eV c (v * w) = burnsideK3_eV c v + burnsideK3_eV c w := by
  simp [burnsideK3_eV]

open CFSG.Quasithin.B45Sp4 CFSG.Quasithin.B42Sp4 in
private theorem burnsideK3_card_fixV {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {a : ℕ}
    (c : burnsideK3_Coord V L a) (A : Subgroup (MulAut V)) (hAL : A ≤ L) :
    Nat.card ↥(fixV A) = Nat.card ↥(hermFix a (Fin 2 ⊕ Fin 2) c.K
      (spM '' (((A.subgroupOf L).map c.δ.toMonoidHom : Subgroup ↥(StatedSp 2 c.K)) :
        Set ↥(StatedSp 2 c.K)))) := by
  classical
  refine Nat.card_congr
    { toFun := fun v => ⟨((burnsideK3_eV c v.1 : ↥(hermA a (Fin 2 ⊕ Fin 2) c.K)) :
        Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) c.K), ?_⟩
      invFun := fun Y => ⟨Classical.choose (burnsideK3_eV_surjective c
          ⟨Y.1, (mem_hermFix.mp Y.2).1⟩), ?_⟩
      left_inv := fun v => ?_
      right_inv := fun Y => ?_ }
  · refine mem_hermFix.mpr ⟨(burnsideK3_eV c v.1).2, ?_⟩
    rintro _ ⟨_, ⟨l, hl, rfl⟩, rfl⟩
    have hlA : (l : MulAut V) ∈ A := hl
    have := burnsideK3_eV_act c l v.1
    rw [v.2 _ hlA] at this
    exact this.symm
  · intro l hl
    have hspec := Classical.choose_spec (burnsideK3_eV_surjective c ⟨Y.1, (mem_hermFix.mp Y.2).1⟩)
    set v := Classical.choose (burnsideK3_eV_surjective c ⟨Y.1, (mem_hermFix.mp Y.2).1⟩) with hv
    apply burnsideK3_eV_injective c
    apply Subtype.ext
    have h3 := burnsideK3_eV_act c ⟨l, hAL hl⟩ v
    have hY := (mem_hermFix.mp Y.2).2 (spM (c.δ ⟨l, hAL hl⟩))
      ⟨c.δ ⟨l, hAL hl⟩, ⟨⟨l, hAL hl⟩, hl, rfl⟩, rfl⟩
    have h2 : ((burnsideK3_eV c v : ↥(hermA a (Fin 2 ⊕ Fin 2) c.K)) :
        Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) c.K) = Y.1 := congrArg Subtype.val hspec
    rw [h2] at h3
    rw [h2]
    exact h3.trans hY
  · apply Subtype.ext
    apply burnsideK3_eV_injective c
    exact Classical.choose_spec (burnsideK3_eV_surjective c ⟨((burnsideK3_eV c v.1 :
      ↥(hermA a (Fin 2 ⊕ Fin 2) c.K)) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) c.K),
      (burnsideK3_eV c v.1).2⟩)
  · apply Subtype.ext
    have hspec := Classical.choose_spec (burnsideK3_eV_surjective c
      ⟨Y.1, (mem_hermFix.mp Y.2).1⟩)
    have := congrArg Subtype.val hspec
    exact this


private theorem burnsideK3_eV_one {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {a : ℕ}
    (c : burnsideK3_Coord V L a) : burnsideK3_eV c 1 = 0 := by
  simp [burnsideK3_eV]

private theorem burnsideK3_eV_inv {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {a : ℕ}
    (c : burnsideK3_Coord V L a) (v : V) : burnsideK3_eV c v⁻¹ = - burnsideK3_eV c v := by
  simp [burnsideK3_eV]

open CFSG.Quasithin.B45Sp4 CFSG.Quasithin.B42Sp4 in
private theorem burnsideK3_eV_cm {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {a : ℕ}
    (c : burnsideK3_Coord V L a) (l : ↥L) (v : V) :
    ((burnsideK3_eV c (cm (l : MulAut V) v) : ↥(hermA a (Fin 2 ⊕ Fin 2) c.K)) :
      Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) c.K) =
      twm a (c.δ l) ((burnsideK3_eV c v : ↥(hermA a (Fin 2 ⊕ Fin 2) c.K)) :
        Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) c.K) := by
  have h1 : cm (l : MulAut V) v = (l : MulAut V) v * v⁻¹ := rfl
  rw [h1, burnsideK3_eV_mul, burnsideK3_eV_inv, AddSubgroup.coe_add, AddSubgroup.coe_neg,
    burnsideK3_eV_act]
  rw [twm, sub_eq_add_neg]


open CFSG.LocalAnalysis.ComponentInitial.SymplecticFour (radical card_radical tau_comm tau_sq) in
open CFSG.Quasithin.B45Sp4 CFSG.Quasithin.B42Sp4 in
private theorem burnsideK3_X_facts {V : Type} [CommGroup V] [Finite V] {G L : Subgroup (MulAut V)}
    (hV : ∀ v : V, v ^ 2 = 1) (hLG : L ≤ G) {a : ℕ} (ha : 1 ≤ a)
    (c : burnsideK3_Coord V L a) (hVcard : Nat.card V = 2 ^ (16 * a))
    (hbd : ∀ B : Subgroup (MulAut V), IsA2 G B →
      Nat.card B ^ 2 * Nat.card ↥(fixV B) ≤ Nat.card V) :
    IsA2 G (((radical c.K).map c.δ.symm.toMonoidHom).map L.subtype) ∧
      rk ↥(((radical c.K).map c.δ.symm.toMonoidHom).map L.subtype) = 6 * a ∧
      commSeries (((radical c.K).map c.δ.symm.toMonoidHom).map L.subtype) 3 = ⊥ ∧
      rAV (((radical c.K).map c.δ.symm.toMonoidHom).map L.subtype) = 2 ∧
      rk ↥(fixV (((radical c.K).map c.δ.symm.toMonoidHom).map L.subtype)) = 4 * a := by
  classical
  set X : Subgroup (MulAut V) := ((radical c.K).map c.δ.symm.toMonoidHom).map L.subtype with hX
  have hmemX : ∀ x ∈ X, ∃ l : ↥L, (l : MulAut V) = x ∧ c.δ l ∈ radical c.K := by
    rintro _ ⟨_, ⟨r, hr, rfl⟩, rfl⟩
    exact ⟨c.δ.symm r, rfl, by simpa using hr⟩
  have hXL : X ≤ L := by
    intro x hx
    obtain ⟨l, rfl, -⟩ := hmemX x hx
    exact l.2
  have hXcard : Nat.card X = Nat.card c.K ^ 3 := by
    rw [hX, Subgroup.card_map_of_injective L.subtype_injective,
      Subgroup.card_map_of_injective c.δ.symm.injective, card_radical]
  have hXe : IsElemAbelian2 X := by
    refine ⟨fun x hx y hy => ?_, fun x hx => ?_⟩
    · obtain ⟨l, rfl, hl⟩ := hmemX x hx
      obtain ⟨m, rfl, hm⟩ := hmemX y hy
      obtain ⟨C, hC, hCe⟩ := hl
      obtain ⟨E, hE, hEe⟩ := hm
      have h1 : c.δ (l * m) = c.δ (m * l) := by
        rw [map_mul, map_mul, hCe, hEe, tau_comm]
      exact congrArg Subtype.val (c.δ.injective h1)
    · obtain ⟨l, rfl, hl⟩ := hmemX x hx
      obtain ⟨C, hC, hCe⟩ := hl
      have h1 : c.δ (l ^ 2) = c.δ 1 := by
        rw [map_pow, hCe, tau_sq, map_one]
      have h2 := c.δ.injective h1
      exact congrArg Subtype.val h2
  have hq1 : 1 < Nat.card c.K := Finite.one_lt_card_iff_nontrivial.mpr inferInstance
  have hXne : X ≠ ⊥ := by
    intro h
    have : Nat.card X = 1 := by rw [h, Subgroup.card_bot]
    rw [hXcard] at this
    have : 1 < Nat.card c.K ^ 3 := Nat.one_lt_pow (by norm_num) hq1
    omega
  have hX2 : IsA2 G X := ⟨hXL.trans hLG, hXne, hXe⟩
  have hXcubic : commSeries X 3 = ⊥ := by
    refine commSeries_three_eq_bot_of fun x hx y hy z hz v => ?_
    obtain ⟨lx, rfl, hlx⟩ := hmemX x hx
    obtain ⟨ly, rfl, hly⟩ := hmemX y hy
    obtain ⟨lz, rfl, hlz⟩ := hmemX z hz
    apply burnsideK3_eV_injective c
    apply Subtype.ext
    rw [burnsideK3_eV_cm, burnsideK3_eV_cm, burnsideK3_eV_cm, radical_cubic a hlx hly hlz,
      burnsideK3_eV_one]
    rfl
  have hmapX : (X.subgroupOf L).map c.δ.toMonoidHom = radical c.K := by
    ext g
    constructor
    · rintro ⟨l, hl, rfl⟩
      obtain ⟨l', hl'1, hl'2⟩ := hmemX _ hl
      have : l' = l := Subtype.ext hl'1
      rw [this] at hl'2
      exact hl'2
    · intro hg
      refine ⟨c.δ.symm g, ?_, c.δ.apply_symm_apply g⟩
      show ((c.δ.symm g : ↥L) : MulAut V) ∈ X
      exact ⟨c.δ.symm g, ⟨g, hg, rfl⟩, rfl⟩
  have hfix2 : Nat.card c.K ^ 2 ≤ Nat.card ↥(fixV X) := by
    have h := burnsideK3_card_fixV c X hXL
    rw [hmapX] at h
    rw [h]
    exact card_hermFix_radical ha c.hK
  have hcardV : Nat.card V = Nat.card c.K ^ 8 := by
    rw [hVcard, c.hK, ← pow_mul]
    ring_nf
  have hXr : rAV X = 2 := by
    refine le_antisymm ((rAV_le_two_iff' hV hX2).mpr ?_) ((two_le_rAV_iff hV hX2).mpr (hbd X hX2))
    rw [hXcard, hcardV]
    calc Nat.card c.K ^ 8 = (Nat.card c.K ^ 3) ^ 2 * Nat.card c.K ^ 2 := by ring
      _ ≤ (Nat.card c.K ^ 3) ^ 2 * Nat.card ↥(fixV X) := Nat.mul_le_mul_left _ hfix2
  have hfixeq : Nat.card ↥(fixV X) = Nat.card c.K ^ 2 := by
    refine le_antisymm ?_ hfix2
    have h := hbd X hX2
    rw [hXcard, hcardV] at h
    have hpos : 0 < (Nat.card c.K ^ 3) ^ 2 := by positivity
    refine Nat.le_of_mul_le_mul_left ?_ hpos
    calc (Nat.card c.K ^ 3) ^ 2 * Nat.card ↥(fixV X) ≤ Nat.card c.K ^ 8 := h
      _ = (Nat.card c.K ^ 3) ^ 2 * Nat.card c.K ^ 2 := by ring
  refine ⟨hX2, ?_, hXcubic, hXr, ?_⟩
  · have h1 := card_eq_two_pow_of_isPGroup hXe.isPGroup
    rw [hXcard, c.hK, ← pow_mul] at h1
    have h2 : 2 ^ (2 * a * 3) = 2 ^ rk ↥X := h1
    have := Nat.pow_right_injective le_rfl h2
    omega
  · have h1 := card_eq_two_pow_of_isPGroup ((isPGroup_two_of_sq_eq_one hV).to_subgroup (fixV X))
    rw [hfixeq, c.hK, ← pow_mul] at h1
    have h2 : 2 ^ (2 * a * 2) = 2 ^ rk ↥(fixV X) := h1
    have := Nat.pow_right_injective le_rfl h2
    omega


open CFSG.Quasithin.B42Sp4 in
private theorem burnsideK3_disp_ge {V : Type} [CommGroup V] [Finite V] {L : Subgroup (MulAut V)} {a : ℕ}
    (ha : 1 ≤ a) (C : burnsideK3_Ctx V L a) :
    ∀ l : ↥L, l * l = 1 → l ≠ 1 →
      2 ^ (6 * a) * Nat.card ↥(fixV (Subgroup.zpowers (l : MulAut V))) ≤ Nat.card V := by
  classical
  intro l hl hl1
  have : Fintype C.K := Fintype.ofFinite C.K
  set π := burnsideK3_pi C.θ C.θL with hπ
  have hKf : Fintype.card C.K = 2 ^ (2 * a) := by
    rw [← Nat.card_eq_fintype_card]
    exact C.hK
  have hπ'inj : Function.Injective (repOf π) := fun g g' hg =>
    burnsideK3_pi_injective C.θ C.θL (LinearEquiv.toLinearMap_injective hg)
  have hπ'nt : ∃ g, repOf π g ≠ 1 :=
    ⟨invX C.K, fun h1 => invX_ne_one (hπ'inj (h1.trans (map_one (repOf π)).symm))⟩
  have hdim4 : Module.finrank (EndRing (repOf π)) C.W ≠ 4 := by
    rw [C.hdim]
    norm_num
  set g : ↥(antiSp C.K) := C.θL l with hg
  have hgg : g * g = 1 := by
    rw [hg, ← map_mul, hl, map_one]
  have hg1 : g ≠ 1 := fun h => hl1 (C.θL.injective (h.trans (map_one C.θL).symm))
  have hdisp := (displacement_ge hKf (by omega : 1 ≤ 2 * a) π hπ'nt hdim4 hgg hg1).1
  have hπg : π g = binPsi C.θ (l : MulAut V) := by
    rw [hπ, burnsideK3_pi_apply, hg, MulEquiv.symm_apply_apply]
  set A : Subgroup (C.W ≃ₗ[ZMod 2] C.W) :=
    (Subgroup.zpowers (l : MulAut V)).map (binPsi C.θ).toMonoidHom with hA
  have hmem : π g ∈ A := by
    rw [hπg]
    exact ⟨(l : MulAut V), Subgroup.mem_zpowers _, rfl⟩
  have hN : 2 ^ (6 * a) ≤ 2 ^ dispRank (π g) :=
    Nat.pow_le_pow_right (by norm_num) (by omega)
  have h1 := mul_card_fixed_le A (π g) hmem hN
  have hfixMap : Nat.card {m : C.W // ∀ c ∈ A, c m = m} = Nat.card ↥(fixV (Subgroup.zpowers
      (l : MulAut V))) := natCard_fixGL_map C.θ _
  rw [hfixMap, ← natCard_eq C.θ] at h1
  exact h1


open scoped Matrix in
private theorem burnsideK3_fromBlocks_one_mulVec {K : Type} [Field K] (C : Matrix (Fin 2) (Fin 2) K)
    (v : Fin 2 ⊕ Fin 2 → K) (i : Fin 2) :
    (Matrix.fromBlocks (1 : Matrix (Fin 2) (Fin 2) K) C (0 : Matrix (Fin 2) (Fin 2) K)
        (1 : Matrix (Fin 2) (Fin 2) K) *ᵥ v) (Sum.inl i) =
      v (Sum.inl i) + ∑ j, C i j * v (Sum.inr j) ∧
    (Matrix.fromBlocks (1 : Matrix (Fin 2) (Fin 2) K) C (0 : Matrix (Fin 2) (Fin 2) K)
        (1 : Matrix (Fin 2) (Fin 2) K) *ᵥ v) (Sum.inr i) = v (Sum.inr i) := by
  constructor <;>
  simp [Matrix.mulVec, dotProduct, Fintype.sum_sum_type, Matrix.one_apply]

open CFSG.Quasithin CFSG.Quasithin.B42Sp4 in
open CFSG.LocalAnalysis.ComponentInitial.SymplecticFour (radical tau coe_tau) in
open CFSG.LocalAnalysis.ComponentInitial.SymplecticTorusWeyl (mem_statedSp_iff statedSp_ext) in
open scoped Matrix in
private theorem burnsideK3_mem_radical_iff {K : Type} [Field K] (g : ↥(StatedSp 2 K)) :
    g ∈ radical K ↔
      ((∀ v ∈ planeK K, ((g : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) *ᵥ
          v = v) ∧
        ∀ v, ((g : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) *ᵥ v - v ∈
          planeK K) := by
  constructor
  · rintro ⟨C, hC, rfl⟩
    refine ⟨fun v hv => ?_, fun v j => ?_⟩
    · have hv' : ∀ j, v (Sum.inr j) = 0 := hv
      funext x
      rcases x with i | i
      · rw [coe_tau, (burnsideK3_fromBlocks_one_mulVec C v i).1]
        simp [hv']
      · rw [coe_tau, (burnsideK3_fromBlocks_one_mulVec C v i).2]
    · rw [coe_tau]
      simp [(burnsideK3_fromBlocks_one_mulVec C v j).2]
  · rintro ⟨h1, h2⟩
    set A : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K :=
      ((g : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) with hA
    have hcol1 : ∀ (j : Fin 2) (x : Fin 2 ⊕ Fin 2),
        A x (Sum.inl j) = if x = Sum.inl j then 1 else 0 := by
      intro j x
      have := congrFun (h1 (Pi.single (Sum.inl j) 1) (fun k => by simp [Pi.single_apply])) x
      simpa [Matrix.mulVec, dotProduct, Pi.single_apply] using this
    have hcol2 : ∀ (j i : Fin 2), A (Sum.inr i) (Sum.inr j) = if i = j then 1 else 0 := by
      intro j i
      have := h2 (Pi.single (Sum.inr j) 1) i
      simpa [Matrix.mulVec, dotProduct, Pi.single_apply, sub_eq_zero] using this
    set B : Matrix (Fin 2) (Fin 2) K := fun i j => A (Sum.inl i) (Sum.inr j) with hB
    have hAeq : A = Matrix.fromBlocks 1 B 0 1 := by
      ext (i | i) (j | j)
      · simp [hcol1 j (Sum.inl i), Matrix.one_apply]
      · rfl
      · simp [hcol1 j (Sum.inr i), Matrix.one_apply]
      · simp [hcol2 j i, Matrix.one_apply]
    have hg := (mem_statedSp_iff).mp g.2
    rw [← hA, hAeq, Matrix.fromBlocks_transpose, Matrix.fromBlocks_multiply,
      Matrix.fromBlocks_multiply] at hg
    simp only [Matrix.transpose_one, Matrix.transpose_zero, Matrix.one_mul, Matrix.zero_mul,
      Matrix.mul_one, Matrix.mul_zero, add_zero, zero_add, Matrix.mul_neg, Matrix.neg_mul,
      Matrix.fromBlocks_inj] at hg
    have hsym : Bᵀ = B := by
      have := hg.2.2.2
      exact (neg_add_eq_zero.mp (by simpa using this)).symm
    refine ⟨B, hsym, CFSG.LocalAnalysis.ComponentInitial.SymplecticTorusWeyl.statedSp_ext ?_⟩
    rw [coe_tau]
    exact hAeq

open CFSG.Quasithin CFSG.Quasithin.B42Sp4 in
open CFSG.LocalAnalysis.ComponentInitial.SymplecticFour (radical) in
private theorem burnsideK3_planeUnipotent_eq_radical {K : Type} [Field K] :
    CFSG.ASVolI.ChIJK.planeUnipotent (StatedSp 2 K) (planeK K) = radical K := by
  unfold CFSG.ASVolI.ChIJK.planeUnipotent
  rw [← Subgroup.closure_eq (radical K)]
  congr 1
  ext g
  exact (burnsideK3_mem_radical_iff g).symm


open CFSG.Quasithin.B42Sp4 in
private theorem burnsideK3_isotropicPlane (K : Type) [Field K] [Finite K] :
    CFSG.ASVolI.ChIJK.IsSp4IsotropicPlane (planeK K) := by
  refine ⟨?_, fun v hv w hw => ?_⟩
  · have h1 := card_planeK (K := K)
    have h2 : Nat.card ↥(planeK K) = Nat.card K ^ Module.finrank K ↥(planeK K) :=
      Module.natCard_eq_pow_finrank
    have h3 : 1 < Nat.card K := Finite.one_lt_card_iff_nontrivial.mpr inferInstance
    exact Nat.pow_right_injective h3 (h2.symm.trans h1)
  · have hv' : ∀ j, v (Sum.inr j) = 0 := hv
    have hw' : ∀ j, w (Sum.inr j) = 0 := hw
    simp [hv', hw']


section Sym

open Matrix

variable {F : Type} [Field F] [CharP F 2] {ι : Type} [Fintype ι] [DecidableEq ι]

@[expose] def burnsideK3_S (a b : ι → F) : Matrix ι ι F :=
  Matrix.vecMulVec a b + Matrix.vecMulVec b a

private theorem burnsideK3_S_apply (a b : ι → F) (i j : ι) :
    burnsideK3_S a b i j = a i * b j + b i * a j := by
  simp [burnsideK3_S, Matrix.vecMulVec_apply]

private theorem burnsideK3_S_diag (a b : ι → F) (i : ι) : burnsideK3_S a b i i = 0 := by
  rw [burnsideK3_S_apply, mul_comm (b i) (a i), CharTwo.add_self_eq_zero]

private theorem burnsideK3_S_comm (a b : ι → F) : burnsideK3_S a b = burnsideK3_S b a := by
  unfold burnsideK3_S
  rw [add_comm]

private theorem burnsideK3_S_smul_left (c : F) (a b : ι → F) :
    burnsideK3_S (c • a) b = c • burnsideK3_S a b := by
  ext i j
  simp [burnsideK3_S_apply, mul_add, mul_assoc, mul_left_comm]

private theorem burnsideK3_S_add_right (a b b' : ι → F) :
    burnsideK3_S a (b + b') = burnsideK3_S a b + burnsideK3_S a b' := by
  ext i j
  simp only [burnsideK3_S_apply, Pi.add_apply, Matrix.add_apply]
  ring

private theorem burnsideK3_S_smul_right (c : F) (a b : ι → F) :
    burnsideK3_S a (c • b) = c • burnsideK3_S a b := by
  rw [burnsideK3_S_comm, burnsideK3_S_smul_left, burnsideK3_S_comm]

private theorem burnsideK3_S_eq_zero {a b : ι → F} (ha : a ≠ 0) (h : burnsideK3_S a b = 0) :
    ∃ l : F, b = l • a := by
  obtain ⟨i, hi⟩ : ∃ i, a i ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact ha (funext hcon)
  refine ⟨b i / a i, funext fun j => ?_⟩
  have := congrFun (congrFun h i) j
  rw [burnsideK3_S_apply, Matrix.zero_apply] at this
  have h2 : a i * b j = b i * a j := by
    have := eq_neg_of_add_eq_zero_left this
    rw [this, CharTwo.neg_eq]
  simp only [Pi.smul_apply, smul_eq_mul]
  field_simp
  linear_combination h2


private theorem burnsideK3_Phi_S (n : Matrix ι ι F) (a b : ι → F) :
    n * burnsideK3_S a b + burnsideK3_S a b * nᵀ =
      burnsideK3_S (n *ᵥ a) b + burnsideK3_S (n *ᵥ b) a := by
  unfold burnsideK3_S
  simp only [Matrix.mul_add, Matrix.add_mul, Matrix.mul_vecMulVec, Matrix.vecMulVec_mul,
    Matrix.vecMul_transpose]
  abel

private theorem burnsideK3_Phi_sq (n : Matrix ι ι F) (w : ι → F) :
    n * Matrix.vecMulVec w w + Matrix.vecMulVec w w * nᵀ = burnsideK3_S (n *ᵥ w) w := by
  simp only [burnsideK3_S, Matrix.mul_vecMulVec, Matrix.vecMulVec_mul, Matrix.vecMul_transpose]

private theorem burnsideK3_T_eq {n : Matrix ι ι F} (hnn : n * n = 0) {w : ι → F} (hv : n *ᵥ w ≠ 0)
    (x : ι → F) (c : F)
    (h : burnsideK3_S (n *ᵥ w) x + burnsideK3_S (n *ᵥ x) w = c • burnsideK3_S (n *ᵥ w) w) :
    c = 0 ∧ ∃ α β : F, x = α • w + β • (n *ᵥ w) := by
  set v := n *ᵥ w with hvdef
  have hnv : n *ᵥ v = 0 := by
    rw [hvdef, Matrix.mulVec_mulVec, hnn, Matrix.zero_mulVec]
  have hnnx : n *ᵥ (n *ᵥ x) = 0 := by
    rw [Matrix.mulVec_mulVec, hnn, Matrix.zero_mulVec]
  have h1 := congrArg (fun M => n * M) h
  simp only [Matrix.mul_add, Matrix.mul_smul] at h1
  have e1 : ∀ a b : ι → F, n * burnsideK3_S a b =
      Matrix.vecMulVec (n *ᵥ a) b + Matrix.vecMulVec (n *ᵥ b) a := fun a b => by
    simp [burnsideK3_S, Matrix.mul_add, Matrix.mul_vecMulVec]
  rw [e1, e1, e1, hnv, hnnx, ← hvdef] at h1
  simp only [Matrix.zero_vecMulVec, zero_add] at h1
  have h2 : burnsideK3_S (n *ᵥ x) v = c • Matrix.vecMulVec v v := by
    have : burnsideK3_S (n *ᵥ x) v = Matrix.vecMulVec (n *ᵥ x) v + Matrix.vecMulVec v (n *ᵥ x) := rfl
    rw [this, ← h1]
  obtain ⟨i, hi⟩ : ∃ i, v i ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hv (funext hcon)
  have hc : c = 0 := by
    have := congrFun (congrFun h2 i) i
    rw [burnsideK3_S_diag, Matrix.smul_apply, Matrix.vecMulVec_apply, smul_eq_mul] at this
    have h3 : c * (v i * v i) = 0 := this.symm
    rcases mul_eq_zero.mp h3 with h | h
    · exact h
    · exact absurd (mul_self_eq_zero.mp h) hi
  refine ⟨hc, ?_⟩
  subst hc
  rw [zero_smul] at h2 h
  obtain ⟨l, hl⟩ := burnsideK3_S_eq_zero hv (by rw [burnsideK3_S_comm]; exact h2)
  rw [hl, burnsideK3_S_smul_left] at h
  have h3 : burnsideK3_S v (x + l • w) = 0 := by
    rw [burnsideK3_S_add_right, burnsideK3_S_smul_right]
    simpa using h
  obtain ⟨μ, hμ⟩ := burnsideK3_S_eq_zero hv h3
  refine ⟨l, μ, ?_⟩
  funext j
  have := congrFun hμ j
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at this ⊢
  have h4 : x j = μ * v j + l * w j := by
    linear_combination this - (l * w j) * (CharTwo.two_eq_zero (R := F))
  rw [h4]
  ring

private theorem burnsideK3_S_add_left (a a' b : ι → F) :
    burnsideK3_S (a + a') b = burnsideK3_S a b + burnsideK3_S a' b := by
  rw [burnsideK3_S_comm, burnsideK3_S_add_right, burnsideK3_S_comm b a, burnsideK3_S_comm b a']

private theorem burnsideK3_S_transpose (a b : ι → F) : (burnsideK3_S a b)ᵀ = burnsideK3_S a b := by
  ext i j
  simp only [Matrix.transpose_apply, burnsideK3_S_apply]
  ring

variable (F ι) in
@[expose] def burnsideK3_Sym : Submodule F (Matrix ι ι F) where
  carrier := {Y | Yᵀ = Y}
  add_mem' := fun {Y Z} hY hZ => by
    simp only [Set.mem_setOf_eq] at *
    rw [Matrix.transpose_add, hY, hZ]
  zero_mem' := by simp
  smul_mem' := fun c Y hY => by
    simp only [Set.mem_setOf_eq] at *
    rw [Matrix.transpose_smul, hY]

private theorem burnsideK3_mem_Sym {Y : Matrix ι ι F} : Y ∈ burnsideK3_Sym F ι ↔ Yᵀ = Y := Iff.rfl

private theorem burnsideK3_finrank_sym (hι : Fintype.card ι = 4) :
    Module.finrank F (burnsideK3_Sym F ι) ≤ 10 := by
  classical
  let e : ι ≃ Fin 4 := Fintype.equivFinOfCardEq hι
  let f : burnsideK3_Sym F ι →ₗ[F] ({p : Fin 4 × Fin 4 // p.1 ≤ p.2} → F) :=
    { toFun := fun Y p => (Y : Matrix ι ι F) (e.symm p.1.1) (e.symm p.1.2)
      map_add' := fun Y Z => by
        ext p
        rfl
      map_smul' := fun c Y => by
        ext p
        rfl }
  have hf : Function.Injective f := by
    intro Y Z h
    apply Subtype.ext
    ext i j
    have hsymm : ∀ Y : burnsideK3_Sym F ι, ∀ i j, (Y : Matrix ι ι F) j i = (Y : Matrix ι ι F) i j :=
      fun Y i j => by
        have := Y.2
        rw [burnsideK3_mem_Sym] at this
        exact congrFun (congrFun this i) j
    rcases le_total (e i) (e j) with hij | hij
    · have := congrFun h ⟨(e i, e j), hij⟩
      simpa [f] using this
    · have := congrFun h ⟨(e j, e i), hij⟩
      simp only [f, LinearMap.coe_mk, AddHom.coe_mk, Equiv.symm_apply_apply] at this
      rw [← hsymm Y i j, ← hsymm Z i j]
      exact this
  have h1 := LinearMap.finrank_le_finrank_of_injective hf
  rw [Module.finrank_fintype_fun_eq_card] at h1
  refine h1.trans ?_
  decide +kernel

private theorem burnsideK3_card_sym_fix [Finite F] (hι : Fintype.card ι = 4) {z : Matrix ι ι F}
    (hz : z * z = 1) (hz1 : z ≠ 1) :
    Nat.card {Y : Matrix ι ι F // Yᵀ = Y ∧ z * Y * zᵀ = Y} ≤ Nat.card F ^ 7 := by
  classical
  obtain ⟨n, hn⟩ : ∃ n : Matrix ι ι F, n = z + 1 := ⟨_, rfl⟩
  have h2 : ∀ M : Matrix ι ι F, M + M = 0 := fun M => by
    ext i j
    simp [CharTwo.add_self_eq_zero]
  have hnn : n * n = 0 := by
    rw [hn, add_mul, mul_add, mul_add, hz, one_mul, mul_one, one_mul]
    have := h2 z
    calc (1 : Matrix ι ι F) + z + (z + 1) = (z + z) + (1 + 1) := by abel
      _ = 0 := by rw [h2 z, h2 1, add_zero]
  have hn0 : n ≠ 0 := by
    intro h
    apply hz1
    have := congrArg (fun M => M + 1) h
    simp only [hn, zero_add, add_assoc] at this
    rw [h2 1, add_zero] at this
    exact this
  obtain ⟨w, hw⟩ : ∃ w : ι → F, n *ᵥ w ≠ 0 := by
    by_contra h
    push Not at h
    apply hn0
    ext i j
    have := congrFun (h (Pi.single j 1)) i
    simpa [Matrix.mulVec, dotProduct, Pi.single_apply] using this
  let Φ : Matrix ι ι F →ₗ[F] Matrix ι ι F := LinearMap.mulLeft F n + LinearMap.mulRight F nᵀ
  have hΦ : ∀ Y, Φ Y = n * Y + Y * nᵀ := fun Y => rfl
  let ΦS := Φ.domRestrict (burnsideK3_Sym F ι)
  let Sx : (ι → F) →ₗ[F] Matrix ι ι F :=
    { toFun := fun x => burnsideK3_S (n *ᵥ w) x + burnsideK3_S (n *ᵥ x) w
      map_add' := fun x y => by
        simp only [Matrix.mulVec_add, burnsideK3_S_add_right, burnsideK3_S_add_left]
        abel
      map_smul' := fun c x => by
        simp only [Matrix.mulVec_smul, burnsideK3_S_smul_right, burnsideK3_S_smul_left, smul_add,
          RingHom.id_apply] }
  let Tt : ((ι → F) × F) →ₗ[F] Matrix ι ι F :=
    Sx.coprod (LinearMap.toSpanSingleton F (Matrix ι ι F) (burnsideK3_S (n *ᵥ w) w))
  have hTt : ∀ x c, Tt (x, c) = burnsideK3_S (n *ᵥ w) x + burnsideK3_S (n *ᵥ x) w + c • burnsideK3_S (n *ᵥ w) w :=
    fun x c => rfl
  have hrange : LinearMap.range Tt ≤ LinearMap.range ΦS := by
    rintro _ ⟨⟨x, c⟩, rfl⟩
    have hY : burnsideK3_S w x + c • Matrix.vecMulVec w w ∈ burnsideK3_Sym F ι := by
      rw [burnsideK3_mem_Sym, Matrix.transpose_add, Matrix.transpose_smul, burnsideK3_S_transpose]
      congr 2
      ext i j
      simp [Matrix.vecMulVec_apply, mul_comm]
    refine ⟨⟨_, hY⟩, ?_⟩
    show n * (burnsideK3_S w x + c • Matrix.vecMulVec w w) +
      (burnsideK3_S w x + c • Matrix.vecMulVec w w) * nᵀ = _
    rw [hTt, Matrix.mul_add, Matrix.add_mul, Matrix.mul_smul, Matrix.smul_mul]
    have e1 := burnsideK3_Phi_S n w x
    have e2 := burnsideK3_Phi_sq n w
    calc n * burnsideK3_S w x + c • (n * Matrix.vecMulVec w w) +
          (burnsideK3_S w x * nᵀ + c • (Matrix.vecMulVec w w * nᵀ))
        = (n * burnsideK3_S w x + burnsideK3_S w x * nᵀ) +
          c • (n * Matrix.vecMulVec w w + Matrix.vecMulVec w w * nᵀ) := by
            rw [smul_add]
            abel
      _ = _ := by rw [e1, e2]
  have hker : LinearMap.ker Tt ≤ Submodule.span F
      {((w, 0) : (ι → F) × F), ((n *ᵥ w, 0) : (ι → F) × F)} := by
    rintro ⟨x, c⟩ hxc
    have h0 : Tt (x, c) = 0 := hxc
    rw [hTt] at h0
    have h1 : burnsideK3_S (n *ᵥ w) x + burnsideK3_S (n *ᵥ x) w = c • burnsideK3_S (n *ᵥ w) w := by
      have := eq_neg_of_add_eq_zero_left h0
      rw [this]
      ext i j
      simp [CharTwo.neg_eq]
    obtain ⟨hc, α, β, hx⟩ := burnsideK3_T_eq hnn hw x c h1
    subst hc
    rw [Submodule.mem_span_pair]
    refine ⟨α, β, ?_⟩
    ext1
    · simp [hx]
    · simp
  have hfin2 : Module.finrank F (LinearMap.ker Tt) ≤ 2 := by
    refine (Submodule.finrank_mono hker).trans ?_
    have := finrank_span_finset_le_card (R := F)
      ({((w, 0) : (ι → F) × F), ((n *ᵥ w, 0) : (ι → F) × F)} : Finset ((ι → F) × F))
    simp only [Finset.coe_insert, Finset.coe_singleton] at this
    exact this.trans Finset.card_le_two
  have hTfin := LinearMap.finrank_range_add_finrank_ker Tt
  rw [Module.finrank_prod, Module.finrank_fintype_fun_eq_card, hι, Module.finrank_self] at hTfin
  have hr3 : 3 ≤ Module.finrank F (LinearMap.range ΦS) :=
    (by omega : 3 ≤ Module.finrank F (LinearMap.range Tt)).trans (Submodule.finrank_mono hrange)
  have hΦfin := LinearMap.finrank_range_add_finrank_ker ΦS
  have hS10 := burnsideK3_finrank_sym (F := F) hι
  have hk7 : Module.finrank F (LinearMap.ker ΦS) ≤ 7 := by omega
  have hfix : ∀ Y : Matrix ι ι F, z * Y * zᵀ = Y ↔ n * Y + Y * nᵀ = 0 := by
    intro Y
    have hzt : zᵀ * zᵀ = 1 := by rw [← Matrix.transpose_mul, hz, Matrix.transpose_one]
    have hexp : n * Y + Y * nᵀ = z * Y + Y * zᵀ := by
      rw [hn, add_mul, Matrix.transpose_add, Matrix.transpose_one, mul_add, one_mul, mul_one]
      calc z * Y + Y + (Y * zᵀ + Y) = z * Y + Y * zᵀ + (Y + Y) := by abel
        _ = _ := by rw [h2 Y, add_zero]
    have hneg : ∀ A B : Matrix ι ι F, A + B = 0 ↔ A = B := fun A B => by
      constructor
      · intro h
        have := eq_neg_of_add_eq_zero_left h
        rw [this]
        ext i j
        simp [CharTwo.neg_eq]
      · intro h
        rw [h]
        exact h2 B
    rw [hexp, hneg]
    constructor
    · intro h
      calc z * Y = z * Y * (zᵀ * zᵀ) := by rw [hzt, Matrix.mul_one]
        _ = (z * Y * zᵀ) * zᵀ := by rw [Matrix.mul_assoc _ zᵀ zᵀ]
        _ = Y * zᵀ := by rw [h]
    · intro h
      calc z * Y * zᵀ = Y * zᵀ * zᵀ := by rw [h]
        _ = Y := by rw [Matrix.mul_assoc, hzt, Matrix.mul_one]
  have hcard : Nat.card {Y : Matrix ι ι F // Yᵀ = Y ∧ z * Y * zᵀ = Y} =
      Nat.card (LinearMap.ker ΦS) :=
    Nat.card_congr
      { toFun := fun Y => ⟨⟨Y.1, Y.2.1⟩, (hfix Y.1).mp Y.2.2⟩
        invFun := fun Y => ⟨(Y.1 : Matrix ι ι F), Y.1.2, (hfix _).mpr Y.2⟩
        left_inv := fun Y => rfl
        right_inv := fun Y => rfl }
  rw [hcard, Module.natCard_eq_pow_finrank (K := F)]
  exact Nat.pow_le_pow_right Nat.card_pos hk7

end Sym

section FixF

open CFSG.Quasithin.B45Sp4

@[expose] def burnsideK3_fixF (K : Type) [Field K] [CharP K 2] (a : ℕ) : Subfield K :=
  RingHom.eqLocusField (iterateFrobenius K 2 a) (RingHom.id K)

private theorem burnsideK3_mem_fixF {K : Type} [Field K] [CharP K 2] {a : ℕ} {x : K} :
    x ∈ burnsideK3_fixF K a ↔ x ^ 2 ^ a = x := by
  show iterateFrobenius K 2 a x = (RingHom.id K) x ↔ _
  rw [iterateFrobenius_def]
  rfl

private theorem burnsideK3_card_fixF {K : Type} [Field K] [CharP K 2] [Finite K] {a : ℕ} (ha : 1 ≤ a) :
    Nat.card ↥(burnsideK3_fixF K a) ≤ 2 ^ a := by
  classical
  have : Fintype K := Fintype.ofFinite K
  have h1 : Nat.card ↥(burnsideK3_fixF K a) = Nat.card {x : K // x ^ 2 ^ a = x} :=
    Nat.card_congr (Equiv.subtypeEquivRight fun x => burnsideK3_mem_fixF)
  rw [h1, Nat.card_eq_fintype_card, Fintype.card_subtype]
  exact card_frobFix_le ha

end FixF


section Inn

open CFSG.Quasithin CFSG.Quasithin.B42Sp4 CFSG.Quasithin.B45Sp4 CFSG.Quasithin.H.Sp4 CFSG.Assembly.LowTwoRank
open CFSG.LocalAnalysis.ComponentInitial.SymplecticFour (sym2 sym2_transpose tau coe_tau lam coe_lam radical mem_unipotent_iff eq_sym2 tau_mul_tau tau_comm tau_injective card_radical unitri tau_sq)
open CFSG.LocalAnalysis.ComponentInitial.SymplecticFlag (unipotent)
open scoped Matrix

variable {K : Type} [Field K]

private theorem burnsideK3_tw_fromBlocks (a : ℕ) (P X Q A B C' D : Matrix (Fin 2) (Fin 2) K) :
    tw a (Matrix.fromBlocks P X 0 Q) (Matrix.fromBlocks A B C' D) =
      Matrix.fromBlocks ((P * A + X * C') * (frobPow a P)ᵀ + (P * B + X * D) * (frobPow a X)ᵀ)
        ((P * B + X * D) * (frobPow a Q)ᵀ)
        (Q * C' * (frobPow a P)ᵀ + Q * D * (frobPow a X)ᵀ) (Q * D * (frobPow a Q)ᵀ) := by
  rw [tw_apply, frobPow_fromBlocks, frobPow_zero', Matrix.fromBlocks_transpose,
    Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp only [Matrix.zero_mul, Matrix.mul_zero, zero_add, add_zero, Matrix.transpose_zero]

private theorem burnsideK3_fix_tau_lam {a : ℕ} {C : Matrix (Fin 2) (Fin 2) K} (hC : Cᵀ = C) (t : K)
    {Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K}
    (hY : tw a (spM (tau hC * lam t)) Y = Y) :
    Y.toBlocks₂₂ = (unitri (-t))ᵀ * Y.toBlocks₂₂ * (frobPow a (unitri (-t))ᵀ)ᵀ ∧
    Y.toBlocks₁₂ = (unitri t * Y.toBlocks₁₂ + (C * (unitri (-t))ᵀ) * Y.toBlocks₂₂) *
      (frobPow a (unitri (-t))ᵀ)ᵀ ∧
    Y.toBlocks₂₁ = (unitri (-t))ᵀ * Y.toBlocks₂₁ * (frobPow a (unitri t))ᵀ +
      (unitri (-t))ᵀ * Y.toBlocks₂₂ * (frobPow a (C * (unitri (-t))ᵀ))ᵀ ∧
    Y.toBlocks₁₁ = (unitri t * Y.toBlocks₁₁ + (C * (unitri (-t))ᵀ) * Y.toBlocks₂₁) *
        (frobPow a (unitri t))ᵀ +
      (unitri t * Y.toBlocks₁₂ + (C * (unitri (-t))ᵀ) * Y.toBlocks₂₂) *
        (frobPow a (C * (unitri (-t))ᵀ))ᵀ := by
  rw [spM, coe_tau_mul_lam hC t, ← Matrix.fromBlocks_toBlocks Y, burnsideK3_tw_fromBlocks] at hY
  obtain ⟨h11, h12, h21, h22⟩ := Matrix.fromBlocks_inj.mp hY
  exact ⟨h22.symm, h12.symm, h21.symm, h11.symm⟩

private theorem burnsideK3_pair_zero [CharP K 2] {a : ℕ} {θ : K} (hθ : θ ^ 2 ^ a ≠ θ) {x y : K}
    (h1 : x + y = 0) (h2 : θ * x + y * θ ^ 2 ^ a = 0) : x = 0 ∧ y = 0 := by
  have hxy : x = y := eq_of_add_eq_zero' h1
  subst hxy
  have h3 : x * (θ + θ ^ 2 ^ a) = 0 := by linear_combination h2
  have hx : x = 0 := (mul_eq_zero.mp h3).resolve_right (add_frob_ne_zero hθ)
  exact ⟨hx, hx⟩

private theorem burnsideK3_ii_shape [CharP K 2] {a : ℕ} {θ : K} (hθ : θ ^ 2 ^ a ≠ θ)
    {E : Subgroup (StatedSp 2 K)} (h1 : tau (sym2_transpose 0 1 0) ∈ E)
    (h2 : tau (sym2_transpose 0 θ 0) ∈ E) {Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K}
    (hY : Y ∈ matFix a _ K (spM '' (E : Set (StatedSp 2 K)))) :
    Y.toBlocks₁₂ = 0 ∧ Y.toBlocks₂₁ = 0 ∧ Y.toBlocks₂₂ = 0 := by
  have hfix := mem_matFix_image.mp hY
  have h2a : 2 ^ a ≠ 0 := by positivity
  have h0 : (0 : K) ^ 2 ^ a = 0 := zero_pow h2a
  have h1' : (1 : K) ^ 2 ^ a = 1 := one_pow _
  obtain ⟨hD1, -, hBC1⟩ := fix_tau _ (hfix _ h1)
  obtain ⟨-, -, hBC2⟩ := fix_tau _ (hfix _ h2)
  rw [frobPow_sym2] at hBC1 hBC2
  set B := Y.toBlocks₁₂ with hB
  set C' := Y.toBlocks₂₁ with hC'
  set D := Y.toBlocks₂₂ with hD
  have hD0 : D = 0 := by
    ext i j
    have e0 := congrFun (congrFun hD1 0) j
    have e1 := congrFun (congrFun hD1 1) j
    simp [sym2, Matrix.mul_apply, Fin.sum_univ_two] at e0 e1
    fin_cases i
    · simpa using e1
    · simpa using e0
  have ev : ∀ {M N : Matrix (Fin 2) (Fin 2) K}, M + N = 0 → ∀ i j, M i j + N i j = 0 :=
    fun h i j => by simpa using congrFun (congrFun h i) j
  have a00 := ev hBC1 0 0
  have a01 := ev hBC1 0 1
  have a10 := ev hBC1 1 0
  have a11 := ev hBC1 1 1
  have b00 := ev hBC2 0 0
  have b01 := ev hBC2 0 1
  have b10 := ev hBC2 1 0
  have b11 := ev hBC2 1 1
  simp [sym2, Matrix.mul_apply, Fin.sum_univ_two, h0, h1'] at a00 a01 a10 a11 b00 b01 b10 b11
  obtain ⟨p1, p2⟩ := burnsideK3_pair_zero hθ a00 b00
  obtain ⟨p3, p4⟩ := burnsideK3_pair_zero hθ a01 b01
  obtain ⟨p5, p6⟩ := burnsideK3_pair_zero hθ a10 b10
  obtain ⟨p7, p8⟩ := burnsideK3_pair_zero hθ a11 b11
  refine ⟨?_, ?_, hD0⟩
  · ext i j
    fin_cases i <;> fin_cases j <;> simp_all
  · ext i j
    fin_cases i <;> fin_cases j <;> simp_all

private theorem burnsideK3_ii_block [CharP K 2] {a : ℕ} {θ : K} (hθ : θ ^ 2 ^ a ≠ θ)
    {E : Subgroup (StatedSp 2 K)} (h1 : tau (sym2_transpose 0 1 0) ∈ E)
    (h2 : tau (sym2_transpose 0 θ 0) ∈ E) {C : Matrix (Fin 2) (Fin 2) K} (hC : Cᵀ = C) {t : K}
    (ht : t ≠ 0) (hg : tau hC * lam t ∈ E) {Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K}
    (hY : Y ∈ matFix a _ K (spM '' (E : Set (StatedSp 2 K)))) :
    Y.toBlocks₁₂ = 0 ∧ Y.toBlocks₂₁ = 0 ∧ Y.toBlocks₂₂ = 0 ∧ Y.toBlocks₁₁ 1 1 = 0 ∧
      t * Y.toBlocks₁₁ 1 0 = t ^ 2 ^ a * Y.toBlocks₁₁ 0 1 := by
  have hfix := mem_matFix_image.mp hY
  obtain ⟨hB, hC', hD⟩ := burnsideK3_ii_shape hθ h1 h2 hY
  obtain ⟨-, -, -, h4⟩ := burnsideK3_fix_tau_lam hC t (hfix _ hg)
  rw [hB, hC', hD] at h4
  have h2a : 2 ^ a ≠ 0 := by positivity
  have h0 : (0 : K) ^ 2 ^ a = 0 := zero_pow h2a
  have h1' : (1 : K) ^ 2 ^ a = 1 := one_pow _
  have e00 := congrFun (congrFun h4 0) 0
  have e01 := congrFun (congrFun h4 0) 1
  simp only [Matrix.add_apply, Matrix.mul_apply, Fin.sum_univ_two, Matrix.transpose_apply,
    frobPow, Matrix.map_apply, unitri, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.head_cons, Matrix.zero_apply, mul_zero, zero_mul, add_zero,
    zero_add, h0, h1', Matrix.cons_val_fin_one, Matrix.empty_val', Fin.isValue,
    Matrix.cons_val, one_mul, mul_one, Matrix.of_apply, Matrix.transpose_apply, Matrix.map_apply,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons] at e00 e01
  have hA11 : Y.toBlocks₁₁ 1 1 = 0 := by
    have : t * Y.toBlocks₁₁ 1 1 = 0 := by linear_combination (-1 : K) * e01
    exact (mul_eq_zero.mp this).resolve_left ht
  refine ⟨hB, hC', hD, hA11, ?_⟩
  rw [hA11] at e00
  linear_combination (-1 : K) * e00 -
    (t ^ 2 ^ a * Y.toBlocks₁₁ 0 1) * (CharTwo.two_eq_zero (R := K))

private theorem burnsideK3_ii_card [CharP K 2] [Finite K] {a : ℕ} (ha : 1 ≤ a)
    (hK : Nat.card K = 2 ^ (2 * a)) {E : Subgroup (StatedSp 2 K)}
    (hE : ∀ c : K, tau (sym2_transpose 0 c 0) ∈ E) {C : Matrix (Fin 2) (Fin 2) K} (hC : Cᵀ = C)
    {t : K} (ht : t ≠ 0) (hg : tau hC * lam t ∈ E) :
    Nat.card ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K)))) ≤ Nat.card K ^ 2 := by
  obtain ⟨θ, hθ⟩ := exists_ne_frob ha hK
  have hblock := fun (Y : ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K))))) =>
    burnsideK3_ii_block hθ (hE 1) (hE θ) hC ht hg Y.2
  have hinj : Function.Injective (fun Y : ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K)))) =>
      ((Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁ 0 0,
        (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁ 0 1)) := by
    intro Y Z h
    obtain ⟨hB, hC', hD, hA11, hA10⟩ := hblock Y
    obtain ⟨kB, kC', kD, kA11, kA10⟩ := hblock Z
    have h00 : (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁ 0 0 =
        (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁ 0 0 := congrArg Prod.fst h
    have h01 : (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁ 0 1 =
        (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁ 0 1 := congrArg Prod.snd h
    have h10 : (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁ 1 0 =
        (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁ 1 0 := by
      apply mul_left_cancel₀ ht
      rw [hA10, kA10, h01]
    apply Subtype.ext
    rw [← Matrix.fromBlocks_toBlocks (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K),
      ← Matrix.fromBlocks_toBlocks (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K), hB, hC', hD,
      kB, kC', kD]
    congr 1
    ext i j
    fin_cases i <;> fin_cases j <;> simp [h00, h01, h10, hA11, kA11]
  calc Nat.card ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K))))
      ≤ Nat.card (K × K) := Nat.card_le_card_of_injective _ hinj
    _ = Nat.card K ^ 2 := by rw [Nat.card_prod, sq]

@[expose] noncomputable def burnsideK3_levHom [CharP K 2] (E : Subgroup (StatedSp 2 K))
    (hEU : E ≤ unipotent 2 K) : ↥E →* Multiplicative K where
  toFun x := Multiplicative.ofAdd (lev (x : StatedSp 2 K))
  map_one' := by
    show Multiplicative.ofAdd (lev (1 : StatedSp 2 K)) = 1
    simp [lev]
  map_mul' x y := by
    show Multiplicative.ofAdd (lev ((x : StatedSp 2 K) * (y : StatedSp 2 K))) = _
    rw [lev_mul (hEU x.2) (hEU y.2), ofAdd_add]

@[expose] noncomputable def burnsideK3_E0 [CharP K 2] (E : Subgroup (StatedSp 2 K))
    (hEU : E ≤ unipotent 2 K) : Subgroup (StatedSp 2 K) :=
  (burnsideK3_levHom E hEU).ker.map E.subtype

private theorem burnsideK3_mem_E0 [CharP K 2] {E : Subgroup (StatedSp 2 K)} (hEU : E ≤ unipotent 2 K)
    {x : StatedSp 2 K} : x ∈ burnsideK3_E0 E hEU ↔ x ∈ E ∧ lev x = 0 := by
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y.2, congrArg Multiplicative.toAdd (MonoidHom.mem_ker.mp hy)⟩
  · rintro ⟨hx, h0⟩
    exact ⟨⟨x, hx⟩, MonoidHom.mem_ker.mpr (congrArg Multiplicative.ofAdd h0), rfl⟩

private theorem burnsideK3_E0_le [CharP K 2] {E : Subgroup (StatedSp 2 K)} (hEU : E ≤ unipotent 2 K) :
    burnsideK3_E0 E hEU ≤ E := fun _ hx => ((burnsideK3_mem_E0 hEU).mp hx).1

private theorem burnsideK3_card_le_E0 [CharP K 2] [Finite K] {E : Subgroup (StatedSp 2 K)}
    (hEU : E ≤ unipotent 2 K) :
    Nat.card E ≤ Nat.card ↥(burnsideK3_E0 E hEU) * Nat.card K := by
  have h1 := (burnsideK3_levHom E hEU).ker.card_mul_index
  rw [Subgroup.index_ker] at h1
  have h2 : Nat.card (burnsideK3_levHom E hEU).range ≤ Nat.card K := by
    calc Nat.card (burnsideK3_levHom E hEU).range ≤ Nat.card (Multiplicative K) :=
        Finite.card_subtype_le _
      _ = Nat.card K := rfl
  have h3 : Nat.card ↥(burnsideK3_E0 E hEU) = Nat.card (burnsideK3_levHom E hEU).ker :=
    Subgroup.card_map_of_injective E.subtype_injective
  rw [h3, ← h1]
  exact Nat.mul_le_mul_left _ h2

private theorem burnsideK3_E0_rad [CharP K 2] {E : Subgroup (StatedSp 2 K)}
    (hEsq : ∀ x ∈ E, x * x = 1) (hEU : E ≤ unipotent 2 K) {g₀ : StatedSp 2 K} (hg₀E : g₀ ∈ E)
    (hlev : lev g₀ ≠ 0) {x : StatedSp 2 K} (hx : x ∈ burnsideK3_E0 E hEU) :
    x ∈ radical K ∧ radD x = 0 := by
  obtain ⟨hxE, hx0⟩ := (burnsideK3_mem_E0 hEU).mp hx
  have hcomm : ∀ x ∈ E, ∀ y ∈ E, x * y = y * x := by
    intro x hx y hy
    have hx' : x⁻¹ = x := inv_eq_of_mul_eq_one_right (hEsq x hx)
    have hy' : y⁻¹ = y := inv_eq_of_mul_eq_one_right (hEsq y hy)
    have hxy : (x * y)⁻¹ = x * y := inv_eq_of_mul_eq_one_right (hEsq _ (E.mul_mem hx hy))
    rw [← hxy, _root_.mul_inv_rev, hx', hy']
  have hxR := (unipotent_facts (hEU hxE)).2.2 hx0
  exact ⟨hxR, radD_eq_zero_of_comm hxR (hEU hg₀E) hlev (hcomm _ hxE _ hg₀E)⟩

private theorem burnsideK3_E0_inj [CharP K 2] {E : Subgroup (StatedSp 2 K)}
    (hEsq : ∀ x ∈ E, x * x = 1) (hEU : E ≤ unipotent 2 K) {g₀ : StatedSp 2 K} (hg₀E : g₀ ∈ E)
    (hlev : lev g₀ ≠ 0) :
    Function.Injective (fun x : ↥(burnsideK3_E0 E hEU) => (radA (x : StatedSp 2 K),
      radB (x : StatedSp 2 K))) := by
  intro x y hxy
  obtain ⟨hxR, hxD⟩ := burnsideK3_E0_rad hEsq hEU hg₀E hlev x.2
  obtain ⟨hyR, hyD⟩ := burnsideK3_E0_rad hEsq hEU hg₀E hlev y.2
  have h1 : radA (x : StatedSp 2 K) = radA (y : StatedSp 2 K) := congrArg Prod.fst hxy
  have h2 : radB (x : StatedSp 2 K) = radB (y : StatedSp 2 K) := congrArg Prod.snd hxy
  exact Subtype.ext (radB_eq_of_radA_radD hxR hyR h1 h2 (by rw [hxD, hyD]))

private theorem burnsideK3_card_E0_le [CharP K 2] [Finite K] {E : Subgroup (StatedSp 2 K)}
    (hEsq : ∀ x ∈ E, x * x = 1) (hEU : E ≤ unipotent 2 K) {g₀ : StatedSp 2 K} (hg₀E : g₀ ∈ E)
    (hlev : lev g₀ ≠ 0) : Nat.card ↥(burnsideK3_E0 E hEU) ≤ Nat.card K ^ 2 := by
  calc Nat.card ↥(burnsideK3_E0 E hEU) ≤ Nat.card (K × K) :=
      Nat.card_le_card_of_injective _ (burnsideK3_E0_inj hEsq hEU hg₀E hlev)
    _ = Nat.card K ^ 2 := by rw [Nat.card_prod, sq]

private theorem burnsideK3_st_large [CharP K 2] [Finite K] {E : Subgroup (StatedSp 2 K)}
    (hEsq : ∀ x ∈ E, x * x = 1) (hEU : E ≤ unipotent 2 K) {g₀ : StatedSp 2 K} (hg₀E : g₀ ∈ E)
    (hlev : lev g₀ ≠ 0) (hcard : Nat.card E = Nat.card K ^ 3) (b c : K) :
    tau (sym2_transpose b c 0) ∈ E := by
  have hq : 0 < Nat.card K := Nat.card_pos
  have h1 := burnsideK3_card_le_E0 hEU
  have h2 := burnsideK3_card_E0_le hEsq hEU hg₀E hlev
  have h3 : Nat.card ↥(burnsideK3_E0 E hEU) = Nat.card K ^ 2 := by
    refine le_antisymm h2 ?_
    rw [hcard] at h1
    have : Nat.card K ^ 2 * Nat.card K ≤ Nat.card ↥(burnsideK3_E0 E hEU) * Nat.card K := by
      calc Nat.card K ^ 2 * Nat.card K = Nat.card K ^ 3 := by ring
        _ ≤ _ := h1
    exact Nat.le_of_mul_le_mul_right this hq
  have hbij := (burnsideK3_E0_inj hEsq hEU hg₀E hlev).bijective_of_nat_card_le
    (by rw [h3, Nat.card_prod, sq])
  obtain ⟨x, hx⟩ := hbij.2 (b, c)
  have hx1 : radA (x : StatedSp 2 K) = b := congrArg Prod.fst hx
  have hx2 : radB (x : StatedSp 2 K) = c := congrArg Prod.snd hx
  obtain ⟨hxR, hxD⟩ := burnsideK3_E0_rad hEsq hEU hg₀E hlev x.2
  have hxE := burnsideK3_E0_le hEU x.2
  have e := eq_upSp_of_mem_radical hxR
  rw [hx1, hx2, hxD] at e
  rw [e] at hxE
  exact hxE

private theorem burnsideK3_E0_radB [CharP K 2] [Finite K] {E : Subgroup (StatedSp 2 K)}
    (hEsq : ∀ x ∈ E, x * x = 1) (hEU : E ≤ unipotent 2 K) {g₀ : StatedSp 2 K} (hg₀E : g₀ ∈ E)
    (hlev : lev g₀ ≠ 0) (hc : Module.finrank K (fixK E) = 2) {x : StatedSp 2 K}
    (hx : x ∈ burnsideK3_E0 E hEU) : radB x = 0 := by
  by_contra hb
  obtain ⟨hxR, hxD⟩ := burnsideK3_E0_rad hEsq hEU hg₀E hlev hx
  have hxE := burnsideK3_E0_le hEU hx
  have hle : fixK E ≤ Submodule.span K {Pi.single (Sum.inl 0) 1} := by
    intro v hv
    have h1 := hv _ hxE
    have h0 := hv g₀ hg₀E
    obtain ⟨C, hC, hxeq⟩ := hxR
    rw [hxeq] at h1 hb hxD
    have hCb : C 0 1 ≠ 0 := by
      have : radB (tau hC) = C 0 1 := by rw [radB, coe_tau]; simp
      rwa [this] at hb
    have hCd : C 1 1 = 0 := by
      have : radD (tau hC) = C 1 1 := by rw [radD, coe_tau]; simp
      rwa [this] at hxD
    have hC10 : C 1 0 = C 0 1 := by
      have := congrFun (congrFun hC 0) 1
      simpa using this
    have e0 := congrFun h1 (Sum.inl 0)
    have e1 := congrFun h1 (Sum.inl 1)
    rw [tau_mulVec_inl, add_eq_left] at e0 e1
    simp only [Fin.sum_univ_two] at e0 e1
    rw [hC10, hCd, zero_mul, add_zero] at e1
    have hy0 : v (Sum.inr 0) = 0 := (mul_eq_zero.mp e1).resolve_left hCb
    rw [hy0, mul_zero, zero_add] at e0
    have hy1 : v (Sum.inr 1) = 0 := (mul_eq_zero.mp e0).resolve_left hCb
    have hx1 : v (Sum.inl 1) = 0 := by
      have e := congrFun h0 (Sum.inl 0)
      rw [Matrix.mulVec, dotProduct, Fintype.sum_sum_type] at e
      simp only [Fin.sum_univ_two, hy0, hy1, mul_zero, add_zero] at e
      have hd : spM g₀ (Sum.inl 0) (Sum.inl 0) = 1 := unipotent_diag (hEU hg₀E) 3
      have hl : spM g₀ (Sum.inl 0) (Sum.inl 1) = lev g₀ := rfl
      rw [hd, hl, one_mul, add_eq_left] at e
      exact (mul_eq_zero.mp e).resolve_left hlev
    rw [Submodule.mem_span_singleton]
    refine ⟨v (Sum.inl 0), ?_⟩
    funext i
    rcases i with i | i <;> fin_cases i <;> simp [hx1, hy0, hy1]
  have h3 := Submodule.finrank_mono hle
  have h4 : Module.finrank K ↥(K ∙ (Pi.single (Sum.inl 0) 1 : Fin 2 ⊕ Fin 2 → K)) = 1 :=
    finrank_span_singleton (by simp)
  omega

private theorem burnsideK3_st_small [CharP K 2] [Finite K] {E : Subgroup (StatedSp 2 K)}
    (hEsq : ∀ x ∈ E, x * x = 1) (hEU : E ≤ unipotent 2 K) {g₀ : StatedSp 2 K} (hg₀E : g₀ ∈ E)
    (hlev : lev g₀ ≠ 0) (hc : Module.finrank K (fixK E) = 2)
    (hcard : Nat.card E = Nat.card K ^ 2) (b : K) : tau (sym2_transpose b 0 0) ∈ E := by
  have hq : 0 < Nat.card K := Nat.card_pos
  have h1 := burnsideK3_card_le_E0 hEU
  have hinj : Function.Injective (fun x : ↥(burnsideK3_E0 E hEU) => radA (x : StatedSp 2 K)) := by
    intro x y hxy
    obtain ⟨hxR, hxD⟩ := burnsideK3_E0_rad hEsq hEU hg₀E hlev x.2
    obtain ⟨hyR, hyD⟩ := burnsideK3_E0_rad hEsq hEU hg₀E hlev y.2
    exact Subtype.ext (radB_eq_of_radA_radD hxR hyR hxy
      (by rw [burnsideK3_E0_radB hEsq hEU hg₀E hlev hc x.2,
        burnsideK3_E0_radB hEsq hEU hg₀E hlev hc y.2]) (by rw [hxD, hyD]))
  have h2 : Nat.card ↥(burnsideK3_E0 E hEU) ≤ Nat.card K := Nat.card_le_card_of_injective _ hinj
  have h3 : Nat.card K ≤ Nat.card ↥(burnsideK3_E0 E hEU) := by
    rw [hcard] at h1
    have : Nat.card K * Nat.card K ≤ Nat.card ↥(burnsideK3_E0 E hEU) * Nat.card K := by
      calc Nat.card K * Nat.card K = Nat.card K ^ 2 := by ring
        _ ≤ _ := h1
    exact Nat.le_of_mul_le_mul_right this hq
  have hbij := hinj.bijective_of_nat_card_le h3
  obtain ⟨x, hx⟩ := hbij.2 b
  obtain ⟨hxR, hxD⟩ := burnsideK3_E0_rad hEsq hEU hg₀E hlev x.2
  have hxb := burnsideK3_E0_radB hEsq hEU hg₀E hlev hc x.2
  have hxE := burnsideK3_E0_le hEU x.2
  have e := eq_upSp_of_mem_radical hxR
  have hx' : radA (x : StatedSp 2 K) = b := hx
  rw [hx', hxb, hxD] at e
  rw [e] at hxE
  exact hxE

private theorem burnsideK3_i2_shape [CharP K 2] {a : ℕ} {θ : K} (hθ : θ ^ 2 ^ a ≠ θ)
    {E : Subgroup (StatedSp 2 K)} (h1 : tau (sym2_transpose 1 0 0) ∈ E)
    (h2 : tau (sym2_transpose θ 0 0) ∈ E) {C : Matrix (Fin 2) (Fin 2) K} (hC : Cᵀ = C) {t : K}
    (ht : t ≠ 0) (hg : tau hC * lam t ∈ E) {Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K}
    (hY : Y ∈ matFix a _ K (spM '' (E : Set (StatedSp 2 K)))) :
    Y.toBlocks₂₂ 0 0 = 0 ∧ Y.toBlocks₂₂ 0 1 = 0 ∧ Y.toBlocks₂₂ 1 0 = 0 ∧
      Y.toBlocks₁₂ 0 0 = 0 ∧ Y.toBlocks₁₂ 1 0 = 0 ∧ Y.toBlocks₂₁ 0 0 = 0 ∧ Y.toBlocks₂₁ 0 1 = 0 ∧
      t * Y.toBlocks₁₂ 1 1 = C 0 1 * Y.toBlocks₂₂ 1 1 ∧
      t ^ 2 ^ a * Y.toBlocks₂₁ 1 1 = (C 0 1) ^ 2 ^ a * Y.toBlocks₂₂ 1 1 := by
  have hfix := mem_matFix_image.mp hY
  have h2a : 2 ^ a ≠ 0 := by positivity
  have h0 : (0 : K) ^ 2 ^ a = 0 := zero_pow h2a
  have h1' : (1 : K) ^ 2 ^ a = 1 := one_pow _
  obtain ⟨hD1, hD1', hBC1⟩ := fix_tau _ (hfix _ h1)
  obtain ⟨-, -, hBC2⟩ := fix_tau _ (hfix _ h2)
  rw [frobPow_sym2] at hD1' hBC1 hBC2
  obtain ⟨-, hBeq, hCeq, -⟩ := burnsideK3_fix_tau_lam hC t (hfix _ hg)
  set B := Y.toBlocks₁₂ with hB
  set C' := Y.toBlocks₂₁ with hC'
  set D := Y.toBlocks₂₂ with hD
  have d00 := congrFun (congrFun hD1 0) 0
  have d01 := congrFun (congrFun hD1 0) 1
  have d10 := congrFun (congrFun hD1' 1) 0
  have ev : ∀ {M N : Matrix (Fin 2) (Fin 2) K}, M + N = 0 → ∀ i j, M i j + N i j = 0 :=
    fun h i j => by simpa using congrFun (congrFun h i) j
  have a00 := ev hBC1 0 0
  have a01 := ev hBC1 0 1
  have a10 := ev hBC1 1 0
  have b00 := ev hBC2 0 0
  have b01 := ev hBC2 0 1
  have b10 := ev hBC2 1 0
  simp [sym2, Matrix.mul_apply, Fin.sum_univ_two, h0, h1'] at d00 d01 d10 a00 a01 a10 b00 b01 b10
  obtain ⟨hC00, hB00⟩ := burnsideK3_pair_zero hθ a00 b00
  have e1 := congrFun (congrFun hBeq 0) 1
  have e2 := congrFun (congrFun hCeq 1) 0
  simp only [Matrix.add_apply, Matrix.mul_apply, Fin.sum_univ_two, Matrix.transpose_apply,
    frobPow, Matrix.map_apply, unitri, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.head_cons, Matrix.zero_apply, mul_zero, zero_mul, add_zero,
    zero_add, h0, h1', Matrix.cons_val_fin_one, Matrix.empty_val', Fin.isValue,
    Matrix.cons_val, one_mul, mul_one, d00, d01, d10, hB00, a10, hC00, a01] at e1 e2
  refine ⟨d00, d01, d10, hB00, a10, hC00, a01, ?_, ?_⟩
  · linear_combination (-1 : K) * e1 - (C 0 1 * D 1 1) * (CharTwo.two_eq_zero (R := K))
  · linear_combination (-1 : K) * e2 - (C 0 1 ^ 2 ^ a * D 1 1) * (CharTwo.two_eq_zero (R := K))

private theorem burnsideK3_i2_card [CharP K 2] [Finite K] {a : ℕ} (ha : 1 ≤ a)
    (hK : Nat.card K = 2 ^ (2 * a)) {E : Subgroup (StatedSp 2 K)}
    (hEsq : ∀ x ∈ E, x * x = 1) (hEU : E ≤ unipotent 2 K) {g₀ : StatedSp 2 K} (hg₀E : g₀ ∈ E)
    (hlev : lev g₀ ≠ 0) (hc : Module.finrank K (fixK E) = 2)
    (hcard : Nat.card E = Nat.card K ^ 2) :
    Nat.card ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K)))) ≤ Nat.card K ^ 7 := by
  obtain ⟨C, hC, t, hg₀⟩ := mem_unipotent_iff.1 (hEU hg₀E)
  have hlevt : lev g₀ = t := by
    rw [hg₀, lev, coe_tau_mul_lam]
    simp [unitri]
  have ht : t ≠ 0 := by rw [← hlevt]; exact hlev
  rw [hg₀] at hg₀E
  obtain ⟨θ, hθ⟩ := exists_ne_frob ha hK
  have hE1 := burnsideK3_st_small hEsq hEU (by rw [← hg₀] at hg₀E; exact hg₀E) hlev hc hcard 1
  have hEθ := burnsideK3_st_small hEsq hEU (by rw [← hg₀] at hg₀E; exact hg₀E) hlev hc hcard θ
  have hσt : t ^ 2 ^ a ≠ 0 := pow_ne_zero _ ht
  have hshape := fun (Y : ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K))))) =>
    burnsideK3_i2_shape hθ hE1 hEθ hC ht hg₀E Y.2
  have hinj : Function.Injective (fun Y : ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K)))) =>
      ((Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁,
        (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₂ 0 1,
        (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁ 1 0,
        (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₂ 1 1)) := by
    intro Y Z h
    obtain ⟨d00, d01, d10, b00, b10, c00, c01, hb11, hc11⟩ := hshape Y
    obtain ⟨d00', d01', d10', b00', b10', c00', c01', hb11', hc11'⟩ := hshape Z
    have hA : (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁ =
        (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁ := congrArg Prod.fst h
    have hB01 : (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₂ 0 1 =
        (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₂ 0 1 :=
      congrArg (fun p => p.2.1) h
    have hC10 : (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁ 1 0 =
        (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁ 1 0 :=
      congrArg (fun p => p.2.2.1) h
    have hD11 : (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₂ 1 1 =
        (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₂ 1 1 :=
      congrArg (fun p => p.2.2.2) h
    have hB11 : (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₂ 1 1 =
        (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₂ 1 1 := by
      apply mul_left_cancel₀ ht
      rw [hb11, hb11', hD11]
    have hC11 : (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁ 1 1 =
        (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁ 1 1 := by
      apply mul_left_cancel₀ hσt
      rw [hc11, hc11', hD11]
    apply Subtype.ext
    rw [← Matrix.fromBlocks_toBlocks (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K),
      ← Matrix.fromBlocks_toBlocks (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K), hA]
    congr 1
    · ext i j
      fin_cases i <;> fin_cases j <;> simp [b00, b10, b00', b10', hB01, hB11]
    · ext i j
      fin_cases i <;> fin_cases j <;> simp [c00, c01, c00', c01', hC10, hC11]
    · ext i j
      fin_cases i <;> fin_cases j <;> simp [d00, d01, d10, d00', d01', d10', hD11]
  calc Nat.card ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K))))
      ≤ Nat.card (Matrix (Fin 2) (Fin 2) K × K × K × K) := Nat.card_le_card_of_injective _ hinj
    _ = Nat.card K ^ 7 := by
        rw [Nat.card_prod, Nat.card_prod, Nat.card_prod]
        show Nat.card (Fin 2 → Fin 2 → K) * _ = _
        rw [Nat.card_fun, Nat.card_fun]
        simp only [Nat.card_eq_fintype_card (α := Fin 2), Fintype.card_fin]
        ring

private theorem burnsideK3_scalar [CharP K 2] {a : ℕ} {C₁ C : Matrix (Fin 2) (Fin 2) K}
    (hdet : IsUnit C₁.det)
    (h : ∀ B : Matrix (Fin 2) (Fin 2) K, ∃ C' : Matrix (Fin 2) (Fin 2) K,
      C₁ * C' = B * frobPow a C₁ ∧ C * C' = B * frobPow a C) :
    ∃ l : K, C = l • C₁ ∧ l ^ 2 ^ a = l := by
  have hGC : C₁⁻¹ * C₁ = 1 := Matrix.nonsing_inv_mul C₁ hdet
  have hCG : C₁ * C₁⁻¹ = 1 := Matrix.mul_nonsing_inv C₁ hdet
  have hCQ : C = (C * C₁⁻¹) * C₁ := by rw [Matrix.mul_assoc, hGC, Matrix.mul_one]
  have hQB : ∀ B : Matrix (Fin 2) (Fin 2) K,
      (C * C₁⁻¹) * B = B * frobPow a (C * C₁⁻¹) := by
    intro B
    obtain ⟨C', h1, h2⟩ := h B
    have hC' : C' = C₁⁻¹ * (B * frobPow a C₁) := by
      rw [← h1, ← Matrix.mul_assoc, hGC, Matrix.one_mul]
    rw [hC'] at h2
    have h3 : ((C * C₁⁻¹) * B) * frobPow a C₁ = B * frobPow a C := by
      rw [← h2]
      simp only [Matrix.mul_assoc]
    have h4 : frobPow a C₁ * frobPow a C₁⁻¹ = 1 := by
      rw [← frobPow_mul, hCG, frobPow_one]
    calc (C * C₁⁻¹) * B = ((C * C₁⁻¹) * B) * (frobPow a C₁ * frobPow a C₁⁻¹) := by
          rw [h4, Matrix.mul_one]
      _ = (((C * C₁⁻¹) * B) * frobPow a C₁) * frobPow a C₁⁻¹ := by rw [Matrix.mul_assoc _ (frobPow a C₁)]
      _ = (B * frobPow a C) * frobPow a C₁⁻¹ := by rw [h3]
      _ = B * frobPow a (C * C₁⁻¹) := by rw [Matrix.mul_assoc, ← frobPow_mul]
  have hQ1 : frobPow a (C * C₁⁻¹) = C * C₁⁻¹ := by
    have := hQB 1
    rw [Matrix.mul_one, Matrix.one_mul] at this
    exact this.symm
  have hcomm : ∀ B : Matrix (Fin 2) (Fin 2) K, (C * C₁⁻¹) * B = B * (C * C₁⁻¹) := fun B => by
    rw [hQB B, hQ1]
  obtain ⟨l, hl⟩ := Matrix.mem_range_scalar_of_commute_single (M := C * C₁⁻¹)
    (fun i j _ => (hcomm _).symm)
  have hQl : C * C₁⁻¹ = l • (1 : Matrix (Fin 2) (Fin 2) K) := by
    rw [← hl]
    ext i j
    simp [Matrix.scalar_apply, Matrix.diagonal_apply, Matrix.one_apply]
  refine ⟨l, ?_, ?_⟩
  · rw [hCQ, hQl, Matrix.smul_mul, Matrix.one_mul]
  · have := congrFun (congrFun hQ1 0) 0
    rw [hQl] at this
    simpa [frobPow] using this

private theorem burnsideK3_rad_one : radA (1 : StatedSp 2 K) = 0 ∧ radB (1 : StatedSp 2 K) = 0 ∧
    radD (1 : StatedSp 2 K) = 0 := by
  refine ⟨?_, ?_, ?_⟩ <;> simp [radA, radB, radD]

private theorem burnsideK3_mul_self_inj [CharP K 2] {x y : K} (h : x * x = y * y) : x = y := by
  have h1 : (x + y) * (x + y) = 0 := by
    linear_combination h + (x * y + y * y) * (CharTwo.two_eq_zero (R := K))
  have h2 : x + y = 0 := mul_self_eq_zero.mp h1
  exact eq_of_add_eq_zero' h2

private theorem burnsideK3_exists_inv [CharP K 2] [Finite K] {E : Subgroup (StatedSp 2 K)}
    (hER : E ≤ radical K) (hcard : Nat.card K < Nat.card E) :
    ∃ x ∈ E, radA x * radD x ≠ radB x * radB x := by
  by_contra hcon
  push Not at hcon
  have hdet : ∀ x ∈ E, radA x * radD x = radB x * radB x := hcon
  have hle : Nat.card E ≤ Nat.card K := by
    by_cases hE : ∀ x ∈ E, x = 1
    · have hbot : E = ⊥ := (Subgroup.eq_bot_iff_forall E).mpr hE
      rw [hbot, Subgroup.card_bot]
      exact Nat.card_pos
    · push Not at hE
      obtain ⟨x₀, hx₀E, hx₀1⟩ := hE
      have hx₀R := hER hx₀E
      have hcross : ∀ x ∈ E, radA x * radD x₀ = radA x₀ * radD x := by
        intro x hx
        obtain ⟨m1, m2, m3⟩ := rad_mul (hER hx) hx₀R
        have h := hdet (x * x₀) (E.mul_mem hx hx₀E)
        rw [m1, m2, m3] at h
        have h1 := hdet x hx
        have h2 := hdet x₀ hx₀E
        have h3 : radA x * radD x₀ + radA x₀ * radD x = 0 := by
          linear_combination h - h1 - h2 + (radB x * radB x₀) * (CharTwo.two_eq_zero (R := K))
        exact eq_of_add_eq_zero' h3
      by_cases hb₀ : radA x₀ = 0
      ·
        have hd₀ : radD x₀ ≠ 0 := by
          intro hd
          have hc : radB x₀ * radB x₀ = 0 := by rw [← hdet x₀ hx₀E, hb₀, zero_mul]
          have hb : radB x₀ = 0 := mul_self_eq_zero.mp hc
          apply hx₀1
          exact radB_eq_of_radA_radD hx₀R (one_mem _) (by rw [hb₀, burnsideK3_rad_one.1])
            (by rw [hb, burnsideK3_rad_one.2.1]) (by rw [hd, burnsideK3_rad_one.2.2])
        have hA0 : ∀ x ∈ E, radA x = 0 := by
          intro x hx
          have := hcross x hx
          rw [hb₀, zero_mul] at this
          exact (mul_eq_zero.mp this).resolve_right hd₀
        have hinj : Function.Injective (fun x : E => radD (x : StatedSp 2 K)) := by
          intro x y hxy
          have hx := hdet x x.2
          have hy := hdet y y.2
          have hxy' : radD (x : StatedSp 2 K) = radD (y : StatedSp 2 K) := hxy
          rw [hA0 x x.2, zero_mul] at hx
          rw [hA0 y y.2, zero_mul] at hy
          have hbx : radB (x : StatedSp 2 K) = 0 := (mul_self_eq_zero.mp hx.symm)
          have hby : radB (y : StatedSp 2 K) = 0 := (mul_self_eq_zero.mp hy.symm)
          exact Subtype.ext (radB_eq_of_radA_radD (hER x.2) (hER y.2)
            (by rw [hA0 x x.2, hA0 y y.2]) (by rw [hbx, hby]) hxy')
        exact Nat.card_le_card_of_injective _ hinj
      · have hinj : Function.Injective (fun x : E => radA (x : StatedSp 2 K)) := by
          intro x y hxy
          have hxy' : radA (x : StatedSp 2 K) = radA (y : StatedSp 2 K) := hxy
          have hdx := hcross x x.2
          have hdy := hcross y y.2
          have hD : radD (x : StatedSp 2 K) = radD (y : StatedSp 2 K) := by
            apply mul_left_cancel₀ hb₀
            rw [← hdx, ← hdy, hxy']
          have hB : radB (x : StatedSp 2 K) = radB (y : StatedSp 2 K) := by
            apply burnsideK3_mul_self_inj
            rw [← hdet x x.2, ← hdet y y.2, hxy', hD]
          exact Subtype.ext (radB_eq_of_radA_radD (hER x.2) (hER y.2) hxy' hB hD)
        exact Nat.card_le_card_of_injective _ hinj
  omega

private theorem burnsideK3_matrix_eq_of_add_eq_zero [CharP K 2] {M N : Matrix (Fin 2) (Fin 2) K}
    (h : M + N = 0) : M = N := by
  have := eq_neg_of_add_eq_zero_left h
  rw [this]
  ext i j
  simp [CharTwo.neg_eq]

private theorem burnsideK3_fix_rad {a : ℕ} {x : StatedSp 2 K} (hx : x ∈ radical K)
    {Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K} (hY : tw a (spM x) Y = Y) :
    sym2 (radA x) (radB x) (radD x) * Y.toBlocks₂₂ = 0 ∧
    Y.toBlocks₂₂ * frobPow a (sym2 (radA x) (radB x) (radD x)) = 0 ∧
    sym2 (radA x) (radB x) (radD x) * Y.toBlocks₂₁ +
      Y.toBlocks₁₂ * frobPow a (sym2 (radA x) (radB x) (radD x)) = 0 := by
  have e : x = tau (sym2_transpose (radA x) (radB x) (radD x)) := eq_upSp_of_mem_radical hx
  have hY' : tw a (spM (tau (sym2_transpose (radA x) (radB x) (radD x)))) Y = Y := by
    rw [← e]
    exact hY
  exact fix_tau _ hY'

private theorem burnsideK3_i1_card [CharP K 2] [Finite K] {a : ℕ} (ha : 1 ≤ a)
    (hK : Nat.card K = 2 ^ (2 * a)) {E : Subgroup (StatedSp 2 K)} (hER : E ≤ radical K)
    (hcard : Nat.card E = Nat.card K ^ 2) :
    Nat.card ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K)))) < Nat.card K ^ 8 := by
  classical
  by_contra hge
  push Not at hge
  have hq2 : 2 ≤ Nat.card K := by
    rw [hK]
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ (2 * a) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hqlt : Nat.card K < Nat.card E := by
    rw [hcard]
    nlinarith
  obtain ⟨x₁, hx₁E, hdet⟩ := burnsideK3_exists_inv hER hqlt
  set C₁ := sym2 (radA x₁) (radB x₁) (radD x₁) with hC₁
  have hdet' : IsUnit C₁.det := by
    rw [isUnit_iff_ne_zero, hC₁, Matrix.det_fin_two]
    simp only [sym2, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons, Matrix.empty_val', Matrix.cons_val_fin_one]
    intro h
    exact hdet (by linear_combination h)
  have hGC : C₁⁻¹ * C₁ = 1 := Matrix.nonsing_inv_mul C₁ hdet'
  have hshape : ∀ Y : ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K)))),
      (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₂ = 0 ∧
      C₁ * (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁ =
        (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₂ * frobPow a C₁ := by
    intro Y
    obtain ⟨hD1, -, hBC1⟩ := burnsideK3_fix_rad (hER hx₁E) (mem_matFix_image.mp Y.2 x₁ hx₁E)
    refine ⟨?_, burnsideK3_matrix_eq_of_add_eq_zero hBC1⟩
    calc (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₂
        = (C₁⁻¹ * C₁) * (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₂ := by
          rw [hGC, Matrix.one_mul]
      _ = C₁⁻¹ * (C₁ * (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₂) :=
          Matrix.mul_assoc _ _ _
      _ = 0 := by rw [hD1, Matrix.mul_zero]
  have hinj : Function.Injective (fun Y : ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K)))) =>
      ((Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁,
        (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₂)) := by
    intro Y Z h
    obtain ⟨hD, hC⟩ := hshape Y
    obtain ⟨kD, kC⟩ := hshape Z
    have hA : (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁ =
        (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₁ := congrArg Prod.fst h
    have hB : (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₂ =
        (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₂ := congrArg Prod.snd h
    have hC' : (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁ =
        (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁ := by
      have h1 : C₁ * (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁ =
          C₁ * (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁ := by rw [hC, kC, hB]
      calc (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁
          = (C₁⁻¹ * C₁) * (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁ := by
            rw [hGC, Matrix.one_mul]
        _ = C₁⁻¹ * (C₁ * (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁) :=
            Matrix.mul_assoc _ _ _
        _ = C₁⁻¹ * (C₁ * (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁) := by rw [h1]
        _ = (C₁⁻¹ * C₁) * (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁ :=
            (Matrix.mul_assoc _ _ _).symm
        _ = (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁ := by
            rw [hGC, Matrix.one_mul]
    apply Subtype.ext
    rw [← Matrix.fromBlocks_toBlocks (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K),
      ← Matrix.fromBlocks_toBlocks (Z : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K), hA, hB, hC',
      hD, kD]
  have hcardMM : Nat.card (Matrix (Fin 2) (Fin 2) K × Matrix (Fin 2) (Fin 2) K) =
      Nat.card K ^ 8 := by
    rw [Nat.card_prod]
    show Nat.card (Fin 2 → Fin 2 → K) * Nat.card (Fin 2 → Fin 2 → K) = _
    rw [Nat.card_fun, Nat.card_fun]
    simp only [Nat.card_eq_fintype_card (α := Fin 2), Fintype.card_fin]
    ring
  have hbij := hinj.bijective_of_nat_card_le (by rw [hcardMM]; exact hge)
  have hsurj : ∀ B : Matrix (Fin 2) (Fin 2) K, ∃ Y : ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K)))),
      (Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₁₂ = B := fun B => by
    obtain ⟨Y, hY⟩ := hbij.2 (0, B)
    exact ⟨Y, congrArg Prod.snd hY⟩
  have hmult : ∀ x ∈ E, ∃ l : K, sym2 (radA x) (radB x) (radD x) = l • C₁ ∧ l ^ 2 ^ a = l := by
    intro x hx
    refine burnsideK3_scalar hdet' (fun B => ?_)
    obtain ⟨Y, hY⟩ := hsurj B
    obtain ⟨-, -, hBC⟩ := burnsideK3_fix_rad (hER hx) (mem_matFix_image.mp Y.2 x hx)
    obtain ⟨-, -, hBC1⟩ := burnsideK3_fix_rad (hER hx₁E) (mem_matFix_image.mp Y.2 x₁ hx₁E)
    refine ⟨(Y : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K).toBlocks₂₁, ?_, ?_⟩
    · have := burnsideK3_matrix_eq_of_add_eq_zero hBC1
      rw [hY] at this
      exact this
    · have := burnsideK3_matrix_eq_of_add_eq_zero hBC
      rw [hY] at this
      exact this
  choose! l hl using hmult
  have hlinj : Function.Injective (fun x : E =>
      (⟨l (x : StatedSp 2 K), (burnsideK3_mem_fixF (a := a)).mpr (hl x x.2).2⟩ :
        ↥(burnsideK3_fixF K a))) := by
    intro x y hxy
    have hxy' : l (x : StatedSp 2 K) = l (y : StatedSp 2 K) := by
      have := congrArg Subtype.val hxy
      exact this
    have hC : sym2 (radA (x : StatedSp 2 K)) (radB (x : StatedSp 2 K)) (radD (x : StatedSp 2 K)) =
        sym2 (radA (y : StatedSp 2 K)) (radB (y : StatedSp 2 K)) (radD (y : StatedSp 2 K)) := by
      rw [(hl x x.2).1, (hl y y.2).1, hxy']
    have e00 := congrFun (congrFun hC 0) 0
    have e01 := congrFun (congrFun hC 0) 1
    have e11 := congrFun (congrFun hC 1) 1
    simp only [sym2, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons, Matrix.empty_val', Matrix.cons_val_fin_one] at e00 e01 e11
    exact Subtype.ext (radB_eq_of_radA_radD (hER x.2) (hER y.2) e00 e01 e11)
  have h1 := Nat.card_le_card_of_injective _ hlinj
  have h2 := burnsideK3_card_fixF (K := K) ha
  rw [hcard, hK, ← pow_mul] at h1
  have h3 : 2 ^ (2 * a * 2) ≤ 2 ^ a := h1.trans h2
  have := (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).mp h3
  omega

private theorem burnsideK3_ii_main [CharP K 2] [Finite K] {a : ℕ} (ha : 1 ≤ a)
    (hK : Nat.card K = 2 ^ (2 * a)) {E : Subgroup (StatedSp 2 K)}
    (hEsq : ∀ x ∈ E, x * x = 1) (hEU : E ≤ unipotent 2 K) {g₀ : StatedSp 2 K} (hg₀E : g₀ ∈ E)
    (hlev : lev g₀ ≠ 0) (hcard : Nat.card E = Nat.card K ^ 3) :
    Nat.card ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K)))) ≤ Nat.card K ^ 2 := by
  obtain ⟨C, hC, t, hg₀⟩ := mem_unipotent_iff.1 (hEU hg₀E)
  have hlevt : lev g₀ = t := by
    rw [hg₀, lev, coe_tau_mul_lam]
    simp [unitri]
  have ht : t ≠ 0 := by rw [← hlevt]; exact hlev
  exact burnsideK3_ii_card ha hK (fun c => burnsideK3_st_large hEsq hEU hg₀E hlev hcard 0 c) hC ht
    (hg₀ ▸ hg₀E)

private theorem burnsideK3_inn [CharP K 2] [Finite K] {a : ℕ} (ha : 1 ≤ a)
    (hK : Nat.card K = 2 ^ (2 * a))
    (hz : ∀ z : ↥(StatedSp 2 K), z * z = 1 → z ≠ 1 →
      Nat.card ↥(hermFix a (Fin 2 ⊕ Fin 2) K
        (spM '' ((Subgroup.zpowers z : Subgroup ↥(StatedSp 2 K)) : Set ↥(StatedSp 2 K)))) *
          Nat.card K ^ 3 ≤ Nat.card K ^ 8)
    (E : Subgroup ↥(StatedSp 2 K)) (hEsq : ∀ x ∈ E, x * x = 1) (hEU : E ≤ unipotent 2 K)
    (hE1 : E ≠ ⊥)
    (h8 : Nat.card K ^ 8 ≤ Nat.card ↥E ^ 2 *
      Nat.card ↥(hermFix a (Fin 2 ⊕ Fin 2) K (spM '' (E : Set ↥(StatedSp 2 K))))) :
    E = radical K := by
  classical
  have hq2 : 2 ≤ Nat.card K := by
    rw [hK]
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ (2 * a) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hpow := card_hermFix_le_pow ha hK E hEsq hEU
  have hc4 := finrank_fixK_le E
  have hcube := card_le_cube E hEsq
  have hMC : Nat.card ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K)))) =
      Nat.card ↥(hermFix a (Fin 2 ⊕ Fin 2) K (spM '' (E : Set ↥(StatedSp 2 K)))) ^ 2 :=
    card_matFix ha hK _
  have hCz : Nat.card ↥(hermFix a (Fin 2 ⊕ Fin 2) K (spM '' (E : Set ↥(StatedSp 2 K)))) ≤
      Nat.card K ^ 5 := by
    obtain ⟨⟨z, hzE⟩, hz1⟩ := (Subgroup.ne_bot_iff_exists_ne_one).mp hE1
    have hz1' : z ≠ 1 := fun h => hz1 (Subtype.ext h)
    have hle : hermFix a (Fin 2 ⊕ Fin 2) K (spM '' (E : Set ↥(StatedSp 2 K))) ≤
        hermFix a (Fin 2 ⊕ Fin 2) K
          (spM '' ((Subgroup.zpowers z : Subgroup ↥(StatedSp 2 K)) : Set ↥(StatedSp 2 K))) := by
      intro Y hY
      rw [mem_hermFix] at hY ⊢
      refine ⟨hY.1, fun g hg => hY.2 g ?_⟩
      obtain ⟨y, hy, rfl⟩ := hg
      exact ⟨y, (Subgroup.zpowers_le.mpr hzE) hy, rfl⟩
    have h1 := AddSubgroup.card_le_of_le hle
    have h2 := hz z (hEsq z hzE) hz1'
    have h3 : Nat.card ↥(hermFix a (Fin 2 ⊕ Fin 2) K
        (spM '' ((Subgroup.zpowers z : Subgroup ↥(StatedSp 2 K)) : Set ↥(StatedSp 2 K)))) *
          Nat.card K ^ 3 ≤ Nat.card K ^ 5 * Nat.card K ^ 3 := by
      calc _ ≤ Nat.card K ^ 8 := h2
        _ = Nat.card K ^ 5 * Nat.card K ^ 3 := by ring
    exact h1.trans (Nat.le_of_mul_le_mul_right h3 (by positivity))
  set C := Nat.card ↥(hermFix a (Fin 2 ⊕ Fin 2) K (spM '' (E : Set ↥(StatedSp 2 K)))) with hC
  set c := Module.finrank K (fixK E) with hc
  have hq1 : 1 ≤ Nat.card K := by omega
  have hpos : 0 < Nat.card K := by omega
  rcases (by omega : c = 4 ∨ c = 3 ∨ c = 2 ∨ c ≤ 1) with h4 | h3 | h2 | h1
  · exact absurd (eq_bot_of_finrank_fixK (Γ₀ := E) (by omega)) hE1
  · exfalso
    have hEq := card_le_of_finrank_fixK_three (Γ₀ := E) h3
    have : Nat.card E ^ 2 * C ≤ Nat.card K ^ 2 * Nat.card K ^ 5 := Nat.mul_le_mul (Nat.pow_le_pow_left hEq 2) hCz
    have h8' : Nat.card K ^ 8 ≤ Nat.card K ^ 7 := by calc Nat.card K ^ 8 ≤ _ := h8
                                      _ ≤ Nat.card K ^ 2 * Nat.card K ^ 5 := this
                                      _ = Nat.card K ^ 7 := by ring
    have : Nat.card K ^ 7 < Nat.card K ^ 8 := Nat.pow_lt_pow_right (by omega) (by norm_num)
    omega
  · rw [h2] at hpow
    by_cases hbig : Nat.card K ^ 2 < Nat.card E
    ·
      have hER := le_radical_of_finrank_two hEsq hEU hbig (by omega)
      have hM := card_matFix_radical_le ha hK hER hbig
      rw [hMC] at hM
      have hC2 : C ≤ Nat.card K ^ 2 := by
        have : C ^ 2 ≤ (Nat.card K ^ 2) ^ 2 := by rw [← pow_mul]; exact hM
        exact (Nat.pow_le_pow_iff_left (by norm_num)).mp this
      have hE3 : Nat.card K ^ 3 ≤ Nat.card E := by
        have h1 : (Nat.card K ^ 3) ^ 2 ≤ Nat.card E ^ 2 := by
          have h2 : Nat.card K ^ 8 ≤ Nat.card E ^ 2 * Nat.card K ^ 2 := h8.trans (Nat.mul_le_mul_left _ hC2)
          have h3 : (Nat.card K ^ 3) ^ 2 * Nat.card K ^ 2 ≤ Nat.card E ^ 2 * Nat.card K ^ 2 := by
            calc (Nat.card K ^ 3) ^ 2 * Nat.card K ^ 2 = Nat.card K ^ 8 := by ring
              _ ≤ _ := h2
          exact Nat.le_of_mul_le_mul_right h3 (by positivity)
        exact (Nat.pow_le_pow_iff_left (by norm_num)).mp h1
      refine Subgroup.eq_of_le_of_card_ge hER ?_
      rw [card_radical]
      exact hE3
    · push Not at hbig
      exfalso
      have hu : Nat.card E ^ 2 = Nat.card K ^ 4 := by
        have hle : Nat.card E ^ 2 ≤ Nat.card K ^ 4 := by
          calc Nat.card E ^ 2 ≤ (Nat.card K ^ 2) ^ 2 := Nat.pow_le_pow_left hbig 2
            _ = Nat.card K ^ 4 := by ring
        by_contra hne
        have hlt : Nat.card E ^ 2 < Nat.card K ^ 4 := lt_of_le_of_ne hle hne
        have h1 : Nat.card E ^ 2 * C ≤ (Nat.card K ^ 4 - 1) * Nat.card K ^ 4 :=
          Nat.mul_le_mul (by omega) hpow
        have h2 : (Nat.card K ^ 4 - 1) * Nat.card K ^ 4 < Nat.card K ^ 8 := by
          have : 0 < Nat.card K ^ 4 := by positivity
          have h3 : (Nat.card K ^ 4 - 1) * Nat.card K ^ 4 + Nat.card K ^ 4 = Nat.card K ^ 4 * Nat.card K ^ 4 := by
            rw [← Nat.succ_mul]
            congr 1
            omega
          have : Nat.card K ^ 4 * Nat.card K ^ 4 = Nat.card K ^ 8 := by ring
          omega
        omega
      have hE2 : Nat.card E = Nat.card K ^ 2 := by
        have : Nat.card E ^ 2 = (Nat.card K ^ 2) ^ 2 := by rw [hu]; ring
        exact (Nat.pow_left_injective (by norm_num : 2 ≠ 0)) this
      have hC4 : C = Nat.card K ^ 4 := by
        refine le_antisymm hpow ?_
        have : Nat.card K ^ 4 * Nat.card K ^ 4 ≤ Nat.card K ^ 4 * C := by
          calc Nat.card K ^ 4 * Nat.card K ^ 4 = Nat.card K ^ 8 := by ring
            _ ≤ Nat.card E ^ 2 * C := h8
            _ = Nat.card K ^ 4 * C := by rw [hu]
        exact Nat.le_of_mul_le_mul_left this (by positivity)
      have hM8 : Nat.card ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K)))) = Nat.card K ^ 8 := by
        rw [hMC, hC4]
        ring
      by_cases hER : E ≤ radical K
      · have := burnsideK3_i1_card ha hK hER hE2
        omega
      · obtain ⟨g₀, hg₀E, hg₀R⟩ : ∃ g ∈ E, g ∉ radical K := by
          by_contra hcon
          push Not at hcon
          exact hER hcon
        have hlev : lev g₀ ≠ 0 := fun h0 => hg₀R ((unipotent_facts (hEU hg₀E)).2.2 h0)
        have := burnsideK3_i2_card ha hK hEsq hEU hg₀E hlev h2 hE2
        have h78 : Nat.card K ^ 7 < Nat.card K ^ 8 := Nat.pow_lt_pow_right (by omega) (by norm_num)
        omega
  ·
    exfalso
    have hC2 : C ≤ Nat.card K ^ 2 := hpow.trans (Nat.pow_le_pow_right hq1 (by omega))
    have hE3 : Nat.card E = Nat.card K ^ 3 := by
      refine le_antisymm hcube ?_
      have h1 : (Nat.card K ^ 3) ^ 2 ≤ Nat.card E ^ 2 := by
        have h2 : Nat.card K ^ 8 ≤ Nat.card E ^ 2 * Nat.card K ^ 2 := h8.trans (Nat.mul_le_mul_left _ hC2)
        have h3 : (Nat.card K ^ 3) ^ 2 * Nat.card K ^ 2 ≤ Nat.card E ^ 2 * Nat.card K ^ 2 := by
          calc (Nat.card K ^ 3) ^ 2 * Nat.card K ^ 2 = Nat.card K ^ 8 := by ring
            _ ≤ _ := h2
        exact Nat.le_of_mul_le_mul_right h3 (by positivity)
      exact (Nat.pow_le_pow_iff_left (by norm_num)).mp h1
    have hCq2 : Nat.card K ^ 2 ≤ C := by
      have h1 : Nat.card K ^ 8 ≤ (Nat.card K ^ 3) ^ 2 * C := by rw [← hE3]; exact h8
      have h2 : (Nat.card K ^ 3) ^ 2 * Nat.card K ^ 2 ≤ (Nat.card K ^ 3) ^ 2 * C := by
        calc (Nat.card K ^ 3) ^ 2 * Nat.card K ^ 2 = Nat.card K ^ 8 := by ring
          _ ≤ _ := h1
      exact Nat.le_of_mul_le_mul_left h2 (by positivity)
    have hCeq : C = Nat.card K ^ 2 := le_antisymm hC2 hCq2
    have hM4 : Nat.card ↥(matFix a _ K (spM '' (E : Set (StatedSp 2 K)))) = Nat.card K ^ 4 := by
      rw [hMC, hCeq]
      ring
    have hER : ¬ E ≤ radical K := by
      intro hER
      have hplane : planeK K ≤ fixK E := fun v hv =>
        mem_fixK_of_le_radical hER hv |> fun h => by
          intro γ hγ
          exact h γ hγ
      have h1 := Submodule.finrank_mono hplane
      have h2 := (burnsideK3_isotropicPlane K).1
      omega
    obtain ⟨g₀, hg₀E, hg₀R⟩ : ∃ g ∈ E, g ∉ radical K := by
      by_contra hcon
      push Not at hcon
      exact hER hcon
    have hlev : lev g₀ ≠ 0 := fun h0 => hg₀R ((unipotent_facts (hEU hg₀E)).2.2 h0)
    have := burnsideK3_ii_main ha hK hEsq hEU hg₀E hlev hE3
    have h24 : Nat.card K ^ 2 < Nat.card K ^ 4 := Nat.pow_lt_pow_right (by omega) (by norm_num)
    omega

end Inn

