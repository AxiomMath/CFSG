private theorem burnsideKC_K324_core {V : Type} [CommGroup V] [Finite V] (hV : ∀ v : V, v ^ 2 = 1)
    {G L : Subgroup (MulAut V)} (hHyp : B4Hyp G L) (hq2 : qhatOf G ≤ ((2 : ℚ) : WithTop ℚ))
    {s : ℕ} (hs : 1 ≤ s) {F : Type} [Field F] [Finite F] [CharP F 2]
    (hFcard : Nat.card F = 2 ^ (2 * s)) (φ₀ : SL(3, F) →* ↥L)
    (hφs : Function.Surjective φ₀)
    (hφk : ∀ x, φ₀ x = 1 → x ∈ LocalAnalysis.ComponentInitial.LinearFlag.scalars 3 F)
