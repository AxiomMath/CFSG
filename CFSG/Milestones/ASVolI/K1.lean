private theorem burnsideKC_endIsF2_wedge4 {V : Type} [CommGroup V] [Finite V]
    [Module (ZMod 2) (Additive V)] {L : Subgroup (MulAut V)}
    (e : ↥L ≃* ↥(StatedSL 4 (ZMod 2))) {β : Additive V ≃ₗ[ZMod 2] (Fin 6 → ZMod 2)}
    (hβ : ∀ g w, β (repOf4 (phiOf4 e) g w) = wedgeRep4' g (β w)) : ChIJK.EndIsF2 L := by
  classical
  intro φ hφ
  let ψa : (Fin 6 → ZMod 2) →+ (Fin 6 → ZMod 2) :=
    β.toAddEquiv.toAddMonoidHom.comp
      ((MonoidHom.toAdditive φ).comp β.symm.toAddEquiv.toAddMonoidHom)
  let ψ : (Fin 6 → ZMod 2) →ₗ[ZMod 2] (Fin 6 → ZMod 2) := AddMonoidHom.toZModLinearMap 2 ψa
  have hψ : ∀ x, ψ x = β (Additive.ofMul (φ (Additive.toMul (β.symm x)))) := fun x => rfl
  have h2 : ∀ v : V, ψ (β (Additive.ofMul v)) = β (Additive.ofMul (φ v)) := by
    intro v
    rw [hψ, LinearEquiv.symm_apply_apply, toMul_ofMul]
  have hcomm : ∀ (g : G4) (x : Fin 6 → ZMod 2), ψ (wedgeRep4' g x) = wedgeRep4' g (ψ x) := by
    intro g x
    have h3 : ∀ v : V, wedgeRep4' g (β (Additive.ofMul v)) =
        β (Additive.ofMul ((((phiOf4 e).symm g : ↥L) : MulAut V) v)) := by
      intro v
      rw [← hβ g (Additive.ofMul v), repOf4_apply]
    have hx : x = β (Additive.ofMul (Additive.toMul (β.symm x))) := by
      rw [ofMul_toMul, LinearEquiv.apply_symm_apply]
    generalize Additive.toMul (β.symm x) = v at hx
    subst hx
    rw [h3, h2, h2, h3]
    congr 2
    exact hφ _ ((phiOf4 e).symm g).2 v
  have hy : ψ (Pi.single 0 1) = 0 ∨ ψ (Pi.single 0 1) = Pi.single 0 1 := by
    have hfix : ψ (Pi.single 0 1) ∈ datum4.fixU wedgeRep4' := by
      intro u hu
      rw [← hcomm, e01_mem_fixU u hu]
    obtain ⟨c, hc⟩ := fixU_wedge hfix
    rcases (by decide : ∀ c : ZMod 2, c = 0 ∨ c = 1) c with rfl | rfl
    · left; rw [hc, zero_smul]
    · right; rw [hc, one_smul]
  have hspan : ∀ (χ : (Fin 6 → ZMod 2) →ₗ[ZMod 2] (Fin 6 → ZMod 2)),
      (∀ g x, χ (wedgeRep4' g x) = wedgeRep4' g (χ x)) → χ (Pi.single 0 1) = 0 → ∀ x, χ x = 0 := by
    intro χ hχ h0 x
    have hle : SmithCurtis.orbitSpan wedgeRep4' (Pi.single 0 1) ≤ LinearMap.ker χ := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨g, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker, hχ, h0, map_zero]
    have hx : x ∈ SmithCurtis.orbitSpan wedgeRep4' (Pi.single 0 1) := by
      rw [wedge_gen]
      trivial
    exact hle hx
  rcases hy with h0 | h1
  · left
    have hall := hspan ψ hcomm h0
    ext v
    have := hall (β (Additive.ofMul v))
    rw [h2] at this
    have h2' : Additive.ofMul (φ v) = 0 := β.injective (by rw [this, map_zero])
    exact Additive.ofMul.injective h2'
  · right
    have hall := hspan (ψ - LinearMap.id) (fun g x => by
      simp only [LinearMap.sub_apply, LinearMap.id_apply, map_sub, hcomm g x]) (by simp [h1])
    ext v
    have := hall (β (Additive.ofMul v))
    rw [LinearMap.sub_apply, LinearMap.id_apply, h2, sub_eq_zero] at this
    have h2' : Additive.ofMul (φ v) = Additive.ofMul v := β.injective this
    exact Additive.ofMul.injective h2'

