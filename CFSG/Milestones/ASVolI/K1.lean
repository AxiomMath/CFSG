      B42SL3.exists_natural_of_single hF ρ bas hirr hnat.1 hnat.2 (Wj 0) e₀
    let ε := specialLinearGroupEquivStatedSL 3 F
    let π : ↥(StatedSL 3 F) →* ↥L := φ₀.comp (ψ.comp ε.symm.toMonoidHom)
    have hπ : Function.Surjective π := by
      intro l
