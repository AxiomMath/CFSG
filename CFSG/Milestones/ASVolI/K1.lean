    exact ((hTU _).mpr ⟨r, radical_le_unipotent hr, rfl⟩).1
  refine ⟨c.δ.symm.toMonoidHom, planeK c.K,
    ((radical c.K).map c.δ.symm.toMonoidHom).map L.subtype,
    burnsideK3_realizesVia c.hK c.θ L c.δ c.φ c.hφL,
    burnsideK3_trivialOnDynkinVia_of_dynP hGN hDyn, burnsideK3_isotropicPlane c.K, ?_,
    ⟨hXT, hXA.2.1, hXA.2.2⟩, hXrk, hXfix, hXr, hXcub, ?_⟩
  · unfold markedPlaneImage
    rw [burnsideK3_planeUnipotent_eq_radical]
  · exact burnsideK3_uniq hV ha c hVcard hTG hdisp hOut hTU

