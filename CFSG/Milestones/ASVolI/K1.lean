private theorem burnsideK3_uniq {V : Type} [CommGroup V] [Finite V] {G L T : Subgroup (MulAut V)}
    (hV : ∀ v : V, v ^ 2 = 1) {a : ℕ} (ha : 1 ≤ a) (c : burnsideK3_Coord V L a)
    (hVcard : Nat.card V = 2 ^ (16 * a)) (hTG : T ≤ G)
    (hdisp : ∀ l : ↥L, l * l = 1 → l ≠ 1 →
      2 ^ (6 * a) * Nat.card ↥(fixV (Subgroup.zpowers (l : MulAut V))) ≤ Nat.card V)
    (hOut : ∀ A : Subgroup (MulAut V), IsA2 G A → ¬ A ≤ L →
      Nat.card ↥A ^ 2 * Nat.card ↥(fixV A) < Nat.card V)
    (hTU : ∀ m : MulAut V, m ∈ T ⊓ L ↔
      ∃ u ∈ unipotent 2 c.K, ((c.δ.symm u : ↥L) : MulAut V) = m) :
    ∀ A : Subgroup (MulAut V), IsA2 T A → rAV A ≤ 2 →
      A = ((radical c.K).map c.δ.symm.toMonoidHom).map L.subtype := by
  classical
  intro A hA hr
  have hAG : IsA2 G A := ⟨hA.1.trans hTG, hA.2.1, hA.2.2⟩
  have h2 : Nat.card V ≤ Nat.card ↥A ^ 2 * Nat.card ↥(fixV A) :=
    (rAV_le_two_iff' hV hAG).mp hr
  have hAL : A ≤ L := by
    by_contra h
    exact absurd (hOut A hAG h) (not_lt.mpr h2)
  set E : Subgroup ↥(StatedSp 2 c.K) := (A.subgroupOf L).map c.δ.toMonoidHom with hE
  have hmemE : ∀ x ∈ E, ∃ l : ↥L, (l : MulAut V) ∈ A ∧ c.δ l = x := by
    rintro _ ⟨l, hl, rfl⟩
    exact ⟨l, hl, rfl⟩
  have hEU : E ≤ unipotent 2 c.K := by
    intro x hx
    obtain ⟨l, hlA, rfl⟩ := hmemE x hx
    obtain ⟨u, hu, hul⟩ := (hTU (l : MulAut V)).mp ⟨hA.1 hlA, l.2⟩
    have h1 : c.δ.symm u = l := Subtype.ext hul
    rw [← h1, MulEquiv.apply_symm_apply]
    exact hu
  have hEsq : ∀ x ∈ E, x * x = 1 := by
    intro x hx
    obtain ⟨l, hlA, rfl⟩ := hmemE x hx
    have hl2 : (l : MulAut V) * (l : MulAut V) = 1 := by
      rw [← sq]
      exact hA.2.2.2 _ hlA
    have : l * l = 1 := Subtype.ext hl2
    rw [← map_mul, this, map_one]
  have hcardE : Nat.card ↥E = Nat.card ↥A := by
    rw [hE, Subgroup.card_map_of_injective c.δ.injective]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAL).toEquiv
  have hE1 : E ≠ ⊥ := by
    intro h
    have h1 : Nat.card ↥E = 1 := by rw [h, Subgroup.card_bot]
    rw [hcardE] at h1
    exact hA.2.1 (Subgroup.eq_bot_of_card_eq A h1)
  have hfix := burnsideK3_card_fixV c A hAL
  have h8 : Nat.card c.K ^ 8 ≤ Nat.card ↥E ^ 2 *
      Nat.card ↥(hermFix a (Fin 2 ⊕ Fin 2) c.K (spM '' (E : Set ↥(StatedSp 2 c.K)))) := by
    rw [hcardE, ← hfix]
    have h6 : Nat.card c.K ^ 8 = Nat.card V := by
      rw [hVcard, c.hK, ← pow_mul]
      ring_nf
    rw [h6]
    exact h2
  have hEeq : E = radical c.K :=
    burnsideK3_inn ha c.hK (burnsideK3_hz c hVcard hdisp) E hEsq hEU hE1 h8
  have hsub : A.subgroupOf L = (radical c.K).map c.δ.symm.toMonoidHom := by
    rw [← hEeq, hE, Subgroup.map_map]
    ext l
    simp
  calc A = (A.subgroupOf L).map L.subtype := by
        rw [Subgroup.subgroupOf_map_subtype]
        exact (inf_eq_left.mpr hAL).symm
    _ = _ := by rw [hsub]

