open CFSG.LocalAnalysis.ComponentInitial.LinearFlag Matrix in
private theorem burnsideKC_card_scalars_le {F : Type} [Field F] : Nat.card (scalars 3 F) ≤ 3 := by
  rw [scalars_eq_center, Nat.card_congr
    (SpecialLinearGroup.center_equiv_rootsOfUnity' (⟨0, by norm_num⟩ : Fin 3)).toEquiv]
  simpa using card_rootsOfUnity F 3

open CFSG.LocalAnalysis.ComponentInitial.LinearFlag Matrix in
private theorem burnsideKC_orderOf_scalar {F : Type} [Field F] {z : SpecialLinearGroup (Fin 3) F}
    (hz : z ∈ scalars 3 F) (h1 : z ≠ 1) : orderOf z = 3 := by
  obtain ⟨c, hc, hzc⟩ := mem_scalars.1 hz
  refine orderOf_eq_prime ?_ h1
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_pow, hzc, Matrix.SpecialLinearGroup.coe_one]
  ext i j
  simp only [Matrix.scalar_apply, Matrix.diagonal_pow, Matrix.one_apply]
  by_cases hij : i = j
  · subst hij
    simp [← Units.val_pow_eq_pow_val, hc]
  · simp [hij]

open CFSG.LocalAnalysis.ComponentInitial.LinearFlag Matrix in
private theorem burnsideKC_scalars_bot_of_odd {F : Type} [Field F] [Finite F] {r : ℕ} (hr : Odd r)
    (hF : Nat.card F = 2 ^ r) : scalars 3 F = ⊥ := by
  by_contra hne
  obtain ⟨⟨z, hz⟩, hz1⟩ := (Subgroup.ne_bot_iff_exists_ne_one).1 hne
  have h3 : orderOf z = 3 :=
    burnsideKC_orderOf_scalar hz (fun h => hz1 (Subtype.ext h))
  have h4 : 3 ∣ Nat.card F - 1 := by
    have h5 : orderOf z ∣ Nat.card (scalars 3 F) :=
      Subgroup.orderOf_dvd_natCard _ hz
    rw [h3] at h5
    exact h5.trans (card_scalars_dvd (by norm_num))
  rw [hF] at h4
  obtain ⟨k, rfl⟩ := hr
  have h6 : 2 ^ (2 * k + 1) % 3 = 2 := by
    rw [pow_succ, pow_mul, Nat.mul_mod, Nat.pow_mod]
    norm_num
  have h7 : 1 ≤ 2 ^ (2 * k + 1) := Nat.one_le_two_pow
  generalize 2 ^ (2 * k + 1) = N at h4 h6 h7
  omega

open CFSG.LocalAnalysis.ComponentInitial.LinearFlag Matrix in
private theorem burnsideKC_center_bot_of_ker {F : Type} [Field F] [Finite F] {Λ : Type} [Group Λ]
    (φ : SpecialLinearGroup (Fin 3) F →* Λ)
    (hmap : (scalars 3 F).map φ = Subgroup.center Λ)
    {z : SpecialLinearGroup (Fin 3) F} (hz : z ∈ scalars 3 F) (hz1 : z ≠ 1) (hφ : φ z = 1) :
    Subgroup.center Λ = ⊥ := by
  have h3 : orderOf z = 3 := burnsideKC_orderOf_scalar hz hz1
  have hcard : Nat.card (Subgroup.zpowers z) = 3 := by rw [Nat.card_zpowers, h3]
  have hle : Subgroup.zpowers z ≤ scalars 3 F := (Subgroup.zpowers_le).2 hz
  have heq : Subgroup.zpowers z = scalars 3 F :=
    Subgroup.eq_of_le_of_card_ge hle (by rw [hcard]; exact burnsideKC_card_scalars_le)
  rw [← hmap, ← heq, MonoidHom.map_zpowers, hφ, Subgroup.zpowers_one_eq_bot]

private theorem burnsideKC_simple_of_center_bot {X : Type} [Group X] (hq : CFSG.IsQuasisimple X)
    (hZ : Subgroup.center X = ⊥) : IsSimpleGroup X := by
  have : IsSimpleGroup (X ⧸ Subgroup.center X) := hq.2.1
  exact MulEquiv.isSimpleGroup
    ((QuotientGroup.quotientBot.symm).trans (QuotientGroup.quotientMulEquivOfEq hZ.symm))

section

open CFSG.Quasithin CFSG.LocalAnalysis.ComponentInitial.LinearFlag in
private theorem burnsideKC_K32_three_structure {V : Type} [CommGroup V] [Finite V]
    (hV : ∀ v : V, v ^ 2 = 1) {G L : Subgroup (MulAut V)} (hHyp : B4Hyp G L) {r : ℕ}
    (hr : 1 ≤ r) (hmodel : StatedClassicalModel (↥L ⧸ Subgroup.center ↥L) .PSL 3 2 r) :
    ((IsSimpleGroup ↥L ∧ ChIJK.IsSLn 3 (2 ^ r) ↥L) ∨
      (Even r ∧ (ChIJK.IsSLn 3 (2 ^ r) ↥L ∨ IsPSL 3 2 r ↥L))) ∧
    (Odd r → Subgroup.center ↥L = ⊥) := by
  classical
  obtain ⟨-, F, hFf, hFfin, φ, hFcard, hcov⟩ := B42SL3.exists_cover hV hHyp hr hmodel
  have hSLiso : Function.Injective φ → ChIJK.IsSLn 3 (2 ^ r) ↥L := fun hinj =>
    ⟨F, hFf, hFfin, hFcard, ⟨(MulEquiv.ofBijective φ ⟨hinj, hcov.surjective⟩).symm.trans
      (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 3 F)⟩⟩
  have hZodd : Odd r → Subgroup.center ↥L = ⊥ := fun hodd => by
    have hZ0 := burnsideKC_scalars_bot_of_odd hodd hFcard
    rw [← hcov.map_scalars, hZ0, Subgroup.map_bot]
  refine ⟨?_, hZodd⟩
  rcases Nat.even_or_odd r with hev | hodd
  · right
    refine ⟨hev, ?_⟩
    by_cases hZ : Subgroup.center ↥L = ⊥
    · right
      exact IsPSL.of_mulEquiv ((QuotientGroup.quotientBot.symm).trans
        (QuotientGroup.quotientMulEquivOfEq hZ.symm)).symm hmodel
    · left
      apply hSLiso
      rw [injective_iff_map_eq_one]
      intro x hx
      by_contra hx1
      exact hZ (burnsideKC_center_bot_of_ker φ hcov.map_scalars (hcov.ker_le x hx) hx1 hx)
  · left
    have hZ0 := burnsideKC_scalars_bot_of_odd hodd hFcard
    have hinj : Function.Injective φ := (injective_iff_map_eq_one φ).2 fun x hx => by
      have := hcov.ker_le x hx
      rw [hZ0, Subgroup.mem_bot] at this
      exact this
    exact ⟨burnsideKC_simple_of_center_bot hHyp.2.2.1 (hZodd hodd), hSLiso hinj⟩

end

open CFSG.Quasithin CFSG.Quasithin.H Matrix in
private theorem burnsideKC_oTwoPrime_le_of_odd {V : Type} [CommGroup V] [Finite V]
    {G L : Subgroup (MulAut V)} (hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)))
    {n r : ℕ} (hn : 2 ≤ n) (hr : Odd r) {K : Type} [Field K] [Finite K]
    (hK : Nat.card K = 2 ^ r) {π : ↥(StatedSL n K) →* ↥L}
    (hπ : (FFModel.nat (StatedSL n K)).RealizesVia L ⊤ ⊥ π) :
    ChIJK.oTwoPrimeRes G ≤ L := by
  classical
  obtain ⟨e, he⟩ := exists_mulEquiv_of_realizesVia (StatedSL n K) hπ
  have hLe := map_congrHom_eq_natImage (StatedSL n K) hπ.1 e he
  have hΓ : HasScalarCommutant (StatedSL n K) := hasScalarCommutant_statedSL hn
  have hcπ : ∀ γ : ↥(StatedSL n K),
      congrHom e ((π γ : ↥L) : MulAut V) = natAut (StatedSL n K) γ := fun γ => by
    ext x
    rw [congrHom_apply, he, MulEquiv.apply_symm_apply]
    rfl
  have hr1 : 1 ≤ r := by
    obtain ⟨k, rfl⟩ := hr
    omega
  unfold ChIJK.oTwoPrimeRes
  rw [Subgroup.closure_le]
  rintro g ⟨hgG, k, hgk⟩
  have hĝ : congrHom e g ∈ natNorm (StatedSL n K) := by
    have h1 : (Subgroup.normalizer (L : Set (MulAut V))).map (congrHom e) =
        Subgroup.normalizer ((L.map (congrHom e) : Subgroup (MulAut (StdMod (Fin n) K))) :
          Set (MulAut (StdMod (Fin n) K))) :=
      Subgroup.map_equiv_normalizer_eq L (MulAut.congr e)
    rw [natNorm, ← hLe, ← h1]
    exact ⟨g, hGN hgG, rfl⟩
  haveI : Nonempty (Fin n) := ⟨⟨0, by omega⟩⟩
  obtain ⟨σ, hσ⟩ := exists_semilinear hΓ hĝ
  have hgk' : (congrHom e g) ^ (2 ^ k) = 1 := by rw [← map_pow, hgk, map_one]
  have hσk : σ ^ (2 ^ k) = 1 := by
    have h1 : IsSemilinear ((congrHom e g) ^ (2 ^ k)) (σ ^ (2 ^ k)) := hσ.pow (2 ^ k)
    rw [hgk'] at h1
    exact h1.unique isSemilinear_one
  obtain ⟨τ, -, -, -, hcard, -⟩ :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_automorphism_fixed_field_cardinality
      Nat.prime_two hr1 hK
  have hσ1 : σ = 1 := by
    have h1 : orderOf σ ∣ r := hcard ▸ orderOf_dvd_natCard σ
    have h2 : orderOf σ ∣ 2 ^ k := orderOf_dvd_of_pow_eq_one hσk
    have hcop : Nat.Coprime (2 ^ k) r := Nat.Coprime.pow_left k (Nat.coprime_two_left.2 hr)
    exact orderOf_eq_one_iff.1 (Nat.dvd_one.1 (hcop ▸ Nat.dvd_gcd h2 h1))
  obtain ⟨A, hA⟩ := exists_matAut_of_mem_linSub (mem_linSub.2 (hσ1 ▸ hσ))
  have hA2 : A ^ (2 ^ k) = 1 := by
    apply matHom_injective
    rw [map_pow, matHom_apply, ← hA, hgk', map_one]
  have hdet1 : GeneralLinearGroup.det A = 1 := by
    have h1 : (GeneralLinearGroup.det A) ^ (2 ^ k) = 1 := by rw [← map_pow, hA2, map_one]
    have h2 : orderOf (GeneralLinearGroup.det A) ∣ Nat.card Kˣ := orderOf_dvd_natCard _
    have h3 : orderOf (GeneralLinearGroup.det A) ∣ 2 ^ k := orderOf_dvd_of_pow_eq_one h1
    have hodd : Odd (Nat.card Kˣ) := by
      rw [Nat.card_units, hK]
      have h4 : 1 ≤ 2 ^ r := Nat.one_le_two_pow
      have h5 : Even (2 ^ r) := (Nat.even_pow' (by omega)).2 even_two
      obtain ⟨m, hm⟩ := h5
      exact ⟨m - 1, by omega⟩
    have hcop : Nat.Coprime (2 ^ k) (Nat.card Kˣ) :=
      Nat.Coprime.pow_left k (Nat.coprime_two_left.2 hodd)
    exact orderOf_eq_one_iff.1 (Nat.dvd_one.1 (hcop ▸ Nat.dvd_gcd h3 h2))
  have hAmem : A ∈ StatedSL n K := by
    rw [CFSG.Open.StatedAPI.mem_statedSL_iff, ← Matrix.GeneralLinearGroup.val_det_apply, hdet1]
    rfl
  have hg : congrHom e g = congrHom e ((π ⟨A, hAmem⟩ : ↥L) : MulAut V) := by
    rw [hcπ]
    exact hA
  have hg' : g = ((π ⟨A, hAmem⟩ : ↥L) : MulAut V) := congrHom_injective e hg
  rw [SetLike.mem_coe, hg']
  exact (π ⟨A, hAmem⟩).2


private theorem burnsideKC_oTwoPrime_le_self {Ω : Type} [Group Ω] (G : Subgroup Ω) :
    ChIJK.oTwoPrimeRes G ≤ G :=
  (Subgroup.closure_le G).2 fun _ hg => hg.1


open CFSG.QuasithinUnique.Setup.X7a CFSG.LocalAnalysis.ComponentInitial.LinearFlag in
open scoped MatrixGroups Matrix in
private theorem burnsideKC_up3_scalar {F : Type} [Field F] {x y z : F}
    (h : up3 x y z ∈ scalars 3 F) : up3 x y z = 1 := by
  obtain ⟨c, -, hc⟩ := mem_scalars.mp h
  have h01 := congrFun (congrFun hc 0) 1
  have h02 := congrFun (congrFun hc 0) 2
  have h12 := congrFun (congrFun hc 1) 2
  simp [up3_coe, upMat, Matrix.scalar_apply, Matrix.diagonal_apply] at h01 h02 h12
  rw [h01, h02, h12]
  exact up3_zero

private theorem burnsideKC_card_map_of_injOn {G H : Type} [Group G] [Group H] (f : G →* H)
    (S : Subgroup G) (hf : ∀ x ∈ S, f x = 1 → x = 1) :
    Nat.card (S.map f) = Nat.card S := by
  symm
  refine Nat.card_congr (Equiv.ofBijective
    (fun x : ↥S => (⟨f x, x, x.2, rfl⟩ : ↥(S.map f))) ⟨?_, ?_⟩)
  · intro x y h
    have h' : f x = f y := congrArg (fun z : ↥(S.map f) => (z : H)) h
    apply Subtype.ext
    have hm : (x : G)⁻¹ * y ∈ S := S.mul_mem (S.inv_mem x.2) y.2
    have h1 : f ((x : G)⁻¹ * y) = 1 := by rw [map_mul, map_inv, h', inv_mul_cancel]
    exact inv_mul_eq_one.mp (hf _ hm h1)
  · rintro ⟨_, x, hx, rfl⟩
    exact ⟨⟨x, hx⟩, rfl⟩

