open CFSG.Quasithin CFSG.QuasithinUnique.Setup.X7a CFSG.LocalAnalysis.ComponentInitial.LinearFlag in
open scoped MatrixGroups in
private theorem burnsideKC_classify {V : Type} [CommGroup V] [Finite V] {L : Subgroup (MulAut V)}
    {F : Type} [Field F] [Finite F] [CharP F 2] (π₀ : SL(3, F) →* ↥L)
    (hker : ∀ x, π₀ x = 1 → x ∈ scalars 3 F) {B : Subgroup (MulAut V)}
    (hel : IsElemAbelian2 B) (hBU : B ≤ ((upperUni F).map π₀).map L.subtype)
    (hcard : Nat.card F ^ 2 ≤ Nat.card B) :
    B = ((burnsideKC_Q1 F).map π₀).map L.subtype ∨
      B = ((burnsideKC_Q2 F).map π₀).map L.subtype := by
  classical
  have hB : ∀ b ∈ B, ∃ u ∈ upperUni F, ((π₀ u : ↥L) : MulAut V) = b := by
    intro b hb
    obtain ⟨l, ⟨u, hu, rfl⟩, rfl⟩ := hBU hb
    exact ⟨u, hu, rfl⟩
  have hQ : ∀ u ∈ upperUni F, ((π₀ u : ↥L) : MulAut V) ∈ B →
      u ∈ burnsideKC_Q1 F ∨ u ∈ burnsideKC_Q2 F := by
    intro u hu hb
    obtain ⟨x, y, z, rfl⟩ := mem_upperUni.mp hu
    have h2 : ∀ a : F, a + a = 0 := fun a => CharTwo.add_self_eq_zero a
    have hsq : (up3 x y z) ^ 2 ∈ scalars 3 F := by
      apply hker
      have h1 := hel.2 _ hb
      rw [map_pow]
      exact Subtype.ext (by simpa using h1)
    have hsq2 : (up3 x y z) ^ 2 = up3 0 (z * x) 0 := by
      rw [pow_two, up3_mul, h2 x, h2 z, show y + y + z * x = z * x by rw [h2 y, zero_add]]
    rw [hsq2] at hsq
    have h4 := up3_inj ((burnsideKC_up3_scalar hsq).trans up3_zero.symm)
    rcases mul_eq_zero.mp h4.2.1 with hz | hx
    · exact Or.inl ⟨x, y, by rw [hz]⟩
    · exact Or.inr ⟨y, z, by rw [hx]⟩
  obtain ⟨UB, hUB⟩ : ∃ UB : Subgroup SL(3, F),
      UB = upperUni F ⊓ B.comap (L.subtype.comp π₀) := ⟨_, rfl⟩
  have hUBmem : ∀ u, u ∈ UB ↔ u ∈ upperUni F ∧ ((π₀ u : ↥L) : MulAut V) ∈ B :=
    fun u => by rw [hUB]; rfl
  have hunion : UB ≤ burnsideKC_Q1 F ∨ UB ≤ burnsideKC_Q2 F := by
    by_contra hcon
    rw [not_or] at hcon
    obtain ⟨h1, h2⟩ := hcon
    obtain ⟨a, haUB, haQ1⟩ := SetLike.not_le_iff_exists.mp h1
    obtain ⟨b, hbUB, hbQ2⟩ := SetLike.not_le_iff_exists.mp h2
    have ha2 : a ∈ burnsideKC_Q2 F :=
      ((hQ a ((hUBmem a).1 haUB).1 ((hUBmem a).1 haUB).2)).resolve_left haQ1
    have hb1 : b ∈ burnsideKC_Q1 F :=
      ((hQ b ((hUBmem b).1 hbUB).1 ((hUBmem b).1 hbUB).2)).resolve_right hbQ2
    have hab : a * b ∈ UB := UB.mul_mem haUB hbUB
    rcases hQ (a * b) ((hUBmem _).1 hab).1 ((hUBmem _).1 hab).2 with h3 | h3
    · exact haQ1 (by simpa using (burnsideKC_Q1 F).mul_mem h3 ((burnsideKC_Q1 F).inv_mem hb1))
    · exact hbQ2 (by simpa using (burnsideKC_Q2 F).mul_mem ((burnsideKC_Q2 F).inv_mem ha2) h3)
  have hle : ∀ Q : Subgroup SL(3, F), UB ≤ Q → B ≤ (Q.map π₀).map L.subtype := by
    intro Q hQle b hb
    obtain ⟨u, hu, rfl⟩ := hB b hb
    exact ⟨π₀ u, ⟨u, hQle ((hUBmem u).2 ⟨hu, hb⟩), rfl⟩, rfl⟩
  have hcardP : ∀ Q : Subgroup SL(3, F), Q ≤ upperUni F → Nat.card Q = Nat.card F ^ 2 →
      Nat.card ((Q.map π₀).map L.subtype) = Nat.card F ^ 2 := by
    intro Q hQU hQc
    rw [Subgroup.card_map_of_injective L.subtype_injective,
      burnsideKC_card_map_of_injOn π₀ Q (fun x hx h => burnsideKC_pi0_injOn π₀ hker x (hQU hx) h),
      hQc]
  rcases hunion with h | h
  · left
    refine Subgroup.eq_of_le_of_card_ge (hle _ h) ?_
    rw [hcardP _ (burnsideKC_Q1_le F) (burnsideKC_card_Q1 F)]
    exact hcard
  · right
    refine Subgroup.eq_of_le_of_card_ge (hle _ h) ?_
    rw [hcardP _ (burnsideKC_Q2_le F) (burnsideKC_card_Q2 F)]
    exact hcard
