open scoped MatrixGroups Matrix in
private theorem burnsideKC_transport_iff {F : Type} [Field F] (A : GL (Fin 3) F) (φ : F ≃+* F)
    (Mx My : Matrix (Fin 3) (Fin 3) F)
    (hM : My = (A : Matrix (Fin 3) (Fin 3) F) * Mx.map φ *
      ((A⁻¹ : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F)) :
    ((∀ v : Fin 3 → F, v 2 = 0 → Mx *ᵥ v = v) ∧ ∀ v : Fin 3 → F, (Mx *ᵥ v - v) 2 = 0) ↔
    ((∀ w : Fin 3 → F, (((A⁻¹ : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) *ᵥ w) 2 = 0 →
        My *ᵥ w = w) ∧
      ∀ w : Fin 3 → F,
        (((A⁻¹ : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) *ᵥ (My *ᵥ w - w)) 2 = 0) := by
  classical
  set Ai : Matrix (Fin 3) (Fin 3) F := ((A⁻¹ : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) with hAi
  set Am : Matrix (Fin 3) (Fin 3) F := (A : Matrix (Fin 3) (Fin 3) F) with hAm
  have hAiA : Ai * Am = 1 := Units.inv_mul A
  have hAAi : Am * Ai = 1 := Units.mul_inv A
  let Θ : (Fin 3 → F) → (Fin 3 → F) := fun v => Am *ᵥ (fun i => φ (v i))
  have hΘ2 : ∀ v i, (Ai *ᵥ Θ v) i = φ (v i) := by
    intro v i
    simp only [Θ, Matrix.mulVec_mulVec, hAiA, Matrix.one_mulVec]
  have hΘsurj : ∀ w, ∃ v, Θ v = w := by
    intro w
    refine ⟨fun i => φ.symm ((Ai *ᵥ w) i), ?_⟩
    simp only [Θ, RingEquiv.apply_symm_apply]
    change Am *ᵥ (Ai *ᵥ w) = w
    rw [Matrix.mulVec_mulVec, hAAi, Matrix.one_mulVec]
  have hΘinj : ∀ v v', Θ v = Θ v' → v = v' := by
    intro v v' h
    funext i
    have := congrArg (fun w => (Ai *ᵥ w) i) h
    simp only [hΘ2] at this
    exact φ.injective this
  have hΘsub : ∀ v v', Θ (v - v') = Θ v - Θ v' := by
    intro v v'
    simp only [Θ]
    rw [← Matrix.mulVec_sub]
    congr 1
    funext i
    simp [map_sub]
  have hΘM : ∀ v, My *ᵥ Θ v = Θ (Mx *ᵥ v) := by
    intro v
    have h1 : My * Am = Am * Mx.map φ := by
      rw [hM, Matrix.mul_assoc, Matrix.mul_assoc, hAiA, Matrix.mul_one]
    have h2 : (fun i => φ ((Mx *ᵥ v) i)) = (Mx.map φ) *ᵥ (fun i => φ (v i)) := by
      funext i
      exact RingHom.map_mulVec φ.toRingHom Mx v i
    simp only [Θ]
    rw [Matrix.mulVec_mulVec, h1, ← Matrix.mulVec_mulVec, h2]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨fun w hw => ?_, fun w => ?_⟩
    · obtain ⟨v, rfl⟩ := hΘsurj w
      have hv2 : v 2 = 0 := by
        have := hΘ2 v 2
        rw [hw] at this
        exact φ.injective (by rw [← this, map_zero])
      rw [hΘM, h1 v hv2]
    · obtain ⟨v, rfl⟩ := hΘsurj w
      rw [hΘM, ← hΘsub, hΘ2, h2 v, map_zero]
  · rintro ⟨h1, h2⟩
    refine ⟨fun v hv => ?_, fun v => ?_⟩
    · apply hΘinj
      rw [← hΘM]
      apply h1
      rw [hΘ2, hv, map_zero]
    · have := h2 (Θ v)
      rw [hΘM, ← hΘsub, hΘ2] at this
      exact φ.injective (by rw [this, map_zero])


open CFSG.ASVolI.ChIJK CFSG.QuasithinUnique.Setup.X7a CFSG.Assembly.LowTwoRank in
