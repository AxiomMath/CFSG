open CFSG.Quasithin CFSG.Quasithin.B42Ln in
theorem as_K_3_2
    : K_3_2 := by
  intro V _ _ G L hK n r hn hL
  obtain ⟨hV, hHyp, hq2⟩ := hK
  have hW : ∀ v : V, v * v = 1 := fun v => by rw [← pow_two]; exact hV v
  have hLG : L ≤ G := le_G hHyp
  have hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)) := B42L2.le_normalizer_of_b4Hyp hHyp
  have hSL : SQTKGroup ↥L := B42Dispatch.sqtkGroup_of_le hHyp.1 hLG
  have hodd := CFSG.QuasithinUnique.Setup.Family.odd_card_center_of_irreducible hW
    (CFSG.QuasithinUnique.Bridge.TypeList.irr_of_isIrrSec hHyp.2.2.2)
  have hSQT := burnsideKC_sqt_center_quotient hHyp.1 hLG hHyp.2.2.1
  have hres : n = 3 ∨ ((n = 4 ∨ n = 5) ∧ r = 1) := by
    rcases CFSG.SectionRank.ClassicalEven.sqt_even_classical_restriction hSQT hL with
      ⟨-, h2, -⟩ | ⟨-, h3, -⟩ | ⟨-, h45, h1⟩ | ⟨ht, -⟩ | ⟨ht, -⟩
    · omega
    · exact Or.inl h3
    · exact Or.inr ⟨h45, h1⟩
    · exact absurd ht (by decide)
    · exact absurd ht (by decide)
  refine ⟨hres, ?_⟩
  rcases hres with rfl | ⟨hn45, rfl⟩
  ·
    have hr1 : 1 ≤ r := by
