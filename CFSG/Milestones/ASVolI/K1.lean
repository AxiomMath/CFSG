open CFSG.Quasithin CFSG.Quasithin.H13 CFSG.Quasithin.H13.Orbit CFSG.Quasithin.B45U33 in
private theorem burnsideKE_g2d_q
    {V : Type} [CommGroup V] [Finite V]
    (hV : ∀ v : V, v ^ 2 = 1) {G L : Subgroup (MulAut V)} (hHyp : B4Hyp G L)
    (hnat : G2NaturalDerived L ⊤ ⊥ 1) (hGL : G = L) :
    qOf G = ((3 / 2 : ℚ) : WithTop ℚ) ∧ qhatOf G = ((3 / 2 : ℚ) : WithTop ℚ) := by
  classical
  have hP := burnsideKE_u33_type hnat
  obtain ⟨e, hLe, hG⟩ := burnsideKE_u33_setup hHyp hnat
  have hV6 : Nat.card V = 2 ^ 6 := by
    rw [Nat.card_congr e.toEquiv, card_ModQ]
    norm_num
  set φ := (MulAut.congr e).toMonoidHom with hφ
  have hφinj : Function.Injective φ := (MulAut.congr e).injective
  have hQ : Nat.card ModQ = Nat.card V := by rw [card_ModQ, hV6]; norm_num
  have : Finite ModQ := Nat.finite_of_card_ne_zero (by rw [card_ModQ]; norm_num)
  have : Finite (MulAut ModQ) := Finite.of_injective _ DFunLike.coe_injective
  have hlow : ∀ B, IsA2 G B → ((3 / 2 : ℚ)) ≤ rAV B := by
    intro B hB
    have hBL : B ≤ L := hGL ▸ hB.1
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    obtain ⟨a, ha⟩ : ∃ a, Nat.card B = 2 ^ a := (IsPGroup.iff_card).1 hB.2.2.isPGroup
    obtain ⟨c, hc⟩ : ∃ c, Nat.card (fixV B) = 2 ^ c :=
      (IsPGroup.iff_card).1 ((isPGroup_two_of_sq_eq_one hV).to_subgroup (fixV B))
    have ha2 := B42U33.rank_le_two hP hBL hB.2.2 ha
    have ha1 : 1 ≤ a := by
      rcases Nat.eq_zero_or_pos a with rfl | h
      · exact absurd (Subgroup.eq_bot_of_card_eq B (by rw [ha, pow_zero])) hB.2.1
      · exact h
    have hnff : ¬ Nat.card V ≤ Nat.card B * Nat.card (fixV B) := by
      intro hff
      have hle' : B.map φ ≤ (g2QAct (ZMod 2)).range := by
        rintro _ ⟨b, hb, rfl⟩
        exact hG b (hB.1 hb)
      have hne' : B.map φ ≠ ⊥ := fun h0 =>
        hB.2.1 ((Subgroup.map_eq_bot_iff_of_injective _ hφinj).1 h0)
      have hcardB : Nat.card (B.map φ) = Nat.card B := Subgroup.card_map_of_injective hφinj
      have hfixB : Nat.card (fixV (B.map φ)) = Nat.card (fixV B) := by
        rw [hφ, fixV_map_congr, Subgroup.card_map_of_injective e.injective]
      have h8 := (B42U33.offender_exact hle' hne' (isElemAbelian2_map_congr e hB.2.2)
        (by rw [hcardB, hfixB, hQ]; exact hff)).1
      rw [hcardB, ha] at h8
      have h4 : 2 ^ a ≤ 2 ^ 2 := Nat.pow_le_pow_right (by norm_num) ha2
      omega
    have hac : a + c ≤ 5 := by
      by_contra hlt
      apply hnff
      rw [hV6, ha, hc, ← pow_add]
      exact Nat.pow_le_pow_right (by norm_num) (by omega)
    rw [rAV_eq_of_card hV6 ha hc]
    have hapos : (0 : ℚ) < (a : ℚ) := by exact_mod_cast ha1
    rw [le_div_iff₀ hapos]
    have h3 : 3 * a ≤ 2 * (6 - c) := by omega
    have h3' : ((3 * a : ℕ) : ℚ) ≤ ((2 * (6 - c) : ℕ) : ℚ) := by exact_mod_cast h3
    push_cast at h3'
    linarith
  obtain ⟨B₀, hB₀⟩ : ∃ B₀, B₀ = subB2.map (g2QAct (ZMod 2)) := ⟨_, rfl⟩
  obtain ⟨B, hB⟩ : ∃ B, B = B₀.map (MulAut.congr e.symm).toMonoidHom := ⟨_, rfl⟩
  have hB0L : B₀ ≤ L.map φ := by
    rw [hLe, hB₀]
    exact Subgroup.map_mono subB2_le
  have hBL : B ≤ L := by
    rw [hB]
    calc B₀.map (MulAut.congr e.symm).toMonoidHom ≤
        (L.map φ).map (MulAut.congr e.symm).toMonoidHom := Subgroup.map_mono hB0L
      _ = L := map_congr_symm_map e L
  have hB0card : Nat.card B₀ = 4 := by
    rw [hB₀]
    exact card_map_sListSub (by decide)
  have hBcard : Nat.card B = 4 := by
    rw [hB, Subgroup.card_map_of_injective (MulAut.congr e.symm).injective, hB0card]
  have hBfix : Nat.card (fixV B) = 8 := by
    rw [hB, fixV_map_congr, Subgroup.card_map_of_injective e.symm.injective, hB₀, subB2,
      card_fixV_sListSub, l4_fix]
  have hBe : IsElemAbelian2 B := by
    rw [hB, hB₀]
    exact isElemAbelian2_map_congr e.symm (isElemAbelian2_map_sListSub l4_comm)
  have hBne : B ≠ ⊥ := fun h0 => by
    have h2 : Nat.card B = 1 := by rw [h0, Subgroup.card_bot]
    omega
  have hBA2 : IsA2 G B := ⟨hGL ▸ hBL, hBne, hBe⟩
  have hBq : commSeries B 2 = ⊥ := by
    rw [← isQuadratic_iff_commSeries_two, hB, hB₀]
    exact isQuadratic_map_congr e.symm (isQuadratic_map_sListSub l4_quad)
  have hBr : rAV B = 3 / 2 := by
    rw [rAV_eq_of_card hV6 (show Nat.card B = 2 ^ 2 by rw [hBcard]; norm_num)
      (show Nat.card (fixV B) = 2 ^ 3 by rw [hBfix]; norm_num)]
    norm_num
  exact ⟨kq_eq_coe_iff.mpr ⟨⟨B, hBA2, hBq, hBr⟩, fun A' hA' _ => hlow A' hA'⟩,
    kq_eq_coe_iff.mpr ⟨⟨B, hBA2, commSeries_eq_bot_of_le (by norm_num) hBq, hBr⟩,
      fun A' hA' _ => hlow A' hA'⟩⟩

open CFSG.Quasithin CFSG.Quasithin.H13 CFSG.Quasithin.H13.Orbit CFSG.Quasithin.B42U33 in
private theorem burnsideKE_g2d_case4
    {V : Type} [CommGroup V] [Finite V]
    (hV : ∀ v : V, v ^ 2 = 1) {G L : Subgroup (MulAut V)} (hHyp : B4Hyp G L)
    (hnat : G2NaturalDerived L ⊤ ⊥ 1) {A : Subgroup (MulAut V)} (hA : IsFFStarOffender G A) :
    B42Case4 G L A := by
  classical
  have hP := burnsideKE_u33_type hnat
  obtain ⟨e, hLe, hG⟩ := burnsideKE_u33_setup hHyp hnat
  have hcard : Nat.card V = 2 ^ 6 := by
    rw [Nat.card_congr e.toEquiv, card_ModQ]
    norm_num
  have hLG := HatA6.le_of_b4Hyp hHyp
  set φ := (MulAut.congr e).toMonoidHom with hφ
  have hφinj : Function.Injective φ := (MulAut.congr e).injective
  have hoff : ∀ B, IsFFStarOffender G B → Nat.card B = 8 ∧ Nat.card (fixV B) = 8 :=
    fun B hB => offender_facts_of_equiv e hG hB
  obtain ⟨hA8, -⟩ := hoff A hA
  have hAL : ¬ A ≤ L := fun h => by
    have := rank_le_two hP h hA.2.2.1 (k := 3) (by rw [hA8]; norm_num)
    omega
  have hL6048 : Nat.card L = 6048 := card_of_b42TypeU33 hP
  have : Finite ModQ := Nat.finite_of_card_ne_zero (by rw [card_ModQ]; norm_num)
  have : Finite (MulAut ModQ) := Finite.of_injective _ DFunLike.coe_injective
  set J := ffJ G with hJdef
  have hJG : J ≤ G := iSup₂_le fun B hB => hB.1
  have hLJ : L ≤ J :=
    CFSG.QuasithinUnique.Bridge.TypeList.le_ffJ_of_b4Hyp (KP := CFSG.SectionRank.IsKGroupCat)
      hV hHyp hA
  have hAJ : A ≤ J := le_iSup₂ (f := fun B (_ : IsFFStarOffender G B) => B) A hA
  have hLJlt : L < J := lt_of_le_of_ne hLJ fun h => hAL (h ▸ hAJ)
  have hJcard : Nat.card J = 12096 := by
    have h1 : Nat.card L ∣ Nat.card J := Subgroup.card_dvd_of_le hLJ
    have h2 : Nat.card L < Nat.card J := Subgroup.card_lt_of_lt hLJlt
    have h3 : Nat.card J ≤ 12096 := by
      rw [← card_range_g2QAct, ← Subgroup.card_map_of_injective hφinj]
      refine Subgroup.card_le_of_le ?_
      rintro _ ⟨x, hx, rfl⟩
      exact hG x (hJG hx)
    rw [hL6048] at h1 h2
    obtain ⟨c, hc⟩ := h1
    rw [hc] at h2 h3 ⊢
    have : c = 2 := by omega
    rw [this]
  have hJimg : J.map φ = (g2QAct (ZMod 2)).range := by
    refine Subgroup.eq_of_le_of_card_ge ?_ ?_
    · rintro _ ⟨x, hx, rfl⟩
      exact hG x (hJG hx)
    · rw [card_range_g2QAct, Subgroup.card_map_of_injective hφinj, hJcard]
  have hnat' : G2Natural J ⊤ ⊥ 1 := by
    refine ⟨ZMod 2, inferInstance, inferInstance, by rw [Nat.card_zmod, pow_one], ?_⟩
    let r : ↥J ≃* ↥(g2QAct (ZMod 2)).range :=
      (J.equivMapOfInjective φ hφinj).trans (MulEquiv.subgroupCongr hJimg)
    refine H.FFModel.realizes_of_equiv (fun _ _ _ _ => trivial)
      ((Subgroup.topEquiv : (⊤ : Subgroup V) ≃* V).trans e) r (fun h u => ?_)
      (FFModel.zornQ_isActionModel (quasithinG2 (ZMod 2)) le_rfl).realizesMod_range
    change MulAut.congr e (h : MulAut V) (e u) = e ((h : MulAut V) u)
    exact congr_apply_eq e _ _
  refine ⟨⟨1, hnat', ?_, fun h => absurd h (lt_irrefl 1)⟩, ?_⟩
  ·
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    rw [rk, hA8, show (8 : ℕ) = 2 ^ 3 by norm_num, padicValNat.prime_pow]
  ·
    refine qOf_eq_of_offenders hV le_rfl (fun B hB => ?_) ⟨A, hA, B1_4_1 hV hA⟩
    obtain ⟨hB8, hB8'⟩ := hoff B hB
    refine HatA6.one_le_rAV_of_le_index hV hB.isA2 ?_
    have := (fixV B).card_mul_index
    rw [hB8', hcard] at this
    omega

open CFSG.Quasithin CFSG.Open CFSG.Quasithin.JonesParshall CFSG.Quasithin.Vol2.KGNat CFSG.Quasithin.Vol2.Ch11.G2Q8 CFSG.Quasithin.B42G2 in
private theorem burnsideKE_g2_case4 {V : Type} [CommGroup V] [Finite V] (hV : ∀ v : V, v ^ 2 = 1)
    {G L : Subgroup (MulAut V)} (hHyp : B4Hyp G L) {f : ℕ} (hf2 : 2 ≤ f)
    (hnat : G2NaturalDerived L ⊤ ⊥ f) {A : Subgroup (MulAut V)} (hA : IsFFStarOffender G A) :
    B42Case4 G L A := by
  have hHyp' := hHyp
  obtain ⟨-, hLF, -, hirr⟩ := hHyp
  have hGN : G ≤ Subgroup.normalizer (L : Set (MulAut V)) :=
    hLF ▸ le_normalizer_quasithinGenFitting G
  have hff : ∀ B, IsFFStarOffender G B → Nat.card V ≤ Nat.card B * Nat.card (fixV B) := by
    intro B hB
    have h := hB.2.2.2 ⊥ bot_le
    rwa [Subgroup.card_bot, one_mul, B1.fixV_bot, Subgroup.card_top] at h
  obtain ⟨K, _, _, hK, hreal'⟩ := hnat
  have : CharP K 2 := charP_two_of_card (by omega) hK
  obtain ⟨c₀, hc0, hc1⟩ := exists_ne_zero_ne_one (two_lt_card hK hf2)
  have heq : ⁅quasithinG2 K, quasithinG2 K⁆ = quasithinG2 K :=
    (g2Derived_eq hc0 hc1).trans
      CFSG.QuasithinUnique.Bridge.Alt57Model.quasithinG2_eq_cayleyGroup.symm
  have hreal : (FFModel.zornQ (quasithinG2 K)).Realizes L ⊤ ⊥ := by
    rw [← heq]
    exact hreal'
  obtain ⟨π, hπ⟩ := hreal'
  have hZ : Subgroup.center ↥L = ⊥ := by
    have hZG : Subgroup.center ↥(quasithinG2 K) = ⊥ := by
      rw [CFSG.QuasithinUnique.Bridge.Alt57Model.quasithinG2_eq_cayleyGroup]
      exact CFSG.Quasithin.A318Excl.center_cayleyGroup_eq_bot hc0 hc1
    obtain ⟨π0, hπ0⟩ := hreal
    let e0 : ↥(quasithinG2 K) ≃* ↥L :=
      FFC.equivOfRealizes (FFC.zornQ_faithful (quasithinG2 K) le_rfl) hπ0
    refine Subgroup.eq_bot_of_card_eq _ ?_
    rw [← Nat.card_congr (Subgroup.centerCongr e0).toEquiv, hZG, Subgroup.card_bot]
  obtain ⟨fc, hfc⟩ := exists_isCoord (lmG K) hπ
  have key : ∀ B, IsFFStarOffender G B →
      B ≤ L ∧ Nat.card B = Nat.card K ^ 3 ∧ Nat.card (fixV B) = Nat.card K ^ 3 := fun B hB =>
    (offender_facts hK hf2 hfc (hB.1.trans hGN) hB.2.2.1).2 hB.2.1 (hff B hB)
  have hJ : ffJ G = L :=
    le_antisymm (iSup₂_le fun B hB => (key B hB).1) (B5.Ln.le_ffJ_of_center hHyp' hZ hA)
  have hcardV : Nat.card V = 2 ^ (6 * f) := by
    rw [card_W hfc, hK, ← pow_mul, mul_comm]
  have hrk : ∀ B, IsFFStarOffender G B → rk ↥B = 3 * f := fun B hB => by
    rw [rk, (key B hB).2.1, hK, ← pow_mul, B42G2.padicValNat_two_pow, mul_comm]
  have hrAV : ∀ B, IsFFStarOffender G B → rAV B = 1 := by
    intro B hB
    have h1 := rk_add_rkIdx (fixV B)
    have h2 : rk ↥(fixV B) = 3 * f := by
      rw [rk, (key B hB).2.2, hK, ← pow_mul, B42G2.padicValNat_two_pow, mul_comm]
    have h3 : rk V = 6 * f := by
      rw [rk, hcardV, B42G2.padicValNat_two_pow]
    have h4 : rkIdx (fixV B) = 3 * f := by omega
    rw [rAV, h4, hrk B hB]
    have h5 : ((3 * f : ℕ) : ℚ) ≠ 0 := by
      rw [Nat.cast_ne_zero]
      omega
    exact div_self h5
  have hq : qOf G = ((1 : ℚ) : WithTop ℚ) :=
    qOf_eq_of_offenders hV le_rfl (fun B hB => (hrAV B hB).ge) ⟨A, hA, (hrAV A hA).le⟩
  refine ⟨⟨f, ?_, hrk A hA, fun _ => hJ⟩, hq⟩
  rw [hJ]
  exact ⟨K, inferInstance, inferInstance, hK, hreal⟩

