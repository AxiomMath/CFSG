private theorem burnsideKC_transport {V : Type} [CommGroup V] {L : Subgroup (MulAut V)} {F : Type}
    [Field F] (π : ↥(StatedSL 3 F) →* ↥L) {g : MulAut V} {A : GL (Fin 3) F} {φ : F ≃+* F}
    (hg : ∀ x : ↥(StatedSL 3 F), ∃ y : ↥(StatedSL 3 F),
      ((y : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) =
        (A : Matrix (Fin 3) (Fin 3) F) * (((x : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F).map φ) *
          ((A⁻¹ : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) ∧
      ((π y : ↥L) : MulAut V) = g * ((π x : ↥L) : MulAut V) * g⁻¹) :
    (markedPlaneImage L (StatedSL 3 F) π (burnsideKC_W0 F)).map (MulAut.conj g).toMonoidHom =
      markedPlaneImage L (StatedSL 3 F) π (burnsideKC_Wmat A) := by
  classical
  unfold markedPlaneImage planeUnipotent
  simp only [MonoidHom.map_closure]
  congr 1
  ext z
  constructor
  · rintro ⟨_, ⟨_, ⟨x, hx, rfl⟩, rfl⟩, rfl⟩
    obtain ⟨y, hy1, hy2⟩ := hg x
    obtain ⟨hx1, hx2⟩ := hx
    have key := (burnsideKC_transport_iff A φ ((x : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F)
      ((y : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) hy1).mp
      ⟨fun v hv => hx1 v (burnsideKC_mem_W0.mpr hv), fun v => burnsideKC_mem_W0.mp (hx2 v)⟩
    refine ⟨_, ⟨y, ⟨fun v hv => key.1 v (burnsideKC_mem_Wmat.mp hv),
      fun v => burnsideKC_mem_Wmat.mpr (key.2 v)⟩, rfl⟩, ?_⟩
    simp only [Subgroup.coe_subtype, MulEquiv.coe_toMonoidHom, MonoidHom.coe_coe]
    rw [hy2]
    rfl
  · rintro ⟨_, ⟨y, hy, rfl⟩, rfl⟩
    obtain ⟨hy1, hy2⟩ := hy
    set Ai : Matrix (Fin 3) (Fin 3) F := ((A⁻¹ : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) with hAi
    set Am : Matrix (Fin 3) (Fin 3) F := (A : Matrix (Fin 3) (Fin 3) F) with hAm
    set My : Matrix (Fin 3) (Fin 3) F := ((y : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) with hMy
    have hAiA : Ai * Am = 1 := Units.inv_mul A
    have hAAi : Am * Ai = 1 := Units.mul_inv A
    have hdetY : My.det = 1 := mem_statedSL_iff.mp y.2
    obtain ⟨Mx, hMx⟩ : ∃ Mx : Matrix (Fin 3) (Fin 3) F, Mx = (Ai * My * Am).map φ.symm :=
      ⟨_, rfl⟩
    have hMxφ : Mx.map φ = Ai * My * Am := by
      ext i j
      rw [Matrix.map_apply, hMx, Matrix.map_apply, RingEquiv.apply_symm_apply]
    have hdetX : Mx.det = 1 := by
      have h1 := RingHom.map_det φ.toRingHom Mx
      rw [RingHom.mapMatrix_apply] at h1
      have h2 : (Mx.map φ).det = 1 := by
        rw [hMxφ, Matrix.det_mul, Matrix.det_mul, hdetY, mul_one, ← Matrix.det_mul, hAiA,
          Matrix.det_one]
      have h3 : φ Mx.det = 1 := by
        have : φ.toRingHom Mx.det = (Mx.map ⇑φ.toRingHom).det := h1
        exact this.trans h2
      exact φ.injective (h3.trans (map_one φ).symm)
    obtain ⟨x, hx⟩ : ∃ x : ↥(StatedSL 3 F), ((x : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) = Mx :=
      ⟨specialLinearGroupEquivStatedSL 3 F ⟨Mx, hdetX⟩, rfl⟩
    have hrel : My = Am * Mx.map φ * Ai := by
      rw [hMxφ, show Am * (Ai * My * Am) * Ai = (Am * Ai) * My * (Am * Ai) by
        simp only [Matrix.mul_assoc], hAAi, Matrix.one_mul, Matrix.mul_one]
    have key := (burnsideKC_transport_iff A φ Mx My hrel).mpr
      ⟨fun w hw => hy1 w (burnsideKC_mem_Wmat.mpr hw),
        fun w => burnsideKC_mem_Wmat.mp (hy2 w)⟩
    obtain ⟨y', hy'1, hy'2⟩ := hg x
    have hyy : y' = y := by
      apply Subtype.ext
      apply Units.ext
      rw [hy'1, hx]
      exact hrel.symm
    subst hyy
    refine ⟨_, ⟨_, ⟨x, ⟨fun v hv => ?_, fun v => ?_⟩, rfl⟩, rfl⟩, ?_⟩
    · rw [hx]
      exact key.1 v hv
    · rw [hx]
      exact burnsideKC_mem_W0.mpr (key.2 v)
    · simp only [Subgroup.coe_subtype, MulEquiv.coe_toMonoidHom, MonoidHom.coe_coe]
      rw [hy'2]
      rfl
