@[expose] def K_3_6 : Prop :=
  ∀ (V : Type) [CommGroup V] [Finite V] (G L : Subgroup (MulAut V)), KSetup V G L →
    ∀ r : ℕ, IsSz r (Lbar L) → BinaryNaturalSz L ⊤ ⊥ r →
      Odd (MonoidHom.range (MulAut.conj : ↥L →* MulAut ↥L)).index ∧
      L = oTwoPrimeRes G ∧
      ∀ T, IsSylowTwoOf T G →
        rk ↥(ChIJK.omegaOne T) = r ∧
        (∀ x ∈ ChIJK.omegaOne T, x ≠ 1 → commV (Subgroup.zpowers x) = fixV (Subgroup.zpowers x)) ∧
        rk ↥(fixV (ChIJK.omegaOne T)) = 2 * r ∧ rAV (ChIJK.omegaOne T) = 2 ∧
        IsQuadratic (ChIJK.omegaOne T) ∧
        qhatOf G = qc 2 ∧ qOf G = qc 2 ∧ Qset T = {ChIJK.omegaOne T}

section

open CFSG.Quasithin CFSG.Quasithin.H CFSG.Blueprint CFSG.LieType.Ree CFSG.ASVolI.ChIJK in
theorem as_K_3_6 : K_3_6 := by
  intro V _ _ G L hKS r hr hnat
  have hV := hKS.elem2
  have hHyp := hKS.hyp
  have hq2 := hKS.qhat
  have hW : ∀ w : V, w * w = 1 := fun w => by rw [← pow_two]; exact hV w
  obtain ⟨hnt, hperf, hirr, hLG, hGN⟩ := B45Sz.b4Hyp_data hHyp
  obtain ⟨hLs, hSzL, -⟩ := burnsideKE_sz_natural hV hHyp hq2 hr
  have hP2 : ∀ P : Subgroup (MulAut V), IsPGroup 2 ↥P →
      P ≤ Subgroup.normalizer (L : Set (MulAut V)) → P ≤ L := by
    obtain ⟨-, a0, ha0, K0, _, _, rfl, hK0, ⟨α⟩⟩ := hr
    exact (QuasithinUnique.Setup.Family.suzuki_irreducible_normalizer_excludes a0 ha0 hK0 V hW L
      hperf hirr α).2.2.1
  obtain ⟨-, a, ha, K, _, _, hra, hK0, ⟨θ⟩⟩ := hSzL
  have hK : Nat.card K = 2 ^ (2 * a + 1) := by rw [← hra]; exact hK0
  have hqq := B45Sz.qOf_qhatOf_eq_two hLG hGN hnat
  refine ⟨burnsideKE_sz_odd_index ha hK θ, ?_, ?_⟩
  ·
    have ht : ∃ t ∈ L, t * t = 1 ∧ t ≠ 1 := by
      have hs := Sz.orderOf_suzukiSElt_zero_one hK
      refine ⟨((θ.symm (suzukiSElt a K 0 1) : ↥L) : MulAut V), (θ.symm _).2, ?_, ?_⟩
      · have h2 : (suzukiSElt a K 0 1) * suzukiSElt a K 0 1 = 1 := by
          rw [← pow_two, ← hs]
          exact pow_orderOf_eq_one _
        rw [← Subgroup.coe_mul, ← map_mul, h2, map_one]
        rfl
      · intro h
        have h1 : θ.symm (suzukiSElt a K 0 1) = 1 := Subtype.ext h
        have h2 : suzukiSElt a K 0 1 = 1 := by simpa using congrArg θ h1
        rw [h2, orderOf_one] at hs
        omega
    exact burnsideKE_oTwoPrimeRes hLG hLs ht (fun P hP hPG => hP2 P hP (hPG.trans hGN))
  · intro T hT
    obtain ⟨hTG, hT2, hTidx⟩ := hT
    have hTL : T ≤ L := hP2 T hT2 (hTG.trans hGN)
    have hTidxL : ¬ 2 ∣ (T.subgroupOf L).index := by
      have h1 := Subgroup.relIndex_mul_relIndex T L G hTL hLG
      intro h2
      apply hTidx
      have h3 : 2 ∣ T.relIndex L * L.relIndex G := Dvd.dvd.mul_right h2 _
      rw [h1] at h3
      exact h3
    obtain ⟨a', ha', hra', K', _, _, hK', hreal⟩ := hnat
    subst hra'
    obtain ⟨e, ρ, g, hρ, hρr, hρe, hΩ⟩ := burnsideKE_sz_T_data hK' hreal hT2 hTL hTidxL
    obtain ⟨hZe, hZrk, hZidx, hZq, hVcard⟩ := burnsideKE_sz_Z_props hK' e ρ hρe g
    rw [← hΩ] at hZe hZrk hZidx hZq
    have hZT : ChIJK.omegaOne T ≤ T := (Subgroup.closure_le T).2 fun x hx => hx.1
    have hZL : ChIJK.omegaOne T ≤ L := hZT.trans hTL
    have hVc : Nat.card V = 2 ^ (2 * (2 * (2 * a' + 1))) := by rw [hVcard]; ring_nf
    have hZcard : Nat.card (ChIJK.omegaOne T) = 2 ^ (2 * a' + 1) := by
      rw [card_eq_two_pow_of_isPGroup hZe.isPGroup, hZrk]
    have hrkV : rk V = 4 * (2 * a' + 1) := by rw [rk, hVcard, padicValNat.prime_pow]
    have hfixZrk : rk ↥(fixV (ChIJK.omegaOne T)) = 2 * (2 * a' + 1) := by
      have := rk_add_rkIdx (fixV (ChIJK.omegaOne T))
      omega
    have hfixZcard : Nat.card (fixV (ChIJK.omegaOne T)) = 2 ^ (2 * (2 * a' + 1)) := by
      rw [card_eq_two_pow_of_isPGroup ((isPGroup_two_of_sq_eq_one hV).to_subgroup _), hfixZrk]
    have hx : ∀ x ∈ ChIJK.omegaOne T, x ≠ 1 →
        commV (Subgroup.zpowers x) = fixV (Subgroup.zpowers x) ∧
          Nat.card (fixV (Subgroup.zpowers x)) = 2 ^ (2 * (2 * a' + 1)) := by
      intro x hxZ hx1
      have hx2 : x * x = 1 := by
        have := hZe.2 x hxZ
        rwa [pow_two] at this
      have hxL : x ∈ L := hZL hxZ
      have hord : orderOf x = 2 := orderOf_eq_prime (by rw [pow_two]; exact hx2) hx1
      have hN : congrHom e x ∈ natNorm (suzukiGroup a' K') := by
        obtain ⟨γ, hγ⟩ : x ∈ ρ.range := by rw [hρr]; exact hxL
        rw [← hγ, hρe]
        exact Subgroup.le_normalizer ⟨γ, rfl⟩
      have hord' : orderOf (congrHom e x) = 2 := by
        rw [orderOf_injective _ (congrHom_injective e) x]
        exact hord
      have h1 := Sz.rkIdx_fixV_of_involution ha' hK' hN hord'
      have h2 : rkIdx (fixV (Subgroup.zpowers x)) = 2 * (2 * a' + 1) := by
        rw [← rkIdx_fixV_map_congrHom e, MonoidHom.map_zpowers]
        exact h1
      exact burnsideKE_commV_eq_fixV_of_rkIdx hV hx2 hVc h2
    have hZne : ChIJK.omegaOne T ≠ ⊥ := by
      intro h
      have := hZcard
      rw [h, Subgroup.card_bot] at this
      have h2 : 1 < 2 ^ (2 * a' + 1) := Nat.one_lt_two_pow (by omega)
      omega
    have hZr : rAV (ChIJK.omegaOne T) = 2 := by
      rw [rAV, hZidx, hZrk]
      have : ((2 * a' + 1 : ℕ) : ℚ) ≠ 0 := by positivity
      push_cast
      field_simp
    refine ⟨hZrk, fun x hxZ hx1 => (hx x hxZ hx1).1, hfixZrk, hZr, hZq, hqq.2, hqq.1, ?_⟩
    ext A
    rw [Set.mem_singleton_iff]
    constructor
    · intro hA
      change (IsA2 T A ∧ rAV A ≤ (2 : ℚ)) ∧ commSeries A 2 = ⊥ at hA
      obtain ⟨⟨hA2, hAr⟩, -⟩ := hA
      have hAZ : A ≤ ChIJK.omegaOne T := by
        intro a ha
        exact Subgroup.subset_closure ⟨hA2.1 ha, hA2.2.2.2 a ha⟩
      obtain ⟨t, ht1⟩ := (Subgroup.ne_bot_iff_exists_ne_one).mp hA2.2.1
      have ht1' : (t : MulAut V) ≠ 1 := fun h => ht1 (Subtype.ext h)
      have htZ : (t : MulAut V) ∈ ChIJK.omegaOne T := hAZ t.2
      obtain ⟨-, hxcard⟩ := hx _ htZ ht1'
      have hfix1 : fixV (ChIJK.omegaOne T) ≤ fixV A := fun v hv y hy => hv y (hAZ hy)
      have hfix2 : fixV A ≤ fixV (Subgroup.zpowers (t : MulAut V)) := fun v hv y hy =>
        hv y ((Subgroup.zpowers_le.2 t.2) hy)
      have hfix3 : fixV (ChIJK.omegaOne T) ≤ fixV (Subgroup.zpowers (t : MulAut V)) :=
        hfix1.trans hfix2
      have hfix4 : fixV (ChIJK.omegaOne T) = fixV (Subgroup.zpowers (t : MulAut V)) :=
        Subgroup.eq_of_le_of_card_ge hfix3 (by rw [hxcard, hfixZcard])
      have hfixA : fixV A = fixV (ChIJK.omegaOne T) := le_antisymm (hfix4 ▸ hfix2) hfix1
      have hrkpos : 0 < rk ↥A := hA2.rk_pos
      have hAr' : (rkIdx (fixV A) : ℚ) / (rk ↥A : ℚ) ≤ 2 := hAr
      rw [hfixA, hZidx, div_le_iff₀ (by exact_mod_cast hrkpos)] at hAr'
      have hrkA : 2 * a' + 1 ≤ rk ↥A := by
        have : ((2 * (2 * a' + 1) : ℕ) : ℚ) ≤ ((2 * rk ↥A : ℕ) : ℚ) := by
          push_cast at hAr' ⊢
          linarith
        have := Nat.cast_le.1 this
        omega
      refine Subgroup.eq_of_le_of_card_ge hAZ ?_
      rw [hZcard, card_eq_two_pow_of_isPGroup hA2.2.2.isPGroup]
      exact Nat.pow_le_pow_right (by norm_num) hrkA
    · rintro rfl
      exact ⟨⟨⟨hZT, hZne, hZe⟩, hZr.le⟩, (isQuadratic_iff_commSeries_two _).1 hZq⟩

end

