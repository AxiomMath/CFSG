namespace CFSG.ASVolI

open CFSG.Quasithin CFSG.ASVolI.ChH CFSG.Quasithin.H.SL3Pair CFSG.Quasithin.H.L3Wr

@[expose] def H_4_1 : Prop :=
  (∀ g ∈ groupLT, ∀ x : PV, pairQ (g x) = pairQ x) ∧
  (∀ v w : Multiplicative (Fin 3 → ZMod 2),
    pairPolar (v, 1) (1, w) = ∑ i, Multiplicative.toAdd v i * Multiplicative.toAdd w i) ∧
  (∀ v : Multiplicative (Fin 3 → ZMod 2), pairQ (v, 1) = 0) ∧
  (∀ w : Multiplicative (Fin 3 → ZMod 2), pairQ (1, w) = 0) ∧
  (∀ i j : Fin 3, pairPolar (b1 i) (b2 j) = if i = j then 1 else 0)

private theorem pairQ_eq_dot (x : PV) :
    pairQ x = dotProduct (Multiplicative.toAdd x.1) (Multiplicative.toAdd x.2) := rfl

private theorem pairQ_pairHom (h : GL (Fin 3) (ZMod 2)) (x : PV) :
    pairQ (pairHom h x) = pairQ x := by
  rw [pairQ_eq_dot, pairQ_eq_dot, pairHom_apply, pairAut_apply]
  change dotProduct (Matrix.mulVec (h : Matrix (Fin 3) (Fin 3) (ZMod 2)) (Multiplicative.toAdd x.1))
    (Matrix.mulVec ((dualGL h : GL (Fin 3) (ZMod 2)) : Matrix (Fin 3) (Fin 3) (ZMod 2))
      (Multiplicative.toAdd x.2)) =
      dotProduct (Multiplicative.toAdd x.1) (Multiplicative.toAdd x.2)
  rw [coe_dualGL, Matrix.dotProduct_mulVec, Matrix.vecMul_transpose, Matrix.mulVec_mulVec]
  have hinv : ((h⁻¹ : GL (Fin 3) (ZMod 2)) : Matrix (Fin 3) (Fin 3) (ZMod 2)) *
      (h : Matrix (Fin 3) (Fin 3) (ZMod 2)) = 1 := by
    rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
  rw [hinv, Matrix.one_mulVec]

private theorem pairQ_swapT (x : PV) : pairQ (swapT x) = pairQ x := by
  rw [pairQ_eq_dot, pairQ_eq_dot]
  exact dotProduct_comm _ _

private def pairQStab : Subgroup (MulAut PV) where
  carrier := {g | ∀ x : PV, pairQ (g x) = pairQ x}
  mul_mem' := by
    intro a b ha hb x
    show pairQ (a (b x)) = pairQ x
    rw [ha, hb]
  one_mem' := fun _ => rfl
  inv_mem' := by
    intro a ha x
    have h := ha (a⁻¹ x)
    rw [← MulAut.mul_apply, mul_inv_cancel, MulAut.one_apply] at h
    exact h.symm

private theorem groupLT_pairQ (g : MulAut PV) (hg : g ∈ groupLT) (x : PV) :
    pairQ (g x) = pairQ x := by
  have hle : groupLT ≤ pairQStab := by
    refine sup_le ?_ (Subgroup.zpowers_le.mpr ?_)
    · intro k hk
      obtain ⟨h, -, rfl⟩ := Subgroup.mem_map.mp hk
      exact fun y => pairQ_pairHom h y
    · exact fun y => pairQ_swapT y
  exact hle hg x

private theorem pairPolar_b1_b2 (i j : Fin 3) :
    pairPolar (b1 i) (b2 j) = if i = j then 1 else 0 := by
  fin_cases i <;> fin_cases j <;> decide

theorem as_H_4_1 : H_4_1 := by
  unfold H_4_1
  refine ⟨fun g hg x => groupLT_pairQ g hg x, ?_, fun v => ?_, fun w => ?_, pairPolar_b1_b2⟩
  · intro v w
    have h1 : pairQ (v, 1) = 0 := by simp [pairQ]
    have h2 : pairQ (1, w) = 0 := by simp [pairQ]
    unfold pairPolar
    rw [h1, h2, add_zero, add_zero]
    simp [pairQ]
  · simp [pairQ]
  · simp [pairQ]

section H42

private def h42Det (a c1 c2 : Fin 3 → ZMod 2) : ZMod 2 :=
  a 0 * c1 1 * c2 2 - a 0 * c1 2 * c2 1 - c1 0 * a 1 * c2 2 + c1 0 * a 2 * c2 1 +
    c2 0 * a 1 * c1 2 - c2 0 * a 2 * c1 1

private def h42Col (a c1 c2 : Fin 3 → ZMod 2) : Matrix (Fin 3) (Fin 3) (ZMod 2) :=
  Matrix.of fun i j => ![a, c1, c2] j i

private theorem h42Col_det (a c1 c2 : Fin 3 → ZMod 2) :
    (h42Col a c1 c2).det = h42Det a c1 c2 := by
  simp [Matrix.det_fin_three, h42Col, h42Det]
  ring

private theorem h42_exists_one : ∀ a b : Fin 3 → ZMod 2, a ≠ 0 → b ≠ 0 →
    dotProduct b a = 1 →
    ∃ c1 c2 : Fin 3 → ZMod 2, h42Det a c1 c2 ≠ 0 ∧ dotProduct b c1 = 0 ∧ dotProduct b c2 = 0 := by
  decide

private theorem h42_exists_zero : ∀ a b : Fin 3 → ZMod 2, a ≠ 0 → b ≠ 0 →
    dotProduct b a = 0 →
    ∃ c1 c2 : Fin 3 → ZMod 2, h42Det a c1 c2 ≠ 0 ∧ dotProduct b c1 = 1 ∧ dotProduct b c2 = 0 := by
  decide

private theorem h42_exists_single : ∀ a : Fin 3 → ZMod 2, a ≠ 0 →
    ∃ c1 c2 : Fin 3 → ZMod 2, h42Det a c1 c2 ≠ 0 := by
  decide

private theorem h42Col_mulVec_e0 (a c1 c2 : Fin 3 → ZMod 2) :
    Matrix.mulVec (h42Col a c1 c2) (Pi.single 0 1) = a := by
  funext i
  fin_cases i <;> simp [h42Col, Matrix.mulVec, dotProduct, Fin.sum_univ_three, Pi.single_apply]

private theorem h42Col_transpose_mulVec (a c1 c2 b : Fin 3 → ZMod 2) :
    Matrix.mulVec (Matrix.transpose (h42Col a c1 c2)) b =
      ![dotProduct b a, dotProduct b c1, dotProduct b c2] := by
  funext j
  fin_cases j <;> simp [h42Col, Matrix.mulVec, dotProduct, Fin.sum_univ_three, mul_comm]

private theorem h42_inv_mulVec (M : Matrix (Fin 3) (Fin 3) (ZMod 2)) (hM : M.det ≠ 0)
    (b w : Fin 3 → ZMod 2) (h : Matrix.mulVec (Matrix.transpose M) b = w) :
    Matrix.mulVec (Matrix.transpose M⁻¹) w = b := by
  rw [← h, Matrix.mulVec_mulVec, ← Matrix.transpose_mul,
    Matrix.mul_nonsing_inv M (isUnit_iff_ne_zero.2 hM), Matrix.transpose_one, Matrix.one_mulVec]

private noncomputable def h42Gl (M : Matrix (Fin 3) (Fin 3) (ZMod 2)) (hM : M.det ≠ 0) :
    GL (Fin 3) (ZMod 2) :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero M hM

private theorem h42_pairHom_apply (h : GL (Fin 3) (ZMod 2)) (x : PV) :
    pairHom h x = (Multiplicative.ofAdd (Matrix.mulVec (h : Matrix (Fin 3) (Fin 3) (ZMod 2))
        (Multiplicative.toAdd x.1)),
      Multiplicative.ofAdd (Matrix.mulVec
        (Matrix.transpose ((h⁻¹ : GL (Fin 3) (ZMod 2)) : Matrix (Fin 3) (Fin 3) (ZMod 2)))
        (Multiplicative.toAdd x.2))) := rfl

private theorem h42_act (M : Matrix (Fin 3) (Fin 3) (ZMod 2)) (hM : M.det ≠ 0) (x : PV) :
    pairHom (h42Gl M hM) x = (Multiplicative.ofAdd (Matrix.mulVec M (Multiplicative.toAdd x.1)),
      Multiplicative.ofAdd (Matrix.mulVec (Matrix.transpose M⁻¹) (Multiplicative.toAdd x.2))) := by
  have e1 : ((h42Gl M hM : GL (Fin 3) (ZMod 2)) : Matrix (Fin 3) (Fin 3) (ZMod 2)) = M := rfl
  have e2 : (((h42Gl M hM)⁻¹ : GL (Fin 3) (ZMod 2)) : Matrix (Fin 3) (Fin 3) (ZMod 2)) = M⁻¹ :=
    Matrix.coe_units_inv (h42Gl M hM)
  rw [h42_pairHom_apply, e1, e2]

private theorem h42_pairHom_mem (h : GL (Fin 3) (ZMod 2)) : pairHom h ∈ groupLT :=
  Subgroup.mem_sup_left (Subgroup.mem_map.2 ⟨h, mem_SL32 h, rfl⟩)

private theorem h42_swap_apply (p : PV) : swapT p = (p.2, p.1) := rfl

private theorem h42_swap_mem : swapT ∈ groupLT :=
  Subgroup.mem_sup_right (Subgroup.mem_zpowers swapT)

private theorem h42_swap_sq : swapT * swapT = 1 :=
  MulEquiv.ext fun x => Prod.swap_swap x

private theorem h42_swap_conj (h : GL (Fin 3) (ZMod 2)) :
    swapT * pairHom h = pairHom (dualGL h) * swapT := by
  refine MulEquiv.ext fun x => Prod.ext rfl ?_
  show CFSG.Quasithin.H.matAut h x.1 = CFSG.Quasithin.H.matAut (dualGL (dualGL h)) x.1
  rw [dualGL_dualGL]

private theorem h42_pair_swap (k : GL (Fin 3) (ZMod 2)) :
    pairHom k * swapT = swapT * pairHom (dualGL k) := by
  have h := h42_swap_conj (dualGL k)
  rw [dualGL_dualGL] at h
  exact h.symm

private theorem h42_decomp {g : MulAut PV} (hg : g ∈ groupLT) :
    (∃ h : GL (Fin 3) (ZMod 2), g = pairHom h) ∨
      (∃ h : GL (Fin 3) (ZMod 2), g = swapT * pairHom h) := by
  let X : Subgroup (MulAut PV) :=
    { carrier := {g | (∃ h : GL (Fin 3) (ZMod 2), g = pairHom h) ∨
        (∃ h : GL (Fin 3) (ZMod 2), g = swapT * pairHom h)}
      mul_mem' := by
        rintro a b (⟨h, rfl⟩ | ⟨h, rfl⟩) (⟨k, rfl⟩ | ⟨k, rfl⟩)
        · exact Or.inl ⟨h * k, (map_mul pairHom h k).symm⟩
        · refine Or.inr ⟨dualGL h * k, ?_⟩
          rw [← mul_assoc, h42_pair_swap h, mul_assoc, ← map_mul]
        · exact Or.inr ⟨h * k, by rw [mul_assoc, ← map_mul]⟩
        · refine Or.inl ⟨dualGL h * k, ?_⟩
          calc (swapT * pairHom h) * (swapT * pairHom k)
              = swapT * ((pairHom h * swapT) * pairHom k) := by group
            _ = swapT * ((swapT * pairHom (dualGL h)) * pairHom k) := by rw [h42_pair_swap h]
            _ = pairHom (dualGL h) * pairHom k := by
                rw [← mul_assoc, ← mul_assoc, h42_swap_sq, one_mul]
            _ = pairHom (dualGL h * k) := (map_mul pairHom _ _).symm
      one_mem' := Or.inl ⟨1, (map_one pairHom).symm⟩
      inv_mem' := by
        rintro a (⟨h, rfl⟩ | ⟨h, rfl⟩)
        · exact Or.inl ⟨h⁻¹, (map_inv pairHom h).symm⟩
        · refine Or.inr ⟨dualGL h⁻¹, ?_⟩
          rw [mul_inv_rev, ← map_inv, inv_eq_of_mul_eq_one_right h42_swap_sq, h42_pair_swap] }
  have hle : groupLT ≤ X := by
    refine sup_le ?_ (Subgroup.zpowers_le.2 ?_)
    · intro g hg
      obtain ⟨h, -, rfl⟩ := Subgroup.mem_map.1 hg
      exact Or.inl ⟨h, rfl⟩
    · exact Or.inr ⟨1, by rw [map_one, mul_one]⟩
  exact hle hg

private theorem h42_T_inv {g : MulAut PV} (hg : g ∈ groupLT) (x : PV) :
    ((g x).1 = 1 ∨ (g x).2 = 1) ↔ (x.1 = 1 ∨ x.2 = 1) := by
  rcases h42_decomp hg with ⟨h, rfl⟩ | ⟨h, rfl⟩
  · have e1 : CFSG.Quasithin.H.matAut h x.1 = 1 ↔ x.1 = 1 :=
      MulEquiv.map_eq_one_iff (CFSG.Quasithin.H.matAut h)
    have e2 : CFSG.Quasithin.H.matAut (dualGL h) x.2 = 1 ↔ x.2 = 1 :=
      MulEquiv.map_eq_one_iff (CFSG.Quasithin.H.matAut (dualGL h))
    exact or_congr e1 e2
  · have e1 : CFSG.Quasithin.H.matAut (dualGL h) x.2 = 1 ↔ x.2 = 1 :=
      MulEquiv.map_eq_one_iff (CFSG.Quasithin.H.matAut (dualGL h))
    have e2 : CFSG.Quasithin.H.matAut h x.1 = 1 ↔ x.1 = 1 :=
      MulEquiv.map_eq_one_iff (CFSG.Quasithin.H.matAut h)
    exact (or_congr e1 e2).trans or_comm

private theorem h42_swap_not_mem (k : GL (Fin 3) (ZMod 2)) :
    swapT * pairHom k ∉ pairSL (ZMod 2) := by
  rintro ⟨m, -, hm⟩
  have h := congrArg (fun φ : MulAut PV => (φ (Multiplicative.ofAdd (Pi.single 0 1), 1)).2) hm
  have h1 : (pairHom m (Multiplicative.ofAdd (Pi.single 0 1), 1)).2 = 1 :=
    map_one (CFSG.Quasithin.H.matAut (dualGL m))
  have h2 : ((swapT * pairHom k) (Multiplicative.ofAdd (Pi.single 0 1), 1)).2 =
      CFSG.Quasithin.H.matAut k (Multiplicative.ofAdd (Pi.single 0 1)) := rfl
  rw [h1, h2] at h
  have h3 := (MulEquiv.map_eq_one_iff (CFSG.Quasithin.H.matAut k)).1 h.symm
  exact absurd h3 (by decide)

private theorem h42_relIndex_pairSL :
    (pairSL (ZMod 2) : Subgroup (MulAut PV)).relIndex groupLT = 2 := by
  refine Subgroup.relIndex_eq_two_iff.2 ⟨swapT, h42_swap_mem, fun b hb => ?_⟩
  rcases h42_decomp hb with ⟨h, rfl⟩ | ⟨h, rfl⟩
  · have hmem : pairHom h ∈ pairSL (ZMod 2) := Subgroup.mem_map.2 ⟨h, mem_SL32 h, rfl⟩
    have hnot : pairHom h * swapT ∉ pairSL (ZMod 2) := by
      rw [h42_pair_swap h]
      exact h42_swap_not_mem (dualGL h)
    exact Or.inr ⟨hmem, hnot⟩
  · have hnot : swapT * pairHom h ∉ pairSL (ZMod 2) := h42_swap_not_mem h
    have hmem : (swapT * pairHom h) * swapT ∈ pairSL (ZMod 2) := by
      have e : (swapT * pairHom h) * swapT = pairHom (dualGL h) := by
        rw [h42_swap_conj, mul_assoc, h42_swap_sq, mul_one]
      rw [e]
      exact Subgroup.mem_map.2 ⟨dualGL h, mem_SL32 _, rfl⟩
    exact Or.inl ⟨hmem, hnot⟩

private theorem h42_pairSL_card : Nat.card (pairSL (ZMod 2)) = 168 :=
  CFSG.Quasithin.H.SL3One.card_pairSL (by rw [Nat.card_eq_fintype_card, ZMod.card])

private theorem h42_card_LT : Nat.card groupLT = 336 := by
  have hPL : pairSL (ZMod 2) ≤ groupLT := le_sup_left
  have h := Subgroup.relIndex_mul_card (H := pairSL (ZMod 2)) (K := groupLT)
  rw [inf_eq_left.2 hPL, h42_relIndex_pairSL, h42_pairSL_card] at h
  exact h.symm.trans (by norm_num)

private theorem h42_pairQ_b10 : pairQ (b1 0) = 0 := by decide

private theorem h42_pairQ_b1b2 : pairQ (b1 0 * b2 1) = 0 := by decide

private theorem h42_pairQ_b1b0 : pairQ (b1 0 * b2 0) = 1 := by decide

private theorem h42_toAdd_ne_zero {z : Multiplicative (Fin 3 → ZMod 2)} (h : z ≠ 1) :
    Multiplicative.toAdd z ≠ 0 := fun h' => h (by rw [← ofAdd_toAdd z, h']; exact ofAdd_zero)

private theorem h42_zmod2_eq_zero_of_ne_one (z : ZMod 2) (h : z ≠ 1) : z = 0 := by
  revert z; decide

private theorem h42_cover (x y : Multiplicative (Fin 3 → ZMod 2)) (hv : (x, y) ≠ (1 : PV)) :
    (∃ g ∈ groupLT, g (b1 0) = (x, y)) ∨ (∃ g ∈ groupLT, g (b1 0 * b2 1) = (x, y)) ∨
      (∃ g ∈ groupLT, g (b1 0 * b2 0) = (x, y)) := by
  by_cases hy : y = 1
  · subst hy
    have hx : x ≠ 1 := fun h => hv (by rw [h]; rfl)
    obtain ⟨c1, c2, hd⟩ := h42_exists_single _ (h42_toAdd_ne_zero hx)
    have hM : (h42Col (Multiplicative.toAdd x) c1 c2).det ≠ 0 := by rw [h42Col_det]; exact hd
    refine Or.inl ⟨pairHom (h42Gl _ hM), h42_pairHom_mem _, ?_⟩
    rw [h42_act]
    simp only [b1, toAdd_ofAdd, toAdd_one, Matrix.mulVec_zero, ofAdd_zero, h42Col_mulVec_e0,
      ofAdd_toAdd]
  · by_cases hx : x = 1
    · subst hx
      obtain ⟨c1, c2, hd⟩ := h42_exists_single _ (h42_toAdd_ne_zero hy)
      have hM : (h42Col (Multiplicative.toAdd y) c1 c2).det ≠ 0 := by rw [h42Col_det]; exact hd
      refine Or.inl ⟨swapT * pairHom (h42Gl _ hM), Subgroup.mul_mem _ h42_swap_mem
        (h42_pairHom_mem _), ?_⟩
      rw [MulAut.mul_apply, h42_act]
      simp only [b1, toAdd_ofAdd, toAdd_one, Matrix.mulVec_zero, ofAdd_zero, h42Col_mulVec_e0,
        ofAdd_toAdd, h42_swap_apply]
    · have ha := h42_toAdd_ne_zero hx
      have hb := h42_toAdd_ne_zero hy
      by_cases hdot : dotProduct (Multiplicative.toAdd y) (Multiplicative.toAdd x) = 1
      · obtain ⟨c1, c2, hd, h1, h2⟩ := h42_exists_one _ _ ha hb hdot
        have hM : (h42Col (Multiplicative.toAdd x) c1 c2).det ≠ 0 := by rw [h42Col_det]; exact hd
        have hT : Matrix.mulVec (Matrix.transpose (h42Col (Multiplicative.toAdd x) c1 c2))
            (Multiplicative.toAdd y) = Pi.single 0 1 := by
          rw [h42Col_transpose_mulVec, hdot, h1, h2]
          funext i
          fin_cases i <;> simp
        have hinv := h42_inv_mulVec _ hM _ _ hT
        refine Or.inr (Or.inr ⟨pairHom (h42Gl _ hM), h42_pairHom_mem _, ?_⟩)
        rw [h42_act]
        simp only [b1, b2, h42_swap_apply, Prod.mk_mul_mk, mul_one, one_mul,
          toAdd_ofAdd, toAdd_one, Matrix.mulVec_zero, h42Col_mulVec_e0, ofAdd_toAdd, hinv]
      · have hdot0 := h42_zmod2_eq_zero_of_ne_one _ hdot
        obtain ⟨c1, c2, hd, h1, h2⟩ := h42_exists_zero _ _ ha hb hdot0
        have hM : (h42Col (Multiplicative.toAdd x) c1 c2).det ≠ 0 := by rw [h42Col_det]; exact hd
        have hT : Matrix.mulVec (Matrix.transpose (h42Col (Multiplicative.toAdd x) c1 c2))
            (Multiplicative.toAdd y) = Pi.single 1 1 := by
          rw [h42Col_transpose_mulVec, hdot0, h1, h2]
          funext i
          fin_cases i <;> simp
        have hinv := h42_inv_mulVec _ hM _ _ hT
        refine Or.inr (Or.inl ⟨pairHom (h42Gl _ hM), h42_pairHom_mem _, ?_⟩)
        rw [h42_act]
        simp only [b1, b2, h42_swap_apply, Prod.mk_mul_mk, mul_one, one_mul,
          toAdd_ofAdd, toAdd_one, Matrix.mulVec_zero, h42Col_mulVec_e0, ofAdd_toAdd, hinv]

private theorem h42_dvd_relIndex (S : Subgroup (MulAut PV)) (hSP : S ≤ pairSL (ZMod 2)) :
    2 ∣ S.relIndex groupLT := by
  have hPL : pairSL (ZMod 2) ≤ groupLT := le_sup_left
  have hrel := Subgroup.relIndex_mul_relIndex S (pairSL (ZMod 2) : Subgroup (MulAut PV)) groupLT
    hSP hPL
  have h2 : (pairSL (ZMod 2) : Subgroup (MulAut PV)).relIndex groupLT = 2 := h42_relIndex_pairSL
  have h3 := congrArg (fun t : ℕ => S.relIndex (pairSL (ZMod 2) : Subgroup (MulAut PV)) * t) h2
  exact ⟨S.relIndex (pairSL (ZMod 2) : Subgroup (MulAut PV)), (hrel.symm.trans h3).trans
    (mul_comm _ _)⟩

private theorem h42_not_tc_b10 : ¬ IsTwoCentralVec groupLT (b1 0) := by
  rintro ⟨S, hS, hfix⟩
  have hSP : S ≤ pairSL (ZMod 2) := by
    intro s hs
    rcases h42_decomp (hS.le hs) with ⟨h, rfl⟩ | ⟨h, rfl⟩
    · exact Subgroup.mem_map.2 ⟨h, mem_SL32 h, rfl⟩
    · exfalso
      have e := congrArg Prod.fst (hfix _ hs)
      have h1 : ((swapT * pairHom h) (b1 0)).1 = 1 :=
        map_one (CFSG.Quasithin.H.matAut (dualGL h))
      exact absurd (e.symm.trans h1) (by decide)
  exact hS.not_dvd_relIndex (h42_dvd_relIndex S hSP)

private theorem h42_orbit_b1b2 :
    MulAction.orbit (↥groupLT) (b1 0 * b2 1) =
      ((Finset.univ.filter (fun w : PV => w.1 ≠ 1 ∧ w.2 ≠ 1 ∧ pairQ w = 0) : Finset PV) :
        Set PV) := by
  ext w
  constructor
  · rintro ⟨g, rfl⟩
    have hTv : ¬ ((b1 0 * b2 1).1 = 1 ∨ (b1 0 * b2 1).2 = 1) := by decide
    have hT := mt (h42_T_inv g.2 (b1 0 * b2 1)).1 hTv
    rw [not_or] at hT
    refine Finset.mem_coe.2 (Finset.mem_filter.2 ⟨Finset.mem_univ _, hT.1, hT.2, ?_⟩)
    exact (groupLT_pairQ g g.2 (b1 0 * b2 1)).trans h42_pairQ_b1b2
  · intro hw
    obtain ⟨-, hx, hy, hq⟩ := Finset.mem_filter.1 (Finset.mem_coe.1 hw)
    have hdot : dotProduct (Multiplicative.toAdd w.2) (Multiplicative.toAdd w.1) = 0 := by
      rw [dotProduct_comm, ← pairQ_eq_dot, hq]
    obtain ⟨c1, c2, hd, h1, h2⟩ := h42_exists_zero _ _ (h42_toAdd_ne_zero hx)
      (h42_toAdd_ne_zero hy) hdot
    have hM : (h42Col (Multiplicative.toAdd w.1) c1 c2).det ≠ 0 := by
      rw [h42Col_det]
      exact hd
    have hT : Matrix.mulVec (Matrix.transpose (h42Col (Multiplicative.toAdd w.1) c1 c2))
        (Multiplicative.toAdd w.2) = Pi.single 1 1 := by
      rw [h42Col_transpose_mulVec, hdot, h1, h2]
      funext i
      fin_cases i <;> simp
    have hinv := h42_inv_mulVec _ hM _ _ hT
    refine ⟨⟨pairHom (h42Gl _ hM), h42_pairHom_mem _⟩, ?_⟩
    show (pairHom (h42Gl _ hM)) (b1 0 * b2 1) = w
    rw [h42_act]
    simp only [b1, b2, h42_swap_apply, Prod.mk_mul_mk, mul_one, one_mul, toAdd_ofAdd, toAdd_one,
      h42Col_mulVec_e0, ofAdd_toAdd, hinv, Prod.mk.eta]

private theorem h42_tc_b1b2 : IsTwoCentralVec groupLT (b1 0 * b2 1) := by
  classical
  haveI : Fintype ↥groupLT := Fintype.ofFinite _
  haveI : Fintype (MulAction.orbit (↥groupLT) (b1 0 * b2 1)) := Fintype.ofFinite _
  haveI : Fintype (MulAction.stabilizer (↥groupLT) (b1 0 * b2 1)) := Fintype.ofFinite _
  have hcardorb : Nat.card (MulAction.orbit (↥groupLT) (b1 0 * b2 1)) = 21 := by
    rw [h42_orbit_b1b2, Nat.card_coe_set_eq, Set.ncard_coe_finset]
    decide
  have hos := MulAction.card_orbit_mul_card_stabilizer_eq_card_group (G := ↥groupLT)
    (b1 0 * b2 1)
  rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card,
    hcardorb, h42_card_LT] at hos
  have hstab : Nat.card (MulAction.stabilizer (↥groupLT) (b1 0 * b2 1)) = 16 := by omega
  set S' : Subgroup (MulAut PV) := (MulAction.stabilizer (↥groupLT) (b1 0 * b2 1)).map
    groupLT.subtype with hS'def
  have hS'card : Nat.card S' = 16 :=
    (Subgroup.card_map_of_injective (f := groupLT.subtype)
      (Subgroup.subtype_injective groupLT)).trans hstab
  have hS'le : S' ≤ groupLT := Subgroup.map_subtype_le _
  have hsyl : IsSylowIn 2 S' groupLT := by
    refine ⟨hS'le, IsPGroup.of_card (n := 4) (by rw [hS'card]; norm_num), ?_⟩
    have h1 := Subgroup.relIndex_mul_card (H := S') (K := groupLT)
    rw [inf_eq_left.2 hS'le, hS'card, h42_card_LT] at h1
    rintro ⟨c, hc⟩
    omega
  refine ⟨S', hsyl, fun s hs => ?_⟩
  obtain ⟨x, hx, rfl⟩ := Subgroup.mem_map.1 hs
  exact (MulAction.mem_stabilizer_iff.1 hx)

private theorem h42_not_b10_b1b2 : ¬ ∃ g ∈ groupLT, g (b1 0) = b1 0 * b2 1 := by
  rintro ⟨g, hg, heq⟩
  have hL := (h42_T_inv hg (b1 0)).2 (Or.inr rfl)
  rw [heq] at hL
  exact absurd hL (by decide)

private theorem h42_not_b10_b1b0 : ¬ ∃ g ∈ groupLT, g (b1 0) = b1 0 * b2 0 := by
  rintro ⟨g, hg, heq⟩
  have h := groupLT_pairQ g hg (b1 0)
  rw [heq, h42_pairQ_b1b0, h42_pairQ_b10] at h
  exact absurd h (by decide)

private theorem h42_not_b1b2_b1b0 : ¬ ∃ g ∈ groupLT, g (b1 0 * b2 1) = b1 0 * b2 0 := by
  rintro ⟨g, hg, heq⟩
  have h := groupLT_pairQ g hg (b1 0 * b2 1)
  rw [heq, h42_pairQ_b1b0, h42_pairQ_b1b2] at h
  exact absurd h (by decide)

end H42

@[expose] def H_4_2 : Prop :=
  (∀ v : PV, v ≠ 1 → (∃ g ∈ groupLT, g (b1 0) = v) ∨ (∃ g ∈ groupLT, g (b1 0 * b2 1) = v) ∨
      (∃ g ∈ groupLT, g (b1 0 * b2 0) = v)) ∧
  (¬ ∃ g ∈ groupLT, g (b1 0) = b1 0 * b2 1) ∧ (¬ ∃ g ∈ groupLT, g (b1 0) = b1 0 * b2 0) ∧
  (¬ ∃ g ∈ groupLT, g (b1 0 * b2 1) = b1 0 * b2 0) ∧
  (pairQ (b1 0) = 0 ∧ ¬ IsTwoCentralVec groupLT (b1 0)) ∧
  (pairQ (b1 0 * b2 1) = 0 ∧ IsTwoCentralVec groupLT (b1 0 * b2 1)) ∧
  pairQ (b1 0 * b2 0) = 1

theorem as_H_4_2 : H_4_2 := by
  refine ⟨fun v hv => h42_cover v.1 v.2 hv, h42_not_b10_b1b2, h42_not_b10_b1b0,
    h42_not_b1b2_b1b0, ⟨h42_pairQ_b10, h42_not_tc_b10⟩, ⟨h42_pairQ_b1b2, h42_tc_b1b2⟩,
    h42_pairQ_b1b0⟩

@[expose] def H_4_3 : Prop :=
  ∀ M : Subgroup (MulAut PV), perfectCore M = pairSL (ZMod 2) → swapT ∈ M →
  ∀ A : Subgroup (MulAut PV), A ≤ M → IsElemAbelian2 A → Nat.card A = 4 →
    (¬ A ≤ pairSL (ZMod 2) → rk ↥(fixV A) = 2 ∧ rk ↥(xiSub A) = 5) ∧
    (A ≤ pairSL (ZMod 2) → ∃ g ∈ M,
      fixV (conjAut g A) = Subgroup.closure {b1 0, b2 1, b2 2} ∧ rk ↥(fixV (conjAut g A)) = 3 ∧
      xiSub (conjAut g A) = V1sub ⊔ fixV (conjAut g A) ∧ rk ↥(xiSub (conjAut g A)) = 5 ∧
      commOn (xiSub (conjAut g A)) (conjAut g A) = Subgroup.zpowers (b1 0))

theorem as_H_4_3 : H_4_3 := by
  intro M hM hs A hAM hA2 hA4
  have hMN : M ≤ CFSG.Quasithin.H.SL3Pair.pairNorm (ZMod 2) :=
    RonanH43.le_pairNorm_of_perfectCore hM
  have hLM : pairSL (ZMod 2) ≤ M := by
    rw [← hM]
    exact perfectCore_le M
  exact ⟨fun hnot => RonanH43.part1 (hAM.trans hMN) hA2 hA4 hnot,
    fun hle => RonanH43.part2 hLM hs hA2 hA4 hle⟩

section H44glue

open CFSG.Quasithin.H.L3Nine CFSG.Quasithin.H.SU3 Matrix

variable {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ}

private theorem h44_mulVec_two {h : Matrix (Fin 3) (Fin 3) K} (h0 : h 2 0 = 0) (h1 : h 2 1 = 0)
    {v : Fin 3 → K} (hv : v 2 = 0) : (h.mulVec v) 2 = 0 := by
  simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three, h0, h1, hv]

private theorem h44_mulVec_one_two {h : Matrix (Fin 3) (Fin 3) K} (h0 : h 1 0 = 0)
    (h1 : h 2 0 = 0) {v : Fin 3 → K} (hv1 : v 1 = 0) (hv2 : v 2 = 0) :
    (h.mulVec v) 1 = 0 ∧ (h.mulVec v) 2 = 0 := by
  constructor <;> simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three, h0, h1, hv1, hv2]

private theorem h44_slStab_spW : slStab (spW K) = CFSG.Quasithin.RonanH44.stabW K := by
  ext g
  constructor
  · intro hg
    have h0 := (hg (Pi.single 0 1) (by simp [spW])).1
    have h1 := (hg (Pi.single 1 1) (by simp [spW])).1
    refine ⟨?_, ?_⟩
    · simpa [spW, Matrix.mulVec, dotProduct, Fin.sum_univ_three, Pi.single_apply] using h0
    · simpa [spW, Matrix.mulVec, dotProduct, Fin.sum_univ_three, Pi.single_apply] using h1
  · intro hg v hv
    have hv2 : v 2 = 0 := hv
    have hgi := inv_mem hg
    exact ⟨h44_mulVec_two hg.1 hg.2 hv2, h44_mulVec_two hgi.1 hgi.2 hv2⟩

private theorem h44_slStab_spZ : slStab (spZ K) = CFSG.Quasithin.RonanH44.stabZ K := by
  ext g
  constructor
  · intro hg
    have h0 := (hg (Pi.single 0 1) (by simp [spZ])).1
    refine ⟨?_, ?_⟩
    · have := h0.1
      simpa [Matrix.mulVec, dotProduct, Fin.sum_univ_three, Pi.single_apply] using this
    · have := h0.2
      simpa [Matrix.mulVec, dotProduct, Fin.sum_univ_three, Pi.single_apply] using this
  · intro hg v hv
    obtain ⟨hv1, hv2⟩ : v 1 = 0 ∧ v 2 = 0 := hv
