        NineFaithfulSection scalar
          (img hK ⊓ Subgroup.centralizer ({i} : Set (MulAut (HMod n K))))
          ⊤ (fixV (Subgroup.zpowers i)) 3) ∧
    ((Odd n → Nonempty (↥(img hK) ≃* PSL(3, K))) ∧ (Even n → Nonempty (↥(img hK) ≃* SL(3, K))))

