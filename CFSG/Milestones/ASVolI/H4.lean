    (∀ A : Subgroup (MulAut (HMod n K)), IsA2 M A → rk ↥A = 4 * n → rkIdx (fixV A) = 5 * n →
      ¬ ∃ x ∈ img hK, x ≠ 1 ∧ orderOf x = 2 ^ n - 1 ∧ ∀ v ∈ fixV A, x v = v) ∧
    (∀ i ∈ M, i ∉ img hK → orderOf i = 2 →
