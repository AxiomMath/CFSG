private theorem mem_fixV_conjSubgroup {W : Type*} [CommGroup W] (B : Subgroup (MulAut W))
    (g : MulAut W) (v : W) : v ∈ fixV (conjSubgroup B g) ↔ g v ∈ fixV B := by
  have hinv : ∀ z : W, g (g⁻¹ z) = z := fun z => by
    rw [← MulAut.mul_apply, mul_inv_cancel] <;> rfl
  have hinv' : ∀ z : W, g⁻¹ (g z) = z := fun z => by
    rw [← MulAut.mul_apply, inv_mul_cancel] <;> rfl
  constructor
  · intro hv y hy
    have hmem : g⁻¹ * y * g ∈ conjSubgroup B g := by
      rw [mem_conjSubgroup_iff]
      have e : g * (g⁻¹ * y * g) * g⁻¹ = y := by group
      rw [e]
      exact hy
    have h : g⁻¹ (y (g v)) = v := hv _ hmem
    calc y (g v) = g (g⁻¹ (y (g v))) := (hinv _).symm
      _ = g v := by rw [h]
  · intro hg x hx
    have hmem : g * x * g⁻¹ ∈ B := mem_conjSubgroup_iff.1 hx
    have h : g (x (g⁻¹ (g v))) = g v := hg _ hmem
    rw [hinv'] at h
    exact g.injective h

private theorem conjSubgroup_mem_aSet {W : Type*} [CommGroup W] {k : ℕ}
    {X A Y : Subgroup (MulAut W)} (g : MulAut W) (hA : A ∈ E3.aSet k X)
    (hY : conjSubgroup A g ≤ Y) : conjSubgroup A g ∈ E3.aSet k Y := by
  obtain ⟨-, hA1, ⟨hcomm, hsq⟩, hfix⟩ := hA
  refine ⟨hY, ?_, ⟨?_, ?_⟩, ?_⟩
  · intro h0
    apply hA1
    rw [← E3.conjSubgroup_conj_inv A g, h0, E3.conjSubgroup_bot]
  · intro a ha b hb
    have hc := hcomm _ (mem_conjSubgroup_iff.1 ha) _ (mem_conjSubgroup_iff.1 hb)
    calc a * b = g⁻¹ * (g * a * g⁻¹ * (g * b * g⁻¹)) * g := by group
      _ = g⁻¹ * (g * b * g⁻¹ * (g * a * g⁻¹)) * g := by rw [hc]
      _ = b * a := by group
  · intro a ha
    have hs := hsq _ (mem_conjSubgroup_iff.1 ha)
    have e : g⁻¹ * (g * a * g⁻¹) ^ 2 * g = a ^ 2 := by
      rw [pow_two, pow_two]
      group
    calc a ^ 2 = g⁻¹ * (g * a * g⁻¹) ^ 2 * g := e.symm
      _ = g⁻¹ * 1 * g := by rw [hs]
      _ = 1 := by group
  · intro B hB hm
    obtain ⟨B0, rfl⟩ : ∃ B0, conjSubgroup B0 g = B :=
      ⟨conjSubgroup B g⁻¹, E3.conjSubgroup_inv_conj B g⟩
    have hB0 : B0 ≤ A := (E3.conjSubgroup_le_conjSubgroup_iff g).1 hB
    rw [E3.mQuot_conjSubgroup] at hm
    have hf : fixV B0 = fixV A := hfix B0 hB0 hm
    ext v
    rw [mem_fixV_conjSubgroup, mem_fixV_conjSubgroup, hf]

private theorem mulVec_e0_apply (M : Matrix (Fin 3) (Fin 3) (ZMod 2)) (i : Fin 3) :
    Matrix.mulVec M (Pi.single 0 1) i = M i 0 := by
  simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three, Pi.single_apply]

private theorem mulVec_e1_apply (M : Matrix (Fin 3) (Fin 3) (ZMod 2)) (i : Fin 3) :
    Matrix.mulVec M (Pi.single 1 1) i = M i 1 := by
  simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three, Pi.single_apply]

private theorem mulVec_e0_eq_iff (M : Matrix (Fin 3) (Fin 3) (ZMod 2)) :
    Matrix.mulVec M (Pi.single 0 1) = Pi.single 0 1 ↔
      M 1 0 = 0 ∧ M 2 0 = 0 ∧ M 0 0 = 1 := by
  constructor
  · intro h
    have h0 := congrFun h 0
    have h1 := congrFun h 1
    have h2 := congrFun h 2
    rw [mulVec_e0_apply] at h0 h1 h2
    simp [Pi.single_apply] at h0 h1 h2
    exact ⟨h1, h2, h0⟩
  · rintro ⟨h1, h2, h0⟩
    ext i
    fin_cases i <;> simp [mulVec_e0_apply, Pi.single_apply, h0, h1, h2]

private theorem vecMul_e2_eq_iff (M : Matrix (Fin 3) (Fin 3) (ZMod 2)) :
    Matrix.vecMul (Pi.single 2 1) M = Pi.single 2 1 ↔
      M 2 0 = 0 ∧ M 2 1 = 0 ∧ M 2 2 = 1 := by
  constructor
  · intro h
    have h0 := congrFun h 0
    have h1 := congrFun h 1
    have h2 := congrFun h 2
    simp [Matrix.vecMul, dotProduct, Fin.sum_univ_three, Pi.single_apply] at h0 h1 h2
    exact ⟨h0, h1, h2⟩
  · rintro ⟨h0, h1, h2⟩
    ext j
    fin_cases j <;> simp [Matrix.vecMul, dotProduct, Fin.sum_univ_three, Pi.single_apply, h0, h1, h2]

private theorem mulVec_e1_eq_iff (M : Matrix (Fin 3) (Fin 3) (ZMod 2)) :
    Matrix.mulVec M (Pi.single 1 1) = Pi.single 1 1 ↔
      M 0 1 = 0 ∧ M 2 1 = 0 ∧ M 1 1 = 1 := by
  constructor
  · intro h
    have h0 := congrFun h 0
    have h1 := congrFun h 1
    have h2 := congrFun h 2
    rw [mulVec_e1_apply] at h0 h1 h2
    simp [Pi.single_apply] at h0 h1 h2
    exact ⟨h0, h2, h1⟩
  · rintro ⟨h0, h2, h1⟩
    ext i
    fin_cases i <;> simp [mulVec_e1_apply, Pi.single_apply, h0, h1, h2]

private theorem mem_fstCoords_one {v : Fin 3 → ZMod 2} :
    v ∈ fstCoords 1 ↔ v 1 = 0 ∧ v 2 = 0 := by
  constructor
  · intro h
    exact ⟨h 1 (by norm_num), h 2 (by norm_num)⟩
  · rintro ⟨h1, h2⟩ j hj
    fin_cases j
    · simp at hj
    · exact h1
    · exact h2

private theorem mem_fstCoords_two {v : Fin 3 → ZMod 2} :
    v ∈ fstCoords 2 ↔ v 2 = 0 := by
  constructor
  · intro h
    exact h 2 (by norm_num)
  · intro h2 j hj
    fin_cases j
    · simp at hj
    · simp at hj
    · exact h2

private theorem e0_mem_fstCoords_one : (Pi.single 0 1 : Fin 3 → ZMod 2) ∈ fstCoords 1 :=
  mem_fstCoords_one.2 ⟨by simp [Pi.single_apply], by simp [Pi.single_apply]⟩

private theorem e0_mem_fstCoords_two : (Pi.single 0 1 : Fin 3 → ZMod 2) ∈ fstCoords 2 :=
  mem_fstCoords_two.2 (by simp [Pi.single_apply])

private theorem e1_mem_fstCoords_two : (Pi.single 1 1 : Fin 3 → ZMod 2) ∈ fstCoords 2 :=
  mem_fstCoords_two.2 (by simp [Pi.single_apply])

private theorem stab_fstCoords_one (M : Matrix (Fin 3) (Fin 3) (ZMod 2))
    (hM : Matrix.mulVec M (Pi.single 0 1) = Pi.single 0 1)
    (v : Fin 3 → ZMod 2) (hv : v ∈ fstCoords 1) :
    Matrix.mulVec M v ∈ fstCoords 1 := by
  obtain ⟨h1, h2⟩ := mem_fstCoords_one.1 hv
  have hv' : v = v 0 • (Pi.single 0 1 : Fin 3 → ZMod 2) := by
    funext j
    fin_cases j <;> simp [h1, h2]
  rw [hv', Matrix.mulVec_smul, hM]
  exact mem_fstCoords_one.2 ⟨by simp [Pi.single_apply], by simp [Pi.single_apply]⟩

private theorem stab_fstCoords_two (M : Matrix (Fin 3) (Fin 3) (ZMod 2))
    (hM : Matrix.vecMul (Pi.single 2 1) M = Pi.single 2 1)
    (v : Fin 3 → ZMod 2) (hv : v ∈ fstCoords 2) :
    Matrix.mulVec M v ∈ fstCoords 2 := by
  rw [mem_fstCoords_two] at hv ⊢
  have key : dotProduct (Pi.single 2 1 : Fin 3 → ZMod 2) (Matrix.mulVec M v) =
      dotProduct (Pi.single 2 1 : Fin 3 → ZMod 2) v := by
    rw [Matrix.dotProduct_mulVec, hM]
  simp [dotProduct, Fin.sum_univ_three, Pi.single_apply] at key
  rw [key, hv]

private theorem mem_parabSL_one (g : ↥SL32) :
    g ∈ parabSL 1 ↔ mat g 1 0 = 0 ∧ mat g 2 0 = 0 ∧ mat g 0 0 = 1 := by
  constructor
  · intro hg
    have h := Subgroup.mem_comap.1 hg (Pi.single 0 1) e0_mem_fstCoords_one
    have h1 : mat g 1 0 = 0 := by
      have := (mem_fstCoords_one.1 h.1).1
      rwa [mulVec_e0_apply] at this
    have h2 : mat g 2 0 = 0 := by
      have := (mem_fstCoords_one.1 h.1).2
      rwa [mulVec_e0_apply] at this
    have hc : mat g 0 0 = 1 := by
      rcases (show ∀ c : ZMod 2, c = 0 ∨ c = 1 from by decide) (mat g 0 0) with h0 | h0
      · exfalso
        apply det_mat_ne_zero g
        rw [Matrix.det_fin_three]
        simp [h0, h1, h2]
      · exact h0
    exact ⟨h1, h2, hc⟩
  · rintro ⟨h1, h2, hc⟩
    have hgE : Matrix.mulVec (mat g) (Pi.single 0 1) = Pi.single 0 1 :=
      (mulVec_e0_eq_iff (mat g)).2 ⟨h1, h2, hc⟩
    refine Subgroup.mem_comap.2 fun v hv => ⟨stab_fstCoords_one _ hgE v hv, ?_⟩
    refine stab_fstCoords_one _ ?_ v hv
    calc Matrix.mulVec (mat g⁻¹) (Pi.single 0 1)
        = Matrix.mulVec (mat g⁻¹) (Matrix.mulVec (mat g) (Pi.single 0 1)) := by rw [hgE]
      _ = Pi.single 0 1 := by
          rw [Matrix.mulVec_mulVec, mat_inv_mul, Matrix.one_mulVec]

private theorem mem_parabSL_two (g : ↥SL32) :
    g ∈ parabSL 2 ↔ mat g 2 0 = 0 ∧ mat g 2 1 = 0 ∧ mat g 2 2 = 1 := by
  constructor
  · intro hg
    have h := Subgroup.mem_comap.1 hg
    have h20 : mat g 2 0 = 0 := by
      have := mem_fstCoords_two.1 (h (Pi.single 0 1) e0_mem_fstCoords_two).1
      rwa [mulVec_e0_apply] at this
    have h21 : mat g 2 1 = 0 := by
      have := mem_fstCoords_two.1 (h (Pi.single 1 1) e1_mem_fstCoords_two).1
      rwa [mulVec_e1_apply] at this
    have h22 : mat g 2 2 = 1 := by
      rcases (show ∀ c : ZMod 2, c = 0 ∨ c = 1 from by decide) (mat g 2 2) with h0 | h0
      · exfalso
        apply det_mat_ne_zero g
        rw [Matrix.det_fin_three]
        simp [h0, h20, h21]
      · exact h0
    exact ⟨h20, h21, h22⟩
  · rintro ⟨h20, h21, h22⟩
    have hgE : Matrix.vecMul (Pi.single 2 1) (mat g) = Pi.single 2 1 :=
      (vecMul_e2_eq_iff (mat g)).2 ⟨h20, h21, h22⟩
    refine Subgroup.mem_comap.2 fun v hv => ⟨stab_fstCoords_two _ hgE v hv, ?_⟩
    refine stab_fstCoords_two _ ?_ v hv
    calc Matrix.vecMul (Pi.single 2 1) (mat g⁻¹)
        = Matrix.vecMul (Matrix.vecMul (Pi.single 2 1) (mat g)) (mat g⁻¹) := by rw [hgE]
      _ = Matrix.vecMul (Pi.single 2 1) (mat g * mat g⁻¹) := by rw [Matrix.vecMul_vecMul]
      _ = Pi.single 2 1 := by rw [mat_mul_inv, Matrix.vecMul_one]

private theorem mem_fixSL_two (g : ↥SL32) :
    g ∈ fixSL 2 ↔ ∃ x y : ZMod 2, mat g = axMat x y := by
  constructor
  · intro hg
    have h := Subgroup.mem_comap.1 hg
    have he0 : Matrix.mulVec (mat g) (Pi.single 0 1) = Pi.single 0 1 :=
      h _ e0_mem_fstCoords_two
    have he1 : Matrix.mulVec (mat g) (Pi.single 1 1) = Pi.single 1 1 :=
      h _ e1_mem_fstCoords_two
    obtain ⟨a10, a20, a00⟩ := (mulVec_e0_eq_iff (mat g)).1 he0
    obtain ⟨b01, b21, b11⟩ := (mulVec_e1_eq_iff (mat g)).1 he1
    have h22 : mat g 2 2 = 1 := by
      rcases (show ∀ c : ZMod 2, c = 0 ∨ c = 1 from by decide) (mat g 2 2) with h0 | h0
      · exfalso
        apply det_mat_ne_zero g
        rw [Matrix.det_fin_three]
        simp [h0, a10, a20, a00, b01, b21, b11]
      · exact h0
    refine ⟨mat g 0 2, mat g 1 2, ?_⟩
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [axMat, a10, a20, a00, b01, b21, b11, h22]
  · rintro ⟨x, y, hM⟩
    refine Subgroup.mem_comap.2 fun v hv => ?_
    have hv2 : v 2 = 0 := mem_fstCoords_two.1 hv
    have hM' : ((g : GL (Fin 3) (ZMod 2)) : Matrix (Fin 3) (Fin 3) (ZMod 2)) = axMat x y := hM
    show Matrix.mulVec ((g : GL (Fin 3) (ZMod 2)) : Matrix (Fin 3) (Fin 3) (ZMod 2)) v = v
    rw [hM']
    funext i
    fin_cases i <;> simp [axMat, Matrix.mulVec, dotProduct, Fin.sum_univ_three, hv2]

private theorem fixSL_two_eq : fixSL 2 = R1 := by
  ext g
  rw [mem_fixSL_two]
  exact Iff.rfl

private theorem flagSL_eq_U3 : flagSL = U3 := by
  ext g
  show (g ∈ parabSL 1 ∧ g ∈ parabSL 2) ↔ (g ∈ P1 ∧ g ∈ P2)
  rw [mem_parabSL_one, mem_parabSL_two]
  exact and_congr (mulVec_e0_iff (mat g)).symm (e2_vecMul_iff (mat g)).symm

private theorem Gw_eq_norm : Gw = norm := by
  refine le_antisymm ?_ ?_
  · unfold Gw Lw0
    exact sup_le img_le_norm (Subgroup.zpowers_le.mpr tau_mem_norm)
  · intro x hx
    obtain ⟨g, rfl | rfl⟩ := mem_norm_iff.1 hx
    · exact Subgroup.mem_sup_left ⟨g, rfl⟩
    · exact mul_mem (Subgroup.mem_sup_left ⟨g, rfl⟩)
        (Subgroup.mem_sup_right (Subgroup.mem_zpowers tau))

private theorem card_T0 : Nat.card T0 = 2 ^ 7 := by
  unfold T0
  rw [card_map_prod_sup_tau, card_U3]
  norm_num

private theorem T0_isSylowIn_norm : IsSylowIn 2 T0 norm := by
  have hXc : Nat.card norm = 2 ^ 7 * 441 := by rw [card_norm]; norm_num
  refine ⟨T0_le_norm, IsPGroup.of_card card_T0, fun h2 => ?_⟩
  have h1 := Subgroup.relIndex_mul_card (H := T0) (K := norm)
  rw [inf_eq_left.mpr T0_le_norm, card_T0, hXc] at h1
  norm_num at h1
  omega

private theorem not_mem_aSet_three_norm (A : Subgroup (MulAut WMod)) :
    A ∉ E3.aSet 3 norm := by
  intro hA
  have : Finite (MulAut WMod) := MulEquiv.finite_left
  have hAp : IsPGroup 2 A := E3.isPGroup_of_isElemAbelian2 hA.2.2.1
  obtain ⟨h, -, hle⟩ := E3.exists_le_conj_of_isSylowIn T0_isSylowIn_norm hA.1 hAp
  have hY : conjSubgroup A h⁻¹ ≤ T0 := by
    intro x hx
    have hx' : h⁻¹ * x * h⁻¹⁻¹ ∈ A := mem_conjSubgroup_iff.1 hx
    have hz : h * (h⁻¹ * x * h⁻¹⁻¹) * h⁻¹ ∈ T0 := mem_conjSubgroup_iff.1 (hle hx')
    have e : h * (h⁻¹ * x * h⁻¹⁻¹) * h⁻¹ = x := by group
    rwa [e] at hz
  have h3 := conjSubgroup_mem_aSet (Y := T0) h⁻¹ hA hY
  rw [aSet_three_T0_eq_empty] at h3
  simp at h3

private theorem aParam_norm : E3.aParam norm = 2 := by
  have : Finite (MulAut WMod) := MulEquiv.finite_left
  have hev : Even (Nat.card norm) := ⟨168 ^ 2, by rw [card_norm]; ring⟩
  have hA1 : A1 ∈ E3.aSet 2 norm :=
    A1_mem_aSet ((Subgroup.map_le_range _ _).trans img_le_norm)
  unfold E3.aParam
  split_ifs with h
  · apply le_antisymm
    · refine csSup_le ⟨2, by norm_num, ⟨A1, hA1⟩⟩ ?_
      rintro k ⟨hk, A, hAk⟩
      by_contra hlt
      have h3k : 3 ≤ k := by omega
      exact not_mem_aSet_three_norm A (E3.aSet_anti h3k norm hAk)
    · exact le_csSup (E3.aSet_bddAbove norm) ⟨by norm_num, ⟨A1, hA1⟩⟩
  · exact absurd hev h

theorem as_H_4_11 : H_4_11 := by
  unfold H_4_11
  have hTw : Tw = T0 := by
    unfold Tw T0
    rw [flagSL_eq_U3]
  have hRw : Rw = (R1.prod R1).map rho := by
    unfold Rw
    rw [fixSL_two_eq]
  refine ⟨?_, ?_⟩
  · rw [Gw_eq_norm]
    exact aParam_norm
  · rw [hTw, hRw]
    exact iSup_aSet_two_eq T0_le_norm (IsPGroup.of_card card_T0)
      (show (U3.prod U3).map rho ≤ T0 from le_sup_left)

section WrH48

private theorem h48_mem_Lw1 {x : MulAut WMod} : x ∈ Lw1 ↔ ∃ a : ↥SL32, x = rho (a, 1) := by
  constructor
  · intro hx
    obtain ⟨⟨a, b⟩, hg, rfl⟩ := Subgroup.mem_map.1 hx
    obtain ⟨-, hb⟩ := Subgroup.mem_prod.1 hg
    have hb' : b = 1 := Subgroup.mem_bot.1 hb
    exact ⟨a, by rw [hb']⟩
  · rintro ⟨a, rfl⟩
    exact Subgroup.mem_map.2
      ⟨(a, 1), Subgroup.mem_prod.2 ⟨Subgroup.mem_top _, Subgroup.one_mem _⟩, rfl⟩

private theorem h48_mem_Lw2 {x : MulAut WMod} : x ∈ Lw2 ↔ ∃ a : ↥SL32, x = rho (1, a) := by
  constructor
  · intro hx
    obtain ⟨⟨a, b⟩, hg, rfl⟩ := Subgroup.mem_map.1 hx
    obtain ⟨ha, -⟩ := Subgroup.mem_prod.1 hg
    have ha' : a = 1 := Subgroup.mem_bot.1 ha
    exact ⟨b, by rw [ha']⟩
  · rintro ⟨a, rfl⟩
    exact Subgroup.mem_map.2
      ⟨(1, a), Subgroup.mem_prod.2 ⟨Subgroup.one_mem _, Subgroup.mem_top _⟩, rfl⟩

private theorem h48_conjAut_Lw1 : conjAut tau Lw1 = Lw2 := by
  ext x
  constructor
  · intro hx
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.1 hx
    obtain ⟨a, rfl⟩ := h48_mem_Lw1.1 hy
    exact h48_mem_Lw2.2 ⟨a, tau_conj_rho (a, 1)⟩
  · intro hx
    obtain ⟨a, rfl⟩ := h48_mem_Lw2.1 hx
    exact Subgroup.mem_map.2 ⟨rho (a, 1), h48_mem_Lw1.2 ⟨a, rfl⟩, tau_conj_rho (a, 1)⟩

private noncomputable def h48TauPow (c : ZMod 2) : MulAut WMod := if c = 0 then 1 else tau

private theorem h48_zmod2 : ∀ c : ZMod 2, c = 0 ∨ c = 1 := by decide

private theorem h48TauPow_zero : h48TauPow 0 = 1 := if_pos rfl

private theorem h48TauPow_one : h48TauPow 1 = tau := if_neg (by decide)

private theorem h48_mul_cases (q : Multiplicative (ZMod 2)) :
    q = 1 ∨ q = Multiplicative.ofAdd 1 := by
  rcases h48_zmod2 (Multiplicative.toAdd q) with h | h
  · exact Or.inl (by rw [← ofAdd_toAdd q, h]; exact ofAdd_zero)
  · exact Or.inr (by rw [← ofAdd_toAdd q, h])

private theorem h48_ne_ofAdd_one : (Multiplicative.ofAdd (1 : ZMod 2)) ≠ 1 := by decide

private noncomputable def h48Val (x : ↥SL32 ≀ᵣ Multiplicative (ZMod 2)) : MulAut WMod :=
  rho (x.left 1, x.left (Multiplicative.ofAdd 1)) * h48TauPow (Multiplicative.toAdd x.right)

private theorem h48_rho_mul (a b c d : ↥SL32) :
    rho (a * c, b * d) = rho (a, b) * rho (c, d) :=
  map_mul rho (a, b) (c, d)

private theorem h48_tau_rho_swap (a b : ↥SL32) : tau * rho (a, b) = rho (b, a) * tau :=
  tau_mul_rho (a, b)

private theorem h48_mul_left (x y : ↥SL32 ≀ᵣ Multiplicative (ZMod 2))
    (z : Multiplicative (ZMod 2)) :
    (x * y).left z = x.left z * y.left (x.right⁻¹ * z) := rfl

private theorem h48_mul_right (x y : ↥SL32 ≀ᵣ Multiplicative (ZMod 2)) :
    (x * y).right = x.right * y.right := rfl

private theorem h48_tau_rho_tau (a b : ↥SL32) : tau * (rho (a, b) * tau) = rho (b, a) := by
  rw [← mul_assoc, h48_tau_rho_swap, mul_assoc, tau_mul_self, mul_one]

private theorem h48Val_one : h48Val 1 = 1 := by
  show rho (1, 1) * h48TauPow (Multiplicative.toAdd (1 : Multiplicative (ZMod 2))) = 1
  rw [toAdd_one, h48TauPow_zero, mul_one]
  exact map_one rho

private theorem h48Val_mul (x y : ↥SL32 ≀ᵣ Multiplicative (ZMod 2)) :
    h48Val (x * y) = h48Val x * h48Val y := by
  have hL1 : (x * y).left 1 = x.left 1 * y.left x.right⁻¹ := by
    rw [h48_mul_left, mul_one]
  have hLt : (x * y).left (Multiplicative.ofAdd 1) =
      x.left (Multiplicative.ofAdd 1) * y.left (x.right⁻¹ * Multiplicative.ofAdd 1) :=
    h48_mul_left _ _ _
  have ht : (Multiplicative.ofAdd (1 : ZMod 2))⁻¹ = Multiplicative.ofAdd 1 := by decide
  have ht1 : (1 : Multiplicative (ZMod 2))⁻¹ = 1 := by decide
  have ht2 : Multiplicative.ofAdd (1 : ZMod 2) * Multiplicative.ofAdd 1 = 1 := by decide
  unfold h48Val
  rw [hL1, hLt, h48_mul_right]
  rcases h48_mul_cases x.right with hx | hx <;> rcases h48_mul_cases y.right with hy | hy <;>
    rw [hx, hy]
  · simp [h48_rho_mul, h48TauPow_zero, ht1]
  · simp [h48_rho_mul, h48TauPow_zero, h48TauPow_one, ht1, mul_assoc]
  · simp [h48_rho_mul, h48_tau_rho_swap, h48TauPow_zero, h48TauPow_one, ht, ht1, ht2, mul_assoc]
  · simp [h48_rho_mul, h48_tau_rho_tau, h48TauPow_zero, h48TauPow_one, ht, ht1, ht2, mul_assoc,
      tau_mul_self]

private noncomputable def h48Hom : (↥SL32 ≀ᵣ Multiplicative (ZMod 2)) →* MulAut WMod where
  toFun := h48Val
  map_one' := h48Val_one
  map_mul' := h48Val_mul

private theorem h48_rho_mem_Gw (g : ↥SL32 × ↥SL32) : rho g ∈ Gw :=
  Subgroup.mem_sup_left ⟨g, rfl⟩

private theorem h48_tauPow_mem_Gw (c : ZMod 2) : h48TauPow c ∈ Gw := by
  unfold h48TauPow
  split_ifs
  · exact Gw.one_mem
  · exact Subgroup.mem_sup_right (Subgroup.mem_zpowers tau)

private theorem h48Val_mem_Gw (x : ↥SL32 ≀ᵣ Multiplicative (ZMod 2)) : h48Hom x ∈ Gw :=
  Gw.mul_mem (h48_rho_mem_Gw _) (h48_tauPow_mem_Gw _)

private noncomputable def h48HomGw : (↥SL32 ≀ᵣ Multiplicative (ZMod 2)) →* ↥Gw :=
  MonoidHom.codRestrict h48Hom Gw h48Val_mem_Gw

private theorem h48_left_ext {f g : Multiplicative (ZMod 2) → ↥SL32} (h1 : f 1 = g 1)
    (ht : f (Multiplicative.ofAdd 1) = g (Multiplicative.ofAdd 1)) : f = g :=
  funext fun z => by
    rcases h48_mul_cases z with rfl | rfl
    · exact h1
    · exact ht

private theorem h48_injective : Function.Injective h48HomGw := by
  intro x y hxy
  have h : h48Val x = h48Val y := congrArg Subtype.val hxy
  obtain ⟨f, q⟩ := x
  obtain ⟨g, r⟩ := y
  rcases h48_mul_cases q with rfl | rfl <;> rcases h48_mul_cases r with rfl | rfl
  · have h' : rho (f 1, f (Multiplicative.ofAdd 1)) = rho (g 1, g (Multiplicative.ofAdd 1)) := by
      simpa [h48Val, h48TauPow_zero] using h
    have hp := Prod.mk.inj (rho_injective h')
    rw [RegularWreathProduct.mk.injEq]
    exact ⟨h48_left_ext hp.1 hp.2, rfl⟩
  · exfalso
    have h' : rho (f 1, f (Multiplicative.ofAdd 1)) =
        rho (g 1, g (Multiplicative.ofAdd 1)) * tau := by
      simpa [h48Val, h48TauPow_zero, h48TauPow_one] using h
    apply tau_not_mem_img
    refine ⟨(g 1, g (Multiplicative.ofAdd 1))⁻¹ * (f 1, f (Multiplicative.ofAdd 1)), ?_⟩
    rw [map_mul, map_inv, h', inv_mul_cancel_left]
  · exfalso
    have h' : rho (f 1, f (Multiplicative.ofAdd 1)) * tau =
        rho (g 1, g (Multiplicative.ofAdd 1)) := by
      simpa [h48Val, h48TauPow_zero, h48TauPow_one] using h
    apply tau_not_mem_img
    refine ⟨(f 1, f (Multiplicative.ofAdd 1))⁻¹ * (g 1, g (Multiplicative.ofAdd 1)), ?_⟩
    rw [map_mul, map_inv, ← h', inv_mul_cancel_left]
  · have h2 : rho (f 1, f (Multiplicative.ofAdd 1)) * tau =
        rho (g 1, g (Multiplicative.ofAdd 1)) * tau := by
      simpa [h48Val, h48TauPow_one] using h
    have h' : rho (f 1, f (Multiplicative.ofAdd 1)) = rho (g 1, g (Multiplicative.ofAdd 1)) :=
      mul_right_cancel h2
    have hp := Prod.mk.inj (rho_injective h')
    rw [RegularWreathProduct.mk.injEq]
    exact ⟨h48_left_ext hp.1 hp.2, rfl⟩

private theorem h48_surjective : Function.Surjective h48HomGw := by
  rintro ⟨y, hy⟩
  have hyn : y ∈ (CFSG.Quasithin.H.L3Wr.norm : Subgroup (MulAut WMod)) := Gw_eq_norm ▸ hy
  obtain ⟨g, rfl | rfl⟩ := mem_norm_iff.1 hyn
  · refine ⟨⟨fun z => if z = 1 then g.1 else g.2, 1⟩, Subtype.ext ?_⟩
    show h48Val _ = rho g
    simp [h48Val, h48TauPow_zero, h48_ne_ofAdd_one]
  · refine ⟨⟨fun z => if z = 1 then g.1 else g.2, Multiplicative.ofAdd 1⟩, Subtype.ext ?_⟩
    show h48Val _ = rho g * tau
    simp [h48Val, h48TauPow_one, h48_ne_ofAdd_one]

private theorem h48_iso : Nonempty (↥Gw ≃* (↥SL32 ≀ᵣ Multiplicative (ZMod 2))) :=
  ⟨(MulEquiv.ofBijective h48HomGw ⟨h48_injective, h48_surjective⟩).symm⟩

private theorem h48_maximal {P N : Subgroup ↥SL32} (hP : Nat.card ↥P = 24) (hPN : P ≤ N) :
    N = P ∨ N = ⊤ := by
  haveI : Finite ↥SL32 := Nat.finite_of_card_ne_zero (by rw [card_SL32]; norm_num)
  have h1 : Nat.card ↥P ∣ Nat.card ↥N := Subgroup.card_dvd_of_le hPN
  have h2 : Nat.card ↥N ∣ 168 := by
    have := Subgroup.card_subgroup_dvd_card N
    rwa [card_SL32] at this
  rw [hP] at h1
  obtain ⟨k, hk⟩ := h1
  rw [hk] at h2
  have hk7 : k ∣ 7 :=
    Nat.dvd_of_mul_dvd_mul_left (by norm_num : 0 < 24) (show 24 * k ∣ 24 * 7 from h2)
  rcases (Nat.dvd_prime (by norm_num : Nat.Prime 7)).1 hk7 with rfl | rfl
  · left
    exact (Subgroup.eq_of_le_of_card_ge hPN (by omega)).symm
  · right
    exact Subgroup.eq_top_of_card_eq N (by rw [card_SL32]; omega)

private theorem h48_card_P2 : Nat.card ↥P2 = 24 := by
  have h : Nat.card ↥P2 =
      Nat.card {a : ↥SL32 // mat a 2 0 = 0 ∧ mat a 2 1 = 0 ∧ mat a 2 2 = 1} :=
    Nat.card_congr (Equiv.subtypeEquivRight fun a => e2_vecMul_iff (mat a))
  rw [h]
  exact (card_SL32_subtype (fun M => M 2 0 = 0 ∧ M 2 1 = 0 ∧ M 2 2 = 1)).trans (by decide)

private theorem h48_parabSL_one : parabSL 1 = P1 := by
  ext g
  rw [mem_parabSL_one]
  exact (mulVec_e0_iff (mat g)).symm

private theorem h48_parabSL_two : parabSL 2 = P2 := by
  ext g
  rw [mem_parabSL_two]
  exact (e2_vecMul_iff (mat g)).symm

private theorem h48_not_normal_P1 : ¬ P1.Normal := by
  intro hN
  have hX : slOfMat !![1, 0, 0; 0, 1, 1; 0, 0, 1] (by decide) ∈ P1 := by
    show Matrix.mulVec (mat (slOfMat !![1, 0, 0; 0, 1, 1; 0, 0, 1] (by decide))) e0 = e0
    decide
  have hGG : slOfMat !![1, 0, 0; 0, 1, 0; 1, 0, 1] (by decide) *
      slOfMat !![1, 0, 0; 0, 1, 0; 1, 0, 1] (by decide) = 1 :=
    Subtype.ext (Units.ext (by decide))
  have h := hN.conj_mem _ hX (slOfMat !![1, 0, 0; 0, 1, 0; 1, 0, 1] (by decide))
  rw [inv_eq_of_mul_eq_one_right hGG] at h
  have key : ¬ Matrix.mulVec (mat (slOfMat !![1, 0, 0; 0, 1, 0; 1, 0, 1] (by decide) *
      slOfMat !![1, 0, 0; 0, 1, 1; 0, 0, 1] (by decide) *
      slOfMat !![1, 0, 0; 0, 1, 0; 1, 0, 1] (by decide))) e0 = e0 := by
    decide
  exact key h

private theorem h48_not_normal_P2 : ¬ P2.Normal := by
  intro hN
  have hX : slOfMat !![1, 0, 1; 0, 1, 0; 0, 0, 1] (by decide) ∈ P2 := by
    show Matrix.vecMul e2 (mat (slOfMat !![1, 0, 1; 0, 1, 0; 0, 0, 1] (by decide))) = e2
    decide
  have hGG : slOfMat !![1, 0, 0; 0, 1, 0; 1, 0, 1] (by decide) *
      slOfMat !![1, 0, 0; 0, 1, 0; 1, 0, 1] (by decide) = 1 :=
    Subtype.ext (Units.ext (by decide))
  have h := hN.conj_mem _ hX (slOfMat !![1, 0, 0; 0, 1, 0; 1, 0, 1] (by decide))
  rw [inv_eq_of_mul_eq_one_right hGG] at h
  have key : ¬ Matrix.vecMul e2 (mat (slOfMat !![1, 0, 0; 0, 1, 0; 1, 0, 1] (by decide) *
      slOfMat !![1, 0, 1; 0, 1, 0; 0, 0, 1] (by decide) *
      slOfMat !![1, 0, 0; 0, 1, 0; 1, 0, 1] (by decide))) = e2 := by
    decide
  exact key h

private theorem h48_prod_eq_of_maximal {G : Type*} [Group G] (P : Subgroup G)
    (hmax : ∀ N : Subgroup G, P ≤ N → N = P ∨ N = ⊤) (hnn : ¬ P.Normal)
    (K : Subgroup (G × G)) (hK : P.prod P ≤ K) (hswap : ∀ g ∈ K, g.swap ∈ K) :
    K = P.prod P ∨ K = ⊤ := by
  set N₁ : Subgroup G := K.comap (MonoidHom.inl G G) with hN₁def
  have hN₁ : ∀ c : G, c ∈ N₁ ↔ ((c, 1) : G × G) ∈ K := fun c => Iff.rfl
  have hPN₁ : P ≤ N₁ := fun p hp =>
    (hN₁ p).2 (hK (Subgroup.mem_prod.2 ⟨hp, Subgroup.one_mem P⟩))
  by_cases htop : N₁ = ⊤
  · right
    refine eq_top_iff.2 fun g _ => ?_
    have h1 : ((g.1, 1) : G × G) ∈ K := (hN₁ g.1).1 (by rw [htop]; exact Subgroup.mem_top _)
    have h2 : ((g.2, 1) : G × G).swap ∈ K :=
      hswap _ ((hN₁ g.2).1 (by rw [htop]; exact Subgroup.mem_top _))
    have h3 := K.mul_mem h1 h2
    simpa using h3
  · left
    have hPN : N₁ = P := (hmax N₁ hPN₁).resolve_right htop
    have hcomm : ∀ g ∈ K, ∀ p ∈ P, p * g.1 * p⁻¹ * g.1⁻¹ ∈ P := by
      intro g hg p hp
      have hpK : ((p, 1) : G × G) ∈ K := hK (Subgroup.mem_prod.2 ⟨hp, Subgroup.one_mem P⟩)
      have h2 := K.mul_mem (K.mul_mem (K.mul_mem hpK hg) (K.inv_mem hpK)) (K.inv_mem hg)
      have e : ((p, 1) * g * (p, 1)⁻¹ * g⁻¹ : G × G) = (p * g.1 * p⁻¹ * g.1⁻¹, 1) := by
        ext <;> simp [mul_assoc]
      rw [e] at h2
      have h3 : p * g.1 * p⁻¹ * g.1⁻¹ ∈ N₁ := (hN₁ _).2 h2
      rwa [hPN] at h3
    have hcl : ∀ g ∈ K, ∀ h ∈ P, g.1 * h * g.1⁻¹ ∈ P := by
      intro g hg h hh
      have h3 := hcomm g hg h⁻¹ (P.inv_mem hh)
      have e : g.1 * h * g.1⁻¹ = h * (h⁻¹ * g.1 * h⁻¹⁻¹ * g.1⁻¹) := by group
      rw [e]
      exact P.mul_mem hh h3
    have hnorm1 : ∀ g ∈ K, g.1 ∈ Subgroup.normalizer (P : Set G) := by
      intro g hg
      rw [Subgroup.mem_normalizer_iff]
      intro h
      constructor
      · exact hcl g hg h
      · intro hh
        have h3 := hcl g⁻¹ (K.inv_mem hg) _ hh
        have e : (g⁻¹).1 * (g.1 * h * g.1⁻¹) * ((g⁻¹).1)⁻¹ = h := by
          simp only [Prod.fst_inv]
          group
        rw [e] at h3
        exact h3
    have hnorm : ∀ a ∈ Subgroup.normalizer (P : Set G), a ∈ P := by
      intro a ha
      rcases hmax _ Subgroup.le_normalizer with h | h
      · rw [h] at ha
        exact ha
      · exact absurd (Subgroup.normalizer_eq_top_iff.1 h) hnn
    refine le_antisymm ?_ hK
    intro g hg
    exact Subgroup.mem_prod.2 ⟨hnorm _ (hnorm1 g hg), hnorm _ (hnorm1 g.swap (hswap g hg))⟩

private theorem h48_wreath_max (P : Subgroup ↥SL32)
    (hmax : ∀ N : Subgroup ↥SL32, P ≤ N → N = P ∨ N = ⊤) (hnn : ¬ P.Normal)
    (hP : Nat.card ↥P = 24) :
    (P.prod P).map rho ⊔ Subgroup.zpowers tau ≤ Gw ∧
    (P.prod P).map rho ⊔ Subgroup.zpowers tau ≠ Gw ∧
    ∀ H : Subgroup (MulAut WMod), (P.prod P).map rho ⊔ Subgroup.zpowers tau ≤ H → H ≤ Gw →
      H = (P.prod P).map rho ⊔ Subgroup.zpowers tau ∨ H = Gw := by
  refine ⟨sup_le ((Subgroup.map_le_range _ _).trans le_sup_left) le_sup_right, ?_, ?_⟩
  · intro h
    have h1 := congrArg (fun H : Subgroup (MulAut WMod) => Nat.card ↥H) h
    rw [card_map_prod_sup_tau P, hP, Gw_eq_norm, card_norm] at h1
    norm_num at h1
  · intro H hGH hHGw
    have hτH : tau ∈ H := hGH (Subgroup.mem_sup_right (Subgroup.mem_zpowers tau))
    set K : Subgroup (↥SL32 × ↥SL32) := H.comap rho with hKdef
    have hK : P.prod P ≤ K := fun g hg =>
      hGH (Subgroup.mem_sup_left (Subgroup.mem_map.2 ⟨g, hg, rfl⟩))
    have hswap : ∀ g ∈ K, g.swap ∈ K := by
      intro g hg
      show rho g.swap ∈ H
      rw [← tau_conj_rho g]
      exact H.mul_mem (H.mul_mem hτH hg) (H.inv_mem hτH)
    rcases h48_prod_eq_of_maximal P hmax hnn K hK hswap with hKP | hKT
    · left
      refine le_antisymm ?_ hGH
      intro x hx
      have hxn : x ∈ (CFSG.Quasithin.H.L3Wr.norm : Subgroup (MulAut WMod)) := Gw_eq_norm ▸ hHGw hx
      obtain ⟨g, rfl | rfl⟩ := mem_norm_iff.1 hxn
      · have hg : g ∈ K := hx
        rw [hKP] at hg
        exact Subgroup.mem_sup_left (Subgroup.mem_map.2 ⟨g, hg, rfl⟩)
      · have hrg : rho g ∈ H := by simpa using H.mul_mem hx (H.inv_mem hτH)
        have hg : g ∈ K := hrg
        rw [hKP] at hg
        exact mul_mem (Subgroup.mem_sup_left (Subgroup.mem_map.2 ⟨g, hg, rfl⟩))
          (Subgroup.mem_sup_right (Subgroup.mem_zpowers tau))
    · right
      refine le_antisymm hHGw ?_
      refine sup_le ?_ (Subgroup.zpowers_le.2 hτH)
      rintro _ ⟨g, rfl⟩
      have hg : g ∈ K := by
        rw [hKT]
        exact Subgroup.mem_top g
      exact hg

private def h48Alt : Subgroup WMod where
  carrier := {X | (∀ i : Fin 3, Multiplicative.toAdd X i i = 0) ∧
    ∀ i j : Fin 3, Multiplicative.toAdd X i j = Multiplicative.toAdd X j i}
  mul_mem' := by
    rintro X Y ⟨hX1, hX2⟩ ⟨hY1, hY2⟩
    exact ⟨fun i => by simp [toAdd_mul, hX1 i, hY1 i],
      fun i j => by simp [toAdd_mul, hX2 i j, hY2 i j]⟩
  one_mem' := ⟨fun i => by simp, fun i j => by simp⟩
  inv_mem' := by
    rintro X ⟨hX1, hX2⟩
    exact ⟨fun i => by simp [toAdd_inv, hX1 i], fun i j => by simp [toAdd_inv, hX2 i j]⟩

private theorem h48_mem_Alt {X : WMod} : X ∈ h48Alt ↔
    (∀ i : Fin 3, Multiplicative.toAdd X i i = 0) ∧
      ∀ i j : Fin 3, Multiplicative.toAdd X i j = Multiplicative.toAdd X j i := Iff.rfl

private theorem h48_aux : ∀ a b : ZMod 2, a + -b = b + -a := by decide

private theorem h48_neg_self : ∀ a : ZMod 2, a + -a = 0 := by decide

private theorem h48_tau_mul_inv (v : WMod) : tau v * v⁻¹ ∈ h48Alt := by
  refine h48_mem_Alt.2 ⟨fun i => ?_, fun i j => ?_⟩
  · simp only [toAdd_mul, toAdd_inv, toAdd_tau, Matrix.add_apply, Matrix.neg_apply,
      Matrix.transpose_apply, Pi.add_apply, Pi.neg_apply]
    exact h48_neg_self _
  · simp only [toAdd_mul, toAdd_inv, toAdd_tau, Matrix.add_apply, Matrix.neg_apply,
      Matrix.transpose_apply]
    exact h48_aux _ _

private theorem h48_tau_mul_inv_xw (i j : Fin 3) : tau (xw i j) * (xw i j)⁻¹ = yw i j := by
  apply Multiplicative.toAdd.injective
  simp only [toAdd_mul, toAdd_inv, toAdd_tau, xw, yw, toAdd_ofAdd]
  ext a b
  fin_cases i <;> fin_cases j <;> fin_cases a <;> fin_cases b <;>
    simp [Matrix.single_apply] <;> decide

private theorem h48_yw01 : yw 0 1 ∈ h48Alt :=
  h48_mem_Alt.2 ⟨fun i => by fin_cases i <;> simp [yw, xw, Matrix.single_apply],
    fun i j => by fin_cases i <;> fin_cases j <;> simp [yw, xw, Matrix.single_apply]⟩

private theorem h48_yw02 : yw 0 2 ∈ h48Alt :=
  h48_mem_Alt.2 ⟨fun i => by fin_cases i <;> simp [yw, xw, Matrix.single_apply],
    fun i j => by fin_cases i <;> fin_cases j <;> simp [yw, xw, Matrix.single_apply]⟩

private theorem h48_yw12 : yw 1 2 ∈ h48Alt :=
  h48_mem_Alt.2 ⟨fun i => by fin_cases i <;> simp [yw, xw, Matrix.single_apply],
    fun i j => by fin_cases i <;> fin_cases j <;> simp [yw, xw, Matrix.single_apply]⟩

private theorem h48_alt_eq_prod (X : WMod) (hX : X ∈ h48Alt) :
    X = yw 0 1 ^ (Multiplicative.toAdd X 0 1).val * yw 0 2 ^ (Multiplicative.toAdd X 0 2).val *
      yw 1 2 ^ (Multiplicative.toAdd X 1 2).val := by
  obtain ⟨hd, hs⟩ := h48_mem_Alt.1 hX
  apply Multiplicative.toAdd.injective
  rw [toAdd_mul, toAdd_mul, toAdd_pow, toAdd_pow, toAdd_pow]
  ext i j
  have h10 := hs 1 0
  have h20 := hs 2 0
  have h21 := hs 2 1
  fin_cases i <;> fin_cases j <;>
    simp [yw, xw, ZMod.natCast_zmod_val, hd, h10, h20, h21]

private theorem h48_alt_le_closure : h48Alt ≤ Subgroup.closure {yw 0 1, yw 0 2, yw 1 2} := by
  intro X hX
  rw [h48_alt_eq_prod X hX]
  exact mul_mem (mul_mem (pow_mem (Subgroup.subset_closure (by simp)) _)
    (pow_mem (Subgroup.subset_closure (by simp)) _)) (pow_mem (Subgroup.subset_closure (by simp)) _)

private theorem h48_closure_le_alt : Subgroup.closure {yw 0 1, yw 0 2, yw 1 2} ≤ h48Alt := by
  rw [Subgroup.closure_le]
  intro y hy
  rcases hy with rfl | rfl | rfl
  · exact h48_yw01
  · exact h48_yw02
  · exact h48_yw12

private theorem h48_alt_eq_closure :
    h48Alt = Subgroup.closure {yw 0 1, yw 0 2, yw 1 2} :=
  le_antisymm h48_alt_le_closure h48_closure_le_alt

private theorem h48_zpow_tau_mem {x : MulAut WMod} (hx : x ∈ Subgroup.zpowers tau) :
    x = 1 ∨ x = tau := by
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hx
  obtain ⟨m, rfl | rfl⟩ := Int.even_or_odd' k
  · left
    rw [zpow_mul, zpow_two, tau_mul_self, one_zpow]
  · right
    rw [zpow_add_one, zpow_mul, zpow_two, tau_mul_self, one_zpow, one_mul]

private theorem h48_commV_tau : commV (Subgroup.zpowers tau) = h48Alt := by
  apply le_antisymm
  · unfold commV
    refine (Subgroup.closure_le _).2 ?_
    rintro w ⟨x, hx, v, rfl⟩
    rcases h48_zpow_tau_mem hx with rfl | rfl
    · have e : (1 : MulAut WMod) v * v⁻¹ = 1 := mul_inv_cancel v
      exact e ▸ h48Alt.one_mem
    · exact h48_tau_mul_inv v
  · unfold commV
    refine h48_alt_le_closure.trans ((Subgroup.closure_le _).2 ?_)
    intro y hy
    rcases hy with rfl | rfl | rfl
    · exact Subgroup.subset_closure ⟨tau, Subgroup.mem_zpowers tau, xw 0 1,
        h48_tau_mul_inv_xw 0 1⟩
    · exact Subgroup.subset_closure ⟨tau, Subgroup.mem_zpowers tau, xw 0 2,
        h48_tau_mul_inv_xw 0 2⟩
    · exact Subgroup.subset_closure ⟨tau, Subgroup.mem_zpowers tau, xw 1 2,
        h48_tau_mul_inv_xw 1 2⟩

private noncomputable def h48AltOf (c : Fin 3 → ZMod 2) : WMod :=
  Multiplicative.ofAdd !![0, c 0, c 1; c 0, 0, c 2; c 1, c 2, 0]

private theorem h48_altOf_mem (c : Fin 3 → ZMod 2) : h48AltOf c ∈ h48Alt := by
  refine h48_mem_Alt.2 ⟨fun i => ?_, fun i j => ?_⟩
  · fin_cases i <;> simp [h48AltOf]
  · fin_cases i <;> fin_cases j <;> simp [h48AltOf]

private theorem h48_card_alt : Nat.card ↥h48Alt = 8 := by
  have hf : Function.Bijective
      (fun c : Fin 3 → ZMod 2 => (⟨h48AltOf c, h48_altOf_mem c⟩ : ↥h48Alt)) := by
    constructor
    · intro c d hcd
      have h' : h48AltOf c = h48AltOf d := congrArg Subtype.val hcd
      have e01 := congrArg (fun X : WMod => Multiplicative.toAdd X 0 1) h'
      have e02 := congrArg (fun X : WMod => Multiplicative.toAdd X 0 2) h'
      have e12 := congrArg (fun X : WMod => Multiplicative.toAdd X 1 2) h'
      simp [h48AltOf] at e01 e02 e12
      funext k
      fin_cases k <;> simp [e01, e02, e12]
    · rintro ⟨X, hX⟩
      obtain ⟨hd, hs⟩ := h48_mem_Alt.1 hX
      refine ⟨![Multiplicative.toAdd X 0 1, Multiplicative.toAdd X 0 2,
        Multiplicative.toAdd X 1 2], ?_⟩
      apply Subtype.ext
      apply Multiplicative.toAdd.injective
      ext i j
      fin_cases i <;> fin_cases j <;> simp [h48AltOf, hd, hs 1 0, hs 2 0, hs 2 1]
  rw [← Nat.card_congr (Equiv.ofBijective _ hf)]
  simp [Nat.card_eq_fintype_card, Fintype.card_fun]

private theorem h48_rk_alt : rk ↥h48Alt = 3 := by
  unfold rk
  rw [h48_card_alt, show (8 : ℕ) = 2 ^ 3 by norm_num, padicValNat.prime_pow]

private theorem h48_diag_prod (D : Fin 3 → ZMod 2) :
    Multiplicative.ofAdd (Matrix.diagonal D) ∈ Subgroup.closure {xw 0 0, xw 1 1, xw 2 2} := by
  have e : Multiplicative.ofAdd (Matrix.diagonal D) =
      xw 0 0 ^ (D 0).val * xw 1 1 ^ (D 1).val * xw 2 2 ^ (D 2).val := by
    apply Multiplicative.toAdd.injective
    rw [toAdd_ofAdd, toAdd_mul, toAdd_mul, toAdd_pow, toAdd_pow, toAdd_pow]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [xw, Matrix.diagonal_apply, ZMod.natCast_zmod_val]
  rw [e]
  exact mul_mem (mul_mem (pow_mem (Subgroup.subset_closure (by simp)) _)
    (pow_mem (Subgroup.subset_closure (by simp)) _)) (pow_mem (Subgroup.subset_closure (by simp)) _)

private theorem h48_tau_xw_diag (i : Fin 3) : tau (xw i i) = xw i i := by
  apply Multiplicative.toAdd.injective
  show Matrix.transpose (Multiplicative.toAdd (xw i i)) = Multiplicative.toAdd (xw i i)
  ext a b
  fin_cases i <;> fin_cases a <;> fin_cases b <;> simp [xw, Matrix.single_apply]

private theorem h48_diag_le_fix : Subgroup.closure {xw 0 0, xw 1 1, xw 2 2} ≤
    fixV (Subgroup.zpowers tau) := by
  refine (Subgroup.closure_le _).2 ?_
  intro y hy
  refine mem_fixV_zpowers_iff_apply.2 ?_
  rcases hy with rfl | rfl | rfl
  · exact h48_tau_xw_diag 0
  · exact h48_tau_xw_diag 1
  · exact h48_tau_xw_diag 2

private theorem h48_alt_le_fix : h48Alt ≤ fixV (Subgroup.zpowers tau) := by
  intro X hX
  refine mem_fixV_zpowers_iff_apply.2 ?_
  obtain ⟨-, hs⟩ := h48_mem_Alt.1 hX
  apply Multiplicative.toAdd.injective
  show Matrix.transpose (Multiplicative.toAdd X) = Multiplicative.toAdd X
  ext i j
  rw [Matrix.transpose_apply]
  exact hs j i

private theorem h48_fixV_tau :
    fixV (Subgroup.zpowers tau) = h48Alt ⊔ Subgroup.closure {xw 0 0, xw 1 1, xw 2 2} := by
  refine le_antisymm ?_ (sup_le h48_alt_le_fix h48_diag_le_fix)
  intro X hX
  have hX' := mem_fixV_zpowers_iff_apply.1 hX
  have hs : ∀ i j : Fin 3, Multiplicative.toAdd X i j = Multiplicative.toAdd X j i := by
    intro i j
    have h : Matrix.transpose (Multiplicative.toAdd X) i j = Multiplicative.toAdd X i j :=
      congrArg (fun Y : WMod => Multiplicative.toAdd Y i j) hX'
    rw [Matrix.transpose_apply] at h
    exact h.symm
  set d : WMod := Multiplicative.ofAdd (Matrix.diagonal fun i => Multiplicative.toAdd X i i)
    with hd_def
  have hdmem : d ∈ Subgroup.closure {xw 0 0, xw 1 1, xw 2 2} := h48_diag_prod _
  have hcmem : X * d⁻¹ ∈ h48Alt := by
    refine h48_mem_Alt.2 ⟨fun i => ?_, fun i j => ?_⟩
    · simp [hd_def, toAdd_mul, toAdd_inv, h48_neg_self]
    · by_cases hij : i = j
      · subst hij
        rfl
      · simp [hd_def, toAdd_mul, toAdd_inv, Matrix.diagonal_apply_ne _ hij,
          Matrix.diagonal_apply_ne _ (Ne.symm hij), hs i j]
  exact Subgroup.mem_sup.2 ⟨X * d⁻¹, hcmem, d, hdmem, inv_mul_cancel_right _ _⟩

private def h48Diag : Subgroup WMod where
  carrier := {Y | ∀ i j : Fin 3, i ≠ j → Multiplicative.toAdd Y i j = 0}
  mul_mem' := by
    intro a b ha hb i j hij
    simp [toAdd_mul, ha i j hij, hb i j hij]
  one_mem' := by
    intro i j _
    simp
  inv_mem' := by
    intro a ha i j hij
    simp [toAdd_inv, ha i j hij]

private theorem h48_mem_Diag {Y : WMod} : Y ∈ h48Diag ↔
    ∀ i j : Fin 3, i ≠ j → Multiplicative.toAdd Y i j = 0 := Iff.rfl

private theorem h48_diag_le : Subgroup.closure {xw 0 0, xw 1 1, xw 2 2} ≤ h48Diag := by
  refine (Subgroup.closure_le _).2 ?_
  intro y hy
  rw [SetLike.mem_coe, h48_mem_Diag]
  rcases hy with rfl | rfl | rfl <;> intro i j hij <;> fin_cases i <;> fin_cases j <;>
    simp_all [xw, Matrix.single_apply]

private theorem h48_alt_inf_diag : h48Alt ⊓ Subgroup.closure {xw 0 0, xw 1 1, xw 2 2} = ⊥ := by
  rw [eq_bot_iff]
  rintro X ⟨hX, hD⟩
  obtain ⟨hd, -⟩ := h48_mem_Alt.1 hX
  have hoff := h48_diag_le hD
  rw [h48_mem_Diag] at hoff
  rw [Subgroup.mem_bot]
  apply Multiplicative.toAdd.injective
  rw [toAdd_one]
  ext i j
  by_cases hij : i = j
  · subst hij
    simp [hd i]
  · simp [hoff i j hij]

end WrH48

theorem as_H_4_8 : H_4_8 := by
  unfold H_4_8
  have hTw : Tw = T0 := by
    unfold Tw T0
    rw [flagSL_eq_U3]
  have hG1 : Gwm 1 = (P1.prod P1).map rho ⊔ Subgroup.zpowers tau := by
    unfold Gwm
    rw [h48_parabSL_one]
  have hG2 : Gwm 2 = (P2.prod P2).map rho ⊔ Subgroup.zpowers tau := by
    unfold Gwm
    rw [h48_parabSL_two]
  have hTle : ∀ m : ℕ, (m = 1 ∨ m = 2) → Tw ≤ Gwm m := by
    intro m hm
    have hf : flagSL ≤ parabSL m := by
      rcases hm with rfl | rfl
      · exact inf_le_left
      · exact inf_le_right
    unfold Tw Gwm
    exact sup_le_sup_right (Subgroup.map_mono (Subgroup.prod_mono hf hf)) _
  refine ⟨⟨h48_conjAut_Lw1, fun a => tau_conj_rho (a, 1)⟩, h48_iso, ?_, ?_, ?_⟩
  · intro m hm
    rcases hm with rfl | rfl
    · have key := h48_wreath_max P1 (fun N hN => h48_maximal card_P1 hN)
        h48_not_normal_P1 card_P1
      have hT := hTle 1 (Or.inl rfl)
      rw [hG1] at hT ⊢
      exact ⟨hT, key.1, key.2.1, key.2.2⟩
    · have key := h48_wreath_max P2 (fun N hN => h48_maximal h48_card_P2 hN)
        h48_not_normal_P2 h48_card_P2
      have hT := hTle 2 (Or.inr rfl)
      rw [hG2] at hT ⊢
      exact ⟨hT, key.1, key.2.1, key.2.2⟩
  · rw [hTw, Gw_eq_norm]
    exact T0_isSylowIn_norm
  · rw [h48_commV_tau]
    exact ⟨h48_alt_eq_closure, h48_rk_alt, h48_fixV_tau, h48_alt_inf_diag⟩

section WrH410

open CFSG.Quasithin.H.L3Wr
open scoped Matrix

private theorem h410_zmod2_add_self : ∀ x : ZMod 2, x + x = 0 := by decide

private theorem h410_sq (w : WMod) : w * w = 1 := by
  apply Multiplicative.toAdd.injective
  rw [toAdd_mul, toAdd_one]
  ext i j
  simp only [Matrix.add_apply, Matrix.zero_apply]
  exact h410_zmod2_add_self _

private theorem h410_inv (w : WMod) : w⁻¹ = w := inv_eq_of_mul_eq_one_right (h410_sq w)

private theorem h410_mat_t02 : mat t02 = t02m := rfl

private theorem h410_t02_sq : t02 * t02 = 1 :=
  eq_of_mat_eq (by rw [mat_mul, h410_mat_t02, mat_one]; decide)

private theorem h410_conj (b : ↥SL32) (hb : b * b = 1) (hb1 : b ≠ 1) :
    ∃ x : ↥SL32, x * t02 * x⁻¹ = b := by
  have hm : mat b * mat b = 1 := by rw [← mat_mul, hb, mat_one]
  obtain ⟨g, hg, hgb⟩ := exists_conj_t02m (mat b) hm (mat_ne_one hb1)
  exact ⟨slOfMat g hg, (eq_conj_of_mat hg det_t02m hgb).symm⟩

private theorem h410_rho_sq (a b : ↥SL32) (ha : a * a = 1) (hb : b * b = 1) :
    rho (a, b) * rho (a, b) = 1 := by
  rw [← map_mul, Prod.mk_mul_mk, ha, hb]
  exact map_one rho

private theorem h410_sq_pair {a b : ↥SL32} (h : rho (a, b) ^ 2 = 1) :
    a * a = 1 ∧ b * b = 1 := by
  have h' : rho ((a, b) * (a, b)) = rho 1 := by
    rw [map_mul, ← pow_two, h, map_one]
  have h'' := rho_injective h'
  exact ⟨congrArg Prod.fst h'', congrArg Prod.snd h''⟩

private theorem h410_rho_t1_sq : rho (t02, 1) * rho (t02, 1) = 1 :=
  h410_rho_sq t02 1 h410_t02_sq (mul_one 1)

private theorem h410_rho_tt_sq : rho (t02, t02) * rho (t02, t02) = 1 :=
  h410_rho_sq t02 t02 h410_t02_sq h410_t02_sq

private theorem h410_rho_t1_ne : rho (t02, 1) ≠ 1 := by
  intro h
  apply t02_ne_one
  exact congrArg Prod.fst (rho_injective (h.trans (map_one rho).symm))

private theorem h410_s2_eq :
    rho (t02, 1) * (tau * rho (t02, 1) * tau⁻¹) = rho (t02, t02) := by
  rw [tau_conj_rho, Prod.swap_prod_mk, ← map_mul, Prod.mk_mul_mk, mul_one, one_mul]

private theorem h410_zpowers_mem {s x : MulAut WMod} (hs : s * s = 1)
    (hx : x ∈ Subgroup.zpowers s) : x = 1 ∨ x = s := by
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hx
  obtain ⟨m, rfl | rfl⟩ := Int.even_or_odd' k
  · left
    rw [zpow_mul, zpow_two, hs, one_zpow]
  · right
    rw [zpow_add_one, zpow_mul, zpow_two, hs, one_zpow, one_mul]

private theorem h410_commV_zpowers {s : MulAut WMod} (hs : s * s = 1) :
    commV (Subgroup.zpowers s) = Subgroup.closure {w | ∃ v : WMod, s v * v⁻¹ = w} := by
  apply le_antisymm
  · unfold commV
    refine (Subgroup.closure_le _).2 ?_
    rintro w ⟨x, hx, v, rfl⟩
    rcases h410_zpowers_mem hs hx with rfl | rfl
    · have e : (1 : MulAut WMod) v * v⁻¹ = 1 := mul_inv_cancel v
      exact e ▸ Subgroup.one_mem _
    · exact Subgroup.subset_closure ⟨v, rfl⟩
  · unfold commV
    refine (Subgroup.closure_le _).2 ?_
    rintro w ⟨v, rfl⟩
    exact Subgroup.subset_closure ⟨s, Subgroup.mem_zpowers s, v, rfl⟩

private theorem h410_commV_le_fixV {s : MulAut WMod} (hs : s * s = 1) :
    commV (Subgroup.zpowers s) ≤ fixV (Subgroup.zpowers s) := by
  have hss : ∀ u : WMod, s (s u) = u := fun u => by
    have h : (s * s) u = u := by
      rw [hs]
      rfl
    exact h
  have hms : ∀ a b : WMod, s (a * b) = s a * s b := fun a b => map_mul s a b
  rw [h410_commV_zpowers hs]
  refine (Subgroup.closure_le _).2 ?_
  rintro w ⟨v, rfl⟩
  refine SetLike.mem_coe.2 (mem_fixV.2 ?_)
  intro y hy
  rcases h410_zpowers_mem hs hy with h | h
  · exact (congrArg (fun z : MulAut WMod => z (s v * v⁻¹)) h).trans rfl
  · rw [h]
    show s (s v * v⁻¹) = s v * v⁻¹
    rw [h410_inv v, hms, hss, mul_comm]

private theorem h410_toAdd_comm (a b : ↥SL32) (v : WMod) :
    Multiplicative.toAdd (rho (a, b) v * v⁻¹) =
      mat a * Multiplicative.toAdd v * (mat b)ᵀ - Multiplicative.toAdd v := by
  rw [toAdd_mul, toAdd_inv, sub_eq_add_neg]
  rfl

private theorem h410_row_comm (v : WMod) :
    Multiplicative.toAdd (rho (t02, 1) v * v⁻¹) =
      t02m * Multiplicative.toAdd v - Multiplicative.toAdd v := by
  rw [h410_toAdd_comm, h410_mat_t02, mat_one, Matrix.transpose_one, mul_one]

private theorem h410_tt_comm (v : WMod) :
    Multiplicative.toAdd (rho (t02, t02) v * v⁻¹) =
      t02m * Multiplicative.toAdd v * t02mᵀ - Multiplicative.toAdd v := by
  rw [h410_toAdd_comm, h410_mat_t02]

private theorem h410_toAdd_rho_tt (X : WMod) :
    Multiplicative.toAdd (rho (t02, t02) X) = t02m * Multiplicative.toAdd X * t02mᵀ :=
  rfl

private theorem h410_row_dec : ∀ X : Matrix (Fin 3) (Fin 3) (ZMod 2), ∀ j : Fin 3,
    (t02m * X - X) 1 j = 0 ∧ (t02m * X - X) 2 j = 0 := by
  decide +kernel

private theorem h410_row_gen : ∀ j : Fin 3,
    t02m * Matrix.single 2 j 1 - Matrix.single 2 j 1 = Matrix.single 0 j 1 := by
  decide +kernel

private theorem h410_tt_dec : ∀ X : Matrix (Fin 3) (Fin 3) (ZMod 2),
    (t02m * X * t02mᵀ - X) 1 1 = 0 ∧ (t02m * X * t02mᵀ - X) 1 2 = 0 ∧
      (t02m * X * t02mᵀ - X) 2 1 = 0 ∧ (t02m * X * t02mᵀ - X) 2 2 = 0 ∧
      (t02m * X * t02mᵀ - X) 0 2 = (t02m * X * t02mᵀ - X) 2 0 := by
  decide +kernel

private theorem h410_tt_gen_dec :
    (t02m * Matrix.single 2 0 1 * t02mᵀ - Matrix.single 2 0 1 = Matrix.single 0 0 1) ∧
    (t02m * Matrix.single 2 1 1 * t02mᵀ - Matrix.single 2 1 1 = Matrix.single 0 1 1) ∧
    (t02m * Matrix.single 1 2 1 * t02mᵀ - Matrix.single 1 2 1 = Matrix.single 1 0 1) ∧
    (t02m * (Matrix.single 2 0 1 + Matrix.single 2 2 1) * t02mᵀ -
        (Matrix.single 2 0 1 + Matrix.single 2 2 1) =
      Matrix.single 0 2 1 + Matrix.single 2 0 1) := by
  decide +kernel

private def h410Fix (X : Matrix (Fin 3) (Fin 3) (ZMod 2)) : Matrix (Fin 3) (Fin 3) (ZMod 2) :=
  X - Matrix.single 1 1 (X 1 1)

private theorem h410_fix_key : ∀ X : Matrix (Fin 3) (Fin 3) (ZMod 2),
    (X - Matrix.single 1 1 (X 1 1)) + (X 1 1).val • Matrix.single 1 1 (1 : ZMod 2) = X := by
  decide +kernel

private theorem h410_fix_dec : ∀ X : Matrix (Fin 3) (Fin 3) (ZMod 2),
    t02m * X * t02mᵀ = X →
      h410Fix X 1 2 = 0 ∧ h410Fix X 2 1 = 0 ∧ h410Fix X 2 2 = 0 ∧
      h410Fix X 0 2 = h410Fix X 2 0 := by
  decide +kernel

private theorem h410_fix_fst : ∀ v : Fin 3 → ZMod 2, t02m.mulVec v = v ↔ v 2 = 0 := by
  decide +kernel

private theorem h410_im_fst : ∀ v : Fin 3 → ZMod 2,
    (v 1 = 0 ∧ v 2 = 0) ↔ ∃ w : Fin 3 → ZMod 2, v = t02m.mulVec w - w := by
  decide +kernel

private theorem h410_row0_prod (M : Matrix (Fin 3) (Fin 3) (ZMod 2))
    (h : ∀ j : Fin 3, M 1 j = 0 ∧ M 2 j = 0) :
    Multiplicative.ofAdd M = xw 0 0 ^ (M 0 0).val * xw 0 1 ^ (M 0 1).val *
      xw 0 2 ^ (M 0 2).val := by
  have h1 : ∀ j : Fin 3, M 1 j = 0 := fun j => (h j).1
  have h2 : ∀ j : Fin 3, M 2 j = 0 := fun j => (h j).2
  apply Multiplicative.toAdd.injective
  simp only [toAdd_mul, toAdd_pow, toAdd_ofAdd, xw]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [h1, h2, Matrix.single_apply, ZMod.natCast_zmod_val]

private theorem h410_row_mem (M : Matrix (Fin 3) (Fin 3) (ZMod 2))
    (h : ∀ j : Fin 3, M 1 j = 0 ∧ M 2 j = 0) :
    Multiplicative.ofAdd M ∈ Subgroup.closure {xw 0 0, xw 0 1, xw 0 2} := by
  rw [h410_row0_prod M h]
  exact mul_mem (mul_mem (pow_mem (Subgroup.subset_closure (by simp)) _)
    (pow_mem (Subgroup.subset_closure (by simp)) _))
    (pow_mem (Subgroup.subset_closure (by simp)) _)

private theorem h410_hset_prod (M : Matrix (Fin 3) (Fin 3) (ZMod 2))
    (h : M 1 1 = 0 ∧ M 1 2 = 0 ∧ M 2 1 = 0 ∧ M 2 2 = 0 ∧ M 0 2 = M 2 0) :
    Multiplicative.ofAdd M = xw 0 0 ^ (M 0 0).val * xw 0 1 ^ (M 0 1).val *
      xw 1 0 ^ (M 1 0).val * yw 0 2 ^ (M 0 2).val := by
  obtain ⟨h11, h12, h21, h22, h02⟩ := h
  apply Multiplicative.toAdd.injective
  simp only [toAdd_mul, toAdd_pow, toAdd_ofAdd, xw, yw]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [h11, h12, h21, h22, h02, Matrix.single_apply, ZMod.natCast_zmod_val]

private theorem h410_hset_mem (M : Matrix (Fin 3) (Fin 3) (ZMod 2))
    (h : M 1 1 = 0 ∧ M 1 2 = 0 ∧ M 2 1 = 0 ∧ M 2 2 = 0 ∧ M 0 2 = M 2 0) :
    Multiplicative.ofAdd M ∈ Subgroup.closure {xw 0 0, xw 0 1, xw 1 0, yw 0 2} := by
  rw [h410_hset_prod M h]
  exact mul_mem (mul_mem (mul_mem (pow_mem (Subgroup.subset_closure (by simp)) _)
    (pow_mem (Subgroup.subset_closure (by simp)) _))
    (pow_mem (Subgroup.subset_closure (by simp)) _))
    (pow_mem (Subgroup.subset_closure (by simp)) _)

private theorem h410_commV_row :
    commV (Subgroup.zpowers (rho (t02, 1))) = Subgroup.closure {xw 0 0, xw 0 1, xw 0 2} := by
  rw [h410_commV_zpowers h410_rho_t1_sq]
  apply le_antisymm
  · refine (Subgroup.closure_le _).2 ?_
    rintro w ⟨v, rfl⟩
    have e : rho (t02, 1) v * v⁻¹ =
        Multiplicative.ofAdd (t02m * Multiplicative.toAdd v - Multiplicative.toAdd v) := by
      apply Multiplicative.toAdd.injective
      rw [h410_row_comm, toAdd_ofAdd]
    have hm := h410_row_mem _ (h410_row_dec (Multiplicative.toAdd v))
    rw [← e] at hm
    exact hm
  · refine (Subgroup.closure_le _).2 ?_
    intro w hw
    have gen : ∀ j : Fin 3, rho (t02, 1) (Multiplicative.ofAdd (Matrix.single 2 j 1)) *
        (Multiplicative.ofAdd (Matrix.single 2 j 1))⁻¹ = xw 0 j := by
      intro j
      apply Multiplicative.toAdd.injective
      rw [h410_row_comm, toAdd_ofAdd]
      simp only [xw, toAdd_ofAdd]
      exact h410_row_gen j
    rcases hw with rfl | rfl | rfl
    · exact Subgroup.subset_closure ⟨_, gen 0⟩
    · exact Subgroup.subset_closure ⟨_, gen 1⟩
    · exact Subgroup.subset_closure ⟨_, gen 2⟩

private theorem h410_commV_tt :
    commV (Subgroup.zpowers (rho (t02, t02))) =
      Subgroup.closure {xw 0 0, xw 0 1, xw 1 0, yw 0 2} := by
  rw [h410_commV_zpowers h410_rho_tt_sq]
  apply le_antisymm
  · refine (Subgroup.closure_le _).2 ?_
    rintro w ⟨v, rfl⟩
    have e : rho (t02, t02) v * v⁻¹ = Multiplicative.ofAdd
        (t02m * Multiplicative.toAdd v * t02mᵀ - Multiplicative.toAdd v) := by
      apply Multiplicative.toAdd.injective
      rw [h410_tt_comm, toAdd_ofAdd]
    have hm := h410_hset_mem _ (h410_tt_dec (Multiplicative.toAdd v))
    rw [← e] at hm
    exact hm
  · refine (Subgroup.closure_le _).2 ?_
    intro w hw
    have g0 : rho (t02, t02) (Multiplicative.ofAdd (Matrix.single 2 0 1)) *
        (Multiplicative.ofAdd (Matrix.single 2 0 1))⁻¹ = xw 0 0 := by
      apply Multiplicative.toAdd.injective
      rw [h410_tt_comm, toAdd_ofAdd]
      simp only [xw, toAdd_ofAdd]
      exact h410_tt_gen_dec.1
    have g1 : rho (t02, t02) (Multiplicative.ofAdd (Matrix.single 2 1 1)) *
        (Multiplicative.ofAdd (Matrix.single 2 1 1))⁻¹ = xw 0 1 := by
      apply Multiplicative.toAdd.injective
      rw [h410_tt_comm, toAdd_ofAdd]
      simp only [xw, toAdd_ofAdd]
      exact h410_tt_gen_dec.2.1
    have g2 : rho (t02, t02) (Multiplicative.ofAdd (Matrix.single 1 2 1)) *
        (Multiplicative.ofAdd (Matrix.single 1 2 1))⁻¹ = xw 1 0 := by
      apply Multiplicative.toAdd.injective
      rw [h410_tt_comm, toAdd_ofAdd]
      simp only [xw, toAdd_ofAdd]
      exact h410_tt_gen_dec.2.2.1
    have g3 : rho (t02, t02) (xw 2 0 * xw 2 2) * (xw 2 0 * xw 2 2)⁻¹ = yw 0 2 := by
      apply Multiplicative.toAdd.injective
      rw [h410_tt_comm]
      simp only [xw, yw, toAdd_mul, toAdd_ofAdd]
      exact h410_tt_gen_dec.2.2.2
    rcases hw with rfl | rfl | rfl | rfl
    · exact Subgroup.subset_closure ⟨_, g0⟩
    · exact Subgroup.subset_closure ⟨_, g1⟩
    · exact Subgroup.subset_closure ⟨_, g2⟩
    · exact Subgroup.subset_closure ⟨_, g3⟩

private theorem h410_fixV_tt :
    fixV (Subgroup.zpowers (rho (t02, t02))) =
      commV (Subgroup.zpowers (rho (t02, t02))) ⊔ Subgroup.zpowers (xw 1 1) := by
  apply le_antisymm
  · intro X hX
    have hX0 : rho (t02, t02) X = X := mem_fixV_zpowers_iff_apply.1 hX
    have hX' : t02m * Multiplicative.toAdd X * t02mᵀ = Multiplicative.toAdd X :=
      congrArg Multiplicative.toAdd hX0
    obtain ⟨h1, h2, h3, h4⟩ := h410_fix_dec _ hX'
    have hmem := h410_hset_mem (Multiplicative.toAdd X -
        Matrix.single 1 1 ((Multiplicative.toAdd X) 1 1)) ⟨by simp, h1, h2, h3, h4⟩
    rw [← h410_commV_tt] at hmem
    refine Subgroup.mem_sup.2 ⟨Multiplicative.ofAdd (Multiplicative.toAdd X -
        Matrix.single 1 1 ((Multiplicative.toAdd X) 1 1)), hmem,
      xw 1 1 ^ ((Multiplicative.toAdd X) 1 1).val, pow_mem (Subgroup.mem_zpowers _) _, ?_⟩
    apply Multiplicative.toAdd.injective
    rw [toAdd_mul, toAdd_pow, toAdd_ofAdd]
    simp only [xw, toAdd_ofAdd]
    exact h410_fix_key _
  · refine sup_le (h410_commV_le_fixV h410_rho_tt_sq) (Subgroup.zpowers_le.2 ?_)
    have h11 : rho (t02, t02) (xw 1 1) = xw 1 1 := by
      apply Multiplicative.toAdd.injective
      rw [h410_toAdd_rho_tt]
      simp only [xw, toAdd_ofAdd]
      decide
    exact mem_fixV_zpowers_iff_apply.2 h11

private theorem h410_tau_comm_rho (g : ↥SL32) : tau * rho (g, g) = rho (g, g) * tau := by
  have h := tau_conj_rho (g, g)
  rw [mul_inv_eq_iff_eq_mul] at h
  exact h

private theorem h410_tau_conj (g : ↥SL32 × ↥SL32) : tau * (rho g * tau) = rho g.swap := by
  rw [← mul_assoc, tau_mul_rho, mul_assoc, tau_mul_self, mul_one]

private theorem h410_decomp {A : Subgroup (MulAut WMod)} (hAG : A ≤ Gw)
    (hcomm : ∀ a ∈ A, ∀ b ∈ A, a * b = b * a) (htA : tau ∈ A) :
    ∀ a ∈ A, ∃ c : ↥SL32, rho (c, c) ∈ A ∧ (a = rho (c, c) ∨ a = rho (c, c) * tau) := by
  intro a ha
  have hn : a ∈ norm := by rw [← Gw_eq_norm]; exact hAG ha
  obtain ⟨g, hg | hg⟩ := mem_norm_iff.1 hn
  · have hc := hcomm a ha tau htA
    rw [hg, tau_mul_rho] at hc
    have hgg : g.1 = g.2 := congrArg Prod.fst (rho_injective (mul_right_cancel hc))
    have e : ((g.1, g.1) : ↥SL32 × ↥SL32) = g := Prod.ext rfl hgg
    have hA' : rho (g.1, g.1) = a := by rw [e, hg]
    exact ⟨g.1, by rw [hA']; exact ha, Or.inl hA'.symm⟩
  · have hc := hcomm a ha tau htA
    rw [hg, mul_assoc, tau_mul_self, mul_one, h410_tau_conj] at hc
    have hgg : g.1 = g.2 := congrArg Prod.fst (rho_injective hc)
    have e : ((g.1, g.1) : ↥SL32 × ↥SL32) = g := Prod.ext rfl hgg
    have hA' : rho (g.1, g.1) = a * tau := by
      rw [e, hg, mul_assoc, tau_mul_self, mul_one]
    refine ⟨g.1, by rw [hA']; exact A.mul_mem ha htA, Or.inr ?_⟩
    rw [hA', mul_assoc, tau_mul_self, mul_one]

private theorem h410_conj_L1 (u : MulAut WMod) (hu : u ∈ Lw1 ∨ u ∈ Lw2)
    (hord : orderOf u = 2) : IsConjIn Gw (rho (t02, 1)) u := by
  have hu2 : u ^ 2 = 1 := by
    have := pow_orderOf_eq_one u
    rwa [hord] at this
  have hu1 : u ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hord
    norm_num at hord
  rcases hu with hu | hu
  · obtain ⟨b, rfl⟩ := h48_mem_Lw1.1 hu
    obtain ⟨hb2, -⟩ := h410_sq_pair hu2
    have hb1 : b ≠ 1 := fun h => hu1 (by rw [h]; exact map_one rho)
    obtain ⟨x, hx⟩ := h410_conj b hb2 hb1
    refine ⟨rho (x, 1), Subgroup.mem_sup_left ⟨(x, 1), rfl⟩, ?_⟩
    rw [← rho_conj, hx, inv_one, mul_one, mul_one]
  · obtain ⟨b, rfl⟩ := h48_mem_Lw2.1 hu
    obtain ⟨-, hb2⟩ := h410_sq_pair hu2
    have hb1 : b ≠ 1 := fun h => hu1 (by rw [h]; exact map_one rho)
    obtain ⟨x, hx⟩ := h410_conj b hb2 hb1
    refine ⟨tau * rho (x, 1), Gw.mul_mem (Subgroup.mem_sup_right (Subgroup.mem_zpowers tau))
      (Subgroup.mem_sup_left ⟨(x, 1), rfl⟩), ?_⟩
    have e : tau * rho (x, 1) * rho (t02, 1) * (tau * rho (x, 1))⁻¹ =
        tau * (rho (x, 1) * rho (t02, 1) * (rho (x, 1))⁻¹) * tau⁻¹ := by group
    rw [e, ← rho_conj, hx, inv_one, mul_one, mul_one, tau_conj_rho, Prod.swap_prod_mk]

private theorem h410_conj_L0 (u : MulAut WMod) (hu : u ∈ Lw0) (hnL1 : u ∉ Lw1)
    (hnL2 : u ∉ Lw2) (hord : orderOf u = 2) : IsConjIn Gw (rho (t02, t02)) u := by
  obtain ⟨⟨b, c⟩, rfl⟩ := MonoidHom.mem_range.1 hu
  have hc1 : c ≠ 1 := fun h => hnL1 (h48_mem_Lw1.2 ⟨b, by rw [h]⟩)
  have hb1 : b ≠ 1 := fun h => hnL2 (h48_mem_Lw2.2 ⟨c, by rw [h]⟩)
  have hsq : rho (b, c) ^ 2 = 1 := by
    have := pow_orderOf_eq_one (rho (b, c))
    rwa [hord] at this
  obtain ⟨hb2, hc2⟩ := h410_sq_pair hsq
  obtain ⟨x, hx⟩ := h410_conj b hb2 hb1
  obtain ⟨y, hy⟩ := h410_conj c hc2 hc1
  refine ⟨rho (x, y), Subgroup.mem_sup_left ⟨(x, y), rfl⟩, ?_⟩
  rw [← rho_conj, hx, hy]

private theorem h410_conj_tau (u : MulAut WMod) (hu : u ∈ Gw) (hnL : u ∉ Lw0)
    (hord : orderOf u = 2) : IsConjIn Gw tau u := by
  have hn : u ∈ norm := by rw [← Gw_eq_norm]; exact hu
  obtain ⟨g, hg | hg⟩ := mem_norm_iff.1 hn
  · exact absurd (MonoidHom.mem_range.2 ⟨g, hg.symm⟩) hnL
  · have hu2 : (rho g * tau) ^ 2 = 1 := by
      have := pow_orderOf_eq_one u
      rwa [hord, hg] at this
    have hgg : rho (g * g.swap) = 1 := by
      rw [map_mul]
      have e : rho g * tau * (rho g * tau) = rho g * rho g.swap := by
        calc rho g * tau * (rho g * tau) = rho g * (tau * rho g) * tau := by
              simp only [mul_assoc]
          _ = rho g * (rho g.swap * tau) * tau := by rw [tau_mul_rho]
          _ = rho g * rho g.swap := by simp only [mul_assoc, tau_mul_self, mul_one]
      rw [← e, ← pow_two]
      exact hu2
    have hg12 : g.1 * g.2 = 1 :=
      congrArg Prod.fst (rho_injective (hgg.trans (map_one rho).symm))
    have hg2 : g.2 = g.1⁻¹ := eq_inv_of_mul_eq_one_right hg12
    have e2 : (g.1, 1) * (1, g.1⁻¹) = g := Prod.ext (by simp) (by simp [hg2])
    have hinv : (rho (g.1, 1))⁻¹ = rho (g.1⁻¹, 1) := by
      rw [← map_inv]
      congr 1
      all_goals exact Prod.ext (by simp) (by simp)
    refine ⟨rho (g.1, 1), Subgroup.mem_sup_left ⟨(g.1, 1), rfl⟩, ?_⟩
    rw [hg, hinv, mul_assoc, tau_mul_rho, Prod.swap_prod_mk, ← mul_assoc, ← map_mul, e2]

private noncomputable def h410Diag : ↥SL32 →* MulAut WMod :=
  rho.comp ((MonoidHom.id ↥SL32).prod (MonoidHom.id ↥SL32))

private theorem h410Diag_injective : Function.Injective h410Diag := fun x y h => by
  have h' : rho (x, x) = rho (y, y) := h
  exact congrArg Prod.fst (rho_injective h')

private theorem h410_diag_tau_ne (c d : ↥SL32) : rho (c, c) * tau ≠ rho (d, d) := by
  intro h
  apply tau_not_mem_img
  refine MonoidHom.mem_range.2 ⟨(c⁻¹ * d, c⁻¹ * d), ?_⟩
  have e : rho (c⁻¹ * d, c⁻¹ * d) = (rho (c, c))⁻¹ * rho (d, d) := by
    rw [← map_inv, ← map_mul]
    rfl
  rw [e, ← h, inv_mul_cancel_left]

private theorem h410_card_eq_filter (K : Subgroup WMod)
    (P : Matrix (Fin 3) (Fin 3) (ZMod 2) → Prop) [DecidablePred P]
    (hK : ∀ M, Multiplicative.ofAdd M ∈ K ↔ P M) :
    Nat.card ↥K = (Finset.univ.filter P).card := by
  have e : ↥K ≃ {M : Matrix (Fin 3) (Fin 3) (ZMod 2) // P M} :=
    { toFun := fun w => ⟨Multiplicative.toAdd (w : WMod),
        (hK _).1 (by rw [ofAdd_toAdd]; exact w.2)⟩
      invFun := fun M => ⟨Multiplicative.ofAdd M.1, (hK _).2 M.2⟩
      left_inv := fun w => Subtype.ext (ofAdd_toAdd _)
      right_inv := fun M => Subtype.ext (toAdd_ofAdd _) }
  rw [Nat.card_congr e, Nat.card_eq_fintype_card, Fintype.card_subtype]

private theorem h410_toAdd_tau (X : WMod) :
    Multiplicative.toAdd (tau X) = (Multiplicative.toAdd X)ᵀ := rfl

private theorem h410_card_tau : Nat.card ↥(fixV (Subgroup.zpowers tau)) ≤ 64 := by
  have hK : ∀ M : Matrix (Fin 3) (Fin 3) (ZMod 2),
      Multiplicative.ofAdd M ∈ fixV (Subgroup.zpowers tau) ↔ M.transpose = M := by
    intro M
    constructor
    · intro h
      have h0 : tau (Multiplicative.ofAdd M) = Multiplicative.ofAdd M :=
        mem_fixV_zpowers_iff_apply.1 h
      have h' := congrArg Multiplicative.toAdd h0
      rw [h410_toAdd_tau, toAdd_ofAdd] at h'
      exact h'
    · intro h
      have h0 : tau (Multiplicative.ofAdd M) = Multiplicative.ofAdd M := by
        apply Multiplicative.toAdd.injective
        rw [h410_toAdd_tau, toAdd_ofAdd]
        exact h
      exact mem_fixV_zpowers_iff_apply.2 h0
  refine (le_of_eq (h410_card_eq_filter _ _ hK)).trans ?_
  decide +kernel

private theorem h410_card_Kt : Nat.card ↥(fixV (Subgroup.zpowers tau) ⊓
    fixV (Subgroup.zpowers (rho (t02, t02)))) ≤ 16 := by
  have hK : ∀ M : Matrix (Fin 3) (Fin 3) (ZMod 2), Multiplicative.ofAdd M ∈
      fixV (Subgroup.zpowers tau) ⊓ fixV (Subgroup.zpowers (rho (t02, t02))) ↔
        M.transpose = M ∧ t02m * M * t02mᵀ = M := by
    intro M
    constructor
    · intro h
      obtain ⟨h1, h2⟩ := Subgroup.mem_inf.1 h
      have h1x : tau (Multiplicative.ofAdd M) = Multiplicative.ofAdd M :=
        mem_fixV_zpowers_iff_apply.1 h1
      have h2x : rho (t02, t02) (Multiplicative.ofAdd M) = Multiplicative.ofAdd M :=
        mem_fixV_zpowers_iff_apply.1 h2
      have h1' := congrArg Multiplicative.toAdd h1x
      have h2' := congrArg Multiplicative.toAdd h2x
      rw [h410_toAdd_tau, toAdd_ofAdd] at h1'
      rw [h410_toAdd_rho_tt, toAdd_ofAdd] at h2'
      exact ⟨h1', h2'⟩
    · rintro ⟨h1, h2⟩
      have h1x : tau (Multiplicative.ofAdd M) = Multiplicative.ofAdd M := by
        apply Multiplicative.toAdd.injective
        rw [h410_toAdd_tau, toAdd_ofAdd]
        exact h1
      have h2x : rho (t02, t02) (Multiplicative.ofAdd M) = Multiplicative.ofAdd M := by
        apply Multiplicative.toAdd.injective
        rw [h410_toAdd_rho_tt, toAdd_ofAdd]
        exact h2
      exact Subgroup.mem_inf.2 ⟨mem_fixV_zpowers_iff_apply.2 h1x,
        mem_fixV_zpowers_iff_apply.2 h2x⟩
  refine (le_of_eq (h410_card_eq_filter _ _ hK)).trans ?_
  decide +kernel

private theorem h410_sym_card {c : ↥SL32} (hc : c * c = 1) (hc1 : c ≠ 1) :
    Nat.card ↥(fixV (Subgroup.zpowers tau) ⊓ fixV (Subgroup.zpowers (rho (c, c)))) ≤ 16 := by
  obtain ⟨x, hx⟩ := h410_conj c hc hc1
  have hc' : rho (x, x) * rho (t02, t02) * (rho (x, x))⁻¹ = rho (c, c) := by
    rw [← rho_conj, hx]
  have hinv : rho (x⁻¹, x⁻¹) = (rho (x, x))⁻¹ := (map_inv rho (x, x)).symm
  have hle : (fixV (Subgroup.zpowers tau) ⊓ fixV (Subgroup.zpowers (rho (c, c)))).map
      (rho (x⁻¹, x⁻¹)).toMonoidHom ≤
        fixV (Subgroup.zpowers tau) ⊓ fixV (Subgroup.zpowers (rho (t02, t02))) := by
    rintro _ ⟨X, hX, rfl⟩
    obtain ⟨hX1, hX2⟩ := Subgroup.mem_inf.1 hX
    have hX1' : tau X = X := mem_fixV_zpowers_iff_apply.1 hX1
    have hX2' : rho (c, c) X = X := mem_fixV_zpowers_iff_apply.1 hX2
    show rho (x⁻¹, x⁻¹) X ∈ fixV (Subgroup.zpowers tau) ⊓
      fixV (Subgroup.zpowers (rho (t02, t02)))
    refine Subgroup.mem_inf.2 ⟨mem_fixV_zpowers_iff_apply.2 ?_, mem_fixV_zpowers_iff_apply.2 ?_⟩
    · have hcomm := congrArg (fun φ : MulAut WMod => φ X) (h410_tau_comm_rho x⁻¹)
      simp only [MulAut.mul_apply] at hcomm
      exact hcomm.trans (congrArg (fun Y => rho (x⁻¹, x⁻¹) Y) hX1')
    · rw [hinv]
      have h1 : rho (x, x) (rho (t02, t02) ((rho (x, x))⁻¹ X)) = X := by
        have h := congrArg (fun φ : MulAut WMod => φ X) hc'
        simp only [MulAut.mul_apply] at h
        rw [h, hX2']
      have h3 := MulAut.inv_apply_self WMod (rho (x, x)) (rho (t02, t02) ((rho (x, x))⁻¹ X))
      exact h3.symm.trans (congrArg (fun Y => (rho (x, x))⁻¹ Y) h1)
  calc Nat.card ↥(fixV (Subgroup.zpowers tau) ⊓ fixV (Subgroup.zpowers (rho (c, c))))
      = Nat.card ↥((fixV (Subgroup.zpowers tau) ⊓ fixV (Subgroup.zpowers (rho (c, c)))).map
          (rho (x⁻¹, x⁻¹)).toMonoidHom) :=
        (Subgroup.card_map_of_injective (rho (x⁻¹, x⁻¹)).injective).symm
    _ ≤ Nat.card ↥(fixV (Subgroup.zpowers tau) ⊓
          fixV (Subgroup.zpowers (rho (t02, t02)))) := Subgroup.card_le_of_le hle
    _ ≤ 16 := h410_card_Kt

private theorem h410_padic (n j : ℕ) (hn : 0 < n) (h : n ≤ 2 ^ j) : padicValNat 2 n ≤ j := by
  have hd : 2 ^ padicValNat 2 n ∣ n := pow_padicValNat_dvd
  have hle : 2 ^ padicValNat 2 n ≤ 2 ^ j := (Nat.le_of_dvd hn hd).trans h
  exact (Nat.pow_le_pow_iff_right (by norm_num)).1 hle

private theorem h410_rk_le (G : Type*) [Group G] [Finite G] (j : ℕ)
    (h : Nat.card G ≤ 2 ^ j) : rk G ≤ j := by
  unfold rk
  exact h410_padic _ j Nat.card_pos h

private theorem h410_card_WMod : Nat.card WMod = 2 ^ 9 := by
  rw [Nat.card_congr Multiplicative.toAdd, Matrix.card_matrix]
  simp [Nat.card_eq_fintype_card, ZMod.card]

private theorem h410_rk_V : rk WMod = 9 := by
  unfold rk
  rw [h410_card_WMod, padicValNat.prime_pow]

private theorem h410_centr_dec : (Finset.univ.filter fun M : Matrix (Fin 3) (Fin 3) (ZMod 2) =>
    t02m * M = M * t02m ∧ M.det = 1).card ≤ 8 := by
  decide +kernel

private def h410G1 : Matrix (Fin 3) (Fin 3) (ZMod 2) := !![1, 1, 0; 0, 1, 0; 0, 0, 1]

private def h410G2 : Matrix (Fin 3) (Fin 3) (ZMod 2) := !![1, 0, 0; 0, 1, 1; 0, 0, 1]

private theorem h410_det_G1 : h410G1.det ≠ 0 := by decide

private theorem h410_det_G2 : h410G2.det ≠ 0 := by decide

private theorem h410_E4 (B : Subgroup ↥SL32) (hB : ∀ x ∈ B, ∀ y ∈ B, x * y = y * x)
    (hsq : ∀ x ∈ B, x * x = 1) : Nat.card B ≤ 4 := by
  by_contra hlt
  push_neg at hlt
  have hp : IsPGroup 2 B := fun g => ⟨1, by
    rw [show (2 : ℕ) ^ 1 = 2 from rfl, pow_two]
    exact Subtype.ext (by simpa using hsq g g.2)⟩
  obtain ⟨k, hk⟩ := hp.exists_card_eq
  have h8 : Nat.card B ≤ 8 := card_le_eight hp
  have hB8 : Nat.card B = 8 := by
    rw [hk] at hlt h8 ⊢
    have hk4 : k < 4 := by
      by_contra h
      push_neg at h
      have h16 : (16 : ℕ) ≤ 2 ^ k := by
        calc (16 : ℕ) = 2 ^ 4 := by norm_num
          _ ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) h
      omega
    interval_cases k <;> simp_all
  obtain ⟨b, hbB, hb1⟩ : ∃ b ∈ B, b ≠ 1 := by
    by_contra h
    push_neg at h
    have hbot : B = ⊥ := eq_bot_iff.2 fun x hx => Subgroup.mem_bot.2 (h x hx)
    rw [hbot, Subgroup.card_bot] at hB8
    norm_num at hB8
  obtain ⟨x, hx⟩ := h410_conj b (hsq b hbB) hb1
  have hB'card : Nat.card ↥(B.map (MulAut.conj x⁻¹).toMonoidHom) = 8 := by
    rw [Subgroup.card_map_of_injective (MulAut.conj x⁻¹).injective, hB8]
  have hB'comm : ∀ u ∈ B.map (MulAut.conj x⁻¹).toMonoidHom,
      ∀ v ∈ B.map (MulAut.conj x⁻¹).toMonoidHom, u * v = v * u := by
    rintro _ ⟨y, hy, rfl⟩ _ ⟨z, hz, rfl⟩
    rw [← map_mul, ← map_mul, hB y hy z hz]
  have ht02 : t02 ∈ B.map (MulAut.conj x⁻¹).toMonoidHom := by
    refine Subgroup.mem_map.2 ⟨b, hbB, ?_⟩
    show MulAut.conj x⁻¹ b = t02
    rw [MulAut.conj_apply, ← hx]
    group
  have hCkey : ∀ a : ↥SL32, a ∈ Subgroup.centralizer ({t02} : Set ↥SL32) ↔
      t02m * mat a = mat a * t02m := by
    intro a
    rw [Subgroup.mem_centralizer_iff]
    constructor
    · intro h
      have h' := congrArg mat (h t02 (Set.mem_singleton _))
      rwa [mat_mul, mat_mul, h410_mat_t02] at h'
    · intro h t ht
      rw [Set.mem_singleton_iff] at ht
      subst ht
      apply eq_of_mat_eq
      rw [mat_mul, mat_mul, h410_mat_t02]
      exact h
  have hCcard : Nat.card ↥(Subgroup.centralizer ({t02} : Set ↥SL32)) ≤ 8 := by
    rw [Nat.card_congr (Equiv.subtypeEquivRight hCkey)]
    exact (card_SL32_subtype (fun M => t02m * M = M * t02m)).le.trans h410_centr_dec
  have hle : B.map (MulAut.conj x⁻¹).toMonoidHom ≤ Subgroup.centralizer ({t02} : Set ↥SL32) := by
    intro u hu
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    rw [Set.mem_singleton_iff] at hh
    subst hh
    exact hB'comm _ ht02 _ hu
  have hBC : B.map (MulAut.conj x⁻¹).toMonoidHom = Subgroup.centralizer ({t02} : Set ↥SL32) :=
    Subgroup.eq_of_le_of_card_ge hle (by rw [hB'card]; exact hCcard)
  have hg1 : slOfMat h410G1 h410_det_G1 ∈ B.map (MulAut.conj x⁻¹).toMonoidHom := by
    rw [hBC]
    exact (hCkey _).2 (by rw [mat_slOfMat]; decide)
  have hg2 : slOfMat h410G2 h410_det_G2 ∈ B.map (MulAut.conj x⁻¹).toMonoidHom := by
    rw [hBC]
    exact (hCkey _).2 (by rw [mat_slOfMat]; decide)
  have hcomm := hB'comm _ hg1 _ hg2
  have hm := congrArg mat hcomm
  rw [mat_mul, mat_mul, mat_slOfMat, mat_slOfMat] at hm
  exact absurd hm (by decide)

private theorem h410_card_A_le {A : Subgroup (MulAut WMod)} (hAG : A ≤ Gw)
    (hAel : IsElemAbelian2 A) (htA : tau ∈ A) : Nat.card ↥A ≤ 8 := by
  haveI : Finite (MulAut WMod) := MulEquiv.finite_left
  have hdec := h410_decomp hAG hAel.1 htA
  have hBcomm : ∀ x ∈ A.comap h410Diag, ∀ y ∈ A.comap h410Diag, x * y = y * x := by
    intro x hx y hy
    apply h410Diag_injective
    rw [map_mul, map_mul]
    exact hAel.1 _ hx _ hy
  have hBsq : ∀ x ∈ A.comap h410Diag, x * x = 1 := by
    intro x hx
    apply h410Diag_injective
    rw [map_mul, map_one]
    exact (pow_two (h410Diag x)).symm.trans (hAel.2 _ hx)
  have hE := h410_E4 (A.comap h410Diag) hBcomm hBsq
  have hH'A : (A.comap h410Diag).map h410Diag ≤ A := by
    rintro _ ⟨c, hc, rfl⟩
    exact hc
  have hnotH : ∀ c : ↥SL32, rho (c, c) * tau ∉ (A.comap h410Diag).map h410Diag := by
    intro c hmem
    obtain ⟨d, -, hd⟩ := Subgroup.mem_map.1 hmem
    exact h410_diag_tau_ne c d hd.symm
  have hrel : ((A.comap h410Diag).map h410Diag).relIndex A = 2 := by
    rw [Subgroup.relIndex_eq_two_iff]
    refine ⟨tau, htA, fun b hb => ?_⟩
    obtain ⟨c, hcA, hbc | hbc⟩ := hdec b hb
    · have hbH : b ∈ (A.comap h410Diag).map h410Diag :=
        Subgroup.mem_map.2 ⟨c, hcA, hbc.symm⟩
      have hbτ : ¬ (b * tau ∈ (A.comap h410Diag).map h410Diag) := by
        rw [hbc]
        exact hnotH c
      exact Or.inr ⟨hbH, hbτ⟩
    · have hbτH : b * tau ∈ (A.comap h410Diag).map h410Diag := by
        rw [hbc, mul_assoc, tau_mul_self, mul_one]
        exact Subgroup.mem_map.2 ⟨c, hcA, rfl⟩
      have hbnot : ¬ (b ∈ (A.comap h410Diag).map h410Diag) := by
        rw [hbc]
        exact hnotH c
      exact Or.inl ⟨hbτH, hbnot⟩
  have hcard := Subgroup.relIndex_mul_card (H := (A.comap h410Diag).map h410Diag) (K := A)
  rw [inf_eq_left.2 hH'A, hrel, Subgroup.card_map_of_injective h410Diag_injective] at hcard
  omega

private theorem h410_sum_le {A : Subgroup (MulAut WMod)} (hAG : A ≤ Gw)
    (hAel : IsElemAbelian2 A) (htA : tau ∈ A) : rk ↥A + rk ↥(fixV A) ≤ 7 := by
  haveI : Finite (MulAut WMod) := MulEquiv.finite_left
  by_cases hex : ∃ c : ↥SL32, c ≠ 1 ∧ rho (c, c) ∈ A
  · obtain ⟨c, hc1, hcA⟩ := hex
    have hc : c * c = 1 := (h410_sq_pair (hAel.2 _ hcA)).1
    have hf : Nat.card ↥(fixV A) ≤ 16 := by
      have h1 : fixV A ≤ fixV (Subgroup.zpowers tau) ⊓ fixV (Subgroup.zpowers (rho (c, c))) :=
