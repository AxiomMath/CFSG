        _ = t * (t * sig covData.tab xt v) * sig covData.tab xt v := by rw [htc (sig covData.tab xt v)]
        _ = (t * t) * (sig covData.tab xt v * sig covData.tab xt v) := by group
        _ = y := by rw [hc.mul_self_t, one_mul, hsq]
  have hconj : ∀ u : L, u * u = 1 → X.φ u ≠ 1 → ∃ c : L, u = c * y * c⁻¹ ∨ u = c * (y * t) * c⁻¹ := by
    intro u hu2 hu1
