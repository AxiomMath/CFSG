open CFSG.ComponentClassification.GrSLit.L34Facts CFSG.ComponentClassification.PSL3Four
  CFSG.PSL3Four CFSG.PSL3Four.Native CFSG.LieType.Multipliers.L34 in
theorem burnsideI22P3_beta
    {K : Type} [Group K] [Finite K]
    {q : K →* Equiv.Perm (Fin 42)} {l : Cover →* K} (hQ : IsQSetting q l)
    (hk2 : ∀ e ∈ q.ker, e * e = 1) :
    ∃ β : K ≃* K, (∀ x, q (β x) = r₄ * q x * r₄⁻¹) ∧ ∀ z ∈ q.ker, β z = z := by
  obtain ⟨α, hα1, hα2, hασ⟩ := burnsideI22P3_alpha
  have hcen : ∀ z ∈ q.ker, ∀ g : K, g * z = z * g := fun z hz g =>
    Subgroup.mem_center_iff.1 (hQ.ker_le hz) g
  have hlz₁ : l z₁ ∈ q.ker := hQ.l_mem_ker (MonoidHom.mem_ker.mpr sigma_z₁)
  have hlz₂ : l z₂ ∈ q.ker := hQ.l_mem_ker (MonoidHom.mem_ker.mpr sigma_z₂)
  have hw : l (α z₃) = 1 := by
    refine hQ.three _ ?_ ?_
    · rw [MonoidHom.mem_ker, hQ.q_l, hασ, sigma_z₃, mul_one, mul_inv_cancel]
    · rw [← map_pow, ← map_pow, z₃_pow, map_one, map_one]
  have hinvc : ∀ c ∈ sigma.ker, l (α c) = (l c)⁻¹ := by
    intro c hc
    rw [← range_zHom] at hc
    obtain ⟨d, rfl⟩ := hc
    rw [zHom_apply]
    simp only [map_mul, map_pow, hα1, hα2, map_inv, hw, hQ.lz₃, one_pow, mul_one]
    calc (l z₁)⁻¹ ^ d.1.toAdd.val * (l z₂)⁻¹ ^ d.2.1.toAdd.val
        = ((l z₂) ^ d.2.1.toAdd.val * (l z₁) ^ d.1.toAdd.val)⁻¹ := by
          rw [mul_inv_rev, inv_pow, inv_pow]
      _ = ((l z₁) ^ d.1.toAdd.val * (l z₂) ^ d.2.1.toAdd.val)⁻¹ := by
          rw [← hcen _ (pow_mem hlz₂ _) ((l z₁) ^ d.1.toAdd.val)]
  have hker : l.ker ≤ (l.comp α).ker := by
    intro c hc
    have hc' : c ∈ sigma.ker := by
      rw [MonoidHom.mem_ker, ← hQ.q_l c]
      have : l c = 1 := hc
      rw [this, map_one]
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, hinvc c hc']
    have : l c = 1 := hc
    rw [this, inv_one]
  set β₀ : K →* K :=
    (l.liftOfRightInverse (Function.surjInv hQ.lsurj) (Function.rightInverse_surjInv hQ.lsurj))
      ⟨l.comp α, hker⟩ with hβ₀
  have hβl : ∀ c, β₀ (l c) = l (α c) := fun c =>
    l.liftOfRightInverse_comp_apply (Function.surjInv hQ.lsurj)
      (Function.rightInverse_surjInv hQ.lsurj) ⟨l.comp α, hker⟩ c
  have hqβ : ∀ x, q (β₀ x) = r₄ * q x * r₄⁻¹ := by
    intro x
    obtain ⟨c, rfl⟩ := hQ.lsurj x
    rw [hβl, hQ.q_l, hQ.q_l, hασ]
  have hβker : ∀ z ∈ q.ker, β₀ z = z := by
    intro z hz
    obtain ⟨i, j, rfl⟩ := (mem_ker_iff hQ.ql hQ.lsurj hQ.three).1 hz
    have hc : z₁ ^ i * z₂ ^ j ∈ sigma.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_pow, map_pow, sigma_z₁, sigma_z₂]
      simp
    have h1 : l z₁ ^ i * l z₂ ^ j = l (z₁ ^ i * z₂ ^ j) := by
      rw [map_mul, map_pow, map_pow]
    rw [h1, hβl, hinvc _ hc]
    have h2 := hk2 (l (z₁ ^ i * z₂ ^ j)) (hQ.l_mem_ker hc)
    exact inv_eq_of_mul_eq_one_right h2
  have hinj : Function.Injective β₀ := by
    rw [← MonoidHom.ker_eq_bot_iff]
    refine (Subgroup.eq_bot_iff_forall _).2 fun x hx => ?_
    have hx1 : β₀ x = 1 := hx
    have h1 : q x = 1 := by
      have := hqβ x
      rw [hx1, map_one] at this
      calc q x = r₄⁻¹ * (r₄ * q x * r₄⁻¹) * r₄ := by group
        _ = 1 := by rw [← this]; group
    have hxk : x ∈ q.ker := h1
    rw [hβker x hxk] at hx1
    exact hx1
  refine ⟨MulEquiv.ofBijective β₀ (Finite.injective_iff_bijective.1 hinj), hqβ, hβker⟩

