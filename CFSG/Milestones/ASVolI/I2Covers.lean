theorem burnsideI22P3_conj_T0
    {s : Equiv.Perm (Fin 42)} (hsS : s ∈ S) (hs2 : s * s = 1) (hs1 : s ≠ 1) :
    ∃ g ∈ S, g⁻¹ * s * g ∈ T0 := by
