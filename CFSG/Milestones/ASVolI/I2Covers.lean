      burnsideI22P3_Pres q ∧ IsQSetting q l ∧
      (∀ x, q x ∈ T0 ↔ x ∈ (Pk : Subgroup K)) ∧ burnsideI22P3_Datum P U V ∧
      preimageStar K Ps = Subgroup.comap q P ∧
      pCoreOf 2 (preimageStar K Ps) = Subgroup.comap q U ∧
      ((∃ z ∈ q.ker, z * z ≠ 1) → ∃ a b : K, q a ∈ U ∧ q b ∈ U ∧ a * b ≠ b * a) ∧
      ((∀ e ∈ q.ker, e * e = 1) →
        ((∀ x ∈ Subgroup.comap q U, ∀ y ∈ Subgroup.comap q U, x * y = y * x) ∧
          ∀ x ∈ Subgroup.comap q U, x * x = 1) ∧
        ((∀ x ∈ Subgroup.comap q V, ∀ y ∈ Subgroup.comap q V, x * y = y * x) ∧
