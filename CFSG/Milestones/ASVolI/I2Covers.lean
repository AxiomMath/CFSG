  ·
    have hR := burnsideI22P3_pCoreOf_le hPkH Pk.isPGroup' Pk.not_dvd_index
    intro r hr
    have hN : (pCoreOf 2 (Subgroup.comap q P)).map q ≤ U := by
      refine hD.O2 _ ?_ ?_
      · rintro _ ⟨r', hr', rfl⟩
        exact (hPk r').2 (hR hr')
      · rintro g hg _ ⟨r', hr', rfl⟩
        obtain ⟨c, hc⟩ := hq.surj g (hD.PS hg)
        have hcH : c ∈ Subgroup.comap q P := by
          rw [Subgroup.mem_comap, hc]
          exact hg
