  refine ⟨X.φ, y, S0, i22hP, i22el i22aVert, {g | ∃ v ∈ aV, i22el v = g}, Ns, ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, hconj⟩
  · exact (hcenter t).2 (Or.inr rfl)
  · exact hc.mul_self_t
  · exact hc.t_ne_one
  · exact fun x hx => (hcenter x).1 hx
  · exact hker
  · exact hy2
  · exact fun g hg => hrange g (hS0le g hg)
  · exact (CayTab.card_sub hT).trans hnV
  · rintro s ⟨v, hv, rfl⟩
    rw [hφy]
    exact (hzcomm v hv).symm
  · exact hSy
  · have hzM : i22zP ∈ NativeSporadic.M22 :=
      hS0le _ (Subgroup.mul_mem _ ⟨79, h79, rfl⟩ ⟨79, h79, rfl⟩)
    have hzord : orderOf i22zP = 2 := orderOf_eq_prime (by rw [sq]; exact hzsq) hzne
    have := card_centralizer_involution_perm i22zP hzM hzord
    rw [hrangeφ, hφy]
    exact this
  · exact hrange _ (wordP_mem _)
  · rw [hφy]; exact facts.h_comm
  · exact facts.h_cube
  · exact facts.h_ne
  · rintro g ⟨v, hv, rfl⟩
    rw [hφy]
    exact facts.aV_root v hv
  · rintro g ⟨v, hv, rfl⟩ p hp
    exact hAl v hv p hp
  · exact fun g hg => hg.1.1
  · intro s hs n hn
    obtain ⟨v, hv, rfl⟩ := (hS0mem s).1 hs
    rw [hmemNs] at hn ⊢
    have := hNsWord (covData.tab.word v) n hn
    exact this
  · intro n hn
    rw [hmemNs] at hn ⊢
    obtain ⟨h1, h2, h3⟩ := hn
    refine ⟨h3, ?_, ?_⟩
    · have : i22hP⁻¹ * (i22hP * n * i22hP⁻¹) * i22hP = n := by group
      rw [this]; exact h1
    · have : i22hP * (i22hP * n * i22hP⁻¹) * i22hP⁻¹ = i22hP⁻¹ * n * i22hP := by
        calc i22hP * (i22hP * n * i22hP⁻¹) * i22hP⁻¹ = (i22hP * i22hP) * n * (i22hP⁻¹ * i22hP⁻¹) := by group
          _ = i22hP⁻¹ * n * i22hP := by rw [hcubeinv, hcubeinv2]
      rw [this]; exact h2
  · exact (hmemNs _).2 facts.a_core
  · obtain ⟨w, hw, hwe⟩ := facts.a_comm
    exact ⟨w, hw, hwe.symm⟩
  · intro g hg hgz hgh
    obtain ⟨v, hv, rfl⟩ := (hS0mem g).1 hg
    rw [hφy] at hgz
    have hvr : v ∈ rootsV := (twRoots_sound hx h79 hroots v hv).1 hgz
    exact ⟨v, facts.uniq v hvr hgh, rfl⟩

open CFSG.ASVolI.ChIJK CFSG.EvenSporadicStandard.M22Std in
theorem burnsideI22P46_part_6_b
    {K : Type} [Group K] [Finite K] (hK : CFSG.IsQuasisimple K)
