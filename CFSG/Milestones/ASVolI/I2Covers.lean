open CFSG.ComponentClassification.GrSLit.L34Facts CFSG.ComponentClassification.PSL3Four
  CFSG.PSL3Four in
theorem burnsideI22P3_qsetting
    {K : Type} [Group K]
    {q : K →* Equiv.Perm (Fin 42)} (hq : burnsideI22P3_Pres q) (hperf : commutator K = ⊤)
    (hZ2 : IsPGroup 2 (Subgroup.center K)) :
    ∃ l : CFSG.LieType.Multipliers.L34.Cover →* K, IsQSetting q l := by
  obtain ⟨l, hl, hls⟩ := exists_lam hperf q hq.mem hq.surj (hq.ker ▸ le_refl _)
  refine ⟨l, hq.mem, hq.surj, hq.ker, fun e he h3 => ?_, hl, hls⟩
  rw [hq.ker] at he
  obtain ⟨k, hk⟩ := hZ2 ⟨e, he⟩
  have hk' : e ^ 2 ^ k = 1 := by
    have := congrArg Subtype.val hk
    simpa using this
  have hd : orderOf e ∣ 3 := orderOf_dvd_of_pow_eq_one h3
  have hd2 : orderOf e ∣ 2 ^ k := orderOf_dvd_of_pow_eq_one hk'
  have : orderOf e ∣ Nat.gcd 3 (2 ^ k) := Nat.dvd_gcd hd hd2
  have hcop : Nat.gcd 3 (2 ^ k) = 1 := by
    apply Nat.Coprime.pow_right
    norm_num
  rw [hcop] at this
  exact orderOf_eq_one_iff.1 (Nat.dvd_one.1 this)

open CFSG.ComponentClassification.GrSLit.L34Facts CFSG.ComponentClassification.PSL3Four
  CFSG.PSL3Four in
theorem burnsideI22P3_std
    {K : Type} [Group K] [Finite K] {q : K →* Equiv.Perm (Fin 42)}
    (hq : burnsideI22P3_Pres q) (hZ2 : IsPGroup 2 (Subgroup.center K)) (P : Sylow 2 K) :
    ∃ g ∈ S, ∀ x : K, g * q x * g⁻¹ ∈ T0 ↔ x ∈ (P : Subgroup K) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set φ : K →* ↥S := q.codRestrict S hq.mem with hφ
  have hφs : Function.Surjective φ := fun s => by
    obtain ⟨x, hx⟩ := hq.surj s s.2
    exact ⟨x, Subtype.ext hx⟩
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq S sylowT0 (P.mapSurjective hφs)
  have hZP : Subgroup.center K ≤ (P : Subgroup K) := hZ2.le_sylow_of_normal P
  refine ⟨(g : Equiv.Perm (Fin 42))⁻¹, S.inv_mem g.2, fun x => ?_⟩
  have key : ∀ y : ↥S, y ∈ ((g • sylowT0 : Sylow 2 S) : Subgroup S) ↔
      (g : Equiv.Perm (Fin 42))⁻¹ * y * g ∈ T0 := mem_smul_sylowT0_iff g
  have hxS : q x ∈ S := hq.mem x
  have h1 := key ⟨q x, hxS⟩
  rw [hg, Sylow.coe_mapSurjective] at h1
  simp only [inv_inv]
  constructor
  · intro hT
    obtain ⟨p, hpP, hp⟩ := h1.2 hT
    have hqp : q p = q x := congrArg Subtype.val hp
    have hker : p⁻¹ * x ∈ q.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hqp, inv_mul_cancel]
    rw [hq.ker] at hker
    have hx : x = p * (p⁻¹ * x) := by group
    rw [hx]
    exact (P : Subgroup K).mul_mem hpP (hZP hker)
  · intro hxP
    exact h1.1 ⟨x, hxP, Subtype.ext rfl⟩

theorem burnsideI22P3_frattini_center_iff {K : Type} [Group K] [Finite K]
    (hZ2 : IsPGroup 2 (Subgroup.center K)) :
    frattini ↥(Subgroup.center K) = ⊥ ↔ ∀ z ∈ Subgroup.center K, z * z = 1 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Fact (IsPGroup 2 ↥(Subgroup.center K)) := ⟨hZ2⟩
  rw [CFSG.frattini_eq_bot_iff_isElementaryAbelian (p := 2)]
  constructor
  · intro h z hz
    have h1 := Monoid.exponent_dvd_iff_forall_pow_eq_one.1
      (CFSG.IsElementaryAbelian.exponent_dvd_p 2 ↥(Subgroup.center K)) ⟨z, hz⟩
    have h2 := congrArg Subtype.val h1
    simpa [pow_two] using h2
  · intro h
    refine { toIsMulCommutative := inferInstance, exponent_dvd_p := ?_ }
    refine Monoid.exponent_dvd_iff_forall_pow_eq_one.2 fun z => ?_
    exact Subtype.ext (by simpa [pow_two] using h z.1 z.2)

open CFSG.ComponentClassification.GrSLit.L34Facts CFSG.ComponentClassification.PSL3Four
  CFSG.PSL3Four in
theorem burnsideI22P3_clause_a1
    {K : Type} [Group K] [Finite K] (hK : CFSG.IsQuasisimple K)
    (hmodel : StatedClassicalModel (K ⧸ Subgroup.center K) .PSL 3 2 2)
    (hZ2 : IsPGroup 2 (Subgroup.center K)) (hφ : frattini ↥(Subgroup.center K) ≠ ⊥)
    (P : Sylow 2 K) :
    (Subgroup.center ↥(P : Subgroup K)).map (P : Subgroup K).subtype = Subgroup.center K := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨e⟩ := nonempty_equiv_of_stated _ hmodel
  obtain ⟨q₀, hq₀⟩ := burnsideI22P3_pres_of_equiv e
  obtain ⟨g, hgS, hg⟩ := burnsideI22P3_std hq₀ hZ2 P
  set q : K →* Equiv.Perm (Fin 42) := (MulAut.conj g).toMonoidHom.comp q₀ with hqdef
  have hq : burnsideI22P3_Pres q := burnsideI22P3_pres_conj hq₀ hgS
  have hqx : ∀ x, q x ∈ T0 ↔ x ∈ (P : Subgroup K) := fun x => by
    rw [hqdef]
    exact hg x
  obtain ⟨l, hQ⟩ := burnsideI22P3_qsetting hq hK.1.commutator_eq_top hZ2
  have hZP : Subgroup.center K ≤ (P : Subgroup K) := hZ2.le_sylow_of_normal P
  have hk4 : ∃ z ∈ q.ker, z * z ≠ 1 := by
    by_contra hcon
    push Not at hcon
    apply hφ
    rw [burnsideI22P3_frattini_center_iff hZ2]
    intro z hz
    exact hcon z (by rw [hq.ker]; exact hz)
  ext u
  constructor
  · rintro ⟨⟨v, hv⟩, hvc, rfl⟩
    rw [← hq.ker, MonoidHom.mem_ker]
    refine hQ.q_eq_one_of_central hk4 ((hqx v).2 hv) fun e' he' => ?_
    have := (Subgroup.mem_center_iff.1 hvc) ⟨e', (hqx e').1 he'⟩
    exact (congrArg Subtype.val this).symm
  · intro hu
    refine ⟨⟨u, hZP hu⟩, Subgroup.mem_center_iff.2 fun w => ?_, rfl⟩
    exact Subtype.ext ((Subgroup.mem_center_iff.1 hu) w)

open CFSG.ComponentClassification.GrSLit.L34Facts CFSG.ComponentClassification.PSL3Four
  CFSG.PSL3Four in
theorem burnsideI22P3_overgroup
    {X : Subgroup (Equiv.Perm (Fin 42))} (hXS : X ≤ S) (hB : B0 ≤ X) (hne : X ≠ S) :
    X ≤ P1 ∨ X ≤ P2 := by
  have key : ∀ g ∈ X, g ∈ P1 ∨ g ∈ P2 := by
    intro g hg
    obtain ⟨k, hk, hb⟩ := exists_rep (hXS hg)
    have hyX : wordPerm (wReps.getD k []) ∈ X := by
      have := X.mul_mem hg (X.inv_mem (hB hb))
      rwa [mul_inv_rev, inv_inv, mul_inv_cancel_left] at this
    have hg' : g = wordPerm (wReps.getD k []) * ((wordPerm (wReps.getD k []))⁻¹ * g) := by
      group
    rcases rep_cases hk with h | h | h
    · left
      rw [hg']
      exact P1.mul_mem h (B0_le_P1_P2.1 hb)
    · right
      rw [hg']
      exact P2.mul_mem h (B0_le_P1_P2.2 hb)
    · exfalso
      apply hne
      refine le_antisymm hXS ?_
      rw [← h, Subgroup.closure_le]
      rintro _ ⟨w, hw, rfl⟩
      rcases List.mem_append.1 hw with hw | hw
      · exact hB (Subgroup.subset_closure ⟨w, hw, rfl⟩)
      · rw [List.mem_singleton.1 hw]
        exact hyX
  have hsub : (X : Set (Equiv.Perm (Fin 42))) ⊆ (P1 : Set _) ∪ P2 := fun g hg => key g hg
  exact SubgroupClass.subset_union.1 hsub

open CFSG.ComponentClassification.GrSLit.L34Facts CFSG.ComponentClassification.PSL3Four
  CFSG.PSL3Four CFSG.ASVolI.ChIJK in
theorem burnsideI22P3_parabolic
    {K : Type} [Group K] [Finite K] {q₀ : K →* Equiv.Perm (Fin 42)}
    (hq₀ : burnsideI22P3_Pres q₀) (hZ2 : IsPGroup 2 (Subgroup.center K))
    {Ps : Subgroup (K ⧸ Subgroup.center K)} (hPs : IsMaxParabolicTwo Ps) :
    ∃ g ∈ S, ∃ P : Sylow 2 K,
      (∀ x, ((MulAut.conj g).toMonoidHom.comp q₀) x ∈ T0 ↔ x ∈ (P : Subgroup K)) ∧
      (preimageStar K Ps = Subgroup.comap ((MulAut.conj g).toMonoidHom.comp q₀) P1 ∨
        preimageStar K Ps = Subgroup.comap ((MulAut.conj g).toMonoidHom.comp q₀) P2) := by
  obtain ⟨hne, T, hNT, hmax⟩ := hPs
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hmk : Function.Surjective (QuotientGroup.mk' (Subgroup.center K)) :=
    QuotientGroup.mk'_surjective _
  obtain ⟨Pk, hPk⟩ := Sylow.mapSurjective_surjective hmk 2 T
  have hTmap : (T : Subgroup (K ⧸ Subgroup.center K)) =
      (Pk : Subgroup K).map (QuotientGroup.mk' (Subgroup.center K)) := by
    rw [← Sylow.coe_mapSurjective hmk Pk, hPk]
  obtain ⟨g, hgS, hg⟩ := burnsideI22P3_std hq₀ hZ2 Pk
  refine ⟨g, hgS, Pk, hg, ?_⟩
  set q : K →* Equiv.Perm (Fin 42) := (MulAut.conj g).toMonoidHom.comp q₀ with hqdef
  have hq : burnsideI22P3_Pres q := burnsideI22P3_pres_conj hq₀ hgS
  have hqx : ∀ x, q x ∈ T0 ↔ x ∈ (Pk : Subgroup K) := fun x => by
    rw [hqdef]
    exact hg x
  set ψ : K ⧸ Subgroup.center K →* Equiv.Perm (Fin 42) :=
    QuotientGroup.lift (Subgroup.center K) q (hq.ker.ge) with hψdef
  have hψ : ∀ x : K, ψ (QuotientGroup.mk x) = q x := fun x => rfl
  have hψinj : Function.Injective ψ := by
    intro y y' hyy
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective y
    obtain ⟨x', rfl⟩ := QuotientGroup.mk_surjective y'
    rw [hψ, hψ] at hyy
    have : x⁻¹ * x' ∈ q.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hyy, inv_mul_cancel]
    rw [hq.ker] at this
    exact (QuotientGroup.eq.2 this)
  have hψS : ∀ y, ψ y ∈ S := fun y => by
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective y
    rw [hψ]
    exact hq.mem x
  have hψsurj : ∀ s ∈ S, ∃ y, ψ y = s := fun s hs => by
    obtain ⟨x, hx⟩ := hq.surj s hs
    exact ⟨QuotientGroup.mk x, by rw [hψ, hx]⟩
  have hTψ : ∀ y, y ∈ (T : Subgroup (K ⧸ Subgroup.center K)) ↔ ψ y ∈ T0 := fun y => by
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective y
    rw [hTmap, hψ, hqx]
    constructor
    · rintro ⟨p, hp, hpx⟩
      have hpx' : (p : K)⁻¹ * x ∈ Subgroup.center K :=
        QuotientGroup.eq.1 (by simpa using hpx)
      have hxp : x = p * (p⁻¹ * x) := by group
      rw [hxp]
      exact (Pk : Subgroup K).mul_mem hp (hZ2.le_sylow_of_normal Pk hpx')
    · intro hx
      exact ⟨x, hx, rfl⟩
  set X : Subgroup (Equiv.Perm (Fin 42)) := Ps.map ψ with hXdef
  have hXS : X ≤ S := by
    rintro _ ⟨y, -, rfl⟩
    exact hψS y
  have hBX : B0 ≤ X := by
    intro b hb
    obtain ⟨y, hy⟩ := hψsurj b (B0_le_S hb)
    refine ⟨y, hNT ?_, hy⟩
    rw [Subgroup.mem_normalizer_iff]
    intro z
    rw [hTψ, hTψ, map_mul, map_mul, map_inv, hy]
    exact Subgroup.mem_normalizer_iff.1 (B0_le_normalizer hb) _
  have hXne : X ≠ S := by
    intro hXS'
    apply hne
    rw [eq_top_iff]
    intro y _
    have : ψ y ∈ X := by rw [hXS']; exact hψS y
