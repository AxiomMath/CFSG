  refine ⟨φ v₀, ⟨⟨z₀, hz₀, ?_⟩, φ x₀, ?_, ?_⟩, ?_⟩
  · rw [hv₀, map_mul, hcenter z₀ hz₀, hφapply u]
  · rw [hQ]; exact ⟨x₀, hx₀, rfl⟩
  · rw [← map_pow, hx₀v]
