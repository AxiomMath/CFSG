  have hy2 : (sig covData.tab xt 79 * sig covData.tab xt 79) *
      (sig covData.tab xt 79 * sig covData.tab xt 79) = 1 :=
    hc.mul_self_of_lift (hc.orderOf_sig_sq e xt hxt)
  have hφy : X.φ (sig covData.tab xt 79 * sig covData.tab xt 79) = i22zP := by
    rw [map_mul, hφsig]; rfl
  have hcenter : ∀ x : L, x ∈ Subgroup.center L ↔ x = 1 ∨ x = t := fun x => by
    constructor
    · intro hx
      rw [hc.center_eq] at hx
      exact eq_one_or_eq_of_mem_zpowers_of_orderOf_eq_two hc.orderOf_t hx
    · rintro (rfl | rfl)
      · exact Subgroup.one_mem _
      · exact hc.center_eq ▸ Subgroup.mem_zpowers _
  have hmk1 : ∀ x : L, (x : L ⧸ Subgroup.center L) = 1 ↔ X.φ x = 1 := fun x => by
    rw [QuotientGroup.eq_one_iff, hcenter, hker]
  have hinvol : ∀ g : L, X.φ g ≠ 1 → X.φ g * X.φ g = 1 → g * g = 1 := by
    intro g hne hsq
    apply hc.mul_self_of_lift
    refine orderOf_eq_prime (by
      rw [sq, ← QuotientGroup.mk_mul]
      exact (hmk1 _).2 (by rw [map_mul]; exact hsq)) (fun h1 => hne ((hmk1 g).1 h1))
  have hnsq : ∀ g : L, g * g ≠ t := hc.not_sq_t
  have hy2' : (sig covData.tab xt 79 * sig covData.tab xt 79) *
      (sig covData.tab xt 79 * sig covData.tab xt 79) = 1 := hy2
  have hxy : ∀ i : Fin 3, xt i * (sig covData.tab xt 79 * sig covData.tab xt 79) =
      (sig covData.tab xt 79 * sig covData.tab xt 79) * xt i := by
    intro i
    by_cases hx1 : covData.x i = 1
    · rcases (hker (xt i)).1 (by rw [hxt i, hx1]) with h1 | h1
      · rw [h1, one_mul, mul_one]
      · rw [h1]; exact (htc _).symm
    · have hg2 : xt i * xt i = 1 := hinvol _ (by rw [hxt i]; exact hx1)
        (by rw [hxt i]; exact twInv_sound hx hinv i)
      have hxS0 : covData.x i ∈ covData.tab.sub covData.x hT := by
        have el0 : covData.tab.el covData.x 0 = 1 := by simp [CayTab.el, hT.word_zero]
        have h1 := hT.el_tgt 0 hT.zero_lt i
