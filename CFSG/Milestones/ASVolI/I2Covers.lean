theorem burnsideI22P7_exists_sz_lifts
    {K : Type} [Group K] [Finite K] [Group.IsPerfect K] {q : K →* ruP}
    (hq : Function.Surjective q) {t : K} (ht : orderOf t = 2)
    (hker : q.ker = Subgroup.zpowers t) (hcen : Subgroup.zpowers t ≤ Subgroup.center K) :
    ∃ s' t' : K, ((q s' : ruP) : Equiv.Perm (Fin 4060)) = sG ∧
      ((q t' : ruP) : Equiv.Perm (Fin 4060)) = tG ∧
      ∀ v ∈ szRels, CFSG.Sporadic.Bridge.wordProd (CFSG.Sporadic.Bridge.TwoGen.img2 s' t') v = 1 := by
  have hchk : szCoverChk () = true := Certificates.certificate7295
  simp only [szCoverChk, Bool.and_eq_true, and_assoc] at hchk
  obtain ⟨hl0, hl1, hi0, hi1, hflag, him1, him2, hiw, hih, hil0, hil1, hil2, his, hit, hrels⟩ := hchk
  obtain ⟨ψ, a, b, hψinj, ha, hb, hqa, hqb, ha2⟩ := burnsideI22P7_faithful hq ht hker hcen hl1
  set lK : ℕ → K := fun i => burnsideI22P7_lGen a b i with hlK
  have hlrep : ∀ i, Rep 16240 (szLA 16240 (p0A ()) (p1A ()) i) (ψ (lK i)) := fun i => by
    rw [hlK, burnsideI22P7_map_lGen]
    exact burnsideI22P7_rep_szLA ha hb hi0 hi1 hflag him1 him2 hiw hih i
  have hS3 : ∀ h < 3, Rep 16240 (szLArr 16240 (p0A ()) (p1A ()))[h]!
      ([ψ (lK 0), ψ (lK 1), ψ (lK 2)].getD h 1) := by
    intro h hh; interval_cases h <;> simpa [szLArr] using hlrep _
  have hSinv3 : ∀ h < 3, Rep 16240 ((szLArr 16240 (p0A ()) (p1A ())).map (invCand 16240))[h]!
      ([ψ (lK 0), ψ (lK 1), ψ (lK 2)].getD h 1)⁻¹ := by
    intro h hh; interval_cases h
    · simpa [szLArr] using rep_inv_of_isInvA (hlrep 0) hil0
    · simpa [szLArr] using rep_inv_of_isInvA (hlrep 1) hil1
    · simpa [szLArr] using rep_inv_of_isInvA (hlrep 2) hil2
  have hsrep : Rep 16240 (szSA 16240 (p0A ()) (p1A ()))
      (evalSigned [ψ (lK 0), ψ (lK 1), ψ (lK 2)] sWord) :=
    rep_wordA_evalSigned hS3 hSinv3 sWord (by decide)
  have htrep0 : Rep 16240 (szLWordA 16240 (p0A ()) (p1A ()) tWord)
      (evalSigned [ψ (lK 0), ψ (lK 1), ψ (lK 2)] tWord) :=
    rep_wordA_evalSigned hS3 hSinv3 tWord (by decide)
  set s' : K := evalSigned [lK 0, lK 1, lK 2] sWord with hs'
  set t' : K := evalSigned [lK 0, lK 1, lK 2] tWord * (a * a) with ht'
  have hψs : ψ s' = evalSigned [ψ (lK 0), ψ (lK 1), ψ (lK 2)] sWord := by
    rw [hs', map_evalSigned]; rfl
  have hψt : ψ t' = evalSigned [ψ (lK 0), ψ (lK 1), ψ (lK 2)] tWord * (ψ a * ψ a) := by
    rw [ht', map_mul, map_mul, map_evalSigned]; rfl
  have hsrep' : Rep 16240 (szSA 16240 (p0A ()) (p1A ())) (ψ s') := hψs ▸ hsrep
  have htrep' : Rep 16240 (szTA 16240 (p0A ()) (p1A ())) (ψ t') := by
    rw [hψt]
    exact rep_compA htrep0 (rep_compA ha ha)
  refine ⟨s', t', ?_, ?_, ?_⟩
  ·
    have hf : ∀ i, (ruP.subtype.comp q) (lK i) = ruLGens.getD i 1 := by
      intro i
      have := burnsideI22P7_map_lGen (ruP.subtype.comp q) a b i
      rw [hlK]
      rw [this]
      have e0 : (ruP.subtype.comp q) a = ruA0 := hqa
      have e1 : (ruP.subtype.comp q) b = ruA1 := hqb
      rw [e0, e1]
      exact burnsideI22P7_lGen_ruA
    have hfs : (ruP.subtype.comp q) s' = evalSigned ruLGens sWord := by
      rw [hs', map_evalSigned]
      simp only [List.map_cons, List.map_nil, hf]
      rw [burnsideI22P7_ruLGens_eq]
    show (ruP.subtype.comp q) s' = sG
    rw [hfs, ← burnsideI22P7_wordG_eq_evalSigned]
    rfl
  · have hf : ∀ i, (ruP.subtype.comp q) (lK i) = ruLGens.getD i 1 := by
      intro i
      have := burnsideI22P7_map_lGen (ruP.subtype.comp q) a b i
      rw [hlK]
      rw [this]
      have e0 : (ruP.subtype.comp q) a = ruA0 := hqa
      have e1 : (ruP.subtype.comp q) b = ruA1 := hqb
      rw [e0, e1]
      exact burnsideI22P7_lGen_ruA
    have hqt : q t = 1 := by
      rw [← MonoidHom.mem_ker, hker]; exact Subgroup.mem_zpowers t
    have haa : a * a = t := by rw [← pow_two]; exact ha2
    have hfs : (ruP.subtype.comp q) t' = evalSigned ruLGens tWord := by
      rw [ht', map_mul, map_evalSigned, haa]
      simp only [List.map_cons, List.map_nil, hf]
      rw [burnsideI22P7_ruLGens_eq]
      have : (ruP.subtype.comp q) t = 1 := by
        show ((q t : ruP) : Equiv.Perm (Fin 4060)) = 1
        rw [hqt]; rfl
      rw [this, mul_one]
    show (ruP.subtype.comp q) t' = tG
    rw [hfs, ← burnsideI22P7_wordG_eq_evalSigned]
    rfl
  · intro v hv
    have hre := List.all_eq_true.1 hrels v hv
    have hrep := burnsideI22P7_rep_szPwordA hsrep' (rep_inv_of_isInvA hsrep' his) htrep'
      (rep_inv_of_isInvA htrep' hit) v
    have h1 := (eqA_iff hrep rep_idA).1 hre
    apply hψinj
    rw [map_one]
    have : ψ (CFSG.Sporadic.Bridge.wordProd (CFSG.Sporadic.Bridge.TwoGen.img2 s' t') v) =
        CFSG.Sporadic.Bridge.wordProd (CFSG.Sporadic.Bridge.TwoGen.img2 (ψ s') (ψ t')) v := by
      rw [CFSG.Sporadic.Bridge.map_wordProd]
      congr 1
      funext i
      unfold CFSG.Sporadic.Bridge.TwoGen.img2
      split_ifs <;> rfl
    rw [this]
    exact h1

