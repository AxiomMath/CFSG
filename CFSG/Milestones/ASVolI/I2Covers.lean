    · have hx1 : x ∈ q.ker := by rw [MonoidHom.mem_ker]; exact Subtype.ext h1
      rw [hker] at hx1
      rcases CFSG.EvenSporadicStandard.TwoRu.eq_one_or_eq_of_mem_zpowers ht hx1 with h | h
      · rw [h]; simp
      · rw [h, ← ht]; exact pow_orderOf_eq_one t
    · obtain ⟨m, hm, hmu⟩ := exists_conj_t64 hxu h1
      obtain ⟨m₀, hm₀, hm₀z⟩ := exists_conj_t64 ruZ_mem_u64
        (by rw [← ruEElt_zero]; exact ruEElt_ne_one (by norm_num))
