theorem burnsideI22P7_split_Sz
    {K : Type} [Group K] [Finite K] [Group.IsPerfect K] {q : K →* ruP}
    (hq : Function.Surjective q) {t : K} (ht : orderOf t = 2)
    (hker : q.ker = Subgroup.zpowers t) (hcen : Subgroup.zpowers t ≤ Subgroup.center K) :
    ∃ L0 : Subgroup K, (∀ x ∈ L0, ((q x : ruP) : Equiv.Perm (Fin 4060)) ∈ K0) ∧
      (∀ x ∈ L0, q x = 1 → x = 1) ∧
      ∀ y ∈ K0, ∃ x ∈ L0, ((q x : ruP) : Equiv.Perm (Fin 4060)) = y := by
  obtain ⟨g, hP⟩ := exists_presentation
  obtain ⟨s', t', hs, ht', hrel⟩ := burnsideI22P7_exists_sz_lifts hq ht hker hcen
  obtain ⟨θK, hθK0, hθK1⟩ := burnsideI22P7_szHom hP (burnsideI22P7_lift_eq_one hrel)
  obtain ⟨θP, hθP0, hθP1⟩ := burnsideI22P7_szHom hP (burnsideI22P7_lift_eq_one wordProd_rels)
  have hinj : Function.Injective θP := by
    rw [← MonoidHom.ker_eq_bot_iff]
    haveI := szB_simple
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal θP.ker with h | h
    · exact h
    · exfalso
      apply sG_ne_one
      rw [← hθP0]
      exact MonoidHom.mem_ker.1 (h ▸ Subgroup.mem_top _)
  have hrange : θP.range = K0 := by
    have hclos : closure (Set.range g) = ⊤ := by
      rw [← FreeGroup.range_lift_eq_closure]
      exact MonoidHom.range_eq_top.2 hP.lift_surjective
    rw [MonoidHom.range_eq_map, ← hclos, MonoidHom.map_closure, K0]
    congr 1
    ext x
    constructor
    · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
      fin_cases i
      · left; exact hθP0
      · right; exact hθP1
    · rintro (rfl | rfl)
      · exact ⟨_, ⟨0, rfl⟩, hθP0⟩
      · exact ⟨_, ⟨1, rfl⟩, hθP1⟩
  have hcomp : (ruP.subtype.comp q).comp θK = θP := by
    have h1 : ((ruP.subtype.comp q).comp θK).comp (FreeGroup.lift g) =
        θP.comp (FreeGroup.lift g) := by
      refine FreeGroup.ext_hom _ _ fun i => ?_
      simp only [MonoidHom.comp_apply, FreeGroup.lift_apply_of]
      fin_cases i
      · show (ruP.subtype.comp q) (θK (g 0)) = θP (g 0)
        rw [hθK0, hθP0]; exact hs
      · show (ruP.subtype.comp q) (θK (g 1)) = θP (g 1)
        rw [hθK1, hθP1]; exact ht'
    refine MonoidHom.ext fun x => ?_
    obtain ⟨y, rfl⟩ := hP.lift_surjective x
    exact DFunLike.congr_fun h1 y
  refine ⟨θK.range, ?_, ?_, ?_⟩
  · rintro _ ⟨y, rfl⟩
    have : ((q (θK y) : ruP) : Equiv.Perm (Fin 4060)) = θP y := by
      rw [← hcomp]; rfl
    rw [this, ← hrange]
    exact ⟨y, rfl⟩
  · rintro _ ⟨y, rfl⟩ h1
    have : θP y = 1 := by
      rw [← hcomp]
      show ((q (θK y) : ruP) : Equiv.Perm (Fin 4060)) = 1
      rw [h1]; rfl
    have hy : y = 1 := hinj (by rw [this, map_one])
    rw [hy, map_one]
  · intro y hy
    rw [← hrange] at hy
    obtain ⟨y', rfl⟩ := hy
    refine ⟨θK y', ⟨y', rfl⟩, ?_⟩
    rw [← hcomp]
    rfl

open scoped commutatorElement in
theorem burnsideI22P7_isQuasisimple_of_simple {S : Type*} [Group S] [IsSimpleGroup S]
    (hn : ∃ a b : S, a * b ≠ b * a) : CFSG.IsQuasisimple S := by
  have hc : Subgroup.center S = ⊥ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center S) with h | h
    · exact h
    · exfalso
      obtain ⟨a, b, hab⟩ := hn
      exact hab (Subgroup.mem_center_iff.1 (h ▸ Subgroup.mem_top a) b).symm
  let e : S ⧸ Subgroup.center S ≃* S :=
    (QuotientGroup.quotientMulEquivOfEq hc).trans QuotientGroup.quotientBot
  refine ⟨?_, ?_, ?_⟩
  · rw [Group.isPerfect_def]
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (commutator S) with h | h
    · exfalso
      obtain ⟨a, b, hab⟩ := hn
      apply hab
      have hm : ⁅a, b⁆ ∈ commutator S := by
        rw [_root_.commutator_def]
        exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
      rw [h, Subgroup.mem_bot] at hm
      exact commutatorElement_eq_one_iff_mul_comm.1 hm
    · exact h
  · exact (MulEquiv.isSimpleGroup_congr e).2 inferInstance
  · obtain ⟨a, b, hab⟩ := hn
    exact ⟨e.symm a, e.symm b, fun h => hab (e.symm.injective (by rw [map_mul, map_mul]; exact h))⟩

theorem burnsideI22P7_layer_eq {G : Type*} [Group G] {C N : Subgroup G} (hNC : N ≤ C)
    (hnorm : (N.subgroupOf C).Normal) [IsSimpleGroup N] (hnab : ∃ a b : N, a * b ≠ b * a)
    (hcomm : ∀ x ∈ C, ∀ y ∈ C, x * y * x⁻¹ * y⁻¹ ∈ N) :
    (CFSG.layer ↥C).map C.subtype = N := by
  have hNq : CFSG.IsQuasisimple N := burnsideI22P7_isQuasisimple_of_simple hnab
  have hcomp : CFSG.IsComponent (N.subgroupOf C) :=
    ⟨CFSG.LocalCores.isQuasisimple_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hNC).symm hNq,
      hnorm.isSubnormal⟩
  have hle : ∀ M : Subgroup ↥C, CFSG.IsComponent M → M ≤ N.subgroupOf C := by
    intro M hM
    have hp := Subgroup.isPerfect_iff.1 hM.1.1
    rw [← hp, Subgroup.commutator_le]
    intro x hx y hy
    exact hcomm x x.2 y y.2
  have hlayer : CFSG.layer ↥C = N.subgroupOf C :=
    le_antisymm (sSup_le fun M hM => hle M hM) (le_sSup hcomp)
  rw [hlayer, Subgroup.map_subgroupOf_eq_of_le hNC]

theorem burnsideI22P7_nonabelian_of_card {S : Type*} [Group S] [Finite S] [IsSimpleGroup S]
    (hc : ¬ (Nat.card S).Prime) : ∃ a b : S, a * b ≠ b * a := by
  by_contra h
  push Not at h
  letI : CommGroup S := { ‹Group S› with mul_comm := h }
  exact hc (IsSimpleGroup.prime_card (α := S))

open CFSG.Sporadic.RuSchreier CFSG.EvenSporadicStandard.Induction.RuSz in
theorem burnsideI22P7_comm_mem_K0
    {x y : Equiv.Perm (Fin 4060)} (hx : x ∈ ruL) (hy : y ∈ ruL) :
    x * y * x⁻¹ * y⁻¹ ∈ K0 := by
  haveI := K0_normal
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hcard : Nat.card (↥ruL ⧸ K0.subgroupOf ruL) = 2 ^ 2 := by
    have h1 := Subgroup.card_eq_card_quotient_mul_card_subgroup (K0.subgroupOf ruL)
    rw [card_ruL_eq, Nat.card_congr (Subgroup.subgroupOfEquivOfLe K0_le_L).toEquiv] at h1
    have hpos : 0 < Nat.card K0 := Nat.card_pos
    have : Nat.card (↥ruL ⧸ K0.subgroupOf ruL) * Nat.card K0 = 4 * Nat.card K0 := h1.symm
    have := Nat.eq_of_mul_eq_mul_right hpos this
    omega
  haveI := IsPGroup.isMulCommutative_of_card_eq_prime_sq hcard
  have hc := IsMulCommutative.is_comm.comm (QuotientGroup.mk (⟨x, hx⟩ : ruL) :
    ↥ruL ⧸ K0.subgroupOf ruL) (QuotientGroup.mk (⟨y, hy⟩ : ruL))
  have h2 : QuotientGroup.mk ((⟨x, hx⟩ : ruL) * ⟨y, hy⟩ * ⟨x, hx⟩⁻¹ * ⟨y, hy⟩⁻¹) =
      (1 : ↥ruL ⧸ K0.subgroupOf ruL) := by
    rw [QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv,
      QuotientGroup.mk_inv, hc]
    group
  have := (QuotientGroup.eq_one_iff _).1 h2
  exact Subgroup.mem_subgroupOf.1 this

theorem burnsideI22P7_layer_centralizer_abs {G P : Type*} [Group G] [Group P] (σ : G ≃* P) (i : G)
    {L Q : Subgroup P} (hQL : Q ≤ L)
    (hCL : ∀ x : P, x * σ i = σ i * x → x ∈ L) (hLC : ∀ x ∈ L, x * σ i = σ i * x)
    (hLQ : ∀ l ∈ L, ∀ q ∈ Q, l * q * l⁻¹ ∈ Q) [IsSimpleGroup Q]
    (hnab : ∃ a b : Q, a * b ≠ b * a) (hcomm : ∀ x ∈ L, ∀ y ∈ L, x * y * x⁻¹ * y⁻¹ ∈ Q) :
    (CFSG.layer ↥(Subgroup.centralizer ({i} : Set G))).map
        (Subgroup.centralizer ({i} : Set G)).subtype = Q.comap σ.toMonoidHom := by
  set C := Subgroup.centralizer ({i} : Set G) with hC
  set N : Subgroup G := Q.comap σ.toMonoidHom with hN
  have hNmem : ∀ x, x ∈ N ↔ σ x ∈ Q := fun x => Iff.rfl
  have hCL' : ∀ c ∈ C, σ c ∈ L := by
    intro c hc
    apply hCL
    have h1 : c * i = i * c := Subgroup.mem_centralizer_singleton_iff.1 hc
    rw [← map_mul, ← map_mul, h1]
  have hNC : N ≤ C := by
    intro n hn
    have h2 := hLC _ (hQL ((hNmem n).1 hn))
    rw [Subgroup.mem_centralizer_singleton_iff]
    apply σ.injective
    rw [map_mul, map_mul]
    exact h2
  have hnorm : (N.subgroupOf C).Normal := by
    rw [Subgroup.normal_subgroupOf_iff hNC]
    intro n c hn hc
    rw [hNmem] at hn ⊢
    rw [map_mul, map_mul, map_inv]
    exact hLQ _ (hCL' c hc) _ hn
  let f : N →* Q :=
    { toFun := fun x => ⟨σ x, (hNmem x).1 x.2⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun x y => Subtype.ext (by simp) }
  have hbij : Function.Bijective f := by
    refine ⟨fun x y h => Subtype.ext (σ.injective (congrArg Subtype.val h)), ?_⟩
    intro y
    refine ⟨⟨σ.symm y, (hNmem _).2 (by rw [MulEquiv.apply_symm_apply]; exact y.2)⟩, ?_⟩
    apply Subtype.ext
    show σ (σ.symm (y : P)) = y
    rw [MulEquiv.apply_symm_apply]
  let e : N ≃* Q := MulEquiv.ofBijective f hbij
  haveI hNs : IsSimpleGroup N := (MulEquiv.isSimpleGroup_congr e).2 inferInstance
  have hnab' : ∃ a b : N, a * b ≠ b * a := by
    obtain ⟨a, b, hab⟩ := hnab
    exact ⟨e.symm a, e.symm b, fun h => hab (e.symm.injective (by
      rw [map_mul, map_mul]; exact h))⟩
  refine burnsideI22P7_layer_eq hNC hnorm hnab' ?_
  intro x hx y hy
  rw [hNmem]
  simp only [map_mul, map_inv]
  exact hcomm _ (hCL' x hx) _ (hCL' y hy)

open CFSG.Sporadic.RuSchreier CFSG.EvenSporadicStandard.Induction.RuSz
  CFSG.EvenSporadicStandard.TwoRu in
theorem burnsideI22P7_layer_centralizer
    {G : Type} [Group G] (σ : G ≃* ruP) (i : G) (hi : σ i = ruAEl) :
    (CFSG.layer ↥(Subgroup.centralizer ({i} : Set G))).map
        (Subgroup.centralizer ({i} : Set G)).subtype =
      (K0.subgroupOf ruP).comap σ.toMonoidHom := by
  have hK0P : K0 ≤ ruP := K0_le_L.trans ruL_le
  have e0 : K0.subgroupOf ruP ≃* K0 := Subgroup.subgroupOfEquivOfLe hK0P
  haveI : IsSimpleGroup (K0.subgroupOf ruP) := (MulEquiv.isSimpleGroup_congr e0).2 K0_simple
  haveI : Finite K0 := K0_finite
  haveI : IsSimpleGroup K0 := K0_simple
  refine burnsideI22P7_layer_centralizer_abs σ i (L := ruL.subgroupOf ruP)
    (Q := K0.subgroupOf ruP) ?_ ?_ ?_ ?_ ?_ ?_
  · intro x hx
    exact Subgroup.mem_subgroupOf.2 (K0_le_L (Subgroup.mem_subgroupOf.1 hx))
  · intro x hx
    rw [hi] at hx
    have h1 : (x : Equiv.Perm (Fin 4060)) * ruA0 = ruA0 * (x : Equiv.Perm (Fin 4060)) :=
      congrArg Subtype.val hx
    refine Subgroup.mem_subgroupOf.2 ?_
    rw [← ruCentralizer_a]
    exact ⟨x.2, Subgroup.mem_centralizer_singleton_iff.2 h1⟩
  · intro x hx
    rw [hi]
    have h1 := Subgroup.mem_centralizer_singleton_iff.1
      (ruL_le_centralizer (Subgroup.mem_subgroupOf.1 hx)).2
    exact Subtype.ext h1
  · intro l hl q hq
    have := (Subgroup.mem_normalizer_iff.1 (ruL_le_normalizer (Subgroup.mem_subgroupOf.1 hl))
      (q : Equiv.Perm (Fin 4060))).1 (Subgroup.mem_subgroupOf.1 hq)
    exact Subgroup.mem_subgroupOf.2 (by simpa using this)
  · obtain ⟨a, b, hab⟩ := burnsideI22P7_nonabelian_of_card (S := K0) (by rw [card_K0]; norm_num)
    exact ⟨e0.symm a, e0.symm b, fun h => hab (e0.symm.injective (by
      rw [map_mul, map_mul]; exact h))⟩
  · intro x hx y hy
    refine Subgroup.mem_subgroupOf.2 ?_
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    exact burnsideI22P7_comm_mem_K0 (Subgroup.mem_subgroupOf.1 hx) (Subgroup.mem_subgroupOf.1 hy)

open CFSG.Blueprint CFSG.ASVolI.ChIJK CFSG.Sporadic.RuSchreier CFSG.EvenSporadicStandard.TwoRu
  CFSG.EvenSporadicStandard.Induction.RuSz in
theorem burnsideI22P7_clause_a
    {K : Type} [Group K] [Finite K] (hK : CFSG.IsQuasisimple K) (hZ : Subgroup.center K ≠ ⊥)
    (hRu : NativeSporadic.IsSporadic (K ⧸ Subgroup.center K) .Ru)
    (i : K ⧸ Subgroup.center K) (hi2 : i ^ 2 = 1) (hi1 : i ≠ 1) (hn : ¬ IsTwoCentralInvolution i) :
    ∃ L : Subgroup K, L ≤ preimageLayerCentralizer K i ∧ L ⊓ Subgroup.center K = ⊥ ∧
      L ⊔ Subgroup.center K = preimageLayerCentralizer K i := by
  haveI hperf : Group.IsPerfect K := hK.1
  obtain ⟨e, t, ht, hZt⟩ := burnsideI22P7_setup hK hZ hRu
  obtain ⟨q, hq, hkerZ, hqe⟩ := burnsideI22P7_qMap e
  have hker : q.ker = Subgroup.zpowers t := hkerZ.trans hZt
  have hcen : Subgroup.zpowers t ≤ Subgroup.center K := hZt ▸ le_rfl
  have hs2 : (e i) ^ 2 = 1 := by rw [← map_pow, hi2, map_one]
  have hs1 : e i ≠ 1 := fun h => hi1 (e.injective (by rw [h, map_one]))
  have hnc : ¬ IsTwoCentralInvolution (e i) := fun h => hn (by
    have := burnsideI22P7_isTwoCentral_map e.symm h
    simpa using this)
  obtain ⟨g, hg⟩ : ∃ g : ruP, e i = g * ruAEl * g⁻¹ := by
    rcases involution_dichotomy hs2 hs1 with h | hA
    · exact h
    · exact absurd ((burnsideI22P7_isTwoCentral_iff).2 ⟨hs2, hs1, hA⟩) hnc
  let σ : (K ⧸ Subgroup.center K) ≃* ruP := e.trans (MulAut.conj g⁻¹)
  have hσ : ∀ x, σ x = g⁻¹ * e x * g := fun x => by
    simp [σ, MulAut.conj_apply]
  have hσi : σ i = ruAEl := by rw [hσ, hg]; group
  have hlayer := burnsideI22P7_layer_centralizer σ i hσi
  have hpre : preimageLayerCentralizer K i =
      preimageStar K ((K0.subgroupOf ruP).comap σ.toMonoidHom) := by
    unfold preimageLayerCentralizer
    rw [hlayer]
  rw [hpre]
  obtain ⟨L0, hL0K, hL0inj, hL0surj⟩ := burnsideI22P7_split_Sz hq ht hker hcen
  obtain ⟨g', hg'⟩ := hq g
  have hmem : ∀ k : K, k ∈ preimageStar K ((K0.subgroupOf ruP).comap σ.toMonoidHom) ↔
      ((g⁻¹ * q k * g : ruP) : Equiv.Perm (Fin 4060)) ∈ K0 := by
    intro k
    show σ (k : K ⧸ Subgroup.center K) ∈ K0.subgroupOf ruP ↔ _
    rw [Subgroup.mem_subgroupOf, hσ, ← hqe]
  have hqconj : ∀ y : K, q (g' * y * g'⁻¹) = g * q y * g⁻¹ := fun y => by
    rw [map_mul, map_mul, map_inv, hg']
  have hLpre : L0.map (MulAut.conj g').toMonoidHom ≤
      preimageStar K ((K0.subgroupOf ruP).comap σ.toMonoidHom) := by
    rintro _ ⟨y, hy, rfl⟩
    rw [hmem]
    have : g⁻¹ * q ((MulAut.conj g').toMonoidHom y) * g = q y := by
      show g⁻¹ * q (g' * y * g'⁻¹) * g = q y
      rw [hqconj]; group
    rw [this]
    exact hL0K y hy
  refine ⟨L0.map (MulAut.conj g').toMonoidHom, hLpre, ?_, ?_⟩
  · rw [eq_bot_iff]
    rintro _ ⟨⟨y, hy, rfl⟩, hxZ⟩
    have hx1 : q (g' * y * g'⁻¹) = 1 := by
      rw [← MonoidHom.mem_ker, hkerZ]; exact hxZ
    have hy1 : q y = 1 := by
      have h2 := hqconj y
      rw [hx1] at h2
      calc q y = g⁻¹ * (g * q y * g⁻¹) * g := by group
        _ = 1 := by rw [← h2]; group
    have : y = 1 := hL0inj y hy hy1
    rw [Subgroup.mem_bot]
    show g' * y * g'⁻¹ = 1
    rw [this]; group
  · refine le_antisymm (sup_le hLpre ?_) ?_
    · intro z hz
      rw [hmem]
      have hqz : q z = 1 := by rw [← MonoidHom.mem_ker, hkerZ]; exact hz
      rw [hqz]
      have : (g⁻¹ * 1 * g : ruP) = 1 := by group
      rw [this]
      exact K0.one_mem
    · intro k hk
      obtain ⟨y, hy, hqy⟩ := hL0surj _ ((hmem k).1 hk)
      have hqy' : q y = g⁻¹ * q k * g := Subtype.ext hqy
      have hxL : g' * y * g'⁻¹ ∈ L0.map (MulAut.conj g').toMonoidHom := ⟨y, hy, rfl⟩
      have hqx : q (g' * y * g'⁻¹) = q k := by
        rw [hqconj, hqy']; group
      have hker' : (g' * y * g'⁻¹)⁻¹ * k ∈ Subgroup.center K := by
        rw [← hkerZ, MonoidHom.mem_ker, map_mul, map_inv, hqx, inv_mul_cancel]
      have := Subgroup.mul_mem_sup hxL hker'
      rwa [mul_inv_cancel_left] at this

theorem burnsideI22P7_twoResidual_eq {G : Type} [Group G] [Finite G] (H : Subgroup G) :
    CFSG.ASVolI.ChIJK.twoResidual H = CFSG.Quasithin.oTwoUpper H := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  unfold CFSG.ASVolI.ChIJK.twoResidual
  apply le_antisymm
  · have hmem : (CFSG.Quasithin.oTwoUpper H).subgroupOf H ∈
        {N : Subgroup H | N.Normal ∧ ∃ n : ℕ, N.index = 2 ^ n} := by
      refine ⟨CFSG.Quasithin.H13.KGRu.oTwoUpper_normal H, ?_⟩
      haveI := CFSG.Quasithin.H13.KGRu.oTwoUpper_normal H
      have hp := CFSG.Quasithin.H13.KGRu.isPGroup_quot_oTwoUpper H
      obtain ⟨n, hn⟩ := (IsPGroup.iff_card).1 hp
      exact ⟨n, by rw [Subgroup.index, hn]⟩
    calc (sInf {N : Subgroup H | N.Normal ∧ ∃ n : ℕ, N.index = 2 ^ n}).map H.subtype
        ≤ ((CFSG.Quasithin.oTwoUpper H).subgroupOf H).map H.subtype :=
          Subgroup.map_mono (sInf_le hmem)
      _ = CFSG.Quasithin.oTwoUpper H :=
          Subgroup.map_subgroupOf_eq_of_le (CFSG.Quasithin.oTwoUpper_le H)
  · refine (Subgroup.closure_le _).2 ?_
    rintro x ⟨hxH, hxo⟩
    refine ⟨⟨x, hxH⟩, ?_, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_sInf]
    rintro N ⟨hN, n, hn⟩
    have hodd : Odd (orderOf (⟨x, hxH⟩ : H)) := by rwa [← Subgroup.orderOf_coe]
    have hcop : Nat.Coprime (2 ^ n) (orderOf (⟨x, hxH⟩ : H)) :=
      Nat.Coprime.pow_left n (Nat.coprime_two_left.mpr hodd)
    have h1 := Subgroup.pow_index_mem N (⟨x, hxH⟩ : H)
    rw [hn] at h1
    exact (Subgroup.zpowers_le.mpr h1) (CFSG.Quasithin.A4.mem_zpowers_pow_of_coprime hcop)

open CFSG.Sporadic.J4.QT CFSG.ASVolI.ChIJK in
open scoped commutatorElement in
theorem burnsideI22P7_frattini_eq {K : Type} [Group K] [Finite K] {Q : Subgroup K} (j f : ℕ → K)
    (hQ : Q = Subgroup.closure {x | ∃ k < 6, x = j k}) (hQ2 : IsPGroup 2 Q)
    (hE : Elem f 6) (hfQ : ∀ i < 6, f i ∈ Q)
    (hfΦ : ∀ i < 6, ∃ a < 6, ∃ b < 6,
      f i = j a * j b * (j a)⁻¹ * (j b)⁻¹ ∨ f i = j a * j a)
    (hconj : ∀ k < 6, ∀ i < 6, ∃ c < 64, j k * f i * (j k)⁻¹ = eta f 6 c)
    (hsq : ∀ a < 6, ∃ c < 64, j a * j a = eta f 6 c)
    (hcom : ∀ a < 6, ∀ b < 6, ∃ c < 64, j a * j b * (j a)⁻¹ * (j b)⁻¹ = eta f 6 c) :
    frattiniOf Q = Eg f 6 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Fact (IsPGroup 2 ↥Q) := ⟨hQ2⟩
  have hjQ : ∀ k < 6, j k ∈ Q := fun k hk => hQ ▸ Subgroup.subset_closure ⟨k, hk, rfl⟩
  have hF₀Q : Eg f 6 ≤ Q := (Subgroup.closure_le Q).2 (fun x ⟨i, hi, hx⟩ => hx ▸ hfQ i hi)
  have hmem : ∀ c < 64, eta f 6 c ∈ Eg f 6 := fun c _ => eta_mem_Eg 6 le_rfl c
  have hjN : ∀ k < 6, j k ∈ Subgroup.normalizer (Eg f 6 : Set K) := by
    intro k hk
    refine CFSG.EvenSporadicStandard.Induction.RuSz.mem_normalizer_of_conj_mem (fun x hx => ?_)
    induction hx using Subgroup.closure_induction with
    | mem y hy =>
      obtain ⟨i, hi, rfl⟩ := hy
      obtain ⟨c, hc, h⟩ := hconj k hk i hi
      rw [h]; exact hmem c hc
    | one => simp
    | mul x y _ _ hx hy =>
      have : j k * (x * y) * (j k)⁻¹ = (j k * x * (j k)⁻¹) * (j k * y * (j k)⁻¹) := by group
      rw [this]; exact mul_mem hx hy
    | inv x _ hx =>
      have : j k * x⁻¹ * (j k)⁻¹ = (j k * x * (j k)⁻¹)⁻¹ := by group
      rw [this]; exact inv_mem hx
  have hQN : Q ≤ Subgroup.normalizer (Eg f 6 : Set K) := by
    rw [hQ]
    exact (Subgroup.closure_le _).2 (fun x ⟨k, hk, hx⟩ => hx ▸ hjN k hk)
  haveI hNn : ((Eg f 6).subgroupOf Q).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hF₀Q).2 hQN
  set N := (Eg f 6).subgroupOf Q with hN
  set X : Set ↥Q := (((↑) : ↥Q → K) ⁻¹' {x | ∃ k < 6, x = j k}) with hX
  have hXtop : Subgroup.closure X = ⊤ := by
    subst hQ
    exact Subgroup.closure_closure_coe_preimage
  have hcomm : ∀ a b : ↥Q ⧸ N, a * b = b * a := by
    refine CFSG.Sporadic.RuSchreier.quotient_comm_of_gens N hXtop ?_
    rintro x ⟨a, ha, hxa⟩ y ⟨b, hb, hyb⟩
    obtain ⟨c, hc, h⟩ := hcom a ha b hb
    rw [hN, Subgroup.mem_subgroupOf]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    rw [hxa, hyb, h]; exact hmem c hc
  have hcommq : IsMulCommutative (↥Q ⧸ N) := ⟨⟨hcomm⟩⟩
  have hcommutator : _root_.commutator ↥Q ≤ N :=
    (Subgroup.Normal.quotient_commutative_iff_commutator_le (N := N)).1 hcommq
  have hsqN : ∀ x : ↥Q, (QuotientGroup.mk' N x) ^ 2 = 1 := by
    intro x
    have hx : x ∈ Subgroup.closure X := by rw [hXtop]; trivial
    induction hx using Subgroup.closure_induction with
    | mem y hy =>
      obtain ⟨a, ha, hya⟩ := hy
      obtain ⟨c, hc, h⟩ := hsq a ha
      rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, hN,
        Subgroup.mem_subgroupOf, pow_two]
      simp only [Subgroup.coe_mul]
      rw [hya, h]; exact hmem c hc
    | one => simp
    | mul x y _ _ hx hy =>
      have hc : Commute (QuotientGroup.mk' N x) (QuotientGroup.mk' N y) := hcomm _ _
      rw [map_mul, hc.mul_pow, hx, hy, one_mul]
    | inv x _ hx => simpa [inv_pow] using hx
  have hsqN' : ∀ x : ↥Q, x ^ 2 ∈ N := fun x => by
    have := hsqN x
    rwa [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at this
  have hle : frattini ↥Q ≤ N := by
    rw [CFSG.frattini_eq_closure_commutator_union_powers (p := 2)]
    refine (Subgroup.closure_le N).2 ?_
    rintro x (hx | ⟨y, rfl⟩)
    · exact hcommutator hx
    · exact hsqN' y
  have hge : Eg f 6 ≤ (frattini ↥Q).map Q.subtype := by
    refine (Subgroup.closure_le _).2 ?_
    rintro x ⟨i, hi, rfl⟩
    obtain ⟨a, ha, b, hb, h | h⟩ := hfΦ i hi
    · refine ⟨⁅(⟨j a, hjQ a ha⟩ : ↥Q), ⟨j b, hjQ b hb⟩⁆, ?_, ?_⟩
      · refine CFSG.commutator_le_frattini_of_isPGroup (p := 2) ?_
        rw [_root_.commutator_def]
        exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
      · simp [h, commutatorElement_def]
    · refine ⟨(⟨j a, hjQ a ha⟩ : ↥Q) ^ 2, CFSG.pth_power_mem_frattini_of_isPGroup _, ?_⟩
      simp [h, pow_two]
  show (frattini ↥Q).map Q.subtype = Eg f 6
  apply le_antisymm
  · calc (frattini ↥Q).map Q.subtype ≤ N.map Q.subtype := Subgroup.map_mono hle
      _ = Eg f 6 := Subgroup.map_subgroupOf_eq_of_le hF₀Q
  · exact hge

open CFSG.Sporadic.J4.QT CFSG.ASVolI.ChIJK in
open scoped commutatorElement in
theorem burnsideI22P7_Y_comm {K : Type} [Group K] [Finite K] {Q Y : Subgroup K} (f g : ℕ → K)
    (y₁ y₂ zh : K) (hE : Elem f 6) (hinj : ∀ c, 0 < c → c < 64 → eta f 6 c ≠ 1)
    (hF₀Q : Eg f 6 ≤ Q) (hQcard : Nat.card Q ≤ 4096)
    (hY : Y = Q ⊓ Subgroup.centralizer ((Eg f 6 : Subgroup K) : Set K))
    (hg : ∀ s < 16, g s ∈ Q)
    (hgd : ∀ s < 16, ∀ s' < 16, s ≠ s' → ∃ i < 6, (g s)⁻¹ * g s' * f i ≠ f i * ((g s)⁻¹ * g s'))
    (hy₁ : y₁ ∈ Q) (hy₂ : y₂ ∈ Q) (hy₁c : ∀ i < 6, y₁ * f i = f i * y₁)
    (hy₂c : ∀ i < 6, y₂ * f i = f i * y₂)
    (hzh : y₁ * y₂ * y₁⁻¹ * y₂⁻¹ = zh) (hzh1 : zh ≠ 1) (hzhF : ∃ c < 64, zh = eta f 6 c) :
    ⁅Y, Y⁆ = Subgroup.zpowers zh ∧ Nat.card ↥⁅Y, Y⁆ = 2 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hxor : ∀ i j : ℕ, i ^^^ j = 0 → i = j := fun i j h => by
    calc i = i ^^^ (i ^^^ j) := by rw [h, Nat.xor_zero]
      _ = j := by rw [← Nat.xor_assoc, Nat.xor_self, Nat.zero_xor]
  have hF₀card : Nat.card (Eg f 6) = 2 ^ 6 := by
    refine card_Eg hE (fun c hc d hd hcd => ?_)
    refine hxor c d ?_
    by_contra hne
    have hlt : c ^^^ d < 64 := Nat.xor_lt_two_pow hc hd
    refine hinj (c ^^^ d) (Nat.pos_of_ne_zero hne) hlt ?_
    rw [eta_xor hE le_rfl, hcd]
    exact eta_sq hE d
  have hFc : ∀ x ∈ Eg f 6, ∀ y ∈ Eg f 6, x * y = y * x := fun x hx y hy => Eg_comm hE hx hy
  have hcentr : ∀ y : K, (∀ i < 6, y * f i = f i * y) → ∀ x ∈ Eg f 6, y * x = x * y := by
    intro y hy x hx
    induction hx using Subgroup.closure_induction with
    | mem z hz => obtain ⟨i, hi, rfl⟩ := hz; exact hy i hi
    | one => simp
    | mul a b _ _ ha hb =>
      calc y * (a * b) = (y * a) * b := by group
        _ = a * y * b := by rw [ha]
        _ = a * (y * b) := by group
        _ = a * (b * y) := by rw [hb]
        _ = a * b * y := by group
    | inv a _ ha =>
      have : y * a⁻¹ = a⁻¹ * y := by
        calc y * a⁻¹ = a⁻¹ * (a * y) * a⁻¹ := by group
          _ = a⁻¹ * (y * a) * a⁻¹ := by rw [ha]
          _ = a⁻¹ * y := by group
      exact this
  have hmemY : ∀ y ∈ Q, (∀ i < 6, y * f i = f i * y) → y ∈ Y := by
    intro y hyQ hy
    rw [hY]
    refine ⟨hyQ, Subgroup.mem_centralizer_iff.2 fun x hx => ?_⟩
    exact (hcentr y hy x hx).symm
  have hYcentr : ∀ y ∈ Y, ∀ x ∈ Eg f 6, y * x = x * y := by
    intro y hy x hx
    rw [hY] at hy
    exact (Subgroup.mem_centralizer_iff.1 hy.2 x hx).symm
  have hYQ : Y ≤ Q := by rw [hY]; exact inf_le_left
  have hF₀Y : Eg f 6 ≤ Y := by
    intro x hx
    rw [hY]
    exact ⟨hF₀Q hx, Subgroup.mem_centralizer_iff.2 fun y hy => (hFc x hx y hy).symm⟩
  have hYcard : Nat.card Y ≤ 256 := by
    set Yq : Subgroup ↥Q := Y.subgroupOf Q with hYq
    have hinjq : Function.Injective
        (fun s : Fin 16 => (QuotientGroup.mk (⟨g s, hg s s.2⟩ : ↥Q) : ↥Q ⧸ Yq)) := by
      intro s s' h
      by_contra hne
      have hne' : (s : ℕ) ≠ s' := fun h' => hne (Fin.ext h')
      obtain ⟨i, hi, hni⟩ := hgd s s.2 s' s'.2 hne'
      have h1 := QuotientGroup.eq.1 h
      rw [hYq, Subgroup.mem_subgroupOf] at h1
      have := hYcentr _ h1 (f i) (u_mem_Eg hi)
      exact hni this
    have h16 : 16 ≤ Nat.card (↥Q ⧸ Yq) := by
      have := Nat.card_le_card_of_injective _ hinjq
      simpa using this
    have hidx := Subgroup.index_mul_card Yq
    rw [Subgroup.index] at hidx
    have hcY : Nat.card Yq = Nat.card Y := Nat.card_congr (Subgroup.subgroupOfEquivOfLe hYQ).toEquiv
    rw [hcY] at hidx
    have hpos : 0 < Nat.card Y := Nat.card_pos
    by_contra hbig
    push Not at hbig
    have : 16 * 257 ≤ Nat.card (↥Q ⧸ Yq) * Nat.card Y := Nat.mul_le_mul h16 hbig
    omega
  have hy₁Y : y₁ ∈ Y := hmemY y₁ hy₁ hy₁c
  have hy₂Y : y₂ ∈ Y := hmemY y₂ hy₂ hy₂c
  have hy₁F : y₁ ∉ Eg f 6 := by
    intro h
    apply hzh1
    rw [← hzh]
    have := hcentr y₂ hy₂c y₁ h
    rw [← this]; group
  have hy₂F : y₂ ∉ Eg f 6 := by
    intro h
    apply hzh1
    rw [← hzh]
    have := hcentr y₁ hy₁c y₂ h
    rw [this]; group
  have hnc : y₁ * y₂ ≠ y₂ * y₁ := by
    intro h
    apply hzh1
    rw [← hzh, h]; group
  have hy₁y₂F : y₁ * y₂ ∉ Eg f 6 := by
    intro h
    apply hnc
    have h1 := hcentr y₁ hy₁c _ h
    have h2 : y₁ * (y₁ * y₂) = y₁ * (y₂ * y₁) := by rw [h1]; group
    exact mul_left_cancel h2
  have hy₁inv₂F : y₁⁻¹ * y₂ ∉ Eg f 6 := by
    intro h
    apply hnc
    have h1 := hcentr y₁ hy₁c _ h
    rw [mul_inv_cancel_left] at h1
    calc y₁ * y₂ = y₁ * (y₁⁻¹ * y₂ * y₁) := by rw [← h1]
      _ = y₂ * y₁ := by group
  have hy₂inv₁y₂F : y₂⁻¹ * y₁ * y₂ ∉ Eg f 6 := by
    intro h
    apply hy₁F
    have h1 := hcentr y₂ hy₂c _ h
    have : y₁ = y₂ * (y₂⁻¹ * y₁ * y₂) * y₂⁻¹ := by group
    rw [this, h1]
    have e : (y₂⁻¹ * y₁ * y₂) * y₂ * y₂⁻¹ = y₂⁻¹ * y₁ * y₂ := by group
    rw [e]; exact h
  set k : Set K := (Eg f 6 : Set K) ∪ {y₁, y₂} with hk
  set H : Subgroup K := Subgroup.closure k with hH
  have hkY : k ⊆ Y := by
    intro x hx
    rcases hx with hx | hx
    · exact hF₀Y hx
    · rcases hx with rfl | rfl
      · exact hy₁Y
      · exact hy₂Y
  have hHY : H ≤ Y := (Subgroup.closure_le Y).2 hkY
  have hF₀H : Eg f 6 ≤ H := fun x hx => Subgroup.subset_closure (Or.inl hx)
  have hy₁H : y₁ ∈ H := Subgroup.subset_closure (Or.inr (Or.inl rfl))
  have hy₂H : y₂ ∈ H := Subgroup.subset_closure (Or.inr (Or.inr rfl))
  have hHcard : 256 ≤ Nat.card H := by
    set F₀' : Subgroup ↥H := (Eg f 6).subgroupOf H with hF₀'
    let e : Fin 4 → ↥H := ![1, ⟨y₁, hy₁H⟩, ⟨y₂, hy₂H⟩, ⟨y₁ * y₂, mul_mem hy₁H hy₂H⟩]
    have hlt : ∀ a b : Fin 4, a < b → ((e a : K)⁻¹ * (e b : K)) ∉ Eg f 6 := by
      intro a b hab
      fin_cases a <;> fin_cases b <;> simp [e] at hab ⊢
      · exact hy₁F
      · exact hy₂F
      · exact hy₁y₂F
      · exact hy₁inv₂F
      · simpa using hy₂F
      · simpa [mul_assoc] using hy₂inv₁y₂F
    have hinj4 : Function.Injective (fun s : Fin 4 => (QuotientGroup.mk (e s) : ↥H ⧸ F₀')) := by
      intro a b hab
      by_contra hne
      rcases lt_or_gt_of_ne hne with hlab | hlab
      · have h1 := QuotientGroup.eq.1 hab
        rw [hF₀', Subgroup.mem_subgroupOf] at h1
        exact hlt a b hlab h1
      · have h1 := QuotientGroup.eq.1 hab.symm
        rw [hF₀', Subgroup.mem_subgroupOf] at h1
        exact hlt b a hlab h1
    have h4 : 4 ≤ Nat.card (↥H ⧸ F₀') := by
      have := Nat.card_le_card_of_injective _ hinj4
      simpa using this
    have hidx := Subgroup.index_mul_card F₀'
    rw [Subgroup.index] at hidx
    have hcF : Nat.card F₀' = 64 := by
      rw [hF₀', Nat.card_congr (Subgroup.subgroupOfEquivOfLe hF₀H).toEquiv, hF₀card]; norm_num
    rw [hcF] at hidx
    nlinarith
  have hHeq : H = Y := Subgroup.eq_of_le_of_card_ge hHY (by omega)
  obtain ⟨c₀, hc₀, hzhc⟩ := hzhF
  have hzhE : zh ∈ Eg f 6 := by rw [hzhc]; exact eta_mem_Eg 6 le_rfl c₀
  have hzh2 : zh * zh = 1 := Eg_sq hE hzhE
  have hzhcent : ∀ h ∈ H, h * zh = zh * h := by
    intro h hh
    induction hh using Subgroup.closure_induction with
    | mem x hx =>
      rcases hx with hx | hx
      · exact hFc x hx zh hzhE
      · rcases hx with rfl | rfl
        · exact hcentr _ hy₁c zh hzhE
        · exact hcentr _ hy₂c zh hzhE
    | one => simp
    | mul a b _ _ ha hb =>
      calc a * b * zh = a * (b * zh) := by group
        _ = a * (zh * b) := by rw [hb]
        _ = a * zh * b := by group
        _ = zh * a * b := by rw [ha]
        _ = zh * (a * b) := by group
    | inv a _ ha =>
      calc a⁻¹ * zh = a⁻¹ * (zh * a) * a⁻¹ := by group
        _ = a⁻¹ * (a * zh) * a⁻¹ := by rw [ha]
        _ = zh * a⁻¹ := by group
  have hCH : Subgroup.zpowers zh ≤ H := Subgroup.zpowers_le.2 (hF₀H hzhE)
  haveI hCn : ((Subgroup.zpowers zh).subgroupOf H).Normal := by
    rw [Subgroup.normal_subgroupOf_iff hCH]
    intro c h hc hh
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 hc
    have hz : h * zh * h⁻¹ = zh := by rw [hzhcent h hh]; group
    rw [← conj_zpow, hz]
    exact Subgroup.zpow_mem_zpowers zh n
  set X : Set ↥H := (((↑) : ↥H → K) ⁻¹' k) with hX
  have hXtop : Subgroup.closure X = ⊤ := Subgroup.closure_closure_coe_preimage
  have hone : ∀ a b : K, a * b = b * a → a * b * a⁻¹ * b⁻¹ ∈ Subgroup.zpowers zh := by
    intro a b h
    have : a * b * a⁻¹ * b⁻¹ = 1 := by rw [h]; group
    rw [this]; exact Subgroup.one_mem _
  have hcomm_gen : ∀ a ∈ k, ∀ b ∈ k, a * b * a⁻¹ * b⁻¹ ∈ Subgroup.zpowers zh := by
    intro a ha b hb
    rcases ha with ha | ha | ha
    · rcases hb with hb | hb | hb
      · exact hone _ _ (hFc a ha b hb)
      · rw [hb]; exact hone _ _ (hcentr _ hy₁c a ha).symm
      · rw [hb]; exact hone _ _ (hcentr _ hy₂c a ha).symm
    · rw [ha]
      rcases hb with hb | hb | hb
      · exact hone _ _ (hcentr _ hy₁c b hb)
      · rw [hb]; exact hone _ _ rfl
      · rw [hb, hzh]; exact Subgroup.mem_zpowers zh
    · rw [ha]
      rcases hb with hb | hb | hb
      · exact hone _ _ (hcentr _ hy₂c b hb)
      · have : y₂ * y₁ * y₂⁻¹ * y₁⁻¹ = zh⁻¹ := by rw [← hzh]; group
        rw [hb, this]; exact Subgroup.inv_mem _ (Subgroup.mem_zpowers zh)
      · rw [hb]; exact hone _ _ rfl
  have hcomm : ∀ a b : ↥H ⧸ (Subgroup.zpowers zh).subgroupOf H, a * b = b * a := by
    refine CFSG.Sporadic.RuSchreier.quotient_comm_of_gens _ hXtop ?_
    intro x hx y hy
    rw [Subgroup.mem_subgroupOf]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    exact hcomm_gen _ hx _ hy
  have hYY : ⁅Y, Y⁆ ≤ Subgroup.zpowers zh := by
    rw [← hHeq, Subgroup.commutator_le]
    intro a ha b hb
    have hc := hcomm (QuotientGroup.mk (⟨a, ha⟩ : ↥H)) (QuotientGroup.mk (⟨b, hb⟩ : ↥H))
    have h2 : QuotientGroup.mk ((⟨a, ha⟩ : ↥H) * ⟨b, hb⟩ * ⟨a, ha⟩⁻¹ * ⟨b, hb⟩⁻¹) =
        (1 : ↥H ⧸ (Subgroup.zpowers zh).subgroupOf H) := by
      rw [QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv,
        QuotientGroup.mk_inv, hc]
      group
    have := (QuotientGroup.eq_one_iff _).1 h2
    have h3 := Subgroup.mem_subgroupOf.1 this
    rwa [commutatorElement_def]
  have hzhmem : zh ∈ ⁅Y, Y⁆ := by
    have := Subgroup.commutator_mem_commutator hy₁Y hy₂Y
    rwa [commutatorElement_def, hzh] at this
  have hEq : ⁅Y, Y⁆ = Subgroup.zpowers zh := le_antisymm hYY (Subgroup.zpowers_le.2 hzhmem)
  refine ⟨hEq, ?_⟩
  rw [hEq, Nat.card_zpowers]
  exact orderOf_eq_prime (by rw [pow_two]; exact hzh2) hzh1

theorem burnsideI22P7_isPGroup_five {G : Type*} [Group G] {y : G} (hy5 : y ^ 5 = 1) (hy1 : y ≠ 1) :
    IsPGroup 5 (Subgroup.zpowers y) := by
  haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  refine IsPGroup.of_card (n := 1) ?_
  rw [Nat.card_zpowers]
  have h1 : orderOf y ∣ 5 := orderOf_dvd_of_pow_eq_one hy5
  have h2 : orderOf y ≠ 1 := fun h => hy1 (orderOf_eq_one_iff.1 h)
  rcases (Nat.dvd_prime (by norm_num : Nat.Prime 5)).1 h1 with h | h
  · exact absurd h h2
  · rw [h]; norm_num

theorem burnsideI22P7_invariant_ncard {y : Equiv.Perm (Fin 6)} (hy5 : y ^ 5 = 1)
    {S : Set (Fin 6)} (hS : ∀ s ∈ S, y s ∈ S) (hS' : ∀ s ∈ S, y⁻¹ s ∈ S) {a : Fin 6}
    (ha : a ∈ S) (hya : y a ≠ a) : 5 ≤ S.ncard := by
  haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  set Z : Subgroup (Equiv.Perm (Fin 6)) := Subgroup.zpowers y with hZ
  have hZ5 : IsPGroup 5 Z := burnsideI22P7_isPGroup_five hy5 (fun h => hya (by rw [h]; rfl))
  have hinv : ∀ m : ℤ, ∀ s ∈ S, (y ^ m) s ∈ S := by
    intro m
    induction m using Int.induction_on with
    | zero => intro s hs; simpa using hs
    | succ n ih =>
      intro s hs
      have : (y ^ ((n : ℤ) + 1)) s = (y ^ (n : ℤ)) (y s) := by
        rw [zpow_add_one, Equiv.Perm.mul_apply]
      rw [this]; exact ih _ (hS _ hs)
    | pred n ih =>
      intro s hs
      have : (y ^ (-(n : ℤ) - 1)) s = (y ^ (-(n : ℤ))) (y⁻¹ s) := by
        rw [zpow_sub_one, Equiv.Perm.mul_apply]
      rw [this]; exact ih _ (hS' _ hs)
  have horb : MulAction.orbit Z a ⊆ S := by
    rintro _ ⟨⟨z, hz⟩, rfl⟩
    obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 hz
    exact hinv m a ha
  obtain ⟨n, hn⟩ := hZ5.card_orbit a
  have hle : (MulAction.orbit Z a).ncard ≤ S.ncard := Set.ncard_le_ncard horb (Set.toFinite S)
  have hcard : (MulAction.orbit Z a).ncard = 5 ^ n := by
    rw [← Nat.card_coe_set_eq]; exact hn
  have hmem : y a ∈ MulAction.orbit Z a := ⟨⟨y, Subgroup.mem_zpowers y⟩, rfl⟩
  have hne : 2 ≤ (MulAction.orbit Z a).ncard := by
    have h2 : ({a, y a} : Set (Fin 6)).ncard = 2 := Set.ncard_pair (Ne.symm hya)
    rw [← h2]
    refine Set.ncard_le_ncard ?_ (Set.toFinite _)
    intro x hx
    rcases hx with rfl | rfl
    · exact MulAction.mem_orbit_self _
    · exact hmem
  have hn1 : 1 ≤ n := by
    by_contra h
    have h0 : n = 0 := by omega
    rw [h0] at hcard
    omega
  calc 5 = 5 ^ 1 := by norm_num
    _ ≤ 5 ^ n := Nat.pow_le_pow_right (by norm_num) hn1
    _ = (MulAction.orbit Z a).ncard := hcard.symm
    _ ≤ S.ncard := hle

theorem burnsideI22P7_perm_six_two_group {N : Subgroup (Equiv.Perm (Fin 6))} (hN : IsPGroup 2 N)
    {y : Equiv.Perm (Fin 6)} (hy5 : y ^ 5 = 1) (hy1 : y ≠ 1)
    (hyN : ∀ n ∈ N, y * n * y⁻¹ ∈ N) (hyN' : ∀ n ∈ N, y⁻¹ * n * y ∈ N) : N = ⊥ := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have hZ5 := burnsideI22P7_isPGroup_five hy5 hy1
  set Fy : Set (Fin 6) := {x | y x = x} with hFy
  have hfixy : MulAction.fixedPoints (Subgroup.zpowers y) (Fin 6) = Fy := by
    ext x
    rw [MulAction.mem_fixedPoints]
    constructor
    · intro h
      exact h ⟨y, Subgroup.mem_zpowers y⟩
    · intro h z
      obtain ⟨z, hz⟩ := z
      obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 hz
      exact Equiv.Perm.zpow_apply_eq_self_of_apply_eq_self h m
  have hmod5 := hZ5.card_modEq_card_fixedPoints (Fin 6)
  rw [hfixy, Nat.card_coe_set_eq] at hmod5
  have hFy6 : Fy.ncard ≠ 6 := by
    intro h6
    apply hy1
    have hsub : Fy ⊆ Set.univ := Set.subset_univ _
    have := Set.eq_of_subset_of_ncard_le hsub (by rw [Set.ncard_univ, Nat.card_eq_fintype_card,
      Fintype.card_fin, h6]) (Set.toFinite _)
    refine Equiv.ext fun x => ?_
    have hx : x ∈ Fy := by rw [this]; trivial
    exact hx
  have hFyle : Fy.ncard ≤ 6 := by
    have := Set.ncard_le_card Fy
    rwa [Nat.card_eq_fintype_card, Fintype.card_fin] at this
  have hFy1 : Fy.ncard = 1 := by
    rw [Nat.card_eq_fintype_card, Fintype.card_fin] at hmod5
    unfold Nat.ModEq at hmod5
    omega
  obtain ⟨p, hp⟩ := Set.ncard_eq_one.1 hFy1
  have hpfix : y p = p := by
    have : p ∈ Fy := by rw [hp]; rfl
    exact this
  have hpuniq : ∀ x, y x = x → x = p := by
    intro x hx
    have : x ∈ Fy := hx
    rw [hp] at this
    exact this
  set Fn : Set (Fin 6) := {x | ∀ n ∈ N, n x = x} with hFn
  have hFn_eq : MulAction.fixedPoints N (Fin 6) = Fn := by
    ext x
    rw [MulAction.mem_fixedPoints]
    constructor
    · intro h n hn
      exact h ⟨n, hn⟩
    · intro h n
      exact h n n.2
  have hmod2 := hN.card_modEq_card_fixedPoints (Fin 6)
  rw [hFn_eq, Nat.card_coe_set_eq, Nat.card_eq_fintype_card, Fintype.card_fin] at hmod2
  have hFn_even : Fn.ncard % 2 = 0 := by
    unfold Nat.ModEq at hmod2
    omega
  have hFn_y : ∀ x ∈ Fn, y x ∈ Fn := by
    intro x hx n hn
    have h2 := hx _ (hyN' n hn)
    have h3 : y⁻¹ (n (y x)) = x := by simpa [Equiv.Perm.mul_apply] using h2
    have h4 := congrArg y h3
    have h5 : y (y⁻¹ (n (y x))) = n (y x) := by simp
    rw [h5] at h4
    exact h4
  have hFn_y' : ∀ x ∈ Fn, y⁻¹ x ∈ Fn := by
    intro x hx n hn
    have h2 := hx _ (hyN n hn)
    have h3 : y (n (y⁻¹ x)) = x := by simpa [Equiv.Perm.mul_apply] using h2
    have h4 := congrArg (fun z => y⁻¹ z) h3
    have h5 : y⁻¹ (y (n (y⁻¹ x))) = n (y⁻¹ x) := by simp
    rw [h5] at h4
    exact h4
  by_contra hne
  have hex : ∃ n ∈ N, n ≠ 1 := by
    by_contra h
    push Not at h
    exact hne ((Subgroup.eq_bot_iff_forall N).2 h)
  obtain ⟨n, hnN, hn1⟩ := hex
  obtain ⟨x0, hx0⟩ : ∃ x0, n x0 ≠ x0 := by
    by_contra h
    push Not at h
    exact hn1 (Equiv.ext h)
  by_cases hpF : p ∈ Fn
  ·
    have hx0M : x0 ∈ Fnᶜ := fun h => hx0 (h n hnN)
    have hx0p : x0 ≠ p := fun h => hx0M (h ▸ hpF)
    have hyx0 : y x0 ≠ x0 := fun h => hx0p (hpuniq x0 h)
    have h5 := burnsideI22P7_invariant_ncard hy5 (S := Fnᶜ) (fun s hs h => hs (by
        have := hFn_y' _ h
        simpa using this)) (fun s hs h => hs (by
        have := hFn_y _ h
        simpa using this)) hx0M hyx0
    have hsum := Set.ncard_add_ncard_compl Fn
    rw [Nat.card_eq_fintype_card, Fintype.card_fin] at hsum
    have hpos : 0 < Fn.ncard := (Set.ncard_pos (Set.toFinite _)).2 ⟨p, hpF⟩
    omega
  ·
    obtain ⟨m, hmN, hmp⟩ : ∃ m ∈ N, m p ≠ p := by
      by_contra h
      push Not at h
      exact hpF h
    have hpinv : y⁻¹ p = p := Equiv.Perm.inv_eq_iff_eq.2 hpfix.symm
    set O : Set (Fin 6) := MulAction.orbit N p with hO
    have hOy : ∀ s ∈ O, y s ∈ O := by
      rintro _ ⟨⟨k, hk⟩, rfl⟩
      refine ⟨⟨y * k * y⁻¹, hyN k hk⟩, ?_⟩
      show (y * k * y⁻¹) p = y (k p)
      rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hpinv]
    have hOy' : ∀ s ∈ O, y⁻¹ s ∈ O := by
      rintro _ ⟨⟨k, hk⟩, rfl⟩
      refine ⟨⟨y⁻¹ * k * y, hyN' k hk⟩, ?_⟩
      show (y⁻¹ * k * y) p = y⁻¹ (k p)
      rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hpfix]
    have hbO : m p ∈ O := ⟨⟨m, hmN⟩, rfl⟩
    have hyb : y (m p) ≠ m p := fun h => hmp (hpuniq _ h)
    have h5 := burnsideI22P7_invariant_ncard hy5 hOy hOy' hbO hyb
    obtain ⟨k, hk⟩ := hN.card_orbit p
    have hk' : O.ncard = 2 ^ k := by rw [← Nat.card_coe_set_eq]; exact hk
    have h6 : O.ncard ≤ 6 := by
      have := Set.ncard_le_card O
      rwa [Nat.card_eq_fintype_card, Fintype.card_fin] at this
    rcases Nat.lt_or_ge k 3 with hk3 | hk3
    · interval_cases k <;> omega
    · have : 2 ^ 3 ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) hk3
      omega

open CFSG.EvenSporadicStandard.TwoRu.CentCover CFSG.Sporadic.RuSchreier in
theorem burnsideI22P7_evalSigned_invW {G : Type*} [Group G] (gens : List G) :
    ∀ w : List ℤ, (∀ l ∈ w, l ≠ 0) → evalSigned gens (invW w) = (evalSigned gens w)⁻¹
  | [], _ => by simp [invW, evalSigned]
  | l :: w, hw => by
    have hl : l ≠ 0 := hw l (List.mem_cons_self ..)
    have hw' : ∀ l ∈ w, l ≠ 0 := fun x hx => hw x (List.mem_cons_of_mem _ hx)
    have h1 : invW (l :: w) = invW w ++ [-l] := by simp [invW]
    have h2 : evalSigned gens [-l] = (evalSigned gens [l])⁻¹ := by
      rw [evalSigned_cons, evalSigned_cons, evalSigned_nil, mul_one, mul_one, Int.natAbs_neg]
      by_cases hpos : 0 < l
      · have hn : ¬ 0 < -l := by omega
        rw [if_pos hpos, if_neg hn]
      · have hn : 0 < -l := by omega
        rw [if_neg hpos, if_pos hn, inv_inv]
    have h3 : evalSigned gens [l] * evalSigned gens w = evalSigned gens (l :: w) := by
      rw [evalSigned_cons gens l [], evalSigned_nil, mul_one, evalSigned_cons gens l w]
    rw [h1, evalSigned_append, burnsideI22P7_evalSigned_invW gens w hw', h2, ← mul_inv_rev, h3]

open CFSG.Sporadic.RuSchreier in
theorem burnsideI22P7_evalSigned_replicate {G : Type*} [Group G] (gens : List G) (m : ℕ) :
    evalSigned gens (List.replicate m 1) = gens.getD 0 1 ^ m := by
  induction m with
  | zero => simp [evalSigned]
  | succ m ih =>
    rw [List.replicate_succ, evalSigned_cons, ih, pow_succ']
    simp

open CFSG.EvenSporadicStandard.TwoRu.CentCover in
theorem burnsideI22P7_ne_zero_of_lettersOK {j : ℕ} {w : List ℤ}
    (h : CFSG.Monster.B.Co2.Native.lettersOK j w = true) : ∀ l ∈ w, l ≠ 0 := by
  intro l hl
  unfold CFSG.Monster.B.Co2.Native.lettersOK at h
  have := List.all_eq_true.1 h l hl
  simp only [Bool.and_eq_true, bne_iff_ne, ne_eq, decide_eq_true_eq] at this
  exact this.1

theorem burnsideI22P7_lettersOK_append {j : ℕ} {u v : List ℤ} :
    CFSG.Monster.B.Co2.Native.lettersOK j (u ++ v) =
      (CFSG.Monster.B.Co2.Native.lettersOK j u && CFSG.Monster.B.Co2.Native.lettersOK j v) := by
  simp [CFSG.Monster.B.Co2.Native.lettersOK, List.all_append]

open CFSG.EvenSporadicStandard.TwoRu.CentCover in
theorem burnsideI22P7_lettersOK_invW {j : ℕ} {w : List ℤ} :
    CFSG.Monster.B.Co2.Native.lettersOK j (invW w) = CFSG.Monster.B.Co2.Native.lettersOK j w := by
  unfold CFSG.Monster.B.Co2.Native.lettersOK invW
  rw [List.all_map, List.all_reverse]
  congr 1
  funext l
  show (-l != 0 && decide ((-l).natAbs ≤ j)) = (l != 0 && decide (l.natAbs ≤ j))
  rw [Int.natAbs_neg]
  by_cases hl : l = 0
  · subst hl; simp
  · rw [bne_iff_ne.2 (neg_ne_zero.2 hl), bne_iff_ne.2 hl]

open CFSG.Monster.B.Co2 CFSG.Monster.B.Co2.Native in
structure burnsideI22P7_Ctx {K : Type} [Group K] (ψ : K →* Equiv.Perm (Fin 16240)) (c0 c1 : K)
    (A B : Array ℕ) : Prop where
  inj : Function.Injective ψ
  repA : Rep 16240 A (ψ c0)
  repB : Rep 16240 B (ψ c1)
