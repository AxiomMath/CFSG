open CFSG.Sporadic.RuSchreier in
theorem burnsideI22P7_sq_eq_one_of_mem_ruZP
    {K : Type} [Group K] [Finite K] [Group.IsPerfect K] {q : K →* ruP}
    (hq : Function.Surjective q) {t : K} (ht : orderOf t = 2) (hker : q.ker = Subgroup.zpowers t)
    (hcen : Subgroup.zpowers t ≤ Subgroup.center K) {x : K}
    (hx : ((q x : ruP) : Equiv.Perm (Fin 4060)) ∈ ruZP) : x ^ 2 = 1 := by
  obtain ⟨v, hv2, hv⟩ := burnsideI22P7_exists_involution_lift_z hq ht hker hcen
  obtain ⟨g, hg, hgx⟩ := hx
  obtain ⟨g', hg'⟩ := hq ⟨g, hg⟩
  have hqw : q (g' * v * g'⁻¹) = q x := by
    rw [map_mul, map_mul, map_inv, hg', hv]
    exact Subtype.ext hgx
  have hmem : x * (g' * v * g'⁻¹)⁻¹ ∈ q.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hqw, mul_inv_cancel]
  rw [hker] at hmem
  have hw2 : (g' * v * g'⁻¹) ^ 2 = 1 := by
    rw [conj_pow, hv2]; group
  have htc : ∀ y : K, y * t = t * y := fun y => Subgroup.mem_center_iff.1 (hcen (Subgroup.mem_zpowers t)) y
  have ht2 : t ^ 2 = 1 := by rw [← ht]; exact pow_orderOf_eq_one t
  rcases CFSG.EvenSporadicStandard.TwoRu.eq_one_or_eq_of_mem_zpowers ht hmem with h1 | h1
  · have : x = g' * v * g'⁻¹ := by
      have := h1; rw [mul_inv_eq_one] at this; exact this
    rw [this]; exact hw2
  · have hxt : x = t * (g' * v * g'⁻¹) :=
      calc x = (x * (g' * v * g'⁻¹)⁻¹) * (g' * v * g'⁻¹) := by group
        _ = t * (g' * v * g'⁻¹) := by rw [h1]
    set w : K := g' * v * g'⁻¹ with hw
    rw [hxt, pow_two]
    calc t * w * (t * w) = t * (w * t) * w := by group
      _ = t * (t * w) * w := by rw [htc w]
      _ = t ^ 2 * w ^ 2 := by simp only [pow_two, mul_assoc]
      _ = 1 := by rw [ht2, hw2, one_mul]

