  obtain ⟨q₀, hq₀⟩ := burnsideI22P3_pres_of_equiv e
  obtain ⟨g, hgS, Pk, hPk, hP⟩ := burnsideI22P3_parabolic hq₀ hZ2 hPs
  set q : K →* Equiv.Perm (Fin 42) := (MulAut.conj g).toMonoidHom.comp q₀ with hqdef
  have hq : burnsideI22P3_Pres q := burnsideI22P3_pres_conj hq₀ hgS
  obtain ⟨l, hQ⟩ := burnsideI22P3_qsetting hq hK.1.commutator_eq_top hZ2
  rcases hP with hP | hP
  · refine ⟨q, l, Pk, P1, U1, U2, hq, hQ, hPk, burnsideI22P3_datum1, hP, ?_, ?_, ?_⟩
    · rw [hP]
      exact burnsideI22P3_pCore_eq hq burnsideI22P3_datum1 Pk hPk
    · exact burnsideI22P3_nonab1 hQ
    · exact fun hk2 => ⟨burnsideI22P3_elem1 hQ hk2, burnsideI22P3_elem2 hQ hk2⟩
  · refine ⟨q, l, Pk, P2, U2, U1, hq, hQ, hPk, burnsideI22P3_datum2, hP, ?_, ?_, ?_⟩
    · rw [hP]
      exact burnsideI22P3_pCore_eq hq burnsideI22P3_datum2 Pk hPk
    · exact burnsideI22P3_nonab2 hQ
    · exact fun hk2 => ⟨burnsideI22P3_elem2 hQ hk2, burnsideI22P3_elem1 hQ hk2⟩

