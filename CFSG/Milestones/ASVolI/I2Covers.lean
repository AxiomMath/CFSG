    rw [pow_two]
    exact ha2
  have hP : IsPGroup 2 ↥(Subgroup.zpowers a) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hord]; norm_num)
  obtain ⟨Q, hQ⟩ := hP.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq S sylowT0 Q
  refine ⟨g, g.2, ?_⟩
