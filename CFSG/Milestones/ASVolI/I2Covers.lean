theorem burnsideI22P46_comm_of_sq {G : Type*} [Group G] (V : Subgroup G) (hsq : ∀ v ∈ V, v * v = 1)
    {a b : G} (ha : a ∈ V) (hb : b ∈ V) : a * b = b * a := by
  have ha2 := hsq a ha
  have hb2 := hsq b hb
  have hab := hsq _ (V.mul_mem ha hb)
  have ha' : a⁻¹ = a := inv_eq_of_mul_eq_one_right ha2
  have hb' : b⁻¹ = b := inv_eq_of_mul_eq_one_right hb2
  have hab' : (a * b)⁻¹ = a * b := inv_eq_of_mul_eq_one_right hab
  calc a * b = (a * b)⁻¹ := hab'.symm
    _ = b⁻¹ * a⁻¹ := mul_inv_rev _ _
    _ = b * a := by rw [ha', hb']

