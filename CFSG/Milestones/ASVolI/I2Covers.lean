theorem burnsideI22P7_szHom {X : Type*} [Group X] {g : Fin 2 → SzB}
    (hP : IsPresentation g (wordSet rels)) {s t : X}
    (hrel : ∀ r ∈ wordSet rels, FreeGroup.lift (fun i : Fin 2 => img2 s t i.val) r = 1) :
    ∃ θ : SzB →* X, θ (g 0) = s ∧ θ (g 1) = t := by
  set f : FreeGroup (Fin 2) →* SzB := FreeGroup.lift g with hf
  set ψ : FreeGroup (Fin 2) →* X := FreeGroup.lift (fun i : Fin 2 => img2 s t i.val) with hψ
  have hsurj : Function.Surjective f := hP.lift_surjective
  have hle : f.ker ≤ ψ.ker := by
    rw [hP.ker_lift]
    exact Subgroup.normalClosure_le_normal fun r hr => MonoidHom.mem_ker.2 (hrel r hr)
  let θ : SzB →* X := MonoidHom.liftOfSurjective f hsurj ⟨ψ, hle⟩
  have hcomp : ∀ x, θ (f x) = ψ x := fun x =>
    MonoidHom.liftOfRightInverse_comp_apply _ _ _ ⟨ψ, hle⟩ x
  have hg : ∀ i : Fin 2, θ (g i) = img2 s t i.val := by
    intro i
    have := hcomp (FreeGroup.of i)
    simpa [hf, hψ] using this
  exact ⟨θ, by simpa [img2] using hg 0, by simpa [img2] using hg 1⟩

open Subgroup CFSG.Sporadic.Bridge CFSG.Sporadic.Bridge.TwoGen CFSG.LieType.Multipliers
