theorem burnsideI22P7_clause_b
    {K : Type} [Group K] [Finite K] (hK : CFSG.IsQuasisimple K) (hZ : Subgroup.center K ≠ ⊥)
    (hRu : NativeSporadic.IsSporadic (K ⧸ Subgroup.center K) .Ru)
