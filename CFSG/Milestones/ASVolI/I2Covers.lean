  have hS0mem : ∀ g, g ∈ covData.tab.sub covData.x hT ↔ i22InS g := fun g => CayTab.mem_sub
  set S0 : Subgroup (Equiv.Perm (Fin 22)) := covData.tab.sub covData.x hT with hS0def
