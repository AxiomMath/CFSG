      ∀ x ∈ Subgroup.comap q U, x * x = 1 := by
  have hdec : ∀ x ∈ Subgroup.comap q U, ∃ k < 64, inU k ∧ ∃ z ∈ q.ker,
      x = l (cv (tw k)) * z := by
    intro x hx
    obtain ⟨k, hk, hUk, hkx⟩ := hU (q x) hx
    refine ⟨k, hk, hUk, (l (cv (tw k)))⁻¹ * x, ?_, by group⟩
    rw [MonoidHom.mem_ker, map_mul, map_inv, h.q_lift hk, hkx, inv_mul_cancel]
  have hc : ∀ z ∈ q.ker, ∀ g : E, g * z = z * g := fun z hz g =>
    Subgroup.mem_center_iff.1 (h.ker_le hz) g
  refine ⟨fun x hx y hy => ?_, fun x hx => ?_⟩
  · obtain ⟨k, hk64, hk, z, hz, rfl⟩ := hdec x hx
    obtain ⟨k', hk64', hk', w, hw, rfl⟩ := hdec y hy
    obtain ⟨d, hd, rfl, rfl⟩ := hcom k hk64 k' hk64' hk hk'
    have hab := burnsideI22P3_lift_comm h hk2 hd
    generalize l (cv (tw d.1)) = a at hab ⊢
    generalize l (cv (tw d.2.1)) = b at hab ⊢
    calc a * z * (b * w) = a * (z * b) * w := by group
      _ = a * (b * z) * w := by rw [← hc z hz b]
      _ = (a * b) * (z * w) := by group
      _ = (b * a) * (w * z) := by rw [hab, hc w hw z]
      _ = b * (a * w) * z := by group
      _ = b * (w * a) * z := by rw [← hc w hw a]
      _ = b * w * (a * z) := by group
  · obtain ⟨k, hk64, hk, z, hz, rfl⟩ := hdec x hx
    have ha := burnsideI22P3_lift_sq h hk2 (hsq k hk64 hk)
    have hz2 := hk2 z hz
    generalize l (cv (tw k)) = a at ha ⊢
    calc a * z * (a * z) = a * (z * a) * z := by group
      _ = a * (a * z) * z := by rw [← hc z hz a]
      _ = (a * a) * (z * z) := by group
      _ = 1 := by rw [ha, hz2, one_mul]

