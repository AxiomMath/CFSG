theorem burnsideI22P3_b3_core {K : Type} [Group K] [Finite K] {q : K →* Equiv.Perm (Fin 42)}
    (hq : burnsideI22P3_Pres q) {P U V : Subgroup (Equiv.Perm (Fin 42))}
    (hD : burnsideI22P3_Datum P U V) (Pk : Sylow 2 K)
    (hPk : ∀ x, q x ∈ T0 ↔ x ∈ (Pk : Subgroup K)) (hZ2 : IsPGroup 2 (Subgroup.center K))
    (hperf : commutator K = ⊤)
    (hVab : ∀ x ∈ Subgroup.comap q V, ∀ y ∈ Subgroup.comap q V, x * y = y * x) :
    ⁅Subgroup.comap q U, Subgroup.comap q P⁆ = Subgroup.comap q U := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set Pc : Subgroup K := Subgroup.comap q P with hPc
  set R : Subgroup K := Subgroup.comap q U with hR
  set RV : Subgroup K := Subgroup.comap q V with hRV
  set D : Subgroup K := ⁅R, Pc⁆ with hDdef
  have hT0S : T0 ≤ S := T0_le_S
  have hRPc : R ≤ Pc := fun x hx => hD.TP (hD.UT hx)
  have hRVPc : RV ≤ Pc := fun x hx => hD.TP (hD.VT hx)
  have hker : ∀ z : K, z ∈ Subgroup.center K → q z = 1 := fun z hz => by
    have : z ∈ q.ker := by rw [hq.ker]; exact hz
    exact this
  have hZR : Subgroup.center K ≤ R := fun z hz => by
    rw [hR, Subgroup.mem_comap, hker z hz]
    exact U.one_mem
  have hZRV : Subgroup.center K ≤ RV := fun z hz => by
    rw [hRV, Subgroup.mem_comap, hker z hz]
    exact V.one_mem
  have hPcN : Pc ≤ Subgroup.normalizer (R : Set K) := fun g hg => by
    rw [Subgroup.mem_normalizer_iff]
    intro h
    have hgP : q g ∈ P := hg
    constructor
    · intro hh
      have := hD.Un _ hgP _ hh
      rw [hR, Subgroup.mem_comap, map_mul, map_mul, map_inv]
      exact this
    · intro hh
      have hh' : q g * q h * (q g)⁻¹ ∈ U := by
        have := hh
        rw [hR, Subgroup.mem_comap, map_mul, map_mul, map_inv] at this
        exact this
      have := hD.Un _ (P.inv_mem hgP) _ hh'
      rw [show (q g)⁻¹ * (q g * q h * (q g)⁻¹) * (q g)⁻¹⁻¹ = q h by group] at this
      rw [hR, Subgroup.mem_comap]
      exact this
  have hDR : D ≤ R := (Subgroup.le_normalizer_iff_commutator_le_left).1 hPcN
  have hDn : ∀ c ∈ Pc, ∀ d ∈ D, c * d * c⁻¹ ∈ D := fun c hc d hd =>
    (Subgroup.mem_normalizer_iff.1 (Subgroup.normalizer_commutator_ge_right (H₁ := R) (H₂ := Pc)
      hc) d).1 hd
  have hdecomp : ∀ x ∈ (Pk : Subgroup K), ∃ r ∈ R, ∃ s ∈ RV, x = r * s := by
    intro x hx
    obtain ⟨u, hu, v, hv, huv⟩ := hD.Prod (q x) ((hPk x).2 hx)
    obtain ⟨a, ha⟩ := hq.surj u (hT0S (hD.UT hu))
    obtain ⟨b, hb⟩ := hq.surj v (hT0S (hD.VT hv))
    have hz : (a * b)⁻¹ * x ∈ Subgroup.center K := by
      rw [← hq.ker, MonoidHom.mem_ker, map_mul, map_inv, map_mul, ha, hb, ← huv, inv_mul_cancel]
    refine ⟨a, ?_, b * ((a * b)⁻¹ * x), ?_, by group⟩
    · rw [hR, Subgroup.mem_comap, ha]; exact hu
    · rw [hRV, Subgroup.mem_comap, map_mul, hb, hker _ hz, mul_one]; exact hv
  have hZD : Subgroup.center K ≤ D := by
    intro z hz
    have hzPk : z ∈ (Pk : Subgroup K) := hZ2.le_sylow_of_normal Pk hz
    have hT := CFSG.Goldschmidt75.mem_commutator_of_mem_center Pk hz hzPk (by rw [hperf]; trivial)
    refine (Subgroup.commutator_le.2 (fun x hx y hy => ?_)) hT
    obtain ⟨r₁, hr₁, s₁, hs₁, rfl⟩ := hdecomp x hx
    obtain ⟨r₂, hr₂, s₂, hs₂, rfl⟩ := hdecomp y hy
    have hs : s₂ * s₁⁻¹ = s₁⁻¹ * s₂ := by
      have := hVab s₁ hs₁ s₂ hs₂
      calc s₂ * s₁⁻¹ = s₁⁻¹ * (s₁ * s₂) * s₁⁻¹ := by group
        _ = s₁⁻¹ * (s₂ * s₁) * s₁⁻¹ := by rw [this]
        _ = s₁⁻¹ * s₂ := by group
    have key : ⁅r₁ * s₁, r₂ * s₂⁆ = r₁ * ⁅s₁, r₂⁆ * r₁⁻¹ * ⁅r₁, r₂ * s₂⁆ := by
      simp only [commutatorElement_def]
      calc r₁ * s₁ * (r₂ * s₂) * (r₁ * s₁)⁻¹ * (r₂ * s₂)⁻¹
          = r₁ * s₁ * r₂ * (s₂ * s₁⁻¹) * r₁⁻¹ * s₂⁻¹ * r₂⁻¹ := by group
        _ = r₁ * s₁ * r₂ * (s₁⁻¹ * s₂) * r₁⁻¹ * s₂⁻¹ * r₂⁻¹ := by rw [hs]
        _ = _ := by group
    have hA : ⁅s₁, r₂⁆ ∈ D := by
      rw [← commutatorElement_inv]
      exact D.inv_mem (Subgroup.commutator_mem_commutator hr₂ (hRVPc hs₁))
    have hB : ⁅r₁, r₂ * s₂⁆ ∈ D :=
      Subgroup.commutator_mem_commutator hr₁ (Pc.mul_mem (hRPc hr₂) (hRVPc hs₂))
    rw [key]
    exact D.mul_mem (by simpa [mul_assoc] using hDn r₁ (hRPc hr₁) _ hA) hB
  have hUD : ∀ v ∈ U, ∃ d ∈ D, q d = v := by
    obtain ⟨u₀, hu₀, t₀, ht₀, hnc⟩ := hD.NC
    obtain ⟨a, ha⟩ := hq.surj u₀ (hT0S (hD.UT hu₀))
    obtain ⟨b, hb⟩ := hq.surj t₀ (hT0S ht₀)
    have haR : a ∈ R := by rw [hR, Subgroup.mem_comap, ha]; exact hu₀
    have hbPc : b ∈ Pc := by rw [hPc, Subgroup.mem_comap, hb]; exact hD.TP ht₀
    have hc₀ : ⁅a, b⁆ ∈ D := Subgroup.commutator_mem_commutator haR hbPc
    have hqc₀ : q ⁅a, b⁆ = ⁅u₀, t₀⁆ := by
      rw [map_commutatorElement, ha, hb]
    have hu₁ : ⁅u₀, t₀⁆ ∈ U := by
      have h1 := hD.Un t₀ (hD.TP ht₀) u₀⁻¹ (U.inv_mem hu₀)
      rw [commutatorElement_def, show u₀ * t₀ * u₀⁻¹ * t₀⁻¹ = u₀ * (t₀ * u₀⁻¹ * t₀⁻¹) by group]
      exact U.mul_mem hu₀ h1
    have hu₁ne : ⁅u₀, t₀⁆ ≠ 1 := fun h => hnc (commutatorElement_eq_one_iff_mul_comm.1 h)
    intro v hv
    by_cases hv1 : v = 1
    · exact ⟨1, D.one_mem, by rw [map_one, hv1]⟩
    · obtain ⟨g, hg, hgv⟩ := hD.Trans _ hu₁ hu₁ne v hv hv1
      obtain ⟨c, hc⟩ := hq.surj g (hD.PS hg)
      have hcPc : c ∈ Pc := by rw [hPc, Subgroup.mem_comap, hc]; exact hg
      refine ⟨c * ⁅a, b⁆ * c⁻¹, hDn c hcPc _ hc₀, ?_⟩
      rw [map_mul, map_mul, map_inv, hc, hqc₀, hgv]
  refine le_antisymm hDR (fun x hx => ?_)
  obtain ⟨d, hd, hdx⟩ := hUD (q x) hx
  have hz : d⁻¹ * x ∈ Subgroup.center K := by
    rw [← hq.ker, MonoidHom.mem_ker, map_mul, map_inv, hdx, inv_mul_cancel]
  have : x = d * (d⁻¹ * x) := by group
  rw [this]
  exact D.mul_mem hd (hZD hz)

