  have hφsig : ∀ v, X.φ (sig covData.tab xt v) = i22el v := fun v => phi_sig X xt hxt covData.tab v
  have htc : ∀ x : L, x * t = t * x := fun x => (hc.t_central x).symm
  have hker : ∀ x : L, X.φ x = 1 ↔ x = 1 ∨ x = t := fun x => ⟨X.ker x, fun hx' => by
    rcases hx' with rfl | rfl
    · exact map_one _
    · exact X.φ_ζ⟩
  have hrangeφ : X.φ.range = NativeSporadic.M22 := by
    ext y
    constructor
    · rintro ⟨e', rfl⟩
