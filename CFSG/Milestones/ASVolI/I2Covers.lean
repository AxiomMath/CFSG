        intro a b hab
        have hab := QuotientGroup.leftRel_apply.1 hab
        have hab' : ((a : K)⁻¹ * b) ∈ C := by simpa [Subgroup.mem_subgroupOf] using hab
        have h1 := (hmemC _).1 hab'
