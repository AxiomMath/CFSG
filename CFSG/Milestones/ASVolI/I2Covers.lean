        exact ⟨covData.tab.tgt 0 i, hT.tgt_lt 0 hT.zero_lt i, h1⟩
      obtain ⟨v, hv, hvx⟩ := hxS0
      have hzc : covData.x i * i22zP = i22zP * covData.x i := by
        rw [← hvx]
        exact (hzcomm v hv).symm
      exact burnsideI22P46_comm_invol hker hc.mul_self_t htc hnsq hg2 hy2'
        (by rw [hxt i, hφy]; exact hzc)
  set y : L := sig covData.tab xt 79 * sig covData.tab xt 79 with hydef
  have hsigy : ∀ w : List (Fin 3), (w.map xt).prod * y = y * (w.map xt).prod := by
    intro w
    induction w with
    | nil => simp
    | cons i w ih =>
      simp only [List.map_cons, List.prod_cons]
      calc xt i * (w.map xt).prod * y = xt i * ((w.map xt).prod * y) := by group
        _ = xt i * (y * (w.map xt).prod) := by rw [ih]
        _ = (xt i * y) * (w.map xt).prod := by group
        _ = (y * xt i) * (w.map xt).prod := by rw [hxy i]
        _ = y * (xt i * (w.map xt).prod) := by group
  have hSy : ∀ p : L, X.φ p ∈ covData.tab.sub covData.x hT → p * y = y * p := by
    intro p hp
    obtain ⟨v, hv, hvp⟩ := hp
