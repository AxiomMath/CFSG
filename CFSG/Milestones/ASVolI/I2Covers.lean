  t_ne : t ≠ 1
  center : ∀ x ∈ Subgroup.center K, x = 1 ∨ x = t
  ker : ∀ x, φ x = 1 ↔ x = 1 ∨ x = t
  y_sq : y * y = 1
  S0_range : S0 ≤ φ.range
  S0_card : Nat.card S0 = 128
  S0_cent : ∀ s ∈ S0, s * φ y = φ y * s
  Sy : ∀ p : K, φ p ∈ S0 → p * y = y * p
  Cs_card : Nat.card ↥(φ.range ⊓ Subgroup.centralizer ({φ y} : Set (Equiv.Perm (Fin 22)))) = 384
  h_range : h ∈ φ.range
  h_cent : h * φ y = φ y * h
  h_cube : h * h * h = 1
  h_ne : h ≠ 1
  Al_root : ∀ g ∈ Al, g * g = φ y
  Al_sq : ∀ g ∈ Al, ∀ p : K, φ p = g → p * p = y
  Ns_le : Ns ≤ S0
  Ns_S0 : ∀ s ∈ S0, ∀ n ∈ Ns, s * n * s⁻¹ ∈ Ns
  Ns_h : ∀ n ∈ Ns, h * n * h⁻¹ ∈ Ns
  a_mem : a ∈ Ns
  a_comm : a * h * a⁻¹ * h⁻¹ ∈ Al
  uniq : ∀ g ∈ S0, g * g = φ y → h⁻¹ * g * h ∈ S0 → g ∈ Al

section BData

variable {K : Type} [Group K] {t y : K} {φ : K →* Equiv.Perm (Fin 22)}
  {S0 : Subgroup (Equiv.Perm (Fin 22))} {h a : Equiv.Perm (Fin 22)}
  {Al : Set (Equiv.Perm (Fin 22))} {Ns : Subgroup (Equiv.Perm (Fin 22))}

theorem burnsideI22P46_BData.orderOf_h (D : burnsideI22P46_BData t y φ S0 h a Al Ns) :
    orderOf h = 3 := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact orderOf_eq_prime (by simpa [pow_succ] using D.h_cube) D.h_ne

theorem burnsideI22P46_BData.h_not_mem (D : burnsideI22P46_BData t y φ S0 h a Al Ns) :
    h ∉ S0 := by
  intro hh
  have := Subgroup.orderOf_dvd_natCard S0 hh
  rw [D.orderOf_h, D.S0_card] at this
  omega

theorem burnsideI22P46_BData.Cs_eq (D : burnsideI22P46_BData t y φ S0 h a Al Ns) :
    Subgroup.closure ((S0 : Set (Equiv.Perm (Fin 22))) ∪ {h}) =
      φ.range ⊓ Subgroup.centralizer ({φ y} : Set (Equiv.Perm (Fin 22))) := by
  set Cs := φ.range ⊓ Subgroup.centralizer ({φ y} : Set (Equiv.Perm (Fin 22))) with hCs
  have hS0Cs : S0 ≤ Cs := fun s hs => ⟨D.S0_range hs, Subgroup.mem_centralizer_singleton_iff.2
    (D.S0_cent s hs)⟩
  have hhCs : h ∈ Cs := ⟨D.h_range, Subgroup.mem_centralizer_singleton_iff.2 D.h_cent⟩
  have hle : Subgroup.closure ((S0 : Set (Equiv.Perm (Fin 22))) ∪ {h}) ≤ Cs := by
    rw [Subgroup.closure_le]
    rintro g (hg | hg)
    · exact hS0Cs hg
    · rw [Set.mem_singleton_iff] at hg; rw [hg]; exact hhCs
  set Dd := Subgroup.closure ((S0 : Set (Equiv.Perm (Fin 22))) ∪ {h}) with hDd
  have hS0D : S0 ≤ Dd := fun s hs => Subgroup.subset_closure (Or.inl hs)
  have hhD : h ∈ Dd := Subgroup.subset_closure (Or.inr rfl)
  have h1 : 128 ∣ Nat.card Dd := D.S0_card ▸ Subgroup.card_dvd_of_le hS0D
  have h2 : Nat.card Dd ∣ 384 := D.Cs_card ▸ Subgroup.card_dvd_of_le hle
  have hne : Nat.card Dd ≠ 128 := by
    intro h128
    have := Subgroup.eq_of_le_of_card_ge hS0D (by rw [D.S0_card, h128])
    exact D.h_not_mem (this ▸ hhD)
  have h384 : Nat.card Dd = 384 := by
    obtain ⟨m, hm⟩ := h1
    have hm3 : m ∣ 3 := by
      have : 128 * m ∣ 128 * 3 := by rw [← hm]; exact h2
      exact Nat.dvd_of_mul_dvd_mul_left (by norm_num) this
    rcases (Nat.dvd_prime Nat.prime_three).1 hm3 with rfl | rfl
    · exact absurd hm (by omega)
    · omega
  exact Subgroup.eq_of_le_of_card_ge hle (by rw [h384, D.Cs_card])

theorem burnsideI22P46_BData.exists_lift (D : burnsideI22P46_BData t y φ S0 h a Al Ns) :
    ∃ g : K, φ g = h ∧ g * g * g = 1 := by
  obtain ⟨g, hg⟩ := D.h_range
  refine ⟨g ^ 4, ?_, ?_⟩
  · rw [map_pow, hg]
    calc h ^ 4 = h * (h * h * h) := by simp only [pow_succ, pow_zero, one_mul, mul_assoc]
      _ = h := by rw [D.h_cube, mul_one]
  · have h3 : φ (g ^ 3) = 1 := by
      rw [map_pow, hg]
      calc h ^ 3 = h * h * h := by simp only [pow_succ, pow_zero, one_mul]
        _ = 1 := D.h_cube
    rcases (D.ker _).1 h3 with h1 | h1
    · calc g ^ 4 * g ^ 4 * g ^ 4 = (g ^ 3) ^ 4 := by group
        _ = 1 := by rw [h1]; simp
    · calc g ^ 4 * g ^ 4 * g ^ 4 = (g ^ 3) ^ 4 := by group
        _ = (t * t) * (t * t) := by rw [h1]; simp only [pow_succ, pow_zero, one_mul, mul_assoc]
        _ = 1 := by rw [D.t_sq]; simp

theorem burnsideI22P46_BData.cube_cent (D : burnsideI22P46_BData t y φ S0 h a Al Ns) {g : K}
    (hg3 : g * g * g = 1) (hgz : φ g * φ y = φ y * φ g) : g * y = y * g := by
  have hzc : φ (g * y * g⁻¹ * y⁻¹) = 1 := by
    simp only [map_mul, map_inv]
    calc φ g * φ y * (φ g)⁻¹ * (φ y)⁻¹ = (φ y * φ g) * (φ g)⁻¹ * (φ y)⁻¹ := by rw [hgz]
      _ = 1 := by group
  rcases (D.ker _).1 hzc with h1 | h1
  · calc g * y = (g * y * g⁻¹ * y⁻¹) * (y * g) := by group
      _ = y * g := by rw [h1, one_mul]
  · exfalso
    have htc : ∀ x : K, x * t = t * x := fun x => Subgroup.mem_center_iff.1 D.t_central x
    have h2 : g * y * g⁻¹ = t * y := by
      calc g * y * g⁻¹ = (g * y * g⁻¹ * y⁻¹) * y := by group
        _ = t * y := by rw [h1]
    have h3 : g * (t * y) * g⁻¹ = y := by
      calc g * (t * y) * g⁻¹ = (g * t) * y * g⁻¹ := by group
        _ = (t * g) * y * g⁻¹ := by rw [htc g]
        _ = t * (g * y * g⁻¹) := by group
        _ = t * (t * y) := by rw [h2]
        _ = (t * t) * y := by group
        _ = y := by rw [D.t_sq, one_mul]
    have h4 : y = t * y := by
      calc y = (g * g * g) * y * (g * g * g)⁻¹ := by rw [hg3]; group
        _ = g * (g * (g * y * g⁻¹) * g⁻¹) * g⁻¹ := by group
        _ = t * y := by rw [h2, h3, h2]
    apply D.t_ne
    have := congrArg (fun x => x * y⁻¹) h4
    simpa using this.symm

theorem burnsideI22P46_BData.centralizer_iff (D : burnsideI22P46_BData t y φ S0 h a Al Ns) (p : K) :
    y * p = p * y ↔ φ y * φ p = φ p * φ y := by
  constructor
  · intro hp
    rw [← map_mul, ← map_mul, hp]
  · intro hp
    obtain ⟨g, hgφ, hg3⟩ := D.exists_lift
    have hgy : g * y = y * g := D.cube_cent hg3 (by rw [hgφ]; exact D.h_cent)
    set T : Subgroup K := Subgroup.closure ((Subgroup.comap φ S0 : Set K) ∪ {g}) with hTdef
    have hT : T ≤ Subgroup.centralizer ({y} : Set K) := by
      rw [hTdef, Subgroup.closure_le]
      rintro q (hq | hq)
      · exact (Subgroup.mem_centralizer_singleton_iff).2 (D.Sy q hq)
      · rw [Set.mem_singleton_iff] at hq; rw [hq]
        exact (Subgroup.mem_centralizer_singleton_iff).2 hgy
    have hker1 : ∀ q : K, φ q = 1 → q ∈ T := fun q hq =>
      Subgroup.subset_closure (Or.inl (by
        show φ q ∈ S0
        rw [hq]; exact S0.one_mem))
    have hφT : Subgroup.closure ((S0 : Set (Equiv.Perm (Fin 22))) ∪ {h}) ≤ T.map φ := by
      rw [Subgroup.closure_le]
      rintro s (hs | hs)
      · obtain ⟨q, hq⟩ := D.S0_range hs
        exact ⟨q, Subgroup.subset_closure (Or.inl (by show φ q ∈ S0; rw [hq]; exact hs)), hq⟩
      · rw [Set.mem_singleton_iff] at hs; rw [hs]
        exact ⟨g, Subgroup.subset_closure (Or.inr rfl), hgφ⟩
    have hmem : φ p ∈ Subgroup.closure ((S0 : Set (Equiv.Perm (Fin 22))) ∪ {h}) := by
      rw [D.Cs_eq]
      exact ⟨⟨p, rfl⟩, (Subgroup.mem_centralizer_singleton_iff).2 hp.symm⟩
    obtain ⟨q, hqT, hqp⟩ := hφT hmem
    have hc : φ (q⁻¹ * p) = 1 := by rw [map_mul, map_inv, hqp, inv_mul_cancel]
    have hpT : p ∈ T := by
      have := T.mul_mem hqT (hker1 _ hc)
      simpa using this
    exact ((Subgroup.mem_centralizer_singleton_iff).1 (hT hpT)).symm

theorem burnsideI22P46_BData.Ns_Cs (D : burnsideI22P46_BData t y φ S0 h a Al Ns) {g : Equiv.Perm (Fin 22)}
    (hg : g ∈ φ.range ⊓ Subgroup.centralizer ({φ y} : Set (Equiv.Perm (Fin 22)))) :
    ∀ n ∈ Ns, g * n * g⁻¹ ∈ Ns := by
  have hh : ∀ n ∈ Ns, h⁻¹ * n * h ∈ Ns := by
    intro n hn
    have e1 : h * h = h⁻¹ := eq_inv_of_mul_eq_one_left D.h_cube
    have e2 : h⁻¹ * h⁻¹ = h := by
      calc h⁻¹ * h⁻¹ = (h * h) * (h * h) := by rw [e1]
        _ = h * (h * h * h) := by group
        _ = h := by rw [D.h_cube, mul_one]
    have e3 : h⁻¹ * n * h = h * (h * n * h⁻¹) * h⁻¹ := by
      calc h⁻¹ * n * h = (h * h) * n * (h⁻¹ * h⁻¹) := by rw [e1, e2]
        _ = h * (h * n * h⁻¹) * h⁻¹ := by group
    rw [e3]
    exact D.Ns_h _ (D.Ns_h n hn)
  have hnorm : Subgroup.closure ((S0 : Set (Equiv.Perm (Fin 22))) ∪ {h}) ≤
      Subgroup.normalizer (Ns : Set (Equiv.Perm (Fin 22))) := by
    rw [Subgroup.closure_le]
    rintro g (hg | hg)
    · rw [SetLike.mem_coe, Subgroup.mem_normalizer_iff]
      intro x
      constructor
      · exact fun hx => D.Ns_S0 g hg x hx
      · intro hx
        have := D.Ns_S0 g⁻¹ (S0.inv_mem hg) _ hx
        simpa [mul_assoc] using this
    · rw [Set.mem_singleton_iff] at hg
      rw [hg, SetLike.mem_coe, Subgroup.mem_normalizer_iff]
      intro x
      constructor
      · exact fun hx => D.Ns_h x hx
      · intro hx
        have := hh _ hx
        simpa [mul_assoc] using this
  rw [← D.Cs_eq] at hg
  intro n hn
  have := (Subgroup.mem_normalizer_iff.1 (hnorm hg) n).1 hn
  exact this

theorem burnsideI22P46_BData.mem_cent_iff (D : burnsideI22P46_BData t y φ S0 h a Al Ns) (p : K) :
    p ∈ Subgroup.centralizer ({y} : Set K) ↔ φ p ∈ Subgroup.centralizer ({φ y} : Set _) := by
  rw [Subgroup.mem_centralizer_singleton_iff, Subgroup.mem_centralizer_singleton_iff]
  constructor
  · intro hp
    rw [← map_mul, ← map_mul, hp]
  · intro hp
    exact (D.centralizer_iff p).2 hp.symm |>.symm

theorem burnsideI22P46_BData.index_three (D : burnsideI22P46_BData t y φ S0 h a Al Ns)
    {S : Subgroup (Equiv.Perm (Fin 22))}
    (hS : S ≤ φ.range ⊓ Subgroup.centralizer ({φ y} : Set (Equiv.Perm (Fin 22))))
    (hc : Nat.card S = 128) :
    (S.subgroupOf (φ.range ⊓ Subgroup.centralizer ({φ y} : Set (Equiv.Perm (Fin 22))))).index = 3 := by
  have h1 := Subgroup.card_mul_index
    (S.subgroupOf (φ.range ⊓ Subgroup.centralizer ({φ y} : Set (Equiv.Perm (Fin 22)))))
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hS).toEquiv, hc, D.Cs_card] at h1
  omega

open CFSG.ASVolI.ChIJK in
theorem burnsideI22P46_BData.exists_sq (D : burnsideI22P46_BData t y φ S0 h a Al Ns) :
    ∃ x ∈ pCoreOf 2 (twoResidual (Subgroup.centralizer ({y} : Set K))), x ^ 2 = y := by
  set C := Subgroup.centralizer ({y} : Set K) with hC
  obtain ⟨g, hgφ, hg3⟩ := D.exists_lift
  have hgC : g ∈ C := (D.mem_cent_iff g).2 (by
    rw [Subgroup.mem_centralizer_singleton_iff, hgφ]; exact D.h_cent)
  have haS0 : a ∈ S0 := D.Ns_le D.a_mem
  obtain ⟨ã, hã⟩ := D.S0_range haS0
  have hãC : ã ∈ C := Subgroup.mem_centralizer_singleton_iff.2 (D.Sy ã (by rw [hã]; exact haS0))
  have hgodd : Odd (orderOf g) := by
    have hdvd : orderOf g ∣ 3 := orderOf_dvd_of_pow_eq_one (by simpa [pow_succ] using hg3)
    exact Odd.of_dvd_nat (by decide) hdvd
  have hgX : g ∈ twoResidual C := burnsideI22P46_odd_mem_twoResidual C hgC hgodd
  set x : K := ã * g * ã⁻¹ * g⁻¹ with hx
  have hxX : x ∈ twoResidual C :=
    (twoResidual C).mul_mem (burnsideI22P46_twoResidual_conj C hãC hgX)
      ((twoResidual C).inv_mem hgX)
  have hφx : φ x = a * h * a⁻¹ * h⁻¹ := by simp [hx, hã, hgφ]
  have hxNs : φ x ∈ Ns := by
    rw [hφx]
    have := Ns.mul_mem D.a_mem (D.Ns_h a⁻¹ (Ns.inv_mem D.a_mem))
    simpa [mul_assoc] using this
  set Nt : Subgroup K := Subgroup.comap φ Ns with hNt
  have hNtC : Nt ≤ C := fun p hp => (D.mem_cent_iff p).2
    (Subgroup.mem_centralizer_singleton_iff.2 (D.S0_cent _ (D.Ns_le hp)))
  have hNtn : ∀ c ∈ C, ∀ n ∈ Nt, c * n * c⁻¹ ∈ Nt := by
    intro c hc n hn
    have hφc : φ c ∈ φ.range ⊓ Subgroup.centralizer ({φ y} : Set (Equiv.Perm (Fin 22))) :=
      ⟨⟨c, rfl⟩, (D.mem_cent_iff c).1 hc⟩
    show φ (c * n * c⁻¹) ∈ Ns
    rw [map_mul, map_mul, map_inv]
    exact D.Ns_Cs hφc _ hn
  have hXn : ∀ c ∈ C, ∀ n ∈ twoResidual C, c * n * c⁻¹ ∈ twoResidual C :=
    fun c hc n hn => burnsideI22P46_twoResidual_conj C hc hn
  set N0 : Subgroup K := Nt ⊓ twoResidual C with hN0
  have hN0X : N0 ≤ twoResidual C := inf_le_right
  have hN0n : (N0.subgroupOf (twoResidual C)).Normal := by
    refine ⟨fun n hn x₁ => ?_⟩
    have hn' : (n : K) ∈ N0 := hn
    have hx₁C : (x₁ : K) ∈ C := burnsideI22P46_twoResidual_le C x₁.2
    exact ⟨hNtn _ hx₁C _ hn'.1, hXn _ hx₁C _ hn'.2⟩
  have hN0p : IsPGroup 2 N0 := by
    intro n
    have hn1 : φ n ∈ Ns := n.2.1
    have hS0p : IsPGroup 2 S0 := IsPGroup.of_card (n := 7) (by rw [D.S0_card]; norm_num)
    obtain ⟨k, hk⟩ := hS0p ⟨φ n, D.Ns_le hn1⟩
    have hk' : φ n ^ (2 ^ k) = 1 := congrArg Subtype.val hk
    have hker : (n : K) ^ (2 ^ k) = 1 ∨ (n : K) ^ (2 ^ k) = t := by
      rcases (D.ker _).1 (by rw [map_pow]; exact hk') with h1 | h1
      · exact Or.inl h1
      · exact Or.inr h1
    refine ⟨k + 1, Subtype.ext ?_⟩
    simp only [Subgroup.coe_pow, Subgroup.coe_one]
    rw [pow_succ, pow_mul]
    rcases hker with h1 | h1
    · rw [h1]; simp
    · rw [h1, pow_two]; exact D.t_sq
  have hxP : x ∈ pCoreOf 2 (twoResidual C) :=
    burnsideI22P46_le_pCoreOf (twoResidual C) N0 hN0X hN0n hN0p ⟨hxNs, hxX⟩
  refine ⟨x, hxP, ?_⟩
  rw [pow_two]
  exact D.Al_sq _ (hφx ▸ D.a_comm) x hφx

open CFSG.ASVolI.ChIJK in
theorem burnsideI22P46_BData.sq_unique (D : burnsideI22P46_BData t y φ S0 h a Al Ns) {x : K}
    (hx : x ∈ pCoreOf 2 (twoResidual (Subgroup.centralizer ({y} : Set K))))
    (hsq : φ x * φ x = φ y) : x * x = y := by
  set C := Subgroup.centralizer ({y} : Set K) with hC
  set X := twoResidual C with hX
  set P := pCoreOf 2 X with hP
  set Cs := φ.range ⊓ Subgroup.centralizer ({φ y} : Set (Equiv.Perm (Fin 22))) with hCs
  have hPC : P ≤ C := (burnsideI22P46_pCoreOf_le X).trans (burnsideI22P46_twoResidual_le C)
  have hPφCs : P.map φ ≤ Cs := by
    rintro _ ⟨p, hp, rfl⟩
    exact ⟨⟨p, rfl⟩, (D.mem_cent_iff p).1 (hPC hp)⟩
  have hPφn : ∀ c ∈ Cs, ∀ n ∈ P.map φ, c * n * c⁻¹ ∈ P.map φ := by
    intro c hc n hn
    obtain ⟨c₀, rfl⟩ := hc.1
    obtain ⟨p, hp, rfl⟩ := hn
    have hc₀ : c₀ ∈ C := (D.mem_cent_iff c₀).2 hc.2
    have h1 : ∀ x ∈ X, c₀ * x * c₀⁻¹ ∈ X := fun x hx => burnsideI22P46_twoResidual_conj C hc₀ hx
    have h2 : ∀ x ∈ X, c₀⁻¹ * x * c₀ ∈ X := fun x hx => by
      have := burnsideI22P46_twoResidual_conj C (C.inv_mem hc₀) hx
      simpa using this
    refine ⟨c₀ * p * c₀⁻¹, burnsideI22P46_pCoreOf_conj X c₀ h1 h2 hp, ?_⟩
    simp [map_mul, map_inv]
  have hPφ2 : IsPGroup 2 (P.map φ) := by
    intro g
    obtain ⟨p, hp, hpg⟩ := g.2
    obtain ⟨k, hk⟩ := burnsideI22P46_pCoreOf_isPGroup X ⟨p, hp⟩
    refine ⟨k, Subtype.ext ?_⟩
    have : p ^ (2 ^ k) = 1 := congrArg Subtype.val hk
    simp only [Subgroup.coe_pow, Subgroup.coe_one]
    rw [← hpg, ← map_pow, this, map_one]
  have hS0Cs : S0 ≤ Cs := fun s hs => ⟨D.S0_range hs,
    Subgroup.mem_centralizer_singleton_iff.2 (D.S0_cent s hs)⟩
  have hS0p : IsPGroup 2 S0 := IsPGroup.of_card (n := 7) (by rw [D.S0_card]; norm_num)
  have hPS0 : P.map φ ≤ S0 :=
    burnsideI22P46_le_of_normal Cs _ _ hPφCs hS0Cs hPφ2 hS0p hPφn
      (by rw [D.index_three hS0Cs D.S0_card]; decide)
  have hhCs : h ∈ Cs := ⟨D.h_range, Subgroup.mem_centralizer_singleton_iff.2 D.h_cent⟩
  set S1 : Subgroup (Equiv.Perm (Fin 22)) := S0.map (MulAut.conj h).toMonoidHom with hS1
  have hS1Cs : S1 ≤ Cs := by
    rintro _ ⟨s, hs, rfl⟩
    exact Cs.mul_mem (Cs.mul_mem hhCs (hS0Cs hs)) (Cs.inv_mem hhCs)
  have hS1card : Nat.card S1 = 128 := by
    rw [hS1, Subgroup.card_map_of_injective (MulAut.conj h).injective, D.S0_card]
  have hS1p : IsPGroup 2 S1 := IsPGroup.of_card (n := 7) (by rw [hS1card]; norm_num)
  have hPS1 : P.map φ ≤ S1 :=
    burnsideI22P46_le_of_normal Cs _ _ hPφCs hS1Cs hPφ2 hS1p hPφn
      (by rw [D.index_three hS1Cs hS1card]; decide)
  have hq : φ x ∈ P.map φ := ⟨x, hx, rfl⟩
  have hq0 : φ x ∈ S0 := hPS0 hq
  have hq1 : h⁻¹ * φ x * h ∈ S0 := by
    obtain ⟨s, hs, hsq'⟩ := hPS1 hq
    have : (MulAut.conj h) s = h * s * h⁻¹ := rfl
    have hs' : φ x = h * s * h⁻¹ := by rw [← hsq']; rfl
    rw [hs']
    simpa [mul_assoc] using hs
  exact D.Al_sq _ (D.uniq _ hq0 hsq hq1) x rfl

open CFSG.ASVolI.ChIJK in
theorem burnsideI22P46_BData.uniqueSquare (D : burnsideI22P46_BData t y φ S0 h a Al Ns) (u : K)
    (hu : u = y ∨ u = y * t) : UniqueSquareInCoset K u := by
  have htc : ∀ x : K, x * t = t * x := fun x => Subgroup.mem_center_iff.1 D.t_central x
  have hφt : φ t = 1 := (D.ker t).2 (Or.inr rfl)
  have hφu : φ u = φ y := by
    rcases hu with rfl | rfl
    · rfl
    · rw [map_mul, hφt, mul_one]
  have hcent : Subgroup.centralizer ({u} : Set K) = Subgroup.centralizer ({y} : Set K) := by
    rcases hu with rfl | rfl
    · rfl
    · ext p
      rw [Subgroup.mem_centralizer_singleton_iff, Subgroup.mem_centralizer_singleton_iff]
      constructor
      · intro hp
        have : p * y * t = y * p * t := by
          calc p * y * t = p * (y * t) := by group
            _ = (y * t) * p := hp
            _ = y * (t * p) := by group
            _ = y * (p * t) := by rw [← htc p]
            _ = y * p * t := by group
        exact mul_right_cancel this
      · intro hp
        calc p * (y * t) = (p * y) * t := by group
          _ = (y * p) * t := by rw [hp]
          _ = y * (p * t) := by group
          _ = y * (t * p) := by rw [htc p]
          _ = (y * t) * p := by group
  unfold UniqueSquareInCoset
  rw [hcent]
  obtain ⟨x, hx, hxy⟩ := D.exists_sq
  refine ⟨y, ⟨?_, x, hx, hxy⟩, ?_⟩
  · rcases hu with rfl | rfl
    · exact ⟨1, Subgroup.one_mem _, (mul_one _).symm⟩
    · exact ⟨t, D.t_central, by rw [mul_assoc, D.t_sq, mul_one]⟩
  · rintro v ⟨⟨z', hz', rfl⟩, x', hx', hx'v⟩
    have hφz' : φ z' = 1 := by
      rcases D.center z' hz' with rfl | rfl
      · exact map_one φ
      · exact hφt
    have hvy : φ x' * φ x' = φ y := by
      rw [← map_mul, ← pow_two, hx'v, map_mul, hφu, hφz', mul_one]
    have := D.sq_unique hx' hvy
    rw [← hx'v, pow_two, this]

theorem burnsideI22P46_BData.conj (D : burnsideI22P46_BData t y φ S0 h a Al Ns) (c : K) :
    burnsideI22P46_BData t (c * y * c⁻¹) (φ.comp (MulAut.conj c⁻¹).toMonoidHom) S0 h a Al Ns := by
  have hφ' : ∀ p : K, (φ.comp (MulAut.conj c⁻¹).toMonoidHom) p = φ (c⁻¹ * p * c) := by
    intro p; simp [MulAut.conj_apply]
  have hφ'y : (φ.comp (MulAut.conj c⁻¹).toMonoidHom) (c * y * c⁻¹) = φ y := by
    rw [hφ']; congr 1; group
  have hrange' : (φ.comp (MulAut.conj c⁻¹).toMonoidHom).range = φ.range := by
    ext g
    constructor
    · rintro ⟨p, rfl⟩
      exact ⟨_, (hφ' p).symm⟩
    · rintro ⟨q, rfl⟩
      exact ⟨c * q * c⁻¹, by rw [hφ']; congr 1; group⟩
  have htc : ∀ x : K, x * t = t * x := fun x => Subgroup.mem_center_iff.1 D.t_central x
  refine ⟨D.t_central, D.t_sq, D.t_ne, D.center, ?_, ?_, ?_, D.S0_card, ?_, ?_, ?_, ?_, ?_, ?_, ?_,
    ?_, ?_, D.Ns_le, D.Ns_S0, D.Ns_h, D.a_mem, D.a_comm, ?_⟩
  · intro x
    rw [hφ', D.ker]
    constructor
    · rintro (h1 | h1)
      · left
        have : c⁻¹ * x * c = 1 := h1
        calc x = c * (c⁻¹ * x * c) * c⁻¹ := by group
          _ = 1 := by rw [this]; group
      · right
        calc x = c * (c⁻¹ * x * c) * c⁻¹ := by group
          _ = c * t * c⁻¹ := by rw [h1]
          _ = t * c * c⁻¹ := by rw [← htc c]
          _ = t := by group
    · rintro (h1 | h1)
      · left; rw [h1]; group
      · right
        rw [h1]
        calc c⁻¹ * t * c = t * c⁻¹ * c := by rw [← htc c⁻¹]
          _ = t := by group
  · calc c * y * c⁻¹ * (c * y * c⁻¹) = c * (y * y) * c⁻¹ := by group
      _ = 1 := by rw [D.y_sq]; group
  · rw [hrange']; exact D.S0_range
  · rw [hφ'y]; exact D.S0_cent
  · intro p hp
    rw [hφ'] at hp
    have := D.Sy _ hp
    calc p * (c * y * c⁻¹) = c * ((c⁻¹ * p * c) * y) * c⁻¹ := by group
      _ = c * (y * (c⁻¹ * p * c)) * c⁻¹ := by rw [this]
      _ = c * y * c⁻¹ * p := by group
  · rw [hrange', hφ'y]; exact D.Cs_card
  · rw [hrange']; exact D.h_range
  · rw [hφ'y]; exact D.h_cent
  · exact D.h_cube
  · exact D.h_ne
  · intro g hg; rw [hφ'y]; exact D.Al_root g hg
  · intro g hg p hp
    rw [hφ'] at hp
    have := D.Al_sq g hg _ hp
    calc p * p = c * ((c⁻¹ * p * c) * (c⁻¹ * p * c)) * c⁻¹ := by group
      _ = c * y * c⁻¹ := by rw [this]
  · intro g hg hgz hgh
    rw [hφ'y] at hgz
    exact D.uniq g hg hgz hgh

end BData

theorem burnsideI22P46_comm_invol {K : Type} [Group K] {t : K} {M : Type} [Group M] {φ : K →* M}
    (hker : ∀ x, φ x = 1 ↔ x = 1 ∨ x = t) (ht2 : t * t = 1) (htc : ∀ x : K, x * t = t * x)
    (hnsq : ∀ g : K, g * g ≠ t) {g y : K} (hg : g * g = 1) (hy : y * y = 1)
    (hφ : φ g * φ y = φ y * φ g) : g * y = y * g := by
  have hgi : g⁻¹ = g := inv_eq_of_mul_eq_one_right hg
  have hyi : y⁻¹ = y := inv_eq_of_mul_eq_one_right hy
  have hc : φ (g * y * (g * y)) = 1 := by
    simp only [map_mul]
    calc φ g * φ y * (φ g * φ y) = φ g * (φ y * φ g) * φ y := by group
      _ = φ g * (φ g * φ y) * φ y := by rw [hφ]
      _ = φ (g * g) * φ (y * y) := by simp only [map_mul]; group
      _ = 1 := by rw [hg, hy]; simp
  rcases (hker _).1 hc with h1 | h1
  ·
    have h2 : g * y = (g * y)⁻¹ := (inv_eq_of_mul_eq_one_right h1).symm
    rw [mul_inv_rev, hgi, hyi] at h2
    exact h2
  · exact absurd h1 (hnsq _)

open CFSG.EvenSporadicStandard.M22Std CFSG.QuasithinUnique.Ch1 CFSG.QuasithinUnique.Ch1.M22Cover
