theorem burnsideI22P46_b_data
    {L : Type} [Group L] [Finite L] [Group.IsPerfect L] {t : L} (hc : IsM22Cover L t) :
    ∃ (φ : L →* Equiv.Perm (Fin 22)) (y : L) (S0 : Subgroup (Equiv.Perm (Fin 22)))
