      rw [hsE]
      calc x * (h' * ruZ' * h'⁻¹) = h' * ((h'⁻¹ * x * h'⁻¹⁻¹) * ruZ') * h'⁻¹ := by group
        _ = h' * (ruZ' * (h'⁻¹ * x * h'⁻¹⁻¹)) * h'⁻¹ := by rw [hcx]
        _ = h' * ruZ' * h'⁻¹ * x := by group

