theorem burnsideI22P7_six_le_pRank
    {K : Type} [Group K] [Finite K] [Group.IsPerfect K] {q : K →* ruP}
    (hq : Function.Surjective q) {t : K} (ht : orderOf t = 2) (hker : q.ker = Subgroup.zpowers t)
