        ⟨m * m₀⁻¹, ruP.mul_mem (M64_le_ruP hm) (ruP.inv_mem (M64_le_ruP hm₀)), ?_⟩
      rw [← hmu]
      have : t64 = m₀⁻¹ * ruZ * m₀ := by rw [← hm₀z]; group
      rw [this]; group
  have hEA := CFSG.GH74.GLS.IVK.Lifted.isElementaryAbelian_two_of_sq_eq_one hsq
  have hcard : Nat.card (H.comap q) = 2 ^ 7 := by
    rw [CFSG.GH74.GLS.IVK.Lifted.card_comap_of_surjective_two hq H, hker, Nat.card_zpowers, ht, hH,
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe (refSub_le_ruP (k := 6) basis64W)).toEquiv]
    show Nat.card (refSub v64) * 2 = 2 ^ 7
    rw [card_refSub hv64]
