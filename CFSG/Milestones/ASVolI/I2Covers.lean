    have hab := hR _ (R.mul_mem a.2 b.2)
    have ha' : (a : G)⁻¹ = a := by rw [inv_eq_iff_mul_eq_one]; exact ha
    have hb' : (b : G)⁻¹ = b := by rw [inv_eq_iff_mul_eq_one]; exact hb
    have hab' : ((a : G) * b)⁻¹ = a * b := by rw [inv_eq_iff_mul_eq_one]; exact hab
    apply Subtype.ext
    calc (a : G) * b = ((a : G) * b)⁻¹ := hab'.symm
      _ = (b : G)⁻¹ * (a : G)⁻¹ := mul_inv_rev _ _
      _ = (b : G) * a := by rw [ha', hb']
  haveI : CFSG.IsElementaryAbelian 2 R :=
    { is_comm := ⟨hcomm⟩
      exponent_dvd_p := by
        refine Monoid.exponent_dvd_iff_forall_pow_eq_one.2 fun x => ?_
        rw [pow_two]
        exact Subtype.ext (hR x x.2) }
  unfold frattiniOf
  rw [CFSG.frattini_eq_bot_of_isElementaryAbelian (R := R) (p := 2)]
  simp

