  · obtain ⟨k, hk⟩ := QuotientGroup.mk_surjective i
    have hs2 : (e i) ^ 2 = 1 := by rw [← map_pow, hi2, map_one]
    have hs1 : e i ≠ 1 := fun h => hi1 (e.injective (by rw [h, map_one]))
