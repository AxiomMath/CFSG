module

public import CFSG.Open.Defs

public section

namespace CFSG.Open

open scoped MatrixGroups

section Embedding

variable {G : Type*} [Group G]

@[expose] def fusionStronglyEmbedded (M : Subgroup G) : Prop :=
  M ≠ ⊤ ∧ Even (Nat.card M) ∧
    ∀ g : G, g ∉ M → Odd (Nat.card ↥(M ⊓ M.map (MulAut.conj g⁻¹).toMonoidHom))

@[expose] def fusionStronglyClosed (A : Set G) (S : Subgroup G) : Prop :=
  ∀ a ∈ A, ∀ g : G, g⁻¹ * a * g ∈ S → g⁻¹ * a * g ∈ A

@[expose] def fusionIsTI (U : Subgroup G) : Prop :=
  ∀ g : G, U.map (MulAut.conj g).toMonoidHom ≠ U →
    U ⊓ U.map (MulAut.conj g).toMonoidHom = ⊥

end Embedding

@[expose] def fusionIsBenderGroup (K : Type*) [Group K] : Prop :=
  (∃ f : ℕ, 2 ≤ f ∧ Nonempty (K ≃* PSL(2, GaloisField 2 f))) ∨
  (∃ f : ℕ, 2 ≤ f ∧ Nonempty (K ≃* PSU3 2 f)) ∨
  (∃ a : ℕ, 1 ≤ a ∧ Nonempty (K ≃* Sz a))

@[expose] def fusionOddCore (H : Type*) [Group H] : Subgroup H :=
  sSup {N : Subgroup H | N.Normal ∧ Odd (Nat.card N)}

instance fusionOddCore_normal (H : Type*) [Group H] : (fusionOddCore H).Normal :=
  Subgroup.sSup_normal _ fun _ hN => hN.1

@[expose] def fusionZStar (H : Type*) [Group H] : Subgroup H :=
  (Subgroup.center (H ⧸ fusionOddCore H)).comap (QuotientGroup.mk' (fusionOddCore H))

instance fusionZStar_normal (H : Type*) [Group H] : (fusionZStar H).Normal := by
  unfold fusionZStar
  infer_instance

section TwoComponents

variable {G : Type*} [Group G]

@[expose] def fusionOddCoreOf (H : Subgroup G) : Subgroup G :=
  (fusionOddCore H).map H.subtype

@[expose] def fusionIsTwoComponent (L K : Subgroup G) : Prop :=
  L ≤ K ∧ IsSubnormal L K ∧ commutator L = ⊤ ∧ IsQuasisimple (L ⧸ fusionOddCore L)

@[expose] def fusionTwoLayer (K : Subgroup G) : Subgroup G :=
  ⨆ (L : Subgroup G) (_ : fusionIsTwoComponent L K), L

@[expose] def fusionIsSylowIn (p : ℕ) (S H : Subgroup G) : Prop :=
  S ≤ H ∧ IsPGroup p S ∧ ∀ P : Subgroup G, P ≤ H → IsPGroup p P → S ≤ P → P = S

end TwoComponents

