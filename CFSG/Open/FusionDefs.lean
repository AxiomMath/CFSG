@[expose] def fusionDigitMatrix (rows : List String) : Matrix (Fin 50) (Fin 50) (ZMod 7) :=
  Matrix.of fun i j =>
    ((((rows.getD i.val "").toList.getD j.val '0').toNat - '0'.toNat : ℕ) : ZMod 7)

@[expose] def fusionHe : Subgroup (GL (Fin 50) (ZMod 7)) :=
  Subgroup.closure {g |
    (g : Matrix (Fin 50) (Fin 50) (ZMod 7)) = fusionDigitMatrix fusionHeGenARows ∨
      (g : Matrix (Fin 50) (Fin 50) (ZMod 7)) = fusionDigitMatrix fusionHeGenBRows}

