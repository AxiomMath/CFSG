module

public import CFSG.Blueprint.NativeSporadic
public import CFSG.Open.Defs

public section

namespace CFSG.Open
open scoped MatrixGroups

@[expose] def quasithinEvenCharacteristic (G : Type*) [Group G] : Prop :=
  ∀ H : Subgroup G, IsTwoLocal H → (∃ S : Sylow 2 G, (S : Subgroup G) ≤ H) →
    H ⊓ Subgroup.centralizer (pCoreOf 2 H : Set G) ≤ pCoreOf 2 H

@[expose] def quasithinIsQTKE (G : Type*) [Group G] [Finite G] : Prop :=
  IsKProper G ∧ quasithinEvenCharacteristic G ∧ evenRank G ≤ 2

@[expose] def quasithinIsSylowTwo {G : Type*} [Group G] (T : Subgroup G) : Prop :=
  IsPGroup 2 T ∧ ¬ 2 ∣ T.index

@[expose] def quasithinIsMaxTwoLocal {G : Type*} [Group G] (M : Subgroup G) : Prop :=
  IsMaxTwoLocalSubgroup M

section Local

variable {G : Type*} [Group G]

@[expose] def quasithinIsCComponent (L X : Subgroup G) : Prop :=
  L ≠ ⊥ ∧ ⁅L, L⁆ = L ∧ IsSubnormal L X ∧
    ∀ K : Subgroup G, K < L → K ≠ ⊥ → ⁅K, K⁆ = K → ¬ IsSubnormal K X

@[expose] def quasithinGenFitting (L : Subgroup G) : Subgroup G :=
  sSup {N | N ≤ L ∧ (N.subgroupOf L).Normal ∧ Group.IsNilpotent N} ⊔
    sSup {K | IsComponentOf K L}

@[expose] def quasithinV2 (L : Subgroup G) : Subgroup G :=
  ⁅Subgroup.closure {z | z ∈ pCoreOf 2 L ⊓ Subgroup.centralizer (pCoreOf 2 L : Set G) ∧
    z ^ 2 = 1}, L⁆

@[expose] def quasithinIsLocal (T L : Subgroup G) : Prop :=
  IsPGroup 2 T ∧ quasithinIsCComponent L (L ⊔ T) ∧
    ¬ 2 ∣ (T.subgroupOf (L ⊔ T)).index ∧ pCoreOf 2 (L ⊔ T) ≠ ⊥

@[expose] def quasithinIsFaithfulLocal (T L : Subgroup G) : Prop :=
  quasithinIsLocal T L ∧
    (∀ N : Subgroup G, N ≤ L → (N.subgroupOf L).Normal →
      (∀ x ∈ L, ∃ k : ℕ, x ^ 2 ^ k ∈ N) → N = L) ∧
    quasithinGenFitting L = pCoreOf 2 L ∧
    quasithinV2 L ≠ ⊥

@[expose] def quasithinIsMaximalLocal (T L : Subgroup G) : Prop :=
  quasithinIsLocal T L ∧ ∀ K : Subgroup G, quasithinIsLocal T K → L ≤ K → K = L

@[expose] def quasithinO2QuotientIso (L : Subgroup G) (H : Type*) [Group H] : Prop :=
  ∃ φ : L →* H, Function.Surjective φ ∧ φ.ker = pCore 2 L

@[expose] def quasithinOmegaOneCenter (T : Subgroup G) : Subgroup G :=
  Subgroup.closure {z | z ∈ T ⊓ Subgroup.centralizer (T : Set G) ∧ z ^ 2 = 1}

end Local

@[expose] def quasithinOrdM22 : ℕ := 2 ^ 7 * 3 ^ 2 * 5 * 7 * 11
@[expose] def quasithinOrdM23 : ℕ := 2 ^ 7 * 3 ^ 2 * 5 * 7 * 11 * 23
@[expose] def quasithinOrdM24 : ℕ := 2 ^ 10 * 3 ^ 3 * 5 * 7 * 11 * 23
@[expose] def quasithinOrdHe : ℕ := 2 ^ 10 * 3 ^ 3 * 5 ^ 2 * 7 ^ 3 * 17
@[expose] def quasithinOrdJ4 : ℕ := 2 ^ 21 * 3 ^ 3 * 5 * 7 * 11 ^ 3 * 23 * 29 * 31 * 37 * 43
@[expose] def quasithinOrdHS : ℕ := 2 ^ 9 * 3 ^ 2 * 5 ^ 3 * 7 * 11
@[expose] def quasithinOrdRu : ℕ := 2 ^ 14 * 3 ^ 3 * 5 ^ 3 * 7 * 13 * 29

@[expose] def quasithinTheoremDOrders : Set ℕ :=
  {m | ∃ n : ℕ, 2 ≤ n ∧ (m = ordA 2 (2 ^ n) ∨ m = ordBC 2 (2 ^ n) ∨ m = ordG2 (2 ^ n) ∨
      m = ordTwistedA 3 (2 ^ n) ∨ m = ordTrialityD4 (2 ^ n))} ∪
  {m | ∃ k : ℕ, 1 ≤ k ∧ m = ordTwistedF4 (2 ^ (2 * k + 1))} ∪
  {ordTwistedA 4 4,
    ordA 3 2, ordA 4 2, Nat.factorial 9 / 2, quasithinOrdM22, quasithinOrdM23, quasithinOrdM24,
    quasithinOrdHe, quasithinOrdJ4,
    ordBC 3 2, ordTwistedA 3 2, ordA 3 3, ordTwistedA 3 3, ordG2 3, quasithinOrdHS,
    quasithinOrdRu}

@[expose] def quasithinH13ExcludedOrders : Set ℕ :=
  {m | ∃ f : ℕ, 2 ≤ f ∧ m ∈ lieOrdersOver (2 ^ f)} ∪
  {m | ∃ k : ℕ, 1 ≤ k ∧ (m = ordSuzuki (2 ^ (2 * k + 1)) ∨ m = ordTwistedF4 (2 ^ (2 * k + 1)))} ∪
  {ordA 3 2, ordA 4 2, Nat.factorial 9 / 2, quasithinOrdM22, quasithinOrdM23, quasithinOrdM24,
    quasithinOrdHe, quasithinOrdJ4}

structure quasithinQTH13 (G : Type*) [Group G] [Finite G] (T L : Subgroup G) : Prop where
  simple : IsSimpleGroup G
  nonabelian : ∃ a b : G, a * b ≠ b * a
  qtke : quasithinIsQTKE G
  sylow : quasithinIsSylowTwo T
  faithful : quasithinIsFaithfulLocal T L
  not_excluded : Nat.card G ∉ quasithinH13ExcludedOrders
  a5 : quasithinO2QuotientIso L (alternatingGroup (Fin 5)) →
    ∀ K : Subgroup G, quasithinIsFaithfulLocal T K →
      quasithinO2QuotientIso K (alternatingGroup (Fin 5))

structure quasithinQTFE14 (G : Type*) [Group G] [Finite G] (T Mc : Subgroup G) : Prop where
  simple : IsSimpleGroup G
  nonabelian : ∃ a b : G, a * b ≠ b * a
  qtke : quasithinIsQTKE G
  sylow : quasithinIsSylowTwo T
  faithful_empty : ∀ L : Subgroup G, ¬ quasithinIsFaithfulLocal T L
  mc_max : quasithinIsMaxTwoLocal Mc
  t_le_mc : T ≤ Mc
  centralizer_le_mc : Subgroup.centralizer (quasithinOmegaOneCenter T : Set G) ≤ Mc
  mc_unique : ∀ M : Subgroup G, quasithinIsMaxTwoLocal M →
    Subgroup.centralizer (quasithinOmegaOneCenter T : Set G) ≤ M → M = Mc
  two_maximal : ∃ M : Subgroup G, quasithinIsMaxTwoLocal M ∧ T ≤ M ∧ M ≠ Mc

abbrev quasithinHopfRelations (X : Type) [Group X] : Subgroup (FreeGroup X) :=
  (FreeGroup.lift (id : X → X)).ker

abbrev quasithinHopfMultiplier (X : Type) [Group X] : Type :=
  ↥(quasithinHopfRelations X ⊓ commutator (FreeGroup X)) ⧸
    (⁅(⊤ : Subgroup (FreeGroup X)), quasithinHopfRelations X⁆).subgroupOf
      (quasithinHopfRelations X ⊓ commutator (FreeGroup X))

@[expose] def quasithinMultiplierCyclic (X : Type) [Group X] (d : ℕ) : Prop :=
  Nonempty (quasithinHopfMultiplier X ≃* Multiplicative (ZMod d))

@[expose] def quasithinAntidiag (n : ℕ) (K : Type*) [Zero K] [One K] : Matrix (Fin n) (Fin n) K :=
  Matrix.of fun i j => if i.val + j.val + 1 = n then 1 else 0

@[expose] noncomputable def quasithinPSU (n p k : ℕ) [Fact p.Prime] :
    Subgroup (Matrix.ProjGenLinGroup (Fin n) (GaloisField p (2 * k))) :=
  (Subgroup.closure {A : GL (Fin n) (GaloisField p (2 * k)) |
      (Matrix.of fun i j =>
          (A : Matrix (Fin n) (Fin n) (GaloisField p (2 * k))) j i ^ (p ^ k)) *
        quasithinAntidiag n (GaloisField p (2 * k)) *
        (A : Matrix (Fin n) (Fin n) (GaloisField p (2 * k))) =
      quasithinAntidiag n (GaloisField p (2 * k)) ∧
    Matrix.GeneralLinearGroup.det A = 1}).map Matrix.ProjGenLinGroup.mk

abbrev quasithinPSp (n : ℕ) (R : Type) [CommRing R] : Type :=
  Matrix.symplecticGroup (Fin n) R ⧸ Subgroup.center (Matrix.symplecticGroup (Fin n) R)

abbrev quasithinZorn (K : Type*) : Type _ := K × (Fin 3 → K) × (Fin 3 → K) × K

@[expose] def quasithinCross {K : Type*} [CommRing K] (u v : Fin 3 → K) : Fin 3 → K :=
  ![u 1 * v 2 - u 2 * v 1, u 2 * v 0 - u 0 * v 2, u 0 * v 1 - u 1 * v 0]

@[expose] def quasithinZornMul {K : Type*} [CommRing K] (x y : quasithinZorn K) : quasithinZorn K :=
  (x.1 * y.1 + ∑ i, x.2.1 i * y.2.2.1 i,
    fun i => x.1 * y.2.1 i + y.2.2.2 * x.2.1 i - quasithinCross x.2.2.1 y.2.2.1 i,
    fun i => y.1 * x.2.2.1 i + x.2.2.2 * y.2.2.1 i + quasithinCross x.2.1 y.2.1 i,
    x.2.2.2 * y.2.2.2 + ∑ i, x.2.2.1 i * y.2.1 i)

@[expose] def quasithinG2 (K : Type*) [CommRing K] : Subgroup (quasithinZorn K ≃ₗ[K] quasithinZorn K) :=
  Subgroup.closure {g | ∀ x y, g (quasithinZornMul x y) = quasithinZornMul (g x) (g y)}

@[expose] def quasithinRootElt {K : Type*} [CommRing K] (pos : List (Fin 8 × Fin 8)) (t : K) :
    Matrix (Fin 8) (Fin 8) K :=
  Matrix.of fun r c => (if r = c then 1 else 0) + if (r, c) ∈ pos then t else 0

@[expose] def quasithinD4Root : Fin 4 → Bool → List (Fin 8 × Fin 8)
  | 0, true => [(0, 1), (6, 7)]
  | 1, true => [(1, 2), (5, 6)]
  | 2, true => [(2, 3), (4, 5)]
  | 3, true => [(2, 4), (3, 5)]
  | 0, false => [(1, 0), (7, 6)]
  | 1, false => [(2, 1), (6, 5)]
  | 2, false => [(3, 2), (5, 4)]
  | 3, false => [(4, 2), (5, 3)]

@[expose] def quasithinTrialityGens : Set (Matrix (Fin 8) (Fin 8) (GaloisField 2 3)) :=
  {M | ∃ (a : GaloisField 2 3) (s : Bool), M = quasithinRootElt (quasithinD4Root 0 s) a *
      quasithinRootElt (quasithinD4Root 2 s) (a ^ 2) *
      quasithinRootElt (quasithinD4Root 3 s) (a ^ 4)} ∪
  {M | ∃ s : Bool, M = quasithinRootElt (quasithinD4Root 1 s) 1}

@[expose] noncomputable def quasithinTrialityD4Two : Subgroup (GL (Fin 8) (GaloisField 2 3)) :=
  Subgroup.closure {A | (A : Matrix (Fin 8) (Fin 8) (GaloisField 2 3)) ∈ quasithinTrialityGens}

@[expose] def quasithinM12 : Subgroup (Equiv.Perm (Fin 12)) :=
  CFSG.Blueprint.NativeSporadic.M12

@[expose] def quasithinM22 : Subgroup (Equiv.Perm (Fin 22)) :=
  CFSG.Blueprint.NativeSporadic.M22

@[expose] def quasithinDigits (s : String) : List ℕ :=
  (s.toList.filter Char.isDigit).map fun c => c.toNat - '0'.toNat

@[expose] def quasithinDecodeMatrix (p d : ℕ) (s : String) : Matrix (Fin d) (Fin d) (ZMod p) :=
  Matrix.of fun i j => (((quasithinDigits s).getD (d * i.val + j.val) 0 : ℕ) : ZMod p)

abbrev quasithinSeedUnits (p d : ℕ) (A B : Matrix (Fin d) (Fin d) (ZMod p)) : Type :=
  (Submonoid.closure ({A, B} : Set (Matrix (Fin d) (Fin d) (ZMod p))))ˣ

@[expose] def quasithinFixedWidth (w : ℕ) (l : List ℕ) (i : ℕ) : ℕ :=
  (List.range w).foldl (fun acc r => 10 * acc + l.getD (w * i + r) 0) 0

@[expose] def quasithinDecodePerm (n : ℕ) (hn : 0 < n) (s : String) : Function.End (Fin n) :=
  fun i => ⟨quasithinFixedWidth 4 (quasithinDigits s) i.val % n, Nat.mod_lt _ hn⟩

abbrev quasithinPermSeedUnits (n : ℕ) (f g : Function.End (Fin n)) : Type :=
  (Submonoid.closure ({f, g} : Set (Function.End (Fin n))))ˣ

