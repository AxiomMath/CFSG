theorem pack_colsOf : ∀ pr ∈ modStab ++ modSpan,
    pairBits pr % 2 ^ 2704 = pack (colsOf (pairBits pr)) % 2 ^ 2704 := by decide +kernel

theorem stab_cols : ∀ j < 2, stabCols.getD j [] = colsOf (pairBits (modStab.getD j ([], []))) := by
  decide +kernel

theorem span_vec : ∀ k < 26, spanVec.getD k 0 =
    mv (colsOf (pairBits (modSpan.getD k ([], [])))) (2 ^ 48) := by decide +kernel

theorem stab_fix : ∀ j < 2, mv (stabCols.getD j []) (2 ^ 48) = 2 ^ 48 := by decide +kernel

theorem eqRows_eq : eqRows = (List.range 104).map eqRow := by decide +kernel

theorem fix_cert : ∀ q < 52, q ≠ 47 → q ≠ 48 →
    xorSel (fun e => eqRows.getD e 0) (fixCert.getD q 0) 104 = 2 ^ q := by decide +kernel

theorem span_cert : ∀ q < 52, q ∈ modShortPos →
    xorSel (fun k => spanVec.getD k 0) (spanCert.getD q 0) 26 = 2 ^ q := by decide +kernel

