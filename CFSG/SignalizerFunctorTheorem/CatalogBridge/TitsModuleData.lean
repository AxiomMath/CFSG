@[expose] def coefB (L : List ℕ) (r c : ℕ) : Bool := (L.getD c 0).testBit r ^^ decide (c = r)

@[expose] def xorB : ℕ → (ℕ → Bool) → Bool
  | 0, _ => false
  | n + 1, f => xorB n f ^^ f n

@[expose] def rowBits (L : List ℕ) (r : ℕ) : ℕ → ℕ
  | 0 => 0
  | n + 1 => rowBits L r n ||| (if coefB L r n then 2 ^ n else 0)

@[expose] def eqRow (e : ℕ) : ℕ := rowBits (stabCols.getD (e / 52) []) (e % 52) 52

