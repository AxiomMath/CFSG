namespace CFSG.ComponentClassification.RankTwoClassical

open Subgroup CFSG.Open CFSG.ComponentClassification.RankTwoStandard
open scoped MatrixGroups

variable {G : Type} [Group G] {A : Subgroup G}

theorem spQuotEquivProj {n : ℕ} {K : Type} [Field K] [Finite K] [CharP K 2]
    (hn : 1 ≤ n) (e : A ≃* StatedSp n K) :
    Nonempty (rankTwoQuot A ≃* StatedProj (StatedSp n K)) := by
  haveI : NeZero n := ⟨by omega⟩
  refine ⟨(QuotientGroup.congr (Subgroup.center A) (Subgroup.center (StatedSp n K)) e
      (Subgroup.map_center_eq e)).trans ?_⟩
  exact (QuotientGroup.quotientMulEquivOfEq
      (CFSG.Timmesfeld.Transvection.center_statedSp_eq_bot hn)).trans
    (QuotientGroup.quotientBot.trans (CFSG.SeitzReduction.OmegaPilot.spProjEquivCharTwo K n).symm)

theorem spTwoQuotEquivPSL {f : ℕ} (_hf : 2 ≤ f)
    (e : A ≃* StatedSp 1 (GaloisField 2 f)) :
    Nonempty (rankTwoQuot A ≃* PSL(2, GaloisField 2 f)) := by
  obtain ⟨e₁⟩ := spQuotEquivProj (n := 1) (by norm_num) e
  exact ⟨e₁.trans ((CFSG.SeitzReduction.OmegaPilot.spOneEquiv (GaloisField 2 f)).trans
    (CFSG.Timmesfeld.RankOne.psl2EquivSL2 (GaloisField 2 f)).symm)⟩

theorem spTwoFourQuotEquivA5 (e : A ≃* StatedSp 1 (GaloisField 2 2)) :
    Nonempty (rankTwoQuot A ≃* alternatingGroup (Fin 5)) := by
  obtain ⟨e₁⟩ := spTwoQuotEquivPSL (A := A) (f := 2) (by norm_num) e
  obtain ⟨e₂⟩ := CFSG.CGT.PushingUpLit.CGT6.sl2_four_equiv_alt5
  exact ⟨e₁.trans ((CFSG.Timmesfeld.RankOne.psl2EquivSL2 (GaloisField 2 2)).trans e₂)⟩

end CFSG.ComponentClassification.RankTwoClassical
