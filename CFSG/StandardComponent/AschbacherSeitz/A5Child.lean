variable {G : Type} [Group G] [Finite G]

theorem hyp31_ofNF {A : Subgroup G} (hH : RankTwoHypNF G A)
    (hO : standardComponentOddCore G = ⊥) {n : ℕ}
    (hn : 5 ≤ n) (e : rankTwoQuot A ≃* alternatingGroup (Fin n)) : Hyp31 A :=
  ⟨hH.standard, hypII_of_alternating_ge_five hn hH.standard.1.1 e, hO,
    by have := hH.rank; omega, hH.not_normal⟩

theorem false_of_double_badNF
    {G : Type} [Group G] [Finite G] {A R T : Subgroup G} {g : G}
    (c : CaseICoords A (rightConjugate A g) R T)
    (hw : c.w ∈ rightConjugate A g ⊔ c.Bx) (hv : c.symm.w ∈ A ⊔ c.symm.Bx) : False :=
  c.false_of_double_bad hw hv

@[expose] def AltFiveCaseINF : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (A : Subgroup G), RankTwoHypNF G A →
    standardComponentOddCore G = ⊥ → Nonempty (rankTwoQuot A ≃* alternatingGroup (Fin 5)) →
    Odd (Nat.card (center ↥A)) → ∀ R : Subgroup G, IsSylowOf 2 R (centralizer (A : Set G)) →
    (∃ x : G, rightConjugate R x ≤ A) → Nonempty (rankTwoX A ≃* alternatingGroup (Fin 9))

theorem altFiveCaseINF_of_lemmas
    (h32 : Lemma32) (h332 : Lemma33Two)
    (hGen5 : AltGenerationFive) : AltFiveCaseINF := by
  intro G _ _ A hH hO hA5 hodd R hR hx
  obtain ⟨x, hx⟩ := hx
  obtain ⟨e⟩ := hA5
  have hZ : center ↥A = ⊥ := center_eq_bot_of_odd_five hH.standard.1.1 e hodd
  set eA := mulEquivOfCenter hZ e with heA
  have hc := sec3_of_le (hyp31_ofNF hH hO le_rfl e) eA hR hx
  have hp := caseIPair_of h32 h332 hc eA hx
  obtain ⟨c⟩ := hp.nonempty_coords
  obtain ⟨Φ, hΦ, hrange, hlift⟩ : ∃ Φ : alternatingGroup (Fin 9) →* G, Function.Injective Φ ∧
      Φ.range = A ⊔ rightConjugate A x ∧ (Φ.comp (liftNat 5)).range = A := by
    by_cases hw : c.w ∈ c.D
    · have hv : c.symm.w ∉ c.symm.D := fun hv =>
        false_of_double_badNF (G := G) (A := A) (R := R)
          (T := rightConjugate R x) (g := x) c hw hv
      obtain ⟨Φ, hΦ, hr, -, hB⟩ := c.symm.exists_alt9 hv
      refine ⟨Φ.comp (conjPerm 9 tauB).toMonoidHom, hΦ.comp (conjPerm 9 tauB).injective, ?_, hB⟩
      rw [MonoidHom.range_comp, MonoidHom.range_eq_top_of_surjective (conjPerm 9 tauB).toMonoidHom
        (conjPerm 9 tauB).surjective, ← MonoidHom.range_eq_map, hr, sup_comm]
    · obtain ⟨Φ, hΦ, hr, hA, -⟩ := c.exists_alt9 hw
      exact ⟨Φ, hΦ, hr, hA⟩
  have hX := hGen5 G A R (rightConjugate R x) x Φ
    { five_le := le_rfl
      hyp := hH
      oddCore_eq_bot := hO
      sec3 := hc
      T_le := hx
      R_le := hp.R_le
      injective := hΦ
      range_eq := hrange
      range_liftNat := hlift }
  exact ⟨((MonoidHom.ofInjective hΦ).trans
    (MulEquiv.subgroupCongr (hrange.trans hX.symm))).symm⟩

@[expose] def AltFiveM12NotTopNF : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (A : Subgroup G), RankTwoHypNF G A →
    standardComponentOddCore G = ⊥ → Nonempty (rankTwoQuot A ≃* alternatingGroup (Fin 5)) →
    Odd (Nat.card (center ↥A)) → ∀ R : Subgroup G, IsSylowOf 2 R (centralizer (A : Set G)) →
    (∀ x : G, ¬ rightConjugate R x ≤ A) → NativeSporadic.IsSporadic (rankTwoX A) .M12 →
    (∃ t : G, t ^ 2 = 1 ∧ t ∈ normalizer (A : Set G) ∧ t ∈ normalizer (R : Set G) ∧
      ¬ ∃ a ∈ A, ∀ y ∈ A, t * y * t⁻¹ = a * y * a⁻¹) →
    rankTwoX A ≠ ⊤

theorem altFiveM12NotTopNF :
    AltFiveM12NotTopNF := by
  intro G _ _ A hH _ hA5 hodd R hR _ hM12 ht hX
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨t, ht2, htA, htR, hout⟩ := ht
  obtain ⟨e⟩ := hM12
  obtain ⟨eq⟩ := hA5
  let eG : G ≃* NativeSporadic.Carrier .M12 :=
    (Subgroup.topEquiv.symm.trans (MulEquiv.subgroupCongr hX.symm)).trans e
  have hR4 : 4 ≤ Nat.card R := by
    obtain ⟨U, hUK, hU, hU4⟩ := RankTwoSporadic.exists_four_le_of_two_le_pRank hH.rank
    obtain ⟨S, hS, hUS⟩ :=
      exists_isSylowOf_le hUK (fun v => ⟨1, Subtype.ext (by simpa using hU.2 v v.2)⟩)
    obtain ⟨c, -, hSc⟩ := Lemma22.exists_conj_eq_of_isSylowOf hR hS
    have h4 := Subgroup.card_le_of_le hUS
    rw [hSc, Lemma34.card_conj, hU4] at h4
    exact h4
  have hA60 : 60 ≤ Nat.card A := by
    have h1 := Subgroup.card_eq_card_quotient_mul_card_subgroup (center ↥A)
    have h2 : Nat.card (↥A ⧸ center ↥A) = 60 := by
      rw [show (↥A ⧸ center ↥A) = rankTwoQuot A from rfl, Nat.card_congr eq.toEquiv]
      exact RankTwoAltFive.card_A5
    have h3 : 0 < Nat.card (center ↥A) := Nat.card_pos
    rw [h1, h2]
    omega
  have ht1 : t ≠ 1 := by
    rintro rfl
    exact hout ⟨1, one_mem A, fun y _ => by group⟩
  have hto : orderOf t = 2 := orderOf_eq_prime ht2 ht1
  have hRA : R ≤ centralizer (A : Set G) := hR.le
  have hAR : A ≤ normalizer (R : Set G) :=
    (le_centralizer_iff.mp hRA).trans (centralizer_le_normalizer _)
  have htAR : t ∉ A ⊔ R := by
    intro htm
    have h1 : t ∈ ((A ⊔ R : Subgroup G) : Set G) := htm
    rw [coe_mul_of_left_le_normalizer_right A R hAR] at h1
    obtain ⟨a, ha, r, hr, har⟩ := h1
    refine hout ⟨a, ha, fun y hy => ?_⟩
    have hry : r * y = y * r := (mem_centralizer_iff.mp (hRA hr) y hy).symm
    rw [← har]
    calc a * r * y * (a * r)⁻¹ = a * (r * y) * r⁻¹ * a⁻¹ := by group
      _ = a * y * a⁻¹ := by rw [hry]; group
  have htN : zpowers t ≤ normalizer (R : Set G) := zpowers_le.mpr htR
  have hT2 : IsPGroup 2 (zpowers t) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hto, pow_one])
  have hW : IsPGroup 2 ↥(zpowers t ⊔ R) := hT2.to_sup_of_normal_right' hR.isPGroup htN
  have hWN : zpowers t ⊔ R ≤ normalizer (R : Set G) := sup_le htN le_normalizer
  have hReven : Even (Nat.card R) := by
    obtain ⟨k, hk⟩ := hR.isPGroup.exists_card_eq
    rw [hk] at hR4 ⊢
    rcases Nat.eq_zero_or_pos k with rfl | hk0
    · norm_num at hR4
    · exact (Nat.even_pow' hk0.ne').mpr even_two
  obtain ⟨r₀, hr₀R, hr₀o, hr₀c⟩ :=
    CFSG.GroupTheory.exists_involution_commute_of_isPGroup_le_normalizer hW hWN hReven
  have hCA : A ≤ centralizer ({r₀} : Set G) := fun a ha =>
    mem_centralizer_singleton_iff.mpr (mem_centralizer_iff.mp (hRA hr₀R) a ha)
  have hCW : zpowers t ⊔ R ≤ centralizer ({r₀} : Set G) := fun p hp =>
    mem_centralizer_singleton_iff.mpr (hr₀c p hp)
  have hle : (A ⊔ R) ⊔ zpowers t ≤ centralizer ({r₀} : Set G) :=
    sup_le (sup_le hCA (le_sup_right.trans hCW)) (le_sup_left.trans hCW)
  have hcAR : Nat.card ↥(A ⊔ R) = Nat.card A * Nat.card R :=
    card_sup_eq_mul (hRA.trans (centralizer_le_normalizer _))
      (inf_eq_bot_of_odd_center hodd hR.isPGroup hRA)
  have hnT : zpowers t ≤ normalizer ((A ⊔ R : Subgroup G) : Set G) :=
    zpowers_le.mpr (RankTwoAltFive.mem_normalizer_sup htA htR)
  have hinf : (A ⊔ R) ⊓ zpowers t = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    obtain ⟨hxAR, hxt⟩ := mem_inf.mp hx
    obtain ⟨k, rfl⟩ := mem_zpowers_iff.mp hxt
    rw [← zpow_mod_orderOf, hto] at hxAR ⊢
    rcases Int.emod_two_eq_zero_or_one k with h | h
    · rw [show ((2 : ℕ) : ℤ) = 2 by rfl, h, zpow_zero]
      exact one_mem _
    · rw [show ((2 : ℕ) : ℤ) = 2 by rfl, h, zpow_one] at hxAR
      exact absurd hxAR htAR
  have hcard : Nat.card ↥((A ⊔ R) ⊔ zpowers t) = Nat.card A * Nat.card R * 2 := by
    rw [card_sup_eq_mul hnT hinf, hcAR, Nat.card_zpowers, hto]
  have h480 : 480 ≤ Nat.card (centralizer ({r₀} : Set G)) := by
    have h1 := Subgroup.card_le_of_le hle
    rw [hcard] at h1
    have h2 : 60 * 4 ≤ Nat.card A * Nat.card R := Nat.mul_le_mul hA60 hR4
    omega
  rcases Sporadic.Schreier.card_centralizer_involution_of_mulEquiv_M12 eG hr₀o with h | h <;>
    omega

@[expose] def AltEvenCenterSmallNF : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (A : Subgroup G), RankTwoHypNF G A →
    standardComponentOddCore G = ⊥ → ∀ n : ℕ, 5 ≤ n → n ≤ 7 →
    Nonempty (rankTwoQuot A ≃* alternatingGroup (Fin n)) → Odd (Nat.card (center ↥A))

theorem altEvenCenterSmallNF_of (h32 : Lemma32) (h4 : Asc75Theorem4) (h34 : Asc08Lemma34)
    (hcfg : Section3Config) : AltEvenCenterSmallNF := by
  intro G _ _ A hH hO n hn5 hn7 ⟨e⟩
  obtain ⟨R, T, g, hc⟩ := exists_sec3_of hcfg (hyp31_ofNF hH hO hn5 e)
  obtain ⟨p, hp2, hpZ⟩ := exists_sq_eq_one_notMem_center hc h32 h4 h34
  have : Group.IsPerfect ↥A := (Group.isPerfect_def).2 hH.standard.1.1
  by_contra hodd
  apply hpZ
  rw [← ker_quotCenterHom e]
  exact alternatingCover_mem_ker_of_sq_eq_one hn5 hn7 (quotCenterHom e)
    (quotCenterHom_surjective e) (ker_quotCenterHom e).le
    (by rw [ker_quotCenterHom]; exact Nat.not_odd_iff_even.mp hodd) hp2

@[expose] def AltChildAtNF (n : ℕ) : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (A : Subgroup G), RankTwoHypNF G A →
    standardComponentOddCore G = ⊥ → Nonempty (rankTwoQuot A ≃* alternatingGroup (Fin n)) →
      Nonempty (rankTwoX A ≃* alternatingGroup (Fin (n + 4))) ∨
        (n = 5 ∧ NativeSporadic.IsSporadic (rankTwoX A) .J2) ∨
        (n = 5 ∧ NativeSporadic.IsSporadic (rankTwoX A) .M12 ∧ rankTwoX A ≠ ⊤)

theorem altChildAt_fiveNF
    (h32 : Lemma32) (h332 : Lemma33Two) (hcfg : Section3Config)
    (hI : AltFiveCaseINF) (hIIa : RankTwoAltFive.Asc310IIa)
    (hIIb : RankTwoAltFive.Asc310IIb) (hM12 : AltFiveM12NotTopNF)
    (hEven : AltEvenCenterSmallNF) : AltChildAtNF 5 := by
  intro G _ _ A hH hO hA5
  have hodd := hEven G A hH hO 5 le_rfl (by norm_num) hA5
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨R, hR⟩ := exists_isSylowOf 2 (centralizer (A : Set G))
  by_cases hconj : ∃ x : G, rightConjugate R x ≤ A
  · exact Or.inl (hI G A hH hO hA5 hodd R hR hconj)
  · push Not at hconj
    have h310 := asc08Lemma310NF_of_local
      (asc08Lemma310LocalNF_of_cases hIIa hIIb) h32 h332 hcfg
    rcases h310 G A hH hO hA5 hodd R hR hconj with hJ | ⟨hM, ht⟩
    · exact Or.inr (Or.inl ⟨rfl, hJ⟩)
    · exact Or.inr (Or.inr ⟨rfl, hM, hM12 G A hH hO hA5 hodd R hR hconj hM ht⟩)

