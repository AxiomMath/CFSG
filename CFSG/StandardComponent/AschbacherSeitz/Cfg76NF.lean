    · have h := congrArg Subtype.val (hU.1.is_comm.comm ⟨a.1.1, a.2⟩ ⟨b.1.1, b.2⟩)
      simpa using h
    · simpa using hU.2 _ hx
  · rw [show (2 : ℕ) ^ 2 = 4 by norm_num, ← hU4]
    exact Nat.card_congr (subgroupOfEquivOfLe hUW).toEquiv

structure Cfg76 (A R Y L : Subgroup G) : Prop where
  hyp : RankTwoHypNF G A
  hyp31 : AS76b.Hyp31 A
  sylowR : IsSylowOf 2 R (centralizer (A : Set G))
  not_le : ∀ x : G, ¬ rightConjugate R x ≤ A
  Y_le : Y ≤ A
  L_le : L ≤ A ⊓ centralizer (Y : Set G)
  a5 : Nonempty (rankTwoQuot L ≃* alternatingGroup (Fin 5))
  oddCenter : Odd (Nat.card (center ↥L))
  standard : standardComponentIsStandard (L.subgroupOf (centralizer (Y : Set G)))
  not_normal : ¬ (L.subgroupOf (centralizer (Y : Set G))).Normal
  noInv : NoInvolutoryCentralizing A (Y ⊔ L)
  outerFree : ∀ σ : MulAut ↥A, σ * σ = 1 → (∀ y : ↥A, (y : G) ∈ Y → σ y = y) →
    ∃ l ∈ L, ∀ z : ↥A, (z : G) ∈ L → ((σ z : ↥A) : G) = l * z * l⁻¹

namespace Cfg76

variable {A R Y L : Subgroup G} (hc : Cfg76 A R Y L)
include hc

theorem L_le_A : L ≤ A := hc.L_le.trans inf_le_left

theorem L_le_centralizer : L ≤ centralizer (Y : Set G) := hc.L_le.trans inf_le_right

theorem R_le_centralizer_Y : R ≤ centralizer (Y : Set G) :=
  hc.sylowR.le.trans (centralizer_le hc.Y_le)

theorem R_le_centralizer_L : R ≤ centralizer (L : Set G) :=
  hc.sylowR.le.trans (centralizer_le hc.L_le_A)

theorem isSylowOf_inf : IsSylowOf 2 R (centralizer (Y : Set G) ⊓ centralizer (L : Set G)) := by
  refine Lemma37.isSylowOf_of_isSylowOf_inf_normalizer ?_
  refine isSylowOf_of_noInvolutory hc.hyp31 hc.sylowR hc.noInv
    (le_inf (le_inf hc.R_le_centralizer_Y hc.R_le_centralizer_L) le_normalizer) ?_ inf_le_right
  intro x hx
  obtain ⟨⟨hxY, hxL⟩, -⟩ := mem_inf.mp hx
  exact mem_centralizer_sup hxY hxL

theorem rank : 2 ≤ Open.pRank 2 (centralizer (A : Set G)) := hc.hyp.rank

theorem rankTwoHyp :
    RankTwoHypNF ↥(centralizer (Y : Set G)) (L.subgroupOf (centralizer (Y : Set G))) :=
  ⟨hc.standard, hc.not_normal,
    two_le_pRank_centralizer_subgroupOf' hc.Y_le hc.L_le_A hc.rank⟩

theorem isSporadic_j2 (h5 : Asc08Lemma310NF) :
    NativeSporadic.IsSporadic (rankTwoX ((L.subgroupOf (centralizer (Y : Set G))).map
      (QuotientGroup.mk' (standardComponentOddCore ↥(centralizer (Y : Set G)))))) .J2 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set C := centralizer (Y : Set G) with hC
  have hLC : L ≤ C := hc.L_le_centralizer
  have hRC : R ≤ C := hc.R_le_centralizer_Y
  set e := subgroupOfEquivOfLe hLC
  obtain ⟨f⟩ := hc.a5
  refine isSporadic_j2_of_standard h5 (R := R.subgroupOf C) hc.rankTwoHyp
    ⟨(QuotientGroup.congr (center _) (center _) e (Subgroup.map_center_eq e)).trans f⟩ ?_ ?_ ?_ ?_
  · rw [Nat.card_congr (Subgroup.centerCongr e).toEquiv]
    exact hc.oddCenter
  · rw [Lemma37.centralizer_subgroupOf hLC,
      ← Subgroup.inf_subgroupOf_left (centralizer (L : Set G)) C,
      Lemma37.isSylowOf_subgroupOf_iff hRC inf_le_left]
    exact hc.isSylowOf_inf
  · intro x hle
    apply hc.not_le (x : G)
    intro r hr
    rw [mem_rightConjugate_iff] at hr
    have hrC : r ∈ C := by
      have h1 : (x : G) * r * (x : G)⁻¹ ∈ C := hRC hr
      have h2 : r = (x : G)⁻¹ * ((x : G) * r * (x : G)⁻¹) * (x : G) := by group
      rw [h2]
      exact mul_mem (mul_mem (inv_mem x.2) h1) x.2
    have h2 : (⟨r, hrC⟩ : ↥C) ∈ rightConjugate (R.subgroupOf C) x := by
      rw [mem_rightConjugate_iff, mem_subgroupOf]
      simpa using hr
    exact hc.L_le_A (mem_subgroupOf.mp (hle h2))
  · intro b hb2 _ hbR
    have hbR' : (b : G) ∈ normalizer (R : Set G) := by
      rw [← subgroupOf_normalizer_eq hRC] at hbR
      exact hbR
    have hbA : (b : G) ∈ normalizer (A : Set G) := by
      have h := Lemma36.normalizer_le hc.hyp31 hc.sylowR 1
      rw [rightConjugate_one, rightConjugate_one] at h
      exact h hbR'
    have h2 : (b : G) ^ 2 = 1 := by simpa using congrArg Subtype.val hb2
    have hσσ : conjAut hbA * conjAut hbA = 1 := by
      refine MulEquiv.ext fun x => Subtype.ext ?_
      rw [MulAut.mul_apply, conjAut_apply, conjAut_apply, MulAut.one_apply]
      calc (b : G) * ((b : G) * x * (b : G)⁻¹) * (b : G)⁻¹ =
          (b : G) ^ 2 * x * ((b : G) ^ 2)⁻¹ := by rw [sq]; group
        _ = x := by rw [h2]; group
    obtain ⟨l, hl, hlσ⟩ := hc.outerFree _ hσσ fun y hy => Subtype.ext (by
      rw [conjAut_apply, ← mem_centralizer_iff.mp b.2 y hy, mul_inv_cancel_right])
    refine ⟨⟨l, hLC hl⟩, hl, fun y hy => Subtype.ext ?_⟩
    have h3 := hlσ ⟨y, hc.L_le_A (mem_subgroupOf.mp hy)⟩ (mem_subgroupOf.mp hy)
    rw [conjAut_apply] at h3
    simpa using h3

omit hc [Finite G] in
theorem conjAut_mul_conjAut {s : G} (hs : s ∈ normalizer (A : Set G)) :
    conjAut hs * conjAut (inv_mem hs) = 1 := by
  refine MulEquiv.ext fun x => Subtype.ext ?_
  rw [MulAut.mul_apply, conjAut_apply, conjAut_apply, MulAut.one_apply]
  group

omit hc [Finite G] in
theorem conjAut_inv_mul_conjAut {s : G} (hs : s ∈ normalizer (A : Set G)) :
    conjAut (inv_mem hs) * conjAut hs = 1 := by
  refine MulEquiv.ext fun x => Subtype.ext ?_
  rw [MulAut.mul_apply, conjAut_apply, conjAut_apply, MulAut.one_apply]
  group

theorem conj {s : G} (hs : s ∈ A) : Cfg76 A R (rightConjugate Y s) (rightConjugate L s) := by
  have hsN : s ∈ normalizer (A : Set G) := le_normalizer hs
  have hAs : rightConjugate A s = A := (rightConjugate_eq_self_iff A s).mpr hsN
  set e : ↥L ≃* ↥(rightConjugate L s) := (MulAut.conj s⁻¹).subgroupMap L
  have hCY : (centralizer (Y : Set G)).map (MulAut.conj s⁻¹).toMonoidHom =
      centralizer (rightConjugate Y s : Set G) := (AS76b.centralizer_rightConjugate Y s).symm
  set ψ : ↥(centralizer (Y : Set G)) ≃* ↥(centralizer (rightConjugate Y s : Set G)) :=
    ((MulAut.conj s⁻¹).subgroupMap _).trans (MulEquiv.subgroupCongr hCY)
  have hψ : ∀ x, ((ψ x : ↥(centralizer (rightConjugate Y s : Set G))) : G) = s⁻¹ * x * s := by
    intro x
    change MulAut.conj s⁻¹ (x : G) = _
    rw [MulAut.conj_apply, inv_inv]
  have hmap : (L.subgroupOf (centralizer (Y : Set G))).map ψ.toMonoidHom =
      (rightConjugate L s).subgroupOf (centralizer (rightConjugate Y s : Set G)) := by
    ext y
    rw [mem_subgroupOf, mem_rightConjugate_iff]
    constructor
    · rintro ⟨x, hx, rfl⟩
      rw [MulEquiv.coe_toMonoidHom, hψ]
      simpa [mul_assoc] using mem_subgroupOf.mp hx
    · intro hy
      have hyC : s * (y : G) * s⁻¹ ∈ centralizer (Y : Set G) := by
        have h1 : (y : G) ∈ rightConjugate (centralizer (Y : Set G)) s := by
          rw [← AS76b.centralizer_rightConjugate]
          exact y.2
        exact (mem_rightConjugate_iff _ s y).mp h1
      refine ⟨⟨s * y * s⁻¹, hyC⟩, mem_subgroupOf.mpr hy, Subtype.ext ?_⟩
      rw [MulEquiv.coe_toMonoidHom, hψ]
      group
  set τ := conjAut (inv_mem hsN) with hτ
  set τ' := conjAut hsN with hτ'
  have hτx : ∀ x : ↥A, ((τ x : ↥A) : G) = s⁻¹ * x * s := by
    intro x
    rw [hτ, conjAut_apply, inv_inv]
  have hτ'x : ∀ x : ↥A, ((τ' x : ↥A) : G) = s * x * s⁻¹ := fun x => conjAut_apply hsN x
  have hτ'τ : τ' * τ = 1 := conjAut_mul_conjAut hsN
  have hττ' : τ * τ' = 1 := conjAut_inv_mul_conjAut hsN
  have hmemY : ∀ y : G, y ∈ Y → s⁻¹ * y * s ∈ rightConjugate Y s := fun y hy => by
    rw [mem_rightConjugate_iff]
    simpa [mul_assoc] using hy
  refine ⟨hc.hyp, hc.hyp31, hc.sylowR, hc.not_le, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [← hAs]
    exact map_mono hc.Y_le
  · rw [AS76b.centralizer_rightConjugate]
    calc rightConjugate L s ≤ rightConjugate (A ⊓ centralizer (Y : Set G)) s := map_mono hc.L_le
      _ = rightConjugate A s ⊓ rightConjugate (centralizer (Y : Set G)) s :=
          map_inf_eq _ _ _ (MulAut.conj s⁻¹).injective
      _ = A ⊓ rightConjugate (centralizer (Y : Set G)) s := by rw [hAs]
  · obtain ⟨f⟩ := hc.a5
    exact ⟨(QuotientGroup.congr (center _) (center _) e (Subgroup.map_center_eq e)).symm.trans f⟩
  · rw [← Nat.card_congr (Subgroup.centerCongr e).toEquiv]
    exact hc.oddCenter
  · rw [← hmap]
    exact standardComponentIsStandard_map_equiv ψ hc.standard
  · intro hn
    apply hc.not_normal
    have h1 := hn.comap ψ.toMonoidHom
    rwa [← hmap, comap_map_eq_self_of_injective ψ.injective] at h1
  · intro σ' hσ' hfix
    have hσ : τ' * σ' * τ * (τ' * σ' * τ) = 1 := by
      rw [show τ' * σ' * τ * (τ' * σ' * τ) = τ' * σ' * (τ * τ') * σ' * τ by group, hττ',
        mul_one, mul_assoc τ', hσ', mul_one, hτ'τ]
    have h1 := hc.noInv (τ' * σ' * τ) hσ fun x hx => by
      have hτx' : (τ x : G) ∈ rightConjugate Y s ⊔ rightConjugate L s := by
        have hsup : rightConjugate (Y ⊔ L) s = rightConjugate Y s ⊔ rightConjugate L s :=
          Subgroup.map_sup _ _ _
        rw [hτx, ← hsup, mem_rightConjugate_iff]
        simpa [mul_assoc] using hx
      rw [MulAut.mul_apply, MulAut.mul_apply, hfix _ hτx', ← MulAut.mul_apply, hτ'τ,
        MulAut.one_apply]
    calc σ' = τ * (τ' * σ' * τ) * τ' := by
          rw [show τ * (τ' * σ' * τ) * τ' = (τ * τ') * σ' * (τ * τ') by group, hττ', one_mul,
            mul_one]
      _ = 1 := by rw [h1, mul_one, hττ']
  · intro σ' hσ' hfix
    have hσ : τ' * σ' * τ * (τ' * σ' * τ) = 1 := by
      rw [show τ' * σ' * τ * (τ' * σ' * τ) = τ' * σ' * (τ * τ') * σ' * τ by group, hττ',
        mul_one, mul_assoc τ', hσ', mul_one, hτ'τ]
    obtain ⟨l, hl, hlσ⟩ := hc.outerFree (τ' * σ' * τ) hσ fun y hy => by
      rw [MulAut.mul_apply, MulAut.mul_apply, hfix _ (by rw [hτx]; exact hmemY y hy),
        ← MulAut.mul_apply, hτ'τ, MulAut.one_apply]
    refine ⟨s⁻¹ * l * s, by rw [mem_rightConjugate_iff]; simpa [mul_assoc] using hl, ?_⟩
    intro z hz
    have hz' : ((τ' z : ↥A) : G) ∈ L := by
      rw [hτ'x]
      exact (mem_rightConjugate_iff L s z).mp hz
    have h1 := hlσ (τ' z) hz'
    have hττ'z : ∀ w : ↥A, τ (τ' w) = w := fun w => by
      rw [← MulAut.mul_apply, hττ', MulAut.one_apply]
    have h2 : σ' z = τ ((τ' * σ' * τ) (τ' z)) := by
      rw [MulAut.mul_apply, MulAut.mul_apply, hττ'z, hττ'z]
    rw [h2, hτx, h1, hτ'x]
    group

end Cfg76

@[expose] def E76 (Y L : Subgroup G) : Subgroup G :=
  (normalClosure ((L.subgroupOf (centralizer (Y : Set G)) : Subgroup ↥(centralizer (Y : Set G))) :
    Set ↥(centralizer (Y : Set G)))).map (centralizer (Y : Set G)).subtype

@[expose] def O76 (Y : Subgroup G) : Subgroup G :=
  (standardComponentOddCore ↥(centralizer (Y : Set G))).map (centralizer (Y : Set G)).subtype

omit [Finite G] in
theorem isElemAbelian_subgroupOf' {p : ℕ} {V X : Subgroup G} (hV : IsElemAbelian p V) :
    IsElemAbelian p (V.subgroupOf X) := CFSG.Open.IsElemAbelian.subgroupOf hV X

namespace Cfg76

variable {A R Y L : Subgroup G} (hc : Cfg76 A R Y L)
include hc

theorem center_eq_bot : center ↥(L.subgroupOf (centralizer (Y : Set G))) = ⊥ ∧
    Nat.card (L.subgroupOf (centralizer (Y : Set G))) = 60 := by
  set e := subgroupOfEquivOfLe hc.L_le_centralizer
  obtain ⟨f⟩ := hc.a5
  refine center_eq_bot_of_a5 hc.standard.1 ?_
    ⟨(QuotientGroup.congr (center _) (center _) e (Subgroup.map_center_eq e)).trans f⟩
  rw [Nat.card_congr (Subgroup.centerCongr e).toEquiv]
  exact hc.oddCenter

theorem isElemAbelian_R (h32 : Lemma32) :
    IsElemAbelian 2 (R.subgroupOf (centralizer (Y : Set G))) :=
  isElemAbelian_subgroupOf' (h32 G A hc.hyp31 R hc.sylowR)

theorem four_le_R : 4 ≤ Nat.card (R.subgroupOf (centralizer (Y : Set G))) := by
  rw [Nat.card_congr (subgroupOfEquivOfLe hc.R_le_centralizer_Y).toEquiv]
  exact Lemma36.four_le_card hc.hyp31 hc.sylowR

theorem R_le_centralizer' : R.subgroupOf (centralizer (Y : Set G)) ≤
    centralizer ((L.subgroupOf (centralizer (Y : Set G)) : Subgroup ↥(centralizer (Y : Set G))) :
      Set ↥(centralizer (Y : Set G))) := by
  rw [Lemma37.centralizer_subgroupOf hc.L_le_centralizer]
  intro r hr
  exact mem_subgroupOf.mpr (hc.R_le_centralizer_L (mem_subgroupOf.mp hr))

theorem exists_conj
    (h5 : Asc08Lemma310NF) (h32 : Lemma32) (hJ : J2Std.J2StdFacts) {x : G} (hxL : x ∈ L)
    (hx5 : orderOf x = 5) :
    ∃ c ∈ centralizer (Y : Set G) ⊓ centralizer ({x} : Set G), ∃ r ∈ R,
      c * r * c⁻¹ ∉ centralizer (L : Set G) := by
  obtain ⟨hZ, h60⟩ := hc.center_eq_bot
  have hxC : x ∈ centralizer (Y : Set G) := hc.L_le_centralizer hxL
  obtain ⟨c, hcx, r, hr, hcr⟩ := exists_conj_not_mem_centralizer hJ hc.rankTwoHyp
    (hc.isSporadic_j2 h5) (hc.isElemAbelian_R h32) hc.four_le_R hc.R_le_centralizer' hZ h60
    (x := ⟨x, hxC⟩) (mem_subgroupOf.mpr hxL) (by rw [Subgroup.orderOf_mk]; exact hx5)
  refine ⟨c, mem_inf.mpr ⟨c.2, ?_⟩, r, mem_subgroupOf.mp hr, fun hmem => hcr ?_⟩
  · rw [mem_centralizer_singleton_iff] at hcx ⊢
    exact congrArg Subtype.val hcx
  · rw [Lemma37.centralizer_subgroupOf hc.L_le_centralizer, mem_subgroupOf]
    simpa using hmem

omit [Finite G] hc in
theorem E76_le_centralizer : E76 Y L ≤ centralizer (Y : Set G) := map_subtype_le _

theorem R_le_E
    (h5 : Asc08Lemma310NF) (h32 : Lemma32) {x : G} (hxL : x ∈ L) (hx5 : orderOf x = 5) :
    R ≤ E76 Y L := by
  obtain ⟨hZ, -⟩ := hc.center_eq_bot
  have hxC : x ∈ centralizer (Y : Set G) := hc.L_le_centralizer hxL
  have h := le_normalClosure_of_elem hc.rankTwoHyp (hc.isSporadic_j2 h5) (hc.isElemAbelian_R h32)
    hc.R_le_centralizer' hZ (x := ⟨x, hxC⟩) (mem_subgroupOf.mpr hxL)
    (by rw [Subgroup.orderOf_mk]; exact hx5)
  intro r hr
  exact ⟨⟨r, hc.R_le_centralizer_Y hr⟩, h (mem_subgroupOf.mpr hr), rfl⟩

theorem mem_O76_of_central {z : G} (hz : z ∈ E76 Y L)
    (hzc : ∀ w ∈ E76 Y L, z * w = w * z) : z ∈ O76 Y := by
  obtain ⟨z', hz', rfl⟩ := hz
  refine ⟨z', mem_oddCore_of_central hc.rankTwoHyp fun w hw => ?_, rfl⟩
  exact Subtype.ext (hzc w ⟨w, hw, rfl⟩)

theorem card_E76 (h5 : Asc08Lemma310NF) :
    Nat.card (E76 Y L) = 604800 * Nat.card ↥(E76 Y L ⊓ O76 Y) := by
  have h := card_normalClosure (hc.isSporadic_j2 h5)
  rw [E76, O76, ← map_inf_eq _ _ _ (subtype_injective _),
    card_map_of_injective (subtype_injective _), card_map_of_injective (subtype_injective _)]
  exact h

theorem conj_mem_E
    (h4 : Asc75Theorem4) (h32 : Lemma32) (h34 : Asc08Lemma34)
    (h5 : Asc08Lemma310NF) {Z : Subgroup G} (hZY : Z ≤ Y) (hZA : Z ≤ A)
    (hlay : layerCentralizer A Z = L) (hnoZ : NoInvolutoryCentralizing A (Z ⊔ L)) :
    ∀ c ∈ centralizer (Z : Set G), ∀ r ∈ E76 Y L, r ^ 2 = 1 → c * r * c⁻¹ ∈ E76 Y L := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set CZ := centralizer (Z : Set G) with hCZ
  have hCYZ : centralizer (Y : Set G) ≤ CZ := centralizer_le hZY
  have hLZ : L ≤ A ⊓ CZ := hlay ▸ layerCentralizer_le A Z
  have hLCZ : L ≤ CZ := hLZ.trans inf_le_right
  have hNL : normalizer (A : Set G) ⊓ CZ ≤ normalizer (L : Set G) :=
    hlay ▸ normalizer_inf_le_normalizer_layerCentralizer A Z
  have hRZ : R ≤ CZ := hc.sylowR.le.trans (centralizer_le hZA)
  have hRL : IsSylowOf 2 R (CZ ⊓ centralizer (L : Set G) ⊓ normalizer (R : Set G)) := by
    refine isSylowOf_of_noInvolutory hc.hyp31 hc.sylowR hnoZ
      (le_inf (le_inf hRZ hc.R_le_centralizer_L) le_normalizer) ?_ inf_le_right
    intro y hy
    obtain ⟨⟨hyZ, hyL⟩, -⟩ := mem_inf.mp hy
    exact mem_centralizer_sup hyZ hyL
  have hLq : CFSG.Open.IsQuasisimple ↥L :=
    (Lemma37.isQuasisimple_subgroupOf_iff hc.L_le_centralizer).mp hc.standard.1
  have hstd : standardComponentIsStandard (L.subgroupOf CZ) := by
    rcases lemma37_bender_of_le h4 h32 h34 hc.hyp31 hc.sylowR hZA hLq hLZ hNL hRL with
      h | ⟨c, -, -, -, hRc, -⟩
    · exact h
    · exfalso
      apply hc.not_le c
      rw [conj_eq_rightConjugate] at hRc
      calc rightConjugate R c ≤ rightConjugate (rightConjugate L c⁻¹) c := map_mono hRc
        _ = L := by rw [rightConjugate_mul, inv_mul_cancel, rightConjugate_one]
        _ ≤ A := hc.L_le_A
  have hnn : ¬ (L.subgroupOf CZ).Normal := by
    intro hn
    apply hc.not_normal
    refine ⟨fun n hn' g => ?_⟩
    have h1 := hn.conj_mem ⟨n, hCYZ n.2⟩ hn' ⟨g, hCYZ g.2⟩
    rw [mem_subgroupOf] at h1 ⊢
    simpa using h1
  have hH₂ : RankTwoHypNF ↥CZ (L.subgroupOf CZ) :=
    ⟨hstd, hnn, two_le_pRank_centralizer_subgroupOf' hZA hc.L_le_A hc.rank⟩
  set e := subgroupOfEquivOfLe hLCZ
  obtain ⟨f⟩ := hc.a5
  have hX : Nat.card (rankTwoX ((L.subgroupOf CZ).map
      (QuotientGroup.mk' (standardComponentOddCore ↥CZ)))) ≤ 604800 := by
    refine card_rankTwoX_le h5 hH₂ (R := R.subgroupOf CZ)
      ⟨(QuotientGroup.congr (center _) (center _) e (Subgroup.map_center_eq e)).trans f⟩ ?_ ?_ ?_
    · rw [Nat.card_congr (Subgroup.centerCongr e).toEquiv]
      exact hc.oddCenter
    · rw [Lemma37.centralizer_subgroupOf hLCZ,
        ← Subgroup.inf_subgroupOf_left (centralizer (L : Set G)) CZ,
        Lemma37.isSylowOf_subgroupOf_iff hRZ inf_le_left]
      exact Lemma37.isSylowOf_of_isSylowOf_inf_normalizer hRL
    · intro x hle
      apply hc.not_le (x : G)
      intro r hr
      rw [mem_rightConjugate_iff] at hr
      have hrC : r ∈ CZ := by
        have h1 : (x : G) * r * (x : G)⁻¹ ∈ CZ := hRZ hr
        have h2 : r = (x : G)⁻¹ * ((x : G) * r * (x : G)⁻¹) * (x : G) := by group
        rw [h2]
        exact mul_mem (mul_mem (inv_mem x.2) h1) x.2
      have h2 : (⟨r, hrC⟩ : ↥CZ) ∈ rightConjugate (R.subgroupOf CZ) x := by
        rw [mem_rightConjugate_iff, mem_subgroupOf]
        simpa using hr
      exact hc.L_le_A (mem_subgroupOf.mp (hle h2))
  have hEC : E76 Y L ≤ CZ := (E76_le_centralizer).trans hCYZ
  set EZ := (E76 Y L).subgroupOf CZ with hEZdef
  have hEZ : EZ ≤ normalClosure ((L.subgroupOf CZ : Subgroup ↥CZ) : Set ↥CZ) := by
    rintro ⟨w, hwC⟩ hw
    obtain ⟨w', hw', rfl⟩ := mem_subgroupOf.mp hw
    have hι := map_normalClosure_le ((L.subgroupOf (centralizer (Y : Set G)) :
      Subgroup ↥(centralizer (Y : Set G))) : Set ↥(centralizer (Y : Set G))) (inclusion hCYZ)
    have h1 : inclusion hCYZ w' ∈ normalClosure (inclusion hCYZ ''
        ((L.subgroupOf (centralizer (Y : Set G)) : Subgroup ↥(centralizer (Y : Set G))) :
          Set ↥(centralizer (Y : Set G)))) := hι ⟨w', hw', rfl⟩
    refine normalClosure_mono ?_ h1
    rintro _ ⟨l, hl, rfl⟩
    exact mem_subgroupOf.mpr (mem_subgroupOf.mp hl)
  have hOE : standardComponentOddCore ↥CZ ≤ centralizer (EZ : Set ↥CZ) :=
    (oddCore_le_centralizer_normalClosure hH₂).trans (centralizer_le hEZ)
  have hcard : 604800 ≤ Nat.card (EZ.map (QuotientGroup.mk' (standardComponentOddCore ↥CZ))) := by
    have h1 := card_map_mk'_mul EZ
    have h2 : Nat.card EZ = Nat.card (E76 Y L) := Nat.card_congr (subgroupOfEquivOfLe hEC).toEquiv
    have h3 := hc.card_E76 h5
    have h4 : Nat.card ↥(EZ ⊓ standardComponentOddCore ↥CZ) ≤ Nat.card ↥(E76 Y L ⊓ O76 Y) := by
      rw [← card_map_of_injective (subtype_injective CZ)]
      refine card_le_of_le ?_
      rintro _ ⟨z, ⟨hzE, hzO⟩, rfl⟩
      refine ⟨mem_subgroupOf.mp hzE, hc.mem_O76_of_central (mem_subgroupOf.mp hzE) ?_⟩
      intro w hw
      have h5' := (mem_centralizer_iff.mp (hOE hzO)) ⟨w, hEC hw⟩ (mem_subgroupOf.mpr hw)
      exact (congrArg Subtype.val h5').symm
    have hpos : 0 < Nat.card ↥(EZ ⊓ standardComponentOddCore ↥CZ) := Nat.card_pos
    rw [h2, h3] at h1
    refine Nat.le_of_mul_le_mul_right ?_ hpos
    calc 604800 * Nat.card ↥(EZ ⊓ standardComponentOddCore ↥CZ) ≤
        604800 * Nat.card ↥(E76 Y L ⊓ O76 Y) := Nat.mul_le_mul_left _ h4
      _ = _ := h1.symm
  have hN := normal_sup_of_card hEZ hX hcard
  intro c hc' r hr hr2
  have hrZ : (⟨r, hEC hr⟩ : ↥CZ) ∈ EZ := mem_subgroupOf.mpr hr
  have h1 := hN.conj_mem _ (mem_sup_left hrZ) ⟨c, hc'⟩
  have h2 : (⟨c, hc'⟩ * ⟨r, hEC hr⟩ * (⟨c, hc'⟩ : ↥CZ)⁻¹) ^ 2 ^ 1 = 1 := by
    apply Subtype.ext
    simp only [Subgroup.coe_pow, Subgroup.coe_mul, Subgroup.coe_inv, OneMemClass.coe_one, pow_one]
    rw [sq, show c * r * c⁻¹ * (c * r * c⁻¹) = c * (r * r) * c⁻¹ by group, ← sq, hr2]
    group
  have h3 := mem_of_mem_sup odd_card_standardComponentOddCore hOE h1 h2
  exact mem_subgroupOf.mp h3

end Cfg76

theorem Cfg76.facts_at {A R Y L Z : Subgroup G} (hc : Cfg76 A R Y L)
    (h32 : Lemma32) (hZA : Z ≤ A) (hLZ : L ≤ centralizer (Z : Set G))
    (hstd : standardComponentIsStandard (L.subgroupOf (centralizer (Z : Set G))))
    (hnn : ¬ (L.subgroupOf (centralizer (Z : Set G))).Normal)
    (hnoZ : NoInvolutoryCentralizing A (Z ⊔ L)) :
    RankTwoHypNF ↥(centralizer (Z : Set G)) (L.subgroupOf (centralizer (Z : Set G))) ∧
      center ↥(L.subgroupOf (centralizer (Z : Set G))) = ⊥ ∧
      Nat.card (L.subgroupOf (centralizer (Z : Set G))) = 60 ∧
      ⁅L.subgroupOf (centralizer (Z : Set G)), L.subgroupOf (centralizer (Z : Set G))⁆ =
        L.subgroupOf (centralizer (Z : Set G)) ∧
      IsElemAbelian 2 (R.subgroupOf (centralizer (Z : Set G))) ∧
      4 ≤ Nat.card (R.subgroupOf (centralizer (Z : Set G))) ∧
      R.subgroupOf (centralizer (Z : Set G)) ≤ centralizer
        ((L.subgroupOf (centralizer (Z : Set G)) : Subgroup ↥(centralizer (Z : Set G))) :
          Set ↥(centralizer (Z : Set G))) ∧
      IsSylowOf 2 (R.subgroupOf (centralizer (Z : Set G))) (centralizer
        ((L.subgroupOf (centralizer (Z : Set G)) : Subgroup ↥(centralizer (Z : Set G))) :
          Set ↥(centralizer (Z : Set G)))) ∧
      (∀ x : ↥(centralizer (Z : Set G)), ¬ rightConjugate (R.subgroupOf
        (centralizer (Z : Set G))) x ≤ L.subgroupOf (centralizer (Z : Set G))) ∧
      Nonempty (rankTwoQuot (L.subgroupOf (centralizer (Z : Set G))) ≃*
        alternatingGroup (Fin 5)) ∧
      Odd (Nat.card (center ↥(L.subgroupOf (centralizer (Z : Set G))))) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set C := centralizer (Z : Set G) with hCdef
  have hRC : R ≤ C := hc.sylowR.le.trans (centralizer_le hZA)
  set e := subgroupOfEquivOfLe hLZ
  obtain ⟨f⟩ := hc.a5
  have ha5 : Nonempty (rankTwoQuot (L.subgroupOf C) ≃* alternatingGroup (Fin 5)) :=
    ⟨(QuotientGroup.congr (center _) (center _) e (Subgroup.map_center_eq e)).trans f⟩
  have hodd : Odd (Nat.card (center ↥(L.subgroupOf C))) := by
    rw [Nat.card_congr (Subgroup.centerCongr e).toEquiv]
    exact hc.oddCenter
  obtain ⟨hZ, h60⟩ := center_eq_bot_of_a5 hstd.1 hodd ha5
  have hH : RankTwoHypNF ↥C (L.subgroupOf C) :=
    ⟨hstd, hnn, two_le_pRank_centralizer_subgroupOf' hZA hc.L_le_A hc.rank⟩
  have hRL : IsSylowOf 2 R (C ⊓ centralizer (L : Set G)) := by
    refine Lemma37.isSylowOf_of_isSylowOf_inf_normalizer ?_
    refine isSylowOf_of_noInvolutory hc.hyp31 hc.sylowR hnoZ
      (le_inf (le_inf hRC hc.R_le_centralizer_L) le_normalizer) ?_ inf_le_right
    intro x hx
    obtain ⟨⟨hxZ, hxL⟩, -⟩ := mem_inf.mp hx
    exact mem_centralizer_sup hxZ hxL
  refine ⟨hH, hZ, h60, commutator_eq_self_of_perfect hstd.1.1,
    ?_, ?_, ?_, ?_, ?_, ha5, hodd⟩
  · have hV := h32 G A hc.hyp31 R hc.sylowR
    refine ⟨⟨⟨fun a b => ?_⟩⟩, fun a ha => ?_⟩
    · apply Subtype.ext
      apply Subtype.ext
      simpa using congrArg Subtype.val (hV.1.is_comm.comm ⟨((a : C) : G), a.2⟩ ⟨((b : C) : G), b.2⟩)
    · rw [mem_subgroupOf] at ha
      exact Subtype.ext (by simpa using hV.2 _ ha)
  · rw [Nat.card_congr (subgroupOfEquivOfLe hRC).toEquiv]
    exact Lemma36.four_le_card hc.hyp31 hc.sylowR
  · rw [Lemma37.centralizer_subgroupOf hLZ]
    intro r hr
    exact mem_subgroupOf.mpr (hc.R_le_centralizer_L (mem_subgroupOf.mp hr))
  · rw [Lemma37.centralizer_subgroupOf hLZ,
      ← Subgroup.inf_subgroupOf_left (centralizer (L : Set G)) C,
      Lemma37.isSylowOf_subgroupOf_iff hRC inf_le_left]
    exact hRL
  · intro x hle
    apply hc.not_le (x : G)
    intro r hr
    rw [mem_rightConjugate_iff] at hr
    have hrC : r ∈ C := by
      have h1 : (x : G) * r * (x : G)⁻¹ ∈ C := hRC hr
      have h2 : r = (x : G)⁻¹ * ((x : G) * r * (x : G)⁻¹) * (x : G) := by group
      rw [h2]
      exact mul_mem (mul_mem (inv_mem x.2) h1) x.2
    have h2 : (⟨r, hrC⟩ : ↥C) ∈ rightConjugate (R.subgroupOf C) x := by
      rw [mem_rightConjugate_iff, mem_subgroupOf]
      simpa using hr
    exact hc.L_le_A (mem_subgroupOf.mp (hle h2))

end NF

