@[expose] def SpClassicalType (Q : Type) [Group Q] : Prop :=
  ∃ n f : ℕ, 2 ≤ n ∧ 2 ≤ f ∧ StatedClassicalModel Q .PSp n 2 f

theorem SpClassicalType.toEvenType {Q : Type} [Group Q] (h : SpClassicalType Q) :
    RankTwoClassicalEvenType Q := by
  obtain ⟨n, f, hn, hf, hM⟩ := h
  refine classicalEvenType_of_model hM ?_ ?_
  · exact Or.inr (Or.inr (Or.inl ⟨rfl, hn⟩))
  · have hle : 7 ≤ f * (n * n) := by
      have h1 : 2 * (2 * 2) ≤ f * (n * n) := Nat.mul_le_mul hf (Nat.mul_le_mul hn hn)
      omega
    refine two_pow_seven_dvd_of_model ?_ ?_ hM
    · simp [EvenSmallLie.CatalogOrders.lieMin]; omega
    · simpa [EvenSmallLie.CatalogOrders.lieExp] using hle

structure SpHyp (A : Subgroup G) : Prop where
  standard : standardComponentIsStandard A
  oddCore : standardComponentOddCore G = ⊥
  not_normal : ¬ A.Normal
  rank : 2 ≤ CFSG.Open.pRank 2 (Subgroup.centralizer (A : Set G))
  type : SpClassicalType (rankTwoQuot A)

namespace SpHyp

variable {A : Subgroup G}

theorem toNF (h : SpHyp A) : RankTwoHypNF G A :=
  ⟨h.standard, h.not_normal, h.rank⟩

theorem hyp31 (h : SpHyp A) (hII : ClassicalHypII) : Hyp31 A :=
  ⟨h.standard, hII ↥A h.standard.1.1 h.type.toEvenType, h.oddCore, h.rank, h.not_normal⟩

end SpHyp

@[expose] def SpClassicalGeneral : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (A : Subgroup G), SpHyp A → False

@[expose] def SpClassicalNormal : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (A : Subgroup G), standardComponentIsStandard A →
    standardComponentOddCore G = ⊥ → 2 ≤ CFSG.Open.pRank 2 (Subgroup.centralizer (A : Set G)) →
    SpClassicalType (rankTwoQuot A) → A.Normal

theorem exists_rankTwoHypNF_quotient {A : Subgroup G} (hH : RankTwoHypNF G A) :
    ∃ B : Subgroup (G ⧸ standardComponentOddCore G),
      RankTwoHypNF (G ⧸ standardComponentOddCore G) B ∧
      standardComponentOddCore (G ⧸ standardComponentOddCore G) = ⊥ ∧
      Nonempty (rankTwoQuot A ≃* rankTwoQuot B) := by
  have hodd := odd_card_standardComponentOddCore (G := G)
  have hNA := standardComponentOddCore_le_centralizer hH.standard hH.rank
  refine ⟨A.map (QuotientGroup.mk' (standardComponentOddCore G)), ⟨?_, ?_, ?_⟩,
    standardComponentOddCore_quotient_eq_bot, ⟨quotCenterEquivMap hNA hH.standard.1.1⟩⟩
  · exact standard_map hH.standard hodd hNA
  · intro hn
    apply hH.not_normal
    have h1 : (A ⊔ standardComponentOddCore G).Normal := by
      have := hn.comap (QuotientGroup.mk' (standardComponentOddCore G))
      rwa [comap_map_eq, QuotientGroup.ker_mk'] at this
    rw [← normalizer_eq_top_iff, ← normalizer_sup_eq hodd hNA hH.standard.1.1]
    exact normalizer_eq_top_iff.mpr h1
  · exact two_le_pRank_map hodd hNA hH.standard.1.1 hH.rank

theorem center_eq_bot_of_rankTwoHypNF {A : Subgroup G} (hH : RankTwoHypNF G A)
    (hO : standardComponentOddCore G = ⊥) : center G = ⊥ := by
  by_cases hodd : Odd (Nat.card (center G))
  · have h : center G ≤ standardComponentOddCore G := le_sSup ⟨inferInstance, hodd⟩
    rw [hO] at h
    exact le_bot_iff.mp h
  · exfalso
    apply hH.not_normal
    have htight := AS76b.tightlyEmbedded_centralizer hH.standard
    rw [← normalizer_eq_top_iff, ← AS76b.normalizer_centralizer_eq hH.standard, eq_top_iff]
    intro g _
    by_contra hg
    have h := htight.2 g hg
    have hZK : center G ≤ Subgroup.centralizer (A : Set G) := fun z hz =>
      mem_centralizer_iff.mpr fun a _ => (mem_center_iff.mp hz a)
    have hle : center G ≤ Subgroup.centralizer (A : Set G) ⊓
        rightConjugate (Subgroup.centralizer (A : Set G)) g := by
      refine le_inf hZK fun z hz => (mem_rightConjugate_iff _ _ _).mpr ?_
      rw [mem_center_iff.mp hz g, mul_inv_cancel_right]
      exact hZK hz
    exact hodd (h.of_dvd_nat (Subgroup.card_dvd_of_le hle))

theorem card_centralizer_lt_of_rankTwoHypNF {A : Subgroup G} (hH : RankTwoHypNF G A)
    (hO : standardComponentOddCore G = ⊥) {Q : Subgroup G} (hQ : Q ≠ ⊥) :
    Nat.card (Subgroup.centralizer (Q : Set G)) < Nat.card G := by
  have hZ := center_eq_bot_of_rankTwoHypNF hH hO
  have hne : Subgroup.centralizer (Q : Set G) ≠ ⊤ := by
    intro htop
    apply hQ
    rw [eq_bot_iff, ← hZ]
    intro q hq
    rw [mem_center_iff]
    intro g
    have hg : g ∈ Subgroup.centralizer (Q : Set G) := htop ▸ mem_top g
    exact (mem_centralizer_iff.mp hg q hq).symm
  rw [← Subgroup.card_top (G := G)]
  exact Subgroup.card_lt_of_lt (lt_top_iff_ne_top.mpr hne)

theorem levi75Y_exists_quotientNF {A : Subgroup G} {D : ClassicalModel A} {T Y W L : Subgroup G}
    (hH : RankTwoHypNF G A) (hA : Hyp31 A) (hl : Levi75Y D T Y W L) :
    ∃ (H : Type) (_ : Group H) (_ : Finite H) (B : Subgroup H), Nat.card H < Nat.card G ∧
      RankTwoHypNF H B ∧ standardComponentOddCore H = ⊥ ∧
      Nonempty (rankTwoQuot B ≃* rankTwoQuot L) := by
  have hLA : L ≤ A := hl.L_le.trans inf_le_left
  have hLW : L ≤ Subgroup.centralizer (Y : Set G) := hl.L_le.trans inf_le_right
  have hH' : RankTwoHypNF ↥(Subgroup.centralizer (Y : Set G))
      (L.subgroupOf (Subgroup.centralizer (Y : Set G))) :=
    ⟨hl.standard, hl.not_normal,
      RankTwoL3Even.two_le_pRank_centralizer_subgroupOf hl.Y_le hLA hH.rank⟩
  have hWlt : Nat.card ↥(Subgroup.centralizer (Y : Set G)) < Nat.card G :=
    card_centralizer_lt_of_rankTwoHypNF hH hA.oddCore hl.Y_ne_bot
  obtain ⟨B, hB', hO', ⟨f⟩⟩ := exists_rankTwoHypNF_quotient hH'
  refine ⟨_, inferInstance, inferInstance, B, ?_, hB', hO',
    ⟨f.symm.trans (RankTwoExceptional.quotCenterCongr (subgroupOfEquivOfLe hLW))⟩⟩
  exact lt_of_le_of_lt (Nat.le_of_dvd Nat.card_pos (Subgroup.card_quotient_dvd_card _)) hWlt

@[expose] def Sp44Step : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (A : Subgroup G) (D : ClassicalModel A)
    (R T Y W L : Subgroup G) (g : G), RankTwoHypNF G A → Hyp31 A →
    Choice74 D R T g → Levi75Y D T Y W L → D.family = .symplectic →
    D.IsLTwoFour → False

@[expose] def Step76Sp : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (A : Subgroup G) (D : ClassicalModel A)
    (R T Y W L : Subgroup G) (g : G), SpHyp A → Hyp31 A → Choice74 D R T g →
    Levi75Y D T Y W L → D.family = .symplectic →
    (∀ (G' : Type) [Group G'] [Finite G'] (A' : Subgroup G'), Nat.card G' < Nat.card G →
      SpHyp A' → False) → False

section Certified

theorem step76Sp_of (hSp44 : Sp44Step) : Step76Sp := by
  intro G _ _ A D R T Y W L g hH hA hch hl hfam ih
  obtain ⟨H, _, _, B, hlt, hB, hO, ⟨eB⟩⟩ := levi75Y_exists_quotientNF hH.toNF hA hl
  have hq := hch.four_le
  have hm2 : ∀ m : ℕ, 4 ≤ 2 ^ m → 2 ≤ m := by
    intro m hm
    by_contra h
    interval_cases m <;> norm_num at hm
  have hL2 : ∀ {m : ℕ}, 3 ≤ m → StatedClassicalModel (rankTwoQuot L) .PSL 2 2 m → False := by
    intro m hm hT
    exact (GMS78.l2Res_of_gms42ResidualU
      (⟨RankTwoFoundation.lemma32, RankTwoFoundation.lemma33One,
        RankTwoFoundation.lemma33Two, RankTwoFoundation.lemma33Three,
        RankTwoFoundation.asc75Theorem4⟩ : GMS78.Foundation)
      GMS78.hksRegularNormalAffine
      (GMS78.gms42ResidualU_of GMS78.gms42ResidualT0 GMS78.gms42ResidualRoot))
      H B ⟨hB.standard, hO, hB.not_normal, hB.rank, Or.inl ⟨m, hm,
        SectionRank.statedClassicalModel_of_mulEquiv eB hT⟩⟩ m hm
      (GMS78.nonempty_mulEquiv_psl2_of_stated
        (SectionRank.statedClassicalModel_of_mulEquiv eB hT))
  cases D with
  | symplectic n m hn hm hnm K hK e =>
    have hlevi := hl.levi
    simp only [ClassicalModel.LeviType] at hlevi
    rcases hlevi with ⟨h3, hT⟩ | ⟨rfl, hT⟩
    · have hBtype : SpClassicalType (rankTwoQuot B) :=
        ⟨n - 1, m, by omega, hm2 m hq,
          SectionRank.statedClassicalModel_of_mulEquiv eB hT⟩
      exact ih H B hlt ⟨hB.standard, hO, hB.not_normal, hB.rank, hBtype⟩
    · have hT' := SectionRank.statedClassicalModel_of_mulEquiv eB hT
      by_cases hm3 : 3 ≤ m
      · exact hL2 hm3 hT
      · have hmge : 2 ≤ m := hm2 m hq
        have hm2' : m = 2 := by omega
        have hq' : 4 ≤ 2 ^ m := hq
        exact hSp44 G A (.symplectic 2 m (by omega) hm
          (by
            intro h
            have h2 : 2 ^ m = 2 := congrArg Prod.snd h
            omega)
          K hK e) R T Y W L g hH.toNF hA hch hl rfl ⟨rfl, hm2'⟩
  | _ => cases hfam

theorem spClassicalGeneral_of_steps (hII : ClassicalHypII) (h74 : Step74) (h75 : Step75Y)
    (h76 : Step76Sp) : SpClassicalGeneral := by
  suffices h : ∀ (N : ℕ) (G : Type) [Group G] [Finite G] (A : Subgroup G), Nat.card G = N →
      SpHyp A → False by
    intro G _ _ A hH
    exact h _ G A rfl hH
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro G _ _ A hN hH
    obtain ⟨n, f, hn, hf, hM⟩ := hH.type
    have hTy := hH.type.toEvenType
    have hA := hH.hyp31 hII
    obtain ⟨-, K, _, _, hK, ⟨e⟩⟩ := hM
    have h4 : 4 ≤ 2 ^ f := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf
    have hnm : (n, 2 ^ f) ≠ (2, 2) := by
      intro h
      have h2 : 2 ^ f = 2 := congrArg Prod.snd h
      omega
    let D : ClassicalModel A := .symplectic n f hn (by omega) hnm K hK e
    obtain ⟨R, T, g, hc⟩ := h74 G A D hA hTy
    obtain ⟨Y, W, L, hl⟩ := h75 G A D R T g hA hTy hc
    exact h76 G A D R T Y W L g hH hA hc hl rfl
      (fun G' _ _ A' hlt hH' => ih _ (hN ▸ hlt) G' A' rfl hH')

theorem spClassicalNormal_of_steps (hII : ClassicalHypII) (h74 : Step74) (h75 : Step75Y)
    (h76 : Step76Sp) : SpClassicalNormal := by
  intro G _ _ A hstd hO hrank hT
  by_contra hnn
  exact spClassicalGeneral_of_steps hII h74 h75 h76 G A ⟨hstd, hO, hnn, hrank, hT⟩

theorem spClassicalNormal_of_sp44 (hSp44 : Sp44Step) : SpClassicalNormal := by
  have h32 := RankTwoFoundation.lemma32
  have h33 := RankTwoFoundation.lemma33Three
  have h4 := RankTwoFoundation.asc75Theorem4
  have h2 := RankTwoFoundation.asc76Theorem2
  have h34 := AS76b.asc08Lemma34
  have hF : Classical222Facts := by
    refine ⟨fun fam => ?_, fun fam => ?_, fun fam => ?_, symplecticJ23, orthJ4⟩
    · cases fam
      exacts [deltaAlpha_linear, deltaAlpha_unitary, deltaAlpha_symplectic, deltaAlpha_orthPlus,
        deltaAlpha_orthMinus]
    · cases fam
      exacts [autAlpha_linear, autAlpha_unitary, autAlpha_symplectic, autAlpha_orthPlus,
        autAlpha_orthMinus]
    · cases fam
      exacts [pairOrbitFree_linear, pairOrbitFree_unitary, pairOrbitFree_symplectic,
        pairOrbitFree_orthPlus, pairOrbitFree_orthMinus]
  have h222 := classical222Large_of hF
  have I : Inputs74 := ⟨h32, h4, h34, h2, classicalOutCommOdd, classicalCentralizerCharTwo,
    h222, classicalJSylow_of hF⟩
  have hExc := classical222TwoExcCenter_of exc213_PSU_four exc213_PSU_six exc213_PSp_three
    exc213_POmegaPlus_four
  have hTwo := classical222Two_of hExc deltaAlphaTwo_symplectic deltaAlphaTwo_orthPlus
    deltaAlphaTwo_orthMinus symplecticJ23Two orthJ4Two
    (classical222TwoB_of linearCaseIITwo unitaryCaseIITwo orthCaseIITwo)
  have h73 := step73_of I h33 hTwo linearTwoResidual symplecticTwoOut
  have h74 := step74_of I classicalSplit classicalPrimaryPerfect h33 h73 symplecticTypeAPerfect
    symplecticCase1Type symplecticSplitA symplecticPairA2
  have hRC : ClassicalRigidChoice := ⟨rigidLeviChoice_linear, rigidLeviChoice_unitary,
    rigidLeviChoice_orthPlus, rigidLeviChoice_orthMinus⟩
  have h75 := step75Y_of h32 h4 h34 h2 classicalOutCommOdd classicalCentralizerCharTwo h222
    hRC symplecticYChoice symplecticOddCentralizerO2
  exact spClassicalNormal_of_steps (classicalHypII_of_multiplier classicalEvenMultiplier) h74 h75
    (step76Sp_of hSp44)

end Certified

