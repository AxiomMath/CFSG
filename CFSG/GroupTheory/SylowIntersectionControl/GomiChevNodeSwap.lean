variable {K₀ K : Type} [Group K₀] [Finite K₀] [Group K] [Finite K] {D : UniversalRootDatum K₀}
  {n : Fin D.rank → K₀} {H : Fin D.rank → Subgroup K₀} {π : K₀ →* K} {M : ℕ}

omit [Finite K] in
theorem card_rootGroup_eq_of_card_map_parJ_eq (h : BorelQuotient D n H π M) {i j : Fin D.rank}
    (hc : Nat.card ((parJ D H {i}).map π) = Nat.card ((parJ D H {j}).map π)) :
    Nat.card ↥(D.rootGroup (Pi.single i 1)) = Nat.card ↥(D.rootGroup (Pi.single j 1)) := by
  have hkerB : π.ker ≤ borel D H := fun z hz =>
    CFSG.ClassicalInvolution.WeakCT.normalizer_posUnipotent_le_borel h.ct h.extras
      (Subgroup.center_le_normalizer (posUnipotent D : Set K₀) (h.ker_central z hz))
  have hcard (k : Fin D.rank) :
      Nat.card ↥(parJ D H {k}) =
        Nat.card ((parJ D H {k}).map π) * Nat.card ↥π.ker := by
    have hrel := Subgroup.relIndex_mul_card (H := π.ker) (K := parJ D H {k})
    rw [Subgroup.relIndex_ker, inf_eq_left.mpr (hkerB.trans (borel_le_parJ {k}))] at hrel
    exact hrel.symm
  have hcardij : Nat.card ↥(parJ D H {i}) = Nat.card ↥(parJ D H {j}) := by
    rw [hcard i, hcard j, hc]
  have hB : 0 < Nat.card ↥(borel D H) := Nat.card_pos
  rw [card_parJ_singleton h.ct h.extras i, card_parJ_singleton h.ct h.extras j] at hcardij
  have := Nat.eq_of_mul_eq_mul_left hB hcardij
  omega

theorem rank_eq_two_of_map_parJ_ne_of_sup_eq_top (h : BorelQuotient D n H π M) (α : MulAut K)
    (hα : ((posUnipotent D).map π).map α.toMonoidHom = (posUnipotent D).map π) {i : Fin D.rank}
    (hne : ((parJ D H {i}).map π).map α.toMonoidHom ≠ (parJ D H {i}).map π)
    (hsup : (parJ D H {i}).map π ⊔ ((parJ D H {i}).map π).map α.toMonoidHom = ⊤) :
    D.rank = 2 ∧ ∀ j k : Fin D.rank,
      Nat.card ↥(D.rootGroup (Pi.single j 1)) = Nat.card ↥(D.rootGroup (Pi.single k 1)) := by
  obtain ⟨j, hj⟩ := exists_map_map_parJ_eq h hα i
  have hji : j ≠ i := by
    rintro rfl
    exact hne hj
  have hsup' : (parJ D H {i}).map π ⊔ (parJ D H {j}).map π = ⊤ := by
    rw [← hj]; exact hsup
  have hmem : ∀ k : Fin D.rank, k = i ∨ k = j := by
    intro k
    have hle : pElementSubgroup 2 ((parJ D H {k}).map π) ≤
        ⨆ m ∈ ({i, j} : Set (Fin D.rank)), (parJ D H {m}).map π := by
      rw [iSup_pair, hsup']
      exact le_top
    have hk := sub_of_borelQuotient h ({i, j} : Set (Fin D.rank)) k hle
    simpa using hk
  have hset : ({i, j} : Set (Fin D.rank)) = Set.univ := by
    ext k
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_univ, iff_true]
    exact hmem k
  have hrank : D.rank = 2 := by
    have h2 : Nat.card (Fin D.rank) = 2 :=
      Nat.card_eq_two_iff.mpr ⟨i, j, hji.symm, hset⟩
    simpa [Nat.card_fin] using h2
  have hπ : Nat.card ((parJ D H {i}).map π) = Nat.card ((parJ D H {j}).map π) := by
    have hci : Nat.card ((parJ D H {i}).map π) =
        Nat.card (((parJ D H {i}).map π).map α.toMonoidHom) :=
      (Subgroup.card_map_of_injective (K := (parJ D H {i}).map π)
        (f := α.toMonoidHom) α.injective).symm
    rw [hci, hj]
  have hXi : Nat.card ↥(D.rootGroup (Pi.single i 1)) =
      Nat.card ↥(D.rootGroup (Pi.single j 1)) :=
    card_rootGroup_eq_of_card_map_parJ_eq h hπ
  have hAll : ∀ k : Fin D.rank, Nat.card ↥(D.rootGroup (Pi.single k 1)) =
      Nat.card ↥(D.rootGroup (Pi.single i 1)) := by
    intro k
    rcases hmem k with hk | hk
    · simp [hk]
    · simpa [hk] using hXi.symm
  refine ⟨hrank, ?_⟩
  intro j k
  exact (hAll j).trans (hAll k).symm

theorem gomiNoAtomSwap_of_borelQuotient (h : BorelQuotient D n H π M) (hr : D.rank ≠ 2) :
    GomiNoAtomSwap K := by
  intro S A α hS hα hA hne hsup
  obtain ⟨π', h', hS'⟩ := exists_borelQuotient_map_posUnipotent_eq h hS
  rw [← hS'] at hα hA
  obtain ⟨i, hi⟩ := (isGomiAtom_iff_exists_eq_map_parJ h').1 hA
  rw [hi] at hne hsup
  exact hr (rank_eq_two_of_map_parJ_ne_of_sup_eq_top h' α hα hne hsup).1

theorem gomiNoAtomSwap_of_borelQuotient_card_ne (h : BorelQuotient D n H π M) {i j : Fin D.rank}
    (hij : Nat.card ↥(D.rootGroup (Pi.single i 1)) ≠ Nat.card ↥(D.rootGroup (Pi.single j 1))) :
    GomiNoAtomSwap K := by
  intro S A α hS hα hA hne hsup
  obtain ⟨π', h', hS'⟩ := exists_borelQuotient_map_posUnipotent_eq h hS
  rw [← hS'] at hα hA
  obtain ⟨k, hk⟩ := (isGomiAtom_iff_exists_eq_map_parJ h').1 hA
  rw [hk] at hne hsup
  exact hij ((rank_eq_two_of_map_parJ_ne_of_sup_eq_top h' α hα hne hsup).2 i j)

