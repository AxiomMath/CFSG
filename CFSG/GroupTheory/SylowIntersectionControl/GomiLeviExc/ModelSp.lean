private theorem isGomiChevTwo_statedSp (K : Type) [Field K] [Finite K] [CharP K 2] {m : ℕ}
    (hm : 2 ≤ m) (hk : 3 ≤ m ∨ (m = 2 ∧ 4 ≤ Nat.card K)) :
    IsGomiChevTwo ↥(CFSG.Open.StatedSp m K) := by
  obtain ⟨f, hf1, hcard⟩ := CFSG.AGLEmbedding.ParabHub.exists_card_eq_two_pow K
  have hadm : CFSG.Open.StatedLieAdmissible .PSp m 2 f := by
    refine ⟨Nat.prime_two, hf1, hm, ?_⟩
    rintro hpair
    have hm2 : m = 2 := by simpa using congrArg Prod.fst hpair
    have hf2 : 2 ^ f = 2 := by simpa using congrArg Prod.snd hpair
    rcases hk with h3 | ⟨-, h4⟩
    · exfalso; omega
    · rw [hcard, hf2] at h4
      exfalso; omega
  have hmodel : CFSG.Open.StatedClassicalModel
      (↥(CFSG.Open.StatedSp m K) ⧸ Subgroup.center ↥(CFSG.Open.StatedSp m K)) .PSp m 2 f :=
    CFSG.LieType.Universal.Symplectic.statedClassicalModel_center_quotient
      (n := m) (F := K) hadm hcard
  have hclass : CFSG.AGLEmbedding.IsClassicalTwoOrG2
      (↥(CFSG.Open.StatedSp m K) ⧸ Subgroup.center ↥(CFSG.Open.StatedSp m K)) :=
    CFSG.HardMathSupport.Cooperstein.Coordinator.LieInput.isClassicalTwoOrG2_of_statedPSp hmodel
      (by
        rcases hk with h3 | ⟨hm2, h4⟩
        · exact Or.inl h3
        · exact Or.inr ⟨hm2, by rwa [hcard] at h4⟩)
  refine IsGomiChevTwo.of_isQuasisimple
    (CFSG.LieType.Universal.Symplectic.isQuasisimple_of_admissible (n := m) (F := K) hadm hcard)
    ?_ (CFSG.AGLEmbeddingD2.McLaughlin.WeakBlockModuleData.isChevTwo_of_classicalTwoOrG2 hclass)
  rw [CFSG.HardMathSupport.Cooperstein.Coordinator.LieInput.center_sp_eq_bot, Subgroup.card_bot]
  norm_num

theorem gomiLeviFactor_statedSp (K : Type) [Field K] [Finite K] [CharP K 2] {m : ℕ}
    (hm : 2 ≤ m) : GomiLeviFactor ↥(CFSG.Open.StatedSp m K) := by
  by_cases hm3 : 3 ≤ m
  · exact Or.inl (isGomiChevTwo_statedSp K hm (Or.inl hm3))
  · have hm2 : m = 2 := by omega
    rw [hm2]
    by_cases hK2 : Nat.card K = 2
    · exact Or.inr ⟨CFSG.SeitzReduction.F4Pilot.sp4EquivPerm hK2⟩
    · refine Or.inl (isGomiChevTwo_statedSp K (by norm_num) (Or.inr ⟨rfl, ?_⟩))
      obtain ⟨f, hf1, hcard⟩ := CFSG.AGLEmbedding.ParabHub.exists_card_eq_two_pow K
      have hf : 2 ≤ f := by
        by_contra hf
        have hf1' : f = 1 := by omega
        exact hK2 (by rw [hcard, hf1']; norm_num)
      rw [hcard]
      calc (4 : ℕ) = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf

end CFSG.GroupTheory.GomiLeviExc
