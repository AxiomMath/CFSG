@[expose] def parseInts (s : String) : List ℤ :=
  (s.split fun c => c == ' ' || c == '\n').toList.filterMap fun t => t.toString.toInt?

@[expose] def pairUp : List ℤ → List (ℤ × ℤ)
  | a :: b :: l => (a, b) :: pairUp l
  | _ => []

@[expose] def refVal (vals : Array Pair) (r : ℤ) : Pair :=
  if 0 ≤ r then vals[r.toNat]! else (vals[(-r - 1).toNat]!).swap

@[expose] def slpStep (vals : Array Pair) (ins : ℤ × ℤ) : Array Pair :=
  let x := refVal vals ins.1
  let y := refVal vals ins.2
  vals.push (mul 52 x.1 y.1, mul 52 y.2 x.2)

@[expose] def slpVals : Array Pair :=
  (pairUp (parseInts slpText)).foldl slpStep #[(aRows, aRows), (bRows, mul 52 bRows bRows)]

