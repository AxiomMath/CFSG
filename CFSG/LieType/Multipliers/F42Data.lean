@[expose] def lifts : Array Pair := (liftRefs.map (refVal slpVals)).toArray

@[expose] def rootAt (k : ℕ) : Fin Tag.F4.rank → ℤ :=
  fun t => (f4ArtifactRoots.getD k []).getD t.val 0

@[expose] def isRootB (v : Fin Tag.F4.rank → ℤ) : Bool := decide (List.ofFn v ∈ f4ArtifactRoots)

@[expose] def rootIdx (v : Fin Tag.F4.rank → ℤ) : ℕ := f4ArtifactRoots.idxOf (List.ofFn v)

@[expose] def matOf (L : Array Pair) (k : ℕ) : Array V := (L[k]!).1

@[expose] def invOf (L : Array Pair) (k : ℕ) : Array V := (L[k]!).2

@[expose] def negM (X : Array V) : Array V := X.map V.neg

@[expose] def eqPM (X Y : Array V) : Bool := eqM 52 X Y || eqM 52 X (negM Y)

@[expose] def commutes (X Y : Array V) : Bool := eqM 52 (mul 52 X Y) (mul 52 Y X)

@[expose] def commArr (L : Array Pair) (i j : ℕ) : Array V :=
  mul 52 (mul 52 (mul 52 (matOf L i) (matOf L j)) (invOf L i)) (invOf L j)

@[expose] def factor (L : Array Pair) (c : Bool) (v : Fin Tag.F4.rank → ℤ) : Array V :=
  if c && isRootB v then matOf L (rootIdx v) else idM 52

@[expose] def f11 (L : Array Pair) (i j : ℕ) : Array V :=
  factor L (!isRootB (rootAt j - rootAt i)) (rootAt i + rootAt j)

@[expose] def f12 (L : Array Pair) (i j : ℕ) : Array V :=
  factor L true (rootAt i + 2 • rootAt j)

@[expose] def f21 (L : Array Pair) (i j : ℕ) : Array V :=
  factor L true (2 • rootAt i + rootAt j)

@[expose] def prodArr (L : Array Pair) (i j : ℕ) : Array V :=
  mul 52 (mul 52 (f11 L i j) (f12 L i j)) (f21 L i j)

@[expose] def liftOK (L : Array Pair) (k : ℕ) : Bool :=
  (matOf L k).size == 52 && wfM (matOf L k) && (invOf L k).size == 52 && wfM (invOf L k) &&
    eqM 52 (mul 52 (matOf L k) (invOf L k)) (idM 52) &&
    eqM 52 (mul 52 (invOf L k) (matOf L k)) (idM 52) &&
    eqPM (mul 52 (matOf L k) (matOf L k)) (idM 52)

@[expose] def pairOK (L : Array Pair) (i j : ℕ) : Bool :=
  eqPM (commArr L i j) (prodArr L i j) && commutes (f11 L i j) (f12 L i j) &&
    commutes (f11 L i j) (f21 L i j) && commutes (f12 L i j) (f21 L i j)

@[expose] def pairsOK (L : Array Pair) : Bool :=
  (List.range 48).all fun i => (List.range 48).all fun j =>
    i == j || decide (rootAt i + rootAt j = 0) || pairOK L i j

@[expose] def wordOK (L : Array Pair) (k : ℕ) : Bool :=
  let p := commPairs.getD k (0, 0)
  p.1 < 48 && p.2 < 48 && p.1 != p.2 && !decide (rootAt p.1 + rootAt p.2 = 0) &&
    decide (rootAt p.1 + rootAt p.2 = rootAt k) && !isRootB (rootAt p.1 + 2 • rootAt p.2) &&
    !isRootB (2 • rootAt p.1 + rootAt p.2) && !isRootB (rootAt p.2 - rootAt p.1) &&
    eqM 52 (commArr L p.1 p.2) (matOf L k)

@[expose] def negOK (L : Array Pair) (i j : ℕ) : Bool :=
  i < 48 && j < 48 && i != j && !decide (rootAt i + rootAt j = 0) &&
    eqM 52 (commArr L i j) (negM (prodArr L i j))

