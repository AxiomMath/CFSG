universe u
variable {k : Type u} [Field k] [IsAlgClosed k]

structure EquivariantReductiveCoverThree
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k) (σM : M →ₐc[k] M) where
  torus : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k
  isTorus : TauCeti.torusCommHopfAlgProperty k torus
  semisimple : TauCeti.SemisimpleCommHopfAlgCat.{u} k
  simplyConnected : TauCeti.simplyConnectedSemisimpleCommHopfAlgProperty k semisimple
  torusAut : torus →ₐc[k] torus
  semisimpleAut : semisimple.obj →ₐc[k] semisimple.obj
  torusAut_cube : (torusAut.comp torusAut).comp torusAut = BialgHom.id k torus
  semisimpleAut_cube : (semisimpleAut.comp semisimpleAut).comp semisimpleAut =
    BialgHom.id k semisimple.obj
  cover : M.obj ⟶ (TauCeti.FiniteTypeCommHopfAlgCat.tensorProduct torus semisimple.obj).obj
  isCentralIsogeny : TauCeti.CommHopfAlgCat.IsCentralIsogeny cover
  equivariant : cover.hom.comp σM =
    (Bialgebra.TensorProduct.map torusAut semisimpleAut).comp cover.hom

namespace EquivariantReductiveCoverThree

omit [IsAlgClosed k] in
theorem productAut_cube
    {M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k} {σM : M →ₐc[k] M}
    (D : EquivariantReductiveCoverThree M σM) :
    let σ := Bialgebra.TensorProduct.map D.torusAut D.semisimpleAut
    (σ.comp σ).comp σ =
      BialgHom.id k (TauCeti.FiniteTypeCommHopfAlgCat.tensorProduct D.torus D.semisimple.obj) := by
  apply BialgHom.ext
  intro x
  induction x using TensorProduct.inductionOn with
  | tmul a b =>
    have ha := congrArg (fun f : D.torus →ₐc[k] D.torus => f a) D.torusAut_cube
    have hb := congrArg (fun f : D.semisimple.obj →ₐc[k] D.semisimple.obj => f b)
      D.semisimpleAut_cube
    simpa only [BialgHom.comp_apply, Bialgebra.TensorProduct.map_tmul, BialgHom.id_apply] using
      congrArg₂ (fun a b => a ⊗ₜ[k] b) ha hb
  | add x y hx hy => simp only [map_add, hx, hy]

end EquivariantReductiveCoverThree

namespace CanonicalReductive

theorem eq_augmentation_of_normal_solvable_derivedCoordinate
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M)
    (I : TauCeti.HopfIdeal (AlgebraicClosure k)
      (TauCeti.FiniteTypeCommHopfAlgCat.baseChange (K := AlgebraicClosure k) (derivedCoordinate M)))
    (hI : I.IsNormal)
    (hconn : TauCeti.geometricallyConnectedCommHopfAlgProperty (AlgebraicClosure k)
      (TauCeti.FiniteTypeCommHopfAlgCat.quotient
        (TauCeti.FiniteTypeCommHopfAlgCat.baseChange (K := AlgebraicClosure k) (derivedCoordinate M)) I).obj)
    (hsm : Algebra.Smooth (AlgebraicClosure k)
      (TauCeti.FiniteTypeCommHopfAlgCat.quotient
        (TauCeti.FiniteTypeCommHopfAlgCat.baseChange (K := AlgebraicClosure k) (derivedCoordinate M)) I))
    (hsolv : TauCeti.geometricallySolvablePointsCommHopfAlgProperty (AlgebraicClosure k)
      (TauCeti.FiniteTypeCommHopfAlgCat.quotient
        (TauCeti.FiniteTypeCommHopfAlgCat.baseChange (K := AlgebraicClosure k) (derivedCoordinate M)) I).obj) :
    I = TauCeti.HopfIdeal.augmentation (AlgebraicClosure k)
      (TauCeti.FiniteTypeCommHopfAlgCat.baseChange (K := AlgebraicClosure k) (derivedCoordinate M)) := by
  apply le_antisymm (TauCeti.HopfIdeal.le_augmentation _ _ I)
  rw [← DerivedSemisimple.solvableRadicalDefiningIdeal_baseChange_derived_eq_augmentation M hM]
  exact TauCeti.FiniteTypeCommHopfAlgCat.solvableRadicalDefiningIdeal_le _ I
    (TauCeti.HopfIdeal.IsSolvableRadicalCandidate.mk hI hconn hsm hsolv)

theorem semisimple_derivedCoordinate
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M) :
    TauCeti.semisimpleCommHopfAlgProperty k (derivedCoordinate M) := by
  rw [TauCeti.semisimpleCommHopfAlgProperty_iff]
  have h := smooth_geometricallyConnected_derivedCoordinate M hM
  exact ⟨h.1, h.2, eq_augmentation_of_normal_solvable_derivedCoordinate M hM⟩

theorem isCocomm_connectedCenter (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k) :
    Coalgebra.IsCocomm k (connectedCenter M) := by
  let f : TauCeti.CommHopfAlgCat.centerCoordinateHopfAlgebra M.obj →ₐc[k] connectedCenter M :=
    (TauCeti.CommHopfAlgCat.mkQuotient
        (TauCeti.CommHopfAlgCat.reducedCenterCoordinateHopfAlgebra M.obj)
        (TauCeti.HopfAlgebra.identityComponentHopfIdeal (k := k)
          (H := TauCeti.FiniteTypeCommHopfAlgCat.of k
            (TauCeti.CommHopfAlgCat.reducedCenterCoordinateHopfAlgebra M.obj)))).hom.comp
      (TauCeti.CommHopfAlgCat.mkQuotient
        (TauCeti.CommHopfAlgCat.centerCoordinateHopfAlgebra M.obj)
        (TauCeti.HopfIdeal.reduction k
          (TauCeti.CommHopfAlgCat.centerCoordinateHopfAlgebra M.obj))).hom
  have hf : Function.Surjective f :=
    (TauCeti.CommHopfAlgCat.mkQuotient_surjective
      (TauCeti.CommHopfAlgCat.reducedCenterCoordinateHopfAlgebra M.obj)
      (TauCeti.HopfAlgebra.identityComponentHopfIdeal (k := k)
        (H := TauCeti.FiniteTypeCommHopfAlgCat.of k
          (TauCeti.CommHopfAlgCat.reducedCenterCoordinateHopfAlgebra M.obj)))).comp
      (TauCeti.CommHopfAlgCat.mkQuotient_surjective
        (TauCeti.CommHopfAlgCat.centerCoordinateHopfAlgebra M.obj)
        (TauCeti.HopfIdeal.reduction k
          (TauCeti.CommHopfAlgCat.centerCoordinateHopfAlgebra M.obj)))
  have hf' : Function.Surjective
      (f : TauCeti.CommHopfAlgCat.centerCoordinateHopfAlgebra M.obj →ₗc[k] connectedCenter M) :=
    fun y => hf y
  exact CoalgHom.isCocomm_of_surjective _ hf'

theorem multiplicativeType_connectedCenter
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M) :
    TauCeti.multiplicativeTypeCommHopfAlgProperty k (connectedCenter M) := by
  have : Coalgebra.IsCocomm k (connectedCenter M) := isCocomm_connectedCenter M
  exact CommutativeReductive.multiplicativeType_of_reductive_of_isCocomm _
    (reductive_connectedCenter M hM)

theorem torus_connectedCenter
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M) :
    TauCeti.torusCommHopfAlgProperty k (connectedCenter M) := by
  apply (TauCeti.torusCommHopfAlgProperty.iff_multiplicativeType_and_geometricallyConnected_and_geometricallyReduced
    k (connectedCenter M)).2
  have hz := reductive_connectedCenter M hM
  exact ⟨multiplicativeType_connectedCenter M hM, hz.geometricallyConnected,
    TauCeti.geometricallyReducedCommHopfAlgProperty_of_smooth k (connectedCenter M).obj
      ((TauCeti.smoothCommHopfAlgProperty_iff _).2 hz.smooth)⟩

@[expose] def multiplication (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M) :
    M.obj ⟶ (TauCeti.FiniteTypeCommHopfAlgCat.tensorProduct
      (connectedCenter M) (derivedCoordinate M)).obj := by
  let : Algebra.Smooth k (connectedCenter M) := (reductive_connectedCenter M hM).smooth
  let : IsReduced (connectedCenter M) := TauCeti.isReduced_of_smooth k _
  let : Algebra.Smooth k (derivedCoordinate M) := (smooth_geometricallyConnected_derivedCoordinate M hM).1
  let : IsReduced (derivedCoordinate M) := TauCeti.isReduced_of_smooth k _
  exact (CentralProduct.centralProductHom (connectedCenterCoordinateMap M) (derivedCoordinateMap M)
    (CentralProduct.pointImageCentral_of_isCentral_ker (connectedCenterCoordinateMap M)
      (TauCeti.CommHopfAlgCat.centerDefiningIdeal M.obj)
      (TauCeti.CommHopfAlgCat.isCentral_centerDefiningIdeal M.obj)
      (connectedCenterCoordinateMap_kills_centerDefiningIdeal M))).hom

theorem multiplication_comp_of_equivariant
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M)
    (F : M →ₐc[k] M) (FT : connectedCenter M →ₐc[k] connectedCenter M)
    (hFT : FT.comp (connectedCenterCoordinateMap M) = (connectedCenterCoordinateMap M).comp F) :
    (multiplication M hM).hom.comp F =
      (Bialgebra.TensorProduct.map FT (derivedCoordinateEnd M F)).comp (multiplication M hM).hom := by
  let T := connectedCenter M
  let D := derivedCoordinate M
  let : Algebra.Smooth k T := (reductive_connectedCenter M hM).smooth
  let : IsReduced T := TauCeti.isReduced_of_smooth k _
  let : Algebra.Smooth k D := (smooth_geometricallyConnected_derivedCoordinate M hM).1
  let : IsReduced D := TauCeti.isReduced_of_smooth k _
  change (CentralProduct.centralProductHom (connectedCenterCoordinateMap M) (derivedCoordinateMap M)
    (CentralProduct.pointImageCentral_of_isCentral_ker (connectedCenterCoordinateMap M)
      (TauCeti.CommHopfAlgCat.centerDefiningIdeal M.obj)
      (TauCeti.CommHopfAlgCat.isCentral_centerDefiningIdeal M.obj)
      (connectedCenterCoordinateMap_kills_centerDefiningIdeal M))).hom.hom.comp F = _
  exact CentralProduct.centralProductBialgHom_comp
    (connectedCenterCoordinateMap M) (derivedCoordinateMap M)
    (CentralProduct.pointImageCentral_of_isCentral_ker (connectedCenterCoordinateMap M)
      (TauCeti.CommHopfAlgCat.centerDefiningIdeal M.obj)
      (TauCeti.CommHopfAlgCat.isCentral_centerDefiningIdeal M.obj)
      (connectedCenterCoordinateMap_kills_centerDefiningIdeal M)) F FT _ hFT.symm
    (derivedCoordinateEnd_comp M F).symm

