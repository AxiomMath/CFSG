theorem kernelDimension_le_finrank_center
    (D : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (S : TauCeti.SemisimpleCommHopfAlgCat.{u} k)
    (q : D.obj ⟶ S.obj.obj) (hq : TauCeti.CommHopfAlgCat.IsCentralIsogeny q) :
    Isogeny.kernelDimension q ≤
      Module.finrank k (TauCeti.CommHopfAlgCat.centerCoordinateHopfAlgebra S.obj.obj) := by
  have hle : TauCeti.CommHopfAlgCat.centerDefiningIdeal S.obj.obj ≤
      TauCeti.CommHopfAlgCat.kernelHopfIdeal q :=
    (TauCeti.CommHopfAlgCat.centerDefiningIdeal_le_iff S.obj.obj _).2 hq.isCentral_kernelHopfIdeal
  let j := TauCeti.CommHopfAlgCat.quotientMapOfLe S.obj.obj hle
  let : Module.Finite k (TauCeti.CommHopfAlgCat.centerCoordinateHopfAlgebra S.obj.obj) :=
    S.property.moduleFinite_centerCoordinate
  exact LinearMap.finrank_le_finrank_of_surjective (f := j.hom.toLinearMap)
    (TauCeti.CommHopfAlgCat.quotientMapOfLe_surjective S.obj.obj hle)

theorem simplyConnected_of_moduleFinite
    (D : TauCeti.SemisimpleCommHopfAlgCat.{u} k) [Module.Finite k D.obj] :
    TauCeti.simplyConnectedSemisimpleCommHopfAlgProperty k D := by
  rw [TauCeti.simplyConnectedSemisimpleCommHopfAlgProperty_iff]
  intro S q hq
  let f := q.hom.hom
  let : Algebra D.obj S.obj := (f.hom.toAlgHom).toAlgebra
  let : Module.Finite D.obj S.obj := hq.finite
  let : IsScalarTower k D.obj S.obj := IsScalarTower.of_algHom f.hom.toAlgHom
  let : Module.Finite k S.obj := Module.Finite.trans D.obj S.obj
  let : Algebra.Smooth k S.obj := S.property.smooth
  let : IsReduced S.obj := TauCeti.isReduced_of_smooth k _
  let : ConnectedSpace (PrimeSpectrum S.obj) :=
    TauCeti.geometricallyConnectedCommHopfAlgProperty.connectedSpace k S.obj.obj
      S.property.geometricallyConnected
  have hfs : Function.Surjective f.hom := by
    intro x
    let c := Bialgebra.counitAlgHom k S.obj
    have hx : x = algebraMap k S.obj (c x) :=
      TauCeti.eq_algebraMap_of_finite_range_eval x (Set.finite_range _) c
    refine ⟨algebraMap k D.obj (c x), ?_⟩
    exact (f.hom.toAlgHom.commutes (c x)).trans hx.symm
  let : IsIso f := hq.isIsogeny.isIso_iff_surjective.2 hfs
  exact (ObjectProperty.isIso_hom_iff q).mp ((ObjectProperty.isIso_hom_iff q.hom).mp inferInstance)

theorem exists_bound_finrank_center_of_isCentralIsogeny
    (D : TauCeti.SemisimpleCommHopfAlgCat.{u} k) (_hD : ¬ Module.Finite k D.obj) :
    ∃ b : ℕ, ∀ S : TauCeti.SemisimpleCommHopfAlgCat.{u} k,
      ∀ q : D.obj.obj ⟶ S.obj.obj, TauCeti.CommHopfAlgCat.IsCentralIsogeny q →
        Module.finrank k (TauCeti.CommHopfAlgCat.centerCoordinateHopfAlgebra S.obj.obj) ≤ b :=
  UniformCenter.exists_bound_finrank_center D fun a ha =>
    algHom_eq_of_agree_commutator D a 0 fun p => (ha p).trans (map_zero _).symm

theorem exists_simplyConnectedCover_of_bddAbove
    (D : TauCeti.SemisimpleCommHopfAlgCat.{u} k)
    (hbound : BddAbove {n : ℕ | ∃ S : TauCeti.SemisimpleCommHopfAlgCat.{u} k,
      ∃ q : D.obj.obj ⟶ S.obj.obj,
        TauCeti.CommHopfAlgCat.IsCentralIsogeny q ∧ n = Isogeny.kernelDimension q}) :
    Nonempty (SimplyConnectedCover D) := by
  let degrees : Set ℕ := {n | ∃ S : TauCeti.SemisimpleCommHopfAlgCat.{u} k,
    ∃ q : D.obj.obj ⟶ S.obj.obj,
      TauCeti.CommHopfAlgCat.IsCentralIsogeny q ∧ n = Isogeny.kernelDimension q}
  have hne : degrees.Nonempty :=
    ⟨Isogeny.kernelDimension (𝟙 D.obj.obj),
      D, 𝟙 D.obj.obj, TauCeti.CommHopfAlgCat.isCentralIsogeny_id D.obj.obj, rfl⟩
  obtain ⟨S, q, hq, hd⟩ := Nat.sSup_mem hne hbound
  have hsc : TauCeti.simplyConnectedSemisimpleCommHopfAlgProperty k S := by
    rw [TauCeti.simplyConnectedSemisimpleCommHopfAlgProperty_iff]
    intro X f hf
    let g := f.hom.hom
    have hdeg : Isogeny.kernelDimension (q ≫ g) ≤ Isogeny.kernelDimension q := by
      rw [← hd]
      exact le_csSup hbound ⟨X, q ≫ g,
        isCentralIsogeny_comp_semisimple D S X q g hq hf, rfl⟩
    let : IsIso g := Isogeny.isIso_of_kernelDimension_le q hq.isIsogeny g hf.isIsogeny hdeg
    exact (ObjectProperty.isIso_hom_iff f).mp ((ObjectProperty.isIso_hom_iff f.hom).mp inferInstance)
  exact ⟨⟨S, hsc, q, hq⟩⟩

theorem exists_simplyConnectedCover (D : TauCeti.SemisimpleCommHopfAlgCat.{u} k) :
    Nonempty (SimplyConnectedCover D) := by
  classical
  by_cases hfinite : Module.Finite k D.obj
  · let := hfinite
    exact ⟨⟨D, simplyConnected_of_moduleFinite D, 𝟙 D.obj.obj,
      TauCeti.CommHopfAlgCat.isCentralIsogeny_id D.obj.obj⟩⟩
  obtain ⟨b, hb⟩ := exists_bound_finrank_center_of_isCentralIsogeny D hfinite
  apply exists_simplyConnectedCover_of_bddAbove D
  refine ⟨b, ?_⟩
  rintro n ⟨S, q, hq, rfl⟩
  exact (kernelDimension_le_finrank_center D.obj S q hq).trans (hb S q hq)

theorem isCentral_kernel_multiplicationCover
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M)
    (C : SimplyConnectedCover ⟨derivedCoordinate M, semisimple_derivedCoordinate M hM⟩) :
    (TauCeti.CommHopfAlgCat.kernelHopfIdeal (multiplicationCover M hM C)).IsCentral := by
  let T := CanonicalReductive.connectedCenter M
  let D := CanonicalReductive.derivedCoordinate M
  let S := C.source.obj
  let Q : (TauCeti.FiniteTypeCommHopfAlgCat.tensorProduct T D).obj ⟶
      (TauCeti.FiniteTypeCommHopfAlgCat.tensorProduct T S).obj :=
    _root_.CommHopfAlgCat.ofHom (C.coordinateMap.hom.lTensor T)
  let : Algebra.Smooth k S := C.source.property.smooth
  let : IsReduced S := TauCeti.isReduced_of_smooth k _
  apply (TauCeti.CommHopfAlgCat.isCentral_iff_forall_isCentralPoint _ _).2
  intro A y hy
  have hyle : TauCeti.AlgHom.mapDomain
      (CanonicalReductive.multiplicationCover M hM C).hom y = 1 :=
    (TauCeti.CommHopfAlgCat.mapPointsFunctor_app_eq_one_iff _ A y).2 hy
  let u := TauCeti.AlgHom.mapDomain Q.hom y
  have hu : u ∈ TauCeti.CommHopfAlgCat.quotientPointsSubgroup
      (TauCeti.FiniteTypeCommHopfAlgCat.tensorProduct T D).obj
      (TauCeti.CommHopfAlgCat.kernelHopfIdeal (CanonicalReductive.multiplication M hM)) A := by
    apply (TauCeti.CommHopfAlgCat.mapPointsFunctor_app_eq_one_iff _ A u).1
    change TauCeti.AlgHom.mapDomain (CanonicalReductive.multiplication M hM).hom
      (TauCeti.AlgHom.mapDomain Q.hom y) = 1
    rw [← MonoidHom.comp_apply, ← TauCeti.AlgHom.mapDomain_comp]
    exact hyle
  have huc : TauCeti.HopfAlgebra.IsCentralPoint u :=
    TauCeti.CommHopfAlgCat.isCentralPoint_of_mem_quotientPointsSubgroup _ _
      (CanonicalReductive.isCentral_kernel_multiplication M hM) A hu
  have hd : TauCeti.HopfAlgebra.IsCentralPoint
      (TauCeti.FiniteTypeCommHopfAlgCat.pointsMulEquiv A T D u).2 := by
    simpa only [pointsMulEquiv_eq_affine] using
      CentralProduct.isCentralPoint_snd_of_product T D u huc
  have hpair := pointsMulEquiv_mapDomain_lTensor T D S C.coordinateMap A y
  have hsimage : TauCeti.HopfAlgebra.IsCentralPoint
      (TauCeti.AlgHom.mapDomain C.coordinateMap.hom
        (TauCeti.FiniteTypeCommHopfAlgCat.pointsMulEquiv A T S y).2) := by
    have hp := congrArg Prod.snd hpair
    change (TauCeti.FiniteTypeCommHopfAlgCat.pointsMulEquiv A T D u).2 = _ at hp
    dsimp only [Prod.snd] at hp
    rw [← hp]
    exact hd
  have hsc : TauCeti.HopfAlgebra.IsCentralPoint
      (TauCeti.FiniteTypeCommHopfAlgCat.pointsMulEquiv A T S y).2 :=
    isCentralPoint_of_mapDomain_of_isCentralIsogeny_semisimple D C.source C.coordinateMap
      C.isCentralIsogeny _ hsimage
  have htc : TauCeti.HopfAlgebra.IsCentralPoint
      (TauCeti.FiniteTypeCommHopfAlgCat.pointsMulEquiv A T S y).1 := by
    apply CentralProduct.isCentralPoint_of_mapDomain_of_surjective
      (CanonicalReductive.connectedCenterCoordinateMap M)
      (CanonicalReductive.connectedCenterCoordinateMap_surjective M)
    exact CentralProduct.pointImageCentral_of_isCentral_ker
      (CanonicalReductive.connectedCenterCoordinateMap M)
      (TauCeti.CommHopfAlgCat.centerDefiningIdeal M.obj)
      (TauCeti.CommHopfAlgCat.isCentral_centerDefiningIdeal M.obj)
      (CanonicalReductive.connectedCenterCoordinateMap_kills_centerDefiningIdeal M) A _
  apply CentralProduct.isCentralPoint_product_of_components T S y
  · simpa only [pointsMulEquiv_eq_affine] using htc
  · simpa only [pointsMulEquiv_eq_affine] using hsc

theorem exists_lift_simplyConnectedCover_three
    (D : TauCeti.SemisimpleCommHopfAlgCat.{u} k) (C : SimplyConnectedCover D)
    (σ : D.obj →ₐc[k] D.obj) (_hσ : (σ.comp σ).comp σ = BialgHom.id k D.obj) :
    ∃ β : C.source.obj →ₐc[k] C.source.obj,
      C.coordinateMap.hom.comp σ = β.comp C.coordinateMap.hom := by
  exact exists_lift_of_simplyConnected D.obj C.source C.simplyConnected
    C.coordinateMap C.isCentralIsogeny σ

theorem multiplicationCover_comp_of_equivariant
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M)
    (C : SimplyConnectedCover ⟨derivedCoordinate M, semisimple_derivedCoordinate M hM⟩)
    (F : M →ₐc[k] M) (FT : connectedCenter M →ₐc[k] connectedCenter M)
    (FS : C.source.obj →ₐc[k] C.source.obj)
    (hFT : FT.comp (connectedCenterCoordinateMap M) = (connectedCenterCoordinateMap M).comp F)
    (hFS : FS.comp C.coordinateMap.hom = C.coordinateMap.hom.comp (derivedCoordinateEnd M F)) :
    (multiplicationCover M hM C).hom.comp F =
      (Bialgebra.TensorProduct.map FT FS).comp (multiplicationCover M hM C).hom := by
  let T := connectedCenter M
  let D := derivedCoordinate M
  let S := C.source.obj
  let q := C.coordinateMap
  let μ := multiplication M hM
  have hm := multiplication_comp_of_equivariant M hM F FT hFT
  have ht := lTensor_comp_map_of_equivariant T D S q FT
    (derivedCoordinateEnd M F) FS hFS.symm
  change ((q.hom.lTensor T).comp μ.hom).comp F =
    (Bialgebra.TensorProduct.map FT FS).comp ((q.hom.lTensor T).comp μ.hom)
  rw [BialgHom.comp_assoc, hm, ← BialgHom.comp_assoc, ht, BialgHom.comp_assoc]

end CanonicalReductive

theorem exists_equivariantReductiveCoverThree
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hred : TauCeti.reductiveCommHopfAlgProperty k M) (_h3 : (3 : k) ≠ 0)
    (σM : M →ₐc[k] M) (hM : (σM.comp σM).comp σM = BialgHom.id k M) :
    Nonempty (EquivariantReductiveCoverThree M σM) := by
  let D : TauCeti.SemisimpleCommHopfAlgCat k :=
    ⟨CanonicalReductive.derivedCoordinate M, CanonicalReductive.semisimple_derivedCoordinate M hred⟩
  obtain ⟨C⟩ := CanonicalReductive.exists_simplyConnectedCover D
  let σD := CanonicalReductive.derivedCoordinateEnd M σM
  obtain ⟨β, hβ⟩ := CanonicalReductive.exists_lift_simplyConnectedCover_three D C σD
    (CanonicalReductive.derivedCoordinateEnd_cube M σM hM)
  let : Algebra.Smooth k C.source.obj := C.source.property.smooth
  let : IsReduced C.source.obj := TauCeti.isReduced_of_smooth k _
  let : ConnectedSpace (PrimeSpectrum C.source.obj) :=
    TauCeti.geometricallyConnectedCommHopfAlgProperty.connectedSpace k C.source.obj.obj
      C.source.property.geometricallyConnected
  have hβcube := cube_eq_id_of_lift_of_isogeny D.obj C.source.obj C.coordinateMap
    C.isCentralIsogeny.isIsogeny σD β (CanonicalReductive.derivedCoordinateEnd_cube M σM hM) hβ
  have hcent : TauCeti.CommHopfAlgCat.IsCentralIsogeny
      (CanonicalReductive.multiplicationCover M hred C) := by
    apply (TauCeti.CommHopfAlgCat.isCentralIsogeny_iff _).2
    exact ⟨(CanonicalReductive.isIsogeny_multiplicationCover M hred C).finite,
      (CanonicalReductive.isIsogeny_multiplicationCover M hred C).faithfullyFlat,
      CanonicalReductive.isCentral_kernel_multiplicationCover M hred C⟩
  refine ⟨{
    torus := CanonicalReductive.connectedCenter M
    isTorus := CanonicalReductive.torus_connectedCenter M hred
    semisimple := C.source
    simplyConnected := C.simplyConnected
    torusAut := CanonicalReductive.sigmaConnectedCenter M σM hM
    semisimpleAut := β
    torusAut_cube := CanonicalReductive.sigmaConnectedCenter_cube M σM hM
    semisimpleAut_cube := hβcube
    cover := CanonicalReductive.multiplicationCover M hred C
    isCentralIsogeny := hcent
    equivariant := ?_ }⟩
  exact CanonicalReductive.multiplicationCover_comp_of_equivariant M hred C σM
    (CanonicalReductive.sigmaConnectedCenter M σM hM) β
    (CanonicalReductive.sigmaConnectedCenter_comp_coordinateMap M σM hM) hβ.symm

end CFSG.LieType.AlgebraicGroups
