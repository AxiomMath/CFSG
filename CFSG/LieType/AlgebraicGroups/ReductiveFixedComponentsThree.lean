      (TauCeti.CommHopfAlgCat.centerDefiningIdeal M.obj)
      (TauCeti.CommHopfAlgCat.isCentral_centerDefiningIdeal M.obj)
      (connectedCenterCoordinateMap_kills_centerDefiningIdeal M))
    (connectedCenterCoordinateMap_surjective M)
    (TauCeti.CommHopfAlgCat.mkQuotient_surjective M.obj _)

theorem moduleFinite_kernel_multiplication
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M) :
    Module.Finite k
      (TauCeti.FiniteTypeCommHopfAlgCat.tensorProduct (connectedCenter M) (derivedCoordinate M) ⧸
        (TauCeti.CommHopfAlgCat.kernelHopfIdeal (multiplication M hM)).toIdeal) := by
  let : Algebra.Smooth k (connectedCenter M) := (reductive_connectedCenter M hM).smooth
  let : IsReduced (connectedCenter M) := TauCeti.isReduced_of_smooth k _
  let : Algebra.Smooth k (derivedCoordinate M) := (smooth_geometricallyConnected_derivedCoordinate M hM).1
  let : IsReduced (derivedCoordinate M) := TauCeti.isReduced_of_smooth k _
  exact CentralProduct.moduleFinite_kernel_centralProductHom
    (connectedCenterCoordinateMap M) (derivedCoordinateMap M)
    (CentralProduct.pointImageCentral_of_isCentral_ker (connectedCenterCoordinateMap M)
      (TauCeti.CommHopfAlgCat.centerDefiningIdeal M.obj)
      (TauCeti.CommHopfAlgCat.isCentral_centerDefiningIdeal M.obj)
      (connectedCenterCoordinateMap_kills_centerDefiningIdeal M))
    (connectedCenterCoordinateMap_surjective M)
    (TauCeti.CommHopfAlgCat.mkQuotient_surjective M.obj _)
    (semisimple_derivedCoordinate M hM)

theorem injective_multiplication
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M) :
    Function.Injective (multiplication M hM).hom := by
  let : Algebra.Smooth k (connectedCenter M) := (reductive_connectedCenter M hM).smooth
  let : IsReduced (connectedCenter M) := TauCeti.isReduced_of_smooth k _
  let : Algebra.Smooth k (derivedCoordinate M) :=
    (smooth_geometricallyConnected_derivedCoordinate M hM).1
  let : IsReduced (derivedCoordinate M) := TauCeti.isReduced_of_smooth k _
  rw [injective_iff_map_eq_zero]
  intro a ha
  apply eq_zero_of_forall_connectedCenter_mul_derived M hM a
  intro z d
  let P := TauCeti.AffineGroup.Product.pointsMulEquiv (R := k) (H₁ := connectedCenter M)
    (H₂ := derivedCoordinate M) (A := CommAlgCat.of k k)
  have hpoint := CentralProduct.centralProductBialgHom_point_eq
    (connectedCenterCoordinateMap M) (derivedCoordinateMap M)
    (CentralProduct.pointImageCentral_of_isCentral_ker (connectedCenterCoordinateMap M)
      (TauCeti.CommHopfAlgCat.centerDefiningIdeal M.obj)
      (TauCeti.CommHopfAlgCat.isCentral_centerDefiningIdeal M.obj)
      (connectedCenterCoordinateMap_kills_centerDefiningIdeal M))
    (CommAlgCat.of k k) (P.symm (z, d))
  rw [MulEquiv.apply_symm_apply] at hpoint
  change TauCeti.AlgHom.mapDomain (multiplication M hM).hom (P.symm (z, d)) = _ at hpoint
  rw [← hpoint, TauCeti.AlgHom.mapDomain_apply_apply, ha, map_zero]

theorem faithfullyFlat_multiplication
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M) :
    (multiplication M hM).hom.toAlgHom.toRingHom.FaithfullyFlat := by
  let : Algebra.Smooth k M := hM.smooth
  let : IsReduced M := TauCeti.isReduced_of_smooth k M
  let : Algebra.FiniteType k (TauCeti.FiniteTypeCommHopfAlgCat.tensorProduct
      (connectedCenter M) (derivedCoordinate M)).obj :=
    TauCeti.FiniteTypeCommHopfAlgCat.finiteType
      (TauCeti.FiniteTypeCommHopfAlgCat.tensorProduct (connectedCenter M) (derivedCoordinate M))
  exact CFSG.ThirdParty.TauCeti.CommHopfAlgCat.faithfullyFlat_of_dominant (multiplication M hM)
    ((RingHom.denseRange_comap_iff_injective _).mpr (injective_multiplication M hM))

theorem isIsogeny_multiplication
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M) :
    TauCeti.CommHopfAlgCat.IsIsogeny (multiplication M hM) := by
  apply (TauCeti.CommHopfAlgCat.isIsogeny_iff _).2
  have hflat := faithfullyFlat_multiplication M hM
  exact ⟨(TauCeti.CommHopfAlgCat.finite_iff_moduleFinite_quotient_kernelHopfIdeal
    (multiplication M hM) hflat).2 (moduleFinite_kernel_multiplication M hM), hflat⟩

theorem isCentralIsogeny_multiplication
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M) :
    TauCeti.CommHopfAlgCat.IsCentralIsogeny (multiplication M hM) := by
  apply (TauCeti.CommHopfAlgCat.isCentralIsogeny_iff _).2
  exact ⟨(isIsogeny_multiplication M hM).finite,
    (isIsogeny_multiplication M hM).faithfullyFlat, isCentral_kernel_multiplication M hM⟩

structure SimplyConnectedCover (D : TauCeti.SemisimpleCommHopfAlgCat.{u} k) where
  source : TauCeti.SemisimpleCommHopfAlgCat.{u} k
  simplyConnected : TauCeti.simplyConnectedSemisimpleCommHopfAlgProperty k source
  coordinateMap : D.obj.obj ⟶ source.obj.obj
  isCentralIsogeny : TauCeti.CommHopfAlgCat.IsCentralIsogeny coordinateMap

@[expose] def multiplicationCover
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M)
    (C : SimplyConnectedCover ⟨derivedCoordinate M, semisimple_derivedCoordinate M hM⟩) :
    M.obj ⟶ (TauCeti.FiniteTypeCommHopfAlgCat.tensorProduct
      (connectedCenter M) C.source.obj).obj :=
  multiplication M hM ≫ _root_.CommHopfAlgCat.ofHom
    (C.coordinateMap.hom.lTensor (connectedCenter M))

theorem isIsogeny_multiplicationCover
    (M : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (hM : TauCeti.reductiveCommHopfAlgProperty k M)
    (C : SimplyConnectedCover ⟨derivedCoordinate M, semisimple_derivedCoordinate M hM⟩) :
    TauCeti.CommHopfAlgCat.IsIsogeny (multiplicationCover M hM C) :=
  (isCentralIsogeny_multiplication M hM).isIsogeny.comp
    (isCentralIsogeny_lTensor (connectedCenter M) (derivedCoordinate M) C.source.obj
      C.coordinateMap C.isCentralIsogeny).isIsogeny

theorem subsingleton_connectedCenter_of_semisimple
    (S : TauCeti.SemisimpleCommHopfAlgCat.{u} k)
    (A : CommAlgCat.{u} k) :
    Subsingleton (TauCeti.HopfAlgebra.points (R := k)
      (H := CanonicalReductive.connectedCenter S.obj) A) := by
  let C := TauCeti.CommHopfAlgCat.centerCoordinateHopfAlgebra S.obj.obj
  let R := TauCeti.CommHopfAlgCat.reducedCenterCoordinateHopfAlgebra S.obj.obj
  let T := CanonicalReductive.connectedCenter S.obj
  let : Module.Finite k C := S.property.moduleFinite_centerCoordinate
  let : Module.Finite k R := inferInstance
  let : Module.Finite k T := inferInstance
  let : Algebra.Smooth k T := (CanonicalReductive.reductive_connectedCenter S.obj
    S.property.reductive).smooth
  let : IsReduced T := TauCeti.isReduced_of_smooth k _
  let : ConnectedSpace (PrimeSpectrum T) :=
    TauCeti.geometricallyConnectedCommHopfAlgProperty.connectedSpace k T.obj
      (CanonicalReductive.reductive_connectedCenter S.obj S.property.reductive).geometricallyConnected
  have hconst : ∀ a : T, a = algebraMap k T (Bialgebra.counitAlgHom k T a) := by
    intro a
    exact TauCeti.eq_algebraMap_of_finite_range_eval a (Set.finite_range _)
      (Bialgebra.counitAlgHom k T)
  refine ⟨fun x y => ?_⟩
  apply WithConv.ofConv_injective
  apply AlgHom.ext
  intro a
  rw [hconst a, AlgHom.commutes, AlgHom.commutes]

theorem derivedCoordinateMap_surjective_points_of_generation_semisimple
    (S : TauCeti.SemisimpleCommHopfAlgCat.{u} k) :
    Function.Surjective (TauCeti.AlgHom.mapDomain (A := k)
      (CanonicalReductive.derivedCoordinateMap S.obj)) := by
  let T := CanonicalReductive.connectedCenter S.obj
  let D := CanonicalReductive.derivedCoordinate S.obj
  let : Subsingleton (TauCeti.HopfAlgebra.points (R := k) (H := T) (CommAlgCat.of k k)) :=
    subsingleton_connectedCenter_of_semisimple S (CommAlgCat.of k k)
  let : Algebra.Smooth k T := (CanonicalReductive.reductive_connectedCenter S.obj S.property.reductive).smooth
  let : IsReduced T := TauCeti.isReduced_of_smooth k _
  let : Algebra.Smooth k D := (CanonicalReductive.smooth_geometricallyConnected_derivedCoordinate
    S.obj S.property.reductive).1
  let : IsReduced D := TauCeti.isReduced_of_smooth k _
  let μ := multiplication S.obj S.property.reductive
  have hfinite : μ.hom.toAlgHom.FiniteType := by
    exact RingHom.FiniteType.of_comp_finiteType (f := algebraMap k S.obj)
      (g := μ.hom.toAlgHom.toRingHom)
      (μ.hom.toAlgHom.comp_algebraMap.symm ▸ RingHom.finiteType_algebraMap.mpr
        (TauCeti.FiniteTypeCommHopfAlgCat.finiteType
          (TauCeti.FiniteTypeCommHopfAlgCat.tensorProduct T D)))
  have hs := TauCeti.CommHopfAlgCat.mapPointsFunctor_app_surjective_of_faithfullyFlat
    (L := k) μ hfinite (faithfullyFlat_multiplication S.obj S.property.reductive)
  intro x
  obtain ⟨y, hy⟩ := hs x
  let P := TauCeti.AffineGroup.Product.pointsMulEquiv (R := k) (H₁ := T) (H₂ := D)
    (A := CommAlgCat.of k k)
  refine ⟨(P y).2, ?_⟩
  have hpoint := CentralProduct.centralProductBialgHom_point_eq
    (CanonicalReductive.connectedCenterCoordinateMap S.obj)
    (CanonicalReductive.derivedCoordinateMap S.obj)
    (CentralProduct.pointImageCentral_of_isCentral_ker
      (CanonicalReductive.connectedCenterCoordinateMap S.obj)
      (TauCeti.CommHopfAlgCat.centerDefiningIdeal S.obj.obj)
      (TauCeti.CommHopfAlgCat.isCentral_centerDefiningIdeal S.obj.obj)
      (CanonicalReductive.connectedCenterCoordinateMap_kills_centerDefiningIdeal S.obj))
    (CommAlgCat.of k k) y
  have ht : (P y).1 = 1 := Subsingleton.elim _ _
  change TauCeti.AlgHom.mapDomain (CanonicalReductive.derivedCoordinateMap S.obj) (P y).2 = x
  change TauCeti.AlgHom.mapDomain (CanonicalReductive.multiplication S.obj S.property.reductive).hom
    y = x at hy
  change TauCeti.AlgHom.mapDomain (CanonicalReductive.multiplication S.obj S.property.reductive).hom
    y = _ at hpoint
  have hp : TauCeti.AlgHom.mapDomain (CanonicalReductive.multiplication S.obj S.property.reductive).hom y =
      TauCeti.AlgHom.mapDomain (CanonicalReductive.derivedCoordinateMap S.obj) (P y).2 := by
    simpa only [P, ht, map_one, one_mul] using hpoint
  exact hp.symm.trans hy

theorem derivedDefiningIdeal_eq_bot_of_generation_semisimple
    (S : TauCeti.SemisimpleCommHopfAlgCat.{u} k) :
    TauCeti.CommHopfAlgCat.derivedDefiningIdeal (R := k) S.obj = ⊥ := by
  let : Algebra.Smooth k S.obj := S.property.smooth
  let : IsReduced S.obj := TauCeti.isReduced_of_smooth k _
  ext a
  rw [TauCeti.HopfIdeal.mem_bot]
  constructor
  · intro ha
    apply TauCeti.eq_of_forall_algHom_apply_eq (k := k) (K := k)
    intro p
    obtain ⟨d, hd⟩ := derivedCoordinateMap_surjective_points_of_generation_semisimple S (toConv p)
    have hzero : CanonicalReductive.derivedCoordinateMap S.obj a = 0 :=
      (TauCeti.CommHopfAlgCat.mkQuotient_eq_zero_iff S.obj.obj _ a).2 ha
    have h := congrArg (fun p => p.ofConv a) hd
    simpa only [TauCeti.AlgHom.mapDomain_apply_apply, hzero, map_zero, ofConv_toConv] using h.symm
  · intro ha
    rw [ha]
    exact (TauCeti.CommHopfAlgCat.derivedDefiningIdeal (R := k) S.obj).toIdeal.zero_mem

theorem algHom_eq_of_agree_commutator
    (S : TauCeti.SemisimpleCommHopfAlgCat.{u} k) (a b : S.obj) (H : ∀ p :
      commutator (TauCeti.HopfAlgebra.points (R := k) (H := S.obj) (CommAlgCat.of k k)),
      p.val.ofConv a = p.val.ofConv b) : a = b := by
  let : Algebra.Smooth k S.obj := S.property.smooth
  let : IsReduced S.obj := TauCeti.isReduced_of_smooth k _
  have hd := derivedDefiningIdeal_eq_bot_of_generation_semisimple S
  have hmem : a - b ∈ TauCeti.CommHopfAlgCat.derivedDefiningIdeal (R := k) S.obj := by
    apply (TauCeti.CommHopfAlgCat.mem_derivedDefiningIdeal_iff_forall_commutator_apply_eq_zero _).2
    intro p
    rw [map_sub, H p, sub_self]
  rw [hd, TauCeti.HopfIdeal.mem_bot, sub_eq_zero] at hmem
  exact hmem

theorem isCentralPoint_of_mapDomain_of_isCentralIsogeny_semisimple
    (D : TauCeti.FiniteTypeCommHopfAlgCat.{u,u} k)
    (S : TauCeti.SemisimpleCommHopfAlgCat.{u} k)
    (q : D.obj ⟶ S.obj.obj) (hq : TauCeti.CommHopfAlgCat.IsCentralIsogeny q)
    {A : CommAlgCat.{u} k}
    (z : TauCeti.HopfAlgebra.points (R := k) (H := S.obj) A)
    (hz : TauCeti.HopfAlgebra.IsCentralPoint (TauCeti.AlgHom.mapDomain q.hom z)) :
    TauCeti.HopfAlgebra.IsCentralPoint z := by
  apply isCentralPoint_of_mapDomain_of_isCentralIsogeny_of_separating_commutator D S.obj q hq _ z hz
  intro a ha
  exact algHom_eq_of_agree_commutator S a 0 (fun p => (ha p).trans (map_zero _).symm)

theorem isCentralIsogeny_comp_semisimple
    (D S X : TauCeti.SemisimpleCommHopfAlgCat.{u} k)
    (q : D.obj.obj ⟶ S.obj.obj) (f : S.obj.obj ⟶ X.obj.obj)
    (hq : TauCeti.CommHopfAlgCat.IsCentralIsogeny q)
    (hf : TauCeti.CommHopfAlgCat.IsCentralIsogeny f) :
    TauCeti.CommHopfAlgCat.IsCentralIsogeny (q ≫ f) := by
  apply (TauCeti.CommHopfAlgCat.isCentralIsogeny_iff _).2
  have hi := hq.isIsogeny.comp hf.isIsogeny
  refine ⟨hi.finite, hi.faithfullyFlat, ?_⟩
  apply (TauCeti.CommHopfAlgCat.isCentral_iff_forall_isCentralPoint _ _).2
  intro A z hz
  have hqfz : TauCeti.AlgHom.mapDomain q.hom (TauCeti.AlgHom.mapDomain f.hom z) = 1 := by
    rw [← MonoidHom.comp_apply, ← TauCeti.AlgHom.mapDomain_comp]
    exact (TauCeti.CommHopfAlgCat.mapPointsFunctor_app_eq_one_iff (q ≫ f) A z).2 hz
  have hzc : TauCeti.HopfAlgebra.IsCentralPoint (TauCeti.AlgHom.mapDomain f.hom z) :=
    TauCeti.CommHopfAlgCat.isCentralPoint_of_mem_quotientPointsSubgroup
      S.obj.obj (TauCeti.CommHopfAlgCat.kernelHopfIdeal q) hq.isCentral_kernelHopfIdeal A
        ((TauCeti.CommHopfAlgCat.mapPointsFunctor_app_eq_one_iff q A _).1 hqfz)
  exact isCentralPoint_of_mapDomain_of_isCentralIsogeny_semisimple S.obj X f hf z hzc

