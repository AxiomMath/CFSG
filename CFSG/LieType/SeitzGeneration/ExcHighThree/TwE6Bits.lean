theorem xwA_eq (i : Fin 6) :
    (List.range 78).map (fun c => 2 ^ c ^^^ mk i 2 c ^^^ mk i 3 c) = xwA i := by
  fin_cases i <;> decide +kernel

theorem xwB_eq (i : Fin 6) :
    (List.range 78).map (fun c => mk i 1 c ^^^ mk i 2 c) = xwB i := by
  fin_cases i <;> decide +kernel

theorem xwA2_eq (i : Fin 6) :
    (List.range 78).map (fun c => 2 ^ c ^^^ mk i 1 c ^^^ mk i 3 c) = xwA2 i := by
  fin_cases i <;> decide +kernel

theorem elt_omega_posVec [CharP K 2] {ω : K} (hω : ω ^ 2 + ω + 1 = 0) (α : Root Tag.E6) {c : ℕ}
    (hc : c < 78) :
    (rootOperatorFamily Tag.E6).elt K α ω (posVec Tag.E6 K c) =
      bitVec K (2 ^ c ^^^ mk (rootPos α) 2 c ^^^ mk (rootPos α) 3 c) +
        ω • bitVec K (mk (rootPos α) 1 c ^^^ mk (rootPos α) 2 c) := by
  have hval : ∀ k ∈ [1, 2, 3],
      ValidVec Tag.E6 (colOf (entries Tag.E6 (rootPos α) k) c) := fun k hk =>
    (validEntries_of_validB
      (validB_of_allValid (τ := Tag.E6) e6_allValid (rootPos_lt α) hk)).colOf c
  have e1 := vecOf_eq_bitVec (K := K) _ (hval 1 (by simp))
  have e2 := vecOf_eq_bitVec (K := K) _ (hval 2 (by simp))
  have e3 := vecOf_eq_bitVec (K := K) _ (hval 3 (by simp))
  rw [elt_posVec_general α ω hc, e1, e2, e3, bitVec_xor, bitVec_xor, bitVec_xor,
    bitVec_two_pow hc]
  have h2 : ω ^ 2 = ω + 1 := by rw [sq]; exact sq_eq_of_root hω
  have h3 : ω ^ 3 = 1 := by linear_combination (ω - 1) * hω
  simp only [mk]
  rw [h2, h3]
  module

theorem elt_omega_sq_posVec [CharP K 2] {ω : K} (hω : ω ^ 2 + ω + 1 = 0) (α : Root Tag.E6) {c : ℕ}
    (hc : c < 78) :
    (rootOperatorFamily Tag.E6).elt K α (ω ^ 2) (posVec Tag.E6 K c) =
      bitVec K (2 ^ c ^^^ mk (rootPos α) 1 c ^^^ mk (rootPos α) 3 c) +
        ω • bitVec K (mk (rootPos α) 1 c ^^^ mk (rootPos α) 2 c) := by
  have hval : ∀ k ∈ [1, 2, 3],
      ValidVec Tag.E6 (colOf (entries Tag.E6 (rootPos α) k) c) := fun k hk =>
    (validEntries_of_validB
      (validB_of_allValid (τ := Tag.E6) e6_allValid (rootPos_lt α) hk)).colOf c
  have e1 := vecOf_eq_bitVec (K := K) _ (hval 1 (by simp))
  have e2 := vecOf_eq_bitVec (K := K) _ (hval 2 (by simp))
  have e3 := vecOf_eq_bitVec (K := K) _ (hval 3 (by simp))
  rw [elt_posVec_general α (ω ^ 2) hc, e1, e2, e3, bitVec_xor, bitVec_xor, bitVec_xor,
    bitVec_two_pow hc]
  have h2 : ω ^ 2 = ω + 1 := by rw [sq]; exact sq_eq_of_root hω
  have h3 : ω ^ 3 = 1 := by linear_combination (ω - 1) * hω
  have h4 : (ω ^ 2) ^ 2 = ω := by
    calc (ω ^ 2) ^ 2 = ω * ω ^ 3 := by ring
      _ = ω := by rw [h3, mul_one]
  have h6 : (ω ^ 2) ^ 3 = 1 := by
    calc (ω ^ 2) ^ 3 = (ω ^ 3) ^ 2 := by ring
      _ = 1 := by rw [h3, one_pow]
  simp only [mk]
  rw [h4, h6, h2]
  module


theorem coe_xUnit_eq_elt (i : Fin 6) (t : K) :
    ((xUnit Tag.E6 K (idx i) t : ModGL Tag.E6 K) : Module.End K (RootModule Tag.E6 K)) =
      (rootOperatorFamily Tag.E6).elt K (simpleRoot Tag.E6 (idx i)) t := by
  rw [(rootOperatorFamily Tag.E6).elt_simple]
  rfl

theorem hasBits2_xUnit_omega [CharP K 2] {ω : K} (hω : ω ^ 2 + ω + 1 = 0) (i : Fin 6) :
    HasBits2 K ω (xUnit Tag.E6 K (idx i) ω) ⟨pack (xwA i), pack (xwB i)⟩ := by
  unfold HasBits2 toEnd2
  refine ext_posVec fun c hc => ?_
  rw [dim_E6] at hc
  rw [coe_xUnit_eq_elt, elt_omega_posVec hω _ hc, rootPos_simpleRoot, LinearMap.add_apply,
    LinearMap.smul_apply, toEnd_pack_posVec K _ hc, toEnd_pack_posVec K _ hc, ← xwA_eq,
    ← xwB_eq, getD_map_range hc, getD_map_range hc]
  rfl

theorem hasBits2_xUnit_omega_sq [CharP K 2] {ω : K} (hω : ω ^ 2 + ω + 1 = 0) (i : Fin 6) :
    HasBits2 K ω (xUnit Tag.E6 K (idx i) (ω ^ 2)) ⟨pack (xwA2 i), pack (xwB i)⟩ := by
  unfold HasBits2 toEnd2
  refine ext_posVec fun c hc => ?_
  rw [dim_E6] at hc
  rw [coe_xUnit_eq_elt, elt_omega_sq_posVec hω _ hc, rootPos_simpleRoot, LinearMap.add_apply,
    LinearMap.smul_apply, toEnd_pack_posVec K _ hc, toEnd_pack_posVec K _ hc, ← xwA2_eq,
    ← xwB_eq, getD_map_range hc, getD_map_range hc]
  rfl


