structure Bits2 where
  a : ℕ
  b : ℕ

namespace Bits2

@[expose] def mul (X Y : Bits2) : Bits2 :=
  ⟨E6Bits.mul X.a Y.a ^^^ E6Bits.mul X.b Y.b,
    E6Bits.mul (X.a ^^^ X.b) (Y.a ^^^ Y.b) ^^^ E6Bits.mul X.a Y.a⟩

@[expose] def one : Bits2 := ⟨oneBits, 0⟩

@[expose] def eqb (X Y : Bits2) : Bool :=
  decide (X.a % 2 ^ 6084 = Y.a % 2 ^ 6084) && decide (X.b % 2 ^ 6084 = Y.b % 2 ^ 6084)

end Bits2

@[expose] def prod2 (L : List Bits2) : Bits2 :=
  L.foldr Bits2.mul Bits2.one

variable (K : Type) [Field K]

@[expose] noncomputable def toEnd2 (ω : K)
    (X : Bits2) : Module.End K (RootModule Tag.E6 K) :=
  toEnd K X.a + ω • toEnd K X.b

variable {K}

theorem bitK_false [CharP K 2] : bitK K false = 0 := by
  have h := bitK_xor (K := K) false false
  have h0 : (false ^^ false) = false := rfl
  rw [h0] at h
  linear_combination (-1 : K) * h

theorem bitK_true [CharP K 2] : bitK K true = 1 := by
  have h := bitK_and (K := K) true true
  have h0 : (true && true) = true := rfl
  rw [h0] at h
  have hne : bitK K true ≠ 0 := by
    intro h1
    have := bitK_injective (K := K) (h1.trans bitK_false.symm)
    exact absurd this (by decide)
  exact (mul_eq_left₀ hne).1 h.symm

theorem vec_ext_posCoord {v w : RootModule Tag.E6 K}
    (h : ∀ p, p < 78 → posCoord Tag.E6 K p v = posCoord Tag.E6 K p w) : v = w := by
  refine Finsupp.ext fun b => ?_
  obtain ⟨p, hp, rfl⟩ := posLabel_surjective (τ := Tag.E6) b
  have h1 := h p (by have := hp; rwa [dim_E6] at this)
  simpa [posCoord, hp] using h1

theorem toEnd_zero [CharP K 2] :
    toEnd K 0 = 0 := by
  refine ext_posVec fun c hc => ?_
  rw [dim_E6] at hc
  have h := toEnd_pack_posVec K [] hc
  rw [show pack [] = 0 from rfl] at h
  rw [h]
  simp [bitVec_zero]

theorem toEnd_xor [CharP K 2]
    (A B : ℕ) : toEnd K (A ^^^ B) = toEnd K A + toEnd K B := by
  refine ext_posVec fun c hc => ?_
  rw [dim_E6] at hc
  refine vec_ext_posCoord fun p hp => ?_
  rw [LinearMap.add_apply, map_add, posCoord_toEnd_posVec _ hc hp, posCoord_toEnd_posVec _ hc hp,
    posCoord_toEnd_posVec _ hc hp, Nat.testBit_xor, bitK_xor]

theorem sq_eq_of_root [CharP K 2] {ω : K} (hω : ω ^ 2 + ω + 1 = 0) : ω * ω = ω + 1 := by
  have h : ω * ω = -(ω + 1) := by linear_combination hω
  rw [h, CharTwo.neg_eq]

theorem toEnd2_mul [CharP K 2]
    {ω : K} (hω : ω ^ 2 + ω + 1 = 0) (X Y : Bits2) :
    toEnd2 K ω (X.mul Y) = toEnd2 K ω X * toEnd2 K ω Y := by
  have h2 := sq_eq_of_root hω
  have h2K : (2 : K) = 0 := CharTwo.two_eq_zero
  simp only [toEnd2, Bits2.mul, toEnd_xor, toEnd_mul, mul_add, add_mul, smul_mul_assoc,
    mul_smul_comm, smul_smul, smul_add, h2, add_smul, one_smul]
  have h2' : ∀ x : Module.End K (RootModule Tag.E6 K), x + x = 0 := fun x => by
    rw [← two_smul K x, h2K, zero_smul]
  have hz : ω • (toEnd K X.a * toEnd K Y.a) + ω • (toEnd K X.a * toEnd K Y.a) = 0 := h2' _
  rw [← sub_eq_zero]
  abel_nf
  rw [two_zsmul]
  exact hz

theorem omega_ne_zero [CharP K 2] {ω : K} (hω : ω ^ 2 + ω + 1 = 0) : ω ≠ 0 := by
  intro h
  rw [h] at hω
  simp at hω

theorem omega_ne_one [CharP K 2] {ω : K} (hω : ω ^ 2 + ω + 1 = 0) : ω ≠ 1 := by
  intro h
  rw [h] at hω
  have h2K : (2 : K) = 0 := CharTwo.two_eq_zero
  have : (1 : K) = 0 := by linear_combination hω - (1 : K) * h2K
  exact one_ne_zero this

theorem bit_pair_inj [CharP K 2] {ω : K} (hω : ω ^ 2 + ω + 1 = 0) (a b a' b' : Bool)
    (h : bitK K a + ω * bitK K b = bitK K a' + ω * bitK K b') : a = a' ∧ b = b' := by
  have h0 := omega_ne_zero hω
  have h1 := omega_ne_one hω
  have h2K : (2 : K) = 0 := CharTwo.two_eq_zero
  cases a <;> cases b <;> cases a' <;> cases b' <;> simp only [bitK_true, bitK_false] at h <;>
    first
    | exact ⟨rfl, rfl⟩
    | (exfalso; first
        | exact h1 (by linear_combination h)
        | exact h1 (by linear_combination -h)
        | exact h1 (by linear_combination h - h2K)
        | exact h1 (by linear_combination -h - h2K)
        | exact h1 (by linear_combination h + h2K)
        | exact h1 (by linear_combination -h + h2K)
        | exact h0 (by linear_combination h)
        | exact h0 (by linear_combination -h)
        | exact h0 (by linear_combination h - h2K)
        | exact h0 (by linear_combination -h - h2K)
        | exact one_ne_zero (α := K) (by linear_combination h)
        | exact one_ne_zero (α := K) (by linear_combination -h))

theorem toEnd2_eq_iff [CharP K 2]
    {ω : K} (hω : ω ^ 2 + ω + 1 = 0) (X Y : Bits2) :
    toEnd2 K ω X = toEnd2 K ω Y ↔
      X.a % 2 ^ 6084 = Y.a % 2 ^ 6084 ∧ X.b % 2 ^ 6084 = Y.b % 2 ^ 6084 := by
  have h0 := omega_ne_zero hω
  have h1 := omega_ne_one hω
  constructor
  · intro h
    have key : ∀ k, k < 6084 →
        X.a.testBit k = Y.a.testBit k ∧ X.b.testBit k = Y.b.testBit k := by
      intro k hk
      have hc : k / 78 < 78 := by omega
      have hp : k % 78 < 78 := by omega
      have e : 78 * (k / 78) + k % 78 = k := by omega
      have h1' := congrArg (fun f => posCoord Tag.E6 K (k % 78) (f (posVec Tag.E6 K (k / 78)))) h
      simp only [toEnd2, LinearMap.add_apply, LinearMap.smul_apply, map_add, map_smul,
        smul_eq_mul, posCoord_toEnd_posVec _ hc hp, e] at h1'
      exact bit_pair_inj hω _ _ _ _ h1'
    constructor <;> refine Nat.eq_of_testBit_eq fun k => ?_ <;>
      rw [Nat.testBit_mod_two_pow, Nat.testBit_mod_two_pow]
    · by_cases hk : k < 6084
      · rw [(key k hk).1]
      · simp [hk]
    · by_cases hk : k < 6084
      · rw [(key k hk).2]
      · simp [hk]
  · rintro ⟨ha, hb⟩
    unfold toEnd2
    rw [(toEnd_eq_toEnd_iff _ _).2 ha, (toEnd_eq_toEnd_iff _ _).2 hb]

variable (K) in
@[expose] def HasBits2 (ω : K)
    (g : ModGL Tag.E6 K) (X : Bits2) : Prop :=
  (g : Module.End K (RootModule Tag.E6 K)) = toEnd2 K ω X

theorem HasBits2.mul [CharP K 2]
    {ω : K} (hω : ω ^ 2 + ω + 1 = 0) {g h : ModGL Tag.E6 K} {X Y : Bits2}
    (hg : HasBits2 K ω g X) (hh : HasBits2 K ω h Y) : HasBits2 K ω (g * h) (X.mul Y) := by
  rw [HasBits2, toEnd2_mul hω, ← hg, ← hh]
  rfl

theorem HasBits2.eq_iff [CharP K 2]
    {ω : K} (hω : ω ^ 2 + ω + 1 = 0) {g h : ModGL Tag.E6 K} {X Y : Bits2}
    (hg : HasBits2 K ω g X) (hh : HasBits2 K ω h Y) :
    g = h ↔ X.a % 2 ^ 6084 = Y.a % 2 ^ 6084 ∧ X.b % 2 ^ 6084 = Y.b % 2 ^ 6084 := by
  rw [← toEnd2_eq_iff hω, ← hg, ← hh]
  exact ⟨fun e => by rw [e], fun e => Units.ext e⟩

theorem hasBits2_one [CharP K 2]
    (ω : K) : HasBits2 K ω 1 Bits2.one := by
  unfold HasBits2 toEnd2 Bits2.one
  rw [show (((1 : ModGL Tag.E6 K) : Module.End K (RootModule Tag.E6 K))) = 1 from rfl,
    toEnd_oneBits.symm.symm, toEnd_zero]
  simp

theorem hasBits2_of_hasBits [CharP K 2]
    (ω : K) {g : adjointGroup Tag.E6 K} {A : ℕ} (h : E6Bits.HasBits K g A) :
    HasBits2 K ω (g : ModGL Tag.E6 K) ⟨A, 0⟩ := by
  unfold HasBits2 toEnd2
  rw [toEnd_zero, smul_zero, add_zero]
  exact h

theorem hasBits2_prod2 [CharP K 2]
    {ω : K} (hω : ω ^ 2 + ω + 1 = 0) : ∀ (L : List (ModGL Tag.E6 K)) (M : List Bits2),
    List.Forall₂ (HasBits2 K ω) L M → HasBits2 K ω L.prod (prod2 M)
  | [], [], _ => by simpa [prod2] using hasBits2_one ω
  | g :: L, X :: M, h => by
    obtain ⟨hg, hL⟩ := List.forall₂_cons.1 h
    rw [List.prod_cons]
    exact hg.mul hω (hasBits2_prod2 hω L M hL)
  | [], _ :: _, h => by cases h
  | _ :: _, [], h => by cases h

