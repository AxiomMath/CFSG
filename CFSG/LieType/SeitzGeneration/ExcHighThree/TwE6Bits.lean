theorem elt_posVec_general (α : Root Tag.E6) (t : K) {c : ℕ} (hc : c < 78) :
    (rootOperatorFamily Tag.E6).elt K α t (posVec Tag.E6 K c) =
      posVec Tag.E6 K c + t • vecOf Tag.E6 K (colOf (entries Tag.E6 (rootPos α) 1) c) +
        t ^ 2 • vecOf Tag.E6 K (colOf (entries Tag.E6 (rootPos α) 2) c) +
        t ^ 3 • vecOf Tag.E6 K (colOf (entries Tag.E6 (rootPos α) 3) c) := by
  have hc' : c < dim Tag.E6 := by rw [dim_E6]; exact hc
  change (∑ k ∈ Finset.range 4, t ^ k • dataD Tag.E6 K α k) (posVec Tag.E6 K c) = _
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add, LinearMap.add_apply,
    LinearMap.smul_apply, dataD]
  simp only [ite_true, show (1 : ℕ) ≠ 0 by decide, show (2 : ℕ) ≠ 0 by decide,
    show (3 : ℕ) ≠ 0 by decide, ite_false, show (1 : ℕ) ≤ 3 by decide, show (2 : ℕ) ≤ 3 by decide,
    le_refl, Module.End.one_apply, entriesOp_posVec _ hc', pow_zero, one_smul, pow_one]

@[expose] def mk (a k c : ℕ) : ℕ :=
  maskOf (colOf (entries Tag.E6 a k) c)

