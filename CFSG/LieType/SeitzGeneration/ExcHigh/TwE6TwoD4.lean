theorem tv_zero_one_eq_uSL {F : Type} [Field F] (c : F) : (tv 0 1 c : SL(2, F)) = uSL c := by
  apply Matrix.SpecialLinearGroup.coeMonoidHom_injective
  rw [Matrix.SpecialLinearGroup.coeMonoidHom_apply, Matrix.SpecialLinearGroup.coeMonoidHom_apply,
    tv_of_ne (by decide), Matrix.SpecialLinearGroup.transvection_coe]
  ext a b
  fin_cases a <;> fin_cases b <;> simp [uSL]

theorem tv_one_zero_eq_vSL {F : Type} [Field F] (c : F) : (tv 1 0 c : SL(2, F)) = vSL c := by
  apply Matrix.SpecialLinearGroup.coeMonoidHom_injective
  rw [Matrix.SpecialLinearGroup.coeMonoidHom_apply, Matrix.SpecialLinearGroup.coeMonoidHom_apply,
    tv_of_ne (by decide), Matrix.SpecialLinearGroup.transvection_coe]
  ext a b
  fin_cases a <;> fin_cases b <;> simp [vSL]

