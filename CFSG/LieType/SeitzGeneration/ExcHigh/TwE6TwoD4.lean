theorem rankOneFix_leaf_tv (σ : K →+* K) (c : RingHom.eqLocusField σ (RingHom.id K)) :
    rankOneFix σ orbLeaf orbLeaf_card (tv 0 1 c) = xUnit Tag.E6 K (e6Index 3) (c : K) ∧
      rankOneFix σ orbLeaf orbLeaf_card (tv 1 0 c) = yUnit Tag.E6 K (e6Index 3) (c : K) := by
  refine ⟨?_, ?_⟩
  · rw [rankOneFix_tv01]
    exact coe_orbitX_two σ _
  · rw [rankOneFix_tv10]
    exact coe_orbitY_two σ _

