theorem rankOneFix_tv01 (σ : K →+* K) (a : Fin TwistTag.E6.foldedTag.rank)
    (ha : (TwistTag.E6.orbit a).card = 1) (c : RingHom.eqLocusField σ (RingHom.id K)) :
    rankOneFix σ a ha (tv 0 1 c) =
      (orbitX TwistTag.E6 K σ a (Subfield.inclusion (fix_le_orbitField σ a ha) c) :
        ModGL TwistTag.E6.tag K) := by
  rw [tv_zero_one_eq_uSL, rankOneFix, MonoidHom.comp_apply, fixIncl_uSL, orbitRankOneHom_uSL]

omit
  [Finite K] in
theorem rankOneFix_tv10 (σ : K →+* K) (a : Fin TwistTag.E6.foldedTag.rank)
    (ha : (TwistTag.E6.orbit a).card = 1) (c : RingHom.eqLocusField σ (RingHom.id K)) :
    rankOneFix σ a ha (tv 1 0 c) =
      (orbitY TwistTag.E6 K σ a (Subfield.inclusion (fix_le_orbitField σ a ha) c) :
        ModGL TwistTag.E6.tag K) := by
  rw [tv_one_zero_eq_vSL, rankOneFix, MonoidHom.comp_apply, fixIncl_vSL, orbitRankOneHom_vSL]

