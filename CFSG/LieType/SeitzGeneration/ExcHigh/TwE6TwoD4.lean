  [Finite K] in
theorem rootTransport_one : RootTransport (1 : ModGL TwistTag.E6.tag K) 1 := by
  intro β hβ
  have : (MulAut.conj (1 : ModGL TwistTag.E6.tag K)).toMonoidHom = MonoidHom.id _ := by
    ext x
    simp
  rw [this, Subgroup.map_id, one_smul]

