theorem rootTransport_mul {g g' : ModGL TwistTag.E6.tag K} {w w' : WeylGroup TwistTag.E6.tag}
    (h : RootTransport g w) (h' : RootTransport g' w') : RootTransport (g * g') (w * w') := by
  intro β hβ
  have hc : (MulAut.conj (g * g')).toMonoidHom =
      (MulAut.conj g).toMonoidHom.comp (MulAut.conj g').toMonoidHom := by
    ext x
    simp [mul_assoc]
  rw [hc, ← Subgroup.map_map, h' β hβ, h _ (IsRoot.smul hβ w'), mul_smul]

omit
  [Finite K] in
theorem rootTransport_inv {g : ModGL TwistTag.E6.tag K} {w : WeylGroup TwistTag.E6.tag}
    (h : RootTransport g w) : RootTransport g⁻¹ w⁻¹ := by
  intro β hβ
  have h1 := h (w⁻¹ • β) (IsRoot.smul hβ w⁻¹)
  rw [smul_inv_smul] at h1
  have hc : (MulAut.conj g⁻¹).toMonoidHom.comp (MulAut.conj g).toMonoidHom = MonoidHom.id _ := by
    ext x
    simp [mul_assoc]
  rw [← h1, Subgroup.map_map, hc, Subgroup.map_id]

