variable {K : Type} [Field K] [Finite K]

theorem exists_sl3_of_adj (σ : K →+* K) {i j : Fin Tag.E6.rank} (hij : i ≠ j)
    (hcij : Tag.E6.cartan i j = -1) (hcji : Tag.E6.cartan j i = -1)
    (hk : ∃ l, ¬ (3 : ℤ) ∣ Tag.E6.cartan i l + 2 * Tag.E6.cartan j l)
    (ρi ρj : SL(2, RingHom.eqLocusField σ (RingHom.id K)) →* ModGL Tag.E6 K)
    (hρi : ∀ c : RingHom.eqLocusField σ (RingHom.id K),
      ρi (tv 0 1 c) = xUnit Tag.E6 K i (c : K) ∧ ρi (tv 1 0 c) = yUnit Tag.E6 K i (c : K))
    (hρj : ∀ c : RingHom.eqLocusField σ (RingHom.id K),
      ρj (tv 0 1 c) = xUnit Tag.E6 K j (c : K) ∧ ρj (tv 1 0 c) = yUnit Tag.E6 K j (c : K))
    (hGi : ∀ A, ρi A ∈ graphFixedRootGroup TwistTag.E6 K σ)
    (hGj : ∀ A, ρj A ∈ graphFixedRootGroup TwistTag.E6 K σ) :
    ∃ ψ : SL(3, RingHom.eqLocusField σ (RingHom.id K)) →* ModGL Tag.E6 K,
      (∀ g, ψ g ∈ graphFixedRootGroup TwistTag.E6 K σ) ∧
        ψ.comp (blk (RingHom.eqLocusField σ (RingHom.id K)) 0) = ρi ∧
        ψ.comp (blk (RingHom.eqLocusField σ (RingHom.id K)) 1) = ρj := by
  classical
  obtain ⟨O, C, hE⟩ := CFSG.ComponentClassification.CatLeafProof.exists_e6_chevalleyExtras
    (RingHom.eqLocusField σ (RingHom.id K))
  obtain ⟨l, hl⟩ := hk
  obtain ⟨emb, -, -, hv⟩ := exists_sl3Levi hE rfl hij hcij hcji hl
  let ι : RingHom.eqLocusField σ (RingHom.id K) →+* K :=
    (RingHom.eqLocusField σ (RingHom.id K)).subtype
  let Ψ : SL(3, RingHom.eqLocusField σ (RingHom.id K)) →* ModGL Tag.E6 K :=
    (baseChangeGL ι).comp
      ((adjointGroup Tag.E6 (RingHom.eqLocusField σ (RingHom.id K))).subtype.comp emb)
  have hx : ∀ (n : Fin Tag.E6.rank) (c : RingHom.eqLocusField σ (RingHom.id K)),
      baseChangeGL ι (((Steinberg.Adjoint.xPar (rootOperatorFamily Tag.E6) (sroot n) c :
        adjointGroup Tag.E6 (RingHom.eqLocusField σ (RingHom.id K))) :
          ModGL Tag.E6 (RingHom.eqLocusField σ (RingHom.id K)))) = xUnit Tag.E6 K n (c : K) :=
    fun n c => by
      rw [sroot, CFSG.StandardType.AutSt.xPar_single_eq_adjX]
      exact baseChangeGL_xUnit ι n c
  have hy : ∀ (n : Fin Tag.E6.rank) (c : RingHom.eqLocusField σ (RingHom.id K)),
      baseChangeGL ι (((Steinberg.Adjoint.xPar (rootOperatorFamily Tag.E6) (-sroot n) c :
        adjointGroup Tag.E6 (RingHom.eqLocusField σ (RingHom.id K))) :
          ModGL Tag.E6 (RingHom.eqLocusField σ (RingHom.id K)))) = yUnit Tag.E6 K n (c : K) :=
    fun n c => by
      rw [sroot, CFSG.StandardType.AutSt.xPar_neg_single_eq_adjY]
      exact baseChangeGL_yUnit ι n c
  have hΨ0 : Ψ.comp (blk (RingHom.eqLocusField σ (RingHom.id K)) 0) = ρi := by
    refine hom_ext_sl2 (fun c => ?_) (fun c => ?_)
    · rw [MonoidHom.comp_apply, blk_zero_tv01, (hρi c).1]
      exact (congrArg (baseChangeGL ι) (congrArg Subtype.val (hv c).1)).trans (hx i c)
    · rw [MonoidHom.comp_apply, blk_zero_tv10, (hρi c).2]
      exact (congrArg (baseChangeGL ι) (congrArg Subtype.val (hv c).2.1)).trans (hy i c)
  have hΨ1 : Ψ.comp (blk (RingHom.eqLocusField σ (RingHom.id K)) 1) = ρj := by
    refine hom_ext_sl2 (fun c => ?_) (fun c => ?_)
    · rw [MonoidHom.comp_apply, blk_one_tv01, (hρj c).1]
      exact (congrArg (baseChangeGL ι) (congrArg Subtype.val (hv c).2.2.1)).trans (hx j c)
    · rw [MonoidHom.comp_apply, blk_one_tv10, (hρj c).2]
      exact (congrArg (baseChangeGL ι) (congrArg Subtype.val (hv c).2.2.2)).trans (hy j c)
  refine ⟨Ψ, fun g => ?_, hΨ0, hΨ1⟩
  have hg : g ∈ B12 (RingHom.eqLocusField σ (RingHom.id K)) ⊔
      B23 (RingHom.eqLocusField σ (RingHom.id K)) := by
    rw [B12_sup_B23]
    trivial
  have hle : B12 (RingHom.eqLocusField σ (RingHom.id K)) ⊔
      B23 (RingHom.eqLocusField σ (RingHom.id K)) ≤
        (graphFixedRootGroup TwistTag.E6 K σ).comap Ψ := by
    refine sup_le ?_ ?_
    · rintro _ ⟨A, rfl⟩
      show Ψ (blk (RingHom.eqLocusField σ (RingHom.id K)) 0 A) ∈
        graphFixedRootGroup TwistTag.E6 K σ
      rw [← MonoidHom.comp_apply, hΨ0]
      exact hGi A
    · rintro _ ⟨A, rfl⟩
      show Ψ (blk (RingHom.eqLocusField σ (RingHom.id K)) 1 A) ∈
        graphFixedRootGroup TwistTag.E6 K σ
      rw [← MonoidHom.comp_apply, hΨ1]
      exact hGj A
  exact hle hg

