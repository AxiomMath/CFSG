theorem pairing_center :
    (∑ k, Tag.E6.cartan ⟨0, by decide⟩ k * (Pi.single cNode 1 : Fin Tag.E6.rank → ℤ) k) = 0 ∧
    (∑ k, Tag.E6.cartan ⟨5, by decide⟩ k * (Pi.single cNode 1 : Fin Tag.E6.rank → ℤ) k) = 0 ∧
    (∑ k, Tag.E6.cartan ⟨2, by decide⟩ k * (Pi.single cNode 1 : Fin Tag.E6.rank → ℤ) k) = 0 ∧
    (∑ k, Tag.E6.cartan ⟨4, by decide⟩ k * (Pi.single cNode 1 : Fin Tag.E6.rank → ℤ) k) = 0 := by
  decide

omit [Finite K]
  in
theorem rootChar_torusTuple_center (σ : K →+* K) (u v : Kˣ) :
    rootChar (torusTuple σ u v) (Pi.single cNode 1) = 1 := by
  obtain ⟨h0, h5, h2, h4⟩ := pairing_center
  rw [rootChar_torusTuple, h0, h5, h2, h4]
  simp

omit [Finite K]
  in
theorem torusG_commute_center (σ : K →+* K) (t : ↥(normOne σ) × ↥(normOne σ))
    (A : SL(2, RingHom.eqLocusField σ (RingHom.id K))) :
    torusG σ t * centerHom σ A = centerHom σ A * torusG σ t := by
  apply Subtype.ext
  rw [Subgroup.coe_mul, Subgroup.coe_mul, coe_torusG, coe_centerHom]
  exact (commute_rootDiagUnit_of_rootChar_eq_one (torusTuple σ t.1 t.2) (isRoot_single _ cNode)
    (rootChar_torusTuple_center σ _ _)
    (rankOneFix_mem_rootPair σ orbCenter orbCenter_card orbCenter_orbit A)).eq

omit [Finite K]
  in
theorem torusG_commute_d4Group (σ : K →+* K) (t : ↥(normOne σ) × ↥(normOne σ)) :
    ∀ y ∈ d4Group σ, torusG σ t * y = y * torusG σ t := by
  have hle : d4Group σ ≤
      Subgroup.centralizer ({torusG σ t} : Set (graphFixedRootGroup TwistTag.E6 K σ)) := by
    refine iSup_le fun i => ?_
    rintro _ ⟨A, rfl⟩
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    rw [Set.mem_singleton_iff.1 hh]
    fin_cases i
    · exact (torusG_commute_frame σ (frameHom_mem_rootPair σ) t 0 A).eq
    · exact torusG_commute_center σ t A
    · exact (torusG_commute_frame σ (frameHom_mem_rootPair σ) t 1 A).eq
    · exact (torusG_commute_frame σ (frameHom_mem_rootPair σ) t 2 A).eq
  intro y hy
  exact (Subgroup.mem_centralizer_iff.1 (hle hy) _ (Set.mem_singleton _))

end TorusD4

