  · rw [rankOneFix_tv10]
    exact coe_orbitY_three σ _

@[expose] def centerHom (σ : K →+* K) :
    SL(2, RingHom.eqLocusField σ (RingHom.id K)) →* graphFixedRootGroup TwistTag.E6 K σ :=
  (rankOneFix σ orbCenter orbCenter_card).codRestrict _
    (rankOneFix_mem_graphFixed σ orbCenter orbCenter_card)

