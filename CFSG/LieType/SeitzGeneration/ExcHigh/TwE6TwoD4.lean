theorem coe_centerHom (σ : K →+* K) (A : SL(2, RingHom.eqLocusField σ (RingHom.id K))) :
    ((centerHom σ A : graphFixedRootGroup TwistTag.E6 K σ) : ModGL TwistTag.E6.tag K) =
      rankOneFix σ orbCenter orbCenter_card A := rfl

