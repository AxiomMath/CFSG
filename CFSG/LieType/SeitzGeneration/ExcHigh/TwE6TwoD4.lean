    (A : SL(2, RingHom.eqLocusField σ (RingHom.id K))) (i : Fin TwistTag.E6.tag.rank)
    (hi : i = ⟨0, by decide⟩ ∨ i = ⟨2, by decide⟩ ∨ i = ⟨4, by decide⟩ ∨ i = ⟨5, by decide⟩)
