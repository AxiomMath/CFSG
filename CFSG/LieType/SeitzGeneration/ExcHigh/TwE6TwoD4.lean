  [Finite K] in
theorem coe_frameHom_zero (σ : K →+* K) (A : SL(2, RingHom.eqLocusField σ (RingHom.id K))) :
    ((frameHom σ 0 A : graphFixedRootGroup TwistTag.E6 K σ) : ModGL TwistTag.E6.tag K) =
      rankOneFix σ orbLeaf orbLeaf_card A := by
  rw [coe_frameHom, frameRaw, MonoidHom.comp_apply, frameConj_zero]
  simp

theorem e6_center_leaf_adj :
    (e6Index 1 : Fin Tag.E6.rank) ≠ e6Index 3 ∧ Tag.E6.cartan (e6Index 1) (e6Index 3) = -1 ∧
      Tag.E6.cartan (e6Index 3) (e6Index 1) = -1 ∧
      (∃ l, ¬ (3 : ℤ) ∣ Tag.E6.cartan (e6Index 1) l + 2 * Tag.E6.cartan (e6Index 3) l) ∧
      (∃ l, ¬ (3 : ℤ) ∣ Tag.E6.cartan (e6Index 3) l + 2 * Tag.E6.cartan (e6Index 1) l) := by
  decide

theorem exists_sl3_center_leaf (σ : K →+* K) :
    (∃ ψ : SL(3, RingHom.eqLocusField σ (RingHom.id K)) →* graphFixedRootGroup TwistTag.E6 K σ,
      ψ.comp (blk (RingHom.eqLocusField σ (RingHom.id K)) 0) = centerHom σ ∧
        ψ.comp (blk (RingHom.eqLocusField σ (RingHom.id K)) 1) = frameHom σ 0) ∧
    (∃ ψ : SL(3, RingHom.eqLocusField σ (RingHom.id K)) →* graphFixedRootGroup TwistTag.E6 K σ,
      ψ.comp (blk (RingHom.eqLocusField σ (RingHom.id K)) 0) = frameHom σ 0 ∧
        ψ.comp (blk (RingHom.eqLocusField σ (RingHom.id K)) 1) = centerHom σ) := by
  obtain ⟨hne, hc13, hc31, hk1, hk2⟩ := e6_center_leaf_adj
  have hc : ∀ A, rankOneFix σ orbCenter orbCenter_card A ∈ graphFixedRootGroup TwistTag.E6 K σ :=
    rankOneFix_mem_graphFixed σ orbCenter orbCenter_card
  have hl : ∀ A, rankOneFix σ orbLeaf orbLeaf_card A ∈ graphFixedRootGroup TwistTag.E6 K σ :=
    rankOneFix_mem_graphFixed σ orbLeaf orbLeaf_card
  have key : ∀ (ψ : SL(3, RingHom.eqLocusField σ (RingHom.id K)) →* ModGL TwistTag.E6.tag K)
      (hψ : ∀ g, ψ g ∈ graphFixedRootGroup TwistTag.E6 K σ)
      (ρ : SL(2, RingHom.eqLocusField σ (RingHom.id K)) →* ModGL TwistTag.E6.tag K)
      (ρ' : SL(2, RingHom.eqLocusField σ (RingHom.id K)) →* graphFixedRootGroup TwistTag.E6 K σ)
      (s : Fin 2), ψ.comp (blk (RingHom.eqLocusField σ (RingHom.id K)) s) = ρ →
      (∀ A, ((ρ' A : graphFixedRootGroup TwistTag.E6 K σ) : ModGL TwistTag.E6.tag K) = ρ A) →
      (ψ.codRestrict _ hψ).comp (blk (RingHom.eqLocusField σ (RingHom.id K)) s) = ρ' :=
    fun ψ hψ ρ ρ' s h1 h2 => MonoidHom.ext fun A =>
      Subtype.ext ((congrArg (fun f => f A) h1).trans (h2 A).symm)
  refine ⟨?_, ?_⟩
  · obtain ⟨ψ, hψ, h0, h1⟩ := exists_sl3_of_adj σ hne hc13 hc31 hk1
      (rankOneFix σ orbCenter orbCenter_card) (rankOneFix σ orbLeaf orbLeaf_card)
      (rankOneFix_center_tv σ) (rankOneFix_leaf_tv σ) hc hl
    exact ⟨ψ.codRestrict _ hψ, key ψ hψ _ _ 0 h0 fun A => rfl,
      key ψ hψ _ _ 1 h1 fun A => (coe_frameHom_zero σ A)⟩
  · obtain ⟨ψ, hψ, h0, h1⟩ := exists_sl3_of_adj σ hne.symm hc31 hc13 hk2
      (rankOneFix σ orbLeaf orbLeaf_card) (rankOneFix σ orbCenter orbCenter_card)
      (rankOneFix_leaf_tv σ) (rankOneFix_center_tv σ) hl hc
    exact ⟨ψ.codRestrict _ hψ, key ψ hψ _ _ 0 h0 fun A => (coe_frameHom_zero σ A),
      key ψ hψ _ _ 1 h1 fun A => rfl⟩

abbrev cNode : Fin TwistTag.E6.tag.rank := ⟨1, by decide⟩

theorem center_commute_check :
    ∀ i : Fin TwistTag.E6.tag.rank,
      (i = ⟨0, by decide⟩ ∨ i = ⟨2, by decide⟩ ∨ i = ⟨4, by decide⟩ ∨ i = ⟨5, by decide⟩) →
      RootOps.isRootB TwistTag.E6.tag (Pi.single i 1) = true ∧
      iform (Pi.single i 1 : Fin TwistTag.E6.tag.rank → ℤ) (Pi.single cNode 1) = 0 ∧
      RootOps.isRootB TwistTag.E6.tag (Pi.single i 1 + Pi.single cNode 1) = false ∧
