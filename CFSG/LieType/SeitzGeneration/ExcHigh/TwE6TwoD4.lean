@[expose] def RootTransport (g : ModGL TwistTag.E6.tag K) (w : WeylGroup TwistTag.E6.tag) : Prop :=
  ∀ β : Fin TwistTag.E6.tag.rank → ℤ, IsRoot TwistTag.E6.tag β →
    (rootSubgroup TwistTag.E6.tag K β).map (MulAut.conj g).toMonoidHom =
      rootSubgroup TwistTag.E6.tag K (w • β)

