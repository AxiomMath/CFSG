theorem rootTransport_orbitN (σ : K →+* K) (a : Fin TwistTag.E6.foldedTag.rank) :
    RootTransport (orbitN TwistTag.E6 K σ a 1 : ModGL TwistTag.E6.tag K)
      (TwistTag.E6.orbitReflection a) := by
  intro β hβ
  obtain ⟨-, -, -, -, -, hN, -⟩ := exceptional_fixed_rank_one_central_image TwistTag.E6 K σ a
  rw [hN]
  exact (canonical_weyl_root_transport TwistTag.E6.tag K).2.1 _ β hβ

@[expose] def signedN (σ : K →+* K) (x : Fin TwistTag.E6.foldedTag.rank × Bool) :
    ModGL TwistTag.E6.tag K :=
  if x.2 then (orbitN TwistTag.E6 K σ x.1 1 : ModGL TwistTag.E6.tag K)
  else (orbitN TwistTag.E6 K σ x.1 1 : ModGL TwistTag.E6.tag K)⁻¹

@[expose] def signedProd (σ : K →+* K) (ω : List (Fin TwistTag.E6.foldedTag.rank × Bool)) :
    ModGL TwistTag.E6.tag K :=
  (ω.map (signedN σ)).reverse.prod

@[expose] def signedW (ω : List (Fin TwistTag.E6.foldedTag.rank × Bool)) :
    WeylGroup TwistTag.E6.tag :=
  (ω.map fun x => TwistTag.E6.orbitReflection x.1).reverse.prod

omit
  [Finite K] in
theorem rootTransport_signedN (σ : K →+* K) (x : Fin TwistTag.E6.foldedTag.rank × Bool) :
    RootTransport (signedN σ x) (TwistTag.E6.orbitReflection x.1) := by
  unfold signedN
  split_ifs
  · exact rootTransport_orbitN σ x.1
  · have h := rootTransport_inv (rootTransport_orbitN σ x.1)
    rwa [TwistTag.orbitReflection_inv] at h

