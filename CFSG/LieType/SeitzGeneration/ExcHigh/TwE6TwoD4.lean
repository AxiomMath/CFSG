    (ha : (TwistTag.E6.orbit a).card = 1) (c : RingHom.eqLocusField σ (RingHom.id K)) :
    fixIncl σ a ha (uSL c) = uSL (Subfield.inclusion (fix_le_orbitField σ a ha) c) := by
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

