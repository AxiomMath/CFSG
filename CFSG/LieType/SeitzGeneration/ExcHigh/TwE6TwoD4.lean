  · exact centerHom_injective σ
  · exact frameHom_injective σ 1
  · exact frameHom_injective σ 2

theorem d4_psi (σ : K →+* K) (i j : Fin 4) (h : edgeD 4 i j) :
    ∃ ψ : SL(3, RingHom.eqLocusField σ (RingHom.id K)) →* graphFixedRootGroup TwistTag.E6 K σ,
      ψ.comp (blk (RingHom.eqLocusField σ (RingHom.id K)) 0) = d4Rho σ i ∧
        ψ.comp (blk (RingHom.eqLocusField σ (RingHom.id K)) 1) = d4Rho σ j := by
  obtain ⟨⟨ψ₁, h₁0, h₁1⟩, ⟨ψ₂, h₂0, h₂1⟩⟩ := exists_sl3_center_leaf σ
  have hed : (i = 0 ∧ j = 1) ∨ (i = 1 ∧ j = 2) ∨ (i = 1 ∧ j = 3) := by
    revert h
    fin_cases i <;> fin_cases j <;> simp [edgeD]
  rcases hed with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact ⟨ψ₂, h₂0, h₂1⟩
  · obtain ⟨hl, hc⟩ := conj_frameConj_leaf_center σ 1 (Or.inl rfl)
    refine ⟨((MulAut.conj (⟨frameConj σ 1, frameConj_mem σ 1⟩ :
        graphFixedRootGroup TwistTag.E6 K σ)).toMonoidHom).comp ψ₁, ?_, ?_⟩
    · rw [MonoidHom.comp_assoc, h₁0, hc]
      rfl
    · rw [MonoidHom.comp_assoc, h₁1, hl]
      rfl
  · obtain ⟨hl, hc⟩ := conj_frameConj_leaf_center σ 2 (Or.inr rfl)
    refine ⟨((MulAut.conj (⟨frameConj σ 2, frameConj_mem σ 2⟩ :
        graphFixedRootGroup TwistTag.E6 K σ)).toMonoidHom).comp ψ₁, ?_, ?_⟩
    · rw [MonoidHom.comp_assoc, h₁0, hc]
      rfl
    · rw [MonoidHom.comp_assoc, h₁1, hl]
      rfl

