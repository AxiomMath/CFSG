    RootTransport ((dWordG σ : graphFixedRootGroup TwistTag.E6 K σ) : ModGL TwistTag.E6.tag K)
      (signedW wordD) := by
  rw [coe_dWordG]
  exact rootTransport_signedProd σ wordD

omit
  [Finite K] in
theorem rankOneFix_mem_orbitRankOneGroup (σ : K →+* K) (a : Fin TwistTag.E6.foldedTag.rank)
    (ha : (TwistTag.E6.orbit a).card = 1)
    (A : SL(2, RingHom.eqLocusField σ (RingHom.id K))) :
    rankOneFix σ a ha A ∈ orbitRankOneGroup TwistTag.E6 K σ a := by
  have := orbitRankOneHom_range (σ := σ) a
  rw [orbitRankOneGroup, ← this]
  exact ⟨_, rfl⟩

omit
  [Finite K] in
theorem orbitRankOneGroup_le_range_rankOneFix (σ : K →+* K)
    (a : Fin TwistTag.E6.foldedTag.rank) (ha : (TwistTag.E6.orbit a).card = 1) :
    orbitRankOneGroup TwistTag.E6 K σ a ≤ (rankOneFix σ a ha).range := by
  have hfix : ∀ c : orbitField TwistTag.E6 K σ a,
      (c : K) ∈ RingHom.eqLocusField σ (RingHom.id K) := fun c => by
    have h := mem_orbitField.1 c.2
    rw [ha, pow_one] at h
    exact h
  rw [orbitRankOneGroup, Subgroup.closure_le]
  rintro _ (⟨c, rfl⟩ | ⟨c, rfl⟩)
  · refine ⟨uSL ⟨(c : K), hfix c⟩, ?_⟩
    rw [rankOneFix, MonoidHom.comp_apply, fixIncl_uSL, orbitRankOneHom_uSL]
    rfl
  · refine ⟨vSL ⟨(c : K), hfix c⟩, ?_⟩
    rw [rankOneFix, MonoidHom.comp_apply, fixIncl_vSL, orbitRankOneHom_vSL]
    rfl

omit
  [Finite K] in
theorem frameHom_three_le_d4Group (σ : K →+* K) : (frameHom σ 3).range ≤ d4Group σ := by
  rintro _ ⟨A, rfl⟩
  have hroot : IsRoot TwistTag.E6.tag
      (Pi.single (⟨3, by decide⟩ : Fin TwistTag.E6.tag.rank) 1 : Fin TwistTag.E6.tag.rank → ℤ) :=
    isRoot_single _ _
  have hQ := orbitRankOneGroup_eq_Q σ orbLeaf orbLeaf_orbit
  have hx := rankOneFix_mem_orbitRankOneGroup σ orbLeaf orbLeaf_card A
  rw [hQ] at hx
  have hΓ3 : frameConj σ 3 ∈ twistedFixedGroup TwistTag.E6 K σ :=
    graphFixedRootGroup_le _ K σ (frameConj_mem σ 3)
  have h4 := map_conj_graphFixedRootPair σ hΓ3 (rootTransport_frameConj σ 3) hroot
  rw [signedW_true_smul, frameSeq_fold] at h4
  have hy : frameConj σ 3 * rankOneFix σ orbLeaf orbLeaf_card A * (frameConj σ 3)⁻¹ ∈
      graphFixedRootPair TwistTag.E6 K σ {frameRoot 3} := by
    rw [← h4]
    exact ⟨_, hx, rfl⟩
  have hΓd : ((dWordG σ : graphFixedRootGroup TwistTag.E6 K σ) : ModGL TwistTag.E6.tag K) ∈
      twistedFixedGroup TwistTag.E6 K σ := graphFixedRootGroup_le _ K σ (dWordG σ).2
  have hd := map_conj_graphFixedRootPair σ hΓd (rootTransport_dWordG σ) hroot
  rw [signedW_smul, wordD_fold] at hd
  rw [← hd] at hy
  obtain ⟨x', hx', hx'eq⟩ := hy
  rw [← hQ] at hx'
  obtain ⟨B, hB⟩ := orbitRankOneGroup_le_range_rankOneFix σ orbLeaf orbLeaf_card hx'
  have hmem : frameHom σ 0 B ∈ d4Group σ := Subgroup.mem_iSup_of_mem 0 ⟨B, rfl⟩
  have heq : frameHom σ 3 A = dWordG σ * frameHom σ 0 B * (dWordG σ)⁻¹ := by
    apply Subtype.ext
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, coe_frameHom_zero, hB]
    exact hx'eq.symm
  rw [heq]
  exact mul_mem (mul_mem (dWordG_mem σ) hmem) (inv_mem (dWordG_mem σ))

end FrameInD

