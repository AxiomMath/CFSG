    rankOneFix σ orbCenter orbCenter_card (tv 0 1 c) = xUnit Tag.E6 K (e6Index 1) (c : K) ∧
      rankOneFix σ orbCenter orbCenter_card (tv 1 0 c) = yUnit Tag.E6 K (e6Index 1) (c : K) := by
  refine ⟨?_, ?_⟩
  · rw [rankOneFix_tv01]
