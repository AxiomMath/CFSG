theorem d4_commute (σ : K →+* K) (i j : Fin 4) (hij : i ≠ j) (h1 : ¬ edgeD 4 i j)
    (h2 : ¬ edgeD 4 j i) (u : graphFixedRootGroup TwistTag.E6 K σ)
    (hu : u ∈ (d4Rho σ i).range) (v : graphFixedRootGroup TwistTag.E6 K σ)
    (hv : v ∈ (d4Rho σ j).range) : u * v = v * u := by
  obtain ⟨A, rfl⟩ := hu
  obtain ⟨B, rfl⟩ := hv
  have hcases : (i = 0 ∧ j = 2) ∨ (i = 0 ∧ j = 3) ∨ (i = 2 ∧ j = 0) ∨ (i = 2 ∧ j = 3) ∨
      (i = 3 ∧ j = 0) ∨ (i = 3 ∧ j = 2) := by
    revert hij h1 h2
    fin_cases i <;> fin_cases j <;> simp [edgeD]
  rcases hcases with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact frameHom_commute σ (i := 0) (j := 1) (by decide) A B
  · exact frameHom_commute σ (i := 0) (j := 2) (by decide) A B
  · exact frameHom_commute σ (i := 1) (j := 0) (by decide) A B
  · exact frameHom_commute σ (i := 1) (j := 2) (by decide) A B
  · exact frameHom_commute σ (i := 2) (j := 0) (by decide) A B
  · exact frameHom_commute σ (i := 2) (j := 1) (by decide) A B

theorem exists_psi_d4 {ℓ f : ℕ} (hℓ : ℓ.Prime) (hf : 1 ≤ f) (σ : K →+* K)
    (hk : Nat.card (RingHom.eqLocusField σ (RingHom.id K)) = ℓ ^ f) :
    ∃ Ψ : spinGroup (Spin.quadPlus 4 (RingHom.eqLocusField σ (RingHom.id K))) →*
        graphFixedRootGroup TwistTag.E6 K σ,
      Ψ.ker ≤ Subgroup.center _ ∧ Ψ.range = ⨆ i, (d4Rho σ i).range := by
  have hadm : StatedLieAdmissible .POmegaPlus 4 ℓ f := ⟨hℓ, hf, by norm_num⟩
  obtain ⟨Ψ, h1, h2, -, -⟩ :=
    CFSG.ComponentClassification.CatLeafProof.spinPlus_frame_subgroup hadm (by norm_num) hk
      (U := fun i => (d4Rho σ i).range)
      (fun i j hij h1 h2 u hu v hv => d4_commute σ i j hij h1 h2 u hu v hv)
      (ρ := d4Rho σ) (fun k => ⟨d4Rho_injective σ k, rfl⟩) (fun i j h => d4_psi σ i j h)
  exact ⟨Ψ, h1, h2⟩

