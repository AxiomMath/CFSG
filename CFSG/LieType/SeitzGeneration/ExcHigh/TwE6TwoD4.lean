section Kernel

theorem not_dvd_card_ker_noncommCoprod_tw {G A B : Type*} [Group G] [Group A] [Group B] [Finite A]
    [Finite B] {p : ℕ} (hp : p.Prime) (f : A →* G) (g : B →* G)
    (hc : ∀ a b, Commute (f a) (g b)) (hfk : ¬ p ∣ Nat.card f.ker)
    (hgk : g.ker ≤ Subgroup.center B) (hcen : ¬ p ∣ Nat.card (Subgroup.center B)) :
    ¬ p ∣ Nat.card (MonoidHom.noncommCoprod f g hc).ker := by
  intro hdvd
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' p hdvd
  obtain ⟨⟨a, b⟩, hzk⟩ := z
  have hψ : f a * g b = 1 := hzk
  have hpow : (⟨(a, b), hzk⟩ : ↥(MonoidHom.noncommCoprod f g hc).ker) ^ p = 1 := by
    have := pow_orderOf_eq_one (⟨(a, b), hzk⟩ : ↥(MonoidHom.noncommCoprod f g hc).ker)
    rwa [hz] at this
  have hab : (a, b) ^ p = 1 := congrArg Subtype.val hpow
  have ha : a ^ p = 1 := congrArg Prod.fst hab
  have hb : b ^ p = 1 := congrArg Prod.snd hab
  have hcop : Nat.Coprime p (Nat.card (Subgroup.center B)) :=
    (Nat.Prime.coprime_iff_not_dvd hp).2 hcen
  have hgb : g b = (f a)⁻¹ := eq_inv_of_mul_eq_one_right hψ
  have hcomm : ∀ y : B, ⁅b, y⁆ ∈ g.ker := fun y => by
    have h1 : Commute (g b) (g y) := by
      rw [hgb]
      exact (hc a y).inv_left
    rw [MonoidHom.mem_ker, map_commutatorElement, commutatorElement_eq_one_iff_commute]
    exact h1
  have hcentral : ∀ y : B, ⁅b, y⁆ = 1 := fun y => by
    have hcc : ⁅b, y⁆ ∈ Subgroup.center B := hgk (hcomm y)
    have hbc : Commute b ⁅b, y⁆ := Subgroup.mem_center_iff.1 hcc b
    have h2 : ⁅b, y⁆ ^ p = 1 := by
      rw [Commute.commutatorElement_pow_left hbc p, hb, commutatorElement_one_left]
    have h3 : orderOf (⟨⁅b, y⁆, hcc⟩ : Subgroup.center B) ∣ p := by
      apply orderOf_dvd_of_pow_eq_one
      exact Subtype.ext h2
    have h4 := orderOf_dvd_natCard (⟨⁅b, y⁆, hcc⟩ : Subgroup.center B)
    have h5 : orderOf (⟨⁅b, y⁆, hcc⟩ : Subgroup.center B) = 1 :=
      Nat.eq_one_of_dvd_coprimes hcop h3 h4
    have h6 : (⟨⁅b, y⁆, hcc⟩ : Subgroup.center B) = 1 := orderOf_eq_one_iff.1 h5
    exact congrArg Subtype.val h6
  have hbmem : b ∈ Subgroup.center B := Subgroup.mem_center_iff.2 fun y =>
    ((commutatorElement_eq_one_iff_mul_comm.1 (hcentral y)).symm)
  have hb1 : b = 1 := by
    have h3 : orderOf (⟨b, hbmem⟩ : Subgroup.center B) ∣ p :=
      orderOf_dvd_of_pow_eq_one (Subtype.ext hb)
    have h4 := orderOf_dvd_natCard (⟨b, hbmem⟩ : Subgroup.center B)
    have h5 := Nat.eq_one_of_dvd_coprimes hcop h3 h4
    exact congrArg Subtype.val (orderOf_eq_one_iff.1 h5)
  have hfa : f a = 1 := by
    rw [hb1, map_one, mul_one] at hψ
    exact hψ
  have hamem : a ∈ f.ker := hfa
  have hcopA : Nat.Coprime p (Nat.card f.ker) := (Nat.Prime.coprime_iff_not_dvd hp).2 hfk
  have ha1 : a = 1 := by
    have h3 : orderOf (⟨a, hamem⟩ : f.ker) ∣ p := orderOf_dvd_of_pow_eq_one (Subtype.ext ha)
    have h4 := orderOf_dvd_natCard (⟨a, hamem⟩ : f.ker)
    have h5 := Nat.eq_one_of_dvd_coprimes hcopA h3 h4
    exact congrArg Subtype.val (orderOf_eq_one_iff.1 h5)
  have hz1 : (⟨(a, b), hzk⟩ : ↥(MonoidHom.noncommCoprod f g hc).ker) = 1 :=
    Subtype.ext (Prod.ext ha1 hb1)
  rw [hz1, orderOf_one] at hz
  exact hp.one_lt.ne hz

end Kernel

section D4Cover

open CFSG.Assembly.LowTwoRank CFSG.LieType.Universal CFSG.LieType.Universal.Spin
  CFSG.ClassicalInvolution.ModelFacts.OrthAut CFSG.HardMathSupport.Lang.AnisoF4

theorem finite_spinPlus_four (k : Type) [Field k] [Finite k] :
    Finite (spinGroup (Spin.quadPlus 4 k)) := by
  classical
  haveI : NeZero 4 := ⟨by norm_num⟩
  have : Nonempty (Fin 4 ⊕ Fin 4) := ⟨Sum.inl ⟨0, by omega⟩⟩
  exact CFSG.ClassicalInvolution.ModelFacts.finite_spinGroup_of_ker _ coe_ker_spinMatrix_quadPlus

theorem not_dvd_card_center_spinPlus_four {k : Type} [Field k] [Finite k] {p : ℕ} (hp : p.Prime)
    (hp5 : 5 ≤ p) (hpq1 : ¬ p ∣ Nat.card k - 1) :
    ¬ p ∣ Nat.card (Subgroup.center (spinGroup (Spin.quadPlus 4 k))) := by
  classical
  have : Fact p.Prime := ⟨hp⟩
  have hp2 : p ≠ 2 := by omega
  have hn3 : 3 ≤ 4 := by norm_num
  haveI := finite_spinPlus_four k
  obtain ⟨-, hcomap, hZ⟩ := spinToStatedProj_quadPlus (n := 4) (K := k) hn3
  exact not_dvd_card_center_spin_of_not_dvd_pred (Spin.quadPlus 4 k)
    (range_spinMatrix_quadPlus hn3) hZ hcomap
    (fun x hx => spin_mul_self_eq_one ((mem_ker_spinMatrix_quadPlus_iff x).mp hx)) hp2 hpq1


theorem twE6D4Cover : TwE6D4Cover := by
  intro K _ _ σ ℓ f hℓ hf hK hσ p hpF hp7 hpq
  classical
  have hσ' : ∀ c, σ.toRingHom c = c ^ (ℓ ^ f) := hσ
  have hkcard : Nat.card (RingHom.eqLocusField σ.toRingHom (RingHom.id K)) = ℓ ^ f :=
    CFSG.RankThree.Chevalley.card_eqLocusField_of_pow hℓ hf hK hσ'
  obtain ⟨Ψ, hΨker, hΨrange⟩ := exists_psi_d4 hℓ hf σ.toRingHom hkcard
  have hq2 : 2 ≤ ℓ ^ f := Nat.one_lt_pow (by omega) hℓ.one_lt
  have hpk : ¬ p ∣ Nat.card (RingHom.eqLocusField σ.toRingHom (RingHom.id K)) := by
    rw [hkcard]
    intro h
    have h1 : p ∣ ℓ ^ f + 1 - ℓ ^ f := Nat.dvd_sub hpq h
    rw [show ℓ ^ f + 1 - ℓ ^ f = 1 by omega] at h1
    exact hpF.out.one_lt.ne' (Nat.dvd_one.1 h1)
  have hpq1 : ¬ p ∣ Nat.card (RingHom.eqLocusField σ.toRingHom (RingHom.id K)) - 1 := by
    rw [hkcard]
    intro h
    have h1 : p ∣ ℓ ^ f + 1 - (ℓ ^ f - 1) := Nat.dvd_sub hpq h
    rw [show ℓ ^ f + 1 - (ℓ ^ f - 1) = 2 by omega] at h1
    have := Nat.le_of_dvd (by norm_num) h1
    omega
  haveI := finite_spinPlus_four (RingHom.eqLocusField σ.toRingHom (RingHom.id K))
  have hcen := not_dvd_card_center_spinPlus_four hpF.out (by omega) hpq1
  have hcomm : ∀ (t : ↥(normOne σ.toRingHom) × ↥(normOne σ.toRingHom))
      (x : spinGroup (Spin.quadPlus 4 (RingHom.eqLocusField σ.toRingHom (RingHom.id K)))),
      Commute (torusG σ.toRingHom t) (Ψ x) := fun t x => by
    have hmem : Ψ x ∈ d4Group σ.toRingHom := by
      rw [d4Group, ← hΨrange]
      exact ⟨x, rfl⟩
    exact torusG_commute_d4Group σ.toRingHom t (Ψ x) hmem
  let ψ := MonoidHom.noncommCoprod (torusG σ.toRingHom) Ψ hcomm
  have hdr : d4Group σ.toRingHom ≤ ψ.range := by
    rw [d4Group, ← hΨrange]
    rintro _ ⟨x, rfl⟩
    refine ⟨(1, x), ?_⟩
    change torusG σ.toRingHom 1 * Ψ x = Ψ x
    rw [map_one, one_mul]
  have htr : (torusG σ.toRingHom).range ≤ ψ.range := by
    rintro _ ⟨t, rfl⟩
    refine ⟨(t, 1), ?_⟩
    change torusG σ.toRingHom t * Ψ 1 = torusG σ.toRingHom t
    rw [map_one, mul_one]
  refine ⟨_, inferInstance, inferInstance, ψ, ?_, ?_, ?_⟩
  · exact not_dvd_card_ker_noncommCoprod_tw hpF.out _ _ hcomm
      (not_dvd_card_ker_torusG σ.toRingHom hpF.out (by omega)) hΨker hcen
  · intro F hF hc
    exact closure_centralizers_prod_of_abelian_plane (fun F hF hc =>
      closure_centralizers_spinPlus_plane hpF.out (by omega) hpk hpq1 (by norm_num) F hF hc) F hF hc
  · refine sup_le (sup_le (iSup_le fun i => ?_) htr) ?_
    · fin_cases i
      · exact (le_iSup (fun i => (d4Rho σ.toRingHom i).range) 0).trans hdr
      · exact (le_iSup (fun i => (d4Rho σ.toRingHom i).range) 2).trans hdr
      · exact (le_iSup (fun i => (d4Rho σ.toRingHom i).range) 3).trans hdr
      · exact (frameHom_three_le_d4Group σ.toRingHom).trans hdr
    · rintro y hy
      have hy' : (y : ModGL TwistTag.E6.tag K) ∈ orbitRankOneGroup TwistTag.E6 K σ.toRingHom
          ⟨3, by decide⟩ := hy
      obtain ⟨A, hA⟩ := orbitRankOneGroup_le_range_rankOneFix σ.toRingHom orbCenter
        orbCenter_card hy'
      have hyeq : y = centerHom σ.toRingHom A := Subtype.ext hA.symm
      rw [hyeq]
      exact hdr (Subgroup.mem_iSup_of_mem 1 ⟨A, rfl⟩)

end D4Cover

