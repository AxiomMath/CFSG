  [Finite K] in
theorem rootTransport_signedProd (σ : K →+* K)
    (ω : List (Fin TwistTag.E6.foldedTag.rank × Bool)) :
    RootTransport (signedProd σ ω) (signedW ω) := by
  induction ω with
  | nil => simpa [signedProd, signedW] using rootTransport_one
  | cons x ω ih =>
    simp only [signedProd, signedW, List.map_cons, List.reverse_cons, List.prod_append,
      List.prod_singleton]
    exact rootTransport_mul ih (rootTransport_signedN σ x)

theorem signedW_smul (ω : List (Fin TwistTag.E6.foldedTag.rank × Bool))
    (v : Fin TwistTag.E6.tag.rank → ℤ) :
    signedW ω • v = ω.foldl (fun v x => TwistTag.E6.orbitReflection x.1 • v) v := by
  induction ω generalizing v with
  | nil => simp [signedW]
  | cons x ω ih =>
    simp only [signedW, List.map_cons, List.reverse_cons, List.prod_append, List.prod_singleton,
      List.foldl_cons, mul_smul]
    exact ih _

