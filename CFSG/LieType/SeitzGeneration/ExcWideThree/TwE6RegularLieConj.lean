@[expose] def e6SepVec : Fin TwistTag.E6.tag.rank → ℤ := ![-3, -3, -3, 2, 3, 3]

theorem e6SepVec_spec : ∀ α ∈ rootFinset TwistTag.E6.tag,
    (∑ i, α i * e6SepVec i = 0 ↔ α = CFSG.LieType.Chevalley.e6HighestRoot ∨
      α = -CFSG.LieType.Chevalley.e6HighestRoot) ∧ |∑ i, α i * e6SepVec i| ≤ 8 := by
  decide +kernel

@[expose] def e6LeviNodes : Set (Fin TwistTag.E6.tag.rank) := {j | j ≠ e6Idx 1}

theorem e6_coord_abs_le : ∀ α ∈ rootFinset TwistTag.E6.tag, |α (e6Idx 1)| ≤ 2 := by
  decide +kernel

theorem mem_parabolicRoots_e6LeviNodes {α : Fin TwistTag.E6.tag.rank → ℤ} :
    α ∈ parabolicRoots TwistTag.E6.tag e6LeviNodes ↔ IsRoot TwistTag.E6.tag α ∧ α (e6Idx 1) = 0 := by
  unfold parabolicRoots e6LeviNodes
  refine and_congr_right fun _ => ⟨fun h => h _ (by simp), fun h i hi => ?_⟩
  have : i = e6Idx 1 := by simpa using hi
  rw [this]
  exact h

@[expose] def zpowFamily {L : Type} [Field L] (ζ : Lˣ) (c : Fin TwistTag.E6.tag.rank → ℤ) :
    Unit → Fin TwistTag.E6.tag.rank → Lˣ := fun _ i => ζ ^ c i

