section Abstract

theorem lang_two_step {Γ : Type*} [Group Γ] (F : Γ →* Γ) {A₀ A B : Subgroup Γ} (hA₀A : A₀ ≤ A)
    (hFB : ∀ b ∈ B, F b ∈ B) (hBA₀ : ∀ b ∈ B, ∀ a ∈ A₀, b * a * b⁻¹ ∈ A₀)
    (hLB : ∀ j ∈ B, ∃ z ∈ B, z⁻¹ * j * F z = 1)
    (hLA : ∀ s ∈ A, ∃ z ∈ A, z⁻¹ * s * F z = 1) {j s : Γ} (hj : j ∈ B) (hs : s ∈ A₀) :
    ∃ z₁ ∈ B, ∃ z₂ ∈ A, (z₁ * z₂)⁻¹ * (j * s) * F (z₁ * z₂) = 1 := by
  obtain ⟨z₁, hz₁, h₁⟩ := hLB j hj
  have hs₁ : (F z₁)⁻¹ * s * F z₁ ∈ A₀ := by
    have := hBA₀ (F z₁)⁻¹ (B.inv_mem (hFB z₁ hz₁)) s hs
    simpa using this
  obtain ⟨z₂, hz₂, h₂⟩ := hLA _ (hA₀A hs₁)
  refine ⟨z₁, hz₁, z₂, hz₂, ?_⟩
  calc (z₁ * z₂)⁻¹ * (j * s) * F (z₁ * z₂)
      = z₂⁻¹ * ((z₁⁻¹ * j * F z₁) * ((F z₁)⁻¹ * s * F z₁)) * F z₂ := by
        rw [map_mul]; group
    _ = z₂⁻¹ * ((F z₁)⁻¹ * s * F z₁) * F z₂ := by rw [h₁, one_mul]
    _ = 1 := h₂

theorem map_mul_eq_self_of_cocycle {Γ : Type*} [Group Γ] (F : Γ →* Γ) {h₀ z : Γ}
    (hz : z⁻¹ * (h₀⁻¹ * F h₀) * F z = 1) : F (h₀ * z) = h₀ * z := by
  have h1 : (h₀⁻¹ * F h₀) * F z = z := by
    calc (h₀⁻¹ * F h₀) * F z = z * (z⁻¹ * (h₀⁻¹ * F h₀) * F z) := by group
      _ = z := by rw [hz, mul_one]
  calc F (h₀ * z) = F h₀ * F z := map_mul F _ _
    _ = h₀ * ((h₀⁻¹ * F h₀) * F z) := by group
    _ = h₀ * z := by rw [h1]

theorem exists_mul_of_mem_sup {Γ : Type*} [Group Γ] {A₀ B : Subgroup Γ}
    (hBA₀ : ∀ b ∈ B, ∀ a ∈ A₀, b * a * b⁻¹ ∈ A₀) {x : Γ} (hx : x ∈ B ⊔ A₀) :
    ∃ j ∈ B, ∃ s ∈ A₀, x = j * s := by
  let N : Subgroup Γ :=
    { carrier := {x | ∃ j ∈ B, ∃ s ∈ A₀, x = j * s}
      mul_mem' := by
        rintro _ _ ⟨j, hj, s, hs, rfl⟩ ⟨j', hj', s', hs', rfl⟩
        refine ⟨j * j', B.mul_mem hj hj', (j'⁻¹ * s * j') * s',
          A₀.mul_mem (by simpa using hBA₀ j'⁻¹ (B.inv_mem hj') s hs) hs', by group⟩
      one_mem' := ⟨1, B.one_mem, 1, A₀.one_mem, (one_mul 1).symm⟩
      inv_mem' := by
        rintro _ ⟨j, hj, s, hs, rfl⟩
        refine ⟨j⁻¹, B.inv_mem hj, j * s⁻¹ * j⁻¹, hBA₀ j hj s⁻¹ (A₀.inv_mem hs), by group⟩ }
  have hle : B ⊔ A₀ ≤ N := sup_le
    (fun b hb => ⟨b, hb, 1, A₀.one_mem, (mul_one b).symm⟩)
    (fun a ha => ⟨1, B.one_mem, a, ha, (one_mul a).symm⟩)
  exact hle hx

end Abstract

