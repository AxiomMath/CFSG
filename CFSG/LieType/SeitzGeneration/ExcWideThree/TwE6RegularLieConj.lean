theorem rootChar_zpowFamily {L : Type} [Field L] (ζ : Lˣ) (c α : Fin TwistTag.E6.tag.rank → ℤ) :
    rootChar (zpowFamily ζ c ()) α = ζ ^ (∑ i, α i * c i) := by
  rw [rootChar, ← prod_zpow_eq_zpow_sum_of_group]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [zpowFamily, ← zpow_mul, mul_comm]

theorem twistHom_mem_familyGroup {L : Type} [Field L] [IsAlgClosed L] {ι : Type} (p f : ℕ)
    [Fact p.Prime] [CharP L p] (a : ι → Fin TwistTag.E6.tag.rank → Lˣ)
    (himg : (fun α => permLattice TwistTag.E6.perm α) '' familyKernel (τ := TwistTag.E6.tag) a =
      familyKernel a)
    {g : ModGL TwistTag.E6.tag L} (hg : g ∈ familyGroup (K := L) a) :
    twistHom TwistTag.E6 L (iterateFrobenius L p f) g ∈ familyGroup (K := L) a := by
  have hFrs : Function.Surjective (iterateFrobenius L p f) := fun y => by
    obtain ⟨c, hc⟩ := IsAlgClosed.exists_pow_nat_eq y (pow_pos (Fact.out : p.Prime).pos f)
    exact ⟨c, by rw [iterateFrobenius_def, hc]⟩
  have := twFrob_mem_familyGroup TwistTag.E6 hFrs 1 a (by simpa using himg) hg
  rwa [twFrob_apply, canonicalRep_one, inv_one, one_mul, mul_one] at this

theorem exists_lang_cocycle_familyGroup {L : Type} [Field L] [IsAlgClosed L] {ι : Type} (p f : ℕ)
    [Fact p.Prime] [CharP L p] (hf : 1 ≤ f) (a : ι → Fin TwistTag.E6.tag.rank → Lˣ)
    (himg : (fun α => permLattice TwistTag.E6.perm α) '' familyKernel (τ := TwistTag.E6.tag) a =
      familyKernel a)
    {j : ModGL TwistTag.E6.tag L} (hj : j ∈ familyGroup (K := L) a) :
    ∃ z ∈ familyGroup (K := L) a,
      z⁻¹ * j * twistHom TwistTag.E6 L (iterateFrobenius L p f) z = 1 := by
  have hFstab : ∀ g ∈ familyGroup (K := L) a,
      twistHom TwistTag.E6 L (iterateFrobenius L p f) g ∈ familyGroup (K := L) a :=
    fun g hg => twistHom_mem_familyGroup p f a himg hg
  have hst : ∀ g ∈ familyGroup (K := L) a, frobTwistGL TwistTag.E6.tag L p f
      (j * diagramMap TwistTag.E6 L) g ∈ familyGroup (K := L) a := by
    intro g hg
    have e : frobTwistGL TwistTag.E6.tag L p f (j * diagramMap TwistTag.E6 L) g =
        j * twistHom TwistTag.E6 L (iterateFrobenius L p f) g * j⁻¹ := by
      rw [frobTwistGL_apply, CFSG.LieType.Chevalley.twistHom_apply]
      group
    rw [e]
    exact mul_mem (mul_mem hj (hFstab g hg)) (inv_mem hj)
  obtain ⟨z, hz, hzc⟩ := lang_familyGroup_of_mapsTo p a f hf (j * diagramMap TwistTag.E6 L) hst
    j⁻¹ (inv_mem hj)
  refine ⟨z, hz, ?_⟩
  have e : (j * diagramMap TwistTag.E6 L) * entrywiseFrobGL TwistTag.E6.tag L p f z *
      (j * diagramMap TwistTag.E6 L)⁻¹ =
      j * twistHom TwistTag.E6 L (iterateFrobenius L p f) z * j⁻¹ := by
    rw [CFSG.LieType.Chevalley.twistHom_apply]
    group
  rw [e] at hzc
  calc z⁻¹ * j * twistHom TwistTag.E6 L (iterateFrobenius L p f) z
      = (z⁻¹ * (j * twistHom TwistTag.E6 L (iterateFrobenius L p f) z * j⁻¹)) * j := by group
    _ = 1 := by rw [hzc]; group

local notation "θ₀" => CFSG.LieType.Chevalley.e6HighestRoot

theorem permLattice_θ₀ : permLattice TwistTag.E6.perm θ₀ = θ₀ := permLattice_e6HighestRoot

theorem smul_cocycleWeyl_highRoot {w v : WeylGroup TwistTag.E6.tag}
    {γ : Fin TwistTag.E6.tag.rank → ℤ} (hw : w • θ₀ = γ)
    (hφ : v • permLattice TwistTag.E6.perm γ = -γ) :
    (w⁻¹ * v * weylTwist TwistTag.E6 w) • θ₀ = -θ₀ := by
  rw [mul_smul, mul_smul]
  have h1 : weylTwist TwistTag.E6 w • θ₀ = permLattice TwistTag.E6.perm γ := by
    have := weylTwist_smul_permLattice TwistTag.E6 w θ₀
    rw [permLattice_θ₀] at this
    rw [this, hw]
  rw [h1, hφ, smul_neg, inv_smul_eq_iff.2 hw.symm]

theorem mem_parabolicWeylGroup_of_smul_θ₀ {u : WeylGroup TwistTag.E6.tag} (hu : u • θ₀ = θ₀) :
    u ∈ parabolicWeylGroup TwistTag.E6.tag e6LeviNodes := by
  have h : u ∈ (parabolicWeylGroup TwistTag.E6.tag e6LeviNodes : Set (WeylGroup TwistTag.E6.tag)) := by
    rw [(parabolic_Weyl_coordinate_stabilizer TwistTag.E6.tag e6LeviNodes).1]
    intro v i hi
    have hi0 : i = e6Idx 1 := by simpa [e6LeviNodes] using hi
    subst hi0
    have h1 : iform θ₀ (u • v) = iform θ₀ v := by
      conv_lhs => rw [← hu]
      exact iform_smul u _ _
    rwa [iform_e6HighestRoot, iform_e6HighestRoot] at h1
  exact h

theorem familyKernel_aJ {L : Type} [Field L] {ζ : Lˣ} (hζ : IsPrimitiveRoot ζ 3) :
    familyKernel (τ := TwistTag.E6.tag) (zpowFamily ζ (Pi.single (e6Idx 1) 1)) =
      parabolicRoots TwistTag.E6.tag e6LeviNodes := by
  have hs : ∀ α : Fin TwistTag.E6.tag.rank → ℤ,
      ∑ i, α i * (Pi.single (e6Idx 1) 1 : Fin TwistTag.E6.tag.rank → ℤ) i = α (e6Idx 1) := by
    intro α
    simp [Pi.single_apply]
  ext α
  rw [mem_parabolicRoots_e6LeviNodes]
  constructor
  · rintro ⟨hα, h⟩
    have h1 := h ()
    rw [rootChar_zpowFamily, hs] at h1
    have hd : (3 : ℤ) ∣ α (e6Idx 1) := by
      have := (hζ.zpow_eq_one_iff_dvd _).1 h1
      exact_mod_cast this
    have hb := e6_coord_abs_le α (mem_rootFinset.2 hα)
    refine ⟨hα, ?_⟩
    obtain ⟨c, hc⟩ := hd
    rw [abs_le] at hb
    omega
  · rintro ⟨hα, h0⟩
    refine ⟨hα, fun _ => ?_⟩
    rw [rootChar_zpowFamily, hs, h0]
    simp

theorem familyKernel_a2 {L : Type} [Field L] {ζ : Lˣ} (hζ : IsPrimitiveRoot ζ 9) :
    familyKernel (τ := TwistTag.E6.tag) (zpowFamily ζ e6SepVec) = {θ₀, -θ₀} := by
  ext α
  rw [Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨hα, h⟩
    have h1 := h ()
    rw [rootChar_zpowFamily] at h1
    have hd : (9 : ℤ) ∣ ∑ i, α i * e6SepVec i := by
      have := (hζ.zpow_eq_one_iff_dvd _).1 h1
      exact_mod_cast this
    obtain ⟨hz, hb⟩ := e6SepVec_spec α (mem_rootFinset.2 hα)
    rw [abs_le] at hb
    obtain ⟨c, hc⟩ := hd
    have : ∑ i, α i * e6SepVec i = 0 := by omega
    exact hz.1 this
  · intro h
    have hα : IsRoot TwistTag.E6.tag α := by
      rcases h with rfl | rfl
      · exact isRoot_e6HighestRoot
      · exact IsRoot.neg isRoot_e6HighestRoot
    refine ⟨hα, fun _ => ?_⟩
    obtain ⟨hz, -⟩ := e6SepVec_spec α (mem_rootFinset.2 hα)
    rw [rootChar_zpowFamily, hz.2 h]
    simp

theorem image_permLattice_pair : (fun α => permLattice TwistTag.E6.perm α) '' ({θ₀, -θ₀} : Set _) =
    {θ₀, -θ₀} := by
  ext α
  simp only [Set.image_insert_eq, Set.image_singleton, Set.mem_insert_iff, Set.mem_singleton_iff]
  have hneg : permLattice TwistTag.E6.perm (-θ₀) = -θ₀ := by
    rw [show permLattice TwistTag.E6.perm (-θ₀) = -permLattice TwistTag.E6.perm θ₀ from rfl,
      permLattice_θ₀]
  rw [permLattice_θ₀, hneg]

theorem image_permLattice_parabolicRoots :
    (fun α => permLattice TwistTag.E6.perm α) '' parabolicRoots TwistTag.E6.tag e6LeviNodes =
      parabolicRoots TwistTag.E6.tag e6LeviNodes := by
  have hperm : TwistTag.E6.perm.symm (e6Idx 1) = e6Idx 1 := by decide
  ext β
  simp only [Set.mem_image, mem_parabolicRoots_e6LeviNodes]
  constructor
  · rintro ⟨α, ⟨hα, h0⟩, rfl⟩
    refine ⟨hα.permLattice TwistTag.E6.cartan_perm, ?_⟩
    simp only [permLattice, Function.comp_apply, hperm]
    exact h0
  · rintro ⟨hβ, h0⟩
    refine ⟨permLattice TwistTag.E6.perm β, ⟨hβ.permLattice TwistTag.E6.cartan_perm, ?_⟩,
      twE6_permLattice_permLattice β⟩
    simp only [permLattice, Function.comp_apply, hperm]
    exact h0

theorem familyGroup_aJ_le_normalizer {L : Type} [Field L] [IsAlgClosed L] {ζ : Lˣ}
    (hζ : IsPrimitiveRoot ζ 3) :
    familyGroup (K := L) (zpowFamily ζ (Pi.single (e6Idx 1) 1)) ≤
      Subgroup.normalizer (rootSpan TwistTag.E6.tag L {θ₀, -θ₀} : Set (ModGL TwistTag.E6.tag L)) := by
  have hroots : ∀ α ∈ ({θ₀, -θ₀} : Set (Fin TwistTag.E6.tag.rank → ℤ)),
      IsRoot TwistTag.E6.tag α := by
    intro α hα
    rcases hα with rfl | rfl
    · exact isRoot_e6HighestRoot
    · exact IsRoot.neg isRoot_e6HighestRoot
  unfold familyGroup
  refine sup_le (CFSG.RankThree.PartOne.KE.torusGroup_le_normalizer_rootSpan hroots) ?_
  rw [familyKernel_aJ hζ]
  have hcomm := rootSpan_commute_of_orth (τ := TwistTag.E6.tag) (L := L) (Or.inr (Or.inl rfl))
    (S₁ := parabolicRoots TwistTag.E6.tag e6LeviNodes) (S₂ := ({θ₀, -θ₀} : Set _))
    (fun r hr => (mem_parabolicRoots_e6LeviNodes.1 hr).1) hroots (by
      intro α hα β hβ
      rw [dotProduct_mulVec_eq_iform]
      have h0 := (mem_parabolicRoots_e6LeviNodes.1 hα).2
      rcases hβ with rfl | rfl
      · rw [iform_comm, iform_e6HighestRoot, h0]
      · have : iform α (-θ₀) = -iform α θ₀ := by
          simp [iform, Finset.sum_neg_distrib]
        rw [this, iform_comm, iform_e6HighestRoot, h0]
        simp)
  intro x hx
  have hxc : x ∈ Subgroup.centralizer
      (rootSpan TwistTag.E6.tag L {θ₀, -θ₀} : Set (ModGL TwistTag.E6.tag L)) := by
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    exact (hcomm x hx y hy).symm
  exact (Subgroup.centralizer_le_normalizer _) hxc

theorem cocycle_decomp {L : Type} [Field L] [IsAlgClosed L] {ζ : Lˣ} (hζ : IsPrimitiveRoot ζ 3)
    {w v : WeylGroup TwistTag.E6.tag} {γ : Fin TwistTag.E6.tag.rank → ℤ} (hw : w • θ₀ = γ)
    (hφ : v • permLattice TwistTag.E6.perm γ = -γ) :
    ∃ τ ∈ torusGroup TwistTag.E6.tag L, ∃ uJ : WeylGroup TwistTag.E6.tag,
      uJ = (rootReflection θ₀)⁻¹ * (w⁻¹ * v * weylTwist TwistTag.E6 w) ∧
      canonicalRep (coxeterSystem TwistTag.E6.tag) L uJ ∈
        familyGroup (K := L) (zpowFamily ζ (Pi.single (e6Idx 1) 1)) ∧
      (canonicalRep (coxeterSystem TwistTag.E6.tag) L w)⁻¹ *
          canonicalRep (coxeterSystem TwistTag.E6.tag) L v *
          canonicalRep (coxeterSystem TwistTag.E6.tag) L (weylTwist TwistTag.E6 w) =
        τ * (canonicalRep (coxeterSystem TwistTag.E6.tag) L (rootReflection θ₀) *
          canonicalRep (coxeterSystem TwistTag.E6.tag) L uJ) := by
  set M := familyGroup (K := L) (zpowFamily ζ (Pi.single (e6Idx 1) 1)) with hM
  obtain ⟨u, hu⟩ : ∃ u : WeylGroup TwistTag.E6.tag, u = w⁻¹ * v * weylTwist TwistTag.E6 w :=
    ⟨_, rfl⟩
  have huθ : u • θ₀ = -θ₀ := by rw [hu]; exact smul_cocycleWeyl_highRoot hw hφ
  set s : WeylGroup TwistTag.E6.tag := rootReflection θ₀ with hs
  have hsθ : s • θ₀ = -θ₀ := rootReflection_smul_self isRoot_e6HighestRoot
  set uJ : WeylGroup TwistTag.E6.tag := s⁻¹ * u with huJ
  have huJθ : uJ • θ₀ = θ₀ := by
    rw [huJ, mul_smul, huθ, inv_smul_eq_iff]
    exact hsθ.symm
  have huJmem := mem_parabolicWeylGroup_of_smul_θ₀ huJθ
  have hnJ : canonicalRep (coxeterSystem TwistTag.E6.tag) L uJ ∈ M := by
    refine canonicalRep_closure_mem_familyGroup _ ?_
    rw [familyKernel_aJ hζ]
    unfold parabolicWeylGroup at huJmem
    refine (Subgroup.closure_mono ?_) huJmem
    rintro _ ⟨j, hj, rfl⟩
    refine ⟨Pi.single j 1, ?_, ?_⟩
    · rw [mem_parabolicRoots_e6LeviNodes]
      refine ⟨isRoot_single _ j, ?_⟩
      have hj' : j ≠ e6Idx 1 := hj
      simp [Pi.single_apply, hj'.symm]
    · exact (rootReflection_eq_conj (τ := TwistTag.E6.tag) (w := 1) (j := j)
        (β := Pi.single j 1) (by simp)).trans (by simp)
  obtain ⟨k₁, hk₁, h1⟩ := canonicalRep_inv_eq (K := L) (τ := TwistTag.E6.tag) w
  obtain ⟨k₂, hk₂, h2⟩ := canonicalRep_mul_mem (R := L) (τ := TwistTag.E6.tag) w⁻¹ v
  obtain ⟨k₃, hk₃, h3⟩ := canonicalRep_mul_mem (R := L) (τ := TwistTag.E6.tag) (w⁻¹ * v)
    (weylTwist TwistTag.E6 w)
  obtain ⟨k₄, hk₄, h4⟩ := canonicalRep_mul_mem (R := L) (τ := TwistTag.E6.tag) s uJ
  have hsuJ : s * uJ = u := by rw [huJ]; group
  rw [hsuJ] at h4
  rw [← hu] at h3
  have hnu : canonicalRep (coxeterSystem TwistTag.E6.tag) L u =
      k₄⁻¹ * (canonicalRep (coxeterSystem TwistTag.E6.tag) L s *
        canonicalRep (coxeterSystem TwistTag.E6.tag) L uJ) := by
    rw [h4]; group
  have hm : (canonicalRep (coxeterSystem TwistTag.E6.tag) L w)⁻¹ *
        canonicalRep (coxeterSystem TwistTag.E6.tag) L v *
        canonicalRep (coxeterSystem TwistTag.E6.tag) L (weylTwist TwistTag.E6 w) =
      (k₁ * k₂ * k₃ * k₄⁻¹) * (canonicalRep (coxeterSystem TwistTag.E6.tag) L s *
        canonicalRep (coxeterSystem TwistTag.E6.tag) L uJ) := by
    calc (canonicalRep (coxeterSystem TwistTag.E6.tag) L w)⁻¹ *
          canonicalRep (coxeterSystem TwistTag.E6.tag) L v *
          canonicalRep (coxeterSystem TwistTag.E6.tag) L (weylTwist TwistTag.E6 w)
        = k₁ * (canonicalRep (coxeterSystem TwistTag.E6.tag) L w⁻¹ *
            canonicalRep (coxeterSystem TwistTag.E6.tag) L v) *
            canonicalRep (coxeterSystem TwistTag.E6.tag) L (weylTwist TwistTag.E6 w) := by
          rw [h1]; group
      _ = k₁ * k₂ * (canonicalRep (coxeterSystem TwistTag.E6.tag) L (w⁻¹ * v) *
            canonicalRep (coxeterSystem TwistTag.E6.tag) L (weylTwist TwistTag.E6 w)) := by
          rw [h2]; group
      _ = k₁ * k₂ * k₃ * canonicalRep (coxeterSystem TwistTag.E6.tag) L u := by
          rw [h3]; group
      _ = (k₁ * k₂ * k₃ * k₄⁻¹) * (canonicalRep (coxeterSystem TwistTag.E6.tag) L s *
            canonicalRep (coxeterSystem TwistTag.E6.tag) L uJ) := by
          rw [hnu]; group
  exact ⟨k₁ * k₂ * k₃ * k₄⁻¹, Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hk₁ hk₂)
    hk₃) (Subgroup.inv_mem _ hk₄), uJ, huJ.trans (by rw [hu]), hnJ, hm⟩

theorem cocycle_mem_sup {L : Type} [Field L] [IsAlgClosed L] {ζ : Lˣ} (hζ : IsPrimitiveRoot ζ 3)
    {w v : WeylGroup TwistTag.E6.tag} {γ : Fin TwistTag.E6.tag.rank → ℤ} (hw : w • θ₀ = γ)
    (hφ : v • permLattice TwistTag.E6.perm γ = -γ) :
    (canonicalRep (coxeterSystem TwistTag.E6.tag) L w)⁻¹ *
        canonicalRep (coxeterSystem TwistTag.E6.tag) L v *
        canonicalRep (coxeterSystem TwistTag.E6.tag) L (weylTwist TwistTag.E6 w) ∈
      familyGroup (K := L) (zpowFamily ζ (Pi.single (e6Idx 1) 1)) ⊔
        rootSpan TwistTag.E6.tag L {θ₀, -θ₀} := by
  obtain ⟨τ, hτ, uJ, -, hnJ, hm⟩ := cocycle_decomp (L := L) hζ hw hφ
  rw [hm]
  have hT : ∀ k ∈ torusGroup TwistTag.E6.tag L,
      k ∈ familyGroup (K := L) (zpowFamily ζ (Pi.single (e6Idx 1) 1)) ⊔
        rootSpan TwistTag.E6.tag L {θ₀, -θ₀} :=
    fun k hk => Subgroup.mem_sup_left (torus_le_familyGroup _ hk)
  have hns : canonicalRep (coxeterSystem TwistTag.E6.tag) L (rootReflection θ₀) ∈
      familyGroup (K := L) (zpowFamily ζ (Pi.single (e6Idx 1) 1)) ⊔
        rootSpan TwistTag.E6.tag L {θ₀, -θ₀} := by
    have := CFSG.HardMathSupport.Timmesfeld.CrossChar.SmallQ3.canonicalRep_rootReflection_mem
      (τ := TwistTag.E6.tag) (k := L) isRoot_e6HighestRoot
    exact sup_le_sup (torus_le_familyGroup _) le_rfl this
  exact Subgroup.mul_mem _ (hT τ hτ) (Subgroup.mul_mem _ hns (Subgroup.mem_sup_left hnJ))

theorem exists_primitiveRoot_nine {L : Type} [Field L] [IsAlgClosed L] (p : ℕ) [Fact p.Prime]
    [CharP L p] (hp3 : p ≠ 3) : ∃ ζ : Lˣ, IsPrimitiveRoot ζ 9 := by
  have h9 : ((9 : ℕ) : L) ≠ 0 := by
    intro h
    have hd : p ∣ 9 := (CharP.cast_eq_zero_iff L p 9).1 h
    have h3 : p ∣ 3 := (Fact.out : p.Prime).dvd_of_dvd_pow (n := 2) (by norm_num; exact hd)
    exact hp3 ((Nat.prime_dvd_prime_iff_eq (Fact.out : p.Prime) Nat.prime_three).1 h3)
  haveI : NeZero ((9 : ℕ) : L) := ⟨h9⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot L 9
  have hu : IsUnit ζ := hζ.isUnit (by norm_num)
  exact ⟨hu.unit, IsPrimitiveRoot.coe_units_iff.1 (by rwa [IsUnit.unit_spec])⟩

theorem map_conj_eq_of_mem_normalizer {Γ : Type*} [Group Γ] {S : Subgroup Γ} {z : Γ}
    (hz : z ∈ Subgroup.normalizer (S : Set Γ)) : S.map (MulAut.conj z).toMonoidHom = S := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact (Subgroup.mem_normalizer_iff.1 hz y).1 hy
  · intro hx
    refine ⟨z⁻¹ * x * z, ?_, by simp [MulAut.conj_apply, mul_assoc]⟩
    have := (Subgroup.mem_normalizer_iff.1 hz (z⁻¹ * x * z)).2
    apply this
    simpa [mul_assoc] using hx

theorem exists_fixed_conj_rootSL2 {L : Type} [Field L] [IsAlgClosed L] (p f : ℕ) [Fact p.Prime]
    [CharP L p] (hf : 1 ≤ f) (hp3 : p ≠ 3) {v : WeylGroup TwistTag.E6.tag}
    {g0 : ModGL TwistTag.E6.tag L} (hg0C : g0 ∈ adjointGroup TwistTag.E6.tag L)
    (hg0 : twistHom TwistTag.E6 L (iterateFrobenius L p f) g0 =
      g0 * canonicalRep (coxeterSystem TwistTag.E6.tag) L v)
    {γ : Fin TwistTag.E6.tag.rank → ℤ} (hγ : IsRoot TwistTag.E6.tag γ)
    (hφ : v • permLattice TwistTag.E6.perm γ = -γ) :
    ∃ h ∈ adjointGroup TwistTag.E6.tag L, twistHom TwistTag.E6 L (iterateFrobenius L p f) h = h ∧
      (rootSpan TwistTag.E6.tag L {θ₀, -θ₀}).map (MulAut.conj h).toMonoidHom =
        (rootSpan TwistTag.E6.tag L {γ, -γ}).map (MulAut.conj g0).toMonoidHom := by
  classical
  obtain ⟨ζ₉, hζ₉⟩ := exists_primitiveRoot_nine (L := L) p hp3
  have hζ₃ : IsPrimitiveRoot (ζ₉ ^ 3) 3 := hζ₉.pow (by norm_num) (by norm_num)
  obtain ⟨w, hw0⟩ := CFSG.SeitzReduction.EPilot.exists_smul_highRoot_eq (τ := TwistTag.E6.tag)
    (Or.inl rfl) hγ
  have hw : w • θ₀ = γ := hw0
  set S₀ : Subgroup (ModGL TwistTag.E6.tag L) := rootSpan TwistTag.E6.tag L {θ₀, -θ₀} with hS₀
  set MJ : Subgroup (ModGL TwistTag.E6.tag L) :=
    familyGroup (K := L) (zpowFamily (ζ₉ ^ 3) (Pi.single (e6Idx 1) 1)) with hMJ
  set M₂ : Subgroup (ModGL TwistTag.E6.tag L) := familyGroup (K := L) (zpowFamily ζ₉ e6SepVec)
    with hM₂
  have hroots : ∀ α ∈ ({θ₀, -θ₀} : Set (Fin TwistTag.E6.tag.rank → ℤ)),
      IsRoot TwistTag.E6.tag α := by
    intro α hα
    rcases hα with rfl | rfl
    · exact isRoot_e6HighestRoot
    · exact IsRoot.neg isRoot_e6HighestRoot
  have hMJN : MJ ≤ Subgroup.normalizer (S₀ : Set (ModGL TwistTag.E6.tag L)) :=
    familyGroup_aJ_le_normalizer hζ₃
  have hS₀M₂ : S₀ ≤ M₂ := by
    have := rootSpan_le_familyGroup (L := L) (zpowFamily ζ₉ e6SepVec)
    rwa [familyKernel_a2 hζ₉] at this
  have hM₂N : M₂ ≤ Subgroup.normalizer (S₀ : Set (ModGL TwistTag.E6.tag L)) := by
    unfold familyGroup at hM₂
    rw [hM₂, familyKernel_a2 hζ₉]
    exact sup_le (CFSG.RankThree.PartOne.KE.torusGroup_le_normalizer_rootSpan hroots)
      Subgroup.le_normalizer
  set h₀ : ModGL TwistTag.E6.tag L := g0 * canonicalRep (coxeterSystem TwistTag.E6.tag) L w
    with hh₀
  have hcoc : h₀⁻¹ * twistHom TwistTag.E6 L (iterateFrobenius L p f) h₀ =
      (canonicalRep (coxeterSystem TwistTag.E6.tag) L w)⁻¹ *
        canonicalRep (coxeterSystem TwistTag.E6.tag) L v *
        canonicalRep (coxeterSystem TwistTag.E6.tag) L (weylTwist TwistTag.E6 w) := by
    rw [hh₀, map_mul, hg0, twistHom_canonicalRep]
    group
  have hmem := cocycle_mem_sup (L := L) hζ₃ hw hφ
  rw [← hcoc] at hmem
  obtain ⟨j, hj, s, hs, hjs⟩ := exists_mul_of_mem_sup (A₀ := S₀) (B := MJ)
    (fun b hb a ha => (Subgroup.mem_normalizer_iff.1 (hMJN hb) a).1 ha) hmem
  have himgJ : (fun α => permLattice TwistTag.E6.perm α) ''
      familyKernel (τ := TwistTag.E6.tag) (zpowFamily (ζ₉ ^ 3) (Pi.single (e6Idx 1) 1)) =
      familyKernel (zpowFamily (ζ₉ ^ 3) (Pi.single (e6Idx 1) 1)) := by
    rw [familyKernel_aJ hζ₃]
    exact image_permLattice_parabolicRoots
  have himg₂ : (fun α => permLattice TwistTag.E6.perm α) ''
      familyKernel (τ := TwistTag.E6.tag) (zpowFamily ζ₉ e6SepVec) =
      familyKernel (zpowFamily ζ₉ e6SepVec) := by
    rw [familyKernel_a2 hζ₉]
    exact image_permLattice_pair
  obtain ⟨z₁, hz₁, z₂, hz₂, hz⟩ := lang_two_step (twistHom TwistTag.E6 L (iterateFrobenius L p f))
    (A₀ := S₀) (A := M₂) (B := MJ) hS₀M₂
    (fun b hb => twistHom_mem_familyGroup p f _ himgJ hb)
    (fun b hb a ha => (Subgroup.mem_normalizer_iff.1 (hMJN hb) a).1 ha)
    (fun j hj => exists_lang_cocycle_familyGroup p f hf _ himgJ hj)
    (fun s hs => exists_lang_cocycle_familyGroup p f hf _ himg₂ hs) hj hs
  rw [← hjs] at hz
  refine ⟨h₀ * (z₁ * z₂), ?_, map_mul_eq_self_of_cocycle _ hz, ?_⟩
  · exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hg0C (canonicalRep_mem_adjointGroup _ L w))
      (Subgroup.mul_mem _ (familyGroup_le_adjoint _ hz₁) (familyGroup_le_adjoint _ hz₂))
  · have hzN : z₁ * z₂ ∈ Subgroup.normalizer (S₀ : Set (ModGL TwistTag.E6.tag L)) :=
      Subgroup.mul_mem _ (hMJN hz₁) (hM₂N hz₂)
    have hconj : (MulAut.conj (h₀ * (z₁ * z₂))).toMonoidHom =
        (MulAut.conj h₀).toMonoidHom.comp (MulAut.conj (z₁ * z₂)).toMonoidHom := by
      ext x; simp [MulAut.conj_apply, mul_assoc]
    rw [hconj, ← Subgroup.map_map, map_conj_eq_of_mem_normalizer hzN, hh₀]
    have hconj' : (MulAut.conj (g0 * canonicalRep (coxeterSystem TwistTag.E6.tag) L w)).toMonoidHom =
        (MulAut.conj g0).toMonoidHom.comp
          (MulAut.conj (canonicalRep (coxeterSystem TwistTag.E6.tag) L w)).toMonoidHom := by
      ext x; simp [MulAut.conj_apply, mul_assoc]
    rw [hconj', ← Subgroup.map_map]
    congr 1
    rw [hS₀, (canonical_weyl_root_transport TwistTag.E6.tag L).1 w {θ₀, -θ₀} hroots]
    congr 1
    ext α
    simp only [Set.image_insert_eq, Set.image_singleton, Set.mem_insert_iff, Set.mem_singleton_iff,
      smul_neg, hw]

