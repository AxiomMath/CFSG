theorem xPar_single_eq_sl2At (i : Fin Tag.D4.rank) (c : K) :
    𝕩 (Pi.single i 1) c = sl2At K i (uSL c) := by
  rw [CFSG.StandardType.AutSt.xPar_single_eq_adjX, sl2At_uSL]

theorem xPar_neg_single_eq_sl2At (i : Fin Tag.D4.rank) (c : K) :
    𝕩 (-Pi.single i 1) c = sl2At K i (vSL c) := by
  rw [CFSG.StandardType.AutSt.xPar_neg_single_eq_adjY, sl2At_vSL]

theorem weylElement_eq_sl2At (i : Fin Tag.D4.rank) :
    CFSG.LieType.Steinberg.weylElement 𝕩 i (1 : Kˣ) = sl2At K i (uSL 1 * vSL (-1) * uSL 1) := by
  unfold CFSG.LieType.Steinberg.weylElement
  simp only [inv_one, Units.val_one, map_mul, xPar_single_eq_sl2At, xPar_neg_single_eq_sl2At]

theorem exists_weyl_conj (i : Fin Tag.D4.rank) {β : Fin Tag.D4.rank → ℤ} (hβ : IsRoot Tag.D4 β) :
    ∃ ε : K, ε * ε = 1 ∧ ∀ u : K,
      CFSG.LieType.Steinberg.weylElement 𝕩 i (1 : Kˣ) * 𝕩 β u *
          (CFSG.LieType.Steinberg.weylElement 𝕩 i (1 : Kˣ))⁻¹ =
        𝕩 (reflect Tag.D4 i β) (ε * u) := by
  obtain ⟨ε, hε, h⟩ := weylElement_xPar_conj (F := rootOperatorFamily Tag.D4) (K := K) i hβ
  refine ⟨(ε : K), ?_, fun u => ?_⟩
  · rcases hε with rfl | rfl <;> norm_num
  · rw [h 1 u]
    have hrefl : CFSG.LieType.RootSystem.reflection Tag.D4.cartan i β = reflect Tag.D4 i β := by
      rw [CFSG.LieType.RootSystem.reflection_apply]
      rfl
    rw [hrefl]
    simp

theorem mem_of_conj_eq {H : Subgroup ↥(adjointGroup Tag.D4 K)} {g : ↥(adjointGroup Tag.D4 K)}
    (hg : g ∈ H) {β β' : Fin Tag.D4.rank → ℤ} {ε : K} (hε : ε * ε = 1)
    (hconj : ∀ u, g * 𝕩 β u * g⁻¹ = 𝕩 β' (ε * u)) (h : ∀ c, 𝕩 β c ∈ H) (c : K) :
    𝕩 β' c ∈ H := by
  have := H.mul_mem (H.mul_mem hg (h (ε * c))) (H.inv_mem hg)
  rwa [hconj, ← mul_assoc, hε, one_mul] at this

@[expose] noncomputable def weylG2 : ↥(adjointGroup Tag.D4 K) :=
  CFSG.LieType.Steinberg.weylElement 𝕩 ⟨2, by decide⟩ (1 : Kˣ) *
    (CFSG.LieType.Steinberg.weylElement 𝕩 ⟨0, by decide⟩ (1 : Kˣ) *
      CFSG.LieType.Steinberg.weylElement 𝕩 ⟨1, by decide⟩ (1 : Kˣ) *
        CFSG.LieType.Steinberg.weylElement 𝕩 ⟨3, by decide⟩ (1 : Kˣ))

theorem exists_weylG2_conj {β : Fin Tag.D4.rank → ℤ} (hβ : IsRoot Tag.D4 β) :
    ∃ ε : K, ε * ε = 1 ∧ ∀ u : K, weylG2 * 𝕩 β u * (weylG2 : ↥(adjointGroup Tag.D4 K))⁻¹ =
      𝕩 (reflect Tag.D4 ⟨2, by decide⟩ (reflect Tag.D4 ⟨0, by decide⟩
        (reflect Tag.D4 ⟨1, by decide⟩ (reflect Tag.D4 ⟨3, by decide⟩ β)))) (ε * u) := by
  have hβ3 := hβ.reflect ⟨3, by decide⟩
  have hβ1 := hβ3.reflect ⟨1, by decide⟩
  have hβ0 := hβ1.reflect ⟨0, by decide⟩
  obtain ⟨e3, he3, h3⟩ := exists_weyl_conj (K := K) ⟨3, by decide⟩ hβ
  obtain ⟨e1, he1, h1⟩ := exists_weyl_conj (K := K) ⟨1, by decide⟩ hβ3
  obtain ⟨e0, he0, h0⟩ := exists_weyl_conj (K := K) ⟨0, by decide⟩ hβ1
  obtain ⟨e2, he2, h2⟩ := exists_weyl_conj (K := K) ⟨2, by decide⟩ hβ0
  refine ⟨e2 * e0 * e1 * e3, ?_, fun u => ?_⟩
  · calc e2 * e0 * e1 * e3 * (e2 * e0 * e1 * e3) =
          (e2 * e2) * (e0 * e0) * (e1 * e1) * (e3 * e3) := by ring
      _ = 1 := by rw [he2, he0, he1, he3]; ring
  · unfold weylG2
    set n2 := CFSG.LieType.Steinberg.weylElement 𝕩 (⟨2, by decide⟩ : Fin Tag.D4.rank) (1 : Kˣ)
    set n0 := CFSG.LieType.Steinberg.weylElement 𝕩 (⟨0, by decide⟩ : Fin Tag.D4.rank) (1 : Kˣ)
    set n1 := CFSG.LieType.Steinberg.weylElement 𝕩 (⟨1, by decide⟩ : Fin Tag.D4.rank) (1 : Kˣ)
    set n3 := CFSG.LieType.Steinberg.weylElement 𝕩 (⟨3, by decide⟩ : Fin Tag.D4.rank) (1 : Kˣ)
    have e : n2 * (n0 * n1 * n3) * 𝕩 β u * (n2 * (n0 * n1 * n3))⁻¹ =
        n2 * (n0 * (n1 * (n3 * 𝕩 β u * n3⁻¹) * n1⁻¹) * n0⁻¹) * n2⁻¹ := by group
    rw [e, h3, h1, h0, h2]
    congr 1
    ring

@[expose] def longOrthRoots : List (Fin Tag.D4.rank → ℤ) := [![1, 1, 1, 0], ![1, 0, 1, 1], ![0, 1, 1, 1]]

theorem longOrth_facts :
    ∀ β ∈ longOrthRoots, IsRoot Tag.D4 β ∧ IsRoot Tag.D4 (-β) ∧
      ¬IsRoot Tag.D4 (β + Pi.single ⟨2, by decide⟩ 1) ∧
      ¬IsRoot Tag.D4 (β + -Pi.single ⟨2, by decide⟩ 1) ∧
      ¬IsRoot Tag.D4 (-β + Pi.single ⟨2, by decide⟩ 1) ∧
      ¬IsRoot Tag.D4 (-β + -Pi.single ⟨2, by decide⟩ 1) ∧
      β ≠ Pi.single ⟨2, by decide⟩ 1 ∧ β ≠ -Pi.single ⟨2, by decide⟩ 1 ∧
      -β ≠ Pi.single ⟨2, by decide⟩ 1 ∧ -β ≠ -Pi.single ⟨2, by decide⟩ 1 := by
  simp only [isRoot_iff_mem_artifactRoots]
  decide

theorem longOrth_reflect :
    ∀ i : Fin Tag.D4.rank, i ≠ ⟨2, by decide⟩ → ∃ β ∈ longOrthRoots,
      reflect Tag.D4 ⟨2, by decide⟩ (reflect Tag.D4 ⟨0, by decide⟩
          (reflect Tag.D4 ⟨1, by decide⟩ (reflect Tag.D4 ⟨3, by decide⟩ β))) = Pi.single i 1 ∧
        reflect Tag.D4 ⟨2, by decide⟩ (reflect Tag.D4 ⟨0, by decide⟩
          (reflect Tag.D4 ⟨1, by decide⟩ (reflect Tag.D4 ⟨3, by decide⟩ (-β)))) =
            -Pi.single i 1 := by
  decide

theorem commute_sl2Two {β : Fin Tag.D4.rank → ℤ} (hβ : IsRoot Tag.D4 β)
    (hp : ¬IsRoot Tag.D4 (β + Pi.single ⟨2, by decide⟩ 1))
    (hm : ¬IsRoot Tag.D4 (β + -Pi.single ⟨2, by decide⟩ 1))
    (h1 : β ≠ Pi.single ⟨2, by decide⟩ 1) (h2 : β ≠ -Pi.single ⟨2, by decide⟩ 1) (c : K)
    (A : SL2 K) : Commute (𝕩 β c) (sl2At K ⟨2, by decide⟩ A) := by
  set S := (Subgroup.centralizer ({𝕩 β c} : Set ↥(adjointGroup Tag.D4 K))).comap
    (sl2At K ⟨2, by decide⟩)
  have hS : S = ⊤ := by
    rw [eq_top_iff, ← sl2_closure_upper_lower, Subgroup.closure_le]
    rintro _ (⟨t, rfl⟩ | ⟨t, rfl⟩)
    · show sl2At K ⟨2, by decide⟩ (uSL t) ∈ Subgroup.centralizer _
      rw [Subgroup.mem_centralizer_singleton_iff, ← xPar_single_eq_sl2At]
      exact (CFSG.LieType.Steinberg.TwistedD4.commute_xPar hβ (isRoot_single Tag.D4 _) h1
        h2 hp c t).symm.eq
    · show sl2At K ⟨2, by decide⟩ (vSL t) ∈ Subgroup.centralizer _
      rw [Subgroup.mem_centralizer_singleton_iff, ← xPar_neg_single_eq_sl2At]
      exact (CFSG.LieType.Steinberg.TwistedD4.commute_xPar hβ (isRoot_neg_single Tag.D4 _) h2
        (fun h => h1 (h.trans (neg_neg _))) hm c t).symm.eq
  have hA : A ∈ S := by rw [hS]; trivial
  exact (Subgroup.mem_centralizer_singleton_iff.1 hA).symm

theorem d4Graph_one_xPar_two (c : K) :
    d4Graph K 1 (𝕩 (Pi.single ⟨2, by decide⟩ 1) c) = 𝕩 (Pi.single ⟨2, by decide⟩ 1) c ∧
      d4Graph K 1 (𝕩 (-Pi.single ⟨2, by decide⟩ 1) c) = 𝕩 (-Pi.single ⟨2, by decide⟩ 1) c := by
  rw [xPar_single_eq_sl2At, xPar_neg_single_eq_sl2At]
  exact ⟨d4Graph_one_sl2Two _, d4Graph_one_sl2Two _⟩

theorem d4Graph_one_weylG2 : d4Graph K 1 (weylG2 : ↥(adjointGroup Tag.D4 K)) = weylG2 := by
  unfold weylG2
  rw [weylElement_eq_sl2At, weylElement_eq_sl2At, weylElement_eq_sl2At, weylElement_eq_sl2At,
    map_mul, d4Graph_one_sl2Two]
  congr 1
  exact d4Graph_one_sl2Short _

theorem closure_eq_top_long (A : SL2 K) :
    Subgroup.closure ((Subgroup.centralizer ({sl2At K ⟨2, by decide⟩ A} :
      Set ↥(adjointGroup Tag.D4 K)) : Set ↥(adjointGroup Tag.D4 K)) ∪
        (fixedSubgroup (d4Graph K 1) : Set ↥(adjointGroup Tag.D4 K))) = ⊤ := by
  set M := Subgroup.closure ((Subgroup.centralizer ({sl2At K ⟨2, by decide⟩ A} :
      Set ↥(adjointGroup Tag.D4 K)) : Set ↥(adjointGroup Tag.D4 K)) ∪
        (fixedSubgroup (d4Graph K 1) : Set ↥(adjointGroup Tag.D4 K))) with hM
  have hγ : ∀ g, d4Graph K 1 g = g → g ∈ M := fun g hg => Subgroup.subset_closure (Or.inr hg)
  have hn : weylG2 ∈ M := hγ _ d4Graph_one_weylG2
  have hβ : ∀ β ∈ longOrthRoots, ∀ c, 𝕩 β c ∈ M ∧ 𝕩 (-β) c ∈ M := by
    intro β hβl c
    obtain ⟨hβr, hβr', hp, hm, hp', hm', h1, h2, h1', h2'⟩ := longOrth_facts β hβl
    refine ⟨Subgroup.subset_closure (Or.inl ?_), Subgroup.subset_closure (Or.inl ?_)⟩
    · rw [SetLike.mem_coe, Subgroup.mem_centralizer_singleton_iff]
      exact (commute_sl2Two hβr hp hm h1 h2 c A).eq
    · rw [SetLike.mem_coe, Subgroup.mem_centralizer_singleton_iff]
      exact (commute_sl2Two hβr' hp' hm' h1' h2' c A).eq
  refine eq_top_of_simple_mem fun i c => ?_
  by_cases hi : i = ⟨2, by decide⟩
  · subst hi
    exact ⟨hγ _ (d4Graph_one_xPar_two c).1, hγ _ (d4Graph_one_xPar_two c).2⟩
  · obtain ⟨β, hβl, hpos, hneg⟩ := longOrth_reflect i hi
    obtain ⟨hβr, hβr', -⟩ := longOrth_facts β hβl
    obtain ⟨ε, hε, hc⟩ := exists_weylG2_conj (K := K) hβr
    obtain ⟨ε', hε', hc'⟩ := exists_weylG2_conj (K := K) hβr'
    rw [hpos] at hc
    rw [hneg] at hc'
    exact ⟨mem_of_conj_eq hn hε hc (fun c => (hβ β hβl c).1) c,
      mem_of_conj_eq hn hε' hc' (fun c => (hβ β hβl c).2) c⟩

theorem conj_eq_of_commute {H : Type*} [Group H] {a b c x : H} (ha : Commute a (b * x * b⁻¹))
    (hc : Commute c x) : a * b * c * x * (a * b * c)⁻¹ = b * x * b⁻¹ := by
  have e1 : a * b * c * x * (a * b * c)⁻¹ = a * (b * (c * x * c⁻¹) * b⁻¹) * a⁻¹ := by group
  rw [e1, hc.eq, mul_inv_cancel_right, ha.eq, mul_inv_cancel_right]

theorem sl2Short_conj_sl2At (A B : SL2 K) :
    sl2Short K B * sl2At K ⟨0, by decide⟩ A * (sl2Short K B)⁻¹ =
        sl2At K ⟨0, by decide⟩ (B * A * B⁻¹) ∧
      sl2Short K B * sl2At K ⟨1, by decide⟩ A * (sl2Short K B)⁻¹ =
        sl2At K ⟨1, by decide⟩ (B * A * B⁻¹) ∧
      sl2Short K B * sl2At K ⟨3, by decide⟩ A * (sl2Short K B)⁻¹ =
        sl2At K ⟨3, by decide⟩ (B * A * B⁻¹) := by
  set i0 : Fin Tag.D4.rank := ⟨0, by decide⟩
  set i1 : Fin Tag.D4.rank := ⟨1, by decide⟩
  set i3 : Fin Tag.D4.rank := ⟨3, by decide⟩
  have c10 : ∀ X Y : SL2 K, Commute (sl2At K i1 X) (sl2At K i0 Y) := fun X Y =>
    sl2At_commute (by decide) (by decide) (by decide) X Y
  have c30 : ∀ X Y : SL2 K, Commute (sl2At K i3 X) (sl2At K i0 Y) := fun X Y =>
    sl2At_commute (by decide) (by decide) (by decide) X Y
  have c01 : ∀ X Y : SL2 K, Commute (sl2At K i0 X) (sl2At K i1 Y) := fun X Y =>
    sl2At_commute (by decide) (by decide) (by decide) X Y
  have c31 : ∀ X Y : SL2 K, Commute (sl2At K i3 X) (sl2At K i1 Y) := fun X Y =>
    sl2At_commute (by decide) (by decide) (by decide) X Y
  have c03 : ∀ X Y : SL2 K, Commute (sl2At K i0 X) (sl2At K i3 Y) := fun X Y =>
    sl2At_commute (by decide) (by decide) (by decide) X Y
  have c13 : ∀ X Y : SL2 K, Commute (sl2At K i1 X) (sl2At K i3 Y) := fun X Y =>
    sl2At_commute (by decide) (by decide) (by decide) X Y
  have hconj : ∀ i : Fin Tag.D4.rank, sl2At K i B * sl2At K i A * (sl2At K i B)⁻¹ =
      sl2At K i (B * A * B⁻¹) := fun i => by rw [map_mul, map_mul, map_inv]
  rw [sl2Short_apply]
  refine ⟨?_, ?_, ?_⟩
  · rw [show sl2At K i0 B * sl2At K i1 B * sl2At K i3 B =
        1 * sl2At K i0 B * (sl2At K i1 B * sl2At K i3 B) by group,
      conj_eq_of_commute (Commute.one_left _) ((c10 B A).mul_left (c30 B A)), hconj]
  · rw [conj_eq_of_commute (by rw [hconj]; exact c01 B _) (c31 B A), hconj]
  · rw [show sl2At K i0 B * sl2At K i1 B * sl2At K i3 B =
        (sl2At K i0 B * sl2At K i1 B) * sl2At K i3 B * 1 by group,
      conj_eq_of_commute (by rw [hconj]; exact (c03 B _).mul_left (c13 B _))
        (Commute.one_left _), hconj]

theorem sl2At_mem_of_normalClosure [Finite K] (hK4 : 4 ≤ Nat.card K)
    {M : Subgroup ↥(adjointGroup Tag.D4 K)} {i : Fin Tag.D4.rank} {A : SL2 K}
    (hA : A ∉ Subgroup.center (SL2 K)) (hconj : ∀ B : SL2 K, sl2At K i (B * A * B⁻¹) ∈ M)
    (C : SL2 K) : sl2At K i C ∈ M := by
  set N := M.comap (sl2At K i)
  have hle : Subgroup.normalClosure ({A} : Set (SL2 K)) ≤ N := by
    rw [Subgroup.normalClosure, Subgroup.closure_le]
    intro x hx
    obtain ⟨a, ha, hax⟩ := Group.mem_conjugatesOfSet_iff.1 hx
    rw [Set.mem_singleton_iff] at ha
    subst ha
    obtain ⟨c, rfl⟩ := isConj_iff.1 hax
    exact hconj c
  rcases CFSG.LieType.CurtisTits.le_center_or_eq_top_of_isQuasisimple
      (CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.isQuasisimple_sl2 hK4)
      (Subgroup.normalClosure ({A} : Set (SL2 K))) with h | h
  · exact absurd (h (Subgroup.subset_normalClosure (Set.mem_singleton A))) hA
  · have : C ∈ N := hle (h ▸ Subgroup.mem_top C)
    exact this

theorem sq_eq_one_of_mem_center {A : SL2 K} (hA : A ∈ Subgroup.center (SL2 K)) : A * A = 1 := by
  obtain ⟨r, hr, hrA⟩ := Matrix.SpecialLinearGroup.mem_center_iff.1 hA
  have hr2 : r * r = 1 := by simpa [sq] using hr
  ext i j
  have e : ((A * A : SL2 K) : Matrix (Fin 2) (Fin 2) K) = Matrix.scalar (Fin 2) (r * r) := by
    rw [Matrix.SpecialLinearGroup.coe_mul, ← hrA, ← map_mul]
  rw [e, hr2, map_one]
  rfl

theorem closure_eq_top_short [Finite K] (hK4 : 4 ≤ Nat.card K) {A : SL2 K}
    (hA : A ∉ Subgroup.center (SL2 K)) :
    Subgroup.closure ((Subgroup.centralizer ({sl2Short K A} :
      Set ↥(adjointGroup Tag.D4 K)) : Set ↥(adjointGroup Tag.D4 K)) ∪
        (fixedSubgroup (d4Graph K 1) : Set ↥(adjointGroup Tag.D4 K))) = ⊤ := by
  set M := Subgroup.closure ((Subgroup.centralizer ({sl2Short K A} :
      Set ↥(adjointGroup Tag.D4 K)) : Set ↥(adjointGroup Tag.D4 K)) ∪
        (fixedSubgroup (d4Graph K 1) : Set ↥(adjointGroup Tag.D4 K))) with hM
  have hγ : ∀ g, d4Graph K 1 g = g → g ∈ M := fun g hg => Subgroup.subset_closure (Or.inr hg)
  have hc := fun (i j : Fin Tag.D4.rank) (hi : i ≠ ⟨2, by decide⟩) (hj : j ≠ ⟨2, by decide⟩)
    (hij : i ≠ j) (A B : SL2 K) => sl2At_commute (K := K) hi hj hij A B
  have hcen : ∀ i : Fin Tag.D4.rank, i ≠ ⟨2, by decide⟩ → sl2At K i A ∈ M := by
    intro i hi
    refine Subgroup.subset_closure (Or.inl ?_)
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_singleton_iff, sl2Short_apply]
    have hcomm : ∀ j : Fin Tag.D4.rank, j ≠ ⟨2, by decide⟩ →
        Commute (sl2At K i A) (sl2At K j A) := by
      intro j hj
      by_cases hij : i = j
      · subst hij
        exact Commute.refl _
      · exact hc i j hi hj hij A A
    exact (((hcomm ⟨0, by decide⟩ (by decide)).mul_right (hcomm ⟨1, by decide⟩ (by decide))).mul_right
      (hcomm ⟨3, by decide⟩ (by decide))).eq
  have hconj : ∀ i : Fin Tag.D4.rank, i ≠ ⟨2, by decide⟩ → ∀ B : SL2 K,
      sl2At K i (B * A * B⁻¹) ∈ M := by
    intro i hi B
    have hB : sl2Short K B ∈ M := hγ _ (d4Graph_one_sl2Short B)
    have h := M.mul_mem (M.mul_mem hB (hcen i hi)) (M.inv_mem hB)
    obtain ⟨h0, h1, h3⟩ := sl2Short_conj_sl2At A B
    fin_cases i
    · rwa [h0] at h
    · rwa [h1] at h
    · exact absurd rfl hi
    · rwa [h3] at h
  have hall : ∀ i : Fin Tag.D4.rank, i ≠ ⟨2, by decide⟩ → ∀ C : SL2 K, sl2At K i C ∈ M :=
    fun i hi C => sl2At_mem_of_normalClosure hK4 hA (hconj i hi) C
  refine eq_top_of_simple_mem fun i c => ?_
  by_cases hi : i = ⟨2, by decide⟩
  · subst hi
    exact ⟨hγ _ (d4Graph_one_xPar_two c).1, hγ _ (d4Graph_one_xPar_two c).2⟩
  · rw [xPar_single_eq_sl2At, xPar_neg_single_eq_sl2At]
    exact ⟨hall i hi _, hall i hi _⟩

open CFSG.HardMathSupport.Solomon.Coordinator CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple

theorem pairGenAt_d4Graph_one [Finite K] (hK3 : ringChar K ≠ 3) (hK4 : 4 ≤ Nat.card K) :
    PairGenAt (d4Graph K 1) := by
  intro x hx3 hx1 hγx
  have hK3' : 3 ≤ Nat.card K := by omega
  set Φ := fixSubgroupEquivG2 K hK3'
  set y : ↥(fixSubgroup (d4Graph K 1)) := ⟨x, mem_fixSubgroup.2 hγx⟩
  have hy3 : y ^ 3 = 1 := Subtype.ext (by simp [y, hx3])
  have hy1 : y ≠ 1 := fun h => hx1 (congrArg Subtype.val h)
  have hz3 : Φ y ^ 3 = 1 := by rw [← map_pow, hy3, map_one]
  have hz1 : Φ y ≠ 1 := fun h => hy1 (Φ.injective (h.trans (map_one Φ).symm))
  obtain ⟨g, j, A, hj⟩ := g2_exists_conj_simpleRootSL2 hK3 hK4 hz3 hz1
  set h := Φ.symm g
  have hΦ : Φ (h * y * h⁻¹) = g * Φ y * g⁻¹ := by simp [h]
  have hhγ : d4Graph K 1 (h : ↥(adjointGroup Tag.D4 K)) = h := mem_fixSubgroup.1 h.2
  refine closure_eq_top_of_conj hhγ ?_
  have hw3 : ((h : ↥(adjointGroup Tag.D4 K)) * x * (h : ↥(adjointGroup Tag.D4 K))⁻¹) ^ 3 = 1 := by
    rw [conj_pow, hx3]
    group
  have hw1 : (h : ↥(adjointGroup Tag.D4 K)) * x * (h : ↥(adjointGroup Tag.D4 K))⁻¹ ≠ 1 := by
    intro h0
    apply hx1
    calc x = (h : ↥(adjointGroup Tag.D4 K))⁻¹ * ((h : ↥(adjointGroup Tag.D4 K)) * x *
          (h : ↥(adjointGroup Tag.D4 K))⁻¹) * h := by group
      _ = 1 := by rw [h0]; group
  fin_cases j
  · have e : h * y * h⁻¹ = sl2TwoFix A :=
      Φ.injective (Subtype.ext (by rw [hΦ, hj, fixSubgroupEquivG2_sl2Two]))
    have e' : (h : ↥(adjointGroup Tag.D4 K)) * x * (h : ↥(adjointGroup Tag.D4 K))⁻¹ =
        sl2At K ⟨2, by decide⟩ A := congrArg Subtype.val e
    rw [e']
    exact closure_eq_top_long A
  · have e : h * y * h⁻¹ = sl2ShortFix A :=
      Φ.injective (Subtype.ext (by rw [hΦ, hj, fixSubgroupEquivG2_sl2Short]))
    have e' : (h : ↥(adjointGroup Tag.D4 K)) * x * (h : ↥(adjointGroup Tag.D4 K))⁻¹ =
        sl2Short K A := congrArg Subtype.val e
    rw [e'] at hw3 hw1 ⊢
    refine closure_eq_top_short hK4 fun hA => hw1 ?_
    have h2 : sl2Short K A * sl2Short K A = 1 := by
      rw [← map_mul, sq_eq_one_of_mem_center hA, map_one]
    calc sl2Short K A = sl2Short K A ^ 3 * (sl2Short K A * sl2Short K A)⁻¹ := by group
      _ = 1 := by rw [hw3, h2]; group

theorem fixedSubgroup_d4Graph_two [Finite K] :
    fixedSubgroup (d4Graph K 2) = fixedSubgroup (d4Graph K 1) := by
  ext x
  exact SetLike.ext_iff.1 fixSubgroup_d4Graph_two x

theorem pairGenAt_d4Graph_two [Finite K] (hK3 : ringChar K ≠ 3) (hK4 : 4 ≤ Nat.card K) :
    PairGenAt (d4Graph K 2) :=
  pairGenAt_congr fixedSubgroup_d4Graph_two.symm (pairGenAt_d4Graph_one hK3 hK4)

theorem pairGenAt_of_isG2Type [Finite K] (hK3 : ringChar K ≠ 3) (hK4 : 4 ≤ Nat.card K)
    {α : MulAut ↥(adjointGroup Tag.D4 K)} (hα : IsG2Type α) : PairGenAt α := by
  obtain ⟨ψ, h | h⟩ := hα
  · exact pairGenAt_of_conj_eq ψ (pairGenAt_d4Graph_one hK3 hK4) (Or.inl h)
  · exact pairGenAt_of_conj_eq ψ (pairGenAt_d4Graph_two hK3 hK4) (Or.inl h)

