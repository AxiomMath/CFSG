variable {K : Type} [Field K] [Finite K]

theorem toral_pow_three_and_fixed {p f : ℕ} (hp : p.Prime) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ (p ^ f)) {s : C0 σ} (hs : D4MinusToral p f hp K σ s) :
    s ^ 3 = 1 ∧ tauAut σ s = s := by
  classical
  have : Fact p.Prime := ⟨hp⟩
  obtain ⟨L, _, _, _, _, g₀, b, ⟨_, hg₀P, _⟩, hb3, -, hsd⟩ := hs
  have key : ∀ a : Fin TwistTag.D4.tag.rank → Lˣ, (∀ i, a i ^ 3 = 1) →
      (∀ i, a (TwistTag.D4.perm.symm i) = a i) →
      triEmb K σ L s = g₀ * rootDiagUnit TwistTag.D4.tag a * g₀⁻¹ →
      s ^ 3 = 1 ∧ tauAut σ s = s := by
    intro a ha3 harho hsa
    set d := rootDiagUnit TwistTag.D4.tag a with hd
    have hd3 : d ^ 3 = 1 := by
      have h1 : d ^ 3 = rootDiagUnit TwistTag.D4.tag (a ^ 3) :=
        (map_pow (rootDiagUnitHom TwistTag.D4.tag L) a 3).symm
      have h2 : a ^ 3 = 1 := funext ha3
      rw [h1, h2]
      exact map_one (rootDiagUnitHom TwistTag.D4.tag L)
    refine ⟨?_, ?_⟩
    · apply triEmb_injective (L := L)
      rw [map_pow, hsa, map_one, conj_pow, hd3]
      group
    · set Fr : L →+* L := iterateFrobenius L p f with hFrdef
      have hFr : ∀ c, Fr c = c ^ (p ^ f) := fun c => iterateFrobenius_def p f c
      rw [CFSG.HardMathSupport.Seitz.TrialityOdd.Inner.fieldActor_eq_iff Fr
        (d4Minus_hcomm hσ Fr hFr) s, hsa]
      have hPd : diagramMap TwistTag.D4 L * d = d * diagramMap TwistTag.D4 L := by
        have h := diagramMap_pow_conj_rootDiagUnit (L := L) a 1
        have hfix : (fun i => a (((TwistTag.D4.perm.symm) ^ 1) i)) = a := by
          funext i
          rw [pow_one]
          exact harho i
        rw [hfix, pow_one, ← hd] at h
        exact mul_inv_eq_iff_eq_mul.1 h
      have hPg : diagramMap TwistTag.D4 L * g₀⁻¹ = g₀⁻¹ * diagramMap TwistTag.D4 L :=
        (Commute.inv_right (show Commute (diagramMap TwistTag.D4 L) g₀ from hg₀P)).eq
      calc diagramMap TwistTag.D4 L * (g₀ * d * g₀⁻¹)
          = (diagramMap TwistTag.D4 L * g₀) * d * g₀⁻¹ := by group
        _ = g₀ * (diagramMap TwistTag.D4 L * d) * g₀⁻¹ := by rw [hg₀P]; group
        _ = g₀ * d * (diagramMap TwistTag.D4 L * g₀⁻¹) := by rw [hPd]; group
        _ = g₀ * d * (g₀⁻¹ * diagramMap TwistTag.D4 L) := by rw [hPg]
        _ = g₀ * d * g₀⁻¹ * diagramMap TwistTag.D4 L := by group
  refine key _ ?_ (by intro i; fin_cases i <;> rfl) hsd
  intro i
  fin_cases i
  · exact one_pow 3
  · exact one_pow 3
  · exact hb3
  · exact one_pow 3

theorem toral_form_of_conj {σ : K ≃+* K} {β : MulAut (C0 σ)} {y s : C0 σ} (hs3 : s ^ 3 = 1)
    (hsτ : tauAut σ s = s)
    (hy : MulAut.conj y * β * (MulAut.conj y)⁻¹ = MulAut.conj s * tauAut σ) :
    ∃ s₁ : C0 σ, β s₁ = s₁ ∧ s₁ ^ 3 = 1 ∧ TriOddIsGLine σ ((MulAut.conj s₁)⁻¹ * β) := by
  have hβ : β = (MulAut.conj y)⁻¹ * (MulAut.conj s * tauAut σ) * MulAut.conj y := by
    rw [← hy]; group
  have hs₁ : y⁻¹ * s * y = (MulAut.conj y)⁻¹ s := (MulAut.conj_inv_apply y s).symm
  refine ⟨y⁻¹ * s * y, ?_, ?_, ?_⟩
  · rw [hβ, hs₁, MulAut.mul_apply, MulAut.mul_apply, MulAut.apply_inv_self, MulAut.mul_apply, hsτ,
      MulAut.conj_apply, show s * s * s⁻¹ = s by group]
  · rw [hs₁, ← map_pow, hs3, map_one]
  · refine ⟨MulAut.conj y, Or.inl ?_⟩
    have e : MulAut.conj (y⁻¹ * s * y) = (MulAut.conj y)⁻¹ * MulAut.conj s * MulAut.conj y := by
      rw [map_mul, map_mul, map_inv]
    rw [e, hβ]
    group

theorem exists_toral_form_of_coset {ℓ f : ℕ} (hℓ : ℓ.Prime) (hℓ2 : ℓ ≠ 2) (hℓ3 : ℓ ≠ 3)
    (hf : 1 ≤ f) (hq : (ℓ ^ f) % 3 = 2) (hK : Nat.card K = (ℓ ^ f) ^ 3) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ (ℓ ^ f)) (hinj : Function.Injective (MulAut.conj : C0 σ →* MulAut (C0 σ)))
    (hτ3 : tauAut σ ^ 3 = 1) (g : C0 σ) (hβ3 : (MulAut.conj g * tauAut σ) ^ 3 = 1)
    (hG : ¬ TriOddIsGLine σ (MulAut.conj g * tauAut σ)) :
    ∃ s : C0 σ, (MulAut.conj g * tauAut σ) s = s ∧ s ^ 3 = 1 ∧
      TriOddIsGLine σ ((MulAut.conj s)⁻¹ * (MulAut.conj g * tauAut σ)) := by
  have hnorm : ∀ n : C0 σ, (MulAut.conj n * tauAut σ) ^ 3 = 1 →
      normSeq (fieldActor (t := TwistTag.D4) σ σ) n 3 = 1 := by
    intro n hn
    have h := conj_mul_pow_eq n (tauAut σ) 3
    rw [hn, hτ3, mul_one] at h
    exact hinj (h.symm.trans (map_one _).symm)
  rcases d4MinusNF ℓ f hℓ hℓ2 hℓ3 hf hq K hK σ hσ g (hnorm g hβ3) with
    ⟨y, hy⟩ | ⟨y, s, hs, hy⟩ | ⟨y, n, hn, hy⟩
  · exact absurd ⟨MulAut.conj y, Or.inl hy⟩ hG
  · obtain ⟨hs3, hsτ⟩ := toral_pow_three_and_fixed hℓ σ hσ hs
    exact toral_form_of_conj hs3 hsτ hy
  · have hn3 : (MulAut.conj n * tauAut σ) ^ 3 = 1 := by
      rw [← hy, conj_pow, hβ3]; group
    obtain ⟨y₀, s, hs, hy₀⟩ := minusEll_conj_toral rotLang_holds hℓ hℓ2 hℓ3 hf hq hK σ hσ n hn
      (hnorm n hn3)
    obtain ⟨hs3, hsτ⟩ := toral_pow_three_and_fixed hℓ σ hσ hs
    refine toral_form_of_conj (y := y₀ * y) hs3 hsτ ?_
    rw [map_mul, ← hy₀, ← hy]
    group

theorem outerToralForm_holds : OuterToralForm := by
  intro ℓ f hℓ hℓ2 hℓ3 hf hq K _ _ hK σ hσ β hβ3 hβout hβG
  classical
  obtain ⟨-, hdec, ⟨Θ, hΘ, -, hker, -⟩, hcyc, hcard3, -, hZ, -⟩ :=
    odd_triality_exact_automorphism_normal_form hℓ hℓ2 hf K hK σ hσ
  haveI : Finite (K ≃+* K) := Nat.finite_of_card_ne_zero (by rw [hcard3]; omega)
  have hinj : Function.Injective (MulAut.conj : C0 σ →* MulAut (C0 σ)) := nf1_conj_injective hZ
  have hq2 : 2 ≤ ℓ ^ f := le_trans hℓ.two_le (Nat.le_self_pow (by omega) ℓ)
  have hσ3 : σ ^ 3 = 1 := triOdd_sigma_pow_three σ (ℓ ^ f) hK hσ
  have hσ1 : σ ≠ 1 := triOdd_sigma_ne_one σ (ℓ ^ f) hq2 hK hσ
  have hσ2 : σ ^ 2 ≠ 1 := nf1_sq_ne_one σ hσ3 hσ1
  have hτ3 : tauAut σ ^ 3 = 1 := triOdd_tauAut_pow_three σ hσ3
  obtain ⟨⟨g, δ⟩, hgδ⟩ := (hdec β).exists
  have hΘβ : Θ β = δ := hΘ β g δ hgδ
  have hδ3 : δ ^ 3 = 1 := by rw [← hΘβ, ← map_pow, hβ3, map_one]
  rcases mem_of_cube_eq_one_cyclic σ hσ3 hσ1 hσ2 δ hδ3 with h | h | h
  · exfalso
    apply hβout
    refine ⟨g, ?_⟩
    rw [hgδ, h, fieldActor_one, mul_one]
  · have hβeq : β = MulAut.conj g * tauAut σ := by rw [hgδ, h]
    subst hβeq
    exact exists_toral_form_of_coset hℓ hℓ2 hℓ3 hf hq hK σ hσ hinj hτ3 g hβ3 hβG
  ·
    have hβeq : β = MulAut.conj g * tauAut σ ^ 2 := by
      rw [hgδ, h, triOdd_fieldActor_pow]
    set g' : C0 σ := tauAut σ g⁻¹ with hg'
    have hβinv : β⁻¹ = MulAut.conj g' * tauAut σ := by
      have hτ2 : (tauAut σ ^ 2)⁻¹ = tauAut σ := by
        rw [inv_eq_iff_eq_inv, eq_inv_iff_mul_eq_one, ← pow_succ, hτ3]
      have hc := aut_conj_conj (tauAut σ) g⁻¹
      rw [hβeq, mul_inv_rev, hτ2, ← map_inv, hg']
      rw [← hc]
      group
    have hβ3' : (MulAut.conj g' * tauAut σ) ^ 3 = 1 := by
      rw [← hβinv, inv_pow, hβ3, inv_one]
    have hG' : ¬ TriOddIsGLine σ (MulAut.conj g' * tauAut σ) := by
      rw [← hβinv]
      rintro ⟨φ, hφ⟩
      apply hβG
      refine ⟨φ, ?_⟩
      rcases hφ with h1 | h1
      · right
        rw [← inv_inv β, show φ * β⁻¹⁻¹ * φ⁻¹ = (φ * β⁻¹ * φ⁻¹)⁻¹ by group, h1]
      · left
        rw [← inv_inv β, show φ * β⁻¹⁻¹ * φ⁻¹ = (φ * β⁻¹ * φ⁻¹)⁻¹ by group, h1, inv_inv]
    obtain ⟨s, hsβ, hs3, hsG⟩ :=
      exists_toral_form_of_coset hℓ hℓ2 hℓ3 hf hq hK σ hσ hinj hτ3 g' hβ3' hG'
    rw [← hβinv] at hsβ hsG
    have hsβ' : β s = s := by
      have := congrArg β hsβ
      rwa [MulAut.apply_inv_self, eq_comm] at this
    refine ⟨s⁻¹, by rw [map_inv, hsβ'], by rw [inv_pow, hs3, inv_one], ?_⟩
    have hcs : β * MulAut.conj s = MulAut.conj s * β := by
      have h2 := aut_conj_conj β s
      rw [hsβ'] at h2
      exact mul_inv_eq_iff_eq_mul.1 h2
    have e : (MulAut.conj s⁻¹)⁻¹ * β = ((MulAut.conj s)⁻¹ * β⁻¹)⁻¹ := by
      simp only [map_inv, inv_inv, mul_inv_rev]
      exact hcs.symm
    rw [e]
    obtain ⟨φ, hφ⟩ := hsG
    refine ⟨φ, ?_⟩
    rw [show φ * ((MulAut.conj s)⁻¹ * β⁻¹)⁻¹ * φ⁻¹ = (φ * ((MulAut.conj s)⁻¹ * β⁻¹) * φ⁻¹)⁻¹ by
      group]
    rcases hφ with h1 | h1
    · right; rw [h1]
    · left; rw [h1, inv_inv]

end NF

