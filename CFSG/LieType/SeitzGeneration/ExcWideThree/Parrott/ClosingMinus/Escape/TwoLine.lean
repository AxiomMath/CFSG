theorem phiFramePlaneGenAt_neg_three : PhiFramePlaneGenAt (-1) 3 :=
  Coordinator.phiFramePlaneGenAt_three_of_lift Coordinator.phi6ThreeLift fun r hr =>
    Coordinator.phiPlaneGenAt_neg_of_coreW hr (Inner.phi6CoreW_of_placementSome hr
      (Inner.phi6PlacementSome_holds r hr) (Inner.phi6PlacementSomeThree_holds r hr))

theorem centralizer_conj_le {G : Type*} [Group G] {H : Subgroup G} {w c : G}
    (hC : Subgroup.centralizer ({w} : Set G) ≤ H) (hc : c ∈ H) :
    Subgroup.centralizer ({c * w * c⁻¹} : Set G) ≤ H := by
  intro k hk
  rw [Subgroup.mem_centralizer_singleton_iff] at hk
  have hk' : c⁻¹ * k * c ∈ Subgroup.centralizer ({w} : Set G) := by
    rw [Subgroup.mem_centralizer_singleton_iff]
    calc c⁻¹ * k * c * w = c⁻¹ * (k * (c * w * c⁻¹)) * c := by group
      _ = c⁻¹ * ((c * w * c⁻¹) * k) * c := by rw [hk]
      _ = w * (c⁻¹ * k * c) := by group
  have e : k = c * (c⁻¹ * k * c) * c⁻¹ := by group
  rw [e]
  exact H.mul_mem (H.mul_mem hc (hC hk')) (H.inv_mem hc)

theorem twoLineGen_holds : TwoLineGen := by
  intro ℓ f hℓ hℓ2 hℓ3 hf hq K _ _ hK σ hσ x g hx3 hx1 hxX hcomm hnot H hCH hgH
  classical
  set y := g * x * g⁻¹ with hy
  have hy3 : y ^ 3 = 1 := by rw [hy, conj_pow, hx3]; group
  have hy1 : y ≠ 1 := fun h => hnot (h ▸ one_mem _)
  have hyX : TriOddIsClassX σ y := by
    obtain ⟨h, hh⟩ := hxX
    refine ⟨h * g⁻¹, ?_⟩
    rw [show h * g⁻¹ * y * (h * g⁻¹)⁻¹ = h * x * h⁻¹ by rw [hy]; group]
    exact hh
  have hxy : x * y = y * x := hcomm.symm
  have hCy : Subgroup.centralizer ({y} : Set (C0 σ)) ≤ H := centralizer_conj_le hCH hgH
  set F := Subgroup.closure ({x, y} : Set (C0 σ)) with hF
  have hxF : x ∈ F := Subgroup.subset_closure (by simp)
  have hyF : y ∈ F := Subgroup.subset_closure (by simp)
  rcases d4Minus_plane_dichotomy hℓ hℓ2 hℓ3 hf hq K hK σ hσ F
      (isElementaryAbelian_closure_pair hx3 hy3 hxy) (card_closure_pair hx3 hx1 hy3 hxy hnot) with
    hT | ⟨β, ⟨Φ, c₀, hc₀⟩, -⟩
  · exact (not_twistedTorus_of_two_classX hℓ hℓ2 hℓ3 hf hq hK σ hσ hx3 hx1 hxX hy3 hy1 hyX hnot
      hT).elim
  set ψ : MulAut (C0 σ) := MulAut.conj c₀ * β⁻¹ with hψ
  have hψapp : ∀ e, ψ e = c₀ * β⁻¹ e * c₀⁻¹ := fun e => rfl
  have hψT : ∀ e ∈ F, frameConj Φ (ψ e) ∈
      twistedTorusOf Φ.n (twistHom TwistTag.D4 (AlgebraicClosure K) Φ.Fr) := by
    intro e he
    rw [frameConj_apply, hψapp]
    exact hc₀ (β⁻¹ e) ⟨e, he, rfl⟩
  set x' := ψ x with hx'
  set y' := ψ y with hy'
  have hx'3 : x' ^ 3 = 1 := by rw [hx', ← map_pow, hx3, map_one]
  have hy'3 : y' ^ 3 = 1 := by rw [hy', ← map_pow, hy3, map_one]
  have hx'1 : x' ≠ 1 := fun h => hx1 (ψ.injective (h.trans (map_one ψ).symm))
  have hx'y' : x' * y' = y' * x' := by rw [hx', hy', ← map_mul, ← map_mul, hxy]
  have hy'x' : y' ∉ Subgroup.zpowers x' := by
    intro hmem
    apply hnot
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.1 hmem
    refine Subgroup.mem_zpowers_iff.2 ⟨n, ψ.injective ?_⟩
    rw [map_zpow, ← hx', hn]
  obtain ⟨c, hcx, hcy⟩ := exists_frame_transvection hℓ hℓ3 hf hq hK Φ (hψT x hxF) (hψT y hyF)
    hx'3 hx'1 hy'3 hy'x'
  set H' : Subgroup (C0 σ) := H.map ψ.toMonoidHom with hH'
  have hmem : ∀ k, k ∈ H' ↔ ψ⁻¹ k ∈ H := by
    intro k
    constructor
    · rintro ⟨v, hv, rfl⟩
      show ψ⁻¹ (ψ v) ∈ H
      rw [MulAut.inv_apply_self]
      exact hv
    · intro hk
      exact ⟨ψ⁻¹ k, hk, MulAut.apply_inv_self _ _ _⟩
  have hCmap : ∀ w : C0 σ, Subgroup.centralizer ({w} : Set (C0 σ)) ≤ H →
      Subgroup.centralizer ({ψ w} : Set (C0 σ)) ≤ H' := by
    intro w hw k hk
    rw [hmem]
    apply hw
    rw [Subgroup.mem_centralizer_singleton_iff] at hk ⊢
    apply ψ.injective
    rw [map_mul, map_mul, MulAut.apply_inv_self]
    exact hk
  have hCx' : Subgroup.centralizer ({x'} : Set (C0 σ)) ≤ H' := hCmap x hCH
  have hCy' : Subgroup.centralizer ({y'} : Set (C0 σ)) ≤ H' := hCmap y hCy
  have hcH' : c ∈ H' := hCx' (Subgroup.mem_centralizer_singleton_iff.2 (by
    calc c * x' = c * x' * c⁻¹ * c := by group
      _ = x' * c := by rw [hcx]))
  have hc2 : c * (c * y' * c⁻¹) * c⁻¹ = c ^ 2 * y' * (c ^ 2)⁻¹ := by rw [sq]; group
  have hcxc : ∀ w, c * (x' * w) * c⁻¹ = x' * (c * w * c⁻¹) := fun w => by
    calc c * (x' * w) * c⁻¹ = (c * x' * c⁻¹) * (c * w * c⁻¹) := by group
      _ = x' * (c * w * c⁻¹) := by rw [hcx]
  have hcxc' : ∀ w, c * (x'⁻¹ * w) * c⁻¹ = x'⁻¹ * (c * w * c⁻¹) := fun w => by
    calc c * (x'⁻¹ * w) * c⁻¹ = (c * x' * c⁻¹)⁻¹ * (c * w * c⁻¹) := by group
      _ = x'⁻¹ * (c * w * c⁻¹) := by rw [hcx]
  have hxinv : x'⁻¹ = x' ^ 2 := by
    rw [inv_eq_iff_mul_eq_one, ← pow_succ', hx'3]
  have hlines : Subgroup.centralizer ({x' * y'} : Set (C0 σ)) ≤ H' ∧
      Subgroup.centralizer ({x' ^ 2 * y'} : Set (C0 σ)) ≤ H' := by
    have h1 := centralizer_conj_le hCy' hcH'
    have h2 := centralizer_conj_le h1 hcH'
    rcases hcy with h | h
    · rw [h] at h1
      rw [h, hcxc, h, ← mul_assoc, ← sq] at h2
      exact ⟨h1, h2⟩
    · rw [h, hxinv] at h1
      rw [h, hcxc', h, ← mul_assoc, hxinv, ← pow_add,
        show x' ^ (2 + 2) = x' by rw [show 2 + 2 = 3 + 1 from rfl, pow_add, hx'3, one_mul,
          pow_one]] at h2
      exact ⟨h2, h1⟩
  set F' := Subgroup.closure ({x', y'} : Set (C0 σ)) with hF'
  have hF'T : F' ≤ (twistedTorusOf Φ.n (twistHom TwistTag.D4 (AlgebraicClosure K) Φ.Fr)).comap
      (frameConj Φ) := by
    rw [hF', Subgroup.closure_le]
    rintro _ (rfl | rfl)
    · exact hψT x hxF
    · exact hψT y hyF
  have hdvd : (3 : ℤ) ∣ ((ℓ ^ f : ℕ) : ℤ) ^ 2 + (-1) * ((ℓ ^ f : ℕ) : ℤ) + 1 := by
    obtain ⟨k, hk⟩ : ∃ k, ℓ ^ f = 3 * k + 2 := ⟨ℓ ^ f / 3, by omega⟩
    rw [hk]
    exact ⟨3 * k ^ 2 + 3 * k + 1, by push_cast; ring⟩
  have hgen := phiFramePlaneGenAt_neg_three ℓ f hℓ hℓ2 hf K hK σ hσ Nat.prime_three
    (Ne.symm hℓ3) hdvd F' (isElementaryAbelian_closure_pair hx'3 hy'3 hx'y')
    (card_closure_pair hx'3 hx'1 hy'3 hx'y' hy'x') ⟨Φ, 1, fun e he => by
      have := hF'T he
      rw [Subgroup.mem_comap, frameConj_apply] at this
      rw [one_mul, inv_one, mul_one]
      exact this⟩
  have htop : H' = ⊤ := by
    rw [eq_top_iff, ← hgen, Subgroup.closure_le]
    rintro k ⟨e, he, he1, hke⟩
    exact centralizer_le_of_mem_closure_pair hx'3 hy'3 hx'y' hCx' hCy' hlines.1 hlines.2 he he1
      (Subgroup.mem_centralizer_singleton_iff.2 hke)
  rw [eq_top_iff]
  intro w _
  have hw : ψ w ∈ H' := by rw [htop]; exact Subgroup.mem_top _
  rw [hmem, MulAut.inv_apply_self] at hw
  exact hw

end Gen

