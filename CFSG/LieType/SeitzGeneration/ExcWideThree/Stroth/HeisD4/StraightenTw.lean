section NegRho

abbrev twE6Rho : Equiv.Perm (Fin Tag.E6.rank) := TwistTag.E6.perm

abbrev twDelta : WeylGroup Tag.E6 ≃* WeylGroup Tag.E6 := weylTwist TwistTag.E6

abbrev twNeg : WeylGroup Tag.E6 := CFSG.RankThree.Chevalley.e6HRReflProd

theorem twNeg_smul (x : Fin Tag.E6.rank → ℤ) : twNeg • x = -permLattice twE6Rho x :=
  CFSG.RankThree.Chevalley.e6HRReflProd_smul x

theorem twE6Rho_symm : twE6Rho.symm = twE6Rho := by decide

theorem permLattice_twE6Rho_twice (x : Fin Tag.E6.rank → ℤ) :
    permLattice twE6Rho (permLattice twE6Rho x) = x := by
  have h := permLattice_permLattice_symm twE6Rho x
  rwa [twE6Rho_symm] at h

theorem twNeg_smul_perm (x : Fin Tag.E6.rank → ℤ) : twNeg • permLattice twE6Rho x = -x := by
  rw [twNeg_smul, permLattice_twE6Rho_twice]

theorem twNeg_inv_smul (x : Fin Tag.E6.rank → ℤ) : twNeg⁻¹ • x = -permLattice twE6Rho x := by
  have h : twNeg • (-permLattice twE6Rho x) = x := by
    rw [smul_neg, twNeg_smul_perm, neg_neg]
  calc twNeg⁻¹ • x = twNeg⁻¹ • (twNeg • (-permLattice twE6Rho x)) := by rw [h]
    _ = -permLattice twE6Rho x := inv_smul_smul _ _

theorem twDelta_smul (w : WeylGroup Tag.E6) (v : Fin Tag.E6.rank → ℤ) :
    twDelta w • v = permLattice twE6Rho (w • permLattice twE6Rho.symm v) :=
  weylTwist_smul TwistTag.E6 w v

theorem twDelta_eq_conj (w : WeylGroup Tag.E6) : twDelta w = twNeg * w * twNeg⁻¹ := by
  refine FaithfulSMul.eq_of_smul_eq_smul (α := Fin Tag.E6.rank → ℤ) fun v => ?_
  rw [twDelta_smul, twE6Rho_symm, mul_smul, mul_smul, twNeg_inv_smul, smul_neg, smul_neg, twNeg_smul,
    neg_neg]

end NegRho

section Frobenius

variable {L : Type} [Field L]

@[expose] def twistHomE6 (Fr : L →+* L) : ModGL Tag.E6 L →* ModGL Tag.E6 L :=
  twistHom TwistTag.E6 L Fr

@[expose] def twFrobE6 (n : ModGL Tag.E6 L) (Fr : L →+* L) : ModGL Tag.E6 L →* ModGL Tag.E6 L :=
  twFrob TwistTag.E6 n Fr

theorem twFrobE6_apply (n : ModGL Tag.E6 L) (Fr : L →+* L) (g : ModGL Tag.E6 L) :
    twFrobE6 n Fr g = n * twistHomE6 Fr g * n⁻¹ :=
  rfl

theorem twFrobE6_mul_left (c n : ModGL Tag.E6 L) (Fr : L →+* L) (g : ModGL Tag.E6 L) :
    twFrobE6 (c * n) Fr g = c * twFrobE6 n Fr g * c⁻¹ := by
  simp only [twFrobE6_apply, mul_inv_rev, mul_assoc]

theorem twistHomE6_canonicalRep (Fr : L →+* L) (w : WeylGroup Tag.E6) :
    twistHomE6 Fr (canonicalRep (coxeterSystem Tag.E6) L w) =
      canonicalRep (coxeterSystem Tag.E6) L (twDelta w) :=
  twistHom_canonicalRep TwistTag.E6 L Fr w

theorem twistHomE6_rootDiagUnit (Fr : L →+* L) (b : Fin Tag.E6.rank → Lˣ) :
    twistHomE6 Fr (rootDiagUnit Tag.E6 b) =
      rootDiagUnit Tag.E6 (fun i => Units.map Fr.toMonoidHom (b (twE6Rho.symm i))) :=
  twistHom_rootDiagUnit_eq (t := TwistTag.E6) (σ := Fr) b

theorem twFrobE6_rootDiagUnit (Fr : L →+* L) (v : WeylGroup Tag.E6) (b : Fin Tag.E6.rank → Lˣ) :
    twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L v) Fr (rootDiagUnit Tag.E6 b) =
      rootDiagUnit Tag.E6 (weylTuple v fun i => Units.map Fr.toMonoidHom (b (twE6Rho.symm i))) :=
  twFrob_rootDiagUnit TwistTag.E6 Fr v b

theorem map_twFrobE6_rootSubgroup {Fr : L →+* L} (hFr : Function.Surjective Fr)
    (v : WeylGroup Tag.E6) {β : Fin Tag.E6.rank → ℤ} (hβ : IsRoot Tag.E6 β) :
    (rootSubgroup Tag.E6 L β).map (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L v) Fr) =
      rootSubgroup Tag.E6 L (v • permLattice twE6Rho β) :=
  map_twFrob_rootSubgroup TwistTag.E6 hFr v hβ

theorem map_twFrobE6_rootSpan {Fr : L →+* L} (hFr : Function.Surjective Fr)
    (v : WeylGroup Tag.E6) {S : Set (Fin Tag.E6.rank → ℤ)} (hS : ∀ α ∈ S, IsRoot Tag.E6 α) :
    (rootSpan Tag.E6 L S).map (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L v) Fr) =
      rootSpan Tag.E6 L ((fun α => v • permLattice twE6Rho α) '' S) :=
  map_twFrob_rootSpan TwistTag.E6 hFr v hS

theorem heisTw_rootChar_neg {a : Fin Tag.E6.rank → Lˣ} (v : Fin Tag.E6.rank → ℤ) :
    rootChar a (-v) = (rootChar a v)⁻¹ := by
  rw [show -v = (-1 : ℤ) • v by simp, rootChar_zsmul, zpow_neg_one]

theorem twFrobE6_negNeg_rootDiagUnit (Fr : L →+* L) (b : Fin Tag.E6.rank → Lˣ) :
    twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L twNeg) Fr (rootDiagUnit Tag.E6 b) =
      rootDiagUnit Tag.E6 (fun i => (Units.map Fr.toMonoidHom (b i))⁻¹) := by
  rw [twFrobE6_rootDiagUnit]
  congr 1
  funext i
  simp only [weylTuple]
  rw [twNeg_inv_smul, permLattice_single, heisTw_rootChar_neg, CTTorus.rootChar_single]
  simp

theorem map_twFrobE6_negNeg_rootSubgroup {Fr : L →+* L} (hFr : Function.Surjective Fr)
    {β : Fin Tag.E6.rank → ℤ} (hβ : IsRoot Tag.E6 β) :
    (rootSubgroup Tag.E6 L β).map (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L twNeg) Fr) =
      rootSubgroup Tag.E6 L (-β) := by
  rw [map_twFrobE6_rootSubgroup hFr twNeg hβ, twNeg_smul_perm]

theorem twFrobE6_canonicalRep_mul_negNeg_rootDiagUnit (Fr : L →+* L) (u : WeylGroup Tag.E6)
    (b : Fin Tag.E6.rank → Lˣ) :
    twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L u * canonicalRep (coxeterSystem Tag.E6) L twNeg)
        Fr (rootDiagUnit Tag.E6 b) =
      rootDiagUnit Tag.E6 (weylTuple u fun i => (Units.map Fr.toMonoidHom (b i))⁻¹) := by
  rw [twFrobE6_mul_left, twFrobE6_negNeg_rootDiagUnit, canonicalRep_conj_rootDiagUnit]

theorem map_twFrobE6_canonicalRep_mul_negNeg_rootSubgroup {Fr : L →+* L}
    (hFr : Function.Surjective Fr) (u : WeylGroup Tag.E6) {β : Fin Tag.E6.rank → ℤ}
    (hβ : IsRoot Tag.E6 β) :
    (rootSubgroup Tag.E6 L β).map (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L u *
        canonicalRep (coxeterSystem Tag.E6) L twNeg) Fr) = rootSubgroup Tag.E6 L (u • -β) := by
  have e : twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L u *
      canonicalRep (coxeterSystem Tag.E6) L twNeg) Fr =
        (MulAut.conj (canonicalRep (coxeterSystem Tag.E6) L u)).toMonoidHom.comp
          (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L twNeg) Fr) :=
    MonoidHom.ext fun g => twFrobE6_mul_left _ _ _ g
  rw [e, ← Subgroup.map_map, map_twFrobE6_negNeg_rootSubgroup hFr hβ]
  exact (canonical_weyl_root_transport Tag.E6 L).2.1 u _ (CFSG.LieType.Chevalley.IsRoot.neg hβ)

end Frobenius

section HeisM

variable {L : Type} [Field L] [IsAlgClosed L]

theorem image_twNeg_familyKernel {ι : Type} (a : ι → Fin Tag.E6.rank → Lˣ) :
    (fun α => twNeg • permLattice twE6Rho α) '' familyKernel a = familyKernel a := by
  simp only [twNeg_smul_perm]
  ext β
  constructor
  · rintro ⟨α, hα, rfl⟩
    exact neg_mem_familyKernel a hα
  · intro hβ
    exact ⟨-β, neg_mem_familyKernel a hβ, neg_neg β⟩

theorem map_twFrobE6_heisM {Fr : L →+* L} (hFr : Function.Surjective Fr) (v : WeylGroup Tag.E6)
    (a : Fin Tag.E6.rank → Lˣ)
    (himg : (fun α => v • permLattice twE6Rho α) '' familyKernel (fun _ : Unit => a) =
      familyKernel (fun _ : Unit => a)) :
    (heisM a).map (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L v) Fr) = heisM a := by
  show (torusGroup Tag.E6 L ⊔ rootSpan Tag.E6 L (familyKernel (fun _ : Unit => a))).map _ = _
  rw [Subgroup.map_sup]
  have hT : (torusGroup Tag.E6 L).map (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L v) Fr) =
      torusGroup Tag.E6 L := by
    have h1 : (torusGroup Tag.E6 L).map (twistHomE6 Fr) = torusGroup Tag.E6 L :=
      map_twistHom_torusGroup TwistTag.E6 L hFr
    have h2 : twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L v) Fr =
        (MulAut.conj (canonicalRep (coxeterSystem Tag.E6) L v)).toMonoidHom.comp (twistHomE6 Fr) :=
      rfl
    rw [h2, ← Subgroup.map_map, h1]
    exact map_conj_eq_of_mem_normalizer (canonicalRep_mem_normalizer (R := L) v)
  have hS := map_twFrobE6_rootSpan hFr v (S := familyKernel (fun _ : Unit => a))
    (fun α hα => hα.1)
  rw [himg] at hS
  rw [hT, hS]
  rfl

theorem map_twFrobE6_negNeg_heisM {Fr : L →+* L} (hFr : Function.Surjective Fr)
    (a : Fin Tag.E6.rank → Lˣ) :
    (heisM a).map (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L twNeg) Fr) = heisM a :=
  map_twFrobE6_heisM hFr twNeg a (image_twNeg_familyKernel _)

theorem map_twFrobE6_heisM_of_mem {Fr : L →+* L} (hFr : Function.Surjective Fr)
    {a : Fin Tag.E6.rank → Lˣ} {c₀ : ModGL Tag.E6 L} (hc₀ : c₀ ∈ heisM a) :
    (heisM a).map (twFrobE6 (c₀ * canonicalRep (coxeterSystem Tag.E6) L twNeg) Fr) =
      heisM a := by
  have e : twFrobE6 (c₀ * canonicalRep (coxeterSystem Tag.E6) L twNeg) Fr =
      (MulAut.conj c₀).toMonoidHom.comp
        (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L twNeg) Fr) :=
    MonoidHom.ext fun g => twFrobE6_mul_left _ _ _ g
  rw [e, ← Subgroup.map_map, map_twFrobE6_negNeg_heisM hFr a]
  exact map_conj_eq_of_mem_normalizer (Subgroup.le_normalizer hc₀)

end HeisM

section Lang

variable {L : Type} [Field L] [IsAlgClosed L]

@[expose] def diagramMapE6 (L : Type) [Field L] : ModGL Tag.E6 L := diagramMap TwistTag.E6 L

theorem twistHomE6_apply (Fr : L →+* L) (g : ModGL Tag.E6 L) :
    twistHomE6 Fr g = diagramMapE6 L * Units.map (entrywiseHom Fr) g * (diagramMapE6 L)⁻¹ :=
  twistHom_apply (t := TwistTag.E6) Fr g

theorem frobTwistGL_diagramMapE6 {ℓ : ℕ} [Fact ℓ.Prime] [CharP L ℓ] (f : ℕ) (n g : ModGL Tag.E6 L) :
    frobTwistGL Tag.E6 L ℓ f (n * diagramMapE6 L) g = twFrobE6 n (iterateFrobenius L ℓ f) g := by
  rw [frobTwistGL_apply, twFrobE6_apply, twistHomE6_apply]
  group

theorem iterateFrobenius_surjective {ℓ : ℕ} [Fact ℓ.Prime] [CharP L ℓ] (f : ℕ) (hf : 1 ≤ f) :
    Function.Surjective (iterateFrobenius L ℓ f) := fun y => by
  obtain ⟨x, hx⟩ := IsAlgClosed.exists_pow_nat_eq y (pow_pos (Fact.out : ℓ.Prime).pos f)
  exact ⟨x, by rw [iterateFrobenius_def, hx]⟩

theorem lang_twFrobE6 {ℓ : ℕ} [Fact ℓ.Prime] [CharP L ℓ] {f : ℕ} (hf : 1 ≤ f)
    {a : Fin Tag.E6.rank → Lˣ} {c₀ : ModGL Tag.E6 L} (hc₀ : c₀ ∈ heisM a) :
    ∀ c ∈ heisM a, ∃ z ∈ heisM a,
      twFrobE6 (c₀ * canonicalRep (coxeterSystem Tag.E6) L twNeg) (iterateFrobenius L ℓ f) z =
        z * c := by
  intro c hc
  have hM := map_twFrobE6_heisM_of_mem (iterateFrobenius_surjective (L := L) (ℓ := ℓ) f hf) hc₀
  obtain ⟨z, hz, hzc⟩ := lang_familyGroup_of_mapsTo ℓ (fun _ : Unit => a) f hf
    ((c₀ * canonicalRep (coxeterSystem Tag.E6) L twNeg) * diagramMapE6 L) (fun g hg => by
      rw [frobTwistGL_diagramMapE6]
      have hmem := Subgroup.mem_map_of_mem
        (twFrobE6 (c₀ * canonicalRep (coxeterSystem Tag.E6) L twNeg) (iterateFrobenius L ℓ f)) hg
      rw [hM] at hmem
      exact hmem) c hc
  refine ⟨z, hz, ?_⟩
  have h2 := frobTwistGL_diagramMapE6 (ℓ := ℓ) f (c₀ * canonicalRep (coxeterSystem Tag.E6) L twNeg) z
  rw [frobTwistGL_apply] at h2
  rw [← h2, ← hzc]
  group

end Lang

section Chars

variable {L : Type} [Field L]

theorem twNeg_inv : twNeg⁻¹ = twNeg :=
  FaithfulSMul.eq_of_smul_eq_smul (α := Fin Tag.E6.rank → ℤ) fun v => by
    rw [twNeg_inv_smul, twNeg_smul]

theorem twNeg_mul_self : twNeg * twNeg = 1 := by
  have h := mul_inv_cancel twNeg
  rwa [twNeg_inv] at h

theorem twDelta_eq_conj' (w : WeylGroup Tag.E6) : twDelta w = twNeg * w * twNeg := by
  rw [twDelta_eq_conj, twNeg_inv]

theorem twE6Rho_cartan (i j : Fin Tag.E6.rank) :
    Tag.E6.cartan (twE6Rho i) (twE6Rho j) = Tag.E6.cartan i j :=
  TwistTag.E6.cartan_perm i j

theorem isRoot_permLattice_twE6Rho {v : Fin Tag.E6.rank → ℤ} (hv : IsRoot Tag.E6 v) :
    IsRoot Tag.E6 (permLattice twE6Rho v) :=
  hv.permLattice twE6Rho_cartan

theorem isRoot_permLattice_twE6Rho_symm {v : Fin Tag.E6.rank → ℤ} (hv : IsRoot Tag.E6 v) :
    IsRoot Tag.E6 (permLattice twE6Rho.symm v) :=
  hv.permLattice (cartan_perm_symm twE6Rho_cartan)

theorem units_map_iterateFrobenius {ℓ : ℕ} [Fact ℓ.Prime] [CharP L ℓ] (f : ℕ) (x : Lˣ) :
    Units.map (iterateFrobenius L ℓ f).toMonoidHom x = x ^ (ℓ ^ f) :=
  Units.ext (by simp [iterateFrobenius_def])

theorem inv_pow_eq_pow_two_mul {x : Lˣ} (hx : x ^ 3 = 1) (n : ℕ) : (x ^ n)⁻¹ = x ^ (2 * n) := by
  refine inv_eq_of_mul_eq_one_right ?_
  rw [← pow_add, show n + 2 * n = 3 * n by ring, pow_mul, hx, one_pow]

theorem rootChar_twFrobE6 {Fr : L →+* L} {a : Fin Tag.E6.rank → Lˣ} {w' : WeylGroup Tag.E6}
    (hT : twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w') Fr (rootDiagUnit Tag.E6 a) =
      rootDiagUnit Tag.E6 a) (v : Fin Tag.E6.rank → ℤ) :
    rootChar a (w' • permLattice twE6Rho v) = Units.map Fr.toMonoidHom (rootChar a v) := by
  have h1 : rootDiagUnit Tag.E6 a = canonicalRep (coxeterSystem Tag.E6) L w' *
      rootDiagUnit Tag.E6 (fun i => Units.map Fr.toMonoidHom (a (twE6Rho.symm i))) *
        (canonicalRep (coxeterSystem Tag.E6) L w')⁻¹ := by
    rw [← twistHomE6_rootDiagUnit, ← twFrobE6_apply]
    exact hT.symm
  have h2 := (rootDiagUnit_eq_conj_canonicalRep_iff _ _ w').1 h1 (permLattice twE6Rho v)
  rw [h2, rootChar_map_tuple Fr (fun i => a (twE6Rho.symm i)) (permLattice twE6Rho v),
    ← rootChar_permLattice a twE6Rho.symm, permLattice_symm_permLattice]

theorem rootChar_mul_twNeg {a : Fin Tag.E6.rank → Lˣ} {w' : WeylGroup Tag.E6} {n : ℕ}
    (h : ∀ v, rootChar a (w' • permLattice twE6Rho v) = rootChar a v ^ n)
    (v : Fin Tag.E6.rank → ℤ) :
    rootChar a ((w' * twNeg) • v) = (rootChar a v ^ n)⁻¹ := by
  rw [mul_smul, twNeg_smul, smul_neg, heisTw_rootChar_neg, h]

theorem image_twist_familyKernel {a : Fin Tag.E6.rank → Lˣ} (ha3 : ∀ i, a i ^ 3 = 1)
    {w' : WeylGroup Tag.E6} {n : ℕ} (hn : Nat.Coprime 3 n)
    (h : ∀ v, rootChar a (w' • permLattice twE6Rho v) = rootChar a v ^ n) :
    (fun α => w' • permLattice twE6Rho α) '' familyKernel (fun _ : Unit => a) =
      familyKernel (fun _ : Unit => a) := by
  have key : ∀ x : Lˣ, x ^ 3 = 1 → x ^ n = 1 → x = 1 := fun x h1 h2 => by
    have h := Nat.dvd_gcd (orderOf_dvd_of_pow_eq_one h1) (orderOf_dvd_of_pow_eq_one h2)
    rw [hn] at h
    exact orderOf_eq_one_iff.1 (Nat.dvd_one.1 h)
  ext β
  constructor
  · rintro ⟨α, ⟨hα, hχ⟩, rfl⟩
    refine ⟨IsRoot.smul (isRoot_permLattice_twE6Rho hα) w', fun s => ?_⟩
    show rootChar a (w' • permLattice twE6Rho α) = 1
    rw [h, hχ (), one_pow]
  · rintro ⟨hβ, hχ⟩
    refine ⟨permLattice twE6Rho.symm (w'⁻¹ • β),
      ⟨isRoot_permLattice_twE6Rho_symm (IsRoot.smul hβ w'⁻¹), fun s => ?_⟩, ?_⟩
    · have h1 := h (permLattice twE6Rho.symm (w'⁻¹ • β))
      rw [permLattice_permLattice_symm, smul_inv_smul, hχ ()] at h1
      exact key _ (CTTorus.rootChar_pow_eq_one ha3 _) h1.symm
    · show w' • permLattice twE6Rho (permLattice twE6Rho.symm (w'⁻¹ • β)) = β
      rw [permLattice_permLattice_symm, smul_inv_smul]

end Chars

section TrivialOnWeyl

variable {L : Type} [Field L]

theorem twFrobE6_negNeg_canonicalRep (Fr : L →+* L) (v : WeylGroup Tag.E6) :
    ∃ t ∈ torusGroup Tag.E6 L,
      twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L twNeg) Fr
        (canonicalRep (coxeterSystem Tag.E6) L v) = t * canonicalRep (coxeterSystem Tag.E6) L v := by
  have hmono : twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L twNeg) Fr
      (canonicalRep (coxeterSystem Tag.E6) L v) ∈ monomialSubgroup Tag.E6 L := by
    rw [twFrobE6_apply, twistHomE6_canonicalRep]
    exact mul_mem (mul_mem (canonicalRep_mem_monomialSubgroup' _)
      (canonicalRep_mem_monomialSubgroup' _)) (inv_mem (canonicalRep_mem_monomialSubgroup' _))
  have hmaps : MapsRootLines (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L twNeg) Fr
      (canonicalRep (coxeterSystem Tag.E6) L v)) v := by
    rw [twFrobE6_apply, twistHomE6_canonicalRep]
    have h := ((mapsRootLines_canonicalRep (R := L) twNeg).mul
      (mapsRootLines_canonicalRep (R := L) (twDelta v))).mul
        (mapsRootLines_canonicalRep (R := L) twNeg).inv
    have e : twNeg * twDelta v * twNeg⁻¹ = v := by
      rw [twDelta_eq_conj', twNeg_inv]
      calc twNeg * (twNeg * v * twNeg) * twNeg = (twNeg * twNeg) * v * (twNeg * twNeg) := by group
        _ = v := by rw [twNeg_mul_self]; group
    rwa [e] at h
  obtain ⟨x', t, ht, hg⟩ := exists_torus_mul_canonicalRep_of_mem_monomial hmono
  have h1 : MapsRootLines (t * canonicalRep (coxeterSystem Tag.E6) L x') (1 * x') :=
    (mapsRootLines_of_mem_torusGroup ht).mul (mapsRootLines_canonicalRep x')
  rw [one_mul, ← hg] at h1
  have e := hmaps.unique h1
  subst e
  exact ⟨t, ht, hg⟩

end TrivialOnWeyl

section Commutator

variable {L : Type} [Field L] [IsAlgClosed L]

theorem commutator_mem_kernel_gen {a : Fin Tag.E6.rank → Lˣ} {Φ : ModGL Tag.E6 L →* ModGL Tag.E6 L}
    (hΦM : ∀ g ∈ heisM a, Φ g ∈ heisM a) {y₀ u : ModGL Tag.E6 L} (hu : u ∈ heisM a)
    (hy₀N : y₀ ∈ Subgroup.normalizer (heisM a : Set (ModGL Tag.E6 L)))
    (hy : Φ (u⁻¹ * y₀ * u) = u⁻¹ * y₀ * u) {κ : WeylGroup Tag.E6}
    (hmono : Φ y₀ * y₀⁻¹ ∈ monomialSubgroup Tag.E6 L)
    (hmaps : MapsRootLines (Φ y₀ * y₀⁻¹) κ) : κ ∈ kernelReflectionGroup a := by
  set m' := Φ u * u⁻¹ with hm'
  have hm'M : m' ∈ heisM a := mul_mem (hΦM u hu) (inv_mem hu)
  have hΦy₀ : Φ y₀ = m' * y₀ * m'⁻¹ := by
    have h := hy
    simp only [map_mul, map_inv] at h
    calc Φ y₀ = Φ u * ((Φ u)⁻¹ * Φ y₀ * Φ u) * (Φ u)⁻¹ := by group
      _ = Φ u * (u⁻¹ * y₀ * u) * (Φ u)⁻¹ := by rw [h]
      _ = m' * y₀ * m'⁻¹ := by rw [hm']; group
  have hg₀M : Φ y₀ * y₀⁻¹ ∈ heisM a := by
    rw [hΦy₀]
    have : m' * y₀ * m'⁻¹ * y₀⁻¹ = m' * (y₀ * m'⁻¹ * y₀⁻¹) := by group
    rw [this]
    exact mul_mem hm'M ((Subgroup.mem_normalizer_iff.1 hy₀N _).1 (inv_mem hm'M))
  exact mem_kernelReflectionGroup_of_mapsRootLines hmono hmaps hg₀M

theorem twFrobE6_rootDiag_mul_canonicalRep_facts (Fr : L →+* L) (b : Fin Tag.E6.rank → Lˣ)
    (w w' : WeylGroup Tag.E6) :
    twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w') Fr
        (rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w) *
        (rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w)⁻¹ ∈
      monomialSubgroup Tag.E6 L ∧
    MapsRootLines (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w') Fr
        (rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w) *
        (rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w)⁻¹)
      (w' * (1 * twDelta w) * w'⁻¹ * (1 * w)⁻¹) := by
  have hd : ∀ t ∈ torusGroup Tag.E6 L, t ∈ monomialSubgroup Tag.E6 L := fun t ht =>
    Subgroup.mem_sup_left ht
  have hΦ : twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w') Fr
      (rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w) =
      canonicalRep (coxeterSystem Tag.E6) L w' *
        (rootDiagUnit Tag.E6 (fun i => Units.map Fr.toMonoidHom (b (twE6Rho.symm i))) *
          canonicalRep (coxeterSystem Tag.E6) L (twDelta w)) *
        (canonicalRep (coxeterSystem Tag.E6) L w')⁻¹ := by
    rw [twFrobE6_apply, map_mul, twistHomE6_rootDiagUnit, twistHomE6_canonicalRep]
  rw [hΦ]
  have h1 : canonicalRep (coxeterSystem Tag.E6) L w' ∈ monomialSubgroup Tag.E6 L :=
    canonicalRep_mem_monomialSubgroup' w'
  have h2 : rootDiagUnit Tag.E6 (fun i => Units.map Fr.toMonoidHom (b (twE6Rho.symm i))) *
      canonicalRep (coxeterSystem Tag.E6) L (twDelta w) ∈ monomialSubgroup Tag.E6 L :=
    mul_mem (hd _ (rootDiagUnit_mem_torusGroup _)) (canonicalRep_mem_monomialSubgroup' _)
  have h3 : rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w ∈
      monomialSubgroup Tag.E6 L :=
    mul_mem (hd _ (rootDiagUnit_mem_torusGroup b)) (canonicalRep_mem_monomialSubgroup' w)
  refine ⟨mul_mem (mul_mem h1 (mul_mem h2 (inv_mem h1))) (inv_mem h3) |> fun h => by
    simpa [mul_assoc] using h, ?_⟩
  have m1 : MapsRootLines (canonicalRep (coxeterSystem Tag.E6) L w') w' :=
    mapsRootLines_canonicalRep w'
  have m2 : MapsRootLines (rootDiagUnit Tag.E6
      (fun i => Units.map Fr.toMonoidHom (b (twE6Rho.symm i))) *
        canonicalRep (coxeterSystem Tag.E6) L (twDelta w)) (1 * twDelta w) :=
    (mapsRootLines_of_mem_torusGroup (rootDiagUnit_mem_torusGroup _)).mul
      (mapsRootLines_canonicalRep (twDelta w))
  have m3 : MapsRootLines (rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w)
      (1 * w) :=
    (mapsRootLines_of_mem_torusGroup (rootDiagUnit_mem_torusGroup b)).mul
      (mapsRootLines_canonicalRep w)
  exact ((m1.mul m2).mul m1.inv).mul m3.inv

end Commutator

section Core

variable {L : Type} [Field L] [IsAlgClosed L] {ℓ : ℕ} [Fact ℓ.Prime] [CharP L ℓ]

theorem twHeis_straighten_core {f : ℕ} (hf : 1 ≤ f) (hℓ3 : ℓ ≠ 3)
    {a b : Fin Tag.E6.rank → Lˣ} (ha3 : ∀ i, a i ^ 3 = 1)
    {w w' : WeylGroup Tag.E6} (hw : w ∈ rootCharStabilizer a)
    (hsh : rootChar a (e6Shift w) ≠ 1) {u y : ModGL Tag.E6 L} (hu : u ∈ heisM a)
    (hyd : y = u⁻¹ * (rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w) * u)
    (hT : twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w') (iterateFrobenius L ℓ f)
      (rootDiagUnit Tag.E6 a) = rootDiagUnit Tag.E6 a)
    (hy : twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w') (iterateFrobenius L ℓ f) y = y)
    {c₀ : ModGL Tag.E6 L} (hc₀ : c₀ ∈ heisM a) :
    ((ℓ ^ f : ℕ) : ZMod 3) = -1 ∧ ∃ (j : ℕ) (z : ModGL Tag.E6 L), z ∈ heisM a ∧
      twFrobE6 (c₀ * canonicalRep (coxeterSystem Tag.E6) L twNeg) (iterateFrobenius L ℓ f) z =
        z * (y ^ j * (canonicalRep (coxeterSystem Tag.E6) L w' *
          (c₀ * canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹)) ∧
      twFrobE6 (c₀ * canonicalRep (coxeterSystem Tag.E6) L twNeg) (iterateFrobenius L ℓ f)
        (z * y * z⁻¹) = z * y * z⁻¹ ∧
      z * y * z⁻¹ ∈ Subgroup.normalizer (heisM a : Set (ModGL Tag.E6 L)) ∧
      (∃ m ∈ heisM a, z * y * z⁻¹ = m * canonicalRep (coxeterSystem Tag.E6) L w) ∧
      ∀ x ∈ heisM a,
        twFrobE6 (c₀ * canonicalRep (coxeterSystem Tag.E6) L twNeg) (iterateFrobenius L ℓ f) x =
          x → Commute x (z * y * z⁻¹) →
        twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w') (iterateFrobenius L ℓ f)
          (z⁻¹ * x * z) = z⁻¹ * x * z := by
  classical
  have hFrs : Function.Surjective (iterateFrobenius L ℓ f) :=
    iterateFrobenius_surjective (L := L) (ℓ := ℓ) f hf
  obtain ⟨b3, hker⟩ := exists_triData_lattice ha3
  obtain ⟨hS, hKW, hχ⟩ := kernel_facts hker
  have hrel : ∀ v, rootChar a (w' • permLattice twE6Rho v) = rootChar a v ^ (ℓ ^ f) := fun v => by
    rw [rootChar_twFrobE6 hT v, units_map_iterateFrobenius]
  have hcop : Nat.Coprime 3 (ℓ ^ f) :=
    Nat.Coprime.pow_right f ((Nat.coprime_primes Nat.prime_three Fact.out).2 (Ne.symm hℓ3))
  have hΦM : (heisM a).map (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w')
      (iterateFrobenius L ℓ f)) = heisM a :=
    map_twFrobE6_heisM hFrs w' a (image_twist_familyKernel ha3 hcop hrel)
  have hΦM' : ∀ g ∈ heisM a, twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w')
      (iterateFrobenius L ℓ f) g ∈ heisM a := fun g hg => by
    have := Subgroup.mem_map_of_mem (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w')
      (iterateFrobenius L ℓ f)) hg
    rwa [hΦM] at this
  have hnw : canonicalRep (coxeterSystem Tag.E6) L w ∈
      Subgroup.normalizer (heisM a : Set (ModGL Tag.E6 L)) :=
    canonicalRep_mem_normalizer_familyGroup (a := fun _ : Unit => a) (fun _ => hw)
  have hdb : rootDiagUnit Tag.E6 b ∈ heisM a := torus_le_heisM a (rootDiagUnit_mem_torusGroup b)
  have hy₀N : rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w ∈
      Subgroup.normalizer (heisM a : Set (ModGL Tag.E6 L)) :=
    mul_mem (Subgroup.le_normalizer hdb) hnw
  have hy' : twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w') (iterateFrobenius L ℓ f)
      (u⁻¹ * (rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w) * u) =
        u⁻¹ * (rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w) * u := by
    rw [← hyd]
    exact hy
  obtain ⟨hmono, hmaps⟩ := twFrobE6_rootDiag_mul_canonicalRep_facts (iterateFrobenius L ℓ f) b w w'
  have hcomm0 := commutator_mem_kernel_gen hΦM' hu hy₀N hy' hmono hmaps
  have hcomm : (w' * twNeg) * w * (w' * twNeg)⁻¹ * w⁻¹ ∈ kernelWeylGroup (triChar b3) := by
    rw [← hKW]
    have e : w' * (1 * twDelta w) * w'⁻¹ * (1 * w)⁻¹ =
        (w' * twNeg) * w * (w' * twNeg)⁻¹ * w⁻¹ := by
      rw [one_mul, one_mul, twDelta_eq_conj', mul_inv_rev, twNeg_inv]
      group
    rwa [e] at hcomm0
  have hsh3 : triPairing b3 (e6Shift w) ≠ 0 := (not_congr (hχ _)).1 hsh
  have hrel2 : ∀ v, rootChar a ((w' * twNeg) • v) = rootChar a v ^ (2 * ℓ ^ f) := fun v => by
    rw [rootChar_mul_twNeg hrel v, inv_pow_eq_pow_two_mul (CTTorus.rootChar_pow_eq_one ha3 v)]
  have hrel3 := triPairing_frob_rel hker hrel2
  have hq2 : ((2 * ℓ ^ f : ℕ) : ZMod 3) = 1 :=
    q_eq_one_of_commutator ((hS w).1 hw) hsh3 hrel3 hcomm
  have hq : ((ℓ ^ f : ℕ) : ZMod 3) = -1 := by
    have h3 : ∀ x : ZMod 3, 2 * x = 1 → x = -1 := by decide
    have e : ((2 * ℓ ^ f : ℕ) : ZMod 3) = 2 * ((ℓ ^ f : ℕ) : ZMod 3) := by
      push_cast
      ring
    rw [e] at hq2
    exact h3 _ hq2
  refine ⟨hq, ?_⟩
  have hw₁S : (w' * twNeg) ∈ charStabilizer (triChar b3) := fun v => by
    rw [triChar_apply, triChar_apply, hrel3 v, hq2, one_mul]
  obtain ⟨j, hj⟩ := exists_pow_mul_mem_kernelWeylGroup ((hS w).1 hw) hw₁S hsh3
  rw [← hKW] at hj
  have hΦF₁ : twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w') (iterateFrobenius L ℓ f) =
      (MulAut.conj (canonicalRep (coxeterSystem Tag.E6) L w' *
        (canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹)).toMonoidHom.comp
        (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L twNeg) (iterateFrobenius L ℓ f)) :=
    MonoidHom.ext fun g => by
      simp only [twFrobE6_apply, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
        MulAut.conj_apply, mul_inv_rev, inv_inv]
      group
  have hc₁N : canonicalRep (coxeterSystem Tag.E6) L w' *
      (canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹ ∈
        Subgroup.normalizer (heisM a : Set (ModGL Tag.E6 L)) := by
    have hmap : (heisM a).map (MulAut.conj (canonicalRep (coxeterSystem Tag.E6) L w' *
        (canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹)).toMonoidHom = heisM a := by
      calc (heisM a).map (MulAut.conj (canonicalRep (coxeterSystem Tag.E6) L w' *
            (canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹)).toMonoidHom
          = ((heisM a).map (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L twNeg)
              (iterateFrobenius L ℓ f))).map (MulAut.conj
                (canonicalRep (coxeterSystem Tag.E6) L w' *
                  (canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹)).toMonoidHom := by
            rw [map_twFrobE6_negNeg_heisM hFrs a]
        _ = (heisM a).map (twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w')
              (iterateFrobenius L ℓ f)) := by rw [Subgroup.map_map, ← hΦF₁]
        _ = heisM a := hΦM
    rw [Subgroup.mem_normalizer_iff_conj_image_eq]
    have h := congrArg SetLike.coe hmap
    rw [Subgroup.coe_map] at h
    exact h
  obtain ⟨hy₀mono, hy₀maps⟩ := rootDiag_mul_canonicalRep_facts (L := L) b w
  have hc₁mono : canonicalRep (coxeterSystem Tag.E6) L w' *
      (canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹ ∈ monomialSubgroup Tag.E6 L :=
    mul_mem (canonicalRep_mem_monomialSubgroup' w')
      (inv_mem (canonicalRep_mem_monomialSubgroup' twNeg))
  have hc₁maps : MapsRootLines (canonicalRep (coxeterSystem Tag.E6) L w' *
      (canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹) (w' * twNeg) := by
    have := (mapsRootLines_canonicalRep (R := L) w').mul
      (mapsRootLines_canonicalRep (R := L) twNeg).inv
    rwa [twNeg_inv] at this
  have hyN : y ∈ Subgroup.normalizer (heisM a : Set (ModGL Tag.E6 L)) := by
    rw [hyd]
    exact mul_mem (mul_mem (inv_mem (Subgroup.le_normalizer hu)) hy₀N) (Subgroup.le_normalizer hu)
  have e1 : y ^ j = u⁻¹ * (rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w) ^ j *
      u := by
    have := conj_pow (a := u⁻¹)
      (b := rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w) (i := j)
    rw [inv_inv] at this
    rw [hyd]
    exact this
  have hyc₁ : y ^ j * (canonicalRep (coxeterSystem Tag.E6) L w' *
      (canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹) ∈ heisM a := by
    have e2 : y ^ j * (canonicalRep (coxeterSystem Tag.E6) L w' *
        (canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹) =
        u⁻¹ * ((rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w) ^ j *
          (canonicalRep (coxeterSystem Tag.E6) L w' *
            (canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹)) *
          ((canonicalRep (coxeterSystem Tag.E6) L w' *
            (canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹)⁻¹ * u *
            (canonicalRep (coxeterSystem Tag.E6) L w' *
              (canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹)) := by
      rw [e1]
      group
    rw [e2]
    refine mul_mem (mul_mem (inv_mem hu) ?_) ?_
    · exact mem_heisM_of_mapsRootLines (mul_mem (pow_mem hy₀mono j) hc₁mono)
        ((E8Lift.mapsRootLines_pow hy₀maps j).mul hc₁maps) hj
    · have := (Subgroup.mem_normalizer_iff.1 (inv_mem hc₁N) u).1 hu
      simpa using this
  obtain ⟨c₁, hc₁⟩ : ∃ c₁ : ModGL Tag.E6 L, c₁ = canonicalRep (coxeterSystem Tag.E6) L w' *
      (c₀ * canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹ := ⟨_, rfl⟩
  have hc : y ^ j * c₁ ∈ heisM a := by
    have : y ^ j * c₁ = (y ^ j * (canonicalRep (coxeterSystem Tag.E6) L w' *
        (canonicalRep (coxeterSystem Tag.E6) L twNeg)⁻¹)) * c₀⁻¹ := by
      rw [hc₁]
      group
    rw [this]
    exact mul_mem hyc₁ (inv_mem hc₀)
  obtain ⟨z, hz, hzc⟩ := lang_twFrobE6 (ℓ := ℓ) hf hc₀ _ hc
  rw [← hc₁]
  have hΦF : ∀ g, twFrobE6 (nrep L w') (iterateFrobenius L ℓ f) g =
      c₁ * twFrobE6 (c₀ * nrep L twNeg) (iterateFrobenius L ℓ f) g * c₁⁻¹ := fun g => by
    rw [hc₁]
    simp only [twFrobE6_apply]
    group
  have hF'y : twFrobE6 (c₀ * nrep L twNeg) (iterateFrobenius L ℓ f) y = c₁⁻¹ * y * c₁ := by
    have h := hΦF y
    rw [hy] at h
    calc twFrobE6 (c₀ * nrep L twNeg) (iterateFrobenius L ℓ f) y
        = c₁⁻¹ * (c₁ * twFrobE6 (c₀ * nrep L twNeg) (iterateFrobenius L ℓ f) y * c₁⁻¹) * c₁ := by
          group
      _ = c₁⁻¹ * y * c₁ := by rw [← h]
  refine ⟨j, z, hz, hzc, ?_, ?_, ?_, ?_⟩
  · rw [map_mul, map_mul, map_inv, hzc, hF'y]
    calc z * (y ^ j * c₁) * (c₁⁻¹ * y * c₁) * (z * (y ^ j * c₁))⁻¹
        = z * (y ^ j * y * (y ^ j)⁻¹) * z⁻¹ := by group
      _ = z * y * z⁻¹ := by rw [show y ^ j * y * (y ^ j)⁻¹ = y by group]
  · exact mul_mem (mul_mem (Subgroup.le_normalizer hz) hyN) (inv_mem (Subgroup.le_normalizer hz))
  · refine ⟨z * u⁻¹ * rootDiagUnit Tag.E6 b * (nrep L w * (u * z⁻¹) * (nrep L w)⁻¹), ?_, ?_⟩
    · refine mul_mem (mul_mem (mul_mem hz (inv_mem hu)) hdb) ?_
      exact (Subgroup.mem_normalizer_iff.1 hnw (u * z⁻¹)).1 (mul_mem hu (inv_mem hz))
    · rw [hyd]
      group
  · intro x hxM hxF hxc
    have hXy : (z⁻¹ * x * z) * y = y * (z⁻¹ * x * z) := by
      have h := hxc.eq
      calc (z⁻¹ * x * z) * y = z⁻¹ * (x * (z * y * z⁻¹)) * z := by group
        _ = z⁻¹ * ((z * y * z⁻¹) * x) * z := by rw [h]
        _ = y * (z⁻¹ * x * z) := by group
    have hXyj : (z⁻¹ * x * z) * y ^ j = y ^ j * (z⁻¹ * x * z) :=
      (Commute.pow_right (show Commute (z⁻¹ * x * z) y from hXy) j).eq
    rw [hΦF, map_mul, map_mul, map_inv, hzc, hxF]
    calc c₁ * ((z * (y ^ j * c₁))⁻¹ * x * (z * (y ^ j * c₁))) * c₁⁻¹
        = (y ^ j)⁻¹ * (z⁻¹ * x * z) * y ^ j := by group
      _ = z⁻¹ * x * z := by
        rw [mul_assoc, hXyj, ← mul_assoc, inv_mul_cancel, one_mul]

theorem twHeis_frame_straighten {f : ℕ} (hf : 1 ≤ f) (hℓ3 : ℓ ≠ 3)
    {a b : Fin Tag.E6.rank → Lˣ} (ha3 : ∀ i, a i ^ 3 = 1)
    {w w' : WeylGroup Tag.E6} (hw : w ∈ rootCharStabilizer a)
    (hsh : rootChar a (e6Shift w) ≠ 1) {u : ModGL Tag.E6 L} (hu : u ∈ heisM a)
    {g0 g₁ g₂ : ModGL Tag.E6 L} (hg0C : g0 ∈ adjointGroup Tag.E6 L)
    (hg0 : twistHomE6 (iterateFrobenius L ℓ f) g0 = g0 * canonicalRep (coxeterSystem Tag.E6) L w')
    (hT : twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w') (iterateFrobenius L ℓ f)
      (rootDiagUnit Tag.E6 a) = rootDiagUnit Tag.E6 a)
    (hg₁ : g0⁻¹ * g₁ * g0 = rootDiagUnit Tag.E6 a)
    (hg₂ : g0⁻¹ * g₂ * g0 =
      u⁻¹ * (rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w) * u)
    (hF₂ : twistHomE6 (iterateFrobenius L ℓ f) g₂ = g₂) (hg₂3 : g₂ ^ 3 = 1)
    {c₀ : ModGL Tag.E6 L} (hc₀ : c₀ ∈ heisM a) :
    ((ℓ ^ f : ℕ) : ZMod 3) = -1 ∧ ∃ y' : ModGL Tag.E6 L,
      y' ∈ Subgroup.normalizer (heisM a : Set (ModGL Tag.E6 L)) ∧
      (∃ m ∈ heisM a, y' = m * canonicalRep (coxeterSystem Tag.E6) L w) ∧ y' ^ 3 = 1 ∧
      twFrobE6 (c₀ * canonicalRep (coxeterSystem Tag.E6) L twNeg) (iterateFrobenius L ℓ f) y' =
        y' ∧
      ∀ x ∈ heisM a, x ≠ 1 → x ^ ℓ = 1 →
        twFrobE6 (c₀ * canonicalRep (coxeterSystem Tag.E6) L twNeg) (iterateFrobenius L ℓ f) x =
          x → Commute x y' →
        ∃ v : ModGL Tag.E6 L, v ∈ adjointGroup Tag.E6 L ∧ v ≠ 1 ∧ v ^ ℓ = 1 ∧
          twistHomE6 (iterateFrobenius L ℓ f) v = v ∧ Commute v g₁ ∧ Commute v g₂ := by
  classical
  obtain ⟨y, hyd⟩ : ∃ y : ModGL Tag.E6 L, y =
      u⁻¹ * (rootDiagUnit Tag.E6 b * canonicalRep (coxeterSystem Tag.E6) L w) * u := ⟨_, rfl⟩
  rw [← hyd] at hg₂
  have hy3 : y ^ 3 = 1 := by
    have h1 := conj_pow (a := g0⁻¹) (b := g₂) (i := 3)
    rw [inv_inv, hg₂3] at h1
    rw [← hg₂, h1]
    group
  have hy : twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w') (iterateFrobenius L ℓ f) y = y := by
    have hFy : twistHomE6 (iterateFrobenius L ℓ f) y =
        (canonicalRep (coxeterSystem Tag.E6) L w')⁻¹ * y *
          canonicalRep (coxeterSystem Tag.E6) L w' := by
      rw [← hg₂, map_mul, map_mul, map_inv, hg0, hF₂]
      group
    rw [twFrobE6_apply, hFy]
    group
  obtain ⟨hq, j, z, hz, hFz, hFy', hyN, ⟨m, hm, hym⟩, hfix⟩ :=
    twHeis_straighten_core (ℓ := ℓ) hf hℓ3 ha3 hw hsh hu hyd hT hy hc₀
  refine ⟨hq, z * y * z⁻¹, hyN, ⟨m, hm, hym⟩, ?_, hFy', ?_⟩
  · have h1 := conj_pow (a := z) (b := y) (i := 3)
    rw [h1, hy3]
    group
  · intro x hxM hx1 hxp hxF hxc
    have hXM : z⁻¹ * x * z ∈ heisM a := mul_mem (mul_mem (inv_mem hz) hxM) hz
    have hXy : (z⁻¹ * x * z) * y = y * (z⁻¹ * x * z) := by
      have h := hxc.eq
      calc (z⁻¹ * x * z) * y = z⁻¹ * (x * (z * y * z⁻¹)) * z := by group
        _ = z⁻¹ * ((z * y * z⁻¹) * x) * z := by rw [h]
        _ = y * (z⁻¹ * x * z) := by group
    have hΦX := hfix x hxM hxF hxc
    refine ⟨g0 * (z⁻¹ * x * z) * g0⁻¹, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · exact mul_mem (mul_mem hg0C (heisM_le_adjoint a hXM)) (inv_mem hg0C)
    · intro h
      apply hx1
      calc x = z * (g0⁻¹ * (g0 * (z⁻¹ * x * z) * g0⁻¹) * g0) * z⁻¹ := by group
        _ = 1 := by rw [h]; group
    · have h1 := conj_pow (a := g0) (b := z⁻¹ * x * z) (i := ℓ)
      have h2 := conj_pow (a := z⁻¹) (b := x) (i := ℓ)
      rw [inv_inv] at h2
      rw [h1, h2, hxp]
      group
    · rw [map_mul, map_mul, map_inv, hg0]
      calc g0 * canonicalRep (coxeterSystem Tag.E6) L w' * twistHomE6 (iterateFrobenius L ℓ f)
            (z⁻¹ * x * z) * (g0 * canonicalRep (coxeterSystem Tag.E6) L w')⁻¹
          = g0 * twFrobE6 (canonicalRep (coxeterSystem Tag.E6) L w') (iterateFrobenius L ℓ f)
              (z⁻¹ * x * z) * g0⁻¹ := by
            rw [twFrobE6_apply]
            group
        _ = g0 * (z⁻¹ * x * z) * g0⁻¹ := by rw [hΦX]
    · have hg₁' : g₁ = g0 * rootDiagUnit Tag.E6 a * g0⁻¹ := by
        rw [← hg₁]
        group
      rw [hg₁']
      have hc := heisM_comm a hXM
      show _ * _ = _ * _
      calc g0 * (z⁻¹ * x * z) * g0⁻¹ * (g0 * rootDiagUnit Tag.E6 a * g0⁻¹)
          = g0 * ((z⁻¹ * x * z) * rootDiagUnit Tag.E6 a) * g0⁻¹ := by group
        _ = g0 * (rootDiagUnit Tag.E6 a * (z⁻¹ * x * z)) * g0⁻¹ := by rw [hc]
        _ = _ := by group
    · have hg₂' : g₂ = g0 * y * g0⁻¹ := by
        rw [← hg₂]
        group
      rw [hg₂']
      show _ * _ = _ * _
      calc g0 * (z⁻¹ * x * z) * g0⁻¹ * (g0 * y * g0⁻¹)
          = g0 * ((z⁻¹ * x * z) * y) * g0⁻¹ := by group
        _ = g0 * (y * (z⁻¹ * x * z)) * g0⁻¹ := by rw [hXy]
        _ = _ := by group

end Core

section Frame

variable {K : Type} [Field K] [Finite K]

theorem twFrame_coords {ℓ f : ℕ} (hℓ : ℓ.Prime) (hf : 1 ≤ f)
    (hK : Nat.card K = (ℓ ^ f) ^ 2) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (ℓ ^ f))
    {E : Subgroup (MulAut (twistedE6RootGroup K σ))} (hE : CFSG.IsElementaryAbelian 3 E)
    (F : TwE6HeisenbergFrame K σ (ℓ ^ f) E) :
    ∃ g0 g₁ g₂ : ModGL Tag.E6 (AlgebraicClosure K),
      g0 ∈ adjointGroup Tag.E6 (AlgebraicClosure K) ∧
      twistHomE6 F.Fr g0 = g0 * canonicalRep (coxeterSystem Tag.E6) (AlgebraicClosure K) F.w' ∧
      twFrobE6 (canonicalRep (coxeterSystem Tag.E6) (AlgebraicClosure K) F.w') F.Fr
        (rootDiagUnit Tag.E6 F.a) = rootDiagUnit Tag.E6 F.a ∧
      g0⁻¹ * g₁ * g0 = rootDiagUnit Tag.E6 F.a ∧
      g0⁻¹ * g₂ * g0 = F.u⁻¹ * (rootDiagUnit Tag.E6 F.b *
        canonicalRep (coxeterSystem Tag.E6) (AlgebraicClosure K) F.w) * F.u ∧
      twistHomE6 F.Fr g₂ = g₂ ∧ g₂ ^ 3 = 1 ∧
      g₁ = baseChangeGL (algebraMap K (AlgebraicClosure K)) (F.g₁ : ModGL TwistTag.E6.tag K) ∧
      g₂ = baseChangeGL (algebraMap K (AlgebraicClosure K)) (F.g₂ : ModGL TwistTag.E6.tag K) := by
  classical
  obtain ⟨g0, hg0def⟩ : ∃ g0 : ModGL Tag.E6 (AlgebraicClosure K), g0 = F.g0 := ⟨F.g0, rfl⟩
  obtain ⟨g₁, hg₁def⟩ : ∃ g₁ : ModGL Tag.E6 (AlgebraicClosure K), g₁ =
      baseChangeGL (algebraMap K (AlgebraicClosure K)) (F.g₁ : ModGL TwistTag.E6.tag K) :=
    ⟨_, rfl⟩
  obtain ⟨g₂, hg₂def⟩ : ∃ g₂ : ModGL Tag.E6 (AlgebraicClosure K), g₂ =
      baseChangeGL (algebraMap K (AlgebraicClosure K)) (F.g₂ : ModGL TwistTag.E6.tag K) :=
    ⟨_, rfl⟩
  refine ⟨g0, g₁, g₂, ?_, ?_, ?_, ?_, ?_, ?_, ?_, hg₁def, hg₂def⟩
  · rw [hg0def]
    exact F.hg0C
  · rw [hg0def]
    exact F.hg0
  · exact (mem_twistedTorusOf.1 F.hT).2
  · rw [hg0def, hg₁def]
    exact F.hg₁
  · rw [hg0def, hg₂def]
    exact F.hg₂
  · rw [hg₂def]
    exact ((mem_twistedFixedGroup_iff_twistHom TwistTag.E6 (AlgebraicClosure K) F.Fr).1
      (map_twistedE6InndiagGL_le_twistedFixedGroup hℓ hf hK σ hσ F.Fr F.hFr
        (Subgroup.mem_map_of_mem _ F.g₂.2))).2
  · have hinj := twistedE6InndiagConj_injective hℓ hf hK σ hσ
    have h3 : F.g₂ ^ 3 = 1 := hinj (by
      rw [map_pow, map_one]
      exact CFSG.elemPow_eq_one_of_isElementaryAbelian (A := E) _ F.hE₂)
    have hd3 : (F.g₂ : ModGL TwistTag.E6.tag K) ^ 3 = 1 := by
      simpa using congrArg Subtype.val h3
    have h4 : (baseChangeGL (algebraMap K (AlgebraicClosure K))
        (F.g₂ : ModGL TwistTag.E6.tag K)) ^ 3 = 1 := by
      rw [← map_pow, hd3, map_one]
    rw [hg₂def]
    exact h4

theorem twFrame_straighten {ℓ f : ℕ} (hℓ : ℓ.Prime) (hℓ3 : ℓ ≠ 3) (hf : 1 ≤ f)
    (hK : Nat.card K = (ℓ ^ f) ^ 2) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (ℓ ^ f))
    {E : Subgroup (MulAut (twistedE6RootGroup K σ))} (hE : CFSG.IsElementaryAbelian 3 E)
    (F : TwE6HeisenbergFrame K σ (ℓ ^ f) E)
    {c₀ : ModGL Tag.E6 (AlgebraicClosure K)} (hc₀ : c₀ ∈ heisM F.a) :
    ∃ y' : ModGL Tag.E6 (AlgebraicClosure K),
      y' ∈ Subgroup.normalizer (heisM F.a : Set (ModGL Tag.E6 (AlgebraicClosure K))) ∧
      (∃ m ∈ heisM F.a, y' = m * canonicalRep (coxeterSystem Tag.E6) (AlgebraicClosure K) F.w) ∧
      y' ^ 3 = 1 ∧
      twFrob TwistTag.E6 (c₀ * canonicalRep (coxeterSystem Tag.E6) (AlgebraicClosure K) twNeg)
        F.Fr y' = y' ∧
      ∀ x ∈ heisM F.a, x ≠ 1 → x ^ ℓ = 1 →
        twFrob TwistTag.E6 (c₀ * canonicalRep (coxeterSystem Tag.E6) (AlgebraicClosure K) twNeg)
          F.Fr x = x → Commute x y' →
        ∃ v : ModGL TwistTag.E6.tag (AlgebraicClosure K),
          v ∈ adjointGroup TwistTag.E6.tag (AlgebraicClosure K) ∧ v ≠ 1 ∧ v ^ ℓ = 1 ∧
          twistHom TwistTag.E6 (AlgebraicClosure K) F.Fr v = v ∧
          Commute v (baseChangeGL (algebraMap K (AlgebraicClosure K))
            (F.g₁ : ModGL TwistTag.E6.tag K)) ∧
          Commute v (baseChangeGL (algebraMap K (AlgebraicClosure K))
            (F.g₂ : ModGL TwistTag.E6.tag K)) := by
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : Fintype K := Fintype.ofFinite K
  haveI : CharP K ℓ := charP_of_card_eq_prime_pow (f := f * 2)
    (by rw [← Nat.card_eq_fintype_card, hK, ← pow_mul])
  haveI : CharP (AlgebraicClosure K) ℓ :=
    charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective ℓ
  have hFrEq : F.Fr = iterateFrobenius (AlgebraicClosure K) ℓ f :=
    RingHom.ext fun c => by rw [F.hFr c, iterateFrobenius_def]
  obtain ⟨g0, g₁, g₂, hg0C, hg0, hT, hg₁, hg₂, hF₂, hg₂3, hg₁def, hg₂def⟩ :=
    twFrame_coords hℓ hf hK σ hσ hE F
  rw [hFrEq] at hg0 hT hF₂
  have hu : F.u ∈ heisM F.a := rootSpan_le_heisM F.a F.hu
  obtain ⟨-, y', h1, h2, h3, h4, h5⟩ := twHeis_frame_straighten (ℓ := ℓ) hf hℓ3 F.ha3 F.hw F.hsh
    hu hg0C hg0 hT hg₁ hg₂ hF₂ hg₂3 hc₀
  rw [hFrEq]
  refine ⟨y', h1, h2, h3, h4, ?_⟩
  intro x hx hx1 hxp hxF hxc
  obtain ⟨v, hv, hv1, hvp, hvF, hvc1, hvc2⟩ := h5 x hx hx1 hxp hxF hxc
  refine ⟨v, hv, hv1, hvp, hvF, ?_, ?_⟩
  · rw [hg₁def] at hvc1
    exact hvc1
  · rw [hg₂def] at hvc2
    exact hvc2

theorem twFrame_card_mod_three {ℓ f : ℕ} (hℓ : ℓ.Prime) (hℓ3 : ℓ ≠ 3) (hf : 1 ≤ f)
    (hK : Nat.card K = (ℓ ^ f) ^ 2) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (ℓ ^ f))
    {E : Subgroup (MulAut (twistedE6RootGroup K σ))} (hE : CFSG.IsElementaryAbelian 3 E)
    (F : TwE6HeisenbergFrame K σ (ℓ ^ f) E) : ((ℓ ^ f : ℕ) : ZMod 3) = -1 := by
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI : Fintype K := Fintype.ofFinite K
  haveI : CharP K ℓ := charP_of_card_eq_prime_pow (f := f * 2)
    (by rw [← Nat.card_eq_fintype_card, hK, ← pow_mul])
  haveI : CharP (AlgebraicClosure K) ℓ :=
    charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective ℓ
  have hFrEq : F.Fr = iterateFrobenius (AlgebraicClosure K) ℓ f :=
    RingHom.ext fun c => by rw [F.hFr c, iterateFrobenius_def]
  obtain ⟨g0, g₁, g₂, hg0C, hg0, hT, hg₁, hg₂, hF₂, hg₂3, -, -⟩ :=
    twFrame_coords hℓ hf hK σ hσ hE F
  rw [hFrEq] at hg0 hT hF₂
  exact (twHeis_frame_straighten (ℓ := ℓ) hf hℓ3 F.ha3 F.hw F.hsh (rootSpan_le_heisM F.a F.hu)
    hg0C hg0 hT hg₁ hg₂ hF₂ hg₂3 (one_mem (heisM F.a))).1

theorem twFrame_three_dvd_pow_add_one {ℓ f : ℕ} (hℓ : ℓ.Prime) (hℓ3 : ℓ ≠ 3) (hf : 1 ≤ f)
    (hK : Nat.card K = (ℓ ^ f) ^ 2) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (ℓ ^ f))
    {E : Subgroup (MulAut (twistedE6RootGroup K σ))} (hE : CFSG.IsElementaryAbelian 3 E)
    (F : TwE6HeisenbergFrame K σ (ℓ ^ f) E) : 3 ∣ ℓ ^ f + 1 := by
  have h := twFrame_card_mod_three hℓ hℓ3 hf hK σ hσ hE F
  refine (ZMod.natCast_eq_zero_iff _ _).1 ?_
  push_cast at h ⊢
  rw [h]
  ring

theorem twFrame_exists_fixedElt_of_exists_x {ℓ f : ℕ} (hℓ : ℓ.Prime) (hℓ3 : ℓ ≠ 3) (hf : 1 ≤ f)
    (hK : Nat.card K = (ℓ ^ f) ^ 2) (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ (ℓ ^ f))
    {E : Subgroup (MulAut (twistedE6RootGroup K σ))} (hE : CFSG.IsElementaryAbelian 3 E)
    (F : TwE6HeisenbergFrame K σ (ℓ ^ f) E)
    (hx : ∃ c₀ ∈ heisM F.a, ∀ y' : ModGL Tag.E6 (AlgebraicClosure K),
      y' ∈ Subgroup.normalizer (heisM F.a : Set (ModGL Tag.E6 (AlgebraicClosure K))) →
      (∃ m ∈ heisM F.a, y' = m * canonicalRep (coxeterSystem Tag.E6) (AlgebraicClosure K) F.w) →
      y' ^ 3 = 1 →
      twFrob TwistTag.E6 (c₀ * canonicalRep (coxeterSystem Tag.E6) (AlgebraicClosure K) twNeg)
        F.Fr y' = y' →
      ∃ x ∈ heisM F.a, x ≠ 1 ∧ x ^ ℓ = 1 ∧
        twFrob TwistTag.E6 (c₀ * canonicalRep (coxeterSystem Tag.E6) (AlgebraicClosure K) twNeg)
          F.Fr x = x ∧ Commute x y') :
    ∃ v : ModGL TwistTag.E6.tag (AlgebraicClosure K),
