theorem exists_fixed_g2 (ε : ℕ) (hε : ε = 1 ∨ ε = 2) :
    ∃ z : ↥(adjointGroup Tag.D4 K), z ≠ 1 ∧ z ^ ringChar K = 1 ∧ d4Graph K ε z = z := by
  haveI : Fact (ringChar K).Prime := ⟨CharP.char_is_prime K (ringChar K)⟩
  set i2 : Fin Tag.D4.rank := ⟨2, by decide⟩
  refine ⟨adjX Tag.D4 K i2 1, ?_, ?_, ?_⟩
  · intro h
    have h1 : pinnedX Tag.D4 K (Pi.single i2 1) 1 = pinnedX Tag.D4 K (Pi.single i2 1) 0 := by
      rw [pinnedX_single, pinnedX_single, xUnit_zero]
      exact congrArg Subtype.val h
    exact one_ne_zero (pinnedX_injective Tag.D4 K _ h1)
  · apply Subtype.ext
    exact xUnit_pow_char (K := K) (p := ringChar K) Tag.D4 i2
  · rw [d4Graph_adjX]
    have : (d4Rho ^ ε) i2 = i2 := by
      rcases hε with rfl | rfl <;> decide
    rw [this]

local notation "𝕩" => xPar (rootOperatorFamily Tag.D4)

theorem weylG2_conj_outer (i : Fin Tag.D4.rank) (hi : i ≠ ⟨2, by decide⟩) :
    ∃ β ∈ longOrthRoots, ∃ c : K,
      (weylG2 : ↥(adjointGroup Tag.D4 K))⁻¹ * adjX Tag.D4 K i 1 * weylG2 = 𝕩 β c := by
  obtain ⟨β, hβl, hpos, -⟩ := longOrth_reflect i hi
  obtain ⟨hβr, -⟩ := longOrth_facts β hβl
  obtain ⟨ε, hε, hc⟩ := exists_weylG2_conj (K := K) hβr
  rw [hpos] at hc
  refine ⟨β, hβl, ε, ?_⟩
  have h := hc ε
  rw [hε, xPar_single_eq_sl2At, sl2At_uSL] at h
  rw [← h]
  group

theorem outer_prod_ne_one :
    adjX Tag.D4 K ⟨0, by decide⟩ 1 * adjX Tag.D4 K ⟨1, by decide⟩ 1 *
      adjX Tag.D4 K ⟨3, by decide⟩ 1 ≠ 1 := by
  intro h
  have h1 : xUnit Tag.D4 K ⟨0, by decide⟩ 1 * xUnit Tag.D4 K ⟨1, by decide⟩ 1 *
      xUnit Tag.D4 K ⟨3, by decide⟩ 1 = 1 := congrArg Subtype.val h
  set idx : Fin 3 → Fin Tag.D4.rank := ![⟨0, by decide⟩, ⟨1, by decide⟩, ⟨3, by decide⟩] with hidx
  have hidx2 : ∀ i, idx i ≠ ⟨2, by decide⟩ := by decide
  have hidxinj : Function.Injective idx := by decide
  have hne := prod_ne_one_aux (τ := Tag.D4) (L := K) 0 3
    (fun i => (Pi.single (idx i) 1 : Fin Tag.D4.rank → ℤ)) (fun _ => 1) 0
    (fun i => isRoot_single _ _)
    (fun i j hij => hidxinj (by
      have := congrFun hij (idx i)
      simpa [Pi.single_apply] using this))
    (fun i k hik => (outer_orth (idx i) (idx k) (hidx2 i) (hidx2 k) (fun h => hik (hidxinj h))).1)
    (by
      have : (Finset.univ.filter fun i : Fin 3 =>
          height (Pi.single (idx i) 1 : Fin Tag.D4.rank → ℤ) < 0) = ∅ := by
        refine Finset.filter_eq_empty_iff.2 fun i _ => ?_
        simp [height]
      rw [this]
      simp)
    one_ne_zero
  apply hne
  simp only [List.ofFn_succ, List.ofFn_zero, List.prod_cons, List.prod_nil, mul_one,
    pinnedX_single]
  simpa [mul_assoc, hidx] using h1

theorem exists_fixed_a2 (B : SL2 K) :
    ∃ z : ↥(adjointGroup Tag.D4 K), z ≠ 1 ∧ z ^ ringChar K = 1 ∧ gammaP K B z = z := by
  haveI : Fact (ringChar K).Prime := ⟨CharP.char_is_prime K (ringChar K)⟩
  set i0 : Fin Tag.D4.rank := ⟨0, by decide⟩ with hi0
  set i1 : Fin Tag.D4.rank := ⟨1, by decide⟩ with hi1
  set i3 : Fin Tag.D4.rank := ⟨3, by decide⟩ with hi3
  set i2 : Fin Tag.D4.rank := ⟨2, by decide⟩ with hi2
  set u : ↥(adjointGroup Tag.D4 K) :=
    adjX Tag.D4 K i0 1 * adjX Tag.D4 K i1 1 * adjX Tag.D4 K i3 1 with hu
  have hushort : u = sl2Short K (uSL 1) := by
    rw [hu, sl2Short_apply, sl2At_uSL, sl2At_uSL, sl2At_uSL]
  have hcomm : ∀ i : Fin Tag.D4.rank, i ≠ i2 →
      Commute ((weylG2 : ↥(adjointGroup Tag.D4 K))⁻¹ * adjX Tag.D4 K i 1 * weylG2)
        (sl2At K i2 B) := by
    intro i hi
    obtain ⟨β, hβl, c, hc⟩ := weylG2_conj_outer (K := K) i hi
    rw [hc]
    obtain ⟨hβr, -, hp, hm, -, -, h1, h2, -⟩ := longOrth_facts β hβl
    exact commute_sl2Two hβr hp hm h1 h2 c B
  refine ⟨weylG2⁻¹ * u * weylG2, ?_, ?_, ?_⟩
  · intro h
    apply outer_prod_ne_one (K := K)
    have e : u = weylG2 * (weylG2⁻¹ * u * weylG2) * weylG2⁻¹ := by group
    rw [← hu, e, h]
    group
  · rw [show (weylG2 : ↥(adjointGroup Tag.D4 K))⁻¹ * u * weylG2 =
        weylG2⁻¹ * u * (weylG2⁻¹)⁻¹ by rw [inv_inv], conj_pow (a := weylG2⁻¹) (b := u)]
    have hc01 : Commute (adjX Tag.D4 K i0 1) (adjX Tag.D4 K i1 1) := by
      have := sl2At_commute (K := K) (i := i0) (j := i1) (by decide) (by decide) (by decide)
        (uSL 1) (uSL 1)
      rwa [sl2At_uSL, sl2At_uSL] at this
    have hc03 : Commute (adjX Tag.D4 K i0 1) (adjX Tag.D4 K i3 1) := by
      have := sl2At_commute (K := K) (i := i0) (j := i3) (by decide) (by decide) (by decide)
        (uSL 1) (uSL 1)
      rwa [sl2At_uSL, sl2At_uSL] at this
    have hc13 : Commute (adjX Tag.D4 K i1 1) (adjX Tag.D4 K i3 1) := by
      have := sl2At_commute (K := K) (i := i1) (j := i3) (by decide) (by decide) (by decide)
        (uSL 1) (uSL 1)
      rwa [sl2At_uSL, sl2At_uSL] at this
    have hp : ∀ i : Fin Tag.D4.rank, adjX Tag.D4 K i 1 ^ ringChar K = 1 := fun i =>
      Subtype.ext (xUnit_pow_char (K := K) (p := ringChar K) Tag.D4 i)
    have hu1 : u ^ ringChar K = 1 := by
      rw [hu, (hc03.mul_left hc13).mul_pow, hc01.mul_pow, hp, hp, hp]
      group
    rw [hu1]
    group
  · have hz : d4Graph K 1 (weylG2⁻¹ * u * weylG2 : ↥(adjointGroup Tag.D4 K)) =
        weylG2⁻¹ * u * weylG2 := by
      rw [map_mul, map_mul, map_inv, d4Graph_one_weylG2, hushort, d4Graph_one_sl2Short]
    have hzc : Commute (weylG2⁻¹ * u * weylG2 : ↥(adjointGroup Tag.D4 K)) (sl2At K i2 B) := by
      have e : (weylG2⁻¹ * u * weylG2 : ↥(adjointGroup Tag.D4 K)) =
          (weylG2⁻¹ * adjX Tag.D4 K i0 1 * weylG2) * (weylG2⁻¹ * adjX Tag.D4 K i1 1 * weylG2) *
            (weylG2⁻¹ * adjX Tag.D4 K i3 1 * weylG2) := by
        rw [hu]
        group
      rw [e]
      exact ((hcomm i0 (by decide)).mul_left (hcomm i1 (by decide))).mul_left
        (hcomm i3 (by decide))
    show (MulAut.conj (sl2At K i2 B) * d4Graph K 1) (weylG2⁻¹ * u * weylG2) = _
    rw [MulAut.mul_apply, hz, MulAut.conj_apply, hzc.symm.eq]
    group

theorem fixed_of_conj {G : Type*} [Group G] {n : ℕ} {α β : MulAut G} (ψ : MulAut G)
    (h : ψ * α * ψ⁻¹ = β) {z₀ : G} (h1 : z₀ ≠ 1) (hp : z₀ ^ n = 1) (hf : β z₀ = z₀) :
    ∃ z : G, z ≠ 1 ∧ z ^ n = 1 ∧ α z = z := by
  have hα : α = ψ⁻¹ * β * ψ := by rw [← h]; group
  refine ⟨ψ⁻¹ z₀, fun h0 => h1 ?_, by rw [← map_pow, hp, map_one], ?_⟩
  · have := congrArg ψ h0
    rwa [MulAut.apply_inv_self, map_one] at this
  · rw [hα, MulAut.mul_apply, MulAut.mul_apply, MulAut.apply_inv_self, hf]

theorem d4_exists_fixed_ell (hK : ringChar K = 2 ∨ 5 ≤ ringChar K)
    {α : MulAut ↥(adjointGroup Tag.D4 K)} (hα3 : α ^ 3 = 1)
    (hαT : D4ElemType α fun ε σ => ε ≠ 0 ∧ σ = 1) :
    ∃ z : ↥(adjointGroup Tag.D4 K), z ≠ 1 ∧ z ^ ringChar K = 1 ∧ α z = z := by
  have hcl : IsG2Type α ∨ IsA2Type α := by
    rcases hK with h2 | h5
    · exact isG2Type_or_isA2Type_of_charTwo K h2 α hα3 hαT
    · exact ClassOdd.d4GraphClassOdd_of (ClassOdd.graphShintaniNF_of ClassOdd.threeD4FixedNF_holds)
        ClassOdd.g2ThreeClass_holds K h5 α hα3 hαT
  rcases hcl with ⟨ψ, hψ⟩ | ⟨ψ, B, -, -, hψ⟩
  · obtain ⟨ε, hε12, hεeq⟩ : ∃ ε : ℕ, (ε = 1 ∨ ε = 2) ∧ ψ * α * ψ⁻¹ = d4Graph K ε := by
      rcases hψ with h | h
      · exact ⟨1, Or.inl rfl, h⟩
      · exact ⟨2, Or.inr rfl, h⟩
    obtain ⟨z₀, hz1, hzp, hzf⟩ := exists_fixed_g2 (K := K) ε hε12
    exact fixed_of_conj ψ hεeq hz1 hzp hzf
  · obtain ⟨z₀, hz1, hzp, hzf⟩ := exists_fixed_a2 (K := K) B
    rcases hψ with h | h
    · exact fixed_of_conj ψ h hz1 hzp hzf
    · refine fixed_of_conj ψ h hz1 hzp ?_
      have := congrArg (fun x => (gammaP K B)⁻¹ x) hzf
      simp only [MulAut.inv_apply_self] at this
      exact this.symm

