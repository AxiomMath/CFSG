theorem HSL_mul_vSL_mul_inv {L : Type*} [Field L] (u : Lˣ) (s : L) :
    HSL u * vSL s * (HSL u)⁻¹ = vSL (((u⁻¹ : Lˣ) : L) ^ 2 * s) := by
  have hu := u.ne_zero
  rw [mul_inv_eq_iff_eq_mul]
  refine SL2_ext ?_ ?_ ?_ ?_ <;>
    simp [coe_HSL, coe_vSL, Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]
  field_simp

theorem not_isRoot_single_pm_highest : ∀ j : Fin TwistTag.E6.tag.rank, j ≠ 1 →
    (((Pi.single j 1 : Fin TwistTag.E6.tag.rank → ℤ) + e6HighestRoot ∉
        rootFinset TwistTag.E6.tag) ∧
      ((Pi.single j 1 : Fin TwistTag.E6.tag.rank → ℤ) + -e6HighestRoot ∉
        rootFinset TwistTag.E6.tag) ∧
      (-(Pi.single j 1 : Fin TwistTag.E6.tag.rank → ℤ) + e6HighestRoot ∉
        rootFinset TwistTag.E6.tag) ∧
      (-(Pi.single j 1 : Fin TwistTag.E6.tag.rank → ℤ) + -e6HighestRoot ∉
        rootFinset TwistTag.E6.tag)) ∧
    (((Pi.single j 1 : Fin TwistTag.E6.tag.rank → ℤ) ≠ e6HighestRoot) ∧
      ((Pi.single j 1 : Fin TwistTag.E6.tag.rank → ℤ) ≠ -e6HighestRoot) ∧
      (-(Pi.single j 1 : Fin TwistTag.E6.tag.rank → ℤ) ≠ e6HighestRoot) ∧
      (-(Pi.single j 1 : Fin TwistTag.E6.tag.rank → ℤ) ≠ -e6HighestRoot)) := by
  decide +kernel

theorem neg_highest_mem_rootFinset : -e6HighestRoot ∈ rootFinset TwistTag.E6.tag := by
  decide +kernel

section Certs

theorem isRoot_neg_highest : IsRoot TwistTag.E6.tag (-e6HighestRoot) :=
  mem_rootFinset.1 neg_highest_mem_rootFinset

section Roots

variable {K : Type} [Field K]

theorem commute_of_not_isRoot_add {α β : Fin TwistTag.E6.tag.rank → ℤ}
    (hα : IsRoot TwistTag.E6.tag α) (hβ : IsRoot TwistTag.E6.tag β) (hne : α ≠ β)
    (hne' : α ≠ -β) (hs : ¬ IsRoot TwistTag.E6.tag (α + β)) {x y : ModGL TwistTag.E6.tag K}
    (hx : x ∈ rootSubgroup TwistTag.E6.tag K α) (hy : y ∈ rootSubgroup TwistTag.E6.tag K β) :
    Commute x y :=
  (simply_laced_root_commutator_unit TwistTag.E6.tag TwistTag.E6.isSimplyLaced hα hβ hne hne').2
    hs K x hx y hy

theorem commute_xUnit_highest {j : Fin TwistTag.E6.tag.rank} (hj : j ≠ 1) (c : K)
    {y : ModGL TwistTag.E6.tag K}
    (hy : y ∈ rootSubgroup TwistTag.E6.tag K e6HighestRoot ∨
      y ∈ rootSubgroup TwistTag.E6.tag K (-e6HighestRoot)) :
    Commute (xUnit TwistTag.E6.tag K j c) y := by
  obtain ⟨⟨h1, h2, -, -⟩, h5, h6, -, -⟩ := not_isRoot_single_pm_highest j hj
  have hx : xUnit TwistTag.E6.tag K j c ∈ rootSubgroup TwistTag.E6.tag K (Pi.single j 1) := by
    rw [← pinnedX_single]
    exact Subgroup.subset_closure ⟨c, rfl⟩
  rcases hy with hy | hy
  · exact commute_of_not_isRoot_add (isRoot_single _ j) isRoot_e6HighestRoot h5 h6
      (fun h => h1 (mem_rootFinset.2 h)) hx hy
  · exact commute_of_not_isRoot_add (isRoot_single _ j) isRoot_neg_highest h6
      (by rw [neg_neg]; exact h5) (fun h => h2 (mem_rootFinset.2 h)) hx hy

theorem commute_yUnit_highest {j : Fin TwistTag.E6.tag.rank} (hj : j ≠ 1) (c : K)
    {y : ModGL TwistTag.E6.tag K}
    (hy : y ∈ rootSubgroup TwistTag.E6.tag K e6HighestRoot ∨
      y ∈ rootSubgroup TwistTag.E6.tag K (-e6HighestRoot)) :
    Commute (yUnit TwistTag.E6.tag K j c) y := by
  obtain ⟨⟨-, -, h3, h4⟩, -, -, h7, h8⟩ := not_isRoot_single_pm_highest j hj
  have hx : yUnit TwistTag.E6.tag K j c ∈ rootSubgroup TwistTag.E6.tag K (-Pi.single j 1) := by
    rw [← pinnedX_neg_single]
    exact Subgroup.subset_closure ⟨c, rfl⟩
  rcases hy with hy | hy
  · exact commute_of_not_isRoot_add (isRoot_neg_single _ j) isRoot_e6HighestRoot h7 h8
      (fun h => h3 (mem_rootFinset.2 h)) hx hy
  · exact commute_of_not_isRoot_add (isRoot_neg_single _ j) isRoot_neg_highest h8
      (by rw [neg_neg]; exact h7) (fun h => h4 (mem_rootFinset.2 h)) hx hy

end Roots

section Centralizer

variable {K : Type} [Field K] [Finite K] (σ : K ≃+* K)

local notation "LeviJ" => twE6LongRootLevi (twE6RootSubgroup K σ e6HighestRoot)
  (twE6RootSubgroup K σ (-e6HighestRoot))

local notation "CentC" => Subgroup.centralizer
  (twE6LongRootSL2 (twE6RootSubgroup K σ e6HighestRoot)
    (twE6RootSubgroup K σ (-e6HighestRoot)) : Set (twistedE6RootGroup K σ))

theorem mem_centralizer_of_commute {g : twistedE6RootGroup K σ}
    (hg : ∀ y : ModGL TwistTag.E6.tag K,
      (y ∈ rootSubgroup TwistTag.E6.tag K e6HighestRoot ∨
        y ∈ rootSubgroup TwistTag.E6.tag K (-e6HighestRoot)) →
      Commute (g : ModGL TwistTag.E6.tag K) y) : g ∈ CentC := by
  have hle : twE6LongRootSL2 (twE6RootSubgroup K σ e6HighestRoot)
      (twE6RootSubgroup K σ (-e6HighestRoot)) ≤
        Subgroup.centralizer ({g} : Set (twistedE6RootGroup K σ)) := by
    refine (Subgroup.closure_le _).2 ?_
    intro h hh
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
    intro k hk
    rw [Set.mem_singleton_iff] at hk
    subst hk
    have hc : Commute (k : ModGL TwistTag.E6.tag K) (h : ModGL TwistTag.E6.tag K) := by
      rcases hh with hh | hh
      · exact hg _ (Or.inl hh)
      · exact hg _ (Or.inr hh)
    exact Subtype.ext hc.eq
  refine Subgroup.mem_centralizer_iff.2 fun h hh => ?_
  exact ((Subgroup.mem_centralizer_iff.1 (hle hh)) g rfl).symm

theorem ne_one_of_mem_orbit {a : Fin TwistTag.E6.foldedTag.rank} (ha : a ≠ 3)
    {j : Fin TwistTag.E6.tag.rank} (hj : j ∈ TwistTag.E6.orbit a) : j ≠ 1 := by
  rintro rfl
  exact ha ((TwistTag.E6.mem_orbit_iff.1 hj).symm.trans (by decide))

theorem xG_mem_centralizer {a : Fin TwistTag.E6.foldedTag.rank} (ha : a ≠ 3)
    (c : orbitField TwistTag.E6 K σ.toRingHom a) : xG σ a c ∈ CentC := by
  refine mem_centralizer_of_commute σ fun y hy => ?_
  rw [coe_xG, coe_orbitX]
  refine Commute.list_prod_left _ _ fun x hx => ?_
  obtain ⟨k, hk, rfl⟩ := List.mem_map.1 hx
  exact commute_xUnit_highest (ne_one_of_mem_orbit ha
    (TwistTag.E6.perm_pow_mem_orbit (TwistTag.E6.orbitMin_mem a) k)) _ hy

theorem yG_mem_centralizer {a : Fin TwistTag.E6.foldedTag.rank} (ha : a ≠ 3)
    (c : orbitField TwistTag.E6 K σ.toRingHom a) : yG σ a c ∈ CentC := by
  refine mem_centralizer_of_commute σ fun y hy => ?_
  rw [coe_yG, coe_orbitY]
  refine Commute.list_prod_left _ _ fun x hx => ?_
  obtain ⟨k, hk, rfl⟩ := List.mem_map.1 hx
  exact commute_yUnit_highest (ne_one_of_mem_orbit ha
    (TwistTag.E6.perm_pow_mem_orbit (TwistTag.E6.orbitMin_mem a) k)) _ hy

theorem nG_eq (a : Fin TwistTag.E6.foldedTag.rank) :
    nG σ a = xG σ a 1 * yG σ a (-1) * xG σ a 1 := by
  apply Subtype.ext
  rw [coe_nG, canonicalRep_orbitReflection_eq_orbitN TwistTag.E6 σ.toRingHom a]
  rfl

theorem hG_eq (a : Fin TwistTag.E6.foldedTag.rank)
    (u : (orbitField TwistTag.E6 K σ.toRingHom a)ˣ) :
    hG σ a u = (xG σ a u * yG σ a (-((u⁻¹ : (orbitField TwistTag.E6 K σ.toRingHom a)ˣ) :
      orbitField TwistTag.E6 K σ.toRingHom a)) * xG σ a u) *
        (xG σ a 1 * yG σ a (-1) * xG σ a 1)⁻¹ := by
  apply Subtype.ext
  rfl

theorem nG_mem_centralizer {a : Fin TwistTag.E6.foldedTag.rank} (ha : a ≠ 3) :
    nG σ a ∈ CentC := by
  rw [nG_eq]
  exact mul_mem (mul_mem (xG_mem_centralizer σ ha _) (yG_mem_centralizer σ ha _))
    (xG_mem_centralizer σ ha _)

theorem hG_mem_centralizer {a : Fin TwistTag.E6.foldedTag.rank} (ha : a ≠ 3)
    (u : (orbitField TwistTag.E6 K σ.toRingHom a)ˣ) : hG σ a u ∈ CentC := by
  rw [hG_eq]
  exact mul_mem (mul_mem (mul_mem (xG_mem_centralizer σ ha _) (yG_mem_centralizer σ ha _))
    (xG_mem_centralizer σ ha _)) (inv_mem (mul_mem (mul_mem (xG_mem_centralizer σ ha _)
      (yG_mem_centralizer σ ha _)) (xG_mem_centralizer σ ha _)))

theorem hG_mul_xG_mul_inv (a : Fin TwistTag.E6.foldedTag.rank)
    (u : (orbitField TwistTag.E6 K σ.toRingHom a)ˣ) (c : orbitField TwistTag.E6 K σ.toRingHom a) :
    hG σ a u * xG σ a c * (hG σ a u)⁻¹ =
      xG σ a ((u : orbitField TwistTag.E6 K σ.toRingHom a) ^ 2 * c) := by
  apply Subtype.ext
  have h := orbitH_mul_orbitX_mul_inv TwistTag.E6 σ.toRingHom a u c
  exact congrArg (Subtype.val : adjointGroup TwistTag.E6.tag K → ModGL TwistTag.E6.tag K) h

theorem hG_mul_yG_mul_inv (a : Fin TwistTag.E6.foldedTag.rank)
    (u : (orbitField TwistTag.E6 K σ.toRingHom a)ˣ) (c : orbitField TwistTag.E6 K σ.toRingHom a) :
    hG σ a u * yG σ a c * (hG σ a u)⁻¹ =
      yG σ a ((((u⁻¹ : (orbitField TwistTag.E6 K σ.toRingHom a)ˣ) :
        orbitField TwistTag.E6 K σ.toRingHom a)) ^ 2 * c) := by
  apply Subtype.ext
  simp only [Subgroup.coe_mul, Subgroup.coe_inv, coe_hG, coe_yG]
  rw [← orbitRankOneHom_HSL, ← orbitRankOneHom_vSL, ← map_inv, ← map_mul, ← map_mul,
    HSL_mul_vSL_mul_inv, orbitRankOneHom_vSL]

theorem nG_mul_xG_mul_inv (a : Fin TwistTag.E6.foldedTag.rank)
    (c : orbitField TwistTag.E6 K σ.toRingHom a) :
    nG σ a * xG σ a (-c) * (nG σ a)⁻¹ = yG σ a c := by
  apply Subtype.ext
  exact canonicalRep_orbitReflection_conj_orbitX TwistTag.E6 σ.toRingHom a c

theorem xG_neg (a : Fin TwistTag.E6.foldedTag.rank) (c : orbitField TwistTag.E6 K σ.toRingHom a) :
    xG σ a (-c) = (xG σ a c)⁻¹ := by
  rw [eq_inv_iff_mul_eq_one, ← xG_add, neg_add_cancel, xG_zero]

theorem xG_mem_levi_of_unit {a : Fin TwistTag.E6.foldedTag.rank} (ha : a ≠ 3)
    {u : (orbitField TwistTag.E6 K σ.toRingHom a)ˣ}
    (hu : (u : orbitField TwistTag.E6 K σ.toRingHom a) ^ 2 ≠ 1)
    (c : orbitField TwistTag.E6 K σ.toRingHom a) : xG σ a c ∈ LeviJ := by
  set b := c / ((u : orbitField TwistTag.E6 K σ.toRingHom a) ^ 2 - 1) with hbdef
  have hb : (u : orbitField TwistTag.E6 K σ.toRingHom a) ^ 2 * b + -b = c := by
    have h1 : (u : orbitField TwistTag.E6 K σ.toRingHom a) ^ 2 - 1 ≠ 0 := sub_ne_zero.2 hu
    rw [hbdef]
    field_simp
    ring
  have hcomm : hG σ a u * xG σ a b * (hG σ a u)⁻¹ * (xG σ a b)⁻¹ = xG σ a c := by
    rw [hG_mul_xG_mul_inv, ← xG_neg, ← xG_add, hb]
  rw [← hcomm, ← commutatorElement_def]
  exact Subgroup.commutator_mem_commutator (hG_mem_centralizer σ ha u)
    (xG_mem_centralizer σ ha b)

theorem yG_mem_levi_of_x {a : Fin TwistTag.E6.foldedTag.rank} (ha : a ≠ 3)
    (hx : ∀ c : orbitField TwistTag.E6 K σ.toRingHom a, xG σ a c ∈ LeviJ)
    (c : orbitField TwistTag.E6 K σ.toRingHom a) : yG σ a c ∈ LeviJ := by
  rw [← nG_mul_xG_mul_inv]
  exact conj_mem_commutator_self (nG_mem_centralizer σ ha) (hx (-c))

theorem nG_mem_levi_of_x {a : Fin TwistTag.E6.foldedTag.rank} (ha : a ≠ 3)
    (hx : ∀ c : orbitField TwistTag.E6 K σ.toRingHom a, xG σ a c ∈ LeviJ) :
    nG σ a ∈ LeviJ := by
  rw [nG_eq]
  exact mul_mem (mul_mem (hx 1) (yG_mem_levi_of_x σ ha hx (-1))) (hx 1)

