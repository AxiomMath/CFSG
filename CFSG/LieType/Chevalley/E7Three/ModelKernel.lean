local instance modelKernelNeZeroRankE7 : NeZero Tag.E7.rank := ⟨by decide⟩

@[expose] def modelWord (a b c d : ℕ) : List (Fin Tag.E7.rank) :=
  nfWordE7 a b c ++ (List.replicate d wordE7C).flatten

@[expose] def scalarVec : Fin Tag.E7.rank → ZMod 3 := ![0, 0, 1, 0, 0, 0, 0]

@[expose] def dot3 (e : Fin Tag.E7.rank → ZMod 3) (v : Fin Tag.E7.rank → ℤ) : ZMod 3 :=
  e 0 * (v 0 : ZMod 3) + e 1 * (v 1 : ZMod 3) + e 2 * (v 2 : ZMod 3) + e 3 * (v 3 : ZMod 3) +
    e 4 * (v 4 : ZMod 3) + e 5 * (v 5 : ZMod 3) + e 6 * (v 6 : ZMod 3)

theorem dot3_eq (e : Fin Tag.E7.rank → ZMod 3) (v : Fin Tag.E7.rank → ℤ) :
    dot3 e v = triPairing e v := by
  rw [triPairing]
  change _ = ∑ j : Fin 7, e j * ((v j : ℤ) : ZMod 3)
  rw [Fin.sum_univ_seven]
  rfl

@[expose] def veqZ (v v' : Fin Tag.E7.rank → ℤ) : Bool :=
  (List.finRange Tag.E7.rank).all fun j => decide (v j = v' j)

theorem veqZ_iff {v v' : Fin Tag.E7.rank → ℤ} : veqZ v v' = true ↔ v = v' := by
  rw [veqZ, List.all_eq_true]
  simp only [List.mem_finRange, decide_eq_true_eq, true_implies]
  exact ⟨fun h => funext h, fun h j => h ▸ rfl⟩

@[expose] def veq3 (e e' : Fin Tag.E7.rank → ZMod 3) : Bool :=
  (List.finRange Tag.E7.rank).all fun j => decide (e j = e' j)

theorem veq3_iff {e e' : Fin Tag.E7.rank → ZMod 3} : veq3 e e' = true ↔ e = e' := by
  rw [veq3, List.all_eq_true]
  simp only [List.mem_finRange, decide_eq_true_eq, true_implies]
  exact ⟨fun h => funext h, fun h j => h ▸ rfl⟩

structure ReflCert where
  u : List (Fin Tag.E7.rank)
  i : Fin Tag.E7.rank
  v : Fin Tag.E7.rank → ℤ
  y : Fin Tag.E7.rank → ℤ

inductive ModelCert where
  | refl (R : List ReflCert)
  | nine (j : Fin Tag.E7.rank)
  | levi (cols : Fin Tag.E7.rank → Fin Tag.E7.rank → ℤ)
      (tbl : List ((Fin Tag.E7.rank → ZMod 3) × List (Fin Tag.E7.rank)))

@[expose] def reflWord (r : ReflCert) : List (Fin Tag.E7.rank) := r.u ++ [r.i] ++ r.u.reverse

@[expose] def ModelCert.check (ω : List (Fin Tag.E7.rank)) : ModelCert → Bool
  | .refl R =>
    ((List.finRange Tag.E7.rank).all fun j =>
      veqZ (wordAct .E7 ω (Pi.single j 1)) (wordAct .E7 (R.flatMap reflWord) (Pi.single j 1))) &&
    R.all fun r => veqZ (wordAct .E7 r.u (Pi.single r.i 1)) (r.v - wordAct .E7 ω r.v + 3 • r.y)
  | .nine j => !veqZ (wordAct .E7 (ω ++ ω ++ ω) (Pi.single j 1)) (Pi.single j 1)
  | .levi cols tbl =>
    ((List.finRange Tag.E7.rank).all fun j => veqZ (wordAct .E7 ω (Pi.single j 1)) (cols j)) &&
    (tbl.all fun p => veq3 (triAct p.2 scalarVec) p.1) &&
    ((List.range (3 ^ 7)).all fun n =>
      !((List.finRange Tag.E7.rank).all fun j =>
          decide (dot3 (vec3OfIndex n) (cols j) = vec3OfIndex n j)) ||
        (ω.all fun i => decide (vec3OfIndex (τ := .E7) n i = 0)) ||
        tbl.any fun p => veq3 p.1 (vec3OfIndex n))

