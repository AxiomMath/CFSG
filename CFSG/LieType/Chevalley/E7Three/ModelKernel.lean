@[expose] def modelCert (a b c d : ℕ) : ModelCert :=
  modelCerts.getD (27 * a + 9 * b + 3 * c + d) (.nine 0)

set_option maxRecDepth 100000 in
theorem modelCert_check : ∀ a b c d : Fin 3,
    (modelCert a b c d).check (modelWord a b c d) = true := by
  decide +kernel

theorem triPairing_sub (e : Fin Tag.E7.rank → ZMod 3) (u v : Fin Tag.E7.rank → ℤ) :
    triPairing e (u - v) = triPairing e u - triPairing e v := by
  have h := triPairing_add e (u - v) v
  rw [sub_add_cancel] at h
  rw [h, add_sub_cancel_right]

theorem triPairing_three_smul (e : Fin Tag.E7.rank → ZMod 3) (y : Fin Tag.E7.rank → ℤ) :
    triPairing e (3 • y) = 0 := by
  have h3 : (3 : ZMod 3) = 0 := rfl
  rw [triPairing]
  refine Finset.sum_eq_zero fun j _ => ?_
  rw [Pi.smul_apply, nsmul_eq_mul]
  push_cast
  rw [h3, zero_mul, mul_zero]

theorem triPairing_single (e : Fin Tag.E7.rank → ZMod 3) (j : Fin Tag.E7.rank) :
    triPairing e (Pi.single j 1) = e j := by
  have h := triPairing_zsmul_single e 1 j
  rwa [one_smul, Int.cast_one, mul_one] at h

theorem wordProd_reflWord (r : ReflCert) :
    (coxeterSystem .E7).wordProd (reflWord r) = (coxeterSystem .E7).wordProd r.u *
      simple .E7 r.i * ((coxeterSystem .E7).wordProd r.u)⁻¹ := by
  rw [reflWord, CoxeterSystem.wordProd_append, CoxeterSystem.wordProd_append,
    CoxeterSystem.wordProd_singleton, CoxeterSystem.wordProd_reverse]

theorem wordProd_flatMap_reflWord (R : List ReflCert) :
    (coxeterSystem .E7).wordProd (R.flatMap reflWord) = (R.map fun r =>
      (coxeterSystem .E7).wordProd r.u * simple .E7 r.i *
        ((coxeterSystem .E7).wordProd r.u)⁻¹).prod := by
  induction R with
  | nil => simp
  | cons r R ih =>
    rw [List.flatMap_cons, CoxeterSystem.wordProd_append, ih, wordProd_reflWord, List.map_cons,
      List.prod_cons]

theorem wordProd_eq_of_check_refl {ω : List (Fin Tag.E7.rank)} {R : List ReflCert}
    (h : (ModelCert.refl R).check ω = true) :
    (coxeterSystem .E7).wordProd ω = (R.map fun r =>
      (coxeterSystem .E7).wordProd r.u * simple .E7 r.i *
        ((coxeterSystem .E7).wordProd r.u)⁻¹).prod := by
  rw [← wordProd_flatMap_reflWord]
  simp only [ModelCert.check, Bool.and_eq_true, List.all_eq_true] at h
  refine CFSG.LieType.Chevalley.ext_single fun j => ?_
  rw [CFSG.StandardType.TableBExc.wordProd_smul, CFSG.StandardType.TableBExc.wordProd_smul]
  exact veqZ_iff.1 (h.1 j (List.mem_finRange j))

theorem triPairing_eq_zero_of_check_refl {ω : List (Fin Tag.E7.rank)} {R : List ReflCert}
    (h : (ModelCert.refl R).check ω = true) {e : Fin Tag.E7.rank → ZMod 3}
    (hfix : ∀ v, triPairing e ((coxeterSystem .E7).wordProd ω • v) = triPairing e v)
    {r : ReflCert} (hr : r ∈ R) :
    triPairing e ((coxeterSystem .E7).wordProd r.u • Pi.single r.i 1) = 0 := by
  simp only [ModelCert.check, Bool.and_eq_true, List.all_eq_true] at h
  rw [CFSG.StandardType.TableBExc.wordProd_smul, veqZ_iff.1 (h.2 r hr), triPairing_add, triPairing_sub,
    triPairing_three_smul, ← CFSG.StandardType.TableBExc.wordProd_smul, hfix, sub_self, add_zero]

theorem pow_three_ne_one_of_check_nine {ω : List (Fin Tag.E7.rank)} {j : Fin Tag.E7.rank}
    (h : (ModelCert.nine j).check ω = true) : (coxeterSystem .E7).wordProd ω ^ 3 ≠ 1 := by
  intro h3
  have e : wordAct .E7 (ω ++ ω ++ ω) (Pi.single j 1) = Pi.single j 1 := by
    rw [← CFSG.StandardType.TableBExc.wordProd_smul, CoxeterSystem.wordProd_append, CoxeterSystem.wordProd_append,
      show (coxeterSystem .E7).wordProd ω * (coxeterSystem .E7).wordProd ω *
        (coxeterSystem .E7).wordProd ω = (coxeterSystem .E7).wordProd ω ^ 3 by
          rw [pow_succ, pow_two], h3,
      one_smul]
  simp only [ModelCert.check, veqZ_iff.2 e, Bool.not_true] at h
  exact Bool.false_ne_true h

theorem levi_of_check {ω : List (Fin Tag.E7.rank)} {cols : Fin Tag.E7.rank → Fin Tag.E7.rank → ℤ}
    {tbl : List ((Fin Tag.E7.rank → ZMod 3) × List (Fin Tag.E7.rank))}
    (h : (ModelCert.levi cols tbl).check ω = true) {e : Fin Tag.E7.rank → ZMod 3}
    (hfix : ∀ v, triPairing e ((coxeterSystem .E7).wordProd ω • v) = triPairing e v) :
    (∀ i ∈ ω, e i = 0) ∨ ∃ ω' : List (Fin Tag.E7.rank), triAct ω' scalarVec = e := by
  simp only [ModelCert.check, Bool.and_eq_true, List.all_eq_true] at h
  obtain ⟨⟨hcols, htbl⟩, henum⟩ := h
  obtain ⟨n, hn, rfl⟩ := exists_vec3OfIndex (τ := .E7) e
  have hn' := henum n (List.mem_range.2 hn)
  have hfixed : ((List.finRange Tag.E7.rank).all fun j =>
      decide (dot3 (vec3OfIndex n) (cols j) = vec3OfIndex n j)) = true := by
    rw [List.all_eq_true]
    intro j _
    rw [decide_eq_true_eq, dot3_eq, ← veqZ_iff.1 (hcols j (List.mem_finRange j)),
      ← CFSG.StandardType.TableBExc.wordProd_smul, hfix, triPairing_single]
  rw [hfixed, Bool.not_true, Bool.false_or, Bool.or_eq_true] at hn'
  rcases hn' with h1 | h2
  · left
    rw [List.all_eq_true] at h1
    exact fun i hi => of_decide_eq_true (h1 i hi)
  · right
    obtain ⟨p, hp, hpe⟩ := List.any_eq_true.1 h2
    exact ⟨p.2, (veq3_iff.1 (htbl p hp)).trans (veq3_iff.1 hpe)⟩

theorem exists_kernel_word {a b c d : ℕ} (ha : a < 3) (hb : b < 3) (hc : c < 3) (hd : d < 3)
    (hw3 : (coxeterSystem .E7).wordProd (modelWord a b c d) ^ 3 = 1)
    {ι : Type*} (e : ι → Fin Tag.E7.rank → ZMod 3)
    (hfix : ∀ k v, triPairing (e k) ((coxeterSystem .E7).wordProd (modelWord a b c d) • v) =
      triPairing (e k) v)
    (hfree : ∀ k ω, triAct ω scalarVec ≠ e k) :
    ∃ R : List (List (Fin Tag.E7.rank) × Fin Tag.E7.rank),
      (coxeterSystem .E7).wordProd (modelWord a b c d) = (R.map fun p =>
        (coxeterSystem .E7).wordProd p.1 * simple .E7 p.2 *
          ((coxeterSystem .E7).wordProd p.1)⁻¹).prod ∧
      ∀ p ∈ R, ∀ k, triPairing (e k) ((coxeterSystem .E7).wordProd p.1 • Pi.single p.2 1) = 0 := by
  have hcheck := modelCert_check ⟨a, ha⟩ ⟨b, hb⟩ ⟨c, hc⟩ ⟨d, hd⟩
  change (modelCert a b c d).check (modelWord a b c d) = true at hcheck
  generalize modelCert a b c d = M at hcheck
  cases M with
  | refl R =>
    refine ⟨R.map fun r => (r.u, r.i), ?_, ?_⟩
    · rw [wordProd_eq_of_check_refl hcheck, List.map_map]
      rfl
    · intro p hp k
      obtain ⟨r, hr, rfl⟩ := List.mem_map.1 hp
      exact triPairing_eq_zero_of_check_refl hcheck (hfix k) hr
  | nine j => exact absurd hw3 (pow_three_ne_one_of_check_nine hcheck)
  | levi cols tbl =>
    refine ⟨(modelWord a b c d).map fun i => ([], i), ?_, ?_⟩
    · rw [List.map_map]
      change (coxeterSystem .E7).wordProd (modelWord a b c d) =
        ((modelWord a b c d).map fun i => (coxeterSystem .E7).wordProd [] * simple .E7 i *
          ((coxeterSystem .E7).wordProd [])⁻¹).prod
      simp only [CoxeterSystem.wordProd_nil, one_mul, inv_one, mul_one]
      rfl
    · intro p hp k
      obtain ⟨i, hi, rfl⟩ := List.mem_map.1 hp
      rcases levi_of_check hcheck (hfix k) with h0 | ⟨ω, hω⟩
      · rw [CoxeterSystem.wordProd_nil, one_smul, triPairing_single]
        exact h0 i hi
      · exact absurd hω (hfree k ω)

