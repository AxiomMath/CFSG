theorem kernelRootWitness_E8
    : ∀ ρ < e8SignReps.length, ∀ α : Fin Tag.E8.rank → ℤ,
    α ∈ kernelRoots (maskChar (listMask (e8SignReps.getD ρ []))) →
      KernelRootWitness (maskChar (listMask (e8SignReps.getD ρ []))) α := by
  intro ρ hρ α hα
  have hlen : e8SignReps.length = 3 := rfl
  rw [hlen] at hρ
  interval_cases ρ
  · exact WitCert.kernelRootWitness_of_check e8Certificate_check e8WitCert0_check
      (fun h => absurd h (by decide)) (fun h => absurd h (by decide)) hα
  · exact WitCert.kernelRootWitness_of_check e8Certificate_check e8WitCert1_check
      (fun h => absurd h (by decide)) (fun h => absurd h (by decide)) hα
  · exact WitCert.kernelRootWitness_of_check e8Certificate_check e8WitCert2_check
      (fun h => absurd h (by decide)) (fun h => absurd h (by decide)) hα

