theorem kernelRootWitness_E7
    : ∀ ρ < e7SignReps.length, ∀ α : Fin Tag.E7.rank → ℤ,
    α ∈ kernelRoots (maskChar (listMask (e7SignReps.getD ρ []))) →
      KernelRootWitness (maskChar (listMask (e7SignReps.getD ρ []))) α := by
  intro ρ hρ α hα
  have hlen : e7SignReps.length = 4 := rfl
  rw [hlen] at hρ
  interval_cases ρ
  · exact WitCert.kernelRootWitness_of_check e7Certificate_check e7WitCert0_check
      (fun h => absurd h (by decide)) (fun h => absurd h (by decide)) hα
  · exact WitCert.kernelRootWitness_of_check e7Certificate_check e7WitCert1_check
      (fun h => absurd h (by decide)) (fun h => absurd h (by decide)) hα
  · exact WitCert.kernelRootWitness_of_check e7Certificate_check e7WitCert2_check
      (fun h => absurd h (by decide)) (fun h => absurd h (by decide)) hα
  · exact WitCert.kernelRootWitness_of_check e7Certificate_check e7WitCert3_check
      (fun h => absurd h (by decide)) (fun h => absurd h (by decide)) hα

