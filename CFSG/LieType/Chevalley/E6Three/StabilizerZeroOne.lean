theorem orbOne_nodup : CFSG.Decide.bitsetNodup (orbOneCodes.map fun c =>
    pairKey (triAct (decodeWord 20 c) (positionBasis 1 0))
      (triAct (decodeWord 20 c) (positionBasis 1 1))) = true := by
  simp only [positionBasis_one_zero, positionBasis_one_one, triAct_toFun, pairKey_toFun]
  decide +kernel

theorem stabOneWords_fix : stabOneWords.all (fun σ =>
    veq3 (triAct σ (positionBasis 1 0)) (positionBasis 1 0) &&
      veq3 (triAct σ (positionBasis 1 1)) (positionBasis 1 1)) = true := by
  decide +kernel

theorem stabOneWords_nodup :
    (stabOneWords.map fun σ => List.ofFn (CFSG.RankThree.Chevalley.wordAct .E6 σ sepVec)).Nodup := by
  decide +kernel

theorem card_stabOne :
    Nat.card (stabPair (positionBasis 1 0) (positionBasis 1 1)) = 24 :=
  (card_stabPair_of_certificates orbOne_nodup stabOneWords_fix stabOneWords_nodup
    (by decide +kernel)).trans (by decide +kernel)

theorem isSolvable_stabOne :
    Group.IsSolvable (stabPair (positionBasis 1 0) (positionBasis 1 1)) :=
  CFSG.Quasithin.E6.Alt.A6.isSolvable_of_card_dvd_24 (by rw [card_stabOne])

