theorem orbFourCodes_length : orbFourCodes.length = 1920 := by decide +kernel

theorem orbFour_nodup : CFSG.Decide.bitsetNodup (orbFourCodes.map fun c =>
    pairKey (triAct (decodeWord 20 c) (positionBasis 4 0))
      (triAct (decodeWord 20 c) (positionBasis 4 1))) = true := by
  decide +kernel

theorem stabFourWords_length : stabFourWords.length = 27 := by decide +kernel

theorem stabFourWords_fix : stabFourWords.all (fun σ =>
    veq3 (triAct σ (positionBasis 4 0)) (positionBasis 4 0) &&
      veq3 (triAct σ (positionBasis 4 1)) (positionBasis 4 1)) = true := by
  decide +kernel

theorem stabFourWords_nodup :
    (stabFourWords.map fun σ => List.ofFn (wordAct .E6 σ sepVec)).Nodup := by
  decide +kernel

theorem card_stabPair_of_certificates
    {x y : Fin Tag.E6.rank → ZMod 3} {codes : List ℕ} {words : List (List (Fin Tag.E6.rank))}
    {sep : Fin Tag.E6.rank → ℤ}
    (hcodes : CFSG.Decide.bitsetNodup (codes.map fun c =>
      pairKey (triAct (decodeWord 20 c) x) (triAct (decodeWord 20 c) y)) = true)
    (hfix : words.all (fun σ => veq3 (triAct σ x) x && veq3 (triAct σ y) y) = true)
    (hsep : (words.map fun σ => List.ofFn (wordAct .E6 σ sep)).Nodup)
    (hprod : codes.length * words.length = 51840) :
    Nat.card (stabPair x y) = words.length := by
  classical
  letI := pairAction
  have hstab : MulAction.stabilizer (WeylGroup .E6) (x, y) = stabPair x y := by
    ext w
    rw [MulAction.mem_stabilizer_iff]
    change (adAct .E6 3 w x, adAct .E6 3 w y) = (x, y) ↔ _
    rw [Prod.ext_iff]
    rfl
  have horb : codes.length ≤ (MulAction.orbit (WeylGroup .E6) (x, y)).ncard := by
    let key : ℕ → ℕ := fun c => pairKey (triAct (decodeWord 20 c) x) (triAct (decodeWord 20 c) y)
    let f : Fin codes.length → (Fin Tag.E6.rank → ZMod 3) × (Fin Tag.E6.rank → ZMod 3) :=
      fun j => (triAct (decodeWord 20 (codes.get j)) x, triAct (decodeWord 20 (codes.get j)) y)
    have hnd : (codes.map key).Nodup := CFSG.Decide.nodup_of_bitsetNodup_nat hcodes
    have hinj : Function.Injective f := by
      intro i j hij
      have hk : key (codes.get i) = key (codes.get j) := by
        have h1 := congrArg Prod.fst hij
        have h2 := congrArg Prod.snd hij
        change triAct (decodeWord 20 (codes.get i)) x = triAct (decodeWord 20 (codes.get j)) x
          at h1
        change triAct (decodeWord 20 (codes.get i)) y = triAct (decodeWord 20 (codes.get j)) y
          at h2
        change pairKey _ _ = pairKey _ _
        rw [h1, h2]
      exact (hnd.of_map key).get_inj_iff.1
        (List.inj_on_of_nodup_map hnd (List.get_mem _ i) (List.get_mem _ j) hk)
    have hsub : Set.range f ⊆ MulAction.orbit (WeylGroup .E6) (x, y) := by
      rintro _ ⟨j, rfl⟩
      refine ⟨(coxeterSystem .E6).wordProd (decodeWord 20 (codes.get j)), ?_⟩
      change (adAct .E6 3 _ x, adAct .E6 3 _ y) = f j
      rw [adAct_wordProd_eq_triAct, adAct_wordProd_eq_triAct]
    have h := Set.ncard_le_ncard hsub (Set.toFinite _)
    rwa [Set.ncard_range_of_injective hinj, Nat.card_eq_fintype_card, Fintype.card_fin] at h
  have hst : words.length ≤ Nat.card (stabPair x y) := by
    let F : List (Fin Tag.E6.rank) → List ℤ := fun σ => List.ofFn (wordAct .E6 σ sep)
    have hfix' := List.all_eq_true.1 hfix
    let g : Fin words.length → stabPair x y := fun j =>
      ⟨(coxeterSystem .E6).wordProd (words.get j), by
        have h := hfix' _ (List.get_mem _ j)
        simp only [Bool.and_eq_true] at h
        exact ⟨by rw [adAct_wordProd_eq_triAct]; exact veq3_iff.1 h.1,
          by rw [adAct_wordProd_eq_triAct]; exact veq3_iff.1 h.2⟩⟩
    have hinj : Function.Injective g := by
      intro i j hij
      have h1 : (coxeterSystem .E6).wordProd (words.get i) =
          (coxeterSystem .E6).wordProd (words.get j) := congrArg Subtype.val hij
      have h2 : F (words.get i) = F (words.get j) := by
        change List.ofFn (wordAct .E6 _ sep) = List.ofFn (wordAct .E6 _ sep)
        rw [← CFSG.StandardType.TableBExc.wordProd_smul,
          ← CFSG.StandardType.TableBExc.wordProd_smul, h1]
      exact (hsep.of_map F).get_inj_iff.1
        (List.inj_on_of_nodup_map hsep (List.get_mem _ i) (List.get_mem _ j) h2)
    have h := Nat.card_le_card_of_injective g hinj
    rwa [Nat.card_eq_fintype_card, Fintype.card_fin] at h
  have hcard := Subgroup.card_mul_index (stabPair x y)
  rw [← hstab, MulAction.index_stabilizer, hstab, CFSG.StandardType.NoOffExc.card_weyl_E6] at hcard
  have hpos : 0 < codes.length := by
    rcases Nat.eq_zero_or_pos codes.length with h0 | h0
    · rw [h0, zero_mul] at hprod
      exact absurd hprod (by norm_num)
    · exact h0
  refine le_antisymm ?_ hst
  have h1 : Nat.card (stabPair x y) * codes.length ≤ words.length * codes.length := by
    calc Nat.card (stabPair x y) * codes.length
        ≤ Nat.card (stabPair x y) * (MulAction.orbit (WeylGroup .E6) (x, y)).ncard :=
          Nat.mul_le_mul_left _ horb
      _ = words.length * codes.length := by rw [hcard, ← hprod, mul_comm]
  exact Nat.le_of_mul_le_mul_right h1 hpos

theorem card_stabFour :
    Nat.card stabFour = 27 :=
  (card_stabPair_of_certificates orbFour_nodup stabFourWords_fix stabFourWords_nodup
    (by rw [orbFourCodes_length, stabFourWords_length])).trans stabFourWords_length

theorem isPGroup_stabFour :
    IsPGroup 3 stabFour := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact IsPGroup.of_card (n := 3) (by rw [card_stabFour]; norm_num)

end CFSG.LieType.Chevalley.E6Three.StabilizerFour
