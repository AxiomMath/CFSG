@[expose] noncomputable def stabPair (x y : Fin Tag.E6.rank → ZMod 3) :
    Subgroup (WeylGroup .E6) where
  carrier := {w | adAct .E6 3 w x = x ∧ adAct .E6 3 w y = y}
  mul_mem' {a b} ha hb := ⟨by rw [adAct_mul, hb.1, ha.1], by rw [adAct_mul, hb.2, ha.2]⟩
  one_mem' := ⟨adAct_one _, adAct_one _⟩
  inv_mem' {a} ha := by
    refine ⟨?_, ?_⟩
    · calc adAct .E6 3 a⁻¹ x = adAct .E6 3 a⁻¹ (adAct .E6 3 a x) := by rw [ha.1]
        _ = x := by rw [← adAct_mul, inv_mul_cancel, adAct_one]
    · calc adAct .E6 3 a⁻¹ y = adAct .E6 3 a⁻¹ (adAct .E6 3 a y) := by rw [ha.2]
        _ = y := by rw [← adAct_mul, inv_mul_cancel, adAct_one]

@[expose] noncomputable def stabFour : Subgroup (WeylGroup .E6) :=
  stabPair (positionBasis 4 0) (positionBasis 4 1)

theorem adAct_eq_self_of_triPairing {w : WeylGroup .E6} {x : Fin Tag.E6.rank → ZMod 3}
    (hx : ∀ v, triPairing x (w • v) = triPairing x v) : adAct .E6 3 w x = x := by
  funext j
  have h := hx (w⁻¹ • (Pi.single j 1 : Fin Tag.E6.rank → ℤ))
  rw [smul_inv_smul, triPairing_single] at h
  rw [h]
  simp only [adAct, triPairing]
  exact Finset.sum_congr rfl fun m _ => mul_comm _ _

theorem mem_stabPair_of_mem_familyStabilizer {L : Type} [Field L] {ζ : Lˣ}
    (hζo : orderOf ζ = 3) (hζ : ζ ^ 3 = 1) (b : Fin 2 → Fin Tag.E6.rank → ZMod 3)
    {w : WeylGroup .E6}
    (hw : w ∈ CFSG.HardMathSupport.Timmesfeld.Torality.familyStabilizer
      fun i : Fin 2 => zetaVec ζ hζ (b i)) :
    w ∈ stabPair (b 0) (b 1) :=
  ⟨adAct_eq_self_of_triPairing ((mem_rootCharStabilizer_zetaVec_iff hζo hζ _ w).1 (hw 0)),
    adAct_eq_self_of_triPairing ((mem_rootCharStabilizer_zetaVec_iff hζo hζ _ w).1 (hw 1))⟩

@[expose, instance_reducible] noncomputable def pairAction :
    MulAction (WeylGroup .E6) ((Fin Tag.E6.rank → ZMod 3) × (Fin Tag.E6.rank → ZMod 3)) where
  smul w p := (adAct .E6 3 w p.1, adAct .E6 3 w p.2)
  one_smul p := Prod.ext (adAct_one _) (adAct_one _)
  mul_smul w w' p := Prod.ext (adAct_mul w w' _) (adAct_mul w w' _)

@[expose] def pairKey (x y : Fin Tag.E6.rank → ZMod 3) : ℕ :=
  (x 0).val + 3 * ((x 1).val + 3 * ((x 2).val + 3 * ((x 3).val + 3 * ((x 4).val +
    3 * ((x 5).val + 3 * ((y 0).val + 3 * ((y 1).val + 3 * ((y 2).val + 3 * ((y 3).val +
      3 * ((y 4).val + 3 * (y 5).val))))))))))

@[expose] def decodeWord : ℕ → ℕ → List (Fin Tag.E6.rank)
  | 0, _ => []
  | fuel + 1, c => if c = 0 then [] else
      (⟨(c % 7 + 5) % 6, Nat.mod_lt _ (by decide)⟩ : Fin Tag.E6.rank) :: decodeWord fuel (c / 7)

