theorem orbThreeCodes_length : orbThreeCodes.length = 2880 := by decide +kernel

open StabilizerN6 in
theorem orbThreeKeys_one : orbThreeCodesOne.map keyThree = orbThreeKeysOne := by
  have h : keyThree = fun c => N6.key (N6.tact (decodeWord 20 c) ⟨1, 2, 1, 0, 0, 0⟩)
      (N6.tact (decodeWord 20 c) ⟨0, 0, 0, 1, 0, 0⟩) := by
    funext c
    rw [keyThree, positionBasis_three_zero, positionBasis_three_one, triAct_toFun, triAct_toFun,
      pairKey_toFun]
  rw [h]
  refine beq_iff_eq.1 ?_
  decide +kernel

