theorem orbThreeKeys_nodup : CFSG.Decide.bitsetNodup
    (orbThreeKeysOne ++ orbThreeKeysTwo ++ orbThreeKeysThree ++ orbThreeKeysFour) = true := by
  decide +kernel

theorem orbThree_nodup : CFSG.Decide.bitsetNodup (orbThreeCodes.map fun c =>
    pairKey (triAct (decodeWord 20 c) (positionBasis 3 0))
      (triAct (decodeWord 20 c) (positionBasis 3 1))) = true := by
  change CFSG.Decide.bitsetNodup (orbThreeCodes.map keyThree) = true
  rw [orbThreeCodes, List.map_append, List.map_append, List.map_append, orbThreeKeys_one,
    orbThreeKeys_two, orbThreeKeys_three, orbThreeKeys_four]
  exact orbThreeKeys_nodup

theorem stabThreeWords_length : stabThreeWords.length = 18 := by decide +kernel

theorem stabThreeWords_fix : stabThreeWords.all (fun σ =>
    veq3 (triAct σ (positionBasis 3 0)) (positionBasis 3 0) &&
      veq3 (triAct σ (positionBasis 3 1)) (positionBasis 3 1)) = true := by
  decide +kernel

theorem stabThreeWords_nodup :
    (stabThreeWords.map fun σ => List.ofFn (wordAct .E6 σ sepThree)).Nodup := by
  decide +kernel

@[expose] noncomputable def stabThree : Subgroup (WeylGroup .E6) :=
  stabPair (positionBasis 3 0) (positionBasis 3 1)

theorem card_stabThree :
    Nat.card stabThree = 18 :=
  (card_stabPair_of_certificates orbThree_nodup stabThreeWords_fix stabThreeWords_nodup
    (by rw [orbThreeCodes_length, stabThreeWords_length])).trans stabThreeWords_length

theorem isSolvable_stabThree :
    Group.IsSolvable stabThree :=
  isSolvable_of_card_eq_eighteen card_stabThree

theorem mem_stabThree_of_mem_familyStabilizer {L : Type} [Field L] {ζ : Lˣ}
    (hζo : orderOf ζ = 3) (hζ : ζ ^ 3 = 1) {w : WeylGroup .E6}
    (hw : w ∈ CFSG.HardMathSupport.Timmesfeld.Torality.familyStabilizer
      fun i : Fin 2 => zetaVec ζ hζ (positionBasis 3 i)) :
    w ∈ stabThree :=
  mem_stabPair_of_mem_familyStabilizer hζo hζ (positionBasis 3) hw

