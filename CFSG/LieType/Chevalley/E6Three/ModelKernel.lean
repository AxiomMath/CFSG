@[expose] def dot6 (e : Fin Tag.E6.rank → ZMod 3) (v : Fin Tag.E6.rank → ℤ) : ZMod 3 :=
  e 0 * (v 0 : ZMod 3) + e 1 * (v 1 : ZMod 3) + e 2 * (v 2 : ZMod 3) + e 3 * (v 3 : ZMod 3) +
    e 4 * (v 4 : ZMod 3) + e 5 * (v 5 : ZMod 3)

theorem dot6_eq (e : Fin Tag.E6.rank → ZMod 3) (v : Fin Tag.E6.rank → ℤ) :
    dot6 e v = triPairing e v := by
  rw [triPairing]
  change _ = ∑ j : Fin 6, e j * ((v j : ℤ) : ZMod 3)
  rw [Fin.sum_univ_six]
  rfl

@[expose] def veqZ (v v' : Fin Tag.E6.rank → ℤ) : Bool :=
  (List.finRange Tag.E6.rank).all fun j => decide (v j = v' j)

theorem veqZ_iff {v v' : Fin Tag.E6.rank → ℤ} : veqZ v v' = true ↔ v = v' := by
  rw [veqZ, List.all_eq_true]
  simp only [List.mem_finRange, decide_eq_true_eq, true_implies]
  exact ⟨fun h => funext h, fun h j => h ▸ rfl⟩

@[expose] def veq3 (e e' : Fin Tag.E6.rank → ZMod 3) : Bool :=
  (List.finRange Tag.E6.rank).all fun j => decide (e j = e' j)

theorem veq3_iff {e e' : Fin Tag.E6.rank → ZMod 3} : veq3 e e' = true ↔ e = e' := by
  rw [veq3, List.all_eq_true]
  simp only [List.mem_finRange, decide_eq_true_eq, true_implies]
  exact ⟨fun h => funext h, fun h j => h ▸ rfl⟩

@[expose] def comb3 (f : Fin 3 → Fin Tag.E6.rank → ZMod 3) (c : Fin 3 → ZMod 3) :
    Fin Tag.E6.rank → ZMod 3 :=
  c 0 • f 0 + c 1 • f 1 + c 2 • f 2

@[expose] def coeff3 (P : Fin 3 → Fin Tag.E6.rank → ZMod 3) (z : Fin Tag.E6.rank → ZMod 3) :
    Fin 3 → ZMod 3 :=
  fun k => P k 0 * z 0 + P k 1 * z 1 + P k 2 * z 2 + P k 3 * z 3 + P k 4 * z 4 + P k 5 * z 5

@[expose] def dot33 (a b : Fin 3 → ZMod 3) : ZMod 3 := a 0 * b 0 + a 1 * b 1 + a 2 * b 2

