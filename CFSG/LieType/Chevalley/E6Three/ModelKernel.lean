@[expose] def wordOfIndex (m : ℕ) : List (Fin Tag.E6.rank) :=
  modelWordE6 ![((m / 27 % 3 : ℕ) : ZMod 3), ((m / 9 % 3 : ℕ) : ZMod 3), ((m / 3 % 3 : ℕ) : ZMod 3)]
    ((m % 3 : ℕ) : ZMod 3)

@[expose] def checkAt (m : ℕ) : Bool := (modelCerts.getD m (.nine 0)).check (wordOfIndex m)

