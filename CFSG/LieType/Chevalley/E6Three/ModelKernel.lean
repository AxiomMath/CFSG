set_option maxRecDepth 100000 in
theorem checkAt_1 : (List.range' 9 9).all checkAt = true := by decide +kernel
set_option maxRecDepth 100000 in
theorem checkAt_2 : (List.range' 18 9).all checkAt = true := by decide +kernel
set_option maxRecDepth 100000 in
