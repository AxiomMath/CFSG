@[expose] def matVec (M : Fin Tag.E6.rank → Fin Tag.E6.rank → ℤ) (v : Fin Tag.E6.rank → ℤ) :
    Fin Tag.E6.rank → ℤ :=
  v 0 • M 0 + v 1 • M 1 + v 2 • M 2 + v 3 • M 3 + v 4 • M 4 + v 5 • M 5

@[expose] def inPosition (k : Fin 5) (z : Fin Tag.E6.rank → ZMod 3) : Bool :=
  (List.finRange 3).any fun s => (List.finRange 3).any fun t =>
    veq3 z (((s : ℕ) : ZMod 3) • positionBasis k 0 + ((t : ℕ) : ZMod 3) • positionBasis k 1)

@[expose] def PositionMem (k : Fin 5) (z : Fin Tag.E6.rank → ZMod 3) : Prop :=
  ∃ s t : ZMod 3, z = s • positionBasis k 0 + t • positionBasis k 1

structure ReflCert where
  u : List (Fin Tag.E6.rank)
  i : Fin Tag.E6.rank
  v : Fin Tag.E6.rank → ℤ
  y : Fin Tag.E6.rank → ℤ

inductive PlaneCert where
  | refl (R : List (List (Fin Tag.E6.rank) × Fin Tag.E6.rank))
  | conj (k : Fin 5) (ω : List (Fin Tag.E6.rank))

inductive ModelCert where
  | refl (R : List ReflCert)
  | nine (j : Fin Tag.E6.rank)
  | planes (cols : Fin Tag.E6.rank → Fin Tag.E6.rank → ℤ) (f P s : Fin 3 → Fin Tag.E6.rank → ZMod 3)
      (jk : Fin 3 → Fin Tag.E6.rank) (cs : List PlaneCert)

@[expose] def reflWord (r : ReflCert) : List (Fin Tag.E6.rank) := r.u ++ [r.i] ++ r.u.reverse

@[expose] def reflWordP (p : List (Fin Tag.E6.rank) × Fin Tag.E6.rank) : List (Fin Tag.E6.rank) :=
  p.1 ++ [p.2] ++ p.1.reverse

@[expose] def PlaneCert.check (ω : List (Fin Tag.E6.rank))
    (cols : Fin Tag.E6.rank → Fin Tag.E6.rank → ℤ) (x₁ x₂ : Fin Tag.E6.rank → ZMod 3) :
    PlaneCert → Bool
  | .refl R =>
    ((List.finRange Tag.E6.rank).all fun j =>
      veqZ (cols j) (wordAct .E6 (R.flatMap reflWordP) (Pi.single j 1))) &&
    R.all fun p => decide (dot6 x₁ (wordAct .E6 p.1 (Pi.single p.2 1)) = 0) &&
      decide (dot6 x₂ (wordAct .E6 p.1 (Pi.single p.2 1)) = 0)
  | .conj k ω' =>
    ((List.finRange Tag.E6.rank).all fun j =>
      veqZ (wordAct .E6 ω' (cols j)) (matVec (positionCols k) (wordAct .E6 ω' (Pi.single j 1)))) &&
    inPosition k (triAct ω' x₁) && inPosition k (triAct ω' x₂)

@[expose] def isFixed (cols : Fin Tag.E6.rank → Fin Tag.E6.rank → ℤ)
    (z : Fin Tag.E6.rank → ZMod 3) : Bool :=
  (List.finRange Tag.E6.rank).all fun j => decide (dot6 z (cols j) = z j)

@[expose] def rowW (cols : Fin Tag.E6.rank → Fin Tag.E6.rank → ℤ) (j i : Fin Tag.E6.rank) :
    ZMod 3 :=
  ((cols j i : ℤ) : ZMod 3) - if j = i then 1 else 0

@[expose] def completeCheck (cols : Fin Tag.E6.rank → Fin Tag.E6.rank → ℤ)
    (f P s : Fin 3 → Fin Tag.E6.rank → ZMod 3) (jk : Fin 3 → Fin Tag.E6.rank) : Bool :=
  (List.finRange Tag.E6.rank).all fun i => (List.finRange Tag.E6.rank).all fun i' =>
    decide (f 0 i * P 0 i' + f 1 i * P 1 i' + f 2 i * P 2 i' + s 0 i * rowW cols (jk 0) i' +
      s 1 i * rowW cols (jk 1) i' + s 2 i * rowW cols (jk 2) i' = if i = i' then 1 else 0)

@[expose] def ModelCert.check (ω : List (Fin Tag.E6.rank)) : ModelCert → Bool
  | .refl R =>
    ((List.finRange Tag.E6.rank).all fun j =>
      veqZ (wordAct .E6 ω (Pi.single j 1)) (wordAct .E6 (R.flatMap reflWord) (Pi.single j 1))) &&
    R.all fun r => veqZ (wordAct .E6 r.u (Pi.single r.i 1)) (r.v - wordAct .E6 ω r.v + 3 • r.y)
  | .nine j => !veqZ (wordAct .E6 (ω ++ ω ++ ω) (Pi.single j 1)) (Pi.single j 1)
  | .planes cols f P s jk cs =>
    ((List.finRange Tag.E6.rank).all fun j => veqZ (wordAct .E6 ω (Pi.single j 1)) (cols j)) &&
    ((List.finRange 3).all fun k => isFixed cols (f k)) && completeCheck cols f P s jk &&
    (List.finRange 13).all fun j =>
      (cs.getD j (.refl [])).check ω cols (comb3 f (planeBasis j 0)) (comb3 f (planeBasis j 1))

