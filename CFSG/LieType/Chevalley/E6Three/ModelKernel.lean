theorem checkAt_lt {m : ℕ} (hm : m < 81) : checkAt m = true := by
  have h : (List.range' 0 81).all checkAt = true := by
    rw [show List.range' 0 81 = List.range' 0 9 ++ List.range' 9 9 ++ List.range' 18 9 ++
      List.range' 27 9 ++ List.range' 36 9 ++ List.range' 45 9 ++ List.range' 54 9 ++
      List.range' 63 9 ++ List.range' 72 9 by decide]
    simp only [List.all_append, checkAt_0, checkAt_1, checkAt_2, checkAt_3, checkAt_4, checkAt_5,
      checkAt_6, checkAt_7, checkAt_8, Bool.and_self]
  rw [List.all_eq_true] at h
  exact h m (List.mem_range'.2 ⟨m, hm, by omega⟩)

@[expose] def modelIndex (v : Fin 3 → ZMod 3) (j : ZMod 3) : ℕ :=
  27 * (v 0).val + 9 * (v 1).val + 3 * (v 2).val + j.val

theorem modelIndex_lt (v : Fin 3 → ZMod 3) (j : ZMod 3) : modelIndex v j < 81 := by
  have h0 := (v 0).val_lt
  have h1 := (v 1).val_lt
  have h2 := (v 2).val_lt
  have h3 := j.val_lt
  rw [modelIndex]
  omega

theorem wordOfIndex_modelIndex : ∀ (v : Fin 3 → ZMod 3) (j : ZMod 3),
    ![((modelIndex v j / 27 % 3 : ℕ) : ZMod 3), ((modelIndex v j / 9 % 3 : ℕ) : ZMod 3),
      ((modelIndex v j / 3 % 3 : ℕ) : ZMod 3)] = v ∧ ((modelIndex v j % 3 : ℕ) : ZMod 3) = j := by
  decide

@[expose] def modelCert (v : Fin 3 → ZMod 3) (j : ZMod 3) : ModelCert :=
  modelCerts.getD (modelIndex v j) (.nine 0)

theorem modelCert_check (v : Fin 3 → ZMod 3) (j : ZMod 3) :
    (modelCert v j).check (modelWordE6 v j) = true := by
  have h := checkAt_lt (modelIndex_lt v j)
  obtain ⟨hv, hj⟩ := wordOfIndex_modelIndex v j
  rw [checkAt, wordOfIndex, hv, hj] at h
  exact h

section Linear

variable {τ : Tag}

theorem reflect_add (i : Fin τ.rank) (u v : Fin τ.rank → ℤ) :
    reflect τ i (u + v) = reflect τ i u + reflect τ i v := by
  funext k
  simp only [reflect, Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, mul_add,
    Finset.sum_add_distrib]
  ring

theorem reflect_zsmul (i : Fin τ.rank) (c : ℤ) (v : Fin τ.rank → ℤ) :
    reflect τ i (c • v) = c • reflect τ i v := by
  funext k
  have h : ∑ j, τ.cartan i j * (c * v j) = c * ∑ j, τ.cartan i j * v j := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => by ring
  change c * v k - (∑ j, τ.cartan i j * (c * v j)) * (Pi.single i (1 : ℤ) : Fin τ.rank → ℤ) k =
    c * (v k - (∑ j, τ.cartan i j * v j) * (Pi.single i (1 : ℤ) : Fin τ.rank → ℤ) k)
  rw [h]
  ring

theorem wordAct_add (ω : List (Fin τ.rank)) (u v : Fin τ.rank → ℤ) :
    wordAct τ ω (u + v) = wordAct τ ω u + wordAct τ ω v := by
  induction ω with
  | nil => rfl
  | cons i ω ih =>
    change reflect τ i (wordAct τ ω (u + v)) =
      reflect τ i (wordAct τ ω u) + reflect τ i (wordAct τ ω v)
    rw [ih, reflect_add]

theorem wordAct_zsmul (ω : List (Fin τ.rank)) (c : ℤ) (v : Fin τ.rank → ℤ) :
    wordAct τ ω (c • v) = c • wordAct τ ω v := by
  induction ω with
  | nil => rfl
  | cons i ω ih =>
    change reflect τ i (wordAct τ ω (c • v)) = c • reflect τ i (wordAct τ ω v)
    rw [ih, reflect_zsmul]

theorem wordAct_zero (ω : List (Fin τ.rank)) : wordAct τ ω 0 = 0 := by
  have h := wordAct_zsmul ω 0 0
  rwa [zero_smul, zero_smul] at h

theorem wordAct_sum {ι : Type*} (ω : List (Fin τ.rank)) (s : Finset ι)
    (f : ι → Fin τ.rank → ℤ) : wordAct τ ω (∑ i ∈ s, f i) = ∑ i ∈ s, wordAct τ ω (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => rw [Finset.sum_empty, Finset.sum_empty, wordAct_zero]
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, wordAct_add, ih]

theorem triReflect_add (i : Fin τ.rank) (a b : Fin τ.rank → ZMod 3) :
    triReflect i (a + b) = triReflect i a + triReflect i b := by
  funext k
  simp only [triReflect, Pi.add_apply]
  ring

theorem triReflect_smul (i : Fin τ.rank) (c : ZMod 3) (a : Fin τ.rank → ZMod 3) :
    triReflect i (c • a) = c • triReflect i a := by
  funext k
  simp only [triReflect, Pi.smul_apply, smul_eq_mul]
  ring

theorem triAct_add (ω : List (Fin τ.rank)) (a b : Fin τ.rank → ZMod 3) :
    triAct ω (a + b) = triAct ω a + triAct ω b := by
  induction ω with
  | nil => rfl
  | cons i ω ih =>
    change triReflect i (triAct ω (a + b)) = triReflect i (triAct ω a) + triReflect i (triAct ω b)
    rw [ih, triReflect_add]

theorem triAct_smul (ω : List (Fin τ.rank)) (c : ZMod 3) (a : Fin τ.rank → ZMod 3) :
    triAct ω (c • a) = c • triAct ω a := by
  induction ω with
  | nil => rfl
  | cons i ω ih =>
    change triReflect i (triAct ω (c • a)) = c • triReflect i (triAct ω a)
    rw [ih, triReflect_smul]

end Linear

theorem wordAct_eq_matVec {ω : List (Fin Tag.E6.rank)} {M : Fin Tag.E6.rank → Fin Tag.E6.rank → ℤ}
    (hM : ∀ j, wordAct .E6 ω (Pi.single j 1) = M j) (v : Fin Tag.E6.rank → ℤ) :
    wordAct .E6 ω v = matVec M v := by
  have hv : v = ∑ j, v j • (Pi.single j 1 : Fin Tag.E6.rank → ℤ) := by
    conv_lhs => rw [← Finset.univ_sum_single v]
    refine Finset.sum_congr rfl fun j _ => ?_
    ext k
    simp [Pi.single_apply]
  conv_lhs => rw [hv]
  rw [wordAct_sum]
  simp_rw [wordAct_zsmul, hM]
  change (∑ j : Fin 6, v j • M j) = _
  rw [Fin.sum_univ_six]
  rfl

theorem triPairing_sub (e : Fin Tag.E6.rank → ZMod 3) (u v : Fin Tag.E6.rank → ℤ) :
    triPairing e (u - v) = triPairing e u - triPairing e v := by
  have h := triPairing_add e (u - v) v
  rw [sub_add_cancel] at h
  rw [h, add_sub_cancel_right]

theorem triPairing_three_smul (e : Fin Tag.E6.rank → ZMod 3) (y : Fin Tag.E6.rank → ℤ) :
    triPairing e (3 • y) = 0 := by
  have h3 : (3 : ZMod 3) = 0 := rfl
  rw [triPairing]
  refine Finset.sum_eq_zero fun j _ => ?_
  rw [Pi.smul_apply, nsmul_eq_mul]
  push_cast
  rw [h3, zero_mul, mul_zero]

theorem triPairing_single (e : Fin Tag.E6.rank → ZMod 3) (j : Fin Tag.E6.rank) :
    triPairing e (Pi.single j 1) = e j := by
  have h := triPairing_zsmul_single e 1 j
  rwa [one_smul, Int.cast_one, mul_one] at h

theorem triPairing_add_left (a b : Fin Tag.E6.rank → ZMod 3) (v : Fin Tag.E6.rank → ℤ) :
    triPairing (a + b) v = triPairing a v + triPairing b v := by
  simp only [triPairing, Pi.add_apply, add_mul, Finset.sum_add_distrib]

theorem triPairing_smul_left (c : ZMod 3) (a : Fin Tag.E6.rank → ZMod 3) (v : Fin Tag.E6.rank → ℤ) :
    triPairing (c • a) v = c * triPairing a v := by
  simp only [triPairing, Pi.smul_apply, smul_eq_mul, mul_assoc, Finset.mul_sum]

theorem wordProd_reflWord (r : ReflCert) :
    (coxeterSystem .E6).wordProd (reflWord r) = (coxeterSystem .E6).wordProd r.u *
      simple .E6 r.i * ((coxeterSystem .E6).wordProd r.u)⁻¹ := by
  rw [reflWord, CoxeterSystem.wordProd_append, CoxeterSystem.wordProd_append,
    CoxeterSystem.wordProd_singleton, CoxeterSystem.wordProd_reverse]

theorem wordProd_flatMap_reflWord (R : List ReflCert) :
    (coxeterSystem .E6).wordProd (R.flatMap reflWord) = (R.map fun r =>
      (coxeterSystem .E6).wordProd r.u * simple .E6 r.i *
        ((coxeterSystem .E6).wordProd r.u)⁻¹).prod := by
  induction R with
  | nil => simp
  | cons r R ih =>
    rw [List.flatMap_cons, CoxeterSystem.wordProd_append, ih, wordProd_reflWord, List.map_cons,
      List.prod_cons]

theorem wordProd_flatMap_reflWordP (R : List (List (Fin Tag.E6.rank) × Fin Tag.E6.rank)) :
    (coxeterSystem .E6).wordProd (R.flatMap reflWordP) = (R.map fun p =>
      (coxeterSystem .E6).wordProd p.1 * simple .E6 p.2 *
        ((coxeterSystem .E6).wordProd p.1)⁻¹).prod := by
  induction R with
  | nil => simp
  | cons p R ih =>
    rw [List.flatMap_cons, CoxeterSystem.wordProd_append, ih, List.map_cons, List.prod_cons,
      reflWordP, CoxeterSystem.wordProd_append, CoxeterSystem.wordProd_append,
      CoxeterSystem.wordProd_singleton, CoxeterSystem.wordProd_reverse]

theorem wordProd_eq_of_check_refl {ω : List (Fin Tag.E6.rank)} {R : List ReflCert}
    (h : (ModelCert.refl R).check ω = true) :
    (coxeterSystem .E6).wordProd ω = (R.map fun r =>
      (coxeterSystem .E6).wordProd r.u * simple .E6 r.i *
        ((coxeterSystem .E6).wordProd r.u)⁻¹).prod := by
  rw [← wordProd_flatMap_reflWord]
  simp only [ModelCert.check, Bool.and_eq_true, List.all_eq_true] at h
  refine CFSG.LieType.Chevalley.ext_single fun j => ?_
  rw [CFSG.StandardType.TableBExc.wordProd_smul, CFSG.StandardType.TableBExc.wordProd_smul]
  exact veqZ_iff.1 (h.1 j (List.mem_finRange j))

theorem triPairing_eq_zero_of_check_refl {ω : List (Fin Tag.E6.rank)} {R : List ReflCert}
    (h : (ModelCert.refl R).check ω = true) {e : Fin Tag.E6.rank → ZMod 3}
    (hfix : ∀ v, triPairing e ((coxeterSystem .E6).wordProd ω • v) = triPairing e v)
    {r : ReflCert} (hr : r ∈ R) :
    triPairing e ((coxeterSystem .E6).wordProd r.u • Pi.single r.i 1) = 0 := by
  simp only [ModelCert.check, Bool.and_eq_true, List.all_eq_true] at h
  rw [CFSG.StandardType.TableBExc.wordProd_smul, veqZ_iff.1 (h.2 r hr), triPairing_add,
    triPairing_sub, triPairing_three_smul, ← CFSG.StandardType.TableBExc.wordProd_smul, hfix,
    sub_self, add_zero]

theorem pow_three_ne_one_of_check_nine {ω : List (Fin Tag.E6.rank)} {j : Fin Tag.E6.rank}
    (h : (ModelCert.nine j).check ω = true) : (coxeterSystem .E6).wordProd ω ^ 3 ≠ 1 := by
  intro h3
  have e : wordAct .E6 (ω ++ ω ++ ω) (Pi.single j 1) = Pi.single j 1 := by
    rw [← CFSG.StandardType.TableBExc.wordProd_smul, CoxeterSystem.wordProd_append,
      CoxeterSystem.wordProd_append,
      show (coxeterSystem .E6).wordProd ω * (coxeterSystem .E6).wordProd ω *
        (coxeterSystem .E6).wordProd ω = (coxeterSystem .E6).wordProd ω ^ 3 by
          rw [pow_succ, pow_two], h3,
      one_smul]
  simp only [ModelCert.check, veqZ_iff.2 e, Bool.not_true] at h
  exact Bool.false_ne_true h

