theorem comb3_add (f : Fin 3 → Fin Tag.E6.rank → ZMod 3) (a b : Fin 3 → ZMod 3) :
    comb3 f (a + b) = comb3 f a + comb3 f b := by
  funext i
  simp only [comb3, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  ring

theorem comb3_smul (f : Fin 3 → Fin Tag.E6.rank → ZMod 3) (c : ZMod 3) (a : Fin 3 → ZMod 3) :
    comb3 f (c • a) = c • comb3 f a := by
  funext i
  simp only [comb3, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  ring

theorem comb3_zero (f : Fin 3 → Fin Tag.E6.rank → ZMod 3) : comb3 f 0 = 0 := by
  have h := comb3_smul f 0 0
  rwa [zero_smul, zero_smul] at h

theorem isFixed_of_triPairing {ω : List (Fin Tag.E6.rank)}
    {cols : Fin Tag.E6.rank → Fin Tag.E6.rank → ℤ}
    (hcols : ∀ j, wordAct .E6 ω (Pi.single j 1) = cols j) {x : Fin Tag.E6.rank → ZMod 3}
    (hx : ∀ u, triPairing x ((coxeterSystem .E6).wordProd ω • u) = triPairing x u) :
    isFixed cols x = true := by
  rw [isFixed, List.all_eq_true]
  intro j _
  rw [decide_eq_true_eq, dot6_eq, ← hcols j, ← CFSG.StandardType.TableBExc.wordProd_smul, hx,
    triPairing_single]

theorem eq_comb3_of_completeCheck {cols : Fin Tag.E6.rank → Fin Tag.E6.rank → ℤ}
    {f P s : Fin 3 → Fin Tag.E6.rank → ZMod 3} {jk : Fin 3 → Fin Tag.E6.rank}
    (hc : completeCheck cols f P s jk = true) {z : Fin Tag.E6.rank → ZMod 3}
    (hz : isFixed cols z = true) : z = comb3 f (coeff3 P z) := by
  simp only [completeCheck, List.all_eq_true, List.mem_finRange, decide_eq_true_eq,
    true_implies] at hc
  rw [isFixed, List.all_eq_true] at hz
  set r : Fin 3 → Fin Tag.E6.rank → ZMod 3 := fun k i' => rowW cols (jk k) i' with hrdef
  have hid : ∀ i i', (∑ k, f k i * P k i') + (∑ k, s k i * r k i') = if i = i' then 1 else 0 := by
    intro i i'
    rw [Fin.sum_univ_three, Fin.sum_univ_three, ← hc i i']
    ring
  have hr : ∀ k, ∑ i', r k i' * z i' = 0 := by
    intro k
    have hfix := of_decide_eq_true (hz (jk k) (List.mem_finRange _))
    rw [dot6_eq, triPairing] at hfix
    have e : ∀ i', r k i' * z i' =
        (cols (jk k) i' : ZMod 3) * z i' - if jk k = i' then z i' else 0 := by
      intro i'
      simp only [hrdef, rowW]
      split_ifs <;> ring
    have e2 : ∑ i', r k i' * z i' = ∑ i', (cols (jk k) i' : ZMod 3) * z i' -
        ∑ i', (if jk k = i' then z i' else 0) := by
      rw [Finset.sum_congr rfl fun i' _ => e i']
      exact Finset.sum_sub_distrib _ _
    rw [e2, Finset.sum_ite_eq, if_pos (Finset.mem_univ _), sub_eq_zero, ← hfix]
    exact Finset.sum_congr rfl fun i' _ => mul_comm _ _
  have hcoeff : ∀ k, coeff3 P z k = ∑ i', P k i' * z i' := by
    intro k
    change _ = ∑ i' : Fin 6, P k i' * z i'
    rw [Fin.sum_univ_six]
    rfl
  funext i
  calc z i = ∑ i', (if i = i' then 1 else 0) * z i' := by
        simp only [ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    _ = ∑ i', ((∑ k, f k i * P k i') + (∑ k, s k i * r k i')) * z i' :=
        Finset.sum_congr rfl fun i' _ => by rw [hid]
    _ = (∑ k, f k i * ∑ i', P k i' * z i') + ∑ k, s k i * ∑ i', r k i' * z i' := by
        simp only [add_mul, Finset.sum_add_distrib, Finset.sum_mul, Finset.mul_sum, mul_assoc]
        rw [Finset.sum_comm, Finset.sum_comm (f := fun x y => s y i * (r y x * z x))]
    _ = comb3 f (coeff3 P z) i := by
        simp only [hr, mul_zero, Finset.sum_const_zero, add_zero, ← hcoeff]
        rw [Fin.sum_univ_three]
        simp only [comb3, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
        ring

theorem positionMem_of_inPosition {k : Fin 5} {z : Fin Tag.E6.rank → ZMod 3}
    (h : inPosition k z = true) : PositionMem k z := by
  obtain ⟨s, -, hs⟩ := List.any_eq_true.1 h
  obtain ⟨t, -, ht⟩ := List.any_eq_true.1 hs
  exact ⟨_, _, veq3_iff.1 ht⟩

theorem PositionMem.add_smul {k : Fin 5} {z z' : Fin Tag.E6.rank → ZMod 3} (hz : PositionMem k z)
    (hz' : PositionMem k z') (a b : ZMod 3) : PositionMem k (a • z + b • z') := by
  obtain ⟨s, t, rfl⟩ := hz
  obtain ⟨s', t', rfl⟩ := hz'
  refine ⟨a * s + b * s', a * t + b * t', ?_⟩
  funext i
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  ring

theorem wordProd_eq_of_cols {ω ω' : List (Fin Tag.E6.rank)}
    {cols : Fin Tag.E6.rank → Fin Tag.E6.rank → ℤ}
    (hcols : ∀ j, wordAct .E6 ω (Pi.single j 1) = cols j)
    (h : ∀ j, wordAct .E6 ω' (Pi.single j 1) = cols j) :
    (coxeterSystem .E6).wordProd ω = (coxeterSystem .E6).wordProd ω' := by
  refine CFSG.LieType.Chevalley.ext_single fun j => ?_
  rw [CFSG.StandardType.TableBExc.wordProd_smul, CFSG.StandardType.TableBExc.wordProd_smul,
    hcols, h]

theorem planes_sound {ω : List (Fin Tag.E6.rank)} {cols : Fin Tag.E6.rank → Fin Tag.E6.rank → ℤ}
    {f P s : Fin 3 → Fin Tag.E6.rank → ZMod 3} {jk : Fin 3 → Fin Tag.E6.rank}
    {cs : List PlaneCert} (h : (ModelCert.planes cols f P s jk cs).check ω = true)
    {x y : Fin Tag.E6.rank → ZMod 3}
    (hx : ∀ u, triPairing x ((coxeterSystem .E6).wordProd ω • u) = triPairing x u)
    (hy : ∀ u, triPairing y ((coxeterSystem .E6).wordProd ω • u) = triPairing y u)
    (hind : ∀ a b : ZMod 3, a • x + b • y = 0 → a = 0 ∧ b = 0) :
    (∃ R : List (List (Fin Tag.E6.rank) × Fin Tag.E6.rank),
      (coxeterSystem .E6).wordProd ω = (R.map fun p => (coxeterSystem .E6).wordProd p.1 *
        simple .E6 p.2 * ((coxeterSystem .E6).wordProd p.1)⁻¹).prod ∧
      ∀ p ∈ R, triPairing x ((coxeterSystem .E6).wordProd p.1 • Pi.single p.2 1) = 0 ∧
        triPairing y ((coxeterSystem .E6).wordProd p.1 • Pi.single p.2 1) = 0) ∨
    ∃ (k : Fin 5) (ω' : List (Fin Tag.E6.rank)),
      (coxeterSystem .E6).wordProd ω' * (coxeterSystem .E6).wordProd ω *
          ((coxeterSystem .E6).wordProd ω')⁻¹ = (coxeterSystem .E6).wordProd (positionWord k) ∧
        PositionMem k (triAct ω' x) ∧ PositionMem k (triAct ω' y) := by
  simp only [ModelCert.check, Bool.and_eq_true, List.all_eq_true] at h
  obtain ⟨⟨⟨hcols, -⟩, hc⟩, hcs⟩ := h
  have hcols' : ∀ j, wordAct .E6 ω (Pi.single j 1) = cols j := fun j =>
    veqZ_iff.1 (hcols j (List.mem_finRange j))
  have hxf := eq_comb3_of_completeCheck hc (isFixed_of_triPairing hcols' hx)
  have hyf := eq_comb3_of_completeCheck hc (isFixed_of_triPairing hcols' hy)
  set a := coeff3 P x with ha
  set b := coeff3 P y with hb
  have hab : ∀ c d : ZMod 3, c • a + d • b = 0 → c = 0 ∧ d = 0 := by
    intro c d hcd
    refine hind c d ?_
    rw [hxf, hyf, ← comb3_smul, ← comb3_smul, ← comb3_add, hcd, comb3_zero]
  obtain ⟨j, hja, hjb⟩ := exists_planeNormal a b hab
  obtain ⟨s₁, t₁, hs₁⟩ := exists_eq_planeBasis j a hja
  obtain ⟨s₂, t₂, hs₂⟩ := exists_eq_planeBasis j b hjb
  set x₁ := comb3 f (planeBasis j 0) with hx₁
  set x₂ := comb3 f (planeBasis j 1) with hx₂
  have hxe : x = s₁ • x₁ + t₁ • x₂ := by rw [hxf, hs₁, comb3_add, comb3_smul, comb3_smul]
  have hye : y = s₂ • x₁ + t₂ • x₂ := by rw [hyf, hs₂, comb3_add, comb3_smul, comb3_smul]
  have hj := hcs j (List.mem_finRange j)
  generalize cs.getD j (.refl []) = c at hj
  cases c with
  | refl R =>
    left
    simp only [PlaneCert.check, Bool.and_eq_true, List.all_eq_true] at hj
    obtain ⟨hR, hroots⟩ := hj
    refine ⟨R, ?_, fun p hp => ?_⟩
    · rw [← wordProd_flatMap_reflWordP]
      exact wordProd_eq_of_cols hcols' fun i => (veqZ_iff.1 (hR i (List.mem_finRange i))).symm
    · have hp' := hroots p hp
      simp only [Bool.and_eq_true, decide_eq_true_eq] at hp'
      rw [CFSG.StandardType.TableBExc.wordProd_smul, hxe, hye, triPairing_add_left,
        triPairing_add_left, triPairing_smul_left, triPairing_smul_left, triPairing_smul_left,
        triPairing_smul_left, ← dot6_eq, ← dot6_eq, hp'.1, hp'.2]
      simp
  | conj k ω' =>
    right
    simp only [PlaneCert.check, Bool.and_eq_true, List.all_eq_true] at hj
    obtain ⟨⟨hconj, hp₁⟩, hp₂⟩ := hj
    refine ⟨k, ω', ?_, ?_, ?_⟩
    · rw [mul_inv_eq_iff_eq_mul]
      refine CFSG.LieType.Chevalley.ext_single fun i => ?_
      rw [mul_smul, mul_smul, CFSG.StandardType.TableBExc.wordProd_smul,
        CFSG.StandardType.TableBExc.wordProd_smul, CFSG.StandardType.TableBExc.wordProd_smul,
        CFSG.StandardType.TableBExc.wordProd_smul, hcols' i,
        veqZ_iff.1 (hconj i (List.mem_finRange i)),
        wordAct_eq_matVec (positionCols_eq k)]
    · rw [hxe, triAct_add, triAct_smul, triAct_smul]
      exact (positionMem_of_inPosition hp₁).add_smul (positionMem_of_inPosition hp₂) _ _
    · rw [hye, triAct_add, triAct_smul, triAct_smul]
      exact (positionMem_of_inPosition hp₁).add_smul (positionMem_of_inPosition hp₂) _ _

theorem exists_reflections_or_position {v : Fin 3 → ZMod 3} {j : ZMod 3}
    (hw3 : (coxeterSystem .E6).wordProd (modelWordE6 v j) ^ 3 = 1)
    {x y : Fin Tag.E6.rank → ZMod 3}
    (hx : ∀ u, triPairing x ((coxeterSystem .E6).wordProd (modelWordE6 v j) • u) = triPairing x u)
    (hy : ∀ u, triPairing y ((coxeterSystem .E6).wordProd (modelWordE6 v j) • u) = triPairing y u)
    (hind : ∀ a b : ZMod 3, a • x + b • y = 0 → a = 0 ∧ b = 0) :
    (∃ R : List (List (Fin Tag.E6.rank) × Fin Tag.E6.rank),
      (coxeterSystem .E6).wordProd (modelWordE6 v j) = (R.map fun p =>
        (coxeterSystem .E6).wordProd p.1 * simple .E6 p.2 *
          ((coxeterSystem .E6).wordProd p.1)⁻¹).prod ∧
      ∀ p ∈ R, triPairing x ((coxeterSystem .E6).wordProd p.1 • Pi.single p.2 1) = 0 ∧
        triPairing y ((coxeterSystem .E6).wordProd p.1 • Pi.single p.2 1) = 0) ∨
    ∃ (k : Fin 5) (ω : List (Fin Tag.E6.rank)),
      (coxeterSystem .E6).wordProd ω * (coxeterSystem .E6).wordProd (modelWordE6 v j) *
          ((coxeterSystem .E6).wordProd ω)⁻¹ = (coxeterSystem .E6).wordProd (positionWord k) ∧
        PositionMem k (triAct ω x) ∧ PositionMem k (triAct ω y) := by
  have hcheck := modelCert_check v j
  generalize modelCert v j = M at hcheck
  cases M with
  | refl R =>
    left
    refine ⟨R.map fun r => (r.u, r.i), ?_, fun p hp => ?_⟩
    · rw [wordProd_eq_of_check_refl hcheck, List.map_map]
      rfl
    · obtain ⟨r, hr, rfl⟩ := List.mem_map.1 hp
      exact ⟨triPairing_eq_zero_of_check_refl hcheck hx hr,
        triPairing_eq_zero_of_check_refl hcheck hy hr⟩
  | nine i => exact absurd hw3 (pow_three_ne_one_of_check_nine hcheck)
  | planes cols f P s jk cs => exact planes_sound hcheck hx hy hind

end CFSG.LieType.Chevalley.E6Three.ModelKernel
