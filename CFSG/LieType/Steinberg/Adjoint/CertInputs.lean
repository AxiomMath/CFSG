module

public import CFSG.Blueprint.ChevalleyStrings
public import Certificates.Certificate113
public import Certificates.Certificate114


public section

namespace CFSG.LieType.Steinberg.Adjoint

open CFSG.Blueprint.Chevalley

@[expose] def field (P w idx : ℕ) : ℕ := (P >>> (w * idx)) % 2 ^ w

inductive AVec where
  | zero
  | root (m : ℕ) (c : ℤ)
  | hvec (v : List ℤ)

namespace AVec

@[expose] def norm : AVec → AVec
  | zero => zero
  | root m c => if c = 0 then zero else root m c
  | hvec v => if v.all (· == 0) then zero else hvec v

@[expose] def smul (s : ℤ) : AVec → AVec
  | zero => zero
  | root m c => norm (root m (s * c))
  | hvec v => norm (hvec (v.map (s * ·)))

@[expose] def beq : AVec → AVec → Bool
  | zero, zero => true
  | root m c, root m' c' => m == m' && c == c'
  | hvec v, hvec w => v == w
  | _, _ => false

@[expose] def obeq : Option AVec → Option AVec → Bool
  | none, none => true
  | some v, some w => beq v w
  | _, _ => false

@[expose] def sub : AVec → AVec → Option AVec
  | zero, w => some (smul (-1) w)
  | v, zero => some v
  | root m c, root m' c' => if m = m' then some (norm (root m (c - c'))) else none
  | hvec v, hvec w => some (norm (hvec (List.zipWith (· - ·) v w)))
  | _, _ => none

end AVec

structure AdjData (τ : Tag) where
  ops : ℕ
  coroots : ℕ
  hparts : ℕ
  negs : ℕ
  images : ℕ
  downs : ℕ
  ups : ℕ
  parities : ℕ
  upIdx : ℕ
  downIdx : ℕ
  signs : ℕ
  pairs : ℕ

namespace AdjData

variable {τ : Tag} (D : AdjData τ)

@[expose] def nR (τ : Tag) : ℕ := τ.rootCertificate.roots.length

@[expose] def op (k b : ℕ) : ℕ := field D.ops 16 (k * nR τ + b)

@[expose] def coroot (k : ℕ) : List ℤ :=
  (List.range τ.rank).map fun j => ((field D.coroots 5 (k * τ.rank + j) : ℕ) : ℤ) - 16

@[expose] def hpart (k : ℕ) : List ℤ :=
  (List.range τ.rank).map fun j => ((field D.hparts 5 (k * τ.rank + j) : ℕ) : ℤ) - 16

@[expose] def neg (k : ℕ) : ℕ := field D.negs 8 k

@[expose] def img (b : ℕ) (i : Fin τ.rank) : ℕ := field D.images 8 (b * τ.rank + i)

@[expose] def dn (b : ℕ) (i : Fin τ.rank) : ℕ := field D.downs 4 (b * τ.rank + i)

@[expose] def upl (b : ℕ) (i : Fin τ.rank) : ℕ := field D.ups 4 (b * τ.rank + i)

@[expose] def par (b : ℕ) (i : Fin τ.rank) : ℕ := field D.parities 1 (b * τ.rank + i)

@[expose] def upI (b : ℕ) (i : Fin τ.rank) : ℕ := field D.upIdx 16 (b * τ.rank + i)

@[expose] def downI (b : ℕ) (i : Fin τ.rank) : ℕ := field D.downIdx 16 (b * τ.rank + i)

@[expose] def weylSign (k : ℕ) (i : Fin τ.rank) : ℤ :=
  if field D.signs 1 (k * τ.rank + i) = 1 then -1 else 1

@[expose] def pairDig (l : ℕ) (j : Fin τ.rank) : ℕ := field D.pairs 16 (l * τ.rank + j)

@[expose] def hUnit (m : Fin τ.rank) : List ℤ :=
  (List.range τ.rank).map fun j => if j = (m : ℕ) then 1 else 0

variable (τ) in
@[expose] def basis : List AVec :=
  (List.range (nR τ)).map (fun b => .root b 1) ++ (List.finRange τ.rank).map fun m => .hvec (hUnit m)

@[expose] def opNat (k : ℕ) : ℕ := field D.ops (16 * nR τ) k

@[expose] def actM (M : ℕ) (k : ℕ) : AVec → AVec
  | .zero => .zero
  | .root b c =>
    if b = D.neg k then AVec.norm (.hvec ((D.coroot k).map (c * ·)))
    else if field M 16 b = 0 then .zero
    else AVec.norm (.root (field M 16 b / 8 - 1) (c * (((field M 16 b % 8 : ℕ) : ℤ) - 4)))
  | .hvec v => AVec.norm (.root k (List.sum (List.zipWith (· * ·) v (D.hpart k))))

@[expose] def act (k : ℕ) : AVec → AVec := D.actM (D.opNat k) k

@[expose] def hReflect (i : Fin τ.rank) (v : List ℤ) : List ℤ :=
  (List.range τ.rank).map fun j =>
    v.getD j 0 - if j = i then ∑ m : Fin τ.rank, v.getD m 0 * ((τ.cartan m i).natAbs : ℤ) else 0

@[expose] def actN (i : Fin τ.rank) : AVec → AVec
  | .zero => .zero
  | .root b c => .root (D.img b i) (c * (-1) ^ D.dn b i)
  | .hvec v => AVec.norm (.hvec (hReflect i v))

@[expose] def actNinv (i : Fin τ.rank) : AVec → AVec
  | .zero => .zero
  | .root b c => .root (D.img b i) (c * (-1) ^ (D.dn b i + D.par b i))
  | .hvec v => AVec.norm (.hvec (hReflect i v))

@[expose] def checkTables : Bool :=
  (List.range (nR τ)).all fun b =>
    decide (D.neg b < nR τ) &&
    (List.ofFn (τ.rootCertificate.root (D.neg b)) == List.ofFn (-τ.rootCertificate.root b)) &&
    (List.finRange τ.rank).all fun i =>
      (D.img b i == τ.rootCertificate.image b i) &&
      (if b = (i : ℕ) then D.dn b i == 2 && D.upl b i == 0
       else if b = D.neg i then D.dn b i == 0 && D.upl b i == 2
       else D.dn b i == τ.stringData.down b i && D.upl b i == τ.stringData.up b i) &&
      (D.par b i == (∑ j, τ.cartan i j * τ.rootCertificate.root b j).natAbs % 2) &&
      (if D.upI b i = 0 then !(τ.stringData.memDec τ.rootCertificate
          (τ.rootCertificate.root b + Pi.single i 1))
       else decide (D.upI b i - 1 < nR τ) &&
         List.ofFn (τ.rootCertificate.root (D.upI b i - 1)) ==
           List.ofFn (τ.rootCertificate.root b + Pi.single i 1)) &&
      (if D.downI b i = 0 then !(τ.stringData.memDec τ.rootCertificate
          (τ.rootCertificate.root b - Pi.single i 1))
       else decide (D.downI b i - 1 < nR τ) &&
         List.ofFn (τ.rootCertificate.root (D.downI b i - 1)) ==
           List.ofFn (τ.rootCertificate.root b - Pi.single i 1))

@[expose] def checkSimple : Bool :=
  (List.finRange τ.rank).all fun i =>
    (List.range (nR τ)).all (fun b =>
      (AVec.beq (D.act i (.root b 1))
        (if b = i then .zero
        else if b = D.neg i then .hvec (hUnit i)
        else if D.upI b i = 0 then .zero
        else .root (D.upI b i - 1) ((D.dn b i : ℤ) + 1))) &&
      (AVec.beq (D.act (D.neg i) (.root b 1))
        (if b = D.neg i then .zero
        else if b = i then .hvec (hUnit i)
        else if D.downI b i = 0 then .zero
        else .root (D.downI b i - 1) ((D.upl b i : ℤ) + 1)))) &&
    (List.finRange τ.rank).all fun m =>
      AVec.beq (D.act i (.hvec (hUnit m))) (AVec.norm (.root i ((τ.cartan m i).natAbs : ℤ))) &&
      AVec.beq (D.act (D.neg i) (.hvec (hUnit m)))
        (AVec.norm (.root (D.neg i) ((τ.cartan m i).natAbs : ℤ)))

@[expose] def weylOne (k : ℕ) (i : Fin τ.rank) (Mk Mt : ℕ) : Bool :=
  (basis τ).all fun u =>
    AVec.beq (D.actN i (D.actM Mk k (D.actNinv i u)))
      (AVec.smul (D.weylSign k i) (D.actM Mt (D.img k i) u))

@[expose] def checkWeylRange (lo len : ℕ) : Bool :=
  ((List.range len).map (lo + ·)).all fun k => (List.finRange τ.rank).all fun i =>
    D.weylOne k i (D.opNat k) (D.opNat (D.img k i))

@[expose] def pairOne (l : ℕ) (j : Fin τ.rank) (Ml Mj Mm : ℕ) : Bool :=
  (basis τ).all fun u =>
    AVec.obeq (AVec.sub (D.actM Mj j (D.actM Ml l u)) (D.actM Ml l (D.actM Mj j u)))
      (some (if D.pairDig l j = 0 then .zero
        else AVec.smul ((D.pairDig l j % 8 : ℕ) - 4 : ℤ) (D.actM Mm (D.pairDig l j / 8 - 1) u)))

@[expose] def checkPairsRange (lo len : ℕ) : Bool :=
  ((List.range len).map (lo + ·)).all fun l => (List.finRange τ.rank).all fun j =>
    decide (l = D.neg j) ||
      ((if D.pairDig l j = 0 then decide (l = j) || decide (D.upI l j = 0)
        else D.pairDig l j / 8 = D.upI l j) &&
        D.pairOne l j (D.opNat l) (D.opNat j) (D.opNat (D.pairDig l j / 8 - 1)))

theorem checkWeylRange_add (lo a b : ℕ) :
    D.checkWeylRange lo (a + b) = (D.checkWeylRange lo a && D.checkWeylRange (lo + a) b) := by
  have h : (List.range (a + b)).map (lo + ·) =
      (List.range a).map (lo + ·) ++ (List.range b).map (lo + a + ·) := by
    rw [List.range_add, List.map_append, List.map_map]
    congr 1
    exact List.map_congr_left fun x _ => by simp [Nat.add_assoc]
  simp only [checkWeylRange, h, List.all_append]

theorem checkPairsRange_add (lo a b : ℕ) :
    D.checkPairsRange lo (a + b) = (D.checkPairsRange lo a && D.checkPairsRange (lo + a) b) := by
  have h : (List.range (a + b)).map (lo + ·) =
      (List.range a).map (lo + ·) ++ (List.range b).map (lo + a + ·) := by
    rw [List.range_add, List.map_append, List.map_map]
    congr 1
    exact List.map_congr_left fun x _ => by simp [Nat.add_assoc]
  simp only [checkPairsRange, h, List.all_append]

theorem checkWeylRange_of_slices (lo len : ℕ) :
    ∀ n : ℕ, (∀ s < n, D.checkWeylRange (lo + s * len) len = true) →
      D.checkWeylRange lo (n * len) = true
  | 0, _ => by simp [checkWeylRange]
  | n + 1, h => by
    rw [Nat.succ_mul, checkWeylRange_add, checkWeylRange_of_slices lo len n
      (fun s hs => h s (Nat.lt_succ_of_lt hs)), h n (Nat.lt_succ_self n), Bool.and_self]

theorem checkPairsRange_of_slices (lo len : ℕ) :
    ∀ n : ℕ, (∀ s < n, D.checkPairsRange (lo + s * len) len = true) →
      D.checkPairsRange lo (n * len) = true
  | 0, _ => by simp [checkPairsRange]
  | n + 1, h => by
    rw [Nat.succ_mul, checkPairsRange_add, checkPairsRange_of_slices lo len n
      (fun s hs => h s (Nat.lt_succ_of_lt hs)), h n (Nat.lt_succ_self n), Bool.and_self]

@[expose] def checkWeyl : Bool := D.checkWeylRange 0 (nR τ)

@[expose] def checkPairs : Bool := D.checkPairsRange 0 (nR τ)

end AdjData

