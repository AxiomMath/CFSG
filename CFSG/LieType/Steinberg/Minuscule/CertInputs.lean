module

public import CFSG.Blueprint.ChevalleyStrings
public import Certificates.Certificate113
public import Certificates.Certificate114

public section

namespace CFSG.LieType.Steinberg.Minuscule

open CFSG.Blueprint.Chevalley

@[expose] def dig (M a : ℕ) : ℕ := M / 256 ^ a % 256

@[expose] def ofDigits (d : ℕ) (f : ℕ → ℕ) : ℕ := ((List.range d).map fun a => f a * 256 ^ a).sum

@[expose] def compDigit (M N a : ℕ) : ℕ :=
  if dig N a = 0 then 0
  else if dig M (dig N a / 2 - 1) = 0 then 0
  else 2 * (dig M (dig N a / 2 - 1) / 2) + (dig N a % 2 + dig M (dig N a / 2 - 1) % 2) % 2

@[expose] def comp (d M N : ℕ) : ℕ := ofDigits d (compDigit M N)

@[expose] def negDigit (c : ℕ) : ℕ := if c = 0 then 0 else c / 2 * 2 + (1 - c % 2)

@[expose] def neg (d M : ℕ) : ℕ := ofDigits d fun a => negDigit (dig M a)

@[expose] def inv (d P : ℕ) : ℕ :=
  ((List.range d).map fun a => (2 * (a + 1) + dig P a % 2) * 256 ^ (dig P a / 2 - 1)).sum

@[expose] def conj (d P M : ℕ) : ℕ := comp d (comp d P M) (inv d P)

@[expose] def disjointDom (d M N : ℕ) : Bool :=
  (List.range d).all fun a => dig M a == 0 || dig N a == 0

@[expose] def union (d M N : ℕ) : ℕ := ofDigits d fun a => if dig M a = 0 then dig N a else dig M a

structure MinData (τ : Tag) where
  d : ℕ
  weights : List ℕ
  weylTable : List ℕ
  ops : List ℕ
  signs : List ℕ
  pairTable : List ℕ
  pgen : List (List (ℕ × ℤ))
  grading : List ℤ
  scale : ℕ

namespace MinData

variable {τ : Tag} (D : MinData τ)

@[expose] def wt (a : ℕ) : Fin τ.rank → ℤ :=
  fun i => ((D.weights.getD a 0 / 4 ^ (i : ℕ) % 4 : ℕ) : ℤ) - 1

@[expose] def toWeight (γ : Fin τ.rank → ℤ) : Fin τ.rank → ℤ :=
  fun j => ∑ i, τ.cartan j i * γ i

@[expose] def reflectWeight (i : Fin τ.rank) (μ : Fin τ.rank → ℤ) : Fin τ.rank → ℤ :=
  μ - μ i • toWeight (Pi.single i 1)

@[expose] def weyl (a : ℕ) (i : Fin τ.rank) : ℕ := D.weylTable.getD a 0 / 256 ^ (i : ℕ) % 256

@[expose] def simpleE (i : Fin τ.rank) : ℕ :=
  ofDigits D.d fun a => if D.wt a i = -1 then 2 * (D.weyl a i + 1) else 0

@[expose] def simpleF (i : Fin τ.rank) : ℕ :=
  ofDigits D.d fun a => if D.wt a i = 1 then 2 * (D.weyl a i + 1) else 0

@[expose] def weylOp (i : Fin τ.rank) : ℕ :=
  ofDigits D.d fun a => 2 * (D.weyl a i + 1) + if D.wt a i = 1 then 1 else 0

@[expose] def op (k : ℕ) : ℕ := D.ops.getD k 0

@[expose] def checkWeights : Bool :=
  (D.weights.length == D.d) && D.weights.Nodup &&
    D.weights.all fun w => (List.finRange τ.rank).all fun i => decide (w / 4 ^ (i : ℕ) % 4 < 3)

@[expose] def checkWeylTable : Bool :=
  (D.weylTable.length == D.d) &&
    (List.range D.d).all fun a => (List.finRange τ.rank).all fun i =>
      decide (D.weyl a i < D.d) &&
        List.ofFn (D.wt (D.weyl a i)) == List.ofFn (reflectWeight i (D.wt a))

@[expose] def checkSimple : Bool :=
  (D.ops.length == τ.rootCertificate.roots.length) &&
    (List.finRange τ.rank).all fun i =>
      (D.op i == D.simpleE i) && (D.op (τ.rootCertificate.image i i) == D.simpleF i) &&
        decide (D.simpleE i ≠ 0)

@[expose] def checkWeyl : Bool :=
  (List.range τ.rootCertificate.roots.length).all fun k => (List.finRange τ.rank).all fun i =>
    conj D.d (D.weylOp i) (D.op k) ==
      if D.signs.getD k 0 / 2 ^ (i : ℕ) % 2 = 1 then neg D.d (D.op (τ.rootCertificate.image k i))
      else D.op (τ.rootCertificate.image k i)

@[expose] def checkPairs : Bool :=
  (List.range τ.rootCertificate.roots.length).all fun l => (List.finRange τ.rank).all fun j =>
    let c := dig (D.pairTable.getD l 0) j
    let A := comp D.d (D.op j) (D.op l)
    let B := comp D.d (D.op l) (D.op j)
    if c = 0 then
      (List.ofFn (τ.rootCertificate.root l) == List.ofFn (-Pi.single j 1 : Fin τ.rank → ℤ)) ||
        (!(τ.stringData.memDec τ.rootCertificate (Pi.single j 1 + τ.rootCertificate.root l)) &&
          A == B)
    else
      decide (c / 2 - 1 < τ.rootCertificate.roots.length) &&
        (List.ofFn (τ.rootCertificate.root (c / 2 - 1)) ==
          List.ofFn (Pi.single j 1 + τ.rootCertificate.root l)) &&
        disjointDom D.d A B &&
        (union D.d A (neg D.d B) ==
          if c % 2 = 1 then neg D.d (D.op (c / 2 - 1)) else D.op (c / 2 - 1)) &&
        (comp D.d A (D.op j) == 0) && (comp D.d B (D.op l) == 0)

@[expose] def checkBraid : Bool :=
  (List.finRange τ.rank).all fun i => (List.finRange τ.rank).all fun j =>
    decide (i = j) ||
      if τ.cartan i j = 0 then
        comp D.d (D.weylOp i) (D.weylOp j) == comp D.d (D.weylOp j) (D.weylOp i)
      else
        (decide (τ.cartan i j * τ.cartan j i = 1)) &&
          (comp D.d (D.weylOp i) (comp D.d (D.weylOp j) (D.weylOp i)) ==
            comp D.d (D.weylOp j) (comp D.d (D.weylOp i) (D.weylOp j)))

@[expose] def checkPGen : Bool :=
  (D.pgen.length == τ.rank) &&
    (List.finRange τ.rank).all fun i =>
      ((D.pgen.getD i []).all fun p => decide (p.1 < D.d)) &&
        List.ofFn (((D.pgen.getD i []).map fun p => p.2 • D.wt p.1).sum) ==
          List.ofFn (Pi.single i 1 : Fin τ.rank → ℤ)

@[expose] def checkGrading : Bool :=
  decide (0 < D.scale) && (D.grading.length == τ.rank) &&
    (List.finRange τ.rank).all fun j =>
      decide (∑ i : Fin τ.rank, D.grading.getD i 0 * toWeight (Pi.single j 1) i = D.scale)

@[expose] def check : Bool :=
  D.checkWeights && D.checkWeylTable && D.checkSimple && D.checkWeyl && D.checkPairs &&
    D.checkBraid && D.checkPGen && D.checkGrading

end MinData

