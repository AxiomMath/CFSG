variable {Ω : Type} [Field Ω] [CharP Ω 2] [Algebra (ZMod 2) Ω]
  [Algebra.IsAlgebraic (ZMod 2) Ω]

theorem e6IsogenyAlgebraic_minBC_algebraic
    {Ω' : Type} [Field Ω'] [CharP Ω' 2] [Algebra (ZMod 2) Ω']
    [Algebra.IsAlgebraic (ZMod 2) Ω'] (ι : Ω →+* Ω')
    (g : e6Data_valid.minGroup Ω) :
    e6IsogenyAlgebraic (minBC e6Data_valid ι g) =
      baseChangeGL ι (e6IsogenyAlgebraic g) := by
  classical
  obtain ⟨k, hk, hfin, κ, j, _, hdesc⟩ := e6Data_valid.exists_finite_subfield_lift
    ({g} : Finset (e6Data_valid.minGroup Ω)) (ZMod 2) (algebraMap (ZMod 2) Ω)
  letI : Field k := hk
  letI : Finite k := hfin
  obtain ⟨x, hx⟩ := hdesc g (Finset.mem_singleton_self _)
  have hbc := congrArg (fun f => f x)
    (minBC_comp e6Data_valid j ι)
  simp only [MonoidHom.comp_apply] at hbc
  rw [← hx, hbc, e6IsogenyAlgebraic_minBC, e6IsogenyAlgebraic_minBC]
  change baseChangeGL (ι.comp j) ((e6Isogeny k x : adjointGroup .E6 k) : ModGL .E6 k) =
    baseChangeGL ι (baseChangeGL j ((e6Isogeny k x : adjointGroup .E6 k) : ModGL .E6 k))
  rw [baseChangeGL_baseChangeGL]

theorem e6IsogenyAlgebraic_xm_single (i : Fin Tag.E6.rank) (c : Ω) :
    e6IsogenyAlgebraic (e6Data_valid.xm Ω (Pi.single i 1) c) = xUnit Tag.E6 Ω i c := by
  classical
  obtain ⟨F, hF, hCF, _⟩ := exists_finite_subfield_of_finset
    (K := ZMod 2) (L := Ω) ({c} : Finset Ω)
  letI : Finite F := hF
  let cF : F := ⟨c, hCF (Finset.mem_singleton_self _)⟩
  have hbc : minBC e6Data_valid F.subtype (e6Data_valid.xm F (Pi.single i 1) cF) =
      e6Data_valid.xm Ω (Pi.single i 1) c := by
    rw [minBC_xm_single]
    rfl
  rw [← hbc, e6IsogenyAlgebraic_minBC]
  change baseChangeGL F.subtype
    ((e6Isogeny F (e6Data_valid.xm F (Pi.single i 1) cF) : adjointGroup .E6 F) : ModGL .E6 F) = _
  rw [e6Isogeny_xm_single, eltElement_simpleRoot_E6]
  change baseChangeGL F.subtype (xUnit Tag.E6 F i cF) = xUnit Tag.E6 Ω i c
  rw [baseChangeGL_xUnit]
  rfl

theorem e6IsogenyAlgebraic_xm_neg_single (i : Fin Tag.E6.rank) (c : Ω) :
    e6IsogenyAlgebraic (e6Data_valid.xm Ω (-Pi.single i 1) c) = yUnit Tag.E6 Ω i c := by
  classical
  obtain ⟨F, hF, hCF, _⟩ := exists_finite_subfield_of_finset
    (K := ZMod 2) (L := Ω) ({c} : Finset Ω)
  letI : Finite F := hF
  let cF : F := ⟨c, hCF (Finset.mem_singleton_self _)⟩
  have hbc : minBC e6Data_valid F.subtype (e6Data_valid.xm F (-Pi.single i 1) cF) =
      e6Data_valid.xm Ω (-Pi.single i 1) c := by
    rw [minBC_xm_neg_single]
    rfl
  rw [← hbc, e6IsogenyAlgebraic_minBC]
  change baseChangeGL F.subtype
    ((e6Isogeny F (e6Data_valid.xm F (-Pi.single i 1) cF) : adjointGroup .E6 F) : ModGL .E6 F) = _
  rw [e6Isogeny_xm_neg_single, eltElement_neg_simpleRoot_E6]
  change baseChangeGL F.subtype (yUnit Tag.E6 F i cF) = yUnit Tag.E6 Ω i c
  rw [baseChangeGL_yUnit]
  rfl

theorem e6IsogenyAlgebraic_sigma (Fr : Ω →+* Ω) (g : e6Data_valid.minGroup Ω) :
    e6IsogenyAlgebraic (CFSG.LieType.Steinberg.TwistedE6.sigma Ω Fr g) =
      twistHom TwistTag.E6 Ω Fr (e6IsogenyAlgebraic g) := by
  let F : ModGL Tag.E6 Ω →* ModGL Tag.E6 Ω := twistHom TwistTag.E6 Ω Fr
  have hFx (i : Fin Tag.E6.rank) (c : Ω) :
      F (xUnit Tag.E6 Ω i c) = xUnit Tag.E6 Ω (CFSG.LieType.Steinberg.TwistedE6.rhoPerm i) (Fr c) := by
    with_unfolding_all exact twistHom_xUnit TwistTag.E6 Ω Fr i c
  have hFy (i : Fin Tag.E6.rank) (c : Ω) :
      F (yUnit Tag.E6 Ω i c) = yUnit Tag.E6 Ω (CFSG.LieType.Steinberg.TwistedE6.rhoPerm i) (Fr c) := by
    with_unfolding_all exact twistHom_yUnit TwistTag.E6 Ω Fr i c
  have h : e6IsogenyAlgebraic.comp (CFSG.LieType.Steinberg.TwistedE6.sigma Ω Fr) =
      F.comp e6IsogenyAlgebraic := by
    refine MonoidHom.eq_of_eqOn_dense (closure_xm_simple_eq_top e6Data_valid Ω) ?_
    rintro _ ⟨i, c, rfl | rfl⟩
    · simp only [MonoidHom.comp_apply]
      rw [CFSG.LieType.Steinberg.TwistedE6.sigma_xm_single, e6IsogenyAlgebraic_xm_single,
        e6IsogenyAlgebraic_xm_single, hFx]
    · simp only [MonoidHom.comp_apply]
      rw [CFSG.LieType.Steinberg.TwistedE6.sigma_xm_neg_single, e6IsogenyAlgebraic_xm_neg_single,
        e6IsogenyAlgebraic_xm_neg_single, hFy]
  exact DFunLike.congr_fun h g

theorem range_minTorus_e6_eq_iSup :
    (minTorus e6Data_valid Ω).range = ⨆ i, e6Data_valid.torus Ω i := by
  apply le_antisymm
  · rintro _ ⟨u, rfl⟩
    induction u using CFSG.LieType.Chevalley.ExceptionalCover.torusVec_induction with
    | h1 => simp only [map_one]; exact one_mem _
    | hmul u v hu hv => simpa only [map_mul] using mul_mem hu hv
    | hsingle i s =>
      rw [minTorus_mulSingle]
      exact le_iSup (e6Data_valid.torus Ω) i (e6Data_valid.hm_mem_torus Ω i s)
  · refine iSup_le fun i t ht => ?_
    obtain ⟨s, rfl⟩ := ht
    exact ⟨Pi.mulSingle i s, minTorus_mulSingle e6Data_valid Ω i s⟩

