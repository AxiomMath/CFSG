@[expose] def srSepCheck : Bool :=
  (List.range 56).all fun i => (List.range 56).all fun j => i == j ||
    (List.range 14).any fun p =>
      coeffAtPos (srOrbit.getD i []) p % 3 != coeffAtPos (srOrbit.getD j []) p % 3

@[expose] def srSpanCheck : Bool :=
