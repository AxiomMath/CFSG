@[expose] def normModVec (n : ℕ) (v : List (ℕ × ℤ)) : List (ℕ × ℤ) :=
  ((normalize v).map fun x => (x.1, x.2 % (n : ℤ))).filter fun x => x.2 != 0

@[expose] def coeffAtPos (v : List (ℕ × ℤ)) (p : ℕ) : ℤ :=
  ((v.filter fun x => x.1 == p).map Prod.snd).sum

@[expose] def srCombo (cs : List (ℕ × ℤ)) : List (ℕ × ℤ) :=
  cs.flatMap fun x => (srOrbit.getD x.1 []).map fun y => (y.1, x.2 * y.2)

@[expose] def srActCheck (E : List Entry) (σ : List ℕ) : Bool :=
  (List.range 56).all fun i =>
