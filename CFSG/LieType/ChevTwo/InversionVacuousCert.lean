theorem outerKleinFour_false_of_G2_of_certs
    {S : Type} [Group S] [Finite S] (q : TauCeti.PrimePower)
    (hv : (TauCeti.LieTypeIndex.G2 q).Valid) (hq : q.p = 2)
    (e : S ≃* (TauCeti.CFSGIndex.lie ⟨.G2 q, hv⟩).Group) {A : Subgroup (MulAut S)}
    (hA : OuterKleinFour A) : False := by
  have : Fact q.p.Prime := ⟨q.prime_p⟩
  have hq3 : 3 ≤ q.card :=
    (TauCeti.LieTypeIndex.inStandardRange_iff _).1 ((TauCeti.LieTypeIndex.valid_iff _).1 hv).1
  have hK : Nat.card (GaloisField q.p q.exponent) = q.card := by
    rw [GaloisField.card _ _ q.exponent_pos.ne', TauCeti.PrimePower.card_def]
  obtain ⟨e0⟩ := CFSG.TauCetiBridge.Even.untwistedBridgeEven_G2 q hv hq
    (GaloisField q.p q.exponent) hK
  have hce : CFSG.Blueprint.ChevalleyExceptionalModel
      (TauCeti.CFSGIndex.lie ⟨.G2 q, hv⟩).Group .G2 q.p q.exponent := by
    refine ⟨⟨q.prime_p, q.exponent_pos, rfl, ?_⟩, GaloisField q.p q.exponent, inferInstance,
      inferInstance, ?_, ⟨e0.symm⟩⟩
    · rw [← TauCeti.PrimePower.card_def]
      exact hq3
    · rw [hK, TauCeti.PrimePower.card_def]
  rw [hq] at hce
  exact not_outerKleinFour_of_outPNice (OutPNice.of_mulEquiv e (outPNice_G2 Nat.prime_two hce)) hA

theorem kleinFamily_of_isChevTwoExc_of_certs
    {S : Type} [Group S] [Finite S] (h : IsChevTwoExc S) {A : Subgroup (MulAut S)}
    (hA : OuterKleinFour A) : IsE6TwoFamily S := by
  obtain ⟨⟨d, hv⟩, hd, ⟨e⟩⟩ := h
  have hB := CFSG.TauCetiBridge.Even.chevalleyBridgesAll
  cases d with
  | E6 q => exact ⟨q, hv, hd, ⟨e⟩⟩
  | E7 q =>
    have hP : OutPNice 2 S := outPNice_E7E8_of_untwisted Nat.prime_two .E7 (Or.inl rfl)
      q.exponent_pos (CFSG.StandardType.ChevTwo.untwistedChevalleyModel_of_bridge hB.e7 q hv hd e)
    exact (not_outerKleinFour_of_outPNice hP hA).elim
  | E8 q =>
    have hP : OutPNice 2 S := outPNice_E7E8_of_untwisted Nat.prime_two .E8 (Or.inr rfl)
      q.exponent_pos (CFSG.StandardType.ChevTwo.untwistedChevalleyModel_of_bridge hB.e8 q hv hd e)
    exact (not_outerKleinFour_of_outPNice hP hA).elim
  | F4 q =>
    have hP : OutPNice 2 S := outPNice_F4 Nat.prime_two (f := q.exponent)
      ⟨⟨Nat.prime_two, q.exponent_pos, rfl⟩,
        CFSG.StandardType.ChevTwo.untwistedChevalleyModel_of_bridge hB.f4 q hv hd e⟩
    exact (not_outerKleinFour_of_outPNice hP hA).elim
  | twistedE6 q =>
    have hP : OutPNice 2 S := outPNice_twistedE6 Nat.prime_two (by norm_num) (f := q.exponent)
      ⟨⟨Nat.prime_two, q.exponent_pos, rfl⟩,
        CFSG.StandardType.ChevTwo.twistedChevalleyModel_of_bridge hB.twistedE6 q hv hd e⟩
    exact (not_outerKleinFour_of_outPNice hP hA).elim
  | trialityD4 q =>
    have hP : OutPNice 2 S := outPNice_trialityD4 Nat.prime_two (f := q.exponent)
      ⟨⟨Nat.prime_two, q.exponent_pos, rfl⟩,
        CFSG.StandardType.ChevTwo.twistedChevalleyModel_of_bridge hB.trialityD4 q hv hd e⟩
    exact (not_outerKleinFour_of_outPNice hP hA).elim
  | suzuki m =>
    have hP : OutPNice 2 S :=
      outPNice_Suzuki Nat.prime_two (CFSG.StandardType.ChevTwo.suzukiModel_of_valid m hv e)
    exact (not_outerKleinFour_of_outPNice hP hA).elim
  | reeF4 a =>
    have hP : OutPNice 2 S :=
      outPNice_twistedF4 Nat.prime_two (CFSG.StandardType.ChevTwo.reeTitsModel_of_reeF4 a hv e)
    exact (not_outerKleinFour_of_outPNice hP hA).elim
  | tits =>
    have hO : Nat.card (Outer S) = 2 :=
      (CFSG.Sporadic.Schreier.Tits.CTI_Tits_model_outer_two_part_bound S 2 1
        (CFSG.StandardType.ChevTwo.reeTitsModel_of_tits hv e)).2.2.1
    have h4 : Nat.card (Outer S) = (inner S).index := rfl
    have hidx : (inner S).index ≤ 2 := by omega
    exact (not_outerKleinFour_of_index_le_two hidx hA).elim
  | A _ _ | twistedA _ _ | B _ _ | C _ _ | D _ _ | twistedD _ _ | G2 _ | reeG2 _ =>
    exact hd.elim

theorem g2NoKlein_of_certs
    : G2NoKlein := fun _ _ _ q hv hq e _ hA => outerKleinFour_false_of_G2_of_certs q hv hq e hA

theorem excOnlyE6_of_certs
    : ExcOnlyE6 := fun _ _ _ h _ hA => kleinFamily_of_isChevTwoExc_of_certs h hA

theorem chev2RankTwoInverts_of_certs
    : Chev2RankTwoInverts :=
  chev2RankTwoInverts_of_hyps g2NoKlein_of_certs excOnlyE6_of_certs
    (fun _ _ h A hA => chev2RankTwoInverts_E6_of_certs h hA) chev2RankTwoInverts_orthPlus
    chev2RankTwoInverts_orthMinus

