section Helpers

variable {F K : Type} [Field F] [Field K] [Algebra F K] [Finite K] [CharP K 2] {f : ℕ}

theorem finiteDimensional_of_quadExt (E : QuadExt F K (unitaryInvolution K 2 f)) :
    FiniteDimensional F K :=
  FiniteDimensional.of_finrank_pos (by rw [E.finrank_eq]; norm_num)

end Helpers

section HypPlane

variable {F : Type} [Field F]

private theorem polar_hypPlane (p q : F × F) :
    QuadraticMap.polar (hypPlane F) p q = p.1 * q.2 + q.1 * p.2 := by
  simp only [QuadraticMap.polar, hypPlane_apply, Prod.fst_add, Prod.snd_add]
  ring

private theorem hypPlane_polarBilin_nondegenerate :
    (QuadraticMap.polarBilin (hypPlane F)).Nondegenerate := by
  refine CFSG.LieType.Universal.Spin.nondegenerate_polarBilin_of_forall fun p hp => ?_
  have h1 := hp (0, 1)
  have h2 := hp (1, 0)
  rw [polar_hypPlane] at h1 h2
  simp only [mul_one, one_mul, mul_zero, zero_mul, add_zero, zero_add] at h1 h2
  exact Prod.ext h1 h2

private theorem isPlusType_hypPlane : IsPlusType (hypPlane F) := by
  refine ⟨LinearMap.range (LinearMap.inl F F F), ?_, ?_⟩
  · have hinj : Function.Injective (LinearMap.inl F F F) := by
      intro a b h
      simpa using congrArg Prod.fst h
    rw [LinearMap.finrank_range_of_inj hinj, Module.finrank_self, Module.finrank_prod,
      Module.finrank_self]
  · rintro _ ⟨a, rfl⟩
    rw [hypPlane_apply]
    simp

end HypPlane

variable {F K : Type} [Field F] [Field K] [Algebra F K] [Finite K] [CharP K 2] {f : ℕ}
  (E : QuadExt F K (unitaryInvolution K 2 f))

include E in
theorem finrank_normHypForm (m : ℕ) :
    Module.finrank F ((F × F) × (Fin m → K)) = 2 * (m + 1) := by
  let : FiniteDimensional F K := finiteDimensional_of_quadExt E
  rw [Module.finrank_prod, Module.finrank_prod, Module.finrank_self,
    CFSG.ClassicalInvolution.PhanDn.finrank_Qn E m]
  ring

theorem isPlusType_normHypForm_iff (m : ℕ) : IsPlusType (normHypForm E m) ↔ Even m := by
  let : Finite F := Finite.of_injective (algebraMap F K) (algebraMap F K).injective
  let : FiniteDimensional F K := finiteDimensional_of_quadExt E
  rcases m with _ | m
  · refine ⟨fun _ => ⟨0, rfl⟩, fun _ => ?_⟩
    refine ⟨LinearMap.range ((LinearMap.inl F F F).prod
      (0 : F →ₗ[F] (Fin 0 → K))), ?_, ?_⟩
    · have hinj : Function.Injective
          ((LinearMap.inl F F F).prod (0 : F →ₗ[F] (Fin 0 → K))) := by
        intro a b h
        simpa using congrArg (fun p : (F × F) × (Fin 0 → K) => p.1.1) h
      rw [LinearMap.finrank_range_of_inj hinj, Module.finrank_self,
        finrank_normHypForm E 0]
    · rintro _ ⟨a, rfl⟩
      simp [normHypForm, hypSum_apply, Qn_apply]
  · have hprod : IsPlusType (normHypForm E (m + 1)) ↔
        (IsPlusType (hypPlane F) ↔ IsPlusType (Qn E (m + 1))) :=
      CFSG.ClassicalInvolution.RouteD.TWY.isPlusType_prod_iff
        (Q₁ := hypPlane F) (Q₂ := Qn E (m + 1)) (hypPlane_polarBilin_nondegenerate)
        (Qn_polarBilin_nondegenerate E (m + 1)) le_rfl (Nat.succ_le_succ (Nat.zero_le m))
        (by rw [Module.finrank_prod, Module.finrank_self])
        (CFSG.ClassicalInvolution.PhanDn.finrank_Qn E (m + 1))
    constructor
    · intro h
      exact (CFSG.ClassicalInvolution.PhanDn.isPlusType_Qn_iff E (m + 1)).mp
        ((hprod.mp h).mp isPlusType_hypPlane)
    · intro hm
      exact hprod.mpr
        ⟨fun _ => (CFSG.ClassicalInvolution.PhanDn.isPlusType_Qn_iff E (m + 1)).mpr hm,
          fun _ => isPlusType_hypPlane⟩

theorem nonempty_isometryEquiv_quadPlus_of_even [Finite F] {m : ℕ} (hm : Even m) :
    Nonempty ((normHypForm E m).IsometryEquiv (quadPlus (m + 1) F)) := by
  let : FiniteDimensional F K := finiteDimensional_of_quadExt E
  exact nonempty_isometry_quadPlus (Q := normHypForm E m)
    (normHypForm_polarBilin_nondegenerate E m) (finrank_normHypForm E m)
    ((isPlusType_normHypForm_iff E m).mpr hm)

theorem nonempty_isometryEquiv_quadMinus_of_odd [Finite F] {m : ℕ} (hm : Odd m) {b c : F}
    (hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0) :
    Nonempty ((normHypForm E m).IsometryEquiv (quadMinus (m + 1) F b c)) := by
  let : FiniteDimensional F K := finiteDimensional_of_quadExt E
  refine nonempty_isometry_of_not_isPlusType (Q := normHypForm E m)
    (normHypForm_polarBilin_nondegenerate E m) (Nat.succ_le_succ (Nat.zero_le m))
    (finrank_normHypForm E m) ?_ hirr
  rw [isPlusType_normHypForm_iff E m]
  exact Nat.not_even_iff_odd.mpr hm

theorem nonempty_normOmega_mulEquiv_plus [Finite F] {m : ℕ} (hm : Even m) :
    Nonempty (normOmega E m ≃* CFSG.Open.StatedOmega (CFSG.Open.StatedQuadPlus (m + 1) F)) := by
  obtain ⟨e⟩ := nonempty_isometryEquiv_quadPlus_of_even E hm
  exact ⟨(CFSG.ClassicalGroups.Orthogonal.commutatorOrthogonalGroupCongr e).trans
    (CFSG.RankThree.GF2n.Stroth80.statedOmegaMulEquivDerived
      (Q := quadPlus (m + 1) F) (CFSG.LieType.Universal.Spin.coe_quadPlus (m + 1) F)).symm⟩

theorem nonempty_normOmega_mulEquiv_minus [Finite F] {m : ℕ} (hm : Odd m) {b c : F}
    (hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0) :
    Nonempty
      (normOmega E m ≃* CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus (m + 1) F b c)) := by
  obtain ⟨e⟩ := nonempty_isometryEquiv_quadMinus_of_odd E hm hirr
  exact ⟨(CFSG.ClassicalGroups.Orthogonal.commutatorOrthogonalGroupCongr e).trans
    (CFSG.RankThree.GF2n.Stroth80.statedOmegaMulEquivDerived
      (Q := quadMinus (m + 1) F b c)
      (CFSG.LieType.Universal.Spin.coe_quadMinus (m + 1) F b c)).symm⟩

theorem nonempty_spinPlus_mulEquiv_normOmega [Finite F] {m : ℕ} (hm : Even m) (hm2 : 2 ≤ m) :
    Nonempty (spinGroup (quadPlus (m + 1) F) ≃* normOmega E m) := by
  have h2 : (2 : F) = 0 := by
    apply (algebraMap F K).injective
    rw [map_ofNat, map_zero]
    exact CharP.cast_eq_zero K 2
  obtain ⟨e⟩ := nonempty_isometryEquiv_quadPlus_of_even E hm
  exact ⟨(CFSG.LieType.Universal.Spin.commutatorEquivSpinPlusOfIsometry e
    (by omega) h2).symm⟩

theorem nonempty_spinMinus_mulEquiv_normOmega [Finite F] {m : ℕ} (hm : Odd m) (hm3 : 3 ≤ m)
    {b c : F} (hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0) :
    Nonempty (spinGroup (quadMinus (m + 1) F b c) ≃* normOmega E m) := by
  have h2 : (2 : F) = 0 := by
    apply (algebraMap F K).injective
    rw [map_ofNat, map_zero]
    exact CharP.cast_eq_zero K 2
  obtain ⟨e⟩ := nonempty_isometryEquiv_quadMinus_of_odd E hm hirr
  exact ⟨(CFSG.LieType.Universal.Spin.commutatorEquivSpinMinusOfIsometry e
    (by omega) hirr h2).symm⟩

end CFSG.ClassicalGroups.Orthogonal.UnitaryOmega
