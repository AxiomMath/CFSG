@[expose] def L7 : Nat := nat_lit 

@[expose] def L1FF : Nat := nat_lit 

@[expose] def L1 : Nat := nat_lit 

@[expose] def COLM : Nat := nat_lit 

@[expose] def M120 : Nat := nat_lit 1329227995784915872903807060280344575

@[expose] def ONE7 : Nat := nat_lit 

@[expose] def NEG7 : Nat := nat_lit 

@[expose] noncomputable def P1200 : Nat := Nat.shiftLeft (nat_lit 1) (nat_lit 1200)

@[expose] noncomputable def M1200 : Nat := Nat.sub P1200 (nat_lit 1)

@[expose] noncomputable def fold7 (x : Nat) : Nat :=
  strictN x (fun v => Nat.add (Nat.land v L7) (Nat.land (Nat.shiftRight v (nat_lit 3)) L1FF))

@[expose] noncomputable def red7 (x : Nat) : Nat :=
  strictN (fold7 (fold7 (fold7 (fold7 (fold7 x))))) (fun s =>
    Nat.sub s (Nat.mul (Nat.land (Nat.shiftRight (Nat.add s L1) (nat_lit 3)) L1) (nat_lit 7)))

@[expose] noncomputable def wf7 (X : Nat) : Bool :=
  andB (Nat.blt X P1200) (Nat.beq (red7 X) X)

@[expose] noncomputable def row7 (B k : Nat) : Nat :=
  Nat.land (Nat.shiftRight B (Nat.mul (nat_lit 120) k)) M120

@[expose] noncomputable def col7 (A k : Nat) : Nat :=
  Nat.land (Nat.shiftRight A (Nat.mul (nat_lit 12) k)) COLM

@[expose] noncomputable def mul7 (A B : Nat) : Nat :=
  red7 (Nat.rec (motive := fun _ => Nat) (nat_lit 0)
    (fun k acc => strictN acc (fun s => Nat.add s (Nat.mul (row7 B k) (col7 A k)))) (nat_lit 10))

