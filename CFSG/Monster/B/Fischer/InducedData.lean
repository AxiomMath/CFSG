@[expose] def indM22Gen (k : Nat) : Array Nat := hexTable3 3510 (3510 * k) indM22GenHex

@[expose] def indTransGen (k : Nat) : Array Nat := hexTable3 3510 (3510 * k) indTransGenHex

@[expose] def indCentral : Array Nat := hexTable3 3510 0 indCentralHex

@[expose] def indCandidate (k : Nat) : Array Nat :=
  if k < 2 then indM22Gen k else if k < 12 then indTransGen (k - 2) else indCentral

@[expose] def indSigma : List (Nat × Nat) :=
  (List.range 770).map fun i => ((hexTable3 1 i indSigmaHex)[0]!,
    (hexTable3 1 (770 + i) indSigmaHex)[0]!)

@[expose] def indTau : List (Nat × Nat) :=
  (List.range 1232).map fun i => ((hexTable3 1 i indTauHex)[0]!,
    (hexTable3 1 (1232 + i) indTauHex)[0]!)

@[expose] def pinXiRaw : Array Nat := hexTable3 3510 0 pinXiHex

