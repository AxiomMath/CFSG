@[expose] def compose (c d : List ℕ) : List ℕ := d.map fun i => c.getD i 0

@[expose] def idCode : List ℕ := List.range 24

@[expose] def codeWord (l : List (Fin 4)) : List ℕ := l.foldr (fun k c => compose (gc k) c) idCode

@[expose] def wordIdx (l : List (Fin 4)) (x : ℕ) : ℕ := l.foldr (fun k y => gidx k y) x

theorem ptList_length : ptList.length = 24 := by decide +kernel

theorem ptList_nodup : ptList.Nodup := by decide +kernel

theorem ptList_lengths : ∀ p ∈ ptList, p.length = 6 := by decide +kernel

theorem theta_eq : List.ofFn θ = ptList.getD 23 [] := by decide +kernel

theorem gc_length : ∀ k : Fin 4, (gc k).length = 24 := by decide +kernel

theorem r_pv : ∀ k : Fin 4, ∀ a < 24,
    gidx k a < 24 ∧ List.ofFn (r k (pv a)) = ptList.getD (gidx k a) [] := by
  decide +kernel

theorem wordIdx_tWords : ∀ a < 24, wordIdx (tWords.getD a []) 23 = a := by decide +kernel

theorem codeWord_tWords : ∀ a < 24, codeWord (tWords.getD a []) = tCodes.getD a [] := by
  decide +kernel

theorem tCodes_theta : ∀ a < 24, (tCodes.getD a []).getD 23 0 = a := by decide +kernel

theorem tWords_theta : tWords.getD 23 [] = [] := by decide +kernel

theorem jWords_length : jWords.length = 48 := by decide +kernel

theorem jCodes_length : jCodes.length = 48 := by decide +kernel

theorem codeWord_jWords : ∀ i < 48, codeWord (jWords.getD i []) = jCodes.getD i [] := by
  decide +kernel

theorem jWords_letters : ∀ l ∈ jWords, ∀ k ∈ l, k ≠ 0 := by decide +kernel

theorem jCodes_nodup : jCodes.Nodup := by decide +kernel

theorem jWords_zero : jWords.getD 0 [] = [] := by decide +kernel

theorem jCodes_edge : ∀ i < 48, ∀ j : Fin 4, j ≠ 0 → ∃ m < 48,
    compose (gc j) (jCodes.getD i []) = jCodes.getD m [] ∧
      (jWords.getD m []).length ≤ (jWords.getD i []).length + 1 ∧
      ((jWords.getD m []).length = (jWords.getD i []).length + 1 →
        wordWeight (jWords.getD m []) = letterWeight j * wordWeight (jWords.getD i [])) := by
  decide +kernel

theorem jWords_tail : ∀ i < 48, jWords.getD i [] = [] ∨
    ∃ m < 48, (jWords.getD i []).tail = jWords.getD m [] := by
  decide +kernel

theorem gc_theta : ∀ j : Fin 4, j ≠ 0 → (gc j).getD 23 0 = 23 := by decide +kernel

theorem kWords_length : kWords.length = 48 := by decide +kernel

theorem kCodes_length : kCodes.length = 48 := by decide +kernel

theorem codeWord_kWords : ∀ i < 48, codeWord (kWords.getD i []) = kCodes.getD i [] := by
  decide +kernel

theorem kWords_letters : ∀ l ∈ kWords, ∀ k ∈ l, k ≠ 3 := by decide +kernel

theorem kCodes_nodup : kCodes.Nodup := by decide +kernel

theorem kWords_zero : kWords.getD 0 [] = [] := by decide +kernel

theorem kCodes_closed : ∀ i < 48, ∀ k : Fin 4, k ≠ 3 →
    compose (gc k) (kCodes.getD i []) ∈ kCodes := by
  decide +kernel

theorem kCodes_orbit : ∀ a < 24, (∃ i < 48, (kCodes.getD i []).getD 23 0 = a) ↔ a ∈ sIdx := by
  decide +kernel

theorem tCodes_edge : ∀ a < 24, ∀ k : Fin 4,
    (compose (gc k) (tCodes.getD a []) = tCodes.getD (gidx k a) [] ∧
      (tWords.getD (gidx k a) []).length ≤ (tWords.getD a []).length + 1 ∧
      ((tWords.getD (gidx k a) []).length = (tWords.getD a []).length + 1 →
        wordWeight (tWords.getD (gidx k a) []) = letterWeight k * wordWeight (tWords.getD a []))) ∨
    (gidx k a = a ∧ ∃ j : Fin 4, j ≠ 0 ∧
      compose (gc k) (tCodes.getD a []) = compose (tCodes.getD a []) (gc j) ∧
      letterWeight j = letterWeight k) := by
  decide +kernel

theorem tWords_tail : ∀ a < 24, a ≠ 23 → tWords.getD a [] ≠ [] ∧
    ∃ b < 24, (tWords.getD a []).tail = tWords.getD b [] := by
