@[expose] def gxSigma (c : Nat) : Nat := [3, 4, 5, 6, 9, 2, 1, 0, 7, 8].getD c 0

@[expose] def gxParent (j : Nat) : Nat := (gxNodes.getD j (0, [])).1

@[expose] def gxWord (j : Nat) : List Nat := (gxNodes.getD j (0, [])).2

@[expose] def gxXList (j : Nat) : List Nat :=
  if h : 0 < j ∧ gxParent j < j then
    gxXList (gxParent j) ++
      ((gxWord j).map gxSigma ++ [10] ++ ((gxWord j).map gxSigma).reverse)
  else []
termination_by j
decreasing_by exact h.2

theorem gxNodes_length : gxNodes.length = 23 := by decide

theorem gxParent_lt_aux : ∀ j, j < 23 → 0 < j → gxParent j < j := by decide

theorem gxParent_lt {j : Nat} (h0 : 0 < j) (h23 : j < 23) : gxParent j < j :=
  gxParent_lt_aux j h23 h0

theorem gxWord_lt (j : Nat) : ∀ c ∈ gxWord j, c < 10 := by
  have h : ∀ q ∈ gxNodes, ∀ c ∈ q.2, c < 10 := by decide +kernel
  intro c hc
  unfold gxWord at hc
  rw [List.getD_eq_getElem?_getD, List.getD_getElem?] at hc
  by_cases hj : j < gxNodes.length
  · rw [dite_eq_left hj] at hc
    exact h _ (List.getElem_mem hj) c hc
  · rw [dite_eq_right hj] at hc
    simp at hc

theorem gxSigma_lt_aux : ∀ c, c < 10 → gxSigma c < 10 := by decide

theorem gxSigma_lt (c : Nat) : gxSigma c < 10 := by
  by_cases h : c < 10
  · exact gxSigma_lt_aux c h
  · unfold gxSigma
    rw [List.getD_eq_getElem?_getD,
      List.getElem?_eq_none (by simp only [List.length_cons, List.length_nil]; omega)]
    decide

theorem gxXList_lt (j : Nat) : ∀ k ∈ gxXList j, k < 11 := by
  induction j using Nat.strongRecOn with
  | _ j ih =>
    by_cases h : 0 < j ∧ gxParent j < j
    · rw [gxXList, dite_eq_left h]
      intro k hk
      rcases List.mem_append.1 hk with hk | hk
      · exact ih _ h.2 k hk
      · rcases List.mem_append.1 hk with hk | hk
        · rcases List.mem_append.1 hk with hk | hk
          · obtain ⟨c, _, rfl⟩ := List.mem_map.1 hk
            have := gxSigma_lt c
            omega
          · have := List.mem_singleton.1 hk
            omega
        · obtain ⟨c, _, rfl⟩ := List.mem_map.1 (List.mem_reverse.1 hk)
          have := gxSigma_lt c
          omega
    · rw [gxXList, dite_eq_right h]
      intro k hk
      simp at hk

