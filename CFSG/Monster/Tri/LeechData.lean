@[expose] def hexVal (c : UInt8) : Nat := if c.toNat < 58 then c.toNat - 48 else c.toNat - 55

@[expose] def hexNum (b : ByteArray) (o w : Nat) : Nat :=
  (List.range w).foldl (fun acc k => acc * 16 + hexVal (b.get! (o + k))) 0

@[expose] def hexTable (w : Nat) (s : String) : Array Nat :=
