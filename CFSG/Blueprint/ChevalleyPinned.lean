@[expose] def Tag.witnesses : Tag → WitnessTable
  | .G2 => g2Witnesses
  | .F4 => f4Witnesses
  | .D4 => d4Witnesses
  | .E6 => e6Witnesses
  | .E7 => e7Witnesses
  | .E8 => e8Witnesses

theorem Tag.rank_pos (τ : Tag) : 0 < τ.rank := by cases τ <;> decide

@[expose] def Tag.idx (τ : Tag) (j : ℕ) : Fin τ.rank := ⟨j % τ.rank, Nat.mod_lt _ τ.rank_pos⟩

open Classical in
@[expose] def pinnedData (τ : Tag) (α : Fin τ.rank → ℤ) : Fin τ.rank × List ℕ × ℤ :=
  if h : ∃ j, α = Pi.single j 1 then (h.choose, [], 1)
  else if h' : ∃ j, α = -Pi.single j 1 then (h'.choose, [(h'.choose : ℕ)], -1)
  else
    let k := τ.witnesses.roots.findIdx fun c => decide (decodeVec (τ := τ) c = α)
    (τ.idx (τ.witnesses.seeds.getD k 0), decodeWord (τ.witnesses.words.getD k 0), 1)

variable (τ : Tag) (R : Type*) [CommRing R]

@[expose] def pinnedWeyl (α : Fin τ.rank → ℤ) : (Module.End R (RootModule τ R))ˣ :=
  (((pinnedData τ α).2.1.map fun i => weylElt τ R (τ.idx i) 1).reverse).prod

@[expose] def pinnedX (α : Fin τ.rank → ℤ) (c : R) : (Module.End R (RootModule τ R))ˣ :=
  pinnedWeyl τ R α * xUnit τ R (pinnedData τ α).1 ((pinnedData τ α).2.2 • c) *
    (pinnedWeyl τ R α)⁻¹

@[expose] def pinnedE (α : Fin τ.rank → ℤ) : Module.End R (RootModule τ R) :=
  ((pinnedData τ α).2.2 : R) •
    ((pinnedWeyl τ R α : Module.End R (RootModule τ R)) * infE τ R (pinnedData τ α).1 *
      ((pinnedWeyl τ R α)⁻¹ : (Module.End R (RootModule τ R))ˣ))

@[expose] def rootSubgroup (α : Fin τ.rank → ℤ) : Subgroup (Module.End R (RootModule τ R))ˣ :=
  Subgroup.closure (Set.range (pinnedX τ R α))

@[expose] def rootSpan (S : Set (Fin τ.rank → ℤ)) : Subgroup (Module.End R (RootModule τ R))ˣ :=
  ⨆ α ∈ S, rootSubgroup τ R α

@[expose] def posUnipotent : Subgroup (Module.End R (RootModule τ R))ˣ :=
  rootSpan τ R {α | IsRoot τ α ∧ 0 < height α}

@[expose] def negUnipotent : Subgroup (Module.End R (RootModule τ R))ˣ :=
  rootSpan τ R {α | IsRoot τ α ∧ height α < 0}

end CFSG.Blueprint.Chevalley
