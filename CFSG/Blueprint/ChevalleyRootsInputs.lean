namespace Tag

@[expose] def rootCertificate : (τ : Tag) → RootCertificate τ
  | G2 => g2Certificate
  | F4 => f4Certificate
  | D4 => d4Certificate
  | E6 => e6Certificate
  | E7 => e7Certificate
  | E8 => e8Certificate

end Tag

@[expose] def rootFinset (τ : Tag) : Finset (Fin τ.rank → ℤ) :=
  ((List.range τ.rootCertificate.roots.length).map τ.rootCertificate.root).toFinset

theorem Tag.cartanE_self (r : ℕ) (i : Fin r) : Tag.cartanE r i i = 2 := by
  simp [Tag.cartanE]

theorem Tag.cartan_self (τ : Tag) (i : Fin τ.rank) : τ.cartan i i = 2 := by
  cases τ
  case E6 | E7 | E8 => exact Tag.cartanE_self _ i
  all_goals (fin_cases i <;> rfl)

theorem reflect_single_self (τ : Tag) (i : Fin τ.rank) :
    reflect τ i (Pi.single i 1) = -Pi.single i 1 := by
  rw [reflect, Finset.sum_eq_single i (fun j _ hj => by simp [hj])
    (fun h => absurd (Finset.mem_univ i) h)]
  simp only [Pi.single_eq_same, mul_one, τ.cartan_self]
  ext j
  simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Pi.neg_apply]
  rcases eq_or_ne j i with rfl | hj
  · simp
  · simp [hj]

theorem isRoot_single (τ : Tag) (i : Fin τ.rank) : IsRoot τ (Pi.single i 1) :=
  .basis i

theorem isRoot_neg_single (τ : Tag) (i : Fin τ.rank) : IsRoot τ (-Pi.single i 1) := by
  rw [← reflect_single_self]
  exact .reflect i (.basis i)

namespace RootCertificate

variable {τ : Tag} (C : RootCertificate τ)

@[expose] def checkSigns : Bool :=
  (List.range C.roots.length).all fun k =>
    (((List.finRange τ.rank).all fun j => decide (0 ≤ C.root k j)) ||
        (List.finRange τ.rank).all fun j => decide (C.root k j ≤ 0)) &&
      (List.finRange τ.rank).any fun j => decide (C.root k j ≠ 0)

@[expose] def checkNodup : Bool :=
  decide ((List.range C.roots.length).map fun k => List.ofFn (C.root k)).Nodup

end RootCertificate

namespace Tag

@[expose] def rootCount : Tag → ℕ
  | G2 => 12
  | F4 => 48
  | D4 => 24
  | E6 => 72
  | E7 => 126
  | E8 => 240

theorem rootCertificate_length (τ : Tag) : τ.rootCertificate.roots.length = τ.rootCount := by
  cases τ <;> rfl

end Tag

end CFSG.Blueprint.Chevalley
