module

public import CFSG.Blueprint.Chevalley

public section

namespace CFSG.Blueprint.Chevalley

@[expose] def decodeVec {τ : Tag} (code : ℕ) : Fin τ.rank → ℤ :=
  fun j => ((code / 16 ^ (j : ℕ) % 16 : ℕ) : ℤ) - 8

structure RootCertificate (τ : Tag) where
  roots : List ℕ
  parents : List ℕ
  table : List ℕ

namespace RootCertificate

variable {τ : Tag} (C : RootCertificate τ)

@[expose] def root (k : ℕ) : Fin τ.rank → ℤ :=
  decodeVec (C.roots.getD k 0)

@[expose] def image (k : ℕ) (i : Fin τ.rank) : ℕ :=
  C.table.getD k 0 / 256 ^ (i : ℕ) % 256

@[expose] def parent (k : ℕ) : ℕ :=
  C.parents.getD (k - τ.rank) 0 / 16

@[expose] def parentReflection (k : ℕ) : ℕ :=
  C.parents.getD (k - τ.rank) 0 % 16

@[expose] def checkBasis : Bool :=
  decide (τ.rank ≤ C.roots.length) &&
    (List.finRange τ.rank).all fun j =>
      List.ofFn (C.root j) == List.ofFn (Pi.single j 1 : Fin τ.rank → ℤ)

@[expose] def checkParents : Bool :=
  (List.range C.roots.length).all fun k =>
    decide (k < τ.rank) ||
      (decide (C.parent k < k) &&
        if h : C.parentReflection k < τ.rank then
          List.ofFn (C.root k) == List.ofFn (reflect τ ⟨_, h⟩ (C.root (C.parent k)))
        else false)

@[expose] def checkTable : Bool :=
  (List.range C.roots.length).all fun k => (List.finRange τ.rank).all fun i =>
    decide (C.image k i < C.roots.length) &&
      List.ofFn (C.root (C.image k i)) == List.ofFn (reflect τ i (C.root k))

@[expose] def check : Bool :=
  C.checkBasis && C.checkParents && C.checkTable

variable {C}

theorem eq_of_ofFn_beq {u v : Fin τ.rank → ℤ} (h : (List.ofFn u == List.ofFn v) = true) :
    u = v :=
  List.ofFn_injective (eq_of_beq h)

theorem isRoot_root (h : C.check = true) : ∀ k < C.roots.length, IsRoot τ (C.root k) := by
  simp only [check, Bool.and_eq_true] at h
  obtain ⟨⟨hb, hp⟩, -⟩ := h
  simp only [checkBasis, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true,
    List.mem_finRange, true_implies] at hb
  simp only [checkParents, List.all_eq_true, List.mem_range, Bool.or_eq_true,
    decide_eq_true_eq, Bool.and_eq_true] at hp
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    intro hk
    by_cases hkr : k < τ.rank
    · have : C.root k = Pi.single (⟨k, hkr⟩ : Fin τ.rank) 1 := eq_of_ofFn_beq (hb.2 ⟨k, hkr⟩)
      rw [this]
      exact .basis _
    · rcases hp k hk with hk' | ⟨hlt, hrefl⟩
      · exact absurd hk' hkr
      · split at hrefl
        · rw [eq_of_ofFn_beq hrefl]
          exact .reflect _ (ih _ hlt (hlt.trans hk))
        · exact absurd hrefl (by simp)

theorem exists_root_eq (h : C.check = true) {v : Fin τ.rank → ℤ} (hv : IsRoot τ v) :
    ∃ k < C.roots.length, C.root k = v := by
  simp only [check, Bool.and_eq_true] at h
  obtain ⟨⟨hb, -⟩, ht⟩ := h
  simp only [checkBasis, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true,
    List.mem_finRange, true_implies] at hb
  simp only [checkTable, List.all_eq_true, List.mem_range, List.mem_finRange, true_implies,
    Bool.and_eq_true, decide_eq_true_eq] at ht
  induction hv with
  | basis j => exact ⟨j, lt_of_lt_of_le j.2 hb.1, eq_of_ofFn_beq (hb.2 j)⟩
  | reflect i _ ih =>
    obtain ⟨k, hk, rfl⟩ := ih
    exact ⟨_, (ht k hk i).1, eq_of_ofFn_beq (ht k hk i).2⟩

theorem isRoot_iff (h : C.check = true) {v : Fin τ.rank → ℤ} :
    IsRoot τ v ↔ ∃ k < C.roots.length, C.root k = v :=
  ⟨exists_root_eq h, fun ⟨k, hk, hkv⟩ => hkv ▸ isRoot_root h k hk⟩

end RootCertificate

