@[expose] def listMat (rows : Array ℕ) (m k : ℕ) : Matrix (Fin m) (Fin k) (ZMod 2) :=
  fun r c => if (rows[r.val]?.getD 0).testBit c.val then 1 else 0

@[expose] def posWord (w : List (Fin 2 × Bool)) : List Bool :=
  w.flatMap fun l => if l.1 = 0 then [false] else if l.2 then [true] else [true, true]

@[expose] def wordsPos : Fin 6 → List Bool :=
  ![posWord a2, posWord b3, posWord ab23, posWord r5, posWord r6, posWord r7]

@[expose] def actPos (A B : Matrix (Fin 11) (Fin 11) (ZMod 2)) :
    List Bool → (Fin 11 → ZMod 2) → (Fin 11 → ZMod 2)
  | [], x => x
  | c :: w, x => (if c then B else A) *ᵥ actPos A B w x

@[expose] def foxVec (A B : Matrix (Fin 11) (Fin 11) (ZMod 2)) :
    List Bool → (Fin 11 → ZMod 2) → (Fin 11 → ZMod 2) × (Fin 11 → ZMod 2)
  | [], _ => (0, 0)
  | c :: w, x =>
    (if c then (0, actPos A B w x) else (actPos A B w x, 0)) + foxVec A B w x

@[expose] def flat (p : (Fin 11 → ZMod 2) × (Fin 11 → ZMod 2)) : Fin (11 + 11) → ZMod 2 :=
  Fin.append p.1 p.2

@[expose] def vecArr (x : Fin 11 → ZMod 2) : Array (ZMod 2) := Array.ofFn x

theorem vecArr_getD (x : Fin 11 → ZMod 2) (j : Fin 11) : (vecArr x).getD j.val 0 = x j := by
  simp [vecArr, Array.getD_eq_getD_getElem?]

@[expose] def mulVecA (M : Matrix (Fin 11) (Fin 11) (ZMod 2)) (v : Array (ZMod 2)) :
    Array (ZMod 2) :=
  Array.ofFn fun i : Fin 11 => ∑ j : Fin 11, M i j * v.getD j.val 0

@[expose] def addA (u v : Array (ZMod 2)) : Array (ZMod 2) :=
  Array.ofFn fun i : Fin 11 => u.getD i.val 0 + v.getD i.val 0

@[expose] def actPosA (A B : Matrix (Fin 11) (Fin 11) (ZMod 2)) :
    List Bool → Array (ZMod 2) → Array (ZMod 2)
  | [], v => v
  | c :: w, v => mulVecA (if c then B else A) (actPosA A B w v)

@[expose] def foxVecA (A B : Matrix (Fin 11) (Fin 11) (ZMod 2)) :
    List Bool → Array (ZMod 2) → Array (ZMod 2) × Array (ZMod 2)
  | [], _ => (vecArr 0, vecArr 0)
  | c :: w, x =>
    let y := actPosA A B w x
    let r := foxVecA A B w x
    if c then (r.1, addA r.2 y) else (addA r.1 y, r.2)

theorem mulVecA_vecArr (M : Matrix (Fin 11) (Fin 11) (ZMod 2)) (x : Fin 11 → ZMod 2) :
    mulVecA M (vecArr x) = vecArr (M *ᵥ x) := by
  show Array.ofFn _ = Array.ofFn _
  apply congrArg Array.ofFn
  funext i
  simp only [Matrix.mulVec, dotProduct]
  exact Finset.sum_congr rfl fun j _ => by rw [vecArr_getD]

theorem addA_vecArr (u v : Fin 11 → ZMod 2) : addA (vecArr u) (vecArr v) = vecArr (u + v) := by
  show Array.ofFn _ = Array.ofFn _
  apply congrArg Array.ofFn
  funext i
  simp only [vecArr_getD]
  rfl

theorem actPosA_vecArr (A B : Matrix (Fin 11) (Fin 11) (ZMod 2)) (w : List Bool)
    (x : Fin 11 → ZMod 2) : actPosA A B w (vecArr x) = vecArr (actPos A B w x) := by
  induction w with
  | nil => rfl
  | cons c w ih =>
    simp only [actPosA, actPos, ih, mulVecA_vecArr]

theorem foxVecA_vecArr (A B : Matrix (Fin 11) (Fin 11) (ZMod 2)) (w : List Bool)
    (x : Fin 11 → ZMod 2) :
    foxVecA A B w (vecArr x) = (vecArr (foxVec A B w x).1, vecArr (foxVec A B w x).2) := by
  induction w with
  | nil => rfl
  | cons c w ih =>
    cases c
    · simp only [foxVecA, ih, actPosA_vecArr, Bool.false_eq_true, ↓reduceIte, addA_vecArr,
        foxVec, Prod.fst_add, Prod.snd_add, zero_add]
      rw [add_comm]
    · simp only [foxVecA, ih, actPosA_vecArr, ↓reduceIte, addA_vecArr, foxVec, Prod.fst_add,
        Prod.snd_add, zero_add]
      rw [add_comm]

@[expose] def foxTable (A B : Matrix (Fin 11) (Fin 11) (ZMod 2)) :
    Array (Array (Array (ZMod 2))) :=
  Array.ofFn fun i : Fin 6 => Array.ofFn fun k : Fin 11 =>
    let p := foxVecA A B (wordsPos i) (vecArr (Pi.single k 1))
    Array.ofFn fun c : Fin (11 + 11) =>
      Fin.append (fun j : Fin 11 => p.1.getD j.val 0) (fun j : Fin 11 => p.2.getD j.val 0) c

@[expose] def foxTableC : Array (Array (Array (ZMod 2))) := foxTable Amat Bmat

@[expose] def foxMatC : Matrix (Fin 6 × Fin 11) (Fin (11 + 11)) (ZMod 2) :=
  fun r c => (((foxTableC[r.1.val]?.getD #[])[r.2.val]?.getD #[])[c.val]?.getD 0)

theorem foxMatC_apply (r : Fin 6 × Fin 11) (c : Fin (11 + 11)) :
    foxMatC r c = flat (foxVec Amat Bmat (wordsPos r.1) (Pi.single r.2 1)) c := by
  simp only [foxMatC, foxTableC, foxTable]
  simp only [Array.getElem?_ofFn, r.1.isLt, r.2.isLt, c.isLt, dite_true, Option.getD_some,
    foxVecA_vecArr, vecArr_getD]
  rfl

@[expose] def lamMat (x₀ : Fin 11 → ZMod 2) : Matrix (Fin 1) (Fin (11 + 11)) (ZMod 2) :=
  fun _ c => flat (x₀, 0) c

@[expose] def deltaMat (A B : Matrix (Fin 11) (Fin 11) (ZMod 2)) :
    Matrix (Fin (11 + 11)) (Fin 11) (ZMod 2) :=
  fun r c => Fin.append (fun j => (Aᵀ + 1) j c) (fun j => (Bᵀ + 1) j c) r

@[expose] def yMat : Matrix (Fin (11 + 11)) (Fin 6 × Fin 11) (ZMod 2) :=
  fun r c => if (foxYrows[r.val]?.getD 0).testBit (11 * c.1.val + c.2.val) then 1 else 0

@[expose] def zMat : Matrix (Fin (11 + 11)) (Fin 1) (ZMod 2) :=
  fun r _ => if foxZrows[r.val]?.getD 0 = 1 then 1 else 0

abbrev I2 : Type := Fin 11 × Fin 11

@[expose] def bigMat (rows : Array ℕ) : Matrix I2 I2 (ZMod 2) :=
  fun r c => if (rows[11 * r.1.val + r.2.val]?.getD 0).testBit (11 * c.1.val + c.2.val)
    then 1 else 0

@[expose] def Rsym : Matrix I2 I2 (ZMod 2) :=
  fun ij kl => (if ij = kl then 1 else 0) + (if kl = (ij.2, ij.1) then 1 else 0)

@[expose] def Rdiag : Matrix I2 I2 (ZMod 2) :=
  fun ij kl => if ij = kl ∧ ij.1 = ij.2 then 1 else 0

@[expose] def Rinv (M : Matrix (Fin 11) (Fin 11) (ZMod 2)) : Matrix I2 I2 (ZMod 2) :=
  fun ij kl => M kl.1 ij.1 * M kl.2 ij.2 + (if ij = kl then 1 else 0)

end CFSG.Sporadic.Co1.Cover
