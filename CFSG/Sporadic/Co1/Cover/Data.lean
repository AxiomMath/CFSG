@[expose] def initRowsCov : Array (Array ℕ) :=
  #[CFSG.Sporadic.Co1.Module.dat.rowsA, CFSG.Sporadic.Co1.Module.dat.rowsB]

@[expose] def regsRowsCov : Array (Array ℕ) := runRows initRowsCov covProg

@[expose] def rrCov (i : ℕ) : Array ℕ := regsRowsCov[i]?.getD (idRows 24)

noncomputable def regsCov :
    List NativeSporadic.Co1 := runEval [eA, eB] covProg

@[expose] noncomputable def regCov
    (i : ℕ) : NativeSporadic.Co1 := regsCov.getD i 1

section

attribute [local irreducible] covProg

theorem regs_relCov : RegsRel mat regsCov regsRowsCov := by
  have hinit : RegsRel mat [eA, eB] initRowsCov := by
    refine ⟨rfl, fun i => ?_⟩
    match i with
    | 0 => exact mat_eA
    | 1 => exact mat_eB
    | i + 2 => simp [rowsMatrix_idRows, initRowsCov]
  exact runRows_spec mat covProg (regsG := [eA, eB]) (regsR := initRowsCov) hinit

end

section

attribute [local irreducible] regsCov regsRowsCov

theorem mat_regCov
    (i : ℕ) : mat (regCov i) = rowsMatrix 24 (rrCov i) := by
  have h : ∀ j : ℕ, mat (regsCov.getD j 1) =
      rowsMatrix 24 (regsRowsCov[j]?.getD (idRows 24)) :=
    And.right regs_relCov
  simpa only [regCov, rrCov] using h i

end

attribute [local irreducible] rrCov regsRowsCov regsCov

@[expose] noncomputable def ga : NativeSporadic.Co1 := regCov 4

@[expose] noncomputable def gb : NativeSporadic.Co1 := regCov 5

@[expose] noncomputable def eps0
    (i : Fin 11) : NativeSporadic.Co1 := regCov (8 + i.val)

theorem ga_eq : ga = regCov 4 := rfl

theorem gb_eq : gb = regCov 5 := rfl

theorem eps0_eq (i : Fin 11) : eps0 i = regCov (8 + i.val) := rfl

@[expose] def epsRows : Array (Array ℕ) := (List.range 11).toArray.map fun i => rrCov (8 + i)

@[expose] def Aa : Array ℕ := #[130, 129, 144, 192, 132, 640, 136, 128, 1024, 160, 256]

@[expose] def Ba : Array ℕ := #[864, 192, 1793, 1346, 1792, 836, 64, 520, 1552, 1280, 1024]

@[expose] def Amat : Matrix (Fin 11) (Fin 11) (ZMod 2) := rowsMatrix 11 Aa

@[expose] def Bmat : Matrix (Fin 11) (Fin 11) (ZMod 2) := rowsMatrix 11 Ba

@[expose] def x0mask : ℕ := 722

@[expose] def t0Rows : Array ℕ := mulRows 24 (eprodRows epsRows x0mask) (rrCov 4)

