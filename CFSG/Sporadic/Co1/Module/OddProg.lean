@[expose] def initRows : Array (Array ℕ) := #[dat.rowsA, dat.rowsB]

@[expose] def regsRows : Array (Array ℕ) := runRows initRows prog

@[expose] def rr (i : ℕ) : Array ℕ := regsRows[i]?.getD (idRows 24)

noncomputable def eA :
    NativeSporadic.Co1 := Classical.choose exists_co1_matA

noncomputable def eB :
    NativeSporadic.Co1 := Classical.choose exists_co1_matB

theorem mat_eA :
    mat eA = matA := Classical.choose_spec exists_co1_matA

theorem mat_eB :
    mat eB = matB := Classical.choose_spec exists_co1_matB

noncomputable def regsG :
    List NativeSporadic.Co1 := runEval [eA, eB] prog

noncomputable def reg (i : ℕ) : NativeSporadic.Co1 := regsG.getD i 1

theorem regs_rel : RegsRel mat regsG regsRows := by
  refine runRows_spec mat prog ?_
  refine ⟨rfl, fun i => ?_⟩
  match i with
  | 0 => exact mat_eA
  | 1 => exact mat_eB
  | i + 2 => simp [rowsMatrix_idRows, initRows]

section

attribute [local irreducible] regsG regsRows

theorem mat_reg
    (i : ℕ) : mat (reg i) = rowsMatrix 24 (rr i) := by
  have h : ∀ j : ℕ, mat (regsG.getD j 1) =
      rowsMatrix 24 (regsRows[j]?.getD (idRows 24)) :=
    And.right regs_rel
  simpa only [reg, rr] using h i

end

