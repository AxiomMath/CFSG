@[expose] def nMat (k : Fin 2) : Matrix (Fin 5) (Fin 5) (ZMod 3) :=
  fun i j => (((nMats[k.val]!)[i.val]!)[j.val]! : ZMod 3)

@[expose] def triIdx (i j : Fin 5) : Fin 10 :=
  ⟨(i.val * (9 - i.val) / 2 + (j.val - i.val - 1)) % 10, Nat.mod_lt _ (Nat.succ_pos 9)⟩

@[expose] def altMat (c : Fin 10 → ZMod 3) : Matrix (Fin 5) (Fin 5) (ZMod 3) :=
  fun i j => if i < j then c (triIdx i j) else if j < i then -c (triIdx j i) else 0

