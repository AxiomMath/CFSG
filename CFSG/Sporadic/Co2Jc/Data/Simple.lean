@[expose] def ordD (l : Nat) : Nat := if l = 0 then 3 else 4

@[expose] def invD (w : List Nat) : List Nat :=
  w.reverse.flatMap fun l => List.replicate (ordD l - 1) l

@[expose] def commD (x y : List Nat) : List Nat := x ++ y ++ invD x ++ invD y

@[expose] def hExpand (w : List Nat) : List Nat :=
  w.flatMap fun l => if l = 0 then [1] else [0, 0]

