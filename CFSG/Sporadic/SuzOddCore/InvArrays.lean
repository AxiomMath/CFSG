@[expose] def invText (i : Nat) : String :=
  match i with
  | 0 => invCase0Text
  | 1 => invCase1Text
  | 2 => invCase2Text
  | _ => invCase3Text

def invRun (i k : Nat) : Array Nat := hexTable 3 1782 (1782 * k) (invText i)

def invFusionRun (k : Nat) : Array Nat := hexTable 3 1782 (1782 * k) invFusionText

@[expose] def invRepArr (i : Nat) : Array Nat := invRun i 0

@[expose] def invFullStart (_i : Nat) : Nat := 1

@[expose] def invInnerStart (i : Nat) : Nat :=
  1 + invFullGenCounts.getD i 0 + invFullStrongCounts.getD i 0

@[expose] def invOddStart (i : Nat) : Nat :=
  invInnerStart i + invInnerGenCounts.getD i 0 + invInnerStrongCounts.getD i 0

@[expose] def invFullGenArrs (i : Nat) : Array (Array Nat) :=
  Array.ofFn (n := invFullGenCounts.getD i 0) fun j => invRun i (1 + j.val)

@[expose] def invFullStrongArrs (i : Nat) : Array (Array Nat) :=
  Array.ofFn (n := invFullStrongCounts.getD i 0) fun j =>
    invRun i (1 + invFullGenCounts.getD i 0 + j.val)

@[expose] def invInnerGenArrs (i : Nat) : Array (Array Nat) :=
  Array.ofFn (n := invInnerGenCounts.getD i 0) fun j => invRun i (invInnerStart i + j.val)

@[expose] def invInnerStrongArrs (i : Nat) : Array (Array Nat) :=
  Array.ofFn (n := invInnerStrongCounts.getD i 0) fun j =>
    invRun i (invInnerStart i + invInnerGenCounts.getD i 0 + j.val)

@[expose] def invFullDerivs (i : Nat) : Array (List Int) :=
  (List.replicate (invFullGenCounts.getD i 0) [] ++ invFullDerivations.getD i []).toArray

@[expose] def invInnerDerivs (i : Nat) : Array (List Int) :=
  (List.replicate (invInnerGenCounts.getD i 0) [] ++ invInnerDerivations.getD i []).toArray

@[expose] def invOddRecordStart (i r : Nat) : Nat :=
  invOddStart i + (((invOddCoreShapes.getD i []).take r).map fun s => s.getD 2 0 + s.getD 3 0).sum

@[expose] def invOddGenArrs (i r : Nat) : Array (Array Nat) :=
  Array.ofFn (n := ((invOddCoreShapes.getD i []).getD r []).getD 2 0) fun j =>
    invRun i (invOddRecordStart i r + j.val)

@[expose] def invOddLineArrs (i r : Nat) : Array (Array Nat) :=
  Array.ofFn (n := ((invOddCoreShapes.getD i []).getD r []).getD 3 0) fun j =>
    invRun i (invOddRecordStart i r + ((invOddCoreShapes.getD i []).getD r []).getD 2 0 + j.val)

@[expose] def invRunCount (i : Nat) : Nat :=
  invOddStart i + ((invOddCoreShapes.getD i []).map fun s => s.getD 2 0 + s.getD 3 0).sum

@[expose] def invSylowArrs : Array (Array Nat) := Array.ofFn (n := 11) fun j => invFusionRun j.val

@[expose] def invFusionRepArr (r : Nat) : Array Nat := invFusionRun (11 + 2 * r)

@[expose] def invFusionConjArr (r : Nat) : Array Nat := invFusionRun (12 + 2 * r)

