@[expose] def glWAct (g r t : Nat) : Nat × Nat := (glWTab.getD g #[]).getD (4 * r + t) (0, 0)

@[expose] def glWeylOK : Bool :=
  (List.range 5).all fun g => (List.range 18).all fun r => (List.range 4).all fun t =>
    decide ((glWAct g r t).1 < 18) && decide ((glWAct g r t).2 < 4) &&
      glConj (glWGen.getD g #[]) (glRootRows r t) ==
        glRootRows (glWAct g r t).1 (glWAct g r t).2

@[expose] def glInChart (t k : Nat) : Bool :=
  if t < 12 then decide (0 ≤ glChartCoord t k) else (t - 12 == k || (t - 12) % 3 != k % 3)

@[expose] def glBlockChart (B : List Nat) : Nat :=
  ((List.range 6).find? fun k => B.all fun t => glInChart t k).getD 6

@[expose] def glChartsOK : Bool :=
  ((List.range 18).all fun r => (List.range 18).all fun s =>
    stOpp r s || decide (glBlockChart (stBlock r s) < 6)) &&
  [[3, 9], [5, 11], [14, 17]].all fun B => decide (glBlockChart B < 6)

@[expose] def glWeylChartOK : Bool := glWeylOK && glChartsOK

