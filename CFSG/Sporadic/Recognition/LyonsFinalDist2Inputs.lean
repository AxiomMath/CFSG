@[expose] def dist2RelatorStrings : List String :=
  ["kbkekbkebebe", "kbkbebkbkbeb", "kbkdeDcbckbkabacacecacabaeae", "kbkbabaeakbkebeabaeabebe",
    "kdkebcacbekDkbabaDbcebabaDebD", "kdkDceacaecdkDkcaDcDbedabDbDbe",
    "kdkabdbecabakDkbaeDcbcaebacaeb", "kdkabDeDeaebckDkebcdecbceadceab",
    "kDbkcbaDbecebdabckbdkedbabaedaDeababDe", "kDbkcbaDbedeDcbebdabckbdkaDebaceaDeDceabe",
    "kDbkcbaDbeadbDaebdabckbdkdeacbacbacebadaea"]

@[expose] def dist2Relators : List (List (Fin 6 × Bool)) := dist2RelatorStrings.map parseWord

@[expose] def dist2KRules : List (List (Fin 6 × Bool) × List (Fin 6 × Bool)) :=
  [(kkRel, []), ([], kkRel)]

@[expose] def dist2ERules : List (List (Fin 6 × Bool) × List (Fin 6 × Bool)) :=
  dist2EEvs.flatMap fun e =>
    [(kLetter :: (e.2.1 ++ [kLetter]), derivInv e.2.2),
     (kLetter :: (derivInv e.2.1 ++ [kLetter]), e.2.2)]

@[expose] def dist2TRules : List (List (Fin 6 × Bool) × List (Fin 6 × Bool)) :=
  [(kLetter :: (rhoS1 ++ [kLetter]), derivInv rhoS3 ++ kLetter :: derivInv rhoS2),
   ([kLetter], derivInv rhoS2 ++ kLetter :: (derivInv rhoS1 ++ kLetter :: derivInv rhoS3))]

@[expose] def ruleOK (rules : List (List (Fin 6 × Bool) × List (Fin 6 × Bool)))
    (old new : List (Fin 6 × Bool)) : Bool :=
  rules.any fun r => (r.1 == old && r.2 == new) || (r.1 == new && r.2 == old)

@[expose] def dist2StepOK (cells : List (List (Fin 6 × Bool))) (s : Dist2Step) : Bool :=
  match s.kind with
  | .B =>
    let w := parseWord s.old ++ derivInv (parseWord s.new)
    cells.any fun c => c == w
  | .K => ruleOK dist2KRules (parseWord s.old) (parseWord s.new)
  | .E => ruleOK dist2ERules (parseWord s.old) (parseWord s.new)
  | .T => ruleOK dist2TRules (parseWord s.old) (parseWord s.new)

@[expose] def replaceAt (cur : List (Fin 6 × Bool)) (pos : ℕ) (old new : List (Fin 6 × Bool)) :
    Option (List (Fin 6 × Bool)) :=
  if (cur.drop pos).take old.length = old then
    some (cur.take pos ++ new ++ cur.drop (pos + old.length))
  else none

@[expose] def dist2Replay (cells : List (List (Fin 6 × Bool))) :
    List (Fin 6 × Bool) → List Dist2Step → Bool
  | cur, [] => cur.isEmpty
  | cur, s :: ss =>
    dist2StepOK cells s &&
      match replaceAt cur s.pos (parseWord s.old) (parseWord s.new) with
      | some cur' => dist2Replay cells cur' ss
      | none => false

@[expose] def dist2DerivOK (cells : List (List (Fin 6 × Bool))) (d : Dist2Deriv) : Bool :=
  dist2Replay cells (parseWord d.start) d.steps

@[expose] def dist2BWords : List (List (Fin 6 × Bool)) :=
  ([(0 : Fin 6), 2, 3, 4].map (fun i => [(i, true), (i, true)]) ++
    dist2Derivs.flatMap fun d => d.steps.filterMap fun s =>
      match s.kind with
      | .B => some (parseWord s.old ++ derivInv (parseWord s.new))
      | _ => none).eraseDups

@[expose] def dist2Evidence : Bool := dist2EEvs.all eCheck && trCheck dist2TrEv

@[expose] def dist2BCheck : Bool := dist2BWords.all bWordCheck

@[expose] def dist2Replays : Bool :=
  (dist2Derivs.map fun d => parseWord d.start) == dist2Relators &&
    dist2Derivs.all (dist2DerivOK dist2BWords)

@[expose] def dist2Check : Bool := dist2Evidence && dist2BCheck && dist2Replays

