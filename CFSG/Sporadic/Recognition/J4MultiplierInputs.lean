abbrev j4A : Matrix (Fin 11) (Fin 11) (ZMod 2) := colsMatrix xColumns

abbrev j4B : Matrix (Fin 11) (Fin 11) (ZMod 2) := colsMatrix yColumns

@[expose] def j4FoxTable : Array (Array (Array (ZMod 2))) := foxTable j4A j4B

@[expose] def j4FoxMat : Matrix (Fin 6 × Fin 11) (Fin (11 + 11)) (ZMod 2) :=
  fun r c => (((j4FoxTable[r.1.val]?.getD #[])[r.2.val]?.getD #[])[c.val]?.getD 0)

theorem j4FoxMat_apply (r : Fin 6 × Fin 11) (c : Fin (11 + 11)) :
    j4FoxMat r c = flat (foxVec j4A j4B (wordsPos r.1) (Pi.single r.2 1)) c := by
  simp only [j4FoxMat, j4FoxTable, foxTable]
  simp only [Array.getElem?_ofFn, r.1.isLt, r.2.isLt, c.isLt, dite_true, Option.getD_some,
    foxVecA_vecArr, vecArr_getD]
  rfl

@[expose] def j4yMat : Matrix (Fin (11 + 11)) (Fin 6 × Fin 11) (ZMod 2) :=
  fun r c => if (j4FoxY[r.val]?.getD 0).testBit (11 * c.1.val + c.2.val) then 1 else 0

abbrev J4FoxCert : Prop :=
  deltaMat j4A j4B * listMat j4FoxX 11 (11 + 11) + j4yMat * j4FoxMat = 1

abbrev J4FormCert : Prop :=
  bigMat j4cSsym * Rsym + bigMat j4cSdiag * Rdiag + bigMat j4cSA * Rinv j4A +
    bigMat j4cSB * Rinv j4B = 1

theorem hl_cert_j4 : listMat j4lX1 11 11 * (j4Aᵀ - 1) + listMat j4lX2 11 11 * (j4Bᵀ - 1) = 1 := by
  decide +kernel

@[expose] def letterCols (l : ℤ) : Array ℕ :=
  if l = 1 then xColumns else if l = -1 then xInvColumns else if l = 2 then yColumns
  else if l = -2 then yInvColumns else idRows 11

@[expose] def wordCols : List ℤ → Array ℕ
  | [] => idRows 11
  | l :: w => comp11 (letterCols l) (wordCols w)

@[expose] def toZ (w : List (Fin 2 × Bool)) : List ℤ :=
  w.map fun l => if l.1 = 0 then (if l.2 then 1 else -1) else (if l.2 then 2 else -2)

abbrev sixW : List (List (Fin 2 × Bool)) :=
  CFSG.Monster.Schur.M24.U ++ (List.finRange 4).map CFSG.Monster.Schur.M24.T

theorem wordCols_sixW : sixW.all (fun w => wordCols (toZ w) == idRows 11) = true := by
  decide +kernel

theorem colsMatrix_xColumns_ne_one : colsMatrix xColumns ≠ 1 := by
  decide +kernel

end CFSG.Sporadic.Recognition.J4Multiplier
