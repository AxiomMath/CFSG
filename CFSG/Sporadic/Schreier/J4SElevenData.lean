@[expose] def max7Text : String := include_str "../../../Certificates/Data/CFSGNative/J4Schreier/max7-slp.txt"

@[expose] def max7Sha : ℕ :=
  0xce71b65dec7b02b2b52fdbf53fc7856efc12f1cce0777c3f0939c3f906659e53

@[expose] def slpTokens (s : String) : List String := (s.splitOn " ").filter fun t => !t.isEmpty

@[expose] def slpLine : List String → Option (Option Instr)
  | [] => some none
  | ["mu", i, j, k] => do return some (.mu (← i.toNat?) (← j.toNat?) (← k.toNat?))
  | ["iv", i, k] => do return some (.iv (← i.toNat?) (← k.toNat?))
  | ["pwr", e, i, k] => do return some (.pwr (← e.toNat?) (← i.toNat?) (← k.toNat?))
  | t :: _ => if t.startsWith "#" then some none else none

@[expose] def parseSLP (s : String) : Option (List Instr) :=
  ((s.splitOn "\n").mapM fun l => slpLine (slpTokens l)).map (List.filterMap id)

@[expose] def max7Prog : List Instr := (parseSLP max7Text).getD []

@[expose] def instrCode : Instr → List ℕ
  | .mu i j k => [0, i, j, k]
  | .iv i k => [1, i, k]
  | .pwr e i k => [2, e, i, k]

@[expose] def max7Regs : Array Pair := runProgN O (initRegsN O 7 An Bn) max7Prog

@[expose] def H1n : Pair := max7Regs[1]!

@[expose] def H2n : Pair := max7Regs[2]!

@[expose] def commP (P Q : Pair) : Pair := mulP (mulP (mulP P Q) (invP P)) (invP Q)

@[expose] def S5n : Pair := powP H2n 8

@[expose] def X0n : Pair := mulP (mulP (mulP S5n (invP H1n)) (invP S5n)) H1n

@[expose] def Y0n : Pair := commP S5n (mulP H1n H2n)

@[expose] def QXn : Pair := mulP X0n (powP Y0n 7)

@[expose] def QYn : Pair := powP Y0n 3

@[expose] def QZn : Pair := commP QXn QYn

@[expose] def C23n : Pair := powP (wordP Xn Yn [1, 2]) 10644480

@[expose] def U8n : Pair := powP H2n 5

@[expose] def W2n : Pair :=
  mulP (mulP (mulP (powP QXn 3) (powP QYn 9)) QZn) (wordP H1n H2n [1, 2, 1, 2, 2, 2, 2])

@[expose] def qWord (a b c : ℕ) : Pair := mulP (mulP (powP QXn a) (powP QYn b)) (powP QZn c)

@[expose] def dRows (k : ℕ) : Array ℕ :=
  Array.ofFn (n := 112) fun i => if i.val < k then 0 else 1 <<< i.val

@[noinline, expose] def fixDimOK (G P Pinv R : Array ℕ) (k : ℕ) : Bool :=
  let T := mulRows 112 P (xorRows112 G (idRows 112))
  mulRows 112 P Pinv == idRows 112 && mulRows 112 Pinv P == idRows 112 &&
    (List.range k).all (fun i => T[i]?.getD 0 == 0) && mulRows 112 T R == dRows k

@[noinline, expose] def expOK (X Y Z : Array ℕ) : Bool :=
  (List.range 1331).all fun t =>
    O.eq (O.pow (O.mul (O.mul (O.pow X (t % 11)) (O.pow Y (t / 11 % 11))) (O.pow Z (t / 121 % 11)))
      11) O.one

@[expose] def rowsDiffer (M N : Array ℕ) : Bool :=
  (List.range 112).any fun t => O.vne (O.vmul (O.unit t) M) (O.vmul (O.unit t) N)

@[noinline, expose] def centerOK (X Y : Array ℕ) : Bool :=
  (List.range 120).all fun t =>
    let A := O.mul (O.pow X ((t + 1) % 11)) (O.pow Y ((t + 1) / 11 % 11))
    rowsDiffer (O.mul A X) (O.mul X A) || rowsDiffer (O.mul A Y) (O.mul Y A)

@[noinline, expose] def sixteenOK (U W : Array ℕ) : Bool :=
  O.distinctOK (Array.ofFn (n := 16) fun t => O.appBase 8 [U, W] t.val (O.unit 0))

@[expose] def matA : Matrix (Fin 2) (Fin 2) (ZMod 11) := !![7, 3; 3, 3]

@[expose] def matB : Matrix (Fin 2) (Fin 2) (ZMod 11) := !![8, 10; 6, 5]

@[expose] def letterM (i : ℕ) : Matrix (Fin 2) (Fin 2) (ZMod 11) := if i = 0 then matA else matB

@[expose] def evalW (l : List ℕ) (v : Fin 2 → ZMod 11) : Fin 2 → ZMod 11 :=
  l.foldr (fun i acc => letterM i *ᵥ acc) v

@[expose] def vec11 (ab : ℕ × ℕ) : Fin 2 → ZMod 11 := ![(ab.1 : ZMod 11), (ab.2 : ZMod 11)]

