@[expose] def formUpRows : Array ℕ :=
  Array.ofFn (n := 112) fun i => ((formRows[i.val]?.getD 0) >>> (i.val + 1) <<< (i.val + 1)) |||
    2 ^ i.val

@[expose] def lowerRows (M : Array ℕ) : Array ℕ :=
  Array.ofFn (n := 112) fun i => (M[i.val]?.getD 0) % 2 ^ i.val

@[expose] def xorRows112 (X Y : Array ℕ) : Array ℕ :=
  Array.ofFn (n := 112) fun i => X[i.val]?.getD 0 ^^^ Y[i.val]?.getD 0

@[expose] def formDefect (G : Array ℕ) : Array ℕ :=
  xorRows112 (mulRows 112 (mulRows 112 G formUpRows) (transposeRows 112 G)) formUpRows

@[noinline, expose] def defectOK (G : Array ℕ) : Bool :=
  let D := formDefect G
  D == xorRows112 (lowerRows D) (transposeRows 112 (lowerRows D))

