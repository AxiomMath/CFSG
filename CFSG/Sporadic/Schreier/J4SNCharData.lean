@[expose] def quadAt (c c' v : ℕ) : Bool :=
  let x := app11 elementColumns[c']! v ^^^ v
  app11 elementColumns[c]! x ^^^ x == 0

@[noinline, expose] def quadSelf (e : ℕ) : Bool := (List.range 2048).all fun v => quadAt e e v

@[noinline, expose] def classForestOK (L : List (ℕ × ℕ × ℕ)) : Bool :=
  !L.isEmpty && (List.range L.length).all fun k =>
    (L[k]!).1 < 1024 && (k == 0 || ((L[k]!).2.1 < k && (L[k]!).2.2 < 4 &&
      (L[k]!).1 == (conjTab[(L[k]!).2.2]!)[(L[(L[k]!).2.1]!).1]!))

@[noinline, expose] def classWitOK (L : List (ℕ × ℕ × ℕ)) : Option (ℕ × ℕ × ℕ) → Bool
  | some (a, b, v) => a < L.length && b < L.length && v < 2048 &&
      !quadAt (L[a]!).1 (L[b]!).1 v
  | none => L.all fun x => x.1 == 118 || x.1 == 448 || x.1 == 502

