@[expose] def suzArr (k : ℕ) : Array ℕ := hexTable 3 1782 (1782 * k) suzHex

@[expose] def sH (_ : Unit := ()) : Array ℕ := suzArr 0

@[expose] def sD (_ : Unit := ()) : Array ℕ := suzArr 1

@[expose] def sB2 (_ : Unit := ()) : Array ℕ := suzArr 2

@[expose] def sB3 (_ : Unit := ()) : Array ℕ := suzArr 3

@[expose] def sM (_ : Unit := ()) : Array ℕ := suzArr 4

@[expose] def sTau (_ : Unit := ()) : Array ℕ := compA 1782 vArr (sM ())

@[expose] def conj1782 (g gi t : Array ℕ) : Array ℕ := compA 1782 g (compA 1782 t gi)

@[expose] def comm1782 (t u : Array ℕ) : Bool := eqA 1782 (compA 1782 t u) (compA 1782 u t)

@[expose] def qIdx (c ci : Array ℕ) (i : ℕ) : ℕ :=
  ((List.range 128).find? fun j => eqA 1782 (conj1782 c ci (qArr i)) qElts[j]!).getD 128

@[expose] def coordsOK (c : Array ℕ) : Bool :=
  let ci := invCand 1782 c
  allBelow 6 fun i => decide (qIdx c ci i < 128)

@[expose] def mat64 (c : Array ℕ) : Array ℕ :=
  let ci := invCand 1782 c
  let w := (Array.range 6).map fun i => qIdx c ci i / 2
  Array.ofFn (n := 64) fun v =>
    (List.range 6).foldl (fun r i => if v.val.testBit i then r ^^^ w[i]! else r) 0

@[expose] def comm64 (t u : Array ℕ) : Bool := comp 64 t u == comp 64 u t

@[expose] def invTest (HL : Array (Array ℕ)) (g : Array ℕ) : Bool :=
  !(comp 64 g g == idTab 64) || g == idTab 64 ||
    anyBelow HL.size fun k =>
      !(comm64 g (comp 64 HL[k]! (comp 64 g (comp 64 HL[k]! HL[k]!))))

@[expose] def pow12 (g : Array ℕ) : Array ℕ :=
  let g2 := comp 64 g g
  let g4 := comp 64 g2 g2
  comp 64 g4 (comp 64 g4 g4)

@[expose] def suzCheck (_ : Unit := ()) : Bool :=
  let H := sH (); let Hi := invCand 1782 H; let D := sD (); let B2 := sB2 (); let B3 := sB3 ()
  let Mm := sM (); let Tau := sTau (); let T1 := tTab; let XA := xAArr (levels ())
  let I := idA 1782; let L := levels ()
  let md := mat64 D; let mb2 := mat64 B2; let mb3 := mat64 B3; let mt := mat64 Tau
  let gens := matTabs.push mt
  let O := enumBFS 64 gens 51840
  let HL : Array (Array ℕ) := #[comp 64 md (comp 64 mb2 (comp 64 mb3 mb3)),
    comp 64 mb2 (comp 64 mb2 (comp 64 mb3 mb3))]
  let Om := matEnum
  validA 1782 H && inP L H && validA 1782 D && validA 1782 B2 && validA 1782 B3 &&
    validA 1782 Mm && inP L Mm && inP L B2 && inP L B3 && validA 1782 XA &&
    eqA 1782 D (conj1782 H Hi XA) &&
    comm1782 T1 D && comm1782 T1 B2 && comm1782 T1 B3 && comm1782 T1 Tau &&
    comm1782 D B2 && comm1782 D B3 && comm1782 B2 B3 &&
    eqA 1782 (powArr 1782 D 3) I && eqA 1782 (powArr 1782 B2 3) I &&
    eqA 1782 (powArr 1782 B3 3) I &&
    allBelow 27 (fun t => t == 0 || !(eqA 1782 (compA 1782 (powArr 1782 D (t % 3))
      (compA 1782 (powArr 1782 B2 (t / 3 % 3)) (powArr 1782 B3 (t / 9)))) I)) &&
    coordsOK D && coordsOK B2 && coordsOK B3 && coordsOK Tau &&
    validA 64 md && validA 64 mb2 && validA 64 mb3 && validA 64 mt &&
    allBelow HL.size (fun k => comp 64 HL[k]! (comp 64 HL[k]! HL[k]!) == idTab 64) &&
    enumOK 64 gens O && O.tabs.size == 51840 &&
    allBelow O.tabs.size (fun k => invTest HL O.tabs[k]!) &&
    !(Om.tabs.any (· == mt)) &&
    allBelow Om.tabs.size (fun k => !(comm64 Om.tabs[k]! md) || pow12 Om.tabs[k]! == idTab 64) &&
    allBelow 128 (fun j => comm1782 D qElts[j]! == (md[j / 2]! == j / 2)) &&
    allBelow 64 (fun v => v == 0 || md[v]! != v ||
      anyBelow 64 fun w => md[w]! == w && (gammaBit v w + gammaBit w v) % 2 == 1) &&
    countBelow 64 (fun v => md[v]! == v) == 16

end CFSG.Sporadic.SuzI301
