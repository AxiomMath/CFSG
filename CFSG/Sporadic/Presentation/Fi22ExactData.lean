@[expose] def xdefs : List (ℕ × Fin 6 × List (Fin 6)) :=
  [(6, 2, [3, 1, 0, 4, 3, 2, 5]),
   (7, 2, [3, 1, 4, 5, 0, 3, 4, 2, 1]),
   (8, 1, [2, 3, 0, 4, 5, 3, 2]),
   (9, 0, [1, 2, 4, 3, 2, 1, 3, 4]),
   (10, 1, [2, 3, 5, 4, 3, 2, 4, 5]),
   (11, 0, [1, 2, 3, 4, 3, 5, 4, 1]),
   (12, 1, [4, 5, 2, 3, 0, 2, 1, 0])]

theorem xdefs_fst : ∀ j : Fin 7, (xdefs.getD j.val (0, 0, [])).1 = j.val + 6 := by decide

theorem xdefs_getD_mem : ∀ j : Fin 7, xdefs.getD j.val (0, 0, []) ∈ xdefs := by decide

theorem xdefs_exists : ∀ j : Fin 7, ∃ d ∈ xdefs, d.1 = j.val + 6 := by decide

@[expose] def conjW (i : Fin 6) (c : List (Fin 6)) : List (Fin 6 × Bool) :=
  (c.reverse.map fun l => (l, false)) ++ [(i, true)] ++ (c.map fun l => (l, true))

@[expose] def qWord (q : Fin 6 × List (Fin 6) × Fin 6 × List (Fin 6)) : List (Fin 6 × Bool) :=
  conjW q.1 q.2.1 ++ FreeGroup.invRev (conjW q.2.2.1 q.2.2.2)

@[expose] def wsF : List (List (Fin 6 × Bool)) :=
  ((List.finRange 6).map fun i => [(i, true), (i, true)]) ++ qrels.map qWord

@[expose] def xW (k : ℕ) : List ℕ := List.replicate k 3 ++ 0 :: List.replicate k 2

abbrev Conj : Type := ℕ × List (Fin 6)

@[expose] def gW (n : ℕ) (c : List (Fin 6)) : List ℕ :=
  List.replicate n 2 ++ c.flatMap fun l => xW l.val

@[expose] def pairWord (pp : Conj × Conj) : List ℕ :=
  gW pp.1.1 pp.1.2 ++ invC (gW pp.2.1 pp.2.2)

@[expose] def qPair (q : Fin 6 × List (Fin 6) × Fin 6 × List (Fin 6)) : Conj × Conj :=
  ((q.1.val, q.2.1), (q.2.2.1.val, q.2.2.2))

@[expose] def xPair (d : ℕ × Fin 6 × List (Fin 6)) : Conj × Conj :=
  ((d.1, []), (d.2.1.val, d.2.2))

@[expose] def allPairs : List (Conj × Conj) := qrels.map qPair ++ xdefs.map xPair

@[expose] def xhat (k : ℕ) : List (Fin 6 × Bool) :=
  if h : k < 6 then [(⟨k, h⟩, true)] else
    conjW (xdefs.getD (k - 6) (0, 0, [])).2.1 (xdefs.getD (k - 6) (0, 0, [])).2.2

@[expose] def Qw : List (Fin 6 × Bool) := ([12, 11, 10, 9, 8, 7, 6, 5, 4, 3].map xhat).flatten

@[expose] def Pw : List (Fin 6 × Bool) := xhat 0 ++ Qw

@[expose] def g1w : List (Fin 6 × Bool) := (List.replicate 91 Pw).flatten

@[expose] def g2w : List (Fin 6 × Bool) := (List.replicate 21 Qw).flatten

abbrev R5 := restrictWords (subsetOf _ [0, 1, 2, 3, 4]) wsF
abbrev R4 := restrictWords (subsetOf _ [0, 1, 2, 3]) R5
abbrev R3 := restrictWords (subsetOf _ [0, 1, 2]) R4
abbrev R2 := restrictWords (subsetOf _ [0, 1]) R3
abbrev R1 := restrictWords (subsetOf _ [0]) R2

