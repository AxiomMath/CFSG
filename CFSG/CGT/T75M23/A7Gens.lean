theorem a7Words_length : a7Words.length = 2520 := by decide +kernel

@[expose] def permKey7 (σ : Perm (Fin 7)) : List ℕ := (List.finRange 7).map fun i => (σ i).val

@[expose] def A7Nodup : Prop := (a7Words.map fun w => permKey7 (evalG a7x a7y w)).Nodup

instance : Decidable A7Nodup :=
  inferInstanceAs (Decidable ((a7Words.map fun w => permKey7 (evalG a7x a7y w)).Nodup))

theorem A7Nodup.values (hn : A7Nodup) : (a7Words.map (evalG a7x a7y)).Nodup := by
  have h' : (a7Words.map fun w => permKey7 (evalG a7x a7y w)).Nodup := hn
  exact List.Nodup.of_map permKey7 (by simpa [List.map_map, Function.comp_def] using h')

theorem a7_closure (hn : A7Nodup) :
    Subgroup.closure ({a7x, a7y} : Set (Perm (Fin 7))) = alternatingGroup (Fin 7) := by
  set H := Subgroup.closure ({a7x, a7y} : Set (Perm (Fin 7))) with hH
  have hle : H ≤ alternatingGroup (Fin 7) := by
    rw [hH, Subgroup.closure_le]
    rintro g (rfl | rfl)
    · exact a7x_mem
    · exact a7y_mem
  refine Subgroup.eq_of_le_of_card_ge hle ?_
  have hcardA : Nat.card (alternatingGroup (Fin 7)) = 2520 := by
    rw [Nat.card_eq_fintype_card, card_alternatingGroup]
    simp [Fintype.card_fin, Nat.factorial]
  rw [hcardA]
  classical
  have hmem : ∀ σ ∈ a7Words.map (evalG a7x a7y), σ ∈ H := by
    intro σ hσ
    obtain ⟨w, -, rfl⟩ := List.mem_map.1 hσ
    exact evalG_mem_closure H (Subgroup.subset_closure (by simp))
      (Subgroup.subset_closure (by simp)) w
  have h1 : (a7Words.map (evalG a7x a7y)).toFinset.card = 2520 := by
    rw [List.toFinset_card_of_nodup hn.values, List.length_map, a7Words_length]
  have h2 : (a7Words.map (evalG a7x a7y)).toFinset ⊆ (Finset.univ.filter (· ∈ H)) := by
    intro σ hσ
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact hmem σ (List.mem_toFinset.1 hσ)
  calc 2520 = (a7Words.map (evalG a7x a7y)).toFinset.card := h1.symm
    _ ≤ (Finset.univ.filter (· ∈ H)).card := Finset.card_le_card h2
    _ = Nat.card H := by
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype]

