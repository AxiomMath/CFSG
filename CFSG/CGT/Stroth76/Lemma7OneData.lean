@[expose] def sig2 (p : Tc) : Tc :=
  subst ((1, 0, 0), 0) ((0, 3, 0), 0) ((0, 0, 3), 0) ((0, 1, 1), (1, 0, 0)) ((0, 3, 0), (0, 1, 0))
    (0, (0, 0, 1)) p

@[expose] def sm2 (a b : Sc) : Sc := smulC sig2 (0, 0) a b

@[expose] def conjChk (a b c : Sc) : Bool := sm2 b a == sm2 a c

@[expose] def checkTab (tab : List (Sc × Sc × Sc)) (targets : List Sc) : Bool :=
  tab.all fun e => conjChk e.2.1 e.1 e.2.2 && targets.contains e.2.2

