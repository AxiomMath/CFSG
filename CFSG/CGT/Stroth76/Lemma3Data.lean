@[expose] def isInv8 (p : Sc8) : Bool := smul8 p p == one8 && p != one8

theorem z8_central : ∀ p : Sc8, smul8 p z8 = smul8 z8 p := by decide +kernel

theorem uv_conj_xyuv8 : smul8 uv8 g0_8 = smul8 g0_8 xyuv8 := by decide

theorem r0_facts : smul8 r0_8 r0_8 = one8 ∧ smul8 r0_8 wu8 = smul8 wu8 r0_8 ∧
    smul8 r0_8 wu8 = q0_8 ∧ smul8 q0_8 ta8 = smul8 ta8 u8 ∧ r0_8 ≠ wu8 ∧ r0_8 ≠ one8 := by
  decide

theorem ainvb8_comm : ainvb8 = smul8 (smul8 (sinv8 ((0, 1, 0), (0, 0, 0))) (sinv8 u8))
    (smul8 ((0, 1, 0), (0, 0, 0)) u8) := by decide

