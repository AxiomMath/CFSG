@[expose] def tabZ8Check : Bool :=
  tabZ8.all fun e => smul8 e.1 e.2 == smul8 e.2 (smul8 e.1 z8)

theorem tabZ8Check_eq : tabZ8Check = true := by decide +kernel

theorem tabZ8_complete : ∀ r : Sc8,
    (!isInv8 r || r == z8 || tabZ8.any (·.1 == r)) = true := by
  decide +kernel

