theorem F8_closed : (F8.all fun p => F8.all fun q => F8.contains (smul8 p q)) = true := by
  decide +kernel
theorem F8_inv : (F8.all fun p => smul8 p p == one8) = true := by decide +kernel
theorem F8_comm : (F8.all fun p => F8.all fun q => smul8 p q == smul8 q p) = true := by
  decide +kernel
theorem r0_mem_F8 : r0_8 ∈ F8 := by decide
theorem one8_mem_F8 : one8 ∈ F8 := by decide

theorem cent_w8 : ∀ p : Sc8, smul8 p w8 = smul8 w8 p → p.2 = 0 ∨ p.2 = (0, 0, 1) := by
  decide +kernel

theorem cent_a4_8 : ∀ v : Cc8, smul8 (v, (0, 0, 1)) a4_8 ≠ smul8 a4_8 (v, (0, 0, 1)) := by
  decide +kernel

theorem cent_comm8 : ∀ v : Cc8, smul8 (v, (0, 0, 1)) ainvb8 ≠ smul8 ainvb8 (v, (0, 0, 1)) := by
  decide +kernel

theorem omega2_C8 : ∀ v : Cc8, 4 • v = 0 → v.2.1.val % 2 = 0 ∧ v.2.2.val % 2 = 0 := by
  decide +kernel

