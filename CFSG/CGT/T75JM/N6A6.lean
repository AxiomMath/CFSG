theorem a6Words_length : a6Words.length = 360 := by decide +kernel

@[expose] def A6Nodup : Prop := (a6Words.map (evalG a6x a6y)).Nodup

instance : Decidable A6Nodup := by unfold A6Nodup; infer_instance

@[expose] def a6NodupCheck : Bool := decide A6Nodup

theorem a6Nodup_of_check (h : a6NodupCheck = true) : A6Nodup := by
  unfold a6NodupCheck at h
  exact of_decide_eq_true h

theorem evalG_mem_closure {H : Type*} [Group H] (S : Subgroup H) {g h : H} (hg : g ∈ S) (hh : h ∈ S)
    (w : List ℕ) : evalG g h w ∈ S := by
  induction w with
  | nil => exact S.one_mem
  | cons l w ih =>
    simp only [evalG]
    refine S.mul_mem ?_ ih
    split
    · exact hg
    · exact hh

theorem a6_closure (hn : A6Nodup) :
    Subgroup.closure ({a6x, a6y} : Set (Perm (Fin 6))) = alternatingGroup (Fin 6) := by
  set H := Subgroup.closure ({a6x, a6y} : Set (Perm (Fin 6))) with hH
  have hle : H ≤ alternatingGroup (Fin 6) := by
    rw [hH, Subgroup.closure_le]
    rintro g (rfl | rfl)
    · exact a6x_mem
    · exact a6y_mem
  refine Subgroup.eq_of_le_of_card_ge hle ?_
  have hcardA : Nat.card (alternatingGroup (Fin 6)) = 360 := by
    rw [Nat.card_eq_fintype_card, card_alternatingGroup]
    simp [Fintype.card_fin, Nat.factorial]
  rw [hcardA]
  classical
  have hmem : ∀ σ ∈ a6Words.map (evalG a6x a6y), σ ∈ H := by
    intro σ hσ
    obtain ⟨w, -, rfl⟩ := List.mem_map.1 hσ
    exact evalG_mem_closure H (Subgroup.subset_closure (by simp))
      (Subgroup.subset_closure (by simp)) w
  have h1 : (a6Words.map (evalG a6x a6y)).toFinset.card = 360 := by
    rw [List.toFinset_card_of_nodup hn, List.length_map, a6Words_length]
  have h2 : (a6Words.map (evalG a6x a6y)).toFinset ⊆ (Finset.univ.filter (· ∈ H)) := by
    intro σ hσ
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact hmem σ (List.mem_toFinset.1 hσ)
  calc 360 = (a6Words.map (evalG a6x a6y)).toFinset.card := h1.symm
    _ ≤ (Finset.univ.filter (· ∈ H)).card := Finset.card_le_card h2
    _ = Nat.card H := by
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype]

