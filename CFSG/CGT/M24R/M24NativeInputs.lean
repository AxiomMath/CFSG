@[expose] def surjAWord : M24Word :=
  [(7, true), (0, false), (1, true), (3, false), (2, true), (4, false), (5, true), (10, true),
   (2, true), (5, true), (1, true), (7, true), (10, true)]

@[expose] def surjBWord : M24Word :=
  [(6, false), (5, false), (3, false), (10, false), (5, false), (3, false), (4, false), (1, false),
   (0, false), (2, false), (8, false), (6, false)]

@[expose] def letterZ (l : Fin 11 × Bool) : ℤ :=
  if l.2 then (l.1.val : ℤ) + 1 else -((l.1.val : ℤ) + 1)

@[expose] def m24AB (z : ℤ) : Table :=
  if z = 1 then m24Data.tA else if z = 2 then m24Data.tB else idT 24

@[expose] def m24Img (k : ℕ) : Table := wordT 24 m24AB (m24GenWord k)

@[expose] def m24L (z : ℤ) : Table :=
  if 0 < z then m24Img (z - 1).toNat else invT 24 (m24Img (-z - 1).toNat)

@[expose] def m24TabCheck : Bool :=
  (List.range 11).all (fun k => m24Img k == genTable k &&
    invOK 24 (m24Img k) (invT 24 (m24Img k))) &&
  m24Rels.all (fun r => wordT 24 m24L (r.map letterZ) == idT 24) &&
  wordT 24 m24L (surjAWord.map letterZ) == m24Data.tA &&
  wordT 24 m24L (surjBWord.map letterZ) == m24Data.tB

end CFSG.CGT.M24R
