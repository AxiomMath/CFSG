@[expose] def entryOk (e : ℕ × ℕ × ℕ × ℕ) : Bool :=
  decide (e.2.2.2 < 3) &&
    all16 (fun i j => ent e.2.1 e.2.2.1 i j == if i = j then 1 else 0) &&
    all16 (fun i j => ent e.2.1 e.1 i j == ent (repCode e.2.2.2) e.2.1 i j)

theorem conjTable_ok : conjTable.all entryOk = true := by
  decide +kernel

@[expose] def ucodeN (n : ℕ) : ℕ :=
  ucode (n / 243 % 3) (n / 81 % 3) (n / 27 % 3) (n / 9 % 3) (n / 3 % 3) (n % 3)

@[expose] def validN (n : ℕ) : Bool :=
  n != 0 && (n / 243 % 3) * (n / 9 % 3) * (n % 3) % 3 == 0

theorem conjTable_cover :
    ∀ n < 729, validN n = true → conjTable.any (fun e => e.1 == ucodeN n) = true := by
  decide +kernel

theorem exists_conj_repM (a b c d e f : ZMod 3) (hadf : a * d * f = 0)
    (h1 : uMat a b c d e f ≠ 1) :
    ∃ (B B' : M43) (i : ℕ), i < 3 ∧ B * B' = 1 ∧ B * uMat a b c d e f = repM i * B := by
  have ha := ZMod.val_lt a
  have hb := ZMod.val_lt b
  have hc := ZMod.val_lt c
  have hd := ZMod.val_lt d
  have he := ZMod.val_lt e
  have hf := ZMod.val_lt f
  set n := a.val * 243 + b.val * 81 + c.val * 27 + d.val * 9 + e.val * 3 + f.val with hn
  have hn729 : n < 729 := by omega
  have hd1 : n / 243 % 3 = a.val := by omega
  have hd2 : n / 81 % 3 = b.val := by omega
  have hd3 : n / 27 % 3 = c.val := by omega
  have hd4 : n / 9 % 3 = d.val := by omega
  have hd5 : n / 3 % 3 = e.val := by omega
  have hd6 : n % 3 = f.val := by omega
  have hvalid : validN n = true := by
    have hne : n ≠ 0 := by
      intro h0
      apply h1
      have h0a : a.val = 0 := by omega
      have h0b : b.val = 0 := by omega
      have h0c : c.val = 0 := by omega
      have h0d : d.val = 0 := by omega
      have h0e : e.val = 0 := by omega
      have h0f : f.val = 0 := by omega
      rw [ZMod.val_eq_zero] at h0a h0b h0c h0d h0e h0f
      subst h0a h0b h0c h0d h0e h0f
      decide
    have hprod : a.val * d.val * f.val % 3 = 0 := by
      have := congrArg ZMod.val hadf
      rwa [ZMod.val_mul, ZMod.val_mul, ZMod.val_zero, Nat.mul_mod, Nat.mod_mod_of_dvd _
        (dvd_refl 3), ← Nat.mul_mod] at this
    simp only [validN, Bool.and_eq_true, bne_iff_ne, ne_eq, beq_iff_eq]
    refine ⟨hne, ?_⟩
    rw [hd1, hd4, hd6]
    exact hprod
  obtain ⟨E, hE, hEeq⟩ := List.any_eq_true.1 (conjTable_cover n hn729 hvalid)
  have hok := List.all_eq_true.1 conjTable_ok E hE
  simp only [entryOk, Bool.and_eq_true, decide_eq_true_eq] at hok
  obtain ⟨⟨hi, hinv⟩, hconj⟩ := hok
  have hu : E.1 = ucode a.val b.val c.val d.val e.val f.val := by
    rw [beq_iff_eq.1 hEeq, ucodeN, hd1, hd2, hd3, hd4, hd5, hd6]
  refine ⟨decM E.2.1, decM E.2.2.1, E.2.2.2, hi, decM_mul_eq_one hinv, ?_⟩
  rw [← decM_ucode, ← hu, repM]
  exact decM_mul_eq_decM_mul hconj

@[expose] def wA2 (i : ℕ) : M43 :=
  if i = 0 then !![2, 0, 2, 1; 0, 0, 2, 0; 1, 2, 0, 2; 0, 0, 0, 1]
  else if i = 1 then !![1, 2, 1, 2; 1, 2, 0, 2; 0, 0, 2, 1; 0, 2, 2, 0]
  else !![0, 1, 0, 0; 1, 2, 0, 0; 2, 1, 1, 2; 0, 0, 1, 1]

@[expose] def wA2' (i : ℕ) : M43 :=
  if i = 0 then !![2, 1, 0, 1; 2, 1, 2, 0; 0, 2, 0, 0; 0, 0, 0, 1]
  else if i = 1 then !![0, 1, 1, 2; 2, 1, 0, 2; 1, 2, 0, 0; 1, 2, 1, 0]
  else !![1, 1, 0, 0; 1, 0, 0, 0; 0, 2, 2, 2; 0, 1, 1, 2]

@[expose] def wA3 (i : ℕ) : M43 :=
  if i = 0 then !![2, 0, 0, 0; 2, 0, 1, 1; 0, 2, 0, 2; 1, 2, 2, 0]
  else if i = 1 then !![2, 1, 2, 0; 2, 1, 2, 1; 0, 1, 0, 2; 2, 2, 1, 2]
  else !![2, 0, 1, 1; 1, 1, 2, 1; 1, 0, 0, 0; 0, 1, 0, 1]

@[expose] def wA3' (i : ℕ) : M43 :=
  if i = 0 then !![2, 0, 0, 0; 0, 1, 1, 1; 2, 2, 2, 1; 0, 2, 1, 2]
  else if i = 1 then !![0, 1, 0, 1; 2, 1, 1, 0; 1, 0, 1, 2; 2, 1, 0, 0]
  else !![0, 0, 1, 0; 2, 2, 0, 2; 0, 2, 1, 1; 1, 1, 0, 2]

@[expose] def wS (i : ℕ) : ZMod 3 :=
  if i = 0 then 1
  else if i = 1 then 2
  else 1

@[expose] def wH (i : ℕ) : M43 :=
  repM i * (wA2 i * repM i * wA2' i) * (wA3 i * repM i * wA3' i)

theorem det_wA2 (i : ℕ) (hi : i < 3) : (wA2 i).det = 1 := by
  interval_cases i <;> decide +kernel

theorem det_wA3 (i : ℕ) (hi : i < 3) : (wA3 i).det = 1 := by
  interval_cases i <;> decide +kernel

theorem wA2_mul (i : ℕ) (hi : i < 3) : wA2 i * wA2' i = 1 := by
  interval_cases i <;> decide +kernel

theorem wA3_mul (i : ℕ) (hi : i < 3) : wA3 i * wA3' i = 1 := by
  interval_cases i <;> decide +kernel

theorem wH_pow (i : ℕ) (hi : i < 3) : wH i ^ 13 = Matrix.scalar (Fin 4) (wS i) := by
  interval_cases i <;> decide +kernel

theorem wS_pow (i : ℕ) (hi : i < 3) : wS i ^ 4 = 1 := by
  interval_cases i <;> decide +kernel

theorem wH_ne_scalar (i : ℕ) (hi : i < 3) (s : ZMod 3) : wH i ≠ Matrix.scalar (Fin 4) s := by
  interval_cases i <;> revert s <;> decide +kernel

