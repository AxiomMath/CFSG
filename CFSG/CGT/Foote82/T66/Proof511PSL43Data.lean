module

public import Mathlib.Algebra.Field.ZMod
public import Mathlib.Data.Nat.Totient
public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import Mathlib.Tactic.IntervalCases

public section

namespace CFSG.CGT.Foote82.Proof511

open Matrix

abbrev M43 : Type := Matrix (Fin 4) (Fin 4) (ZMod 3)

@[expose] def dg (n k : ℕ) : ℕ := n / 3 ^ k % 3

@[expose] def decM (n : ℕ) : M43 :=
  Matrix.of fun i j => ((dg n (4 * (i : ℕ) + (j : ℕ)) : ℕ) : ZMod 3)

@[expose] def ent (m n i j : ℕ) : ℕ :=
  (dg m (4 * i) * dg n j + dg m (4 * i + 1) * dg n (4 + j) + dg m (4 * i + 2) * dg n (8 + j) +
    dg m (4 * i + 3) * dg n (12 + j)) % 3

theorem decM_mul_apply (m n : ℕ) (i j : Fin 4) :
    (decM m * decM n) i j = ((ent m n i j : ℕ) : ZMod 3) := by
  rw [Matrix.mul_apply, Fin.sum_univ_four, ent, ZMod.natCast_mod]
  fin_cases i <;> fin_cases j <;> simp [decM]

@[expose] def all16 (p : ℕ → ℕ → Bool) : Bool :=
  (List.range 4).all fun i => (List.range 4).all fun j => p i j

theorem all16_spec {p : ℕ → ℕ → Bool} (h : all16 p = true) (i j : Fin 4) : p i j = true := by
  simp only [all16, List.all_eq_true, List.mem_range] at h
  exact h i i.isLt j j.isLt

theorem decM_mul_eq_one {m n : ℕ}
    (h : all16 (fun i j => ent m n i j == if i = j then 1 else 0) = true) :
    decM m * decM n = 1 := by
  ext i j
  have hij := all16_spec h i j
  rw [decM_mul_apply]
  simp only [beq_iff_eq] at hij
  rw [hij, Matrix.one_apply]
  by_cases hh : i = j
  · subst hh
    simp
  · have : (i : ℕ) ≠ (j : ℕ) := fun e => hh (Fin.ext e)
    simp [hh, this]

theorem decM_mul_eq_decM_mul {a b c d : ℕ}
    (h : all16 (fun i j => ent a b i j == ent c d i j) = true) :
    decM a * decM b = decM c * decM d := by
  ext i j
  have hij := all16_spec h i j
  simp only [beq_iff_eq] at hij
  rw [decM_mul_apply, decM_mul_apply, hij]

@[expose] def uMat (a b c d e f : ZMod 3) : M43 :=
  !![1, a, b, c; 0, 1, d, e; 0, 0, 1, f; 0, 0, 0, 1]

@[expose] def ucode (a b c d e f : ℕ) : ℕ :=
  1 + a * 3 + b * 9 + c * 27 + 243 + d * 729 + e * 2187 + 59049 + f * 177147 + 14348907

theorem dg_ucode {a b c d e f : ℕ} (ha : a < 3) (hb : b < 3) (hc : c < 3) (hd : d < 3)
    (he : e < 3) (hf : f < 3) (k : ℕ) (hk : k < 16) :
    dg (ucode a b c d e f) k = [1, a, b, c, 0, 1, d, e, 0, 0, 1, f, 0, 0, 0, 1].getD k 0 := by
  interval_cases k <;> simp only [dg, ucode, List.getD_cons_zero, List.getD_cons_succ] <;> omega

theorem decM_ucode (a b c d e f : ZMod 3) :
    decM (ucode a.val b.val c.val d.val e.val f.val) = uMat a b c d e f := by
  have ha := ZMod.val_lt a
  have hb := ZMod.val_lt b
  have hc := ZMod.val_lt c
  have hd := ZMod.val_lt d
  have he := ZMod.val_lt e
  have hf := ZMod.val_lt f
  ext i j
  simp only [decM, Matrix.of_apply]
  rw [dg_ucode ha hb hc hd he hf _ (by omega)]
  fin_cases i <;> fin_cases j <;> simp [uMat]

@[expose] def repCode (i : ℕ) : ℕ :=
  if i = 0 then ucode 1 0 0 0 0 0 else if i = 1 then ucode 1 0 0 0 0 1 else ucode 1 0 0 1 0 0

@[expose] def repM (i : ℕ) : M43 := decM (repCode i)

