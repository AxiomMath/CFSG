theorem tightS26DichR_of_four_le {r n : ℕ} (hr : 4 ≤ r) (_hNo : NoQ16E4)
    (hG : GH74SectionalModels) (h6 : ∀ m, TightLargeEdgeSR r m) (h4 : Thm4RBelow r n)
    (hA : CIT3Below n) (hB : TightBelowR r n) : TightS26DichR r n := by
  classical
  intro X _ _ hn Φ hΦ hO hgen hAE hEdge hTop ⟨W', hW', hμ⟩ A hAΦ u huA m hm hou ⟨P, hPS, hPc⟩ β hβu hβ
  have hrm : m + 2 = r := r_eq_of_card_sylow (by omega) hΦ hAΦ hPS hPc
  obtain rfl : m = r - 2 := by omega
  have e1 : r - 2 + 1 = r - 1 := by omega
  rw [e1] at hou hβ
  obtain ⟨z, hz⟩ := Sec6Gen.exists_uniqueInvolution hΦ.hyp hAΦ
  have hstar := dstar_edgeless_of_muZ2 hΦ hAE hEdge hW' hμ
  have htr : ∀ L ∈ Φ, ∃ g ∈ omegaGen Φ, conjSub g A = L := by
    intro L hL
    by_contra hnc
    have hconn := dConnected_of_not_conjR h4 hΦ hO hn hAΦ hL hnc
    have hne : A ≠ L := fun h => hnc ⟨1, (omegaGen Φ).one_mem, by rw [conjSub_one, h]⟩
    rcases (hconn A hAΦ L hL).cases_head with h | ⟨c, ⟨hc, hadj⟩, -⟩
    · exact hne h
    · exact hEdge A hAΦ c hc hadj
  by_cases hnO : TightInO2 z
  · exact (false_of_inO2_s26 hr hΦ hO hgen hAE hTop hstar hAΦ htr hz hnO).elim
  obtain ⟨S₀, -, hc₀, hfam⟩ := exists_datumR_of_omegaTransitive (by omega) hΦ hO hgen hAΦ htr hz
  have hE : TightEdgeless A := by
    unfold TightEdgeless
    rw [hfam]
    exact hEdge
  have hcore : tightCore A = A := hΦ.closure_twoElts hAΦ
  have hgenA : (⨆ g : X, conjSub g A) = ⊤ := by
    have h := hc₀.2.1
    unfold TightSelfGen at h
    rwa [hcore] at h
  have hu2 : IsPGroup 2 (Subgroup.zpowers (⟨u, huA⟩ : ↥A)) := by
    refine IsPGroup.iff_card.mpr ⟨r - 1, ?_⟩
    rw [Nat.card_zpowers, Subgroup.orderOf_mk, hou]
  obtain ⟨S, hS⟩ := IsPGroup.exists_le_sylow hu2
  have huS : u ∈ (S : Subgroup ↥A).map A.subtype :=
    Subgroup.mem_map_of_mem A.subtype (hS (Subgroup.mem_zpowers _))
  have hd : TightDatum A S z := tightDatum_of_memR (by omega) hΦ hAΦ hz S
  have hc : TightClsR r X A S z := ⟨nonempty_sylow_equivR hΦ hAΦ S, hc₀.2.1, hc₀.2.2⟩
  obtain ⟨e⟩ := hΦ.quat A hAΦ _ (isSylow2In_map_subtype A S)
  obtain ⟨b, hbS, hbu, hbb⟩ := exists_quat_pair_of_mem hr e huS hou
  have hzu : u ^ 2 ^ (r - 2) = z := by
    have hdvd : 2 ^ (r - 2) ∣ orderOf u := by
      rw [hou]
      exact pow_dvd_pow 2 (by omega)
    have hord : orderOf (u ^ 2 ^ (r - 2)) = 2 := by
      rw [orderOf_pow_of_dvd (by positivity) hdvd, hou, show r - 1 = (r - 2) + 1 by omega, pow_succ,
        Nat.mul_div_cancel_left _ (by positivity)]
    exact hd.eq_of_orderOf_eq_two (A.pow_mem huA _) hord
  obtain ⟨L, hLn, hLq, hLC, hzn, hnt, hd', hc', hnO', hE', hTs, hab, hTC, hfamL⟩ :=
    layerIdent hr hA hB (smallListR_of_gh74 hG) (noDatumOtherR_holds r) h6 hn hd hc hnO hE
  haveI := hLn
  rcases hfamL with hL2 | hL3 | hU3
  ·
    rw [hzu]
    exact s26_l2_branch hr hO hΦ hAΦ hd hz hLq hLC hzn hnt hL2 hTC hgenA huS hbS hou hbu hbb hzu β
      hβu hβ
  ·
    exfalso
    obtain ⟨hxo, -, -, -⟩ := quatPair_mk hr hzn hou hbu hbb hzu
    obtain ⟨g, hgz, hgc⟩ := l3_exists_comm_conj hr (socleOf L) hTs hab hTC hL3 hd' hc'
      (x := (QuotientGroup.mk u : X ⧸ Subgroup.center X)) (Subgroup.mem_map_of_mem _ huA) hxo
    obtain ⟨g₀, rfl⟩ := QuotientGroup.mk_surjective g
    obtain ⟨hy, hcomm⟩ := lift_comm_conj hnt hgz hgc
    obtain ⟨M, hM, hne⟩ := dstar_edge_of_comm hr hΦ hAΦ hz S huS hou hy hcomm
    exact (Set.nonempty_iff_ne_empty.mp hne) (hstar M hM)
  ·
    exfalso
    obtain ⟨hxo, hbx, hbb', hxz⟩ := quatPair_mk hr hzn hou hbu hbb hzu
    have hxS : (QuotientGroup.mk u : X ⧸ Subgroup.center X) ∈
        ((TwistQ.sylowMap (Subgroup.center X) S : Sylow 2 _) : Subgroup _).map
          (A.map (QuotientGroup.mk' (Subgroup.center X))).subtype := by
      rw [TwistQ.sylowMap_map_subtype]
      exact Subgroup.mem_map_of_mem _ huS
    have hbS' : (QuotientGroup.mk b : X ⧸ Subgroup.center X) ∈
        ((TwistQ.sylowMap (Subgroup.center X) S : Sylow 2 _) : Subgroup _).map
          (A.map (QuotientGroup.mk' (Subgroup.center X))).subtype := by
      rw [TwistQ.sylowMap_map_subtype]
      exact Subgroup.mem_map_of_mem _ hbS
    obtain ⟨g, hgz, hgc⟩ := u3_exists_comm_conj hr (socleOf L) hTs hab hTC hU3 hd' hc' hxS hbS' hxo
      hbx hbb' hxz
    obtain ⟨g₀, rfl⟩ := QuotientGroup.mk_surjective g
    obtain ⟨hy, hcomm⟩ := lift_comm_conj hnt hgz hgc
    obtain ⟨M, hM, hne⟩ := dstar_edge_of_comm hr hΦ hAΦ hz S huS hou hy hcomm
    exact (Set.nonempty_iff_ne_empty.mp hne) (hstar M hM)

end Cit3

