namespace FiveTransitive.Degree48ThreeBound

open MulAction

theorem three_card_le_6561
    {X : Type} [Fintype X] [DecidableEq X]
    (P : Subgroup (Equiv.Perm X)) (hcard : Fintype.card X = 48)
    (h5 : IsMultiplyPretransitive P X 5) (hnotAlt : ¬ alternatingGroup X ≤ P)
    (Q : Subgroup P) (hQ : IsPGroup 3 Q)
    (hfixed : 12 ≤ Nat.card (fixedPoints Q X)) : Nat.card Q ≤ 6561 := by
  have hd := FiveTransitive.Degree48FiveGroupBound.card_dvd_exterior_tuples P hcard h5 hnotAlt Q 12 13 (by norm_num) hfixed
  obtain ⟨a,ha⟩ := IsPGroup.iff_card.mp hQ
  have habound : a ≤ 8 := by
    by_contra hn
    have hpow : 3^9 ∣ Nat.card Q := by
      rw [ha]
      exact pow_dvd_pow 3 (by omega)
    have hc := hpow.trans hd
    norm_num [Nat.descFactorial] at hc
  rw [ha]
  exact (Nat.pow_le_pow_right (by norm_num : 0 < 3) habound).trans (by norm_num)

end FiveTransitive.Degree48ThreeBound

end CFSG
