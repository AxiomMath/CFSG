theorem sum_length_G2 [Fintype (WeylGroup .G2)] (q : ℕ) :
    ∑ w : WeylGroup .G2, q ^ (coxeterSystem .G2).length w = geomSum 2 1 q * geomSum 6 1 q := by
  rw [← parabolicSum_univ, ← maskSet_full (m := 3) (by decide),
    parabolicSum_eq_of_chainCheck q _ _ g2Chain_check]
  simp only [g2Chain, ChainStep.value, List.map_cons, List.map_nil, List.prod_cons,
    List.prod_nil]
  ring

