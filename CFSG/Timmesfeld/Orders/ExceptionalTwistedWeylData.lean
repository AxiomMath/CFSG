open Classical in
theorem sum_length_relWeylTwist_E6 [Fintype (WeylGroup TwistTag.E6.tag)] (q : ℕ) :
    ∑ w ∈ Finset.univ.filter (· ∈ relWeylTwist TwistTag.E6),
        q ^ (coxeterSystem TwistTag.E6.tag).length w =
      geomSum 2 2 q * geomSum 3 2 q * (geomSum 2 5 q * geomSum 2 3 q * geomSum 2 1 q) *
        (geomSum 2 9 q * geomSum 2 6 q * geomSum 2 4 q * geomSum 3 1 q) := by
  rw [← twistedParabolicSum_univ, ← maskSet_full (m := 63) (by decide),
    twistedParabolicSum_eq_of_chainCheck q _ _ twE6Chain_check]
  simp only [twE6Chain, TwistedStep.value, List.map_cons, List.map_nil, List.prod_cons,
    List.prod_nil]
  ring

open Classical in
theorem sum_length_relWeylTwist_D4 [Fintype (WeylGroup TwistTag.D4.tag)] (q : ℕ) :
    ∑ w ∈ Finset.univ.filter (· ∈ relWeylTwist TwistTag.D4),
        q ^ (coxeterSystem TwistTag.D4.tag).length w =
      geomSum 2 3 q * (geomSum 3 4 q * geomSum 2 1 q) := by
  rw [← twistedParabolicSum_univ, ← maskSet_full (m := 15) (by decide),
    twistedParabolicSum_eq_of_chainCheck q _ _ twD4Chain_check]
  simp only [twD4Chain, TwistedStep.value, List.map_cons, List.map_nil, List.prod_cons,
    List.prod_nil]
  ring

