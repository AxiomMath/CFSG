@[expose] def lab6 (x : Fin 24) : Fin 6 := ⟨lab6L.getD x 0 % 6, Nat.mod_lt _ (by norm_num)⟩

@[expose] def rep6 : Fin 6 → Fin 24 := ![0, 2, 3, 5, 8, 13]

theorem lab6_rep6 : ∀ i, lab6 (rep6 i) = i := by decide

theorem lab6L_lt : ∀ x : Fin 24, lab6L.getD x 0 < 6 := by
  decide +kernel

theorem lab6_val (x : Fin 24) : ((lab6 x : Fin 6) : ℕ) = lab6L.getD x 0 :=
  Nat.mod_eq_of_lt (lab6L_lt x)

@[expose] def perm6 (f g : Fin 6 → Fin 6) (h : ∀ i, g (f i) = i ∧ f (g i) = i) :
    Equiv.Perm (Fin 6) where
  toFun := f
  invFun := g
  left_inv i := (h i).1
  right_inv i := (h i).2

@[expose] def s1P : Equiv.Perm (Fin 6) := perm6 ![1, 0, 3, 4, 5, 2] ![1, 0, 5, 2, 3, 4] (by decide)

@[expose] def s2P : Equiv.Perm (Fin 6) := perm6 ![2, 3, 1, 5, 4, 0] ![5, 2, 0, 1, 4, 3] (by decide)

@[expose] def bp1P : Equiv.Perm (Fin 6) := perm6 ![1, 4, 3, 2, 5, 0] ![5, 0, 3, 2, 1, 4] (by decide)

@[expose] def bp2P : Equiv.Perm (Fin 6) := perm6 ![3, 5, 0, 1, 4, 2] ![2, 3, 5, 0, 4, 1] (by decide)

@[expose] def bptP : Equiv.Perm (Fin 6) := perm6 ![4, 5, 2, 1, 0, 3] ![4, 3, 2, 5, 0, 1] (by decide)

theorem sign6 : Equiv.Perm.sign bp1P = 1 ∧ Equiv.Perm.sign bp2P = 1 ∧ Equiv.Perm.sign bptP ≠ 1 ∧
    Equiv.Perm.sign s1P = 1 ∧ Equiv.Perm.sign s2P = 1 := by
  decide

theorem sx_ok : InvPairOK 24 sxG1Arr sxG1Inv = true ∧ InvPairOK 24 sxG2Arr sxG2Inv = true ∧
    InvPairOK 24 sxTArr sxTInv = true ∧ autArrOK sxG1Arr sxG1Inv = true ∧
    autArrOK sxG2Arr sxG2Inv = true ∧ autArrOK sxTArr sxTInv = true := by
  decide +kernel

theorem sx_pres : ∀ m ∈ uSMasks, actC11 sxG1Arr m ∈ uSMasks ∧
    actC11 sxG1Inv m ∈ uSMasks ∧ actC11 sxG2Arr m ∈ uSMasks ∧ actC11 sxG2Inv m ∈ uSMasks ∧
    actC11 sxTArr m ∈ uSMasks ∧ actC11 sxTInv m ∈ uSMasks := by
  decide +kernel

theorem sx_lab : ∀ x y : Fin 24,
    (lab6L.getD sxG1Arr[(x : ℕ)]! 0 = lab6L.getD sxG1Arr[(y : ℕ)]! 0 ↔
      lab6L.getD x 0 = lab6L.getD y 0) ∧
    (lab6L.getD sxG2Arr[(x : ℕ)]! 0 = lab6L.getD sxG2Arr[(y : ℕ)]! 0 ↔
      lab6L.getD x 0 = lab6L.getD y 0) ∧
    (lab6L.getD sxTArr[(x : ℕ)]! 0 = lab6L.getD sxTArr[(y : ℕ)]! 0 ↔
      lab6L.getD x 0 = lab6L.getD y 0) := by
  decide +kernel

theorem sx_bp : ∀ i : Fin 6, lab6L.getD sxG1Arr[((rep6 i : Fin 24) : ℕ)]! 0 = (bp1P i : ℕ) ∧
    lab6L.getD sxG2Arr[((rep6 i : Fin 24) : ℕ)]! 0 = (bp2P i : ℕ) ∧
    lab6L.getD sxTArr[((rep6 i : Fin 24) : ℕ)]! 0 = (bptP i : ℕ) := by
  decide +kernel

@[expose] def sxC0Arr : Array ℕ := cArr (cArr sxG1Arr sxG2Arr) (cArr sxG1Inv sxG2Inv)

@[expose] def sxC1Arr : Array ℕ :=
  cArr (cArr sxG1Arr (cArr sxG2Arr (cArr sxG2Arr sxG2Arr)))
    (cArr sxG1Inv (cArr (cArr sxG2Inv sxG2Inv) sxG2Inv))

theorem sx_perf : wArr [sxC0Arr, sxC1Arr] (sxPerfWord 0) = sxG1Arr ∧
    wArr [sxC0Arr, sxC1Arr] (sxPerfWord 1) = sxG2Arr := by
  decide +kernel

@[expose] def ks6Arr (i : ℕ) : Array ℕ := wArr [sxG1Arr, sxG2Arr] (ksWord6 i)

@[expose] def subW (S : ℕ) : List ℕ := (List.range 6).filter fun j => S.testBit j

theorem ks6_ok : ∀ i < 6, matOf 11 (actC11 (ks6Arr i)) = ksC6 i ∧
    (∀ m ∈ combos uSBasis, actC11 (ks6Arr i) m = m) ∧
    cArr (ks6Arr i) (ks6Arr i) = idArr ∧
    ∀ j < 6, cArr (ks6Arr i) (ks6Arr j) = cArr (ks6Arr j) (ks6Arr i) := by
  decide +kernel

theorem ks6_conj : ∀ i < 6,
    cArr (cArr sxG1Arr (ks6Arr i)) sxG1Inv = wArr ((List.range 6).map ks6Arr) (subW (ksConj 0 i)) ∧
    cArr (cArr sxG2Arr (ks6Arr i)) sxG2Inv = wArr ((List.range 6).map ks6Arr) (subW (ksConj 1 i)) ∧
    cArr (cArr sxG1Inv (ks6Arr i)) sxG1Arr = wArr ((List.range 6).map ks6Arr) (subW (ksConj 2 i)) ∧
    cArr (cArr sxG2Inv (ks6Arr i)) sxG2Arr =
      wArr ((List.range 6).map ks6Arr) (subW (ksConj 3 i)) := by
  decide +kernel

@[expose] def ks6Act (g m : ℕ) : ℕ := actM (ksC6 (g % 6)) m

theorem ksTree6_ok : treeB ks6Act ksTree6 (1 <<< 8) = true := by
  decide +kernel

theorem ksTree6_length : ksTree6.length = 63 := by
  decide +kernel

theorem ksC6_lt : ∀ i < 6, ∀ c ∈ ksC6 i, c < 2 ^ 11 := by
  decide +kernel

@[expose] def sxZArr : Array ℕ := wArr [sxG1Arr, sxG2Arr] [1, 1, 1, 1, 1]

theorem sxZ_ok : cArr sxZArr (cArr sxZArr sxZArr) = idArr ∧ sxZArr[0]! = 12 ∧
    ∀ m ∈ combos uSBasis, actC11 sxZArr m = m := by
  decide +kernel

theorem sxCols_eq : matOf 11 (actC11 sxG1Arr) = sxG1C ∧ matOf 11 (actC11 sxG2Arr) = sxG2C := by
  decide +kernel

theorem sxCols_lt : ∀ c ∈ sxG1C ++ sxG2C, c < 2 ^ 11 := by
  decide +kernel

theorem usD_ok : ∀ m ∈ uSMasks, actM uSBasis (actM usD m) = m ∧ actM usD m < 2 ^ 4 := by
  decide +kernel

theorem usStart : uSBasis.foldr (fun u acc => actM usD u + 2 ^ 4 * acc) 0 = 33825 := by
  decide +kernel

@[expose] def usAct (g k : ℕ) : ℕ := tupAct 4 usD uSBasis (if g = 0 then sxG1C else sxG2C) 4 k

theorem usTree_ok : treeB usAct usTree (1 <<< 33825) = true := by
  decide +kernel

theorem usTree_length : usTree.length = 359 := by
  decide +kernel

theorem th_ok : ∀ m ∈ combos uSBasis, actM thC m < 2 ^ 6 ∧ (actM thC m = 0 → m = 0) ∧
    ∑ i : Fin 6, bvec 6 (actM thC m) i = 0 ∧ bvec 6 (actM thC m) 5 = 0 ∧
    ∀ i : Fin 6, bvec 6 (actM thC (actM sxG1C m)) i =
        bvec 6 (actM thC m) (s1P⁻¹ i) + bvec 6 (actM thC m) (s1P⁻¹ 5) ∧
      bvec 6 (actM thC (actM sxG2C m)) i =
        bvec 6 (actM thC m) (s2P⁻¹ i) + bvec 6 (actM thC m) (s2P⁻¹ 5) := by
  decide +kernel

theorem uSMasks_combos : ∀ m < 2 ^ 11, m ∈ combos uSBasis ↔ m ∈ uSMasks := by
  decide +kernel

end CFSG.Quasithin.H.LU24
