@[expose] def oddMask : ℕ := 3264

@[expose] def subCheck (gW gens : List (List ℕ)) (D : List (List ℕ × List ℕ)) : Bool :=
  gW.map tW == gens && (D.all fun p => evalW 12 gens p.2 == p.1) &&
  ((D.map Prod.fst).all fun x => gens.all fun g => (D.map Prod.fst).contains (mulN g x)) &&
  (D.map Prod.fst).contains one12 && gens.all (validB 12) && decide (D.map Prod.fst).Nodup &&
  (D.map Prod.fst).all fun x => x == one12 || fixOK x oddMask

@[expose] def oddCheck : Bool :=
  subCheck p3W p3G p3D && subCheck p5W p5G p5D && subCheck p7W p7G p7D &&
    subCheck p11W p11G p11D && decide (maskCard oddMask ≤ 16)

theorem oddCheck_eq : oddCheck = true := by decide +kernel

