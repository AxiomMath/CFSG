abbrev Tab : Type := List Nat

@[expose] def tid : Tab := List.range 12

@[expose] def tmul (p q : Tab) : Tab := q.map fun k => p.getD k 0

@[expose] def tA : Tab := [3, 1, 9, 0, 10, 11, 6, 7, 8, 2, 4, 5]

@[expose] def tB : Tab := [7, 2, 3, 1, 11, 9, 5, 8, 0, 6, 4, 10]

@[expose] def tBi : Tab := [8, 3, 1, 2, 10, 6, 9, 0, 7, 5, 11, 4]

@[expose] def tBp : Tab := [5, 8, 1, 0, 7, 3, 10, 9, 2, 4, 11, 6]

@[expose] def tBpi : Tab := [3, 2, 8, 5, 9, 0, 11, 4, 1, 7, 6, 10]

@[expose] def letterT (tg tgi : Tab) (d : Nat) : Tab :=
  if d = 1 then tA else if d = 2 then tg else if d = 3 then tgi else tid

@[expose] def evalN (tg tgi : Tab) : Nat → Nat → Tab
  | 0, _ => tid
  | n + 1, w => if w = 0 then tid else tmul (letterT tg tgi (w % 4)) (evalN tg tgi n (w / 4))

