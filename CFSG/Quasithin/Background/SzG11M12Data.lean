theorem e8_cover : ∀ x ∈ invs, ∀ y ∈ invs, tmul x y = tmul y x → y ≠ x → ∀ z ∈ invs,
    tmul x z = tmul z x → tmul y z = tmul z y → z ≠ x → z ≠ y → z ≠ tmul x y →
    ∃ E ∈ e8Data, x ∈ E.1 ∧ y ∈ E.1 ∧ z ∈ E.1 := by decide +kernel

@[expose] def outerWord : Nat := 107444071

theorem outer_swap :
    (evalN tB tBi fuel outerWord).getD 0 0 = 1 ∧ (evalN tB tBi fuel outerWord).getD 1 0 = 0 := by
  decide +kernel

theorem outer_free : ∀ x < 12, (evalN tBp tBpi fuel outerWord).getD x 0 ≠ x ∧
    (tmul (evalN tBp tBpi fuel outerWord) (evalN tBp tBpi fuel outerWord)).getD x 0 ≠ x := by
  decide +kernel

