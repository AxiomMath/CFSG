@[expose] def enc (t : Tab) : Nat := t.foldr (fun x a => a * 12 + x) 0

theorem enc_inj : ∀ (s t : List Nat), s.length = t.length → (∀ x ∈ s, x < 12) →
    (∀ x ∈ t, x < 12) → enc s = enc t → s = t
  | [], [], _, _, _, _ => rfl
  | [], _ :: _, hl, _, _, _ => by simp at hl
  | _ :: _, [], hl, _, _, _ => by simp at hl
  | x :: s, y :: t, hl, hs, ht, h => by
    have hx : x < 12 := hs x (by simp)
    have hy : y < 12 := ht y (by simp)
    have h' : enc s * 12 + x = enc t * 12 + y := h
    have h1 : x = y := by omega
    have h2 : enc s = enc t := by omega
    have h3 : s = t := enc_inj s t (by simpa using hl) (fun z hz => hs z (by simp [hz]))
      (fun z hz => ht z (by simp [hz])) h2
    rw [h1, h3]

