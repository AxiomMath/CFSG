@[expose] def IrredInvolutionRankBound (G : Type) [Group G] (b : ℕ) : Prop :=
  ∀ (U : Type) [CommGroup U] [Finite U], (∀ u : U, u ^ 2 = 1) →
    ∀ ρ : G →* MulAut U,
      (∀ H : Subgroup U, (∀ g : G, ∀ u ∈ H, ρ g u ∈ H) → H = ⊥ ∨ H = ⊤) →
      ∀ l : G, orderOf l = 2 → ρ l ≠ 1 →
        b ≤ rkIdx (fixV (Subgroup.zpowers (ρ l)))

theorem involution_eq_mul_of_inner
    {Y : Type} [Group Y] (L : Subgroup Y) [L.Normal]
    (hZ : Subgroup.center L = ⊥)
    (hinner : ∀ α : MulAut L, α ^ 2 = 1 → ∃ g : L, ∀ x, α x = g * x * g⁻¹)
    {t : Y} (ht : t ^ 2 = 1) :
    ∃ l ∈ L, ∃ c : Y, (∀ x ∈ L, c * x = x * c) ∧ l ^ 2 = 1 ∧ c ^ 2 = 1 ∧
      c * l = l * c ∧ t = l * c := by
  classical
  let α : MulAut L := MulAut.conjNormal t
  have hα2 : α ^ 2 = 1 := by
    change (MulAut.conjNormal (H := L) t) ^ 2 = 1
    rw [← map_pow, ht, map_one]
  obtain ⟨g, hg⟩ := hinner α hα2
  have hαα : ∀ y : L, α (α y) = y := by
    intro y
    have h := congrArg (fun e : MulAut L => e y) hα2
    simpa [pow_two] using h
  have hg2_center : g ^ 2 ∈ Subgroup.center L := by
    rw [Subgroup.mem_center_iff]
    intro y
    have key : (g ^ 2 : L) * y * (g ^ 2)⁻¹ = y := by
      calc
        (g ^ 2 : L) * y * (g ^ 2)⁻¹ = g * (g * y * g⁻¹) * g⁻¹ := by
          simp only [pow_two]; group
        _ = g * (α y) * g⁻¹ := by rw [← hg y]
        _ = α (α y) := (hg (α y)).symm
        _ = y := hαα y
    have key2 : (g ^ 2 : L) * y = y * (g ^ 2) := by
      calc
        (g ^ 2 : L) * y = ((g ^ 2 : L) * y * (g ^ 2)⁻¹) * (g ^ 2) := by group
        _ = y * (g ^ 2) := by rw [key]
    exact key2.symm
  have hg2 : g ^ 2 = 1 := by
    have h := hg2_center
    rw [hZ] at h
    simpa using h
  have hαx : ∀ x : L, ((α x : L) : Y) = t * (x : Y) * t⁻¹ := by
    intro x
    change ((MulAut.conjNormal (H := L) t x : L) : Y) = t * (x : Y) * t⁻¹
    rw [MulAut.conjNormal_apply]
  let c : Y := (g : Y)⁻¹ * t
  have hcx : ∀ x ∈ L, c * x * c⁻¹ = x := by
    intro x hx
    let xL : L := ⟨x, hx⟩
    have hαx' : t * x * t⁻¹ = (g : Y) * x * (g : Y)⁻¹ := by
      rw [← hαx xL]
      simpa using congrArg Subtype.val (hg xL)
    calc
      c * x * c⁻¹ = (g : Y)⁻¹ * (t * x * t⁻¹) * g := by simp [c, mul_assoc]
      _ = (g : Y)⁻¹ * ((g : Y) * x * (g : Y)⁻¹) * g := by rw [hαx']
      _ = x := by group
  have hc_cent : ∀ x ∈ L, c * x = x * c := by
    intro x hx
    have h := hcx x hx
    calc
      c * x = (c * x * c⁻¹) * c := by group
      _ = x * c := by rw [h]
  have hg2Y : (g : Y) ^ 2 = 1 := by
    simpa using congrArg Subtype.val hg2
  have ht_eq : t = (g : Y) * c := by simp [c]
  have hc2 : c ^ 2 = 1 := by
    have hcomm : (g : Y) * c = c * (g : Y) := (hc_cent (g : Y) g.property).symm
    have hsq : ((g : Y) * c) ^ 2 = ((g : Y) ^ 2) * c ^ 2 := by
      rw [pow_two, pow_two, pow_two]
      calc
        ((g : Y) * c) * ((g : Y) * c) = (g : Y) * (c * (g : Y)) * c := by group
        _ = (g : Y) * ((g : Y) * c) * c := by rw [hcomm]
        _ = ((g : Y) * (g : Y)) * (c * c) := by group
    have h1 : ((g : Y) * c) ^ 2 = 1 := by
      rw [← ht_eq]
      exact ht
    rw [hsq, hg2Y, one_mul] at h1
    exact h1
  exact ⟨g, g.property, c, hc_cent, hg2Y, hc2, hc_cent (g : Y) g.property, ht_eq⟩

theorem even_card_of_le_of_involution {W : Type} [CommGroup W] [Finite W]
    {Y L : Subgroup (MulAut W)} (hLY : L ≤ Y) (hinv : ∃ l : L, orderOf l = 2) :
    Even (Nat.card Y) := by
  obtain ⟨l, hl⟩ := hinv
  have hdvdL : 2 ∣ Nat.card L := by
    rw [← hl]
    exact orderOf_dvd_natCard l
  have hdvdY : 2 ∣ Nat.card Y := hdvdL.trans (Subgroup.card_dvd_of_le hLY)
  exact even_iff_two_dvd.mpr hdvdY

theorem le_mParam_of_forall_involutions {W : Type} [CommGroup W] [Finite W]
    (Y : Subgroup (MulAut W)) (b : ℕ) (hY : Even (Nat.card Y))
    (hne : ∃ t ∈ Y, orderOf t = 2)
    (hall : ∀ t ∈ Y, orderOf t = 2 → b ≤ rkIdx (fixV (Subgroup.zpowers t))) :
    b ≤ E3.mParam Y := by
  classical
  unfold E3.mParam
  rw [if_pos hY]
  refine le_csInf ?_ ?_
  · obtain ⟨t, ht, hto⟩ := hne
    exact ⟨_, t, ht, hto, rfl⟩
  · rintro _ ⟨t, ht, hto, rfl⟩
    exact hall t ht hto

theorem involution_decomp_of_inner {W : Type} [CommGroup W] [Finite W]
    (Y L : Subgroup (MulAut W)) (hLY : L ≤ Y) (hN : (L.subgroupOf Y).Normal)
    (hZ : Subgroup.center L = ⊥)
    (hinner : ∀ α : MulAut L, α ^ 2 = 1 → ∃ g : L, ∀ x, α x = g * x * g⁻¹)
    {t : Y} (ht : orderOf t = 2) :
    ∃ (l c : MulAut W), l ∈ L ∧ c ∈ Y ∧
      (∀ x ∈ L, c * x = x * c) ∧ l ^ 2 = 1 ∧ c ^ 2 = 1 ∧ c * l = l * c ∧
      (t : MulAut W) = l * c := by
  classical
  let L' : Subgroup Y := L.subgroupOf Y
  let e : L' ≃* L := Subgroup.subgroupOfEquivOfLe hLY
  have hZ' : Subgroup.center L' = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    have hxL : e x ∈ Subgroup.center L := by
      rw [Subgroup.mem_center_iff]
      intro y
      obtain ⟨y', rfl⟩ := e.surjective y
      have hx' : x ∈ Subgroup.center L' := hx
      rw [Subgroup.mem_center_iff] at hx'
      have := congrArg e (hx' y')
      simpa using this
    have hx1 : e x = 1 := by
      have := hxL
      rw [hZ] at this
      simpa using this
    have hx1' : x = 1 := e.injective (by simpa using hx1)
    simpa [hx1'] using Subgroup.one_mem (⊥ : Subgroup L')
  have hinner' : ∀ α : MulAut L', α ^ 2 = 1 → ∃ g : L', ∀ x, α x = g * x * g⁻¹ := by
    intro α hα2
    let β : MulAut L := MulAut.congr e α
    have hβ2 : β ^ 2 = 1 := by
      change (MulAut.congr e α) ^ 2 = 1
      rw [← map_pow, hα2, map_one]
    obtain ⟨g, hg⟩ := hinner β hβ2
    refine ⟨e.symm g, fun x => ?_⟩
    apply e.injective
    have hβx : β (e x) = e (α x) := by
      change (MulAut.congr e α) (e x) = e (α x)
      rw [MulAut.congr_apply]
      simp
    have hgx := hg (e x)
    rw [hβx] at hgx
    rw [hgx]
    simp
  have ht2 : t ^ 2 = 1 := by
    have := pow_orderOf_eq_one t
    rwa [ht] at this
  obtain ⟨l', hl', c, hc_cent', hl'2, hc2, hcl', ht_eq'⟩ :=
    involution_eq_mul_of_inner L' hZ' hinner' ht2
  refine ⟨(l' : MulAut W), (c : MulAut W), Subgroup.mem_subgroupOf.mp hl', c.property, ?_,
    ?_, ?_, ?_, ?_⟩
  · intro x hx
    let x' : Y := ⟨x, hLY hx⟩
    have hx' : x' ∈ L' := Subgroup.mem_subgroupOf.mpr hx
    have h := hc_cent' x' hx'
    simpa [x'] using congrArg (fun z : Y => (z : MulAut W)) h
  · simpa using congrArg (fun z : Y => (z : MulAut W)) hl'2
  · simpa using congrArg (fun z : Y => (z : MulAut W)) hc2
  · simpa using congrArg (fun z : Y => (z : MulAut W)) hcl'
  · simpa using congrArg (fun z : Y => (z : MulAut W)) ht_eq'

theorem exists_minimal_invariant_subgroup {W : Type} [Group W] [Finite W]
    (L : Subgroup (MulAut W)) (O : Subgroup W) (hO : O ≠ ⊥)
    (hLO : ∀ x ∈ L, ∀ u ∈ O, x u ∈ O) :
    ∃ U : Subgroup W, U ≤ O ∧ U ≠ ⊥ ∧ (∀ x ∈ L, ∀ u ∈ U, x u ∈ U) ∧
      ∀ U' : Subgroup W, U' ≤ U → U' ≠ ⊥ → (∀ x ∈ L, ∀ u ∈ U', x u ∈ U') → U' = U := by
  classical
  obtain ⟨U, ⟨hUO, hUne, hLU⟩, hmin⟩ :=
    (measure (fun U : Subgroup W => Nat.card U)).wf.has_min
      {U : Subgroup W | U ≤ O ∧ U ≠ ⊥ ∧ ∀ x ∈ L, ∀ u ∈ U, x u ∈ U}
      ⟨O, le_rfl, hO, hLO⟩
  refine ⟨U, hUO, hUne, hLU, fun U' hU'U hU'ne hU'inv => ?_⟩
  have hlt := hmin U' ⟨hU'U.trans hUO, hU'ne, hU'inv⟩
  exact Subgroup.eq_of_le_of_card_ge hU'U (not_lt.mp hlt)

theorem le_rkIdx_of_centralizing_involution {W : Type} [CommGroup W] [Finite W]
    (hW : ∀ w : W, w ^ 2 = 1) (L : Subgroup (MulAut W)) (hS : IsSimpleGroup L)
    (hfix : fixV L = ⊥) (hinv : ∃ l : L, orderOf l = 2) (b : ℕ)
    (hb : IrredInvolutionRankBound L b) {c : MulAut W}
    (hcL : ∀ x ∈ L, c * x = x * c) (hc2 : c ^ 2 = 1) (hc1 : c ≠ 1) :
    b ≤ rkIdx (fixV (Subgroup.zpowers c)) := by
  classical
  let O : Subgroup W := commV (Subgroup.zpowers c)
  have hO : O ≠ ⊥ := by
    intro hbot
    apply hc1
    ext v
    have hgen : c v * v⁻¹ ∈ O := by
      rw [show O = commV (Subgroup.zpowers c) from rfl]
      exact Subgroup.subset_closure ⟨c, Subgroup.mem_zpowers c, v, rfl⟩
    rw [hbot] at hgen
    have h1 : c v * v⁻¹ = 1 := by simpa using hgen
    calc
      c v = c v * v⁻¹ * v := by group
      _ = 1 * v := by rw [h1]
      _ = v := one_mul v
  have hcomm : ∀ a ∈ Subgroup.zpowers c, ∀ x ∈ L, a * x = x * a := by
    intro a ha x hx
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp ha
    exact (Commute.zpow_left (hcL x hx) n).eq
  have hLO : ∀ x ∈ L, ∀ u ∈ O, x u ∈ O := by
    intro x hx u hu
    exact commV_apply_mem_of_commute hcomm hx hu
  obtain ⟨U, hUO, hUne, hLU, hmin⟩ := exists_minimal_invariant_subgroup L O hO hLO
  have hLstab : L ≤ stabSub U := by
    intro x hx
    rw [mem_stabSub]
    intro u
    constructor
    · intro hu
      have hxinv : x⁻¹ ∈ L := L.inv_mem hx
      have := hLU x⁻¹ hxinv (x u) (by simpa using hu)
      simpa using this
    · exact hLU x hx u
  let ρ : L →* MulAut U := (resHom U).comp (Subgroup.inclusion hLstab)
  have hρ_apply : ∀ (x : L) (u : U), ((ρ x u : U) : W) = (x : MulAut W) u := by
    intro x u
    rfl
  have hirr : ∀ H : Subgroup U, (∀ g : L, ∀ u ∈ H, ρ g u ∈ H) → H = ⊥ ∨ H = ⊤ := by
    intro H hH
    by_cases hHbot : H = ⊥
    · exact Or.inl hHbot
    · right
      let H' : Subgroup W := H.map U.subtype
      have hH'le : H' ≤ U := by
        rintro _ ⟨u, -, rfl⟩
        exact u.2
      have hH'ne : H' ≠ ⊥ := by
        intro h
        apply hHbot
        have h' : H'.subgroupOf U = (⊥ : Subgroup W).subgroupOf U := congrArg _ h
        simpa [H', CFSG.subgroupOf_map_subtype_eq] using h'
      have hH'inv : ∀ x ∈ L, ∀ u ∈ H', x u ∈ H' := by
        rintro x hx u ⟨u₀, hu₀, rfl⟩
        exact ⟨ρ ⟨x, hx⟩ u₀, hH ⟨x, hx⟩ u₀ hu₀, (hρ_apply ⟨x, hx⟩ u₀).symm⟩
      have hmin' := hmin H' hH'le hH'ne hH'inv
      calc
        H = H'.subgroupOf U := (CFSG.subgroupOf_map_subtype_eq H).symm
        _ = U.subgroupOf U := by rw [hmin']
        _ = ⊤ := Subgroup.subgroupOf_self U
  have hker : ρ.ker = ⊥ := by
    rcases hS.eq_bot_or_eq_top_of_normal ρ.ker with h | h
    · exact h
    · exfalso
      have hUfix : U ≤ fixV L := by
        intro u hu
        rw [mem_fixV]
        intro x hx
        let xL : L := ⟨x, hx⟩
        have hxker : xL ∈ ρ.ker := by rw [h]; exact Subgroup.mem_top xL
        have hρx : ρ xL = 1 := MonoidHom.mem_ker.mp hxker
        have h := congrArg (fun φ : MulAut U => ((φ ⟨u, hu⟩ : U) : W)) hρx
        rw [hρ_apply xL ⟨u, hu⟩] at h
        exact h
      have hUbot : U = ⊥ := by
        rw [eq_bot_iff]
        exact hUfix.trans (le_of_eq hfix)
      exact hUne hUbot
  obtain ⟨l0, hl0⟩ := hinv
  have hl0ne : l0 ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hl0
    omega
  have hρl0 : ρ l0 ≠ 1 := by
    intro h
    have : l0 ∈ ρ.ker := MonoidHom.mem_ker.mpr h
    rw [hker] at this
    exact hl0ne (by simpa using this)
  have hbU : b ≤ rkIdx (fixV (Subgroup.zpowers (ρ l0))) :=
    hb U (fun u => Subtype.ext (by simpa using hW u.1)) ρ hirr l0 hl0 hρl0
  have hleU : rkIdx (fixV (Subgroup.zpowers (ρ l0))) ≤ rk U := by
    have h := rk_add_rkIdx (fixV (Subgroup.zpowers (ρ l0)))
    omega
  have hleO : rk U ≤ rk O := rk_mono hUO
  have hOeq : rk O = rkIdx (fixV (Subgroup.zpowers c)) := by
    rw [show O = commV (Subgroup.zpowers c) from rfl, ← rkIdx_fixV_zpowers c]
  calc
    b ≤ rkIdx (fixV (Subgroup.zpowers (ρ l0))) := hbU
    _ ≤ rk U := hleU
    _ ≤ rk O := hleO
    _ = rkIdx (fixV (Subgroup.zpowers c)) := hOeq

theorem le_rkIdx_of_involution_mul_centralizing {W : Type} [CommGroup W] [Finite W]
    (hW : ∀ w : W, w ^ 2 = 1) (L : Subgroup (MulAut W)) (hS : IsSimpleGroup L)
    (hfix : fixV L = ⊥) (b : ℕ) (hb : IrredInvolutionRankBound L b)
    {l c : MulAut W} (hlL : l ∈ L) (hl2 : l ^ 2 = 1) (hl1 : l ≠ 1)
    (hcL : ∀ x ∈ L, c * x = x * c) (hc2 : c ^ 2 = 1) :
    b ≤ rkIdx (fixV (Subgroup.zpowers (l * c))) := by
  classical
  have hWnt : Nontrivial W := by
    rcases subsingleton_or_nontrivial W with h | h
    · exfalso
      apply hl1
      ext w
      exact Subsingleton.elim (l w) w
    · exact h
  haveI : Nontrivial W := hWnt
  let H : Subgroup (MulAut W) := L ⊔ Subgroup.zpowers c
  have hO : (⊤ : Subgroup W) ≠ ⊥ := bot_lt_top.ne.symm
  obtain ⟨U, -, hUne, hHU, hmin⟩ :=
    exists_minimal_invariant_subgroup H ⊤ hO
      (by intro x hx u hu; exact Subgroup.mem_top u)
  have hLH : L ≤ H := le_sup_left
  have hcH : c ∈ H := Subgroup.mem_sup_right (Subgroup.mem_zpowers c)
  have hLU : ∀ x ∈ L, ∀ u ∈ U, x u ∈ U := fun x hx => hHU x (hLH hx)
  have hcU : ∀ u ∈ U, c u ∈ U := hHU c hcH
  have hc_stab : c ∈ stabSub U := by
    rw [mem_stabSub]
    intro u
    constructor
    · intro hu
      have hcc : c (c u) = u := by
        have := congrArg (fun φ : MulAut W => φ u) hc2
        simpa [pow_two] using this
      simpa [hcc] using hcU (c u) hu
    · exact hcU u
  have hcUzp : Subgroup.zpowers c ≤ stabSub U := Subgroup.zpowers_le.mpr hc_stab
  have hcUzp' : ∀ x ∈ Subgroup.zpowers c, ∀ u ∈ U, x u ∈ U := by
    intro x hx u hu
    exact (mem_stabSub.mp (hcUzp hx) u).2 hu
  let Csub : Subgroup W := commSub U (Subgroup.zpowers c)
  have hCsub_le : Csub ≤ U := commSub_le_of_invariant hcUzp'
  have hCsubH : H ≤ stabSub Csub := by
    apply sup_le
    · intro x hx
      rw [mem_stabSub]
      intro u
      constructor
      · intro hu
        have hxinv : x⁻¹ ∈ L := L.inv_mem hx
        have hxinv_norm : x⁻¹ ∈ Subgroup.normalizer (Subgroup.zpowers c : Set (MulAut W)) := by
          apply Subgroup.centralizer_le_normalizer
          rw [Subgroup.mem_centralizer_iff]
          intro y hy
          obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
          exact (Commute.zpow_left (hcL x⁻¹ hxinv) n).eq
        have h := CFSG.Quasithin.RonanF918.commSub_apply_mem hxinv_norm (hLU x⁻¹ hxinv) hu
        simpa using h
      · intro hu
        have hx_norm : x ∈ Subgroup.normalizer (Subgroup.zpowers c : Set (MulAut W)) := by
          apply Subgroup.centralizer_le_normalizer
          rw [Subgroup.mem_centralizer_iff]
          intro y hy
          obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
          exact (Commute.zpow_left (hcL x hx) n).eq
        exact CFSG.Quasithin.RonanF918.commSub_apply_mem hx_norm (hLU x hx) hu
    · apply Subgroup.zpowers_le.mpr
      rw [mem_stabSub]
      intro u
      constructor
      · intro hu
        have hc_norm : c ∈ Subgroup.normalizer (Subgroup.zpowers c : Set (MulAut W)) :=
          Subgroup.le_normalizer (Subgroup.mem_zpowers c)
        have h := CFSG.Quasithin.RonanF918.commSub_apply_mem hc_norm hcU hu
        have hcc : c (c u) = u := by
          have := congrArg (fun φ : MulAut W => φ u) hc2
          simpa [pow_two] using this
        simpa [hcc] using h
      · intro hu
        have hc_norm : c ∈ Subgroup.normalizer (Subgroup.zpowers c : Set (MulAut W)) :=
          Subgroup.le_normalizer (Subgroup.mem_zpowers c)
        exact CFSG.Quasithin.RonanF918.commSub_apply_mem hc_norm hcU hu
  have hCsub_bot : Csub = ⊥ := by
    by_contra hne
    have hCsubH' : ∀ x ∈ H, ∀ u ∈ Csub, x u ∈ Csub := by
      intro x hx u hu
      exact (mem_stabSub.mp (hCsubH hx) u).2 hu
    have hminC := hmin Csub hCsub_le hne hCsubH'
    have hquad : commSub Csub (Subgroup.zpowers c) = ⊥ := by
      have hq : IsQuadratic (Subgroup.zpowers c) := isQuadratic_zpowers hW hc2
      have hq' : commSub (commV (Subgroup.zpowers c)) (Subgroup.zpowers c) = ⊥ :=
        commSub_eq_bot_iff.mpr hq
      have hle : commSub Csub (Subgroup.zpowers c) ≤
          commSub (commV (Subgroup.zpowers c)) (Subgroup.zpowers c) := by
        apply commSub_mono
        · rw [commV_eq_commSub]
          exact commSub_mono le_top le_rfl
        · exact le_rfl
      exact le_bot_iff.mp (hle.trans (le_of_eq hq'))
    rw [hminC] at hquad
    exact hne hquad
  have hUfixc : U ≤ fixV (Subgroup.zpowers c) := commSub_eq_bot_iff.mp hCsub_bot
  have hc_triv : ∀ u ∈ U, c u = u := fun u hu => mem_fixV_zpowers_iff.mp (hUfixc hu)
  have hLstab : L ≤ stabSub U := by
    intro x hx
    rw [mem_stabSub]
    intro u
    constructor
    · intro hu
      have hxinv : x⁻¹ ∈ L := L.inv_mem hx
      have h := hLU x⁻¹ hxinv (x u) hu
      simpa using h
    · exact hLU x hx u
  let ρ : L →* MulAut U := (resHom U).comp (Subgroup.inclusion hLstab)
  have hρ_apply : ∀ (x : L) (u : U), ((ρ x u : U) : W) = (x : MulAut W) u := by
    intro x u
    rfl
  have hirr : ∀ V : Subgroup U, (∀ g : L, ∀ u ∈ V, ρ g u ∈ V) → V = ⊥ ∨ V = ⊤ := by
    intro V hV
    by_cases hVbot : V = ⊥
    · exact Or.inl hVbot
    · right
      let V' : Subgroup W := V.map U.subtype
      have hV'le : V' ≤ U := by
        rintro _ ⟨u, -, rfl⟩
        exact u.2
      have hV'ne : V' ≠ ⊥ := by
        intro h
        apply hVbot
        have h' : V'.subgroupOf U = (⊥ : Subgroup W).subgroupOf U := congrArg _ h
        simpa [V', CFSG.subgroupOf_map_subtype_eq] using h'
      have hLV' : L ≤ stabSub V' := by
        intro x hx
        rw [mem_stabSub]
        intro u
        constructor
        · intro hu
          have hxinv : x⁻¹ ∈ L := L.inv_mem hx
          have hxinv_map : ∀ w ∈ V', x⁻¹ w ∈ V' := by
            intro w hw
            obtain ⟨w₀, hw₀, rfl⟩ := Subgroup.mem_map.mp hw
            exact ⟨ρ ⟨x⁻¹, hxinv⟩ w₀, hV ⟨x⁻¹, hxinv⟩ w₀ hw₀,
              (hρ_apply ⟨x⁻¹, hxinv⟩ w₀).symm⟩
          have h := hxinv_map (x u) hu
          simpa using h
        · intro hu
          obtain ⟨u₀, hu₀, rfl⟩ := Subgroup.mem_map.mp hu
          exact ⟨ρ ⟨x, hx⟩ u₀, hV ⟨x, hx⟩ u₀ hu₀, (hρ_apply ⟨x, hx⟩ u₀).symm⟩
      have hcV' : c ∈ stabSub V' := by
        rw [mem_stabSub]
        intro u
        constructor
        · intro hu
          obtain ⟨u₀, hu₀, hcu⟩ := Subgroup.mem_map.mp hu
          have hcu₀ : c (u₀ : W) = (u₀ : W) := hc_triv (u₀ : W) u₀.property
          have hcc : c (c u) = u := by
            have := congrArg (fun φ : MulAut W => φ u) hc2
            simpa [pow_two] using this
          have hu₀u : u₀ = u := by
            calc
              u₀ = c u₀ := hcu₀.symm
              _ = c (c u) := by simpa using congrArg c hcu
              _ = u := hcc
          exact ⟨u₀, hu₀, hu₀u⟩
        · intro hu
          obtain ⟨u₀, hu₀, rfl⟩ := Subgroup.mem_map.mp hu
          have hcu₀ : c (u₀ : W) = (u₀ : W) := hc_triv (u₀ : W) u₀.property
          simpa [hcu₀] using hu
      have hHV' : H ≤ stabSub V' := sup_le hLV' (Subgroup.zpowers_le.mpr hcV')
      have hHV'' : ∀ x ∈ H, ∀ u ∈ V', x u ∈ V' := by
        intro x hx u hu
        exact (mem_stabSub.mp (hHV' hx) u).2 hu
      have hminV := hmin V' hV'le hV'ne hHV''
      calc
        V = V'.subgroupOf U := (CFSG.subgroupOf_map_subtype_eq V).symm
        _ = U.subgroupOf U := by rw [hminV]
        _ = ⊤ := Subgroup.subgroupOf_self U
  have hker : ρ.ker = ⊥ := by
    rcases hS.eq_bot_or_eq_top_of_normal ρ.ker with h | h
    · exact h
    · exfalso
      have hUfix : U ≤ fixV L := by
        intro u hu
        rw [mem_fixV]
        intro x hx
        let xL : L := ⟨x, hx⟩
        have hxker : xL ∈ ρ.ker := by rw [h]; exact Subgroup.mem_top xL
        have hρx : ρ xL = 1 := MonoidHom.mem_ker.mp hxker
        have h := congrArg (fun φ : MulAut U => ((φ ⟨u, hu⟩ : U) : W)) hρx
        rw [hρ_apply xL ⟨u, hu⟩] at h
        exact h
      have hUbot : U = ⊥ := by
        rw [eq_bot_iff]
        exact hUfix.trans (le_of_eq hfix)
      exact hUne hUbot
  have hlL' : l ≠ 1 := hl1
  have hlord : orderOf (⟨l, hlL⟩ : L) = 2 := by
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    refine orderOf_eq_prime ?_ ?_
    · apply Subtype.ext
      simpa using hl2
    · intro h
      apply hlL'
      exact congrArg Subtype.val h
  have hρl : ρ ⟨l, hlL⟩ ≠ 1 := by
    intro h
    have : (⟨l, hlL⟩ : L) ∈ ρ.ker := MonoidHom.mem_ker.mpr h
    rw [hker] at this
    have h1 : (⟨l, hlL⟩ : L) = 1 := by simpa using this
    exact hlL' (congrArg Subtype.val h1)
  have hbU : b ≤ rkIdx (fixV (Subgroup.zpowers (ρ ⟨l, hlL⟩))) :=
    hb U (fun u => Subtype.ext (by simpa using hW u.1)) ρ hirr ⟨l, hlL⟩ hlord hρl
  have hInv_l : ∀ x ∈ Subgroup.zpowers l, ∀ w ∈ U, x w ∈ U := by
    intro x hx w hw
    have hz : Subgroup.zpowers l ≤ stabSub U := Subgroup.zpowers_le.mpr (hLstab hlL)
    exact (mem_stabSub.mp (hz hx) w).2 hw
  have hlcH : l * c ∈ H := H.mul_mem (hLH hlL) hcH
  have hlc_stab : l * c ∈ stabSub U := by
    rw [mem_stabSub]
    intro u
    constructor
    · intro hu
      have hinvH : (l * c)⁻¹ ∈ H := H.inv_mem hlcH
      have h := hHU (l * c)⁻¹ hinvH ((l * c) u) hu
      simpa using h
    · exact hHU (l * c) hlcH u
  have hInv_lc : ∀ x ∈ Subgroup.zpowers (l * c), ∀ w ∈ U, x w ∈ U := by
    intro x hx w hw
    have hz : Subgroup.zpowers (l * c) ≤ stabSub U := Subgroup.zpowers_le.mpr hlc_stab
    exact (mem_stabSub.mp (hz hx) w).2 hw
  have hfix_eq : (U ⊓ fixV (Subgroup.zpowers (l * c)) : Subgroup W) =
      U ⊓ fixV (Subgroup.zpowers l) := by
    ext u
    simp only [Subgroup.mem_inf]
    constructor
    · rintro ⟨hu, hfix⟩
      refine ⟨hu, ?_⟩
      rw [mem_fixV_zpowers_iff] at hfix ⊢
      rw [MulAut.mul_apply, hc_triv u hu] at hfix
      exact hfix
    · rintro ⟨hu, hfix⟩
      refine ⟨hu, ?_⟩
      rw [mem_fixV_zpowers_iff] at hfix ⊢
      rw [MulAut.mul_apply, hc_triv u hu, hfix]
  have hcodim_eq : rk (commSub U (Subgroup.zpowers l)) =
      rk (commSub U (Subgroup.zpowers (l * c))) := by
    have h1 := rk_commSub_add_rk_inf_fixV (g := l * c) (W := U) hInv_lc
    have h2 := rk_commSub_add_rk_inf_fixV (g := l) (W := U) hInv_l
    rw [hfix_eq] at h1
    omega
  have hrk_res : rk (commV (Subgroup.zpowers (ρ ⟨l, hlL⟩))) =
      rk (commSub U (Subgroup.zpowers l)) := by
    have hres : (ρ ⟨l, hlL⟩) = resHom U ⟨l, hLstab hlL⟩ := rfl
    rw [hres]
    exact rk_commV_resHom (hLstab hlL) hInv_l
  calc
    b ≤ rkIdx (fixV (Subgroup.zpowers (ρ ⟨l, hlL⟩))) := hbU
    _ = rk (commV (Subgroup.zpowers (ρ ⟨l, hlL⟩))) := rkIdx_fixV_zpowers _
    _ = rk (commSub U (Subgroup.zpowers l)) := hrk_res
    _ = rk (commSub U (Subgroup.zpowers (l * c))) := hcodim_eq
    _ ≤ rk (commV (Subgroup.zpowers (l * c))) := by
      rw [commV_eq_commSub]
      exact rk_mono (commSub_mono le_top le_rfl)
    _ = rkIdx (fixV (Subgroup.zpowers (l * c))) := (rkIdx_fixV_zpowers _).symm

theorem le_rkIdx_of_involution {W : Type} [CommGroup W] [Finite W]
    (hW : ∀ w : W, w ^ 2 = 1) (Y L : Subgroup (MulAut W)) (hLY : L ≤ Y)
    (hN : (L.subgroupOf Y).Normal) (hS : IsSimpleGroup L)
    (hZ : Subgroup.center L = ⊥)
    (hinner : ∀ α : MulAut L, α ^ 2 = 1 → ∃ g : L, ∀ x, α x = g * x * g⁻¹)
    (hinv : ∃ l : L, orderOf l = 2) (hfix : fixV L = ⊥) (b : ℕ)
    (hb : IrredInvolutionRankBound L b) {t : Y} (ht : orderOf t = 2) :
    b ≤ rkIdx (fixV (Subgroup.zpowers (t : MulAut W))) := by
  obtain ⟨l, c, hlL, -, hcL, hl2, hc2, -, ht_eq⟩ :=
    involution_decomp_of_inner Y L hLY hN hZ hinner ht
  have ht1 : (t : MulAut W) ≠ 1 := by
    intro h
    have ht' : orderOf (t : MulAut W) = 2 := (Subgroup.orderOf_coe t).trans ht
    rw [h, orderOf_one] at ht'
    omega
  by_cases hl1 : l = 1
  · have hc1 : c ≠ 1 := by
      intro hc
      apply ht1
      rw [ht_eq, hl1, hc, mul_one]
    have h := le_rkIdx_of_centralizing_involution hW L hS hfix hinv b hb hcL hc2 hc1
    have ht_eq' : (t : MulAut W) = c := by rw [ht_eq, hl1, one_mul]
    rw [ht_eq']
    exact h
  · have h := le_rkIdx_of_involution_mul_centralizing hW L hS hfix b hb hlL hl2 hl1 hcL hc2
    rw [ht_eq]
    exact h

theorem le_mParam_of_irredInvolutionRankBound
    {W : Type} [CommGroup W] [Finite W] (hW : ∀ w : W, w ^ 2 = 1)
    (Y L : Subgroup (MulAut W)) (hLY : L ≤ Y) (hN : (L.subgroupOf Y).Normal)
    (hS : IsSimpleGroup L) (hZ : Subgroup.center L = ⊥)
    (hinner : ∀ α : MulAut L, α ^ 2 = 1 → ∃ g : L, ∀ x, α x = g * x * g⁻¹)
    (hinv : ∃ l : L, orderOf l = 2)
    (hfix : fixV L = ⊥) (b : ℕ) (hb : IrredInvolutionRankBound L b) : b ≤ E3.mParam Y := by
  have hY : Even (Nat.card Y) := even_card_of_le_of_involution hLY hinv
  have hinv' : ∃ l : L, orderOf l = 2 := hinv
  obtain ⟨l0, hl0⟩ := hinv
  let t0 : Y := ⟨(l0 : MulAut W), hLY l0.property⟩
  have ht0 : orderOf t0 = 2 := by
    rw [← Subgroup.orderOf_coe]
    simpa [t0] using hl0
  have hne : ∃ t ∈ Y, orderOf t = 2 := ⟨(t0 : MulAut W), t0.property, by simpa using ht0⟩
  refine le_mParam_of_forall_involutions Y b hY hne ?_
  intro t htY ht2
  let tY : Y := ⟨t, htY⟩
  have htY2 : orderOf tY = 2 := by
    rw [← Subgroup.orderOf_coe]
    simpa [tY] using ht2
  simpa using le_rkIdx_of_involution hW Y L hLY hN hS hZ hinner hinv' hfix b hb htY2

