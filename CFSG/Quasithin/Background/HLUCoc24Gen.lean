@[expose] def lab (x : Fin 24) : Fin 3 := ⟨labL.getD x 0 % 3, Nat.mod_lt _ (by norm_num)⟩

@[expose] def twWord (i : ℕ) : List ℕ := [[], [0], [0, 0], [1], [0, 1], [0, 0, 1]].getD i []

theorem t_ok : InvPairOK 24 t3Arr t3Inv = true ∧ InvPairOK 24 t2Arr t2Inv = true ∧
    autArrOK t3Arr t3Inv = true ∧ autArrOK t2Arr t2Inv = true := by
  decide +kernel

theorem t_pres : ∀ m < 2 ^ 11, m ∈ uTMasks → act11 t3Arr m ∈ uTMasks ∧ act11 t3Inv m ∈ uTMasks ∧
    act11 t2Arr m ∈ uTMasks ∧ act11 t2Inv m ∈ uTMasks := by
  decide +kernel

theorem tr_lab : ∀ x : Fin 24, labL.getD trAArr[(x : ℕ)]! 0 = labL.getD x 0 ∧
    labL.getD trBArr[(x : ℕ)]! 0 = labL.getD x 0 := by
  decide +kernel

theorem t_lab : ∀ x y : Fin 24,
    (labL.getD t3Arr[(x : ℕ)]! 0 = labL.getD t3Arr[(y : ℕ)]! 0 ↔ labL.getD x 0 = labL.getD y 0) ∧
    (labL.getD t2Arr[(x : ℕ)]! 0 = labL.getD t2Arr[(y : ℕ)]! 0 ↔
      labL.getD x 0 = labL.getD y 0) := by
  decide +kernel

theorem labL_lt : ∀ x : Fin 24, labL.getD x 0 < 3 := by
  decide +kernel

theorem tw_lab : ∀ i j : Fin 6,
    (∀ x : Fin 24, labL.getD (wArr [t3Arr, t2Arr] (twWord i))[(x : ℕ)]! 0 =
      labL.getD (wArr [t3Arr, t2Arr] (twWord j))[(x : ℕ)]! 0) → i = j := by
  decide +kernel

theorem kt_ok : ∀ i < 6, matOf 11 (act11 (wArr [trAArr, trBArr] (ktWord i))) = ktCols i ∧
    ∀ m ∈ combos uTBasis, act11 (wArr [trAArr, trBArr] (ktWord i)) m = m := by
  decide +kernel

@[expose] def ktAct (g m : ℕ) : ℕ := actM (ktCols (g % 6)) m

theorem ktTree_ok : treeB ktAct ktTree (1 <<< 1) = true := by
  decide +kernel

theorem ktTree_length : ktTree.length = 63 := by
  decide +kernel

theorem ktCols_lt : ∀ i < 6, ∀ c ∈ ktCols i, c < 2 ^ 11 := by
  decide +kernel

theorem trCols_eq : matOf 11 (act11 trAArr) = trACols ∧ matOf 11 (act11 trBArr) = trBCols := by
  decide +kernel

theorem trCols_lt : ∀ c ∈ trACols ++ trBCols, c < 2 ^ 11 := by
  decide +kernel

theorem trD_ok : ∀ m ∈ uTMasks, actM uTBasis (actM trD m) = m ∧ actM trD m < 2 ^ 3 := by
  decide +kernel

theorem trStart : uTBasis.foldr (fun u acc => actM trD u + 2 ^ 3 * acc) 0 = 273 := by
  decide +kernel

@[expose] def trAct (g k : ℕ) : ℕ := tupAct 3 trD uTBasis (if g = 0 then trACols else trBCols) 3 k

theorem trTree_ok : treeB trAct trTree (1 <<< 273) = true := by
  decide +kernel

theorem trTree_length : trTree.length = 167 := by
  decide +kernel

