@[expose] def pR (q : ℕ) : ℕ := Nat.land q 281474976710655

@[expose] def tR (q : ℕ) : ℕ := Nat.shiftRight q 48

theorem evenTot_map : (evenTot.map pR == evenCodes6) = true := by decide +kernel

theorem check_tot : allK (fun q => Nat.beq (totK (lo6 (pR q))) (tR q)) evenTot = true := by
  decide +kernel

theorem exists_tot (σ : Perm (Fin 6)) (hs : Perm.sign σ = 1) :
    ∃ q ∈ evenTot, pR q = pc6 σ ∧ tR q = totK (enc σ) := by
  have hm := memK_iff.1 (pc6_mem_even σ hs)
  rw [← eq_of_beq evenTot_map] at hm
  obtain ⟨q, hq, hp⟩ := List.mem_map.1 hm
  refine ⟨q, hq, hp, ?_⟩
  have h := allK_iff.1 check_tot q hq
  rw [Nat.beq_eq, hp, lo6_pc6] at h
  exact h.symm

theorem sign_swap2 (a b c d : Fin 6) (h1 : a ≠ b) (h2 : c ≠ d) :
    Perm.sign (swap a b * swap c d) = 1 := by
  rw [Perm.sign_mul, Perm.sign_swap h1, Perm.sign_swap h2, Int.units_mul_self]

theorem sign_swap4 (a b c d e f g h : Fin 6) (h1 : a ≠ b) (h2 : c ≠ d) (h3 : e ≠ f) (h4 : g ≠ h) :
    Perm.sign (swap a b * swap c d * swap e f * swap g h) = 1 := by
  rw [Perm.sign_mul, Perm.sign_mul, sign_swap2 a b c d h1 h2, one_mul, Perm.sign_swap h3,
    Perm.sign_swap h4, Int.units_mul_self]

