@[expose] def hexW (c : ℕ) : List ℕ :=
  (List.range 6).map fun j =>
    ((List.range 6).filter fun i => c.testBit i).foldl (fun a i => a ^^^ (ksWord i).getD j 0) 0

@[expose] def ksC (c : ℕ) : Array ℕ :=
  ((List.range 24).map fun p => (p % 4 ^^^ (hexW c).getD (p / 4) 0) + 4 * (p / 4)).toArray

theorem ksC_ok : ∀ c < 64,
    InvPairOK 24 (ksC c) (ksC c) = true ∧ autArrOK (ksC c) (ksC c) = true := by
  decide +kernel

theorem ksC_mul : ∀ c < 64, ∀ i < 6, cArr (ksArr i) (ksC c) = ksC (c ^^^ 2 ^ i) := by
  have hK : ∀ c < 64, ksC c = Coc24Pack.dec (Coc24Pack.KT c) := Coc24Pack.ksC_dec
  have h : ∀ c < 64, ∀ i < 6, Nat.beq (Coc24Pack.cK (Coc24Pack.KA i) (Coc24Pack.KT c))
      (Coc24Pack.KT (c ^^^ 2 ^ i)) = true := by
    decide +kernel
  intro c hc i hi
  rw [Coc24Pack.ksArr_dec i hi, hK c hc, hK _ (Coc24Pack.xor_pow_lt hc hi), Coc24Pack.cArr_dec]
  exact Coc24Pack.dec_inj (Nat.eq_of_beq_eq_true (h c hc i hi))

theorem ksC_mulR : ∀ c < 64, ∀ i < 6, cArr (ksC c) (ksArr i) = ksC (c ^^^ 2 ^ i) := by
  have hK : ∀ c < 64, ksC c = Coc24Pack.dec (Coc24Pack.KT c) := Coc24Pack.ksC_dec
  have h : ∀ c < 64, ∀ i < 6, Nat.beq (Coc24Pack.cK (Coc24Pack.KT c) (Coc24Pack.KA i))
      (Coc24Pack.KT (c ^^^ 2 ^ i)) = true := by
    decide +kernel
  intro c hc i hi
  rw [Coc24Pack.ksArr_dec i hi, hK c hc, hK _ (Coc24Pack.xor_pow_lt hc hi), Coc24Pack.cArr_dec]
  exact Coc24Pack.dec_inj (Nat.eq_of_beq_eq_true (h c hc i hi))

