theorem ksC_word : ∀ c < 64,
    wArr ((List.range 6).map ksArr) ((List.range 6).filter fun i => c.testBit i) = ksC c := by
  have hK : ∀ c < 64, ksC c = Coc24Pack.dec (Coc24Pack.KT c) := Coc24Pack.ksC_dec
  have hl : (List.range 6).map ksArr = ((List.range 6).map Coc24Pack.KA).map Coc24Pack.dec := by
    rw [List.map_map]
    apply List.map_congr_left
    intro i hi
    exact Coc24Pack.ksArr_dec i (List.mem_range.1 hi)
  have h : ∀ c < 64, Nat.beq (Coc24Pack.wK ((List.range 6).map Coc24Pack.KA)
      ((List.range 6).filter fun i => c.testBit i)) (Coc24Pack.KT c) = true := by
    decide +kernel
  intro c hc
  rw [hl, Coc24Pack.wArr_dec, hK c hc]
  exact Coc24Pack.dec_inj (Nat.eq_of_beq_eq_true (h c hc))

