theorem ksWordC_ok : ∀ c < 64, wArr [lzXArr, lzYArr] (ksWordC c) = ksC c := by
  have hK : ∀ c < 64, ksC c = Coc24Pack.dec (Coc24Pack.KT c) := Coc24Pack.ksC_dec
  have hx : lzXArr = Coc24Pack.dec Coc24Pack.xK := by
    unfold Coc24Pack.dec
    decide +kernel
  have hy : lzYArr = Coc24Pack.dec Coc24Pack.yK := by
    unfold Coc24Pack.dec
    decide +kernel
  have hl : [Coc24Pack.dec Coc24Pack.xK, Coc24Pack.dec Coc24Pack.yK] =
      [Coc24Pack.xK, Coc24Pack.yK].map Coc24Pack.dec := rfl
  have h : ∀ c < 64,
      Nat.beq (Coc24Pack.wK [Coc24Pack.xK, Coc24Pack.yK] (ksWordC c)) (Coc24Pack.KT c) = true := by
    decide +kernel
  intro c hc
  rw [hx, hy, hl, Coc24Pack.wArr_dec, hK c hc]
  exact Coc24Pack.dec_inj (Nat.eq_of_beq_eq_true (h c hc))

@[expose] def mxCols : List ℕ := [27, 45, 30, 39, 21, 42]

@[expose] def myCols : List ℕ := [21, 42, 19, 33, 18, 35]

theorem ksC_conj : ∀ c < 64, cArr lzXArr (cArr (ksC c) lzXInv) = ksC (actM mxCols c) ∧
    cArr lzYArr (cArr (ksC c) lzYInv) = ksC (actM myCols c) := by
  have hK : ∀ c < 64, ksC c = Coc24Pack.dec (Coc24Pack.KT c) := Coc24Pack.ksC_dec
  have hx : lzXArr = Coc24Pack.dec Coc24Pack.xK := by
    unfold Coc24Pack.dec
    decide +kernel
  have hxi : lzXInv = Coc24Pack.dec Coc24Pack.xiK := by
    unfold Coc24Pack.dec
    decide +kernel
  have hy : lzYArr = Coc24Pack.dec Coc24Pack.yK := by
    unfold Coc24Pack.dec
    decide +kernel
  have hyi : lzYInv = Coc24Pack.dec Coc24Pack.yiK := by
    unfold Coc24Pack.dec
    decide +kernel
  have hb : ∀ c < 64, actM mxCols c < 64 ∧ actM myCols c < 64 := by
    decide +kernel
  have h : ∀ c < 64,
      Nat.beq (Coc24Pack.cK Coc24Pack.xK (Coc24Pack.cK (Coc24Pack.KT c) Coc24Pack.xiK))
        (Coc24Pack.KT (actM mxCols c)) = true ∧
      Nat.beq (Coc24Pack.cK Coc24Pack.yK (Coc24Pack.cK (Coc24Pack.KT c) Coc24Pack.yiK))
        (Coc24Pack.KT (actM myCols c)) = true := by
    decide +kernel
  intro c hc
  rw [hx, hxi, hy, hyi, hK c hc, hK _ (hb c hc).1, hK _ (hb c hc).2]
  simp only [Coc24Pack.cArr_dec]
  exact ⟨Coc24Pack.dec_inj (Nat.eq_of_beq_eq_true (h c hc).1),
    Coc24Pack.dec_inj (Nat.eq_of_beq_eq_true (h c hc).2)⟩

