@[expose] def pAArr : Array ℕ :=
  #[3, 4, 20, 0, 1, 13, 18, 11, 19, 16, 23, 7, 14, 5, 12, 22, 9, 21, 6, 8, 2, 17, 15, 10]

@[expose] def pBArr : Array ℕ :=
  #[3, 9, 6, 18, 4, 5, 13, 22, 8, 14, 10, 23, 15, 2, 1, 20, 16, 7, 0, 11, 12, 21, 17, 19]

theorem hasArr_pA : HasArr bridgePA pAArr := fun i => by
  rw [bridgePA_image]
  revert i
  decide

theorem hasArr_pB : HasArr bridgePB pBArr := fun i => by
  rw [bridgePB_image]
  revert i
  decide

@[expose] def lzXArr : Array ℕ :=
  #[15, 14, 13, 12, 23, 21, 20, 22, 19, 16, 18, 17, 0, 1, 2, 3, 4, 6, 7, 5, 11, 8, 10, 9]

@[expose] def lzXInv : Array ℕ :=
  #[12, 13, 14, 15, 16, 19, 17, 18, 21, 23, 22, 20, 3, 2, 1, 0, 9, 11, 10, 8, 6, 5, 7, 4]

@[expose] def lzYArr : Array ℕ :=
  #[16, 17, 18, 19, 20, 21, 22, 23, 7, 6, 5, 4, 3, 2, 1, 0, 15, 14, 13, 12, 11, 10, 9, 8]

@[expose] def lzYInv : Array ℕ :=
  #[15, 14, 13, 12, 11, 10, 9, 8, 23, 22, 21, 20, 19, 18, 17, 16, 0, 1, 2, 3, 4, 5, 6, 7]

theorem lz_ok : InvPairOK 24 lzXArr lzXInv = true ∧ InvPairOK 24 lzYArr lzYInv = true ∧
    autArrOK lzXArr lzXInv = true ∧ autArrOK lzYArr lzYInv = true := by
  decide +kernel

theorem lz_fix : act11 lzXArr 31 = 31 ∧ act11 lzYArr 31 = 31 := by
  decide +kernel

@[expose] def orbAct (g m : ℕ) : ℕ := act11 (if g = 0 then pAArr else pBArr) m

