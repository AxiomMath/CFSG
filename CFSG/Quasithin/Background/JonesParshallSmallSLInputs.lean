@[expose] def cocycle3 (g : SpecialLinearGroup (Fin 3) (ZMod 2)) : Fin 3 → ZMod 2 :=
  fun c => if (magic3 c).testBit (code3 (g : Matrix (Fin 3) (Fin 3) (ZMod 2))) then 1 else 0

