@[expose] def q16Arr (t : ℕ) : Array ℕ := q16Data.getD t idArr

theorem q16_inv : ∀ t < 16, InvPairOK 24 (q16Arr t) (q16Arr t) = true := by
  decide +kernel

theorem q16_mul : ∀ s < 16, ∀ t < 16, cArr (q16Arr s) (q16Arr t) = q16Arr (s ^^^ t) := by
  have hq := Code22Pack.getD_dec (D := q16Data) (T := Code22Pack.q16T) (n := 16) (by decide +kernel)
  have h : ∀ s < 16, ∀ t < 16, Nat.beq (Coc24Pack.cK (Code22Pack.lane120 Code22Pack.q16T s)
      (Code22Pack.lane120 Code22Pack.q16T t)) (Code22Pack.lane120 Code22Pack.q16T (s ^^^ t)) =
      true := by
    decide +kernel
  intro s hs t ht
  unfold q16Arr
  rw [hq s hs, hq t ht, hq _ (Nat.xor_lt_two_pow (n := 4) hs ht), Coc24Pack.cArr_dec]
  exact Coc24Pack.dec_inj (Nat.eq_of_beq_eq_true (h s hs t ht))

theorem q16_sep : ∀ s < 16, ∀ t < 16, s ≠ t → ∃ k < 24, (q16Arr s)[k]! ≠ (q16Arr t)[k]! := by
  decide +kernel

theorem q16_bits : ∀ t < 16, wArr q16Basis ((List.range 4).filter fun i => t.testBit i) =
    q16Arr t := by
  decide +kernel

theorem q16_basis : ∀ i < 4, q16Arr (2 ^ i) = q16Basis.getD i idArr := by
  decide +kernel

