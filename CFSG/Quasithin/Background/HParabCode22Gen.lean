theorem s1_mulR : ∀ i < 64, ∀ g < 6, (s1Tab.getD i []).getD g 0 < 64 ∧
    cArr (s1Arr i) (s1Gens.getD g idArr) = s1Arr ((s1Tab.getD i []).getD g 0) := by
  have hs := Code22Pack.getD_dec (D := s1Data) (T := Code22Pack.s1T) (n := 64) (by decide +kernel)
  have hg := Code22Pack.getD_dec (D := s1Gens) (T := Code22Pack.genT) (n := 6) (by decide +kernel)
  have h1 : ∀ i < 64, ∀ g < 6, (s1Tab.getD i []).getD g 0 < 64 := by
    decide +kernel
  have h2 : ∀ i < 64, ∀ g < 6, Nat.beq (Coc24Pack.cK (Code22Pack.lane120 Code22Pack.s1T i)
      (Code22Pack.lane120 Code22Pack.genT g))
      (Code22Pack.lane120 Code22Pack.s1T ((s1Tab.getD i []).getD g 0)) = true := by
    decide +kernel
  intro i hi g hg'
  refine ⟨h1 i hi g hg', ?_⟩
  unfold s1Arr
  rw [hs i hi, hg g hg', hs _ (h1 i hi g hg'), Coc24Pack.cArr_dec]
  exact Coc24Pack.dec_inj (Nat.eq_of_beq_eq_true (h2 i hi g hg'))

