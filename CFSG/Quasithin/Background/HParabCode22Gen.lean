theorem q16_words : ∀ t < 16, wArr [hbAArr, hbBArr] (q16Words.getD t []) = q16Arr t := by
  have hq := Code22Pack.getD_dec (D := q16Data) (T := Code22Pack.q16T) (n := 16) (by decide +kernel)
  have hab : [hbAArr, hbBArr] = [Coc24Pack.dec Code22Pack.hbAK, Coc24Pack.dec Code22Pack.hbBK] := by
    unfold Coc24Pack.dec
    decide +kernel
  have hm : [Coc24Pack.dec Code22Pack.hbAK, Coc24Pack.dec Code22Pack.hbBK] =
      [Code22Pack.hbAK, Code22Pack.hbBK].map Coc24Pack.dec := rfl
  have h : ∀ t < 16, Nat.beq (Coc24Pack.wK [Code22Pack.hbAK, Code22Pack.hbBK] (q16Words.getD t []))
      (Code22Pack.lane120 Code22Pack.q16T t) = true := by
    decide +kernel
  intro t ht
  unfold q16Arr
  rw [hab, hm, Coc24Pack.wArr_dec, hq t ht]
  exact Coc24Pack.dec_inj (Nat.eq_of_beq_eq_true (h t ht))

