theorem s1ConjData_ok : ∀ i < 48,
    s1ConjData.getD i idArr = cArr hbBInv (cArr (s1Arr (16 + i)) hbBArr) := by
  have hc := Code22Pack.getD_dec (D := s1ConjData) (T := Code22Pack.scT) (n := 48)
    (by decide +kernel)
  have hs := Code22Pack.getD_dec (D := s1Data) (T := Code22Pack.s1T) (n := 64) (by decide +kernel)
  have hb : hbBArr = Coc24Pack.dec Code22Pack.hbBK ∧ hbBInv = Coc24Pack.dec Code22Pack.hbBiK := by
    unfold Coc24Pack.dec
    decide +kernel
  have h : ∀ i < 48, Nat.beq (Code22Pack.lane120 Code22Pack.scT i)
      (Coc24Pack.cK Code22Pack.hbBiK
        (Coc24Pack.cK (Code22Pack.lane120 Code22Pack.s1T (16 + i)) Code22Pack.hbBK)) = true := by
    decide +kernel
  intro i hi
  unfold s1Arr
  rw [hc i hi, hs _ (by omega), hb.1, hb.2, Coc24Pack.cArr_dec, Coc24Pack.cArr_dec]
  exact Coc24Pack.dec_inj (Nat.eq_of_beq_eq_true (h i hi))

