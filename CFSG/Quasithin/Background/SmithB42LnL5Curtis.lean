@[expose] def ctabT20 : Fin 6 → Fin 20 → Fin 20 → Fin 120 :=
  ![ctab20_0, ctab20_1, ctab20_2, ctab20_3, ctab20_4, ctab20_5]

set_option maxRecDepth 100000 in
theorem pair_spec20 : ∀ (p : Fin 6) (i j : Fin 20),
    bmul (bword (canW (repsT20 p i)).reverse) (bword (canW (repsT20 p j))) =
      bword (canW (ctabT20 p i j)) ∧ (i = j → ctabT20 p i j = 0) ∧
      (i ≠ j → pairA p ∈ canW (ctabT20 p i j) ∨ pairB p ∈ canW (ctabT20 p i j)) := by
  decide +kernel

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

theorem twenty_le_finrank
    {ρ : Representation (ZMod 2) G5 V} (hρ : IsSimpleRep ρ) [Finite V]
    {y : V} (hy : y ∈ fixU ρ) (hy0 : y ≠ 0) (p : Fin 6) (ha : Th ρ (pairA p) y ≠ 0)
    (hb : Th ρ (pairB p) y ≠ 0) : 20 ≤ Module.finrank (ZMod 2) V := by
  refine card_le_finrank hρ hy hy0 (repsT20 p) (ctabT20 p)
    (fun i j => wE_inv_mul (pair_spec20 p i j).1) (fun i => (pair_spec20 p i i).2.1 rfl)
    (fun i j hij => ?_)
  rcases (pair_spec20 p i j).2.2 hij with h | h
  · exact ⟨_, h, ha⟩
  · exact ⟨_, h, hb⟩

theorem twenty_le_finrank'
    {ρ : Representation (ZMod 2) G5 V} (hρ : IsSimpleRep ρ) [Finite V]
    {y : V} (hy : y ∈ fixU ρ) (hy0 : y ≠ 0) {s t : Fin 4} (hst : s ≠ t)
    (hs : Th ρ s y ≠ 0) (ht : Th ρ t y ≠ 0) : 20 ≤ Module.finrank (ZMod 2) V := by
  rcases lt_or_gt_of_ne hst with h | h
  · obtain ⟨p, rfl, rfl⟩ := pair_exists s t h
    exact twenty_le_finrank hρ hy hy0 p hs ht
  · obtain ⟨p, rfl, rfl⟩ := pair_exists t s h
    exact twenty_le_finrank hρ hy hy0 p ht hs

@[expose] def L5Model (ρ : Representation (ZMod 2) G5 V) : Prop :=
  (∀ g w, ρ g w = w) ∨
    (∃ κ : G5 ≃* G5, ∃ β : V ≃ₗ[ZMod 2] (Fin 5 → ZMod 2), ∀ g w, β (ρ g w) = natRep (κ g) (β w)) ∨
    (∃ κ : G5 ≃* G5, ∃ β : V ≃ₗ[ZMod 2] (Fin 10 → ZMod 2),
      ∀ g w, β (ρ g w) = wedgeRep (κ g) (β w))

theorem l5Model_of_unique
    {ρ : Representation (ZMod 2) G5 V} (hρ : IsSimpleRep ρ) [Finite V] {y : V}
    (hy : y ∈ fixU ρ) (hy0 : y ≠ 0)
    (hu : ∀ s t : Fin 4, s ≠ t → Th ρ s y = 0 ∨ Th ρ t y = 0) : L5Model ρ := by
  by_cases hall : ∀ s, Th ρ s y = 0
  · left
    obtain ⟨β, hβ⟩ := iso_of_type hρ triv_simple hy hy0 (triv_fixU 1) one_ne_zero
      fun s => iff_of_true (hall s) (triv_type s)
    intro g w
    apply β.injective
    rw [hβ, Representation.trivial_apply]
  · right
    push Not at hall
    obtain ⟨s, hs⟩ := hall
    have hother : ∀ t, t ≠ s → Th ρ t y = 0 := fun t hts =>
      (hu s t (Ne.symm hts)).resolve_left hs
    have hJ := type_of_unique hs hother
    rcases (by decide : ∀ s : Fin 4, s = 0 ∨ s = 1 ∨ s = 2 ∨ s = 3) s with rfl | rfl | rfl | rfl
    · left
      obtain ⟨β, hβ⟩ := iso_of_type hρ natRep_simple hy hy0 e0_mem_fixU e0_ne
        fun t => (hJ t).trans (natRep_type t).symm
      exact ⟨MulEquiv.refl _, β, hβ⟩
    · right
      obtain ⟨β, hβ⟩ := iso_of_type hρ wedge_simple hy hy0 e01_mem_fixU e01_ne
        fun t => (hJ t).trans (wedge_type t).symm
      exact ⟨MulEquiv.refl _, β, hβ⟩
    · right
      obtain ⟨β, hβ⟩ := iso_of_type hρ wedgeTw_simple hy hy0 e01_mem_fixU_tw e01_ne
        fun t => (hJ t).trans (wedgeTw_type t).symm
      exact ⟨twistα, β, fun g v => (hβ g v).trans (wedgeTw_apply g (β v))⟩
    · left
      obtain ⟨β, hβ⟩ := iso_of_type hρ natTw_simple hy hy0 e0_mem_fixU_tw e0_ne
        fun t => (hJ t).trans (natTw_type t).symm
      exact ⟨twistα, β, hβ⟩

theorem l5Model_of_finrank_le
    {ρ : Representation (ZMod 2) G5 V} (hρ : IsSimpleRep ρ) [Finite V]
    (hdim : Module.finrank (ZMod 2) V ≤ 19) : L5Model ρ := by
  have := hρ.1
  obtain ⟨y, hy, hy0⟩ := exists_fixU_ne ρ
  refine l5Model_of_unique hρ hy hy0 fun s t hst => ?_
  by_contra h
  push Not at h
  have := twenty_le_finrank' hρ hy hy0 hst h.1 h.2
  omega

theorem l5Model_of_parabolic
    {ρ : Representation (ZMod 2) G5 V} (hρ : IsSimpleRep ρ) [Finite V] (k : Fin 4) {x : V}
    (hx0 : x ≠ 0) (hxU : x ∈ fixU ρ) (hxs : ∀ t, t ≠ k → ρ (sE t) x = x) : L5Model ρ := by
  have := hρ.1
  obtain ⟨y, hy, hy0, heig⟩ := exists_eigen ρ
  have hxy : x = y := (fixU_eq hρ hy hy0 heig hxU).resolve_left hx0
  subst hxy
  refine l5Model_of_unique hρ hy hy0 fun s t hst => ?_
  by_cases hs : s = k
  · subst hs
    exact Or.inr ((Th_eq_zero_iff ρ t hy).2 (hxs t (Ne.symm hst)))
  · exact Or.inl ((Th_eq_zero_iff ρ s hy).2 (hxs s hs))

