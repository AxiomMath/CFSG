@[expose] def ctabT : Fin 6 → Fin 11 → Fin 11 → Fin 120 :=
  ![ctab0, ctab1, ctab2, ctab3, ctab4, ctab5]

theorem pair_spec : ∀ (p : Fin 6) (i j : Fin 11),
    bmul (bword (canW (repsT p i)).reverse) (bword (canW (repsT p j))) =
      bword (canW (ctabT p i j)) ∧ (i = j → ctabT p i j = 0) ∧
      (i ≠ j → pairA p ∈ canW (ctabT p i j) ∨ pairB p ∈ canW (ctabT p i j)) := by
  decide +kernel

theorem pair_exists : ∀ s t : Fin 4, s < t → ∃ p : Fin 6, pairA p = s ∧ pairB p = t := by
  decide

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

theorem eleven_le_finrank
    {ρ : Representation (ZMod 2) G5 V} (hρ : IsSimpleRep ρ) [Finite V]
    {y : V} (hy : y ∈ fixU ρ) (hy0 : y ≠ 0) (p : Fin 6) (ha : Th ρ (pairA p) y ≠ 0)
    (hb : Th ρ (pairB p) y ≠ 0) : 11 ≤ Module.finrank (ZMod 2) V := by
  refine card_le_finrank hρ hy hy0 (repsT p) (ctabT p)
    (fun i j => wE_inv_mul (pair_spec p i j).1) (fun i => (pair_spec p i i).2.1 rfl)
    (fun i j hij => ?_)
  rcases (pair_spec p i j).2.2 hij with h | h
  · exact ⟨_, h, ha⟩
  · exact ⟨_, h, hb⟩

theorem eleven_le_finrank'
    {ρ : Representation (ZMod 2) G5 V} (hρ : IsSimpleRep ρ) [Finite V]
    {y : V} (hy : y ∈ fixU ρ) (hy0 : y ≠ 0) {s t : Fin 4} (hst : s ≠ t)
    (hs : Th ρ s y ≠ 0) (ht : Th ρ t y ≠ 0) : 11 ≤ Module.finrank (ZMod 2) V := by
  rcases lt_or_gt_of_ne hst with h | h
  · obtain ⟨p, rfl, rfl⟩ := pair_exists s t h
    exact eleven_le_finrank hρ hy hy0 p hs ht
  · obtain ⟨p, rfl, rfl⟩ := pair_exists t s h
    exact eleven_le_finrank hρ hy hy0 p ht hs

