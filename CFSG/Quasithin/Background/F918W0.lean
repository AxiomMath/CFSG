@[expose] def kapply (a v : Nat) : Nat :=
  Nat.lor (Nat.lor
    (Nat.xor (Nat.xor (fmul (kent a 0) (kent v 0)) (fmul (kent a 2) (kent v 2))) (fmul (kent a 4) (kent v 4)))
    (Nat.shiftLeft (Nat.xor (Nat.xor (fmul (kent a 6) (kent v 0)) (fmul (kent a 8) (kent v 2)))
      (fmul (kent a 10) (kent v 4))) 2))
    (Nat.shiftLeft (Nat.xor (Nat.xor (fmul (kent a 12) (kent v 0)) (fmul (kent a 14) (kent v 2)))
      (fmul (kent a 16) (kent v 4))) 4)

@[expose] def listEqN : List Nat → List Nat → Bool
  | [], [] => true
  | a :: as, b :: bs => Nat.beq a b && listEqN as bs
  | _, _ => false

@[expose] def listEqP : List (Nat × Nat) → List (Nat × Nat) → Bool
  | [], [] => true
  | a :: as, b :: bs => Nat.beq a.1 b.1 && Nat.beq a.2 b.2 && listEqP as bs
  | _, _ => false

@[expose] def listEqT : List (Nat × Nat × Nat) → List (Nat × Nat × Nat) → Bool
  | [], [] => true
  | a :: as, b :: bs => Nat.beq a.1 b.1 && Nat.beq a.2.1 b.2.1 && Nat.beq a.2.2 b.2.2 && listEqT as bs
  | _, _ => false

@[expose] def entryB (e : Nat × Nat × Nat) : Bool :=
  Nat.blt e.2.1 262144 && Nat.blt e.2.2 262144 && Nat.beq (kmul e.1 e.2.1) (kmul e.2.1 u0) &&
    Nat.beq (kmul e.2.1 e.2.2) kid

@[expose] def chkB : Bool := listEqN tList (btab.map fun e => e.1) && btab.all entryB

@[expose] def sList : List Nat :=
  tList.filter fun x => !(Nat.beq x u0) && isScalK (kpow3 (kmul u0 x))

@[expose] def condP (x2 x3 : Nat) : Bool :=
  !(Nat.beq x2 x3) && isScalK (kpow4 (kmul x2 x3)) && isScalK (kpow5 (kmul (kmul u0 x2) x3))

@[expose] def pairList : List (Nat × Nat) :=
  sList.flatMap fun x2 => (sList.filter fun x3 => condP x2 x3).map fun x3 => (x2, x3)

@[expose] def refA (s : Nat) : Nat := if Nat.beq s 0 then a0 else b0

@[expose] def refB (s : Nat) : Nat := if Nat.beq s 0 then b0 else a0

@[expose] def entryP (e : Nat × Nat × Nat × Nat × Nat) : Bool :=
  Nat.blt e.2.2.1 2 && Nat.blt e.2.2.2.1 68719476736 && Nat.blt e.2.2.2.2 68719476736 &&
    Nat.beq (bmul e.2.2.2.1 (expand u0)) (bmul (expand u0) e.2.2.2.1) &&
    Nat.beq (bmul e.2.2.2.1 (expand e.1)) (bmul (expand (refA e.2.2.1)) e.2.2.2.1) &&
    Nat.beq (bmul e.2.2.2.1 (expand e.2.1)) (bmul (expand (refB e.2.2.1)) e.2.2.2.1) &&
    Nat.beq (bmul e.2.2.2.1 e.2.2.2.2) idm

@[expose] def chkP : Bool := listEqP pairList (ptab.map fun e => (e.1, e.2.1)) && ptab.all entryP

@[expose] def bitSet (s e : Nat) : Bool := Nat.beq (Nat.land (Nat.shiftRight s e) 1) 1

@[expose] def goG : Nat → List (Nat × Nat × Nat) → Option Nat
  | vis, [] => some vis
  | vis, e :: rest =>
    if bitSet vis e.2.1 && !(bitSet vis e.1) && Nat.blt e.1 262144 && Nat.blt e.2.2 3 &&
        Nat.beq (kmul e.2.1 (genK e.2.2)) e.1
    then goG (Nat.lor vis (Nat.shiftLeft 1 e.1)) rest else none

@[expose] def gl : List Nat := kid :: gdata.map fun e => e.1

@[expose] def glMask : Nat := (goG (Nat.shiftLeft 1 kid) gdata).getD 0

@[expose] def chkG : Bool :=
  (goG (Nat.shiftLeft 1 kid) gdata).isSome && Nat.beq gl.length 1080 &&
    bitSet glMask u0 && bitSet glMask a0 && bitSet glMask b0 &&
    gl.all fun g => [0, 1, 2].all fun i => bitSet glMask (kmul g (genK i))

@[expose] def comm (a b : Nat) : Bool := Nat.beq (kmul a b) (kmul b a)

@[expose] def chkZ : Bool :=
  bitSet glMask kid && bitSet glMask kom && bitSet glMask kom2 &&
    [kom, kom2].all (fun s => [u0, a0, b0].all fun r => comm s r) &&
    gl.all fun g => !(comm g u0 && comm g a0 && comm g b0) || isScalK g

@[expose] def fixMask (a : Nat) : Nat :=
  (List.range 64).foldl (fun m v => if Nat.beq (kapply a v) v then Nat.lor m (Nat.shiftLeft 1 v) else m) 0

@[expose] def popc (m : Nat) : Nat := (List.range 64).foldl (fun c i => Nat.add c (bit m i)) 0

@[expose] def invList : List Nat := gl.filter fun g => !(Nat.beq g kid) && Nat.beq (kmul g g) kid

@[expose] def offPairs : List (Nat × Nat) :=
  invList.flatMap fun a =>
    (invList.filter fun b =>
      !(Nat.beq a b) && comm a b && Nat.ble 16 (popc (Nat.land (fixMask a) (fixMask b)))).map fun b => (a, b)

@[expose] def chkO1 : Bool := invList.all fun a => Nat.blt (Nat.mul 2 (popc (fixMask a))) 64

@[expose] def chkO2 : Bool :=
  invList.all fun a => invList.all fun b =>
    (!(!(Nat.beq a b) && comm a b)) ||
      invList.all fun c =>
        (!(comm a c && comm b c)) || Nat.beq c a || Nat.beq c b || Nat.beq c (kmul a b)

@[expose] def e1 : Nat := a0

@[expose] def e2 : Nat := kmul (kmul b0 a0) b0

@[expose] def memF (a b x : Nat) : Bool := Nat.beq x a || Nat.beq x b || Nat.beq x (kmul a b)

@[expose] def entryC (e : Nat × Nat × Nat × Nat) : Bool :=
  bitSet glMask e.2.2.1 && bitSet glMask e.2.2.2 && Nat.beq (kmul e.2.2.1 e.2.2.2) kid &&
    memF e.1 e.2.1 (kmul (kmul e.2.2.1 e1) e.2.2.2) && memF e.1 e.2.1 (kmul (kmul e.2.2.1 e2) e.2.2.2) &&
    !(Nat.beq (kmul (kmul e.2.2.1 e1) e.2.2.2) (kmul (kmul e.2.2.1 e2) e.2.2.2))

@[expose] def chkC : Bool :=
  listEqP offPairs (ctab.map fun e => (e.1, e.2.1)) && ctab.all entryC &&
    offPairs.any fun p => Nat.beq p.1 e1 && Nat.beq p.2 e2

@[expose] def rel12 (x1 x2 : Nat) : Bool := isScalK (kpow3 (kmul x1 x2))

@[expose] def rel23 (x2 x3 : Nat) : Bool := isScalK (kpow4 (kmul x2 x3))

@[expose] def rel123 (x1 x2 x3 : Nat) : Bool := isScalK (kpow5 (kmul (kmul x1 x2) x3))

@[expose] def neigh (x1 : Nat) : List Nat := invList.filter fun x => !(Nat.beq x x1) && rel12 x1 x

@[expose] def tripleList : List (Nat × Nat × Nat) :=
  invList.flatMap fun x1 =>
    (neigh x1).flatMap fun x2 =>
      ((neigh x1).filter fun x3 => !(Nat.beq x3 x2) && rel23 x2 x3 && rel123 x1 x2 x3).map fun x3 => (x1, x2, x3)

@[expose] def offTriples : List (Nat × Nat × Nat) := offPairs.map fun p => (p.1, p.2, kmul p.1 p.2)

@[expose] def memT (t : Nat × Nat × Nat) (x : Nat) : Bool := Nat.beq x t.1 || Nat.beq x t.2.1 || Nat.beq x t.2.2

@[expose] def classPres (x2 y : Nat) : Bool := offTriples.any fun t => memT t x2 && memT t y

@[expose] def presList : List (Nat × Nat × Nat) :=
  tripleList.filter fun t => classPres t.2.1 (kmul (kmul t.2.2 t.2.1) t.2.2)

@[expose] def entryR (e : Nat × Nat × Nat × Nat × Nat) : Bool :=
  Nat.blt e.2.2.2.1 68719476736 && Nat.blt e.2.2.2.2 68719476736 &&
    Nat.beq (bmul e.2.2.2.1 (expand u0)) (bmul (expand e.1) e.2.2.2.1) &&
    Nat.beq (bmul e.2.2.2.1 (expand a0)) (bmul (expand e.2.1) e.2.2.2.1) &&
    Nat.beq (bmul e.2.2.2.1 (expand b0)) (bmul (expand e.2.2.1) e.2.2.2.1) &&
    Nat.beq (bmul e.2.2.2.1 e.2.2.2.2) idm

@[expose] def chkR : Bool :=
  listEqT presList (rtab.map fun e => (e.1, e.2.1, e.2.2.1)) && rtab.all entryR

@[expose] def run : Bool := chkB && chkP && chkG && chkZ && chkO1 && chkO2 && chkC && chkR

end CFSG.Quasithin.D35ValChk
