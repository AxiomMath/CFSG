theorem gcd_two_odd {q : ℕ} (hq : Odd q) : Nat.gcd 2 (q - 1) = 2 := by
  obtain ⟨j, hj⟩ := hq
  exact Nat.gcd_eq_left ⟨j, by omega⟩

