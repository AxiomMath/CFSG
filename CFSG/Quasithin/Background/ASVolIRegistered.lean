theorem card_groupCohomology_one {G V : Type} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
    [Finite G] [Finite V] (ρ : Representation (ZMod 2) G V) :
    Nat.card (groupCohomology (Rep.of ρ) 1) =
      2 ^ Module.finrank (ZMod 2) (CFSG.Quasithin.JonesParshall.H1 ρ) := by
  classical
  set A := Rep.of ρ
  have hZ : CFSG.Quasithin.JonesParshall.Z1 ρ = groupCohomology.cocycles₁ A := by
    ext f
    rw [groupCohomology.mem_cocycles₁_iff]
    change (∀ g h, f (g * h) = f g + ρ g (f h)) ↔ _
    constructor <;> intro h g k <;> rw [h g k, add_comm]
  have hB : CFSG.Quasithin.JonesParshall.B1 ρ = groupCohomology.coboundaries₁ A := rfl
  have hsurj : Function.Surjective (groupCohomology.H1π A) :=
    (ModuleCat.epi_iff_surjective _).1 inferInstance
  let φ := (groupCohomology.H1π A).hom
  have hker : LinearMap.ker φ =
      (groupCohomology.coboundaries₁ A).comap (groupCohomology.cocycles₁ A).subtype := by
    ext x
    rw [LinearMap.mem_ker, Submodule.mem_comap]
    exact groupCohomology.H1π_eq_zero_iff x
  let e1 : CFSG.Quasithin.JonesParshall.H1 ρ ≃ₗ[ZMod 2]
      (↥(groupCohomology.cocycles₁ A) ⧸ LinearMap.ker φ) :=
    Submodule.Quotient.equiv _ _ (LinearEquiv.ofEq _ _ hZ) (by
      rw [hker]
      ext x
      simp only [Submodule.mem_map, Submodule.mem_comap, Submodule.coe_subtype]
      constructor
      · rintro ⟨y, hy, rfl⟩
        rw [← hB]
        exact hy
      · intro hx
        refine ⟨(LinearEquiv.ofEq _ _ hZ).symm x, ?_, (LinearEquiv.ofEq _ _ hZ).apply_symm_apply x⟩
        rw [hB]
        exact hx)
  let e2 := φ.quotKerEquivOfSurjective hsurj
  have hfin : Finite (CFSG.Quasithin.JonesParshall.H1 ρ) :=
    Finite.of_surjective (Submodule.mkQ _) (Submodule.mkQ_surjective _)
  let := Fintype.ofFinite (CFSG.Quasithin.JonesParshall.H1 ρ)
  rw [← Nat.card_congr (e1.trans e2).toEquiv, Nat.card_eq_fintype_card,
    Module.card_eq_pow_finrank (K := ZMod 2), ZMod.card]

theorem isModel_nat {Γ ι K : Type} [Group Γ] [Fintype ι] [DecidableEq ι] [Field K]
    [Algebra (ZMod 2) K] (Γ₀ : Subgroup (GL ι K)) (φ : Γ →* Matrix ι ι K) (θ : Γ ≃* Γ₀)
    (hθ : ∀ γ, (((θ γ : Γ₀) : GL ι K) : Matrix ι ι K) = φ γ) :
    (CFSG.Quasithin.FFModel.nat Γ₀).IsModel (quasithinH1MatrixRep φ) := by
  classical
  let D := CFSG.Quasithin.FFModel.nat Γ₀
  let m1 : Multiplicative (ι → K) ≃* ↥(⊤ : Subgroup (Multiplicative (ι → K))) :=
    Subgroup.topEquiv.symm
  let m2 : ↥(⊤ : Subgroup (Multiplicative (ι → K))) ≃* D.Sec :=
    ((QuotientGroup.quotientMulEquivOfEq (Subgroup.bot_subgroupOf _)).trans
      QuotientGroup.quotientBot).symm
  let β : (ι → K) ≃+ Additive D.Sec :=
    (AddEquiv.additiveMultiplicative _).symm.trans (MulEquiv.toAdditive (m1.trans m2))
  have hβ : ∀ w, β w =
      Additive.ofMul (QuotientGroup.mk ⟨Multiplicative.ofAdd w, trivial⟩ : D.Sec) :=
    fun w => rfl
  refine ⟨θ, β, bot_le, fun _ _ _ => trivial, ?_, ?_⟩
  · intro g m hm
    have hm1 : (m : Multiplicative (ι → K)) = 1 := Subgroup.mem_bot.1 hm
    refine Subgroup.mem_bot.2 ?_
    change Multiplicative.ofAdd (Matrix.mulVec (((show ↥Γ₀ from g) : GL ι K) : Matrix ι ι K)
      (Multiplicative.toAdd (m : Multiplicative (ι → K)))) = 1
    rw [hm1]
    change Multiplicative.ofAdd (Matrix.mulVec _ (0 : ι → K)) = 1
    rw [Matrix.mulVec_zero]
    rfl
  · intro γ w m hm hw
    obtain ⟨m, hmtop⟩ := m
    have hw' : (QuotientGroup.mk ⟨Multiplicative.ofAdd w, trivial⟩ : D.Sec) =
        QuotientGroup.mk ⟨m, hmtop⟩ :=
      Additive.ofMul.injective ((hβ w).symm.trans hw)
    have h1 := Subgroup.mem_bot.1 ((Subgroup.mem_subgroupOf).1 (QuotientGroup.eq.1 hw'))
    simp only [Subgroup.coe_mul, Subgroup.coe_inv] at h1
    have hm' : m = Multiplicative.ofAdd w := (inv_mul_eq_one.1 h1).symm
    refine (hβ _).trans ?_
    congr 2
    apply Subtype.ext
    change Multiplicative.ofAdd (Matrix.toLin' (φ γ) w) =
      Multiplicative.ofAdd (Matrix.mulVec (((θ γ : Γ₀) : GL ι K) : Matrix ι ι K)
        (Multiplicative.toAdd (m : Multiplicative (ι → K))))
    rw [hm', hθ, Matrix.toLin'_apply]
    rfl

theorem binaryNaturalSL_matrixRep (n : ℕ) (K : Type) [Field K] [Algebra (ZMod 2) K] :
    CFSG.Quasithin.Explicit.BinaryNaturalSL (quasithinH1MatrixRep (quasithinH1SLMatrix n K)) n K
      .natural :=
  isModel_nat (CFSG.Assembly.LowTwoRank.StatedSL n K) (quasithinH1SLMatrix n K)
    (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL n K) (fun _ => rfl)

theorem sp4_eq_statedSp (F : Type) [Field F] [CharP F 2] :
    CFSG.Quasithin.Explicit.sp4 F = CFSG.Assembly.LowTwoRank.StatedSp 2 F := by
  have hneg : (-1 : Matrix (Fin 2) (Fin 2) F) = 1 := by
    ext i j
    rw [Matrix.neg_apply, CharTwo.neg_eq]
  rw [CFSG.Assembly.LowTwoRank.StatedSp, hneg]
  exact (Subgroup.closure_eq (CFSG.Quasithin.Explicit.sp4 F)).symm

theorem binaryNaturalSp4Derived_matrixRep (F : Type) [Field F] [CharP F 2] [Algebra (ZMod 2) F]
    (h4 : 4 ≤ Nat.card F) :
    CFSG.Quasithin.Explicit.BinaryNaturalSp4Derived
      (quasithinH1MatrixRep (Matrix.symplecticGroup (Fin 2) F).subtype) F := by
  have hperf : Group.IsPerfect (CFSG.Assembly.LowTwoRank.StatedSp 2 F) :=
    CFSG.LieType.Steinberg.CentralExt.SpClosed.isPerfect_statedSp 2 F h4
  have hcomm : ⁅CFSG.Quasithin.Explicit.sp4 F, CFSG.Quasithin.Explicit.sp4 F⁆ =
      CFSG.Assembly.LowTwoRank.StatedSp 2 F := by
    rw [sp4_eq_statedSp]
    exact Subgroup.commutator_eq_self
  let θ : ↥(Matrix.symplecticGroup (Fin 2) F) ≃*
      ↥⁅CFSG.Quasithin.Explicit.sp4 F, CFSG.Quasithin.Explicit.sp4 F⁆ :=
    ((TauCeti.GLSymplectic.mulEquivSymplecticGroup (Fin 2) F).symm.trans
      (MulEquiv.subgroupCongr CFSG.ClassicalGroups.Symplectic.statedSp_eq_GLSymplectic.symm)).trans
      (MulEquiv.subgroupCongr hcomm.symm)
  refine isModel_nat _ _ θ (fun γ => ?_)
  have h := TauCeti.GLSymplectic.coe_mulEquivSymplecticGroup
    (M := (TauCeti.GLSymplectic.mulEquivSymplecticGroup (Fin 2) F).symm γ)
  rw [MulEquiv.apply_symm_apply] at h
  exact h.symm

theorem red_2
    : (
    (∀ n : ℕ, 2 ≤ n → quasithinH1CardSL 2 (GaloisField 2 n) = 2 ^ n) ∧
    (∀ n : ℕ, 2 ≤ n → quasithinH1CardSL 3 (GaloisField 2 n) = 1) ∧
    quasithinH1CardSL 3 (ZMod 2) = 2 ∧
    (∀ n : ℕ, 2 ≤ n →
      Nat.card (groupCohomology (Rep.of (quasithinH1MatrixRep
        (Matrix.symplecticGroup (Fin 2) (GaloisField 2 n)).subtype)) 1) = 2 ^ n) ∧
    quasithinH1CardSL 4 (ZMod 2) = 1 ∧
    quasithinH1CardSL 5 (ZMod 2) = 1) := by
  obtain ⟨h1, -, h3, h4, -, h5, -⟩ :=
    CFSG.Quasithin.JonesParshall.natural_binary_first_cohomology_sector.{0, 0}
  have hcardF : ∀ n, n ≠ 0 → ∀ [Fintype (GaloisField 2 n)],
      Fintype.card (GaloisField 2 n) = 2 ^ n := fun n hn _ => by
    rw [← Nat.card_eq_fintype_card]
    exact GaloisField.card 2 n hn
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro n hn
    let : Fintype (GaloisField 2 n) := Fintype.ofFinite _
    rw [quasithinH1CardSL, card_groupCohomology_one,
      h1 (a := n) (hcardF n (by omega)) (by omega) (binaryNaturalSL_matrixRep 2 _)]
  · intro n hn
    let : Fintype (GaloisField 2 n) := Fintype.ofFinite _
    rw [quasithinH1CardSL, card_groupCohomology_one,
      h3 (a := n) (hcardF n (by omega)) (by omega) (binaryNaturalSL_matrixRep 3 _),
      ite_eq_right (by omega), pow_zero]
  · rw [quasithinH1CardSL, card_groupCohomology_one,
      h3 (F := ZMod 2) (a := 1) (by rw [ZMod.card, pow_one]) (by norm_num)
        (binaryNaturalSL_matrixRep 3 _)]
    rfl
  · intro n hn
    let : Fintype (GaloisField 2 n) := Fintype.ofFinite _
    have h4F : 4 ≤ Nat.card (GaloisField 2 n) := by
      rw [GaloisField.card 2 n (by omega)]
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
    rw [card_groupCohomology_one,
      h4 (a := n) (hcardF n (by omega)) (by omega) (binaryNaturalSp4Derived_matrixRep _ h4F)]
  · rw [quasithinH1CardSL, card_groupCohomology_one,
      h5 (d := 4) (Or.inl rfl) (ZMod.card 2) (binaryNaturalSL_matrixRep 4 _), pow_zero]
  · rw [quasithinH1CardSL, card_groupCohomology_one,
      h5 (d := 5) (Or.inr rfl) (ZMod.card 2) (binaryNaturalSL_matrixRep 5 _), pow_zero]

