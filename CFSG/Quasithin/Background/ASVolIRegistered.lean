noncomputable def pspEquiv (K : Type) [Field K] :
    quasithinPSp 2 K ≃*
      CFSG.Assembly.LowTwoRank.StatedProj (CFSG.Assembly.LowTwoRank.StatedSp 2 K) := by
  let e0 : CFSG.Assembly.LowTwoRank.StatedSp 2 K ≃* Matrix.symplecticGroup (Fin 2) K :=
    (MulEquiv.subgroupCongr CFSG.ClassicalGroups.Symplectic.statedSp_eq_GLSymplectic).trans
      (TauCeti.GLSymplectic.mulEquivSymplecticGroup (Fin 2) K)
  have hc : (Subgroup.center (Matrix.symplecticGroup (Fin 2) K)).map e0.symm.toMonoidHom =
      Subgroup.center (CFSG.Assembly.LowTwoRank.StatedSp 2 K) := by
    ext g
    constructor
    · rintro ⟨x, hx, rfl⟩
      rw [SetLike.mem_coe, Subgroup.mem_center_iff] at hx
      rw [Subgroup.mem_center_iff]
      intro y
      apply e0.injective
      simpa using hx (e0 y)
    · intro hg
      refine ⟨e0 g, ?_, by simp⟩
      rw [Subgroup.mem_center_iff] at hg
      rw [SetLike.mem_coe, Subgroup.mem_center_iff]
      intro y
      apply e0.symm.injective
      simpa using hg (e0.symm y)
  exact (QuotientGroup.congr _ _ e0.symm hc).trans
    (QuotientGroup.quotientMulEquivOfEq (CFSG.LieType.Universal.Symplectic.center_eq 2 K))

theorem multCyc_psp4 (p : ℕ) [Fact p.Prime] (hp : 5 ≤ p) :
    quasithinMultiplierCyclic (quasithinPSp 2 (ZMod p)) 2 := by
  obtain ⟨-, ⟨i⟩⟩ := CFSG.LieType.Steinberg.CentralExt.SpClosed.psp_hopfMultiplier
    (K := ZMod p) (n := 2) le_rfl (by rw [Nat.card_zmod]; exact hp)
  rw [Nat.card_zmod, gcd_two_odd (Nat.Prime.odd_of_ne_two Fact.out (by omega))] at i
  exact multCyc_congr (pspEquiv (ZMod p)) ⟨i⟩

