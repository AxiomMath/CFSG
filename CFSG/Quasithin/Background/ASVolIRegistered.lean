theorem psu3_eq (p k : ℕ) [Fact p.Prime] : PSU3 p k = quasithinPSU 3 p k := by
  have hJ : quasithinAntidiag 3 (GaloisField p (2 * k)) = !![0, 0, 1; 0, 1, 0; 1, 0, 0] := by
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  rw [PSU3, quasithinPSU, hJ]

theorem lieModel_psu3 {p k : ℕ} [Fact p.Prime] (hk : 0 < k) (h2 : p ^ k ≠ 2) :
    CFSG.Blueprint.LieModel (PSU3 p k) .PSU 3 p k :=
