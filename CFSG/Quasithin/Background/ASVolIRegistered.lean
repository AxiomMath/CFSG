theorem multCyc_congr {X Y : Type} [Group X] [Group Y] (e : X ≃* Y) {d : ℕ}
    (h : quasithinMultiplierCyclic Y d) : quasithinMultiplierCyclic X d := by
  obtain ⟨i⟩ := h
  exact ⟨(CFSG.LieType.Steinberg.CentralExt.griessHopfMultiplierCongr e).trans i⟩

theorem multCyc_of_hopf {S : Type} [Group S] {d : ℕ}
    (hc : IsCyclic (CFSG.RankThree.PerfectCover.hopfMultiplier S))
    (hd : Nat.card (CFSG.RankThree.PerfectCover.hopfMultiplier S) = d) :
    quasithinMultiplierCyclic S d := by
  subst hd
  exact ⟨(CFSG.RankThree.PerfectCover.hopfMultiplierEquivGriess S).trans
    (zmodCyclicMulEquiv hc).symm⟩

theorem multCyc_of_hopf_prime {S : Type} [Group S] {d : ℕ} (hp : d.Prime)
    (hd : Nat.card (CFSG.RankThree.PerfectCover.hopfMultiplier S) = d) :
    quasithinMultiplierCyclic S d :=
  have : Fact d.Prime := ⟨hp⟩
  multCyc_of_hopf (isCyclic_of_prime_card hd) hd

theorem multCyc_of_griess_prime {S : Type} [Group S] {d : ℕ} (hp : d.Prime)
    (hd : Nat.card (griessHopfMultiplier S) = d) : quasithinMultiplierCyclic S d := by
  have : Fact d.Prime := ⟨hp⟩
  have hc : IsCyclic (griessHopfMultiplier S) := isCyclic_of_prime_card hd
  subst hd
  exact ⟨(zmodCyclicMulEquiv hc).symm⟩

theorem hopf_of_table {X T : Type} [Group X] [Group T] {t : Tag} {n p f a b c d : ℕ}
    (hX : Nonempty (griessHopfMultiplier X ≃*
      (Multiplicative (ZMod (CFSG.Blueprint.Multiplier.genericOrders t n p f).1) ×
        Multiplicative (ZMod (CFSG.Blueprint.Multiplier.genericOrders t n p f).2)) ×
      (Multiplicative (ZMod (CFSG.Blueprint.Multiplier.exceptionalOrders t n p f).1) ×
        Multiplicative (ZMod (CFSG.Blueprint.Multiplier.exceptionalOrders t n p f).2))))
    (hg : CFSG.Blueprint.Multiplier.genericOrders t n p f = (a, b))
    (he : CFSG.Blueprint.Multiplier.exceptionalOrders t n p f = (c, d))
    (i : (Multiplicative (ZMod a) × Multiplicative (ZMod b)) ×
      (Multiplicative (ZMod c) × Multiplicative (ZMod d)) ≃* T) :
    Nonempty (quasithinHopfMultiplier X ≃* T) := by
  obtain ⟨e⟩ := hX
  rw [hg, he] at e
  exact ⟨e.trans i⟩

theorem multCyc_gen {X : Type} [Group X] {t : Tag} {n p f d : ℕ}
    (hX : Nonempty (griessHopfMultiplier X ≃*
      (Multiplicative (ZMod (CFSG.Blueprint.Multiplier.genericOrders t n p f).1) ×
        Multiplicative (ZMod (CFSG.Blueprint.Multiplier.genericOrders t n p f).2)) ×
      (Multiplicative (ZMod (CFSG.Blueprint.Multiplier.exceptionalOrders t n p f).1) ×
        Multiplicative (ZMod (CFSG.Blueprint.Multiplier.exceptionalOrders t n p f).2))))
    (hg : CFSG.Blueprint.Multiplier.genericOrders t n p f = (d, 1))
    (he : CFSG.Blueprint.Multiplier.exceptionalOrders t n p f = (1, 1)) :
    quasithinMultiplierCyclic X d :=
  hopf_of_table hX hg he (MulEquiv.prodUnique.trans MulEquiv.prodUnique)

theorem multCyc_exc {X : Type} [Group X] {t : Tag} {n p f d : ℕ}
    (hX : Nonempty (griessHopfMultiplier X ≃*
      (Multiplicative (ZMod (CFSG.Blueprint.Multiplier.genericOrders t n p f).1) ×
        Multiplicative (ZMod (CFSG.Blueprint.Multiplier.genericOrders t n p f).2)) ×
      (Multiplicative (ZMod (CFSG.Blueprint.Multiplier.exceptionalOrders t n p f).1) ×
        Multiplicative (ZMod (CFSG.Blueprint.Multiplier.exceptionalOrders t n p f).2))))
    (hg : CFSG.Blueprint.Multiplier.genericOrders t n p f = (1, 1))
    (he : CFSG.Blueprint.Multiplier.exceptionalOrders t n p f = (d, 1)) :
    quasithinMultiplierCyclic X d :=
  hopf_of_table hX hg he (MulEquiv.uniqueProd.trans MulEquiv.prodUnique)

theorem multCyc_psl {n p k d : ℕ} [Fact p.Prime]
    (h : Nonempty (griessHopfMultiplier PSL(n, GaloisField p k) ≃*
      Multiplicative (ZMod (Nat.gcd n (p ^ k - 1)) × ZMod (griessPSLExceptional n (p ^ k)).1 ×
        ZMod (griessPSLExceptional n (p ^ k)).2)))
    (hg : Nat.gcd n (p ^ k - 1) = d) (he : griessPSLExceptional n (p ^ k) = (1, 1)) :
    quasithinMultiplierCyclic PSL(n, GaloisField p k) d := by
  obtain ⟨e⟩ := h
  rw [hg, he] at e
  exact ⟨e.trans (AddEquiv.toMultiplicative
    (AddEquiv.prodUnique : ZMod d × (ZMod 1 × ZMod 1) ≃+ ZMod d))⟩

theorem odd_pow_of_ne_two {p k : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) : Odd (p ^ k) :=
