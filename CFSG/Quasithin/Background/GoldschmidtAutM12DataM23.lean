  ⟨m23gA, by rw [m23_eq]; exact Subgroup.subset_closure (Set.mem_insert _ _)⟩

@[expose] def m23b : ↥NativeSporadic.M23 :=
  ⟨m23gB, by rw [m23_eq]; exact Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)⟩

@[expose] def ag : ℕ → ↥NativeSporadic.M23 := fun i => if i = 0 then m23a else m23b

@[expose] def gens (a : ℕ) : ↥NativeSporadic.M23 := posWord ag (words.getD a [])

@[expose] def xl : List (List ℕ) :=
  [[1, 0, 3, 2, 4, 5, 7, 6, 9, 8, 10, 11, 13, 12, 15, 14, 16, 17, 19, 18,
   21, 20, 22],
  [15, 8, 0, 4, 7, 21, 6, 22, 20, 9, 2, 1, 19, 17, 16, 10, 14, 5, 18, 12,
   11, 13, 3]]

theorem ok : data.Ok compL (List.range 23) := by decide +kernel

theorem hx : ∀ i, i < xl.length →
    (permSubRep 23 NativeSporadic.M23).rel (ag i) (xl.getD i (List.range 23)) := by
  intro i hi
  have : i = 0 ∨ i = 1 := by simp [xl] at hi; omega
  rcases this with rfl | rfl
  · show RepL _ ((ag 0 : ↥NativeSporadic.M23) : Equiv.Perm (Fin 23))
    decide +kernel
  · show RepL _ ((ag 1 : ↥NativeSporadic.M23) : Equiv.Perm (Fin 23))
    decide +kernel

theorem hw : ∀ a, a < 6 → ∀ i ∈ words.getD a [], i < xl.length := by decide +kernel

theorem hwords : ∀ a, a < 6 →
    lwordD compL (List.range 23) xl (words.getD a []) = data.gd.getD a (List.range 23) := by
  decide +kernel

theorem hgd : ∀ a, a < 6 →
    (permSubRep 23 NativeSporadic.M23).rel (gens a) (data.gd.getD a (List.range 23)) := by
  intro a ha
  have h : (permSubRep 23 NativeSporadic.M23).rel (posWord ag (words.getD a []))
      (lwordD compL (List.range 23) xl (words.getD a [])) :=
    rel_posWord (permSubRep 23 NativeSporadic.M23) ag xl hx _ (hw a ha)
  rwa [hwords a ha] at h

theorem hasTwoE16_m23 (Q : Sylow 2 ↥NativeSporadic.M23) :
    HasTwoE16 ↥(Q : Subgroup ↥NativeSporadic.M23) :=
  hasTwoE16_of_rep (permSubRep 23 NativeSporadic.M23) data ok gens hgd Q

end CFSG.Quasithin.F6.AutM12Recog.Tab.M23Cert
