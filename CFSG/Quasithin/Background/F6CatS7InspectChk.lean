@[expose] def gen (i : ℕ) : Perm (Fin 7) :=
  if i = 0 then swap 0 1 * swap 1 2 * swap 2 3 * swap 3 4 * swap 4 5 * swap 5 6
  else swap 0 1

@[expose] def gL (i : ℕ) : List ℕ :=
  if i = 0 then [1, 2, 3, 4, 5, 6, 0] else [1, 0, 2, 3, 4, 5, 6]

@[expose] def giL (i : ℕ) : List ℕ :=
  if i = 0 then [6, 0, 1, 2, 3, 4, 5] else [1, 0, 2, 3, 4, 5, 6]

theorem gen_chk : RepL (gL 0) (gen 0) ∧ RepL (gL 1) (gen 1) ∧ RepL (giL 0) (gen 0)⁻¹ ∧
    RepL (giL 1) (gen 1)⁻¹ := by decide

@[expose] def idL : List ℕ := List.range 7

@[expose] def wR : List (ℕ × Bool) :=
  [(1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (0, true), (1, true),
    (0, true), (0, true), (0, true)]

@[expose] def r : Perm (Fin 7) := wordProd gen wR

@[expose] def rL : List ℕ := [1, 2, 3, 0, 5, 4, 6]

@[expose] def wF : List (ℕ × Bool) :=
  [(1, true), (0, true), (1, true), (0, true), (0, true), (0, true), (1, true), (0, true),
    (0, true), (0, true), (1, true)]

@[expose] def f : Perm (Fin 7) := wordProd gen wF

@[expose] def fL : List ℕ := [2, 1, 0, 3, 5, 4, 6]

@[expose] def wZ : List (ℕ × Bool) :=
  [(0, false), (0, false), (0, false), (1, true), (0, true), (0, true), (0, true)]

@[expose] def z : Perm (Fin 7) := wordProd gen wZ

@[expose] def zL : List ℕ := [0, 1, 2, 3, 5, 4, 6]

theorem tgen_chk :
    rL = F6.wordLst gL giL 7 wR ∧
    fL = F6.wordLst gL giL 7 wF ∧
    zL = F6.wordLst gL giL 7 wZ := by
  decide +kernel

@[expose] def tel (a : ℕ) : Perm (Fin 7) := r ^ (a % 4) * f ^ (a / 4 % 2) * z ^ (a / 8)

@[expose] def telTab : List (List ℕ) :=
  [[0, 1, 2, 3, 4, 5, 6], [1, 2, 3, 0, 5, 4, 6], [2, 3, 0, 1, 4, 5, 6], [3, 0, 1, 2, 5, 4, 6],
    [2, 1, 0, 3, 5, 4, 6], [3, 2, 1, 0, 4, 5, 6], [0, 3, 2, 1, 5, 4, 6], [1, 0, 3, 2, 4, 5, 6],
    [0, 1, 2, 3, 5, 4, 6], [1, 2, 3, 0, 4, 5, 6], [2, 3, 0, 1, 5, 4, 6], [3, 0, 1, 2, 4, 5, 6],
    [2, 1, 0, 3, 4, 5, 6], [3, 2, 1, 0, 5, 4, 6], [0, 3, 2, 1, 4, 5, 6], [1, 0, 3, 2, 5, 4, 6]]

@[expose] def telL (a : ℕ) : List ℕ := telTab.getD a []

theorem telL_chk : ∀ a < 16,
    telL a = compL (compL (powLst 7 rL (a % 4)) (powLst 7 fL (a / 4 % 2)))
      (powLst 7 zL (a / 8)) := by
  decide +kernel

theorem telL_inj_chk : ∀ a < 16, ∀ b < 16, telL a = telL b → a = b := by decide +kernel

@[expose] def trR : List ℕ := [1, 2, 3, 0, 7, 4, 5, 6, 9, 10, 11, 8, 15, 12, 13, 14]

@[expose] def trF : List ℕ := [4, 5, 6, 7, 0, 1, 2, 3, 12, 13, 14, 15, 8, 9, 10, 11]

@[expose] def trZ : List ℕ := [8, 9, 10, 11, 12, 13, 14, 15, 0, 1, 2, 3, 4, 5, 6, 7]

theorem tr_chk : ∀ a < 16,
    trR.getD a 0 < 16 ∧ compL (telL a) rL = telL (trR.getD a 0) ∧
    trF.getD a 0 < 16 ∧ compL (telL a) fL = telL (trF.getD a 0) ∧
    trZ.getD a 0 < 16 ∧ compL (telL a) zL = telL (trZ.getD a 0) := by
  decide +kernel

