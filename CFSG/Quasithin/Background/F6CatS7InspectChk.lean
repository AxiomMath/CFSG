@[expose] def good : List ℕ := [1, 34]

theorem cls_chk : ∀ j < 35, (j = 0 ∧ clsTab.getD j 0 = 0) ∨ (clsTab.getD j 0 = 1 ∧ j ∈ good) ∨
    (2 ≤ clsTab.getD j 0 ∧ clsTab.getD j 0 - 2 < 16 ∧
      powLst 7 (compL (dL j) (telL (clsTab.getD j 0 - 2))) 4 ≠ idL ∧
      powLst 7 (compL (dL j) (telL (clsTab.getD j 0 - 2))) 6 ≠ idL) := by
  decide +kernel

theorem good_lt_chk : ∀ j ∈ good, j < 35 := by decide +kernel

@[expose] def pairX (j j' : ℕ) : Finset (Finset (Fin 7)) :=
  if (j = 1 ∧ j' = 34) ∨ (j = 34 ∧ j' = 1) then
    {{6}}
  else ∅

theorem pair_chk : ∀ j ∈ good, ∀ j' ∈ good, j ≠ j' →
    (pairX j j').image (Finset.image (F6.lfun 7 rL)) = pairX j j' ∧
    (pairX j j').image (Finset.image (F6.lfun 7 fL)) = pairX j j' ∧
    (pairX j j').image (Finset.image (F6.lfun 7 zL)) = pairX j j' ∧
    (pairX j j').image (Finset.image (F6.lfun 7 (dL j))) = pairX j j' ∧
    (pairX j j').image (Finset.image (F6.lfun 7 (dL j'))) = pairX j j' ∧
    (pairX j j').image (Finset.image (F6.lfun 7 (gL 0))) ≠ pairX j j' := by
  decide +kernel

