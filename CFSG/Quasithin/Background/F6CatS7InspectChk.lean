@[expose] def decE (j b k e : ℕ) : ℕ := (decTab.getD j []).getD (6 * b + 3 * k + e) 0

@[expose] def DecOK (j : ℕ) : Prop :=
  ∀ b < 16, ∀ k < 2, decE j b k 0 < 16 ∧ decE j b k 1 < 35 ∧ decE j b k 2 < 16 ∧
    compL (compL (dL j) (telL b)) (gL k) =
      compL (compL (telL (decE j b k 0)) (dL (decE j b k 1))) (telL (decE j b k 2))

instance (j : ℕ) : Decidable (DecOK j) := by unfold DecOK; infer_instance

theorem dec_chk0 : ∀ j, 0 ≤ j → j < 5 → DecOK j := by decide +kernel

theorem dec_chk1 : ∀ j, 5 ≤ j → j < 10 → DecOK j := by decide +kernel

theorem dec_chk2 : ∀ j, 10 ≤ j → j < 15 → DecOK j := by decide +kernel

theorem dec_chk3 : ∀ j, 15 ≤ j → j < 20 → DecOK j := by decide +kernel

theorem dec_chk4 : ∀ j, 20 ≤ j → j < 25 → DecOK j := by decide +kernel

theorem dec_chk5 : ∀ j, 25 ≤ j → j < 30 → DecOK j := by decide +kernel

theorem dec_chk6 : ∀ j, 30 ≤ j → j < 35 → DecOK j := by decide +kernel

theorem dec_chk (j : ℕ) (hj : j < 35) : DecOK j := by
  by_cases h0 : j < 5
  · exact dec_chk0 j (by omega) h0
  by_cases h1 : j < 10
  · exact dec_chk1 j (by omega) h1
  by_cases h2 : j < 15
  · exact dec_chk2 j (by omega) h2
  by_cases h3 : j < 20
  · exact dec_chk3 j (by omega) h3
  by_cases h4 : j < 25
  · exact dec_chk4 j (by omega) h4
  by_cases h5 : j < 30
  · exact dec_chk5 j (by omega) h5
  exact dec_chk6 j (by omega) hj

