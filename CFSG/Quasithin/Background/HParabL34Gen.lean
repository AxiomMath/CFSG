@[expose] def s2Word (p : ℕ) : List ℕ := s2Words.getD p []

theorem s2Word_ok : ∀ p < 64, cols (wM [x2M, y2M] (s2Word p)) = colsS1.getD p [] := by
  decide +kernel

theorem s2_conj : ∀ p < 64, p % 4 ≠ 0 → cols (x2Mi * sM p * x2M) ∉ colsS1 := by
  decide +kernel

theorem qw_mul_code : ∀ s < 16, ∀ t < 16,
    mcode (sM (4 * s) * sM (4 * t)) = mcode (sM (4 * (s ^^^ t))) := by
  decide +kernel

theorem qw_zero_code : mcode (sM (4 * 0)) = mcode 1 := by
  decide +kernel

@[expose] def kc2M (i : ℕ) : Matrix (Fin 3) (Fin 3) F4 :=
  if i < 4 then sM (4 * 2 ^ i) * x2M * sM (4 * 2 ^ i) * x2Mi
  else sM (4 * 2 ^ (i - 4)) * y2M * sM (4 * 2 ^ (i - 4)) * y2Mi

@[expose] def qwComms : List (List ℕ) :=
  [[], [3, 7], [0, 6, 7], [1, 6], [3, 6, 7], [6], [1], [0, 7], [0, 6], [1, 6, 7], [7], [3], [1, 7],
    [0], [3, 6], [6, 7]]

theorem qwComm_code : ∀ t < 16,
    mcode (wM ((List.range 8).map kc2M) (qwComms.getD t [])) = mcode (sM (4 * t)) := by
  decide +kernel

theorem qw_fix : ∀ m < 512, ((List.range 16).all fun t => actM (colsS1.getD (4 * t) []) m == m) =
    (combos U0Basis).contains m := by
  decide +kernel

@[expose] def id9 : List ℕ := [1, 2, 4, 8, 16, 32, 64, 128, 256]

theorem id9_ok : ∀ m < 2 ^ 9, actM id9 (actM id9 m) = m ∧ actM id9 m < 2 ^ 9 := by
  decide +kernel

@[expose] def p2Cols (g : ℕ) : List ℕ := if g = 0 then colsX2 else colsY2

@[expose] def p2Act (g k : ℕ) : ℕ := tupAct 9 id9 id9 (p2Cols g) 2 k

@[expose] def p2Us : List ℕ := [3, 13]

theorem p2Us_start : p2Us.foldr (fun u acc => actM id9 u + 2 ^ 9 * acc) 0 = 6659 := by
  decide +kernel

