@[expose] def gp : ℕ → Equiv.Perm (Fin 8)
  | 0 => List.formPerm [0, 1] * List.formPerm [2, 3]
  | 1 => List.formPerm [4, 5] * List.formPerm [6, 7]
  | 2 => List.formPerm [0, 1]
  | 3 => List.formPerm [4, 5]
  | 4 => List.formPerm [0, 2] * List.formPerm [1, 3]
  | 5 => List.formPerm [4, 6] * List.formPerm [5, 7]
  | _ => 1

@[expose] def gens (a : ℕ) : ↥(⊤ : Subgroup (Equiv.Perm (Fin 8))) := ⟨gp a, Subgroup.mem_top _⟩

theorem ok : data.Ok compL (List.range 8) := by decide +kernel

theorem hgd : ∀ a, a < 6 →
    (permSubRep 8 ⊤).rel (gens a) (data.gd.getD a (List.range 8)) := by
  intro a ha
  show RepL (data.gd.getD a (List.range 8)) (gp a)
  interval_cases a <;> decide +kernel

theorem hasTwoE16_perm8 (Q : Sylow 2 (Equiv.Perm (Fin 8))) :
    HasTwoE16 ↥(Q : Subgroup (Equiv.Perm (Fin 8))) := by
  obtain ⟨Q', ⟨ι⟩⟩ := exists_sylow_mulEquiv (Subgroup.topEquiv (G := Equiv.Perm (Fin 8))).symm Q
  exact (hasTwoE16_of_rep (permSubRep 8 ⊤) data ok gens hgd Q').of_mulEquiv ι.symm

