@[expose] def lane120 (T i : ℕ) : ℕ :=
  Nat.land (Nat.shiftRight T (Nat.mul 120 i)) 1329227995784915872903807060280344575

@[expose] def decL (T n : ℕ) : List (List ℕ) :=
  (List.range n).map fun i => (List.range 24).map fun p => lane (lane120 T i) p

theorem getD_dec {D : List (Array ℕ)} {T n : ℕ} (h : (D.map Array.toList == decL T n) = true) :
    ∀ i < n, D.getD i idArr = dec (lane120 T i) := by
  intro i hi
  have he := eq_of_beq h
  have hlen : D.length = n := by simpa [decL] using congrArg List.length he
  have hiD : i < D.length := hlen ▸ hi
  have h2 := congrArg (fun L => L[i]?) he
  simp only [decL, List.getElem?_map, List.getElem?_range hi, List.getElem?_eq_getElem hiD,
    Option.map_some, Option.some.injEq] at h2
  rw [List.getD_eq_getElem _ _ hiD]
  unfold dec
  rw [← h2]

