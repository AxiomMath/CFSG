theorem card_SL2_five : Nat.card (Matrix.SpecialLinearGroup (Fin 2) (ZMod 5)) = 120 := by
  have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  rw [Matrix.card_SL_field (𝔽 := ZMod 5) 2, ZMod.card]
  simp [Fin.prod_univ_two]

theorem false_of_E9_SL2 {r : ℕ} (hr : r.Prime) (hr5 : 5 ≤ r)
    {E : Subgroup (Matrix.SpecialLinearGroup (Fin 2) (ZMod r))} (hE : Nat.card E = 9)
    (hE3 : ∀ e ∈ E, e ^ 3 = 1) : False := by
  have : Fact r.Prime := ⟨hr⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  rcases Nat.lt_or_ge r 7 with hr7 | hr7
  ·
    have h5 : r = 5 := by
      interval_cases r
      · rfl
      · exact absurd hr (by norm_num)
    subst h5
    have h := Subgroup.card_subgroup_dvd_card E
    rw [hE, card_SL2_five] at h
    norm_num at h
  set π := QuotientGroup.mk' (Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) (ZMod r)))
  have hinj : Function.Injective (π.comp E.subtype) := by
    rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
    intro x hx
    have hxc : (x : Matrix.SpecialLinearGroup (Fin 2) (ZMod r)) ∈
        Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) (ZMod r)) :=
      (QuotientGroup.eq_one_iff _).mp hx
    obtain ⟨c, hc, hcx⟩ := Matrix.SpecialLinearGroup.mem_center_iff.mp hxc
    have h2 : (x : Matrix.SpecialLinearGroup (Fin 2) (ZMod r)) ^ 2 = 1 := by
      apply Subtype.ext
      rw [Matrix.SpecialLinearGroup.coe_pow, ← hcx, ← map_pow]
      rw [Fintype.card_fin] at hc
      rw [hc, map_one]
      rfl
    have h1 : (x : Matrix.SpecialLinearGroup (Fin 2) (ZMod r)) = 1 := by
      have := pow_gcd_eq_one.mpr ⟨h2, hE3 x x.2⟩
      rwa [show Nat.gcd 2 3 = 1 from rfl, pow_one] at this
    exact Subgroup.mem_bot.mpr (Subtype.ext h1)
  set E' := E.map π with hE'
  have hE'c : Nat.card E' = 9 := by
    rw [hE', ← hE, show E.map π = (π.comp E.subtype).range by
      rw [MonoidHom.range_comp, Subgroup.range_subtype], MonoidHom.range_eq_map,
      Subgroup.card_map_of_injective hinj, Subgroup.card_top]
  have hE'3 : ∀ x ∈ E', x ^ 3 = 1 := by
    rintro _ ⟨a, ha, rfl⟩
    rw [← map_pow, hE3 a ha, map_one]
  have hp3 : IsPGroup 3 ↥E' := fun x => ⟨1, Subtype.ext (by simpa using hE'3 x x.2)⟩
  obtain ⟨R, hR⟩ := hp3.exists_le_sylow
  have hcop : Nat.Coprime 3 (Nat.card (ZMod r)) := by
    rw [Nat.card_zmod]
    exact (Nat.coprime_primes Nat.prime_three hr).mpr (by omega)
  have hRc := CFSG.GorensteinWalter.psl2_sylow_isCyclic_of_coprime_field_card (ZMod r)
    (p := r) (f := 1) (by rw [Nat.card_zmod, pow_one]) (by rw [Nat.card_zmod]; exact hr7) 3
    (by norm_num) hcop R
  have hcyc : IsCyclic ↥E' := by
    have : IsCyclic ↥(E'.subgroupOf (R : Subgroup _)) := Subgroup.isCyclic _
    exact isCyclic_of_surjective (Subgroup.subgroupOfEquivOfLe hR).toMonoidHom
      (Subgroup.subgroupOfEquivOfLe hR).surjective
  have hexp : Monoid.exponent ↥E' ∣ 3 := Monoid.exponent_dvd_of_forall_pow_eq_one fun x =>
    Subtype.ext (by simpa using hE'3 x x.2)
  have hle := Nat.le_of_dvd (by norm_num) hexp
  rw [IsCyclic.exponent_eq_card, hE'c] at hle
  omega

theorem false_of_case34 {X : Type} [Group X] [Finite X] (h : A36Case3 X ∨ A36Case4 X)
    {E : Subgroup X} (hE : Nat.card E = 9) (hE3 : ∀ e ∈ E, e ^ 3 = 1) : False := by
  have h3F : ¬ 3 ∣ Nat.card (CFSG.fittingSubgroup X) := by
    rcases h with ⟨p, hp, hp3, -, ⟨eF⟩, -⟩ | ⟨-, -, -, hp⟩
    · have : Fact p.Prime := ⟨hp⟩
      rw [Nat.card_congr eF.toEquiv, Nat.card_eq_fintype_card]
      simp only [Fintype.card_multiplicative, Fintype.card_fun, ZMod.card, Fintype.card_fin]
      intro h3
      have := (Nat.prime_dvd_prime_iff_eq Nat.prime_three hp).mp
        (Nat.prime_three.dvd_of_dvd_pow h3)
      omega
    · intro h3
      have := (hp 3 Nat.prime_three h3).1
      omega
  obtain ⟨r, hr, hr5, χ, -, hker⟩ := exists_sl2_surjection_of_case34 h
  have hcop : Nat.Coprime 3 (Nat.card (CFSG.fittingSubgroup X)) :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr h3F
  have hinj : Function.Injective (χ.comp E.subtype) := by
    rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
    intro x hx
    have hxF : (x : X) ∈ CFSG.fittingSubgroup X := by rw [← hker]; exact hx
    have h1 : orderOf (x : X) ∣ 3 := orderOf_dvd_of_pow_eq_one (hE3 x x.2)
    have h2 : orderOf (x : X) ∣ Nat.card (CFSG.fittingSubgroup X) :=
      Subgroup.orderOf_dvd_natCard _ hxF
    have h3 : orderOf (x : X) = 1 := Nat.eq_one_of_dvd_coprimes hcop h1 h2
    exact Subgroup.mem_bot.mpr (Subtype.ext (orderOf_eq_one_iff.mp h3))
  refine false_of_E9_SL2 hr hr5 (E := E.map χ) ?_ ?_
  · rw [← hE, show E.map χ = (χ.comp E.subtype).range by
      rw [MonoidHom.range_comp, Subgroup.range_subtype], MonoidHom.range_eq_map,
      Subgroup.card_map_of_injective hinj, Subgroup.card_top]
  · rintro _ ⟨a, ha, rfl⟩
    rw [← map_pow, hE3 a ha, map_one]

theorem not_isSolvable_of_isQuasisimple {Q : Type*} [Group Q] (hQ : CFSG.IsQuasisimple Q) :
    ¬ Group.IsSolvable Q := by
  intro hsol
  obtain ⟨hperf, -, a, b, hab⟩ := hQ
  obtain ⟨n, hn⟩ := hsol.solvable
  have htop : ∀ m, derivedSeries Q m = ⊤ := by
    intro m
    induction m with
    | zero => rfl
    | succ m ih =>
      rw [derivedSeries_succ, ih]
      exact hperf.commutator_eq_top
  rw [htop] at hn
  have hall : ∀ x : Q, x = 1 := fun x => Subgroup.mem_bot.1 (hn ▸ Subgroup.mem_top x)
  apply hab
  induction a using QuotientGroup.induction_on with | H a => ?_
  induction b using QuotientGroup.induction_on with | H b => ?_
  rw [hall a, hall b]

theorem le_center_of_isPGroup_two {K : Type} [Group K] [Finite K]
    (hq : CFSG.IsQuasisimple (K ⧸ CFSG.oddCore K)) {N : Subgroup K} (hNn : N.Normal)
    (hN : IsPGroup 2 N) : N ≤ Subgroup.center K := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set π := QuotientGroup.mk' (CFSG.oddCore K)
  have hNm : (N.map π).Normal := hNn.map π (QuotientGroup.mk'_surjective _)
  have hcen : N.map π ≤ Subgroup.center (K ⧸ CFSG.oddCore K) := by
    rcases CFSG.LocalCores.quasisimple_normal_subgroups hq hNm with h | h
    · exfalso
      have h2 : IsPGroup 2 (K ⧸ CFSG.oddCore K) := by
        intro y
        have hy : y ∈ N.map π := h ▸ Subgroup.mem_top y
        obtain ⟨x, hx, rfl⟩ := hy
        obtain ⟨k, hk⟩ := hN ⟨x, hx⟩
        refine ⟨k, ?_⟩
        rw [← map_pow]
        have : x ^ 2 ^ k = 1 := by simpa using congrArg Subtype.val hk
        rw [this, map_one]
      have : Group.IsNilpotent (K ⧸ CFSG.oddCore K) := h2.isNilpotent
      exact not_isSolvable_of_isQuasisimple hq inferInstance
    · exact h
  have hodd : Odd (Nat.card (CFSG.oddCore K)) := by
    have hc : CFSG.oddCore K = CFSG.pPrimeCore 2 K := by
      unfold CFSG.oddCore CFSG.pPrimeCore
      simp_rw [Nat.coprime_two_left]
    rw [hc]
    exact Nat.coprime_two_left.mp CFSG.pPrimeCore_coprime_card
  obtain ⟨m, hm⟩ := hN.exists_card_eq
  have hdisj : Disjoint N (CFSG.oddCore K) :=
    Subgroup.disjoint_of_coprime_natCard (by
      rw [hm]
      exact Nat.Coprime.pow_left m (Nat.coprime_two_left.mpr hodd))
  intro n hn
  rw [Subgroup.mem_center_iff]
  intro k
  have hc1 : k * n * k⁻¹ * n⁻¹ ∈ N := N.mul_mem (hNn.conj_mem n hn k) (N.inv_mem hn)
  have hc2 : k * n * k⁻¹ * n⁻¹ ∈ CFSG.oddCore K := by
    rw [← QuotientGroup.eq_one_iff]
    have hcomm : π k * π n = π n * π k :=
      (Subgroup.mem_center_iff.mp (hcen ⟨n, hn, rfl⟩) (π k))
    change π (k * n * k⁻¹ * n⁻¹) = 1
    rw [map_mul, map_mul, map_mul, map_inv, map_inv, hcomm]
    group
  have h1 : k * n * k⁻¹ * n⁻¹ = 1 := Subgroup.disjoint_def.mp hdisj hc1 hc2
  calc k * n = k * n * k⁻¹ * n⁻¹ * (n * k) := by group
    _ = n * k := by rw [h1, one_mul]

theorem card_map_of_injective_comp {Y Z : Type*} [Group Y] [Group Z] (f : Y →* Z)
    {E : Subgroup Y} (hf : Function.Injective (f.comp E.subtype)) :
    Nat.card (E.map f) = Nat.card E := by
  rw [show E.map f = (f.comp E.subtype).range by
    rw [MonoidHom.range_comp, Subgroup.range_subtype], MonoidHom.range_eq_map,
    Subgroup.card_map_of_injective hf, Subgroup.card_top]

theorem injective_mk_of_pow_three {X : Type} [Group X] [Finite X] {E : Subgroup X}
    (hE3 : ∀ e ∈ E, e ^ 3 = 1) :
    Function.Injective ((QuotientGroup.mk' (CFSG.pCore 2 X)).comp E.subtype) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro x hx
  have hx2 : (x : X) ∈ CFSG.pCore 2 X := (QuotientGroup.eq_one_iff _).mp hx
  obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := 2) (G := X)) ⟨x, hx2⟩
  have h2 : (x : X) ^ 2 ^ k = 1 := by simpa using congrArg Subtype.val hk
  have h1 : (x : X) = 1 := by
    have := pow_gcd_eq_one.mpr ⟨h2, hE3 x x.2⟩
    rwa [show Nat.gcd (2 ^ k) 3 = 1 from Nat.Coprime.pow_left k (by norm_num), pow_one] at this
  exact Subgroup.mem_bot.mpr (Subtype.ext h1)

theorem sqtkGroup_of_le {G : Type} [Group G] [Finite G] {P L : Subgroup G} (hS : SQTKGroup ↥P)
    (hLP : L ≤ P) : SQTKGroup ↥L := by
  refine ⟨fun p hp hp2 => ?_, ?_⟩
  · have h1 : CFSG.Open.pRank p (⊤ : Subgroup ↥L) ≤ CFSG.Open.pRank p (⊤ : Subgroup ↥P) :=
      CFSG.SectionRank.pRank_top_le_of_injective hp.one_lt (Subgroup.inclusion hLP)
        (Subgroup.inclusion_injective hLP)
    have h2 : CFSG.Open.pRank p (⊤ : Subgroup ↥P) ≤ 2 := hS.1 p hp hp2
    show CFSG.Open.pRank p (⊤ : Subgroup ↥L) ≤ 2
    omega
  · exact (hS.2.subgroup (L.subgroupOf P)).of_mulEquiv (Subgroup.subgroupOfEquivOfLe hLP).symm

theorem isQuasisimple_of_E9 (h36 : A36CoreForSQTKCat) {G : Type} [Group G] [Finite G]
    {H K E : Subgroup G} (hH : SQTKGroup ↥H)
    (hK : CFSG.QuasithinUnique.Id2519.IsTwoComponentIn K H) (hEK : E ≤ K)
    (hE : Nat.card E = 9) (hE3 : ∀ e ∈ E, e ^ 3 = 1) : CFSG.IsQuasisimple ↥K := by
  have hKH : K ≤ H := le_of_mem_cComp hK.1
  set J : Subgroup ↥H := K.subgroupOf H with hJdef
  have hJ : J ∈ cComp (⊤ : Subgroup ↥H) := subgroupOf_mem_cComp hK.1
  set π := QuotientGroup.mk' (CFSG.pCore 2 ↥H) with hπ
  have hQ : SQTKHypCat (↥H ⧸ CFSG.pCore 2 ↥H) := (SQTKHyp.of_sqtkGroup ↥H hH).toCat
  have hJ' : J.map π ∈ cComp (⊤ : Subgroup (↥H ⧸ CFSG.pCore 2 ↥H)) := A318.mem_cComp_quotient hJ
  set EX : Subgroup ↥H := E.subgroupOf H with hEX
  have hEXc : Nat.card EX = 9 := by
    rw [hEX, Nat.card_congr (Subgroup.subgroupOfEquivOfLe (hEK.trans hKH)).toEquiv, hE]
  have hEX3 : ∀ e ∈ EX, e ^ 3 = 1 := fun e he => Subtype.ext (by simpa using hE3 _ he)
  have hEXJ : EX ≤ J := fun x hx => hEK hx
  set EJ : Subgroup ↥(J.map π) := (EX.map π).subgroupOf (J.map π) with hEJ
  have hEJc : Nat.card EJ = 9 := by
    rw [hEJ, Nat.card_congr (Subgroup.subgroupOfEquivOfLe (Subgroup.map_mono hEXJ)).toEquiv,
      card_map_of_injective_comp π (injective_mk_of_pow_three hEX3), hEXc]
  have hEJ3 : ∀ e ∈ EJ, e ^ 3 = 1 := by
    intro e he
    obtain ⟨x, hx, hxe⟩ := he
    have h' : (e : ↥H ⧸ CFSG.pCore 2 ↥H) = π x := hxe.symm
    apply Subtype.ext
    rw [SubgroupClass.coe_pow, OneMemClass.coe_one, h', ← map_pow, hEX3 x hx, map_one]
  have hJq : CFSG.IsQuasisimple ↥(J.map π) := by
    rcases (h36 _ hQ _ hJ').1 with hc | h3 | h4
    · exact hc.1
    · exact (false_of_case34 (Or.inl h3) hEJc hEJ3).elim
    · exact (false_of_case34 (Or.inr h4) hEJc hEJ3).elim
  let ι : ↥K →* ↥H := Subgroup.inclusion hKH
  let f : ↥K →* ↥(J.map π) :=
    (π.comp ι).codRestrict (J.map π) fun k => ⟨ι k, (show (ι k : G) ∈ K from k.2), rfl⟩
  have hf : Function.Surjective f := by
    rintro ⟨_, ⟨j, hj, rfl⟩⟩
    exact ⟨⟨j, hj⟩, rfl⟩
  have hperf : Group.IsPerfect ↥K := Subgroup.isPerfect_iff.mpr (perfect_of_mem_cComp hK.1)
  have hker : f.ker ≤ Subgroup.center ↥K := by
    have hkeq : f.ker = (CFSG.pCore 2 ↥H).comap ι := by
      ext k
      rw [MonoidHom.mem_ker, Subgroup.mem_comap]
      constructor
      · intro h
        exact (QuotientGroup.eq_one_iff _).mp (congrArg Subtype.val h)
      · intro h
        exact Subtype.ext ((QuotientGroup.eq_one_iff _).mpr h)
    rw [hkeq]
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    exact le_center_of_isPGroup_two hK.2 (Subgroup.Normal.comap inferInstance ι)
      (CFSG.pCore_isPGroup.comap_of_injective ι (Subgroup.inclusion_injective hKH))
  exact (CFSG.LocalCores.isQuasisimple_iff_of_surjective hperf f hf hker).mpr hJq

theorem false_of_E9_le_sup {Q : Type} [Group Q] [Finite Q]
    (hrank : CFSG.Open.pRank 3 (⊤ : Subgroup Q) ≤ 2) {A B E : Subgroup Q} {g : Q}
    (hAB : ⁅A, B⁆ = ⊥) (hAB' : A ⊓ B = ⊥) (hB : B = A.map (MulAut.conj g⁻¹).toMonoidHom)
    (hE : E ≤ A ⊔ B) (hEel : IsElemAbelian 3 E) (hEc : Nat.card E = 9)
    (hg : ∀ e ∈ E, g * e = e * g) : False := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hcomm : ∀ a ∈ A, ∀ b ∈ B, a * b = b * a := fun a ha b hb => by
    have h := Subgroup.commutator_mem_commutator ha hb
    rw [hAB, Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm] at h
    exact h
  have hEcomm : ∀ x ∈ E, ∀ y ∈ E, x * y = y * x := fun x hx y hy =>
    congrArg Subtype.val (hEel.1.is_comm.comm ⟨x, hx⟩ ⟨y, hy⟩)
  have hdec : ∀ x ∈ A ⊔ B, ∃ a ∈ A, ∃ b ∈ B, a * b = x := by
    intro x hx
    have hle : A ≤ Subgroup.normalizer (B : Set Q) :=
      ((Subgroup.commutator_eq_bot_iff_le_centralizer).mp hAB).trans
        (Subgroup.centralizer_le_normalizer _)
    rw [← SetLike.mem_coe, Subgroup.coe_mul_of_left_le_normalizer_right A B hle] at hx
    obtain ⟨a, ha, b, hb, rfl⟩ := hx
    exact ⟨a, ha, b, hb, rfl⟩
  have huniq : ∀ a ∈ A, ∀ b ∈ B, ∀ a' ∈ A, ∀ b' ∈ B, a * b = a' * b' → a = a' := by
    intro a ha b hb a' ha' b' hb' h
    have h1 : a'⁻¹ * a = b' * b⁻¹ := by
      calc a'⁻¹ * a = a'⁻¹ * (a * b) * b⁻¹ := by group
        _ = a'⁻¹ * (a' * b') * b⁻¹ := by rw [h]
        _ = b' * b⁻¹ := by group
    have h2 : a'⁻¹ * a ∈ A ⊓ B :=
      ⟨A.mul_mem (A.inv_mem ha') ha, by rw [h1]; exact B.mul_mem hb' (B.inv_mem hb)⟩
    rw [hAB', Subgroup.mem_bot] at h2
    calc a = a' * (a'⁻¹ * a) := by group
      _ = a' := by rw [h2, mul_one]
  have hEA : ∀ x ∈ E, x ∈ A → x = 1 := by
    intro x hxE hxA
    have hxB : x ∈ B := by
      rw [hB]
      refine ⟨x, hxA, ?_⟩
      change g⁻¹ * x * g⁻¹⁻¹ = x
      rw [inv_inv, mul_assoc, ← hg x hxE, ← mul_assoc, inv_mul_cancel, one_mul]
    have : x ∈ A ⊓ B := ⟨hxA, hxB⟩
    rwa [hAB', Subgroup.mem_bot] at this
  have hEB : ∀ x ∈ E, x ∈ B → x = 1 := by
    intro x hxE hxB
    have hxA : x ∈ A := by
      rw [hB] at hxB
      obtain ⟨y, hy, hyx⟩ := hxB
      change g⁻¹ * y * g⁻¹⁻¹ = x at hyx
      have : y = x := by
        calc y = g * (g⁻¹ * y * g⁻¹⁻¹) * g⁻¹ := by group
          _ = g * x * g⁻¹ := by rw [hyx]
          _ = x := by rw [hg x hxE, mul_assoc, mul_inv_cancel, mul_one]
      rwa [← this]
    have : x ∈ A ⊓ B := ⟨hxA, hxB⟩
    rwa [hAB', Subgroup.mem_bot] at this
  obtain ⟨e, he, a, ha, b, hb, hab, haE⟩ : ∃ e ∈ E, ∃ a ∈ A, ∃ b ∈ B, a * b = e ∧ a ∉ E := by
    by_contra hno
    push Not at hno
    have hall : ∀ e ∈ E, e = 1 := by
      intro e he
      obtain ⟨a, ha, b, hb, hab⟩ := hdec e (hE he)
      have ha1 : a = 1 := hEA a (hno e he a ha b hb hab) ha
      rw [ha1, one_mul] at hab
      exact hEB e he (hab ▸ hb)
    have hbot : E = ⊥ := eq_bot_iff.mpr fun x hx => Subgroup.mem_bot.mpr (hall x hx)
    rw [hbot, Subgroup.card_bot] at hEc
    norm_num at hEc
  have ha3 : a ^ 3 = 1 := by
    have he3 : e ^ 3 = 1 := hEel.2 e he
    have hc : Commute a b := hcomm a ha b hb
    rw [← hab, hc.mul_pow] at he3
    have h1 : a ^ 3 = (b ^ 3)⁻¹ := eq_inv_of_mul_eq_one_left he3
    have h2 : a ^ 3 ∈ A ⊓ B :=
      ⟨A.pow_mem ha 3, by rw [h1]; exact B.inv_mem (B.pow_mem hb 3)⟩
    rwa [hAB', Subgroup.mem_bot] at h2
  have haC : ∀ f ∈ E, a * f = f * a := by
    intro f hf
    obtain ⟨a', ha', b', hb', hf'⟩ := hdec f (hE hf)
    have hef : e * f = f * e := hEcomm e he f hf
    rw [← hab, ← hf'] at hef
    have e1 : a * b * (a' * b') = a * a' * (b * b') := by
      calc a * b * (a' * b') = a * (b * a') * b' := by group
        _ = a * (a' * b) * b' := by rw [hcomm a' ha' b hb]
        _ = a * a' * (b * b') := by group
    have e2 : a' * b' * (a * b) = a' * a * (b' * b) := by
      calc a' * b' * (a * b) = a' * (b' * a) * b := by group
        _ = a' * (a * b') * b := by rw [hcomm a ha b' hb']
        _ = a' * a * (b' * b) := by group
    rw [e1, e2] at hef
    have haa : a * a' = a' * a := huniq _ (A.mul_mem ha ha') _ (B.mul_mem hb hb') _
      (A.mul_mem ha' ha) _ (B.mul_mem hb' hb) hef
    rw [← hf']
    calc a * (a' * b') = a * a' * b' := by group
      _ = a' * a * b' := by rw [haa]
      _ = a' * (a * b') := by group
      _ = a' * (b' * a) := by rw [hcomm a ha b' hb']
      _ = a' * b' * a := by group
  have ha1 : a ≠ 1 := fun h => haE (h ▸ E.one_mem)
  have hao : orderOf a = 3 := orderOf_eq_prime ha3 ha1
  have hZc : Nat.card (Subgroup.zpowers a) = 3 ^ 1 := by
    rw [Nat.card_zpowers, hao, pow_one]
  have hZel : IsElemAbelian 3 (Subgroup.zpowers a) := by
    refine ⟨inferInstance, fun x hx => ?_⟩
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, ha3, one_zpow]
  have hEZ : E ⊓ Subgroup.zpowers a = ⊥ := by
    have hd : Nat.card ↥(E ⊓ Subgroup.zpowers a) ∣ 3 := by
      rw [← hao, ← Nat.card_zpowers]
      exact Subgroup.card_dvd_of_le inf_le_right
    rcases (Nat.dvd_prime Nat.prime_three).mp hd with h1 | h3
    · exact Subgroup.card_eq_one.mp h1
    · exfalso
      have heq : E ⊓ Subgroup.zpowers a = Subgroup.zpowers a :=
        Subgroup.eq_of_le_of_card_ge inf_le_right (by rw [Nat.card_zpowers, hao, h3])
      apply haE
      have : a ∈ E ⊓ Subgroup.zpowers a := by
        rw [heq]
        exact Subgroup.mem_zpowers a
      exact this.1
  have hsum := A320.pRank_add_le (⊥ : Subgroup Q) (by rw [Subgroup.card_bot]; norm_num) hEel
    hZel
    (fun x hx z hz => by
      rw [Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm]
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hz
      exact ((Commute.zpow_left (haC x hx) k).symm : Commute x (a ^ k)))
    (fun x hx z hz hxz => by
      rw [Subgroup.mem_bot] at hxz
      have hzx : z = x⁻¹ := eq_inv_of_mul_eq_one_right hxz
      have hz1 : z = 1 := by
        have : z ∈ E ⊓ Subgroup.zpowers a := ⟨hzx ▸ E.inv_mem hx, hz⟩
        rwa [hEZ, Subgroup.mem_bot] at this
      refine ⟨?_, hz1⟩
      rw [hz1] at hzx
      exact inv_eq_one.mp hzx.symm)
    (a := 2) (b := 1) (by rw [hEc]; norm_num) hZc
  have := hsum.trans hrank
  omega

theorem false_of_moved (h38 : A38ForSQTKCat) {X : Type} [Group X] [Finite X] (hX : SQTKGroup X)
    {J P E : Subgroup X} (hJ : J ∈ cComp (⊤ : Subgroup X)) (hP : IsPGroup 2 P) {p : X}
    (hp : p ∈ P) (hpJ : CFSG.conjugate J p ≠ J) (hEJ : E ≤ I31.orbitSubP P J)
    (hEC : E ≤ Subgroup.centralizer (P : Set X)) (hEel : IsElemAbelian 3 E)
    (hEc : Nat.card E = 9) : False := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set π := QuotientGroup.mk' (CFSG.pCore 2 X) with hπ
  have hQ : SQTKHyp (X ⧸ CFSG.pCore 2 X) := SQTKHyp.of_sqtkGroup X hX
  have h38Q : A38Part3 (X ⧸ CFSG.pCore 2 X) := h38 _ hQ.toCat
  have hsolv : Group.IsSolvable π.ker := by
    rw [hπ, QuotientGroup.ker_mk']
    exact A320.isSolvable_pCore_two X
  have hJ' : J.map π ∈ cComp (⊤ : Subgroup (X ⧸ CFSG.pCore 2 X)) := A318.mem_cComp_quotient hJ
  have hconjC : ∀ q : X, CFSG.conjugate J q ∈ cComp (⊤ : Subgroup X) := fun q => by
    have := cComp_map_mulEquiv (MulAut.conj q⁻¹) hJ
    rwa [Subgroup.map_top_of_surjective _ (MulAut.conj q⁻¹).surjective] at this
  have hmapc : ∀ q : X, (CFSG.conjugate J q).map π = CFSG.conjugate (J.map π) (π q) :=
    fun q => CFSG.QuasithinUnique.I32.map_conjugate π J q
  have hpJ' : CFSG.conjugate (J.map π) (π p) ≠ J.map π := by
    rw [← hmapc]
    intro h
    exact hpJ (map_injOn_cComp_top π hsolv (hconjC p) hJ h)
  obtain ⟨S, hS⟩ := (hP.map π).exists_le_sylow
  have hT : CFSG.QuasithinUnique.IsSylowTwoOf (S : Subgroup (X ⧸ CFSG.pCore 2 X)) ⊤ :=
    ⟨le_top, S.isPGroup', by
      rw [← Subgroup.relIndex, Subgroup.relIndex_top_right]
      exact S.not_dvd_index⟩
  have hmemT : ∀ q ∈ P, CFSG.conjugate (J.map π) (π q) ∈
      conjSubgroupsBy (S : Subgroup (X ⧸ CFSG.pCore 2 X)) (J.map π) :=
    fun q hq => ⟨(π q)⁻¹, inv_mem (hS ⟨q, hq, rfl⟩), rfl⟩
  rcases (h38Q _ hJ').2 _ hT with ⟨-, hset, -⟩ | ⟨t, -, -, hset, -, hcomm, hinter, -, -⟩
  · apply hpJ'
    have := hmemT p hp
    rw [hset] at this
    exact this
  set B := (J.map π).map (MulAut.conj t).toMonoidHom with hBdef
  have hmem2 : ∀ q ∈ P, CFSG.conjugate (J.map π) (π q) = J.map π ∨
      CFSG.conjugate (J.map π) (π q) = B := by
    intro q hq
    have := hmemT q hq
    rw [hset] at this
    simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using this
  have hpB : CFSG.conjugate (J.map π) (π p) = B := (hmem2 p hp).resolve_left hpJ'
  have horb : (I31.orbitSubP P J).map π ≤ J.map π ⊔ B := by
    unfold I31.orbitSubP
    rw [Subgroup.map_iSup]
    refine iSup_le fun q => ?_
    rw [Subgroup.map_iSup]
    refine iSup_le fun hq => ?_
    rw [hmapc]
    rcases hmem2 q hq with h | h
    · rw [h]
      exact le_sup_left
    · rw [h]
      exact le_sup_right
  refine false_of_E9_le_sup (hQ.pRank_le ⊤ Nat.prime_three (by norm_num)) hcomm hinter
    (g := π p) hpB.symm ((Subgroup.map_mono hEJ).trans horb)
    (CFSG.SectionRank.isElemAbelian_map hEel π)
    (by rw [card_map_of_injective_comp π (injective_mk_of_pow_three hEel.2), hEc]) ?_
  rintro _ ⟨e, he, rfl⟩
  rw [← map_mul, ← map_mul, (Subgroup.mem_centralizer_iff.mp (hEC he) p hp)]

end I313

open I313 in
theorem as_I_3_1_three_of (h36 : A36CoreForSQTKCat) (h38 : A38ForSQTKCat) :
    CFSG.Quasithin.E6.AS_I_3_1_three := by
  intro G _ _ H P L hH hPH hP hL hm3
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hHs : SQTKGroup ↥H := ⟨CFSG.SectionRank.isStronglyQuasithin_iff.mp hH.1, hH.2⟩
  obtain ⟨E, hEL, hEel, hEc⟩ := CFSG.SectionRank.exists_pRank (p := 3) (by norm_num) L
  rw [hm3] at hEc
  have hE9 : Nat.card E = 9 := by rw [hEc]; norm_num
  have hE3 : ∀ e ∈ E, e ^ 3 = 1 := hEel.2
  have hLZ : L ≤ H ⊓ Subgroup.centralizer (P : Set G) := le_of_mem_cComp hL.1
  have hLH : L ≤ H := hLZ.trans inf_le_left
  let P' : Subgroup ↥H := P.subgroupOf H
  have hP' : IsPGroup 2 P' := hP.comap_of_injective H.subtype H.subtype_injective
  let C : Subgroup ↥H := (H ⊓ Subgroup.centralizer (P : Set G)).subgroupOf H
  have hC : C = Subgroup.centralizer (P' : Set ↥H) := by
    ext x
    rw [Subgroup.mem_subgroupOf, Subgroup.mem_inf, Subgroup.mem_centralizer_iff,
      Subgroup.mem_centralizer_iff]
    constructor
    · rintro ⟨-, hx⟩ p hp
      exact Subtype.ext (hx p hp)
    · intro hx
      refine ⟨x.2, fun p hp => ?_⟩
      exact congrArg Subtype.val (hx ⟨p, hPH hp⟩ hp)
  let LX : Subgroup ↥H := L.subgroupOf H
  have hLX : LX.map H.subtype = L := Subgroup.map_subgroupOf_eq_of_le hLH
  have hLXC : LX ≤ C := fun x hx => hLZ hx
  have hLtwo : CFSG.ComponentClassification.TwoComponents.IsTwoComponent (LX.subgroupOf C) := by
    let e : ↥C ≃* ↥(H ⊓ Subgroup.centralizer (P : Set G)) :=
      Subgroup.subgroupOfEquivOfLe inf_le_left
    have h1 := (CFSG.QuasithinUnique.I32.isTwoComponentIn_iff hLZ).mp hL
    have hmap : (LX.subgroupOf C).map e.toMonoidHom =
        L.subgroupOf (H ⊓ Subgroup.centralizer (P : Set G)) := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        exact ⟨⟨⟨x.1, x.2.1⟩, x.2⟩, hx, rfl⟩
    exact (CFSG.ComponentClassification.TwoComponentTransport.equiv_iff e _).mp
      (by rw [hmap]; exact h1)
  obtain ⟨J, hJ, hKJ⟩ := I31.abstract_I31 hP' hC hLXC hLtwo
  have hLK : LX ≤ CFSG.QuasithinUnique.I32.normalClosureLayer LX := by
    unfold CFSG.QuasithinUnique.I32.normalClosureLayer
    exact le_iSup₂_of_le (1 : ↥H) (Subgroup.one_mem _)
      (CFSG.QuasithinUnique.BenderBranch.conjugate_one LX).ge
  set K : Subgroup G := J.map H.subtype with hKdef
  have hJH : K.subgroupOf H = J := Subgroup.comap_map_eq_self_of_injective H.subtype_injective J
  have hKH : K ≤ H := Subgroup.map_subtype_le J
  have hK2 : CFSG.QuasithinUnique.Id2519.IsTwoComponentIn K H :=
    (CFSG.QuasithinUnique.I32.isTwoComponentIn_iff hKH).mpr (by rw [hJH]; exact hJ)
  have hJc : J ∈ cComp (⊤ : Subgroup ↥H) := hJH ▸ subgroupOf_mem_cComp hK2.1
  set EX : Subgroup ↥H := E.subgroupOf H with hEX
  have hEXc : Nat.card EX = 9 := by
    rw [hEX, Nat.card_congr (Subgroup.subgroupOfEquivOfLe (hEL.trans hLH)).toEquiv, hE9]
  have hEXel : IsElemAbelian 3 EX := by
    refine ⟨⟨⟨fun x y => ?_⟩⟩, fun x hx => ?_⟩
    · have h := hEel.1.is_comm.comm (⟨((x : ↥H) : G), x.2⟩ : E) ⟨((y : ↥H) : G), y.2⟩
      have h' : ((x : ↥H) : G) * ((y : ↥H) : G) = ((y : ↥H) : G) * ((x : ↥H) : G) :=
        congrArg Subtype.val h
      exact Subtype.ext (Subtype.ext h')
    · exact Subtype.ext (by simpa using hE3 _ hx)
  have hEXLX : EX ≤ LX := fun x hx => hEL hx
  have hEXC : EX ≤ Subgroup.centralizer (P' : Set ↥H) := hC ▸ hEXLX.trans hLXC
  have hinv : ∀ p ∈ P', CFSG.conjugate J p = J := by
    by_contra hne
    push Not at hne
    obtain ⟨p, hp, hpJ⟩ := hne
    exact false_of_moved h38 hHs hJc hP' hp hpJ (hEXLX.trans (hLK.trans hKJ.le)) hEXC hEXel
      hEXc
  have horb : I31.orbitSubP P' J = J :=
    le_antisymm (iSup₂_le fun p hp => (hinv p hp).le) (I31.le_orbitSubP P' J)
  have hLJ : LX ≤ J := hLK.trans (hKJ.le.trans horb.le)
  have hLK' : L ≤ K := by
    rw [← hLX]
    exact Subgroup.map_mono hLJ
  have hrank : 1 < CFSG.Open.pRank 3 J := by
    have h2 : 2 ≤ CFSG.Open.pRank 3 J :=
      CFSG.SectionRank.le_pRank (by norm_num) (hEXLX.trans hLJ) hEXel (k := 2)
        (by rw [hEXc]; norm_num)
    omega
  have hJn : J.Normal := A318.normal_of_pRank_gt_one hHs (h38 _ (SQTKHyp.of_sqtkGroup _ hHs).toCat)
    hJc Nat.prime_three (by norm_num) hrank
  refine ⟨K, hK2, hLK', hJH ▸ hJn, ?_, ?_⟩
  · exact isQuasisimple_of_E9 h36 (sqtkGroup_of_le hHs inf_le_left) hL hEL hE9 hE3
  · exact isQuasisimple_of_E9 h36 hHs hK2 (hEL.trans hLK') hE9 hE3

end CFSG.Quasithin.VolI
