theorem card_G5' : Nat.card G5 = 9999360 := by
  have hdet : ∀ g : GL (Fin 5) (ZMod 2), (g : Matrix (Fin 5) (Fin 5) (ZMod 2)).det = 1 := by
    intro g
    have h : (g : Matrix (Fin 5) (Fin 5) (ZMod 2)).det ≠ 0 := by
      rw [← Matrix.GeneralLinearGroup.val_det_apply]
      exact Units.ne_zero _
    generalize (g : Matrix (Fin 5) (Fin 5) (ZMod 2)).det = a at h ⊢
    revert a
    decide
  let e : G5 ≃ GL (Fin 5) (ZMod 2) :=
    { toFun := Matrix.SpecialLinearGroup.toGL
      invFun := fun g => ⟨g, hdet g⟩
      left_inv := fun _ => Subtype.ext rfl
      right_inv := fun _ => Units.ext (Matrix.SpecialLinearGroup.coe_GL_coe_matrix _) }
  rw [Nat.card_congr e, Matrix.card_GL_field, ZMod.card, Fin.prod_univ_five]
  norm_num [Fin.val_zero, Fin.val_one, Fin.val_two]

theorem exists_conj_le_Ugrp {B : Subgroup G5} (hB : IsPGroup 2 B) :
    ∃ h : G5, ∀ b ∈ B, h * b * h⁻¹ ∈ Ugrp := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨P, hP⟩ := hB.exists_le_sylow
  have hUi : ¬ 2 ∣ Ugrp.index := by
    have h := Ugrp.index_mul_card
    rw [card_Ugrp, card_G5'] at h
    generalize Ugrp.index = n at h ⊢
    have h' : n * 1024 = 9999360 := by rw [← h]; norm_num
    have h9765 : n = 9765 := by omega
    subst h9765
    decide
  obtain ⟨h, hh⟩ := MulAction.exists_smul_eq G5 P (isPGroup_Ugrp.toSylow hUi)
  have h1 : MulAut.conj h • (P : Subgroup G5) = Ugrp :=
    congrArg (fun P : Sylow 2 G5 => (P : Subgroup G5)) hh
  refine ⟨h, fun b hb => ?_⟩
  rw [← h1]
  have h2 := Subgroup.smul_mem_pointwise_smul b (MulAut.conj h) (P : Subgroup G5) (hP hb)
  rwa [MulAut.smul_def, MulAut.conj_apply] at h2

@[expose] def upB (e : ℕ) : BM :=
  ![1 + 2 * (e % 2) + 4 * (e / 2 % 2) + 8 * (e / 4 % 2) + 16 * (e / 8 % 2),
    2 + 4 * (e / 16 % 2) + 8 * (e / 32 % 2) + 16 * (e / 64 % 2),
    4 + 8 * (e / 128 % 2) + 16 * (e / 256 % 2), 8 + 16 * (e / 512 % 2), 16]

@[expose] def codeU (c₀ c₁ c₂ c₃ c₄ c₅ c₆ c₇ c₈ c₉ : ZMod 2) : ℕ :=
  c₀.val + 2 * c₁.val + 4 * c₂.val + 8 * c₃.val + 16 * c₄.val + 32 * c₅.val + 64 * c₆.val +
    128 * c₇.val + 256 * c₈.val + 512 * c₉.val

theorem toMat_upB_codeU : ∀ c₀ c₁ c₂ c₃ c₄ c₅ c₆ c₇ c₈ c₉ : ZMod 2,
    toMat (upB (codeU c₀ c₁ c₂ c₃ c₄ c₅ c₆ c₇ c₈ c₉)) = upMat c₀ c₁ c₂ c₃ c₄ c₅ c₆ c₇ c₈ c₉ := by
  decide +kernel

