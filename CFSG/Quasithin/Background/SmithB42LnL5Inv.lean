@[expose] def InvGood (M : Matrix (Fin 5) (Fin 5) (ZMod 2)) (e : ℕ) : Prop :=
  match invTab.find? (fun t => t.1 = e) with
  | some t => toMat t.2.1 * toMat t.2.2 = 1 ∧
      (toMat t.2.1 * M * toMat t.2.2 = t0M ∨ toMat t.2.1 * M * toMat t.2.2 = s0M)
  | none => False

instance (M : Matrix (Fin 5) (Fin 5) (ZMod 2)) (e : ℕ) : Decidable (InvGood M e) := by
  unfold InvGood
  split <;> infer_instance

