theorem invTab_spec : ∀ c₀ c₁ c₂ c₃ c₄ c₅ c₆ c₇ c₈ c₉ : ZMod 2,
    upMat c₀ c₁ c₂ c₃ c₄ c₅ c₆ c₇ c₈ c₉ * upMat c₀ c₁ c₂ c₃ c₄ c₅ c₆ c₇ c₈ c₉ = 1 →
    upMat c₀ c₁ c₂ c₃ c₄ c₅ c₆ c₇ c₈ c₉ ≠ 1 →
    InvGood (upMat c₀ c₁ c₂ c₃ c₄ c₅ c₆ c₇ c₈ c₉) (codeU c₀ c₁ c₂ c₃ c₄ c₅ c₆ c₇ c₈ c₉) := by
  decide +kernel

theorem exists_conj_of_mem_Ugrp {u : G5} (hu : u ∈ Ugrp) (hu2 : u * u = 1) (hu1 : u ≠ 1) :
    ∃ g : G5, g * u * g⁻¹ = t0 ∨ g * u * g⁻¹ = s0 := by
  have hU : IsUpU (u : Matrix (Fin 5) (Fin 5) (ZMod 2)) := hu
  have hM := eq_upMat hU
  have h2 : (u : Matrix (Fin 5) (Fin 5) (ZMod 2)) * (u : Matrix (Fin 5) (Fin 5) (ZMod 2)) = 1 := by
    rw [← Matrix.SpecialLinearGroup.coe_mul, hu2, Matrix.SpecialLinearGroup.coe_one]
  have h1 : (u : Matrix (Fin 5) (Fin 5) (ZMod 2)) ≠ 1 := fun h => hu1 (Subtype.ext h)
  have hspec := invTab_spec _ _ _ _ _ _ _ _ _ _ (hM ▸ h2) (hM ▸ h1)
  rw [← hM] at hspec
  unfold InvGood at hspec
  split at hspec
  · rename_i t _
    obtain ⟨hgi, hc⟩ := hspec
    have hig : toMat t.2.2 * toMat t.2.1 = 1 :=
      (mul_eq_one_comm_of_card_eq (Fin 5) (Fin 5) (ZMod 2) rfl).mp hgi
    refine ⟨ofMatInv (toMat t.2.1) (toMat t.2.2) hgi, ?_⟩
    rw [inv_ofMatInv hgi hig]
    rcases hc with hc | hc
    · left
      apply Subtype.ext
      exact hc
    · right
      apply Subtype.ext
      exact hc
  · exact hspec.elim

theorem exists_conj_t0_or_s0 {u : G5} (hu2 : u * u = 1) (hu1 : u ≠ 1) :
    ∃ g : G5, g * u * g⁻¹ = t0 ∨ g * u * g⁻¹ = s0 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hord : orderOf u = 2 := orderOf_eq_prime (by rw [pow_two, hu2]) hu1
  have hQ : IsPGroup 2 (Subgroup.zpowers u) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hord, pow_one])
  obtain ⟨h, hh⟩ := exists_conj_le_Ugrp hQ
  have hmem := hh u (Subgroup.mem_zpowers u)
  have h2 : h * u * h⁻¹ * (h * u * h⁻¹) = 1 := by
    calc h * u * h⁻¹ * (h * u * h⁻¹) = h * (u * u) * h⁻¹ := by group
      _ = 1 := by rw [hu2]; group
  have h1 : h * u * h⁻¹ ≠ 1 := fun h0 => hu1 (by
    calc u = h⁻¹ * (h * u * h⁻¹) * h := by group
      _ = 1 := by rw [h0]; group)
  obtain ⟨g, hg⟩ := exists_conj_of_mem_Ugrp hmem h2 h1
  refine ⟨g * h, ?_⟩
  have e : g * h * u * (g * h)⁻¹ = g * (h * u * h⁻¹) * g⁻¹ := by group
  rw [e]
  exact hg

end CFSG.Quasithin.B42Ln
