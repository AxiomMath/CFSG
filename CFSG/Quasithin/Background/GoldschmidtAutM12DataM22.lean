  have h : (permSubRep 22 NativeSporadic.M22).rel (posWord ag (words.getD a []))
      (lwordD compL (List.range 22) xl (words.getD a [])) :=
    rel_posWord (permSubRep 22 NativeSporadic.M22) ag xl hx _ (hw a ha)
  rwa [hwords a ha] at h

theorem hasTwoE16_m22 (Q : Sylow 2 ↥NativeSporadic.M22) :
    HasTwoE16 ↥(Q : Subgroup ↥NativeSporadic.M22) :=
  hasTwoE16_of_rep (permSubRep 22 NativeSporadic.M22) data ok gens hgd Q

