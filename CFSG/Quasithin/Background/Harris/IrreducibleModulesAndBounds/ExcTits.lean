section Main


theorem tits_dim_bound (W : Type) [CommGroup W] [Finite W] (hW : ∀ w : W, w * w = 1)
    (σ : titsD →* MulAut W) (hσ : Function.Injective σ) : 2 ^ 24 ≤ Nat.card W := by
  let L : Subgroup (MulAut W) := σ.range
  let e0 : titsD ≃* L := MonoidHom.ofInjective hσ
  have hZL : Subgroup.center L = ⊥ := center_eq_bot_of_mulEquiv_generic e0.symm titsD_center
  let e : (↥L ⧸ Subgroup.center ↥L) ≃* titsD :=
    ((QuotientGroup.quotientMulEquivOfEq hZL).trans (QuotientGroup.quotientBot (G := ↥L))).trans
      e0.symm
  obtain ⟨y, hy⟩ := modelProj_surjective L e (titsI * titsI)
  have hyy : y * y = 1 := modelProj_injective L hZL e (by
    rw [map_mul, hy, map_one]; exact titsI_pow_four)
  have hidx := two_pow_le_index_titsT hW L hZL e (x := y) (by rw [hy]; exact isConj_titsTD)
  calc 2 ^ 24 = (2 ^ 12) ^ 2 := by norm_num
    _ ≤ (fixV (Subgroup.zpowers (y : MulAut W))).index ^ 2 := Nat.pow_le_pow_left hidx 2
    _ ≤ Nat.card W := index_fixV_sq_le_card hW (congrArg Subtype.val hyy)

theorem tits_rank_bound :
    ∀ B : Subgroup (MulAut titsD), (∀ x ∈ B, ∀ y ∈ B, x * y = y * x) →
      (∀ x ∈ B, x * x = 1) → Nat.card B ≤ 2 ^ 5 := by
  have h5 : TwistedF4RankLeFive :=
    twistedF4RankLeFive_of_check CFSG.Quasithin.F112S.titsRankCheck_cert
  refine rank_transport (MulAut.congr quasithinTitsEquivD.symm) ?_
  intro B hBc hB2
  exact h5 B ⟨⟨⟨fun x y => Subtype.ext (hBc _ x.2 _ y.2)⟩⟩, fun x hx => by
    rw [sq]; exact hB2 x hx⟩

theorem false_of_tits {Γ A L : Subgroup (GLV V)} {m : ℕ} (h : G93Hyp Γ A L L m)
    (hX : ReeTitsModel (↥L ⧸ Subgroup.center ↥L) .Tits 2 1) : False := by
  obtain ⟨e⟩ := titsModelEquiv _ 2 1 hX
  obtain ⟨K, _, _, _, hK, ⟨e'⟩⟩ := CFSG.SectionRank.exists_mulEquiv_titsGroup_of_model hX
  refine false_of_cover_rank_dim h e ?_ (r := 5) tits_rank_bound (ρ := 24)
    (fun W _ _ hW σ hσ => tits_dim_bound W hW σ hσ) (by norm_num)
  intro E _ _ _ π hπ hC hodd
  have e'' : titsD ≃* commutator (reeFixed ReeTag.F4 K 0) := e.symm.trans e'
  have hk : (e''.toMonoidHom.comp π).ker = π.ker := by
    ext x; simp
  have := CFSG.SectionRank.Tits_perfect_odd_cover_trivial (K := K) hK
    (e''.toMonoidHom.comp π) (e''.surjective.comp hπ) (by rw [hk]; exact hC)
    (by rw [hk]; exact hodd)
  rwa [hk] at this

