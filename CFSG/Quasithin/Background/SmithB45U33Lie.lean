@[expose] def uaT : (Matrix (Fin 14) (Fin 14) (ZMod 2))ˣ where
  val := untab laT
  inv := untab laT * untab laT
  val_inv := by decide +kernel
  inv_val := by decide +kernel

@[expose] def ubT : (Matrix (Fin 14) (Fin 14) (ZMod 2))ˣ where
  val := untab lbT
  inv := untab lbT * untab lbT
  val_inv := by decide +kernel
  inv_val := by decide +kernel

@[expose] def mFree : FreeGroup (Fin 2) →* Matrix (Fin 14) (Fin 14) (ZMod 2) :=
  (Units.coeHom _).comp (FreeGroup.lift ![uaT, ubT])

@[expose] def certLie : NortonData (FreeGroup (Fin 2)) (ZMod 2) 14 where
  terms := certTerms
  Q := certQT
  Qi := certQiT
  R := certRT
  S := certST
  Si := certSiT
  spin := certSpin
  w := certWV
  T := certTT
  Ti := certTiT
  dual := certDual

theorem certLie_check : certLie.check (fun g => tab (mFree g)) = true := by decide +kernel

theorem isIrreducible_mFree {E : Type*} [Field E] (φ : ZMod 2 →+* E) :
    (matrixBaseChange φ mFree).IsIrreducible :=
  certLie.isIrreducible_of_check φ mFree (fun g => tab (mFree g)) (fun _ => untab_tab _)
    certLie_check

@[expose] def lieOfQ (Q : Matrix Ix3 Ix3 (ZMod 2)) : Matrix LIdx LIdx (ZMod 2) :=
  ((Q ⊗ₖ Q) * secL (ZMod 2)).submatrix lP id

theorem repLie_eq_lieOfQ (g : ↥(cayleyGroup (ZMod 2))) : repLie g = lieOfQ (repQ g) := rfl

theorem repQ_eq_submatrix (g : ↥(cayleyGroup (ZMod 2))) :
    repQ g = (cmat g).submatrix embQ embQ := by
  ext i j
  rw [repQ_apply, g2Act_eq_mulVec, Matrix.mulVec_single_one]
  rfl

theorem lieOfQ_A : lieOfQ (matA2.submatrix embQ embQ) = untab laT := by decide +kernel

theorem lieOfQ_B : lieOfQ (matB2.submatrix embQ embQ) = untab lbT := by decide +kernel


theorem repLie_g2a : repLie g2a = untab laT := by
  rw [repLie_eq_lieOfQ, repQ_eq_submatrix, cmat_g2a, lieOfQ_A]

theorem repLie_g2b : repLie g2b = untab lbT := by
  rw [repLie_eq_lieOfQ, repQ_eq_submatrix, cmat_g2b, lieOfQ_B]

theorem mFree_of_zero : mFree (FreeGroup.of 0) = untab laT := by
  simp only [mFree, MonoidHom.comp_apply, FreeGroup.lift_apply_of, Units.coeHom_apply]
  rw [show (![uaT, ubT] : Fin 2 → _) 0 = uaT from rfl]
  rfl

theorem mFree_of_one : mFree (FreeGroup.of 1) = untab lbT := by
  simp only [mFree, MonoidHom.comp_apply, FreeGroup.lift_apply_of, Units.coeHom_apply]
  rw [show (![uaT, ubT] : Fin 2 → _) 1 = ubT from rfl]
  rfl

theorem repLie_lift (w : FreeGroup (Fin 2)) :
    repLie (FreeGroup.lift ![g2a, g2b] w) = mFree w := by
  have h : (repLie : ↥(cayleyGroup (ZMod 2)) →* _).comp (FreeGroup.lift ![g2a, g2b]) = mFree := by
    refine FreeGroup.ext_hom _ _ fun i => ?_
    match i with
    | 0 =>
      rw [MonoidHom.comp_apply, FreeGroup.lift_apply_of, mFree_of_zero]
      exact repLie_g2a
    | 1 =>
      rw [MonoidHom.comp_apply, FreeGroup.lift_apply_of, mFree_of_one]
      exact repLie_g2b
  rw [← h, MonoidHom.comp_apply]

end CFSG.Quasithin.B45U33
