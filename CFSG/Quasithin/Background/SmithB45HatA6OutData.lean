@[expose] def wOK (e : List Nat × List Nat × Nat × Nat × Nat × Nat) : Bool :=
  let g := cmul e.1 e.2.1
  pslLit.contains e.2.1 && decide (e.2.2.1 < 3) && decide (e.2.2.2.1 < 3) &&
    decide (e.2.2.2.2.1 < 3) && decide (e.2.2.2.2.2 < 3) &&
    conjC g xC == qC e.2.2.1 e.2.2.2.1 && conjC g yC == qC e.2.2.2.2.1 e.2.2.2.2.2 &&
    (e.2.2.1 * e.2.2.2.2.2 + 2 * (e.2.2.2.1 * e.2.2.2.2.1)) % 3 != 1

@[expose] def f1Check : Bool :=
  autL.all fun c => cmul c c != cid || pslLit.contains c || f1Tab.any fun e => e.1 == c && wOK e

theorem f1Check_true : f1Check = true := by decide +kernel

