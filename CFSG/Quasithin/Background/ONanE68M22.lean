theorem hexad_excl_aux (hC129 : ∀ (G : Type) [Group G] [Finite G], ASC129Statement G)
    (hSpor : Ch1.SporadicAutInner) {s : TauCeti.SporadicName}
    (hs : Ch1.IsLemma115SporadicName s) {m : ℕ} (hpar : HexadPar (NativeSporadic.Carrier s) m)
    (hsimp : IsSimpleGroup (alternatingGroup (Fin m)))
    (hcard : Nat.card (alternatingGroup (Fin m)) = 360 ∨
      Nat.card (alternatingGroup (Fin m)) = 2520)
    (h : HypE61 T M V) (hU : U ∈ gammaE64 V M)
    (hL : IsComponentIn L (Subgroup.centralizer (U : Set G)))
    (hQN : T ⊓ Subgroup.centralizer (V : Set G) ≤ Subgroup.normalizer (L : Set G))
    (e : (↥L ⧸ CFSG.pCore 2 ↥L) ≃* NativeSporadic.Carrier s) : False := by
  have hq : CFSG.IsQuasisimple ↥L := BenderBranch.isQuasisimple_of_isComponentIn hL
  have hQH := e6_5_one h hU
  have hSyl : IsSylowTwoOf ((T ⊓ Subgroup.centralizer (V : Set G)) ⊓ L) L :=
    RankOneRecog.isSylowTwoOf_inf_of_subnormal hQH hL.1 hL.2.2
  obtain ⟨K, hKL, -, hQK, hchar, hno, hres, hmax, -, hcentr⟩ :=
    exists_hexad_lift hpar hsimp hcard hq h.isPGroup_Q hQN hSyl ⟨e⟩
  have hKH : K ≤ Subgroup.centralizer (U : Set G) := hKL.trans hL.1
  have hKM : K ≤ M := (dich hC129 h hU hKH hQK hchar).resolve_right hno
  have hLM := not_le_of_component h hU.1 hL
  have hKLM : L ⊓ M = K := by
    rcases hmax (L ⊓ M) (le_inf hKL hKM) inf_le_left with e' | e'
    · exact e'
    · exact absurd (e' ▸ inf_le_right) hLM
  obtain ⟨-, hres', -⟩ := sandwich h hU hL
  rw [hKLM] at hres'
  have hKV : ∀ k ∈ K, ∀ a ∈ V, a * k = k * a := fun k hk a ha =>
    Subgroup.mem_centralizer_iff.1 (hres' (hres hk)).2 a ha
  have hbase := baseHyp h hU hL
  have : Group.IsPerfect ↥L := hq.1
  have hperf : commutator ↥L = ⊤ := Group.isPerfect_def.mp hq.1
  have hNc : CFSG.pCore 2 ↥L ≤ Subgroup.center ↥L := pCore_two_le_center hq.2.1
  have hVC : V ≤ Subgroup.centralizer (L : Set G) := by
    intro a ha
    have haN : a ∈ Subgroup.normalizer (L : Set G) := leN_base hbase ha
    set β : MulAut (↥L ⧸ CFSG.pCore 2 ↥L) :=
      qAut (CFSG.pCore 2 ↥L) (conjOn L a haN) with hβ
    have hββ : ∀ x, β (β x) = x := by
      have h1 : β * β = 1 := by
        rw [hβ, ← CFSG.Quasithin.H13.KG68.quotAut_mul, conjOn_sq_base hbase ha,
          CFSG.Quasithin.H13.KG68.quotAut_one]
      intro x
      have := congrArg (fun φ : MulAut (↥L ⧸ CFSG.pCore 2 ↥L) => φ x) h1
      simpa using this
    have hfix : ∃ P : Sylow 2 (↥L ⧸ CFSG.pCore 2 ↥L), ∀ t ∈ (P : Subgroup _), β t = t := by
      have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
      refine ⟨(sylowInB hbase).mapSurjective (QuotientGroup.mk'_surjective (CFSG.pCore 2 ↥L)), ?_⟩
      intro t ht
      rw [Sylow.coe_mapSurjective] at ht
      obtain ⟨x, hx, rfl⟩ := ht
      have := conjOn_fix_base hbase ha hx
      show qAut (CFSG.pCore 2 ↥L) (conjOn L a haN) (x : ↥L ⧸ CFSG.pCore 2 ↥L) = _
      rw [CFSG.Quasithin.H13.KG68.quotAut_mk, this]
      rfl
    obtain ⟨hsq, hne⟩ := isSQTK_of_isLemma115 hs
    obtain ⟨g, hg⟩ := hSpor s hsq hne (↥L ⧸ CFSG.pCore 2 ↥L) ⟨e⟩ β hββ hfix
    obtain ⟨l, rfl⟩ := QuotientGroup.mk_surjective g
    have hl : (l : G) ∈ pCoreOf 2 L := by
      refine hcentr (l : G) l.2 fun k hk => ?_
      have hkL : k ∈ L := hKL hk
      have hβk : β ((⟨k, hkL⟩ : ↥L) : ↥L ⧸ CFSG.pCore 2 ↥L) = ((⟨k, hkL⟩ : ↥L) : ↥L ⧸ _) := by
        rw [hβ, CFSG.Quasithin.H13.KG68.quotAut_mk]
        congr 1
        apply Subtype.ext
        show a * k * a⁻¹ = k
        rw [hKV k hk a ha]
        group
      have h2 := hg ((⟨k, hkL⟩ : ↥L) : ↥L ⧸ CFSG.pCore 2 ↥L)
      rw [hβk] at h2
      have h3 : (l : ↥L ⧸ CFSG.pCore 2 ↥L) * ((⟨k, hkL⟩ : ↥L) : ↥L ⧸ _) =
          ((⟨k, hkL⟩ : ↥L) : ↥L ⧸ _) * (l : ↥L ⧸ _) := by
        have h4 := congrArg (fun z => (l : ↥L ⧸ CFSG.pCore 2 ↥L) * z) h2
        simpa [mul_assoc] using h4
      have h5 : (l * ⟨k, hkL⟩ * l⁻¹ * ⟨k, hkL⟩⁻¹ : ↥L) ∈ CFSG.pCore 2 ↥L := by
        rw [← QuotientGroup.eq_one_iff]
        simp only [QuotientGroup.mk_mul, QuotientGroup.mk_inv]
        rw [h3]
        group
      exact mem_pCoreOf_iff'.2 ⟨_, rfl, h5⟩
    have hl1 : (l : ↥L ⧸ CFSG.pCore 2 ↥L) = 1 := by
      obtain ⟨y, hyG, hy⟩ := mem_pCoreOf_iff'.1 hl
      have : y = l := Subtype.ext hyG
      rw [this] at hy
      exact (QuotientGroup.eq_one_iff l).2 hy
    have hβ1 : β = 1 := by
      ext x
      rw [hg x, hl1]
      simp
    have := CFSG.Quasithin.H13.KG68.eq_one_of_quotAut_eq_one hNc hperf hβ1
    exact (conjOn_eq_one_iff L haN).1 this
  apply hLM
  refine fun l hl => h.centralizer_le ?_
  exact Subgroup.mem_centralizer_iff.2 fun v hv =>
    (Subgroup.mem_centralizer_iff.1 (hVC hv) l hl).symm

theorem isSimpleGroup_alt {m : ℕ} (hm : 5 ≤ m) : IsSimpleGroup (alternatingGroup (Fin m)) :=
  alternatingGroup.isSimpleGroup (by rw [Nat.card_eq_fintype_card, Fintype.card_fin]; omega)

theorem e68M22Excl (hC129 : ∀ (G : Type) [Group G] [Finite G], ASC129Statement G)
    (hSpor : Ch1.SporadicAutInner) (hm22 : L239M22Parabolic) (hm23 : L239M23Parabolic)
    (hnot : L239NotRankOne) (h121 : Id2519.Prop121Three) : E68M22Excl := by
  intro G _ _ T M V U L h hU hL hiso
  have hq : CFSG.IsQuasisimple ↥L := BenderBranch.isQuasisimple_of_isComponentIn hL
  have hnorm : IsNormalListedType L := Or.inr (Or.inr (Or.inr (Or.inl hiso)))
  have hCN := le_normalizer_of_not_is121List h121 h hU hL fun hl =>
    hnot G L hq hnorm (Id2519.a38Types_of_is121List hl)
  have hQN : T ⊓ Subgroup.centralizer (V : Set G) ≤ Subgroup.normalizer (L : Set G) :=
    (e6_5_one h hU).1.trans hCN
  rcases hiso with ⟨⟨e⟩⟩ | ⟨⟨e⟩⟩
  · exact hexad_excl_aux hC129 hSpor (s := .M22) (Or.inr (Or.inr (Or.inl rfl)))
      (hexadPar_m22 hm22) (isSimpleGroup_alt (by norm_num)) (Or.inl card_alt_six) h hU hL hQN e
  · exact hexad_excl_aux hC129 hSpor (s := .M23) (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
      (hexadPar_m23 hm23) (isSimpleGroup_alt (by norm_num)) (Or.inr card_alt_seven) h hU hL hQN e

