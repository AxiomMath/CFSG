@[expose] def wit1 (i : ℕ) : Wit := (wit1Table.lookup i).getD Wit.empty

@[expose] def wit2 (i j : ℕ) : Wit := (wit2Table.lookup (min i j, max i j)).getD Wit.empty

@[expose] def wit3 (e : ℕ) : Wit := wit3Table.getD e Wit.empty

theorem wit1_ok : ∀ i ∈ sInv, (wit1 i).ok = true ∧ (wit1 i).gens = [i] ∧
    (wit1 i).conj.length ≤ 4 ∧ (i ∈ sOuter → (wit1 i).conj.length ≤ 3) := by
  decide +kernel

theorem wit2_ok : ∀ i ∈ sInner, ∀ j ∈ sInner, i ≠ j → mmul (sM i) (sM j) = mmul (sM j) (sM i) →
    (wit2 i j).ok = true ∧ (∀ t ∈ (wit2 i j).gens, t = i ∨ t = j) ∧
      (wit2 i j).conj.length ≤ 3 := by
  decide +kernel

theorem wit3_ok : ∀ e < 8, (wit3 e).ok = true ∧ (∀ t ∈ (wit3 e).gens, t ∈ sE8.getD e []) ∧
    (wit3 e).conj.length ≤ 2 := by
  decide +kernel

