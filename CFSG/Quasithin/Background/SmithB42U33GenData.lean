namespace CFSG.Quasithin.B42U33

open CFSG.Quasithin.H13.Orbit

@[expose] def codeA : List ℕ := [91, 167, 94, 243, 181, 159, 229, 218]

@[expose] def codeB : List ℕ := [1, 2, 10, 14, 80, 96, 32, 128]

@[expose] def codeAi : List ℕ := [95, 231, 90, 233, 245, 62, 165, 222]

@[expose] def codeBi : List ℕ := [1, 2, 12, 6, 112, 64, 96, 128]

theorem code_cubes : mmul codeA codeA = codeAi ∧ mmul codeB codeB = codeBi ∧
    mmul codeA codeAi = idMat ∧ mmul codeB codeBi = idMat := by
  decide +kernel

@[expose] def letC (i : ℕ) : List ℕ := [codeA, codeB, codeAi, codeBi].getD i idMat

@[expose] def wordC (w : List ℕ) : List ℕ := w.foldr (fun i acc => mmul (letC i) acc) idMat

@[expose] def swapL (i : ℕ) : ℕ := [2, 3, 0, 1].getD i i

@[expose] def invW (w : List ℕ) : List ℕ := (w.map swapL).reverse

@[expose] def conjC (d t : List ℕ) : List ℕ := mmul (mmul (wordC d) t) (wordC (invW d))

@[expose] def prodC (X : List (List ℕ)) (w : List ℕ) : List ℕ :=
  w.foldr (fun k acc => mmul (X.getD k idMat) acc) idMat

structure Wit where
  gens : List ℕ
  conj : List (List ℕ)
  codes : List (List ℕ)
  wa : List ℕ
  wb : List ℕ

@[expose] def Wit.conjCodes (W : Wit) : List (List ℕ) :=
  W.conj.flatMap fun d => W.gens.map fun t => conjC d (sM t)

@[expose] def Wit.ok (W : Wit) : Bool :=
  W.codes == W.conjCodes && prodC W.codes W.wa == codeA && prodC W.codes W.wb == codeB

@[expose] def Wit.empty : Wit := ⟨[], [], [], [], []⟩

