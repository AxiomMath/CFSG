theorem hx : ∀ i, i < xl.length → (matSubRep seedGroup).rel (ag i) (xl.getD i idL) := by
  intro i hi
  have hi2 : i = 0 ∨ i = 1 := by simp [xl] at hi; omega
  have hwf : wfM mA = true ∧ wfM mB = true := ⟨wfM_seeds.1, wfM_seeds.2.1⟩
  have hred : redM mA ∧ redM mB := by decide +kernel
  rcases hi2 with rfl | rfl
  · exact ⟨hwf.1, hred.1, (natU_val 0).symm⟩
  · exact ⟨hwf.2, hred.2, (natU_val 1).symm⟩

theorem hw : ∀ a, a < 6 → ∀ i ∈ words.getD a [], i < xl.length := by decide +kernel

theorem hwords : ∀ a, a < 6 → lwordD mulL idL xl (words.getD a []) = data.gd.getD a idL := by
  decide +kernel

theorem hgd : ∀ a, a < 6 → (matSubRep seedGroup).rel (gens a) (data.gd.getD a idL) := by
  intro a ha
  have h : (matSubRep seedGroup).rel (posWord ag (words.getD a []))
      (lwordD mulL idL xl (words.getD a [])) :=
    rel_posWord (matSubRep seedGroup) ag xl hx _ (hw a ha)
  rwa [hwords a ha] at h

theorem hasTwoE16_seedGroup (Q : Sylow 2 ↥seedGroup) :
    HasTwoE16 ↥(Q : Subgroup ↥seedGroup) :=
  hasTwoE16_of_rep (matSubRep seedGroup) data ok gens hgd Q

theorem hasTwoE16_j2 (Q : Sylow 2 CFSG.Blueprint.NativeSporadic.J2) :
    HasTwoE16 ↥(Q : Subgroup CFSG.Blueprint.NativeSporadic.J2) := by
  have : Finite CFSG.Blueprint.NativeSporadic.J2 :=
    Finite.of_equiv ↥seedGroup nativeEquiv.symm.toEquiv
  exact hasTwoE16_of_mulEquiv hasTwoE16_seedGroup Q nativeEquiv

end CFSG.Quasithin.F6.AutM12Recog.Tab.J2Cert
