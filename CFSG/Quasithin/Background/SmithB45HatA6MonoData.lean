@[expose] def EY (k : Bool) : List (List ℕ) := Core.buildCodes (List.range 6) (gcY k) (treeY k)

theorem tblY_check (k : Bool) :
    Core.tblCheckC (List.range 6) (gcY k) (EY k) (tblY k) = true := by
  cases k <;> decide +kernel

@[expose] def tauY (k : Bool) : List (Perm (Fin 6)) :=
  if k then [1, c[0, 2, 3, 4, 5], c[0, 1, 2], aY * c[0, 1, 2], bY true * c[0, 1, 2],
    aY * bY true * c[0, 1, 2]]
  else [1, c[0, 3, 1] * c[2, 5, 4], c[1, 2, 3, 4, 5], aY * c[1, 2, 3, 4, 5],
    bY false * c[1, 2, 3, 4, 5], aY * bY false * c[1, 2, 3, 4, 5]]

@[expose] def tauC (k : Bool) : List (List ℕ) := (tauY k).map (codeN 6)

theorem coverY_check (k : Bool) :
    genC.all (fun c => (tauC k).any fun t => (EY k).any fun e => Core.cmul t e == c) = true := by
  cases k <;> decide +kernel

