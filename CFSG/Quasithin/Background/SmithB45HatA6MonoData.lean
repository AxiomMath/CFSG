@[expose] def aY : Perm (Fin 6) := swap 0 1 * swap 2 3

@[expose] def bY (k : Bool) : Perm (Fin 6) := if k then swap 2 3 * swap 4 5 else swap 0 2 * swap 1 3

@[expose] def gY : Perm (Fin 6) := c[1, 2, 3, 4, 5]

@[expose] def gensY (k : Bool) : List (Perm (Fin 6)) :=
  if k then [swap 0 1 * swap 2 3, swap 2 3 * swap 4 5, swap 0 2 * swap 3 4, swap 3 4 * swap 1 5]
  else [swap 0 1 * swap 2 3, swap 0 2 * swap 1 3, swap 0 2 * swap 3 4, swap 0 3 * swap 2 4]

@[expose] def gcY (k : Bool) : List (List ℕ) :=
  if k then [[1, 0, 3, 2, 4, 5], [0, 1, 3, 2, 5, 4], [2, 1, 0, 4, 3, 5], [0, 5, 2, 4, 3, 1]]
  else [[1, 0, 3, 2, 4, 5], [2, 3, 0, 1, 4, 5], [2, 1, 0, 4, 3, 5], [3, 1, 4, 0, 2, 5]]

theorem gensY_code (k : Bool) : (gensY k).map (codeN 6) = gcY k := by
  cases k <;> decide

theorem gensY_eq (k : Bool) : gensY k = [aY, bY k, gY * aY * gY⁻¹, gY * bY k * gY⁻¹] := by
  cases k <;> decide

theorem aY_bY (k : Bool) : aY * aY = 1 ∧ bY k * bY k = 1 ∧ aY * bY k = bY k * aY ∧
    aY ∈ alternatingGroup (Fin 6) ∧ bY k ∈ alternatingGroup (Fin 6) ∧
    gY ∈ alternatingGroup (Fin 6) ∧ aY ≠ 1 ∧ bY k ≠ 1 ∧ aY ≠ bY k := by
  simp only [Perm.mem_alternatingGroup]
  cases k <;> decide

