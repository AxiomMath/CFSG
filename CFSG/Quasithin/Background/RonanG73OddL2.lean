theorem isPSL_two_two_two_of_five {X : Type} [Group X] {K : Type} [Field K] [Finite K]
    (hK : Nat.card K = 5) (e : X ≃* StatedProj (StatedSL 2 K)) : IsPSL 2 2 2 X := by
  have hK2 : Nat.card (GaloisField 2 2) = 2 ^ 2 := GaloisField.card 2 2 (by norm_num)
  have hK4 : Nat.card (GaloisField 2 2) = 4 := hK2.trans (by norm_num)
  obtain ⟨e5⟩ := CFSG.ClassicalModels.nonempty_statedLinearModel_equiv_alternating_five K
    (Or.inr hK)
  obtain ⟨e4⟩ := CFSG.ClassicalModels.nonempty_statedLinearModel_equiv_alternating_five
    (GaloisField 2 2) (Or.inl hK4)
  refine ⟨⟨Nat.prime_two, by norm_num, by norm_num, by norm_num, by norm_num⟩,
    GaloisField 2 2, inferInstance, inferInstance, hK2, ⟨e.trans (e5.trans e4.symm)⟩⟩

theorem isPSL_three_two_one_of_seven {X : Type} [Group X] {K : Type} [Field K] [Finite K]
    (hK : Nat.card K = 7) (e : X ≃* StatedProj (StatedSL 2 K)) : IsPSL 3 2 1 X := by
  have : Fintype K := Fintype.ofFinite K
  have : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  have hK7 : Fintype.card K = Fintype.card (ZMod 7) := by
    rw [ZMod.card, ← Nat.card_eq_fintype_card, hK]
  let eK : K ≃+* ZMod 7 := FiniteField.ringEquivOfCardEq hK7
  obtain ⟨e₇⟩ := CFSG.LocalAnalysis.ComponentInitial.nonempty_GL_three_two_equiv_PSL_two_seven
  let e₃ : Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2) ≃* GL (Fin 3) (ZMod 2) :=
    ((QuotientGroup.quotientMulEquivOfEq
      CFSG.LocalAnalysis.ComponentInitial.center_SL_three_zmod_two_eq_bot).trans
        QuotientGroup.quotientBot).trans
      (MulEquiv.ofBijective Matrix.SpecialLinearGroup.toGL
        CFSG.LocalAnalysis.ComponentInitial.bijective_toGL_three_zmod_two)
  refine ⟨⟨Nat.prime_two, le_refl 1, by norm_num, by norm_num, by norm_num⟩, ZMod 2,
    inferInstance, inferInstance,
    Nat.card_eq_fintype_card.trans ((ZMod.card 2).trans (pow_one 2).symm), ⟨?_⟩⟩
  exact e.trans ((projectiveSpecialLinearGroupEquivStatedProj 2 K).symm.trans
    ((CFSG.ClassicalModels.projectiveSpecialLinearFieldEquiv eK (Fin 2)).trans
      (e₇.symm.trans (e₃.symm.trans (projectiveSpecialLinearGroupEquivStatedProj 3 (ZMod 2))))))

theorem statedScalars_subgroupOf_statedSp_eq_bot :
    (StatedScalars (Fin 2 ⊕ Fin 2) (ZMod 2)).subgroupOf (StatedSp 2 (ZMod 2)) = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  rw [Subgroup.mem_subgroupOf] at hx
  obtain ⟨c, hc⟩ := hx
  have hu : ∀ c : (ZMod 2)ˣ, c = 1 := by decide
  rw [hu c, map_one] at hc
  exact Subgroup.mem_bot.2 (Subtype.ext hc.symm)

theorem commutator_subgroup_equiv {M : Type*} [Group M] (S : Subgroup M) :
    Nonempty (↥⁅S, S⁆ ≃* ↥(commutator ↥S)) := by
  have hTop : (⊤ : Subgroup ↥S).map S.subtype = S := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  have hmap : (⁅(⊤ : Subgroup ↥S), (⊤ : Subgroup ↥S)⁆).map S.subtype = ⁅S, S⁆ := by
    rw [Subgroup.map_commutator, hTop]
  exact ⟨(MulEquiv.subgroupCongr hmap.symm).trans
    (Subgroup.equivMapOfInjective (⁅(⊤ : Subgroup ↥S), (⊤ : Subgroup ↥S)⁆) S.subtype
      (Subgroup.subtype_injective S)).symm⟩

theorem alt6_equiv_commutator_statedSp :
    Nonempty (↥(alternatingGroup (Fin 6)) ≃*
      ↥⁅StatedSp 2 (ZMod 2), StatedSp 2 (ZMod 2)⁆) := by
  have hk : Nat.card (ZMod 2) = 2 := by rw [Nat.card_zmod]
  let e0 : ↥(StatedSp 2 (ZMod 2)) ≃* StatedProj (StatedSp 2 (ZMod 2)) :=
    ((QuotientGroup.quotientMulEquivOfEq statedScalars_subgroupOf_statedSp_eq_bot).trans
      QuotientGroup.quotientBot).symm
  obtain ⟨hA, -⟩ := CFSG.RankThree.PartOne.derived_alt_index_of_mulEquiv_sympFour
    (e0.trans (CFSG.RankThree.PartOne.KCSpComm.statedProjEquivSympFour hk))
  obtain ⟨e1⟩ := hA
  obtain ⟨e2⟩ := commutator_subgroup_equiv (StatedSp 2 (ZMod 2))
  exact ⟨e1.symm.trans e2.symm⟩

variable {V : Type} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]

theorem clause1_psl2 {L Γ A : Subgroup (GLV V)} {m : ℕ} (h : G93Hyp Γ A L L m)
    (hq : CFSG.IsQuasisimple ↥L) {p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hf : f = 1 ∨ f = 2)
    (hm : StatedClassicalModel (↥L ⧸ Subgroup.center ↥L) .PSL 2 p f) :
    IsPSL 2 2 2 ↥L ∨ IsPSL 3 2 1 ↥L ∨
      Nonempty (↥L ≃* ↥⁅StatedSp 2 (ZMod 2), StatedSp 2 (ZMod 2)⁆) ∨
      IsHat ↥L ↥(alternatingGroup (Fin 6)) := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hperf : Group.IsPerfect ↥L := ⟨h.L_comp.2.2.1⟩
  have hodd := odd_card_center_of_irr' h.H_irr
  have hm' := hm
  obtain ⟨hadm, K, hK1, hK2, hK, ⟨e0⟩⟩ := hm
  let e : (↥L ⧸ Subgroup.center ↥L) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) K :=
    e0.trans (pslEquiv K).symm
  let π : ↥L →* Matrix.ProjectiveSpecialLinearGroup (Fin 2) K :=
    e.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center ↥L))
  have hπ : Function.Surjective π := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hker : π.ker = Subgroup.center ↥L := by
    ext x
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      MulEquiv.map_eq_one_iff, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  obtain ⟨hne9, h9⟩ := psl_two_perfect_odd_cover_kernel hp2 hK π hπ hker.le
    (by rw [hker]; exact hodd)
  by_cases hq9 : p ^ f = 9
  ·
    obtain ⟨-, hle3⟩ := h9 hq9
    obtain ⟨hp3, hf2⟩ := eq_three_of_pow_eq_nine hp hq9
    subst hp3
    subst hf2
    rw [hker] at hle3
    have hZ : Nat.card (Subgroup.center ↥L) = 1 ∨ Nat.card (Subgroup.center ↥L) = 3 := by
      obtain ⟨k, hk⟩ := hodd
      have := Nat.card_pos (α := Subgroup.center ↥L)
      omega
    obtain ⟨hA6⟩ := CFSG.QuasithinUnique.Vol2Native.alternating_six_of_psl_two_nine hm'
    rcases hZ with h1 | h3
    · have hZ : Subgroup.center ↥L = ⊥ := Subgroup.eq_bot_of_card_eq _ h1
      obtain ⟨e6⟩ := alt6_equiv_commutator_statedSp
      exact Or.inr (Or.inr (Or.inl ⟨(mulEquiv_of_center_eq_bot hZ (MulEquiv.refl _)).trans
        (hA6.trans e6)⟩))
    · exact Or.inr (Or.inr (Or.inr ⟨hq, h3, ⟨hA6⟩⟩))
  ·
    have hZ : Subgroup.center ↥L = ⊥ := by rw [← hker]; exact hne9 hq9
    let eL : ↥L ≃* (↥L ⧸ Subgroup.center ↥L) := mulEquiv_of_center_eq_bot hZ (MulEquiv.refl _)
    have hmL : StatedClassicalModel ↥L .PSL 2 p f := statedClassicalModel_PSL_of_mulEquiv eL hm'
    rcases hf with rfl | rfl
    · by_cases h5 : p = 5
      · subst h5
        exact Or.inl (isPSL_two_two_two_of_five (by rw [hK]; norm_num) (eL.trans e0))
      by_cases h7 : p = 7
      · subst h7
        exact Or.inr (Or.inl (isPSL_three_two_one_of_seven (by rw [hK]; norm_num)
          (eL.trans e0)))
      exact (false_of_oddL2Big_prime hp hp2 h5 h7 h hmL).elim
    · exact (false_of_oddL2Big_sq hp hp2 hq9 h hmL).elim

