theorem mod_two_pow_succ_of_odd {a w : ℕ} (hw : Odd w) : 2 ^ a * w % 2 ^ (a + 1) = 2 ^ a := by
  obtain ⟨v, rfl⟩ := hw
  rw [show 2 ^ a * (2 * v + 1) = 2 ^ a + 2 ^ (a + 1) * v by ring, Nat.add_mul_mod_self_left,
    Nat.mod_eq_of_lt (Nat.pow_lt_pow_right (by norm_num) (by omega))]

theorem psl2_card_odd (m : ℕ) :
    (2 * m + 1) * ((2 * m + 1) ^ 2 - 1) / 2 = 2 * ((2 * m + 1) * (m * (m + 1))) := by
  have hsq : (2 * m + 1) ^ 2 - 1 = 4 * (m * (m + 1)) := by
    have h : (2 * m + 1) ^ 2 = 4 * (m * (m + 1)) + 1 := by ring
    omega
  rw [hsq, show (2 * m + 1) * (4 * (m * (m + 1))) = 2 * (2 * ((2 * m + 1) * (m * (m + 1)))) by
    ring, Nat.mul_div_cancel_left _ (by norm_num)]

theorem psl2_card_eq_of_mod_eight {q : ℕ} (hq : q % 8 = 3 ∨ q % 8 = 5) :
    ∃ w, Odd w ∧ q * (q ^ 2 - 1) / 2 = 2 ^ 2 * w := by
  obtain ⟨m, rfl⟩ : ∃ m, q = 2 * m + 1 := ⟨q / 2, by omega⟩
  obtain ⟨u, hu, hmu⟩ : ∃ u, Odd u ∧ m * (m + 1) = 2 * u := by
    rcases hq with h | h
    · obtain ⟨k, rfl⟩ : ∃ k, m = 4 * k + 1 := ⟨m / 4, by omega⟩
      exact ⟨(4 * k + 1) * (2 * k + 1), Nat.odd_mul.mpr ⟨⟨2 * k, by ring⟩, ⟨k, rfl⟩⟩, by ring⟩
    · obtain ⟨k, rfl⟩ : ∃ k, m = 4 * k + 2 := ⟨m / 4, by omega⟩
      exact ⟨(2 * k + 1) * (4 * k + 3), Nat.odd_mul.mpr ⟨⟨k, rfl⟩, ⟨2 * k + 1, by ring⟩⟩, by ring⟩
  refine ⟨(2 * m + 1) * u, Nat.odd_mul.mpr ⟨⟨m, rfl⟩, hu⟩, ?_⟩
  rw [psl2_card_odd, hmu]
  ring

theorem psl2_card_eq_of_mod_sixteen {q : ℕ} (hq : q % 16 = 7 ∨ q % 16 = 9) :
    ∃ w, Odd w ∧ q * (q ^ 2 - 1) / 2 = 2 ^ 3 * w := by
  obtain ⟨m, rfl⟩ : ∃ m, q = 2 * m + 1 := ⟨q / 2, by omega⟩
  obtain ⟨u, hu, hmu⟩ : ∃ u, Odd u ∧ m * (m + 1) = 4 * u := by
    rcases hq with h | h
    · obtain ⟨k, rfl⟩ : ∃ k, m = 8 * k + 3 := ⟨m / 8, by omega⟩
      exact ⟨(8 * k + 3) * (2 * k + 1), Nat.odd_mul.mpr ⟨⟨4 * k + 1, by ring⟩, ⟨k, rfl⟩⟩,
        by ring⟩
    · obtain ⟨k, rfl⟩ : ∃ k, m = 8 * k + 4 := ⟨m / 8, by omega⟩
      exact ⟨(2 * k + 1) * (8 * k + 5), Nat.odd_mul.mpr ⟨⟨k, rfl⟩, ⟨4 * k + 2, by ring⟩⟩,
        by ring⟩
  refine ⟨(2 * m + 1) * u, Nat.odd_mul.mpr ⟨⟨m, rfl⟩, hu⟩, ?_⟩
  rw [psl2_card_odd, hmu]
  ring

theorem le_psl2_card {q : ℕ} (hq : 11 ≤ q) : 660 ≤ q * (q ^ 2 - 1) / 2 := by
  have h1 : 121 ≤ q ^ 2 := by nlinarith
  have h2 : 11 * 120 ≤ q * (q ^ 2 - 1) := Nat.mul_le_mul hq (by omega)
  omega

theorem notSL2_of_card_psl2_mod_eight {M : Type*} [Group M] {q : ℕ}
    (hc : Nat.card M = q * (q ^ 2 - 1) / 2) (hq : q % 8 = 3 ∨ q % 8 = 5) (h11 : 11 ≤ q) :
    NotSL2 M := by
  obtain ⟨w, hw, hN⟩ := psl2_card_eq_of_mod_eight hq
  refine notSL2_of_card 2 ?_ ?_
  · rw [hc, hN]
    exact mod_two_pow_succ_of_odd hw
  · rw [hc]
    have := le_psl2_card h11
    norm_num
    omega

theorem notSL2_of_card_psl2_mod_sixteen {M : Type*} [Group M] {q : ℕ}
    (hc : Nat.card M = q * (q ^ 2 - 1) / 2) (hq : q % 16 = 7 ∨ q % 16 = 9) : NotSL2 M := by
  obtain ⟨w, hw, hN⟩ := psl2_card_eq_of_mod_sixteen hq
  refine notSL2_of_card 3 ?_ ?_
  · rw [hc, hN]
    exact mod_two_pow_succ_of_odd hw
  · rw [hc]
    rcases le_or_gt 11 q with h | h
    · have := le_psl2_card h
      norm_num
      omega
    · interval_cases q <;> revert hq <;> norm_num

theorem psl2_facts (K : Type) [Field K] [Finite K] (hodd : IsOddPrimePower (Nat.card K))
    (h5 : 5 ≤ Nat.card K) :
    IsSimpleGroup (PSL2 K) ∧ (∃ a b : PSL2 K, a * b ≠ b * a) ∧
      Nat.card (PSL2 K) = Nat.card K * (Nat.card K ^ 2 - 1) / 2 := by
  have hs : IsSimpleGroup (PSL2 K) :=
    CFSG.BenderSuzuki.External.huppert_II_6_13 2 le_rfl (.inr (by omega)) (.inr (by omega))
  refine ⟨hs, ?_, psl2_card_formula K hodd⟩
  by_contra hcomm
  push Not at hcomm
  have : Subgroup.center (PSL2 K) = ⊤ :=
    eq_top_iff.mpr fun x _ => Subgroup.mem_center_iff.mpr fun g => hcomm g x
  rw [psl2_center_eq_bot] at this
  exact (bot_ne_top : (⊥ : Subgroup (PSL2 K)) ≠ ⊤) this

theorem socle_psl2 (K : Type) [Field K] [Finite K] (hodd : IsOddPrimePower (Nat.card K))
    (h5 : 5 ≤ Nat.card K) (hS : NotSL2 (PSL2 K)) : Socle (PSL2 K) :=
  have := (psl2_facts K hodd h5).1
  socle_of_isSimpleGroup (psl2_facts K hodd h5).2.1 hS

theorem exists_of_isL2 {p e : ℕ} {W : Type} [Group W] (h : F6.IsL2 p e W) :
    p.Prime ∧ 1 ≤ e ∧ ∃ (K : Type) (_ : Field K) (_ : Finite K), Nat.card K = p ^ e ∧
      Nonempty (W ≃* PSL2 K) := by
  obtain ⟨⟨hp, he, -, -, -⟩, K, _, _, hK, ⟨φ⟩⟩ := h
  exact ⟨hp, he, K, inferInstance, inferInstance, hK,
    ⟨φ.trans (projectiveSpecialLinearGroupEquivStatedProj 2 K).symm⟩⟩

theorem isOddPrimePower_pow {p e : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (he : 1 ≤ e) :
    IsOddPrimePower (p ^ e) :=
  ⟨p, e, hp, hp.odd_of_ne_two hp2, he, rfl⟩

theorem isL2_facts {p e : ℕ} {W : Type} [Group W] (h : F6.IsL2 p e W) (hp2 : p ≠ 2)
    (h5 : 5 ≤ p ^ e) :
    IsSimpleGroup W ∧ (∃ a b : W, a * b ≠ b * a) ∧
      Nat.card W = p ^ e * ((p ^ e) ^ 2 - 1) / 2 := by
  obtain ⟨hp, he, K, _, _, hK, ⟨φ⟩⟩ := exists_of_isL2 h
  have hodd : IsOddPrimePower (Nat.card K) := hK ▸ isOddPrimePower_pow hp hp2 he
  obtain ⟨hs, ⟨a, b, hab⟩, hc⟩ := psl2_facts K hodd (hK ▸ h5)
  refine ⟨φ.isSimpleGroup, ⟨φ.symm a, φ.symm b, fun h' => hab ?_⟩, ?_⟩
  · have := congrArg φ h'
    simpa only [map_mul, MulEquiv.apply_symm_apply] using this
  · rw [Nat.card_congr φ.toEquiv, hc, hK]

theorem pgl2_centralizer_eq_bot (K : Type) [Field K] [Finite K]
    (hodd : IsOddPrimePower (Nat.card K)) (h3 : 3 < Nat.card K) :
    Subgroup.centralizer
      ((Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range :
        Set (PGL2 K)) = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  rw [Subgroup.mem_centralizer_iff] at hx
  have hx' : (SemidirectProduct.inl x : PGammaL2 K) ∈
      Subgroup.centralizer (pGammaL2PSLRange K : Set (PGammaL2 K)) := by
    rw [Subgroup.mem_centralizer_iff]
    rintro _ ⟨y, rfl⟩
    simp only [MonoidHom.coe_comp, Function.comp_apply]
    rw [← map_mul, ← map_mul, hx _ ⟨y, rfl⟩]
  rw [pGammaL2_pslRange_centralizer_eq_bot K hodd h3, Subgroup.mem_bot] at hx'
  rw [Subgroup.mem_bot]
  exact SemidirectProduct.inl_injective (hx'.trans (map_one _).symm)

theorem socle_pgl2 (K : Type) [Field K] [Finite K] (hodd : IsOddPrimePower (Nat.card K))
    (h5 : 5 ≤ Nat.card K) (hS : NotSL2 (PSL2 K)) : Socle (PGL2 K) := by
  obtain ⟨hs, hnab, -⟩ := psl2_facts K hodd h5
  set N := (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := K)).range
  have ψ : PSL2 K ≃* ↥N := psl2EquivToPGLRange K
  have hC := pgl2_centralizer_eq_bot K hodd (by omega)
  refine Or.inr ⟨N, Subgroup.normal_of_index_eq_two (pgl2_psl2Range_index_eq_two K hodd),
    CFSG.LocalCores.isQuasisimple_of_mulEquiv ψ (isQuasisimple_of_isSimpleGroup hnab), ?_,
    hS.of_mulEquiv ψ.symm, fun _ => hC⟩
  rw [hC, Subgroup.card_bot]
  exact odd_one

theorem socle_pSigmaL2 (K : Type) [Field K] [Finite K] (hodd : IsOddPrimePower (Nat.card K))
    (h5 : 5 ≤ Nat.card K) (hS : NotSL2 (PSL2 K)) : Socle ↥(F6.PSigmaL2 K) := by
  obtain ⟨hs, hnab, -⟩ := psl2_facts K hodd h5
  have hle : pGammaL2PSLRange K ≤ F6.PSigmaL2 K := le_sup_left
  set N := (pGammaL2PSLRange K).subgroupOf (F6.PSigmaL2 K)
  have ψ : PSL2 K ≃* ↥N :=
    (pGammaL2PSLRangeEquiv K).trans (Subgroup.subgroupOfEquivOfLe hle).symm
  have hC : Subgroup.centralizer (N : Set ↥(F6.PSigmaL2 K)) = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    rw [Subgroup.mem_centralizer_iff] at hx
    have hx' : (x : PGammaL2 K) ∈
        Subgroup.centralizer (pGammaL2PSLRange K : Set (PGammaL2 K)) := by
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      have := hx ⟨y, hle hy⟩ (by rw [SetLike.mem_coe, Subgroup.mem_subgroupOf]; exact hy)
      exact congrArg Subtype.val this
    rw [pGammaL2_pslRange_centralizer_eq_bot K hodd (by omega), Subgroup.mem_bot] at hx'
    rw [Subgroup.mem_bot]
    exact Subtype.ext hx'
  refine Or.inr ⟨N, (pGammaL2PSLRange_normal K hodd (by omega)).subgroupOf _,
    CFSG.LocalCores.isQuasisimple_of_mulEquiv ψ (isQuasisimple_of_isSimpleGroup hnab), ?_,
    hS.of_mulEquiv ψ.symm, fun _ => hC⟩
  rw [hC, Subgroup.card_bot]
  exact odd_one

theorem ne_two_of_odd_pow {p e : ℕ} (he : 1 ≤ e) (h : p ^ e % 2 = 1) : p ≠ 2 := by
  rintro rfl
  rw [Nat.pow_mod, Nat.mod_self, zero_pow (by omega)] at h
  exact absurd h (by norm_num)

theorem socle_of_isL2_mod_eight {D : Type} [Group D] {p e : ℕ} (h : F6.IsL2 p e D)
    (hq : p ^ e % 8 = 3 ∨ p ^ e % 8 = 5) (h11 : 11 ≤ p ^ e) : Socle D := by
  obtain ⟨hp, he, K, _, _, hK, ⟨φ⟩⟩ := exists_of_isL2 h
  have hp2 : p ≠ 2 := ne_two_of_odd_pow he (by rcases hq with h | h <;> omega)
  have hodd : IsOddPrimePower (Nat.card K) := hK ▸ isOddPrimePower_pow hp hp2 he
  refine Socle.of_mulEquiv φ (socle_psl2 K hodd (by omega) ?_)
  exact notSL2_of_card_psl2_mod_eight (psl2_facts K hodd (by omega)).2.2 (by rw [hK]; exact hq)
    (by rw [hK]; exact h11)

theorem socle_of_isL2_mod_sixteen {D : Type} [Group D] {p e : ℕ} (h : F6.IsL2 p e D)
    (hq : p ^ e % 16 = 7 ∨ p ^ e % 16 = 9) : Socle D := by
  obtain ⟨hp, he, K, _, _, hK, ⟨φ⟩⟩ := exists_of_isL2 h
  have hp2 : p ≠ 2 := ne_two_of_odd_pow he (by rcases hq with h | h <;> omega)
  have hodd : IsOddPrimePower (Nat.card K) := hK ▸ isOddPrimePower_pow hp hp2 he
  have h5 : 5 ≤ Nat.card K := by rw [hK]; rcases hq with h | h <;> omega
  refine Socle.of_mulEquiv φ (socle_psl2 K hodd h5 ?_)
  exact notSL2_of_card_psl2_mod_sixteen (psl2_facts K hodd h5).2.2 (by rw [hK]; exact hq)

theorem socle_of_isPGL2 {D : Type} [Group D] {q : ℕ} (hq : q.Prime)
    (hq24 : q % 24 = 11 ∨ q % 24 = 13) (h : F6.IsPGL2 q D) : Socle D := by
  obtain ⟨K, _, _, hK, ⟨φ⟩⟩ := h
  have hq2 : q ≠ 2 := by rcases hq24 with h | h <;> omega
  have hodd : IsOddPrimePower (Nat.card K) := by
    rw [hK, ← pow_one q]
    exact isOddPrimePower_pow hq hq2 le_rfl
  have h11 : 11 ≤ Nat.card K := by rw [hK]; rcases hq24 with h | h <;> omega
  refine Socle.of_mulEquiv (φ.trans (F6.PGL2Res.statedEquiv K)) (socle_pgl2 K hodd (by omega) ?_)
  exact notSL2_of_card_psl2_mod_eight (psl2_facts K hodd (by omega)).2.2
    (by rw [hK]; rcases hq24 with h | h <;> omega) h11

theorem sq_mod_sixteen {p : ℕ} (hp : p % 8 = 3 ∨ p % 8 = 5) : p ^ 2 % 16 = 9 := by
  have : p % 16 = 3 ∨ p % 16 = 5 ∨ p % 16 = 11 ∨ p % 16 = 13 := by omega
  rcases this with h | h | h | h <;> simp [Nat.pow_mod, h]

theorem socle_of_isL2FieldExtCat {D : Type} [Group D] {p : ℕ} (hp8 : p % 8 = 3 ∨ p % 8 = 5)
    (h : F6.IsL2FieldExtCat p D) : Socle D := by
  obtain ⟨hp, K, _, _, hK, ⟨φ⟩⟩ := h
  have hp2 : p ≠ 2 := by rcases hp8 with h | h <;> omega
  have hodd : IsOddPrimePower (Nat.card K) := hK ▸ isOddPrimePower_pow hp hp2 (by norm_num)
  have h9 : 9 ≤ Nat.card K := by
    rw [hK]
    have : 3 ≤ p := by rcases hp8 with h | h <;> omega
    nlinarith
  refine Socle.of_mulEquiv φ (socle_pSigmaL2 K hodd (by omega) ?_)
  exact notSL2_of_card_psl2_mod_sixteen (psl2_facts K hodd (by omega)).2.2
    (by rw [hK]; exact Or.inr (sq_mod_sixteen hp8))

