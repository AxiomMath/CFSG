@[expose] def bfsOk : Bool :=
  (Ltab.getD 0 M16.one == M16.one) &&
  (List.range 360).all fun i =>
    i == 0 || (decide (Lpar.getD i 0 < i) &&
      (M16.mul (Ltab.getD (Lpar.getD i 0) M16.one) (genL (Lgen.getD i 0)) == Ltab.getD i M16.one))

set_option maxRecDepth 100000 in
theorem bfsOk_eq : bfsOk = true := by decide +kernel

