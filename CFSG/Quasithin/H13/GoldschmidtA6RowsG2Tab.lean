theorem linesAt_spec : ∀ n < 6, ∀ p ∈ linesAt.getD n [],
    p.1 < 2 ^ (n + 1) ∧ p.2 < 2 ^ (n + 1) ∧ isLine p.1 p.2 = true := by decide +kernel


@[expose] def bOk (pre : List ℕ) (c : ℕ) : Bool :=
  (List.range pre.length).all fun i =>
    bnum c (pre.getD i 0) == bnum (2 ^ pre.length) (2 ^ i)

@[expose] def lineOk (pre' : List ℕ) (n : ℕ) : Bool :=
  (linesAt.getD n []).all fun p => isLine (appL pre' p.1 % 64) (appL pre' p.2 % 64)

@[expose] def okG2 (pre : List ℕ) (c : ℕ) : Bool := bOk pre c && lineOk (pre ++ [c]) pre.length

@[expose] def fullG2 (_ : List ℕ) : Bool := true

