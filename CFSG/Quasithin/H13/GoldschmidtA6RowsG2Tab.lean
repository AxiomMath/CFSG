@[expose] def gramC : List ℕ := [32, 24, 8, 22, 42, 17]

@[expose] def Gm : Matrix (Fin 6) (Fin 6) (ZMod 2) := matOfCols 6 gramC

@[expose] def Bf2 (y z : Fin 6 → ZMod 2) : ZMod 2 := y ⬝ᵥ (Gm *ᵥ z)

@[expose] def bnum (x y : ℕ) : Bool := parT (Nat.land x (appL gramC y))

theorem bnum_cast : ∀ x < 64, ∀ y < 64,
    bnum x y = decide (Bf2 (vecN 6 x) (vecN 6 y) = 1) := by decide +kernel

