@[expose] def MemG2 (K : Matrix (Fin 6) (Fin 6) (ZMod 2)) : Prop :=
  Kᵀ * Gm * K = Gm ∧ ∀ x < 64, ∀ y < 64, isLine x y = true →
    isLine (codeN 6 (K *ᵥ vecN 6 x)) (codeN 6 (K *ᵥ vecN 6 y)) = true

theorem memG2_one : MemG2 1 := by
  refine ⟨by rw [Matrix.transpose_one, Matrix.one_mul, Matrix.mul_one], fun x hx y hy h => ?_⟩
  rw [Matrix.one_mulVec, Matrix.one_mulVec, laws6.code_vec x hx, laws6.code_vec y hy]
  exact h

theorem memG2_mul {A B : Matrix (Fin 6) (Fin 6) (ZMod 2)} (hA : MemG2 A) (hB : MemG2 B) :
    MemG2 (A * B) := by
  refine ⟨?_, fun x hx y hy h => ?_⟩
  · calc (A * B)ᵀ * Gm * (A * B) = Bᵀ * (Aᵀ * Gm * A) * B := by
          rw [Matrix.transpose_mul]
          simp only [Matrix.mul_assoc]
      _ = Gm := by rw [hA.1, hB.1]
  · have hx' := laws6.code_lt (B *ᵥ vecN 6 x)
    have hy' := laws6.code_lt (B *ᵥ vecN 6 y)
    have h1 := hB.2 x hx y hy h
    have h2 := hA.2 _ hx' _ hy' h1
    rw [laws6.vec_code, laws6.vec_code, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec] at h2
    exact h2

theorem codeN_vecN_mod (n : ℕ) : codeN 6 (vecN 6 n) = n % 64 := by
  rw [← vecN_mod 6 n]
  exact laws6.code_vec _ (Nat.mod_lt _ (by norm_num))

theorem codeN_matOfCols {cols : List ℕ} (hc : cols.length = 6) (x : ℕ) :
    codeN 6 (matOfCols 6 cols *ᵥ vecN 6 x) = appL cols x % 64 := by
  rw [← vecN_appC, ← codeN_vecN_mod]
  rw [appL_eq, hc]

@[expose] def lineGen (cols : List ℕ) : Bool :=
  (List.range 64).all fun x => (List.range 64).all fun y =>
    !isLine x y || isLine (appL cols x % 64) (appL cols y % 64)

theorem memG2_of_cols {cols : List ℕ} (hc : cols.length = 6)
    (h1 : (matOfCols 6 cols)ᵀ * Gm * matOfCols 6 cols = Gm) (h2 : lineGen cols = true) :
    MemG2 (matOfCols 6 cols) := by
  refine ⟨h1, fun x hx y hy h => ?_⟩
  unfold lineGen at h2
  rw [List.all_eq_true] at h2
  have h3 := List.all_eq_true.mp (h2 x (List.mem_range.mpr hx)) y (List.mem_range.mpr hy)
  rw [codeN_matOfCols hc, codeN_matOfCols hc]
  simpa [h] using h3

@[expose] def colsA : List ℕ := [24, 60, 13, 63, 40, 7]

@[expose] def colsB : List ℕ := [62, 2, 35, 14, 11, 25]

theorem gramA : (matOfCols 6 colsA)ᵀ * Gm * matOfCols 6 colsA = Gm := by decide +kernel

theorem gramB : (matOfCols 6 colsB)ᵀ * Gm * matOfCols 6 colsB = Gm := by decide +kernel

theorem lineGenA : lineGen colsA = true := by decide +kernel

theorem lineGenB : lineGen colsB = true := by decide +kernel

theorem memG2_A : MemG2 (matOfCols 6 colsA) := memG2_of_cols (by decide) gramA lineGenA

theorem memG2_B : MemG2 (matOfCols 6 colsB) := memG2_of_cols (by decide) gramB lineGenB

theorem matG2_gensK0 :
    matG2 (gensK 0) = matOfCols 6 colsA := by
  rw [matG2, muQ_gensK0]
  decide +kernel

theorem matG2_gensK1 :
    matG2 (gensK 1) = matOfCols 6 colsB := by
  rw [matG2, muQ_gensK1]
  decide +kernel

local notation "Amb" => quasithinZorn (ZMod 2) ≃ₗ[ZMod 2] quasithinZorn (ZMod 2)

theorem memG2_of_mul {s y : Amb} (hs : s ∈ subG2) (hy : y ∈ subG2)
    (h1 : MemG2 (matG2 ⟨s, hs⟩)) (h2 : MemG2 (matG2 ⟨y, hy⟩)) :
    MemG2 (matG2 ⟨s * y, subG2.mul_mem hs hy⟩) := by
  have e : (⟨s * y, subG2.mul_mem hs hy⟩ : ↥subG2) = ⟨s, hs⟩ * ⟨y, hy⟩ := rfl
  rw [e, matG2_mul]
  exact memG2_mul h1 h2

theorem memG2_matG2
    (g : ↥subG2) : MemG2 (matG2 g) := by
  have hA : MemG2 (matG2 (gensK 0)) := by rw [matG2_gensK0]; exact memG2_A
  have hB : MemG2 (matG2 (gensK 1)) := by rw [matG2_gensK1]; exact memG2_B
  have hAi : MemG2 (matG2 (gensK 0)⁻¹) := by
    have : (gensK 0)⁻¹ = gensK 0 * gensK 0 := inv_eq_of_mul_eq_one_right (gensK_cube 0)
    rw [this, matG2_mul]
    exact memG2_mul hA hA
  have hBi : MemG2 (matG2 (gensK 1)⁻¹) := by
    have : (gensK 1)⁻¹ = gensK 1 * gensK 1 := inv_eq_of_mul_eq_one_right (gensK_cube 1)
    rw [this, matG2_mul]
    exact memG2_mul hB hB
  obtain ⟨x, hx⟩ := g
  refine Subgroup.closure_induction_left
    (p := fun x hx => MemG2 (matG2 (⟨x, hx⟩ : ↥subG2))) ?_ ?_ ?_ hx
  · exact (matG2_one ▸ memG2_one : MemG2 (matG2 1))
  · intro s hs y hy ih
    have hs' : s ∈ subG2 := Subgroup.subset_closure hs
    refine memG2_of_mul hs' hy ?_ ih
    rcases hs with rfl | rfl
    · exact hA
    · exact hB
  · intro s hs y hy ih
    have hs' : s⁻¹ ∈ subG2 := subG2.inv_mem (Subgroup.subset_closure hs)
    refine memG2_of_mul hs' hy ?_ ih
    rcases hs with rfl | rfl
    · exact hAi
    · exact hBi


theorem Bf2_mulVec {K : Matrix (Fin 6) (Fin 6) (ZMod 2)} (h : Kᵀ * Gm * K = Gm)
    (y z : Fin 6 → ZMod 2) : Bf2 (K *ᵥ y) (K *ᵥ z) = Bf2 y z := by
  unfold Bf2
  have h1 : (K *ᵥ y) ⬝ᵥ (Gm *ᵥ (K *ᵥ z)) = y ⬝ᵥ (Kᵀ *ᵥ (Gm *ᵥ (K *ᵥ z))) := by
    symm
    calc y ⬝ᵥ (Kᵀ *ᵥ (Gm *ᵥ (K *ᵥ z))) = (y ᵥ* Kᵀ) ⬝ᵥ (Gm *ᵥ (K *ᵥ z)) :=
          Matrix.dotProduct_mulVec _ _ _
      _ = (K *ᵥ y) ⬝ᵥ (Gm *ᵥ (K *ᵥ z)) := by rw [Matrix.vecMul_transpose]
  have h2 : Kᵀ *ᵥ (Gm *ᵥ (K *ᵥ z)) = (Kᵀ * Gm * K) *ᵥ z := by
    rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec]
  rw [h1, h2, h]

theorem appL_zero_left (cols : List ℕ) : appL cols 0 = 0 := by
  induction cols with
  | nil => rfl
  | cons c cs ih => simp [appL, ih]

theorem appL_take : ∀ (cols : List ℕ) (k x : ℕ), x < 2 ^ k → appL (cols.take k) x = appL cols x
  | cols, 0, x, hx => by
    have : x = 0 := by simpa using hx
    subst this
    rw [List.take_zero, appL_zero_left, appL_zero_left]
  | [], k + 1, x, _ => by rw [List.take_nil]
  | c :: cs, k + 1, x, hx => by
    rw [List.take_succ_cons, appL, appL]
    congr 1
    refine appL_take cs k (Nat.shiftRight x 1) ?_
    show x >>> 1 < 2 ^ k
    rw [Nat.shiftRight_eq_div_pow, pow_one]
    rw [pow_succ] at hx
    omega

theorem codeN_colsOf {K : Matrix (Fin 6) (Fin 6) (ZMod 2)} (x : ℕ) :
    codeN 6 (K *ᵥ vecN 6 x) = appL (colsOf 6 K) x % 64 := by
  have h := codeN_matOfCols (cols := colsOf 6 K) (colsOf_length 6 K) x
  rwa [matOfCols_colsOf laws6 K] at h

theorem hfullG2 (K : Matrix (Fin 6) (Fin 6) (ZMod 2)) (_ : MemG2 K) :
    fullG2 (colsOf 6 K) = true := rfl

theorem hokG2 (K : Matrix (Fin 6) (Fin 6) (ZMod 2)) (hK : MemG2 K) :
    ∀ j < 6, okG2 ((colsOf 6 K).take j) ((colsOf 6 K).getD j 0) = true := by
  intro j hj
  have hlen : ((colsOf 6 K).take j).length = j := by simp [colsOf_length, hj.le]
  have hcol : ∀ i (hi : i < 6), vecN 6 ((colsOf 6 K).getD i 0) = K *ᵥ vecN 6 (2 ^ i) := by
    intro i hi
    rw [colsOf_getD laws6 K ⟨i, hi⟩, mulVec_vecN_pow K ⟨i, hi⟩]
  have hlt : ∀ i (hi : i < 6), (colsOf 6 K).getD i 0 < 64 := fun i hi =>
    colsOf_getD_lt laws6 K hi
  have hpw : ∀ i (hi : i < 6), 2 ^ i < 64 := fun i hi => by
    have : 2 ^ i < 2 ^ 6 := Nat.pow_lt_pow_right (by norm_num) hi
    simpa using this
  unfold okG2
  rw [Bool.and_eq_true]
  constructor
  · unfold bOk
    rw [hlen, List.all_eq_true]
    intro i hi
    rw [List.mem_range] at hi
    have hi6 : i < 6 := by omega
    have hget : ((colsOf 6 K).take j).getD i 0 = (colsOf 6 K).getD i 0 := by
      rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_take_of_lt hi]
    rw [hget, beq_iff_eq, bnum_cast _ (hlt j hj) _ (hlt i hi6),
      bnum_cast _ (hpw j hj) _ (hpw i hi6), hcol j hj, hcol i hi6, Bf2_mulVec hK.1]
  · unfold lineOk
    rw [hlen, List.all_eq_true]
    intro p hp
    have hspec := linesAt_spec j hj p hp
    have hts : (colsOf 6 K).take j ++ [(colsOf 6 K).getD j 0] = (colsOf 6 K).take (j + 1) := by
      rw [List.take_add_one, List.getD_eq_getElem?_getD]
      have hj' : j < (colsOf 6 K).length := by simpa [colsOf_length] using hj
      simp [List.getElem?_eq_getElem hj']
    rw [hts, appL_take _ _ _ hspec.1, appL_take _ _ _ hspec.2.1, ← codeN_colsOf, ← codeN_colsOf]
    have h64 : 2 ^ (j + 1) ≤ 64 := by
      calc 2 ^ (j + 1) ≤ 2 ^ 6 := Nat.pow_le_pow_right (by norm_num) (by omega)
        _ = 64 := by norm_num
    exact hK.2 _ (lt_of_lt_of_le hspec.1 h64) _ (lt_of_lt_of_le hspec.2.1 h64) hspec.2.2

