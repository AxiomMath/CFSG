open Subgroup CFSG.Open
open CFSG.Quasithin.SteinbergCC (normalizerFrattiniConj)

@[expose] def DifferentMaxTwoLocalStrictCore : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (T L M : Subgroup G), QTNQ T L M →
    ∀ H : Subgroup G, quasithinIsMaxTwoLocal H → T ≤ H → H ≠ M →
      pCoreOf 2 H ≠ ⊥ ∧ pCoreOf 2 H < pCoreOf 2 (H ⊓ M) ∧ pCoreOf 2 M ≤ pCoreOf 2 (H ⊓ M) ∧
        pCoreOf 2 (H ⊓ M) ≠ pCoreOf 2 H

theorem differentMaxTwoLocalStrictCore_of
    (hsing : NQCore.StmtOriginalWitnessSingleton) : DifferentMaxTwoLocalStrictCore := by
  intro G _ _ T L M h H hH hTH hHM
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set P := pCoreOf 2 H with hPdef
  have hP2 : IsPGroup 2 P := CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 H
  have hPT : P ≤ T := QuasithinUnique.EscapingLocal.pCoreOf_le_of_isSylowTwoOf
    (NQCore.isSylowIn_of_quasithin h.sylow hTH)
  have hQT : pCoreOf 2 M ≤ T := QuasithinUnique.EscapingLocal.pCoreOf_le_of_isSylowTwoOf
    (NQCore.isSylowIn_of_quasithin h.sylow h.t_le)
  have hP1 : P ≠ ⊥ := CFSG.Quasithin.pCoreOf_ne_bot_of_isTwoLocal hH.1
  have hHP : H ≤ normalizer (P : Set G) := CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 H
  have hPI : P ≤ pCoreOf 2 (H ⊓ M) :=
    CFSG.LieType.BorelTits.le_pCoreOf_of_le_normalizer 2
      (le_inf (CFSG.LieType.BorelTits.pCoreOf_le 2 H) (hPT.trans h.t_le))
      (inf_le_left.trans hHP) hP2
  have hQI : pCoreOf 2 M ≤ pCoreOf 2 (H ⊓ M) :=
    CFSG.LieType.BorelTits.le_pCoreOf_of_le_normalizer 2
      (le_inf (hQT.trans hTH) (CFSG.LieType.BorelTits.pCoreOf_le 2 M))
      (inf_le_right.trans (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 M))
      (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 M)
  have hlt : P < pCoreOf 2 (H ⊓ M) := by
    refine lt_of_le_of_ne hPI fun heq => ?_
    have hMP : pCoreOf 2 M ≤ P := heq ▸ hQI
    obtain ⟨p, hp, hp5, X, -, hXc, hXN, hXno, hexp, hrk, hX2, -, hW, hirr, -, -⟩ :=
      NQRigid.configuration_centralizer_conjugate_rigidity_witness h
    have : Fact p.Prime := ⟨hp⟩
    have hXA : IsPGroup p (↥X ⧸ CFSG.pCore 2 ↥X) := fun g =>
      ⟨1, by rw [pow_one, ← hexp]; exact Monoid.pow_exponent_eq_one g⟩
    have hLW : ∃ l : normalizer (X : Set G), (l : G) ∈ L ∧ normalizerFrattiniConj X l ≠ 1 := by
      obtain ⟨f, ⟨l, hlL, rfl⟩, hf⟩ := NQCore.exists_ne_one_of_irreducible hp
        (fun w => by
          obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective w
          rw [← QuotientGroup.mk_pow, ← hexp, Monoid.pow_exponent_eq_one, QuotientGroup.mk_one])
        hW {f | ∃ l : normalizer (X : Set G), (l : G) ∈ L ∧ normalizerFrattiniConj X l = f}
        (fun Y hY => hirr Y fun l hl y hy => hY _ ⟨l, hl, rfl⟩ y hy)
      exact ⟨l, hlL, hf⟩
    have hU := hsing G T L M h p X hp hp5 hXN hXc hX2 hXno hXA hexp hrk hW hLW
      (fun Y hY => hirr Y hY)
    obtain ⟨-, -, hVs, h3, hSyl, -, hVc⟩ := witness_sylow_product h hp hp5 hXN hXc hXA hPT hMP
    have hfac := sylow_thompson_factorization hVs h3 hVc hSyl
    set J := (CFSG.elemThompson ↥P 2).map P.subtype with hJdef
    set Z := omegaOneCenterOf 2 P with hZdef
    have : (CFSG.elemThompson ↥P 2).Characteristic := by
      have := ((SteinbergBK.higher_elementary_thompson_intersections_and_central_involutions
        (S := ↥P) hP2).1 0).1
      rwa [CFSG.higherElemThompson_zero] at this
    have hJ1 : J ≠ ⊥ := CFSG.RankThree.Coprime.map_elemThompson_ne_bot hP2 hP1
    have hHJ : H ≤ normalizer (J : Set G) := hHP.trans
      (CFSG.LieType.BorelTits.normalizer_le_normalizer_map_of_characteristic _)
    have hNJ : normalizer (J : Set G) = H :=
      hH.2 _ ⟨J, hJ1, hP2.to_le (map_subtype_le _), rfl⟩ hHJ
    have : (Z.subgroupOf P).Characteristic := omegaOneCenterOf_characteristic P
    have hZmap : (Z.subgroupOf P).map P.subtype = Z := by
      rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr ((omegaOneCenterOf_le 2 P).trans
        inf_le_left)]
    have hHZ : H ≤ normalizer (Z : Set G) := by
      have := hHP.trans
        (CFSG.LieType.BorelTits.normalizer_le_normalizer_map_of_characteristic (Z.subgroupOf P))
      rwa [hZmap] at this
    have hZ1 : Z ≠ ⊥ := omegaOneCenterOf_two_ne_bot hP2 hP1
    have hNZ : normalizer (Z : Set G) = H :=
      hH.2 _ ⟨Z, hZ1, hP2.to_le ((omegaOneCenterOf_le 2 P).trans inf_le_left), rfl⟩ hHZ
    have hVH : X ⊔ P ≤ H := by
      intro v hv
      have hv' : v ∈ ((X ⊔ P : Subgroup G) : Set G) := hv
      rw [hfac] at hv'
      obtain ⟨a, ha, b, hb, rfl⟩ := hv'
      refine mul_mem ?_ ?_
      · rw [← hNJ]
        exact (mem_inf.mp ha).2
      · rw [← hNZ]
        exact Subgroup.centralizer_le_normalizer _ (mem_inf.mp hb).2
    exact hHM (hU.2.2 H hH (sup_le (le_sup_left.trans hVH) hTH))
  exact ⟨hP1, hlt, hQI, hlt.ne'⟩

theorem differentMaxTwoLocalStrictCore_holds :
    DifferentMaxTwoLocalStrictCore :=
  differentMaxTwoLocalStrictCore_of stmtOriginalWitnessSingleton_holds

end CFSG.Quasithin.H13.NQBlock
