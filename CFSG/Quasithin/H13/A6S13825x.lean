theorem exists_mapEquiv {A B₁ B₂ : Type*} [Group A] [Group B₁] [Group B₂] (φ₁ : A →* B₁)
    (φ₂ : A →* B₂) (h : ∀ x, φ₁ x = 1 ↔ φ₂ x = 1) (X : Subgroup A) :
    ∃ ψ : ↥(X.map φ₁) ≃* ↥(X.map φ₂), ∀ x (hx : x ∈ X),
      ψ ⟨φ₁ x, Subgroup.mem_map_of_mem φ₁ hx⟩ = ⟨φ₂ x, Subgroup.mem_map_of_mem φ₂ hx⟩ := by
  set ψ₁ := φ₁.comp X.subtype
  set ψ₂ := φ₂.comp X.subtype
  have hker : ψ₁.ker = ψ₂.ker := by
    ext x
    simp only [MonoidHom.mem_ker, ψ₁, ψ₂, MonoidHom.comp_apply]
    exact h _
  have hr₁ : ψ₁.range = X.map φ₁ := by rw [MonoidHom.range_comp, Subgroup.range_subtype]
  have hr₂ : ψ₂.range = X.map φ₂ := by rw [MonoidHom.range_comp, Subgroup.range_subtype]
  refine ⟨(MulEquiv.subgroupCongr hr₁).symm.trans
    ((QuotientGroup.quotientKerEquivRange ψ₁).symm.trans
      ((QuotientGroup.quotientMulEquivOfEq hker).trans
        ((QuotientGroup.quotientKerEquivRange ψ₂).trans (MulEquiv.subgroupCongr hr₂)))),
    fun x hx => ?_⟩
  have h1 : (MulEquiv.subgroupCongr hr₁).symm ⟨φ₁ x, Subgroup.mem_map_of_mem φ₁ hx⟩ =
      QuotientGroup.quotientKerEquivRange ψ₁ (QuotientGroup.mk ⟨x, hx⟩) := by
    apply Subtype.ext
    rfl
  simp only [MulEquiv.trans_apply, h1, MulEquiv.symm_apply_apply]
  rfl

theorem cuts_four_nine {C : Set ℕ} (hC : IsCuts 4 C)
    (hs : Group.IsSolvable ↥(flagStabilizer 4 (ZMod 2) C))
    (h9 : 9 ∣ Nat.card ↥(flagStabilizer 4 (ZMod 2) C)) : C = {2} := by
  rcases shape_four hC with h | ⟨j, hj, hjn, h⟩ | h | h
  · rw [h] at h9
    exact absurd ((show 3 ∣ 9 by norm_num).trans h9) (not_three_dvd_full (by norm_num))
  · rw [h] at h9
    exact absurd h9 (not_nine_dvd_minPar hj hjn)
  · exact h
  · exact absurd hs h

theorem det_block_aux : ∀ a b c d x₀ x₁ y₀ y₁ : ZMod 2,
    a * x₀ + b * x₁ = 1 → c * x₀ + d * x₁ = 0 → a * y₀ + b * y₁ = 0 → c * y₀ + d * y₁ = 1 →
      a * d - b * c = 1 := by
  decide

theorem wedge_fix_of_mem_flag {g : SpecialLinearGroup (Fin 4) (ZMod 2)}
    (hg : g ∈ flagStabilizer 4 (ZMod 2) {2}) :
    JonesParshall.wedgeMat4 (g : Matrix (Fin 4) (Fin 4) (ZMod 2)) *ᵥ Pi.single 0 1 =
      Pi.single 0 1 := by
  rw [mem_flagStabilizer] at hg
  have hW := hg 2 (Set.mem_singleton 2)
  rw [mem_stabilizer] at hW
  have hsingle : ∀ j : Fin 4, (j : ℕ) < 2 →
      (Pi.single j 1 : Fin 4 → ZMod 2) ∈ flagSpace 4 (ZMod 2) 2 :=
    fun j hj => Submodule.subset_span ⟨j, hj, rfl⟩
  have hcol : ∀ j : Fin 4, (j : ℕ) < 2 → ∀ i : Fin 4, 2 ≤ (i : ℕ) →
      (g : Matrix (Fin 4) (Fin 4) (ZMod 2)) i j = 0 := by
    intro j hj i hi
    have hmem : mulVecLin (g : Matrix (Fin 4) (Fin 4) (ZMod 2)) (Pi.single j 1) ∈
        flagSpace 4 (ZMod 2) 2 := hW ▸ Submodule.mem_map_of_mem (hsingle j hj)
    rw [mem_flagSpace] at hmem
    have := hmem i hi
    simpa [Matrix.mulVecLin_apply, Matrix.mulVec_single] using this
  have hsurj : ∀ j : Fin 4, (j : ℕ) < 2 → ∃ w : Fin 4 → ZMod 2, w 2 = 0 ∧ w 3 = 0 ∧
      (g : Matrix (Fin 4) (Fin 4) (ZMod 2)) *ᵥ w = Pi.single j 1 := by
    intro j hj
    have hmem := hsingle j hj
    rw [← hW] at hmem
    obtain ⟨w, hw, hgw⟩ := Submodule.mem_map.1 hmem
    rw [mem_flagSpace] at hw
    exact ⟨w, hw 2 (by norm_num), hw 3 (by norm_num), hgw⟩
  obtain ⟨w₀, hw₀2, hw₀3, hgw₀⟩ := hsurj 0 (by norm_num)
  obtain ⟨w₁, hw₁2, hw₁3, hgw₁⟩ := hsurj 1 (by norm_num)
  have h20 := hcol 0 (by norm_num) 2 (by norm_num)
  have h30 := hcol 0 (by norm_num) 3 (by norm_num)
  have h21 := hcol 1 (by norm_num) 2 (by norm_num)
  have h31 := hcol 1 (by norm_num) 3 (by norm_num)
  have hdet : (g : Matrix (Fin 4) (Fin 4) (ZMod 2)) 0 0 *
      (g : Matrix (Fin 4) (Fin 4) (ZMod 2)) 1 1 -
      (g : Matrix (Fin 4) (Fin 4) (ZMod 2)) 0 1 *
      (g : Matrix (Fin 4) (Fin 4) (ZMod 2)) 1 0 = 1 := by
    have e00 := congrFun hgw₀ 0
    have e10 := congrFun hgw₀ 1
    have e01 := congrFun hgw₁ 0
    have e11 := congrFun hgw₁ 1
    simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_four, hw₀2, hw₀3, hw₁2, hw₁3, mul_zero,
      add_zero] at e00 e10 e01 e11
    simp only [Pi.single_eq_same] at e00 e11
    rw [Pi.single_eq_of_ne (by decide : (1 : Fin 4) ≠ 0)] at e10
    rw [Pi.single_eq_of_ne (by decide : (0 : Fin 4) ≠ 1)] at e01
    exact det_block_aux _ _ _ _ _ _ _ _ e00 e10 e01 e11
  funext k
  fin_cases k <;>
    simp [JonesParshall.wedgeMat4, JonesParshall.pr4, Matrix.mulVec, dotProduct,
      Fin.sum_univ_succ, h20, h30, h21, h31, hdet]

