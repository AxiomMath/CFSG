theorem exists_std_equiv_hat (h21 : Lem13821) (h16 : Lem13816)
    (h1334 : Stmt13_3_4) {G : Type} [Group G] [Finite G] {T L V : Subgroup G}
    {S : Setting4 G T L V} (hS : S.Hyp138) {H : Subgroup G} (hH : H ∈ S.Hz) {K : Subgroup G}
    (hK : K ∈ cComp H) (hKn : IsPSL 4 2 1 ↥(S.KSt H K)) (hhat : IsHatA6 L)
    (hTK : T ≤ K ⊔ pCoreOf 2 H) :
    ∃ e : ↥(S.KSt H K) ≃* SpecialLinearGroup (Fin 4) (ZMod 2),
      toSL e (S.KSt H T) = unitriangular 4 (ZMod 2) ∧
      toSL e (S.KSt H S.L1 ⊔ S.KSt H T) = flagStabilizer 4 (ZMod 2) {2} := by
  obtain ⟨-, -, -, -, -, e, he⟩ := star_setup h21 h16 hS hH hK (by norm_num) hKn
  have hF := (hS.hF H hH).toHypF91
  have hKH : K ≤ H := le_of_mem_cComp hK
  have hTH : T ≤ H := le_sup_right.trans hH.1.1
  have hL1H : S.L1 ≤ H := le_sup_left.trans hH.1.1
  have hL1K : S.L1 ≤ K := (h21 G T L V S hS H hH K hK).1
  have hTK' : S.KSt H T ≤ S.KSt H K := (S.kst_le_iff hF hTH hKH).2 hTK
  rw [inf_eq_left.2 hTK'] at he
  have hLK : S.KSt H S.L1 ≤ S.KSt H K := S.kst_mono hF hL1K hKH
  have hBK : S.KSt H S.L1 ⊔ S.KSt H T ≤ S.KSt H K := sup_le hLK hTK'
  have hUle : upperTriangular 4 (ZMod 2) ≤ toSL e (S.KSt H S.L1 ⊔ S.KSt H T) := by
    rw [upperTriangular_eq_unitriangular (Nat.card_zmod 2), ← he]
    exact toSL_mono e le_sup_right
  obtain ⟨hQ, hCc⟩ := eq_flagStabilizer_borelOvergroupCuts hUle
  have hBLT : S.KSt H S.L1 ⊔ S.KSt H T ≤ S.KSt H (S.L1 ⊔ T) := by
    rw [S.kst_sup hF hL1H hTH]
  have hLTs : Group.IsSolvable ↥(S.KSt H (S.L1 ⊔ T)) :=
    S.kst_isSolvable hF hH.1.1 (S.isSolvable_L1T h1334 hS)
  have hBs : Group.IsSolvable ↥(S.KSt H S.L1 ⊔ S.KSt H T) :=
    Group.isSolvable_of_isSolvable_injective (f := Subgroup.inclusion hBLT)
      (Subgroup.inclusion_injective _)
  have hQs := isSolvable_toSL e hBK hBs
  rw [hQ] at hQs
  have h9 : 9 ∣ Nat.card ↥(flagStabilizer 4 (ZMod 2)
      (borelOvergroupCuts (toSL e (S.KSt H S.L1 ⊔ S.KSt H T)))) := by
    rw [← hQ, card_toSL e hBK]
    exact (nine_dvd_card_kst S hF hL1H
      (nine_dvd_of_two_le_pRank (S.two_le_pRank_L1_of_hat hhat))).trans
      (Subgroup.card_dvd_of_le le_sup_left)
  refine ⟨e, he, ?_⟩
  rw [hQ, cuts_four_nine hCc hQs h9]

