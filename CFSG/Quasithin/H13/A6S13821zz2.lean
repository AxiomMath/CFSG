theorem mul_self_sec (w : Sec (⊤ : Subgroup ↥(subM V₁ (conjClosure I H) I))
      ((subM V₁ (conjClosure I H) I ⊓ fixV (autIH V₁ I H (conjClosure K T))).subgroupOf
        (subM V₁ (conjClosure I H) I))) : w * w = 1 := by
  obtain ⟨i, rfl⟩ := secMap_surjective (HypF918.conjClosure_le_normalizer_V₁ hF hIU) hV₁I _ w
  rw [← map_mul]
  have hi2 : i * i = 1 := Subtype.ext (by
    have := hF.toHypF98.F911_3.2 (i : G) (hIU i.2)
    simpa [sq] using this)
  rw [hi2, map_one]

theorem secMap_quad {y y' t t' : G}
    (ht : t ∈ Subgroup.normalizer (I : Set G)) (htH : t ∈ H)
    (ht' : t' ∈ Subgroup.normalizer (I : Set G)) (ht'H : t' ∈ H)
    (hy : y ∈ Subgroup.normalizer (I : Set G)) (hy' : y' ∈ Subgroup.normalizer (I : Set G))
    (htq : t⁻¹ * y ∈ pCoreOf 2 H) (htq' : t'⁻¹ * y' ∈ pCoreOf 2 H)
    (hyy : ∀ u ∈ conjClosure Vp H, ⁅⁅u, y⁆, y'⁆ = 1)
    {ℓ ℓ' : MulAut (Sec (⊤ : Subgroup ↥(subM V₁ (conjClosure I H) I))
      ((subM V₁ (conjClosure I H) I ⊓ fixV (autIH V₁ I H (conjClosure K T))).subgroupOf
        (subM V₁ (conjClosure I H) I)))}
    (hℓ : ∀ (i : ↥I) (hi : t * (i : G) * t⁻¹ ∈ I), ℓ (fI i) = fI ⟨_, hi⟩)
    (hℓ' : ∀ (i : ↥I) (hi : t' * (i : G) * t'⁻¹ ∈ I), ℓ' (fI i) = fI ⟨_, hi⟩) (i : ↥I) :
    ℓ' (ℓ (fI i) * fI i) = ℓ (fI i) * fI i := by
  obtain ⟨i, hi⟩ := i
  have hyi : y * i⁻¹ * y⁻¹ ∈ I := (Subgroup.mem_normalizer_iff.mp hy _).mp (I.inv_mem hi)
  have hz : i * (y * i⁻¹ * y⁻¹) ∈ I := I.mul_mem hi hyi
  have hfz : fI ⟨_, hz⟩ = ℓ (fI ⟨i, hi⟩) * fI ⟨i, hi⟩ := by
    have e1 : (⟨_, hz⟩ : ↥I) = ⟨i, hi⟩ * ⟨_, hyi⟩ := rfl
    have e2 : (⟨y * i⁻¹ * y⁻¹, hyi⟩ : ↥I) =
        (⟨y * i * y⁻¹, (Subgroup.mem_normalizer_iff.mp hy i).mp hi⟩ : ↥I)⁻¹ := by
      apply Subtype.ext
      show y * i⁻¹ * y⁻¹ = (y * i * y⁻¹)⁻¹
      group
    rw [e1, map_mul, e2, map_inv, secMap_conj_of_mem_QH hF hV₁I hIU ht htH hy htq hi,
      ← hℓ ⟨i, hi⟩ ((Subgroup.mem_normalizer_iff.mp ht i).mp hi),
      inv_eq_of_mul_eq_one_right (mul_self_sec hF hV₁I hIU _), mul_comm]
  have hc := hyy i (hIU hi)
  have hfix : y' * (i * (y * i⁻¹ * y⁻¹)) * y'⁻¹ = i * (y * i⁻¹ * y⁻¹) := by
    rw [commutatorElement_def, commutatorElement_def] at hc
    have e : i * y * i⁻¹ * y⁻¹ = i * (y * i⁻¹ * y⁻¹) := by group
    rw [e] at hc
    have h2 : (i * (y * i⁻¹ * y⁻¹)) * y' = y' * (i * (y * i⁻¹ * y⁻¹)) := by
      have h3 := congrArg (· * (y' * (i * (y * i⁻¹ * y⁻¹)))) hc
      simp only [one_mul] at h3
      rw [← h3]
      group
    calc y' * (i * (y * i⁻¹ * y⁻¹)) * y'⁻¹ = (i * (y * i⁻¹ * y⁻¹)) * y' * y'⁻¹ := by rw [h2]
      _ = i * (y * i⁻¹ * y⁻¹) := by group
  have hℓ'z : ℓ' (fI ⟨_, hz⟩) = fI ⟨_, hz⟩ := by
    rw [hℓ' ⟨_, hz⟩ ((Subgroup.mem_normalizer_iff.mp ht' _).mp hz),
      ← secMap_conj_of_mem_QH hF hV₁I hIU ht' ht'H hy' htq' hz]
    congr 1
    exact Subtype.ext hfix
  rw [← hfz]
  exact hℓ'z

