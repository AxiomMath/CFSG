local notation "fI" => secMap (HypF918.conjClosure_le_normalizer_V₁ hF hIU) hV₁I
  (Subgroup.subgroupOf (subM V₁ (conjClosure I H) I ⊓ fixV (autIH V₁ I H (conjClosure K T)))
    (subM V₁ (conjClosure I H) I))

theorem secMap_conj_of_mem_QH {y t : G}
    (ht : t ∈ Subgroup.normalizer (I : Set G)) (htH : t ∈ H)
    (hy : y ∈ Subgroup.normalizer (I : Set G)) (htq : t⁻¹ * y ∈ pCoreOf 2 H) {i : G}
    (hi : i ∈ I) :
    fI ⟨y * i * y⁻¹, (Subgroup.mem_normalizer_iff.mp hy i).mp hi⟩ =
      fI ⟨t * i * t⁻¹, (Subgroup.mem_normalizer_iff.mp ht i).mp hi⟩ := by
  have h1 := hF.toHypF98.toHypF91
  have hHV₁ : H ≤ Subgroup.normalizer (V₁ : Set G) := hF.H_le_normalizer_V₁
  have hV₁C : V₁ ≤ centralizerMod V₁ I (conjClosure K T) :=
    le_centralizerMod hHV₁ hF.K₀_le_H hV₁I
  have hv : (t⁻¹ * y) * i * (t⁻¹ * y)⁻¹ * i⁻¹ ∈ V₁ := by
    have hq := htq
    rw [h1.pCoreOf_eq_centralizerMod] at hq
    exact hq.2.2 i (hIU hi)
  have h2 : t * ((t⁻¹ * y) * i * (t⁻¹ * y)⁻¹ * i⁻¹) * t⁻¹ ∈ V₁ :=
    (Subgroup.mem_normalizer_iff.mp (hHV₁ htH) _).mp hv
  have e : y * i * y⁻¹ * (t * i * t⁻¹)⁻¹ = t * ((t⁻¹ * y) * i * (t⁻¹ * y)⁻¹ * i⁻¹) * t⁻¹ := by
    group
  have h3 := (secMap_eq_one_iff hF hV₁I hIU
    ((⟨y * i * y⁻¹, (Subgroup.mem_normalizer_iff.mp hy i).mp hi⟩ : ↥I) *
      (⟨t * i * t⁻¹, (Subgroup.mem_normalizer_iff.mp ht i).mp hi⟩ : ↥I)⁻¹)).mpr
    (show y * i * y⁻¹ * (t * i * t⁻¹)⁻¹ ∈ centralizerMod V₁ I (conjClosure K T) by
      rw [e]
      exact hV₁C h2)
  rw [map_mul, map_inv, mul_inv_eq_one] at h3
  exact h3

theorem mem_QH_of_secMap_conj (hK₀ : conjClosure K T = K)
    (hS' : IsSimpleGroup (↥K ⧸ CFSG.pCore 2 ↥K)) (hirr : IsIrrPlusTilde V₁ (conjClosure K T) I)
    {x : G} (hx : x ∈ K)
    (h : ∀ i (hi : i ∈ I), fI ⟨x * i * x⁻¹,
      (Subgroup.mem_normalizer_iff.mp ((le_conjClosure K T).trans hirr.1 hx) i).mp hi⟩ =
        fI ⟨i, hi⟩) :
    x ∈ pCoreOf 2 H := by
  have hOQ : pCoreOf 2 K ≤ pCoreOf 2 H :=
    A4.pCoreOf_le_of_subnormal 2 (subnormal_of_mem_cComp hF.K_cComp)
  have h2 := mk_eq_one_of_comm (x := ⟨x, hx⟩) hF hK₀ hS' hV₁I hIU hirr fun i hi =>
    (secMap_eq_one_iff hF hV₁I hIU (⟨_, (Subgroup.mem_normalizer_iff.mp
      ((le_conjClosure K T).trans hirr.1 hx) i).mp hi⟩ * (⟨i, hi⟩ : ↥I)⁻¹)).mp
      (by rw [map_mul, map_inv, h i hi, mul_inv_cancel])
  rw [QuotientGroup.eq_one_iff, A6L24.mem_pCore_iff'] at h2
  exact hOQ h2

