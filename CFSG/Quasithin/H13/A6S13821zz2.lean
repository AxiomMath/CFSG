theorem false_of_quad_alt5 (hK₀ : conjClosure K T = K) (hS' : IsSimpleGroup (↥K ⧸ CFSG.pCore 2 ↥K))
    (hirr : IsIrrPlusTilde V₁ (conjClosure K T) I)
    (hA5 : AlternatingNatural (autSec (autSub (autIH V₁ I H K) (subM V₁ (conjClosure I H) I)) ⊤
        ((subM V₁ (conjClosure I H) I ⊓ fixV (autIH V₁ I H (conjClosure K T))).subgroupOf
          (subM V₁ (conjClosure I H) I))) ⊤ ⊥ 5)
    {y₁ y₂ t₁ t₂ : G} (ht₁ : t₁ ∈ K) (ht₂ : t₂ ∈ K)
    (hy₁I : y₁ ∈ Subgroup.normalizer (I : Set G)) (hy₂I : y₂ ∈ Subgroup.normalizer (I : Set G))
    (hyt₁ : t₁⁻¹ * y₁ ∈ pCoreOf 2 H) (hyt₂ : t₂⁻¹ * y₂ ∈ pCoreOf 2 H)
    (hy₁Q : y₁ ∉ pCoreOf 2 H) (hy₂Q : y₂ ∉ pCoreOf 2 H) (hy₁₂ : y₁⁻¹ * y₂ ∉ pCoreOf 2 H)
    (hq : ∀ u ∈ conjClosure Vp H, ⁅⁅u, y₁⁆, y₂⁆ = 1 ∧ ⁅⁅u, y₁⁆, y₁⁆ = 1) : False := by
  classical
  have hKH : K ≤ H := le_of_mem_cComp hF.K_cComp
  have hKI : K ≤ Subgroup.normalizer (I : Set G) := (le_conjClosure K T).trans hirr.1
  have hconjI : ∀ {x : G}, x ∈ Subgroup.normalizer (I : Set G) → ∀ i ∈ I, x * i * x⁻¹ ∈ I :=
    fun hx i hi => (Subgroup.mem_normalizer_iff.mp hx i).mp hi
  obtain ⟨ℓ₁, hℓ₁L, hℓ₁⟩ := exists_secHom_secMap (K := K) hF hV₁I hIU hKH hKI ht₁
  obtain ⟨ℓ₂, hℓ₂L, hℓ₂⟩ := exists_secHom_secMap (K := K) hF hV₁I hIU hKH hKI ht₂
  have hℓ1 : ∀ {ℓ : MulAut (Sec (⊤ : Subgroup ↥(subM V₁ (conjClosure I H) I))
      ((subM V₁ (conjClosure I H) I ⊓ fixV (autIH V₁ I H (conjClosure K T))).subgroupOf
        (subM V₁ (conjClosure I H) I)))} {t y : G}, t ∈ K → y ∉ pCoreOf 2 H →
      t⁻¹ * y ∈ pCoreOf 2 H → (∀ (i : ↥I) (hi : t * (i : G) * t⁻¹ ∈ I), ℓ (fI i) = fI ⟨_, hi⟩) →
      ℓ ≠ 1 := by
    intro ℓ t y ht hyQ htq hℓ h1'
    apply hyQ
    have htQ : t ∈ pCoreOf 2 H := mem_QH_of_secMap_conj hF hV₁I hIU hK₀ hS' hirr ht
      fun i hi => by
        rw [← hℓ ⟨i, hi⟩ (hconjI (hKI ht) i hi), h1']
        rfl
    have e : y = t * (t⁻¹ * y) := by group
    rw [e]
    exact (pCoreOf 2 H).mul_mem htQ htq
  have hℓ₁1 := hℓ1 ht₁ hy₁Q hyt₁ hℓ₁
  have hℓ₂1 := hℓ1 ht₂ hy₂Q hyt₂ hℓ₂
  have hℓ₁₂ : ℓ₁ ≠ ℓ₂ := by
    intro h12
    apply hy₁₂
    have hx : t₁⁻¹ * t₂ ∈ K := K.mul_mem (K.inv_mem ht₁) ht₂
    have hxQ : t₁⁻¹ * t₂ ∈ pCoreOf 2 H := mem_QH_of_secMap_conj hF hV₁I hIU hK₀ hS' hirr hx
      fun i hi => by
        have hxi : (t₁⁻¹ * t₂) * i * (t₁⁻¹ * t₂)⁻¹ ∈ I := hconjI (hKI hx) i hi
        have h2 : ℓ₁ (fI ⟨_, hxi⟩) = fI ⟨t₂ * i * t₂⁻¹, hconjI (hKI ht₂) i hi⟩ := by
          rw [hℓ₁ ⟨_, hxi⟩ (hconjI (hKI ht₁) _ hxi)]
          congr 1
          apply Subtype.ext
          show t₁ * ((t₁⁻¹ * t₂) * i * (t₁⁻¹ * t₂)⁻¹) * t₁⁻¹ = t₂ * i * t₂⁻¹
          group
        have h3 := hℓ₂ ⟨i, hi⟩ (hconjI (hKI ht₂) i hi)
        apply ℓ₁.injective
        rw [h2, ← h3, ← h12]
    have e : y₁⁻¹ * y₂ = (t₁⁻¹ * y₁)⁻¹ * (t₁⁻¹ * t₂) * (t₂⁻¹ * y₂) := by group
    rw [e]
    exact (pCoreOf 2 H).mul_mem ((pCoreOf 2 H).mul_mem ((pCoreOf 2 H).inv_mem hyt₁) hxQ) hyt₂
  have hq₁₂ := secMap_quad hF hV₁I hIU (hKI ht₁) (hKH ht₁) (hKI ht₂) (hKH ht₂) hy₁I hy₂I hyt₁
    hyt₂ (fun u hu => (hq u hu).1) hℓ₁ hℓ₂
  have hq₁₁ := secMap_quad hF hV₁I hIU (hKI ht₁) (hKH ht₁) (hKI ht₁) (hKH ht₁) hy₁I hy₁I hyt₁
    hyt₁ (fun u hu => (hq u hu).2) hℓ₁ hℓ₁
  obtain ⟨π, Ψ, hπs, hΨadd, -, -, hΨonto, hΨeq⟩ := exists_isA5Coord hA5
  obtain ⟨γ₁, hγ₁⟩ := hπs ⟨ℓ₁, hℓ₁L⟩
  obtain ⟨γ₂, hγ₂⟩ := hπs ⟨ℓ₂, hℓ₂L⟩
  have hπℓ : ∀ {γ : alternatingGroup (Fin 5)} {ℓ}, ∀ hℓL, π γ = ⟨ℓ, hℓL⟩ →
      ∀ w, Ψ (ℓ w) = Vol2.Ch10.SecD.C10P06.pv γ (Ψ w) := by
    intro γ ℓ hℓL h w
    have h2 := hΨeq γ w
    rw [h] at h2
    exact h2
  have hne : ∀ {γ : alternatingGroup (Fin 5)} {ℓ}, ∀ hℓL, π γ = ⟨ℓ, hℓL⟩ → ℓ ≠ 1 →
      (γ : Perm (Fin 5)) ≠ 1 := by
    intro γ ℓ hℓL h hℓ1' hγ
    apply hℓ1'
    have h2 : γ = 1 := Subtype.ext hγ
    rw [h2, map_one] at h
    exact (congrArg Subtype.val h).symm
  have hγ12 : (γ₁ : Perm (Fin 5)) ≠ γ₂ := by
    intro h
    apply hℓ₁₂
    have h2 : γ₁ = γ₂ := Subtype.ext h
    rw [h2, hγ₂] at hγ₁
    exact (congrArg Subtype.val hγ₁).symm
  obtain ⟨u, hu, hu'⟩ := not_quad_pair γ₁ γ₂ (Perm.mem_alternatingGroup.mp γ₁.2)
