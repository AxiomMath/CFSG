theorem false_of_pCoreOf_eq_bot_slices
    (hA5 : CFSG.Quasithin.F112R.F112SliceA5)
    (hSz : Nat.card ↥(Sz 0) = 20) (h12213 : Stmt12_2_13)
    (hU : fsuU T V = pCoreOf 2 (l32nH T V))
    (h0 : pCoreOf 2 (preM D e KA5 ⊔ i128 T L V (fsuV1 T V) ⊔ T) = ⊥) : False := by
  have hnorm : (T.subgroupOf (T ⊔ borelOf (preM D e KA5) T)).Normal ∨
      (T.subgroupOf (T ⊔ borelOf (i128 T L V (fsuV1 T V)) T)).Normal := by
    right
    rw [sup_eq_left.mpr (borelOf_I2_le h12213 C.base), Subgroup.subgroupOf_self]
    infer_instance
  have hyp := C.hyp111 h12213 h0
  have hqt := isQuasithinSub_of_qtke C.base.hyp.fsu.qtke
    (preM D e KA5 ⊔ i128 T L V (fsuV1 T V) ⊔ T)
  have hK0 : IsL2Quot 2 (oTwoQuot ↥(preM D e KA5)) := by
    obtain ⟨φ⟩ := C.nonempty_quot_K0
    have : IsSimpleGroup ↥KA5 := isSimpleGroup_KA5
    obtain ⟨ψ⟩ := CFSG.Walter.Suzuki.nonempty_mulEquiv_psl24 card_KA5
    exact ⟨φ.trans ψ⟩
  have hI2 : Nonempty (oTwoQuot ↥(i128 T L V (fsuV1 T V)) ≃* Equiv.Perm (Fin 3)) :=
    nonempty_oTwoQuot_I2 h12213 C.base
  obtain ⟨L1', L2', hLL, -, hlist, -⟩ := hA5 G (preM D e KA5) (i128 T L V (fsuV1 T V)) T
    ⟨hyp, hqt, hnorm⟩ (Or.inr (Or.inr ⟨hK0, hI2⟩))
  have hKO : 2 ^ 9 ≤ Nat.card (pCoreOf 2 (preM D e KA5 ⊔
      bigB (preM D e KA5) (i128 T L V (fsuV1 T V)) T)) :=
    (C.card_pCoreOf_K0 hU).symm.le.trans
      (Subgroup.card_le_of_le hyp.pCoreOf_le_pCoreOf_vertex)
  rcases hLL with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact not_f112ListC hSz C.card_oTwoQuot_K0 (card_oTwoQuot_I2 h12213 C.base)
      hKO C.card_K0_gt hlist
  · exact not_f112List_swapC C.card_oTwoQuot_K0 (card_oTwoQuot_I2 h12213 C.base) C.card_K0_gt
      (C.not_isShort2_K0 hU) hlist

end CtxA

