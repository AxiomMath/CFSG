@[expose] def pow256R (r : Array ℕ) : Array ℕ := (List.range 8).foldl (fun y _ => mulR y y) r

@[expose] def gensOKb (gs : List (Array ℕ)) : Bool :=
  gs.all fun g => Viol.okRows g && Viol.okRows (Viol.invR g) && mulR g (Viol.invR g) == idR &&
    mulR (Viol.invR g) g == idR

@[expose] def stabOK (v : ℕ) (gs ps : List (Array ℕ)) (W : List (Array ℕ × Array ℕ))
    (nS nP : ℕ) : Bool :=
  let X := enumGrp gs
  let P := enumGrp ps
  let Xs := Std.HashSet.ofList X
  let Ps := Std.HashSet.ofList P
  gensOKb gs && gensOKb ps && gs.all (fun g => appN g v == v) &&
    X.contains idR && closedCheck gs X && X.dedup.length == nS &&
    P.contains idR && closedCheck ps P && P.dedup.length == nP &&
    ps.all (fun p => Xs.contains p) &&
    gs.all (fun t => ps.all fun p => Ps.contains (mulR t (mulR p (Viol.invR t)))) &&
    W.all (fun w => Xs.contains w.1 && Viol.okRows w.2 && mulR w.1 w.2 == idR &&
      mulR w.2 w.1 == idR) &&
    X.all (fun x => pow256R x != idR || Ps.contains x ||
      W.any fun w => pow256R (mulR x (mulR w.1 (mulR x w.2))) != idR)

