@[expose] def orbitOK42 (_ : Unit := ()) : Bool :=
  orbitSetOK gamGens 3 inO1b && orbitSetOK gamGens 5 inO2b && orbitSetOK gamGens 1 q0b &&
    (List.range 4096).all (fun n => nGensI.all fun g =>
      (!inO1b n || inO1b (appN g n)) && (!inO2b n || inO2b (appN g n))) &&
    (List.range 4096).all (fun n =>
      let k := ([q0b n, inO1b n, inO2b n].filter id).length
      if n == 0 then k == 0 else k == 1) &&
    ((List.range 4096).filter inO1b).length == 693 &&
    ((List.range 4096).filter inO2b).length == 1386

