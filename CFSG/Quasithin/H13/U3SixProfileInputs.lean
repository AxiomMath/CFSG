@[expose] def fixP (m c : ℕ) : Bool :=
  (List.range 64).all fun k => !m.testBit k || vapp (s0m k) c == c

@[expose] def rangeCard (k : ℕ) : ℕ :=
  ((Finset.range 64).image fun d => vapp (s0m k) d ^^^ d).card

@[expose] def failOK (x : ℕ × ℕ × ℕ × ℕ) : Bool :=
  x.2.1.testBit 0 && decide (x.2.2.1 < 64) && decide (x.2.2.2 < 64) && x.1.testBit x.2.2.2 &&
    (vapp (s0m x.2.2.2) x.2.2.1 != x.2.2.1) && ((ofMask x.1).card == 2 * (ofMask x.2.1).card) &&
    (List.range 64).all fun i => !x.2.1.testBit i || (x.1.testBit i && tab i i == 0 &&
      vapp (s0m i) x.2.2.1 == x.2.2.1 &&
      (List.range 64).all fun j => !x.2.1.testBit j || x.2.1.testBit (tab i j))

@[expose] def goodOK (x : ℕ × ℕ) : Bool :=
  ((ofMask x.1).card == 8) &&
    ((List.range 64).all fun k => !x.1.testBit k ||
      (List.range 64).all fun d => fixP x.1 (vapp (s0m k) d ^^^ d)) &&
    ((List.range 64).all fun c => !fixP x.1 c ||
      (List.range 64).any fun k => x.1.testBit k &&
        (List.range 64).any fun d => vapp (s0m k) d ^^^ d == c) &&
    (((Finset.range 64).filter fun c => fixP x.1 c = true).card == 8) &&
    x.1.testBit x.2 && (x.2 != 0) && decide (x.2 < 64) && (rangeCard x.2 == 4)

