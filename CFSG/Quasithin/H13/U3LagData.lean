theorem lag3_tree : ∀ k < 63, 0 < k →
    (lag3Par.getD k (0, 0)).1 < k ∧ (lag3Par.getD k (0, 0)).2 < 5 ∧
      maskImg (gens7.getD (lag3Par.getD k (0, 0)).2 []) (lag3c.getD (lag3Par.getD k (0, 0)).1 0) =
        lag3c.getD k 0 := by
  decide +kernel

theorem lag3_length : lag3c.length = 63 ∧ lag3c.getD 0 0 = spanMask3 15 18 39 := by
  decide +kernel

theorem lag3_closed : ∀ m ∈ lag3c, ∀ g ∈ gens7, maskImg g m ∈ lag3c := by
  decide +kernel

theorem lagY_closed : ∀ m ∈ lagYc, ∀ g ∈ gens7, maskImg g m ∈ lagYc := by
  decide +kernel

theorem lag_disjoint : ∀ m ∈ lagYc, m ∉ lag3c := by
  decide +kernel

theorem lagYtri_spec : lagYtri.length = 72 ∧ ∀ k < 72,
    spanMask3 (lagYtri.getD k (0, 0, 0)).1 (lagYtri.getD k (0, 0, 0)).2.1
      (lagYtri.getD k (0, 0, 0)).2.2 = lagYc.getD k 0 ∧
    (lagYtri.getD k (0, 0, 0)).1 < 64 ∧ (lagYtri.getD k (0, 0, 0)).2.1 < 64 ∧
    (lagYtri.getD k (0, 0, 0)).2.2 < 64 := by
  decide +kernel

theorem lagY_free : ∀ e ∈ s0c.tail, ∀ t ∈ lagYtri,
    ¬ (vapp e t.1 = t.1 ∧ vapp e t.2.1 = t.2.1 ∧ vapp e t.2.2 = t.2.2) := by
  decide +kernel

theorem dotB_b0c_symm : ∀ u < 64, ∀ v < 64, dotB u (vapp b0c v) = dotB v (vapp b0c u) := by
  decide +kernel

@[expose] def lagCoverOK : Bool :=
  (List.range 64).all fun u₁ => (List.range 64).all fun u₂ =>
    !(decide (0 < u₁) && decide (u₁ < u₂) && !dotB u₁ (vapp b0c u₂)) ||
      (List.range 64).all fun u₃ =>
        !(decide (u₂ < u₃) && !dotB u₁ (vapp b0c u₃) && !dotB u₂ (vapp b0c u₃) &&
          decide (u₃ ≠ u₁ ^^^ u₂)) ||
          (lag3c.contains (spanMask3 u₁ u₂ u₃) || lagYc.contains (spanMask3 u₁ u₂ u₃))

theorem lagCoverOK_eq : lagCoverOK = true := by
  decide +kernel

theorem lag_cover : ∀ u₁ < 64, ∀ u₂ < 64, 0 < u₁ → u₁ < u₂ → dotB u₁ (vapp b0c u₂) = false →
    ∀ u₃ < 64, u₂ < u₃ → dotB u₁ (vapp b0c u₃) = false → dotB u₂ (vapp b0c u₃) = false →
      u₃ ≠ u₁ ^^^ u₂ → spanMask3 u₁ u₂ u₃ ∈ lag3c ∨ spanMask3 u₁ u₂ u₃ ∈ lagYc := by
  intro u₁ hu₁ u₂ hu₂ h0 h12 hb12 u₃ hu₃ h23 hb13 hb23 hne
  have h := lagCoverOK_eq
  simp only [lagCoverOK, List.all_eq_true, List.mem_range] at h
  have h1 := h u₁ hu₁ u₂ hu₂
  simp only [h0, h12, hb12, decide_true, Bool.not_false, Bool.and_self, Bool.not_true,
    Bool.false_or, List.all_eq_true, List.mem_range] at h1
  have h2 := h1 u₃ hu₃
  simp only [h23, hb13, hb23, ne_eq, hne, not_false_eq_true, decide_true, Bool.not_false,
    Bool.and_self, Bool.not_true, Bool.false_or, Bool.or_eq_true, List.contains_iff_mem] at h2
  exact h2

