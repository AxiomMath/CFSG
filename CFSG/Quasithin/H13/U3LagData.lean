@[expose] def maskImg (g : List ℕ) (m : ℕ) : ℕ :=
  (List.range 64).foldr (fun c acc => if m.testBit c then acc ||| 2 ^ vapp g c else acc) 0

@[expose] def spanMask3 (a b c : ℕ) : ℕ :=
  2 ^ 0 ||| 2 ^ a ||| 2 ^ b ||| 2 ^ c ||| 2 ^ (a ^^^ b) ||| 2 ^ (a ^^^ c) ||| 2 ^ (b ^^^ c) |||
    2 ^ (a ^^^ b ^^^ c)

