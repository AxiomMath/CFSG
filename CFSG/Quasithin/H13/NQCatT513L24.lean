local notation "L24" => Matrix.ProjectiveSpecialLinearGroup (Fin 2) (GaloisField 2 2)

theorem exists_l24_of_lieModel {X : Type} [Group X]
    (h : CFSG.Blueprint.LieModel X .PSL 2 2 2) : Nonempty (X ≃* L24) := by
  obtain ⟨-, -, -, F, _, _, hF, ⟨e⟩⟩ :=
    CFSG.ComponentClassification.HarrisLit.exists_psl2_of_lieModel h
  let _ : Fintype F := Fintype.ofFinite F
  let _ : Fintype (GaloisField 2 2) := Fintype.ofFinite _
  have hcard : Fintype.card F = Fintype.card (GaloisField 2 2) := by
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hF,
      GaloisField.card 2 2 (by norm_num)]
  exact ⟨e.trans (CFSG.Adapters.RankTwoModelTransports.projectiveSpecialLinearGroupCongr (Fin 2)
    (FiniteField.ringEquivOfCardEq hcard))⟩

theorem mem_normalizer_of_conj_mem {G : Type*} [Group G] [Finite G] {H : Subgroup G} {g : G}
    (h : ∀ x ∈ H, g * x * g⁻¹ ∈ H) : g ∈ Subgroup.normalizer (H : Set G) := by
  have hle : H.map (MulAut.conj g).toMonoidHom ≤ H := by
    rintro _ ⟨x, hx, rfl⟩
    exact h x hx
  have hcard : Nat.card (H.map (MulAut.conj g).toMonoidHom) = Nat.card H :=
    Subgroup.card_map_of_injective (MulAut.conj g).injective
  have heq := Subgroup.eq_of_le_of_card_ge hle hcard.ge
  rw [Subgroup.mem_normalizer_iff]
  intro x
  refine ⟨h x, fun hx => ?_⟩
  rw [← heq] at hx
  obtain ⟨y, hy, hyx⟩ := hx
  have : y = x := by simpa [MulAut.conj_apply] using hyx
  rwa [← this]

theorem card_normalizer_dvd_of_centralizer_le {G : Type*} [Group G] [Finite G] {T : Subgroup G}
    (hC : Subgroup.centralizer (T : Set G) ≤ T) :
    Nat.card (Subgroup.normalizer (T : Set G)) ∣ Nat.card T * (Nat.card T).factorial := by
  set N := Subgroup.normalizer (T : Set G) with hN
  let φ : ↥N →* MulAut ↥(T.subgroupOf N) := MulAut.conjNormal
  have hker : φ.ker ≤ T.subgroupOf N := by
    intro n hn
    rw [Subgroup.mem_subgroupOf]
    apply hC
    rw [Subgroup.mem_centralizer_iff]
    intro t ht
    have h1 := DFunLike.congr_fun (MonoidHom.mem_ker.mp hn) ⟨⟨t, Subgroup.le_normalizer ht⟩, ht⟩
    have h2 := congrArg (fun z : ↥(T.subgroupOf N) => ((z : ↥N) : G)) h1
    simp only [MulAut.one_apply] at h2
    rw [MulAut.conjNormal_apply] at h2
    simp only [Subgroup.coe_mul, Subgroup.coe_inv] at h2
    calc t * (n : G) = ((n : G) * t * (n : G)⁻¹) * n := by rw [h2]
      _ = n * t := by group
  have hTN : Nat.card ↥(T.subgroupOf N) = Nat.card T :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe Subgroup.le_normalizer).toEquiv
  have hk : Nat.card φ.ker ∣ Nat.card T := hTN ▸ Subgroup.card_dvd_of_le hker
  have hr : Nat.card φ.range ∣ (Nat.card T).factorial := by
    have h1 : Nat.card φ.range ∣ Nat.card (MulAut ↥(T.subgroupOf N)) :=
      Subgroup.card_subgroup_dvd_card _
    have h2 : Nat.card (MulAut ↥(T.subgroupOf N)) ∣ Nat.card (Equiv.Perm ↥(T.subgroupOf N)) := by
      have hinj : Function.Injective (MulAut.toPerm ↥(T.subgroupOf N)) :=
        fun a b hab => MulEquiv.ext fun x => congrArg (fun σ => σ x) hab
      rw [Nat.card_congr (MonoidHom.ofInjective hinj).toEquiv]
      exact Subgroup.card_subgroup_dvd_card _
    rw [Nat.card_perm, hTN] at h2
    exact h1.trans h2
  rw [Subgroup.card_eq_card_quotient_mul_card_subgroup φ.ker,
    Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv, mul_comm]
  exact Nat.mul_dvd_mul hk hr

theorem card_normalizer_dvd_twelve {L : Type*} [Group L] [Finite L] (e : L ≃* L24)
    (T : Sylow 2 L) : Nat.card (Subgroup.normalizer ((T : Subgroup L) : Set L)) ∣ 12 := by
  have hT4 := CFSG.Walter.JT.card_sylow_of_psl24 e T
  obtain ⟨y, hyT, hy1⟩ : ∃ y ∈ (T : Subgroup L), y ≠ 1 := by
    by_contra hcon
    push Not at hcon
    have : (T : Subgroup L) = ⊥ := (Subgroup.eq_bot_iff_forall _).mpr hcon
    rw [this, Subgroup.card_bot] at hT4
    omega
  have hC : Subgroup.centralizer ((T : Subgroup L) : Set L) ≤ T :=
    calc Subgroup.centralizer ((T : Subgroup L) : Set L) ≤ Subgroup.centralizer {y} :=
          Subgroup.centralizer_le (Set.singleton_subset_iff.mpr hyT)
      _ = T := CFSG.Walter.JT.centralizer_le_of_psl24 e T hyT hy1
  have h96 := card_normalizer_dvd_of_centralizer_le hC
  rw [hT4] at h96
  have h60 : Nat.card (Subgroup.normalizer ((T : Subgroup L) : Set L)) ∣ 60 := by
    rw [← CFSG.Walter.JT.card_of_psl24 e]
    exact Subgroup.card_subgroup_dvd_card _
  exact (Nat.dvd_gcd h96 h60).trans (by decide)

variable {A : Type} [Group A] [Finite A]

theorem card_B {Q R S B D : Subgroup A} (h : Star513 Q R S B D) : Nat.card B = 3 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨e₄⟩ := exists_l24_of_lieModel h.R_type
  let π : ↥R →* ModO2 R := QuotientGroup.mk' _
  have hπ : Function.Surjective π := QuotientGroup.mk'_surjective _
  have hkerπ : π.ker = CFSG.pCore 2 ↥R := QuotientGroup.ker_mk' _
  obtain ⟨-, hSR2, hSRi⟩ := h.sylow_R
  set P : Subgroup ↥R := (S ⊓ R).subgroupOf R with hP
  have hP2 : IsPGroup 2 P := hSR2.of_equiv (Subgroup.subgroupOfEquivOfLe inf_le_right).symm
  let PS : Sylow 2 ↥R := hP2.toSylow hSRi
  have hcore : CFSG.pCore 2 ↥R ≤ P :=
    (CFSG.pCore_isPGroup (G := ↥R) (p := 2)).le_sylow_of_normal PS
  have hPb2 : IsPGroup 2 (P.map π) := hP2.map π
  have hPbi : ¬ 2 ∣ (P.map π).index := fun h2 => hSRi (h2.trans (P.index_map_dvd hπ))
  let PbS : Sylow 2 (ModO2 R) := hPb2.toSylow hPbi
  obtain ⟨hBY, hBodd, k, hk⟩ := h.hall_B
  have hBR : B ≤ R := hBY.trans inf_le_left
  let fB : ↥(B.subgroupOf R) →* ModO2 R := π.comp (B.subgroupOf R).subtype
  have hfB : Function.Injective fB := by
    rw [injective_iff_map_eq_one]
    intro b hb
    have hb' : ((b : ↥R) : ↥R) ∈ CFSG.pCore 2 ↥R := by
      rw [← hkerπ]
      exact hb
    obtain ⟨n, hn⟩ := IsPGroup.iff_orderOf.mp (CFSG.pCore_isPGroup (G := ↥R) (p := 2))
      ⟨(b : ↥R), hb'⟩
    have hodd : Odd (orderOf (b : ↥R)) := by
      have h1 : orderOf ((b : ↥R) : A) ∣ Nat.card B := Subgroup.orderOf_dvd_natCard B b.2
      rw [Subgroup.orderOf_coe] at h1
      exact Odd.of_dvd_nat hBodd h1
    rw [Subgroup.orderOf_mk] at hn
    rw [hn] at hodd
    have hn0 : n = 0 := by
      rcases Nat.eq_zero_or_pos n with h0 | h0
      · exact h0
      · exact absurd (Nat.even_pow.mpr ⟨even_two, h0.ne'⟩) (Nat.not_even_iff_odd.mpr hodd)
    rw [hn0, pow_zero] at hn
    exact Subtype.ext (orderOf_eq_one_iff.mp hn)
  have hrange : fB.range ≤ Subgroup.normalizer (((PbS : Subgroup (ModO2 R))) : Set (ModO2 R)) := by
    rintro _ ⟨b, rfl⟩
    have hbN : ((b : ↥R) : A) ∈ Subgroup.normalizer ((S ⊓ R : Subgroup A) : Set A) :=
      (hBY (b.2 : ((b : ↥R) : A) ∈ B)).2
    apply mem_normalizer_of_conj_mem
    rintro _ ⟨s, hs, rfl⟩
    refine ⟨(b : ↥R) * s * (b : ↥R)⁻¹, ?_, by simp [fB]⟩
    have hs' : (s : A) ∈ S ⊓ R := hs
    show (((b : ↥R) * s * (b : ↥R)⁻¹ : ↥R) : A) ∈ S ⊓ R
    exact (Subgroup.mem_normalizer_iff.mp hbN _).mp hs'
  have hBdvd : Nat.card B ∣ 12 := by
    have h1 : Nat.card fB.range ∣ 12 :=
      (Subgroup.card_dvd_of_le hrange).trans (card_normalizer_dvd_twelve e₄ PbS)
    rwa [Nat.card_congr (MonoidHom.ofInjective hfB).toEquiv.symm,
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hBR).toEquiv] at h1
  obtain ⟨ybar, hybar, hy3⟩ := CFSG.Walter.JT.exists_orderOf_three_mem_normalizer_of_psl24 e₄ PbS
  obtain ⟨y, rfl⟩ := hπ ybar
  have hyN : (y : A) ∈ R ⊓ Subgroup.normalizer ((S ⊓ R : Subgroup A) : Set A) := by
    refine ⟨y.2, ?_⟩
    have hyP : y ∈ Subgroup.normalizer (P : Set ↥R) := by
      apply mem_normalizer_of_conj_mem
      intro s hs
      have h1 : π (y * s * y⁻¹) ∈ P.map π := by
        rw [map_mul, map_mul, map_inv]
        exact (Subgroup.mem_normalizer_iff.mp hybar _).mp ⟨s, hs, rfl⟩
      obtain ⟨s', hs', hs'e⟩ := h1
      have h2 : s'⁻¹ * (y * s * y⁻¹) ∈ P := by
        apply hcore
        rw [← hkerπ, MonoidHom.mem_ker, map_mul, map_inv, hs'e, inv_mul_cancel]
      have := P.mul_mem hs' h2
      rwa [mul_inv_cancel_left] at this
    apply mem_normalizer_of_conj_mem
    intro s hs
    have h1 := (Subgroup.mem_normalizer_iff.mp hyP ⟨s, hs.2⟩).mp
      (show (⟨s, hs.2⟩ : ↥R) ∈ P from hs)
    exact h1
  have h3Y : 3 ∣ Nat.card ↥(R ⊓ Subgroup.normalizer ((S ⊓ R : Subgroup A) : Set A)) := by
    have h1 : orderOf (π y) ∣ orderOf y := orderOf_map_dvd π y
    rw [hy3, ← Subgroup.orderOf_coe] at h1
    exact h1.trans (Subgroup.orderOf_dvd_natCard _ hyN)
  have hYcard : Nat.card ↥(R ⊓ Subgroup.normalizer ((S ⊓ R : Subgroup A) : Set A)) =
      2 ^ k * Nat.card B := by
    rw [← hk, ← Subgroup.relIndex_mul_card B _, inf_eq_left.mpr hBY]
  rw [hYcard] at h3Y
  have h3B : 3 ∣ Nat.card B :=
    (Nat.Coprime.pow_right k (by norm_num : Nat.Coprime 3 2)).dvd_of_dvd_mul_left h3Y
  have hB3 : Nat.card B ∣ 3 := by
    have hpos : 0 < Nat.card B := Nat.card_pos
    have hle : Nat.card B ≤ 12 := Nat.le_of_dvd (by norm_num) hBdvd
    obtain ⟨m, hm⟩ := hBodd
    interval_cases hc : Nat.card B <;> omega
  exact Nat.dvd_antisymm hB3 h3B

theorem nonempty_equiv_l24_of_surjective {X Y : Type*} [Group X] [Group Y] [Finite X]
    (eX : X ⧸ CFSG.pCore 2 X ≃* L24) (f : X →* Y) (hf : Function.Surjective f)
    (hker : IsPGroup 2 f.ker) (hY : ∀ T : Subgroup Y, IsPGroup 2 T → Nat.card T ≤ 4) :
    Nonempty (Y ≃* L24) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Finite Y := Finite.of_surjective f hf
  have hle : f.ker ≤ CFSG.pCore 2 X := le_sSup ⟨inferInstance, hker⟩
  let eY : X ⧸ f.ker ≃* Y := QuotientGroup.quotientKerEquivOfSurjective f hf
  let g₀ : X ⧸ f.ker →* X ⧸ CFSG.pCore 2 X :=
    QuotientGroup.map f.ker (CFSG.pCore 2 X) (MonoidHom.id X) hle
  have hg₀ : Function.Surjective g₀ := by
    intro x
    induction x using QuotientGroup.induction_on with
    | H x => exact ⟨QuotientGroup.mk x, rfl⟩
  let g : Y →* X ⧸ CFSG.pCore 2 X := g₀.comp eY.symm.toMonoidHom
  have hg : Function.Surjective g := hg₀.comp eY.symm.surjective
  have hkg : IsPGroup 2 g.ker := by
    have h1 : g.ker = (CFSG.pCore 2 X).map f := by
      ext y
      obtain ⟨x, rfl⟩ := hf y
      constructor
      · intro hy
        have hx : (QuotientGroup.mk x : X ⧸ CFSG.pCore 2 X) = 1 := by
          have := hy
          simp only [MonoidHom.mem_ker, g, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom] at this
          have e1 : eY.symm (f x) = (QuotientGroup.mk x : X ⧸ f.ker) :=
            eY.symm_apply_eq.mpr rfl
          rw [e1] at this
          exact this
        exact ⟨x, (QuotientGroup.eq_one_iff x).mp hx, rfl⟩
      · rintro ⟨x', hx', hx'e⟩
        rw [← hx'e, MonoidHom.mem_ker]
        simp only [g, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom]
        have e1 : eY.symm (f x') = (QuotientGroup.mk x' : X ⧸ f.ker) :=
          eY.symm_apply_eq.mpr rfl
        rw [e1]
        exact (QuotientGroup.eq_one_iff x').mpr hx'
    rw [h1]
    exact (CFSG.pCore_isPGroup (G := X) (p := 2)).map f
  obtain ⟨a, ha⟩ := IsPGroup.iff_card.mp hkg
  have hY60 : Nat.card Y = 60 * 2 ^ a := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup g.ker,
      Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective g hg).toEquiv,
      Nat.card_congr eX.toEquiv, CFSG.Walter.JT.card_of_psl24 (MulEquiv.refl _), ha]
  obtain ⟨T, hT⟩ := Sylow.exists_subgroup_card_pow_prime (G := Y) 2 (n := a + 2)
    (by rw [hY60, pow_add]; exact ⟨15, by ring⟩)
  have hT4 := hY T (IsPGroup.of_card hT)
  rw [hT] at hT4
  have ha0 : a = 0 := by
    by_contra ha0
    have : 2 ^ (a + 2) ≥ 2 ^ 3 := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  have hinj : Function.Injective g := by
    rw [← MonoidHom.ker_eq_bot_iff, ← Subgroup.card_eq_one, ha, ha0, pow_zero]
  exact ⟨(MulEquiv.ofBijective g ⟨hinj, hg⟩).trans eX⟩

