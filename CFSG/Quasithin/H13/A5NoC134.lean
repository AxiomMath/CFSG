    (hres : Lem13622Case4Z0) (h124 : C124StatementSQTK (G := G)) (hA7 : Lem13622A7Block)
    (hH : S.Hyp1367) {K : Subgroup G}
    (hK : K ∈ cComp (Subgroup.centralizer ({S.v12} : Set G))) (hYz : S.InYz K)
