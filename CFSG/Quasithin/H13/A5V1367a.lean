variable {K : Type} [Field K] [CharP K 2]

theorem sl2_mul_self_of_fix {M : Matrix (Fin 2) (Fin 2) K} (hdet : M.det = 1) {v : Fin 2 → K}
    (hv : v ≠ 0) (hMv : M *ᵥ v = v) : M * M = 1 := by
  have h0 : (M - 1) *ᵥ v = 0 := by
    rw [Matrix.sub_mulVec, hMv, Matrix.one_mulVec, sub_self]
  have hd : (M - 1).det = 0 := Matrix.exists_mulVec_eq_zero_iff.mp ⟨v, hv, h0⟩
  have h2 : (2 : K) = 0 := CharTwo.two_eq_zero
  rw [Matrix.det_fin_two] at hdet hd
  simp only [Matrix.sub_apply, Matrix.one_apply_eq] at hd
  have h01 : (1 : Matrix (Fin 2) (Fin 2) K) 0 1 = 0 := Matrix.one_apply_ne (by decide)
  have h10 : (1 : Matrix (Fin 2) (Fin 2) K) 1 0 = 0 := Matrix.one_apply_ne (by decide)
  rw [h01, h10, sub_zero, sub_zero] at hd
  have htr : M 0 0 + M 1 1 = 0 := by linear_combination hdet - hd + h2
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two]
  · linear_combination M 0 0 * htr - hdet - h2
  · linear_combination M 0 1 * htr
  · linear_combination M 1 0 * htr
  · linear_combination M 1 1 * htr - hdet - h2

omit [CharP K 2] in
theorem det_of_mem_statedSL {n : ℕ} (γ : ↥(StSL n K)) :
    ((γ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K).det = 1 :=
  CFSG.Open.StatedAPI.det_of_mem_statedSL γ.2

theorem statedSL2_mul_self_of_fix (γ : ↥(StSL 2 K)) {v : Fin 2 → K} (hv : v ≠ 0)
    (hγv : ((γ : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) *ᵥ v = v) : γ * γ = 1 := by
  have h := sl2_mul_self_of_fix (det_of_mem_statedSL γ) hv hγv
  apply Subtype.ext
  apply Units.ext
  rw [Subgroup.coe_mul, Units.val_mul, h, Subgroup.coe_one, Units.val_one]

theorem statedSL2_orderOf_ne_four (γ : ↥(StSL 2 K)) : orderOf γ ≠ 4 := by
  intro h4
  have hpow : γ ^ 2 ^ 2 = 1 := by rw [show 2 ^ 2 = 4 from rfl, ← h4]; exact pow_orderOf_eq_one γ
  have hM : ((γ : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) ^ 2 ^ 2 = 1 := by
    have := congrArg (fun x : ↥(StSL 2 K) => ((x : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K))
      hpow
    simpa using this
  have h2 := NQCat.SL3Sect.sq_eq_one_of_pow_two_pow hM
  have hγ2 : γ ^ 2 = 1 := by
    apply Subtype.ext
    apply Units.ext
    simpa using h2
  have := orderOf_dvd_of_pow_eq_one hγ2
  rw [h4] at this
  exact absurd this (by norm_num)

theorem orderOf_ne_four_of_equiv {X : Type} [Group X] (e : X ≃* ↥(StSL 2 K)) (x : X) :
    orderOf x ≠ 4 := by
  rw [← MulEquiv.orderOf_eq e]
  exact statedSL2_orderOf_ne_four _

@[expose] def u3 : Matrix.SpecialLinearGroup (Fin 3) K :=
  ⟨!![1, 1, 0; 0, 1, 1; 0, 0, 1], by simp [Matrix.det_fin_three]⟩

omit [CharP K 2] in
theorem u3_sq_ne_one : (u3 (K := K)) ^ 2 ≠ 1 := by
  intro h
  have h' := congrArg (fun x : Matrix.SpecialLinearGroup (Fin 3) K =>
    (x : Matrix (Fin 3) (Fin 3) K) 0 2) h
  simp only [Matrix.SpecialLinearGroup.coe_pow, Matrix.SpecialLinearGroup.coe_one] at h'
  simp [u3, pow_two, Matrix.mul_apply, Fin.sum_univ_three] at h'

theorem u3_pow_four : (u3 (K := K)) ^ 4 = 1 := by
  have h2 : (2 : K) = 0 := CharTwo.two_eq_zero
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_pow, Matrix.SpecialLinearGroup.coe_one]
  have e : (4 : ℕ) = 2 * 2 := rfl
  rw [e, pow_mul]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [u3, pow_two, Matrix.mul_apply, Fin.sum_univ_three] <;>
    first | linear_combination h2 | linear_combination 2 * h2 | linear_combination 3 * h2

theorem exists_orderOf_four_statedSL3 : ∃ γ : ↥(StSL 3 K), orderOf γ = 4 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hmem : Matrix.SpecialLinearGroup.toGL (u3 (K := K)) ∈ StSL 3 K :=
    Subgroup.subset_closure (by
      show (Matrix.SpecialLinearGroup.toGL (u3 (K := K)) : Matrix (Fin 3) (Fin 3) K).det = 1
      rw [Matrix.SpecialLinearGroup.coe_GL_coe_matrix]
      exact (u3 (K := K)).2)
  refine ⟨⟨_, hmem⟩, ?_⟩
  rw [Subgroup.orderOf_mk, orderOf_injective _ Matrix.SpecialLinearGroup.toGL_injective]
  exact orderOf_eq_prime_pow (n := 1) (by simpa using (u3_sq_ne_one (K := K)))
    (by simpa using (u3_pow_four (K := K)))

end Matrix

theorem orderOf_cycle4 :
    orderOf (Equiv.swap (0 : Fin 5) 1 * Equiv.swap 1 2 * Equiv.swap 2 3) = 4 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h1 : ¬ (Equiv.swap (0 : Fin 5) 1 * Equiv.swap 1 2 * Equiv.swap 2 3) ^ 2 ^ 1 = 1 := by
    decide
  have h2 : (Equiv.swap (0 : Fin 5) 1 * Equiv.swap 1 2 * Equiv.swap 2 3) ^ 2 ^ (1 + 1) = 1 := by
    decide
  exact orderOf_eq_prime_pow h1 h2

theorem mul_self_eq_one_of_fix_natural {V : Type*} [CommGroup V] {H : Subgroup (MulAut V)}
    {W C : Subgroup V} {K : Type} [Field K] [CharP K 2]
    {π : (FFModel.nat (StSL 2 K)).Gam →* ↥H}
    (hπ : (FFModel.nat (StSL 2 K)).RealizesVia H W C π) {g : MulAut V} (hg : g ∈ H) {w : V}
    (hw : w ∈ W) (hwC : w ∉ C) (hfix : g w * w⁻¹ ∈ C) : g * g = 1 := by
  obtain ⟨γ, hγ⟩ := G64.exists_preimage hπ hg
  obtain ⟨-, -, -, hHW, -, -, -, β, -, hβk, hβe⟩ := hπ
  obtain ⟨⟨m, hmsec⟩, hm⟩ := QuotientGroup.mk_surjective (β ⟨w, hw⟩)
  have hgw : ((π γ : ↥H) : MulAut V) w ∈ W := hHW (π γ) w hw
  have h1 : β ⟨((π γ : ↥H) : MulAut V) w, hgw⟩ = _ :=
    hβe γ ⟨w, hw⟩ ⟨m, hmsec⟩ hgw trivial hm.symm
  have h2 : β ⟨((π γ : ↥H) : MulAut V) w, hgw⟩ = β ⟨w, hw⟩ := by
    have hc : ((π γ : ↥H) : MulAut V) w * w⁻¹ ∈ C := by
      have := hfix
      rwa [← hγ] at this
    have hcW : ((π γ : ↥H) : MulAut V) w * w⁻¹ ∈ W := W.mul_mem hgw (W.inv_mem hw)
    have e : (⟨((π γ : ↥H) : MulAut V) w, hgw⟩ : ↥W) = ⟨_, hcW⟩ * ⟨w, hw⟩ :=
      Subtype.ext (by simp)
    rw [e, map_mul, (hβk _).2 hc, one_mul]
  rw [h2, ← hm] at h1
  have h3 := QuotientGroup.eq.mp h1
  have h4 := Subgroup.mem_bot.mp (Subgroup.mem_subgroupOf.mp h3)
  change Multiplicative (Fin 2 → K) at m
  set γ' : ↥(StSL 2 K) := γ with hγ'
  have hact : natAct (StSL 2 K) γ' m = m := by
    have h5 : m⁻¹ * natAct (StSL 2 K) γ' m = 1 := by
      have := h4
      simp only [Subgroup.coe_mul, Subgroup.coe_inv] at this
      exact this
    exact (inv_mul_eq_one.mp h5).symm
  have hv : Multiplicative.toAdd m ≠ 0 := by
    intro h0
    apply hwC
    have hm1' : m = 1 := Multiplicative.toAdd.injective (by rw [h0]; rfl)
    have hm1 : (⟨m, hmsec⟩ : ↥(FFModel.nat (StSL 2 K)).sec) = 1 := Subtype.ext hm1'
    rw [← hβk ⟨w, hw⟩, ← hm, hm1, QuotientGroup.mk_one]
  have hfixv : ((γ' : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) *ᵥ Multiplicative.toAdd m =
      Multiplicative.toAdd m :=
    congrArg Multiplicative.toAdd hact
  have hγ2 : γ' * γ' = 1 := statedSL2_mul_self_of_fix γ' hv hfixv
  have h6 : π γ * π γ = 1 := by rw [← map_mul, show γ * γ = 1 from hγ2, map_one]
  rw [← hγ, ← Subgroup.coe_mul, h6, Subgroup.coe_one]

theorem exists_torus_sl2 {F : Type} [Field F] [Finite F] {n : ℕ} (hn : 2 ≤ n)
    (hF : Nat.card F = 2 ^ n) :
    ∃ h : Matrix.SpecialLinearGroup (Fin 2) F, h ∈ upperTriangular 2 F ∧ Odd (orderOf h) ∧
      h ≠ 1 := by
  classical
  have : Fintype F := Fintype.ofFinite F
  have hcard : Fintype.card F = 2 ^ n := by rw [← Nat.card_eq_fintype_card, hF]
  have h4 : 4 ≤ 2 ^ n := by
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
  obtain ⟨a, -, ha⟩ := Finset.exists_mem_notMem_of_card_lt_card
    (s := ({0, 1} : Finset F)) (t := Finset.univ) (by
      rw [Finset.card_univ, hcard]
      exact (Finset.card_le_two).trans_lt (by omega))
  have ha0 : a ≠ 0 := fun h => ha (by simp [h])
  have ha1 : a ≠ 1 := fun h => ha (by simp [h])
  let h : Matrix.SpecialLinearGroup (Fin 2) F :=
    ⟨Matrix.diagonal ![a, a⁻¹], by simp [Matrix.det_diagonal, Fin.prod_univ_two, ha0]⟩
  have hpow : ∀ k : ℕ, ((h ^ k : Matrix.SpecialLinearGroup (Fin 2) F) :
      Matrix (Fin 2) (Fin 2) F) = Matrix.diagonal (![a, a⁻¹] ^ k) := by
    intro k
    rw [Matrix.SpecialLinearGroup.coe_pow, Matrix.diagonal_pow]
  have hq : h ^ (2 ^ n - 1) = 1 := by
    apply Subtype.ext
    rw [hpow, Matrix.SpecialLinearGroup.coe_one, ← Matrix.diagonal_one]
    congr 1
    funext i
    fin_cases i
    · simpa [hcard] using FiniteField.pow_card_sub_one_eq_one a ha0
    · simpa [hcard] using FiniteField.pow_card_sub_one_eq_one a⁻¹ (inv_ne_zero ha0)
  refine ⟨h, fun i j hij => ?_, ?_, fun h1 => ha1 ?_⟩
  · exact Matrix.diagonal_apply_ne _ (ne_of_gt hij)
  · have hdvd : orderOf h ∣ 2 ^ n - 1 := orderOf_dvd_of_pow_eq_one hq
    have h2 : 2 ∣ 2 ^ n := dvd_pow_self 2 (by omega)
    refine Nat.odd_iff.mpr ?_
    by_contra hne
    have h2o : 2 ∣ orderOf h := by omega
    have := h2o.trans hdvd
    omega
  · have := congrArg (fun x : Matrix.SpecialLinearGroup (Fin 2) F =>
      (x : Matrix (Fin 2) (Fin 2) F) 0 0) h1
    simpa [h] using this

theorem exists_odd_normalizer_sl2 {X : Type} [Group X] [Finite X] {F : Type} [Field F]
    [Finite F] {n : ℕ} (hn : 2 ≤ n) (hF : Nat.card F = 2 ^ n) (e : X ≃* ↥(StSL 2 F))
    {P : Subgroup X} (hP : IsSylowTwoOf P ⊤) :
    ∃ x ∈ Subgroup.normalizer (P : Set X), Odd (orderOf x) ∧ x ≠ 1 := by
  have hchar : CharP F 2 := R3c.charP_two_of_natCard_eq_two_pow hF
  set φ₀ : X ≃* Matrix.SpecialLinearGroup (Fin 2) F := e.trans (statedSLEquivSL 2 F) with hφ₀
  have hP' : IsSylowTwoOf (P.map φ₀.toMonoidHom) ⊤ := by
    refine ⟨le_top, hP.2.1.map _, ?_⟩
    show ¬ 2 ∣ (P.map φ₀.toMonoidHom).relIndex ⊤
    rw [Subgroup.relIndex_top_right,
      show P.map φ₀.toMonoidHom = P.map (φ₀ : X →* Matrix.SpecialLinearGroup (Fin 2) F) from rfl,
      Subgroup.index_map_equiv]
    have h := hP.2.2
    rwa [show (P.subgroupOf ⊤).index = P.relIndex ⊤ from rfl, Subgroup.relIndex_top_right] at h
  obtain ⟨φ, hφ⟩ := SzN2.exists_mulEquiv_map_eq
    (SzN2.isSylowTwoOf_unitriangular (K := F) (n := 2) (by norm_num)) hP'
  obtain ⟨h, hB, hodd, h1⟩ := exists_torus_sl2 hn hF
  have hN : h ∈ Subgroup.normalizer
      (((P.map φ₀.toMonoidHom).map φ.toMonoidHom : Subgroup _) : Set _) := by
    rw [hφ, normalizer_unitriangular]
    exact hB
  rw [← Subgroup.map_equiv_normalizer_eq, ← Subgroup.map_equiv_normalizer_eq] at hN
  obtain ⟨_, ⟨x, hx, rfl⟩, hxh⟩ := hN
  refine ⟨x, hx, ?_, ?_⟩
  · have e1 : orderOf x = orderOf h := by
      rw [← hxh]
      simp [MulEquiv.orderOf_eq]
    rw [e1]
    exact hodd
  · rintro rfl
    apply h1
    rw [← hxh]
    simp

end CFSG.Quasithin.H13.A5
