@[expose] def R2P : PP := ⟨33345, 33345⟩

@[expose] def M2P : PP := ⟨33377, 34369⟩

@[expose] def uOf (n : ℕ) : ℕ :=
  Nat.bit true <| Nat.bit (n.testBit 0) <| Nat.bit (n.testBit 1) <| Nat.bit (n.testBit 2) <|
  Nat.bit false <| Nat.bit true <| Nat.bit (n.testBit 3) <| Nat.bit (n.testBit 4) <|
  Nat.bit false <| Nat.bit false <| Nat.bit true <| Nat.bit (n.testBit 5) <|
  Nat.bit false <| Nat.bit false <| Nat.bit false <| Nat.bit true 0

@[expose] def uInv (a : ℕ) : ℕ :=
  let x := a ^^^ idN
  idN ^^^ x ^^^ bmul x x ^^^ bmul x (bmul x x)

@[expose] def uP (n : ℕ) : PP := ⟨uOf n, uInv (uOf n)⟩

@[expose] def eqB (x y : ℕ) : Bool := (List.range 16).all fun k => x.testBit k == y.testBit k

@[expose] def validB (p : PP) : Bool := eqB (bmul p.m p.m') idN

@[expose] def fixB (u : PP) (e : Bool) (g : PP) : Bool := sameB g (act u e g)

@[expose] def swapB (u : PP) (e : Bool) (g : PP) : Bool := sameB (mul g M2P) (act u e (mul g R2P))

@[expose] def R1B (u : PP) (e : Bool) : Bool := fixB u e R2P && fixB u e M2P

@[expose] def involB (u : PP) (e : Bool) : Bool := eqB (mul u (gamE e u)).m idN

@[expose] def mulU (u₁ : PP) (e₁ : Bool) (u₂ : PP) : PP := mul u₁ (gamE e₁ u₂)

@[expose] def commB (u₁ : PP) (e₁ : Bool) (u₂ : PP) (e₂ : Bool) : Bool :=
  eqB (mulU u₁ e₁ u₂).m (mulU u₂ e₂ u₁).m

