@[expose] def fsB (u : PP) (e : Bool) (g : PP) : Bool := validB g && fixB u e g && swapB u e g

@[expose] def w4 (u : PP) (e : Bool) (g₁ g₂ g₃ g₄ : PP) : Bool :=
  fsB u e g₁ && fsB u e g₂ && fsB u e g₃ && fsB u e g₄ && !sameB g₁ g₂ && !sameB g₁ g₃ &&
    !sameB g₁ g₄ && !sameB g₂ g₃ && !sameB g₂ g₄ && !sameB g₃ g₄

@[expose] def wTr (u : PP) (e : Bool) (g y : PP) : Bool :=
  validB g && validB y && !fixB u e g && !fixB u e (mul g R2P) && !fixB u e (mul g M2P) &&
    eqB (act u e y).m (mul y u).m && sameB g (mul (mul y y) g) &&
    sameB (mul g M2P) (mul (mul y y) (mul g R2P)) && sameB (mul g R2P) (mul (mul y y) (mul g M2P))

@[expose] def chkA : Bool :=
  (List.range 64).all fun n => validB (uP n) && [false, true].all fun e =>
    !(R1B (uP n) e && involB (uP n) e) || (n == 0 && !e) || invList.contains (n, e)

@[expose] def oneB (b : ℕ × Bool) : Bool :=
  match oneWit.lookup b with
  | some w => if w.1 then
      w4 (uP b.1) b.2 ⟨w.2.1.1, w.2.1.2⟩ ⟨w.2.2.1.1, w.2.2.1.2⟩ ⟨w.2.2.2.1.1, w.2.2.2.1.2⟩
        ⟨w.2.2.2.2.1, w.2.2.2.2.2⟩
    else wTr (uP b.1) b.2 ⟨w.2.1.1, w.2.1.2⟩ ⟨w.2.2.1.1, w.2.2.1.2⟩
  | none => false

@[expose] def chkB : Bool := invList.all oneB

@[expose] def pairs : List ((ℕ × Bool) × (ℕ × Bool)) :=
  invList.flatMap fun b₁ => invList.filterMap fun b₂ =>
    if b₁ != b₂ && commB (uP b₁.1) b₁.2 (uP b₂.1) b₂.2 then some (b₁, b₂) else none

@[expose] def sel (b₁ b₂ : ℕ × Bool) : ℕ → PP × Bool
  | 0 => (uP b₁.1, b₁.2)
  | 1 => (uP b₂.1, b₂.2)
  | _ => (mulU (uP b₁.1) b₁.2 (uP b₂.1), b₁.2 ^^ b₂.2)

@[expose] def wPair (b₁ b₂ : ℕ × Bool) (w : ℕ × ℕ × ℕ × ℕ) : Bool :=
  let c := sel b₁ b₂ w.1
  let c' := sel b₁ b₂ w.2.1
  let g : PP := ⟨w.2.2.1, w.2.2.2⟩
  w.1 < 3 && w.2.1 < 3 && validB g && fixB c.1 c.2 g && swapB c.1 c.2 g && !fixB c'.1 c'.2 g

@[expose] def twoB (x : (ℕ × Bool) × (ℕ × Bool)) : Bool :=
  match twoWit.lookup x with
  | some w => wPair x.1 x.2 w
  | none => false

@[expose] def chkC : Bool := pairs.all twoB

theorem chkA_eq : chkA = true := by decide +kernel

theorem chkB_eq : chkB = true := by decide +kernel

theorem chkC_eq : chkC = true := by decide +kernel

