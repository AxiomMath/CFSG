@[expose] def g2a : Perm (Fin 6) := swap 0 1 * swap 2 3

@[expose] def g2b : Perm (Fin 6) := (swap 0 2 * swap 2 5) * (swap 1 3 * swap 3 4)

theorem noLine_heart : NoLine (heartHom g1a) (heartHom g1b) := by decide +kernel

theorem noLine_heartTotal :
    NoLine (heartHom (totalPermHom g2a)) (heartHom (totalPermHom g2b)) := by decide +kernel

