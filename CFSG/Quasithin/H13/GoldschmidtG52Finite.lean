theorem rank_eq_of_cert {m n : ℕ} {r : ℕ} (A : Matrix (Fin m) (Fin n) (ZMod 2))
    (Ap : Matrix (Fin r) (Fin m) (ZMod 2)) (Bp : Matrix (Fin n) (Fin r) (ZMod 2))
    (C : Matrix (Fin m) (Fin r) (ZMod 2)) (R : Matrix (Fin r) (Fin n) (ZMod 2))
    (h1 : Ap * A * Bp = 1) (h2 : A = C * R) : A.rank = r := by
  apply le_antisymm
  · rw [h2]
    exact (Matrix.rank_mul_le_left C R).trans (Matrix.rank_le_width C)
  · have h3 : (Ap * A * Bp).rank ≤ A.rank :=
      (Matrix.rank_mul_le_left _ Bp).trans (Matrix.rank_mul_le_right Ap A)
    rw [h1, Matrix.rank_one, Fintype.card_fin] at h3
    exact h3

@[expose] def cyc3 : Perm (Fin 6) := swap 0 1 * swap 1 2

@[expose] def cyc33 : Perm (Fin 6) := cyc3 * (swap 3 4 * swap 4 5)

theorem exists_two_of_card_four {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    (L : Submodule (ZMod 2) W) (hL : Nat.card L = 4) :
    ∃ u v : W, u ∈ L ∧ v ∈ L ∧ u ≠ 0 ∧ v ≠ 0 ∧ u ≠ v ∧
      ∀ x ∈ L, x = 0 ∨ x = u ∨ x = v ∨ x = u + v := by
  have hfin : Finite L := Nat.finite_of_card_ne_zero (by omega)
  have : Module.Finite (ZMod 2) L := Module.Finite.of_finite
  have hrank : Module.finrank (ZMod 2) L = 2 := by
    have h := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := L)
    rw [hL, Nat.card_zmod] at h
    have h4 : (2 : ℕ) ^ 2 = 2 ^ Module.finrank (ZMod 2) L := by simpa using h
    exact (Nat.pow_right_injective le_rfl h4).symm
  let b := Module.finBasisOfFinrankEq (ZMod 2) L hrank
  refine ⟨b 0, b 1, (b 0).2, (b 1).2, ?_, ?_, ?_, ?_⟩
  · exact fun h => b.ne_zero 0 (Subtype.ext h)
  · exact fun h => b.ne_zero 1 (Subtype.ext h)
  · exact fun h => by have := b.injective (Subtype.ext h); exact absurd this (by decide)
  · intro x hx
    have h := b.sum_repr ⟨x, hx⟩
    rw [Fin.sum_univ_two] at h
    have h' : x = (b.repr ⟨x, hx⟩ 0) • (b 0 : W) + (b.repr ⟨x, hx⟩ 1) • (b 1 : W) := by
      have := congrArg Subtype.val h
      simpa using this.symm
    clear h
    have hc : ∀ c : ZMod 2, c = 0 ∨ c = 1 := by decide
    generalize b.repr ⟨x, hx⟩ 0 = c0 at h'
    generalize b.repr ⟨x, hx⟩ 1 = c1 at h'
    rcases hc c0 with rfl | rfl <;> rcases hc c1 with rfl | rfl <;> simp [h']

abbrev InLine (u v x : Fin 4 → ZMod 2) : Prop := x = 0 ∨ x = u ∨ x = v ∨ x = u + v

@[expose] def NoLine (M N : Matrix (Fin 4) (Fin 4) (ZMod 2)) : Prop :=
  ∀ u v : Fin 4 → ZMod 2, u ≠ 0 → v ≠ 0 → u ≠ v →
    ¬ (InLine u v (M *ᵥ u) ∧ InLine u v (M *ᵥ v) ∧ InLine u v (N *ᵥ u) ∧ InLine u v (N *ᵥ v))

instance (M N : Matrix (Fin 4) (Fin 4) (ZMod 2)) : Decidable (NoLine M N) := by
  unfold NoLine; infer_instance

theorem no_stable_line {M N : Matrix (Fin 4) (Fin 4) (ZMod 2)} (h : NoLine M N)
    (L : Submodule (ZMod 2) (Fin 4 → ZMod 2)) (hL : Nat.card L = 4)
    (hM : ∀ x ∈ L, M *ᵥ x ∈ L) (hN : ∀ x ∈ L, N *ᵥ x ∈ L) : False := by
  obtain ⟨u, v, hu, hv, hu0, hv0, huv, hLeq⟩ := exists_two_of_card_four L hL
  exact h u v hu0 hv0 huv ⟨hLeq _ (hM u hu), hLeq _ (hM v hv), hLeq _ (hN u hu), hLeq _ (hN v hv)⟩

@[expose] def g1a : Perm (Fin 6) := swap 0 1 * swap 1 2

