theorem card_sup_dvd_of_le_normalizer {G : Type*} [Group G] {A B : Subgroup G}
    (hB : B ≤ Subgroup.normalizer (A : Set G)) :
    Nat.card ↥(A ⊔ B) ∣ Nat.card A * Nat.card B := by
  have hA : A ≤ A ⊔ B := le_sup_left
  have hn : (A.subgroupOf (A ⊔ B)).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hA).mpr (sup_le Subgroup.le_normalizer hB)
  let ψ : ↥B →* ↥(A ⊔ B) ⧸ A.subgroupOf (A ⊔ B) :=
    (QuotientGroup.mk' _).comp (Subgroup.inclusion le_sup_right)
  have hψ : Function.Surjective ψ := by
    intro z
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective z
    have hx : (x : G) ∈ ((B ⊔ A : Subgroup G) : Set G) := by
      rw [sup_comm]
      exact x.2
    rw [Subgroup.coe_mul_of_left_le_normalizer_right B A hB] at hx
    obtain ⟨b, hb, a, ha, hba⟩ := hx
    refine ⟨⟨b, hb⟩, ?_⟩
    rw [MonoidHom.comp_apply, QuotientGroup.mk'_apply, QuotientGroup.eq, Subgroup.mem_subgroupOf]
    have h : (((Subgroup.inclusion le_sup_right ⟨b, hb⟩)⁻¹ * x : ↥(A ⊔ B)) : G) = a := by
      rw [Subgroup.coe_mul, Subgroup.coe_inv, ← hba]
      simp
    rw [h]
    exact ha
  have h1 : Nat.card ↥(A.subgroupOf (A ⊔ B)) = Nat.card A :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hA).toEquiv
  rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (A.subgroupOf (A ⊔ B)), h1,
    mul_comm (Nat.card A)]
  exact mul_dvd_mul_right (Subgroup.card_dvd_of_surjective hψ) _

theorem dvd_of_dvd_card_parabolic
    {K : Type} [Field K] [Finite K] [CharP K 2] {m p : ℕ} (hK : Nat.card K = 2 ^ m)
    (hp : p.Prime) (hp2 : p ≠ 2) (i : Fin Tag.G2.rank)
    (h : p ∣ Nat.card ↥(parabolicSubgroup Tag.G2 K {i})) : p ∣ 2 ^ (2 * m) - 1 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨-, -, -, hMP, -, hsup, -, -, -, -, -, -, hfin⟩ :=
    parabolic_root_radical_Levi_factors Tag.G2 K {i}
  obtain ⟨hQcard, -, -⟩ := hfin 2
  have hMN : parabolicLevi Tag.G2 K {i} ≤
      Subgroup.normalizer (parabolicRadical Tag.G2 K {i} : Set (ModGL Tag.G2 K)) :=
    hMP.trans (parabolicSubgroup_le_normalizer_parabolicRadical {i})
  have hPdvd := card_sup_dvd_of_le_normalizer hMN
  rw [hsup] at hPdvd
  obtain ⟨ρ, hρ, hrange⟩ :=
    CFSG.QuasithinUnique.Vol2Native.A312L.exists_rankOne_injective (K := K) (τ := Tag.G2) i
  have hcl : Subgroup.closure {g | ∃ j ∈ ({i} : Set (Fin Tag.G2.rank)), ∃ c : K,
      g = xUnit Tag.G2 K j c ∨ g = yUnit Tag.G2 K j c} = ρ.range := by
    rw [hrange]
    congr 1
    ext g
    constructor
    · rintro ⟨j, hj, c, rfl | rfl⟩
      · rw [Set.mem_singleton_iff] at hj
        subst hj
        exact Or.inl ⟨c, rfl⟩
      · rw [Set.mem_singleton_iff] at hj
        subst hj
        exact Or.inr ⟨c, rfl⟩
    · rintro (⟨c, rfl⟩ | ⟨c, rfl⟩)
      · exact ⟨i, rfl, c, Or.inl rfl⟩
      · exact ⟨i, rfl, c, Or.inr rfl⟩
  have hMeq : parabolicLevi Tag.G2 K {i} = ρ.range ⊔ torusGroup Tag.G2 K := by
    rw [parabolicLevi, hcl, sup_comm]
  have hLspan : ρ.range = rootSpan Tag.G2 K {Pi.single i 1, -Pi.single i 1} := by
    rw [hrange]
    apply le_antisymm
    · refine (Subgroup.closure_le _).2 ?_
      rintro _ (⟨c, rfl⟩ | ⟨c, rfl⟩)
      · rw [← pinnedX_single]
        exact pinnedX_mem_rootSpan (Set.mem_insert _ _) c
      · rw [← pinnedX_neg_single]
        exact pinnedX_mem_rootSpan (Set.mem_insert_of_mem _ (Set.mem_singleton _)) c
    · refine iSup₂_le fun α hα => ?_
      refine (Subgroup.closure_le _).2 ?_
      rintro _ ⟨c, rfl⟩
      rcases hα with rfl | hα
      · rw [pinnedX_single]
        exact Subgroup.subset_closure (Or.inl ⟨c, rfl⟩)
      · rw [Set.mem_singleton_iff] at hα
        subst hα
        rw [pinnedX_neg_single]
        exact Subgroup.subset_closure (Or.inr ⟨c, rfl⟩)
  have hHnorm : torusGroup Tag.G2 K ≤ Subgroup.normalizer (ρ.range : Set (ModGL Tag.G2 K)) := by
    rw [hLspan]
    refine torusGroup_le_normalizer_rootSpan ?_
    intro α hα
    rcases hα with rfl | hα
    · exact isRoot_single Tag.G2 i
    · rw [Set.mem_singleton_iff] at hα
      subst hα
      exact isRoot_neg_single Tag.G2 i
  have hMdvd := card_sup_dvd_of_le_normalizer hHnorm
  rw [← hMeq] at hMdvd
  have hL : Nat.card ρ.range = 2 ^ m * ((2 ^ m) ^ 2 - 1) := by
    rw [← Nat.card_congr (MonoidHom.ofInjective hρ).toEquiv,
      CFSG.SL2MinimalFaithful.card_specialLinearGroup_fin_two, hK]
  have hT : Nat.card (torusGroup Tag.G2 K) = (2 ^ m - 1) ^ 2 := by
    rw [CFSG.Timmesfeld.ExceptionalOrders.card_torusGroup_G2, hK]
  have hp2m : ∀ k, ¬ p ∣ (2 ^ m) ^ k := fun k hd =>
    hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp
      (hp.dvd_of_dvd_pow (hp.dvd_of_dvd_pow hd)))
  have hsq : (2 ^ m) ^ 2 - 1 = 2 ^ (2 * m) - 1 := by rw [← pow_mul, mul_comm]
  have h1 : p ∣ Nat.card (parabolicLevi Tag.G2 K {i}) := by
    rcases (Nat.Prime.dvd_mul hp).mp (h.trans hPdvd) with h' | h'
    · rw [hQcard, hK] at h'
      exact absurd h' (hp2m _)
    · exact h'
  rcases (Nat.Prime.dvd_mul hp).mp (h1.trans hMdvd) with h' | h'
  · rw [hL] at h'
    rcases (Nat.Prime.dvd_mul hp).mp h' with h'' | h''
    · exact absurd (by rwa [pow_one] : p ∣ (2 ^ m) ^ 1) (hp2m 1)
    · rwa [hsq] at h''
  · rw [hT] at h'
    rw [← hsq, show (2 ^ m) ^ 2 - 1 = (2 ^ m + 1) * (2 ^ m - 1) by
      rw [← Nat.sq_sub_sq, one_pow]]
    exact (hp.dvd_of_dvd_pow h').mul_left _

theorem inspFFG2_holds :
    InspFFG2 := by
  intro F _ _ m n p hm hn hF K hK hp hp2 hpn
  have : Fact p.Prime := ⟨hp⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hZ := center_quasithinG2_eq_bot hm hF
  let eq : ↥(CFSG.Open.quasithinG2 F) ⧸ Subgroup.center ↥(CFSG.Open.quasithinG2 F) ≃*
      ↥(CFSG.Open.quasithinG2 F) :=
    (QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot
  have hCE : ChevalleyExceptionalModel ↥(CFSG.Open.quasithinG2 F) .G2 2 m :=
    CFSG.SectionRank.chevalleyExceptionalModel_of_mulEquiv eq.symm
      (CFSG.Quasithin.factG2Cayley_holds F m hm hF)
  have hLM : LieModel ↥(CFSG.Open.quasithinG2 F) .G2 0 2 m :=
    Or.inr (Or.inl ⟨rfl, by simp [chevalleyExceptionalTags], hCE⟩)
  have hKcard := CFSG.Quasithin.F420.card_of_statedPSL_two_two hK
  obtain ⟨S₀⟩ : Nonempty (Sylow 2 ↥K) := inferInstance
  obtain ⟨Y, -, -, hYN, -, -, -, -, hYcard, -⟩ :=
    CFSG.Quasithin.H13.KG22.torusOut_of_isPSL2 (by omega) hK
      (CFSG.QuasithinUnique.isSylowTwoOf_top_of_sylow S₀)
  obtain ⟨y, hy⟩ := exists_prime_orderOf_dvd_card' (G := ↥Y) p (hYcard ▸ hpn)
  let R : Subgroup ↥(CFSG.Open.quasithinG2 F) := (S₀ : Subgroup ↥K).map K.subtype
  have hR2 : IsPGroup 2 ↥R := S₀.isPGroup'.map K.subtype
  have hR1 : R ≠ ⊥ := by
    rw [Ne, Subgroup.map_eq_bot_iff_of_injective _ K.subtype_injective]
    refine S₀.ne_bot_of_dvd_card ?_
    rw [hKcard]
    exact Dvd.dvd.mul_right (dvd_pow_self 2 (by omega)) _
  have hyN : ((y : ↥K) : ↥(CFSG.Open.quasithinG2 F)) ∈
      Subgroup.normalizer (R : Set ↥(CFSG.Open.quasithinG2 F)) :=
    Subgroup.le_normalizer_map K.subtype ⟨(y : ↥K), hYN y.2, rfl⟩
  obtain ⟨S, P, hPtop, hNP, -, -, hSP⟩ :=
    CFSG.LieType.BorelTits.holds_of_lieModel hLM (by decide) R hR1 hR2
  obtain ⟨M, hMc, hPM⟩ := (eq_top_or_exists_le_coatom P).resolve_left hPtop
  obtain ⟨K', _, _, _, φ, hK'card, -, hres, -⟩ :=
    CFSG.QuasithinUnique.Setup.X6.even_rank_two_residual_G2 hCE
      (CFSG.QuasithinUnique.isSylowTwoOf_top_of_sylow S)
  obtain ⟨-, -, hmax, -⟩ := hres
  have hSM : (S : Subgroup ↥(CFSG.Open.quasithinG2 F)) ≤ M :=
    Subgroup.le_normalizer.trans (hSP.trans hPM)
  obtain ⟨j, hj⟩ := (hmax M hSM).1 (covBy_top_iff.mpr hMc)
  have hpM : p ∣ Nat.card ↥M := by
    have := Subgroup.orderOf_dvd_natCard M (hPM (hNP hyN))
    rwa [Subgroup.orderOf_coe, Subgroup.orderOf_coe, hy] at this
  rw [hj] at hpM
  refine dvd_of_dvd_card_parabolic hK'card hp hp2 (CFSG.QuasithinUnique.Setup.X6.g2Index j) ?_
  refine hpM.trans ((Subgroup.card_map_dvd _ _).trans ?_)
  exact (Nat.card_congr (Subgroup.subgroupOfEquivOfLe
    (parabolicSubgroup_le_adjointGroup Tag.G2 K' _)).toEquiv).dvd

end FFG2

theorem inspFF436_holds :
