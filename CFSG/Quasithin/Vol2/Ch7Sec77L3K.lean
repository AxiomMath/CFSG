theorem conj_pow_mul_inv_mem' {K : Subgroup G} {z : G}
    (hzN : z ∈ Subgroup.normalizer (pCoreOf 2 K : Set G))
    (hz : ∀ k ∈ K, k * z * k⁻¹ * z⁻¹ ∈ pCoreOf 2 K) {k : G} (hk : k ∈ K) (n : ℕ) :
    k * z ^ n * k⁻¹ * (z ^ n)⁻¹ ∈ pCoreOf 2 K := by
  induction n with
  | zero => simp
  | succ n ih =>
    have hN : z ^ n ∈ Subgroup.normalizer (pCoreOf 2 K : Set G) := Subgroup.pow_mem _ hzN n
    have e : k * z ^ (n + 1) * k⁻¹ * (z ^ (n + 1))⁻¹ =
        (k * z ^ n * k⁻¹ * (z ^ n)⁻¹) * (z ^ n * (k * z * k⁻¹ * z⁻¹) * (z ^ n)⁻¹) := by
      rw [pow_succ]
      group
    rw [e]
    exact (pCoreOf 2 K).mul_mem ih ((Subgroup.mem_normalizer_iff.mp hN _).mp (hz k hk))

theorem exists_mem_normalizer_zpowers' {K : Subgroup G} {z : G}
    (hzN : z ∈ Subgroup.normalizer (pCoreOf 2 K : Set G)) (hzo : Odd (orderOf z))
    (hz : ∀ k ∈ K, k * z * k⁻¹ * z⁻¹ ∈ pCoreOf 2 K) {k : G} (hk : k ∈ K) :
    ∃ o ∈ pCoreOf 2 K, o * k ∈ Subgroup.normalizer (Subgroup.zpowers z : Set G) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine exists_mem_normalizer_of_conj_le (by rw [Nat.card_zpowers]; exact hzo)
    (pCoreOf_isPGroup 2 K) ((Subgroup.zpowers_le).mpr hzN) (le_normalizer_pCoreOf 2 K hk) ?_
  intro a ha
  obtain ⟨n, rfl⟩ : ∃ n : ℕ, z ^ n = a := (mem_powers_iff_mem_zpowers).mpr ha
  have h1 := conj_pow_mul_inv_mem' hzN hz hk n
  have e : k * z ^ n * k⁻¹ = (k * z ^ n * k⁻¹ * (z ^ n)⁻¹) * z ^ n := by group
  rw [e]
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_left h1)
    (Subgroup.mem_sup_right (Subgroup.pow_mem _ (Subgroup.mem_zpowers z) n))

theorem inf_normalizer_eq_of_isMaxParabolic2 {X : Type} [Group X] {Y P : Subgroup X}
    [IsSimpleGroup ↥Y] (hP : IsMaxParabolic2 Y P) (hP1 : P ≠ ⊥) :
    Y ⊓ Subgroup.normalizer (P : Set X) = P := by
  obtain ⟨⟨hPY, S, hS, hSP⟩, hPne, hmax⟩ := hP
  have hPN : P ≤ Y ⊓ Subgroup.normalizer (P : Set X) := le_inf hPY Subgroup.le_normalizer
  refine hmax _ ⟨inf_le_left, S, hS, hSP.trans hPN⟩ (fun hY => ?_) hPN
  have hn : (P.subgroupOf Y).Normal := (Subgroup.normal_subgroupOf_iff_le_normalizer hPY).2
    (by rw [← hY]; exact inf_le_right)
  rcases hn.eq_bot_or_eq_top with h | h
  · rw [Subgroup.subgroupOf_eq_bot] at h
    exact hP1 (h.eq_bot_of_le hPY)
  · rw [Subgroup.subgroupOf_eq_top] at h
    exact hPne (le_antisymm hPY h)

theorem exists_mem_comm_centralizer_of_odd {K W P : Subgroup G}
    (eK : ↥(autOn K W) ≃* Matrix.SpecialLinearGroup (Fin 3) (ZMod 2))
    (hKW : K ≤ Subgroup.normalizer (W : Set G)) (hPK : P ≤ K)
    (hP : IsMaxParabolic2 (autOn K W) (autOn P W)) (hP1 : autOn P W ≠ ⊥) {x : G}
    (hxo : Odd (orderOf x)) (hxK : x ∈ Subgroup.normalizer (K : Set G))
    (hxW : x ∈ Subgroup.normalizer (W : Set G)) (hxP : x ∈ Subgroup.normalizer (P : Set G)) :
    ∃ k ∈ P, ∀ k' ∈ K,
      k' * (k⁻¹ * x) * k'⁻¹ * (k⁻¹ * x)⁻¹ ∈ Subgroup.centralizer (W : Set G) := by
  classical
  have : Finite (MulAut ↥W) := Finite.of_injective (fun f : MulAut ↥W => (f : ↥W ≃ ↥W))
    fun f g h => MulEquiv.toEquiv_injective h
  have hsl := CFSG.Quasithin.H13.NQCat.SLk.isSimpleGroup_sl (n := 3) (by norm_num)
  have hsK : IsSimpleGroup ↥(autOn K W) := eK.isSimpleGroup
  set xh := conjAct W ⟨x, hxW⟩ with hxh
  have hxinv : (conjAct W ⟨x, hxW⟩)⁻¹ = conjAct W ⟨x⁻¹, Subgroup.inv_mem _ hxW⟩ := by
    rw [← map_inv]
    rfl
  have hxN : xh ∈ Subgroup.normalizer ((autOn K W : Subgroup (MulAut ↥W)) : Set (MulAut ↥W)) :=
    Subgroup.mem_normalizer_fintype fun a ha => conj_mem_autOn hxW hxK ha
  set α := (autOn K W).normalizerMonoidHom ⟨xh, hxN⟩ with hα
  have hαo : Odd (orderOf α) := by
    have h1 : orderOf α ∣ orderOf (⟨xh, hxN⟩ : ↥(Subgroup.normalizer
        ((autOn K W : Subgroup (MulAut ↥W)) : Set (MulAut ↥W)))) := orderOf_map_dvd _ _
    rw [Subgroup.orderOf_mk] at h1
    have h2 : orderOf xh ∣ orderOf (⟨x, hxW⟩ : ↥(Subgroup.normalizer (W : Set G))) :=
      orderOf_map_dvd _ _
    rw [Subgroup.orderOf_mk] at h2
    exact Odd.of_dvd_nat (Odd.of_dvd_nat hxo h2) h1
  obtain ⟨kh, hkh⟩ := (CFSG.Quasithin.oddInner_sl32.of_mulEquiv eK.symm) α hαo
  have hconj : ∀ a ∈ autOn K W, xh * a * xh⁻¹ = (kh : MulAut ↥W) * a * (kh : MulAut ↥W)⁻¹ :=
    fun a ha => by
      have h1 := congrArg (fun β : MulAut ↥(autOn K W) =>
        ((β ⟨a, ha⟩ : ↥(autOn K W)) : MulAut ↥W)) hkh
      simpa [hα, Subgroup.normalizerMonoidHom_apply_apply_coe, MulAut.conj_apply] using h1
  have hkhP : (kh : MulAut ↥W) ∈ autOn P W := by
    rw [← inf_normalizer_eq_of_isMaxParabolic2 hP hP1]
    refine ⟨kh.2, Subgroup.mem_normalizer_fintype fun p hp => ?_⟩
    rw [← hconj p (CFSG.Quasithin.InternalSec.autOn_le_autOn_of_le hPK hp)]
    exact conj_mem_autOn hxW hxP hp
  obtain ⟨g, hgP, hgk⟩ := CFSG.QuasithinUnique.Setup.mem_autOn_iff.1 hkhP
  refine ⟨g, hgP, fun k' hk' => ?_⟩
  have hk'N : k' ∈ Subgroup.normalizer (W : Set G) := hKW hk'
  set y : G := k' * ((g : G)⁻¹ * x) * k'⁻¹ * ((g : G)⁻¹ * x)⁻¹ with hy
  have hyN : y ∈ Subgroup.normalizer (W : Set G) := by
    rw [hy]
    refine Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hk'N
      (Subgroup.mul_mem _ (Subgroup.inv_mem _ g.2) hxW)) (Subgroup.inv_mem _ hk'N))
      (Subgroup.inv_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ g.2) hxW))
  have e : (⟨y, hyN⟩ : ↥(Subgroup.normalizer (W : Set G))) =
      ⟨k', hk'N⟩ * g⁻¹ * ⟨x, hxW⟩ * ⟨k', hk'N⟩⁻¹ * ⟨x, hxW⟩⁻¹ * g := Subtype.ext (by
    simp only [hy, Subgroup.coe_mul, Subgroup.coe_inv]
    group)
  have hk'K : conjAct W ⟨k'⁻¹, Subgroup.inv_mem _ hk'N⟩ ∈ autOn K W :=
    CFSG.QuasithinUnique.Setup.mem_autOn_iff.2 ⟨_, K.inv_mem hk', rfl⟩
  have h1 := hconj _ hk'K
  have h2 : conjAct W ⟨y, hyN⟩ = 1 := by
    rw [e, map_mul, map_mul, map_mul, map_mul, map_mul, map_inv, map_inv, map_inv, hgk]
    have e2 : (conjAct W ⟨k', hk'N⟩)⁻¹ = conjAct W ⟨k'⁻¹, Subgroup.inv_mem _ hk'N⟩ := by
      rw [← map_inv]
      rfl
    rw [e2]
    calc conjAct W ⟨k', hk'N⟩ * (kh : MulAut ↥W)⁻¹ * xh *
          conjAct W ⟨k'⁻¹, Subgroup.inv_mem _ hk'N⟩ * xh⁻¹ * (kh : MulAut ↥W)
        = conjAct W ⟨k', hk'N⟩ * (kh : MulAut ↥W)⁻¹ *
          (xh * conjAct W ⟨k'⁻¹, Subgroup.inv_mem _ hk'N⟩ * xh⁻¹) * (kh : MulAut ↥W) := by
          group
      _ = conjAct W ⟨k', hk'N⟩ * (kh : MulAut ↥W)⁻¹ * ((kh : MulAut ↥W) *
          conjAct W ⟨k'⁻¹, Subgroup.inv_mem _ hk'N⟩ * (kh : MulAut ↥W)⁻¹) *
          (kh : MulAut ↥W) := by rw [h1]
      _ = conjAct W ⟨k', hk'N⟩ * conjAct W ⟨k'⁻¹, Subgroup.inv_mem _ hk'N⟩ := by group
      _ = 1 := by
          rw [← map_mul]
          have : (⟨k', hk'N⟩ * ⟨k'⁻¹, Subgroup.inv_mem _ hk'N⟩ :
            ↥(Subgroup.normalizer (W : Set G))) = 1 := Subtype.ext (mul_inv_cancel k')
          rw [this, map_one]
  exact (CFSG.QuasithinUnique.Setup.rho_eq_one_iff (P := Subgroup.normalizer (W : Set G))
    le_rfl ⟨y, hyN⟩).1 h2

omit [Finite G] in
theorem exists_mul_pow_eq {K : Subgroup G} {k q : G} (hk : k ∈ K)
    (hq : q ∈ Subgroup.normalizer (K : Set G)) (n : ℕ) : ∃ k' ∈ K, (k * q) ^ n = k' * q ^ n := by
  induction n with
  | zero => exact ⟨1, K.one_mem, by simp⟩
  | succ n ih =>
    obtain ⟨k', hk', e1⟩ := ih
    have hqn : q ^ n ∈ Subgroup.normalizer (K : Set G) := Subgroup.pow_mem _ hq n
    have hc : q ^ n * k * (q ^ n)⁻¹ ∈ K := (Subgroup.mem_normalizer_iff.1 hqn k).1 hk
    refine ⟨k' * (q ^ n * k * (q ^ n)⁻¹), K.mul_mem hk' hc, ?_⟩
    rw [pow_succ, e1, pow_succ]
    group

theorem solvRad_le_pCoreOf_of_simple {K : Subgroup G}
    (hs : IsSimpleGroup (↥K ⧸ CFSG.pCore 2 ↥K))
    (hnab : ∃ a b : ↥K ⧸ CFSG.pCore 2 ↥K, a * b ≠ b * a) :
    solvRad K ≤ pCoreOf 2 K := by
  let π : ↥K →* ↥K ⧸ CFSG.pCore 2 ↥K := QuotientGroup.mk' (CFSG.pCore 2 ↥K)
  let N : Subgroup ↥K := (solvRad K).subgroupOf K
  have hNn : N.Normal := solvRad_normal K
  have hNs : Group.IsSolvable N := by
    have := solvRad_isSolvable K
    exact Group.isSolvable_of_surjective
      (f := (Subgroup.subgroupOfEquivOfLe (solvRad_le K)).symm.toMonoidHom) (MulEquiv.surjective _)
  have hNπ : (N.map π).Normal := hNn.map π (QuotientGroup.mk'_surjective _)
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (N.map π) with h | h
  · intro x hx
    have hxN : (⟨x, solvRad_le K hx⟩ : ↥K) ∈ N := hx
    have h1 : π ⟨x, solvRad_le K hx⟩ = 1 := by
      rw [← Subgroup.mem_bot, ← h]
      exact Subgroup.mem_map_of_mem π hxN
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h1
    refine ⟨⟨x, solvRad_le K hx⟩, ?_, rfl⟩
    exact h1
  · exfalso
    have hrange : N.map π = (π.comp N.subtype).range := by
      rw [MonoidHom.range_comp, Subgroup.range_subtype]
    have h1 : Group.IsSolvable ↥(N.map π) := by
      rw [hrange]
      exact Group.isSolvable_of_surjective (π.comp N.subtype).rangeRestrict_surjective
    rw [h] at h1
    have h2 : Group.IsSolvable (↥K ⧸ CFSG.pCore 2 ↥K) :=
      Group.isSolvable_of_surjective (f := (Subgroup.topEquiv).toMonoidHom) (MulEquiv.surjective _)
    obtain ⟨a, b, hab⟩ := hnab
    exact hab ((IsSimpleGroup.comm_iff_isSolvable.2 h2) a b)

