theorem false_of_central' (h443 : Stmt4_4_3Orbit') (hC24a : ASC24One G) (hF : CharTwo H)
    {K : Subgroup G} (hK : K ∈ cComp H) (hKq : CFSG.IsQuasisimple (↥K ⧸ CFSG.pCore 2 ↥K))
    (hKM : ¬ K ≤ fsuM T L) {z : G} (hzH : z ∈ H) (hzN : z ∈ Subgroup.normalizer (K : Set G))
    (hzM : z ∈ fsuM T L) (hzo : Odd (orderOf z)) (hz1 : z ≠ 1)
    (hz : ∀ k ∈ K, k * z * k⁻¹ * z⁻¹ ∈ pCoreOf 2 K) : False := by
  have hc := C.conf.hc
  have hO2V := C.pCoreOf_le_centralizer hF hK
  have hzO : z ∈ Subgroup.normalizer (pCoreOf 2 K : Set G) :=
    normalizer_le_normalizer_pCoreOf (r := 2) K hzN
  by_cases hzV : z ∈ Subgroup.centralizer (fsuV T I : Set G)
  · have hB1 : Subgroup.zpowers z ≠ ⊥ := by
      intro h
      apply hz1
      have h' := Subgroup.mem_zpowers z
      rw [h, Subgroup.mem_bot] at h'
      exact h'
    have hN := S.normalizer_le h443 ((Subgroup.zpowers_le).mpr hzM)
      ((Subgroup.zpowers_le).mpr hzV) hB1 (isMulCommutative_zpowers z)
      (by rw [Nat.card_zpowers]; exact hzo)
    apply hKM
    intro k hk
    obtain ⟨o, ho, hok⟩ := exists_mem_normalizer_zpowers' hzO hzo hz hk
    have h1 : o * k ∈ fsuM T L := hN hok
    have h2 : o⁻¹ ∈ fsuM T L := (fsuM T L).inv_mem (C.pCoreOf_le_fsuM hK ho)
    have h3 := (fsuM T L).mul_mem h2 h1
    simpa using h3
  · have hz0 : z ∈ Subgroup.centralizer ((fsuV T I ⊓ Subgroup.centralizer ({θ} : Set G) :
        Subgroup G) : Set G) := by
      have h1 := C.conf.hHG hzH
      rwa [C.hVp] at h1
    obtain ⟨m, hm⟩ := exists_pow_of_odd hc hzM hz0 hzo hzV
    apply C.not_inf_le_Q h443 hC24a hF hK hKq hKM
    intro t ht
    obtain ⟨⟨htT, htVp⟩, htK⟩ := ht
    refine ⟨htT, ?_⟩
    have htM : t ∈ fsuM T L := S.T_le_fsuM htT
    have ht0 : t ∈ Subgroup.centralizer ((fsuV T I ⊓ Subgroup.centralizer ({θ} : Set G) :
        Subgroup G) : Set G) := by rwa [C.hVp] at htVp
    obtain ⟨k, hk⟩ := C.conf.sylH.2.1 ⟨t, ⟨htT, htVp⟩⟩
    have htk : t ^ 2 ^ k = 1 := by simpa using congrArg Subtype.val hk
    refine mem_centralizer_of_comm_th hc htM ht0 htk ?_
    set c := θ * (z ^ m)⁻¹ with hcdef
    have hcV : c ∈ Subgroup.centralizer (fsuV T I : Set G) := hm
    have htN : t ∈ Subgroup.normalizer (fsuV T I : Set G) := S.hMN htM
    have htC : t * c * t⁻¹ ∈ Subgroup.centralizer (fsuV T I : Set G) :=
      conj_mem_centralizer htN hcV
    have hzt : t * z ^ m * t⁻¹ * (z ^ m)⁻¹ ∈ Subgroup.centralizer (fsuV T I : Set G) :=
      hO2V (conj_pow_mul_inv_mem' hzO hz htK m)
    have e : t * θ * t⁻¹ * θ⁻¹ = (t * c * t⁻¹) * (t * z ^ m * t⁻¹ * (z ^ m)⁻¹) * c⁻¹ := by
      rw [hcdef]
      group
    rw [e]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ htC hzt) (Subgroup.inv_mem _ hcV)

theorem mem_of_odd_of_sl3 (h443 : Stmt4_4_3Orbit') (hC24a : ASC24One G) (hF : CharTwo H)
    {K : Subgroup G} (hK : K ∈ cComp H) (hKq : CFSG.IsQuasisimple (↥K ⧸ CFSG.pCore 2 ↥K))
    (hKM : ¬ K ≤ fsuM T L) {W : Subgroup G}
    (eK : ↥(autOn K W) ≃* Matrix.SpecialLinearGroup (Fin 3) (ZMod 2))
    (hKW : K ≤ Subgroup.normalizer (W : Set G))
    (hCK : K ⊓ Subgroup.centralizer (W : Set G) ≤ pCoreOf 2 K)
    (hP : IsMaxParabolic2 (autOn K W) (autOn (fsuM T L ⊓ H ⊓ K) W))
    {x : G} (hxo : Odd (orderOf x)) (hxM : x ∈ fsuM T L) (hxH : x ∈ H)
    (hxK : x ∈ Subgroup.normalizer (K : Set G)) (hxW : x ∈ Subgroup.normalizer (W : Set G)) :
    x ∈ K := by
  have hP1 : autOn (fsuM T L ⊓ H ⊓ K) W ≠ ⊥ := by
    obtain ⟨⟨-, S0, hS0, hS0P⟩, -, -⟩ := hP
    intro hbot
    have hS0b : S0 = ⊥ := le_bot_iff.1 (fun s hs => by
      have := hS0P ⟨hS0.1 hs, Subgroup.le_normalizer hs⟩
      rwa [hbot] at this)
    apply hS0.2.2
    rw [hS0b, Subgroup.bot_subgroupOf, Subgroup.index_bot, Nat.card_congr eK.toEquiv]
    set t0 : Matrix.SpecialLinearGroup (Fin 3) (ZMod 2) := ⟨!![1, 1, 0; 0, 1, 0; 0, 0, 1],
      by decide⟩ with ht0
    have h2 : orderOf t0 = 2 := orderOf_eq_prime (Subtype.ext (by decide)) (fun h => by
      have := congrArg (fun A : Matrix.SpecialLinearGroup (Fin 3) (ZMod 2) =>
        (A : Matrix (Fin 3) (Fin 3) (ZMod 2)) 0 1) h
      exact absurd this (by decide))
    exact (dvd_of_eq h2.symm).trans (orderOf_dvd_natCard t0)
  have hxP : x ∈ Subgroup.normalizer ((fsuM T L ⊓ H ⊓ K : Subgroup G) : Set G) :=
    Subgroup.inf_normalizer_le_normalizer_inf ⟨Subgroup.inf_normalizer_le_normalizer_inf
      ⟨Subgroup.le_normalizer hxM, Subgroup.le_normalizer hxH⟩, hxK⟩
  obtain ⟨k, hkP, hk⟩ :=
    exists_mem_comm_centralizer_of_odd eK hKW inf_le_right hP hP1 hxo hxK hxW hxP
  have hkM : k ∈ fsuM T L := hkP.1.1
  have hkH : k ∈ H := hkP.1.2
  have hkK : k ∈ K := hkP.2
  set c := k⁻¹ * x with hcdef
  have hcN : c ∈ Subgroup.normalizer (K : Set G) :=
    Subgroup.mul_mem _ (Subgroup.inv_mem _ (Subgroup.le_normalizer hkK)) hxK
  have hc : ∀ k' ∈ K, k' * c * k'⁻¹ * c⁻¹ ∈ pCoreOf 2 K := fun k' hk' => by
    refine hCK ⟨?_, hk k' hk'⟩
    have h1 : c * k'⁻¹ * c⁻¹ ∈ K := (Subgroup.mem_normalizer_iff.1 hcN _).1 (K.inv_mem hk')
    have e : k' * c * k'⁻¹ * c⁻¹ = k' * (c * k'⁻¹ * c⁻¹) := by group
    rw [e]
    exact K.mul_mem hk' h1
  have hcO : c ∈ Subgroup.normalizer (pCoreOf 2 K : Set G) :=
    normalizer_le_normalizer_pCoreOf (r := 2) K hcN
  obtain ⟨v, w, hw, hvw⟩ := Nat.exists_eq_two_pow_mul_odd (orderOf_pos c).ne'
  set z := c ^ 2 ^ v with hzdef
  have hzo : Odd (orderOf z) := by
    refine Odd.of_dvd_nat hw (orderOf_dvd_of_pow_eq_one ?_)
    rw [hzdef, ← pow_mul, ← hvw, pow_orderOf_eq_one]
  have hz : ∀ k' ∈ K, k' * z * k'⁻¹ * z⁻¹ ∈ pCoreOf 2 K := fun k' hk' =>
    conj_pow_mul_inv_mem' hcO hc hk' _
  have hzN : z ∈ Subgroup.normalizer (K : Set G) := Subgroup.pow_mem _ hcN _
  have hzM : z ∈ fsuM T L :=
    Subgroup.pow_mem _ ((fsuM T L).mul_mem ((fsuM T L).inv_mem hkM) hxM) _
  have hzH : z ∈ H := Subgroup.pow_mem _ (H.mul_mem (H.inv_mem hkH) hxH) _
  by_contra hxK'
  have hzK : z ∉ K := by
    intro hzK
    apply hxK'
    have hcm : c ^ orderOf x ∈ K := by
      obtain ⟨k'', hk'', e1⟩ := exists_mul_pow_eq (K.inv_mem hkK) hxK (orderOf x)
      rw [hcdef, e1, pow_orderOf_eq_one, mul_one]
      exact hk''
    have hcop : Nat.Coprime (2 ^ v) (orderOf x) :=
      Nat.Coprime.pow_left v (Nat.coprime_two_left.mpr hxo)
    have hcK : c ∈ K := by
      have h1 := Nat.gcd_eq_gcd_ab (2 ^ v) (orderOf x)
      rw [hcop, Nat.cast_one] at h1
      have e : c = (c ^ 2 ^ v) ^ Nat.gcdA (2 ^ v) (orderOf x) *
          (c ^ orderOf x) ^ Nat.gcdB (2 ^ v) (orderOf x) := by
        rw [← zpow_natCast c (2 ^ v), ← zpow_natCast c (orderOf x), ← zpow_mul, ← zpow_mul,
          ← zpow_add, ← h1, zpow_one]
      rw [e]
      exact K.mul_mem (K.zpow_mem hzK _) (K.zpow_mem hcm _)
    have e : x = k * c := by rw [hcdef]; group
    rw [e]
    exact K.mul_mem hkK hcK
  have hz1 : z ≠ 1 := fun h => hzK (h ▸ K.one_mem)
  exact C.false_of_central' h443 hC24a hF hK hKq hKM hzH hzN hzM hzo hz1 hz

theorem oTwoUpper_le_of_sl3 (h37c : Vol2Native.A37ForSQTKCat) (h38c : Vol2Native.A38ForSQTKCat)
    (h443 : Stmt4_4_3Orbit') (hC24a : ASC24One G) (hF : CharTwo H) {K : Subgroup G}
    (hK : K ∈ cComp H) (hKq : CFSG.IsQuasisimple (↥K ⧸ CFSG.pCore 2 ↥K)) (hKM : ¬ K ≤ fsuM T L)
    (eK : ↥(autOn K (omegaOneCenterOf (pCoreOf 2 (K ⊔ T ⊓ Subgroup.centralizer
      (fsuV T I : Set G))))) ≃* Matrix.SpecialLinearGroup (Fin 3) (ZMod 2))
    (hCK : K ⊓ Subgroup.centralizer ((omegaOneCenterOf (pCoreOf 2 (K ⊔ T ⊓
      Subgroup.centralizer (fsuV T I : Set G))) : Subgroup G) : Set G) ≤ pCoreOf 2 K)
    (hP : IsMaxParabolic2 (autOn K (omegaOneCenterOf (pCoreOf 2 (K ⊔ T ⊓ Subgroup.centralizer
      (fsuV T I : Set G))))) (autOn (fsuM T L ⊓ H ⊓ K) (omegaOneCenterOf (pCoreOf 2 (K ⊔ T ⊓
        Subgroup.centralizer (fsuV T I : Set G)))))) :
    oTwoUpper (L ⊓ Subgroup.centralizer (Vp : Set G)) ≤ K := by
  set Q := T ⊓ Subgroup.centralizer (fsuV T I : Set G) with hQdef
  have hKW := le_normalizer_omegaOneCenterOf_sup K Q
  refine (Subgroup.closure_le _).mpr ?_
  rintro x ⟨⟨hxL, hxV0⟩, hxo⟩
  have hxL₀ : x ∈ oTwoUpper (L ⊓ Subgroup.centralizer (Vp : Set G)) :=
    mem_oTwoUpper_of_odd ⟨hxL, hxV0⟩ hxo
  have hxH : x ∈ H := le_sup_left.trans C.conf.hLH hxL₀
  have hxK : x ∈ Subgroup.normalizer (K : Set G) :=
    S.oTwoUpper_le_normalizer_cComp h37c h38c C.conf.pCoreOf_ne_bot hK
      (mem_oTwoUpper_of_odd hxH hxo)
  have hxQ : x ∈ Subgroup.normalizer (Q : Set G) := S.L_le_normalizer_Q hxL
  have hxW : x ∈ Subgroup.normalizer ((omegaOneCenterOf (pCoreOf 2 (K ⊔ Q)) : Subgroup G) :
      Set G) := by
    have h1 : x ∈ Subgroup.normalizer ((K ⊔ Q : Subgroup G) : Set G) :=
      le_normalizer_sup_of (A := Subgroup.zpowers x) (Subgroup.zpowers_le.mpr hxK)
        (Subgroup.zpowers_le.mpr hxQ) (Subgroup.mem_zpowers x)
    exact CFSG.Quasithin.A4.normalizer_le_normalizer_omegaOneCenterOf _
      (normalizer_le_normalizer_pCoreOf (r := 2) _ h1)
  exact C.mem_of_odd_of_sl3 h443 hC24a hF hK hKq hKM eK hKW hCK hP hxo (S.L_le_fsuM hxL) hxH
    hxK hxW

theorem tp_le_normalizer_of_sl3 (hF : CharTwo H) {K : Subgroup G} (hK : K ∈ cComp H)
    (eX : (↥K ⧸ CFSG.pCore 2 ↥K) ≃* ↥(CFSG.Assembly.LowTwoRank.StatedSL 3 (ZMod 2)))
    (hL₀K : oTwoUpper (L ⊓ Subgroup.centralizer (Vp : Set G)) ≤ K) :
    T ⊓ Subgroup.centralizer (Vp : Set G) ≤ Subgroup.normalizer (K : Set G) := by
  have hc := C.conf.hc
  have hZ : Subgroup.center (↥K ⧸ CFSG.pCore 2 ↥K) = ⊥ := by
    have h1 := Subgroup.map_center_eq eX.symm
    rw [center_statedSL_two_eq_bot, Subgroup.map_bot] at h1
    exact h1.symm
  have hsl := CFSG.Quasithin.H13.NQCat.SLk.isSimpleGroup_sl (n := 3) (by norm_num)
  have hsS : IsSimpleGroup ↥(CFSG.Assembly.LowTwoRank.StatedSL 3 (ZMod 2)) :=
    (specialLinearGroupEquivStatedSL 3 (ZMod 2)).symm.isSimpleGroup
  have hsKq : IsSimpleGroup (↥K ⧸ CFSG.pCore 2 ↥K) := eX.isSimpleGroup
  have hnab : ∃ a b : ↥K ⧸ CFSG.pCore 2 ↥K, a * b ≠ b * a := by
    by_contra hcon
    push Not at hcon
    have htop : Subgroup.center (↥K ⧸ CFSG.pCore 2 ↥K) = ⊤ :=
      eq_top_iff.2 fun a _ => Subgroup.mem_center_iff.2 fun b => hcon b a
    rw [hZ] at htop
    obtain ⟨a, b, hab⟩ := exists_pair_ne (↥K ⧸ CFSG.pCore 2 ↥K)
    have ha : a ∈ (⊥ : Subgroup (↥K ⧸ CFSG.pCore 2 ↥K)) := htop ▸ Subgroup.mem_top a
    have hb : b ∈ (⊥ : Subgroup (↥K ⧸ CFSG.pCore 2 ↥K)) := htop ▸ Subgroup.mem_top b
    rw [Subgroup.mem_bot] at ha hb
    exact hab (ha.trans hb.symm)
  intro s hs
  by_contra hsK
  have hsH : s ∈ H := C.conf.tp_le_H hs
  set K' : Subgroup G := K.map (MulAut.conj s).toMonoidHom with hK'def
  have hK' : K' ∈ cComp H := conjSub_mem_cComp_of_mem hK hsH
  have hne : K ≠ K' := by
    intro h
    apply hsK
    refine Subgroup.mem_normalizer_fintype fun k hk => ?_
    rw [h]
    exact ⟨k, hk, rfl⟩
  have hsL₀ : s ∈ Subgroup.normalizer
      (oTwoUpper (L ⊓ Subgroup.centralizer (Vp : Set G)) : Set G) :=
    normalizer_le_normalizer_oTwoUpper _ (Subgroup.inf_normalizer_le_normalizer_inf
      ⟨S.T_le_normalizer_L hs.1, Subgroup.le_normalizer hs.2⟩)
  have hθL₀ : θ ∈ oTwoUpper (L ⊓ Subgroup.centralizer (Vp : Set G)) :=
    S.th_mem_oTwoUpper hc C.conf.vp_le
  have hθK : θ ∈ K := hL₀K hθL₀
  have hθK' : θ ∈ K' := by
    have h1 : s⁻¹ * θ * s⁻¹⁻¹ ∈ oTwoUpper (L ⊓ Subgroup.centralizer (Vp : Set G)) :=
      (Subgroup.mem_normalizer_iff.1 (Subgroup.inv_mem _ hsL₀) θ).1 hθL₀
    refine ⟨s⁻¹ * θ * s⁻¹⁻¹, hL₀K h1, ?_⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    group
  have hKR : K ⊓ solvRad H ≤ pCoreOf 2 K := by
    refine (le_solvRad (H := K) inf_le_left ?_ ?_).trans (solvRad_le_pCoreOf_of_simple hsKq hnab)
    · rw [Subgroup.normal_subgroupOf_iff_le_normalizer inf_le_left]
      intro k hk
      refine Subgroup.mem_normalizer_fintype fun y hy => ⟨K.mul_mem (K.mul_mem hk hy.1)
        (K.inv_mem hk), ?_⟩
      have h1 := solvRad_normal H
      exact (Subgroup.mem_normalizer_iff.1 (((Subgroup.normal_subgroupOf_iff_le_normalizer
        (solvRad_le H)).1 h1) (le_of_mem_cComp hK hk)) y).1 hy.2
    · have := solvRad_isSolvable H
      exact Group.isSolvable_of_isSolvable_injective (f := Subgroup.inclusion inf_le_right)
        (Subgroup.inclusion_injective _)
  have hcomm : ∀ k ∈ K, k * θ * k⁻¹ * θ⁻¹ ∈ pCoreOf 2 K := by
    intro k hk
    have h1 : ⁅k, θ⁆ ∈ solvRad H :=
      cComp_ne_commutator_le_solvRad hK hK' hne (Subgroup.commutator_mem_commutator hk hθK')
    rw [commutatorElement_def] at h1
    exact hKR ⟨K.mul_mem (K.mul_mem (K.mul_mem hk hθK) (K.inv_mem hk)) (K.inv_mem hθK), h1⟩
  have hcen : (QuotientGroup.mk ⟨θ, hθK⟩ : ↥K ⧸ CFSG.pCore 2 ↥K) ∈
      Subgroup.center (↥K ⧸ CFSG.pCore 2 ↥K) := by
    refine Subgroup.mem_center_iff.2 fun y => ?_
    obtain ⟨k, rfl⟩ := QuotientGroup.mk_surjective y
    have h1 := hcomm k k.2
    have h2 : (⟨k * θ * k⁻¹ * θ⁻¹, K.mul_mem (K.mul_mem (K.mul_mem k.2 hθK)
        (K.inv_mem k.2)) (K.inv_mem hθK)⟩ : ↥K) ∈ CFSG.pCore 2 ↥K := by
      obtain ⟨x', hx', hxx'⟩ := h1
      have e2 : x' = ⟨k * θ * k⁻¹ * θ⁻¹, K.mul_mem (K.mul_mem (K.mul_mem k.2 hθK)
          (K.inv_mem k.2)) (K.inv_mem hθK)⟩ := Subtype.ext hxx'
      rw [← e2]
      exact hx'
    have h3 : (QuotientGroup.mk (⟨k * θ * k⁻¹ * θ⁻¹, K.mul_mem (K.mul_mem (K.mul_mem k.2 hθK)
        (K.inv_mem k.2)) (K.inv_mem hθK)⟩ : ↥K) : ↥K ⧸ CFSG.pCore 2 ↥K) = 1 :=
      (QuotientGroup.eq_one_iff _).mpr h2
    have e3 : (⟨k * θ * k⁻¹ * θ⁻¹, K.mul_mem (K.mul_mem (K.mul_mem k.2 hθK)
        (K.inv_mem k.2)) (K.inv_mem hθK)⟩ : ↥K) = k * ⟨θ, hθK⟩ * k⁻¹ * (⟨θ, hθK⟩ : ↥K)⁻¹ :=
      Subtype.ext rfl
    rw [e3, QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_mul,
      QuotientGroup.mk_inv, QuotientGroup.mk_inv] at h3
    calc (QuotientGroup.mk k : ↥K ⧸ CFSG.pCore 2 ↥K) * QuotientGroup.mk ⟨θ, hθK⟩
        = ((QuotientGroup.mk k : ↥K ⧸ CFSG.pCore 2 ↥K) * QuotientGroup.mk ⟨θ, hθK⟩ *
            (QuotientGroup.mk k)⁻¹ * (QuotientGroup.mk ⟨θ, hθK⟩)⁻¹) *
          (QuotientGroup.mk ⟨θ, hθK⟩ * QuotientGroup.mk k) := by group
      _ = QuotientGroup.mk ⟨θ, hθK⟩ * QuotientGroup.mk k := by rw [h3, one_mul]
  rw [hZ, Subgroup.mem_bot, QuotientGroup.eq_one_iff] at hcen
  have hθO : θ ∈ pCoreOf 2 K := coe_mem_pCoreOf hcen
  exact th_not_mem hc (C.pCoreOf_le_centralizer hF hK hθO)

theorem sup_eq_of_le {K : Subgroup G} (hKH : K ≤ H) (hKM : ¬ K ≤ fsuM T L)
    (hL₀K : oTwoUpper (L ⊓ Subgroup.centralizer (Vp : Set G)) ≤ K) :
    K ⊔ T ⊓ Subgroup.centralizer (Vp : Set G) = H :=
  C.min _ (sup_le (hL₀K.trans le_sup_left) le_sup_right) (sup_le hKH C.conf.tp_le_H)
    fun h => hKM (le_sup_left.trans h)

theorem basic_of_c27L3
    (hC27 : ASC27Statement G)
    (h37c : Vol2Native.A37ForSQTKCat) (h38c : Vol2Native.A38ForSQTKCat)
    (h443 : Stmt4_4_3Orbit') (hC24a : ASC24One G) (hC24b : ASC24TwoChar G) (hF : CharTwo H)
    {K : Subgroup G} (hK : K ∈ cComp H) (hKq : CFSG.IsQuasisimple (↥K ⧸ CFSG.pCore 2 ↥K))
    (hKM : ¬ K ≤ fsuM T L)
    (h : C27SL3 H (T ⊓ Subgroup.centralizer (fsuV T I : Set G)) (fsuM T L ⊓ H) K
        (omegaOneCenterOf (pCoreOf 2 (K ⊔ T ⊓ Subgroup.centralizer (fsuV T I : Set G)))) ∧
      ∃ (F : Type) (_ : Field F) (_ : Fintype F), Fintype.card F = 2 ∧
        Nonempty (↥(autOn K (omegaOneCenterOf (pCoreOf 2 (K ⊔ T ⊓ Subgroup.centralizer
          (fsuV T I : Set G))))) ≃* ↥(CFSG.Assembly.LowTwoRank.StatedSL 3 F))) :
    Nonempty (↥(autOn K (omegaOneCenterOf (pCoreOf 2 (K ⊔ T ⊓ Subgroup.centralizer
        (fsuV T I : Set G))))) ≃* Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)) ∧
      K ⊓ Subgroup.centralizer ((omegaOneCenterOf (pCoreOf 2 (K ⊔ T ⊓
        Subgroup.centralizer (fsuV T I : Set G))) : Subgroup G) : Set G) ≤ pCoreOf 2 K ∧
      Nonempty ((↥K ⧸ CFSG.pCore 2 ↥K) ≃* ↥(CFSG.Assembly.LowTwoRank.StatedSL 3 (ZMod 2))) ∧
      oTwoUpper (L ⊓ Subgroup.centralizer (Vp : Set G)) ≤ K ∧
      T ⊓ Subgroup.centralizer (Vp : Set G) ≤ Subgroup.normalizer (K : Set G) ∧
      K ⊔ T ⊓ Subgroup.centralizer (Vp : Set G) = H := by
  obtain ⟨⟨-, hP, -⟩, F, hFf, hFt, hF2, ⟨eF⟩⟩ := h
  obtain ⟨eK⟩ := nonempty_equiv_sl_of_card_two hF2 eF
  obtain ⟨hCK, ⟨eX⟩⟩ := C.inf_centralizer_le_and_equiv hC27 h443 hC24a hC24b hF hK hKq hKM
    (Or.inl rfl) (eK.trans (specialLinearGroupEquivStatedSL 3 (ZMod 2)))
  have hL₀K := C.oTwoUpper_le_of_sl3 h37c h38c h443 hC24a hF hK hKq hKM eK hCK hP
  exact ⟨⟨eK⟩, hCK, ⟨eX⟩, hL₀K, C.tp_le_normalizer_of_sl3 hF hK eX hL₀K,
    C.sup_eq_of_le (le_of_mem_cComp hK) hKM hL₀K⟩

