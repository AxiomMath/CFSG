noncomputable def slMapTwo {F : Type} [Field F] (σ : F ≃+* ZMod 2) :
    Matrix.SpecialLinearGroup (Fin 3) F ≃* Matrix.SpecialLinearGroup (Fin 3) (ZMod 2) :=
  MonoidHom.toMulEquiv (Matrix.SpecialLinearGroup.map σ.toRingHom)
    (Matrix.SpecialLinearGroup.map σ.symm.toRingHom)
    (by ext A : 1; apply Subtype.ext; ext i j; simp [Matrix.SpecialLinearGroup.map_apply_coe])
    (by ext A : 1; apply Subtype.ext; ext i j; simp [Matrix.SpecialLinearGroup.map_apply_coe])

theorem nonempty_equiv_sl_of_card_two {X : Type*} [Group X] {F : Type} [Field F] [Fintype F]
    (hF : Fintype.card F = 2) (e : X ≃* ↥(CFSG.Assembly.LowTwoRank.StatedSL 3 F)) :
    Nonempty (X ≃* Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)) := by
  obtain ⟨σ⟩ : Nonempty (F ≃+* ZMod 2) :=
    ⟨FiniteField.ringEquivOfCardEq (by rw [hF]; simp)⟩
  exact ⟨(e.trans (specialLinearGroupEquivStatedSL 3 F).symm).trans (slMapTwo σ)⟩

