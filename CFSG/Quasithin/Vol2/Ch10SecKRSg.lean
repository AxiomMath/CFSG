open scoped IsMulCommutative

theorem extSq5_faithful : (FFModel.extSq (ZMod 2) 5).Faithful := by
  intro γ h
  obtain ⟨Ψ, hΨ⟩ := extSq5_equiv_alt
  refine altMulAct_faithful fun B => ?_
  obtain ⟨x, rfl⟩ := Ψ.surjective B
  have h1 : extSqAct (ZMod 2) 5 γ x * x⁻¹ ∈ (⊥ : Subgroup _) := h x (Subgroup.mem_top x)
  have h2 : extSqAct (ZMod 2) 5 γ x = x := by
    rw [Subgroup.mem_bot, mul_inv_eq_one] at h1
    exact h1
  have h3 := hΨ γ x
  rw [h2] at h3
  exact h3.symm

variable {G : Type} [Group G]

structure AltCoord (L W : Subgroup G) where
  E : G → Matrix (Fin 5) (Fin 5) (ZMod 2)
  ρ : ↥L →* Matrix.SpecialLinearGroup (Fin 5) (ZMod 2)
  le : L ≤ Subgroup.normalizer (W : Set G)
  mem : ∀ a, E a ∈ altMat 5
  map_mul : ∀ a ∈ W, ∀ b ∈ W, E (a * b) = E a + E b
  inj : ∀ a ∈ W, ∀ b ∈ W, E a = E b → a = b
  surj : ∀ B ∈ altMat 5, ∃ a ∈ W, E a = B
  conj : ∀ (l : ↥L), ∀ a ∈ W,
    E ((l : G) * a * (l : G)⁻¹) = (ρ l : Matrix (Fin 5) (Fin 5) (ZMod 2)) * E a *
      (ρ l : Matrix (Fin 5) (Fin 5) (ZMod 2))ᵀ
  ρ_surj : Function.Surjective ρ

theorem exists_altCoord {L W : Subgroup G} (hLW : L ≤ Subgroup.normalizer (W : Set G))
    (h : ∃ _ : IsMulCommutative ↥W, SLExteriorTwo (V := ↥W) (autOn L W) ⊤ ⊥ 5) :
    Nonempty (AltCoord L W) := by
  classical
  obtain ⟨_, π, hπ⟩ := h
  obtain ⟨E, hE⟩ := G64.RealizesVia.exists_secEquiv (D := FFModel.extSq (ZMod 2) 5) rfl hπ
  obtain ⟨Ψ, hΨ⟩ := extSq5_equiv_alt
  have hinj : Function.Injective π :=
    FFModel.RealizesVia.injective_of_faithful extSq5_faithful hπ
  let πe := MulEquiv.ofBijective π ⟨hinj, hπ.1⟩
  let σ : ↥L →* ↥(autOn L W) := (QuasithinUnique.Setup.rho W L hLW).codRestrict (autOn L W)
    fun l => (QuasithinUnique.Setup.mem_autOn_self_iff hLW).2 ⟨l, rfl⟩
  have hσ : Function.Surjective σ := by
    rintro ⟨φ, hφ⟩
    obtain ⟨l, rfl⟩ := (QuasithinUnique.Setup.mem_autOn_self_iff hLW).1 hφ
    exact ⟨l, rfl⟩
  let eSL := specialLinearGroupEquivStatedSL 5 (ZMod 2)
  let ρ : ↥L →* Matrix.SpecialLinearGroup (Fin 5) (ZMod 2) :=
    (eSL.symm.toMonoidHom.comp πe.symm.toMonoidHom).comp σ
  let Φ : ↥W ≃* Multiplicative ↥(altMat 5) :=
    ((E.trans (MulEquiv.subgroupCongr (rfl : (FFModel.extSq (ZMod 2) 5).sec = ⊤))).trans
      Subgroup.topEquiv).trans Ψ
  have hΦe : ∀ (γ : (FFModel.extSq (ZMod 2) 5).Gam) (v : ↥W),
      Φ (((π γ : ↥(autOn L W)) : MulAut ↥W) v) = altMulAct γ (Φ v) := by
    intro γ v
    have h1 := hE γ v
    show Ψ ((E _ : ↥(FFModel.extSq (ZMod 2) 5).sec) : (FFModel.extSq (ZMod 2) 5).Amb) = _
    rw [h1]
    exact hΨ γ _
  let coord : ↥W → Matrix (Fin 5) (Fin 5) (ZMod 2) := fun w =>
    ((Multiplicative.toAdd (Φ w) : ↥(altMat 5)) : Matrix (Fin 5) (Fin 5) (ZMod 2))
  have hcoord : ∀ a b : ↥W, coord (a * b) = coord a + coord b := by
    intro a b
    simp only [coord, map_mul, toAdd_mul, Submodule.coe_add]
  have hcinj : ∀ a b : ↥W, coord a = coord b → a = b := by
    intro a b hab
    apply Φ.injective
    exact Multiplicative.toAdd.injective (Subtype.ext hab)
  refine ⟨⟨fun g => if hg : g ∈ W then coord ⟨g, hg⟩ else 0, ρ, hLW, ?_, ?_, ?_, ?_, ?_, ?_⟩⟩
  · intro a
    by_cases ha : a ∈ W
    · simp only [ha, dite_true]
      exact (Multiplicative.toAdd (Φ ⟨a, ha⟩)).2
    · simp only [ha, dite_false]
      exact (altMat 5).zero_mem
  · intro a ha b hb
    simp only [ha, hb, W.mul_mem ha hb, dite_true]
    exact hcoord ⟨a, ha⟩ ⟨b, hb⟩
  · intro a ha b hb hab
    simp only [ha, hb, dite_true] at hab
    exact congrArg Subtype.val (hcinj ⟨a, ha⟩ ⟨b, hb⟩ hab)
  · intro B hB
    refine ⟨(Φ.symm (Multiplicative.ofAdd ⟨B, hB⟩) : ↥W), Subtype.prop _, ?_⟩
    simp only [Subtype.coe_eta, Subtype.prop _, dite_true, coord, MulEquiv.apply_symm_apply]
    rfl
  · intro l a ha
    have hla : (l : G) * a * (l : G)⁻¹ ∈ W :=
      (Subgroup.mem_normalizer_iff.1 (hLW l.2) a).1 ha
    simp only [ha, hla, dite_true]
    set γ := πe.symm (σ l) with hγ
    have hπγ : π γ = σ l := πe.apply_symm_apply (σ l)
    have h1 : (⟨(l : G) * a * (l : G)⁻¹, hla⟩ : ↥W) =
        (((π γ : ↥(autOn L W)) : MulAut ↥W) ⟨a, ha⟩) := by
      rw [hπγ]
      apply Subtype.ext
      exact (QuasithinUnique.Setup.rho_apply_coe hLW l ⟨a, ha⟩).symm
    have h3 : ((ρ l : Matrix.SpecialLinearGroup (Fin 5) (ZMod 2)) :
        Matrix (Fin 5) (Fin 5) (ZMod 2)) = B5.Ln.mat γ := by
      have h := specialLinearGroupEquivStatedSL_coe 5 (ZMod 2) (eSL.symm γ)
      have h' : specialLinearGroupEquivStatedSL 5 (ZMod 2) (eSL.symm γ) = γ :=
        eSL.apply_symm_apply γ
      rw [h'] at h
      exact h.symm
    rw [h1, h3]
    show ((Multiplicative.toAdd (Φ _) : ↥(altMat 5)) : Matrix (Fin 5) (Fin 5) (ZMod 2)) = _
    rw [hΦe]
    rfl
  · exact (eSL.symm.surjective.comp πe.symm.surjective).comp hσ

local notation "M5" => Matrix (Fin 5) (Fin 5) (ZMod 2)

namespace AltCoord

variable {L W : Subgroup G} (C : AltCoord L W)

theorem congr_inv (A : SL5)
    (B : M5) :
    (A : M5) *
        (((A⁻¹ : SL5) : M5) *
          B * ((A⁻¹ : SL5) :
            M5)ᵀ) * (A : M5)ᵀ = B := by
  have h1 : (A : M5) *
      ((A⁻¹ : SL5) : M5) = 1 := by
    rw [← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel]
    rfl
  calc _ = ((A : M5) *
        ((A⁻¹ : SL5) : M5)) *
        B * ((A : M5) *
          ((A⁻¹ : SL5) :
            M5))ᵀ := by
        simp only [Matrix.transpose_mul, Matrix.mul_assoc]
    _ = B := by rw [h1, Matrix.transpose_one, Matrix.one_mul, Matrix.mul_one]

theorem congr_conj_aux (a i r B : M5) (hi : i * a = 1) :
    a * (r * B * rᵀ) * aᵀ = (a * r * i) * (a * B * aᵀ) * (a * r * i)ᵀ := by
  rw [Matrix.transpose_mul, Matrix.transpose_mul]
  have hiT : aᵀ * iᵀ = 1 := by rw [← Matrix.transpose_mul, hi, Matrix.transpose_one]
  simp only [Matrix.mul_assoc]
  rw [← Matrix.mul_assoc i a, hi, Matrix.one_mul, ← Matrix.mul_assoc aᵀ iᵀ, hiT, Matrix.one_mul]

noncomputable def conjBy (A : SL5) : AltCoord L W where
  E g := (A : M5) * C.E g * (A : M5)ᵀ
  ρ := (MulAut.conj A).toMonoidHom.comp C.ρ
  le := C.le
  mem a := congr_mem_altMat _ (C.mem a)
  map_mul a ha b hb := by
    rw [C.map_mul a ha b hb, Matrix.mul_add, Matrix.add_mul]
  inj a ha b hb h := C.inj a ha b hb (by
    have := congrArg (fun B => ((A⁻¹ : SL5) :
      M5) * B * ((A⁻¹ : SL5) :
        M5)ᵀ) h
    have hc := congr_inv A⁻¹ (C.E a)
    have hd := congr_inv A⁻¹ (C.E b)
    simp only [inv_inv] at hc hd this
    simp only [Matrix.mul_assoc] at this hc hd ⊢
    rw [hc, hd] at this
    exact this)
  surj B hB := by
    obtain ⟨a, ha, hab⟩ := C.surj _ (congr_mem_altMat
      ((A⁻¹ : SL5) : M5) hB)
    exact ⟨a, ha, by rw [hab, congr_inv]⟩
  conj l a ha := by
    have h1 : ((A⁻¹ : SL5) :
        M5) * (A : M5) = 1 := by
      rw [← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel]
      rfl
    have h2 : (((MulAut.conj A).toMonoidHom.comp C.ρ l : SL5) :
        M5) = (A : M5) *
          (C.ρ l : M5) *
            ((A⁻¹ : SL5) : M5) := by
      simp [MulAut.conj_apply, Matrix.SpecialLinearGroup.coe_mul]
    rw [h2]
    show (A : M5) * C.E ((l : G) * a * (l : G)⁻¹) *
      (A : M5)ᵀ = _
    rw [C.conj l a ha]
    exact congr_conj_aux _ _ _ _ h1
  ρ_surj := (MulAut.conj A).surjective.comp C.ρ_surj

theorem conjBy_ρ (A : SL5) (l : ↥L) : (C.conjBy A).ρ l = A * C.ρ l * A⁻¹ := by
  change ((MulAut.conj A).toMonoidHom.comp C.ρ) l = _
  rw [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]

end AltCoord

