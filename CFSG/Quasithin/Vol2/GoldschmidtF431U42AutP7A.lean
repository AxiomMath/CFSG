theorem centralizer_A1 {g : Ah}
    (hg : ∀ a ∈ listSub Al1 A1_check.1 A1_check.2.1, g * a = a * g) :
    g ∈ listSub Al1 A1_check.1 A1_check.2.1 :=
  centralizer_listSub D1w Dl1 Dl1_eq (fun w hw => mem_P1h_of_repL (repL_aW w) (D1_check.2.2.1 w hw))
    D1_check.2.2.2 D1_check.1 card_C1 D1_check.2.1 Al1 A1_check.1 A1_check.2.1
    A1_check.2.2.2.1 A_cent_check.2.2.1 A_cent_check.2.2.2.1 A_cent_check.1 hg

