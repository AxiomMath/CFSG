theorem A1_check : idL ∈ Al1 ∧ (∀ a ∈ Al1, ∀ b ∈ Al1, comp a b ∈ Al1) ∧
    (∀ a ∈ Al1, a ∈ Dl1) ∧ (∀ a ∈ Al1, a ∈ Thl) ∧
    (∀ d ∈ Dl1, ∀ a ∈ Al1, ∃ a' ∈ Al1, comp d a = comp a' d) ∧ g1w ∈ D1w ∧ Al1.Nodup ∧
    Al1.length = 16 ∧
    (∀ l ∈ Thl, comp l fhatL = comp fhatL l →
      comp (comp (evalAL (invAL g1w)) l) (evalAL g1w) ∈ Thl → l ∈ Al1) := by
  decide +kernel

theorem A2_check : idL ∈ Al2 ∧ (∀ a ∈ Al2, ∀ b ∈ Al2, comp a b ∈ Al2) ∧
    (∀ a ∈ Al2, a ∈ Dl2) ∧ (∀ a ∈ Al2, a ∈ Thl) ∧
    (∀ d ∈ Dl2, ∀ a ∈ Al2, ∃ a' ∈ Al2, comp d a = comp a' d) ∧ g2w ∈ D2w ∧ Al2.Nodup ∧
    Al2.length = 16 ∧
    (∀ l ∈ Thl, comp l fhatL = comp fhatL l →
      comp (comp (evalAL (invAL g2w)) l) (evalAL g2w) ∈ Thl → l ∈ Al2) := by
  decide +kernel

theorem A_cent_check :
    (∀ d ∈ Dl1, (∀ a ∈ Al1, comp d a = comp a d) → d ∈ Al1) ∧
    (∀ d ∈ Dl1, (∀ a ∈ Al2, comp d a = comp a d) → d ∈ Al2) ∧
    xL ∈ Al1 ∧ fhatL ∈ Al1 ∧ xL ∈ Al2 ∧ fhatL ∈ Al2 ∧ (∀ a ∈ Al2, a ∈ Dl1) := by
  decide +kernel

theorem pCoreOf_D1 :
    pCoreOf 2 (P1h ⊓ Subgroup.centralizer ({fhatA} : Set Ah)) =
      listSub Al1 A1_check.1 A1_check.2.1 :=
  pCoreOf_eq_listSub (That_le_Bh.trans Bh_le_P1h) D1w Dl1 Al1 g1w Dl1_eq
    (fun w hw => mem_P1h_of_repL (repL_aW w) (D1_check.2.2.1 w hw)) D1_check.2.2.2 D1_check.1
    card_C1 D1_check.2.1 A1_check.1 A1_check.2.1 A1_check.2.2.1 A1_check.2.2.2.1
    A1_check.2.2.2.2.1 A1_check.2.2.2.2.2.1 A1_check.2.2.2.2.2.2.2.2

theorem pCoreOf_D2 :
