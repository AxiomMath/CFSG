@[expose] noncomputable def covQBTheta {G : Type} [Group G] {Kz Lz : Subgroup G} (hLK : Lz ≤ Kz) :
    ↥Lz →* ↥(modO2Image Kz Lz) :=
  ((QuotientGroup.mk' (CFSG.pCore 2 ↥Kz)).comp (Subgroup.inclusion hLK)).codRestrict
    (modO2Image Kz Lz) (fun x => kzMemModO2Image_kz3.mpr ⟨(x : G), x.2, hLK x.2, rfl⟩)

theorem covQBTheta_surjective {G : Type} [Group G] {Kz Lz : Subgroup G} (hLK : Lz ≤ Kz) :
    Function.Surjective (covQBTheta hLK) := by
  intro b
  obtain ⟨l, hlL, hlK, hl⟩ := kzMemModO2Image_kz3.mp b.2
  exact ⟨⟨l, hlL⟩, Subtype.ext hl⟩

theorem covQB_comm_mem {G : Type} [Group G] [Finite G] {Lz : Subgroup G} {y : G} (hyL : y ∈ Lz)
    (hcomm : ∀ l ∈ Lz, y⁻¹ * l⁻¹ * y * l ∈ CFSG.Open.pCoreOf 2 Lz) (l : ↥Lz) :
    l * ⟨y, hyL⟩ * l⁻¹ * ⟨y, hyL⟩⁻¹ ∈ CFSG.pCore 2 ↥Lz := by
  haveI : (CFSG.pCore 2 ↥Lz).Normal := CFSG.pCore_normal
  have hx : (⟨y, hyL⟩ : ↥Lz)⁻¹ * l⁻¹ * ⟨y, hyL⟩ * l ∈ CFSG.pCore 2 ↥Lz := by
    rw [mem_pCore_iff_kz2]
    simpa using hcomm (l : G) l.2
  have h2 : (l * ⟨y, hyL⟩) * ((⟨y, hyL⟩ : ↥Lz)⁻¹ * l⁻¹ * ⟨y, hyL⟩ * l)⁻¹ * (l * ⟨y, hyL⟩)⁻¹ ∈
      CFSG.pCore 2 ↥Lz :=
    Subgroup.Normal.conj_mem inferInstance _ ((CFSG.pCore 2 ↥Lz).inv_mem hx) _
  have e : l * ⟨y, hyL⟩ * l⁻¹ * ⟨y, hyL⟩⁻¹ =
      (l * ⟨y, hyL⟩) * ((⟨y, hyL⟩ : ↥Lz)⁻¹ * l⁻¹ * ⟨y, hyL⟩ * l)⁻¹ * (l * ⟨y, hyL⟩)⁻¹ := by
    group
  rw [e]
  exact h2

theorem covQB_pCore_le {G : Type} [Group G] [Finite G] {Kz Lz : Subgroup G} (hLK : Lz ≤ Kz) :
    (CFSG.pCore 2 ↥Lz).map (covQBTheta hLK) ≤ CFSG.pCore 2 ↥(modO2Image Kz Lz) := by
  have hN : ((CFSG.pCore 2 ↥Lz).map (covQBTheta hLK)).Normal :=
    (CFSG.pCore_normal : (CFSG.pCore 2 ↥Lz).Normal).map _ (covQBTheta_surjective hLK)
  have hP : IsPGroup 2 ↥((CFSG.pCore 2 ↥Lz).map (covQBTheta hLK)) :=
    IsPGroup.map (CFSG.pCore_isPGroup : IsPGroup 2 (CFSG.pCore 2 ↥Lz)) (covQBTheta hLK)
  exact le_sSup ⟨hN, hP⟩

theorem covQB_central {G : Type} [Group G] [Finite G] {Kz Lz : Subgroup G} (hLK : Lz ≤ Kz) {y : G}
    (hyL : y ∈ Lz) (hcomm : ∀ l ∈ Lz, y⁻¹ * l⁻¹ * y * l ∈ CFSG.Open.pCoreOf 2 Lz)
    (h : (QuotientGroup.mk' (CFSG.pCore 2 ↥Kz) ⟨y, hLK hyL⟩ : ↥Kz ⧸ CFSG.pCore 2 ↥Kz) ∈
      modO2Image Kz Lz) :
    (QuotientGroup.mk (⟨QuotientGroup.mk' (CFSG.pCore 2 ↥Kz) ⟨y, hLK hyL⟩, h⟩ :
        ↥(modO2Image Kz Lz)) :
        ↥(modO2Image Kz Lz) ⧸ CFSG.pCore 2 ↥(modO2Image Kz Lz)) ∈
      Subgroup.center (↥(modO2Image Kz Lz) ⧸ CFSG.pCore 2 ↥(modO2Image Kz Lz)) := by
  haveI : (CFSG.pCore 2 ↥(modO2Image Kz Lz)).Normal := CFSG.pCore_normal
  have hY : (⟨QuotientGroup.mk' (CFSG.pCore 2 ↥Kz) ⟨y, hLK hyL⟩, h⟩ : ↥(modO2Image Kz Lz)) =
      covQBTheta hLK ⟨y, hyL⟩ := rfl
  rw [hY, Subgroup.mem_center_iff]
  intro g
  obtain ⟨b, rfl⟩ := QuotientGroup.mk_surjective g
  obtain ⟨L', rfl⟩ := covQBTheta_surjective hLK b
  apply kzMkCommOfComm_kz3
  have key : covQBTheta hLK L' * covQBTheta hLK ⟨y, hyL⟩ * (covQBTheta hLK L')⁻¹ *
      (covQBTheta hLK ⟨y, hyL⟩)⁻¹ = covQBTheta hLK (L' * ⟨y, hyL⟩ * L'⁻¹ * ⟨y, hyL⟩⁻¹) := by
    simp only [map_mul, map_inv]
  rw [key]
  exact covQB_pCore_le hLK (Subgroup.mem_map_of_mem _ (covQB_comm_mem hyL hcomm L'))

theorem covQB_S_le_normalizer {G : Type} [Group G] [Finite G] {T Kz Lz : Subgroup G}
    (hTLz : T ≤ Subgroup.normalizer (Lz : Set G)) (hLK : Lz ≤ Kz) :
    modO2Image Kz (T ⊓ Kz) ≤
      Subgroup.normalizer (modO2Image Kz Lz : Set (↥Kz ⧸ CFSG.pCore 2 ↥Kz)) := by
  have hkey : ∀ s ∈ modO2Image Kz (T ⊓ Kz), ∀ x ∈ modO2Image Kz Lz,
      s * x * s⁻¹ ∈ modO2Image Kz Lz := by
    intro s hs x hx
    obtain ⟨t, htTK, htK, rfl⟩ := kzMemModO2Image_kz3.mp hs
    obtain ⟨l, hlL, hlK, rfl⟩ := kzMemModO2Image_kz3.mp hx
    have htT : t ∈ T := (Subgroup.mem_inf.mp htTK).1
    have hconj : t * l * t⁻¹ ∈ Lz := (Subgroup.mem_normalizer_iff.mp (hTLz htT) l).mp hlL
    have hKc : t * l * t⁻¹ ∈ Kz :=
      Subgroup.mul_mem _ (Subgroup.mul_mem _ htK hlK) (Subgroup.inv_mem _ htK)
    rw [kzMemModO2Image_kz3]
    refine ⟨t * l * t⁻¹, hconj, hKc, ?_⟩
    rw [← map_inv, ← map_mul, ← map_mul]
    congr 1
  intro s hs
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · exact hkey s hs x
  · intro hx
    have h := hkey s⁻¹ (Subgroup.inv_mem _ hs) _ hx
    have e : s⁻¹ * (s * x * s⁻¹) * s⁻¹⁻¹ = x := by group
    rwa [e] at h

theorem cov_Q_B {G : Type} [Group G] [Finite G] {T Kz Lz : Subgroup G} {y : G}
    (hTLz : T ≤ Subgroup.normalizer (Lz : Set G)) (hLK : Lz ≤ Kz) (hLzperf : ⁅Lz, Lz⁆ = Lz)
    (hLzq : CFSG.Quasithin.IsHat (↥Lz ⧸ CFSG.pCore 2 ↥Lz) (alternatingGroup (Fin 6)))
    (hyL : y ∈ Lz) (hy3 : y ^ 3 = 1)
    (hcomm : ∀ l ∈ Lz, y⁻¹ * l⁻¹ * y * l ∈ CFSG.Open.pCoreOf 2 Lz) :
    ⁅CFSG.Quasithin.modO2Image Kz Lz, CFSG.Quasithin.modO2Image Kz Lz⁆ =
        CFSG.Quasithin.modO2Image Kz Lz ∧
      CFSG.Quasithin.modO2Image Kz (T ⊓ Kz) ≤
        Subgroup.normalizer (CFSG.Quasithin.modO2Image Kz Lz : Set (↥Kz ⧸ CFSG.pCore 2 ↥Kz)) ∧
      CFSG.Quasithin.IsHat
        (↥(CFSG.Quasithin.modO2Image Kz Lz) ⧸ CFSG.pCore 2 ↥(CFSG.Quasithin.modO2Image Kz Lz))
        (alternatingGroup (Fin 6)) ∧
      ∃ h : (QuotientGroup.mk' (CFSG.pCore 2 ↥Kz) ⟨y, hLK hyL⟩ : ↥Kz ⧸ CFSG.pCore 2 ↥Kz) ∈
          CFSG.Quasithin.modO2Image Kz Lz,
        (QuotientGroup.mk (⟨QuotientGroup.mk' (CFSG.pCore 2 ↥Kz) ⟨y, hLK hyL⟩, h⟩ :
            ↥(CFSG.Quasithin.modO2Image Kz Lz)) :
            ↥(CFSG.Quasithin.modO2Image Kz Lz) ⧸ CFSG.pCore 2 ↥(CFSG.Quasithin.modO2Image Kz Lz)) ∈
          Subgroup.center
            (↥(CFSG.Quasithin.modO2Image Kz Lz) ⧸ CFSG.pCore 2 ↥(CFSG.Quasithin.modO2Image Kz Lz)) := by
  refine ⟨kzBq_commutator_kz3 hLK hLzperf, covQB_S_le_normalizer hTLz hLK, ?_, ?_⟩
  · obtain ⟨e⟩ := modO2_quot_iso_kz3 (Gz := Kz) hLK
    exact IsHat.of_mulEquiv e hLzq
  · have hmem : (QuotientGroup.mk' (CFSG.pCore 2 ↥Kz) ⟨y, hLK hyL⟩ : ↥Kz ⧸ CFSG.pCore 2 ↥Kz) ∈
        modO2Image Kz Lz :=
      kzMemModO2Image_kz3.mpr ⟨y, hyL, hLK hyL, rfl⟩
    exact ⟨hmem, covQB_central hLK hyL hcomm hmem⟩

