variable {K : Type*} [Group K]

theorem center_eq_bot_of_simple (hs : IsSimpleGroup K) {a b : K} (hab : a * b ≠ b * a) :
    Subgroup.center K = ⊥ := by
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center K) with h | h
  · exact h
  · exfalso
    have ha : a ∈ Subgroup.center K := h ▸ Subgroup.mem_top a
    exact hab (Subgroup.mem_center_iff.1 ha b).symm

theorem isPerfect_of_simple (hs : IsSimpleGroup K) {a b : K} (hab : a * b ≠ b * a) :
    Group.IsPerfect K := by
  rw [Group.isPerfect_def]
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (commutator K) with h | h
  · exfalso
    apply hab
    have : ⁅a, b⁆ ∈ commutator K := by
      rw [commutator_def]
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_top a) (Subgroup.mem_top b)
    rw [h, Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm] at this
    exact this
  · exact h

theorem isQuasisimple_of_simple (hs : IsSimpleGroup K) {a b : K} (hab : a * b ≠ b * a) :
    CFSG.IsQuasisimple K := by
  have hZ := center_eq_bot_of_simple hs hab
  let e : K ⧸ Subgroup.center K ≃* K :=
    (QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot
  refine ⟨isPerfect_of_simple hs hab, (MulEquiv.isSimpleGroup_congr e).2 hs, e.symm a, e.symm b,
    ?_⟩
  rw [← map_mul, ← map_mul]
  exact fun h => hab (e.symm.injective h)

theorem pCore_eq_bot_of_simple [Finite K] (hs : IsSimpleGroup K) {a b : K}
    (hab : a * b ≠ b * a) : CFSG.pCore 2 K = ⊥ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : (CFSG.pCore 2 K).Normal := CFSG.pCore_normal
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (CFSG.pCore 2 K) with h | h
  · exact h
  · exfalso
    have h2 : IsPGroup 2 K := fun x => by
      obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := 2) (G := K)) ⟨x, h ▸ Subgroup.mem_top x⟩
      exact ⟨k, by simpa using congrArg Subtype.val hk⟩
    have : Group.IsNilpotent K := h2.isNilpotent
    have : Group.IsPerfect K := isPerfect_of_simple hs hab
    exact Group.IsPerfect.not_isNilpotent K inferInstance

end Simple

