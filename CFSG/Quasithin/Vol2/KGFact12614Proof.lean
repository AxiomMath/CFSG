theorem eq_bot_of_perfect_of_two [Finite G] {P : Subgroup G} (hP : ⁅P, P⁆ = P)
    (h2 : IsPGroup 2 ↥P) : P = ⊥ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  by_contra hne
  have : Nontrivial ↥P := (Subgroup.nontrivial_iff_ne_bot P).mpr hne
  have : Group.IsNilpotent ↥P := h2.isNilpotent
  have : Group.IsPerfect ↥P := Subgroup.isPerfect_iff.mpr hP
  exact Group.IsPerfect.not_isNilpotent ↥P inferInstance

theorem eq_top_of_perfect_of_two {X : Type*} [Group X] [Finite X] [Group.IsPerfect X]
    (N : Subgroup X) [N.Normal] (hN : IsPGroup 2 (X ⧸ N)) : N = ⊤ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  by_contra hne
  have : Nontrivial (X ⧸ N) := by
    rw [← not_subsingleton_iff_nontrivial, QuotientGroup.subsingleton_iff]
    exact hne
  have : Group.IsNilpotent (X ⧸ N) := hN.isNilpotent
  exact Group.IsPerfect.not_isNilpotent (X ⧸ N) inferInstance

theorem mem_cComp_of_simple [Finite G] {B X : Subgroup G} (hBX : B ≤ X)
    (hXB : X ≤ Subgroup.normalizer (B : Set G)) (hB : ⁅B, B⁆ = B)
    (hs : IsSimpleGroup (↥B ⧸ CFSG.pCore 2 ↥B)) : B ∈ cComp X := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hBne : B ≠ ⊥ := by
    rintro rfl
    obtain ⟨a, b, hab⟩ := exists_pair_ne (↥(⊥ : Subgroup G) ⧸ CFSG.pCore 2 ↥(⊥ : Subgroup G))
    apply hab
    induction a using QuotientGroup.induction_on with
    | H a =>
      induction b using QuotientGroup.induction_on with
      | H b => rw [Subsingleton.elim a b]
  refine ⟨hBne, hB, A3.subnormal_of_normal hBX (Subgroup.normal_subgroupOf_of_le_normalizer hXB),
    fun P hPB hPne hPp hPsub => ?_⟩
  have hPB' := A3.subnormal_of_le_of_le hPsub hPB.le hBX
  obtain ⟨N, hNB, hNn, hPN⟩ := A3.subnormal_exists_normal_of_lt hPB' hPB
  set O := CFSG.pCore 2 ↥B with hOdef
  have hmn : ((N.subgroupOf B).map (QuotientGroup.mk' O)).Normal :=
    Subgroup.Normal.map hNn _ (QuotientGroup.mk'_surjective O)
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal ((N.subgroupOf B).map (QuotientGroup.mk' O))
    with hbot | htop
  ·
    apply hPne
    refine eq_bot_of_perfect_of_two hPp ?_
    rintro ⟨x, hx⟩
    have hxN : (⟨x, hPB.le hx⟩ : ↥B) ∈ N.subgroupOf B := hPN hx
    have hxO : (⟨x, hPB.le hx⟩ : ↥B) ∈ O := by
      have h1 : QuotientGroup.mk' O ⟨x, hPB.le hx⟩ ∈ (N.subgroupOf B).map (QuotientGroup.mk' O) :=
        ⟨_, hxN, rfl⟩
      rw [hbot, Subgroup.mem_bot, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h1
      exact h1
    obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := 2) (G := ↥B)) ⟨_, hxO⟩
    refine ⟨k, Subtype.ext ?_⟩
    have := congrArg (fun y : ↥O => ((y : ↥B) : G)) hk
    simpa using this
  ·
    apply hNB.ne
    have : Group.IsPerfect ↥B := Subgroup.isPerfect_iff.mpr hB
    have hQ : IsPGroup 2 (↥B ⧸ N.subgroupOf B) := by
      intro z
      induction z using QuotientGroup.induction_on with
      | H b =>
        have h1 : QuotientGroup.mk' O b ∈ (N.subgroupOf B).map (QuotientGroup.mk' O) := by
          rw [htop]
          exact Subgroup.mem_top _
        obtain ⟨n, hn, hnb⟩ := h1
        have hnO : n⁻¹ * b ∈ O := by
          rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq] at hnb
          exact hnb
        obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := 2) (G := ↥B)) ⟨_, hnO⟩
        refine ⟨k, ?_⟩
        have hk' : (n⁻¹ * b) ^ 2 ^ k = 1 := congrArg Subtype.val hk
        have he : (QuotientGroup.mk b : ↥B ⧸ N.subgroupOf B) = QuotientGroup.mk (n⁻¹ * b) := by
          rw [QuotientGroup.eq]
          have := hNn.conj_mem _ ((N.subgroupOf B).inv_mem hn) b⁻¹
          simpa [mul_assoc] using this
        rw [he, ← QuotientGroup.mk_pow, hk', QuotientGroup.mk_one]
    have htop' := eq_top_of_perfect_of_two (N.subgroupOf B) hQ
    exact le_antisymm hNB.le fun b hb => by
      have : (⟨b, hb⟩ : ↥B) ∈ N.subgroupOf B := htop' ▸ Subgroup.mem_top _
      exact this

theorem eq_one_of_mem_centralizer [Finite G] {Y K T : Subgroup G}
    (hYK : Y ≤ Subgroup.normalizer (K : Set G)) (hT2 : IsPGroup 2 ↥T) (hTY : T ≤ Y)
    (hYeq : Y = K ⊔ T) (hO2 : pCoreOf 2 Y = ⊥) (hZ : K ⊓ Subgroup.centralizer (K : Set G) = ⊥)
    {t : G} (htY : t ∈ Y) (ht : t ∈ Subgroup.centralizer (K : Set G)) : t = 1 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hYC : Y ≤ Subgroup.normalizer
      ((Y ⊓ Subgroup.centralizer (K : Set G) : Subgroup G) : Set G) := fun y hy =>
    A4.mem_normalizer_inf (Subgroup.le_normalizer hy) (A4.mem_normalizer_centralizer (hYK hy))
  have hTK : T ≤ Subgroup.normalizer (K : Set G) := hTY.trans hYK
  have hC2 : IsPGroup 2 ↥(Y ⊓ Subgroup.centralizer (K : Set G)) := by
    rintro ⟨c, hcY, hcC⟩
    have hc' : c ∈ (↑(K ⊔ T) : Set G) := hYeq ▸ hcY
    rw [Subgroup.coe_mul_of_right_le_normalizer_left K T hTK] at hc'
    obtain ⟨y, hy, s, hs, hys⟩ := hc'
    obtain ⟨j, hj⟩ := hT2 ⟨s, hs⟩
    have hj' : s ^ 2 ^ j = 1 := congrArg Subtype.val hj
    obtain ⟨y', hy', hp⟩ := A4.exists_pow_mul_eq hy (hTK hs) (2 ^ j)
    have hcK : c ^ 2 ^ j ∈ K := by
      rw [← hys, hp, hj', mul_one]
      exact hy'
    have h1 : c ^ 2 ^ j ∈ K ⊓ Subgroup.centralizer (K : Set G) := ⟨hcK, Subgroup.pow_mem _ hcC _⟩
    rw [hZ, Subgroup.mem_bot] at h1
    exact ⟨j, Subtype.ext (by simpa using h1)⟩
  have hle := le_pCoreOf_of_le_normalizer inf_le_left hYC hC2
  rw [hO2] at hle
  exact Subgroup.mem_bot.1 (hle ⟨htY, ht⟩)

theorem mem_normalizer_subgroupOf {K B : Subgroup G} {k : ↥K}
    (hk : (k : G) ∈ Subgroup.normalizer (B : Set G)) :
    k ∈ Subgroup.normalizer ((B.subgroupOf K : Subgroup ↥K) : Set ↥K) := by
  rw [Subgroup.mem_normalizer_iff] at hk ⊢
  intro x
  simp only [Subgroup.mem_subgroupOf, Subgroup.coe_mul, Subgroup.coe_inv]
  exact hk x

