open scoped IsMulCommutative

theorem mem_normalizer_wSetG_iff {V P : Subgroup G} (hP : P ≤ Subgroup.normalizer (V : Set G))
    (W : Set ↥V) (p : ↥P) :
    (p : G) ∈ Subgroup.normalizer (Subtype.val '' W : Set G) ↔
      ∀ v : ↥V, Setup.rho V P hP p v ∈ W ↔ v ∈ W := by
  have hpV := hP p.2
  have hval : ∀ v : ↥V, ((Setup.rho V P hP p v : ↥V) : G) = (p : G) * v * (p : G)⁻¹ :=
    Setup.rho_apply_coe hP p
  have hmemW : ∀ v : ↥V, (v : G) ∈ (Subtype.val '' W : Set G) ↔ v ∈ W := by
    intro v
    constructor
    · rintro ⟨w, hw, hwv⟩
      rwa [← Subtype.ext hwv]
    · intro hv
      exact ⟨v, hv, rfl⟩
  rw [Subgroup.mem_set_normalizer_iff]
  constructor
  · intro H v
    rw [← hmemW, ← hmemW, hval]
    exact (H v).symm
  · intro H x
    by_cases hx : x ∈ V
    · have := H ⟨x, hx⟩
      rw [← hmemW, ← hmemW, hval] at this
      exact this.symm
    · have hx' : (p : G) * x * (p : G)⁻¹ ∉ V := fun h =>
        hx ((Subgroup.mem_normalizer_iff.mp hpV x).mpr h)
      constructor
      · rintro ⟨w, -, rfl⟩
        exact absurd w.2 hx
      · rintro ⟨w, -, hw⟩
        exact absurd (hw ▸ w.2) hx'

theorem mem_wSet_conj_iff {V : Type*} [CommGroup V] {S : Subgroup (MulAut V)} {Z : Subgroup V}
    (τ : MulAut V) (hS : ∀ s ∈ S, τ * s * τ⁻¹ ∈ S ∧ τ⁻¹ * s * τ ∈ S)
    (hZ : ∀ z ∈ Z, τ z ∈ Z ∧ τ⁻¹ z ∈ Z) (v : V) :
    τ v ∈ Point.wSet S Z ↔ v ∈ Point.wSet S Z := by
  have hτ : ∀ v, v ∈ Point.wSet S Z → τ v ∈ Point.wSet S Z := by
    intro v hv s hs
    have h1 := hv _ (hS s hs).2
    have e : s (τ v) * (τ v)⁻¹ = τ ((τ⁻¹ * s * τ) v * v⁻¹) := by
      rw [map_mul, map_inv, MulAut.mul_apply, MulAut.mul_apply, MulAut.apply_inv_self]
    rw [e]
    exact (hZ _ h1).1
  have hτ' : ∀ v, v ∈ Point.wSet S Z → τ⁻¹ v ∈ Point.wSet S Z := by
    intro v hv s hs
    have h1 := hv _ (hS s hs).1
    have e : s (τ⁻¹ v) * (τ⁻¹ v)⁻¹ = τ⁻¹ ((τ * s * τ⁻¹) v * v⁻¹) := by
      rw [map_mul, map_inv, MulAut.mul_apply, MulAut.mul_apply, MulAut.inv_apply_self]
    rw [e]
    exact (hZ _ h1).2
  refine ⟨fun h => ?_, hτ v⟩
  have := hτ' _ h
  rwa [MulAut.inv_apply_self] at this

