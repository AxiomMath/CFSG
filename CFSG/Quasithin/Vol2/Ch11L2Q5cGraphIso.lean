theorem isCoatom_comap_of_surjective {A B : Type*} [Group A] [Group B] {f : A →* B}
    (hf : Function.Surjective f) {P : Subgroup B} (hP : IsCoatom P) : IsCoatom (P.comap f) := by
  refine ⟨fun h => hP.1 ?_, fun Q hQ => ?_⟩
  · rw [← Subgroup.map_comap_eq_self_of_surjective hf P, h, ← MonoidHom.range_eq_map,
      MonoidHom.range_eq_top.mpr hf]
  · have hle : P ≤ Q.map f := by
      rw [← Subgroup.map_comap_eq_self_of_surjective hf P]
      exact Subgroup.map_mono hQ.le
    rcases eq_or_lt_of_le hle with h | h
    · exfalso
      have : Q ≤ P.comap f := by
        rw [h]
        exact Subgroup.le_comap_map f Q
      exact absurd hQ (not_lt_of_ge this)
    · have htop := hP.2 _ h
      rw [eq_top_iff]
      intro x _
      have hx : f x ∈ Q.map f := by rw [htop]; trivial
      obtain ⟨q, hq, hqx⟩ := hx
      have hk : q⁻¹ * x ∈ P.comap f := by
        rw [Subgroup.mem_comap, map_mul, map_inv, hqx, inv_mul_cancel]
        exact P.one_mem
      have := Q.mul_mem hq (hQ.le hk)
      simpa using this

theorem normalizer_sup_le_of_le_center {X : Type} [Group X] [Finite X] {S₁ : Subgroup X}
    (hS₁ : IsSylowTwoOf S₁ ⊤) {C : Subgroup X} (hC : C ≤ Subgroup.center X) :
    Subgroup.normalizer ((S₁ ⊔ C : Subgroup X) : Set X) ≤ Subgroup.normalizer (S₁ : Set X) := by
  intro x hx
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set R : Subgroup X := S₁ ⊔ C with hR
  have hSR : S₁ ≤ R := le_sup_left
  have hRN : R ≤ Subgroup.normalizer (S₁ : Set X) :=
    sup_le Subgroup.le_normalizer (hC.trans (Subgroup.center_le_normalizer _))
  have hnorm : (S₁.subgroupOf R).Normal := (Subgroup.normal_subgroupOf_iff_le_normalizer hSR).2 hRN
  have hP2 : IsPGroup 2 (S₁.subgroupOf R) :=
    hS₁.2.1.of_equiv (Subgroup.subgroupOfEquivOfLe hSR).symm
  have hodd : ¬ 2 ∣ (S₁.subgroupOf R).index := by
    intro hd
    have h1 : (S₁.subgroupOf R).index = S₁.relIndex R := rfl
    have h2 : S₁.relIndex R ∣ S₁.index := Subgroup.relIndex_dvd_index_of_le hSR
    have h3 : (S₁.subgroupOf ⊤).index = S₁.index := Subgroup.relIndex_top_right S₁
    exact hS₁.2.2 (by rw [h3]; exact (h1 ▸ hd).trans h2)
  let P : Sylow 2 ↥R := hP2.toSylow hodd
  have hPn : P.Normal := hnorm
  have hchar := Sylow.characteristic_of_normal P hPn
  let e : ↥R ≃* ↥R := R.normalizerMonoidHom ⟨x, hx⟩
  have hfix := hchar.fixed e
  rw [Subgroup.mem_normalizer_iff]
  intro y
  have hxR : ∀ z : X, x * z * x⁻¹ ∈ R ↔ z ∈ R := fun z => by
    simpa using (Subgroup.mem_normalizer_iff.mp hx z).symm
  constructor
  · intro hy
    have hyR : y ∈ R := hSR hy
    have h1 : (⟨y, hyR⟩ : ↥R) ∈ (P : Subgroup ↥R) := hy
    have h2 : (⟨y, hyR⟩ : ↥R) ∈ (P : Subgroup ↥R).comap e.toMonoidHom := by
      rw [hfix]
      exact h1
    exact h2
  · intro hy
    have hyR : y ∈ R := (hxR y).1 (hSR hy)
    have h2 : (⟨y, hyR⟩ : ↥R) ∈ (P : Subgroup ↥R).comap e.toMonoidHom := hy
    rw [hfix] at h2
    exact h2

open CFSG.Timmesfeld.Orders in
theorem ordA_two_ne_ordG2_pow {f g : ℕ} (hf : 1 ≤ f) (hg : 1 ≤ g) :
    ordA 2 (2 ^ f) ≠ ordG2 (2 ^ g) := by
  intro h
  have hG : Profile (ordA 2 (2 ^ f)) (g * 6) (zG2 g) := by
    rw [h]
    exact profile_ordG2 hg
  have hN : f * 3 = g * 6 := ((profile_ordA (n := 2) (by norm_num) hf).transfer hG).1
  have hf2 : f = 2 * g := by omega
  subst hf2
  have hdvd : Nat.gcd 3 (2 ^ (2 * g) - 1) ∣
      (2 ^ (2 * g)) ^ 3 * (((2 ^ (2 * g)) ^ 2 - 1) * ((2 ^ (2 * g)) ^ 3 - 1)) :=
    ((Nat.gcd_dvd_right 3 _).trans (Nat.sub_one_dvd_pow_sub_one (2 ^ (2 * g)) 2)).trans
      ((dvd_mul_right _ _).trans (dvd_mul_left _ _))
  have hA : ordA 2 (2 ^ (2 * g)) =
      (2 ^ (2 * g)) ^ 3 * (((2 ^ (2 * g)) ^ 2 - 1) * ((2 ^ (2 * g)) ^ 3 - 1)) /
        Nat.gcd 3 (2 ^ (2 * g) - 1) := by
    unfold ordA
    rw [show Finset.Icc 2 (2 + 1) = {2, 3} by decide, Finset.prod_pair (by norm_num)]
  have h3 : Nat.gcd 3 (2 ^ (2 * g) - 1) = 3 := by
    refine Nat.gcd_eq_left ?_
    rw [pow_mul]
    exact Nat.sub_one_dvd_pow_sub_one (2 ^ 2) g
  rw [h3] at hA hdvd
  have hX : ordA 2 (2 ^ (2 * g)) * 3 =
      (2 ^ (2 * g)) ^ 3 * (((2 ^ (2 * g)) ^ 2 - 1) * ((2 ^ (2 * g)) ^ 3 - 1)) := by
    rw [hA]
    exact Nat.div_mul_cancel hdvd
  rw [pow_mul'] at hX h
  have hq : 2 ≤ 2 ^ g := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ g := Nat.pow_le_pow_right (by norm_num) hg
  rw [h, ordG2_eq, pow_mul] at hX
  generalize 2 ^ g = q at hX hq
  have h6 : q ^ 6 = (q ^ 2) ^ 3 := by ring
  rw [h6] at hX
  have hu : 4 ≤ q ^ 2 := by nlinarith
  generalize q ^ 2 = u at hX hu
  have h1 : 1 ≤ u := by omega
  have h2 : 1 ≤ u ^ 2 := Nat.one_le_pow _ _ (by omega)
  have h3' : 1 ≤ u ^ 3 := Nat.one_le_pow _ _ (by omega)
  zify [h1, h2, h3'] at hX
  have hu' : (4 : ℤ) ≤ u := by exact_mod_cast hu
  have hu3 : (64 : ℤ) ≤ (u : ℤ) ^ 3 := by
    have := pow_le_pow_left₀ (by norm_num) hu' 3
    norm_num at this
    exact this
  have hP : (u : ℤ) ^ 3 * ((u : ℤ) ^ 3 - 1) * ((u : ℤ) - 1) ≠ 0 :=
    mul_ne_zero (mul_ne_zero (by positivity) (by linarith)) (by linarith)
  have e : ((u : ℤ) ^ 3 * ((u : ℤ) ^ 3 - 1) * ((u : ℤ) - 1)) * 3 =
      ((u : ℤ) ^ 3 * ((u : ℤ) ^ 3 - 1) * ((u : ℤ) - 1)) * ((u : ℤ) + 1) := by
    linear_combination hX
  have := mul_left_cancel₀ hP e
  linarith

variable {G : Type} [Group G] [Finite G]

theorem sup_pCoreOf_eq_of_iso {K Kp : Subgroup G} (hKKp : K ≤ Kp)
    (he : Nonempty ((↥K ⧸ CFSG.pCore 2 ↥K) ≃* (↥Kp ⧸ CFSG.pCore 2 ↥Kp))) :
    K ⊔ pCoreOf 2 Kp = Kp ∧ K ⊓ pCoreOf 2 Kp = pCoreOf 2 K := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨e⟩ := he
  set N := pCoreOf 2 Kp with hN
  have hKN : K ⊓ N ≤ pCoreOf 2 K := by
    refine CFSG.LieType.BorelTits.le_pCoreOf_of_le_normalizer 2 inf_le_left ?_
      ((pCoreOf_isPGroup 2 Kp).to_le inf_le_right)
    exact le_inf Subgroup.le_normalizer
      (hKKp.trans (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 Kp)) |>.trans
      Subgroup.inf_normalizer_le_normalizer_inf
  set N' : Subgroup ↥Kp := CFSG.pCore 2 ↥Kp with hN'
  set φ : ↥K →* ↥Kp ⧸ N' := (QuotientGroup.mk' N').comp (Subgroup.inclusion hKKp) with hφ
  have hker : ∀ k : ↥K, k ∈ φ.ker ↔ (k : G) ∈ N := by
    intro k
    rw [MonoidHom.mem_ker, hφ, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
      QuotientGroup.eq_one_iff, hN, pCoreOf, hN']
    constructor
    · intro h
      exact ⟨_, h, rfl⟩
    · rintro ⟨y, hy, hyk⟩
      have : y = Subgroup.inclusion hKKp k := Subtype.ext hyk
      rwa [← this]
  have hcardker : Nat.card φ.ker ≤ Nat.card (CFSG.pCore 2 ↥K) := by
    have hle : φ.ker ≤ CFSG.pCore 2 ↥K := by
      intro k hk
      have h1 : (k : G) ∈ pCoreOf 2 K := hKN ⟨k.2, (hker k).mp hk⟩
      rw [pCoreOf] at h1
      obtain ⟨y, hy, hyk⟩ := h1
      have : y = k := Subtype.ext hyk
      rwa [← this]
    exact Subgroup.card_le_of_le hle
  have hK := (CFSG.pCore 2 ↥K).card_eq_card_quotient_mul_card_subgroup
  have hKp := N'.card_eq_card_quotient_mul_card_subgroup
  have hcq : Nat.card (↥K ⧸ CFSG.pCore 2 ↥K) = Nat.card (↥Kp ⧸ N') := Nat.card_congr e.toEquiv
  have hrk := φ.ker.card_eq_card_quotient_mul_card_subgroup
  have hrange : Nat.card (↥K ⧸ φ.ker) = Nat.card φ.range :=
    Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv
  have hpos : 0 < Nat.card (CFSG.pCore 2 ↥K) := Nat.card_pos
  have hposk : 0 < Nat.card φ.ker := Nat.card_pos
  have hge : Nat.card (↥Kp ⧸ N') ≤ Nat.card φ.range := by
    rw [← hrange, ← hcq]
    have h1 : Nat.card (↥K ⧸ CFSG.pCore 2 ↥K) * Nat.card (CFSG.pCore 2 ↥K) ≤
        Nat.card (↥K ⧸ φ.ker) * Nat.card (CFSG.pCore 2 ↥K) := by
      rw [← hK, hrk]
      exact Nat.mul_le_mul_left _ hcardker
    exact Nat.le_of_mul_le_mul_right h1 hpos
  have htop : φ.range = ⊤ :=
    Subgroup.eq_top_of_card_eq _ (le_antisymm (Subgroup.card_le_card_group _) hge)
  have hcardeq : Nat.card φ.ker = Nat.card (CFSG.pCore 2 ↥K) := by
    refine le_antisymm hcardker ?_
    have h1 : Nat.card φ.range ≤ Nat.card (↥Kp ⧸ N') := Subgroup.card_le_card_group _
    rw [← hrange, ← hcq] at h1
    have h2 : Nat.card (↥K ⧸ φ.ker) * Nat.card (CFSG.pCore 2 ↥K) ≤
        Nat.card (↥K ⧸ φ.ker) * Nat.card φ.ker := by
      calc Nat.card (↥K ⧸ φ.ker) * Nat.card (CFSG.pCore 2 ↥K)
          ≤ Nat.card (↥K ⧸ CFSG.pCore 2 ↥K) * Nat.card (CFSG.pCore 2 ↥K) :=
            Nat.mul_le_mul_right _ h1
        _ = Nat.card (↥K ⧸ φ.ker) * Nat.card φ.ker := by rw [← hK, hrk]
    exact Nat.le_of_mul_le_mul_left h2 Nat.card_pos
  refine ⟨le_antisymm (sup_le hKKp (pCoreOf_le 2 Kp)) ?_, ?_⟩
  · intro x hx
    have hmem : (QuotientGroup.mk' N' ⟨x, hx⟩ : ↥Kp ⧸ N') ∈ φ.range := by rw [htop]; trivial
    obtain ⟨k, hk⟩ := hmem
    have h1 : (Subgroup.inclusion hKKp k)⁻¹ * ⟨x, hx⟩ ∈ N' := by
      rw [← QuotientGroup.eq]
      exact hk
    have h2 : ((Subgroup.inclusion hKKp k)⁻¹ * ⟨x, hx⟩ : ↥Kp).1 ∈ N := by
      rw [hN, pCoreOf]
      exact ⟨_, h1, rfl⟩
    have e2 : x = (k : G) * ((Subgroup.inclusion hKKp k)⁻¹ * ⟨x, hx⟩ : ↥Kp).1 := by
      simp
    rw [e2]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_left k.2) (Subgroup.mem_sup_right h2)
  · refine le_antisymm hKN ?_
    have hle : (φ.ker).map K.subtype ≤ K ⊓ N := by
      rintro _ ⟨k, hk, rfl⟩
      exact ⟨k.2, (hker k).mp hk⟩
    have hc1 : Nat.card ((φ.ker).map K.subtype) = Nat.card (CFSG.pCore 2 ↥K) := by
      rw [Subgroup.card_map_of_injective K.subtype_injective, hcardeq]
    have hc2 : Nat.card (pCoreOf 2 K) = Nat.card (CFSG.pCore 2 ↥K) := by
      rw [pCoreOf, Subgroup.card_map_of_injective K.subtype_injective]
    have h1 : Nat.card (pCoreOf 2 K) ≤ Nat.card ↥(K ⊓ N) := by
      rw [hc2, ← hc1]
      exact Subgroup.card_le_of_le hle
    have := Subgroup.eq_of_le_of_card_ge hKN h1
    rw [this]

