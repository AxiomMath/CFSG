variable {K : Type} [Field K]

local notation "𝔅" => Matrix.toBilin' (spJ K)

@[expose] def stabSp (p : Fin 2 ⊕ Fin 2 → K) : Subgroup ↥(StatedSp 2 K) where
  carrier := {γ | mat 2 K γ *ᵥ p = p}
  mul_mem' := fun {a b} (ha : mat 2 K a *ᵥ p = p) (hb : mat 2 K b *ᵥ p = p) =>
    show mat 2 K (a * b) *ᵥ p = p by rw [map_mul, ← Matrix.mulVec_mulVec, hb, ha]
  one_mem' := show mat 2 K 1 *ᵥ p = p by rw [map_one, Matrix.one_mulVec]
  inv_mem' := fun {a} (ha : mat 2 K a *ᵥ p = p) =>
    show mat 2 K a⁻¹ *ᵥ p = p by
      conv_lhs => rw [← ha]
      exact mat_inv_mulVec a p

theorem mem_stabSp {p : Fin 2 ⊕ Fin 2 → K} {γ : ↥(StatedSp 2 K)} :
    γ ∈ stabSp p ↔ mat 2 K γ *ᵥ p = p :=
  Iff.rfl

theorem conjSubgroup_stabSp (u : Fin 2 ⊕ Fin 2 → K) (δ : ↥(StatedSp 2 K)) :
    conjSubgroup (stabSp u) δ = stabSp (mat 2 K δ⁻¹ *ᵥ u) := by
  ext γ
  rw [mem_conjSubgroup_iff, mem_stabSp, mem_stabSp, map_mul, map_mul, ← Matrix.mulVec_mulVec,
    ← Matrix.mulVec_mulVec]
  constructor
  · intro h
    calc mat 2 K γ *ᵥ (mat 2 K δ⁻¹ *ᵥ u) =
        mat 2 K δ⁻¹ *ᵥ (mat 2 K δ *ᵥ (mat 2 K γ *ᵥ (mat 2 K δ⁻¹ *ᵥ u))) :=
          (mat_inv_mulVec δ _).symm
      _ = mat 2 K δ⁻¹ *ᵥ u := by rw [h]
  · intro h
    rw [h, mat_mulVec_inv]

theorem trv_mem_stabSp {u d : Fin 2 ⊕ Fin 2 → K} (h : 𝔅 u d = 0) (c : K) :
    SecB.K7.trv d c ∈ stabSp u := by
  rw [mem_stabSp, SecB.K7.trv_mulVec, h, mul_zero, zero_smul, add_zero]

theorem trv_sub_mulVec {x y : Fin 2 ⊕ Fin 2 → K} (hxy : 𝔅 x y ≠ 0) :
    mat 2 K (SecB.K7.trv (y - x) (𝔅 x y)⁻¹) *ᵥ x = y := by
  rw [SecB.K7.trv_mulVec, map_sub, SecB.K7.bil_self, sub_zero, inv_mul_cancel₀ hxy, one_smul,
    add_sub_cancel]

variable [CharP K 2]

theorem exists_stabSp_mulVec_eq {u x y : Fin 2 ⊕ Fin 2 → K} (hxy : 𝔅 u x = 𝔅 u y)
    (hx : 𝔅 u x ≠ 0) : ∃ γ ∈ stabSp u, mat 2 K γ *ᵥ x = y := by
  by_cases h : 𝔅 x y = 0
  · have hxz : 𝔅 x (y + u) ≠ 0 := by
      rwa [map_add, h, zero_add, SecB.K7.bil_comm]
    have hzy : 𝔅 (y + u) y ≠ 0 := by
      rwa [SecB.K7.bil_add_left, SecB.K7.bil_self, zero_add, ← hxy]
    refine ⟨SecB.K7.trv (y - (y + u)) (𝔅 (y + u) y)⁻¹ *
      SecB.K7.trv (y + u - x) (𝔅 x (y + u))⁻¹,
      Subgroup.mul_mem _ (trv_mem_stabSp ?_ _) (trv_mem_stabSp ?_ _), ?_⟩
    · rw [map_sub, map_add, SecB.K7.bil_self, add_zero, sub_self]
    · rw [map_sub, map_add, SecB.K7.bil_self, add_zero, hxy, sub_self]
    · rw [map_mul, ← Matrix.mulVec_mulVec, trv_sub_mulVec hxz, trv_sub_mulVec hzy]
  · exact ⟨SecB.K7.trv (y - x) (𝔅 x y)⁻¹,
      trv_mem_stabSp (by rw [map_sub, hxy, sub_self]) _, trv_sub_mulVec h⟩

omit [CharP K 2] in
theorem exists_orth_ne {p q : Fin 2 ⊕ Fin 2 → K} (hp : p ≠ 0) (hq : ∀ c : K, q ≠ c • p) :
    ∃ z, 𝔅 p z = 0 ∧ 𝔅 q z ≠ 0 := by
  by_contra hcon
  push Not at hcon
  obtain ⟨y₀, hy₀⟩ : ∃ y, 𝔅 p y ≠ 0 := by
    by_contra h
    push Not at h
    exact hp (toBilin'_spJ_nondegenerate.1 p h)
  apply hq (𝔅 q y₀ / 𝔅 p y₀)
  refine sub_eq_zero.mp (toBilin'_spJ_nondegenerate.1 _ fun z => ?_)
  have hz := hcon (z - (𝔅 p z / 𝔅 p y₀) • y₀) (by
    rw [map_sub, map_smul, smul_eq_mul, div_mul_cancel₀ _ hy₀, sub_self])
  rw [map_sub, map_smul, smul_eq_mul] at hz
  rw [show q - (𝔅 q y₀ / 𝔅 p y₀) • p = q + (-(𝔅 q y₀ / 𝔅 p y₀)) • p by
    rw [neg_smul, sub_eq_add_neg], SecB.K7.bil_add_left, SecB.K7.bil_smul_left]
  linear_combination hz

theorem exists_mulVec_eq_of_bil_ne {H : Subgroup ↥(StatedSp 2 K)} {p q : Fin 2 ⊕ Fin 2 → K}
    (hpH : stabSp p ≤ H) (hqH : stabSp q ≤ H) (hqp : 𝔅 q p ≠ 0) {v : Fin 2 ⊕ Fin 2 → K}
    (hv : v ≠ 0) : ∃ h ∈ H, mat 2 K h *ᵥ p = v := by
  have hpq : 𝔅 p q ≠ 0 := by rwa [SecB.K7.bil_comm]
  have hi : ∀ w, 𝔅 p w ≠ 0 → ∃ h ∈ H, mat 2 K h *ᵥ p = w := by
    intro w hw
    have hqx : 𝔅 q p = 𝔅 q (p + (𝔅 p w / 𝔅 p q) • q) := by
      rw [SecB.K7.bil_add_right, SecB.K7.bil_smul_right, SecB.K7.bil_self, mul_zero, add_zero]
    have hpx : 𝔅 p (p + (𝔅 p w / 𝔅 p q) • q) = 𝔅 p w := by
      rw [SecB.K7.bil_add_right, SecB.K7.bil_smul_right, SecB.K7.bil_self, zero_add,
        div_mul_cancel₀ _ hpq]
    obtain ⟨γ₂, hγ₂, hγ₂x⟩ := exists_stabSp_mulVec_eq hqx hqp
    obtain ⟨γ₁, hγ₁, hγ₁w⟩ := exists_stabSp_mulVec_eq hpx (by rw [hpx]; exact hw)
    exact ⟨γ₁ * γ₂, H.mul_mem (hpH hγ₁) (hqH hγ₂), by
      rw [map_mul, ← Matrix.mulVec_mulVec, hγ₂x, hγ₁w]⟩
  by_cases hpv : 𝔅 p v = 0
  · by_cases hqv : 𝔅 q v = 0
    ·
      obtain ⟨y, hy⟩ : ∃ y, 𝔅 v y ≠ 0 := by
        by_contra h
        push Not at h
        exact hv (toBilin'_spJ_nondegenerate.1 v h)
      have hvp : 𝔅 v p = 0 := by rw [SecB.K7.bil_comm]; exact hpv
      have hvq : 𝔅 v q = 0 := by rw [SecB.K7.bil_comm]; exact hqv
      have hqd : 𝔅 q (y + (-(𝔅 q y / 𝔅 q p)) • p + ((1 - 𝔅 p y) / 𝔅 p q) • q) = 0 := by
        rw [SecB.K7.bil_add_right, SecB.K7.bil_add_right, SecB.K7.bil_smul_right,
          SecB.K7.bil_smul_right, SecB.K7.bil_self, mul_zero, add_zero, neg_mul,
          div_mul_cancel₀ _ hqp, add_neg_cancel]
      have hvd : 𝔅 v (y + (-(𝔅 q y / 𝔅 q p)) • p + ((1 - 𝔅 p y) / 𝔅 p q) • q) = 𝔅 v y := by
        rw [SecB.K7.bil_add_right, SecB.K7.bil_add_right, SecB.K7.bil_smul_right,
          SecB.K7.bil_smul_right, hvp, hvq, mul_zero, mul_zero, add_zero, add_zero]
      have hpd : 𝔅 p (y + (-(𝔅 q y / 𝔅 q p)) • p + ((1 - 𝔅 p y) / 𝔅 p q) • q) = 1 := by
        rw [SecB.K7.bil_add_right, SecB.K7.bil_add_right, SecB.K7.bil_smul_right,
          SecB.K7.bil_smul_right, SecB.K7.bil_self, mul_zero, add_zero, div_mul_cancel₀ _ hpq]
        ring
      set d := y + (-(𝔅 q y / 𝔅 q p)) • p + ((1 - 𝔅 p y) / 𝔅 p q) • q with hd
      have hτ : SecB.K7.trv d 1 ∈ stabSp q := trv_mem_stabSp hqd 1
      have hv' : mat 2 K (SecB.K7.trv d 1) *ᵥ v = v + (𝔅 v d) • d := by
        rw [SecB.K7.trv_mulVec, one_mul]
      have hpv' : 𝔅 p (v + (𝔅 v d) • d) ≠ 0 := by
        rw [SecB.K7.bil_add_right, SecB.K7.bil_smul_right, hpv, zero_add, hpd, mul_one, hvd]
        exact hy
      obtain ⟨h', hh', hh'p⟩ := hi _ hpv'
      refine ⟨(SecB.K7.trv d 1)⁻¹ * h', H.mul_mem (H.inv_mem (hqH hτ)) hh', ?_⟩
      rw [map_mul, ← Matrix.mulVec_mulVec, hh'p, ← hv', mat_inv_mulVec]
    ·
      have hqv' : 𝔅 q v = 𝔅 q (v + q) := by
        rw [SecB.K7.bil_add_right, SecB.K7.bil_self, add_zero]
      obtain ⟨γ, hγ, hγv⟩ := exists_stabSp_mulVec_eq hqv' hqv
      have hpv' : 𝔅 p (v + q) ≠ 0 := by rwa [SecB.K7.bil_add_right, hpv, zero_add]
      obtain ⟨h', hh', hh'p⟩ := hi _ hpv'
      refine ⟨γ⁻¹ * h', H.mul_mem (H.inv_mem (hqH hγ)) hh', ?_⟩
      rw [map_mul, ← Matrix.mulVec_mulVec, hh'p, ← hγv, mat_inv_mulVec]
  · exact hi v hpv

theorem sup_stabSp_eq_top {p₁ p₂ : Fin 2 ⊕ Fin 2 → K} (hp₁ : p₁ ≠ 0) (hp₂ : p₂ ≠ 0)
    (h12 : ∀ c : K, p₂ ≠ c • p₁) : stabSp p₁ ⊔ stabSp p₂ = ⊤ := by
  have htr : ∀ v, v ≠ 0 → ∃ h ∈ stabSp p₁ ⊔ stabSp p₂, mat 2 K h *ᵥ p₁ = v := by
    by_cases h21 : 𝔅 p₂ p₁ = 0
    · have h21' : ∀ c : K, p₁ ≠ c • p₂ := fun c h => by
        have hc : c ≠ 0 := by
          rintro rfl
          rw [zero_smul] at h
          exact hp₁ h
        exact h12 c⁻¹ (by rw [h, smul_smul, inv_mul_cancel₀ hc, one_smul])
      obtain ⟨d, hd2, hd1⟩ := exists_orth_ne hp₂ h21'
      obtain ⟨τ, hτH, hτp⟩ : ∃ τ ∈ stabSp p₁ ⊔ stabSp p₂,
          mat 2 K τ *ᵥ p₁ = p₁ + (𝔅 p₁ d) • d :=
        ⟨SecB.K7.trv d 1, Subgroup.mem_sup_right (trv_mem_stabSp hd2 1), by
          rw [SecB.K7.trv_mulVec, one_mul]⟩
      have h31 : 𝔅 (p₁ + (𝔅 p₁ d) • d) p₁ ≠ 0 := by
        rw [SecB.K7.bil_add_left, SecB.K7.bil_self, zero_add, SecB.K7.bil_smul_left,
          SecB.K7.bil_comm d p₁]
        exact mul_ne_zero hd1 hd1
      have h3H : stabSp (p₁ + (𝔅 p₁ d) • d) ≤ stabSp p₁ ⊔ stabSp p₂ := fun γ hγ => by
        have hc : τ⁻¹ * γ * τ ∈ stabSp p₁ := by
          rw [mem_stabSp, map_mul, map_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hτp,
            mem_stabSp.mp hγ, ← hτp, mat_inv_mulVec]
        have h := Subgroup.mul_mem _ (Subgroup.mul_mem _ hτH (Subgroup.mem_sup_left hc))
          (Subgroup.inv_mem _ hτH)
        rwa [show τ * (τ⁻¹ * γ * τ) * τ⁻¹ = γ by group] at h
      exact fun v hv => exists_mulVec_eq_of_bil_ne le_sup_left h3H h31 hv
    · exact fun v hv => exists_mulVec_eq_of_bil_ne le_sup_left le_sup_right h21 hv
  rw [eq_top_iff]
  intro A _
  obtain ⟨h, hh, hhA⟩ := htr (mat 2 K A *ᵥ p₁) fun h0 => hp₁ (by
    rw [← mat_inv_mulVec A p₁, h0, Matrix.mulVec_zero])
  have hs : h⁻¹ * A ∈ stabSp p₁ := by
    rw [mem_stabSp, map_mul, ← Matrix.mulVec_mulVec, ← hhA, mat_inv_mulVec]
  have h1 := Subgroup.mul_mem _ hh (Subgroup.mem_sup_left hs)
  rwa [mul_inv_cancel_left] at h1

