    refine isConj_iff.2 ⟨e.symm c, ?_⟩
    apply e.injective
    simpa only [map_mul, map_inv, MulEquiv.apply_symm_apply] using hc
  · intro y _ hy
    exact hfix S hS y (fun b hb => hy b (Subgroup.le_normalizer hb))
  · intro y _ hy
    exact hfix S hS y (fun b hb => hy b (L32_mem_centralizer_inf S hb))

