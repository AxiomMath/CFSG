variable {G : Type} [Group G] [Finite G]

private theorem commute_images_N1a {H Y Y' : Subgroup G} (hY : Y ∈ cComp H) (hY' : Y' ∈ cComp H)
    (hne : Y ≠ Y') {u v : ↥H} (hu : u ∈ Y.subgroupOf H) (hv : v ∈ Y'.subgroupOf H) :
    Commute (QuotientGroup.mk' (CFSG.solvableRadical ↥H) u)
      (QuotientGroup.mk' (CFSG.solvableRadical ↥H) v) := by
  have h1 := Subgroup.commutator_mem_commutator
    (Subgroup.mem_map_of_mem (QuotientGroup.mk' (CFSG.solvableRadical ↥H)) hu)
    (Subgroup.mem_map_of_mem (QuotientGroup.mk' (CFSG.solvableRadical ↥H)) hv)
  rw [cComp_ne_map_commutator_eq_bot hY hY' hne, Subgroup.mem_bot] at h1
  exact commutatorElement_eq_one_iff_mul_comm.mp h1

private theorem two_le_pRank_top_N1a {B : Type} [Group B] [Finite B] {x z : B}
    (hx : orderOf x = 5) (hz : orderOf z = 5) (hxz : Commute x z)
    (hzx : z ∉ Subgroup.zpowers x) : 2 ≤ CFSG.Open.pRank 5 (⊤ : Subgroup B) := by
  have h5x : x ^ 5 = 1 := by rw [← hx]; exact pow_orderOf_eq_one x
  have h5z : z ^ 5 = 1 := by rw [← hz]; exact pow_orderOf_eq_one z
  have hE : CFSG.Open.IsElemAbelian 5 (Subgroup.zpowers x) := by
    refine ⟨inferInstance, fun y hy => ?_⟩
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, h5x, one_zpow]
  have hcard : Nat.card (Subgroup.zpowers x) = 5 ^ 1 := by
    rw [Nat.card_zpowers, hx, pow_one]
  have hbc : ∀ e ∈ Subgroup.zpowers x, Commute e z := by
    intro e he
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp he
    exact hxz.zpow_left k
  exact succ_le_pRank_of_commute_828 (by norm_num : Nat.Prime 5) hE hcard hbc h5z hzx
    le_top (Subgroup.mem_top z)

private theorem not_mem_zpowers_N1a {H Y Y' : Subgroup G} (hY : Y ∈ cComp H) (hY' : Y' ∈ cComp H)
    (hne : Y ≠ Y') {a b y : ↥H} (ha : a ∈ Y.subgroupOf H) (hb : b ∈ Y'.subgroupOf H)
    (hao : orderOf (QuotientGroup.mk' (CFSG.solvableRadical ↥H) a) = 5)
    (hbo : orderOf (QuotientGroup.mk' (CFSG.solvableRadical ↥H) b) = 5)
    (hy : y ∈ Y.subgroupOf H)
    (hnc : QuotientGroup.mk' (CFSG.solvableRadical ↥H) a *
        QuotientGroup.mk' (CFSG.solvableRadical ↥H) y ≠
        QuotientGroup.mk' (CFSG.solvableRadical ↥H) y *
        QuotientGroup.mk' (CFSG.solvableRadical ↥H) a) :
    QuotientGroup.mk' (CFSG.solvableRadical ↥H) b ∉
      Subgroup.zpowers (QuotientGroup.mk' (CFSG.solvableRadical ↥H) a) := by
  intro hbmem
  have hle : Subgroup.zpowers (QuotientGroup.mk' (CFSG.solvableRadical ↥H) b) ≤
      Subgroup.zpowers (QuotientGroup.mk' (CFSG.solvableRadical ↥H) a) :=
    Subgroup.zpowers_le.mpr hbmem
  have hcard : Nat.card (Subgroup.zpowers (QuotientGroup.mk' (CFSG.solvableRadical ↥H) a)) =
      Nat.card (Subgroup.zpowers (QuotientGroup.mk' (CFSG.solvableRadical ↥H) b)) := by
    rw [Nat.card_zpowers, Nat.card_zpowers, hao, hbo]
  have heq := Subgroup.eq_of_le_of_card_ge hle hcard.le
  have hamem : QuotientGroup.mk' (CFSG.solvableRadical ↥H) a ∈
      Subgroup.zpowers (QuotientGroup.mk' (CFSG.solvableRadical ↥H) b) := by
    rw [heq]
    exact Subgroup.mem_zpowers _
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hamem
  have hc := commute_images_N1a hY hY' hne hy (zpow_mem hb k)
  rw [map_zpow, hk] at hc
  exact hnc hc.symm

private theorem exists_elemAbelian_sq_N1a {A B : Type} [Group A] [Finite A] [Group B] [Finite B]
    (f : A →* B) (hf : Function.Surjective f)
    (hk : 2 ≤ CFSG.Open.pRank 5 (⊤ : Subgroup B)) :
    ∃ S : Subgroup A, CFSG.Open.IsElemAbelian 5 S ∧ Nat.card S = 5 ^ 2 := by
  have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  obtain ⟨E, -, hE, hEcard⟩ :=
    CFSG.SectionRank.exists_pRank (p := 5) (by norm_num) (⊤ : Subgroup B)
  have hEp : IsPGroup 5 ↥E := IsPGroup.iff_card.mpr ⟨_, hEcard⟩
  obtain ⟨Q, hEQ⟩ := IsPGroup.exists_le_sylow hEp
  obtain ⟨P, hP⟩ := Sylow.mapSurjective_surjective hf 5 Q
  have hmap : (P : Subgroup A).map f = (Q : Subgroup B) := by
    rw [← Sylow.coe_mapSurjective hf P, hP]
  have hnc : ¬ IsCyclic (P : Subgroup A) := by
    intro hcyc
    have hQc : IsCyclic ((P : Subgroup A).map f) :=
      isCyclic_of_surjective (f.subgroupMap (P : Subgroup A))
        (MonoidHom.subgroupMap_surjective f _)
    rw [hmap] at hQc
    have hEc : IsCyclic ↥E := Subgroup.isCyclic_of_le hEQ
    have hexp : Monoid.exponent ↥E ∣ 5 :=
      Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (fun x => Subtype.ext (by
        simpa using hE.2 (x : B) x.2))
    have hexp' : Monoid.exponent ↥E = Nat.card ↥E := IsCyclic.exponent_eq_card
    rw [hEcard] at hexp'
    have h1 : Monoid.exponent ↥E ≤ 5 := Nat.le_of_dvd (by norm_num) hexp
    have h2 : 5 ^ 2 ≤ 5 ^ CFSG.Open.pRank 5 (⊤ : Subgroup B) :=
      Nat.pow_le_pow_right (by norm_num) hk
    rw [← hexp'] at h2
    exact absurd (h2.trans h1) (by norm_num)
  haveI : Fact (IsPGroup 5 ↥(P : Subgroup A)) := ⟨P.isPGroup'⟩
  obtain ⟨S', -, hS'card, hS'el⟩ := CFSG.lemma_4_5_a (by norm_num : (5 : ℕ) ≠ 2) hnc
  have hS'e : CFSG.Open.IsElemAbelian 5 S' :=
    ⟨inferInstance, fun x hx => congrArg Subtype.val
      (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 5 S') ⟨x, hx⟩)⟩
  refine ⟨S'.map (P : Subgroup A).subtype,
    CFSG.SectionRank.isElemAbelian_map hS'e (P : Subgroup A).subtype, ?_⟩
  rw [Subgroup.card_map_of_injective (Subgroup.subtype_injective _), hS'card]

theorem s828N_two_le_pRank_five {H Y Y' : Subgroup G} (hY : Y ∈ cComp H) (hY' : Y' ∈ cComp H)
    (hne : Y ≠ Y')
    (ha : ∃ a ∈ Y.subgroupOf H,
      orderOf (QuotientGroup.mk' (CFSG.solvableRadical ↥H) a) = 5 ∧
      ∃ y ∈ Y.subgroupOf H, QuotientGroup.mk' (CFSG.solvableRadical ↥H) a *
        QuotientGroup.mk' (CFSG.solvableRadical ↥H) y ≠
        QuotientGroup.mk' (CFSG.solvableRadical ↥H) y *
        QuotientGroup.mk' (CFSG.solvableRadical ↥H) a)
    (hb : ∃ b ∈ Y'.subgroupOf H, orderOf (QuotientGroup.mk' (CFSG.solvableRadical ↥H) b) = 5) :
    2 ≤ CFSG.Open.pRank 5 H := by
  obtain ⟨a, ha, hao, y, hy, hnc⟩ := ha
  obtain ⟨b, hb, hbo⟩ := hb
  have h2 : 2 ≤ CFSG.Open.pRank 5 (⊤ : Subgroup (↥H ⧸ CFSG.solvableRadical ↥H)) :=
    two_le_pRank_top_N1a hao hbo (commute_images_N1a hY hY' hne ha hb)
      (not_mem_zpowers_N1a hY hY' hne ha hb hao hbo hy hnc)
  obtain ⟨S, hS, hScard⟩ :=
    exists_elemAbelian_sq_N1a (QuotientGroup.mk' (CFSG.solvableRadical ↥H))
      (QuotientGroup.mk'_surjective _) h2
  have hEel : CFSG.Open.IsElemAbelian 5 (S.map H.subtype) :=
    CFSG.SectionRank.isElemAbelian_map hS H.subtype
  have hEcard : Nat.card (S.map H.subtype) = 5 ^ 2 := by
    rw [Subgroup.card_map_of_injective H.subtype_injective, hScard]
  exact CFSG.SectionRank.le_pRank (by norm_num) (Subgroup.map_subtype_le S) hEel hEcard

end N1a

