  CFSG.Sporadic.HeldB.permOrId 100 hs100FiveLines[j]!

@[expose] def lineT (j : ℕ) : Table := toTable (linePerm j)

@[expose] def clA : Array Table × Array ℕ × Array ℕ := conjClosure 100 genArr genInvArr b0T 5775

@[expose] def clB : Array Table × Array ℕ × Array ℕ := conjClosure 100 genArr genInvArr rBT 15400

@[expose] def invs : List Table := clA.1.toList ++ clB.1.toList

@[expose] def invCovered (g : Table) : Bool :=
  !(tblEq 100 (compT 100 g g) (idT 100)) || tblEq 100 g (idT 100) || invs.any (tblEq 100 g)

@[expose] def permsOf (ws : List (List ℤ)) : List (Equiv.Perm (Fin 100)) :=
  ws.map fun w => tab (wordG gensG w)

@[expose] def tabsOf (ws : List (List ℤ)) : List Table := ws.map (wordT 100 gensT)

@[expose] def commOf (gs : List (Equiv.Perm (Fin 100))) (uv : List (List ℤ)) :
    Equiv.Perm (Fin 100) :=
  evalCodes gs (uv.getD 0 []) * evalCodes gs (uv.getD 1 []) * (evalCodes gs (uv.getD 0 []))⁻¹ *
    (evalCodes gs (uv.getD 1 []))⁻¹

