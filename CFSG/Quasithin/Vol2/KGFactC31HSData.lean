@[expose] def permA : Equiv.Perm (Fin 100) := CFSG.Sporadic.HeldB.permOrId 100 (hs100Arr 0)

@[expose] def permB : Equiv.Perm (Fin 100) := CFSG.Sporadic.HeldB.permOrId 100 (hs100Arr 1)

@[expose] def gensG : ℤ → Equiv.Perm (Fin 100) := fun l => if l = 1 then permA else permB

@[expose] def aT : Table := toTable permA

@[expose] def bT : Table := toTable permB

@[expose] def gensT : ℤ → Table := fun l => if l = 1 then aT else bT

@[expose] def genArr : Array Table := #[aT, bT]

@[expose] def genInvArr : Array Table := #[invT 100 aT, invT 100 bT]

@[expose] def permOK (t : Array ℕ) : Bool :=
  CFSG.Monster.B.Co2.Native.isInvA 100 t (CFSG.Monster.B.Co2.Native.invCand 100 t) &&
    CFSG.Monster.B.Co2.Native.isInvA 100 (CFSG.Monster.B.Co2.Native.invCand 100 t) t

