theorem false_of_overgroup_J4
    {K : Subgroup J} {a : ℕ} (ha : a = 2 ∨ a = 3) (hP0K : P0 ≤ K)
    (hK : Nat.card K = 11 ^ a * 2 ^ 21) : False := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Fact (Nat.Prime 11) := ⟨by norm_num⟩
  have hM := j4Facts.mat
  have hF := j4Facts
  have hEl := elem_uJ hM
  have hEP0 : Eg uJ 11 ≤ P0 := Eg_le_P0
  have hP0H : P0 ≤ Hj := P0_le_Hj
  have hEcard : Nat.card (Eg uJ 11) = 2 ^ 11 := card_Eg_uJ hM
  have hapos : 0 < a := by omega
  have hSkmem : ∀ x : K, x ∈ MulAction.stabilizer K basePt ↔ (x : J) ∈ Hj := fun x => by
    rw [MulAction.mem_stabilizer_iff, Subgroup.smul_def, smul_basePt_eq_self_iff]
  have hSkeq : MulAction.stabilizer K basePt = (Hj ⊓ K).subgroupOf K := by
    ext x
    rw [hSkmem, Subgroup.mem_subgroupOf, Subgroup.mem_inf]
    exact ⟨fun h => ⟨h, x.2⟩, fun h => h.1⟩
  have hSkcard : Nat.card (MulAction.stabilizer K basePt) = Nat.card ↥(Hj ⊓ K) := by
    rw [hSkeq]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe inf_le_right).toEquiv
  have hP0card : Nat.card P0 = 2 ^ 21 := card_P0 hM hF
  have hP0K' : P0 ≤ Hj ⊓ K := le_inf hP0H hP0K
  have hdvd : 2 ^ 21 ∣ Nat.card ↥(Hj ⊓ K) := hP0card ▸ Subgroup.card_dvd_of_le hP0K'
  have hHj : Nat.card Hj = 2 ^ 21 * 239085 := by rw [card_Hj hF]; norm_num
  obtain ⟨d, hd⟩ := hdvd
  have hdH : d ∣ 239085 := by
    have h1 : Nat.card ↥(Hj ⊓ K) ∣ Nat.card Hj := Subgroup.card_dvd_of_le inf_le_left
    rw [hd, hHj] at h1
    exact Nat.dvd_of_mul_dvd_mul_left (by positivity) h1
  have hdK : d ∣ 11 ^ a := by
    have h1 : Nat.card ↥(Hj ⊓ K) ∣ Nat.card K := Subgroup.card_dvd_of_le inf_le_right
    rw [hd, hK, mul_comm (11 ^ a)] at h1
    exact Nat.dvd_of_mul_dvd_mul_left (by positivity) h1
  obtain ⟨i, hi, hdi⟩ := (Nat.dvd_prime_pow (by norm_num : Nat.Prime 11)).1 hdK
  have hi1 : i ≤ 1 := by
    by_contra hcon
    have hdH' : 11 ^ i ∣ 239085 := by rw [← hdi]; exact hdH
    have h1 : 11 ^ 2 ∣ 11 ^ i := pow_dvd_pow 11 (by omega)
    have h2 : 11 ^ 2 ∣ 239085 := h1.trans hdH'
    norm_num at h2
  interval_cases i
  ·
    have hSk2 : Nat.card (MulAction.stabilizer K basePt) = 2 ^ 21 := by
      rw [hSkcard, hd, hdi]; norm_num
    have hSkp : IsPGroup 2 (MulAction.stabilizer K basePt) := IsPGroup.of_card hSk2
    have hSkidx : (MulAction.stabilizer K basePt).index = 11 ^ a := by
      have h1 := (MulAction.stabilizer K basePt).card_mul_index
      rw [hSk2, hK, mul_comm (11 ^ a)] at h1
      exact Nat.eq_of_mul_eq_mul_left (by positivity) h1
    have hEK : Eg uJ 11 ≤ K := hEP0.trans hP0K
    refine false_of_two_group_stabilizer (X := K) (Ω := J ⧸ Hj) basePt (p := 11) (a := a)
      (by norm_num) (by norm_num) hapos hSkp hSkidx ((Eg uJ 11).subgroupOf K) ?_ ?_ ?_ ?_
    · intro e he
      show (e : J) • basePt = basePt
      exact smul_basePt_eq_self_iff.mpr (Eg_le_Hj (Subgroup.mem_subgroupOf.mp he))
    · intro x hx y hy
      exact Subtype.ext (Eg_comm hEl (Subgroup.mem_subgroupOf.mp hx)
        (Subgroup.mem_subgroupOf.mp hy))
    · intro x hx
      exact Subtype.ext (Eg_sq hEl (Subgroup.mem_subgroupOf.mp hx))
    · intro x hx
      have h4 := four_le_ncard_orbit (g := (x : J)) hx
      have hset : {w : J ⧸ Hj | ∃ e ∈ (Eg uJ 11).subgroupOf K, e • (x • basePt) = w} =
          {w | ∃ e ∈ Eg uJ 11, e • ((x : J) • basePt) = w} := by
        ext w
        constructor
        · rintro ⟨e, he, rfl⟩
          exact ⟨e, Subgroup.mem_subgroupOf.mp he, rfl⟩
        · rintro ⟨e, he, rfl⟩
          exact ⟨⟨e, hEK he⟩, Subgroup.mem_subgroupOf.mpr he, rfl⟩
      rw [hset]
      exact h4
  ·
    have hK'card : Nat.card ↥(Hj ⊓ K) = 2 ^ 21 * 11 := by rw [hd, hdi]; norm_num
    have hEK' : Eg uJ 11 ≤ Hj ⊓ K := hEP0.trans hP0K'
    have hKimg : Nat.card (starImg (Hj ⊓ K)) = 2 ^ 10 * 11 := by
      have h := card_starImg_mul (inf_le_left : Hj ⊓ K ≤ Hj)
      rw [inf_eq_right.mpr hEK', hEcard, hK'card] at h
      exact Nat.eq_of_mul_eq_mul_right (by norm_num) (h.trans (by norm_num))
    have hTimg : Nat.card (starImg P0) = 2 ^ 10 := by
      have h := card_starImg_mul (P0_le_Hj : P0 ≤ Hj)
      rw [inf_eq_right.mpr hEP0, hEcard, hP0card] at h
      exact Nat.eq_of_mul_eq_mul_right (by norm_num) (h.trans (by norm_num))
    have hTK : starImg P0 ≤ starImg (Hj ⊓ K) := starImg_mono hP0K'
    have hM24 : Nat.card NativeSporadic.M24 = 2 ^ 10 * 239085 := by
      rw [CFSG.Sporadic.Mathieu.card_M24]; norm_num
    set T : Subgroup NativeSporadic.M24 := (starImg P0).subgroupOf NativeSporadic.M24 with hTdef
    set Y : Subgroup NativeSporadic.M24 :=
      (starImg (Hj ⊓ K)).subgroupOf NativeSporadic.M24 with hYdef
    have hTcard : Nat.card T = 2 ^ 10 := by
      rw [hTdef, Nat.card_congr (Subgroup.subgroupOfEquivOfLe (starImg_le P0)).toEquiv, hTimg]
    have hYcard : Nat.card Y = 2 ^ 10 * 11 := by
      rw [hYdef, Nat.card_congr (Subgroup.subgroupOfEquivOfLe (starImg_le (Hj ⊓ K))).toEquiv,
        hKimg]
    have hTp : IsPGroup 2 T := IsPGroup.of_card hTcard
    have hTi : ¬ 2 ∣ T.index := by
      have h1 := T.card_mul_index
      rw [hTcard, hM24] at h1
      have h2 : T.index = 239085 := by omega
      rw [h2]; norm_num
    have hTY : T ≤ Y := Subgroup.subgroupOf_mono NativeSporadic.M24 hTK
    rcases m24_overgroups (X := NativeSporadic.M24) ⟨MulEquiv.refl _⟩
      (isSylowTwoOf_top_of hTp hTi) hTY with htop | ⟨m, hm, hmc, -, -⟩
    · have h1 : Nat.card Y = Nat.card NativeSporadic.M24 := by
        rw [htop]
        exact Subgroup.card_top
      rw [hYcard, hM24] at h1
      omega
    · have hrows : ∀ m ∈ m24Mems, m.order ≠ 2 ^ 10 * 11 := by decide +kernel
      exact hrows m hm (hmc.symm.trans hYcard)

end CFSG.Quasithin.H13.NQCore
