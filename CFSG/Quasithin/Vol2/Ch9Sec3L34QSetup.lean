theorem F4_cases (x : F4) : x = f4 0 ∨ x = f4 1 ∨ x = f4 2 ∨ x = f4 3 := by
  obtain ⟨⟨n, hn⟩⟩ := x
  interval_cases n
  · left; rfl
  · right; left; rfl
  · right; right; left; rfl
  · right; right; right; rfl

theorem f4_ne {m n : ℕ} (hm : m < 4) (hn : n < 4) (h : m ≠ n) : f4 m ≠ f4 n := by
  intro he
  have := congrArg (fun x : F4 => x.code.val) he
  simp only [f4, Nat.mod_eq_of_lt hm, Nat.mod_eq_of_lt hn] at this
  exact h this

theorem mem_allF4 (x : F4) : x ∈ allF4 := by
  rcases F4_cases x with rfl | rfl | rfl | rfl <;> simp [allF4]

theorem mem_nzF4 {x : F4} (hx : x ≠ 0) : x ∈ nzF4 := by
  rcases F4_cases x with rfl | rfl | rfl | rfl
  · exact absurd rfl hx
  all_goals simp [nzF4]

theorem mem_params {a a' b1 b b2 : F4} (s t : Bool) (ha' : a' ≠ 0) (hb1 : b1 ≠ 0)
    (hb2 : b2 ≠ 0) : (⟨!![1, a; 0, a'], !![b1, b; 0, b2], s, t⟩ : Par) ∈ params := by
  unfold params
  simp only [List.mem_flatMap, List.mem_map]
  refine ⟨a, mem_allF4 a, a', mem_nzF4 ha', b1, mem_nzF4 hb1, b, mem_allF4 b, b2,
    mem_nzF4 hb2, s, ?_, t, ?_, rfl⟩ <;> cases s <;> cases t <;> simp

theorem F4_aut (σ : F4 ≃+* F4) : (∀ x, σ x = x) ∨ (∀ x, σ x = frob x) := by
  have h0 : σ (f4 0) = f4 0 := map_zero σ
  have h1 : σ (f4 1) = f4 1 := map_one σ
  have h3 : σ (f4 3) = σ (f4 2) + f4 1 := by
    rw [← h1, ← map_add]
    congr 1
  have hω : σ (f4 2) = f4 2 ∨ σ (f4 2) = f4 3 := by
    have h : σ (f4 2) * σ (f4 2) + σ (f4 2) + f4 1 = f4 0 := by
      rw [← h1, ← map_mul, ← map_add, ← map_add, ← h0]
      congr 1
    generalize σ (f4 2) = a at h ⊢
    rcases F4_cases a with rfl | rfl | rfl | rfl
    · have e : f4 0 * f4 0 + f4 0 + f4 1 = f4 1 := rfl
      rw [e] at h
      exact absurd h (f4_ne (by norm_num) (by norm_num) (by norm_num))
    · have e : f4 1 * f4 1 + f4 1 + f4 1 = f4 1 := rfl
      rw [e] at h
      exact absurd h (f4_ne (by norm_num) (by norm_num) (by norm_num))
    · left; rfl
    · right; rfl
  rcases hω with h | h
  · left
    intro x
    rcases F4_cases x with rfl | rfl | rfl | rfl
    · exact h0
    · exact h1
    · exact h
    · rw [h3, h]; rfl
  · right
    intro x
    rcases F4_cases x with rfl | rfl | rfl | rfl
    · rw [h0]; rfl
    · rw [h1]; rfl
    · rw [h]; rfl
    · rw [h3, h]; rfl

variable {K : Type} [Field K]

@[expose] noncomputable def psiV (φ : F4 ≃+* K) : Om4.VM K ≃* VM4 :=
  AddEquiv.toMultiplicative (φ.symm.mapMatrix (m := Fin 2)).toAddEquiv

theorem toAdd_psiV (φ : F4 ≃+* K) (x : Om4.VM K) :
    Multiplicative.toAdd (psiV φ x) = (Multiplicative.toAdd x).map φ.symm := rfl

theorem toAdd_psiV_symm (φ : F4 ≃+* K) (X : M2) :
    Multiplicative.toAdd ((psiV φ).symm (Multiplicative.ofAdd X)) = X.map φ := rfl

theorem exists_realizes (φ : F4 ≃+* K) {A B : GL (Fin 2) K} (hA : Om4.IsUT A)
    (hB : Om4.IsUT B) (τ : K ≃+* K) (s : Bool) :
    ∃ p ∈ params, Realizes (MulAut.congr (psiV φ)
      (Om4.lr A B * Om4.frM τ * (if s then Om4.trM else 1))) p := by
  set A' : M2 := (A : Matrix (Fin 2) (Fin 2) K).map φ.symm with hA'
  set B' : M2 := (B : Matrix (Fin 2) (Fin 2) K).map φ.symm with hB'
  set σ : F4 ≃+* F4 := (φ.trans τ).trans φ.symm with hσ
  have hdetA : (A : Matrix (Fin 2) (Fin 2) K) 0 0 * (A : Matrix (Fin 2) (Fin 2) K) 1 1 ≠ 0 := by
    have h := A.isUnit.map Matrix.detMonoidHom
    have h' : (A : Matrix (Fin 2) (Fin 2) K).det ≠ 0 := h.ne_zero
    rw [Matrix.det_fin_two, show (A : Matrix (Fin 2) (Fin 2) K) 1 0 = 0 from hA, mul_zero,
      sub_zero] at h'
    exact h'
  have hdetB : (B : Matrix (Fin 2) (Fin 2) K) 0 0 * (B : Matrix (Fin 2) (Fin 2) K) 1 1 ≠ 0 := by
    have h := B.isUnit.map Matrix.detMonoidHom
    have h' : (B : Matrix (Fin 2) (Fin 2) K).det ≠ 0 := h.ne_zero
    rw [Matrix.det_fin_two, show (B : Matrix (Fin 2) (Fin 2) K) 1 0 = 0 from hB, mul_zero,
      sub_zero] at h'
    exact h'
  have hA00 : A' 0 0 ≠ 0 := by
    simp only [hA', Matrix.map_apply, ne_eq, map_eq_zero_iff _ φ.symm.injective]
    exact left_ne_zero_of_mul hdetA
  have hA11 : A' 1 1 ≠ 0 := by
    simp only [hA', Matrix.map_apply, ne_eq, map_eq_zero_iff _ φ.symm.injective]
    exact right_ne_zero_of_mul hdetA
  have hB00 : B' 0 0 ≠ 0 := by
    simp only [hB', Matrix.map_apply, ne_eq, map_eq_zero_iff _ φ.symm.injective]
    exact left_ne_zero_of_mul hdetB
  have hB11 : B' 1 1 ≠ 0 := by
    simp only [hB', Matrix.map_apply, ne_eq, map_eq_zero_iff _ φ.symm.injective]
    exact right_ne_zero_of_mul hdetB
  have hA10 : A' 1 0 = 0 := by
    simp only [hA', Matrix.map_apply, show (A : Matrix (Fin 2) (Fin 2) K) 1 0 = 0 from hA,
      map_zero]
  have hB10 : B' 1 0 = 0 := by
    simp only [hB', Matrix.map_apply, show (B : Matrix (Fin 2) (Fin 2) K) 1 0 = 0 from hB,
      map_zero]
  obtain ⟨t, ht⟩ : ∃ t : Bool, ∀ X : M2, X.map σ = if t then X.map frob else X := by
    rcases F4_aut σ with h | h
    · refine ⟨false, fun X => ?_⟩
      ext i j
      exact h _
    · refine ⟨true, fun X => ?_⟩
      ext i j
      exact h _
  refine ⟨⟨!![1, (A' 0 0)⁻¹ * A' 0 1; 0, (A' 0 0)⁻¹ * A' 1 1],
    !![A' 0 0 * B' 0 0, A' 0 0 * B' 0 1; 0, A' 0 0 * B' 1 1], s, t⟩,
    mem_params s t (mul_ne_zero (inv_ne_zero hA00) hA11) (mul_ne_zero hA00 hB00)
    (mul_ne_zero hA00 hB11), fun X => ?_⟩
  have eA : (!![1, (A' 0 0)⁻¹ * A' 0 1; 0, (A' 0 0)⁻¹ * A' 1 1] : M2) = (A' 0 0)⁻¹ • A' := by
    ext i j
    fin_cases i <;> fin_cases j
    · simp [inv_mul_cancel₀ hA00]
    · simp
    · simp [hA10]
    · simp
  have eB : (!![A' 0 0 * B' 0 0, A' 0 0 * B' 0 1; 0, A' 0 0 * B' 1 1] : M2) =
      (A' 0 0) • B' := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [hB10]
  have hmap : ∀ M N : Matrix (Fin 2) (Fin 2) K, (M * N).map φ.symm = M.map φ.symm * N.map φ.symm :=
    fun M N => map_mul φ.symm.mapMatrix M N
  have key : Multiplicative.toAdd ((MulAut.congr (psiV φ)
      (Om4.lr A B * Om4.frM τ * (if s then Om4.trM else 1))) (Multiplicative.ofAdd X)) =
      A' * (if s then (X.map σ)ᵀ else X.map σ) * B'ᵀ := by
    show Multiplicative.toAdd (psiV φ ((Om4.lr A B * Om4.frM τ * (if s then Om4.trM else 1) :
      MulAut (Om4.VM K)) ((psiV φ).symm (Multiplicative.ofAdd X)))) = _
    rw [toAdd_psiV]
    cases s
    · simp only [Bool.false_eq_true, ↓reduceIte, mul_one, MulAut.mul_apply]
      rw [Om4.toAdd_lr, Om4.toAdd_frM, toAdd_psiV_symm, hmap, hmap, Matrix.map_map,
        ← Matrix.transpose_map]
      rfl
    · simp only [↓reduceIte, MulAut.mul_apply]
      rw [Om4.toAdd_lr, Om4.toAdd_frM, Om4.toAdd_trM, toAdd_psiV_symm, hmap, hmap,
        ← Matrix.transpose_map, Matrix.map_map, ← Matrix.transpose_map]
      rfl
  rw [key]
  unfold gmap
  rw [eA, eB, ← ht X]
  simp only [Matrix.smul_mul, Matrix.mul_smul, Matrix.transpose_smul, smul_smul,
    mul_inv_cancel₀ hA00, one_smul]

end CFSG.Quasithin.H13.Ch9.L34Q

