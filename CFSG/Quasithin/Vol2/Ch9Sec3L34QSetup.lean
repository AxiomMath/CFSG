theorem not_isDualFFInt_l34 :
    ¬ IsDualFFInt (fsuL0 T L ⊔ T) (fsuV T I) S.hV := by
  let _ : CommGroup ↥(fsuV T I) := commGroupOfElemAbelian S.hV
  have hsq : ∀ v : ↥(fsuV T I), v ^ 2 = 1 := fun v => Subtype.ext (S.hV.2 v v.2)
  intro hdual
  obtain ⟨K, _, _, _, e, ψ, hc, hK4⟩ := S.exists_coord4
  let φ : F4 ≃+* K := FiniteField.ringEquivOfCardEq (K := F4) (K' := K) (by rw [F4.card, hK4])
  set ε := e.trans (psiV φ) with hε
  set TV := autOn T (fsuV T I) with hTV
  have hSyl : IsSylowTwoOf TV (autOn (fsuL0 T L ⊔ T) (fsuV T I)) :=
    Ch4.E443.isSylowTwoOf_autOn S.hN
      (isSylowTwoOf_of_isSylowTwo S.hyp.fsu.sylow le_sup_right)
  have hSyl' := L34Q.isSylowTwoOf_map_of_injective (dualAct_injective hsq) hSyl
  have hFF : IsFFModule (dualSub TV) := Ch4.E443.isFFModule_of_isSylowTwoOf hSyl' hdual
  have hW2 : ∀ f : DualGrp ↥(fsuV T I), f ^ 2 = 1 := by
    intro f
    refine DFunLike.ext _ _ fun v => ?_
    show (f v) ^ 2 = 1
    generalize f v = x
    revert x
    decide
  obtain ⟨A, hA⟩ := ((B1_4_5 hW2 (dualSub TV)).out 1 2).mp hFF
  obtain ⟨F, -, hF, hFq, -⟩ := exists_quadratic_offender_le hW2 hA
  set F₀ := F.comap (dualAct ↥(fsuV T I)) with hF₀
  have hFle : F ≤ (dualAct ↥(fsuV T I)).range :=
    hF.1.trans (Subgroup.map_le_range _ _)
  have hmap : dualSub F₀ = F := Subgroup.map_comap_eq_self hFle
  have hF₀T : F₀ ≤ TV := by
    intro x hx
    obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp (hF.1 hx)
    rwa [← dualAct_injective hsq hyx]
  have hF₀q : IsQuadratic F₀ := (isQuadratic_dualSub_iff hsq F₀).mpr (hmap ▸ hFq)
  have hF₀e : IsElemAbelian2 F₀ := by
    refine ⟨fun a ha b hb => dualAct_injective hsq ?_, fun a ha => dualAct_injective hsq ?_⟩
    · rw [map_mul, map_mul]
      exact hF.2.2.1.1 _ ha _ hb
    · rw [map_pow, map_one]
      exact hF.2.2.1.2 _ ha
  have hF₀1 : F₀ ≠ ⊥ := by
    intro h0
    apply hF.2.1
    rw [← hmap, h0]
    exact Subgroup.map_bot _
  have hoff : Nat.card ↥(commV F₀) ≤ Nat.card ↥F₀ := by
    have h1 := hF.2.2.2 ⊥ bot_le
    have eF : Nat.card ↥F = Nat.card ↥F₀ := by
      rw [← hmap]
      exact card_dualSub hsq F₀
    have eFix : Nat.card ↥(fixV F) = Nat.card ↥(dualAnn (commV F₀)) := by
      rw [← hmap, fixV_dualSub]
    have eBot : Nat.card ↥(⊥ : Subgroup (MulAut (DualGrp ↥(fsuV T I)))) *
        Nat.card ↥(fixV (⊥ : Subgroup (MulAut (DualGrp ↥(fsuV T I))))) =
        Nat.card ↥(fsuV T I) := by
      have : fixV (⊥ : Subgroup (MulAut (DualGrp ↥(fsuV T I)))) = ⊤ := by
        ext f
        refine ⟨fun _ => Subgroup.mem_top f, fun _ x hx => ?_⟩
        have hx1 : x = 1 := Subgroup.mem_bot.mp hx
        subst hx1
        rfl
      rw [this, Subgroup.card_top, Subgroup.card_bot, one_mul, card_dualGrp hsq]
    have h1' : Nat.card ↥(fsuV T I) ≤ Nat.card ↥F₀ * Nat.card ↥(dualAnn (commV F₀)) :=
      calc Nat.card ↥(fsuV T I)
          = Nat.card ↥(⊥ : Subgroup (MulAut (DualGrp ↥(fsuV T I)))) *
            Nat.card ↥(fixV (⊥ : Subgroup (MulAut (DualGrp ↥(fsuV T I))))) := eBot.symm
        _ ≤ Nat.card ↥F * Nat.card ↥(fixV F) := h1
        _ = Nat.card ↥F₀ * Nat.card ↥(dualAnn (commV F₀)) := by rw [eF, eFix]
    have h3 := dualAnn_card hsq (commV F₀)
    have hpos : 0 < Nat.card ↥(dualAnn (commV F₀)) := Nat.card_pos
    have h4 : Nat.card ↥(dualAnn (commV F₀)) * Nat.card ↥(commV F₀) ≤
        Nat.card ↥(dualAnn (commV F₀)) * Nat.card ↥F₀ := by
      rw [h3]
      calc Nat.card ↥(fsuV T I) ≤ Nat.card ↥F₀ * Nat.card ↥(dualAnn (commV F₀)) := h1'
        _ = _ := mul_comm _ _
    exact Nat.le_of_mul_le_mul_left h4 hpos
  have hEr := realizes_of_le_autOn hc φ hF₀T
  have hlt := Certificates.certificate7212.2 _ hEr
    (isElemAbelian2_map_congr' ε hF₀e)
    (isQuadratic_map_congr' ε hF₀q) (by
      intro h0
      apply hF₀1
      exact (Subgroup.map_eq_bot_iff_of_injective _ (MulAut.congr ε).injective).mp h0)
  rw [Subgroup.card_map_of_injective (MulAut.congr ε).injective, commV_map_congr',
    Subgroup.card_map_of_injective ε.injective] at hlt
  exact absurd hoff (not_le.mpr hlt)

