theorem q43_le :
    ∀ E₀ : Subgroup G, E₀ ≤ T → IsElemAbelian 2 E₀ → ⁅⁅fsuV T I, E₀⁆, E₀⁆ = ⊥ →
      ¬ E₀ ≤ Subgroup.centralizer (fsuV T I : Set G) →
      ((Subgroup.centralizer (fsuV T I : Set G)).relIndex E₀) ^ 4 ≤
        ((Subgroup.centralizer (E₀ : Set G)).relIndex (fsuV T I)) ^ 3 := by
  intro E₀ hE₀T hE₀ hquad _
  let _ : CommGroup ↥(fsuV T I) := commGroupOfElemAbelian S.hV
  obtain ⟨K, _, _, _, e, ψ, hc, hK4⟩ := S.exists_coord4
  let φ : F4 ≃+* K := FiniteField.ringEquivOfCardEq (K := F4) (K' := K) (by rw [F4.card, hK4])
  have hE₀N : E₀ ≤ Subgroup.normalizer (fsuV T I : Set G) := hE₀T.trans S.T_le_normalizer_V
  set X := autOn E₀ (fsuV T I) with hX
  have hXT : X ≤ autOn T (fsuV T I) := Subgroup.map_mono fun x hx => hE₀T hx
  set ε := e.trans (psiV φ) with hε
  have hEr := realizes_of_le_autOn hc φ hXT
  have hel := isElemAbelian2_map_congr' ε (isElemAbelian2_autOn S.hV hE₀ hE₀N)
  have hq := isQuadratic_map_congr' ε
    ((isQuadratic_iff_commSeries_two _).mpr (D15Proof.commSeries_autOn_two_eq_bot S.hV hquad))
  have hbd := Certificates.certificate7212.1 _ hEr hel hq
  rw [Subgroup.card_map_of_injective (MulAut.congr ε).injective, fixV_map_congr',
    Subgroup.card_map_of_injective ε.injective, card_autOn_eq_relIndex hE₀N,
    card_fixV_autOn_eq S.hV hE₀N, Subgroup.inf_relIndex_left] at hbd
  set a := (Subgroup.centralizer (fsuV T I : Set G)).relIndex E₀
  set b := (Subgroup.centralizer (E₀ : Set G)).relIndex (fsuV T I)
  set c := Nat.card ↥(fsuV T I ⊓ Subgroup.centralizer (E₀ : Set G) : Subgroup G)
  have hV : b * c = 256 := by
    rw [← S.card_fsuV_eq]
    have := Subgroup.relIndex_mul_card (Subgroup.centralizer (E₀ : Set G)) (fsuV T I)
    rwa [inf_comm] at this
  have hc0 : 0 < c := Nat.card_pos
  have h1 : a ^ 4 * c ^ 3 ≤ b ^ 3 * c ^ 3 := by
    calc a ^ 4 * c ^ 3 ≤ 2 ^ 24 := hbd
      _ = (b * c) ^ 3 := by rw [hV]; norm_num
      _ = b ^ 3 * c ^ 3 := mul_pow b c 3
  exact Nat.le_of_mul_le_mul_right h1 (pow_pos hc0 3)

end Setup

theorem L34Q.isSylowTwoOf_map_of_injective {Γ Γ' : Type*} [Group Γ] [Group Γ'] {f : Γ →* Γ'}
    (hf : Function.Injective f) {Y X : Subgroup Γ} (h : IsSylowTwoOf Y X) :
    IsSylowTwoOf (Y.map f) (X.map f) := by
  refine ⟨Subgroup.map_mono h.1, h.2.1.map f, ?_⟩
  have e : ((Y.map f).subgroupOf (X.map f)).index = (Y.subgroupOf X).index :=
    Subgroup.relIndex_map_map_of_injective Y X hf
  rw [e]
  exact h.2.2

