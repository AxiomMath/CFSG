theorem exists_coord4 : ∃ (K : Type) (_ : Field K) (_ : Fintype K) (_ : CharP K 2)
    (e : ↥(fsuV T I) ≃* Om4.VM K)
    (ψ : ↥(fsuL0 T L) →* Matrix.SpecialLinearGroup (Fin 2) K × Matrix.SpecialLinearGroup (Fin 2) K),
    S.IsCoord e ψ ∧ Fintype.card K = 4 := by
  obtain ⟨K, _, _, _, e, ψ, hc⟩ := S.exists_isCoord
  exact ⟨K, inferInstance, inferInstance, inferInstance, e, ψ, hc, by rw [hc.card]; norm_num⟩

omit S in
theorem realizes_of_le_autOn {K : Type} [Field K] [Fintype K] [CharP K 2]
    {e : ↥(fsuV T I) ≃* Om4.VM K}
    {ψ : ↥(fsuL0 T L) →* Matrix.SpecialLinearGroup (Fin 2) K × Matrix.SpecialLinearGroup (Fin 2) K}
    {S : Setup T L I 2} (hc : S.IsCoord e ψ) (φ : F4 ≃+* K)
    {X : Subgroup (MulAut ↥(fsuV T I))} (hX : X ≤ autOn T (fsuV T I)) :
    ∀ g ∈ X.map (MulAut.congr (e.trans (psiV φ))).toMonoidHom, ∃ p ∈ params, Realizes g p := by
  rintro _ ⟨x, hx, rfl⟩
  obtain ⟨⟨t, htN⟩, htT, rfl⟩ : ∃ g : ↥(Subgroup.normalizer (fsuV T I : Set G)),
      (g : G) ∈ T ∧ conjAct (fsuV T I) g = x := by
    have h := hX hx
    unfold autOn at h
    obtain ⟨g, hg, rfl⟩ := Subgroup.mem_map.mp h
    exact ⟨g, Subgroup.mem_subgroupOf.mp hg, rfl⟩
  obtain ⟨A, B, τ, hA, hB, hform⟩ := hc.exists_form_ut htT
  have hbar : MulAut.congr e (conjAct (fsuV T I) ⟨t, htN⟩) =
      bar e ⟨t, S.hMN (Setup.T_le_fsuM htT)⟩ := rfl
  show ∃ p ∈ params, Realizes ((MulAut.congr (e.trans (psiV φ)))
    (conjAct (fsuV T I) ⟨t, htN⟩)) p
  rw [L34Q.congr_trans_apply, hbar]
  rcases hform with h | h
  · rw [h]
    have := exists_realizes φ hA hB τ false
    simpa using this
  · rw [h]
    have := exists_realizes φ hA hB τ true
    simpa using this


theorem card_fsuV_eq : Nat.card ↥(fsuV T I) = 256 := by
