variable {W W' : Type*} [CommGroup W] [CommGroup W']

theorem fixV_map_congr' (ε : W ≃* W') (X : Subgroup (MulAut W)) :
    fixV (X.map (MulAut.congr ε).toMonoidHom) = (fixV X).map ε.toMonoidHom :=
  fixV_map_congr_equiv ε X

theorem commV_map_congr' (ε : W ≃* W') (X : Subgroup (MulAut W)) :
    commV (X.map (MulAut.congr ε).toMonoidHom) = (commV X).map ε.toMonoidHom :=
  commV_map_congr_equiv ε X

theorem isQuadratic_map_congr' (ε : W ≃* W') {X : Subgroup (MulAut W)} (hX : IsQuadratic X) :
    IsQuadratic (X.map (MulAut.congr ε).toMonoidHom) := by
  unfold IsQuadratic at hX ⊢
  rw [commV_map_congr', fixV_map_congr']
  exact Subgroup.map_mono hX

theorem isElemAbelian2_map_congr' (ε : W ≃* W') {X : Subgroup (MulAut W)}
    (hX : IsElemAbelian2 X) : IsElemAbelian2 (X.map (MulAut.congr ε).toMonoidHom) := by
  refine ⟨?_, ?_⟩
  · rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
    rw [← map_mul, ← map_mul, hX.1 a ha b hb]
  · rintro _ ⟨a, ha, rfl⟩
    rw [← map_pow, hX.2 a ha, map_one]

end L34Q

theorem L34Q.congr_trans_apply {W₁ W₂ W₃ : Type*} [Group W₁] [Group W₂] [Group W₃]
    (ε₁ : W₁ ≃* W₂) (ε₂ : W₂ ≃* W₃) (x : MulAut W₁) :
    MulAut.congr (ε₁.trans ε₂) x = MulAut.congr ε₂ (MulAut.congr ε₁ x) :=
  MulEquiv.ext fun _ => rfl

