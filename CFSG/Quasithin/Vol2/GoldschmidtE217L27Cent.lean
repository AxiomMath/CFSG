variable {G : Type} [Group G] [Finite G]

theorem exists_mulEquiv_psl_seven {X : Type} [Group X] (h : IsPSL 2 7 1 X) :
    ∃ (F : Type) (_ : Field F) (_ : Fintype F), Fintype.card F = 7 ∧
      Nonempty (X ≃* PSL(2, F)) := by
  obtain ⟨-, F, hF1, hF2, hF, ⟨ψ₀⟩⟩ := h
  have : Fintype F := Fintype.ofFinite F
  refine ⟨F, hF1, this, ?_, ⟨ψ₀.trans
    (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj 2 F).symm⟩⟩
  rw [← Nat.card_eq_fintype_card, hF, pow_one]

theorem kerIn_eq_pCoreOf_of_L27
    {H T M V K : Subgroup G} (hS : Setting2 H T M V K)
    (hC2 : Case2 H T M K) (hL : IsPSL 2 7 1 ↥(E2.star M H K)) : kerIn M H = pCoreOf 2 H := by
  have hmp := hS.toHyp2.hyp.minParabolic
  have hKc := hS.mem_cComp
  have hKH : K ≤ H := le_of_mem_cComp hKc
  have hOJ : pCoreOf 2 H ≤ kerIn M H := hmp.pCoreOf_le_kerIn
  have hKN : K ≤ Subgroup.normalizer (pCoreOf 2 H : Set G) := hKH.trans (le_normalizer_pCoreOf 2 H)
  have hOh : ((pCoreOf 2 H).subgroupOf H).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer (pCoreOf_le 2 H)).2 (le_normalizer_pCoreOf 2 H)
  set Oh : Subgroup ↥H := (pCoreOf 2 H).subgroupOf H with hOhdef
  set π₁ : ↥H →* ↥H ⧸ Oh := QuotientGroup.mk' Oh with hπ₁
  have hker : Oh ≤ (E2P.starMap M H).ker := by
    rw [E2P.ker_starMap]
    exact Subgroup.subgroupOf_mono H hOJ
  set ρ : (↥H ⧸ Oh) →* E2.StarQuot M H := QuotientGroup.lift Oh (E2P.starMap M H) hker with hρ
  set K' : Subgroup ↥H := K.subgroupOf H with hK'
  set Kb : Subgroup (↥H ⧸ Oh) := K'.map π₁ with hKb
  have hmem : ∀ x : ↥Kb, ρ (x : ↥H ⧸ Oh) ∈ E2.star M H K := by
    rintro ⟨_, ⟨k, hk, rfl⟩⟩
    exact ⟨k, hk, rfl⟩
  obtain ⟨F, hFf, hFfin, hF7, ⟨θ⟩⟩ := exists_mulEquiv_psl_seven hL
  let φ : ↥Kb →* ↥(E2.star M H K) := (ρ.comp Kb.subtype).codRestrict (E2.star M H K) hmem
  let π : ↥Kb →* PSL(2, F) := θ.toMonoidHom.comp φ
  have hπsurj : Function.Surjective π := by
    intro y
    obtain ⟨k, hk, hky⟩ := (θ.symm y).2
    refine ⟨⟨π₁ k, k, hk, rfl⟩, ?_⟩
    show θ (φ ⟨π₁ k, k, hk, rfl⟩) = y
    have : φ ⟨π₁ k, k, hk, rfl⟩ = θ.symm y := Subtype.ext hky
    rw [this, MulEquiv.apply_symm_apply]
  have hcomm : ∀ k ∈ K', ∀ k' ∈ K', E2P.starMap M H k = 1 → π₁ k' * π₁ k = π₁ k * π₁ k' := by
    intro k hk k' hk' h1
    have hkJ : (k : G) ∈ kerIn M H := by
      have : k ∈ (E2P.starMap M H).ker := h1
      rw [E2P.ker_starMap] at this
      exact Subgroup.mem_subgroupOf.1 this
    have hk'K : (k' : G) ∈ K ⊔ pCoreOf 2 H := Subgroup.mem_sup_left hk'
    have h2 := ((hC2.2 (k : G)).1 hkJ).2 (k' : G) hk'K
    have h3 : π₁ ⁅k, k'⁆ = 1 := (QuotientGroup.eq_one_iff _).2 (by
      rw [hOhdef, Subgroup.mem_subgroupOf]
      simpa [commutatorElement_def] using h2)
    rw [map_commutatorElement, commutatorElement_eq_one_iff_commute] at h3
    exact h3.symm.eq
  have hker1 : ∀ (k : ↥H) (hk : k ∈ K'), π ⟨π₁ k, k, hk, rfl⟩ = 1 →
      E2P.starMap M H k = 1 := by
    intro k hk hx
    have h2 : φ ⟨π₁ k, k, hk, rfl⟩ = 1 := θ.injective (by rw [map_one]; exact hx)
    exact congrArg Subtype.val h2
  have hcen : π.ker ≤ Subgroup.center ↥Kb := by
    rintro ⟨_, k, hk, rfl⟩ hx
    have hx1 : E2P.starMap M H k = 1 := hker1 k hk hx
    rw [Subgroup.mem_center_iff]
    rintro ⟨_, k', hk', rfl⟩
    exact Subtype.ext (hcomm k hk k' hk' hx1)
  have hperfS : Group.IsPerfect (PSL(2, F)) :=
    ⟨(CFSG.LieType.Steinberg.CentralExt.SLClosed.psl_two_hopfMultiplier_of_mulEquiv (k := F)
      (by rw [hF7]; norm_num) (by rw [hF7]; norm_num) (MulEquiv.refl _)).1⟩
  obtain ⟨e⟩ := (CFSG.LieType.Steinberg.CentralExt.SLClosed.psl_two_hopfMultiplier_of_mulEquiv
    (k := F) (by rw [hF7]; norm_num) (by rw [hF7]; norm_num) (MulEquiv.refl PSL(2, F))).2
  have hperfKb : Group.IsPerfect ↥Kb := by
    refine Subgroup.isPerfect_iff.2 ?_
    have hperfK' : ⁅K', K'⁆ = K' := perfect_of_mem_cComp (subgroupOf_mem_cComp hKc)
    rw [hKb, ← Subgroup.map_commutator, hperfK']
  have hdvd := CFSG.RankThree.PartOne.card_ker_dvd_card_hopfMultiplier hperfS hperfKb π hπsurj hcen
  have hmult : Nat.card (CFSG.RankThree.PerfectCover.hopfMultiplier PSL(2, F)) = 2 := by
    rw [← Nat.card_congr (CFSG.RankThree.PerfectCover.hopfMultiplierEquivGriess _).toEquiv,
      Nat.card_congr e.toEquiv, hF7]
    simp
  rw [hmult] at hdvd
  have hsq : ∀ y ∈ π.ker, y * y = 1 := by
    intro y hy
    have h2 : (⟨y, hy⟩ : π.ker) ^ 2 = 1 :=
      orderOf_dvd_iff_pow_eq_one.1 ((orderOf_dvd_natCard _).trans hdvd)
    have := congrArg Subtype.val h2
    simpa [pow_two] using this
  have hQT : pCoreOf 2 H ≤ T := B6.pCoreOf_two_le_of_isSylowTwoOf hmp.isSylow
  have hker_triv : ∀ (k : ↥H) (hk : k ∈ K'), E2P.starMap M H k = 1 → π₁ k = 1 := by
    intro k hk hk1
    have hy : (⟨π₁ k, k, hk, rfl⟩ : ↥Kb) ∈ π.ker := by
      rw [MonoidHom.mem_ker]
      show θ (φ ⟨π₁ k, k, hk, rfl⟩) = 1
      have : φ ⟨π₁ k, k, hk, rfl⟩ = 1 := Subtype.ext hk1
      rw [this, map_one]
    have h2 := hsq _ hy
    have h3 : π₁ (k * k) = 1 := by
      have := congrArg Subtype.val h2
      simpa [map_mul] using this
    have hkk : ((k * k : ↥H) : G) ∈ pCoreOf 2 H :=
      Subgroup.mem_subgroupOf.1 ((QuotientGroup.eq_one_iff _).1 h3)
    have hkJ : (k : G) ∈ kerIn M H := by
      have : k ∈ (E2P.starMap M H).ker := hk1
      rw [E2P.ker_starMap] at this
      exact Subgroup.mem_subgroupOf.1 this
    obtain ⟨m, hm⟩ := E2.exists_pow_two_pow_eq_one hmp.isSylow.2.1 (hQT hkk)
    have hk2 : (k : G) ^ 2 ^ (m + 1) = 1 := by
      calc (k : G) ^ 2 ^ (m + 1) = ((k : G) * k) ^ 2 ^ m := by rw [pow_succ', pow_mul, pow_two]
        _ = 1 := hm
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    have hP : IsPGroup 2 (Subgroup.zpowers (k : G)) := by
      obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 (orderOf_dvd_of_pow_eq_one hk2)
      exact IsPGroup.of_card (by rw [Nat.card_zpowers, hj])
    have hle := hmp.le_pCoreOf_of_isPGroup_of_le_kerIn hP (Subgroup.zpowers_le.2 hkJ)
    have hkQ : (k : G) ∈ pCoreOf 2 H := hle (Subgroup.mem_zpowers _)
    exact (QuotientGroup.eq_one_iff _).2 (Subgroup.mem_subgroupOf.2 hkQ)
  refine le_antisymm (fun x hx => ?_) hOJ
  have hxK := ((hC2.2 x).1 hx).1
  have hxKO : x ∈ ((pCoreOf 2 H ⊔ K : Subgroup G) : Set G) := by
    rw [sup_comm]
    exact hxK
  rw [Subgroup.coe_mul_of_right_le_normalizer_left (pCoreOf 2 H) K hKN] at hxKO
  obtain ⟨o, ho, k, hk, rfl⟩ := hxKO
  have hkJ : k ∈ kerIn M H := by
    simpa using (kerIn M H).mul_mem ((kerIn M H).inv_mem (hOJ ho)) hx
  have hkH : k ∈ H := hKH hk
  have hk' : (⟨k, hkH⟩ : ↥H) ∈ K' := hk
  have hk1 : E2P.starMap M H ⟨k, hkH⟩ = 1 := by
    have : (⟨k, hkH⟩ : ↥H) ∈ (E2P.starMap M H).ker := by
      rw [E2P.ker_starMap]
      exact Subgroup.mem_subgroupOf.2 hkJ
    exact this
  have hk3 := hker_triv ⟨k, hkH⟩ hk' hk1
  have hkO : k ∈ pCoreOf 2 H := Subgroup.mem_subgroupOf.1 ((QuotientGroup.eq_one_iff _).1 hk3)
  exact (pCoreOf 2 H).mul_mem ho hkO

