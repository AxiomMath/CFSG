variable {G : Type} [Group G] [Finite G] {T L V : Subgroup G}

theorem autOn_l1 (h1222 : Stmt12_2_2) (F : Frame125 T L V) (hH : Hyp125 G T L V) :
    autOn (li L F.V1) V = (S125Gen.pR 2 3 rfl).map (psi F) := by
  have hf := S125Ex.Facts125.of h1222 hH
  show autOn (li L (F.sub {0})) V = _
  rw [lbar_eq F hf.normalizes hf.T_le (S := {0}) (rfl : 2 + 3 = 5)
    (isStab_V1 F hf.normalizes hf.T_le)
    (S125L2G.hres_of parJR_le_parQ S125Pb.perfectResidual_parQ23), S125Gen.pR,
    Subgroup.map_map]
  rfl

theorem V_le_L (h1222 : Stmt12_2_2) (hH : Hyp125 G T L V) : V ≤ L := by
  have hf := S125Ex.Facts125.of h1222 hH
  have hcomm : ⁅V, L⁆ = V := hH.hyp.irrPlus.2.2.2.1
  rw [← hcomm]
  rw [Subgroup.commutator_le]
  intro v hv l hl
  have h1 : v * l * v⁻¹ ∈ L :=
    (Subgroup.mem_normalizer_iff.mp (hH.hyp.normalizes (hf.le_T hv)) l).mp hl
  exact L.mul_mem h1 (L.inv_mem hl)

theorem V_le_normalizer_l1 (h1222 : Stmt12_2_2) (F : Frame125 T L V) (hH : Hyp125 G T L V) :
    V ≤ Subgroup.normalizer (li L F.V1 : Set G) := by
  have hf := S125Ex.Facts125.of h1222 hH
  have : IsMulCommutative ↥V := hf.comm
  have hV₁V : F.V1 ≤ V := Subgroup.map_subtype_le _
  have hVX : V ≤ L ⊓ Subgroup.normalizer (F.V1 : Set G) := by
    refine le_inf (V_le_L h1222 hH) fun v hv => ?_
    apply S125St.mem_normalizer_of_conj_le
    intro w hw
    have h1 : v * w = w * v := setLike_mul_comm hv (hV₁V hw)
    rw [h1, mul_inv_cancel_right]
    exact hw
  exact hVX.trans (Subgroup.le_normalizer.trans
    (CFSG.RankThree.GroupTheory.SteinbergBY.normalizer_le_normalizer_inSubgroup_perfectResidual
      _))

theorem V_le_l1 (h1222 : Stmt12_2_2) (F : Frame125 T L V) (hH : Hyp125 G T L V) :
    V ≤ li L F.V1 := by
  have hVN := V_le_normalizer_l1 h1222 F hH
  have hbasis : ∀ k : Fin 10,
      ((F.e.symm (Multiplicative.ofAdd (Pi.single k 1)) : ↥V) : G) ∈ li L F.V1 := by
    intro k
    obtain ⟨m, t, ht, hw⟩ := S125Gen.exists_transvec_wedge k
    have hψ : psi F t ∈ autOn (li L F.V1) V := by
      rw [autOn_l1 h1222 F hH]
      exact ⟨t, ht, rfl⟩
    obtain ⟨l, hlN, hlL, hl⟩ := mem_autOn_iff_exists.mp hψ
    set v : ↥V := F.e.symm (Multiplicative.ofAdd (Pi.single m 1)) with hv
    set b : ↥V := F.e.symm (Multiplicative.ofAdd (Pi.single k 1)) with hb
    have hact : conjAct V ⟨l, hlN⟩ v = v * b := by
      apply F.e.injective
      rw [hl]
      change F.e (((F.γ.symm t : ↥(autOn L V)) : MulAut ↥V) v) = _
      rw [F.wedge, MulEquiv.apply_symm_apply, S125ZV.wedgeRep_apply, map_mul, hv, hb,
        MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply, toAdd_ofAdd, hw, ofAdd_add]
    have hcoe : l * (v : G) * l⁻¹ = (v : G) * (b : G) := by
      have := congrArg Subtype.val hact
      rwa [S125ZV.coe_conjAct_apply] at this
    have hbG : (b : G) = ((v : G)⁻¹ * l * v) * l⁻¹ := by
      have h1 : (b : G) = (v : G)⁻¹ * (l * v * l⁻¹) := by
        rw [hcoe]
        group
      rw [h1]
      group
    rw [hbG]
    refine (li L F.V1).mul_mem ?_ ((li L F.V1).inv_mem hlL)
    have hv' : (v : G)⁻¹ ∈ Subgroup.normalizer (li L F.V1 : Set G) :=
      Subgroup.inv_mem _ (hVN v.2)
    have h1 := (Subgroup.mem_normalizer_iff.mp hv' l).mp hlL
    simpa using h1
  have hle : coordOf F V ≤ coordOf F (li L F.V1) := by
    rw [coordOf_V, ← coordSub_univ]
    exact coordSub_le fun k _ => mem_coordOf.2 (hbasis k)
  exact (coordOf_le_iff F le_rfl).1 hle

theorem V_le_pCoreOf (h1222 : Stmt12_2_2) (F : Frame125 T L V) (hH : Hyp125 G T L V)
    (hN : Subgroup.normalizer (F.V1 : Set G) ≤ Subgroup.normalizer (li L F.V1 : Set G)) :
    V ≤ pCoreOf 2 (Subgroup.normalizer (F.V1 : Set G)) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hf := S125Ex.Facts125.of h1222 hH
  have hV2 : IsPGroup 2 ↥V := IsPGroup.of_card (n := 10) hf.card
  have hL₁V : li L F.V1 ≤ Subgroup.normalizer (V : Set G) :=
    (S125K6.li_le L _).trans hf.normalizes
  have h1 : V ≤ pCoreOf 2 (li L F.V1) :=
    CFSG.LieType.BorelTits.le_pCoreOf_of_le_normalizer 2 (V_le_l1 h1222 F hH) hL₁V hV2
  have hL₁G₁ : li L F.V1 ≤ Subgroup.normalizer (F.V1 : Set G) := S125K6.li_le_normalizer L _
  refine h1.trans (CFSG.LieType.BorelTits.le_pCoreOf_of_le_normalizer 2
    ((CFSG.LieType.BorelTits.pCoreOf_le 2 _).trans hL₁G₁)
    (hN.trans (S125Fin.normalizer_le_normalizer_pCoreOf _))
    (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 _))

theorem isElemAbelian_u128 (h1222 : Stmt12_2_2) (F : Frame125 T L V) (hH : Hyp125 G T L V)
    (h7 : Concl12_5_7 T L V) (hV : V ≤ pCoreOf 2 (Subgroup.normalizer (F.V1 : Set G))) :
    IsElemAbelian 2 (u128 V F.V1) := by
  have hf := S125Ex.Facts125.of h1222 hH
  have hTV₁ : T ≤ Subgroup.normalizer (F.V1 : Set G) := (S125L2G.T_le_V F hf.T_le).1
  have hS : QuasithinUnique.IsSylowTwoOf T (Subgroup.normalizer (F.V1 : Set G)) :=
    isSylowTwoOf_of_quasithinIsSylowTwo hH.hyp.sylow hTV₁
  have hOT : pCoreOf 2 (Subgroup.normalizer (F.V1 : Set G)) ≤ T :=
    pCoreOf_two_le_of_isSylowTwoOf hS
  have hkey : ∀ k ∈ Subgroup.normalizer (F.V1 : Set G), ∀ v ∈ V, ∀ w ∈ V,
      Commute (k * v * k⁻¹) w := by
    intro k hk v hv w hw
    have hA : conjSubgroup V k⁻¹ ≤ T := by
      intro x hx
      rw [mem_conjSubgroup_iff, inv_inv] at hx
      have h1 : k * (k⁻¹ * x * k) * k⁻¹ ∈ pCoreOf 2 (Subgroup.normalizer (F.V1 : Set G)) :=
        (Subgroup.mem_normalizer_iff.mp
          (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 _ hk) _).mp (hV hx)
      exact hOT (by simpa [mul_assoc] using h1)
    have hmem : k * v * k⁻¹ ∈ conjSubgroup V k⁻¹ := by
      rw [mem_conjSubgroup_iff, inv_inv]
      simpa [mul_assoc] using hv
    have hW : conjSubgroup V k⁻¹ ∈ E3.gammaSet V 0 T :=
      ⟨hA, k⁻¹, le_rfl, by rw [E3.mQuot, Subgroup.relIndex_self, padicValNat_one_right]⟩
    have hWC : conjSubgroup V k⁻¹ ≤ Subgroup.centralizer (V : Set G) :=
      (le_iSup₂ (f := fun (A : Subgroup G) (_ : A ∈ E3.gammaSet V 0 T) => A) _ hW).trans h7.1
    exact (Subgroup.mem_centralizer_iff.mp (hWC hmem) w hw).symm
  show IsElemAbelian 2 (Subgroup.closure
    {x | ∃ h ∈ Subgroup.normalizer (F.V1 : Set G), ∃ z ∈ V, h * z * h⁻¹ = x})
  refine CFSG.LieType.SeitzGeneration.isElemAbelian_closure_of_comm (fun x hx y hy => ?_) ?_
  · obtain ⟨g, hg, v, hv, rfl⟩ := hx
    obtain ⟨h, hh, w, hw, rfl⟩ := hy
    have hhg : h⁻¹ * g ∈ Subgroup.normalizer (F.V1 : Set G) :=
      Subgroup.mul_mem _ (Subgroup.inv_mem _ hh) hg
    have h1 := hkey _ hhg v hv w hw
    have h2 := h1.conj h
    simpa [mul_assoc] using h2
  · rintro _ ⟨g, -, v, hv, rfl⟩
    have h1 : v ^ 2 = 1 := hf.sq v hv
    rw [conj_pow, h1, mul_one, mul_inv_cancel]

theorem concl12_5_8_of (h1222 : Stmt12_2_2) (F : Frame125 T L V) (hH : Hyp125 G T L V)
    (h7 : Concl12_5_7 T L V)
    (hN : Subgroup.normalizer (F.V1 : Set G) ≤ Subgroup.normalizer (li L F.V1 : Set G)) :
    Concl12_5_8 T L V F := by
  have hV := V_le_pCoreOf h1222 F hH hN
  exact ⟨hV, isElemAbelian_u128 h1222 F hH h7 hV⟩

