    exact ru_seed_pow_check.2)

theorem det_ruMA_ne_zero : (ofDigits28 ruDigits₁).det ≠ 0 := by
  intro h
  have := congrArg Matrix.det ruMA_sq
  rw [Matrix.det_mul, h, zero_mul, Matrix.det_one] at this
  exact zero_ne_one this

theorem det_ruMB_ne_zero : (ofDigits28 ruDigits₂).det ≠ 0 := by
  intro h
  have := congrArg Matrix.det ruMB_pow
  rw [Matrix.det_mul, h, zero_mul, Matrix.det_one] at this
