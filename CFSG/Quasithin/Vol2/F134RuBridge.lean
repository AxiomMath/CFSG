theorem matCode28_ruB : matCode28 (ofDigits28 ruDigits₂) = ruBC := by decide +kernel

theorem matCode28_one : matCode28 (1 : Matrix (Fin 28) (Fin 28) (ZMod 2)) = ruOneC := by
  decide +kernel

theorem ru_seed_pow_check : mulF28 ruAC ruAC = ruOneC ∧
    mulF28 ruBC (mulF28 ruBC (mulF28 ruBC ruBC)) = ruOneC := by
  decide +kernel

theorem ruMA_sq : ofDigits28 ruDigits₁ * ofDigits28 ruDigits₁ = 1 := matCode28_injective (by
