@[expose] def seedDigits (l : List Char) : List ℕ :=
  (((l.dropWhile (· != '\n')).drop 1).filter fun c => !asciiWhitespace c).map fun c =>
    if '0' ≤ c && c ≤ '9' then c.toNat - '0'.toNat else 0

theorem decode_eq_seedDigits (p d : ℕ) (s : String) : decode p d 1 s =
    Matrix.of fun i j => (((seedDigits s.toList)[i.val * d + j.val]?.getD 0 : ℕ) : ZMod p) :=
  rfl

@[expose] def ofDigits28 (L : List ℕ) : Matrix (Fin 28) (Fin 28) (ZMod 2) :=
  Matrix.of fun i j => ((L[i.val * 28 + j.val]?.getD 0 : ℕ) : ZMod 2)

