@[expose] def sGens : List (List ℕ) := [matT01, matX, matW]

@[expose] def sM (i : ℕ) : List ℕ := sMats.getD i []

@[expose] def sInv : List ℕ := sInner ++ sOuter

@[expose] def sCommB (t u : ℕ) : Bool := (sComm.getD t 0).testBit u

@[expose] def fixOB (m : List ℕ) (c : ℕ) : Bool := mact m c == c

@[expose] def fixQB (m : List ℕ) (c : ℕ) : Bool := (mact m c ^^^ c) ||| 129 == 129

theorem matCode_zT01 : matCode (zT01 : quasithinZorn (ZMod 2) ≃ₗ[ZMod 2] _) = matT01 := by
  decide +kernel

theorem matCode_zT10 : matCode (zT10 : quasithinZorn (ZMod 2) ≃ₗ[ZMod 2] _) = matT10 := by
  decide +kernel

theorem matCode_zX : matCode (zX : quasithinZorn (ZMod 2) ≃ₗ[ZMod 2] _) = matX := by
  decide +kernel

theorem matW_eq : mmul (mmul (mmul (mmul matT10 matT01) matX) matT01) matT10 = matW := by
  decide +kernel

theorem sMats_inj : ∀ i < 64, ∀ k < 64, sM i = sM k → i = k := by
  decide +kernel

theorem sM_zero : sM 0 = idMat := by
  decide

theorem sWords_spec : ∀ i < 64,
    (sWords.getD i []).foldl (fun m j => mmul m (sGens.getD j [])) idMat = sM i ∧
      ∀ j ∈ sWords.getD i [], j < 3 := by
  decide +kernel

theorem sMats_closed : ∀ i < 64, ∀ j < 3, ∃ k < 64, mmul (sM i) (sGens.getD j []) = sM k := by
  decide +kernel

theorem sInv_spec : ∀ i < 64, (mmul (sM i) (sM i) = idMat ∧ i ≠ 0) ↔ i ∈ sInv := by
  decide +kernel

theorem sInner_fix : ∀ i ∈ sInner, (o0Codes.filter (fixOB (sM i))).length = 32 ∧
    (o0Codes.filter fun c => !c.testBit 0 && fixQB (sM i) c).length = 16 := by
  decide +kernel

theorem sOuter_fix : ∀ i ∈ sOuter, (o0Codes.filter (fixOB (sM i))).length = 16 ∧
    (o0Codes.filter fun c => !c.testBit 0 && fixQB (sM i) c).length = 8 := by
  decide +kernel

theorem sInner_pair : ∀ i ∈ sInner, ∀ j ∈ sInner, i ≠ j →
    mmul (sM i) (sM j) = mmul (sM j) (sM i) →
      (o0Codes.filter fun c => fixOB (sM i) c && fixOB (sM j) c).length < 32 ∧
        (o0Codes.filter fun c =>
          !c.testBit 0 && (fixQB (sM i) c && fixQB (sM j) c)).length < 16 := by
  decide +kernel

theorem sComm_spec : ∀ i ∈ sInv, ∀ l < 64,
    sCommB i l = ((l == 0 || decide (l ∈ sInv)) && mmul (sM l) (sM i) == mmul (sM i) (sM l)) := by
  decide +kernel

theorem sE8_spec : ∀ e < 8, ∀ l < 64,
    (sE8Mask.getD e 0).testBit l = decide (l ∈ sE8.getD e []) := by
  decide +kernel

theorem sE8_len : ∀ e < 8, (sE8.getD e []).length = 8 ∧ (sE8.getD e []).Nodup ∧
    ∀ l ∈ sE8.getD e [], l < 64 := by
  decide +kernel

theorem sTriple : ∀ i ∈ sInv, ∀ j ∈ sInv, ∀ k ∈ sInv, sCommB i j = true → sCommB i k = true →
    sCommB j k = true → i ≠ j → i ≠ k → j ≠ k → sM k ≠ mmul (sM i) (sM j) →
      ∃ e < 8, sComm.getD i 0 &&& sComm.getD j 0 &&& sComm.getD k 0 = sE8Mask.getD e 0 := by
  decide +kernel

theorem sFixO_spec : ∀ e < 8,
    sFixO.getD e [] = o0Codes.filter fun c => (sE8.getD e []).all fun i => fixOB (sM i) c := by
  decide +kernel

theorem sFixQ_spec : ∀ e < 8,
    sFixQ.getD e [] = o0Codes.filter fun c => (sE8.getD e []).all fun i => fixQB (sM i) c := by
  decide +kernel

theorem sClaimO : ∀ e < 8, (sFixO.getD e []).length < 16 ∨
    ((∀ i ∈ sE8.getD e [], ∀ c ∈ o0Codes, mact (sM i) c ^^^ c ∈ sFixO.getD e []) ∧
      ∀ f ∈ sFixO.getD e [], ∃ w ∈ sWitO.getD e [], w.1 = f ∧ w.2.1 ∈ sE8.getD e [] ∧
        w.2.2.1 ∈ o0Codes ∧ w.2.2.2.1 ∈ sE8.getD e [] ∧ w.2.2.2.2 ∈ o0Codes ∧
        f = mact (sM w.2.1) w.2.2.1 ^^^ w.2.2.1 ^^^
          (mact (sM w.2.2.2.1) w.2.2.2.2 ^^^ w.2.2.2.2)) := by
  decide +kernel

theorem sClaimQ : ∀ e < 8,
    (o0Codes.filter fun c =>
      !c.testBit 0 && (sE8.getD e []).all fun i => fixQB (sM i) c).length < 8 ∨
    ((∀ i ∈ sE8.getD e [], ∀ c ∈ o0Codes, mact (sM i) c ^^^ c ∈ sFixQ.getD e []) ∧
      ∀ f ∈ sFixQ.getD e [], ∃ w ∈ sWitQ.getD e [], w.1 = f ∧ w.2.1 ∈ sE8.getD e [] ∧
        w.2.2 ∈ o0Codes ∧
        (f = mact (sM w.2.1) w.2.2 ^^^ w.2.2 ∨ f = mact (sM w.2.1) w.2.2 ^^^ w.2.2 ^^^ 129)) := by
  decide +kernel

