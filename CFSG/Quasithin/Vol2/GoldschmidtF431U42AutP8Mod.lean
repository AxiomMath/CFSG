@[expose] def dL : PL := Kl1L.getD 1 []

@[expose] def a1L : PL := Kl1L.getD 2 []

@[expose] def b1L : PL := Alt1L.getD 4 []

@[expose] def T3L : List PL := Alt1L.filter fun m => m != idL && comp m (comp m m) == idL

theorem Kl1_check : idL ∈ Kl1L ∧ (∀ a ∈ Kl1L, ∀ b ∈ Kl1L, comp a b ∈ Kl1L) ∧ Kl1L.Nodup ∧
    Kl1L.length = 4 ∧ (∀ a ∈ Kl1L, a ∈ UL ∧ a ∈ Alt1L ∧ comp a a = idL) := by
  decide +kernel

theorem UL_check : idL ∈ UL ∧ (∀ a ∈ UL, ∀ b ∈ UL, comp a b ∈ UL) ∧ UL.Nodup ∧ UL.length = 8 ∧
    (∀ a ∈ UL, a ∈ Thl ∧ comp a fhatL = comp fhatL a) ∧ fhatL ∉ UL := by
  decide +kernel

theorem Alt1_check : idL ∈ Alt1L ∧ (∀ a ∈ Alt1L, ∀ b ∈ Alt1L, comp a b ∈ Alt1L) ∧ Alt1L.Nodup ∧
    Alt1L.length = 12 ∧ (∀ a ∈ Alt1L, a ∈ Dl1) := by
  decide +kernel

theorem U_struct : (∀ a ∈ UL, ∃ k ∈ Kl1L, ∃ l ∈ Bl1, comp k l = a) ∧
    (∀ k ∈ Kl1L, ∀ l ∈ Bl1, comp k l ∈ UL) ∧ dL ∈ Kl1L ∧ dL ∈ Bl1 ∧ dL ≠ idL ∧
    (∀ a ∈ UL, comp a dL = comp dL a) ∧
    (∀ a ∈ UL, (∀ m ∈ UL, comp a m = comp m a) → a = idL ∨ a = dL) ∧
    (∀ a ∈ UL, comp a a = idL → a ∈ Kl1L ∨ a ∈ Bl1) ∧ (∀ a ∈ Bl1, a ∈ UL) := by
  decide +kernel

theorem Alt1_odd : (∀ l ∈ Dl1, powL l 12 = idL) ∧
    (∀ l ∈ Dl1, comp l (comp l l) = idL → l ∈ Alt1L) := by
  decide +kernel

theorem Alt1_gen : ∀ l ∈ Alt1L, ∃ a ∈ T3L, ∃ b ∈ idL :: T3L, comp a b = l := by
  decide +kernel

theorem Alt1_invol : ∀ l ∈ Alt1L, comp l l = idL → l ∈ Kl1L := by decide +kernel

theorem b1_check : b1L ∈ Alt1L ∧ b1L ∈ T3L ∧ comp b1L (comp b1L b1L) = idL ∧ b1L ≠ idL ∧
    (∀ v ∈ Kl1L, comp (comp b1L v) (comp b1L b1L) ∈ Kl1L) ∧
    (∀ v ∈ Kl1L, v ≠ idL → v = dL ∨ v = comp (comp b1L dL) (comp b1L b1L) ∨
      v = comp (comp (comp b1L b1L) dL) b1L) := by
  decide +kernel

theorem Alt1_inner : ∀ y ∈ Alt1L,
    (∀ v ∈ Kl1L, comp y v = comp (comp (comp b1L v) (comp b1L b1L)) y) →
    ∃ w ∈ Kl1L, y = comp (comp w b1L) w := by
  decide +kernel

theorem CU_b1 : ∀ l ∈ UL, comp l b1L = comp b1L l → l = idL := by decide +kernel

