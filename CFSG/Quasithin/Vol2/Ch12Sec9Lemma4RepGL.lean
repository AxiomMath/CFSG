@[expose] def wordAt (i₁ i₂ i₃ i₄ i₅ : Nat) : List (Fin 5) :=
  wordTable.getD ((((i₁ * 2 + i₂) * 4 + i₃) * 4 + i₄) * 5 + i₅) []

@[expose] def c1s : List (Fin 16) := [6, 10, 14]

@[expose] def omegas : List (Fin 16 × Fin 16) := [(8, 12), (12, 4)]

@[expose] def d2s : List (Fin 16) := [4, 5, 6, 7]

@[expose] def d3s : List (Fin 16) := [8, 9, 10, 11]

@[expose] def gl42Check : Bool :=
  (List.range 3).all fun i₁ => (List.range 2).all fun i₂ => (List.range 4).all fun i₃ =>
    (List.range 4).all fun i₄ => (List.range 5).all fun i₅ =>
      good (fiveS.getD i₅ (false, false, false))
        (y1Code (c1s.getD i₁ 0) (omegas.getD i₂ (0, 0)).1 (omegas.getD i₂ (0, 0)).2)
        (y2Code (d2s.getD i₃ 0) (d3s.getD i₄ 0)) (wordAt i₁ i₂ i₃ i₄ i₅)

@[expose] def v1s : List (Fin 16) := [2, 3, 6, 7, 10, 11, 14, 15]

@[expose] def dMasks : List (Fin 16) := [4, 8, 12]

theorem shape_or_witness : ∀ v₁ ∈ v1s, ∀ v₂ ∈ dMasks, ∀ v₃ ∈ dMasks, v₂ ≠ v₃ →
    v₁ = 2 ∨ v₁ = 3 ∨ (v₁ ∈ c1s ∧ (v₂, v₃) ∈ omegas) ∨
      ∃ x : Fin 16, ((y1Code v₁ v₂ v₃).comp (y1Code v₁ v₂ v₃)).app x = x ∧
        (y1Code v₁ v₂ v₃).app x ≠ x := by
  decide

theorem sList_comp_mem : ∀ S ∈ fiveS, ∀ s ∈ sList S, ∀ s' ∈ sList S, s.comp s' ∈ sList S := by
  decide

theorem sList_comp_self : ∀ S ∈ fiveS, ∀ s ∈ sList S, s.comp s = idC := by decide

theorem tau1_comp_tau2 : tau1.comp tau2 = tau12 := by decide

theorem tau1_comp_tau12 : tau1.comp tau12 = tau2 := by decide

theorem tau2_comp_tau12 : tau2.comp tau12 = tau1 := by decide

theorem gl42Check_eq_true : gl42Check = true := by decide +kernel

theorem exists_getD_eq {α : Type} {l : List α} {x : α} (d : α) (hx : x ∈ l) :
    ∃ i < l.length, l.getD i d = x := by
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hx
  exact ⟨i, hi, by simp [List.getD_eq_getElem?_getD, hi]⟩

theorem exists_good {c₁ : Fin 16} (h₁ : c₁ ∈ c1s) {q : Fin 16 × Fin 16} (h₂ : q ∈ omegas)
    {d₂ : Fin 16} (h₃ : d₂ ∈ d2s) {d₃ : Fin 16} (h₄ : d₃ ∈ d3s) {S : Bool × Bool × Bool}
    (h₅ : S ∈ fiveS) : ∃ w, good S (y1Code c₁ q.1 q.2) (y2Code d₂ d₃) w = true := by
  obtain ⟨i₁, hi₁, e₁⟩ := exists_getD_eq 0 h₁
  obtain ⟨i₂, hi₂, e₂⟩ := exists_getD_eq (0, 0) h₂
  obtain ⟨i₃, hi₃, e₃⟩ := exists_getD_eq 0 h₃
  obtain ⟨i₄, hi₄, e₄⟩ := exists_getD_eq 0 h₄
  obtain ⟨i₅, hi₅, e₅⟩ := exists_getD_eq (false, false, false) h₅
  have h := gl42Check_eq_true
  simp only [gl42Check, List.all_eq_true, List.mem_range] at h
  refine ⟨wordAt i₁ i₂ i₃ i₄ i₅, ?_⟩
  have := h i₁ (by simpa [c1s] using hi₁) i₂ (by simpa [omegas] using hi₂) i₃
    (by simpa [d2s] using hi₃) i₄ (by simpa [d3s] using hi₄) i₅ (by simpa [fiveS] using hi₅)
  rwa [e₁, e₂, e₃, e₄, e₅] at this

end CFSG.Quasithin.H13.GL42
