module

public section

namespace CFSG.Quasithin.H13.GL42

structure Code where
  v0 : Fin 16
  v1 : Fin 16
  v2 : Fin 16
  v3 : Fin 16
deriving DecidableEq

@[expose] def Code.app (c : Code) (n : Fin 16) : Fin 16 :=
  ⟨((if n.val % 2 = 1 then c.v0.val else 0) ^^^ (if n.val / 2 % 2 = 1 then c.v1.val else 0) ^^^
      (if n.val / 4 % 2 = 1 then c.v2.val else 0) ^^^
      (if n.val / 8 % 2 = 1 then c.v3.val else 0)) % 16, Nat.mod_lt _ (by decide)⟩

@[expose] def Code.comp (c e : Code) : Code :=
  ⟨c.app e.v0, c.app e.v1, c.app e.v2, c.app e.v3⟩

@[expose] def idC : Code := ⟨1, 2, 4, 8⟩

@[expose] def tau1 : Code := ⟨1, 3, 4, 8⟩

@[expose] def tau2 : Code := ⟨1, 2, 4, 12⟩

@[expose] def tau12 : Code := ⟨1, 3, 4, 12⟩

@[expose] def sList (S : Bool × Bool × Bool) : List Code :=
  idC :: ((if S.1 then [tau1] else []) ++ (if S.2.1 then [tau2] else []) ++
    (if S.2.2 then [tau12] else []))

@[expose] def fiveS : List (Bool × Bool × Bool) :=
  [(false, false, false), (true, false, false), (false, true, false), (false, false, true),
    (true, true, true)]

@[expose] def y1Code (c₁ c₂ c₃ : Fin 16) : Code := ⟨1, c₁, c₂, c₃⟩

@[expose] def y2Code (d₂ d₃ : Fin 16) : Code := ⟨2, 3, d₂, d₃⟩

@[expose] def letter (y₁ y₂ : Code) (l : Fin 5) : Code :=
  match l with
  | 0 => tau1
  | 1 => tau2
  | 2 => tau12
  | 3 => y₁
  | 4 => y₂

@[expose] def allowed (S : Bool × Bool × Bool) (l : Fin 5) : Bool :=
  match l with
  | 0 => S.1
  | 1 => S.2.1
  | 2 => S.2.2
  | 3 => true
  | 4 => true

@[expose] def evalWord (y₁ y₂ : Code) (w : List (Fin 5)) : Code :=
  w.foldl (fun g l => g.comp (letter y₁ y₂ l)) idC

@[expose] def memS (S : Bool × Bool × Bool) (c : Code) : Bool :=
  (sList S).any fun s => decide (s = c)

@[expose] def good (S : Bool × Bool × Bool) (y₁ y₂ : Code) (w : List (Fin 5)) : Bool :=
  let g := evalWord y₁ y₂ w
  w.all (allowed S) && !(memS S g) && memS S (g.comp g) &&
    (sList S).all fun s => (sList S).any fun s' => decide (g.comp s = s'.comp g)

