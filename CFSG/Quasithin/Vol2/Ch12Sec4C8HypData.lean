    mmul (wMat o3W9) (mmul (wMat o3W9) (wMat o3W9)) = idMat ∧
    (∃ c ∈ o0Codes, parB 9 c = true ∧ parB 9 (mact (wMat o3W9) c) = false) := by
  decide +kernel

