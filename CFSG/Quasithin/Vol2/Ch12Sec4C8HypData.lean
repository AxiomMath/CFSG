@[expose] def parB (b c : ℕ) : Bool :=
  !(c.testBit 0 ^^ (b.testBit 0 && c.testBit 1) ^^ (b.testBit 1 && c.testBit 2) ^^
    (b.testBit 2 && c.testBit 3) ^^ (b.testBit 3 && c.testBit 4) ^^
    (b.testBit 4 && c.testBit 5) ^^ (b.testBit 5 && c.testBit 6))

@[expose] def hypMaps (m : List ℕ) (b b' : ℕ) : Bool :=
  o0Codes.all fun c => parB b' (mact m c) == parB b c

@[expose] def wMat (w : List ℕ) : List ℕ := (List.range 8).map fun k => applyG w (2 ^ k)

@[expose] def wprod (gs : List (List ℕ)) (w : List ℕ) : List ℕ :=
  w.foldr (fun i m => mmul (gs.getD i []) m) idMat

@[expose] def sing (b : ℕ) : ℕ :=
  (o0Codes.filter fun c => parB b c && decide (zornNorm (decodeZ c) = 0)).length

@[expose] def basO : List ℕ := [129, 2, 4, 8, 16, 32, 64]

@[expose] def decomp (c : ℕ) : List ℕ := basO.filter fun d => c &&& d == d

@[expose] def outB (b d : ℕ) : Bool :=
  d == 129 || (d == 2 && b.testBit 0) || (d == 4 && b.testBit 1) || (d == 8 && b.testBit 2) ||
    (d == 16 && b.testBit 3) || (d == 32 && b.testBit 4) || (d == 64 && b.testBit 5)

