theorem decomp_check : (∀ c ∈ o0Codes, (decomp c).foldr (· ^^^ ·) 0 = c) ∧
    (∀ d ∈ basO, d ∈ o0Codes) ∧
    ∀ b < 64, ∀ c ∈ o0Codes, (decide (Even ((decomp c).countP (outB b))) = parB b c) := by
  decide +kernel

theorem orb_check : (∀ b < 64, (∀ t ∈ orbW.getD b [], t = 1 ∨ t = 2) ∧
    wMat (orbW.getD b []) = orbM.getD b [] ∧ hypMaps (orbM.getD b []) (orbR.getD b 0) b = true ∧
    (orbR.getD b 0 = 0 ∨ orbR.getD b 0 = 9) ∧ sing b = sing (orbR.getD b 0)) ∧
    sing 0 ≠ sing 9 := by
  decide +kernel

theorem t0_check : (∀ t ∈ tW0, t = 1 ∨ t = 2) ∧
    mmul (wMat [1]) (mmul (wMat [1]) (wMat [1])) = idMat ∧ wMat [1] ≠ idMat ∧
    hypMaps (wMat [1]) 0 0 = true ∧ (∃ c ∈ o0Codes, parB 0 c = true ∧ mact (wMat [1]) c ≠ c) ∧
    hypMaps (mmul (mmul (wMat tW0) matX) (mmul (wMat tW0) matX)) 0 0 = true ∧
    (∃ c ∈ o0Codes, parB 0 c = true ∧ parB 0 (mact (mmul (wMat tW0) matX) c) = false) ∧
    mmul (mmul (wMat tW0) matX) (wMat [1]) =
      mmul (mmul (wMat [1]) (wMat [1])) (mmul (wMat tW0) matX) := by
  decide +kernel

theorem y_check : (∀ t ∈ yaW, t = 1 ∨ t = 2) ∧ (∀ t ∈ ybW, t = 1 ∨ t = 2) ∧
    yMats.length = 27 ∧ yMats.Nodup ∧ yWords.length = 27 ∧
    (∀ i < 27, wprod [wMat yaW, wMat ybW] (yWords.getD i []) = yMats.getD i [] ∧
      ∀ j ∈ yWords.getD i [], j < 2) ∧
    (∀ m ∈ yMats, ∀ n ∈ yMats, mmul m n ∈ yMats) ∧ idMat ∈ yMats ∧
    (∀ m ∈ yMats, mmul m (mmul m m) = idMat) ∧ (∀ m ∈ yMats, hypMaps m 9 9 = true) ∧
    (∀ m ∈ yMats, m ≠ idMat → ∃ c ∈ o0Codes, parB 9 c = true ∧ mact m c ≠ c) := by
  decide +kernel

theorem max_check0 : (∀ t ∈ h1W0, t = 1 ∨ t = 2) ∧ (∀ t ∈ h2W0, t = 1 ∨ t = 2) ∧
    hypMaps (wMat h1W0) 0 0 = true ∧ hypMaps (wMat h2W0) 0 0 = true ∧
    (∀ e ∈ subW0, hypMaps (wprod [wMat h1W0, wMat h2W0] e.2.1) e.1 e.2.2 = true ∧
      e.2.2 ∈ reps0 ∧ ∀ j ∈ e.2.1, j < 2) ∧
    (∀ b < 64, orbR.getD b 0 = 0 → b ≠ 0 → ∃ e ∈ subW0, e.1 = b) ∧
    (∀ ρ ∈ reps0, ρ < 64 ∧ orbR.getD ρ 0 = 0 ∧ ∃ e ∈ cW0, e.1 = ρ) ∧
    (∀ e ∈ cW0, wprod [wMat h1W0, wMat h2W0, orbM.getD e.1 []] e.2.1 = wMat [1] ∧
      wprod [wMat h1W0, wMat h2W0, orbM.getD e.1 []] e.2.2 = wMat [2] ∧
      (∀ j ∈ e.2.1, j < 3) ∧ ∀ j ∈ e.2.2, j < 3) := by
  decide +kernel

theorem max_check9 : (∀ t ∈ h1W9, t = 1 ∨ t = 2) ∧ (∀ t ∈ h2W9, t = 1 ∨ t = 2) ∧
    hypMaps (wMat h1W9) 9 9 = true ∧ hypMaps (wMat h2W9) 9 9 = true ∧
    (∀ e ∈ subW9, hypMaps (wprod [wMat h1W9, wMat h2W9] e.2.1) e.1 e.2.2 = true ∧
      e.2.2 ∈ reps9 ∧ ∀ j ∈ e.2.1, j < 2) ∧
    (∀ b < 64, orbR.getD b 0 = 9 → b ≠ 9 → ∃ e ∈ subW9, e.1 = b) ∧
    (∀ ρ ∈ reps9, ρ < 64 ∧ orbR.getD ρ 0 = 9 ∧ ∃ e ∈ cW9, e.1 = ρ) ∧
    (∀ e ∈ cW9, wprod [wMat h1W9, wMat h2W9, orbM.getD e.1 []] e.2.1 = wMat [1] ∧
      wprod [wMat h1W9, wMat h2W9, orbM.getD e.1 []] e.2.2 = wMat [2] ∧
      (∀ j ∈ e.2.1, j < 3) ∧ ∀ j ∈ e.2.2, j < 3) := by
