theorem ru_o2_Y2 :
    Nat.card (pCoreOf 2 (ruCtx.Y 2)) = 2048 := by
  obtain ⟨m, hm, h1, h2, -⟩ := ru_row 2 (by norm_num)
  have hc : Nat.card (ruCtx.Y 2) = 344064 := by
    rw [ru_member_card 2 (by norm_num)]
    rfl
  simp only [ruMems, List.mem_cons, List.not_mem_nil, or_false] at hm
  rcases hm with rfl | rfl | rfl | rfl | rfl
  all_goals first
    | (exfalso; simp only at h1; omega)
    | simpa using h2

theorem ru_dist :
    ∀ j ≤ 5, j ≠ 2 →
    Nat.card (memberOrTop 5 ruCtx.Y j) ≠ Nat.card (ruCtx.Y 2) := by
  intro j hj hj2
  have hc2 : Nat.card (ruCtx.Y 2) = 344064 := by
    rw [ru_member_card 2 (by norm_num)]
    rfl
  rcases Nat.lt_or_ge j 5 with h | h
  · have hm : memberOrTop 5 ruCtx.Y j = ruCtx.Y j := by simp [memberOrTop, h]
    rw [hm, hc2, ru_member_card j h]
    interval_cases j <;> simp_all
  · have hj5 : j = 5 := by omega
    subst hj5
    have hm : memberOrTop 5 ruCtx.Y 5 = ⊤ := by simp [memberOrTop]
    rw [hm, Subgroup.card_top, ru_card, hc2]
    norm_num

theorem map_centralizer_subtype {G : Type} [Group G] (A : Subgroup G) (τ : ↥A) :
    (Subgroup.centralizer ({τ} : Set ↥A)).map A.subtype =
      A ⊓ Subgroup.centralizer ({(τ : G)} : Set G) := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    refine ⟨y.2, Subgroup.mem_centralizer_singleton_iff.mpr ?_⟩
    exact congrArg Subtype.val (Subgroup.mem_centralizer_singleton_iff.mp hy)
  · rintro ⟨hxA, hxc⟩
    refine ⟨⟨x, hxA⟩, Subgroup.mem_centralizer_singleton_iff.mpr (Subtype.ext ?_), rfl⟩
    exact Subgroup.mem_centralizer_singleton_iff.mp hxc

theorem ru_cent_card
    {H : Type} [Group H] (e : H ≃* Carrier .Ru) {t : H}
    (ht : orderOf t = 2) :
    Nat.card (Subgroup.centralizer ({t} : Set H)) = 245760 ∨
      Nat.card (Subgroup.centralizer ({t} : Set H)) = 116480 := by
  let φ : H ≃* ↥CFSG.Sporadic.RuSchreier.ruP :=
    e.trans CFSG.QuasithinUnique.Id2519.MathNoLayer.ruEquivCar
  have h1 := CFSG.Quasithin.cmax_card_centralizer_equiv φ t
  have hτ2 : orderOf (φ t : Equiv.Perm (Fin 4060)) = 2 := by
    rw [Subgroup.orderOf_coe, MulEquiv.orderOf_eq]
    exact ht
  rw [h1, ← Subgroup.card_map_of_injective
    (Subgroup.subtype_injective CFSG.Sporadic.RuSchreier.ruP), map_centralizer_subtype]
  exact CFSG.QuasithinUnique.Id2519.MathNoLayer.ru_centralizer_card (φ t).2 hτ2

theorem ru_inv
    {H : Type} [Group H] (e : H ≃* Carrier .Ru) :
    ∀ t : H, orderOf t = 2 → ¬ 21 ∣ Nat.card (Subgroup.centralizer ({t} : Set H)) := by
  intro t ht h21
  rcases ru_cent_card e ht with h | h <;> (rw [h] at h21; omega)

theorem ru_cent
    {H : Type} [Group H] (e : H ≃* Carrier .Ru) :
    ∀ t : H, orderOf t = 2 → 2 ^ 11 ∣ Nat.card (Subgroup.centralizer ({t} : Set H)) →
      ¬ 7 ∣ Nat.card (Subgroup.centralizer ({t} : Set H)) := by
  intro t ht h2 h7
  rcases ru_cent_card e ht with h | h <;> (rw [h] at h2 h7; omega)

theorem input15122RuModel_holds :
    HSRuLoc.Input15122RuModel := by
  intro H _ _ hH P hP
  obtain ⟨e⟩ := hH
  have hXΓ : Nonempty (H ≃* J ruData) := ⟨e.trans (seedEquiv ru_facts.toBaseFacts)⟩
  obtain ⟨ψ, hψ, huniqψ⟩ := unique_member_of_lattice (S := ruCtx.S) ru_S_sylow 5 ruCtx.Y
    ru_complete (j₀ := 2) (by norm_num) ru_dist hXΓ hP
  set K : Subgroup H := (ruCtx.Y 2).map ψ.symm.toMonoidHom with hK
  have hc2 : Nat.card (ruCtx.Y 2) = 344064 := by
    rw [ru_member_card 2 (by norm_num)]
    rfl
  have hKcard : Nat.card K = 344064 := by
    rw [hK, Subgroup.card_map_of_injective ψ.symm.injective, hc2]
  have hPcard : Nat.card P = 16384 := by
    rw [← Subgroup.card_map_of_injective (f := ψ.toMonoidHom) ψ.injective, hψ, ru_card_S]
  have hPK : P ≤ K := by
    intro x hx
    have hxS : ψ x ∈ ruCtx.S := hψ ▸ Subgroup.mem_map_of_mem _ hx
    exact ⟨ψ x, ruCtx.S_le_Y 2 hxS, by simp⟩
  have hcard : Nat.card K = 21 * Nat.card P := by rw [hKcard, hPcard]
  have huniq : ∀ X : Subgroup H, P ≤ X → Nat.card X = Nat.card K → X = K := fun X hX hc =>
    huniqψ X hX (by rw [hc, hKcard, hc2])
  have hO2 : Nat.card (pCoreOf 2 K) * 8 = Nat.card P := by
    rw [hK, CFSG.LieType.BorelTits.pCoreOf_map_mulEquiv 2 ψ.symm (ruCtx.Y 2),
      Subgroup.card_map_of_injective ψ.symm.injective, ru_o2_Y2, hPcard]
  have hKtop : K ≠ ⊤ := by
    intro h
    have h1 := hKcard
    rw [h, Subgroup.card_top, Nat.card_congr ψ.toEquiv, ru_card] at h1
    omega
  have hov : ∀ Z : Subgroup H, P ≤ Z → Z ≠ ⊤ →
      (Nat.card Z = Nat.card P ∧ Nat.card (pCoreOf 2 Z) = Nat.card P) ∨
        Nat.card Z = 15 * Nat.card P ∨ Nat.card Z = 21 * Nat.card P ∨
        (Nat.card Z = 3 * Nat.card P ∧ Nat.card (pCoreOf 2 Z) * 2 = Nat.card P) := by
    intro Z hPZ hZ
    rcases ru_overgroups ⟨e⟩ hP hPZ with h | ⟨m, hm, hord, ho2, -⟩
    · exact absurd h hZ
    · simp only [ruMems, List.mem_cons, List.not_mem_nil, or_false] at hm
      rw [hPcard]
      rcases hm with rfl | rfl | rfl | rfl | rfl <;> simp only at hord ho2 <;> omega
  have hodd : ∀ (N : Subgroup ↥K) [N.Normal], IsPGroup 2 (↥K ⧸ N) → Nat.card (↥K ⧸ N) ≤ 1 :=
    noTwoQuot_map_equiv ψ.symm (ruCtx.Y 2) (fun N' _ hp' =>
      CFSG.Quasithin.A312Ru.ru_Y2_quot N' hp')
  have hK21 : Nat.card K = 21 * 2 ^ (11 + 3) := by rw [hKcard]; norm_num
  obtain ⟨u, y, huK, hyK, hu, hy, huy⟩ := exists_order7_order3_in hK21
  have hRcard : Nat.card (pCoreOf 2 K) = 2 ^ 11 := by omega
  have hR4 : ∃ x ∈ pCoreOf 2 K, x ^ 2 ≠ 1 :=
    hsru_exists_sq_ne_one hRcard (by norm_num) hu
      (fun x hx => (Subgroup.mem_normalizer_iff.mp
        (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 K huK) x).mp hx) (ru_cent e)
  exact ⟨K, pCoreOf 2 K, 11, hsruModel_of_data hP.2.1 hPK hcard huniq hO2
    (by rw [hPcard]; norm_num) (hrows_of_overgroups hKtop hcard huniq hov) hodd (ru_inv e) hR4
    ⟨by norm_num, by norm_num, by norm_num⟩⟩

