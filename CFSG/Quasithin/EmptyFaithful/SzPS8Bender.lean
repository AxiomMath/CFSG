theorem sqtk_of_isHTM (hyp : Hyp1421 G T M) {H : Subgroup G} (hH : IsHTM T M H) :
    SQTKGroup ↥H :=
  ⟨stronglyQuasithin_of_pCoreOf_ne_bot hyp.qtke hH.1.2,
    kGroup_of_pCoreOf_ne_bot hyp.qtke hyp.simple hyp.nonabelian hH.1.2⟩

theorem le_of_mem_cComp_of_le_sup_of_normalizes (hsyl : IsSylowTwoOf T (K ⊔ T))
    (hTN : T ≤ Subgroup.normalizer (K : Set G)) {H₂ K₂ : Subgroup G} (hH₂ : H₂ ≤ K ⊔ T)
    (hK₂ : K₂ ∈ cComp H₂) : K₂ ≤ K := by
  have hT2 : IsPGroup 2 T := hsyl.2.1
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hTs : Group.IsSolvable ↥T := by
    have := hT2.isNilpotent
    infer_instance
  have hKnorm : ((K.subgroupOf (K ⊔ T))).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer le_sup_left).mpr
      (sup_le Subgroup.le_normalizer hTN)
  have h1 : perfectCore (K ⊔ T) ≤ K :=
    perfectCore_le_of_sup_solvable le_sup_left hKnorm rfl hTs
  exact (le_perfectCore_of_perfect (le_of_mem_cComp hK₂ |>.trans hH₂)
    (perfect_of_mem_cComp hK₂)).trans h1

theorem pCoreOf_le_kerIn_of_isSylowTwoOf (hTM : T ≤ M) {H₂ : Subgroup G}
    (hsyl : IsSylowTwoOf T H₂) : pCoreOf 2 H₂ ≤ kerIn (H₂ ⊓ M) H₂ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine le_kerIn_of_le_normalizer (le_inf (CFSG.LieType.BorelTits.pCoreOf_le 2 H₂)
    ((pCoreOf_two_le_of_isSylowTwoOf hsyl).trans hTM)) ?_
  exact CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 H₂

theorem false_of_bender_borel
    (hE22 : E2.E22StatementNoN) (hF : FieldOne1432) (hyp : Hyp1421 G T M)
    (hnot : ¬ SixModels G) (hHTM : IsHTM T M (K ⊔ T)) (hKc : K ∈ cComp (K ⊔ T))
    (hTN : T ≤ Subgroup.normalizer (K : Set G))
    (hsimp : IsSimpleGroup (KBar K)) (hBen : fusionIsBenderGroup (KBar K))
    {m : ℕ} (hm : 2 ≤ m) (hcard : Nat.card (KBar K) = ordL2 m)
    (hB : K ⊓ Subgroup.normalizer ((T ⊓ K : Subgroup G) : Set G) ≤ M) : False := by
  have hTM : T ≤ M := hyp.m_max.1.2
  have hsyl : IsSylowTwoOf T (K ⊔ T) :=
    isSylowTwoOf_of_quasithinIsSylowTwo hyp.sylow le_sup_right
  have hsylK : IsSylowTwoOf (T ⊓ K) K :=
    A312.isSylowTwoOf_inf_of_subnormal (subnormal_of_mem_cComp hKc) hsyl
  have hpc : pCoreOf 2 K ≤ T ⊓ K := pCoreOf_two_le_of_isSylowTwoOf hsylK
  have hSyl : IsSylowTwoOf (imgJ K (pCoreOf 2 K) (T ⊓ K)) ⊤ := isSylowTwoOf_imgJ hsylK hpc
  have hLat1 : ∀ Y : Subgroup (KBar K), imgJ K (pCoreOf 2 K) (T ⊓ K) ≤ Y → Y ≠ ⊤ →
      Y ≤ Subgroup.normalizer
        ((imgJ K (pCoreOf 2 K) (T ⊓ K) : Subgroup (KBar K)) : Set (KBar K)) := by
    intro Y hUY hY
    have hB' : fusionIsBenderGroup ↥(⊤ : Subgroup (KBar K)) :=
      fusionIsBenderGroup_congr Subgroup.topEquiv.symm hBen
    rcases bender_overgroup (A := ⊤) hB' hSyl hUY le_top with h | h
    · exact h
    · exact absurd (top_le_iff.mp h) hY
  have hStar : IsHStar T M (K ⊔ T) := by
    refine ⟨hHTM.1, hHTM.2, fun Y hY hYH hYM => ?_⟩
    by_contra hne
    apply hYM
    have hTY : T ≤ Y := hY.1
    have hsupY : Y = T ⊔ (Y ⊓ K) :=
      A3.eq_sup_inf_of_le_sup hTN hTY (hYH.trans (sup_comm K T).le)
    have hne' : Y ⊓ K ≠ K := fun h =>
      hne (le_antisymm hYH (sup_le (by rw [← h]; exact inf_le_left) hTY))
    have hSY : T ⊓ K ≤ Y ⊓ K := inf_le_inf_right K hTY
    have hJY : pCoreOf 2 K ≤ Y ⊓ K := hpc.trans hSY
    have hU := imgJ_mono (H := K) (J := pCoreOf 2 K) hSY
    have htop : imgJ K (pCoreOf 2 K) (Y ⊓ K) ≠ ⊤ := fun h =>
      hne' ((imgJ_eq_top_iff hJY inf_le_right).mp h)
    have h1 := hLat1 _ hU htop
    have hYB : Y ⊓ K ≤ Subgroup.normalizer ((T ⊓ K : Subgroup G) : Set G) :=
      le_normalizer_of_imgJ hpc hSY inf_le_right h1
    calc Y = T ⊔ (Y ⊓ K) := hsupY
      _ ≤ M := sup_le hTM ((le_inf inf_le_right hYB).trans hB)
  have hns : ¬ Group.IsSolvable ↥(K ⊔ T) := fun hs =>
    not_isSolvable_of_mem_cComp hKc
      (Group.isSolvable_of_isSolvable_injective
        (f := Subgroup.inclusion (le_sup_left : K ≤ K ⊔ T))
        (Subgroup.inclusion_injective (le_sup_left : K ≤ K ⊔ T)))
  have hMinP : MinParabolic (K ⊔ T) T ((K ⊔ T) ⊓ M) := hyp.minParabolic hStar
  have hsqtk := sqtk_of_isHTM hyp hHTM
  obtain ⟨⟨K₂, hK₂c, hHK₂, -, hcases⟩, -⟩ := hE22 G (K ⊔ T) T ((K ⊔ T) ⊓ M) hMinP hsqtk hns
  have hF1 : ∀ n : ℕ, A38c12.E22Field (K ⊔ T) T ((K ⊔ T) ⊓ M) K₂ n → n = 1 := fun n hn =>
    hF G T M hyp hnot (K ⊔ T) K₂ hStar hns hK₂c hHK₂ hcases n hn
  have hK₂K : K₂ ≤ K := le_of_mem_cComp_of_le_sup_of_normalizes hsyl hTN le_rfl hK₂c
  have hK₂ : K₂ = K := by
    have h1 : K₂ ∈ cComp K := cComp_mem_of_le hK₂c hK₂K le_sup_left
    rw [cComp_self_eq_singleton hKc] at h1
    exact h1
  rw [hK₂] at hcases hF1
  have hJH : kerIn ((K ⊔ T) ⊓ M) (K ⊔ T) ≤ K ⊔ T := kerIn_le.trans inf_le_left
  have hOJ : pCoreOf 2 K ≤ kerIn ((K ⊔ T) ⊓ M) (K ⊔ T) :=
    (A4.pCoreOf_le_of_subnormal 2 (subnormal_of_mem_cComp hKc)).trans
      (pCoreOf_le_kerIn_of_isSylowTwoOf hTM hsyl)
  have hKJ : ¬ K ≤ kerIn ((K ⊔ T) ⊓ M) (K ⊔ T) := by
    intro h
    exact hHTM.2 (sup_le (h.trans (kerIn_le.trans inf_le_right)) hTM)
  have hinf : K ⊓ kerIn ((K ⊔ T) ⊓ M) (K ⊔ T) = pCoreOf 2 K :=
    inf_eq_pCoreOf_of_simple (le_sup_left : K ≤ K ⊔ T) hJH hOJ hKJ hsimp
  obtain ⟨e⟩ := nonempty_kbar_equiv_imgJ (J := kerIn ((K ⊔ T) ⊓ M) (K ⊔ T))
    (le_sup_left : K ≤ K ⊔ T) hinf
  have hcard' : Nat.card ↥(E2.star ((K ⊔ T) ⊓ M) (K ⊔ T) K) = ordL2 m :=
    (Nat.card_congr e.toEquiv).symm.trans hcard
  exact A38c12.e22_cases_false' arithAll hm hcard' hF1 hcases

theorem false_of_bender_pair_borel
    (hE22 : E2.E22StatementNoN) (hF : FieldOne1432) (hyp : Hyp1421 G T M)
    (hnot : ¬ SixModels G) (hHTM : IsHTM T M (conjClosure K T ⊔ T))
    (hKc : K ∈ cComp (conjClosure K T ⊔ T))
    (hpair : IsPairIn T K) (hsimp : IsSimpleGroup (KBar K))
    (hshape : (∃ n, IsPSL 2 2 n (KBar K)) ∨ (∃ n, IsSz n (KBar K)) ∨ IsAlt 5 (KBar K))
    (hBM : conjClosure K T ⊓
      Subgroup.normalizer ((T ⊓ conjClosure K T : Subgroup G) : Set G) ≤ M) : False := by
  obtain ⟨t, htT, htK, hK₀, hcomm⟩ := hpair
  set K₀ : Subgroup G := conjClosure K T with hK₀def
  set H : Subgroup G := K₀ ⊔ T with hHdef
  have hsyl : IsSylowTwoOf T H := isSylowTwoOf_of_quasithinIsSylowTwo hyp.sylow le_sup_right
  have hBen : fusionIsBenderGroup (KBar K) := fusionIsBenderGroup_of_shape hshape
  obtain ⟨hdich, hclass⟩ := pair_facts hsyl hKc htT htK hK₀ hcomm hsimp hBen
  have hTM : T ≤ M := hyp.m_max.1.2
  have hStar : IsHStar T M H := by
    refine ⟨hHTM.1, hHTM.2, fun Y hY hYH hYM => ?_⟩
    by_contra hne
    apply hYM
    rcases hdich Y hY.1 hYH with hfull | hnorm
    · exact absurd (le_antisymm hYH (sup_le hfull hY.1)) hne
    · have hY0 : Y ⊓ K₀ ≤ M := (le_inf inf_le_right hnorm).trans hBM
      have hYeq : Y = T ⊔ (Y ⊓ K₀) :=
        A3.eq_sup_inf_of_le_sup (le_normalizer_conjClosure K T) hY.1
          (hYH.trans (sup_comm K₀ T).le)
      rw [hYeq]
      exact sup_le hTM hY0
  have hMinP : MinParabolic H T (H ⊓ M) := hyp.minParabolic hStar
  have hsqtk : SQTKGroup ↥H := sqtk_of_isHTM hyp hHTM
  have hKH : K ≤ H := le_of_mem_cComp hKc
  have hnonsolv : ¬ Group.IsSolvable ↥H := fun hs => by
    have : Group.IsSolvable ↥H := hs
    exact not_isSolvable_of_mem_cComp hKc
      (Group.isSolvable_of_isSolvable_injective (f := Subgroup.inclusion hKH)
        (Subgroup.inclusion_injective hKH))
  obtain ⟨⟨K₂, hK₂c, hHK₂, -, hcases⟩, -⟩ := hE22 G H T (H ⊓ M) hMinP hsqtk hnonsolv
  have hK₂cl := hclass K₂ hK₂c
  have hF1 : ∀ n : ℕ, A38c12.E22Field H T (H ⊓ M) K₂ n → n = 1 := fun n hn =>
    hF G T M hyp hnot H K₂ hStar hnonsolv hK₂c hHK₂ hcases n hn
  unfold E2.E22CasesNoN at hcases
  dsimp only at hcases
  rcases hcases with ⟨hker, -, -, -, -, h1⟩ | ⟨hTN, -, -⟩
  · rcases h1 with ⟨n, hn2, hsh, hB⟩ | ⟨p, hp, hp8, hPSL, -, -⟩
    · have h4 : n = 1 := hF1 n (Or.inl ⟨hn2, hsh, hB⟩)
      omega
    · have hK₂H : K₂ ≤ H := le_of_mem_cComp hK₂c
      have hKJ : K₂ ⊓ kerIn (H ⊓ M) H = pCoreOf 2 K₂ := by
        rw [hker]
        exact inf_pCoreOf_eq_of_mem_cComp hK₂c
      obtain ⟨eKs⟩ := nonempty_kbar_equiv_imgJ (J := kerIn (H ⊓ M) H) hK₂H hKJ
      have hcard : Nat.card (KBar K) = Nat.card ↥(E2.star (H ⊓ M) H K₂) := by
        rcases hK₂cl with rfl | rfl
        · exact Nat.card_congr eKs.toEquiv
        · obtain ⟨ec⟩ := nonempty_kbar_conj t K
          exact (Nat.card_congr ec.toEquiv).symm.trans (Nat.card_congr eKs.toEquiv)
      exact false_of_shape_card_eq_psl_two_odd hp8 hPSL hshape hcard
  · rcases hK₂cl with rfl | rfl
    · exact htK (hTN htT)
    · apply htK
      have h5 : t ∈ Subgroup.normalizer
          ((K.map (MulAut.conj t).toMonoidHom : Subgroup G) : Set G) := hTN htT
      have h6 := Subgroup.mem_normalizer_iff_map_conj_eq.mp h5
      exact A38.map_conj_eq_iff.mp
        (Subgroup.map_injective (MulAut.conj t).injective (h6.trans rfl))

end SzPS8

