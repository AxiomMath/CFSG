theorem sl2_alg {F : Type} [Field F] (h2 : (2 : F) = 0) (a b c d x y u v : F)
    (hdz : 1 = a * d - b * c) (hdl : 1 = x * v - y * u)
    (z00 : a * a + b * c = 1) (z01 : a * b + b * d = 0) (z10 : c * a + d * c = 0)
    (z11 : c * b + d * d = 1) (c01 : x * b + y * d = a * y + b * v)
    (c10 : u * a + v * c = c * x + d * u) (hz1 : ¬ (a = 1 ∧ b = 0 ∧ c = 0 ∧ d = 1)) :
    x * x + y * u = 1 ∧ x * y + y * v = 0 ∧ u * x + v * u = 0 ∧ u * y + v * v = 1 := by
  have hsq : ∀ t : F, t * t = 1 → t = 1 := by
    intro t ht
    have : (t - 1) * (t - 1) = 0 := by linear_combination ht + (1 - t) * h2
    have := mul_self_eq_zero.mp this
    linear_combination this
  by_cases hbc : b = 0 ∧ c = 0
  · exfalso
    obtain ⟨hb, hc⟩ := hbc
    subst hb; subst hc
    have ha : a = 1 := hsq a (by linear_combination z00)
    have hd : d = 1 := hsq d (by linear_combination z11)
    exact hz1 ⟨ha, rfl, rfl, hd⟩
  · have hbc' : b ≠ 0 ∨ c ≠ 0 := not_and_or.mp hbc
    have had : a + d = 0 := by
      rcases hbc' with hb | hc
      · have : b * (a + d) = 0 := by linear_combination z01
        exact (mul_eq_zero.mp this).resolve_left hb
      · have : c * (a + d) = 0 := by linear_combination z10
        exact (mul_eq_zero.mp this).resolve_left hc
    have hda : d = a := by linear_combination had - a * h2
    subst hda
    have hxv : x = v := by
      rcases hbc' with hb | hc
      · have : b * (x - v) = 0 := by linear_combination c01
        have := (mul_eq_zero.mp this).resolve_left hb
        linear_combination this
      · have : c * (v - x) = 0 := by linear_combination c10
        have := (mul_eq_zero.mp this).resolve_left hc
        linear_combination -this
    subst hxv
    refine ⟨?_, ?_, ?_, ?_⟩
    · linear_combination -hdl + y * u * h2
    · linear_combination y * x * h2
    · linear_combination u * x * h2
    · linear_combination -hdl + y * u * h2

theorem sl2_sq_eq_one_of_commute {F : Type} [Field F] [CharP F 2] (z l : SL(2, F))
    (hz2 : z * z = 1) (hz1 : z ≠ 1) (hc : l * z = z * l) : l * l = 1 := by
  have h2 : (2 : F) = 0 := by
    have := CharP.cast_eq_zero F 2
    simpa using this
  have hzz := congrArg (fun g : SL(2, F) => (g : Matrix (Fin 2) (Fin 2) F)) hz2
  have hcc := congrArg (fun g : SL(2, F) => (g : Matrix (Fin 2) (Fin 2) F)) hc
  simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_one] at hzz hcc
  have hdz := Matrix.det_fin_two (z : Matrix (Fin 2) (Fin 2) F)
  rw [Matrix.SpecialLinearGroup.det_coe] at hdz
  have hdl := Matrix.det_fin_two (l : Matrix (Fin 2) (Fin 2) F)
  rw [Matrix.SpecialLinearGroup.det_coe] at hdl
  have z00 := congrFun (congrFun hzz 0) 0
  have z01 := congrFun (congrFun hzz 0) 1
  have z10 := congrFun (congrFun hzz 1) 0
  have z11 := congrFun (congrFun hzz 1) 1
  have c01 := congrFun (congrFun hcc 0) 1
  have c10 := congrFun (congrFun hcc 1) 0
  simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply_eq, Matrix.one_apply_ne,
    ne_eq, one_ne_zero, not_false_eq_true, zero_ne_one, Fin.isValue] at z00 z01 z10 z11 c01 c10
  have hz1' : ¬ ((z : Matrix (Fin 2) (Fin 2) F) 0 0 = 1 ∧ (z : Matrix (Fin 2) (Fin 2) F) 0 1 = 0 ∧
      (z : Matrix (Fin 2) (Fin 2) F) 1 0 = 0 ∧ (z : Matrix (Fin 2) (Fin 2) F) 1 1 = 1) := by
    rintro ⟨h00, h01, h10, h11⟩
    apply hz1
    apply Subtype.ext
    ext i j
    fin_cases i <;> fin_cases j <;> simp [h00, h01, h10, h11]
  obtain ⟨r00, r01, r10, r11⟩ :=
    sl2_alg h2 _ _ _ _ _ _ _ _ hdz hdl z00 z01 z10 z11 c01 c10 hz1'
  apply Subtype.ext
  ext i j
  simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_one, Matrix.mul_apply,
    Fin.sum_univ_two, Fin.isValue]
  fin_cases i <;> fin_cases j <;> simp <;> assumption

@[expose] def EvenL2Fam (L : Type) [Group L] : Prop :=
  ∃ f : ℕ, 2 ≤ f ∧ f ≤ 8 ∧ StatedClassicalModel L .PSL 2 2 f

theorem numFactAt_evenL2 : NumFactAt EvenL2Fam := by
  intro L _ _ _ hF z hz2 hzc Gc _ _ ρ hρ hinn ž hž Ŝ hŜ2 hŜodd hŜC hcard hC9
  obtain ⟨f, hf2, hf8, hmodel⟩ := hF
  obtain ⟨-, K, _, hfin, hKcard, ⟨e0⟩⟩ := hmodel
  have hchar : CharP K 2 :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic Nat.prime_two
      (by omega) hKcard
  let e : L ≃* SL(2, K) :=
    (e0.trans (projectiveSpecialLinearGroupEquivStatedProj 2 K).symm).trans sl2EquivPSL2.symm
  have hZSL : Subgroup.center SL(2, K) = ⊥ := by
    have h1 : (Subgroup.center SL(2, K)).map (sl2EquivPSL2 (F := K)).toMonoidHom =
        Subgroup.center (PSL2 K) := Subgroup.map_center_eq (sl2EquivPSL2 (F := K))
    rw [psl2_center_eq_bot K] at h1
    exact (Subgroup.map_eq_bot_iff_of_injective _ (sl2EquivPSL2 (F := K)).injective).mp h1
  have hZ : Subgroup.center L = ⊥ := by
    have h1 : (Subgroup.center L).map e.toMonoidHom = Subgroup.center SL(2, K) :=
      Subgroup.map_center_eq e
    rw [hZSL] at h1
    exact (Subgroup.map_eq_bot_iff_of_injective _ e.injective).mp h1
  have hz1 : z ≠ 1 := fun h => hzc (h ▸ Subgroup.one_mem _)
  have hez1 : e z ≠ 1 := fun h => hz1 (e.injective (by rw [h, map_one]))
  have hez2 : e z * e z = 1 := by rw [← map_mul, hz2, map_one]
  have hl2 : ∀ l : L, l * z = z * l → l * l = 1 := by
    intro l hl
    have h1 := sl2_sq_eq_one_of_commute (e z) (e l) hez2 hez1 (by rw [← map_mul, ← map_mul, hl])
    apply e.injective
    rw [map_mul, map_one]
    exact h1
  set C : Subgroup Gc := Subgroup.centralizer ({ž} : Set Gc) with hC
  set H : Subgroup Gc := (Inn L).comap ρ with hH
  have hHn : H.Normal := Subgroup.normal_comap ρ
  set B : Subgroup Gc := H ⊓ C with hB
  have hBC : B ≤ C := inf_le_right
  have hB2 : ∀ b : Gc, b ∈ B → b * b = 1 := by
    intro b hb
    obtain ⟨hbH, hbC⟩ := hb
    obtain ⟨l, hl⟩ := hbH
    have hbž : b * ž = ž * b := Subgroup.mem_centralizer_singleton_iff.mp hbC
    have hcomm : MulAut.conj l * MulAut.conj z = MulAut.conj z * MulAut.conj l := by
      rw [hl, ← hž, ← map_mul, ← map_mul, hbž]
    have h3 : MulAut.conj (l * z * (z * l)⁻¹) = 1 := by
      rw [map_mul, map_mul, map_inv, map_mul, hcomm]
      simp
    have h4 : l * z * (z * l)⁻¹ ∈ Subgroup.center L := by
      rw [← ker_conj_eq_center]
      exact h3
    rw [hZ, Subgroup.mem_bot] at h4
    have h5 : l * z = z * l := mul_inv_eq_one.mp h4
    apply hρ
    rw [map_mul, map_one, show ρ b = MulAut.conj l from hl.symm, ← map_mul, hl2 l h5, map_one]
  have hBp : IsPGroup 2 B := fun g => ⟨1, Subtype.ext (by simpa [sq] using hB2 g.1 g.2)⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨k, hk⟩ := (IsPGroup.iff_card (p := 2)).mp hBp
  have hCB : Nat.card C = Nat.card B * B.relIndex C := by
    have h1 := Subgroup.card_mul_index (B.subgroupOf C)
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hBC).toEquiv] at h1
    exact h1.symm
  have hrel : B.relIndex C ∣ f := by
    have h1 : B.relIndex C = H.relIndex C := Subgroup.inf_relIndex_right H C
    have h2 : H.relIndex C ∣ H.index := Subgroup.relIndex_dvd_index_of_normal H C
    have h3 : H.index = (Inn L).relIndex ρ.range := Subgroup.index_comap (Inn L) ρ
    have hinn' : Inn L ≤ ρ.range := by
      rintro _ ⟨l, rfl⟩
      exact hinn l
    have h4 : (Inn L).relIndex ρ.range ∣ (Inn L).index :=
      Subgroup.relIndex_dvd_index_of_le hinn'
    have h5 : (Inn L).index = f := by
      have h6 : Nat.card (Outer L) = Nat.card (Outer SL(2, K)) :=
        Nat.card_congr (CFSG.ComponentClassification.OuterAutomorphisms.equivalence e).toEquiv
      have h7 := (even_SL2_full_automorphism_semilinear_model (F := K) (n := f) (by omega)
        hKcard).2.2.2.1
      have h8 : (Inn L).index = Nat.card (Outer L) := rfl
      rw [h8, h6, h7]
    rw [h1]
    exact h2.trans (h3 ▸ h4.trans (h5 ▸ dvd_rfl))
  have h9 : 9 ∣ Nat.card C := ⟨Nat.card Ŝ, hC9⟩
  rw [hCB, hk] at h9
  have hcop : Nat.Coprime 9 (2 ^ k) := Nat.Coprime.pow_right k (by norm_num)
  have h9' : 9 ∣ B.relIndex C := hcop.dvd_of_dvd_mul_left h9
  have := Nat.le_of_dvd (by omega) (h9'.trans hrel)
  omega

