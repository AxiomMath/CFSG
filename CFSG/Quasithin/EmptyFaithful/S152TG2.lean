section G2Arith

theorem g2_cartan_gcd : ∀ m < Tag.G2.rootCertificate.roots.length,
    0 < height (Tag.G2.rootCertificate.root m) →
      Int.gcd (∑ k, Tag.G2.cartan ⟨0, by decide⟩ k * Tag.G2.rootCertificate.root m k)
        (∑ k, Tag.G2.cartan ⟨1, by decide⟩ k * Tag.G2.rootCertificate.root m k) = 1 := by
  decide +kernel

variable {K : Type} [Field K]

theorem g2_char_ne_one (hK : 4 ≤ Nat.card K) {u : Kˣ} (hu : orderOf u = Nat.card K - 1)
    (β : Root Tag.G2) (hβ : 0 < height β.1) :
    ∃ j : Fin Tag.G2.rank, ((u ^ (∑ k, Tag.G2.cartan j k * β.1 k) : Kˣ) : K) ≠ 1 := by
  have hm := g2_cartan_gcd (rootPos β) (rootPos_lt β) (by rw [root_rootPos]; exact hβ)
  rw [root_rootPos] at hm
  by_contra hall
  have h0 := not_exists.1 hall ⟨0, by decide⟩
  have h1 := not_exists.1 hall ⟨1, by decide⟩
  rw [not_not, Units.val_eq_one, ← orderOf_dvd_iff_zpow_eq_one, hu] at h0 h1
  have hd := Int.dvd_gcd h0 h1
  rw [hm] at hd
  have hd' : Nat.card K - 1 ∣ 1 := by exact_mod_cast hd
  have := Nat.le_of_dvd one_pos hd'
  omega

theorem S152T.exists_units_orderOf_eq_card_sub_one [Finite K] : ∃ u : Kˣ, orderOf u = Nat.card K - 1 := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Kˣ)
  exact ⟨g, by rw [orderOf_eq_card_of_forall_mem_zpowers hg, Nat.card_units]⟩

end G2Arith

section G2


variable {K : Type} [Field K] [Finite K]

theorem g2_eq_one_of_mem_U_of_commute (hK : 4 ≤ Nat.card K) {u₀ : Kˣ}
    (hu₀ : orderOf u₀ = Nat.card K - 1) {x : adjointGroup Tag.G2 K}
    (hx : x ∈ (nativeData Tag.G2 K).U)
    (hc : ∀ j, torusElement Tag.G2 K j u₀ * x * (torusElement Tag.G2 K j u₀)⁻¹ = x) : x = 1 :=
  eq_one_of_mem_U_of_forall_commute (A := {h | ∃ j, h = torusElement Tag.G2 K j u₀})
    (by rintro _ ⟨j, rfl⟩; exact torusElement_mem_H _ j u₀)
    (fun β hβ y hy hyc => by
      obtain ⟨j, hne⟩ := g2_char_ne_one hK hu₀ β hβ
      exact eq_one_of_conj_eltElement hne
        (fun c => (rootOperatorFamily Tag.G2).torusElement_mul_eltElement_mul_inv j u₀ β c) hy
        (hyc _ ⟨j, rfl⟩))
    (ReeTag.isReduced_longWord ReeTag.G2) (ReeTag.negCheck_longWord ReeTag.G2) hx
    (by rintro _ ⟨j, rfl⟩; exact hc j)

theorem borelCentralizerTrivial_g2 [CharP K 2] (hK : 4 ≤ Nat.card K) :
    BorelCentralizerTrivial (adjointGroup Tag.G2 K) := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have := finite_modGL (τ := Tag.G2) (K := K)
  obtain ⟨w₀, hw₀⟩ := Finite.exists_max (coxeterSystem Tag.G2).length
  obtain ⟨⟨PU, hPU⟩, ⟨PV, hPV⟩, hUV, hopp, -, -⟩ :=
    exceptional_ordinary_Sylow_opposition Tag.G2 K 2 w₀ hw₀
  have hU : IsSylowTwoOf ((posUnipotent Tag.G2 K).subgroupOf (adjointGroup Tag.G2 K)) ⊤ := by
    rw [← hPU]
    exact isSylowTwoOf_top_iff.mpr ⟨PU.isPGroup', PU.not_dvd_index⟩
  have hV : IsSylowTwoOf ((negUnipotent Tag.G2 K).subgroupOf (adjointGroup Tag.G2 K)) ⊤ := by
    rw [← hPV]
    exact isSylowTwoOf_top_iff.mpr ⟨PV.isPGroup', PV.not_dvd_index⟩
  have hUV' : (posUnipotent Tag.G2 K).subgroupOf (adjointGroup Tag.G2 K) ⊓
      (negUnipotent Tag.G2 K).subgroupOf (adjointGroup Tag.G2 K) = ⊥ := by
    refine eq_bot_iff.2 fun x hx => ?_
    have h : (x : ModGL Tag.G2 K) ∈ posUnipotent Tag.G2 K ⊓ negUnipotent Tag.G2 K :=
      Subgroup.mem_inf.2 ⟨(Subgroup.mem_inf.1 hx).1, (Subgroup.mem_inf.1 hx).2⟩
    rw [hUV, Subgroup.mem_bot] at h
    exact Subgroup.mem_bot.2 (Subtype.ext h)
  obtain ⟨u₀, hu₀⟩ := S152T.exists_units_orderOf_eq_card_sub_one (K := K)
  refine bct_of_opposition hU hV hUV' ?_ ?_ center_adjointGroup_eq_bot ?_
  · intro S hS hUS
    obtain ⟨hp, hi⟩ := isSylowTwoOf_top_iff.mp hS
    have hcoe : ((hp.toSylow hi : Sylow 2 (adjointGroup Tag.G2 K)) :
        Subgroup (adjointGroup Tag.G2 K)) = S := IsPGroup.toSylow_coe hp hi
    obtain ⟨u, hu, hSu⟩ := (hopp (hp.toSylow hi)).1 (by rw [hcoe]; exact hUS)
    exact ⟨u, hu, hcoe ▸ hSu⟩
  · rintro δ hUδ hVδ ⟨w, hwU, hw⟩
    have hδA : δ ∈ unipotentPairAut Tag.G2 K := ⟨hUδ, hVδ⟩
    obtain ⟨a, σ, hδ⟩ := exists_exactNormalAut_zero_eq_of_even_G2 hK hδA
    exact eq_one_of_exactNormalAut_inner hδ hwU hw
  · intro u hu hc
    have hu' : (⟨(u : ModGL Tag.G2 K), u.2⟩ : adjointGroup Tag.G2 K) ∈ (nativeData Tag.G2 K).U :=
      ReeTag.mem_nativeData_U_of_mem_posUnipotent (t := ReeTag.G2) (Subgroup.mem_subgroupOf.1 hu)
    refine g2_eq_one_of_mem_U_of_commute hK hu₀ hu' fun j => ?_
    have hT : (torusElement Tag.G2 K j u₀ : ModGL Tag.G2 K) ∈ torusGroup Tag.G2 K :=
      Subgroup.subset_closure ⟨(j, u₀), rfl⟩
    have hNU : torusElement Tag.G2 K j u₀ ∈ Subgroup.normalizer
        (((posUnipotent Tag.G2 K).subgroupOf (adjointGroup Tag.G2 K) : Subgroup _) :
          Set (adjointGroup Tag.G2 K)) :=
      S152T.mem_normalizer_subgroupOf (posUnipotent_le_adjointGroup (τ := Tag.G2) (K := K))
        ((triangular_borel_structure.{0, 0} Tag.G2 K).2.2.1 hT)
    have hNV : torusElement Tag.G2 K j u₀ ∈ Subgroup.normalizer
        (((negUnipotent Tag.G2 K).subgroupOf (adjointGroup Tag.G2 K) : Subgroup _) :
          Set (adjointGroup Tag.G2 K)) :=
      S152T.mem_normalizer_subgroupOf (negUnipotent_le_adjointGroup (τ := Tag.G2) (K := K))
        (torusGroup_le_normalizer_negUnipotent hT)
    have h1 := hc _ hNU hNV
    calc torusElement Tag.G2 K j u₀ * ⟨(u : ModGL Tag.G2 K), u.2⟩ * (torusElement Tag.G2 K j u₀)⁻¹
        = (⟨(u : ModGL Tag.G2 K), u.2⟩ * torusElement Tag.G2 K j u₀) *
            (torusElement Tag.G2 K j u₀)⁻¹ := by rw [h1]
      _ = ⟨(u : ModGL Tag.G2 K), u.2⟩ := by group

end G2

section G2Fam


theorem bctFamG2_proof : BCTFamG2 := by
  intro f hf X _ _ h
  obtain ⟨-, K, _, _, hK, ⟨e⟩⟩ := h
  have : CharP K 2 := finite_field_prime_power_characteristic Nat.prime_two (by omega) hK
  have hK4 : 4 ≤ Nat.card K := by
    rw [hK]
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf
  let e' : X ≃* adjointGroup Tag.G2 K :=
    e.trans ((QuotientGroup.quotientMulEquivOfEq center_adjointGroup_eq_bot).trans
      QuotientGroup.quotientBot)
  exact BorelCentralizerTrivial.of_mulEquiv e'.symm (borelCentralizerTrivial_g2 hK4)

end G2Fam

