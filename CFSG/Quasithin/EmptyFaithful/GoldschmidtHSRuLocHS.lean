theorem hs_o2_Y2 : Nat.card (pCoreOf 2 (hsCtx.Y 2)) = 64 := by
  obtain ⟨m, hm, h1, h2, -⟩ := hs_row 2 (by norm_num)
  have hc : Nat.card (hsCtx.Y 2) = 10752 := by
    rw [hs_member_card 2 (by norm_num)]
    rfl
  simp only [hsMems, List.mem_cons, List.not_mem_nil, or_false] at hm
  rcases hm with rfl | rfl | rfl | rfl | rfl
  all_goals first
    | (exfalso; simp only at h1; omega)
    | simpa using h2

theorem hs_dist : ∀ j ≤ 5, j ≠ 2 →
    Nat.card (memberOrTop 5 hsCtx.Y j) ≠ Nat.card (hsCtx.Y 2) := by
  intro j hj hj2
  have hc2 : Nat.card (hsCtx.Y 2) = 10752 := by
    rw [hs_member_card 2 (by norm_num)]
    rfl
  rcases Nat.lt_or_ge j 5 with h | h
  · have hm : memberOrTop 5 hsCtx.Y j = hsCtx.Y j := by simp [memberOrTop, h]
    rw [hm, hc2, hs_member_card j h]
    interval_cases j <;> simp_all
  · have hj5 : j = 5 := by omega
    subst hj5
    have hm : memberOrTop 5 hsCtx.Y 5 = ⊤ := by simp [memberOrTop]
    rw [hm, Subgroup.card_top, hs_card, hc2]
    norm_num

end Data

theorem hs_inv
    {H : Type} [Group H] (e : H ≃* Carrier .HS) :
    ∀ t : H, orderOf t = 2 → ¬ 21 ∣ Nat.card (Subgroup.centralizer ({t} : Set H)) := by
  intro t ht h21
  rcases CFSG.ComponentClassification.HSFLit.card_centralizer_of_HS e ht with h | h <;>
    (rw [h] at h21; omega)

theorem input15122HSModel_holds :
    HSRuLoc.Input15122HSModel := by
  intro H _ _ hH P hP
  obtain ⟨e⟩ := hH
  have hXΓ : Nonempty (H ≃* J hsData) := ⟨e.trans (seedEquiv hs_facts.toBaseFacts)⟩
  obtain ⟨ψ, hψ, huniqψ⟩ := unique_member_of_lattice (S := hsCtx.S) hs_S_sylow 5 hsCtx.Y
    hs_complete (j₀ := 2) (by norm_num) hs_dist hXΓ hP
  set K : Subgroup H := (hsCtx.Y 2).map ψ.symm.toMonoidHom with hK
  have hc2 : Nat.card (hsCtx.Y 2) = 10752 := by
    rw [hs_member_card 2 (by norm_num)]
    rfl
  have hKcard : Nat.card K = 10752 := by
    rw [hK, Subgroup.card_map_of_injective ψ.symm.injective, hc2]
  have hPcard : Nat.card P = 512 := by
    rw [← Subgroup.card_map_of_injective (f := ψ.toMonoidHom) ψ.injective, hψ, hs_card_S]
  have hPK : P ≤ K := by
    intro x hx
    have hxS : ψ x ∈ hsCtx.S := hψ ▸ Subgroup.mem_map_of_mem _ hx
    exact ⟨ψ x, hsCtx.S_le_Y 2 hxS, by simp⟩
  have hcard : Nat.card K = 21 * Nat.card P := by rw [hKcard, hPcard]
  have huniq : ∀ X : Subgroup H, P ≤ X → Nat.card X = Nat.card K → X = K := fun X hX hc =>
    huniqψ X hX (by rw [hc, hKcard, hc2])
  have hO2 : Nat.card (pCoreOf 2 K) * 8 = Nat.card P := by
    rw [hK, CFSG.LieType.BorelTits.pCoreOf_map_mulEquiv 2 ψ.symm (hsCtx.Y 2),
      Subgroup.card_map_of_injective ψ.symm.injective, hs_o2_Y2, hPcard]
  have hKtop : K ≠ ⊤ := by
    intro h
    have h1 := hKcard
    rw [h, Subgroup.card_top, Nat.card_congr ψ.toEquiv, hs_card] at h1
    omega
  have hov : ∀ Z : Subgroup H, P ≤ Z → Z ≠ ⊤ →
      (Nat.card Z = Nat.card P ∧ Nat.card (pCoreOf 2 Z) = Nat.card P) ∨
        Nat.card Z = 15 * Nat.card P ∨ Nat.card Z = 21 * Nat.card P ∨
        (Nat.card Z = 3 * Nat.card P ∧ Nat.card (pCoreOf 2 Z) * 2 = Nat.card P) := by
    intro Z hPZ hZ
    rcases hs_overgroups ⟨e⟩ hP hPZ with h | ⟨m, hm, hord, ho2, -⟩
    · exact absurd h hZ
    · simp only [hsMems, List.mem_cons, List.not_mem_nil, or_false] at hm
      rw [hPcard]
      rcases hm with rfl | rfl | rfl | rfl | rfl <;> simp only at hord ho2 <;> omega
  have hodd : ∀ (N : Subgroup ↥K) [N.Normal], IsPGroup 2 (↥K ⧸ N) → Nat.card (↥K ⧸ N) ≤ 1 :=
    noTwoQuot_map_equiv ψ.symm (hsCtx.Y 2) (fun N' _ hp' =>
      CFSG.Quasithin.A312Hs.hs_Y2_quot N' hp')
  have hR4 : ∃ x ∈ pCoreOf 2 K, x ^ 2 ≠ 1 := by
    by_contra hcon
    push Not at hcon
    have hrank := CFSG.QuasithinUnique.Lin2.RankCert.ElemAbelianLt.of_mulEquiv (X := H)
      (Y := Carrier .HS) e CFSG.QuasithinUnique.Lin2.hs_native_rank
    have := hrank _ (isElemAbelian_of_sq_eq_one hcon)
    rw [show Nat.card (pCoreOf 2 K) = 64 by omega] at this
    omega
  exact ⟨K, pCoreOf 2 K, 6, hsruModel_of_data hP.2.1 hPK hcard huniq hO2
    (by rw [hPcard]; norm_num) (hrows_of_overgroups hKtop hcard huniq hov) hodd (hs_inv e) hR4
    ⟨by norm_num, by norm_num, by norm_num⟩⟩

end CFSG.Quasithin.HSRuLoc.Mod
