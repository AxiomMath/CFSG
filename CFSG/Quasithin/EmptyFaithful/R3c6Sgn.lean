section Model

variable {n : ℕ} {K : Type} [Field K] [CharP K 2]

section Psu

variable (h : UnitaryFieldData 2 n K)

local notation "PGL3" => ProjGenLinGroup (Fin 3) K

variable (n K) in
@[expose] noncomputable def p1A : Subgroup (ProjGenLinGroup (Fin 3) K) :=
  (unitaryAntidiagonalGroup (K := K) n).map ProjGenLinGroup.mk

theorem suA_le_guA : unitaryAntidiagonalGroup (K := K) n ≤ guA n K := by
  rw [← map_unitaryGramConj_glaSUGroup n]
  exact Subgroup.map_mono (Subgroup.closure_mono (fun _ hg => hg.2))

theorem p1A_le_pguA : p1A n K ≤ pguA n K := Subgroup.map_mono suA_le_guA

include h in
theorem conj_mem_suA {M s : GL (Fin 3) K} (hM : M ∈ guA n K)
    (hs : s ∈ unitaryAntidiagonalGroup (K := K) n) :
    M * s * M⁻¹ ∈ unitaryAntidiagonalGroup (K := K) n := by
  rw [← map_unitaryGramConj_glaSUGroup n] at hs ⊢
  obtain ⟨s₀, hs₀, rfl⟩ := hs
  obtain ⟨A, hA, rfl⟩ := hM
  refine ⟨A * s₀ * A⁻¹, ?_, by simp⟩
  have hA' : A ∈ unitaryIsom3 h := by
    rw [← A318P.statedGU_eq_unitaryIsom3 h]
    exact hA
  exact CFSG.RankThree.PartTwo.KFacts.conj_mem_unitarySU hA' hs₀

include h in
theorem p1A_normal : ((p1A n K).subgroupOf (pguA n K)).Normal := by
  refine ⟨fun x hx g => ?_⟩
  obtain ⟨s, hs, hsx⟩ := hx
  obtain ⟨M, hM, hMg⟩ := g.2
  show ((g * x * g⁻¹ : ↥(pguA n K)) : PGL3) ∈ p1A n K
  refine ⟨M * s * M⁻¹, conj_mem_suA h hM hs, ?_⟩
  have hx' : ProjGenLinGroup.mk s = (x : PGL3) := hsx
  have hg' : ProjGenLinGroup.mk M = (g : PGL3) := hMg
  rw [map_mul, map_mul, map_inv, hx', hg']
  rfl

variable (n K) in
noncomputable def p1Equiv : ↥((p1A n K).subgroupOf (pguA n K)) ≃*
    GLAProj (GLASUGroup (Fin 3) K (2 ^ n)) :=
  (Subgroup.subgroupOfEquivOfLe p1A_le_pguA).trans (glaSUGramEquiv n).symm

variable (n K) in
noncomputable def modelEquiv : StatedProj (StatedGU 3 (2 ^ n) K) ≃* ↥(pguA n K) :=
  (scalarQuotientEquivImage (StatedGU 3 (2 ^ n) K)).trans
    (projectiveImageEquiv unitaryGramConj (StatedGU 3 (2 ^ n) K) (guA n K) rfl)

theorem isPSU_p1A [Finite K] (h : UnitaryFieldData 2 n K) (hn : 2 ≤ n) :
    CFSG.Quasithin.IsPSU 3 2 n ↥((p1A n K).subgroupOf (pguA n K)) := by
  refine ⟨⟨Nat.prime_two, h.one_le, le_refl 3, ?_⟩, K, inferInstance, inferInstance, ?_, ⟨p1Equiv n K⟩⟩
  · intro h3
    have := congrArg Prod.snd h3
    have h2 : 2 ^ n = 2 ^ 1 := this
    have := Nat.pow_right_injective (le_refl 2) h2
    omega
  · rw [h.card, ← pow_mul, mul_comm]

include h in
theorem p1A_index_odd [Finite K] (hn : 2 ≤ n) :
    ¬ 2 ∣ ((p1A n K).subgroupOf (pguA n K)).index := by
  have hpsu := isPSU_p1A h hn
  obtain ⟨hfin, -, -, -, hcard⟩ := CFSG.Quasithin.R3c5.psu3_data hpsu
  have hP := CFSG.Quasithin.R3c5.card_statedProj_statedGU_three (p := 2) (f := n) (K := K) h
  rw [Nat.card_congr (modelEquiv n K).toEquiv] at hP
  have hidx := Subgroup.index_mul_card ((p1A n K).subgroupOf (pguA n K))
  have hpos : 0 < Nat.card ↥((p1A n K).subgroupOf (pguA n K)) := Nat.card_pos
  have h1 : ((p1A n K).subgroupOf (pguA n K)).index * Nat.card ↥((p1A n K).subgroupOf (pguA n K)) =
      Nat.gcd 3 (2 ^ n + 1) * Nat.card ↥((p1A n K).subgroupOf (pguA n K)) := by
    rw [hidx, hP, ← hcard, mul_comm]
  have h2 := Nat.eq_of_mul_eq_mul_right hpos h1
  rw [h2]
  intro hd
  have h3 : 2 ∣ 3 := hd.trans (Nat.gcd_dvd_left 3 (2 ^ n + 1))
  omega

theorem p1A_bender [Finite K] (h : UnitaryFieldData 2 n K) (hn : 2 ≤ n) :
    fusionBenderBorel ↥((p1A n K).subgroupOf (pguA n K)) (2 ^ n) 3 := by
  have hcard : Nat.card K = 2 ^ (2 * n) := h.card
  have hfin : Finite (ProjGenLinGroup (Fin 3) K) :=
    Finite.of_surjective ProjGenLinGroup.mk ProjGenLinGroup.mk_surjective
  let e : ↥((p1A n K).subgroupOf (pguA n K)) ≃* CFSG.Open.PSU3 2 n :=
    (p1Equiv n K).trans (glaSU3EquivNative n hn hcard)
  have : Finite (CFSG.Open.PSU3 2 n) := Finite.of_equiv _ e.toEquiv
  exact (CFSG.Open.bender_psu3_borel_full n hn).map_mulEquiv e.symm

include h in
theorem model_borelComp [Finite K] (hn : 2 ≤ n) (Q : Sylow 2 ↥(pguA n K)) :
    BorelComp ↥(pguA n K) (Q : Subgroup ↥(pguA n K)) := by
  have hfin : Finite (ProjGenLinGroup (Fin 3) K) :=
    Finite.of_surjective ProjGenLinGroup.mk ProjGenLinGroup.mk_surjective
  obtain ⟨S₀, hS₀, hcyc₀⟩ := model_sylow_cyclic h
  have hcyc₀' : ∀ R : Subgroup ↥(pguA n K),
      R ≤ Subgroup.normalizer ((S₀ : Subgroup ↥(pguA n K)) : Set ↥(pguA n K)) →
      IsPGroup 3 ↥R → IsCyclic ↥R := by
    rw [hS₀]
    exact hcyc₀
  have := p1A_normal h
  exact borelComp_of_normal_odd _ (p1A_index_odd h hn)
    (Nat.pow_le_pow_right (by norm_num) hn) (p1A_bender h hn) Q (cyclic_of_sylow_conj hcyc₀' Q)

end Psu

end Model

section Final

open CFSG.Quasithin CFSG.QuasithinUnique CFSG.Assembly.LowTwoRank CFSG.Quasithin.R3c5

theorem borelComp_of_isPGLEps3 {n : ℕ} (hn : 2 ≤ n) {P : Type} [Group P] [Finite P]
    (hP : IsPGLEps3 false (2 ^ n) P) (Q : Sylow 2 P) : BorelComp P (Q : Subgroup P) := by
  obtain ⟨K, _, _, hK, ⟨e⟩⟩ := hP
  have h : UnitaryFieldData 2 n K := ⟨Nat.prime_two, by omega, by rw [hK, ← pow_mul, mul_comm]⟩
  have := h.charP
  exact borelComp_forall_of_mulEquiv (e.trans (modelEquiv n K))
    (fun S => model_borelComp h hn S) Q

theorem rankTwoSign_holds : RankTwoSign := by
  intro n hn A _ _ P Y Q hP hQ hYP hQY hY3 hr
  obtain ⟨S, hS⟩ := exists_sylow_of_isSylowTwoOf' hQ
  have hQmap : (S : Subgroup ↥P).map P.subtype = Q := by
    rw [hS]
    exact Subgroup.map_subgroupOf_eq_of_le hQ.1
  have hB := borelComp_of_isPGLEps3 hn hP S
  have hBD := borelData_of_components hB.strong hB.cyclic hB.elem
  rw [hQmap] at hBD
  exact sign_of_borelData hQ hBD hYP hQY hY3 hr

end Final

