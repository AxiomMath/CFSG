theorem A2L_sub_DL : A2L.all (fun x => decide (x ∈ DL)) = true := by decide +kernel

theorem invs_sub_A12 :
    P0L.all (fun x => decide (x * x = 1 → x ∈ A1L ∨ x ∈ A2L)) = true := by decide +kernel

theorem omega_length : (P0L.filter fun x => decide (x * x = 1)).length = 6 := by decide +kernel

theorem DL_prod : DL.all (fun d => A1L.any fun a => A2L.any fun b => decide (d = a * b)) = true := by
