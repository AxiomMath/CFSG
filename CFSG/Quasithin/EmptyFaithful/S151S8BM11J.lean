@[expose] def listSub (l : List (Equiv.Perm (Fin 11))) (h1 : (1 : Equiv.Perm (Fin 11)) ∈ l)
    (hm : l.all (fun x => l.all fun y => decide (x * y ∈ l)) = true)
    (hi : l.all (fun x => decide (x⁻¹ ∈ l)) = true) : Subgroup MG where
  carrier := {x | (x : Equiv.Perm (Fin 11)) ∈ l}
  one_mem' := h1
  mul_mem' := fun hx hy =>
    of_decide_eq_true (List.all_eq_true.mp (List.all_eq_true.mp hm _ hx) _ hy)
  inv_mem' := fun hx => of_decide_eq_true (List.all_eq_true.mp hi _ hx)

@[expose] def A1 : Subgroup MG := listSub A1L (by decide +kernel) A1L_closed A1L_inv

@[expose] def A2 : Subgroup MG := listSub A2L (by decide +kernel) A2L_closed A2L_inv

@[expose] def D0 : Subgroup MG := listSub DL (by decide +kernel) DL_closed DL_inv

theorem mem_D0 {x : MG} : x ∈ D0 ↔ (x : Equiv.Perm (Fin 11)) ∈ DL := Iff.rfl

theorem P0L_sub_M {p : Equiv.Perm (Fin 11)} (hp : p ∈ P0L) : p ∈ 𝓜 := by
  obtain ⟨i, -, j, -, rfl⟩ := mem_P0L_iff.mp hp
  exact Subgroup.mul_mem _ (Subgroup.pow_mem _ sa_mem i) (Subgroup.pow_mem _ sb_mem j)

@[expose] def liftM (p : Equiv.Perm (Fin 11)) (hp : p ∈ P0L) : MG := ⟨p, P0L_sub_M hp⟩

theorem mem_P0L_of_mem_A1L {p : Equiv.Perm (Fin 11)} (hp : p ∈ A1L) : p ∈ P0L :=
  of_decide_eq_true (List.all_eq_true.mp A1L_sub_P0L _ hp)

theorem mem_P0L_of_mem_A2L {p : Equiv.Perm (Fin 11)} (hp : p ∈ A2L) : p ∈ P0L :=
  of_decide_eq_true (List.all_eq_true.mp A2L_sub_P0L _ hp)

theorem mem_P0L_of_mem_DL {p : Equiv.Perm (Fin 11)} (hp : p ∈ DL) : p ∈ P0L :=
  of_decide_eq_true (List.all_eq_true.mp DL_sub_P0L _ hp)

theorem A1_le_P0 : A1 ≤ P0 := fun _ hx => mem_P0.mpr (mem_P0L_of_mem_A1L hx)

theorem A2_le_P0 : A2 ≤ P0 := fun _ hx => mem_P0.mpr (mem_P0L_of_mem_A2L hx)

theorem D0_le_P0 : D0 ≤ P0 := fun _ hx => mem_P0.mpr (mem_P0L_of_mem_DL hx)

theorem coe_mul_self_eq_one {x : MG} (hx : x ^ 2 = 1) :
    (x : Equiv.Perm (Fin 11)) * x = 1 := by
  have := congrArg Subtype.val hx
  simpa [pow_two] using this

theorem isElemAbelian_A1 : IsElemAbelian 2 A1 := by
  refine ⟨CFSG.QuasithinUnique.GammaExtra.isMulCommutative_iff_forall.mpr fun a ha b hb => ?_,
    fun x hx => ?_⟩
  · exact Subtype.ext (of_decide_eq_true
      (List.all_eq_true.mp (List.all_eq_true.mp A1L_comm _ ha) _ hb))
  · apply Subtype.ext
    have := of_decide_eq_true (List.all_eq_true.mp A1L_sq _ hx)
    simpa [pow_two] using this

theorem isElemAbelian_A2 : IsElemAbelian 2 A2 := by
  refine ⟨CFSG.QuasithinUnique.GammaExtra.isMulCommutative_iff_forall.mpr fun a ha b hb => ?_,
    fun x hx => ?_⟩
  · exact Subtype.ext (of_decide_eq_true
      (List.all_eq_true.mp (List.all_eq_true.mp A2L_comm _ ha) _ hb))
  · apply Subtype.ext
    have := of_decide_eq_true (List.all_eq_true.mp A2L_sq _ hx)
    simpa [pow_two] using this

theorem card_A1 : Nat.card ↥A1 = 4 := by
  have h := card_eq_length (fun x : MG => x ∈ A1) (fun x => (x : Equiv.Perm (Fin 11)))
    Subtype.val_injective A1L A1L_nodup (fun b => by
      constructor
      · intro hb
        exact ⟨liftM b (mem_P0L_of_mem_A1L hb), hb, rfl⟩
      · rintro ⟨x, hx, rfl⟩
        exact hx)
  exact h

theorem card_A2 : Nat.card ↥A2 = 4 := by
  have h := card_eq_length (fun x : MG => x ∈ A2) (fun x => (x : Equiv.Perm (Fin 11)))
    Subtype.val_injective A2L A2L_nodup (fun b => by
      constructor
      · intro hb
        exact ⟨liftM b (mem_P0L_of_mem_A2L hb), hb, rfl⟩
      · rintro ⟨x, hx, rfl⟩
        exact hx)
  exact h

theorem card_le_four {B : Subgroup MG} (hB : B ≤ P0) (hBe : IsElemAbelian 2 B) :
    Nat.card ↥B ≤ 4 := by
  classical
  let Ω : Finset (Equiv.Perm (Fin 11)) := (P0L.filter fun x => decide (x * x = 1)).toFinset
  have hΩ : Ω.card = 6 := by
    rw [List.toFinset_card_of_nodup (P0L_nodup.filter _), omega_length]
  let f : ↥B → ↥Ω := fun b => ⟨((b : MG) : Equiv.Perm (Fin 11)), by
    simp only [Ω, List.mem_toFinset, List.mem_filter, decide_eq_true_eq]
    exact ⟨mem_P0.mp (hB b.2), coe_mul_self_eq_one (hBe.2 (b : MG) b.2)⟩⟩
  have hf : Function.Injective f := fun a b hab => by
    have h := congrArg (fun p : ↥Ω => (p : Equiv.Perm (Fin 11))) hab
    exact Subtype.ext (Subtype.ext h)
  have h6 : Nat.card ↥B ≤ 6 := by
    have := Nat.card_le_card_of_injective f hf
    rwa [Nat.card_eq_fintype_card (α := ↥Ω), Fintype.card_coe, hΩ] at this
  have hdvd : Nat.card ↥B ∣ 16 := by
    have := Subgroup.card_dvd_of_le hB
    rwa [card_P0] at this
  obtain ⟨n, hn⟩ : ∃ n, Nat.card ↥B = n := ⟨_, rfl⟩
  rw [hn] at h6 hdvd ⊢
  interval_cases n <;> omega

theorem isMaxElemAbelian_A1 : IsMaxElemAbelian P0 A1 :=
  ⟨A1_le_P0, isElemAbelian_A1, fun _ hB hBe => (card_le_four hB hBe).trans_eq card_A1.symm⟩

theorem isMaxElemAbelian_A2 : IsMaxElemAbelian P0 A2 :=
  ⟨A2_le_P0, isElemAbelian_A2, fun _ hB hBe => (card_le_four hB hBe).trans_eq card_A2.symm⟩

theorem thompsonJ_P0 : thompsonJ P0 = D0 := by
  apply le_antisymm
  · refine CFSG.QuasithinUnique.GammaExtra.thompsonJ_le fun A hA x hx => ?_
    have hxP : (x : Equiv.Perm (Fin 11)) ∈ P0L := mem_P0.mp (hA.1 hx)
    have hx2 : (x : Equiv.Perm (Fin 11)) * x = 1 := coe_mul_self_eq_one (hA.2.1.2 x hx)
    have h12 := of_decide_eq_true (List.all_eq_true.mp invs_sub_A12 _ hxP) hx2
    rw [mem_D0]
    rcases h12 with h | h
    · exact of_decide_eq_true (List.all_eq_true.mp A1L_sub_DL _ h)
    · exact of_decide_eq_true (List.all_eq_true.mp A2L_sub_DL _ h)
  · intro d hd
    have hd' : (d : Equiv.Perm (Fin 11)) ∈ DL := hd
    obtain ⟨a, ha, h2⟩ := List.any_eq_true.mp (List.all_eq_true.mp DL_prod _ hd')
    obtain ⟨b, hb, h3⟩ := List.any_eq_true.mp h2
    have hdab : (d : Equiv.Perm (Fin 11)) = a * b := of_decide_eq_true h3
    have hd2 : d = liftM a (mem_P0L_of_mem_A1L ha) * liftM b (mem_P0L_of_mem_A2L hb) :=
      Subtype.ext hdab
    rw [hd2]
    exact Subgroup.mul_mem _
      (CFSG.QuasithinUnique.GammaExtra.le_thompsonJ isMaxElemAbelian_A1 ha)
      (CFSG.QuasithinUnique.GammaExtra.le_thompsonJ isMaxElemAbelian_A2 hb)

theorem sb_ne_one : sb ≠ 1 := by decide +kernel

theorem z_mem_DL : sa ^ 4 ∈ DL := by decide +kernel

theorem sb_mem_DL : sb ∈ DL := by decide +kernel

@[expose] def zM : MG := ga ^ 4

theorem coe_ga : (ga : Equiv.Perm (Fin 11)) = sa := rfl

theorem coe_zM : (zM : Equiv.Perm (Fin 11)) = sa ^ 4 := by
  simp [zM, coe_ga]

theorem gb_sq : gb * gb = 1 := Subtype.ext sb_sq

section Core

theorem core {m : MG} (hm : ∀ d ∈ D0, m * d * m⁻¹ ∈ D0) : m ∈ P0 := by
  have hnorm : m ∈ Subgroup.normalizer (D0 : Set MG) := mem_normalizer_of_conj_le hm
  have hnorm' : m⁻¹ ∈ Subgroup.normalizer (D0 : Set MG) := inv_mem hnorm
  have hcent : ∀ p ∈ P0, p * zM = zM * p := fun p hp => by
    apply Subtype.ext
    have := of_decide_eq_true (List.all_eq_true.mp z_central _ (mem_P0.mp hp))
    simpa [coe_zM] using this
  have hzD : zM ∈ D0 := by
    show (zM : Equiv.Perm (Fin 11)) ∈ DL
    rw [coe_zM]
    exact z_mem_DL
  have hgbD : gb ∈ D0 := sb_mem_DL
  have hz : m * zM * m⁻¹ = zM := by
    have huD : m * zM * m⁻¹ ∈ D0 := hm zM hzD
    have hucomm : ∀ e ∈ D0, (m * zM * m⁻¹) * e = e * (m * zM * m⁻¹) := by
      intro e he
      have hd : m⁻¹ * e * m ∈ D0 := by
        have := (Subgroup.mem_normalizer_iff.mp hnorm' e).mp he
        simpa using this
      have hzd : zM * (m⁻¹ * e * m) = (m⁻¹ * e * m) * zM := (hcent _ (D0_le_P0 hd)).symm
      calc (m * zM * m⁻¹) * e = m * (zM * (m⁻¹ * e * m)) * m⁻¹ := by group
        _ = m * ((m⁻¹ * e * m) * zM) * m⁻¹ := by rw [hzd]
        _ = e * (m * zM * m⁻¹) := by group
    have hcen : ∀ e ∈ DL, ((m * zM * m⁻¹ : MG) : Equiv.Perm (Fin 11)) * e =
        e * ((m * zM * m⁻¹ : MG) : Equiv.Perm (Fin 11)) := fun e he =>
      congrArg Subtype.val (hucomm (liftM e (mem_P0L_of_mem_DL he)) he)
    have hc2 := of_decide_eq_true (List.all_eq_true.mp DL_center _ huD)
    rcases hc2 (List.all_eq_true.mpr fun e he => decide_eq_true (hcen e he)) with h1 | h1
    · exfalso
      have h1' : m * zM * m⁻¹ = 1 := Subtype.ext h1
      have h2 : zM = 1 := by
        calc zM = m⁻¹ * (m * zM * m⁻¹) * m := by group
          _ = 1 := by rw [h1']; group
      have h3 := congrArg Subtype.val h2
      rw [coe_zM] at h3
      exact sa_pow_four_ne h3
    · exact Subtype.ext (h1.trans coe_zM.symm)
  have htD : m * gb * m⁻¹ ∈ D0 := hm gb hgbD
  have ht2 : ((m * gb * m⁻¹ : MG) : Equiv.Perm (Fin 11)) * ((m * gb * m⁻¹ : MG) : Equiv.Perm (Fin 11)) = 1 := by
    have h1 : (m * gb * m⁻¹) * (m * gb * m⁻¹) = 1 := by
      calc (m * gb * m⁻¹) * (m * gb * m⁻¹) = m * (gb * gb) * m⁻¹ := by group
        _ = 1 := by rw [gb_sq]; group
    exact congrArg Subtype.val h1
  have ht1 : ((m * gb * m⁻¹ : MG) : Equiv.Perm (Fin 11)) ≠ 1 := by
    intro h
    have h' : m * gb * m⁻¹ = 1 := Subtype.ext h
    have h2 : gb = 1 := by
      calc gb = m⁻¹ * (m * gb * m⁻¹) * m := by group
        _ = 1 := by rw [h']; group
    exact sb_ne_one (congrArg Subtype.val h2)
  have htz : ((m * gb * m⁻¹ : MG) : Equiv.Perm (Fin 11)) ≠ sa ^ 4 := by
    intro h
    have h' : m * gb * m⁻¹ = zM := Subtype.ext (h.trans coe_zM.symm)
    have h2 : gb = zM := by
      calc gb = m⁻¹ * (m * gb * m⁻¹) * m := by group
        _ = m⁻¹ * zM * m := by rw [h']
        _ = m⁻¹ * (m * zM * m⁻¹) * m := by rw [hz]
        _ = zM := by group
    have h3 := congrArg Subtype.val h2
    rw [coe_zM] at h3
    exact sb_ne_z h3
  obtain ⟨p, hp, hpt⟩ := List.any_eq_true.mp
    (of_decide_eq_true (List.all_eq_true.mp DL_orbit _ htD) ht2 ht1 htz)
  have hpt' : p * sb * p⁻¹ = ((m * gb * m⁻¹ : MG) : Equiv.Perm (Fin 11)) := of_decide_eq_true hpt
  obtain ⟨p', hp'eq⟩ : ∃ p' : MG, p' = liftM p hp := ⟨_, rfl⟩
  have hp'P : p' ∈ P0 := by rw [hp'eq]; exact mem_P0.mpr hp
  have hp't : p' * gb * p'⁻¹ = m * gb * m⁻¹ := by rw [hp'eq]; exact Subtype.ext hpt'
  obtain ⟨h, hh⟩ : ∃ h : MG, h = p'⁻¹ * m := ⟨_, rfl⟩
  have hhb : h * gb = gb * h := by
    have e1 : h * gb * h⁻¹ = gb := by
      calc h * gb * h⁻¹ = p'⁻¹ * (m * gb * m⁻¹) * p' := by rw [hh]; group
        _ = p'⁻¹ * (p' * gb * p'⁻¹) * p' := by rw [hp't]
        _ = gb := by group
    calc h * gb = (h * gb * h⁻¹) * h := by group
      _ = gb * h := by rw [e1]
  have hhz : h * zM = zM * h := by
    have e1 : h * zM * h⁻¹ = zM := by
      calc h * zM * h⁻¹ = p'⁻¹ * (m * zM * m⁻¹) * p' := by rw [hh]; group
        _ = p'⁻¹ * zM * p' := by rw [hz]
        _ = p'⁻¹ * (zM * p') := by group
        _ = p'⁻¹ * (p' * zM) := by rw [hcent p' hp'P]
        _ = zM := by group
