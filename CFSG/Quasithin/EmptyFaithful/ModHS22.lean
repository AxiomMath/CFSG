@[expose] def cd (x : G) : ℕ := pkn 22 x.1

theorem cd_mul (x y : G) : cd (x * y) = compn 22 (cd x) (cd y) := by
  simp only [cd, Subgroup.coe_mul]
  exact pkn_mul (by norm_num) _ _

theorem cd_one : cd 1 = kIdn 22 := by
  simp only [cd, OneMemClass.coe_one]
