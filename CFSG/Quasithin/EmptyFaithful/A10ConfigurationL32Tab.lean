@[expose] def dig (c i : Nat) : Nat := (c >>> (3 * i)) &&& 7

@[expose] def codeV (v : Fin 8 → Nat) : Nat :=
  v 0 + 8 * v 1 + 64 * v 2 + 512 * v 3 + 4096 * v 4 + 32768 * v 5 + 262144 * v 6 + 2097152 * v 7

@[expose] def cmpN (a b : Nat) : Nat := codeV fun k => dig a (dig b k.val)

@[expose] def commB (d x : Nat) : Bool :=
  (List.range 8).all fun k => dig x (dig d k) == dig d (dig x k)

@[expose] def closedN (S gens : List Nat) : Bool :=
  S.all fun t => gens.all fun g => S.contains (cmpN t g)

theorem closedN_spec {S gens : List Nat} (h : closedN S gens = true) :
    ∀ t ∈ S, ∀ g ∈ gens, cmpN t g ∈ S := by
  intro t ht g hg
  simp only [closedN, List.all_eq_true, List.contains_iff_mem] at h
  exact h t ht g hg

