theorem Lc_closed : ∀ t ∈ Lc, ∀ g ∈ [tauC, tauInvC, iotaC], cmpN t g ∈ Lc :=
  closedN_spec (by decide +kernel)

theorem Dc_closed : ∀ t ∈ Dc, ∀ g ∈ [tauC, tauInvC, iotaC, muC, muInvC], cmpN t g ∈ Dc :=
  closedN_spec (by decide +kernel)

theorem idC_mem_Lc : idC ∈ Lc := by decide +kernel

theorem idC_mem_Dc : idC ∈ Dc := by decide +kernel

@[expose] def commOk (D S : List Nat) : Bool :=
  D.all fun d => d == idC || decide ((S.filter (commB d)).length < 24)

theorem Dc_comm : ∀ d ∈ Dc, d ≠ idC → (Lc.filter (commB d)).length < 24 := by
  have h : commOk Dc Lc = true := by decide +kernel
  intro d hd hne
  simp only [commOk, List.all_eq_true, Bool.or_eq_true, beq_iff_eq, decide_eq_true_eq] at h
  exact (h d hd).resolve_left hne

