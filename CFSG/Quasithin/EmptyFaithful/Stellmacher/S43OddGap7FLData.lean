@[expose] def stabElt (e : ℕ × ℕ × ℕ × ℕ) : Perm (Fin 5) :=
  tHat e.2.1 * (if e.2.2.2 = 1 then (orbRep e.1)⁻¹ else 1)

@[expose] def stabRep (e : ℕ × ℕ × ℕ × ℕ) : Perm (Fin 5) :=
  if e.2.2.2 = 1 then (orbRep e.1)⁻¹ else orbRep e.1

