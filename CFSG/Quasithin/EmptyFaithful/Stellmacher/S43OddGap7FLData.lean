  pm ![0, 1, 3, 4, 2] ![0, 1, 4, 2, 3],
  pm ![0, 1, 4, 3, 2] ![0, 1, 4, 3, 2],
  pm ![0, 2, 1, 4, 3] ![0, 2, 1, 4, 3],
  pm ![1, 0, 3, 4, 2] ![1, 0, 4, 2, 3],
  pm ![1, 0, 4, 3, 2] ![1, 0, 4, 3, 2]]

@[expose] def orbRep (k : ℕ) : Perm (Fin 5) := orbRepL.getD k 1

@[expose] def ptCode (s : Perm (Fin 5)) : ℕ := 2 ^ (s 0).val + 2 ^ (s 2).val + 32 * (s 4).val

@[expose] def ptData : ℕ := ofChunks [
    0x33000000190031000000000011002900000013000000000000,
    0x2e000000170000160000000023000022000000020000000000,
    0x32000000000030180000000000002810000000000012000000,
    0x15002c140000000000000000000021000020000000,
    0x900380800000b38000a000000]

@[expose] def ptD (s : Perm (Fin 5)) : ℕ := (ptData >>> (8 * ptCode s)) % 256

@[expose] def ptOrb (s : Perm (Fin 5)) : ℕ := ptD s / 8

@[expose] def ptAct (s : Perm (Fin 5)) : Perm (Fin 5) :=
  tHat (ptD s % 4) * (if ptD s / 4 % 2 = 1 then (orbRep (ptOrb s))⁻¹ else 1)

@[expose] def orbRepE (s : Perm (Fin 5)) : Perm (Fin 5) :=
  if ptD s / 4 % 2 = 1 then (orbRep (ptOrb s))⁻¹ else orbRep (ptOrb s)

@[expose] def prmOrbL : List ℕ := [0, 1, 1, 2, 2, 2, 2, 3, 4, 4, 5, 5, 6, 6, 0, 1, 3, 5]

@[expose] def prmMaskL : List ℕ := [24, 3, 17, 3, 5, 9, 17, 20, 6, 24, 5, 17, 3, 20, 5, 15, 10, 10]

@[expose] def prmOrb (l : ℕ) : ℕ := prmOrbL.getD l 7

@[expose] def prmVec (l : ℕ) : orth.W := mkW (prmMaskL.getD l 0)

@[expose] def basF (l : ℕ) (s : Perm (Fin 5)) : orth.W :=
  if ptOrb s = prmOrb l then orth.act (ptAct s) (prmVec l) else 1

@[expose] def basC (l : ℕ) (h h' : Perm (Fin 5)) : orth.W := orth.act h (basF l (h⁻¹ * h'))

