@[expose] def ofChunks : List ℕ → ℕ
  | [] => 0
  | a :: as => a + 2 ^ 256 * ofChunks as

@[expose] def tHatL : List (Perm (Fin 5)) := [1, swap 0 2, swap 1 3, swap 0 2 * swap 1 3]

@[expose] def tHat (i : ℕ) : Perm (Fin 5) := tHatL.getD i 1

@[expose] def orbRepL : List (Perm (Fin 5)) := [
  pm ![0, 1, 2, 4, 3] ![0, 1, 2, 4, 3],
