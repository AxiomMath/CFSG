theorem OvgSetting.false_of_equiv_u33
    {V : Type} [AddCommGroup V]
    [Module (ZMod 2) V] [Finite V] {Γ T0 : Subgroup (V ≃ₗ[ZMod 2] V)} {v : V}
    (S : OvgSetting Γ T0 v) (e : ↥Γ ≃* U33G) : False := by
  set ρ : U33G →* (V ≃ₗ[ZMod 2] V) := Γ.subtype.comp e.symm.toMonoidHom with hρ
  have hρinj : Function.Injective ρ := Γ.subtype_injective.comp e.symm.injective
  have hmem : ∀ g, ρ g ∈ Γ := fun g => (e.symm g).2
  have hrange : ∀ z ∈ Γ, z ∈ ρ.range := fun z hz => ⟨e ⟨z, hz⟩, by simp [hρ]⟩
  refine S.false_of_u33 ρ hρinj (by rintro _ ⟨g, rfl⟩; exact hmem g)
    (fun γ hγ k hk => ?_) ⟨0, ?_⟩
  · obtain ⟨g, rfl⟩ := hk
    exact hrange _ (Γ.mul_mem (Γ.mul_mem hγ (hmem g)) (Γ.inv_mem hγ))
  · rw [pow_zero, one_mul, Nat.card_congr e.toEquiv, card_u33Pres]

theorem excl6U33S_of_ovg
    (h11 : StageLemma14111) (h113 : StageLemma14113) (h35 : Lemma1435) :
    Lemma14315Excl6U33S := by
  intro G _ _ T M hyp hnot hU D hc
  obtain ⟨v, S⟩ := exists_ovgSetting h11 h113 h35 hyp hnot hU D
  obtain ⟨φ, -⟩ := hc.2
  have hGF : Nat.card (GaloisField 2 1) = 2 := by
    rw [GaloisField.card 2 1 one_ne_zero]
    norm_num
  obtain ⟨e⟩ := nonempty_derived_g2_equiv_u33 hGF
  exact (S.false_of_equiv_u33 (φ.trans e)).elim

