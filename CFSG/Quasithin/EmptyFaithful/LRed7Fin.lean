@[expose] def idE : Nat := 605728907615742478127163846336690649049022037395941866804996873203182254337115014162779941914389627335876016873536

@[expose] def fxl (p : Nat) : List Nat := (List.range 63).filter fun x => dig p x == x

@[expose] def bigE : List Nat := LAE.filter fun p => p != idE && (fxl p).length == 15

theorem idE_mem : idE ∈ LAE := by decide +kernel

theorem LAE_closed : (LAE.all fun p => genE.all fun g => LAE.contains (mulE p g)) = true := by
  decide +kernel

theorem LAE_le15 : (LAE.all fun p => p == idE || decide ((fxl p).length ≤ 15)) = true := by
  decide +kernel

theorem bigE_distinct : (bigE.all fun p => bigE.all fun q =>
    p == q || !((fxl p).all fun x => (fxl q).contains x)) = true := by
  decide +kernel

end Packed

section Enc

@[expose] def pk : List Nat → Nat
  | [] => 0
  | a :: l => a + 64 * pk l

theorem dig_pk : ∀ {l : List Nat}, (∀ a ∈ l, a < 64) → ∀ y : Nat, dig (pk l) y = l.getD y 0
  | [], _, y => by simp [pk, dig]
  | a :: l, hl, 0 => by
    have ha : a < 64 := hl a (List.mem_cons_self ..)
    simp only [pk, dig, pow_zero, Nat.div_one, List.getD_cons_zero]
    rw [Nat.add_mul_mod_self_left]
    exact Nat.mod_eq_of_lt ha
  | a :: l, hl, y + 1 => by
    have ha : a < 64 := hl a (List.mem_cons_self ..)
    have hl' : ∀ b ∈ l, b < 64 := fun b hb => hl b (List.mem_cons_of_mem _ hb)
    have h1 := dig_pk hl' y
    simp only [pk, dig, List.getD_cons_succ] at h1 ⊢
    rw [pow_succ', ← Nat.div_div_eq_div_mul, Nat.add_mul_div_left _ _ (by norm_num : 0 < 64),
      Nat.div_eq_of_lt ha, zero_add]
    exact h1

theorem mulE_eq (p q : Nat) :
    mulE p q = pk ((List.range 63).map fun x => dig p (dig q x)) := by
  unfold mulE
  generalize List.range 63 = l
  induction l with
  | nil => rfl
  | cons x l ih => simp only [List.foldr_cons, List.map_cons, pk, ih]

@[expose] def tabN (σ : Equiv.Perm (Fin 63)) (x : Nat) : Nat :=
  if h : x < 63 then (σ ⟨x, h⟩).val else 0

theorem tabN_lt (σ : Equiv.Perm (Fin 63)) (x : Nat) : tabN σ x < 64 := by
  unfold tabN
  split_ifs with h
  · exact lt_trans (σ ⟨x, h⟩).2 (by norm_num)
  · norm_num

@[expose] def enc (σ : Equiv.Perm (Fin 63)) : Nat := pk ((List.range 63).map (tabN σ))

theorem dig_enc (σ : Equiv.Perm (Fin 63)) (y : Fin 63) : dig (enc σ) y.val = (σ y).val := by
  have hl : ∀ a ∈ (List.range 63).map (tabN σ), a < 64 := by
    intro a ha
    obtain ⟨x, -, rfl⟩ := List.mem_map.mp ha
    exact tabN_lt σ x
  rw [enc, dig_pk hl]
  have : ((List.range 63).map (tabN σ)).getD y.val 0 = tabN σ y.val := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range y.2]
    simp
  rw [this]
  simp [tabN, y.2]

theorem enc_mul (σ τ : Equiv.Perm (Fin 63)) : enc (σ * τ) = mulE (enc σ) (enc τ) := by
  rw [mulE_eq, enc]
  congr 1
  apply List.map_congr_left
  intro x hx
  have hx' : x < 63 := List.mem_range.mp hx
  have h1 := dig_enc τ ⟨x, hx'⟩
  have h2 := dig_enc σ (τ ⟨x, hx'⟩)
  simp only [] at h1 h2
  rw [h1, h2]
  simp [tabN, hx']

theorem enc_injective : Function.Injective enc := by
  intro σ τ h
  ext y
  have h1 := dig_enc σ y
  have h2 := dig_enc τ y
  rw [h] at h1
  exact h1.symm.trans h2

theorem enc_one : enc 1 = idE := by decide +kernel

end Enc

theorem enc_vImg : ∀ i : Fin 4, enc (vImg (Fin.castLE (by norm_num) i)) = genE.getD i.val 0 := by
  decide +kernel

theorem genE_getD_mem : ∀ k : Fin 4, genE.getD k.val 0 ∈ genE := by decide +kernel

theorem enc_gen_mem (k : Fin 5) (hk : k.val < 4) : enc (vHom (u33GenPG k.val)) ∈ genE := by
  rw [vHom_gen k]
  have h := enc_vImg ⟨k.val, hk⟩
  have h2 : (Fin.castLE (by norm_num) (⟨k.val, hk⟩ : Fin 4) : Fin 5) = k := Fin.ext rfl
  rw [h2] at h
  rw [h]
  exact genE_getD_mem ⟨k.val, hk⟩

theorem enc_mem_LAE :
    ∀ g ∈ u33Data.A, enc (vHom g) ∈ LAE := by
  intro g hg
  have key : (↑(Subgroup.closure ({u33Data.a, u33Data.b, u33Data.s, u33Data.x} : Set U33G)) :
      Set U33G) ⊆ {g | enc (vHom g) ∈ LAE} := by
    refine closure_subset_of_right_closed ?_ ?_ ?_
    · intro s hs
      rcases hs with rfl | rfl | rfl | rfl
      · exact ⟨4, by norm_num, u33Data.ha⟩
      · exact ⟨4, by norm_num, u33Data.hb⟩
      · exact ⟨2, by norm_num, u33Data.hs⟩
      · exact ⟨3, by norm_num, u33Data.hx⟩
    · show enc (vHom 1) ∈ LAE
      rw [map_one, enc_one]
      exact idE_mem
    · intro p hp s hs
      show enc (vHom (p * s)) ∈ LAE
      rw [map_mul, enc_mul]
      have hsg : enc (vHom s) ∈ genE := by
        rcases hs with rfl | rfl | rfl | rfl
        · exact enc_gen_mem 0 (by decide)
        · exact enc_gen_mem 1 (by decide)
        · exact enc_gen_mem 2 (by decide)
        · exact enc_gen_mem 3 (by decide)
      have h1 := (List.all_eq_true.mp LAE_closed) _ hp
      have h2 := (List.all_eq_true.mp h1) _ hsg
      exact List.mem_of_elem_eq_true h2
  exact key hg

theorem vHom_injective :
    Function.Injective vHom := by
  have hs : IsSimpleGroup U33G := isSimpleGroup_u33Pres
  rw [← MonoidHom.ker_eq_bot_iff]
  have hn : (vHom.ker).Normal := inferInstance
  rcases @IsSimpleGroup.eq_bot_or_eq_top_of_normal _ _ hs vHom.ker hn with h | h
  · exact h
  · exfalso
    have h1 : vHom (u33GenPG (0 : Fin 5).val) = 1 := by
      have : u33GenPG (0 : Fin 5).val ∈ vHom.ker := h ▸ Subgroup.mem_top _
      exact this
    rw [vHom_gen] at h1
    have h3 : vImg 0 1 ≠ 1 := by decide +kernel
    exact h3 (by simpa using congrArg (fun σ : Equiv.Perm (Fin 63) => σ 1) h1)

theorem finite_u33 : Finite U33G := (u33Pres_finite_card_le).1

theorem fix_card_le
    (P : Finset (Fin 63)) (hP : P.card = 15) :
    Nat.card {g : U33G // ∀ p ∈ P, vHom g p = p} ≤ 2 := by
  classical
  have : Finite U33G := finite_u33
  by_contra hlt
  push Not at hlt
  obtain ⟨a, b, c, hab, hac, hbc⟩ : ∃ a b c : {g : U33G // ∀ p ∈ P, vHom g p = p},
      a ≠ b ∧ a ≠ c ∧ b ≠ c := by
    have : Fintype {g : U33G // ∀ p ∈ P, vHom g p = p} := Fintype.ofFinite _
    rw [Nat.card_eq_fintype_card] at hlt
    exact Fintype.two_lt_card_iff.mp hlt
  have key : ∃ g g' : U33G, g ≠ 1 ∧ g' ≠ 1 ∧ g ≠ g' ∧ (∀ p ∈ P, vHom g p = p) ∧
      (∀ p ∈ P, vHom g' p = p) := by
    by_cases ha1 : (a : U33G) = 1
    · refine ⟨b, c, ?_, ?_, fun h => hbc (Subtype.ext h), b.2, c.2⟩
      · intro h; exact hab (Subtype.ext (ha1.trans h.symm))
      · intro h; exact hac (Subtype.ext (ha1.trans h.symm))
    · by_cases hb1 : (b : U33G) = 1
      · refine ⟨a, c, ha1, ?_, fun h => hac (Subtype.ext h), a.2, c.2⟩
        intro h; exact hbc (Subtype.ext (hb1.trans h.symm))
      · exact ⟨a, b, ha1, hb1, fun h => hab (Subtype.ext h), a.2, b.2⟩
  obtain ⟨g, g', hg1, hg1', hgg', hgP, hg'P⟩ := key
  have hPne : P.Nonempty := by
    rw [← Finset.card_pos, hP]
    norm_num
  obtain ⟨p₁, hp₁⟩ := hPne
  obtain ⟨h, hh⟩ := vHom_trans p₁
  have hinv0 : vHom h⁻¹ p₁ = 0 := by
    rw [map_inv, ← hh]
    simp
  have hconj : ∀ x : U33G, (∀ p ∈ P, vHom x p = p) →
      vHom (h⁻¹ * x * h) 0 = 0 ∧ ∀ p ∈ P, vHom (h⁻¹ * x * h) (vHom h⁻¹ p) = vHom h⁻¹ p := by
    intro x hx
    refine ⟨?_, fun p hp => ?_⟩
    · rw [map_mul, map_mul, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hh, hx p₁ hp₁, hinv0]
    · rw [map_mul, map_mul, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply]
      have : vHom h (vHom h⁻¹ p) = p := by
        rw [map_inv]
        simp
      rw [this, hx p hp]
  obtain ⟨h0, hfix⟩ := hconj g hgP
  obtain ⟨h0', hfix'⟩ := hconj g' hg'P
  have hgA : h⁻¹ * g * h ∈ u33Data.A := by
    rw [← stab_vHom]
    exact mem_stabπ.mpr h0
  have hgA' : h⁻¹ * g' * h ∈ u33Data.A := by
    rw [← stab_vHom]
    exact mem_stabπ.mpr h0'
  have hconj1 : ∀ x : U33G, h⁻¹ * x * h = 1 → x = 1 := fun x hx => by
    calc x = h * (h⁻¹ * x * h) * h⁻¹ := by group
      _ = 1 := by rw [hx]; group
  have hne1 : vHom (h⁻¹ * g * h) ≠ 1 := fun e => hg1 (hconj1 g
    (vHom_injective (e.trans (map_one vHom).symm)))
  have hne1' : vHom (h⁻¹ * g' * h) ≠ 1 := fun e => hg1' (hconj1 g'
    (vHom_injective (e.trans (map_one vHom).symm)))
  have hnegg : vHom (h⁻¹ * g * h) ≠ vHom (h⁻¹ * g' * h) := fun e => hgg' (by
    have := vHom_injective e
    calc g = h * (h⁻¹ * g * h) * h⁻¹ := by group
      _ = h * (h⁻¹ * g' * h) * h⁻¹ := by rw [this]
      _ = g' := by group)
  set σ := vHom (h⁻¹ * g * h) with hσ
  set σ' := vHom (h⁻¹ * g' * h) with hσ'
  have hℓ : enc σ ∈ LAE := enc_mem_LAE _ hgA
  have hℓ' : enc σ' ∈ LAE := enc_mem_LAE _ hgA'
  have hℓ1 : enc σ ≠ idE := fun e => hne1 (enc_injective (e.trans enc_one.symm))
  have hℓ1' : enc σ' ≠ idE := fun e => hne1' (enc_injective (e.trans enc_one.symm))
  have hℓℓ' : enc σ ≠ enc σ' := fun e => hnegg (enc_injective e)
  set Pt : Finset Nat := (P.image (vHom h⁻¹)).image Fin.val with hPt
  have hPtcard : Pt.card = 15 := by
    rw [hPt, Finset.card_image_of_injective _ Fin.val_injective,
      Finset.card_image_of_injective _ (vHom h⁻¹).injective, hP]
  have hsub : ∀ (τ : Equiv.Perm (Fin 63)), (∀ p ∈ P, τ (vHom h⁻¹ p) = vHom h⁻¹ p) →
      Pt ⊆ (fxl (enc τ)).toFinset := by
    intro τ hτ x hx
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hy
    rw [List.mem_toFinset, fxl, List.mem_filter, List.mem_range]
    refine ⟨(vHom h⁻¹ p).2, ?_⟩
    have := dig_enc τ (vHom h⁻¹ p)
    rw [hτ p hp] at this
    simpa using this
  have hcount : ∀ (τ : Equiv.Perm (Fin 63)), (∀ p ∈ P, τ (vHom h⁻¹ p) = vHom h⁻¹ p) →
      enc τ ≠ idE → enc τ ∈ LAE → enc τ ∈ bigE ∧ (fxl (enc τ)).toFinset = Pt := by
    intro τ hτ hne hmem
    have h1 := hsub τ hτ
    have h2 : (fxl (enc τ)).length ≤ 15 := by
      have := (List.all_eq_true.mp LAE_le15) _ hmem
      simpa [hne] using this
    have h3 : (fxl (enc τ)).toFinset.card ≤ (fxl (enc τ)).length := List.toFinset_card_le _
    have h4 : (fxl (enc τ)).toFinset.card = 15 := by
      have := Finset.card_le_card h1
      omega
    have h5 : (fxl (enc τ)).length = 15 := by
      have hnd : (fxl (enc τ)).Nodup := List.Nodup.filter _ (List.nodup_range)
      rw [← List.toFinset_card_of_nodup hnd]
      exact h4
    refine ⟨?_, (Finset.eq_of_subset_of_card_le h1 (by rw [h4, hPtcard])).symm⟩
    rw [bigE, List.mem_filter]
    exact ⟨hmem, by simp [hne, h5]⟩
  obtain ⟨hb, hs⟩ := hcount σ hfix hℓ1 hℓ
  obtain ⟨hb', hs'⟩ := hcount σ' hfix' hℓ1' hℓ'
  have hd := (List.all_eq_true.mp (List.all_eq_true.mp bigE_distinct _ hb) _ hb')
  simp only [Bool.or_eq_true, beq_iff_eq, Bool.not_eq_true'] at hd
  rcases hd with h | h
  · exact hℓℓ' h
  ·
    have hall : ∀ x ∈ fxl (enc σ), x ∈ fxl (enc σ') := by
      intro x hx
      have : x ∈ (fxl (enc σ)).toFinset := List.mem_toFinset.mpr hx
      rw [hs] at this
      have := hsub σ' hfix' this
      exact List.mem_toFinset.mp this
    have : ((fxl (enc σ)).all fun x => (fxl (enc σ')).contains x) = true := by
      rw [List.all_eq_true]
      intro x hx
      exact List.elem_eq_true_of_mem (hall x hx)
    rw [this] at h
    exact absurd h (by simp)

end CFSG.Quasithin.LRed7
