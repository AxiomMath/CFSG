theorem componentClassificationOddCore_eq_pPrimeCore (Y : Type*) [Group Y] :
    CFSG.Open.componentClassificationOddCore Y = CFSG.pPrimeCore 2 Y := by
  unfold CFSG.Open.componentClassificationOddCore CFSG.pPrimeCore
  congr 1
  ext N
  simp [Nat.coprime_two_left]

variable {G : Type} [Group G] [Finite G] {T Mc M V₁ V₂ Yp I L : Subgroup G} {t : G}
  {X : Subgroup G} {τ f : G}

theorem KFHyp.invol_data (h : KFHyp T Mc M V₁ V₂ Yp I L t X τ f) {x : G} (hxe : x = τ ∨ x = f) :
    x ∈ Sgp153 T V₁ ∧ x * x = 1 ∧ x ∈ I ∧ ∃ v ∈ V₁, x * v ≠ v * x := by
  rcases hxe with rfl | rfl
  · exact ⟨h.hτS, h.hττ, h.r.S_le_I h.hτS, h.hmove⟩
  · refine ⟨h.hfS, h.hff, h.r.S_le_I h.hfS, ?_⟩
    obtain ⟨v, hv, hne⟩ := h.hmove
    refine ⟨v, hv, fun hfv => hne ?_⟩
    have hτ : τ = (τ * x) * x := by
      calc τ = τ * (x * x) := by rw [h.hff, mul_one]
        _ = (τ * x) * x := by rw [mul_assoc]
    calc τ * v = (τ * x) * x * v := by rw [← hτ]
      _ = (τ * x) * (x * v) := by simp only [mul_assoc]
      _ = (τ * x) * (v * x) := by rw [hfv]
      _ = ((τ * x) * v) * x := by simp only [mul_assoc]
      _ = (v * (τ * x)) * x := by rw [h.hcent v hv]
      _ = v * ((τ * x) * x) := by simp only [mul_assoc]
      _ = v * τ := by rw [← hτ]

theorem KFHyp.exists_fixed_vector (h : KFHyp T Mc M V₁ V₂ Yp I L t X τ f) {x : G} (hxI : x ∈ I)
    (hxx : x * x = 1) : ∃ v ∈ V₁, v ≠ 1 ∧ v * x = x * v := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hxN : x ∈ Subgroup.normalizer (V₁ : Set G) := h.hI ▸ hxI
  have hmod := card_inf_centralizer_modEq (E := V₁) (p := 2) (n := 1) hxN
    (by rw [pow_one, pow_two]; exact hxx)
  rw [h.r.ctx.hyp.decomp.card₁] at hmod
  have hne : V₁ ⊓ Subgroup.centralizer ({x} : Set G) ≠ ⊥ := by
    intro hbot
    rw [hbot, Subgroup.card_bot] at hmod
    exact absurd hmod (by decide)
  obtain ⟨a, ha⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hne
  exact ⟨(a : G), (Subgroup.mem_inf.mp a.2).1, fun h1 => ha (Subtype.ext h1),
    Subgroup.mem_centralizer_singleton_iff.mp (Subgroup.mem_inf.mp a.2).2⟩

theorem KFHyp.core_le_layer (h113 : StageLemma14113) (h : KFHyp T Mc M V₁ V₂ Yp I L t X τ f)
    {x : G} {Lx : Subgroup G} (hxe : x = τ ∨ x = f) (hLx : SBd14.CoreProps L V₁ I Lx x)
    (hcard : Nat.card (↥Lx ⧸ Subgroup.center ↥Lx) = 168)
    (hx : ∃ k : G, k⁻¹ * (τ * f) * k = x) :
    Lx ≤ (CFSG.ComponentClassification.Layer.subgroup ↥(Subgroup.centralizer ({x} : Set G))).map
      (Subgroup.centralizer ({x} : Set G)).subtype := by
  classical
  obtain ⟨-, hxx, hxI, -⟩ := h.invol_data hxe
  obtain ⟨v, hvV, hv1, hvx⟩ := h.exists_fixed_vector hxI hxx
  obtain ⟨hLxL, hqs, hZ, hxc, hnorm⟩ := hLx
  obtain ⟨k, hk⟩ := hx
  set Cx : Subgroup G := Subgroup.centralizer ({x} : Set G) with hCx
  have hLxCx : Lx ≤ Cx := fun y hy => Subgroup.mem_centralizer_singleton_iff.mpr (hxc y hy).symm
  have hvCx : v ∈ Cx := Subgroup.mem_centralizer_singleton_iff.mpr hvx
  let t' : ↥Cx := ⟨v, hvCx⟩
  have ht'1 : t' ≠ 1 := fun h1 => hv1 (congrArg Subtype.val h1)
  have ht'2 : t' * t' = 1 := Subtype.ext (h.r.V_sq v (h.r.ctx.hyp.decomp.le₁ hvV))
  set C : Subgroup ↥Cx := Subgroup.centralizer ({t'} : Set ↥Cx) with hC
  let Lx' : Subgroup ↥Cx := Lx.subgroupOf Cx
  have hLx'C : Lx' ≤ C := by
    intro y hy
    rw [hC, Subgroup.mem_centralizer_singleton_iff]
    apply Subtype.ext
    exact (Subgroup.mem_centralizer_iff.mp (h.r.h1 hvV)) (y : G) (hLxL hy)
  have hKnorm : (Lx'.subgroupOf C).Normal := by
    refine ⟨fun n hn g => ?_⟩
    have hν : ((n : ↥Cx) : G) ∈ Lx := hn
    have hγv : ((g : ↥Cx) : G) ∈ Subgroup.centralizer ({v} : Set G) := by
      have hg2 := Subgroup.mem_centralizer_singleton_iff.mp
        (show (g : ↥Cx) ∈ Subgroup.centralizer ({t'} : Set ↥Cx) from g.2)
      exact Subgroup.mem_centralizer_singleton_iff.mpr (congrArg Subtype.val hg2)
    have hγI : ((g : ↥Cx) : G) ∈ I := h.hCv v hvV hv1 hγv
    have hγx : ((g : ↥Cx) : G) * x = x * ((g : ↥Cx) : G) :=
      Subgroup.mem_centralizer_singleton_iff.mp (g : ↥Cx).2
    have hγN := hnorm _ hγI hγx
    exact (Subgroup.mem_normalizer_iff.mp hγN _).mp hν
  let e : ↥Lx ≃* ↥(Lx'.subgroupOf C) :=
    ((Subgroup.subgroupOfEquivOfLe hLxCx).symm).trans
      (Subgroup.subgroupOfEquivOfLe hLx'C).symm
  have hKq : CFSG.IsQuasisimple ↥(Lx'.subgroupOf C) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv e hqs
  have hKZ : IsPGroup 2 ↥(Subgroup.center ↥(Lx'.subgroupOf C)) := by
    intro z
    refine ⟨1, Subtype.ext ?_⟩
    have hzc : e.symm z.1 ∈ Subgroup.center ↥Lx := by
      rw [Subgroup.mem_center_iff]
      intro y
      obtain ⟨w, rfl⟩ := e.symm.surjective y
      rw [← e.symm.map_mul, ← e.symm.map_mul, Subgroup.mem_center_iff.mp z.2 w]
    have hzV : (((e.symm z.1 : ↥Lx)) : G) ∈ V₁ := hZ _ hzc
    have hsq : (e.symm z.1 : ↥Lx) * (e.symm z.1 : ↥Lx) = 1 :=
      Subtype.ext (h.r.V_sq _ (h.r.ctx.hyp.decomp.le₁ hzV))
    have hz2 : z.1 * z.1 = 1 := e.symm.injective (by rw [map_mul, hsq, map_one])
    simp only [SubmonoidClass.coe_pow, OneMemClass.coe_one]
    rw [pow_one, pow_two]
    exact hz2
  have hKeven : 2 ∣ Nat.card ↥(Lx'.subgroupOf C) := by
    have h1 : Nat.card ↥(Lx'.subgroupOf C) = Nat.card ↥Lx := (Nat.card_congr e.toEquiv).symm
    have h2 : Nat.card (↥Lx ⧸ Subgroup.center ↥Lx) ∣ Nat.card ↥Lx :=
      Subgroup.index_dvd_card (Subgroup.center ↥Lx)
    rw [h1]
    rw [hcard] at h2
    exact (by norm_num : 2 ∣ 168).trans h2
  have := hKnorm
  have hTwo : TwoComponents.IsTwoComponent (Lx'.subgroupOf C) :=
    SBd17.isTwoComponent_of_normal_quasisimple hKq hKZ hKeven
  have hodd : Lx' ≤ oddLayerOf ↥Cx := twoComponent_le_oddLayerOf ht'1 ht'2 hC hLx'C hTwo
  obtain ⟨F', hF'el, hF'9, hQle⟩ := h.oddCore_centralizer_conj h113 hk
  have hQeq := componentClassificationOddCore_eq_pPrimeCore ↥Cx
  have hQel : CFSG.Assembly.IsElemAbelian 3 (CFSG.Open.componentClassificationOddCore ↥Cx) := by
    rw [hQeq]
    refine ⟨⟨⟨fun a b => ?_⟩⟩, fun q hq => ?_⟩
    · apply Subtype.ext
      apply Subtype.ext
      have ha : ((a : ↥Cx) : G) ∈ F' := hQle ⟨a, a.2, rfl⟩
      have hb : ((b : ↥Cx) : G) ∈ F' := hQle ⟨b, b.2, rfl⟩
      have := congrArg (fun w : ↥F' => (w : G)) (hF'el.1.is_comm.comm ⟨_, ha⟩ ⟨_, hb⟩)
      exact this
    · apply Subtype.ext
      have hq' : (q : G) ∈ F' := hQle ⟨q, hq, rfl⟩
      have := hF'el.2 (q : G) hq'
      simpa using this
  have hQ9 : Nat.card (CFSG.Open.componentClassificationOddCore ↥Cx) ≤ 9 := by
    rw [hQeq]
    have h1 : Nat.card (CFSG.pPrimeCore 2 ↥Cx) =
        Nat.card ((CFSG.pPrimeCore 2 ↥Cx).map Cx.subtype) :=
      (Subgroup.card_map_of_injective Cx.subtype_injective).symm
    rw [h1, ← hF'9]
    exact Subgroup.card_le_of_le hQle
  have hperfLx : Group.IsPerfect ↥Lx := hqs.1
  have hperfLx' : Group.IsPerfect ↥Lx' :=
    have := hperfLx
    Group.IsPerfect.ofSurjective (f := (Subgroup.subgroupOfEquivOfLe hLxCx).symm.toMonoidHom)
      (Subgroup.subgroupOfEquivOfLe hLxCx).symm.surjective
  have hcomm := commutator_eq_bot_of_perfect_of_elemAbelian (P := Lx')
    (Q := CFSG.Open.componentClassificationOddCore ↥Cx) hperfLx' hQel hQ9
  have hlayer : Lx' ≤ Layer.subgroup ↥Cx :=
    PerfectCentralizingLayerLift.quotient_enters_layer
      (CFSG.Open.componentClassificationOddCore ↥Cx) Lx' hcomm
      (Subgroup.map_le_iff_le_comap.mpr hodd)
  intro y hy
  exact ⟨⟨y, hLxCx hy⟩, hlayer (Subgroup.mem_subgroupOf.mpr hy), rfl⟩

