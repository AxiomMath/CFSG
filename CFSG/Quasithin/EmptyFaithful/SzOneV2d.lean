@[expose] def KFact2dAtoms : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (T N K K0 V : Subgroup G), MinParabolic K T N → CharTwo K →
    K0 ∈ cComp K → K = K0 ⊔ T →
    CFSG.Open.IsQuasisimple (↥K0 ⧸ CFSG.Open.pCore 2 ↥K0) → E22Case2d K T N K0 →
    IsElemAbelian 2 V → V ≤ T → T ≤ Subgroup.normalizer (V : Set G) →
    (∀ A : Subgroup G, T ≤ A → A ≤ N → ¬ A ≤ Subgroup.normalizer (V : Set G) →
      (∀ B : Subgroup G, T ≤ B → B < A → B ≤ Subgroup.normalizer (V : Set G)) →
      IsElemAbelian 2 (conjClosure V A)) →
    V ≤ pCoreOf 2 N

variable {G : Type} [Group G] [Finite G] {T Mc M K N : Subgroup G}

theorem NonBorelK.atom_good (h : quasithinQTFE14Cat G T Mc) (hMf : IsMf T Mc M)
    (hCE : IsCE1513 T M) (h15111 : StageLemma15111) (hK : NonBorelK T Mc M K N)
    {A : Subgroup G} (hTA : T ≤ A) (hAN : A ≤ N)
    (hnA : ¬ A ≤ Subgroup.normalizer (V154 T Mc M : Set G))
    (hmin : ∀ B : Subgroup G, T ≤ B → B < A →
      B ≤ Subgroup.normalizer (V154 T Mc M : Set G)) :
    IsElemAbelian 2 (conjClosure (V154 T Mc M) A) := by
  have hNV : Subgroup.normalizer (V154 T Mc M : Set G) = M :=
    S152N.normalizer_V154_eq ⟨h, hMf, hCE⟩
  have hAM : ¬ A ≤ M := hNV ▸ hnA
  have hAK : A ≤ K := hAN.trans hK.N_lt_K.le
  have hZT : quasithinOmegaOneCenter T ≤ T :=
    (quasithinOmegaOneCenter_le_center T).trans inf_le_left
  have hZA : quasithinOmegaOneCenter T ≤ pCoreOf 2 A :=
    le_pCoreOf_of_le_normalizer 2 (hZT.trans hTA)
      (fun x hx => Subgroup.centralizer_le_normalizer _ (hK.le_centralizer (hAK hx)))
      (h.sylow.1.to_le hZT)
  have hInH : InH T A :=
    ⟨hTA, fun hbot => h.omegaOneCenter_ne_bot (le_bot_iff.1 (hZA.trans hbot.le))⟩
  have hStar : IsHStar T M A := by
    refine ⟨hInH, hAM, fun Y hY hYA hYM => ?_⟩
    rcases lt_or_eq_of_le hYA with hlt | heq
    · exact absurd (hNV ▸ hmin Y hY.1 hlt) hYM
    · exact heq
  exact (h15111 G T Mc M h hMf hCE A hStar).2

theorem nonBorelV2d_of_kfact2d (hK2d : KFact2dAtoms) (h15111 : StageLemma15111) :
    NonBorelV2d := by
  intro G _ _ T Mc M h hMf hCE h15 h157 h158 h159 K N hK hmin hJ hns hVK K0 hK0 hKK0 hq hc
  have hel : IsElemAbelian 2 (V154 T Mc M) := h15.reduced.2.2.1
  have hVT : V154 T Mc M ≤ T := (V154_le_VZ T Mc M).trans (isTwoReducedIn_VZ h hMf.1.1).2
  have hTV : T ≤ Subgroup.normalizer (V154 T Mc M : Set G) :=
    hMf.1.1.2.trans (le_normalizer_V154 T Mc M)
  exact hK2d G T N K K0 (V154 T Mc M) hK.minParabolic (hK.charTwo h) hK0 hKK0 hq hc hel hVT hTV
    fun A hTA hAN hnA hmin' => hK.atom_good h hMf hCE h15111 hTA hAN hnA hmin'

