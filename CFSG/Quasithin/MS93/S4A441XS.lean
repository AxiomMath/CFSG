local notation "𝔄" => SimpleGraph.Adj (GoldAmalgam.treeGraph (puAmalgam h.le))

theorem not_zm_le_qv_of_good (hb : 4 < critDist 𝔛)
    (hV : ∀ δ δ' : Vtx 𝔛, IsCritical 𝔛 δ δ' → ¬ Vv 𝔛 δ ≤ Qv 𝔛 (geo 𝔛 δ' δ 2))
    {α₀ β₀ γ₀ : Vtx 𝔛} (hα₀ : IsMVtx 𝔛 α₀) (hαβ₀ : 𝔄 α₀ β₀) (hβγ₀ : 𝔄 β₀ γ₀)
    (hex : ∀ g : 𝔘, ⁅ZM 𝔛 (g • α₀), Qv 𝔛 (g • γ₀)⁆ = Usup 𝔛 (g • α₀) (g • β₀) ∧
      Usup 𝔛 (g • α₀) (g • β₀) = Usup 𝔛 (g • γ₀) (g • β₀))
    {μ μ' : Vtx 𝔛} (hc : IsCritical 𝔛 μ μ')
    (hgood : Qv 𝔛 (geo 𝔛 μ μ' 3) ⊓ Subgroup.centralizer (Usup 𝔛 μ (geo 𝔛 μ μ' 1) : Set 𝔘) ≤
      Qv 𝔛 (geo 𝔛 μ μ' 2))
    {g : 𝔘} (hgγ : g • γ₀ = μ') (hR : ¬ ⁅ZM 𝔛 μ, ZM 𝔛 μ'⁆ ≤ Usup 𝔛 μ' (g • β₀)) :
    ¬ ZM 𝔛 (g • α₀) ≤ Qv 𝔛 (geo 𝔛 μ μ' 2) := by
  intro hle
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have h20 := h.hyp20
  have hb0 := h.critDist_pos
  have hC := h.centHyp
  have hc' := ms22_iii _ h20 hb0 hC hc
  have hμ : IsMVtx 𝔛 μ := hc.1
  have hμ' : IsMVtx 𝔛 μ' := hc'.1
  have hd : (puAmalgam h.le).treeGraph.dist μ μ' = critDist 𝔛 := hc.2.1
  have hμ'ρ : 𝔄 μ' (g • β₀) := by
    rw [← hgγ]
    exact (adj_smul _ g γ₀ β₀).mpr hβγ₀.symm
  have hρδ : 𝔄 (g • β₀) (g • α₀) := (adj_smul _ g β₀ α₀).mpr hαβ₀.symm
  have hδ : IsMVtx 𝔛 (g • α₀) := (isMVtx_smul _ g α₀).mpr hα₀
  obtain ⟨hex1, hex2⟩ := hex g
  rw [hgγ] at hex1 hex2
  have hZμs : ZM 𝔛 μ ≤ stab 𝔛 μ' := zm_le_stab_right _ h20 hb0 hC hc
  have hZ2 : IsPGroup 2 ↥(ZM 𝔛 μ) :=
    (S46.isPGroup_qv_of_isMVtx h hμ).to_le (zm_le_qv_self _ hμ hb0)
  have hZδρ : ZM 𝔛 (g • α₀) ≤ Qv 𝔛 (g • β₀) :=
    (zm_le_qv_self _ hδ hb0).trans (qv_le_qv _ h20 hδ hρδ.symm)
  have hZδs : ZM 𝔛 (g • α₀) ≤ stab 𝔛 μ' := hZδρ.trans (qv_le_stab_of_adj _ hμ'ρ.symm)
  have hA2 : ¬ ⁅ZM 𝔛 (g • α₀), ZM 𝔛 μ⁆ ≤ ZM 𝔛 μ' := by
    intro hA
    have hN1 : ZM 𝔛 μ ≤ Subgroup.normalizer
        ((ZM 𝔛 (g • α₀) ⊔ ZM 𝔛 μ' : Subgroup 𝔘) : Set 𝔘) :=
      le_normalizer_sup_of_commutator_le (hZμs.trans (stab_le_normalizer_zm _ μ'))
        (hA.trans le_sup_right)
    have hN2 : ZM 𝔛 μ ≤ Subgroup.normalizer (Usup 𝔛 μ' (g • β₀) : Set 𝔘) := by
      rw [← hex2, ← hex1]
      refine le_normalizer_of_map_conj_le fun z hz => ?_
      rw [Subgroup.map_commutator,
        MS93.map_conj_eq_of_mem_normalizer (stab_le_normalizer_qv _ μ' (hZμs hz))]
      calc ⁅(ZM 𝔛 (g • α₀)).map (MulAut.conj z).toMonoidHom, Qv 𝔛 μ'⁆ ≤
            ⁅ZM 𝔛 (g • α₀) ⊔ ZM 𝔛 μ', Qv 𝔛 μ'⁆ := by
            refine Subgroup.commutator_mono ?_ le_rfl
            calc (ZM 𝔛 (g • α₀)).map (MulAut.conj z).toMonoidHom ≤
                  (ZM 𝔛 (g • α₀) ⊔ ZM 𝔛 μ').map (MulAut.conj z).toMonoidHom :=
                  Subgroup.map_mono le_sup_left
              _ = ZM 𝔛 (g • α₀) ⊔ ZM 𝔛 μ' := MS93.map_conj_eq_of_mem_normalizer (hN1 hz)
        _ ≤ ⁅ZM 𝔛 (g • α₀), Qv 𝔛 μ'⁆ := commutator_sup_le'
            (hZδs.trans (stab_le_normalizer_zm _ μ')) (zm_le_centralizer_qv _ h20 hμ')
    apply hR
    rw [Subgroup.commutator_comm, commutator_zm_eq_uloc h hfull hμ' hZμs]
    exact commutator_uloc_le_usup_of_le_normalizer h hφ hC hb hμ' hμ'ρ hZμs hZ2 hN2
  have hκν : 𝔄 (geo 𝔛 μ μ' 1) (geo 𝔛 μ μ' 2) := adj_geo _ (by rw [hd]; omega)
  have hν : IsMVtx 𝔛 (geo 𝔛 μ μ' 2) := isMVtx_geo_two _ h20 hb0 hc
  have hB : ZM 𝔛 (g • α₀) ≤ Qv 𝔛 (geo 𝔛 μ μ' 1) := hle.trans (qv_le_qv _ h20 hν hκν.symm)
  have hA3 := N441.usup_le_commutator_sup h hφ hb hc' hB hA2
  have hdμ'δ : (puAmalgam h.le).treeGraph.dist μ' (g • α₀) ≤ 2 := by
    have := dist_triangle 𝔛 μ' (g • β₀) (g • α₀)
    rw [dist_eq_one_of_adj _ hμ'ρ, dist_eq_one_of_adj _ hρδ] at this
    exact this
  have hZδV : ZM 𝔛 (g • α₀) ≤ Vv 𝔛 μ' := by
    have := zv_le_vv h (α := μ') (ρ := g • α₀) hdμ'δ
    rwa [zv_of_isMVtx _ hδ] at this
  have hUV : Usup 𝔛 μ (geo 𝔛 μ μ' 1) ≤ Vv 𝔛 μ' := by
    refine hA3.trans (sup_le ?_ (zm_le_vv h hμ'))
    exact (Subgroup.commutator_mono hZδV le_rfl).trans
      (Subgroup.le_normalizer_iff_commutator_le_left.mp
        (hZμs.trans (stab_le_normalizer_vv h μ')))
  have hVc : Vv 𝔛 μ' ≤ Subgroup.centralizer (Usup 𝔛 μ (geo 𝔛 μ μ' 1) : Set 𝔘) := by
    have hab := vv_comm_eq_bot h hb hμ'
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer] at hab
    exact hab.trans (Subgroup.centralizer_le hUV)
  have hVε : Vv 𝔛 μ' ≤ Qv 𝔛 (geo 𝔛 μ μ' 3) := by
    refine S45.vi_le_qv _ ?_
    rw [tdist_comm, dist_geo_right _ (by omega), hd]
    omega
  exact hV μ' μ hc' ((le_inf hVε hVc).trans hgood)

theorem rdelta_of_good (hb : 4 < critDist 𝔛)
    (hV : ∀ δ δ' : Vtx 𝔛, IsCritical 𝔛 δ δ' → ¬ Vv 𝔛 δ ≤ Qv 𝔛 (geo 𝔛 δ' δ 2))
    {α₀ β₀ γ₀ : Vtx 𝔛} (hα₀ : IsMVtx 𝔛 α₀) (hαβ₀ : 𝔄 α₀ β₀) (hβγ₀ : 𝔄 β₀ γ₀)
    (hex : ∀ g : 𝔘, ⁅ZM 𝔛 (g • α₀), Qv 𝔛 (g • γ₀)⁆ = Usup 𝔛 (g • α₀) (g • β₀) ∧
      Usup 𝔛 (g • α₀) (g • β₀) = Usup 𝔛 (g • γ₀) (g • β₀))
    {μ μ' : Vtx 𝔛} (hc : IsCritical 𝔛 μ μ')
    (hgood : Qv 𝔛 (geo 𝔛 μ μ' 3) ⊓ Subgroup.centralizer (Usup 𝔛 μ (geo 𝔛 μ μ' 1) : Set 𝔘) ≤
      Qv 𝔛 (geo 𝔛 μ μ' 2))
    {g : 𝔘} (hgγ : g • γ₀ = μ') (hR : ¬ ⁅ZM 𝔛 μ, ZM 𝔛 μ'⁆ ≤ Usup 𝔛 μ' (g • β₀)) :
    ¬ ZM 𝔛 (g • α₀) ≤ Qv 𝔛 (geo 𝔛 μ μ' 2) ∧
      ⁅ZM 𝔛 (geo 𝔛 μ μ' 2), ZM 𝔛 (g • α₀)⁆ ≠ ⊥ ∧
      Fintype.card F ≤ Nat.card ↥⁅ZM 𝔛 (geo 𝔛 μ μ' 2), ZM 𝔛 (g • α₀)⁆ ∧
      ⁅ZM 𝔛 (geo 𝔛 μ μ' 2), ZM 𝔛 (g • α₀)⁆ ≤ Usup 𝔛 μ' (g • β₀) ⊓
        (Uloc h.le L μ' ⊓ Subgroup.centralizer (ZM 𝔛 μ : Set 𝔘)) := by
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have h20 := h.hyp20
  have hb0 := h.critDist_pos
  have hC := h.centHyp
  have hc' := ms22_iii _ h20 hb0 hC hc
  have hμ : IsMVtx 𝔛 μ := hc.1
  have hμ' : IsMVtx 𝔛 μ' := hc'.1
  have hd : (puAmalgam h.le).treeGraph.dist μ μ' = critDist 𝔛 := hc.2.1
  have hnot := not_zm_le_qv_of_good h hφ hb hV hα₀ hαβ₀ hβγ₀ hex hc hgood hgγ hR
  set ν := geo 𝔛 μ μ' 2 with hνdef
  have hν : IsMVtx 𝔛 ν := isMVtx_geo_two _ h20 hb0 hc
  have hμ'ρ : 𝔄 μ' (g • β₀) := by
    rw [← hgγ]
    exact (adj_smul _ g γ₀ β₀).mpr hβγ₀.symm
  have hρδ : 𝔄 (g • β₀) (g • α₀) := (adj_smul _ g β₀ α₀).mpr hαβ₀.symm
  have hδ : IsMVtx 𝔛 (g • α₀) := (isMVtx_smul _ g α₀).mpr hα₀
  have hdνμ' : (puAmalgam h.le).treeGraph.dist ν μ' = critDist 𝔛 - 2 := by
    rw [hνdef, dist_geo_right _ (by omega), hd]
  have hdδν : (puAmalgam h.le).treeGraph.dist (g • α₀) ν = critDist 𝔛 := by
    have t := dist_triangle 𝔛 (g • α₀) μ' ν
    have t1 : (puAmalgam h.le).treeGraph.dist (g • α₀) μ' ≤ 2 := by
      have := dist_triangle 𝔛 (g • α₀) (g • β₀) μ'
      rw [dist_eq_one_of_adj _ hρδ.symm, dist_eq_one_of_adj _ hμ'ρ.symm] at this
      exact this
    rw [tdist_comm _ μ' ν, hdνμ'] at t
    by_contra hne
    exact hnot (zm_le_qv_of_dist_lt _ hδ (by omega))
  have hcδ : IsCritical 𝔛 (g • α₀) ν := ⟨hδ, hdδν, hnot⟩
  have hcδ' := ms22_iii _ h20 hb0 hC hcδ
  have hZδν : ZM 𝔛 (g • α₀) ≤ Qv 𝔛 (geo 𝔛 ν (g • α₀) 1) := zm_le_qv_geo_one _ h20 hb0 hcδ'
  have hZδs : ZM 𝔛 (g • α₀) ≤ stab 𝔛 ν :=
    hZδν.trans (qv_le_stab_of_adj _ (adj_geo_one_of_isCritical _ hb0 hcδ').symm)
  have hne : ⁅ZM 𝔛 ν, ZM 𝔛 (g • α₀)⁆ ≠ ⊥ := ms22_ii _ h20 hb0 hC hcδ'
  have hRU : ⁅ZM 𝔛 ν, ZM 𝔛 (g • α₀)⁆ = ⁅Uloc h.le L ν, ZM 𝔛 (g • α₀)⁆ :=
    commutator_zm_eq_uloc h hfull hν hZδs
  have hcard : Fintype.card F ≤ Nat.card ↥⁅ZM 𝔛 ν, ZM 𝔛 (g • α₀)⁆ := by
    rw [hRU]
    exact le_card_commutator_uloc h hφ hν (adj_geo_one_of_isCritical _ hb0 hcδ') hZδν
      (by rwa [← hRU])
  refine ⟨hnot, hne, hcard, le_inf ?_ (le_inf ?_ ?_)⟩
  ·
    obtain ⟨-, hex2⟩ := hex g
    rw [hgγ] at hex2
    have hZνρ : ZM 𝔛 ν ≤ Qv 𝔛 (g • β₀) := by
      refine zm_le_qv_of_dist_lt _ hν ?_
      have := dist_triangle 𝔛 ν μ' (g • β₀)
      rw [hdνμ', dist_eq_one_of_adj _ hμ'ρ] at this
      omega
    rw [← hex2, Usup, zv_of_isMVtx _ hδ, Subgroup.commutator_comm]
    exact Subgroup.commutator_mono le_rfl hZνρ
  · obtain ⟨-, hex2⟩ := hex g
    rw [hgγ] at hex2
    have hZνρ : ZM 𝔛 ν ≤ Qv 𝔛 (g • β₀) := by
      refine zm_le_qv_of_dist_lt _ hν ?_
      have := dist_triangle 𝔛 ν μ' (g • β₀)
      rw [hdνμ', dist_eq_one_of_adj _ hμ'ρ] at this
      omega
    refine le_trans ?_ (S4A.usup_le_uloc h hφ hμ' hμ'ρ)
    rw [← hex2, Usup, zv_of_isMVtx _ hδ, Subgroup.commutator_comm]
    exact Subgroup.commutator_mono le_rfl hZνρ
  ·
    have hRZ : ⁅ZM 𝔛 ν, ZM 𝔛 (g • α₀)⁆ ≤ ZM 𝔛 ν :=
      Subgroup.le_normalizer_iff_commutator_le_left.mp (hZδs.trans (stab_le_normalizer_zm _ ν))
    have hdνμ : (puAmalgam h.le).treeGraph.dist ν μ ≤ 2 := by
      rw [tdist_comm, hνdef, dist_geo _ (by omega)]
    have hZμV : ZM 𝔛 μ ≤ Vv 𝔛 ν := by
      have := zv_le_vv h (α := ν) (ρ := μ) hdνμ
      rwa [zv_of_isMVtx _ hμ] at this
    have hab := vv_comm_eq_bot h hb hν
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer] at hab
    exact hRZ.trans ((zm_le_vv h hν).trans (hab.trans (Subgroup.centralizer_le hZμV)))

theorem card_inf_centralizer_of_good (hb : 4 < critDist 𝔛)
    (hV : ∀ δ δ' : Vtx 𝔛, IsCritical 𝔛 δ δ' → ¬ Vv 𝔛 δ ≤ Qv 𝔛 (geo 𝔛 δ' δ 2))
    {α₀ β₀ γ₀ : Vtx 𝔛} (hα₀ : IsMVtx 𝔛 α₀) (hγ₀ : IsMVtx 𝔛 γ₀) (hαβ₀ : 𝔄 α₀ β₀)
    (hβγ₀ : 𝔄 β₀ γ₀)
    (hex : ∀ g : 𝔘, ⁅ZM 𝔛 (g • α₀), Qv 𝔛 (g • γ₀)⁆ = Usup 𝔛 (g • α₀) (g • β₀) ∧
      Usup 𝔛 (g • α₀) (g • β₀) = Usup 𝔛 (g • γ₀) (g • β₀))
    {μ μ' : Vtx 𝔛} (hc : IsCritical 𝔛 μ μ')
    (hgood : Qv 𝔛 (geo 𝔛 μ μ' 3) ⊓ Subgroup.centralizer (Usup 𝔛 μ (geo 𝔛 μ μ' 1) : Set 𝔘) ≤
      Qv 𝔛 (geo 𝔛 μ μ' 2)) :
    Nat.card ↥(Uloc h.le L μ' ⊓ Subgroup.centralizer (ZM 𝔛 μ : Set 𝔘)) = Fintype.card F ^ 2 ∧
      ∃ g₁ g₂ : 𝔘, g₁ • γ₀ = μ' ∧ g₂ • γ₀ = μ' ∧
        ¬ ZM 𝔛 (g₁ • α₀) ≤ Qv 𝔛 (geo 𝔛 μ μ' 2) ∧ ¬ ZM 𝔛 (g₂ • α₀) ≤ Qv 𝔛 (geo 𝔛 μ μ' 2) ∧
        Uloc h.le L μ' ⊓ Subgroup.centralizer (ZM 𝔛 μ : Set 𝔘) ≤
          ⁅ZM 𝔛 (geo 𝔛 μ μ' 2), ZM 𝔛 (g₁ • α₀)⁆ ⊔ ⁅ZM 𝔛 (geo 𝔛 μ μ' 2), ZM 𝔛 (g₂ • α₀)⁆ := by
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have h20 := h.hyp20
  have hb0 := h.critDist_pos
  have hC := h.centHyp
  have hc' := ms22_iii _ h20 hb0 hC hc
  have hμ : IsMVtx 𝔛 μ := hc.1
  have hμ' : IsMVtx 𝔛 μ' := hc'.1
  have hZs : ZM 𝔛 μ ≤ stab 𝔛 μ' := zm_le_stab_right _ h20 hb0 hC hc
  obtain ⟨ψ, hψs, hψ⟩ := exists_natural_Uloc h hφ hμ'
  set C := Uloc h.le L μ' ⊓ Subgroup.centralizer (ZM 𝔛 μ : Set 𝔘) with hCdef
  have hRU : ⁅Uloc h.le L μ', ZM 𝔛 μ⁆ ≤ Uloc h.le L μ' :=
    Subgroup.le_normalizer_iff_commutator_le_left.mp (hZs.trans (stab_le_normalizer_uloc h μ'))
  have hRZ : ⁅Uloc h.le L μ', ZM 𝔛 μ⁆ ≤ ZM 𝔛 μ := by
    rw [Subgroup.commutator_comm]
    exact Subgroup.le_normalizer_iff_commutator_le_left.mp ((uloc_le_zm h hfull hμ').trans
      ((zm_le_stab_right _ h20 hb0 hC hc').trans (stab_le_normalizer_zm _ _)))
  have hZab : ZM 𝔛 μ ≤ Subgroup.centralizer (ZM 𝔛 μ : Set 𝔘) :=
    (zm_le_centralizer_qv _ h20 hμ).trans (Subgroup.centralizer_le (zm_le_qv_self _ hμ hb0))
  have hRC : ⁅Uloc h.le L μ', ZM 𝔛 μ⁆ ≤ C := le_inf hRU (hRZ.trans hZab)
  have hRe : ⁅ZM 𝔛 μ, ZM 𝔛 μ'⁆ = ⁅Uloc h.le L μ', ZM 𝔛 μ⁆ := by
    rw [Subgroup.commutator_comm, commutator_zm_eq_uloc h hfull hμ' hZs]
  have hRne : ⁅Uloc h.le L μ', ZM 𝔛 μ⁆ ≠ ⊥ := by
    rw [← hRe]
    exact ms22_ii _ h20 hb0 hC hc
  obtain ⟨u₀, hu₀, hu₀1⟩ := (Subgroup.bot_or_exists_ne_one _).resolve_left hRne
  set r := natVec hψ ⟨u₀, hRU hu₀⟩ with hrdef
  have hr0 : r ≠ 0 := by
    intro h0
    apply hu₀1
    have : (⟨u₀, hRU hu₀⟩ : ↥(Uloc h.le L μ')) = 1 :=
      natVec_injective hψ (by rw [← hrdef, h0, natVec_one])
    exact congrArg Subtype.val this
  have hrC : r ∈ fixN (natImage ψ (ZM 𝔛 μ)) :=
    (mem_centralizer_iff_natVec hψ hZs _).mp (hRC hu₀).2
  have hC2 : Module.finrank F (fixN (natImage ψ (ZM 𝔛 μ))) ≤ 2 := by
    have h3 := Submodule.finrank_le (fixN (natImage ψ (ZM 𝔛 μ)))
    rw [Module.finrank_fin_fun] at h3
    by_contra hcon
    have htop : fixN (natImage ψ (ZM 𝔛 μ)) = ⊤ :=
      Submodule.eq_top_of_finrank_eq (by rw [Module.finrank_fin_fun]; omega)
    exact hc.2.2 (le_qv_of_fixN_eq_top h hφ hμ' hψ hZs htop)
  have hgam : ∀ K' : Submodule F (Fin 3 → F), Module.finrank F K' = 2 → r ∉ K' →
      ∃ g : 𝔘, g • γ₀ = μ' ∧ commN (natImage ψ (Qv 𝔛 (g • β₀))) = K' ∧
        ¬ ⁅ZM 𝔛 μ, ZM 𝔛 μ'⁆ ≤ Usup 𝔛 μ' (g • β₀) := by
    intro K' hK' hrK'
    obtain ⟨ρ, hμ'ρ, hρK⟩ := exists_adj_commN_eq h hφ hC hb hμ' hψs hψ hK'
    obtain ⟨g, hgγ, hgβ⟩ := exists_smul_edge_of_isMVtx _ hγ₀ hβγ₀.symm hμ' hμ'ρ
    refine ⟨g, hgγ, hgβ ▸ hρK, fun hle => hrK' ?_⟩
    rw [← hρK, ← hgβ]
    rw [hRe] at hle
    exact (mem_usup_iff_natVec h hφ hμ' (hgβ ▸ hμ'ρ) hψ _).mp (hle hu₀)
  have hadj : ∀ g : 𝔘, g • γ₀ = μ' → 𝔄 μ' (g • β₀) := fun g hgγ => by
    rw [← hgγ]
    exact (adj_smul _ g γ₀ β₀).mpr hβγ₀.symm
  obtain ⟨K₁, hK₁, hrK₁⟩ := exists_plane_not_mem hr0
  obtain ⟨g₁, hg₁γ, hg₁K, hR₁⟩ := hgam K₁ hK₁ hrK₁
  obtain ⟨hn₁, hne₁, hq₁, hR₁C⟩ :=
    rdelta_of_good h hφ hb hV hα₀ hαβ₀ hβγ₀ hex hc hgood hg₁γ hR₁
  obtain ⟨u₁, hu₁, hu₁1⟩ := (Subgroup.bot_or_exists_ne_one _).resolve_left hne₁
  have hu₁U : u₁ ∈ Uloc h.le L μ' := (hR₁C hu₁).2.1
  set c := natVec hψ ⟨u₁, hu₁U⟩ with hcdef
  have hc0 : c ≠ 0 := by
    intro h0
    apply hu₁1
    have : (⟨u₁, hu₁U⟩ : ↥(Uloc h.le L μ')) = 1 :=
      natVec_injective hψ (by rw [← hcdef, h0, natVec_one])
    exact congrArg Subtype.val this
  have hcK₁ : c ∈ K₁ := by
    rw [← hg₁K]
    exact (mem_usup_iff_natVec h hφ hμ' (hadj g₁ hg₁γ) hψ _).mp (hR₁C hu₁).1
  have hcC : c ∈ fixN (natImage ψ (ZM 𝔛 μ)) :=
    (mem_centralizer_iff_natVec hψ hZs _).mp (hR₁C hu₁).2.2
  obtain ⟨K₂, hK₂, hrK₂, hcK₂⟩ := exists_plane_not_mem_two hr0 hc0
  obtain ⟨g₂, hg₂γ, hg₂K, hR₂⟩ := hgam K₂ hK₂ hrK₂
  obtain ⟨hn₂, -, hq₂, hR₂C⟩ :=
    rdelta_of_good h hφ hb hV hα₀ hαβ₀ hβγ₀ hex hc hgood hg₂γ hR₂
  have hline : K₁ ⊓ fixN (natImage ψ (ZM 𝔛 μ)) = Submodule.span F {c} := by
    symm
    refine Submodule.eq_of_le_of_finrank_le ?_ ?_
    · rw [Submodule.span_le, Set.singleton_subset_iff]
      exact ⟨hcK₁, hcC⟩
    · have hlt : K₁ ⊓ fixN (natImage ψ (ZM 𝔛 μ)) < fixN (natImage ψ (ZM 𝔛 μ)) :=
        lt_of_le_of_ne inf_le_right fun heq => hrK₁ (heq ▸ hrC).1
      have := Submodule.finrank_lt_finrank_of_lt hlt
      rw [finrank_span_singleton hc0]
      omega
  have hdisj : ∀ u ∈ Usup 𝔛 μ' (g₁ • β₀) ⊓ C, u ∈ Usup 𝔛 μ' (g₂ • β₀) → u = 1 := by
    intro u hu1 hu2
    have huU : u ∈ Uloc h.le L μ' := hu1.2.1
    have hv1 : natVec hψ ⟨u, huU⟩ ∈ K₁ := by
      rw [← hg₁K]
      exact (mem_usup_iff_natVec h hφ hμ' (hadj g₁ hg₁γ) hψ _).mp hu1.1
    have hv2 : natVec hψ ⟨u, huU⟩ ∈ K₂ := by
      rw [← hg₂K]
      exact (mem_usup_iff_natVec h hφ hμ' (hadj g₂ hg₂γ) hψ _).mp hu2
    have hvC := (mem_centralizer_iff_natVec hψ hZs ⟨u, huU⟩).mp hu1.2.2
    have hvl : natVec hψ ⟨u, huU⟩ ∈ Submodule.span F {c} := hline ▸ ⟨hv1, hvC⟩
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hvl
    have ha0 : a = 0 := by
      by_contra ha0
      apply hcK₂
      have : c = a⁻¹ • natVec hψ ⟨u, huU⟩ := by
        rw [← ha, smul_smul, inv_mul_cancel₀ ha0, one_smul]
      rw [this]
      exact K₂.smul_mem _ hv2
    have hv0 : natVec hψ ⟨u, huU⟩ = 0 := by rw [← ha, ha0, zero_smul]
    have : (⟨u, huU⟩ : ↥(Uloc h.le L μ')) = 1 := natVec_injective hψ (by rw [hv0, natVec_one])
    exact congrArg Subtype.val this
  set R₁ := ⁅ZM 𝔛 (geo 𝔛 μ μ' 2), ZM 𝔛 (g₁ • α₀)⁆ with hR₁def
  set R₂ := ⁅ZM 𝔛 (geo 𝔛 μ μ' 2), ZM 𝔛 (g₂ • α₀)⁆ with hR₂def
  have hR₁₂ : R₁ ⊓ R₂ = ⊥ := by
    rw [eq_bot_iff]
    intro u ⟨hu1, hu2⟩
    exact (Subgroup.mem_bot).mpr (hdisj u ⟨(hR₁C hu1).1, (hR₁C hu1).2⟩ (hR₂C hu2).1)
  have hR₁₂C : R₁ ⊔ R₂ ≤ C := sup_le (hR₁C.trans inf_le_right) (hR₂C.trans inf_le_right)
  have hfinU : Finite ↥(Uloc h.le L μ') := Nat.finite_of_card_ne_zero (by
    rw [card_eq_of_natural hψ]; exact pow_ne_zero _ Nat.card_pos.ne')
  have hfin12 : Finite ↥(R₁ ⊔ R₂) :=
    Finite.of_injective _ (Subgroup.inclusion_injective (hR₁₂C.trans inf_le_left))
  have hlow : Fintype.card F ^ 2 ≤ Nat.card ↥(R₁ ⊔ R₂) := by
    rw [sq]
    exact (Nat.mul_le_mul hq₁ hq₂).trans (card_mul_card_le_card_sup hR₁₂)
  have hq : 1 < Fintype.card F := by
    rw [← Nat.card_eq_fintype_card]
    exact Finite.one_lt_card
  have hCq : Nat.card ↥C ≤ Fintype.card F ^ 2 := by
    rw [hCdef, S46.I464.card_inf_centralizer_eq_pow hψ hZs, Nat.card_eq_fintype_card]
    exact Nat.pow_le_pow_right (by omega) hC2
  have hfinC : Finite ↥C := Finite.of_injective _ (Subgroup.inclusion_injective
    (inf_le_left : C ≤ Uloc h.le L μ'))
  have hR₁₂eq : R₁ ⊔ R₂ = C := Subgroup.eq_of_le_of_card_ge hR₁₂C (hCq.trans hlow)
  refine ⟨le_antisymm hCq ?_, g₁, g₂, hg₁γ, hg₂γ, hn₁, hn₂, hR₁₂eq.ge⟩
  rw [← hR₁₂eq]
  exact hlow

