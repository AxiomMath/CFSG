section Card

variable {G : Type*} [Group G]

theorem card_mul_card_le_card_sup' {A B : Subgroup G} [Finite ↥(A ⊔ B)] (hAB : A ⊓ B = ⊥) :
    Nat.card ↥A * Nat.card ↥B ≤ Nat.card ↥(A ⊔ B) := by
  rw [← Nat.card_prod]
  refine Nat.card_le_card_of_injective
    (fun p => ⟨(p.1 : G) * p.2, Subgroup.mul_mem_sup p.1.2 p.2.2⟩) ?_
  rintro ⟨a, b⟩ ⟨a', b'⟩ heq
  have heq' : (a : G) * b = a' * b' := congrArg Subtype.val heq
  have h1 : (a' : G)⁻¹ * a = b' * (b : G)⁻¹ := by
    calc (a' : G)⁻¹ * a = (a' : G)⁻¹ * (a * b) * (b : G)⁻¹ := by group
      _ = (a' : G)⁻¹ * (a' * b') * (b : G)⁻¹ := by rw [heq']
      _ = b' * (b : G)⁻¹ := by group
  have hmem : (a' : G)⁻¹ * a ∈ A ⊓ B :=
    ⟨A.mul_mem (A.inv_mem a'.2) a.2, h1 ▸ B.mul_mem b'.2 (B.inv_mem b.2)⟩
  rw [hAB, Subgroup.mem_bot] at hmem
  have ha : (a : G) = a' := by
    calc (a : G) = a' * ((a' : G)⁻¹ * a) := by group
      _ = a' := by rw [hmem, mul_one]
  have hb : (b : G) = b' := by
    rw [ha] at heq'
    exact mul_left_cancel heq'
  rw [Subtype.ext ha, Subtype.ext hb]

theorem card_sup_le_mul {A B : Subgroup G} [Finite ↥A] [Finite ↥B]
    (hAB : A ≤ Subgroup.normalizer (B : Set G)) :
    Nat.card ↥(A ⊔ B) ≤ Nat.card ↥A * Nat.card ↥B := by
  rw [← Nat.card_prod]
  have hset : ((A ⊔ B : Subgroup G) : Set G) = (A : Set G) * (B : Set G) :=
    Subgroup.coe_mul_of_left_le_normalizer_right A B hAB
  refine Nat.card_le_card_of_surjective (fun p : ↥A × ↥B =>
    (⟨(p.1 : G) * p.2, Subgroup.mul_mem_sup p.1.2 p.2.2⟩ : ↥(A ⊔ B))) ?_
  rintro ⟨z, hz⟩
  have hz' : z ∈ ((A ⊔ B : Subgroup G) : Set G) := hz
  rw [hset] at hz'
  obtain ⟨a, ha, b, hb, rfl⟩ := hz'
  exact ⟨(⟨a, ha⟩, ⟨b, hb⟩), rfl⟩

end Card

section Vertex

variable {G : Type} [Group G] [Finite G] {M T L : Subgroup G} (h : PUHyp M T L)
  (hfull : IsSL3Full M T L)
include h hfull

local notation "𝔘" => GoldAmalgam.Universal (puAmalgam h.le)

theorem commutator_le_line_of_levi_dloc {F : Type} [Field F] [Fintype F]
    {φ : ↥M →* ↥(StatedSL 3 F)} (hφ : IsSL3FullVia M T L φ) {μ : Vtx (puAmalgam h.le)}
    (hμ : IsMVtx _ μ)
    {ψ' : ↥(stab (puAmalgam h.le) μ) →* ↥(StatedSL 3 F)} (hψ's : Function.Surjective ψ')
    (hψ' : IsSumOfNaturalModulesVia (stab _ μ) (Uloc h.le L μ) ⊥ ψ' false 1)
    {x : 𝔘} (hxs : x ∈ stab (puAmalgam h.le) μ) {K' : Subgroup 𝔘}
    (hK'Q : ⁅K', Qv (puAmalgam h.le) μ⁆ ≤ Dloc h.le L μ)
    (hF1 : ∀ k : ↥(stab (puAmalgam h.le) μ), toSL3 ψ' k ∈ (ptLevi : Subgroup (SL3 F)) →
      x⁻¹ * ((k : 𝔘) * x * (k : 𝔘)⁻¹) ∈ K')
    {R' : Subgroup 𝔘} [Finite ↥R'] (hxR : ∀ y ∈ Qv (puAmalgam h.le) μ, ⁅x, y⁆ ∈ R')
    (hR : Nat.card ↥R' < Fintype.card F ^ 3)
    (hxUD : ∀ y ∈ Qv (puAmalgam h.le) μ, ⁅x, y⁆ ∈ Uloc h.le L μ ⊔ Dloc h.le L μ) :
    ∃ S₀ : Subgroup 𝔘, S₀ ≤ Uloc h.le L μ ∧ Nat.card ↥S₀ = Fintype.card F ∧
      (∀ k : ↥(stab (puAmalgam h.le) μ), toSL3 ψ' k ∈ (ptStab : Subgroup (SL3 F)) →
        ∀ u ∈ S₀, (k : 𝔘) * u * (k : 𝔘)⁻¹ ∈ S₀) ∧
      ∀ y ∈ Qv (puAmalgam h.le) μ, ⁅x, y⁆ ∈ S₀ ⊔ Dloc h.le L μ := by
  classical
  have h20 := h.hyp20
  have hb0 := h.critDist_pos
  obtain ⟨n, hn⟩ := hφ.1
  have hFn : Nat.card F = 2 ^ n := by rw [Nat.card_eq_fintype_card, hn]
  have : CharP F 2 := FFC.charP_two_of_card_pow hFn
  have hUn : stab (puAmalgam h.le) μ ≤ Subgroup.normalizer (Uloc h.le L μ : Set 𝔘) :=
    stab_le_normalizer_puTrans h.le (S4A.Uq_normal h) μ
  have hDn : stab (puAmalgam h.le) μ ≤ Subgroup.normalizer (Dloc h.le L μ : Set 𝔘) :=
    stab_le_normalizer_puTrans h.le (S4A.Dq_normal h) μ
  have hQs : Qv (puAmalgam h.le) μ ≤ stab _ μ := qv_le_stab _ μ
  have hDs : Dloc h.le L μ ≤ stab _ μ := puTrans_le_stab h.le _ μ
  have hZs : ZM (puAmalgam h.le) μ ≤ stab _ μ :=
    (zm_le_qv_self _ hμ hb0).trans hQs
  have hUZ : Uloc h.le L μ ≤ ZM (puAmalgam h.le) μ := uloc_le_zm h hfull hμ
  have hUs : Uloc h.le L μ ≤ stab _ μ := hUZ.trans hZs
  have : Finite ↥(stab (puAmalgam h.le) μ) := finite_stab h hμ
  have hfinD : Finite ↥(Dloc h.le L μ) := Finite.of_injective _ (Subgroup.inclusion_injective hDs)
  have hfinU : Finite ↥(Uloc h.le L μ) := Finite.of_injective _ (Subgroup.inclusion_injective hUs)
  have hZD : Uloc h.le L μ ⊓ Dloc h.le L μ = ⊥ := by
    have hUD : Uq M T L ⊓ Dq M L = ⊥ := by
      rw [h.Uq_inf_Dq, ← h.Uq_inf_Zq, inf_comm]
      exact hφ.2.2.2.1
    rw [Uloc, Dloc, ← puTrans_inf, hUD, puTrans, Subgroup.bot_subgroupOf, transN_bot]
  set R₀ : Set 𝔘 := {r | ∃ y ∈ Qv (puAmalgam h.le) μ, ⁅x, y⁆ = r} with hR₀
  set R := Subgroup.closure R₀ with hRdef
  have hRR' : R ≤ R' := (Subgroup.closure_le _).mpr fun _ ⟨y, hy, hr⟩ => hr ▸ hxR y hy
  have hfinR : Finite ↥R := Finite.of_injective _ (Subgroup.inclusion_injective hRR')
  have hRs : R ≤ stab (puAmalgam h.le) μ := (Subgroup.closure_le _).mpr fun _ ⟨y, hy, hr⟩ =>
    hr ▸ Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hxs (hQs hy))
      (Subgroup.inv_mem _ hxs)) (Subgroup.inv_mem _ (hQs hy))
  have hkR : ∀ k : ↥(stab (puAmalgam h.le) μ), toSL3 ψ' k ∈ (ptLevi : Subgroup (SL3 F)) →
      ∀ r ∈ R, (k : 𝔘) * r * (k : 𝔘)⁻¹ ∈ R ⊔ Dloc h.le L μ := by
    intro k hk r hr
    induction hr using Subgroup.closure_induction with
    | mem r hr =>
      obtain ⟨y, hy, rfl⟩ := hr
      set k₀ : 𝔘 := (k : 𝔘)
      have hc := hF1 k hk
      have hy' : k₀ * y * k₀⁻¹ ∈ Qv (puAmalgam h.le) μ :=
        (Subgroup.mem_normalizer_iff.mp (stab_le_normalizer_qv _ μ k.2) y).mp hy
      have hcD : ⁅x⁻¹ * (k₀ * x * k₀⁻¹), k₀ * y * k₀⁻¹⁆ ∈ Dloc h.le L μ :=
        hK'Q (Subgroup.commutator_mem_commutator hc hy')
      have e : k₀ * ⁅x, y⁆ * k₀⁻¹ =
          (x * ⁅x⁻¹ * (k₀ * x * k₀⁻¹), k₀ * y * k₀⁻¹⁆ * x⁻¹) * ⁅x, k₀ * y * k₀⁻¹⁆ := by
        simp only [commutatorElement_def]
        group
      rw [e, sup_comm]
      exact Subgroup.mul_mem_sup ((Subgroup.mem_normalizer_iff.mp (hDn hxs) _).mp hcD)
        (Subgroup.subset_closure ⟨_, hy', rfl⟩)
    | one => simp
    | mul a b _ _ ha hb =>
      have : (k : 𝔘) * (a * b) * (k : 𝔘)⁻¹ =
          ((k : 𝔘) * a * (k : 𝔘)⁻¹) * ((k : 𝔘) * b * (k : 𝔘)⁻¹) := by group
      rw [this]
      exact Subgroup.mul_mem _ ha hb
    | inv a _ ha =>
      have : (k : 𝔘) * a⁻¹ * (k : 𝔘)⁻¹ = ((k : 𝔘) * a * (k : 𝔘)⁻¹)⁻¹ := by group
      rw [this]
      exact Subgroup.inv_mem _ ha
  have hkRD : ∀ k : ↥(stab (puAmalgam h.le) μ), toSL3 ψ' k ∈ (ptLevi : Subgroup (SL3 F)) →
      ∀ r ∈ R ⊔ Dloc h.le L μ, (k : 𝔘) * r * (k : 𝔘)⁻¹ ∈ R ⊔ Dloc h.le L μ := by
    intro k hk r hr
    have hle : (R ⊔ Dloc h.le L μ).map (MulAut.conj (k : 𝔘)).toMonoidHom ≤
        R ⊔ Dloc h.le L μ := by
      rw [Subgroup.map_sup]
      refine sup_le ?_ ?_
      · rintro _ ⟨a, ha, rfl⟩
        exact hkR k hk a ha
      · rintro _ ⟨d, hd, rfl⟩
        exact Subgroup.mem_sup_right ((Subgroup.mem_normalizer_iff.mp (hDn k.2) d).mp hd)
    exact hle ⟨r, hr, by simp [MulAut.conj_apply]⟩
  set T := Uloc h.le L μ ⊓ (R ⊔ Dloc h.le L μ) with hTdef
  let Tc : AddSubgroup (Fin 3 → F) :=
    { carrier := {v | ∃ u : ↥(Uloc h.le L μ), (u : 𝔘) ∈ T ∧ natVec hψ' u = v}
      add_mem' := by
        rintro _ _ ⟨u, hu, rfl⟩ ⟨u', hu', rfl⟩
        exact ⟨u * u', T.mul_mem hu hu', natVec_mul hψ' u u'⟩
      zero_mem' := ⟨1, T.one_mem, natVec_one hψ'⟩
      neg_mem' := by
        rintro _ ⟨u, hu, rfl⟩
        exact ⟨u⁻¹, T.inv_mem hu, natVec_inv hψ' u⟩ }
  have hTc : ∀ g ∈ (ptLevi : Subgroup (SL3 F)), ∀ v ∈ Tc,
      ((g : SL3 F) : Matrix (Fin 3) (Fin 3) F) *ᵥ v ∈ Tc := by
    rintro g hg _ ⟨u, hu, rfl⟩
    obtain ⟨k, rfl⟩ := toSL3_surjective hψ's g
    have hku : (k : 𝔘) * u * (k : 𝔘)⁻¹ ∈ Uloc h.le L μ :=
      (Subgroup.mem_normalizer_iff.mp (hUn k.2) _).mp u.2
    exact ⟨⟨_, hku⟩, ⟨hku, hkRD k hg _ hu.2⟩, natVec_conj hψ' k u ⟨_, hku⟩ rfl⟩
  have hTcard : Nat.card ↥T ≤ Nat.card ↥R := by
    have hTD : T ⊓ Dloc h.le L μ = ⊥ := by
      rw [eq_bot_iff, ← hZD]
      exact inf_le_inf_right _ inf_le_left
    have hfinTD : Finite ↥(T ⊔ Dloc h.le L μ) := Finite.of_injective _
      (Subgroup.inclusion_injective (sup_le (inf_le_left.trans hUs) hDs))
    have hfinT : Finite ↥T := Finite.of_injective _ (Subgroup.inclusion_injective
      (inf_le_left.trans hUs))
    have h1 := card_mul_card_le_card_sup' hTD
    have hfinRD : Finite ↥(R ⊔ Dloc h.le L μ) :=
      Finite.of_injective _ (Subgroup.inclusion_injective (sup_le hRs hDs))
    have h2 := Subgroup.card_le_of_le (sup_le inf_le_right le_sup_right :
      T ⊔ Dloc h.le L μ ≤ R ⊔ Dloc h.le L μ)
    have h3 := card_sup_le_mul (hRs.trans hDn)
    have hpos : 0 < Nat.card ↥(Dloc h.le L μ) := Nat.card_pos
    exact Nat.le_of_mul_le_mul_right ((h1.trans h2).trans h3) hpos
  have hTc0 : ∀ v ∈ Tc, v ∈ pt0 := by
    rcases ptLevi_invariant_cases Tc hTc with hT | hT
    · exact hT
    · exfalso
      have hUT : Uloc h.le L μ ≤ T := by
        intro u hu
        obtain ⟨u', hu'T, hu'v⟩ := hT (natVec hψ' ⟨u, hu⟩)
        have : u' = ⟨u, hu⟩ := natVec_injective hψ' hu'v
        rw [this] at hu'T
        exact hu'T
      have hfinT : Finite ↥T := Finite.of_injective _ (Subgroup.inclusion_injective inf_le_left)
      have h1 := Subgroup.card_le_of_le hUT
      have h2 := Subgroup.card_le_of_le hRR'
      rw [card_eq_of_natural hψ', Nat.card_eq_fintype_card (α := F)] at h1
      omega
  let S₀ : Subgroup 𝔘 :=
    { carrier := {u | ∃ hu : u ∈ Uloc h.le L μ, natVec hψ' ⟨u, hu⟩ ∈ pt0}
      mul_mem' := by
        rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
        refine ⟨(Uloc h.le L μ).mul_mem ha hb, ?_⟩
        have : (⟨a * b, (Uloc h.le L μ).mul_mem ha hb⟩ : ↥(Uloc h.le L μ)) =
            ⟨a, ha⟩ * ⟨b, hb⟩ := rfl
        rw [this, natVec_mul]
        exact pt0.add_mem ha' hb'
      one_mem' := by
        refine ⟨(Uloc h.le L μ).one_mem, ?_⟩
        have : (⟨1, (Uloc h.le L μ).one_mem⟩ : ↥(Uloc h.le L μ)) = 1 := rfl
        rw [this, natVec_one]
        exact pt0.zero_mem
      inv_mem' := by
        rintro a ⟨ha, ha'⟩
        refine ⟨(Uloc h.le L μ).inv_mem ha, ?_⟩
        have : (⟨a⁻¹, (Uloc h.le L μ).inv_mem ha⟩ : ↥(Uloc h.le L μ)) = (⟨a, ha⟩)⁻¹ := rfl
        rw [this, natVec_inv]
        exact Submodule.neg_mem _ ha' }
  have hS₀U : S₀ ≤ Uloc h.le L μ := fun u hu => hu.1
  refine ⟨S₀, hS₀U, ?_, ?_, ?_⟩
  ·
    rw [← Nat.card_eq_fintype_card (α := F), ← ML3.card_pt0 (F := F)]
    refine Nat.card_congr
      { toFun := fun u => ⟨natVec hψ' ⟨u, u.2.1⟩, u.2.2⟩
        invFun := fun v => ⟨((natVec_surjective hψ' v).choose : _),
          (natVec_surjective hψ' v).choose.2, by
            rw [show (⟨((natVec_surjective hψ' v).choose : _),
              (natVec_surjective hψ' v).choose.2⟩ : ↥(Uloc h.le L μ)) =
                (natVec_surjective hψ' v).choose from rfl,
              (natVec_surjective hψ' v).choose_spec]
            exact v.2⟩
        left_inv := fun u => by
          have := (natVec_surjective hψ' (natVec hψ' ⟨u, u.2.1⟩)).choose_spec
          have h' := natVec_injective hψ' this
          apply Subtype.ext
          simp only
          exact congrArg Subtype.val h'
        right_inv := fun v => by
          apply Subtype.ext
          exact (natVec_surjective hψ' v).choose_spec }
  ·
    rintro k hk u ⟨hu, hu0⟩
    have hku : (k : 𝔘) * u * (k : 𝔘)⁻¹ ∈ Uloc h.le L μ :=
      (Subgroup.mem_normalizer_iff.mp (hUn k.2) _).mp hu
    refine ⟨hku, ?_⟩
    rw [natVec_conj hψ' k ⟨u, hu⟩ ⟨_, hku⟩ rfl, eq_smul_e0_of_mem_pt0 hu0, Matrix.mulVec_smul]
    exact pt0.smul_mem _ (mem_ptStab_iff_mulVec_e0.mp hk)
  ·
    intro y hy
    have hset : ((Uloc h.le L μ ⊔ Dloc h.le L μ : Subgroup _) : Set 𝔘) =
        (Uloc h.le L μ : Set _) * (Dloc h.le L μ : Set _) :=
      Subgroup.coe_mul_of_left_le_normalizer_right _ _ (hUs.trans hDn)
    have hxy' : ⁅x, y⁆ ∈ ((Uloc h.le L μ ⊔ Dloc h.le L μ : Subgroup _) : Set 𝔘) := hxUD y hy
    rw [hset] at hxy'
    obtain ⟨u, hu, w, hw, huw⟩ := hxy'
    have huT : u ∈ T := by
      refine ⟨hu, ?_⟩
      have : u = ⁅x, y⁆ * w⁻¹ := by rw [← huw]; group
      rw [this]
      exact Subgroup.mul_mem _ (Subgroup.mem_sup_left (Subgroup.subset_closure ⟨y, hy, rfl⟩))
        (Subgroup.mem_sup_right (Subgroup.inv_mem _ hw))
    have hu0 : natVec hψ' ⟨u, hu⟩ ∈ pt0 := hTc0 _ ⟨⟨u, hu⟩, huT, rfl⟩
    rw [← huw]
    exact Subgroup.mul_mem_sup ⟨hu, hu0⟩ hw

end Vertex

