namespace S512F

theorem three56ResA_holds (h32 : S32) (hX2 : S33.S33X52) (h52 : S52) (h54 : S54) :
    S512R.Three56ResA := by
  intro G _ _ M T L h hmin hb4 k F _ _ a hd α' ν μ₁ μ₂ hchS hq1 hq l hl g hg x hx hc56 w
    hwcase hnw hlarge hncrit
  exfalso
  have hch := S5B.isChain512Sel_subset hchS
  have hb0 := h.critDist_pos
  have hb : 2 < critDist (puAmalgam h.le) := by omega
  have hLn : (L.subgroupOf M).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer h.L_le).2 h.le_normalizer
  obtain ⟨hc, -, hcμ, ⟨y, hy, hμy⟩, hdμ, -, -⟩ := S512T.chain_geo h hb4 hch
  have hd4 : (puAmalgam h.le).treeGraph.dist (baseA _) α' = 4 := hc.2.1.trans hb4
  have hxst : x ∈ stab _ (baseA (puAmalgam h.le)) := puTrans_le_stab h.le L _ hx
  have hwst : w ∈ stab _ (baseA (puAmalgam h.le)) := by
    rcases hwcase with ⟨rfl, -⟩ | ⟨rfl, -⟩
    · exact hxst
    · exact inv_mem hxst
  have hwα : w • baseA (puAmalgam h.le) = baseA _ := (mem_stab _).1 hwst
  have hν : w⁻¹ • μ₁ = g⁻¹ • geo _ (baseA (puAmalgam h.le)) α' 2 ∨
      w⁻¹ • μ₁ = x⁻¹ • g⁻¹ • geo _ (baseA (puAmalgam h.le)) α' 2 := by
    rcases hwcase with ⟨rfl, he⟩ | ⟨rfl, he⟩
    · right
      rw [he]
    · left
      rw [he, inv_inv, smul_inv_smul]
  have hνlam : w⁻¹ • μ₁ ∈ S5.lam h (2 ^ k) a α' (geo _ (baseA (puAmalgam h.le)) α' 2) :=
    ⟨g, x, hg, hx, Or.inr ⟨l, hl, hc56⟩, hν⟩
  have hL : S512Z.Large h k (baseA _) (geo _ (baseA (puAmalgam h.le)) α' 2) ∨
      S512Z.Large h k (geo _ (baseA (puAmalgam h.le)) α' 2) (baseA _) := by
    right
    have e := S512Z.large_smul h y (geo _ (baseA (puAmalgam h.le)) α' 2) (baseA _) (k := k)
    rw [(mem_stab _).1 hy, ← hμy] at e
    exact e.1 hlarge
  have hstar := commutator_le_xm h32 hX2 h52 h54 h hmin hb4 hd hchS hl hL hνlam
  rw [S512T.zHat_eq h hd hc hq1] at hstar
  have hconj : ⁅S5.uSub h.le L μ₁ ⊓ Qv _ (w • geo _ (baseA (puAmalgam h.le)) α' 2),
      ZM _ (w • α')⁆ ≤ XM _ (baseA (puAmalgam h.le)) := by
    have e : (S5.uSub h.le L μ₁ ⊓ Qv _ (w • geo _ (baseA (puAmalgam h.le)) α' 2) :
        Subgroup _) = (S5.uSub h.le L (w⁻¹ • μ₁) ⊓
          Qv _ (geo _ (baseA (puAmalgam h.le)) α' 2)).map (MulAut.conj w).toMonoidHom := by
      rw [Subgroup.map_inf _ _ _ (MulAut.conj w).injective, ← S5B.uSub_smul h.le hLn,
        ← qv_smul, smul_inv_smul]
    have hX : XM _ (baseA (puAmalgam h.le)) =
        (XM _ (baseA (puAmalgam h.le))).map (MulAut.conj w).toMonoidHom := by
      rw [← xm_smul, hwα]
    rw [e, zm_smul, ← Subgroup.map_commutator, hX]
    exact Subgroup.map_mono hstar
  have hdwγ : (puAmalgam h.le).treeGraph.dist (baseA _)
      (w • geo _ (baseA (puAmalgam h.le)) α' 2) = 2 := by
    have := dist_smul _ w (baseA (puAmalgam h.le)) (geo _ (baseA (puAmalgam h.le)) α' 2)
    rw [hwα] at this
    rw [this]
    exact dist_geo _ (by omega)
  have hZQ : ZM _ μ₁ ≤ Qv _ (w • geo _ (baseA (puAmalgam h.le)) α' 2) := by
    have htri := dist_triangle _ μ₁ (baseA (puAmalgam h.le))
      (w • geo _ (baseA (puAmalgam h.le)) α' 2)
    have hdμ' : (puAmalgam h.le).treeGraph.dist μ₁ (baseA _) = 2 := by
      rw [SimpleGraph.dist_comm]
      exact hdμ
    rw [hdμ', hdwγ] at htri
    by_cases h4 : (puAmalgam h.le).treeGraph.dist μ₁
        (w • geo _ (baseA (puAmalgam h.le)) α' 2) = 4
    · by_contra hn
      exact hncrit ⟨hcμ.1, h4.trans hb4.symm, hn⟩
    · exact zm_le_qv_of_dist_lt _ hcμ.1 (by omega)
  rw [inf_eq_left.2 ((S5B.uSub_le_zm h.le μ₁).trans hZQ)] at hconj
  have hZst : ZM _ (w • α') ≤ stab _ (baseA (puAmalgam h.le)) := by
    rw [zm_smul]
    rintro _ ⟨z, hz, rfl⟩
    exact mul_mem (mul_mem hwst ((S5B.crit_facts h hc).1 hz)) (inv_mem hwst)
  apply hnw
  refine le_normalizer_sup_of_commutator_le (hZst.trans (stab_le_normalizer_xm _ _)) ?_
  exact ((Subgroup.commutator_mono inf_le_left le_rfl).trans hconj).trans le_sup_right

