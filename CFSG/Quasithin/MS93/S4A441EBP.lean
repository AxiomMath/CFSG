section Lin

variable {F : Type} [Field F]

theorem fixN_le_commN_of_finrank_eq_two [Finite F] [CharP F 2] {P : Subgroup (SL3 F)}
    (hP : IsPGroup 2 P) (h2 : Module.finrank F (commN P) = 2) : fixN P ≤ commN P := by
  obtain ⟨y, hy⟩ := exists_conj_le_sStar hP
  set S := P.map (MulAut.conj y).toMonoidHom with hS
  have hcS : commN S = ln01 := by
    refine Submodule.eq_of_le_of_finrank_eq (commN_le_ln01_of_le_sStar hy) ?_
    rw [hS, commN_map_conj, LinearEquiv.finrank_map_eq, h2, finrank_ln01]
  have hfS : fixN S ≤ commN S := by
    rw [hcS]
    intro v hv
    rw [mem_ln01]
    by_contra hv2
    have hc0 : ∀ g ∈ S, ∀ x : Fin 3 → F,
        ((g : SL3 F) : Matrix (Fin 3) (Fin 3) F) *ᵥ x - x ∈ pt0 := by
      intro g hg x
      obtain ⟨a, b, c, rfl⟩ := mem_sStar_iff.mp (hy hg)
      have hfix := congrFun (hv _ hg) 1
      rw [coe_uniTri] at hfix
      simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three] at hfix
      have hc : c = 0 := by
        rcases hfix with h | h
        · exact h
        · exact absurd h hv2
      rw [mem_pt0, coe_uniTri, hc]
      simp [dotProduct, Fin.sum_univ_three]
    have hle : commN S ≤ pt0 := Submodule.span_le.mpr (by
      rintro _ ⟨g, hg, x, rfl⟩
      exact hc0 g hg x)
    have := Submodule.finrank_mono hle
    rw [hcS, finrank_ln01, finrank_pt0] at this
    omega
  rw [hS, fixN_map_conj, commN_map_conj] at hfS
  exact (Submodule.map_le_map_iff_of_injective (LinearEquiv.injective _) _ _).mp hfS

theorem fixN_le_commN_or [Finite F] [CharP F 2] {E P : Subgroup (SL3 F)} (hEP : E ≤ P)
    (hP : IsPGroup 2 P) (h2 : Module.finrank F (commN P) = 2) (hE0 : E ≠ ⊥)
    (hEs : ∀ g ∈ E, g * g = 1) (hEc : ∀ g ∈ E, ∀ g' ∈ E, g * g' = g' * g) :
    fixN P ≤ commN E ∨ (commN P ≤ fixN E ∧ Module.finrank F (commN E) = 1) := by
  have hpH := fixN_le_commN_of_finrank_eq_two hP h2
  have hcH : commN E ≤ commN P := commN_mono hEP
  have hpC : fixN P ≤ fixN E := fixN_anti hEP
  have hcC : commN E ≤ fixN E := commN_le_fixN_of_elemAb hEs hEc
  have hc1 : 1 ≤ Module.finrank F (commN E) := by
    rw [Nat.one_le_iff_ne_zero, Ne, Submodule.finrank_eq_zero]
    exact commN_ne_bot hE0
  have hCtop : fixN E ≠ ⊤ := by
    intro htop
    apply hE0
    rw [eq_bot_iff]
    intro g hg
    rw [Subgroup.mem_bot]
    refine eq_one_of_mulVec_eq_self fun v => ?_
    have hv : v ∈ fixN E := by rw [htop]; trivial
    exact hv g hg
  have hf3 : Module.finrank F (fixN E) < 3 := by
    have := Submodule.finrank_lt hCtop
    rwa [Module.finrank_fin_fun] at this
  have hcf := Submodule.finrank_mono hcC
  have hcP := Submodule.finrank_mono hcH
  rcases (show Module.finrank F (fixN E) = 1 ∨ Module.finrank F (fixN E) = 2 by omega) with
    hf | hf
  · left
    have : commN E = fixN E := Submodule.eq_of_le_of_finrank_eq hcC (by omega)
    rw [this]
    exact hpC
  · by_cases hCH : fixN E = commN P
    · by_cases hw1 : Module.finrank F (commN E) = 1
      · exact Or.inr ⟨hCH.symm.le, hw1⟩
      · left
        have : commN E = commN P := Submodule.eq_of_le_of_finrank_eq hcH (by omega)
        rw [this]
        exact hpH
    · left
      have hI : Module.finrank F ↥(fixN E ⊓ commN P) = 1 :=
        finrank_inf_planes_eq_one hf h2 hCH
      have hcI : commN E ≤ fixN E ⊓ commN P := le_inf hcC hcH
      have : commN E = fixN E ⊓ commN P := Submodule.eq_of_le_of_finrank_eq hcI (by
        have := Submodule.finrank_mono hcI
        omega)
      rw [this]
      exact le_inf hpC hpH

end Lin

section Grp

variable {Γ : Type*} [Group Γ]

private theorem commutator_le_of_forall_mul {A Y N : Subgroup Γ}
    (h : ∀ v ∈ A, ∃ a c : Γ, v = a * c ∧ ∀ y ∈ Y, ⁅a, y⁆ ∈ N ∧ a * ⁅c, y⁆ * a⁻¹ ∈ N) :
    ⁅A, Y⁆ ≤ N := by
  rw [Subgroup.commutator_le]
  intro v hv y hy
  obtain ⟨a, c, rfl, hay⟩ := h v hv
  have e : ⁅a * c, y⁆ = a * ⁅c, y⁆ * a⁻¹ * ⁅a, y⁆ := by
    simp only [commutatorElement_def]; group
  rw [e]
  exact N.mul_mem (hay y hy).2 (hay y hy).1

end Grp

section Vertex

variable {G : Type} [Group G] [Finite G] {M T L : Subgroup G} (h : PUHyp M T L)
  {F : Type} [Field F] [Fintype F] {φ : ↥M →* ↥(StatedSL 3 F)} (hφ : IsSL3FullVia M T L φ)
include h hφ

local notation "𝔛" => puAmalgam h.le
local notation "𝔘" => GoldAmalgam.Universal (puAmalgam h.le)
local notation "𝔄" => SimpleGraph.Adj (GoldAmalgam.treeGraph (puAmalgam h.le))

theorem uloc_inf_centralizer_le_or (hb : 4 < critDist 𝔛) {w z : Vtx 𝔛}
    (hc : IsCritical 𝔛 w z) :
    Uloc h.le L w ⊓ Subgroup.centralizer (Qv 𝔛 (geo 𝔛 w z 1) : Set 𝔘) ≤
        ⁅ZM 𝔛 w, ZM 𝔛 z⁆ ∨
      (Usup 𝔛 w (geo 𝔛 w z 1) ≤ Subgroup.centralizer (ZM 𝔛 z : Set 𝔘) ∧
        Nat.card ↥⁅ZM 𝔛 w, ZM 𝔛 z⁆ = Fintype.card F) := by
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have h20 := h.hyp20
  have hb0 := h.critDist_pos
  have hC := h.centHyp
  obtain ⟨n, hn⟩ := hφ.1
  have : CharP F 2 := FFC.charP_two_of_card_pow (by rw [Nat.card_eq_fintype_card, hn])
  have hc' := ms22_iii _ h20 hb0 hC hc
  have hw : IsMVtx 𝔛 w := hc.1
  have hwρ : 𝔄 w (geo 𝔛 w z 1) := adj_geo_one_of_isCritical _ hb0 hc
  have hρH : ¬ IsMVtx 𝔛 (geo 𝔛 w z 1) := by
    rw [← isMVtx_iff_of_adj _ hwρ]
    exact hw
  have hTs : Qv 𝔛 (geo 𝔛 w z 1) ≤ stab 𝔛 w := qv_le_stab_of_adj _ hwρ.symm
  have hZT : ZM 𝔛 z ≤ Qv 𝔛 (geo 𝔛 w z 1) := zm_le_qv_geo_one _ h20 hb0 hc
  have hZs : ZM 𝔛 z ≤ stab 𝔛 w := hZT.trans hTs
  obtain ⟨ψ, -, hψ⟩ := exists_natural_Uloc h hφ hw
  obtain ⟨ψ', -, hψ'⟩ := exists_natural_Uloc h hφ hc'.1
  obtain ⟨-, -, -, -, -, hE0⟩ := s35_core h hC hφ hc hψ hψ'
  have hPT2 : IsPGroup 2 ↥(natImage ψ (Qv 𝔛 (geo 𝔛 w z 1))) :=
    ((isPGroup_qv _ h20 hρH).of_equiv (Subgroup.subgroupOfEquivOfLe hTs).symm).map (toSL3 ψ)
  have hkey := fixN_le_commN_or (natImage_mono hZT) hPT2
    (finrank_commN_qv h hφ hC hb hw hwρ hψ) hE0 (natImage_zm_sq h hc'.1) (natImage_zm_comm h hc'.1)
  rcases hkey with hk | ⟨hk1, hk2⟩
  · left
    rintro u ⟨huU, huc⟩
    have h1 := (mem_centralizer_iff_natVec hψ hTs ⟨u, huU⟩).mp huc
    rw [commutator_zm_eq_uloc h hfull hw hZs]
    exact (mem_commutator_iff_natVec hψ hZs ⟨u, huU⟩).mpr (hk h1)
  · right
    refine ⟨fun u hu => ?_, ?_⟩
    · have huU : u ∈ Uloc h.le L w := usup_le_uloc h hφ hw hwρ hu
      have h1 := (mem_usup_iff_natVec h hφ hw hwρ hψ ⟨u, huU⟩).mp hu
      exact (mem_centralizer_iff_natVec hψ hZs ⟨u, huU⟩).mpr (hk1 h1)
    · rw [commutator_zm_eq_uloc h hfull hw hZs, card_commutator_eq hψ hZs,
        Module.natCard_eq_pow_finrank (K := F), hk2, pow_one, Nat.card_eq_fintype_card]

theorem isCritical_relIndex_of_not_normalizer (hb : 4 < critDist 𝔛) {x y w : Vtx 𝔛}
    (hc : IsCritical 𝔛 x y) (hw : IsMVtx 𝔛 w) (hyw : (puAmalgam h.le).treeGraph.dist y w = 2)
    (hN : ¬ ZM 𝔛 x ≤ Subgroup.normalizer
      ((⁅ZM 𝔛 w, Qv 𝔛 y⁆ ⊔ ZM 𝔛 y : Subgroup 𝔘) : Set 𝔘))
    (h3 : ⁅ZM 𝔛 x, Vv 𝔛 y ⊓ Qv 𝔛 (geo 𝔛 x y 2)⁆ ≤ ZM 𝔛 y) :
    IsCritical 𝔛 w (geo 𝔛 x y 2) ∧ geo 𝔛 w (geo 𝔛 x y 2) 2 = y ∧
      (Qv 𝔛 (geo 𝔛 x y 2)).relIndex (ZM 𝔛 w) = Fintype.card F ^ 2 ∧
      Uloc h.le L w ⊓ Subgroup.centralizer (Qv 𝔛 (geo 𝔛 w (geo 𝔛 x y 2) 1) : Set 𝔘) ≤
        ⁅ZM 𝔛 w, ZM 𝔛 (geo 𝔛 x y 2)⁆ := by
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have h20 := h.hyp20
  have hb0 := h.critDist_pos
  have hC := h.centHyp
  obtain ⟨n, hn⟩ := hφ.1
  have : CharP F 2 := FFC.charP_two_of_card_pow (by rw [Nat.card_eq_fintype_card, hn])
  have hc' := ms22_iii _ h20 hb0 hC hc
  have hy : IsMVtx 𝔛 y := hc'.1
  have hd : (puAmalgam h.le).treeGraph.dist x y = critDist 𝔛 := hc.2.1
  set z := geo 𝔛 x y 2 with hz
  have hdzy : (puAmalgam h.le).treeGraph.dist z y = critDist 𝔛 - 2 := by
    rw [hz, dist_geo_right _ (by omega), hd]
  have hdyz : (puAmalgam h.le).treeGraph.dist y z = critDist 𝔛 - 2 := by
    rw [tdist_comm]
    exact hdzy
  have hdwy : (puAmalgam h.le).treeGraph.dist w y = 2 := by
    rw [tdist_comm]
    exact hyw
  have hZwV : ZM 𝔛 w ≤ Vv 𝔛 y := by
    have := zv_le_vv h (α := y) (ρ := w) hyw.le
    rwa [zv_of_isMVtx _ hw] at this
  have hQys : Qv 𝔛 y ≤ stab 𝔛 w := qv_le_stab_of_dist_le_two _ h20 hy hyw.le
  have hB : ⁅ZM 𝔛 w, Qv 𝔛 y⁆ ≤ ZM 𝔛 w :=
    Subgroup.le_normalizer_iff_commutator_le_left.mp (hQys.trans (stab_le_normalizer_zm _ w))
  have hZxn : ZM 𝔛 x ≤ Subgroup.normalizer (ZM 𝔛 y : Set 𝔘) :=
    (zm_le_stab_right _ h20 hb0 hC hc).trans (stab_le_normalizer_zm _ y)
  have hi : ¬ ⁅ZM 𝔛 w, Qv 𝔛 y⁆ ≤ Qv 𝔛 z := by
    intro hle
    apply hN
    refine le_normalizer_sup_of_commutator_le hZxn ?_
    rw [Subgroup.commutator_comm]
    exact ((Subgroup.commutator_mono le_rfl (le_inf (hB.trans hZwV) hle)).trans h3).trans
      le_sup_right
  have hwz : ¬ ZM 𝔛 w ≤ Qv 𝔛 z := fun hle => hi (hB.trans hle)
  have hdwz : (puAmalgam h.le).treeGraph.dist w z = critDist 𝔛 := by
    have t := dist_triangle 𝔛 w y z
    by_contra hne
    exact hwz (zm_le_qv_of_dist_lt _ hw (by omega))
  have hcwz : IsCritical 𝔛 w z := ⟨hw, hdwz, hwz⟩
  have hcwz' := ms22_iii _ h20 hb0 hC hcwz
  have hgeo : geo 𝔛 w z 2 = y := (eq_geo_of_dist _ hdwy (by omega)).symm
  obtain ⟨ψ, -, hψ⟩ := exists_natural_Uloc h hφ hw
  obtain ⟨ψ', -, hψ'⟩ := exists_natural_Uloc h hφ hcwz'.1
  obtain ⟨-, -, hrel, -, -, hE0⟩ := s35_core h hC hφ hcwz hψ hψ'
  have hZzs : ZM 𝔛 z ≤ stab 𝔛 w := zm_le_stab_of_isCritical _ h20 hb0 hcwz
  have hUn := stab_le_normalizer_uloc h w
  have hAU : ⁅Uloc h.le L w, Qv 𝔛 y⁆ ≤ Uloc h.le L w :=
    Subgroup.le_normalizer_iff_commutator_le_left.mp (hQys.trans hUn)
  have hcent : ZM 𝔛 w ⊓ Subgroup.centralizer (ZM 𝔛 z : Set 𝔘) = ZM 𝔛 w ⊓ Qv 𝔛 z :=
    zm_inf_centralizer_eq_inf_qv _ h20 hb0 hC hcwz
  set A := commN (natImage ψ (Qv 𝔛 y)) with hA
  set C := fixN (natImage ψ (ZM 𝔛 z)) with hCdef
  have hAC : ¬ A ≤ C := by
    intro hle
    apply hi
    rw [commutator_zm_eq_uloc h hfull hw hQys]
    intro v hv
    have hvU := hAU hv
    have h1 := (mem_commutator_iff_natVec hψ hQys ⟨v, hvU⟩).mp hv
    have h2 := (mem_centralizer_iff_natVec hψ hZzs ⟨v, hvU⟩).mpr (hle h1)
    have : v ∈ ZM 𝔛 w ⊓ Subgroup.centralizer (ZM 𝔛 z : Set 𝔘) :=
      ⟨uloc_le_zm h hfull hw hvU, h2⟩
    rw [hcent] at this
    exact this.2
  have hZwy : ZM 𝔛 w ≤ Qv 𝔛 y := zm_le_qv_of_dist_lt _ hw (by omega)
  have hACt : A ⊔ C ≠ ⊤ := by
    intro htop
    apply hN
    refine (ms21_vi _ h20 hb0 hc' hyw hZwy ?_).2
    refine commutator_le_of_forall_mul fun v hv => ?_
    have hv' : v ∈ ((Uloc h.le L w ⊔ Zloc h.le L w : Subgroup 𝔘) : Set 𝔘) := by
      rw [← zm_eq_uloc_sup_zloc h hfull hw]
      exact hv
    rw [Subgroup.coe_mul_of_left_le_normalizer_right _ _ ((uloc_le_zm h hfull hw).trans
      ((zm_le_qv_self _ hw hb0).trans ((qv_le_stab _ w).trans
        ((Subgroup.le_centralizer_iff.mp (zloc_le_centralizer_stab h hfull hw)).trans
          (Subgroup.centralizer_le_normalizer _)))))] at hv'
    obtain ⟨u, hu, ζ, hζ, huζ⟩ := hv'
    have hmem : natVec hψ ⟨u, hu⟩ ∈ A ⊔ C := by
      rw [htop]
      trivial
    obtain ⟨a, ha, c, hcC, hac⟩ := Submodule.mem_sup.mp hmem
    obtain ⟨ua, hua⟩ := natVec_surjective hψ a
    obtain ⟨uc, huc⟩ := natVec_surjective hψ c
    have hu_eq : (⟨u, hu⟩ : ↥(Uloc h.le L w)) = ua * uc :=
      natVec_injective hψ (by rw [natVec_mul, hua, huc, hac])
    have hua' : (ua : 𝔘) ∈ ⁅ZM 𝔛 w, Qv 𝔛 y⁆ := by
      rw [commutator_zm_eq_uloc h hfull hw hQys]
      exact (mem_commutator_iff_natVec hψ hQys ua).mpr (hua ▸ ha)
    have huc' : (uc : 𝔘) ∈ Subgroup.centralizer (ZM 𝔛 z : Set 𝔘) :=
      (mem_centralizer_iff_natVec hψ hZzs uc).mpr (huc ▸ hcC)
