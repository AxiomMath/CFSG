theorem map_conj_le_zloc_sup (hb4 : critDist (puAmalgam h.le) = 4)
    (hW : ∀ x : Vtx (puAmalgam h.le), IsMVtx _ x → ⁅Vv (puAmalgam h.le) x, Vv _ x⁆ ≤ Zloc h.le L x)
    {δ ρ : Vtx (puAmalgam h.le)} (hδ : IsMVtx _ δ) (hδρ : (puAmalgam h.le).treeGraph.Adj δ ρ)
    {A' : Subgroup (puAmalgam h.le).Universal}
    (hle : ⁅Uloc h.le L δ, A'⁆ ≤ ⁅ZM (puAmalgam h.le) δ, Qv _ ρ⁆)
    {h₀ : (puAmalgam h.le).Universal}
    (h₀N : h₀ ∈ Subgroup.normalizer (Qv (puAmalgam h.le) ρ : Set _))
    (hZ'' : ⁅Vv (puAmalgam h.le) δ, ZM _ (h₀ • δ)⁆ ≤ Zloc h.le L δ)
    (hcard'' : Nat.card ↥⁅Vv (puAmalgam h.le) δ, ZM _ (h₀ • δ)⁆ = Fintype.card F)
    (hH₁ : ⁅Vv (puAmalgam h.le) δ, ZM _ (h₀ • δ)⁆ ⊔ ⁅Uloc h.le L δ, A'⁆ =
      ⁅ZM (puAmalgam h.le) (h₀ • δ), Qv _ ρ⁆)
    {n : (puAmalgam h.le).Universal} (hns : n ∈ stab _ δ)
    (hnN : n ∈ Subgroup.normalizer (Qv (puAmalgam h.le) ρ : Set _))
    (hnR : ¬ (⁅Uloc h.le L δ, A'⁆).map (MulAut.conj n).toMonoidHom ≤ ⁅Uloc h.le L δ, A'⁆) :
    (⁅Uloc h.le L δ, A'⁆).map (MulAut.conj n).toMonoidHom ≤
      Zloc h.le L (h₀ • δ) ⊔ Zloc h.le L δ := by
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have h20 := h.hyp20
  have hb : 2 < critDist 𝔛 := by omega
  have hx' : IsMVtx 𝔛 (h₀ • δ) := (isMVtx_smul _ h₀ δ).mpr hδ
  have hx'ρ' : (puAmalgam h.le).treeGraph.Adj (h₀ • δ) (h₀ • ρ) := (adj_smul _ h₀ δ ρ).mpr hδρ
  have hTρ' : Qv 𝔛 (h₀ • ρ) = Qv _ ρ := qv_smul_eq_of_mem_normalizer h h₀N
  have hVδT : Vv 𝔛 δ ≤ Qv _ ρ := (vv_le_qv h hb hδ).trans (qv_le_qv _ h20 hδ hδρ)
  have hVδs : Vv 𝔛 δ ≤ stab _ (h₀ • δ) := by
    have := qv_le_stab_of_adj _ hx'ρ'.symm
    rw [hTρ'] at this
    exact hVδT.trans this
  have hR''eq : ⁅Vv 𝔛 δ, ZM _ (h₀ • δ)⁆ = ⁅Uloc h.le L (h₀ • δ), Vv 𝔛 δ⁆ :=
    (Subgroup.commutator_comm _ _).trans (commutator_zm_eq_uloc h hfull hx' hVδs)
  have hnN' : n ∈ Subgroup.normalizer (Qv 𝔛 (h₀ • ρ) : Set _) := by rw [hTρ']; exact hnN
  have hR''n : (⁅Vv 𝔛 δ, ZM _ (h₀ • δ)⁆).map (MulAut.conj n).toMonoidHom =
      ⁅Vv 𝔛 δ, ZM _ (h₀ • δ)⁆ :=
    map_conj_eq_of_forall_comm fun k hk =>
      Subgroup.mem_centralizer_iff.mp (zloc_le_centralizer_stab h hfull hδ (hZ'' hk)) n hns
  have hδs : Uloc h.le L δ ≤ stab _ δ := puTrans_le_stab h.le _ δ
  have hHU : ⁅ZM 𝔛 δ, Qv _ ρ⁆ ≤ Uloc h.le L δ := by
    rw [commutator_zm_eq_uloc h hfull hδ (qv_le_stab_of_adj _ hδρ.symm)]
    exact Subgroup.le_normalizer_iff_commutator_le_left.mp ((qv_le_stab_of_adj _ hδρ.symm).trans
      (stab_le_normalizer_puTrans h.le (S4A.Uq_normal h) δ))
  have hne : ⁅ZM 𝔛 (n • h₀ • δ), Qv _ (h₀ • ρ)⁆ ≠ ⁅ZM 𝔛 (h₀ • δ), Qv _ (h₀ • ρ)⁆ := by
    rw [hTρ']
    intro he
    apply hnR
    have hH₁n : (⁅ZM 𝔛 (h₀ • δ), Qv _ ρ⁆).map (MulAut.conj n).toMonoidHom =
        ⁅ZM 𝔛 (h₀ • δ), Qv _ ρ⁆ := by
      rw [Subgroup.map_commutator, ← zm_smul, map_conj_eq_of_mem_normalizer hnN, he]
    have hHn : (⁅ZM 𝔛 δ, Qv _ ρ⁆).map (MulAut.conj n).toMonoidHom = ⁅ZM 𝔛 δ, Qv _ ρ⁆ := by
      rw [Subgroup.map_commutator, map_conj_eq_of_mem_normalizer hnN,
        map_conj_eq_of_mem_normalizer (stab_le_normalizer_zm _ δ hns)]
    intro w hw
    have hw1 : w ∈ ⁅Vv 𝔛 δ, ZM _ (h₀ • δ)⁆ ⊔ ⁅Uloc h.le L δ, A'⁆ := by
      rw [hH₁, ← hH₁n, ← hH₁]
      exact Subgroup.map_mono le_sup_right hw
    have hw2 : w ∈ ⁅ZM 𝔛 δ, Qv _ ρ⁆ := by
      rw [← hHn]
      exact Subgroup.map_mono hle hw
    obtain ⟨a, ha, r, hr, rfl⟩ := exists_mul_of_mem_sup_of_commute (fun a ha b hb =>
      (Subgroup.mem_centralizer_iff.mp (zloc_le_centralizer_stab h hfull hδ (hZ'' ha)) b
        ((hle.trans (hHU.trans hδs)) hb)).symm) hw1
    have haH : a ∈ ⁅ZM 𝔛 δ, Qv _ ρ⁆ := by
      have := Subgroup.mul_mem _ hw2 (Subgroup.inv_mem _ (hle hr))
      rwa [mul_inv_cancel_right] at this
    have ha1 : a ∈ Uloc h.le L δ ⊓ Zloc h.le L δ := ⟨hHU haH, hZ'' ha⟩
    rw [uloc_inf_zloc h hfull δ, Subgroup.mem_bot] at ha1
    rw [ha1, one_mul]
    exact hr
  have hcard' : Nat.card ↥⁅Uloc h.le L (h₀ • δ), Vv 𝔛 δ⁆ = Fintype.card F := by
    rw [← hR''eq]
    exact hcard''
  have hle' : ⁅Uloc h.le L (h₀ • δ), Vv 𝔛 δ⁆ ≤ ⁅ZM 𝔛 (h₀ • δ), Qv _ (h₀ • ρ)⁆ := by
    rw [← hR''eq, hTρ', ← hH₁]
    exact le_sup_left
  have hRn' : (⁅Uloc h.le L (h₀ • δ), Vv 𝔛 δ⁆).map (MulAut.conj n).toMonoidHom =
      ⁅Uloc h.le L (h₀ • δ), Vv 𝔛 δ⁆ := by
    rw [← hR''eq]
    exact hR''n
  have hnot := not_vv_le_qv_of_ne h hφ h464 hsq h466 h461 h465 hb4 hx' hx'ρ' hVδs hcard' hle'
    hnN' hRn' hne
  obtain ⟨hZ3, -, hsup3⟩ := commutator_vv_zm_of_not_le h hφ hsq hb4 hx' hx'ρ' (hW _ hx') hVδs
    hcard' hle' hnN' hRn' hnot
  have hRn : (⁅Uloc h.le L δ, A'⁆).map (MulAut.conj n).toMonoidHom ≤
      ⁅ZM 𝔛 (n • h₀ • δ), Qv _ (h₀ • ρ)⁆ := by
    rw [hTρ', zm_smul, ← map_conj_eq_of_mem_normalizer hnN, ← Subgroup.map_commutator, ← hH₁]
    exact Subgroup.map_mono le_sup_right
  rw [← hsup3, ← hR''eq] at hRn
  exact hRn.trans (sup_le_sup hZ3 hZ'')

