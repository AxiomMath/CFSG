theorem qv_smul_eq_of_mem_normalizer {ρ : Vtx (puAmalgam h.le)} {n : (puAmalgam h.le).Universal}
    (hn : n ∈ Subgroup.normalizer (Qv (puAmalgam h.le) ρ : Set _)) :
    Qv (puAmalgam h.le) (n • ρ) = Qv _ ρ := by
  rw [qv_smul, map_conj_eq_of_mem_normalizer hn]

omit [Fintype F] hφ in
theorem zh_smul_eq_of_mem_normalizer {ρ : Vtx (puAmalgam h.le)} {n : (puAmalgam h.le).Universal}
    (hn : n ∈ Subgroup.normalizer (Qv (puAmalgam h.le) ρ : Set _)) :
    ZH (puAmalgam h.le) (n • ρ) = ZH _ ρ := by
  rw [ZH, ZH, qv_smul_eq_of_mem_normalizer h hn]

omit [Fintype F] hφ in
theorem zm_smul_le_vv {x ρ : Vtx (puAmalgam h.le)} (hx : IsMVtx _ x)
    (hxρ : (puAmalgam h.le).treeGraph.Adj x ρ) {n : (puAmalgam h.le).Universal}
    (hn : n ∈ Subgroup.normalizer (Qv (puAmalgam h.le) ρ : Set _)) :
    ZM (puAmalgam h.le) (n • x) ≤ Vv _ x := by
  have hρH : ¬ IsMVtx (puAmalgam h.le) ρ := (isMVtx_iff_of_adj _ hxρ).mp hx
  have hnx : IsMVtx (puAmalgam h.le) (n • x) := (isMVtx_smul _ n x).mpr hx
  have hadj : (puAmalgam h.le).treeGraph.Adj (n • ρ) (n • x) := (adj_smul _ n ρ x).mpr hxρ.symm
  calc ZM (puAmalgam h.le) (n • x) ≤ Vv _ (n • ρ) := zm_le_vv_of_adj hadj hnx
    _ = Vv _ ρ := vv_smul_eq_of_mem_normalizer h hρH hn
    _ ≤ Vv _ x := vv_le_vv_of_adj h hx hxρ

