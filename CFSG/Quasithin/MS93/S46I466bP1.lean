variable {𝔾 : Type*} [Group 𝔾]

theorem map_conj_eq_of_forall_comm {K : Subgroup 𝔾} {g : 𝔾} (hg : ∀ k ∈ K, g * k = k * g) :
    K.map (MulAut.conj g).toMonoidHom = K := by
  ext x
  constructor
  · rintro ⟨k, hk, rfl⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    rw [hg k hk, mul_inv_cancel_right]
    exact hk
  · intro hx
    refine ⟨x, hx, ?_⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    rw [hg x hx, mul_inv_cancel_right]

theorem map_map_conj_eq_conj_mul (K : Subgroup 𝔾) (a b : 𝔾) :
    (K.map (MulAut.conj b).toMonoidHom).map (MulAut.conj a).toMonoidHom =
      K.map (MulAut.conj (a * b)).toMonoidHom := by
  rw [Subgroup.map_map]
  congr 1
  ext x
  simp only [MonoidHom.coe_comp, Function.comp_apply, MulEquiv.coe_toMonoidHom,
    MulAut.conj_apply]
  group

end Grp

theorem count_absurd {q A B C D E : ℕ} (hq : 2 ≤ q) (hA : 0 < A) (hB : 0 < B)
    (h1 : E = q ^ 2 * B) (h2 : E ≤ D) (h3 : D * A = C * B) (h4 : C ≤ A * q) : False := by
  have h5 : q * q * (A * B) ≤ 1 * q * (A * B) := by
    calc q * q * (A * B) = q ^ 2 * B * A := by ring
      _ ≤ D * A := Nat.mul_le_mul_right A (h1 ▸ h2)
      _ = C * B := h3
      _ ≤ A * q * B := Nat.mul_le_mul_right B h4
      _ = 1 * q * (A * B) := by ring
  have h6 := Nat.le_of_mul_le_mul_right h5 (Nat.mul_pos hA hB)
  have h7 := Nat.le_of_mul_le_mul_right h6 (by omega)
  omega

