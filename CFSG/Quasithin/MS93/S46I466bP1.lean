theorem usup_le_zloc_of_isCritical (hb4 : critDist (puAmalgam h.le) = 4)
    (hW : ∀ x : Vtx (puAmalgam h.le), IsMVtx _ x → ⁅Vv (puAmalgam h.le) x, Vv _ x⁆ ≤ Zloc h.le L x)
    {δ l : Vtx (puAmalgam h.le)} (hc : IsCritical (puAmalgam h.le) δ l) :
    Usup (puAmalgam h.le) δ (geo _ δ l 1) ≤ Zloc h.le L (geo _ δ l 2) := by
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have hC := centHyp_of_gen23 h hfull
  have h20 := h.hyp20
  have hb0 : 0 < critDist 𝔛 := by omega
  have hδ : IsMVtx _ δ := hc.1
  have hδρ : (puAmalgam h.le).treeGraph.Adj δ (geo _ δ l 1) := adj_geo_one_of_isCritical _ hb0 hc
  have hργ : (puAmalgam h.le).treeGraph.Adj (geo _ δ l 1) (geo _ δ l 2) :=
    adj_geo_crit hb4 hc (i := 1) (by omega)
  have hγ : IsMVtx _ (geo 𝔛 δ l 2) := isMVtx_geo_two' hb4 hc
  have h23 : (puAmalgam h.le).treeGraph.Adj (geo _ δ l 2) (geo _ δ l 3) :=
    adj_geo_crit hb4 hc (i := 2) (by omega)
  have h34 : (puAmalgam h.le).treeGraph.Adj (geo _ δ l 3) l := by
