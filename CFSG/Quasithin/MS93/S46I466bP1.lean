theorem false_of_le_zloc_sup {δ ρ : Vtx (puAmalgam h.le)} (hδ : IsMVtx _ δ)
    (hδρ : (puAmalgam h.le).treeGraph.Adj δ ρ) {h₀ : (puAmalgam h.le).Universal}
    (h₀N : h₀ ∈ Subgroup.normalizer (Qv (puAmalgam h.le) ρ : Set _))
    {K : Subgroup (puAmalgam h.le).Universal} [Finite K] (hKcard : Nat.card K ≤ Fintype.card F)
    (hK : ∀ z ∈ ZH (puAmalgam h.le) ρ, h₀ * z * h₀⁻¹ * z⁻¹ ∈ K)
    (hsub : ⁅ZM (puAmalgam h.le) δ, Qv _ ρ⁆ ≤ Zloc h.le L (h₀ • δ) ⊔ Zloc h.le L δ) : False := by
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have hx' : IsMVtx 𝔛 (h₀ • δ) := (isMVtx_smul _ h₀ δ).mpr hδ
  have hx'ρ' : (puAmalgam h.le).treeGraph.Adj (h₀ • δ) (h₀ • ρ) := (adj_smul _ h₀ δ ρ).mpr hδρ
  have hZ₁ρ : Zloc h.le L (h₀ • δ) ≤ ZH 𝔛 ρ := by
    rw [← zh_smul_eq_of_mem_normalizer h h₀N]
    exact zloc_le_zh h hfull hx' hx'ρ'
  have hZ₂ρ : Zloc h.le L δ ≤ ZH 𝔛 ρ := zloc_le_zh h hfull hδ hδρ
  have hZc : ∀ a ∈ ZH 𝔛 ρ, ∀ b ∈ ZH 𝔛 ρ, a * b = b * a := fun a ha b hb =>
    (Subgroup.mem_centralizer_iff.mp (zh_le_centralizer _ ρ ha) b (zh_le_qv _ ρ hb)).symm
  have hZn : ∀ z ∈ ZH 𝔛 ρ, h₀ * z * h₀⁻¹ ∈ ZH 𝔛 ρ := by
    intro z hz
    have : h₀ * z * h₀⁻¹ ∈ ZH 𝔛 (h₀ • ρ) := by
      rw [zh_smul]
      exact ⟨z, hz, rfl⟩
    rwa [zh_smul_eq_of_mem_normalizer h h₀N] at this
  have hZ₁s : Zloc h.le L (h₀ • δ) ≤ stab _ (h₀ • δ) := puTrans_le_stab h.le _ _
  have hδs : Uloc h.le L δ ≤ stab _ δ := puTrans_le_stab h.le _ δ
  have : Finite ↥(Zloc h.le L (h₀ • δ)) := finite_of_le_stab h hx' hZ₁s
  have : Finite ↥(Zloc h.le L δ) := finite_of_le_stab h hδ (puTrans_le_stab h.le _ δ)
  have : Finite ↥(Zloc h.le L (h₀ • δ) ⊓ Zloc h.le L δ) :=
    finite_of_le_stab h hx' (inf_le_left.trans hZ₁s)
  have hZρs : ZH 𝔛 ρ ≤ stab _ δ :=
    (zh_le_zm _ hδρ).trans ((zm_le_qv_self _ hδ h.critDist_pos).trans (qv_le_stab _ δ))
  have : Finite ↥(Zloc h.le L (h₀ • δ) ⊔ Zloc h.le L δ) :=
    finite_of_le_stab h hδ ((sup_le hZ₁ρ hZ₂ρ).trans hZρs)
  have hHU : ⁅ZM 𝔛 δ, Qv _ ρ⁆ ≤ Uloc h.le L δ := by
    rw [commutator_zm_eq_uloc h hfull hδ (qv_le_stab_of_adj _ hδρ.symm)]
    exact Subgroup.le_normalizer_iff_commutator_le_left.mp ((qv_le_stab_of_adj _ hδρ.symm).trans
      (stab_le_normalizer_puTrans h.le (S4A.Uq_normal h) δ))
  have hHcard : Nat.card ↥⁅ZM 𝔛 δ, Qv _ ρ⁆ = Fintype.card F ^ 2 := by
    have := hsq δ ρ hδ hδρ
    rwa [Usup, zv_of_isMVtx _ hδ] at this
  have : Finite ↥⁅ZM 𝔛 δ, Qv _ ρ⁆ := Nat.finite_of_card_ne_zero (by rw [hHcard]; positivity)
  have hHZ : ⁅ZM 𝔛 δ, Qv _ ρ⁆ ⊓ Zloc h.le L δ = ⊥ := by
    refine eq_bot_iff.mpr ((inf_le_inf_right _ hHU).trans ?_)
    rw [uloc_inf_zloc h hfull δ]
  have hc1 := card_sup_mul_card_inf_of_commute (H := ⁅ZM 𝔛 δ, Qv _ ρ⁆) (K := Zloc h.le L δ)
    (fun a ha b hb => Subgroup.mem_centralizer_iff.mp
      (zloc_le_centralizer_stab h hfull hδ hb) a ((hHU.trans hδs) ha))
  rw [hHZ, Subgroup.card_bot, mul_one, hHcard] at hc1
  have hc2 := card_sup_mul_card_inf_of_commute (H := Zloc h.le L (h₀ • δ)) (K := Zloc h.le L δ)
    (fun a ha b hb => hZc a (hZ₁ρ ha) b (hZ₂ρ hb))
  have hc3 : Nat.card ↥(⁅ZM 𝔛 δ, Qv _ ρ⁆ ⊔ Zloc h.le L δ) ≤
      Nat.card ↥(Zloc h.le L (h₀ • δ) ⊔ Zloc h.le L δ) :=
    Subgroup.card_le_of_le (sup_le hsub le_sup_right)
  let f : ↥(Zloc h.le L (h₀ • δ)) →* 𝔘 := MonoidHom.mk'
    (fun a => h₀ * (a : 𝔘) * h₀⁻¹ * (a : 𝔘)⁻¹) fun a b => by
      have ha := hZ₁ρ a.2
      have hb := hZ₁ρ b.2
      have e1 : (a : 𝔘)⁻¹ * (h₀ * b * h₀⁻¹) = h₀ * b * h₀⁻¹ * (a : 𝔘)⁻¹ :=
        hZc _ (Subgroup.inv_mem _ ha) _ (hZn _ hb)
      have e2 : (a : 𝔘) * b = b * a := hZc _ ha _ hb
      simp only [Subgroup.coe_mul]
      calc h₀ * (↑a * ↑b) * h₀⁻¹ * (↑a * ↑b)⁻¹
          = h₀ * ↑a * h₀⁻¹ * (h₀ * ↑b * h₀⁻¹) * (↑a * ↑b)⁻¹ := by group
        _ = h₀ * ↑a * h₀⁻¹ * (h₀ * ↑b * h₀⁻¹) * (↑b * ↑a)⁻¹ := by rw [e2]
        _ = h₀ * ↑a * h₀⁻¹ * (h₀ * ↑b * h₀⁻¹ * (↑a)⁻¹) * (↑b)⁻¹ := by group
        _ = h₀ * ↑a * h₀⁻¹ * ((↑a)⁻¹ * (h₀ * ↑b * h₀⁻¹)) * (↑b)⁻¹ := by rw [e1]
        _ = h₀ * ↑a * h₀⁻¹ * (↑a)⁻¹ * (h₀ * ↑b * h₀⁻¹ * (↑b)⁻¹) := by group
  have hkZ : ∀ k : ↥(Zloc h.le L (h₀ • δ)), f k = 1 → (k : 𝔘) ∈ Zloc h.le L δ := by
    intro k hk
    have hk' : h₀ * (k : 𝔘) * h₀⁻¹ * (k : 𝔘)⁻¹ = 1 := hk
    have hk1 : h₀ * (k : 𝔘) * h₀⁻¹ = k := mul_inv_eq_one.mp hk'
    have hmem : (k : 𝔘) ∈ (Zloc h.le L δ).map (MulAut.conj h₀).toMonoidHom := by
      rw [← zloc_smul h h₀ δ]
      exact k.2
    obtain ⟨z, hz, hzk⟩ := hmem
    have e : h₀ * z * h₀⁻¹ = h₀ * (k : 𝔘) * h₀⁻¹ := hzk.trans hk1.symm
    rw [← mul_left_cancel (mul_right_cancel e)]
    exact hz
  have hker : Nat.card ↥f.ker ≤ Nat.card ↥(Zloc h.le L (h₀ • δ) ⊓ Zloc h.le L δ) :=
    Nat.card_le_card_of_injective
      (fun k => ⟨(k.1 : 𝔘), k.1.2, hkZ k.1 (MonoidHom.mem_ker.mp k.2)⟩)
      fun k k' hkk => by
        have e : ((k.1 : ↥(Zloc h.le L (h₀ • δ))) : 𝔘) = ((k'.1 : ↥(Zloc h.le L (h₀ • δ))) : 𝔘) :=
          congrArg (fun x : ↥(Zloc h.le L (h₀ • δ) ⊓ Zloc h.le L δ) => (x : 𝔘)) hkk
        exact Subtype.ext (Subtype.ext e)
  have hrange : f.range ≤ K := by
    rintro _ ⟨a, rfl⟩
    exact hK a (hZ₁ρ a.2)
  have hrc : Nat.card ↥f.range ≤ Fintype.card F := (Subgroup.card_le_of_le hrange).trans hKcard
  have hC : Nat.card ↥(Zloc h.le L (h₀ • δ)) ≤
      Nat.card ↥(Zloc h.le L (h₀ • δ) ⊓ Zloc h.le L δ) * Fintype.card F := by
    rw [← Subgroup.card_ker_mul_card_range f]
    exact Nat.mul_le_mul hker hrc
  have hq : 2 ≤ Fintype.card F := by
    rw [← Nat.card_eq_fintype_card]
    exact Finite.one_lt_card
  exact count_absurd hq Nat.card_pos Nat.card_pos hc1 hc3 hc2 hC

