  have : Finite ↥⁅Vv 𝔛 x, ZM _ (n • x)⁆ := finite_of_le_stab h hx (hDZ.trans hxs)
  have : Finite ↥⁅Uloc h.le L x, A'⁆ := finite_of_le_stab h hx (hRU.trans hUs)
