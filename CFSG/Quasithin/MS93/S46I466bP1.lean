include h461 h465 in
theorem commutator_centerOf_stab_le (hfull : IsSL3Full M T L)
    (hb : 2 < critDist (puAmalgam h.le)) {x : Vtx (puAmalgam h.le)} (hx : IsMVtx _ x)
    {w : (puAmalgam h.le).Universal} (hw : w ∈ centerOf (Vv _ x)) {k : (puAmalgam h.le).Universal}
    (hk : k ∈ stab _ x) : k * w * k⁻¹ * w⁻¹ ∈ ZM _ x := by
  have hZn := stab_le_normalizer_zm (puAmalgam h.le) x
  have hle : ⁅stab (puAmalgam h.le) x, Subgroup.zpowers w⁆ ≤ ZM _ x := by
    rw [stab_eq_ltil_sup_qv h hfull hx]
    refine S4A.commutator_sup_le_of ?_ ?_ ((ltil_le_stab h x).trans hZn)
      ((qv_le_stab _ x).trans hZn)
    · rw [Subgroup.commutator_le]
      rintro l hl _ ⟨m, rfl⟩
      have hwm : w ^ m ∈ centerOf (Vv (puAmalgam h.le) x) := Subgroup.zpow_mem _ hw m
      have hB := (mem_bloc_iff h hb hx).mp (h461 x hx hwm)
      have := hB.2 l hl
      rw [← commutatorElement_inv]
      exact Subgroup.inv_mem _ this
    · rw [Subgroup.commutator_comm]
      refine (Subgroup.commutator_mono ?_ le_rfl).trans (h465 x hx)
      rw [Subgroup.zpowers_le]
      exact hw.1
  have := hle (Subgroup.commutator_mem_commutator hk (Subgroup.mem_zpowers w))
  simpa [commutatorElement_def] using this

include h464 hsq h466 h461 h465 in
theorem not_vv_le_qv_of_ne (hb4 : critDist (puAmalgam h.le) = 4) {x ρ : Vtx (puAmalgam h.le)}
    (hx : IsMVtx _ x) (hxρ : (puAmalgam h.le).treeGraph.Adj x ρ)
    {A' : Subgroup (puAmalgam h.le).Universal} (hA' : A' ≤ stab _ x)
    (hcard : Nat.card ↥⁅Uloc h.le L x, A'⁆ = Fintype.card F)
    (hle : ⁅Uloc h.le L x, A'⁆ ≤ ⁅ZM (puAmalgam h.le) x, Qv _ ρ⁆)
    {n : (puAmalgam h.le).Universal}
    (hnN : n ∈ Subgroup.normalizer (Qv (puAmalgam h.le) ρ : Set _))
    (hRn : (⁅Uloc h.le L x, A'⁆).map (MulAut.conj n).toMonoidHom = ⁅Uloc h.le L x, A'⁆)
    (hne : ⁅ZM (puAmalgam h.le) (n • x), Qv _ ρ⁆ ≠ ⁅ZM (puAmalgam h.le) x, Qv _ ρ⁆) :
    ¬ Vv (puAmalgam h.le) x ≤ Qv _ (n • x) := by
  intro hVQ
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have h20 := h.hyp20
  have hb : 2 < critDist (puAmalgam h.le) := by omega
  have hb0 : 0 < critDist (puAmalgam h.le) := by omega
  set R' := ⁅Uloc h.le L x, A'⁆ with hR'def
  obtain ⟨g, hgs, hgN, hg3, hgZ, hsup, -⟩ := exists_rot h hφ h464 hsq h466 hx hxρ hA' hcard hle
  have hnx : IsMVtx (puAmalgam h.le) (n • x) := (isMVtx_smul _ n x).mpr hx
  have hnxρ : (puAmalgam h.le).treeGraph.Adj (n • x) (n • ρ) := (adj_smul _ n x ρ).mpr hxρ
  have hTn := qv_smul_eq_of_mem_normalizer h hnN
  have hZnV := zm_smul_le_vv h hx hxρ hnN
  have hZnc : ZM (puAmalgam h.le) (n • x) ≤ centerOf (Vv _ x) :=
    le_inf hZnV ((zm_le_centralizer_qv _ h20 hnx).trans (Subgroup.centralizer_le hVQ))
  have hZnT : ZM (puAmalgam h.le) (n • x) ≤ Qv _ ρ := by
    rw [← hTn]
    exact (zm_le_qv_self _ hnx hb0).trans (qv_le_qv _ h20 hnx hnxρ)
  have hcoc : ∀ w ∈ ZM (puAmalgam h.le) (n • x), g * w * g⁻¹ * w⁻¹ ∈ ZH _ ρ := by
    intro w hw
    have hZn := stab_le_normalizer_zm (puAmalgam h.le) x
    set c := g * w * g⁻¹ * w⁻¹ with hcdef
    have hc : c ∈ ZM (puAmalgam h.le) x :=
      commutator_centerOf_stab_le h h461 h465 hfull hb hx (hZnc hw) hgs
    set a := g * c * g⁻¹ with hadef
    have ha : a ∈ ZM (puAmalgam h.le) x := (Subgroup.mem_normalizer_iff.mp (hZn hgs) c).mp hc
    have hrel : g * a * g⁻¹ * a * c = 1 := by
      have e : g * a * g⁻¹ * a * c * w = g ^ 3 * w * (g ^ 3)⁻¹ := by
        rw [hadef, hcdef, pow_three]; group
      rw [hg3, one_mul, inv_one, mul_one] at e
      exact mul_right_cancel (e.trans (one_mul w).symm)
    have ha2 : a * a = 1 := by
      rw [← sq]; exact (isElemAbelian_zm _ h20 hb0 hx).2 a ha
    have e : c = (g * a * g⁻¹ * a⁻¹)⁻¹ := by
      rw [inv_eq_of_mul_eq_one_right ha2]
      exact eq_inv_of_mul_eq_one_right hrel
    rw [e]
    exact Subgroup.inv_mem _ (hgZ a ha)
  have hgHn : (⁅ZM (puAmalgam h.le) (n • x), Qv _ ρ⁆).map (MulAut.conj g).toMonoidHom ≤
      ⁅ZM (puAmalgam h.le) (n • x), Qv _ ρ⁆ := by
    rw [Subgroup.map_commutator, map_conj_eq_of_mem_normalizer hgN, Subgroup.commutator_le]
    rintro _ ⟨w, hw, rfl⟩ t ht
    have hc' := hcoc w hw
    have hc'T := zh_le_centralizer _ ρ hc'
    have hwt : w * t * w⁻¹ ∈ Qv (puAmalgam h.le) ρ :=
      Subgroup.mul_mem _ (Subgroup.mul_mem _ (hZnT hw) ht) (Subgroup.inv_mem _ (hZnT hw))
    have e : ⁅(MulAut.conj g).toMonoidHom w, t⁆ = ⁅w, t⁆ := by
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      have h1 := Subgroup.mem_centralizer_iff.mp hc'T _ hwt
      calc ⁅g * w * g⁻¹, t⁆ = (g * w * g⁻¹ * w⁻¹) * (w * t * w⁻¹) *
            (g * w * g⁻¹ * w⁻¹)⁻¹ * t⁻¹ := by simp only [commutatorElement_def]; group
        _ = (w * t * w⁻¹) * (g * w * g⁻¹ * w⁻¹) * (g * w * g⁻¹ * w⁻¹)⁻¹ * t⁻¹ := by rw [h1]
        _ = ⁅w, t⁆ := by simp only [commutatorElement_def]; group
    rw [e]
    exact Subgroup.commutator_mem_commutator hw ht
  have hHn : ⁅ZM (puAmalgam h.le) (n • x), Qv _ ρ⁆ =
      (⁅ZM (puAmalgam h.le) x, Qv _ ρ⁆).map (MulAut.conj n).toMonoidHom := by
    rw [Subgroup.map_commutator, ← zm_smul, map_conj_eq_of_mem_normalizer hnN]
  have hRHn : R' ≤ ⁅ZM (puAmalgam h.le) (n • x), Qv _ ρ⁆ := by
    rw [← hRn, hHn]
    exact Subgroup.map_mono hle
  have hle' : ⁅ZM (puAmalgam h.le) x, Qv _ ρ⁆ ≤ ⁅ZM (puAmalgam h.le) (n • x), Qv _ ρ⁆ := by
    rw [← hsup]
    exact sup_le hRHn ((Subgroup.map_mono hRHn).trans hgHn)
  apply hne
  have hHcard : Nat.card ↥⁅ZM (puAmalgam h.le) x, Qv _ ρ⁆ = Fintype.card F ^ 2 := by
    have := hsq x ρ hx hxρ
    rwa [Usup, zv_of_isMVtx _ hx] at this
  have hHncard : Nat.card ↥⁅ZM (puAmalgam h.le) (n • x), Qv _ ρ⁆ = Fintype.card F ^ 2 := by
    rw [hHn, Subgroup.card_map_of_injective (MulAut.conj n).injective, hHcard]
  have : Finite ↥⁅ZM (puAmalgam h.le) (n • x), Qv _ ρ⁆ :=
    Nat.finite_of_card_ne_zero (by rw [hHncard]; positivity)
  exact (Subgroup.eq_of_le_of_card_ge hle' (by rw [hHcard, hHncard])).symm

theorem card_le_card_commutator_uloc {y : Vtx (puAmalgam h.le)} (hy : IsMVtx _ y)
    {A : Subgroup (puAmalgam h.le).Universal} (hA : A ≤ stab _ y) (hAQ : ¬ A ≤ Qv _ y) :
    Fintype.card F ≤ Nat.card ↥⁅Uloc h.le L y, A⁆ := by
  obtain ⟨ψ, -, hψ⟩ := exists_natural_Uloc h hφ hy
  rw [card_commutator_eq hψ hA, ← Nat.card_eq_fintype_card]
  refine card_le_commN fun hbot => hAQ fun a ha => ?_
  have h1 : toSL3 ψ ⟨a, hA ha⟩ = 1 := by
    have : toSL3 ψ ⟨a, hA ha⟩ ∈ natImage ψ A := mem_natImage.mpr ⟨_, ha, rfl⟩
    rwa [hbot, Subgroup.mem_bot] at this
  exact (toSL3_eq_one_iff_mem_qv h hφ hy hψ _).mp h1

include hsq in
theorem commutator_vv_zm_of_not_le (hb4 : critDist (puAmalgam h.le) = 4)
    {x ρ : Vtx (puAmalgam h.le)} (hx : IsMVtx _ x) (hxρ : (puAmalgam h.le).treeGraph.Adj x ρ)
    (hW : ⁅Vv (puAmalgam h.le) x, Vv _ x⁆ ≤ Zloc h.le L x)
    {A' : Subgroup (puAmalgam h.le).Universal} (hA' : A' ≤ stab _ x)
    (hcard : Nat.card ↥⁅Uloc h.le L x, A'⁆ = Fintype.card F)
    (hle : ⁅Uloc h.le L x, A'⁆ ≤ ⁅ZM (puAmalgam h.le) x, Qv _ ρ⁆)
    {n : (puAmalgam h.le).Universal}
    (hnN : n ∈ Subgroup.normalizer (Qv (puAmalgam h.le) ρ : Set _))
    (hRn : (⁅Uloc h.le L x, A'⁆).map (MulAut.conj n).toMonoidHom = ⁅Uloc h.le L x, A'⁆)
    (hnot : ¬ Vv (puAmalgam h.le) x ≤ Qv _ (n • x)) :
    ⁅Vv (puAmalgam h.le) x, ZM _ (n • x)⁆ ≤ Zloc h.le L x ∧
      Nat.card ↥⁅Vv (puAmalgam h.le) x, ZM _ (n • x)⁆ = Fintype.card F ∧
      ⁅Vv (puAmalgam h.le) x, ZM _ (n • x)⁆ ⊔ ⁅Uloc h.le L x, A'⁆ =
        ⁅ZM (puAmalgam h.le) (n • x), Qv _ ρ⁆ := by
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have h20 := h.hyp20
  have hb : 2 < critDist 𝔛 := by omega
  have hnx : IsMVtx 𝔛 (n • x) := (isMVtx_smul _ n x).mpr hx
  have hnxρ : (puAmalgam h.le).treeGraph.Adj (n • x) (n • ρ) := (adj_smul _ n x ρ).mpr hxρ
  have hTn := qv_smul_eq_of_mem_normalizer h hnN
  have hZnV := zm_smul_le_vv h hx hxρ hnN
  have hVT : Vv 𝔛 x ≤ Qv _ ρ := (vv_le_qv h hb hx).trans (qv_le_qv _ h20 hx hxρ)
