variable {G : Type} [Group G] [Finite G] {M T L : Subgroup G} (h : PUHyp M T L)
  {F : Type} [Field F] [Fintype F] {φ : ↥M →* ↥(StatedSL 3 F)}
include h

local notation "𝔛" => puAmalgam h.le
local notation "𝔘" => GoldAmalgam.Universal (puAmalgam h.le)

theorem false_of_conf (hC : CentHyp 𝔛) (hb : 4 < critDist 𝔛)
    (hV : ∀ δ δ' : Vtx 𝔛, IsCritical 𝔛 δ δ' → ¬ Vv 𝔛 δ ≤ Qv 𝔛 (geo 𝔛 δ' δ 2))
    (h441 : ∀ δ δ' : Vtx 𝔛, IsCritical 𝔛 δ δ' → Concl441 h.le L δ (geo 𝔛 δ δ' 2))
    (hcomm : S442Comm) (hffd : S442FFD) (hH : Hyp40 h φ) {α α' δ : Vtx 𝔛}
    (hconf : Conf442 𝔛 α α' δ)
    (hN : stab 𝔛 α ≤ Subgroup.normalizer ((conjCl (stab 𝔛 (geo 𝔛 α α' 2)) (ZM 𝔛 α) ⊔
      conjCl (stab 𝔛 α) (ZM 𝔛 (geo 𝔛 α α' 2)) : Subgroup 𝔘) : Set 𝔘)) : False := by
  have hφ : IsSL3FullVia M T L φ := hH.2.2
  have h20 := h.hyp20
  have hb0 := h.critDist_pos
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  obtain ⟨n, hn⟩ := ms21_v _ h20
  have hconf' := hconf
  obtain ⟨hc, hA, hB, hdδ, hpath⟩ := hconf
  have hd : (𝔛).treeGraph.dist α α' = critDist 𝔛 := hc.2.1
  have hd' : (𝔛).treeGraph.dist α' α = critDist 𝔛 := by rw [tdist_comm]; exact hd
  have hα : IsMVtx 𝔛 α := hc.1
  have hβ : (𝔛).treeGraph.Adj α (geo 𝔛 α α' 1) := adj_geo_one_of_isCritical _ hb0 hc
  have hβγ : (𝔛).treeGraph.Adj (geo 𝔛 α α' 1) (geo 𝔛 α α' 2) := adj_geo _ (by omega)
  have hγ : IsMVtx 𝔛 (geo 𝔛 α α' 2) := isMVtx_geo_two _ h20 hb0 hc
  have hdγ : (𝔛).treeGraph.dist α (geo 𝔛 α α' 2) = 2 := dist_geo _ (by omega)
  have hδ2 : geo 𝔛 α δ (2 * (n - 1)) = δ := by
    rw [show 2 * (n - 1) = (𝔛).treeGraph.dist α δ by omega, geo_dist]
  have hcδ : IsCritical 𝔛 δ (geo 𝔛 α α' 2) := by
    have := hpath (n - 1) (by omega) (by omega)
    rwa [hδ2, show critDist 𝔛 - 2 * (n - 1) = 2 by omega] at this
  have hδM : IsMVtx 𝔛 δ := hcδ.1
  have hsym2 : geo 𝔛 α α' (critDist 𝔛 - 2) = geo 𝔛 α' α 2 := by
    have := geo_symm (𝔛) (u := α') (w := α) (i := 2) (by omega)
    rwa [hd'] at this
  have hcδ₂ : IsCritical 𝔛 (geo 𝔛 α δ 2) (geo 𝔛 α' α 2) := by
    have := hpath 1 (by omega) (by omega)
    rwa [show 2 * 1 = 2 from rfl, hsym2] at this
  have hδ₁ : (𝔛).treeGraph.Adj α (geo 𝔛 α δ 1) := adj_geo_one _ (by omega)
  obtain ⟨g, hg, hgβ⟩ := exists_mem_stab_smul _ hβ hδ₁
  have hgα : g • α = α := (mem_stab _).mp hg
  have hν : IsMVtx 𝔛 (g • geo 𝔛 α α' 2) := (isMVtx_smul _ g _).mpr hγ
  have hdαν : (𝔛).treeGraph.dist α (g • geo 𝔛 α α' 2) = 2 := by
    have := dist_smul (𝔛) g α (geo 𝔛 α α' 2)
    rwa [hgα, hdγ] at this
  have hδ₁ν : (𝔛).treeGraph.Adj (geo 𝔛 α δ 1) (g • geo 𝔛 α α' 2) := by
    rw [← hgβ]
    exact (adj_smul _ g _ _).2 hβγ
  have hZνV : ZM 𝔛 (g • geo 𝔛 α α' 2) ≤ conjCl (stab 𝔛 α) (ZM 𝔛 (geo 𝔛 α α' 2)) := by
    rw [zm_smul]
    exact le_iSup₂_of_le (f := fun k (_ : k ∈ stab 𝔛 α) =>
      (ZM 𝔛 (geo 𝔛 α α' 2)).map (MulAut.conj k).toMonoidHom) g hg le_rfl
  have hνne : g • geo 𝔛 α α' 2 ≠ geo 𝔛 α δ 2 := by
    intro he
    apply hcδ₂.2.2
    rw [← he]
    exact hZνV.trans hA
  have hδ₁δ : (𝔛).treeGraph.dist (geo 𝔛 α δ 1) δ = critDist 𝔛 - 3 := by
    rw [dist_geo_right _ (by omega)]
    omega
  have hδ₂e : geo 𝔛 α δ 2 = geo 𝔛 (geo 𝔛 α δ 1) δ 1 := by
    have hadd : (𝔛).treeGraph.dist α δ = (𝔛).treeGraph.dist α (geo 𝔛 α δ 1) +
        (𝔛).treeGraph.dist (geo 𝔛 α δ 1) δ := by
      rw [dist_geo _ (by omega), hδ₁δ]
      omega
    have := geo_of_dist_eq_add (𝔛) hadd (k := 1) (by omega)
    rwa [dist_geo _ (by omega)] at this
  have hdνδ : (𝔛).treeGraph.dist (g • geo 𝔛 α α' 2) δ = critDist 𝔛 - 2 := by
    have t1 := dist_triangle (𝔛) (g • geo 𝔛 α α' 2) (geo 𝔛 α δ 1) δ
    have t2 := dist_triangle (𝔛) (geo 𝔛 α δ 1) (g • geo 𝔛 α α' 2) δ
    rw [tdist_comm _ (g • geo 𝔛 α α' 2) (geo 𝔛 α δ 1), dist_eq_one_of_adj _ hδ₁ν, hδ₁δ] at t1
    rw [dist_eq_one_of_adj _ hδ₁ν, hδ₁δ] at t2
    obtain ⟨r, hr⟩ := (even_dist_iff (𝔛) (g • geo 𝔛 α α' 2) δ).mpr ⟨fun _ => hδM, fun _ => hν⟩
    by_contra hne
    have h1 : (𝔛).treeGraph.dist (g • geo 𝔛 α α' 2) δ + 1 =
        (𝔛).treeGraph.dist (geo 𝔛 α δ 1) δ := by
      rw [hδ₁δ]
      omega
    exact hνne ((eq_geo_one (𝔛) hδ₁ν h1).trans hδ₂e.symm)
  have hV₁g : (conjCl (stab 𝔛 (geo 𝔛 α α' 2)) (ZM 𝔛 α)).map (MulAut.conj g).toMonoidHom =
      conjCl (stab 𝔛 (g • geo 𝔛 α α' 2)) (ZM 𝔛 α) := by
    rw [conjCl_map_conj, ← stab_smul, ← zm_smul, hgα]
  have hVg : (conjCl (stab 𝔛 α) (ZM 𝔛 (geo 𝔛 α α' 2))).map (MulAut.conj g).toMonoidHom =
