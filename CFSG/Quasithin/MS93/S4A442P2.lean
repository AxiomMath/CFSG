    rw [eq_bot_iff, ← uloc_inf_dloc h hφ δ]
    exact inf_le_inf hR''U hSD
  have hsupR₂ : ⁅ZM 𝔛 (geo 𝔛 α α' 2), ZM 𝔛 δ⁆ ⊔ ⁅ZM 𝔛 (g • geo 𝔛 α α' 2), Vv 𝔛 δ⁆ ≤
      ⁅ZM 𝔛 (geo 𝔛 α α' 2), Vv 𝔛 δ ⊓ Qv 𝔛 α⁆ := sup_le hR''R₂ hS
  have : Finite ↥(⁅ZM 𝔛 (geo 𝔛 α α' 2), ZM 𝔛 δ⁆ ⊔ ⁅ZM 𝔛 (g • geo 𝔛 α α' 2), Vv 𝔛 δ⁆) :=
    Finite.of_injective _ (Subgroup.inclusion_injective hsupR₂)
  have hmul := card_mul_card_le_card_sup hinter
  have heq := Subgroup.eq_of_le_of_card_ge hsupR₂ (by
    rw [hcR₂, sq]
    calc Fintype.card F * Fintype.card F
        ≤ Nat.card ↥⁅ZM 𝔛 (geo 𝔛 α α' 2), ZM 𝔛 δ⁆ *
            Nat.card ↥⁅ZM 𝔛 (g • geo 𝔛 α α' 2), Vv 𝔛 δ⁆ := by
          rw [hcR'', hc₃]
          exact Nat.mul_le_mul_left _ (Nat.le_self_pow (by omega) _)
      _ ≤ _ := hmul)
  apply hR₂
  rw [← heq]
  exact sup_le_sup hR''Z hSD

end Main

