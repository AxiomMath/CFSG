variable {A B : Type u} {C : Type v} [Group A] [Group C] [Group B] (X : GoldAmalgam A C B)

theorem exists_isCritical_path (h : Hyp20 X) (hb : 0 < critDist X)
    (hV : ∀ δ δ' : Vtx X, IsCritical X δ δ' → ¬ Vv X δ ≤ Qv X (geo X δ' δ 2)) {α α' : Vtx X}
    (hc : IsCritical X α α') :
    ∀ i, 2 * i + 2 ≤ critDist X → ∃ ρ, X.treeGraph.dist α ρ = 2 * i ∧
      IsCritical X ρ (geo X α α' (critDist X - 2 * i)) ∧
      ∀ k, 0 < k → k ≤ i →
        IsCritical X (geo X α ρ (2 * k)) (geo X α α' (critDist X - 2 * k)) := by
  have hd : X.treeGraph.dist α α' = critDist X := hc.2.1
  intro i
  induction i with
  | zero =>
    intro _
    refine ⟨α, by simp, ?_, fun k hk hki => by omega⟩
    rw [Nat.mul_zero, Nat.sub_zero, ← hd, geo_dist]
    exact hc
  | succ i ih =>
    intro hi
    obtain ⟨ρ, hρα, hρc, hpath⟩ := ih (by omega)
    have hαw : X.treeGraph.dist α (geo X α α' (critDist X - 2 * (i + 1))) =
        critDist X - 2 * (i + 1) := dist_geo X (by omega)
    have hwv : X.treeGraph.dist (geo X α α' (critDist X - 2 * (i + 1)))
        (geo X α α' (critDist X - 2 * i)) = 2 := by
      rw [dist_geo_geo X (by omega) (by omega)]
      omega
    have hρv : X.treeGraph.dist ρ (geo X α α' (critDist X - 2 * i)) = critDist X := hρc.2.1
    have hw : geo X α α' (critDist X - 2 * (i + 1)) =
        geo X (geo X α α' (critDist X - 2 * i)) ρ 2 := by
      have t1 := dist_triangle X ρ α (geo X α α' (critDist X - 2 * (i + 1)))
      have t2 := dist_triangle X ρ (geo X α α' (critDist X - 2 * (i + 1)))
        (geo X α α' (critDist X - 2 * i))
      rw [hαw, tdist_comm X ρ α, hρα] at t1
      rw [hwv, hρv] at t2
      have e1 : X.treeGraph.dist (geo X α α' (critDist X - 2 * i))
          (geo X α α' (critDist X - 2 * (i + 1))) = 2 := by
        rw [SimpleGraph.dist_comm]; exact hwv
      apply eq_geo_of_dist X e1
      rw [e1, tdist_comm X _ ρ, tdist_comm X (geo X α α' (critDist X - 2 * i)) ρ, hρv]
      omega
    obtain ⟨ρ', hρρ', hρ'c⟩ := exists_isCritical_step X h hb hρc (hV ρ _ hρc)
    rw [← hw] at hρ'c
    have hρ'w : X.treeGraph.dist ρ' (geo X α α' (critDist X - 2 * (i + 1))) = critDist X :=
      hρ'c.2.1
    have t1 := dist_triangle X α ρ ρ'
    have t2 := dist_triangle X ρ' α (geo X α α' (critDist X - 2 * (i + 1)))
    rw [hρα, hρρ'] at t1
    rw [hαw, hρ'w] at t2
    have hαρ' : X.treeGraph.dist α ρ' = 2 * (i + 1) := by
      rw [tdist_comm X ρ' α] at t2
      omega
    have hadd : X.treeGraph.dist α ρ' = X.treeGraph.dist α ρ + X.treeGraph.dist ρ ρ' := by
      omega
    refine ⟨ρ', hαρ', hρ'c, fun k hk hki => ?_⟩
    rcases Nat.lt_or_ge k (i + 1) with hlt | hge
    · rw [geo_eq_of_dist_eq_add X hadd (k := 2 * k) (by omega)]
      exact hpath k hk (by omega)
    · obtain rfl : k = i + 1 := by omega
      have e : geo X α ρ' (2 * (i + 1)) = ρ' := by rw [← hαρ', geo_dist]
      rw [e]
      exact hρ'c

theorem exists_conf442 (h : Hyp20 X) (hb : 4 < critDist X)
    (hV : ∀ δ δ' : Vtx X, IsCritical X δ δ' → ¬ Vv X δ ≤ Qv X (geo X δ' δ 2)) {α α' : Vtx X}
    (hc : IsCritical X α α')
    (hA : conjCl (stab X α) (ZM X (geo X α α' 2)) ≤ Qv X (geo X α' α 2))
    (hB : ∀ g ∈ stab X α,
      conjCl (stab X (g • geo X α α' 2)) (ZM X α) ≤ Qv X (geo X α' α 4)) :
    ∃ δ, Conf442 X α α' δ := by
  obtain ⟨n, hn⟩ := ms21_v X h
  obtain ⟨δ, hδα, -, hpath⟩ := exists_isCritical_path X h (by omega) hV hc (n - 1) (by omega)
  exact ⟨δ, hc, hA, hB, by omega, fun k hk hkb => hpath k hk (by omega)⟩

theorem zm_le_stab_of_dist_le {ρ ε : Vtx X} (hρ : IsMVtx X ρ) (hb : 0 < critDist X)
    (hd : X.treeGraph.dist ρ ε ≤ critDist X) : ZM X ρ ≤ stab X ε := by
  rcases hd.lt_or_eq with hlt | heq
  · exact (zm_le_qv_of_dist_lt X hρ hlt).trans (qv_le_stab X ε)
  · have hd1 : 0 < X.treeGraph.dist ε ρ := by rw [tdist_comm, heq]; exact hb
    have hadj : X.treeGraph.Adj ε (geo X ε ρ 1) := adj_geo_one X hd1
    have hlt : X.treeGraph.dist ρ (geo X ε ρ 1) < critDist X := by
      rw [tdist_comm, dist_geo_right X (show 1 ≤ X.treeGraph.dist ε ρ from hd1), tdist_comm,
        heq]
      omega
    exact (zm_le_qv_of_dist_lt X hρ hlt).trans (qv_le_stab_of_adj X hadj.symm)

end Path

section Lin

variable {F : Type} [Field F]

theorem fixN_le_commN_of_lt_card [Finite F] [CharP F 2] {E : Subgroup (SL3 F)}
    (h2 : ∀ g ∈ E, g * g = 1) (hc : ∀ g ∈ E, ∀ g' ∈ E, g * g' = g' * g)
    (hcard : Nat.card F < Nat.card E) : fixN E ≤ commN E := by
  have hle := commN_le_fixN_of_elemAb h2 hc
  have hE : E ≠ ⊥ := by
    intro h0
    rw [h0, Subgroup.card_bot] at hcard
    exact absurd hcard (not_lt.mpr Nat.card_pos)
  have hd0 : 0 < Module.finrank F (commN E) := by
    rw [Nat.pos_iff_ne_zero, Ne, Submodule.finrank_eq_zero]
    exact commN_ne_bot hE
  have hfix : fixN E ≠ ⊤ := by
    intro htop
    apply hE
    rw [eq_bot_iff]
    intro g hg
    rw [Subgroup.mem_bot]
    refine eq_one_of_mulVec_eq_self fun x => ?_
    have hx : x ∈ fixN E := by rw [htop]; trivial
    exact hx g hg
  have hf3 : Module.finrank F (fixN E) < 3 := by
    have := Submodule.finrank_lt hfix
    rwa [Module.finrank_fin_fun] at this
  have hmono := Submodule.finrank_mono hle
  suffices he : Module.finrank F (commN E) = Module.finrank F (fixN E) from
    (Submodule.eq_of_le_of_finrank_eq hle he).symm.le
  by_cases hf2 : 2 ≤ Module.finrank F (fixN E)
  · have h1 : ¬ Module.finrank F (commN E) ≤ 1 := fun h1 =>
      absurd (S46.I464.card_le_of_finrank hf2 h1) (not_le.mpr hcard)
    omega
  · omega

theorem commutator_sup_left_le_of {Γ : Type*} [Group Γ] {A B Y N : Subgroup Γ}
    (hAN : A ≤ Subgroup.normalizer (N : Set Γ)) (hBN : B ≤ Subgroup.normalizer (N : Set Γ))
    (hA : ⁅A, Y⁆ ≤ N) (hB : ⁅B, Y⁆ ≤ N) : ⁅A ⊔ B, Y⁆ ≤ N := by
  let S : Subgroup Γ :=
    { carrier := {y | y ∈ Subgroup.normalizer (N : Set Γ) ∧ ∀ x ∈ Y, ⁅y, x⁆ ∈ N}
      one_mem' := ⟨one_mem _, fun x _ => by simp⟩
      mul_mem' := by
        rintro y₁ y₂ ⟨hy₁, h₁⟩ ⟨hy₂, h₂⟩
        refine ⟨mul_mem hy₁ hy₂, fun x hx => ?_⟩
        have e : ⁅y₁ * y₂, x⁆ = y₁ * ⁅y₂, x⁆ * y₁⁻¹ * ⁅y₁, x⁆ := by
          simp only [commutatorElement_def]; group
        rw [e]
        exact mul_mem ((Subgroup.mem_normalizer_iff.mp hy₁ _).mp (h₂ x hx)) (h₁ x hx)
      inv_mem' := by
        rintro y ⟨hy, h⟩
        refine ⟨inv_mem hy, fun x hx => ?_⟩
        have e : ⁅y⁻¹, x⁆ = y⁻¹ * ⁅y, x⁆⁻¹ * y := by
          simp only [commutatorElement_def]; group
        rw [e]
        have hy' : y⁻¹ ∈ Subgroup.normalizer (N : Set Γ) := inv_mem hy
        have := (Subgroup.mem_normalizer_iff.mp hy' _).mp (inv_mem (h x hx))
        simpa [mul_assoc] using this }
  have hAS : A ≤ S := fun y hy =>
    ⟨hAN hy, fun x hx => hA (Subgroup.commutator_mem_commutator hy hx)⟩
  have hBS : B ≤ S := fun y hy =>
    ⟨hBN hy, fun x hx => hB (Subgroup.commutator_mem_commutator hy hx)⟩
  rw [Subgroup.commutator_le]
  intro y hy x hx
  exact (sup_le hAS hBS hy).2 x hx

end Lin

