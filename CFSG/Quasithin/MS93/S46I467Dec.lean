theorem commutator_biSup_le_of {𝔾 : Type*} [Group 𝔾] {ι : Type*} {p : ι → Prop}
    {A : ι → Subgroup 𝔾} {H N : Subgroup 𝔾} (hA : ∀ i, p i → ⁅A i, H⁆ ≤ N)
