section Axis

variable {F : Type} [Field F]

theorem axisGroup_comm {P : Submodule F (Fin 3 → F)} {B C : SL3 F} (hB : B ∈ axisGroup P)
    (hC : C ∈ axisGroup P) : B * C = C * B := by
  have key : ∀ {B C : SL3 F}, B ∈ axisGroup P → C ∈ axisGroup P → ∀ x : Fin 3 → F,
      ((B * C : SL3 F) : Matrix (Fin 3) (Fin 3) F) *ᵥ x =
        x + ((B : Matrix (Fin 3) (Fin 3) F) *ᵥ x - x) +
          ((C : Matrix (Fin 3) (Fin 3) F) *ᵥ x - x) := by
    intro B C hB hC x
    have e : ((B * C : SL3 F) : Matrix (Fin 3) (Fin 3) F) *ᵥ x =
        (B : Matrix (Fin 3) (Fin 3) F) *ᵥ (x + ((C : Matrix (Fin 3) (Fin 3) F) *ᵥ x - x)) := by
      rw [coe_mul_SL3, ← Matrix.mulVec_mulVec]
      congr 1
      abel
    rw [e, Matrix.mulVec_add, hB.1 _ (hC.2 x)]
    abel
  apply Subtype.ext
  refine Matrix.ext_of_mulVec_single fun i => ?_
  change ((B * C : SL3 F) : Matrix (Fin 3) (Fin 3) F) *ᵥ Pi.single i 1 =
    ((C * B : SL3 F) : Matrix (Fin 3) (Fin 3) F) *ᵥ Pi.single i 1
  rw [key hB hC, key hC hB]
  abel

theorem axisGroup_mul_self [CharP F 2] {P : Submodule F (Fin 3 → F)} {B : SL3 F}
    (hB : B ∈ axisGroup P) : B * B = 1 := by
  apply eq_one_of_mulVec_eq_self
  intro x
  have hBx : (B : Matrix (Fin 3) (Fin 3) F) *ᵥ x = x + ((B : Matrix (Fin 3) (Fin 3) F) *ᵥ x - x) :=
    by abel
  have hBy : (B : Matrix (Fin 3) (Fin 3) F) *ᵥ ((B : Matrix (Fin 3) (Fin 3) F) *ᵥ x - x) =
      (B : Matrix (Fin 3) (Fin 3) F) *ᵥ x - x := hB.1 _ (hB.2 x)
  rw [coe_mul_SL3, ← Matrix.mulVec_mulVec]
  conv_lhs => rw [hBx]
  rw [Matrix.mulVec_add, hBy]
  have h2 := CharTwo.add_self_eq_zero ((B : Matrix (Fin 3) (Fin 3) F) *ᵥ x - x)
  calc (B : Matrix (Fin 3) (Fin 3) F) *ᵥ x + ((B : Matrix (Fin 3) (Fin 3) F) *ᵥ x - x)
      = x + (((B : Matrix (Fin 3) (Fin 3) F) *ᵥ x - x) +
          ((B : Matrix (Fin 3) (Fin 3) F) *ᵥ x - x)) := by abel
    _ = x := by rw [h2, add_zero]

end Axis

section Tree

universe u v

variable {A B : Type u} {C : Type v} [Group A] [Group C] [Group B] {X : GoldAmalgam A C B}

theorem exists_mem_stab_smul_eq {δ β ρ : Vtx X} (hδ : IsMVtx X δ) (hβ : X.treeGraph.Adj δ β)
    (hρ : X.treeGraph.Adj δ ρ) : ∃ k ∈ stab X δ, k • β = ρ := by
  obtain ⟨g, rfl⟩ := exists_eq_smul_baseA X hδ
  have hβ' : X.treeGraph.Adj (baseA X) (g⁻¹ • β) := by
    have := (adj_smul X g⁻¹ (g • baseA X) β).mpr hβ
    rwa [inv_smul_smul] at this
  have hρ' : X.treeGraph.Adj (baseA X) (g⁻¹ • ρ) := by
    have := (adj_smul X g⁻¹ (g • baseA X) ρ).mpr hρ
    rwa [inv_smul_smul] at this
  obtain ⟨a, ha⟩ := (adj_baseA_iff X _).mp hβ'
  obtain ⟨a', ha'⟩ := (adj_baseA_iff X _).mp hρ'
  have e1 : g⁻¹ • β = X.ofA a • baseB X := by rw [ha, smul_baseB]; rfl
  have e2 : g⁻¹ • ρ = X.ofA a' • baseB X := by rw [ha', smul_baseB]; rfl
  have hfix : ∀ b : A, X.ofA b • baseA X = baseA X := fun b => by
    have : X.ofA b ∈ MulAction.stabilizer X.Universal (baseA X) := by
      rw [stabilizer_baseA]
      exact ⟨b, rfl⟩
    exact this
  have h1 : (X.ofA a)⁻¹ • baseA X = baseA X := by
    rw [inv_smul_eq_iff, hfix]
  refine ⟨g * X.ofA a' * (X.ofA a)⁻¹ * g⁻¹, ?_, ?_⟩
  · rw [mem_stab]
    calc (g * X.ofA a' * (X.ofA a)⁻¹ * g⁻¹) • (g • baseA X)
        = g • (X.ofA a' • ((X.ofA a)⁻¹ • (g⁻¹ • (g • baseA X)))) := by simp only [mul_smul]
      _ = g • baseA X := by rw [inv_smul_smul, h1, hfix]
  · calc (g * X.ofA a' * (X.ofA a)⁻¹ * g⁻¹) • β
        = g • (X.ofA a' • ((X.ofA a)⁻¹ • (g⁻¹ • β))) := by simp only [mul_smul]
      _ = g • (g⁻¹ • ρ) := by rw [e1, inv_smul_smul, ← e2]
      _ = ρ := smul_inv_smul g ρ

end Tree

section Hvtx

variable {G : Type} [Group G] [Finite G] {M T L : Subgroup G} (h : PUHyp M T L)
include h

local notation "𝔛" => puAmalgam h.le
local notation "𝔘" => GoldAmalgam.Universal (puAmalgam h.le)

theorem vv_adj_le_vv {x ρ : Vtx (puAmalgam h.le)} (hx : IsMVtx _ x)
    (hxρ : (puAmalgam h.le).treeGraph.Adj x ρ) : Vv (puAmalgam h.le) ρ ≤ Vv _ x := by
  rw [vv_eq_iSup_vv hx]
  exact le_iSup₂_of_le (f := fun ρ (_ : ρ ∈ (puAmalgam h.le).treeGraph.neighborSet x) =>
    Vv (puAmalgam h.le) ρ) ρ hxρ le_rfl

theorem vv_le_centralizer_vv (hb4 : critDist (puAmalgam h.le) = 4) {β : Vtx (puAmalgam h.le)}
    (hβ : ¬ IsMVtx (puAmalgam h.le) β) :
    Vv (puAmalgam h.le) β ≤ Subgroup.centralizer (Vv (puAmalgam h.le) β : Set 𝔘) := by
  have h20 := h.hyp20
  conv_lhs => rw [vv_eq_iSup_of_not_isMVtx hβ]
  refine iSup₂_le fun μ hμ => ?_
  have hμM : IsMVtx 𝔛 μ := by
    have := isMVtx_iff_of_adj _ (show (puAmalgam h.le).treeGraph.Adj β μ from hμ)
    tauto
  have hVQ : Vv 𝔛 β ≤ Qv _ μ := vv_le_qv_of_dist_le_two hb4 hβ
    (by rw [dist_eq_one_of_adj _ (show (puAmalgam h.le).treeGraph.Adj β μ from hμ)]; omega)
  exact (zm_le_centralizer_qv _ h20 hμM).trans (Subgroup.centralizer_le hVQ)

theorem commutator_vv_qv_le_zh
    (h464 : ∀ δ ρ : Vtx (puAmalgam h.le), IsMVtx _ δ → (puAmalgam h.le).treeGraph.Adj δ ρ →
      Usup (puAmalgam h.le) δ ρ ≤ ZH _ ρ)
    {β : Vtx (puAmalgam h.le)} (hβ : ¬ IsMVtx (puAmalgam h.le) β) :
    ⁅Vv (puAmalgam h.le) β, Qv _ β⁆ ≤ ZH _ β := by
  have h20 := h.hyp20
  have hb0 := h.critDist_pos
  rw [vv_eq_iSup_of_not_isMVtx hβ]
  refine commutator_biSup_le_of (fun μ hμ => ?_) fun μ hμ => ?_
  · have hμM : IsMVtx 𝔛 μ := by
      have := isMVtx_iff_of_adj _ (show (puAmalgam h.le).treeGraph.Adj β μ from hμ)
      tauto
    have := h464 μ β hμM (show (puAmalgam h.le).treeGraph.Adj β μ from hμ).symm
    rwa [Usup, zv_of_isMVtx _ hμM] at this
  · have hμM : IsMVtx 𝔛 μ := by
      have := isMVtx_iff_of_adj _ (show (puAmalgam h.le).treeGraph.Adj β μ from hμ)
      tauto
    exact ((zm_le_qv_self _ hμM hb0).trans ((qv_le_qv _ h20 hμM
      (show (puAmalgam h.le).treeGraph.Adj β μ from hμ).symm).trans (qv_le_stab _ β))).trans
      (stab_le_normalizer_zh _ β)

end Hvtx

section Main

variable {G : Type} [Group G] [Finite G] {M T L : Subgroup G} (h : PUHyp M T L)
  {F : Type} [Field F] [Fintype F] {φ : ↥M →* ↥(StatedSL 3 F)} (hφ : IsSL3FullVia M T L φ)
  (h464 : ∀ δ ρ : Vtx (puAmalgam h.le), IsMVtx _ δ → (puAmalgam h.le).treeGraph.Adj δ ρ →
    Usup (puAmalgam h.le) δ ρ ≤ ZH _ ρ)
  (hsq : ∀ δ ρ : Vtx (puAmalgam h.le), IsMVtx _ δ → (puAmalgam h.le).treeGraph.Adj δ ρ →
    Nat.card ↥(Usup (puAmalgam h.le) δ ρ) = Fintype.card F ^ 2)
  (h466 : ∀ δ ρ : Vtx (puAmalgam h.le), IsMVtx _ δ → (puAmalgam h.le).treeGraph.Adj δ ρ →
    (Qv (puAmalgam h.le) δ).relIndex (Qv _ ρ) = Fintype.card F ^ 2)
  (h465 : ∀ x : Vtx (puAmalgam h.le), IsMVtx _ x →
    ⁅Vv (puAmalgam h.le) x, Qv _ x⁆ ≤ ZM _ x)
include h hφ

local notation "𝔛" => puAmalgam h.le
local notation "𝔘" => GoldAmalgam.Universal (puAmalgam h.le)

include h464 hsq h466 h465 in
theorem bloc_le_vv_of_isC1 (hb4 : critDist (puAmalgam h.le) = 4) {δ β : Vtx (puAmalgam h.le)}
    (hδ : IsMVtx _ δ) (hδβ : (puAmalgam h.le).treeGraph.Adj δ β) {Bo : Subgroup 𝔘}
    (hBT : Bo ≤ Qv 𝔛 β) (hBQ : ¬ Bo ≤ Qv 𝔛 δ) (hBV : ⁅Vv 𝔛 δ, Bo⁆ ≤ Vv 𝔛 β)
    (hC1 : IsC1 h.le L (Fintype.card F) δ (Vv 𝔛 δ) (ZM 𝔛 δ)) :
    Bloc h.le L δ ≤ Vv 𝔛 β := by
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have : CharP F 2 := charP_two_of_isSL3FullVia hφ
  have h20 := h.hyp20
  have hb : 2 < critDist 𝔛 := by omega
  have hb0 : 0 < critDist 𝔛 := by omega
  have hβH : ¬ IsMVtx 𝔛 β := (isMVtx_iff_of_adj _ hδβ).mp hδ
  have hKZ : ⁅Vv 𝔛 δ, Qv 𝔛 δ⁆ ⊔ ZM 𝔛 δ = ZM 𝔛 δ := sup_eq_right.mpr (h465 δ hδ)
  obtain ⟨-, C, hKC, hCV, hCfix, hsupC, -, F', iF', fF', ψ', hFF', hψ's, hnat⟩ := hC1
  rw [hKZ] at hKC hCfix hnat
  set N := ⁅Vv 𝔛 δ, stab 𝔛 δ⁆ ⊔ ZM 𝔛 δ with hNdef
  have hVs : Vv 𝔛 δ ≤ stab _ δ := (vv_le_qv h hb hδ).trans (qv_le_stab _ δ)
  have hZV := zm_le_vv h hδ
  have hNV : N ≤ Vv 𝔛 δ :=
    sup_le (Subgroup.le_normalizer_iff_commutator_le_left.mp (stab_le_normalizer_vv h δ)) hZV
  have hNn : stab 𝔛 δ ≤ Subgroup.normalizer (N : Set 𝔘) := hnat.1
  have hCn : stab 𝔛 δ ≤ Subgroup.normalizer (C : Set 𝔘) :=
    Subgroup.le_normalizer_iff_commutator_le_left.mpr (hCfix.trans hKC)
  have hCB : C ≤ Bloc h.le L δ := fun c hc => (mem_bloc_iff h hb hδ).mpr ⟨hCV hc,
    fun l hl => hCfix (Subgroup.commutator_mem_commutator hc (ltil_le_stab h δ hl))⟩
  have hZβ : ZM 𝔛 δ ≤ Vv 𝔛 β := zm_le_vv_of_adj hδβ.symm hδ
  have hTs : Qv 𝔛 β ≤ stab _ δ := qv_le_stab_of_adj _ hδβ.symm
  have hQβ : Qv 𝔛 δ ≤ Qv _ β := qv_le_qv _ h20 hδ hδβ
  have hQ' : ∀ q : ↥(stab 𝔛 δ), (q : 𝔘) ∈ Qv 𝔛 δ → toSL3 ψ' q = 1 := fun q hq =>
    toSL3_eq_one_of_commutator_mem hnat fun v =>
      h465 δ hδ (Subgroup.commutator_mem_commutator (hNV v.2) hq)
  have hBN : ∀ n ∈ N, n ∈ Bloc h.le L δ → n ∈ ZM 𝔛 δ := by
    intro n hn hnB
    have hnB' := ((mem_bloc_iff h hb hδ).mp hnB).2
    refine mem_of_forall_commutator_mem hnat ⟨n, hn⟩ fun γ => ?_
    obtain ⟨a, ha⟩ := toSL3_surjective hψ's γ
    have ha' : (a : 𝔘) ∈ ((Ltil h.le L δ ⊔ Qv 𝔛 δ : Subgroup 𝔘) : Set 𝔘) := by
      rw [← stab_eq_ltil_sup_qv h hfull hδ]
      exact a.2
    rw [Subgroup.coe_mul_of_left_le_normalizer_right _ _
      ((ltil_le_stab h δ).trans (stab_le_normalizer_qv _ δ))] at ha'
    obtain ⟨l, hl, q, hq, hlq⟩ := ha'
    have hls : l ∈ stab 𝔛 δ := ltil_le_stab h δ hl
    have hqs : q ∈ stab 𝔛 δ := qv_le_stab _ δ hq
    refine ⟨⟨l, hls⟩, ?_, hnB' l hl⟩
    have e : a = ⟨l, hls⟩ * ⟨q, hqs⟩ := Subtype.ext hlq.symm
    rw [e, map_mul, hQ' ⟨q, hqs⟩ hq, mul_one] at ha
    exact ha
  obtain ⟨ψ₀, hψ₀s, hψ₀⟩ := exists_natural_Uloc h hφ hδ
  set Q := (Qv 𝔛 δ).subgroupOf (stab 𝔛 δ) with hQdef
  have hQ₀ : (toSL3 ψ₀).ker = Q := by
    ext g
    rw [MonoidHom.mem_ker, hQdef, Subgroup.mem_subgroupOf]
    exact toSL3_eq_one_iff_mem_qv h hφ hδ hψ₀ g
  have : Finite ↥(stab 𝔛 δ) := finite_stab h hδ
  have hker : (toSL3 ψ').ker = Q := by
    have hle : Q ≤ (toSL3 ψ').ker := fun q hq => hQ' q (Subgroup.mem_subgroupOf.mp hq)
    have h1 := Subgroup.card_ker_mul_card_range (toSL3 ψ₀)
    have h2 := Subgroup.card_ker_mul_card_range (toSL3 ψ')
    rw [MonoidHom.range_eq_top.mpr (toSL3_surjective hψ₀s), Subgroup.card_top, hQ₀,
      card_SL3] at h1
    rw [MonoidHom.range_eq_top.mpr (toSL3_surjective hψ's), Subgroup.card_top, card_SL3,
      Nat.card_eq_fintype_card (α := F'), hFF', ← Nat.card_eq_fintype_card] at h2
    have hpos : 0 < Nat.card F ^ 3 * ((Nat.card F ^ 3 - 1) * (Nat.card F ^ 2 - 1)) := by
      have hq : 2 ≤ Nat.card F := Finite.one_lt_card
      have h3 : 1 < Nat.card F ^ 3 := Nat.one_lt_pow (by norm_num) hq
      have h4 : 1 < Nat.card F ^ 2 := Nat.one_lt_pow (by norm_num) hq
      exact Nat.mul_pos (by omega) (Nat.mul_pos (by omega) (by omega))
    have hc : Nat.card ↥Q = Nat.card ↥(toSL3 ψ').ker :=
      Nat.eq_of_mul_eq_mul_right hpos (h1.trans h2.symm)
    exact (Subgroup.eq_of_le_of_card_ge hle hc.ge).symm
  have hax := natImage_qv_eq_axisGroup h hφ h464 hsq h466 hδ hδβ hψ₀
  have hT1 : ∀ t : ↥(stab 𝔛 δ), (t : 𝔘) ∈ Qv 𝔛 β → toSL3 ψ₀ t ∈
      axisGroup (fixN (natImage ψ₀ (Qv 𝔛 β))) := fun t ht => by
    rw [← hax]
    exact mem_natImage.mpr ⟨t, ht, rfl⟩
  have hker' : ∀ g : ↥(stab 𝔛 δ), toSL3 ψ₀ g = 1 → toSL3 ψ' g = 1 := fun g hg => by
