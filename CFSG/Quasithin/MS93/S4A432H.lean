section Grp

variable {Γ : Type*} [Group Γ]

theorem commutator_sup_left_le {H₁ H₂ A N : Subgroup Γ}
    (hN₁ : H₁ ≤ Subgroup.normalizer (N : Set Γ)) (hN₂ : H₂ ≤ Subgroup.normalizer (N : Set Γ))
    (h₁ : ⁅H₁, A⁆ ≤ N) (h₂ : ⁅H₂, A⁆ ≤ N) : ⁅H₁ ⊔ H₂, A⁆ ≤ N := by
  let S : Subgroup Γ :=
    { carrier := {y | y ∈ Subgroup.normalizer (N : Set Γ) ∧ ∀ x ∈ A, ⁅y, x⁆ ∈ N}
      one_mem' := ⟨one_mem _, fun x _ => by simp⟩
      mul_mem' := by
        rintro y₁ y₂ ⟨hy₁, k₁⟩ ⟨hy₂, k₂⟩
        refine ⟨mul_mem hy₁ hy₂, fun x hx => ?_⟩
        have e : ⁅y₁ * y₂, x⁆ = y₁ * ⁅y₂, x⁆ * y₁⁻¹ * ⁅y₁, x⁆ := by
          simp only [commutatorElement_def]; group
        rw [e]
        exact mul_mem ((Subgroup.mem_normalizer_iff.mp hy₁ _).mp (k₂ x hx)) (k₁ x hx)
      inv_mem' := by
        rintro y ⟨hy, k⟩
        refine ⟨inv_mem hy, fun x hx => ?_⟩
        have e : ⁅y⁻¹, x⁆ = y⁻¹ * ⁅y, x⁆⁻¹ * y := by
          simp only [commutatorElement_def]; group
        rw [e]
        have hy' : y⁻¹ ∈ Subgroup.normalizer (N : Set Γ) := inv_mem hy
        have := (Subgroup.mem_normalizer_iff.mp hy' _).mp (inv_mem (k x hx))
        simpa [mul_assoc] using this }
  have hS : H₁ ⊔ H₂ ≤ S := by
    refine sup_le (fun y hy => ⟨hN₁ hy, fun x hx => ?_⟩) (fun y hy => ⟨hN₂ hy, fun x hx => ?_⟩)
    · exact h₁ (Subgroup.commutator_mem_commutator hy hx)
    · exact h₂ (Subgroup.commutator_mem_commutator hy hx)
  rw [Subgroup.commutator_le]
  intro y hy x hx
  exact (hS hy).2 x hx

theorem commutator_sup_right_le {H₁ H₂ A N : Subgroup Γ}
    (hN₁ : H₁ ≤ Subgroup.normalizer (N : Set Γ)) (hN₂ : H₂ ≤ Subgroup.normalizer (N : Set Γ))
    (h₁ : ⁅A, H₁⁆ ≤ N) (h₂ : ⁅A, H₂⁆ ≤ N) : ⁅A, H₁ ⊔ H₂⁆ ≤ N := by
  rw [Subgroup.commutator_comm] at h₁ h₂ ⊢
  exact commutator_sup_left_le hN₁ hN₂ h₁ h₂

end Grp

section Coord

variable {𝔾 : Type} [Group 𝔾] {K V Z : Subgroup 𝔾} {F : Type} [Field F]

theorem isSumOfNaturalModulesVia_of_natAct_eq {φ φ' : ↥K →* ↥(StatedSL 3 F)} {d d' : Bool}
    (hφ : ∀ a, natAct d' (toSL3 φ' a) = natAct d (toSL3 φ a))
    (h : IsSumOfNaturalModulesVia K V Z φ d 1) : IsSumOfNaturalModulesVia K V Z φ' d' 1 := by
  obtain ⟨hKV, hZV, β, hβs, hβk, hβc⟩ := h
  refine ⟨hKV, hZV, β, hβs, hβk, fun a u v huv i => ?_⟩
  rw [moduleAct_eq_natAct, hφ a, ← moduleAct_eq_natAct]
  exact hβc a u v huv i

@[expose] noncomputable def dualSL (φ : ↥K →* ↥(StatedSL 3 F)) : ↥K →* ↥(StatedSL 3 F) :=
  (specialLinearGroupEquivStatedSL 3 F).toMonoidHom.comp (transposeInv.comp (toSL3 φ))

theorem toSL3_dualSL (φ : ↥K →* ↥(StatedSL 3 F)) (a : ↥K) :
    toSL3 (dualSL φ) a = transposeInv (toSL3 φ a) := by
  simp [toSL3, dualSL]

theorem dualSL_surjective {φ : ↥K →* ↥(StatedSL 3 F)} (hφ : Function.Surjective φ) :
    Function.Surjective (dualSL φ) := by
  intro y
  obtain ⟨a, ha⟩ := toSL3_surjective hφ
    (transposeInv ((specialLinearGroupEquivStatedSL 3 F).symm y))
  refine ⟨a, ?_⟩
  apply (specialLinearGroupEquivStatedSL 3 F).symm.injective
  have := toSL3_dualSL φ a
  rw [ha, transposeInv_transposeInv] at this
  exact this

theorem isSumOfNaturalModulesVia_dualSL {φ : ↥K →* ↥(StatedSL 3 F)} {d : Bool}
    (h : IsSumOfNaturalModulesVia K V Z φ d 1) :
    IsSumOfNaturalModulesVia K V Z (dualSL φ) (!d) 1 := by
  refine isSumOfNaturalModulesVia_of_natAct_eq (fun a => ?_) h
  rw [toSL3_dualSL]
  cases d
  · rw [Bool.not_false, natAct_true, natAct_false, ← coe_transposeInv, transposeInv_transposeInv]
  · rw [Bool.not_true, natAct_true, natAct_false, coe_transposeInv]

theorem isSumOfNaturalModulesVia_conjSL_true {φ : ↥K →* ↥(StatedSL 3 F)}
    (h : IsSumOfNaturalModulesVia K V Z φ true 1) (s : SL3 F) :
    IsSumOfNaturalModulesVia K V Z (conjSL s φ) true 1 := by
  have h1 := isSumOfNaturalModulesVia_conjSL (isSumOfNaturalModulesVia_dualSL h) (transposeInv s)
  refine isSumOfNaturalModulesVia_of_natAct_eq (fun a => ?_) h1
  rw [natAct_true, natAct_false, toSL3_conjSL, toSL3_conjSL, toSL3_dualSL, ← coe_transposeInv,
    map_mul, map_mul, map_inv]

theorem natImage_conjSL' (s : SL3 F) (φ : ↥K →* ↥(StatedSL 3 F)) (A : Subgroup 𝔾) :
    natImage (conjSL s φ) A = (natImage φ A).map (MulAut.conj s).toMonoidHom := by
  rw [natImage, natImage, Subgroup.map_map]
  refine congrArg (Subgroup.map · _) (MonoidHom.ext fun a => ?_)
  rw [toSL3_conjSL]
  rfl

theorem exists_map_plane_eq {P H : Submodule F (Fin 3 → F)} (hP : Module.finrank F P = 2)
    (hH : Module.finrank F H = 2) :
    ∃ s : SL3 F, P.map (Matrix.SpecialLinearGroup.toLin' s : (Fin 3 → F) →ₗ[F] (Fin 3 → F)) =
      H := by
  obtain ⟨g₁, hg₁⟩ := CFSG.LocalAnalysis.ComponentInitial.LinearFlag.exists_map_flagSpace_eq P
  obtain ⟨g₂, hg₂⟩ := CFSG.LocalAnalysis.ComponentInitial.LinearFlag.exists_map_flagSpace_eq H
  rw [hP] at hg₁
  rw [hH] at hg₂
  refine ⟨g₂ * g₁⁻¹, ?_⟩
  have hlin : ∀ g : SL3 F, ((Matrix.SpecialLinearGroup.toLin' g : (Fin 3 → F) ≃ₗ[F] (Fin 3 → F)) :
      (Fin 3 → F) →ₗ[F] (Fin 3 → F)) =
        Matrix.mulVecLin ((g : SL3 F) : Matrix (Fin 3) (Fin 3) F) := by
    intro g
    ext x
    simp [Matrix.SpecialLinearGroup.toLin'_apply, Matrix.toLin'_apply]
  rw [hlin, ← hg₁, ← hg₂, ← Submodule.map_comp, ← Matrix.mulVecLin_mul, ← coe_mul_SL3,
    inv_mul_cancel_right]

end Coord

section Pv

universe u v

variable {A B : Type u} {C : Type v} [Group A] [Group C] [Group B] (X : GoldAmalgam A C B)

@[expose] def Pv (μ : Vtx X) : Subgroup X.Universal := ⁅Vv X μ, stab X μ⁆ ⊔ ZM X μ

theorem pv_smul (g : X.Universal) (μ : Vtx X) :
    Pv X (g • μ) = (Pv X μ).map (MulAut.conj g).toMonoidHom := by
  have hV : Vv X (g • μ) = (Vv X μ).map (MulAut.conj g).toMonoidHom := vi_smul X g μ 2
  rw [Pv, Pv, Subgroup.map_sup, Subgroup.map_commutator, ← stab_smul, ← zm_smul, hV]

theorem zm_le_pv (μ : Vtx X) : ZM X μ ≤ Pv X μ := le_sup_right

theorem stab_le_normalizer_pv (μ : Vtx X) :
    stab X μ ≤ Subgroup.normalizer (Pv X μ : Set X.Universal) :=
  stab_le_normalizer_of_smul X (pv_smul X) μ

end Pv

section PvPU

variable {G : Type} [Group G] [Finite G] {M T L : Subgroup G} (h : PUHyp M T L)
include h

theorem pv_le_vv {μ : Vtx (puAmalgam h.le)} (hμ : IsMVtx _ μ) :
    Pv (puAmalgam h.le) μ ≤ Vv (puAmalgam h.le) μ :=
  sup_le (Subgroup.le_normalizer_iff_commutator_le_left.mp (stab_le_normalizer_vv h μ))
    (zm_le_vv h hμ)

theorem vcirc_le_pv (μ : Vtx (puAmalgam h.le)) : Vcirc h.le L μ ≤ Pv (puAmalgam h.le) μ :=
  (Subgroup.commutator_mono le_rfl (ltil_le_stab h μ)).trans le_sup_left

end PvPU

structure Ctx {G : Type} [Group G] [Finite G] {M T L : Subgroup G} (h : PUHyp M T L)
    {F : Type} [Field F] [Fintype F] (φ : ↥M →* ↥(StatedSL 3 F))
    (α₀ α₀' : Vtx (puAmalgam h.le)) : Prop where
  full : IsSL3Full M T L
  hyp : Hyp40 h φ
  cent : CentHyp (puAmalgam h.le)
  s42 : S42
  s431A : S431A
  s431B : S431B
  b4 : 4 < critDist (puAmalgam h.le)
  star : Star (puAmalgam h.le) α₀ α₀'
  kind : ∀ μ : Vtx (puAmalgam h.le), IsMVtx _ μ → KindAt h.le L F true μ
  ch : ∀ μ : Vtx (puAmalgam h.le), IsMVtx _ μ →
    ¬ ⁅Vv (puAmalgam h.le) μ, Qv (puAmalgam h.le) μ⁆ ≤ Dloc h.le L μ

namespace Ctx

variable {G : Type} [Group G] [Finite G] {M T L : Subgroup G} {h : PUHyp M T L}
  {F : Type} [Field F] [Fintype F] {φ : ↥M →* ↥(StatedSL 3 F)}
  {α₀ α₀' : Vtx (puAmalgam h.le)} (c : Ctx h φ α₀ α₀')
include c

local notation "𝔛" => puAmalgam h.le
local notation "𝔘" => GoldAmalgam.Universal (puAmalgam h.le)
local notation "𝔄" => SimpleGraph.Adj (GoldAmalgam.treeGraph (puAmalgam h.le))

theorem b2 : 2 < critDist 𝔛 := by have := c.b4; omega

theorem commutator_vv_qv {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) : ⁅Vv 𝔛 μ, Qv 𝔛 μ⁆ ≤ ZM 𝔛 μ :=
  commutator_vv_qv_le_zm_of_star h c.full c.hyp c.cent c.s42 c.s431A c.s431B c.star hμ

theorem edge {μ ν : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) (hμν : 𝔄 μ ν) :
    Usup 𝔛 μ ν ≤ ZH 𝔛 ν ∧ Nat.card ↥(Usup 𝔛 μ ν) = Fintype.card F ^ 2 ∧
      (ZH 𝔛 ν).relIndex (ZM 𝔛 μ) = Fintype.card F ∧
      (Qv 𝔛 μ).relIndex (Qv 𝔛 ν) = Fintype.card F ^ 2 :=
  concl433_edge h c.full c.s42 c.s431A c.s431B c.hyp c.cent c.star hμ hμν

theorem three {μ ν δ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) (hμν : 𝔄 μ ν) (hνδ : 𝔄 ν δ)
    (hδ : δ ∈ nablaSet h.le L μ) :
    ⁅ZM 𝔛 δ, Qv 𝔛 μ⁆ = Usup 𝔛 μ ν ∧ Usup 𝔛 δ ν = Usup 𝔛 μ ν :=
  commutator_zm_qv_eq_usup_of_dual h c.full c.hyp c.cent c.s42 c.s431A c.s431B c.b4 c.star
    c.kind c.ch hμ hμν hνδ hδ

theorem nabla_symm {μ ν δ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) (hμν : 𝔄 μ ν) (hνδ : 𝔄 ν δ)
    (hδ : δ ∈ nablaSet h.le L μ) : μ ∈ nablaSet h.le L δ :=
  mem_nablaSet_of_dual h c.full c.hyp c.cent c.s42 c.s431A c.s431B c.b4 c.star c.kind c.ch hμ
    hμν hνδ hδ

theorem hloc {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) : Hloc h.le L μ = Uloc h.le L μ :=
  hloc_eq_uloc_of_dual h c.full c.hyp c.cent c.s42 c.s431A c.s431B c.b4 c.star c.kind c.ch hμ

theorem uloc_inf_bloc {μ ν δ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) (hμν : 𝔄 μ ν) (hνδ : 𝔄 ν δ)
    (hδ : δ ∈ nablaSet h.le L μ) : Uloc h.le L δ ⊓ Bloc h.le L μ = Usup 𝔛 μ ν :=
  uloc_inf_bloc_eq_usup_of_dual h c.full c.hyp c.cent c.s42 c.s431A c.s431B c.b4 c.star c.kind
    c.ch hμ hμν hνδ hδ

theorem usup_le_uloc {μ ν : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) (hμν : 𝔄 μ ν) :
    Usup 𝔛 μ ν ≤ Uloc h.le L μ := by
  rw [usup_eq_commutator_uloc h c.full hμ hμν]
  exact Subgroup.le_normalizer_iff_commutator_le_left.mp
    ((qv_le_stab_of_adj _ hμν.symm).trans (stab_le_normalizer_puTrans h.le (S4A.Uq_normal h) μ))

theorem decomp {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) :
    Pv 𝔛 μ ⊓ Bloc h.le L μ = ZM 𝔛 μ ∧ Pv 𝔛 μ ⊔ Bloc h.le L μ = Vv 𝔛 μ ∧
      ⁅Bloc h.le L μ, stab 𝔛 μ⁆ ≤ ZM 𝔛 μ := by
  obtain ⟨-, -, -, -, -, -, -, hPiB, hPB, hBG, -⟩ :=
    isC1_normal h c.full c.b2 hμ (isC1_of_star h c.hyp c.s431A c.star hμ)
  have e : ⁅Vv 𝔛 μ, Qv 𝔛 μ⁆ ⊔ ZM 𝔛 μ = ZM 𝔛 μ := sup_eq_right.mpr (c.commutator_vv_qv hμ)
  rw [e] at hPiB hBG
  exact ⟨hPiB, hPB, hBG⟩

theorem exists_dual {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) :
    ∃ ψ : ↥(stab 𝔛 μ) →* ↥(StatedSL 3 F), Function.Surjective ψ ∧
      IsSumOfNaturalModulesVia (stab 𝔛 μ) (Uloc h.le L μ) ⊥ ψ false 1 ∧
      IsSumOfNaturalModulesVia (stab 𝔛 μ) (Pv 𝔛 μ) (ZM 𝔛 μ) ψ true 1 := by
  obtain ⟨ψ, hs, hU, hP⟩ := c.kind μ hμ
  have e : ⁅Vv 𝔛 μ, Qv 𝔛 μ⁆ ⊔ ZM 𝔛 μ = ZM 𝔛 μ := sup_eq_right.mpr (c.commutator_vv_qv hμ)
  rw [e] at hP
  exact ⟨ψ, hs, hU, hP⟩

theorem pv_le_vcirc_sup {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) :
    Pv 𝔛 μ ≤ Vcirc h.le L μ ⊔ ZM 𝔛 μ := by
  have hVn := stab_le_normalizer_vv h μ
  have hVcn : stab 𝔛 μ ≤ Subgroup.normalizer (Vcirc h.le L μ : Set 𝔘) :=
    le_normalizer_commutator hVn (stab_le_normalizer_ltil h μ)
  have hNn : stab 𝔛 μ ≤ Subgroup.normalizer ((Vcirc h.le L μ ⊔ ZM 𝔛 μ : Subgroup 𝔘) : Set 𝔘) :=
    (le_inf hVcn (stab_le_normalizer_zm _ μ)).trans
      (Subgroup.inf_normalizer_le_normalizer_sup _ _)
  refine sup_le ?_ le_sup_right
  rw [stab_eq_ltil_sup_qv h c.full hμ]
  refine commutator_sup_right_le ((ltil_le_stab h μ).trans hNn) ((qv_le_stab _ μ).trans hNn)
    ?_ ?_
  · rw [← Vcirc]; exact le_sup_left
  · exact (c.commutator_vv_qv hμ).trans le_sup_right

theorem commutator_pv_qv {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) :
    ⁅Pv 𝔛 μ, Qv 𝔛 μ⁆ ≤ Uloc h.le L μ := by
  have hUn : stab 𝔛 μ ≤ Subgroup.normalizer (Uloc h.le L μ : Set 𝔘) :=
    stab_le_normalizer_puTrans h.le (S4A.Uq_normal h) μ
  have hVcs : Vcirc h.le L μ ≤ stab 𝔛 μ :=
    (vcirc_le_pv h μ).trans ((pv_le_vv h hμ).trans ((vv_le_qv h c.b2 hμ).trans (qv_le_stab _ μ)))
  have hZs : ZM 𝔛 μ ≤ stab 𝔛 μ := (zm_le_qv_self _ hμ h.critDist_pos).trans (qv_le_stab _ μ)
  refine (Subgroup.commutator_mono (c.pv_le_vcirc_sup hμ) le_rfl).trans ?_
  refine commutator_sup_left_le (hVcs.trans hUn) (hZs.trans hUn) ?_ ?_
  · rw [← Hloc, c.hloc hμ]
  · rw [(Subgroup.commutator_eq_bot_iff_le_centralizer).mpr (zm_le_centralizer_qv _ h.hyp20 hμ)]
    exact bot_le

theorem uloc_ne_bot {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) : Uloc h.le L μ ≠ ⊥ := by
  intro hbot
  obtain ⟨ψ, -, hψ⟩ := exists_natural_Uloc h c.hyp.2.2 hμ
  have hc := card_eq_of_natural hψ
  rw [hbot, Subgroup.card_bot] at hc
  have hq : 2 ≤ Nat.card F := Finite.one_lt_card
  have : 1 < Nat.card F ^ 3 := Nat.one_lt_pow (by norm_num) (by omega)
  omega

theorem pv_inf_centralizer {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) :
    Pv 𝔛 μ ⊓ Subgroup.centralizer (Qv 𝔛 μ : Set 𝔘) = ZM 𝔛 μ := by
  refine le_antisymm ?_ (le_inf (zm_le_pv _ μ) (zm_le_centralizer_qv _ h.hyp20 hμ))
  obtain ⟨ψ, hs, -, hP⟩ := c.exists_dual hμ
  set N := NatSec.ofIsSum hP
  set Y := Pv 𝔛 μ ⊓ Subgroup.centralizer (Qv 𝔛 μ : Set 𝔘) with hY
  have key : ∀ g ∈ stab 𝔛 μ, ∀ y ∈ Y, g * y * g⁻¹ ∈ Y := by
    rintro g hg y ⟨hyP, hyC⟩
    refine ⟨(Subgroup.mem_normalizer_iff.mp (stab_le_normalizer_pv _ μ hg) y).mp hyP, ?_⟩
    show g * y * g⁻¹ ∈ Subgroup.centralizer (Qv 𝔛 μ : Set 𝔘)
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    have hx' : g⁻¹ * x * g⁻¹⁻¹ ∈ Qv 𝔛 μ :=
      (Subgroup.mem_normalizer_iff.mp (stab_le_normalizer_qv _ μ (inv_mem hg)) x).mp hx
    have hxy := Subgroup.mem_centralizer_iff.mp hyC _ hx'
    calc x * (g * y * g⁻¹) = g * ((g⁻¹ * x * g⁻¹⁻¹) * y) * g⁻¹ := by group
      _ = g * (y * (g⁻¹ * x * g⁻¹⁻¹)) * g⁻¹ := by rw [hxy]
      _ = g * y * g⁻¹ * x := by group
  by_contra hYZ
  obtain ⟨y, hyY, hyZ⟩ := Set.not_subset.mp hYZ
  have hall : Pv 𝔛 μ ≤ Subgroup.centralizer (Qv 𝔛 μ : Set 𝔘) := by
    intro v hv
    obtain ⟨w, hwY, -, hwv⟩ := N.exists_inv_mul_mem_of_invariant hs
      (fun l x hx => key l l.2 x hx) hyY hyY.1 hyZ hv
    have : v = w * (w⁻¹ * v) := by group
    rw [this]
    exact Subgroup.mul_mem _ hwY.2 (zm_le_centralizer_qv _ h.hyp20 hμ hwv)
  have hbot : ⁅Pv 𝔛 μ, Qv 𝔛 μ⁆ = ⊥ := (Subgroup.commutator_eq_bot_iff_le_centralizer).mpr hall
  have h1 : Hloc h.le L μ = ⊥ := by
    rw [Hloc, eq_bot_iff, ← hbot]
    exact Subgroup.commutator_mono (vcirc_le_pv h μ) le_rfl
  exact c.uloc_ne_bot hμ (by rw [← c.hloc hμ, h1])

end Ctx

