universe u v

variable {A B : Type u} {C : Type v} [Group A] [Group C] [Group B] (X : GoldAmalgam A C B)

theorem mem_stabCenter_iff_comm {δ : Vtx X} {x : X.Universal} :
    x ∈ stabCenter X δ ↔ x ∈ stab X δ ∧ ∀ g ∈ stab X δ, g * x = x * g := by
  constructor
  · rintro ⟨y, hy, rfl⟩
    refine ⟨y.2, fun g hg => ?_⟩
    have := Subgroup.mem_center_iff.mp hy ⟨g, hg⟩
    exact congrArg Subtype.val this
  · rintro ⟨hx, hc⟩
    refine ⟨⟨x, hx⟩, Subgroup.mem_center_iff.mpr fun g => Subtype.ext (hc g g.2), rfl⟩

@[expose] def subCommHom {G : Type*} [Group G] (Q H : Subgroup G) (x : G)
    (hval : ∀ s ∈ Q, ⁅x, s⁆ ∈ H) (hcomm : H ≤ Subgroup.centralizer (Q : Set G)) : ↥Q →* G where
  toFun s := ⁅x, (s : G)⁆
  map_one' := by simp
  map_mul' a b := by
    have key : (a : G) * ⁅x, (b : G)⁆ = ⁅x, (b : G)⁆ * a :=
      Subgroup.mem_centralizer_iff.mp (hcomm (hval b b.2)) a a.2
    calc ⁅x, ((a * b : ↥Q) : G)⁆ = ⁅x, (a : G)⁆ * ((a : G) * ⁅x, (b : G)⁆ * (a : G)⁻¹) := by
          simp only [Subgroup.coe_mul, commutatorElement_def]
          group
      _ = ⁅x, (a : G)⁆ * ⁅x, (b : G)⁆ := by rw [key, mul_inv_cancel_right]

theorem subCommHom_apply {G : Type*} [Group G] {Q H : Subgroup G} {x : G}
    (hval : ∀ s ∈ Q, ⁅x, s⁆ ∈ H) (hcomm : H ≤ Subgroup.centralizer (Q : Set G)) (s : ↥Q) :
    subCommHom Q H x hval hcomm s = ⁅x, (s : G)⁆ := rfl

theorem commutatorElement_mul_left_eq {G : Type*} [Group G] (a b c : G) :
    ⁅a * b, c⁆ = a * ⁅b, c⁆ * a⁻¹ * ⁅a, c⁆ := by
  simp only [commutatorElement_def]
  group

theorem le_normalizer_sup_of_comm_le {G : Type*} [Group G] {Z Y W : Subgroup G}
    (hW : Z ≤ Subgroup.normalizer (W : Set G)) (hY : ⁅Y, Z⁆ ≤ Y ⊔ W) :
    Z ≤ Subgroup.normalizer ((Y ⊔ W : Subgroup G) : Set G) := by
  refine le_normalizer_of_map_conj_le fun z hz => ?_
  rw [Subgroup.map_sup, map_conj_eq_of_mem_normalizer (hW hz)]
  refine sup_le ?_ le_sup_right
  rintro _ ⟨y, hy, rfl⟩
  have e : (MulAut.conj z).toMonoidHom y = ⁅z, y⁆ * y := by
    simp [commutatorElement_def]
  rw [e]
  refine Subgroup.mul_mem _ (hY ?_) (Subgroup.mem_sup_left hy)
  rw [Subgroup.commutator_comm]
  exact Subgroup.commutator_mem_commutator hz hy

end General

section Ctx

variable {G : Type} [Group G] [Finite G] {M T L : Subgroup G} (h : PUHyp M T L)
  {F : Type} [Field F] [Fintype F] (φ : ↥M →* ↥(StatedSL 3 F))

structure Ctx43 : Prop where
  hyp : Hyp40 h φ
  cent : CentHyp (puAmalgam h.le)
  ex : ∃ α α' : Vtx (puAmalgam h.le), Star (puAmalgam h.le) α α'
  c431A : ∀ α α' : Vtx (puAmalgam h.le), Star (puAmalgam h.le) α α' →
    Concl431A h.le L (Fintype.card F) α α'
  c431B : ∀ α α' : Vtx (puAmalgam h.le), Star (puAmalgam h.le) α α' →
    Concl431B h.le L (Fintype.card F) α α'
  c432 : ∀ α α' : Vtx (puAmalgam h.le), Star (puAmalgam h.le) α α' → Concl432 h.le L α
  edge : ∀ α β : Vtx (puAmalgam h.le), IsMVtx _ α → (puAmalgam h.le).treeGraph.Adj α β →
    Usup (puAmalgam h.le) α β ≤ ZH (puAmalgam h.le) β ∧
      Nat.card ↥(Usup (puAmalgam h.le) α β) = Fintype.card F ^ 2 ∧
      (ZH (puAmalgam h.le) β).relIndex (ZM (puAmalgam h.le) α) = Fintype.card F ∧
      (Qv (puAmalgam h.le) α).relIndex (Qv (puAmalgam h.le) β) = Fintype.card F ^ 2

theorem ctx43_of (h32 : S32) (h431A : S431A) (h431B : S431B) (h432 : S432) (hH : Hyp40 h φ)
    {α α' : Vtx (puAmalgam h.le)} (hs : Star (puAmalgam h.le) α α') : Ctx43 h φ where
  hyp := hH
  cent := centHyp_of_S32 h32 h
  ex := ⟨α, α', hs⟩
  c431A := fun a a' has => h431A G M T L h F inferInstance inferInstance φ hH a a' has
  c431B := fun a a' has => h431B G M T L h F inferInstance inferInstance φ hH a a' has
  c432 := fun a a' has => h432 G M T L h F inferInstance inferInstance φ hH a a' has
  edge := fun _ _ ha hab =>
    concl433_edge h (isSL3Full_iff_exists_via.mpr ⟨F, inferInstance, inferInstance, φ, hH.2.2⟩)
      (s42_of h32) h431A h431B hH (centHyp_of_S32 h32 h) hs ha hab

end Ctx

namespace Ctx43

variable {G : Type} [Group G] [Finite G] {M T L : Subgroup G} {h : PUHyp M T L}
  {F : Type} [Field F] [Fintype F] {φ : ↥M →* ↥(StatedSL 3 F)} (c : Ctx43 h φ)
include c

local notation "𝔛" => puAmalgam h.le
local notation "𝔘" => GoldAmalgam.Universal (puAmalgam h.le)
local notation "𝔄" => SimpleGraph.Adj (GoldAmalgam.treeGraph (puAmalgam h.le))

theorem via : IsSL3FullVia M T L φ := c.hyp.2.2

theorem full : IsSL3Full M T L :=
  isSL3Full_iff_exists_via.mpr ⟨F, inferInstance, inferInstance, φ, c.via⟩

theorem hb : 2 < critDist 𝔛 := c.hyp.2.1

theorem charP : CharP F 2 := by
  obtain ⟨n, hn⟩ := c.via.1
  exact FFC.charP_two_of_card_pow (by rw [Nat.card_eq_fintype_card, hn])

theorem b6 : 6 ≤ critDist 𝔛 := by
  obtain ⟨α, α', hs⟩ := c.ex
  exact (c.c431A α α' hs).2.2.2.2.2

theorem star_at {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) : ∃ μ' : Vtx 𝔛, Star 𝔛 μ μ' := by
  obtain ⟨α, α', hs⟩ := c.ex
  exact exists_star_at _ hs hμ

theorem isC1 {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) :
    IsC1 h.le L (Fintype.card F) μ (Vv 𝔛 μ) (ZM 𝔛 μ) := by
  obtain ⟨μ', hs⟩ := c.star_at hμ
  exact (c.c431A μ μ' hs).2.2.2.1

theorem vii {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) {δ : Vtx 𝔛} (hδ : δ ∈ nablaSet h.le L μ) :
    ⁅ZM 𝔛 δ, Qv 𝔛 μ⁆ = Usup 𝔛 δ (geo 𝔛 μ δ 1) := by
  obtain ⟨μ', hs⟩ := c.star_at hμ
  exact (c.c431B μ μ' hs).2.2 δ hδ

theorem concl432 {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) : Concl432 h.le L μ := by
  obtain ⟨μ', hs⟩ := c.star_at hμ
  exact c.c432 μ μ' hs

theorem usup_le_zh {μ ν : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) (hμν : 𝔄 μ ν) :
    Usup 𝔛 μ ν ≤ ZH 𝔛 ν := (c.edge μ ν hμ hμν).1

theorem card_usup {μ ν : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) (hμν : 𝔄 μ ν) :
    Nat.card ↥(Usup 𝔛 μ ν) = Fintype.card F ^ 2 := (c.edge μ ν hμ hμν).2.1

theorem relIndex_qv {μ ν : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) (hμν : 𝔄 μ ν) :
    (Qv 𝔛 μ).relIndex (Qv 𝔛 ν) = Fintype.card F ^ 2 := (c.edge μ ν hμ hμν).2.2.2

theorem commutator_vv_qv_le_zm {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) :
    ⁅Vv 𝔛 μ, Qv 𝔛 μ⁆ ≤ ZM 𝔛 μ :=
  S4A.commutator_vv_qv_le_zm h c.hb (fun _ _ hδ hδρ => c.usup_le_zh hδ hδρ) hμ

theorem zm_inf_centralizer_ltil_le_zloc {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) :
    ZM 𝔛 μ ⊓ Subgroup.centralizer (Ltil h.le L μ : Set 𝔘) ≤ Zloc h.le L μ := by
  rw [Zloc, h.puTrans_Zq hμ, xm_eq_zm h c.full hμ]

theorem commutator_vv_qv_le_zloc {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) :
    ⁅Vv 𝔛 μ, Qv 𝔛 μ⁆ ≤ Zloc h.le L μ := by
  refine (le_inf (c.commutator_vv_qv_le_zm hμ) ((c.concl432 hμ).1.trans ?_)).trans
    (c.zm_inf_centralizer_ltil_le_zloc hμ)
  rw [Dloc, h.puTrans_Dq hμ]
  exact inf_le_right

theorem zloc_le_stabCenter {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) :
    Zloc h.le L μ ≤ stabCenter 𝔛 μ := by
  intro x hx
  refine (mem_stabCenter_iff_comm _).mpr ⟨puTrans_le_stab h.le _ μ hx, fun g hg => ?_⟩
  exact Subgroup.mem_centralizer_iff.mp (zloc_le_centralizer_stab h c.full hμ hx) g hg

theorem zm_inf_stabCenter_le_zloc {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) :
    ZM 𝔛 μ ⊓ stabCenter 𝔛 μ ≤ Zloc h.le L μ := by
  refine le_trans ?_ (c.zm_inf_centralizer_ltil_le_zloc hμ)
  rintro x ⟨hxZ, hxC⟩
  refine ⟨hxZ, Subgroup.mem_centralizer_iff.mpr fun l hl => ?_⟩
  exact (((mem_stabCenter_iff_comm _).mp hxC).2 l (ltil_le_stab h μ hl))

theorem uloc_inf_stabCenter {μ : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) :
    Uloc h.le L μ ⊓ stabCenter 𝔛 μ = ⊥ := by
  rw [eq_bot_iff, ← uloc_inf_zloc h c.full μ]
  rintro x ⟨hxU, hxC⟩
  exact ⟨hxU, c.zm_inf_stabCenter_le_zloc hμ ⟨uloc_le_zm h c.full hμ hxU, hxC⟩⟩

theorem usup_le_uloc {μ ν : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) (hμν : 𝔄 μ ν) :
    Usup 𝔛 μ ν ≤ Uloc h.le L μ := by
  rw [usup_eq_commutator_uloc h c.full hμ hμν]
  exact Subgroup.le_normalizer_iff_commutator_le_left.mp ((qv_le_stab_of_adj _ hμν.symm).trans
    (stab_le_normalizer_puTrans h.le (S4A.Uq_normal h) μ))

theorem card_uloc_inf_zh {μ ν : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) (hμν : 𝔄 μ ν) :
    Nat.card ↥(Uloc h.le L μ ⊓ ZH 𝔛 ν) = Fintype.card F ^ 2 := by
  have hb0 := h.critDist_pos
  obtain ⟨ψ, -, hψ⟩ := exists_natural_Uloc h c.via hμ
  have hrel := (c.edge μ ν hμ hμν).2.2.1
  rw [zm_eq_uloc_sup_zloc h c.full hμ] at hrel
  have hZQ : ZM 𝔛 μ ≤ Qv 𝔛 ν := (zm_le_qv_self _ hμ hb0).trans (qv_le_qv _ h.hyp20 hμ hμν)
  have hfQ : Finite ↥(Qv 𝔛 ν) := finite_qv _ h.hyp20 (by rw [← isMVtx_iff_of_adj _ hμν]; exact hμ)
  have hfU : Finite ↥(Uloc h.le L μ) :=
    Finite.of_injective _ (Subgroup.inclusion_injective ((uloc_le_zm h c.full hμ).trans hZQ))
  have hfW : Finite ↥(Zloc h.le L μ) :=
    Finite.of_injective _ (Subgroup.inclusion_injective ((zloc_le_zm h c.full hμ).trans hZQ))
  rw [relIndex_sup_eq_of_le (zloc_le_zh h c.full hμ hμν)
    ((zloc_le_centralizer_stab h c.full hμ).trans (Subgroup.centralizer_le
      ((uloc_le_zm h c.full hμ).trans ((zm_le_qv_self _ hμ hb0).trans (qv_le_stab _ μ)))))
    (uloc_inf_zloc h c.full μ)] at hrel
  have hmul := relIndex_mul_card_inf (ZH 𝔛 ν) (Uloc h.le L μ)
  rw [hrel, card_eq_of_natural hψ, Nat.card_eq_fintype_card (α := F)] at hmul
  have hqpos : 0 < Fintype.card F := Fintype.card_pos
  rw [inf_comm]
  have : Fintype.card F * Nat.card ↥(ZH 𝔛 ν ⊓ Uloc h.le L μ) =
      Fintype.card F * Fintype.card F ^ 2 := by rw [hmul]; ring
  exact Nat.eq_of_mul_eq_mul_left hqpos this

theorem uloc_inf_zh_eq_usup {μ ν : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) (hμν : 𝔄 μ ν) :
    Uloc h.le L μ ⊓ ZH 𝔛 ν = Usup 𝔛 μ ν := by
  have hle : Usup 𝔛 μ ν ≤ Uloc h.le L μ ⊓ ZH 𝔛 ν :=
    le_inf (c.usup_le_uloc hμ hμν) (c.usup_le_zh hμ hμν)
  have hfin : Finite ↥(Uloc h.le L μ ⊓ ZH 𝔛 ν) := by
    have := finite_qv _ h.hyp20 (by rw [← isMVtx_iff_of_adj _ hμν]; exact hμ)
    exact Finite.of_injective _ (Subgroup.inclusion_injective (inf_le_right.trans (zh_le_qv _ ν)))
  symm
  exact Subgroup.eq_of_le_of_card_ge hle (by rw [c.card_uloc_inf_zh hμ hμν, c.card_usup hμ hμν])

theorem mem_usup_of_commute {μ ν : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) (hμν : 𝔄 μ ν) {x : 𝔘}
    (hxν : x ∈ Qv 𝔛 ν) (hxμ : x ∉ Qv 𝔛 μ) {u : 𝔘} (hu : u ∈ Uloc h.le L μ)
    (hc : x * u = u * x) : u ∈ Usup 𝔛 μ ν := by
  have hq : 2 ≤ Nat.card F := Finite.one_lt_card
  obtain ⟨ψ, -, hψ⟩ := exists_natural_Uloc h c.via hμ
  have hTs : Qv 𝔛 ν ≤ stab 𝔛 μ := qv_le_stab_of_adj _ hμν.symm
  have hxs : x ∈ stab 𝔛 μ := hTs hxν
  have hZs : Subgroup.zpowers x ≤ stab 𝔛 μ := (Subgroup.zpowers_le).mpr hxs
  have hP2 : Module.finrank F (fixN (natImage ψ (Qv 𝔛 ν))) = 2 := by
    have hcard := c.card_uloc_inf_zh hμ hμν
    rw [inf_comm, zh_inf_uloc h c.full hμ hμν, card_inf_centralizer_eq hψ hTs,
      Module.natCard_eq_pow_finrank (K := F), ← Nat.card_eq_fintype_card] at hcard
    exact Nat.pow_right_injective hq hcard
  have hPW : fixN (natImage ψ (Qv 𝔛 ν)) ≤ fixN (natImage ψ (Subgroup.zpowers x)) :=
    fixN_anti (natImage_mono ((Subgroup.zpowers_le).mpr hxν))
  have hWtop : fixN (natImage ψ (Subgroup.zpowers x)) ≠ ⊤ := by
    intro htop
    apply hxμ
    have h1 : toSL3 ψ ⟨x, hxs⟩ = 1 := by
      refine eq_one_of_mulVec_eq_self fun v => ?_
      have hv : v ∈ fixN (natImage ψ (Subgroup.zpowers x)) := htop ▸ Submodule.mem_top
      exact (mem_fixN.mp hv) _ (mem_natImage.mpr ⟨⟨x, hxs⟩, Subgroup.mem_zpowers x, rfl⟩)
    exact (S46.toSL3_eq_one_iff_mem_qv h c.via hμ hψ ⟨x, hxs⟩).mp h1
  have hWP : fixN (natImage ψ (Subgroup.zpowers x)) = fixN (natImage ψ (Qv 𝔛 ν)) := by
    have hlt := Submodule.finrank_lt hWtop
    rw [Module.finrank_fin_fun] at hlt
    exact (Submodule.eq_of_le_of_finrank_le hPW (by omega)).symm
  have huc : (⟨u, hu⟩ : ↥(Uloc h.le L μ)).1 ∈
      Subgroup.centralizer ((Subgroup.zpowers x : Subgroup 𝔘) : Set 𝔘) := by
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
    exact ((Commute.zpow_left hc k).eq)
  rw [mem_centralizer_iff_natVec hψ hZs, hWP, ← mem_centralizer_iff_natVec hψ hTs] at huc
  rw [← c.uloc_inf_zh_eq_usup hμ hμν, inf_comm, zh_inf_uloc h c.full hμ hμν]
  exact ⟨hu, huc⟩

theorem le_card_commutator_uloc {μ ν : Vtx 𝔛} (hμ : IsMVtx 𝔛 μ) (hμν : 𝔄 μ ν) {x : 𝔘}
    (hxν : x ∈ Qv 𝔛 ν) (hxμ : x ∉ Qv 𝔛 μ) :
    Fintype.card F ≤ Nat.card ↥⁅Uloc h.le L μ, Subgroup.zpowers x⁆ := by
  obtain ⟨ψ, -, hψ⟩ := exists_natural_Uloc h c.via hμ
  have hxs : x ∈ stab 𝔛 μ := qv_le_stab_of_adj _ hμν.symm hxν
  have hZs : Subgroup.zpowers x ≤ stab 𝔛 μ := (Subgroup.zpowers_le).mpr hxs
  have hne : natImage ψ (Subgroup.zpowers x) ≠ ⊥ := by
    intro hbot
    apply hxμ
    refine (S46.toSL3_eq_one_iff_mem_qv h c.via hμ hψ ⟨x, hxs⟩).mp ?_
    have : toSL3 ψ ⟨x, hxs⟩ ∈ natImage ψ (Subgroup.zpowers x) :=
      mem_natImage.mpr ⟨⟨x, hxs⟩, Subgroup.mem_zpowers x, rfl⟩
    rw [hbot] at this
    exact this
  rw [card_commutator_eq hψ hZs, ← Nat.card_eq_fintype_card]
  exact card_le_commN hne

theorem mem_nablaSet_geo_two {a a' : Vtx 𝔛} (hc : IsCritical 𝔛 a a') :
    a ∈ nablaSet h.le L (geo 𝔛 a a' 2) := by
  have hb6 := c.b6
  have hd : (puAmalgam h.le).treeGraph.dist a a' = critDist 𝔛 := hc.2.1
  have hγ : IsMVtx 𝔛 (geo 𝔛 a a' 2) := isMVtx_geo_two _ h.hyp20 h.critDist_pos hc
  have hdγ : (puAmalgam h.le).treeGraph.dist (geo 𝔛 a a' 2) a = 2 := by
    rw [tdist_comm, dist_geo _ (by omega)]
  refine ⟨hdγ, fun hZB => ms22_iv _ h.hyp20 h.critDist_pos c.cent hc ?_⟩
  rw [zv_of_isMVtx _ hc.1] at hZB
  have hZV : ZM 𝔛 a ≤ Vv 𝔛 (geo 𝔛 a a' 2) := by
    rw [← zv_of_isMVtx _ hc.1]
    exact zv_le_vv h hdγ.le
  rw [stab_eq_ltil_sup_qv h c.full hγ, xm_eq_zm h c.full hγ]
  refine sup_le ?_ ?_
  · refine le_normalizer_sup_of_comm_le
      ((ltil_le_stab h _).trans (stab_le_normalizer_zm _ _)) ?_
    exact ((Subgroup.commutator_mono hZB le_rfl).trans (commutator_bloc_le h c.hb hγ)).trans
      le_sup_right
  · refine le_normalizer_sup_of_comm_le ((qv_le_stab _ _).trans
      (stab_le_normalizer_zm _ _)) ?_
    exact ((Subgroup.commutator_mono hZV le_rfl).trans (c.commutator_vv_qv_le_zm hγ)).trans
      le_sup_right

theorem mem_nablaSet_geo_two' {a a' : Vtx 𝔛} (hc : IsCritical 𝔛 a a') :
    a' ∈ nablaSet h.le L (geo 𝔛 a' a 2) :=
  c.mem_nablaSet_geo_two (ms22_iii _ h.hyp20 h.critDist_pos c.cent hc)

theorem uloc_inf_zm_le_usup {β δ l : Vtx 𝔛} (hβ : ¬ IsMVtx 𝔛 β) (hβδ : 𝔄 β δ) (hβl : 𝔄 β l)
    (hne : ¬ Qv 𝔛 l ≤ Qv 𝔛 δ) : Uloc h.le L δ ⊓ ZM 𝔛 l ≤ Usup 𝔛 δ β := by
  have hδ : IsMVtx 𝔛 δ := by have := isMVtx_iff_of_adj _ hβδ; tauto
  have hl : IsMVtx 𝔛 l := by have := isMVtx_iff_of_adj _ hβl; tauto
  obtain ⟨x, hxl, hxδ⟩ := IsConcreteLE.not_le_iff_exists.mp hne
  rintro u ⟨hu, huZ⟩
  exact c.mem_usup_of_commute hδ hβδ.symm (qv_le_qv _ h.hyp20 hl hβl.symm hxl) hxδ hu
    (Subgroup.mem_centralizer_iff.mp (zm_le_centralizer_qv _ h.hyp20 hl huZ) x hxl)

theorem commutator_mem_zloc_of_dloc {l : Vtx 𝔛} (hl : IsMVtx 𝔛 l) {d : 𝔘}
    (hdD : d ∈ Dloc h.le L l) (hdV : d ∈ Vv 𝔛 l) {t : 𝔘} (ht : t ∈ stab 𝔛 l) :
    ⁅t, d⁆ ∈ Zloc h.le L l := by
  rw [stab_eq_ltil_sup_qv h c.full hl, ← SetLike.mem_coe,
    Subgroup.coe_mul_of_left_le_normalizer_right _ _
      ((ltil_le_stab h l).trans (stab_le_normalizer_qv _ l))] at ht
  obtain ⟨x, hx, y, hy, rfl⟩ := ht
  rw [Dloc, h.puTrans_Dq hl] at hdD
  have hxd : ⁅x, d⁆ = 1 := by
    rw [commutatorElement_eq_one_iff_mul_comm]
    exact Subgroup.mem_centralizer_iff.mp hdD.2 x hx
  have hyd : ⁅y, d⁆ ∈ Zloc h.le L l := by
    have := c.commutator_vv_qv_le_zloc hl (Subgroup.commutator_mem_commutator hdV hy)
    have he : ⁅y, d⁆ = ⁅d, y⁆⁻¹ := by rw [commutatorElement_inv]
    rw [he]
    exact Subgroup.inv_mem _ this
  rw [commutatorElement_mul_left_eq, hxd, mul_one]
  have hxs : x ∈ stab 𝔛 l := ltil_le_stab h l hx
  have hc := Subgroup.mem_centralizer_iff.mp (zloc_le_centralizer_stab h c.full hl hyd) x hxs
  rw [hc, mul_inv_cancel_right]
  exact hyd

theorem zm_le_uloc_sup_dloc {β δ l : Vtx 𝔛} (hβ : ¬ IsMVtx 𝔛 β) (hβδ : 𝔄 β δ) (hβl : 𝔄 β l)
    (hne : ¬ Qv 𝔛 δ ≤ Qv 𝔛 l) (hd : (puAmalgam h.le).treeGraph.dist l δ = 2)
    (hZB : ZM 𝔛 δ ≤ Bloc h.le L l) : ZM 𝔛 δ ≤ Uloc h.le L l ⊔ Dloc h.le L l := by
  have hδ : IsMVtx 𝔛 δ := by have := isMVtx_iff_of_adj _ hβδ; tauto
  have hl : IsMVtx 𝔛 l := by have := isMVtx_iff_of_adj _ hβl; tauto
  obtain ⟨ψ, hsurj, hψ⟩ := exists_natural_Uloc h c.via hl
  have : CharP F 2 := c.charP
  have hb6 := c.b6
  have hQs : Qv 𝔛 δ ≤ stab 𝔛 l :=
    (qv_le_qv _ h.hyp20 hδ hβδ.symm).trans (qv_le_stab_of_adj _ hβl)
  intro z hz
  refine mem_uloc_sup_dloc h c.full hl hsurj hψ
    (zm_le_qv_of_dist_lt _ hδ (by rw [tdist_comm, hd]; omega) hz) (fun k hk => ?_) hQs
    (fun y hy => Subgroup.mem_centralizer_iff.mp (zm_le_centralizer_qv _ h.hyp20 hδ hz) y hy)
    ((qv_le_qv _ h.hyp20 hl hβl.symm).trans ((qv_le_stab_of_adj _ hβδ).trans
      (stab_le_normalizer_qv _ δ)))
    ((isPGroup_qv _ h.hyp20 hβ).to_le (qv_le_qv _ h.hyp20 hδ hβδ.symm)) (fun hc => hne ?_)
  · have := ((mem_bloc_iff h c.hb hl).mp (hZB hz)).2 k hk
    rw [← commutatorElement_inv]
    exact Subgroup.inv_mem _ this
  · intro y hy
    have hys : y ∈ stab 𝔛 l := hQs hy
    obtain ⟨e, he⟩ := (isPGroup_qv _ h.hyp20 hβ) ⟨y, qv_le_qv _ h.hyp20 hδ hβδ.symm hy⟩
    exact mem_qv_of_centralizer_uloc h hl hys (hc hy)
      ⟨e, by have := congrArg Subtype.val he; simpa using this⟩

theorem usup_le_zloc_of_ne {β δ l : Vtx 𝔛} (hβ : ¬ IsMVtx 𝔛 β) (hβδ : 𝔄 β δ) (hβl : 𝔄 β l)
    (hne : Qv 𝔛 δ ≠ Qv 𝔛 l) : Usup 𝔛 δ β ≤ Zloc h.le L l := by
  have hδ : IsMVtx 𝔛 δ := by have := isMVtx_iff_of_adj _ hβδ; tauto
  have hl : IsMVtx 𝔛 l := by have := isMVtx_iff_of_adj _ hβl; tauto
  have hδl : δ ≠ l := fun e => hne (e ▸ rfl)
  have hd : (puAmalgam h.le).treeGraph.dist l δ = 2 :=
    dist_eq_two_of_adj_adj _ hβl.symm hβδ (Ne.symm hδl)
  have hgeo : geo 𝔛 l δ 1 = β :=
    (eq_geo_one _ hβl.symm (by rw [dist_eq_one_of_adj _ hβδ, hd])).symm
  have hQl : ¬ Qv 𝔛 l ≤ Qv 𝔛 δ := fun hle => hne (qv_eq_of_le h hδ hl hle).symm
  have hQδ : ¬ Qv 𝔛 δ ≤ Qv 𝔛 l := fun hle => hne (qv_eq_of_le h hl hδ hle)
  have hZV : ZM 𝔛 δ ≤ Vv 𝔛 l := by rw [← zv_of_isMVtx _ hδ]; exact zv_le_vv h hd.le
  by_cases hn : δ ∈ nablaSet h.le L l
  · have hvii := c.vii hl hn
    rw [hgeo] at hvii
    rw [← hvii]
    exact (Subgroup.commutator_mono hZV le_rfl).trans (c.commutator_vv_qv_le_zloc hl)
  have hZB : ZM 𝔛 δ ≤ Bloc h.le L l := by
    by_contra hcon
    exact hn ⟨hd, by rwa [zv_of_isMVtx _ hδ]⟩
  have hUD := c.zm_le_uloc_sup_dloc hβ hβδ hβl hQδ hd hZB
  have hβH := hβ
  have hfin := finite_qv _ h.hyp20 hβH
  have hTl : Qv 𝔛 β ≤ stab 𝔛 l := qv_le_stab_of_adj _ hβl
  have hUn : Uloc h.le L l ≤ Subgroup.normalizer (Dloc h.le L l : Set 𝔘) :=
    (puTrans_le_stab h.le _ l).trans (stab_le_normalizer_puTrans h.le (S4A.Dq_normal h) l)
  have hZcen : Zloc h.le L l ≤ Subgroup.centralizer (stab 𝔛 l : Set 𝔘) :=
    zloc_le_centralizer_stab h c.full hl
  by_contra hcon
  obtain ⟨z, hz, t, ht, hzt⟩ : ∃ z ∈ ZM 𝔛 δ, ∃ t ∈ Qv 𝔛 β, ⁅z, t⁆ ∉ Zloc h.le L l := by
    by_contra hall
    push Not at hall
    apply hcon
    rw [Usup, zv_of_isMVtx _ hδ, Subgroup.commutator_le]
    exact hall
  have hz' : z ∈ ((Uloc h.le L l ⊔ Dloc h.le L l : Subgroup 𝔘) : Set 𝔘) := hUD hz
  rw [Subgroup.coe_mul_of_left_le_normalizer_right _ _ hUn] at hz'
  obtain ⟨u, hu, d, hdD, rfl⟩ := hz'
  have hdV : d ∈ Vv 𝔛 l := by
    have huV : u ∈ Vv 𝔛 l := zm_le_vv h hl (uloc_le_zm h c.full hl hu)
    have := (Vv 𝔛 l).mul_mem ((Vv 𝔛 l).inv_mem huV) (hZV hz)
    simpa using this
  have hds : ∀ s ∈ Qv 𝔛 β, ⁅d, s⁆ ∈ Zloc h.le L l := fun s hs => by
    have := c.commutator_mem_zloc_of_dloc hl hdD hdV (hTl hs)
    rw [← commutatorElement_inv]
    exact Subgroup.inv_mem _ this
  have hsplit : ∀ s ∈ Qv 𝔛 β, ⁅u * d, s⁆ = ⁅d, s⁆ * ⁅u, s⁆ := fun s hs => by
    rw [commutatorElement_mul_left_eq]
    have hc := Subgroup.mem_centralizer_iff.mp (hZcen (hds s hs)) u
      (puTrans_le_stab h.le _ l hu)
    rw [hc, mul_inv_cancel_right]
  have hut : ⁅u, t⁆ ∉ Zloc h.le L l := fun hmem =>
    hzt (by rw [hsplit t ht]; exact Subgroup.mul_mem _ (hds t ht) hmem)
  have hmemf : ∀ s ∈ Qv 𝔛 β, ⁅u * d, s⁆ ∈ Usup 𝔛 δ β := fun s hs => by
    rw [Usup, zv_of_isMVtx _ hδ]
    exact Subgroup.commutator_mem_commutator hz hs
  have hmemg : ∀ s ∈ Qv 𝔛 β, ⁅u, s⁆ ∈ Usup 𝔛 l β := fun s hs => by
    rw [usup_eq_commutator_uloc h c.full hl hβl.symm]
    exact Subgroup.commutator_mem_commutator hu hs
  have hcf : Usup 𝔛 δ β ≤ Subgroup.centralizer (Qv 𝔛 β : Set 𝔘) :=
    (c.usup_le_zh hδ hβδ.symm).trans (zh_le_centralizer _ β)
  have hcg : Usup 𝔛 l β ≤ Subgroup.centralizer (Qv 𝔛 β : Set 𝔘) :=
    (c.usup_le_zh hl hβl.symm).trans (zh_le_centralizer _ β)
  set f := subCommHom (Qv 𝔛 β) (Usup 𝔛 δ β) (u * d) hmemf hcf with hf
  set g := subCommHom (Qv 𝔛 β) (Usup 𝔛 l β) u hmemg hcg with hg
  have hun : u ∉ Usup 𝔛 l β := fun hmem => hut (by
    have hc := Subgroup.mem_centralizer_iff.mp (hcg hmem) t ht
    rw [commutatorElement_eq_one_iff_mul_comm.mpr hc.symm]
    exact Subgroup.one_mem _)
  have hUZ : Uloc h.le L l ⊓ Zloc h.le L l = ⊥ := uloc_inf_zloc h c.full l
  have hgU : ∀ s ∈ Qv 𝔛 β, ⁅u, s⁆ ∈ Uloc h.le L l := fun s hs =>
    c.usup_le_uloc hl hβl.symm (hmemg s hs)
  have hkerg : g.ker ≤ (Qv 𝔛 l).subgroupOf (Qv 𝔛 β) := by
    intro s hs
    rw [MonoidHom.mem_ker, hg, subCommHom_apply, commutatorElement_eq_one_iff_mul_comm] at hs
    rw [Subgroup.mem_subgroupOf]
    by_contra hsl
    exact hun (c.mem_usup_of_commute hl hβl.symm s.2 hsl hu hs.symm)
  have hkerfg : f.ker ≤ g.ker := by
    intro s hs
    rw [MonoidHom.mem_ker, hf, subCommHom_apply, hsplit s s.2] at hs
    rw [MonoidHom.mem_ker, hg, subCommHom_apply]
    have h1 : ⁅u, (s : 𝔘)⁆ = (⁅d, (s : 𝔘)⁆)⁻¹ := eq_inv_of_mul_eq_one_right hs
    have h2 : ⁅u, (s : 𝔘)⁆ ∈ Uloc h.le L l ⊓ Zloc h.le L l :=
      ⟨hgU s s.2, h1 ▸ Subgroup.inv_mem _ (hds s s.2)⟩
    rw [hUZ] at h2
    exact h2
  have hfinU : Finite ↥(Usup 𝔛 δ β) := Finite.of_injective _ (Subgroup.inclusion_injective
    ((c.usup_le_zh hδ hβδ.symm).trans (zh_le_qv _ β)))
  have hrange : f.range ≤ Usup 𝔛 δ β := by
    rintro _ ⟨s, rfl⟩
    exact hmemf s s.2
  have hidxg : Fintype.card F ^ 2 ≤ g.ker.index := by
    rw [← c.relIndex_qv hl hβl.symm]
    exact Nat.le_of_dvd (Nat.pos_of_ne_zero Subgroup.index_ne_zero_of_finite)
      (Subgroup.index_dvd_of_le hkerg)
  have hidxf : f.ker.index ≤ Fintype.card F ^ 2 := by
    rw [Subgroup.index_ker, ← c.card_usup hδ hβδ.symm]
    exact Subgroup.card_le_of_le hrange
  have hkeq : g.ker ≤ f.ker := by
    have hmul := Subgroup.relIndex_mul_index hkerfg
    have hpos : 0 < g.ker.index := Nat.pos_of_ne_zero Subgroup.index_ne_zero_of_finite
    have hle : f.ker.index ≤ g.ker.index := hidxf.trans hidxg
    have h1 : f.ker.relIndex g.ker = 1 := by
      have : f.ker.relIndex g.ker * g.ker.index ≤ 1 * g.ker.index := by
        rw [hmul, one_mul]; exact hle
      have h0 : f.ker.relIndex g.ker ≠ 0 := Subgroup.index_ne_zero_of_finite
      have := Nat.le_of_mul_le_mul_right this hpos
      omega
    exact Subgroup.relIndex_eq_one.mp h1
  have hkfg : f.ker = g.ker := le_antisymm hkerfg hkeq
  have hrangeeq : f.range = Usup 𝔛 δ β := by
    refine Subgroup.eq_of_le_of_card_ge hrange ?_
    rw [c.card_usup hδ hβδ.symm, ← Subgroup.index_ker, hkfg]
    exact hidxg
  have hinf : Usup 𝔛 δ β ⊓ Zloc h.le L l = ⊥ := by
    rw [eq_bot_iff]
    rintro w ⟨hw, hwZ⟩
    rw [← hrangeeq] at hw
    obtain ⟨s, rfl⟩ := hw
    have hfs : f s = ⁅d, (s : 𝔘)⁆ * ⁅u, (s : 𝔘)⁆ := by
      rw [hf, subCommHom_apply, hsplit s s.2]
    have hgs : ⁅u, (s : 𝔘)⁆ ∈ Zloc h.le L l := by
      have key : ⁅u, (s : 𝔘)⁆ = (⁅d, (s : 𝔘)⁆)⁻¹ * f s := by rw [hfs, inv_mul_cancel_left]
      rw [key]
      exact (Zloc h.le L l).mul_mem ((Zloc h.le L l).inv_mem (hds s s.2)) hwZ
    have hs1 : s ∈ g.ker := by
      rw [MonoidHom.mem_ker, hg, subCommHom_apply]
      have h2 : ⁅u, (s : 𝔘)⁆ ∈ Uloc h.le L l ⊓ Zloc h.le L l := ⟨hgU s s.2, hgs⟩
      rw [hUZ] at h2
      exact h2
    rw [← hkfg, MonoidHom.mem_ker] at hs1
    rw [hs1]
    exact Subgroup.one_mem _
  have hQlβ : Qv 𝔛 l ≤ Qv 𝔛 β := qv_le_qv _ h.hyp20 hl hβl.symm
  have hbot : ⁅ZM 𝔛 δ, Qv 𝔛 l⁆ = ⊥ := by
    rw [eq_bot_iff, ← hinf]
    refine le_inf ?_ ((Subgroup.commutator_mono hZV le_rfl).trans (c.commutator_vv_qv_le_zloc hl))
    rw [Usup, zv_of_isMVtx _ hδ]
    exact Subgroup.commutator_mono le_rfl hQlβ
  apply hQl
  rw [← c.cent δ β hδ hβδ.symm]
  refine le_inf hQlβ ?_
  rw [Subgroup.commutator_comm, Subgroup.commutator_eq_bot_iff_le_centralizer] at hbot
  exact hbot

theorem concl434 : Concl434 h.le L := by
  intro β δ l hβ hβδ hβl hnot
  have hδ : IsMVtx 𝔛 δ := by have := isMVtx_iff_of_adj _ hβδ; tauto
  have hl : IsMVtx 𝔛 l := by have := isMVtx_iff_of_adj _ hβl; tauto
  by_cases hQ : Qv 𝔛 δ = Qv 𝔛 l
  · rw [← xm_eq_zm h c.full hδ, ← xm_eq_zm h c.full hl, XM, XM, hQ]
  · exfalso
    apply hnot
    have hQl : ¬ Qv 𝔛 l ≤ Qv 𝔛 δ := fun hle => hQ (qv_eq_of_le h hδ hl hle).symm
    exact (c.uloc_inf_zm_le_usup hβ hβδ hβl hQl).trans
      ((c.usup_le_zloc_of_ne hβ hβδ hβl hQ).trans (c.zloc_le_stabCenter hl))

theorem zm_eq_of_mem_nablaSet {α β δ l : Vtx 𝔛} (hα : IsMVtx 𝔛 α) (hαβ : 𝔄 α β) (hβδ : 𝔄 β δ)
    (hβl : 𝔄 β l) (hδ : δ ∈ nablaSet h.le L α) (hl : l ∈ nablaSet h.le L α) :
    ZM 𝔛 δ = ZM 𝔛 l := by
  have hβ : ¬ IsMVtx 𝔛 β := by rw [← isMVtx_iff_of_adj _ hαβ]; exact hα
  have hlM : IsMVtx 𝔛 l := by have := isMVtx_iff_of_adj _ hβl; tauto
  have hgeo : ∀ {x : Vtx 𝔛}, 𝔄 β x → x ∈ nablaSet h.le L α → geo 𝔛 α x 1 = β :=
    fun hβx hx => (eq_geo_one _ hαβ (by rw [dist_eq_one_of_adj _ hβx, hx.1])).symm
  have hH := c.concl432 hα
  have hU : Usup 𝔛 δ β = Usup 𝔛 l β := by
    have h1 := (hH.2 δ hδ)
    have h2 := (hH.2 l hl)
    rw [hgeo hβδ hδ] at h1
    rw [hgeo hβl hl] at h2
    rw [← h1.2, ← h1.1, h2.1, h2.2]
  refine c.concl434 β δ l hβ hβδ hβl fun hle => ?_
  have hδM : IsMVtx 𝔛 δ := by have := isMVtx_iff_of_adj _ hβδ; tauto
  have hsub : Usup 𝔛 l β ≤ Uloc h.le L l ⊓ stabCenter 𝔛 l := by
    refine le_inf (c.usup_le_uloc hlM hβl.symm) (le_trans ?_ hle)
    rw [← hU]
    exact le_inf (c.usup_le_uloc hδM hβδ.symm) (hU ▸ (c.usup_le_zh hlM hβl.symm).trans
      (zh_le_zm _ hβl.symm))
  rw [c.uloc_inf_stabCenter hlM, le_bot_iff] at hsub
  have hc := c.card_usup hlM hβl.symm
  rw [hsub, Subgroup.card_bot] at hc
  have hq : 2 ≤ Fintype.card F := Fintype.one_lt_card
  have : 4 ≤ Fintype.card F ^ 2 := by nlinarith
  omega

end Ctx43

