theorem stab_le_normalizer_of_le_qv (hC : CentHyp 𝔛) (hb : 4 < critDist 𝔛)
    (hV : ∀ δ δ' : Vtx 𝔛, IsCritical 𝔛 δ δ' → ¬ Vv 𝔛 δ ≤ Qv 𝔛 (geo 𝔛 δ' δ 2))
    {α α' : Vtx 𝔛} (hc : IsCritical 𝔛 α α')
    (hA : conjCl (stab 𝔛 α) (ZM 𝔛 (geo 𝔛 α α' 2)) ≤ Qv 𝔛 (geo 𝔛 α' α 2))
    {t : 𝔘} (ht : t ∈ stab 𝔛 α)
    (hN : ¬ ZM 𝔛 α' ≤ Subgroup.normalizer (Usup 𝔛 α (t • geo 𝔛 α α' 1) : Set 𝔘))
    (hle : conjCl (stab 𝔛 α ⊓ Subgroup.normalizer (Usup 𝔛 α (t • geo 𝔛 α α' 1) : Set 𝔘))
      (conjCl (stab 𝔛 (t • geo 𝔛 α α' 2)) (ZM 𝔛 α)) ≤ Qv 𝔛 (geo 𝔛 α' α 2)) :
    stab 𝔛 α ≤ Subgroup.normalizer ((conjCl (stab 𝔛 (geo 𝔛 α α' 2)) (ZM 𝔛 α) ⊔
      conjCl (stab 𝔛 α) (ZM 𝔛 (geo 𝔛 α α' 2)) : Subgroup 𝔘) : Set 𝔘) := by
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have h20 := h.hyp20
  have hb0 := h.critDist_pos
  have hα : IsMVtx 𝔛 α := hc.1
  have hα' : IsMVtx 𝔛 α' := hc.isMVtx_right _ h20
  have hd : (puAmalgam h.le).treeGraph.dist α α' = critDist 𝔛 := hc.2.1
  have htα : t • α = α := (mem_stab _).mp ht
  set β := geo 𝔛 α α' 1 with hβdef
  set γ := geo 𝔛 α α' 2 with hγdef
  have hαβ : 𝔄 α β := adj_geo_one_of_isCritical _ hb0 hc
  have hβγ : 𝔄 β γ := adj_geo _ (i := 1) (by omega)
  have htβ : 𝔄 α (t • β) := by
    have := (adj_smul _ t α β).mpr hαβ
    rwa [htα] at this
  set P := stab 𝔛 α ⊓ Subgroup.normalizer (Usup 𝔛 α (t • β) : Set 𝔘) with hPdef
  set V := conjCl (stab 𝔛 α) (ZM 𝔛 γ) with hVdef
  set W₁ := conjCl (stab 𝔛 (t • γ)) (ZM 𝔛 α) with hW₁def
  set Y := conjCl P W₁ with hYdef
  have hVn : stab 𝔛 α ≤ Subgroup.normalizer (V : Set 𝔘) := le_normalizer_conjCl _ _
  have hPs : P ≤ stab 𝔛 α := inf_le_left
  have hZs : ZM 𝔛 α' ≤ stab 𝔛 α := zm_le_stab_of_isCritical _ h20 hb0 hc
  have hZV : ⁅V, ZM 𝔛 α'⁆ ≤ V :=
    Subgroup.le_normalizer_iff_commutator_le_left.mp (hZs.trans hVn)
  have hX : conjCl P (ZM 𝔛 (t • γ)) ≤ V := by
    refine conjCl_le_of_le_normalizer ?_ (hPs.trans hVn)
    rw [zm_smul]
    exact map_conj_le_conjCl ht
  have hU := commutator_conjCl_normalizer_eq_usup h hφ hC hb hV hc htβ hN ht rfl (hX.trans hA)
  have hUV : Usup 𝔛 α' (geo 𝔛 α' α 1) ≤ V := by
    rw [← hU]
    exact (Subgroup.commutator_mono hX le_rfl).trans hZV
  have hd2 : (puAmalgam h.le).treeGraph.dist α' (geo 𝔛 α' α 2) = 2 :=
    dist_geo _ (by rw [tdist_comm, hd]; omega)
  have ha2 : IsMVtx 𝔛 (geo 𝔛 α' α 2) :=
    (isMVtx_geo _ (by rw [tdist_comm, hd]; omega)).mpr ⟨fun _ => even_two, fun _ => hα'⟩
  have ha12 : 𝔄 (geo 𝔛 α' α 1) (geo 𝔛 α' α 2) := adj_geo _ (i := 1) (by rw [tdist_comm, hd]; omega)
  have hYQ : Y ≤ Qv 𝔛 (geo 𝔛 α' α 1) := hle.trans (qv_le_qv _ h20 ha2 ha12.symm)
  have hYZ : ⁅Y, ZM 𝔛 α'⁆ ≤ V := by
    refine (Subgroup.commutator_mono hYQ le_rfl).trans ?_
    rw [Subgroup.commutator_comm]
    have e : ⁅ZM 𝔛 α', Qv 𝔛 (geo 𝔛 α' α 1)⁆ = Usup 𝔛 α' (geo 𝔛 α' α 1) := by
      rw [Usup, zv_of_isMVtx _ hα']
    rw [e]
    exact hUV
  have hQn : stab 𝔛 α ≤ Subgroup.normalizer (Qv 𝔛 α : Set 𝔘) := stab_le_normalizer_qv _ α
  have hdtγ : (puAmalgam h.le).treeGraph.dist (t • γ) α = 2 := by
    rw [tdist_comm, ← htα, dist_smul, dist_geo _ (by omega)]
  have htγM : IsMVtx 𝔛 (t • γ) := (isMVtx_smul _ t γ).mpr (isMVtx_geo_two _ h20 hb0 hc)
  have hW₁Q : W₁ ≤ Qv 𝔛 α := by
    have hZW : ZM 𝔛 α ≤ Vv 𝔛 (t • γ) := by
      have := zv_le_vv h (α := t • γ) (ρ := α) hdtγ.le
      rwa [zv_of_isMVtx _ hα] at this
    exact (conjCl_le_of_le_normalizer hZW (stab_le_normalizer_vv h (t • γ))).trans
      (vv_le_qv_of_dist h htγM (by omega))
  have hYs : Y ≤ stab 𝔛 α := (conjCl_le_of_le_normalizer hW₁Q (hPs.trans hQn)).trans
    (qv_le_stab _ α)
  have hVs : V ≤ stab 𝔛 α := by
    have hZγ : ZM 𝔛 γ ≤ Qv 𝔛 α := zm_le_qv_of_dist_lt _ (isMVtx_geo_two _ h20 hb0 hc)
      (by rw [tdist_comm, dist_geo _ (by omega)]; omega)
    exact (conjCl_le_of_le_normalizer hZγ hQn).trans (qv_le_stab _ α)
  have hPYt : P ≤ Subgroup.normalizer ((Y ⊔ V : Subgroup 𝔘) : Set 𝔘) :=
    (le_inf (le_normalizer_conjCl P W₁) (hPs.trans hVn)).trans
      (Subgroup.inf_normalizer_le_normalizer_sup _ _)
  have hZYt : ZM 𝔛 α' ≤ Subgroup.normalizer ((Y ⊔ V : Subgroup 𝔘) : Set 𝔘) :=
    le_normalizer_sup_of_commutator_le (hZs.trans hVn) hYZ
  have hH : stab 𝔛 α ⊓ Subgroup.normalizer ((Y ⊔ V : Subgroup 𝔘) : Set 𝔘) = stab 𝔛 α :=
    eq_stab_of_le h hφ hC hb hα htβ inf_le_left (le_inf hPs hPYt)
      (fun hle' => hN ((le_inf hZs hZYt).trans hle'))
  have hsYt : stab 𝔛 α ≤ Subgroup.normalizer ((Y ⊔ V : Subgroup 𝔘) : Set 𝔘) := by
    rw [← hH]
    exact inf_le_right
  have hYtZ : ⁅Y ⊔ V, ZM 𝔛 α'⁆ ≤ V :=
    commutator_sup_le_of (hYs.trans hVn) (hVs.trans hVn) hYZ hZV
  have hYtL : ⁅Y ⊔ V, Ltil h.le L α⁆ ≤ V :=
    S46.commutator_ltil_le_of_commutator_le h hfull hα hαβ hsYt hVn hYtZ
      (zm_le_qv_geo_one _ h20 hb0 hc) (ms22_iii _ h20 hb0 hC hc).2.2
  have hW₁L : ⁅W₁, Ltil h.le L α⁆ ≤ V :=
    (Subgroup.commutator_mono ((le_conjCl P W₁).trans le_sup_left) le_rfl).trans hYtL
  have hLN : Ltil h.le L α ≤ Subgroup.normalizer ((W₁ ⊔ V : Subgroup 𝔘) : Set 𝔘) :=
    le_normalizer_sup_of_commutator_le ((ltil_le_stab h α).trans hVn) hW₁L
  have hQN : Qv 𝔛 (t • β) ≤ Subgroup.normalizer ((W₁ ⊔ V : Subgroup 𝔘) : Set 𝔘) := by
    have h1 : Qv 𝔛 (t • β) ≤ stab 𝔛 (t • γ) :=
      qv_le_stab_of_adj _ ((adj_smul _ t β γ).mpr hβγ)
    have h2 : Qv 𝔛 (t • β) ≤ stab 𝔛 α := qv_le_stab_of_adj _ htβ.symm
    exact (le_inf (h1.trans (le_normalizer_conjCl _ _)) (h2.trans hVn)).trans
      (Subgroup.inf_normalizer_le_normalizer_sup _ _)
  have hsW : stab 𝔛 α ≤ Subgroup.normalizer ((W₁ ⊔ V : Subgroup 𝔘) : Set 𝔘) := by
    rw [stab_eq_ltil_sup_qv_adj h hfull hα htβ]
    exact sup_le hLN hQN
  have hW₁V : W₁ ⊔ V = conjCl (stab 𝔛 γ) (ZM 𝔛 α) ⊔ V := by
    have hti : t⁻¹ ∈ stab 𝔛 α := inv_mem ht
    have e1 : (W₁ ⊔ V).map (MulAut.conj t⁻¹).toMonoidHom = W₁ ⊔ V :=
      map_conj_eq_of_mem_normalizer (hsW hti)
    rw [← e1, Subgroup.map_sup, map_conj_eq_of_mem_normalizer (hVn hti), hW₁def,
      map_conj_conjCl_zm h, inv_smul_smul, (mem_stab _).mp hti]
  rw [← hW₁V]
  exact hsW

theorem commutator_props (hC : CentHyp 𝔛) (hb : 4 < critDist 𝔛)
    (h441 : ∀ δ δ' : Vtx 𝔛, IsCritical 𝔛 δ δ' → Concl441 h.le L δ (geo 𝔛 δ δ' 2))
    {α α' : Vtx 𝔛} (hc : IsCritical 𝔛 α α')
    (hA : conjCl (stab 𝔛 α) (ZM 𝔛 (geo 𝔛 α α' 2)) ≤ Qv 𝔛 (geo 𝔛 α' α 2))
    (hB : ∀ g ∈ stab 𝔛 α, conjCl (stab 𝔛 (g • geo 𝔛 α α' 2)) (ZM 𝔛 α) ≤ Qv 𝔛 (geo 𝔛 α' α 4))
    {t : 𝔘} (ht : t ∈ stab 𝔛 α) {Y : Subgroup 𝔘}
    (hYdef : Y = conjCl (stab 𝔛 α ⊓ Subgroup.normalizer (Usup 𝔛 α (t • geo 𝔛 α α' 1) : Set 𝔘))
      (conjCl (stab 𝔛 (t • geo 𝔛 α α' 2)) (ZM 𝔛 α)))
    (hY : ¬ Y ≤ Qv 𝔛 (geo 𝔛 α' α 2)) :
    ⁅Y, ZM 𝔛 (geo 𝔛 α' α 2)⁆ ≤ Usup 𝔛 α (t • geo 𝔛 α α' 1) ∧
      ⁅Y, ZM 𝔛 (geo 𝔛 α' α 2)⁆ ≤ Uloc h.le L (geo 𝔛 α' α 2) ∧
      ⁅Y, ZM 𝔛 (geo 𝔛 α' α 2)⁆ ≤ Subgroup.centralizer (ZM 𝔛 α' : Set 𝔘) ∧
      Fintype.card F ≤ Nat.card ↥⁅Y, ZM 𝔛 (geo 𝔛 α' α 2)⁆ := by
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have h20 := h.hyp20
  have hb0 := h.critDist_pos
  have hα : IsMVtx 𝔛 α := hc.1
  have hα' : IsMVtx 𝔛 α' := hc.isMVtx_right _ h20
  have hd : (puAmalgam h.le).treeGraph.dist α α' = critDist 𝔛 := hc.2.1
  have hd' : (puAmalgam h.le).treeGraph.dist α' α = critDist 𝔛 := by rw [tdist_comm]; exact hd
  have htα : t • α = α := (mem_stab _).mp ht
  set β := geo 𝔛 α α' 1 with hβdef
  set γ := geo 𝔛 α α' 2 with hγdef
  set a2 := geo 𝔛 α' α 2 with ha2def
  set a3 := geo 𝔛 α' α 3 with ha3def
  set a4 := geo 𝔛 α' α 4 with ha4def
  have hαβ : 𝔄 α β := adj_geo_one_of_isCritical _ hb0 hc
  have hβγ : 𝔄 β γ := adj_geo _ (i := 1) (by omega)
  have hγM : IsMVtx 𝔛 γ := isMVtx_geo_two _ h20 hb0 hc
  have htβ : 𝔄 α (t • β) := by
    have := (adj_smul _ t α β).mpr hαβ
    rwa [htα] at this
  have ha2 : IsMVtx 𝔛 a2 :=
    (isMVtx_geo _ (by omega)).mpr ⟨fun _ => even_two, fun _ => hα'⟩
  have ha4 : IsMVtx 𝔛 a4 :=
    (isMVtx_geo _ (by omega)).mpr ⟨fun _ => ⟨2, rfl⟩, fun _ => hα'⟩
  have h23 : 𝔄 a2 a3 := adj_geo _ (i := 2) (by omega)
  have h34 : 𝔄 a3 a4 := adj_geo _ (i := 3) (by omega)
  have hda2α : (puAmalgam h.le).treeGraph.dist a2 α = critDist 𝔛 - 2 := by
    rw [dist_geo_right _ (by omega), hd']
  have hYQ4 : Y ≤ Qv 𝔛 a4 := by
    rw [hYdef]
    refine iSup₂_le fun p hp => ?_
    rw [map_conj_conjCl_zm h, (mem_stab _).mp hp.1, smul_smul]
    exact hB (p * t) (mul_mem hp.1 ht)
  have hYQ3 : Y ≤ Qv 𝔛 a3 := hYQ4.trans (qv_le_qv _ h20 ha4 h34.symm)
  have hYs2 : Y ≤ stab 𝔛 a2 := hYQ3.trans (qv_le_stab_of_adj _ h23.symm)
  have hHne : ⁅Y, ZM 𝔛 a2⁆ ≠ ⊥ := by
    intro hbot
    apply hY
    refine le_qv_of_le_centralizer _ hC ha2 h23 hYQ3 ?_
    rwa [← Subgroup.commutator_eq_bot_iff_le_centralizer]
  have hHU : ⁅Y, ZM 𝔛 a2⁆ ≤ Uloc h.le L a2 := by
    refine (Subgroup.commutator_mono hYQ3 le_rfl).trans ?_
    rw [Subgroup.commutator_comm]
    have e : ⁅ZM 𝔛 a2, Qv 𝔛 a3⁆ = Usup 𝔛 a2 a3 := by rw [Usup, zv_of_isMVtx _ ha2]
    rw [e]
    exact usup_le_uloc h hφ ha2 h23
  have hHe : ⁅Y, ZM 𝔛 a2⁆ = ⁅Uloc h.le L a2, Y⁆ := by
    rw [Subgroup.commutator_comm, commutator_zm_eq_uloc h hfull ha2 hYs2]
  have hcard : Fintype.card F ≤ Nat.card ↥⁅Y, ZM 𝔛 a2⁆ := by
    obtain ⟨d, -, hcd⟩ := S46.card_commutator_uloc_le h hφ ha2 h23 hYQ3
    rw [hHe, hcd]
    have hd1 : d ≠ 0 := by
      rintro rfl
      apply hHne
      rw [hHe, ← Subgroup.card_eq_one, hcd, pow_zero]
    calc Fintype.card F = Fintype.card F ^ 1 := (pow_one _).symm
      _ ≤ Fintype.card F ^ d :=
        Nat.pow_le_pow_right Fintype.card_pos (Nat.one_le_iff_ne_zero.mpr hd1)
  have hHc : ⁅Y, ZM 𝔛 a2⁆ ≤ Subgroup.centralizer (ZM 𝔛 α' : Set 𝔘) := by
    have h1 : ⁅Y, ZM 𝔛 a2⁆ ≤ ZM 𝔛 a2 := by
      rw [Subgroup.commutator_comm]
      exact Subgroup.le_normalizer_iff_commutator_le_left.mp
        (hYs2.trans (stab_le_normalizer_zm _ a2))
    have h2 : ZM 𝔛 a2 ≤ Qv 𝔛 α' := zm_le_qv_of_dist_lt _ ha2 (by
      rw [tdist_comm, dist_geo _ (by omega)]; omega)
    exact h1.trans (h2.trans (Subgroup.le_centralizer_iff.mp (zm_le_centralizer_qv _ h20 hα')))
  have hUn : Qv 𝔛 α ≤ Subgroup.normalizer (Usup 𝔛 α (t • β) : Set 𝔘) := by
    rw [Usup, zv_of_isMVtx _ hα]
    exact le_normalizer_commutator' ((qv_le_stab _ α).trans (stab_le_normalizer_zm _ α))
      ((qv_le_qv _ h20 hα htβ).trans Subgroup.le_normalizer)
  have hZa2α : ZM 𝔛 a2 ≤ Qv 𝔛 α := zm_le_qv_of_dist_lt _ ha2 (by rw [hda2α]; omega)
  have hHtβ : ⁅Y, ZM 𝔛 a2⁆ ≤ Usup 𝔛 α (t • β) := by
    rw [hYdef]
    refine commutator_iSup₂_le hUn (fun p hp => ?_) (fun p hp => ?_)
    all_goals
      have hpt : p * t ∈ stab 𝔛 α := mul_mem hp.1 ht
      have hptα : (p * t) • α = α := (mem_stab _).mp hpt
      have hW : (conjCl (stab 𝔛 (t • γ)) (ZM 𝔛 α)).map (MulAut.conj p).toMonoidHom =
          conjCl (stab 𝔛 ((p * t) • γ)) (ZM 𝔛 α) := by
        rw [map_conj_conjCl_zm h, (mem_stab _).mp hp.1, smul_smul]
      rw [hW]
      have hlamM : IsMVtx 𝔛 ((p * t) • γ) := (isMVtx_smul _ (p * t) γ).mpr hγM
      have hlamα : (puAmalgam h.le).treeGraph.dist ((p * t) • γ) α = 2 := by
        have e := dist_smul _ (p * t) γ α
        rw [hptα] at e
        rw [e, tdist_comm, dist_geo _ (by omega)]
    · have hZW : ZM 𝔛 α ≤ Vv 𝔛 ((p * t) • γ) := by
        have := zv_le_vv h (α := (p * t) • γ) (ρ := α) hlamα.le
        rwa [zv_of_isMVtx _ hα] at this
      exact (conjCl_le_of_le_normalizer hZW (stab_le_normalizer_vv h ((p * t) • γ))).trans
        (vv_le_qv_of_dist h hlamM (by omega))
    · have hρ : 𝔄 ((p * t) • γ) ((p * t) • β) := (adj_smul _ (p * t) γ β).mpr hβγ.symm
      have hαρ : 𝔄 α ((p * t) • β) := by
        have := (adj_smul _ (p * t) α β).mpr hαβ
        rwa [hptα] at this
      have hZlamV : ZM 𝔛 ((p * t) • γ) ≤ conjCl (stab 𝔛 α) (ZM 𝔛 γ) := by
        rw [zm_smul]
        exact map_conj_le_conjCl hpt
      have hZa2ρ : ZM 𝔛 a2 ≤ Qv 𝔛 ((p * t) • β) := by
        refine zm_le_qv_of_dist_lt _ ha2 ?_
        have := dist_triangle 𝔛 a2 α ((p * t) • β)
        rw [hda2α, dist_eq_one_of_adj _ hαρ] at this
        omega
      have hZa2c : ZM 𝔛 a2 ≤ Subgroup.centralizer (ZM 𝔛 ((p * t) • γ) : Set 𝔘) :=
        (zm_le_centralizer_qv _ h20 ha2).trans (Subgroup.centralizer_le (hZlamV.trans hA))
      have hZa2lam : ZM 𝔛 a2 ≤ Qv 𝔛 ((p * t) • γ) :=
        le_qv_of_le_centralizer _ hC hlamM hρ hZa2ρ hZa2c
      have h441lam : Concl441 h.le L α ((p * t) • γ) := by
        have := (concl441_smul h (p * t) α γ).mpr (h441 α α' hc)
        rwa [hptα] at this
      have hZαs : ZM 𝔛 α ≤ stab 𝔛 ((p * t) • γ) :=
        (zm_le_qv_of_dist_lt _ hα (by rw [dist_eq_one_of_adj _ hαρ]; omega)).trans
          (qv_le_stab_of_adj _ hρ.symm)
      have hD : ⁅conjCl (stab 𝔛 ((p * t) • γ)) (ZM 𝔛 α), ZM 𝔛 a2⁆ ≤
          Dloc h.le L ((p * t) • γ) := by
        by_cases hZD : ⁅ZM 𝔛 α, Qv 𝔛 ((p * t) • γ)⁆ ≤ Dloc h.le L ((p * t) • γ)
        · refine (Subgroup.commutator_mono le_rfl hZa2lam).trans ?_
          exact commutator_conjCl_le (stab_le_normalizer_dloc h _) (stab_le_normalizer_qv _ _)
            (hZαs.trans (stab_le_normalizer_dloc h _)) hZD
        · exact (Subgroup.commutator_mono le_rfl (le_inf hZa2α hZa2lam)).trans (h441lam hZD).1
      have hQ := commutator_conjCl_le_of_le_dloc h hfull hb hlamM hlamα hZa2lam hD
      have hU1 : ⁅ZM 𝔛 α, Qv 𝔛 ((p * t) • γ)⁆ ≤ Usup 𝔛 α ((p * t) • β) := by
        rw [Usup, zv_of_isMVtx _ hα]
        exact Subgroup.commutator_mono le_rfl (qv_le_qv _ h20 hlamM hρ)
      have hU2 : Usup 𝔛 α ((p * t) • β) = Usup 𝔛 α (t • β) := by
        calc Usup 𝔛 α ((p * t) • β) = Usup 𝔛 (p • α) (p • (t • β)) := by
              rw [(mem_stab _).mp hp.1, mul_smul]
          _ = (Usup 𝔛 α (t • β)).map (MulAut.conj p).toMonoidHom := usup_smul _ p α (t • β)
          _ = Usup 𝔛 α (t • β) := map_conj_eq_of_mem_normalizer hp.2
      exact hQ.trans (inf_le_left.trans (hU2 ▸ hU1))
  exact ⟨hHtβ, hHU, hHc, hcard⟩

theorem stab_le_normalizer (hC : CentHyp 𝔛) (hb : 4 < critDist 𝔛)
    (hV : ∀ δ δ' : Vtx 𝔛, IsCritical 𝔛 δ δ' → ¬ Vv 𝔛 δ ≤ Qv 𝔛 (geo 𝔛 δ' δ 2))
    (h441 : ∀ δ δ' : Vtx 𝔛, IsCritical 𝔛 δ δ' → Concl441 h.le L δ (geo 𝔛 δ δ' 2))
    {α α' : Vtx 𝔛} (hc : IsCritical 𝔛 α α')
    (hA : conjCl (stab 𝔛 α) (ZM 𝔛 (geo 𝔛 α α' 2)) ≤ Qv 𝔛 (geo 𝔛 α' α 2))
    (hB : ∀ g ∈ stab 𝔛 α, conjCl (stab 𝔛 (g • geo 𝔛 α α' 2)) (ZM 𝔛 α) ≤ Qv 𝔛 (geo 𝔛 α' α 4)) :
    stab 𝔛 α ≤ Subgroup.normalizer ((conjCl (stab 𝔛 (geo 𝔛 α α' 2)) (ZM 𝔛 α) ⊔
      conjCl (stab 𝔛 α) (ZM 𝔛 (geo 𝔛 α α' 2)) : Subgroup 𝔘) : Set 𝔘) := by
  by_contra hN
  have hfull : IsSL3Full M T L := isSL3Full_iff_exists_via.mpr ⟨F, _, _, φ, hφ⟩
  have h20 := h.hyp20
  have hb0 := h.critDist_pos
  have hα : IsMVtx 𝔛 α := hc.1
  have hα' : IsMVtx 𝔛 α' := hc.isMVtx_right _ h20
  have hc' : IsCritical 𝔛 α' α := ms22_iii _ h20 hb0 hC hc
  set β := geo 𝔛 α α' 1 with hβdef
  have hαβ : 𝔄 α β := adj_geo_one_of_isCritical _ hb0 hc
  have hZs : ZM 𝔛 α' ≤ stab 𝔛 α := zm_le_stab_of_isCritical _ h20 hb0 hc
  have hZ2 : IsPGroup 2 ↥(ZM 𝔛 α') :=
    (S46.isPGroup_qv_of_isMVtx h hα').to_le (zm_le_qv_self _ hα' hb0)
  obtain ⟨ψ, hψs, hψ⟩ := exists_natural_Uloc h hφ hα
  set C := Uloc h.le L α ⊓ Subgroup.centralizer (ZM 𝔛 α' : Set 𝔘) with hCdef
  have hRU : ⁅Uloc h.le L α, ZM 𝔛 α'⁆ ≤ Uloc h.le L α :=
    Subgroup.le_normalizer_iff_commutator_le_left.mp (hZs.trans (stab_le_normalizer_uloc h α))
  have hRZ : ⁅Uloc h.le L α, ZM 𝔛 α'⁆ ≤ ZM 𝔛 α' := by
    rw [Subgroup.commutator_comm]
    exact Subgroup.le_normalizer_iff_commutator_le_left.mp ((uloc_le_zm h hfull hα).trans
      ((zm_le_stab_of_isCritical _ h20 hb0 hc').trans (stab_le_normalizer_zm _ _)))
  have hZab : ZM 𝔛 α' ≤ Subgroup.centralizer (ZM 𝔛 α' : Set 𝔘) :=
    (zm_le_centralizer_qv _ h20 hα').trans (Subgroup.centralizer_le (zm_le_qv_self _ hα' hb0))
  have hRC : ⁅Uloc h.le L α, ZM 𝔛 α'⁆ ≤ C := le_inf hRU (hRZ.trans hZab)
  have hRe : ⁅ZM 𝔛 α, ZM 𝔛 α'⁆ = ⁅Uloc h.le L α, ZM 𝔛 α'⁆ := commutator_zm_eq_uloc h hfull hα hZs
  have hRne : ⁅Uloc h.le L α, ZM 𝔛 α'⁆ ≠ ⊥ := by
    rw [← hRe]
    exact ms22_ii _ h20 hb0 hC hc
  obtain ⟨u₀, hu₀, hu₀1⟩ := (Subgroup.bot_or_exists_ne_one _).resolve_left hRne
  set r := natVec hψ ⟨u₀, hRU hu₀⟩ with hrdef
  have hr0 : r ≠ 0 := by
    intro h0
    apply hu₀1
    have : (⟨u₀, hRU hu₀⟩ : ↥(Uloc h.le L α)) = 1 :=
      natVec_injective hψ (by rw [← hrdef, h0, natVec_one])
    exact congrArg Subtype.val this
  have hrC : r ∈ fixN (natImage ψ (ZM 𝔛 α')) :=
    (mem_centralizer_iff_natVec hψ hZs _).mp (hRC hu₀).2
  have hC2 : Module.finrank F (fixN (natImage ψ (ZM 𝔛 α'))) ≤ 2 := by
    have h3 := Submodule.finrank_le (fixN (natImage ψ (ZM 𝔛 α')))
    rw [Module.finrank_fin_fun] at h3
    by_contra hcon
    have htop : fixN (natImage ψ (ZM 𝔛 α')) = ⊤ :=
      Submodule.eq_top_of_finrank_eq (by rw [Module.finrank_fin_fun]; omega)
    exact hc'.2.2 (le_qv_of_fixN_eq_top h hφ hα hψ hZs htop)
  have hgam : ∀ K' : Submodule F (Fin 3 → F), Module.finrank F K' = 2 → r ∉ K' →
      ∃ t ∈ stab 𝔛 α, 𝔄 α (t • β) ∧ commN (natImage ψ (Qv 𝔛 (t • β))) = K' ∧
        ¬ ZM 𝔛 α' ≤ Subgroup.normalizer (Usup 𝔛 α (t • β) : Set 𝔘) := by
    intro K' hK' hrK'
    obtain ⟨ρ, hαρ, hρK⟩ := exists_adj_commN_eq h hφ hC hb hα hψs hψ hK'
    obtain ⟨t, htα, htβ⟩ := exists_smul_edge_of_isMVtx _ hα hαβ hα hαρ
    have htβ' : 𝔄 α (t • β) := by rw [htβ]; exact hαρ
    refine ⟨t, (mem_stab _).mpr htα, htβ', by rw [htβ]; exact hρK, fun hle => hrK' ?_⟩
    have hR := commutator_uloc_le_usup_of_le_normalizer h hφ hC hb hα htβ' hZs hZ2 hle
    rw [← hρK, ← htβ]
    exact (mem_usup_iff_natVec h hφ hα htβ' hψ _).mp (hR hu₀)
  have hprops := fun t (ht : t ∈ stab 𝔛 α)
      (hNt : ¬ ZM 𝔛 α' ≤ Subgroup.normalizer (Usup 𝔛 α (t • β) : Set 𝔘)) =>
    commutator_props h hφ hC hb h441 hc hA hB ht rfl
      (fun hle => hN (stab_le_normalizer_of_le_qv h hφ hC hb hV hc hA ht hNt hle))
  have hq : 1 < Fintype.card F := by
    rw [← Nat.card_eq_fintype_card]
    exact Finite.one_lt_card
  obtain ⟨K₁, hK₁, hrK₁⟩ := exists_plane_not_mem hr0
  obtain ⟨t₁, ht₁, htβ₁, hK₁e, hN₁⟩ := hgam K₁ hK₁ hrK₁
  obtain ⟨hH₁U, hH₁L, hH₁c, hq₁⟩ := hprops t₁ ht₁ hN₁
  set H₁ := ⁅conjCl (stab 𝔛 α ⊓ Subgroup.normalizer (Usup 𝔛 α (t₁ • β) : Set 𝔘))
    (conjCl (stab 𝔛 (t₁ • geo 𝔛 α α' 2)) (ZM 𝔛 α)), ZM 𝔛 (geo 𝔛 α' α 2)⁆ with hH₁def
  have hne₁ : H₁ ≠ ⊥ := by
    intro hbot
    rw [hbot, Subgroup.card_bot] at hq₁
    omega
  obtain ⟨u₁, hu₁, hu₁1⟩ := (Subgroup.bot_or_exists_ne_one _).resolve_left hne₁
  have hu₁U : u₁ ∈ Uloc h.le L α := usup_le_uloc h hφ hα htβ₁ (hH₁U hu₁)
  set c := natVec hψ ⟨u₁, hu₁U⟩ with hcdef
  have hc0 : c ≠ 0 := by
    intro h0
    apply hu₁1
    have : (⟨u₁, hu₁U⟩ : ↥(Uloc h.le L α)) = 1 :=
      natVec_injective hψ (by rw [← hcdef, h0, natVec_one])
    exact congrArg Subtype.val this
  have hcK₁ : c ∈ K₁ := by
    rw [← hK₁e]
    exact (mem_usup_iff_natVec h hφ hα htβ₁ hψ _).mp (hH₁U hu₁)
  have hcC : c ∈ fixN (natImage ψ (ZM 𝔛 α')) :=
    (mem_centralizer_iff_natVec hψ hZs _).mp (hH₁c hu₁)
  obtain ⟨K₂, hK₂, hrK₂, hcK₂⟩ := exists_plane_not_mem_two hr0 hc0
  obtain ⟨t₂, ht₂, htβ₂, hK₂e, hN₂⟩ := hgam K₂ hK₂ hrK₂
  obtain ⟨hH₂U, hH₂L, hH₂c, hq₂⟩ := hprops t₂ ht₂ hN₂
  set H₂ := ⁅conjCl (stab 𝔛 α ⊓ Subgroup.normalizer (Usup 𝔛 α (t₂ • β) : Set 𝔘))
    (conjCl (stab 𝔛 (t₂ • geo 𝔛 α α' 2)) (ZM 𝔛 α)), ZM 𝔛 (geo 𝔛 α' α 2)⁆ with hH₂def
  have hline : K₁ ⊓ fixN (natImage ψ (ZM 𝔛 α')) = Submodule.span F {c} := by
    symm
    refine Submodule.eq_of_le_of_finrank_le ?_ ?_
    · rw [Submodule.span_le, Set.singleton_subset_iff]
      exact ⟨hcK₁, hcC⟩
    · have hlt : K₁ ⊓ fixN (natImage ψ (ZM 𝔛 α')) < fixN (natImage ψ (ZM 𝔛 α')) :=
        lt_of_le_of_ne inf_le_right fun heq => hrK₁ (heq ▸ hrC).1
      have := Submodule.finrank_lt_finrank_of_lt hlt
      rw [finrank_span_singleton hc0]
      omega
  have hH₁₂ : H₁ ⊓ H₂ = ⊥ := by
    rw [eq_bot_iff]
    intro u ⟨hu1, hu2⟩
    have huU : u ∈ Uloc h.le L α := usup_le_uloc h hφ hα htβ₁ (hH₁U hu1)
    have hv1 : natVec hψ ⟨u, huU⟩ ∈ K₁ := by
      rw [← hK₁e]
      exact (mem_usup_iff_natVec h hφ hα htβ₁ hψ _).mp (hH₁U hu1)
    have hv2 : natVec hψ ⟨u, huU⟩ ∈ K₂ := by
      rw [← hK₂e]
      exact (mem_usup_iff_natVec h hφ hα htβ₂ hψ _).mp (hH₂U hu2)
    have hvC := (mem_centralizer_iff_natVec hψ hZs ⟨u, huU⟩).mp (hH₁c hu1)
    have hvl : natVec hψ ⟨u, huU⟩ ∈ Submodule.span F {c} := hline ▸ ⟨hv1, hvC⟩
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hvl
    have ha0 : a = 0 := by
      by_contra ha0
      apply hcK₂
      have : c = a⁻¹ • natVec hψ ⟨u, huU⟩ := by
        rw [← ha, smul_smul, inv_mul_cancel₀ ha0, one_smul]
      rw [this]
      exact K₂.smul_mem _ hv2
    have hv0 : natVec hψ ⟨u, huU⟩ = 0 := by rw [← ha, ha0, zero_smul]
    have : (⟨u, huU⟩ : ↥(Uloc h.le L α)) = 1 := natVec_injective hψ (by rw [hv0, natVec_one])
    exact (Subgroup.mem_bot).mpr (congrArg Subtype.val this)
  have hH₁₂C : H₁ ⊔ H₂ ≤ C :=
    sup_le (le_inf (fun u hu => usup_le_uloc h hφ hα htβ₁ (hH₁U hu)) hH₁c)
      (le_inf (fun u hu => usup_le_uloc h hφ hα htβ₂ (hH₂U hu)) hH₂c)
  have hfinU : Finite ↥(Uloc h.le L α) := Nat.finite_of_card_ne_zero (by
    rw [card_eq_of_natural hψ]; exact pow_ne_zero _ Nat.card_pos.ne')
  have hfin12 : Finite ↥(H₁ ⊔ H₂) :=
    Finite.of_injective _ (Subgroup.inclusion_injective (hH₁₂C.trans inf_le_left))
  have hlow : Fintype.card F ^ 2 ≤ Nat.card ↥(H₁ ⊔ H₂) := by
    rw [sq]
    exact (Nat.mul_le_mul hq₁ hq₂).trans (card_mul_card_le_card_sup hH₁₂)
  have hCq : Nat.card ↥C ≤ Fintype.card F ^ 2 := by
    rw [hCdef, S46.I464.card_inf_centralizer_eq_pow hψ hZs, Nat.card_eq_fintype_card]
    exact Nat.pow_le_pow_right (by omega) hC2
  have hfinC : Finite ↥C := Finite.of_injective _ (Subgroup.inclusion_injective
    (inf_le_left : C ≤ Uloc h.le L α))
  have hH₁₂eq : H₁ ⊔ H₂ = C := Subgroup.eq_of_le_of_card_ge hH₁₂C (hCq.trans hlow)
  have hRa2 : ⁅ZM 𝔛 α, ZM 𝔛 α'⁆ ≤ Uloc h.le L (geo 𝔛 α' α 2) := by
    rw [hRe]
    exact hRC.trans (hH₁₂eq.ge.trans (sup_le hH₁L hH₂L))
