variable {F : Type} [Field F]

theorem mat_mul_mulVec_qLine {l : Submodule F (MSP.V4 F)} (hl : MSP.IsLine l) {g g' : MSP.Sp4 F}
    (hg : g ∈ MSP.qLine l) (hg' : g' ∈ MSP.qLine l) (v : MSP.V4 F) :
    MSP.mat (g * g') *ᵥ v = v + (MSP.mat g *ᵥ v - v) + (MSP.mat g' *ᵥ v - v) := by
  have hw : MSP.mat g' *ᵥ v - v ∈ l := MSP.commSp_qLine_le hl (MSP.sub_mem_commSp hg' v)
  have h1 : MSP.mat g *ᵥ (MSP.mat g' *ᵥ v - v) = MSP.mat g' *ᵥ v - v := MSP.mem_fixer.1 hg _ hw
  rw [Matrix.mulVec_sub, sub_eq_iff_eq_add] at h1
  rw [MSP.mat_mul_mulVec, h1]
  abel

theorem qLine_mul_comm {l : Submodule F (MSP.V4 F)} (hl : MSP.IsLine l) {g g' : MSP.Sp4 F}
    (hg : g ∈ MSP.qLine l) (hg' : g' ∈ MSP.qLine l) : g * g' = g' * g :=
  MSP.ext_mulVec fun v => by
    rw [mat_mul_mulVec_qLine hl hg hg' v, mat_mul_mulVec_qLine hl hg' hg v]
    abel

theorem qLine_sq [CharP F 2] {l : Submodule F (MSP.V4 F)} (hl : MSP.IsLine l) {g : MSP.Sp4 F}
    (hg : g ∈ MSP.qLine l) : g ^ 2 = 1 :=
  MSP.ext_mulVec fun v => by
    have h2 : (2 : F) = 0 := CharTwo.two_eq_zero
    rw [pow_two, mat_mul_mulVec_qLine hl hg hg v, MSP.mat_one, Matrix.one_mulVec, add_assoc,
      ← two_smul F, h2, zero_smul, add_zero]

end QLine

variable {G : Type} [Group G] [Finite G] {M T L : Subgroup G}
  {k : ℕ} {F : Type} [Field F] [Fintype F] {a : ↥M →* ↥(StatedSp 2 F)}

theorem mem_qv_of_le_vPre_qLine (h : PUHyp M T L) (hd : S5.IsSp4Data M T L k F a)
    {l : Submodule F (MSP.V4 F)} (hl : MSP.IsLine l) {E : Subgroup (puAmalgam h.le).Universal}
    (hE2 : IsPGroup 2 E) (hEl : E ≤ S5.vPre h.le a (MSP.qLine l)) :
    (∀ x ∈ E, ∀ y ∈ E, x * y * x⁻¹ * y⁻¹ ∈ Qv _ (baseA (puAmalgam h.le))) ∧
      ∀ x ∈ E, x ^ 2 ∈ Qv _ (baseA (puAmalgam h.le)) := by
  have : CharP F 2 := S5B.charP_two_of_card hd.2.1
  have hmem : ∀ {t : ↥M}, (puAmalgam h.le).ofA t ∈ E → a t = 1 →
      (puAmalgam h.le).ofA t ∈ Qv _ (baseA (puAmalgam h.le)) := by
    intro t htE ht
    obtain ⟨n, hn⟩ := hE2 ⟨_, htE⟩
    have h1 : (puAmalgam h.le).ofA (t ^ 2 ^ n) = (puAmalgam h.le).ofA 1 := by
      rw [map_pow, map_one]
      simpa using congrArg Subtype.val hn
    have h2 := congrArg Subtype.val ((puAmalgam h.le).ofA_injective h1)
    have hp := hd.mem_pCoreOf_of_mem_kerG h ((S5.mem_kerG a).2 ⟨t.2, ht⟩) ⟨n, by simpa using h2⟩
    rw [S5.qv_baseA_eq h]
    exact ⟨t, Subgroup.mem_subgroupOf.2 hp, rfl⟩
  refine ⟨fun x hx y hy => ?_, fun x hx => ?_⟩
  · obtain ⟨mx, hmx, rfl⟩ := Subgroup.mem_map.1 (hEl hx)
    obtain ⟨my, hmy, rfl⟩ := Subgroup.mem_map.1 (hEl hy)
    have hE : (puAmalgam h.le).ofA (mx * my * mx⁻¹ * my⁻¹) ∈ E := by
      rw [map_mul, map_mul, map_mul, map_inv, map_inv]
      exact mul_mem (mul_mem (mul_mem hx hy) (inv_mem hx)) (inv_mem hy)
    have ha : a (mx * my * mx⁻¹ * my⁻¹) = 1 := by
      rw [map_mul, map_mul, map_mul, map_inv, map_inv,
        qLine_mul_comm hl (Subgroup.mem_comap.1 hmx) (Subgroup.mem_comap.1 hmy)]
      group
    have := hmem hE ha
    rwa [map_mul, map_mul, map_mul, map_inv, map_inv] at this
  · obtain ⟨mx, hmx, rfl⟩ := Subgroup.mem_map.1 (hEl hx)
    have hE : (puAmalgam h.le).ofA (mx ^ 2) ∈ E := by
      rw [map_pow]
      exact pow_mem hx 2
    have := hmem hE (by rw [map_pow]; exact qLine_sq hl (Subgroup.mem_comap.1 hmx))
    rwa [map_pow] at this

theorem le_xm_of_le_stabCenter (h : PUHyp M T L) {δ : Vtx (puAmalgam h.le)}
    {K : Subgroup (puAmalgam h.le).Universal} (hKZ : K ≤ stabCenter _ δ) (hKQ : K ≤ Qv _ δ)
    (hK2 : ∀ x ∈ K, x ^ 2 = 1) : K ≤ XM _ δ := by
  intro x hx
  have hxC : x ∈ Subgroup.centralizer (Qv (puAmalgam h.le) δ : Set (puAmalgam h.le).Universal) :=
    Subgroup.mem_centralizer_iff.2 fun y hy =>
      S510.commute_of_mem_stabCenter (hKZ hx) (qv_le_stab _ δ hy)
  exact Subgroup.subset_closure ⟨⟨hKQ hx, hxC⟩, hK2 x hx⟩

theorem le_of_le_sup_stabCenter (h : PUHyp M T L) {α' ε : Vtx (puAmalgam h.le)}
    (hα' : IsMVtx _ α') (hεα' : (puAmalgam h.le).treeGraph.Adj ε α')
    {R R₁ K : Subgroup (puAmalgam h.le).Universal} (hRst : R ≤ stab _ α') (hRX : R ≤ XM _ α')
    (hR1 : R₁ ≤ R ⊔ stabCenter _ α') (hR₁X : R₁ ≤ XM _ α') (hRK : R ≤ K)
    (hεK : ZH _ ε ≤ K) : R₁ ≤ K := by
  intro r₁ hr₁
  have h1 := hR1 hr₁
  have hZn : stabCenter _ α' ≤ Subgroup.normalizer (R : Set (puAmalgam h.le).Universal) :=
    (S5B.stabCenter_le_inf α').trans (inf_le_right.trans ((Subgroup.centralizer_le hRst).trans
      (Subgroup.centralizer_le_normalizer _)))
  rw [← SetLike.mem_coe, Subgroup.coe_mul_of_right_le_normalizer_left _ _ hZn] at h1
  obtain ⟨r, hr, z, hz, rfl⟩ := h1
  have hzX : z ∈ XM _ α' := by
    have e : z = r⁻¹ * (r * z) := by group
    rw [e]
    exact mul_mem (inv_mem (hRX hr)) (hR₁X hr₁)
  exact mul_mem (hRK hr) (hεK (S5B.stabCenter_inf_xm_le_zh h hα' hεα'.symm ⟨hz, hzX⟩))

theorem commutator_eq_bot_of_le_stabCenter (h : PUHyp M T L)
    (hd : S5.IsSp4Data M T L k F a) {δ : Vtx (puAmalgam h.le)} (hδM : IsMVtx _ δ)
    (hdδ : (puAmalgam h.le).treeGraph.dist (baseA _) δ = 2)
    {y : (puAmalgam h.le).Universal} (hy : y ∈ stab _ (baseA (puAmalgam h.le)))
    {A : Subgroup (puAmalgam h.le).Universal} (hAQ : A ≤ Qv _ (baseA (puAmalgam h.le)))
    (hZα : ⁅S5.uSub h.le L (y • δ) ⊓ Qv _ δ, A⁆ ≤ stabCenter _ (baseA (puAmalgam h.le)))
    (hZδ : ⁅S5.uSub h.le L (y • δ) ⊓ Qv _ δ, A⁆ ≤ stabCenter _ δ) :
    ⁅S5.uSub h.le L (y • δ) ⊓ Qv _ δ, A⁆ = ⊥ := by
  have hyα : y • baseA (puAmalgam h.le) = baseA _ := (mem_stab _).1 hy
  have hμM : IsMVtx _ (y • δ) := (isMVtx_smul _ y _).2 hδM
  have hdμ : (puAmalgam h.le).treeGraph.dist (baseA _) (y • δ) = 2 := by
    have := dist_smul _ y (baseA (puAmalgam h.le)) δ
    rw [hyα] at this
    rw [this, hdδ]
  have hQαμ : Qv _ (baseA (puAmalgam h.le)) ≤ stab _ (y • δ) :=
    qv_le_stab_of_dist_le_two _ h.hyp20 (isMVtx_baseA _) hdμ.le
  have hZμ : ⁅S5.uSub h.le L (y • δ) ⊓ Qv _ δ, A⁆ ≤ stabCenter _ (y • δ) := by
    intro r hr
    rw [S510.stabCenter_smul, PU.mem_map_conj]
    have hc1 : y⁻¹ * r * y = r := by
      have := S5C56.mul_comm_of_mem_stabCenter (hZα hr) hy
      calc y⁻¹ * r * y = y⁻¹ * (r * y) := by group
        _ = y⁻¹ * (y * r) := by rw [this]
        _ = r := by group
    rw [hc1]
    exact hZδ hr
  rw [eq_bot_iff, Subgroup.commutator_le]
  intro u hu a' ha'
  have hc1 : ⁅u, a'⁆ ∈ ⁅S5.uSub h.le L (y • δ) ⊓ Qv _ δ, A⁆ :=
    Subgroup.commutator_mem_commutator hu ha'
  have hmem1 : a' * u * a'⁻¹ * u⁻¹ ∈ Subgroup.centralizer
      (puTrans h.le L (y • δ) : Set (puAmalgam h.le).Universal) := by
    have e : a' * u * a'⁻¹ * u⁻¹ = ⁅u, a'⁆⁻¹ := by rw [commutatorElement_def]; group
    rw [e]
    refine inv_mem (Subgroup.mem_centralizer_iff.2 fun x hx => ?_)
    exact S510.commute_of_mem_stabCenter (hZμ hc1) (puTrans_le_stab h.le L _ hx)
  have h1 := S5B.lift_at h hd hμM (hQαμ (hAQ ha')) hu.1 hmem1
  have h2 : u * a' = a' * u := by
    calc u * a' = (a' * u * a'⁻¹) * a' := by rw [h1]
      _ = a' * u := by group
  rw [Subgroup.mem_bot, commutatorElement_def, h2]
  group

theorem normalizer_of_pair (h32 : S32) (hX2 : S33.S33X52) (h : PUHyp M T L)
    (hb4 : critDist (puAmalgam h.le) = 4) (hd : S5.IsSp4Data M T L k F a)
    {c : Vtx (puAmalgam h.le)} (hc : IsCritical _ (baseA (puAmalgam h.le)) c)
    (hβ : geo _ (baseA (puAmalgam h.le)) c 1 = baseB _) {l : Submodule F (MSP.V4 F)}
    (hl : S5.Case56 h (2 ^ k) a (geo _ (baseA (puAmalgam h.le)) c 2) l)
    (hR : critR _ (baseA (puAmalgam h.le)) c ≤
      stabCenter _ (geo _ (baseA (puAmalgam h.le)) c 2))
    (hcent : Xq M = Uq M T L ⊔ Zq M L →
      ZM _ (baseA (puAmalgam h.le)) ⊓ ZM _ (geo _ (baseA (puAmalgam h.le)) c 2) ⊓ ZM _ c ≤
        stabCenter _ (geo _ (baseA (puAmalgam h.le)) c 2))
    {y : (puAmalgam h.le).Universal} (hy : y ∈ stab _ (baseA (puAmalgam h.le)))
    (hZy : Xq M = Uq M T L ⊔ Zq M L →
      ZM _ (y • geo _ (baseA (puAmalgam h.le)) c 2) ⊓ ZM _ (baseA (puAmalgam h.le)) ⊓
        ZM _ (geo _ (baseA (puAmalgam h.le)) c 2) ≤ stabCenter _ (baseA (puAmalgam h.le))) :
    S5.zHat _ (baseA (puAmalgam h.le)) c ≤ Subgroup.normalizer
      (((S5.uSub h.le L (y • geo _ (baseA (puAmalgam h.le)) c 2) ⊓
        Qv _ (geo _ (baseA (puAmalgam h.le)) c 2)) ⊔ XM _ (baseA (puAmalgam h.le)) :
          Subgroup _) : Set _) := by
  have hyp := h.hyp20
  have hb0 := h.critDist_pos
  have hb : 2 < critDist (puAmalgam h.le) := by omega
  have hα : IsMVtx _ (baseA (puAmalgam h.le)) := isMVtx_baseA _
  have hcM : IsMVtx _ c := hc.isMVtx_right _ hyp
  have hd4 : (puAmalgam h.le).treeGraph.dist (baseA _) c = 4 := hc.2.1.trans hb4
  set δ := geo _ (baseA (puAmalgam h.le)) c 2 with hδ
  have hβδ : (puAmalgam h.le).treeGraph.Adj (baseB _) δ := by
    have := adj_geo _ (u := baseA (puAmalgam h.le)) (w := c) (i := 1) (by omega)
    rwa [hβ] at this
  have hδM : IsMVtx _ δ := isMVtx_geo_two _ hyp hb0 hc
  have hdδ : (puAmalgam h.le).treeGraph.dist (baseA _) δ = 2 := dist_geo _ (by omega)
  have hdδc : (puAmalgam h.le).treeGraph.dist δ c = 2 := by
    rw [dist_geo_right _ (by omega), hd4]
  have hgδ : geo _ c (baseA (puAmalgam h.le)) 2 = δ := by
    have := geo_symm _ (show 2 ≤ (puAmalgam h.le).treeGraph.dist (baseA _) c by omega)
    rwa [hd4] at this
  have hdc : 0 < (puAmalgam h.le).treeGraph.dist c (baseA _) := by
    rw [SimpleGraph.dist_comm]; omega
  set ε := geo _ c (baseA (puAmalgam h.le)) 1 with hε
  have hcε : (puAmalgam h.le).treeGraph.Adj c ε := adj_geo_one _ hdc
  have hεδ : (puAmalgam h.le).treeGraph.Adj ε δ := by
    have := adj_geo _ (u := c) (w := baseA (puAmalgam h.le)) (i := 1)
      (by rw [SimpleGraph.dist_comm]; omega)
    rwa [hgδ] at this
  have hyα : y • baseA (puAmalgam h.le) = baseA _ := (mem_stab _).1 hy
  have hμM : IsMVtx _ (y • δ) := (isMVtx_smul _ y _).2 hδM
  have hdμ : (puAmalgam h.le).treeGraph.dist (baseA _) (y • δ) = 2 := by
    have := dist_smul _ y (baseA (puAmalgam h.le)) δ
    rw [hyα] at this
    rw [this, hdδ]
  set Y := S5.uSub h.le L (y • δ) ⊓ Qv _ δ with hY
  have hYZ : Y ≤ ZM _ (y • δ) := inf_le_left.trans (S5B.uSub_le_zm h.le _)
  have hZμQ : ZM _ (y • δ) ≤ Qv _ (baseA (puAmalgam h.le)) :=
    zm_le_qv_of_dist_lt _ hμM (by rw [SimpleGraph.dist_comm, hdμ]; omega)
  have hQαμ : Qv _ (baseA (puAmalgam h.le)) ≤ stab _ (y • δ) :=
    qv_le_stab_of_dist_le_two _ hyp hα hdμ.le
  have hAQ : critA _ (baseA (puAmalgam h.le)) c ≤ Qv _ (baseA (puAmalgam h.le)) := inf_le_right
  have hAZ : ⁅critA _ (baseA (puAmalgam h.le)) c, Y⁆ ≤ ZM _ (y • δ) := by
    rw [Subgroup.commutator_comm]
    exact (Subgroup.commutator_mono hYZ le_rfl).trans (commutator_le_left_of_le_normalizer
      ((hAQ.trans hQαμ).trans (stab_le_normalizer_zm _ _)))
  have hZQX : ⁅ZM _ (y • δ), Qv _ (baseA (puAmalgam h.le))⁆ ≤ XM _ (baseA (puAmalgam h.le)) :=
    S512F.commutator_zm_smul_qv_le_xm h hb hd hβδ hl hy
  have hAY : ⁅critA _ (baseA (puAmalgam h.le)) c, Y⁆ ≤ XM _ (baseA (puAmalgam h.le)) := by
    rw [Subgroup.commutator_comm]
    exact (Subgroup.commutator_mono hYZ hAQ).trans hZQX
  have hZab : ⁅ZM (puAmalgam h.le) (y • δ), ZM (puAmalgam h.le) (y • δ)⁆ = ⊥ := by
    have hab := (isElemAbelian_zm _ hyp hb0 hμM).1
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
    intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    have := hab.is_comm.comm ⟨w, hw⟩ ⟨x, hx⟩
    simpa using congrArg Subtype.val this
  have hZαc : ZM _ (baseA (puAmalgam h.le)) ≤ stab _ c :=
    (S512T.zm_facts h hb4 (ms22_iii _ hyp hb0 h.centHyp hc)).2.1
  have hRZc : critR _ (baseA (puAmalgam h.le)) c ≤ ZM _ c := by
    rw [critR, Subgroup.commutator_comm]
    exact commutator_le_left_of_le_normalizer (hZαc.trans (stab_le_normalizer_zm _ _))
  have hZcδ : ZM _ c ≤ Qv _ δ := zm_le_qv_of_dist_lt _ hcM (by rw [SimpleGraph.dist_comm]; omega)
  have hRK : critR _ (baseA (puAmalgam h.le)) c ≤ ZM _ δ ⊓ ZM _ c := by
    have hRX : critR _ (baseA (puAmalgam h.le)) c ≤ XM _ δ :=
      le_xm_of_le_stabCenter h hR (hRZc.trans hZcδ)
        (fun x hx => (isElemAbelian_zm _ hyp hb0 hcM).2 x (hRZc hx))
    exact (le_inf hR hRX).trans ((S5B.stabCenter_inf_xm_le_zh h hδM hεδ.symm).trans
      (le_inf (zh_le_zm _ hεδ.symm) (zh_le_zm _ hcε)))
  have hcomm : ⁅Y, S5.zHat _ (baseA (puAmalgam h.le)) c⁆ ≤ XM _ (baseA (puAmalgam h.le)) := by
    refine commutator_zHat_le_xm h32 hX2 h hd hc ?_ ?_ ?_ hAY ?_ ?_
    · exact inf_le_right.trans (qv_le_qv _ hyp hδM hεδ.symm)
    · intro x hx
      rw [Subgroup.mem_centralizer_iff]
      intro r hr
      exact (S510.commute_of_mem_stabCenter (hR hr) (qv_le_stab _ δ hx.2)).symm
    · exact (hYZ.trans hZμQ).trans (qv_le_centralizer_xm _ _)
    · rw [← le_bot_iff, ← hZab]
      exact Subgroup.commutator_mono hAZ hYZ
    · intro hidx hXU hcard hle
      have hZc := S5Q2.UC.zq_le_centralizer_of_relIndex_eq h hd hc hidx
      have hXZ := S5B.xm_eq_zm h hXU hZc
      have hR₁Zμ : ⁅Y, critA _ (baseA (puAmalgam h.le)) c⁆ ≤ ZM _ (y • δ) := by
        rw [Subgroup.commutator_comm]
        exact hAZ
      have hR₁A : ⁅Y, critA _ (baseA (puAmalgam h.le)) c⁆ ≤ ZM _ (baseA (puAmalgam h.le)) := by
        rw [← hXZ]
        exact (Subgroup.commutator_mono hYZ hAQ).trans hZQX
      have hR₁X : ⁅Y, critA _ (baseA (puAmalgam h.le)) c⁆ ≤ XM _ c := by
        rw [Subgroup.commutator_comm]
        exact (Subgroup.commutator_mono inf_le_left le_rfl).trans
          (commutator_le_left_of_le_normalizer ((inf_le_right.trans
            (qv_le_stab_of_dist_le_two _ hyp hδM hdδc.le)).trans (stab_le_normalizer_xm _ _)))
      have hR₁K := le_of_le_sup_stabCenter h hcM hcε.symm
        (hRZc.trans ((zm_le_qv_self _ hcM hb0).trans (qv_le_stab _ _)))
        (hRZc.trans (zm_le_xm _ hyp hb0 hcM)) hle hR₁X hRK
        (le_inf (zh_le_zm _ hεδ.symm) (zh_le_zm _ hcε))
      have hR₁ZA : ⁅Y, critA _ (baseA (puAmalgam h.le)) c⁆ ≤
          stabCenter _ (baseA (puAmalgam h.le)) :=
        (le_inf (le_inf hR₁Zμ hR₁A) (hR₁K.trans inf_le_left)).trans (hZy hXU)
      have hR₁Zδ : ⁅Y, critA _ (baseA (puAmalgam h.le)) c⁆ ≤ stabCenter _ δ :=
        (le_inf (le_inf hR₁A (hR₁K.trans inf_le_left)) (hR₁K.trans inf_le_right)).trans
          (hcent hXU)
      have hbot := commutator_eq_bot_of_le_stabCenter h hd hδM hdδ hy hAQ hR₁ZA hR₁Zδ
      rw [hbot, Subgroup.card_bot] at hcard
      exact absurd hcard (Nat.one_lt_two_pow (by have := hd.1; omega)).ne
  exact le_normalizer_sup_of_commutator_le
    ((S5B.crit_facts h hc).2.2.1.trans (stab_le_normalizer_xm _ _)) hcomm

theorem commutator_nclStab_le (h : PUHyp M T L) (hb4 : critDist (puAmalgam h.le) = 4)
    (hd : S5.IsSp4Data M T L k F a) {δ m : Vtx (puAmalgam h.le)}
    (hβδ : (puAmalgam h.le).treeGraph.Adj (baseB _) δ) (hcm : IsCritical _ m δ)
    (hmid : geo _ m δ 2 = baseA _) (hqm : (Qv _ δ).relIndex (ZM _ m) = 2 ^ k)
    (hD0 : S5.uSub h.le L δ ⊓ Subgroup.centralizer (ZM _ m : Set (puAmalgam h.le).Universal) ≤
      S5.bSub h.le L (baseA _))
    (hR4 : ⁅ZM (puAmalgam h.le) m, ZM (puAmalgam h.le) δ⁆ ≤
      stabCenter _ (baseA (puAmalgam h.le)))
    {v t : (puAmalgam h.le).Universal}
    (hv : v ∈ S5.nclStab _ (baseA (puAmalgam h.le)) (ZM _ δ))
    (ht : t ∈ Qv _ (baseA (puAmalgam h.le)) ⊓ Subgroup.centralizer
      ((ZM _ δ ⊓ S5.bSub h.le L (baseA _) : Subgroup _) : Set (puAmalgam h.le).Universal)) :
    ⁅v, t⁆ ∈ ⁅ZM (puAmalgam h.le) m, ZM (puAmalgam h.le) δ⁆ := by
  have hyp := h.hyp20
  have hb0 := h.critDist_pos
  have hb : 2 < critDist (puAmalgam h.le) := by omega
  have hα : IsMVtx _ (baseA (puAmalgam h.le)) := isMVtx_baseA _
  have hδM : IsMVtx _ δ := (isMVtx_iff_of_adj _ hβδ.symm).2 (not_isMVtx_baseB _)
  have hdδ : (puAmalgam h.le).treeGraph.dist (baseA _) δ ≤ 2 := by
    have := dist_triangle _ (baseA (puAmalgam h.le)) (baseB _) δ
    rwa [dist_eq_one_of_adj _ (adj_baseA_baseB _), dist_eq_one_of_adj _ hβδ] at this
  have hcδm : IsCritical _ δ m := ms22_iii _ hyp hb0 h.centHyp hcm
  set R := ⁅ZM (puAmalgam h.le) m, ZM (puAmalgam h.le) δ⁆ with hR
  set T₀ := Qv _ (baseA (puAmalgam h.le)) ⊓ Subgroup.centralizer
    ((ZM _ δ ⊓ S5.bSub h.le L (baseA _) : Subgroup _) : Set (puAmalgam h.le).Universal) with hT₀
  have hRc : ∀ {g r : (puAmalgam h.le).Universal}, g ∈ stab _ (baseA (puAmalgam h.le)) → r ∈ R →
      g * r * g⁻¹ = r := fun hg hr => by
    rw [S510.commute_of_mem_stabCenter (hR4 hr) hg, mul_inv_cancel_right]
  have hTB : ∀ {t' x : (puAmalgam h.le).Universal}, t' ∈ Qv _ (baseB (puAmalgam h.le)) →
      x ∈ T₀ → t' * x * t'⁻¹ ∈ T₀ := by
    intro t' x ht' hx
    have ht'A : t' ∈ stab _ (baseA (puAmalgam h.le)) :=
      qv_le_stab_of_adj _ (adj_baseA_baseB _).symm ht'
    have ht'δ : t' ∈ stab _ δ := qv_le_stab_of_adj _ hβδ ht'
    refine ⟨(Subgroup.mem_normalizer_iff.1 (stab_le_normalizer_qv _ _ ht'A) x).1 hx.1,
      Subgroup.mem_centralizer_iff.2 fun b hb => ?_⟩
    have hb' : t'⁻¹ * b * t'⁻¹⁻¹ ∈ ZM _ δ ⊓ S5.bSub h.le L (baseA _) :=
      ⟨(Subgroup.mem_normalizer_iff.1 (stab_le_normalizer_zm _ _ (inv_mem ht'δ)) b).1 hb.1,
        (Subgroup.mem_normalizer_iff.1 (S310.stab_le_normalizer_bSub h _ (inv_mem ht'A)) b).1
          hb.2⟩
    have h1 := Subgroup.mem_centralizer_iff.1 hx.2 _ hb'
    calc b * (t' * x * t'⁻¹) = t' * ((t'⁻¹ * b * t'⁻¹⁻¹) * x) * t'⁻¹ := by group
      _ = t' * (x * (t'⁻¹ * b * t'⁻¹⁻¹)) * t'⁻¹ := by rw [h1]
      _ = t' * x * t'⁻¹ * b := by group
  have hLt : ∀ {l x : (puAmalgam h.le).Universal}, l ∈ puTrans h.le L (baseA _) →
      x ∈ T₀ → l * x * l⁻¹ ∈ T₀ := by
    intro l x hl hx
    have hlA : l ∈ stab _ (baseA (puAmalgam h.le)) := puTrans_le_stab h.le L _ hl
    refine ⟨(Subgroup.mem_normalizer_iff.1 (stab_le_normalizer_qv _ _ hlA) x).1 hx.1,
      Subgroup.mem_centralizer_iff.2 fun b hbB => ?_⟩
    have hc : ⁅b⁻¹, l⁻¹⁆ ∈ ZM _ (baseA (puAmalgam h.le)) :=
      S310.commutator_mem_zm_of_mem_bSub h hb (inv_mem hbB.2) (inv_mem hl)
    have hxc : ⁅b⁻¹, l⁻¹⁆ * x = x * ⁅b⁻¹, l⁻¹⁆ :=
      (Subgroup.mem_centralizer_iff.1 (zm_le_centralizer_qv _ hyp hα hc) x hx.1).symm
    have hxb : b * x = x * b := Subgroup.mem_centralizer_iff.1 hx.2 b hbB
    have e1 : l⁻¹ * b * l = b * ⁅b⁻¹, l⁻¹⁆ := by
      rw [commutatorElement_def]; group
    have h1 : (l⁻¹ * b * l) * x = x * (l⁻¹ * b * l) := by
      rw [e1, mul_assoc, hxc, ← mul_assoc, hxb, mul_assoc]
    calc b * (l * x * l⁻¹) = l * ((l⁻¹ * b * l) * x) * l⁻¹ := by group
      _ = l * (x * (l⁻¹ * b * l)) * l⁻¹ := by rw [h1]
      _ = l * x * l⁻¹ * b := by group
  have hT0n : ∀ {g x : (puAmalgam h.le).Universal}, g ∈ stab _ (baseA (puAmalgam h.le)) →
      x ∈ T₀ → g * x * g⁻¹ ∈ T₀ := by
    intro g x hg hx
    obtain ⟨l, hl, t', ht', rfl⟩ := S310.exists_mul_of_mem_stab h (adj_baseA_baseB _) hg
    have e : l * t' * x * (l * t')⁻¹ = l * (t' * x * t'⁻¹) * l⁻¹ := by group
    rw [e]
    exact hLt hl (hTB ht' hx)
  obtain ⟨-, hZmδ, hZm2, -⟩ := S512T.zm_facts h hb4 hcδm
  have hgeo1 : geo _ δ m 1 = baseB _ := by
    have hmid' : geo _ δ m 2 = baseA _ := by
      obtain ⟨-, -, -, hd4', -⟩ := S512T.pair_facts h hb4 hcm
      have := geo_symm _ (show 2 ≤ (puAmalgam h.le).treeGraph.dist m δ by omega)
      rw [hd4', hmid] at this
      exact this
    exact (S512T.eq_geo_one_of_adj h hb4 hcδm hmid' (adj_baseA_baseB _) hβδ).symm
  have hZmB : ZM _ m ≤ Qv _ (baseB (puAmalgam h.le)) := by
    have := (S512T.zm_facts h hb4 hcδm).1
    rwa [hgeo1] at this
  have hu : (Subgroup.centralizer (ZM _ m : Set (puAmalgam h.le).Universal)).relIndex
      (S5.uSub h.le L δ) = 2 ^ k := by
    rw [← S512T.relIndex_qv_zm_eq h hb4 hcδm]
    exact le_antisymm (S512T.relIndex_qv_zm_symm h hb4 hd hcm hqm.le)
      (S512T.le_relIndex_qv_zm h hb4 hd hcδm)
  have hT0Z : ∀ {x z : (puAmalgam h.le).Universal}, x ∈ T₀ → z ∈ ZM _ δ → ⁅z, x⁆ ∈ R := by
    intro x z hx hz
    have hxδ : x ∈ stab _ δ := qv_le_stab_of_dist_le_two _ hyp hα hdδ hx.1
    have htc : ∀ u ∈ S5.uSub h.le L δ ⊓ Subgroup.centralizer (ZM _ m : Set _),
        x * u * x⁻¹ = u := by
      intro u hu'
      have hub : u ∈ ZM _ δ ⊓ S5.bSub h.le L (baseA _) :=
        ⟨S5B.uSub_le_zm h.le δ hu'.1, hD0 hu'⟩
      rw [← Subgroup.mem_centralizer_iff.1 hx.2 u hub, mul_inv_cancel_right]
    obtain ⟨e, he, hconj⟩ := exists_mem_conj_eq h hd hδM hZmδ hZm2 hqm hu hxδ htc
    have hxB : x ∈ Qv _ (baseB (puAmalgam h.le)) := qv_le_qv _ hyp hα (adj_baseA_baseB _) hx.1
    have hle : ZM _ δ ≤ (MulAut.conj x).toMonoidHom.eqLocus (MulAut.conj e).toMonoidHom := by
      rw [S5B.zm_eq_zh_sup_uSub h hδM hβδ.symm]
      refine sup_le (fun z' hz' => ?_) (fun u hu' => ?_)
      · have h1 := Subgroup.mem_centralizer_iff.1 (zh_le_centralizer _ _ hz') x hxB
        have h2 := Subgroup.mem_centralizer_iff.1 (zh_le_centralizer _ _ hz') e (hZmB he)
        change x * z' * x⁻¹ = e * z' * e⁻¹
        rw [h1, h2, mul_inv_cancel_right, mul_inv_cancel_right]
      · exact hconj u hu'
    have h1 : x * z⁻¹ * x⁻¹ = e * z⁻¹ * e⁻¹ := hle (inv_mem hz)
    have h2 : ⁅z, x⁆ = ⁅z, e⁆ := by
      calc ⁅z, x⁆ = z * (x * z⁻¹ * x⁻¹) := by rw [commutatorElement_def]; group
        _ = z * (e * z⁻¹ * e⁻¹) := by rw [h1]
        _ = ⁅z, e⁆ := by rw [commutatorElement_def]; group
    rw [h2, hR, Subgroup.commutator_comm]
    exact Subgroup.commutator_mem_commutator hz he
  let S : Subgroup (puAmalgam h.le).Universal :=
    { carrier := {w | w ∈ stab _ (baseA (puAmalgam h.le)) ∧ ∀ x ∈ T₀, ⁅w, x⁆ ∈ R}
      one_mem' := ⟨one_mem _, fun x _ => by
        rw [commutatorElement_def, one_mul, inv_one, mul_one, mul_inv_cancel]
        exact one_mem _⟩
      mul_mem' := by
        rintro w₁ w₂ ⟨h₁, k₁⟩ ⟨h₂, k₂⟩
        refine ⟨mul_mem h₁ h₂, fun x hx => ?_⟩
        have e : ⁅w₁ * w₂, x⁆ = (w₁ * ⁅w₂, x⁆ * w₁⁻¹) * ⁅w₁, x⁆ := by
          simp only [commutatorElement_def]; group
        rw [e, hRc h₁ (k₂ x hx)]
        exact mul_mem (k₂ x hx) (k₁ x hx)
      inv_mem' := by
        rintro w ⟨hw, kw⟩
        refine ⟨inv_mem hw, fun x hx => ?_⟩
        have e : ⁅w⁻¹, x⁆ = w⁻¹ * ⁅w, x⁆⁻¹ * w⁻¹⁻¹ := by
          simp only [commutatorElement_def]; group
        rw [e, hRc (inv_mem hw) (inv_mem (kw x hx))]
        exact inv_mem (kw x hx) }
  have hVS : S5.nclStab _ (baseA (puAmalgam h.le)) (ZM _ δ) ≤ S := by
    refine iSup_le fun g => ?_
    rintro _ ⟨z, hz, rfl⟩
    have hg := g.2
    refine ⟨mul_mem (mul_mem hg ((zm_le_qv_of_dist_lt _ hδM (by
      rw [SimpleGraph.dist_comm]; omega)).trans (qv_le_stab _ _) hz)) (inv_mem hg),
        fun x hx => ?_⟩
    have hx' : (g : (puAmalgam h.le).Universal)⁻¹ * x * (g : (puAmalgam h.le).Universal)⁻¹⁻¹ ∈
        T₀ := hT0n (inv_mem hg) hx
    have h1 := hT0Z hx' hz
    have e : ⁅(MulAut.conj (g : (puAmalgam h.le).Universal)).toMonoidHom z, x⁆ =
        (g : (puAmalgam h.le).Universal) *
          ⁅z, (g : (puAmalgam h.le).Universal)⁻¹ * x * (g : (puAmalgam h.le).Universal)⁻¹⁻¹⁆ *
            (g : (puAmalgam h.le).Universal)⁻¹ := by
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, commutatorElement_def]
      group
    rw [e, hRc hg h1]
    exact h1
  exact (hVS hv).2 t ht

theorem commutator_nclStab_inf_le (h32 : S32) (hX2 : S33.S33X52) (h : PUHyp M T L)
    (hb4 : critDist (puAmalgam h.le) = 4) (hd : S5.IsSp4Data M T L k F a)
    {c : Vtx (puAmalgam h.le)} (hc : IsCritical _ (baseA (puAmalgam h.le)) c)
    (hβ : geo _ (baseA (puAmalgam h.le)) c 1 = baseB _) {l : Submodule F (MSP.V4 F)}
    (hl : S5.Case56 h (2 ^ k) a (geo _ (baseA (puAmalgam h.le)) c 2) l)
    (hR : critR _ (baseA (puAmalgam h.le)) c ≤
      stabCenter _ (geo _ (baseA (puAmalgam h.le)) c 2))
    (hcent : Xq M = Uq M T L ⊔ Zq M L →
      ZM _ (baseA (puAmalgam h.le)) ⊓ ZM _ (geo _ (baseA (puAmalgam h.le)) c 2) ⊓ ZM _ c ≤
        stabCenter _ (geo _ (baseA (puAmalgam h.le)) c 2))
    {yc : (puAmalgam h.le).Universal} (hyc : yc ∈ stab _ (geo _ (baseA (puAmalgam h.le)) c 2))
    (hyce : yc • baseA (puAmalgam h.le) = c)
    {R : Subgroup (puAmalgam h.le).Universal} (hRZ : R ≤ stabCenter _ (baseA (puAmalgam h.le)))
    (hRX : R ≤ XM _ (baseA (puAmalgam h.le)))
    (hT0 : ∀ v ∈ S5.nclStab _ (baseA (puAmalgam h.le)) (ZM _ (geo _ (baseA (puAmalgam h.le)) c 2)),
      ∀ t ∈ Qv _ (baseA (puAmalgam h.le)) ⊓ Subgroup.centralizer
        ((ZM _ (geo _ (baseA (puAmalgam h.le)) c 2) ⊓ S5.bSub h.le L (baseA _) : Subgroup _) :
          Set (puAmalgam h.le).Universal), ⁅v, t⁆ ∈ R) :
    ⁅S5.nclStab _ (baseA (puAmalgam h.le)) (ZM _ (geo _ (baseA (puAmalgam h.le)) c 2)) ⊓
      Qv _ (geo _ (baseA (puAmalgam h.le)) c 2), S5.zHat _ (baseA (puAmalgam h.le)) c⁆ ≤
        XM _ (baseA (puAmalgam h.le)) := by
  have hyp := h.hyp20
  have hb0 := h.critDist_pos
  have hb : 2 < critDist (puAmalgam h.le) := by omega
  have hα : IsMVtx _ (baseA (puAmalgam h.le)) := isMVtx_baseA _
  have hcM : IsMVtx _ c := hc.isMVtx_right _ hyp
  have hd4 : (puAmalgam h.le).treeGraph.dist (baseA _) c = 4 := hc.2.1.trans hb4
  set δ := geo _ (baseA (puAmalgam h.le)) c 2 with hδ
  have hβδ : (puAmalgam h.le).treeGraph.Adj (baseB _) δ := by
    have := adj_geo _ (u := baseA (puAmalgam h.le)) (w := c) (i := 1) (by omega)
    rwa [hβ] at this
  have hδM : IsMVtx _ δ := isMVtx_geo_two _ hyp hb0 hc
  have hdδ : (puAmalgam h.le).treeGraph.dist (baseA _) δ = 2 := dist_geo _ (by omega)
  have hdδc : (puAmalgam h.le).treeGraph.dist δ c = 2 := by
    rw [dist_geo_right _ (by omega), hd4]
  have hgδ : geo _ c (baseA (puAmalgam h.le)) 2 = δ := by
    have := geo_symm _ (show 2 ≤ (puAmalgam h.le).treeGraph.dist (baseA _) c by omega)
    rwa [hd4] at this
  have hdc : 0 < (puAmalgam h.le).treeGraph.dist c (baseA _) := by
    rw [SimpleGraph.dist_comm]; omega
  set ε := geo _ c (baseA (puAmalgam h.le)) 1 with hε
  have hcε : (puAmalgam h.le).treeGraph.Adj c ε := adj_geo_one _ hdc
  have hεδ : (puAmalgam h.le).treeGraph.Adj ε δ := by
    have := adj_geo _ (u := c) (w := baseA (puAmalgam h.le)) (i := 1)
      (by rw [SimpleGraph.dist_comm]; omega)
    rwa [hgδ] at this
  set V := S5.nclStab _ (baseA (puAmalgam h.le)) (ZM _ δ) with hV
  have hVQ : V ≤ Qv _ (baseA (puAmalgam h.le)) := S310.nclStab_le_qv h hδM hdδ hb
  have hAQ : critA _ (baseA (puAmalgam h.le)) c ≤ Qv _ (baseA (puAmalgam h.le)) := inf_le_right
  have hVX : ⁅V, Qv _ (baseA (puAmalgam h.le))⁆ ≤ XM _ (baseA (puAmalgam h.le)) := by
    let S : Subgroup (puAmalgam h.le).Universal :=
      { carrier := {w | w ∈ stab _ (baseA (puAmalgam h.le)) ∧
          ∀ x ∈ Qv _ (baseA (puAmalgam h.le)), ⁅w, x⁆ ∈ XM _ (baseA (puAmalgam h.le))}
        one_mem' := ⟨one_mem _, fun x _ => by
          rw [commutatorElement_def, one_mul, inv_one, mul_one, mul_inv_cancel]
          exact one_mem _⟩
        mul_mem' := by
          rintro w₁ w₂ ⟨h₁, k₁⟩ ⟨h₂, k₂⟩
          refine ⟨mul_mem h₁ h₂, fun x hx => ?_⟩
          have e : ⁅w₁ * w₂, x⁆ = (w₁ * ⁅w₂, x⁆ * w₁⁻¹) * ⁅w₁, x⁆ := by
            simp only [commutatorElement_def]; group
          rw [e]
          exact mul_mem ((Subgroup.mem_normalizer_iff.1 (stab_le_normalizer_xm _ _ h₁) _).1
            (k₂ x hx)) (k₁ x hx)
        inv_mem' := by
          rintro w ⟨hw, kw⟩
          refine ⟨inv_mem hw, fun x hx => ?_⟩
          have hx' : w⁻¹ * x * w⁻¹⁻¹ ∈ Qv _ (baseA (puAmalgam h.le)) :=
            (Subgroup.mem_normalizer_iff.1 (stab_le_normalizer_qv _ _ (inv_mem hw)) x).1 hx
          have e : ⁅w⁻¹, x⁆ = ⁅w, w⁻¹ * x * w⁻¹⁻¹⁆⁻¹ := by
            simp only [commutatorElement_def]; group
          rw [e]
          exact inv_mem (kw _ hx') }
    have hZX := S512F.commutator_zm_qv_le_xm h hb hd hβδ hl
    have hVS : V ≤ S := by
      refine iSup_le fun g => ?_
      rintro _ ⟨z, hz, rfl⟩
      have hg := g.2
      have hzA : z ∈ stab _ (baseA (puAmalgam h.le)) :=
        ((zm_le_qv_of_dist_lt _ hδM (by rw [SimpleGraph.dist_comm]; omega)).trans
          (qv_le_stab _ _)) hz
      refine ⟨mul_mem (mul_mem hg hzA) (inv_mem hg), fun x hx => ?_⟩
      have hx' : (g : (puAmalgam h.le).Universal)⁻¹ * x * (g : (puAmalgam h.le).Universal)⁻¹⁻¹ ∈
          Qv _ (baseA (puAmalgam h.le)) :=
        (Subgroup.mem_normalizer_iff.1 (stab_le_normalizer_qv _ _ (inv_mem hg)) x).1 hx
      have h1 := hZX (Subgroup.commutator_mem_commutator hz hx')
      have e : ⁅(MulAut.conj (g : (puAmalgam h.le).Universal)).toMonoidHom z, x⁆ =
          (g : (puAmalgam h.le).Universal) *
            ⁅z, (g : (puAmalgam h.le).Universal)⁻¹ * x * (g : (puAmalgam h.le).Universal)⁻¹⁻¹⁆ *
              (g : (puAmalgam h.le).Universal)⁻¹ := by
        simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, commutatorElement_def]
        group
      rw [e]
      exact (Subgroup.mem_normalizer_iff.1 (stab_le_normalizer_xm _ _ hg) _).1 h1
    rw [Subgroup.commutator_le]
    intro v hv x hx
    exact (hVS hv).2 x hx
  have hAY : ⁅critA _ (baseA (puAmalgam h.le)) c, V ⊓ Qv _ δ⁆ ≤ XM _ (baseA (puAmalgam h.le)) := by
    rw [Subgroup.commutator_comm]
    exact (Subgroup.commutator_mono inf_le_left hAQ).trans hVX
  have hZαc : ZM _ (baseA (puAmalgam h.le)) ≤ stab _ c :=
    (S512T.zm_facts h hb4 (ms22_iii _ hyp hb0 h.centHyp hc)).2.1
  have hRZc : critR _ (baseA (puAmalgam h.le)) c ≤ ZM _ c := by
    rw [critR, Subgroup.commutator_comm]
    exact commutator_le_left_of_le_normalizer (hZαc.trans (stab_le_normalizer_zm _ _))
  have hZcδ : ZM _ c ≤ Qv _ δ := zm_le_qv_of_dist_lt _ hcM (by rw [SimpleGraph.dist_comm]; omega)
  have hRK : critR _ (baseA (puAmalgam h.le)) c ≤ ZM _ δ ⊓ ZM _ c := by
    have hRX' : critR _ (baseA (puAmalgam h.le)) c ≤ XM _ δ :=
      le_xm_of_le_stabCenter h hR (hRZc.trans hZcδ)
        (fun x hx => (isElemAbelian_zm _ hyp hb0 hcM).2 x (hRZc hx))
    exact (le_inf hR hRX').trans ((S5B.stabCenter_inf_xm_le_zh h hδM hεδ.symm).trans
      (le_inf (zh_le_zm _ hεδ.symm) (zh_le_zm _ hcε)))
  refine commutator_zHat_le_xm h32 hX2 h hd hc ?_ ?_ ?_ hAY ?_ ?_
  · exact inf_le_right.trans (qv_le_qv _ hyp hδM hεδ.symm)
  · intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro r hr
    exact (S510.commute_of_mem_stabCenter (hR hr) (qv_le_stab _ δ hx.2)).symm
  · exact (inf_le_left.trans hVQ).trans (qv_le_centralizer_xm _ _)
  · rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
    exact hAY.trans ((xm_le_centralizer _ _).trans
      (Subgroup.centralizer_le (inf_le_left.trans hVQ)))
  · intro hidx hXU hcard hle
    have hZc := S5Q2.UC.zq_le_centralizer_of_relIndex_eq h hd hc hidx
    have hXZc : XM _ c = ZM _ c := by
      obtain ⟨g, hg⟩ := exists_eq_smul_baseA _ hcM
      rw [hg, xm_smul, zm_smul, S5B.xm_eq_zm h hXU hZc]
    have hR₁R : ⁅V ⊓ Qv _ δ, critA _ (baseA (puAmalgam h.le)) c⁆ ≤ R := by
      rw [Subgroup.commutator_le]
      intro v hv x hx
      refine hT0 v hv.1 x ⟨hAQ hx, Subgroup.mem_centralizer_iff.2 fun b hb => ?_⟩
      exact Subgroup.mem_centralizer_iff.1 (xm_le_centralizer _ c hx.1) b
        (zm_le_qv_of_dist_lt _ hδM (by omega) hb.1)
    have hR₁X : ⁅V ⊓ Qv _ δ, critA _ (baseA (puAmalgam h.le)) c⁆ ≤ XM _ c := by
      rw [Subgroup.commutator_comm]
      exact (Subgroup.commutator_mono inf_le_left le_rfl).trans
        (commutator_le_left_of_le_normalizer ((inf_le_right.trans
          (qv_le_stab_of_dist_le_two _ hyp hδM hdδc.le)).trans (stab_le_normalizer_xm _ _)))
    have hR₁K := le_of_le_sup_stabCenter h hcM hcε.symm
      (hRZc.trans ((zm_le_qv_self _ hcM hb0).trans (qv_le_stab _ _)))
      (hRZc.trans (zm_le_xm _ hyp hb0 hcM)) hle hR₁X hRK
      (le_inf (zh_le_zm _ hεδ.symm) (zh_le_zm _ hcε))
    have hR₁A : ⁅V ⊓ Qv _ δ, critA _ (baseA (puAmalgam h.le)) c⁆ ≤
        ZM _ (baseA (puAmalgam h.le)) :=
      hR₁R.trans ((le_inf hRZ hRX).trans ((S5B.stabCenter_inf_xm_le_zh h hα
        (adj_baseA_baseB _)).trans (zh_le_zm _ (adj_baseA_baseB _))))
    have hR₁δ : ⁅V ⊓ Qv _ δ, critA _ (baseA (puAmalgam h.le)) c⁆ ≤ stabCenter _ δ :=
      (le_inf (le_inf hR₁A (hR₁K.trans inf_le_left)) (hR₁K.trans inf_le_right)).trans
        (hcent hXU)
    have hR₁c : ⁅V ⊓ Qv _ δ, critA _ (baseA (puAmalgam h.le)) c⁆ ≤ stabCenter _ c := fun r hr =>
      S510.mem_stabCenter_of_reflect hyc hyce (hR₁δ hr) (hRZ (hR₁R hr))
    have hbot : ⁅V ⊓ Qv _ δ, critA _ (baseA (puAmalgam h.le)) c⁆ = ⊥ := by
      rw [eq_bot_iff, Subgroup.commutator_le]
      intro v hv x hx
      have hvc : v ∈ stab _ c := qv_le_stab_of_dist_le_two _ hyp hδM hdδc.le hv.2
      have hvε : v ∈ Qv _ ε := qv_le_qv _ hyp hδM hεδ.symm hv.2
      have hxZ : x ∈ ZM _ c := hXZc ▸ hx.1
      have hUn : S5.uSub h.le L c ≤ Subgroup.normalizer (ZH _ ε : Set _) :=
        ((S5B.uSub_le_zm h.le c).trans ((zm_le_qv_of_dist_lt _ hcM (by
          rw [dist_eq_one_of_adj _ hcε]; omega)).trans (qv_le_stab _ _))).trans
            (stab_le_normalizer_zh _ _)
      rw [S5B.zm_eq_zh_sup_uSub h hcM hcε, ← SetLike.mem_coe,
        Subgroup.coe_mul_of_right_le_normalizer_left _ _ hUn] at hxZ
      obtain ⟨z, hz, u, hu, rfl⟩ := hxZ
      have hvz : z * v = v * z :=
        (Subgroup.mem_centralizer_iff.1 (zh_le_centralizer _ _ hz) v hvε).symm
      have hzc : z ∈ stab _ c := (zh_le_zm _ hcε).trans ((zm_le_qv_self _ hcM hb0).trans
        (qv_le_stab _ _)) hz
      have e1 : ⁅v, z * u⁆ = z * ⁅v, u⁆ * z⁻¹ := by
        rw [commutatorElement_def, commutatorElement_def]
        calc v * (z * u) * v⁻¹ * (z * u)⁻¹ = (v * z) * u * v⁻¹ * u⁻¹ * z⁻¹ := by group
          _ = (z * v) * u * v⁻¹ * u⁻¹ * z⁻¹ := by rw [hvz]
          _ = z * (v * u * v⁻¹ * u⁻¹) * z⁻¹ := by group
      have h1 := hR₁c (Subgroup.commutator_mem_commutator hv hx)
      rw [e1] at h1
      have h2 : ⁅v, u⁆ ∈ stabCenter _ c := by
        have e2 : ⁅v, u⁆ = z⁻¹ * (z * ⁅v, u⁆ * z⁻¹) * z⁻¹⁻¹ := by group
        rw [e2, S510.commute_of_mem_stabCenter h1 (inv_mem hzc), mul_inv_cancel_right]
        exact h1
      have h3 := S5B.lift_at h hd hcM hvc hu (Subgroup.mem_centralizer_iff.2 fun y hy =>
        S510.commute_of_mem_stabCenter h2 (puTrans_le_stab h.le L _ hy))
      rw [e1, Subgroup.mem_bot, commutatorElement_def, h3, mul_inv_cancel, mul_one,
        mul_inv_cancel]
    rw [hbot, Subgroup.card_bot] at hcard
    exact absurd hcard (Nat.one_lt_two_pow (by have := hd.1; omega)).ne

theorem uSub_inf_qv_le_bSub (h32 : S32) (hX2 : S33.S33X52) (h54 : S54) (h : PUHyp M T L)
    (hmin : PUMin M T L) (hb4 : critDist (puAmalgam h.le) = 4) (hd : S5.IsSp4Data M T L k F a)
    {l : Submodule F (MSP.V4 F)} (hl : MSP.IsLine l)
    (hTl : Qv _ (baseB (puAmalgam h.le)) ≤ S5.vPre h.le a (MSP.qLine l))
    (hTB : (2 ^ k) ^ 2 < (Qv _ (baseA (puAmalgam h.le))).relIndex (Qv _ (baseB (puAmalgam h.le))))
    {c₁ c₂ m : Vtx (puAmalgam h.le)}
    (hc₁ : IsCritical _ (baseA (puAmalgam h.le)) c₁)
    (hβ₁ : geo _ (baseA (puAmalgam h.le)) c₁ 1 = baseB _)
    (hc₂ : IsCritical _ (baseA (puAmalgam h.le)) c₂)
    (hβ₂ : geo _ (baseA (puAmalgam h.le)) c₂ 1 = baseB _)
    (hmid : geo _ (baseA (puAmalgam h.le)) c₂ 2 = geo _ (baseA (puAmalgam h.le)) c₁ 2)
    (hq₁ : (Qv _ c₁).relIndex (ZM _ (baseA (puAmalgam h.le))) = 2 ^ k)
    (hq₂ : (Qv _ c₂).relIndex (ZM _ (baseA (puAmalgam h.le))) = 2 ^ k)
    (hne : S5.uSub h.le L (baseA (puAmalgam h.le)) ⊓
        Subgroup.centralizer (ZM _ c₁ : Set (puAmalgam h.le).Universal) ≠
      S5.uSub h.le L (baseA (puAmalgam h.le)) ⊓
        Subgroup.centralizer (ZM _ c₂ : Set (puAmalgam h.le).Universal))
    (hR₁ : critR _ (baseA (puAmalgam h.le)) c₁ ≤
      stabCenter _ (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    (hR₂ : critR _ (baseA (puAmalgam h.le)) c₂ ≤
      stabCenter _ (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    (hcent₁ : Xq M = Uq M T L ⊔ Zq M L →
      ZM _ (baseA (puAmalgam h.le)) ⊓ ZM _ (geo _ (baseA (puAmalgam h.le)) c₁ 2) ⊓ ZM _ c₁ ≤
        stabCenter _ (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    (hcent₂ : Xq M = Uq M T L ⊔ Zq M L →
      ZM _ (baseA (puAmalgam h.le)) ⊓ ZM _ (geo _ (baseA (puAmalgam h.le)) c₁ 2) ⊓ ZM _ c₂ ≤
        stabCenter _ (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    (hlarge : S512Z.Large h k (baseA _) (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    {g' x' : (puAmalgam h.le).Universal} (hg' : g' ∈ stab _ (baseA (puAmalgam h.le)))
    (hx' : x' ∈ puTrans h.le L (baseA _)) {l' : Submodule F (MSP.V4 F)}
    (hl' : S5.Case56 h (2 ^ k) a (geo _ (baseA (puAmalgam h.le)) c₁ 2) l')
    (hc56 : S5.Concl56 h (2 ^ k) a c₁ l' g' x') (hopp : S5.Opp56 h (2 ^ k) a l' g' x')
    (hm : m = g'⁻¹ • geo _ (baseA (puAmalgam h.le)) c₁ 2 ∨
      m = x'⁻¹ • g'⁻¹ • geo _ (baseA (puAmalgam h.le)) c₁ 2)
    (hcm : IsCritical _ m (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    (hqm : (Qv _ (geo _ (baseA (puAmalgam h.le)) c₁ 2)).relIndex (ZM _ m) = 2 ^ k) :
    S5.uSub h.le L m ⊓ Qv _ (geo _ (baseA (puAmalgam h.le)) c₁ 2) ≤
      S5.bSub h.le L (baseA _) := by
  have hyp := h.hyp20
  have hb0 := h.critDist_pos
  have hb : 2 < critDist (puAmalgam h.le) := by omega
  have hα : IsMVtx _ (baseA (puAmalgam h.le)) := isMVtx_baseA _
  have hLn : (L.subgroupOf M).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer h.L_le).2 h.le_normalizer
  have hFq : Nat.card F = 2 ^ k := by rw [Nat.card_eq_fintype_card, hd.2.1]
  have hk : 1 < 2 ^ k := Nat.one_lt_two_pow (by have := hd.1; omega)
  have hd4 : (puAmalgam h.le).treeGraph.dist (baseA _) c₁ = 4 := hc₁.2.1.trans hb4
  set δ := geo _ (baseA (puAmalgam h.le)) c₁ 2 with hδ
  have hβδ : (puAmalgam h.le).treeGraph.Adj (baseB _) δ := by
    have := adj_geo _ (u := baseA (puAmalgam h.le)) (w := c₁) (i := 1) (by omega)
    rwa [hβ₁] at this
  have hδM : IsMVtx _ δ := isMVtx_geo_two _ hyp hb0 hc₁
  have hdδ : (puAmalgam h.le).treeGraph.dist (baseA _) δ = 2 := dist_geo _ (by omega)
  have hJT := jOff_eq_qv_of_le_qLine h54 h hmin hb hd hl hTl
  have hTl' : Qv _ (baseB (puAmalgam h.le)) ≤ S5.vPre h.le a (MSP.qLine l') := by
    rw [← hJT]; exact hl'.2.2.2
  have hTB2 : IsPGroup 2 (Qv (puAmalgam h.le) (baseB _)) := isPGroup_qv _ hyp (not_isMVtx_baseB _)
  have hTs : Qv _ (baseB (puAmalgam h.le)) ≤ stab _ (baseA (puAmalgam h.le)) :=
    qv_le_stab_of_adj _ (adj_baseA_baseB _).symm
  have hQT : Qv _ (baseA (puAmalgam h.le)) ≤ Qv _ (baseB (puAmalgam h.le)) :=
    qv_le_qv _ hyp hα (adj_baseA_baseB _)
  have hmlam : m ∈ S5.lam h (2 ^ k) a c₁ δ := ⟨g', x', hg', hx', Or.inr ⟨l', hl', hc56⟩, hm⟩
  obtain ⟨y', hy', hmy, hgen⟩ : ∃ y' ∈ stab _ (baseA (puAmalgam h.le)), m = y'⁻¹ • δ ∧
      ∀ E₁ E₂ : Subgroup (puAmalgam h.le).Universal, IsPGroup 2 E₁ → IsPGroup 2 E₂ →
        E₁ ≤ S5.rconj y' (S5.vPre h.le a (MSP.qLine l')) →
        E₂ ≤ S5.vPre h.le a (MSP.qLine l') →
        (2 ^ k) ^ 2 < (Qv _ (baseA _)).relIndex E₁ → (2 ^ k) ^ 2 < (Qv _ (baseA _)).relIndex E₂ →
        E₁ ⊔ E₂ ⊔ Qv _ (baseA _) = stab _ (baseA _) := by
    rcases hm with hm | hm
    · exact ⟨g', hg', hm, hc56.1⟩
    · exact ⟨g' * x', mul_mem hg' (puTrans_le_stab h.le L _ hx'),
        by rw [hm, mul_inv_rev, mul_smul], hopp⟩
  have hym : y'⁻¹ ∈ stab _ (baseA (puAmalgam h.le)) := inv_mem hy'
  have hyα : y'⁻¹ • baseA (puAmalgam h.le) = baseA _ := (mem_stab _).1 hym
  have hstep : S5B.IsLamStep h (2 ^ k) a (baseA _) c₁ m :=
    ⟨hc₁, ⟨1, one_smul _ _, by rw [one_smul, hβ₁], by simpa using hmlam⟩, hcm⟩
  obtain ⟨hdm, hmidm⟩ := S5B.lamStep_geo h hb4 hstep
  have hmM : IsMVtx _ m := hcm.1
  have hAν : (puAmalgam h.le).treeGraph.Adj (baseA _) (y'⁻¹ • baseB (puAmalgam h.le)) := by
    have := (adj_smul _ y'⁻¹ _ _).2 (adj_baseA_baseB (puAmalgam h.le))
    rwa [hyα] at this
  have hνm : (puAmalgam h.le).treeGraph.Adj (y'⁻¹ • baseB (puAmalgam h.le)) m := by
    rw [hmy]
    exact (adj_smul _ y'⁻¹ _ _).2 hβδ
  have hJ := S512T.jOff_le_normalizer_y h54 h hmin hb4 hd hcm hmidm hAν hνm hqm
  have hJeq : S5.jOff h.le L (2 ^ k) m (y'⁻¹ • baseB (puAmalgam h.le)) =
      S5.rconj y' (Qv _ (baseB (puAmalgam h.le))) := by
    rw [hmy, S5B.jOff_smul h.le hLn, hl'.1, hJT]
    rfl
  rw [hJeq] at hJ
  have hE₁s : S5.rconj y' (Qv _ (baseB (puAmalgam h.le))) ≤ stab _ (baseA (puAmalgam h.le)) :=
    S5.rconj_le_stab h hTs hy'
  have hrel₁ : (2 ^ k) ^ 2 < (Qv _ (baseA (puAmalgam h.le))).relIndex
      (S5.rconj y' (Qv _ (baseB (puAmalgam h.le)))) := by
    rw [S5C56.relIndex_rconj h hy']
    exact hTB
  have htop := hgen (S5.rconj y' (Qv _ (baseB (puAmalgam h.le)))) (Qv _ (baseB (puAmalgam h.le)))
    (hTB2.map _) hTB2 (Subgroup.map_mono hTl') hTl' hrel₁ hTB
  rw [sup_assoc, sup_eq_left.2 hQT] at htop
  have hy'r : y' ∈ (puAmalgam h.le).ofA.range := by rw [S5.ofA_range_eq]; exact hy'
  obtain ⟨my, hmyE⟩ := hy'r
  have hvJ : S5.vIm h.le a (S5.rconj y' (Qv _ (baseB (puAmalgam h.le)))) =
      (S5.vIm h.le a (Qv _ (baseB (puAmalgam h.le)))).map (MulAut.conj (a my⁻¹)).toMonoidHom := by
    rw [S5.rconj, ← hmyE, ← map_inv, S5.vIm_map_conj]
  have hvT : S5.vIm h.le a (Qv _ (baseB (puAmalgam h.le))) ≤ MSP.qLine l' :=
    S5.vIm_le_of_le_vPre' h.le hTl'
  set l₁ := l'.map (Matrix.mulVecLin (MSP.mat (a my⁻¹))) with hl₁def
  have hl₁ : MSP.IsLine l₁ := MSP.isLine_map hl'.2.1 _
  have hvJ' : S5.vIm h.le a (S5.rconj y' (Qv _ (baseB (puAmalgam h.le)))) ≤
      MSP.qLine l₁ := by
    rw [hvJ, hl₁def, MSP.qLine_map]
    exact Subgroup.map_mono hvT
  have hran : ∀ {K : Subgroup (puAmalgam h.le).Universal}, K ≤ stab _ (baseA (puAmalgam h.le)) →
      K ≤ (puAmalgam h.le).ofA.range := fun hK => hK.trans (S5.ofA_range_eq h.le).ge
  have htop' : S5.vIm h.le a (Qv _ (baseB (puAmalgam h.le))) ⊔
      S5.vIm h.le a (S5.rconj y' (Qv _ (baseB (puAmalgam h.le)))) = ⊤ := by
    have e1 := congrArg (S5.vIm h.le a) htop
    rw [S5.vIm_sup h.le (hran hE₁s) (hran hTs)] at e1
    rw [sup_comm, e1, puAmalgam.stab_baseA, S5B.vIm_imM h.le, Subgroup.subgroupOf_self,
      ← MonoidHom.range_eq_map, MonoidHom.range_eq_top]
    exact hd.2.2.1
  have hopp' : l' ⊓ l₁ = ⊥ := inf_eq_bot_of_sup_eq_top hvT hvJ' htop'
  have hZ₁ := S512T.zHat_eq h hd hc₁ hq₁
  have hZ₂ := S512T.zHat_eq h hd hc₂ hq₂
  have hZ₁B : ZM _ c₁ ≤ Qv _ (baseB (puAmalgam h.le)) := by
    have := (S512T.zm_facts h hb4 hc₁).1
    rwa [hβ₁] at this
  have hZ₂B : ZM _ c₂ ≤ Qv _ (baseB (puAmalgam h.le)) := by
    have := (S512T.zm_facts h hb4 hc₂).1
    rwa [hβ₂] at this
  have hcq₁ : (Qv _ (baseA (puAmalgam h.le))).relIndex (ZM _ c₁) = 2 ^ k :=
    le_antisymm (S512T.relIndex_qv_zm_symm h hb4 hd hc₁ hq₁.le)
      (S512T.le_relIndex_qv_zm h hb4 hd (ms22_iii _ hyp hb0 h.centHyp hc₁))
  have hcq₂ : (Qv _ (baseA (puAmalgam h.le))).relIndex (ZM _ c₂) = 2 ^ k :=
    le_antisymm (S512T.relIndex_qv_zm_symm h hb4 hd hc₂ hq₂.le)
      (S512T.le_relIndex_qv_zm h hb4 hd (ms22_iii _ hyp hb0 h.centHyp hc₂))
  have hu₁ : (Subgroup.centralizer (ZM _ c₁ : Set (puAmalgam h.le).Universal)).relIndex
      (S5.uSub h.le L (baseA (puAmalgam h.le))) = 2 ^ k := by
    rw [← S512T.relIndex_qv_zm_eq h hb4 hc₁]; exact hq₁
  have hu₂ : (Subgroup.centralizer (ZM _ c₂ : Set (puAmalgam h.le).Universal)).relIndex
      (S5.uSub h.le L (baseA (puAmalgam h.le))) = 2 ^ k := by
    rw [← S512T.relIndex_qv_zm_eq h hb4 hc₂]; exact hq₂
  have hsq := sq_le_card_vIm_sup h hd hZ₁B hZ₂B hcq₁ hu₁ hcq₂ hu₂ hne
  have hvZ : S5.vIm h.le a (ZM _ c₁ ⊔ ZM _ c₂) ≤ MSP.qLine l' :=
    S5.vIm_le_of_le_vPre' h.le ((sup_le hZ₁B hZ₂B).trans hTl')
  have hJc : (2 ^ k) ^ 2 < Nat.card (S5.vIm h.le a
      (S5.rconj y' (Qv _ (baseB (puAmalgam h.le))))) := by
    rw [S5.card_vIm h hd hE₁s (hTB2.map _)]
    exact hrel₁
  have : CharP F 2 := S5B.charP_two_of_card hd.2.1
  have hgen' := MSP.sup_eq_top_of_le_qLine' hl'.2.1 hl₁ hopp' hvZ hvJ'
    (by rw [hFq]; nlinarith) (by rw [hFq]; exact hJc)
  set K := Qv _ (baseA (puAmalgam h.le)) ⊔ S5.rconj y' (Qv _ (baseB (puAmalgam h.le))) ⊔
    (S5.zHat _ (baseA _) c₁ ⊔ S5.zHat _ (baseA _) c₂) with hK
  have hZs₁ := (S5B.crit_facts h hc₁).2.2.1
  have hZs₂ := (S5B.crit_facts h hc₂).2.2.1
  have hKs : K ≤ stab _ (baseA (puAmalgam h.le)) :=
    sup_le (sup_le (qv_le_stab _ _) hE₁s) (sup_le hZs₁ hZs₂)
  have hQK : Qv _ (baseA (puAmalgam h.le)) ≤ K := le_sup_left.trans le_sup_left
  have hvK : S5.vIm h.le a K = ⊤ := by
    refine eq_top_iff.2 (hgen'.symm.le.trans (sup_le ?_ ?_))
    · rw [← hZ₁, ← hZ₂]
      exact S5.vIm_mono' h le_sup_right
    · exact S5.vIm_mono' h (le_sup_right.trans le_sup_left)
  have hKeq := (S5.lift56 h hd hKs hQK).2 hvK
  have hLK : puTrans h.le L (baseA (puAmalgam h.le)) ≤ K := hKeq ▸ puTrans_le_stab h.le L _
  have hZy : Xq M = Uq M T L ⊔ Zq M L →
      ZM _ (y'⁻¹ • δ) ⊓ ZM _ (baseA (puAmalgam h.le)) ⊓ ZM _ δ ≤
        stabCenter _ (baseA (puAmalgam h.le)) := by
    intro hXU
    have hZc := S5Q2.UC.zq_le_centralizer_of_relIndex_eq h hd hc₁ hq₁
    rw [← hmy]
    exact S5C56.zm_inf_le_stabCenter_of_mem_lam h hd
      (fun l'' hl'' => S512Z.zz56_of_large hZc h hd hXU hβδ hl'' hlarge) ⟨l', hl'⟩ hq₁ hmlam
  have hN₁ := normalizer_of_pair h32 hX2 h hb4 hd hc₁ hβ₁ hl' hR₁ hcent₁ hym hZy
  have hN₂ := normalizer_of_pair h32 hX2 h hb4 hd hc₂ hβ₂ (hmid ▸ hl') (hmid ▸ hR₂)
    (hmid ▸ hcent₂) hym (hmid ▸ hZy)
  rw [← hmy] at hN₁
  rw [hmid, ← hmy] at hN₂
  have hQN : Qv _ (baseA (puAmalgam h.le)) ≤ Subgroup.normalizer
      (((S5.uSub h.le L m ⊓ Qv _ δ) ⊔ XM _ (baseA (puAmalgam h.le)) : Subgroup _) : Set _) := by
    refine (le_inf (le_inf ((qv_le_stab_of_dist_le_two _ hyp hα hdm.le).trans
      (S510.stab_le_normalizer_uSub h m)) ((qv_le_stab_of_dist_le_two _ hyp hα hdδ.le).trans
        (stab_le_normalizer_qv _ δ)) |>.trans Subgroup.inf_normalizer_le_normalizer_inf)
      ((qv_le_stab _ _).trans (stab_le_normalizer_xm _ _))).trans
        (Subgroup.inf_normalizer_le_normalizer_sup _ _)
  have hn : puTrans h.le L (baseA (puAmalgam h.le)) ≤ Subgroup.normalizer
      (((S5.uSub h.le L m ⊓ Qv _ δ) ⊔ XM _ (baseA (puAmalgam h.le)) : Subgroup _) : Set _) :=
    hLK.trans (sup_le (sup_le hQN hJ) (sup_le hN₁ hN₂))
  have hYZ : S5.uSub h.le L m ⊓ Qv _ δ ≤ ZM _ m := inf_le_left.trans (S5B.uSub_le_zm h.le m)
  exact S5B.le_bSub_of_xm h hb (h32 G M T L h).2.1 hα hdm (hYZ.trans (zm_le_xm _ hyp hb0 hmM))
    (hYZ.trans (S5B.zm_le_vv_of_dist hmM hdm.le)) hn

theorem false_of_frame (h14 : MS14AS) (hSQ : SQTKQuot)
    (hT : S32.TypeFacts) (h32 : S32) (hX2 : S33.S33X52) (h52 : S52) (h54 : S54)
    (h : PUHyp M T L) (hmin : PUMin M T L) (hb4 : critDist (puAmalgam h.le) = 4)
    (hd : S5.IsSp4Data M T L k F a) {l : Submodule F (MSP.V4 F)} (hl : MSP.IsLine l)
    (hTl : Qv _ (baseB (puAmalgam h.le)) ≤ S5.vPre h.le a (MSP.qLine l))
    (hTB : (2 ^ k) ^ 2 < (Qv _ (baseA (puAmalgam h.le))).relIndex (Qv _ (baseB (puAmalgam h.le))))
    {c₁ c₂ m : Vtx (puAmalgam h.le)}
    (hc₁ : IsCritical _ (baseA (puAmalgam h.le)) c₁)
    (hβ₁ : geo _ (baseA (puAmalgam h.le)) c₁ 1 = baseB _)
    (hc₂ : IsCritical _ (baseA (puAmalgam h.le)) c₂)
    (hβ₂ : geo _ (baseA (puAmalgam h.le)) c₂ 1 = baseB _)
    (hmid : geo _ (baseA (puAmalgam h.le)) c₂ 2 = geo _ (baseA (puAmalgam h.le)) c₁ 2)
    (hq₁ : (Qv _ c₁).relIndex (ZM _ (baseA (puAmalgam h.le))) = 2 ^ k)
    (hq₂ : (Qv _ c₂).relIndex (ZM _ (baseA (puAmalgam h.le))) = 2 ^ k)
    (hne : S5.uSub h.le L (baseA (puAmalgam h.le)) ⊓
        Subgroup.centralizer (ZM _ c₁ : Set (puAmalgam h.le).Universal) ≠
      S5.uSub h.le L (baseA (puAmalgam h.le)) ⊓
        Subgroup.centralizer (ZM _ c₂ : Set (puAmalgam h.le).Universal))
    (hR₁ : critR _ (baseA (puAmalgam h.le)) c₁ ≤
      stabCenter _ (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    (hR₂ : critR _ (baseA (puAmalgam h.le)) c₂ ≤
      stabCenter _ (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    (hcent₁ : Xq M = Uq M T L ⊔ Zq M L →
      ZM _ (baseA (puAmalgam h.le)) ⊓ ZM _ (geo _ (baseA (puAmalgam h.le)) c₁ 2) ⊓ ZM _ c₁ ≤
        stabCenter _ (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    (hcent₂ : Xq M = Uq M T L ⊔ Zq M L →
      ZM _ (baseA (puAmalgam h.le)) ⊓ ZM _ (geo _ (baseA (puAmalgam h.le)) c₁ 2) ⊓ ZM _ c₂ ≤
        stabCenter _ (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    (hlarge : S512Z.Large h k (baseA _) (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    {y₁ y₂ : (puAmalgam h.le).Universal}
    (hy₁ : y₁ ∈ stab _ (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    (hy₁e : y₁ • baseA (puAmalgam h.le) = c₁)
    (hy₂ : y₂ ∈ stab _ (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    (hy₂e : y₂ • baseA (puAmalgam h.le) = c₂)
    {g' x' : (puAmalgam h.le).Universal} (hg' : g' ∈ stab _ (baseA (puAmalgam h.le)))
    (hx' : x' ∈ puTrans h.le L (baseA _)) {l' : Submodule F (MSP.V4 F)}
    (hl' : S5.Case56 h (2 ^ k) a (geo _ (baseA (puAmalgam h.le)) c₁ 2) l')
    (hc56 : S5.Concl56 h (2 ^ k) a c₁ l' g' x') (hopp : S5.Opp56 h (2 ^ k) a l' g' x')
    (hm : m = g'⁻¹ • geo _ (baseA (puAmalgam h.le)) c₁ 2 ∨
      m = x'⁻¹ • g'⁻¹ • geo _ (baseA (puAmalgam h.le)) c₁ 2)
    (hcm : IsCritical _ m (geo _ (baseA (puAmalgam h.le)) c₁ 2))
    (hqm : (Qv _ (geo _ (baseA (puAmalgam h.le)) c₁ 2)).relIndex (ZM _ m) = 2 ^ k)
    (hR4 : ⁅ZM (puAmalgam h.le) m, ZM (puAmalgam h.le) (geo _ (baseA (puAmalgam h.le)) c₁ 2)⁆ ≤
      stabCenter _ (baseA (puAmalgam h.le))) :
    False := by
  have hyp := h.hyp20
  have hb0 := h.critDist_pos
  have hb : 2 < critDist (puAmalgam h.le) := by omega
  have hα : IsMVtx _ (baseA (puAmalgam h.le)) := isMVtx_baseA _
  have hk : 1 < 2 ^ k := Nat.one_lt_two_pow (by have := hd.1; omega)
  have hYB := uSub_inf_qv_le_bSub h32 hX2 h54 h hmin hb4 hd hl hTl hTB hc₁ hβ₁ hc₂ hβ₂ hmid hq₁
    hq₂ hne hR₁ hR₂ hcent₁ hcent₂ hlarge hg' hx' hl' hc56 hopp hm hcm hqm
  have hd4 : (puAmalgam h.le).treeGraph.dist (baseA _) c₁ = 4 := hc₁.2.1.trans hb4
  set δ := geo _ (baseA (puAmalgam h.le)) c₁ 2 with hδ
  have hβδ : (puAmalgam h.le).treeGraph.Adj (baseB _) δ := by
    have := adj_geo _ (u := baseA (puAmalgam h.le)) (w := c₁) (i := 1) (by omega)
    rwa [hβ₁] at this
  have hδM : IsMVtx _ δ := isMVtx_geo_two _ hyp hb0 hc₁
  have hdδ : (puAmalgam h.le).treeGraph.dist (baseA _) δ = 2 := dist_geo _ (by omega)
  have hmlam : m ∈ S5.lam h (2 ^ k) a c₁ δ := ⟨g', x', hg', hx', Or.inr ⟨l', hl', hc56⟩, hm⟩
  have hstep : S5B.IsLamStep h (2 ^ k) a (baseA _) c₁ m :=
    ⟨hc₁, ⟨1, one_smul _ _, by rw [one_smul, hβ₁], by simpa using hmlam⟩, hcm⟩
  obtain ⟨hdm, hmidm⟩ := S5B.lamStep_geo h hb4 hstep
  have hmM : IsMVtx _ m := hcm.1
  obtain ⟨t, ht, hmt⟩ := S5B.exists_mem_stab_of_mem_lam hmlam
  have hBm : (S5.bSub h.le L (baseA _)).relIndex (ZM _ m) ≤ 2 ^ k := by
    rw [S512T.relIndex_bSub_zm_eq h hb4 hcm hmidm]
    have hq' := hqm
    rw [← S512T.relIndex_qv_uSub_eq h hb4 hcm] at hq'
    rw [← hq', ← Subgroup.inf_relIndex_right (S5.bSub h.le L (baseA _)),
      ← Subgroup.inf_relIndex_right (Qv _ δ)]
    refine Subgroup.relIndex_le_of_le_left (fun x hx => ⟨hYB ⟨hx.2, hx.1⟩, hx.2⟩) ?_
    rw [Subgroup.inf_relIndex_right, hq']
    positivity
  have hBδ : (S5.bSub h.le L (baseA _)).relIndex (ZM _ δ) ≤ 2 ^ k := by
    have e := S5B.relIndex_bSub_zm_smul h t (baseA (puAmalgam h.le)) δ
    rw [(mem_stab _).1 ht, ← hmt] at e
    rw [← e]
    exact hBm
  set V := S5.nclStab _ (baseA (puAmalgam h.le)) (ZM _ δ) with hVdef
  have hZmV : ZM _ m ≤ V := by
    rw [hmt]
    exact S512R.zm_smul_le_nclStab h ht _
  have hVQ : V ≤ Qv _ (baseA (puAmalgam h.le)) := S310.nclStab_le_qv h hδM hdδ hb
  have hrel : (Subgroup.centralizer (V : Set (puAmalgam h.le).Universal)).relIndex
      (S5.uSub h.le L δ) ≤ 2 ^ k := by
    have := S512N.finite_zm h hδM
    have hY := S512N.inf_bSub_sup_le_centralizer_nclStab h hb hα hδM hdδ
    calc (Subgroup.centralizer (V : Set (puAmalgam h.le).Universal)).relIndex
          (S5.uSub h.le L δ)
        ≤ (Subgroup.centralizer (V : Set (puAmalgam h.le).Universal)).relIndex (ZM _ δ) :=
          Subgroup.relIndex_le_of_le_right (S5B.uSub_le_zm h.le _)
            Subgroup.FiniteIndex.index_ne_zero
      _ ≤ (ZM _ δ ⊓ S5.bSub h.le L (baseA _)).relIndex (ZM _ δ) :=
          Subgroup.relIndex_le_of_le_left (le_sup_left.trans hY)
            Subgroup.FiniteIndex.index_ne_zero
      _ = (S5.bSub h.le L (baseA _)).relIndex (ZM _ δ) := Subgroup.inf_relIndex_left _ _
      _ ≤ 2 ^ k := hBδ
  have hV2 : IsPGroup 2 V :=
    (isPGroup_qv _ hyp (not_isMVtx_baseB _)).to_le
      (hVQ.trans (qv_le_qv _ hyp hα (adj_baseA_baseB _)))
  have hVst : V ≤ stab _ δ := hVQ.trans (qv_le_stab_of_dist_le_two _ hyp hα hdδ.le)
  have hmul : ∀ x ∈ V, ∃ z ∈ ZM _ m, z⁻¹ * x ∈ Qv _ δ :=
    fun x hx => S310.exists_mem_mul_qv h hd hδM hVst hV2 hZmV hcm.2.2 hrel
      (S512T.le_relIndex_qv_zm h hb4 hd hcm) hx
  have hcδm : IsCritical _ δ m := ms22_iii _ hyp hb0 h.centHyp hcm
  have hmid' : geo _ δ m 2 = baseA _ := by
    obtain ⟨-, -, -, hd4', -⟩ := S512T.pair_facts h hb4 hcm
    have := geo_symm _ (show 2 ≤ (puAmalgam h.le).treeGraph.dist m δ by omega)
    rw [hd4', hmidm] at this
    exact this
  have hVX := S512G.commutator_vv_le_xm h52 h hmin hb hd hc₁ hα
  have hV := S512G.secHyp_nclStab h32 h hb hδM hdδ hVX (S512L.zm_not_le_bSub h hb hcδm hmid')
  have hRX : ⁅ZM (puAmalgam h.le) m, ZM (puAmalgam h.le) δ⁆ ≤ XM _ (baseA (puAmalgam h.le)) :=
    (Subgroup.commutator_mono (S5B.zm_le_vv_of_dist hmM hdm.le)
      (S5B.zm_le_vv_of_dist hδM hdδ.le)).trans hVX
  have hD0 : S5.uSub h.le L δ ⊓ Subgroup.centralizer (ZM _ m : Set (puAmalgam h.le).Universal) ≤
      S5.bSub h.le L (baseA _) := by
    have := S512N.finite_zm h hδM
    have hP : (S5.bSub h.le L (baseA _)).relIndex (S5.uSub h.le L δ) ≤ 2 ^ k :=
      (Subgroup.relIndex_le_of_le_right (S5B.uSub_le_zm h.le δ)
        Subgroup.FiniteIndex.index_ne_zero).trans hBδ
    have hdm0 : 0 < (puAmalgam h.le).treeGraph.dist (baseA _) m := by omega
    have hdε : (puAmalgam h.le).treeGraph.dist (geo _ (baseA (puAmalgam h.le)) m 1) m = 1 := by
      rw [dist_geo_right _ (by omega), hdm]
    have hdmB : (puAmalgam h.le).treeGraph.dist m (baseB _) < critDist (puAmalgam h.le) := by
      have h1 := dist_triangle _ m (baseA (puAmalgam h.le)) (baseB _)
      have h2 : (puAmalgam h.le).treeGraph.dist m (baseA _) = 2 := by
        rw [SimpleGraph.dist_comm]; exact hdm
      rw [dist_eq_one_of_adj _ (adj_baseA_baseB _), h2] at h1
      omega
    exact (S5B.uSub_inf_bSub_eq_centralizer h hb hd hα (adj_baseA_baseB _)
      (adj_geo_one _ hdm0) hβδ hmM (by omega) (by omega) hdmB hcm.2.2 hP).1.symm.le.trans
        inf_le_right
  have hT0 : ∀ v ∈ V, ∀ s ∈ Qv _ (baseA (puAmalgam h.le)) ⊓ Subgroup.centralizer
      ((ZM _ δ ⊓ S5.bSub h.le L (baseA _) : Subgroup _) : Set (puAmalgam h.le).Universal),
      ⁅v, s⁆ ∈ ⁅ZM (puAmalgam h.le) m, ZM (puAmalgam h.le) δ⁆ :=
    fun v hv s hs => commutator_nclStab_le h hb4 hd hβδ hcm hmidm hqm hD0 hR4 hv hs
  have hT0₂ : ∀ v ∈ S5.nclStab _ (baseA (puAmalgam h.le))
      (ZM _ (geo _ (baseA (puAmalgam h.le)) c₂ 2)), ∀ s ∈ Qv _ (baseA (puAmalgam h.le)) ⊓
        Subgroup.centralizer ((ZM _ (geo _ (baseA (puAmalgam h.le)) c₂ 2) ⊓
          S5.bSub h.le L (baseA _) : Subgroup _) : Set (puAmalgam h.le).Universal),
      ⁅v, s⁆ ∈ ⁅ZM (puAmalgam h.le) m, ZM (puAmalgam h.le) δ⁆ := by
    rw [hmid]
    exact hT0
  have hZ₁ := S512T.zHat_eq h hd hc₁ hq₁
  have hZ₂ := S512T.zHat_eq h hd hc₂ hq₂
  have hX₁ : ⁅V ⊓ Qv _ δ, ZM _ c₁⁆ ≤ XM _ (baseA (puAmalgam h.le)) := by
    have key := commutator_nclStab_inf_le h32 hX2 h hb4 hd hc₁ hβ₁ hl' hR₁ hcent₁ hy₁ hy₁e hR4
      hRX hT0
    rwa [hZ₁] at key
  have hX₂ : ⁅V ⊓ Qv _ δ, ZM _ c₂⁆ ≤ XM _ (baseA (puAmalgam h.le)) := by
    have key := commutator_nclStab_inf_le h32 hX2 h hb4 hd hc₂ hβ₂ (hmid ▸ hl') (hmid ▸ hR₂)
      (hmid ▸ hcent₂) (hmid ▸ hy₂) hy₂e hR4 hRX hT0₂
    rwa [hmid, hZ₂] at key
  have hTs : Qv _ (baseB (puAmalgam h.le)) ≤ stab _ (baseA (puAmalgam h.le)) :=
    qv_le_stab_of_adj _ (adj_baseA_baseB _).symm
  have hTB2 : IsPGroup 2 (Qv (puAmalgam h.le) (baseB _)) := isPGroup_qv _ hyp (not_isMVtx_baseB _)
  have hZ₁B : ZM _ c₁ ≤ Qv _ (baseB (puAmalgam h.le)) := by
    have := (S512T.zm_facts h hb4 hc₁).1
    rwa [hβ₁] at this
  have hZ₂B : ZM _ c₂ ≤ Qv _ (baseB (puAmalgam h.le)) := by
    have := (S512T.zm_facts h hb4 hc₂).1
    rwa [hβ₂] at this
  have hEB : ZM _ c₁ ⊔ ZM _ c₂ ≤ Qv _ (baseB (puAmalgam h.le)) := sup_le hZ₁B hZ₂B
  have hEs : ZM _ c₁ ⊔ ZM _ c₂ ≤ stab _ (baseA (puAmalgam h.le)) := hEB.trans hTs
  have hE2 : IsPGroup 2 ↥(ZM (puAmalgam h.le) c₁ ⊔ ZM _ c₂) := hTB2.to_le hEB
  obtain ⟨hEc, hEsq⟩ := mem_qv_of_le_vPre_qLine h hd hl hE2 (hEB.trans hTl)
  have hVv : V ≤ Vv _ (baseA (puAmalgam h.le)) := S512N.nclStab_le_vv h hδM hdδ.le
  have hXB : XM _ (baseA (puAmalgam h.le)) ⊓ Vv _ (baseA (puAmalgam h.le)) ≤
      S5.bSub h.le L (baseA _) := by
    intro x hx
    refine Subgroup.subset_closure ⟨hx.2, fun y hy => ?_⟩
    exact S5B.uSub_le_zm h.le _ (S5C56.commutator_xm_puTrans_le_uSub h32 h
      (Subgroup.commutator_mem_commutator hx.1 hy))
  have hN : ∀ {e n : (puAmalgam h.le).Universal}, e ∈ stab _ (baseA (puAmalgam h.le)) →
      n ∈ V ⊓ S5.bSub h.le L (baseA _) → e * n * e⁻¹ ∈ V ⊓ S5.bSub h.le L (baseA _) :=
    fun he hn => ⟨(Subgroup.mem_normalizer_iff.1 (hV.vn he) _).1 hn.1,
      (Subgroup.mem_normalizer_iff.1 (S310.stab_le_normalizer_bSub h _ he) _).1 hn.2⟩
  have hfix : ∀ w ∈ V ⊓ Qv _ δ, ∀ e ∈ ZM _ c₁ ⊔ ZM _ c₂,
      e * w * e⁻¹ * w⁻¹ ∈ V ⊓ S5.bSub h.le L (baseA _) := by
    intro w hw
    let S : Subgroup (puAmalgam h.le).Universal :=
      { carrier := {e | e ∈ stab _ (baseA (puAmalgam h.le)) ∧
          e * w * e⁻¹ * w⁻¹ ∈ V ⊓ S5.bSub h.le L (baseA _)}
        one_mem' := ⟨one_mem _, by
          rw [one_mul, inv_one, mul_one, mul_inv_cancel]
          exact one_mem _⟩
        mul_mem' := by
          rintro e₁ e₂ ⟨h₁, k₁⟩ ⟨h₂, k₂⟩
          refine ⟨mul_mem h₁ h₂, ?_⟩
          have e : e₁ * e₂ * w * (e₁ * e₂)⁻¹ * w⁻¹ =
              e₁ * (e₂ * w * e₂⁻¹ * w⁻¹) * e₁⁻¹ * (e₁ * w * e₁⁻¹ * w⁻¹) := by group
          rw [e]
