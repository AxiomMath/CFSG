        inv_mem' := by
          rintro e ⟨he, ke⟩
          refine ⟨inv_mem he, ?_⟩
          have e' : e⁻¹ * w * e⁻¹⁻¹ * w⁻¹ = e⁻¹ * (e * w * e⁻¹ * w⁻¹)⁻¹ * e⁻¹⁻¹ := by group
          rw [e']
          exact hN (inv_mem he) (inv_mem ke) }
    have hS : ∀ {c : Vtx (puAmalgam h.le)}, ⁅V ⊓ Qv _ δ, ZM _ c⁆ ≤ XM _ (baseA (puAmalgam h.le)) →
        ZM _ c ≤ stab _ (baseA (puAmalgam h.le)) → ZM _ c ≤ S := by
      intro c hXc hsc e he
      have hwe : e * w * e⁻¹ * w⁻¹ ∈ V :=
        mul_mem ((Subgroup.mem_normalizer_iff.1 (hV.vn (hsc he)) w).1 hw.1) (inv_mem hw.1)
      refine ⟨hsc he, Subgroup.mem_inf.2 ⟨hwe, hXB (Subgroup.mem_inf.2 ⟨?_, hVv hwe⟩)⟩⟩
      have e2 : e * w * e⁻¹ * w⁻¹ = ⁅w, e⁆⁻¹ := by
        rw [commutatorElement_inv, commutatorElement_def]
      rw [e2]
      exact inv_mem (hXc (Subgroup.commutator_mem_commutator hw he))
    intro e he
    exact (sup_le (hS hX₁ (hZ₁B.trans hTs)) (hS hX₂ (hZ₂B.trans hTs)) he).2
  have hEW : (S36E.fixSec V (V ⊓ S5.bSub h.le L (baseA _)) (ZM _ c₁ ⊔ ZM _ c₂)
      (hV.le_stab.trans hV.le_normalizer_inf)).relIndex V ≤ 2 ^ k := by
    have := S512N.finite_zm h hmM
    have hNV : ∀ x ∈ V, ∃ z ∈ ZM _ m, z⁻¹ * x ∈ S36E.fixSec V (V ⊓ S5.bSub h.le L (baseA _))
        (ZM _ c₁ ⊔ ZM _ c₂) (hV.le_stab.trans hV.le_normalizer_inf) := by
      intro x hx
      obtain ⟨z, hz, hzx⟩ := hmul x hx
      have hzxV : z⁻¹ * x ∈ V := mul_mem (inv_mem (hZmV hz)) hx
