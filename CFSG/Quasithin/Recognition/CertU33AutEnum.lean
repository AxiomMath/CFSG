@[expose] def autId : List Nat := List.range 28

@[expose] def autPow (l : List Nat) (n : Nat) : List Nat := (List.replicate n l).foldr compL autId

@[expose] def autRelT (a b s : List Nat) : Bool :=
  autPow a 4 == autId && autPow b 4 == autId && autPow s 2 == autId &&
    compL a b == compL b a && compL (compL s a) s == b && compL (compL s b) s == a

@[expose] def autRelX (a b s x : List Nat) : Bool :=
  autPow x 3 == autId && compL a x == compL x b && compL (compL (compL b x) b) a == x &&
    autPow (compL x s) 2 == autId

@[expose] def autRelY (a b s y : List Nat) : Bool :=
  autPow y 3 == autId &&
    compL (compL (compL (compL (compL (compL a b) s) y) s) a) a == y &&
    compL (compL (compL (compL s a) a) y) b == compL y a &&
    compL (compL (compL (compL s y) s) a) y == a

@[expose] def u33AutEnum : List (Nat × Nat × Nat × Nat × Nat) :=
  (List.range 32).flatMap fun ia =>
    if autPow (u33TelTab.getD ia []) 4 == autId && u33TelTab.getD ia [] != autId then
      (List.range 32).flatMap fun ib =>
        if autPow (u33TelTab.getD ib []) 4 == autId &&
            compL (u33TelTab.getD ia []) (u33TelTab.getD ib []) ==
              compL (u33TelTab.getD ib []) (u33TelTab.getD ia []) then
          (List.range 32).flatMap fun is =>
            if autRelT (u33TelTab.getD ia []) (u33TelTab.getD ib []) (u33TelTab.getD is []) then
              (List.range 160).flatMap fun ix =>
                if autRelX (u33TelTab.getD ia []) (u33TelTab.getD ib []) (u33TelTab.getD is [])
                    (u33ABTab.getD ix []) then
                  (List.range 160).flatMap fun iy =>
                    if autRelY (u33TelTab.getD ia []) (u33TelTab.getD ib [])
                        (u33TelTab.getD is []) (u33ABTab.getD iy []) then
                      [(ia, ib, is, ix, iy)]
                    else []
                else []
            else []
        else []
    else []

theorem u33AutEnum_length : u33AutEnum.length = 64 := by
  decide +kernel

end CFSG.Quasithin
