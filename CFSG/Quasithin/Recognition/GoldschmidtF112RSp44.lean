section RootAxis

variable {G : Type} [Group G] {K : Type} [Field K]
  {U A : Subgroup G} {s : SL₂ K →* G} {d : Kˣ →* G} {coord : K → G} {vec : G → Fin 2 → K}

@[expose] def trU (K : Type) [Field K] : SL₂ K := ⟨!![1, 1; 0, 1], by simp [det_fin_two]⟩

@[expose] def trL (K : Type) [Field K] : SL₂ K := ⟨!![1, 0; 1, 1], by simp [det_fin_two]⟩

theorem RA.vec_one (hS : RootAxisStructure U A s d coord vec) : vec 1 = 0 := by
  have h := hS.vec_add 1 A.one_mem 1 A.one_mem
  rw [mul_one] at h
  exact left_eq_add.mp h

theorem RA.vec_inv (hS : RootAxisStructure U A s d coord vec) {z : G} (hz : z ∈ A) :
    vec z⁻¹ = -vec z := by
  have h := hS.vec_add z hz z⁻¹ (A.inv_mem hz)
  rw [mul_inv_cancel, RA.vec_one hS] at h
  exact eq_neg_of_add_eq_zero_right h.symm

theorem eq_zero_of_fixed_tr {v : Fin 2 → K} (h1 : ((trU K : SL₂ K) : Matrix _ _ K) *ᵥ v = v)
    (h2 : ((trL K : SL₂ K) : Matrix _ _ K) *ᵥ v = v) : v = 0 := by
  have a := congrFun h1 0
  have b := congrFun h2 1
  simp [trU, trL, mulVec, dotProduct, Fin.sum_univ_two] at a b
  ext i
  fin_cases i <;> simp [a, b]

theorem eq_one_of_fixed {M : SL₂ K} (h : ∀ v : Fin 2 → K, (M : Matrix _ _ K) *ᵥ v = v) : M = 1 := by
  ext i j
  have := congrFun (h (Pi.single j 1)) i
  rw [mulVec_single_one] at this
  simpa [Matrix.one_apply, Pi.single_apply, eq_comm] using this

variable [Finite G]

local notation "C" => Subgroup.centralizer (U : Set G)

theorem RA.blockQ_eq (hS : RootAxisStructure U A s d coord vec) : blockQ C = A := by
  rw [blockQ, pCoreOf, CFSG.Open.pCore_eq_pCore, hS.C_pCore, Subgroup.subgroupOf_map_subtype]
  exact inf_eq_left.mpr hS.A_le_C

theorem RA.blockU_eq (hS : RootAxisStructure U A s d coord vec) : blockU C = A := by
  rw [blockU, (RA.blockQ_eq hS)]
  have hAC := hS.A_le_C
  set A' := A.subgroupOf C with hA'
  haveI hA'n : A'.Normal := ⟨fun a ha g => by
    rw [hA', Subgroup.mem_subgroupOf] at ha ⊢
    exact hS.A_normal_C g g.2 a ha⟩
  have himg : ⁅A, C⁆ = (⁅A', (⊤ : Subgroup C)⁆).map (Subgroup.centralizer (U : Set G)).subtype := by
    rw [Subgroup.map_commutator, hA', Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hAC,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  have hle : ⁅A, C⁆ ≤ A := by
    rw [Subgroup.commutator_le]
    intro a ha g hg
    rw [commutatorElement_def, show a * g * a⁻¹ * g⁻¹ = a * (g * a⁻¹ * g⁻¹) by group]
    exact A.mul_mem ha (hS.A_normal_C g hg _ (A.inv_mem ha))
  refine hS.normal_eq_A _ (hle.trans hAC) ?_ hle ?_
  · intro g hg v hv
    rw [himg] at hv ⊢
    obtain ⟨w, hw, rfl⟩ := hv
    refine ⟨⟨g, hg⟩ * w * ⟨g, hg⟩⁻¹, (Subgroup.commutator_normal A' ⊤).conj_mem w hw _, rfl⟩
  ·
    intro hU
    obtain ⟨z, hz, hzv⟩ := hS.vec_surj ![0, 1]
    have hc : ⁅z, s (trU K)⁆ ∈ ⁅A, C⁆ :=
      Subgroup.commutator_mem_commutator hz (hS.s_mem_C _)
    have hcA : s (trU K) * z⁻¹ * (s (trU K))⁻¹ ∈ A :=
      hS.A_normal_C _ (hS.s_mem_C _) _ (A.inv_mem hz)
    have h0 := (hS.vec_ker _ (hle hc)).mpr (hU hc)
    rw [commutatorElement_def, mul_assoc, mul_assoc, ← mul_assoc (s _), hS.vec_add z hz _ hcA,
      hS.vec_conj _ _ (A.inv_mem hz), (RA.vec_inv hS) hz, hzv] at h0
    have := congrFun h0 0
    simp [trU, mulVec, dotProduct, Fin.sum_univ_two] at this

theorem RA.blockZ_eq (hS : RootAxisStructure U A s d coord vec) (hUA : U ≤ A) :
    blockZ C = U := by
  rw [blockZ, (RA.blockU_eq hS)]
  apply le_antisymm
  · rintro z ⟨hz, hzc⟩
    rw [← hS.vec_ker z hz]
    have hfix : ∀ M : SL₂ K, (M : Matrix _ _ K) *ᵥ vec z = vec z := by
      intro M
      rw [← hS.vec_conj M z hz, Subgroup.mem_centralizer_iff.mp hzc _ (hS.s_mem_C M),
        mul_inv_cancel_right]
    exact eq_zero_of_fixed_tr (hfix _) (hfix _)
  · intro z hz
    refine ⟨hUA hz, Subgroup.mem_centralizer_iff.mpr fun g hg => ?_⟩
    exact (Subgroup.mem_centralizer_iff.mp hg z hz).symm

@[expose] noncomputable def RA.quotEquiv (hS : RootAxisStructure U A s d coord vec) :
    SL₂ K ≃* (C ⧸ CFSG.pCore 2 C) :=
  MulEquiv.ofBijective
    ((QuotientGroup.mk' (CFSG.pCore 2 C)).comp (s.codRestrict C hS.s_mem_C))
    (by
      obtain ⟨hs, hb⟩ := hS.quot_bijective
      rw [← hS.C_pCore] at hb
      exact hb)

theorem RA.quotEquiv_apply (hS : RootAxisStructure U A s d coord vec)
    (M : SL₂ K) : RA.quotEquiv hS M = QuotientGroup.mk (⟨s M, hS.s_mem_C M⟩ : C) := rfl

theorem RA.quotEquiv_symm_mk (hS : RootAxisStructure U A s d coord vec)
    {a : G} (ha : a ∈ A) (M : SL₂ K) (hg : a * s M ∈ C) :
    (RA.quotEquiv hS).symm (QuotientGroup.mk (⟨a * s M, hg⟩ : C)) = M := by
  rw [MulEquiv.symm_apply_eq, RA.quotEquiv_apply, QuotientGroup.eq, hS.C_pCore,
    Subgroup.mem_subgroupOf]
  have := hS.A_normal_C _ (Subgroup.inv_mem _ (hS.s_mem_C M)) _ (A.inv_mem ha)
  simpa [mul_assoc] using this

theorem RA.isShort2 (hS : RootAxisStructure U A s d coord vec) [Finite K]
    (h4 : 4 ≤ Nat.card K) (hUA : U ≤ A) (hA : IsElemAbelian 2 A) : IsShort2 C := by
  have hQ := (RA.blockQ_eq hS)
  have hU := (RA.blockU_eq hS)
  have hZ := RA.blockZ_eq hS hUA
  have hperf := hS.C_perfect
  refine ⟨?_, ?_, ⟨?_, ?_⟩, Or.inl ?_, ?_, ?_⟩
  · intro N _ hN
    by_contra hne
    have : Nontrivial (C ⧸ N) := by
      rw [← not_subsingleton_iff_nontrivial]
      intro hsub
      apply hne
      rw [eq_top_iff]
      intro x _
      have : (x : C ⧸ N) = 1 := Subsingleton.elim _ _
      rwa [QuotientGroup.eq_one_iff] at this
    have hperfQ : Group.IsPerfect (C ⧸ N) :=
      Group.IsPerfect.ofSurjective (f := QuotientGroup.mk' N) (QuotientGroup.mk'_surjective N)
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    have : Group.IsNilpotent (C ⧸ N) := hN.isNilpotent
    exact Group.IsPerfect.not_isSolvable (C ⧸ N) inferInstance
  · show C ⊓ Subgroup.centralizer (pCoreOf 2 C : Set G) ≤ pCoreOf 2 C
    rw [← blockQ, hQ]
    rintro g ⟨hg, hgc⟩
    obtain ⟨a, ha, M, rfl⟩ := hS.C_decomp g hg
    have hsc : ∀ z ∈ A, s M * z * (s M)⁻¹ = z := by
      intro z hz
      have h1 := Subgroup.mem_centralizer_iff.mp hgc z hz
      have h2 : a * z = z * a := Subtype.ext_iff.mp (hA.1.is_comm.comm ⟨a, ha⟩ ⟨z, hz⟩)
      have h3 : s M * z = z * s M := by
        apply mul_left_cancel (a := a)
        calc a * (s M * z) = a * s M * z := (mul_assoc _ _ _).symm
          _ = z * (a * s M) := by first | exact h1 | exact h1.symm
          _ = z * a * s M := (mul_assoc _ _ _).symm
          _ = a * z * s M := by rw [← h2]
          _ = a * (z * s M) := mul_assoc _ _ _
      rw [h3, mul_inv_cancel_right]
    have hM : M = 1 := eq_one_of_fixed fun v => by
      obtain ⟨z, hz, rfl⟩ := hS.vec_surj v
      rw [← hS.vec_conj M z hz, hsc z hz]
    rw [hM, map_one, mul_one]
    exact ha
  · rw [hU, hQ]
    refine le_inf le_rfl fun x hx => Subgroup.mem_centralizer_iff.mpr fun y hy => ?_
    exact congrArg Subtype.val (hA.1.is_comm.comm ⟨y, hy⟩ ⟨x, hx⟩)
  · intro x hx
    rw [hU] at hx
    exact hA.2 x hx
  · have e : (C ⧸ CFSG.pCore 2 C) ≃* SL₂ K :=
      (RA.quotEquiv hS).symm
    exact CFSG.IsQuasisimple.of_mulEquiv e
      (CFSG.GH74.GLS.IVK.Lifted.isQuasisimple_sl2' h4)
  · rw [hZ, hU]
    refine lt_of_le_of_ne hUA fun h => ?_
    obtain ⟨z, hz, hzv⟩ := hS.vec_surj ![1, 0]
    have := (hS.vec_ker z hz).mpr (h ▸ hz)
    rw [hzv] at this
    simpa using congrFun this 0
  · intro W hZW hWU hN
    rw [hZ] at hZW ⊢
    rw [hU] at hWU ⊢
    by_cases hW : W ≤ U
    · exact Or.inl (le_antisymm hW hZW)
    · refine Or.inr (hS.normal_eq_A W (hWU.trans hS.A_le_C) (fun g hg v hv => ?_) hWU hW)
      exact (Subgroup.mem_normalizer_iff.mp (hN hg) v).mp hv

theorem RA.isLin2Type (hS : RootAxisStructure U A s d coord vec) [Fintype K]
    {n : ℕ} (hK : Fintype.card K = 2 ^ n) (hUA : U ≤ A) (hA : IsElemAbelian 2 A) :
    IsLin2Type C n := by
  classical
  have hU := (RA.blockU_eq hS)
  have hZ := RA.blockZ_eq hS hUA
  refine ⟨K, inferInstance, inferInstance, hK, ?_⟩
  set α : C →* SL₂ K :=
    (RA.quotEquiv hS).symm.toMonoidHom.comp (QuotientGroup.mk' (CFSG.pCore 2 C)) with hα
  refine ⟨α, ?_, ?_, ?_⟩
  · intro M
    obtain ⟨g, hg⟩ := QuotientGroup.mk'_surjective (CFSG.pCore 2 C) (RA.quotEquiv hS M)
    exact ⟨g, by rw [hα, MonoidHom.comp_apply, hg, MulEquiv.coe_toMonoidHom,
      MulEquiv.symm_apply_apply]⟩
  · ext x
    rw [MonoidHom.mem_ker, hα, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      MulEquiv.map_eq_one_iff, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  have hUA' : ∀ u : blockU C, (u : G) ∈ A := fun u => hU ▸ u.2
  let β : blockU C →* Multiplicative (Fin 2 → K) :=
    { toFun := fun u => Multiplicative.ofAdd (vec u)
      map_one' := by
        show Multiplicative.ofAdd (vec 1) = 1
        rw [(RA.vec_one hS)]
        rfl
      map_mul' := fun u v => by
        show Multiplicative.ofAdd (vec ((u : G) * v)) = _
        rw [hS.vec_add _ (hUA' u) _ (hUA' v)]
        rfl }
  refine ⟨β, ?_, ?_, ?_⟩
  · intro w
    obtain ⟨z, hz, hzv⟩ := hS.vec_surj (Multiplicative.toAdd w)
    exact ⟨⟨z, hU ▸ hz⟩, by
      show Multiplicative.ofAdd (vec z) = w
      rw [hzv]
      rfl⟩
  · ext u
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, hZ, ← hS.vec_ker _ (hUA' u)]
    exact ⟨fun h => congrArg Multiplicative.toAdd h, fun h => congrArg Multiplicative.ofAdd h⟩
  · intro ℓ u v huv
    obtain ⟨a, ha, M, hℓ⟩ := hS.C_decomp ℓ ℓ.2
    have hαℓ : α ℓ = M := by
      have h1 : ℓ = ⟨a * s M, hℓ ▸ ℓ.2⟩ := Subtype.ext hℓ
      rw [hα, MonoidHom.comp_apply, h1]
      exact (RA.quotEquiv_symm_mk hS) ha M _
    show vec v = (α ℓ : Matrix _ _ K) *ᵥ vec u
    rw [hαℓ, huv, Subgroup.coe_inv, hℓ]
    have hcA : s M * u * (s M)⁻¹ ∈ A := hS.A_normal_C _ (hS.s_mem_C M) _ (hUA' u)
    have h2 : a * s M * u * (a * s M)⁻¹ = s M * u * (s M)⁻¹ := by
      have hc : a * (s M * u * (s M)⁻¹) = (s M * u * (s M)⁻¹) * a :=
        Subtype.ext_iff.mp (hA.1.is_comm.comm ⟨a, ha⟩ ⟨_, hcA⟩)
      calc a * s M * u * (a * s M)⁻¹ = a * (s M * u * (s M)⁻¹) * a⁻¹ := by group
        _ = s M * u * (s M)⁻¹ := by rw [hc, mul_inv_cancel_right]
    rw [h2, hS.vec_conj M _ (hUA' u)]

end RootAxis

section Vertex

open CFSG.Quasithin CFSG.Quasithin.H13.F431 CFSG.Quasithin.H13.F431.SpModel
  CFSG.ComponentClassification.UnbalancedCatalog.SpChain

variable {F : Type} [Field F] [Finite F] [CharP F 2] {n : ℕ}

theorem sp_vertex (hn : 2 ≤ n) (hF : Nat.card F = 2 ^ n) (j : Fin 2) :
    IsShort2 (perfectCore (Subgroup.normalizer (Rrad F j : Set (antiSp F)))) ∧
      IsLin2Type (perfectCore (Subgroup.normalizer (Rrad F j : Set (antiSp F)))) n := by
  have := Fintype.ofFinite F
  have hS := hS_axis hn hF j
  have h4 : 4 ≤ Nat.card F := by
    rw [hF]
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
  have hA := CFSG.Quasithin.H13.KGE623A3.isElemAbelian_rootA (K := F) (axisOf j)
  rw [← rootA_axisOf j, axis_perfectCore_normalizer hS]
  exact ⟨RA.isShort2 hS h4 (rootU_le_rootA j) hA,
    RA.isLin2Type hS (by rw [← Nat.card_eq_fintype_card, hF]) (rootU_le_rootA j) hA⟩

end Vertex

section Transport

open CFSG.Quasithin CFSG.Quasithin.H13.NQCat.A314D CFSG.QuasithinUnique.Setup.Wreath

theorem perfectCore_map_inj {D H : Type} [Group D] [Group H] (φ : D →* H)
    (hφ : Function.Injective φ) (X : Subgroup D) :
    perfectCore (X.map φ) = (perfectCore X).map φ := by
  unfold perfectCore
  rw [Subgroup.map_iInf φ hφ]
  congr 1
  funext n
  exact (map_derivedSeriesOf φ X n).symm

theorem short_lin2_of_perfectCore {G H : Type} [Group G] [Group H] {L P : Subgroup G}
    {N : Subgroup H} {n : ℕ} (hL : perfectCore P = L) (ψ : ↥P ≃* ↥N)
    (h : IsShort2 (perfectCore N) ∧ IsLin2Type (perfectCore N) n) :
    IsShort2 L ∧ IsLin2Type L n := by
  let g : ↥P →* H := N.subtype.comp ψ.toMonoidHom
  have hg : Function.Injective g := N.subtype_injective.comp ψ.injective
  have hN : (⊤ : Subgroup ↥P).map g = N := by
    rw [← MonoidHom.range_eq_map, MonoidHom.range_comp,
      MonoidHom.range_eq_top_of_surjective _ ψ.surjective, ← MonoidHom.range_eq_map,
      Subgroup.range_subtype]
  have hP : (⊤ : Subgroup ↥P).map P.subtype = P := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  have hN' : perfectCore N = (perfectCore (⊤ : Subgroup ↥P)).map g := by
    rw [← hN, perfectCore_map_inj g hg]
  have hL' : L = (perfectCore (⊤ : Subgroup ↥P)).map P.subtype := by
    rw [← hL, ← hP, perfectCore_map_inj P.subtype P.subtype_injective, hP]
  rw [hN'] at h
  rw [hL']
  exact ⟨IsShort2.map_of_injective P.subtype P.subtype_injective
      (IsShort2.of_map_injective g hg h.1),
    IsLin2Type.map_of_injective' P.subtype P.subtype_injective
      (IsLin2Type.of_map_injective g hg h.2)⟩

end Transport

section Main

open CFSG.Quasithin CFSG.Quasithin.H13.F431 CFSG.Quasithin.H13.F431.SpModel
  CFSG.ComponentClassification.UnbalancedCatalog.SpChain
  CFSG.Quasithin.H13.Ch9.F112Pf CFSG.LieType.BorelTits

variable {G : Type} [Group G] [Finite G]

theorem perfectCore_vertex {L B : Subgroup G} (hBL : B ≤ Subgroup.normalizer (L : Set G))
    (hB : Group.IsSolvable ↥B) (hL : perfectCore L = L) : perfectCore (L ⊔ B) = L := by
  have hLP : L ≤ L ⊔ B := le_sup_left
  have hn : (L.subgroupOf (L ⊔ B)).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hLP).2 (sup_le Subgroup.le_normalizer hBL)
  refine le_antisymm (perfectCore_le_of_sup_solvable hLP hn rfl hB) ?_
  calc L = perfectCore L := hL.symm
    _ ≤ perfectCore (L ⊔ B) := perfectCore_mono hLP

theorem y9Sp44 : Y9Sp44 := by
  intro G _ _ L1 L2 S hF h1 h2 hA
  have hPO := perfectOver_sp44 hF h1 h2 hA
  obtain ⟨hB, -, -⟩ := vFact_of_hasModelFacts h1 h2 (hasModelFacts_sp4 2 le_rfl) hA
  obtain ⟨hB1, hB2⟩ := bigB_le_normalizer hF.1
  have hc1 := perfectCore_vertex hB1 hB hPO.1
  have hc2 := perfectCore_vertex hB2 hB hPO.2.1
  obtain ⟨Y, _, hY, T, M₁, M₂, hp, ⟨iso0⟩⟩ := hA
  have hL : CFSG.Blueprint.LieModel Y .PSp 2 2 2 := by
    rcases hY with ⟨h, -⟩ | ⟨-, hL⟩
    · exact absurd h (by norm_num)
    · exact hL
  obtain ⟨hf, F, _, _, _, hFcard, ⟨e1⟩⟩ := exists_equiv_antiSp hL
  have hy1 := hp.map e1
  obtain ⟨h, -, hh⟩ := IsSylowTwoOf.exists_conj hy1.1 (borel_antiSp (F := F) hf hFcard).sylow
  let E : Y ≃* antiSp F := e1.trans (MulAut.conj h)
  have hy2 : IsYAmalgamPair (antiUnipotent F) (M₁.map E.toMonoidHom) (M₂.map E.toMonoidHom) := by
    have := hp.map E
    have hTD : T.map E.toMonoidHom = antiUnipotent F := by
      rw [hh, Subgroup.map_map]
      rfl
    rwa [hTD] at this
  have ψ1 : ↥(L1 ⊔ bigB L1 L2 S) ≃* ↥(M₁.map E.toMonoidHom) :=
    iso0.φ1.trans (M₁.equivMapOfInjective E.toMonoidHom E.injective)
  have ψ2 : ↥(L2 ⊔ bigB L1 L2 S) ≃* ↥(M₂.map E.toMonoidHom) :=
    iso0.φ2.trans (M₂.equivMapOfInjective E.toMonoidHom E.injective)
  have hv : (IsShort2 (perfectCore (M₁.map E.toMonoidHom)) ∧
        IsLin2Type (perfectCore (M₁.map E.toMonoidHom)) 2) ∧
      (IsShort2 (perfectCore (M₂.map E.toMonoidHom)) ∧
        IsLin2Type (perfectCore (M₂.map E.toMonoidHom)) 2) := by
    rcases yam_antiSp hf hFcard hy2 with ⟨e₁, e₂⟩ | ⟨e₁, e₂⟩
    · rw [e₁, e₂]
      exact ⟨sp_vertex hf hFcard 0, sp_vertex hf hFcard 1⟩
    · rw [e₁, e₂]
      exact ⟨sp_vertex hf hFcard 1, sp_vertex hf hFcard 0⟩
  obtain ⟨hs1, hl1⟩ := short_lin2_of_perfectCore hc1 ψ1 hv.1
  obtain ⟨hs2, hl2⟩ := short_lin2_of_perfectCore hc2 ψ2 hv.2
  exact ⟨⟨Gold14610.isBlock2_of_short hs1 le_rfl Subgroup.le_normalizer, hl1⟩,
    ⟨Gold14610.isBlock2_of_short hs2 le_rfl Subgroup.le_normalizer, hl2⟩, hPO⟩

end Main

