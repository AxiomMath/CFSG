@[expose] def u33W (s : String) : List (ℕ × Bool) :=
  (u33Word s).map fun l => (l.1.val, l.2)

@[expose] def u33W4 (s : String) : List (ℕ × Bool) :=
  s.toList.map fun c => ("absd".toList.idxOf c.toLower, c.isLower)

@[expose] def u33TelW (i : ℕ) : List (ℕ × Bool) := u33W (u33TelWords.getD i "")

@[expose] def u33DW (j : ℕ) : List (ℕ × Bool) := u33W (u33DWords.getD j "")

@[expose] def u33Tel {G : Type*} [Group G] (gen : ℕ → G) (i : ℕ) : G := wordProd gen (u33TelW i)

@[expose] def u33D {G : Type*} [Group G] (gen : ℕ → G) (j : ℕ) : G := wordProd gen (u33DW j)

@[expose] def u33Gen4 {G : Type*} [Group G] (gen : ℕ → G) (d : G) (i : ℕ) : G :=
  if i = 0 then gen 0 else if i = 1 then gen 1 else if i = 2 then gen 2 else d

@[expose] def u33GenP (i : ℕ) : Equiv.Perm (Fin 28) := if h : i < 5 then u33Img ⟨i, h⟩ else 1

@[expose] def u33Nxt (i g : ℕ) : ℕ := u33TelNext.getD (3 * i + g) 0

@[expose] def u33DecXk (j i : ℕ) : ℕ := u33DecX.getD (3 * (32 * j + i)) 0

@[expose] def u33DecXa (j i : ℕ) : ℕ := u33DecX.getD (3 * (32 * j + i) + 1) 0

@[expose] def u33DecXb (j i : ℕ) : ℕ := u33DecX.getD (3 * (32 * j + i) + 2) 0

@[expose] def u33DecYk (j i : ℕ) : ℕ := u33DecY.getD (3 * (32 * j + i)) 0

@[expose] def u33DecYa (j i : ℕ) : ℕ := u33DecY.getD (3 * (32 * j + i) + 1) 0

@[expose] def u33DecYb (j i : ℕ) : ℕ := u33DecY.getD (3 * (32 * j + i) + 2) 0

