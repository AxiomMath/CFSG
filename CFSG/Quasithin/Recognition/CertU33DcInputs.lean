@[expose] def u33WordL (w : List (ℕ × Bool)) : List Nat :=
  w.foldr (fun l acc =>
    compL (if l.2 then u33GenTab.getD l.1 [] else u33GenInvTab.getD l.1 []) acc) (List.range 28)

@[expose] def u33InvW (w : List (ℕ × Bool)) : List (ℕ × Bool) :=
  w.reverse.map fun l => (l.1, !l.2)

@[expose] def u33PosL4 (j i : ℕ) : List Nat :=
  if i = 0 then u33GenTab.getD 0 [] else if i = 1 then u33GenTab.getD 1 []
  else if i = 2 then u33GenTab.getD 2 [] else u33DTab.getD j []

@[expose] def u33NegL4 (j i : ℕ) : List Nat :=
  if i = 0 then u33GenInvTab.getD 0 [] else if i = 1 then u33GenInvTab.getD 1 []
  else if i = 2 then u33GenInvTab.getD 2 [] else u33DInvTab.getD j []

@[expose] def u33WordL4 (j : ℕ) (w : List (ℕ × Bool)) : List Nat :=
  w.foldr (fun l acc => compL (if l.2 then u33PosL4 j l.1 else u33NegL4 j l.1) acc)
    (List.range 28)

@[expose] def u33A2 : Equiv.Perm (Fin 28) := u33GenP 0 * u33GenP 0

@[expose] def u33B2 : Equiv.Perm (Fin 28) := u33GenP 1 * u33GenP 1

@[expose] def u33Z : Equiv.Perm (Fin 28) := u33A2 * u33B2

@[expose] def u33V3 : Fin 3 → Equiv.Perm (Fin 28) := ![u33A2, u33B2, u33Z]

@[expose] def u33A2Tab : List Nat := compL (u33GenTab.getD 0 []) (u33GenTab.getD 0 [])

@[expose] def u33B2Tab : List Nat := compL (u33GenTab.getD 1 []) (u33GenTab.getD 1 [])

@[expose] def u33ZTab : List Nat := compL u33A2Tab u33B2Tab

@[expose] def u33VTab (i : ℕ) : List Nat :=
  if i = 0 then u33A2Tab else if i = 1 then u33B2Tab else u33ZTab

