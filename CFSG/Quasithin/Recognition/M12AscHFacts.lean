theorem zTab_eval : tabOf (ascHImg 0 * ascHImg 0) = zTab := by decide +kernel

theorem qTabs_sub : ∀ t ∈ qTabs, t ∈ ascHTabs := by decide +kernel
theorem tid_mem_q : tid ∈ qTabs := by decide +kernel
theorem qTabs_mul : ∀ s ∈ qTabs, ∀ t ∈ qTabs, tmul s t ∈ qTabs := by decide +kernel
theorem qTabs_inv : ∀ t ∈ qTabs, ∃ s ∈ qTabs, tmul t s = tid := by decide +kernel
@[expose] def normWitQ (Q : List (List (Fin 12))) (h : List (Fin 12)) :
    List (List (Fin 12)) → List ℕ → Bool
  | q :: qs, j :: js =>
      (Nat.blt j Q.length && tmul h q == tmul (Q.getD j []) h) && normWitQ Q h qs js
  | [], [] => true
  | _, _ => false

@[expose] def normWitH (Q : List (List (Fin 12))) : List (List (Fin 12)) → List (List ℕ) → Bool
  | h :: hs, w :: ws => normWitQ Q h Q w && normWitH Q hs ws
  | [], [] => true
  | _, _ => false

theorem normWitQ_spec (Q : List (List (Fin 12))) (h : List (Fin 12)) :
    ∀ qs js, normWitQ Q h qs js = true → ∀ q ∈ qs, ∃ q' ∈ Q, tmul h q = tmul q' h
  | [], _, _, q, hq => absurd hq List.not_mem_nil
  | _ :: _, [], hw, _, _ => by simp [normWitQ] at hw
  | q₀ :: qs, j :: js, hw, q, hq => by
    simp only [normWitQ, Bool.and_eq_true, Nat.blt_eq, beq_iff_eq] at hw
    obtain ⟨⟨hj, he⟩, hr⟩ := hw
    rcases List.mem_cons.1 hq with rfl | hq
    · refine ⟨Q.getD j [], ?_, he⟩
      rw [List.getD_eq_getElem _ _ hj]
      exact List.getElem_mem hj
    · exact normWitQ_spec Q h qs js hr q hq

theorem normWitH_spec (Q : List (List (Fin 12))) :
    ∀ hs ws, normWitH Q hs ws = true → ∀ h ∈ hs, ∀ q ∈ Q, ∃ q' ∈ Q, tmul h q = tmul q' h
  | [], _, _, h, hh => absurd hh List.not_mem_nil
  | _ :: _, [], hw, _, _ => by simp [normWitH] at hw
  | h₀ :: hs, w :: ws, hw, h, hh => by
    simp only [normWitH, Bool.and_eq_true] at hw
    rcases List.mem_cons.1 hh with rfl | hh
    · exact normWitQ_spec Q h Q w hw.1
    · exact normWitH_spec Q hs ws hw.2 h hh

