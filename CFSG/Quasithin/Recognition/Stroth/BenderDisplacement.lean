private theorem binaryNaturalSz_index_eq
    (a : ℕ) {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2 ^ (2 * a + 1))
    {W : Type} [CommGroup W] [Finite W] (hW : ∀ w : W, w * w = 1)
    {L : Subgroup (MulAut W)} (hnat : BinaryNaturalSz L ⊤ ⊥ (2 * a + 1))
    {t : MulAut W} (htL : t ∈ L) (ht2 : t * t = 1) (ht1 : t ≠ 1) :
    (fixV (Subgroup.zpowers t)).index = 2 ^ (2 * (2 * a + 1)) := by
  classical
  haveI : Fact (∀ w : W, w * w = 1) := ⟨hW⟩
  obtain ⟨a', ha', hf', K', _, _, hK', π, hπ⟩ := hnat
  have hK'' : Nat.card K' = 2 ^ (2 * a' + 1) := by rw [← hf']; exact hK'
  let Γ : Subgroup (Matrix.GeneralLinearGroup (Fin 4) K') := suzukiGroup a' K'
  let D : FFModel := FFModel.nat Γ
  have hfaith : FFModel.Faithful D := FFModel.nat_faithful Γ
  have hπinj : Function.Injective π := hπ.injective_of_faithful hfaith
  let e : ↥Γ ≃* ↥L := MulEquiv.ofBijective π ⟨hπinj, hπ.1⟩
  obtain ⟨E, hE⟩ := G64.RealizesVia.exists_secEquiv (D := D) rfl hπ
  let Θ : W ≃* Multiplicative (Fin 4 → K') := E.trans Subgroup.topEquiv
  have hΘ : ∀ (l : L) (v : W), Θ ((l : MulAut W) v) =
      natAct Γ (e.symm l) (Θ v) := by
    intro l v
    have h1 := hE (e.symm l) v
    have h2 : π (e.symm l) = l := e.apply_symm_apply l
    rw [h2] at h1
    change ((E ((l : MulAut W) v) : ↥D.sec) : D.Amb) =
      natAct Γ (e.symm l) ((E v : ↥D.sec) : D.Amb)
    exact h1
  let t₀ : ↥Γ := e.symm ⟨t, htL⟩
  have ht₀2 : t₀ * t₀ = 1 := by
    apply e.injective
    rw [map_mul, map_one, e.apply_symm_apply]
    exact Subtype.ext ht2
  have ht₀1 : t₀ ≠ 1 := by
    intro h
    apply ht1
    have h1 : (⟨t, htL⟩ : ↥L) = 1 := by
      calc (⟨t, htL⟩ : ↥L) = e t₀ := (e.apply_symm_apply _).symm
        _ = e 1 := by rw [h]
        _ = 1 := map_one e
    exact congrArg Subtype.val h1
  have hmap : (Subgroup.zpowers t).map (congrHom Θ) =
      Subgroup.zpowers (natAut Γ t₀) := by
    rw [MonoidHom.map_zpowers]
    congr 1
    apply MulEquiv.ext
    intro v
    rw [congrHom_apply, hΘ ⟨t, htL⟩ (Θ.symm v), Θ.apply_symm_apply]
    rfl
  have h1 : rkIdx (fixV (Subgroup.zpowers t)) =
      rkIdx (fixV (Subgroup.zpowers (natAut Γ t₀))) := by
    rw [← rkIdx_fixV_map_congrHom Θ (Subgroup.zpowers t), hmap]
  have ht₀ord : orderOf t₀ = 2 := orderOf_eq_prime (by rw [pow_two, ht₀2]) ht₀1
  obtain ⟨u, hu⟩ := isConj_iff.mp
    (suzuki_involutions_conjugate hK'' (suzukiSElt a' K' 0 1) t₀
      (orderOf_suzukiSElt_zero_one hK'') ht₀ord)
  have hconj : natAut Γ t₀ =
      natAut Γ u * natAut Γ (suzukiSElt a' K' 0 1) * (natAut Γ u)⁻¹ := by
    rw [← hu, map_mul, map_mul, map_inv]
  have h2 : rkIdx (fixV (Subgroup.zpowers (natAut Γ t₀))) = 2 * (2 * a' + 1) := by
    rw [hconj, rkIdx_fixV_conj, rkIdx_fixV_suzukiSElt hK'']
  have hW2 : ∀ v : W, v ^ 2 = 1 := fun v => by rw [pow_two]; exact hW v
  rw [index_eq_two_pow_rkIdx (isPGroup_two_of_sq_eq_one hW2), h1, h2,
    show 2 * (2 * a' + 1) = 2 * (2 * a + 1) by omega]

theorem suzuki_pow_le_index_fixV
    (a : ℕ) (ha : 1 ≤ a) {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2 ^ (2 * a + 1))
    (W : Type) [CommGroup W] [Finite W] [Nontrivial W] (hW : ∀ w : W, w * w = 1)
    (L : Subgroup (MulAut W)) (hLperf : Group.IsPerfect ↥L)
    (hLirr : ∀ U : Subgroup W, (∀ g ∈ L, ∀ u ∈ U, g u ∈ U) → U = ⊥ ∨ U = ⊤)
    (α : CQ L ≃* suzukiGroup a K) :
    ∀ t ∈ L, t * t = 1 → t ≠ 1 → 2 ^ (2 * (2 * a + 1)) ≤ (fixV (Subgroup.zpowers t)).index := by
  classical
  intro t htL ht2 ht1
  by_cases hbig : 2 ^ (2 * (2 * a + 1)) ≤ (fixV (Subgroup.zpowers t)).index
  · exact hbig
  push Not at hbig
  have hnat : BinaryNaturalSz L ⊤ ⊥ (2 * a + 1) :=
    szNaturalOfSmallDisplacement_holds a ha K hK W hW L hLperf hLirr ⟨α⟩
      ⟨t, htL, ht2, ht1, hbig.le⟩
  have hidx := binaryNaturalSz_index_eq a hK hW hnat htL ht2 ht1
  rw [hidx] at hbig
  exact absurd hbig (lt_irrefl _)

private def quotientCenterEquivSelf' {X : Type} [Group X] (h : Subgroup.center X = ⊥) :
    X ⧸ Subgroup.center X ≃* X :=
  (QuotientGroup.quotientMulEquivOfEq h).trans QuotientGroup.quotientBot

private theorem quotient_center_central_quotient
    {Q : Type} [Group Q] (hQ : CFSG.IsQuasisimple Q) (A : Subgroup Q) [A.Normal]
    (hA : A ≤ Subgroup.center Q) :
    Nonempty ((Q ⧸ A) ⧸ Subgroup.center (Q ⧸ A) ≃* Q ⧸ Subgroup.center Q) := by
  obtain ⟨-, -, hZmap⟩ := CFSG.LocalCores.quasisimple_central_quotient hQ A hA
  refine ⟨(QuotientGroup.quotientMulEquivOfEq hZmap).trans ?_⟩
  exact QuotientGroup.quotientQuotientEquivQuotient A (Subgroup.center Q) hA

private def quotientCenterCongr' {X Y : Type} [Group X] [Group Y] (e : X ≃* Y) :
    X ⧸ Subgroup.center X ≃* Y ⧸ Subgroup.center Y :=
  QuotientGroup.congr (Subgroup.center X) (Subgroup.center Y) e (Subgroup.map_center_eq e)

private theorem isQuasisimple_subgroup_of_surjective
    {Q W : Type} [Group Q] [Mul W]
    (hQ : CFSG.IsQuasisimple Q) (L : Subgroup (MulAut W))
    (π : Q →* ↥L) (hπ : Function.Surjective π) (hker : π.ker ≤ Subgroup.center Q) :
    CFSG.IsQuasisimple ↥L ∧
      Nonempty (CQ L ≃* Q ⧸ Subgroup.center Q) := by
  have hqs : CFSG.IsQuasisimple ↥L :=
    CFSG.LocalCores.isQuasisimple_of_surjective hQ π hπ hker
  refine ⟨hqs, ?_⟩
  let e : ↥L ≃* Q ⧸ π.ker :=
    (QuotientGroup.quotientKerEquivOfSurjective π hπ).symm
  exact ⟨(quotientCenterCongr' e).trans
    (Classical.choice (quotient_center_central_quotient hQ π.ker hker))⟩

private theorem autI_le_normalizer_autI
    {G : Type} [Group G] {H U C R : Subgroup G}
    (hU : CFSG.Open.IsElemAbelian 2 U)
    (hHU : H ≤ Subgroup.normalizer (U : Set G))
    (hCH : C ≤ H) (hNR : H ≤ Subgroup.normalizer (R : Set G)) :
    CFSG.Quasithin.autI hU C ≤ Subgroup.normalizer
      (CFSG.Quasithin.autI hU R : Set (MulAut (CFSG.Quasithin.IntMod U hU))) := by
  have hstep : ∀ c : Subgroup.normalizer (U : Set G), (c : G) ∈ C →
      ∀ a ∈ CFSG.Quasithin.autI hU R,
        CFSG.Quasithin.convI hU c * a * (CFSG.Quasithin.convI hU c)⁻¹ ∈
          CFSG.Quasithin.autI hU R := by
    intro c hc a ha
    obtain ⟨r, hr, rfl⟩ := (CFSG.Quasithin.mem_autI hU).1 ha
    have hconj : CFSG.Quasithin.convI hU c * CFSG.Quasithin.convI hU r *
        (CFSG.Quasithin.convI hU c)⁻¹ = CFSG.Quasithin.convI hU (c * r * c⁻¹) := by
      simp only [← map_mul, ← map_inv]
    rw [hconj]
    refine CFSG.Quasithin.convI_mem_autI hU (K := R) ?_ (c * r * c⁻¹).2
    have hgn : (c : G) * (r : G) * (c : G)⁻¹ ∈ R :=
      (Subgroup.mem_normalizer_iff.mp (hNR (hCH hc)) (r : G)).mp hr
    simpa using hgn
  intro x hx
  obtain ⟨c, hc, rfl⟩ := (CFSG.Quasithin.mem_autI hU).1 hx
  rw [Subgroup.mem_normalizer_iff]
  intro a
  constructor
  · exact hstep c hc a
  · intro ha
    have h1 := hstep c⁻¹ (C.inv_mem hc) (CFSG.Quasithin.convI hU c * a *
      (CFSG.Quasithin.convI hU c)⁻¹) ha
    simpa [mul_assoc] using h1

private theorem isPGroup_autI_pCoreOf
    {G : Type} [Group G] [Finite G] {H U : Subgroup G}
    (hU : CFSG.Open.IsElemAbelian 2 U)
    (hHU : H ≤ Subgroup.normalizer (U : Set G)) :
    IsPGroup 2 (CFSG.Quasithin.autI hU (CFSG.Open.pCoreOf 2 H)) := by
  let R : Subgroup G := CFSG.Open.pCoreOf 2 H
  have hRH : R ≤ H := CFSG.LieType.BorelTits.pCoreOf_le 2 H
  have hRN : R ≤ Subgroup.normalizer (U : Set G) := hRH.trans hHU
  have hR2 : IsPGroup 2 R := CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 H
  have hRsub : IsPGroup 2 (R.subgroupOf (Subgroup.normalizer (U : Set G))) :=
    hR2.of_equiv (Subgroup.subgroupOfEquivOfLe hRN).symm
  have hmap := hRsub.map (CFSG.Quasithin.convI hU)
  change IsPGroup 2 (Subgroup.map (CFSG.Quasithin.convI hU)
    (R.subgroupOf (Subgroup.normalizer (U : Set G))))
  exact hmap

private theorem isPGroup_autI_centralizer_of_trivial
    {G : Type} [Group G] [Finite G] {H U U' : Subgroup G}
    (hU : CFSG.Open.IsElemAbelian 2 U)
    (hHU : H ≤ Subgroup.normalizer (U : Set G))
    (hHU' : H ≤ Subgroup.normalizer (U' : Set G))
    (hU'U : U' ≤ U)
    (htriv : ∀ h ∈ H, ∀ u ∈ U, h * u * h⁻¹ * u⁻¹ ∈ U') :
    IsPGroup 2 (CFSG.Quasithin.autI hU (H ⊓ Subgroup.centralizer (U' : Set G))) := by
  classical
  let C : Subgroup G := H ⊓ Subgroup.centralizer (U' : Set G)
  let K : Subgroup (MulAut (CFSG.Quasithin.IntMod U hU)) := CFSG.Quasithin.autI hU C
  have hCnorm : C ≤ Subgroup.normalizer (U : Set G) := inf_le_left.trans hHU
  have hCU' : C ≤ Subgroup.centralizer (U' : Set G) := inf_le_right
  have hfixC : ∀ (c : Subgroup.normalizer (U : Set G)), (c : G) ∈ C →
      ∀ u : CFSG.Quasithin.IntMod U hU, u ∈ U'.subgroupOf U →
        CFSG.Quasithin.convI hU c u = u := by
    intro c hc u hu
    have hcen : (c : G) * u.val * (c : G)⁻¹ = u.val := by
      have hcc := (Subgroup.mem_inf.mp (by simpa [C] using hc)).2
      have := Subgroup.mem_centralizer_iff.mp hcc u.val (Subgroup.mem_subgroupOf.mp hu)
      calc (c : G) * u.val * (c : G)⁻¹ = u.val * (c : G) * (c : G)⁻¹ := by rw [this]
        _ = u.val := by group
    apply CFSG.Quasithin.IntMod.val_injective
    rw [CFSG.Quasithin.convI_apply_val]
    exact hcen
  have hKcent : K ≤ centSub (U'.subgroupOf U) := by
    intro x hx u hu
    obtain ⟨g, hg, rfl⟩ := (CFSG.Quasithin.mem_autI hU).1 hx
    exact hfixC g hg u hu
  have hKq : ∀ x ∈ K, ∀ w : CFSG.Quasithin.IntMod U hU, x w * w⁻¹ ∈ U'.subgroupOf U := by
    intro x hx w
    obtain ⟨g, hg, rfl⟩ := (CFSG.Quasithin.mem_autI hU).1 hx
    have hgH : (g : G) ∈ H := (Subgroup.mem_inf.mp (by simpa [C] using hg)).1
    refine Subgroup.mem_subgroupOf.mpr ?_
    change ((CFSG.Quasithin.convI hU g) w * w⁻¹).val ∈ U'
    have h1 : ((CFSG.Quasithin.convI hU g) w * w⁻¹).val =
        (g : G) * w.val * (g : G)⁻¹ * w.val⁻¹ := by
      simp only [CFSG.Quasithin.IntMod.val_mul, CFSG.Quasithin.IntMod.val_inv,
        CFSG.Quasithin.convI_apply_val]
    rw [h1]
    exact htriv (g : G) hgH w.val w.2
  exact CFSG.LocalAnalysis.UniquenessCase.PartTwo.s15_Lin_isPGroup_two_of_acts_trivially
    (W := CFSG.Quasithin.IntMod U hU) (fun w => CFSG.Quasithin.IntMod.sq_eq_one (hV := hU) w)
    hKcent hKq

private theorem isPGroup_range_convHom_of_trivial
    {G : Type} [Group G] [Finite G] {H U U' : Subgroup G}
    (hU : CFSG.Open.IsElemAbelian 2 U)
    (hHU : H ≤ Subgroup.normalizer (U : Set G))
    (hHU' : H ≤ Subgroup.normalizer (U' : Set G))
    (hU'U : U' ≤ U)
    (hmin : H ≤ (H ⊓ Subgroup.centralizer (U' : Set G)) ⊔ CFSG.Open.pCoreOf 2 H)
    (htriv : ∀ h ∈ H, ∀ u ∈ U, h * u * h⁻¹ * u⁻¹ ∈ U') :
    IsPGroup 2 (CFSG.Quasithin.convHom hU H hHU).range := by
  let R : Subgroup G := CFSG.Open.pCoreOf 2 H
  let C : Subgroup G := H ⊓ Subgroup.centralizer (U' : Set G)
  have hCH : C ≤ H := inf_le_left
  have hCN : C ≤ Subgroup.normalizer (U : Set G) := hCH.trans hHU
  have hRH : R ≤ H := CFSG.LieType.BorelTits.pCoreOf_le 2 H
  have hRN : R ≤ Subgroup.normalizer (U : Set G) := hRH.trans hHU
  have hC2 : IsPGroup 2 (CFSG.Quasithin.autI hU C) :=
    isPGroup_autI_centralizer_of_trivial hU hHU hHU' hU'U htriv
  have hR2 : IsPGroup 2 (CFSG.Quasithin.autI hU R) :=
    isPGroup_autI_pCoreOf hU hHU
  have hnorm : CFSG.Quasithin.autI hU C ≤ Subgroup.normalizer
      (CFSG.Quasithin.autI hU R : Set (MulAut (CFSG.Quasithin.IntMod U hU))) :=
    autI_le_normalizer_autI hU hHU hCH (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 H)
  have hsup2 : IsPGroup 2
      (CFSG.Quasithin.autI hU C ⊔ CFSG.Quasithin.autI hU R :
        Subgroup (MulAut (CFSG.Quasithin.IntMod U hU))) :=
    hC2.to_sup_of_normal_right' hR2 hnorm
  have hrange : (CFSG.Quasithin.convHom hU H hHU).range = CFSG.Quasithin.autI hU H :=
    CFSG.Quasithin.range_convHom hU H hHU
  rw [hrange]
  refine hsup2.to_le ?_
  calc CFSG.Quasithin.autI hU H ≤ CFSG.Quasithin.autI hU (C ⊔ R) :=
        CFSG.Quasithin.autI_mono hU hmin
    _ = CFSG.Quasithin.autI hU C ⊔ CFSG.Quasithin.autI hU R :=
        CFSG.Quasithin.autI_sup hU hCN hRN

private theorem le_sup_of_trivial_section
    {G : Type} [Group G] [Finite G] {H U U' : Subgroup G}
    (hU : CFSG.Open.IsElemAbelian 2 U)
    (hHU : H ≤ Subgroup.normalizer (U : Set G))
    (hHU' : H ≤ Subgroup.normalizer (U' : Set G))
    (hU'U : U' ≤ U)
    (hmin : H ≤ (H ⊓ Subgroup.centralizer (U' : Set G)) ⊔ CFSG.Open.pCoreOf 2 H)
    (htriv : ∀ h ∈ H, ∀ u ∈ U, h * u * h⁻¹ * u⁻¹ ∈ U')
    (hperf : Group.IsPerfect (CFSG.Quasithin.oTwoQuot ↥H)) :
    H ≤ (H ⊓ Subgroup.centralizer (U : Set G)) ⊔ CFSG.Open.pCoreOf 2 H := by
  classical
  let R : Subgroup G := CFSG.Open.pCoreOf 2 H
  let C : Subgroup G := H ⊓ Subgroup.centralizer (U : Set G)
  let K : Subgroup ↥H := C.subgroupOf H
  let L : Subgroup ↥H := R.subgroupOf H
  let S : Subgroup ↥H := K ⊔ L
  have hCH : C ≤ H := inf_le_left
  have hRH : R ≤ H := CFSG.LieType.BorelTits.pCoreOf_le 2 H
  have hCnorm : K.Normal := by
    refine (Subgroup.normal_subgroupOf_iff_le_normalizer hCH).2 ?_
    exact Subgroup.le_normalizer_inf Subgroup.le_normalizer
      (CFSG.GroupTheory.FT63ChII.le_normalizer_centralizer hHU)
  have hRnorm : L.Normal := by
    refine (Subgroup.normal_subgroupOf_iff_le_normalizer hRH).2 ?_
    exact CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 H
  haveI : K.Normal := hCnorm
  haveI : L.Normal := hRnorm
  have hSnorm : S.Normal := Subgroup.sup_normal K L
  let φ := CFSG.Quasithin.convHom hU H hHU
  have hP2 : IsPGroup 2 φ.range :=
    isPGroup_range_convHom_of_trivial hU hHU hHU' hU'U hmin htriv
  have hKker : φ.ker = K := by
    rw [CFSG.Quasithin.ker_convHom]
  have hQ2 : IsPGroup 2 (↥H ⧸ K) := by
    have hker : φ.rangeRestrict.ker = K := by
      rw [MonoidHom.ker_rangeRestrict, hKker]
    let e : (↥H ⧸ K) ≃* φ.range :=
      (QuotientGroup.quotientMulEquivOfEq hker.symm).trans
        (QuotientGroup.quotientKerEquivOfSurjective φ.rangeRestrict
          φ.rangeRestrict_surjective)
    exact hP2.of_equiv e.symm
  have hKS : K ≤ S := le_sup_left
  have hLS : L ≤ S := le_sup_right
  let ψ : (↥H ⧸ K) →* (↥H ⧸ S) :=
    QuotientGroup.lift K (QuotientGroup.mk' S) (by
      intro x hx
      exact (QuotientGroup.eq_one_iff (N := S) (x := x)).2 (hKS hx))
  have hψ : Function.Surjective ψ := by
    intro y
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective S y
    exact ⟨QuotientGroup.mk' K x, rfl⟩
  have hQ2S : IsPGroup 2 (↥H ⧸ S) := hQ2.of_surjective ψ hψ
  have hperfS : Group.IsPerfect (↥H ⧸ S) := by
    have hRsub : L = CFSG.pCore 2 ↥H := by
      ext x
      constructor
      · intro hx
        have hx' : (x : ↥H).val ∈ R := by
          simpa [L] using (Subgroup.mem_subgroupOf.mp hx)
        have hx'' : (x : ↥H).val ∈ (CFSG.pCore 2 ↥H).map H.subtype := by
          simpa [R, CFSG.Open.pCoreOf] using hx'
        obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx''
        exact Subtype.ext hyx ▸ hy
      · intro hx
        apply Subgroup.mem_subgroupOf.mpr
        have hx' : (x : ↥H).val ∈ (CFSG.pCore 2 ↥H).map H.subtype :=
          Subgroup.mem_map.mpr ⟨x, hx, rfl⟩
        simpa [R, CFSG.Open.pCoreOf] using hx'
    have hperfR : Group.IsPerfect (↥H ⧸ L) := by
      let e : (↥H ⧸ CFSG.pCore 2 ↥H) ≃* (↥H ⧸ L) :=
        QuotientGroup.quotientMulEquivOfEq hRsub.symm
      haveI : Group.IsPerfect (↥H ⧸ CFSG.pCore 2 ↥H) := hperf
      exact Group.IsPerfect.ofSurjective (f := e.toMonoidHom) (by
        intro y
        exact e.surjective y)
    let χ : (↥H ⧸ L) →* (↥H ⧸ S) :=
      QuotientGroup.lift L (QuotientGroup.mk' S) (by
        intro x hx
        exact (QuotientGroup.eq_one_iff (N := S) (x := x)).2 (hLS hx))
    have hχ : Function.Surjective χ := by
      intro y
      obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective S y
      exact ⟨QuotientGroup.mk' L x, rfl⟩
    haveI : Group.IsPerfect (↥H ⧸ L) := hperfR
    exact Group.IsPerfect.ofSurjective (f := χ) (by
      intro y
      exact hχ y)
  have hsub : Subsingleton (↥H ⧸ S) :=
    CFSG.Quasithin.H13.C1294.subsingleton_of_perfect_isPGroup hQ2S hperfS.commutator_eq_top
  have hStop : S = ⊤ := QuotientGroup.subgroup_eq_top_of_subsingleton S hsub
  have hsubsup : (C ⊔ R).subgroupOf H = S := by
    rw [Subgroup.subgroupOf_sup hCH hRH]
  have htop : (C ⊔ R).subgroupOf H = ⊤ := by rw [hsubsup, hStop]
  have hHsup : H ≤ C ⊔ R := Subgroup.subgroupOf_eq_top.mp htop
  simpa [C, R] using hHsup

private theorem pCoreOf_trivial_on_section
    {G : Type} [Group G] [Finite G] {H U U' : Subgroup G}
    (hU : CFSG.Open.IsElemAbelian 2 U)
    (hHU : H ≤ Subgroup.normalizer (U : Set G))
    (hHU' : H ≤ Subgroup.normalizer (U' : Set G))
    (hU'U : U' < U)
    (hmax : ∀ X : Subgroup G, U' ≤ X → X ≤ U →
      H ≤ Subgroup.normalizer (X : Set G) → X = U' ∨ X = U) :
    ∀ r ∈ CFSG.Open.pCoreOf 2 H, ∀ u ∈ U, r * u * r⁻¹ * u⁻¹ ∈ U' := by
  classical
  let W : Type := ↥U ⧸ U'.subgroupOf U
  have hUcomm : ∀ a : ↥U, ∀ b : ↥U, a * b = b * a := by
    haveI : IsMulCommutative ↥U := hU.1
    intro a b
    exact (IsMulCommutative.is_comm (M := ↥U)).comm a b
  have hUnorm : (U'.subgroupOf U).Normal :=
    CFSG.Quasithin.H13.C1294.IDIrr.subgroupOf_normal_of_comm
      (fun a ha b hb => congrArg Subtype.val (hUcomm ⟨a, ha⟩ ⟨b, hb⟩))
  haveI : (U'.subgroupOf U).Normal := hUnorm
  let hWcomm : CommGroup W :=
    { (inferInstance : Group W) with
      mul_comm := by
        intro x y
        refine Quotient.inductionOn₂' x y ?_
        intro a b
        change (QuotientGroup.mk (a * b) : W) = QuotientGroup.mk (b * a)
        rw [QuotientGroup.eq]
        have h : a * b = b * a := hUcomm a b
        rw [h, inv_mul_cancel]
        exact (U'.subgroupOf U).one_mem }
  let φ : ↥H →* MulAut W :=
    CFSG.Quasithin.Vol2.Ch11.SecD.quotAct (K := H) (U := U) (Z := U') hHU hHU'
  let R : Subgroup ↥H := (CFSG.Open.pCoreOf 2 H).subgroupOf H
  let P : Subgroup (MulAut W) := R.map φ
  have hR2 : IsPGroup 2 R := by
    have hR : IsPGroup 2 (CFSG.Open.pCoreOf 2 H) :=
      CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 H
    exact hR.of_equiv (Subgroup.subgroupOfEquivOfLe
      (CFSG.LieType.BorelTits.pCoreOf_le 2 H)).symm
  have hP2 : IsPGroup 2 P := hR2.map φ
  have hntW : Nontrivial W := by
    obtain ⟨u, huU, huU'⟩ := Set.exists_of_ssubset hU'U
    refine ⟨⟨QuotientGroup.mk ⟨u, huU⟩, 1, ?_⟩⟩
    intro h
    apply huU'
    have h1 : (QuotientGroup.mk ⟨u, huU⟩ : W) = (1 : W) := h
    rw [QuotientGroup.eq_one_iff] at h1
    exact Subgroup.mem_subgroupOf.mp h1
  have hWsq : ∀ w : W, w ^ 2 = 1 := by
    intro w
    induction w using QuotientGroup.induction_on with
    | H u =>
      rw [pow_two]
      rw [← QuotientGroup.mk_mul]
      exact (QuotientGroup.eq_one_iff (N := U'.subgroupOf U) (x := u * u)).2
        (Subgroup.mem_subgroupOf.mpr (by
          have hu : u.val * u.val = 1 := by
            simpa [pow_two] using hU.2 u.val u.2
          simpa [hu] using U'.one_mem))
  have hKne : fixV P ≠ ⊥ :=
    CFSG.Quasithin.MS93.S32.fixV_ne_bot_of_isPGroup hWsq hP2
  let K : Subgroup W := fixV P
  have hconjP : ∀ (h : ↥H) (r : ↥H), (r : G) ∈ CFSG.Open.pCoreOf 2 H →
      φ h * φ r * (φ h)⁻¹ ∈ P := by
    intro h r hr
    refine Subgroup.mem_map.mpr ⟨h * r * h⁻¹, ?_, by rw [map_mul, map_mul, map_inv]⟩
    refine Subgroup.mem_subgroupOf.mpr ?_
    have hnorm := CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 H h.2
    exact (Subgroup.mem_normalizer_iff.mp hnorm (r : G)).mp hr
  have hKinv : ∀ g ∈ φ.range, ∀ w ∈ K, g w ∈ K := by
    intro g hg w hw
    rw [mem_fixV] at hw ⊢
    intro p hp
    obtain ⟨h, rfl⟩ := hg
    obtain ⟨r, hr, rfl⟩ := Subgroup.mem_map.mp hp
    have hrR : (r : G) ∈ CFSG.Open.pCoreOf 2 H := Subgroup.mem_subgroupOf.mp hr
    have hmem : φ h⁻¹ * φ r * (φ h⁻¹)⁻¹ ∈ P := hconjP h⁻¹ r hrR
    have h1 := hw (φ h⁻¹ * φ r * (φ h⁻¹)⁻¹) hmem
    have h2 := congrArg (φ h) h1
    simpa [MulAut.mul_apply] using h2
  let X : Subgroup ↥U := K.comap (QuotientGroup.mk' (U'.subgroupOf U))
  let X' : Subgroup G := X.map U.subtype
  have hU'X' : U' ≤ X' := by
    intro u hu'
    refine Subgroup.mem_map.mpr ⟨⟨u, hU'U.le hu'⟩, ?_, rfl⟩
    change (QuotientGroup.mk ⟨u, hU'U.le hu'⟩ : W) ∈ K
    rw [(QuotientGroup.eq_one_iff (N := U'.subgroupOf U)
      (x := ⟨u, hU'U.le hu'⟩)).2 (Subgroup.mem_subgroupOf.mpr hu')]
    exact K.one_mem
  have hX'U : X' ≤ U := by
    rintro _ ⟨u, -, rfl⟩
    exact u.2
  have hX'conj : ∀ h ∈ H, ∀ x ∈ X', h * x * h⁻¹ ∈ X' := by
    intro h hh x hx
    let hH : ↥H := ⟨h, hh⟩
    obtain ⟨u, huX, rfl⟩ := Subgroup.mem_map.mp hx
    have hhu : h * (u : G) * h⁻¹ ∈ U :=
      (Subgroup.mem_normalizer_iff.mp (hHU hh) (u : G)).mp u.2
    let c : ↥U := ⟨h * (u : G) * h⁻¹, hhu⟩
    refine Subgroup.mem_map.mpr ⟨c, ?_, rfl⟩
    change (QuotientGroup.mk c : W) ∈ K
    have hc : c = conjAct U ⟨hH, hHU hH.2⟩ u := Subtype.ext rfl
    rw [hc]
    rw [← CFSG.Quasithin.Vol2.Ch11.SecD.quotAct_mk (K := H) (U := U) (Z := U')
      hHU hHU' hH u]
    exact hKinv (φ hH) ⟨hH, rfl⟩ (QuotientGroup.mk u) huX
  have hHX' : H ≤ Subgroup.normalizer (X' : Set G) := by
    intro h hh
    rw [Subgroup.mem_normalizer_iff]
    intro x
    constructor
    · exact hX'conj h hh x
    · intro hx
      have h1 := hX'conj h⁻¹ (H.inv_mem hh) (h * x * h⁻¹) hx
      simpa [mul_assoc] using h1
  have hXne : X' ≠ U' := by
    intro hEq
    have hKbot : K = ⊥ := by
      apply le_antisymm ?_ bot_le
      intro w hw
      obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective (U'.subgroupOf U) w
      have huX' : (u : G) ∈ X' := by
        refine Subgroup.mem_map.mpr ⟨u, ?_, rfl⟩
        exact hw
      rw [hEq] at huX'
      exact (QuotientGroup.eq_one_iff (N := U'.subgroupOf U) (x := u)).2
        (Subgroup.mem_subgroupOf.mpr huX')
    exact hKne hKbot
  have hKtop : K = ⊤ := by
    rcases hmax X' hU'X' hX'U hHX' with h | h
    · exact absurd h hXne
    · apply le_antisymm le_top
      intro w _
      obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective (U'.subgroupOf U) w
      have huX' : (u : G) ∈ X' := by rw [h]; exact u.2
      obtain ⟨u0, hu0X, hu0⟩ := Subgroup.mem_map.mp huX'
      have hu0u : u0 = u := Subtype.ext hu0
      subst hu0u
      exact hu0X
  have hPtriv : ∀ p ∈ P, p = 1 := by
    intro p hp
    ext w
    have hw : w ∈ K := by rw [hKtop]; exact Subgroup.mem_top w
    exact (mem_fixV.mp hw) p hp
  have hUZ : U ≤ Subgroup.normalizer (U' : Set G) := by
    intro u hu
    rw [Subgroup.mem_normalizer_iff]
    intro x
    constructor
    · intro hx
      have hxU : x ∈ U := hU'U.le hx
      have hcomm : u * x = x * u :=
        congrArg Subtype.val (hUcomm ⟨u, hu⟩ ⟨x, hxU⟩)
      have hxeq : u * x * u⁻¹ = x := by rw [hcomm]; group
      rwa [hxeq]
    · intro hx
      have hyU : u * x * u⁻¹ ∈ U := hU'U.le hx
      have hcomm : u⁻¹ * (u * x * u⁻¹) = (u * x * u⁻¹) * u⁻¹ :=
        congrArg Subtype.val (hUcomm ⟨u⁻¹, U.inv_mem hu⟩ ⟨u * x * u⁻¹, hyU⟩)
      have hxeq : x = u * x * u⁻¹ := by
        calc x = u⁻¹ * (u * x * u⁻¹) * u := by group
          _ = (u * x * u⁻¹) * u⁻¹ * u := by rw [hcomm]
          _ = u * x * u⁻¹ := by group
      rwa [hxeq]
  intro r hr u hu
  let rH : ↥H := ⟨r, CFSG.LieType.BorelTits.pCoreOf_le 2 H hr⟩
  have hp : φ rH ∈ P := by
    refine Subgroup.mem_map.mpr ⟨rH, ?_, rfl⟩
    exact Subgroup.mem_subgroupOf.mpr hr
  have hphi : φ rH = 1 := hPtriv (φ rH) hp
  have hq : CFSG.Quasithin.Vol2.Ch11.SecD.quotAct (K := H) (U := U) (Z := U')
      hHU hHU' rH = 1 := hphi
  exact (CFSG.Quasithin.Vol2.Ch11.SecD.quotAct_eq_one_iff hUZ hHU hHU' rH).1 hq u hu

abbrev SectionW {G : Type} [Group G] (U U' : Subgroup G) : Type :=
  ↥U ⧸ U'.subgroupOf U

private theorem index_le_relIndex_centralizer_of_fixed
    {G : Type} [Group G] [Finite G] {H U U' V : Subgroup G} {t : G}
    (hUV : U ≤ V) (hU'U : U' < U)
    (hHU : H ≤ Subgroup.normalizer (U : Set G))
    (hHU' : H ≤ Subgroup.normalizer (U' : Set G))
    [(U'.subgroupOf U).Normal]
    (htH : t ∈ H) (K : Subgroup (SectionW U U'))
    (hKmem : ∀ u : ↥U, (QuotientGroup.mk u : SectionW U U') ∈ K ↔
      t * (u : G) * t⁻¹ * (u : G)⁻¹ ∈ U') :
    K.index ≤ (V ⊓ Subgroup.centralizer ({t} : Set G)).relIndex V := by
  classical
  let X : Subgroup ↥U := K.comap (QuotientGroup.mk' (U'.subgroupOf U))
  let X' : Subgroup G := X.map U.subtype
  have hKidx : K.index = X'.relIndex U := by
    have h1 : X.index = K.index :=
      Subgroup.index_comap_of_surjective K (QuotientGroup.mk'_surjective (U'.subgroupOf U))
    have hX'U : X' ≤ U := by
      rintro _ ⟨u, -, rfl⟩
      exact u.2
    have hXsub : X'.subgroupOf U = X := by
      ext x
      rw [Subgroup.mem_subgroupOf, Subgroup.mem_map]
      constructor
      · rintro ⟨y, hy, hyx⟩
        have hyx' : y = x := Subtype.ext hyx
        simpa [hyx'] using hy
      · intro hx
        exact ⟨x, hx, rfl⟩
    have h2 : X'.relIndex U = X.index := by
      change (X'.subgroupOf U).index = X.index
      rw [hXsub]
    rw [← h1, ← h2]
  have hCUX' : U ⊓ Subgroup.centralizer ({t} : Set G) ≤ X' := by
    intro u hu
    have huU : u ∈ U := hu.1
    have hcomm : t * u * t⁻¹ * u⁻¹ = 1 := by
      have h : t * u = u * t := Subgroup.mem_centralizer_iff.mp hu.2 t (by simp)
      calc t * u * t⁻¹ * u⁻¹ = u * t * t⁻¹ * u⁻¹ := by rw [h]
        _ = 1 := by group
    refine Subgroup.mem_map.mpr ⟨⟨u, huU⟩, ?_, rfl⟩
    exact (hKmem ⟨u, huU⟩).2 (by simpa [hcomm] using U'.one_mem)
  have hstep1 : K.index ≤ (U ⊓ Subgroup.centralizer ({t} : Set G)).relIndex U := by
    rw [hKidx]
    exact Subgroup.relIndex_le_of_le_left hCUX'
      (Subgroup.index_ne_zero_of_finite)
  have hstep2 : (U ⊓ Subgroup.centralizer ({t} : Set G)).relIndex U ≤
      (V ⊓ Subgroup.centralizer ({t} : Set G)).relIndex V := by
    have hCU : U ⊓ Subgroup.centralizer ({t} : Set G) =
        U ⊓ (V ⊓ Subgroup.centralizer ({t} : Set G)) := by
      rw [← inf_assoc, inf_eq_left.mpr hUV]
    rw [hCU]
    have h1 : (U ⊓ (V ⊓ Subgroup.centralizer ({t} : Set G))).relIndex U =
        (V ⊓ Subgroup.centralizer ({t} : Set G)).relIndex U := by
      rw [inf_comm]
      exact Subgroup.inf_relIndex_right _ _
    rw [h1]
    exact Subgroup.relIndex_le_of_le_right hUV
      (Subgroup.index_ne_zero_of_finite)
  exact hstep1.trans hstep2

theorem section_actor
    {G : Type} [Group G] [Finite G] {H U U' : Subgroup G} {t : G}
    [(U'.subgroupOf U).Normal]
    (hUsec : ∀ a ∈ U, ∀ b ∈ U, a * b * a⁻¹ * b⁻¹ ∈ U' ∧ a * a ∈ U')
    (hHU : H ≤ Subgroup.normalizer (U : Set G))
    (hHU' : H ≤ Subgroup.normalizer (U' : Set G))
    (hU'U : U' < U)
    (hmax : ∀ X : Subgroup G, U' ≤ X → X ≤ U →
      H ≤ Subgroup.normalizer (X : Set G) → X = U' ∨ X = U)
    (hnotriv : ∃ h ∈ H, ∃ u ∈ U, h * u * h⁻¹ * u⁻¹ ∉ U')
    (hO2triv : ∀ r ∈ CFSG.Open.pCoreOf 2 H, ∀ u ∈ U, r * u * r⁻¹ * u⁻¹ ∈ U')
    (hQ : CFSG.IsQuasisimple (CFSG.Quasithin.oTwoQuot ↥H))
    (hZinv : ∀ z ∈ Subgroup.center (CFSG.Quasithin.oTwoQuot ↥H), z * z = 1 → z = 1)
    (htH : t ∈ H) (ht2 : t * t ∈ CFSG.Open.pCoreOf 2 H) (htO : t ∉ CFSG.Open.pCoreOf 2 H) :
    ∃ (_ : Nontrivial (SectionW U U'))
      (L : Subgroup (MulAut (SectionW U U'))) (tL : MulAut (SectionW U U')),
      Group.IsPerfect ↥L ∧
      (∀ K : Subgroup (SectionW U U'), (∀ g ∈ L, ∀ w ∈ K, g w ∈ K) → K = ⊥ ∨ K = ⊤) ∧
      tL ∈ L ∧ tL * tL = 1 ∧ tL ≠ 1 ∧
      (∀ u : ↥U, tL (QuotientGroup.mk u) =
        QuotientGroup.mk (conjAct U ⟨t, hHU htH⟩ u)) ∧
      Nonempty (CQ L ≃* (CFSG.Quasithin.oTwoQuot ↥H) ⧸
        Subgroup.center (CFSG.Quasithin.oTwoQuot ↥H)) ∧
      (∀ w : SectionW U U', w * w = 1) := by
  classical
  let W : Type := ↥U ⧸ U'.subgroupOf U
  have hUnorm : (U'.subgroupOf U).Normal := inferInstance
  have hWsq : ∀ w : W, w ^ 2 = 1 := by
    intro w
    induction w using QuotientGroup.induction_on with
    | H u =>
      rw [pow_two]
      rw [← QuotientGroup.mk_mul]
      exact (QuotientGroup.eq_one_iff (N := U'.subgroupOf U) (x := u * u)).2
        (Subgroup.mem_subgroupOf.mpr (hUsec u.val u.2 u.val u.2).2)
  have hntW : Nontrivial W := by
    obtain ⟨u, huU, huU'⟩ := Set.exists_of_ssubset hU'U
    refine ⟨⟨QuotientGroup.mk ⟨u, huU⟩, 1, ?_⟩⟩
    intro h
    apply huU'
    have h1 : (QuotientGroup.mk ⟨u, huU⟩ : W) = (1 : W) := h
    rw [QuotientGroup.eq_one_iff] at h1
    exact Subgroup.mem_subgroupOf.mp h1
  have hUZ : U ≤ Subgroup.normalizer (U' : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hU'U.le).1 hUnorm
  let φ : ↥H →* MulAut W :=
    CFSG.Quasithin.Vol2.Ch11.SecD.quotAct (K := H) (U := U) (Z := U') hHU hHU'
  have hφker : ∀ x ∈ CFSG.pCore 2 ↥H, φ x = 1 := by
    intro x hx
    have hxO : (x : G) ∈ CFSG.Open.pCoreOf 2 H := Subgroup.mem_map.mpr ⟨x, hx, rfl⟩
    exact (CFSG.Quasithin.Vol2.Ch11.SecD.quotAct_eq_one_iff hUZ hHU hHU' x).2
      (fun u hu => hO2triv (x : G) hxO u hu)
  have hφker' : CFSG.pCore 2 ↥H ≤ φ.ker := by
    intro x hx
    rw [MonoidHom.mem_ker]
    exact hφker x hx
  let π : (↥H ⧸ CFSG.pCore 2 ↥H) →* MulAut W :=
    QuotientGroup.lift (CFSG.pCore 2 ↥H) φ hφker'
  have hπmk : ∀ h : ↥H, π (QuotientGroup.mk h) = φ h := by
    intro h
    exact QuotientGroup.lift_mk' (N := CFSG.pCore 2 ↥H) (φ := φ) hφker' h
  let L : Subgroup (MulAut W) := π.range
  have hLne : L ≠ ⊥ := by
    intro hbot
    obtain ⟨h, hh, u, hu, hc⟩ := hnotriv
    have hφrange : φ ⟨h, hh⟩ ∈ L := ⟨QuotientGroup.mk ⟨h, hh⟩, hπmk ⟨h, hh⟩⟩
    rw [hbot] at hφrange
    have hφ1 : φ ⟨h, hh⟩ = 1 := Subgroup.mem_bot.mp hφrange
    have hcomm := (CFSG.Quasithin.Vol2.Ch11.SecD.quotAct_eq_one_iff hUZ hHU hHU'
      ⟨h, hh⟩).1 hφ1 u hu
    exact hc (by simpa using hcomm)
  have hNnorm : π.ker.Normal := MonoidHom.normal_ker π
  have hNcenter : π.ker ≤ Subgroup.center (CFSG.Quasithin.oTwoQuot ↥H) := by
    rcases CFSG.LocalCores.quasisimple_normal_subgroups hQ hNnorm with htop | hle
    · exfalso
      apply hLne
      rw [MonoidHom.range_eq_bot_iff, ← MonoidHom.ker_eq_top_iff]
      exact htop
    · exact hle
  have hkerR : π.rangeRestrict.ker ≤ Subgroup.center (CFSG.Quasithin.oTwoQuot ↥H) := by
    rw [MonoidHom.ker_rangeRestrict]
    exact hNcenter
  obtain ⟨hLq, ⟨eCQ⟩⟩ :=
    isQuasisimple_subgroup_of_surjective hQ L π.rangeRestrict
      π.rangeRestrict_surjective hkerR
  have hLirr : ∀ K : Subgroup W, (∀ g ∈ L, ∀ w ∈ K, g w ∈ K) → K = ⊥ ∨ K = ⊤ := by
    intro K hK
    let X : Subgroup ↥U := K.comap (QuotientGroup.mk' (U'.subgroupOf U))
    let X' : Subgroup G := X.map U.subtype
    have hU'X' : U' ≤ X' := by
      intro u hu'
      refine Subgroup.mem_map.mpr ⟨⟨u, hU'U.le hu'⟩, ?_, rfl⟩
      change (QuotientGroup.mk ⟨u, hU'U.le hu'⟩ : W) ∈ K
      rw [(QuotientGroup.eq_one_iff (N := U'.subgroupOf U)
        (x := ⟨u, hU'U.le hu'⟩)).2 (Subgroup.mem_subgroupOf.mpr hu')]
      exact K.one_mem
    have hX'U : X' ≤ U := by
      rintro _ ⟨u, -, rfl⟩
      exact u.2
    have hXconj : ∀ h ∈ H, ∀ x ∈ X', h * x * h⁻¹ ∈ X' := by
      intro h hh x hx
      obtain ⟨u, huX, rfl⟩ := Subgroup.mem_map.mp hx
      have hhu : h * (u : G) * h⁻¹ ∈ U :=
        (Subgroup.mem_normalizer_iff.mp (hHU hh) (u : G)).mp u.2
      let c : ↥U := ⟨h * (u : G) * h⁻¹, hhu⟩
      refine Subgroup.mem_map.mpr ⟨c, ?_, rfl⟩
      change (QuotientGroup.mk c : W) ∈ K
      have hc : c = conjAct U ⟨h, hHU hh⟩ u := Subtype.ext rfl
      rw [hc]
      rw [← CFSG.Quasithin.Vol2.Ch11.SecD.quotAct_mk (K := H) (U := U) (Z := U')
        hHU hHU' ⟨h, hh⟩ u]
      exact hK (φ ⟨h, hh⟩) ⟨QuotientGroup.mk ⟨h, hh⟩, hπmk ⟨h, hh⟩⟩
        (QuotientGroup.mk u) huX
    have hHX' : H ≤ Subgroup.normalizer (X' : Set G) := by
      intro h hh
      rw [Subgroup.mem_normalizer_iff]
      intro x
      constructor
      · exact hXconj h hh x
      · intro hx
        have h1 := hXconj h⁻¹ (H.inv_mem hh) (h * x * h⁻¹) hx
        simpa [mul_assoc] using h1
    rcases hmax X' hU'X' hX'U hHX' with h | h
    · left
      apply le_antisymm ?_ bot_le
      intro w hw
      obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective (U'.subgroupOf U) w
      have huX' : (u : G) ∈ X' := Subgroup.mem_map.mpr ⟨u, hw, rfl⟩
      rw [h] at huX'
      exact (QuotientGroup.eq_one_iff (N := U'.subgroupOf U) (x := u)).2
        (Subgroup.mem_subgroupOf.mpr huX')
    · right
      apply le_antisymm le_top
      intro w _
      obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective (U'.subgroupOf U) w
      have huX' : (u : G) ∈ X' := by rw [h]; exact u.2
      obtain ⟨u0, hu0X, hu0⟩ := Subgroup.mem_map.mp huX'
      have hu0u : u0 = u := Subtype.ext hu0
      subst hu0u
      exact hu0X
  let tH : ↥H := ⟨t, htH⟩
  let tL : MulAut W := π (QuotientGroup.mk tH)
  have htL : tL ∈ L := ⟨QuotientGroup.mk tH, rfl⟩
  have htH2 : tH * tH ∈ CFSG.pCore 2 ↥H := by
    obtain ⟨x, hx, hxt⟩ := Subgroup.mem_map.mp ht2
    have hx' : x = tH * tH := Subtype.ext hxt
    rw [← hx']
    exact hx
  have htL2 : tL * tL = 1 := by
    rw [← map_mul, ← QuotientGroup.mk_mul, hπmk]
    exact hφker' htH2
  have htL1 : tL ≠ 1 := by
    intro h1
    let qH : CFSG.Quasithin.oTwoQuot ↥H :=
      (QuotientGroup.mk' (CFSG.pCore 2 ↥H)) tH
    have hmem : qH ∈ π.ker := by
      rw [MonoidHom.mem_ker]
      change π (QuotientGroup.mk tH) = 1
      exact h1
    have hcenter : qH ∈ Subgroup.center (CFSG.Quasithin.oTwoQuot ↥H) := hNcenter hmem
    have hsq : qH * qH = 1 := by
      change (QuotientGroup.mk tH) * (QuotientGroup.mk tH) = 1
      rw [← QuotientGroup.mk_mul]
      exact (QuotientGroup.eq_one_iff (N := CFSG.pCore 2 ↥H) (x := tH * tH)).2 htH2
    have hone : qH = 1 := hZinv qH hcenter hsq
    have htP : tH ∈ CFSG.pCore 2 ↥H :=
      (QuotientGroup.eq_one_iff (N := CFSG.pCore 2 ↥H) (x := tH)).1 hone
    have htO' : t ∈ CFSG.Open.pCoreOf 2 H := Subgroup.mem_map.mpr ⟨tH, htP, rfl⟩
    exact htO htO'
  have hact : ∀ u : ↥U, tL (QuotientGroup.mk u) =
      QuotientGroup.mk (conjAct U ⟨t, hHU htH⟩ u) := by
    intro u
    change π (QuotientGroup.mk (⟨t, htH⟩ : ↥H)) (QuotientGroup.mk u) =
      QuotientGroup.mk (conjAct U ⟨t, hHU htH⟩ u)
    rw [hπmk ⟨t, htH⟩]
    exact CFSG.Quasithin.Vol2.Ch11.SecD.quotAct_mk (K := H) (U := U) (Z := U')
      hHU hHU' ⟨t, htH⟩ u
  exact ⟨hntW, L, tL,
    hLq.1, hLirr, htL, htL2, htL1, hact, ⟨eCQ⟩,
    fun w => by rw [← pow_two]; exact hWsq w⟩

private theorem exists_minimal_noncentral_section
    {G : Type} [Group G] [Finite G] {H V : Subgroup G}
    (hHV : H ≤ Subgroup.normalizer (V : Set G))
    (hHc : ¬ H ≤ (H ⊓ Subgroup.centralizer (V : Set G)) ⊔ CFSG.Open.pCoreOf 2 H) :
    ∃ U U' : Subgroup G,
      U' < U ∧ U ≤ V ∧
      H ≤ Subgroup.normalizer (U : Set G) ∧ H ≤ Subgroup.normalizer (U' : Set G) ∧
      H ≤ (H ⊓ Subgroup.centralizer (U' : Set G)) ⊔ CFSG.Open.pCoreOf 2 H ∧
      ¬ H ≤ (H ⊓ Subgroup.centralizer (U : Set G)) ⊔ CFSG.Open.pCoreOf 2 H ∧
      ∀ X : Subgroup G, U' ≤ X → X ≤ U → H ≤ Subgroup.normalizer (X : Set G) →
        X = U' ∨ X = U := by
  classical
  let S : Set (Subgroup G) := {U | U ≤ V ∧ H ≤ Subgroup.normalizer (U : Set G) ∧
    ¬ H ≤ (H ⊓ Subgroup.centralizer (U : Set G)) ⊔ CFSG.Open.pCoreOf 2 H}
  have hSne : S.Nonempty := ⟨V, le_rfl, hHV, hHc⟩
  obtain ⟨U, hUS, hUmin⟩ := Set.exists_min_image S (fun U => Nat.card U)
    (Set.toFinite S) hSne
  obtain ⟨hUV, hHU, hUnc⟩ := hUS
  have hcentBot : Subgroup.centralizer ((⊥ : Subgroup G) : Set G) = ⊤ := by
    ext g
    simp [Subgroup.mem_centralizer_iff]
  have hnormBot : H ≤ Subgroup.normalizer ((⊥ : Subgroup G) : Set G) := by
    intro h _
    rw [Subgroup.mem_normalizer_iff]
    intro x
    simp
  have hUne : U ≠ ⊥ := by
    intro hbot
    apply hUnc
    rw [hbot, hcentBot, inf_top_eq]
    exact le_sup_left
  have hbotU : (⊥ : Subgroup G) < U := bot_lt_iff_ne_bot.mpr hUne
  let T : Set (Subgroup G) := {X | X < U ∧ H ≤ Subgroup.normalizer (X : Set G)}
  have hTne : T.Nonempty := ⟨⊥, hbotU, hnormBot⟩
  obtain ⟨U', hU'T, hU'max⟩ := Set.exists_max_image T (fun X => Nat.card X)
    (Set.toFinite T) hTne
  obtain ⟨hU'U, hHU'⟩ := hU'T
  refine ⟨U, U', hU'U, hUV, hHU, hHU', ?_, hUnc, ?_⟩
  ·
    by_contra hcon
    exact absurd (hUmin U' ⟨hU'U.le.trans hUV, hHU', hcon⟩)
      (not_le.mpr (Subgroup.card_lt_of_lt hU'U))
  ·
    intro X hU'X hXU hHX
    rcases eq_or_lt_of_le hXU with hXU' | hXU'
    · exact Or.inr hXU' 
    · left
      have hXT : X ∈ T := ⟨hXU', hHX⟩
      have hcard := hU'max X hXT
      exact (Subgroup.eq_of_le_of_card_ge hU'X (by omega)).symm

private theorem sz_actor_facts
    {X : Type} [Group X] {a : ℕ} (ha : 1 ≤ a) (e : X ≃* CFSG.Open.Sz a) :
    CFSG.IsQuasisimple X ∧ (∀ z ∈ Subgroup.center X, z * z = 1 → z = 1) ∧
      ∀ (W : Type) [CommGroup W] [Finite W] [Nontrivial W], (∀ w : W, w * w = 1) →
        ∀ L : Subgroup (MulAut W), Group.IsPerfect ↥L →
        (∀ K : Subgroup W, (∀ g ∈ L, ∀ w ∈ K, g w ∈ K) → K = ⊥ ∨ K = ⊤) →
        Nonempty (CQ L ≃* X ⧸ Subgroup.center X) →
        ∀ t ∈ L, t * t = 1 → t ≠ 1 →
          (2 ^ (2 * a + 1)) ^ 2 ≤ (fixV (Subgroup.zpowers t)).index := by
  have hZ : Subgroup.center X = ⊥ := by
    rw [← Subgroup.map_center_eq e.symm, center_sz a ha, Subgroup.map_bot]
  refine ⟨CFSG.LocalCores.isQuasisimple_of_mulEquiv e.symm (isQuasisimple_sz a ha), ?_, ?_⟩
  · intro z hz _
    rw [hZ] at hz
    exact Subgroup.mem_bot.mp hz
  · intro W _ _ _ hW L hperf hirr ⟨eL⟩ t htL ht2 ht1
    have hK : Nat.card (GaloisField 2 (2 * a + 1)) = 2 ^ (2 * a + 1) :=
      GaloisField.card 2 (2 * a + 1) (by omega)
    have h := suzuki_pow_le_index_fixV a ha hK W hW L hperf hirr
      (eL.trans ((quotientCenterEquivSelf' hZ).trans
        (e.trans (suzukiGroupEquivSz a (GaloisField 2 (2 * a + 1)) hK).symm))) t htL ht2 ht1
    rw [← pow_mul']
    exact h

private theorem unitary_quot_facts
    {X : Type} [Group X] {n : ℕ} (hn : 2 ≤ n) {F : Type} [Field F] [Finite F]
    (hF : Nat.card F = (2 ^ n) ^ 2)
    (he : Nonempty (X ≃* CFSG.Open.StatedSU 3 (2 ^ n) F) ∨
      Nonempty (X ≃* CFSG.Open.StatedProj (CFSG.Open.StatedSU 3 (2 ^ n) F))) :
    CFSG.IsQuasisimple X ∧ (∀ z ∈ Subgroup.center X, z * z = 1 → z = 1) ∧
      Nonempty (X ⧸ Subgroup.center X ≃*
        CFSG.Open.StatedProj (CFSG.Open.StatedSU 3 (2 ^ n) F)) := by
  letI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  letI : Fintype F := Fintype.ofFinite F
  have hcard : Fintype.card F = 2 ^ (2 * n) := by
    rw [← Nat.card_eq_fintype_card, hF, ← pow_mul, Nat.mul_comm n 2]
  haveI : CharP F 2 := charP_of_card_eq_prime_pow (f := 2 * n) hcard
  have hnq : ((3 : ℕ), 2 ^ n) ≠ (3, 2) := by
    intro h
    have h2 : 2 ^ n = 2 := congrArg Prod.snd h
    have hle : 2 ^ 2 ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
    omega
  have hSU := CFSG.LieType.Universal.Unitary.isQuasisimple_statedSU_of_card
    (p := 2) (f := n) (F := F) hF (by norm_num) hnq
  rcases he with he | he
  · obtain ⟨e⟩ := he
    refine ⟨CFSG.LocalCores.isQuasisimple_of_mulEquiv e.symm hSU.1, ?_, ?_⟩
    · intro z hz hzz
      have hz' : e z ∈ Subgroup.center (CFSG.Open.StatedSU 3 (2 ^ n) F) := by
        rw [← Subgroup.map_center_eq e]
        exact Subgroup.mem_map_of_mem e.toMonoidHom hz
      have h3 := center_statedSU_pow_three hn hF (e z) hz'
      have h2 : e z * e z = 1 := by rw [← map_mul, hzz, map_one]
      have h1 : e z = 1 := by
        calc e z = e z ^ 3 * (e z * e z)⁻¹ := by group
          _ = 1 := by rw [h3, h2, inv_one, one_mul]
      exact e.injective (h1.trans (map_one e).symm)
    · exact ⟨(quotientCenterCongr' e).trans (QuotientGroup.quotientMulEquivOfEq hSU.2)⟩
  · obtain ⟨e⟩ := he
    have hSimple : IsSimpleGroup (CFSG.Open.StatedProj (CFSG.Open.StatedSU 3 (2 ^ n) F)) :=
      CFSG.ClassicalGroups.Unitary.isSimpleGroup_statedProj_statedSU F 2 n hF 3
        (by norm_num) hnq
    haveI := hSimple
    have hnc := CFSG.Quasithin.F6.InspRest.exists_noncomm_statedProj
      (H := CFSG.Open.StatedSU 3 (2 ^ n) F) hSU.1 hSimple
    have hP := CFSG.LocalCores.isQuasisimple_of_isSimpleGroup hnc
    have hZ : Subgroup.center X = ⊥ := by
      rw [← Subgroup.map_center_eq e.symm, hP.2, Subgroup.map_bot]
    refine ⟨CFSG.LocalCores.isQuasisimple_of_mulEquiv e.symm hP.1, ?_, ?_⟩
    · intro z hz _
      rw [hZ] at hz
      exact Subgroup.mem_bot.mp hz
    · exact ⟨(quotientCenterEquivSelf' hZ).trans e⟩

open CFSG.QuasithinUnique.Setup in
private theorem unitary_actor_bound
    {n : ℕ} (hn : 2 ≤ n) {F : Type} [Field F] [Finite F] (hF : Nat.card F = (2 ^ n) ^ 2)
    {W : Type} [CommGroup W] [Finite W] [Nontrivial W] (hW : ∀ w : W, w * w = 1)
    (L : Subgroup (MulAut W)) (hperf : Group.IsPerfect ↥L)
    (hirr : ∀ K : Subgroup W, (∀ g ∈ L, ∀ w ∈ K, g w ∈ K) → K = ⊥ ∨ K = ⊤)
    (e : CQ L ≃* CFSG.Open.StatedProj (CFSG.Open.StatedSU 3 (2 ^ n) F))
    {t : MulAut W} (htL : t ∈ L) (ht2 : t * t = 1) (ht1 : t ≠ 1) :
    (2 ^ n) ^ 2 ≤ (fixV (Subgroup.zpowers t)).index := by
  have hU : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData 2 n F :=
    ⟨Nat.prime_two, by omega, by rw [hF, ← pow_mul, mul_comm]⟩
  have h := (X5.irreducible_even_unitary_three_full_normalizer_excludes_binary_offenders
    hn hU hW L hperf hirr
    (e.trans (CFSG.ClassicalGroups.UnitaryFlag.unitaryPSUEquiv hU (by norm_num)).symm)).2.2.1
    t htL ht2 ht1
  rw [← pow_mul']
  exact h

theorem bender_actor_facts
    {X : Type} [Group X] {q : ℕ}
    (hX : (∃ a : ℕ, 1 ≤ a ∧ q = 2 ^ (2 * a + 1) ∧ Nonempty (X ≃* CFSG.Open.Sz a)) ∨
      (∃ n : ℕ, 2 ≤ n ∧ q = 2 ^ n ∧ ∃ (F : Type) (_ : Field F) (_ : Finite F),
        Nat.card F = (2 ^ n) ^ 2 ∧
        (Nonempty (X ≃* CFSG.Open.StatedSU 3 (2 ^ n) F) ∨
          Nonempty (X ≃* CFSG.Open.StatedProj (CFSG.Open.StatedSU 3 (2 ^ n) F))))) :
    CFSG.IsQuasisimple X ∧ (∀ z ∈ Subgroup.center X, z * z = 1 → z = 1) ∧
      ∀ (W : Type) [CommGroup W] [Finite W] [Nontrivial W], (∀ w : W, w * w = 1) →
        ∀ L : Subgroup (MulAut W), Group.IsPerfect ↥L →
        (∀ K : Subgroup W, (∀ g ∈ L, ∀ w ∈ K, g w ∈ K) → K = ⊥ ∨ K = ⊤) →
        Nonempty (CQ L ≃* X ⧸ Subgroup.center X) →
        ∀ t ∈ L, t * t = 1 → t ≠ 1 → q ^ 2 ≤ (fixV (Subgroup.zpowers t)).index := by
  rcases hX with ⟨a, ha, rfl, ⟨e⟩⟩ | ⟨n, hn, rfl, F, hFld, hFin, hF, he⟩
  · exact sz_actor_facts ha e
  · obtain ⟨hQ, hZ, ⟨eQ⟩⟩ := unitary_quot_facts hn hF he
    refine ⟨hQ, hZ, ?_⟩
    intro W _ _ _ hW L hperf hirr ⟨eL⟩ t htL ht2 ht1
    exact unitary_actor_bound hn hF hW L hperf hirr (eL.trans eQ) htL ht2 ht1

theorem sq_le_relIndex_centralizer_of_sq_mem
    {G : Type} [Group G] [Finite G] {H V : Subgroup G} {q : ℕ}
    (hX : (∃ a : ℕ, 1 ≤ a ∧ q = 2 ^ (2 * a + 1) ∧
        Nonempty (CFSG.Quasithin.oTwoQuot ↥H ≃* CFSG.Open.Sz a)) ∨
      (∃ n : ℕ, 2 ≤ n ∧ q = 2 ^ n ∧ ∃ (F : Type) (_ : Field F) (_ : Finite F),
        Nat.card F = (2 ^ n) ^ 2 ∧
        (Nonempty (CFSG.Quasithin.oTwoQuot ↥H ≃* CFSG.Open.StatedSU 3 (2 ^ n) F) ∨
          Nonempty (CFSG.Quasithin.oTwoQuot ↥H ≃*
            CFSG.Open.StatedProj (CFSG.Open.StatedSU 3 (2 ^ n) F)))))
    (hV : ∀ v ∈ V, v * v = 1) (hHV : H ≤ Subgroup.normalizer (V : Set G))
    (hHc : ¬ H ≤ (H ⊓ Subgroup.centralizer (V : Set G)) ⊔ CFSG.Open.pCoreOf 2 H)
    {t : G} (htH : t ∈ H) (ht : t * t ∈ CFSG.Open.pCoreOf 2 H)
    (htO : t ∉ CFSG.Open.pCoreOf 2 H) :
    q ^ 2 ≤ (V ⊓ Subgroup.centralizer ({t} : Set G)).relIndex V := by
  classical
  obtain ⟨hQ, hZinv, hbound⟩ := bender_actor_facts hX
  obtain ⟨U, U', hU'U, hUV, hHU, hHU', hmin, hUnc, hmax⟩ :=
    exists_minimal_noncentral_section hHV hHc
  have hUelem : CFSG.Open.IsElemAbelian 2 U := by
    have hsq : ∀ x ∈ U, x * x = 1 := fun x hx => hV x (hUV hx)
    refine ⟨⟨⟨fun a b => Subtype.ext ?_⟩⟩, fun x hx => by rw [pow_two]; exact hsq x hx⟩
    have hinv : ∀ x ∈ U, x⁻¹ = x := fun x hx => inv_eq_of_mul_eq_one_right (hsq x hx)
    have hab := inv_eq_of_mul_eq_one_right (hsq _ (U.mul_mem a.2 b.2))
    rw [mul_inv_rev, hinv _ a.2, hinv _ b.2] at hab
    exact hab.symm
  have hUcomm : ∀ a b : ↥U, a * b = b * a := by
    haveI : IsMulCommutative ↥U := hUelem.1
    exact fun a b => (IsMulCommutative.is_comm (M := ↥U)).comm a b
  haveI : (U'.subgroupOf U).Normal :=
    CFSG.Quasithin.H13.C1294.IDIrr.subgroupOf_normal_of_comm
      (fun a ha b hb => congrArg Subtype.val (hUcomm ⟨a, ha⟩ ⟨b, hb⟩))
  have hUsec : ∀ a ∈ U, ∀ b ∈ U, a * b * a⁻¹ * b⁻¹ ∈ U' ∧ a * a ∈ U' := by
    intro a ha b hb
    have ha2 : a * a = 1 := by simpa [pow_two] using hUelem.2 a ha
    have hb2 : b * b = 1 := by simpa [pow_two] using hUelem.2 b hb
    have hai : a⁻¹ = a := inv_eq_of_mul_eq_one_right ha2
    have hbi : b⁻¹ = b := inv_eq_of_mul_eq_one_right hb2
    refine ⟨?_, ?_⟩
    · rw [hai, hbi]
      have hab2 : (a * b) * (a * b) = 1 := by
        simpa [pow_two] using hUelem.2 (a * b) (U.mul_mem ha hb)
      have h1 : a * b * a * b = 1 := by simpa [mul_assoc] using hab2
      rw [h1]
      exact U'.one_mem
    · rw [ha2]
      exact U'.one_mem
  have hnotriv : ∃ h ∈ H, ∃ u ∈ U, h * u * h⁻¹ * u⁻¹ ∉ U' := by
    by_contra h
    push Not at h
    exact hUnc (le_sup_of_trivial_section hUelem hHU hHU' hU'U.le hmin h hQ.1)
  obtain ⟨hnt, L, tL, hperf, hirr, htL, htL2, htL1, hact, ⟨eCQ⟩, hsq⟩ :=
    section_actor hUsec hHU hHU' hU'U hmax hnotriv
      (pCoreOf_trivial_on_section hUelem hHU hHU' hU'U hmax) hQ hZinv htH ht htO
  have hWcomm : ∀ x y : SectionW U U', x * y = y * x := by
    intro x y
    induction x using QuotientGroup.induction_on with
    | H a =>
      induction y using QuotientGroup.induction_on with
      | H b => rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, hUcomm a b]
  letI : CommGroup (SectionW U U') :=
    { (inferInstance : Group (SectionW U U')) with mul_comm := hWcomm }
  refine (hbound (SectionW U U') hsq L hperf hirr ⟨eCQ⟩ tL htL htL2 htL1).trans
    (index_le_relIndex_centralizer_of_fixed hUV hU'U hHU hHU' htH _ ?_)
  intro u
  rw [CFSG.Quasithin.mem_fixV_zpowers_iff_apply, hact, QuotientGroup.eq,
    Subgroup.mem_subgroupOf]
  have hx : t * (u : G) * t⁻¹ ∈ U := (Subgroup.mem_normalizer_iff.mp (hHU htH) u).mp u.2
  have hc : (u : G)⁻¹ * (t * u * t⁻¹) = t * u * t⁻¹ * (u : G)⁻¹ :=
    congrArg Subtype.val (hUcomm ⟨(u : G)⁻¹, U.inv_mem u.2⟩ ⟨_, hx⟩)
  change (t * (u : G) * t⁻¹)⁻¹ * (u : G) ∈ U' ↔ _
  rw [← U'.inv_mem_iff (x := (t * (u : G) * t⁻¹)⁻¹ * u), mul_inv_rev, inv_inv, hc]

theorem sq_le_relIndex_centralizer
    {G : Type} [Group G] [Finite G] {H V : Subgroup G} {q : ℕ}
    (hX : (∃ a : ℕ, 1 ≤ a ∧ q = 2 ^ (2 * a + 1) ∧
        Nonempty (CFSG.Quasithin.oTwoQuot ↥H ≃* CFSG.Open.Sz a)) ∨
      (∃ n : ℕ, 2 ≤ n ∧ q = 2 ^ n ∧ ∃ (F : Type) (_ : Field F) (_ : Finite F),
        Nat.card F = (2 ^ n) ^ 2 ∧
        (Nonempty (CFSG.Quasithin.oTwoQuot ↥H ≃* CFSG.Open.StatedSU 3 (2 ^ n) F) ∨
          Nonempty (CFSG.Quasithin.oTwoQuot ↥H ≃*
            CFSG.Open.StatedProj (CFSG.Open.StatedSU 3 (2 ^ n) F)))))
    (hV : ∀ v ∈ V, v * v = 1) (hHV : H ≤ Subgroup.normalizer (V : Set G))
    (hHc : ¬ H ≤ (H ⊓ Subgroup.centralizer (V : Set G)) ⊔ CFSG.Open.pCoreOf 2 H)
    {t : G} (htH : t ∈ H) (ht : t * t = 1) (htO : t ∉ CFSG.Open.pCoreOf 2 H) :
    q ^ 2 ≤ (V ⊓ Subgroup.centralizer ({t} : Set G)).relIndex V :=
  sq_le_relIndex_centralizer_of_sq_mem hX hV hHV hHc htH (ht ▸ Subgroup.one_mem _) htO

theorem sq_le_relIndex_centralizer_of_pCoreOf_le
    {G : Type} [Group G] [Finite G] {H V : Subgroup G} {q : ℕ}
    (hX : (∃ a : ℕ, 1 ≤ a ∧ q = 2 ^ (2 * a + 1) ∧
        Nonempty (CFSG.Quasithin.oTwoQuot ↥H ≃* CFSG.Open.Sz a)) ∨
      (∃ n : ℕ, 2 ≤ n ∧ q = 2 ^ n ∧ ∃ (F : Type) (_ : Field F) (_ : Finite F),
        Nat.card F = (2 ^ n) ^ 2 ∧
        (Nonempty (CFSG.Quasithin.oTwoQuot ↥H ≃* CFSG.Open.StatedSU 3 (2 ^ n) F) ∨
          Nonempty (CFSG.Quasithin.oTwoQuot ↥H ≃*
            CFSG.Open.StatedProj (CFSG.Open.StatedSU 3 (2 ^ n) F)))))
    (hV : ∀ v ∈ V, v * v = 1) (hHV : H ≤ Subgroup.normalizer (V : Set G))
    (hO : CFSG.Open.pCoreOf 2 H ≤ Subgroup.centralizer (V : Set G))
    (hHV' : ¬ H ≤ Subgroup.centralizer (V : Set G))
    {t : G} (htH : t ∈ H) (ht : t * t = 1) (htO : t ∉ CFSG.Open.pCoreOf 2 H) :
    q ^ 2 ≤ (V ⊓ Subgroup.centralizer ({t} : Set G)).relIndex V :=
  sq_le_relIndex_centralizer hX hV hHV (fun hle => hHV' (hle.trans (sup_le inf_le_right hO)))
    htH ht htO

end CFSG.Quasithin.Stroth
