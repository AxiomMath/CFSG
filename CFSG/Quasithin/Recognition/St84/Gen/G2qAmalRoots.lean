private theorem eq_zero_of_mul_eq_self {u x : K} (hu : u ≠ 1) (h : u * x = x) : x = 0 := by
  have h' : (u - 1) * x = 0 := by linear_combination h
  exact (mul_eq_zero.1 h').resolve_left (sub_ne_zero.2 hu)

private theorem sq_ne_one_of_ne_one {u : K} (hu : u ≠ 1) : u ^ 2 ≠ 1 := fun h =>
  hu (eq_one_of_mul_self_eq_one_two (by rw [← sq]; exact h))

theorem g2N_eq_of_commute_dT_left {s : Kˣ} (hs : s ≠ 1) {A B C D E F : K}
    (h : dT s 1 * g2N A B C D E F = g2N A B C D E F * dT s 1) :
    g2N A B C D E F = X g2r A := by
  obtain ⟨-, h2, h3, h4, h5, h6⟩ := (dT_comm_g2N_iff s 1 A B C D E F).1 h
  simp only [Units.val_one, one_pow, mul_one] at h3 h4 h5 h6
  have hs' : (s : K) ≠ 1 := fun e => hs (Units.val_eq_one.1 e)
  rw [eq_zero_of_mul_eq_self hs' h2, eq_zero_of_mul_eq_self hs' h3,
    eq_zero_of_mul_eq_self hs' h4, eq_zero_of_mul_eq_self hs' h5,
    eq_zero_of_mul_eq_self (sq_ne_one_of_ne_one hs') h6, pinnedX_r_eq_g2N]

theorem g2N_eq_of_commute_dT_right {w : Kˣ} (hw : (w : K) ^ 3 ≠ 1) {A B C D E F : K}
    (h : dT 1 w * g2N A B C D E F = g2N A B C D E F * dT 1 w) :
    g2N A B C D E F = X g2a B := by
  obtain ⟨h1, -, h3, h4, h5, h6⟩ := (dT_comm_g2N_iff 1 w A B C D E F).1 h
  simp only [Units.val_one, one_pow, one_mul] at h3 h4 h5 h6
  have hw1 : (w : K) ≠ 1 := fun e => hw (by rw [e, one_pow])
  rw [eq_zero_of_mul_eq_self hw1 h1, eq_zero_of_mul_eq_self hw1 h3,
    eq_zero_of_mul_eq_self (sq_ne_one_of_ne_one hw1) h4, eq_zero_of_mul_eq_self hw h5,
    eq_zero_of_mul_eq_self hw h6, pinnedX_a_eq_g2N]

theorem eq_one_of_commute_dT_of_ne_zero_left {s t : Kˣ} {A B C D E F : K} (hA : A ≠ 0)
    (h : dT s t * g2N A B C D E F = g2N A B C D E F * dT s t) : t = 1 := by
  obtain ⟨h1, -⟩ := (dT_comm_g2N_iff s t A B C D E F).1 h
  have h' : ((t : K) - 1) * A = 0 := by linear_combination h1
  exact Units.val_eq_one.1 (sub_eq_zero.1 ((mul_eq_zero.1 h').resolve_right hA))

theorem eq_one_of_commute_dT_of_ne_zero_right {s t : Kˣ} {A B C D E F : K} (hB : B ≠ 0)
    (h : dT s t * g2N A B C D E F = g2N A B C D E F * dT s t) : s = 1 := by
  obtain ⟨-, h2, -⟩ := (dT_comm_g2N_iff s t A B C D E F).1 h
  have h' : ((s : K) - 1) * B = 0 := by linear_combination h2
  exact Units.val_eq_one.1 (sub_eq_zero.1 ((mul_eq_zero.1 h').resolve_right hB))

theorem eq_one_of_commute_dT_of_ne_zero_top {s t : Kˣ} {A B C D E F : K} (hF : F ≠ 0)
    (h : dT s t * g2N A B C D E F = g2N A B C D E F * dT s t) :
    (s : K) ^ 2 * (t : K) ^ 3 = 1 := by
  obtain ⟨-, -, -, -, -, h6⟩ := (dT_comm_g2N_iff s t A B C D E F).1 h
  have h' : ((s : K) ^ 2 * (t : K) ^ 3 - 1) * F = 0 := by linear_combination h6
  exact sub_eq_zero.1 ((mul_eq_zero.1 h').resolve_right hF)

theorem g2N_mem_of_forall_mem {S : Subgroup (ModGL Tag.G2 K)} {s₀ : K} (h0 : s₀ ≠ 0)
    (h1 : s₀ ≠ 1) (hr : ∀ c, X g2r c ∈ S) (ha : ∀ c, X g2a c ∈ S) (A B C D E F : K) :
    g2N A B C D E F ∈ S := by
  have hs1 : s₀ + 1 ≠ 0 := fun h => h1 (by linear_combination h - two_eq_zero_K (K := K))
  have hs : s₀ ^ 2 + s₀ ≠ 0 := by
    rw [show s₀ ^ 2 + s₀ = s₀ * (s₀ + 1) by ring]
    exact mul_ne_zero h0 hs1
  have hdiv : ∀ z : K, z * (s₀ ^ 2 + s₀)⁻¹ * (s₀ ^ 2 + s₀) = z := fun z => by
    rw [mul_assoc, inv_mul_cancel₀ hs, mul_one]
  have hw : ∀ x y : K, g2N 0 0 (x * y) (x * y ^ 2) (x * y ^ 3) (x ^ 2 * y ^ 3) ∈ S := by
    intro x y
    have e : g2N (0 : K) 0 (x * y) (x * y ^ 2) (x * y ^ 3) (x ^ 2 * y ^ 3) =
        ⁅X g2a x, X g2r y⁆ := by
      rw [comm_a_r]
      simp only [g2N, pinnedX_zero, one_mul]
    rw [e, commutatorElement_def]
    exact mul_mem (mul_mem (mul_mem (ha x) (hr y)) (inv_mem (ha x))) (inv_mem (hr y))
  have hw1 : ∀ x : K, g2N 0 0 x x x (x ^ 2) ∈ S := fun x => by
    have := hw x 1
    simp only [one_pow, mul_one] at this
    exact this
  have hcS : ∀ x, X g2c x ∈ S := by
    intro x
    have e : X g2a 1 * g2N 0 0 x x x (x ^ 2) * X g2a 1 = g2N 0 0 x x x (x ^ 2) * X g2c x := by
      rw [conj_a, g2N_mul_c]
      exact g2N_eq_g2N rfl rfl (by ring) (by ring) (by ring) (by ring)
    have e' : X g2c x =
