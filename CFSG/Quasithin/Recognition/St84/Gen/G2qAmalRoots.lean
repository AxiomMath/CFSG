local notation "X" => pinnedX Tag.G2 K

@[expose] def dTHom : Kˣ × Kˣ →* ModGL Tag.G2 K where
  toFun p := dT p.1 p.2
  map_one' := dT_one
  map_mul' p q := (dT_mul p.1 p.2 q.1 q.2).symm

theorem range_dTHom : (dTHom (K := K)).range = torusGroup Tag.G2 K := by
  ext h
  rw [MonoidHom.mem_range, mem_torusGroup_iff]
  constructor
  · rintro ⟨p, rfl⟩
    exact ⟨p.1, p.2, rfl⟩
  · rintro ⟨s, t, rfl⟩
    exact ⟨(s, t), rfl⟩

theorem dTHom_injective : Function.Injective (dTHom (K := K)) := fun p q h => by
  obtain ⟨h1, h2⟩ := dT_injective h
  exact Prod.ext h1 h2

theorem card_torusGroup : Nat.card (torusGroup Tag.G2 K) = (Nat.card K - 1) ^ 2 := by
  rw [← range_dTHom, ← Nat.card_congr (MonoidHom.ofInjective dTHom_injective).toEquiv,
    Nat.card_prod, Nat.card_units, sq]

theorem mem_borelGroup_iff {g : ModGL Tag.G2 K} :
    g ∈ borelGroup Tag.G2 K ↔
      ∃ (s t : Kˣ) (A B C D E F : K), g = dT s t * g2N A B C D E F := by
  constructor
  · intro hg
    have hg' : g ∈ (torusGroup Tag.G2 K : Set (ModGL Tag.G2 K)) *
        (posUnipotent Tag.G2 K : Set (ModGL Tag.G2 K)) := by
      rw [← (triangular_borel_structure.{0, 0} Tag.G2 K).2.2.2.2.1]
      exact hg
    obtain ⟨h, hh, u, hu, rfl⟩ := hg'
    obtain ⟨s, t, rfl⟩ := mem_torusGroup_iff.1 hh
    obtain ⟨A, B, C, D, E, F, rfl⟩ := exists_g2N_of_mem_posUnipotent hu
    exact ⟨s, t, A, B, C, D, E, F, rfl⟩
  · rintro ⟨s, t, A, B, C, D, E, F, rfl⟩
    exact mul_mem (Subgroup.mem_sup_left (dT_mem_torusGroup s t))
      (Subgroup.mem_sup_right (g2N_mem_posUnipotent A B C D E F))

theorem g2N_mem_borelGroup (A B C D E F : K) : g2N A B C D E F ∈ borelGroup Tag.G2 K :=
  Subgroup.mem_sup_right (g2N_mem_posUnipotent A B C D E F)

theorem dT_mem_borelGroup (s t : Kˣ) : dT s t ∈ borelGroup Tag.G2 K :=
  Subgroup.mem_sup_left (dT_mem_torusGroup s t)

theorem g2N_mem_parabolicRadical_one_iff {A B C D E F : K} :
    g2N A B C D E F ∈ parabolicRadical Tag.G2 K {i1} ↔ A = 0 := by
  constructor
  · intro h
    obtain ⟨t₁, t₂, t₃, t₄, t₅, ht⟩ := coords_one h
    have e : g2N A B C D E F = g2N 0 t₁ t₂ t₃ t₄ t₅ := by
      rw [ht]
      simp only [g2N, pinnedX_zero, one_mul, mul_assoc]
      rfl
    exact (g2N_injective e).1
  · rintro rfl
    have h : g2N (0 : K) B C D E F = X g2a B * (X g2u C * (X g2v D * (X g2b E * X g2c F))) := by
      simp only [g2N, pinnedX_zero, one_mul, mul_assoc]
    rw [h]
    exact mul_mem (mem_one (Or.inl rfl) B) (mul_mem (mem_one (Or.inr (Or.inl rfl)) C)
      (mul_mem (mem_one (Or.inr (Or.inr (Or.inl rfl))) D)
        (mul_mem (mem_one (Or.inr (Or.inr (Or.inr (Or.inl rfl)))) E)
          (mem_one (Or.inr (Or.inr (Or.inr (Or.inr rfl)))) F))))

theorem mem_pCoreOf_g2ParA_iff [Finite K] [CharP K 2] {y : ↥(adjointGroup Tag.G2 K)} :
    y ∈ pCoreOf 2 (g2ParA K) ↔ (y : ModGL Tag.G2 K) ∈ parabolicRadical Tag.G2 K {i1} := by
  have e : g2ParA K = (parabolicSubgroup Tag.G2 K {i1}).subgroupOf (adjointGroup Tag.G2 K) := by
    rw [g2ParA, g2Index_one]
  rw [e, CFSG.RankThree.GF2n.Tim79a.pCoreOf_subgroupOf_of_le 2
    (parabolicSubgroup_le_adjointGroup _ _ _),
    CFSG.StandardType.GGOppRadExc.pCoreOf_parabolicSubgroup]
  exact Subgroup.mem_subgroupOf

