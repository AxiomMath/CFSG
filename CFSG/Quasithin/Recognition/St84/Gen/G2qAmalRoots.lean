private theorem commute_iff_conj_eq {G : Type*} [Group G] {x y : G} (hy : y * y = 1) :
    Commute x y ↔ y * x * y = x := by
  constructor
  · intro h
    rw [← h.eq, mul_assoc, hy, mul_one]
  · intro h
    change x * y = y * x
    calc x * y = y * x * y * y := by rw [h]
      _ = y * x := by rw [mul_assoc (y * x), hy, mul_one]

theorem g2N_commute_X_r_iff {A B C D E F : K} :
    (∀ c : K, Commute (g2N A B C D E F) (X g2r c)) ↔ B = 0 ∧ C = 0 ∧ D = 0 := by
  constructor
  · intro h
    have h1 := (commute_iff_conj_eq (pinnedX_mul_self g2r 1)).1 (h 1)
    rw [conj_r] at h1
    obtain ⟨-, -, e3, -, e5, e6⟩ := g2N_injective h1
    have hB : B = 0 := by linear_combination e3
    subst hB
    have hC2 : C ^ 2 = 0 := by linear_combination e6
    have hC : C = 0 := pow_eq_zero_iff (two_ne_zero) |>.1 hC2
    subst hC
    exact ⟨rfl, rfl, by linear_combination e5⟩
  · rintro ⟨rfl, rfl, rfl⟩ c
    rw [commute_iff_conj_eq (pinnedX_mul_self g2r c), conj_r]
    exact g2N_eq_g2N rfl rfl (by ring) (by ring) (by ring) (by ring)

theorem g2N_commute_X_a_iff {A B C D E F : K} :
    (∀ c : K, Commute (g2N A B C D E F) (X g2a c)) ↔ A = 0 ∧ E = 0 := by
  constructor
  · intro h
    have h1 := (commute_iff_conj_eq (pinnedX_mul_self g2a 1)).1 (h 1)
    rw [conj_a] at h1
    obtain ⟨-, -, e3, -, -, e6⟩ := g2N_injective h1
    have hA : A = 0 := by linear_combination e3
    subst hA
    exact ⟨rfl, by linear_combination e6⟩
  · rintro ⟨rfl, rfl⟩ c
    rw [commute_iff_conj_eq (pinnedX_mul_self g2a c), conj_a]
    exact g2N_eq_g2N rfl rfl (by ring) (by ring) (by ring) (by ring)

theorem g2N_commute_X_b_iff {A B C D E F : K} :
    (∀ c : K, Commute (g2N A B C D E F) (X g2b c)) ↔ B = 0 := by
  constructor
  · intro h
    have h1 := (commute_iff_conj_eq (pinnedX_mul_self g2b 1)).1 (h 1)
    rw [conj_b] at h1
    obtain ⟨-, -, -, -, -, e6⟩ := g2N_injective h1
    linear_combination e6
  · rintro rfl c
    rw [commute_iff_conj_eq (pinnedX_mul_self g2b c), conj_b]
    exact g2N_eq_g2N rfl rfl rfl rfl rfl (by ring)

theorem g2N_commute_X_c (A B C D E F c : K) : Commute (g2N A B C D E F) (X g2c c) := by
  rw [commute_iff_conj_eq (pinnedX_mul_self g2c c), conj_c]

theorem g2N_commute_bc_iff {A B C D E F : K} :
    (∀ E' F' : K, Commute (g2N A B C D E F) (g2N 0 0 0 0 E' F')) ↔ B = 0 := by
  have hbc : ∀ E' F' : K, g2N (0 : K) 0 0 0 E' F' = X g2b E' * X g2c F' := fun E' F' => by
    simp only [g2N, pinnedX_zero, one_mul]
  simp only [hbc]
  constructor
  · intro h
    refine (g2N_commute_X_b_iff (A := A) (C := C) (D := D) (E := E) (F := F)).1 fun c => ?_
    have := h c 0
    rwa [pinnedX_zero, mul_one] at this
  · intro hB E' F'
    exact (g2N_commute_X_b_iff.2 hB E').mul_right (g2N_commute_X_c A B C D E F F')

