variable {G : Type*} [Group G] {K : Type} [Field K]

structure LinVertex (C A : Subgroup G) (s : Matrix.SpecialLinearGroup (Fin 2) K →* G)
    (vec : G → Fin 2 → K) : Prop where
  A_le_C : A ≤ C
  s_mem_C : ∀ M, s M ∈ C
  A_comm : ∀ a ∈ A, ∀ b ∈ A, a * b = b * a
  A_sq : ∀ a ∈ A, a ^ 2 = 1
  A_normal_C : ∀ g ∈ C, ∀ a ∈ A, g * a * g⁻¹ ∈ A
  C_decomp : ∀ g ∈ C, ∃ a ∈ A, ∃ M : Matrix.SpecialLinearGroup (Fin 2) K, g = a * s M
  C_unique : ∀ a ∈ A, ∀ a' ∈ A, ∀ M M' : Matrix.SpecialLinearGroup (Fin 2) K,
    a * s M = a' * s M' → a = a' ∧ M = M'
  S_perfect : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin 2) K)
  S_pCore : CFSG.pCore 2 (Matrix.SpecialLinearGroup (Fin 2) K) = ⊥
  vec_add : ∀ z ∈ A, ∀ w ∈ A, vec (z * w) = vec z + vec w
  vec_surj : ∀ v : Fin 2 → K, ∃ z ∈ A, vec z = v
  vec_ker : ∀ z ∈ A, (vec z = 0 ↔ z = 1)
  vec_conj : ∀ (M : Matrix.SpecialLinearGroup (Fin 2) K) (z : G), z ∈ A →
    vec (s M * z * (s M)⁻¹) = (M : Matrix (Fin 2) (Fin 2) K) *ᵥ vec z

variable {C A : Subgroup G} {s : Matrix.SpecialLinearGroup (Fin 2) K →* G} {vec : G → Fin 2 → K}

private theorem LinVertex.vec_one (h : LinVertex C A s vec) : vec 1 = 0 := by
  have h1 := h.vec_add 1 A.one_mem 1 A.one_mem
  rw [mul_one] at h1
  exact left_eq_add.mp h1

private theorem LinVertex.vec_inv (h : LinVertex C A s vec) {z : G} (hz : z ∈ A) :
    vec z⁻¹ = -vec z := by
  have h1 := h.vec_add z hz z⁻¹ (A.inv_mem hz)
  rw [mul_inv_cancel, h.vec_one] at h1
  exact eq_neg_of_add_eq_zero_right h1.symm

private theorem LinVertex.isPGroup_A (h : LinVertex C A s vec) : IsPGroup 2 A := fun a =>
  ⟨1, by simpa using Subtype.ext (h.A_sq (a : G) a.2)⟩

private theorem LinVertex.normal_subgroupOf (h : LinVertex C A s vec) :
    (A.subgroupOf C).Normal where
  conj_mem a ha g := by
    rw [Subgroup.mem_subgroupOf] at ha ⊢
    exact h.A_normal_C (g : G) g.2 (a : G) ha

private theorem LinVertex.range_le (h : LinVertex C A s vec) : (s.range : Subgroup G) ≤ C := by
  rintro x hx
  obtain ⟨M, rfl⟩ := MonoidHom.mem_range.mp hx
  exact h.s_mem_C M

private theorem LinVertex.C_eq_sup (h : LinVertex C A s vec) : C = A ⊔ (s.range : Subgroup G) := by
  refine le_antisymm (fun g hg => ?_) (sup_le h.A_le_C h.range_le)
  obtain ⟨a, ha, M, rfl⟩ := h.C_decomp g hg
  exact (A ⊔ (s.range : Subgroup G)).mul_mem (Subgroup.mem_sup_left ha)
    (Subgroup.mem_sup_right (MonoidHom.mem_range.mpr ⟨M, rfl⟩))

private noncomputable def LinVertex.quotEquiv (h : LinVertex C A s vec) [(A.subgroupOf C).Normal] :
    Matrix.SpecialLinearGroup (Fin 2) K ≃* (C ⧸ A.subgroupOf C) :=
  MulEquiv.ofBijective
    ((QuotientGroup.mk' (A.subgroupOf C)).comp (s.codRestrict C h.s_mem_C)) (by
      constructor
      · intro M M' hMM'
        rw [MonoidHom.comp_apply, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
          QuotientGroup.mk'_apply, QuotientGroup.eq] at hMM'
        have hmem : (s M)⁻¹ * s M' ∈ A := by
          simpa using Subgroup.mem_subgroupOf.mp hMM'
        have ha' : s M * ((s M)⁻¹ * s M') * (s M)⁻¹ ∈ A :=
          h.A_normal_C (s M) (h.s_mem_C M) _ hmem
        have hEq : 1 * s M' = (s M * ((s M)⁻¹ * s M') * (s M)⁻¹) * s M := by
          rw [one_mul]
          group
        exact (h.C_unique 1 A.one_mem _ ha' M' M hEq).2.symm
      · intro y
        refine Quotient.inductionOn' y ?_
        intro g
        obtain ⟨a, ha, M, hg⟩ := h.C_decomp (g : G) g.2
        refine ⟨M, ?_⟩
        change QuotientGroup.mk (⟨s M, h.s_mem_C M⟩ : C) = QuotientGroup.mk g
        apply QuotientGroup.eq.mpr
        rw [Subgroup.mem_subgroupOf]
        show (s M)⁻¹ * (g : G) ∈ A
        rw [hg]
        have h1 : (s M)⁻¹ * (a * s M) = (s M)⁻¹ * a * s M := by group
        rw [h1]
        simpa using h.A_normal_C (s M)⁻¹ (C.inv_mem (h.s_mem_C M)) a ha)

private noncomputable def LinVertex.proj (h : LinVertex C A s vec) [(A.subgroupOf C).Normal] :
    C →* Matrix.SpecialLinearGroup (Fin 2) K :=
  h.quotEquiv.symm.toMonoidHom.comp (QuotientGroup.mk' (A.subgroupOf C))

private theorem LinVertex.proj_apply_s (h : LinVertex C A s vec) [(A.subgroupOf C).Normal]
    (M : Matrix.SpecialLinearGroup (Fin 2) K) :
    h.proj ⟨s M, h.s_mem_C M⟩ = M := by
  change h.quotEquiv.symm (h.quotEquiv M) = M
  exact h.quotEquiv.symm_apply_apply M

private theorem LinVertex.proj_ker (h : LinVertex C A s vec) [(A.subgroupOf C).Normal] :
    h.proj.ker = A.subgroupOf C := by
  ext x
  rw [MonoidHom.mem_ker]
  show h.quotEquiv.symm (QuotientGroup.mk x : C ⧸ A.subgroupOf C) = 1 ↔ x ∈ A.subgroupOf C
  rw [MulEquiv.symm_apply_eq, map_one]
  exact QuotientGroup.eq_one_iff x

private theorem LinVertex.proj_surjective (h : LinVertex C A s vec) [(A.subgroupOf C).Normal] :
    Function.Surjective h.proj :=
  h.quotEquiv.symm.surjective.comp (QuotientGroup.mk'_surjective (A.subgroupOf C))

private theorem LinVertex.pCore_eq [Finite G] (h : LinVertex C A s vec) : pCoreOf 2 C = A := by
  haveI := h.normal_subgroupOf
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine le_antisymm ?_ (CFSG.LieType.BorelTits.le_pCoreOf 2 h.A_le_C h.normal_subgroupOf
    h.isPGroup_A)
  have hm : (CFSG.pCore 2 C).map h.proj ≤ CFSG.pCore 2 (Matrix.SpecialLinearGroup (Fin 2) K) :=
    CFSG.LieType.BorelTits.map_pCore_le 2 h.proj h.proj_surjective
  rw [h.S_pCore] at hm
  have hle : CFSG.pCore 2 C ≤ A.subgroupOf C := by
    rw [← h.proj_ker, ← Subgroup.map_eq_bot_iff]
    exact le_bot_iff.mp hm
  calc pCoreOf 2 C = (CFSG.pCore 2 C).map C.subtype := rfl
    _ ≤ (A.subgroupOf C).map C.subtype := Subgroup.map_mono hle
    _ = A := Subgroup.map_subgroupOf_eq_of_le h.A_le_C

private theorem LinVertex.pCore_subgroupOf [Finite G] (h : LinVertex C A s vec) :
    CFSG.pCore 2 C = A.subgroupOf C := by
  refine Subgroup.map_injective C.subtype_injective ?_
  rw [Subgroup.map_subgroupOf_eq_of_le h.A_le_C]
  exact h.pCore_eq

private theorem LinVertex.eq_A_of_normal (h : LinVertex C A s vec) {W : Subgroup G} (hWA : W ≤ A)
    (hWn : C ≤ Subgroup.normalizer (W : Set G)) (hW : W ≠ ⊥) : W = A := by
  obtain ⟨z, hzW, hz1⟩ : ∃ z ∈ W, z ≠ 1 := by
    by_contra hall
    push Not at hall
    exact hW (le_antisymm (fun x hx => Subgroup.mem_bot.mpr (hall x hx)) bot_le)
  have hzA : z ∈ A := hWA hzW
  have hvz : vec z ≠ 0 := fun hv => hz1 ((h.vec_ker z hzA).mp hv)
  have hcover : ∀ u : Fin 2 → K, ∃ w ∈ W, vec w = u := by
    intro u
    by_cases hu : u = 0
    · exact ⟨1, W.one_mem, by rw [hu, h.vec_one]⟩
    · obtain ⟨M, hM⟩ := CFSG.GroupTheory.SteinbergBK.exists_sl2_mulVec_eq (vec z) u hvz hu
      refine ⟨s M * z * (s M)⁻¹, ?_, ?_⟩
      · exact (Subgroup.mem_normalizer_iff.mp (hWn (h.s_mem_C M)) z).mp hzW
      · rw [h.vec_conj M z hzA, hM]
  refine le_antisymm hWA fun a ha => ?_
  obtain ⟨w, hwW, hvw⟩ := hcover (vec a)
  have hwA : w ∈ A := hWA hwW
  have hmem : a * w⁻¹ ∈ A := A.mul_mem ha (A.inv_mem hwA)
  have hvec0 : vec (a * w⁻¹) = 0 := by
    rw [h.vec_add a ha w⁻¹ (A.inv_mem hwA), h.vec_inv hwA, hvw, add_neg_cancel]
  have h1 : a * w⁻¹ = 1 := (h.vec_ker _ hmem).mp hvec0
  have h2 : a = w := mul_inv_eq_one.mp h1
  rw [h2]
  exact hwW

private theorem LinVertex.commutator_range_le (h : LinVertex C A s vec) :
    ⁅A, (s.range : Subgroup G)⁆ ≤ A := by
  refine Subgroup.commutator_le.mpr fun a ha b hb => ?_
  obtain ⟨M, rfl⟩ := hb
  have hconj := h.A_normal_C (s M) (h.s_mem_C M) a⁻¹ (A.inv_mem ha)
  rw [commutatorElement_def, show a * s M * a⁻¹ * (s M)⁻¹ = a * (s M * a⁻¹ * (s M)⁻¹) by group]
  exact A.mul_mem ha hconj

private theorem LinVertex.commutator_range_ne_bot (h : LinVertex C A s vec) :
    ⁅A, (s.range : Subgroup G)⁆ ≠ ⊥ := by
  obtain ⟨z, hzA, hzv⟩ := h.vec_surj ![0, 1]
  have hmem : ⁅z, s (trU K)⁆ ∈ ⁅A, (s.range : Subgroup G)⁆ :=
    Subgroup.commutator_mem_commutator hzA ⟨trU K, rfl⟩
  intro hbot
  have h1 : ⁅z, s (trU K)⁆ = 1 := Subgroup.mem_bot.mp (hbot ▸ hmem)
  have h2 : s (trU K) * z * (s (trU K))⁻¹ = z := by
    rw [commutatorElement_eq_one_iff_mul_comm] at h1
    rw [← h1]
    group
  have h3 : vec z = (trU K : Matrix (Fin 2) (Fin 2) K) *ᵥ vec z := by
    rw [← h.vec_conj (trU K) z hzA, h2]
  rw [hzv] at h3
  have h4 := congrFun h3 0
  simp [trU, Matrix.mulVec, dotProduct, Fin.sum_univ_two] at h4

private theorem LinVertex.blockU_eq [Finite G] (h : LinVertex C A s vec) : blockU C = A := by
  have hnorm₀ : ((⁅A, (s.range : Subgroup G)⁆).subgroupOf (A ⊔ (s.range : Subgroup G))).Normal :=
    CFSG.commutator_normal_in_sup A (s.range : Subgroup G)
  have hnorm : C ≤ Subgroup.normalizer
      ((⁅A, (s.range : Subgroup G)⁆ : Subgroup G) : Set G) := by
    rw [h.C_eq_sup]
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer
      (CFSG.commutator_le_sup A (s.range : Subgroup G))).mp
      hnorm₀
  have hAs : ⁅A, (s.range : Subgroup G)⁆ = A :=
    h.eq_A_of_normal h.commutator_range_le hnorm h.commutator_range_ne_bot
  have hle : ⁅A, C⁆ ≤ A := by
    refine Subgroup.commutator_le.mpr fun a ha g hg => ?_
    rw [commutatorElement_def]
    have hconj := h.A_normal_C g hg a⁻¹ (A.inv_mem ha)
    rw [show a * g * a⁻¹ * g⁻¹ = a * (g * a⁻¹ * g⁻¹) by group]
    exact A.mul_mem ha hconj
  have hge : A ≤ ⁅A, C⁆ := by
    have h1 : ⁅A, (s.range : Subgroup G)⁆ ≤ ⁅A, C⁆ :=
      Subgroup.commutator_mono le_rfl h.range_le
    calc A = ⁅A, (s.range : Subgroup G)⁆ := hAs.symm
      _ ≤ ⁅A, C⁆ := h1
  show ⁅blockQ C, C⁆ = A
  rw [show blockQ C = A from h.pCore_eq]
  exact le_antisymm hle hge

private theorem LinVertex.blockZ_eq [Finite G] (h : LinVertex C A s vec) : blockZ C = ⊥ := by
  rw [blockZ, h.blockU_eq]
  refine le_antisymm ?_ bot_le
  rintro z hz
  rw [Subgroup.mem_inf] at hz
  obtain ⟨hzA, hzc⟩ := hz
  have hfix : ∀ M : Matrix.SpecialLinearGroup (Fin 2) K,
      (M : Matrix (Fin 2) (Fin 2) K) *ᵥ vec z = vec z := by
    intro M
    have h1 : s M * z * (s M)⁻¹ = z := by
      have h2 : s M * z = z * s M := Subgroup.mem_centralizer_iff.mp hzc (s M) (h.s_mem_C M)
      rw [h2]
      group
    rw [← h.vec_conj M z hzA, h1]
  rw [Subgroup.mem_bot]
  exact (h.vec_ker z hzA).mp (eq_zero_of_fixed_tr (hfix (trU K)) (hfix (trL K)))

private theorem LinVertex.commutator_eq [Finite G] (h : LinVertex C A s vec) : ⁅C, C⁆ = C := by
  haveI : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin 2) K) := h.S_perfect
  refine le_antisymm (Subgroup.commutator_le.mpr fun a ha b hb => ?_) ?_
  · rw [commutatorElement_def]
    exact C.mul_mem (C.mul_mem (C.mul_mem ha hb) (C.inv_mem ha)) (C.inv_mem hb)
  · have hA : A ≤ ⁅C, C⁆ := by
      rw [← h.blockU_eq]
      exact Subgroup.commutator_mono (CFSG.LieType.BorelTits.pCoreOf_le 2 C) le_rfl
    have hSr : (s.range : Subgroup G) ≤ ⁅C, C⁆ := by
      have hperf : ⁅(s.range : Subgroup G), (s.range : Subgroup G)⁆ = (s.range : Subgroup G) := by
        have h1 : ⁅(s.range : Subgroup G), (s.range : Subgroup G)⁆ =
            (commutator (Matrix.SpecialLinearGroup (Fin 2) K)).map s := by
          rw [commutator_def, Subgroup.map_commutator, Subgroup.map_top s]
        rw [h1, h.S_perfect.commutator_eq_top, Subgroup.map_top]
      rw [← hperf]
      exact Subgroup.commutator_mono (fun x hx => by
          obtain ⟨M, rfl⟩ := hx
          exact h.s_mem_C M) (fun x hx => by
          obtain ⟨M, rfl⟩ := hx
          exact h.s_mem_C M)
    have hsup : A ⊔ (s.range : Subgroup G) ≤ ⁅C, C⁆ := sup_le hA hSr
    exact h.C_eq_sup.symm ▸ hsup

private theorem LinVertex.A_ne_bot (h : LinVertex C A s vec) : A ≠ ⊥ := by
  obtain ⟨z, hzA, hzv⟩ := h.vec_surj ![1, 0]
  intro hbot
  have hz1 : z = 1 := Subgroup.mem_bot.mp (hbot ▸ hzA)
  rw [hz1, h.vec_one] at hzv
  have h1 := congrFun hzv.symm 0
  simp at h1

theorem LinVertex.isShort2 [Finite G] [Finite K] (h : LinVertex C A s vec)
    (h4 : 4 ≤ Nat.card K) : IsShort2 C := by
  haveI : Group.IsPerfect C := by
    refine ⟨Subgroup.map_injective C.subtype_injective ?_⟩
    rw [Subgroup.map_subtype_commutator, h.commutator_eq, Subgroup.map_top,
      Subgroup.range_subtype]
  haveI := h.normal_subgroupOf
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine ⟨?_, ?_, ?_, Or.inl ?_, ?_⟩
  · intro N _ hN
    by_contra hne
    haveI : Nontrivial (C ⧸ N) := by
      rw [← not_subsingleton_iff_nontrivial]
      intro hsub
      apply hne
      rw [eq_top_iff]
      intro x _
      have hx : (x : C ⧸ N) = 1 := Subsingleton.elim _ _
      rwa [QuotientGroup.eq_one_iff] at hx
    have hperfQ : Group.IsPerfect (C ⧸ N) :=
      Group.IsPerfect.ofSurjective (f := QuotientGroup.mk' N) (QuotientGroup.mk'_surjective N)
    haveI : Group.IsNilpotent (C ⧸ N) := hN.isNilpotent
    exact Group.IsPerfect.not_isSolvable (C ⧸ N) inferInstance
  · show C ⊓ Subgroup.centralizer (pCoreOf 2 C : Set G) ≤ pCoreOf 2 C
    rw [h.pCore_eq]
    rintro g ⟨hgC, hgc⟩
    obtain ⟨a, ha, M, hg⟩ := h.C_decomp g hgC
    have hsc : ∀ z ∈ A, s M * z * (s M)⁻¹ = z := by
      intro z hz
      have h1 : (a * s M) * z = z * (a * s M) := by
        rw [← hg]
        exact (Subgroup.mem_centralizer_iff.mp hgc z hz).symm
      have h2 : a * z = z * a := h.A_comm a ha z hz
      have h3 : s M * z = z * s M := by
        apply mul_left_cancel (a := a)
        calc a * (s M * z) = a * s M * z := (mul_assoc _ _ _).symm
          _ = z * (a * s M) := h1
          _ = z * a * s M := (mul_assoc _ _ _).symm
          _ = a * z * s M := by rw [← h2]
          _ = a * (z * s M) := mul_assoc _ _ _
      rw [h3, mul_inv_cancel_right]
    have hM : M = 1 := by
      refine eq_one_of_fixed fun v => ?_
      obtain ⟨z, hz, rfl⟩ := h.vec_surj v
      rw [← h.vec_conj M z hz, hsc z hz]
    rw [hg, hM, map_one, mul_one]
    exact ha
  · have hQ' : blockQ C = A := h.pCore_eq
    rw [h.blockU_eq, hQ']
    refine ⟨le_inf le_rfl ?_, fun x hx => h.A_sq x hx⟩
    intro x hx
    exact Subgroup.mem_centralizer_iff.mpr fun y hy => (h.A_comm x hx y hy).symm
  · have e1 : (C ⧸ CFSG.pCore 2 C) ≃* (C ⧸ A.subgroupOf C) :=
      QuotientGroup.quotientMulEquivOfEq h.pCore_subgroupOf
    exact CFSG.IsQuasisimple.of_mulEquiv (e1.trans h.quotEquiv.symm)
      (CFSG.GH74.GLS.IVK.Lifted.isQuasisimple_sl2' h4)
  · refine ⟨?_, ?_⟩
    · rw [h.blockZ_eq, h.blockU_eq]
      exact bot_lt_iff_ne_bot.mpr h.A_ne_bot
    · intro W _ hWU hWn
      rw [h.blockU_eq] at hWU
      by_cases hW : W = ⊥
      · exact Or.inl (by rw [h.blockZ_eq]; exact hW)
      · rw [h.blockU_eq]
        exact Or.inr (h.eq_A_of_normal hWU hWn hW)

theorem LinVertex.isLin2Type [Finite G] (h : LinVertex C A s vec) [Fintype K] {n : ℕ}
    (hcard : Fintype.card K = 2 ^ n) : IsLin2Type C n := by
  classical
  haveI := h.normal_subgroupOf
  have hU := h.blockU_eq
  have hZ := h.blockZ_eq
  have hker : (blockZ C).subgroupOf (blockU C) = ⊥ := by
    rw [hZ]
    exact Subgroup.bot_subgroupOf _
  let β : ↥(blockU C) →* Multiplicative (Fin 2 → K) :=
    { toFun := fun u => Multiplicative.ofAdd (vec (u : G))
      map_one' := by
        show Multiplicative.ofAdd (vec ((1 : ↥(blockU C)) : G)) = 1
        rw [show ((1 : ↥(blockU C)) : G) = 1 from rfl, h.vec_one]
        rfl
      map_mul' := fun u v => by
        show Multiplicative.ofAdd (vec ((u * v : ↥(blockU C)) : G)) =
          Multiplicative.ofAdd (vec (u : G)) * Multiplicative.ofAdd (vec (v : G))
        rw [show ((u * v : ↥(blockU C)) : G) = (u : G) * (v : G) from rfl,
          h.vec_add _ (hU ▸ u.2) _ (hU ▸ v.2)]
        rfl }
  refine ⟨K, inferInstance, inferInstance, hcard, h.proj, h.proj_surjective, ?_, β, ?_, ?_, ?_⟩
  · rw [h.proj_ker, h.pCore_subgroupOf]
  · intro w
    obtain ⟨z, hz, hzv⟩ := h.vec_surj (Multiplicative.toAdd w)
    refine ⟨⟨z, hU ▸ hz⟩, ?_⟩
    show Multiplicative.ofAdd (vec z) = w
    rw [hzv, ofAdd_toAdd]
  · ext u
    rw [MonoidHom.mem_ker, hker, Subgroup.mem_bot]
    exact ⟨fun hu => Subtype.ext
      ((h.vec_ker (u : G) (hU ▸ u.2)).mp (Multiplicative.ofAdd.injective hu)),
      fun hu => by rw [hu, map_one]⟩
  · intro l u v huv
    obtain ⟨a, ha, M, hg⟩ := h.C_decomp (l : G) l.2
    have ha1 : h.proj ⟨a, h.A_le_C ha⟩ = 1 := by
      rw [← MonoidHom.mem_ker, h.proj_ker]
      exact Subgroup.mem_subgroupOf.mpr ha
    have hl : h.proj l = M := by
      have h1 : l = ⟨a, h.A_le_C ha⟩ * ⟨s M, h.s_mem_C M⟩ := by
        apply Subtype.ext
        show (l : G) = a * s M
        exact hg
      rw [h1, map_mul, ha1, one_mul, h.proj_apply_s]
    have hv : (v : G) = s M * (u : G) * (s M)⁻¹ := by
      have hconj : (v : G) = (a * s M) * (u : G) * (a * s M)⁻¹ := by
        rw [← hg]
        exact huv
      rw [hconj]
      have humem : s M * (u : G) * (s M)⁻¹ ∈ A :=
        h.A_normal_C (s M) (h.s_mem_C M) (u : G) (hU ▸ u.2)
      rw [show (a * s M) * (u : G) * (a * s M)⁻¹ =
        a * (s M * (u : G) * (s M)⁻¹) * a⁻¹ by group, h.A_comm a ha _ humem]
      group
    show Multiplicative.toAdd (β v) = (h.proj l : Matrix (Fin 2) (Fin 2) K) *ᵥ
      Multiplicative.toAdd (β u)
    rw [hl]
    show vec (v : G) = (M : Matrix (Fin 2) (Fin 2) K) *ᵥ vec (u : G)
    rw [hv, h.vec_conj M (u : G) (hU ▸ u.2)]

end Abstract

namespace PointVertex

open CFSG.QuasithinUnique.Fin257.L3 CFSG.LocalAnalysis.ComponentInitial.LinearFlag
  CFSG.LocalAnalysis.ComponentInitial.LinearFieldFour CFSG.Quasithin.H13.F431.L3.P3
  CFSG.GH74.QTGen4.DSGen4.L34 CFSG.QuasithinUnique.Setup.X7a
  CFSG.LocalAnalysis.ComponentInitial.LinearCover

variable {F : Type} [Field F] [CharP F 2]

private def blockV1 (B : Matrix.SpecialLinearGroup (Fin 2) F) :
    Matrix.SpecialLinearGroup (Fin 3) F :=
  ⟨!![1, 0, 0; 0, (B : Matrix (Fin 2) (Fin 2) F) 1 1, (B : Matrix (Fin 2) (Fin 2) F) 1 0;
    0, (B : Matrix (Fin 2) (Fin 2) F) 0 1, (B : Matrix (Fin 2) (Fin 2) F) 0 0], by
    rw [Matrix.det_fin_three]
    simp only [Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val,
      Matrix.head_cons, Matrix.tail_cons, Matrix.zero_apply, mul_zero, sub_zero, mul_one,
      zero_mul, sub_self, add_zero, one_mul]
    have hB := B.2
    rw [Matrix.det_fin_two] at hB
    linear_combination hB⟩

private def levV1Hom : Matrix.SpecialLinearGroup (Fin 2) F →* Matrix.SpecialLinearGroup (Fin 3) F
    where
  toFun := blockV1
  map_one' := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [blockV1]
  map_mul' B C := by
    apply Subtype.ext
    show ((blockV1 (B * C) : Matrix.SpecialLinearGroup (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) =
      ((blockV1 B : Matrix.SpecialLinearGroup (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) *
        ((blockV1 C : Matrix.SpecialLinearGroup (Fin 3) F) : Matrix (Fin 3) (Fin 3) F)
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [blockV1, Matrix.mul_apply, Fin.sum_univ_three] <;> ring

private noncomputable def levV1 : Matrix.SpecialLinearGroup (Fin 2) F →* projectiveSL 3 F :=
  (proj 3 F).comp levV1Hom

private theorem levV1_apply (B : Matrix.SpecialLinearGroup (Fin 2) F) :
    levV1 B = proj 3 F (blockV1 B) := rfl

private noncomputable def vecV1 (g : projectiveSL 3 F) : Fin 2 → F := by
  classical
  exact if h : g ∈ (V1 : Subgroup (projectiveSL 3 F)) then
    ![Classical.choose h, Classical.choose (Classical.choose_spec h)]
  else 0

private theorem vecV1_of_mem {g : projectiveSL 3 F} (h : g ∈ (V1 : Subgroup (projectiveSL 3 F))) :
    g = xP (vecV1 g 0) * wP (vecV1 g 1) := by
  rw [vecV1, dif_pos h]
  simpa using Classical.choose_spec (Classical.choose_spec h)

private theorem vecV1_xP_wP (a c : F) : vecV1 (xP a * wP c) = ![a, c] := by
  have hmem : xP a * wP c ∈ (V1 : Subgroup (projectiveSL 3 F)) := mem_V1.mpr ⟨a, c, rfl⟩
  have h := vecV1_of_mem hmem
  obtain ⟨ha, hc⟩ := xP_mul_wP_inj h.symm
  funext i
  fin_cases i
  · simpa using ha
  · simpa using hc

private theorem vecV1_one : vecV1 (1 : projectiveSL 3 F) = 0 := by
  rw [show (1 : projectiveSL 3 F) = xP 0 * wP 0 from by rw [xP_zero, wP_zero, mul_one],
    vecV1_xP_wP]
  funext i
  fin_cases i <;> simp

private theorem vecV1_add {z w : projectiveSL 3 F} (hz : z ∈ (V1 : Subgroup (projectiveSL 3 F)))
    (hw : w ∈ (V1 : Subgroup (projectiveSL 3 F))) : vecV1 (z * w) = vecV1 z + vecV1 w := by
  obtain ⟨a, c, rfl⟩ := mem_V1.mp hz
  obtain ⟨a', c', rfl⟩ := mem_V1.mp hw
  rw [V1_mul, vecV1_xP_wP, vecV1_xP_wP, vecV1_xP_wP]
  funext i
  fin_cases i <;> simp

private theorem vecV1_ker {z : projectiveSL 3 F} (hz : z ∈ (V1 : Subgroup (projectiveSL 3 F))) :
    vecV1 z = 0 ↔ z = 1 := by
  obtain ⟨a, c, rfl⟩ := mem_V1.mp hz
  rw [vecV1_xP_wP]
  constructor
  · intro h
    have h1 := congrFun h 0
    have h2 := congrFun h 1
    simp only [Pi.zero_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons] at h1 h2
    rw [h2, h1, xP_zero, wP_zero, mul_one]
  · intro h
    have h2 : vecV1 (xP a * wP c) = vecV1 (1 : projectiveSL 3 F) := by rw [h]
    rw [vecV1_xP_wP, vecV1_one] at h2
    exact h2

private theorem vecV1_surj (v : Fin 2 → F) :
    ∃ z ∈ (V1 : Subgroup (projectiveSL 3 F)), vecV1 z = v := by
  refine ⟨xP (v 0) * wP (v 1), mem_V1.mpr ⟨v 0, v 1, rfl⟩, ?_⟩
  rw [vecV1_xP_wP]
  funext i
  fin_cases i <;> simp

private theorem conj_levV1_xP_wP (B : Matrix.SpecialLinearGroup (Fin 2) F) (a c : F) :
    levV1 B * (xP a * wP c) * (levV1 B)⁻¹ =
      xP ((B : Matrix (Fin 2) (Fin 2) F) 0 0 * a + (B : Matrix (Fin 2) (Fin 2) F) 0 1 * c) *
        wP ((B : Matrix (Fin 2) (Fin 2) F) 1 0 * a + (B : Matrix (Fin 2) (Fin 2) F) 1 1 * c) := by
  have hM : blockV1 B ∈ Q3 F 0 := by
    rw [mem_Q3_zero_iff]
    simp [blockV1]
  have hx := conj_xP_Q3 hM a
  have hw := conj_wP_Q3 hM c
  have hx' : proj 3 F (blockV1 B) * xP a * (proj 3 F (blockV1 B))⁻¹ =
      xP ((B : Matrix (Fin 2) (Fin 2) F) 0 0 * a) *
        wP ((B : Matrix (Fin 2) (Fin 2) F) 1 0 * a) := by
    simpa [blockV1] using hx
  have hw' : proj 3 F (blockV1 B) * wP c * (proj 3 F (blockV1 B))⁻¹ =
      xP ((B : Matrix (Fin 2) (Fin 2) F) 0 1 * c) *
        wP ((B : Matrix (Fin 2) (Fin 2) F) 1 1 * c) := by
    simpa [blockV1] using hw
  rw [levV1_apply]
  rw [show proj 3 F (blockV1 B) * (xP a * wP c) * (proj 3 F (blockV1 B))⁻¹ =
      (proj 3 F (blockV1 B) * xP a * (proj 3 F (blockV1 B))⁻¹) *
        (proj 3 F (blockV1 B) * wP c * (proj 3 F (blockV1 B))⁻¹) by group]
  rw [hx', hw', V1_mul]

private theorem vecV1_conj (B : Matrix.SpecialLinearGroup (Fin 2) F) {z : projectiveSL 3 F}
    (hz : z ∈ (V1 : Subgroup (projectiveSL 3 F))) :
    vecV1 (levV1 B * z * (levV1 B)⁻¹) =
      (B : Matrix (Fin 2) (Fin 2) F) *ᵥ vecV1 z := by
  obtain ⟨a, c, rfl⟩ := mem_V1.mp hz
  rw [conj_levV1_xP_wP, vecV1_xP_wP, vecV1_xP_wP]
  funext i
  fin_cases i <;> simp [Matrix.mulVec, dotProduct, Fin.sum_univ_two]

private theorem conj_mem_V1_levV1 (B : Matrix.SpecialLinearGroup (Fin 2) F) {v : projectiveSL 3 F}
    (hv : v ∈ (V1 : Subgroup (projectiveSL 3 F))) :
    levV1 B * v * (levV1 B)⁻¹ ∈ (V1 : Subgroup (projectiveSL 3 F)) := by
  rw [vecV1_of_mem hv, conj_levV1_xP_wP]
  exact mem_V1.mpr ⟨_, _, rfl⟩

private theorem mem_normalizer_V1_levV1 (B : Matrix.SpecialLinearGroup (Fin 2) F) :
    levV1 B ∈ Subgroup.normalizer ((V1 : Subgroup (projectiveSL 3 F)) :
      Set (projectiveSL 3 F)) := by
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · exact conj_mem_V1_levV1 B
  · intro hx
    have h1 := conj_mem_V1_levV1 B⁻¹ hx
    have h2 : levV1 B⁻¹ * (levV1 B * x * (levV1 B)⁻¹) * (levV1 B⁻¹)⁻¹ = x := by
      have hinv : (levV1 B⁻¹)⁻¹ = levV1 B := by rw [← map_inv, inv_inv]
      have hinv2 : levV1 B⁻¹ = (levV1 B)⁻¹ := map_inv levV1 B
      rw [hinv, hinv2]
      group
    rwa [h2] at h1

private theorem range_le_normalizer_V1 :
    (levV1.range : Subgroup (projectiveSL 3 F)) ≤
      Subgroup.normalizer ((V1 : Subgroup (projectiveSL 3 F)) : Set (projectiveSL 3 F)) := by
  rintro _ ⟨B, rfl⟩
  exact mem_normalizer_V1_levV1 B

private theorem le_normalizer_V1_sup :
    (V1 ⊔ levV1.range : Subgroup (projectiveSL 3 F)) ≤
      Subgroup.normalizer ((V1 : Subgroup (projectiveSL 3 F)) : Set (projectiveSL 3 F)) :=
  sup_le Subgroup.le_normalizer range_le_normalizer_V1

private theorem blockV1_eq_one_of_mem_V1 (M : Matrix.SpecialLinearGroup (Fin 2) F)
    (h : proj 3 F (blockV1 M) ∈ (V1 : Subgroup (projectiveSL 3 F))) : M = 1 := by
  obtain ⟨a, c, hV⟩ := mem_V1.mp h
  have hV' : proj 3 F (blockV1 M) = proj 3 F (xMat a * wMat c) := by
    rw [hV, map_mul]
    rfl
  have hsc : (xMat a * wMat c)⁻¹ * blockV1 M ∈ scalars 3 F := by
    rw [← proj_eq_proj_iff]
    exact hV'.symm
  obtain ⟨d, hd3, hd⟩ := mem_scalars.mp hsc
  let s : Matrix.SpecialLinearGroup (Fin 3) F := scalarElement d hd3
  have hds : (s : Matrix (Fin 3) (Fin 3) F) = Matrix.scalar (Fin 3) (d : F) :=
    coe_scalarElement d hd3
  have h2 : (xMat a * wMat c)⁻¹ * blockV1 M = s := by
    apply Subtype.ext
    rw [hds]
    exact hd
  have h3 : blockV1 M = (xMat a * wMat c) * s := by
    rw [← h2]
    group
  have hd1 : (d : F) = 1 := by
    have h4 := congrArg (fun X : Matrix.SpecialLinearGroup (Fin 3) F =>
      (X : Matrix (Fin 3) (Fin 3) F)) h3
    have h6 : (((xMat a * wMat c) * s : Matrix.SpecialLinearGroup (Fin 3) F) :
        Matrix (Fin 3) (Fin 3) F) =
          ((xMat a * wMat c : Matrix.SpecialLinearGroup (Fin 3) F) :
            Matrix (Fin 3) (Fin 3) F) * Matrix.scalar (Fin 3) (d : F) := by
      rw [Matrix.SpecialLinearGroup.coe_mul, hds]
    rw [h6, coe_xMat_mul_wMat] at h4
    have h5 := congrFun (congrFun h4 0) 0
    simpa [blockV1, Matrix.mul_apply, Fin.sum_univ_three, Matrix.scalar_apply] using h5.symm
  have hs1 : s = 1 := by
    apply Subtype.ext
    rw [hds, hd1]
    simp
  have hmat : blockV1 M = xMat a * wMat c := by
    rw [h3, hs1, mul_one]
  have h' := congrArg (fun X : Matrix.SpecialLinearGroup (Fin 3) F =>
    (X : Matrix (Fin 3) (Fin 3) F)) hmat
  rw [coe_xMat_mul_wMat] at h'
  have e11 : (M : Matrix (Fin 2) (Fin 2) F) 1 1 = 1 := by
    have h2 := congrFun (congrFun h' 1) 1
    simpa [blockV1] using h2
  have e10 : (M : Matrix (Fin 2) (Fin 2) F) 1 0 = 0 := by
    have h2 := congrFun (congrFun h' 1) 2
    simpa [blockV1] using h2
  have e01 : (M : Matrix (Fin 2) (Fin 2) F) 0 1 = 0 := by
    have h2 := congrFun (congrFun h' 2) 1
    simpa [blockV1] using h2
  have e00 : (M : Matrix (Fin 2) (Fin 2) F) 0 0 = 1 := by
    have h2 := congrFun (congrFun h' 2) 2
    simpa [blockV1] using h2
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [e00, e01, e10, e11]

private theorem levV1_injective : Function.Injective (levV1 (F := F)) := by
  intro B B' h
  rw [levV1_apply, levV1_apply] at h
  have hBm : blockV1 (B * B'⁻¹) = blockV1 B * (blockV1 B')⁻¹ := by
    show levV1Hom (B * B'⁻¹) = levV1Hom B * (levV1Hom B')⁻¹
    rw [map_mul, map_inv]
  have h1 : proj 3 F (blockV1 (B * B'⁻¹)) = 1 := by
    rw [hBm, map_mul, map_inv, h, mul_inv_cancel]
  have h2 : B * B'⁻¹ = 1 :=
    blockV1_eq_one_of_mem_V1 _ (by rw [h1]; exact (V1 : Subgroup _).one_mem)
  exact mul_inv_eq_one.mp h2

private theorem V1_inf_range :
    ((V1 : Subgroup (projectiveSL 3 F)) ⊓ (levV1 (F := F)).range) = ⊥ := by
  refine le_antisymm ?_ bot_le
  rintro g ⟨hgV, hgR⟩
  obtain ⟨M, rfl⟩ := MonoidHom.mem_range.mp hgR
  rw [Subgroup.mem_bot]
  rw [levV1_apply] at hgV
  have hM : M = 1 := blockV1_eq_one_of_mem_V1 M hgV
  rw [hM, map_one]

private theorem proj_mem_sup_of_mem_Q3 [Finite F] {M : Matrix.SpecialLinearGroup (Fin 3) F}
    (hM : M ∈ Q3 F 0) :
    proj 3 F M ∈
      (V1 ⊔ (levV1 (F := F)).range : Subgroup (projectiveSL 3 F)) ⊔ torus3 F := by
  obtain ⟨h10, h20⟩ := mem_Q3_zero_iff.mp hM
  set lam : F := (M : Matrix (Fin 3) (Fin 3) F) 0 0 with hlam
  set r1 : F := (M : Matrix (Fin 3) (Fin 3) F) 0 1 with hr1
  set r2 : F := (M : Matrix (Fin 3) (Fin 3) F) 0 2 with hr2
  set b : F := (M : Matrix (Fin 3) (Fin 3) F) 1 1 with hb
  set c : F := (M : Matrix (Fin 3) (Fin 3) F) 1 2 with hc
  set d : F := (M : Matrix (Fin 3) (Fin 3) F) 2 1 with hd
  set e : F := (M : Matrix (Fin 3) (Fin 3) F) 2 2 with he
  have hdet : lam * (b * e - c * d) = 1 := by
    simpa [hlam, hb, hc, hd, he] using det_V1 (F := F) h10 h20
  have hdet2 : lam * (b * e + c * d) = 1 := by
    have h2 : (2 : F) = 0 := CharTwo.two_eq_zero
    linear_combination hdet + (lam * c * d) * h2
  have hlam0 : lam ≠ 0 := left_ne_zero_of_mul_eq_one hdet
  obtain ⟨mu, hmu⟩ := (FiniteField.isSquare_of_char_two (ringChar.eq F 2) lam)
  have hmu0 : mu ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hmu
    exact hlam0 hmu
  let T : Matrix.SpecialLinearGroup (Fin 3) F :=
    ⟨!![lam, 0, 0; 0, mu⁻¹, 0; 0, 0, mu * lam⁻¹], by
      rw [Matrix.det_fin_three]
      simp only [Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val,
        Matrix.head_cons, Matrix.tail_cons, Matrix.zero_apply, mul_zero, sub_zero, mul_one,
        zero_mul, sub_self, add_zero, one_mul]
      field_simp⟩
  let B' : Matrix.SpecialLinearGroup (Fin 2) F :=
    ⟨!![mu * e, mu * d; mu * c, mu * b], by
      rw [Matrix.det_fin_two]
      simp only [Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Matrix.tail_cons]
      have h1 : mu * mu * (b * e - c * d) = 1 := by rw [← hmu]; exact hdet
      linear_combination h1⟩
  let L : Matrix.SpecialLinearGroup (Fin 3) F := blockV1 B'
  let u1 : F := lam * (r1 * e + r2 * d)
  let u2 : F := lam * (r1 * c + r2 * b)
  let U : Matrix.SpecialLinearGroup (Fin 3) F := xMat u1 * wMat u2
  have hLmat : (L : Matrix (Fin 3) (Fin 3) F) =
      !![1, 0, 0; 0, mu * b, mu * c; 0, mu * d, mu * e] := by
    show (blockV1 B' : Matrix (Fin 3) (Fin 3) F) = _
    simp [blockV1, B']
  have hTL : ((T : Matrix (Fin 3) (Fin 3) F) * (L : Matrix (Fin 3) (Fin 3) F)) =
      !![lam, 0, 0; 0, b, c; 0, d, e] := by
    rw [hLmat]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [T, Matrix.mul_apply, Fin.sum_univ_three] <;> field_simp <;> try rw [hmu] <;> ring
  have hUmat : (U : Matrix (Fin 3) (Fin 3) F) = !![1, u1, u2; 0, 1, 0; 0, 0, 1] := by
    show (↑(xMat u1 * wMat u2) : Matrix (Fin 3) (Fin 3) F) = _
    rw [coe_xMat_mul_wMat]
  have hmat : (M : Matrix (Fin 3) (Fin 3) F) =
      ((U : Matrix (Fin 3) (Fin 3) F) * (T : Matrix (Fin 3) (Fin 3) F)) *
        (L : Matrix (Fin 3) (Fin 3) F) := by
    rw [mul_assoc, hTL, hUmat]
    have hMmat : (M : Matrix (Fin 3) (Fin 3) F) = !![lam, r1, r2; 0, b, c; 0, d, e] := by
      ext i j
      fin_cases i <;> fin_cases j <;> simp [hlam, hr1, hr2, hb, hc, hd, he, h10, h20]
    rw [hMmat]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [u1, u2, Matrix.mul_apply, Fin.sum_univ_three]
    · have hdb : d * b + b * d = 0 := by
        rw [mul_comm d b]
        exact CharTwo.add_self_eq_zero _
      linear_combination -(r1 * hdet2 + (lam * r2) * hdb)
    · have hce : e * c + c * e = 0 := by
        rw [mul_comm e c]
        exact CharTwo.add_self_eq_zero _
      linear_combination -(r2 * hdet2 + (lam * r1) * hce)
  have hTmem : proj 3 F T ∈ torus3 F := by
    have hT : T = dMat (Units.mk0 lam hlam0) (Units.mk0 mu⁻¹ (inv_ne_zero hmu0)) := by
      apply Subtype.ext
      ext i j
      fin_cases i <;> fin_cases j <;> simp [T, dMat, Matrix.diagonal_apply]
    rw [hT]
    exact dP_mem_torus3 _ _
  have hUmem : proj 3 F U ∈ (V1 : Subgroup (projectiveSL 3 F)) := by
    have h1 : proj 3 F U = xP u1 * wP u2 := rfl
    rw [h1]
    exact mem_V1.mpr ⟨u1, u2, rfl⟩
  have hLmem : proj 3 F L ∈ (levV1 (F := F)).range :=
    MonoidHom.mem_range.mpr ⟨B', rfl⟩
  have hMdecomp : M = U * T * L := Subtype.ext hmat
  rw [hMdecomp, map_mul, map_mul]
  exact ((V1 ⊔ (levV1 (F := F)).range : Subgroup (projectiveSL 3 F)) ⊔ torus3 F).mul_mem
    (((V1 ⊔ (levV1 (F := F)).range : Subgroup (projectiveSL 3 F)) ⊔ torus3 F).mul_mem
      (Subgroup.mem_sup_left (Subgroup.mem_sup_left hUmem))
      (Subgroup.mem_sup_right hTmem))
    (Subgroup.mem_sup_left (Subgroup.mem_sup_right hLmem))

private theorem linVertex_V1 [Finite F] (h4 : 4 ≤ Nat.card F) :
    LinVertex (V1 ⊔ (levV1 (F := F)).range) V1 (levV1 (F := F)) (vecV1 (F := F)) where
  A_le_C := le_sup_left
  s_mem_C B := Subgroup.mem_sup_right (MonoidHom.mem_range.mpr ⟨B, rfl⟩)
  A_comm a ha b hb :=
    congrArg Subtype.val (isElemAbelian_V1.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  A_sq a ha := isElemAbelian_V1.2 a ha
  A_normal_C g hg a ha := (Subgroup.mem_normalizer_iff.mp (le_normalizer_V1_sup hg) a).mp ha
  C_decomp := by
    intro g hg
    have hcoe := Subgroup.coe_mul_of_right_le_normalizer_left (V1 (F := F) : Subgroup _)
      (levV1 (F := F)).range range_le_normalizer_V1
    have hg' : g ∈ (V1 (F := F) : Set (projectiveSL 3 F)) *
        ((levV1 (F := F)).range : Set (projectiveSL 3 F)) := by
      rwa [← hcoe]
    obtain ⟨a, ha, l, hl, rfl⟩ := hg'
    obtain ⟨B, rfl⟩ := MonoidHom.mem_range.mp hl
    exact ⟨a, ha, B, rfl⟩
  C_unique := by
    intro a ha a' ha' B B' heq
    have hB : B = B' := by
      have hmem : levV1 (B * B'⁻¹) ∈ (V1 : Subgroup (projectiveSL 3 F)) := by
        have h2 : levV1 B * (levV1 B')⁻¹ = a⁻¹ * a' := by
          calc levV1 B * (levV1 B')⁻¹ = a⁻¹ * (a * levV1 B) * (levV1 B')⁻¹ := by group
            _ = a⁻¹ * (a' * levV1 B') * (levV1 B')⁻¹ := by rw [heq]
            _ = a⁻¹ * a' := by group
        rw [show levV1 (B * B'⁻¹) = levV1 B * (levV1 B')⁻¹ from by rw [map_mul, map_inv], h2]
        exact (V1 : Subgroup (projectiveSL 3 F)).mul_mem ((V1 : Subgroup _).inv_mem ha) ha'
      have hboth : levV1 (B * B'⁻¹) ∈
          (V1 : Subgroup (projectiveSL 3 F)) ⊓ levV1.range :=
        ⟨hmem, MonoidHom.mem_range.mpr ⟨B * B'⁻¹, rfl⟩⟩
      rw [V1_inf_range] at hboth
      have h1 : levV1 (B * B'⁻¹) = 1 := Subgroup.mem_bot.mp hboth
      have h2 : B * B'⁻¹ = 1 := levV1_injective (by rw [h1, map_one])
      exact mul_inv_eq_one.mp h2
    refine ⟨?_, hB⟩
    rw [hB] at heq
    exact mul_right_cancel heq
  S_perfect := CFSG.ClassicalModels.specialLinear_isPerfect_two_of_four_le_card F h4
  S_pCore := CFSG.Quasithin.SimsG4.pCore_sl2_charTwo F
  vec_add z hz w hw := vecV1_add hz hw
  vec_surj := vecV1_surj
  vec_ker z hz := vecV1_ker hz
  vec_conj B z hz := vecV1_conj B hz

private def twistTorus (a : Fˣ) (B : Matrix.SpecialLinearGroup (Fin 2) F) :
    Matrix.SpecialLinearGroup (Fin 2) F :=
  ⟨!![(B : Matrix (Fin 2) (Fin 2) F) 0 0, ((a : F)⁻¹) * (B : Matrix (Fin 2) (Fin 2) F) 0 1;
    (a : F) * (B : Matrix (Fin 2) (Fin 2) F) 1 0, (B : Matrix (Fin 2) (Fin 2) F) 1 1], by
    rw [Matrix.det_fin_two]
    simp only [Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      Matrix.tail_cons]
    have h3 : (a : F)⁻¹ * (a : F) = 1 := by field_simp
    have h4 : (a : F)⁻¹ * (B : Matrix (Fin 2) (Fin 2) F) 0 1 *
        ((a : F) * (B : Matrix (Fin 2) (Fin 2) F) 1 0) =
          (B : Matrix (Fin 2) (Fin 2) F) 0 1 * (B : Matrix (Fin 2) (Fin 2) F) 1 0 := by
      calc (a : F)⁻¹ * (B : Matrix (Fin 2) (Fin 2) F) 0 1 *
          ((a : F) * (B : Matrix (Fin 2) (Fin 2) F) 1 0) =
            ((a : F)⁻¹ * (a : F)) * ((B : Matrix (Fin 2) (Fin 2) F) 0 1 *
              (B : Matrix (Fin 2) (Fin 2) F) 1 0) := by ring
        _ = (B : Matrix (Fin 2) (Fin 2) F) 0 1 *
              (B : Matrix (Fin 2) (Fin 2) F) 1 0 := by rw [h3, one_mul]
    rw [h4]
    have h2 := B.2
    rw [Matrix.det_fin_two] at h2
    exact h2⟩

private theorem conj_blockV1_dMat (t1 t2 : Fˣ) (B : Matrix.SpecialLinearGroup (Fin 2) F) :
    (dMat t1 t2 : Matrix.SpecialLinearGroup (Fin 3) F) * blockV1 B * (dMat t1 t2)⁻¹ =
      blockV1 (twistTorus (t1 * t2 * t2) B) := by
  have h1 : (dMat t1 t2 : Matrix.SpecialLinearGroup (Fin 3) F) * blockV1 B =
      blockV1 (twistTorus (t1 * t2 * t2) B) * dMat t1 t2 := by
    apply Subtype.ext
    show ((dMat t1 t2 : Matrix (Fin 3) (Fin 3) F) * (blockV1 B : Matrix (Fin 3) (Fin 3) F)) =
      ((blockV1 (twistTorus (t1 * t2 * t2) B) : Matrix (Fin 3) (Fin 3) F) *
        (dMat t1 t2 : Matrix (Fin 3) (Fin 3) F))
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [dMat, coe_dMat, blockV1, twistTorus, Matrix.mul_apply, Fin.sum_univ_three,
        Matrix.diagonal_apply] <;>
      field_simp
  rw [h1]
  group

private theorem conj_mem_range_torus {t : projectiveSL 3 F} (ht : t ∈ torus3 F)
    {x : projectiveSL 3 F} (hx : x ∈ (levV1 (F := F)).range) :
    t * x * t⁻¹ ∈ (levV1 (F := F)).range := by
  obtain ⟨t1, t2, rfl⟩ := mem_torus3.mp ht
  obtain ⟨B, rfl⟩ := MonoidHom.mem_range.mp hx
  refine MonoidHom.mem_range.mpr ⟨twistTorus (t1 * t2 * t2) B, ?_⟩
  change proj 3 F (blockV1 (twistTorus (t1 * t2 * t2) B)) =
    proj 3 F (dMat t1 t2) * proj 3 F (blockV1 B) * (proj 3 F (dMat t1 t2))⁻¹
  rw [← map_inv, ← map_mul, ← map_mul]
  exact (congrArg (proj 3 F) (conj_blockV1_dMat t1 t2 B)).symm

private theorem torus3_le_normalizer_V1 [Finite F] :
    torus3 F ≤ Subgroup.normalizer ((V1 : Subgroup (projectiveSL 3 F)) :
      Set (projectiveSL 3 F)) := by
  intro t ht
  rw [normalizer_V1_eq]
  obtain ⟨t1, t2, rfl⟩ := mem_torus3.mp ht
  refine ⟨dMat t1 t2, ?_, rfl⟩
  exact mem_Q3_zero_iff.mpr ⟨by simp [coe_dMat, Matrix.diagonal_apply],
    by simp [coe_dMat, Matrix.diagonal_apply]⟩

private theorem normalizer_V1_eq_sup [Finite F] :
    Subgroup.normalizer ((V1 : Subgroup (projectiveSL 3 F)) : Set (projectiveSL 3 F)) =
      (V1 ⊔ (levV1 (F := F)).range : Subgroup (projectiveSL 3 F)) ⊔ torus3 F := by
  refine le_antisymm ?_ ?_
  · rw [normalizer_V1_eq]
    rintro _ ⟨M, hM, rfl⟩
    exact proj_mem_sup_of_mem_Q3 hM
  · refine sup_le (sup_le Subgroup.le_normalizer range_le_normalizer_V1) torus3_le_normalizer_V1

private theorem isSolvable_torus3 [Finite F] : Group.IsSolvable (torus3 F) :=
  Group.isSolvable_of_surjective (f := (dHom F).rangeRestrict)
    (MonoidHom.rangeRestrict_surjective (dHom F))

private theorem normalizer_V1_le_normalizer_sup [Finite F] :
    Subgroup.normalizer ((V1 : Subgroup (projectiveSL 3 F)) : Set (projectiveSL 3 F)) ≤
      Subgroup.normalizer
        ((V1 ⊔ (levV1 (F := F)).range : Subgroup (projectiveSL 3 F)) :
          Set (projectiveSL 3 F)) := by
  rw [normalizer_V1_eq_sup]
  refine sup_le Subgroup.le_normalizer ?_
  have hcoe := Subgroup.coe_mul_of_right_le_normalizer_left (V1 (F := F) : Subgroup _)
    (levV1 (F := F)).range range_le_normalizer_V1
  intro t ht
  refine CFSG.QuasithinUnique.Fin257.L3.mem_normalizer_of_conj _ ?_ ?_
  · intro x hx
    have hx' : x ∈ (V1 (F := F) : Set (projectiveSL 3 F)) *
        ((levV1 (F := F)).range : Set (projectiveSL 3 F)) := by
      rwa [← hcoe]
    obtain ⟨a, ha, l, hl, rfl⟩ := hx'
    have h1 : t * (a * l) * t⁻¹ = (t * a * t⁻¹) * (t * l * t⁻¹) := by group
    rw [h1]
    have h2 : t * a * t⁻¹ ∈ V1 :=
      (Subgroup.mem_normalizer_iff.mp (torus3_le_normalizer_V1 ht) a).mp ha
    have h3 : t * l * t⁻¹ ∈ (levV1 (F := F)).range := conj_mem_range_torus ht hl
    exact (V1 ⊔ (levV1 (F := F)).range : Subgroup _).mul_mem
      (Subgroup.mem_sup_left h2) (Subgroup.mem_sup_right h3)
  · intro x hx
    have hx' : x ∈ (V1 (F := F) : Set (projectiveSL 3 F)) *
        ((levV1 (F := F)).range : Set (projectiveSL 3 F)) := by
      rwa [← hcoe]
    obtain ⟨a, ha, l, hl, rfl⟩ := hx'
    have ht' : t⁻¹ ∈ torus3 F := (torus3 F).inv_mem ht
    have h1 : t⁻¹ * (a * l) * t = (t⁻¹ * a * t) * (t⁻¹ * l * t) := by group
    rw [h1]
    have h2 : t⁻¹ * a * t ∈ V1 := by
      simpa using (Subgroup.mem_normalizer_iff.mp (torus3_le_normalizer_V1 ht') a).mp ha
    have h3 : t⁻¹ * l * t ∈ (levV1 (F := F)).range := by
      simpa using conj_mem_range_torus ht' hl
    exact (V1 ⊔ (levV1 (F := F)).range : Subgroup _).mul_mem
      (Subgroup.mem_sup_left h2) (Subgroup.mem_sup_right h3)

private theorem perfectCore_normalizer_V1 [Finite F] (h4 : 4 ≤ Nat.card F) :
    perfectCore (Subgroup.normalizer ((V1 : Subgroup (projectiveSL 3 F)) :
      Set (projectiveSL 3 F))) = (V1 ⊔ (levV1 (F := F)).range : Subgroup _) := by
  let N : Subgroup (projectiveSL 3 F) :=
    Subgroup.normalizer ((V1 : Subgroup (projectiveSL 3 F)) : Set (projectiveSL 3 F))
  let C : Subgroup (projectiveSL 3 F) := V1 ⊔ (levV1 (F := F)).range
  have hCY : C ≤ N := le_normalizer_V1_sup
  have hN : N = C ⊔ torus3 F := normalizer_V1_eq_sup (F := F)
  have hnormal : (C.subgroupOf N).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hCY).mpr
      (normalizer_V1_le_normalizer_sup (F := F))
  have hmain : perfectCore N ≤ C := by
    refine CFSG.Quasithin.perfectCore_le_of_sup_solvable (A := C) (B := torus3 F) (Y := N)
      hCY hnormal ?_ isSolvable_torus3
    exact hN
  refine le_antisymm hmain ?_
  refine CFSG.Quasithin.le_perfectCore_of_perfect hCY ?_
  exact (linVertex_V1 (F := F) h4).commutator_eq

theorem l3_vertex_V1 [Finite F] {n : ℕ} (hn : 2 ≤ n) (hF : Nat.card F = 2 ^ n) :
    IsShort2 (perfectCore (Subgroup.normalizer ((V1 : Subgroup (projectiveSL 3 F)) :
      Set (projectiveSL 3 F)))) ∧
    IsLin2Type (perfectCore (Subgroup.normalizer ((V1 : Subgroup (projectiveSL 3 F)) :
      Set (projectiveSL 3 F)))) n := by
  have h4 : 4 ≤ Nat.card F := by
    rw [hF]
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
  letI := Fintype.ofFinite F
  have hcard : Fintype.card F = 2 ^ n := by
    rw [Fintype.card_eq_nat_card]
    exact hF
  have hpc := perfectCore_normalizer_V1 (F := F) h4
  have hLV := linVertex_V1 (F := F) h4
  rw [hpc]
  exact ⟨hLV.isShort2 h4, hLV.isLin2Type hcard⟩

end PointVertex

namespace LineVertex

open CFSG.QuasithinUnique.Fin257.L3 CFSG.LocalAnalysis.ComponentInitial.LinearFlag
  CFSG.LocalAnalysis.ComponentInitial.LinearFieldFour CFSG.Quasithin.H13.F431.L3.P3
  CFSG.GH74.QTGen4.DSGen4.L34 CFSG.QuasithinUnique.Setup.X7a
  CFSG.LocalAnalysis.ComponentInitial.LinearCover

variable {F : Type} [Field F] [CharP F 2]

private def blockV2 (B : Matrix.SpecialLinearGroup (Fin 2) F) :
    Matrix.SpecialLinearGroup (Fin 3) F :=
  ⟨!![(B : Matrix (Fin 2) (Fin 2) F) 0 0, (B : Matrix (Fin 2) (Fin 2) F) 0 1, 0;
    (B : Matrix (Fin 2) (Fin 2) F) 1 0, (B : Matrix (Fin 2) (Fin 2) F) 1 1, 0;
    0, 0, 1], by
    rw [Matrix.det_fin_three]
    simp only [Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val,
      Matrix.head_cons, Matrix.tail_cons, Matrix.zero_apply, mul_zero, sub_zero, mul_one,
      zero_mul, sub_self, add_zero, one_mul]
    have hB := B.2
    rw [Matrix.det_fin_two] at hB
    linear_combination hB⟩

private def levV2Hom : Matrix.SpecialLinearGroup (Fin 2) F →* Matrix.SpecialLinearGroup (Fin 3) F
    where
  toFun := blockV2
  map_one' := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [blockV2]
  map_mul' B C := by
    apply Subtype.ext
    show ((blockV2 (B * C) : Matrix.SpecialLinearGroup (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) =
      ((blockV2 B : Matrix.SpecialLinearGroup (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) *
        ((blockV2 C : Matrix.SpecialLinearGroup (Fin 3) F) : Matrix (Fin 3) (Fin 3) F)
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [blockV2, Matrix.mul_apply, Fin.sum_univ_three] <;> ring

private noncomputable def levV2 : Matrix.SpecialLinearGroup (Fin 2) F →* projectiveSL 3 F :=
  (proj 3 F).comp levV2Hom

private theorem levV2_apply (B : Matrix.SpecialLinearGroup (Fin 2) F) :
    levV2 B = proj 3 F (blockV2 B) := rfl

private noncomputable def vecV2 (g : projectiveSL 3 F) : Fin 2 → F := by
  classical
  exact if h : g ∈ (V2 : Subgroup (projectiveSL 3 F)) then
    ![Classical.choose (Classical.choose_spec h), Classical.choose h]
  else 0

private theorem vecV2_of_mem {g : projectiveSL 3 F} (h : g ∈ (V2 : Subgroup (projectiveSL 3 F))) :
    g = yP (vecV2 g 1) * wP (vecV2 g 0) := by
  rw [vecV2, dif_pos h]
  simpa using Classical.choose_spec (Classical.choose_spec h)

private theorem vecV2_yP_wP (b c : F) : vecV2 (yP b * wP c) = ![c, b] := by
  have hmem : yP b * wP c ∈ (V2 : Subgroup (projectiveSL 3 F)) := mem_V2.mpr ⟨b, c, rfl⟩
  have h := vecV2_of_mem hmem
  obtain ⟨hb, hc⟩ := yP_mul_wP_inj h.symm
  funext i
  fin_cases i
  · simpa using hc
  · simpa using hb

private theorem vecV2_one : vecV2 (1 : projectiveSL 3 F) = 0 := by
  rw [show (1 : projectiveSL 3 F) = yP 0 * wP 0 from by rw [yP_zero, wP_zero, mul_one],
    vecV2_yP_wP]
  funext i
  fin_cases i <;> simp

private theorem vecV2_add {z w : projectiveSL 3 F} (hz : z ∈ (V2 : Subgroup (projectiveSL 3 F)))
    (hw : w ∈ (V2 : Subgroup (projectiveSL 3 F))) : vecV2 (z * w) = vecV2 z + vecV2 w := by
  obtain ⟨b, c, rfl⟩ := mem_V2.mp hz
  obtain ⟨b', c', rfl⟩ := mem_V2.mp hw
  rw [V2_mul, vecV2_yP_wP, vecV2_yP_wP, vecV2_yP_wP]
  funext i
  fin_cases i <;> simp

private theorem vecV2_ker {z : projectiveSL 3 F} (hz : z ∈ (V2 : Subgroup (projectiveSL 3 F))) :
    vecV2 z = 0 ↔ z = 1 := by
  obtain ⟨b, c, rfl⟩ := mem_V2.mp hz
  rw [vecV2_yP_wP]
  constructor
  · intro h
    have h1 := congrFun h 0
    have h2 := congrFun h 1
    simp only [Pi.zero_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons] at h1 h2
    rw [h1, h2, yP_zero, wP_zero, mul_one]
  · intro h
    have h2 : vecV2 (yP b * wP c) = vecV2 (1 : projectiveSL 3 F) := by rw [h]
    rw [vecV2_yP_wP, vecV2_one] at h2
    exact h2

private theorem vecV2_surj (v : Fin 2 → F) :
    ∃ z ∈ (V2 : Subgroup (projectiveSL 3 F)), vecV2 z = v := by
  refine ⟨yP (v 1) * wP (v 0), mem_V2.mpr ⟨v 1, v 0, rfl⟩, ?_⟩
  rw [vecV2_yP_wP]
  funext i
  fin_cases i <;> simp

private theorem conj_levV2_yP_wP (B : Matrix.SpecialLinearGroup (Fin 2) F) (b c : F) :
    levV2 B * (yP b * wP c) * (levV2 B)⁻¹ =
      yP ((B : Matrix (Fin 2) (Fin 2) F) 1 1 * b + (B : Matrix (Fin 2) (Fin 2) F) 1 0 * c) *
        wP ((B : Matrix (Fin 2) (Fin 2) F) 0 1 * b + (B : Matrix (Fin 2) (Fin 2) F) 0 0 * c) := by
  have hM : blockV2 B ∈ Q3 F 1 := by
    rw [mem_Q3_one_iff]
    simp [blockV2]
  have hy := conj_yP_Q3 hM b
  have hw := conj_wP_Q3' hM c
  have hy' : proj 3 F (blockV2 B) * yP b * (proj 3 F (blockV2 B))⁻¹ =
      yP ((B : Matrix (Fin 2) (Fin 2) F) 1 1 * b) *
        wP ((B : Matrix (Fin 2) (Fin 2) F) 0 1 * b) := by
    have h1 : ((B : Matrix (Fin 2) (Fin 2) F) 0 0 * (B : Matrix (Fin 2) (Fin 2) F) 1 1 -
        (B : Matrix (Fin 2) (Fin 2) F) 0 1 * (B : Matrix (Fin 2) (Fin 2) F) 1 0) = 1 := by
      have := B.2
      rwa [Matrix.det_fin_two] at this
    simpa [blockV2, h1] using hy
  have hw' : proj 3 F (blockV2 B) * wP c * (proj 3 F (blockV2 B))⁻¹ =
      yP ((B : Matrix (Fin 2) (Fin 2) F) 1 0 * c) *
        wP ((B : Matrix (Fin 2) (Fin 2) F) 0 0 * c) := by
    have h1 : ((B : Matrix (Fin 2) (Fin 2) F) 0 0 * (B : Matrix (Fin 2) (Fin 2) F) 1 1 -
        (B : Matrix (Fin 2) (Fin 2) F) 0 1 * (B : Matrix (Fin 2) (Fin 2) F) 1 0) = 1 := by
      have := B.2
      rwa [Matrix.det_fin_two] at this
    simpa [blockV2, h1] using hw
  rw [levV2_apply]
  rw [show proj 3 F (blockV2 B) * (yP b * wP c) * (proj 3 F (blockV2 B))⁻¹ =
      (proj 3 F (blockV2 B) * yP b * (proj 3 F (blockV2 B))⁻¹) *
        (proj 3 F (blockV2 B) * wP c * (proj 3 F (blockV2 B))⁻¹) by group]
  rw [hy', hw', V2_mul]

private theorem vecV2_conj (B : Matrix.SpecialLinearGroup (Fin 2) F) {z : projectiveSL 3 F}
    (hz : z ∈ (V2 : Subgroup (projectiveSL 3 F))) :
    vecV2 (levV2 B * z * (levV2 B)⁻¹) =
      (B : Matrix (Fin 2) (Fin 2) F) *ᵥ vecV2 z := by
  obtain ⟨b, c, rfl⟩ := mem_V2.mp hz
  rw [conj_levV2_yP_wP, vecV2_yP_wP, vecV2_yP_wP]
  funext i
  fin_cases i <;> simp [Matrix.mulVec, dotProduct, Fin.sum_univ_two] <;> ring

private theorem conj_mem_V2_levV2 (B : Matrix.SpecialLinearGroup (Fin 2) F) {v : projectiveSL 3 F}
    (hv : v ∈ (V2 : Subgroup (projectiveSL 3 F))) :
    levV2 B * v * (levV2 B)⁻¹ ∈ (V2 : Subgroup (projectiveSL 3 F)) := by
  rw [vecV2_of_mem hv, conj_levV2_yP_wP]
  exact mem_V2.mpr ⟨_, _, rfl⟩

private theorem mem_normalizer_V2_levV2 (B : Matrix.SpecialLinearGroup (Fin 2) F) :
    levV2 B ∈ Subgroup.normalizer ((V2 : Subgroup (projectiveSL 3 F)) :
      Set (projectiveSL 3 F)) := by
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · exact conj_mem_V2_levV2 B
  · intro hx
    have h1 := conj_mem_V2_levV2 B⁻¹ hx
    have hinv : (levV2 B⁻¹)⁻¹ = levV2 B := by rw [← map_inv, inv_inv]
    have hinv2 : levV2 B⁻¹ = (levV2 B)⁻¹ := map_inv levV2 B
    rw [hinv, hinv2] at h1
    have h2 : (levV2 B)⁻¹ * (levV2 B * x * (levV2 B)⁻¹) * levV2 B = x := by group
    rwa [h2] at h1

private theorem range_le_normalizer_V2 :
    (levV2.range : Subgroup (projectiveSL 3 F)) ≤
      Subgroup.normalizer ((V2 : Subgroup (projectiveSL 3 F)) : Set (projectiveSL 3 F)) := by
  rintro _ ⟨B, rfl⟩
  exact mem_normalizer_V2_levV2 B

private theorem le_normalizer_V2_sup :
    (V2 ⊔ levV2.range : Subgroup (projectiveSL 3 F)) ≤
      Subgroup.normalizer ((V2 : Subgroup (projectiveSL 3 F)) : Set (projectiveSL 3 F)) :=
  sup_le Subgroup.le_normalizer range_le_normalizer_V2

private theorem blockV2_eq_one_of_mem_V2 (M : Matrix.SpecialLinearGroup (Fin 2) F)
    (h : proj 3 F (blockV2 M) ∈ (V2 : Subgroup (projectiveSL 3 F))) : M = 1 := by
  obtain ⟨b, c, hV⟩ := mem_V2.mp h
  have hV' : proj 3 F (blockV2 M) = proj 3 F (yMat b * wMat c) := by
    rw [hV, map_mul]
    rfl
  have hsc : (yMat b * wMat c)⁻¹ * blockV2 M ∈ scalars 3 F := by
    rw [← proj_eq_proj_iff]
    exact hV'.symm
  obtain ⟨d, hd3, hd⟩ := mem_scalars.mp hsc
  let s : Matrix.SpecialLinearGroup (Fin 3) F := scalarElement d hd3
  have hds : (s : Matrix (Fin 3) (Fin 3) F) = Matrix.scalar (Fin 3) (d : F) :=
    coe_scalarElement d hd3
  have h2 : (yMat b * wMat c)⁻¹ * blockV2 M = s := by
    apply Subtype.ext
    rw [hds]
    exact hd
  have h3 : blockV2 M = (yMat b * wMat c) * s := by
    rw [← h2]
    group
  have hd1 : (d : F) = 1 := by
    have h4 := congrArg (fun X : Matrix.SpecialLinearGroup (Fin 3) F =>
      (X : Matrix (Fin 3) (Fin 3) F)) h3
    have h6 : (((yMat b * wMat c) * s : Matrix.SpecialLinearGroup (Fin 3) F) :
        Matrix (Fin 3) (Fin 3) F) =
          ((yMat b * wMat c : Matrix.SpecialLinearGroup (Fin 3) F) :
            Matrix (Fin 3) (Fin 3) F) * Matrix.scalar (Fin 3) (d : F) := by
      rw [Matrix.SpecialLinearGroup.coe_mul, hds]
    rw [h6, coe_yMat_mul_wMat] at h4
    have h5 := congrFun (congrFun h4 2) 2
    simpa [blockV2, Matrix.mul_apply, Fin.sum_univ_three, Matrix.scalar_apply] using h5.symm
  have hs1 : s = 1 := by
    apply Subtype.ext
    rw [hds, hd1]
    simp
  have hmat : blockV2 M = yMat b * wMat c := by
    rw [h3, hs1, mul_one]
  have h' := congrArg (fun X : Matrix.SpecialLinearGroup (Fin 3) F =>
    (X : Matrix (Fin 3) (Fin 3) F)) hmat
  rw [coe_yMat_mul_wMat] at h'
  have e00 : (M : Matrix (Fin 2) (Fin 2) F) 0 0 = 1 := by
    have h2 := congrFun (congrFun h' 0) 0
    simpa [blockV2] using h2
  have e01 : (M : Matrix (Fin 2) (Fin 2) F) 0 1 = 0 := by
    have h2 := congrFun (congrFun h' 0) 1
    simpa [blockV2] using h2
  have e10 : (M : Matrix (Fin 2) (Fin 2) F) 1 0 = 0 := by
    have h2 := congrFun (congrFun h' 1) 0
    simpa [blockV2] using h2
  have e11 : (M : Matrix (Fin 2) (Fin 2) F) 1 1 = 1 := by
    have h2 := congrFun (congrFun h' 1) 1
    simpa [blockV2] using h2
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [e00, e01, e10, e11]

private theorem levV2_injective : Function.Injective (levV2 (F := F)) := by
  intro B B' h
  rw [levV2_apply, levV2_apply] at h
  have hBm : blockV2 (B * B'⁻¹) = blockV2 B * (blockV2 B')⁻¹ := by
    show levV2Hom (B * B'⁻¹) = levV2Hom B * (levV2Hom B')⁻¹
    rw [map_mul, map_inv]
  have h1 : proj 3 F (blockV2 (B * B'⁻¹)) = 1 := by
    rw [hBm, map_mul, map_inv, h, mul_inv_cancel]
  have h2 : B * B'⁻¹ = 1 :=
    blockV2_eq_one_of_mem_V2 _ (by rw [h1]; exact (V2 : Subgroup _).one_mem)
  exact mul_inv_eq_one.mp h2

private theorem V2_inf_range :
    ((V2 : Subgroup (projectiveSL 3 F)) ⊓ levV2.range) = ⊥ := by
  refine le_antisymm ?_ bot_le
  rintro g ⟨hgV, hgR⟩
  obtain ⟨M, rfl⟩ := MonoidHom.mem_range.mp hgR
  rw [Subgroup.mem_bot]
  rw [levV2_apply] at hgV
  have hM : M = 1 := blockV2_eq_one_of_mem_V2 M hgV
  rw [hM, map_one]

private theorem proj_mem_sup_of_mem_Q3_one [Finite F] {M : Matrix.SpecialLinearGroup (Fin 3) F}
    (hM : M ∈ Q3 F 1) :
    proj 3 F M ∈
      (V2 ⊔ (levV2 (F := F)).range : Subgroup (projectiveSL 3 F)) ⊔ torus3 F := by
  obtain ⟨h20, h21⟩ := mem_Q3_one_iff.mp hM
  set lam : F := (M : Matrix (Fin 3) (Fin 3) F) 2 2 with hlam
  set a : F := (M : Matrix (Fin 3) (Fin 3) F) 0 0 with ha
  set b : F := (M : Matrix (Fin 3) (Fin 3) F) 0 1 with hb
  set c : F := (M : Matrix (Fin 3) (Fin 3) F) 1 0 with hc
  set d : F := (M : Matrix (Fin 3) (Fin 3) F) 1 1 with hd
  set e : F := (M : Matrix (Fin 3) (Fin 3) F) 0 2 with he
  set f : F := (M : Matrix (Fin 3) (Fin 3) F) 1 2 with hf
  have hdet : lam * (a * d - b * c) = 1 := by
    simpa [hlam, ha, hb, hc, hd] using det_V2 (F := F) h20 h21
  have hlam0 : lam ≠ 0 := left_ne_zero_of_mul_eq_one hdet
  have hdetA : a * d - b * c ≠ 0 := right_ne_zero_of_mul_eq_one hdet
  obtain ⟨nu, hnu⟩ := FiniteField.isSquare_of_char_two (ringChar.eq F 2) (a * d - b * c)
  have hnu0 : nu ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hnu
    exact hdetA hnu
  have h1 : nu ^ 2 * lam = 1 := by
    rw [sq, ← hnu, mul_comm]
    exact hdet
  let C : Matrix.SpecialLinearGroup (Fin 2) F :=
    ⟨!![(nu * lam) * a, (nu * lam) * b; (nu * lam) * c, (nu * lam) * d], by
      rw [Matrix.det_fin_two]
      simp only [Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Matrix.tail_cons]
      have h2 : (nu * lam) * a * ((nu * lam) * d) - (nu * lam) * b * ((nu * lam) * c) =
          (nu ^ 2 * lam) * (lam * (a * d - b * c)) := by ring
      rw [h2, h1, hdet, mul_one]⟩
  let T : Matrix.SpecialLinearGroup (Fin 3) F :=
    ⟨!![(nu * lam)⁻¹, 0, 0; 0, nu, 0; 0, 0, lam], by
      rw [Matrix.det_fin_three]
      simp only [Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val,
        Matrix.head_cons, Matrix.tail_cons, Matrix.zero_apply, mul_zero, sub_zero, mul_one,
        zero_mul, sub_self, add_zero, one_mul]
      field_simp⟩
  let L : Matrix.SpecialLinearGroup (Fin 3) F := blockV2 C
  let U : Matrix.SpecialLinearGroup (Fin 3) F := yMat (f * lam⁻¹) * wMat (e * lam⁻¹)
  have hMmat : (M : Matrix (Fin 3) (Fin 3) F) =
      !![a, b, e; c, d, f; 0, 0, lam] := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [hlam, ha, hb, hc, hd, he, hf, h20, h21]
  have hLmat : (L : Matrix (Fin 3) (Fin 3) F) =
      !![(nu * lam) * a, (nu * lam) * b, 0; (nu * lam) * c, (nu * lam) * d, 0; 0, 0, 1] := by
    show (blockV2 C : Matrix (Fin 3) (Fin 3) F) = _
    simp [blockV2, C]
  have hTL : ((T : Matrix (Fin 3) (Fin 3) F) * (L : Matrix (Fin 3) (Fin 3) F)) =
      !![a, b, 0; c, d, 0; 0, 0, lam] := by
    rw [hLmat]
    have hTdiag : (T : Matrix (Fin 3) (Fin 3) F) = Matrix.diagonal ![(nu * lam)⁻¹, nu, lam] := by
      ext i j
      fin_cases i <;> fin_cases j <;> simp [T, Matrix.diagonal_apply]
    rw [hTdiag]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.diagonal_mul, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.head_cons, Matrix.tail_cons] <;> field_simp
    all_goals try rw [h1]
    all_goals try rw [inv_mul_cancel_left₀ hnu0]
    all_goals ring
  have hUmat : (U : Matrix (Fin 3) (Fin 3) F) =
      !![1, 0, e * lam⁻¹; 0, 1, f * lam⁻¹; 0, 0, 1] := by
    show (↑(yMat (f * lam⁻¹) * wMat (e * lam⁻¹)) : Matrix (Fin 3) (Fin 3) F) = _
    rw [coe_yMat_mul_wMat]
  have hmat : (M : Matrix (Fin 3) (Fin 3) F) =
      ((U : Matrix (Fin 3) (Fin 3) F) * (T : Matrix (Fin 3) (Fin 3) F)) *
        (L : Matrix (Fin 3) (Fin 3) F) := by
    rw [mul_assoc, hTL, hUmat, hMmat]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_three, Matrix.of_apply, Matrix.cons_val_zero,
        Matrix.cons_val_one, Matrix.head_cons, Matrix.tail_cons] <;> field_simp
    all_goals try rw [h1]
    all_goals try rw [inv_mul_cancel_left₀ hnu0]
    all_goals ring
  have hTmem : proj 3 F T ∈ torus3 F := by
    have hT : T = dMat (Units.mk0 (nu * lam)⁻¹ (inv_ne_zero (mul_ne_zero hnu0 hlam0)))
        (Units.mk0 nu hnu0) := by
      apply Subtype.ext
      ext i j
      fin_cases i <;> fin_cases j <;> simp [T, dMat, Matrix.diagonal_apply]
      all_goals try rw [inv_mul_cancel_left₀ hnu0]
      all_goals ring
    rw [hT]
    exact dP_mem_torus3 _ _
  have hLmem : proj 3 F L ∈ (levV2 (F := F)).range :=
    MonoidHom.mem_range.mpr ⟨C, rfl⟩
  have hUmem : proj 3 F U ∈ (V2 : Subgroup (projectiveSL 3 F)) := by
    have h1' : proj 3 F U = yP (f * lam⁻¹) * wP (e * lam⁻¹) := rfl
    rw [h1']
    exact mem_V2.mpr ⟨f * lam⁻¹, e * lam⁻¹, rfl⟩
  have hMdecomp : M = U * T * L := Subtype.ext hmat
  rw [hMdecomp, map_mul, map_mul]
  exact ((V2 ⊔ (levV2 (F := F)).range : Subgroup (projectiveSL 3 F)) ⊔ torus3 F).mul_mem
    (((V2 ⊔ (levV2 (F := F)).range : Subgroup (projectiveSL 3 F)) ⊔ torus3 F).mul_mem
      (Subgroup.mem_sup_left (Subgroup.mem_sup_left hUmem))
      (Subgroup.mem_sup_right hTmem))
    (Subgroup.mem_sup_left (Subgroup.mem_sup_right hLmem))

private theorem linVertex_V2 [Finite F] (h4 : 4 ≤ Nat.card F) :
    LinVertex (V2 ⊔ (levV2 (F := F)).range) V2 (levV2 (F := F)) (vecV2 (F := F)) where
  A_le_C := le_sup_left
  s_mem_C B := Subgroup.mem_sup_right (MonoidHom.mem_range.mpr ⟨B, rfl⟩)
  A_comm a ha b hb :=
    congrArg Subtype.val (isElemAbelian_V2.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  A_sq a ha := isElemAbelian_V2.2 a ha
  A_normal_C g hg a ha := (Subgroup.mem_normalizer_iff.mp (le_normalizer_V2_sup hg) a).mp ha
  C_decomp := by
    intro g hg
    have hcoe := Subgroup.coe_mul_of_right_le_normalizer_left (V2 (F := F) : Subgroup _)
      (levV2 (F := F)).range range_le_normalizer_V2
    have hg' : g ∈ (V2 (F := F) : Set (projectiveSL 3 F)) *
        ((levV2 (F := F)).range : Set (projectiveSL 3 F)) := by
      rwa [← hcoe]
    obtain ⟨a, ha, l, hl, rfl⟩ := hg'
    obtain ⟨B, rfl⟩ := MonoidHom.mem_range.mp hl
    exact ⟨a, ha, B, rfl⟩
  C_unique := by
    intro a ha a' ha' B B' heq
    have hB : B = B' := by
      have hmem : levV2 (B * B'⁻¹) ∈ (V2 : Subgroup (projectiveSL 3 F)) := by
        have h2 : levV2 B * (levV2 B')⁻¹ = a⁻¹ * a' := by
          calc levV2 B * (levV2 B')⁻¹ = a⁻¹ * (a * levV2 B) * (levV2 B')⁻¹ := by group
            _ = a⁻¹ * (a' * levV2 B') * (levV2 B')⁻¹ := by rw [heq]
            _ = a⁻¹ * a' := by group
        rw [show levV2 (B * B'⁻¹) = levV2 B * (levV2 B')⁻¹ from by rw [map_mul, map_inv], h2]
        exact (V2 : Subgroup (projectiveSL 3 F)).mul_mem ((V2 : Subgroup _).inv_mem ha) ha'
      have hboth : levV2 (B * B'⁻¹) ∈
          (V2 : Subgroup (projectiveSL 3 F)) ⊓ levV2.range :=
        ⟨hmem, MonoidHom.mem_range.mpr ⟨B * B'⁻¹, rfl⟩⟩
      rw [V2_inf_range] at hboth
      have h1 : levV2 (B * B'⁻¹) = 1 := Subgroup.mem_bot.mp hboth
      have h2 : B * B'⁻¹ = 1 := levV2_injective (by rw [h1, map_one])
      exact mul_inv_eq_one.mp h2
    refine ⟨?_, hB⟩
    rw [hB] at heq
    exact mul_right_cancel heq
  S_perfect := CFSG.ClassicalModels.specialLinear_isPerfect_two_of_four_le_card F h4
  S_pCore := CFSG.Quasithin.SimsG4.pCore_sl2_charTwo F
  vec_add z hz w hw := vecV2_add hz hw
  vec_surj := vecV2_surj
  vec_ker z hz := vecV2_ker hz
  vec_conj B z hz := vecV2_conj B hz

private def twistTorusV2 (a : Fˣ) (B : Matrix.SpecialLinearGroup (Fin 2) F) :
    Matrix.SpecialLinearGroup (Fin 2) F :=
  ⟨!![(B : Matrix (Fin 2) (Fin 2) F) 0 0, (a : F) * (B : Matrix (Fin 2) (Fin 2) F) 0 1;
    (a : F)⁻¹ * (B : Matrix (Fin 2) (Fin 2) F) 1 0, (B : Matrix (Fin 2) (Fin 2) F) 1 1], by
    rw [Matrix.det_fin_two]
    simp only [Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      Matrix.tail_cons]
    have h3 : (a : F) * (a : F)⁻¹ = 1 := by field_simp
    have h4 : (a : F) * (B : Matrix (Fin 2) (Fin 2) F) 0 1 *
        ((a : F)⁻¹ * (B : Matrix (Fin 2) (Fin 2) F) 1 0) =
          (B : Matrix (Fin 2) (Fin 2) F) 0 1 * (B : Matrix (Fin 2) (Fin 2) F) 1 0 := by
      calc (a : F) * (B : Matrix (Fin 2) (Fin 2) F) 0 1 *
          ((a : F)⁻¹ * (B : Matrix (Fin 2) (Fin 2) F) 1 0) =
            ((a : F) * (a : F)⁻¹) * ((B : Matrix (Fin 2) (Fin 2) F) 0 1 *
              (B : Matrix (Fin 2) (Fin 2) F) 1 0) := by ring
        _ = (B : Matrix (Fin 2) (Fin 2) F) 0 1 *
              (B : Matrix (Fin 2) (Fin 2) F) 1 0 := by rw [h3, one_mul]
    rw [h4]
    have h2 := B.2
    rw [Matrix.det_fin_two] at h2
    exact h2⟩

private theorem dMat_mul_blockV2 (t1 t2 : Fˣ) (B : Matrix.SpecialLinearGroup (Fin 2) F) :
    (dMat t1 t2 : Matrix (Fin 3) (Fin 3) F) * (blockV2 B : Matrix (Fin 3) (Fin 3) F) =
      (blockV2 (twistTorusV2 (t1 * t2⁻¹) B) : Matrix (Fin 3) (Fin 3) F) *
        (dMat t1 t2 : Matrix (Fin 3) (Fin 3) F) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [dMat, coe_dMat, blockV2, twistTorusV2, Matrix.mul_apply, Fin.sum_univ_three,
      Matrix.diagonal_apply] <;>
    field_simp

private theorem conj_blockV2_dMat (t1 t2 : Fˣ) (B : Matrix.SpecialLinearGroup (Fin 2) F) :
    (dMat t1 t2 : Matrix.SpecialLinearGroup (Fin 3) F) * blockV2 B * (dMat t1 t2)⁻¹ =
      blockV2 (twistTorusV2 (t1 * t2⁻¹) B) := by
  have h1 : (dMat t1 t2 : Matrix.SpecialLinearGroup (Fin 3) F) * blockV2 B =
      blockV2 (twistTorusV2 (t1 * t2⁻¹) B) * dMat t1 t2 := by
    apply Subtype.ext
    show ((dMat t1 t2 : Matrix (Fin 3) (Fin 3) F) * (blockV2 B : Matrix (Fin 3) (Fin 3) F)) =
      ((blockV2 (twistTorusV2 (t1 * t2⁻¹) B) : Matrix (Fin 3) (Fin 3) F) *
        (dMat t1 t2 : Matrix (Fin 3) (Fin 3) F))
    exact dMat_mul_blockV2 t1 t2 B
  rw [h1]
  group

private theorem conj_mem_rangeV2_torus {t : projectiveSL 3 F} (ht : t ∈ torus3 F)
    {x : projectiveSL 3 F} (hx : x ∈ (levV2 (F := F)).range) :
    t * x * t⁻¹ ∈ (levV2 (F := F)).range := by
  obtain ⟨t1, t2, rfl⟩ := mem_torus3.mp ht
  obtain ⟨B, rfl⟩ := MonoidHom.mem_range.mp hx
  refine MonoidHom.mem_range.mpr ⟨twistTorusV2 (t1 * t2⁻¹) B, ?_⟩
  change proj 3 F (blockV2 (twistTorusV2 (t1 * t2⁻¹) B)) =
    proj 3 F (dMat t1 t2) * proj 3 F (blockV2 B) * (proj 3 F (dMat t1 t2))⁻¹
  rw [← map_inv, ← map_mul, ← map_mul]
  exact (congrArg (proj 3 F) (conj_blockV2_dMat t1 t2 B)).symm

private theorem torus3_le_normalizer_V2 [Finite F] :
    torus3 F ≤ Subgroup.normalizer ((V2 : Subgroup (projectiveSL 3 F)) :
      Set (projectiveSL 3 F)) := by
  intro t ht
  rw [normalizer_V2_eq]
  obtain ⟨t1, t2, rfl⟩ := mem_torus3.mp ht
  refine ⟨dMat t1 t2, ?_, rfl⟩
  exact mem_Q3_one_iff.mpr ⟨by simp [coe_dMat, Matrix.diagonal_apply],
    by simp [coe_dMat, Matrix.diagonal_apply]⟩

private theorem normalizer_V2_eq_sup [Finite F] :
    Subgroup.normalizer ((V2 : Subgroup (projectiveSL 3 F)) : Set (projectiveSL 3 F)) =
      (V2 ⊔ (levV2 (F := F)).range : Subgroup (projectiveSL 3 F)) ⊔ torus3 F := by
  refine le_antisymm ?_ ?_
  · rw [normalizer_V2_eq]
    rintro _ ⟨M, hM, rfl⟩
    exact proj_mem_sup_of_mem_Q3_one hM
  · refine sup_le (sup_le Subgroup.le_normalizer range_le_normalizer_V2) torus3_le_normalizer_V2

private theorem normalizer_V2_le_normalizer_sup [Finite F] :
    Subgroup.normalizer ((V2 : Subgroup (projectiveSL 3 F)) : Set (projectiveSL 3 F)) ≤
      Subgroup.normalizer
        ((V2 ⊔ (levV2 (F := F)).range : Subgroup (projectiveSL 3 F)) :
          Set (projectiveSL 3 F)) := by
  rw [normalizer_V2_eq_sup]
  refine sup_le Subgroup.le_normalizer ?_
  have hcoe := Subgroup.coe_mul_of_right_le_normalizer_left (V2 (F := F) : Subgroup _)
    (levV2 (F := F)).range range_le_normalizer_V2
  intro t ht
  refine CFSG.QuasithinUnique.Fin257.L3.mem_normalizer_of_conj _ ?_ ?_
  · intro x hx
    have hx' : x ∈ (V2 (F := F) : Set (projectiveSL 3 F)) *
        ((levV2 (F := F)).range : Set (projectiveSL 3 F)) := by
      rwa [← hcoe]
    obtain ⟨a, ha, l, hl, rfl⟩ := hx'
    have h1 : t * (a * l) * t⁻¹ = (t * a * t⁻¹) * (t * l * t⁻¹) := by group
    rw [h1]
    have h2 : t * a * t⁻¹ ∈ V2 :=
      (Subgroup.mem_normalizer_iff.mp (torus3_le_normalizer_V2 ht) a).mp ha
    have h3 : t * l * t⁻¹ ∈ (levV2 (F := F)).range := conj_mem_rangeV2_torus ht hl
    exact (V2 ⊔ (levV2 (F := F)).range : Subgroup _).mul_mem
      (Subgroup.mem_sup_left h2) (Subgroup.mem_sup_right h3)
  · intro x hx
    have hx' : x ∈ (V2 (F := F) : Set (projectiveSL 3 F)) *
        ((levV2 (F := F)).range : Set (projectiveSL 3 F)) := by
      rwa [← hcoe]
    obtain ⟨a, ha, l, hl, rfl⟩ := hx'
    have ht' : t⁻¹ ∈ torus3 F := (torus3 F).inv_mem ht
    have h1 : t⁻¹ * (a * l) * t = (t⁻¹ * a * t) * (t⁻¹ * l * t) := by group
    rw [h1]
    have h2 : t⁻¹ * a * t ∈ V2 := by
      simpa using (Subgroup.mem_normalizer_iff.mp (torus3_le_normalizer_V2 ht') a).mp ha
    have h3 : t⁻¹ * l * t ∈ (levV2 (F := F)).range := by
      simpa using conj_mem_rangeV2_torus ht' hl
    exact (V2 ⊔ (levV2 (F := F)).range : Subgroup _).mul_mem
      (Subgroup.mem_sup_left h2) (Subgroup.mem_sup_right h3)

private theorem perfectCore_normalizer_V2 [Finite F] (h4 : 4 ≤ Nat.card F) :
    perfectCore (Subgroup.normalizer ((V2 : Subgroup (projectiveSL 3 F)) :
      Set (projectiveSL 3 F))) = (V2 ⊔ (levV2 (F := F)).range : Subgroup _) := by
  let N : Subgroup (projectiveSL 3 F) :=
    Subgroup.normalizer ((V2 : Subgroup (projectiveSL 3 F)) : Set (projectiveSL 3 F))
  let C : Subgroup (projectiveSL 3 F) := V2 ⊔ (levV2 (F := F)).range
  have hCY : C ≤ N := le_normalizer_V2_sup
  have hN : N = C ⊔ torus3 F := normalizer_V2_eq_sup (F := F)
  have hnormal : (C.subgroupOf N).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hCY).mpr
      (normalizer_V2_le_normalizer_sup (F := F))
  have hmain : perfectCore N ≤ C := by
    refine CFSG.Quasithin.perfectCore_le_of_sup_solvable (A := C) (B := torus3 F) (Y := N)
      hCY hnormal ?_ PointVertex.isSolvable_torus3
    exact hN
  refine le_antisymm hmain ?_
  refine CFSG.Quasithin.le_perfectCore_of_perfect hCY ?_
  exact (linVertex_V2 (F := F) h4).commutator_eq

theorem l3_vertex_V2 [Finite F] {n : ℕ} (hn : 2 ≤ n) (hF : Nat.card F = 2 ^ n) :
    IsShort2 (perfectCore (Subgroup.normalizer ((V2 : Subgroup (projectiveSL 3 F)) :
      Set (projectiveSL 3 F)))) ∧
    IsLin2Type (perfectCore (Subgroup.normalizer ((V2 : Subgroup (projectiveSL 3 F)) :
      Set (projectiveSL 3 F)))) n := by
  have h4 : 4 ≤ Nat.card F := by
    rw [hF]
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
  letI := Fintype.ofFinite F
  have hcard : Fintype.card F = 2 ^ n := by
    rw [Fintype.card_eq_nat_card]
    exact hF
  have hpc := perfectCore_normalizer_V2 (F := F) h4
  have hLV := linVertex_V2 (F := F) h4
  rw [hpc]
  exact ⟨hLV.isShort2 h4, hLV.isLin2Type hcard⟩

end LineVertex

