theorem le_pCoreOf_or_le_sup_of_borelOf_le_normalizer {n : ℕ} (hn : 1 ≤ n)
    (hsyl : IsSylowTwoOf (S ⊓ L1) L1) (h1 : IsL2Quot n (oTwoQuot ↥L1)) (hS1 : S ≤ L1)
    {K : Subgroup G} (hKS : K ≤ S) (hBK : borelOf L1 S ≤ Subgroup.normalizer (K : Set G)) :
    K ≤ pCoreOf 2 L1 ∨ S ≤ K ⊔ pCoreOf 2 L1 := by
  have hKL : K ≤ L1 := hKS.trans hS1
  let K1 := ↥L1
  let π : K1 →* oTwoQuot K1 := QuotientGroup.mk' (CFSG.pCore 2 K1)
  have hmemQ : ∀ x : K1, π x = 1 → (x : G) ∈ pCoreOf 2 L1 := fun x hx =>
    (CFSG.mem_openPCoreOf_iff x).mpr ((QuotientGroup.eq_one_iff x).mp hx)
  let T1 : Subgroup K1 := (S ⊓ L1).subgroupOf L1
  have hT1syl : IsSylowTwoOf T1 ⊤ := by
    refine ⟨le_top, hsyl.2.1.of_equiv (Subgroup.subgroupOfEquivOfLe hsyl.1).symm, ?_⟩
    rw [show (T1.subgroupOf ⊤).index = T1.index from by
      rw [← Subgroup.relIndex, Subgroup.relIndex_top_right]]
    exact hsyl.2.2
  let P1 : Sylow 2 K1 := hT1syl.2.1.toSylow hsyl.2.2
  let P : Sylow 2 (oTwoQuot K1) := P1.mapSurjective (QuotientGroup.mk'_surjective _)
  have hPcoe : (P : Subgroup (oTwoQuot K1)) = T1.map π :=
    Sylow.coe_mapSurjective (QuotientGroup.mk'_surjective _) P1
  set H : Subgroup (oTwoQuot K1) := (K.subgroupOf L1).map π with hHdef
  have hHP : H ≤ (P : Subgroup (oTwoQuot K1)) := by
    rw [hHdef, hPcoe]
    refine Subgroup.map_mono fun x hx => ?_
    exact Subgroup.mem_subgroupOf.mpr ⟨hKS (Subgroup.mem_subgroupOf.mp hx), x.2⟩
  by_cases hHne : H = ⊥
  · refine Or.inl fun x hxK => hmemQ ⟨x, hKL hxK⟩ ?_
    have hxH : π (⟨x, hKL hxK⟩ : K1) ∈ H := by
      rw [hHdef]
      exact Subgroup.mem_map_of_mem π (Subgroup.mem_subgroupOf.mpr hxK)
    rw [hHne] at hxH
    exact Subgroup.mem_bot.mp hxH
  refine Or.inr ?_
  have hB1K : (borelOf L1 S).subgroupOf L1 ≤
      Subgroup.normalizer ((K.subgroupOf L1) : Set K1) := by
    intro b hb
    have hbG : (b : G) ∈ Subgroup.normalizer (K : Set G) := hBK (Subgroup.mem_subgroupOf.mp hb)
    rw [Subgroup.mem_normalizer_iff] at hbG ⊢
    intro x
    constructor
    · intro hx
      have hA : (b : G) * (x : G) * (b : G)⁻¹ ∈ K :=
        (hbG (x : G)).mp (Subgroup.mem_subgroupOf.mp hx)
      exact Subgroup.mem_subgroupOf.mpr (by simpa using hA)
    · intro hx
      have hxK : (b : G) * (x : G) * (b : G)⁻¹ ∈ K := by
        simpa using (Subgroup.mem_subgroupOf.mp hx)
      exact Subgroup.mem_subgroupOf.mpr ((hbG (x : G)).mpr hxK)
  have hNP : Subgroup.normalizer ((P : Subgroup (oTwoQuot K1)) : Set (oTwoQuot K1)) =
      ((borelOf L1 S).subgroupOf L1).map π := by
    have hmap := (F1.map_borelOf_eq_normalizer hsyl).2.2
    rw [hPcoe]
    simpa [T1, π] using hmap.symm
  have hNPH : Subgroup.normalizer ((P : Subgroup (oTwoQuot K1)) : Set (oTwoQuot K1)) ≤
      Subgroup.normalizer (H : Set (oTwoQuot K1)) := by
    rw [hNP]
    calc ((borelOf L1 S).subgroupOf L1).map π
        ≤ (Subgroup.normalizer ((K.subgroupOf L1) : Set K1)).map π :=
          Subgroup.map_mono hB1K
      _ ≤ Subgroup.normalizer (((K.subgroupOf L1).map π) : Set (oTwoQuot K1)) :=
          Subgroup.le_normalizer_map π
      _ = Subgroup.normalizer (H : Set (oTwoQuot K1)) := by rw [hHdef]
  have hTH : (P : Subgroup (oTwoQuot K1)) ≤ H := by
    intro x hxP
    by_cases hx1 : x = 1
    · rw [hx1]
      exact H.one_mem
    · obtain ⟨h, hh1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hHne
      have hh1' : (h : oTwoQuot K1) ≠ 1 := fun he => hh1 (Subtype.ext he)
      obtain ⟨d, hdN, hdh⟩ := CFSG.Quasithin.Stroth.psl2_normalizer_transitive hn h1 P
        (hHP h.2) hxP hh1' hx1
      have hmem : d * (h : oTwoQuot K1) * d⁻¹ ∈ H :=
        (Subgroup.mem_normalizer_iff.mp (hNPH hdN) (h : oTwoQuot K1)).mp h.2
      rwa [hdh] at hmem
  intro s hs
  have hsH : π (⟨s, hS1 hs⟩ : K1) ∈ H := by
    refine hTH ?_
    rw [hPcoe]
    exact Subgroup.mem_map_of_mem π (Subgroup.mem_subgroupOf.mpr ⟨hs, hS1 hs⟩)
  obtain ⟨k, hk, hkπ⟩ := Subgroup.mem_map.mp hsH
  have hdiff : (k : G)⁻¹ * s ∈ pCoreOf 2 L1 := by
    refine hmemQ (k⁻¹ * (⟨s, hS1 hs⟩ : K1)) ?_
    rw [map_mul, map_inv, hkπ]
    group
  have hEq : s = (k : G) * ((k : G)⁻¹ * s) := by group
  rw [hEq]
  exact mul_mem (Subgroup.mem_sup_left (Subgroup.mem_subgroupOf.mp hk))
    (Subgroup.mem_sup_right hdiff)

theorem D4qLocalData.centerOf_pCoreOf_right_le_left (hH : Hyp111 L1 L2 S)
    (hD : D4qLocalData L1 L2 S f) (h1 : IsL2Quot (3 * f) (oTwoQuot ↥L1)) :
    centerOf (pCoreOf 2 L2) ≤ pCoreOf 2 L1 := by
  have hf : 1 ≤ f := hD.one_le
  have hS1 : S ≤ L1 := hD.le_left hH h1
  have hZQ : centerOf (pCoreOf 2 L2) ≤ pCoreOf 2 L2 := inf_le_left
  have hZS : centerOf (pCoreOf 2 L2) ≤ S := hZQ.trans hH.pCoreOf_le_right
  have hBZ : borelOf L1 S ≤ Subgroup.normalizer (centerOf (pCoreOf 2 L2) : Set G) :=
    le_normalizer_centerOf_of_le_normalizer
      ((le_sup_left.trans le_sup_left : borelOf L1 S ≤ bigB L1 L2 S).trans
        hH.bigB_le_normalizer_pCoreOf_right)
  refine (le_pCoreOf_or_le_sup_of_borelOf_le_normalizer (n := 3 * f) (by omega) hH.h1.sylow h1
    hS1 hZS hBZ).resolve_right fun hle => ?_
  obtain ⟨F, hField, hFintype, hFcard, α, -, -, β, hβ, hker, -⟩ := hD.nat_right
  letI := hField
  letI := hFintype
  have hinj : Function.Injective β := by
    rw [← MonoidHom.ker_eq_bot_iff, hker, Subgroup.bot_subgroupOf]
  have hZcard : Nat.card (centerOf (pCoreOf 2 L2)) = 2 ^ (2 * f) := by
    rw [Nat.card_eq_of_bijective β ⟨hinj, hβ⟩, Nat.card_congr Multiplicative.toAdd, Nat.card_fun,
      Nat.card_fin, Nat.card_eq_fintype_card, hFcard]
    ring
  have hN : centerOf (pCoreOf 2 L2) ≤ Subgroup.normalizer (pCoreOf 2 L1 : Set G) :=
    (hZS.trans (le_sup_right : S ≤ bigB L1 L2 S)).trans hH.bigB_le_normalizer_pCoreOf_left
  have hprod := card_sup_mul_card_inf_of_le_normalizer hN
  rw [hZcard, hD.card_left, ← pow_add] at hprod
  have hpos : 0 < Nat.card ↥(centerOf (pCoreOf 2 L2) ⊓ pCoreOf 2 L1) := Nat.card_pos
  have hsup : Nat.card ↥(centerOf (pCoreOf 2 L2) ⊔ pCoreOf 2 L1) ≤ 2 ^ (2 * f + 9 * f) := by
    rw [← hprod]
    exact Nat.le_mul_of_pos_right _ hpos
  have hcard : Nat.card S ≤ Nat.card ↥(centerOf (pCoreOf 2 L2) ⊔ pCoreOf 2 L1) :=
    Subgroup.card_le_of_le hle
  rw [hD.card_S] at hcard
  have hlt : 2 ^ (2 * f + 9 * f) < 2 ^ (12 * f) := Nat.pow_lt_pow_right (by norm_num) (by omega)
  omega

theorem mem_utri_of_conj_utriElt_one_eq {F : Type} [Field F] [CharP F 2] {g : SL(2, F)}
    (hg : g * utriElt 1 * g⁻¹ = utriElt 1) : g ∈ utri F := by
  have h10 : g 1 0 = 0 := by
    have h := congrArg (fun M : SL(2, F) => M 1 0) hg
    simp only [conj_utriElt_apply_10, utriElt_apply_10, mul_one, neg_eq_zero] at h
    exact (pow_eq_zero_iff two_ne_zero).mp h
  have h00 : g 0 0 = 1 := by
    have h := congrArg (fun M : SL(2, F) => M 0 1) hg
    simp only [conj_utriElt_apply_01, utriElt_apply_01, mul_one] at h
    have hsq : (g 0 0 + 1) ^ 2 = 0 := by
      rw [CharTwo.add_sq, h, one_pow, CharTwo.add_self_eq_zero]
    have h' := (pow_eq_zero_iff two_ne_zero).mp hsq
    rwa [add_eq_zero_iff_eq_neg, CharTwo.neg_eq] at h'
  exact mem_utri_entries.mpr ⟨h10, h00⟩

private theorem d4qIndec_exists_pCoreOf_right_utriElt (hH : Hyp111 L1 L2 S)
    (hD : D4qLocalData L1 L2 S f) (h1 : IsL2Quot (3 * f) (oTwoQuot ↥L1)) {F : Type} [Field F]
    (α : ↥L1 →* SL(2, F)) (hsurj : Function.Surjective α)
    (hker : ∀ x : ↥L1, α x = 1 ↔ (x : G) ∈ pCoreOf 2 L1)
    (hmemS : ∀ x : ↥L1, (x : G) ∈ S ↔ α x ∈ utri F) :
    ∃ x₀ ∈ pCoreOf 2 L2, ∀ hx : x₀ ∈ L1, α ⟨x₀, hx⟩ = utriElt 1 := by
  have hS1 : S ≤ L1 := hD.le_left hH h1
  obtain ⟨s, hs⟩ := hsurj (utriElt 1)
  have hsS : (s : G) ∈ S := (hmemS s).mpr (by rw [hs]; exact utriElt_mem_utri 1)
  have hmul := Subgroup.coe_mul_of_left_le_normalizer_right (pCoreOf 2 L2) (pCoreOf 2 L1)
    ((hH.pCoreOf_le_right.trans hS1).trans (le_normalizer_pCoreOf 2 L1))
  have hs' : (s : G) ∈ (pCoreOf 2 L2 : Set G) * (pCoreOf 2 L1 : Set G) := by
    rw [← hmul, sup_comm, hD.sup_pCoreOf hH h1]
    exact hsS
  obtain ⟨x, hx, y, hy, hxy⟩ := hs'
  refine ⟨x, hx, fun hxL => ?_⟩
  have hyL : y ∈ L1 := pCoreOf_le 2 L1 hy
  have hαy : α ⟨y, hyL⟩ = 1 := (hker _).mpr hy
  have hsxy : s = ⟨x, hxL⟩ * ⟨y, hyL⟩ := Subtype.ext hxy.symm
  rw [← hs, hsxy, map_mul, hαy, mul_one]

private theorem d4qIndec_inf_right_le_trivOTwoQuot (hH : Hyp111 L1 L2 S)
    (hD : D4qLocalData L1 L2 S f) (h1 : IsL2Quot (3 * f) (oTwoQuot ↥L1)) {H : Subgroup G}
    (hHB : H ≤ bigB L1 L2 S) (hSH : S ⊔ H = bigB L1 L2 S) (hSinfH : S ⊓ H = ⊥)
    (hHcard : Nat.card H = (2 ^ (3 * f) - 1) * (2 ^ f - 1))
    (hHcomm : ∀ a ∈ H, ∀ b ∈ H, a * b = b * a) (hR : ⁅pCoreOf 2 L2, L2⁆ ≤ pCoreOf 2 L1) :
    H ⊓ L2 ≤ trivOTwoQuot L1 := by
  have hS1 : S ≤ L1 := hD.le_left hH h1
  obtain ⟨-, -, hHsup, -⟩ := hD.torus_left_of_hall hH h1 hHB hSH hSinfH hHcard hHcomm
  obtain ⟨c1⟩ := hD.exists_coordLeft hH h1
  letI := c1.field
  letI := c1.fintype
  haveI : CharP c1.F 2 :=
    charP_of_card_eq_prime_pow (by rw [← Nat.card_eq_fintype_card, c1.card])
  obtain ⟨x₀, hx₀Q, hx₀⟩ :=
    d4qIndec_exists_pCoreOf_right_utriElt hH hD h1 c1.α c1.surj c1.ker c1.memS
  have hx₀L : x₀ ∈ L1 := hS1 (hH.pCoreOf_le_right hx₀Q)
  intro t ht
  obtain ⟨htH, htL2⟩ := Subgroup.mem_inf.mp ht
  have hnorm : H ⊓ L1 ≤ Subgroup.normalizer ((H ⊓ trivOTwoQuot L1 : Subgroup G) : Set G) := by
    intro a ha
    have haH : a ∈ H := (Subgroup.mem_inf.mp ha).1
    have hcomm : ∀ b ∈ H, a * b * a⁻¹ = b := fun b hb => by
      rw [hHcomm a haH b hb, mul_inv_cancel_right]
    rw [Subgroup.mem_normalizer_iff]
    intro b
    constructor
    · intro hb
      rwa [hcomm b (Subgroup.mem_inf.mp hb).1]
    · intro hb
      have hbH : b ∈ H := by
        have h' := H.mul_mem (H.mul_mem (H.inv_mem haH) (Subgroup.mem_inf.mp hb).1) haH
        rwa [show a⁻¹ * (a * b * a⁻¹) * a = b by group] at h'
      rwa [hcomm b hbH] at hb
  have hmem : t ∈ ((H ⊓ L1 : Subgroup G) : Set G) *
      ((H ⊓ trivOTwoQuot L1 : Subgroup G) : Set G) := by
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right _ _ hnorm, hHsup]
    exact htH
  obtain ⟨t₁, ht₁, t₀, ht₀, rfl⟩ := hmem
  obtain ⟨ht₁H, ht₁L⟩ := Subgroup.mem_inf.mp ht₁
  have ht₀T : t₀ ∈ trivOTwoQuot L1 := (Subgroup.mem_inf.mp ht₀).2
  have hc : ⁅t₁ * t₀, x₀⁆ ∈ pCoreOf 2 L1 := by
    have h := Subgroup.commutator_mem_commutator htL2 hx₀Q
    rw [Subgroup.commutator_comm] at h
    exact hR h
  have hk : t₀ * x₀ * t₀⁻¹ * x₀⁻¹ ∈ pCoreOf 2 L1 := (mem_trivOTwoQuot.mp ht₀T).2 x₀ hx₀L
  have hmemQ : t₁ * x₀ * t₁⁻¹ * x₀⁻¹ ∈ pCoreOf 2 L1 := by
    have h3 : t₁ * (t₀ * x₀ * t₀⁻¹ * x₀⁻¹)⁻¹ * t₁⁻¹ ∈ pCoreOf 2 L1 :=
      (Subgroup.mem_normalizer_iff.mp (le_normalizer_pCoreOf 2 L1 ht₁L) _).mp (inv_mem hk)
    have h4 := mul_mem h3 hc
    rw [commutatorElement_def] at h4
    have heq : t₁ * x₀ * t₁⁻¹ * x₀⁻¹ = t₁ * (t₀ * x₀ * t₀⁻¹ * x₀⁻¹)⁻¹ * t₁⁻¹ *
        (t₁ * t₀ * x₀ * (t₁ * t₀)⁻¹ * x₀⁻¹) := by group
    rw [heq]
    exact h4
  have hab : c1.α (⟨t₁, ht₁L⟩ * ⟨x₀, hx₀L⟩ * (⟨t₁, ht₁L⟩ : ↥L1)⁻¹ * (⟨x₀, hx₀L⟩ : ↥L1)⁻¹) = 1 :=
    (c1.ker _).mpr hmemQ
  rw [map_mul, map_mul, map_mul, map_inv, map_inv, hx₀ hx₀L] at hab
  have ht₁S : t₁ ∈ S :=
    (c1.memS ⟨t₁, ht₁L⟩).mpr (mem_utri_of_conj_utriElt_one_eq (mul_inv_eq_one.mp hab))
  have ht₁1 : t₁ = 1 := by
    have h : t₁ ∈ S ⊓ H := Subgroup.mem_inf.mpr ⟨ht₁S, ht₁H⟩
    rw [hSinfH] at h
    exact Subgroup.mem_bot.mp h
  rw [ht₁1]
  simpa using ht₀T

theorem D4qLocalData.pCoreOf_right_le_commutator_sup (hf : 2 ≤ f) (hH : Hyp111 L1 L2 S)
    (hD : D4qLocalData L1 L2 S f) (h1 : IsL2Quot (3 * f) (oTwoQuot ↥L1)) {H : Subgroup G}
    (hHB : H ≤ bigB L1 L2 S) (hSH : S ⊔ H = bigB L1 L2 S) (hSinfH : S ⊓ H = ⊥)
    (hHcard : Nat.card H = (2 ^ (3 * f) - 1) * (2 ^ f - 1))
    (hHcomm : ∀ a ∈ H, ∀ b ∈ H, a * b = b * a) (htriv : H ⊓ L2 ⊓ trivOTwoQuot L1 = ⊥) :
    pCoreOf 2 L2 ≤ ⁅pCoreOf 2 L2, L2⁆ ⊔ pCoreOf 2 L1 := by
  have hS1 : S ≤ L1 := hD.le_left hH h1
  have hQ2S : pCoreOf 2 L2 ≤ S := hH.pCoreOf_le_right
  have hRQ : ⁅pCoreOf 2 L2, L2⁆ ≤ pCoreOf 2 L2 := by
    rw [Subgroup.commutator_le]
    intro x hx l hl
    rw [commutatorElement_def, show x * l * x⁻¹ * l⁻¹ = x * (l * x⁻¹ * l⁻¹) by group]
    exact mul_mem hx
      ((Subgroup.mem_normalizer_iff.mp (le_normalizer_pCoreOf 2 L2 hl) x⁻¹).mp (inv_mem hx))
  have hNB := hD.bigB_le_normalizer hH h1
  have hBR : borelOf L1 S ≤ Subgroup.normalizer ((⁅pCoreOf 2 L2, L2⁆ : Subgroup G) : Set G) := by
    intro g hg
    have hgB : g ∈ bigB L1 L2 S := (le_sup_left.trans le_sup_left : borelOf L1 S ≤ _) hg
    have hgL : g ∈ Subgroup.normalizer (L2 : Set G) :=
      (Subgroup.mem_inf.mp (Subgroup.mem_inf.mp (hNB hgB)).1).2
    rw [Subgroup.mem_normalizer_iff_map_conj_eq, Subgroup.map_commutator,
      Subgroup.mem_normalizer_iff_map_conj_eq.mp (hH.bigB_le_normalizer_pCoreOf_right hgB),
      Subgroup.mem_normalizer_iff_map_conj_eq.mp hgL]
  rcases le_pCoreOf_or_le_sup_of_borelOf_le_normalizer (n := 3 * f) (by omega) hH.h1.sylow h1 hS1
    (hRQ.trans hQ2S) hBR with hR | hR
  · exfalso
    obtain ⟨hcard2, -⟩ := hD.torus_right_of_hall hf hH h1 hHB hSH hSinfH hHcard hHcomm
    have hbot : H ⊓ L2 = ⊥ :=
      (inf_eq_left.mpr
        (d4qIndec_inf_right_le_trivOTwoQuot hH hD h1 hHB hSH hSinfH hHcard hHcomm hR)).symm.trans
        htriv
    rw [hbot, Subgroup.card_bot] at hcard2
    have h4 : 4 ≤ 2 ^ f := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf
    omega
  · exact hQ2S.trans hR

