variable {K : Type} [Field K]

private theorem posUnipotentSub_le_parabolic (J : Set (Fin Tag.G2.rank)) :
    posUnipotentSub Tag.G2 K ≤
      (parabolicSubgroup Tag.G2 K J).subgroupOf (adjointGroup Tag.G2 K) :=
  fun _ hy => Subgroup.mem_subgroupOf.2 (borelGroup_le_parabolicSubgroup J
    (Subgroup.mem_sup_right (Subgroup.mem_subgroupOf.1 hy)))

end Model

variable {G : Type} [Group G] [Finite G] {L1 L2 S : Subgroup G} {f : ℕ}

theorem isAmalgamOfGroup_g2_of_mulEquiv_of_dcProp (hf : 2 ≤ f) (hH : Hyp111 L1 L2 S)
    (hSL1 : S ≤ L1) (hSL2 : S ≤ L2) (h1 : IsL2Quot f (oTwoQuot ↥L1))
    (h2 : IsL2Quot f (oTwoQuot ↥L2)) {K : Type} [Field K] [Finite K] [CharP K 2]
    (hK : Nat.card K = 2 ^ f)
    (hDC : CFSG.GH74.QTGen4.DSGen4.L34.DCProp (g2ParA K) (g2ParB K))
    (ψ₁ : ↥(L1 ⊔ bigB L1 L2 S) ≃* ↥(g2ParA K))
    (hψ₁Q : ∀ x : ↥(L1 ⊔ bigB L1 L2 S), (x : G) ∈ pCoreOf 2 L1 ↔
      ((ψ₁ x : ↥(g2ParA K)) : ↥(adjointGroup Tag.G2 K)) ∈ pCoreOf 2 (g2ParA K))
    (hψ₁S : ∀ x : ↥(L1 ⊔ bigB L1 L2 S), (x : G) ∈ S ↔
      ((ψ₁ x : ↥(g2ParA K)) : ↥(adjointGroup Tag.G2 K)) ∈ posUnipotentSub Tag.G2 K)
    (ψ₂ : ↥(L2 ⊔ bigB L1 L2 S) ≃* ↥(g2ParB K))
    (hψ₂Q : ∀ x : ↥(L2 ⊔ bigB L1 L2 S), (x : G) ∈ pCoreOf 2 L1 ↔
      ((ψ₂ x : ↥(g2ParB K)) : ↥(adjointGroup Tag.G2 K)) ∈ pCoreOf 2 (g2ParA K))
    (hψ₂S : ∀ x : ↥(L2 ⊔ bigB L1 L2 S), (x : G) ∈ S ↔
      ((ψ₂ x : ↥(g2ParB K)) : ↥(adjointGroup Tag.G2 K)) ∈ posUnipotentSub Tag.G2 K) :
    IsAmalgamOfGroup (f112Amalgam L1 L2 S) (IsG2Over f) := by
  classical
  let C := ↥(adjointGroup Tag.G2 K)
  let P1 : Subgroup G := L1 ⊔ bigB L1 L2 S
  let P2 : Subgroup G := L2 ⊔ bigB L1 L2 S
  have hR : Hyp111R L1 L2 S := hyp111R_of_isL2Quot (by omega) (by omega) hH h1 h2
  have hbigB1 : bigB L1 L2 S = P1 ⊓ Subgroup.normalizer (S : Set G) := by
    have h := bigB_eq_parabolic_inf hR
    rwa [inf_eq_left.mpr hSL1] at h
  have hbigB2 : bigB L1 L2 S = P2 ⊓ Subgroup.normalizer (S : Set G) := by
    have h := bigB_eq_parabolic_inf hR.symm
    rw [bigB_comm L1 L2 S, inf_eq_left.mpr hSL2] at h
    exact h
  have hN := G2q.normalizer_posUnipotentSub (K := K)
  have hψ₁N := mem_normalizer_iff_of_mulEquiv ψ₁ (hSL1.trans le_sup_left)
    (posUnipotentSub_le_parabolic _) hψ₁S
  have hψ₂N := mem_normalizer_iff_of_mulEquiv ψ₂ (hSL2.trans le_sup_left)
    (posUnipotentSub_le_parabolic _) hψ₂S
  have hB1 : ∀ x : ↥P1, (x : G) ∈ P2 ↔ ((ψ₁ x : ↥(g2ParA K)) : C) ∈ g2ParB K := by
    intro x
    constructor
    · intro hx
      have hxB : (x : G) ∈ bigB L1 L2 S := by
        rw [← parabolic_inf_parabolic hR]
        exact ⟨x.2, hx⟩
      rw [hbigB1] at hxB
      have hψ := (hψ₁N x).mp hxB.2
      rw [hN] at hψ
      exact hψ.2
    · intro hx
      have hψ : ((ψ₁ x : ↥(g2ParA K)) : C) ∈
          Subgroup.normalizer (posUnipotentSub Tag.G2 K : Set C) := by
        rw [hN]
        exact ⟨(ψ₁ x).2, hx⟩
      have hxB : (x : G) ∈ bigB L1 L2 S := by
        rw [hbigB1]
        exact ⟨x.2, (hψ₁N x).mpr hψ⟩
      exact (le_sup_right : bigB L1 L2 S ≤ P2) hxB
  have hB2 : ∀ x : ↥P2, (x : G) ∈ P1 ↔ ((ψ₂ x : ↥(g2ParB K)) : C) ∈ g2ParA K := by
    intro x
    constructor
    · intro hx
      have hxB : (x : G) ∈ bigB L1 L2 S := by
        rw [← parabolic_inf_parabolic hR]
        exact ⟨hx, x.2⟩
      rw [hbigB2] at hxB
      have hψ := (hψ₂N x).mp hxB.2
      rw [hN] at hψ
      exact hψ.1
    · intro hx
      have hψ : ((ψ₂ x : ↥(g2ParB K)) : C) ∈
          Subgroup.normalizer (posUnipotentSub Tag.G2 K : Set C) := by
        rw [hN]
        exact ⟨hx, (ψ₂ x).2⟩
      have hxB : (x : G) ∈ bigB L1 L2 S := by
        rw [hbigB2]
        exact ⟨x.2, (hψ₂N x).mpr hψ⟩
      exact (le_sup_right : bigB L1 L2 S ≤ P1) hxB
  have hiso : Nonempty ((RankTwoAmalgam.ofSubgroups P1 P2).Iso
      (RankTwoAmalgam.ofSubgroups (g2ParA K) (g2ParB K))) :=
    amalgam_iso_of_dcProp hDC ψ₁ ψ₂ hB1 hB2 hψ₁Q hψ₂Q
  refine ⟨C, inferInstance, Or.inr ⟨by omega, isLieOverTwo_g2 hK (by omega)⟩,
    posUnipotentSub Tag.G2 K, g2ParA K, g2ParB K, isYAmalgamPair_g2 hK (by omega), ?_⟩
  simpa [f112Amalgam, P1, P2] using hiso

theorem isAmalgamOfGroup_g2_of_mulEquiv (hf : 3 ≤ f) (hH : Hyp111 L1 L2 S)
    (hD : G2qLocalData L1 L2 S f) (h1 : IsL2Quot f (oTwoQuot ↥L1))
    (h2 : IsL2Quot f (oTwoQuot ↥L2)) {K : Type} [Field K] [Finite K] [CharP K 2]
    (hK : Nat.card K = 2 ^ f)
    (ψ₁ : ↥(L1 ⊔ bigB L1 L2 S) ≃* ↥(g2ParA K))
    (hψ₁Q : ∀ x : ↥(L1 ⊔ bigB L1 L2 S), (x : G) ∈ pCoreOf 2 L1 ↔
      ((ψ₁ x : ↥(g2ParA K)) : ↥(adjointGroup Tag.G2 K)) ∈ pCoreOf 2 (g2ParA K))
    (hψ₁S : ∀ x : ↥(L1 ⊔ bigB L1 L2 S), (x : G) ∈ S ↔
      ((ψ₁ x : ↥(g2ParA K)) : ↥(adjointGroup Tag.G2 K)) ∈ posUnipotentSub Tag.G2 K)
    (ψ₂ : ↥(L2 ⊔ bigB L1 L2 S) ≃* ↥(g2ParB K))
    (hψ₂Q : ∀ x : ↥(L2 ⊔ bigB L1 L2 S), (x : G) ∈ pCoreOf 2 L1 ↔
      ((ψ₂ x : ↥(g2ParB K)) : ↥(adjointGroup Tag.G2 K)) ∈ pCoreOf 2 (g2ParA K))
    (hψ₂S : ∀ x : ↥(L2 ⊔ bigB L1 L2 S), (x : G) ∈ S ↔
      ((ψ₂ x : ↥(g2ParB K)) : ↥(adjointGroup Tag.G2 K)) ∈ posUnipotentSub Tag.G2 K) :
    IsAmalgamOfGroup (f112Amalgam L1 L2 S) (IsG2Over f) :=
  isAmalgamOfGroup_g2_of_mulEquiv_of_dcProp (by omega) hH (hD.le_left hH (by omega) h1)
    (hD.le_right hH (by omega) h2) h1 h2 hK (dcProp_g2 hK hf) ψ₁ hψ₁Q hψ₁S ψ₂ hψ₂Q hψ₂S

end CFSG.Quasithin.F112R.St84

