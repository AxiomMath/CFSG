theorem f112sa_mem_K_of_steps {L1 L2 S : Subgroup H} (hF : F112HypW L1 L2 S)
    (hR : Hyp111R L1 L2 S) (hW : f112saW L1 L2 S = ⊥)
    (hT : S ⊓ f112saK L1 L2 S =
      pCoreOf 2 (f112saP1' L1 L2 S) ⊔ pCoreOf 2 (f112saP2' L1 L2 S))
    (hα : ∀ c ∈ S, (∀ l ∈ oTwoPrime (f112saP1' L1 L2 S),
        ⁅c, l⁆ ∈ pCoreOf 2 (f112saP1' L1 L2 S)) →
      ∀ q ∈ pCoreOf 2 (f112saP1' L1 L2 S), ⁅c, q⁆ = 1)
    (hβ₁ : ∀ c ∈ S, (∀ q ∈ pCoreOf 2 (f112saP1' L1 L2 S), ⁅c, q⁆ = 1) →
      ∃ a ∈ S ⊓ f112saK L1 L2 S, (∀ q ∈ pCoreOf 2 (f112saP1' L1 L2 S), ⁅c * a⁻¹, q⁆ = 1) ∧
        ∀ l ∈ oTwoPrime (f112saP2' L1 L2 S), ⁅c * a⁻¹, l⁆ ∈ pCoreOf 2 (f112saP2' L1 L2 S))
    (hβ₂ : ∀ c ∈ S, (∀ l ∈ oTwoPrime (f112saP2' L1 L2 S),
        ⁅c, l⁆ ∈ pCoreOf 2 (f112saP2' L1 L2 S)) →
      ∀ q ∈ pCoreOf 2 (f112saP2' L1 L2 S), ⁅c, q⁆ = 1)
    {c : H} (hcS : c ∈ S)
    (hc : ∀ l ∈ oTwoPrime (f112saP1' L1 L2 S), ⁅c, l⁆ ∈ pCoreOf 2 (f112saP1' L1 L2 S)) :
    c ∈ f112saK L1 L2 S := by
  classical
  let Eα := f112saP1' L1 L2 S
  let Eβ := f112saP2' L1 L2 S
  let Qα := pCoreOf 2 Eα
  let Qβ := pCoreOf 2 Eβ
  let T := S ⊓ f112saK L1 L2 S
  have hcQα : ∀ q ∈ Qα, ⁅c, q⁆ = 1 := hα c hcS hc
  obtain ⟨a, haT, hcaQα, hcaQβ⟩ := hβ₁ c hcS hcQα
  have haS : a ∈ S := (Subgroup.mem_inf.mp haT).1
  have hcaS : c * a⁻¹ ∈ S := S.mul_mem hcS (S.inv_mem haS)
  have hcaQβ' : ∀ q ∈ Qβ, ⁅c * a⁻¹, q⁆ = 1 := hβ₂ (c * a⁻¹) hcaS hcaQβ
  have hcaCentQα : c * a⁻¹ ∈ Subgroup.centralizer (Qα : Set H) := by
    rw [Subgroup.mem_centralizer_iff]
    intro q hq
    exact (commutatorElement_eq_one_iff_mul_comm.mp (hcaQα q hq)).symm
  have hcaCentQβ : c * a⁻¹ ∈ Subgroup.centralizer (Qβ : Set H) := by
    rw [Subgroup.mem_centralizer_iff]
    intro q hq
    exact (commutatorElement_eq_one_iff_mul_comm.mp (hcaQβ' q hq)).symm
  have hcaCentT : c * a⁻¹ ∈ Subgroup.centralizer (T : Set H) := by
    rw [show T = Qα ⊔ Qβ from hT, CFSG.centralizer_sup_eq]
    exact Subgroup.mem_inf.mpr ⟨hcaCentQα, hcaCentQβ⟩
  have hcaT : c * a⁻¹ ∈ T :=
    f112sa_S_inf_centralizer_le_T_of_W_eq_bot_of_hyp111R hF hR hW ⟨hcaS, hcaCentT⟩
  have hcT : c ∈ T := by
    rw [← show c * a⁻¹ * a = c by group]
    exact T.mul_mem hcaT haT
  exact (Subgroup.mem_inf.mp hcT).2

theorem f112sa_le_K_of_core_steps_of_isL2Quot {L1 L2 S : Subgroup H} {m n k₁ k₂ : ℕ}
    (hF : F112HypW L1 L2 S) (hm : 2 ≤ m) (hn : 2 ≤ n) (h1 : IsL2Quot m (oTwoQuot ↥L1))
    (h2 : IsL2Quot n (oTwoQuot ↥L2)) (hk₁ : 2 ≤ k₁)
    (hq1 : IsL2Quot k₁ (oTwoQuot ↥(oTwoPrime (f112saP1' L1 L2 S)))) (hk₂ : 2 ≤ k₂)
    (hq2 : IsL2Quot k₂ (oTwoQuot ↥(oTwoPrime (f112saP2' L1 L2 S))))
    (hstep1 : ∀ c ∈ S, (∀ l ∈ oTwoPrime (f112saP1' L1 L2 S),
      ⁅c, l⁆ ∈ pCoreOf 2 (f112saP1' L1 L2 S)) → c ∈ f112saK L1 L2 S)
    (hstep2 : ∀ c ∈ S, (∀ l ∈ oTwoPrime (f112saP2' L1 L2 S),
      ⁅c, l⁆ ∈ pCoreOf 2 (f112saP2' L1 L2 S)) → c ∈ f112saK L1 L2 S) :
    S ≤ f112saK L1 L2 S := by
  intro s hs
  rcases hF.2 with hnorm | hnorm
  · obtain ⟨t, ht, c, hcS, hcL, rfl⟩ :=
      f112_exists_mul_centralizer_mod_left_of_isL2Quot hF hm h1 hnorm s hs
    exact (f112saK L1 L2 S).mul_mem (Subgroup.mem_inf.mp ht).2 (hstep1 c hcS
      (f112sa_commutator_mem_pCoreOf_of_mem_oTwoPrime_P1'_of_isL2Quot hF hm h1 hk₁ hq1 hcS hcL))
  · obtain ⟨t, ht, c, hcS, hcL, rfl⟩ :=
      f112_exists_mul_centralizer_mod_right_of_isL2Quot hF hn h2 hnorm s hs
    exact (f112saK L1 L2 S).mul_mem (Subgroup.mem_inf.mp ht).2 (hstep2 c hcS
      (f112sa_commutator_mem_pCoreOf_of_mem_oTwoPrime_P2'_of_isL2Quot hF hn h2 hk₂ hq2 hcS hcL))

structure TransferVertexLin (E : Subgroup H) (n : ℕ) : Prop where
  lin : IsLin2Type (oTwoPrime E) n
  abelian : IsMulCommutative ↥(pCoreOf 2 E)
  indec : ⁅pCoreOf 2 E, oTwoPrime E⁆ = pCoreOf 2 E

theorem TransferVertexLin.quot {E : Subgroup H} {n : ℕ} (hV : TransferVertexLin E n)
    (hn : 2 ≤ n) : IsL2Quot n (oTwoQuot ↥(oTwoPrime E)) :=
  CFSG.Quasithin.F146Field.isL2Quot_of_isPSL (isPSL_of_isLin2Type1521 hn hV.lin)

theorem TransferVertexLin.centralizes_pCoreOf {E : Subgroup H} {n : ℕ}
    (hV : TransferVertexLin E n) {c : H} (hc2 : ∃ k, c ^ (2 ^ k) = 1)
    (hcE : c ∈ Subgroup.normalizer (E : Set H))
    (hcL : ∀ l ∈ oTwoPrime E, ⁅c, l⁆ ∈ pCoreOf 2 E) :
    ∀ q ∈ pCoreOf 2 E, ⁅c, q⁆ = 1 := by
  have hcL' : c ∈ Subgroup.normalizer (oTwoPrime E : Set H) :=
    mem_normalizer_oTwoPrime hcE
  have hQ : pCoreOf 2 (oTwoPrime E) = pCoreOf 2 E := pCoreOf_oTwoPrime E
  have hab : IsMulCommutative ↥(pCoreOf 2 (oTwoPrime E)) := by
    rw [hQ]
    exact hV.abelian
  have hU : ⁅pCoreOf 2 (oTwoPrime E), oTwoPrime E⁆ = pCoreOf 2 (oTwoPrime E) := by
    rw [hQ]
    exact hV.indec
  have hcLQ : ∀ l ∈ oTwoPrime E, ⁅c, l⁆ ∈ pCoreOf 2 (oTwoPrime E) := by
    intro l hl
    rw [hQ]
    exact hcL l hl
  have h := centralizes_pCoreOf_of_isLin2Type (L := oTwoPrime E) hV.lin hab hU hc2 hcL' hcLQ
  rwa [hQ] at h

private theorem exists_odd_ne_one_of_torus {D : Subgroup H} {q : ℕ} (hD : Nat.card D = q)
    (hq : 2 ≤ q) (hoddq : Odd q) :
    ∃ d : ↥D, d ≠ 1 ∧ Odd (orderOf (d : H)) := by
  have hDne : D ≠ ⊥ := by
    intro hbot
    rw [hbot, Subgroup.card_bot] at hD
    omega
  obtain ⟨d, hd1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hDne
  have hoddD : Odd (Nat.card D) := by
    rw [hD]
    exact hoddq
  refine ⟨d, hd1, Odd.of_dvd_nat hoddD ?_⟩
  have h := orderOf_dvd_natCard d
  rwa [Subgroup.orderOf_mk] at h

private theorem mem_centralizer_oTwoPrime_of_mem_pCoreOf_of_comm {E : Subgroup H} {m : ℕ}
    (hV : TransferVertexLin E m) {k u : H} (hk : k ∈ oTwoPrime E) (hodd : Odd (orderOf k))
    (hk1 : k ≠ 1) (hu : u ∈ pCoreOf 2 E) (hcomm : k * u = u * k) :
    u ∈ Subgroup.centralizer (oTwoPrime E : Set H) := by
  have hU : blockU (oTwoPrime E) = pCoreOf 2 E := by
    rw [blockU, blockQ, pCoreOf_oTwoPrime E, hV.indec]
  have huU : u ∈ blockU (oTwoPrime E) := by
    rw [hU]
    exact hu
  have hz := mem_blockZ_of_mul_comm_of_odd hV.lin hk hodd hk1 huU hcomm
  rw [blockZ] at hz
  exact (Subgroup.mem_inf.mp hz).2

theorem f112ll_W_eq_bot {L1 L2 S : Subgroup H} {m n : ℕ} (hF : F112HypW L1 L2 S)
    (hm : 2 ≤ m) (hn : 2 ≤ n) (h1 : IsL2Quot m (oTwoQuot ↥L1))
    (h2 : IsL2Quot n (oTwoQuot ↥L2))
    (hV1 : TransferVertexLin (f112saP1' L1 L2 S) m)
    (hV2 : TransferVertexLin (f112saP2' L1 L2 S) n) :
    f112saW L1 L2 S = ⊥ := by
  have hR : Hyp111R L1 L2 S := hyp111R_of_isL2Quot (by omega) (by omega) hF.1 h1 h2
  have hO1 : oTwoRes L1 ≤ oTwoPrime (f112saP1' L1 L2 S) :=
    f112sa_oTwoRes_le_oTwoPrime_P1'_of_isL2Quot hm h1
  have hO2 : oTwoRes L2 ≤ oTwoPrime (f112saP2' L1 L2 S) :=
    f112sa_oTwoRes_le_oTwoPrime_P2'_of_isL2Quot hn h2
  obtain ⟨D1, hD1, hcard1⟩ := f112_exists_torus_X1 hF (by omega) h1
  obtain ⟨D2, hD2, hcard2⟩ := f112_exists_torus_X2 hF (by omega) h2
  have hodd1 : Odd (2 ^ m - 1) :=
    Nat.Even.sub_odd Nat.one_le_two_pow
      (Even.pow_of_ne_zero (a := (2 : ℕ)) even_two (by omega)) odd_one
  have hodd2 : Odd (2 ^ n - 1) :=
    Nat.Even.sub_odd Nat.one_le_two_pow
      (Even.pow_of_ne_zero (a := (2 : ℕ)) even_two (by omega)) odd_one
  obtain ⟨k1, hk1ne, hoddk1⟩ := exists_odd_ne_one_of_torus hcard1 (by
    have h : 4 ≤ 2 ^ m := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ m := Nat.pow_le_pow_right (by norm_num) hm
    omega) hodd1
  obtain ⟨k2, hk2ne, hoddk2⟩ := exists_odd_ne_one_of_torus hcard2 (by
    have h : 4 ≤ 2 ^ n := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
    omega) hodd2
  have hk1X1 : (k1 : H) ∈ f112saX1 L1 L2 S := (hD1 k1.2).1
  have hk1o : (k1 : H) ∈ oTwoRes L1 := by
    have h := hk1X1
    rw [f112saX1] at h
    exact (Subgroup.mem_inf.mp h).1
  have hk1K : (k1 : H) ∈ f112saK L1 L2 S := by
    rw [f112saK]
    exact Subgroup.mem_sup_left hk1X1
  have hk1L : (k1 : H) ∈ oTwoPrime (f112saP1' L1 L2 S) := hO1 hk1o
  have hk2X2 : (k2 : H) ∈ f112saX2 L1 L2 S := (hD2 k2.2).1
  have hk2o : (k2 : H) ∈ oTwoRes L2 := by
    have h := hk2X2
    rw [f112saX2] at h
    exact (Subgroup.mem_inf.mp h).1
  have hk2K : (k2 : H) ∈ f112saK L1 L2 S := by
    rw [f112saK]
    exact Subgroup.mem_sup_right hk2X2
  have hk2L : (k2 : H) ∈ oTwoPrime (f112saP2' L1 L2 S) := hO2 hk2o
  have hP1 : pCoreOf 2 (f112saP1' L1 L2 S) ⊓ Subgroup.centralizer ({(k1 : H)} : Set H) ≤
      Subgroup.centralizer (oTwoRes L1 : Set H) := by
    intro u hu
    obtain ⟨huQ, huC⟩ := Subgroup.mem_inf.mp hu
    have hcomm : (k1 : H) * u = u * (k1 : H) :=
      Subgroup.mem_centralizer_iff.mp huC (k1 : H) (Set.mem_singleton (k1 : H))
    have hcent := mem_centralizer_oTwoPrime_of_mem_pCoreOf_of_comm hV1 hk1L hoddk1
      (fun h => hk1ne (Subtype.ext h)) huQ hcomm
    exact Subgroup.centralizer_le hO1 hcent
  have hP2 : pCoreOf 2 (f112saP2' L1 L2 S) ⊓ Subgroup.centralizer ({(k2 : H)} : Set H) ≤
      Subgroup.centralizer (oTwoRes L2 : Set H) := by
    intro u hu
    obtain ⟨huQ, huC⟩ := Subgroup.mem_inf.mp hu
    have hcomm : (k2 : H) * u = u * (k2 : H) :=
      Subgroup.mem_centralizer_iff.mp huC (k2 : H) (Set.mem_singleton (k2 : H))
    have hcent := mem_centralizer_oTwoPrime_of_mem_pCoreOf_of_comm hV2 hk2L hoddk2
      (fun h => hk2ne (Subtype.ext h)) huQ hcomm
    exact Subgroup.centralizer_le hO2 hcent
  exact f112saW_eq_bot_of_centerOf_inf_centralizer_le_of_hyp111R hF hR hk1K hk2K
    (f112sa_centerOf_inf_centralizer_le_of_pCoreOf_P1'_of_hyp111R hF hR hP1)
    (f112sa_centerOf_inf_centralizer_le_of_pCoreOf_P2'_of_hyp111R hF hR hP2)

theorem f112ll_mem_K_of_vertexLin {L1 L2 S : Subgroup H} {m n : ℕ} (hF : F112HypW L1 L2 S)
    (hm : 2 ≤ m) (hn : 2 ≤ n) (h1 : IsL2Quot m (oTwoQuot ↥L1))
    (h2 : IsL2Quot n (oTwoQuot ↥L2))
    (hV1 : TransferVertexLin (f112saP1' L1 L2 S) m)
    (hV2 : TransferVertexLin (f112saP2' L1 L2 S) n)
    (hT : S ⊓ f112saK L1 L2 S =
      pCoreOf 2 (f112saP1' L1 L2 S) ⊔ pCoreOf 2 (f112saP2' L1 L2 S))
    {c : H} (hcS : c ∈ S)
    (hc : ∀ l ∈ oTwoPrime (f112saP1' L1 L2 S), ⁅c, l⁆ ∈ pCoreOf 2 (f112saP1' L1 L2 S)) :
    c ∈ f112saK L1 L2 S := by
  classical
  let Eα := f112saP1' L1 L2 S
  let Eβ := f112saP2' L1 L2 S
  let Qα := pCoreOf 2 Eα
  let Qβ := pCoreOf 2 Eβ
  let T := S ⊓ f112saK L1 L2 S
  have hR : Hyp111R L1 L2 S := hyp111R_of_isL2Quot (by omega) (by omega) hF.1 h1 h2
  have hW : f112saW L1 L2 S = ⊥ := f112ll_W_eq_bot hF hm hn h1 h2 hV1 hV2
  have hSNα : S ≤ Subgroup.normalizer (Eα : Set H) :=
    ((le_sup_right : S ≤ bigB L1 L2 S).trans
      (le_sup_right : bigB L1 L2 S ≤ f112P1 L1 L2 S)).trans
        (f112sa_P1_le_normalizer_P1' hF)
  have hSNβ : S ≤ Subgroup.normalizer (Eβ : Set H) :=
    ((le_sup_right : S ≤ bigB L1 L2 S).trans
      (le_sup_right : bigB L1 L2 S ≤ f112P2 L1 L2 S)).trans
        (f112sa_P2_le_normalizer_P2' hF)
  have hα : ∀ c ∈ S, (∀ l ∈ oTwoPrime Eα, ⁅c, l⁆ ∈ Qα) → ∀ q ∈ Qα, ⁅c, q⁆ = 1 := by
    intro c hcS' hcL'
    have hc2 : ∃ k, c ^ (2 ^ k) = 1 := by
      obtain ⟨k, hk⟩ := hF.1.h1.pgroup ⟨c, hcS'⟩
      exact ⟨k, by simpa using congrArg (fun x : ↥S => (x : H)) hk⟩
    exact hV1.centralizes_pCoreOf hc2 (hSNα hcS') hcL'
  have hβ₂ : ∀ c ∈ S, (∀ l ∈ oTwoPrime Eβ, ⁅c, l⁆ ∈ Qβ) → ∀ q ∈ Qβ, ⁅c, q⁆ = 1 := by
    intro c hcS' hcL'
    have hc2 : ∃ k, c ^ (2 ^ k) = 1 := by
      obtain ⟨k, hk⟩ := hF.1.h1.pgroup ⟨c, hcS'⟩
      exact ⟨k, by simpa using congrArg (fun x : ↥S => (x : H)) hk⟩
    exact hV2.centralizes_pCoreOf hc2 (hSNβ hcS') hcL'
  have hAleT : Qα ≤ T := by
    rw [show T = Qα ⊔ Qβ from hT]
    exact le_sup_left
  have hAT : Qα ⊔ pCoreOf 2 (oTwoPrime Eβ) = T := by
    rw [pCoreOf_oTwoPrime, ← hT]
  have hβ₁ : ∀ c ∈ S, (∀ q ∈ Qα, ⁅c, q⁆ = 1) →
      ∃ a ∈ T, (∀ q ∈ Qα, ⁅c * a⁻¹, q⁆ = 1) ∧
        ∀ l ∈ oTwoPrime Eβ, ⁅c * a⁻¹, l⁆ ∈ Qβ := by
    intro c hcS' hcQα
    have hcNLβ : c ∈ Subgroup.normalizer (oTwoPrime Eβ : Set H) :=
      mem_normalizer_oTwoPrime (hSNβ hcS')
