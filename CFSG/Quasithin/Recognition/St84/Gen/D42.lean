private theorem nonempty_pCoreOf_parabolic
    {K : Type} [Field K] [Finite K] [CharP K 2] (σ : K ≃+* K)
    (a : Fin TwistTag.D4.foldedTag.rank) :
    Nonempty (↥(pCoreOf 2 ((graphFixedParabolic TwistTag.D4 K σ.toRingHom {a}).subgroupOf
        (graphFixedRootGroup TwistTag.D4 K σ.toRingHom))) ≃*
      ↥(graphFixedParabolicRadical TwistTag.D4 K σ.toRingHom {a})) :=
  ⟨(pCoreOfSubgroupOfEquiv _ _ (graphFixedParabolic_le _ _ _ _)).trans
    (MulEquiv.subgroupCongr
      (CFSG.StandardType.GGOppRadExc.pCoreOf_graphFixedParabolic σ {a}))⟩

theorem y9D42 : Y9D42 := by
  intro G _ _ L1 L2 S hF h1 h2 hA
  have hL1ns : ¬ Group.IsSolvable ↥L1 := not_isSolvable_of_isL2Quot (f := 3) (by norm_num) h1
  have hM1ns : ¬ Group.IsSolvable ↥(L1 ⊔ bigB L1 L2 S) := by
    intro hs
    haveI : Group.IsSolvable ↥(L1 ⊔ bigB L1 L2 S) := hs
    exact hL1ns (Group.isSolvable_of_isSolvable_injective
      (Subgroup.inclusion_injective (le_sup_left : L1 ≤ L1 ⊔ bigB L1 L2 S)))
  obtain ⟨Y, _, hY, T, M₁, M₂, hp, ⟨iso0⟩⟩ := hA
  have hM1ns' : ¬ Group.IsSolvable ↥M₁ := by
    intro hs
    haveI : Group.IsSolvable ↥M₁ := hs
    let e : ↥M₁ ≃* ↥(L1 ⊔ bigB L1 L2 S) := iso0.φ1.symm
    exact hM1ns (Group.isSolvable_of_surjective (f := e.toMonoidHom) e.surjective)
  obtain ⟨hf, K, hField, hFinK, σ, hK, hσq, ⟨eY⟩⟩ :=
    CFSG.Quasithin.H13.F431.D4q.Hex.d4q_model_data hY
  letI : Field K := hField
  letI : Finite K := hFinK
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : CharP K 2 := CFSG.Quasithin.H13.F431.D4q.NFq.charP_two_of_std (f := 1) hf hK
  haveI : Finite (ModGL TwistTag.D4.tag K) := finite_modGL
  have hσ3 : σ.toRingHom ^ 3 = 1 := by
    refine RingHom.ext fun c => ?_
    simpa using CFSG.Quasithin.H13.F431.D4q.NFq.sigma_cube σ hK hσq c
  have h2 : Nat.card ↥(orbitField TwistTag.D4 K σ.toRingHom fa1) = 2 := by
    have h := card_orbitField_D4_orientation Nat.prime_two (f := 1) le_rfl hK
      (r := 1) (Or.inl rfl) (σ := σ.toRingHom) (fun c => by rw [pow_one]; exact hσq c) fa1
    rwa [orbit_card_fa1, pow_one] at h
  letI hP1solv : Group.IsSolvable ↥(Pst1 σ) :=
    (isSolvable_iff_perfectCore_eq_bot _).mpr
      (CFSG.Quasithin.H13.KGInsp4316.Exc.fixed_perfectCore_eq_bot σ fa1
        (CFSG.QuasithinUnique.Vol2Native.L239.Lie.D4.isPGroup_posUnipotent σ hσ3) h2)
  have hstd : CFSG.Quasithin.H13.Sec53F.Yam.YamStd (Cm σ) (Ust σ) (Pst0 σ) (Pst1 σ) :=
    CFSG.Quasithin.H13.F431.D4q.Hex.d4_yamStd σ hf hK hσq
  obtain ⟨c, -, hcase⟩ := hstd.pair eY hp
  let E : Y ≃* Cm σ := eY.trans (MulAut.conj c⁻¹)
  have hcase1 : M₁.map eY.toMonoidHom = (Pst0 σ).map (MulAut.conj c).toMonoidHom ∧
      M₂.map eY.toMonoidHom = (Pst1 σ).map (MulAut.conj c).toMonoidHom := by
    rcases hcase with h | h
    · exact h
    · exfalso
      have h1' : M₁.map E.toMonoidHom = Pst1 σ := by
        calc M₁.map E.toMonoidHom =
            (M₁.map eY.toMonoidHom).map (MulAut.conj c⁻¹).toMonoidHom := by
              rw [Subgroup.map_map]
              rfl
          _ = ((Pst1 σ).map (MulAut.conj c).toMonoidHom).map
                (MulAut.conj c⁻¹).toMonoidHom := by rw [h.1]
          _ = Pst1 σ := map_conj_conj_inv (Pst1 σ) c
      haveI : Group.IsSolvable ↥(M₁.map E.toMonoidHom) := by rwa [h1']
      exact hM1ns' (Group.isSolvable_of_isSolvable_injective
        (f := (M₁.equivMapOfInjective E.toMonoidHom E.injective).toMonoidHom)
        (M₁.equivMapOfInjective E.toMonoidHom E.injective).injective)
  have hM1eq : M₁.map E.toMonoidHom = Pst0 σ := by
    calc M₁.map E.toMonoidHom =
        (M₁.map eY.toMonoidHom).map (MulAut.conj c⁻¹).toMonoidHom := by
          rw [Subgroup.map_map]
          rfl
      _ = ((Pst0 σ).map (MulAut.conj c).toMonoidHom).map
            (MulAut.conj c⁻¹).toMonoidHom := by rw [hcase1.1]
      _ = Pst0 σ := map_conj_conj_inv (Pst0 σ) c
  have hM2eq : M₂.map E.toMonoidHom = Pst1 σ := by
    calc M₂.map E.toMonoidHom =
        (M₂.map eY.toMonoidHom).map (MulAut.conj c⁻¹).toMonoidHom := by
          rw [Subgroup.map_map]
          rfl
      _ = ((Pst1 σ).map (MulAut.conj c).toMonoidHom).map
            (MulAut.conj c⁻¹).toMonoidHom := by rw [hcase1.2]
      _ = Pst1 σ := map_conj_conj_inv (Pst1 σ) c
  have hQ0 : ↥(pCoreOf 2 (L1 ⊔ bigB L1 L2 S)) ≃* ↥(Q0 σ) :=
    (pCoreOfMulEquiv iso0.φ1 2).trans
      ((pCoreOfMulEquiv (M₁.equivMapOfInjective E.toMonoidHom E.injective) 2).trans
        ((MulEquiv.subgroupCongr (congrArg (pCoreOf 2) hM1eq)).trans
          (nonempty_pCoreOf_parabolic σ fa0).some))
  have hQ1 : ↥(pCoreOf 2 (L2 ⊔ bigB L1 L2 S)) ≃* ↥(Q1 σ) :=
    (pCoreOfMulEquiv iso0.φ2 2).trans
      ((pCoreOfMulEquiv (M₂.equivMapOfInjective E.toMonoidHom E.injective) 2).trans
        ((MulEquiv.subgroupCongr (congrArg (pCoreOf 2) hM2eq)).trans
          (nonempty_pCoreOf_parabolic σ fa1).some))
  have hspecial : IsSpecialPow 2 (2 ^ 1) 4 ↥(pCoreOf 2 (L1 ⊔ bigB L1 L2 S)) :=
    IsSpecialPow.of_mulEquiv hQ0.symm (isSpecialPow_d4Q0 σ (f := 1) (by norm_num) hK hσq)
  have hcard : Nat.card (pCoreOf 2 (L2 ⊔ bigB L1 L2 S)) = (2 ^ 1) ^ 11 := by
    rw [Nat.card_congr hQ1.toEquiv]
    exact card_d4Q1 σ (f := 1) (by norm_num) hK hσq
  have hR : Hyp111R L1 L2 S := Hyp111R.of_hyp111 rankOneListedFacts hF.1
  have hO1N : L1 ≤ Subgroup.normalizer (pCoreOf 2 L1 : Set G) := le_normalizer_pCoreOf 2 L1
  have hQS : pCoreOf 2 (L1 ⊔ bigB L1 L2 S) ≤ S :=
    F7.isSylowTwoOf_pCoreOf_le (F112W.isSylowTwoOf_parabolic hR)
  have hB1 : bigB L1 L2 S ≤ Subgroup.normalizer (L1 : Set G) :=
    (bigB_le_normalizer hF.1).1
  have hOQ : pCoreOf 2 L1 ≤ pCoreOf 2 (L1 ⊔ bigB L1 L2 S) :=
    le_pCoreOf_of_le_normalizer 2 ((pCoreOf_le 2 L1).trans le_sup_left)
      (sup_le hO1N (hB1.trans (normalizer_le_normalizer_pCoreOf 2 L1)))
      (pCoreOf_isPGroup 2 L1)
  have hLQ : L1 ≤ Subgroup.normalizer (pCoreOf 2 (L1 ⊔ bigB L1 L2 S) : Set G) :=
    le_sup_left.trans (le_normalizer_pCoreOf 2 _)
  have hZQ : Nat.card ↥(Subgroup.center ↥(pCoreOf 2 (L1 ⊔ bigB L1 L2 S))) = 2 ^ 1 :=
    hspecial.2.2
  have hZL : L1 ≤ Subgroup.centralizer
      (centerOf (pCoreOf 2 (L1 ⊔ bigB L1 L2 S)) : Set G) := by
    refine CFSG.Quasithin.H13.le_centralizer_of_isL2Quot (n := 3) (f := 1)
      (by norm_num) (by norm_num) h1 (by rw [CFSG.Quasithin.H13.card_centerOf_eq, hZQ])
      (hLQ.trans (CFSG.Quasithin.A4.normalizer_le_normalizer_centerOf _)) ?_
    intro o ho
    rw [Subgroup.mem_centralizer_iff]
    intro q hq
    exact (Subgroup.mem_centralizer_iff.mp (Subgroup.mem_inf.mp hq).2 o (hOQ ho)).symm
  exact ⟨fun _ => CFSG.Quasithin.H13.centerOf_le_centralizer_of_hyp111 hR hQS hOQ hLQ hZL,
    hspecial, hcard⟩

