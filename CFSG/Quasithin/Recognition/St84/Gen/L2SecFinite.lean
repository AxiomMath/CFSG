variable {G : Type} [Group G] {V Z L : Subgroup G}

private theorem l2SecFin_isElemSec (hsec : IsElemSec Z V) :
    IsElemSec (Z.subgroupOf L) (V.subgroupOf L) := by
  refine ⟨fun x hx => Subgroup.mem_subgroupOf.mpr (hsec.1 (Subgroup.mem_subgroupOf.mp hx)),
    ?_, ?_⟩
  · rw [Subgroup.commutator_le]
    intro x hx y hy
    have h1 := (Subgroup.commutator_le.mp hsec.2.1) (x : G) (Subgroup.mem_subgroupOf.mp hx)
      (y : G) (Subgroup.mem_subgroupOf.mp hy)
    have hcoe : ((⁅x, y⁆ : ↥L) : G) = ⁅(x : G), (y : G)⁆ :=
      map_commutatorElement (f := L.subtype) (g₁ := x) (g₂ := y)
    exact Subgroup.mem_subgroupOf.mpr (by rw [hcoe]; exact h1)
  · intro x hx
    have h1 := hsec.2.2 (x : G) (Subgroup.mem_subgroupOf.mp hx)
    exact Subgroup.mem_subgroupOf.mpr (by simpa [map_pow] using h1)

private theorem l2SecFin_normalizer (hVL : V ≤ L) (hZV : Z ≤ V)
    (hL : L ≤ Subgroup.normalizer (V : Set G) ⊓ Subgroup.normalizer (Z : Set G)) :
    L.subgroupOf L ≤ Subgroup.normalizer ((V.subgroupOf L : Subgroup ↥L) : Set ↥L) ⊓
      Subgroup.normalizer ((Z.subgroupOf L : Subgroup ↥L) : Set ↥L) :=
  le_inf ((le_top : L.subgroupOf L ≤ ⊤).trans
      (le_normalizer_subgroupOf_of_le_normalizer hVL (hL.trans inf_le_left)))
    ((le_top : L.subgroupOf L ≤ ⊤).trans
      (le_normalizer_subgroupOf_of_le_normalizer (hZV.trans hVL) (hL.trans inf_le_right)))

private theorem l2SecFin_core (hQ : ∀ p ∈ pCoreOf 2 L, ∀ v ∈ V, ⁅p, v⁆ ∈ Z) :
    ∀ p ∈ pCoreOf 2 (L.subgroupOf L), ∀ v ∈ V.subgroupOf L, ⁅p, v⁆ ∈ Z.subgroupOf L := by
  intro p hp v hv
  have hpL : (p : G) ∈ pCoreOf 2 L := by
    have hmem := Subgroup.mem_map_of_mem (f := L.subtype) hp
    rwa [CFSG.Quasithin.Vol2.Ch10.SecB.KRP.map_pCoreOf_subgroupOf le_rfl] at hmem
  have hcoe : ((⁅p, v⁆ : ↥L) : G) = ⁅(p : G), (v : G)⁆ :=
    map_commutatorElement (f := L.subtype) (g₁ := p) (g₂ := v)
  exact Subgroup.mem_subgroupOf.mpr
    (by rw [hcoe]; exact hQ (p : G) hpL (v : G) (Subgroup.mem_subgroupOf.mp hv))

private theorem l2SecFin_nt (hVL : V ≤ L) (hnt : ∃ l ∈ L, ∃ v ∈ V, ⁅l, v⁆ ∉ Z) :
    ∃ l ∈ L.subgroupOf L, ∃ v ∈ V.subgroupOf L, ⁅l, v⁆ ∉ Z.subgroupOf L := by
  obtain ⟨l, hl, v, hv, hne⟩ := hnt
  refine ⟨⟨l, hl⟩, Subgroup.mem_subgroupOf.mpr hl, ⟨v, hVL hv⟩,
    Subgroup.mem_subgroupOf.mpr hv, fun hmem => hne ?_⟩
  have hcoe : ((⁅(⟨l, hl⟩ : ↥L), (⟨v, hVL hv⟩ : ↥L)⁆ : ↥L) : G) = ⁅l, v⁆ := rfl
  have hmem' := Subgroup.mem_subgroupOf.mp hmem
  rwa [hcoe] at hmem'

private theorem l2SecFin_quot {m : ℕ} (hquot : IsL2Quot m (oTwoQuot ↥L)) :
    IsL2Quot m (oTwoQuot ↥(L.subgroupOf L)) := by
  obtain ⟨e⟩ := hquot
  exact ⟨(CFSG.Quasithin.F112R.oTwoQuotCongr (Subgroup.subgroupOfEquivOfLe le_rfl)).trans e⟩

theorem two_pow_le_relIndex_of_nontrivial_of_le [Finite ↥L] {m : ℕ} (hm : 1 ≤ m)
    (hquot : IsL2Quot m (oTwoQuot ↥L)) (hVL : V ≤ L) (hsec : IsElemSec Z V)
    (hL : L ≤ Subgroup.normalizer (V : Set G) ⊓ Subgroup.normalizer (Z : Set G))
    (hQ : ∀ p ∈ pCoreOf 2 L, ∀ v ∈ V, ⁅p, v⁆ ∈ Z)
    (hnt : ∃ l ∈ L, ∃ v ∈ V, ⁅l, v⁆ ∉ Z) : 2 ^ (2 * m) ≤ Z.relIndex V := by
  have h := two_pow_le_relIndex_of_nontrivial (G := ↥L) hm (l2SecFin_quot hquot)
    (l2SecFin_isElemSec hsec) (l2SecFin_normalizer hVL hsec.1 hL) (l2SecFin_core hQ)
    (l2SecFin_nt hVL hnt)
  rwa [Subgroup.relIndex_subgroupOf hVL] at h

theorem eq_three_mul_of_irreducible_of_relIndex_of_le [Finite ↥L] {m r : ℕ} (hr : 0 < r)
    (hrm : r < m) (hquot : IsL2Quot m (oTwoQuot ↥L)) (hVL : V ≤ L) (hVZ : Z ≤ V)
    (hsec : IsElemSec Z V)
    (hL : L ≤ Subgroup.normalizer (V : Set G) ⊓ Subgroup.normalizer (Z : Set G))
    (hirr : ∀ W : Subgroup G, Z ≤ W → W ≤ V → L ≤ Subgroup.normalizer (W : Set G) →
      W = Z ∨ W = V)
    (hnt : ∃ l ∈ L, ∃ v ∈ V, ⁅l, v⁆ ∉ Z)
    (hcard : Z.relIndex V = 2 ^ (2 * m + 2 * r)) : m = 3 * r := by
  have hirr' : ∀ W' : Subgroup ↥L, Z.subgroupOf L ≤ W' → W' ≤ V.subgroupOf L →
      L.subgroupOf L ≤ Subgroup.normalizer (W' : Set ↥L) →
      W' = Z.subgroupOf L ∨ W' = V.subgroupOf L := by
    intro W' hZW hWV hLW
    have hZW' : Z ≤ W'.map L.subtype := fun z hz =>
      ⟨⟨z, hVL (hVZ hz)⟩, hZW (Subgroup.mem_subgroupOf.mpr hz), rfl⟩
    have hWV' : W'.map L.subtype ≤ V := by
      rintro _ ⟨w, hw, rfl⟩
      exact Subgroup.mem_subgroupOf.mp (hWV hw)
    have hLW' : L ≤ Subgroup.normalizer ((W'.map L.subtype : Subgroup G) : Set G) := by
      intro l hl
      have hlN := hLW (Subgroup.mem_subgroupOf.mpr hl : (⟨l, hl⟩ : ↥L) ∈ L.subgroupOf L)
      rw [Subgroup.mem_normalizer_iff]
      intro x
      constructor
      · rintro ⟨w, hw, rfl⟩
        exact ⟨⟨l, hl⟩ * w * (⟨l, hl⟩ : ↥L)⁻¹,
          (Subgroup.mem_normalizer_iff.mp hlN w).mp hw, rfl⟩
      · rintro ⟨w, hw, hwx⟩
        have hxL : x ∈ L := by
          have : x = l⁻¹ * (L.subtype w) * l := by rw [hwx]; group
          rw [this]
          exact L.mul_mem (L.mul_mem (L.inv_mem hl) w.2) hl
        refine ⟨⟨x, hxL⟩, (Subgroup.mem_normalizer_iff.mp hlN ⟨x, hxL⟩).mpr ?_, rfl⟩
        have hw' : (⟨l, hl⟩ : ↥L) * ⟨x, hxL⟩ * (⟨l, hl⟩ : ↥L)⁻¹ = w := Subtype.ext hwx.symm
        rw [hw']
        exact hw
    have hcomap : ∀ A : Subgroup G, W'.map L.subtype = A → W' = A.subgroupOf L := by
      intro A hA
      rw [← hA, Subgroup.subgroupOf, Subgroup.comap_map_eq_self_of_injective L.subtype_injective]
    rcases hirr _ hZW' hWV' hLW' with h | h
    · exact Or.inl (hcomap Z h)
    · exact Or.inr (hcomap V h)
  have hcard' : (Z.subgroupOf L).relIndex (V.subgroupOf L) = 2 ^ (2 * m + 2 * r) := by
    rw [Subgroup.relIndex_subgroupOf hVL, hcard]
  exact eq_three_mul_of_irreducible_of_relIndex (G := ↥L) hr hrm (l2SecFin_quot hquot)
    (fun x hx => Subgroup.mem_subgroupOf.mpr (hVZ (Subgroup.mem_subgroupOf.mp hx)))
    (l2SecFin_isElemSec hsec) (l2SecFin_normalizer hVL hVZ hL) hirr' (l2SecFin_nt hVL hnt) hcard'

