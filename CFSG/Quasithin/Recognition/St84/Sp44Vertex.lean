      rw [← h2]
      exact Subgroup.mem_subgroupOf.mp hs
    · intro hz
      exact Subgroup.mem_map.mpr ⟨z, Subgroup.mem_subgroupOf.mpr hz, rfl⟩
  have hS₁card : Nat.card ↥S₁ = 2 ^ 8 := by
    have hinj1 : Function.Injective
        ((Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄))).subtype.comp ψ₀.toMonoidHom) := by
      intro a b hab
      exact ψ₀.injective (Subtype.ext hab)
    rw [Subgroup.card_map_of_injective hinj1,
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe h.sylP.1).toEquiv, h.card_S]
  have hS₁p : IsPGroup 2 S₁ := IsPGroup.iff_card.mpr ⟨8, hS₁card⟩
  have hNcard : Nat.card ↥(Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄))) = 11520 := by
    rw [← Nat.card_congr ψ₀.toEquiv]
    exact card_parabolic h
  have hS₁sylow : IsSylowTwoOf S₁ (Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄))) := by
    refine ⟨hS₁le, hS₁p, ?_⟩
    intro h2
    have h1 := Subgroup.index_mul_card (H := S₁.subgroupOf
      (Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄))))
    have hc : Nat.card ↥(S₁.subgroupOf
        (Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄)))) = 256 := by
      rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hS₁le).toEquiv, hS₁card]
      norm_num
    rw [hc, hNcard] at h1
    obtain ⟨c, hc2⟩ := h2
    rw [hc2] at h1
    omega
  have hU_N : antiUnipotent F₄ ≤ Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄)) := by
    intro u hu
    obtain ⟨a, b, c, d, rfl⟩ := hu
    rw [Subgroup.mem_normalizer_iff]
    intro x
    constructor
    · intro hx
      exact conj_mem_radA2 (firstCol_uElt a b c d) hx
    · intro hx
      have h1 := conj_mem_radA2 (firstCol_uElt a b c d).inv hx
      simpa [mul_assoc] using h1
  have hUcard : Nat.card (antiUnipotent F₄) = 2 ^ 8 := by
    rw [(card_radicals (K := F₄)).1, card_galoisField_two_two]
    norm_num
  have hUsylow : IsSylowTwoOf (antiUnipotent F₄)
      (Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄))) := by
    refine ⟨hU_N, IsPGroup.iff_card.mpr ⟨8, hUcard⟩, ?_⟩
    intro h2
    have h1 := Subgroup.index_mul_card (H := (antiUnipotent F₄).subgroupOf
      (Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄))))
    have hc : Nat.card ↥((antiUnipotent F₄).subgroupOf
        (Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄)))) = 256 := by
      rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hU_N).toEquiv, hUcard]
      norm_num
    rw [hc, hNcard] at h1
    obtain ⟨c, hc2⟩ := h2
    rw [hc2] at h1
    omega
  obtain ⟨g, hgN, hgeq⟩ := IsSylowTwoOf.exists_conj hS₁sylow hUsylow
  let gN : ↥(Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄))) := ⟨g, hgN⟩
  let ψ : ↥P ≃* ↥(Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄))) :=
    ψ₀.trans (MulAut.conj gN)
  have hψval : ∀ z : ↥P, (ψ z : antiSp F₄) = g * (ψ₀ z : antiSp F₄) * g⁻¹ := by
    intro z
    show (((MulAut.conj gN) (ψ₀ z) : ↥(Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄)))) :
      antiSp F₄) = g * (ψ₀ z : antiSp F₄) * g⁻¹
    rw [MulAut.conj_apply]
    rfl
  have hS_clause : ∀ z : ↥P, (z : G) ∈ S ↔ (ψ z : antiSp F₄) ∈ antiUnipotent F₄ := by
    intro z
    rw [hψval z, hgeq]
    constructor
    · intro hmem
      exact Subgroup.mem_map.mpr
        ⟨ψ₀ z, (hS₁mem z).mpr hmem, MulAut.conj_apply g (ψ₀ z)⟩
    · intro hmem
      refine (hS₁mem z).mp ?_
      obtain ⟨s, hs, hgs⟩ := Subgroup.mem_map.mp hmem
      have h2 : s = ψ₀ z :=
        (MulAut.conj g).injective (hgs.trans (MulAut.conj_apply g (ψ₀ z)).symm)
      rwa [h2] at hs
  have hconj_radA2 : ∀ x : antiSp F₄, x ∈ radA2 F₄ ↔ g * x * g⁻¹ ∈ radA2 F₄ := by
    intro x
    constructor
    · intro hx
      exact (Subgroup.mem_normalizer_iff.mp hgN x).mp hx
    · intro hx
      have h1 := (Subgroup.mem_normalizer_iff.mp
        ((Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄))).inv_mem hgN)
        (g * x * g⁻¹)).mp hx
      simpa [mul_assoc] using h1
  have hQ_clause : ∀ z : ↥P, (z : G) ∈ pCoreOf 2 L ↔ (ψ z : antiSp F₄) ∈ radA2 F₄ := by
    intro z
    rw [hψval z, ← hconj_radA2]
    exact hψ₀_Qmem z
  have hconj_C : ∀ x : antiSp F₄,
      x ∈ Subgroup.centralizer (rootU₂ F₄ : Set (antiSp F₄)) ↔
      g * x * g⁻¹ ∈ Subgroup.centralizer (rootU₂ F₄ : Set (antiSp F₄)) := by
    intro x
    have hgU : g ∈ Subgroup.normalizer (rootU₂ F₄ : Set (antiSp F₄)) := by rwa [hS2.N_eq]
    constructor
    · intro hx
      rw [Subgroup.mem_centralizer_iff] at hx ⊢
      intro y hy
      have hy' : g⁻¹ * y * g ∈ rootU₂ F₄ :=
        (Subgroup.mem_normalizer_iff.mp
          ((Subgroup.normalizer (rootU₂ F₄ : Set (antiSp F₄))).inv_mem hgU) y).mp hy
      calc y * (g * x * g⁻¹) = g * ((g⁻¹ * y * g) * x) * g⁻¹ := by group
        _ = g * (x * (g⁻¹ * y * g)) * g⁻¹ := by rw [hx (g⁻¹ * y * g) hy']
        _ = (g * x * g⁻¹) * y := by group
    · intro hx
      rw [Subgroup.mem_centralizer_iff] at hx ⊢
      intro y hy
      have hy' : g * y * g⁻¹ ∈ rootU₂ F₄ := (Subgroup.mem_normalizer_iff.mp hgU y).mp hy
      calc y * x = g⁻¹ * ((g * y * g⁻¹) * (g * x * g⁻¹)) * g := by group
        _ = g⁻¹ * ((g * x * g⁻¹) * (g * y * g⁻¹)) * g := by rw [hx (g * y * g⁻¹) hy']
        _ = x * y := by group
  have hL_clause : ∀ z : ↥P, (z : G) ∈ L ↔
      (ψ z : antiSp F₄) ∈ Subgroup.centralizer (rootU₂ F₄ : Set (antiSp F₄)) := by
    intro z
    rw [hψval z, ← hconj_C]
    exact hψ₀_Lmem z
  exact ⟨ψ, hS_clause, hQ_clause, hL_clause,
    fun z => L34Loc.normalizer_transport h.sylP.1 hUsylow.1 ψ hS_clause z⟩


theorem Sp44Side.exists_vertexIso_one [Finite G]
    {L P S Q' : Subgroup G} (h : Sp44Side L P S Q') :
    ∃ ψ : ↥P ≃* ↥(Subgroup.normalizer (radA1 (GaloisField 2 2) : Set (antiSp (GaloisField 2 2)))),
      (∀ z : ↥P, (z : G) ∈ S ↔ (ψ z : antiSp (GaloisField 2 2)) ∈ antiUnipotent (GaloisField 2 2)) ∧
      (∀ z : ↥P, (z : G) ∈ pCoreOf 2 L ↔
        (ψ z : antiSp (GaloisField 2 2)) ∈ radA1 (GaloisField 2 2)) ∧
      (∀ z : ↥P, (z : G) ∈ L ↔
        (ψ z : antiSp (GaloisField 2 2)) ∈
          Subgroup.centralizer (rootU₁ (GaloisField 2 2) : Set (antiSp (GaloisField 2 2)))) ∧
      (∀ z : ↥P, (z : G) ∈ Subgroup.normalizer (S : Set G) ↔
        (ψ z : antiSp (GaloisField 2 2)) ∈
          Subgroup.normalizer (antiUnipotent (GaloisField 2 2) : Set (antiSp (GaloisField 2 2)))) := by
  classical
  obtain ⟨ψ₀, hS, hQ, hL, hN⟩ := h.exists_vertexIso
  have hmem : ∀ x : antiSp F₄,
      x ∈ Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄)) ↔
      minorAut F₄ x ∈ Subgroup.normalizer (radA1 F₄ : Set (antiSp F₄)) := by
    intro x
    rw [radA1_eq_map, mem_normalizer_map]
    simp
  let e : ↥(Subgroup.normalizer (radA2 F₄ : Set (antiSp F₄))) ≃*
      ↥(Subgroup.normalizer (radA1 F₄ : Set (antiSp F₄))) :=
    subgroupEquiv (minorAut F₄) hmem
  have hmapU : (antiUnipotent F₄).map (minorAut F₄).toMonoidHom = antiUnipotent F₄ := by
    simpa using CFSG.Quasithin.SteinbergBS.map_minorAut_pow_antiUnipotent (F := F₄) 1
  have hU : ∀ x : antiSp F₄, (minorAut F₄ x ∈ antiUnipotent F₄ ↔ x ∈ antiUnipotent F₄) := by
    intro x
    have h1 : (minorAut F₄ x ∈ (antiUnipotent F₄).map (minorAut F₄).toMonoidHom ↔
        x ∈ antiUnipotent F₄) := by
      rw [Subgroup.mem_map_equiv, MulEquiv.symm_apply_apply]
    rwa [hmapU] at h1
  have hA : ∀ x : antiSp F₄, (minorAut F₄ x ∈ radA1 F₄ ↔ x ∈ radA2 F₄) := by
    intro x
    rw [radA1_eq_map, Subgroup.mem_map_equiv, MulEquiv.symm_apply_apply]
  have hC : ∀ x : antiSp F₄,
      (minorAut F₄ x ∈ Subgroup.centralizer (rootU₁ F₄ : Set (antiSp F₄)) ↔
       x ∈ Subgroup.centralizer (rootU₂ F₄ : Set (antiSp F₄))) := by
    intro x
    rw [rootU₁_eq_map, mem_centralizer_map, MulEquiv.symm_apply_apply]
  have hN' : ∀ x : antiSp F₄,
      (minorAut F₄ x ∈ Subgroup.normalizer (antiUnipotent F₄ : Set (antiSp F₄)) ↔
       x ∈ Subgroup.normalizer (antiUnipotent F₄ : Set (antiSp F₄))) := by
    intro x
    have h1 : (minorAut F₄ x ∈ Subgroup.normalizer
        ((antiUnipotent F₄).map (minorAut F₄).toMonoidHom : Set (antiSp F₄)) ↔
        x ∈ Subgroup.normalizer (antiUnipotent F₄ : Set (antiSp F₄))) := by
      rw [mem_normalizer_map, MulEquiv.symm_apply_apply]
    rwa [hmapU] at h1
  refine ⟨ψ₀.trans e, ?_, ?_, ?_, ?_⟩
  · intro z
    show (z : G) ∈ S ↔ minorAut F₄ (ψ₀ z : antiSp F₄) ∈ antiUnipotent F₄
    rw [hU]
    exact hS z
  · intro z
    show (z : G) ∈ pCoreOf 2 L ↔ minorAut F₄ (ψ₀ z : antiSp F₄) ∈ radA1 F₄
    rw [hA]
    exact hQ z
  · intro z
    show (z : G) ∈ L ↔
      minorAut F₄ (ψ₀ z : antiSp F₄) ∈ Subgroup.centralizer (rootU₁ F₄ : Set (antiSp F₄))
    rw [hC]
    exact hL z
  · intro z
    show (z : G) ∈ Subgroup.normalizer (S : Set G) ↔
      minorAut F₄ (ψ₀ z : antiSp F₄) ∈
        Subgroup.normalizer (antiUnipotent F₄ : Set (antiSp F₄))
    rw [hN']
    exact hN z

end Sp44

