theorem card_galoisField_two_two : Nat.card F₄ = 2 ^ 2 :=
  GaloisField.card (p := 2) (n := 2) (by norm_num)

theorem card_units_galoisField : Nat.card F₄ˣ = 3 := by
  have h : Nat.card F₄ = 4 := by rw [card_galoisField_two_two]; norm_num
  rw [Nat.card_units, h]

theorem card_inf_centralizer [Finite G] {L P S Q' : Subgroup G} (h : Sp44Side L P S Q') {τ : G}
    (hdec : ∀ x ∈ L, ∃ q ∈ pCoreOf 2 L,
      ∃ k ∈ L ⊓ Subgroup.centralizer ({τ} : Set G), q * k = x)
    (hKQ : (L ⊓ Subgroup.centralizer ({τ} : Set G)) ⊓ pCoreOf 2 L = ⊥) :
    Nat.card ↥(L ⊓ Subgroup.centralizer ({τ} : Set G)) = 60 := by
  have hQleL : pCoreOf 2 L ≤ L := CFSG.LieType.BorelTits.pCoreOf_le 2 L
  have hQn : L ≤ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
    CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 L
  have hLQK : L = pCoreOf 2 L ⊔ (L ⊓ Subgroup.centralizer ({τ} : Set G)) := by
    refine le_antisymm ?_ (sup_le hQleL inf_le_left)
    intro x hx
    obtain ⟨q, hq, k, hk, rfl⟩ := hdec x hx
    exact Subgroup.mul_mem_sup hq hk
  have h1 := CFSG.GroupTheory.CoprimeActionSupport.NormalSubgroupSylowJoin.card_sup_mul_card_inf
    (H := L ⊓ Subgroup.centralizer ({τ} : Set G)) (K := pCoreOf 2 L) (inf_le_left.trans hQn)
  rw [sup_comm, ← hLQK, hKQ, Subgroup.card_bot, card_vertex h, h.card] at h1
  norm_num at h1 ⊢
  omega

theorem zpowers_inf_eq_bot {L : Subgroup G} {τ : G} (hτ3 : orderOf τ = 3)
    (hτL : τ ∉ L) : Subgroup.zpowers τ ⊓ L = ⊥ := by
  rw [eq_bot_iff]
  intro y hy
  obtain ⟨hyz, hyL⟩ := Subgroup.mem_inf.mp hy
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hyz
  rw [Subgroup.mem_bot]
  have hz3 : τ ^ k = τ ^ (k % 3) := by
    rw [← zpow_mod_orderOf τ k, show (orderOf τ : ℤ) = 3 from by rw [hτ3]; norm_num]
  have hmem : τ ^ (k % 3) ∈ L := by rw [← hz3]; exact hyL
  have h1 : k % 3 ≠ 1 := by
    intro h
    apply hτL
    have h' : τ ^ (k % 3) = τ := by rw [h]; simp
    rwa [h'] at hmem
  have h2 : k % 3 ≠ 2 := by
    intro h
    apply hτL
    have h' : τ ^ (k % 3) = τ ^ (2 : ℤ) := by rw [h]
    rw [h'] at hmem
    have h3 : (τ ^ (2 : ℤ)) ^ 2 ∈ L := L.pow_mem hmem 2
    have h4 : (τ ^ (2 : ℤ)) ^ 2 = τ := by
      have h0 : τ ^ 3 = 1 := by rw [← hτ3]; exact pow_orderOf_eq_one τ
      have h2' : τ ^ (2 : ℤ) = τ ^ 2 := by simp
      rw [h2', ← pow_mul, show 2 * 2 = 3 + 1 by norm_num, pow_add, pow_one, h0, one_mul]
    rwa [h4] at h3
  have hkm : k % 3 = 0 := by omega
  rw [hz3, hkm]
  simp

theorem zpowers_dElt_eq_range {ν : F₄ˣ} (hν3 : ν ^ 3 = 1) (hν1 : ν ≠ 1) :
    Subgroup.zpowers (dElt (K := F₄) ν) = (dHom₂ F₄).range := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hνord : orderOf ν = 3 := orderOf_eq_prime hν3 hν1
  have htop : Subgroup.zpowers ν = ⊤ :=
    zpowers_eq_top_of_prime_card (p := 3) card_units_galoisField hν1
  have hmap : Subgroup.map (dHom₂ F₄) (Subgroup.zpowers ν) =
      Subgroup.zpowers (dElt (K := F₄) ν) := by
    rw [MonoidHom.map_zpowers]
    rfl
  rw [← hmap, htop, MonoidHom.range_eq_map]

theorem range_sHom₂_inf_radA2
    (hS2 : RootAxisStructure (rootU₂ F₄) (radA2 F₄) (sHom₂ F₄) (dHom₂ F₄)
      (fun c => uElt 0 0 c 0) vecOf₂) :
    (sHom₂ F₄).range ⊓ radA2 F₄ = ⊥ := by
  rw [eq_bot_iff]
  intro z hz
  obtain ⟨hzR, hzA⟩ := Subgroup.mem_inf.mp hz
  obtain ⟨M, hM⟩ := hzR
  have hM' : sElt M = z := by rw [← sHom₂_apply]; exact hM
  have h1 : z * sElt (1 : SL₂ F₄) = (1 : antiSp F₄) * sElt M := by
    rw [show sElt (1 : SL₂ F₄) = 1 from map_one (sHom₂ F₄), mul_one, one_mul, ← hM']
  obtain ⟨h2, -⟩ := hS2.C_unique z hzA 1 (radA2 F₄).one_mem 1 M h1
  rw [Subgroup.mem_bot]
  exact h2

theorem zpowers_dElt_inf_centralizer
    (hS2 : RootAxisStructure (rootU₂ F₄) (radA2 F₄) (sHom₂ F₄) (dHom₂ F₄)
      (fun c => uElt 0 0 c 0) vecOf₂)
    {ν : F₄ˣ} (hν3 : ν ^ 3 = 1) (hν1 : ν ≠ 1) :
    Subgroup.zpowers (dElt (K := F₄) ν) ⊓
      Subgroup.centralizer (rootU₂ F₄ : Set (antiSp F₄)) = ⊥ := by
  rw [eq_bot_iff]
  intro z hz
  obtain ⟨hzD, hzC⟩ := Subgroup.mem_inf.mp hz
  rw [zpowers_dElt_eq_range hν3 hν1] at hzD
  obtain ⟨l, hl⟩ := hzD
  have hl' : dElt l = z := by rw [← dHom₂_apply]; exact hl
  obtain ⟨a, ha, M, hM⟩ := hS2.C_decomp z hzC
  have hM' : a * sElt M = z := by rw [← sHom₂_apply]; exact hM.symm
  have h1 : a * (dElt (1 : F₄ˣ) * sElt M) = (1 : antiSp F₄) * (dElt l * sElt 1) := by
    rw [show sElt (1 : SL₂ F₄) = 1 from map_one (sHom₂ F₄), dElt_one, mul_one, one_mul,
      one_mul, hM', hl']
  obtain ⟨-, hl1, -⟩ := hS2.N_unique a ha 1 (radA2 F₄).one_mem 1 l M 1 h1
  rw [Subgroup.mem_bot, ← hl', ← hl1, dElt_one]

theorem Sp44Side.exists_vertexIso [Finite G]
    {L P S Q' : Subgroup G} (h : Sp44Side L P S Q') :
    ∃ ψ : ↥P ≃* ↥(Subgroup.normalizer (radA2 (GaloisField 2 2) : Set (antiSp (GaloisField 2 2)))),
      (∀ z : ↥P, (z : G) ∈ S ↔ (ψ z : antiSp (GaloisField 2 2)) ∈ antiUnipotent (GaloisField 2 2)) ∧
      (∀ z : ↥P, (z : G) ∈ pCoreOf 2 L ↔
        (ψ z : antiSp (GaloisField 2 2)) ∈ radA2 (GaloisField 2 2)) ∧
      (∀ z : ↥P, (z : G) ∈ L ↔
        (ψ z : antiSp (GaloisField 2 2)) ∈
          Subgroup.centralizer (rootU₂ (GaloisField 2 2) : Set (antiSp (GaloisField 2 2)))) ∧
      (∀ z : ↥P, (z : G) ∈ Subgroup.normalizer (S : Set G) ↔
        (ψ z : antiSp (GaloisField 2 2)) ∈
          Subgroup.normalizer (antiUnipotent (GaloisField 2 2) : Set (antiSp (GaloisField 2 2)))) := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hF4 : Fintype.card F₄ = 4 := by
    rw [← Nat.card_eq_fintype_card, card_galoisField_two_two]
    norm_num
  have hS2 : RootAxisStructure (rootU₂ F₄) (radA2 F₄) (sHom₂ F₄) (dHom₂ F₄)
      (fun c => uElt 0 0 c 0) vecOf₂ :=
    rootAxisStructure_two (K := F₄) (by rw [card_galoisField_two_two]; norm_num)
  obtain ⟨α₀, β₀, hframe⟩ :=
    natFrame_of_natSec h.quot h.elem h.center_le h.relIndex_center h.nat
  have hαsurj : Function.Surjective α₀ := hframe.1
  have hαker : α₀.ker = CFSG.pCore 2 ↥L := hframe.2.1
  have hβsurj : Function.Surjective β₀ := hframe.2.2.1
  have hβker := hframe.2.2.2.1
  have hβeq := hframe.2.2.2.2
  obtain ⟨τ, hτP, hτ3, hτL, hτQ, hτff, hKQ, hdec, hmem_le⟩ := Sp44Side.exists_torus h
  set K : Subgroup G := L ⊓ Subgroup.centralizer ({τ} : Set G) with hKdef
  have hKL : K ≤ L := inf_le_left
  have hQleL : pCoreOf 2 L ≤ L := CFSG.LieType.BorelTits.pCoreOf_le 2 L
  have hinj : Function.Injective (α₀.comp (Subgroup.inclusion hKL)) := by
    intro x y hxy
    have h1 : (Subgroup.inclusion hKL x * (Subgroup.inclusion hKL y)⁻¹ : ↥L) ∈ α₀.ker := by
      rw [MonoidHom.mem_ker]
      have hxy' : α₀ (Subgroup.inclusion hKL x) = α₀ (Subgroup.inclusion hKL y) := hxy
      rw [map_mul, map_inv, hxy', mul_inv_cancel]
    rw [hαker] at h1
    have h3 : ((Subgroup.inclusion hKL x * (Subgroup.inclusion hKL y)⁻¹ : ↥L) : G) ∈
        pCoreOf 2 L :=
      (CFSG.GH74.QTGen4.DSGen4.Lin2C.mem_pCore_iff_pCoreOf _).mp h1
    have h4 : (x : G) * (y : G)⁻¹ ∈ pCoreOf 2 L := by simpa using h3
    have h5 : (x : G) * (y : G)⁻¹ ∈ K := K.mul_mem x.2 (K.inv_mem y.2)
    have h6 : (x : G) * (y : G)⁻¹ = 1 := by
      have h7 : (x : G) * (y : G)⁻¹ ∈ (⊥ : Subgroup G) := by
        rw [← hKQ]
        exact Subgroup.mem_inf.mpr ⟨h5, h4⟩
      simpa using h7
    exact Subtype.ext (mul_inv_eq_one.mp h6)
  have hsurj : Function.Surjective (α₀.comp (Subgroup.inclusion hKL)) := by
    intro s
    obtain ⟨l, hl⟩ := hαsurj s
    obtain ⟨q, hqQ, k, hkK, hqk⟩ := hdec (l : G) l.2
    refine ⟨⟨k, hkK⟩, ?_⟩
    have hqL : q ∈ L := (CFSG.LieType.BorelTits.pCoreOf_le 2 L) hqQ
    have hqker : α₀ ⟨q, hqL⟩ = 1 := by
      rw [← MonoidHom.mem_ker, hαker]
      exact (CFSG.GH74.QTGen4.DSGen4.Lin2C.mem_pCore_iff_pCoreOf ⟨q, hqL⟩).mpr hqQ
    have hlqk : l = ⟨q, hqL⟩ * ⟨k, hKL hkK⟩ := Subtype.ext (by simpa using hqk.symm)
    calc α₀ ⟨k, hKL hkK⟩ = α₀ (⟨q, hqL⟩ * ⟨k, hKL hkK⟩) := by rw [map_mul, hqker, one_mul]
      _ = α₀ l := by rw [hlqk]
      _ = s := hl
  let α : ↥K ≃* SL₂ F₄ := MulEquiv.ofBijective _ ⟨hinj, hsurj⟩
  have hαapp : ∀ k : ↥K, α k = α₀ ⟨k, hKL k.2⟩ := fun k => rfl
  let T₁ : Subgroup G :=
    (CFSG.SL2MinimalFaithful.unipotentHom (F := F₄)).range.map
      ((Subgroup.subtype K).comp α.symm.toMonoidHom)
  have hT₁K : T₁ ≤ K := by
    rintro _ ⟨u, -, rfl⟩
    exact (α.symm u).2
  have hT₁card : Nat.card ↥T₁ = 4 := by
    have hinj' : Function.Injective ((Subgroup.subtype K).comp α.symm.toMonoidHom) := by
      intro a b hab
      exact α.symm.injective (Subtype.ext hab)
    rw [Subgroup.card_map_of_injective hinj']
    rw [← Nat.card_congr (MonoidHom.ofInjective
      (CFSG.SL2MinimalFaithful.unipotentHom_injective (F := F₄))).toEquiv,
      Nat.card_congr Multiplicative.toAdd, card_galoisField_two_two]
    norm_num
  have hT₁p : IsPGroup 2 T₁ := IsPGroup.iff_card.mpr ⟨2, by rw [hT₁card]; norm_num⟩
  have hKcard : Nat.card ↥K = 60 := card_inf_centralizer h hdec hKQ
  have hT₁sylow : IsSylowTwoOf T₁ K := by
    refine ⟨hT₁K, hT₁p, ?_⟩
    intro h2
    have h1 := Subgroup.index_mul_card (H := T₁.subgroupOf K)
    have hc : Nat.card ↥(T₁.subgroupOf K) = 4 := by
      rw [← hT₁card]
      exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hT₁K).toEquiv
    rw [hc, hKcard] at h1
    obtain ⟨c, hc2⟩ := h2
    rw [hc2] at h1
    omega
  obtain ⟨hSKsylow, hQinf_cent⟩ := Sp44Side.inf_sylow h hτP hτ3 hτL hτff hdec
  obtain ⟨k, hkK, hT₁eq⟩ := IsSylowTwoOf.exists_conj hSKsylow hT₁sylow
  have hQn : L ≤ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
    CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 L
  have hconj_le : (pCoreOf 2 L ⊓ Q').map (MulAut.conj k).toMonoidHom ≤
      Cplus α (pCoreOf 2 L) := by
    intro y hy
    obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.mp hy
    obtain ⟨hzQ, hzQ'⟩ := Subgroup.mem_inf.mp hz
    rw [mem_Cplus_iff]
    refine ⟨(Subgroup.mem_normalizer_iff.mp (hQn (hKL hkK)) z).mp hzQ, ?_⟩
    intro t
    have hxT : ((xElt α t : ↥K) : G) ∈ T₁ := by
      refine Subgroup.mem_map.mpr ⟨unipotent t, ⟨Multiplicative.ofAdd t, rfl⟩, ?_⟩
      rw [xElt_eq_symm]
      rfl
    rw [hT₁eq] at hxT
    obtain ⟨s, hs, hsk⟩ := Subgroup.mem_map.mp hxT
    have hsk' : k * (s : G) * k⁻¹ = ((xElt α t : ↥K) : G) := by
      rw [← hsk]
      exact (MulAut.conj_apply k s).symm
    have hzs : (s : G) * (z : G) = (z : G) * (s : G) :=
      Subgroup.mem_centralizer_iff.mp (hQinf_cent hz) s hs
    calc ((xElt α t : ↥K) : G) * (k * (z : G) * k⁻¹)
        = (k * (s : G) * k⁻¹) * (k * (z : G) * k⁻¹) := by rw [hsk']
      _ = k * ((s : G) * (z : G)) * k⁻¹ := by group
      _ = k * ((z : G) * (s : G)) * k⁻¹ := by rw [hzs]
      _ = (k * (z : G) * k⁻¹) * (k * (s : G) * k⁻¹) := by group
      _ = (k * (z : G) * k⁻¹) * ((xElt α t : ↥K) : G) := by rw [hsk']
  have hcard_conj : Nat.card ↥((pCoreOf 2 L ⊓ Q').map (MulAut.conj k).toMonoidHom) = 16 := by
    rw [Subgroup.card_map_of_injective (MulAut.conj k).injective, h.card_inf]
    norm_num
  have hT : 16 ≤ Nat.card ↥(Cplus α (pCoreOf 2 L)) := by
    rw [← hcard_conj]
    exact Nat.card_le_card_of_injective (Subgroup.inclusion hconj_le)
      (Subgroup.inclusion_injective hconj_le)
  have hind : ∀ W : Subgroup G, W ≤ pCoreOf 2 L →
      (∀ k ∈ K, ∀ w ∈ W, k * w * k⁻¹ ∈ W) → W ⊔ centerOf L = pCoreOf 2 L →
      W = pCoreOf 2 L := by
    intro W hWQ hWn hsup
    have hstep : ∀ l ∈ L, ∀ w ∈ W, l * w * l⁻¹ ∈ W := by
      intro l hl w hw
      obtain ⟨q, hq, kk, hk, rfl⟩ := hdec l hl
      have h1 : kk * w * kk⁻¹ ∈ W := hWn kk hk w hw
      have h2 : kk * w * kk⁻¹ ∈ pCoreOf 2 L := hWQ h1
      have hcomm : q * (kk * w * kk⁻¹) = (kk * w * kk⁻¹) * q :=
        congrArg Subtype.val (h.elem.1.is_comm.comm ⟨q, hq⟩ ⟨kk * w * kk⁻¹, h2⟩)
      have h3 : q * (kk * w * kk⁻¹) * q⁻¹ = kk * w * kk⁻¹ := by
        calc q * (kk * w * kk⁻¹) * q⁻¹ = ((kk * w * kk⁻¹) * q) * q⁻¹ := by rw [hcomm]
          _ = kk * w * kk⁻¹ := by group
      have he : (q * kk) * w * (q * kk)⁻¹ = q * (kk * w * kk⁻¹) * q⁻¹ := by group
