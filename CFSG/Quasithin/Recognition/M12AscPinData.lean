theorem Llist_keys : Llist.map (fun ℓ : Perm (Fin 12) => keyF ℓ) = Lkeys := by decide +kernel

@[expose] def kElt : Perm (Fin 12) := wordProd genS wordK

@[expose] def kvec : Fin 12 → Fin 12 := ![0, 1, 9, 8, 11, 6, 4, 3, 2, 7, 5, 10]

theorem kElt_apply : ∀ j : Fin 12, kElt j = kvec j := by decide +kernel

theorem kElt_mem : kElt ∈ S0 := wordProd_mem genS_mem _

@[expose] def candFun (a b c d e f g : Fin 12) : Fin 12 → Fin 12 :=
  ![1, 0, 2, 3, 4, a, b, c, d, e, f, g]

set_option synthInstance.maxSize 100000 in
set_option synthInstance.maxHeartbeats 2000000 in
theorem finite_lemma :
    ∀ a : Fin 12, 5 ≤ a.val →
    ∀ b : Fin 12, 5 ≤ b.val → b ≠ a → (a = 6 ↔ b = 5) →
    ∀ c : Fin 12, 5 ≤ c.val → c ≠ a → c ≠ b → (a = 7 ↔ c = 5) → (b = 7 ↔ c = 6) →
    ∀ d : Fin 12, 5 ≤ d.val → d ≠ a → d ≠ b → d ≠ c → (a = 8 ↔ d = 5) → (b = 8 ↔ d = 6) →
      (c = 8 ↔ d = 7) →
    ∀ e : Fin 12, 5 ≤ e.val → e ≠ a → e ≠ b → e ≠ c → e ≠ d → (a = 9 ↔ e = 5) → (b = 9 ↔ e = 6) →
      (c = 9 ↔ e = 7) → (d = 9 ↔ e = 8) →
    ∀ f : Fin 12, 5 ≤ f.val → f ≠ a → f ≠ b → f ≠ c → f ≠ d → f ≠ e → (a = 10 ↔ f = 5) →
      (b = 10 ↔ f = 6) → (c = 10 ↔ f = 7) → (d = 10 ↔ f = 8) → (e = 10 ↔ f = 9) →
    ∀ g : Fin 12, 5 ≤ g.val → g ≠ a → g ≠ b → g ≠ c → g ≠ d → g ≠ e → g ≠ f → (a = 11 ↔ g = 5) →
      (b = 11 ↔ g = 6) → (c = 11 ↔ g = 7) → (d = 11 ↔ g = 8) → (e = 11 ↔ g = 9) →
      (f = 11 ↔ g = 10) →
    keyF (fun j => candFun a b c d e f g (kvec (candFun a b c d e f g j))) ∈ Lkeys →
    candFun a b c d e f g = ⇑(Equiv.swap (0 : Fin 12) 1) ∨ candFun a b c d e f g = ⇑tau0 := by
  decide +kernel

