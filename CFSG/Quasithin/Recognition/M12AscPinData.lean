@[expose] def genA : Perm (Fin 12) :=
  List.formPerm [0, 3] * List.formPerm [2, 9] * List.formPerm [4, 10] * List.formPerm [5, 11]

@[expose] def genB : Perm (Fin 12) :=
  List.formPerm [0, 7, 8] * List.formPerm [1, 2, 3] * List.formPerm [4, 11, 10] *
    List.formPerm [5, 9, 6]

theorem m12_eq_closure :
    CFSG.Blueprint.NativeSporadic.M12 = Subgroup.closure {genA, genB} := rfl

@[expose] def genM (i : ℕ) : Perm (Fin 12) := if i = 0 then genA else genB

@[expose] def s1 : Perm (Fin 12) :=
  List.formPerm [2, 9] * List.formPerm [4, 5] * List.formPerm [7, 8] * List.formPerm [10, 11]

@[expose] def s2 : Perm (Fin 12) :=
  List.formPerm [1, 4, 3, 10] * List.formPerm [2, 8, 6, 11]

@[expose] def tau0 : Perm (Fin 12) :=
  List.formPerm [0, 1] * List.formPerm [5, 10] * List.formPerm [6, 7] * List.formPerm [9, 11]

@[expose] def genT (i : ℕ) : Perm (Fin 12) := if i = 0 then s1 else if i = 1 then s2 else tau0

@[expose] def S0 : Subgroup (Perm (Fin 12)) := Subgroup.closure {s1, s2}

