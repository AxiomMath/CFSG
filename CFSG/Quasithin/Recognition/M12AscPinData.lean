theorem s1_eq : s1 = wordProd genM wordS1 := by decide +kernel

theorem s2_eq : s2 = wordProd genM wordS2 := by decide +kernel

theorem genA_eq : genA = wordProd genT wordA := by decide +kernel

theorem genB_eq : genB = wordProd genT wordB := by decide +kernel

theorem genM_mem (i : ℕ) : genM i ∈ CFSG.Blueprint.NativeSporadic.M12 := by
  rw [m12_eq_closure]
  unfold genM
  split
  · exact Subgroup.subset_closure (by simp)
  · exact Subgroup.subset_closure (by simp)

theorem s1_mem : s1 ∈ CFSG.Blueprint.NativeSporadic.M12 := by
  rw [s1_eq]; exact wordProd_mem genM_mem _

theorem s2_mem : s2 ∈ CFSG.Blueprint.NativeSporadic.M12 := by
  rw [s2_eq]; exact wordProd_mem genM_mem _

theorem s1_mem_S0 : s1 ∈ S0 := Subgroup.subset_closure (by simp)

theorem s2_mem_S0 : s2 ∈ S0 := Subgroup.subset_closure (by simp)

theorem S0_le_M12 : S0 ≤ CFSG.Blueprint.NativeSporadic.M12 := by
  unfold S0
  rw [Subgroup.closure_le]
  rintro _ (rfl | rfl)
  · exact s1_mem
  · exact s2_mem

theorem exists_mem_M12_apply_zero (q : Fin 12) :
    ∃ r ∈ CFSG.Blueprint.NativeSporadic.M12, r 0 = q := by
  obtain ⟨w, -, hw⟩ := (by decide +kernel : ∀ q : Fin 12, ∃ w ∈ wordsR, (wordProd genM w) 0 = q) q
  exact ⟨wordProd genM w, wordProd_mem genM_mem w, hw⟩

theorem M12_le {P : Subgroup (Perm (Fin 12))} (h1 : s1 ∈ P) (h2 : s2 ∈ P) (h3 : tau0 ∈ P) :
    CFSG.Blueprint.NativeSporadic.M12 ≤ P := by
  have hg : ∀ i, genT i ∈ P := by
    intro i
    unfold genT
    split
    · exact h1
    · split
      · exact h2
      · exact h3
  rw [m12_eq_closure, Subgroup.closure_le]
  rintro _ (rfl | rfl)
  · rw [genA_eq]; exact wordProd_mem hg _
  · rw [genB_eq]; exact wordProd_mem hg _

@[expose] def genS (i : ℕ) : Perm (Fin 12) := if i = 0 then s1 else s2

theorem genS_mem (i : ℕ) : genS i ∈ S0 := by
  unfold genS
  split
  · exact Subgroup.subset_closure (by simp)
  · exact Subgroup.subset_closure (by simp)

@[expose] def transT2 : List (Perm (Fin 12)) := wordsT2.map (wordProd genS)

@[expose] def transT3 : List (Perm (Fin 12)) := wordsT3.map (wordProd genS)

@[expose] def transT4 : List (Perm (Fin 12)) := wordsT4.map (wordProd genS)

theorem transT2_mem : ∀ t ∈ transT2, t ∈ S0 := by
  intro t ht
  obtain ⟨w, -, rfl⟩ := List.mem_map.1 ht
  exact wordProd_mem genS_mem w

theorem transT3_mem : ∀ t ∈ transT3, t ∈ S0 := by
  intro t ht
  obtain ⟨w, -, rfl⟩ := List.mem_map.1 ht
  exact wordProd_mem genS_mem w

theorem transT4_mem : ∀ t ∈ transT4, t ∈ S0 := by
  intro t ht
  obtain ⟨w, -, rfl⟩ := List.mem_map.1 ht
  exact wordProd_mem genS_mem w

theorem T2_spec : ∀ u : Fin 12, 2 ≤ u.val →
    ∃ t ∈ transT2, (∀ i : Fin 12, i.val < 2 → t i = i) ∧ t 2 = u := by decide +kernel

theorem T3_spec : ∀ v : Fin 12, 3 ≤ v.val →
    ∃ t ∈ transT3, (∀ i : Fin 12, i.val < 3 → t i = i) ∧ t 3 = v := by decide +kernel

theorem T4_spec : ∀ w : Fin 12, 4 ≤ w.val →
    ∃ t ∈ transT4, (∀ i : Fin 12, i.val < 4 → t i = i) ∧ t 4 = w := by decide +kernel

@[expose] def Llist : List (Perm (Fin 12)) :=
  transT2.flatMap fun a => transT3.flatMap fun b => transT4.map fun c => a * b * c

theorem mem_Llist {a b c : Perm (Fin 12)} (ha : a ∈ transT2) (hb : b ∈ transT3)
    (hc : c ∈ transT4) : a * b * c ∈ Llist := by
  unfold Llist
  exact List.mem_flatMap.2 ⟨a, ha, List.mem_flatMap.2 ⟨b, hb, List.mem_map.2 ⟨c, hc, rfl⟩⟩⟩

@[expose] def keyF (f : Fin 12 → Fin 12) : ℕ :=
  [f 0, f 1, f 2, f 3, f 4, f 5, f 6, f 7, f 8, f 9, f 10, f 11].foldr
    (fun x acc => x.val + 12 * acc) 0

