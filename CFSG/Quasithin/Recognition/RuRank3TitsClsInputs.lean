@[expose] def titsK0Strong : Array (Array ℕ) :=
  Array.ofFn (n := 5) fun j => hexTable 3 1755 (1755 * j.val) titsK0Text

@[expose] def titsK0Words : List (List ℤ) :=
  [[-1, -3, 1, 1, -3, -1, -1, 3, 1, 3], [-1, -4, 1, -3, 1, 1, 1, 1, 1]]

@[expose] def inTitsD (a : Array ℕ) : Bool :=
  siftA 1755 (rawLevels 1755 titsDerivedArrs (baseArr 1755 titsDerivedBase))
    (baseArr 1755 titsDerivedBase) 0 a

@[expose] def isInvolA (c : Array ℕ) : Bool :=
  eqA 1755 (compA 1755 c c) (idA 1755) && !eqA 1755 c (idA 1755)

@[expose] def classifiedA (c : Array ℕ) : Bool :=
  (List.range 12).any fun k =>
    let y := powArr 1755 titsY12Arr k
    (List.range 30).any fun i => eqA 1755 (compA 1755 (compA 1755 y c) (invCand 1755 y))
      (titsRepArr i)

@[expose] def classOK (c : Array ℕ) : Bool :=
  !isInvolA c || eqA 1755 c titsTArr || classifiedA c

@[expose] def badLetters (i : ℕ) : Array (Array ℕ) :=
  Array.ofFn (n := 3) fun h => if h.val = 0 then titsX13Arr else if h.val = 1 then titsTArr
    else titsRepArr i

@[expose] def badWordArr (i : ℕ) : Array ℕ :=
  wordA 1755 (badLetters i) ((badLetters i).map (invCand 1755)) (titsBadWords.getD i [])

@[expose] def badOK (i : ℕ) : Bool :=
  lettersOK 3 (titsBadWords.getD i []) &&
    (!eqA 1755 (powArr 1755 (badWordArr i) 12) (idA 1755) &&
      (!eqA 1755 (powArr 1755 (badWordArr i) 13) (idA 1755) &&
        !eqA 1755 (powArr 1755 (badWordArr i) 5) (idA 1755)))

@[expose] def inTitsK0 (a : Array ℕ) : Bool := ruSift 1755 titsK0Strong [0, 12, 1] a

