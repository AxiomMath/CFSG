private lemma g2_weylElt_mem_normalizer_torusSub
    {K : Type} [Field K]
    (i : Fin Tag.G2.rank) :
    (⟨weylElt Tag.G2 K i 1, weylElt_mem_adjointGroup i 1⟩ :
      ↥(adjointGroup Tag.G2 K)) ∈
      Subgroup.normalizer ((torusGroup Tag.G2 K).subgroupOf
        (adjointGroup Tag.G2 K) : Set ↥(adjointGroup Tag.G2 K)) := by
  have hle : torusGroup Tag.G2 K ≤ adjointGroup Tag.G2 K :=
    torusGroup_le_borelGroup.trans borelGroup_le_adjointGroup'
  rw [CFSG.GorensteinWalter.normalizer_subgroupOf_eq_subgroupOf_inf_normalizer
    (adjointGroup Tag.G2 K) (torusGroup Tag.G2 K) hle]
  exact Subgroup.mem_subgroupOf.mpr
    (Subgroup.mem_inf.mpr ⟨weylElt_mem_adjointGroup i 1,
      CFSG.LieType.Chevalley.weylElt_mem_normalizer_torus Tag.G2 K i 1⟩)

private lemma g2_n0_mem_closure
    {K : Type} [Field K] :
    (⟨canonicalRep (coxeterSystem Tag.G2) K g2LongestWeyl,
        canonicalRep_mem_adjointGroup _ K _⟩ : ↥(adjointGroup Tag.G2 K)) ∈
      Subgroup.closure (Set.range fun i : Fin Tag.G2.rank =>
        (⟨weylElt Tag.G2 K i 1, weylElt_mem_adjointGroup i 1⟩ :
          ↥(adjointGroup Tag.G2 K))) := by
  have hcanon : canonicalRep (coxeterSystem Tag.G2) K g2LongestWeyl ∈
      Subgroup.closure (Set.range fun i : Fin Tag.G2.rank => weylElt Tag.G2 K i 1) :=
    canonicalRep_mem_closure _ K g2LongestWeyl
  have himage : (adjointGroup Tag.G2 K).subtype '' (Set.range fun i : Fin Tag.G2.rank =>
      (⟨weylElt Tag.G2 K i 1, weylElt_mem_adjointGroup i 1⟩ :
        ↥(adjointGroup Tag.G2 K))) =
      Set.range fun i : Fin Tag.G2.rank => weylElt Tag.G2 K i 1 := by
    ext y
    constructor
    · rintro ⟨x, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨_, ⟨i, rfl⟩, rfl⟩
  have hmap : ((⟨canonicalRep (coxeterSystem Tag.G2) K g2LongestWeyl,
      canonicalRep_mem_adjointGroup _ K _⟩ : ↥(adjointGroup Tag.G2 K)) : ModGL Tag.G2 K) ∈
      (Subgroup.closure (Set.range fun i : Fin Tag.G2.rank =>
        (⟨weylElt Tag.G2 K i 1, weylElt_mem_adjointGroup i 1⟩ :
          ↥(adjointGroup Tag.G2 K)))).map (adjointGroup Tag.G2 K).subtype := by
    rw [MonoidHom.map_closure, himage]
    exact hcanon
  obtain ⟨w, hw, hwe⟩ := Subgroup.mem_map.mp hmap
  have hw' : w = (⟨canonicalRep (coxeterSystem Tag.G2) K g2LongestWeyl,
      canonicalRep_mem_adjointGroup _ K _⟩ : ↥(adjointGroup Tag.G2 K)) := Subtype.ext hwe
  rwa [hw'] at hw

private lemma g2_n0_inverts_torus
    {K : Type} [Field K]
    (x : ↥(adjointGroup Tag.G2 K)) (hx : x ∈ torusSub Tag.G2 K) :
    (⟨canonicalRep (coxeterSystem Tag.G2) K g2LongestWeyl,
        canonicalRep_mem_adjointGroup _ K _⟩ : ↥(adjointGroup Tag.G2 K)) * x *
      (⟨canonicalRep (coxeterSystem Tag.G2) K g2LongestWeyl,
        canonicalRep_mem_adjointGroup _ K _⟩ : ↥(adjointGroup Tag.G2 K))⁻¹ = x⁻¹ := by
  apply Subtype.ext
  have hxT : (x : ModGL Tag.G2 K) ∈ torusGroup Tag.G2 K := Subgroup.mem_subgroupOf.mp hx
  have h := CFSG.RankThree.Chevalley.mul_canonicalRep_conj_eq_inv_of_smul_eq_neg
    (k := K) (τ := Tag.G2) (h := 1) (one_mem _)
    (fun v => CFSG.RankThree.PartTwo.Sec4.Res417Seven.g2LongestWeyl_smul_eq_neg v) hxT
  simpa using h

theorem invertsByWeyl_g2
    {K : Type} [Field K] [Finite K] [CharP K 2] {f : ℕ}
    (hK : Nat.card K = 2 ^ f) (hf : 2 ≤ f) {m : ℕ} (hm : Odd m) :
    InvertsByWeyl ((parabolicSubgroup Tag.G2 K {g2Index 0}).subgroupOf (adjointGroup Tag.G2 K))
      ((parabolicSubgroup Tag.G2 K {g2Index 1}).subgroupOf (adjointGroup Tag.G2 K)) m := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Finite (ModGL Tag.G2 K) := finite_modGL
  let U := posUnipotentSub Tag.G2 K
  let T := torusSub Tag.G2 K
  let P₀ := (parabolicSubgroup Tag.G2 K {g2Index 0}).subgroupOf (adjointGroup Tag.G2 K)
  let P₁ := (parabolicSubgroup Tag.G2 K {g2Index 1}).subgroupOf (adjointGroup Tag.G2 K)
  have hB : P₀ ⊓ P₁ = borelSub Tag.G2 K := by
    change CFSG.Quasithin.F112R.St84.g2ParB K ⊓
      CFSG.Quasithin.F112R.St84.g2ParA K = borelSub Tag.G2 K
    rw [inf_comm]
    exact g2ParA_inf_g2ParB
  have hU : IsPGroup 2 U := (CFSG.Quasithin.H13.Sec53F.G2.g2_sylow (K := K)).2.1
  have hUn : (U.subgroupOf (P₀ ⊓ P₁)).Normal := by
    rw [hB]
    exact normal_posUnipotentSub
  have hUH : U ⊔ T = P₀ ⊓ P₁ := by
    rw [show U ⊔ T = borelSub Tag.G2 K from by
      simpa [U, T] using posUnipotentSub_sup_torusSub (τ := Tag.G2) (K := K), hB]
  have hH : Odd (Nat.card T) := by
    have hT : Odd (Nat.card (torusGroup Tag.G2 K)) := by
      rw [card_torusGroup, hK]
      have hodd : Odd (2 ^ f - 1) :=
        Nat.Even.sub_odd (Nat.one_le_two_pow)
          (Nat.even_pow.2 ⟨even_two, Nat.pos_iff_ne_zero.mp (by omega)⟩) odd_one
      exact hodd.pow (n := 2)
    change Odd (Nat.card ((torusGroup Tag.G2 K).subgroupOf (adjointGroup Tag.G2 K)))
    exact CFSG.QuasiDihedralFusion.odd_card_subgroupOf hT (adjointGroup Tag.G2 K)
  let X : Set ↥(adjointGroup Tag.G2 K) := Set.range fun i : Fin Tag.G2.rank =>
    (⟨weylElt Tag.G2 K i 1, weylElt_mem_adjointGroup i 1⟩ : ↥(adjointGroup Tag.G2 K))
  have hX : ∀ x ∈ X, (x ∈ P₀ ∨ x ∈ P₁) ∧
      x ∈ Subgroup.normalizer (T : Set ↥(adjointGroup Tag.G2 K)) := by
    rintro x ⟨i, rfl⟩
    rcases fin_two_cases i with rfl | rfl
    · refine ⟨Or.inl (Subgroup.mem_subgroupOf.mpr
          (weylElt_mem_parabolicSubgroup (J := {g2Index 0}) (j := i0) ?_)),
        g2_weylElt_mem_normalizer_torusSub i0⟩
      rw [← g2Index_zero]
      exact Set.mem_singleton _
    · refine ⟨Or.inr (Subgroup.mem_subgroupOf.mpr
          (weylElt_mem_parabolicSubgroup (J := {g2Index 1}) (j := i1) ?_)),
        g2_weylElt_mem_normalizer_torusSub i1⟩
      rw [← g2Index_one]
      exact Set.mem_singleton _
  let w : ↥(adjointGroup Tag.G2 K) :=
    ⟨canonicalRep (coxeterSystem Tag.G2) K g2LongestWeyl,
      canonicalRep_mem_adjointGroup _ K _⟩
  have hw : w ∈ Subgroup.closure X := by
    simpa [w, X] using g2_n0_mem_closure (K := K)
  have hinv : ∀ x ∈ T, x ^ m = 1 → w * x * w⁻¹ = x⁻¹ := by
    intro x hx _
    simpa [T, w] using g2_n0_inverts_torus x hx
  have h := InvertsByWeyl.of_torus_closure (Y := ↥(adjointGroup Tag.G2 K))
    (U := U) (H := T) (P₀ := P₀) (P₁ := P₁) hm hU hUn hUH hH hX hw hinv
  simpa [P₀, P₁] using h

theorem allInvertsByWeyl_g2
    {f : ℕ} (hf : 2 ≤ f) {m : ℕ} (hm : Odd m) :
    AllInvertsByWeyl (CFSG.Quasithin.IsG2Over f) m := by
  intro Y _ hY T M₁ M₂ hYam
  rcases hY with ⟨rfl, -⟩ | ⟨hf', hLie⟩
  · omega
  · have hChev : ChevalleyExceptionalModel Y .G2 2 f :=
      (CFSG.LieType.Steinberg.CentralExt.GriessNative.chevalley_of_lieModel
        hLie (by decide)).2
    obtain ⟨-, K, hF, hFin, hcp, hK, ⟨e⟩⟩ :=
      CFSG.QuasithinUnique.Setup.X6.exists_mulEquiv_G2_model hChev
    have : Finite (ModGL Tag.G2 K) := finite_modGL
    exact InvertsByWeyl.of_yamStd (CFSG.Quasithin.H13.Sec53F.G2.g2_yamStd hK hf')
      (invertsByWeyl_g2 hK hf' hm) e hYam

