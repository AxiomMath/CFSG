@[expose] def listClosedA (n : ℕ) (gens L : Array (Array ℕ)) : Bool :=
  L.any (fun e => eqA n e (idA n)) &&
    allLt gens.size fun k => allLt L.size fun i =>
      (L.any fun e => eqA n e (compA n gens[k]! L[i]!)) &&
        (L.any fun e => eqA n e (compA n (invCand n gens[k]!) L[i]!))

@[expose] def closureList (n : ℕ) (gens : Array (Array ℕ)) (cap : ℕ) : Array (Array ℕ) :=
  Id.run do
    let mut L : Array (Array ℕ) := #[idA n]
    let mut head := 0
    for _ in [0:cap] do
      if head < L.size then
        let g := L[head]!
        head := head + 1
        for k in [0:gens.size] do
          let h := compA n gens[k]! g
          if !(L.any fun e => eqA n e h) then
            L := L.push h
    return L

@[expose] def lineFixedA (a : Array ℕ) (v : ℕ) : Bool :=
  (List.range 3).all fun k =>
    let x := a[titsLinePtArr[3 * v + k]!]!
    x == titsLinePtArr[3 * v]! || x == titsLinePtArr[3 * v + 1]! || x == titsLinePtArr[3 * v + 2]!

@[expose] def lineFixCount (a : Array ℕ) : ℕ := (List.range 2925).countP (lineFixedA a)

@[expose] def ptFixCount (a : Array ℕ) : ℕ := (List.range 1755).countP fun x => a[x]! == x

