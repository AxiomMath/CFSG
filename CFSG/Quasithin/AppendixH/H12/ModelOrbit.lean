@[expose] def tree1465 : List (ℕ × ℕ × ℕ) := tree1465a ++ tree1465b

@[expose] def O5 : List ℕ := 5 :: tree5.map (·.1)

@[expose] def O1465 : List ℕ := 1465 :: tree1465.map (·.1)

set_option maxRecDepth 200000 in
theorem treeCheck_tree5 : treeCheck [5] tree5 = true := by
  decide +kernel

set_option maxRecDepth 200000 in
theorem treeCheck_tree1465 : treeCheck [1465] tree1465 = true := by
  decide +kernel

set_option maxRecDepth 200000 in
theorem closedCheck_O5 : closedCheck O5 = true := by
  decide +kernel

set_option maxRecDepth 200000 in
theorem closedCheck_O1465 : closedCheck O1465 = true := by
  decide +kernel

@[expose] def coverCheck : Bool :=
  (List.range 4096).all fun c =>
    c == 0 || quadN 12 Qcols c || (maskOf O5).testBit c || (maskOf O1465).testBit c

set_option maxRecDepth 200000 in
theorem coverCheck_eq : coverCheck = true := by
  decide +kernel

theorem cover {c : ℕ} (hc0 : 0 < c) (hc : c < 4096) (hq : quadN 12 Qcols c = false) :
    c ∈ O5 ∨ c ∈ O1465 := by
  have hcov : (List.range 4096).all (fun c =>
      c == 0 || quadN 12 Qcols c || (maskOf O5).testBit c || (maskOf O1465).testBit c) = true := by
    simpa only [coverCheck] using coverCheck_eq
  have h := (List.all_eq_true.mp hcov) c (List.mem_range.mpr hc)
  change (c == 0 || quadN 12 Qcols c || (maskOf O5).testBit c || (maskOf O1465).testBit c) = true
    at h
  have h0 : (c == 0) = false := by
    cases h' : c == 0 with
    | false => rfl
    | true => exact absurd (beq_iff_eq.mp h') (ne_of_gt hc0)
  rw [h0, Bool.false_or, hq, Bool.false_or, Bool.or_eq_true] at h
  rcases h with h | h
  · exact Or.inl (of_decide_eq_true ((testBit_maskOf O5 c).symm.trans h))
  · exact Or.inr (of_decide_eq_true ((testBit_maskOf O1465 c).symm.trans h))

theorem line1465_not_mem_O5 : ∀ x ∈ lineOf 1465, x ∉ O5 := by
  decide +kernel

theorem reach5 {c : ℕ} (hc : c ∈ O5) : ∃ g ∈ G0, gmv g 5 = c := by
  have hseen : ∀ x ∈ [5], ∃ g ∈ G0, gmv g 5 = x := by
    intro x hx
    rw [List.mem_singleton] at hx
    subst hx
    exact ⟨1, G0.one_mem, gmv_one (by norm_num)⟩
  have hreach := treeCheck_reach hseen treeCheck_tree5
  rcases List.mem_cons.mp hc with rfl | hc
  · exact ⟨1, G0.one_mem, gmv_one (by norm_num)⟩
  · obtain ⟨e, he, hc'⟩ := List.mem_map.mp hc
    obtain ⟨g, hg, hgv⟩ := hreach e he
    exact ⟨g, hg, hc' ▸ hgv⟩

theorem reach1465 {c : ℕ} (hc : c ∈ O1465) : ∃ g ∈ G0, gmv g 1465 = c := by
  have hseen : ∀ x ∈ [1465], ∃ g ∈ G0, gmv g 1465 = x := by
    intro x hx
    rw [List.mem_singleton] at hx
    subst hx
    exact ⟨1, G0.one_mem, gmv_one (by norm_num)⟩
  have hreach := treeCheck_reach hseen treeCheck_tree1465
  rcases List.mem_cons.mp hc with rfl | hc
  · exact ⟨1, G0.one_mem, gmv_one (by norm_num)⟩
  · obtain ⟨e, he, hc'⟩ := List.mem_map.mp hc
    obtain ⟨g, hg, hgv⟩ := hreach e he
    exact ⟨g, hg, hc' ▸ hgv⟩

theorem closed5 {g : Γ12} (hg : g ∈ G0) {c : ℕ} (hc : c ∈ O5) : gmv g c ∈ O5 :=
  closed_of_closedCheck closedCheck_O5 hg hc

theorem closed1465 {g : Γ12} (hg : g ∈ G0) {c : ℕ} (hc : c ∈ O1465) : gmv g c ∈ O1465 :=
  closed_of_closedCheck closedCheck_O1465 hg hc

theorem isConjPt_ptSub_five {c : ℕ} (hc : c ∈ O5) : IsConjPt glHom G0 (ptSub 5) (ptSub c) := by
  obtain ⟨g, hg, hgv⟩ := reach5 hc
  refine ⟨g, hg, ?_⟩
  show smulSub g (ptSub 5) = ptSub c
  rw [smulSub_ptSub hg (by norm_num), hgv]

theorem isConjPt_ptSub_1465 {c : ℕ} (hc : c ∈ O1465) :
    IsConjPt glHom G0 (ptSub 1465) (ptSub c) := by
  obtain ⟨g, hg, hgv⟩ := reach1465 hc
  refine ⟨g, hg, ?_⟩
  show smulSub g (ptSub 1465) = ptSub c
  rw [smulSub_ptSub hg (by norm_num), hgv]

theorem not_isConjPt_five_1465 : ¬ IsConjPt glHom G0 (ptSub 5) (ptSub 1465) := by
  rintro ⟨g, hg, hgeq⟩
  have h1 : ptSub (gmv g 5) = ptSub 1465 := by
    rw [← smulSub_ptSub hg (by norm_num : 5 < 4096)]
    exact hgeq
  have hv0 : gmv g 5 ≠ 0 := by
    intro h
    have h5 : (5 : ℕ) = 0 := (gmv_eq_zero_iff g (by norm_num : 5 < 4096)).mp h
    omega
  have hline : gmv g 5 ∈ lineOf 1465 :=
    (ptSub_eq_iff (by norm_num : 0 < 1465) (by norm_num : 1465 < 4096) (gmv_lt g 5)).mp
      h1.symm
  have hmem : gmv g 5 ∈ O5 := closed5 hg (by simp [O5])
  exact line1465_not_mem_O5 (gmv g 5) hline hmem

theorem isoPoint_conj {P : Subgroup Vec12} (hP : IsIsoPoint ι0 f0 P) :
    IsConjPt glHom G0 P (ptSub 5) ∨ IsConjPt glHom G0 P (ptSub 1465) := by
  obtain ⟨c, hc0, hc, hq, rfl⟩ := (isIsoPoint_iff P).mp hP
  rcases cover hc0 hc hq with hc | hc
  · exact Or.inl (isConjPt_symm (isConjPt_ptSub_five hc))
  · exact Or.inr (isConjPt_symm (isConjPt_ptSub_1465 hc))

theorem isIsoPoint_five : IsIsoPoint ι0 f0 (ptSub 5) :=
  isIsoPoint_ptSub (by norm_num) (by norm_num) (by decide)

theorem isIsoPoint_1465 : IsIsoPoint ι0 f0 (ptSub 1465) :=
  isIsoPoint_ptSub (by norm_num) (by norm_num) (by decide)

