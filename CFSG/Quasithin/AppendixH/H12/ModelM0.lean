      simpa only [colsN_tU] using h2
    exact List.inj_on_of_nodup_map hmap a.2 b.2 h1
  rw [← List.attach_map_val (f := tU) (l := qWords)]
  exact List.Nodup.map hinj (List.nodup_attach.mpr (by decide))

