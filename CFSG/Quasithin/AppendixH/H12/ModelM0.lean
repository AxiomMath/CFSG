    Nat.card Q0 = 16 ∧ pCoreOf 2 M0 = Q0 ∧
      IsExtHatOf M0 (pCoreOf 2 M0) ↥(alternatingGroup (Fin 6)) :=
  structure_M (Γ := Γ12) (M := M0) (Q := Q0) (ω := zU)
    card_M0_le Q0_le_M0 card_Q0_ge zU_mem_M0 orderOf_zU zU_comm_M0
    zU_not_mem_Q0 pM pM_Q0 pM_zU pM_range comm_witness

theorem card_of_isExtHatOf_A6 {X : Type*} [Group X] [Finite X] {C E : Subgroup X}
    (h : IsExtHatOf C E ↥(alternatingGroup (Fin 6))) : Nat.card C = Nat.card E * 1080 := by
  obtain ⟨hE, Q, hQgrp, f, hf, hker, hHat⟩ := h
  letI := hQgrp
  obtain ⟨eQ⟩ := hHat.2.2
  have hcardQ : Nat.card Q = 1080 := by
    have h1 := Subgroup.card_eq_card_quotient_mul_card_subgroup (Subgroup.center Q)
    rw [hHat.2.1] at h1
    rw [Nat.card_congr eQ.toEquiv, nat_card_alternatingGroup, Nat.card_fin] at h1
    have hnum : (Nat.factorial 6 / 2) * 3 = 1080 := by decide
    rw [hnum] at h1
    exact h1
  have hkerCard : Nat.card ↥(f.ker) = Nat.card E := by
    rw [hker]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hE).toEquiv
  have hquotCard : Nat.card (C ⧸ f.ker) = Nat.card Q :=
    Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective f hf).toEquiv
  have hC : Nat.card C = Nat.card Q * Nat.card E := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (f.ker), hquotCard, hkerCard]
  rw [hC, hcardQ]
  ring

theorem card_M0 : Nat.card M0 = 17280 := by
  obtain ⟨hQcard, hpcore, hext⟩ := structure_M0
  have h := card_of_isExtHatOf_A6 hext
  rw [hpcore, hQcard] at h
  norm_num at h
  exact h

private theorem qWords_tU_nodup : (qWords.map tU).Nodup := by
  have hmap : (qWords.map tW).Nodup := qWords_tW_nodup
  have hinj : Function.Injective (fun w : {w // w ∈ qWords} => tU w.1) := by
