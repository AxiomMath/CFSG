set_option maxRecDepth 200000 in
private theorem comm_rel_tU :
    tU commA * tU commB = zU * tU commQ * tU commB * tU commA := by
  have h1 := tU_eq_of_tW_eq (w := commA ++ commB)
    (w' := zW ++ commQ ++ commB ++ commA) comm_relation
  have hL : tU commA * tU commB = tU (commA ++ commB) := (tU_append commA commB).symm
  have hR : tU (zW ++ commQ ++ commB ++ commA) =
      zU * tU commQ * tU commB * tU commA := by
    have e1 : tU (zW ++ (commQ ++ (commB ++ commA))) =
        tU zW * tU (commQ ++ (commB ++ commA)) := tU_append zW (commQ ++ (commB ++ commA))
    have e2 : tU (commQ ++ (commB ++ commA)) =
        tU commQ * tU (commB ++ commA) := tU_append commQ (commB ++ commA)
    have e3 : tU (commB ++ commA) = tU commB * tU commA := tU_append commB commA
    calc tU (zW ++ commQ ++ commB ++ commA)
        = tU zW * tU (commQ ++ (commB ++ commA)) := e1
      _ = tU zW * (tU commQ * tU (commB ++ commA)) := by rw [e2]
      _ = tU zW * (tU commQ * (tU commB * tU commA)) := by rw [e3]
      _ = zU * tU commQ * tU commB * tU commA := by
            rw [show tU zW = zU from rfl]; group
  exact hL.trans (h1.trans hR)

theorem comm_witness : ∃ a ∈ M0, ∃ b ∈ M0, zU⁻¹ * (a * b * a⁻¹ * b⁻¹) ∈ Q0 := by
  refine ⟨tU commA, tU_commA_mem, tU commB, tU_commB_mem, ?_⟩
  have hconj : zU⁻¹ * (tU commA * tU commB * (tU commA)⁻¹ * (tU commB)⁻¹) = tU commQ := by
    rw [comm_rel_tU]
    group
  rw [hconj]
  exact tU_commQ_mem

