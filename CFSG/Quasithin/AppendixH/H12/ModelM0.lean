theorem qWords_length : qWords.length = 16 := by
  decide

theorem qWords_tW_nodup : (qWords.map tW).Nodup := by
  decide +kernel

theorem qWords_fix : ∀ w ∈ qWords, ∀ c ∈ Wb, mvN (tW w) c = c := by
  intro w hw c hc
  have h : (qWords.all fun w => Wb.all fun c => mvN (tW w) c == c) = true := by
    rw [ModelM0K.all_tW qWords ModelM0K.qQL (by decide +kernel) (fun A => Wb.all fun c => mvN A c == c)]
    decide +kernel
  have hw' := (List.all_eq_true.mp h) w hw
  have hc' := (List.all_eq_true.mp hw') c hc
  simpa using hc'

theorem tU_qWords_mem : ∀ w ∈ qWords, tU w ∈ Q0 := by
  intro w hw
  rw [show Q0 = cenIn glHom G0 (spanSub Wb) from rfl, tU_mem_cenIn_spanSub_iff Wb_valid w]
  exact qWords_fix w hw

theorem card_Q0_ge : 16 ≤ Nat.card Q0 := by
  have h := length_le_card_of_words Q0 qWords qWords_tW_nodup tU_qWords_mem
  rwa [qWords_length] at h

@[expose] def hypGen (i : ℕ) : List ℕ := [hypPts.getD i 0, mvN z12 (hypPts.getD i 0)]

private theorem hypPts_pos : ∀ r ∈ hypPts, 0 < r := by
  intro r hr
  have h : (hypPts.all fun r => decide (0 < r)) = true := by decide +kernel
  exact of_decide_eq_true ((List.all_eq_true.mp h) r hr)

private theorem hypPts_getD_mem {i : ℕ} (hi : i < 6) : hypPts.getD i 0 ∈ hypPts := by
  have hi' : i < hypPts.length := by simpa [hypPts_length] using hi
  rw [List.getD_eq_getElem hypPts 0 hi']
  exact List.getElem_mem hi'

theorem hypGen_valid : ∀ i < 6, ∀ c ∈ hypGen i, c < 4096 := by
  intro i hi c hc
  have hmem : hypPts.getD i 0 ∈ hypPts := hypPts_getD_mem hi
  simp only [hypGen, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl
  · exact hypPts_lt _ hmem
  · exact z12_lt _

theorem hypGen_inj : ∀ i < 6, ∀ j < 6, spanSub (hypGen i) = spanSub (hypGen j) → i = j := by
  intro i hi j hj h
  have hmask : spanMask (hypGen i) = spanMask (hypGen j) :=
    (spanMask_eq_iff (hypGen_valid i hi) (hypGen_valid j hj)).mpr h
  have hcheck : ((List.range 6).all fun i => (List.range 6).all fun j =>
      (i == j) || (spanMask (hypGen i) != spanMask (hypGen j))) = true := by
    decide +kernel
  have hi' := (List.all_eq_true.mp hcheck) i (List.mem_range.mpr hi)
  have hj' := (List.all_eq_true.mp hi') j (List.mem_range.mpr hj)
  rw [Bool.or_eq_true] at hj'
  rcases hj' with heq | hne
  · exact beq_iff_eq.mp heq
  · exact absurd hmask (bne_iff_ne.mp hne)

theorem exists_hyp_image {g : Γ12} (hg : g ∈ M0) {r : ℕ} (hr : r ∈ hypPts) :
    ∃ r' ∈ hypPts, smulSub g (ptSub r) = ptSub r' := by
  obtain ⟨hgG, hstab⟩ := (mem_ptStab_iff G0 Wsub g).mp hg
  have hrlt : r < 4096 := hypPts_lt r hr
  have hrlin : r ∈ lineOf r := by simp [lineOf]
  have hrW : r ∈ spanN Wb :=
    (mem_Wb_iff hrlt).mpr (Or.inr ⟨r, List.mem_append.mpr (Or.inr hr), hrlin⟩)
  have hrO : r ∈ O1465 := hyp_mem_O1465 r hr r hrlin
  have hcW : gmv g r ∈ spanN Wb := by
    have h1 : dc r ∈ Wsub := (dc_mem_spanSub_iff Wb_valid hrlt).mpr hrW
    have h2 : glHom g (dc r) ∈ smulSub g Wsub :=
      Subgroup.mem_map_of_mem (glHom g).toMonoidHom h1
    rw [hstab, glHom_dc] at h2
    exact (dc_mem_spanSub_iff Wb_valid (gmv_lt g r)).mp h2
  have hcO : gmv g r ∈ O1465 := closed1465 hgG hrO
  have hc0 : gmv g r ≠ 0 := by
    intro h0
    exact absurd ((gmv_eq_zero_iff g hrlt).mp h0) (ne_of_gt (hypPts_pos r hr))
  obtain ⟨r', hr', hlin⟩ := mem_hyp_of_mem_O1465 hcW hc0 hcO
  refine ⟨r', hr', ?_⟩
  rw [smulSub_ptSub hgG hrlt]
  exact (ptSub_eq_of_mem (hypPts_pos r' hr') (hypPts_lt r' hr') hlin).symm

theorem exists_pM : ∃ π : ↥M0 →* Equiv.Perm (Fin 6), ∀ (g : ↥M0) (i : Fin 6),
    smulSub (g : Γ12) (spanSub (hypGen i)) = spanSub (hypGen (π g i)) := by
  refine exists_actHom M0 hypGen (n := 6) hypGen_inj ?_
  intro g hg i hi
  obtain ⟨r', hr', heq⟩ := exists_hyp_image (g := g) hg (hypPts_getD_mem hi)
  obtain ⟨j, hj, hjr'⟩ := List.mem_iff_getElem.mp hr'
  refine ⟨j, by simpa [hypPts_length] using hj, ?_⟩
  have heq' : smulSub g (ptSub (hypPts.getD i 0)) = ptSub (hypPts.getD j 0) := by
    rw [List.getD_eq_getElem hypPts 0 hj, hjr']
    exact heq
  exact heq'

noncomputable def pM : ↥M0 →* Equiv.Perm (Fin 6) := Classical.choose exists_pM

theorem pM_spec (g : ↥M0) (i : Fin 6) :
    smulSub (g : Γ12) (spanSub (hypGen i)) = spanSub (hypGen (pM g i)) :=
  Classical.choose_spec exists_pM g i

theorem pM_Q0 : ∀ q (hq : q ∈ Q0), pM ⟨q, Q0_le_M0 hq⟩ = 1 := by
  intro q hq
  apply actHom_eq_one pM hypGen hypGen_inj pM_spec
  intro i hi
  obtain ⟨hqG, hfix⟩ := (mem_cenIn_iff G0 Wsub q).mp hq
  have hgi : hypPts.getD i 0 ∈ hypPts := hypPts_getD_mem hi
  have hrlt : hypPts.getD i 0 < 4096 := hypPts_lt _ hgi
  have hrW : hypPts.getD i 0 ∈ spanN Wb :=
    (mem_Wb_iff hrlt).mpr
      (Or.inr ⟨_, List.mem_append.mpr (Or.inr hgi), by simp [lineOf]⟩)
  have hqr : gmv q (hypPts.getD i 0) = hypPts.getD i 0 := by
    have h1 : glHom q (dc (hypPts.getD i 0)) = dc (hypPts.getD i 0) :=
      hfix _ ((dc_mem_spanSub_iff Wb_valid hrlt).mpr hrW)
    rw [glHom_dc] at h1
    exact dc_inj (gmv_lt q _) hrlt h1
  rw [show spanSub (hypGen i) = ptSub (hypPts.getD i 0) from rfl,
      smulSub_ptSub hqG hrlt, hqr]

theorem pM_zU : pM ⟨zU, zU_mem_M0⟩ = 1 := by
  apply actHom_eq_one pM hypGen hypGen_inj pM_spec
  intro i hi
  have hgi : hypPts.getD i 0 ∈ hypPts := hypPts_getD_mem hi
  have hrlt : hypPts.getD i 0 < 4096 := hypPts_lt _ hgi
  have hrpos : 0 < hypPts.getD i 0 := hypPts_pos _ hgi
  have hz : gmv zU (hypPts.getD i 0) = mvN z12 (hypPts.getD i 0) := by
    rw [gmv, zU_val, colsN_decN validN_z12]
  rw [show spanSub (hypGen i) = ptSub (hypPts.getD i 0) from rfl,
      smulSub_ptSub zU_mem hrlt, hz]
  exact (ptSub_eq_of_mem hrpos hrlt (by simp [lineOf])).symm

