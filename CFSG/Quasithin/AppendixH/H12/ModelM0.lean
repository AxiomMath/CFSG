abbrev M0 : Subgroup Γ12 := ptStab glHom G0 Wsub

abbrev Q0 : Subgroup Γ12 := cenIn glHom G0 Wsub

theorem Q0_le_M0 : Q0 ≤ M0 := by
  intro g hg
  rw [mem_cenIn_iff] at hg
  obtain ⟨hgG, hfix⟩ := hg
  rw [mem_ptStab_iff]
  refine ⟨hgG, ?_⟩
  apply smulSub_eq_of_le
  rw [smulSub, Subgroup.map_le_iff_le_comap]
  intro u hu
  show glHom g u ∈ Wsub
  rw [hfix u hu]
  exact hu

theorem M0_le_G0 : M0 ≤ G0 := inf_le_left

theorem zU_mem_M0 : zU ∈ M0 := zU_mem_ptStab_Wsub

theorem zU_not_mem_Q0 : zU ∉ Q0 := by
  intro hz
  rw [mem_cenIn_iff] at hz
  obtain ⟨-, hfix⟩ := hz
  have h5 : glHom zU (dc 5) = dc 5 :=
    hfix (dc 5) (Subgroup.subset_closure ⟨5, by decide, rfl⟩)
  rw [glHom_dc] at h5
  have h1 : mvN (colsN (zU : Matrix (Fin 12) (Fin 12) (ZMod 2))) 5 = 5 :=
    dc_inj (gmv_lt zU 5) (by norm_num) h5
  have hzU : gmv zU 5 = mvN z12 5 := by
    rw [gmv, zU_val, colsN_decN validN_z12]
  have h2 : mvN z12 5 = 5 := by
    rw [← hzU]
    simpa only [gmv] using h1
  exact omega_ne (by norm_num) (by norm_num) h2

theorem zU_comm_M0 : ∀ m ∈ M0, m * zU = zU * m :=
  fun m hm => zU_comm (M0_le_G0 hm)

