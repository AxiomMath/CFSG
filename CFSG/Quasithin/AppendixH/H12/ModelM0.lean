@[expose] def m360 : List (List ℕ) := m360a ++ m360b

set_option maxRecDepth 200000 in
theorem m360_length : m360.length = 360 := by
  decide

theorem tU_m360_mem : ∀ w ∈ m360, tU w ∈ M0 := by
  intro w hw
  rw [show M0 = ptStab glHom G0 (spanSub Wb) from rfl, tU_mem_ptStab_spanSub_iff Wb_valid w]
  intro c hc
  have h : (m360.all fun w => Wb.all fun c => (spanN Wb).contains (mvN (tW w) c)) = true := by
    simp only [ModelM0K.contains_spanN_Wb, ModelM0K.tW_eq]
    decide +kernel
  exact List.contains_iff_mem.mp
    ((List.all_eq_true.mp ((List.all_eq_true.mp h) w hw)) c hc)

set_option maxRecDepth 200000 in
theorem m360_sig_nodup : (m360.map (sigOf hypGen 6)).Nodup :=
  ModelM0K.sig_nodup hypGen 6 m360 (by decide +kernel)

theorem pM_range : 360 ≤ Nat.card pM.range := by
  have h := length_le_card_range_of_sig pM hypGen hypGen_valid pM_spec m360 tU_m360_mem
    m360_sig_nodup
  rwa [m360_length] at h

