theorem planes_map_nodup : (planes.map spanSub).Nodup := by
  have hmap : (planes.map spanMask).Nodup := by decide +kernel
  have hinj : Function.Injective (fun b : {b // b ∈ planes} => spanSub b.1) := by
    intro a b hab
    apply Subtype.ext
    have hm : spanMask a.1 = spanMask b.1 :=
      (spanMask_eq_iff (planes_valid a.1 a.2) (planes_valid b.1 b.2)).mpr hab
    exact List.inj_on_of_nodup_map hmap a.2 b.2 hm
  rw [← List.attach_map_val (f := spanSub) (l := planes)]
  exact List.Nodup.map hinj (List.nodup_attach.mpr (by decide))

theorem planes_orbit : ∀ P ∈ planes.map spanSub, ∃ h ∈ G0, smulSub h Wsub = P := by
  intro P hP
  obtain ⟨b, hb, rfl⟩ := List.mem_map.mp hP
  obtain ⟨k, hk, hbk⟩ := List.mem_iff_getElem.mp hb
  have hk77 : k < 77 := by simpa [planes_length] using hk
  have hklen : k < planes.length := by simpa [planes_length] using hk77
  have hb' : b = planes.getD k [] := by
    rw [← hbk, List.getD_eq_getElem planes [] hklen]
  subst hb'
  have hvalid_k : ∀ c ∈ planes.getD k [], c < 4096 := by
    intro c hc
    exact planes_valid _ (by
      rw [List.getD_eq_getElem planes [] hklen]
      exact List.getElem_mem _) c hc
  refine ⟨tU (planeWords.getD k []), tU_mem _, ?_⟩
  have hmask : spanMask (Wb.map (mvN (tW (planeWords.getD k [])))) =
      spanMask (planes.getD k []) := by
    have hchk : ((List.range 77).all fun k =>
        spanMask (Wb.map (mvN (tW (planeWords.getD k [])))) ==
          spanMask (planes.getD k [])) = true := by
      decide +kernel
    exact beq_iff_eq.mp ((List.all_eq_true.mp hchk) k (List.mem_range.mpr hk77))
  have hvalid_map : ∀ c ∈ Wb.map (mvN (tW (planeWords.getD k []))), c < 4096 := by
    intro c hc
    obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hc
    exact mvN_lt (validN_evalW gG validN_gG (planeWords.getD k [])).2 d
  rw [show Wsub = spanSub Wb from rfl, smulSub_tU_spanSub]
  exact (spanMask_eq_iff hvalid_map hvalid_k).mp hmask

theorem card_M0_le : Nat.card M0 ≤ 17280 := by
  have h := card_mul_le_of_orbit (H := G0) Wsub (planes.map spanSub) planes_map_nodup planes_orbit
  rw [List.length_map, planes_length, card_G] at h
  change Nat.card (ptStab glHom G0 Wsub) ≤ 17280
  omega

