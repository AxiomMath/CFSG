theorem Q0_isElemAbelian : IsElemAbelian 2 Q0 := by
  have hm : qMats = ModelM0K.qQL.map CFSG.KC.Mat12P.unpackQ :=
    ModelM0K.map_tW qWords _ (by decide +kernel)
  have hcommall : qMats.all (fun a => qMats.all (fun b =>
      mulN a b == mulN b a)) = true := by
    rw [hm]
    simp only [List.all_map, Function.comp_def, CFSG.KC.Mat12P.mulN_unpackQ]
    decide +kernel
  have hsqall : qMats.all (fun a => mulN a a == tW []) = true := by
    rw [hm]
    simp only [List.all_map, Function.comp_def, CFSG.KC.Mat12P.mulN_unpackQ]
    decide +kernel
  have hcomm : ∀ a ∈ qWords.map tU, ∀ b ∈ qWords.map tU, a * b = b * a := by
    intro a ha b hb
    obtain ⟨w, hw, rfl⟩ := List.mem_map.mp ha
    obtain ⟨w', hw', rfl⟩ := List.mem_map.mp hb
    have hm : tW (w ++ w') = tW (w' ++ w) := by
      rw [tW_append, tW_append]
      exact beq_iff_eq.mp (List.all_eq_true.mp
        (List.all_eq_true.mp hcommall (tW w) (List.mem_map.mpr ⟨w, hw, rfl⟩))
        (tW w') (List.mem_map.mpr ⟨w', hw', rfl⟩))
    rw [← tU_append, ← tU_append]
    exact tU_eq_of_tW_eq hm
  have hsq : ∀ a ∈ qWords.map tU, a ^ 2 = 1 := by
    intro a ha
    obtain ⟨w, hw, rfl⟩ := List.mem_map.mp ha
    have hm : tW (w ++ w) = tW [] := by
      rw [tW_append]
      exact beq_iff_eq.mp (List.all_eq_true.mp hsqall (tW w)
        (List.mem_map.mpr ⟨w, hw, rfl⟩))
    rw [pow_two, ← tU_append, tU_eq_of_tW_eq hm, tU_nil]
  exact isElemAbelian_of_list Q0 (qWords.map tU) Q0_mem_words hcomm hsq

private theorem inv_self_vec12 (x : Vec12) : x⁻¹ = x := by
  rw [← dc_cd x]
  apply inv_eq_of_mul_eq_one_right
  show dc (cd x) * dc (cd x) = 1
  rw [← dc_xor, Nat.xor_self, dc_zero]

theorem fixV_map_eq_spanSub {X : Subgroup Γ12} {b : List ℕ} (hb : ∀ c ∈ b, c < 4096)
    (hfix : ∀ g ∈ X, ∀ c ∈ b, gmv g c = c)
    (hmax : ∀ c < 4096, (∀ g ∈ X, gmv g c = c) → c ∈ spanN b) :
    fixV (X.map glHom) = spanSub b := by
  apply le_antisymm
  · intro v hv
    rw [mem_fixV] at hv
    refine (mem_spanSub_iff hb v).mpr ?_
    refine hmax (cd v) (cd_lt v) fun g hg => ?_
    have h1 : glHom g (dc (cd v)) = dc (cd v) := by
      rw [dc_cd]
      exact hv (glHom g) (Subgroup.mem_map_of_mem glHom hg)
    rw [glHom_dc] at h1
    exact dc_inj (gmv_lt g (cd v)) (cd_lt v) h1
  · change Subgroup.closure {x | ∃ c ∈ b, x = dc c} ≤ fixV (X.map glHom)
    refine (Subgroup.closure_le (fixV (X.map glHom))).mpr ?_
    rintro x ⟨c, hc, rfl⟩
    refine (mem_fixV).mpr ?_
    intro y hy
    obtain ⟨g, hg, rfl⟩ := Subgroup.mem_map.mp hy
    exact (glHom_dc g c).trans (congrArg dc (hfix g hg c hc))

private theorem comm_eq_dc (g : Γ12) (v : Vec12) :
    glHom g v * v⁻¹ = dc (gmv g (cd v) ^^^ cd v) := by
  conv_lhs => rw [← dc_cd v]
  rw [glHom_dc, inv_self_vec12, ← dc_xor]
  simp only [gmv]

theorem commV_map_eq_spanSub {X : Subgroup Γ12} {b : List ℕ} (hb : ∀ c ∈ b, c < 4096)
    (hle : ∀ g ∈ X, ∀ c < 4096, (gmv g c ^^^ c) ∈ spanN b)
    (hge : ∀ x ∈ b, ∃ g ∈ X, ∃ c < 4096, gmv g c ^^^ c = x) :
    commV (X.map glHom) = spanSub b := by
  apply le_antisymm
  · change Subgroup.closure {w | ∃ x ∈ X.map glHom, ∃ v : Vec12, x v * v⁻¹ = w} ≤ spanSub b
    refine (Subgroup.closure_le (spanSub b)).mpr ?_
    rintro w ⟨y, hy, v, rfl⟩
    obtain ⟨g, hg, rfl⟩ := Subgroup.mem_map.mp hy
    have h4 : dc (gmv g (cd v) ^^^ cd v) ∈ spanSub b :=
      (dc_mem_spanSub_iff hb (by
        have := Nat.xor_lt_two_pow (n := 12) (gmv_lt g (cd v)) (cd_lt v)
        simpa using this)).mpr (hle g hg (cd v) (cd_lt v))
    rw [comm_eq_dc g v]
    exact h4
  · change spanSub b ≤ Subgroup.closure {w | ∃ x ∈ X.map glHom, ∃ v : Vec12, x v * v⁻¹ = w}
    refine (Subgroup.closure_le (Subgroup.closure
      {w | ∃ x ∈ X.map glHom, ∃ v : Vec12, x v * v⁻¹ = w})).mpr ?_
    rintro y ⟨x, hx, rfl⟩
    obtain ⟨g, hg, c, hc, hgc⟩ := hge x hx
    have hgen : glHom g (dc c) * (dc c)⁻¹ ∈
        Subgroup.closure {w | ∃ x ∈ X.map glHom, ∃ v : Vec12, x v * v⁻¹ = w} :=
      Subgroup.subset_closure ⟨glHom g, Subgroup.mem_map_of_mem glHom hg, dc c, rfl⟩
    have heq : glHom g (dc c) * (dc c)⁻¹ = dc x := by
      rw [glHom_dc, inv_self_vec12, ← dc_xor]
      have hx' : mvN (colsN (g : Matrix (Fin 12) (Fin 12) (ZMod 2))) c ^^^ c = x := hgc
      rw [hx']
    rwa [← heq]

theorem fixV_Q0 : fixV (Q0.map glHom) = Wsub := by
  rw [show Wsub = spanSub Wb from rfl]
  refine fixV_map_eq_spanSub Wb_valid ?_ ?_
  · intro g hg c hc
    obtain ⟨hgG, hfix⟩ := (mem_cenIn_iff G0 Wsub g).mp hg
    have hW : dc c ∈ Wsub := Subgroup.subset_closure ⟨c, hc, rfl⟩
    have h1 : glHom g (dc c) = dc c := hfix (dc c) hW
    rw [glHom_dc] at h1
    exact dc_inj (gmv_lt g c) (Wb_valid c hc) h1
  · intro c hc4096 hfixall
    have hword : (qWords.all fun w => mvN (tW w) c == c) = true := by
      apply List.all_eq_true.mpr
      intro w hw
      have h := hfixall (tU w) (tU_qWords_mem w hw)
      rw [gmv_tU] at h
      exact beq_iff_eq.mpr h
    have hchk : (List.range 4096).all (fun c =>
        !(qWords.all fun w => mvN (tW w) c == c) || (spanN Wb).contains c) = true :=
      qFixCheck_eq
    have hc' := (List.all_eq_true.mp hchk) c (List.mem_range.mpr hc4096)
    have hcont : (spanN Wb).contains c = true := by
      simpa [hword] using hc'
    exact List.contains_iff_mem.mp hcont

private theorem commV_Q0_hle
    (g : Γ12) (hg : g ∈ Q0) (c : ℕ) (hc : c < 4096) :
    gmv g c ^^^ c ∈ spanN Wb := by
  obtain ⟨w, hw, rfl⟩ := List.mem_map.mp (Q0_mem_words g hg)
  rw [gmv_tU]
  have hc' := (List.all_eq_true.mp qCommVhleCheck_eq) c (List.mem_range.mpr hc)
  have hbit := (List.all_eq_true.mp hc') w hw
  have hb := hbit
  rw [spanMask, testBit_maskOf] at hb
  exact of_decide_eq_true hb

