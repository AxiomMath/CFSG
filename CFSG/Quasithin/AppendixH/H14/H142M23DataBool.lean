@[expose] noncomputable def m23K_act (cs : List ℕ) : ℕ → ℕ :=
  List.rec (motive := fun _ => ℕ → ℕ) (fun _ => 0)
    (fun c _ ih m => Nat.xor (Bool.rec (motive := fun _ => ℕ) 0 c (Nat.beq (Nat.land m 1) 1))
      (ih (Nat.shiftRight m 1))) cs

theorem m23K_act_eq : ∀ (cs : List ℕ) (m : ℕ), m23K_act cs m = actM cs m
  | [], _ => rfl
  | c :: cs, m => by
    change Nat.xor (Bool.rec (motive := fun _ => ℕ) 0 c (Nat.beq (Nat.land m 1) 1))
      (m23K_act cs (Nat.shiftRight m 1)) = actM (c :: cs) m
    have h1 : Nat.land m 1 = m % 2 := Nat.and_one_is_mod m
    have h2 : Nat.shiftRight m 1 = m / 2 := by
      change m >>> 1 = m / 2
      rw [Nat.shiftRight_eq_div_pow, pow_one]
    rw [h1, h2, m23K_act_eq cs, actM]
    rcases Nat.mod_two_eq_zero_or_one m with h | h
    · rw [h]
      rfl
    · rw [h]
      rfl

@[expose] noncomputable def m23K_lane (T p : ℕ) : ℕ :=
  Nat.land (Nat.shiftRight T (Nat.mul 24 p)) 16777215

@[expose] noncomputable def m23K_strict (y : ℕ) (k : ℕ → Bool) : Bool :=
  Nat.rec (motive := fun _ => Bool) (k (nat_lit 0)) (fun n _ => k (Nat.succ n)) y

theorem m23K_strict_eq (y : ℕ) (k : ℕ → Bool) : m23K_strict y k = k y := by
  cases y <;> rfl

@[expose] noncomputable def m23K_walk (T : ℕ) (C₀ C₁ : List ℕ) (L : List (ℕ × ℕ × ℕ)) :
    ℕ → Bool :=
  List.rec (motive := fun _ => ℕ → Bool) (fun _ => true)
    (fun e _ ih k => Prod.rec (motive := fun _ => Bool) (fun m q =>
      Prod.rec (motive := fun _ => Bool) (fun j p =>
        Bool.and' (Nat.beq (m23K_lane T k) m) (Bool.and' (Nat.blt p k) (Bool.and' (Nat.blt j 2)
          (Bool.and' (Nat.beq m (m23K_act (Bool.rec (motive := fun _ => List ℕ) C₁ C₀ (Nat.beq j 0))
            (m23K_lane T p))) (m23K_strict (Nat.succ k) ih))))) q) e) L

@[expose] noncomputable def m23K_chk (T : ℕ) (C₀ C₁ : List ℕ) (m₀ : ℕ) (L : List (ℕ × ℕ × ℕ)) :
    Bool :=
  List.rec (motive := fun _ => Bool) false
    (fun e rest _ => Bool.and' (Nat.beq e.1 m₀)
      (Bool.and' (Nat.beq (m23K_lane T 0) e.1) (m23K_walk T C₀ C₁ rest 1))) L

theorem m23K_walk_cons (T : ℕ) (C₀ C₁ : List ℕ) (m j p : ℕ) (L : List (ℕ × ℕ × ℕ)) (k : ℕ) :
    m23K_walk T C₀ C₁ ((m, j, p) :: L) k =
      (Nat.beq (m23K_lane T k) m && (Nat.blt p k && (Nat.blt j 2 &&
        (Nat.beq m (m23K_act (Bool.rec (motive := fun _ => List ℕ) C₁ C₀ (Nat.beq j 0))
          (m23K_lane T p)) && m23K_walk T C₀ C₁ L (k + 1))))) := by
  change Bool.and' _ (Bool.and' _ (Bool.and' _ (Bool.and' _
    (m23K_strict (Nat.succ k) (m23K_walk T C₀ C₁ L))))) = _
  rw [m23K_strict_eq]

theorem m23K_walk_spec (T : ℕ) (C₀ C₁ : List ℕ) :
    ∀ (L : List (ℕ × ℕ × ℕ)) (k : ℕ), m23K_walk T C₀ C₁ L k = true →
      ∀ i (hi : i < L.length), m23K_lane T (k + i) = L[i].1 ∧ L[i].2.2 < k + i ∧
        L[i].2.1 < 2 ∧ L[i].1 = actM (if L[i].2.1 = 0 then C₀ else C₁) (m23K_lane T L[i].2.2)
  | [], _, _, i, hi => absurd hi (Nat.not_lt_zero i)
  | (m, j, p) :: L, k, h, i, hi => by
    rw [m23K_walk_cons] at h
    simp only [Bool.and_eq_true, Nat.beq_eq, Nat.blt_eq] at h
    obtain ⟨h1, h2, h3, h4, h5⟩ := h
    rcases i with _ | i
    · refine ⟨h1, h2, h3, ?_⟩
      simp only [List.getElem_cons_zero]
      rw [h4, m23K_act_eq]
      rcases j with _ | j
      · rfl
      · rfl
    · have hi' : i < L.length := by simpa using hi
      have e : k + (i + 1) = k + 1 + i := by omega
      rw [e]
      exact m23K_walk_spec T C₀ C₁ L (k + 1) h5 i hi'

theorem m23K_sound (g₀ g₁ : Array ℕ) (T : ℕ) (C₀ C₁ : List ℕ) (hC₀ : permCols g₀ = C₀)
    (hC₁ : permCols g₁ = C₁) (m₀ : ℕ) (L : List (ℕ × ℕ × ℕ)) (h : m23K_chk T C₀ C₁ m₀ L = true) :
    bfsOKg [g₀, g₁] m₀ L = true := by
  rcases L with _ | ⟨e, rest⟩
  · change false = true at h
    cases h
  change (Nat.beq e.1 m₀ && (Nat.beq (m23K_lane T 0) e.1 && m23K_walk T C₀ C₁ rest 1)) = true at h
  simp only [Bool.and_eq_true, Nat.beq_eq] at h
  obtain ⟨he, hl0, hw⟩ := h
  have W := m23K_walk_spec T C₀ C₁ rest 1 hw
  have lane : ∀ q (hq : q < rest.length + 1), m23K_lane T q = ((e :: rest).getD q (0, 0, 0)).1 := by
    intro q hq
    rcases q with _ | q
    · simpa using hl0
    · have hq' : q < rest.length := by omega
      rw [List.getD_cons_succ, List.getD_eq_getElem _ _ hq', ← (W q hq').1]
      congr 1
      omega
  unfold bfsOKg
  rw [List.all_eq_true]
  intro k hk
  rw [List.mem_range] at hk
  rcases k with _ | i
  · simpa using he
  have hi : i < rest.length := by simpa using hk
  obtain ⟨wl, wp, wj, wa⟩ := W i hi
  have hg : (rest[i]).2.1 = 0 ∨ (rest[i]).2.1 = 1 := by omega
  simp only [Nat.add_one_ne_zero, ↓reduceIte, List.getD_cons_succ, List.getD_eq_getElem _ _ hi,
    List.length_cons, List.length_nil, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq]
  refine ⟨⟨by omega, by omega⟩, ?_⟩
  rw [← lane _ (by simp; omega), wa]
  rcases hg with hg | hg
  · rw [hg]
    simp only [↓reduceIte, List.getD_cons_zero, permM, hC₀]
  · rw [hg]
    simp only [Nat.one_ne_zero, ↓reduceIte, List.getD_cons_succ, List.getD_cons_zero, permM, hC₁]

