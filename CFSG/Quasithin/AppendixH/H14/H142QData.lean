theorem qTab_ok : tabOK qTabArr = true := by decide +kernel

theorem qTab_stab : ∀ n < 16, (qTabArr[n]!)[8]! = 8 ∧ ∀ m ∈ qMasks, permM qTabArr[n]! m ∈ qMasks := by
  decide +kernel

theorem qGens_ok : ∀ a ∈ qGens, inAutOK a = true ∧ a[8]! = 8 ∧
    ∀ m ∈ qMasks, permM a m ∈ qMasks := by
  decide +kernel

theorem qGMat_eq_cmap : ∀ j < 2, ∀ n < 16, cmap qTabArr qGens[j]! n = qGMat j n := by
  decide +kernel

theorem qReps_size : qReps.size = 360 := by decide +kernel

theorem qMats_length : qMats.length = 360 := by decide +kernel

theorem qTriples_length : qTriples.length = 360 := by decide +kernel

theorem qBfs_length : qBfs.length = 360 := by decide +kernel

private theorem qReps_okB :
    (qReps.toList.all fun a => a.size == 24 && QDataK.repOKL a.toList) = true := by
  decide +kernel

theorem qReps_ok : ∀ k < 360, inAutOK qReps[k]! = true ∧ (qReps[k]!)[8]! = 8 ∧
    ∀ m ∈ qMasks, permM qReps[k]! m ∈ qMasks := by
  intro k hk
  have hs : k < qReps.size := lt_of_lt_of_eq hk qReps_size.symm
  have hm : qReps[k]! ∈ qReps.toList := by
    rw [getElem!_pos qReps k hs]
    exact Array.getElem_mem_toList hs
  exact QDataK.repOK_sound (List.all_eq_true.1 qReps_okB _ hm)

private theorem qBfs_okB : QDataK.bfsL 360 qBfs qReps.toList qGens = true := by decide +kernel

theorem qBfs_ok : qReps[0]! = id24 ∧ ∀ k < 360, 0 < k → qPar k < k ∧ qGen k < 2 ∧
    qReps[k]! = comp24 qGens[qGen k]! qReps[qPar k]! :=
  ⟨by decide +kernel, QDataK.bfs_sound qBfs_length qReps_size (QDataK.size_of_all qReps_okB)
    qBfs_okB⟩

theorem qMats_ok : (∀ n < 16, qMat 0 n = n) ∧ ∀ k < 360, 0 < k → ∀ n < 16,
    qMat k n = qGMat (qGen k) (qMat (qPar k) n) := by
  decide +kernel

theorem qMat_lt : ∀ k < 360, ∀ n < 16, qMat k n < 16 := by decide +kernel

theorem qGMat_lt : ∀ j < 2, ∀ n < 16, qGMat j n < 16 := by decide +kernel

theorem qMats_nodup : qMats.Nodup :=
  CFSG.Decide.nodup_of_bitsetNodup
    (fun M : List ℕ => M.getD 1 0 + 16 * (M.getD 2 0 + 16 * M.getD 4 0)) (by decide +kernel)

theorem qMats_len16 : ∀ M ∈ qMats, M.length = 16 := by decide +kernel

private theorem qMat_semilinB : ((List.zip qMats qTriples).all fun e =>
    decide (e.2.1 < 2) && e.1.getD 1 16 == e.2.2.1 && e.1.getD 4 16 == e.2.2.2 &&
      (List.range 4).all fun c => (List.range 16).all fun n =>
        e.1.getD (smulCode c n) 16 == smulCode (sigC e.2.1 c) (e.1.getD n 16)) = true := by
  decide +kernel

theorem qMat_semilin : ∀ k < 360, qSig k < 2 ∧ qMat k 1 = qV0 k ∧ qMat k 4 = qV1 k ∧
    ∀ c < 4, ∀ n < 16, qMat k (smulCode c n) = smulCode (sigC (qSig k) c) (qMat k n) := by
  intro k hk
  have h1 : k < qMats.length := lt_of_lt_of_eq hk qMats_length.symm
  have h2 : k < qTriples.length := lt_of_lt_of_eq hk qTriples_length.symm
  have hz : k < (List.zip qMats qTriples).length := by
    rw [List.length_zip]
    exact Nat.lt_min.2 ⟨h1, h2⟩
  have h := List.all_eq_true.1 qMat_semilinB _ (List.getElem_mem hz)
  rw [List.getElem_zip] at h
  simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, List.all_eq_true,
    List.mem_range] at h
  have e1 : qMats.getD k [] = qMats[k]'h1 := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h1, Option.getD_some]
  have e2 : qTriples.getD k (0, 0, 0) = qTriples[k]'h2 := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h2, Option.getD_some]
  simp only [qMat, qSig, qV0, qV1, e1, e2]
  exact ⟨h.1.1.1, h.1.1.2, h.1.2, h.2⟩

@[expose] def qCover : Bool :=
  (List.range 2).all fun s => (List.range 16).all fun v0 => (List.range 16).all fun v1 =>
    !goodTriple s v0 v1 || (List.range 360).any fun k => qSig k == s && qV0 k == v0 && qV1 k == v1

private theorem qCover_okB : ((List.range 2).all fun s => (List.range 16).all fun v0 =>
    (List.range 16).all fun v1 => !goodTriple s v0 v1 || decide ((s, v0, v1) ∈ qTriples)) = true := by
  decide +kernel

theorem qCover_ok : qCover = true := by
  rw [qCover]
  refine QDataK.all3_mono (fun s v0 v1 h => ?_) qCover_okB
  beta_reduce at h ⊢
  rw [Bool.or_eq_true] at h ⊢
  rcases h with h | h
  · exact Or.inl h
  · exact Or.inr (QDataK.any_of_mem qTriples_length (f0 := qSig) (f1 := qV0) (f2 := qV1)
      (fun _ => rfl) (fun _ => rfl) (fun _ => rfl) (of_decide_eq_true h))

theorem qTriples_cover : ∀ s < 2, ∀ v0 < 16, ∀ v1 < 16, goodTriple s v0 v1 = true →
    ∃ k < 360, qSig k = s ∧ qV0 k = v0 ∧ qV1 k = v1 := by
  intro s hs v0 hv0 v1 hv1 hg
  have h := qCover_ok
  simp only [qCover, List.all_eq_true, List.mem_range, Bool.or_eq_true, Bool.not_eq_true',
    List.any_eq_true, Bool.and_eq_true, beq_iff_eq] at h
  rcases h s hs v0 hv0 v1 hv1 with h' | ⟨k, hk, ⟨h1, h2⟩, h3⟩
  · rw [hg] at h'
    exact absurd h' (by decide)
  · exact ⟨k, hk, h1, h2, h3⟩

theorem qMat_selfC : ∀ k < 360, (∀ n < 16, qMat k n = n) → k = 0 := by decide +kernel

theorem qVbfs_ok : vbfsOK qTabArr qGens 1 qVbfs = true := by decide +kernel

theorem qVbfs_cover : ∀ n < 16, 0 < n → ∃ e ∈ qVbfs, e.1 = n := by decide +kernel

end CFSG.Quasithin.AppendixH.H14
