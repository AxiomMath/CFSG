theorem length_h2Codes : h2Codes.length = 960 := by decide +kernel

@[expose] def h2Word (k : Fin 960) : List (Fin 5 × Bool) :=
  wordOfCode letter2 (h2Codes[k.val]'(Nat.lt_of_lt_of_eq k.isLt length_h2Codes.symm))

theorem h2Distinct_eq_true : wordsDistinct gd2 letter2 h2Codes = true := by decide +kernel

theorem semEval_h2Word_injective :
    Function.Injective fun k : Fin 960 => semEval gd2 (h2Word k) :=
  fun _ _ h => Fin.ext (eq_of_wordsDistinct h2Distinct_eq_true _ _ h)

