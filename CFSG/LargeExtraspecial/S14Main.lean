      hSt hc hocc hext h6 h7 h8 hF
    with hU | hL
  · have hdvd := outU62Input S.Mbar (Mbar0 S) hnorm hU hcent
    have h3 := claim14_12U_of_reifartSmith (reifartSmithU62Input_of_smith hSm)
      G S g t c hSt hc hocc hext h6 h7
      h8 hF hU
    refine ⟨hw, ?_, Or.inr hU⟩
    change (Mbar0 S).index ≤ 2
    generalize (Mbar0 S).index = k at hdvd h3 ⊢
    have hk := Nat.le_of_dvd (by norm_num) hdvd
    interval_cases k <;> omega
  · exact ⟨hw, outL62Input S.Mbar (Mbar0 S) hnorm hL hcent, Or.inl hL⟩

theorem step_of_widthTwo
    (hW2 : AschbacherWidthTwoResidual) (G : Type) [Group G] [Finite G] [IsSimpleGroup G]
    (ih : ∀ (H : Type) [Group H] [Finite H] [IsSimpleGroup H], Nat.card H < Nat.card G →
      (∃ a b : H, a * b ≠ b * a) → ∀ T : Setting H, Bridge.TimmesfeldConclusion H T.width T.Mbar)
    (S : Setting G) : Bridge.TimmesfeldConclusion G S.width S.Mbar := by
  have hCE : CentralExtInput.{0} := centralExtInput
  have hHolt : CFSG.RankThree.PartTwo.Sec21.HoltUniqueFixedPointSimple :=
    CFSG.Holt.H78.holtUniqueFixedPointSimple_of_holtTheorem1 CFSG.Holt.H78.holtTheorem1
  have hFM : AschbacherSixElevenFusionMStmt :=
    aschbacherSixElevenFusionMStmt_of_inner unitaryInnerCentStmt
  have h512 : AschbacherFiveTwelveCoreStmt :=
    aschbacherFiveTwelveCoreStmt_of_fixFree asc512FixFreeStmt_proof
      suModuleEndInput
  have hRest : AschbacherSecFiveSixRest :=
    aschbacherSecFiveSixRest_of_core' h512 sixFiveTransvectionStmt aschbacherSixSevenMbarStmt
      aschbacherFiveNineOneStmt aschbacherFiveNineTwoStmt aschTwoAutStmt
      (aschbacherSixElevenFusionCoreStmt_of_fusionM hFM)
  have h63g : SmithSixThreeGenInput :=
    smithSixThreeGenInput_of S63.smith55Input S63.autL32Input S63.autA6Input
      S63.smith58Input (S63.smith59Input_of S63.u33CentInput)
      S63.j2CentInput S63.j2SchurInput
  have h63 : SmithSixThreeInput := smithSixThreeInput_of_gen h63g
  have h35 : AschbacherThreeTranspositionCore :=
    aschbacherThreeTranspositionCore_of_residuals h63 smithSixFourInput
      (aschbacherHypCore_of hW2 aschbacherTwoTwoStmt_of aschbacherTIInput
        hRest)
  have hT75 : CFSG.CGT.Timmesfeld75.SimpleCaseStmt :=
    TI75Bridge.simpleCaseStmt_of_rest
      ⟨CFSG.CGT.A8S.a8SylowInput, CFSG.CGT.M24S.m24SylowInput⟩
  have hDemp : DW.DempwolffLn2Input := DW.D73.dempwolffLn2Input_of h35
    (CFSG.CGT.Timmesfeld75.nodeStatement_of_simpleCase hT75.list)
  have h215 : CFSG.CGT.Timmesfeld75.Lemma215Stmt :=
    CFSG.CGT.Timmesfeld75.lemma215
  have hDWI : DW.DW2OutInspectionInputN :=
    DW.dw2OutInspectionInputN_of_cert DW.dw2FieldInput s12ExcModuleInputN
  have hFS : FSmith1977cOmegaInput :=
    FS77.fsmith1977cOmegaInput_of h35 (FS77.fSmith1977cW4WeakInput_of_main
      (aschbacherMainStmt_of_residuals hW2 aschbacherTwoTwoStmt_of aschbacherTIInput
        hRest)
      (smithSixFiveStmt_of h63 smithSixFourInput))
  have hInsp5 : Insp5Input :=
    insp5Input_of_residualN hDWI (inspPSL4_ofN s12PSLModuleInputN) (inspPSp_ofN s12SpModuleInputN)
      (inspPOmega_ofN s12OmegaModuleInputN hFS)
  have hTI : WeaklyClosedTITransitive.{0} :=
    TI75.weaklyClosedTITransitive_of_inputs hT75 h215
  have hTL : CFSG.CGT.Timmesfeld75.ListWCIdentification :=
    CFSG.CGT.Timmesfeld75.listWCIdentification_of_cert
  have hF2 : Form2StrongStmt := TI75.form2StrongStmt_of_inputs hT75 h215 hTL
  have hCorB : S8.TimmesfeldCorBInput := CFSG.Timmesfeld.timmesfeldCorBInput
  have hFacts : S8.CorBListFacts := S8.corBListFacts_of S8.corBSectResidual
  have hA5Facts : S8.CorBListA5Facts := S8.corBListA5Facts_of S8.corBA5Residual
  have hRes97 : S11.Residual97For111 :=
    S11.residual97For111_of hT75 h215 hTL S11.a9WCPairFact S11.m22WCPairFact
  by_contra hnc
  have hn5 : 5 ≤ S.width := by
    by_contra h
    exact hnc (Bridge.TimmesfeldConclusion.of_width_le_four (by omega))
  have hdw37 : DW.DW37Statement :=
    DW.dw37Statement_ofN CFSG.Timmesfeld.arsInput hDWI hDemp
  obtain ⟨g, haQ, hne⟩ := (claim_14_1_of_core h35 hn5).resolve_right hnc
  have hnoAll : S11.NoA2All S := fun g' h1 h2 =>
    (claim_14_2_of_insp5 rootInvolutionComponentsInput CFSG.Timmesfeld.arsInput
      S12Tri.fischerTrialityInput s12FischerStatement hInsp5 (timmesfeld36Input_of hFS)
      SL4Mod.s12SL4ModuleInput hdw37 hn5 h1 h2).resolve_right hnc
  have hno := hnoAll g haQ hne
  have hirr : ¬ S.IsReducible := fun hred => hnc (concl_of_isReducible hdw37 hn5 haQ hne hred)
  have hn6 : 6 ≤ S.width := by
    by_contra h
    exact S.false_of_width_eq_five hTI (by omega) haQ hne hno hirr
  have H := hyp4_of hTI hn5 haQ hne hno hirr
  have C := cons311_of hTI hn5 haQ hne hno hirr
  have hex := claim_14_3 hF2 Bender.benderConjCountInput hTI H C (noA2_of hno) hirr hn5
  obtain ⟨t, hSt, h89⟩ := (claim_14_5 hCE
    (S11.s11_1Stmt_of_noCommuting
      (S11.noCommuting111_of (S11.a5Input111_of S11.tiClaim111 hRes97))
      (S11.shultInput111_of_NI (S11.shultF6ResidualNI_of S11.shultF6ResidualE_of)))
    (fun _ _ _ _ S => S11.timmesfeld11_8M2 S) (S11.s11Alt4Stmt hCE)
    (S13.s13_9Stmt_of hCE)
    (S10.s10Alt4Stmt hCE)
    H C hnoAll hirr hn6 hex).resolve_right hnc
  have h83 : S8_3Stmt := s8_3Stmt_of S9.tiPairInput S8.timmesfeld83A5InfLinBadE.{0}
    S9.pgl25ConjResidual
    S9.pgl25TypeIIResidual (S8.timmesfeld83PlusGlobal4_of hT75 h215)
    S8.timmesfeld83PlusGlobal3 hCorB hFacts hA5Facts hCE
  obtain ⟨c, hocc, hext⟩ :=
    exists_config hCorB hFacts hCE h83 S9.timmesfeld93Residual
      (s9a6pglStmt_of hCE) hSt h89
  have h6 := claim_14_6 hCE hSt hocc hext
  have h7 := claim14_7 hCE G S g t c hSt hocc hext
  have h8 := (claim14_8_of hCorB hFacts hCE h83 (nqIrredStmt_of hCE)
      (nqPlus6Stmt_of hCE)) G S g t c hSt hocc hext h6 h7
  have h9 := claim14_9_of (nqIrredStmt_of hCE) (claim14_9Plus6_of hCE)
    G S g t c hSt hocc hext h6 h7 h8
  have ihM : Bridge.MainFor (Mbar0 S) :=
    Bridge.ih_subgroup S (P := fun H inst => @Bridge.MainFor H inst)
      (fun H _ _ _ hlt => (Bridge.mainFor_iff H).mpr (ih H hlt)) (Mbar0 S)
  have h10 := claim14_10_of_inputs hCE pslpsu10Input G S g t
  have h13A : Claim14_13A := claim14_13A_of_inputs hCE
  cases c with
  | omegaMinus8 =>
    exact h10 _ hSt (Or.inl rfl) hocc hext h6 h7 h8
      (h9.resolve_right (by intro h; cases h)) ihM
  | omegaPlus10 =>
    exact h10 _ hSt (Or.inr (Or.inl rfl)) hocc hext h6 h7 h8
      (h9.resolve_right (by intro h; cases h)) ihM
  | sp8 =>
    exact h10 _ hSt (Or.inr (Or.inr rfl)) hocc hext h6 h7 h8
      (h9.resolve_right (by intro h; cases h)) ihM
  | omegaMinus6 =>
    exact hnc (Bridge.TimmesfeldConclusion.of_alt5 (claim_14_12_of_widthTwo hW2 hSt (Or.inl rfl) hocc hext h6
      h7 h8 (h9.resolve_right (by intro h; cases h))))
  | omegaPlus6 =>
    exact hnc (Bridge.TimmesfeldConclusion.of_alt5 (claim_14_12_of_widthTwo hW2 hSt (Or.inr rfl) hocc hext h6
      h7 h8 (h9.resolve_right (by intro h; cases h))))
  | sp6 =>
    obtain ⟨ht, hCo2⟩ := (h13A G S g t _ hSt hocc hext h6 h7 h8
      (h9.resolve_right (by intro h; cases h))).1 rfl
    exact hnc (Bridge.TimmesfeldConclusion.of_co2 hocc.2.1
      (CFSG.Sporadic.Co2Smith.smith_co2_of_residual CFSG.Sporadic.Co2Smith.ccCensus_check
        (Sporadic.Co2Smith.smithGlobalResidual_of_G1
            (Sporadic.Co2Smith.smithG1Input_of_U62 CFSG.Sporadic.Co2Smith.smithC0Input
                Sporadic.Co2Smith.smithU62Input_holds))
        _ _ hCo2))
  | omegaPlus8a =>
    obtain ⟨ht, hCo1⟩ := (h13A G S g t _ hSt hocc hext h6 h7 h8
      (h9.resolve_right (by intro h; cases h))).2.1 rfl
    have hAS35 : AschbacherSmith35Input :=
      aschbacherSmith35Input_of_core (aschbacherSmith35Core_of_main
        (aschbacherMainStmt_of_residuals hW2 aschbacherTwoTwoStmt_of aschbacherTIInput
          hRest)
        (smithSixFiveStmt_of h63 smithSixFourInput))
    exact hnc (Bridge.TimmesfeldConclusion.of_co1 hocc.2.1
      (CFSG.Sporadic.Co1Patterson.pattersonCo1Input_of hHolt hAS35 _ _ hCo1))
  | omegaPlus12 =>
    exact hnc (Bridge.TimmesfeldConclusion.of_alt8 ((h13A G S g t _ hSt hocc hext h6 h7 h8
      (h9.resolve_right (by intro h; cases h))).2.2 rfl))
  | omegaPlus8b =>
    by_cases hF : FCt S t = Nbar S g t
    · exact hnc (Bridge.TimmesfeldConclusion.of_alt8
        (claim14_13B1_of_centralExt hCE G S g t hSt hocc hext h6 h7 h8 hF ihM))
    · exact claim14_13B2_of hCE h83 G S g t hSt hocc hext h6 h7 h8 hF

theorem mainStatement_of_widthTwo
    (hW2 : AschbacherWidthTwoResidual) : Bridge.MainStatement :=
  Bridge.mainStatement_of_setting_step fun G _ _ _ ih _ S => step_of_widthTwo hW2 G ih S

theorem mainStatement_of_inputs
    (I : Inputs) : Bridge.MainStatement := by
  exact mainStatement_of_widthTwo
    (aschbacherWidthTwoResidual_of_gh74 I.gh74 AS35W.rankTwoW2Input)

