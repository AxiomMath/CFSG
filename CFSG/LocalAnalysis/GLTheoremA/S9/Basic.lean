private theorem basic_mem_center_of_mem_center_quot {Q : Type} [Group Q] (hQ : commutator Q = ⊤)
    {O : Subgroup Q} [O.Normal] (hOZ : O ≤ Subgroup.center Q) {m : Q}
    (hm : (QuotientGroup.mk m : Q ⧸ O) ∈ Subgroup.center (Q ⧸ O)) : m ∈ Subgroup.center Q := by
  have hcomm : ∀ g : Q, ⁅m, g⁆ ∈ O := by
    intro g
    have h1 : (QuotientGroup.mk ⁅m, g⁆ : Q ⧸ O) =
        ⁅(QuotientGroup.mk m : Q ⧸ O), QuotientGroup.mk g⁆ := by
      simp only [commutatorElement_def, QuotientGroup.mk_mul, QuotientGroup.mk_inv]
    have h2 : ⁅(QuotientGroup.mk m : Q ⧸ O), (QuotientGroup.mk g : Q ⧸ O)⁆ = 1 := by
      rw [commutatorElement_eq_one_iff_mul_comm]
      exact (Subgroup.mem_center_iff.1 hm (QuotientGroup.mk g : Q ⧸ O)).symm
    exact (QuotientGroup.eq_one_iff _).1 (h1.trans h2)
  have hcen : ∀ g : Q, ⁅m, g⁆ ∈ Subgroup.center Q := fun g => hOZ (hcomm g)
  have hmul : ∀ x y : Q, ⁅m, x * y⁆ = ⁅m, x⁆ * ⁅m, y⁆ := by
    intro x y
    have hc : x * (m * y * m⁻¹ * y⁻¹) = (m * y * m⁻¹ * y⁻¹) * x :=
      Subgroup.mem_center_iff.1 (hcen y) x
    have hzx : (m * y * m⁻¹ * y⁻¹) * x⁻¹ = x⁻¹ * (m * y * m⁻¹ * y⁻¹) := by
      calc (m * y * m⁻¹ * y⁻¹) * x⁻¹ = x⁻¹ * (x * (m * y * m⁻¹ * y⁻¹)) * x⁻¹ := by group
        _ = x⁻¹ * ((m * y * m⁻¹ * y⁻¹) * x) * x⁻¹ := by rw [hc]
        _ = x⁻¹ * (m * y * m⁻¹ * y⁻¹) := by group
    rw [commutatorElement_def, commutatorElement_def, commutatorElement_def]
    calc m * (x * y) * m⁻¹ * (x * y)⁻¹ = m * x * m⁻¹ * ((m * y * m⁻¹ * y⁻¹) * x⁻¹) := by group
      _ = m * x * m⁻¹ * (x⁻¹ * (m * y * m⁻¹ * y⁻¹)) := by rw [hzx]
      _ = m * x * m⁻¹ * x⁻¹ * (m * y * m⁻¹ * y⁻¹) := by group
  have hinv : ∀ x : Q, ⁅m, x⁻¹⁆ = ⁅m, x⁆⁻¹ := by
    intro x
    have h1 := hmul x x⁻¹
    rw [mul_inv_cancel, commutatorElement_one_right] at h1
    exact eq_inv_of_mul_eq_one_right h1.symm
  have hcomm_ab : ∀ a b : Q, ⁅m, ⁅a, b⁆⁆ = 1 := by
    intro a b
    have e1 : ⁅a, b⁆ = (a * b) * (b * a)⁻¹ := by rw [commutatorElement_def]; group
    have hzz : ⁅m, a⁆ * ⁅m, b⁆ = ⁅m, b⁆ * ⁅m, a⁆ := Subgroup.mem_center_iff.1 (hcen b) _
    rw [e1, hmul (a * b) (b * a)⁻¹, hinv, hmul a b, hmul b a, hzz, mul_inv_cancel]
  have htop : (⊤ : Subgroup Q) ≤ Subgroup.centralizer ({m} : Set Q) := by
    have hle : ⁅(⊤ : Subgroup Q), ⊤⁆ ≤ Subgroup.centralizer ({m} : Set Q) := by
      rw [Subgroup.commutator_le]
      intro a _ b _
      rw [Subgroup.mem_centralizer_singleton_iff]
      have := hcomm_ab a b
      rw [commutatorElement_eq_one_iff_mul_comm] at this
      exact this.symm
    have hQ' : (⁅(⊤ : Subgroup Q), ⊤⁆ : Subgroup Q) = ⊤ := hQ
    rwa [hQ'] at hle
  exact Subgroup.mem_center_iff.2 fun g => Subgroup.mem_centralizer_singleton_iff.1 (htop (Subgroup.mem_top g))

private theorem basic_center_quot {Q : Type} [Group Q] (hQ : commutator Q = ⊤)
    {O : Subgroup Q} [O.Normal] (hOZ : O ≤ Subgroup.center Q) :
    Subgroup.center (Q ⧸ O) = (Subgroup.center Q).map (QuotientGroup.mk' O) := by
  ext x
  obtain ⟨m, rfl⟩ := QuotientGroup.mk'_surjective O x
  constructor
  · intro hm
    exact ⟨m, basic_mem_center_of_mem_center_quot hQ hOZ hm, rfl⟩
  · rintro ⟨z, hz, hzm⟩
    rw [← hzm]
    refine Subgroup.mem_center_iff.2 fun g => ?_
    obtain ⟨g', rfl⟩ := QuotientGroup.mk'_surjective O g
    rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.1 hz g']

private theorem basic_commutator_top {p : ℕ} {X L : Subgroup G} (hL : GLAPComponent p X L) :
    commutator ↥L = ⊤ := by
  apply Subgroup.map_injective (f := L.subtype) (Subgroup.subtype_injective L)
  have h1 : Subgroup.map L.subtype (⊤ : Subgroup ↥L) = L := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  rw [h1]
  show Subgroup.map L.subtype ⁅(⊤ : Subgroup ↥L), ⊤⁆ = L
  rw [Subgroup.map_commutator, h1]
  exact glaPComponent_perfect hL

private theorem basic_core_le_center {p : ℕ} {L : Subgroup G}
    (h : (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) = ⊥) :
    GLAPPrimeCore p ↥L ≤ Subgroup.center ↥L := by
  intro o ho
  rw [Subgroup.mem_center_iff]
  intro g
  have ho' : (o : G) ∈ GLAPPrimeCoreOf p L := Subgroup.mem_map.2 ⟨o, ho, rfl⟩
  have hgc : (g : G) ∈ Subgroup.centralizer (GLAPPrimeCoreOf p L : Set G) :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.1 h g.2
  exact Subtype.ext (Subgroup.mem_centralizer_iff.1 hgc (o : G) ho').symm

private theorem basic_pSimple_equiv {p : ℕ} (hp : p.Prime) {X L : Subgroup G}
    (hL : GLAPComponent p X L) (h : (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) = ⊥) :
    Nonempty (PSimple p L ≃* (↥L ⧸ Subgroup.center ↥L)) := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hOZ := basic_core_le_center h
  have hc := basic_center_quot (basic_commutator_top hL) hOZ
  exact ⟨(QuotientGroup.quotientMulEquivOfEq hc).trans
    (QuotientGroup.quotientQuotientEquivQuotient _ _ hOZ)⟩

theorem isQuasisimple_of_commutator_eq_bot {p : ℕ} (hp : p.Prime) {X L : Subgroup G}
    (hL : GLAPComponent p X L) (h : (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) = ⊥) :
    CFSG.Open.IsQuasisimple ↥L := by
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨e⟩ := basic_pSimple_equiv hp hL h
  haveI := (isQuasisimple_pQuot_of_glaPComponent hp hL).2
  exact ⟨basic_commutator_top hL, e.symm.isSimpleGroup⟩

theorem commutator_eq_bot_of_isQuasisimple {p : ℕ} (hp : p.Prime) {X L : Subgroup G}
    (hL : GLAPComponent p X L) (hq : CFSG.Open.IsQuasisimple ↥L) :
    (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) = ⊥ := by
  have hne : GLAPPrimeCore p ↥L ≠ ⊤ := by
    intro htop
    have hsub : Subsingleton (PQuot p L) := by
      unfold PQuot
      rw [htop]
      exact QuotientGroup.subsingleton_quotient_top
    exact (not_nontrivial_iff_subsingleton.2 hsub)
      (isQuasisimple_nontrivial (isQuasisimple_pQuot_of_glaPComponent hp hL))
  have hcen := le_center_of_normal_of_isQuasisimple hq (GLAPPrimeCore.normal p ↥L) hne
  rw [eq_bot_iff, Subgroup.commutator_le]
  intro l hl o ho
  obtain ⟨n, hn, rfl⟩ := Subgroup.mem_map.1 ho
  have hz := Subgroup.mem_center_iff.1 (hcen hn) ⟨l, hl⟩
  rw [Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm]
  exact congrArg Subtype.val hz

theorem nonempty_pSimple_equiv {p : ℕ} (hp : p.Prime) {X L : Subgroup G}
    (hL : GLAPComponent p X L) (hq : CFSG.Open.IsQuasisimple ↥L) :
    Nonempty (PSimple p L ≃* (↥L ⧸ Subgroup.center ↥L)) :=
  basic_pSimple_equiv hp hL (commutator_eq_bot_of_isQuasisimple hp hL hq)

theorem isChevSimple_congr {r : ℕ} {S S' : Type} [Group S] [Group S'] (e : S ≃* S') :
    IsChevSimple r S ↔ IsChevSimple r S' := by
  unfold IsChevSimple
  rw [catalogIs_congr e, catalogIs_congr e]

theorem isGB_of_isGStar {p : ℕ} {B L : Subgroup G} (h : IsGStar p B L)
    (hBL : B ≤ Subgroup.normalizer (L : Set G)) : IsGB p B L := by
  obtain ⟨E, hEB, hE, hc, hne⟩ := h
  refine ⟨E, hEB, hE, hc, hEB.trans hBL, ?_⟩
  rwa [closureIn_eq_self hBL] at hne

theorem catalogIs_k3_of_kLevel_eq_three {p : ℕ} {S : Type} [Group S] (h : kLevel p S = 3) :
    catalogIs S (k3 p) := by
  classical
  unfold kLevel at h
  by_cases h1 : IsChevSimple p S
  · rw [if_pos h1] at h
    omega
  · rw [if_neg h1] at h
    by_cases h2 : catalogIs S (k2 p)
    · rw [if_pos h2] at h
      omega
    · rw [if_neg h2] at h
      by_cases h3 : catalogIs S (k3 p)
      · exact h3
      · rw [if_neg h3] at h
        omega

private def basic_sylowOf {p : ℕ} {H R : Subgroup G} (hR : IsPGroup p R) (hRH : R ≤ H)
    (hmax : ∀ Y : Subgroup G, Y ≤ H → IsPGroup p Y → R ≤ Y → Y = R) : Sylow p ↥H where
  toSubgroup := R.subgroupOf H
  isPGroup' := hR.comap_subtype
  is_maximal' := fun {Y} hY hle => by
    have hYmap : Y.map H.subtype = R := hmax _ (Subgroup.map_subtype_le Y) (hY.map H.subtype) (by
      intro x hx
      rw [Subgroup.mem_map]
      exact ⟨⟨x, hRH hx⟩, hle (Subgroup.mem_subgroupOf.2 hx), rfl⟩)
    ext z
    rw [Subgroup.mem_subgroupOf]
    constructor
    · intro hz
      rw [← hYmap]
      exact Subgroup.mem_map.2 ⟨z, hz, rfl⟩
    · intro hz
      rw [← hYmap] at hz
      obtain ⟨w, hw, hwz⟩ := Subgroup.mem_map.1 hz
      have hwz' : w = z := Subtype.ext hwz
      rwa [hwz'] at hw

private theorem basic_maximal_of_card {p : ℕ} (hp : p.Prime) {H P : Subgroup G}
    (hP : IsPGroup p P) (hPH : P ≤ H) {m : ℕ} (hm : Nat.card H = Nat.card P * m)
    (hpm : Nat.Coprime p m) : ∀ Y : Subgroup G, Y ≤ H → IsPGroup p Y → P ≤ Y → Y = P := by
  intro Y hYH hY hPY
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨a, ha⟩ := hY.exists_card_eq
  obtain ⟨b, hb⟩ := hP.exists_card_eq
  have h1 : p ^ a ∣ p ^ b * m := by
    have := Subgroup.card_dvd_of_le hYH
    rwa [ha, hm, hb] at this
  have h2 : p ^ a ∣ p ^ b := Nat.Coprime.dvd_of_dvd_mul_right (Nat.Coprime.pow_left a hpm) h1
  have h3 : p ^ b ∣ p ^ a := by
    have := Subgroup.card_dvd_of_le hPY
    rwa [ha, hb] at this
  have hab : a = b :=
    le_antisymm ((Nat.pow_dvd_pow_iff_le_right hp.one_lt).1 h2)
      ((Nat.pow_dvd_pow_iff_le_right hp.one_lt).1 h3)
  exact (Subgroup.eq_of_le_of_card_ge hPY (le_of_eq (by rw [ha, hb, hab]))).symm

private theorem basic_exists_conj_le {p : ℕ} (hp : p.Prime) {H P Q : Subgroup G}
    (hP : IsPGroup p P) (hPH : P ≤ H) (hQ : IsPGroup p Q) (hQH : Q ≤ H) {m : ℕ}
    (hm : Nat.card H = Nat.card P * m) (hQc : Nat.card Q = Nat.card P) (hpm : Nat.Coprime p m) :
    ∃ h ∈ H, ∀ x ∈ P, h * x * h⁻¹ ∈ Q := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  have hmP := basic_maximal_of_card hp hP hPH hm hpm
  have hmQ := basic_maximal_of_card hp hQ hQH (by rw [hQc]; exact hm) hpm
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq ↥H (basic_sylowOf hP hPH hmP) (basic_sylowOf hQ hQH hmQ)
  have hQ0 : ((basic_sylowOf hQ hQH hmQ : Sylow p ↥H) : Subgroup ↥H) =
      MulAut.conj g • ((basic_sylowOf hP hPH hmP : Sylow p ↥H) : Subgroup ↥H) := by
    rw [← hg]
    rfl
  refine ⟨(g : G), g.2, fun x hx => ?_⟩
  have hx' : (⟨x, hPH hx⟩ : ↥H) ∈ ((basic_sylowOf hP hPH hmP : Sylow p ↥H) : Subgroup ↥H) :=
    Subgroup.mem_subgroupOf.2 hx
  have hmem : MulAut.conj g (⟨x, hPH hx⟩ : ↥H) ∈
      ((basic_sylowOf hQ hQH hmQ : Sylow p ↥H) : Subgroup ↥H) := by
    rw [hQ0]
    exact Subgroup.smul_mem_pointwise_smul _ _ _ hx'
  have := Subgroup.mem_subgroupOf.1 hmem
  simpa [MulAut.conj_apply, mul_assoc] using this

private theorem basic_isTwoLocal_map_conj {N : Subgroup G} (hN : IsTwoLocal N) (g : G) :
    IsTwoLocal (N.map (MulAut.conj g).toMonoidHom) := by
  obtain ⟨T, hT1, hT2, rfl⟩ := hN
  refine ⟨T.map (MulAut.conj g).toMonoidHom, ?_, hT2.map _, ?_⟩
  · intro h
    apply hT1
    rw [eq_bot_iff]
    intro x hx
    have hxm : (MulAut.conj g) x ∈ T.map (MulAut.conj g).toMonoidHom :=
      Subgroup.mem_map.2 ⟨x, hx, rfl⟩
    rw [h, Subgroup.mem_bot] at hxm
    rw [Subgroup.mem_bot]
    simpa using hxm
  · exact Subgroup.map_equiv_normalizer_eq T (MulAut.conj g)

private theorem basic_mem_normalizer_of_map_le {T : Subgroup G} {g : G}
    (h : T.map (MulAut.conj g).toMonoidHom ≤ T) : g ∈ Subgroup.normalizer (T : Set G) := by
  have hfin : T.map (MulAut.conj g).toMonoidHom = T :=
    Subgroup.eq_of_le_of_card_ge h (le_of_eq (Subgroup.card_map_of_injective (MulAut.conj g).injective).symm)
  rw [Subgroup.mem_normalizer_iff]
  intro y
  constructor
  · intro hy
    have : g * y * g⁻¹ ∈ T.map (MulAut.conj g).toMonoidHom := Subgroup.mem_map.2 ⟨y, hy, rfl⟩
    rwa [hfin] at this
  · intro hy
    rw [← hfin] at hy
    obtain ⟨z, hz, hzy⟩ := Subgroup.mem_map.1 hy
    have : z = y := by simpa [MulAut.conj_apply] using hzy
    rwa [← this]

private theorem basic_covers_map_conj {p : ℕ} {N C : Subgroup G} (hcov : Covers p N C) {g : G}
    (hg : g ∈ C) : Covers p (N.map (MulAut.conj g).toMonoidHom) C := by
  have hcov' : (N ⊓ C) ⊔ GLAPPrimeCoreOf p C = C := hcov
  have hOC : GLAPPrimeCoreOf p C ≤ C := Subgroup.map_subtype_le _
  have hCO := le_normalizer_glaPPrimeCoreOf p C
  unfold Covers
  apply le_antisymm (sup_le inf_le_right hOC)
  intro c hc
  have hx : g⁻¹ * c * g ∈ C := C.mul_mem (C.mul_mem (C.inv_mem hg) hc) hg
  have hx' : g⁻¹ * c * g ∈ (N ⊓ C) ⊔ GLAPPrimeCoreOf p C := by rw [hcov']; exact hx
  rw [← SetLike.mem_coe, Subgroup.coe_mul_of_left_le_normalizer_right (N ⊓ C) _
    (inf_le_right.trans hCO)] at hx'
  obtain ⟨n, hn, o, ho, hno⟩ := Set.mem_mul.1 hx'
  have hn' : n ∈ N ⊓ C := hn
  have hgn : g * n * g⁻¹ ∈ N.map (MulAut.conj g).toMonoidHom ⊓ C :=
    ⟨Subgroup.mem_map.2 ⟨n, hn'.1, rfl⟩, C.mul_mem (C.mul_mem hg hn'.2) (C.inv_mem hg)⟩
  have hgo : g * o * g⁻¹ ∈ GLAPPrimeCoreOf p C := (Subgroup.mem_normalizer_iff.1 (hCO hg) o).1 ho
  have hc' : c = (g * n * g⁻¹) * (g * o * g⁻¹) := by
    calc c = g * (g⁻¹ * c * g) * g⁻¹ := by group
      _ = g * (n * o) * g⁻¹ := by rw [hno]
      _ = (g * n * g⁻¹) * (g * o * g⁻¹) := by group
  rw [hc']
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hgn) (Subgroup.mem_sup_right hgo)

private theorem basic_coprime_glaPPrimeCoreOf (p : ℕ) [Fact p.Prime] (C : Subgroup G) :
    Nat.Coprime p (Nat.card (GLAPPrimeCoreOf p C : Subgroup G)) := by
  have h : Nat.card (GLAPPrimeCoreOf p C : Subgroup G) = Nat.card (CFSG.pPrimeCore p ↥C) :=
    Subgroup.card_map_of_injective (Subgroup.subtype_injective C)
  rw [h]
  exact CFSG.pPrimeCore_coprime_card

private theorem basic_exists_conj_mem {p : ℕ} (hp : p.Prime) {C N P O : Subgroup G}
    (hP : IsPGroup p P) (hPC : P ≤ C) (hOC : O ≤ C) (hCO : C ≤ Subgroup.normalizer (O : Set G))
    (hOcop : Nat.Coprime p (Nat.card O)) (hcov : (N ⊓ C) ⊔ O = C) :
    ∃ h ∈ C, ∀ x ∈ P, h * x * h⁻¹ ∈ N := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨b, hb⟩ := hP.exists_card_eq
  have hPO : P ≤ Subgroup.normalizer (O : Set G) := hPC.trans hCO
  have hHP : P ⊔ O ≤ C := sup_le hPC hOC
  have hPOinf : Nat.card (P ⊓ O : Subgroup G) = 1 := by
    have h1 : Nat.card (P ⊓ O : Subgroup G) ∣ p ^ b := by
      rw [← hb]; exact Subgroup.card_dvd_of_le inf_le_left
    have h2 : Nat.card (P ⊓ O : Subgroup G) ∣ Nat.card O := Subgroup.card_dvd_of_le inf_le_right
    have h3 : Nat.Coprime (Nat.card (P ⊓ O : Subgroup G)) p := Nat.Coprime.coprime_dvd_left h2 hOcop.symm
    exact Nat.Coprime.eq_one_of_dvd (Nat.Coprime.pow_right b h3) h1
  have hHcard : Nat.card (P ⊔ O : Subgroup G) = Nat.card P * Nat.card O := by
    have h := card_sup_mul_card_inf_of_le_normalizer (A := O) (B := P) hPO
    rw [inf_comm, hPOinf, mul_one, sup_comm, mul_comm] at h
    exact h
  have hKO : ((P ⊔ O) ⊓ N) ⊔ O = P ⊔ O := by
    apply le_antisymm (sup_le inf_le_left le_sup_right)
    intro y hy
    have hyC : y ∈ (N ⊓ C) ⊔ O := by rw [hcov]; exact hHP hy
    rw [← SetLike.mem_coe, Subgroup.coe_mul_of_left_le_normalizer_right (N ⊓ C) O
      (inf_le_right.trans hCO)] at hyC
    obtain ⟨n, hn, o, ho, hno⟩ := Set.mem_mul.1 hyC
    have hn' : n ∈ N ⊓ C := hn
    have hnH : n ∈ P ⊔ O := by
      have e : n = y * o⁻¹ := by rw [← hno]; group
      rw [e]
      exact (P ⊔ O).mul_mem hy ((P ⊔ O).inv_mem (Subgroup.mem_sup_right ho))
    rw [← hno]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_left (show n ∈ (P ⊔ O) ⊓ N from ⟨hnH, hn'.1⟩))
      (Subgroup.mem_sup_right ho)
  have hKcard : Nat.card ((P ⊔ O) ⊓ N : Subgroup G) =
      Nat.card P * Nat.card (O ⊓ ((P ⊔ O) ⊓ N) : Subgroup G) := by
    have hKle : (P ⊔ O) ⊓ N ≤ Subgroup.normalizer (O : Set G) :=
      inf_le_left.trans (hHP.trans hCO)
    have h := card_sup_mul_card_inf_of_le_normalizer (A := O) (B := (P ⊔ O) ⊓ N) hKle
    rw [sup_comm O ((P ⊔ O) ⊓ N), hKO, hHcard] at h
    have hO0 : 0 < Nat.card O := Nat.card_pos
    apply Nat.eq_of_mul_eq_mul_left hO0
    rw [← h]
    ring
  have hdvd : p ^ b ∣ Nat.card ((P ⊔ O) ⊓ N : Subgroup G) := by
    rw [hKcard, hb]
    exact dvd_mul_right _ _
  obtain ⟨Q', hQ'⟩ := Sylow.exists_subgroup_card_pow_prime p hdvd
  obtain ⟨Q, hQdef⟩ : ∃ Q : Subgroup G, Q = Q'.map ((P ⊔ O) ⊓ N).subtype := ⟨_, rfl⟩
  have hQle : Q ≤ (P ⊔ O) ⊓ N := hQdef ▸ Subgroup.map_subtype_le Q'
  have hQp : IsPGroup p Q := hQdef ▸ (IsPGroup.of_card hQ').map _
  have hQc : Nat.card Q = Nat.card P := by
    rw [hQdef, Subgroup.card_map_of_injective (Subgroup.subtype_injective _), hQ', hb]
  obtain ⟨h, hhH, hconj⟩ := basic_exists_conj_le hp hP le_sup_left hQp
    (hQle.trans inf_le_left) hHcard hQc hOcop
  exact ⟨h, hHP hhH, fun x hx => (hQle (hconj x hx)).2⟩

private theorem basic_isElemAbelian_map_conj {p : ℕ} {E : Subgroup G} (hE : IsElemAbelian p E)
    (h : G) : IsElemAbelian p (E.map (MulAut.conj h).toMonoidHom) := by
  refine ⟨IsMulCommutative.of_setLike_mul_comm fun a ha b hb => ?_, fun y hy => ?_⟩
  · obtain ⟨x, hx, rfl⟩ := Subgroup.mem_map.1 ha
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.1 hb
    show h * x * h⁻¹ * (h * y * h⁻¹) = h * y * h⁻¹ * (h * x * h⁻¹)
    rw [show h * x * h⁻¹ * (h * y * h⁻¹) = h * (x * y) * h⁻¹ by group,
      show h * y * h⁻¹ * (h * x * h⁻¹) = h * (y * x) * h⁻¹ by group,
      isElemAbelian_commute hE hx hy]
  · obtain ⟨x, hx, rfl⟩ := Subgroup.mem_map.1 hy
    show (h * x * h⁻¹) ^ p = 1
    rw [conj_pow, hE.2 x hx, mul_one, mul_inv_cancel]

private theorem basic_exists_sylow_two {O : Subgroup G} (hev : Even (Nat.card O)) :
    ∃ T : Subgroup G, IsPGroup 2 T ∧ T ≠ ⊥ ∧ T ≤ O ∧
      ∃ m : ℕ, Nat.card O = Nat.card T * m ∧ Nat.Coprime 2 m := by
  classical
  haveI : Fintype ↥O := Fintype.ofFinite _
  obtain ⟨S⟩ : Nonempty (Sylow 2 ↥O) := Sylow.nonempty
  have hS0 : S.toSubgroup ≠ ⊥ := by
    intro hbot
    have h2 : 2 ∣ Fintype.card ↥O := by rw [← Nat.card_eq_fintype_card]; exact even_iff_two_dvd.1 hev
    obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card (G := ↥O) 2 h2
    have hZ : IsPGroup 2 (Subgroup.zpowers x) :=
      IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hx, pow_one])
    have hzb : Subgroup.zpowers x = S.toSubgroup := S.is_maximal' hZ (by rw [hbot]; exact bot_le)
    have hx1 : x = 1 := Subgroup.mem_bot.1 (by rw [← hbot, ← hzb]; exact Subgroup.mem_zpowers x)
    rw [hx1, orderOf_one] at hx
    exact absurd hx (by norm_num)
  refine ⟨S.toSubgroup.map O.subtype, S.isPGroup'.map _, ?_, Subgroup.map_subtype_le _,
    S.toSubgroup.index, ?_, ?_⟩
  · intro hbot
    apply hS0
    rw [eq_bot_iff]
    intro y hy
    have hyG : (y : G) ∈ S.toSubgroup.map O.subtype := Subgroup.mem_map.2 ⟨y, hy, rfl⟩
    rw [hbot, Subgroup.mem_bot] at hyG
    exact Subgroup.mem_bot.2 (Subtype.ext hyG)
  · rw [Subgroup.card_map_of_injective (Subgroup.subtype_injective O)]
    exact (Subgroup.card_mul_index _).symm
  · exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).2 S.not_dvd_index

private theorem basic_covers_of_sylow {C O T : Subgroup G} (hOC : O ≤ C)
    (hCO : C ≤ Subgroup.normalizer (O : Set G)) (hT2 : IsPGroup 2 T) (hTO : T ≤ O)
    {m : ℕ} (hm : Nat.card O = Nat.card T * m) (hcop : Nat.Coprime 2 m) :
    (Subgroup.normalizer (T : Set G) ⊓ C) ⊔ O = C := by
  apply le_antisymm (sup_le inf_le_right hOC)
  intro c hc
  have hcO : c ∈ Subgroup.normalizer (O : Set G) := hCO hc
  have hTc : T.map (MulAut.conj c).toMonoidHom ≤ O := by
    rintro _ ⟨t, ht, rfl⟩
    exact (Subgroup.mem_normalizer_iff.1 hcO t).1 (hTO ht)
  have hTc2 : IsPGroup 2 (T.map (MulAut.conj c).toMonoidHom) := hT2.map _
  have hTcc : Nat.card (T.map (MulAut.conj c).toMonoidHom) = Nat.card T :=
    Subgroup.card_map_of_injective (MulAut.conj c).injective
  obtain ⟨h, hhO, hconj⟩ := basic_exists_conj_le Nat.prime_two hT2 hTO hTc2 hTc hm hTcc hcop
  have hgC : c⁻¹ * h ∈ C := C.mul_mem (C.inv_mem hc) (hOC hhO)
  have hgT : T.map (MulAut.conj (c⁻¹ * h)).toMonoidHom ≤ T := by
    rintro _ ⟨t, ht, rfl⟩
    obtain ⟨s, hs, hs'⟩ := Subgroup.mem_map.1 (hconj t ht)
    have e : (MulAut.conj (c⁻¹ * h)) t = s := by
      have hs2 : c * s * c⁻¹ = h * t * h⁻¹ := hs'
      calc (MulAut.conj (c⁻¹ * h)) t = c⁻¹ * (h * t * h⁻¹) * c := by
            simp only [MulAut.conj_apply]; group
        _ = c⁻¹ * (c * s * c⁻¹) * c := by rw [hs2]
        _ = s := by group
    show (MulAut.conj (c⁻¹ * h)) t ∈ T
    rw [e]
    exact hs
  have hgN : c⁻¹ * h ∈ Subgroup.normalizer (T : Set G) := basic_mem_normalizer_of_map_le hgT
  have hc' : c = h * (c⁻¹ * h)⁻¹ := by group
  rw [hc']
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_right hhO)
    (Subgroup.mem_sup_left ⟨Subgroup.inv_mem _ hgN, C.inv_mem hgC⟩)

theorem isMaxRankIn_of_covers {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {B C N : Subgroup G}
    (hB : GLAIsBmax p B) (hN : IsTwoLocal N) (hcov : Covers p N C) : IsMaxRankIn p B C := by
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨T, hT1, hT2, rfl⟩ := hN
  intro E hEC hE
  obtain ⟨h, -, hconj⟩ := basic_exists_conj_mem hp (isPGroup_of_isElemAbelian hE) hEC
    (Subgroup.map_subtype_le _) (le_normalizer_glaPPrimeCoreOf p C)
    (basic_coprime_glaPPrimeCoreOf p C) hcov
  have hE' := basic_isElemAbelian_map_conj hE h
  have hsub : E.map (MulAut.conj h).toMonoidHom ≤ Subgroup.normalizer (T : Set G) := by
    intro y hy
    obtain ⟨x, hx, rfl⟩ := Subgroup.mem_map.1 hy
    exact hconj x hx
  have hcard : Nat.card (E.map (MulAut.conj h).toMonoidHom) = Nat.card E :=
    Subgroup.card_map_of_injective (MulAut.conj h).injective
  have hle := card_le_pow_glaTwoLocalRank hp hE' hT1 hT2 hsub
  rw [hcard] at hle
  rw [hB.2.1]
  exact hle

theorem isSC_of_isMaxRankIn {p : ℕ} (hp : p.Prime) {B : Subgroup G} {x : G}
    (hB : IsElemAbelian p B) (hx : x ∈ B)
    (hmax : IsMaxRankIn p B (Subgroup.centralizer ({x} : Set G))) : IsSC p B := by
  refine ⟨hB, fun g hg hord => ?_⟩
  by_contra hgB
  have hgc : ∀ b ∈ B, b * g = g * b := fun b hb => Subgroup.mem_centralizer_iff.1 hg b hb
  have hgx : g ∈ Subgroup.centralizer ({x} : Set G) := by
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact (hgc x hx).symm
  have hzle : Subgroup.zpowers g ≤ Subgroup.centralizer ({x} : Set G) :=
    Subgroup.zpowers_le.2 hgx
  have hEC : B ⊔ Subgroup.zpowers g ≤ Subgroup.centralizer ({x} : Set G) :=
    sup_le (isElemAbelian_le_centralizer hB hx) hzle
  have hgN : g ∈ Subgroup.normalizer (B : Set G) := by
    rw [Subgroup.mem_normalizer_iff]
    intro h
    constructor
    · intro hh
      have e : g * h * g⁻¹ = h := by rw [← hgc h hh]; group
      rw [e]
      exact hh
    · intro hc
      have hc' := hgc _ hc
      have e : g⁻¹ * (g * h * g⁻¹) * g = g * h * g⁻¹ := by
        calc g⁻¹ * (g * h * g⁻¹) * g = g⁻¹ * ((g * h * g⁻¹) * g) := by group
          _ = g⁻¹ * (g * (g * h * g⁻¹)) := by rw [hc']
          _ = g * h * g⁻¹ := by group
      have e' : h = g⁻¹ * (g * h * g⁻¹) * g := by group
      rw [e', e]
      exact hc
  have hle : Subgroup.zpowers g ≤ Subgroup.normalizer (B : Set G) := Subgroup.zpowers_le.2 hgN
  have hcard := card_sup_mul_card_inf_of_le_normalizer (A := B) (B := Subgroup.zpowers g) hle
  rw [Nat.card_zpowers, hord] at hcard
  have hdec : ∀ y ∈ B ⊔ Subgroup.zpowers g, ∃ b ∈ B, ∃ k : ℤ, y = g ^ k * b := by
    intro y hy
    rw [sup_comm, ← SetLike.mem_coe, Subgroup.coe_mul_of_left_le_normalizer_right _ B hle] at hy
    obtain ⟨z, hz, b, hb, rfl⟩ := Set.mem_mul.1 hy
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hz
    exact ⟨b, hb, k, rfl⟩
  have hgp : g ^ p = 1 := hord ▸ pow_orderOf_eq_one g
  have hEab : IsElemAbelian p (B ⊔ Subgroup.zpowers g : Subgroup G) := by
    refine ⟨IsMulCommutative.of_setLike_mul_comm fun a ha b hb => ?_, fun y hy => ?_⟩
    · obtain ⟨b1, hb1, k, rfl⟩ := hdec a ha
      obtain ⟨b2, hb2, l, rfl⟩ := hdec b hb
      have c1 : Commute b1 b2 := isElemAbelian_commute hB hb1 hb2
      have c2 : Commute (g ^ k) b2 := Commute.zpow_left (show Commute g b2 from (hgc b2 hb2).symm) k
      have c3 : Commute b1 (g ^ l) := Commute.zpow_right (show Commute b1 g from hgc b1 hb1) l
      have c4 : Commute (g ^ k) (g ^ l) := (Commute.refl g).zpow_zpow k l
      have c5 : Commute (g ^ k * b1) (g ^ l) := (c4.mul_left c3)
      have c6 : Commute (g ^ k * b1) b2 := (c2.mul_left c1)
      exact (c5.mul_right c6)
    · obtain ⟨b1, hb1, k, rfl⟩ := hdec y hy
      have c2 : Commute (g ^ k) b1 := Commute.zpow_left (show Commute g b1 from (hgc b1 hb1).symm) k
      rw [c2.mul_pow, hB.2 b1 hb1, mul_one]
      have hgk : (g ^ k) ^ p = 1 := by
        rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hgp, one_zpow]
      exact hgk
  have hEle := hmax (B ⊔ Subgroup.zpowers g) hEC hEab
  have hBpos : 0 < Nat.card B := Nat.card_pos
  have hpk : p ≤ Nat.card (B ⊓ Subgroup.zpowers g : Subgroup G) := by
    have h1 : Nat.card (B ⊔ Subgroup.zpowers g : Subgroup G) * Nat.card (B ⊓ Subgroup.zpowers g : Subgroup G)
        ≤ Nat.card B * Nat.card (B ⊓ Subgroup.zpowers g : Subgroup G) := Nat.mul_le_mul_right _ hEle
    rw [hcard] at h1
    exact Nat.le_of_mul_le_mul_left h1 hBpos
  have hkp : Nat.card (B ⊓ Subgroup.zpowers g : Subgroup G) ∣ p := by
    have := Subgroup.card_dvd_of_le (inf_le_right : B ⊓ Subgroup.zpowers g ≤ Subgroup.zpowers g)
    rwa [Nat.card_zpowers, hord] at this
  have hkeq : Nat.card (B ⊓ Subgroup.zpowers g : Subgroup G) = p :=
    le_antisymm (Nat.le_of_dvd hp.pos hkp) hpk
  have hinf : B ⊓ Subgroup.zpowers g = Subgroup.zpowers g :=
    Subgroup.eq_of_le_of_card_ge inf_le_right (by rw [hkeq, Nat.card_zpowers, hord])
  exact hgB (Subgroup.zpowers_le.1 (inf_eq_right.1 hinf))

theorem exists_covers_of_even {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {C : Subgroup G}
    (hev : Even (Nat.card (GLAPPrimeCoreOf p C))) : ∃ N : Subgroup G, IsTwoLocal N ∧ Covers p N C := by
  obtain ⟨T, hT2, hT0, hTO, m, hm, hcop⟩ := basic_exists_sylow_two hev
  exact ⟨Subgroup.normalizer (T : Set G), ⟨T, hT0, hT2, rfl⟩,
    basic_covers_of_sylow (Subgroup.map_subtype_le _) (le_normalizer_glaPPrimeCoreOf p C) hT2 hTO hm
      hcop⟩

theorem exists_covers_conj {p : ℕ} (hp : p.Prime) {C N P : Subgroup G} (hP : IsPGroup p P)
    (hPC : P ≤ C) (hN : IsTwoLocal N) (hcov : Covers p N C) :
    ∃ N' : Subgroup G, IsTwoLocal N' ∧ Covers p N' C ∧ P ≤ N' := by
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨h, hhC, hconj⟩ := basic_exists_conj_mem hp hP hPC (Subgroup.map_subtype_le _)
    (le_normalizer_glaPPrimeCoreOf p C) (basic_coprime_glaPPrimeCoreOf p C) hcov
  have hinv : h⁻¹ ∈ C := C.inv_mem hhC
  refine ⟨N.map (MulAut.conj h⁻¹).toMonoidHom, basic_isTwoLocal_map_conj hN h⁻¹,
    basic_covers_map_conj hcov hinv, fun y hy => ?_⟩
  refine Subgroup.mem_map.2 ⟨h * y * h⁻¹, hconj y hy, ?_⟩
  show h⁻¹ * (h * y * h⁻¹) * h⁻¹⁻¹ = y
  group

theorem covers_of_le {p : ℕ} {M C : Subgroup G} (h : C ≤ M) : Covers p M C := by
  unfold Covers
  rw [inf_eq_right.2 h]
  exact sup_eq_left.2 (by
    intro g hg
    obtain ⟨g', _, rfl⟩ := hg
    exact g'.2)

theorem isBmax_of_covers {p : ℕ} (hp : p.Prime) {B B₀ C N : Subgroup G} (hB : GLAIsBmax p B)
    (hB₀C : B₀ ≤ C) (hB₀ : IsElemAbelian p B₀) (hcard : Nat.card B₀ = Nat.card B)
    (hN : IsTwoLocal N) (hcov : Covers p N C) : GLAIsBmax p B₀ := by
  obtain ⟨N', ⟨T, hT1, hT2, hN'⟩, -, hB₀N'⟩ :=
    exists_covers_conj hp (isPGroup_of_isElemAbelian hB₀) hB₀C hN hcov
  refine ⟨hB₀, hcard.trans hB.2.1, T, hT1, hT2, ?_⟩
  rw [← hN']
  exact hB₀N'

theorem pCoreOf_le_of_isSubnormal {q : ℕ} (hq : q.Prime) {L X : Subgroup G}
    (h : IsSubnormal L X) : pCoreOf q L ≤ pCoreOf q X := by
  haveI : Fact q.Prime := ⟨hq⟩
  exact CFSG.LocalAnalysis.GLTheoremB.pCoreOf_le_of_isSubnormal q h

theorem le_of_isSubnormal_commutator_eq {J X I S : Subgroup G} (hJX : IsSubnormal J X)
    (hIJ : I ≤ J) (hSX : S ≤ X) (hSI : (⁅S, I⁆ : Subgroup G) = S) : S ≤ J := by
  induction hJX generalizing I S with
  | refl H => exact hSX
  | @step H M K hHM hn hMK ih =>
    have hIM : I ≤ M := hIJ.trans hHM
    have hSM : S ≤ M := ih hIM hSX hSI
    have hcomm : (⁅S, I⁆ : Subgroup G) ≤ H := by
      rw [Subgroup.commutator_le]
      intro s hs i hi
      have hsM : s ∈ M := hSM hs
      have hiM : i ∈ M := hHM (hIJ hi)
      have hc : (⟨s, hsM⟩ : ↥M) * ⟨i, hiM⟩ * (⟨s, hsM⟩ : ↥M)⁻¹ ∈ H.subgroupOf M :=
        hn.conj_mem ⟨i, hiM⟩ (Subgroup.mem_subgroupOf.2 (hIJ hi)) ⟨s, hsM⟩
      rw [Subgroup.mem_subgroupOf] at hc
      rw [commutatorElement_def]
      exact H.mul_mem (by simpa using hc) (H.inv_mem (hIJ hi))
    exact hSI.symm.trans_le hcomm

private theorem basic_subsingleton_of_perfect_solvable {Q : Type} [Group Q]
    (hQ : commutator Q = ⊤) [hs : Group.IsSolvable Q] : Subsingleton Q := by
  obtain ⟨n, hn⟩ := (Group.isSolvable_def Q).1 hs
  have key : ∀ k : ℕ, derivedSeries Q k = ⊤ := by
    intro k
    induction k with
    | zero => exact derivedSeries_zero Q
    | succ k ih =>
      rw [derivedSeries_succ, ih]
      exact hQ
  have h1 : (⊤ : Subgroup Q) = ⊥ := by rw [← key n, hn]
  have hall : ∀ x : Q, x = 1 := by
    intro x
    have hx : x ∈ (⊥ : Subgroup Q) := h1 ▸ Subgroup.mem_top x
    exact Subgroup.mem_bot.1 hx
  exact ⟨fun a b => by rw [hall a, hall b]⟩

private theorem basic_commutator_quot {Q : Type} [Group Q] (hQ : commutator Q = ⊤)
    (N : Subgroup Q) [N.Normal] : commutator (Q ⧸ N) = ⊤ := by
  have hs : Function.Surjective (QuotientGroup.mk' N) := QuotientGroup.mk'_surjective N
  have h1 : Subgroup.map (QuotientGroup.mk' N) (⊤ : Subgroup Q) = ⊤ := by
    rw [← MonoidHom.range_eq_map, MonoidHom.range_eq_top.2 hs]
  have h2 : ⁅Subgroup.map (QuotientGroup.mk' N) (⊤ : Subgroup Q),
      Subgroup.map (QuotientGroup.mk' N) (⊤ : Subgroup Q)⁆ =
        Subgroup.map (QuotientGroup.mk' N) ⊤ := by
    rw [← Subgroup.map_commutator]
    show Subgroup.map _ (commutator Q) = _
    rw [hQ]
  rw [h1] at h2
  exact h2

private theorem basic_central_pow_p {p : ℕ} (hp : p.Prime) {Q : Type} [Group Q] [Finite Q]
    (hO : pPrimeCore p Q = ⊥) {x : Q} (hx : x ∈ Subgroup.center Q) :
    ∃ k : ℕ, x ^ (p ^ k) = 1 := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hx0 : orderOf x ≠ 0 := (orderOf_pos_iff.mpr (isOfFinOrder_of_finite x)).ne'
  have hzc : Subgroup.zpowers x ≤ Subgroup.center Q := Subgroup.zpowers_le.2 hx
  have hpow : orderOf x = p ^ (orderOf x).primeFactorsList.length := by
    apply Nat.eq_prime_pow_of_unique_prime_dvd hx0
    intro d hd hdx
    by_contra hne
    haveI : Fact d.Prime := ⟨hd⟩
    haveI : Fintype (Subgroup.zpowers x) := Fintype.ofFinite _
    have hdz : d ∣ Fintype.card (Subgroup.zpowers x) := by
      rw [← Nat.card_eq_fintype_card, Nat.card_zpowers]
      exact hdx
    obtain ⟨y, hy⟩ := exists_prime_orderOf_dvd_card (G := Subgroup.zpowers x) d hdz
    have hyc : (y : Q) ∈ Subgroup.center Q := hzc y.2
    have hnorm : (Subgroup.zpowers (y : Q)).Normal := by
      refine ⟨fun n hn g => ?_⟩
      have hnc : n ∈ Subgroup.center Q := (Subgroup.zpowers_le.2 hyc) hn
      have e : g * n * g⁻¹ = n := by
        rw [Subgroup.mem_center_iff.1 hnc g]
        group
      rw [e]
      exact hn
    have hcop : Nat.Coprime p (Nat.card (Subgroup.zpowers (y : Q))) := by
      rw [Nat.card_zpowers, Subgroup.orderOf_coe, hy]
      exact (Nat.coprime_primes hp hd).2 (fun h => hne h.symm)
    have hNle : Subgroup.zpowers (y : Q) ≤ pPrimeCore p Q := le_sSup ⟨hnorm, hcop⟩
    rw [hO, le_bot_iff] at hNle
    have h1 : (y : Q) = 1 := Subgroup.mem_bot.1 (hNle ▸ Subgroup.mem_zpowers (y : Q))
    have h2 : orderOf (y : Q) = d := by rw [Subgroup.orderOf_coe, hy]
    rw [h1, orderOf_one] at h2
    exact hd.one_lt.ne h2
  exact ⟨_, by rw [← hpow]; exact pow_orderOf_eq_one x⟩

private theorem basic_normal_inf_centralizer {L Q : Subgroup G}
    (h : L ≤ Subgroup.normalizer (Q : Set G)) :
    ((L ⊓ Subgroup.centralizer (Q : Set G)).subgroupOf L).Normal := by
  refine ⟨fun n hn g => ?_⟩
  rw [Subgroup.mem_subgroupOf, Subgroup.mem_inf] at hn ⊢
  refine ⟨L.mul_mem (L.mul_mem g.2 n.2) (L.inv_mem g.2), ?_⟩
  refine Subgroup.mem_centralizer_iff.2 (fun y hy => ?_)
  have hg : (g : G) ∈ Subgroup.normalizer (Q : Set G) := h g.2
  have hy' : (g : G)⁻¹ * y * g ∈ Q := by
    have := (Subgroup.mem_normalizer_iff.1 (Subgroup.inv_mem _ hg) y).1 hy
    simpa using this
  have hc := Subgroup.mem_centralizer_iff.1 hn.2 _ hy'
  simp only [Subgroup.coe_mul, Subgroup.coe_inv]
  calc y * ((g : G) * (n : G) * (g : G)⁻¹)
      = (g : G) * (((g : G)⁻¹ * y * (g : G)) * (n : G)) * (g : G)⁻¹ := by group
    _ = (g : G) * ((n : G) * ((g : G)⁻¹ * y * (g : G))) * (g : G)⁻¹ := by rw [hc]
    _ = ((g : G) * (n : G) * (g : G)⁻¹) * y := by group

private theorem basic_caseB {p q : ℕ} (hp : p.Prime) (hq : q.Prime) {X L K : Subgroup G}
    (hL : GLAPComponent p X L)
    (hodd : Odd (Nat.card (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G))) (hKL : K ≤ L)
    (hKn : (K.subgroupOf L).Normal)
    (hact : ∀ k ∈ K, ∃ n : ℕ, k ^ (q ^ n) ∈ Subgroup.centralizer (pCoreOf q L : Set G))
    (hQ : ¬ pCoreOf q L ≤ Subgroup.centralizer (L : Set G))
    (hK : (K.subgroupOf L).map (QuotientGroup.mk' (GLAPPrimeCore p ↥L)) = ⊤) : False := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : Fact q.Prime := ⟨hq⟩
  have hOL : GLAPPrimeCoreOf p L ≤ L := Subgroup.map_subtype_le _
  have hML : (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) ≤ L := commutator_le_of_le' le_rfl hOL
  have hsolv : Group.IsSolvable ↥(⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) :=
    CFSG.FeitThompson.isSolvable_of_odd_natCard _ hodd
  set C : Subgroup G := L ⊓ Subgroup.centralizer (pCoreOf q L : Set G) with hCdef
  have hCn : (C.subgroupOf L).Normal :=
    basic_normal_inf_centralizer (CFSG.LieType.BorelTits.le_normalizer_pCoreOf q L)
  have hdec : ∀ l ∈ L, ∃ k ∈ K, ∃ o ∈ GLAPPrimeCoreOf p L, l = k * o := by
    intro l hl
    have hmem : (QuotientGroup.mk' (GLAPPrimeCore p ↥L) (⟨l, hl⟩ : ↥L)) ∈
        (K.subgroupOf L).map (QuotientGroup.mk' (GLAPPrimeCore p ↥L)) := by
      rw [hK]
      exact Subgroup.mem_top _
    obtain ⟨k', hk', hk'eq⟩ := Subgroup.mem_map.1 hmem
    have hrel : k'⁻¹ * (⟨l, hl⟩ : ↥L) ∈ GLAPPrimeCore p ↥L := QuotientGroup.eq.1 hk'eq
    refine ⟨(k' : G), Subgroup.mem_subgroupOf.1 hk', ((k'⁻¹ * (⟨l, hl⟩ : ↥L) : ↥L) : G),
      Subgroup.mem_map.2 ⟨_, hrel, rfl⟩, ?_⟩
    simp
  let R : Subgroup ↥L := K.subgroupOf L ⊔ C.subgroupOf L
  haveI hRn : R.Normal := Subgroup.sup_normal _ _
  have hKR : ∀ k : ↥L, k.1 ∈ K → k ∈ R := fun k hk => Subgroup.mem_sup_left (Subgroup.mem_subgroupOf.2 hk)
  have hcommQ : commutator (↥L ⧸ R) = ⊤ := basic_commutator_quot (basic_commutator_top hL) R
  let φ : ↥(⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) →* ↥L ⧸ R :=
    (QuotientGroup.mk' R).comp (Subgroup.inclusion hML)
  have hcls : ∀ x : ↥L ⧸ R, ∃ o : ↥L, o.1 ∈ GLAPPrimeCoreOf p L ∧ x = QuotientGroup.mk' R o := by
    intro x
    obtain ⟨l, rfl⟩ := QuotientGroup.mk'_surjective R x
    obtain ⟨k, hk, o, ho, hlo⟩ := hdec l.1 l.2
    refine ⟨⟨o, hOL ho⟩, ho, ?_⟩
    have hl' : l = (⟨k, hKL hk⟩ : ↥L) * ⟨o, hOL ho⟩ := Subtype.ext hlo
    have h1 : QuotientGroup.mk' R (⟨k, hKL hk⟩ : ↥L) = 1 :=
      (QuotientGroup.eq_one_iff _).2 (hKR _ hk)
    rw [hl', map_mul, h1, one_mul]
  have hφ : Function.Surjective φ := by
    rw [← MonoidHom.range_eq_top]
    apply top_le_iff.1
    rw [← hcommQ]
    show ⁅(⊤ : Subgroup (↥L ⧸ R)), ⊤⁆ ≤ φ.range
    rw [Subgroup.commutator_le]
    intro x _ y _
    obtain ⟨o1, ho1, rfl⟩ := hcls x
    obtain ⟨o2, ho2, rfl⟩ := hcls y
    have hmem : (⁅o1.1, o2.1⁆ : G) ∈ (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) :=
      Subgroup.commutator_mem_commutator o1.2 ho2
    refine ⟨⟨⁅o1.1, o2.1⁆, hmem⟩, ?_⟩
    have heq : (Subgroup.inclusion hML ⟨⁅o1.1, o2.1⁆, hmem⟩ : ↥L) = ⁅o1, o2⁆ :=
      Subtype.ext (by simp [commutatorElement_def])
    show (QuotientGroup.mk' R) (Subgroup.inclusion hML ⟨⁅o1.1, o2.1⁆, hmem⟩) = _
    rw [heq, map_commutatorElement]
  haveI : Group.IsSolvable (↥L ⧸ R) := Group.isSolvable_of_surjective hφ
  haveI : Subsingleton (↥L ⧸ R) := basic_subsingleton_of_perfect_solvable hcommQ
  have hLR : ∀ l : ↥L, l ∈ R := fun l => (QuotientGroup.eq_one_iff l).1 (Subsingleton.elim _ _)
  have hkc : ∀ l : ↥L, ∃ k : ↥L, k.1 ∈ K ∧ ∃ c : ↥L, c.1 ∈ C ∧ l = k * c := by
    intro l
    obtain ⟨k, hk, c, hc, hkc'⟩ := Subgroup.mem_sup_of_normal_right.1 (hLR l)
    exact ⟨k, Subgroup.mem_subgroupOf.1 hk, c, Subgroup.mem_subgroupOf.1 hc, hkc'.symm⟩
  have hQ2 : IsPGroup q (↥L ⧸ C.subgroupOf L) := by
    intro x
    obtain ⟨l, rfl⟩ := QuotientGroup.mk'_surjective (C.subgroupOf L) x
    obtain ⟨k, hk, c, hc, rfl⟩ := hkc l
    obtain ⟨n, hn⟩ := hact k.1 hk
    refine ⟨n, ?_⟩
    have hcC : c ∈ C.subgroupOf L := Subgroup.mem_subgroupOf.2 hc
    have hkC : k ^ (q ^ n) ∈ C.subgroupOf L := by
      refine Subgroup.mem_subgroupOf.2 ?_
      rw [hCdef, Subgroup.coe_pow, Subgroup.mem_inf]
      exact ⟨L.pow_mem k.2 _, hn⟩
    have hc1 : QuotientGroup.mk' (C.subgroupOf L) c = 1 := (QuotientGroup.eq_one_iff c).2 hcC
    have hk1 : QuotientGroup.mk' (C.subgroupOf L) (k ^ (q ^ n)) = 1 :=
      (QuotientGroup.eq_one_iff _).2 hkC
    rw [map_mul, hc1, mul_one, ← map_pow, hk1]
  haveI : Group.IsNilpotent (↥L ⧸ C.subgroupOf L) := hQ2.isNilpotent
  haveI : Subsingleton (↥L ⧸ C.subgroupOf L) :=
    basic_subsingleton_of_perfect_solvable (basic_commutator_quot (basic_commutator_top hL) _)
  apply hQ
  intro x hx
  rw [Subgroup.mem_centralizer_iff]
  intro l hl
  have hlC : (⟨l, hl⟩ : ↥L) ∈ C.subgroupOf L :=
    (QuotientGroup.eq_one_iff _).1 (Subsingleton.elim _ _)
  have hlc : l ∈ Subgroup.centralizer (pCoreOf q L : Set G) := (Subgroup.mem_subgroupOf.1 hlC).2
  exact (Subgroup.mem_centralizer_iff.1 hlc x hx).symm

theorem le_oPPrimeP_of_acts_as_q_group {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hqp : q ≠ p)
    {X L K : Subgroup G} (hL : GLAPComponent p X L)
    (hodd : Odd (Nat.card (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G))) (hKL : K ≤ L)
    (hKn : (K.subgroupOf L).Normal)
    (hact : ∀ k ∈ K, ∃ n : ℕ, k ^ (q ^ n) ∈ Subgroup.centralizer (pCoreOf q L : Set G))
    (hQ : ¬ pCoreOf q L ≤ Subgroup.centralizer (L : Set G)) : K ≤ oPPrimeP p L := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  by_cases hK : (K.subgroupOf L).map (QuotientGroup.mk' (GLAPPrimeCore p ↥L)) = ⊤
  · exact (basic_caseB hp hq hL hodd hKL hKn hact hQ hK).elim
  ·
    have hKbn : ((K.subgroupOf L).map (QuotientGroup.mk' (GLAPPrimeCore p ↥L))).Normal :=
      hKn.map _ (QuotientGroup.mk'_surjective _)
    have hcen := le_center_of_normal_of_isQuasisimple
      (isQuasisimple_pQuot_of_glaPComponent hp hL) hKbn hK
    have hO : pPrimeCore p (PQuot p L) = ⊥ := pPrimeCore_quotient_eq_bot hp
    have hKp : IsPGroup p ↥((K.subgroupOf L).map (QuotientGroup.mk' (GLAPPrimeCore p ↥L))) := by
      intro x
      obtain ⟨k, hk⟩ := basic_central_pow_p hp hO (hcen x.2)
      exact ⟨k, Subtype.ext (by simpa using hk)⟩
    have hle : (K.subgroupOf L).map (QuotientGroup.mk' (GLAPPrimeCore p ↥L)) ≤
        CFSG.pCore p (PQuot p L) := le_sSup ⟨hKbn, hKp⟩
    intro k hk
    exact Subgroup.mem_map.2 ⟨⟨k, hKL hk⟩,
      hle (Subgroup.mem_map.2 ⟨⟨k, hKL hk⟩, Subgroup.mem_subgroupOf.2 hk, rfl⟩), rfl⟩

theorem exists_prime_noncentral {p : ℕ} (hp : p.Prime) {X L : Subgroup G}
    (hL : GLAPComponent p X L) (hne : (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) ≠ ⊥)
    (hodd : Odd (Nat.card (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G))) :
    ∃ q : ℕ, q.Prime ∧ q ≠ 2 ∧ q ≠ p ∧ ¬ pCoreOf q L ≤ Subgroup.centralizer (L : Set G) := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  by_contra hcon
  push Not at hcon
  have hOL : GLAPPrimeCoreOf p L ≤ L := Subgroup.map_subtype_le _
  have hLO : L ≤ Subgroup.normalizer (GLAPPrimeCoreOf p L : Set G) :=
    le_normalizer_glaPPrimeCoreOf p L
  have hcop := basic_coprime_glaPPrimeCoreOf p L
  have hML : (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) ≤ L := commutator_le_of_le' le_rfl hOL
  have hMO : (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) ≤ GLAPPrimeCoreOf p L := by
    rw [Subgroup.commutator_le]
    intro l hl o ho
    rw [commutatorElement_def]
    have h1 : l * o * l⁻¹ ∈ GLAPPrimeCoreOf p L :=
      (Subgroup.mem_normalizer_iff.1 (hLO hl) o).1 ho
    exact (GLAPPrimeCoreOf p L).mul_mem h1 ((GLAPPrimeCoreOf p L).inv_mem ho)
  have hMcop : ¬ p ∣ Nat.card (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) := by
    intro hd
    have h2 : p ∣ Nat.card (GLAPPrimeCoreOf p L : Subgroup G) := hd.trans (Subgroup.card_dvd_of_le hMO)
    exact (Nat.Prime.coprime_iff_not_dvd hp).1 hcop h2
  have hMstab : ∀ l ∈ L, (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G).map (MulAut.conj l).toMonoidHom ≤
      (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) := by
    intro l hl
    rw [Subgroup.map_commutator]
    refine Subgroup.commutator_mono ?_ ?_
    · rintro _ ⟨x, hx, rfl⟩
      exact L.mul_mem (L.mul_mem hl hx) (L.inv_mem hl)
    · rintro _ ⟨x, hx, rfl⟩
      exact (Subgroup.mem_normalizer_iff.1 (hLO hl) x).1 hx
  have hLnorm : L ≤ Subgroup.normalizer ((⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) : Set G) :=
    fun l hl => basic_mem_normalizer_of_map_le (hMstab l hl)
  have hMn : ((⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G).subgroupOf L).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hML).2 hLnorm
  have hMconj : ∀ l ∈ L, ∀ m ∈ (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G),
      l * m * l⁻¹ ∈ (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) := fun l hl m hm =>
    hMstab l hl (Subgroup.mem_map.2 ⟨m, hm, rfl⟩)
  have hsolv : Group.IsSolvable ↥(⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) :=
    CFSG.FeitThompson.isSolvable_of_odd_natCard _ hodd
  have hF : (CFSG.fittingSubgroup ↥(⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G)).map
      (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G).subtype ≤ Subgroup.centralizer (L : Set G) := by
    rw [CFSG.fitting_eq_sup_pCore, Subgroup.map_iSup]
    refine iSup_le fun i => ?_
    have hmem := i.1.2
    have hq := Nat.prime_of_mem_primeFactors hmem
    have hqd := Nat.dvd_of_mem_primeFactors hmem
    have hq2 : i.1.1 ≠ 2 := by
      intro h2
      rw [h2] at hqd
      exact absurd (Odd.of_dvd_nat hodd hqd) (by decide)
    have hqp : i.1.1 ≠ p := by
      intro hpq
      rw [hpq] at hqd
      exact hMcop hqd
    exact (pCoreOf_le_of_normal i.1.1 hML hMn).trans (hcon i.1.1 hq hq2 hqp)
  have hMC : (⁅L, (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G)⁆ : Subgroup G) ≤
      Subgroup.centralizer (L : Set G) := by
    rw [Subgroup.commutator_le]
    intro l hl m hm
    have hm' : m ∈ L := hML hm
    have hxL : ⁅l, m⁆ ∈ L := by
      rw [commutatorElement_def]
      exact L.mul_mem (L.mul_mem (L.mul_mem hl hm') (L.inv_mem hl)) (L.inv_mem hm')
    have hx : ⁅l, m⁆ ∈ (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) := by
      rw [commutatorElement_def]
      exact (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G).mul_mem (hMconj l hl m hm)
        ((⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G).inv_mem hm)
    let x : ↥(⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) := ⟨⁅l, m⁆, hx⟩
    have hxF : x ∈ CFSG.fittingSubgroup ↥(⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) := by
      apply CFSG.centralizer_fittingSubgroup_le_fittingSubgroup_of_solvable hsolv
      rw [Subgroup.mem_centralizer_iff]
      intro f hf
      apply Subtype.ext
      have hfC : (f : G) ∈ Subgroup.centralizer (L : Set G) :=
        hF (Subgroup.mem_map.2 ⟨f, hf, rfl⟩)
      exact (Subgroup.mem_centralizer_iff.1 hfC _ hxL).symm
    exact hF (Subgroup.mem_map.2 ⟨x, hxF, rfl⟩)
  have hMperf : ⁅L, L⁆ = L := glaPComponent_perfect hL
  have s1 : ⁅⁅L, (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G)⁆, (L : Subgroup G)⁆ = ⊥ := by
    rw [eq_bot_iff, Subgroup.commutator_le]
    intro x hx l hl
    rw [Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm]
    exact (Subgroup.mem_centralizer_iff.1 (hMC hx) l hl).symm
  have s2 : ⁅⁅(⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G), (L : Subgroup G)⁆, (L : Subgroup G)⁆ = ⊥ := by
    rw [Subgroup.commutator_comm (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) (L : Subgroup G)]
    exact s1
  have s3 := Subgroup.commutator_commutator_eq_bot_of_rotate s1 s2
  rw [hMperf] at s3
  have s6 : ⁅⁅GLAPPrimeCoreOf p L, (L : Subgroup G)⁆, (L : Subgroup G)⁆ = ⊥ := by
    rw [Subgroup.commutator_comm (GLAPPrimeCoreOf p L) (L : Subgroup G)]
    rw [Subgroup.commutator_comm] at s3
    exact s3
  have s7 := Subgroup.commutator_commutator_eq_bot_of_rotate (H₁ := L) (H₂ := L)
    (H₃ := GLAPPrimeCoreOf p L) (by
      rw [Subgroup.commutator_comm] at s3
      exact s3) s6
  rw [hMperf] at s7
  exact hne s7

theorem exists_critical_q1 {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) {L : Subgroup G}
    (hQ : ¬ pCoreOf q L ≤ Subgroup.centralizer (L : Set G)) :
    ∃ Q₁ : Subgroup G, Q₁ ≤ pCoreOf q L ∧ Q₁ ≠ ⊥ ∧
      Subgroup.normalizer (L : Set G) ≤ Subgroup.normalizer (Q₁ : Set G) ∧
      (∀ g ∈ Q₁, g ^ q = 1) ∧
      (∀ a ∈ Q₁, ∀ b ∈ Q₁, ∀ c ∈ Q₁, ⁅a, b⁆ * c = c * ⁅a, b⁆) ∧
      ∀ g ∈ L ⊓ Subgroup.centralizer (Q₁ : Set G),
        ∃ n : ℕ, g ^ (q ^ n) ∈ Subgroup.centralizer (pCoreOf q L : Set G) := by
  classical
  haveI : Fact q.Prime := ⟨hq⟩
  have hPne : pCoreOf q L ≠ ⊥ := fun h => hQ (h ▸ bot_le)
  have hPp : IsPGroup q ↥(pCoreOf q L) := CFSG.LieType.BorelTits.pCoreOf_isPGroup q L
  haveI : Nontrivial ↥(pCoreOf q L) := (Subgroup.nontrivial_iff_ne_bot _).2 hPne
  obtain ⟨D, hDchar, hDne, hDcomm, hDexp, hDfix⟩ :=
    CFSG.SectionRank.Ccomm.odd_critical_exponent_subgroup hq2 hPp
  refine ⟨D.map (pCoreOf q L).subtype, Subgroup.map_subtype_le D, ?_, ?_, ?_, ?_, ?_⟩
  · intro h
    exact hDne (Subgroup.map_injective (Subgroup.subtype_injective _)
      (h.trans (Subgroup.map_bot _).symm))
  · intro g hg
    have hgP : g ∈ Subgroup.normalizer ((pCoreOf q L : Subgroup G) : Set G) :=
      CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf q L hg
    apply basic_mem_normalizer_of_map_le
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨d, hd, rfl⟩ := Subgroup.mem_map.1 hx
    have hfix := (Subgroup.characteristic_iff_map_eq.1 hDchar)
      ((pCoreOf q L).normalizerMonoidHom ⟨g, hgP⟩)
    have hmem : (pCoreOf q L).normalizerMonoidHom ⟨g, hgP⟩ d ∈ D := by
      rw [← hfix]
      exact Subgroup.mem_map_of_mem _ hd
    refine Subgroup.mem_map.2 ⟨_, hmem, ?_⟩
    simp [Subgroup.normalizerMonoidHom_apply_apply_coe]
  · intro g hg
    obtain ⟨d, hd, rfl⟩ := Subgroup.mem_map.1 hg
    show ((d : ↥(pCoreOf q L)) : G) ^ q = 1
    rw [← Subgroup.coe_pow, hDexp d hd, Subgroup.coe_one]
  · intro a ha b hb c hc
    obtain ⟨a', ha', rfl⟩ := Subgroup.mem_map.1 ha
    obtain ⟨b', hb', rfl⟩ := Subgroup.mem_map.1 hb
    obtain ⟨c', hc', rfl⟩ := Subgroup.mem_map.1 hc
    have h1 : ⁅a', b'⁆ ∈ Subgroup.centralizer (D : Set ↥(pCoreOf q L)) :=
      (hDcomm (Subgroup.commutator_mem_commutator ha' (Subgroup.mem_top b'))).2
    have h2 := Subgroup.mem_centralizer_iff.1 h1 c' hc'
    have h4 := congrArg (Subtype.val : ↥(pCoreOf q L) → G) h2
    simp only [Subgroup.coe_mul] at h4
    have h3 : (((⁅a', b'⁆ : ↥(pCoreOf q L))) : G) = ⁅(a' : G), (b' : G)⁆ := by
      simp [commutatorElement_def]
    rw [h3] at h4
    exact h4.symm
  · intro g hg
    obtain ⟨hgL, hgC⟩ := hg
    have hgN : g ∈ Subgroup.normalizer ((pCoreOf q L : Subgroup G) : Set G) :=
      CFSG.LieType.BorelTits.le_normalizer_pCoreOf q L hgL
    have hαD : (pCoreOf q L).normalizerMonoidHom ⟨g, hgN⟩ ∈
        fixingSubgroup (MulAut ↥(pCoreOf q L)) (D : Set ↥(pCoreOf q L)) := by
      rw [mem_fixingSubgroup_iff]
      intro d hd
      apply Subtype.ext
      rw [MulAut.smul_def, Subgroup.normalizerMonoidHom_apply_apply_coe]
      have hcd := Subgroup.mem_centralizer_iff.1 hgC (d : G) (Subgroup.mem_map_of_mem _ hd)
      show g * (d : G) * g⁻¹ = (d : G)
      rw [← hcd]
      group
    obtain ⟨n, hn⟩ := hDfix ⟨_, hαD⟩
    refine ⟨n, ?_⟩
    have hαn : (pCoreOf q L).normalizerMonoidHom ⟨g, hgN⟩ ^ (q ^ n) = 1 := by
      simpa using congrArg Subtype.val hn
    have hpow : (pCoreOf q L).normalizerMonoidHom ((⟨g, hgN⟩ : Subgroup.normalizer ((pCoreOf q L : Subgroup G) : Set G)) ^ (q ^ n)) = 1 := by
      rw [map_pow, hαn]
    refine Subgroup.mem_centralizer_iff.2 fun x hx => ?_
    have hx' := congrArg Subtype.val (congrArg (fun φ => φ ⟨x, hx⟩) hpow)
    simp only [Subgroup.normalizerMonoidHom_apply_apply_coe, MulAut.one_apply, Subgroup.coe_pow] at hx'
    have key : (g ^ (q ^ n)) * x * (g ^ (q ^ n))⁻¹ = x := by simpa using hx'
    calc x * g ^ (q ^ n) = g ^ (q ^ n) * x * (g ^ (q ^ n))⁻¹ * g ^ (q ^ n) := by rw [key]
      _ = g ^ (q ^ n) * x := by group

theorem normal_inf_centralizer {L Q : Subgroup G} (h : L ≤ Subgroup.normalizer (Q : Set G)) :
    ((L ⊓ Subgroup.centralizer (Q : Set G)).subgroupOf L).Normal := by
  refine ⟨fun n hn g => ?_⟩
  rw [Subgroup.mem_subgroupOf, Subgroup.mem_inf] at hn ⊢
  refine ⟨L.mul_mem (L.mul_mem g.2 n.2) (L.inv_mem g.2), ?_⟩
  refine Subgroup.mem_centralizer_iff.2 (fun y hy => ?_)
  have hg : (g : G) ∈ Subgroup.normalizer (Q : Set G) := h g.2
  have hy' : (g : G)⁻¹ * y * g ∈ Q := by
    have := (Subgroup.mem_normalizer_iff.1 (Subgroup.inv_mem _ hg) y).1 hy
    simpa using this
  have hc := Subgroup.mem_centralizer_iff.1 hn.2 _ hy'
  simp only [Subgroup.coe_mul, Subgroup.coe_inv]
  calc y * ((g : G) * (n : G) * (g : G)⁻¹)
      = (g : G) * (((g : G)⁻¹ * y * (g : G)) * (n : G)) * (g : G)⁻¹ := by group
    _ = (g : G) * ((n : G) * ((g : G)⁻¹ * y * (g : G))) * (g : G)⁻¹ := by rw [hc]
    _ = ((g : G) * (n : G) * (g : G)⁻¹) * y := by group

theorem exists_setup {p : ℕ} (hp : p.Prime) {X L : Subgroup G} (hL : GLAPComponent p X L)
    (hne : (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) ≠ ⊥)
    (hodd : Odd (Nat.card (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G))) :
    ∃ (q : ℕ) (Q₁ : Subgroup G), Setup92 p q L Q₁ := by
  obtain ⟨q, hq, hq2, hqp, hQ⟩ := exists_prime_noncentral hp hL hne hodd
  obtain ⟨Q₁, hQ₁le, hQ₁ne, hnorm, hexp, hcl, hact⟩ := exists_critical_q1 hq hq2 hQ
  refine ⟨q, Q₁, ⟨hq, hq2, hqp, hQ₁le, hexp, hcl, hnorm, ?_, hQ₁ne⟩⟩
  have hLn := normal_inf_centralizer (L := L) (Q := Q₁) (fun l hl => hnorm (Subgroup.le_normalizer hl))
  exact le_oPPrimeP_of_acts_as_q_group hp hq hqp hL hodd inf_le_left hLn hact hQ

end CFSG.LocalAnalysis.GLTheoremA.S9

namespace CFSG.LocalAnalysis.GLTheoremA

open CFSG.Open CFSG.Yardstones.Md0ec50421ce4 CFSG.LocalAnalysis.GLTheoremB
open scoped commutatorElement

variable {G : Type} [Group G] [Finite G]

section H92Facts

variable {p : ℕ} {B : Subgroup G} {x : G} {L : Subgroup G}

theorem H92.le_cx (h : H92 p B x L) : B ≤ S9.cx x :=
  isElemAbelian_le_centralizer h.bmax.1 h.mem

theorem H92.inf_centMod_eq (h : H92 p B x L) : B ⊓ centModSubgroup p L = Subgroup.zpowers x := by
  ext b
  constructor
  · rintro ⟨hbB, hbc⟩
    exact (h.cent b hbB).1 (centMod_iff.2 hbc)
  · intro hb
    have hbB : b ∈ B := (Subgroup.zpowers_le.2 h.mem) hb
    exact ⟨hbB, centMod_iff.1 ((h.cent b hbB).2 hb)⟩

theorem H92.card_inf_centMod (hp : p.Prime) (h : H92 p B x L) :
    Nat.card ↥(B ⊓ centModSubgroup p L) = p := by
  haveI : Fact p.Prime := ⟨hp⟩
  rw [h.inf_centMod_eq, Nat.card_zpowers]
  exact orderOf_eq_prime (h.bmax.1.2 x h.mem) h.ne_one

theorem H92.pow_four_le (hc : S9Ctx G p) (h : H92 p B x L) : p ^ 4 ≤ Nat.card B := by
  rw [h.bmax.2.1]
  exact Nat.pow_le_pow_right hc.ctx.prime.pos hc.ctx.rank_ge

theorem H92.pow_three_mul_le (hc : S9Ctx G p) (h : H92 p B x L) :
    p ^ 3 * Nat.card ↥(B ⊓ centModSubgroup p L) ≤ Nat.card B := by
  rw [h.card_inf_centMod hc.ctx.prime, ← pow_succ]
  exact h.pow_four_le hc

end H92Facts

theorem S9.isKGroup_cx {p : ℕ} (hc : S9Ctx G p) {x : G} (hx : x ≠ 1) :
    CFSG.Open.IsKGroup ↥(S9.cx x) :=
  isKGroup_of_isKProper hc.ctx.kProper (centralizer_ne_top_of_ne_one hc.ctx.simple hc.ctx.nonabelian hx)

theorem S9.fullCoverLevel_min_eq_dLevel {p : ℕ} {B : Subgroup G} {x : G} {L : Subgroup G}
    (h : IsS0 p B x L) (hnoG : ¬ IsGStar p B L) :
    min 4 (fullCoverLevel p (PQuot p L)) = dLevel G p := by
  have := h.2
  unfold tripleLevel at this
  rwa [if_neg hnoG] at this

theorem S9.fullCoverLevel_le_four (p : ℕ) (Q : Type) [Group Q] : fullCoverLevel p Q ≤ 4 := by
  classical
  unfold fullCoverLevel
  split_ifs <;> omega

theorem S9.k3Cover_of_fullCoverLevel_eq_three {p : ℕ} {Q : Type} [Group Q]
    (h : fullCoverLevel p Q = 3) : K3Cover p Q := by
  classical
  unfold fullCoverLevel at h
  by_cases h1 : K1Cover p Q
  · rw [if_pos h1] at h
    omega
  · rw [if_neg h1] at h
    by_cases h2 : K2Cover p Q
    · rw [if_pos h2] at h
      omega
    · rw [if_neg h2] at h
      by_cases h3 : K3Cover p Q
      · exact h3
      · rw [if_neg h3] at h
        omega

theorem S9.k1_or_k2_of_fullCoverLevel_le_two {p : ℕ} {Q : Type} [Group Q]
    (h : fullCoverLevel p Q ≤ 2) : K1Cover p Q ∨ K2Cover p Q := by
  classical
  unfold fullCoverLevel at h
  by_cases h1 : K1Cover p Q
  · exact Or.inl h1
  · rw [if_neg h1] at h
    by_cases h2 : K2Cover p Q
    · exact Or.inr h2
    · rw [if_neg h2] at h
      by_cases h3 : K3Cover p Q
      · rw [if_pos h3] at h
        omega
      · rw [if_neg h3] at h
        omega


end CFSG.LocalAnalysis.GLTheoremA
