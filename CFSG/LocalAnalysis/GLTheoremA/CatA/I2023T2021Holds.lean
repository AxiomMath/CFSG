private theorem i2tHold_pp_eq {q q' : TauCeti.PrimePower} (hq : q.p = 2) (h : q'.card = q.card) :
    q'.p = 2 ∧ q'.exponent = q.exponent := by
  have hcardq : q'.p ^ q'.exponent = 2 ^ q.exponent := by
    rw [← TauCeti.PrimePower.card_def, h, TauCeti.PrimePower.card_def, hq]
  have hp2 : q'.p = 2 := by
    have hdvd : q'.p ∣ 2 ^ q.exponent := by
      rw [← hcardq]
      exact dvd_pow_self _ (Nat.pos_iff_ne_zero.1 q'.exponent_pos)
    exact (Nat.prime_dvd_prime_iff_eq q'.prime_p Nat.prime_two).1 (q'.prime_p.dvd_of_dvd_pow hdvd)
  refine ⟨hp2, ?_⟩
  have h2 := hcardq
  rw [hp2] at h2
  exact Nat.pow_right_injective (le_refl 2) h2

private theorem i2tHold_model {S : Type} [Group S] {q : TauCeti.PrimePower} (hq : q.p = 2)
    (hcat : catalogIs S (isTD4Of q)) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (σ : K ≃+* K),
      Nat.card K = (2 ^ q.exponent) ^ 3 ∧ (∀ c, σ c = c ^ (2 ^ q.exponent)) ∧
      (∃ Θ : MulAut (graphFixedRootGroup TwistTag.D4 K σ.toRingHom) →* (K ≃+* K),
        Θ.ker = (MulAut.conj : graphFixedRootGroup TwistTag.D4 K σ.toRingHom →*
          MulAut (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)).range) ∧
      Nonempty (S ≃* graphFixedRootGroup TwistTag.D4 K σ.toRingHom) ∧
      CFSG.Blueprint.ChevalleyExceptionalModel S .trialityD4 2 q.exponent := by
  obtain ⟨d, hv, hP, ⟨eS⟩⟩ := CFSG.LocalAnalysis.GLTheoremA.CatB.exists_lieIndex hcat
  cases d with
  | trialityD4 q' =>
    have hP' : q'.card = q.card := hP
    obtain ⟨hp2, hn⟩ := i2tHold_pp_eq hq hP'
    obtain ⟨K, _, _, σ, hK, hσ, hΘ, ⟨eC⟩⟩ :=
      CFSG.HardMathSupport.Timmesfeld.CrossChar.exists_catEquiv_trialityD4 q' hv
    have hqc : q'.card = q'.p ^ q'.exponent := TauCeti.PrimePower.card_def q'
    obtain ⟨eB⟩ := CFSG.TauCetiBridge.Even.chevalleyBridgesAll.trialityD4 q' hv K
      (by rw [hqc]; exact hK) σ.toRingHom (fun x => by rw [hqc]; exact hσ x)
    rw [hp2, hn] at hK
    simp only [hp2, hn] at hσ
    refine ⟨K, inferInstance, inferInstance, σ, hK, hσ, hΘ, ⟨eS.trans eC⟩,
      ⟨⟨Nat.prime_two, q.exponent_pos, rfl⟩, ?_⟩⟩
    exact ⟨K, inferInstance, inferInstance, hK, σ.toRingHom, hσ, ⟨eS.trans eB.symm⟩⟩
  | _ => exact hP.elim

