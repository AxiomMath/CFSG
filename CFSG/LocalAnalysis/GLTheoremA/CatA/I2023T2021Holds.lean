    have h0 := congrFun (CFSG.LieType.Chevalley.rootDiagUnit_injective h') ⟨0, by decide⟩
    exact hz1 h0
  have hd₂n : d₂ ∉ Subgroup.zpowers d₁ := by
    rintro ⟨k, hk⟩
    have hk' : CFSG.LocalAnalysis.ComponentInitial.FourGroupChevalley.rootDiagUnit TwistTag.D4.tag
        ((CFSG.RankThree.Chevalley.SteinbergBT.TrialityPlane.outerTuple z) ^ k) =
        CFSG.LocalAnalysis.ComponentInitial.FourGroupChevalley.rootDiagUnit TwistTag.D4.tag
          (CFSG.RankThree.Chevalley.SteinbergBT.TrialityPlane.middleTuple z) := by
      have := congrArg Subtype.val hk
      rw [Subgroup.coe_zpow, hd₁def, hd₂def] at this
      rw [← this]
      exact map_zpow (CFSG.LieType.Chevalley.rootDiagUnitHom TwistTag.D4.tag K) _ k
    have h2 := congrFun (CFSG.LieType.Chevalley.rootDiagUnit_injective hk') ⟨2, by decide⟩
    simp only [Pi.pow_apply, CFSG.RankThree.Chevalley.SteinbergBT.TrialityPlane.outerTuple,
      CFSG.RankThree.Chevalley.SteinbergBT.TrialityPlane.middleTuple] at h2
    have e3 : z ^ (-3 : ℤ) = 1 := by
      rw [zpow_neg, inv_eq_one]
      exact_mod_cast hz3
    change (z ^ (-3 : ℤ)) ^ k = z ^ (2 : ℤ) at h2
    rw [e3, one_zpow] at h2
    exact hz1 h2.symm
  have hVcard : Nat.card V = 9 := by
    have hVp : IsPGroup 3 V := CFSG.Open.IsElemAbelian.isPGroup hVel
    obtain ⟨m, hm⟩ := (IsPGroup.iff_card).1 hVp
    have hd₁o : orderOf d₁ = 3 := by
      exact orderOf_eq_prime (hVel.2 _ hd₁mem) hd₁1
    have hZle : Subgroup.zpowers d₁ ≤ V := (Subgroup.zpowers_le).2 hd₁mem
    have hZc : Nat.card (Subgroup.zpowers d₁) = 3 := by rw [Nat.card_zpowers, hd₁o]
    have hdvd : 3 ∣ Nat.card V := hZc ▸ Subgroup.card_dvd_of_le hZle
    have hne : Nat.card V ≠ 3 := by
      intro h3V
      have heq : Subgroup.zpowers d₁ = V :=
        Subgroup.eq_of_le_of_card_ge hZle (by rw [h3V, hZc])
      exact hd₂n (heq ▸ hd₂mem)
    rw [hm] at hV9 hdvd hne ⊢
    have hm2 : m ≤ 2 := by
      by_contra hlt
      push Not at hlt
      have : 3 ^ 3 ≤ 3 ^ m := Nat.pow_le_pow_right (by norm_num) hlt
      omega
    interval_cases m <;> simp_all
  have hdvdr : 3 ^ r ∣ Nat.card V := by
    rw [hVcard, show (9 : ℕ) = 3 ^ 2 by norm_num]
    exact pow_dvd_pow 3 hr
  obtain ⟨E₁, hE₁⟩ := Sylow.exists_subgroup_card_pow_prime 3 hdvdr
  refine ⟨E₁.map V.subtype, ?_, ?_, ?_, ?_⟩
  · have hE₁el : IsElemAbelian 3 E₁ := by
      refine ⟨⟨⟨fun a b => Subtype.ext ?_⟩⟩, fun x _ => ?_⟩
      · exact hVel.1.is_comm.comm (a : V) (b : V)
      · apply Subtype.ext
        rw [Subgroup.coe_pow, Subgroup.coe_one]
        exact hVel.2 _ x.2
    exact CFSG.Open.IsElemAbelian.map hE₁el V.subtype
  · rw [Subgroup.card_map_of_injective V.subtype_injective, hE₁]
  · rintro _ ⟨x, -, rfl⟩
    exact hfixV _ x.2
  set U₀ : Subgroup C :=
    (CFSG.LieType.Chevalley.graphFixedPosUnipotent TwistTag.D4 K σ.toRingHom).subgroupOf C with hU₀
  have hmapU : U₀.map (fieldActor σ σ).toMonoidHom = U₀ :=
    CFSG.OddStandard.GH71.S55.d4_fieldActor_map_U σ σ
  refine ⟨U₀, CFSG.LieType.Chevalley.isPGroup_graphFixedPosUnipotent_subgroupOf 2, ?_, ?_, ?_, ?_, ?_⟩
  ·
    set a₀ : Fin TwistTag.D4.foldedTag.rank := ⟨0, by decide⟩ with ha₀
    let f : CFSG.LieType.Chevalley.orbitField TwistTag.D4 K σ.toRingHom a₀ → U₀ := fun c =>
      ⟨CFSG.LieType.Chevalley.fixedOrbitX TwistTag.D4 K σ.toRingHom a₀ c,
        Subgroup.mem_subgroupOf.2
          (CFSG.LieType.Chevalley.orbitX_mem_graphFixedPosUnipotent TwistTag.D4 σ.toRingHom a₀ c)⟩
    have hf : Function.Injective f := fun c c' h =>
      CFSG.LieType.Chevalley.fixedOrbitX_injective a₀ (congrArg Subtype.val h)
    have hle := Nat.card_le_card_of_injective f hf
    have htop : CFSG.LieType.Chevalley.orbitField TwistTag.D4 K σ.toRingHom a₀ = ⊤ :=
      CFSG.LieType.Chevalley.orbitField_D4_zero_eq_top σ
        (fun c => by
          have := congrArg (fun τ : K ≃+* K => τ c) hσ3
          simpa [pow_succ] using this)
    have hcardF : Nat.card (CFSG.LieType.Chevalley.orbitField TwistTag.D4 K σ.toRingHom a₀) =
        2 ^ (3 * n) := by
      rw [htop, ← hK3]
      exact Nat.card_congr (Subfield.topEquiv : (⊤ : Subfield K) ≃+* K).toEquiv
    have h64 : 64 ≤ 2 ^ (3 * n) := by
      calc 64 = 2 ^ 6 := by norm_num
        _ ≤ 2 ^ (3 * n) := Nat.pow_le_pow_right (by norm_num) (by
          obtain ⟨m, rfl⟩ := hev
          omega)
    calc 8 < 64 := by norm_num
      _ ≤ 2 ^ (3 * n) := h64
      _ = Nat.card (CFSG.LieType.Chevalley.orbitField TwistTag.D4 K σ.toRingHom a₀) := hcardF.symm
      _ ≤ Nat.card U₀ := hle
  · intro u hu
    rw [← hmapU]
    exact ⟨u, hu, rfl⟩
  · intro u hu
    rw [← hmapU] at hu
    obtain ⟨v, hv, rfl⟩ := hu
    show (fieldActor σ σ)⁻¹ (fieldActor σ σ v) ∈ U₀
    rw [MulAut.inv_apply, MulEquiv.symm_apply_apply]
    exact hv
  · intro e he u hu
    obtain ⟨x, -, rfl⟩ := he
    have hxT : ((x : C) : CFSG.Blueprint.Chevalley.ModGL TwistTag.D4.tag K) ∈
        CFSG.LieType.Chevalley.graphFixedRootTorus TwistTag.D4 K σ.toRingHom :=
      (Subgroup.mem_subgroupOf.1 x.2).1
    have hN := CFSG.LieType.Chevalley.graphFixedRootTorus_le_normalizer_graphFixedPosUnipotent hxT
    rw [Subgroup.mem_subgroupOf]
    have hu' := Subgroup.mem_subgroupOf.1 hu
    have e : ((V.subtype x * u * (V.subtype x)⁻¹ : C) : CFSG.Blueprint.Chevalley.ModGL TwistTag.D4.tag K) =
        ((x : C) : CFSG.Blueprint.Chevalley.ModGL TwistTag.D4.tag K) * (u : CFSG.Blueprint.Chevalley.ModGL TwistTag.D4.tag K) *
          ((x : C) : CFSG.Blueprint.Chevalley.ModGL TwistTag.D4.tag K)⁻¹ := by
      simp only [Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_subtype]
    rw [e]
    exact (Subgroup.mem_normalizer_iff.1 hN _).1 hu'
  ·
    have hσ1 : σ ≠ 1 := CFSG.LocalAnalysis.GLTheoremA.td4g2_frob_ne_one Nat.prime_two hn hK hσ
    obtain ⟨c, hc⟩ : ∃ c : K, σ c ≠ c := by
      by_contra hcon
      push Not at hcon
      exact hσ1 (RingEquiv.ext hcon)
    set a₀ : Fin TwistTag.D4.foldedTag.rank := ⟨0, by decide⟩ with ha₀
    have htop : CFSG.LieType.Chevalley.orbitField TwistTag.D4 K σ.toRingHom a₀ = ⊤ :=
      CFSG.LieType.Chevalley.orbitField_D4_zero_eq_top σ
        (fun c => by
          have := congrArg (fun τ : K ≃+* K => τ c) hσ3
          simpa [pow_succ] using this)
    have hcmem : c ∈ CFSG.LieType.Chevalley.orbitField TwistTag.D4 K σ.toRingHom a₀ := by
      rw [htop]; trivial
    refine ⟨CFSG.LieType.Chevalley.fixedOrbitX TwistTag.D4 K σ.toRingHom a₀ ⟨c, hcmem⟩,
      Subgroup.mem_subgroupOf.2
        (CFSG.LieType.Chevalley.orbitX_mem_graphFixedPosUnipotent TwistTag.D4 σ.toRingHom a₀ _), ?_⟩
    rw [CFSG.LieType.Chevalley.fieldActor_fixedOrbitX]
    intro h
    have h' := CFSG.LieType.Chevalley.fixedOrbitX_injective a₀ h
    have h'' := congrArg Subtype.val h'
    exact hc h''

theorem i2023FactD4BorelEven_holds : I2023FactD4BorelEven := by
  intro S _ _ q hq2 hev hcat φ hφ3 hφi hfix r hr
  classical
  obtain ⟨K, _, _, σ, hK, hσ, -, ⟨eS⟩, -⟩ := i2tHold_model hq2 hcat
  set n := q.exponent with hn
  have hn1 : 1 ≤ n := q.exponent_pos
  set β := MulAut.congr eS φ with hβ
  have hβ3 : β ^ 3 = 1 := by rw [hβ, ← map_pow, hφ3, map_one]
  have hβx : ∀ x : S, β (eS x) = eS (φ x) := fun x => by
    rw [hβ]
    exact CFSG.LocalAnalysis.GLTheoremA.td4g2_congr_apply eS φ x
  have hβout : ¬ CFSG.RankThree.PartTwo.KFacts.IsInnerAut β := by
    rintro ⟨g, hg⟩
    apply hφi
    refine ⟨eS.symm g, MulEquiv.ext fun y => ?_⟩
    apply eS.injective
    have key := congrArg (fun ψ : MulAut (graphFixedRootGroup TwistTag.D4 K σ.toRingHom) => ψ (eS y)) hg
    simp only [MulAut.conj_apply] at key
    rw [MulAut.conj_apply, map_mul, map_mul, map_inv, MulEquiv.apply_symm_apply, ← hβx]
    exact key
  have hcardfix : Nat.card ↥(CFSG.RankThree.PartTwo.Sec4.autFix β) = Nat.card {x : S // φ x = x} := by
    rw [Nat.card_congr (CFSG.RankThree.PartTwo.Sec4.autFixCongrEquiv eS φ).toEquiv]
    rfl
  obtain ⟨s, γ, hβγ, hsfix, hsU⟩ : ∃ (s γ : MulAut (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)),
      β = γ * s * γ⁻¹ ∧ (∀ x, fieldActor σ σ x = x → s x = x) ∧
      (∀ U : Subgroup (graphFixedRootGroup TwistTag.D4 K σ.toRingHom),
        (∀ u ∈ U, fieldActor σ σ u ∈ U) → (∀ u ∈ U, (fieldActor σ σ)⁻¹ u ∈ U) →
          (∀ u ∈ U, s u ∈ U) ∧ ∀ u, fieldActor σ σ u ≠ u → s u ≠ u) := by
    rcases CFSG.RankThree.PartTwo.Sec8.Item8KFacts2Proof.isStdGraphFieldConj_or_nonempty_autFix_equiv hn1 hK
        hσ hβ3 hβout with ⟨γ, hγ | hγ⟩ | he2
    · refine ⟨fieldActor σ σ, γ, hγ, fun x hx => hx, fun U h1 _ => ⟨h1, fun u hu => hu⟩⟩
    · refine ⟨(fieldActor σ σ)⁻¹, γ, hγ, fun x hx => ?_, fun U _ h2 => ⟨h2, fun u hu h => hu ?_⟩⟩
      · rw [MulAut.inv_apply, MulEquiv.symm_apply_eq]
        exact hx.symm
      · rw [MulAut.inv_apply, MulEquiv.symm_apply_eq] at h
        exact h.symm
    · exfalso
      obtain ⟨e2⟩ := he2
      have h6 := CFSG.LocalAnalysis.GLTheoremA.td4g2_pgl_case_twoPart hn1 hK hσ e2
      rw [hcardfix] at h6
      have h6' : (Nat.card {x : S // φ x = x}).factorization 2 = n * 3 := by
        have := h6
        unfold CFSG.LocalAnalysis.GLTheoremA.S10.twoPart at this
        rw [← pow_mul] at this
        exact Nat.pow_right_injective (le_refl 2) this
      rw [hfix] at h6'
      omega
  obtain ⟨E₀, hE₀el, hE₀card, hE₀fix, U₀, hU₀2, hU₀card, hU₀σ, hU₀σi, hE₀U₀, u₀, hu₀, hu₀σ⟩ :=
    i2tHold_borel_model hev hn1 hK hσ hr
  obtain ⟨hsU₀, hsmove⟩ := hsU U₀ hU₀σ hU₀σi
  set ι : graphFixedRootGroup TwistTag.D4 K σ.toRingHom →* S :=
    (eS.symm.toMonoidHom).comp (γ : graphFixedRootGroup TwistTag.D4 K σ.toRingHom ≃*
      graphFixedRootGroup TwistTag.D4 K σ.toRingHom).toMonoidHom with hι
  have hιinj : Function.Injective ι := eS.symm.injective.comp γ.injective
  have hφι : ∀ x, φ (ι x) = ι (s x) := by
    intro x
    apply eS.injective
    rw [← hβx]
    simp only [hι, MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom, Function.comp_apply,
      MulEquiv.apply_symm_apply]
    rw [hβγ, MulAut.mul_apply, MulAut.mul_apply, MulAut.inv_apply, MulEquiv.symm_apply_apply]
  refine ⟨E₀.map ι, CFSG.Open.IsElemAbelian.map hE₀el ι, ?_, ?_,
    U₀.map ι, hU₀2.map ι, ?_, ?_, ?_, ?_⟩
  · rw [Subgroup.card_map_of_injective hιinj, hE₀card]
  · rintro _ ⟨x, hx, rfl⟩
    rw [hφι, hsfix x (hE₀fix x hx)]
  · rw [Subgroup.card_map_of_injective hιinj]
    exact hU₀card
  · rintro _ ⟨x, hx, rfl⟩
    rw [hφι]
    exact ⟨s x, hsU₀ x hx, rfl⟩
  · rintro _ ⟨e, he, rfl⟩ _ ⟨u, hu, rfl⟩
    refine ⟨e * u * e⁻¹, hE₀U₀ e he u hu, ?_⟩
    simp only [map_mul, map_inv]
  · refine ⟨ι u₀, ⟨u₀, hu₀, rfl⟩, ?_⟩
    rw [hφι]
    exact fun h => hsmove u₀ hu₀σ (hιinj h)

end CFSG.LocalAnalysis.GLTheoremA.I2023

