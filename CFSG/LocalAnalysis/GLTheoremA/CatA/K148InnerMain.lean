@[expose] def TD4InnThreeCentLeCube (f : ℕ) : Prop :=
  ∀ (K : Type) [Field K] [Finite K] (σ : K ≃+* K), Nat.card K = (2 ^ f) ^ 3 → (∀ c, σ c = c ^ 2 ^ f) →
    ∀ z : graphFixedRootGroup TwistTag.D4 K σ.toRingHom, z ^ 3 = 1 → z ≠ 1 →
      twoPart (Nat.card (Subgroup.centralizer
        ({z} : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)))) ≤ (2 ^ f) ^ 3

theorem td4InnThreeCentLeCube_of_even {f : ℕ} (hf : 1 ≤ f) (hev : f % 2 = 0) :
    TD4InnThreeCentLeCube f := by
  intro K _ _ σ hK hσ z hz3 hz1
  exact TD4Le.two_part_centralizer_le_cube σ ⟨hf, hK, Or.inl hσ⟩ (two_pow_mod_three_of_even hev) z hz3 hz1

theorem td4InnThreeCentAt_of_even {f : ℕ} (hf : 1 ≤ f) (hev : f % 2 = 0) : TD4InnThreeCentAt f := by
  intro K _ _ σ hK hσ z hz3 hz1
  exact le_antisymm (td4InnThreeCentLeCube_of_even hf hev K σ hK hσ z hz3 hz1)
    (two_pow_three_le_twoPart_centralizer hf K hK hσ hz3 hz1)

@[expose] def K148InnerOddGap : Prop :=
  ∀ f : ℕ, 1 ≤ f → f % 2 = 1 → TD4InnThreeCentLeCube f

theorem k148InnerCentFact_of_oddGap (hodd : K148InnerOddGap) : K148InnerCentFact := by
  intro f hf
  by_cases hev : f % 2 = 0
  · exact td4InnThreeCentAt_of_even hf hev
  · intro K _ _ σ hK hσ z hz3 hz1
    exact le_antisymm (hodd f hf (by omega) K σ hK hσ z hz3 hz1)
      (two_pow_three_le_twoPart_centralizer hf K hK hσ hz3 hz1)

@[expose] def K148RepA (f : ℕ) : Prop :=
  ∀ (K : Type) [Field K] [Finite K] (σ : K ≃+* K), Nat.card K = (2 ^ f) ^ 3 → (∀ c, σ c = c ^ 2 ^ f) →
    ∀ z ∈ CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.d4ShortSL2 K σ.toRingHom,
      z ^ 3 = 1 → z ≠ 1 →
        twoPart (Nat.card (Subgroup.centralizer
          ({z} : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)))) ≤ (2 ^ f) ^ 3

@[expose] def K148RepB (f : ℕ) : Prop :=
  ∀ (K : Type) [Field K] [Finite K] (σ : K ≃+* K), Nat.card K = (2 ^ f) ^ 3 → (∀ c, σ c = c ^ 2 ^ f) →
    ∀ t ∈ Subgroup.centralizer
        ((CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.d4ShortSL2 K σ.toRingHom :
          Subgroup (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) :
            Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)),
      t ^ 3 = 1 → t ≠ 1 →
        twoPart (Nat.card (Subgroup.centralizer
          ({t} : Set (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)))) ≤ (2 ^ f) ^ 3

theorem conj_three_ne {G : Type*} [Group G] {z : G} (g : G) (hz3 : z ^ 3 = 1) (hz1 : z ≠ 1) :
    (g * z * g⁻¹) ^ 3 = 1 ∧ g * z * g⁻¹ ≠ 1 := by
  refine ⟨by rw [conj_pow, hz3, mul_one, mul_inv_cancel], fun h => hz1 ?_⟩
  calc z = g⁻¹ * (g * z * g⁻¹) * g := by group
    _ = 1 := by rw [h]; group

theorem td4InnThreeCentLeCube_of_reps {f : ℕ} (hA : K148RepA f) (hB : K148RepB f) :
    TD4InnThreeCentLeCube f := by
  intro K _ _ σ hK hσ z hz3 hz1
  have h3 : ¬ 3 ∣ 2 ^ f := fun h => by
    have := Nat.Prime.dvd_of_dvd_pow Nat.prime_three h
    norm_num at this
  obtain ⟨g, hg⟩ :=
    CFSG.RankThree.PartTwo.Sec11.KS11Lie6Proof.d4ThreeConj_holds K (2 ^ f) σ hK hσ h3 z hz3 hz1
  rw [← natCard_centralizer_conj g z]
  obtain ⟨hz3', hz1'⟩ := conj_three_ne g hz3 hz1
  rcases hg with hS | hC
  · exact hA K σ hK hσ _ hS hz3' hz1'
  · exact hB K σ hK hσ _ hC hz3' hz1'

theorem k148InnerOddGap_of_reps (h : ∀ f : ℕ, 1 ≤ f → f % 2 = 1 → K148RepA f ∧ K148RepB f) :
    K148InnerOddGap :=
  fun f hf hodd => td4InnThreeCentLeCube_of_reps (h f hf hodd).1 (h f hf hodd).2

theorem k148RepB_of_odd {f : ℕ} (hodd : f % 2 = 1) : K148RepB f :=
  fun K _ _ σ hK hσ t ht ht3 ht1 => twoPart_centralizer_3B_odd (by omega) hodd K hK hσ ht ht3 ht1

theorem k148InnerCentFact_of_repA (hA : ∀ f : ℕ, 1 ≤ f → f % 2 = 1 → K148RepA f) : K148InnerCentFact :=
  k148InnerCentFact_of_oddGap
    (k148InnerOddGap_of_reps fun f hf hodd => ⟨hA f hf hodd, k148RepB_of_odd hodd⟩)

