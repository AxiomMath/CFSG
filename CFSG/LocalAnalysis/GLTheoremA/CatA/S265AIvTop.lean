theorem caseIv_false_of_parts (hLie : IvLieRow) (hSp8 : IvCoreAt S8.L84.isSp82)
    (hF4 : IvCoreAt S9.isF4two) (hSch : SchurF4Three) {Ω : Type} [Group Ω] [Finite Ω]
    {S B T : Subgroup Ω} {x : Ω} {D K : Subgroup Ω} (h : QSNL 3 S B T x D K)
    (hK6 : catalogIs (PSimple 3 K) S9.isSp6two) (hr : Nat.card B = 9 * Nat.card D)
    (hU : (⁅T, B⁆ : Subgroup Ω) ≠ ⊥) : False := by
  obtain ⟨e6⟩ := CatB.bridge_sp6two hK6
  have hZK := center_pQuot_eq_bot_of_oddSchur (h.nlAct (three_dvd_card hK6)).comp
    ((oddSchurTrivial_statedSp 3 (ZMod 2)).of_mulEquiv e6.symm)
  rcases hLie h.cfg hK6 hr with hS8 | hF
  · obtain ⟨e8⟩ := CatB.KFacts.bridge_sp8two hS8
    obtain ⟨hZS, ⟨eS⟩⟩ := center_eq_bot_and_equiv h.cfg.core (center_pQuot_eq_bot_of_oddSchur
      h.cfg.comp ((oddSchurTrivial_statedSp 4 (ZMod 2)).of_mulEquiv e8.symm))
    refine caseIv_false_of_core hSp8 h hK6 hr hU hZK ?_ hZS fun α _ => ?_
    · obtain ⟨i, hi, ⟨f⟩⟩ := hS8
      exact ⟨i, hi, ⟨eS.trans f⟩⟩
    · obtain ⟨g, hg⟩ := CFSG.LocalAnalysis.GLTheoremB.MovingAround.Inputs273d.all_inner_spTwo
        (by norm_num : 3 ≤ 4) (MulAut.congr (eS.trans e8) α)
      exact ⟨_, eq_conj_of_congr _ hg⟩
  · obtain ⟨hZS, hQ⟩ := center_eq_bot_of_schurF4 hSch h.cfg.quasi h.cfg.core hF
    refine caseIv_false_of_core hF4 h hK6 hr hU hZK hQ hZS fun α hα => ?_
    obtain ⟨L, _, _, hL, ⟨e⟩⟩ := CatB.I2610.exists_adjointGroup_of_catalogIs_isF4two hQ
    obtain ⟨g, hg⟩ := CatB.I2610.exists_eq_conj_of_pow_three_F4 hL
      (show MulAut.congr e α ^ 3 = 1 by rw [← map_pow, hα, map_one])
    exact ⟨_, eq_conj_of_congr _ hg⟩

