omit [Finite Ω] in
private theorem three_dvd_card {K : Subgroup Ω} (hK : catalogIs (PSimple 3 K) S9.isSp6two) :
    3 ∣ Nat.card ↥K := by
  obtain ⟨e⟩ := CatB.bridge_sp6two hK
  have h3 : 3 ∣ Nat.card (PSimple 3 K) := by
    rw [(Nat.card_congr e.toEquiv).trans CatB.U4Sp8.card_sp_three]
    norm_num
  exact h3.trans ((Subgroup.card_quotient_dvd_card _).trans (Subgroup.card_quotient_dvd_card _))

private theorem center_pQuot_eq_bot_of_oddSchur {X J : Subgroup Ω} (hJ : GLAPComponent 3 X J)
    (hS : OddSchurTrivial (PSimple 3 J)) : Subgroup.center (PQuot 3 J) = ⊥ := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hq := isQuasisimple_pQuot_of_glaPComponent Nat.prime_three hJ
  have hodd : Odd (Nat.card ↥(QuotientGroup.mk' (Subgroup.center (PQuot 3 J))).ker) := by
    rw [QuotientGroup.ker_mk']
    obtain ⟨k, hk⟩ := (I2611.isPGroup_center_pQuot' Nat.prime_three J).exists_card_eq
    rw [hk]
    exact Odd.pow (by decide)
  have hinj := hS (PQuot 3 J) ⟨hq.1⟩ (QuotientGroup.mk' _) (QuotientGroup.mk'_surjective _)
    (QuotientGroup.ker_mk' _).le hodd
  rw [← QuotientGroup.ker_mk' (Subgroup.center (PQuot 3 J))]
  exact (MonoidHom.ker_eq_bot_iff _).2 hinj

omit [Finite Ω] in
private theorem center_eq_bot_and_equiv {S : Subgroup Ω} (hcore : GLAPPrimeCore 3 ↥S = ⊥)
    (hZ : Subgroup.center (PQuot 3 S) = ⊥) :
    Subgroup.center ↥S = ⊥ ∧ Nonempty (↥S ≃* PSimple 3 S) := by
  let e1 : PQuot 3 S ≃* ↥S :=
    (QuotientGroup.quotientMulEquivOfEq hcore).trans QuotientGroup.quotientBot
  refine ⟨by rw [← Subgroup.map_center_eq e1, hZ, Subgroup.map_bot], ⟨e1.symm.trans ?_⟩⟩
  exact ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm

end Helpers

private theorem eq_conj_of_congr {G H : Type*} [Group G] [Group H] (e : G ≃* H) {α : MulAut G}
    {g : H} (h : MulAut.congr e α = MulAut.conj g) : α = MulAut.conj (e.symm g) := by
  refine (MulAut.congr e).injective (h.trans ?_)
  ext y
  simp [MulAut.congr_apply, MulAut.conj_apply]

