theorem rk2Lower_of
    (htwd1 : ∀ (K : Type) [Group K] [Finite K] (lab : GLALabel),
      Rk2IsLabel K lab → lab.tag = .twD → 4 ≤ lab.rank → lab.n = 1 →
        lab.rank - 1 ≤ evenRank K)
    (htwe6three : ∀ (K : Type) [Group K] [Finite K] (lab : GLALabel),
      Rk2IsLabel K lab → lab.tag = .twE6 → lab.n = 3 → 5 ≤ evenRank K) :
    Rk2Lower := by
  intro K _ _ lab hK
  obtain ⟨-, hlab, -⟩ := rk2_model_of_isLabel hK
  exact
    { bcd_ge := by
        intro htag hn
        rcases htag with hB | hC | hD
        · exact rk2_low_bc_ge hK (Or.inl hB) hn
        · exact rk2_low_bc_ge hK (Or.inr hC) hn
        · have h3 : 3 ≤ lab.rank := by
            have h := hlab
            simp only [CFSG.Assembly.LargeEvenInLambda2, hD] at h
            exact h.2
          by_cases hr3 : lab.rank = 3
          · simpa [hr3] using rk2_low_d_three_ge K lab hK hD hr3 hn
          · exact rk2_low_d_ge hK hD (by omega) hn
      bcd_one := by
        intro htag hn
        rcases htag with hB | hC | hD
        · exact rk2_low_bc_one hK (Or.inl hB) hn
        · exact rk2_low_bc_one hK (Or.inr hC) hn
        · have h3 : 3 ≤ lab.rank := by
            have h := hlab
            simp only [CFSG.Assembly.LargeEvenInLambda2, hD] at h
            exact h.2
          by_cases hr3 : lab.rank = 3
          · exact rk2_low_d_three_one K lab hK hD hr3 hn
          · exact rk2_low_d_one (K := K) (lab := lab) hK hD hn (by omega)
      f4 := rk2_low_f4 K lab hK
      e7 := rk2_low_e7 K lab hK
      e7_one := rk2_low_e7_one K lab hK
      e8 := rk2_low_e8 K lab hK
      e8_one := rk2_low_e8_one K lab hK
      e6_one := rk2_low_e6_one K lab hK
      e6_two := rk2_low_e6_two_all K lab hK
      e6_big := rk2_low_e6_big K lab hK
      a_ge := rk2_low_a_ge K lab hK
      a_five := rk2_low_a_five K lab hK
      a_one := rk2_low_a_one K lab hK
      twa_two := rk2_low_twa_two K lab hK
      twa_one := rk2_low_twa_one K lab hK
      twd := by
        intro htag
        have hn1 : 1 ≤ lab.n := by
          have h := hlab
          simp only [CFSG.Assembly.LargeEvenInLambda2, htag] at h
          exact h.1
        have h2 : 2 ≤ lab.rank := by
          have h := hlab
          simp only [CFSG.Assembly.LargeEvenInLambda2, htag] at h
          exact h.2
        by_cases hr2 : lab.rank = 2
        · exact rk2_low_twd_two K lab hK htag hr2
        · by_cases hr3 : lab.rank = 3
          · simpa [hr3] using rk2_low_twd_three K lab hK htag hr3
          · have h4 : 4 ≤ lab.rank := by omega
            by_cases hn : lab.n = 1
            · exact htwd1 K lab hK htag h4 hn
            · exact rk2_low_twd_ge K lab hK htag h4 (by omega)
      twe6_one := rk2_low_twe6_one K lab hK
      twe6 := by
        intro htag hn
        by_cases h3 : lab.n = 3
        · exact htwe6three K lab hK htag h3
        · exact rk2_low_twe6_of_ne_three K lab hK htag hn h3 }

theorem rk2Upper_of (hG : CFSG.Open.GriessAllModelsStatement)
    (htwa5 : ∀ (K : Type) [Group K] [Finite K] (lab : GLALabel), Rk2IsLabel K lab →
      (lab.tag = .twA ∧ lab.rank = 5) → 2 ≤ lab.n → Subgroup.center K = ⊥ →
        evenRank K ≤ 4)
    (hLev : Rk2TwE6LeviRankInputMaximal) : Rk2Upper := by
  refine ⟨?_, ?_⟩
  · intro K _ _ lab hK
    exact ⟨rk2_up_a5 hG hK, rk2_up_e6_two hK, htwa5 K lab hK,
      fun htag hn hc => rk2_up_twe6 hK htag hn hc hLev⟩
  · intro K _ _ lab p hK hp hp2 htag hn hd
    rcases htag with hB | hD | hF4 | hE7 | hE8
    · exact rk2_up_BD hK (Or.inl hB) hn hp hp2 hd
    · exact rk2_up_BD hK (Or.inr hD) hn hp hp2 hd
    · exact rk2_up_F4 hK hF4 hn hp hp2 hd
    · exact rk2_up_e7 hK hE7 hn hp hp2 hd
    · exact rk2_up_e8_of_levi hK hE8 hn hp hp2 hd (rk2E8LeviRankInput_holds p hp hp2)

theorem rk2Tables_of (hL : Rk2Lower) (hU : Rk2Upper) (hS : Rk2Split) : Rk2Tables :=
  ⟨rk2InnRank_of_kRank rk2KRank, rk2KRank, hL, hU, hS⟩

