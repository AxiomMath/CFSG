private theorem rk2Cnt_twB2_eq_one {m : ℕ} (hm : m = 1 ∨ m = 4) :
    rk2Cnt [(1, true), (2, false)] m = 1 := by
  rcases hm with rfl | rfl <;> decide

private theorem rk2Cnt_twB2_eq_zero {m : ℕ} (hm : m ∉ ({1, 4} : Finset ℕ)) :
    rk2Cnt [(1, true), (2, false)] m = 0 := by
  by_cases hdiv : m ∣ 4
  · have hm0 : m ≠ 0 := by rintro rfl; norm_num at hdiv
    have hle : m ≤ 4 := Nat.le_of_dvd (by norm_num) hdiv
    interval_cases m <;> first | (simp_all; done) | decide
  · have h1 : ¬ m ∣ 1 := fun h => by
      have : m = 1 := Nat.dvd_one.1 h
      subst this
      exact hm (by simp)
    unfold rk2Cnt
    simp [h1, hdiv]

private theorem rk2Cnt_twF4_eq_two {m : ℕ} (hm : m ∈ ({1, 2, 4} : Finset ℕ)) :
    rk2Cnt [(1, true), (3, false), (4, true), (6, false)] m = 2 := by
  simp only [Finset.mem_insert, Finset.mem_singleton] at hm
  rcases hm with rfl | rfl | rfl <;> decide

private theorem rk2Cnt_twF4_eq_one {m : ℕ} (hm : m ∈ ({6, 12} : Finset ℕ)) :
    rk2Cnt [(1, true), (3, false), (4, true), (6, false)] m = 1 := by
  simp only [Finset.mem_insert, Finset.mem_singleton] at hm
  rcases hm with rfl | rfl <;> decide

private theorem rk2Cnt_twF4_eq_zero {m : ℕ} (hm : m ∉ ({1, 2, 4, 6, 12} : Finset ℕ)) :
    rk2Cnt [(1, true), (3, false), (4, true), (6, false)] m = 0 := by
  by_cases hdiv : m ∣ 12
  · have hm0 : m ≠ 0 := by rintro rfl; norm_num at hdiv
    have hle : m ≤ 12 := Nat.le_of_dvd (by norm_num) hdiv
    interval_cases m <;> first | (simp_all; done) | decide
  · have h1 : ¬ m ∣ 1 := fun h => by
      have : m = 1 := Nat.dvd_one.1 h
      subst this
      exact hm (by simp)
    have h2 : ¬ m ∣ 2 := fun h => hdiv (h.trans (by norm_num))
    have h4 : ¬ m ∣ 4 := fun h => hdiv (h.trans (by norm_num))
    have h6 : ¬ m ∣ 6 := fun h => hdiv (h.trans (by norm_num))
    have h3 : ¬ (m ∣ 6 ∧ ¬ m ∣ 3) := fun h => h6 h.1
    have h12 : ¬ (m ∣ 12 ∧ ¬ m ∣ 6) := fun h => hdiv h.1
    unfold rk2Cnt
    simp [h1, h2, h4, h3, h12]

private theorem rk2Cnt_triD4_eq_two {m : ℕ} (hm : m ∈ ({1, 2, 3, 6} : Finset ℕ)) :
    rk2Cnt [(2, true), (6, true), (12, true)] m - rk2Cnt [(4, true)] m = 2 := by
  simp only [Finset.mem_insert, Finset.mem_singleton] at hm
  rcases hm with rfl | rfl | rfl | rfl <;> decide

private theorem rk2Cnt_triD4_eq_one {m : ℕ} (hm : m = 12) :
    rk2Cnt [(2, true), (6, true), (12, true)] m - rk2Cnt [(4, true)] m = 1 := by
  subst hm
  decide

private theorem rk2Cnt_triD4_eq_zero {m : ℕ} (hm : m ∉ ({1, 2, 3, 6, 12} : Finset ℕ)) :
    rk2Cnt [(2, true), (6, true), (12, true)] m - rk2Cnt [(4, true)] m = 0 := by
  by_cases hdiv : m ∣ 12
  · have hm0 : m ≠ 0 := by rintro rfl; norm_num at hdiv
    have hle : m ≤ 12 := Nat.le_of_dvd (by norm_num) hdiv
    interval_cases m <;> first | (simp_all; done) | decide
  · have h2 : ¬ m ∣ 2 := fun h => hdiv (h.trans (by norm_num))
    have h6 : ¬ m ∣ 6 := fun h => hdiv (h.trans (by norm_num))
    have h4 : ¬ m ∣ 4 := fun h => hdiv (h.trans (by norm_num))
    unfold rk2Cnt
    simp [h2, h6, hdiv, h4]

