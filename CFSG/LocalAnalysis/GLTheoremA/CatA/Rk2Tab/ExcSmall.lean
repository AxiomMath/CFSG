theorem rk2_not_dvd_card_center {K : Type} [Group K] [Finite K] {lab : GLALabel}
    (hQ : CFSG.IsQuasisimple K) (hM : MarkedModel lab (K ⧸ Subgroup.center K))
    (htag : lab.tag = .triD4 ∨ lab.tag = .twB2 ∨ lab.tag = .twF4)
    {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) : ¬ p ∣ Nat.card (Subgroup.center K) := by
  obtain ⟨t, r, n⟩ := lab
  simp only at htag hM
  rcases htag with rfl | rfl | rfl
  ·
    obtain ⟨-, ⟨eM⟩⟩ := CFSG.Milestones.cl_lit_griess_schur_multipliers_all_native_models
      (K ⧸ Subgroup.center K) (markTag ⟨.triD4, r, n⟩) (markRank ⟨.triD4, r, n⟩)
      (markChar ⟨.triD4, r, n⟩) (markDeg ⟨.triD4, r, n⟩) hM
    have hg : genericOrders (markTag ⟨.triD4, r, n⟩) (markRank ⟨.triD4, r, n⟩)
        (markChar ⟨.triD4, r, n⟩) (markDeg ⟨.triD4, r, n⟩) = (1, 1) := rfl
    have he : exceptionalOrders (markTag ⟨.triD4, r, n⟩) (markRank ⟨.triD4, r, n⟩)
        (markChar ⟨.triD4, r, n⟩) (markDeg ⟨.triD4, r, n⟩) = (1, 1) := rfl
    have hcard : Nat.card (CFSG.Open.griessHopfMultiplier (K ⧸ Subgroup.center K)) = 1 := by
      rw [Nat.card_congr eM.toEquiv,
        CFSG.GH74.GLS.Stage2.Signalizer.Odd87.card_generic_exceptional']
      rw [hg, he]
      norm_num
    have : Finite (CFSG.Open.griessHopfMultiplier (K ⧸ Subgroup.center K)) :=
      Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
    have hdvd := CFSG.GH74.GLS.Stage2.Signalizer.Odd87.card_center_dvd_hopf hQ
      (MulEquiv.refl (K ⧸ Subgroup.center K))
    rw [hcard] at hdvd
    exact fun h => hp.not_dvd_one (h.trans hdvd)
  ·
    by_cases hn3 : n = 3
    · subst hn3
      obtain ⟨-, ⟨eM⟩⟩ := CFSG.Milestones.cl_lit_griess_schur_multipliers_all_native_models
        (K ⧸ Subgroup.center K) (markTag ⟨.twB2, r, 3⟩) (markRank ⟨.twB2, r, 3⟩)
        (markChar ⟨.twB2, r, 3⟩) (markDeg ⟨.twB2, r, 3⟩) hM
      have hg : genericOrders (markTag ⟨.twB2, r, 3⟩) (markRank ⟨.twB2, r, 3⟩)
          (markChar ⟨.twB2, r, 3⟩) (markDeg ⟨.twB2, r, 3⟩) = (1, 1) := rfl
      have he : exceptionalOrders (markTag ⟨.twB2, r, 3⟩) (markRank ⟨.twB2, r, 3⟩)
          (markChar ⟨.twB2, r, 3⟩) (markDeg ⟨.twB2, r, 3⟩) = (2, 2) := rfl
      have hcard : Nat.card (CFSG.Open.griessHopfMultiplier (K ⧸ Subgroup.center K)) = 4 := by
        rw [Nat.card_congr eM.toEquiv,
          CFSG.GH74.GLS.Stage2.Signalizer.Odd87.card_generic_exceptional']
        rw [hg, he]
        norm_num
      have : Finite (CFSG.Open.griessHopfMultiplier (K ⧸ Subgroup.center K)) :=
        Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
      have hdvd := CFSG.GH74.GLS.Stage2.Signalizer.Odd87.card_center_dvd_hopf hQ
        (MulEquiv.refl (K ⧸ Subgroup.center K))
      rw [hcard] at hdvd
      intro h
      have hp4 : p ∣ 4 := h.trans hdvd
      have hp2' : p ∣ 2 := by
        rcases (Nat.Prime.dvd_mul hp).1 (show p ∣ 2 * 2 by simpa using hp4) with h' | h'
        · exact h'
        · exact h'
      exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 hp2')
    · obtain ⟨-, ⟨eM⟩⟩ := CFSG.Milestones.cl_lit_griess_schur_multipliers_all_native_models
        (K ⧸ Subgroup.center K) (markTag ⟨.twB2, r, n⟩) (markRank ⟨.twB2, r, n⟩)
        (markChar ⟨.twB2, r, n⟩) (markDeg ⟨.twB2, r, n⟩) hM
      have hg : genericOrders (markTag ⟨.twB2, r, n⟩) (markRank ⟨.twB2, r, n⟩)
          (markChar ⟨.twB2, r, n⟩) (markDeg ⟨.twB2, r, n⟩) = (1, 1) := rfl
      have he : exceptionalOrders (markTag ⟨.twB2, r, n⟩) (markRank ⟨.twB2, r, n⟩)
          (markChar ⟨.twB2, r, n⟩) (markDeg ⟨.twB2, r, n⟩) = (1, 1) := by
        simp [exceptionalOrders, markTag, markRank, markChar, markDeg, hn3]
      have hcard : Nat.card (CFSG.Open.griessHopfMultiplier (K ⧸ Subgroup.center K)) = 1 := by
        rw [Nat.card_congr eM.toEquiv,
          CFSG.GH74.GLS.Stage2.Signalizer.Odd87.card_generic_exceptional']
        rw [hg, he]
        norm_num
      have : Finite (CFSG.Open.griessHopfMultiplier (K ⧸ Subgroup.center K)) :=
        Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
      have hdvd := CFSG.GH74.GLS.Stage2.Signalizer.Odd87.card_center_dvd_hopf hQ
        (MulEquiv.refl (K ⧸ Subgroup.center K))
      rw [hcard] at hdvd
      exact fun h => hp.not_dvd_one (h.trans hdvd)
  ·
    obtain ⟨-, ⟨eM⟩⟩ := CFSG.Milestones.cl_lit_griess_schur_multipliers_all_native_models
      (K ⧸ Subgroup.center K) (markTag ⟨.twF4, r, n⟩) (markRank ⟨.twF4, r, n⟩)
      (markChar ⟨.twF4, r, n⟩) (markDeg ⟨.twF4, r, n⟩) hM
    have hg : genericOrders (markTag ⟨.twF4, r, n⟩) (markRank ⟨.twF4, r, n⟩)
        (markChar ⟨.twF4, r, n⟩) (markDeg ⟨.twF4, r, n⟩) = (1, 1) := rfl
    have he : exceptionalOrders (markTag ⟨.twF4, r, n⟩) (markRank ⟨.twF4, r, n⟩)
        (markChar ⟨.twF4, r, n⟩) (markDeg ⟨.twF4, r, n⟩) = (1, 1) := rfl
    have hcard : Nat.card (CFSG.Open.griessHopfMultiplier (K ⧸ Subgroup.center K)) = 1 := by
      rw [Nat.card_congr eM.toEquiv,
        CFSG.GH74.GLS.Stage2.Signalizer.Odd87.card_generic_exceptional']
      rw [hg, he]
      norm_num
    have : Finite (CFSG.Open.griessHopfMultiplier (K ⧸ Subgroup.center K)) :=
      Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
    have hdvd := CFSG.GH74.GLS.Stage2.Signalizer.Odd87.card_center_dvd_hopf hQ
      (MulEquiv.refl (K ⧸ Subgroup.center K))
    rw [hcard] at hdvd
    exact fun h => hp.not_dvd_one (h.trans hdvd)


private theorem rk2_valid_reeF4 {a : ℕ} (ha : 1 ≤ a) : (TauCeti.LieTypeIndex.reeF4 a).Valid := by
  refine (TauCeti.LieTypeIndex.valid_iff _).2 ⟨?_, ?_⟩
  · simpa [TauCeti.LieTypeIndex.inStandardRange_iff] using ha
  · simp [TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]

theorem rk2_nonempty_cat_equiv_twB2 {R : Type} [Group R] {n : ℕ}
    (hM : MarkedModel ⟨.twB2, 0, n⟩ R) :
    ∃ (a : ℕ) (_ : 1 ≤ a) (hv : (TauCeti.LieTypeIndex.suzuki a).Valid),
      n = 2 * a + 1 ∧ Nonempty (R ≃* Cat ⟨.suzuki a, hv⟩) := by
  rcases hM with ⟨hcl, -⟩ | ⟨-, hce, -⟩ | ⟨-, hrt, -⟩ | ⟨-, -, hsz⟩
  · exact absurd hcl (by simp [markTag, classicalTags])
  · exact absurd hce (by simp [markTag, chevalleyExceptionalTags])
  · exact absurd hrt (by simp [markTag, reeTitsTags])
  · obtain ⟨-, a, ha, K, _, _, hf, hcard, ⟨eR⟩⟩ := hsz
    have hv : (TauCeti.LieTypeIndex.suzuki a).Valid :=
      CFSG.HardMathSupport.Solomon.Coordinator.LieComp.suzuki_valid ha
    have hK : Nat.card K = 2 ^ (2 * a + 1) := by rw [← hf]; exact hcard
    obtain ⟨eC⟩ := CFSG.HardMathSupport.Solomon.Coordinator.LieComp.nonempty_suzukiGroup_equiv_cat
      ha hK
    exact ⟨a, ha, hv, hf, ⟨eR.trans eC⟩⟩

theorem rk2_nonempty_cat_equiv_twF4 {R : Type} [Group R] {n : ℕ} (hn : 3 ≤ n)
    (hM : MarkedModel ⟨.twF4, 0, n⟩ R) :
    ∃ (a : ℕ) (_ : 1 ≤ a) (hv : (TauCeti.LieTypeIndex.reeF4 a).Valid),
      n = 2 * a + 1 ∧ Nonempty (R ≃* Cat ⟨.reeF4 a, hv⟩) := by
  rcases hM with ⟨hcl, -⟩ | ⟨-, hce, -⟩ | ⟨-, hrt, hree⟩ | ⟨-, ht, -⟩
  · exact absurd hcl (by simp [markTag, classicalTags])
  · exact absurd hce (by simp [markTag, chevalleyExceptionalTags])
  · obtain ⟨hadm, a, hf₀, hrel⟩ := hree
    have hf : n = 2 * a + 1 := by simpa [markDeg] using hf₀
    have ha : 1 ≤ a := by omega
    have hv : (TauCeti.LieTypeIndex.reeF4 a).Valid := rk2_valid_reeF4 ha
    have hree' : ReeTitsModel R .twistedF4 2 (2 * a + 1) := hf ▸ ⟨hadm, a, hf₀, hrel⟩
    obtain ⟨K, _, _, hcharK, hcard, ⟨eR⟩⟩ :=
      CFSG.LieType.ChevTwo.Semi.exists_mulEquiv_reeGamma ha hree' 
    haveI := hcharK
    obtain ⟨eC⟩ :=
      CFSG.HardMathSupport.Solomon.Coordinator.SeitzOuterCube.Exc.reeGamma_equiv_cat_of_card ha hv hcard
    exact ⟨a, ha, hv, hf, ⟨eR.trans eC.symm⟩⟩
  · exact absurd ht (by simp [markTag])

theorem rk2_nonempty_cat_equiv_triD4 {R : Type} [Group R] {n : ℕ} (hn : 1 ≤ n)
    (hM : MarkedModel ⟨.triD4, 0, n⟩ R) :
    ∃ hv : (TauCeti.LieTypeIndex.trialityD4 ⟨2, n, Nat.prime_two, hn⟩).Valid,
      Nonempty (R ≃* Cat ⟨.trialityD4 ⟨2, n, Nat.prime_two, hn⟩, hv⟩) := by
  rcases hM with ⟨hcl, -⟩ | ⟨-, hce, hce'⟩ | ⟨-, hrt, -⟩ | ⟨-, ht, -⟩
  · exact absurd hcl (by simp [markTag, classicalTags])
  · have htw : TwistedChevalleyModel R .D4 (2 ^ n) := hce'.2
    obtain ⟨K, _, _, σ, hK, hσ, ⟨eR⟩⟩ :=
      CFSG.LieType.Chevalley.exists_mulEquiv_graphFixedRootGroup_card .D4 Nat.prime_two hn htw
    have hK3 : Nat.card K = (2 ^ n) ^ 3 := by
      have h3 : CFSG.Blueprint.Chevalley.TwistTag.D4.order = 3 := rfl
      rw [h3] at hK
      exact hK
    have hv : (TauCeti.LieTypeIndex.trialityD4 ⟨2, n, Nat.prime_two, hn⟩).Valid :=
      TauCeti.LieTypeIndex.valid_trialityD4 _
    have hqc : (⟨2, n, Nat.prime_two, hn⟩ : TauCeti.PrimePower).card = 2 ^ n := by
      rw [TauCeti.PrimePower.card_def]
    have hσ' : (∀ c, σ c = c ^ (⟨2, n, Nat.prime_two, hn⟩ : TauCeti.PrimePower).card) := by
      intro c
      rw [hqc]
      exact hσ c
    obtain ⟨eC⟩ :=
      CFSG.HardMathSupport.Solomon.Coordinator.SeitzOuterCube.Exc.graphFixedRootGroup_trialityD4_equiv_cat
        (q₀ := (⟨2, n, Nat.prime_two, hn⟩ : TauCeti.PrimePower)) hv (k := K)
        (by rw [hqc]; exact hK3) σ (Or.inl hσ')
    exact ⟨hv, ⟨eR.trans eC⟩⟩
  · exact absurd hrt (by simp [markTag, reeTitsTags])
  · exact absurd ht (by simp [markTag])

theorem rk2_carrier_triD4_two {R : Type} [Group R] [Finite R] {n p : ℕ} (hn : 1 ≤ n)
    (hM : MarkedModel ⟨.triD4, 0, n⟩ R) (hp : p.Prime) (hp2 : p ≠ 2)
    (hm : rk2Ord p n ∈ ({1, 2, 3, 6} : Finset ℕ)) :
    CFSG.Open.pRank p (⊤ : Subgroup R) ≤ rk2Mult ⟨.triD4, 0, n⟩ (rk2Ord p n) := by
  rw [rk2Mult_triD4_eq_two hm]
  obtain ⟨hv, ⟨e⟩⟩ := rk2_nonempty_cat_equiv_triD4 hn hM
  by_cases hp3 : p = 3
  · subst hp3
    exact rk2_pRank_le_two_of_rankLE2 Nat.prime_three
      (RankLE2.of_mulEquiv e.symm (rankLE2_three_cat_trialityD4 _ hv (by simp)))
  · have hp5 : 5 ≤ p := (eq_three_or_five_le hp hp2).resolve_left hp3
    exact rk2_pRank_le_two_of_rankLE2 hp
      (RankLE2.of_mulEquiv e.symm (rankLE2_cat_trialityD4 _ hv hp hp5 hp2))

theorem rk2_carrier_triD4_one {R : Type} [Group R] [Finite R] {n p : ℕ} (hn : 1 ≤ n)
    (hM : MarkedModel ⟨.triD4, 0, n⟩ R) (hp : p.Prime) (hp2 : p ≠ 2)
    (hm : rk2Ord p n = 12) :
    CFSG.Open.pRank p (⊤ : Subgroup R) ≤ rk2Mult ⟨.triD4, 0, n⟩ (rk2Ord p n) := by
  obtain ⟨hv, ⟨e⟩⟩ := rk2_nonempty_cat_equiv_triD4 hn hM
  rw [rk2Mult_triD4_eq_one hm]
  have hnd : ¬ p ∣ (2 ^ n) ^ 6 - 1 := by
    intro hd
    have h6 : rk2Ord p n ∣ 6 := by
      rw [rk2Ord_dvd_iff]
      have hpow : 2 ^ (n * 6) = (2 ^ n) ^ 6 := pow_mul ..
      rw [hpow]
      exact hd
    rw [hm] at h6
    norm_num at h6
  have hnd' : ¬ p ∣ (⟨2, n, Nat.prime_two, hn⟩ : TauCeti.PrimePower).card ^ 6 - 1 := by
    rw [TauCeti.PrimePower.card_def]
    exact hnd
  exact rk2_pRank_le_one_of_rankLE1 hp
    (RankLE1.of_mulEquiv e.symm
      (rankLE1_cat_trialityD4 ⟨2, n, Nat.prime_two, hn⟩ hv hp hp2 hp2 hnd'))

theorem rk2_carrier_twF4_two {R : Type} [Group R] [Finite R] {n p : ℕ} (hn : 3 ≤ n)
    (hM : MarkedModel ⟨.twF4, 0, n⟩ R) (hp : p.Prime) (hp2 : p ≠ 2)
    (hm : rk2Ord p n ∈ ({1, 2, 4} : Finset ℕ)) :
    CFSG.Open.pRank p (⊤ : Subgroup R) ≤ rk2Mult ⟨.twF4, 0, n⟩ (rk2Ord p n) := by
  rw [rk2Mult_twF4_eq_two hm]
  obtain ⟨a, ha, hv, rfl, ⟨e⟩⟩ := rk2_nonempty_cat_equiv_twF4 hn hM
  by_cases hp3 : p = 3
  · subst hp3
    exact rk2_pRank_le_two_of_rankLE2 Nat.prime_three
      (RankLE2.of_mulEquiv e.symm (rankLE2_three_cat_reeF4 hv))
  · have hp5 : 5 ≤ p := (eq_three_or_five_le hp hp2).resolve_left hp3
    exact rk2_pRank_le_two_of_rankLE2 hp
      (RankLE2.of_mulEquiv e.symm (rankLE2_cat_reeF4_five hv hp hp5))

theorem rk2_carrier_twF4_one {R : Type} [Group R] [Finite R] {n p : ℕ} (hn : 3 ≤ n)
    (hM : MarkedModel ⟨.twF4, 0, n⟩ R) (hp : p.Prime) (hp2 : p ≠ 2)
    (hm : rk2Ord p n ∈ ({6, 12} : Finset ℕ)) :
    CFSG.Open.pRank p (⊤ : Subgroup R) ≤ rk2Mult ⟨.twF4, 0, n⟩ (rk2Ord p n) := by
  rw [rk2Mult_twF4_eq_one hm]
  obtain ⟨a, ha, hv, rfl, ⟨e⟩⟩ := rk2_nonempty_cat_equiv_twF4 hn hM
  have hnd : ¬ p ∣ (2 ^ (2 * a + 1)) ^ 4 - 1 := by
    intro hd
    have h4 : rk2Ord p (2 * a + 1) ∣ 4 := by
      rw [rk2Ord_dvd_iff]
      have hpow : 2 ^ ((2 * a + 1) * 4) = (2 ^ (2 * a + 1)) ^ 4 := pow_mul ..
      rw [hpow]
      exact hd
    simp only [Finset.mem_insert, Finset.mem_singleton] at hm
    rcases hm with h6 | h12
    · rw [h6] at h4; norm_num at h4
    · rw [h12] at h4; norm_num at h4
  exact rk2_pRank_le_one_of_rankLE1 hp
    (RankLE1.of_mulEquiv e.symm (rankLE1_cat_reeF4 hv hp hp2 hnd))

theorem rk2_carrier_twB2_one {R : Type} [Group R] [Finite R] {n p : ℕ}
    (hM : MarkedModel ⟨.twB2, 0, n⟩ R) (hp : p.Prime) (hp2 : p ≠ 2)
    (hm : rk2Ord p n = 1 ∨ rk2Ord p n = 4) :
    CFSG.Open.pRank p (⊤ : Subgroup R) ≤ rk2Mult ⟨.twB2, 0, n⟩ (rk2Ord p n) := by
  rw [rk2Mult_twB2_eq_one hm]
  obtain ⟨a, ha, hv, rfl, ⟨e⟩⟩ := rk2_nonempty_cat_equiv_twB2 hM
  exact rk2_pRank_le_one_of_rankLE1 hp
    (RankLE1.of_mulEquiv e.symm (rankLE1_cat_suzuki hv hp hp2))


private theorem rk2_suzukiModel_of_markedModel {R : Type} [Group R] {n : ℕ}
    (hM : MarkedModel ⟨.twB2, 0, n⟩ R) : SuzukiModel R 2 n := by
  rcases hM with ⟨hcl, -⟩ | ⟨-, hce, -⟩ | ⟨-, hrt, -⟩ | ⟨-, -, hsz⟩
  · exact absurd hcl (by simp [markTag, classicalTags])
  · exact absurd hce (by simp [markTag, chevalleyExceptionalTags])
  · exact absurd hrt (by simp [markTag, reeTitsTags])
  · exact hsz

private theorem rk2_carrier_twB2_not_mem (R : Type) [Group R] [Finite R] (n p : ℕ)
    (hM : MarkedModel ⟨.twB2, 0, n⟩ R) (hp : p.Prime) (hp2 : p ≠ 2)
    (hm : rk2Ord p n ∉ ({1, 4} : Finset ℕ)) :
    CFSG.Open.pRank p (⊤ : Subgroup R) ≤ rk2Mult ⟨.twB2, 0, n⟩ (rk2Ord p n) := by
  rw [rk2Mult_twB2_eq_zero hm]
  have h0 : CFSG.Open.pRank p (⊤ : Subgroup R) = 0 := by
    refine rk2_pRank_eq_zero_of_not_dvd hp ?_
    obtain ⟨-, a, ha, K, _, hKfin, hf, hcard, ⟨eR⟩⟩ := rk2_suzukiModel_of_markedModel hM
    haveI := hKfin
    have hK : Nat.card K = 2 ^ (2 * a + 1) := by rw [← hf]; exact hcard
    rw [Nat.card_congr eR.toEquiv, CFSG.LieType.Ree.suzuki_order hK]
    intro hd
    have hq : ¬ p ∣ 2 ^ (2 * a + 1) := by
      intro h
      exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 (hp.dvd_of_dvd_pow h))
    have hq2 : ¬ p ∣ (2 ^ (2 * a + 1)) ^ 2 := fun h => hq (hp.dvd_of_dvd_pow h)
    rcases (Nat.Prime.dvd_mul hp).1 hd with h1 | h1
    · rcases (Nat.Prime.dvd_mul hp).1 h1 with h2 | h2
      · exact hq2 h2
      · have hm1 : rk2Ord p n = 1 := by
          rw [rk2Ord_eq_one_iff, hf]
          exact h2
        rw [hm1] at hm
        simp at hm
    · have hm4 : rk2Ord p n = 4 := by
        refine rk2Ord_eq_four_of_dvd_sq_add_one hp hp2 ?_
        rw [hf]
        exact h1
      rw [hm4] at hm
      simp at hm
  simpa using h0

theorem rk2_carrier_twB2 {R : Type} [Group R] [Finite R] {n p : ℕ}
    (hM : MarkedModel ⟨.twB2, 0, n⟩ R) (hp : p.Prime) (hp2 : p ≠ 2) :
    CFSG.Open.pRank p (⊤ : Subgroup R) ≤ rk2Mult ⟨.twB2, 0, n⟩ (rk2Ord p n) := by
  by_cases hm : rk2Ord p n ∈ ({1, 4} : Finset ℕ)
  · have hm' : rk2Ord p n = 1 ∨ rk2Ord p n = 4 := by simpa using hm
    exact rk2_carrier_twB2_one hM hp hp2 hm'
  · exact rk2_carrier_twB2_not_mem R n p hM hp hp2 hm

theorem rk2_pRank_le_small {K : Type} [Group K] [Finite K] {lab : GLALabel} {p : ℕ}
    (hK : Rk2IsLabel K lab) (htag : lab.tag = .triD4 ∨ lab.tag = .twB2 ∨ lab.tag = .twF4)
    (hp : p.Prime) (hp2 : p ≠ 2) :
    CFSG.Open.pRank p (⊤ : Subgroup K) ≤ rk2Mult lab (rk2Ord p lab.n) := by
  obtain ⟨t, r, n⟩ := lab
  obtain ⟨hQ, hlab2, hM⟩ := rk2_model_of_isLabel hK
  have hQ' : CFSG.IsQuasisimple K :=
    (CFSG.Foundations.SteinbergCA.quasisimple_iff _).2.2.1.2 hQ
  have hZ : ¬ p ∣ Nat.card (Subgroup.center K) :=
    rk2_not_dvd_card_center hQ' hM htag hp hp2
  haveI : Fact p.Prime := ⟨hp⟩
  rw [← CFSG.SectionRank.pRank_quotient_eq (Subgroup.center K) hZ]
  rcases htag with rfl | rfl | rfl
  · obtain ⟨hn1, hr0⟩ := hlab2
    subst hr0
    by_cases hm : rk2Ord p n ∈ ({1, 2, 3, 6, 12} : Finset ℕ)
    · by_cases h2 : rk2Ord p n ∈ ({1, 2, 3, 6} : Finset ℕ)
      · exact rk2_carrier_triD4_two hn1 hM hp hp2 h2
      · have h12 : rk2Ord p n = 12 := by
          simp only [Finset.mem_insert, Finset.mem_singleton] at hm h2 ⊢
          omega
        exact rk2_carrier_triD4_one hn1 hM hp hp2 h12
    · rw [rk2Mult_triD4_eq_zero hm]
      exact (rk2_pRank_eq_zero_of_not_dvd hp (rk2_not_dvd_card_triD4 hM hp hp2 hm)).le
  · obtain ⟨hn1, hr0, hodd, hn3⟩ := hlab2
    subst hr0
    exact rk2_carrier_twB2 hM hp hp2
  · obtain ⟨hn1, hr0, hodd, hn3⟩ := hlab2
    subst hr0
    by_cases hm : rk2Ord p n ∈ ({1, 2, 4, 6, 12} : Finset ℕ)
    · by_cases h2 : rk2Ord p n ∈ ({1, 2, 4} : Finset ℕ)
      · exact rk2_carrier_twF4_two hn3 hM hp hp2 h2
      · have h1' : rk2Ord p n ∈ ({6, 12} : Finset ℕ) := by
          simp only [Finset.mem_insert, Finset.mem_singleton] at hm h2 ⊢
          omega
        exact rk2_carrier_twF4_one hn3 hM hp hp2 h1'
    · rw [rk2Mult_twF4_eq_zero hm]
      exact (rk2_pRank_eq_zero_of_not_dvd hp (rk2_not_dvd_card_twF4 hn3 hM hp hp2 hm)).le

end CFSG.LocalAnalysis.GLTheoremA

