theorem rk2_pRank_le_two_of_rankLE2 {G : Type} [Group G] [Finite G] {p : ℕ} (hp : p.Prime)
    (h : RankLE2 p G) : CFSG.Open.pRank p (⊤ : Subgroup G) ≤ 2 :=
  CFSG.SectionRank.pRank_le hp.one_lt fun E _ hE => h E hE

theorem rk2_pRank_le_one_of_rankLE1 {G : Type} [Group G] [Finite G] {p : ℕ} (hp : p.Prime)
    (h : RankLE1 p G) : CFSG.Open.pRank p (⊤ : Subgroup G) ≤ 1 :=
  CFSG.SectionRank.pRank_le hp.one_lt fun E _ hE => by simpa using h E hE

theorem rk2_pRank_eq_zero_of_not_dvd {G : Type} [Group G] [Finite G] {p : ℕ} (hp : p.Prime)
    (h : ¬ p ∣ Nat.card G) : CFSG.Open.pRank p (⊤ : Subgroup G) = 0 := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hle : CFSG.Open.pRank p (⊤ : Subgroup G) ≤ 0 := by
    refine CFSG.SectionRank.pRank_le hp.one_lt ?_
    intro E _ hE
    have hEp : IsPGroup p E := fun x => ⟨1, by
      apply Subtype.ext
      simpa using hE.2 x x.2⟩
    obtain ⟨k, hk⟩ := hEp.exists_card_eq
    have hk0 : k = 0 := by
      rcases Nat.eq_zero_or_pos k with h0 | hpos
      · exact h0
      · exfalso
        apply h
        have hdvd : p ∣ p ^ k := dvd_pow_self p hpos.ne'
        rw [← hk] at hdvd
        exact hdvd.trans (Subgroup.card_subgroup_dvd_card E)
    rw [hk, hk0, pow_zero]
  omega

private theorem rk2Ord_eq_four_of_dvd_sq_add_one {n p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (h : p ∣ (2 ^ n) ^ 2 + 1) : rk2Ord p n = 4 := by
  have hpos := rk2Ord_pos hp hp2 n
  have hz : ((2 : ZMod p) ^ n) ^ 2 = -1 := by
    have h0 : (((2 ^ n) ^ 2 + 1 : ℕ) : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff _ p).2 h
    push_cast at h0
    linear_combination h0
  have h4 : rk2Ord p n ∣ 4 := by
    rw [rk2Ord_dvd_iff]
    have hz4 : (2 : ZMod p) ^ (n * 4) = 1 := by
      rw [pow_mul]
      rw [show ((2 : ZMod p) ^ n) ^ 4 = (((2 : ZMod p) ^ n) ^ 2) ^ 2 by ring, hz]
      norm_num
    have hle : 1 ≤ 2 ^ (n * 4) := Nat.one_le_two_pow
    have hz0 : (((2 ^ (n * 4) - 1 : ℕ)) : ZMod p) = 0 := by
      rw [Nat.cast_sub hle]
      push_cast
      rw [hz4]
      ring
    exact (ZMod.natCast_eq_zero_iff _ p).1 hz0
  have h1 : rk2Ord p n ≠ 1 := by
    intro hone
    rw [rk2Ord_eq_one_iff] at hone
    have hq1 : (2 : ZMod p) ^ n = 1 := by
      have h0 : (((2 ^ n - 1 : ℕ)) : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff _ p).2 hone
      rw [Nat.cast_sub (Nat.one_le_two_pow)] at h0
      push_cast at h0
      linear_combination h0
    rw [hq1] at hz
    norm_num at hz
    have hpdiv : p ∣ 2 := by
      refine (ZMod.natCast_eq_zero_iff 2 p).1 ?_
      have h : (2 : ZMod p) = 0 := by
        have h' := sub_eq_zero.2 hz
        rw [show (2 : ZMod p) = 1 + 1 by norm_num]
        simpa using h'
      exact h
    exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 hpdiv)
  have h2 : rk2Ord p n ≠ 2 := by
    intro htwo
    rw [rk2Ord_eq_two_iff hp hp2] at htwo
    have hqm1 : (2 : ZMod p) ^ n = -1 := by
      have h0 : (((2 ^ n + 1 : ℕ)) : ZMod p) = 0 := (ZMod.natCast_eq_zero_iff _ p).2 htwo
      push_cast at h0
      linear_combination h0
    rw [hqm1] at hz
    norm_num at hz
    have hpdiv : p ∣ 2 := by
      refine (ZMod.natCast_eq_zero_iff 2 p).1 ?_
      have h : (2 : ZMod p) = 0 := by
        have h' := sub_eq_zero.2 hz
        rw [show (2 : ZMod p) = 1 + 1 by norm_num]
        simpa using h'
      exact h
    exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 hpdiv)
  have h3 : rk2Ord p n ≠ 3 := by
    intro h
    rw [h] at h4
    norm_num at h4
  have hle : rk2Ord p n ≤ 4 := Nat.le_of_dvd (by norm_num) h4
  omega

private theorem rk2_eval_exhaustionPhi_eq_cyclotomic (m : ℕ)
    (hm : m ∈ ({1, 2, 3, 4, 6, 12} : Finset ℕ)) (q : ℤ) :
    (CFSG.RankThree.Chevalley.exhaustionPhi m).eval q = (Polynomial.cyclotomic m ℤ).eval q := by
  simp only [Finset.mem_insert, Finset.mem_singleton] at hm
  rcases hm with rfl | rfl | rfl | rfl | rfl | rfl
  · simp [CFSG.RankThree.Chevalley.exhaustionPhi, Polynomial.cyclotomic_one]
  · simp [CFSG.RankThree.Chevalley.exhaustionPhi, Polynomial.cyclotomic_two]
  · simp [CFSG.RankThree.Chevalley.exhaustionPhi,
      CFSG.LieType.SeitzGeneration.cyclotomic_three_eq]
  · simp [CFSG.RankThree.Chevalley.exhaustionPhi,
      CFSG.LieType.SeitzGeneration.cyclotomic_four_eq]
  · simp [CFSG.RankThree.Chevalley.exhaustionPhi,
      CFSG.LieType.SeitzGeneration.cyclotomic_six_eq]
  · simp [CFSG.RankThree.Chevalley.exhaustionPhi,
      CFSG.LieType.SeitzGeneration.cyclotomic_twelve_eq]

theorem rk2_exists_dvd_cyclotomic_of_dvd_card_triD4 {R : Type} [Group R] [Finite R] {n p : ℕ}
    (hM : MarkedModel ⟨.triD4, 0, n⟩ R) (hp : p.Prime) (hp2 : p ≠ 2) (hp3 : 3 < p)
    (hdvd : p ∣ Nat.card R) :
    ∃ m ∈ ({1, 2, 3, 6, 12} : Finset ℕ),
      (p : ℤ) ∣ (Polynomial.cyclotomic m ℤ).eval ((2 ^ n : ℕ) : ℤ) := by
  rcases hM with ⟨hcl, -⟩ | ⟨-, hce, hce'⟩ | ⟨-, hrt, -⟩ | ⟨-, ht, -⟩
  · exact absurd hcl (by simp [markTag, classicalTags])
  · have hce'' : ChevalleyExceptionalModel R .trialityD4 2 n := hce'
    obtain ⟨m, hm, hpm⟩ :=
      ((CFSG.RankThree.Chevalley.exact_E_type_and_triality_cross_prime_factor_exhaustion
        hp hp3 (fun h => hp2 h.symm) hce'').1 hdvd).2.2.2.2 rfl
    refine ⟨m, by simpa using hm, ?_⟩
    have hm4 : m ∈ ({1, 2, 3, 4, 6, 12} : Finset ℕ) := by
      simp only [Finset.mem_insert, Finset.mem_singleton] at hm ⊢
      omega
    have hΦ := rk2_eval_exhaustionPhi_eq_cyclotomic m hm4 ((2 ^ n : ℕ) : ℤ)
    rwa [← hΦ]
  · exact absurd hrt (by simp [markTag, reeTitsTags])
  · exact absurd ht (by simp [markTag])

theorem rk2_exists_dvd_cyclotomic_of_dvd_card_reeF4 {R : Type} [Group R] [Finite R] {n p : ℕ}
    (hn : 3 ≤ n) (hM : MarkedModel ⟨.twF4, 0, n⟩ R) (hp : p.Prime) (hp2 : p ≠ 2) (hp3 : 3 < p)
    (hdvd : p ∣ Nat.card R) :
    ∃ m ∈ ({1, 2, 4, 6, 12} : Finset ℕ),
      (p : ℤ) ∣ (Polynomial.cyclotomic m ℤ).eval ((2 ^ n : ℕ) : ℤ) := by
  rcases hM with ⟨hcl, -⟩ | ⟨-, hce, -⟩ | ⟨-, hrt, hree⟩ | ⟨-, ht, -⟩
  · exact absurd hcl (by simp [markTag, classicalTags])
  · exact absurd hce (by simp [markTag, chevalleyExceptionalTags])
  · obtain ⟨hadm, a, hf₀, hrel⟩ := hree
    have hf : n = 2 * a + 1 := by simpa [markDeg] using hf₀
    have ha : 1 ≤ a := by omega
    have hree' : ReeTitsModel R .twistedF4 2 (2 * a + 1) := hf ▸ ⟨hadm, a, hf₀, hrel⟩
    obtain ⟨K, _, _, hcharK, hcard, ⟨eR⟩⟩ :=
      CFSG.LieType.ChevTwo.Semi.exists_mulEquiv_reeGamma ha hree'
    haveI := hcharK
    have hK : Nat.card K = 2 ^ (2 * a + 1) := hcard
    have hdvd' : p ∣ Nat.card (CFSG.LieType.Ree.ReeTag.F4.reeGamma K a) := by
      rw [← Nat.card_congr eR.toEquiv]
      exact hdvd
    obtain ⟨-, hexh⟩ :=
      CFSG.RankThree.LargeReeOrder.large_Ree_exact_native_order_and_prime_factor_exhaustion
        a K hK
    have hq1 : 1 ≤ 2 ^ (2 * a + 1) := Nat.one_le_two_pow
    have hq2le : 2 ^ (2 * a + 1) ≤ (2 ^ (2 * a + 1)) ^ 2 := by
      calc 2 ^ (2 * a + 1) = 2 ^ (2 * a + 1) * 1 := by ring
        _ ≤ 2 ^ (2 * a + 1) * 2 ^ (2 * a + 1) := Nat.mul_le_mul_left _ hq1
        _ = (2 ^ (2 * a + 1)) ^ 2 := by ring
    have hq4le : (2 ^ (2 * a + 1)) ^ 2 ≤ (2 ^ (2 * a + 1)) ^ 4 := by
      calc (2 ^ (2 * a + 1)) ^ 2 = (2 ^ (2 * a + 1)) ^ 2 * 1 := by ring
        _ ≤ (2 ^ (2 * a + 1)) ^ 2 * (2 ^ (2 * a + 1)) ^ 2 :=
            Nat.mul_le_mul_left _ (Nat.one_le_pow _ _ hq1)
        _ = (2 ^ (2 * a + 1)) ^ 4 := by ring
    rcases hexh p hp hp3 hdvd' with h1 | h1 | h1 | h1 | h1
    · refine ⟨1, by simp, ?_⟩
      rw [hf]
      have hz : (p : ℤ) ∣ ((2 ^ (2 * a + 1) : ℕ) : ℤ) - 1 := by
        have h' := Int.natCast_dvd_natCast.mpr h1
        rwa [Nat.cast_sub hq1] at h' 
      simpa [Polynomial.cyclotomic_one] using hz
    · refine ⟨2, by simp, ?_⟩
      rw [hf]
      have hz : (p : ℤ) ∣ ((2 ^ (2 * a + 1) : ℕ) : ℤ) + 1 := by
        simpa using Int.natCast_dvd_natCast.mpr h1
      simpa [Polynomial.cyclotomic_two] using hz
    · refine ⟨4, by simp, ?_⟩
      rw [hf, CFSG.LieType.SeitzGeneration.cyclotomic_four_eq]
      simp only [Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_one]
      have hz := Int.natCast_dvd_natCast.mpr h1
      push_cast at hz
      exact hz
    · refine ⟨6, by simp, ?_⟩
      rw [hf, CFSG.LieType.SeitzGeneration.cyclotomic_six_eq]
      simp only [Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_one]
      have hz := Int.natCast_dvd_natCast.mpr h1
      rw [Nat.cast_add, Nat.cast_sub hq2le] at hz
      push_cast at hz
      exact hz
    · refine ⟨12, by simp, ?_⟩
      rw [hf, CFSG.LieType.SeitzGeneration.cyclotomic_twelve_eq]
      simp only [Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_one]
      have hz := Int.natCast_dvd_natCast.mpr h1
      rw [Nat.cast_add, Nat.cast_sub hq4le] at hz
      push_cast at hz
      exact hz
  · exact absurd ht (by simp [markTag])

private theorem rk2_not_dvd_card_triD4 {R : Type} [Group R] [Finite R] {n p : ℕ}
    (hM : MarkedModel ⟨.triD4, 0, n⟩ R) (hp : p.Prime) (hp2 : p ≠ 2)
    (hm : rk2Ord p n ∉ ({1, 2, 3, 6, 12} : Finset ℕ)) : ¬ p ∣ Nat.card R := by
  intro hdvd
  have hp3 : 3 < p := by
    have h2p : 2 ≤ p := hp.two_le
    rcases (by omega : p = 3 ∨ 3 < p) with h3 | h3
    · subst h3
      have hle : rk2Ord 3 n ≤ 2 := Nat.le_of_dvd (by norm_num) (rk2Ord_three_dvd_two n)
      have hpos : 0 < rk2Ord 3 n := rk2Ord_pos Nat.prime_three (by norm_num) n
      have h2 : rk2Ord 3 n = 1 ∨ rk2Ord 3 n = 2 := by omega
      rcases h2 with h1 | h2
      · exact (hm (by simp [h1])).elim
      · exact (hm (by simp [h2])).elim
    · exact h3
  obtain ⟨m, hm', hpm⟩ := rk2_exists_dvd_cyclotomic_of_dvd_card_triD4 hM hp hp2 hp3 hdvd
  have hde : m ≠ rk2Ord p n := by
    intro h
    exact hm (h ▸ hm')
  have hpd : ¬ p ∣ m := by
    intro hpdm
    have hm12 : m ∣ 12 := by
      simp only [Finset.mem_insert, Finset.mem_singleton] at hm'
      rcases hm' with rfl | rfl | rfl | rfl | rfl <;> norm_num
    have hp12 : p ∣ 12 := hpdm.trans hm12
    have h2or3 : p ∣ 2 ∨ p ∣ 3 := by
      have h : p ∣ 2 ^ 2 * 3 := by simpa using hp12
      rcases (Nat.Prime.dvd_mul hp).1 h with h' | h'
      · exact Or.inl (hp.dvd_of_dvd_pow h')
      · exact Or.inr h'
    rcases h2or3 with h' | h'
    · exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 h')
    · have := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).1 h'
      omega
  have he : orderOf ((2 ^ n : ℕ) : ZMod p) = rk2Ord p n := by
    rw [rk2Ord]
    push_cast
    rfl
  exact CFSG.LieType.SeitzGeneration.not_dvd_cyclotomic_eval_of_ne hp he hde hpd hpm

