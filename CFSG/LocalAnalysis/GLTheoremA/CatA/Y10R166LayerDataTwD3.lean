variable {F : Type} [Field F] [Finite F] [CharP F 2] {n q : ℕ}
  {b c : F} (hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0) (hF : Nat.card F = 2 ^ n)
  (hq : q.Prime) (hqdvd : q ∣ 2 ^ n + 1)

theorem exists_qElt_leviFixBar {d : ℕ} {Q : QuadraticForm F (Fin d → F)} {P₁ P₂ : HypPair Q}
    (h₁₂ : P₁.Orth P₂) (hQ : (polarBilin Q).Nondegenerate)
    (hT : ∃ T : Submodule F (Fin d → F), Module.finrank F T = 3 ∧ ∀ x ∈ T, Q x = 0)
    (hQ' : ∃ v, Q v ≠ 0) {n q : ℕ} (hn : 2 ≤ n) (hF : Nat.card F = 2 ^ n)
    (hq : q.Prime) (hqdvd : q ∣ 2 ^ n + 1) :
    ∃ g ∈ leviFixBar P₁ P₂, orderOf g = q := by
  obtain ⟨t, ht⟩ := exists_order_q_sl2 (F := F) hn hF hq hqdvd
  refine ⟨(leviFixBarEquiv h₁₂ hQ hT hQ').symm t, ((leviFixBarEquiv h₁₂ hQ hT hQ').symm t).2, ?_⟩
  rw [Subgroup.orderOf_coe]
  exact (MulEquiv.orderOf_eq (leviFixBarEquiv h₁₂ hQ hT hQ').symm t).trans ht

theorem exists_qElt_anisoTorus {d : ℕ} {Q : QuadraticForm F (Fin d → F)} {a a' : Fin d} {b c : F}
    (h : IsAnisoCoord Q a a' b c) (hQ : (polarBilin Q).Nondegenerate)
    (hT : ∃ T : Submodule F (Fin d → F), Module.finrank F T = 3 ∧ ∀ x ∈ T, Q x = 0)
    {n q : ℕ} (hF : Nat.card F = 2 ^ n) (hq : q.Prime) (hqdvd : q ∣ 2 ^ n + 1) :
    ∃ u ∈ anisoTorusOf Q h.ne b c, orderOf u = q := by
  haveI : Fact q.Prime := ⟨hq⟩
  have hcard : Nat.card (anisoTorusOf Q h.ne b c) = Nat.card F + 1 :=
    h.card_anisoTorusOf hQ hT
  have hdvd : q ∣ Nat.card (anisoTorusOf Q h.ne b c) := by rw [hcard, hF]; exact hqdvd
  obtain ⟨u, hu⟩ := exists_prime_orderOf_dvd_card' (G := anisoTorusOf Q h.ne b c) q hdvd
  exact ⟨u, u.2, by simpa using hu⟩

theorem exists_g0 (hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0) (hF : Nat.card F = 2 ^ n)
    (hq : q.Prime) (hqdvd : q ∣ 2 ^ n + 1) (hn : 2 ≤ n) :
    ∃ g0 ∈ leviFixBar (cPair F b c 0) (cPair F b c 1), orderOf g0 = q := by
  obtain ⟨hQ, hT⟩ := regular_coordinateQuadMinus 5 F b c (by norm_num) hirr
  exact exists_qElt_leviFixBar (cPair_orth F b c 0 1 (by decide)) hQ hT
    (isAnisoCoord_coordinateQuadMinus (K := F) (by norm_num) hirr).exists_ne_zero hn hF hq hqdvd

theorem exists_g2 (hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0) (hF : Nat.card F = 2 ^ n)
    (hq : q.Prime) (hqdvd : q ∣ 2 ^ n + 1) (hn : 2 ≤ n) :
    ∃ g2 ∈ leviFixBar (cPair F b c 2) (cPair F b c 3), orderOf g2 = q := by
  obtain ⟨hQ, hT⟩ := regular_coordinateQuadMinus 5 F b c (by norm_num) hirr
  exact exists_qElt_leviFixBar (cPair_orth F b c 2 3 (by decide)) hQ hT
    (isAnisoCoord_coordinateQuadMinus (K := F) (by norm_num) hirr).exists_ne_zero hn hF hq hqdvd

theorem exists_g3 (hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0) (hF : Nat.card F = 2 ^ n)
    (hq : q.Prime) (hqdvd : q ∣ 2 ^ n + 1) (hn : 2 ≤ n) :
    ∃ g3 ∈ leviFixBar (cPair F b c 2) (flipPair (cPair F b c 3)), orderOf g3 = q := by
  obtain ⟨hQ, hT⟩ := regular_coordinateQuadMinus 5 F b c (by norm_num) hirr
  have h23 := cPair_orth F b c 2 3 (by decide)
  have h2f : (cPair F b c 2).Orth (flipPair (cPair F b c 3)) :=
    ⟨h23.ef, h23.ee, h23.ff, h23.fe⟩
  exact exists_qElt_leviFixBar h2f hQ hT
    (isAnisoCoord_coordinateQuadMinus (K := F) (by norm_num) hirr).exists_ne_zero hn hF hq hqdvd

theorem exists_u (hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0) (hF : Nat.card F = 2 ^ n)
    (hq : q.Prime) (hqdvd : q ∣ 2 ^ n + 1) (hn : 2 ≤ n) :
    ∃ u ∈ anisoTorusOf (Qc F b c) (anisoCoord_ne (n := 5) (by norm_num)) b c, orderOf u = q := by
  obtain ⟨hQ, hT⟩ := regular_coordinateQuadMinus 5 F b c (by norm_num) hirr
  exact exists_qElt_anisoTorus (h := isAnisoCoord_coordinateQuadMinus (K := F) (by norm_num) hirr)
    hQ hT hF hq hqdvd

private theorem card_sup_zpowers_leviFixBar_eq_sq
    (hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0) (hF : Nat.card F = 2 ^ n)
    (hq : q.Prime) (hqdvd : q ∣ 2 ^ n + 1) (hn : 2 ≤ n)
    {g2 g3 : matrixProjectiveDerived (Qc F b c)}
    (hg2 : g2 ∈ leviFixBar (cPair F b c 2) (cPair F b c 3))
    (hg3 : g3 ∈ leviFixBar (cPair F b c 2) (flipPair (cPair F b c 3)))
    (hord2 : orderOf g2 = q) (hord3 : orderOf g3 = q) :
    Nat.card ↥(Subgroup.zpowers g2 ⊔ Subgroup.zpowers g3) = q ^ 2 := by
  classical
  obtain ⟨hQ, hT⟩ := regular_coordinateQuadMinus 5 F b c (by norm_num) hirr
  have hc32 : g2 * g3 = g3 * g2 := by
    have h := le_centralizer_iff.mp
      (leviFixBar_le_centralizer_flip (cPair_orth F b c 2 3 (by decide)) hQ hT) hg3
    exact mem_centralizer_iff.mp h g2 hg2
  have hinf23 : Subgroup.zpowers g2 ⊓ Subgroup.zpowers g3 = ⊥ := by
    have hle : Subgroup.zpowers g2 ⊓ Subgroup.zpowers g3 ≤
        leviFixBar (cPair F b c 2) (cPair F b c 3) ⊓
          leviFixBar (cPair F b c 2) (flipPair (cPair F b c 3)) :=
      inf_le_inf (Subgroup.zpowers_le.2 hg2) (Subgroup.zpowers_le.2 hg3)
    rw [leviFixBar_inf_flip_eq_bot (cPair_orth F b c 2 3 (by decide)) hQ hT
      (isAnisoCoord_coordinateQuadMinus (K := F) (by norm_num) hirr).exists_ne_zero] at hle
    exact le_bot_iff.1 hle
  have hcomm : ∀ x ∈ Subgroup.zpowers g2, ∀ y ∈ Subgroup.zpowers g3, x * y = y * x := by
    intro x hx y hy
    obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.1 hx
    obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
    exact ((show Commute g2 g3 from hc32).zpow_zpow i j).eq
  have hcard2 : Nat.card ↥(Subgroup.zpowers g2) = q := by rw [Nat.card_zpowers, hord2]
  have hcard3 : Nat.card ↥(Subgroup.zpowers g3) = q := by rw [Nat.card_zpowers, hord3]
  have hcardE : Nat.card ↥(Subgroup.zpowers g2 ⊔ Subgroup.zpowers g3) = q ^ 2 := by
    have h := (CFSG.GroupTheory.card_sup_mul_card_inf_of_commute
      (Subgroup.zpowers g2) (Subgroup.zpowers g3) hcomm).1
    rw [hinf23, Subgroup.card_bot, mul_one, hcard2, hcard3] at h
    rw [h, _root_.sq]
  exact hcardE

private theorem le_centralizer_zpowers_sup_stabPairsBar
    (hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0) (hF : Nat.card F = 2 ^ n)
    (hq : q.Prime) (hqdvd : q ∣ 2 ^ n + 1) (hn : 2 ≤ n)
    {g2 g3 : matrixProjectiveDerived (Qc F b c)}
    (hg2 : g2 ∈ leviFixBar (cPair F b c 2) (cPair F b c 3))
    (hg3 : g3 ∈ leviFixBar (cPair F b c 2) (flipPair (cPair F b c 3)))
    (hord2 : orderOf g2 = q) (hord3 : orderOf g3 = q) :
    stabPairsBar (Qc F b c) miE2 miF2 miE3 miF3 ≤
      Subgroup.centralizer (↑(Subgroup.zpowers g2 ⊔ Subgroup.zpowers g3) :
        Set (matrixProjectiveDerived (Qc F b c))) := by
  classical
  obtain ⟨hQ, hT⟩ := regular_coordinateQuadMinus 5 F b c (by norm_num) hirr
  have hQ' : ∃ v, Qc F b c v ≠ 0 :=
    (isAnisoCoord_coordinateQuadMinus (K := F) (by norm_num) hirr).exists_ne_zero
  let G2 : (Fin (2 * 5) → F) ≃ₗ[F] (Fin (2 * 5) → F) := projLift hQ' g2
  have hG2L : G2 ∈ leviFix (orthDerived (Qc F b c)) (cPair F b c 2) (cPair F b c 3) :=
    projLift_mem_leviFix hQ' hg2
  have hG2root : G2 ∈ rootLevi (Qc F b c) (cPair F b c 2) (cPair F b c 3) :=
    (mem_leviFix.mp hG2L).2.1
  have hG2W : ∀ x, InW (cPair F b c 2) (cPair F b c 3) x → G2 x = x :=
    (mem_leviFix.mp hG2L).2.2
  have hL2 : ∀ l ∈ stabPairsBar (Qc F b c) miE2 miF2 miE3 miF3,
      g2 * l = l * g2 := by
    rintro l ⟨Y, hY, rfl⟩
    obtain ⟨hY2, hY3⟩ := mem_inf.mp (mem_subgroupOf.mp hY)
    have h2e : (Y : (Fin (2 * 5) → F) ≃ₗ[F] (Fin (2 * 5) → F)) (cPair F b c 2).e =
        (cPair F b c 2).e := hY2.1
    have h2f : (Y : _ ≃ₗ[F] _) (cPair F b c 2).f = (cPair F b c 2).f := hY2.2
    have h3e : (Y : _ ≃ₗ[F] _) (cPair F b c 3).e = (cPair F b c 3).e := hY3.1
    have h3f : (Y : _ ≃ₗ[F] _) (cPair F b c 3).f = (cPair F b c 3).f := hY3.2
    have hcomm' := leviFix_commute_of_fix (cPair_orth F b c 2 3 (by decide))
      (H := orthDerived (Qc F b c)) hG2L
      (Subgroup.commutator_le_self (TauCeti.QuadraticMap.orthogonalGroup (Qc F b c)) Y.2)
      h2e h2f h3e h3f
    have hcomm'' : (⟨projLift hQ' g2, projLift_mem_orthDerived hQ' g2⟩ :
        orthDerived (Qc F b c)) * Y =
        Y * ⟨projLift hQ' g2, projLift_mem_orthDerived hQ' g2⟩ := Subtype.ext hcomm'
    have := congrArg (projHom (Qc F b c)) hcomm''
    simpa only [map_mul, projHom_projLift] using this
  have hL3 : ∀ l ∈ stabPairsBar (Qc F b c) miE2 miF2 miE3 miF3,
      g3 * l = l * g3 := by
    rintro l ⟨Y, hY, rfl⟩
    obtain ⟨hY2, hY3⟩ := mem_inf.mp (mem_subgroupOf.mp hY)
    have h2e : (Y : (Fin (2 * 5) → F) ≃ₗ[F] (Fin (2 * 5) → F)) (cPair F b c 2).e =
        (cPair F b c 2).e := hY2.1
    have h2f : (Y : _ ≃ₗ[F] _) (cPair F b c 2).f = (cPair F b c 2).f := hY2.2
    have h3e : (Y : _ ≃ₗ[F] _) (cPair F b c 3).e = (cPair F b c 3).e := hY3.1
    have h3f : (Y : _ ≃ₗ[F] _) (cPair F b c 3).f = (cPair F b c 3).f := hY3.2
    have h23 := cPair_orth F b c 2 3 (by decide)
    have h2f3 : (cPair F b c 2).Orth (flipPair (cPair F b c 3)) :=
      ⟨h23.ef, h23.ee, h23.ff, h23.fe⟩
    have hcomm' := leviFix_commute_of_fix h2f3 (H := orthDerived (Qc F b c))
      (projLift_mem_leviFix hQ' hg3)
      (Subgroup.commutator_le_self (TauCeti.QuadraticMap.orthogonalGroup (Qc F b c)) Y.2)
      h2e h2f h3f h3e
    have hcomm'' : (⟨projLift hQ' g3, projLift_mem_orthDerived hQ' g3⟩ :
        orthDerived (Qc F b c)) * Y =
        Y * ⟨projLift hQ' g3, projLift_mem_orthDerived hQ' g3⟩ := Subtype.ext hcomm'
    have := congrArg (projHom (Qc F b c)) hcomm''
    simpa only [map_mul, projHom_projLift] using this
  intro l hl
  rw [Subgroup.mem_centralizer_iff]
  intro x hx
  have h1 : Subgroup.zpowers g2 ≤
      Subgroup.centralizer ({l} : Set (matrixProjectiveDerived (Qc F b c))) := by
    intro y hy
    rw [Subgroup.mem_centralizer_singleton_iff]
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
    exact ((show Commute g2 l from hL2 l hl).zpow_left k).eq
  have h2 : Subgroup.zpowers g3 ≤
      Subgroup.centralizer ({l} : Set (matrixProjectiveDerived (Qc F b c))) := by
    intro y hy
    rw [Subgroup.mem_centralizer_singleton_iff]
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
    exact ((show Commute g3 l from hL3 l hl).zpow_left k).eq
  exact Subgroup.mem_centralizer_singleton_iff.mp ((sup_le h1 h2) hx)

private theorem normal_stabPairsBar_subgroupOf_centralizer
    (hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0) (hF : Nat.card F = 2 ^ n)
    (hq : q.Prime) (hqdvd : q ∣ 2 ^ n + 1) (hn : 2 ≤ n) (hq2 : q ≠ 2)
    {g2 g3 : matrixProjectiveDerived (Qc F b c)}
    (hg2 : g2 ∈ leviFixBar (cPair F b c 2) (cPair F b c 3))
    (hord2 : orderOf g2 = q)
    (hLle : stabPairsBar (Qc F b c) miE2 miF2 miE3 miF3 ≤
      Subgroup.centralizer (↑(Subgroup.zpowers g2 ⊔ Subgroup.zpowers g3) :
        Set (matrixProjectiveDerived (Qc F b c))))
    (h2e : Pi.single miE2 1 ∈ spanU₄ (cPair F b c 2) (cPair F b c 3))
    (h2e' : Pi.single miF2 1 ∈ spanU₄ (cPair F b c 2) (cPair F b c 3))
    (h3e : Pi.single miE3 1 ∈ spanU₄ (cPair F b c 2) (cPair F b c 3))
    (h3e' : Pi.single miF3 1 ∈ spanU₄ (cPair F b c 2) (cPair F b c 3)) :
    (stabPairsBar (Qc F b c) miE2 miF2 miE3 miF3).subgroupOf
      (Subgroup.centralizer (↑(Subgroup.zpowers g2 ⊔ Subgroup.zpowers g3) :
        Set (matrixProjectiveDerived (Qc F b c)))) |>.Normal := by
  classical
  have hQ' : ∃ v, Qc F b c v ≠ 0 :=
    (isAnisoCoord_coordinateQuadMinus (K := F) (by norm_num) hirr).exists_ne_zero
  let G2 : (Fin (2 * 5) → F) ≃ₗ[F] (Fin (2 * 5) → F) := projLift hQ' g2
  have hG2L : G2 ∈ leviFix (orthDerived (Qc F b c)) (cPair F b c 2) (cPair F b c 3) :=
    projLift_mem_leviFix hQ' hg2
  have hG2root : G2 ∈ rootLevi (Qc F b c) (cPair F b c 2) (cPair F b c 3) :=
    (mem_leviFix.mp hG2L).2.1
  have hG2W : ∀ x, InW (cPair F b c 2) (cPair F b c 3) x → G2 x = x :=
    (mem_leviFix.mp hG2L).2.2
  have hordG2 : orderOf G2 = q := by
    rw [show G2 = ↑(⟨projLift hQ' g2, projLift_mem_orthDerived hQ' g2⟩ :
      orthDerived (Qc F b c)) from rfl, Subgroup.orderOf_coe]
    exact (MulEquiv.orderOf_eq _ g2).trans hord2
  have hG2q : G2 ^ q = 1 := by
    rw [← hordG2]
    exact pow_orderOf_eq_one G2
  have hG2one : G2 ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hordG2
    exact hq.ne_one hordG2.symm
  have hoddq : Odd q := hq.odd_of_ne_two hq2
  rw [Subgroup.normal_subgroupOf_iff hLle]
  intro l k hl hk
  have hkg2 : g2 * k = k * g2 :=
    Subgroup.mem_centralizer_iff.mp hk g2 (Subgroup.mem_sup_left (Subgroup.mem_zpowers g2))
  have hkg2' : g2 * k⁻¹ = k⁻¹ * g2 :=
    Subgroup.mem_centralizer_iff.mp (inv_mem hk) g2
      (Subgroup.mem_sup_left (Subgroup.mem_zpowers g2))
  let H : (Fin (2 * 5) → F) ≃ₗ[F] (Fin (2 * 5) → F) := projLift hQ' k
  let Hinv : (Fin (2 * 5) → F) ≃ₗ[F] (Fin (2 * 5) → F) := projLift hQ' k⁻¹
  have hHcomm : H * G2 = G2 * H := by
    have h1 : projLift hQ' (g2 * k) = projLift hQ' (k * g2) := by rw [hkg2]
    rw [projLift_mul, projLift_mul] at h1
    exact h1.symm
  have hHinvcomm : Hinv * G2 = G2 * Hinv := by
    have h1 : projLift hQ' (g2 * k⁻¹) = projLift hQ' (k⁻¹ * g2) := by rw [hkg2']
    rw [projLift_mul, projLift_mul] at h1
    exact h1.symm
  have hHmap : ∀ v ∈ spanU₄ (cPair F b c 2) (cPair F b c 3),
      H v ∈ spanU₄ (cPair F b c 2) (cPair F b c 3) :=
    fun v hv => apply_mem_spanU₄_of_commute (cPair_orth F b c 2 3 (by decide)) hG2root hG2W
      hoddq hG2q hG2one hHcomm hv
  have hHinvmap : ∀ v ∈ spanU₄ (cPair F b c 2) (cPair F b c 3),
      Hinv v ∈ spanU₄ (cPair F b c 2) (cPair F b c 3) :=
    fun v hv => apply_mem_spanU₄_of_commute (cPair_orth F b c 2 3 (by decide)) hG2root hG2W
      hoddq hG2q hG2one hHinvcomm hv
  have hHinv_eq : Hinv = H⁻¹ := by
    rw [show Hinv = projLift hQ' k⁻¹ from rfl, show H = projLift hQ' k from rfl,
      ← projLiftHom_apply hQ' k⁻¹, ← projLiftHom_apply hQ' k, map_inv]
  obtain ⟨Y, hY, rfl⟩ := hl
  obtain ⟨hY2, hY3⟩ := mem_inf.mp (mem_subgroupOf.mp hY)
  have hYfix : ∀ v ∈ spanU₄ (cPair F b c 2) (cPair F b c 3),
      (Y : (Fin (2 * 5) → F) ≃ₗ[F] (Fin (2 * 5) → F)) v = v := by
    intro v hv
    induction hv using Submodule.span_induction with
    | mem x hx =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl | rfl | rfl
      · exact hY2.1
      · exact hY3.1
      · exact hY2.2
      · exact hY3.2
    | zero => exact map_zero _
    | add x y _ _ hx hy => rw [map_add, hx, hy]
    | smul a x _ hx => rw [map_smul, hx]
  have hZeq : projLift hQ' (k * projHom (Qc F b c) Y * k⁻¹) = H * Y * Hinv := by
    rw [projLift_mul, projLift_mul, projLift_projHom]
  have hZw : ∀ v ∈ spanU₄ (cPair F b c 2) (cPair F b c 3),
      projLift hQ' (k * projHom (Qc F b c) Y * k⁻¹) v = v := by
    intro v hv
    rw [hZeq, LinearEquiv.mul_apply, LinearEquiv.mul_apply,
      hYfix _ (hHinvmap v hv), hHinv_eq, LinearEquiv.apply_inv_apply']
  let Z : orthDerived (Qc F b c) :=
    ⟨projLift hQ' (k * projHom (Qc F b c) Y * k⁻¹), projLift_mem_orthDerived hQ' _⟩
  have hZmem : Z ∈ (stabSub (K := F) miE2 miF2 ⊓ stabSub miE3 miF3).subgroupOf
      (orthDerived (Qc F b c)) := by
    refine mem_subgroupOf.mpr (mem_inf.mpr ⟨mem_stabSub.mpr ⟨?_, ?_⟩,
      mem_stabSub.mpr ⟨?_, ?_⟩⟩)
    · exact hZw (Pi.single (minusIndexEquiv 5 (by norm_num) (Sum.inl 2)) 1) h2e
    · exact hZw (Pi.single (minusIndexEquiv 5 (by norm_num) (Sum.inr (Sum.inl 2))) 1) h2e'
    · exact hZw (Pi.single (minusIndexEquiv 5 (by norm_num) (Sum.inl 3)) 1) h3e
    · exact hZw (Pi.single (minusIndexEquiv 5 (by norm_num) (Sum.inr (Sum.inl 3))) 1) h3e'
  exact ⟨Z, hZmem, projHom_projLift hQ' _⟩
theorem exists_qLayer_of_mem_leviFixBar (hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0)
    (hF : Nat.card F = 2 ^ n) (hq : q.Prime) (hqdvd : q ∣ 2 ^ n + 1) (hn : 2 ≤ n) (hq2 : q ≠ 2)
    {g2 g3 : matrixProjectiveDerived (Qc F b c)}
    (hg2 : g2 ∈ leviFixBar (cPair F b c 2) (cPair F b c 3))
    (hg3 : g3 ∈ leviFixBar (cPair F b c 2) (flipPair (cPair F b c 3)))
    (hord2 : orderOf g2 = q) (hord3 : orderOf g3 = q) :
    Nat.card ↥(Subgroup.zpowers g2 ⊔ Subgroup.zpowers g3) = q ^ 2 ∧
      GLAPLayer q (Subgroup.centralizer (↑(Subgroup.zpowers g2 ⊔ Subgroup.zpowers g3) :
        Set (matrixProjectiveDerived (Qc F b c)))) ≠ ⊥ := by
  classical
  obtain ⟨hQ, hT⟩ := regular_coordinateQuadMinus 5 F b c (by norm_num) hirr
  have hQ' : ∃ v, Qc F b c v ≠ 0 :=
    (isAnisoCoord_coordinateQuadMinus (K := F) (by norm_num) hirr).exists_ne_zero
  obtain ⟨g0, hg0, hord0⟩ := exists_g0 (F := F) (n := n) (q := q) (b := b) (c := c)
    hirr hF hq hqdvd hn
  have hcardE := card_sup_zpowers_leviFixBar_eq_sq hirr hF hq hqdvd hn hg2 hg3 hord2 hord3
  refine ⟨hcardE, ?_⟩
  set a2 : Fin (2 * 5) := minusIndexEquiv 5 (by norm_num) (Sum.inl 2) with ha2
  set a2' : Fin (2 * 5) := minusIndexEquiv 5 (by norm_num) (Sum.inr (Sum.inl 2)) with ha2'
  set a3 : Fin (2 * 5) := minusIndexEquiv 5 (by norm_num) (Sum.inl 3) with ha3
  set a3' : Fin (2 * 5) := minusIndexEquiv 5 (by norm_num) (Sum.inr (Sum.inl 3)) with ha3'
  let L : Subgroup (matrixProjectiveDerived (Qc F b c)) := stabPairsBar (Qc F b c) a2 a2' a3 a3'
  have hLq : CFSG.Open.IsQuasisimple ↥L := by
    have h := (isQuasisimple_minusStabPairsBar_of_five_le (K := F) (n := 5) (by norm_num)
      (b := b) (c := c) hirr (i := 2) (j := 3) (by decide)).1
    exact ⟨h.1.commutator_eq_top, h.2.1⟩
  have hLZ : Subgroup.center ↥L = ⊥ :=
    (isQuasisimple_minusStabPairsBar_of_five_le (K := F) (n := 5) (by norm_num) (b := b) (c := c)
      hirr (i := 2) (j := 3) (by decide)).2
  have hLle := le_centralizer_zpowers_sup_stabPairsBar hirr hF hq hqdvd hn
    hg2 hg3 hord2 hord3
  have h2e : Pi.single a2 1 ∈ spanU₄ (cPair F b c 2) (cPair F b c 3) :=
    Submodule.subset_span (by simp [a2, cPair])
  have h2e' : Pi.single a2' 1 ∈ spanU₄ (cPair F b c 2) (cPair F b c 3) :=
    Submodule.subset_span (by simp [a2', cPair])
  have h3e : Pi.single a3 1 ∈ spanU₄ (cPair F b c 2) (cPair F b c 3) :=
    Submodule.subset_span (by simp [a3, cPair])
  have h3e' : Pi.single a3' 1 ∈ spanU₄ (cPair F b c 2) (cPair F b c 3) :=
    Submodule.subset_span (by simp [a3', cPair])
  have hN := normal_stabPairsBar_subgroupOf_centralizer hirr hF hq hqdvd hn hq2
    hg2 hord2 hLle h2e h2e' h3e h3e'
  have hL01 : leviFixBar (cPair F b c 0) (cPair F b c 1) ≤ L := by
    rintro x ⟨Y, hY, rfl⟩
    have hY0 := mem_subgroupOf.mp hY
    have hYfix := (mem_leviFix.mp hY0).2.2
    have hInW2 := inW_of_orth (P₁ := cPair F b c 2) (P₃ := cPair F b c 0) (P₄ := cPair F b c 1)
      (cPair_orth F b c 2 0 (by decide)) (cPair_orth F b c 2 1 (by decide))
    have hInW3 := inW_of_orth (P₁ := cPair F b c 3) (P₃ := cPair F b c 0) (P₄ := cPair F b c 1)
      (cPair_orth F b c 3 0 (by decide)) (cPair_orth F b c 3 1 (by decide))
    refine ⟨Y, mem_subgroupOf.mpr (mem_inf.mpr ⟨mem_stabSub.mpr ⟨?_, ?_⟩,
      mem_stabSub.mpr ⟨?_, ?_⟩⟩), rfl⟩
    · exact hYfix _ hInW2.1
    · exact hYfix _ hInW2.2
    · exact hYfix _ hInW3.1
    · exact hYfix _ hInW3.2
  have hdvd : q ∣ Nat.card (↥L ⧸ Subgroup.center ↥L) := by
    have hcard : Nat.card (↥L ⧸ Subgroup.center ↥L) = Nat.card ↥L := by
      rw [hLZ]
      exact Nat.card_congr (QuotientGroup.quotientBot (G := ↥L)).toEquiv
    rw [hcard]
    have hg0L : g0 ∈ L := hL01 hg0
    have hord' : orderOf (⟨g0, hg0L⟩ : ↥L) = q := by
      rw [← Subgroup.orderOf_coe]; exact hord0
    exact hord' ▸ orderOf_dvd_natCard (⟨g0, hg0L⟩ : ↥L)
  exact glaPLayer_ne_bot_of_normal_quasisimple hq hLle hN hLq hdvd

