variable {K : Type} [Field K] [Finite K] [CharP K 2]

theorem centralizer_nonsplit_E6_of_orderOf {p : ℕ} [Fact p.Prime] (hp3 : 3 ≤ p)
    (hpq : p ∣ Nat.card K + 1) {X : Subgroup (ModGL .E6 K)}
    (hXJ : X ≤ EPilot.highRootSL2 .E6 K) (hXcyc : IsCyclic X)
    (hXcard : Nat.card X = Nat.card K + 1) {x : ModGL .E6 K} (hxX : x ∈ X)
    (hx : orderOf x = p) :
    adjointGroup .E6 K ⊓ centralizer ({x} : Set (ModGL .E6 K)) =
        X ⊔ rootSpan .E6 K a5LeviRoots ∧
      Disjoint X (rootSpan .E6 K a5LeviRoots) ∧
      X ≤ centralizer (rootSpan .E6 K a5LeviRoots : Set (ModGL .E6 K)) := by
  classical
  have hτ : (Tag.E6 : Tag) = .E6 ∨ (Tag.E6 : Tag) = .E7 ∨ (Tag.E6 : Tag) = .E8 := Or.inl rfl
  set ρ : SL2 K →* ModGL .E6 K := rootSL2 .E6 K (highRoot .E6) with hρ
  have hinj : Function.Injective ρ := rootSL2_highRoot_injective
  have hXrange : X ≤ ρ.range := by
    rw [range_rootSL2_highRoot]
    exact hXJ
  set X' : Subgroup (SL2 K) := X.comap ρ with hX'
  have hX'map : X'.map ρ = X := by
    rw [hX', Subgroup.map_comap_eq, inf_eq_right.mpr hXrange]
  have hX'cyc : IsCyclic X' := by
    haveI : IsCyclic X := hXcyc
    have e : X' ≃* X :=
      (Subgroup.equivMapOfInjective X' ρ hinj).trans (MulEquiv.subgroupCongr hX'map)
    exact e.isCyclic.mpr hXcyc
  have hX'card : Nat.card X' = Nat.card K + 1 := by
    rw [← hXcard, ← hX'map]
    exact (Subgroup.card_map_of_injective hinj).symm
  obtain ⟨A, hAx⟩ := hXrange hxX
  have hAX' : A ∈ X' := by
    rw [hX', Subgroup.mem_comap, hAx]
    exact hxX
  have hA : orderOf A = p := by
    have h := orderOf_injective ρ hinj A
    rw [hAx, hx] at h
    exact h.symm
  have hXD : X ≤ centralizer (rootSpan .E6 K a5LeviRoots : Set (ModGL .E6 K)) :=
    hXJ.trans (EPilot.highRootSL2_le_centralizer_perpLevi hτ)
  have hJx : rootSpan .E6 K a5LeviRoots ≤ centralizer ({x} : Set (ModGL .E6 K)) := by
    intro d hd
    rw [Subgroup.mem_centralizer_singleton_iff]
    have hxJ : x ∈ EPilot.highRootSL2 .E6 K := hXJ hxX
    exact (Subgroup.mem_centralizer_iff.1
      (EPilot.rootSpan_perpRoots_le_centralizer_highRootSL2 hτ hd) x hxJ).symm
  have hXx : X ≤ centralizer ({x} : Set (ModGL .E6 K)) := by
    intro y hy
    rw [Subgroup.mem_centralizer_singleton_iff]
    letI : IsCyclic X := hXcyc
    exact setLike_mul_comm hy hxX
  refine ⟨le_antisymm ?_ ?_, ?_, hXD⟩
  · rintro c ⟨hcC, hcx⟩
    have hcx' : c * ρ A = ρ A * c := by
      rw [hAx]
      exact Subgroup.mem_centralizer_singleton_iff.mp hcx
    obtain ⟨y, hy, d, hd, hcd⟩ :=
      exists_mem_mul_of_commute_nonsplit_E6_of_orderOf (K := K) (p := p) hp3 hpq hX'cyc
        hX'card hAX' hA hcC hcx'
    have hyX : ρ y ∈ X := by
      rw [← hX'map]
      exact Subgroup.mem_map_of_mem ρ hy
    rw [hcd]
    exact mul_mem (Subgroup.mem_sup_left hyX) (Subgroup.mem_sup_right hd)
  · refine sup_le (le_inf ?_ hXx) (le_inf ?_ hJx)
    · exact hXJ.trans EPilot.highRootSL2_le_adjointGroup
    · exact EPilot.rootSpan_le_adjointGroup' _
  · rw [Subgroup.disjoint_def]
    intro y hyX hyD
    exact (Subgroup.disjoint_def.1 (disjoint_highRootSL2_perpLevi hτ)) (hXJ hyX) hyD

end GLModel

section Adjoint

variable {K : Type} [Field K] [Finite K] [CharP K 2]

theorem centralizer_subgroupOf_nonsplit_E6_of_orderOf {p : ℕ} [Fact p.Prime] (hp3 : 3 ≤ p)
    (hpq : p ∣ Nat.card K + 1) {X : Subgroup (adjointGroup .E6 K)}
    (hXJ : X ≤ (EPilot.highRootSL2 .E6 K).subgroupOf (adjointGroup .E6 K))
    (hXcyc : IsCyclic X) (hXcard : Nat.card X = Nat.card K + 1)
    {x : adjointGroup .E6 K} (hxX : x ∈ X) (hx : orderOf x = p) :
    centralizer ({x} : Set (adjointGroup .E6 K)) = X ⊔ a5Levi K ∧
      Disjoint X (a5Levi K) ∧
      X ≤ centralizer (a5Levi K : Set (adjointGroup .E6 K)) := by
  classical
  set Xg : Subgroup (ModGL .E6 K) := X.map (Subgroup.subtype (adjointGroup .E6 K)) with hXg
  have hXgJ : Xg ≤ EPilot.highRootSL2 .E6 K := by
    intro y hy
    obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.1 hy
    exact Subgroup.mem_subgroupOf.1 (hXJ hz)
  have hXgcyc : IsCyclic Xg := by
    haveI : IsCyclic X := hXcyc
    have hsurj : Function.Surjective
        ((Subgroup.subtype (adjointGroup .E6 K)).subgroupMap X) :=
      MonoidHom.subgroupMap_surjective _ _
    exact isCyclic_of_surjective _ hsurj
  have hXgcard : Nat.card Xg = Nat.card K + 1 := by
    rw [hXg, Subgroup.card_map_of_injective (Subgroup.subtype_injective (adjointGroup .E6 K)),
      hXcard]
  have hxgXg : (x : ModGL .E6 K) ∈ Xg := Subgroup.mem_map_of_mem _ hxX
  have hxg : orderOf (x : ModGL .E6 K) = p := by
    rw [← hx]
    exact Subgroup.orderOf_coe x
  obtain ⟨hcent, hdisj, hCL⟩ :=
    centralizer_nonsplit_E6_of_orderOf (K := K) (p := p) hp3 hpq hXgJ hXgcyc hXgcard hxgXg
      hxg
  have hcentH : Subgroup.centralizer ({x} : Set (adjointGroup .E6 K)) =
      (adjointGroup .E6 K ⊓
          Subgroup.centralizer ({(x : ModGL .E6 K)} : Set (ModGL .E6 K))).subgroupOf
        (adjointGroup .E6 K) := by
    ext c
    rw [Subgroup.mem_subgroupOf, Subgroup.mem_inf, Subgroup.mem_centralizer_singleton_iff,
      Subgroup.mem_centralizer_singleton_iff]
    constructor
    · intro hc
      exact ⟨c.2, congrArg Subtype.val hc⟩
    · rintro ⟨-, hc⟩
      exact Subtype.ext hc
  rw [hcentH, hcent]
  have hXgH : Xg ≤ adjointGroup .E6 K := by
    rw [hXg]
    intro y hy
    obtain ⟨z, -, rfl⟩ := Subgroup.mem_map.1 hy
    exact z.2
  have hJH : rootSpan .E6 K a5LeviRoots ≤ adjointGroup .E6 K := EPilot.rootSpan_le_adjointGroup' _
  have hXsub : (X.map (Subgroup.subtype (adjointGroup .E6 K))).subgroupOf
      (adjointGroup .E6 K) = X := by
    ext z
    rw [Subgroup.mem_subgroupOf, Subgroup.mem_map]
    constructor
    · rintro ⟨y, hy, hyz⟩
      have hzy : y = z := Subtype.ext hyz
      rwa [hzy] at hy
    · intro hz
      exact ⟨z, hz, rfl⟩
  constructor
  · rw [Subgroup.subgroupOf_sup hXgH hJH, hXg, hXsub]
    rfl
  constructor
  · rw [Subgroup.disjoint_def]
    intro z hzX hzJ
    apply Subtype.ext
    apply (Subgroup.disjoint_def.1 hdisj)
    · rw [hXg]
      exact Subgroup.mem_map_of_mem _ hzX
    · exact mem_a5Levi_iff.1 hzJ
  · intro z hz
    rw [Subgroup.mem_centralizer_iff]
    intro d hd
    apply Subtype.ext
    exact Subgroup.mem_centralizer_iff.1
      (hCL (Subgroup.mem_map_of_mem (Subgroup.subtype (adjointGroup .E6 K)) hz))
      (d : ModGL .E6 K) (mem_a5Levi_iff.1 hd)

theorem a5Levi_subgroupOf_centralizer_normal {p : ℕ} [Fact p.Prime] (hp3 : 3 ≤ p)
    (hpq : p ∣ Nat.card K + 1) {X : Subgroup (adjointGroup .E6 K)}
    (hXJ : X ≤ (EPilot.highRootSL2 .E6 K).subgroupOf (adjointGroup .E6 K))
    (hXcyc : IsCyclic X) (hXcard : Nat.card X = Nat.card K + 1)
    {x : adjointGroup .E6 K} (hxX : x ∈ X) (hx : orderOf x = p) :
    ((a5Levi K).subgroupOf (Subgroup.centralizer ({x} : Set (adjointGroup .E6 K)))).Normal := by
  obtain ⟨hcent, hdisj, hXJ'⟩ :=
    centralizer_subgroupOf_nonsplit_E6_of_orderOf (K := K) (p := p) hp3 hpq hXJ hXcyc hXcard
      hxX hx
  have hJC : a5Levi K ≤ Subgroup.centralizer ({x} : Set (adjointGroup .E6 K)) := by
    rw [hcent]
    exact le_sup_right
  rw [Subgroup.normal_subgroupOf_iff_le_normalizer hJC]
  rw [hcent]
  refine sup_le (hXJ'.trans (Subgroup.centralizer_le_normalizer _)) ?_
  exact Subgroup.le_normalizer

theorem dvd_card_a5Levi {p : ℕ} (hp : p.Prime) (hp3 : 3 ≤ p) (hpq : p ∣ Nat.card K + 1) :
    p ∣ Nat.card (a5Levi K) := by
  classical
  have hqpos : 0 < Nat.card K := Nat.card_pos
  have hpnd : ¬ p ∣ Nat.card K - 1 := by
    intro h
    have h2 : p ∣ 2 := by
      have := Nat.dvd_sub hpq h
      rwa [show Nat.card K + 1 - (Nat.card K - 1) = 2 by omega] at this
    have hle : p ≤ 2 := Nat.le_of_dvd (by norm_num) h2
    omega
  have hndvd : ¬ p ∣ Nat.card (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.scalars 6 K) := by
    intro h
    exact hpnd (h.trans (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.card_scalars_dvd
      (K := K) (n := 6) (by norm_num)))
  have hq2 : p ∣ Nat.card K ^ 2 - 1 := by
    have h : p ∣ (Nat.card K - 1) * (Nat.card K + 1) := dvd_mul_of_dvd_right hpq _
    rwa [show (Nat.card K - 1) * (Nat.card K + 1) = Nat.card K ^ 2 - 1 by
      rw [mul_comm]
      exact (Nat.sq_sub_sq (Nat.card K) 1).symm] at h
  have hmem : 2 ∈ Finset.Icc 2 6 := by norm_num
  have hprod : Nat.card K ^ 2 - 1 ∣
      ∏ j ∈ Finset.Icc 2 6, (Nat.card K ^ j - 1) :=
    Finset.dvd_prod_of_mem (fun j => Nat.card K ^ j - 1) hmem
  have hdvdSL : p ∣ Nat.card (Matrix.SpecialLinearGroup (Fin 6) K) := by
    rw [CFSG.LocalAnalysis.ComponentInitial.LinearFlag.card_SL_eq (K := K) (n := 6) (by norm_num)]
    exact Dvd.dvd.mul_left (hq2.trans hprod) _
  have hmul : Nat.card (Matrix.SpecialLinearGroup (Fin 6) K) =
      Nat.card (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL 6 K) *
        Nat.card (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.scalars 6 K) :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup
      (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.scalars 6 K)
  have hPSL : p ∣ Nat.card (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL 6 K) := by
    have h : p ∣ Nat.card (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL 6 K) *
        Nat.card (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.scalars 6 K) := by
      rw [← hmul]
      exact hdvdSL
    exact (hp.dvd_mul.mp h).resolve_right hndvd
  rw [← Nat.card_congr (a5LeviProjEquiv K).toEquiv]
  exact hPSL

end Adjoint

