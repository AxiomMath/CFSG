private theorem exists_exponent_of_catalogIs_E6 {S : Type} [Group S]
    (h : catalogIs S (onLie fun i => ∃ q, I171.I171LieShape 3 i ∧ i = .E6 q)) :
    ∃ n, 1 ≤ n ∧ 3 ∣ 2 ^ n - 1 ∧ catalogIs S (isE6n n) := by
  obtain ⟨i, hi, ⟨e⟩⟩ := h
  cases i with
  | cyclic p hp => simp [onLie] at hi
  | alternating k hk => simp [onLie] at hi
  | sporadic s => simp [onLie] at hi
  | lie idx =>
    obtain ⟨d, hv⟩ := idx
    cases d with
    | E6 q =>
      simp only [onLie] at hi
      obtain ⟨q', hshape, heq⟩ := hi
      cases heq
      obtain ⟨-, hq2, h3⟩ := hshape
      refine ⟨q.exponent, q.exponent_pos, ?_, ⟨.lie ⟨.E6 q, hv⟩, ⟨hq2, rfl⟩, ⟨e⟩⟩⟩
      rwa [TauCeti.PrimePower.card_def, hq2] at h3
    | _ =>
      simp only [onLie] at hi
      obtain ⟨q', -, heq⟩ := hi
      cases heq

theorem e6Marking_holds :
    E6Marking := by
  intro G _ _ L J A d b hS hcat
  obtain ⟨n, hn1, h3dvd, hcatn⟩ := exists_exponent_of_catalogIs_E6 hcat
  obtain ⟨eP⟩ := pSimpleEquivCenterQuot_of_setup hS
  have hcatZ : catalogIs (↥L ⧸ Subgroup.center ↥L) (isE6n n) :=
    (CFSG.LocalAnalysis.GLTheoremA.catalogIs_congr eP).mpr hcatn
  have hLieZ : CFSG.Blueprint.LieModel (↥L ⧸ Subgroup.center ↥L) .E6 0 2 n :=
    lieModel_E6_of_catalogIs hcatZ
  obtain ⟨-, lab, hlab, hraw⟩ :=
    CFSG.StandardType.Canonical.largeEvenMarking_markedModel hS.idiag
  obtain ⟨R, _, _, _, -, -, θ, -, hM⟩ :=
    CFSG.StandardType.Canonical.largeEvenRawDatum_exists hraw
  have hLieR : CFSG.Blueprint.LieModel R .E6 0 2 n :=
    CFSG.Blueprint.LieModel.of_mulEquiv θ hLieZ
  have hc : markChar lab = 2 := by
    by_contra h2
    have hodd : CFSG.Blueprint.OddLieType R := by
      obtain ⟨tag, rank, m⟩ := lab
      cases tag <;> simp [markChar] at h2
      · have h : CFSG.Blueprint.LieModel R .PSL 2 3 2 := hM
        exact ⟨.PSL, 2, 3, 2, Nat.prime_three, by norm_num,
          CFSG.SeitzReduction.F4Pilot.statedLieAdmissible_of_lieModel h, h⟩
      · have h : CFSG.Blueprint.LieModel R .PSU 3 3 1 := hM
        exact ⟨.PSU, 3, 3, 1, Nat.prime_three, by norm_num,
          CFSG.SeitzReduction.F4Pilot.statedLieAdmissible_of_lieModel h, h⟩
    exact CFSG.SeitzReduction.CrossChar.not_oddLieType_of_lieModel_two_of_ne_Tits hLieR
      (by decide) (by simp) (by simp) (by simp) hodd
  obtain ⟨hlabE6, hlabn⟩ := NbrInnerMore.eq_of_markedModel_E6 hn1 hLieR hlab hc hM
  obtain ⟨tag, rank, exp⟩ := lab
  dsimp only at hlabE6 hlabn
  rw [hlabE6, hlabn] at hraw
  dsimp only [CFSG.Assembly.LargeEvenRawDatum, CFSG.Assembly.LargeEvenRecipeChevalley] at hraw
  obtain ⟨K, hKfield, hKfinite, hKcard, hQ⟩ := hraw
  obtain ⟨-, -, ⟨θ', hP', -⟩⟩ := hQ
  obtain ⟨-, hBI⟩ := hP'
  exact ⟨n, K, hKfield, hKfinite, hn1, h3dvd, hKcard, θ', hBI⟩

end CFSG.LocalAnalysis.GLTheoremA.T171Sh

