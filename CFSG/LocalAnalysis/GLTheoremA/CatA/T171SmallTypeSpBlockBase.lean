abbrev SpV (n : ℕ) := Fin n ⊕ Fin n → ZMod 2

noncomputable def linHom (n : ℕ) : StatedSp n (ZMod 2) →* (SpV n ≃ₗ[ZMod 2] SpV n) :=
  (LinearMap.GeneralLinearGroup.generalLinearEquiv (ZMod 2) (SpV n)).toMonoidHom.comp
    ((Matrix.GeneralLinearGroup.toLin (n := Fin n ⊕ Fin n) (R := ZMod 2)).toMonoidHom.comp
      (StatedSp n (ZMod 2)).subtype)

theorem linHom_apply (n : ℕ) (g : StatedSp n (ZMod 2)) (v : SpV n) :
    linHom n g v = ((g : GL (Fin n ⊕ Fin n) (ZMod 2)) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (ZMod 2)) *ᵥ v := by
  change (↑(Matrix.GeneralLinearGroup.toLin (g : GL (Fin n ⊕ Fin n) (ZMod 2))) :
    SpV n →ₗ[ZMod 2] SpV n) v =
    ((g : GL (Fin n ⊕ Fin n) (ZMod 2)) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (ZMod 2)) *ᵥ v
  rw [Matrix.GeneralLinearGroup.toLin_apply]
  rfl

theorem linHom_injective (n : ℕ) : Function.Injective (linHom n) := by
  intro g h hgh
  apply Subtype.ext
  apply Matrix.GeneralLinearGroup.toLin.injective
  have h2 := congrArg (LinearMap.GeneralLinearGroup.generalLinearEquiv (ZMod 2) (SpV n)).symm hgh
  simpa [linHom] using h2

variable {n : ℕ}

theorem invariantBilin_map (Bb : Subgroup (StatedSp n (ZMod 2))) :
    InvariantBilin (Bb.map (linHom n)) (CFSG.LargeExtraspecial.DW.spB n (ZMod 2)) := by
  rintro ⟨a, haA⟩ u v
  obtain ⟨b, hb, rfl⟩ := Subgroup.mem_map.mp haA
  rw [linHom_apply, linHom_apply]
  exact CFSG.LargeExtraspecial.DW.mem_statedSp_iff_spB.1 b.2 u v

theorem mem_linIsometryGroup_map (Bb : Subgroup (StatedSp n (ZMod 2))) :
    Bb.map (linHom n) ≤ linIsometryGroup (CFSG.LargeExtraspecial.DW.spB n (ZMod 2)) := by
  intro a ha
  rw [mem_linIsometryGroup]
  exact invariantBilin_map Bb ⟨a, ha⟩



theorem spB_eq_dot (n : ℕ) (v w : SpV n) :
    CFSG.LargeExtraspecial.DW.spB n (ZMod 2) v w =
      v ⬝ᵥ (CFSG.LargeExtraspecial.DW.spJ n (ZMod 2) *ᵥ w) := by
  rw [CFSG.LargeExtraspecial.DW.spB, Matrix.toBilin'_apply']

theorem heldFlag_invariant {n : ℕ} (Bb : Subgroup (StatedSp n (ZMod 2)))
    (T : Subgroup (StatedSp n (ZMod 2))) (hTne : T ≠ ⊥) (hT2 : IsPGroup 2 T)
    (hTnorm : Bb ≤ Subgroup.normalizer (T : Set (StatedSp n (ZMod 2)))) :
    ∃ W : Submodule (ZMod 2) (SpV n), W ≠ ⊥ ∧
      (∀ v ∈ W, ∀ w ∈ W, CFSG.LargeExtraspecial.DW.spB n (ZMod 2) v w = 0) ∧
      (∀ a ∈ Bb.map (linHom n), ∀ w ∈ W, a w ∈ W) := by
  obtain ⟨W, hWne, hWiso, hWinv⟩ := heldFlagSp T hTne hT2
  refine ⟨W, hWne, ?_, ?_⟩
  · intro v hv w hw
    rw [spB_eq_dot]
    exact hWiso v hv w hw
  · rintro a ⟨b, hb, rfl⟩ w hw
    rw [linHom_apply]
    exact hWinv b (hTnorm hb) w hw


abbrev SpNonzeroBlock {n : ℕ} (A : Subgroup (SpV n ≃ₗ[ZMod 2] SpV n))
    [Fintype A] : Type :=
  {D : Hyperplane A 3 // blockSpace A D.1 ≠ ⊥}

theorem sup_fixed_iSup_nonzeroBlock {n : ℕ} (A : Subgroup (SpV n ≃ₗ[ZMod 2] SpV n))
    [Fintype A] (hAe : IsElemAbelian 3 A) :
    fixedSpaceOf A ⊔ (⨆ D : SpNonzeroBlock A, blockSpace A D.1.1) = ⊤ := by
  have hp : Nat.Prime 3 := by norm_num
  have hpF : (3 : ZMod 2) ≠ 0 := by decide
  rw [← sup_fixedSpaceOf_iSup_blockSpace A hp hpF hAe]
  congr 1
  apply le_antisymm
  · exact iSup_le fun D => le_iSup (fun E : Hyperplane A 3 => blockSpace A E.1) (Subtype.val D)
  · apply iSup_le
    intro D
    by_cases hD : blockSpace A D.1 = ⊥
    · rw [hD]
      exact bot_le
    · exact le_iSup (fun D : SpNonzeroBlock A => blockSpace A D.1.1) ⟨D, hD⟩

theorem inf_fixed_iSup_nonzeroBlock {n : ℕ} (A : Subgroup (SpV n ≃ₗ[ZMod 2] SpV n))
    [Fintype A] (hAe : IsElemAbelian 3 A) :
    fixedSpaceOf A ⊓ (⨆ D : SpNonzeroBlock A, blockSpace A D.1.1) = ⊥ := by
  have hp : Nat.Prime 3 := by norm_num
  have hpF : (3 : ZMod 2) ≠ 0 := by decide
  refine le_antisymm ?_ bot_le
  intro v hv
  obtain ⟨hvc, hvD⟩ := Submodule.mem_inf.mp hv
  have hvall : v ∈ ⨆ D : Hyperplane A 3, blockSpace A D.1 :=
    (iSup_le fun D : SpNonzeroBlock A =>
      le_iSup (fun E : Hyperplane A 3 => blockSpace A E.1) (Subtype.val D)) hvD
  have hvcomm : v ∈ commutatorSpaceOf A := by
    rw [← iSup_blockSpace_eq_commutatorSpaceOf A hp hpF hAe]
    exact hvall
  exact (fixedSpaceOf_inf_commutatorSpaceOf A hp hpF hAe).le (Submodule.mem_inf.mpr ⟨hvc, hvcomm⟩)

theorem finrank_eq_fixed_add_nonzeroBlock {n : ℕ}
    (A : Subgroup (SpV n ≃ₗ[ZMod 2] SpV n)) [Fintype A]
    [Fintype (SpNonzeroBlock A)] (hAe : IsElemAbelian 3 A) :
    Module.finrank (ZMod 2) (SpV n) =
      Module.finrank (ZMod 2) (fixedSpaceOf A) +
        ∑ D : SpNonzeroBlock A,
          Module.finrank (ZMod 2) (blockSpace A D.1.1) := by
  classical
  have hp : Nat.Prime 3 := by norm_num
  have hpF : (3 : ZMod 2) ≠ 0 := by decide
  let C := fixedSpaceOf A
  let U := ⨆ D : SpNonzeroBlock A, blockSpace A D.1.1
  have hsup : C ⊔ U = ⊤ := sup_fixed_iSup_nonzeroBlock A hAe
  have hinf : C ⊓ U = ⊥ := inf_fixed_iSup_nonzeroBlock A hAe
  have hcompl : IsCompl C U :=
    ⟨disjoint_iff_inf_le.mpr (le_of_eq hinf), codisjoint_iff_le_sup.mpr (le_of_eq hsup.symm)⟩
  have hdim1 : Module.finrank (ZMod 2) (SpV n) =
      Module.finrank (ZMod 2) C + Module.finrank (ZMod 2) U := by
    have h := Submodule.finrank_sup_add_finrank_inf_eq C U
    rw [hcompl.sup_eq_top, hcompl.inf_eq_bot, finrank_top, finrank_bot] at h
    omega
  have hind : iSupIndep (fun D : SpNonzeroBlock A => blockSpace A D.1.1) :=
    (iSupIndep_blockSpace A hp hpF hAe).comp Subtype.val_injective
  have hdim2 : Module.finrank (ZMod 2) U =
      ∑ D : SpNonzeroBlock A, Module.finrank (ZMod 2) (blockSpace A D.1.1) := by
    have h := CFSG.CGT.PushingUpLit.CGT6.WeilJoint.finrank_biSup_eq_sum
      (fun D : SpNonzeroBlock A => blockSpace A D.1.1) hind Finset.univ
    have hU : (⨆ i ∈ (Finset.univ : Finset (SpNonzeroBlock A)),
        blockSpace A i.1.1) = U := by
      simp [U]
    rw [hU] at h
    exact h
  rw [hdim1, hdim2]



open CFSG.LieType.SeitzGeneration.HyperBlocks (sumOp)

theorem sum_projBlock_eq_self {n : ℕ} (A : Subgroup (SpV n ≃ₗ[ZMod 2] SpV n))
    [Fintype A] [Fintype (SpNonzeroBlock A)] (hAe : IsElemAbelian 3 A)
    (hC : fixedSpaceOf A = ⊥) (v : SpV n) :
    ∑ D : SpNonzeroBlock A, projBlock A (by norm_num : Nat.Prime 3)
      (by decide : (3 : ZMod 2) ≠ 0) hAe D.1 v = v := by
  classical
  let hp : Nat.Prime 3 := by norm_num
  let hpF : (3 : ZMod 2) ≠ 0 := by decide
  let P : SpNonzeroBlock A → Module.End (ZMod 2) (SpV n) :=
    fun D => projBlock A hp hpF hAe D.1
  let L : Module.End (ZMod 2) (SpV n) := 1 - ∑ D, P D
  have hLker : LinearMap.ker L = ⊤ := by
    apply top_unique
    have hsup : fixedSpaceOf A ⊔ (⨆ D : SpNonzeroBlock A, blockSpace A D.1.1) = ⊤ :=
      sup_fixed_iSup_nonzeroBlock A hAe
    rw [← hsup]
    apply sup_le
    · intro c hc
      rw [LinearMap.mem_ker]
      have hc0 : c = 0 := by
        rw [hC] at hc
        simpa using hc
      subst hc0
      simp [L]
    · apply iSup_le
      intro D
      intro w hw
      rw [LinearMap.mem_ker]
      have hsum : ∑ E : SpNonzeroBlock A, P E w = P D w := by
        refine Finset.sum_eq_single D ?_ ?_
        · intro E _ hED
          exact projBlock_apply_of_mem_block A hp hpF hAe (D := E.1) (E := D.1)
            (fun h => hED (Subtype.ext h.symm)) hw
        · intro h
          exact absurd (Finset.mem_univ D) h
      simp only [L, P, LinearMap.sub_apply, Module.End.one_apply, LinearMap.sum_apply,
        hsum, projBlock_apply_of_mem A hp hpF hAe D.1 hw, sub_self]
  have hLzero : L = 0 := by
    rw [← LinearMap.ker_eq_top]
    exact hLker
  have h := congrArg (fun f : Module.End (ZMod 2) (SpV n) => f v) hLzero
  simp only [L, LinearMap.sub_apply, Module.End.one_apply, LinearMap.zero_apply] at h
  simpa [P] using (sub_eq_zero.mp h).symm

theorem not_all_planes_of_invariant_isotropic {n : ℕ}
    (A : Subgroup (SpV n ≃ₗ[ZMod 2] SpV n)) [Fintype A]
    [Fintype (SpNonzeroBlock A)] (hAe : IsElemAbelian 3 A)
    (hAinv : InvariantBilin A (CFSG.LargeExtraspecial.DW.spB n (ZMod 2)))
    (hAlt : (CFSG.LargeExtraspecial.DW.spB n (ZMod 2)).IsAlt)
    (hBn : (CFSG.LargeExtraspecial.DW.spB n (ZMod 2)).Nondegenerate)
    (W : Submodule (ZMod 2) (SpV n)) (hWne : W ≠ ⊥)
    (hWiso : ∀ v ∈ W, ∀ w ∈ W, CFSG.LargeExtraspecial.DW.spB n (ZMod 2) v w = 0)
    (hWinv : ∀ a ∈ A, ∀ w ∈ W, a w ∈ W)
    (hC : fixedSpaceOf A = ⊥)
    (hplane : ∀ D : SpNonzeroBlock A,
      Module.finrank (ZMod 2) (blockSpace A D.1.1) = 2) : False := by
  classical
  let hp : Nat.Prime 3 := by norm_num
  let hpF : (3 : ZMod 2) ≠ 0 := by decide
  let P : SpNonzeroBlock A → Module.End (ZMod 2) (SpV n) :=
    fun D => projBlock A hp hpF hAe D.1
  obtain ⟨w, hwW, hw0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hWne
  have hwsum : w = ∑ D : SpNonzeroBlock A, P D w := by
    have h := sum_projBlock_eq_self A hAe hC w
    simpa [P] using h.symm
  have hPDW : ∀ D : SpNonzeroBlock A, P D w ∈ W := by
    intro D
    rw [projBlock_apply_eq]
    apply W.sub_mem
    · apply W.smul_mem
      rw [sumOp, LinearMap.sum_apply]
      exact W.sum_mem fun a _ => hWinv a.1 a.1.2 w hwW
    · apply W.smul_mem
      rw [sumOp, LinearMap.sum_apply]
      exact W.sum_mem fun a _ => hWinv a.1 a.1.2 w hwW
  have hex : ∃ D : SpNonzeroBlock A, P D w ≠ 0 := by
    by_contra h
    push Not at h
    apply hw0
    rw [hwsum]
    exact Finset.sum_eq_zero fun D _ => h D
  obtain ⟨D, hDw⟩ := hex
  have hWD : W ⊓ blockSpace A D.1.1 ≠ ⊥ := by
    intro hbot
    apply hDw
    have hmem : P D w ∈ W ⊓ blockSpace A D.1.1 :=
      Submodule.mem_inf.mpr ⟨hPDW D, projBlock_apply_mem A hp hpF hAe D.1 w⟩
    rw [hbot] at hmem
    simpa using hmem
  obtain ⟨x, hxWD, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hWD
  have hxW : x ∈ W := hxWD.1
  have hxD : x ∈ blockSpace A D.1.1 := hxWD.2
  let U : Submodule (ZMod 2) (SpV n) :=
    Submodule.span (ZMod 2) (Set.range fun a : A => (a : SpV n ≃ₗ[ZMod 2] SpV n) x)
  have hUleD : U ≤ blockSpace A D.1.1 := by
    apply Submodule.span_le.mpr
    rintro _ ⟨a, rfl⟩
    exact blockSpace_invariant A hp hpF hAe (a := a) hxD
  have hUleW : U ≤ W := by
    apply Submodule.span_le.mpr
    rintro _ ⟨a, rfl⟩
    exact hWinv a a.2 x hxW
  have hUne : U ≠ ⊥ := by
    intro h
    have hxU : x ∈ U := Submodule.subset_span ⟨1, by simp⟩
    rw [h] at hxU
    exact hx0 (by simpa using hxU)
  have hUinv : ∀ a ∈ A, ∀ u ∈ U, (a : SpV n ≃ₗ[ZMod 2] SpV n) u ∈ U := by
    intro a ha u hu
    have hmap : U.map (a : SpV n →ₗ[ZMod 2] SpV n) ≤ U := by
      change (Submodule.span (ZMod 2)
        (Set.range fun b : A => (b : SpV n ≃ₗ[ZMod 2] SpV n) x)).map
          (a : SpV n →ₗ[ZMod 2] SpV n) ≤ U
      rw [Submodule.map_span]
      apply Submodule.span_le.mpr
      rintro y ⟨z, hz, rfl⟩
      rcases hz with ⟨b, hb⟩
      rw [← hb]
      let aA : A := ⟨a, ha⟩
      change ((aA * b : A) : SpV n ≃ₗ[ZMod 2] SpV n) x ∈ U
      exact Submodule.subset_span (show ((aA * b : A) : SpV n ≃ₗ[ZMod 2] SpV n) x ∈
        Set.range (fun b : A => (b : SpV n ≃ₗ[ZMod 2] SpV n) x) from ⟨aA * b, rfl⟩)
    exact hmap (Submodule.mem_map.mpr ⟨u, hu, rfl⟩)
  have hdimD : Module.finrank (ZMod 2) (blockSpace A D.1.1) = 2 := hplane D
  have hUeq : U = blockSpace A D.1.1 := by
    by_contra hne
    have hlt : Module.finrank (ZMod 2) U < Module.finrank (ZMod 2) (blockSpace A D.1.1) :=
      Submodule.finrank_lt_finrank_of_lt (lt_of_le_of_ne hUleD hne)
    have hU1 : Module.finrank (ZMod 2) U = 1 := by
      have hpos : 0 < Module.finrank (ZMod 2) U := by
        rw [Nat.pos_iff_ne_zero, Ne, Submodule.finrank_eq_zero]
        exact hUne
      omega
    have hUC : U ≤ fixedSpaceOf A := by
      intro u hu
      rw [mem_fixedSpaceOf]
      intro a
      let aU : U →ₗ[ZMod 2] U :=
        { toFun := fun z => ⟨(a : SpV n ≃ₗ[ZMod 2] SpV n) z.1, hUinv a a.2 z.1 z.2⟩
          map_add' := fun z t => Subtype.ext
            (map_add (a : SpV n →ₗ[ZMod 2] SpV n) z.1 t.1)
          map_smul' := fun c z => Subtype.ext
            (map_smul (a : SpV n →ₗ[ZMod 2] SpV n) c z.1) }
      obtain ⟨c, hc, -⟩ := LinearMap.existsUnique_eq_smul_id_of_finrank_eq_one hU1 aU
      obtain ⟨u0, hu0U, hu00⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hUne
      have hc1 : c = 1 := by
        by_contra hcne
        have hc0 : c = 0 := by
          fin_cases c
          · rfl
          · exact absurd rfl hcne
        have hzero : (a : SpV n ≃ₗ[ZMod 2] SpV n) u0 = 0 := by
          have h := congrArg (fun f : U →ₗ[ZMod 2] U => f ⟨u0, hu0U⟩) hc
          have h' : aU ⟨u0, hu0U⟩ = 0 := by simpa [hc0] using h
          simpa [aU] using congrArg Subtype.val h'
        exact hu00 ((a : SpV n ≃ₗ[ZMod 2] SpV n).injective (by simpa using hzero))
      have haU : aU = 1 := by
        rw [hc, hc1, one_smul]
        rfl
      have h := congrArg (fun f : U →ₗ[ZMod 2] U => f ⟨u, hu⟩) haU
      simpa [aU] using congrArg Subtype.val h
    have hinf : blockSpace A D.1.1 ⊓ fixedSpaceOf A = ⊥ := by
      rw [eq_bot_iff]
      intro v hv
      exact (fixedSpaceOf_inf_commutatorSpaceOf A hp hpF hAe).le
        (Submodule.mem_inf.mpr ⟨hv.2, blockSpace_le_commutatorSpaceOf A D.1 hv.1⟩)
    have hUbot : U = ⊥ := by
      rw [eq_bot_iff]
      intro u hu
      have huinf : u ∈ blockSpace A D.1.1 ⊓ fixedSpaceOf A := ⟨hUleD hu, hUC hu⟩
      rw [hinf] at huinf
      simpa using huinf
    exact hUne hUbot
  have hVDW : blockSpace A D.1.1 ≤ W := by
    rw [← hUeq]
    exact hUleW
  have hnd := blockSpace_nondegenerate A hp hpF hAe hAlt hAinv hBn D
  have hDne : blockSpace A D.1.1 ≠ ⊥ := D.2
  obtain ⟨u, huD, hu0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hDne
  have huW : u ∈ W := hVDW huD
  have hexv : ∃ v ∈ blockSpace A D.1.1,
      CFSG.LargeExtraspecial.DW.spB n (ZMod 2) u v ≠ 0 := by
    by_contra h
    push Not at h
    have hz : (⟨u, huD⟩ : blockSpace A D.1.1) = 0 :=
      hnd.1 ⟨u, huD⟩ (fun y => by
        have := h y.1 y.2
        simpa using this)
    exact hu0 (congrArg Subtype.val hz)
  obtain ⟨v, hvD, huv⟩ := hexv
  exact huv (hWiso u huW v (hVDW hvD))


open CFSG.LocalAnalysis.GLTheoremA.S172A.GL (comSp fixSp isCompl_fixSp_comSp)
open CFSG.Walter (exists_ne_one_ne_of_three_le_card)

theorem exists_plane_block_of_smallModel {n : ℕ} (hn4 : 4 ≤ n) (hn5 : n ≤ 5)
    (Bb : Subgroup (StatedSp n (ZMod 2))) (h : SmallModel (StatedSp n (ZMod 2)) Bb)
    [Fintype (Bb.map (linHom n))] :
    ∃ (D : SpNonzeroBlock (Bb.map (linHom n))),
      Module.finrank (ZMod 2) (blockSpace (Bb.map (linHom n)) D.1.1) = 2 ∧
        Nat.card (SpNonzeroBlock (Bb.map (linHom n))) = n - 1 := by
  classical
  let A : Subgroup (SpV n ≃ₗ[ZMod 2] SpV n) := Bb.map (linHom n)
  haveI : Fintype A := ‹Fintype (Bb.map (linHom n))›
  have hAe : IsElemAbelian 3 A := h.elem.map (linHom n)
  have hAinv : InvariantBilin A (CFSG.LargeExtraspecial.DW.spB n (ZMod 2)) :=
    invariantBilin_map Bb
  have hAlt : (CFSG.LargeExtraspecial.DW.spB n (ZMod 2)).IsAlt :=
    fun x => CFSG.LargeExtraspecial.DW.spB_self x
  have hBn : (CFSG.LargeExtraspecial.DW.spB n (ZMod 2)).Nondegenerate :=
    CFSG.LocalAnalysis.GLTheoremA.CatB.spB_nondegenerate n
  haveI : Finite (SpV n) := inferInstance
  haveI : Finite (SpV n ≃ₗ[ZMod 2] SpV n) :=
    CFSG.LargeExtraspecial.O62.finite_linearEquiv
  haveI : Fintype A := Fintype.ofFinite A
  haveI : Fintype (SpNonzeroBlock A) := Fintype.ofFinite _
  let r : ℕ := Nat.card (SpNonzeroBlock A)
  let c : ℕ := Module.finrank (ZMod 2) (fixedSpaceOf A)
  let d : SpNonzeroBlock A → ℕ := fun D =>
    Module.finrank (ZMod 2) (blockSpace A D.1.1)
  have hp : Nat.Prime 3 := by norm_num
  have hpF : (3 : ZMod 2) ≠ 0 := by decide
  obtain ⟨T, hT2, hTne, hTnorm⟩ := h.twoLocal
  have hle : Nat.card Bb ≤ 3 ^ (n - 1) :=
    CFSG.LocalAnalysis.GLTheoremA.CatB.rankFine_statedSp_two n Bb T h.elem hT2 hTne hTnorm
  obtain ⟨E, hEelem, hEcard, hEtwo⟩ := exists_twoLocal_elementaryAbelian n (n - 1) (by omega)
  have hmax := h.max E hEelem hEtwo
  rw [hEcard] at hmax
  have hcardBb : Nat.card Bb = 3 ^ (n - 1) := le_antisymm hle hmax
  have hcardA : Nat.card A = 3 ^ (n - 1) := by
    change Nat.card (Bb.map (linHom n)) = 3 ^ (n - 1)
    rw [Subgroup.card_map_of_injective (linHom_injective n), hcardBb]
  have hdim : 2 * n = c + ∑ D : SpNonzeroBlock A, d D := by
    have h := finrank_eq_fixed_add_nonzeroBlock A hAe
    rw [CFSG.LocalAnalysis.GLTheoremA.CatB.finrank_sp] at h
    simpa [c, d] using h
  have hd_even : ∀ D : SpNonzeroBlock A, Even (d D) := by
    intro D
    have hnd := blockSpace_nondegenerate A hp hpF hAe hAlt hAinv hBn D
    have halt' : ((CFSG.LargeExtraspecial.DW.spB n (ZMod 2)).restrict
        (blockSpace A D.1.1)).IsAlt := fun x => hAlt x.1
    exact LinearMap.BilinForm.IsAlt.even_finrank halt' hnd
  have hd_ge : ∀ D : SpNonzeroBlock A, 2 ≤ d D := by
    intro D
    have hpos : 0 < d D := by
      rw [Nat.pos_iff_ne_zero, Ne, Submodule.finrank_eq_zero]
      exact D.2
    rcases hd_even D with ⟨k, hk⟩
    omega
  have hsum_ge : 2 * r ≤ ∑ D : SpNonzeroBlock A, d D := by
    change 2 * Nat.card (SpNonzeroBlock A) ≤ ∑ D : SpNonzeroBlock A, d D
    rw [Nat.card_eq_fintype_card, Nat.mul_comm]
    have h : (∑ _ : SpNonzeroBlock A, (2 : ℕ)) = Fintype.card (SpNonzeroBlock A) * 2 := by
      simp [Finset.sum_const, smul_eq_mul]
    rw [← h]
    exact Finset.sum_le_sum fun D _ => hd_ge D
  have hsum_even : Even (∑ D : SpNonzeroBlock A, d D) :=
    Finset.even_sum _ fun D _ => hd_even D
  have hc_even : Even c := by
    rcases hsum_even with ⟨k, hk⟩
    exact ⟨n - k, by omega⟩
  haveI : IsMulCommutative A := hAe.1
  letI : CommGroup A := IsMulCommutative.instCommGroup
  let f : A →* ((D : SpNonzeroBlock A) → A ⧸ D.1.1) :=
    { toFun := fun a D => QuotientGroup.mk' D.1.1 a
      map_one' := by ext D; rfl
      map_mul' := by intro a b; ext D; rfl }
  have hf_one : ∀ a : A, f a = 1 → a = 1 := by
    intro a ha
    have haD : ∀ D : SpNonzeroBlock A, a ∈ D.1.1 := by
      intro D
      have hD := congrFun ha D
      change QuotientGroup.mk' D.1.1 a = 1 at hD
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at hD
      exact hD
    have hCker : fixedSpaceOf A ≤ LinearMap.ker ((a : SpV n →ₗ[ZMod 2] SpV n) - 1) := by
      intro v hv
      rw [LinearMap.mem_ker]
      have hfix : (a : SpV n ≃ₗ[ZMod 2] SpV n) v = v := (mem_fixedSpaceOf A).mp hv a
      simp [hfix]
    have hDker : (⨆ D : SpNonzeroBlock A, blockSpace A D.1.1) ≤
        LinearMap.ker ((a : SpV n →ₗ[ZMod 2] SpV n) - 1) := by
      apply iSup_le
      intro D v hv
      rw [LinearMap.mem_ker]
      have hfix : (a : SpV n ≃ₗ[ZMod 2] SpV n) v = v :=
        (mem_blockSpace A).mp hv |>.1 a (haD D)
      simp [hfix]
    have htop : LinearMap.ker ((a : SpV n →ₗ[ZMod 2] SpV n) - 1) = ⊤ := by
      apply top_unique
      rw [← sup_fixed_iSup_nonzeroBlock A hAe]
      exact sup_le hCker hDker
    apply Subtype.ext
    apply LinearEquiv.ext
    intro v
    have hmem : v ∈ LinearMap.ker ((a : SpV n →ₗ[ZMod 2] SpV n) - 1) := by
      rw [htop]
      exact Submodule.mem_top
    simpa using sub_eq_zero.mp (LinearMap.mem_ker.mp hmem)
  have hf_inj : Function.Injective f := by
    intro a b hab
    have h1 : f (a⁻¹ * b) = 1 := by
      rw [map_mul, map_inv, hab, inv_mul_cancel]
    have h2 : a⁻¹ * b = 1 := hf_one _ h1
    exact inv_mul_eq_one.mp h2
  have hquot_card : ∀ D : SpNonzeroBlock A, Nat.card (A ⧸ D.1.1) = 3 := by
    intro D
    rw [← Subgroup.index_eq_card]
    exact D.1.2
  have hcard_le : Nat.card A ≤ 3 ^ r := by
    have h := Nat.card_le_card_of_injective f hf_inj
    rw [Nat.card_pi] at h
    simp_rw [hquot_card] at h
    rw [Finset.prod_const, Finset.card_univ, Nat.card_eq_fintype_card] at h
    simpa [r] using h
  have hr_ge : n - 1 ≤ r := by
    have hpow : 3 ^ (n - 1) ≤ 3 ^ r := by
      rw [← hcardA]
      exact hcard_le
    exact (Nat.pow_le_pow_iff_right (by norm_num : 1 < 3)).mp hpow
  have hr_le : r ≤ n := by
    have h1 : 2 * r ≤ 2 * n := by
      refine hsum_ge.trans ?_
      rw [hdim]
      exact Nat.le_add_left _ _
    omega
  have hc_le : c ≤ 2 := by
    have h1 : 2 * (n - 1) ≤ ∑ D : SpNonzeroBlock A, d D :=
      (Nat.mul_le_mul_left 2 hr_ge).trans hsum_ge
    have h2 : c + 2 * (n - 1) ≤ c + ∑ D : SpNonzeroBlock A, d D :=
      Nat.add_le_add_left h1 c
    rw [← hdim] at h2
    omega
  have hdata : ∃ D : SpNonzeroBlock A, d D = 2 ∧ r = n - 1 := by
    by_cases hc0 : c = 0
    · by_cases hrN : r = n
      ·
        have hsum_eq : ∑ D : SpNonzeroBlock A, d D = 2 * n := by
          rw [hc0] at hdim
          omega
        have hd2 : ∀ D : SpNonzeroBlock A, d D = 2 := by
          intro D
          by_contra hne
          have h4 : 4 ≤ d D := by
            have h2 := hd_ge D
            rcases hd_even D with ⟨k, hk⟩
            omega
          have hlt : ∑ E : SpNonzeroBlock A, d E > ∑ E : SpNonzeroBlock A, 2 := by
            refine Finset.sum_lt_sum (fun E _ => hd_ge E)
              ⟨D, Finset.mem_univ D, by omega⟩
          have hsum2 : (∑ E : SpNonzeroBlock A, (2 : ℕ)) = 2 * r := by
            rw [Finset.sum_const, smul_eq_mul]
            have hr : r = Fintype.card (SpNonzeroBlock A) := by
              simp [r, Nat.card_eq_fintype_card]
            rw [hr, Finset.card_univ]
            ring
          omega
        exfalso
        obtain ⟨W, hWne, hWiso, hWinv⟩ := heldFlag_invariant Bb T hTne hT2 hTnorm
        have hCbot : fixedSpaceOf A = ⊥ := by
          rw [← Submodule.finrank_eq_zero]
          simpa [c] using hc0
        exact not_all_planes_of_invariant_isotropic A hAe hAinv hAlt hBn W hWne
          hWiso (by simpa [A] using hWinv) hCbot (by simpa [d] using hd2)
      · have hrN1 : r = n - 1 := by omega
        have hex : ∃ D : SpNonzeroBlock A, d D = 2 := by
          by_contra hcon
          push Not at hcon
          have h4 : ∀ D : SpNonzeroBlock A, 4 ≤ d D := by
            intro D
            have h2 := hd_ge D
            rcases hd_even D with ⟨k, hk⟩
            have hne : d D ≠ 2 := hcon D
            omega
          have hsum_eq : ∑ D : SpNonzeroBlock A, d D = 2 * n := by
            rw [hc0] at hdim
            omega
          have hge : 4 * r ≤ ∑ D : SpNonzeroBlock A, d D := by
            change 4 * Nat.card (SpNonzeroBlock A) ≤ ∑ D : SpNonzeroBlock A, d D
            rw [Nat.mul_comm, Nat.card_eq_fintype_card]
            have h : (∑ _ : SpNonzeroBlock A, (4 : ℕ)) =
                Fintype.card (SpNonzeroBlock A) * 4 := by
              rw [Finset.sum_const, smul_eq_mul, Finset.card_univ]
            rw [← h]
            exact Finset.sum_le_sum fun D _ => h4 D
          omega
        obtain ⟨D, hD⟩ := hex
        exact ⟨D, hD, hrN1⟩
    · have hc2 : c = 2 := by
        rcases hc_even with ⟨k, hk⟩
        omega
      have hrN1 : r = n - 1 := by omega
      have hsum_eq : ∑ D : SpNonzeroBlock A, d D = 2 * r := by omega
      have hd2 : ∀ D : SpNonzeroBlock A, d D = 2 := by
        intro D
        by_contra hne
        have h4 : 4 ≤ d D := by
          have h2 := hd_ge D
          rcases hd_even D with ⟨k, hk⟩
          omega
        have hlt : ∑ E : SpNonzeroBlock A, d E > ∑ E : SpNonzeroBlock A, 2 := by
          refine Finset.sum_lt_sum (fun E _ => hd_ge E)
            ⟨D, Finset.mem_univ D, by omega⟩
        have hsum2 : (∑ E : SpNonzeroBlock A, (2 : ℕ)) = 2 * r := by
          rw [Finset.sum_const, smul_eq_mul]
          have hr : r = Fintype.card (SpNonzeroBlock A) := by
            simp [r, Nat.card_eq_fintype_card]
          rw [hr, Finset.card_univ]
          ring
        omega
      have hpos : 0 < r := by omega
      haveI : Nonempty (SpNonzeroBlock A) := by
        apply Fintype.card_pos_iff.mp
        rwa [← Nat.card_eq_fintype_card]
      exact ⟨Classical.choice inferInstance, hd2 (Classical.choice inferInstance), hrN1⟩
  obtain ⟨D, hD, hrN1⟩ := hdata
  exact ⟨D, hD, hrN1⟩


theorem exists_coordinate_element {n : ℕ}
    (A : Subgroup (SpV n ≃ₗ[ZMod 2] SpV n)) [Fintype A]
    [Fintype (SpNonzeroBlock A)] (hAe : IsElemAbelian 3 A)
    (hcardA : Nat.card A = 3 ^ (n - 1))
    (D0 : SpNonzeroBlock A) (hr : Nat.card (SpNonzeroBlock A) = n - 1) :
    ∃ y : A, y ∉ D0.1.1 ∧ (∀ D : SpNonzeroBlock A, D ≠ D0 → y ∈ D.1.1) ∧
      (y : SpV n ≃ₗ[ZMod 2] SpV n) ^ 3 = 1 := by
  classical
  haveI : IsMulCommutative A := hAe.1
  letI : CommGroup A := IsMulCommutative.instCommGroup
  let f : A →* ((D : SpNonzeroBlock A) → A ⧸ D.1.1) :=
    { toFun := fun a D => QuotientGroup.mk' D.1.1 a
      map_one' := by ext D; rfl
      map_mul' := by intro a b; ext D; rfl }
  have hf_one : ∀ a : A, f a = 1 → a = 1 := by
    intro a ha
    have haD : ∀ D : SpNonzeroBlock A, a ∈ D.1.1 := by
      intro D
      have hD := congrFun ha D
      change QuotientGroup.mk' D.1.1 a = 1 at hD
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at hD
      exact hD
    have hCker : fixedSpaceOf A ≤ LinearMap.ker ((a : SpV n →ₗ[ZMod 2] SpV n) - 1) := by
      intro v hv
      rw [LinearMap.mem_ker]
      have hfix : (a : SpV n ≃ₗ[ZMod 2] SpV n) v = v := (mem_fixedSpaceOf A).mp hv a
      simp [hfix]
    have hDker : (⨆ D : SpNonzeroBlock A, blockSpace A D.1.1) ≤
        LinearMap.ker ((a : SpV n →ₗ[ZMod 2] SpV n) - 1) := by
      apply iSup_le
      intro D v hv
      rw [LinearMap.mem_ker]
      have hfix : (a : SpV n ≃ₗ[ZMod 2] SpV n) v = v :=
        (mem_blockSpace A).mp hv |>.1 a (haD D)
      simp [hfix]
    have htop : LinearMap.ker ((a : SpV n →ₗ[ZMod 2] SpV n) - 1) = ⊤ := by
      apply top_unique
      rw [← sup_fixed_iSup_nonzeroBlock A hAe]
      exact sup_le hCker hDker
    apply Subtype.ext
    apply LinearEquiv.ext
    intro v
    have hmem : v ∈ LinearMap.ker ((a : SpV n →ₗ[ZMod 2] SpV n) - 1) := by
      rw [htop]
      exact Submodule.mem_top
    simpa using sub_eq_zero.mp (LinearMap.mem_ker.mp hmem)
  have hf_inj : Function.Injective f := by
    intro a b hab
    have h1 : f (a⁻¹ * b) = 1 := by
      rw [map_mul, map_inv, hab, inv_mul_cancel]
    have h2 : a⁻¹ * b = 1 := hf_one _ h1
    exact inv_mul_eq_one.mp h2
  have hquot_card : ∀ D : SpNonzeroBlock A, Nat.card (A ⧸ D.1.1) = 3 := by
    intro D
    rw [← Subgroup.index_eq_card]
    exact D.1.2
  have hcardCod : Nat.card ((D : SpNonzeroBlock A) → A ⧸ D.1.1) = 3 ^ (n - 1) := by
    rw [Nat.card_pi]
    simp_rw [hquot_card]
    rw [Finset.prod_const, Finset.card_univ, ← Nat.card_eq_fintype_card, hr]
  have hbij : Function.Bijective f := by
    rw [Nat.bijective_iff_injective_and_card]
    exact ⟨hf_inj, by rw [hcardA, hcardCod]⟩
  have hqcard : 3 ≤ Nat.card (A ⧸ D0.1.1) := by
    rw [hquot_card D0]
  obtain ⟨q0, q1, hq01, hq11, hqneq⟩ := exists_ne_one_ne_of_three_le_card hqcard
  let cvec : (D : SpNonzeroBlock A) → A ⧸ D.1.1 :=
    fun D => if h : D = D0 then h ▸ q0 else 1
  have hcvec0 : cvec D0 = q0 := by
    simp [cvec]
  have hcvecne : cvec D0 ≠ 1 := by
    rw [hcvec0]
    exact hq01
  obtain ⟨y, hy⟩ := hbij.2 cvec
  have hyD0 : y ∉ D0.1.1 := by
    intro hyD
    have h1 : f y D0 = 1 := by
      change QuotientGroup.mk' D0.1.1 y = 1
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact hyD
    rw [hy] at h1
    exact hcvecne h1
  have hyD : ∀ D : SpNonzeroBlock A, D ≠ D0 → y ∈ D.1.1 := by
    intro D hD
    have h1 : f y D = 1 := by
      rw [hy]
      simp [cvec, hD]
    change QuotientGroup.mk' D.1.1 y = 1 at h1
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h1
    exact h1
  exact ⟨y, hyD0, hyD, hAe.2 y y.2⟩

end

