private theorem ker_eq_center_of_center_eq_bot {X J : Type} [Group X] [Group J] (g : X →* J)
    (hg : Function.Surjective g) (hker : g.ker ≤ Subgroup.center X)
    (hZ : Subgroup.center J = ⊥) : g.ker = Subgroup.center X := by
  refine le_antisymm hker fun z hz => ?_
  have hgz : g z ∈ Subgroup.center J := Subgroup.mem_center_iff.2 fun y => by
    obtain ⟨w, rfl⟩ := hg y
    rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.1 hz w]
  rw [hZ, Subgroup.mem_bot] at hgz
  exact MonoidHom.mem_ker.2 hgz

private theorem ker_comp_le_center {X Y J : Type} [Group X] [Group Y] [Group J] (e : Y ≃* X)
    (g : X →* J) (hker : g.ker ≤ Subgroup.center X) :
    (g.comp e.toMonoidHom).ker ≤ Subgroup.center Y := fun z hz =>
  Subgroup.mem_center_iff.2 fun y => e.injective (by
    rw [map_mul, map_mul]
    exact Subgroup.mem_center_iff.1 (hker (show e z ∈ g.ker from hz)) (e y))

private theorem two_pow_ten_dvd_ordTwistedA_four {e : ℕ} (he : 1 ≤ e) :
    2 ^ 10 ∣ ordTwistedA 4 (2 ^ e) := by
  obtain ⟨t, -, ht⟩ := (CFSG.Timmesfeld.Orders.profile_ordTwistedA (n := 4) (by norm_num) he).two
  exact (Nat.pow_dvd_pow 2 (by omega : 10 ≤ e * (4 * (4 + 1) / 2))).trans ⟨t, ht⟩

theorem card_ne_ordTwistedA_four_of_sl {m k e : ℕ} {E : Type} [Field E] [Finite E] (hm : 2 ≤ m)
    (hk : 1 ≤ k) (hE : Nat.card E = 2 ^ k) (he : 1 ≤ e) {J : Type} [Group J]
    (g : Matrix.SpecialLinearGroup (Fin m) E →* J) (hg : Function.Surjective g)
    (hker : g.ker ≤ Subgroup.center _) (hZ : Subgroup.center J = ⊥) :
    Nat.card J ≠ ordTwistedA 4 (2 ^ e) := by
  intro hcard
  by_cases h21 : m = 2 ∧ k = 1
  · obtain ⟨rfl, rfl⟩ := h21
    haveI := Fintype.ofFinite E
    have hdvd := Subgroup.card_dvd_of_surjective hg
    rw [Matrix.card_SL_field, ← Nat.card_eq_fintype_card, hE, hcard] at hdvd
    have h6 := (two_pow_ten_dvd_ordTwistedA_four he).trans hdvd
    norm_num [Fin.prod_univ_two] at h6
  have h4 : m = 2 → 4 ≤ 2 ^ k := fun h2 => by
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hmod : StatedClassicalModel J .PSL m 2 k :=
    ⟨⟨Nat.prime_two, hk, hm, fun hc => by
      obtain ⟨h1, h2⟩ := Prod.mk.inj hc
      have := h4 h1
      omega, fun hc => by
      obtain ⟨h1, h2⟩ := Prod.mk.inj hc
      have := h4 h1
      omega⟩, E, inferInstance, inferInstance, hE,
      ⟨(QuotientGroup.quotientKerEquivOfSurjective g hg).symm.trans
        ((QuotientGroup.quotientMulEquivOfEq (ker_eq_center_of_center_eq_bot g hg hker hZ)).trans
          (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj m E))⟩⟩
  exact CFSG.Timmesfeld.Orders.ordA_ne_ordTwistedA (n := m - 1) (u := 4) (by omega) hk
    (by norm_num) he (((CFSG.Timmesfeld.card_statedClassicalModel_two hmod).1 rfl).symm.trans hcard)

theorem card_statedSU_ne_ordTwistedA_four {m k e : ℕ} {E : Type} [Field E] [Finite E]
    (hm : 3 ≤ m) (hk : 1 ≤ k) (hE : Nat.card E = (2 ^ k) ^ 2)
    (hZ : Subgroup.center ↥(StatedSU m (2 ^ k) E) = ⊥) (h5 : 5 ∣ 2 ^ e + 1) :
    Nat.card ↥(StatedSU m (2 ^ k) E) ≠ ordTwistedA 4 (2 ^ e) := by
  intro hcard
  have he : 1 ≤ e := by
    rcases Nat.eq_zero_or_pos e with rfl | he
    · norm_num at h5
    · exact he
  have hS : (StatedScalars (Fin m) E).subgroupOf (StatedSU m (2 ^ k) E) = ⊥ := by
    rw [eq_bot_iff, ← hZ]
    intro z hz
    rw [Subgroup.mem_subgroupOf, StatedScalars,
      ← Matrix.GeneralLinearGroup.center_eq_range_scalar] at hz
    exact Subgroup.mem_center_iff.2 fun y => Subtype.ext (Subgroup.mem_center_iff.1 hz y)
  have hSU : Nat.card ↥(StatedSU m (2 ^ k) E) = ordTwistedA (m - 1) (2 ^ k) := by
    rw [← Nat.card_congr ((QuotientGroup.quotientMulEquivOfEq hS).trans
        QuotientGroup.quotientBot).toEquiv,
      CFSG.Timmesfeld.ClassicalOrders.card_statedProj_statedSU Nat.prime_two hk hE (by omega),
      ordTwistedA, Nat.sub_add_cancel (by omega : 1 ≤ m), mul_comm (m - 1) m]
  obtain ⟨hm5, rfl⟩ := eq_four_of_ordTwistedA_eq (by omega) hk he (hSU.symm.trans hcard)
  obtain rfl : m = 5 := by omega
  exact center_statedSU_five_ne_bot hE h5 hZ

theorem card_ne_ordTwistedA_four_of_orthFactorRank {f e : ℕ} (hf : 1 ≤ f) (he : 1 ≤ e)
    {X : Type} [Group X] (hX : OrthFactorRank 2 (2 ^ f) X) {J : Type} [Group J] (g : X →* J)
    (hg : Function.Surjective g) (hker : g.ker ≤ Subgroup.center X)
    (hZ : Subgroup.center J = ⊥) : Nat.card J ≠ ordTwistedA 4 (2 ^ e) := by
  intro hcard
  let eJ : J ≃* X ⧸ Subgroup.center X :=
    (QuotientGroup.quotientKerEquivOfSurjective g hg).symm.trans
      (QuotientGroup.quotientMulEquivOfEq (ker_eq_center_of_center_eq_bot g hg hker hZ))
  have hXc : Nat.card (X ⧸ Subgroup.center X) = ordTwistedA 4 (2 ^ e) := by
    rw [← hcard]
    exact Nat.card_congr eJ.symm.toEquiv
  rcases hX with ⟨m, j, E, _, _, hm24, hj, -, hEc, -, ⟨eX⟩⟩ |
    ⟨j, q', E, _, _, hj, -, hq', hEc, ⟨eX⟩⟩ | ⟨K', _, _, hK', hK'r, s, hs2, hne, ⟨eX⟩⟩ |
    ⟨K', _, _, V, _, _, _, Q, hK', -, hQ, hd, hT, ⟨eX⟩⟩
  ·
    refine card_ne_ordTwistedA_four_of_sl (k := f * j) (by omega) (Nat.mul_pos hf hj) ?_ he
      (g.comp eX.symm.toMonoidHom) (hg.comp eX.symm.surjective)
      (ker_comp_le_center eX.symm g hker) hZ hcard
    rw [Nat.card_eq_fintype_card, hEc, pow_mul]
  ·
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    have hfj : 1 ≤ f * j := Nat.mul_pos hf hj
    obtain rfl : q' = 2 ^ (f * j) := by rw [hq', ← pow_mul]
    have hEn : Nat.card E = (2 ^ (f * j)) ^ 2 := by rw [Nat.card_eq_fintype_card, hEc]
    have hQ4 := CFSG.LieType.Universal.Unitary.isQuasisimple_statedSU_of_card (p := 2) hEn
      (by norm_num : 3 ≤ 4) (by simp)
    have hg₄ : Function.Surjective (g.comp eX.symm.toMonoidHom) := hg.comp eX.symm.surjective
    have hmod : StatedClassicalModel J .PSU 4 2 (f * j) :=
      ⟨⟨Nat.prime_two, hfj, by norm_num, by simp⟩, E, inferInstance, inferInstance, hEn,
        ⟨(QuotientGroup.quotientKerEquivOfSurjective _ hg₄).symm.trans
          (QuotientGroup.quotientMulEquivOfEq ((ker_eq_center_of_center_eq_bot _ hg₄
            (ker_comp_le_center eX.symm g hker) hZ).trans hQ4.2))⟩⟩
    have := (eq_four_of_ordTwistedA_eq (by norm_num) hfj he
      (((CFSG.Timmesfeld.card_statedClassicalModel_two hmod).2.1 rfl).symm.trans hcard)).1
    omega
  ·
    have hne' : ¬(s = 2 ∧ Nat.card K' = 2) := fun h => hne (by rw [h.1, h.2])
    obtain ⟨eSZ⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_sp hs2 hne'
      (ringChar.of_eq hK'r) eX
    have hmod : StatedClassicalModel (X ⧸ Subgroup.center X) .PSp s 2 f :=
      ⟨⟨Nat.prime_two, hf, hs2, by rwa [hK'] at hne⟩, K', inferInstance, inferInstance, hK',
        ⟨eSZ⟩⟩
    exact ordBC_ne_ordTwistedA_four (by omega) hf he
      (((CFSG.Timmesfeld.card_statedClassicalModel_two hmod).2.2.1 rfl).symm.trans hXc)
  ·
    obtain ⟨s, hs | hs⟩ := exists_statedClassicalModel_quotCenter_orthDerived hK' hQ hd hT eX
    · exact ordD_ne_ordTwistedA_four (by have := hs.1.2.2; omega) hf he
        (((CFSG.Timmesfeld.card_statedClassicalModel_two hs).2.2.2.1 rfl).symm.trans hXc)
    · exact ordTwistedD_ne_ordTwistedA_four (by have := hs.1.2.2; omega) hf he
        (((CFSG.Timmesfeld.card_statedClassicalModel_two hs).2.2.2.2 rfl).symm.trans hXc)

