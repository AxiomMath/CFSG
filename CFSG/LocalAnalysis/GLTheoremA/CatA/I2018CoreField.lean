private theorem hasLabel_of_u3eight {G : Type} [Group G] [Finite G] {X J : Subgroup G} (hJ : GLAPComponent 3 X J)
    (hq : CFSG.Open.IsQuasisimple ↥J) (hU : catalogIs (PSimple 3 J) S9.isU3eight) :
    Y10F.HasLabel ↥J (fun l => l = ⟨.twA, 2, 3⟩) := by
  obtain ⟨eJ⟩ := nonempty_center_quot_equiv_pSimple hJ hq
  obtain ⟨q, hv, hq8, ⟨e8⟩⟩ := CFSG.LocalAnalysis.GLTheoremA.CatB.lieIndex_isU3eight hU
  obtain ⟨hp2, he3⟩ := primePower_eq_of_card_eq Nat.prime_two (by norm_num : 0 < 3) (hq8.trans (by norm_num))
  have hm := CFSG.Models.lieModel_twistedA 2 q hv (eJ.trans e8)
  have hc : ValidLieTypeIndex.characteristic ⟨.twistedA 2 q, hv⟩ = q.p :=
    LieTypeIndex.characteristic_twistedA 2 q
  have hf : ValidLieTypeIndex.fieldExponent ⟨.twistedA 2 q, hv⟩ = q.exponent :=
    LieTypeIndex.fieldExponent_twistedA 2 q
  rw [hc, hf, hp2, he3] at hm
  have hb : CFSG.Blueprint.LieModel (↥J ⧸ Subgroup.center ↥J) .PSU (2 + 1) 2 3 :=
    CFSG.StandardType.ChevTwo.blueprintLieModel_of_modelsLieModel
      (by simp [CFSG.Blueprint.classicalTags]) hm
  obtain ⟨hperf, lab, hlab, hraw⟩ := CFSG.StandardType.Canonical.largeEvenMarking_of_lieModel_centerQuot hq.1 hb
  obtain ⟨R, _, I, F, -, -, -, ht, hr, hc, hf⟩ := CFSG.StandardType.Canonical.largeEvenRawDatum_exists hraw
  have hlab' : lab = ⟨.twA, 2, 3⟩ := eq_twA_two_three ht hr hc hf
  exact ⟨hperf, lab, hlab, CFSG.StandardType.Canonical.largeEvenRawDatum_mono
    (fun R _ I F ⟨hs, hna, θ, _⟩ => ⟨hs, hna, θ, hlab'⟩) hraw⟩

theorem field_bound {S : Type} [Group S] [Finite S] (hS : IsSimpleGroup S) (hna : ∃ a b : S, a * b ≠ b * a)
    (d : ValidLieTypeIndex) (hd : d.1.characteristic = 2) (e : S ≃* d.Group)
    {α : MulAut S} (hα3 : α ^ 3 = 1) (hα1 : α ≠ 1) {J : Subgroup S}
