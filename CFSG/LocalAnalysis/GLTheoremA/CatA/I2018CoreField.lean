@[expose] def specOf : LieTypeIndex → StatedLieTag × ℕ × ℕ
  | .A r q => (.PSL, r + 1, q.exponent)
  | .twistedA r q => (.PSU, r + 1, q.exponent)
  | .B r q => (.PSp, r, q.exponent)
  | .C r q => (.PSp, r, q.exponent)
  | .D r q => (.POmegaPlus, r, q.exponent)
  | .twistedD r q => (.POmegaMinus, r, q.exponent)
  | .E6 q => (.E6, 0, q.exponent)
  | .E7 q => (.E7, 0, q.exponent)
  | .E8 q => (.E8, 0, q.exponent)
  | .F4 q => (.F4, 0, q.exponent)
  | .G2 q => (.G2, 0, q.exponent)
  | .twistedE6 q => (.twistedE6, 0, q.exponent)
  | .trialityD4 q => (.trialityD4, 0, q.exponent)
  | .suzuki m => (.twistedB2, 0, 2 * m + 1)
  | .reeG2 m => (.twistedG2, 0, 2 * m + 1)
  | .reeF4 a => (.twistedF4, 0, 2 * a + 1)
  | .tits => (.Tits, 0, 1)

private theorem canonLabel_n_eq_markDeg {lab : CFSG.Assembly.LargeEvenLabel}
    (hΛ : CFSG.Assembly.LargeEvenInLambda2 lab) (h : markChar lab = 2) :
    (canonLabel lab).n = markDeg lab := by
  obtain ⟨t, r, n⟩ := lab
  obtain ⟨-, hΛ⟩ := hΛ
  cases t <;> simp only [markChar, markDeg, canonLabel] at hΛ h ⊢ <;> (try split_ifs) <;> simp_all

private theorem markDeg_eq_n_or {lab : CFSG.Assembly.LargeEvenLabel} (h : markChar lab = 2) :
    markDeg lab = lab.n ∨ (lab.tag = .twD ∧ lab.rank = 2) := by
  obtain ⟨t, r, n⟩ := lab
  cases t <;> simp only [markChar, markDeg] at h ⊢ <;> (try split_ifs) <;> simp_all

private theorem eq_twA_two_of_canonLabel {lab : CFSG.Assembly.LargeEvenLabel}
    (h : (canonLabel lab).tag = .twA ∧ (canonLabel lab).rank = 2) :
    lab.tag = .twA ∧ lab.rank = 2 := by
  obtain ⟨t, r, n⟩ := lab
  cases t <;> simp only [canonLabel] at h ⊢ <;> (try split_ifs at h) <;> simp_all

private theorem eq_twA_two_three {lab : CFSG.Assembly.LargeEvenLabel} (ht : markTag lab = .PSU)
    (hr : markRank lab = 3) (hc : markChar lab = 2) (hf : markDeg lab = 3) :
    lab = ⟨.twA, 2, 3⟩ := by
  obtain ⟨t, r, n⟩ := lab
  cases t <;> simp only [markTag, markRank, markChar, markDeg] at ht hr hc hf <;>
    (try split_ifs at ht hr hc hf) <;> simp_all

private theorem normal_eq_top_or_le_center {Q : Type*} [Group Q] (hQ : CFSG.Open.IsQuasisimple Q)
    {N : Subgroup Q} (hN : N.Normal) : N = ⊤ ∨ N ≤ Subgroup.center Q := by
  obtain ⟨hp, hs⟩ := hQ
  have := hN.map (QuotientGroup.mk' (Subgroup.center Q)) (QuotientGroup.mk'_surjective _)
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal
    (N.map (QuotientGroup.mk' (Subgroup.center Q))) with h | h
  · right
    rwa [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at h
  · left
    have hsup : N ⊔ Subgroup.center Q = ⊤ := by
      have := Subgroup.comap_map_eq (QuotientGroup.mk' (Subgroup.center Q)) N
      rw [h, Subgroup.comap_top, QuotientGroup.ker_mk'] at this
      exact this.symm
    have hZ : ⁅Subgroup.center Q, Subgroup.center Q⁆ = ⊥ :=
      Subgroup.commutator_eq_bot_iff_le_centralizer.mpr (Subgroup.center_le_centralizer _)
    have hmap : (⊤ : Subgroup Q).map (QuotientGroup.mk' N) =
        (Subgroup.center Q).map (QuotientGroup.mk' N) := by
      rw [← hsup, Subgroup.map_sup, QuotientGroup.map_mk'_self, bot_sup_eq]
    have hcomm : commutator Q ≤ N := by
      rw [_root_.commutator_def, ← QuotientGroup.ker_mk' N, ← Subgroup.map_eq_bot_iff,
        Subgroup.map_commutator, hmap, ← Subgroup.map_commutator, hZ, Subgroup.map_bot]
    rw [hp] at hcomm
    exact eq_top_iff.mpr hcomm

private theorem nonempty_center_quot_equiv_pSimple {G : Type} [Group G] [Finite G] {X J : Subgroup G}
    (hJ : GLAPComponent 3 X J) (hq : CFSG.Open.IsQuasisimple ↥J) :
    Nonempty (↥J ⧸ Subgroup.center ↥J ≃* PSimple 3 J) := by
  have hQ := isQuasisimple_pQuot_of_glaPComponent Nat.prime_three hJ
  have hcore : GLAPPrimeCore 3 ↥J ≤ Subgroup.center ↥J := by
    rcases normal_eq_top_or_le_center hq (inferInstance : (GLAPPrimeCore 3 ↥J).Normal) with h | h
    · exfalso
      haveI := hQ.2.toNontrivial
      have hsub : Subsingleton (PQuot 3 J) := ⟨fun a b => by
        induction a using QuotientGroup.induction_on with | H a => ?_
        induction b using QuotientGroup.induction_on with | H b => ?_
        exact QuotientGroup.eq.2 (h ▸ Subgroup.mem_top _)⟩
      obtain ⟨x, y, hxy⟩ := exists_pair_ne (PQuot 3 J ⧸ Subgroup.center (PQuot 3 J))
      obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective x
      obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective y
      exact hxy (congrArg _ (Subsingleton.elim x y))
    · exact h
  exact CFSG.HardMathSupport.Solomon.Coordinator.LieComp.nonempty_centralQuotient_mulEquiv hq.1
    (QuotientGroup.mk' (GLAPPrimeCore 3 ↥J)) (QuotientGroup.mk'_surjective _)
    (by rw [QuotientGroup.ker_mk']; exact hcore)

