private theorem fixFree_of_torusSigns {q f : ℕ} {K : Type} [Field K] [Finite K]
    (h : UnitaryFieldData q f K) {n : ℕ} (h2K : (2 : K) ≠ 0)
    (hn1 : h.norm (-1 : K) = 1)
    (W : Submodule K (Fin n → K))
    (hWnd : ((idForm h n).domRestrict₁₂ W W).SeparatingLeft)
    (hW2 : 2 ≤ Module.finrank K W)
    (G : Subgroup (primeFormUnitary h (idGram K n)))
    (hGpres : ∀ g ∈ G, ∀ v ∈ W,
      ((toLinU h n g : LinearMap.GeneralLinearGroup K (Fin n → K)) :
        Module.End K (Fin n → K)) v ∈ W)
    (hGtorus : ∀ {u v : Fin n → K} (huv : IsONPair h u v), u ∈ W → v ∈ W →
      torusUnitary h huv (-1 : Kˣ) hn1 ∈ G)
    (T : Subgroup G) (hT2 : IsPGroup 2 T) (hTodd : ¬ 2 ∣ T.index) :
    ∀ v ∈ W,
      (∀ t ∈ T,
        ((toLinU h n (t : primeFormUnitary h (idGram K n)) :
          LinearMap.GeneralLinearGroup K (Fin n → K)) :
          Module.End K (Fin n → K)) v = v) → v = 0 := by
  classical
  have hWsymm : ((idForm h n).domRestrict₁₂ W W).IsSymm := (idForm_isSymm h n).domRestrict W
  obtain ⟨b, hb⟩ := h.exists_orthonormal_basis (B := (idForm h n).domRestrict₁₂ W W)
    hWsymm hWnd
  have hb' : IsOrthonormalFamily h
      (fun i : Fin (Module.finrank K W) => (b i : Fin n → K)) := by
    intro i j
    simpa [LinearMap.domRestrict₁₂_apply] using hb i j
  let j0 : Fin (Module.finrank K W) := ⟨0, by omega⟩
  let pair : (j : Fin (Module.finrank K W)) → j ≠ j0 →
      IsONPair h (b j0 : Fin n → K) (b j : Fin n → K) :=
    fun j hj => hb'.pair (Ne.symm hj)
  let Ttorus : {j : Fin (Module.finrank K W) // j ≠ j0} →
      primeFormUnitary h (idGram K n) :=
    fun j => torusUnitary h (pair j.1 j.2) (-1 : Kˣ) hn1
  let uHom : primeFormUnitary h (idGram K n) →*
      ((Fin n → K) ≃ₗ[K] (Fin n → K)) :=
    (LinearMap.GeneralLinearGroup.generalLinearEquiv K (Fin n → K)).toMonoidHom.comp
      (toLinU h n)
  have huHom_inj : Function.Injective uHom :=
    (LinearMap.GeneralLinearGroup.generalLinearEquiv K (Fin n → K)).injective.comp
      (toLinU_injective (h := h) (n := n))
  let Tg : {j : Fin (Module.finrank K W) // j ≠ j0} → G :=
    fun j => ⟨Ttorus j, hGtorus (pair j.1 j.2) (b j0).2 (b j.1).2⟩
  have hVlam_nd_H : CFSG.LocalAnalysis.RankFourTheoremC.CrossExcU.HermNondeg
      (idForm h n) W := by
    intro w hw hzero
    exact Subtype.ext_iff.mp (hWnd ⟨w, hw⟩ (fun w' => hzero w' w'.2))
  have hcomplV : IsCompl W (CFSG.LocalAnalysis.RankFourTheoremC.CrossExcU.hermPerp
      (idForm h n) W) :=
    CFSG.LocalAnalysis.RankFourTheoremC.CrossExcU.hermNondeg_isCompl
      (B := idForm h n) (hB := idForm_isSymm h n) hVlam_nd_H
  have hT_apply (j : {j : Fin (Module.finrank K W) // j ≠ j0}) (v : Fin n → K) :
      (uHom (Ttorus j)) v = torusMat h (b j0) (b j.1) (-1) *ᵥ v := by
    have hmat : (((Ttorus j : primeFormUnitary h (idGram K n)) : GL (Fin n) K) :
        Matrix (Fin n) (Fin n) K) = torusMat h (b j0) (b j.1) (-1) :=
      coe_torusUnitary h (pair j.1 j.2) (-1) hn1
    change ((toLinU h n (Ttorus j) : LinearMap.GeneralLinearGroup K (Fin n → K)) :
      (Fin n → K) →ₗ[K] (Fin n → K)) v = torusMat h (b j0) (b j.1) (-1) *ᵥ v
    rw [toLinU_apply]
    ext i
    simp [Matrix.GeneralLinearGroup.coe_toLin, Matrix.mulVecLin, Matrix.toLin'_apply, hmat]
  have hT_b (j : {j : Fin (Module.finrank K W) // j ≠ j0})
      (l : Fin (Module.finrank K W)) :
      (uHom (Ttorus j)) (b l : Fin n → K) =
        (if l = j0 then (-1 : K) else if l = j.1 then (-1 : K) else 1) • (b l : Fin n → K) := by
    rw [hT_apply, torusMat_mulVec_orthonormal hb' (Ne.symm j.2) (-1)]
    simp
  have hT_fix_perp (j : {j : Fin (Module.finrank K W) // j ≠ j0})
      {v : Fin n → K}
      (hv : v ∈ CFSG.LocalAnalysis.RankFourTheoremC.CrossExcU.hermPerp (idForm h n) W) :
      (uHom (Ttorus j)) v = v := by
    rw [hT_apply, torusMat_mulVec]
    have h0 : idForm h n (b j0 : Fin n → K) v = 0 :=
      (CFSG.LocalAnalysis.RankFourTheoremC.CrossExcU.mem_hermPerp (B := idForm h n)).mp hv _
        (b j0).2
    have hj : idForm h n (b j.1 : Fin n → K) v = 0 :=
      (CFSG.LocalAnalysis.RankFourTheoremC.CrossExcU.mem_hermPerp (B := idForm h n)).mp hv _
        (b j.1).2
    simp [h0, hj]
  let eps (j : {j : Fin (Module.finrank K W) // j ≠ j0})
      (l : Fin (Module.finrank K W)) : K :=
    if l = j0 then (-1 : K) else if l = j.1 then (-1 : K) else 1
  have hT_apply_sum (j : {j : Fin (Module.finrank K W) // j ≠ j0})
      (c : Fin (Module.finrank K W) → K) :
      (uHom (Ttorus j)) (∑ l, c l • (b l : Fin n → K)) =
        ∑ l, (eps j l * c l) • (b l : Fin n → K) := by
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro l _
    rw [map_smul, hT_b, smul_smul]
    simp [eps]
  have hT_comm_lin (j k : {j : Fin (Module.finrank K W) // j ≠ j0}) :
      uHom (Ttorus j) * uHom (Ttorus k) = uHom (Ttorus k) * uHom (Ttorus j) := by
    apply LinearEquiv.ext
    intro v
    obtain ⟨v1, hv1, v2, hv2, hv⟩ := Submodule.mem_sup.mp
      (hcomplV.sup_eq_top ▸ (Submodule.mem_top : v ∈ (⊤ : Submodule K (Fin n → K))))
    set c : Fin (Module.finrank K W) → K := fun l => b.repr ⟨v1, hv1⟩ l with hc
    have hv1_exp : (v1 : Fin n → K) = ∑ l, c l • (b l : Fin n → K) := by
      have h := (congrArg (fun x : W => (x : Fin n → K))
        (b.sum_repr ⟨v1, hv1⟩)).symm
      simpa only [Submodule.coe_subtype, Submodule.coe_sum, Submodule.coe_smul] using h
    have hTk_v2 : (uHom (Ttorus k)) v2 = v2 := hT_fix_perp k hv2
    have hTj_v2 : (uHom (Ttorus j)) v2 = v2 := hT_fix_perp j hv2
    rw [← hv]
    calc (uHom (Ttorus j) * uHom (Ttorus k)) (v1 + v2)
        = uHom (Ttorus j) (uHom (Ttorus k) (v1 + v2)) := rfl
      _ = uHom (Ttorus j) (uHom (Ttorus k) v1 + v2) := by rw [map_add, hTk_v2]
      _ = uHom (Ttorus j) (uHom (Ttorus k) v1) + v2 := by rw [map_add, hTj_v2]
      _ = uHom (Ttorus j) (uHom (Ttorus k) (∑ l, c l • (b l : Fin n → K))) + v2 := by
            conv_lhs => rw [hv1_exp]
      _ = uHom (Ttorus j) (∑ l, (eps k l * c l) • (b l : Fin n → K)) + v2 := by
            rw [hT_apply_sum (j := k) (c := c)]
      _ = (∑ l, (eps j l * (eps k l * c l)) • (b l : Fin n → K)) + v2 := by
            rw [hT_apply_sum (j := j) (c := fun l => eps k l * c l)]
      _ = (∑ l, (eps k l * (eps j l * c l)) • (b l : Fin n → K)) + v2 := by
            congr 1
            apply Finset.sum_congr rfl
            intro l _
            ring
      _ = uHom (Ttorus k) (∑ l, (eps j l * c l) • (b l : Fin n → K)) + v2 := by
            conv_lhs => rw [← hT_apply_sum (j := k) (c := fun l => eps j l * c l)]
      _ = uHom (Ttorus k) (uHom (Ttorus j) (∑ l, c l • (b l : Fin n → K))) + v2 := by
            conv_lhs => rw [← hT_apply_sum (j := j) (c := c)]
      _ = uHom (Ttorus k) (uHom (Ttorus j) v1) + v2 := by
            conv_lhs => rw [← hv1_exp]
      _ = uHom (Ttorus k) (uHom (Ttorus j) v1 + v2) := by
            conv_rhs => rw [map_add]
            rw [hTk_v2]
      _ = uHom (Ttorus k) (uHom (Ttorus j) (v1 + v2)) := by
            conv_rhs => rw [map_add, hTj_v2]
      _ = (uHom (Ttorus k) * uHom (Ttorus j)) (v1 + v2) := rfl
  have hTg_sq (j : {j : Fin (Module.finrank K W) // j ≠ j0}) :
      Tg j * Tg j = 1 := by
    apply Subtype.ext
    change Ttorus j * Ttorus j = 1
    rw [← pow_two]
    exact CFSG.HardMathSupport.Timmesfeld.CrossChar.torusUnitary_pow
      (h := h) (hb := pair j.1 j.2) (c := (-1 : Kˣ)) (hc := hn1) (k := 2)
      (by norm_num)
  have hTg_comm (j k : {j : Fin (Module.finrank K W) // j ≠ j0}) :
      Commute (Tg j) (Tg k) := by
    apply Subtype.ext
    change Ttorus j * Ttorus k = Ttorus k * Ttorus j
    apply huHom_inj
    rw [map_mul, map_mul]
    exact hT_comm_lin j k
  let E : Subgroup G := Subgroup.closure (Set.range Tg)
  have hE2 : IsPGroup 2 E := by
    apply CFSG.GF2Type.Aschbacher1976Full.HS.TransFin.isPGroup_closure_of_comm
    · rintro _ ⟨j, rfl⟩
      exact hTg_sq j
    · rintro _ ⟨j, rfl⟩ _ ⟨k, rfl⟩
      exact (hTg_comm j k).eq
  have hGpres_inv : ∀ g ∈ G, ∀ v ∈ W, (uHom g)⁻¹ v ∈ W := by
    intro g hg v hv
    have hpres := hGpres (g⁻¹) (inv_mem hg) v hv
    have h' : (uHom g⁻¹) v ∈ W := by
      change ((toLinU h n (g⁻¹) : LinearMap.GeneralLinearGroup K (Fin n → K)) :
        Module.End K (Fin n → K)) v ∈ W
      exact hpres
    rwa [map_inv] at h'
  have hGmap : ∀ g ∈ G, W.map ((uHom g : (Fin n → K) ≃ₗ[K] (Fin n → K)) :
      (Fin n → K) →ₗ[K] (Fin n → K)) = W := by
    intro g hg
    refine le_antisymm ?_ ?_
    · rintro w ⟨v, hv, rfl⟩
      exact hGpres g hg v hv
    · intro w hw
      refine ⟨(uHom g)⁻¹ w, hGpres_inv g hg w hw, ?_⟩
      simp
  let restrictGB : G →* (W ≃ₗ[K] W) :=
  { toFun := fun g => (uHom g).ofSubmodules W W (hGmap g g.2)
    map_one' := by
      ext v
      simp [uHom]
    map_mul' := by
      intro g g'
      ext v
      simp [mul_smul] }
  have hR_b (j : {j : Fin (Module.finrank K W) // j ≠ j0})
      (l : Fin (Module.finrank K W)) :
      restrictGB (Tg j) (b l) = eps j l • b l := by
    apply Subtype.ext
    change (((uHom (Tg j)).ofSubmodules W W (hGmap (Tg j) (Tg j).2)) (b l) :
      Fin n → K) = eps j l • (b l : Fin n → K)
    rw [LinearEquiv.ofSubmodules_apply]
    change (uHom (Ttorus j)) (b l : Fin n → K) = eps j l • (b l : Fin n → K)
    rw [hT_b]
  have hcoord_zero (j : {j : Fin (Module.finrank K W) // j ≠ j0})
      {v : W} (hfix : restrictGB (Tg j) v = v) :
      b.repr v j0 = 0 ∧ b.repr v j.1 = 0 := by
    have hv_exp : v = ∑ l, b.repr v l • b l := (b.sum_repr v).symm
    have hS_diag : restrictGB (Tg j) v =
        ∑ l, (eps j l * b.repr v l) • b l := by
      conv_lhs => rw [hv_exp]
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro l _
      rw [map_smul, hR_b, smul_smul, mul_comm]
    have hsum : (∑ l, ((eps j l - 1) * b.repr v l) • b l) = 0 := by
      have h1 : (∑ l, ((eps j l - 1) * b.repr v l) • b l) =
          (∑ l, (eps j l * b.repr v l) • b l) -
            (∑ l, b.repr v l • b l) := by
        rw [← Finset.sum_sub_distrib]
        apply Finset.sum_congr rfl
        intro l _
        rw [sub_mul, one_mul]
        exact sub_smul (eps j l * b.repr v l) (b.repr v l) (b l)
      calc (∑ l, ((eps j l - 1) * b.repr v l) • b l)
          = (∑ l, (eps j l * b.repr v l) • b l) -
              (∑ l, b.repr v l • b l) := h1
        _ = restrictGB (Tg j) v - v := by
              rw [hS_diag]
              conv_rhs => arg 2; rw [hv_exp]
        _ = 0 := by rw [hfix, sub_self]
    have hcoeff := (Fintype.linearIndependent_iff.mp b.linearIndependent)
      (fun l => (eps j l - 1) * b.repr v l) hsum
    have hzero_of (l : Fin (Module.finrank K W)) (heps : eps j l = (-1 : K)) :
        b.repr v l = 0 := by
      have h := hcoeff l
      rw [heps] at h
      have h2 : (2 : K) * b.repr v l = 0 := by
        have : (-1 - 1 : K) * b.repr v l = -((2 : K) * b.repr v l) := by ring
        rw [this] at h
        exact neg_eq_zero.mp h
      exact (mul_eq_zero.mp h2).resolve_left h2K
    constructor
    · exact hzero_of j0 (by simp [eps])
    · exact hzero_of j.1 (by simp [eps])
  have hEfix : ∀ v : W, (∀ e ∈ E, restrictGB e v = v) → v = 0 := by
    intro v hv
    have hgen (j : {j : Fin (Module.finrank K W) // j ≠ j0}) :
        restrictGB (Tg j) v = v :=
      hv (Tg j) (Subgroup.subset_closure ⟨j, rfl⟩)
    let j1 : Fin (Module.finrank K W) := ⟨1, by omega⟩
    have hj1 : j1 ≠ j0 := by simp [j1, j0]
    have h0 : b.repr v j0 = 0 := (hcoord_zero ⟨j1, hj1⟩ (hgen ⟨j1, hj1⟩)).1
    have hsum : (∑ l, b.repr v l • b l) = 0 := by
      apply Finset.sum_eq_zero
      intro l _
      by_cases hl : l = j0
      · rw [hl, h0, zero_smul]
      · let jl : {j : Fin (Module.finrank K W) // j ≠ j0} := ⟨l, hl⟩
        have hc : b.repr v l = 0 := (hcoord_zero jl (hgen jl)).2
        rw [hc, zero_smul]
    rw [← b.sum_repr v, hsum]
  have hTfixfree : ∀ v : W, (∀ t ∈ T, restrictGB t v = v) → v = 0 := by
    intro v hv
    exact eq_zero_of_fixed_by_subgroup_of_not_dvd_index (ρ := restrictGB) (p := 2)
      Nat.prime_two hE2 hEfix hT2 hTodd hv
  intro v hvW hv
  have hfix : ∀ t ∈ T, restrictGB t ⟨v, hvW⟩ = ⟨v, hvW⟩ := by
    intro t ht
    apply Subtype.ext
    change (uHom (t : primeFormUnitary h (idGram K n))) v = v
    change ((toLinU h n (t : primeFormUnitary h (idGram K n)) :
      LinearMap.GeneralLinearGroup K (Fin n → K)) : Module.End K (Fin n → K)) v = v
    exact hv t ht
  exact congrArg Subtype.val (hTfixfree ⟨v, hvW⟩ hfix)

private lemma hSTlift_aux
    {q f : ℕ} {K : Type} [Field K] (h : UnitaryFieldData q f K) {n : ℕ}
    (G : Subgroup (primeFormUnitary h (idGram K n)))
    (F : Subgroup (gramSU h (idGram K n))) (e : G ≃* F)
    (he_toLin : ∀ g : G, toLinSU h n (e g) = toLinU h n g)
    (htSU : ∀ g : G, (g : GL (Fin n) K) ∈ gramSU h (idGram K n))
    (J : Subgroup (primeFormP h (idGram K n))) (φJ : G →* J)
    (T : Subgroup (primeFormP h (idGram K n))) (Tstar : Subgroup G)
    (hTstarmap : Tstar.map φJ ≤ T.subgroupOf J)
    (hφJ : ∀ t : G, t ∈ Tstar →
      (φJ t : primeFormP h (idGram K n)) =
        QuotientGroup.mk (e t : gramSU h (idGram K n)))
    (S : Subgroup (MulAut (primeFormP h (idGram K n))))
    (hST : ∀ s ∈ S, ∀ t ∈ T, s t = t) :
    ∀ s ∈ S, ∀ t ∈ Tstar,
      s * primeFormConjHom h (idGram K n) (t : primeFormUnitary h (idGram K n)) =
        primeFormConjHom h (idGram K n) (t : primeFormUnitary h (idGram K n)) * s := by
  intro s hs t ht
  let tSU : gramSU h (idGram K n) := ⟨(t : GL (Fin n) K), htSU t⟩
  have hsu_eq : (e t : gramSU h (idGram K n)) = tSU := by
    apply Subtype.ext
    apply Matrix.GeneralLinearGroup.toLin.injective
    exact he_toLin t
  let tP : primeFormP h (idGram K n) := tSU
  have hclass_eq : tP = (φJ t : primeFormP h (idGram K n)) := by
    change (QuotientGroup.mk tSU : primeFormP h (idGram K n)) =
      (φJ t : primeFormP h (idGram K n))
    rw [hφJ t ht, hsu_eq]
  have htT : tP ∈ T := by
    rw [hclass_eq]
    exact Subgroup.mem_subgroupOf.mp (hTstarmap (Subgroup.mem_map_of_mem φJ ht))
  have hx : s tP = tP := hST s hs tP htT
  have hconj : primeFormConjHom h (idGram K n) (t : primeFormUnitary h (idGram K n)) =
      MulAut.conj tP :=
    primeFormConjHom_eq_conj (C := idGram K n) (s := tSU)
  rw [hconj, hclass_eq]
  ext y
  rw [MulAut.mul_apply, MulAut.mul_apply, MulAut.conj_apply, MulAut.conj_apply]
  rw [← hclass_eq]
  rw [map_mul, map_mul, map_inv, hx]

theorem i2020UniInner : I2020UniInner := by
  intro p q hp hp2 hq hq2 hqp f K _ h hpdvd n hn3 hn4 A c hA
  intro J hJ _ T hT S hS2 hST hSβ hScomm s hs j hj
  classical
  haveI := h.finite
  haveI : Fintype K := Fintype.ofFinite K
  haveI : Fact q.Prime := ⟨hq⟩
  haveI : CharP K q := h.charP
  have hpq : p ≠ q := Ne.symm hqp
  have h2K : (2 : K) ≠ 0 := by
    intro h0
    have hdvd : q ∣ 2 := (CharP.cast_eq_zero_iff K q 2).mp h0
    exact hq2 ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).1 hdvd)
  have hq3 : 2 ≤ q ^ f := by
    have hq3' : 2 ≤ q := hq.two_le
    exact le_trans hq3' (Nat.le_self_pow (Nat.one_le_iff_ne_zero.mp h.one_le) q)
  have hq_gt3 : 3 < q ^ f := by
    have hq3' : 3 ≤ q := by
      have := hq.two_le
      omega
    have h3le : 3 ≤ q ^ f := le_trans hq3' (Nat.le_self_pow (Nat.one_le_iff_ne_zero.mp h.one_le) q)
    have hne3 : q ^ f ≠ 3 := by
      intro h3
      have h4 : p ∣ 4 := by simpa [h3] using hpdvd
      have h4' : p ∣ 2 ^ 2 := by
        rw [show (2 : ℕ) ^ 2 = 4 by norm_num]
        exact h4
      have h2dvd : p ∣ 2 := hp.dvd_of_dvd_pow h4'
      exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp h2dvd)
    omega
  have hperf : ⁅J, J⁆ = J := glaPComponent_perfect hJ
  have hle := perfectInLayer_primeFormConjHom h hp hpq A hA J hJ.1 hperf
  obtain ⟨hcomp, -⟩ := glaPComponent_isComponent_of_le_layer hJ hle
  have H := CFSG.HardMathSupport.Timmesfeld.CrossChar.primaryData_of_pow_eq_scalar
    (h := h) hp hpq hA
  set xlin : LinearMap.GeneralLinearGroup K (Fin n → K) := toLinU h n A with hxlin
  have hxlin_eq : xlin = Matrix.GeneralLinearGroup.toLin (A : GL (Fin n) K) := by
    rw [hxlin, toLinU_apply]
  obtain ⟨⟨a, hgood⟩, hLeq⟩ := exists_good_primaryFactor_of_component hq3 A hxlin_eq H J hcomp
  obtain ⟨lam, hlam⟩ := exists_linear_of_good_unitaryBlock hp hp2 hpdvd hA hn4 a.2 hgood
  set Vlam : Submodule K (Fin n → K) :=
    primaryComponent (xlin : Module.End K (Fin n → K)) (X - C lam) with hVlam
  have hnorm : h.bar lam * lam = 1 := by
    have hVlam_ne : Vlam ≠ ⊥ := by
      apply primaryComponent_ne_bot H.squarefree
      simpa [Vlam, hxlin, hlam] using a.2
    obtain ⟨v, hv_mem, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hVlam_ne
    have hv_eigen : (xlin : Module.End K (Fin n → K)) v = lam • v :=
      (mem_primaryComponent_X_sub_C).mp hv_mem
    exact unitary_eigenvalue_norm_one hp hp2 hpdvd hA (by omega : 1 ≤ n) hv0 hv_eigen
  set SB : Subgroup (LinearMap.GeneralLinearGroup K (Fin n → K)) :=
    specialBlock (idForm h n) xlin (X - C lam) with hSB
  set F : Subgroup ↥(gramSU h (idGram K n)) := SB.comap (toLinSU h n) with hF
  have hLeq' : J = F.map (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)) := by
    rw [hLeq, hlam, hF, hSB, hxlin]
  let π : ↥(gramSU h (idGram K n)) →* primeFormP h (idGram K n) :=
    QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)
  have hSBleSU : SB ≤ (toLinSU h n).range := by
    intro g hg
    have hg' : g ∈ sesqSpecialUnitaryGroup (idForm h n) :=
      specialBlock_le_sesqSpecialUnitaryGroup_of_good H hq3 a hgood (by
        simpa [SB, hlam] using hg)
    refine ⟨⟨Matrix.GeneralLinearGroup.toLin.symm g, ?_⟩, ?_⟩
    · rw [← toLin_mem_sesqSpecialUnitaryGroup_iff h (idGram K n), MulEquiv.apply_symm_apply]
      exact hg'
    · exact MulEquiv.apply_symm_apply (Matrix.GeneralLinearGroup.toLin (n := Fin n) (R := K)) g
  have hFmap : F.map (toLinSU h n) = SB := Subgroup.map_comap_eq_self hSBleSU
  let gB : Subgroup (primeFormUnitary h (idGram K n)) := SB.comap (toLinU h n)
  have hSBleU : SB ≤ (toLinU h n).range := by
    intro g hg
    have hg' : g ∈ sesqSpecialUnitaryGroup (idForm h n) :=
      specialBlock_le_sesqSpecialUnitaryGroup_of_good H hq3 a hgood (by
        simpa [SB, hlam] using hg)
    exact exists_toLinU (sesqSpecialUnitaryGroup_le (idForm h n) hg')
  have hGmap : gB.map (toLinU h n) = SB := Subgroup.map_comap_eq_self hSBleU
  have hSUinj : Function.Injective (toLinSU h n) := fun _ _ e =>
    Subtype.ext (Matrix.GeneralLinearGroup.toLin.injective e)
  let eF : F ≃* SB :=
    (Subgroup.equivMapOfInjective F (toLinSU h n) hSUinj).trans
      (MulEquiv.subgroupCongr hFmap)
  let eG : gB ≃* SB :=
    (Subgroup.equivMapOfInjective gB (toLinU h n) toLinU_injective).trans
      (MulEquiv.subgroupCongr hGmap)
  let e : gB ≃* F := eG.trans eF.symm
  let ψ : gB →* primeFormP h (idGram K n) := (π.comp F.subtype).comp e.toMonoidHom
  have hψ_le : ψ.range ≤ J := by
    rintro _ ⟨g, rfl⟩
    have hmem : π (e g : F) ∈ F.map π := Subgroup.mem_map_of_mem _ (e g).2
    rwa [← hLeq'] at hmem
  let φJ : gB →* J := ψ.codRestrict J (fun g => hψ_le ⟨g, rfl⟩)
  have hφJ_surj : Function.Surjective φJ := by
    intro j
    have hj : (j : primeFormP h (idGram K n)) ∈ F.map π := by
      rw [← hLeq']
      exact j.2
    obtain ⟨f, hf, hfj⟩ := Subgroup.mem_map.mp hj
    obtain ⟨g, hg⟩ := e.surjective (⟨f, hf⟩ : F)
    refine ⟨g, Subtype.ext ?_⟩
    change π (e g : F) = (j : primeFormP h (idGram K n))
    rw [hg]
    exact hfj
  have hTnotdvd : ¬ 2 ∣ (T.subgroupOf J).index := by
    obtain ⟨P, hP⟩ := CFSG.Goldschmidt.G310.exists_sylow_of_fusionIsSylowIn hT
    have hTJ : T.subgroupOf J = (P : Subgroup J) := by
      rw [← hP]
      change (Subgroup.map J.subtype (P : Subgroup J)).comap J.subtype = (P : Subgroup J)
      exact Subgroup.comap_map_eq_self_of_injective J.subtype_injective (P : Subgroup J)
    rw [hTJ]
    exact P.not_dvd_index
  obtain ⟨Tstar, hTstar2, hTstarnotdvd, hTstarmap⟩ :=
    exists_isPGroup_not_dvd_index_map_le φJ hφJ_surj Nat.prime_two hTnotdvd
  let uHom : primeFormUnitary h (idGram K n) →*
      ((Fin n → K) ≃ₗ[K] (Fin n → K)) :=
    (LinearMap.GeneralLinearGroup.generalLinearEquiv K (Fin n → K)).toMonoidHom.comp
      (toLinU h n)
  let uHomG : gB →* ((Fin n → K) ≃ₗ[K] (Fin n → K)) := uHom.comp gB.subtype
  have huHom_inj : Function.Injective uHom :=
    (LinearMap.GeneralLinearGroup.generalLinearEquiv K (Fin n → K)).injective.comp
      (toLinU_injective (h := h) (n := n))
  let TstarL : Subgroup ((Fin n → K) ≃ₗ[K] (Fin n → K)) := Tstar.map uHomG
  have hTstarL2 : IsPGroup 2 TstarL := hTstar2.map uHomG
  haveI : Fintype ((Fin n → K) ≃ₗ[K] (Fin n → K)) :=
    Fintype.ofInjective (fun f : (Fin n → K) ≃ₗ[K] (Fin n → K) =>
      (f : (Fin n → K) → (Fin n → K))) DFunLike.coe_injective
  haveI : Fintype TstarL := Fintype.ofFinite _
  have hTLcard : (Fintype.card TstarL : K) ≠ 0 := by
    obtain ⟨k, hk⟩ := hTstarL2.exists_card_eq
    rw [Nat.card_eq_fintype_card] at hk
    rw [hk]
    simpa [Nat.cast_pow] using pow_ne_zero k h2K
  have hfacts := specialBlockFacts_of_good H hq3 a hgood
  have hself : dualPoly h.bar (X - C lam) = X - C lam := by
    have hbar0 : h.bar lam ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at hnorm
      exact zero_ne_one hnorm
    rw [dualPoly_X_sub_C hbar0]
    congr 1
    have hbar : h.bar lam = lam⁻¹ :=
      eq_inv_of_mul_eq_one_left hnorm
    rw [hbar, inv_inv]
  have hGB_mem_SB : ∀ g : gB, toLinU h n g ∈ SB := fun g => Subgroup.mem_comap.mp g.2
  have hGB_comm : ∀ g : gB,
      Commute (((toLinU h n g : LinearMap.GeneralLinearGroup K (Fin n → K)) :
        Module.End K (Fin n → K))) (xlin : Module.End K (Fin n → K)) := by
    intro g
    have hgOrb : toLinU h n g ∈ orbitFactor (idForm h n) xlin (X - C lam) :=
      (mem_specialBlock.mp (hGB_mem_SB g)).1
    exact mem_gl_centralizer.mp (orbitFactor_le_gl_centralizer hgOrb)
  have hGB_triv : ∀ g : gB, ∀ b ∈ primaryFactors (xlin : Module.End K (Fin n → K)),
      b ≠ X - C lam → ∀ v ∈ primaryComponent (xlin : Module.End K (Fin n → K)) b,
        (uHomG g) v = v := by
    intro g b hb hbne v hv
    have hgOrb : toLinU h n g ∈ orbitFactor (idForm h n) xlin (X - C lam) :=
      (mem_specialBlock.mp (hGB_mem_SB g)).1
    have hmem : b ∉ ({X - C lam, dualPoly h.bar (X - C lam)} : Set K[X]) := by
      simp [hself, hbne]
    have h := hgOrb.2 b hb hmem v hv
    simpa [uHomG, uHom] using h
  have hGB_pres : ∀ g : gB, ∀ v ∈ Vlam, (uHomG g) v ∈ Vlam := by
    intro g v hv
    have hcomm : Commute (((uHomG g : (Fin n → K) ≃ₗ[K] (Fin n → K)) :
        Module.End K (Fin n → K))) (xlin : Module.End K (Fin n → K)) := by
      simpa [uHomG, uHom] using hGB_comm g
    have h := apply_mem_primaryComponent (x := (xlin : Module.End K (Fin n → K)))
      (r := ((uHomG g : (Fin n → K) ≃ₗ[K] (Fin n → K)) : Module.End K (Fin n → K)))
      hcomm hv
    simpa [Vlam, uHomG, uHom] using h
  have hVlam_nd : ((idForm h n).domRestrict₁₂ Vlam Vlam).SeparatingLeft := by
    simpa [Vlam, hlam] using
      (separatingLeft_primaryComponent_selfDual (H := H) (a := X - C lam)
        (by simpa [hlam] using a.2) hself)
  have hm2 : 2 ≤ Module.finrank K Vlam := by
    have h := hgood.1
    rw [show (a : K[X]) = X - C lam from hlam] at h
    rwa [primaryMultiplicity_X_sub_C] at h
  have hnorm_neg1 : h.norm (-1 : K) = 1 := by
    rw [UnitaryFieldData.norm]
    simp
  have hGpres : ∀ g ∈ gB, ∀ v ∈ Vlam,
      ((toLinU h n g : LinearMap.GeneralLinearGroup K (Fin n → K)) :
        Module.End K (Fin n → K)) v ∈ Vlam := by
    intro g hg v hv
    have h := hGB_pres ⟨g, hg⟩ v hv
    change (uHomG ⟨g, hg⟩) v ∈ Vlam
    exact h
  have hGtorus : ∀ {u v : Fin n → K} (huv : IsONPair h u v), u ∈ Vlam → v ∈ Vlam →
      torusUnitary h huv (-1 : Kˣ) hnorm_neg1 ∈ gB := by
    intro u v huv hu hv
    have hxu : ((toLinU h n A : LinearMap.GeneralLinearGroup K (Fin n → K)) :
        Module.End K (Fin n → K)) u = lam • u := by
      have h := (mem_primaryComponent_X_sub_C (x := (xlin : Module.End K (Fin n → K)))
        (μ := lam)).mp hu
      rwa [hxlin] at h
    have hxv : ((toLinU h n A : LinearMap.GeneralLinearGroup K (Fin n → K)) :
        Module.End K (Fin n → K)) v = lam • v := by
      have h := (mem_primaryComponent_X_sub_C (x := (xlin : Module.End K (Fin n → K)))
        (μ := lam)).mp hv
      rwa [hxlin] at h
    have hmem := CFSG.HardMathSupport.Timmesfeld.CrossChar.torusUnitary_mem_gBlock
      (h := h) A H hnorm (by simpa [hlam] using a.2) huv hxu hxv (-1 : Kˣ) hnorm_neg1
    have hmem' : toLinU h n (torusUnitary h huv (-1 : Kˣ) hnorm_neg1) ∈ SB :=
      CFSG.HardMathSupport.Timmesfeld.CrossChar.mem_gBlock.mp hmem
    simpa [gB, hSB, xlin, hxlin] using hmem'
  have hW_fix : Vlam ⊓ fixSub TstarL = ⊥ := by
    rw [eq_bot_iff]
    intro v hv
    rw [Submodule.mem_bot]
    refine fixFree_of_torusSigns h h2K hnorm_neg1 Vlam hVlam_nd hm2 gB hGpres hGtorus
      Tstar hTstar2 hTstarnotdvd v hv.1 (fun t ht => ?_)
    exact mem_fixSub.mp hv.2 (uHomG t) (Subgroup.mem_map_of_mem uHomG ht)
  have hTstarL_pres : ∀ t ∈ TstarL, ∀ v ∈ Vlam, t v ∈ Vlam := by
    intro t ht v hv
    have ht' : t ∈ Tstar.map uHomG := by simpa [TstarL] using ht
    obtain ⟨t0, ht0, rfl⟩ := Subgroup.mem_map.mp ht'
    exact hGB_pres t0 v hv
  have hU_le_W : movedSpan TstarL ≤ Vlam := by
    rw [movedSpan, Submodule.span_le]
    rintro w ⟨t, ht, u, rfl⟩
    have ht' : t ∈ Tstar.map uHomG := by simpa [TstarL] using ht
    obtain ⟨t0, ht0, rfl⟩ := Subgroup.mem_map.mp ht'
    have h_exp : (u : Fin n → K) =
        ∑ b ∈ primaryFactors (xlin : Module.End K (Fin n → K)),
          primaryProjection (xlin : Module.End K (Fin n → K)) b u := by
      have := LinearMap.congr_fun (sum_primaryProjection H.squarefree) u
      simpa using this.symm
    rw [h_exp]
    rw [map_sum, ← Finset.sum_sub_distrib]
    refine Submodule.sum_mem _ ?_
    intro b hb
    by_cases hba : b = X - C lam
    · subst hba
      refine Submodule.sub_mem _ ?_ ?_
      · exact hGB_pres t0 _ (by simpa [Vlam] using primaryProjection_mem H.squarefree hb u)
      · simpa [Vlam] using primaryProjection_mem H.squarefree hb u
    · have hfix := hGB_triv t0 b hb hba
        (primaryProjection (xlin : Module.End K (Fin n → K)) b u)
        (primaryProjection_mem H.squarefree hb u)
      rw [hfix, sub_self]
      exact Submodule.zero_mem _
  have hcomplU : IsCompl (movedSpan TstarL) (fixSub TstarL) :=
    isCompl_movedSpan_fixSub TstarL hTLcard
  have hcomplW : IsCompl Vlam (fixSub TstarL) := by
    refine ⟨disjoint_iff.mpr hW_fix, ?_⟩
    rw [codisjoint_iff]
    exact top_le_iff.mp (by
      rw [← hcomplU.sup_eq_top]
      exact sup_le_sup hU_le_W le_rfl)
  have hW_eq_U : Vlam = movedSpan TstarL := by
    have h := (movedSpan_eq_of_isCompl_fixSub TstarL hTLcard hcomplW
      hTstarL_pres (fun t ht w hw => mem_fixSub.mp hw t ht) hW_fix).1
    exact h.symm
  have hSle : S ≤ (primeFormConjHom h (idGram K n)).range := by
    have hlin : ⁅S, Subgroup.zpowers (primeFormConjHom h (idGram K n) A)⁆ ≤
        (primeFormConjHom h (idGram K n)).range := by
      rw [Subgroup.commutator_le]
      intro a ha x hx
      simpa [primeFormD] using commutator_mem_primeFormD hn3 hq_gt3 a x
    rwa [hScomm] at hlin
  have hker : (primeFormConjHom h (idGram K n)).ker ≤
      Subgroup.center (primeFormUnitary h (idGram K n)) := by
    intro B hB
    rw [MonoidHom.mem_ker, primeFormConjHom_eq_one_iff hn3 hq_gt3] at hB
    obtain ⟨c, hc, hBeq⟩ := mem_idScalarKernel.mp hB
    rw [Subgroup.mem_center_iff]
    intro C
    apply Subtype.ext
    change ((C : GL (Fin n) K) * (B : GL (Fin n) K) =
      (B : GL (Fin n) K) * (C : GL (Fin n) K))
    rw [hBeq]
    exact (Matrix.GeneralLinearGroup.scalar_commute c (C : GL (Fin n) K)).symm
  have htSU : ∀ t : gB, (t : GL (Fin n) K) ∈ gramSU h (idGram K n) := by
    intro t
    refine (mem_gramSU_iff_unitary h).mpr ⟨t.1.2, ?_⟩
    have hdet := hfacts.detK (toLinU h n (t : primeFormUnitary h (idGram K n)))
      (by simpa [SB, hlam] using hGB_mem_SB t)
    have hdet' : Matrix.det ((t : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) = 1 := by
      rw [toLinU_apply, Matrix.GeneralLinearGroup.coe_toLin] at hdet
      rwa [show Matrix.mulVecLin ((t : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) =
          Matrix.toLin' ((t : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) from rfl,
        LinearMap.det_toLin'] at hdet
    exact hdet'
  have he_toLin : ∀ g : gB, toLinSU h n (e g) = toLinU h n g := by
    intro g
    have h1 : eF (e g) = eG g := by
      rw [show e g = eF.symm (eG g) from rfl]
      exact eF.apply_symm_apply (eG g)
    exact congrArg Subtype.val h1
  have hφJ : ∀ t : gB, t ∈ Tstar →
      (φJ t : primeFormP h (idGram K n)) =
        QuotientGroup.mk (e t : gramSU h (idGram K n)) := fun t ht => rfl
  have hSTlift : ∀ s ∈ S, ∀ t ∈ Tstar,
      s * primeFormConjHom h (idGram K n) (t : primeFormUnitary h (idGram K n)) =
        primeFormConjHom h (idGram K n) (t : primeFormUnitary h (idGram K n)) * s :=
    hSTlift_aux h gB F e he_toLin htSU J φJ T Tstar hTstarmap hφJ S hST
  have hA_cent_Tstar : ∀ t ∈ Tstar, Commute A (t : primeFormUnitary h (idGram K n)) := by
    intro t ht
    apply toLinU_injective (h := h) (n := n)
    apply Units.ext
    simpa [map_mul, xlin, hxlin] using (hGB_comm t).symm.eq
  let TstarU : Subgroup (primeFormUnitary h (idGram K n)) := Tstar.map gB.subtype
  have hTstarU2 : IsPGroup 2 TstarU := hTstar2.map gB.subtype
  have hxT : ⁅Subgroup.zpowers A, TstarU⁆ ≤
      Subgroup.center (primeFormUnitary h (idGram K n)) := by
    rw [Subgroup.commutator_le]
    intro a ha t ht
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp ha
    obtain ⟨t0, ht0, rfl⟩ := Subgroup.mem_map.mp ht
    have hcomm : Commute (A ^ k) (t0 : primeFormUnitary h (idGram K n)) :=
      (hA_cent_Tstar t0 ht0).zpow_left k
    have h1 : ⁅A ^ k, gB.subtype t0⁆ = 1 := by
      change ⁅A ^ k, (t0 : primeFormUnitary h (idGram K n))⁆ = 1
      rw [commutatorElement_def, hcomm.eq]
      calc (t0 : primeFormUnitary h (idGram K n)) * A ^ k * (A ^ k)⁻¹ *
            (t0 : primeFormUnitary h (idGram K n))⁻¹
          = (t0 : primeFormUnitary h (idGram K n)) * (A ^ k * (A ^ k)⁻¹) *
              (t0 : primeFormUnitary h (idGram K n))⁻¹ := by
              exact congrArg
                (fun x => x * (t0 : primeFormUnitary h (idGram K n))⁻¹)
                (mul_assoc (t0 : primeFormUnitary h (idGram K n)) (A ^ k) (A ^ k)⁻¹)
        _ = 1 := by rw [mul_inv_cancel, mul_one, mul_inv_cancel]
    rw [h1]
    exact Subgroup.one_mem _
  let πc : primeFormUnitary h (idGram K n) →* MulAut (primeFormP h (idGram K n)) :=
    primeFormConjHom h (idGram K n)
  have hSTliftU : ∀ s ∈ S, ∀ t ∈ TstarU, s * πc t = πc t * s := by
    intro s hs t ht
    obtain ⟨t0, ht0, rfl⟩ := Subgroup.mem_map.mp ht
    exact hSTlift s hs t0 ht0
  let S₁ : Subgroup (primeFormUnitary h (idGram K n)) :=
    ⁅S.comap πc, Subgroup.zpowers A⁆
  have hS₁_cent : ∀ s ∈ S₁, ∀ t ∈ TstarU, Commute s t := by
    intro s₁ hs₁ t ht
    have hlift := commutator_commutator_comap_zpowers_eq_bot (π := πc) hker
      (S := S) (x := A) (T := TstarU) hxT hSTliftU
    have hmem : ⁅s₁, t⁆ ∈ (⊥ : Subgroup (primeFormUnitary h (idGram K n))) := by
      rw [← hlift]
      exact Subgroup.commutator_mem_commutator hs₁ ht
    exact commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp hmem)
  have hS₁map : S₁.map πc = S :=
    map_commutator_comap_zpowers_eq πc hSle hScomm
  let S₂ : Subgroup (primeFormUnitary h (idGram K n)) := ⁅S₁, Subgroup.zpowers A⁆
  have hS₂map : S₂.map πc = S :=
    map_commutator_commutator_comap_zpowers_eq πc hSle hScomm
  have hS₁ : ∀ s ∈ S₁, ∀ t ∈ TstarL, Commute (uHom s) t := by
    intro s hs t ht
    obtain ⟨t0, ht0, rfl⟩ := Subgroup.mem_map.mp (show t ∈ Tstar.map uHomG from ht)
    have hcent := hS₁_cent s hs (t0 : primeFormUnitary h (idGram K n))
      (Subgroup.mem_map_of_mem gB.subtype ht0)
    have hmap := hcent.map uHom
    change Commute (uHom s) (uHom (t0 : primeFormUnitary h (idGram K n)))
    exact hmap
  have hA : ∀ t ∈ TstarL, Commute (uHom A) t := by
    intro t ht
    obtain ⟨t0, ht0, rfl⟩ := Subgroup.mem_map.mp (show t ∈ Tstar.map uHomG from ht)
    have hmap := (hA_cent_Tstar t0 ht0).map uHom
    change Commute (uHom A) (uHom (t0 : primeFormUnitary h (idGram K n)))
    exact hmap
  have hAmoved : ∀ u ∈ movedSpan TstarL, uHom A u = lam • u := by
    intro u hu
    rw [← hW_eq_U] at hu
    have hscalar := (mem_primaryComponent_X_sub_C
      (x := (xlin : Module.End K (Fin n → K))) (μ := lam)).mp hu
    rw [hxlin] at hscalar
    change ((toLinU h n A : LinearMap.GeneralLinearGroup K (Fin n → K)) :
      Module.End K (Fin n → K)) u = lam • u
    exact hscalar
  have hBtriv : ∀ g ∈ gB.map uHom,
      ∀ b ∈ primaryFactors (xlin : Module.End K (Fin n → K)), b ≠ X - C lam →
        ∀ v ∈ primaryComponent (xlin : Module.End K (Fin n → K)) b,
          (g : (Fin n → K) ≃ₗ[K] (Fin n → K)) v = v := by
    rintro g ⟨g0, hg0, rfl⟩ b hb hbne v hv
    exact hGB_triv ⟨g0, hg0⟩ b hb hbne v hv
  have hTcomm : ∀ t ∈ TstarL,
      Commute ((t : (Fin n → K) ≃ₗ[K] (Fin n → K)) : Module.End K (Fin n → K))
        (primaryProjection (xlin : Module.End K (Fin n → K)) (X - C lam)) := by
    intro t ht
    obtain ⟨t0, ht0, rfl⟩ := Subgroup.mem_map.mp (show t ∈ Tstar.map uHomG from ht)
    have hcomm : Commute (((toLinU h n t0 : LinearMap.GeneralLinearGroup K (Fin n → K)) :
        Module.End K (Fin n → K))) (xlin : Module.End K (Fin n → K)) := hGB_comm t0
    have hcoe : ((uHomG t0 : (Fin n → K) ≃ₗ[K] (Fin n → K)) :
        Module.End K (Fin n → K)) =
        ((toLinU h n t0 : LinearMap.GeneralLinearGroup K (Fin n → K)) :
          Module.End K (Fin n → K)) := by
      ext v
      rfl
    rw [hcoe]
    exact commute_aeval_of_commute hcomm _
  have hBfix : ∀ b ∈ gB, ∀ w ∈ fixSub TstarL, (uHom b) w = w := by
    intro b hb w hw
    exact fixes_fixSub_of_trivial_off (x := (xlin : Module.End K (Fin n → K)))
      (a := X - C lam) (ha := by simpa [hlam] using a.2) (hx := H.squarefree)
      (B := gB.map uHom) (T := TstarL) hBtriv hTcomm hW_fix
      (uHom b) (Subgroup.mem_map_of_mem uHom hb) w hw
  have hBpres : ∀ b ∈ gB, ∀ w ∈ movedSpan TstarL, (uHom b) w ∈ movedSpan TstarL := by
    intro b hb w hw
    rw [← hW_eq_U] at hw ⊢
    have h := hGB_pres ⟨b, hb⟩ w hw
    change (uHomG ⟨b, hb⟩) w ∈ Vlam
    exact h
  have hS₂_comm : ∀ g ∈ S₂, ∀ b ∈ gB, Commute g b :=
    commute_of_mem_commutator_of_injective uHom huHom_inj TstarL hTLcard
      hS₁ hA hAmoved hBfix hBpres
  have hsS₂ : s ∈ S₂.map πc := by
    rw [hS₂map]
    exact hs
  obtain ⟨g, hg, hgconj⟩ := Subgroup.mem_map.mp hsS₂
  have hex : ∃ t : gB, φJ t = ⟨j, hj⟩ := hφJ_surj ⟨j, hj⟩
  obtain ⟨t, htj⟩ := hex
  have htj' : (φJ t : primeFormP h (idGram K n)) = j := congrArg Subtype.val htj
  have hcomm : Commute g (t : primeFormUnitary h (idGram K n)) :=
    hS₂_comm g hg (t : primeFormUnitary h (idGram K n)) t.2
  have hconj_e : (⟨(g : GL (Fin n) K) * (e t) * ((g : GL (Fin n) K))⁻¹,
      conj_mem_gramSU h (idGram K n) g.2 (e t : gramSU h (idGram K n)).2⟩ :
        gramSU h (idGram K n)) = e t := by
    apply hSUinj
    change Matrix.GeneralLinearGroup.toLin ((g : GL (Fin n) K) * (e t : GL (Fin n) K) *
      (g : GL (Fin n) K)⁻¹) = Matrix.GeneralLinearGroup.toLin (e t : GL (Fin n) K)
    rw [map_mul, map_mul, map_inv]
    have het : Matrix.GeneralLinearGroup.toLin (e t : GL (Fin n) K) =
        toLinU h n (t : primeFormUnitary h (idGram K n)) := he_toLin t
    have hgt : Matrix.GeneralLinearGroup.toLin (g : GL (Fin n) K) = toLinU h n g := rfl
    rw [het, hgt]
    have hc : toLinU h n g * toLinU h n (t : primeFormUnitary h (idGram K n)) =
        toLinU h n (t : primeFormUnitary h (idGram K n)) * toLinU h n g := by
      rw [← map_mul, ← map_mul]
      exact congrArg (toLinU h n) hcomm.eq
    rw [hc]
    group
  calc s j = πc g (φJ t) := by rw [← hgconj, ← htj']
  _ = φJ t := by
        change primeFormConjHom h (idGram K n) g (φJ t) = φJ t
        rw [show (φJ t : primeFormP h (idGram K n)) =
          ((e t : gramSU h (idGram K n)) : primeFormP h (idGram K n)) from rfl]
        rw [primeFormConjHom_mk h (idGram K n) g (e t)]
        exact congrArg (fun y : gramSU h (idGram K n) =>
          (y : primeFormP h (idGram K n))) hconj_e
  _ = j := htj'

