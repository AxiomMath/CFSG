theorem exists_langSetup_of_hatE6_conj_g0
    {K : Type} [Field K] [Finite K] {p : ℕ}
    (hp : p.Prime) (hpK : ¬ p ∣ Nat.card K) {p₀ : ℕ} (hp₀ : p₀.Prime) (hp₀K : ¬ p₀ ∣ Nat.card K)
    (hq₀ : 5 ≤ p₀ ∨ 4 ≤ Nat.card K) (hmon : MonomialToralAt Tag.E6 p) {h : ModGL Tag.E6 K}
    (hh : h ∈ TableBExc.E6Three.hatGroup Tag.E6 K) (hp1 : h ^ p = 1) (hh1 : h ≠ 1) :
    ∃ (S : LangSetup Tag.E6 (AlgebraicClosure K) p₀) (a : Fin Tag.E6.rank → (AlgebraicClosure K)ˣ)
      (ι : ↥(adjointGroup Tag.E6 K) →* ModGL Tag.E6 (AlgebraicClosure K)),
      S.D.q = Nat.card K ∧
      (∃ Fr : AlgebraicClosure K →+* AlgebraicClosure K, (∀ c, Fr c = c ^ Nat.card K) ∧
        S.D.Φ = Units.map (entrywiseHom Fr)) ∧
      rootDiagUnit Tag.E6 a ∈ S.D.torus ∧ (∀ i, a i ^ p = 1) ∧ rootDiagUnit Tag.E6 a ≠ 1 ∧
      Function.Injective ι ∧ ι.range = S.Γ ∧
      rootDiagUnit Tag.E6 a = S.D.g0⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) h * S.D.g0 ∧
      (∀ c : ↥(adjointGroup Tag.E6 K),
        ι c = S.D.g0⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) (c : ModGL Tag.E6 K) * S.D.g0) ∧
      ∀ h' ∈ TableBExc.E6Three.hatGroup Tag.E6 K,
        S.D.step (S.D.g0⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) h' * S.D.g0) =
            S.D.g0⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) h' * S.D.g0 ∧
          S.D.g0⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) h' * S.D.g0 ∈
            adjointGroup Tag.E6 (AlgebraicClosure K) := by
  haveI : Fintype K := Fintype.ofFinite K
  obtain ⟨f, hℓ, hf⟩ := FiniteField.card K (ringChar K)
  haveI : Fact (ringChar K).Prime := ⟨hℓ⟩
  haveI : CharP K (ringChar K) := ringChar.charP K
  set ℓ := ringChar K
  have hqK : Nat.card K = ℓ ^ (f : ℕ) := by rw [Nat.card_eq_fintype_card]; exact hf
  have hf1 : 1 ≤ (f : ℕ) := f.pos
  set L := AlgebraicClosure K
  haveI : CharP L ℓ := charP_of_injective_algebraMap (algebraMap K L).injective _
  set ι₁ : K →+* L := algebraMap K L
  have hFr : ∀ c : L, iterateFrobenius L ℓ (f : ℕ) c = c ^ Nat.card K := fun c => by
    rw [hqK]
    exact iterateFrobenius_def ℓ (f : ℕ) c
  have hFix : ∀ y : ModGL Tag.E6 K,
      entrywiseFrobGL Tag.E6 L ℓ (f : ℕ) (baseChangeGL ι₁ y) = baseChangeGL ι₁ y := by
    intro y
    have hcomp : (iterateFrobenius L ℓ (f : ℕ)).comp ι₁ = ι₁ := by
      refine RingHom.ext fun c => ?_
      change (iterateFrobenius L ℓ f) (ι₁ c) = ι₁ c
      rw [iterateFrobenius_def, ← map_pow]
      congr 1
      rw [← hf]
      exact FiniteField.pow_card c
    rw [entrywiseFrobGL, CFSG.LieType.Chevalley.units_map_entrywiseHom_eq_baseChangeGL,
      CFSG.LieType.Chevalley.baseChangeGL_baseChangeGL, hcomp]
  have hℓp : ℓ ≠ p := by
    intro h'
    apply hpK
    rw [hqK, h']
    exact dvd_pow_self p (by omega)
  have hpq : Nat.Coprime p (ℓ ^ (f : ℕ)) := (Nat.Prime.coprime_iff_not_dvd hp).2 (hqK ▸ hpK)
  have hbcG : ∀ x ∈ TableBExc.E6Three.hatGroup Tag.E6 K,
      baseChangeGL ι₁ x ∈ adjointGroup Tag.E6 L := by
    rintro _ ⟨g, hg, a, rfl⟩
    rw [map_mul, CFSG.LieType.Chevalley.baseChangeGL_rootDiagUnit]
    exact mul_mem (CFSG.LieType.Chevalley.baseChangeGL_mem_adjointGroup ι₁ hg)
      (CFSG.RankThree.Classical2.torusGroup_le_adjointGroup_E6 (rootDiagUnit_mem_torusGroup _))
  set u : ModGL Tag.E6 L := baseChangeGL ι₁ h with hu
  have hup : u ^ p = 1 := by rw [hu, ← map_pow, hp1, map_one]
  have hu1 : u ≠ 1 := fun h' => hh1 (baseChangeGL_injective ι₁ (by rw [map_one]; exact h'))
  have hconj := exists_conj_torusGroup_of_pow_eq_one hp hmon hℓp
    (isAlgebraic_zmod_algebraicClosure_of_finite K ℓ) (hbcG h hh) hup
  obtain ⟨D, hΦ, hDq, hmem⟩ := exists_langDatum_of_toral_untw (f : ℕ) hf1 hpq hup (hFix h) hconj
  set ι₀ : ↥(adjointGroup Tag.E6 K) →* ModGL Tag.E6 L :=
    (baseChangeGL ι₁).comp (adjointGroup Tag.E6 K).subtype
  have hι₀inj : Function.Injective ι₀ :=
    (baseChangeGL_injective _).comp (Subgroup.subtype_injective _)
  have hperf : commutator ↥(adjointGroup Tag.E6 K) = ⊤ :=
    single_edge_perfect Tag.E6 K (Or.inr (Or.inr (Or.inl rfl)))
  have hd : LangDescent D 7 ι₀ :=
    langDescent_untw 3 (Or.inl ⟨rfl, rfl⟩) hFr D hΦ Nat.prime_seven (by norm_num) hperf
  have hq' : 5 ≤ p₀ ∨ 4 ≤ D.q := by
    rw [hDq, ← hqK]
    exact hq₀
  have hℓp₀ : ℓ ≠ p₀ := by
    intro h'
    apply hp₀K
    rw [hqK, h']
    exact dvd_pow_self p₀ (by omega)
  obtain ⟨S, a, ι, rfl, hT, hap, h1, hinj, hrange, hda, hι⟩ :=
    KD264Lie.exists_langSetup_of_toral_datum_conj_kd264alg hℓ hf1 D hDq hp₀ hℓp₀.symm hq'
      hd.finite_model ι₀ hι₀inj hd.Γ_eq hmem hup hu1
  have key : ∀ x : ModGL Tag.E6 L, S.D.Φ x = x →
      S.D.step (S.D.g0⁻¹ * x * S.D.g0) = S.D.g0⁻¹ * x * S.D.g0 := by
    intro x hx
    change (MulAut.conj S.D.n) (S.D.Φ (S.D.g0⁻¹ * x * S.D.g0)) = S.D.g0⁻¹ * x * S.D.g0
    rw [MulAut.conj_apply, map_mul, map_mul, map_inv, hx, S.D.lang]
    group
  refine ⟨S, a, ι, hDq.trans hqK.symm, ⟨iterateFrobenius L ℓ (f : ℕ), hFr, hΦ⟩, hT, hap, h1,
    hinj, hrange, hda, fun c => hι c, fun h' hh' => ?_⟩
  have hΦv : S.D.Φ (baseChangeGL ι₁ h') = baseChangeGL ι₁ h' := by
    rw [hΦ]
    exact hFix h'
  exact ⟨key _ hΦv, mul_mem (mul_mem (inv_mem S.D.g0_mem) (hbcG h' hh')) S.D.g0_mem⟩

theorem exists_langSetup_of_hatE6_conj
    {K : Type} [Field K] [Finite K] {p : ℕ}
    (hp : p.Prime) (hpK : ¬ p ∣ Nat.card K) {p₀ : ℕ} (hp₀ : p₀.Prime) (hp₀K : ¬ p₀ ∣ Nat.card K)
    (hq₀ : 5 ≤ p₀ ∨ 4 ≤ Nat.card K) (hmon : MonomialToralAt Tag.E6 p) {h : ModGL Tag.E6 K}
    (hh : h ∈ TableBExc.E6Three.hatGroup Tag.E6 K) (hp1 : h ^ p = 1) (hh1 : h ≠ 1) :
    ∃ (S : LangSetup Tag.E6 (AlgebraicClosure K) p₀) (a : Fin Tag.E6.rank → (AlgebraicClosure K)ˣ)
      (ι : ↥(adjointGroup Tag.E6 K) →* ModGL Tag.E6 (AlgebraicClosure K))
      (g : ModGL Tag.E6 (AlgebraicClosure K)),
      S.D.q = Nat.card K ∧
      (∃ Fr : AlgebraicClosure K →+* AlgebraicClosure K, (∀ c, Fr c = c ^ Nat.card K) ∧
        S.D.Φ = Units.map (entrywiseHom Fr)) ∧
      rootDiagUnit Tag.E6 a ∈ S.D.torus ∧ (∀ i, a i ^ p = 1) ∧ rootDiagUnit Tag.E6 a ≠ 1 ∧
      Function.Injective ι ∧ ι.range = S.Γ ∧
      rootDiagUnit Tag.E6 a = g⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) h * g ∧
      (∀ c : ↥(adjointGroup Tag.E6 K),
        ι c = g⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) (c : ModGL Tag.E6 K) * g) ∧
      ∀ h' ∈ TableBExc.E6Three.hatGroup Tag.E6 K,
        S.D.step (g⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) h' * g) =
            g⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) h' * g ∧
          g⁻¹ * baseChangeGL (algebraMap K (AlgebraicClosure K)) h' * g ∈
            adjointGroup Tag.E6 (AlgebraicClosure K) := by
  obtain ⟨S, a, ι, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩ :=
    exists_langSetup_of_hatE6_conj_g0 hp hpK hp₀ hp₀K hq₀ hmon hh hp1 hh1
  exact ⟨S, a, ι, S.D.g0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩

