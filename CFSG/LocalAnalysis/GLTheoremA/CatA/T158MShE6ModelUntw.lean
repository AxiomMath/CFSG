open CFSG.HardMathSupport.Timmesfeld.CrossChar CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple in
theorem t158E6ModelData_untw
    {G : Type} [Group G] [Finite G]
    {L J A : Subgroup G} {d b : G} (hP : PreSetup 3 L J A d b)
    (hcat : catalogIs (PSimple 3 L) (onLie fun i => ∃ q, I171.I171LieShape 3 i ∧ i = .E6 q)) :
    T158E6ModelData L J A d b := by
  obtain ⟨n, K, _, _, hn1, h3, hKcard, θ', hBI⟩ := t158E6Marking_untw hP hcat
  obtain ⟨φd, hφdI, hφd⟩ := hBI d (Subgroup.mem_sup_left (Subgroup.mem_zpowers d))
  obtain ⟨φb, hφbI, hφb⟩ := hBI b (Subgroup.mem_sup_right (Subgroup.mem_zpowers b))
  let ρ : LargeEvenCenterQuot (LargeEvenChevH (LargeEvenCartanE 6) K false) ≃* adjointGroup Tag.E6 K :=
    TableBExc.recipeEquiv Tag.E6 K
  let θ : ↥L ⧸ Subgroup.center ↥L ≃* adjointGroup Tag.E6 K := θ'.trans ρ
  obtain ⟨wd, hwd⟩ := MonoidHom.mem_range.1 ((E6ThreeModel.recipeID_iff_hatAut φd).1 hφdI)
  obtain ⟨wb, hwb⟩ := MonoidHom.mem_range.1 ((E6ThreeModel.recipeID_iff_hatAut φb).1 hφbI)
  have htrans : ∀ {x : G} {φ : MulAut (LargeEvenCenterQuot (LargeEvenChevH (LargeEvenCartanE 6) K false))},
      LargeEvenInduces θ' (fun l l' => (l' : G) = x⁻¹ * l * x) φ →
      LargeEvenInduces θ (T171Sh.conjRel x) (MulAut.congr ρ φ) := by
    intro x φ hx l l' hl
    change ρ (φ (ρ.symm (ρ (θ' (QuotientGroup.mk l))))) = ρ (θ' (QuotientGroup.mk l'))
    rw [MulEquiv.symm_apply_apply, hx l l' hl]
  have hβ : LargeEvenInduces θ (T171Sh.conjRel d) (TableBExc.E6Three.hatAut Tag.E6 K wd) := by
    rw [hwd]
    exact htrans hφd
  have hφ : LargeEvenInduces θ (T171Sh.conjRel b) (TableBExc.E6Three.hatAut Tag.E6 K wb) := by
    rw [hwb]
    exact htrans hφb
  have hdN : d ∈ Subgroup.normalizer (L : Set G) := hP.norm hP.d_mem
  have hbN : b ∈ Subgroup.normalizer (L : Set G) := hP.norm hP.b_mem
  have hinj : Function.Injective (TableBExc.E6Three.hatAut Tag.E6 K) := NoOffE6Three.hatAut_injective
  have hwd3 : wd ^ 3 = 1 := hinj (by
    rw [map_pow, T171Sh.largeEvenInduces_pow_eq_one hdN hβ (hP.elem.2 d hP.d_mem), map_one])
  have hwd1 : wd ≠ 1 := by
    intro h1
    rw [h1, map_one] at hβ
    have hcent : d ∈ Subgroup.centralizer (L : Set G) :=
      T171Sh.centralizes_of_conjRel_center hdN (T171Sh.exists_center_of_largeEvenInduces_one hdN hβ)
        (Group.isPerfect_def.mpr hP.qs.1)
    have hmem : d ∈ A ⊓ Subgroup.centralizer (L : Set G) := ⟨hP.d_mem, hcent⟩
    rw [hP.faithful] at hmem
    exact hP.d_ne (Subgroup.mem_bot.mp hmem)
  have hdb : d * b = b * d := hP.elem.comm hP.d_mem hP.b_mem
  have hwdb : wd * wb = wb * wd := by
    apply hinj
    have h1 := T171Sh.largeEvenInduces_mul hdN hbN hdb hβ hφ
    have h2 := T171Sh.largeEvenInduces_mul hbN hdN hdb.symm hφ hβ
    rw [← hdb] at h2
    rw [map_mul, map_mul]
    exact T171Sh.largeEvenInduces_unique h1 h2 (T171Sh.conjRel_total (mul_mem hdN hbN))
  have h3K : ¬ 3 ∣ Nat.card K := by
    rw [hKcard]
    intro h
    have := Nat.Prime.dvd_of_dvd_pow Nat.prime_three h
    omega
  have h5K : ¬ 5 ∣ Nat.card K := by
    rw [hKcard]
    intro h
    have := Nat.Prime.dvd_of_dvd_pow Nat.prime_five h
    omega
  have hmon : MonomialToralAt Tag.E6 3 :=
    monomialToralAt_exc monomialToralAt_E6_five monomialToralAt_E7_five (by simp) Nat.prime_three
      (by norm_num)
  obtain ⟨S, a, ι, g, hSq, ⟨Fr, hFr, hΦ⟩, hT, hap, h1, hιinj, hrange, hda, hι, hfix⟩ :=
    exists_langSetup_of_hatE6_conj Nat.prime_three h3K Nat.prime_five h5K (Or.inl le_rfl) hmon wd.2
      (by rw [← Subgroup.coe_pow, hwd3]; rfl) (fun h => hwd1 (Subtype.ext h))
  haveI : Fintype K := Fintype.ofFinite K
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : CharP K 2 := charP_of_card_eq_prime_pow (f := n) (by rw [← Nat.card_eq_fintype_card, hKcard])
