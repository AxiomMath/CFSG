theorem t158E6Marking_untw
    {G : Type} [Group G] [Finite G] {L J A : Subgroup G} {d b : G}
    (hP : PreSetup 3 L J A d b)
    (hcat : catalogIs (PSimple 3 L) (onLie fun i => ∃ q, I171.I171LieShape 3 i ∧ i = .E6 q)) :
    ∃ (n : ℕ) (K : Type) (_ : Field K) (_ : Finite K), 1 ≤ n ∧ 3 ∣ 2 ^ n - 1 ∧
      Nat.card K = 2 ^ n ∧
      ∃ θ : ↥L ⧸ Subgroup.center ↥L ≃*
          LargeEvenCenterQuot (LargeEvenChevH (LargeEvenCartanE 6) K false),
        ∀ x ∈ Subgroup.zpowers d ⊔ Subgroup.zpowers b,
          ∃ φ ∈ LargeEvenChevIDImage (LargeEvenCartanE 6) K
              (LargeEvenChevH (LargeEvenCartanE 6) K false),
            LargeEvenInduces θ (fun l l' => (l' : G) = x⁻¹ * l * x) φ := by
  obtain ⟨n, hn1, h3dvd, hcatn⟩ := T171Sh.exists_exponent_of_catalogIs_E6 hcat
  haveI : Group.IsPerfect ↥L := Group.isPerfect_def.mpr hP.qs.1
  have hO : GLAPPrimeCore 3 ↥L ≤ Subgroup.center ↥L := by
    rw [hP.core]
    exact bot_le
  have hcatZ : catalogIs (↥L ⧸ Subgroup.center ↥L) (T171Sh.isE6n n) :=
    (CFSG.LocalAnalysis.GLTheoremA.catalogIs_congr (S172A.pSimpleEquivCenterQuot 3 hO)).mpr hcatn
  have hLieZ : CFSG.Blueprint.LieModel (↥L ⧸ Subgroup.center ↥L) .E6 0 2 n :=
    T171Sh.lieModel_E6_of_catalogIs hcatZ
  obtain ⟨-, lab, hlab, hraw⟩ := Canonical.largeEvenMarking_markedModel hP.idiag₂
  obtain ⟨R, _, _, _, -, -, θ, -, hM⟩ := Canonical.largeEvenRawDatum_exists hraw
  have hLieR : CFSG.Blueprint.LieModel R .E6 0 2 n := CFSG.Blueprint.LieModel.of_mulEquiv θ hLieZ
  have hc : markChar lab = 2 := by
    by_contra h2
    have hodd : CFSG.Blueprint.OddLieType R := by
      obtain ⟨tag, rank, m⟩ := lab
      cases tag <;> simp [markChar] at h2
      · have h : CFSG.Blueprint.LieModel R .PSL 2 3 2 := hM
        exact ⟨.PSL, 2, 3, 2, Nat.prime_three, by norm_num,
          CFSG.SeitzReduction.F4Pilot.statedLieAdmissible_of_lieModel h, h⟩
      · have h : CFSG.Blueprint.LieModel R .PSU 3 3 1 := hM
        exact ⟨.PSU, 3, 3, 1, Nat.prime_three, by norm_num,
          CFSG.SeitzReduction.F4Pilot.statedLieAdmissible_of_lieModel h, h⟩
    exact CFSG.SeitzReduction.CrossChar.not_oddLieType_of_lieModel_two_of_ne_Tits hLieR
      (by decide) (by simp) (by simp) (by simp) hodd
  obtain ⟨hlabE6, hlabn⟩ := NbrInnerMore.eq_of_markedModel_E6 hn1 hLieR hlab hc hM
  obtain ⟨tag, rank, exp⟩ := lab
  dsimp only at hlabE6 hlabn
  rw [hlabE6, hlabn] at hraw
  dsimp only [CFSG.Assembly.LargeEvenRawDatum, CFSG.Assembly.LargeEvenRecipeChevalley] at hraw
  obtain ⟨K, hKfield, hKfinite, hKcard, hQ⟩ := hraw
  obtain ⟨-, -, ⟨θ', hP', -⟩⟩ := hQ
  obtain ⟨-, hBI⟩ := hP'
  exact ⟨n, K, hKfield, hKfinite, hn1, h3dvd, hKcard, θ', hBI⟩

