private lemma e8T3_lang_transport {K : Type} [Field K] {L : Type} [Field L] [Algebra K L]
    [IsAlgClosure K L] {ℓ f : ℕ} [Fact ℓ.Prime] [CharP L ℓ] (hf : 1 ≤ f)
    {ε : ℤ} {n : ModGL Tag.E8 L} (hnm : n ∈ monomialSubgroup Tag.E8 L)
    (hnW : weylQuotientHom Tag.E8 L ⟨n, hnm⟩ = e8T3We ε)
    {b : Fin Tag.E8.rank → Lˣ} {u : WeylGroup Tag.E8}
    (hSu : (fun γ => u • γ) '' rootCharKernel b = parabolicRoots Tag.E8 (e6Nodes Tag.E8))
    (hmaps : ∀ α ∈ parabolicRoots Tag.E8 (e6Nodes Tag.E8),
      ((u⁻¹)⁻¹ * e8T3We ε * u⁻¹) • α ∈ parabolicRoots Tag.E8 (e6Nodes Tag.E8)) :
    ∃ (V n' m₁ hL : ModGL Tag.E8 L) (π : Equiv.Perm (Fin Tag.E8.rank)),
      V ∈ monomialSubgroup Tag.E8 L ∧ n' = V⁻¹ * n * V ∧
      StdTwist6 m₁ π ∧ m₁ ∈ monomialSubgroup Tag.E8 L ∧
      hL ∈ subsystemGroup Tag.E8 L (e6Set Tag.E8) ∧
      ((rootSpan Tag.E8 L (parabolicRoots Tag.E8 (e6Set Tag.E8)) ⊓
          twistedFixedPoints n' (Units.map (entrywiseHom (iterateFrobenius L ℓ f)))).map
        (MulAut.conj V).toMonoidHom =
        rootSpan Tag.E8 L (rootCharKernel b) ⊓
          twistedFixedPoints n (Units.map (entrywiseHom (iterateFrobenius L ℓ f)))) ∧
      (∀ g : ModGL Tag.E8 L,
        n' * Units.map (entrywiseHom (iterateFrobenius L ℓ f)) g * n'⁻¹ = g ↔
          m₁ * Units.map (entrywiseHom (iterateFrobenius L ℓ f)) (hL * g * hL⁻¹) * m₁⁻¹ =
            hL * g * hL⁻¹) := by
  classical
  haveI : IsAlgClosed L := IsAlgClosure.isAlgClosed K
  set Fr : L →+* L := iterateFrobenius L ℓ f with hFrdef
  set Φ : ModGL Tag.E8 L →* ModGL Tag.E8 L := Units.map (entrywiseHom Fr) with hΦdef
  set v : WeylGroup Tag.E8 := u⁻¹ with hv
  set V : ModGL Tag.E8 L := canonicalRep (coxeterSystem Tag.E8) L v with hV
  have hVm : V ∈ monomialSubgroup Tag.E8 L := canonicalRep_mem_monomialSubgroup L v
  set n' : ModGL Tag.E8 L := V⁻¹ * n * V with hn'
  have hn'm : n' ∈ monomialSubgroup Tag.E8 L := mul_mem (mul_mem (inv_mem hVm) hnm) hVm
  have hvS_node :
      (fun γ => v • γ) '' parabolicRoots Tag.E8 (e6Nodes Tag.E8) = rootCharKernel b := by
    rw [hv, ← hSu, ← Set.image_comp]
    simp [Function.comp_def]
  have hFrbij : Function.Bijective Fr := ⟨Fr.injective, fun y => by
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_pow_nat_eq y
      (show 0 < ℓ ^ f from pow_pos (Fact.out : ℓ.Prime).pos f)
    exact ⟨x, by rw [hFrdef, iterateFrobenius_def, hx]⟩⟩
  have hvS : (fun γ => v • γ) '' parabolicRoots Tag.E8 (e6Set Tag.E8) = rootCharKernel b := by
    simpa [e6Nodes_eq_e6Set] using hvS_node
  have hSroot : ∀ r ∈ parabolicRoots Tag.E8 (e6Set Tag.E8), IsRoot Tag.E8 r :=
    fun r hr => hr.1
  have hlayer := map_conj_rootSpan_inf_twistedFixedPoints Fr hFrbij v n hSroot
  have hP'eq : (rootSpan Tag.E8 L (parabolicRoots Tag.E8 (e6Set Tag.E8)) ⊓
      twistedFixedPoints n' Φ).map (MulAut.conj V).toMonoidHom =
      rootSpan Tag.E8 L (rootCharKernel b) ⊓ twistedFixedPoints n Φ := by
    rw [hvS] at hlayer
    simpa [hV, hn'] using hlayer
  have hπV : weylQuotientHom Tag.E8 L ⟨V, hVm⟩ = v :=
    weylQuotientHom_eq (mapsRootLines_canonicalRep v)
  have hπn' : weylQuotientHom Tag.E8 L ⟨n', hn'm⟩ = v⁻¹ * e8T3We ε * v := by
    have h1 : (⟨n', hn'm⟩ : monomialSubgroup Tag.E8 L) =
        ⟨V, hVm⟩⁻¹ * ⟨n, hnm⟩ * ⟨V, hVm⟩ := Subtype.ext rfl
    rw [h1, map_mul, map_mul, map_inv, hπV, hnW]
  have hw' : MapsJ Tag.E8 (e6Set Tag.E8) (weylQuotientHom Tag.E8 L ⟨n', hn'm⟩) := by
    intro α hα
    rw [hπn']
    have hα' : α ∈ parabolicRoots Tag.E8 (e6Nodes Tag.E8) := by rwa [e6Nodes_eq_e6Set]
    have h := hmaps α hα'
    rw [hv]
    rwa [e6Nodes_eq_e6Set] at h
  obtain ⟨u', hu', π, hπ, hact⟩ := exists_action hw'
  have hπJ : ∀ i ∈ e6Set Tag.E8, π i ∈ e6Set Tag.E8 := by
    rcases hπ with rfl | rfl
    · exact fun i hi => hi
    · exact fun i hi => rhoτ_mem hi
  have hπJ' : ∀ i ∈ e6Set Tag.E8, π.symm i ∈ e6Set Tag.E8 := by
    rcases hπ with rfl | rfl
    · exact fun i hi => hi
    · exact fun i hi => rhoτ_symm_mem hi
  obtain ⟨m₁, hL, hm₁, hhL, hgen, hlang⟩ :=
    exists_conj_twistedFixed hf hn'm hπJ hπJ' hu' hact
  refine ⟨V, n', m₁, hL, π, hVm, rfl, ⟨hπ, hgen⟩, hm₁, hhL, ?_, ?_⟩
  · simpa [hΦdef] using hP'eq
  · simpa [hΦdef] using hlang

private lemma e8T3_transport_qTorus {L : Type} [Field L] {ℓ f : ℕ} [Fact ℓ.Prime] [CharP L ℓ]
    {n n' : ModGL Tag.E8 L} {b : Fin Tag.E8.rank → Lˣ} {q : ℕ}
    {V m₁ hL : ModGL Tag.E8 L} {π : Equiv.Perm (Fin Tag.E8.rank)}
    {T : Subgroup (ModGL Tag.E8 L)} (hstd : StdTwist6 m₁ π)
    (hTle : T ≤ stdLayer Tag.E8 ℓ f m₁) (hTel : IsElemAbelian q T)
    (hTcard : Nat.card T = q ^ 3)
    (hhL : hL ∈ subsystemGroup Tag.E8 L (e6Set Tag.E8))
    (hP'eq : (rootSpan Tag.E8 L (parabolicRoots Tag.E8 (e6Set Tag.E8)) ⊓
      twistedFixedPoints n' (Units.map (entrywiseHom (iterateFrobenius L ℓ f)))).map
        (MulAut.conj V).toMonoidHom =
      rootSpan Tag.E8 L (rootCharKernel b) ⊓
        twistedFixedPoints n (Units.map (entrywiseHom (iterateFrobenius L ℓ f))))
    (hlang : ∀ g : ModGL Tag.E8 L,
      n' * Units.map (entrywiseHom (iterateFrobenius L ℓ f)) g * n'⁻¹ = g ↔
        m₁ * Units.map (entrywiseHom (iterateFrobenius L ℓ f)) (hL * g * hL⁻¹) * m₁⁻¹ =
          hL * g * hL⁻¹) :
    ∃ T₂ : Subgroup (ModGL Tag.E8 L),
      T₂ ≤ rootSpan Tag.E8 L (rootCharKernel b) ⊓
        twistedFixedPoints n (Units.map (entrywiseHom (iterateFrobenius L ℓ f))) ∧
      IsElemAbelian q T₂ ∧ Nat.card T₂ = q ^ 3 := by
  classical
  have h1 : ∀ t ∈ T, hL⁻¹ * t * hL ∈ rootSpan Tag.E8 L (parabolicRoots Tag.E8 (e6Set Tag.E8)) := by
    intro t ht
    have htQ : t ∈ subsystemGroup Tag.E8 L (e6Set Tag.E8) := (Subgroup.mem_inf.mp (hTle ht)).1
    have hmem : hL⁻¹ * t * hL ∈ subsystemGroup Tag.E8 L (e6Set Tag.E8) :=
      mul_mem (mul_mem (inv_mem hhL) htQ) hhL
    rwa [subsystemGroup_eq_rootSpan] at hmem
  have h2 : ∀ t ∈ T, hL⁻¹ * t * hL ∈
      twistedFixedPoints n' (Units.map (entrywiseHom (iterateFrobenius L ℓ f))) := by
    intro t ht
    have htR : t ∈ twistedFixedPoints m₁
        (Units.map (entrywiseHom (iterateFrobenius L ℓ f))) := (Subgroup.mem_inf.mp (hTle ht)).2
    rw [mem_twistedFixedPoints] at htR ⊢
    have hg : m₁ * (Units.map (entrywiseHom (iterateFrobenius L ℓ f)))
        (hL * (hL⁻¹ * t * hL) * hL⁻¹) * m₁⁻¹ = hL * (hL⁻¹ * t * hL) * hL⁻¹ := by
      rwa [show hL * (hL⁻¹ * t * hL) * hL⁻¹ = t from by group]
    exact (hlang (hL⁻¹ * t * hL)).2 hg
  set c₁ : ModGL Tag.E8 L →* ModGL Tag.E8 L := (MulAut.conj hL⁻¹).toMonoidHom with hc₁
  set T₁ : Subgroup (ModGL Tag.E8 L) := T.map c₁ with hT₁
  have hT₁le : T₁ ≤ rootSpan Tag.E8 L (parabolicRoots Tag.E8 (e6Set Tag.E8)) ⊓
      twistedFixedPoints n' (Units.map (entrywiseHom (iterateFrobenius L ℓ f))) := by
    intro y hy
    rw [hT₁] at hy
    obtain ⟨t, ht, rfl⟩ := Subgroup.mem_map.mp hy
    exact Subgroup.mem_inf.mpr ⟨h1 t ht, h2 t ht⟩
  set c₂ : ModGL Tag.E8 L →* ModGL Tag.E8 L := (MulAut.conj V).toMonoidHom with hc₂
  set T₂ : Subgroup (ModGL Tag.E8 L) := T₁.map c₂ with hT₂
  have hT₂le : T₂ ≤ rootSpan Tag.E8 L (rootCharKernel b) ⊓
      twistedFixedPoints n (Units.map (entrywiseHom (iterateFrobenius L ℓ f))) := by
    rw [hT₂]
    have hmono := Subgroup.map_mono (f := c₂) hT₁le
    rwa [hP'eq] at hmono
  have hcardT₂ : Nat.card T₂ = q ^ 3 := by
    rw [hT₂, Subgroup.card_map_of_injective (MulAut.conj V).injective, hT₁,
      Subgroup.card_map_of_injective (MulAut.conj hL⁻¹).injective, hTcard]
  exact ⟨T₂, hT₂le, (hTel.map c₁).map c₂, hcardT₂⟩

theorem exists_rank_three_qTorus_centralizer_of_stdLayer (hE6 : E6Layer Tag.E8) {ε : ℤ}
    (hε : ε = 1 ∨ ε = -1)
    (K : Type) [Field K] [Finite K] {ℓ f : ℕ} [Fact ℓ.Prime] [CharP K ℓ] (hf : 1 ≤ f)
    (hK : Nat.card K = ℓ ^ f) {p : ℕ} (hp : p.Prime) (hp3 : 3 < p)
    (hpf : (p : ℤ) ∣ (Nat.card K : ℤ) ^ 2 + ε * (Nat.card K : ℤ) + 1)
    (L : Type) [Field L] [Algebra K L] [IsAlgClosure K L] [CharP L ℓ]
    (n : ModGL Tag.E8 L) (hnm : n ∈ monomialSubgroup Tag.E8 L)
    (hnW : weylQuotientHom Tag.E8 L ⟨n, hnm⟩ = e8T3We ε)
    (g0 : ModGL Tag.E8 L) (hg0C : g0 ∈ adjointGroup Tag.E8 L)
    (hg0 : Units.map (entrywiseHom (iterateFrobenius L ℓ f)) g0 = g0 * n)
    (hperf : ∀ P : Subgroup (ModGL Tag.E8 L), Finite P → P ≤ adjointGroup Tag.E8 L →
      (∀ x ∈ P, Units.map (entrywiseHom (iterateFrobenius L ℓ f)) x = x) → ⁅P, P⁆ = P →
        P ≤ (adjEmb Tag.E8 K L).range)
    (hT : twistedTorusOf n (Units.map (entrywiseHom (iterateFrobenius L ℓ f))) =
      (fixedCharTuples (weylMatrix (e8T3We ε)) (iterateFrobenius L ℓ f)).map
        (rootDiagUnitHom Tag.E8 L))
    {x : adjointGroup Tag.E8 K} (hx : orderOf x = p) (c : adjointGroup Tag.E8 K)
    (hh : g0⁻¹ * adjEmb Tag.E8 K L (c * x * c⁻¹) * g0 ∈
      twistedTorusOf n (Units.map (entrywiseHom (iterateFrobenius L ℓ f))))
    (b : Fin Tag.E8.rank → Lˣ)
    (hb : rootDiagUnit Tag.E8 b = g0⁻¹ * adjEmb Tag.E8 K L (c * x * c⁻¹) * g0)
    (hS : ∃ u : WeylGroup Tag.E8, (fun γ => u • γ) '' rootCharKernel b =
      parabolicRoots Tag.E8 (e6Nodes Tag.E8))
    {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) (hqp : q ≠ p)
    (hprov : ∀ (m₁ : ModGL Tag.E8 L) (π : Equiv.Perm (Fin Tag.E8.rank)),
      m₁ ∈ monomialSubgroup Tag.E8 L → StdTwist6 m₁ π →
      ∃ T : Subgroup (ModGL Tag.E8 L), T ≤ stdLayer Tag.E8 ℓ f m₁ ∧
        IsElemAbelian q T ∧ Nat.card T = q ^ 3) :
    ∃ F : Subgroup (adjointGroup Tag.E8 K),
      F ≤ Subgroup.centralizer ({x} : Set (adjointGroup Tag.E8 K)) ∧
      IsElemAbelian q F ∧ 3 ≤ CFSG.Open.pRank q F := by
  classical
  have : Fact p.Prime := ⟨hp⟩
  have : Fintype K := Fintype.ofFinite K
  haveI : IsAlgClosed L := IsAlgClosure.isAlgClosed K
  set Fr : L →+* L := iterateFrobenius L ℓ f with hFrdef
  set Φ : ModGL Tag.E8 L →* ModGL Tag.E8 L := Units.map (entrywiseHom Fr) with hΦdef
  obtain ⟨ψ, u, -, hψinj, -, -, -, -, hrange, hSu, -, hmaps, -, -, -⟩ :=
    e8T3_embedding_data (hE6 := hE6) (hε := hε) (K := K) (hf := hf) (hK := hK)
      (hp := hp) (hp3 := hp3) (hpf := hpf) (L := L) (n := n) (hnm := hnm) (hnW := hnW)
      (g0 := g0) (hg0C := hg0C) (hg0 := hg0) (hperf := hperf) (hT := hT) (hx := hx)
      (c := c) (hh := hh) (b := b) (hb := hb) (hS := hS)
  obtain ⟨V, n', m₁, hL, π, hVm, -, hstd, hm₁, hhL, hP'eq, hlang⟩ :=
    e8T3_lang_transport (K := K) (ε := ε) (n := n) (b := b) (u := u) hf hnm hnW hSu hmaps
  obtain ⟨T, hTle, hTel, hTcard⟩ := hprov m₁ π hm₁ hstd
  obtain ⟨T₂, hT₂le, hTel₂, hcardT₂⟩ :=
    e8T3_transport_qTorus hstd hTle hTel hTcard hhL hP'eq hlang
  let F : Subgroup (adjointGroup Tag.E8 K) :=
    (T₂.comap ψ).map (Subgroup.centralizer ({x} : Set (adjointGroup Tag.E8 K))).subtype
  have hFle : F ≤ Subgroup.centralizer ({x} : Set (adjointGroup Tag.E8 K)) :=
    Subgroup.map_subtype_le _
  have hFel : IsElemAbelian q F :=
    (hTel₂.comap hψinj).map (Subgroup.centralizer ({x} : Set (adjointGroup Tag.E8 K))).subtype
  have hT₂range : T₂ ≤ ψ.range := hT₂le.trans hrange
  have hFcard : Nat.card F = q ^ 3 := by
    dsimp only [F]
    rw [Subgroup.card_map_of_injective
      (Subgroup.centralizer ({x} : Set (adjointGroup Tag.E8 K))).subtype_injective]
    have hcomap : Nat.card (T₂.comap ψ) = Nat.card T₂ := by
      rw [← Subgroup.card_map_of_injective hψinj, Subgroup.map_comap_eq,
        inf_of_le_right hT₂range]
    rw [hcomap, hcardT₂]
  exact ⟨F, hFle, hFel, CFSG.SectionRank.le_pRank hq.one_lt le_rfl hFel hFcard⟩

