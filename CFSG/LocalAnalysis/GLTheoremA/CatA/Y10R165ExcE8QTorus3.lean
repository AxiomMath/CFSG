      F ≤ Subgroup.centralizer ({x} : Set (adjointGroup Tag.E8 K)) ∧
      IsElemAbelian q F ∧ 3 ≤ CFSG.Open.pRank q F :=
  exists_rank_three_qTorus_centralizer_of_root (hE6 := hE6) (hε := hε) (K := K)
