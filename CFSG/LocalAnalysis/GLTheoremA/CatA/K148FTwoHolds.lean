private theorem k2h_not_inner {P C : Type} [Group P] [Group C] (eS : P ≃* C) {τ : MulAut P}
    (hτi : ¬ CFSG.RankThree.PartTwo.KFacts.IsInnerAut τ) :
    ¬ CFSG.RankThree.PartTwo.KFacts.IsInnerAut (MulAut.congr eS τ) := by
  have hβx : ∀ x : P, MulAut.congr eS τ (eS x) = eS (τ x) := fun x => k2h_congr_apply eS τ x
  rintro ⟨g, hg⟩
  apply hτi
  refine ⟨eS.symm g, MulEquiv.ext fun y => ?_⟩
  apply eS.injective
  have key := congrArg (fun ψ : MulAut C => ψ (eS y)) hg
  simp only [MulAut.conj_apply] at key
  rw [MulAut.conj_apply, map_mul, map_mul, map_inv, MulEquiv.apply_symm_apply, ← hβx]
  exact key

