        rintro ⟨-, hcm⟩
        rw [hcore] at hcm
        have hcomm : ∀ d ∈ derivedIn X, d * c = c * d := by
          intro d hd
          have h := hcm (Subgroup.commutator_mem_commutator hd (Subgroup.mem_zpowers c))
          rw [Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm] at h
          exact h
        have hmem : (⟨c, hcX⟩ : ↥X) ∈
            Subgroup.centralizer ((commutator ↥X : Subgroup ↥X) : Set ↥X) := by
          rw [Subgroup.mem_centralizer_iff]
          intro t ht
          apply Subtype.ext
          exact hcomm t ⟨t, ht, rfl⟩
        rw [hcen, Subgroup.mem_bot] at hmem
        exact hc1 (congrArg Subtype.val hmem)
      have hlay := u33SolvCentAt_holds P X (derivedIn X) c hS hcatS hcN hc3 hnc
      have hMle : M ≤ GLAPLayer 3 (derivedIn X ⊓ Subgroup.centralizer ({c} : Set P)) := le_sSup hM
      rw [hlay, le_bot_iff] at hMle
      subst hMle
      exact k2h_comp_ne_bot hM

