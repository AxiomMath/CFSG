private noncomputable def projImageSlPiTrueEquivProjectiveSL {K : Type} [Field K] (p f : ℕ) :
    ↥(CFSG.PGLModel.projImage (slPi true 3 (p ^ f) K)) ≃*
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL 3 K :=
  (MulEquiv.subgroupCongr (projSL_eq_projImage (p ^ f) K)).symm.trans
    (projSLEquivProjectiveSL 3 K)

theorem nonempty_projImage_slPi_true_mulEquiv_catalogue {K : Type} [Field K] {p f : ℕ}
    (hF : PiField true p f K) (h5 : 5 ≤ p ^ f) :
    ∃ (Q : TauCeti.PrimePower) (hv : (TauCeti.LieTypeIndex.A 2 Q).Valid),
      Q.p = p ∧ Q.card = p ^ f ∧
      Nonempty (↥(CFSG.PGLModel.projImage (slPi true 3 (p ^ f) K)) ≃*
        (TauCeti.CFSGIndex.lie ⟨.A 2 Q, hv⟩).Group) := by
  classical
  haveI : Finite K := hF.finite
  let Q : TauCeti.PrimePower := ⟨p, f, hF.prime, hF.one_le⟩
  have hQcard : Q.card = p ^ f := TauCeti.PrimePower.card_def Q
  have hQ5 : 5 ≤ Q.card := by rw [hQcard]; exact h5
  have hv : (TauCeti.LieTypeIndex.A 2 Q).Valid :=
    CFSG.LocalAnalysis.RankThreeTheoremC.SmallRankE3.FongLevi.valid_A_two_of_ne_two
      (by omega)
  have hk : Nat.card K = Q.card := by
    rw [hQcard]; simpa [piCard] using hF.card
  obtain ⟨e⟩ := CFSG.Adapters.CatalogueFieldBridges.nonempty_projectiveSL_mulEquiv_lie Q hv hk
  exact ⟨Q, hv, rfl, hQcard,
    ⟨(projImageSlPiTrueEquivProjectiveSL p f).trans e⟩⟩

