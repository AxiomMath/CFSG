  obtain ⟨hPU, -⟩ :=
    CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.unitary_full_diagonal_outer_order
      (h := h) (n := 3) le_rfl hne
  let ePU := Classical.choice hPU
  exact (psuEquivUnitary h).trans ePU.symm

theorem nonempty_projImage_slPi_false_mulEquiv_catalogue {K : Type} [Field K] {p f : ℕ}
    (h : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData p f K) (h5 : 5 ≤ p ^ f) :
