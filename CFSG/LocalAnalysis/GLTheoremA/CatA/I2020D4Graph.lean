  exact ⟨Q, hv, rfl, hQcard,
    ⟨(projImageSlPiFalseEquivPrimeFormP h h5).trans ePC⟩⟩


private theorem isSimpleGroup_fixSubgroup_d4Graph_one {K : Type} [Field K] [Finite K]
    {q f : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) (hq3 : q ≠ 3) (hKcard : Nat.card K = q ^ f) :
    IsSimpleGroup ↥(fixSubgroup (d4Graph K 1)) := by
  have hf : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with h | h
    · rw [h, pow_zero] at hKcard
      have h1 : 1 < Nat.card K := Finite.one_lt_card
      omega
    · exact h
  have hq5 : 5 ≤ q := hq.five_le_of_ne_two_of_ne_three hq2 hq3
  have hK5 : 5 ≤ Nat.card K := by
    rw [hKcard]
    calc 5 ≤ q := hq5
      _ = q ^ 1 := (pow_one q).symm
      _ ≤ q ^ f := Nat.pow_le_pow_right hq.pos hf
  have hK3 : 3 ≤ Nat.card K := by omega
  have hqs := isQuasisimple_fixSubgroup_d4Graph_one hK3
  have hG2q : CFSG.IsQuasisimple ↥(adjointGroup Tag.G2 K) :=
    CFSG.IsQuasisimple.of_mulEquiv (fixSubgroupEquivG2 K hK3).symm hqs
  haveI : IsSimpleGroup ↥(adjointGroup Tag.G2 K) :=
    CFSG.LieType.SeitzGeneration.isSimpleGroup_adjointGroup_of_isQuasisimple hG2q
  exact (fixSubgroupEquivG2 K hK3).isSimpleGroup

private theorem not_jType_fixSubgroup_d4Graph_one {K : Type} [Field K] [Finite K]
    {q f : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) (hq3 : q ≠ 3) (hKcard : Nat.card K = q ^ f) :
    ¬ JType 3 q (fixSubgroup (d4Graph K 1)) := by
  classical
  have hf : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with h | h
    · rw [h, pow_zero] at hKcard
      have h1 : 1 < Nat.card K := Finite.one_lt_card
      omega
    · exact h
  have hq5 : 5 ≤ q := hq.five_le_of_ne_two_of_ne_three hq2 hq3
  have hK5 : 5 ≤ Nat.card K := by
    rw [hKcard]
    calc 5 ≤ q := hq5
      _ = q ^ 1 := (pow_one q).symm
      _ ≤ q ^ f := Nat.pow_le_pow_right hq.pos hf
  have hK3 : 3 ≤ Nat.card K := by omega
  set C := fixSubgroup (d4Graph K 1) with hC
  have hqs : CFSG.IsQuasisimple ↥C := isQuasisimple_fixSubgroup_d4Graph_one hK3
  have hCs : IsSimpleGroup ↥C := isSimpleGroup_fixSubgroup_d4Graph_one hq hq2 hq3 hKcard
  haveI := hCs
  have hnab : ∃ a b : ↥C, a * b ≠ b * a :=
    CFSG.RankThree.PartTwo.Sec8.Item8KFacts2Proof.exists_ne_comm_of_isPerfect hqs.1
  have hZ : Subgroup.center ↥C = ⊥ :=
    CFSG.HardMathSupport.Dickson.I271.center_eq_bot_of_simple_nonab hnab
  have h3K : ¬ 3 ∣ Nat.card K := by
    rw [hKcard]
    intro h3
    have h3q : 3 ∣ q := Nat.prime_three.dvd_of_dvd_pow h3
    exact hq3 ((Nat.prime_dvd_prime_iff_eq Nat.prime_three hq).1 h3q).symm
  have h3dvd : 3 ∣ Nat.card K ^ 2 - 1 :=
    CFSG.SignalizerFunctorTheorem.CatalogBridge.three_dvd_sq_sub_one_of_not_dvd h3K
  have hcardC : Nat.card C = CFSG.Open.ordG2 (Nat.card K) := by
    rw [Nat.card_congr (fixSubgroupEquivG2 K hK3).toEquiv,
      CFSG.Timmesfeld.ExceptionalOrders.card_adjointGroup_G2]
  have h3C : 3 ∣ Nat.card C := by
    rw [hcardC, CFSG.Open.ordG2]
    exact dvd_mul_of_dvd_right h3dvd (Nat.card K ^ 6 * (Nat.card K ^ 6 - 1))
  have hcore : GLAPPrimeCore 3 ↥C = ⊥ :=
    CFSG.HardMathSupport.Dickson.I271.glaPPrimeCore_eq_bot_of_simple
      (J := ↥C) Nat.prime_three h3C
  let ePS := CFSG.HardMathSupport.Dickson.I271.pSimpleEquivSelf C hcore hZ
  have hcard : Nat.card (PSimple 3 C) *
      CFSG.ComponentClassification.CatLeaf.lieOrderDivisor .G2 2 (q ^ f) =
      CFSG.ComponentClassification.CatLeaf.lieOrderNumerator .G2 2 (q ^ f) := by
    rw [Nat.card_congr ePS.toEquiv, hcardC, CFSG.Open.ordG2, hKcard]
    simp [CFSG.ComponentClassification.CatLeaf.lieOrderDivisor,
      CFSG.ComponentClassification.CatLeaf.lieOrderNumerator]
  exact not_jType_of_card hq hq2
    (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))) hf hcard

theorem noJTypeComponent_d4Graph_one {K : Type} [Field K] [Finite K]
    {q f : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) (hq3 : q ≠ 3) (hKcard : Nat.card K = q ^ f) :
    NoJTypeComponent 3 q (d4Graph K 1) := by
  intro J hJ hJT
  have hCs : IsSimpleGroup ↥(fixSubgroup (d4Graph K 1)) :=
    isSimpleGroup_fixSubgroup_d4Graph_one hq hq2 hq3 hKcard
  have hpc : J = fixSubgroup (d4Graph K 1) := by
    refine CFSG.LocalAnalysis.GLTheoremB.MovingAround.SporFacts.glaPComponent_eq_of_simple_normal
      (D := fixSubgroup (d4Graph K 1)) (L := J) (X := fixSubgroup (d4Graph K 1))
      le_rfl ?_ hCs ?_ hJ
    · rw [Subgroup.subgroupOf_self]; infer_instance
    · haveI : Subsingleton (↥(fixSubgroup (d4Graph K 1)) ⧸
          (fixSubgroup (d4Graph K 1)).subgroupOf (fixSubgroup (d4Graph K 1))) := by
        rw [Subgroup.subgroupOf_self]
        exact QuotientGroup.subsingleton_quotient_top
      infer_instance
  rw [hpc] at hJT
  exact not_jType_fixSubgroup_d4Graph_one hq hq2 hq3 hKcard hJT

private theorem gammaP_setup {K : Type} [Field K] [Finite K]
    {q f0 : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) (hq3 : q ≠ 3) (hKcard : Nat.card K = q ^ f0)
    {B : SL2 K} (hB3 : B ^ 3 = 1) (hB1 : B ≠ 1) :
    5 ≤ Nat.card K ∧ ringChar K = q ∧ 5 ≤ ringChar K ∧
      CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.OuterHigh3.IsPGLPiThree
        ↥(fixSubgroup (gammaP K B)) (Nat.card K) := by
  have hf0 : 1 ≤ f0 := by
    rcases Nat.eq_zero_or_pos f0 with h | h
    · rw [h, pow_zero] at hKcard
      have h1 : 1 < Nat.card K := Finite.one_lt_card
      omega
    · exact h
  have hq5 : 5 ≤ q := hq.five_le_of_ne_two_of_ne_three hq2 hq3
  have hK5 : 5 ≤ Nat.card K := by
    rw [hKcard]
    calc 5 ≤ q := hq5
      _ = q ^ 1 := (pow_one q).symm
      _ ≤ q ^ f0 := Nat.pow_le_pow_right hq.pos hf0
  have hring : ringChar K = q :=
    CFSG.ClassicalGroups.Orthogonal.ringChar_eq_of_card_eq hq hf0 hKcard
  have h5 : 5 ≤ ringChar K := by rw [hring]; exact hq5
  have hK2 : ringChar K ≠ 2 := by rw [hring]; exact hq2
  have hK3 : ringChar K ≠ 3 := by rw [hring]; exact hq3
  have hPGL : CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.OuterHigh3.IsPGLPiThree
      ↥(fixSubgroup (gammaP K B)) (Nat.card K) := by
    have hCfixed : fixSubgroup (gammaP K B) =
        CFSG.RankThree.PartOne.CTP.fixedSubgroup (gammaP K B) :=
      Subgroup.ext fun _ => Iff.rfl
    rw [hCfixed]
    exact CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.OuterHighD4Odd.d4GraphA2FixIsoOdd_holds
      K hK2 hK3 hK5 B hB3 hB1
  exact ⟨hK5, hring, h5, hPGL⟩

private theorem pComponent_eq_commutator_gammaP {K : Type} [Field K] [Finite K]
    {q f0 : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) (hq3 : q ≠ 3) (hKcard : Nat.card K = q ^ f0)
    {B : SL2 K} (hB3 : B ^ 3 = 1) (hB1 : B ≠ 1) :
    ∀ J : Subgroup (adjointGroup Tag.D4 K),
      GLAPComponent 3 (fixSubgroup (gammaP K B)) J → J = ⁅fixSubgroup (gammaP K B),
        fixSubgroup (gammaP K B)⁆ := by
  classical
  obtain ⟨hK5, -, -, hPGL'⟩ := gammaP_setup hq hq2 hq3 hKcard hB3 hB1
  set C := fixSubgroup (gammaP K B) with hC
  have hPGL : CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.OuterHigh3.IsPGLPiThree ↥C
      (Nat.card K) := by rwa [hC]
  obtain ⟨hJs', -⟩ :=
    CFSG.LocalAnalysis.GLTheoremA.S2019.isSimpleGroup_commutator_of_isPGLPiThree hK5 hPGL
  set L := (commutator ↥C).map C.subtype with hL
  have hLs : IsSimpleGroup ↥L := by
    haveI := hJs'
    exact (Subgroup.equivMapOfInjective (commutator ↥C) C.subtype
      C.subtype_injective).symm.isSimpleGroup
  have hCL : ⁅C, C⁆ = L := by
    rw [hL, commutator_def, Subgroup.map_commutator, ← MonoidHom.range_eq_map,
      Subgroup.range_subtype]
  have hDn : (L.subgroupOf C).Normal := by
    rw [← hCL, CFSG.LocalAnalysis.GLTheoremB.subgroupOf_commutator le_rfl le_rfl,
      Subgroup.subgroupOf_self]
    infer_instance
  have hmapL : (commutator ↥C).map C.subtype = L := by
    have h1 : (commutator ↥C).map C.subtype = ⁅C, C⁆ := by
      rw [commutator_def, Subgroup.map_commutator, ← MonoidHom.range_eq_map,
        Subgroup.range_subtype]
    exact h1.trans hCL
  have hjcomm : commutator ↥C ≤ L.subgroupOf C := by
    intro z hz
    rw [Subgroup.mem_subgroupOf]
    have hz' : C.subtype z ∈ (commutator ↥C).map C.subtype := ⟨z, hz, rfl⟩
    rwa [hmapL] at hz' 
  haveI := hDn
  have hcomm : IsMulCommutative (↥C ⧸ L.subgroupOf C) :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr hjcomm
  have hsol : Group.IsSolvable (↥C ⧸ L.subgroupOf C) := inferInstance
  intro J hJ
  rw [hCL]
  exact CFSG.LocalAnalysis.GLTheoremB.MovingAround.SporFacts.glaPComponent_eq_of_simple_normal
    (D := L) (L := J) (X := C) (by rw [hL]; exact Subgroup.map_subtype_le _)
    hDn hLs hsol hJ

private theorem three_dvd_card_projImage_slPi {F : Type} [Field F] {p f : ℕ} {π : Bool}
    (hF : PiField π p f F) (hmod : ModThree π (p ^ f)) :
    3 ∣ Nat.card ↥(projImage (slPi π 3 (p ^ f) F)) := by
  set H := slPi π 3 (p ^ f) F
  have h3q := CFSG.HardMathSupport.Solomon.Coordinator.three_dvd_card_slPi_quot hF hmod
  have hker : (projOf H).ker = (StatedScalars (Fin 3) F).subgroupOf H := by
    ext z
    rw [mem_ker_projOf, Subgroup.mem_subgroupOf]
  let eQ : (↥H ⧸ Subgroup.center ↥H) ≃* projImage H :=
    (QuotientGroup.quotientMulEquivOfEq
      (CFSG.HardMathSupport.Solomon.Coordinator.center_slPi_eq hF hmod)).trans
      ((QuotientGroup.quotientMulEquivOfEq hker.symm).trans
        (QuotientGroup.quotientKerEquivOfSurjective (projOf H) (projOf_surjective H)))
  rw [Nat.card_congr eQ.toEquiv] at h3q
  exact h3q

private theorem pSimpleIsLie_of_mulEquiv_projImageSlPi {K : Type} [Field K] [Finite K]
    {p f : ℕ} {π : Bool} {F : Type} [Field F] [Finite F]
    (hF : PiField π p f F) (h5 : 5 ≤ p ^ f)
    {L : Subgroup (adjointGroup Tag.D4 K)}
    (eL : ↥L ≃* projImage (slPi π 3 (p ^ f) F))
    (hZ : Subgroup.center ↥L = ⊥) (hcore : GLAPPrimeCore 3 ↥L = ⊥) :
    ∃ Q : TauCeti.PrimePower,
      pSimpleIsLie 3 L (.A 2 Q) ∨ pSimpleIsLie 3 L (.twistedA 2 Q) := by
  let ePS := CFSG.HardMathSupport.Dickson.I271.pSimpleEquivSelf L hcore hZ
  cases π with
  | false =>
    obtain ⟨Q, hv, -, -, ⟨eCat⟩⟩ :=
      nonempty_projImage_slPi_false_mulEquiv_catalogue hF.unitary h5
    exact ⟨Q, Or.inr ⟨.lie ⟨.twistedA 2 Q, hv⟩, rfl,
      ⟨ePS.trans (eL.trans eCat)⟩⟩⟩
  | true =>
    obtain ⟨Q, hv, -, -, ⟨eCat⟩⟩ :=
      nonempty_projImage_slPi_true_mulEquiv_catalogue hF h5
    exact ⟨Q, Or.inl ⟨.lie ⟨.A 2 Q, hv⟩, rfl,
      ⟨ePS.trans (eL.trans eCat)⟩⟩⟩

private theorem not_jType_commutator_gammaP {K : Type} [Field K] [Finite K]
    {q f0 : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) (hq3 : q ≠ 3) (hKcard : Nat.card K = q ^ f0)
    {B : SL2 K} (hB3 : B ^ 3 = 1) (hB1 : B ≠ 1) :
    ¬ JType 3 q ⁅fixSubgroup (gammaP K B), fixSubgroup (gammaP K B)⁆ := by
  classical
  obtain ⟨hK5, -, -, hPGL'⟩ := gammaP_setup hq hq2 hq3 hKcard hB3 hB1
  set C := fixSubgroup (gammaP K B) with hC
  have hPGL : CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.OuterHigh3.IsPGLPiThree ↥C
      (Nat.card K) := by rwa [hC]
  obtain ⟨π, p, f, F, hFld, hF, hpq, hmod, ⟨eC⟩⟩ := hPGL
  rw [← hpq] at hmod eC
  letI := hFld
  haveI : Finite F := hF.finite
  have hq2' : 2 < p ^ f := by rw [hpq]; omega
  have h5 : 5 ≤ p ^ f := by rw [hpq]; exact hK5
  have hπ : π = false → CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData p f F :=
    fun h => by subst h; exact hF.unitary
  have hSP : projImage (slPi π 3 (p ^ f) F) ≤ projImage (glPi π 3 (p ^ f) F) :=
    Subgroup.map_mono (slPi_le_glPi hπ)
  set L := (commutator ↥C).map C.subtype with hL
  have hCL : ⁅C, C⁆ = L := by
    rw [hL, commutator_def, Subgroup.map_commutator, ← MonoidHom.range_eq_map,
      Subgroup.range_subtype]
  have hcommE : (commutator ↥C).map eC.toMonoidHom =
      (projImage (slPi π 3 (p ^ f) F)).subgroupOf (projImage (glPi π 3 (p ^ f) F)) := by
    rw [← commutator_projImage_glPi hF hq2', commutator_def, commutator_def,
      Subgroup.map_commutator, ← MonoidHom.range_eq_map, MonoidHom.range_eq_top.2 eC.surjective]
  let e0 : ↥(commutator ↥C) ≃* ↥(projImage (slPi π 3 (p ^ f) F)) :=
    ((commutator ↥C).equivMapOfInjective eC.toMonoidHom eC.injective).trans
      ((MulEquiv.subgroupCongr hcommE).trans (Subgroup.subgroupOfEquivOfLe hSP))
  let eMap : ↥(commutator ↥C) ≃* ↥L :=
    (Subgroup.equivMapOfInjective (commutator ↥C) C.subtype C.subtype_injective)
  let eL : ↥L ≃* ↥(projImage (slPi π 3 (p ^ f) F)) := eMap.symm.trans e0
  have hLs0 : IsSimpleGroup ↥(projImage (slPi π 3 (p ^ f) F)) :=
    RonanK429Lie.isSimpleGroup_projImage_slPi hF (Or.inr hq2')
  have hLs : IsSimpleGroup ↥L := by
    haveI := hLs0
    exact eL.isSimpleGroup
  haveI hperf : Group.IsPerfect ↥(projImage (slPi π 3 (p ^ f) F)) :=
    isPerfect_projImage_slPi hF hq2'
  have hZ : Subgroup.center ↥L = ⊥ := by
    have hZproj : Subgroup.center ↥(projImage (slPi π 3 (p ^ f) F)) = ⊥ :=
      center_projImage_eq_bot hF hmod
    have hmap := Subgroup.map_center_eq eL.symm
    rw [hZproj, Subgroup.map_bot] at hmap
    exact hmap.symm
  have h3proj : 3 ∣ Nat.card ↥(projImage (slPi π 3 (p ^ f) F)) :=
    three_dvd_card_projImage_slPi hF hmod
  have h3L : 3 ∣ Nat.card ↥L := by
    rw [Nat.card_congr eL.toEquiv]
    exact h3proj
  have hcore : GLAPPrimeCore 3 ↥L = ⊥ :=
    CFSG.HardMathSupport.Dickson.I271.glaPPrimeCore_eq_bot_of_simple
      (J := ↥L) Nat.prime_three h3L
  have hA2 := pSimpleIsLie_of_mulEquiv_projImageSlPi hF h5 eL hZ hcore
  have hZP : Subgroup.center (PQuot 3 L) = ⊥ := by
    let ePQ := CFSG.HardMathSupport.Dickson.I271.pQuotEquivSelf L hcore
    have hmap := Subgroup.map_center_eq ePQ
    rw [hZ] at hmap
    exact (Subgroup.map_eq_bot_iff_of_injective (f := ePQ.toMonoidHom)
      (Subgroup.center (PQuot 3 L)) ePQ.injective).1 (by simpa using hmap)
  have hnotSL : ¬ IsSL3Type 3 q L := by
    rintro ⟨Q', -, -, hcen⟩
    exact hcen rfl hZP
  rw [hCL]
  intro hJT
  rcases hJT with hSL | hOm
  · exact hnotSL hSL
  · exact CFSG.LocalAnalysis.GLTheoremA.P65.isOmega_not_A2
      CFSG.LocalAnalysis.GLTheoremA.lieTypeNonIsoAt_holds hOm hA2

private theorem noJTypeComponent_gammaP {K : Type} [Field K] [Finite K]
    {q f0 : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) (hq3 : q ≠ 3) (hKcard : Nat.card K = q ^ f0)
    {B : SL2 K} (hB3 : B ^ 3 = 1) (hB1 : B ≠ 1) :
    NoJTypeComponent 3 q (gammaP K B) := by
  intro J hJ hJT
  have hJeq := pComponent_eq_commutator_gammaP hq hq2 hq3 hKcard hB3 hB1 J hJ
  rw [hJeq] at hJT
  exact not_jType_commutator_gammaP hq hq2 hq3 hKcard hB3 hB1 hJT

theorem i2020D4GraphType_holds : I2020D4GraphType := by
  intro K _ _ q f hq hq2 hq3 hKcard α hα3 g a ε hε3 hε0 hα
  classical
  have hf : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with h | h
    · rw [h, pow_zero] at hKcard
      have h1 : 1 < Nat.card K := Finite.one_lt_card
      omega
    · exact h
  have hq5 : 5 ≤ q := hq.five_le_of_ne_two_of_ne_three hq2 hq3
  have hring : ringChar K = q :=
    CFSG.ClassicalGroups.Orthogonal.ringChar_eq_of_card_eq hq hf hKcard
  have h5 : 5 ≤ ringChar K := by rw [hring]; exact hq5
  have hT : D4ElemType α (fun ε σ => ε ≠ 0 ∧ σ = 1) :=
    ⟨g, a, 1, ε, hε3, by simp, ⟨hε0, rfl⟩, hα⟩
  have hNo1 : NoJTypeComponent 3 q (d4Graph K 1) :=
    noJTypeComponent_d4Graph_one hq hq2 hq3 hKcard
  have hNo2 : NoJTypeComponent 3 q (d4Graph K 2) := by
    have hinv : d4Graph K 2 = (d4Graph K 1)⁻¹ := by
      rw [← inv_inv (d4Graph K 2), ClassOdd.d4Graph_two_inv]
    rw [hinv]
    exact noJTypeComponent_inv hNo1
  have hconjInv : ∀ ψ : MulAut (adjointGroup Tag.D4 K),
      NoJTypeComponent 3 q (ψ * α * ψ⁻¹) → NoJTypeComponent 3 q α := by
    intro ψ hβ
    have h := noJTypeComponent_conj Nat.prime_three ψ⁻¹ hβ
    simpa [mul_assoc] using h
  rcases ClassOdd.d4GraphClassOdd_of (ClassOdd.graphShintaniNF_of ClassOdd.threeD4FixedNF_holds)
      ClassOdd.g2ThreeClass_holds K h5 α hα3 hT with ⟨ψ, hψ⟩ | ⟨ψ, B, hB3, hB1, hψ⟩
  · apply hconjInv ψ
    rcases hψ with h | h
    · rw [h]; exact hNo1
    · rw [h]; exact hNo2
  · apply hconjInv ψ
    have hNoP : NoJTypeComponent 3 q (gammaP K B) :=
      noJTypeComponent_gammaP hq hq2 hq3 hKcard hB3 hB1
    rcases hψ with h | h
    · rw [h]; exact hNoP
    · rw [h]; exact noJTypeComponent_inv hNoP
