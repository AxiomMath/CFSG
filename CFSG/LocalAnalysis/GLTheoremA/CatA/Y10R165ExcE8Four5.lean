theorem torusAct_d4d4W_sq {p : ℕ} [NeZero p] (x : Fin Tag.E8.rank → ZMod p) :
    TableBExc.torusAct .E8 p d4d4W (TableBExc.torusAct .E8 p d4d4W x) = -x := by
  rw [← TableBExc.torusAct_mul, TableBExc.torusAct, mul_smul, d4d4W_smul_smul]
  funext i
  simp [TableBExc.redMod, TableBExc.liftMod, ZMod.natCast_zmod_val]

theorem dualHyp_d4d4W {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2) {lam : ZMod p}
    (hlam : lam * lam = -1) :
    NoOffRest.DualHyp (NoOffRest.bform .E8 p) (NoOffRest.torusLin .E8 p d4d4W)
      (NoOffRest.torusLin .E8 p 1) lam where
  nondeg := NoOffRest.bform_nondegenerate_E8
  isomT := NoOffRest.bform_torusAct d4d4W
  isomU := by
    intro x y
    simp only [NoOffRest.torusLin_apply, TableBExc.torusAct_one]
  comm x := by
    simp only [NoOffRest.torusLin_apply, TableBExc.torusAct_one]
  sq := torusAct_d4d4W_sq
  lam_sq := hlam
  two_ne := by
    intro h
    have h' : ((2 : ℕ) : ZMod p) = 0 := by exact_mod_cast h
    rw [ZMod.natCast_eq_zero_iff] at h'
    exact hp2 ((Nat.prime_dvd_prime_iff_eq Fact.out Nat.prime_two).mp h')

theorem finrank_eig_d4d4W {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2) {lam : ZMod p}
    (hlam : lam * lam = -1) :
    Module.finrank (ZMod p) (NoOffRest.eigSp (NoOffRest.torusLin .E8 p d4d4W) lam) = 4 := by
  have h := dualHyp_d4d4W hp2 hlam
  have d1 := h.finrank_eq
  have d2 := h.finrank_eig_eq
  rw [Module.finrank_fin_fun] at d1
  change 8 = _ at d1
  omega

theorem card_eig_d4d4W {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2) {lam : ZMod p}
    (hlam : lam * lam = -1) :
    Nat.card (NoOffRest.eigSp (NoOffRest.torusLin .E8 p d4d4W) lam) = p ^ 4 := by
  rw [CFSG.StandardType.NoOffRest.natCard_submodule, finrank_eig_d4d4W hp2 hlam]

@[expose] def d6zBase : Fin Tag.E8.rank → ℤ := ![0, 0, 0, 0, 1, 0, 0, 0]

@[expose] def d6zLambda : Fin Tag.E8.rank → ℤ := ![0, 1, 0, 0, 0, 0, 0, 0]

theorem d4d4W_smul_d6zBase :
    d4d4W • d6zBase = -d6zLambda := by
  rw [d4d4W, d4d4W_smul_foldr]
  decide +kernel

theorem d4d4W_smul_d6zLambda :
    d4d4W • d6zLambda = d6zBase := by
  rw [d4d4W, d4d4W_smul_foldr]
  decide +kernel

@[expose] def d6Vec (p : ℕ) (lam : ZMod p) : Fin Tag.E8.rank → ZMod p :=
  TableBExc.redMod .E8 p (d4d4WBase + (lam.val : ℤ) • d4d4WLambda)

@[expose] def d6zVec (p : ℕ) (lam : ZMod p) : Fin Tag.E8.rank → ZMod p :=
  TableBExc.redMod .E8 p (d6zBase + (lam.val : ℤ) • d6zLambda)

private theorem torusAct_redMod' {p : ℕ} [NeZero p] (w : WeylGroup Tag.E8)
    (v : Fin Tag.E8.rank → ℤ) :
    TableBExc.torusAct .E8 p w (TableBExc.redMod .E8 p v) =
      TableBExc.redMod .E8 p (w • v) := by
  rw [TableBExc.torusAct]
  exact TableBExc.redMod_smul_eq w
    (TableBExc.redMod_liftMod (τ := .E8) (p := p) (TableBExc.redMod .E8 p v))

private theorem d4d4W_smul_d6Vec_lattice {p : ℕ} (lam : ZMod p) :
    d4d4W • (d4d4WBase + (lam.val : ℤ) • d4d4WLambda) =
      -d4d4WLambda + (lam.val : ℤ) • d4d4WBase := by
  rw [smul_add,
    show d4d4W • ((lam.val : ℤ) • d4d4WLambda) = (lam.val : ℤ) • (d4d4W • d4d4WLambda) from by
      rw [smul_def, smul_def, map_zsmul],
    d4d4W_smul_d4d4WBase, d4d4W_smul_d4d4WLambda]

private theorem d4d4W_smul_d6zVec_lattice {p : ℕ} (lam : ZMod p) :
    d4d4W • (d6zBase + (lam.val : ℤ) • d6zLambda) =
      -d6zLambda + (lam.val : ℤ) • d6zBase := by
  rw [smul_add,
    show d4d4W • ((lam.val : ℤ) • d6zLambda) = (lam.val : ℤ) • (d4d4W • d6zLambda) from by
      rw [smul_def, smul_def, map_zsmul],
    d4d4W_smul_d6zBase, d4d4W_smul_d6zLambda]

private theorem lam_val_cast {p : ℕ} [NeZero p] (lam : ZMod p) :
    ((lam.val : ℤ) : ZMod p) = lam := by
  push_cast
  exact ZMod.natCast_zmod_val lam

private theorem redMod_eigen_eq {p : ℕ} [NeZero p] (lam : ZMod p) (hlam : lam * lam = -1)
    (X B : Fin Tag.E8.rank → ℤ) :
    TableBExc.redMod .E8 p (-X + (lam.val : ℤ) • B) =
      lam • TableBExc.redMod .E8 p (B + (lam.val : ℤ) • X) := by
  funext i
  simp only [TableBExc.redMod, Pi.add_apply, Pi.smul_apply, Pi.neg_apply, smul_eq_mul,
    Int.cast_add, Int.cast_neg, Int.cast_mul, lam_val_cast]
  rw [mul_add, ← mul_assoc, hlam]
  ring

theorem d6Vec_mem_eig {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2) {lam : ZMod p}
    (hlam : lam * lam = -1) :
    d6Vec p lam ∈ NoOffRest.eigSp (NoOffRest.torusLin .E8 p d4d4W) lam := by
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  rw [NoOffRest.mem_eigSp, NoOffRest.torusLin_apply, d6Vec]
  rw [torusAct_redMod' d4d4W, d4d4W_smul_d6Vec_lattice]
  exact redMod_eigen_eq lam hlam d4d4WLambda d4d4WBase

theorem d6zVec_mem_eig {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2) {lam : ZMod p}
    (hlam : lam * lam = -1) :
    d6zVec p lam ∈ NoOffRest.eigSp (NoOffRest.torusLin .E8 p d4d4W) lam := by
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  rw [NoOffRest.mem_eigSp, NoOffRest.torusLin_apply, d6zVec]
  rw [torusAct_redMod' d4d4W, d4d4W_smul_d6zVec_lattice]
  exact redMod_eigen_eq lam hlam d6zLambda d6zBase

theorem d6Vec_apply_four (p : ℕ) (lam : ZMod p) : d6Vec p lam 4 = 0 := by
  rw [d6Vec, TableBExc.redMod]
  have h1 : d4d4WBase 4 = 0 := by decide
  have h2 : d4d4WLambda 4 = 0 := by decide
  rw [show (d4d4WBase + (lam.val : ℤ) • d4d4WLambda) 4 = 0 from by
    show d4d4WBase 4 + (lam.val : ℤ) * d4d4WLambda 4 = 0
    rw [h1, h2, mul_zero, add_zero]]
  norm_num

theorem d6zVec_apply_four (p : ℕ) (lam : ZMod p) : d6zVec p lam 4 = 1 := by
  rw [d6zVec, TableBExc.redMod]
  have h1 : d6zBase 4 = 1 := by decide
  have h2 : d6zLambda 4 = 0 := by decide
  rw [show (d6zBase + (lam.val : ℤ) • d6zLambda) 4 = 1 from by
    show d6zBase 4 + (lam.val : ℤ) * d6zLambda 4 = 1
    rw [h1, h2, mul_zero, add_zero]]
  norm_num

end Certificates

@[expose] def d6zBaseCoeff : Fin Tag.E8.rank → ℤ := ![0, 0, 0, -1, 2, -1, 0, 0]

@[expose] def d6zDirCoeff : Fin Tag.E8.rank → ℤ := ![0, 2, 0, -1, 0, 0, 0, 0]

theorem d6zBaseCoeff_eq_mulVec :
    d6zBaseCoeff = Matrix.mulVec Tag.E8.symmetrizedCartan d6zBase := by
  decide +kernel

theorem d6zDirCoeff_eq_mulVec :
    d6zDirCoeff = Matrix.mulVec Tag.E8.symmetrizedCartan d6zLambda := by
  decide +kernel

@[expose] def d6zCoeff (p : ℕ) (lam : ZMod p) : Fin Tag.E8.rank → ℤ :=
  d6zBaseCoeff + (lam.val : ℤ) • d6zDirCoeff

theorem d6zCoeff_eq_mulVec (p : ℕ) (lam : ZMod p) :
    d6zCoeff p lam = Matrix.mulVec Tag.E8.symmetrizedCartan
      (d6zBase + (lam.val : ℤ) • d6zLambda) := by
  rw [d6zCoeff, d6zBaseCoeff_eq_mulVec, d6zDirCoeff_eq_mulVec,
    Matrix.mulVec_add, Matrix.mulVec_smul]

@[expose] def d6zTorsionChar {K : Type} [Field K] (p : ℕ) (ζ : Kˣ) (lam : ZMod p) :
    Fin Tag.E8.rank → Kˣ :=
  fun i => ζ ^ (d6zCoeff p lam i)

theorem rootChar_d6zTorsionChar {K : Type} [Field K] (p : ℕ) (ζ : Kˣ) (lam : ZMod p)
    (α : Fin Tag.E8.rank → ℤ) :
    rootChar (d6zTorsionChar p ζ lam) α =
      ζ ^ ((2 * α 4 - α 3 - α 5) + (2 * α 1 - α 3) * (lam.val : ℤ)) := by
  rw [rootChar]
  simp only [d6zTorsionChar]
  calc ∏ i, (ζ ^ d6zCoeff p lam i) ^ α i = ∏ i, ζ ^ (d6zCoeff p lam i * α i) := by
        refine Finset.prod_congr rfl fun i _ => ?_
        rw [zpow_mul]
    _ = ζ ^ ∑ i, d6zCoeff p lam i * α i := Finset.prod_zpow_eq_zpow_sum _ _ _
    _ = ζ ^ ((2 * α 4 - α 3 - α 5) + (2 * α 1 - α 3) * (lam.val : ℤ)) := by
        congr 1
        simp only [d6zCoeff, Pi.add_apply, Pi.smul_apply, smul_eq_mul, add_mul]
        rw [Finset.sum_add_distrib, Fin.sum_univ_def, Fin.sum_univ_def]
        have hrange : List.finRange Tag.E8.rank = [0, 1, 2, 3, 4, 5, 6, 7] := by
          decide +kernel
        rw [hrange]
        simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
        simp [d6zBaseCoeff, d6zDirCoeff]
        ring

theorem d6z_pair_bound :
    ∀ α ∈ rootFinset .E8,
      (2 * α 4 - α 3 - α 5) ^ 2 + (2 * α 1 - α 3) ^ 2 ≤ 4 := by
  decide +kernel

theorem frameDiag_d6Vec {L : Type} [Field L] {p : ℕ} [Fact p.Prime]
    {ζ : Lˣ} (hζ : ζ ^ p = 1) (lam : ZMod p) :
    ExcFrames.frameDiag (τ := .E8) ζ hζ (d6Vec p lam) =
      rootDiagUnit .E8 (d6TorsionChar p ζ lam) := by
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  rw [ExcFrames.frameDiag, d6Vec, ExcFrames.frameCoord_redMod, ← d6EigenCoeff_eq_mulVec]
  congr 1
  funext i
  rw [TableBExc.E6Three.zetaVec_apply]
  exact CFSG.RankThree.Chevalley.pow_val_eq_zpow_of_pow_eq_one hζ _ _ rfl

theorem frameDiag_d6zVec {L : Type} [Field L] {p : ℕ} [Fact p.Prime]
    {ζ : Lˣ} (hζ : ζ ^ p = 1) (lam : ZMod p) :
    ExcFrames.frameDiag (τ := .E8) ζ hζ (d6zVec p lam) =
      rootDiagUnit .E8 (d6zTorsionChar p ζ lam) := by
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  rw [ExcFrames.frameDiag, d6zVec, ExcFrames.frameCoord_redMod, ← d6zCoeff_eq_mulVec]
  congr 1
  funext i
  rw [TableBExc.E6Three.zetaVec_apply]
  exact CFSG.RankThree.Chevalley.pow_val_eq_zpow_of_pow_eq_one hζ _ _ rfl

