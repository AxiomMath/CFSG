theorem inner_of_sup_decomp {G : Type} [Group G] (x : G) (A Sg N : Subgroup G)
    (hcomm : ∀ a ∈ A, ∀ s ∈ Sg, a * s = s * a)
    (hsup : A ⊔ Sg = Subgroup.centralizer ({x} : Set G))
    (hqs : CFSG.IsQuasisimple ↥Sg)
    (hnorm : (Sg.subgroupOf (Subgroup.centralizer ({x} : Set G))).Normal)
    (huniq : ∀ D : Subgroup G,
      CFSG.RankThree.PartOne.IsComponentOf (Subgroup.centralizer ({x} : Set G)) D → D = N) :
    ∀ c ∈ Subgroup.centralizer ({x} : Set G),
      ∃ n ∈ N, ∀ y ∈ N, c * y * c⁻¹ = n * y * n⁻¹ := by
  intro c hc
  have hSgcomp : CFSG.RankThree.PartOne.IsComponentOf
      (Subgroup.centralizer ({x} : Set G)) Sg :=
    ⟨hsup ▸ le_sup_right, hqs, hnorm.isSubnormal⟩
  have hSgN : Sg = N := huniq Sg hSgcomp
  obtain ⟨p, hpA, s, hsS, rfl⟩ :=
    mem_sup_of_commute' hcomm (hsup.symm ▸ hc)
  have hsN : s ∈ N := by rw [← hSgN]; exact hsS
  refine ⟨s, hsN, fun y hy => ?_⟩
  have hyS : y ∈ Sg := by rw [hSgN]; exact hy
  have hys : s * y * s⁻¹ ∈ Sg := Sg.mul_mem (Sg.mul_mem hsS hyS) (Sg.inv_mem hsS)
  have hp3 : p * (s * y * s⁻¹) = (s * y * s⁻¹) * p := hcomm p hpA _ hys
  calc (p * s) * y * (p * s)⁻¹ = p * (s * y * s⁻¹) * p⁻¹ := by group
    _ = s * y * s⁻¹ := by rw [hp3]; group

theorem inner_of_odd_order {G : Type} [Group G] [Finite G] {x : G} {N : Subgroup G}
    (hodd : Odd (Nat.card (Subgroup.centralizer ({x} : Set G))))
    (hNle : N ≤ Subgroup.centralizer ({x} : Set G))
    (hNcomp : N ≠ ⊥ → CFSG.RankThree.PartOne.IsComponentOf
      (Subgroup.centralizer ({x} : Set G)) N) :
    ∀ c ∈ Subgroup.centralizer ({x} : Set G),
      ∃ n ∈ N, ∀ y ∈ N, c * y * c⁻¹ = n * y * n⁻¹ := by
  have hNbot : N = ⊥ := by
    by_contra h
    obtain ⟨hNC, hqs, -⟩ := hNcomp h
    have hoddN : Odd (Nat.card N) := hodd.of_dvd_nat (Subgroup.card_dvd_of_le hNC)
    haveI : Finite ↥N := Subtype.finite
    haveI : Nontrivial ↥N := CFSG.LocalCores.isQuasisimple_nontrivial hqs
    haveI : Group.IsPerfect ↥N := hqs.1
    exact Group.IsPerfect.not_isSolvable ↥N (CFSG.FeitThompson.isSolvable_of_odd_natCard _ hoddN)
  intro c hc
  refine ⟨1, Subgroup.one_mem N, fun y hy => ?_⟩
  rw [hNbot, Subgroup.mem_bot] at hy
  rw [hy]
  group

theorem inner_of_sector (D : ReeFrameData K (AlgebraicClosure K) a) (ha : 1 ≤ a)
    (hK : Nat.card K = 2 ^ (2 * a + 1)) (w : WeylGroup ReeTag.F4.tag)
    (E : Subgroup (ModGL ReeTag.F4.tag (AlgebraicClosure K)))
    (hEH : E ≤ torusGroup ReeTag.F4.tag (AlgebraicClosure K))
    (hEF : E ≤ twistedFixed D.F
      (canonicalRep (coxeterSystem ReeTag.F4.tag) (AlgebraicClosure K) w))
    (m : ℕ) (hE : Nat.card E = m ^ 2) {p : ℕ} (hp : p.Prime) (hp3 : 3 < p)
    (hpm : p ^ (Nat.card (ReeTag.F4.reeGamma K a)).factorization p ∣ m ^ 2)
    (x : ReeTag.F4.reeGamma K a) (hx : orderOf x = p)
    (N : Subgroup (ReeTag.F4.reeGamma K a))
    (hNle : N ≤ Subgroup.centralizer ({x} : Set (ReeTag.F4.reeGamma K a)))
    (huniq : ∀ D' : Subgroup (ReeTag.F4.reeGamma K a),
      CFSG.RankThree.PartOne.IsComponentOf
        (Subgroup.centralizer ({x} : Set (ReeTag.F4.reeGamma K a))) D' → D' = N) :
    ∀ c ∈ Subgroup.centralizer ({x} : Set (ReeTag.F4.reeGamma K a)),
      ∃ n ∈ N, ∀ y ∈ N, c * y * c⁻¹ = n * y * n⁻¹ := by
  classical
  haveI : CharP (AlgebraicClosure K) 2 :=
    charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective 2
  obtain ⟨g₀, hg₀, hFg₀, hconj⟩ := sector_hconj D w E hEH hEF m hE hp hpm
  obtain ⟨c, hcH⟩ := hconj x hx
  set g : ModGL ReeTag.F4.tag (AlgebraicClosure K) :=
    (thetaGamma (AlgebraicClosure K) a c)⁻¹ * g₀ with hgdef
  have hg : g ∈ adjointGroup ReeTag.F4.tag (AlgebraicClosure K) :=
    mul_mem (inv_mem (thetaGamma_mem_adjointGroup (AlgebraicClosure K) c)) hg₀
  have hFg : Fext D.F g =
      g * canonicalRep (coxeterSystem ReeTag.F4.tag) (AlgebraicClosure K) w := by
    have hinv : Fext D.F ((thetaGamma (AlgebraicClosure K) a c)⁻¹) =
        (thetaGamma (AlgebraicClosure K) a c)⁻¹ := by
      rw [Fext_inv D.F (thetaGamma_mem_adjointGroup (AlgebraicClosure K) c), D.fext_theta]
    rw [hgdef, Fext_mul D.F (inv_mem (thetaGamma_mem_adjointGroup (AlgebraicClosure K) c)) hg₀,
      hinv, hFg₀]
    group
  have hκH : reeConj g x ∈ torusGroup ReeTag.F4.tag (AlgebraicClosure K) := by
    have e : g⁻¹ * thetaGamma (AlgebraicClosure K) a x * g =
        g₀⁻¹ * thetaGamma (AlgebraicClosure K) a (c * x * c⁻¹) * g₀ := by
      rw [hgdef, map_mul, map_mul, map_inv]
      group
    rw [reeConj_apply, e]
    exact hcH
  obtain ⟨b, hb⟩ := exists_rootDiagUnit_eq_of_mem_torusGroup hκH
  have hordy : orderOf (rootDiagUnit ReeTag.F4.tag b) = p := by
    rw [← hb, orderOf_injective (reeConj g) (reeConj_injective g) x, hx]
  have hbp := CFSG.RankThree.PartOne.KE.pow_eq_one_of_orderOf_rootDiagUnit hordy
  have hb1 := ne_one_of_orderOf_rootDiagUnit hp hordy
  have hbtw : rootDiagUnit ReeTag.F4.tag b ∈ twistedFixed D.F
      (canonicalRep (coxeterSystem ReeTag.F4.tag) (AlgebraicClosure K) w) := by
    rw [← hb]
    exact reeConj_mem_twistedFixed D hg hFg x
  by_cases hne : rootCharKernel b = ∅
  ·
    have hSbot : rootSpan ReeTag.F4.tag (AlgebraicClosure K) (rootCharKernel b) = ⊥ := by
      rw [hne]
      simp [rootSpan]
    have hordW : ¬ p ∣ Nat.card (WeylGroup ReeTag.F4.tag) := not_dvd_card_weylGroup_F4 hp hp3
    have hS : ∀ α ∈ rootCharKernel b, IsRoot ReeTag.F4.tag α := fun α hα => hα.1
    have hSn : ∀ α ∈ rootCharKernel b, -α ∈ rootCharKernel b := fun α hα =>
      ⟨(isRoot_neg_iff).2 hα.1,
        by rw [← zero_sub, rootChar_sub, rootChar_zero, hα.2]; simp⟩
    have hCH : ∀ d ∈ Subgroup.centralizer ({x} : Set (ReeTag.F4.reeGamma K a)),
        reeConj g d ∈ torusGroup ReeTag.F4.tag (AlgebraicClosure K) := by
      intro d hd
      have hψadj : reeConj g d ∈ adjointGroup ReeTag.F4.tag (AlgebraicClosure K) :=
        (reeConj_mem_twistedFixed D hg hFg d).1
      have hcd : reeConj g d * rootDiagUnit ReeTag.F4.tag b =
          rootDiagUnit ReeTag.F4.tag b * reeConj g d := by
        rw [← hb, ← map_mul, ← map_mul]
        congr 1
        exact Subgroup.mem_centralizer_singleton_iff.1 hd
      have hmem := mem_torus_mul_rootSpan_of_commute hp hordW hbp hb1 hS hSn
        (fun _ h => h) hψadj hcd
      rw [hSbot] at hmem
      obtain ⟨t, ht, q, hq, hqeq⟩ := hmem
      have hq1 : q = 1 := by simpa using hq
      subst hq1
      have h2 : t = reeConj g d := by simpa using hqeq
      exact h2 ▸ ht
    have hCcomm : ∀ d ∈ Subgroup.centralizer ({x} : Set (ReeTag.F4.reeGamma K a)),
        ∀ e ∈ Subgroup.centralizer ({x} : Set (ReeTag.F4.reeGamma K a)), d * e = e * d := by
      intro d hd e he
      apply reeConj_injective g
      rw [map_mul, map_mul, torusGroup_comm (hCH d hd) (hCH e he)]
    intro c hc
    refine ⟨1, N.one_mem, fun y hy => ?_⟩
    have hcy := hCcomm c hc y (hNle hy)
    rw [hcy]
    group
  ·
    obtain ⟨A, Sg, -, hcomm, -, hsup, -, htype⟩ :=
      exists_layer_decomp (D := D) hK hp hp3 w hg hFg hbtw hbp hb1 hne x hb
    have hqs : CFSG.IsQuasisimple ↥Sg := (layerType_props ha hK htype).1
    have hAle : A ≤ Subgroup.normalizer (Sg : Set (ReeTag.F4.reeGamma K a)) := by
      intro t ht
      rw [Subgroup.mem_normalizer_iff]
      intro y
      constructor
      · intro hy
        rw [hcomm t ht y hy]
        simpa using hy
      · intro hy
        have h1 : t⁻¹ * (t * y * t⁻¹) = (t * y * t⁻¹) * t⁻¹ :=
          hcomm t⁻¹ (A.inv_mem ht) _ hy
        have h2 : y = t * y * t⁻¹ := by
          calc y = t⁻¹ * (t * y * t⁻¹) * t := by group
            _ = (t * y * t⁻¹) * t⁻¹ * t := by rw [h1]
            _ = t * y * t⁻¹ := by group
        rw [h2]
        exact hy
    have hle : Sg ≤ Subgroup.centralizer ({x} : Set (ReeTag.F4.reeGamma K a)) :=
      hsup ▸ le_sup_right
    have hCN : Subgroup.centralizer ({x} : Set (ReeTag.F4.reeGamma K a)) ≤
        Subgroup.normalizer (Sg : Set (ReeTag.F4.reeGamma K a)) :=
      hsup ▸ sup_le hAle Subgroup.le_normalizer
    exact inner_of_sup_decomp x A Sg N hcomm hsup hqs
      ((Subgroup.normal_subgroupOf_iff_le_normalizer hle).2 hCN) huniq

theorem inner_of_reeGamma
    (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1))
    {p : ℕ} (hp : p.Prime) (hp3 : 3 < p) (x : ReeTag.F4.reeGamma K a) (hx : orderOf x = p)
    (N : Subgroup (ReeTag.F4.reeGamma K a))
    (hNle : N ≤ Subgroup.centralizer ({x} : Set (ReeTag.F4.reeGamma K a)))
    (huniq : ∀ D' : Subgroup (ReeTag.F4.reeGamma K a),
      CFSG.RankThree.PartOne.IsComponentOf
        (Subgroup.centralizer ({x} : Set (ReeTag.F4.reeGamma K a))) D' → D' = N)
    (hNcomp : N ≠ ⊥ → CFSG.RankThree.PartOne.IsComponentOf
      (Subgroup.centralizer ({x} : Set (ReeTag.F4.reeGamma K a))) N) :
    ∀ c ∈ Subgroup.centralizer ({x} : Set (ReeTag.F4.reeGamma K a)),
      ∃ n ∈ N, ∀ y ∈ N, c * y * c⁻¹ = n * y * n⁻¹ := by
  classical
  haveI : Finite (ModGL ReeTag.F4.tag K) := finite_modGL
  haveI : Finite (ReeTag.F4.reeGamma K a) := Subtype.finite
  obtain ⟨D⟩ := reeFrameData_nonempty (K := K) (L := AlgebraicClosure K) hK
  have hdvd : p ∣ Nat.card (ReeTag.F4.reeGamma K a) := hx ▸ orderOf_dvd_natCard x
  have hfac :=
    (large_Ree_exact_native_order_and_prime_factor_exhaustion a K hK).2 p hp hp3 hdvd
  rcases hfac with h1 | h2 | h3 | h4 | h5
  · obtain ⟨E, hEH, hEF, hE⟩ := torus_phi1 D.isFrob
    exact inner_of_sector D ha hK wPhi1 E hEH hEF _ hE hp hp3
