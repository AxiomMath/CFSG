@[expose] def LinBlockInnDiag : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p : ℕ) (L J A : Subgroup G) (d b : G) (N n : ℕ)
    (K : Type) [Field K] [Finite K], Nat.card K = 2 ^ n → WSetup p L J A d b →
    ∀ (θ : ↥L ⧸ Subgroup.center ↥L ≃* LargeEvenProj (LargeEvenSLGroup (Fin N) K))
      (D B : GL (Fin N) K)
      (hD : D ∈ Subgroup.normalizer (LargeEvenSLGroup (Fin N) K : Set (GL (Fin N) K)))
      (hB : B ∈ Subgroup.normalizer (LargeEvenSLGroup (Fin N) K : Set (GL (Fin N) K))),
      D ^ p = 1 → Commute D B →
      LargeEvenInduces θ (conjRel d) (TableB.projConj (LargeEvenSLGroup (Fin N) K) ⟨D, hD⟩) →
      LargeEvenInduces θ (conjRel b) (TableB.projConj (LargeEvenSLGroup (Fin N) K) ⟨B, hB⟩) →
      InnDiagOn p (Subgroup.zpowers b) J

@[expose] def UniBlockInnDiag : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (p : ℕ) (L J A : Subgroup G) (d b : G) (N n : ℕ)
    (K : Type) [Field K] [Finite K] (_ : UnitaryFieldData 2 n K), 3 ≤ N → (N, 2 ^ n) ≠ (3, 2) →
    WSetup p L J A d b →
    ∀ (θ : ↥L ⧸ Subgroup.center ↥L ≃* LargeEvenProj (unitarySU 2 n K N))
      (D B : GL (Fin N) K) (_ : D ∈ LargeEvenGUSet (Fin N) K (2 ^ n))
      (_ : B ∈ LargeEvenGUSet (Fin N) K (2 ^ n))
      (hD : D ∈ Subgroup.normalizer (unitarySU 2 n K N : Set (GL (Fin N) K)))
      (hB : B ∈ Subgroup.normalizer (unitarySU 2 n K N : Set (GL (Fin N) K))),
      D ^ p = 1 → Commute D B →
      LargeEvenInduces θ (conjRel d) (TableB.projConj (unitarySU 2 n K N) ⟨D, hD⟩) →
      LargeEvenInduces θ (conjRel b) (TableB.projConj (unitarySU 2 n K N) ⟨B, hB⟩) →
      InnDiagOn p (Subgroup.zpowers b) J

end CFSG.LocalAnalysis.GLTheoremA.T171Sh

