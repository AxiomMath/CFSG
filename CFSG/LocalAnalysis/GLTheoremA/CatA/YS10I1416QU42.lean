theorem twoRank_le_five_of_order_four {G : Type} [Group G] [Finite G] (hcard : Nat.card G = 25920)
    (g : G) (hg : orderOf g = 4) : twoRank G ≤ 5 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hsyl : ∀ T : Sylow 2 G, Nat.card (T : Subgroup G) = 2 ^ 6 := by
    intro T
    rw [Sylow.card_eq_multiplicity, hcard, show (25920 : ℕ).factorization 2 = 6 by decide +kernel]
  obtain ⟨S0⟩ : Nonempty (Sylow 2 G) := inferInstance
  have hnot : ∀ E : Subgroup G, IsElemAbelian 2 E → Nat.card E ≠ 2 ^ 6 := by
    intro E hE hE64
    have hPg : IsPGroup 2 (Subgroup.zpowers g) :=
      IsPGroup.of_card (n := 2) (by rw [Nat.card_zpowers, hg]; norm_num)
    obtain ⟨T, hgT⟩ := hPg.exists_le_sylow
    obtain ⟨c, hc⟩ := CFSG.GH74.SmallRanks.exists_conj_le_sylow T hE
    have hmap : Nat.card (E.map (MulAut.conj c).toMonoidHom) = 2 ^ 6 := by
      rw [Subgroup.card_map_of_injective (MulAut.conj c).injective, hE64]
    have heq : E.map (MulAut.conj c).toMonoidHom = (T : Subgroup G) :=
      Subgroup.eq_of_le_of_card_ge hc (by rw [hsyl T, hmap])
    have hgE : g ∈ E.map (MulAut.conj c).toMonoidHom := by
      rw [heq]
      exact hgT (Subgroup.mem_zpowers g)
    have hEm := CFSG.SectionRank.isElemAbelian_map hE (MulAut.conj c).toMonoidHom
    have hg2 : g ^ 2 = 1 := hEm.2 g hgE
    have hdv : orderOf g ∣ 2 := orderOf_dvd_of_pow_eq_one hg2
    rw [hg] at hdv
    norm_num at hdv
  refine CFSG.GH74.SmallRanks.twoRank_le_of_sylow S0 (r := 5) (fun E hES hE => ?_)
  have hdvd : Nat.card E ∣ 2 ^ 6 := by
    rw [← hsyl S0]
    exact Subgroup.card_dvd_of_le hES
  obtain ⟨j, hj6, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hdvd
  have hj5 : j ≠ 6 := fun h => hnot E hE (by rw [hj, h])
  rw [hj]
  exact Nat.pow_le_pow_right (by norm_num) (by omega)

def ordFourMat : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod 3) :=
  Matrix.fromBlocks !![0, 1; 1, 1] 0 0 !![2, 1; 1, 0]

def ordFourInv : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod 3) :=
  Matrix.fromBlocks !![2, 1; 1, 0] 0 0 !![0, 1; 1, 1]

theorem ordFour_symp : ordFourMat.transpose *
    (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod 3)) * ordFourMat =
      Matrix.fromBlocks 0 1 (-1) 0 := by
  decide

theorem ordFour_mul : ordFourMat * ordFourInv = 1 := by decide
theorem ordFour_mul' : ordFourInv * ordFourMat = 1 := by decide
theorem ordFour_pow4 : ordFourMat ^ 4 = -1 := by decide
theorem ordFour_sq_diag : (ordFourMat ^ 2) (Sum.inl 0) (Sum.inl 0) ≠
    (ordFourMat ^ 2) (Sum.inl 1) (Sum.inl 1) := by decide

def ordFourU : GL (Fin 2 ⊕ Fin 2) (ZMod 3) := ⟨ordFourMat, ordFourInv, ordFour_mul, ordFour_mul'⟩

theorem ordFourU_mem : ordFourU ∈ StatedSp 2 (ZMod 3) := Subgroup.subset_closure ordFour_symp

theorem ordFourU_pow4 : ordFourU ^ 4 = -1 := Units.ext (by
  rw [Units.val_pow_eq_pow_val, Units.val_neg, Units.val_one]
  exact ordFour_pow4)

theorem exists_orderOf_four_psp43 : ∃ x : PSp43, orderOf x = 4 := by
  set x : PSp43 := QuotientGroup.mk ⟨ordFourU, ordFourU_mem⟩ with hx
  have hnot : ¬ x ^ 2 ^ 1 = 1 := by
    intro h
    rw [hx, ← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf] at h
    obtain ⟨c, hc⟩ := h
    have hv := congrArg (fun u : GL (Fin 2 ⊕ Fin 2) (ZMod 3) =>
      (u : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod 3))) hc
    have h1 := congrFun (congrFun hv (Sum.inl 0)) (Sum.inl 0)
    have h2 := congrFun (congrFun hv (Sum.inl 1)) (Sum.inl 1)
    simp [Matrix.GeneralLinearGroup.scalar, Units.val_pow_eq_pow_val, ordFourU] at h1 h2
    exact ordFour_sq_diag (h1.symm.trans h2)
  have hfin : x ^ 2 ^ (1 + 1) = 1 := by
    rw [hx, ← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
    show ordFourU ^ 2 ^ (1 + 1) ∈ StatedScalars (Fin 2 ⊕ Fin 2) (ZMod 3)
    norm_num
    rw [ordFourU_pow4]
    exact CFSG.GH74.Exceptional.neg_one_mem_statedScalars
  exact ⟨x, by simpa using orderOf_eq_prime_pow hnot hfin⟩

theorem exists_orderOf_four_U4 {q : PrimePower} {hv : (LieTypeIndex.twistedA 3 q).Valid}
    (hq : q.card = 2) : ∃ g : ValidLieTypeIndex.Group ⟨.twistedA 3 q, hv⟩, orderOf g = 4 := by
  obtain ⟨e⟩ := CFSG.LieType.Multipliers.U42.nonempty_mulEquiv_PSp43
    (CFSG.HardMathSupport.Dickson.I271.Amb.u4_lieModel (hv := hv) hq)
  obtain ⟨x, hx⟩ := exists_orderOf_four_psp43
  exact ⟨e.symm x, by rw [MulEquiv.orderOf_eq, hx]⟩

theorem twoRank_lt_six_of_twistedA_three_two
    {J : Type} [Group J] [Finite J] (hJ : Group.IsPerfect J)
    {q : PrimePower} (hv : (LieTypeIndex.twistedA 3 q).Valid) (hq : q.card = 2)
    (e : J ⧸ Subgroup.center J ≃* ValidLieTypeIndex.Group ⟨.twistedA 3 q, hv⟩) : twoRank J < 6 := by
  have hU := CFSG.HardMathSupport.Dickson.I271.Amb.u4_lieModel (hv := hv) hq
  have hcard : Nat.card (ValidLieTypeIndex.Group ⟨.twistedA 3 q, hv⟩) = 25920 :=
    (CFSG.HardMathSupport.Dickson.I271.Amb.u4_card (hv := hv) hq).2
  obtain ⟨e43⟩ := CFSG.LieType.Multipliers.U42.nonempty_mulEquiv_PSp43 hU
  have hm2 : Nat.card (CFSG.Open.griessHopfMultiplier (ValidLieTypeIndex.Group ⟨.twistedA 3 q, hv⟩)) = 2 := by
    obtain ⟨-, ⟨eM⟩⟩ := CFSG.LieType.Multipliers.U42.multiplier_PSU_four_two _ hU
    rw [Nat.card_congr eM.toEquiv, Nat.card_congr Multiplicative.toAdd, Nat.card_zmod]
  have hdvd : Nat.card (Subgroup.center J) ∣ 2 := by
    have h1 := CFSG.AGLEmbedding.card_center_dvd_card_griessHopfMultiplier hJ e
    rwa [hm2] at h1
  rcases (Nat.dvd_prime Nat.prime_two).1 hdvd with h1 | h2
  ·
    have hcen : Subgroup.center J = ⊥ := Subgroup.card_eq_one.1 h1
    have eJ0 : J ⧸ Subgroup.center J ≃* J :=
      (QuotientGroup.quotientMulEquivOfEq hcen).trans QuotientGroup.quotientBot
    have eJU : J ≃* ValidLieTypeIndex.Group ⟨.twistedA 3 q, hv⟩ := eJ0.symm.trans e
    have hfin : Finite (ValidLieTypeIndex.Group ⟨.twistedA 3 q, hv⟩) := Finite.of_equiv J eJU.toEquiv
    obtain ⟨g, hg⟩ := exists_orderOf_four_U4 (hv := hv) hq
    rw [CFSG.GH74.twoRank_eq_of_mulEquiv eJU]
    have := twoRank_le_five_of_order_four hcard g hg
    omega
  ·
    have hJe : J ⧸ Subgroup.center J ≃* CFSG.Assembly.RankThreeEven.projSU 4 2 1 :=
      e.trans (e43.trans
        (CFSG.LieType.Multipliers.U42.nonempty_mulEquiv_PSp43
          CFSG.RankThree.PartTwo.Sec4.Census.DoubleCoverRanksTwo.blueprint_lieModel_projSU_four_two).some.symm)
    obtain ⟨α⟩ := CFSG.RankThree.PartTwo.Sec4.Census.DoubleCoverRanksTwo.nonempty_mulEquiv_statedSp_of_double_cover
      hJ h2 hJe
    have h3 := CFSG.RankThree.PartTwo.Sec4.Census.DoubleCoverRanksTwo.pRank_le_two_of_mulEquiv α
    show CFSG.Open.pRank 2 (⊤ : Subgroup J) < 6
    rw [← CFSG.SectionRank.pRank_eq_open_pRank_top]
    omega

