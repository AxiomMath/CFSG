variable {F : Type} [Field F] [Finite F]

theorem exists_conj_le_e7Levi_of_stdElt [CharP F 2] (hF : Nat.card F = 2)
    {A : Subgroup ↥(adjointGroup .E8 F)} {d : ↥(adjointGroup .E8 F)} (hAel : IsElemAbelian 3 A)
    (h7 : 3 ^ 7 ≤ Nat.card A) (hd : IsStdElt 3 A d)
    {T : Subgroup ↥(adjointGroup .E8 F)} (hT : T ≠ ⊥) (hT2 : IsPGroup 2 T)
    (hTN : innerClosure A d ⊔ A ≤ Subgroup.normalizer (T : Set ↥(adjointGroup .E8 F))) :
    ∃ g : ↥(adjointGroup .E8 F), A.map (MulAut.conj g).toMonoidHom ≤ e7Levi F ∧
      stdLayer (MulAut.conj g d) ≤ e7Levi F := by
  obtain ⟨g, hA, hK⟩ := exists_conj_le_of_stdElt_of_levi .E8 Nat.prime_three (by norm_num)
    (M₀ := rootSpan .E8 F (perpRoots .E8)) hAel hd
    (fun J hJ E hE hEel hcard => parabolicLevi_le_rootSpan_perpRoots_of_card_E8 hF hJ hE hEel
      (h7.trans hcard)) hT hT2 hTN
  exact ⟨g, fun z hz => Subgroup.mem_subgroupOf.2 (hA (Subgroup.mem_map_of_mem _ hz)),
    fun z hz => Subgroup.mem_subgroupOf.2 (hK (Subgroup.mem_map_of_mem _ hz))⟩

theorem exists_conj_frameRep_of_le_e7Levi [CharP F 2] (hF : Nat.card F = 2)
    {A : Subgroup ↥(adjointGroup .E8 F)} {d : ↥(adjointGroup .E8 F)} (hAel : IsElemAbelian 3 A)
    (h7 : 3 ^ 7 ≤ Nat.card A) (hd : IsStdElt 3 A d) (hAD : A ≤ e7Levi F)
    (hKD : stdLayer d ≤ e7Levi F) :
    ∃ g : ↥(adjointGroup .E8 F), A.map (MulAut.conj g).toMonoidHom = e8FrameV F ∧
      ∃ r ∈ e8FrameReps, MulAut.conj g d = tE F frameE8 (Multiplicative.ofAdd r) ∧
        stdLayer (MulAut.conj g d) ≤ e7Levi F := by
  obtain ⟨m, hmD, hm⟩ := exists_conj_eq_e8FrameV_of_le_e7Levi (K := F) hF hAD hAel h7
  have hdm : MulAut.conj m d ∈ e8FrameV F := by
    rw [← hm]
    exact Subgroup.mem_map_of_mem _ hd.1
  obtain ⟨v, hv0, hdv⟩ := (mem_e8FrameV_iff (K := F)).1 hdm
  have hv : v ≠ 0 := by
    intro hv
    have h1 : MulAut.conj m d = 1 := by rw [hdv, hv]; simp
    have h2 : MulAut.conj m d = MulAut.conj m 1 := by rw [h1, map_one]
    exact hd.2.1 ((MulAut.conj m).injective h2)
  obtain ⟨n, hnD, hnV, r, hr, hnr⟩ := exists_conj_tE_mem_e8FrameReps (K := F) hF hv0 hv
  refine ⟨n * m, ?_, r, hr, ?_, ?_⟩
  · have hcomp : (MulAut.conj (n * m)).toMonoidHom =
        (MulAut.conj n).toMonoidHom.comp (MulAut.conj m).toMonoidHom := by
      ext x
      simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      group
    rw [hcomp, ← Subgroup.map_map, hm, hnV]
  · have hconj : MulAut.conj (n * m) d = MulAut.conj n (MulAut.conj m d) := by
      simp only [MulAut.conj_apply]
      group
    rw [hconj, hdv]
    simpa only [MulAut.conj_apply] using hnr
  · have hgD : n * m ∈ e7Levi F := (e7Levi F).mul_mem hnD hmD
    rw [stdLayer_map_mulEquiv]
    intro x hx
    obtain ⟨y, hy, rfl⟩ := hx
    change (MulAut.conj (n * m)) y ∈ e7Levi F
    rw [MulAut.conj_apply]
    exact (e7Levi F).mul_mem ((e7Levi F).mul_mem hgD (hKD hy)) ((e7Levi F).inv_mem hgD)

theorem stdExtendsN_of_mem_e8FrameReps [CharP F 2] (hF : Nat.card F = 2)
    {r : Fin 8 → ZMod 3} (hr : r ∈ e8FrameReps)
    (hd : IsStdElt 3 (e8FrameV F) (tE F frameE8 (Multiplicative.ofAdd r)))
    (hKD : stdLayer (tE F frameE8 (Multiplicative.ofAdd r)) ≤ e7Levi F) :
    StdExtendsN 3 (e8FrameV F) (tE F frameE8 (Multiplicative.ofAdd r)) := by
  rcases e8FrameReps_cases r hr with rfl | ⟨w, c, hx⟩
  · exact stdExtendsN_lineRep hF hKD
  · exact (false_of_isStdElt_of_mem_e8FrameTrickData (K := F) hF hx hd hKD).elim

theorem stdVanishes_or_stdExtendsN_three_E8_two (hF : Nat.card F = 2)
    [Finite ↥(adjointGroup .E8 F)] {A : Subgroup ↥(adjointGroup .E8 F)}
    {d : ↥(adjointGroup .E8 F)} (hA : GLAIsBmax 3 A) (hd : IsStdElt 3 A d) :
    StdVanishes A d ∨ StdExtendsN 3 A d := by
  obtain ⟨hAel, hcard, -⟩ := hA
  have h7 : 3 ^ 7 ≤ Nat.card A :=
    hcard ▸ Nat.pow_le_pow_right (by norm_num) (seven_le_glaTwoLocalRank_E8_two hF)
  by_cases hv : StdVanishes A d
  · exact Or.inl hv
  obtain ⟨T, hT, hT2, hTN⟩ := not_not.1 hv
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Fintype F := Fintype.ofFinite F
  haveI : CharP F 2 := charP_of_card_eq_prime_pow (p := 2) (f := 1) (by
    rw [← Nat.card_eq_fintype_card, hF]; norm_num)
  obtain ⟨g, hAg, hKg⟩ := exists_conj_le_e7Levi_of_stdElt hF hAel h7 hd hT hT2 hTN
  have hcard' : Nat.card (A.map (MulAut.conj g).toMonoidHom) = Nat.card A :=
    Subgroup.card_map_of_injective (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).injective
  obtain ⟨g', hA', r, hr, hd', hK'⟩ := exists_conj_frameRep_of_le_e7Levi hF (hAel.map _)
    (hcard'.symm ▸ h7) (isStdElt_map (MulAut.conj g) hd) hAg hKg
  have hstd : IsStdElt 3 (e8FrameV F) (tE F frameE8 (Multiplicative.ofAdd r)) := by
    rw [← hA', ← hd']
    exact isStdElt_map (MulAut.conj g') (isStdElt_map (MulAut.conj g) hd)
  have hext := stdExtendsN_of_mem_e8FrameReps hF hr hstd (hd' ▸ hK')
  rw [← hA', ← hd'] at hext
  exact Or.inr ((stdExtendsN_map_iff (MulAut.conj g)).1
    ((stdExtendsN_map_iff (MulAut.conj g')).1 hext))

theorem modelFactExcThree_E8 : ModelFactExcThree .E8 :=
  fun _ _ _ _ hF => fun _ _ hA hd => stdVanishes_or_stdExtendsN_three_E8_two hF hA hd

