private theorem kd76cOpen_no_outer {S : Type} [Group S] {D : Subgroup (MulAut S)}
    (hDI : D ⊓ inner S = ⊥) {x : MulAut S} (hx : x ∈ D ⊓ innerAut S) (hx1 : x ≠ 1) : False := by
  have h' : x ∈ D ⊓ inner S := hx
  rw [hDI, Subgroup.mem_bot] at h'
  exact hx1 h'

private theorem kd76cOpen_d4_three_dvd (q : TauCeti.PrimePower)
    (hv : (TauCeti.LieTypeIndex.D 4 q).Valid)
    {S : Type} [Group S] (e0 : S ≃* (TauCeti.CFSGIndex.lie ⟨.D 4 q, hv⟩).Group)
    (D : Subgroup (MulAut S)) (hD : IsElemAbelian 3 D) (hcard : Nat.card D = 3 ^ 2)
    (hDI : D ⊓ inner S = ⊥) : 3 ∣ q.exponent := by
  have hp : Nat.Prime 3 := Nat.prime_three
  have hp2 : (3 : ℕ) ≠ 2 := by norm_num
  have hmodel : StatedClassicalModel (CFSG.HardMathSupport.Timmesfeld.CrossChar.Cat ⟨.D 4 q, hv⟩)
      .POmegaPlus 4 q.p q.exponent :=
    CFSG.RankThree.PartTwo.Census.statedClassicalModel_typeD 4 q hv (MulEquiv.refl _)
  obtain ⟨-, K, hKF, hKfin, hK, ⟨eK⟩⟩ := id hmodel
  let ε := e0.trans (coordinatePlusWitnessEquiv K eK)
  set ψ := (MulAut.congr ε).toMonoidHom with hψ
  have hinj : Function.Injective ψ := (MulAut.congr ε).injective
  have hinn : (innerAut S).map ψ = innerAut (matrixProjectiveDerived (coordinateQuadPlus 4 K)) :=
    CFSG.HardMathSupport.Solomon.Coordinator.i196_map_innerAut_congr ε
  have hDI' : D ⊓ innerAut S = ⊥ := hDI
  have hout : D.map ψ ⊓ innerAut (matrixProjectiveDerived (coordinateQuadPlus 4 K)) = ⊥ := by
    rw [← hinn, ← Subgroup.map_inf D (innerAut S) ψ hinj, hDI', Subgroup.map_bot]
  have hD' : IsElemAbelian 3 (D.map ψ) :=
    CFSG.HardMathSupport.Solomon.Coordinator.i196_isElemAbelian_map ψ hD
  have hcard' : Nat.card (D.map ψ) = 3 ^ 2 := by
    rw [Subgroup.card_map_of_injective hinj, hcard]
  obtain ⟨a, -, haE, haL, hao⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.i196_d4_outer_exists
      (CFSG.HardMathSupport.Timmesfeld.CrossChar.Cat ⟨.D 4 q, hv⟩) hmodel K hK eK (D.map ψ) hD'
      hcard' hout
  obtain ⟨hdvd, -⟩ := CFSG.HardMathSupport.Timmesfeld.CrossChar.d4_field_descent3
    (CFSG.HardMathSupport.Timmesfeld.CrossChar.Cat ⟨.D 4 q, hv⟩) hmodel hp hp2 K hK eK a haE haL hao
  exact hdvd

section KD76cOpen

set_option linter.unusedSectionVars false

theorem kd76cLieP_holds : ∀ p : ℕ, p.Prime → p ≠ 2 → KD76cLieP p KDOpenFam := by
  intro p hp hp2
  intro S _ _ hS hnab idx _ hchar hiso D hD hcard hDI
  have hcases : p = 3 ∨ p = 5 ∨ 5 < p := by
    rcases Nat.lt_or_ge 5 p with h5 | h5
    · exact Or.inr (Or.inr h5)
    · interval_cases p
      all_goals first
        | exact (Nat.not_prime_zero hp).elim
        | exact (Nat.not_prime_one hp).elim
        | exact (hp2 rfl).elim
        | exact Or.inl rfl
        | exact Or.inr (Or.inl rfl)
        | (exfalso; norm_num at hp)
  rcases hcases with rfl | rfl | hp5
  · by_cases hD4 : ∃ q : TauCeti.PrimePower, idx.1 = TauCeti.LieTypeIndex.D 4 q
    · obtain ⟨q, hq⟩ := hD4
      obtain ⟨d, hv⟩ := idx
      dsimp only at hq
      subst hq
      have hq3 : q.p = 3 := (TauCeti.LieTypeIndex.characteristic_D 4 q).symm.trans hchar
      obtain ⟨e0⟩ := hiso
      refine ⟨rfl, ?_⟩
      show q.p = 3 ∧ 3 ∣ q.exponent
      exact ⟨hq3, kd76cOpen_d4_three_dvd q hv e0 D hD hcard hDI⟩
    · exfalso
      obtain ⟨x, hx, hx1⟩ :=
        CFSG.HardMathSupport.Solomon.Coordinator.defCharOuterRankTwoThreeNonD4_proved S hS hnab idx
          hD4 hiso hchar D hD hcard
      exact kd76cOpen_no_outer hDI hx hx1
  · exfalso
    obtain ⟨x, hx, hx1⟩ :=
      CFSG.HardMathSupport.Solomon.Coordinator.defCharOuterRankTwoFive_proved S hS hnab idx hiso
        hchar D hD hcard
    exact kd76cOpen_no_outer hDI hx hx1
  · exfalso
    obtain ⟨x, hx, hx1⟩ :=
      CFSG.HardMathSupport.Timmesfeld.LocalTwo.defCharOuterRankTwo_proved S hS hnab idx hiso p hp hp5
        hchar D hD hcard
    exact kd76cOpen_no_outer hDI hx hx1

end KD76cOpen

