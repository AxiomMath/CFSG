    have hcenter : Subgroup.center (PQuot 3 (Ipart 3 L b)) = ⊥ :=
      TauCeti.IsSimpleGroup.center_eq_bot_of_not_isMulCommutative hnc
    let eS : PSimple 3 (Ipart 3 L b) ≃* PQuot 3 (Ipart 3 L b) :=
      (QuotientGroup.quotientMulEquivOfEq hcenter).trans QuotientGroup.quotientBot
    have hG : CFSG.Blueprint.LieModel (PSimple 3 (Ipart 3 L b)) .G2 0 2 q.exponent := by
      have hm := I2018Core.lieModel_specOf ⟨.G2 q, hv⟩ (by simp [hq2]) (eS.trans eG2)
      simp only [I2018Core.specOf] at hm
      exact hm
    have hf : 2 ≤ q.exponent := by
      by_contra hlt
      have h1 : q.exponent = 1 := by have := q.exponent_pos; omega
      have : q.card = 2 := by rw [TauCeti.PrimePower.card_def, hq2, h1]; norm_num
      omega
    exact not_tyC_of_G2model hf hG hC
  ·
    haveI : IsSimpleGroup (PQuot 3 (Ipart 3 L b)) := by
      obtain ⟨i, hi, ⟨eU⟩⟩ := hU3
      cases i with
      | lie idx =>
        haveI : IsSimpleGroup idx.Group := (CFSG.Assembly.lie_finite_simple idx).2
        exact MulEquiv.isSimpleGroup eU
      | cyclic _ _ => exact False.elim hi
      | alternating _ _ => exact False.elim hi
