    have hcenter : Subgroup.center (PQuot 3 (Ipart 3 L b)) = ⊥ :=
      TauCeti.IsSimpleGroup.center_eq_bot_of_not_isMulCommutative hnc
    let eS : PSimple 3 (Ipart 3 L b) ≃* PQuot 3 (Ipart 3 L b) :=
      (QuotientGroup.quotientMulEquivOfEq hcenter).trans QuotientGroup.quotientBot
    have hG2d : catalogIs (PSimple 3 (Ipart 3 L b)) isG2der := (catalogIs_congr eS).2 hU3
    refine ⟨hG2d, ?_⟩
    have hcI : card2 3 (Ipart 3 L b) = 32 := by
      unfold card2
      rw [I141F.card_eq_6048_of_isG2der hU3, twoPart_6048]
    have hle : centCard2 3 L b ≤ 64 := by
      have h := FR.i91CentIAt_holds (G := G) hp3 hp2 X L b hL hchev hbp (Or.inr ⟨rfl, hTD4, hNI⟩) hIne
      rw [hcI] at h
