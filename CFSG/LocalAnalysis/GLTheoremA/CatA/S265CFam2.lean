theorem reeEight_centralizer_comm {F : Type} [Field F] [Finite F] [CharP F F4.prime]
    (hF : Nat.card F = 2 ^ (2 * 1 + 1)) (E : Subgroup (F4.reeGamma F 1)) (hE : IsElemAbelian 3 E)
    (h9 : 9 ≤ Nat.card E) {g h : F4.reeGamma F 1} (hg : g ∈ Subgroup.centralizer (E : Set (F4.reeGamma F 1)))
    (hh : h ∈ Subgroup.centralizer (E : Set (F4.reeGamma F 1))) : g * h = h * g := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨z, hzE, hz1⟩ : ∃ z ∈ E, z ≠ 1 := by
    by_contra hcon
    push Not at hcon
    have hbot : E = ⊥ := eq_bot_iff.2 fun x hx => (Subgroup.mem_bot).2 (hcon x hx)
    rw [hbot, Subgroup.card_bot] at h9
    omega
  have hz3 : orderOf z = 3 := orderOf_eq_prime (hE.2 z hzE) hz1
  obtain ⟨e⟩ := CFSG.RankThree.PartTwo.Sec8.Item8KFacts2Proof.centralizer_mulEquiv_unitarySU 1 F hF z hz3
  have hKcard : Nat.card (GaloisField 2 (2 * (2 * 1 + 1))) = (2 ^ (2 * 1 + 1)) ^ 2 := by
    rw [GaloisField.card 2 _ (by norm_num)]
    norm_num
  have h64 : 3 ∣ Nat.card (GaloisField 2 (2 * (2 * 1 + 1))) - 1 := by
    rw [hKcard]
    norm_num
  obtain ⟨ω, hω3, hω1⟩ := exists_cubeRoot_of_three_dvd h64
  exact centralizer_comm_of_centralizer_statedSU hω3 hω1
    (CFSG.Open.StatedCenterThree.card_center_statedSU_three hKcard (by norm_num)) hE h9 hzE hz3 e hg hh

theorem reeEight_outer_solvable {Q : Type} [Group Q] (hmodel : CFSG.Blueprint.ReeTitsModel Q .twistedF4 2 3)
    {τ : MulAut Q} (hτ : orderOf τ = 3) (hτi : τ ∉ CFSG.ComponentClassification.OuterAutomorphisms.inner Q) {γ : Q} (hγ : orderOf γ = 3)
    (hγτ : τ γ = γ) (Y : Subgroup Q) (hYτ : ∀ y ∈ Y, τ y = y) (hYγ : ∀ y ∈ Y, γ * y = y * γ) :
    Group.IsSolvable ↥Y := by
  obtain ⟨hadm, a, hfa, K, hKf, hKfin, hK, ⟨e0⟩⟩ := hmodel
  have ha : a = 1 := by omega
  subst ha
  have hK' : Nat.card K = 2 ^ (2 * 1 + 1) := by simpa using hK
  obtain ⟨-, b, hb, k, _, _, _, hk, ⟨eF⟩⟩ :=
    FR.Res.ree_fix_equiv (by norm_num : 1 ≤ 1) hK' Nat.prime_three (by norm_num) e0 τ hτ hτi
  have hb0 : b = 0 := by omega
  subst hb0
  have hγmem : γ ∈ FP.fixSub τ := FP.mem_fixSub.2 hγτ
  set x : F4.reeGamma k 0 := eF ⟨γ, hγmem⟩ with hx
  have hxord : orderOf x = 3 := by
    have h1 : orderOf (eF.toMonoidHom ⟨γ, hγmem⟩) = orderOf (⟨γ, hγmem⟩ : ↥(FP.fixSub τ)) :=
      orderOf_injective eF.toMonoidHom eF.injective _
    have h2 : orderOf (⟨γ, hγmem⟩ : ↥(FP.fixSub τ)) = 3 := (Subgroup.orderOf_mk γ hγmem).trans hγ
    exact h1.trans h2
  have hcard := CFSG.RankThree.PartTwo.Sec19.SimsC198.reeGamma_card_centralizer hk x hxord
  haveI hsol : Group.IsSolvable ↥(Subgroup.centralizer ({x} : Set (F4.reeGamma k 0))) := by
    haveI : Finite ↥(Subgroup.centralizer ({x} : Set (F4.reeGamma k 0))) :=
      Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
    haveI := Fintype.ofFinite ↥(Subgroup.centralizer ({x} : Set (F4.reeGamma k 0)))
    refine CFSG.Burnside.finite_group_isSolvable_of_card_eq_prime_pow_mul_prime_pow (a := 3) (b := 3)
      Nat.prime_two Nat.prime_three (by norm_num) ?_
    rw [← Nat.card_eq_fintype_card, hcard]
    norm_num
  have hYle : Y ≤ FP.fixSub τ := fun y hy => FP.mem_fixSub.2 (hYτ y hy)
  let ρ0 : ↥Y →* ↥(F4.reeGamma k 0) := eF.toMonoidHom.comp (Subgroup.inclusion hYle)
  have hρ0 : ∀ y : ↥Y, ρ0 y ∈ Subgroup.centralizer ({x} : Set (F4.reeGamma k 0)) := by
    intro y
    rw [Subgroup.mem_centralizer_singleton_iff]
    show eF (Subgroup.inclusion hYle y) * eF ⟨γ, hγmem⟩ = eF ⟨γ, hγmem⟩ * eF (Subgroup.inclusion hYle y)
    rw [← map_mul, ← map_mul]
    congr 1
    exact Subtype.ext (hYγ y y.2).symm
  let ρ := ρ0.codRestrict _ hρ0
  have hρinj : Function.Injective ρ := fun a b h =>
    Subtype.ext (by
      have h1 : ρ0 a = ρ0 b := congrArg Subtype.val h
      have h2 : Subgroup.inclusion hYle a = Subgroup.inclusion hYle b := eF.injective h1
      exact congrArg (fun z : ↥(FP.fixSub τ) => (z : Q)) h2)
