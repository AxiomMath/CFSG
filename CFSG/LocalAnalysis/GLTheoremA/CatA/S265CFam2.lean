theorem twoPart_two_pow_eq (k : ℕ) : twoPart (2 ^ k) = 2 ^ k := by
  unfold twoPart
  rw [Nat.factorization_pow, Finsupp.smul_apply, Nat.Prime.factorization_self Nat.prime_two, smul_eq_mul, mul_one]

theorem lab_not_derived_of_dvd {lab : LargeEvenLabel} (hl : LargeEvenInLambda2 lab) (h3 : 3 ∣ lab.n) :
    ¬ IsChar3Lab lab ∧ lab.tag ≠ .twF4der := by
  obtain ⟨t, r, n⟩ := lab
  obtain ⟨-, hl⟩ := hl
  unfold IsChar3Lab
  dsimp only at h3 hl ⊢
  refine ⟨?_, ?_⟩
  · rintro (rfl | rfl) <;> simp only at hl <;> omega
  · rintro rfl
    simp only at hl
    omega

theorem odd_two_pow_sub_one_of_pos {k : ℕ} (hk : 1 ≤ k) : Odd (2 ^ k - 1) := by
  have h : 2 ^ k = 2 * 2 ^ (k - 1) := by
    rw [← pow_succ']
    congr 1
    omega
  have h1 : 1 ≤ 2 ^ (k - 1) := Nat.one_le_two_pow
  exact ⟨2 ^ (k - 1) - 1, by omega⟩

theorem twoPart_6048 : twoPart 6048 = 32 := by
  have h : (6048 : ℕ) = 189 * 2 ^ 5 := by norm_num
  rw [h, FP.twoPart_mul_odd (by decide) (by positivity), twoPart_two_pow_eq]
  norm_num

theorem twoPart_orderTrialityD4 {f : ℕ} (hf : 1 ≤ f) :
    twoPart (CFSG.Open.orderTrialityD4 (2 ^ f)) = 2 ^ (12 * f) := by
  unfold CFSG.Open.orderTrialityD4
  have hA : Odd ((2 ^ f) ^ 8 + (2 ^ f) ^ 4 + 1) := by
    have hq : Even (2 ^ f) := Nat.even_pow.2 ⟨even_two, by omega⟩
    have h8 : Even ((2 ^ f) ^ 8) := Nat.even_pow.2 ⟨hq, by norm_num⟩
    have h4 : Even ((2 ^ f) ^ 4) := Nat.even_pow.2 ⟨hq, by norm_num⟩
    exact (h8.add h4).add_one
  have hB : Odd ((2 ^ f) ^ 6 - 1) := by
    rw [← pow_mul]
    exact odd_two_pow_sub_one_of_pos (by omega)
  have hC : Odd ((2 ^ f) ^ 2 - 1) := by
    rw [← pow_mul]
    exact odd_two_pow_sub_one_of_pos (by omega)
  have e : (2 ^ f) ^ 12 * ((2 ^ f) ^ 8 + (2 ^ f) ^ 4 + 1) * ((2 ^ f) ^ 6 - 1) * ((2 ^ f) ^ 2 - 1) =
      (((2 ^ f) ^ 8 + (2 ^ f) ^ 4 + 1) * ((2 ^ f) ^ 6 - 1) * ((2 ^ f) ^ 2 - 1)) * 2 ^ (12 * f) := by
    rw [mul_comm 12 f, pow_mul]
    ring
  rw [e, FP.twoPart_mul_odd ((hA.mul hB).mul hC) (by positivity), twoPart_two_pow_eq]

theorem range_isElemAbelian_of_subgroup {M Ω : Type*} [Group M] [Group Ω] {p : ℕ} {E : Subgroup Ω}
    (hE : IsElemAbelian p E) (φ : ↥E →* M) : IsElemAbelian p φ.range := by
  refine ⟨⟨⟨fun a b => ?_⟩⟩, fun x hx => ?_⟩
  · obtain ⟨a', ha'⟩ := a.2
    obtain ⟨b', hb'⟩ := b.2
    apply Subtype.ext
    show (a : M) * b = b * a
    rw [← ha', ← hb', ← map_mul, ← map_mul]
    exact congrArg φ (hE.1.is_comm.comm a' b')
  · obtain ⟨y, rfl⟩ := hx
    rw [← map_pow]
    have : y ^ p = 1 := Subtype.ext (hE.2 y y.2)
    rw [this, map_one]

theorem quCfg_false_of_autSolv {Ω : Type} [Group Ω] [Finite Ω] {S B T : Subgroup Ω} {x b : Ω}
    (cfg : QUCfg 3 S B T x b) (hQ : AutSolvThree (↥S ⧸ Subgroup.center ↥S)) : False := by
  have hp := cfg.prime
  haveI hSn : S.Normal := cfg.normal
  obtain ⟨E, hEB, hEel, hE3, hlay⟩ := cfg.gstar
  set φ : ↥E →* MulAut (↥S ⧸ Subgroup.center ↥S) := (S2019.actQuot S).comp E.subtype with hφ
  have hĒ : IsElemAbelian 3 φ.range := range_isElemAbelian_of_subgroup hEel φ
  have hSperf : ⁅S, S⁆ = S := S2019.commutator_self_eq_of_isQuasisimple cfg.quasi
  have hker : Nat.card φ.ker ≤ 3 := by
    have hmem : ∀ k : ↥φ.ker, ((k.1 : ↥E) : Ω) ∈ Subgroup.zpowers x := by
      intro k
      have hk1 : S2019.actQuot S ((k.1 : ↥E) : Ω) = 1 := k.2
      have hcen : ((k.1 : ↥E) : Ω) ∈ Subgroup.centralizer (S : Set Ω) := by
        refine S2019.le_centralizer_of_actQuot_eq_one S hSperf
          (K := Subgroup.zpowers ((k.1 : ↥E) : Ω)) ?_ (Subgroup.mem_zpowers _)
        intro c hc
        obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 hc
        rw [map_zpow, hk1, one_zpow]
      have hnorm : ((k.1 : ↥E) : Ω) ∈ Subgroup.normalizer (S : Set Ω) := by
        rw [Subgroup.normalizer_eq_top_iff.2 hSn]
        exact Subgroup.mem_top _
      exact (cfg.centB _ (hEB k.1.2)).1 ((centMod_iff_centralizer cfg.core hnorm).2 hcen)
    let ι : ↥φ.ker → ↥(Subgroup.zpowers x) := fun k => ⟨((k.1 : ↥E) : Ω), hmem k⟩
    have hι : Function.Injective ι := fun k l h =>
      Subtype.ext (Subtype.ext (by
        have h' : ((k.1 : ↥E) : Ω) = ((l.1 : ↥E) : Ω) :=
          congrArg (fun z : ↥(Subgroup.zpowers x) => (z : Ω)) h
        exact h'))
    have hordx : Nat.card (Subgroup.zpowers x) = 3 := by
      haveI := Fact.mk hp
      rw [Nat.card_zpowers, orderOf_eq_prime (cfg.elem.2 x cfg.xB) cfg.x1]
    calc Nat.card φ.ker ≤ Nat.card (Subgroup.zpowers x) := Nat.card_le_card_of_injective ι hι
      _ = 3 := hordx
  have h9 : 9 ≤ Nat.card φ.range := by
    have h1 := Subgroup.card_ker_mul_card_range φ
    rw [hE3] at h1
    by_contra hlt
    push Not at hlt
    have h2 : Nat.card φ.ker * Nat.card φ.range ≤ 3 * 8 :=
      Nat.mul_le_mul hker (by omega)
    omega
  set Y : Subgroup (↥S ⧸ Subgroup.center ↥S) :=
    (S172X.csIn S E).map (QuotientGroup.mk' (Subgroup.center ↥S)) with hY
  have hYfix : ∀ y ∈ Y, ∀ ψ ∈ φ.range, ψ y = y := by
    rintro _ ⟨g, hg, rfl⟩ _ ⟨e, rfl⟩
    show S2019.actQuot S ((e : ↥E) : Ω) (QuotientGroup.mk g) = QuotientGroup.mk g
    rw [S2019.actQuot_mk]
    congr 1
    apply Subtype.ext
    have h := S172X.mem_csIn.1 hg ((e : ↥E) : Ω) e.2
    simp only [MulAut.conjNormal_apply]
    calc ((e : ↥E) : Ω) * g * ((e : ↥E) : Ω)⁻¹ = g * ((e : ↥E) : Ω) * ((e : ↥E) : Ω)⁻¹ := by rw [h]
      _ = g := by group
  haveI hsolY : Group.IsSolvable ↥Y := hQ φ.range hĒ h9 Y hYfix
  have hsolC : Group.IsSolvable ↥(S172X.csIn S E) :=
    S172X.isSolvable_of_map_le (QuotientGroup.mk' (Subgroup.center ↥S))
      (fun g hg => (QuotientGroup.eq_one_iff g).1 hg) (le_refl Y)
  haveI : Group.IsSolvable ↥((S172X.csIn S E).map S.subtype) :=
    solvable_of_surjective (f := (Subgroup.equivMapOfInjective (S172X.csIn S E) S.subtype
      S.subtype_injective).toMonoidHom)
      (Subgroup.equivMapOfInjective (S172X.csIn S E) S.subtype S.subtype_injective).surjective
  rw [S172X.map_csIn_subtype S E] at this
  exact hlay (S172X.glaPLayer_eq_bot_of_isSolvable hp)

open Matrix Polynomial in
theorem charpoly_eval_cubeRoot_eq_zero {F : Type*} [Field F] {B : Matrix (Fin 3) (Fin 3) F}
    (hB3 : B ^ 3 = 1) (hdet : B.det = 1) (hns : ∀ c : F, B ≠ c • (1 : Matrix (Fin 3) (Fin 3) F))
    {t : F} (ht : t ^ 3 = 1) : B.charpoly.eval t = 0 := by
  set χ := B.charpoly with hχ
  have hdeg : χ.natDegree = 3 := by rw [hχ, Matrix.charpoly_natDegree_eq_dim, Fintype.card_fin]
  have h3 : χ.coeff 3 = 1 := by
    have := (Matrix.charpoly_monic B).coeff_natDegree
    rwa [← hχ, hdeg] at this
  have h0 : χ.coeff 0 = -1 := by
    have := Matrix.det_eq_sign_charpoly_coeff B
    rw [hdet, Fintype.card_fin, ← hχ] at this
    linear_combination this
  have hCH : χ.coeff 0 • (1 : Matrix (Fin 3) (Fin 3) F) + χ.coeff 1 • B + χ.coeff 2 • B ^ 2 +
      χ.coeff 3 • B ^ 3 = 0 := by
    have := Matrix.aeval_self_charpoly B
    rw [Polynomial.aeval_eq_sum_range, ← hχ, hdeg] at this
    simpa [Finset.sum_range_succ] using this
  rw [h0, h3, hB3, one_smul] at hCH
  have hlin : χ.coeff 1 • B + χ.coeff 2 • B ^ 2 = 0 := by
    rw [← hCH, neg_one_smul]
    abel
  have e1 : B * B ^ 2 = 1 := by rw [← pow_succ', hB3]
  have e2 : B ^ 2 * B ^ 2 = B := by rw [← pow_add, show 2 + 2 = 3 + 1 from rfl, pow_succ, hB3, one_mul]
  have hlin2 : χ.coeff 1 • (1 : Matrix (Fin 3) (Fin 3) F) + χ.coeff 2 • B = 0 := by
    have := congrArg (· * B ^ 2) hlin
    simp only [add_mul, smul_mul_assoc, zero_mul, e1, e2] at this
    exact this
  have hc2 : χ.coeff 2 = 0 := by
    by_contra hc
    apply hns (-(χ.coeff 2)⁻¹ * χ.coeff 1)
    have h1 : χ.coeff 2 • B = -(χ.coeff 1 • (1 : Matrix (Fin 3) (Fin 3) F)) :=
      eq_neg_of_add_eq_zero_right hlin2
    calc B = (χ.coeff 2)⁻¹ • (χ.coeff 2 • B) := by rw [smul_smul, inv_mul_cancel₀ hc, one_smul]
      _ = (-(χ.coeff 2)⁻¹ * χ.coeff 1) • (1 : Matrix (Fin 3) (Fin 3) F) := by
        rw [h1, smul_neg, smul_smul, neg_mul, neg_smul]
  have hc1 : χ.coeff 1 = 0 := by
    rw [hc2, zero_smul, add_zero] at hlin2
    have := congrFun (congrFun hlin2 0) 0
    simpa using this
  rw [Polynomial.eval_eq_sum_range, hdeg]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, h0, hc1, hc2, h3, ht]
  ring

open Matrix Polynomial in
theorem exists_eigenvector_cubeRoot {F : Type*} [Field F] {B : Matrix (Fin 3) (Fin 3) F}
    (hB3 : B ^ 3 = 1) (hdet : B.det = 1) (hns : ∀ c : F, B ≠ c • (1 : Matrix (Fin 3) (Fin 3) F))
    {t : F} (ht : t ^ 3 = 1) : ∃ v : Fin 3 → F, v ≠ 0 ∧ B *ᵥ v = t • v := by
  classical
  have h := charpoly_eval_cubeRoot_eq_zero hB3 hdet hns ht
  rw [Matrix.eval_charpoly] at h
  obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.2 h
  refine ⟨v, hv0, ?_⟩
  rw [Matrix.sub_mulVec] at hv
  have hs : Matrix.scalar (Fin 3) t *ᵥ v = t • v := by
    ext i
    simp [Matrix.scalar_apply, Matrix.mulVec_diagonal]
  rw [hs] at hv
  exact (sub_eq_zero.1 hv).symm

open Matrix Polynomial in
theorem commute_of_commute_cubeRoot_matrix {F : Type*} [Field F] {ω : F} (hω3 : ω ^ 3 = 1) (hω1 : ω ≠ 1)
    {B X Y : Matrix (Fin 3) (Fin 3) F} (hB3 : B ^ 3 = 1) (hdet : B.det = 1)
    (hns : ∀ c : F, B ≠ c • (1 : Matrix (Fin 3) (Fin 3) F)) (hX : Commute X B) (hY : Commute Y B) :
    Commute X Y := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hord : orderOf ω = 3 := orderOf_eq_prime hω3 hω1
  set μ : Fin 3 → F := fun i => ω ^ (i : ℕ) with hμ
  have hω0 : ω ≠ 0 := by
    rintro rfl
    simp at hω3
  have hu : orderOf (Units.mk0 ω hω0) = 3 := by
    rw [← orderOf_units]
    exact hord
  have hμinj : Function.Injective μ := by
    intro i j h
    have h1 : (Units.mk0 ω hω0) ^ (i : ℕ) = (Units.mk0 ω hω0) ^ (j : ℕ) :=
      Units.ext (by simpa [Units.val_pow_eq_pow_val] using h)
    have h' := (pow_eq_pow_iff_modEq (x := Units.mk0 ω hω0)).1 h1
    rw [hu] at h'
    unfold Nat.ModEq at h'
    rw [Nat.mod_eq_of_lt i.2, Nat.mod_eq_of_lt j.2] at h'
    exact Fin.ext h'
  have hμ3 : ∀ i, μ i ^ 3 = 1 := fun i => by
    show (ω ^ (i : ℕ)) ^ 3 = 1
    rw [← pow_mul, mul_comm, pow_mul, hω3, one_pow]
  choose v hv0 hvB using fun i => exists_eigenvector_cubeRoot hB3 hdet hns (hμ3 i)
  have hli : LinearIndependent F v := by
    refine Module.End.eigenvectors_linearIndependent' (Matrix.toLin' B) μ hμinj v fun i => ⟨?_, hv0 i⟩
    rw [Module.End.mem_eigenspace_iff, Matrix.toLin'_apply]
    exact hvB i
  set V : Matrix (Fin 3) (Fin 3) F := Matrix.of fun r c => v c r with hV
  have hVcol : V.col = v := by
    funext c r
    rfl
  have hVu : IsUnit V := Matrix.linearIndependent_cols_iff_isUnit.1 (hVcol ▸ hli)
  have hdetV : IsUnit V.det := (Matrix.isUnit_iff_isUnit_det V).1 hVu
  have hBV : B * V = V * Matrix.diagonal μ := by
    ext r c
    rw [Matrix.mul_diagonal]
    have h := congrFun (hvB c) r
    simp only [Matrix.mulVec, dotProduct, Pi.smul_apply, smul_eq_mul] at h
    simp only [Matrix.mul_apply, hV, Matrix.of_apply]
    rw [h, mul_comm]
  have hD : V⁻¹ * B * V = Matrix.diagonal μ := by
    rw [Matrix.mul_assoc, hBV, ← Matrix.mul_assoc, Matrix.nonsing_inv_mul V hdetV, Matrix.one_mul]
  have hVV : V * V⁻¹ = 1 := Matrix.mul_nonsing_inv V hdetV
  have hVV' : V⁻¹ * V = 1 := Matrix.nonsing_inv_mul V hdetV
  have hdiag : ∀ Z : Matrix (Fin 3) (Fin 3) F, Commute Z B →
      V⁻¹ * Z * V = Matrix.diagonal (fun i => (V⁻¹ * Z * V) i i) := by
    intro Z hZ
    have hcomm : (V⁻¹ * Z * V) * Matrix.diagonal μ = Matrix.diagonal μ * (V⁻¹ * Z * V) := by
      rw [← hD]
      calc V⁻¹ * Z * V * (V⁻¹ * B * V) = V⁻¹ * (Z * B) * V := by
            simp only [Matrix.mul_assoc]
            rw [← Matrix.mul_assoc V V⁻¹, hVV, Matrix.one_mul]
        _ = V⁻¹ * (B * Z) * V := by rw [hZ.eq]
        _ = V⁻¹ * B * V * (V⁻¹ * Z * V) := by
            simp only [Matrix.mul_assoc]
            rw [← Matrix.mul_assoc V V⁻¹, hVV, Matrix.one_mul]
    ext i j
    by_cases hij : i = j
    · subst hij
      simp
    · rw [Matrix.diagonal_apply_ne _ hij]
      have h := congrFun (congrFun hcomm i) j
      rw [Matrix.mul_diagonal, Matrix.diagonal_mul] at h
      have hne : μ i ≠ μ j := fun h' => hij (hμinj h')
      have h0 : (μ i - μ j) * (V⁻¹ * Z * V) i j = 0 := by linear_combination -h
      rcases mul_eq_zero.1 h0 with h1 | h1
      · exact absurd (sub_eq_zero.1 h1) hne
      · exact h1
  have hrec : ∀ Z : Matrix (Fin 3) (Fin 3) F, Z = V * (V⁻¹ * Z * V) * V⁻¹ := by
    intro Z
    simp only [Matrix.mul_assoc]
    rw [hVV, Matrix.mul_one, ← Matrix.mul_assoc, hVV, Matrix.one_mul]
  have hMN : (V⁻¹ * X * V) * (V⁻¹ * Y * V) = (V⁻¹ * Y * V) * (V⁻¹ * X * V) := by
    rw [hdiag X hX, hdiag Y hY, Matrix.diagonal_mul_diagonal, Matrix.diagonal_mul_diagonal]
    congr 1
    funext i
    ring
  show X * Y = Y * X
  rw [hrec X, hrec Y]
  calc V * (V⁻¹ * X * V) * V⁻¹ * (V * (V⁻¹ * Y * V) * V⁻¹)
      = V * ((V⁻¹ * X * V) * (V⁻¹ * Y * V)) * V⁻¹ := by
        simp only [Matrix.mul_assoc]
        rw [← Matrix.mul_assoc V⁻¹ V, hVV', Matrix.one_mul]
    _ = V * ((V⁻¹ * Y * V) * (V⁻¹ * X * V)) * V⁻¹ := by rw [hMN]
    _ = V * (V⁻¹ * Y * V) * V⁻¹ * (V * (V⁻¹ * X * V) * V⁻¹) := by
        simp only [Matrix.mul_assoc]
        rw [← Matrix.mul_assoc V⁻¹ V, hVV', Matrix.one_mul]

theorem commute_of_commute_cubeRoot_statedSU {K : Type} [Field K] {ω : K} (hω3 : ω ^ 3 = 1) (hω1 : ω ≠ 1) {q : ℕ}
    {u g h : ↥(StatedSU 3 q K)} (hu3 : u ^ 3 = 1) (hu : u ∉ Subgroup.center ↥(StatedSU 3 q K))
    (hg : Commute g u) (hh : Commute h u) : Commute g h := by
  have hcoe : ∀ a b : ↥(StatedSU 3 q K), (((a * b : ↥(StatedSU 3 q K)) : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) =
      ((a : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) * ((b : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) :=
    fun a b => rfl
  have hB3 : ((u : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) ^ 3 = 1 := by
    have h1 := congrArg (fun x : ↥(StatedSU 3 q K) => ((x : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K)) hu3
    simpa using h1
  have hdet : ((u : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K).det = 1 := CFSG.Open.StatedAPI.det_of_mem_statedSU u.2
  have hns : ∀ c : K, ((u : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) ≠ c • (1 : Matrix (Fin 3) (Fin 3) K) := by
    intro c hc
    apply hu
    rw [Subgroup.mem_center_iff]
    intro z
    apply Subtype.ext
    apply Units.ext
    rw [hcoe, hcoe, hc, Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_one, Matrix.one_mul]
  have hX : Commute ((g : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) ((u : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) := by
    have h1 := congrArg (fun x : ↥(StatedSU 3 q K) => ((x : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K)) hg.eq
    simp only [hcoe] at h1
    exact h1
  have hY : Commute ((h : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) ((u : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) := by
    have h1 := congrArg (fun x : ↥(StatedSU 3 q K) => ((x : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K)) hh.eq
    simp only [hcoe] at h1
    exact h1
  have hc := commute_of_commute_cubeRoot_matrix hω3 hω1 hB3 hdet hns hX hY
  show g * h = h * g
  apply Subtype.ext
  apply Units.ext
  rw [hcoe, hcoe]
  exact hc.eq

theorem centralizer_comm_of_centralizer_statedSU {G : Type*} [Group G] [Finite G] {L : Type} [Field L] {q : ℕ}
    {ω : L} (hω3 : ω ^ 3 = 1) (hω1 : ω ≠ 1) (hZ3 : Nat.card (Subgroup.center ↥(StatedSU 3 q L)) = 3)
    {E : Subgroup G} (hE : IsElemAbelian 3 E) (h9 : 9 ≤ Nat.card E) {z : G} (hzE : z ∈ E) (hz3 : orderOf z = 3)
    (e : ↥(Subgroup.centralizer ({z} : Set G)) ≃* ↥(StatedSU 3 q L))
    {g h : G} (hg : g ∈ Subgroup.centralizer (E : Set G)) (hh : h ∈ Subgroup.centralizer (E : Set G)) :
    g * h = h * g := by
  obtain ⟨z', hz'E, hz'z⟩ : ∃ z' ∈ E, z' ∉ Subgroup.zpowers z := by
    by_contra hcon
    push Not at hcon
    have h1 := Subgroup.card_le_of_le (show E ≤ Subgroup.zpowers z from fun x hx => hcon x hx)
    rw [Nat.card_zpowers, hz3] at h1
    omega
  have hcommE : ∀ a ∈ E, ∀ b ∈ E, a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (hE.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  set C := Subgroup.centralizer ({z} : Set G) with hC
  have hmemC : ∀ {c : G}, c ∈ Subgroup.centralizer (E : Set G) → c ∈ C :=
    fun hc => Subgroup.mem_centralizer_singleton_iff.2 (Subgroup.mem_centralizer_iff.1 hc z hzE).symm
  have hz'C : z' ∈ C := Subgroup.mem_centralizer_singleton_iff.2 (hcommE z' hz'E z hzE)
  have hzC : z ∈ C := Subgroup.mem_centralizer_singleton_iff.2 rfl
  have hZC : Nat.card (Subgroup.center C) = 3 := by
    rw [Nat.card_congr (Subgroup.centerCongr e).toEquiv]
    exact hZ3
  have hzZ : (⟨z, hzC⟩ : C) ∈ Subgroup.center C := by
    rw [Subgroup.mem_center_iff]
    intro c
    exact Subtype.ext (Subgroup.mem_centralizer_singleton_iff.1 c.2)
  have hZeq : Subgroup.center C = Subgroup.zpowers (⟨z, hzC⟩ : C) := by
    symm
    apply Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.2 hzZ)
    rw [hZC, Nat.card_zpowers, Subgroup.orderOf_mk, hz3]
  set u := e ⟨z', hz'C⟩ with hu
  have hu3 : u ^ 3 = 1 := by
    rw [hu, ← map_pow]
    have h1 : (⟨z', hz'C⟩ : C) ^ 3 = 1 := Subtype.ext (by simpa using hE.2 z' hz'E)
    rw [h1, map_one]
  have hunc : u ∉ Subgroup.center _ := by
    intro huZ
    apply hz'z
    have hmem : (⟨z', hz'C⟩ : C) ∈ Subgroup.center C := by
      rw [Subgroup.mem_center_iff]
      intro c
      apply e.injective
      rw [map_mul, map_mul]
      exact Subgroup.mem_center_iff.1 huZ (e c)
    rw [hZeq] at hmem
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 hmem
    exact Subgroup.mem_zpowers_iff.2 ⟨k, by simpa using congrArg Subtype.val hk⟩
  have hgC := hmemC hg
  have hhC := hmemC hh
  have hgu : Commute (e ⟨g, hgC⟩) u := by
    show e ⟨g, hgC⟩ * e ⟨z', hz'C⟩ = e ⟨z', hz'C⟩ * e ⟨g, hgC⟩
    rw [← map_mul, ← map_mul]
    congr 1
    exact Subtype.ext (Subgroup.mem_centralizer_iff.1 hg z' hz'E).symm
  have hhu : Commute (e ⟨h, hhC⟩) u := by
    show e ⟨h, hhC⟩ * e ⟨z', hz'C⟩ = e ⟨z', hz'C⟩ * e ⟨h, hhC⟩
    rw [← map_mul, ← map_mul]
    congr 1
    exact Subtype.ext (Subgroup.mem_centralizer_iff.1 hh z' hz'E).symm
  have hc := commute_of_commute_cubeRoot_statedSU hω3 hω1 hu3 hunc hgu hhu
  have h1 : (⟨g, hgC⟩ : C) * ⟨h, hhC⟩ = ⟨h, hhC⟩ * ⟨g, hgC⟩ := by
    apply e.injective
    rw [map_mul, map_mul]
    exact hc.eq
  exact congrArg Subtype.val h1

theorem autSolvThree_of_mulEquiv {S T : Type} [Group S] [Group T] (e : S ≃* T) (hT : AutSolvThree T) :
    AutSolvThree S := by
  intro Ē hĒ h9 Y hY
  set Ē' : Subgroup (MulAut T) := Ē.map (MulAut.congr e).toMonoidHom with hĒ'
  have hĒ'ab : IsElemAbelian 3 Ē' := CFSG.SectionRank.isElemAbelian_map hĒ _
  have h9' : 9 ≤ Nat.card Ē' := by
    rw [hĒ', Subgroup.card_map_of_injective (MulAut.congr e).injective]
    exact h9
  set Y' : Subgroup T := Y.map e.toMonoidHom with hY'
  have hYfix : ∀ y ∈ Y', ∀ ψ ∈ Ē', ψ y = y := by
    rintro _ ⟨y, hy, rfl⟩ _ ⟨ψ, hψ, rfl⟩
    simp [MulAut.congr_apply, hY y hy ψ hψ]
  haveI := hT Ē' hĒ'ab h9' Y' hYfix
  exact Group.isSolvable_of_isSolvable_injective
    (f := (Y.equivMapOfInjective e.toMonoidHom e.injective).toMonoidHom) (MulEquiv.injective _)

theorem centralizer_le_normalizer_of_subgroup {G : Type*} [Group G] (H : Subgroup G) :
    Subgroup.centralizer (H : Set G) ≤ Subgroup.normalizer (H : Set G) := by
  intro c hc
  have hcz : ∀ z ∈ H, c * z * c⁻¹ = z := fun z hz => by
    rw [← (Subgroup.mem_centralizer_iff.1 hc z hz), mul_inv_cancel_right]
  rw [Subgroup.mem_normalizer_iff]
  intro y
  constructor
  · intro hy
    rw [hcz y hy]
    exact hy
  · intro hy
    have h1 := hcz _ hy
    have h2 : c * y * c⁻¹ = y := by
      have h3 := congrArg (fun w => c⁻¹ * w * c) h1
      rw [show c⁻¹ * (c * (c * y * c⁻¹) * c⁻¹) * c = c * y * c⁻¹ by group,
        show c⁻¹ * (c * y * c⁻¹) * c = y by group] at h3
      exact h3
    rw [← h2]
    exact hy

theorem mem_of_pow_odd_of_index_two {G : Type*} [Group G] {N : Subgroup G} [N.Normal] (hN : N.index = 2)
    {g : G} {n : ℕ} (hn : Odd n) (hg : g ^ n = 1) : g ∈ N := by
  have h2 : g ^ 2 ∈ N := hN ▸ N.pow_index_mem g
  obtain ⟨m, rfl⟩ := hn
  have e : g = (g ^ 2) ^ (m + 1) := by
    rw [← pow_mul, show 2 * (m + 1) = (2 * m + 1) + 1 by ring, pow_succ, hg, one_mul]
  rw [e]
  exact N.pow_mem h2 _

theorem false_of_comm_three_seven_of_simple_6048 {T : Type} [Group T] [Finite T] [IsSimpleGroup T]
    (hcard : Nat.card T = 6048) (hnc : ∀ t b : T, orderOf t = 2 → orderOf b = 7 → t * b ≠ b * t)
    {s b : T} (hs : orderOf s = 3) (hb : orderOf b = 7) (hsb : s * b = b * s) : False := by
  haveI : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  have hbcard : Nat.card (Subgroup.zpowers b) = 7 := by rw [Nat.card_zpowers, hb]
  obtain ⟨P, hbP⟩ := (IsPGroup.of_card (p := 7) (n := 1) (by rw [hbcard, pow_one])).exists_le_sylow
  have hPcard : Nat.card (P : Subgroup T) = 7 := CFSG.Quasithin.H13.U3.GC137.SQ.card_sylow_seven hcard P
  have hPeq : (P : Subgroup T) = Subgroup.zpowers b :=
    (Subgroup.eq_of_le_of_card_ge hbP (by rw [hPcard, hbcard])).symm
  have hN := CFSG.Quasithin.H13.U3.GC137.SQ.card_normalizer_seven hcard hnc P
  set C := Subgroup.centralizer ((P : Subgroup T) : Set T) with hC
  have hCN : C ≤ Subgroup.normalizer ((P : Subgroup T) : Set T) := centralizer_le_normalizer_of_subgroup _
  have hcentP : ∀ c : T, c * b = b * c → c ∈ C := by
    intro c hc
    rw [hC, Subgroup.mem_centralizer_iff]
    intro y hy
    rw [SetLike.mem_coe, hPeq] at hy
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
    exact ((Commute.zpow_left hc.symm k)).eq
  have hbC : b ∈ C := hcentP b rfl
  have hsC : s ∈ C := hcentP s hsb
  have h7 : 7 ∣ Nat.card C := by
    have := Subgroup.orderOf_dvd_natCard C hbC
    rwa [hb] at this
  have h3 : 3 ∣ Nat.card C := by
    have := Subgroup.orderOf_dvd_natCard C hsC
    rwa [hs] at this
  have h21 : 21 ∣ Nat.card C := Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num) h3 h7
  have hN' : Nat.card ↥(Subgroup.normalizer ((P : Subgroup T) : Set T)) = 21 := hN
  have hCeq : C = Subgroup.normalizer ((P : Subgroup T) : Set T) := by
    apply Subgroup.eq_of_le_of_card_ge hCN
    rw [hN']
    exact Nat.le_of_dvd Nat.card_pos h21
  have hNC : Subgroup.normalizer ((P : Subgroup T) : Set T) ≤ Subgroup.centralizer ((P : Subgroup T) : Set T) :=
    hCeq ▸ le_refl _
  have hcompl := MonoidHom.ker_transferSylow_isComplement' P hNC
  have h1 := hcompl.card_mul_card
  rw [hPcard, hcard] at h1
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (MonoidHom.transferSylow P hNC).ker with h | h
  · rw [h, Subgroup.card_bot] at h1
    omega
  · rw [h, Subgroup.card_top, hcard] at h1
    omega

theorem isSolvable_of_card_dvd_1728 {X : Type*} [Group X] [Finite X] (h : Nat.card X ∣ 1728) :
    Group.IsSolvable X := by
  apply CFSG.LocalAnalysis.ComponentInitial.isSolvable_of_card_primeFactors_le_two
  have hsub : (Nat.card X).primeFactors ⊆ {2, 3} := by
    intro r hr
    have hrp := Nat.prime_of_mem_primeFactors hr
    have hr' : r ∣ 2 ^ 6 * 3 ^ 3 := (Nat.dvd_of_mem_primeFactors hr).trans h
    rcases (Nat.Prime.dvd_mul hrp).1 hr' with h2 | h3
    · have := (Nat.prime_dvd_prime_iff_eq hrp Nat.prime_two).1 (hrp.dvd_of_dvd_pow h2)
      simp [this]
    · have := (Nat.prime_dvd_prime_iff_eq hrp Nat.prime_three).1 (hrp.dvd_of_dvd_pow h3)
      simp [this]
  calc (Nat.card X).primeFactors.card ≤ ({2, 3} : Finset ℕ).card := Finset.card_le_card hsub
    _ = 2 := by decide

theorem isSolvable_of_card_dvd_sixtyThree {X : Type*} [Group X] [Finite X] (h : Nat.card X ∣ 63) :
    Group.IsSolvable X := by
  apply CFSG.LocalAnalysis.ComponentInitial.isSolvable_of_card_primeFactors_le_two
  have hsub : (Nat.card X).primeFactors ⊆ {3, 7} := by
    intro r hr
    have hrp := Nat.prime_of_mem_primeFactors hr
    have hr63 : r ∣ 3 ^ 2 * 7 := (Nat.dvd_of_mem_primeFactors hr).trans h
    rcases (Nat.Prime.dvd_mul hrp).1 hr63 with h9 | h7
    · have := (Nat.prime_dvd_prime_iff_eq hrp Nat.prime_three).1 (hrp.dvd_of_dvd_pow h9)
      simp [this]
    · have := (Nat.prime_dvd_prime_iff_eq hrp (by norm_num : Nat.Prime 7)).1 h7
      simp [this]
  calc (Nat.card X).primeFactors.card ≤ ({3, 7} : Finset ℕ).card := Finset.card_le_card hsub
    _ = 2 := by decide

theorem exists_cubeRoot_of_three_dvd {K : Type*} [Field K] [Finite K] (h3 : 3 ∣ Nat.card K - 1) :
    ∃ ω : K, ω ^ 3 = 1 ∧ ω ≠ 1 := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨a, ha⟩ := exists_prime_orderOf_dvd_card' (G := Kˣ) 3 (by rw [Nat.card_units]; exact h3)
  have ha3 : a ^ 3 = 1 := by rw [← ha]; exact pow_orderOf_eq_one a
  refine ⟨(a : K), by rw [← Units.val_pow_eq_pow_val, ha3, Units.val_one], fun h => ?_⟩
  have ha1 : a = 1 := Units.ext h
  rw [ha1, orderOf_one] at ha
  omega

theorem mulAutConj_injective_of_center_eq_bot {Q : Type*} [Group Q] (hZ : Subgroup.center Q = ⊥) :
    Function.Injective (MulAut.conj : Q →* MulAut Q) := by
  rw [injective_iff_map_eq_one]
  intro g hg
  have hmem : g ∈ Subgroup.center Q := by
    rw [Subgroup.mem_center_iff]
    intro y
    have h := congrArg (fun φ : MulAut Q => φ y) hg
    simp only [MulAut.conj_apply, MulAut.one_apply] at h
    calc y * g = (g * y * g⁻¹) * g := by rw [h]
      _ = g * y := by group
  rw [hZ] at hmem
  exact Subgroup.mem_bot.1 hmem

theorem isElemAbelian_comap_of_injective {G H : Type*} [Group G] [Group H] {p : ℕ} (f : G →* H)
    (hf : Function.Injective f) {U : Subgroup H} (hU : IsElemAbelian p U) :
    IsElemAbelian p (U.comap f) := by
  refine ⟨⟨⟨fun a b => ?_⟩⟩, fun x hx => ?_⟩
  · apply Subtype.ext
    apply hf
    have h := hU.1.is_comm.comm ⟨f a, a.2⟩ ⟨f b, b.2⟩
    have h' := congrArg Subtype.val h
    simpa [map_mul] using h'
  · apply hf
    rw [map_pow, map_one]
    exact hU.2 _ hx

end Plain

