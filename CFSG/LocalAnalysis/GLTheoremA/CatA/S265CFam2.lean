    have hmap : Ē₀.map (MulAut.conj : Q →* MulAut Q) = Ē := Subgroup.map_comap_eq_self hinn
    have hĒ₀ab : IsElemAbelian 3 Ē₀ := isElemAbelian_comap_of_injective _ hinj hĒ
    have hcard : Nat.card Ē₀ = Nat.card Ē := by
