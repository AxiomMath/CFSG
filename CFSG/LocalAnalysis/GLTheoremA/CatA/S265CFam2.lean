    CFSG.LocalAnalysis.GLTheoremA.HSubT.not_isMulCommutative_of_quasisimple hQI
  rcases k148_outer K148G2SimpleFact_holds K148TwoG2Fact_holds hL hchev hTD4 hNI.1 hbp hNI hI hfix
    with ⟨q, hv, hq2, hq3, ⟨eG2⟩⟩ | hU3
  ·
    exfalso
    haveI : IsSimpleGroup (PQuot 3 (Ipart 3 L b)) := by
