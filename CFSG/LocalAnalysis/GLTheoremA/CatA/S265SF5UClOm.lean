theorem false_of_classicalModel_pomega {G : Type} [Group G] [Finite G] {t : StatedLieTag}
    (ht : t = .POmegaPlus ∨ t = .POmegaMinus) {n f : ℕ} (hG : StatedClassicalModel G t n 2 f)
    {β : MulAut G} (hβ : β ∈ innAutDerived G) (hβ5 : β ^ 5 = 1) {J : Subgroup G}
    (hJ : IsComponentOf J (fixSubgroup β)) (hZ : Subgroup.center ↥J = ⊥) {e : ℕ}
    (h5 : 5 ∣ 2 ^ e + 1) (hJc : Nat.card J = ordTwistedA 4 (2 ^ e)) : False := by
  have hinner : β ∈ inner G := by
    rcases ht with rfl | rfl
    · by_cases hn5 : 5 ≤ n
      · exact CFSG.LocalAnalysis.GLTheoremA.S8.L84.ClsRed.mem_inner_of_mem_innAutDerived_omegaPlus
          hG hn5 (p := 5) (by norm_num) (by norm_num) hβ hβ5
      ·
        obtain ⟨hadm, K, _, _, -, ⟨eG⟩⟩ := hG
        have h4 : 4 ≤ n := hadm.2.2
        obtain rfl : n = 4 := by omega
        obtain ⟨φ⟩ :=
          CFSG.HardMathSupport.Lang.Coordinator.D4Bridge.nonempty_statedProj_equiv_adjointGroup K
        let θ : G ≃* adjointGroup Tag.D4 K := eG.trans φ
        obtain ⟨g, hg⟩ := exists_conj_eq_of_mem_innAutDerived_D4 (p := 5) (by norm_num)
          (by norm_num) (by norm_num) ((mem_innAutDerived_congr θ).2 hβ)
          (by rw [← map_pow, hβ5, map_one])
        have hmem : MulAut.congr θ β ∈ inner (adjointGroup Tag.D4 K) :=
          MonoidHom.mem_range.2 ⟨g, hg.symm⟩
        exact (congr_mem_inner_iff θ β).1 hmem
    · exact CFSG.LocalAnalysis.GLTheoremA.S8.L84.ClsRed.mem_inner_of_mem_innAutDerived_omegaMinus
        hG (p := 5) (by norm_num) (by norm_num) hβ hβ5
  obtain ⟨a, ha5, rfl⟩ := exists_pow_eq_one_of_mem_inner
    (CFSG.LocalAnalysis.GLTheoremA.S267.P3.OrthFix.center_eq_bot_of_orth_model (Or.inr ht) hG)
    hinner hβ5
  obtain ⟨K, _, _, V, _, _, _, Q, hQ, hT, hK, -, ⟨eG⟩⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieComp.exists_projOrth_model_card (Or.inr ht) hG
  haveI : CharP K 2 := CFSG.Timmesfeld.ClassicalOrders.charP_two_of_card_eq hK
  haveI : Nontrivial V := by
    obtain ⟨U, hU, -⟩ := hT
    exact Module.nontrivial_of_finrank_pos (R := K) (by have := Submodule.finrank_le U; omega)
  set ρ : ↥(orthDerived Q) →* ProjOrthDerived Q :=
    QuotientGroup.mk' ((scalars K V).subgroupOf (orthDerived Q))
  have hρinj : Function.Injective ρ := by
    rw [injective_iff_map_eq_one]
    intro g hg
    exact Subtype.ext (CFSG.RankThree.PartOne.eq_one_of_mem_scalars_of_mem_orthDerived hQ g.2
      (Subgroup.mem_subgroupOf.mp ((QuotientGroup.eq_one_iff g).mp hg)))
  obtain ⟨x, hxa⟩ := QuotientGroup.mk'_surjective ((scalars K V).subgroupOf (orthDerived Q)) (eG a)
  have hx5 : x ^ 5 = 1 := hρinj (by rw [map_pow, hxa, ← map_pow eG, ha5, map_one, map_one])
  have hxa' : (QuotientGroup.mk x : ProjOrthDerived Q) = eG a := hxa
  have hJ' : IsComponentOf (J.map (eG : G →* ProjOrthDerived Q))
      (Subgroup.centralizer {(QuotientGroup.mk x : ProjOrthDerived Q)}) := by
    have h1 := CFSG.SignalizerFunctorTheorem.TransportA.isComponentOf_map eG hJ
    rw [← CFSG.HardMathSupport.Solomon.Coordinator.LieComp.fixSubgroup_congr eG, congr_conj,
      CFSG.HardMathSupport.Solomon.Coordinator.LieComp.fixSubgroup_conj_eq_centralizer] at h1
    rwa [hxa']
  let eJ := J.equivMapOfInjective (eG : G →* ProjOrthDerived Q) eG.injective
  refine false_of_component_orthDerived_five hK hQ hT hx5 hJ' ?_ h5 ?_
  · rw [← Subgroup.map_center_eq eJ, hZ, Subgroup.map_bot]
  · rw [← hJc]
    exact Nat.card_congr eJ.toEquiv.symm

end CFSG.LocalAnalysis.GLTheoremA.S265.SF5U

