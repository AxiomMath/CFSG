open CFSG.Open CFSG.LocalAnalysis.ComponentInitial
open CFSG.ComponentClassification.OuterAutomorphisms (innAutDerived inner mem_innAutDerived_congr
  innAutDerived_statedSp_le_spLinearAutGroup)
open CFSG.HardMathSupport.Solomon.Coordinator (fixSubgroup)

theorem false_of_classicalModel_psp {G : Type} [Group G] [Finite G] {n f : ℕ}
    (hG : StatedClassicalModel G .PSp n 2 f) {β : MulAut G} (hβ : β ∈ innAutDerived G)
    (hβ5 : β ^ 5 = 1) (hβ1 : β ≠ 1) {J : Subgroup G} (hJ : IsComponentOf J (fixSubgroup β))
    (hZ : Subgroup.center ↥J = ⊥) {e : ℕ} (h5 : 5 ∣ 2 ^ e + 1)
    (hJc : Nat.card J = ordTwistedA 4 (2 ^ e)) : False := by
  obtain ⟨⟨-, hf, hn, hne⟩, K, _, _, hK, ⟨θ⟩⟩ := hG
  haveI : NeZero n := ⟨by omega⟩
  haveI := Fintype.ofFinite K
  haveI : CharP K 2 := charP_of_card_eq_prime_pow (by rw [← Nat.card_eq_fintype_card, hK])
  have hπ : Function.Bijective (SymplecticFlag.proj n K) :=
    UnitaryHigher.proj_bijective_of_charTwo
  have hβi : MulAut.congr θ β ∈ inner (StatedProj (StatedSp n K)) := by
    rw [← UnitaryHigher.spLinearAutGroup_eq_inner_of_charTwo]
    refine innAutDerived_statedSp_le_spLinearAutGroup hn (fun hn2 => ?_)
      ((mem_innAutDerived_congr θ).2 hβ)
    have h1 : 2 ^ f ≠ 2 := fun h => hne (by rw [hn2, h])
    have h2 : 2 ≤ 2 ^ f := Nat.le_self_pow (by omega) 2
    rw [hK]
    omega
  obtain ⟨t, ht⟩ := hβi
  obtain ⟨x, rfl⟩ := hπ.2 t
  have hx : x ^ 5 = 1 := by
    apply hπ.1
    apply CFSG.mulAutConj_injective_of_center_eq_bot
      (CFSG.LieType.SeitzGeneration.center_statedProj_statedSp_eq_bot (k := K) hn)
    rw [map_pow, map_pow, ht, ← map_pow, hβ5]
    simp only [map_one]
  have hx1 : x ≠ 1 := by
    rintro rfl
    apply hβ1
    apply (MulEquiv.map_eq_one_iff (MulAut.congr θ)).1
    rw [← ht]
    simp only [map_one]
  let eJ := J.equivMapOfInjective (θ : G →* StatedProj (StatedSp n K)) θ.injective
  refine false_of_component_statedSp_five hK hf (by omega) hx hx1
    (J := J.map (θ : G →* StatedProj (StatedSp n K))) ?_ ?_ h5 ?_
  · rw [ht, CFSG.HardMathSupport.Solomon.Coordinator.LieComp.fixSubgroup_congr θ β]
    exact CFSG.SignalizerFunctorTheorem.TransportA.isComponentOf_map θ hJ
  · rw [← Subgroup.map_center_eq eJ, hZ, Subgroup.map_bot]
  · rw [← hJc]
    exact Nat.card_congr eJ.toEquiv.symm

end CFSG.LocalAnalysis.GLTheoremA.S265.SF5U

