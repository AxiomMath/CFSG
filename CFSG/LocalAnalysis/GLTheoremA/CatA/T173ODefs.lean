@[expose] def StdExtendsN {G₀ : Type} [Group G₀] (p : ℕ) (A : Subgroup G₀) (d : G₀) : Prop :=
  (∃ T : Subgroup G₀, T ≠ ⊥ ∧ IsPGroup 2 T ∧ T ≤ stdLayer d ∧
      A = (A ⊓ stdLayer d) ⊔ (A ⊓ Subgroup.normalizer (T : Set G₀))) ∧
    ∃ y : G₀, y ∈ Subgroup.centralizer (A : Set G₀) ∧ y ∈ Subgroup.centralizer (stdLayer d : Set G₀) ∧
      y ^ p = 1 ∧ y ∉ A

@[expose] def ModelFactO (p : ℕ) (G₀ : Type) [Group G₀] [Finite G₀] : Prop :=
  ∀ (A : Subgroup G₀) (d : G₀), GLAIsBmax p A → IsStdElt p A d → StdVanishes A d ∨ StdExtendsN p A d

@[expose] def ModelFactV (p : ℕ) (G₀ : Type) [Group G₀] [Finite G₀] : Prop :=
  ∀ (A : Subgroup G₀) (d : G₀), GLAIsBmax p A → IsStdElt p A d → StdVanishes A d

@[expose] def ModelFactExcSplit (τ : Tag) : Prop :=
  ∀ (F : Type) [Field F] [Finite F] [Finite ↥(adjointGroup τ F)] (n p : ℕ), Nat.card F = 2 ^ n →
    p.Prime → p ≠ 2 → p ∣ 2 ^ n - 1 → (τ = .E6 → p ≠ 3) → ModelFactV p ↥(adjointGroup τ F)

@[expose] def ModelFactExcThree (τ : Tag) : Prop :=
  ∀ (F : Type) [Field F] [Finite F] [Finite ↥(adjointGroup τ F)], Nat.card F = 2 →
    ModelFactO 3 ↥(adjointGroup τ F)

@[expose] def I173OOn (P : GLALabel → ℕ → Prop) : Prop :=
  ∀ (p : ℕ) (Ω : Type) [Group Ω] [Finite Ω] (S B N D K : Subgroup Ω) (x : Ω) (lab : GLALabel),
    Cfg173 p S B N D K x → GLAInLambda2 lab → P lab p →
    GLAMarking S (fun lab' _ _ I _ θ => lab' = lab ∧ GLASplit16 p lab' ∧
      B ≤ Subgroup.normalizer (S : Set Ω) ∧
      ∀ b ∈ B, ∃ φ ∈ I, GLAInduces θ (fun l l' => (l' : Ω) = b⁻¹ * l * b) φ) →
    T173Concl p S B K N

@[expose] def famExcSplit (lab : GLALabel) (p : ℕ) : Prop :=
  (lab.tag = .F4 ∨ lab.tag = .E6 ∨ lab.tag = .E7 ∨ lab.tag = .E8) ∧ p ∣ 2 ^ lab.n - 1 ∧
    (lab.tag = .E6 → p ≠ 3)

@[expose] def famSpSplit (lab : GLALabel) (p : ℕ) : Prop :=
  (lab.tag = .B ∨ lab.tag = .C) ∧ 3 ≤ lab.rank ∧ p ∣ 2 ^ lab.n - 1

@[expose] def famThree (lab : GLALabel) (p : ℕ) : Prop :=
  ((lab.tag = .B ∨ lab.tag = .C) ∧ 3 ≤ lab.rank ∨
      lab.tag = .F4 ∨ lab.tag = .E6 ∨ lab.tag = .E7 ∨ lab.tag = .E8) ∧ lab.n = 1 ∧ p = 3

@[expose] def famTwE6 (lab : GLALabel) (p : ℕ) : Prop :=
  lab.tag = .twE6 ∧ p ≠ 3

@[expose] def famFive (lab : GLALabel) (p : ℕ) : Prop :=
  p = 3 ∧ (lab.tag = .E6 ∧ 3 ∣ 2 ^ lab.n - 1 ∨ lab.tag = .twE6)

