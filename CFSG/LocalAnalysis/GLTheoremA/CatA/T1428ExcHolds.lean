theorem false_of_lieModel_two_of_excIndex {R : Type} [Group R] {t : StatedLieTag} {n f : ℕ}
    (hR : CFSG.Blueprint.LieModel R t n 2 f) (h3 : 3 ∣ f) {i : TauCeti.CFSGIndex}
    (hi : excIndex i) (E : R ≃* i.Group) : False := by
  have hadm : StatedLieAdmissible t n 2 f :=
    CFSG.SeitzReduction.F4Pilot.statedLieAdmissible_of_lieModel hR
  have hform := CFSG.ComponentClassification.CatLeafProof.lieOrderFormulasInput R t n 2 f hadm hR
  haveI : Finite R := hform.1
  have hcard : Nat.card R = CFSG.SeitzReduction.F4Pilot.evenLieOrder t n f :=
    CFSG.SeitzReduction.F4Pilot.card_eq_evenLieOrder hR
  cases i with
  | cyclic p hp => simp [excIndex] at hi
  | alternating m hm =>
    have hc := CatDistinct.card_alternating_of_iso hm E
    simp only [excIndex] at hi
    rcases hi with rfl | rfl
    · exact evenLieOrder_ne_of_three_dvd hadm h3 (a := 3) (r := 45) (by decide)
        (Or.inr ⟨rfl, by decide⟩) (hcard.symm.trans (hc.trans (by decide)))
    · exact evenLieOrder_ne_of_three_dvd hadm h3 (a := 3) (r := 315) (by decide)
        (Or.inr ⟨rfl, by decide⟩) (hcard.symm.trans (hc.trans (by decide)))
  | sporadic s =>
    simp only [excIndex] at hi
    subst hi
    have hc : Nat.card R = 443520 := (Nat.card_congr E.toEquiv).trans card_group_M22
    exact evenLieOrder_ne_of_three_dvd hadm h3 (a := 7) (r := 3465) (by decide)
      (Or.inl (by decide)) (hcard.symm.trans (hc.trans (by norm_num)))
  | lie idx =>
    obtain ⟨d, hv⟩ := idx
    cases d with
    | A r q =>
      rcases r with _ | _ | _ | r <;> simp [excIndex] at hi
      have hcardq : Nat.card R = CFSG.Open.orderA 2 q.card :=
        CFSG.HardMathSupport.Solomon.Coordinator.lieOrderBridge_holds ⟨.A 2 q, hv⟩ R ⟨E⟩
      by_cases hq : q.p = 2
      ·
        have hqc : q.card = 2 ^ q.exponent := by rw [TauCeti.PrimePower.card_def, hq]
        have hqc' : q.p ^ q.exponent = 2 ^ q.exponent := by rw [hq]
        have he : CFSG.SeitzReduction.F4Pilot.evenLieOrder t n f =
            CFSG.Open.ordA 2 (2 ^ q.exponent) := by
          rw [← hcard, hcardq, hqc]
          rfl
        obtain ⟨-, ⟨-, hfk⟩ | ⟨-, hf1, -, -⟩ | ⟨-, -, h23, -⟩⟩ :=
          CFSG.SeitzReduction.LinearPilot.evenLieOrder_eq_ordA hadm le_rfl q.exponent_pos he
        · rw [hfk] at h3
          rcases two_pow_mod_nine_of_three_dvd h3 with h | h <;> omega
        · rw [hf1] at h3
          omega
        · omega
      ·
        have hadm' : StatedLieAdmissible .PSL 3 q.p q.exponent :=
          ⟨q.prime_p, q.exponent_pos, by norm_num, by simp, by simp⟩
        have hM' : Nat.card R * lieOrderDivisor .PSL 3 (q.p ^ q.exponent) =
            lieOrderNumerator .PSL 3 (q.p ^ q.exponent) := by
          refine CatDistinct.hM'_of_card hadm' ?_
          rw [hcardq]
          simp [CFSG.Open.orderA, lieOrderNumerator, lieOrderDivisor,
            TauCeti.PrimePower.card_def]
        rcases CFSG.SeitzReduction.CrossChar.crossChar_arith hadm hadm' hq hform.2.1 hM' with
          ⟨-, -, -, -, h, -⟩ | ⟨-, -, -, -, h, -⟩ | ⟨-, -, -, -, h, -⟩ <;> omega
    | twistedA r q =>
      rcases r with _ | _ | _ | r <;> simp [excIndex] at hi
      have hcardq : Nat.card R = CFSG.Open.orderTwistedA 2 q.card :=
        CFSG.HardMathSupport.Solomon.Coordinator.lieOrderBridge_holds ⟨.twistedA 2 q, hv⟩ R ⟨E⟩
      have hq3 : 3 ≤ q.card :=
        ((TauCeti.LieTypeIndex.inStandardRange_iff _).mp
          ((TauCeti.LieTypeIndex.valid_iff _).mp hv).1).2 rfl
      by_cases hq : q.p = 2
      ·
        have hqc : q.card = 2 ^ q.exponent := by rw [TauCeti.PrimePower.card_def, hq]
        have hqc' : q.p ^ q.exponent = 2 ^ q.exponent := by rw [hq]
        have hk : 2 ≤ q.exponent := by
          by_contra hk
          have h1 : q.exponent = 1 := by have := q.exponent_pos; omega
          rw [hqc, h1] at hq3
          norm_num at hq3
        have he : CFSG.SeitzReduction.F4Pilot.evenLieOrder t n f =
            CFSG.Open.ordTwistedA 2 (2 ^ q.exponent) := by
          rw [← hcard, hcardq, hqc, ordTwistedA_eq_orderTwistedA 2 _ Nat.one_le_two_pow]
        obtain ⟨-, -, hfk⟩ :=
          CFSG.LocalAnalysis.EvenBN.GMSK.TypeDet.evenLieOrder_eq_ordTwistedA_two hadm hk he
        rw [hfk] at h3
        rcases two_pow_mod_nine_of_three_dvd h3 with h | h <;> omega
      ·
        have hadm' : StatedLieAdmissible .PSU 3 q.p q.exponent := by
          refine ⟨q.prime_p, q.exponent_pos, le_rfl, ?_⟩
          intro hh
          have : q.p ^ q.exponent = 2 := (Prod.mk.inj hh).2
          have h3' : 3 ≤ q.p ^ q.exponent := by rwa [TauCeti.PrimePower.card_def] at hq3
          omega
        have hM' : Nat.card R * lieOrderDivisor .PSU 3 (q.p ^ q.exponent) =
            lieOrderNumerator .PSU 3 (q.p ^ q.exponent) := by
          refine CatDistinct.hM'_of_card hadm' ?_
          rw [hcardq]
          simp [CFSG.Open.orderTwistedA, lieOrderNumerator, lieOrderDivisor,
            TauCeti.PrimePower.card_def]
        rcases CFSG.SeitzReduction.CrossChar.crossChar_arith hadm hadm' hq hform.2.1 hM' with
          ⟨-, -, -, -, h, -⟩ | ⟨-, -, -, -, h, -⟩ | ⟨-, -, -, -, h, -⟩ <;> omega
    | _ => simp [excIndex] at hi

theorem t1428ExcFact_holds : T1428ExcFact := by
  intro H _ hcat _ hmark
  obtain ⟨lab, hlab, R, _, I, F, θ, -, -, h3, hm⟩ :=
    CFSG.StandardType.Canonical.largeEvenMarking_exists_markedModel hmark
  obtain ⟨i, hi, ⟨e⟩⟩ := hcat
  obtain ⟨tg, rk, nn⟩ := lab
  change 3 ∣ nn at h3
  by_cases hc : CFSG.StandardType.markChar ⟨tg, rk, nn⟩ = 2
  · have hR : CFSG.Blueprint.LieModel R (CFSG.StandardType.markTag ⟨tg, rk, nn⟩)
        (CFSG.StandardType.markRank ⟨tg, rk, nn⟩) 2 (CFSG.StandardType.markDeg ⟨tg, rk, nn⟩) := by
      have h : CFSG.Blueprint.LieModel R (CFSG.StandardType.markTag ⟨tg, rk, nn⟩)
          (CFSG.StandardType.markRank ⟨tg, rk, nn⟩) (CFSG.StandardType.markChar ⟨tg, rk, nn⟩)
          (CFSG.StandardType.markDeg ⟨tg, rk, nn⟩) := hm
      rw [hc] at h
      exact h
    have hdeg : 3 ∣ CFSG.StandardType.markDeg ⟨tg, rk, nn⟩ := by
      cases tg
      case twD =>
        show 3 ∣ (if rk = 2 then 2 * nn else nn)
        split_ifs
        · exact Dvd.dvd.mul_left h3 2
        · exact h3
      case B2der => simp [CFSG.StandardType.markChar] at hc
      case G2der => simp [CFSG.StandardType.markChar] at hc
      all_goals exact h3
    exact false_of_lieModel_two_of_excIndex hR hdeg hi (θ.symm.trans e)
  ·
    have hn : nn = 1 := by
      cases tg
      case B2der => exact hlab.2.2
      case G2der => exact hlab.2.2
      all_goals exact (hc rfl).elim
    omega

end Main

