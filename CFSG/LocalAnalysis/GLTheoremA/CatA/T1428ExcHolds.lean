theorem two_pow_mod_nine_of_three_dvd {k : ℕ} (h : 3 ∣ k) : 2 ^ k % 9 = 1 ∨ 2 ^ k % 9 = 8 := by
  obtain ⟨m, rfl⟩ := h
  induction m with
  | zero => left; rfl
  | succ m ih =>
    have h8 : 2 ^ (3 * (m + 1)) = 2 ^ (3 * m) * 8 := by
      rw [mul_add, mul_one, pow_add]
      norm_num
    rw [h8]
    omega

theorem ordTwistedA_eq_orderTwistedA (n Q : ℕ) (hQ : 1 ≤ Q) :
    CFSG.Open.ordTwistedA n Q = CFSG.Open.orderTwistedA n Q := by
  unfold CFSG.Open.ordTwistedA CFSG.Open.orderTwistedA
  congr 2
  refine Finset.prod_congr rfl fun i _ => ?_
  have h1 : 1 ≤ Q ^ i := Nat.one_le_pow _ _ hQ
  have hc : ((Q ^ i : ℕ) : ℤ) = (Q : ℤ) ^ i := Nat.cast_pow Q i
  rcases Nat.even_or_odd i with hi | hi
  · rw [if_pos hi, hi.neg_one_pow]
    omega
  · rw [if_neg (Nat.not_even_iff_odd.2 hi), hi.neg_one_pow]
    omega

theorem evenLieOrder_ne_of_three_dvd {t : StatedLieTag} {n f a r : ℕ}
    (hadm : StatedLieAdmissible t n 2 f) (h3 : 3 ∣ f) (hr : Odd r)
    (ha : ¬ 3 ∣ a ∨ (a = 3 ∧ r ≠ 63)) :
    CFSG.SeitzReduction.F4Pilot.evenLieOrder t n f ≠ 2 ^ a * r := by
  have hf : 1 ≤ f := hadm.2.1
  have hf3 : 3 ≤ f := Nat.le_of_dvd (by omega) h3
  have key : ∀ N : ℕ, 2 ≤ N → f * N ≠ a := by
    intro N hN hfa
    rcases ha with ha | ⟨rfl, -⟩
    · exact ha (hfa ▸ dvd_mul_of_dvd_left h3 N)
    · nlinarith
  cases t with
  | PSL =>
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by have := hadm.2.2.1; omega⟩
    have hm : 1 ≤ m := by have := hadm.2.2.1; omega
    show CFSG.Open.ordA (m + 1 - 1) (2 ^ f) ≠ _
    rw [Nat.add_sub_cancel]
    by_cases h18 : m = 1 ∧ f = 3
    · obtain ⟨rfl, rfl⟩ := h18
      intro h
      have h504 : CFSG.Open.ordA 1 (2 ^ 3) = 2 ^ 3 * 63 := by decide
      rw [h504] at h
      have hae := eq_of_two_pow_mul_odd (by decide : Odd 63) hr h
      subst hae
      have hr63 : r = 63 := by
        have h' := h
        norm_num at h'
        omega
      rcases ha with ha | ⟨-, ha⟩
      · exact ha dvd_rfl
      · exact ha hr63
    · refine (profile_ordA hm hf).ne_of_ne hr fun hN => ?_
      rcases (show m = 1 ∨ 2 ≤ m by omega) with rfl | hm2
      · have hf' : f ≠ 3 := fun h => h18 ⟨rfl, h⟩
        have hfa : f = a := by simpa using hN
        subst hfa
        rcases ha with ha | ⟨ha, -⟩
        · exact ha h3
        · exact hf' ha
      · have h3m : 3 ≤ m * (m + 1) / 2 := by
          have : 6 ≤ m * (m + 1) := by nlinarith
          omega
        exact key _ (by omega) hN
  | PSU =>
    obtain ⟨-, -, hn, -⟩ := hadm
    show CFSG.Open.ordTwistedA (n - 1) (2 ^ f) ≠ _
    refine (profile_ordTwistedA (by omega) hf).ne_of_ne hr fun hN => key _ ?_ hN
    have : 6 ≤ (n - 1) * (n - 1 + 1) := by
      have : 2 ≤ n - 1 := by omega
      nlinarith
    omega
  | PSp =>
    obtain ⟨-, -, hn, -⟩ := hadm
    show CFSG.Open.ordBC n (2 ^ f) ≠ _
    exact (profile_ordBC hf).ne_of_ne hr fun hN => key _ (by nlinarith) hN
  | POmegaOdd => exact absurd rfl hadm.2.2.2
  | POmegaPlus =>
    have hn : 4 ≤ n := hadm.2.2
    show CFSG.Open.ordD n (2 ^ f) ≠ _
    refine (profile_ordD (by omega) hf).ne_of_ne hr fun hN => key _ ?_ hN
    have : 3 ≤ n - 1 := by omega
    nlinarith
  | POmegaMinus =>
    have hn : 4 ≤ n := hadm.2.2
    show CFSG.Open.ordTwistedD n (2 ^ f) ≠ _
    refine (profile_ordTwistedD (by omega) hf).ne_of_ne hr fun hN => key _ ?_ hN
    have : 3 ≤ n - 1 := by omega
    nlinarith
  | F4 => exact (profile_ordF4' hf).ne_of_ne hr (key 24 (by norm_num))
  | E6 => exact (profile_ordE6' hf).ne_of_ne hr (key 36 (by norm_num))
  | E7 => exact (profile_ordE7' hf).ne_of_ne hr (key 63 (by norm_num))
  | E8 => exact (profile_ordE8' hf).ne_of_ne hr (key 120 (by norm_num))
  | twistedE6 => exact (profile_ordTwistedE6' hf).ne_of_ne hr (key 36 (by norm_num))
  | G2 => exact (profile_ordG2' hf).ne_of_ne hr (key 6 (by norm_num))
  | trialityD4 => exact (profile_ordTrialityD4' hf).ne_of_ne hr (key 12 (by norm_num))
  | twistedB2 => exact (profile_ordSuzuki' hf).ne_of_ne hr (key 2 le_rfl)
  | twistedG2 => exact absurd hadm.2.2.2.1 (by norm_num)
  | twistedF4 => exact (profile_ordTwistedF4' hf).ne_of_ne hr (key 12 (by norm_num))
  | Tits =>
    have : f = 1 := hadm.2.2.2.2
    omega

theorem card_group_M22 :
    Nat.card (TauCeti.CFSGIndex.sporadic TauCeti.SporadicName.M22).Group = 443520 := by
  obtain ⟨-, hle⟩ := CFSG.Sporadic.Bridge.M22.tauCeti_finite_card_le
  obtain ⟨e⟩ := CFSG.Sporadic.Bridge.M22.nonempty_mulEquiv
  exact le_antisymm hle
    (CFSG.Sporadic.Bridge.M22.le_card_native.trans_eq (Nat.card_congr e.toEquiv))

