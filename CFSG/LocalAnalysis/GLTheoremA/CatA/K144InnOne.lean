section InnOne


theorem canon_of_trivial (hRig : GGLabelRigidInput) {S : Type} [Group S] [Finite S]
    (hcen : Subgroup.center S = ⊥) {labK : GLALabel}
    (hlab : HasLabel S (fun l : GLALabel => l = labK)) {Jb : Subgroup S}
    (hJ : GLAPComponent 3 (fixSubgroup (1 : MulAut S)) Jb)
    (hcat : catalogIs (PSimple 3 Jb) I144Cat) :
    (canonLabel labK).n = 1 ∧ ((canonLabel labK).tag = .twA ∨ (canonLabel labK).tag = .B) := by
  have hq : CFSG.Open.IsQuasisimple S := Y10F.hasLabel_isQuasisimple hlab
  haveI : IsSimpleGroup (S ⧸ Subgroup.center S) := hq.2
  haveI : IsSimpleGroup S := (CanonInn.quotCenterEquivOfBot hcen).symm.isSimpleGroup
  have hfix : fixSubgroup (1 : MulAut S) = ⊤ := by
    ext x
    simp [mem_fixSubgroup]
  have hJtop : Jb = ⊤ := by
    have hJ' : GLAPComponent 3 (⊤ : Subgroup S) Jb := by
      rw [← hfix]
      exact hJ
    obtain ⟨-, hsn, -, -⟩ := id hJ'
    rcases CFSG.Open.IsSubnormal.eq_bot_or_eq_of_isSimpleGroup hsn
      (Subgroup.topEquiv.isSimpleGroup) with hbot | htop
    · exact absurd hbot (CFSG.LocalAnalysis.GLTheoremA.glaPComponent_ne_bot' hJ')
    · exact htop
  have e : ↥Jb ≃* S := (MulEquiv.subgroupCongr hJtop).trans Subgroup.topEquiv
  have hlabJ : HasLabel ↥Jb (fun l : GLALabel => l = labK) :=
    (Y10F.hasLabel_congr e (fun l : GLALabel => l = labK)).2 hlab
  have hqJ : CFSG.Open.IsQuasisimple ↥Jb := Y10F.hasLabel_isQuasisimple hlabJ
  obtain ⟨eA⟩ := chev2_quot_equiv Nat.prime_three hJ hqJ
  have eB : ↥Jb ⧸ Subgroup.center ↥Jb ≃* S ⧸ Subgroup.center S :=
    QuotientGroup.congr (Subgroup.center ↥Jb) (Subgroup.center S) e
      (Subgroup.map_center_eq e)
  have hcatJ : catalogIs (↥Jb ⧸ Subgroup.center ↥Jb) I144Cat :=
    (catalogIs_congr eA.symm).1 hcat
  have hcatS : catalogIs (S ⧸ Subgroup.center S) I144Cat :=
    (catalogIs_congr eB).1 hcatJ
  obtain ⟨lab, hlabS, hn1, htag⟩ := exists_label_of_catalog hq hcatS
  have hcanon : canonLabel labK = canonLabel lab :=
    Y10GInnExcLabel.canonLabel_eq_of_hasLabel hRig hlab hlabS
  exact ⟨by rw [hcanon]; exact hn1, by rw [hcanon]; exact htag⟩

end InnOne

end CFSG.LocalAnalysis.GLTheoremA.K144
