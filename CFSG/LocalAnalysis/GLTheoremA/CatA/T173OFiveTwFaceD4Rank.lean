private theorem one_le_of_card_sq {F : Type} [Field F] [Finite F] {n : ℕ}
    (hF : Nat.card F = (2 ^ n) ^ 2) : 1 ≤ n := by
  rcases Nat.eq_zero_or_pos n with h0 | h0
  · subst h0
    have h1 : Nat.card F = 1 := by simpa using hF
    exact absurd h1 (Finite.one_lt_card (α := F)).ne'
  · exact h0

theorem twistedE6DiagGL_commute {F : Type} [Field F] (σ : F ≃+* F) {x y : Γ₂ F}
    (hx : x ∈ twistedE6DiagGL F σ) (hy : y ∈ twistedE6DiagGL F σ) : x * y = y * x := by
  obtain ⟨u, rfl⟩ := hx
  obtain ⟨v, rfl⟩ := hy
  change rootDiagUnit TwistTag.E6.tag _ * rootDiagUnit TwistTag.E6.tag _ =
    rootDiagUnit TwistTag.E6.tag _ * rootDiagUnit TwistTag.E6.tag _
  rw [← rootDiagUnit_mul, ← rootDiagUnit_mul, mul_comm]

private theorem units_map_eq_inv_of_pow_three {F : Type} [Field F] {n : ℕ}
    (σ : F ≃+* F) (hσ : ∀ c, σ c = c ^ 2 ^ n) (h3 : 3 ∣ 2 ^ n + 1) {ν : Fˣ}
    (hν3 : ν ^ 3 = 1) : Units.map σ.toRingHom.toMonoidHom ν = ν⁻¹ := by
  obtain ⟨k, hk⟩ : ∃ k, 2 ^ n = 3 * k + 2 := by
    have hdiv := Nat.mod_add_div (2 ^ n) 3
    have hmod : 2 ^ n % 3 = 2 := by
      have h := Nat.mod_eq_zero_of_dvd h3
      omega
    exact ⟨2 ^ n / 3, by omega⟩
  have hν3' : (ν : F) ^ 3 = 1 := by simpa using congrArg Units.val hν3
  have hsq : Units.map σ.toRingHom.toMonoidHom ν = ν ^ 2 := by
    apply Units.ext
    simp only [Units.coe_map, Units.val_pow_eq_pow_val]
    change σ (ν : F) = (ν : F) ^ 2
    rw [hσ, hk, pow_add, pow_mul, hν3', one_pow, one_mul]
  rw [hsq, eq_inv_iff_mul_eq_one, ← pow_succ, hν3]

theorem levi_sup_diag_le_eqLocus {F : Type} [Field F] (σ : F ≃+* F)
    (J : Set (Fin TwistTag.E6.foldedTag.rank)) :
    graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom J ⊔ twistedE6DiagGL F σ ≤
      MonoidHom.eqLocus (twistHom TwistTag.E6 F σ.toRingHom) (MonoidHom.id _) := by
  refine sup_le (fun g hg => ?_) ?_
  · exact ((mem_twistedFixedGroup_iff_twistHom _ _ _).1 (graphFixedRootGroup_le _ _ _
      (graphFixedParabolicLevi_le (t := TwistTag.E6) (K := F) (σ := σ.toRingHom) (J := J)
        hg))).2
  · rintro _ ⟨u, rfl⟩
    exact twistHom_rootDiagUnit (compatDiag_perm u)

private theorem levi_sup_diag_D4_le_d4CentralTorus_sup {F : Type} [Field F] [Finite F] {n : ℕ}
    (hF : Nat.card F = (2 ^ n) ^ 2) (σ : F ≃+* F) :
    graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxD4 ⊔ twistedE6DiagGL F σ ≤
      d4CentralTorus F ⊔ subsystemGroup Tag.E6 F setD := by
  have h2 : (2 : F) = 0 := E6GraphLevi.two_eq_zero_of_card_sq (one_le_of_card_sq hF) hF
  have hsq := E6GraphLevi.exists_sq_eq_of_two h2
  have hMA : parabolicLevi TwistTag.E6.tag F (TwistTag.E6.orbitUnion twE6MaxD4) =
      torusGroup TwistTag.E6.tag F ⊔
        subsystemGroup TwistTag.E6.tag F
          {i : Fin TwistTag.E6.tag.rank | i.val ≠ 0 ∧ i.val ≠ 5} := by
    rw [orbitUnion_twE6MaxD4]
    rfl
  refine sup_le ?_ ?_
  · refine (inf_le_left : graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxD4 ≤ _).trans ?_
    rw [hMA]
    refine sup_le (torusGroup_le_d4CentralTorus_sup hsq) (le_sup_of_le_right ?_)
    have hsub : ∀ i : Fin 6, (i.val ≠ 0 ∧ i.val ≠ 5) → i ∈ setD := by
      intro i hi
      fin_cases i <;> simp_all [setD]
    exact Subgroup.closure_mono fun _ ⟨j, hj, c, hc⟩ => ⟨j, hsub j hj, c, hc⟩
  · rintro _ ⟨u, rfl⟩
    exact rootDiagUnit_mem_d4CentralTorus_sup hsq _

private theorem mem_d4AntiTorus_sup_of_pow_three {F : Type} [Field F] [Finite F] {n : ℕ}
    (hF : Nat.card F = (2 ^ n) ^ 2) (σ : F ≃+* F) (hσ : ∀ c, σ c = c ^ 2 ^ n)
    (h3 : 3 ∣ 2 ^ n + 1) {g : Γ₂ F}
    (hg : g ∈ graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxD4 ⊔
      twistedE6DiagGL F σ)
    (hg3 : g ^ 3 = 1) : g ∈ d4AntiTorus F ⊔ subsystemGroup Tag.E6 F setD := by
  have hn := one_le_of_card_sq hF
  haveI : CharP F 2 := charP_two_of_card hn hF
  haveI : IsSimpleGroup (subsystemGroup Tag.E6 F setD) := isSimpleGroup_d4Levi (K := F)
  haveI : Group.IsPerfect (subsystemGroup Tag.E6 F setD) := isPerfect_d4Levi (K := F)
  have hZD : d4CentralTorus F ⊓ subsystemGroup Tag.E6 F setD = ⊥ := d4CentralTorus_inf_d4Levi
  have hZc : d4CentralTorus F ≤
      Subgroup.centralizer (subsystemGroup Tag.E6 F setD : Set (ModGL Tag.E6 F)) :=
    d4CentralTorus_le_centralizer
  have hgF : twistHom TwistTag.E6 F σ.toRingHom g = g :=
    levi_sup_diag_le_eqLocus σ twE6MaxD4 hg
  obtain ⟨⟨z, l⟩, ⟨hz, hl, hzl⟩, -⟩ := E6GraphLevi.existsUnique_mul_of_commute hZD
    (fun z hz l hl => (Subgroup.mem_centralizer_iff.1 (hZc hz) l hl).symm) g
    (levi_sup_diag_D4_le_d4CentralTorus_sup hF σ hg)
  dsimp only at hz hl hzl
  have hfix := twistHom_eq_and_eq_of_mul (t := TwistTag.E6) (σ := σ.toRingHom) hZD hz hl
    (twistHom_mem_d4CentralTorus σ.toRingHom hz) (d4F_mem_d4Levi σ.toRingHom hl) hzl hgF
  have hcomm : Commute z l := (Subgroup.mem_centralizer_iff.1 (hZc hz) l hl).symm
  have hz3 : z ^ 3 = 1 := by
    have h33 : z ^ 3 * l ^ 3 = 1 := by
      rw [← hcomm.mul_pow, ← hzl]
      exact hg3
    have hmem : z ^ 3 ∈ d4CentralTorus F ⊓ subsystemGroup Tag.E6 F setD := by
      refine Subgroup.mem_inf.2 ⟨pow_mem hz 3, ?_⟩
      rw [eq_inv_of_mul_eq_one_left h33]
      exact Subgroup.inv_mem _ (Subgroup.pow_mem _ hl 3)
    rw [hZD] at hmem
    exact hmem
  obtain ⟨μ, ν, rfl⟩ := mem_d4CentralTorus.1 hz
  have hb := CFSG.LieType.Chevalley.rootDiagUnit_injective
    ((twistHom_rootDiagUnit_d4CentralDiag σ.toRingHom μ ν).symm.trans hfix.1)
  have h0 : Units.map σ.toRingHom.toMonoidHom ν = μ := by
    have := congrFun hb 0
    rwa [d4CentralDiag_apply_zero, d4CentralDiag_apply_zero] at this
  have hν3 : ν ^ 3 = 1 := by
    have hz3' : rootDiagUnitHom Tag.E6 F (d4CentralDiag μ ν) ^ 3 = 1 := hz3
    rw [← map_pow, d4CentralDiag_pow] at hz3'
    have := congrFun (CFSG.LieType.Chevalley.rootDiagUnit_injective
      (hz3'.trans rootDiagUnit_one.symm)) 5
    rwa [d4CentralDiag_apply_five] at this
  rw [hzl]
  refine Subgroup.mul_mem_sup (mem_d4AntiTorus.2 ⟨ν⁻¹, ?_⟩) hl
  rw [inv_inv, ← h0, units_map_eq_inv_of_pow_three σ hσ h3 hν3]

