theorem card_le_pow_four_of_le_levi_sup_diag_D4 {F : Type} [Field F] [Finite F] {n : ℕ}
    (hF : Nat.card F = (2 ^ n) ^ 2) (σ : F ≃+* F) (hσ : ∀ c, σ c = c ^ 2 ^ n)
    (h3 : 3 ∣ 2 ^ n + 1) {E : Subgroup (Γ₂ F)}
    (hE : E ≤ graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxD4 ⊔
      twistedE6DiagGL F σ)
    (hEel : IsElemAbelian 3 E) : Nat.card E ≤ 3 ^ 4 := by
  have hEC : E ≤ d4AntiTorus F ⊔ subsystemGroup Tag.E6 F setD := fun g hg =>
    mem_d4AntiTorus_sup_of_pow_three hF σ hσ h3 (hE hg) (hEel.2 g hg)
  have hbound := card_le_mul_card_inf_of_le_sup_cyclic Nat.prime_three
    (isCyclic_d4AntiTorus F) (d4AntiTorus_le_normalizer F) hEC hEel
  have hL : omegaMinusLevi (σ : F →+* F) =
      subsystemGroup TwistTag.E6.tag F setD ⊓ twistedFixedGroup TwistTag.E6 F (σ : F →+* F) :=
    omegaMinusLevi_eq_of_card (one_le_of_card_sq hF) hF (σ := (σ : F →+* F)) fun c => hσ c
  let E' : Subgroup (Γ₂ F) := E ⊓ subsystemGroup Tag.E6 F setD
  have hE'le : E' ≤ omegaMinusLevi (σ : F →+* F) := by
    intro x hx
    rw [hL]
    exact ⟨hx.2, (mem_twistedFixedGroup_iff_twistHom _ _ _).2
      ⟨d4Levi_le_adjointGroup hx.2, levi_sup_diag_le_eqLocus σ twE6MaxD4 (hE hx.1)⟩⟩
  have hE'el : IsElemAbelian 3 E' := hEel.mono inf_le_left
  have hpr3 := pRank_omegaMinusLevi_le_three hF σ hσ Nat.prime_three (by norm_num) h3
  let A : Subgroup (omegaMinusLevi (σ : F →+* F)) := E'.subgroupOf _
  have hAel : IsElemAbelian 3 A := hE'el.comap (Subgroup.subtype_injective _)
  have hAcard : Nat.card A = Nat.card E' :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hE'le).toEquiv
  have hA3 : Nat.card A ≤ 3 ^ 3 :=
    (CFSG.RankThree.OddKernel.card_le_pow_pRank_of_le Nat.prime_three hAel le_top).trans
      (Nat.pow_le_pow_right (by norm_num) hpr3)
  calc Nat.card E ≤ 3 * Nat.card E' := hbound
    _ = 3 * Nat.card A := by rw [hAcard]
    _ ≤ 3 * 3 ^ 3 := Nat.mul_le_mul_left 3 hA3
    _ = 3 ^ 4 := by norm_num

theorem mem_of_le_levi_sup_diag_D4_of_card {F : Type} [Field F] [Finite F] {n : ℕ}
    (hF : Nat.card F = (2 ^ n) ^ 2) (σ : F ≃+* F) (hσ : ∀ c, σ c = c ^ 2 ^ n)
    (h3 : 3 ∣ 2 ^ n + 1) {z : Γ₂ F} (hzT : z ∈ twistedE6DiagGL F σ) (hz3 : z ^ 3 = 1)
    (hzC : z ∈ Subgroup.centralizer
      (graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxD4 : Set (Γ₂ F)))
    {E : Subgroup (Γ₂ F)}
    (hE : E ≤ graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxD4 ⊔
      twistedE6DiagGL F σ)
    (hEel : IsElemAbelian 3 E) (hE4 : 3 ^ 4 ≤ Nat.card E) : z ∈ E := by
  have hcen : graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxD4 ⊔
      twistedE6DiagGL F σ ≤ Subgroup.centralizer ({z} : Set (Γ₂ F)) := by
    refine sup_le (fun y hy => ?_) (fun y hy => ?_)
    · rw [Subgroup.mem_centralizer_singleton_iff]
      exact Subgroup.mem_centralizer_iff.1 hzC y hy
    · rw [Subgroup.mem_centralizer_singleton_iff]
      exact twistedE6DiagGL_commute σ hy hzT
  have hE₁el : IsElemAbelian 3 (E ⊔ Subgroup.zpowers z) :=
    hEel.sup_of_commute (CFSG.Open.isElemAbelian_zpowers hz3) fun a ha b hb => by
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hb
      exact (Commute.zpow_right
        (Subgroup.mem_centralizer_singleton_iff.1 (hcen (hE ha))) k).eq
  have hE₁le : E ⊔ Subgroup.zpowers z ≤
      graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxD4 ⊔ twistedE6DiagGL F σ :=
    sup_le hE ((Subgroup.zpowers_le).2 (Subgroup.mem_sup_right hzT))
  have hcard := card_le_pow_four_of_le_levi_sup_diag_D4 hF σ hσ h3 hE₁le hE₁el
  have hEE : E = E ⊔ Subgroup.zpowers z :=
    Subgroup.eq_of_le_of_card_ge le_sup_left (hcard.trans hE4)
  rw [hEE]
  exact Subgroup.mem_sup_right (Subgroup.mem_zpowers z)

end RankBound

