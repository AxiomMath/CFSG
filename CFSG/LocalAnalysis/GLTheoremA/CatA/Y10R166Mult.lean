  have hA : r ∣ q ^ (6 * (6 - 1) / 2) * ∏ i ∈ Finset.Icc 2 6,
      ((((q : ℕ) : ℤ) ^ i - (-1 : ℤ) ^ i).toNat) := Dvd.dvd.mul_left hprod2 _
  have hq13 : q + 1 ∣ q ^ 3 + 1 :=
    CFSG.Timmesfeld.Orders.add_one_dvd_pow_add_one q (by decide : Odd 3)
  have hgq : g ∣ q + 1 := by rw [hgdef]; exact Nat.gcd_dvd_right 6 (q + 1)
  have hfac3 : g ∣ ((((q : ℕ) : ℤ) ^ 3 - (-1 : ℤ) ^ 3).toNat) := by
    rw [toNat_cube_add_one]; exact hgq.trans hq13
  have hmem3 : (3 : ℕ) ∈ Finset.Icc 2 6 := Finset.mem_Icc.mpr ⟨by norm_num, by norm_num⟩
  have hprod3 : g ∣ ∏ i ∈ Finset.Icc 2 6,
      ((((q : ℕ) : ℤ) ^ i - (-1 : ℤ) ^ i).toNat) :=
    dvd_trans hfac3 (Finset.dvd_prod_of_mem _ hmem3)
  have hgA : g ∣ q ^ (6 * (6 - 1) / 2) * ∏ i ∈ Finset.Icc 2 6,
      ((((q : ℕ) : ℤ) ^ i - (-1 : ℤ) ^ i).toNat) := Dvd.dvd.mul_left hprod3 _
  have hgodd : Odd g := Odd.of_dvd_nat hqodd hgq
  by_cases h3 : 3 ∣ q + 1
  · have hg3eq : g = 3 := by
      have hg6 : g ∣ 6 := by rw [hgdef]; exact Nat.gcd_dvd_left 6 (q + 1)
      have hg3 : g ∣ 3 := by
        have hcop : Nat.Coprime g 2 := Nat.coprime_two_left.mpr hgodd |>.symm
        have hg23 : g ∣ 2 * 3 := by
          rw [← show (6 : ℕ) = 2 * 3 by norm_num]
          exact hg6
        exact hcop.dvd_of_dvd_mul_left hg23
      exact Nat.dvd_antisymm hg3 (Nat.dvd_gcd (by norm_num) h3)
    rw [hg3eq] at hgA ⊢
    by_cases hr3 : r = 3
    · subst hr3
      refine dvd_div_self_of_sq_dvd (by decide : Nat.Prime 3) ?_
      have hf2_3 : 3 ∣ (((q : ℕ) : ℤ) ^ 2 - (-1 : ℤ) ^ 2).toNat := by
        rw [h2eq]; exact hdvd
      have hf3_3 : 3 ∣ (((q : ℕ) : ℤ) ^ 3 - (-1 : ℤ) ^ 3).toNat := by
        rw [toNat_cube_add_one]; exact h3.trans hq13
      have h9 : 9 ∣ (((q : ℕ) : ℤ) ^ 2 - (-1 : ℤ) ^ 2).toNat *
          ((((q : ℕ) : ℤ) ^ 3 - (-1 : ℤ) ^ 3).toNat) := by
        simpa using mul_dvd_mul hf2_3 hf3_3
      have hsub : ({2, 3} : Finset ℕ) ⊆ Finset.Icc 2 6 := by
        intro i hi
        simp only [Finset.mem_insert, Finset.mem_singleton] at hi
        rcases hi with rfl | rfl <;> simp
      have hprod9 : 9 ∣ ∏ i ∈ Finset.Icc 2 6,
          ((((q : ℕ) : ℤ) ^ i - (-1 : ℤ) ^ i).toNat) := by
        refine dvd_trans ?_ (Finset.prod_dvd_prod_of_subset ({2, 3} : Finset ℕ)
          (Finset.Icc 2 6) (fun i => ((((q : ℕ) : ℤ) ^ i - (-1 : ℤ) ^ i).toNat)) hsub)
        simpa using h9
      exact Dvd.dvd.mul_left hprod9 _
    · have hcop : Nat.Coprime r 3 := (hr.coprime_iff_not_dvd).2 fun hd => hr3
        ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_three).1 hd)
      exact dvd_div_of_dvd_of_coprime hr hA hgA hcop
  · have hg1 : g = 1 := by
      have hg6 : g ∣ 6 := by rw [hgdef]; exact Nat.gcd_dvd_left 6 (q + 1)
      have hcop : Nat.Coprime g 3 := (Nat.prime_three.coprime_iff_not_dvd).2
        (fun hd => h3 (hd.trans hgq)) |>.symm
      have hg2 : g ∣ 2 := by
        have hg32 : g ∣ 3 * 2 := by
          rw [← show (6 : ℕ) = 3 * 2 by norm_num]
          exact hg6
        exact hcop.dvd_of_dvd_mul_left hg32
      rcases (Nat.dvd_prime Nat.prime_two).1 hg2 with h1 | h1
      · exact h1
      · exfalso
        rw [h1] at hgodd
        exact (Nat.not_odd_iff_even.mpr (by decide : Even 2)) hgodd
    rw [hg1, Nat.div_one]
    exact hA

theorem linear_twoRank {J : Type} [Group J] [Finite J] {r n : ℕ}
    (hr : 1 ≤ r) (hn : 1 ≤ n) (hodd : Odd (Nat.card (Subgroup.center J)))
    (h : HasLabel J (· = ⟨.A, r, n⟩)) :
    n * ((r + 1) ^ 2 / 4) ≤ twoRank J := by
  have hraw := rk2IsLabel_rawDatum h
  dsimp only [GLARawDatum, CFSG.Assembly.LargeEvenRawDatum,
    CFSG.Assembly.LargeEvenRecipeLinear] at hraw
  obtain ⟨K, hf, hfin, hK, hQ⟩ := hraw
  obtain ⟨hsR, hna, ⟨θ⟩⟩ := hQ
  haveI : Finite (LargeEvenProj (LargeEvenSLGroup (Fin (r + 1)) K)) :=
    Finite.of_equiv _ θ.toEquiv
  rw [twoRank_eq_pRank_centerQuot_of_odd hodd, ← pRank_top_congr θ]
  have h' := pRank_unipProj_ge (K := K) (d := r + 1) (k := (r + 1) / 2) (n := n)
    (by omega) (by omega) hn hK
  rw [← sq_div_four_eq] at h'
  simpa using h'

