    p * q ∣ Nat.card (J ⧸ Subgroup.center J) := by
  have hcop : Nat.Coprime p q := by
    refine (hp.coprime_iff_not_dvd).2 ?_
    intro hd
    exact hpq ((Nat.prime_dvd_prime_iff_eq hp hq).1 hd)
  exact hcop.mul_dvd_of_dvd_of_dvd (h p hp hp2 hpd) (h q hq hq2 hqd)


theorem linearDThree_mult {J : Type} [Group J] [Finite J] {n : ℕ} (hn : 2 ≤ n)
    (h : HasLabel J (· = ⟨.D, 3, n⟩)) (hGA : CFSG.Open.GriessAllModelsStatement) :
    (Subgroup.center J = ⊥ ∧ TrivialMultiplierT J) ∧
      Odd (Nat.card (Subgroup.center J)) ∧
      4 * n ≤ twoRank J ∧
      (∀ r : ℕ, r.Prime → r ≠ 2 → r ∣ 2 ^ (2 * n) - 1 →
        r ∣ Nat.card (J ⧸ Subgroup.center J)) := by
  obtain ⟨hQ, hlab, hM⟩ :=
    quasisimple_markedModel_of_isLabel (K := J) (lab := ⟨.D, 3, n⟩) h
  have hM' : CFSG.Blueprint.LieModel (J ⧸ Subgroup.center J) .PSL 4 2 n := by
    simpa [CFSG.StandardType.MarkedModel, CFSG.StandardType.markTag,
      CFSG.StandardType.markRank, CFSG.StandardType.markChar,
      CFSG.StandardType.markDeg] using hM
  have hm : CFSG.Models.LieModel (J ⧸ Subgroup.center J) .PSL 4 2 n :=
    CFSG.Models.LieModel.of_blueprint_of_ne_zero (by omega) hM'
  have hodd2n : Odd (2 ^ n - 1) := by
    have h' := CFSG.Timmesfeld.ClassicalOrders.odd_two_pow_pow_sub_one (f := 1) (n := n)
      (by norm_num) (by omega)
    simpa using h'
  have hcop : Nat.Coprime 4 (2 ^ n - 1) := by
    have h1 : Nat.Coprime 2 (2 ^ n - 1) := Nat.coprime_two_left.mpr hodd2n
    simpa using h1.pow_left 2
  have hgcd : Nat.gcd 4 (2 ^ n - 1) = 1 := Nat.coprime_iff_gcd_eq_one.mp hcop
  have hn1 : n ≠ 1 := by omega
  have h1 : Nat.card (CFSG.Blueprint.Multiplier.generic .PSL 4 2 n ×
      CFSG.Blueprint.Multiplier.exceptional .PSL 4 2 n) = 1 := by
    simp [CFSG.Blueprint.Multiplier.generic, CFSG.Blueprint.Multiplier.exceptional,
      CFSG.Blueprint.Multiplier.genericOrders, CFSG.Blueprint.Multiplier.exceptionalOrders,
      Nat.card_prod, ZMod.card, hn1, hgcd]
  have hsix := center_eq_bot_and_trivialMultiplierT_of_quotient_center hQ.1.commutator_eq_top
    (trivialMultiplierT_of_lieModel hGA hm h1)
  have hodd : Odd (Nat.card (Subgroup.center J)) := by rw [hsix.1]; simp
  have hm2 : 4 * n ≤ twoRank J := by
    have hraw := rk2IsLabel_rawDatum h
    dsimp only [GLARawDatum, CFSG.Assembly.LargeEvenRawDatum] at hraw
    rw [if_pos rfl] at hraw
    dsimp only [CFSG.Assembly.LargeEvenRecipeLinear] at hraw
    obtain ⟨K, hf, hfin, hK, hQ'⟩ := hraw
    obtain ⟨hsR, hna, ⟨θ⟩⟩ := hQ'
    haveI : Finite (LargeEvenProj (LargeEvenSLGroup (Fin 4) K)) :=
      Finite.of_equiv _ θ.toEquiv
    rw [twoRank_eq_pRank_centerQuot_of_odd hodd, ← pRank_top_congr θ]
    have h' := pRank_unipProj_ge (K := K) (d := 4) (k := 2) (n := n)
      (by norm_num) (by norm_num) (by omega) hK
    simpa [mul_comm] using h'
  have hdvd : ∀ r : ℕ, r.Prime → r ≠ 2 → r ∣ 2 ^ (2 * n) - 1 →
      r ∣ Nat.card (J ⧸ Subgroup.center J) := by
    intro r hr hr2 hdvd
    have hraw := rk2IsLabel_rawDatum h
    dsimp only [GLARawDatum, CFSG.Assembly.LargeEvenRawDatum] at hraw
    rw [if_pos rfl] at hraw
    dsimp only [CFSG.Assembly.LargeEvenRecipeLinear] at hraw
    obtain ⟨K, hf, hfin, hK, hQ'⟩ := hraw
    obtain ⟨hsR, hna, ⟨θ⟩⟩ := hQ'
    rw [Nat.card_congr θ.toEquiv]
    rw [show LargeEvenProj (LargeEvenSLGroup (Fin 4) K) = StatedProj (StatedSL 4 K) by
      rw [largeEvenSLGroup_eq_statedSL]]
    rw [card_statedProj_statedSL (K := K) (n := 4) (by norm_num), hK]
    rw [hgcd, Nat.div_one]
    have hfac : r ∣ ((2 ^ n) ^ (2 * 1) - 1) := by
      have h1 : (2 ^ n) ^ (2 * 1) - 1 = 2 ^ (2 * n) - 1 := by
        rw [show 2 * 1 = 2 by norm_num, pow_two, ← pow_add]
        congr 1
        ring
      rw [h1]
      exact hdvd
    have hmem : (2 : ℕ) ∈ Finset.Icc 2 4 := Finset.mem_Icc.mpr ⟨by norm_num, by norm_num⟩
    exact Dvd.dvd.mul_left (dvd_trans hfac
      (Finset.dvd_prod_of_mem (fun j => ((2 ^ n) ^ j - 1)) hmem)) _
  exact ⟨hsix, hodd, hm2, hdvd⟩


theorem mul_dvd_card_centerQuot_of_dvd_pow_add_one_sub_one {J : Type} [Group J] [Finite J]
    {n p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) (hp2 : p ≠ 2) (hq2 : q ≠ 2)
    (hpd : p ∣ 2 ^ n + 1) (hqd : q ∣ 2 ^ n - 1)
    (h : ∀ r : ℕ, r.Prime → r ≠ 2 → r ∣ 2 ^ (2 * n) - 1 →
      r ∣ Nat.card (J ⧸ Subgroup.center J)) :
    p * q ∣ Nat.card (J ⧸ Subgroup.center J) := by
  have hfac : 2 ^ (2 * n) - 1 = (2 ^ n + 1) * (2 ^ n - 1) := by
    rw [show 2 ^ (2 * n) = (2 ^ n) ^ 2 by
      rw [pow_two, ← pow_add]
      congr 1
      ring]
    simpa using Nat.sq_sub_sq (2 ^ n) 1
  refine mul_dvd_card_centerQuot_of_two_primes hp hq hpq hp2 hq2 ?_ ?_ h
  · rw [hfac]
    exact dvd_mul_of_dvd_left hpd _
  · rw [hfac]
    exact dvd_mul_of_dvd_right hqd _

end CFSG.LocalAnalysis.GLTheoremA.Y10F
