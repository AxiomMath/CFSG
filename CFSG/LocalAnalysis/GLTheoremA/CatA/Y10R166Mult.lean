theorem unitaryFive_dvd {J : Type} [Group J] [Finite J] {n : ℕ} (hn : 2 ≤ n)
    (h : HasLabel J (· = ⟨.twA, 4, n⟩)) :
    ∀ r : ℕ, r.Prime → r ≠ 2 → r ∣ 2 ^ (2 * n) - 1 →
      r ∣ Nat.card (J ⧸ Subgroup.center J) := by
  intro r hr hr2 hdvd
  have hraw := rk2IsLabel_rawDatum h
  dsimp only [GLARawDatum, CFSG.Assembly.LargeEvenRawDatum,
    CFSG.Assembly.LargeEvenRecipeUnitary] at hraw
  obtain ⟨K, hf, hfin, hK, hQ⟩ := hraw
  obtain ⟨hsR, hna, ⟨θ⟩⟩ := hQ
  rw [Nat.card_congr θ.toEquiv]
  change r ∣ Nat.card (StatedProj (StatedSU 5 (2 ^ n) K))
  rw [card_statedProj_statedSU (K := K) (p := 2) (f := n) (n := 5)
    Nat.prime_two (by omega) hK (by norm_num)]
  set q : ℕ := 2 ^ n with hq
  have hqpos : 0 < q := by rw [hq]; positivity
  have h2eq : (((q : ℕ) : ℤ) ^ 2 - (-1 : ℤ) ^ 2).toNat = 2 ^ (2 * n) - 1 := by
    rw [toNat_sq_sub_one hqpos, hq, pow_two, ← pow_add]
    congr 1
    ring
  have hfac2 : r ∣ (((q : ℕ) : ℤ) ^ 2 - (-1 : ℤ) ^ 2).toNat := by
    rw [h2eq]; exact hdvd
  have hmem2 : (2 : ℕ) ∈ Finset.Icc 2 5 := Finset.mem_Icc.mpr ⟨by norm_num, by norm_num⟩
  have hprod2 : r ∣ ∏ i ∈ Finset.Icc 2 5,
      ((((q : ℕ) : ℤ) ^ i - (-1 : ℤ) ^ i).toNat) :=
    dvd_trans hfac2 (Finset.dvd_prod_of_mem _ hmem2)
  have hA : r ∣ q ^ (5 * (5 - 1) / 2) * ∏ i ∈ Finset.Icc 2 5,
      ((((q : ℕ) : ℤ) ^ i - (-1 : ℤ) ^ i).toNat) := Dvd.dvd.mul_left hprod2 _
  have hq13 : q + 1 ∣ q ^ 3 + 1 :=
    CFSG.Timmesfeld.Orders.add_one_dvd_pow_add_one q (by decide : Odd 3)
  have hgq : Nat.gcd 5 (q + 1) ∣ q + 1 := Nat.gcd_dvd_right 5 (q + 1)
  have hfac3 : Nat.gcd 5 (q + 1) ∣ ((((q : ℕ) : ℤ) ^ 3 - (-1 : ℤ) ^ 3).toNat) := by
    rw [toNat_cube_add_one]; exact hgq.trans hq13
  have hmem3 : (3 : ℕ) ∈ Finset.Icc 2 5 := Finset.mem_Icc.mpr ⟨by norm_num, by norm_num⟩
  have hprod3 : Nat.gcd 5 (q + 1) ∣ ∏ i ∈ Finset.Icc 2 5,
      ((((q : ℕ) : ℤ) ^ i - (-1 : ℤ) ^ i).toNat) :=
    dvd_trans hfac3 (Finset.dvd_prod_of_mem _ hmem3)
  have hgA : Nat.gcd 5 (q + 1) ∣ q ^ (5 * (5 - 1) / 2) * ∏ i ∈ Finset.Icc 2 5,
      ((((q : ℕ) : ℤ) ^ i - (-1 : ℤ) ^ i).toNat) := Dvd.dvd.mul_left hprod3 _
  by_cases h5 : 5 ∣ q + 1
  · have hg5 : Nat.gcd 5 (q + 1) = 5 := Nat.gcd_eq_left h5
    by_cases hr5 : r = 5
    · subst hr5
      rw [hg5]
      refine dvd_div_self_of_sq_dvd (by decide : Nat.Prime 5) ?_
      have hf2_5 : 5 ∣ (((q : ℕ) : ℤ) ^ 2 - (-1 : ℤ) ^ 2).toNat := by
        rw [h2eq]; exact hdvd
      have hf3_5 : 5 ∣ (((q : ℕ) : ℤ) ^ 3 - (-1 : ℤ) ^ 3).toNat := by
        rw [toNat_cube_add_one]; exact h5.trans hq13
      have h25 : 25 ∣ (((q : ℕ) : ℤ) ^ 2 - (-1 : ℤ) ^ 2).toNat *
          ((((q : ℕ) : ℤ) ^ 3 - (-1 : ℤ) ^ 3).toNat) := by
        simpa using mul_dvd_mul hf2_5 hf3_5
      have hsub : ({2, 3} : Finset ℕ) ⊆ Finset.Icc 2 5 := by
        intro i hi
        simp only [Finset.mem_insert, Finset.mem_singleton] at hi
        rcases hi with rfl | rfl <;> simp
      have hprod25 : 25 ∣ ∏ i ∈ Finset.Icc 2 5,
          ((((q : ℕ) : ℤ) ^ i - (-1 : ℤ) ^ i).toNat) := by
        refine dvd_trans ?_ (Finset.prod_dvd_prod_of_subset ({2, 3} : Finset ℕ)
          (Finset.Icc 2 5) (fun i => ((((q : ℕ) : ℤ) ^ i - (-1 : ℤ) ^ i).toNat)) hsub)
        simpa [Finset.prod_insert] using h25
      exact Dvd.dvd.mul_left hprod25 _
    · have hcop : Nat.Coprime r 5 := (hr.coprime_iff_not_dvd).2 fun hd => hr5
        ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_five).1 hd)
      rw [hg5] at hgA ⊢
      exact dvd_div_of_dvd_of_coprime hr hA hgA hcop
  · have hg1 : Nat.gcd 5 (q + 1) = 1 := by
      rcases (Nat.dvd_prime Nat.prime_five).1 (Nat.gcd_dvd_left 5 (q + 1)) with h' | h'
      · exact h'
      · exact absurd (h' ▸ Nat.gcd_dvd_right 5 (q + 1)) h5
    rw [hg1, Nat.div_one]
    exact hA

theorem unitarySix_odd_exponent_and_odd_center {J : Type} [Group J] [Finite J] {n : ℕ}
    (hn : 2 ≤ n)
    (h : HasLabel J (· = ⟨.twA, 5, n⟩)) (hGA : CFSG.Open.GriessAllModelsStatement)
    (h3 : 3 ∣ Nat.card (Subgroup.center J)) :
    Odd n ∧ Odd (Nat.card (Subgroup.center J)) := by
  obtain ⟨hQ, hlab, hM⟩ :=
    quasisimple_markedModel_of_isLabel (K := J) (lab := ⟨.twA, 5, n⟩) h
  have hM' : CFSG.Blueprint.LieModel (J ⧸ Subgroup.center J) .PSU 6 2 n := by
    simpa [CFSG.StandardType.MarkedModel, CFSG.StandardType.markTag,
      CFSG.StandardType.markRank, CFSG.StandardType.markChar,
      CFSG.StandardType.markDeg] using hM
  have hm : CFSG.Models.LieModel (J ⧸ Subgroup.center J) .PSU 6 2 n :=
    CFSG.Models.LieModel.of_blueprint_of_ne_zero (by omega) hM'
  have hn1 : n ≠ 1 := by omega
  have hqodd : Odd (2 ^ n + 1) := by
    have h' := CFSG.Timmesfeld.ClassicalOrders.odd_two_pow_pow_add_one (f := 1) (n := n)
      (by norm_num) (by omega)
    simpa using h'
  have hcard : Nat.card (CFSG.Open.griessHopfMultiplier (J ⧸ Subgroup.center J)) =
      Nat.card (CFSG.Blueprint.Multiplier.generic .PSU 6 2 n ×
        CFSG.Blueprint.Multiplier.exceptional .PSU 6 2 n) := by
    rw [Nat.card_congr (CFSG.RankThree.PerfectCover.hopfMultiplierEquivGriess
      (J ⧸ Subgroup.center J)).toEquiv,
      (CFSG.RankThree.PartOne.card_hopfMultiplier_of_model hGA hm).2]
  have hgcd_of_not_three : ¬ 3 ∣ 2 ^ n + 1 → Nat.gcd 6 (2 ^ n + 1) = 1 := by
    intro h3'
    have hg6 : Nat.gcd 6 (2 ^ n + 1) ∣ 6 := Nat.gcd_dvd_left 6 (2 ^ n + 1)
    have hgodd : Odd (Nat.gcd 6 (2 ^ n + 1)) :=
      Odd.of_dvd_nat hqodd (Nat.gcd_dvd_right 6 (2 ^ n + 1))
    have hcop : Nat.Coprime (Nat.gcd 6 (2 ^ n + 1)) 3 :=
      ((Nat.prime_three.coprime_iff_not_dvd).2 fun hd =>
        h3' (hd.trans (Nat.gcd_dvd_right 6 (2 ^ n + 1)))).symm
    have hg2 : Nat.gcd 6 (2 ^ n + 1) ∣ 2 := by
      have h32 : Nat.gcd 6 (2 ^ n + 1) ∣ 3 * 2 := by
        rw [← show (6 : ℕ) = 3 * 2 by norm_num]
        exact hg6
      exact hcop.dvd_of_dvd_mul_left h32
    rcases (Nat.dvd_prime Nat.prime_two).1 hg2 with h1 | h1
    · exact h1
    · exfalso
      rw [h1] at hgodd
      exact (Nat.not_odd_iff_even.mpr (by decide : Even 2)) hgodd
  have hgcd_of_three : 3 ∣ 2 ^ n + 1 → Nat.gcd 6 (2 ^ n + 1) = 3 := by
    intro h3'
    have hg6 : Nat.gcd 6 (2 ^ n + 1) ∣ 6 := Nat.gcd_dvd_left 6 (2 ^ n + 1)
    have hgodd : Odd (Nat.gcd 6 (2 ^ n + 1)) :=
      Odd.of_dvd_nat hqodd (Nat.gcd_dvd_right 6 (2 ^ n + 1))
    have hg3 : Nat.gcd 6 (2 ^ n + 1) ∣ 3 := by
      have hcop : Nat.Coprime (Nat.gcd 6 (2 ^ n + 1)) 2 :=
        (Nat.coprime_two_left.mpr hgodd).symm
      have h23 : Nat.gcd 6 (2 ^ n + 1) ∣ 2 * 3 := by
        rw [← show (6 : ℕ) = 2 * 3 by norm_num]
        exact hg6
      exact hcop.dvd_of_dvd_mul_left h23
    exact Nat.dvd_antisymm hg3 (Nat.dvd_gcd (by norm_num) h3')
  have h3q : 3 ∣ 2 ^ n + 1 := by
    by_contra h3'
    have hg1 := hgcd_of_not_three h3'
    have hprod1 : Nat.card (CFSG.Blueprint.Multiplier.generic .PSU 6 2 n ×
        CFSG.Blueprint.Multiplier.exceptional .PSU 6 2 n) = 1 := by
      simpa [CFSG.Blueprint.Multiplier.generic, CFSG.Blueprint.Multiplier.exceptional,
        CFSG.Blueprint.Multiplier.genericOrders, CFSG.Blueprint.Multiplier.exceptionalOrders,
        Nat.card_prod, ZMod.card, hn1, hg1] using
        (show Nat.card (Multiplicative (ZMod 1) × Multiplicative (ZMod 1) ×
          (Multiplicative (ZMod 1) × Multiplicative (ZMod 1))) = 1 by simp)
    haveI : Finite (CFSG.Open.griessHopfMultiplier (J ⧸ Subgroup.center J)) :=
      Nat.finite_of_card_ne_zero (by rw [hcard, hprod1]; norm_num)
    have hdvd := CFSG.GH74.GLS.Stage2.Signalizer.Odd87.card_center_dvd_hopf hQ
      (MulEquiv.refl (J ⧸ Subgroup.center J))
    rw [hcard, hprod1, Nat.dvd_one] at hdvd
    have : 3 ∣ 1 := hdvd ▸ h3
    omega
  have hg3eq := hgcd_of_three h3q
  have hoddProd : Odd (Nat.card (CFSG.Blueprint.Multiplier.generic .PSU 6 2 n ×
      CFSG.Blueprint.Multiplier.exceptional .PSU 6 2 n)) := by
    simpa [CFSG.Blueprint.Multiplier.generic, CFSG.Blueprint.Multiplier.exceptional,
      CFSG.Blueprint.Multiplier.genericOrders, CFSG.Blueprint.Multiplier.exceptionalOrders,
      Nat.card_prod, ZMod.card, hn1, hg3eq] using (show Odd 3 by decide)
  exact ⟨CFSG.Quasithin.H13.P31X.l3_odd_of_three_dvd_two_pow_add_one h3q,
    odd_card_center_of_lieModel_multiplier hGA hQ hm hoddProd⟩

