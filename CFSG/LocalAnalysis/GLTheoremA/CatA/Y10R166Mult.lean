theorem trivialMultiplierT_of_quotient_center {X : Type} [Group X] [Finite X]
    (h : TrivialMultiplierT (X ⧸ Subgroup.center X)) : TrivialMultiplierT X := by
  intro E _ _ hE π hπ hker
  let q : X →* X ⧸ Subgroup.center X := QuotientGroup.mk' _
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective _
  have hcomap := CFSG.LocalCores.comap_center_eq_of_perfect (Group.IsPerfect.mk hE) π hπ hker
  have hcompker : (q.comp π).ker = (Subgroup.center X).comap π := by
    ext x
    simp only [MonoidHom.mem_ker, Subgroup.mem_comap]
    change QuotientGroup.mk (π x) = 1 ↔ π x ∈ Subgroup.center X
    rw [QuotientGroup.eq_one_iff]
  have hcomp : (q.comp π).ker ≤ Subgroup.center E := by rw [hcompker, hcomap]
  have hbot : (q.comp π).ker = ⊥ := h E hE (q.comp π) (hq.comp hπ) hcomp
  have hle : π.ker ≤ (q.comp π).ker := by
    intro x hx
    rw [MonoidHom.mem_ker] at hx ⊢
    rw [MonoidHom.comp_apply, hx, map_one]
  exact le_bot_iff.mp (hle.trans (le_of_eq hbot))

theorem center_eq_bot_of_trivialMultiplierT_quotient_center {X : Type} [Group X] [Finite X]
    (hperf : commutator X = ⊤) (h : TrivialMultiplierT (X ⧸ Subgroup.center X)) :
    Subgroup.center X = ⊥ := by
  let q : X →* X ⧸ Subgroup.center X := QuotientGroup.mk' _
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective _
  have hker : q.ker ≤ Subgroup.center X := by rw [QuotientGroup.ker_mk']
  have hbot := h X hperf q hq hker
  rwa [QuotientGroup.ker_mk'] at hbot

theorem center_eq_bot_and_trivialMultiplierT_of_quotient_center {X : Type} [Group X] [Finite X]
    (hperf : commutator X = ⊤) (h : TrivialMultiplierT (X ⧸ Subgroup.center X)) :
    Subgroup.center X = ⊥ ∧ TrivialMultiplierT X :=
  ⟨center_eq_bot_of_trivialMultiplierT_quotient_center hperf h,
    trivialMultiplierT_of_quotient_center h⟩

private theorem twoRank_eq_pRank_centerQuot_of_odd {J : Type} [Group J] [Finite J]
    (hodd : Odd (Nat.card (Subgroup.center J))) :
    twoRank J = CFSG.Open.pRank 2 (⊤ : Subgroup (J ⧸ Subgroup.center J)) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h2 : ¬ 2 ∣ Nat.card (Subgroup.center J) := fun h =>
    (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr h)
  exact (CFSG.SectionRank.pRank_quotient_eq (Subgroup.center J) h2).symm

theorem odd_card_center_of_lieModel_multiplier (hGA : CFSG.Open.GriessAllModelsStatement)
    {G : Type} [Group G] [Finite G] {t : CFSG.Assembly.LowTwoRank.StatedLieTag} {n f : ℕ}
    (hQ : CFSG.IsQuasisimple G)
    (hm : CFSG.Models.LieModel (G ⧸ Subgroup.center G) t n 2 f)
    (hodd : Odd (Nat.card (CFSG.Blueprint.Multiplier.generic t n 2 f ×
      CFSG.Blueprint.Multiplier.exceptional t n 2 f))) :
    Odd (Nat.card (Subgroup.center G)) := by
  have hcard : Nat.card (CFSG.Open.griessHopfMultiplier (G ⧸ Subgroup.center G)) =
      Nat.card (CFSG.Blueprint.Multiplier.generic t n 2 f ×
        CFSG.Blueprint.Multiplier.exceptional t n 2 f) := by
    rw [Nat.card_congr (CFSG.RankThree.PerfectCover.hopfMultiplierEquivGriess
      (G ⧸ Subgroup.center G)).toEquiv,
      (CFSG.RankThree.PartOne.card_hopfMultiplier_of_model hGA hm).2]
  haveI : Finite (CFSG.Open.griessHopfMultiplier (G ⧸ Subgroup.center G)) :=
    Nat.finite_of_card_ne_zero (by rw [hcard]; exact hodd.pos.ne')
  have hdvd := CFSG.GH74.GLS.Stage2.Signalizer.Odd87.card_center_dvd_hopf hQ
    (MulEquiv.refl (G ⧸ Subgroup.center G))
  rw [hcard] at hdvd
  exact Odd.of_dvd_nat hodd hdvd

private theorem dvd_div_of_dvd_of_coprime {A g r : ℕ} (hr : r.Prime) (hA : r ∣ A) (hg : g ∣ A)
    (hcop : Nat.Coprime r g) : r ∣ A / g := by
  rw [← Nat.mul_div_cancel' hg] at hA
  rcases (hr.dvd_mul).1 hA with h | h
  · exact absurd h (hr.coprime_iff_not_dvd.mp hcop)
  · exact h

private theorem dvd_div_self_of_sq_dvd {A r : ℕ} (hr : r.Prime) (hA : r ^ 2 ∣ A) : r ∣ A / r := by
  obtain ⟨k, rfl⟩ := hA
  rw [pow_two, mul_assoc, Nat.mul_div_cancel_left _ hr.pos]
  exact dvd_mul_right r k

theorem symplectic_six {J : Type} [Group J] [Finite J] {m n : ℕ} (hm : 3 ≤ m) (hn : 2 ≤ n)
    (h : HasLabel J (· = ⟨.B, m, n⟩)) (hGA : CFSG.Open.GriessAllModelsStatement) :
    Subgroup.center J = ⊥ ∧ TrivialMultiplierT J := by
  obtain ⟨hQ, hlab, hM⟩ :=
    quasisimple_markedModel_of_isLabel (K := J) (lab := ⟨.B, m, n⟩) h
  have hM' : CFSG.Blueprint.LieModel (J ⧸ Subgroup.center J) .PSp m 2 n := by
    simpa [CFSG.StandardType.MarkedModel, CFSG.StandardType.markTag,
      CFSG.StandardType.markRank, CFSG.StandardType.markChar,
      CFSG.StandardType.markDeg] using hM
  have hmM : CFSG.Models.LieModel (J ⧸ Subgroup.center J) .PSp m 2 n :=
    CFSG.Models.LieModel.of_blueprint_of_ne_zero (by omega) hM'
  have hodd : Odd (2 ^ n - 1) := by
    have := CFSG.Timmesfeld.ClassicalOrders.odd_two_pow_pow_sub_one (f := 1) (n := n)
      (by norm_num) (by omega)
    simpa using this
  have hn1 : n ≠ 1 := by omega
  have h1 : Nat.card (CFSG.Blueprint.Multiplier.generic .PSp m 2 n ×
      CFSG.Blueprint.Multiplier.exceptional .PSp m 2 n) = 1 := by
    have hgcd : Nat.gcd 2 (2 ^ n - 1) = 1 := by
      rw [Nat.gcd_comm, ← Nat.coprime_iff_gcd_eq_one, Nat.coprime_comm, Nat.coprime_two_left]
      exact hodd
    simp [CFSG.Blueprint.Multiplier.generic, CFSG.Blueprint.Multiplier.exceptional,
      CFSG.Blueprint.Multiplier.genericOrders, CFSG.Blueprint.Multiplier.exceptionalOrders,
      Nat.card_prod, ZMod.card, hn1, hgcd]
  exact center_eq_bot_and_trivialMultiplierT_of_quotient_center hQ.1.commutator_eq_top
    (trivialMultiplierT_of_lieModel hGA hmM h1)

theorem symplectic_twoRank {J : Type} [Group J] [Finite J] {m n : ℕ}
    (hm : 3 ≤ m) (hn : 1 ≤ n) (hodd : Odd (Nat.card (Subgroup.center J)))
    (h : HasLabel J (· = ⟨.B, m, n⟩)) :
    n * (m * (m + 1) / 2) ≤ twoRank J := by
  have hraw := rk2IsLabel_rawDatum h
  dsimp only [GLARawDatum, CFSG.Assembly.LargeEvenRawDatum,
    CFSG.Assembly.LargeEvenRecipeSymplectic] at hraw
  obtain ⟨K, hf, hfin, hK, hQ⟩ := hraw
  obtain ⟨hsR, hna, ⟨θ⟩⟩ := hQ
  haveI : Finite (LargeEvenProj (LargeEvenSpGroup K m)) := Finite.of_equiv _ θ.toEquiv
  rw [twoRank_eq_pRank_centerQuot_of_odd hodd, ← pRank_top_congr θ]
  have h' := CFSG.GH74.Filter.le_pRank_Sp_sym (K := K) (n := m) (by omega) (p := 2) (f := n) hK
  rw [I107L.choose_succ_two] at h'
  simpa using h'

theorem omegaPlus_twoRank {J : Type} [Group J] [Finite J] {m n : ℕ}
    (hm : 4 ≤ m) (hn : 1 ≤ n) (hodd : Odd (Nat.card (Subgroup.center J)))
    (h : HasLabel J (· = ⟨.D, m, n⟩)) :
    n * (m * (m - 1) / 2) ≤ twoRank J := by
  have hraw := rk2IsLabel_rawDatum h
  dsimp only [GLARawDatum, CFSG.Assembly.LargeEvenRawDatum] at hraw
  rw [if_neg (by omega : ¬ m = 3)] at hraw
  dsimp only [CFSG.Assembly.LargeEvenRecipeOmegaPlus] at hraw
  obtain ⟨K, hf, hfin, hK, hQ⟩ := hraw
  obtain ⟨hsR, hna, ⟨θ⟩⟩ := hQ
  haveI : Finite (LargeEvenProj (LargeEvenOmega (LargeEvenQPlus K m))) :=
    Finite.of_equiv _ θ.toEquiv
  rw [twoRank_eq_pRank_centerQuot_of_odd hodd, ← pRank_top_congr θ]
  have h' := pRank_alt_plus_ge (m := m) (n := n) hn (by omega) hK
  rw [Nat.choose_two_right] at h'
  simpa using h'


theorem symplectic_dvd {J : Type} [Group J] [Finite J] {m n : ℕ} (hm : 1 ≤ m)
    (h : HasLabel J (· = ⟨.B, m, n⟩)) :
    ∀ r : ℕ, r.Prime → r ≠ 2 → r ∣ 2 ^ (2 * n) - 1 →
      r ∣ Nat.card (J ⧸ Subgroup.center J) := by
  intro r hr hr2 hdvd
  have hn : 1 ≤ n := (rk2IsLabel_inLambda2 h).1
  have hraw := rk2IsLabel_rawDatum h
  dsimp only [GLARawDatum, CFSG.Assembly.LargeEvenRawDatum,
    CFSG.Assembly.LargeEvenRecipeSymplectic] at hraw
  obtain ⟨K, hf, hfin, hK, hQ⟩ := hraw
  obtain ⟨hsR, hna, ⟨θ⟩⟩ := hQ
  haveI : CharP K 2 := charP_two_of_card_eq hK
  rw [Nat.card_congr θ.toEquiv]
  change r ∣ Nat.card (StatedProj (StatedSp m K))
  rw [card_statedProj_statedSp_of_charTwo (K := K) m, hK]
  have hfac : r ∣ (2 ^ n) ^ (2 * 1) - 1 := by
    have h1 : (2 ^ n) ^ (2 * 1) - 1 = 2 ^ (2 * n) - 1 := by
      rw [show 2 * 1 = 2 by norm_num, pow_two, ← pow_add]
      congr 1
      ring
    rw [h1]
    exact hdvd
  have hmem : (1 : ℕ) ∈ Finset.Icc 1 m := Finset.mem_Icc.mpr ⟨le_rfl, hm⟩
  exact Dvd.dvd.mul_left (dvd_trans hfac
    (Finset.dvd_prod_of_mem (fun j => (2 ^ n) ^ (2 * j) - 1) hmem)) _

theorem omegaPlus_six {J : Type} [Group J] [Finite J] {m n : ℕ} (hm : 4 ≤ m) (hn : 2 ≤ n)
    (h : HasLabel J (· = ⟨.D, m, n⟩)) (hGA : CFSG.Open.GriessAllModelsStatement) :
