  change r ∣ Nat.card (StatedProj (StatedOmega (StatedQuadPlus m K)))
  have hfac : (r : ℤ) ∣ ((2 : ℤ) ^ (2 * n) - 1) := by
    have hcast : ((2 : ℤ) ^ (2 * n) - 1) = ((2 ^ (2 * n) - 1 : ℕ) : ℤ) := by
      rw [Nat.cast_sub (Nat.one_le_two_pow)]
      push_cast
      ring
    rw [hcast, Int.natCast_dvd_natCast]
    exact hdvd
  have hfac1 : (r : ℤ) ∣ ((Nat.card K : ℤ) ^ (2 * 1) - 1) := by
    rw [hK]
    have hcast : (((2 ^ n : ℕ) : ℤ) ^ (2 * 1) - 1) = ((2 ^ (2 * n) - 1 : ℕ) : ℤ) := by
      have h1 : (1 : ℕ) ≤ 2 ^ (2 * n) := Nat.one_le_two_pow
      push_cast
      rw [Nat.cast_sub h1]
      push_cast
      ring
    rw [hcast, Int.natCast_dvd_natCast]
    exact hdvd
  have hmem : (1 : ℕ) ∈ Finset.Icc 1 (m - 1) :=
    Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
  have hprod : (r : ℤ) ∣ ∏ i ∈ Finset.Icc 1 (m - 1),
      ((Nat.card K : ℤ) ^ (2 * i) - 1) :=
    dvd_trans hfac1 (Finset.dvd_prod_of_mem _ hmem)
  rw [hK] at hprod
  have hdvdZ : (r : ℤ) ∣ (Nat.card (StatedProj (StatedOmega (StatedQuadPlus m K))) : ℤ) := by
    rw [card_statedProj_statedOmega_quadPlus (K := K) (n := m) hm, hK]
    simpa [mul_assoc] using
      Dvd.dvd.mul_left (Dvd.dvd.mul_left hprod (((2 : ℤ) ^ n) ^ m - 1)) (((2 : ℤ) ^ n) ^ (m * (m - 1)))
  exact Int.natCast_dvd_natCast.mp hdvdZ

private theorem toNat_sq_sub_one {q : ℕ} (hq : 0 < q) :
    (((q : ℕ) : ℤ) ^ 2 - (-1 : ℤ) ^ 2).toNat = q ^ 2 - 1 := by
  have hge : (1 : ℕ) ≤ q ^ 2 := Nat.one_le_pow _ _ hq
  have hcast : (((q : ℕ) : ℤ) ^ 2 - (-1 : ℤ) ^ 2) = ((q ^ 2 - 1 : ℕ) : ℤ) := by
    push_cast
    rw [Nat.cast_sub hge]
    push_cast
    ring
  rw [hcast, Int.toNat_natCast]

private theorem toNat_cube_add_one (q : ℕ) :
    (((q : ℕ) : ℤ) ^ 3 - (-1 : ℤ) ^ 3).toNat = q ^ 3 + 1 := by
  have hcast : (((q : ℕ) : ℤ) ^ 3 - (-1 : ℤ) ^ 3) = ((q ^ 3 + 1 : ℕ) : ℤ) := by
    push_cast
    ring
  rw [hcast, Int.toNat_natCast]

private theorem five_not_dvd_two_pow_add_one_of_odd {n : ℕ} (hn : Odd n) : ¬ 5 ∣ 2 ^ n + 1 := by
  intro h
  have hz : ((2 : ZMod 5) ^ n + 1) = 0 := by
    have h' : ((2 ^ n + 1 : ℕ) : ZMod 5) = 0 := by
      rw [ZMod.natCast_eq_zero_iff]
      exact h
    push_cast at h'
    simpa using h'
  have hx : (2 : ZMod 5) ^ n = -1 := by rwa [add_eq_zero_iff_eq_neg] at hz
  have hsq1 : (2 : ZMod 5) ^ (2 * n) = 1 := by
    rw [show 2 * n = n * 2 by ring, pow_mul, hx]
    decide
  have hsq2 : (2 : ZMod 5) ^ (2 * n) = -1 := by
    rw [pow_mul, show (2 : ZMod 5) ^ 2 = -1 by decide]
    exact Odd.neg_one_pow hn
  have hbad : (1 : ZMod 5) = -1 := hsq1.symm.trans hsq2
  exact (by decide : (-1 : ZMod 5) ≠ 1) hbad.symm

