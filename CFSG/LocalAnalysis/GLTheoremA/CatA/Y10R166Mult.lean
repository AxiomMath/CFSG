theorem mul_dvd_card_centerQuot_of_two_primes {J : Type} [Group J] [Finite J] {n p q : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) (hp2 : p ≠ 2) (hq2 : q ≠ 2)
    (hpd : p ∣ 2 ^ (2 * n) - 1) (hqd : q ∣ 2 ^ (2 * n) - 1)
    (h : ∀ r : ℕ, r.Prime → r ≠ 2 → r ∣ 2 ^ (2 * n) - 1 →
