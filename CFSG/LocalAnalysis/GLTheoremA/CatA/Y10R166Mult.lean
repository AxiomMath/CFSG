  have hm3 : ¬ m = 3 := by omega
  have hM' : CFSG.Blueprint.LieModel (J ⧸ Subgroup.center J) .POmegaPlus m 2 n := by
    simpa [CFSG.StandardType.MarkedModel, CFSG.StandardType.markTag,
      CFSG.StandardType.markRank, CFSG.StandardType.markChar,
      CFSG.StandardType.markDeg, hm3] using hM
  have hmM : CFSG.Models.LieModel (J ⧸ Subgroup.center J) .POmegaPlus m 2 n :=
    CFSG.Models.LieModel.of_blueprint_of_ne_zero (by omega) hM'
  have hq : Even (2 ^ n) := Nat.even_pow.mpr ⟨even_two, by omega⟩
  have hn1 : n ≠ 1 := by omega
  have h1 : Nat.card (CFSG.Blueprint.Multiplier.generic .POmegaPlus m 2 n ×
      CFSG.Blueprint.Multiplier.exceptional .POmegaPlus m 2 n) = 1 := by
    simp [CFSG.Blueprint.Multiplier.generic, CFSG.Blueprint.Multiplier.exceptional,
      CFSG.Blueprint.Multiplier.genericOrders, CFSG.Blueprint.Multiplier.exceptionalOrders,
      Nat.card_prod, ZMod.card, hn1, hq]
  exact center_eq_bot_and_trivialMultiplierT_of_quotient_center hQ.1.commutator_eq_top
    (trivialMultiplierT_of_lieModel hGA hmM h1)

theorem omegaPlus_dvd {J : Type} [Group J] [Finite J] {m n : ℕ} (hm : 4 ≤ m) (hn : 2 ≤ n)
    (h : HasLabel J (· = ⟨.D, m, n⟩)) :
