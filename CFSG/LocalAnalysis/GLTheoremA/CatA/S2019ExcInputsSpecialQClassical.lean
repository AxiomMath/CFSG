variable {K : Type} [Field K]

section Tools

private theorem coe_eq_scalar_of_blockGL {k m : ℕ} {X : GL (Fin k) K} {c : K}
    (hX : (blockGL K k m X : Matrix (Fin (k + m)) (Fin (k + m)) K) = scalar (Fin (k + m)) c) :
    (X : Matrix (Fin k) (Fin k) K) = scalar (Fin k) c := by
  ext i j
  have := congrFun (congrFun hX (finSumFinEquiv (Sum.inl i))) (finSumFinEquiv (Sum.inl j))
  rw [blockGL_apply_inl, scalar_apply_finSumFinEquiv] at this
  rw [this, scalar_apply, diagonal_apply]
  simp

private theorem eq_one_of_heisMat {ι : Type} [Fintype ι] [DecidableEq ι] {H : Subgroup (GL ι K)}
    (ψ : Heis K →* H) (e : Fin 3 → ι) (he : Function.Injective e)
    (hψ : ∀ x i j, (((ψ x : H) : GL ι K) : Matrix ι ι K) (e i) (e j) = heisMat x i j)
    (x : Heis K) (c : K) (hx : (((ψ x : H) : GL ι K) : Matrix ι ι K) = scalar ι c) : x = 1 := by
  have hc : c = 1 := by
    have := hψ x 0 0
    rw [hx, scalar_apply, diagonal_apply_eq] at this
    rw [this]
    simp [heisMat]
  apply heisSL_injective
  rw [map_one]
  ext i j
  rw [coe_heisSL]
  show heisMat x i j = (1 : Matrix (Fin 3) (Fin 3) K) i j
  rw [← hψ x i j, hx, hc, scalar_apply, diagonal_apply, one_apply]
  simp [he.eq_iff]

private theorem blockGL_heisSL_apply (m : ℕ) (x : Heis K) (i j : Fin 3) :
    (blockGL K 3 m (SpecialLinearGroup.toGL (heisSL x)) : Matrix (Fin (3 + m)) (Fin (3 + m)) K)
      (finSumFinEquiv (Sum.inl i)) (finSumFinEquiv (Sum.inl j)) = heisMat x i j := by
  rw [blockGL_apply_inl, SpecialLinearGroup.coe_GL_coe_matrix, coe_heisSL]

private theorem sum_mulVec_mul_mulVec {k : ℕ} (A B : Matrix (Fin k) (Fin k) K)
    (hAB : Aᵀ * B = 1) (x y : Fin k → K) :
    ∑ i, (A *ᵥ x) i * (B *ᵥ y) i = ∑ i, x i * y i := by
  change (A *ᵥ x) ⬝ᵥ (B *ᵥ y) = x ⬝ᵥ y
  rw [dotProduct_mulVec, ← vecMul_transpose, vecMul_vecMul, hAB, vecMul_one]

private theorem mem_statedOmega_of_isPerfect {ι : Type} [Fintype ι] [DecidableEq ι] {G : Type*}
    [Group G] [Group.IsPerfect G] (Q : (ι → K) → K) (ψ : G →* GL ι K)
    (hψ : ∀ g v, Q ((ψ g : Matrix ι ι K) *ᵥ v) = Q v) (g : G) : ψ g ∈ StatedOmega Q := by
  have hg : g ∈ commutator G := Group.IsPerfect.mem_commutator
  have hle : (commutator G).map ψ ≤ StatedOmega Q := by
    rw [_root_.commutator_def, Subgroup.map_commutator]
    apply Subgroup.commutator_mono <;>
    · rintro _ ⟨y, -, rfl⟩
      exact Subgroup.subset_closure (hψ y)
  exact hle ⟨g, hg, rfl⟩

private def heisGL (m : ℕ) : Heis K →* GL (Fin (3 + m)) K :=
  (blockGL K 3 m).comp ((SpecialLinearGroup.toGL).comp heisSL)

private theorem heisGL_apply (m : ℕ) (x : Heis K) :
    heisGL m x = blockGL K 3 m (SpecialLinearGroup.toGL (heisSL x)) :=
  rfl

private def slGL (m : ℕ) : SpecialLinearGroup (Fin 3) K →* GL (Fin (3 + m)) K :=
  (blockGL K 3 m).comp SpecialLinearGroup.toGL

end Tools

section Linear

private def heisStatedSL (m : ℕ) : Heis K →* StatedSL (3 + m) K :=
  (heisGL m).codRestrict _ fun x =>
    StatedAPI.mem_statedSL_of_det (by
      rw [heisGL_apply, det_blockGL, SpecialLinearGroup.coe_GL_coe_matrix, coe_heisSL,
        det_heisMat])

theorem hasS2019SpecialQ_statedSL [Finite K] {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) [CharP K q]
    {n : ℕ} (hn : 3 ≤ n) : HasS2019SpecialQ q (Nat.card K) (StatedProj (StatedSL n K)) := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hn
  refine hasS2019SpecialQ_statedProj (isS2019SpecialQ_heis hq hq2) (heisStatedSL m) ?_
  exact eq_one_of_heisMat (heisStatedSL m) (fun i => finSumFinEquiv (Sum.inl i))
    (fun i j h => Sum.inl_injective (finSumFinEquiv.injective h)) fun x i j =>
      blockGL_heisSL_apply m x i j

end Linear

section Unitary

open CFSG.LocalAnalysis.ComponentInitial CFSG.ClassicalGroups.UnitaryFlag
open CFSG.GH74.GLS.IVK.Proofs2.Lemma41dU3 (UHeis uSU uMat coe_uSU uSU_injective uMat_ee)

variable {p f : ℕ}

private theorem blockGL_mem_unitarySU (h : UnitaryFieldData p f K) {k m : ℕ} {X : GL (Fin k) K}
    (hX : X ∈ unitarySU p f K k) : blockGL K k m X ∈ unitarySU p f K (k + m) := by
  rw [mem_unitarySU_iff h] at hX ⊢
  rw [det_blockGL, coe_blockGL_eq_diagBlock, diagBlock_map, diagBlock_transpose, diagBlock_mul,
    Matrix.map_one _ (map_zero _) (map_one _), transpose_one, Matrix.mul_one, hX.2, diagBlock_one]
  exact ⟨hX.1, rfl⟩

private def unitaryBlockGL (h : UnitaryFieldData p f K) (k m : ℕ) :
    unitarySU p f K k →* unitarySU p f K (k + m) :=
  ((blockGL K k m).comp (unitarySU p f K k).subtype).codRestrict _
    fun X => blockGL_mem_unitarySU h X.2

theorem hasS2019SpecialQ_statedSU (h : UnitaryFieldData p f K) (hp2 : p ≠ 2) {n : ℕ}
    (hn : 3 ≤ n) : HasS2019SpecialQ p (p ^ f) (StatedProj (StatedSU n (p ^ f) K)) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = 2 * 1 + 1 + m := ⟨n - 3, by omega⟩
  obtain ⟨R, hR⟩ := exists_isHypTransport h (r := 1) (ε := 1)
  refine hasS2019SpecialQ_statedProj (isS2019SpecialQ_uheis h hp2)
    ((unitaryBlockGL h (2 * 1 + 1) m).comp ((hypTransport h hR).toMonoidHom.comp uSU)) ?_
  intro x c hx
  have h1 : R * uMat x * transportInv h R = scalar (Fin (2 * 1 + 1)) c := by
    have := coe_eq_scalar_of_blockGL (m := m) hx
    simp only [Subgroup.coe_subtype, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom] at this
    rwa [coe_hypTransport, coe_uSU] at this
  have h2 : uMat x = scalar (HypIndex 1 1) c := by
    have e1 : transportInv h R * (R * uMat x * transportInv h R) * R = uMat x := by
      simp only [Matrix.mul_assoc]
      rw [transportInv_mul hR, Matrix.mul_one, ← Matrix.mul_assoc, transportInv_mul hR,
        Matrix.one_mul]
    rw [← e1, h1, transportInv_scalar hR]
  have hc : c = 1 := by
    have := congrFun (congrFun h2 (.inl 0)) (.inl 0)
    rwa [uMat_ee, scalar_apply, diagonal_apply_eq, eq_comm] at this
  apply uSU_injective
  rw [map_one]
  apply Subtype.ext
  apply Units.ext
  rw [coe_uSU, h2, hc, map_one, Subgroup.coe_one, Units.val_one]

end Unitary

section Levi

private def levi2 (k : ℕ) : GL (Fin k) K →* GL (Fin k ⊕ Fin k) K where
  toFun A := ⟨fromBlocks (A : Matrix (Fin k) (Fin k) K) 0 0
      ((A⁻¹ : GL (Fin k) K) : Matrix (Fin k) (Fin k) K)ᵀ,
    fromBlocks ((A⁻¹ : GL (Fin k) K) : Matrix (Fin k) (Fin k) K) 0 0
      (A : Matrix (Fin k) (Fin k) K)ᵀ, by
      rw [fromBlocks_multiply]
      simp [← transpose_mul], by
      rw [fromBlocks_multiply]
      simp [← transpose_mul]⟩
  map_one' := Units.ext (by simp)
  map_mul' A B := Units.ext (by
    simp only [Units.val_mul, _root_.mul_inv_rev, transpose_mul, fromBlocks_multiply]
    simp)

private theorem coe_levi2 {k : ℕ} (A : GL (Fin k) K) :
    (levi2 k A : Matrix (Fin k ⊕ Fin k) (Fin k ⊕ Fin k) K) =
      fromBlocks (A : Matrix (Fin k) (Fin k) K) 0 0
        ((A⁻¹ : GL (Fin k) K) : Matrix (Fin k) (Fin k) K)ᵀ :=
  rfl

private theorem levi2_isometry {k : ℕ} (A : GL (Fin k) K) (v : Fin k ⊕ Fin k → K) :
    ∑ i, ((levi2 k A : Matrix (Fin k ⊕ Fin k) (Fin k ⊕ Fin k) K) *ᵥ v) (Sum.inl i) *
      ((levi2 k A : Matrix (Fin k ⊕ Fin k) (Fin k ⊕ Fin k) K) *ᵥ v) (Sum.inr i) = ∑ i, v (Sum.inl i) * v (Sum.inr i) := by
  simp only [coe_levi2, fromBlocks_mulVec, Sum.elim_inl, Sum.elim_inr, zero_mulVec, add_zero,
    zero_add]
  exact sum_mulVec_mul_mulVec _ _ (by rw [← transpose_mul, Units.inv_mul, transpose_one]) _ _

private theorem levi2_mem_statedSp {k : ℕ} (A : GL (Fin k) K) : levi2 k A ∈ StatedSp k K := by
  rw [StatedAPI.mem_statedSp_iff, coe_levi2, fromBlocks_transpose, fromBlocks_multiply,
    fromBlocks_multiply]
  simp [← transpose_mul]

private def levi3 (T : Type) [Fintype T] [DecidableEq T] (k : ℕ) :
    GL (Fin k) K →* GL (Fin k ⊕ (Fin k ⊕ T)) K where
  toFun A := ⟨fromBlocks (A : Matrix (Fin k) (Fin k) K) 0 0
      (fromBlocks ((A⁻¹ : GL (Fin k) K) : Matrix (Fin k) (Fin k) K)ᵀ 0 0 1),
    fromBlocks ((A⁻¹ : GL (Fin k) K) : Matrix (Fin k) (Fin k) K) 0 0
      (fromBlocks (A : Matrix (Fin k) (Fin k) K)ᵀ 0 0 1), by
      rw [fromBlocks_multiply, fromBlocks_multiply]
      simp [← transpose_mul], by
      rw [fromBlocks_multiply, fromBlocks_multiply]
      simp [← transpose_mul]⟩
  map_one' := Units.ext (by simp)
  map_mul' A B := Units.ext (by
    simp only [Units.val_mul, _root_.mul_inv_rev, transpose_mul, fromBlocks_multiply]
    simp)

private theorem coe_levi3 {T : Type} [Fintype T] [DecidableEq T] {k : ℕ} (A : GL (Fin k) K) :
    (levi3 T k A : Matrix (Fin k ⊕ (Fin k ⊕ T)) (Fin k ⊕ (Fin k ⊕ T)) K) =
      fromBlocks (A : Matrix (Fin k) (Fin k) K) 0 0
        (fromBlocks ((A⁻¹ : GL (Fin k) K) : Matrix (Fin k) (Fin k) K)ᵀ 0 0 1) :=
  rfl

private theorem levi3_mulVec_inl {T : Type} [Fintype T] [DecidableEq T] {k : ℕ}
    (A : GL (Fin k) K) (v : Fin k ⊕ (Fin k ⊕ T) → K) (i : Fin k) :
    ((levi3 T k A : Matrix (Fin k ⊕ (Fin k ⊕ T)) (Fin k ⊕ (Fin k ⊕ T)) K) *ᵥ v) (Sum.inl i) =
      ((A : Matrix (Fin k) (Fin k) K) *ᵥ fun j => v (Sum.inl j)) i := by
  rw [coe_levi3, fromBlocks_mulVec]
  simp
  rfl

private theorem levi3_mulVec_inr_inl {T : Type} [Fintype T] [DecidableEq T] {k : ℕ}
    (A : GL (Fin k) K) (v : Fin k ⊕ (Fin k ⊕ T) → K) (i : Fin k) :
    ((levi3 T k A : Matrix (Fin k ⊕ (Fin k ⊕ T)) (Fin k ⊕ (Fin k ⊕ T)) K) *ᵥ v) (Sum.inr (Sum.inl i)) =
      (((A⁻¹ : GL (Fin k) K) : Matrix (Fin k) (Fin k) K)ᵀ *ᵥ
        fun j => v (Sum.inr (Sum.inl j))) i := by
  rw [coe_levi3, fromBlocks_mulVec]
  simp [fromBlocks_mulVec]
  rfl

private theorem levi3_mulVec_inr_inr {T : Type} [Fintype T] [DecidableEq T] {k : ℕ}
    (A : GL (Fin k) K) (v : Fin k ⊕ (Fin k ⊕ T) → K) (t : T) :
    ((levi3 T k A : Matrix (Fin k ⊕ (Fin k ⊕ T)) (Fin k ⊕ (Fin k ⊕ T)) K) *ᵥ v) (Sum.inr (Sum.inr t)) = v (Sum.inr (Sum.inr t)) := by
  rw [coe_levi3, fromBlocks_mulVec]
  simp [fromBlocks_mulVec]

end Levi

section Symplectic

open CFSG.RankThree.SubgroupLists (heis heis_mul heis_mem_statedSp coe_heis)
private theorem heis_entries (α β γ : K) :
    ((heis α β γ : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) (Sum.inl 0) (Sum.inl 0) = 1 ∧
    ((heis α β γ : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) (Sum.inl 0) (Sum.inl 1) = α ∧
    ((heis α β γ : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) (Sum.inl 0) (Sum.inr 1) = β ∧
    ((heis α β γ : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K) (Sum.inl 0) (Sum.inr 0) = γ := by
  simp [coe_heis, CFSG.RankThree.SubgroupLists.heisMat]

private def heisSp4 : Heis K →* StatedSp 2 K where
  toFun x := ⟨heis x.a x.b (2 * x.c - x.a * x.b), heis_mem_statedSp _ _ _⟩
  map_one' := by
    apply Subtype.ext
    apply Units.ext
    ext i j
    rw [coe_heis]
    simp only [Heis.one_a, Heis.one_b, Heis.one_c, mul_zero, sub_zero]
    rw [CFSG.RankThree.SubgroupLists.heisMat_zero]
    rfl
  map_mul' x y := by
    apply Subtype.ext
    simp only [Subgroup.coe_mul, heis_mul, Heis.mul_a, Heis.mul_b, Heis.mul_c]
    congr 1
    ring

private theorem heisSp4_injective [NeZero (2 : K)] : Function.Injective (heisSp4 (K := K)) := by
  intro x y hxy
  have h := congrArg (fun g : StatedSp 2 K =>
    ((g : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K)) hxy
  obtain ⟨-, hxa, hxb, hxc⟩ := heis_entries x.a x.b (2 * x.c - x.a * x.b)
  obtain ⟨-, hya, hyb, hyc⟩ := heis_entries y.a y.b (2 * y.c - y.a * y.b)
  have ha : x.a = y.a := by
    rw [← hxa, ← hya]
    exact congrFun (congrFun h _) _
  have hb : x.b = y.b := by
    rw [← hxb, ← hyb]
    exact congrFun (congrFun h _) _
  have hc : 2 * x.c - x.a * x.b = 2 * y.c - y.a * y.b := by
    rw [← hxc, ← hyc]
    exact congrFun (congrFun h _) _
  rw [ha, hb, sub_left_inj] at hc
  ext
  · exact ha
  · exact hb
  · exact mul_left_cancel₀ (NeZero.ne 2) hc

private def heisStatedSp (m : ℕ) : Heis K →* StatedSp (3 + m) K :=
  ((levi2 (3 + m)).comp (heisGL m)).codRestrict _ fun x => levi2_mem_statedSp _

theorem hasS2019SpecialQ_statedSp [Finite K] {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) [CharP K q]
    {n : ℕ} (hn : 2 ≤ n) : HasS2019SpecialQ q (Nat.card K) (StatedProj (StatedSp n K)) := by
  have h2 : (2 : K) ≠ 0 := by
    intro h
    have := (CharP.cast_eq_zero_iff K q 2).1 (by exact_mod_cast h)
    exact hq2 ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).1 this)
  haveI : NeZero (2 : K) := ⟨h2⟩
  rcases Nat.lt_or_ge n 3 with hn3 | hn3
  · obtain rfl : n = 2 := by omega
    refine hasS2019SpecialQ_statedProj (isS2019SpecialQ_heis hq hq2) heisSp4
      (eq_one_of_coe_eq_scalar heisSp4 heisSp4_injective (Sum.inl 0) fun x => ?_)
    exact (heis_entries _ _ _).1
  · obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hn3
    refine hasS2019SpecialQ_statedProj (isS2019SpecialQ_heis hq hq2) (heisStatedSp m) ?_
    exact eq_one_of_heisMat (heisStatedSp m) (fun i => Sum.inl (finSumFinEquiv (Sum.inl i)))
      (fun i j h => Sum.inl_injective (finSumFinEquiv.injective (Sum.inl_injective h)))
      fun x i j => by
        show (levi2 (3 + m) (heisGL m x) :
          Matrix (Fin (3 + m) ⊕ Fin (3 + m)) (Fin (3 + m) ⊕ Fin (3 + m)) K) _ _ = _
        rw [coe_levi2, fromBlocks_apply₁₁, heisGL_apply, blockGL_heisSL_apply]

end Symplectic

section Orthogonal

theorem hasS2019SpecialQ_statedOmega_plus [Finite K] {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2)
    [CharP K q] {k : ℕ} (hk : 3 ≤ k) (Q : (Fin k ⊕ Fin k → K) → K)
    (hQ : ∀ v, Q v = ∑ i, v (Sum.inl i) * v (Sum.inr i)) :
    HasS2019SpecialQ q (Nat.card K) (StatedProj (StatedOmega Q)) := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hk
  haveI : Group.IsPerfect (SpecialLinearGroup (Fin 3) K) :=
    CFSG.ClassicalModels.specialLinear_isPerfect_of_three_le le_rfl
  set ψ : SpecialLinearGroup (Fin 3) K →* GL (Fin (3 + m) ⊕ Fin (3 + m)) K :=
    (levi2 (3 + m)).comp (slGL m) with hψ
  have hiso : ∀ g v, Q ((ψ g : Matrix (Fin (3 + m) ⊕ Fin (3 + m)) (Fin (3 + m) ⊕ Fin (3 + m)) K) *ᵥ
      v) = Q v := fun g v => by
    rw [hQ, hQ]
    exact levi2_isometry _ v
  let φ : Heis K →* StatedOmega Q :=
    (ψ.codRestrict _ (mem_statedOmega_of_isPerfect Q ψ hiso)).comp heisSL
  refine hasS2019SpecialQ_statedProj (isS2019SpecialQ_heis hq hq2) φ ?_
  exact eq_one_of_heisMat φ (fun i => Sum.inl (finSumFinEquiv (Sum.inl i)))
    (fun i j h => Sum.inl_injective (finSumFinEquiv.injective (Sum.inl_injective h)))
    fun x i j => by
      show (levi2 (3 + m) (slGL m (heisSL x)) :
        Matrix (Fin (3 + m) ⊕ Fin (3 + m)) (Fin (3 + m) ⊕ Fin (3 + m)) K) _ _ = _
      rw [coe_levi2, fromBlocks_apply₁₁]
      exact blockGL_heisSL_apply m x i j

theorem hasS2019SpecialQ_statedOmega_tail [Finite K] {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2)
    [CharP K q] {T : Type} [Fintype T] [DecidableEq T] {k : ℕ} (hk : 3 ≤ k)
    (Q : (Fin k ⊕ (Fin k ⊕ T) → K) → K) (Q' : (T → K) → K)
    (hQ : ∀ v, Q v = ∑ i, v (Sum.inl i) * v (Sum.inr (Sum.inl i)) +
      Q' fun t => v (Sum.inr (Sum.inr t))) :
    HasS2019SpecialQ q (Nat.card K) (StatedProj (StatedOmega Q)) := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hk
  haveI : Group.IsPerfect (SpecialLinearGroup (Fin 3) K) :=
    CFSG.ClassicalModels.specialLinear_isPerfect_of_three_le le_rfl
  set ψ : SpecialLinearGroup (Fin 3) K →* GL (Fin (3 + m) ⊕ (Fin (3 + m) ⊕ T)) K :=
    (levi3 T (3 + m)).comp (slGL m) with hψ
  have hiso : ∀ g v, Q ((ψ g : Matrix (Fin (3 + m) ⊕ (Fin (3 + m) ⊕ T))
      (Fin (3 + m) ⊕ (Fin (3 + m) ⊕ T)) K) *ᵥ v) = Q v := fun g v => by
    rw [hQ, hQ]
    simp only [hψ, MonoidHom.comp_apply, levi3_mulVec_inl, levi3_mulVec_inr_inl,
      levi3_mulVec_inr_inr]
    rw [sum_mulVec_mul_mulVec _ _ (by rw [← transpose_mul, Units.inv_mul, transpose_one])]
  let φ : Heis K →* StatedOmega Q :=
    (ψ.codRestrict _ (mem_statedOmega_of_isPerfect Q ψ hiso)).comp heisSL
  refine hasS2019SpecialQ_statedProj (isS2019SpecialQ_heis hq hq2) φ ?_
  exact eq_one_of_heisMat φ (fun i => Sum.inl (finSumFinEquiv (Sum.inl i)))
    (fun i j h => Sum.inl_injective (finSumFinEquiv.injective (Sum.inl_injective h)))
    fun x i j => by
      show (levi3 T (3 + m) (slGL m (heisSL x)) :
        Matrix (Fin (3 + m) ⊕ (Fin (3 + m) ⊕ T)) (Fin (3 + m) ⊕ (Fin (3 + m) ⊕ T)) K) _ _ = _
      rw [coe_levi3, fromBlocks_apply₁₁]
      exact blockGL_heisSL_apply m x i j

end Orthogonal

theorem hasS2019SpecialQ_of_statedClassicalModel {Y : Type} [Group Y] {t : StatedLieTag}
    {n p f : ℕ} (hY : StatedClassicalModel Y t n p f) (hp2 : p ≠ 2) (hn : t = .PSL → 3 ≤ n) :
    HasS2019SpecialQ p (p ^ f) Y := by
  obtain ⟨⟨hp, hf, hadm⟩, hmod⟩ := hY
  cases t with
  | PSL =>
    obtain ⟨K, _, _, hK, ⟨e⟩⟩ := hmod
    haveI := CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic hp hf hK
    rw [← hK]
    exact (hasS2019SpecialQ_statedSL hp hp2 (hn rfl)).of_mulEquiv e.symm
  | PSU =>
    obtain ⟨K, _, _, hK, ⟨e⟩⟩ := hmod
    have h : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData p f K :=
      ⟨hp, hf, by rw [hK, ← pow_mul, mul_comm]⟩
    exact (hasS2019SpecialQ_statedSU h hp2 hadm.1).of_mulEquiv e.symm
  | PSp =>
    obtain ⟨K, _, _, hK, ⟨e⟩⟩ := hmod
    haveI := CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic hp hf hK
    rw [← hK]
    exact (hasS2019SpecialQ_statedSp hp hp2 hadm.1).of_mulEquiv e.symm
  | POmegaOdd =>
    obtain ⟨K, _, _, hK, ⟨e⟩⟩ := hmod
    haveI := CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic hp hf hK
    rw [← hK]
    exact (hasS2019SpecialQ_statedOmega_tail hp hp2 hadm.1 (StatedQuadOdd n K)
      (fun w => w () ^ 2) fun v => rfl).of_mulEquiv e.symm
  | POmegaPlus =>
    obtain ⟨K, _, _, hK, ⟨e⟩⟩ := hmod
    haveI := CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic hp hf hK
    rw [← hK]
    exact (hasS2019SpecialQ_statedOmega_plus hp hp2 (by have : 4 ≤ n := hadm; omega)
      (StatedQuadPlus n K) fun v => rfl).of_mulEquiv e.symm
  | POmegaMinus =>
    obtain ⟨K, _, _, hK, b, c, -, ⟨e⟩⟩ := hmod
    haveI := CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic hp hf hK
    rw [← hK]
    exact (hasS2019SpecialQ_statedOmega_tail hp hp2 (by have : 4 ≤ n := hadm; omega)
      (StatedQuadMinus n K b c) (fun w => w 0 ^ 2 + b * w 0 * w 1 + c * w 1 ^ 2)
      fun v => by rw [StatedQuadMinus]; ring).of_mulEquiv e.symm
  | _ => exact (show False from hmod).elim

end CFSG.LocalAnalysis.GLTheoremA.S2019
