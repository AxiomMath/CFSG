private theorem not_mem_map_of_inf_center_eq_bot {Ω : Type} [Group Ω] [Finite Ω]
    {S B N D K : Subgroup Ω} {x : Ω} (hcfg : Cfg173 3 S B N D K x) {E : Subgroup ↥S}
    (hEbot : E ⊓ Subgroup.center ↥S = ⊥) : x ∉ E.map S.subtype := by
  have hxcent : x ∈ Subgroup.centralizer (S : Set Ω) :=
    (hcfg.cent x hcfg.mem).2 (Subgroup.mem_zpowers x)
  intro hx
  obtain ⟨s, hs, hval⟩ := Subgroup.mem_map.mp hx
  have hxS : x ∈ S := by rw [← hval]; exact s.2
  have hcenter : (⟨x, hxS⟩ : ↥S) ∈ Subgroup.center ↥S := by
    rw [Subgroup.mem_center_iff]
    intro t
    apply Subtype.ext
    exact Subgroup.mem_centralizer_iff.mp hxcent (t : Ω) t.2
  have hmem : (⟨x, hxS⟩ : ↥S) ∈ E := by
    rw [show (⟨x, hxS⟩ : ↥S) = s from Subtype.ext hval.symm]
    exact hs
  have h1 : (⟨x, hxS⟩ : ↥S) = 1 := by
    have h2 : (⟨x, hxS⟩ : ↥S) ∈ E ⊓ Subgroup.center ↥S := ⟨hmem, hcenter⟩
    rw [hEbot] at h2
    simpa using h2
  exact hcfg.ne_one (by simpa using congrArg Subtype.val h1)

private theorem exists_elemAbelian_five_normalizer {Ω : Type} [Group Ω] [Finite Ω]
    {S B N D K : Subgroup Ω} {x : Ω} (hcfg : Cfg173 3 S B N D K x) {F : Type} [Field F]
    [Finite F] {n : ℕ} (hF : Nat.card F = (2 ^ n) ^ 2) (σ : F ≃+* F)
    (hσ : ∀ c, σ c = c ^ 2 ^ n) (h3 : 3 ∣ 2 ^ n + 1)
    (M : S172DModel S B (twistedE6RootGroup F σ) (twistedE6InndiagGL F σ)) :
    ∃ E U : Subgroup Ω, U ≠ ⊥ ∧ IsPGroup 2 U ∧ IsElemAbelian 3 E ∧
      Nat.card E = 3 ^ 5 ∧ E ≤ Subgroup.normalizer (U : Set Ω) := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hn : 1 ≤ n := by
    rcases Nat.eq_zero_or_pos n with h0 | h0
    · subst h0
      have h1 : Nat.card F = 1 := by simpa using hF
      exact absurd h1 (Finite.one_lt_card (α := F)).ne'
    · exact h0
  obtain ⟨σ₀, hσ₀, ε, -⟩ := TwE6Transport.exists_recipeConj (K := F) (n := n) hn hF
  have hσ_eq : σ₀ = σ := RingEquiv.ext (fun c => by rw [hσ₀ c, hσ c])
  subst hσ_eq
  obtain ⟨hsimple, -⟩ := TwE6Dvd.isSimpleGroup_recipeR (K := F) (n := n) hn hF
  let θ : ↥S ⧸ Subgroup.center ↥S ≃* TwE6Delta.RecipeR F n :=
    (QuotientGroup.quotientMulEquivOfEq M.ker_π).symm.trans
      ((QuotientGroup.quotientKerEquivOfSurjective M.π M.surj).trans ε)
  obtain ⟨U, hU, hU2, E, hEU, hEab, hEcase⟩ :=
    ggTwE6LocalRankInput_holds n hn h3 F hF hsimple ↥S hcfg.qs.1 θ
  let U' : Subgroup Ω := U.map S.subtype
  let E' : Subgroup Ω := E.map S.subtype
  have hU' : U' ≠ ⊥ := fun h =>
    hU ((Subgroup.map_eq_bot_iff_of_injective U S.subtype_injective).mp h)
  have hU'2 : IsPGroup 2 U' := hU2.map S.subtype
  have hE'el : IsElemAbelian 3 E' := hEab.map S.subtype
  have hE'N : E' ≤ Subgroup.normalizer (U' : Set Ω) :=
    (Subgroup.map_mono hEU).trans (Subgroup.le_normalizer_map (H := U) S.subtype)
  have hE'card : Nat.card E' = Nat.card E :=
    Subgroup.card_map_of_injective S.subtype_injective
  rcases hEcase with hE5 | ⟨hE4, hEbot⟩
  · exact ⟨E', U', hU', hU'2, hE'el, by rw [hE'card, hE5], hE'N⟩
  · have hxcent : x ∈ Subgroup.centralizer (S : Set Ω) :=
      (hcfg.cent x hcfg.mem).2 (Subgroup.mem_zpowers x)
    have hxE : x ∉ E' := not_mem_map_of_inf_center_eq_bot hcfg hEbot
    obtain ⟨hsupel, hsupcard⟩ := CFSG.Quasithin.H13.U3.elemAbelian_sup_zpowers hE'el hxE
      (hcfg.elem.2 x hcfg.mem)
      (fun a ha => Subgroup.mem_centralizer_iff.mp hxcent a (Subgroup.map_subtype_le E ha))
    have hxN : x ∈ Subgroup.normalizer (U' : Set Ω) :=
      (Subgroup.centralizer_le_normalizer (U' : Set Ω))
        (Subgroup.mem_centralizer_iff.mpr fun u hu =>
          Subgroup.mem_centralizer_iff.mp hxcent u (Subgroup.map_subtype_le U hu))
    refine ⟨_, U', hU', hU'2, hsupel, ?_, sup_le hE'N (Subgroup.zpowers_le.mpr hxN)⟩
    rw [hsupcard, hE'card, hE4]
    norm_num

theorem three_pow_four_le_card_barB_twE6 {Ω : Type} [Group Ω] [Finite Ω]
    {S B N D K : Subgroup Ω} {x : Ω} (hcfg : Cfg173 3 S B N D K x) {F : Type} [Field F]
    [Finite F] {n : ℕ} (hF : Nat.card F = (2 ^ n) ^ 2) (σ : F ≃+* F)
    (hσ : ∀ c, σ c = c ^ 2 ^ n) (h3 : 3 ∣ 2 ^ n + 1)
    (M : S172DModel S B (twistedE6RootGroup F σ) (twistedE6InndiagGL F σ)) :
    3 ^ 4 ≤ Nat.card M.barB := by
  obtain ⟨E, U, hU, hU2, hEel, hEcard, hEN⟩ :=
    exists_elemAbelian_five_normalizer hcfg hF σ hσ h3 M
  have hB5 : 3 ^ 5 ≤ Nat.card B := by
    rw [← hEcard, hcfg.bmax.2.1]
    exact card_le_pow_glaTwoLocalRank hcfg.prime hEel hU hU2 hEN
  have hB := S172DModel.card_eq_mul_card_barB hcfg M
  rw [hB] at hB5
  have h : 3 * 3 ^ 4 ≤ 3 * Nat.card M.barB := by
    calc 3 * 3 ^ 4 = 3 ^ 5 := by norm_num
      _ ≤ 3 * Nat.card M.barB := hB5
  exact Nat.le_of_mul_le_mul_left h (by norm_num)

