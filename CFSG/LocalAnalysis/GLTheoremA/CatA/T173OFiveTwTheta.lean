local notation "Γ₂" F => ModGL TwistTag.E6.tag F

theorem thetaTorus_le_twistedE6DiagGL {f : ℕ} (hf : 1 ≤ f) {k F : Type} [Field k] [Field F]
    [Algebra k F] (hk : Nat.card k = 2 ^ f) (hF : Nat.card F = (2 ^ f) ^ 2)
    {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f) :
    thetaTorus (algebraMap k F) ≤ twistedE6DiagGL F σ := by
  haveI : Finite k := Nat.finite_of_card_ne_zero (by rw [hk]; positivity)
  have hfix : TwistTag.E6.perm (e6Idx 1) = e6Idx 1 := by decide
  rintro g hg
  obtain ⟨a, rfl⟩ := (mem_thetaTorus (algebraMap k F)).1 hg
  rw [rootTorusSL2_e6HighestRoot]
  refine rootDiagUnit_mem_twistedE6DiagGL σ ?_
  intro i
  by_cases hi : i = e6Idx 1
  · subst hi
    rw [hfix]
    exact (Units.ext (fixed_algebraMap (sigma_eq_pow_card hk hσ) a)).symm
  · have hρ : TwistTag.E6.perm i ≠ e6Idx 1 := by
      intro h
      have hs : TwistTag.E6.perm.symm (e6Idx 1) = e6Idx 1 := by decide
      have h' := congrArg TwistTag.E6.perm.symm h
      rw [Equiv.symm_apply_apply, hs] at h'
      exact hi h'
    rw [Pi.mulSingle_eq_of_ne hρ, Pi.mulSingle_eq_of_ne hi, map_one]

theorem twistedE6DiagGL_le_normalizer_su6Levi {f : ℕ} (hf : 1 ≤ f) {k F : Type} [Field k]
    [Field F] [Algebra k F] (hk : Nat.card k = 2 ^ f) (hF : Nat.card F = (2 ^ f) ^ 2)
    {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f) :
    twistedE6DiagGL F σ ≤ Subgroup.normalizer (su6Levi σ.toRingHom : Set (Γ₂ F)) := by
  intro d hd
  obtain ⟨b, hb, rfl⟩ := (mem_twistedE6DiagGL_iff F σ).1 hd
  exact mem_normalizer_inf_of_mem_normalizer_twE6
    (rootDiagUnit_mem_normalizer_subsystemGroup setA b)
    (rootDiagUnit_mem_normalizer_graphFixedRootGroup hb)

private theorem rootChar_e6HighestRoot_fixed {f : ℕ} (hf : 1 ≤ f) {k F : Type} [Field k]
    [Field F] [Algebra k F] (hk : Nat.card k = 2 ^ f) (hF : Nat.card F = (2 ^ f) ^ 2)
    {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f) {b : Fin TwistTag.E6.tag.rank → Fˣ}
    (hb : TwCompat F σ.toRingHom b) :
    σ ((rootChar b e6HighestRoot : Fˣ) : F) = ((rootChar b e6HighestRoot : Fˣ) : F) := by
  haveI : Finite k := Nat.finite_of_card_ne_zero (by rw [hk]; positivity)
  have h2 : (2 : F) = 0 := two_eq_zero_of_card_sq hf hF
  have hxJ : pinnedX TwistTag.E6.tag F e6HighestRoot 1 ∈
      thetaRankOneGroup (algebraMap k F) :=
    Subgroup.mem_sup_left ((mem_thetaRootGroup (algebraMap k F)).2 ⟨1, by simp⟩)
  have hxC : pinnedX TwistTag.E6.tag F e6HighestRoot 1 ∈
      graphFixedRootGroup TwistTag.E6 F σ.toRingHom :=
    thetaRankOneGroup_le_C0 hf hk hF hσ hxJ
  have hdN := rootDiagUnit_mem_normalizer_graphFixedRootGroup (t := TwistTag.E6) (K := F)
    (σ := σ.toRingHom) hb
  have hyC : rootDiagUnit TwistTag.E6.tag b * pinnedX TwistTag.E6.tag F e6HighestRoot 1 *
      (rootDiagUnit TwistTag.E6.tag b)⁻¹ ∈ graphFixedRootGroup TwistTag.E6 F σ.toRingHom := by
    rw [← map_conj_rootDiagUnit_graphFixedRootGroup (t := TwistTag.E6) (K := F)
      (σ := σ.toRingHom) (b := b) hb]
    exact ⟨_, hxC, rfl⟩
  have hy : rootDiagUnit TwistTag.E6.tag b * pinnedX TwistTag.E6.tag F e6HighestRoot 1 *
      (rootDiagUnit TwistTag.E6.tag b)⁻¹ =
      pinnedX TwistTag.E6.tag F e6HighestRoot ((rootChar b e6HighestRoot : Fˣ) : F) := by
    rw [rootDiagUnit_conj_pinnedX b isRoot_e6HighestRoot 1, mul_one]
  have hfix := (mem_twistedFixedGroup_iff_twistHom TwistTag.E6 F σ.toRingHom).1
    (graphFixedRootGroup_le TwistTag.E6 F σ.toRingHom hyC) |>.2
  rw [hy, twistHom_pinnedX_eq_of_charTwo h2 σ.toRingHom isRoot_e6HighestRoot,
    permLattice_e6HighestRoot] at hfix
  exact pinnedX_injective TwistTag.E6.tag F e6HighestRoot hfix

private theorem exists_sq_rootChar_e6HighestRoot {f : ℕ} (hf : 1 ≤ f) {k F : Type} [Field k]
    [Field F] [Algebra k F] (hk : Nat.card k = 2 ^ f) (hF : Nat.card F = (2 ^ f) ^ 2)
    {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f) {b : Fin TwistTag.E6.tag.rank → Fˣ}
    (hb : TwCompat F σ.toRingHom b) :
    ∃ l : kˣ, Units.map (algebraMap k F).toMonoidHom l ^ 2 = rootChar b e6HighestRoot := by
  haveI : Finite k := Nat.finite_of_card_ne_zero (by rw [hk]; positivity)
  obtain ⟨μ, hμ⟩ := (sigma_eq_self_iff (f := f) (k := k) (K := F) (σ := σ.toRingHom) hk
    hσ _).1 (rootChar_e6HighestRoot_fixed hf hk hF hσ hb)
  have hμne : μ ≠ 0 := by
    intro h
    rw [h, map_zero] at hμ
    exact (rootChar b e6HighestRoot).ne_zero hμ.symm
  obtain ⟨l, hl⟩ := exists_sq_eq_of_two (two_eq_zero_of_card hf hk) (Units.mk0 μ hμne)
  refine ⟨l, ?_⟩
  rw [← map_pow, hl]
  exact Units.ext hμ

private theorem conj_rootDiagUnit_eq_conj_thetaTorus {f : ℕ} (hf : 1 ≤ f) {k F : Type} [Field k]
    [Field F] [Algebra k F] (hk : Nat.card k = 2 ^ f) (hF : Nat.card F = (2 ^ f) ^ 2)
    {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f) {b : Fin TwistTag.E6.tag.rank → Fˣ}
    (hb : TwCompat F σ.toRingHom b) {l : kˣ}
    (hl : Units.map (algebraMap k F).toMonoidHom l ^ 2 = rootChar b e6HighestRoot)
    {x : Γ₂ F} (hx : x ∈ thetaRankOneGroup (algebraMap k F)) :
    rootDiagUnit TwistTag.E6.tag b * x * (rootDiagUnit TwistTag.E6.tag b)⁻¹ =
      thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l) * x *
        (thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l))⁻¹ := by
  have h2 : (2 : F) = 0 := two_eq_zero_of_card_sq hf hF
  set u : Fˣ := Units.map (algebraMap k F).toMonoidHom l
  have hχ : ((u : F) ^ 2) = ((rootChar b e6HighestRoot : Fˣ) : F) := by
    have := congrArg (fun t : Fˣ => (t : F)) hl
    simpa only [Units.val_pow_eq_pow_val] using this
  have hneg : rootChar b (-e6HighestRoot) = (rootChar b e6HighestRoot)⁻¹ := by
    rw [show -e6HighestRoot = 0 - e6HighestRoot by ext i; simp, rootChar_sub, rootChar_zero,
      one_mul]
  have hχu : rootChar b (-e6HighestRoot) = (u⁻¹ : Fˣ) ^ 2 := by
    rw [hneg, ← hl, inv_pow]
  have hχneg : ((rootChar b (-e6HighestRoot) : Fˣ) : F) = (((u⁻¹ : Fˣ) : F) ^ 2) := by
    rw [hχu, Units.val_pow_eq_pow_val]
  rw [thetaRankOneGroup, Subgroup.sup_eq_closure] at hx
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
      rcases hy with hy | hy
      · obtain ⟨c, rfl⟩ := (mem_thetaRootGroup (algebraMap k F)).1 hy
        rw [rootDiagUnit_conj_pinnedX b isRoot_e6HighestRoot (algebraMap k F c),
          thetaTorusHom_apply, rootTorusSL2_conj_pinnedX h2 u (algebraMap k F c), ← hχ]
      · obtain ⟨c, rfl⟩ := (mem_thetaNegRootGroup (algebraMap k F)).1 hy
        rw [rootDiagUnit_conj_pinnedX b (IsRoot.neg isRoot_e6HighestRoot) (algebraMap k F c),
          thetaTorusHom_apply, rootTorusSL2_conj_pinnedX_neg h2 u (algebraMap k F c), hχneg]
  | one => simp
  | mul y z _ _ ihy ihz =>
      calc rootDiagUnit TwistTag.E6.tag b * (y * z) * (rootDiagUnit TwistTag.E6.tag b)⁻¹ =
          (rootDiagUnit TwistTag.E6.tag b * y * (rootDiagUnit TwistTag.E6.tag b)⁻¹) *
            (rootDiagUnit TwistTag.E6.tag b * z * (rootDiagUnit TwistTag.E6.tag b)⁻¹) :=
            by group
        _ = (thetaTorusHom F u * y * (thetaTorusHom F u)⁻¹) *
              (thetaTorusHom F u * z * (thetaTorusHom F u)⁻¹) := by rw [ihy, ihz]
        _ = thetaTorusHom F u * (y * z) * (thetaTorusHom F u)⁻¹ := by group
  | inv y _ ih =>
      calc rootDiagUnit TwistTag.E6.tag b * y⁻¹ * (rootDiagUnit TwistTag.E6.tag b)⁻¹ =
          (rootDiagUnit TwistTag.E6.tag b * y * (rootDiagUnit TwistTag.E6.tag b)⁻¹)⁻¹ :=
            by group
        _ = (thetaTorusHom F u * y * (thetaTorusHom F u)⁻¹)⁻¹ := by rw [ih]
        _ = thetaTorusHom F u * y⁻¹ * (thetaTorusHom F u)⁻¹ := by group

private lemma not_three_dvd_two_pow_sub_one {f : ℕ} (h3 : 3 ∣ 2 ^ f + 1) :
    ¬ 3 ∣ 2 ^ f - 1 := by
  intro h
  have hsub : 3 ∣ (2 ^ f + 1) - (2 ^ f - 1) := Nat.dvd_sub h3 h
  have htwo : (2 ^ f + 1) - (2 ^ f - 1) = 2 := by
    have := Nat.one_le_two_pow (n := f)
    omega
  rw [htwo] at hsub
  omega

private theorem exists_conj_eq_thetaTorus_of_mem_sup {f : ℕ} (hf : 1 ≤ f)
    {k F : Type} [Field k] [Field F] [Algebra k F] [Finite F]
    (hk : Nat.card k = 2 ^ f) (hF : Nat.card F = (2 ^ f) ^ 2)
    {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f) {a : Γ₂ F}
    (ha : a ∈ su6Levi σ.toRingHom ⊔ twistedE6DiagGL F σ) :
    ∃ l : kˣ, ∀ y ∈ thetaRankOneGroup (algebraMap k F),
      a * y * a⁻¹ = thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l) * y *
        (thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l))⁻¹ := by
  classical
  have h2 : (2 : F) = 0 := two_eq_zero_of_card_sq hf hF
  obtain ⟨hsu6C, -, -, -, -, -, -⟩ := su6Levi_facts hf hk hF (σ := σ.toRingHom) hσ
  have hTN := twistedE6DiagGL_le_normalizer_su6Levi hf hk hF hσ
  have ha' : a ∈ ((su6Levi σ.toRingHom ⊔ twistedE6DiagGL F σ : Subgroup (Γ₂ F)) :
    Set (Γ₂ F)) := ha
  rw [Subgroup.coe_mul_of_right_le_normalizer_left _ _ hTN] at ha'
  obtain ⟨s, hs, t, ht, rfl⟩ := ha'
  obtain ⟨b, hb, rfl⟩ := (mem_twistedE6DiagGL_iff F σ).1 ht
  obtain ⟨l, hl⟩ := exists_sq_rootChar_e6HighestRoot hf hk hF hσ hb
  refine ⟨l, fun y hy => ?_⟩
  set h : Γ₂ F := thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l)
  have hd : rootDiagUnit TwistTag.E6.tag b * y * (rootDiagUnit TwistTag.E6.tag b)⁻¹ =
      h * y * h⁻¹ := conj_rootDiagUnit_eq_conj_thetaTorus hf hk hF hσ hb hl hy
  have hW : h ∈ thetaTorus (algebraMap k F) :=
    (mem_thetaTorus (algebraMap k F)).2 ⟨l, (thetaTorusHom_apply _).symm⟩
  have hJ : h ∈ thetaRankOneGroup (algebraMap k F) :=
    thetaTorus_le_thetaRankOneGroup h2 (algebraMap k F) hW
  have hyJ : h * y * h⁻¹ ∈ thetaRankOneGroup (algebraMap k F) :=
    mul_mem (mul_mem hJ hy) (inv_mem hJ)
  have hsc : Commute s (h * y * h⁻¹) :=
    (Subgroup.mem_centralizer_iff.1 (hsu6C hs) (h * y * h⁻¹) hyJ).symm
  calc (s * rootDiagUnit TwistTag.E6.tag b) * y *
        (s * rootDiagUnit TwistTag.E6.tag b)⁻¹ =
      s * (rootDiagUnit TwistTag.E6.tag b * y * (rootDiagUnit TwistTag.E6.tag b)⁻¹) * s⁻¹ :=
        by group
    _ = s * (h * y * h⁻¹) * s⁻¹ := by rw [hd]
    _ = h * y * h⁻¹ := by rw [hsc.eq, mul_assoc, mul_inv_cancel, mul_one]

private theorem inv_mul_mem_centralizer_of_conj_eq {f : ℕ} (hf : 1 ≤ f) {k F : Type} [Field k]
    [Field F] [Algebra k F] {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f) {a : Γ₂ F} {l : kˣ}
    (hconj : ∀ y ∈ thetaRankOneGroup (algebraMap k F),
      a * y * a⁻¹ = thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l) * y *
        (thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l))⁻¹) :
    (thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l))⁻¹ * a ∈
      Subgroup.centralizer (thetaRankOneGroup (algebraMap k F) : Set (Γ₂ F)) := by
  set h : Γ₂ F := thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l)
  rw [Subgroup.mem_centralizer_iff]
  intro y hy
  have e := hconj y hy
  have hzy : (h⁻¹ * a) * y = y * (h⁻¹ * a) := by
    calc (h⁻¹ * a) * y = h⁻¹ * (a * y) := by group
      _ = h⁻¹ * (a * y * a⁻¹) * a := by group
      _ = h⁻¹ * (h * y * h⁻¹) * a := by rw [e]
      _ = y * (h⁻¹ * a) := by group
  exact hzy.symm

private theorem pow_thetaTorus_eq_one_of_conj_eq {f : ℕ} (hf : 1 ≤ f) {k F : Type} [Field k]
    [Field F] [Algebra k F] (hk : Nat.card k = 2 ^ f) (hF : Nat.card F = (2 ^ f) ^ 2)
    {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f) {n : ℕ} {a : Γ₂ F} {l : kˣ}
    (hconj : ∀ y ∈ thetaRankOneGroup (algebraMap k F),
      a * y * a⁻¹ = thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l) * y *
        (thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l))⁻¹)
    (haord : orderOf a ∣ 3 ^ n) :
    (thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l)) ^ (3 ^ n) = 1 := by
  have h2 : (2 : F) = 0 := two_eq_zero_of_card_sq hf hF
  set h : Γ₂ F := thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l)
  have hW : h ∈ thetaTorus (algebraMap k F) :=
    (mem_thetaTorus (algebraMap k F)).2 ⟨l, (thetaTorusHom_apply _).symm⟩
  have hJ : h ∈ thetaRankOneGroup (algebraMap k F) :=
    thetaTorus_le_thetaRankOneGroup h2 (algebraMap k F) hW
  have hzC := inv_mul_mem_centralizer_of_conj_eq hf hσ hconj
  have haeq : a = h * (h⁻¹ * a) := by group
  have hzh : Commute h (h⁻¹ * a) := Subgroup.mem_centralizer_iff.1 hzC h hJ
  have hpow : a ^ (3 ^ n) = 1 := (orderOf_dvd_iff_pow_eq_one).1 haord
  have hhpow : h ^ (3 ^ n) = ((h⁻¹ * a) ^ (3 ^ n))⁻¹ := by
    have e : (h * (h⁻¹ * a)) ^ (3 ^ n) = h ^ (3 ^ n) * (h⁻¹ * a) ^ (3 ^ n) := hzh.mul_pow _
    rw [← haeq, hpow] at e
    calc h ^ (3 ^ n) = h ^ (3 ^ n) * (h⁻¹ * a) ^ (3 ^ n) *
          ((h⁻¹ * a) ^ (3 ^ n))⁻¹ := by group
      _ = ((h⁻¹ * a) ^ (3 ^ n))⁻¹ := by rw [e.symm]; group
  have hhC : h ^ (3 ^ n) ∈ Subgroup.centralizer (thetaRankOneGroup (algebraMap k F) :
      Set (Γ₂ F)) := by
    rw [hhpow]
    exact inv_mem (pow_mem hzC _)
  have hhJ : h ^ (3 ^ n) ∈ thetaRankOneGroup (algebraMap k F) := pow_mem hJ _
  have hmem := Subgroup.mem_inf.2 ⟨hhJ, hhC⟩
  rw [thetaRankOneGroup_inf_eq_bot h2 (algebraMap k F)
    (C := Subgroup.centralizer (thetaRankOneGroup (algebraMap k F) : Set (Γ₂ F))) le_rfl,
    Subgroup.mem_bot] at hmem
  exact hmem

private theorem eq_one_of_pow_thetaTorus_eq_one {f : ℕ} (hf : 1 ≤ f) {k F : Type} [Field k]
    [Field F] [Algebra k F] [Finite F] (hk : Nat.card k = 2 ^ f)
    (hF : Nat.card F = (2 ^ f) ^ 2) {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f)
    {n : ℕ} {l : kˣ}
    (hpow : (thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l)) ^ (3 ^ n) = 1)
    (h3 : 3 ∣ 2 ^ f + 1) : l = 1 := by
  have h2 : (2 : F) = 0 := two_eq_zero_of_card_sq hf hF
  have hordh : orderOf (thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l)) ∣ 3 ^ n :=
    (orderOf_dvd_iff_pow_eq_one).2 hpow
  have hordl : orderOf l ∣ 2 ^ f - 1 := by
    have hd : orderOf l ∣ Nat.card kˣ := by
      have := Subgroup.orderOf_dvd_natCard (⊤ : Subgroup kˣ) (Subgroup.mem_top l)
      simpa using this
    rw [Nat.card_units, hk] at hd
    exact hd
  have hordhl : orderOf (thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l)) =
      orderOf l := by
    have e1 : orderOf (thetaTorusHom F (Units.map (algebraMap k F).toMonoidHom l)) =
        orderOf (Units.map (algebraMap k F).toMonoidHom l) :=
      orderOf_injective (thetaTorusHom F) (thetaTorusHom_injective h2) _
    have e2 : orderOf (Units.map (algebraMap k F).toMonoidHom l) = orderOf l :=
      orderOf_injective (Units.map (algebraMap k F).toMonoidHom)
        (Units.map_injective (algebraMap k F).injective) l
    rw [e1, e2]
  have hcop : Nat.Coprime (3 ^ n) (2 ^ f - 1) :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).2
      (not_three_dvd_two_pow_sub_one h3) |>.pow_left n
  have hdvd : orderOf l ∣ Nat.gcd (3 ^ n) (2 ^ f - 1) :=
    Nat.dvd_gcd (hordhl ▸ hordh) hordl
  rw [hcop.gcd_eq_one, Nat.dvd_one] at hdvd
  exact orderOf_eq_one_iff.1 hdvd

private theorem centralizes_of_mem_sup_twistedE6DiagGL_of_order_dvd {f : ℕ} (hf : 1 ≤ f)
    {k F : Type} [Field k] [Field F] [Algebra k F] [Finite F]
    (hk : Nat.card k = 2 ^ f) (hF : Nat.card F = (2 ^ f) ^ 2)
    {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f) (h3 : 3 ∣ 2 ^ f + 1) {n : ℕ} {a : Γ₂ F}
    (ha : a ∈ su6Levi σ.toRingHom ⊔ twistedE6DiagGL F σ)
    (haord : orderOf a ∣ 3 ^ n) :
    a ∈ Subgroup.centralizer (thetaRankOneGroup (algebraMap k F) : Set (Γ₂ F)) := by
  obtain ⟨l, hconj⟩ := exists_conj_eq_thetaTorus_of_mem_sup hf hk hF hσ ha
  have hpow := pow_thetaTorus_eq_one_of_conj_eq hf hk hF hσ hconj haord
  have hl1 := eq_one_of_pow_thetaTorus_eq_one hf hk hF hσ hpow h3
  refine Subgroup.mem_centralizer_iff.2 fun y hy => ?_
  have e' : a * y = y * a := by
    have e := hconj y hy
    rw [hl1] at e
    simp only [map_one, one_mul, inv_one, mul_one] at e
    calc a * y = (a * y * a⁻¹) * a := by group
      _ = y * a := by rw [e]
  exact e'.symm

theorem le_centralizer_thetaRankOneGroup {f : ℕ} (hf : 1 ≤ f) {k F : Type} [Field k] [Field F]
    [Algebra k F] [Finite F] (hk : Nat.card k = 2 ^ f) (hF : Nat.card F = (2 ^ f) ^ 2)
    {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f) (h3 : 3 ∣ 2 ^ f + 1) {A : Subgroup (Γ₂ F)}
    (hA3 : IsPGroup 3 A)
    (hAL : A ≤ graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxA5 ⊔
      twistedE6DiagGL F σ) :
    A ≤ Subgroup.centralizer (E6GraphLevi.thetaRankOneGroup (algebraMap k F) : Set (Γ₂ F)) := by
  haveI : Finite k := Nat.finite_of_card_ne_zero (by rw [hk]; positivity)
  haveI : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  haveI : Finite (ModGL TwistTag.E6.tag F) := finite_modGL
  have hsup := (su6Levi_facts hf hk hF (σ := σ.toRingHom) hσ).2.1
  have hW := thetaTorus_le_twistedE6DiagGL hf hk hF hσ
  have hL : graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxA5 ≤
      su6Levi σ.toRingHom ⊔ twistedE6DiagGL F σ := by
    rw [graphFixedParabolicLevi, show twE6MaxA5 = foldedSetA from rfl, orbitUnion_foldedSetA,
      ← hsup]
    exact sup_le_sup le_rfl hW
  have hAK : A ≤ su6Levi σ.toRingHom ⊔ twistedE6DiagGL F σ :=
    hAL.trans (sup_le hL le_sup_right)
  obtain ⟨n, hn⟩ := hA3.exists_card_eq
  intro a ha
  refine centralizes_of_mem_sup_twistedE6DiagGL_of_order_dvd hf hk hF hσ h3 (n := n) (hAK ha) ?_
  rw [← hn]
  exact Subgroup.orderOf_dvd_natCard A ha

private lemma uSL_mul_vSL_ne_one_charTwo {F : Type} [Field F] (h2 : (2 : F) = 0) :
    (uSL (1 : F) * vSL 1 : SL2 F) ≠ 1 := by
  intro h
  have h00 := congrArg (fun B : SL2 F => ((B : Matrix (Fin 2) (Fin 2) F)) 0 0) h
  have hz : ((uSL (1 : F) * vSL 1 : SL2 F) : Matrix (Fin 2) (Fin 2) F) 0 0 = 0 := by
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]
    simp [uSL, vSL]
    rw [show (1 : F) + 1 = 2 by ring, h2]
  rw [hz] at h00
  exact one_ne_zero h00.symm

private theorem orderOf_pinnedX_mul_theta {F : Type} [Field F] (h2 : (2 : F) = 0) :
    orderOf (pinnedX TwistTag.E6.tag F e6HighestRoot 1 *
      pinnedX TwistTag.E6.tag F (-e6HighestRoot) 1) = 3 := by
  have hcube : (pinnedX TwistTag.E6.tag F e6HighestRoot 1 *
      pinnedX TwistTag.E6.tag F (-e6HighestRoot) 1) ^ 3 = 1 := by
    rw [← E6GraphLevi.thetaSL2_uSL h2 1, ← E6GraphLevi.thetaSL2_vSL h2 1, ← map_mul,
      ← map_pow, E6GraphRootSL2.uSL_mul_vSL_pow_three h2, map_one]
  have hne : pinnedX TwistTag.E6.tag F e6HighestRoot 1 *
      pinnedX TwistTag.E6.tag F (-e6HighestRoot) 1 ≠ 1 := by
    intro h
    have h1 : (uSL (1 : F) * vSL 1 : SL2 F) = 1 :=
      E6GraphLevi.thetaSL2_injective h2 (by
        rw [map_mul, E6GraphLevi.thetaSL2_uSL h2 1, E6GraphLevi.thetaSL2_vSL h2 1, h, map_one])
    exact uSL_mul_vSL_ne_one_charTwo h2 h1
  exact orderOf_eq_prime (hp := ⟨Nat.prime_three⟩) hcube hne

theorem exists_involution_pair_thetaRankOneGroup {f : ℕ} (hf : 1 ≤ f) {k F : Type} [Field k]
    [Field F] [Algebra k F] [Finite F] (hk : Nat.card k = 2 ^ f) (hF : Nat.card F = (2 ^ f) ^ 2)
    {σ : F ≃+* F} (hσ : ∀ c, σ c = c ^ 2 ^ f) (h3 : 3 ∣ 2 ^ f + 1) :
    ∃ t ∈ E6GraphLevi.thetaRankOneGroup (algebraMap k F),
      ∃ s ∈ E6GraphLevi.thetaRankOneGroup (algebraMap k F), t ^ 2 = 1 ∧ s ^ 2 = 1 ∧
        (t * s) ^ 3 = 1 ∧
        t * s ∉ graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxA5 ⊔
          twistedE6DiagGL F σ := by
  classical
  haveI : Finite k := Nat.finite_of_card_ne_zero (by rw [hk]; positivity)
  haveI : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  have h2 : (2 : F) = 0 := two_eq_zero_of_card_sq hf hF
  have hF2 : Nat.card F = 2 ^ (2 * f) := by
    rw [hF, ← pow_mul, Nat.mul_comm f 2]
  haveI : Fintype F := Fintype.ofFinite F
  haveI : CharP F 2 := charP_of_card_eq_prime_pow (f := 2 * f)
    (by rw [Fintype.card_eq_nat_card]; exact hF2)
  have htJ : pinnedX TwistTag.E6.tag F e6HighestRoot 1 ∈
      thetaRankOneGroup (algebraMap k F) :=
    Subgroup.mem_sup_left ((mem_thetaRootGroup (algebraMap k F)).2 ⟨1, by simp⟩)
  have hsJ : pinnedX TwistTag.E6.tag F (-e6HighestRoot) 1 ∈
      thetaRankOneGroup (algebraMap k F) :=
    Subgroup.mem_sup_right ((mem_thetaNegRootGroup (algebraMap k F)).2 ⟨1, by simp⟩)
  have htsq : (pinnedX TwistTag.E6.tag F e6HighestRoot 1) ^ 2 = 1 :=
    ExceptionalCover.pinnedX_sq e6HighestRoot 1
  have hssq : (pinnedX TwistTag.E6.tag F (-e6HighestRoot) 1) ^ 2 = 1 :=
    ExceptionalCover.pinnedX_sq (-e6HighestRoot) 1
  have hts3 : (pinnedX TwistTag.E6.tag F e6HighestRoot 1 *
      pinnedX TwistTag.E6.tag F (-e6HighestRoot) 1) ^ 3 = 1 := by
    rw [← E6GraphLevi.thetaSL2_uSL h2 1, ← E6GraphLevi.thetaSL2_vSL h2 1, ← map_mul,
      ← map_pow, E6GraphRootSL2.uSL_mul_vSL_pow_three h2, map_one]
  refine ⟨_, htJ, _, hsJ, htsq, hssq, hts3, ?_⟩
  intro htsP
  have hord : orderOf (pinnedX TwistTag.E6.tag F e6HighestRoot 1 *
      pinnedX TwistTag.E6.tag F (-e6HighestRoot) 1) = 3 := orderOf_pinnedX_mul_theta h2
  have hsup := (su6Levi_facts hf hk hF (σ := σ.toRingHom) hσ).2.1
  have hW := thetaTorus_le_twistedE6DiagGL hf hk hF hσ
  have hL : graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxA5 ≤
      su6Levi σ.toRingHom ⊔ twistedE6DiagGL F σ := by
    rw [graphFixedParabolicLevi, show twE6MaxA5 = foldedSetA from rfl, orbitUnion_foldedSetA,
      ← hsup]
    exact sup_le_sup le_rfl hW
  have htsKT := (sup_le hL le_sup_right) htsP
  have htsC := centralizes_of_mem_sup_twistedE6DiagGL_of_order_dvd hf hk hF hσ h3 htsKT
    (n := 1) (by rw [hord]; norm_num)
  have htsZ : pinnedX TwistTag.E6.tag F e6HighestRoot 1 *
      pinnedX TwistTag.E6.tag F (-e6HighestRoot) 1 ∈
      thetaRankOneGroup (algebraMap k F) ⊓
        Subgroup.centralizer (thetaRankOneGroup (algebraMap k F) : Set (Γ₂ F)) :=
    Subgroup.mem_inf.2 ⟨mul_mem htJ hsJ, htsC⟩
  rw [thetaRankOneGroup_inf_eq_bot h2 (algebraMap k F)
    (C := Subgroup.centralizer (thetaRankOneGroup (algebraMap k F) : Set (Γ₂ F))) le_rfl,
    Subgroup.mem_bot] at htsZ
  rw [htsZ] at hord
  norm_num at hord

