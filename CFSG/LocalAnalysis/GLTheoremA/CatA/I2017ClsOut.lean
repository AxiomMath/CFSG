theorem outA8_of (hD4 : D4TwoNoA8) : OutA8 := by
  intro d hd hfin hsimp β hmem hβ3 hA8
  classical
  haveI := hfin
  haveI := hsimp
  have hcard := CFSG.HardMathSupport.Solomon.Coordinator.lieOrderBridge_holds d
    (TauCeti.CFSGIndex.lie d).Group ⟨MulEquiv.refl _⟩
  have hdvd : 20160 ∣ CFSG.HardMathSupport.Solomon.Coordinator.I1420.lieOrderFormula d.1 := by
    rw [← hcard]
    exact dvd_card_of_hasA8Comp hA8
  obtain ⟨K, hK, hKc, ⟨eK⟩⟩ := hA8
  have hna : ∃ a b : (TauCeti.CFSGIndex.lie d).Group, a * b ≠ b * a :=
    CFSG.LocalAnalysis.GLTheoremA.exists_mul_ne_mul_of_glaPComponent Nat.prime_three hK
  have hZ : Subgroup.center (TauCeti.CFSGIndex.lie d).Group = ⊥ :=
    CFSG.StandardType.center_eq_bot_of_isSimpleGroup_of_nonabelian hna
  have hperf : commutator (TauCeti.CFSGIndex.lie d).Group = ⊤ :=
    (CFSG.HardMathSupport.Solomon.Coordinator.b3Lie_isQuasisimple_of_simple hna).1
  let eZ : (TauCeti.CFSGIndex.lie d).Group ≃*
      (TauCeti.CFSGIndex.lie d).Group ⧸ Subgroup.center (TauCeti.CFSGIndex.lie d).Group :=
    ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm
  have hmZ := CFSG.Blueprint.LieModel.of_mulEquiv eZ
    (I2018Core.lieModel_specOf (S := (TauCeti.CFSGIndex.lie d).Group) d hd (MulEquiv.refl _))
  obtain ⟨-, labK, hlabK, hrawK⟩ :=
    CFSG.StandardType.Canonical.largeEvenMarking_of_lieModel_centerQuot hperf hmZ
  obtain ⟨_, _, _, _, -, -, -, htK, hrK, hcK, hfK⟩ :=
    CFSG.StandardType.Canonical.largeEvenRawDatum_exists hrawK
  have hlS : Y10F.HasLabel (TauCeti.CFSGIndex.lie d).Group (fun l => l = labK) :=
    ⟨hperf, labK, hlabK, CFSG.StandardType.Canonical.largeEvenRawDatum_mono
      (fun R _ I F ⟨hs, hna, θ, _⟩ => ⟨hs, hna, θ, rfl⟩) hrawK⟩
  have hKq : CFSG.Open.IsQuasisimple ↥K := hKc.2.2
  have hb : CFSG.Blueprint.LieModel (↥K ⧸ Subgroup.center ↥K) .PSL 4 2 1 :=
    (CFSG.ComponentClassification.SymmetricLocal.lie_model_linear_four_two_iff _).2 ⟨eK⟩
  obtain ⟨-, labJ, hlabJ, hrawJ⟩ :=
    CFSG.StandardType.Canonical.largeEvenMarking_of_lieModel_centerQuot hKq.1 hb
  obtain ⟨_, _, _, _, -, -, -, htJ, hrJ, hcJ, hfJ⟩ :=
    CFSG.StandardType.Canonical.largeEvenRawDatum_exists hrawJ
  have hcanJ : canonLabel labJ = ⟨.A, 3, 1⟩ := canonLabel_eq_of_psl_four_two htJ hrJ hcJ hfJ
  have hlJ : Y10F.HasLabel ↥K (fun l => l = labJ) :=
    ⟨hKq.1, labJ, hlabJ, CFSG.StandardType.Canonical.largeEvenRawDatum_mono
      (fun R _ I F ⟨hs, hna, θ, _⟩ => ⟨hs, hna, θ, rfl⟩) hrawJ⟩
  have hTri : Y10GField.TriPiece :=
    Y10GField.triPiece_of_innDiag Y10GField.innDiagOrth_holds Y10GField.innDiagExc_holds
  rcases Y10GField.cls_of_families Y10GField.ClsLin_holds Y10GField.ClsUni_holds
      Y10GField.ClsSymp_holds Y10GClsOrth.clsOrth_holds Y10GClsExc.clsExc_holds _ 3 β labK
      Nat.prime_three (by decide) hZ hlS hβ3 with hin | hfld | hD4l
  ·
    exfalso
    obtain ⟨hB, hG⟩ := tag_ne_of_markChar hcK
    by_cases htw : labK.tag = .twF4der
    · have hdt := eq_tits_of_tag htK htw
      rw [hdt] at hdvd
      exact not_dvd_lieOrder_tits hdvd
    · exact hmem (mem_innAutDerived_of_innDiagKind_nd
        CFSG.StandardType.ggInndiagCommRestInput_holds hZ ⟨hB, hG, htw⟩ hin)
  · by_cases htri : labK.tag = .triD4
    ·
      exfalso
      have hFR := hTri _ 3 β K labK labJ rfl hZ hlS (Or.inl htri) hβ3 hlJ hK
      have h1 := markDeg_eq_one_of_fieldRel hcanJ (Or.inl htri) hFR
      have hdt := eq_triD4_two hd (by rw [← htK]; exact mark_triD4 htri) (by rw [← hfK]; exact h1)
      rw [hdt] at hdvd
      exact not_dvd_lieOrder_triD4_two hdvd
    ·
      have hF := Y10GField.fld_of_families
        (Y10GField.fldLin_of_labelDict Y10GInnLin.linLabelDict_holds)
        (Y10GFldUni.fldUni_of_sigmaPow Y10GFldUniSig.uniSigmaPowOne_holds)
        Y10GField.fldSymp_holds Y10GFldOrth.fldOrth_holds
        (Y10GField.fldExc_of_gaps Y10GField.fixGapG2_holds Y10GField.fixGapE6_holds
          Y10GField.fixGapTwE6_holds Y10GField.fixGapTriD4_holds Y10GField.fixGapTwB2_holds
          Y10GField.fixGapTwF4_holds)
        _ 3 β K labK labJ Nat.prime_three (by decide) hZ hfld (fun h => htri h.1) hβ3 hlJ hK
      obtain ⟨ht, hr, hf⟩ := mark_of_fld hcanJ hF
      exact Or.inl (eq_A_three_eight hd (by rw [← htK]; exact ht) (by rw [← hrK]; exact hr)
        (by rw [← hfK]; exact hf))
  ·
    exfalso
    have hFR := hTri _ 3 β K labK labJ rfl hZ hlS (Or.inr ⟨hD4l.1, hD4l.2.1⟩) hβ3 hlJ hK
    have h1 := markDeg_eq_one_of_fieldRel hcanJ (Or.inr ⟨hD4l.1, hD4l.2.1⟩) hFR
    obtain ⟨ht, hr⟩ := mark_D4 hD4l.1 hD4l.2.1
    have hdD := eq_D4_two hd (by rw [← htK]; exact ht) (by rw [← hrK]; exact hr)
      (by rw [← hfK]; exact h1)
    exact hD4 d hdD hfin hsimp β hβ3 (fun h => hmem (by rw [h]; exact Subgroup.one_mem _))
      ⟨K, hK, hKc, ⟨eK⟩⟩

