@[expose] def D4TwoNoA8 : Prop :=
  ∀ d : TauCeti.ValidLieTypeIndex, d.1 = .D 4 gfTwoPP → Finite (TauCeti.CFSGIndex.lie d).Group →
    IsSimpleGroup (TauCeti.CFSGIndex.lie d).Group →
    ∀ β : MulAut (TauCeti.CFSGIndex.lie d).Group, β ^ 3 = 1 → β ≠ 1 → ¬ HasA8Comp β

theorem dvd_card_of_hasA8Comp {T : Type} [Group T] {β : MulAut T} (h : HasA8Comp β) :
    20160 ∣ Nat.card T := by
  obtain ⟨K, -, -, ⟨eK⟩⟩ := h
  have h1 : Nat.card (↥K ⧸ Subgroup.center ↥K) = 20160 := by
    rw [Nat.card_congr eK.toEquiv]
    exact CFSG.LocalAnalysis.GLTheoremB.MovingAround.AltFacts4.card_alt_eight
  have h2 := Subgroup.card_quotient_dvd_card (Subgroup.center ↥K)
  rw [h1] at h2
  exact h2.trans (Subgroup.card_subgroup_dvd_card K)

theorem not_dvd_lieOrder_tits :
    ¬ 20160 ∣ CFSG.HardMathSupport.Solomon.Coordinator.I1420.lieOrderFormula .tits := by
  simp only [CFSG.HardMathSupport.Solomon.Coordinator.I1420.lieOrderFormula, CFSG.Open.orderTits]
  norm_num

theorem not_dvd_lieOrder_triD4_two :
    ¬ 20160 ∣ CFSG.HardMathSupport.Solomon.Coordinator.I1420.lieOrderFormula
      (.trialityD4 gfTwoPP) := by
  simp only [CFSG.HardMathSupport.Solomon.Coordinator.I1420.lieOrderFormula,
    CFSG.Open.orderTrialityD4, gfTwoPP, TauCeti.PrimePower.card_def]
  norm_num

private theorem canonLabel_eq_of_psl_four_two {lab : GLALabel} (ht : markTag lab = .PSL)
    (hr : markRank lab = 4) (hc : markChar lab = 2) (hf : markDeg lab = 1) :
    canonLabel lab = ⟨.A, 3, 1⟩ := by
  obtain ⟨t, r, n⟩ := lab
  by_cases h3 : r = 3 <;> by_cases h2 : r = 2 <;> cases t <;>
    simp_all [markTag, markRank, markChar, markDeg, canonLabel]

private theorem mark_of_fld {lab labJ : GLALabel} (hJ : canonLabel labJ = ⟨.A, 3, 1⟩)
    (h : (canonLabel lab).n = 3 * (canonLabel labJ).n ∧ (canonLabel lab).tag = (canonLabel labJ).tag ∧
      (canonLabel lab).rank = (canonLabel labJ).rank) :
    markTag lab = .PSL ∧ markRank lab = 4 ∧ markDeg lab = 3 := by
  rw [hJ] at h
  obtain ⟨h1, h2, h3⟩ := h
  obtain ⟨t, r, n⟩ := lab
  by_cases hr3 : r = 3 <;> by_cases hr2 : r = 2 <;> cases t <;>
    simp_all [markTag, markRank, markDeg, canonLabel]

private theorem markDeg_eq_one_of_fieldRel {lab labJ : GLALabel} (hJ : canonLabel labJ = ⟨.A, 3, 1⟩)
    (ht : lab.tag = .triD4 ∨ (lab.tag = .D ∧ lab.rank = 4))
    (h : FieldRel 3 (canonLabel lab) (canonLabel labJ)) : markDeg lab = 1 := by
  rw [hJ] at h
  obtain ⟨t, r, n⟩ := lab
  rcases ht with ht | ⟨ht, hr⟩
  · simp only at ht
    subst ht
    simp_all [FieldRel, canonLabel, markDeg]
  · simp only at ht hr
    subst ht hr
    simp_all [FieldRel, canonLabel, markDeg]

private theorem tag_ne_of_markChar {lab : GLALabel} (h : markChar lab = 2) :
    lab.tag ≠ .B2der ∧ lab.tag ≠ .G2der := by
  obtain ⟨t, r, n⟩ := lab
  cases t <;> simp_all [markChar]

private theorem eq_tits_of_tag {lab : GLALabel} {d : TauCeti.LieTypeIndex}
    (ht : markTag lab = (I2018Core.specOf d).1) (h : lab.tag = .twF4der) : d = .tits := by
  obtain ⟨t, r, n⟩ := lab
  simp only at h
  subst h
  cases d <;> simp_all [markTag, I2018Core.specOf]

private theorem mark_triD4 {lab : GLALabel} (ht : lab.tag = .triD4) : markTag lab = .trialityD4 := by
  obtain ⟨t, r, n⟩ := lab
  simp only at ht
  subst ht
  rfl

private theorem mark_D4 {lab : GLALabel} (ht : lab.tag = .D) (hr : lab.rank = 4) :
    markTag lab = .POmegaPlus ∧ markRank lab = 4 := by
  obtain ⟨t, r, n⟩ := lab
  simp only at ht hr
  subst ht hr
  simp [markTag, markRank]

private theorem eq_A_three_eight {d : TauCeti.LieTypeIndex} (hd : d.characteristic = 2)
    (ht : (I2018Core.specOf d).1 = .PSL) (hr : (I2018Core.specOf d).2.1 = 4)
    (hf : (I2018Core.specOf d).2.2 = 3) : d = .A 3 gfEightPP := by
  cases d <;> simp only [I2018Core.specOf, reduceCtorEq] at ht hr hf
  rename_i r q
  have hp : q.p = 2 := by simpa using hd
  obtain rfl : r = 3 := by omega
  exact congrArg _ (TauCeti.PrimePower.ext hp hf)

private theorem eq_triD4_two {d : TauCeti.LieTypeIndex} (hd : d.characteristic = 2)
    (ht : (I2018Core.specOf d).1 = .trialityD4) (hf : (I2018Core.specOf d).2.2 = 1) :
    d = .trialityD4 gfTwoPP := by
  cases d <;> simp only [I2018Core.specOf, reduceCtorEq] at ht hf
  rename_i q
  have hp : q.p = 2 := by simpa using hd
  exact congrArg _ (TauCeti.PrimePower.ext hp hf)

private theorem eq_D4_two {d : TauCeti.LieTypeIndex} (hd : d.characteristic = 2)
    (ht : (I2018Core.specOf d).1 = .POmegaPlus) (hr : (I2018Core.specOf d).2.1 = 4)
    (hf : (I2018Core.specOf d).2.2 = 1) : d = .D 4 gfTwoPP := by
  cases d <;> simp only [I2018Core.specOf, reduceCtorEq] at ht hr hf
  rename_i r q
  have hp : q.p = 2 := by simpa using hd
  subst hr
  exact congrArg _ (TauCeti.PrimePower.ext hp hf)

