private theorem central_congr {G H : Type} [Group G] [Group H] (Φ : G ≃* H) {β : MulAut G}
    (hβ : ¬ D4Y.NotCentralOut β) (γ : MulAut H) :
    γ * MulAut.congr Φ β * γ⁻¹ * (MulAut.congr Φ β)⁻¹ ∈ inner H := by
  have h1 : MulAut.congr Φ.symm γ * β * (MulAut.congr Φ.symm γ)⁻¹ * β⁻¹ ∈ inner G :=
    not_not.1 fun h => hβ ⟨_, h⟩
  have hγ : MulAut.congr Φ (MulAut.congr Φ.symm γ) = γ :=
    MulEquiv.ext fun y => by simp [MulAut.congr_apply]
  have h3 : MulAut.congr Φ (MulAut.congr Φ.symm γ * β * (MulAut.congr Φ.symm γ)⁻¹ * β⁻¹) =
      γ * MulAut.congr Φ β * γ⁻¹ * (MulAut.congr Φ β)⁻¹ := by
    rw [map_mul, map_mul, map_mul, map_inv, map_inv, hγ]
  rw [← h3, ← inner_map_congr Φ]
  exact ⟨_, h1, rfl⟩

private theorem mem_layer_of_fix {G : Type} [Group G] [Finite G]
    (hS : StatedClassicalModel G .POmegaPlus 4 2 3) {F₀ : Type} [Field F₀] [Finite F₀]
    (hF₀ : Nat.card F₀ = 2 ^ 3) (e₀ : G ≃* StatedProj (StatedOmega (StatedQuadPlus 4 F₀)))
    (φ₀ : G ≃* matrixProjectiveDerived (coordinateQuadPlus 4 F₀)) {β : MulAut G}
    (hβ3 : β ^ 3 = 1) (g : similarityPairs (coordinateQuadPlus 4 F₀))
    (hag : matrixProjectiveConjugationHom (coordinateQuadPlus 4 F₀) g = MulAut.congr φ₀ β)
    (hσ1 : g.val.right ≠ 1) {c : G} (hfix : β c = c) (hc3 : c ^ 3 = 1) :
    c ∈ GLAPLayer 3 (fixSubgroup β) := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have haE : MulAut.congr φ₀ β ∈ matrixProjectiveImage (coordinateQuadPlus 4 F₀) := ⟨g, hag⟩
  obtain ⟨-, ⟨ψ, hψg, hψker, -⟩, -⟩ := orthogonal_large_prime_semilinear_field_and_diagonal_gates
    G .POmegaPlus (Or.inr (Or.inl rfl)) 4 2 3 hS F₀ hF₀ e₀
  have haD : MulAut.congr φ₀ β ∉ (linearConjugationHom (coordinateQuadPlus 4 F₀)).range := by
    intro hD
    have hmem : (⟨_, haE⟩ : matrixProjectiveImage (coordinateQuadPlus 4 F₀)) ∈ ψ.ker := by
      rw [hψker]
      exact hD
    have h1 : ψ ⟨_, haE⟩ = g.val.right := by
      rw [← hψg g]
      congr 1
      exact Subtype.ext hag.symm
    rw [MonoidHom.mem_ker, h1] at hmem
    exact hσ1 hmem
  have hap : orderOf (MulAut.congr φ₀ β) = 3 :=
    orderOf_eq_prime (by rw [← map_pow, hβ3, map_one]) fun h => haD (h ▸ Subgroup.one_mem _)
  obtain ⟨-, hdesc⟩ := D4YH.plus_descent3 Nat.prime_three (by norm_num) G hS F₀ hF₀ e₀ _ haE
    haD hap
  obtain ⟨hord, -, U, _, _, hUκ, hUr, -, hPlus⟩ := hdesc g.val.right ⟨g, hag, rfl⟩
  obtain ⟨_, _, -, -, _, _, -, -, -, Θ, -, g', hg'l, hg'r, hΘ⟩ := hPlus
  have SS := subfieldSetup_plus (semilinearFixedSubfield U.val.right)
    (fun _ => RingHom.mem_eqLocusField) Nat.prime_three (by norm_num) (by rw [hUr]; exact hord)
    (by norm_num : 3 ≤ 4)
  set k := semilinearFixedSubfield U.val.right with hk
  let φ : G ≃* matrixProjectiveDerived (coordinateQuadPlus 4 F₀) := φ₀.trans Θ
  have he : MulAut.congr φ β = fieldAutT (coordinateQuadPlus 4 F₀) U.val.right SS.hQσ := by
    have hg' : g' = fieldPair (coordinateQuadPlus 4 F₀) U.val.right SS.hQσ :=
      Subtype.ext (SemidirectProduct.ext hg'l hg'r)
    refine MulEquiv.ext fun y => ?_
    have h1 : MulAut.congr φ β y = Θ (matrixProjectiveConjugationHom _ U (Θ.symm y)) := by
      rw [hUκ]
      rfl
    rw [h1, hΘ, MulEquiv.apply_symm_apply, hg']
    rfl
  set N := subfieldFixedGroup k (coordinateQuadPlus 4 ↥k) (coordinateQuadPlus 4 F₀) with hN
  set J₀ := subfieldDerivedImage k SS.hext with hJ₀
  have hNβ : ∀ t, t ∈ N ↔ β (φ.symm t) = φ.symm t := fun t => by
    rw [← fieldAutT_apply_iff SS, ← he, MulAut.congr_apply]
    exact φ.apply_eq_iff_eq_symm_apply
  have hcN : φ c ∈ N := by
    rw [hNβ, MulEquiv.symm_apply_apply]
    exact hfix
  haveI hJn := subfieldDerivedImage_normal k SS.hext
  have hcJ : φ c ∈ J₀ := by
    have hx3 : (⟨φ c, hcN⟩ : ↥N) ^ 3 = 1 := Subtype.ext (by
      rw [Subgroup.coe_pow, ← map_pow, hc3, map_one]
      rfl)
    obtain ⟨n, hn⟩ := fixedGroup_quotient_isPGroup k SS.hext SS.hnd₀ SS.hT₀
      (QuotientGroup.mk (⟨φ c, hcN⟩ : ↥N) : ↥N ⧸ J₀.subgroupOf N)
    have h1 := pow_gcd_eq_one.2 ⟨hn, (by rw [← QuotientGroup.mk_pow, hx3, QuotientGroup.mk_one] :
      (QuotientGroup.mk (⟨φ c, hcN⟩ : ↥N) : ↥N ⧸ J₀.subgroupOf N) ^ 3 = 1)⟩
    rw [(Nat.Coprime.pow_left n (by norm_num : Nat.Coprime 2 3)).gcd_eq_one, pow_one,
      QuotientGroup.eq_one_iff] at h1
    exact h1
  by_cases hc1 : c = 1
  · rw [hc1]
    exact Subgroup.one_mem _
  have hd : 0 < 2 * 4 := by norm_num
  haveI : Finite ↥k := Finite.of_injective (algebraMap k F₀) (algebraMap k F₀).injective
  haveI : Finite (matrixProjectiveDerived (coordinateQuadPlus 4 F₀)) :=
    Finite.of_equiv G φ.toEquiv
  obtain ⟨hsimp, a₁, b₁, hab⟩ := matrix_simple_nonabelian hd SS.hnd₀ SS.hT₀
  have h3J : 3 ∣ Nat.card ↥J₀ := by
    have h1 : orderOf (⟨φ c, hcJ⟩ : ↥J₀) = 3 := by
      rw [Subgroup.orderOf_mk, MulEquiv.orderOf_eq]
      exact orderOf_eq_prime hc3 hc1
    exact h1 ▸ orderOf_dvd_natCard _
  have hcomp := CFSG.LocalAnalysis.GLTheoremB.MovingAround.Claims126.glaPComponent_of_simple_normal
    Nat.prime_three (subfieldDerivedImage_le k SS.hext) hJn
    (inclEquiv k SS.hext hd).symm.isSimpleGroup
    ⟨inclEquiv k SS.hext hd a₁, inclEquiv k SS.hext hd b₁, fun h => hab
      ((inclEquiv k SS.hext hd).injective (by rw [map_mul, map_mul]; exact h))⟩ h3J
  have hle : J₀ ≤ GLAPLayer 3 N := le_sSup hcomp
  have hlay : φ c ∈ GLAPLayer 3 N := hle hcJ
  have hNmap : N = (fixSubgroup β).map φ.toMonoidHom := by
    ext t
    rw [Subgroup.mem_map_equiv, mem_fixSubgroup]
    exact hNβ t
  rw [hNmap, ← CFSG.glaPLayer_map_eq_of_injective Nat.prime_three _ φ.injective,
    Subgroup.mem_map_equiv, MulEquiv.symm_apply_apply] at hlay
  exact hlay

theorem d4eight_eq_conj_mul_pow {G : Type} [Group G] [Finite G]
    (hS : StatedClassicalModel G .POmegaPlus 4 2 3) {β β' : MulAut G} (hβ3 : β ^ 3 = 1)
    (hβ'3 : β' ^ 3 = 1) (hcomm : β * β' = β' * β) (hβc : ¬ D4Y.NotCentralOut β)
    (hβ'c : ¬ D4Y.NotCentralOut β') (hout : ∀ a : G, MulAut.conj a ≠ β) :
    ∃ (c : G) (m : ℕ), c ∈ GLAPLayer 3 (fixSubgroup β) ∧ β' = MulAut.conj c * β ^ m := by
  classical
  obtain ⟨-, F₀, _, _, hF₀, ⟨e₀⟩⟩ := id hS
  haveI : CharP F₀ 2 := CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic
    Nat.prime_two (by norm_num) hF₀
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hQne : ∃ v, coordinateQuadPlus 4 F₀ v ≠ 0 :=
    ⟨stdU F₀, by rw [coordinateQuadPlus_stdU]; exact one_ne_zero⟩
  let Λ := derivedProjEquiv (coordinateQuadPlus 4 F₀) hQne
  let Φ : G ≃* Om8 F₀ := (coordinatePlusWitnessEquiv F₀ e₀).trans Λ.symm
  have hinj : Function.Injective (MulAut.conj : G →* MulAut G) := fun a a' h =>
    Φ.injective (D4YF.conj_injective_om8' (by rw [← congr_conj, ← congr_conj, h]))
  have hα := T1428.t1428_mem_sup_of_central (α := MulAut.congr Φ β)
    (by rw [← map_pow, hβ3, map_one]) (central_congr Φ hβc)
  have hα' := T1428.t1428_mem_sup_of_central (α := MulAut.congr Φ β')
    (by rw [← map_pow, hβ'3, map_one]) (central_congr Φ hβ'c)
  obtain ⟨g, σ, ι, hι, hαeq, hgc, hgr⟩ := D4YH.exists_pair_of_mem_sup hα
  obtain ⟨-, σ', ι', hι', hα'eq, -, -⟩ := D4YH.exists_pair_of_mem_sup hα'
  have hσ1 : σ ≠ 1 := by
    rintro rfl
    rw [map_one, mul_one] at hαeq
    obtain ⟨u, hu⟩ := hι
    refine hout (Φ.symm u) ((MulAut.congr Φ).injective ?_)
    rw [congr_conj, MulEquiv.apply_symm_apply, hu, hαeq]
  have hσ3 := CFSG.RankThree.PartTwo.Sec8.Hering88LC.ringEquiv_pow_three_of_card_eight hF₀
  obtain ⟨m, hm⟩ : ∃ m : ℕ, σ' = σ ^ m := by
    by_cases h1 : σ' = 1
    · exact ⟨0, by rw [h1, pow_zero]⟩
    rcases CFSG.RankThree.PartTwo.Sec8.Hering418.ringAut_order_three_rel Nat.prime_two
      (by norm_num) hF₀ (orderOf_eq_prime (hσ3 σ) hσ1) (orderOf_eq_prime (hσ3 σ') h1) with h | h
    · exact ⟨1, by rw [h, pow_one]⟩
    · exact ⟨2, by rw [h]; exact inv_eq_of_mul_eq_one_right (by rw [← pow_succ']; exact hσ3 σ)⟩
  have hmem : MulAut.congr Φ β' * (MulAut.congr Φ β ^ m)⁻¹ ∈ inner (Om8 F₀) := by
    have hπ : ∀ {y}, y ∈ inner (Om8 F₀) → QuotientGroup.mk' (inner (Om8 F₀)) y = 1 :=
      fun hy => (QuotientGroup.eq_one_iff _).2 hy
    rw [← QuotientGroup.ker_mk' (inner (Om8 F₀)), MonoidHom.mem_ker, map_mul, map_inv, map_pow,
      hαeq, hα'eq, map_mul, map_mul, hπ hι, hπ hι', one_mul, one_mul, hm, map_pow, map_pow,
      mul_inv_cancel]
  obtain ⟨u, hu⟩ := hmem
  have hcu : MulAut.conj (Φ.symm u) = β' * (β ^ m)⁻¹ := by
    apply (MulAut.congr Φ).injective
    rw [congr_conj, MulEquiv.apply_symm_apply, hu, map_mul, map_inv, map_pow]
  refine ⟨Φ.symm u, m, ?_, by rw [hcu, inv_mul_cancel_right]⟩
  have hC : Commute β (β' * (β ^ m)⁻¹) := Commute.mul_right hcomm (Commute.self_pow β m).inv_right
  have hconj : MulAut.conj (β (Φ.symm u)) = β * MulAut.conj (Φ.symm u) * β⁻¹ := by
    ext y
    simp [MulAut.mul_apply, MulAut.conj_apply]
  have hag : matrixProjectiveConjugationHom (coordinateQuadPlus 4 F₀) g =
      MulAut.congr (Φ.trans Λ) β := by
    ext x
    obtain ⟨A, rfl⟩ := Λ.surjective x
    have h1 : matrixProjectiveConjugationHom (coordinateQuadPlus 4 F₀) g (Λ A) =
        Λ (matrixDerivedConjugation (coordinateQuadPlus 4 F₀) g A) :=
      matrixProjectiveConjugation_mk _ g A
    have h2 : (MulAut.congr (Φ.trans Λ) β) (Λ A) = Λ (MulAut.congr Φ β A) := by
      simp [MulAut.congr_apply]
    rw [h1, h2, ← hgc]
    rfl
  refine mem_layer_of_fix hS hF₀ e₀ (Φ.trans Λ) hβ3 g hag (by rwa [hgr])
    (hinj (by rw [hconj, hcu, hC.eq, mul_inv_cancel_right])) (hinj ?_)
  rw [map_pow, map_one, hcu, ((Commute.pow_right hcomm.symm m).inv_right).mul_pow, hβ'3,
    inv_pow, ← pow_mul, mul_comm m 3, pow_mul, hβ3, one_pow, inv_one, one_mul]

end CFSG.LocalAnalysis.GLTheoremA.S265

