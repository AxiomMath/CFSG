private theorem lieModel_of_catalogIs_A {S : Type} [Group S] {N n : ℕ}
    (hcat : catalogIs S (onLie fun i =>
      ∃ q : TauCeti.PrimePower, i = .A (N - 1) q ∧ q.card = 2 ^ n)) :
    CFSG.Blueprint.LieModel S .PSL N 2 n := by
  obtain ⟨d, hv, ⟨q, rfl, hq⟩, ⟨e⟩⟩ := exists_lieIndex hcat
  have hN : 2 ≤ N := by
    have hrange := (TauCeti.LieTypeIndex.valid_iff _).mp hv |>.1
    rw [TauCeti.LieTypeIndex.inStandardRange_iff] at hrange
    omega
  have hLM := CFSG.Models.lieModel_A (N - 1) q hv e
  have hp2 : q.p = 2 := by
    have hdiv : q.p ∣ 2 ^ n := by
      rw [← hq, TauCeti.PrimePower.card_def]
      exact dvd_pow_self q.p (Nat.ne_of_gt q.exponent_pos)
    have hd := (Nat.Prime.dvd_of_dvd_pow q.prime_p hdiv)
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h1
    · exact absurd h1 q.prime_p.ne_one
    · exact h1
  have hq' : q.p ^ q.exponent = 2 ^ n := by simpa using hq
  have hqn : q.exponent = n := by
    rw [hp2] at hq'
    exact Nat.pow_right_injective (le_refl 2) hq'
  exact CFSG.Models.LieModel.toBlueprint (by simp [CFSG.Blueprint.classicalTags]) (by
    rwa [show N - 1 + 1 = N by omega, hp2, hqn] at hLM)

