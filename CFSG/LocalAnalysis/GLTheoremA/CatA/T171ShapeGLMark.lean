private theorem label_linear {X : Type} [Group X] {lab : LargeEvenLabel} {N n : ℕ}
    (hM : MarkedModel lab X) (hX : CFSG.Blueprint.LieModel X .PSL N 2 n)
    (h12 : ¬ (N = 2 ∧ n = 2)) (h13 : ¬ (N = 3 ∧ n = 1)) :
    (lab.tag = .A ∧ lab.rank = N - 1 ∧ lab.n = n) ∨
    (lab.tag = .D ∧ lab.rank = 3 ∧ lab.n = n ∧ N = 4) ∨
    (lab.tag = .twD ∧ lab.rank = 2 ∧ 2 * lab.n = n ∧ N = 2) := by
  have hdet : markTag lab = .PSL ∧ markRank lab = N ∧ markChar lab = 2 ∧ markDeg lab = n := by
    by_cases hc : markChar lab = 2
    · have hM' : CFSG.Blueprint.LieModel X (markTag lab) (markRank lab) 2 (markDeg lab) :=
        CFSG.StandardType.NbrInnerMore.lieModel_of_markedModel_two hc hM
      by_cases hN2 : N = 2
      · subst hN2
        obtain ⟨ht, hr, hn⟩ := RankOne.lieModel_PSL_two_two_unique_of_card_eq hX hM' rfl
        exact ⟨ht, hr, hc, hn⟩
      · have hN3 : 3 ≤ N := by
          have := (F4Pilot.statedLieAdmissible_of_lieModel hX).2.2.1
          omega
        obtain ⟨ht, hr, hn⟩ := LinearPilot.lieModel_PSL_two_unique hN3 hX hM'
        exact ⟨ht, hr, hc, hn⟩
    · exfalso
      refine (CFSG.StandardType.NbrInnerMore.not_markedModel_of_char_ne_two hX
        (fun h => h12 ⟨h.2.1, h.2.2⟩) (fun h => h13 ⟨h.2.1, h.2.2⟩) (by simp) hc) hM
  obtain ⟨ht, hr, hc, hn⟩ := hdet
  obtain ⟨tag, rank, nn⟩ := lab
  cases tag <;> simp [markTag, markRank, markDeg, markChar] at ht hr hn hc ⊢
  · exact ⟨by omega, hn⟩
  · subst ht
    simp at hr
    exact ⟨rfl, hn, hr.symm⟩
  · have hrk : rank = 2 := by
      by_contra h2
      have hbad := ht h2
      by_cases h3 : rank = 3 <;> simp [h3] at hbad
    subst hrk
    simp at hr hn
    exact ⟨rfl, hn, hr.symm⟩

private theorem label_unitary {X : Type} [Group X] {lab : LargeEvenLabel} {N n : ℕ}
    (hM : MarkedModel lab X) (hX : CFSG.Blueprint.LieModel X .PSU N 2 n) :
    (lab.tag = .twA ∧ lab.rank = N - 1 ∧ lab.n = n) ∨
    (lab.tag = .twD ∧ lab.rank = 3 ∧ lab.n = n ∧ N = 4) := by
  have hdet : markTag lab = .PSU ∧ markRank lab = N ∧ markChar lab = 2 ∧ markDeg lab = n := by
    by_cases hc : markChar lab = 2
    · have hM' : CFSG.Blueprint.LieModel X (markTag lab) (markRank lab) 2 (markDeg lab) :=
        CFSG.StandardType.NbrInnerMore.lieModel_of_markedModel_two hc hM
      by_cases hN3 : N = 3
      · subst hN3
        obtain ⟨ht, hr, hn⟩ := CFSG.LocalAnalysis.EvenBN.GMSK.su3EvenTypeDet X n
          (markTag lab) (markRank lab) (markDeg lab) hX
          (F4Pilot.statedLieAdmissible_of_lieModel hM') hM'
        exact ⟨ht, hr, hc, hn⟩
      · have hN4 : 4 ≤ N := by
          have := (F4Pilot.statedLieAdmissible_of_lieModel hX).2.2.1
          omega
        obtain ⟨ht, hr, hn⟩ :=
          UnitaryPilot.lieModel_PSU_two_unique_of_card_eq hN4 hX hM' rfl
        exact ⟨ht, hr, hc, hn⟩
    · exfalso
      by_cases h41 : N = 4 ∧ n = 1
      · obtain ⟨hn4, hn1⟩ := h41
        subst hn4
        subst hn1
        obtain ⟨tag, rank, nn⟩ := lab
        cases tag <;> simp [markChar] at hc
        · have hMPSL : CFSG.Blueprint.LieModel X .PSL 2 3 2 := by
            simpa [MarkedModel, markTag, markRank, markDeg, markChar] using hM
          have h1 : Nat.card X = CFSG.Open.ordA 1 9 := by
            simpa using CFSG.GH74.card_of_lieModel_PSL (by norm_num : 2 ≠ 0) hMPSL
          have h2 : Nat.card X = CFSG.Open.ordTwistedA 3 2 := by
            simpa using UnitaryPilot.card_of_lieModel_PSU_two_pow hX
          rw [h1] at h2
          rw [show CFSG.Open.ordA 1 9 = 360 by
            rw [CFSG.Open.ordA]
            norm_num,
            show CFSG.Open.ordTwistedA 3 2 = 25920 by
            rw [CFSG.Open.ordTwistedA]
            norm_num [Finset.prod_Icc_succ_top]] at h2
          norm_num at h2
        · have hMPSU : CFSG.Blueprint.LieModel X .PSU 3 3 1 := by
            simpa [MarkedModel, markTag, markRank, markDeg, markChar] using hM
          have h1 := CFSG.LargeExtraspecial.A2Mod.Ord.card_of_lieModel_PSU33 hMPSU
          have h2 : Nat.card X = CFSG.Open.ordTwistedA 3 2 := by
            simpa using UnitaryPilot.card_of_lieModel_PSU_two_pow hX
          rw [h1] at h2
          rw [show CFSG.Open.ordTwistedA 3 2 = 25920 by
            rw [CFSG.Open.ordTwistedA]
            norm_num [Finset.prod_Icc_succ_top]] at h2
          norm_num at h2
      · refine (CFSG.StandardType.NbrInnerMore.not_markedModel_of_char_ne_two hX
          (by simp) (by simp) (fun h => h41 ⟨h.2.1, h.2.2⟩) hc) hM
  obtain ⟨ht, hr, hc, hn⟩ := hdet
  obtain ⟨tag, rank, nn⟩ := lab
  cases tag <;> simp [markTag, markRank, markDeg, markChar] at ht hr hn hc ⊢
  · exact ⟨by omega, hn⟩
  · by_cases h3 : rank = 3 <;> simp [h3] at ht
  · have hrk : rank = 3 := by
      by_cases h2 : rank = 2
      · simp [h2] at ht
      · by_cases h3 : rank = 3
        · exact h3
        · simp [h2, h3] at ht
    subst hrk
    simp at hr hn
    exact ⟨rfl, hn, hr.symm⟩

theorem linMarking_holds :
    LinMarking := by
  intro G _ _ p L J A d b N n hS hcat
  have hnt : Nontrivial (PSimple p L) := by
    obtain ⟨_, hv, ⟨q, rfl, _⟩, ⟨e⟩⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.CatB.exists_lieIndex hcat
    exact CFSG.LocalAnalysis.GLTheoremA.T123C.nontrivial_of_lie_A (N - 1) q hv e
  have hcore := pPrimeCore_le_center_of_nontrivial hS.qs hnt
  haveI : Group.IsPerfect ↥L := ⟨hS.qs.1⟩
  let eP : ↥L ⧸ Subgroup.center ↥L ≃* PSimple p L :=
    CFSG.LocalAnalysis.GLTheoremA.S172A.pSimpleEquivCenterQuot p hcore
  have hLM : CFSG.Blueprint.LieModel (PSimple p L) .PSL N 2 n := lieModel_of_catalogIs_A hcat
  have hLieZ : CFSG.Blueprint.LieModel (↥L ⧸ Subgroup.center ↥L) .PSL N 2 n :=
    hLM.of_mulEquiv eP.symm
  obtain ⟨-, lab, hlab, hraw⟩ :=
    CFSG.StandardType.Canonical.largeEvenMarking_markedModel hS.idiag
  obtain ⟨R, _, _, _, _, _, θ, _, hM⟩ :=
    CFSG.StandardType.Canonical.largeEvenRawDatum_exists hraw
  have hLieR : CFSG.Blueprint.LieModel R .PSL N 2 n := hLieZ.of_mulEquiv θ
  have h12 : ¬ (N = 2 ∧ n = 2) := by
    rintro ⟨rfl, rfl⟩
    obtain ⟨_, hv, ⟨q, hq1, hq2⟩, -⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.CatB.exists_lieIndex hcat
    subst hq1
    have hdup : (TauCeti.LieTypeIndex.A 1 q).IsDuplicateRepresentative := by
      rw [TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
      exact Or.inl ⟨rfl, Or.inl (by simpa using hq2)⟩
    exact ((TauCeti.LieTypeIndex.valid_iff _).mp hv).2 hdup
  have h13 : ¬ (N = 3 ∧ n = 1) := by
    rintro ⟨rfl, rfl⟩
    obtain ⟨_, hv, ⟨q, hq1, hq2⟩, -⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.CatB.exists_lieIndex hcat
    subst hq1
    have hdup : (TauCeti.LieTypeIndex.A 2 q).IsDuplicateRepresentative := by
      rw [TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
      exact Or.inr (Or.inl ⟨rfl, by simpa using hq2⟩)
    exact ((TauCeti.LieTypeIndex.valid_iff _).mp hv).2 hdup
  obtain ⟨tag, rank, nn⟩ := lab
  rcases label_linear hM hLieR h12 h13 with
    ⟨htag, hrank, hnlab⟩ | ⟨htag, hrank, hnlab, hN4⟩ | ⟨htag, hrank, hnlab, hN2⟩
  · change tag = .A at htag
    change rank = N - 1 at hrank
    change nn = n at hnlab
    subst htag
    subst hrank
    subst hnlab
    have hN1 : 1 ≤ N := by
      have h := hlab
      simp [LargeEvenInLambda2] at h
      omega
    have hrecipe := hraw
    dsimp only [CFSG.Assembly.LargeEvenRawDatum] at hrecipe
    rw [show N - 1 + 1 = N by omega] at hrecipe
    dsimp only [LargeEvenRecipeLinear] at hrecipe
    obtain ⟨K, hKfield, hKfinite, hKcard, hQ⟩ := hrecipe
    obtain ⟨-, -, ⟨θ', hP', -⟩⟩ := hQ
    obtain ⟨hBN, hBI⟩ := hP'
    letI := hKfield
    letI := hKfinite
    exact ⟨K, hKfield, hKfinite, hKcard, θ', hBI⟩
  · change tag = .D at htag
    change rank = 3 at hrank
    change nn = n at hnlab
    subst htag
    subst hrank
    subst hnlab
    subst hN4
    have hrecipe := hraw
    dsimp only [CFSG.Assembly.LargeEvenRawDatum] at hrecipe
    dsimp only [LargeEvenRecipeLinear] at hrecipe
    obtain ⟨K, hKfield, hKfinite, hKcard, hQ⟩ := hrecipe
    obtain ⟨-, -, ⟨θ', hP', -⟩⟩ := hQ
    obtain ⟨hBN, hBI⟩ := hP'
    letI := hKfield
    letI := hKfinite
    exact ⟨K, hKfield, hKfinite, hKcard, θ', hBI⟩
  · change tag = .twD at htag
    change rank = 2 at hrank
    change 2 * nn = n at hnlab
    subst htag
    subst hrank
    subst hN2
    have hrecipe := hraw
    dsimp only [CFSG.Assembly.LargeEvenRawDatum] at hrecipe
    dsimp only [LargeEvenRecipeLinear] at hrecipe
    obtain ⟨K, hKfield, hKfinite, hKcard, hQ⟩ := hrecipe
    obtain ⟨-, -, ⟨θ', hP', -⟩⟩ := hQ
    obtain ⟨hBN, hBI⟩ := hP'
    have hpow : (2 ^ nn) ^ 2 = 2 ^ n := by
      rw [pow_two, ← pow_add, show nn + nn = n by omega]
    letI := hKfield
    letI := hKfinite
    exact ⟨K, hKfield, hKfinite, by simpa [hKcard, hpow], θ', hBI⟩

theorem uniMarking_holds :
    UniMarking := by
  intro G _ _ p L J A d b N n hS hcat
  have hnt : Nontrivial (PSimple p L) := by
    obtain ⟨_, hv, ⟨q, rfl, _⟩, ⟨e⟩⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.CatB.exists_lieIndex hcat
    exact CFSG.LocalAnalysis.GLTheoremA.T123C.nontrivial_of_lie_twistedA (N - 1) q hv e
  have hcore := pPrimeCore_le_center_of_nontrivial hS.qs hnt
  haveI : Group.IsPerfect ↥L := ⟨hS.qs.1⟩
  let eP : ↥L ⧸ Subgroup.center ↥L ≃* PSimple p L :=
    CFSG.LocalAnalysis.GLTheoremA.S172A.pSimpleEquivCenterQuot p hcore
  have hLM : CFSG.Blueprint.LieModel (PSimple p L) .PSU N 2 n :=
    lieModel_of_catalogIs_twistedA hcat
  have hLieZ : CFSG.Blueprint.LieModel (↥L ⧸ Subgroup.center ↥L) .PSU N 2 n :=
    hLM.of_mulEquiv eP.symm
  obtain ⟨-, lab, hlab, hraw⟩ :=
    CFSG.StandardType.Canonical.largeEvenMarking_markedModel hS.idiag
  obtain ⟨R, _, _, _, _, _, θ, _, hM⟩ :=
    CFSG.StandardType.Canonical.largeEvenRawDatum_exists hraw
  have hLieR : CFSG.Blueprint.LieModel R .PSU N 2 n := hLieZ.of_mulEquiv θ
  obtain ⟨tag, rank, nn⟩ := lab
  rcases label_unitary hM hLieR with ⟨htag, hrank, hnlab⟩ | ⟨htag, hrank, hnlab, hN4⟩
  · change tag = .twA at htag
    change rank = N - 1 at hrank
    change nn = n at hnlab
    subst htag
    subst hrank
    subst nn
    have hN1 : 1 ≤ N := by
      have h := hlab
      simp [LargeEvenInLambda2] at h
      omega
    have hrecipe := hraw
    dsimp only [CFSG.Assembly.LargeEvenRawDatum] at hrecipe
    rw [show N - 1 + 1 = N by omega] at hrecipe
    dsimp only [CFSG.Assembly.LargeEvenRecipeUnitary] at hrecipe
    obtain ⟨K, hKfield, hKfinite, hKcard, hQ⟩ := hrecipe
    obtain ⟨-, -, ⟨θ', hP', -⟩⟩ := hQ
    obtain ⟨hBN, hBI⟩ := hP'
    have hfield : UnitaryFieldData 2 n K := unitaryFieldDataOfCard hKcard
    letI := hKfield
    letI := hKfinite
    letI := hfield
    exact ⟨K, hKfield, hKfinite, hfield, θ', hBI⟩
  · change tag = .twD at htag
    change rank = 3 at hrank
    change nn = n at hnlab
    subst htag
    subst hrank
    subst nn
    subst hN4
    have hrecipe := hraw
    dsimp only [CFSG.Assembly.LargeEvenRawDatum] at hrecipe
    dsimp only [CFSG.Assembly.LargeEvenRecipeUnitary] at hrecipe
    obtain ⟨K, hKfield, hKfinite, hKcard, hQ⟩ := hrecipe
    obtain ⟨-, -, ⟨θ', hP', -⟩⟩ := hQ
    obtain ⟨hBN, hBI⟩ := hP'
    have hfield : UnitaryFieldData 2 n K := unitaryFieldDataOfCard hKcard
    letI := hKfield
    letI := hKfinite
    letI := hfield
    exact ⟨K, hKfield, hKfinite, hfield, θ', hBI⟩

end Certificates

