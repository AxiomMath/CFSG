private theorem mem_primaryFactors_quad [CharP F 2] (hF : Nat.card F = 2)
    {d : ↥(StatedSp ℓ F)} (hd3 : d ^ 3 = 1) (hd1 : d ≠ 1) :
    (X ^ 2 + X + 1 : F[X]) ∈ primaryFactors (spEnd d) := by
  simpa [CFSG.StandardType.SpFin.h3] using
    CFSG.StandardType.SpFin.h3_mem_primaryFactors (K := F) hF hd3 hd1

theorem eq_X_sub_one_of_mem_primaryFactors [CharP F 2] (hF : Nat.card F = 2)
    {d : ↥(StatedSp ℓ F)} (hd3 : d ^ 3 = 1) {k : F[X]}
    (hk : k ∈ primaryFactors (spEnd d)) (hk3 : k ≠ X ^ 2 + X + 1) : k = X - 1 := by
  rcases CFSG.HardMathSupport.Dickson.Bal207.primaryFactor_cases_of_card
      (f := 1) (by rw [hF]; norm_num) (Or.inl rfl) (spEnd_pow (p := 3) hd3) hk with h | h
  · exact h
  · exact absurd h hk3

theorem eq_quad_of_mem_primaryFactors [CharP F 2] (hF : Nat.card F = 2)
    {d : ↥(StatedSp ℓ F)} (hd3 : d ^ 3 = 1) {k : F[X]}
    (hk : k ∈ primaryFactors (spEnd d)) (hk1 : k ≠ X - 1) : k = X ^ 2 + X + 1 := by
  rcases CFSG.HardMathSupport.Dickson.Bal207.primaryFactor_cases_of_card
      (f := 1) (by rw [hF]; norm_num) (Or.inl rfl) (spEnd_pow (p := 3) hd3) hk with h | h
  · exact absurd h hk1
  · exact h

theorem spEnd_eq_self_on_quad_of_mem_fixed [CharP F 2]
    (hF : Nat.card F = 2) {d : ↥(StatedSp ℓ F)} (hd3 : d ^ 3 = 1) (hd1 : d ≠ 1)
    {g : ↥(StatedSp ℓ F)} (hg : g ∈ spSupported d {X - 1}) :
    ∀ v ∈ primaryComponent (spEnd d) (X ^ 2 + X + 1), spEnd g v = v :=
  (mem_spSupported.mp hg).2 _ (mem_primaryFactors_quad hF hd3 hd1) (by
    simp only [Set.mem_singleton_iff]
    exact CFSG.HardMathSupport.Dickson.Bal207.X_sq_add_X_add_one_ne)

theorem commute_spSupported_of_disjoint [CharP F 2] {d : ↥(StatedSp ℓ F)}
    (hd3 : d ^ 3 = 1) {O O' : Set F[X]} (hd : Disjoint O O') {g g' : ↥(StatedSp ℓ F)}
    (hg : g ∈ spSupported d O) (hg' : g' ∈ spSupported d O') : g * g' = g' * g := by
  have H := CFSG.RankThree.Classical.altPrimaryData_spLin (p := 3) (x := d)
    three_ne_zero_of_charP_two hd3
  have hc : Commute (spLin ℓ F g) (spLin ℓ F g') :=
    CFSG.RankThree.Classical.AltPrimaryData.commute_of_disjoint (H := H) hd hg hg'
  exact spLin_injective (by rw [map_mul, map_mul]; exact hc.eq)

theorem spSupported_fixed_le_centralizer_quad [CharP F 2] {d : ↥(StatedSp ℓ F)} (hd3 : d ^ 3 = 1) :
    spSupported d {X - 1} ≤
      Subgroup.centralizer (spSupported d {X ^ 2 + X + 1} : Set ↥(StatedSp ℓ F)) := by
  intro g hg
  rw [Subgroup.mem_centralizer_iff]
  intro h hh
  have hO : Disjoint ({X - 1} : Set F[X]) {X ^ 2 + X + 1} := by
    rw [Set.disjoint_singleton_left, Set.mem_singleton_iff]
    exact fun h => CFSG.HardMathSupport.Dickson.Bal207.X_sq_add_X_add_one_ne h.symm
  exact (commute_spSupported_of_disjoint hd3 hO hg hh).symm

theorem spSupported_fixed_le_centralizer_layer [CharP F 2] {d : ↥(StatedSp ℓ F)}
    (hd3 : d ^ 3 = 1) :
    spSupported d {X - 1} ≤ Subgroup.centralizer
      ((⁅spSupported d {X ^ 2 + X + 1}, spSupported d {X ^ 2 + X + 1}⁆ :
        Subgroup ↥(StatedSp ℓ F)) : Set ↥(StatedSp ℓ F)) :=
  (spSupported_fixed_le_centralizer_quad hd3).trans
    (Subgroup.centralizer_le (Subgroup.commutator_le_self _))

theorem spEnd_eq_self_of_mem_fixed {d : ↥(StatedSp ℓ F)} {v : V}
    (hv : v ∈ primaryComponent (spEnd d) (X - 1)) : spEnd d v = v := by
  have h := (mem_primaryComponent (x := spEnd d) (a := X - 1)).mp hv
  simpa [map_sub, map_one, aeval_X, LinearMap.sub_apply, sub_eq_zero] using h

theorem nondegenerate_primaryComponent_fixed [CharP F 2] {d : ↥(StatedSp ℓ F)} (hd3 : d ^ 3 = 1) :
    ((spForm ℓ F).restrict (primaryComponent (spEnd d) (X - 1))).Nondegenerate := by
  rw [primaryComponent_sub_one_eq_fixSub]
  exact nondegenerate_fixSub (K := F) three_ne_zero_of_charP_two hd3

theorem finrank_primaryComponent_fixed_add_quad [CharP F 2] {d : ↥(StatedSp ℓ F)}
    (hd3 : d ^ 3 = 1) :
    Module.finrank F (primaryComponent (spEnd d) (X - 1)) +
      Module.finrank F (primaryComponent (spEnd d) (X ^ 2 + X + 1)) = 2 * ℓ := by
  have hsup : primaryComponent (spEnd d) (X - 1) ⊔
      primaryComponent (spEnd d) (X ^ 2 + X + 1) = ⊤ := by
    rw [eq_top_iff]
    intro v _
    have h := split_primary hd3 v
    rw [h.2.2]
    exact Submodule.add_mem_sup h.1 h.2.1
  have hinf : primaryComponent (spEnd d) (X - 1) ⊓
      primaryComponent (spEnd d) (X ^ 2 + X + 1) = ⊥ := by
    rw [eq_bot_iff]
    intro v hv
    have h2 : spEnd d (spEnd d v) = 0 := by
      rw [spEnd_sq_apply_of_mem_primary hv.2, spEnd_eq_self_of_mem_fixed hv.1]
      have h2F : (2 : F) = 0 := CharP.cast_eq_zero F 2
      calc v + v = (2 : F) • v := (two_smul F v).symm
        _ = 0 := by rw [h2F, zero_smul]
    have h3 := spEnd_cube_apply hd3 v
    rw [h2, map_zero] at h3
    exact h3.symm
  have hdim := Submodule.finrank_sup_add_finrank_inf_eq
    (primaryComponent (spEnd d) (X - 1)) (primaryComponent (spEnd d) (X ^ 2 + X + 1))
  rw [hsup, hinf, finrank_top, finrank_bot] at hdim
  have hV : Module.finrank F V = 2 * ℓ := by
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_sum, Fintype.card_fin]
    omega
  rw [hV] at hdim
  omega

theorem finrank_quad_eq_two_mul [CharP F 2] (hF : Nat.card F = 2)
    {d : ↥(StatedSp ℓ F)} :
    ∃ m : ℕ, Module.finrank F (primaryComponent (spEnd d) (X ^ 2 + X + 1)) = 2 * m := by
  haveI : Fact (Irreducible (X ^ 2 + X + 1 : F[X])) :=
    ⟨CFSG.HardMathSupport.Curtis.Coordinator.irreducible_X_sq_add_X_add_one_of_card_eq_two hF⟩
  refine ⟨Module.finrank (AdjoinRoot (X ^ 2 + X + 1 : F[X]))
    (primaryComponent (spEnd d) (X ^ 2 + X + 1)), ?_⟩
  have h := finrank_primaryComponent (spEnd d) (X ^ 2 + X + 1)
  have hdeg : (X ^ 2 + X + 1 : F[X]).natDegree = 2 := by compute_degree!
  rw [hdeg] at h
  exact h

theorem mem_span_of_perp_of_mem_fixed [CharP F 2] {d : ↥(StatedSp ℓ F)}
    (hd3 : d ^ 3 = 1) {r : V} (hr1 : r ∈ primaryComponent (spEnd d) (X - 1)) (hr0 : r ≠ 0)
    (hdim2 : Module.finrank F (primaryComponent (spEnd d) (X - 1)) = 2) :
    ∀ v ∈ primaryComponent (spEnd d) (X - 1),
      (∀ s ∈ Submodule.span F {r}, spForm ℓ F v s = 0) → v ∈ Submodule.span F {r} := by
  have hnd := nondegenerate_primaryComponent_fixed (ℓ := ℓ) hd3
  have hY : ∀ y ∈ primaryComponent (spEnd d) (X - 1),
      (∀ y' ∈ primaryComponent (spEnd d) (X - 1), spForm ℓ F y y' = 0) → y = 0 := by
    intro y hy hyperp
    exact congrArg Subtype.val (hnd.1 ⟨y, hy⟩ fun y' => hyperp y' y'.2)
  have hR : Submodule.span F {r} ≤ primaryComponent (spEnd d) (X - 1) :=
    (Submodule.span_singleton_le_iff_mem r _).mpr hr1
  have hRiso : ∀ u ∈ Submodule.span F {r}, ∀ v ∈ Submodule.span F {r}, spForm ℓ F u v = 0 := by
    intro u hu v hv
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hu
    obtain ⟨c', rfl⟩ := Submodule.mem_span_singleton.mp hv
    simp only [map_smul, LinearMap.smul_apply, smul_eq_mul]
    rw [spForm_isAlt.self_eq_zero, mul_zero, mul_zero]
  have hdim : Module.finrank F (primaryComponent (spEnd d) (X - 1)) =
      2 * Module.finrank F ↥(Submodule.span F {r}) := by
    rw [finrank_span_singleton hr0, hdim2]
  exact mem_of_perp_of_lagrangian hR hY hRiso hdim

theorem eq_span_of_le_fixed_isotropic [CharP F 2] {d : ↥(StatedSp ℓ F)}
    (hd3 : d ^ 3 = 1) {W : Submodule F V} (hW0 : W ≠ ⊥)
    (hWiso : ∀ u ∈ W, ∀ v ∈ W, spForm ℓ F u v = 0)
    (hle : W ≤ primaryComponent (spEnd d) (X - 1))
    (hdim2 : Module.finrank F (primaryComponent (spEnd d) (X - 1)) = 2) :
    ∃ r ∈ W, r ≠ 0 ∧ W = Submodule.span F {r} ∧
      Module.finrank F W = 1 := by
  obtain ⟨r, hr, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hW0
  have hRle : Submodule.span F {r} ≤ W := (Submodule.span_singleton_le_iff_mem r W).mpr hr
  have hr1 : r ∈ primaryComponent (spEnd d) (X - 1) := hle hr
  have hperp := mem_span_of_perp_of_mem_fixed hd3 hr1 hr0 hdim2
  have hWle : W ≤ Submodule.span F {r} := by
    intro w hw
    refine hperp w (hle hw) fun s hs => ?_
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hs
    rw [map_smul, hWiso w hw r hr, smul_zero]
  have hW : W = Submodule.span F {r} := le_antisymm hWle hRle
  exact ⟨r, hr, hr0, hW, by rw [hW, finrank_span_singleton hr0]⟩

theorem isQuasisimple_layer_of_stdElt {A : Subgroup ↥(StatedSp ℓ F)}
    {d : ↥(StatedSp ℓ F)} (hd : IsStdElt 3 A d)
    (hK : stdLayer d = ⁅spSupported d {X ^ 2 + X + 1}, spSupported d {X ^ 2 + X + 1}⁆) :
    CFSG.Open.IsQuasisimple ↥⁅spSupported d {X ^ 2 + X + 1},
      spSupported d {X ^ 2 + X + 1}⁆ := by
  rw [← hK]
  exact hd.2.2.2.1.2.2

