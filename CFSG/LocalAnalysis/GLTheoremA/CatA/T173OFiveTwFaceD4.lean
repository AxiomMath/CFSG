local notation "Γ₂" F => ModGL TwistTag.E6.tag F

@[expose] def d4TorusParam {F : Type} [Field F] (ω : Fˣ) :
    Fin TwistTag.E6.tag.rank → Fˣ :=
  Pi.mulSingle (0 : Fin TwistTag.E6.tag.rank) ω *
    Pi.mulSingle (5 : Fin TwistTag.E6.tag.rank) ω⁻¹

private theorem two_pow_mod_three {n : ℕ} (h3 : 3 ∣ 2 ^ n + 1) : 2 ^ n % 3 = 2 := by
  have h := Nat.mod_eq_zero_of_dvd h3
  omega

private theorem sigma_eq_sq_of_pow_three {F : Type} [Field F] {n : ℕ}
    (h3 : 3 ∣ 2 ^ n + 1) (σ : F ≃+* F) (hσ : ∀ c, σ c = c ^ 2 ^ n) {ω : Fˣ}
    (hω3 : ω ^ 3 = 1) : Units.map σ.toMonoidHom ω = ω ^ 2 := by
  obtain ⟨k, hk⟩ : ∃ k, 2 ^ n = 3 * k + 2 := by
    have hdiv := Nat.mod_add_div (2 ^ n) 3
    rw [two_pow_mod_three h3] at hdiv
    exact ⟨2 ^ n / 3, by omega⟩
  have hω3' : (ω : F) ^ 3 = 1 := by simpa using congrArg Units.val hω3
  apply Units.ext
  simp only [Units.coe_map, Units.val_pow_eq_pow_val]
  change σ (ω : F) = (ω : F) ^ 2
  rw [hσ, hk, pow_add, pow_mul, hω3', one_pow, one_mul]

private theorem twCompat_d4TorusParam {F : Type} [Field F] {n : ℕ}
    (h3 : 3 ∣ 2 ^ n + 1) (σ : F ≃+* F) (hσ : ∀ c, σ c = c ^ 2 ^ n) {ω : Fˣ}
    (hω3 : ω ^ 3 = 1) :
    TwCompat F σ.toRingHom (d4TorusParam ω) := by
  have hω2 : ω ^ 2 = ω⁻¹ := by
    rw [eq_inv_iff_mul_eq_one]
    rw [← pow_succ, hω3]
  have hσeq : Units.map σ.toMonoidHom ω = ω⁻¹ := by
    rw [sigma_eq_sq_of_pow_three h3 σ hσ hω3, hω2]
  have hσinv : Units.map σ.toMonoidHom ω⁻¹ = ω := by
    rw [map_inv, hσeq]
    simp
  have hp0 : TwistTag.E6.perm (0 : Fin TwistTag.E6.tag.rank) = 5 := by decide
  have hp5 : TwistTag.E6.perm (5 : Fin TwistTag.E6.tag.rank) = 0 := by decide
  have hinj := TwistTag.E6.perm.injective
  have hne0 : ∀ i : Fin TwistTag.E6.tag.rank, i ≠ 0 → TwistTag.E6.perm i ≠ 5 := by
    intro i hi h
    exact hi (hinj (h.trans hp0.symm))
  have hne5 : ∀ i : Fin TwistTag.E6.tag.rank, i ≠ 5 → TwistTag.E6.perm i ≠ 0 := by
    intro i hi h
    exact hi (hinj (h.trans hp5.symm))
  intro i
  by_cases hi0 : i = 0
  · subst hi0
    simp [d4TorusParam, TwCompat, Pi.mulSingle_apply, hp0]
    exact hσeq.symm
  · by_cases hi5 : i = 5
    · subst hi5
      simp [d4TorusParam, TwCompat, Pi.mulSingle_apply, hp5]
      have h := congrArg Inv.inv hσeq
      simpa using h.symm
    · have hpi0 : TwistTag.E6.perm i ≠ 0 := hne5 i hi5
      have hpi5 : TwistTag.E6.perm i ≠ 5 := hne0 i hi0
      simp [d4TorusParam, TwCompat, Pi.mulSingle_apply, hi0, hi5, hpi0, hpi5]

@[expose] noncomputable def d4Witness {F : Type} [Field F] (ω : Fˣ) : Γ₂ F :=
  rootDiagUnit TwistTag.E6.tag (d4TorusParam ω)

private theorem d4TorusParam_pow_three {F : Type} [Field F] {ω : Fˣ} (hω3 : ω ^ 3 = 1) :
    d4TorusParam ω ^ 3 = 1 := by
  funext i
  by_cases hi0 : i = 0
  · subst hi0; simp [d4TorusParam, Pi.mulSingle_apply, hω3]
  · by_cases hi5 : i = 5
    · subst hi5; simp [d4TorusParam, Pi.mulSingle_apply, hω3]
    · simp [d4TorusParam, Pi.mulSingle_apply, hi0, hi5]

private theorem d4Witness_ne_one {F : Type} [Field F] {ω : Fˣ} (hω1 : ω ≠ 1) :
    d4Witness ω ≠ 1 := by
  intro h
  have h' : rootDiagUnit TwistTag.E6.tag (d4TorusParam ω) =
      rootDiagUnit TwistTag.E6.tag (1 : Fin TwistTag.E6.tag.rank → Fˣ) := by
    simpa [d4Witness, rootDiagUnit_one] using h
  have hb := CFSG.LieType.Chevalley.rootDiagUnit_injective h'
  have h0 := congrFun hb (0 : Fin TwistTag.E6.tag.rank)
  exact hω1 (by simpa [d4TorusParam, Pi.mulSingle_apply] using h0)

private theorem d4Witness_mem_twistedE6DiagGL {F : Type} [Field F] {n : ℕ}
    (σ : F ≃+* F) (hσ : ∀ c, σ c = c ^ 2 ^ n) (h3 : 3 ∣ 2 ^ n + 1) {ω : Fˣ}
    (hω3 : ω ^ 3 = 1) :
    d4Witness ω ∈ twistedE6DiagGL F σ :=
  rootDiagUnit_mem_twistedE6DiagGL σ (twCompat_d4TorusParam h3 σ hσ hω3)

private theorem d4Witness_pow_three {F : Type} [Field F] {ω : Fˣ} (hω3 : ω ^ 3 = 1) :
    d4Witness ω ^ 3 = 1 := by
  change (rootDiagUnitHom TwistTag.E6.tag F) (d4TorusParam ω) ^ 3 = 1
  rw [← map_pow, d4TorusParam_pow_three hω3, map_one]

private theorem d4Witness_centralizes_parabolicLevi {F : Type} [Field F] (ω : Fˣ) :
    parabolicLevi TwistTag.E6.tag F (TwistTag.E6.orbitUnion twE6MaxD4) ≤
      Subgroup.centralizer ({d4Witness ω} : Set (Γ₂ F)) := by
  have hMA : parabolicLevi TwistTag.E6.tag F
      (TwistTag.E6.orbitUnion twE6MaxD4) =
      torusGroup TwistTag.E6.tag F ⊔
        subsystemGroup TwistTag.E6.tag F
          {i : Fin TwistTag.E6.tag.rank | i.val ≠ 0 ∧ i.val ≠ 5} := by
    rw [orbitUnion_twE6MaxD4]
    rfl
  rw [hMA]
  refine sup_le ?_ ?_
  · intro t ht
    rw [Subgroup.mem_centralizer_singleton_iff]
    obtain ⟨b', rfl⟩ := exists_rootDiagUnit_eq_of_mem_torusGroup ht
    rw [d4Witness, ← rootDiagUnit_mul, ← rootDiagUnit_mul, mul_comm]
  · rw [subsystemGroup_eq_rootSpan]
    refine rootSpan_le_centralizer (a := d4TorusParam ω) ?_
    intro α hα
    refine ⟨hα.1, ?_⟩
    rw [rootChar]
    refine Finset.prod_eq_one fun i _ => ?_
    by_cases hi0 : i = 0
    · subst hi0
      rw [show α 0 = 0 from hα.2 0 (by decide), zpow_zero]
    · by_cases hi5 : i = 5
      · subst hi5
        rw [show α 5 = 0 from hα.2 5 (by decide), zpow_zero]
      · rw [show d4TorusParam ω i = 1 from by
          simp [d4TorusParam, Pi.mulSingle_apply, hi0, hi5], one_zpow]

private theorem d4Witness_centralizes_levi {F : Type} [Field F] (σ : F ≃+* F) (ω : Fˣ) :
    d4Witness ω ∈ Subgroup.centralizer
      (graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxD4 : Set (Γ₂ F)) := by
  have hle := d4Witness_centralizes_parabolicLevi (F := F) ω
  have hLle : graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxD4 ≤
      parabolicLevi TwistTag.E6.tag F (TwistTag.E6.orbitUnion twE6MaxD4) :=
    inf_le_left
  have hzC : d4Witness ω ∈ Subgroup.centralizer
      (parabolicLevi TwistTag.E6.tag F (TwistTag.E6.orbitUnion twE6MaxD4) :
        Set (Γ₂ F)) := by
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    exact ((Subgroup.mem_centralizer_iff.1 (hle hy)) (d4Witness ω)
      (Set.mem_singleton _)).symm
  exact (Subgroup.centralizer_le (fun x hx => hLle hx)) hzC

theorem d4Witness_facts {F : Type} [Field F] [Finite F] {n : ℕ}
    (hF : Nat.card F = (2 ^ n) ^ 2) (σ : F ≃+* F) (hσ : ∀ c, σ c = c ^ 2 ^ n)
    (h3 : 3 ∣ 2 ^ n + 1) {ω : Fˣ} (hω3 : ω ^ 3 = 1) (hω1 : ω ≠ 1) :
    d4Witness ω ≠ 1 ∧
      d4Witness ω ∈ twistedE6DiagGL F σ ∧
      d4Witness ω ^ 3 = 1 ∧
      d4Witness ω ∈ Subgroup.centralizer
        (graphFixedParabolicLevi TwistTag.E6 F σ.toRingHom twE6MaxD4 : Set (Γ₂ F)) :=
  ⟨d4Witness_ne_one hω1, d4Witness_mem_twistedE6DiagGL σ hσ h3 hω3,
    d4Witness_pow_three hω3, d4Witness_centralizes_levi σ ω⟩

