theorem glapPrimeCore_le_center_of_nontrivial_pSimple {Ω : Type} [Group Ω] [Finite Ω]
    {L : Subgroup Ω} {p : ℕ} (hq : CFSG.Open.IsQuasisimple ↥L)
    (hnt : Nontrivial (PSimple p L)) : GLAPPrimeCore p ↥L ≤ Subgroup.center ↥L := by
  haveI : Group.IsPerfect ↥L := ⟨hq.1⟩
  haveI : Nontrivial (PSimple p L) := hnt
  refine CFSG.LocalAnalysis.GLTheoremA.le_center_of_normal_of_isQuasisimple hq
    (GLAPPrimeCore.normal p ↥L) ?_
  intro htop
  have hsub : Subsingleton (PQuot p L) := by
    rw [PQuot, QuotientGroup.subsingleton_iff]
    exact htop
  haveI : Subsingleton (PQuot p L) := hsub
  have hsub2 : Subsingleton (PSimple p L) := by
    rw [PSimple, QuotientGroup.subsingleton_iff]
    refine top_unique ?_
    intro x _
    rw [Subgroup.mem_center_iff]
    intro y
    rw [Subsingleton.elim x y]
  exact not_subsingleton (PSimple p L) hsub2

section Certificates

theorem spMarking_holds :
    ∀ (G : Type) [Group G] [Finite G] (p : ℕ) (L J A : Subgroup G) (d b : G) (m n : ℕ),
      Setup p L J A d b →
      catalogIs (PSimple p L) (onLie fun i =>
        ∃ q : TauCeti.PrimePower, (i = .B m q ∨ i = .C m q) ∧ q.card = 2 ^ n) →
      ∃ (K : Type) (_ : Field K) (_ : Finite K), Nat.card K = 2 ^ n ∧ 2 ≤ m ∧
        ∃ θ : ↥L ⧸ Subgroup.center ↥L ≃* StatedProj (StatedSp m K),
          ∀ a ∈ A, ∃ x : StatedSp m K,
            LargeEvenInduces θ (fun l l' : ↥L => (l' : G) = a⁻¹ * l * a)
              (MulAut.conj (proj m K x)) := by
  intro G _ _ p L J A d b m n hS hcat
  obtain ⟨idx, hv, hP, ⟨eS⟩⟩ := CFSG.LocalAnalysis.GLTheoremA.CatB.exists_lieIndex hcat
  obtain ⟨q, hqdisj, hqcard⟩ := hP
  have hq2 : q.p = 2 := by
    have hdiv : q.p ∣ 2 ^ n := by
      rw [← hqcard, TauCeti.PrimePower.card_def]
      exact dvd_pow_self q.p (Nat.ne_of_gt q.exponent_pos)
    exact (Nat.prime_dvd_prime_iff_eq q.prime_p Nat.prime_two).mp
      (q.prime_p.dvd_of_dvd_pow hdiv)
  have hqn : q.exponent = n := by
    have hq' : q.p ^ q.exponent = 2 ^ n := by
      rw [← TauCeti.PrimePower.card_def]
      exact hqcard
    rw [hq2] at hq'
    exact Nat.pow_right_injective (le_refl 2) hq'
  have hm2 : 2 ≤ m := by
    rcases hqdisj with h | h
    · subst h
      have hr := ((TauCeti.LieTypeIndex.inStandardRange_iff _).1
        ((TauCeti.LieTypeIndex.valid_iff _).1 hv).1).1
      omega
    · subst h
      have hr := ((TauCeti.LieTypeIndex.inStandardRange_iff _).1
        ((TauCeti.LieTypeIndex.valid_iff _).1 hv).1).1
      omega
  have hLM : CFSG.Blueprint.LieModel (PSimple p L) .PSp m 2 n := by
    rcases hqdisj with h | h
    · subst h
      rcases CFSG.Models.lieModel_B m q hv eS with h' | h'
      · rw [hq2, hqn] at h'
        exact CFSG.Models.LieModel.toBlueprint (by decide) h'
      · have hadm := CFSG.Models.LieModel.admissible h'
        rw [CFSG.Open.StatedLieAdmissible] at hadm
        exact absurd hq2 hadm.2.2.2
    · subst h
      have h' := CFSG.Models.lieModel_C m q hv eS
      rw [hq2, hqn] at h'
      exact CFSG.Models.LieModel.toBlueprint (by decide) h'
  haveI : Nontrivial (PSimple p L) :=
    (CFSG.ClassicalGroups.Symplectic.isSimpleGroup_of_statedClassicalModel_PSp _
      m 2 n (CFSG.Blueprint.LieModel.statedClassicalModel hLM (by decide))).toNontrivial
  have hcore : GLAPPrimeCore p ↥L ≤ Subgroup.center ↥L :=
    glapPrimeCore_le_center_of_nontrivial_pSimple hS.qs inferInstance
  haveI : Group.IsPerfect ↥L := ⟨hS.qs.1⟩
  let eP : ↥L ⧸ Subgroup.center ↥L ≃* PSimple p L :=
    CFSG.LocalAnalysis.GLTheoremA.S172A.pSimpleEquivCenterQuot p hcore
  have hLieZ : CFSG.Blueprint.LieModel (↥L ⧸ Subgroup.center ↥L) .PSp m 2 n :=
    hLM.of_mulEquiv eP.symm
  obtain ⟨-, lab, hlab, hraw⟩ :=
    CFSG.StandardType.Canonical.largeEvenMarking_markedModel hS.idiag
  obtain ⟨R, _, _, _, _, _, θ₀, _, hM⟩ :=
    CFSG.StandardType.Canonical.largeEvenRawDatum_exists hraw
  have hLieR : CFSG.Blueprint.LieModel R .PSp m 2 n := hLieZ.of_mulEquiv θ₀
  have hc2 : markChar lab = 2 := by
    by_contra hc
    exact CFSG.StandardType.NbrInnerMore.not_markedModel_of_char_ne_two hLieR
      (fun h => by simp at h) (fun h => by simp at h) (fun h => by simp at h) hc hM
  have hM' : CFSG.Blueprint.LieModel R (markTag lab) (markRank lab) 2 (markDeg lab) :=
    CFSG.StandardType.NbrInnerMore.lieModel_of_markedModel_two hc2 hM
  obtain ⟨htag, hrank, hdeg⟩ :=
    CFSG.SeitzReduction.SymplecticPilot.lieModel_PSp_two_unique hLieR hM'
  obtain ⟨tag, rank, nn⟩ := lab
  have hsymp : tag = .B ∨ tag = .C := by
    cases tag <;> simp only [markTag] at htag <;>
      first
        | exact Or.inl rfl
        | exact Or.inr rfl
        | (exfalso; first | exact absurd htag (by decide) | split_ifs at htag)
  have hrank' : rank = m := by
    rcases hsymp with h | h <;> subst h <;> simpa [markRank] using hrank
  have hnn' : nn = n := by
    rcases hsymp with h | h <;> subst h <;> simpa [markDeg] using hdeg
  subst rank
  subst nn
  cases tag with
  | B =>
    have hrec := hraw
    dsimp only [CFSG.Assembly.LargeEvenRawDatum] at hrec
    dsimp only [CFSG.Assembly.LargeEvenRecipeSymplectic] at hrec
    obtain ⟨K, hKfield, hKfinite, hKcard, hQ⟩ := hrec
    obtain ⟨-, -, ⟨θ', hP', -⟩⟩ := hQ
    obtain ⟨hBN, hBI⟩ := hP'
    letI := hKfield
    letI := hKfinite
    have hchar : CharP K 2 := CFSG.RankThree.PartOne.charP_two_of_card_eq_pow hKcard
    letI : CharP K 2 := hchar
    have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
    refine ⟨K, hKfield, hKfinite, hKcard, hm2, θ', ?_⟩
    intro a ha
    obtain ⟨φ, hφ, hind⟩ := hBI a ha
    obtain ⟨A, hA⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.Y10GFldSympMark.exists_conjAut_eq_of_mem_matConjImage hφ
    obtain ⟨x, hx⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GInnSympRed.exists_conjAut_eq_conj h2 A
    exact ⟨x, by rw [← hx, hA]; exact hind⟩
  | C =>
    have hrec := hraw
    dsimp only [CFSG.Assembly.LargeEvenRawDatum] at hrec
    dsimp only [CFSG.Assembly.LargeEvenRecipeSymplectic] at hrec
    obtain ⟨K, hKfield, hKfinite, hKcard, hQ⟩ := hrec
    obtain ⟨-, -, ⟨θ', hP', -⟩⟩ := hQ
    obtain ⟨hBN, hBI⟩ := hP'
    letI := hKfield
    letI := hKfinite
    have hchar : CharP K 2 := CFSG.RankThree.PartOne.charP_two_of_card_eq_pow hKcard
    letI : CharP K 2 := hchar
    have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
    refine ⟨K, hKfield, hKfinite, hKcard, hm2, θ', ?_⟩
    intro a ha
    obtain ⟨φ, hφ, hind⟩ := hBI a ha
    obtain ⟨A, hA⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.Y10GFldSympMark.exists_conjAut_eq_of_mem_matConjImage hφ
    obtain ⟨x, hx⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GInnSympRed.exists_conjAut_eq_conj h2 A
    exact ⟨x, by rw [← hx, hA]; exact hind⟩
  | _ => exfalso
         simp only [markTag] at htag
         first | exact absurd htag (by decide) | split_ifs at htag

