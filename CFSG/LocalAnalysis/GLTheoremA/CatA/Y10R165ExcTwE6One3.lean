theorem not_dvd_card_center_of_rk2Ord_one {k : Type} [Field k] [Finite k] {f p : ℕ}
    (θ : k →+* k) (hk : Nat.card k = (2 ^ f) ^ 2) (hθ : ∀ c, θ c = c ^ (2 ^ f))
    (hp : p.Prime) (hp2 : p ≠ 2) (hrk : CFSG.LocalAnalysis.GLTheoremA.rk2Ord p f = 1) :
    ¬ p ∣ Nat.card ↥(Subgroup.center ↥(fixedGroup k θ)) := by
  rw [CFSG.LocalAnalysis.GLTheoremA.Y10F.ExcTwE6.card_center_fixedGroup_pow_two θ hk hθ]
  intro hdvd
  have hp3 : p = 3 :=
    (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).1 (hdvd.trans (Nat.gcd_dvd_left 3 _))
  have h1 : p ∣ 2 ^ f - 1 :=
    (CFSG.LocalAnalysis.GLTheoremA.rk2Ord_eq_one_iff).mp hrk
  have h2 : p ∣ 2 ^ f + 1 := hdvd.trans (Nat.gcd_dvd_right 3 _)
  have h3 : p ∣ 2 ^ f + 1 - (2 ^ f - 1) := Nat.dvd_sub h2 h1
  have h4 : 2 ^ f + 1 - (2 ^ f - 1) = 2 := by
    have := Nat.one_le_pow f 2 (by norm_num)
    omega
  rw [h4] at h3
  have hp2' : p = 2 := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 h3
  exact hp2 hp2'

theorem pRank_fixedGroup_eq_four {f p : ℕ} (hf : 1 ≤ f) (hp : p.Prime) (hp5 : 5 ≤ p)
    (he : orderOf (((2 ^ f : ℕ)) : ZMod p) = 1) :
    CFSG.Open.pRank p (⊤ : Subgroup ↥(fixedGroup (GaloisField 2 (2 * f)) (frobQ 2 f))) = 4 := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let k := GaloisField 2 (2 * f)
  let θ : k →+* k := frobQ 2 f
  have hk : Nat.card k = (2 ^ f) ^ 2 := by
    rw [show Nat.card k = Nat.card (GaloisField 2 (2 * f)) from rfl,
      GaloisField.card 2 (2 * f) (by omega), ← pow_mul, mul_comm]
  have hθ : ∀ c, θ c = c ^ (2 ^ f) := fun c => frobQ_apply 2 f c
  let π : ↥(fixedGroup k θ) →* ↥(graphFixedRootGroup TwistTag.E6 k θ) :=
    twistedIsogenyC hf hk θ hθ
  have hsurj : Function.Surjective π := twistedIsogenyC_surjective hf hk θ hθ
  have hker : π.ker = Subgroup.center ↥(fixedGroup k θ) :=
    ker_twistedIsogenyC hf hk θ hθ
  have hpZ : ¬ p ∣ Nat.card ↥(π.ker) := by
    rw [hker]
    refine not_dvd_card_center_of_rk2Ord_one θ hk hθ hp (by omega) ?_
    rw [CFSG.LocalAnalysis.GLTheoremA.rk2Ord]
    simpa using he
  let e : (↥(fixedGroup k θ) ⧸ π.ker) ≃* ↥(graphFixedRootGroup TwistTag.E6 k θ) :=
    QuotientGroup.quotientKerEquivOfSurjective π hsurj
  have hquot : CFSG.Open.pRank p (⊤ : Subgroup (↥(fixedGroup k θ) ⧸ π.ker)) =
      CFSG.Open.pRank p (⊤ : Subgroup ↥(fixedGroup k θ)) :=
    CFSG.SectionRank.pRank_quotient_eq π.ker hpZ
  have hiso : CFSG.Open.pRank p (⊤ : Subgroup (↥(fixedGroup k θ) ⧸ π.ker)) =
      CFSG.Open.pRank p (⊤ : Subgroup ↥(graphFixedRootGroup TwistTag.E6 k θ)) :=
    CFSG.SectionRank.pRank_top_eq_of_mulEquiv hp.one_lt e
  have hS : SylowTorus (↥(graphFixedRootGroup TwistTag.E6 k θ)) p 4 :=
    sylowTorus_C0 hf hp hp5 he
  have hle : CFSG.Open.pRank p (⊤ : Subgroup ↥(graphFixedRootGroup TwistTag.E6 k θ)) ≤ 4 :=
    CFSG.LocalAnalysis.GLTheoremA.pRank_le_of_sylowTorusDatum hS hp
  have hge : 4 ≤ CFSG.Open.pRank p (⊤ : Subgroup ↥(graphFixedRootGroup TwistTag.E6 k θ)) := by
    obtain ⟨E, hE, hEcard⟩ := hS.exists_elemAbelian
    have := CFSG.SectionRank.le_pRank hp.one_lt (le_top : E ≤ ⊤) hE hEcard
    simpa using this
  have hC0 : CFSG.Open.pRank p (⊤ : Subgroup ↥(graphFixedRootGroup TwistTag.E6 k θ)) = 4 :=
    le_antisymm hle hge
  rw [← hquot, hiso, hC0]

theorem pRank_elemAbelian_eq {G : Type} [Group G] [Finite G] {p k : ℕ} (hp : p.Prime)
    {E : Subgroup G} (hE : IsElemAbelian p E) (hcard : Nat.card E = p ^ k) :
    CFSG.Open.pRank p E = k := by
  refine le_antisymm ?_ (CFSG.SectionRank.le_pRank hp.one_lt le_rfl hE hcard)
  refine CFSG.SectionRank.pRank_le hp.one_lt fun F hF hFel => ?_
  have h1 : Nat.card F ≤ Nat.card E := Subgroup.card_le_of_le hF
  rw [hcard] at h1
  exact h1

theorem card_eq_pow_four_of_maximal_rank {f p : ℕ} (hf : 1 ≤ f) (hp : p.Prime) (hp5 : 5 ≤ p)
    (he : orderOf (((2 ^ f : ℕ)) : ZMod p) = 1)
    {A : Subgroup ↥(fixedGroup (GaloisField 2 (2 * f)) (frobQ 2 f))}
    (hA : IsElemAbelian p A)
    (hmax : CFSG.Open.pRank p (⊤ : Subgroup ↥(fixedGroup (GaloisField 2 (2 * f)) (frobQ 2 f))) ≤
      CFSG.Open.pRank p A) :
    Nat.card A = p ^ 4 := by
  have hprank : CFSG.Open.pRank p A = 4 := by
    refine le_antisymm ?_ ?_
    · calc CFSG.Open.pRank p A ≤
          CFSG.Open.pRank p (⊤ : Subgroup ↥(fixedGroup (GaloisField 2 (2 * f)) (frobQ 2 f))) :=
            CFSG.SectionRank.pRank_mono hp.one_lt le_top
        _ = 4 := pRank_fixedGroup_eq_four hf hp hp5 he
    · rw [← pRank_fixedGroup_eq_four hf hp hp5 he]
      exact hmax
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨k, hk⟩ := GL83.CompFam.exists_card_eq_pow (p := p) hA
  have hk4 : k = 4 := by
    have h := pRank_elemAbelian_eq hp hA hk
    rw [hprank] at h
    exact h.symm
  rw [hk, hk4]
