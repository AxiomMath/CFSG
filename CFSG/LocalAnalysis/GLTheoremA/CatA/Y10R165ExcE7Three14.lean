theorem blockP_sq_add_self_add_one_of_weylMatrix {w : WeylGroup τ}
    (hJ : ∀ β ∈ parabolicRoots τ J, w • β ∈ parabolicRoots τ J)
    (hmat : ∀ c : J, weylMatrix w *ᵥ (weylMatrix w *ᵥ extJ' J (Pi.single c 1)) +
      weylMatrix w *ᵥ extJ' J (Pi.single c 1) + extJ' J (Pi.single c 1) = 0) :
    blockP w J * blockP w J + blockP w J + 1 = 0 := by
  classical
  refine Matrix.ext_of_mulVec_single fun c => ?_
  have h2 := weylMatrix_pow_mulVec_extJ' hJ 2 (Pi.single c 1 : J → ℤ)
  have h1 := weylMatrix_mulVec_extJ' hJ (Pi.single c 1 : J → ℤ)
  have hm : weylMatrix w *ᵥ (weylMatrix w *ᵥ extJ' J (Pi.single c 1 : J → ℤ)) =
      weylMatrix w ^ 2 *ᵥ extJ' J (Pi.single c 1 : J → ℤ) := by
    rw [pow_two, Matrix.mulVec_mulVec]
  have hmatc := hmat c
  rw [hm, h2, h1] at hmatc
  funext j
  have hcoord := congrFun hmatc j
  simpa [Matrix.add_mulVec, Matrix.one_mulVec, Matrix.mulVec_mulVec, pow_two,
    Pi.add_apply, extJ'_apply_mem, Matrix.one_apply, Pi.single_apply] using hcoord

theorem blockP_sq_sub_self_add_one_of_weylMatrix {w : WeylGroup τ}
    (hJ : ∀ β ∈ parabolicRoots τ J, w • β ∈ parabolicRoots τ J)
    (hmat : ∀ c : J, weylMatrix w *ᵥ (weylMatrix w *ᵥ extJ' J (Pi.single c 1)) -
      weylMatrix w *ᵥ extJ' J (Pi.single c 1) + extJ' J (Pi.single c 1) = 0) :
    blockP w J * blockP w J - blockP w J + 1 = 0 := by
  classical
  refine Matrix.ext_of_mulVec_single fun c => ?_
  have h2 := weylMatrix_pow_mulVec_extJ' hJ 2 (Pi.single c 1 : J → ℤ)
  have h1 := weylMatrix_mulVec_extJ' hJ (Pi.single c 1 : J → ℤ)
  have hm : weylMatrix w *ᵥ (weylMatrix w *ᵥ extJ' J (Pi.single c 1 : J → ℤ)) =
      weylMatrix w ^ 2 *ᵥ extJ' J (Pi.single c 1 : J → ℤ) := by
    rw [pow_two, Matrix.mulVec_mulVec]
  have hmatc := hmat c
  rw [hm, h2, h1] at hmatc
  funext j
  have hcoord := congrFun hmatc j
  simpa [Matrix.add_mulVec, Matrix.sub_mulVec, Matrix.one_mulVec, Matrix.mulVec_mulVec,
    pow_two, Pi.add_apply, Pi.sub_apply, extJ'_apply_mem, Matrix.one_apply,
    Pi.single_apply] using hcoord

