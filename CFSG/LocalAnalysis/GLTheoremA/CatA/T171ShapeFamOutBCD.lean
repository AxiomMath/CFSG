theorem shape_A_of_label {p : ℕ} (hp : p.Prime) {lab : GLALabel} {R : Type} [Group R]
    (hlab : LargeEvenInLambda2 lab) (htag : lab.tag = .A)
    (hM : MarkedModel lab R) (hpd : p ∣ rk2DiagIndex lab) :
    catalogIs R (onLie (I171.I171LieShape p)) := by
  obtain ⟨tag, rank, n⟩ := lab
  simp only [LargeEvenLabel.mk.injEq] at htag
  subst htag
  simp only [LargeEvenInLambda2] at hlab
  obtain ⟨hn, hrk, hrn⟩ := hlab
  simp only [MarkedModel, markTag, markRank, markChar, markDeg] at hM
  have hSC : StatedClassicalModel R .PSL (rank + 1) 2 n :=
    CFSG.Blueprint.LieModel.statedClassicalModel hM (by decide)
  simp only [rk2DiagIndex] at hpd
  obtain ⟨-, K, hfield, hfinite, hKcard, ⟨e⟩⟩ := hSC
  letI := hfield
  letI := hfinite
  haveI : Fact (2 : ℕ).Prime := ⟨Nat.prime_two⟩
  let q : TauCeti.PrimePower := ⟨2, n, Nat.prime_two, by omega⟩
  have hqcard : q.card = 2 ^ n := TauCeti.PrimePower.card_def q
  have hodd : Odd (2 ^ n - 1) := CFSG.StandardType.ggOdd_two_pow_sub_one hn
  have hcop : Nat.Coprime 2 (2 ^ n - 1) := (Nat.coprime_two_right.mpr hodd).symm
  have hrank1 : rank ≠ 1 := by
    rintro rfl
    have h1 : Nat.gcd 2 (2 ^ n - 1) = 1 := hcop.gcd_eq_one
    rw [h1] at hpd
    exact Nat.Prime.not_dvd_one hp hpd
  have hv : (TauCeti.LieTypeIndex.A rank q).Valid := by
    rw [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
      TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
    refine ⟨⟨hrk, ?_⟩, ?_⟩
    · intro h
      exact absurd h hrank1
    · simp only [q, TauCeti.PrimePower.card_def]
      rintro (⟨hr1, -⟩ | ⟨hr2, h2⟩ | ⟨hr3, h2⟩)
      · exact hrank1 hr1
      · have hn1 : n = 1 := by
          have h2' : 2 ^ n = 2 ^ 1 := by simpa using h2
          exact Nat.pow_right_injective (by norm_num) h2'
        subst hn1
        have hgc : Nat.gcd (rank + 1) (2 ^ 1 - 1) = 1 := by norm_num
        rw [hgc] at hpd
        exact Nat.Prime.not_dvd_one hp hpd
      · have hn1 : n = 1 := by
          have h2' : 2 ^ n = 2 ^ 1 := by simpa using h2
          exact Nat.pow_right_injective (by norm_num) h2'
        subst hn1
        have hgc : Nat.gcd (rank + 1) (2 ^ 1 - 1) = 1 := by norm_num
        rw [hgc] at hpd
        exact Nat.Prime.not_dvd_one hp hpd
  refine ⟨.lie ⟨.A rank q, hv⟩, ?_, ?_⟩
  · refine ⟨rfl, ?_⟩
    simpa [q, TauCeti.PrimePower.card_def] using hpd
  · have eK := CFSG.ClassicalModels.statedLinearModelEquivGaloisPSL K (rank + 1) 2 n
      (by omega) hKcard
    have eC := CFSG.ClassicalModels.linearCatalogCandidateEquivPSL rank q hv
    exact ⟨(e.trans eK).trans eC.symm⟩

private noncomputable def statedProjEq {ι : Type} [Fintype ι] [DecidableEq ι]
    {K : Type} [Field K] {H H' : Subgroup (GL ι K)} (h : H = H') :
    CFSG.Open.StatedProj H ≃* CFSG.Open.StatedProj H' := by
  subst h
  exact MulEquiv.refl _

theorem shape_twA_of_label {p : ℕ} (hp : p.Prime) {lab : GLALabel} {R : Type} [Group R]
    (hlab : LargeEvenInLambda2 lab) (htag : lab.tag = .twA)
    (hM : MarkedModel lab R) (hpd : p ∣ rk2DiagIndex lab) :
    catalogIs R (onLie (I171.I171LieShape p)) := by
  obtain ⟨tag, rank, n⟩ := lab
  simp only [LargeEvenLabel.mk.injEq] at htag
  subst htag
  simp only [LargeEvenInLambda2] at hlab
  obtain ⟨hn, hrk, hrn⟩ := hlab
  simp only [MarkedModel, markTag, markRank, markChar, markDeg] at hM
  have hSC : StatedClassicalModel R .PSU (rank + 1) 2 n :=
    CFSG.Blueprint.LieModel.statedClassicalModel hM (by decide)
  simp only [rk2DiagIndex] at hpd
  obtain ⟨-, K, hfield, hfinite, hKcard, ⟨e⟩⟩ := hSC
  letI := hfield
  letI := hfinite
  haveI : Fact (2 : ℕ).Prime := ⟨Nat.prime_two⟩
  let q : TauCeti.PrimePower := ⟨2, n, Nat.prime_two, by omega⟩
  have hqcard : q.card = 2 ^ n := TauCeti.PrimePower.card_def q
  have hv : (TauCeti.LieTypeIndex.twistedA rank q).Valid := by
    rw [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
      TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
    refine ⟨⟨hrk, ?_⟩, not_false⟩
    intro h
    have hn2 : 2 ≤ n := hrn h
    have : 4 ≤ 2 ^ n := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn2
    simp only [q, TauCeti.PrimePower.card_def]
    omega
  refine ⟨.lie ⟨.twistedA rank q, hv⟩, ?_, ?_⟩
  · refine ⟨rfl, ?_⟩
    simpa [q, TauCeti.PrimePower.card_def] using hpd
  · have hchar : TauCeti.ValidLieTypeIndex.characteristic
        ⟨TauCeti.LieTypeIndex.twistedA rank q, hv⟩ = 2 := by
      change (TauCeti.LieTypeIndex.twistedA rank q).characteristic = 2
      rw [TauCeti.LieTypeIndex.characteristic_twistedA]
    have hexp : TauCeti.ValidLieTypeIndex.fieldExponent
        ⟨TauCeti.LieTypeIndex.twistedA rank q, hv⟩ = n := by
      change (TauCeti.LieTypeIndex.twistedA rank q).fieldExponent = n
      rw [TauCeti.LieTypeIndex.fieldExponent_twistedA]
    have hq : TauCeti.ValidLieTypeIndex.characteristic
          ⟨TauCeti.LieTypeIndex.twistedA rank q, hv⟩ ^
          TauCeti.ValidLieTypeIndex.fieldExponent
            ⟨TauCeti.LieTypeIndex.twistedA rank q, hv⟩ = 2 ^ n := by
      rw [hchar, hexp]
    let L := GaloisField 2 (2 * n)
    let F1 := GaloisField (TauCeti.ValidLieTypeIndex.characteristic
        ⟨TauCeti.LieTypeIndex.twistedA rank q, hv⟩)
      (2 * TauCeti.ValidLieTypeIndex.fieldExponent
        ⟨TauCeti.LieTypeIndex.twistedA rank q, hv⟩)
    let _ : Fact (TauCeti.ValidLieTypeIndex.characteristic
        ⟨TauCeti.LieTypeIndex.twistedA rank q, hv⟩).Prime :=
      ⟨TauCeti.ValidLieTypeIndex.characteristic_prime _⟩
    let _ : Fintype K := Fintype.ofFinite K
    let _ : Fintype L := Fintype.ofFinite L
    let _ : Fintype F1 := Fintype.ofFinite F1
    have hLcard : Nat.card L = (2 ^ n) ^ 2 := by
      dsimp only [L]
      rw [GaloisField.card 2 (2 * n) (by omega), Nat.mul_comm 2 n, pow_mul]
    have hF1card : Nat.card F1 = (2 ^ n) ^ 2 := by
      dsimp only [F1]
      rw [GaloisField.card _ (2 * TauCeti.ValidLieTypeIndex.fieldExponent
          ⟨TauCeti.LieTypeIndex.twistedA rank q, hv⟩) (by
            have := TauCeti.ValidLieTypeIndex.fieldExponent_pos
              (⟨TauCeti.LieTypeIndex.twistedA rank q, hv⟩ : TauCeti.ValidLieTypeIndex)
            omega),
        hchar, hexp, Nat.mul_comm 2 n, pow_mul]
    have hcard1 : Fintype.card K = Fintype.card L := by
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hKcard, hLcard]
    have hcard2 : Fintype.card L = Fintype.card F1 := by
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hLcard, hF1card]
    let φ1 : K ≃+* L := FiniteField.ringEquivOfCardEq hcard1
    let e1 := CFSG.Adapters.RankTwoModelTransports.statedProjCongr
      (CFSG.Adapters.RankTwoModelTransports.glCongr (ι := Fin (rank + 1)) φ1)
      (CFSG.Adapters.RankTwoModelTransports.glCongr_statedSU φ1 (rank + 1) (2 ^ n))
      (CFSG.Adapters.RankTwoModelTransports.glCongr_statedScalars φ1)
    let eSub := statedProjEq (H := StatedSU (rank + 1) (2 ^ n) L)
      (H' := StatedSU (rank + 1)
        (TauCeti.ValidLieTypeIndex.characteristic
            ⟨TauCeti.LieTypeIndex.twistedA rank q, hv⟩ ^
          TauCeti.ValidLieTypeIndex.fieldExponent
            ⟨TauCeti.LieTypeIndex.twistedA rank q, hv⟩) L)
      (by rw [hq])
    let φ2 : L ≃+* F1 := FiniteField.ringEquivOfCardEq hcard2
    let e2 := CFSG.Adapters.RankTwoModelTransports.statedProjCongr
      (CFSG.Adapters.RankTwoModelTransports.glCongr (ι := Fin (rank + 1)) φ2)
      (CFSG.Adapters.RankTwoModelTransports.glCongr_statedSU φ2 (rank + 1)
        (TauCeti.ValidLieTypeIndex.characteristic
            ⟨TauCeti.LieTypeIndex.twistedA rank q, hv⟩ ^
          TauCeti.ValidLieTypeIndex.fieldExponent
            ⟨TauCeti.LieTypeIndex.twistedA rank q, hv⟩))
      (CFSG.Adapters.RankTwoModelTransports.glCongr_statedScalars φ2)
    have eT := CFSG.QuasithinUnique.SQTK.typeTwistedAGroupEquivStatedProj rank q hv
    exact ⟨(e.trans e1).trans (eSub.trans (e2.trans eT.symm))⟩

theorem shape_E6_of_label {p : ℕ} (hp : p.Prime) {lab : GLALabel} {R : Type}
    [Group R] (hlab : LargeEvenInLambda2 lab) (htag : lab.tag = .E6)
    (hM : MarkedModel lab R) (hpd : p ∣ rk2DiagIndex lab) :
    catalogIs R (onLie (I171.I171LieShape p)) := by
  obtain ⟨tag, rank, n⟩ := lab
  simp only [LargeEvenLabel.mk.injEq] at htag
  subst htag
  simp only [LargeEvenInLambda2] at hlab
  obtain ⟨hn, hrank⟩ := hlab
  simp only [MarkedModel, markTag, markRank, markChar, markDeg] at hM
  have hCE : CFSG.Blueprint.ChevalleyExceptionalModel R .E6 2 n :=
    CFSG.Blueprint.LieModel.chevalleyExceptionalModel hM (by decide)
  simp only [rk2DiagIndex] at hpd
  obtain ⟨-, hUM⟩ := hCE
  simp only [CFSG.Blueprint.UntwistedChevalleyModel] at hUM
  obtain ⟨K, hfield, hfinite, hKcard, ⟨e⟩⟩ := hUM
  letI := hfield
  letI := hfinite
  let q : TauCeti.PrimePower := ⟨2, n, Nat.prime_two, by omega⟩
  have hqcard : q.card = 2 ^ n := TauCeti.PrimePower.card_def q
  have hp3 : p = 3 :=
    (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp
      (hpd.trans (Nat.gcd_dvd_left 3 (2 ^ n - 1)))
  have h3dvd : 3 ∣ 2 ^ n - 1 := by
    rw [← hp3]
    exact hpd.trans (Nat.gcd_dvd_right 3 (2 ^ n - 1))
  have hv : (TauCeti.LieTypeIndex.E6 q).Valid := by
    rw [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
      TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
    exact ⟨trivial, not_false⟩
  refine ⟨.lie ⟨.E6 q, hv⟩, ⟨hp3, rfl, ?_⟩, ?_⟩
  · simpa [q, TauCeti.PrimePower.card_def] using h3dvd
  · have eB := CFSG.TauCetiBridge.Even.chevalleyBridgesAll.e6 q hv K (by
      simpa [q, TauCeti.PrimePower.card_def] using hKcard)
    obtain ⟨e'⟩ := eB
    exact ⟨e.trans e'⟩

theorem shape_twE6_of_label {p : ℕ} (hp : p.Prime) {lab : GLALabel} {R : Type}
    [Group R] (hlab : LargeEvenInLambda2 lab) (htag : lab.tag = .twE6)
    (hM : MarkedModel lab R) (hpd : p ∣ rk2DiagIndex lab) :
    catalogIs R (onLie (I171.I171LieShape p)) := by
  obtain ⟨tag, rank, n⟩ := lab
  simp only [LargeEvenLabel.mk.injEq] at htag
  subst htag
  simp only [LargeEvenInLambda2] at hlab
  obtain ⟨hn, hrank⟩ := hlab
  simp only [MarkedModel, markTag, markRank, markChar, markDeg] at hM
  have hCE : CFSG.Blueprint.ChevalleyExceptionalModel R .twistedE6 2 n :=
    CFSG.Blueprint.LieModel.chevalleyExceptionalModel hM (by decide)
  simp only [rk2DiagIndex] at hpd
  obtain ⟨-, hTM⟩ := hCE
  simp only [CFSG.Blueprint.TwistedChevalleyModel] at hTM
  obtain ⟨K, hfield, hfinite, hKcard, σ, hσ, ⟨e⟩⟩ := hTM
  letI := hfield
  letI := hfinite
  let q : TauCeti.PrimePower := ⟨2, n, Nat.prime_two, by omega⟩
  have hqcard : q.card = 2 ^ n := TauCeti.PrimePower.card_def q
  have hp3 : p = 3 :=
    (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp
      (hpd.trans (Nat.gcd_dvd_left 3 (2 ^ n + 1)))
  have h3dvd : 3 ∣ 2 ^ n + 1 := by
    rw [← hp3]
    exact hpd.trans (Nat.gcd_dvd_right 3 (2 ^ n + 1))
  have hv : (TauCeti.LieTypeIndex.twistedE6 q).Valid := by
    rw [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
      TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
    exact ⟨trivial, not_false⟩
  refine ⟨.lie ⟨.twistedE6 q, hv⟩, ⟨hp3, rfl, ?_⟩, ?_⟩
  · simpa [q, TauCeti.PrimePower.card_def] using h3dvd
  · have eB := CFSG.TauCetiBridge.Even.chevalleyBridgesAll.twistedE6 q hv K
      (by simpa [q, TauCeti.PrimePower.card_def] using hKcard) σ (by
        intro x
        simpa [q, TauCeti.PrimePower.card_def] using hσ x)
    obtain ⟨e'⟩ := eB
    exact ⟨e.trans e'⟩

theorem pSimple_equiv_centerQuot_of_dvd {Ω : Type} [Group Ω] [Finite Ω] {p : ℕ}
    (hp : p.Prime) {K : Subgroup Ω} (hq : CFSG.Open.IsQuasisimple ↥K)
    (hd : p ∣ Nat.card ↥K) :
    Nonempty ((↥K ⧸ Subgroup.center ↥K) ≃* PSimple p K) := by
  haveI : Group.IsPerfect ↥K := ⟨hq.1⟩
  haveI : Fact p.Prime := ⟨hp⟩
  have hOne : GLAPPrimeCore p ↥K ≠ ⊤ := by
    intro htop
    have hc : Nat.Coprime p (Nat.card (GLAPPrimeCore p ↥K)) :=
      CFSG.pPrimeCore_coprime_card (p := p) (G := ↥K)
    rw [htop, Subgroup.card_top] at hc
    exact hp.ne_one (Nat.Coprime.eq_one_of_dvd hc hd)
  have hOZ := CFSG.LocalAnalysis.GLTheoremA.le_center_of_normal_of_isQuasisimple
    hq inferInstance hOne
  exact ⟨CFSG.LocalAnalysis.GLTheoremA.S172A.pSimpleEquivCenterQuot p hOZ⟩

theorem innerDiagInnerOrShape_holds (F : TauCeti.LieTypeIndex → Prop) :
    InnerDiagInnerOrShape F := by
  intro G _ _ p L J A d b hS _
  obtain ⟨-, lab, hlab, hraw⟩ :=
    CFSG.StandardType.Canonical.largeEvenMarking_markedModel hS.idiag
  by_cases hpd : p ∣ CFSG.LocalAnalysis.GLTheoremA.rk2DiagIndex lab
  · right
    obtain ⟨R, _, I, F, hs, hna, θ, hP, hM⟩ :=
      CFSG.StandardType.Canonical.largeEvenRawDatum_exists hraw
    have hpJ : p ∣ Nat.card ↥J :=
      CFSG.LocalAnalysis.GLTheoremB.MovingAround.Claims1110d.prime_dvd_card_of_glaPComponent
        hS.prime hS.pcomp
    have hJleL : J ≤ L := hS.comp.1.1.trans inf_le_left
    have hpL : p ∣ Nat.card ↥L := hpJ.trans (Subgroup.card_dvd_of_le hJleL)
    obtain ⟨eP⟩ := pSimple_equiv_centerQuot_of_dvd hS.prime hS.qs hpL
    have hshapeR : catalogIs R (onLie (I171.I171LieShape p)) := by
      have h1 : ¬ p ∣ 1 := Nat.Prime.not_dvd_one hS.prime
      cases htag : lab.tag
      case A => exact shape_A_of_label hS.prime hlab htag hM hpd
      case twA => exact shape_twA_of_label hS.prime hlab htag hM hpd
      case E6 => exact shape_E6_of_label hS.prime hlab htag hM hpd
      case twE6 => exact shape_twE6_of_label hS.prime hlab htag hM hpd
      all_goals
        exact absurd (by
          have h2 : CFSG.LocalAnalysis.GLTheoremA.rk2DiagIndex lab = 1 := by
            simp [CFSG.LocalAnalysis.GLTheoremA.rk2DiagIndex, htag]
          rw [h2] at hpd
          exact hpd) h1
    have hshapeZ : catalogIs (↥L ⧸ Subgroup.center ↥L) (onLie (I171.I171LieShape p)) :=
      (CFSG.LocalAnalysis.GLTheoremA.catalogIs_congr θ
        (Q := onLie (I171.I171LieShape p))).mpr hshapeR
    exact (CFSG.LocalAnalysis.GLTheoremA.catalogIs_congr eP
      (Q := onLie (I171.I171LieShape p))).mp hshapeZ
  · left
    haveI : Fact p.Prime := ⟨hS.prime⟩
    have hstep : GLARawDatum lab (fun R _ I F =>
        (IsSimpleGroup R ∧ (∃ a b : R, a * b ≠ b * a) ∧
          ∃ θ : ↥L ⧸ Subgroup.center ↥L ≃* R,
            (A ≤ Subgroup.normalizer (L : Set G) ∧
              ∀ a ∈ A, ∃ φ ∈ I, LargeEvenInduces θ
                (fun l l' => (l' : G) = a⁻¹ * l * a) φ) ∧
            CFSG.StandardType.MarkedModel lab R) ∧
        (∀ E : Subgroup (MulAut R),
          E ≤ Subgroup.closure (I ∪ Set.range (MulAut.conj : R →* MulAut R)) →
            IsPGroup p E → E ≤ (MulAut.conj : R →* MulAut R).range)) :=
      CFSG.LocalAnalysis.GLTheoremA.rk2_pSubgroup_le_inn' (lab := lab) hlab hS.prime
        hS.odd hpd (fun R _ I F =>
          (IsSimpleGroup R ∧ (∃ a b : R, a * b ≠ b * a) ∧
            ∃ θ : ↥L ⧸ Subgroup.center ↥L ≃* R,
              (A ≤ Subgroup.normalizer (L : Set G) ∧
                ∀ a ∈ A, ∃ φ ∈ I, LargeEvenInduces θ
                  (fun l l' => (l' : G) = a⁻¹ * l * a) φ) ∧
              CFSG.StandardType.MarkedModel lab R)) hraw
    obtain ⟨R, hR, I, F, hQ, hIinn⟩ :=
      CFSG.StandardType.Canonical.largeEvenRawDatum_exists hstep
    obtain ⟨hs, hna, θ, hP, hM⟩ := hQ
    have hbN : b ∈ Subgroup.normalizer (L : Set G) := hP.1 hS.b_mem
    have hbp : b ^ p = 1 := hS.elem.2 b hS.b_mem
    obtain ⟨φ, hφI, hφind⟩ := hP.2 b hS.b_mem
    have hφpow : φ ^ p = 1 := largeEvenInduces_pow_eq_one hbN hφind hbp
    have hφp : IsPGroup p (Subgroup.zpowers φ) := by
      rcases hS.prime.eq_one_or_self_of_dvd (orderOf φ)
        (orderOf_dvd_of_pow_eq_one hφpow) with h1 | hp'
      · exact IsPGroup.of_card (n := 0) (by rw [Nat.card_zpowers, h1, pow_zero])
      · exact IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hp', pow_one])
    have hle : Subgroup.zpowers φ ≤
        Subgroup.closure (I ∪ Set.range (MulAut.conj : R →* MulAut R)) :=
      Subgroup.zpowers_le_of_mem (Subgroup.subset_closure (Set.mem_union_left _ hφI))
    have hinner : φ ∈ Set.range (MulAut.conj : R →* MulAut R) :=
      hIinn (Subgroup.zpowers φ) hle hφp (Subgroup.mem_zpowers φ)
    obtain ⟨r, hr⟩ := hinner
    refine inducesInnerMod_of_marked_conj (R := R) (θ := θ) (r := r) hbN ?_ ?_
    · exact Group.isPerfect_def.mpr hS.qs.1
    · rw [hr]
      exact hφind

end CFSG.LocalAnalysis.GLTheoremA.T171Sh

