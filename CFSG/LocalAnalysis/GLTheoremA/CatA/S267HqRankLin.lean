section Sign

variable {K : Type} [Field K] {N : ℕ}

private def signVec (N : ℕ) (K : Type) [Field K] (j : Fin 7) : Fin N → K :=
  fun i => if i.val = 0 ∨ i.val = j.val + 1 then -1 else 1

private theorem signVec_mul_self (j : Fin 7) (i : Fin N) :
    signVec N K j i * signVec N K j i = 1 := by
  unfold signVec
  split_ifs <;> simp

private theorem diagonal_signVec_mul_self (j : Fin 7) :
    diagonal (signVec N K j) * diagonal (signVec N K j) = 1 := by
  rw [diagonal_mul_diagonal, ← diagonal_one]
  exact congrArg diagonal (funext (signVec_mul_self j))

private def signGL (N : ℕ) (K : Type) [Field K] (j : Fin 7) : GL (Fin N) K :=
  ⟨diagonal (signVec N K j), diagonal (signVec N K j), diagonal_signVec_mul_self j,
    diagonal_signVec_mul_self j⟩

private theorem det_signVec (hN : 8 ≤ N) (j : Fin 7) : (diagonal (signVec N K j)).det = 1 := by
  classical
  rw [det_diagonal]
  unfold signVec
  rw [Finset.prod_ite]
  simp only [Finset.prod_const, one_pow, mul_one]
  have hcard : (Finset.univ.filter fun i : Fin N => i.val = 0 ∨ i.val = j.val + 1).card = 2 := by
    rw [Finset.card_eq_two]
    refine ⟨⟨0, by omega⟩, ⟨j.val + 1, by omega⟩, fun h => by
      have := congrArg Fin.val h
      simp only at this
      omega, ?_⟩
    ext i
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert,
      Finset.mem_singleton, Fin.ext_iff]
  rw [hcard]
  norm_num

private theorem exists_elemAbelian_two_statedProj [Finite K] (h2 : (2 : K) ≠ 0) (hN : 9 ≤ N)
    (H : Subgroup (GL (Fin N) K)) (hH : ∀ j, signGL N K j ∈ H) :
    ∃ E : Subgroup (StatedProj H), IsElemAbelian 2 E ∧ Nat.card E = 2 ^ 7 := by
  classical
  have : Finite (StatedProj H) := inferInstance
  set Zs := (StatedScalars (Fin N) K).subgroupOf H with hZs
  set ρ : H →* StatedProj H := QuotientGroup.mk' Zs with hρ
  set y : Fin 7 → StatedProj H := fun j => ρ ⟨signGL N K j, hH j⟩ with hy
  set i8 : Fin N := ⟨8, by omega⟩ with hi8
  have hne : (-1 : K) ≠ 1 := fun h => h2 (by linear_combination -h)
  have hscal : ∀ g : H, g ∈ Zs → ∃ c : K, ∀ v : Fin N → K,
      ((g : GL (Fin N) K) : Matrix (Fin N) (Fin N) K) *ᵥ v = c • v := by
    intro g hg
    rw [hZs, mem_subgroupOf, StatedScalars, MonoidHom.mem_range] at hg
    obtain ⟨c, hc⟩ := hg
    refine ⟨c, fun v => ?_⟩
    rw [← hc, Matrix.GeneralLinearGroup.coe_scalar]
    ext i
    simp [Matrix.mulVec_diagonal, Matrix.scalar_apply]
  have hsv : ∀ (j : Fin 7) (k : Fin N), ((signGL N K j : GL (Fin N) K) :
      Matrix (Fin N) (Fin N) K) *ᵥ Pi.single k 1 = signVec N K j k • Pi.single k 1 := by
    intro j k
    change diagonal (signVec N K j) *ᵥ Pi.single k 1 = _
    rw [diagonal_mulVec_single, mul_one]
    ext i
    by_cases h : i = k
    · subst h
      simp
    · simp [Pi.single_apply, h]
  have hsv8 : ∀ j, signVec N K j i8 = 1 := fun j => by
    unfold signVec
    rw [if_neg (by simp [hi8]; omega)]
  have hsvj : ∀ j : Fin 7, signVec N K j ⟨j.val + 1, by omega⟩ = -1 := fun j => by
    unfold signVec
    rw [if_pos (Or.inr rfl)]
  have hc1 : ∀ c : K, c • (Pi.single i8 1 : Fin N → K) = Pi.single i8 1 → c = 1 := by
    intro c hc
    have := congrFun hc i8
    simpa using this
  have hy2 : ∀ j, y j ^ 2 = 1 := by
    intro j
    rw [hy, ← map_pow]
    have : (⟨signGL N K j, hH j⟩ : H) ^ 2 = 1 := by
      rw [pow_two]
      exact Subtype.ext (Units.ext (diagonal_signVec_mul_self j))
    rw [this, map_one]
  have hy1 : ∀ j, y j ≠ 1 := by
    intro j h
    obtain ⟨c, hc⟩ := hscal _ ((QuotientGroup.eq_one_iff _).1 h)
    have h8 := hc (Pi.single i8 1)
    have h0 := hc (Pi.single ⟨0, by omega⟩ 1)
    change ((signGL N K j : GL (Fin N) K) : Matrix (Fin N) (Fin N) K) *ᵥ _ = _ at h8 h0
    rw [hsv, hsv8, one_smul] at h8
    rw [hsv] at h0
    have hc' := hc1 c h8.symm
    rw [hc', one_smul] at h0
    have h00 : signVec N K j ⟨0, by omega⟩ = -1 := by
      unfold signVec
      rw [if_pos (Or.inl rfl)]
    rw [h00] at h0
    have : (-1 : K) = 1 := by simpa using congrFun h0 ⟨0, by omega⟩
    exact hne this
  have hyo : ∀ j, orderOf (y j) = 2 := fun j => orderOf_eq_prime (hy2 j) (hy1 j)
  have hycomm : ∀ i j, y i * y j = y j * y i := by
    intro i j
    rw [hy, ← map_mul, ← map_mul]
    congr 1
    refine Subtype.ext (Units.ext ?_)
    change diagonal (signVec N K i) * diagonal (signVec N K j) =
      diagonal (signVec N K j) * diagonal (signVec N K i)
    rw [diagonal_mul_diagonal, diagonal_mul_diagonal]
    exact congrArg diagonal (funext fun k => mul_comm _ _)
  have hyind : iSupIndep fun j => zpowers (y j) := by
    rw [iSupIndep_def]
    intro j
    rw [disjoint_iff, eq_bot_iff]
    rintro x ⟨hx, hxs⟩
    rw [mem_bot]
    obtain ⟨k, rfl⟩ := mem_zpowers_iff.1 hx
    have hk : (y j) ^ k = (y j) ^ (k % 2) := by
      rw [← zpow_mod_orderOf, hyo j]
      norm_num
    rw [hk] at hxs ⊢
    rcases Int.emod_two_eq_zero_or_one k with h0 | h1
    · rw [h0, zpow_zero]
    · exfalso
      rw [h1, zpow_one] at hxs
      set ej : Fin N → K := Pi.single ⟨j.val + 1, by omega⟩ 1 with hej
      set e8 : Fin N → K := Pi.single i8 1 with he8
      have hfix : ∀ {g : H} {v : Fin N → K},
          ((g : GL (Fin N) K) : Matrix (Fin N) (Fin N) K) *ᵥ v = v →
          ((g⁻¹ : H) : GL (Fin N) K).val *ᵥ v = v := by
        intro g v hg
        calc ((g⁻¹ : H) : GL (Fin N) K).val *ᵥ v
            = ((g⁻¹ : H) : GL (Fin N) K).val *ᵥ (((g : GL (Fin N) K) : Matrix _ _ K) *ᵥ v) := by
              rw [hg]
          _ = v := by
              rw [mulVec_mulVec, Subgroup.coe_inv, Units.inv_mul, one_mulVec]
      let St : Subgroup H :=
        { carrier := {g | ((g : GL (Fin N) K) : Matrix (Fin N) (Fin N) K) *ᵥ ej = ej ∧
            ((g : GL (Fin N) K) : Matrix (Fin N) (Fin N) K) *ᵥ e8 = e8}
          one_mem' := ⟨one_mulVec _, one_mulVec _⟩
          mul_mem' := fun {a b} ha hb => ⟨by
              rw [Subgroup.coe_mul, Units.val_mul, ← mulVec_mulVec, hb.1, ha.1], by
              rw [Subgroup.coe_mul, Units.val_mul, ← mulVec_mulVec, hb.2, ha.2]⟩
          inv_mem' := fun {a} ha => ⟨hfix ha.1, hfix ha.2⟩ }
      have hle : (⨆ (i : Fin 7) (_ : i ≠ j), zpowers (y i)) ≤ St.map ρ := by
        refine iSup₂_le fun i hij => ?_
        rw [zpowers_le]
        refine ⟨⟨signGL N K i, hH i⟩, ⟨?_, ?_⟩, rfl⟩
        · change ((signGL N K i : GL (Fin N) K) : Matrix (Fin N) (Fin N) K) *ᵥ ej = ej
          rw [hej, hsv]
          have : signVec N K i ⟨j.val + 1, by omega⟩ = 1 := by
            unfold signVec
            rw [if_neg]
            intro h
            rcases h with h | h
            · simp at h
            · exact hij (Fin.ext (by simp at h; omega))
          rw [this, one_smul]
        · change ((signGL N K i : GL (Fin N) K) : Matrix (Fin N) (Fin N) K) *ᵥ e8 = e8
          rw [he8, hsv, hsv8, one_smul]
      obtain ⟨g, hgSt, hgy⟩ := hle hxs
      have hmem : g⁻¹ * ⟨signGL N K j, hH j⟩ ∈ Zs := (QuotientGroup.eq (s := Zs)).1 hgy
      obtain ⟨c, hc⟩ := hscal _ hmem
      have hact : ∀ v : Fin N → K, ((g : GL (Fin N) K) : Matrix (Fin N) (Fin N) K) *ᵥ v = v →
          ((g⁻¹ * ⟨signGL N K j, hH j⟩ : H) : GL (Fin N) K).val *ᵥ v =
            ((g⁻¹ : H) : GL (Fin N) K).val *ᵥ
              (((signGL N K j : GL (Fin N) K) : Matrix (Fin N) (Fin N) K) *ᵥ v) := by
        intro v _
        rw [Subgroup.coe_mul, Units.val_mul, ← mulVec_mulVec]
      have h8 := hc e8
      rw [hact e8 hgSt.2, he8, hsv, hsv8, one_smul, ← he8, hfix hgSt.2] at h8
      have hc' := hc1 c h8.symm
      have hj := hc ej
      rw [hact ej hgSt.1, hej, hsv, hsvj, ← hej, mulVec_smul, hfix hgSt.1, hc'] at hj
      have : (-1 : K) = 1 := by simpa [hej] using congrFun hj ⟨j.val + 1, by omega⟩
      exact hne this
  obtain ⟨hE2, hE2c⟩ := i1020_family y hyo (fun i j _ => hycomm i j) hyind
  exact ⟨_, hE2, by rw [hE2c, Fintype.card_fin]⟩

private theorem signGL_mem_statedSL (hN : 8 ≤ N) (j : Fin 7) : signGL N K j ∈ StatedSL N K :=
  Subgroup.subset_closure (det_signVec hN j)

private theorem signGL_mem_statedSU {p f : ℕ}
    (h : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData p f K) (hN : 8 ≤ N) (j : Fin 7) :
    signGL N K j ∈ StatedSU N (p ^ f) K := by
  have hmem := (CFSG.ClassicalGroups.UnitaryFlag.mem_unitarySU_iff h (n := N)
    (A := signGL N K j)).2
  refine hmem ⟨det_signVec hN j, ?_⟩
  change ((diagonal (signVec N K j)).map h.bar)ᵀ * diagonal (signVec N K j) = 1
  rw [Matrix.diagonal_map (map_zero h.bar), Matrix.diagonal_transpose]
  have hs : (fun i => h.bar (signVec N K j i)) = signVec N K j := by
    funext i
    unfold signVec
    split_ifs <;> simp
  rw [hs]
  exact diagonal_signVec_mul_self j

private theorem exists_not_comm_of_commutator_eq_top {G : Type} [Group G] [Nontrivial G]
    (h : commutator G = ⊤) : ∃ a b : G, a * b ≠ b * a := by
  by_contra hcon
  push Not at hcon
  have hbot : commutator G = ⊥ := by
    rw [commutator_eq_bot_iff_center_eq_top, eq_top_iff]
    intro x _
    rw [mem_center_iff]
    intro y
    exact hcon y x
  rw [hbot] at h
  obtain ⟨x, hx⟩ := exists_ne (1 : G)
  have hxb : x ∈ (⊥ : Subgroup G) := h.symm ▸ mem_top x
  exact hx (mem_bot.1 hxb)

end Sign

section Row

variable {K : Type} [Field K] {N : ℕ}

private def rowMap (N : ℕ) (K : Type) [Field K] : (Fin 6 → K) →+ Matrix (Fin N) (Fin N) K where
  toFun a := Matrix.of fun i k =>
    if h : i.val = 0 ∧ 1 ≤ k.val ∧ k.val ≤ 6 then a ⟨k.val - 1, by omega⟩ else 0
  map_zero' := by
    ext i k
    simp
  map_add' a b := by
    ext i k
    simp only [of_apply, Pi.add_apply, Matrix.add_apply]
    split_ifs <;> simp

private theorem rowMap_apply_eq_zero {a : Fin 6 → K} {i k : Fin N}
    (h : ¬ (i.val = 0 ∧ 1 ≤ k.val ∧ k.val ≤ 6)) : rowMap N K a i k = 0 := by
  change (if h : i.val = 0 ∧ 1 ≤ k.val ∧ k.val ≤ 6 then a ⟨k.val - 1, by omega⟩ else 0) = 0
  rw [dif_neg h]

private theorem rowMap_mul (a b : Fin 6 → K) : rowMap N K a * rowMap N K b = 0 := by
  ext i k
  rw [mul_apply, Matrix.zero_apply]
  refine Finset.sum_eq_zero fun l _ => ?_
  by_cases hl : l.val = 0
  · rw [rowMap_apply_eq_zero (i := i) (k := l) (by omega), zero_mul]
  · rw [rowMap_apply_eq_zero (i := l) (k := k) (by omega), mul_zero]

private theorem rowMap_injective (hN : 7 ≤ N) : Function.Injective (rowMap N K) := by
  intro a b hab
  funext j
  have h := congrFun (congrFun hab ⟨0, by omega⟩) ⟨j.val + 1, by omega⟩
  have hc : (⟨0, by omega⟩ : Fin N).val = 0 ∧ 1 ≤ (⟨j.val + 1, by omega⟩ : Fin N).val ∧
      (⟨j.val + 1, by omega⟩ : Fin N).val ≤ 6 :=
    ⟨rfl, show 1 ≤ j.val + 1 by omega, show j.val + 1 ≤ 6 by omega⟩
  change (if h : _ then a _ else 0) = (if h : _ then b _ else 0) at h
  rw [dif_pos hc, dif_pos hc] at h
  simpa using h

private def lowSign8 (N : ℕ) (K : Type) [Field K] : Fin N → K :=
  fun i => if i.val < 8 then -1 else 1

private theorem six_le_localRank_PSL [Finite K] {p f : ℕ} [Fact p.Prime] [CharP K p] (hp2 : p ≠ 2)
    (hK : Nat.card K = p ^ f) (hN : 9 ≤ N) :
    f * 6 ≤ localRank p (ProjectiveSpecialLinearGroup (Fin N) K) := by
  have h2 : (2 : K) ≠ 0 := CFSG.RankThree.PartOne.Census3.two_ne_zero_of_charP hp2
  have hne : (-1 : K) ≠ 1 := fun h => h2 (by linear_combination -h)
  refine CFSG.RankThree.PartOne.Census3.le_localRank_PSL_of_unipotent (s := lowSign8 N K)
    (fun i => by unfold lowSign8; split_ifs <;> simp) ?_ (i₀ := ⟨0, by omega⟩) (j₀ := ⟨8, by omega⟩)
    (by unfold lowSign8; simpa using hne) (rowMap N K) (rowMap_injective (by omega)) rowMap_mul
    (fun a i => rowMap_apply_eq_zero (by omega)) ?_ (k := f * 6) ?_
  · rw [det_diagonal]
    unfold lowSign8
    rw [Finset.prod_ite, Finset.prod_const, Finset.prod_const_one, mul_one,
      Fin.card_filter_val_lt, min_eq_right (by omega)]
    norm_num
  · intro a i k hik
    by_cases hc : i.val = 0 ∧ 1 ≤ k.val ∧ k.val ≤ 6
    · unfold lowSign8
      rw [if_pos (by omega), if_pos (by omega)]
    · exact absurd (rowMap_apply_eq_zero hc) hik
  · rw [Nat.card_fun, Nat.card_fin, hK, ← pow_mul]

end Row

theorem six_le_twoLocalRank_of_PSL {K : Type} [Field K] [Fintype K] {p f N : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (hK : Fintype.card K = p ^ f) (hN : 9 ≤ N) {X : Type} [Group X] [Finite X]
    (φ : X →* ProjectiveSpecialLinearGroup (Fin N) K) (hφ : Function.Surjective φ) :
    6 ≤ GLATwoLocalRank p X := by
  have : Fact p.Prime := ⟨hp⟩
  have : CharP K p := charP_of_card_eq_prime_pow hK
  have hK' : Nat.card K = p ^ f := by rw [Nat.card_eq_fintype_card, hK]
  have hf : 1 ≤ f := by
    by_contra h0
    have : f = 0 := by omega
    rw [this, pow_zero] at hK
    exact absurd hK (Fintype.one_lt_card).ne'
  have h2 : (2 : K) ≠ 0 := CFSG.RankThree.PartOne.Census3.two_ne_zero_of_charP hp2
  haveI : IsSimpleGroup (ProjectiveSpecialLinearGroup (Fin N) K) :=
    (CFSG.LinearGroups.linear_projective_simple (K := K) (n := N) (by omega)
      (Or.inl (by omega))).2.1
  obtain ⟨hperf, ⟨eM⟩⟩ :=
    CFSG.LieType.Steinberg.CentralExt.SLClosed.psl_hopfMultiplier_of_five_le (k := K) (n := N)
      (by omega)
  have hnc := exists_not_comm_of_commutator_eq_top hperf
  have hM : ¬ p ∣ Nat.card (CFSG.Open.griessHopfMultiplier
      (ProjectiveSpecialLinearGroup (Fin N) K)) := by
    rw [Nat.card_congr eM.toEquiv, Nat.card_congr Multiplicative.toAdd, Nat.card_zmod]
    intro hd
    have h1 : p ∣ Fintype.card K - 1 := hd.trans (Nat.gcd_dvd_right _ _)
    have h3 : p ∣ Fintype.card K := by rw [hK]; exact dvd_pow_self p (by omega)
    have h4 := Nat.dvd_sub h3 h1
    rw [Nat.sub_sub_self Fintype.card_pos] at h4
    exact hp.one_lt.ne' (Nat.dvd_one.1 h4)
  obtain ⟨E, hE, hEc⟩ := exists_elemAbelian_two_statedProj h2 hN (StatedSL N K)
    (signGL_mem_statedSL (by omega))
  obtain ⟨eP⟩ : Nonempty (ProjectiveSpecialLinearGroup (Fin N) K ≃* StatedProj (StatedSL N K)) :=
    ⟨CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj N K⟩
  have hV : IsElemAbelian 2 (E.map eP.symm.toMonoidHom) :=
    CFSG.SectionRank.isElemAbelian_map hE _
  have hVc : Nat.card (E.map eP.symm.toMonoidHom) = 2 ^ (6 + 1) := by
    rw [Subgroup.card_map_of_injective eP.symm.injective, hEc]
  have hF6 : 6 ≤ GLATwoLocalRank p (ProjectiveSpecialLinearGroup (Fin N) K) := by
    have := six_le_localRank_PSL (K := K) hp2 hK' hN
    change 6 ≤ localRank p _
    omega
  exact le_twoLocalRank_of_surj hnc hp hp2 hV hVc
    (twoLocalRank_cover_of_multiplier hnc hp hM hF6) φ hφ

theorem six_le_twoLocalRank_of_PSU
    {K : Type} [Field K] [Finite K] {p f N : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (hf : 1 ≤ f) (hK : Nat.card K = (p ^ f) ^ 2) (hN : 9 ≤ N) {X : Type}
    [Group X] [Finite X] (φ : X →* StatedProj (StatedSU N (p ^ f) K))
    (hφ : Function.Surjective φ) : 6 ≤ GLATwoLocalRank p X := by
  have : Fact p.Prime := ⟨hp⟩
  have hK' : Nat.card K = p ^ (2 * f) := by rw [hK, ← pow_mul, mul_comm]
  have h : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData p f K := ⟨hp, hf, hK'⟩
  have : CharP K p := h.charP
  have h2 : (2 : K) ≠ 0 := CFSG.RankThree.PartTwo.Census.two_ne_zero_of_unitaryFieldData h hp2
  haveI : IsSimpleGroup (StatedProj (StatedSU N (p ^ f) K)) :=
    CFSG.ClassicalGroups.Unitary.isSimpleGroup_statedProj_statedSU K p f hK N (by omega)
      (fun h => by simp only [Prod.mk.injEq] at h; omega)
  have hodd : Odd (p ^ f) := (hp.odd_of_ne_two hp2).pow
  have hmult : commutator (StatedProj (StatedSU N (p ^ f) K)) = ⊤ ∧
      Nonempty (CFSG.Open.griessHopfMultiplier (StatedProj (StatedSU N (p ^ f) K)) ≃*
        Multiplicative (ZMod (Nat.gcd N (p ^ f + 1)))) := by
    by_cases he : Even N
    · by_cases hq3 : p ^ f = 3
      · obtain ⟨rfl, rfl⟩ := (Nat.Prime.pow_eq_iff Nat.prime_three).1 hq3
        exact CFSG.LieType.Steinberg.CentralExt.SUClosed.psu_three_hopfMultiplier hK he (by omega)
      · have h1 : 1 < p ^ f := Nat.one_lt_pow (by omega) hp.one_lt
        obtain ⟨k, hk⟩ := hodd
        exact CFSG.LieType.Steinberg.CentralExt.SUClosed.psu_hopfMultiplier hK he (by omega)
          (by omega)
    · exact CFSG.LieType.Steinberg.CentralExt.SUOdd.psu_odd_hopfMultiplier hK hf (by omega) he
        (fun h => by simp only [Prod.mk.injEq] at h; omega)
  have hnc := exists_not_comm_of_commutator_eq_top hmult.1
  have hM : ¬ p ∣ Nat.card (CFSG.Open.griessHopfMultiplier
      (StatedProj (StatedSU N (p ^ f) K))) := by
    obtain ⟨eM⟩ := hmult.2
    rw [Nat.card_congr eM.toEquiv, Nat.card_congr Multiplicative.toAdd, Nat.card_zmod]
    intro hd
    have h1 : p ∣ p ^ f + 1 := hd.trans (Nat.gcd_dvd_right _ _)
    have h3 : p ∣ p ^ f := dvd_pow_self p (by omega)
    exact hp.one_lt.ne' (Nat.dvd_one.1 ((Nat.dvd_add_right h3).1 h1))
  obtain ⟨E, hE, hEc⟩ := exists_elemAbelian_two_statedProj h2 hN (StatedSU N (p ^ f) K)
    (signGL_mem_statedSU h (by omega))
  have hVc : Nat.card E = 2 ^ (6 + 1) := hEc
  have hF6 : 6 ≤ GLATwoLocalRank p (StatedProj (StatedSU N (p ^ f) K)) := by
    have h1 := CFSG.RankThree.PartTwo.Census.le_localRank_unitaryPSU h hp2 (n := N) (r := 3)
      (by norm_num) (by omega)
    have h3 := CFSG.RankThree.PartTwo.Census.localRank_eq_of_mulEquiv
      (CFSG.ClassicalGroups.UnitaryFlag.unitaryPSUEquiv h (n := N) (by omega)) hp
    change 6 ≤ localRank p _
    rw [← h3]
    nlinarith
  exact le_twoLocalRank_of_surj hnc hp hp2 hE hVc
    (twoLocalRank_cover_of_multiplier hnc hp hM hF6) φ hφ

theorem six_le_twoLocalRank_A {n : ℕ} (hn : 8 ≤ n) (Q : TauCeti.PrimePower)
    (hv : (TauCeti.LieTypeIndex.A n Q).Valid) (hq2 : Q.p ≠ 2) {X : Type} [Group X] [Finite X]
    (φ : X →* (TauCeti.CFSGIndex.lie ⟨.A n Q, hv⟩).Group) (hφ : Function.Surjective φ) :
    6 ≤ GLATwoLocalRank Q.p X := by
  haveI : Fact Q.p.Prime := ⟨Q.prime_p⟩
  letI : Fintype (GaloisField Q.p Q.exponent) := Fintype.ofFinite _
  have hK : Fintype.card (GaloisField Q.p Q.exponent) = Q.p ^ Q.exponent := by
    rw [Fintype.card_eq_nat_card, GaloisField.card _ _ Q.exponent_pos.ne']
  let e := CFSG.ClassicalModels.linearCatalogCandidateEquivPSL n Q hv
  exact six_le_twoLocalRank_of_PSL Q.prime_p hq2 hK (by omega) (e.toMonoidHom.comp φ)
    (e.surjective.comp hφ)

theorem six_le_twoLocalRank_twistedA
    {n : ℕ} (hn : 8 ≤ n) (Q : TauCeti.PrimePower)
    (hv : (TauCeti.LieTypeIndex.twistedA n Q).Valid) (hq2 : Q.p ≠ 2) {X : Type} [Group X]
    [Finite X] (φ : X →* (TauCeti.CFSGIndex.lie ⟨.twistedA n Q, hv⟩).Group)
    (hφ : Function.Surjective φ) : 6 ≤ GLATwoLocalRank Q.p X := by
  have hc : TauCeti.ValidLieTypeIndex.characteristic ⟨.twistedA n Q, hv⟩ = Q.p :=
    TauCeti.LieTypeIndex.characteristic_twistedA n Q
  have hfe := TauCeti.ValidLieTypeIndex.fieldExponent_pos ⟨.twistedA n Q, hv⟩
  have hcp : (TauCeti.ValidLieTypeIndex.characteristic ⟨.twistedA n Q, hv⟩).Prime := by
    rw [hc]
    exact Q.prime_p
  haveI : Fact (TauCeti.ValidLieTypeIndex.characteristic ⟨.twistedA n Q, hv⟩).Prime := ⟨hcp⟩
  have hK : Nat.card (GaloisField (TauCeti.ValidLieTypeIndex.characteristic ⟨.twistedA n Q, hv⟩)
      (2 * TauCeti.ValidLieTypeIndex.fieldExponent ⟨.twistedA n Q, hv⟩)) =
      (TauCeti.ValidLieTypeIndex.characteristic ⟨.twistedA n Q, hv⟩ ^
        TauCeti.ValidLieTypeIndex.fieldExponent ⟨.twistedA n Q, hv⟩) ^ 2 := by
    rw [GaloisField.card _ _ (by omega), ← pow_mul, mul_comm]
  let e := CFSG.QuasithinUnique.SQTK.typeTwistedAGroupEquivStatedProj n Q hv
  have := six_le_twoLocalRank_of_PSU hcp (by rw [hc]; exact hq2) hfe hK (by omega)
    (e.toMonoidHom.comp φ) (e.surjective.comp hφ)
  rwa [hc] at this

end CFSG.LocalAnalysis.GLTheoremA.S267.HqRank
