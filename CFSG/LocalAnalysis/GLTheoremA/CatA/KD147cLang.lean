theorem kd147c_inner_class (hT : rootDiagUnit Tag.G2 a ∈ S.D.torus)
    (i : KernelComponent (rootCharHom a)) (hk : twistKind S.ρ (rootCharHom a) i = .inner)
    (hQ : 4 ≤ S.D.q) {γ : Fin Tag.G2.rank → ℤ} (hγ : γ ∈ componentRoots (rootCharHom a) i) :
    CFSG.IsQuasisimple ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ∧
      3 ∣ Nat.card ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) := by
  classical
  obtain ⟨hs0, hs, hmin⟩ := outer_componentOrbitLength_spec S hT i
  set s := componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) with hsdef
  have : NeZero s := ⟨hs0.ne'⟩
  have hinner := twistInner_of_twistKind_eq_innerT S rootAutIsWeyl_holds hT i hk
  obtain ⟨σ, z, hσ, hnorm, hz⟩ := exists_untwistT S hT i hs0 hinner
  obtain ⟨r, e, hr, hchar, he, hq⟩ := exists_char_pow S
  have : Fact r.Prime := ⟨hr⟩
  have hσ' : ∀ c, σ c = c ^ (r ^ (e * s)) := fun c => by rw [hσ, hq, ← pow_mul]
  have hQ' : 4 ≤ r ^ (e * s) := by
    rw [pow_mul, ← hq]
    exact hQ.trans (Nat.le_self_pow hs0.ne' _)
  obtain ⟨t, ht⟩ := exists_unit_sq_ne_one (L := L) σ hσ' (Nat.mul_pos he hs0) hQ'
  have hsL : ∃ u : Lˣ, u ^ 2 ≠ 1 := by
    refine ⟨Units.map (fixSubfield σ).subtype.toMonoidHom t, fun h => ht ?_⟩
    apply Units.ext
    apply Subtype.ext
    simpa using congrArg (fun x : Lˣ => (x : L)) h
  have hperfC := isPerfect_componentRootSpan_of_sq_ne_one (K := fixSubfield σ)
    (χ := rootCharHom a) ht i
  have hQS := isQuasisimple_componentRootSpan_of_sq_ne_one (K := fixSubfield σ)
    (χ := rootCharHom a) ht i
  obtain ⟨f, hf1, hker, hf2⟩ :=
    rationalComponent_eq_range_componentRootSpanT S hT i hs hmin σ z hnorm hz hsL
  have hR : f.range = rationalComponent S.ρ S.Γ (rootCharHom a) i :=
    le_antisymm (hf2 (Subgroup.isPerfect_iff.1 hperfC)) hf1
  refine ⟨hR ▸ isQuasisimple_range_of_ker_le_center hQS f hker, ?_⟩
  have hΨ := isRootComponent_componentRoots (χ := rootCharHom a) i
  have hγroot : IsRoot Tag.G2 γ := hΨ.isRoot γ hγ
  have hnγ : -γ ∈ componentRoots (rootCharHom a) i := hΨ.neg_mem γ hγ
  have hmem : ∀ A : SL(2, fixSubfield σ), rootSL2 Tag.G2 (fixSubfield σ) γ A ∈
      componentRootSpan (fixSubfield σ) (rootCharHom a) i := by
    intro A
    have hle : rootSubgroup Tag.G2 (fixSubfield σ) γ ⊔ rootSubgroup Tag.G2 (fixSubfield σ) (-γ) ≤
        componentRootSpan (fixSubfield σ) (rootCharHom a) i :=
      sup_le (le_iSup₂ (f := fun α (_ : α ∈ componentRoots (rootCharHom a) i) =>
          rootSubgroup Tag.G2 (fixSubfield σ) α) γ hγ)
        (le_iSup₂ (f := fun α (_ : α ∈ componentRoots (rootCharHom a) i) =>
          rootSubgroup Tag.G2 (fixSubfield σ) α) (-γ) hnγ)
    rw [← CFSG.RankThree.Chevalley.range_rootSL2_of_isRoot hγroot] at hle
    exact hle ⟨A, rfl⟩
  let m₁ : ↥(componentRootSpan (fixSubfield σ) (rootCharHom a) i) :=
    ⟨rootSL2 Tag.G2 (fixSubfield σ) γ (kd147cM (fixSubfield σ)), hmem _⟩
  let y₁ : ↥(componentRootSpan (fixSubfield σ) (rootCharHom a) i) :=
    ⟨rootSL2 Tag.G2 (fixSubfield σ) γ (kd147cL (fixSubfield σ)), hmem _⟩
  have hm₁3 : m₁ ^ 3 = 1 := by
    apply Subtype.ext
    change (rootSL2 Tag.G2 (fixSubfield σ) γ (kd147cM (fixSubfield σ))) ^ 3 = 1
    rw [← map_pow, kd147cM_pow_three, map_one]
  have hm₁nc : m₁ ∉ Subgroup.center ↥(componentRootSpan (fixSubfield σ) (rootCharHom a) i) := by
    intro hc
    have hcomm := Subgroup.mem_center_iff.1 hc y₁
    apply kd147cL_mul_ne (fixSubfield σ)
    apply CFSG.RankThree.Chevalley.rootSL2_injective_of_field (τ := Tag.G2) γ
    rw [map_mul, map_mul]
    exact congrArg Subtype.val hcomm
  have hfm₁ : f m₁ ≠ 1 := fun h => hm₁nc (hker h)
  have hfm₃ : (f m₁) ^ 3 = 1 := by rw [← map_pow, hm₁3, map_one]
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact kd147c_three_dvd_card (hR ▸ (⟨m₁, rfl⟩ : f m₁ ∈ f.range)) (orderOf_eq_prime hfm₃ hfm₁)

theorem kd147c_suN_class (hT : rootDiagUnit Tag.G2 a ∈ S.D.torus)
    (hTp : rootDiagUnit Tag.G2 a ^ 3 = 1) (h3L : ((3 : ℕ) : L) ≠ 0)
    (i : KernelComponent (rootCharHom a)) (hk : twistKind S.ρ (rootCharHom a) i = .suN)
    (hQ : 4 ≤ S.D.q) :
    CFSG.IsQuasisimple ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ∧
      3 ∣ Nat.card ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) := by
  classical
  obtain ⟨h2, hn⟩ := suN_rank_ncard hk
  obtain ⟨ν, ψ, σ, κ, hν, hψ, hκ, hnorm, hΨ⟩ := exists_frame_of_typeA_tag_T_of_prime
    g2LongA2Frame_proved S Nat.prime_three h3L hTp i h2 hn
  have hrk : compRank (componentRoots (rootCharHom a) i) ≤ 2 :=
    compRank_le_rank (componentRoots (rootCharHom a) i)
  have hν3 : ν = 3 := by
    have hc := kd147c_frameRoots_ncard hψ hκ hnorm
    rw [← hΨ, hn, show compRank (componentRoots (rootCharHom a) i) = 2 by omega] at hc
    by_contra hne
    have h4 : 4 ≤ ν := by omega
    have : 4 * 3 ≤ ν * (ν - 1) := Nat.mul_le_mul h4 (by omega)
    omega
  subst hν3
  obtain ⟨hs0, hs, -⟩ := outer_componentOrbitLength_spec S hT i
  set s := componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) with hsdef
  have hout : ¬ twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin Tag.G2.rank → ℤ) → _)^[s]) := by
    intro h
    unfold twistKind at hk
    rw [ite_eq_left_iff.2 (fun h' => absurd h h')] at hk
    exact absurd hk (by decide)
  have hmaps : ∀ x y, x ≠ y → (S.ρ : (Fin Tag.G2.rank → ℤ) → _)^[s] (σ x y) ∈ frameRoots σ := by
    intro x y hxy
    have h1 : σ x y ∈ componentRoots (rootCharHom a) i := by
      rw [hΨ]
      exact ⟨x, y, hxy, rfl⟩
    have h2 : (S.ρ : (Fin Tag.G2.rank → ℤ) → _)^[s] (σ x y) ∈
        (S.ρ : (Fin Tag.G2.rank → ℤ) → _)^[s] '' componentRoots (rootCharHom a) i := ⟨_, h1, rfl⟩
    rw [hs, hΨ] at h2
    exact h2
  have hneg : ∀ (n : ℕ) (γ : Fin Tag.G2.rank → ℤ),
      (S.ρ : (Fin Tag.G2.rank → ℤ) → _)^[n] (-γ) = -(S.ρ : (Fin Tag.G2.rank → ℤ) → _)^[n] γ := by
    intro n
    induction n with
    | zero => exact fun γ => rfl
    | succ n ih =>
      intro γ
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih, S.frob.neg_eq]
  rcases hψ.aut_cases hν hκ hnorm ((S.ρ : (Fin Tag.G2.rank → ℤ) → _)^[s]) hmaps (hneg s)
      (iform_rho_iterate S s) with ⟨π, hπ⟩ | ⟨π, hπ⟩
  · exfalso
    apply hout
    obtain ⟨w, hw, hwσ⟩ := hψ.exists_weyl_perm hκ hnorm π
    refine ⟨w, ?_, fun γ hγ => ?_⟩
    · rw [hΨ]
      exact hw
    · rw [hΨ] at hγ
      obtain ⟨x, y, hxy, rfl⟩ := hγ
      rw [hπ x y hxy, hwσ]
  · obtain ⟨r, e, hr, hchar, he, hq⟩ := exists_char_pow S
    haveI : Fact r.Prime := ⟨hr⟩
    have hes : 0 < e * s := Nat.mul_pos he hs0
    obtain ⟨σQ, hσc, f, hf1, hfker, hf2⟩ := two_suN_exists_hom S hT i hν hψ hΨ π hπ hr hchar he hq
    obtain ⟨-, hqsC, -⟩ := stdUnitary_fixSubgroup (ν := 3) hr hes σQ hσc hν
    have hQ' : 4 ≤ r ^ (e * s) := by
      rw [pow_mul, ← hq]
      exact hQ.trans (Nat.le_self_pow hs0.ne' _)
    have h32 : ((3 : ℕ), r ^ (e * s)) ≠ (3, 2) := fun h => by
      have := (Prod.mk.inj h).2
      omega
    have hCq := hqsC h32
    have hCperf : Group.IsPerfect ↥(SU₃fix σQ) := hCq.1
    have hRf : f.range = rationalComponent S.ρ S.Γ (rootCharHom a) i :=
      le_antisymm (hf2 hCperf) hf1
    refine ⟨hRf ▸ isQuasisimple_range_of_ker_le_center hCq f hfker, ?_⟩
    have hCmem : ∀ Y : SL(3, L), Y ∈ SU₃fix σQ ↔
        stdUnitary σQ.toRingHom Y = Y := fun Y => by
      rw [CFSG.RankThree.Classical2.mem_fixSubgroup, stdUnitaryEquiv_apply]
    let P₁ : ↥(SU₃fix σQ) :=
      ⟨kd147cCyc L, (hCmem _).2 (kd147c_stdUnitary_cyc _)⟩
    let Y₁ : ↥(SU₃fix σQ) :=
      ⟨kd147cSw L, (hCmem _).2 (kd147c_stdUnitary_sw _)⟩
    have hP₃ : P₁ ^ 3 = 1 := Subtype.ext kd147cCyc_pow_three
    have hPnc : P₁ ∉ Subgroup.center ↥(SU₃fix σQ) := by
      intro hc
      have hcomm := Subgroup.mem_center_iff.1 hc Y₁
      exact kd147cSw_mul_ne (congrArg Subtype.val hcomm)
    have hfP : f P₁ ≠ 1 := fun h => hPnc (hfker h)
    have hfP₃ : (f P₁) ^ 3 = 1 := by rw [← map_pow, hP₃, map_one]
    haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    exact kd147c_three_dvd_card (hRf ▸ (⟨P₁, rfl⟩ : f P₁ ∈ f.range)) (orderOf_eq_prime hfP₃ hfP)

theorem kd147c_rootDiagUnit_pow_three (hap : ∀ i, a i ^ 3 = 1) :
    rootDiagUnit Tag.G2 a ^ 3 = 1 := by
  have key : ∀ n : ℕ, rootDiagUnit Tag.G2 a ^ n = rootDiagUnit Tag.G2 (a ^ n) := by
    intro n
    induction n with
    | zero => rw [pow_zero, pow_zero, rootDiagUnit_one]
    | succ n ih => rw [pow_succ, ih, ← rootDiagUnit_mul, ← pow_succ]
  rw [key 3, show a ^ 3 = 1 from funext fun i => by simpa using hap i, rootDiagUnit_one]

theorem kd147c_exists_class (hT : rootDiagUnit Tag.G2 a ∈ S.D.torus) (hap : ∀ i, a i ^ 3 = 1)
    (h3L : ((3 : ℕ) : L) ≠ 0) (hQ : 4 ≤ S.D.q) :
    ∃ i : KernelComponent (rootCharHom a),
      CFSG.IsQuasisimple ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ∧
        3 ∣ Nat.card ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) := by
  obtain ⟨γ, hγr, hγ⟩ := kd147c_exists_kernel_root a hap
  have hγk : γ ∈ kernelRoots (rootCharHom a) := ⟨hγr, hγ⟩
  have hγi : γ ∈ componentRoots (rootCharHom a) (⟦⟨γ, hγk⟩⟧ : KernelComponent (rootCharHom a)) :=
    ⟨hγk, rfl⟩
  have hTp : rootDiagUnit Tag.G2 a ^ 3 = 1 := kd147c_rootDiagUnit_pow_three hap
  refine ⟨⟦⟨γ, hγk⟩⟧, ?_⟩
  rcases kd147c_twistKind_cases S.ρ (rootCharHom a) ⟦⟨γ, hγk⟩⟧ with hk | hk
  · exact kd147c_inner_class S hT _ hk hQ hγi
  · exact kd147c_suN_class S hT hTp h3L _ hk hQ

theorem kd147c_glaPComponent_of_rational {C : Type} [Group C] [Finite C]
    (hT : rootDiagUnit Tag.G2 a ∈ S.D.torus) (ι : C →* ModGL Tag.G2 L)
    (hι : Function.Injective ι) (hrange : ι.range = S.Γ) {x : C}
    (hconj : ∀ c, ι (MulAut.conj x c) = rootDiagUnit Tag.G2 a * ι c * (rootDiagUnit Tag.G2 a)⁻¹)
    (i : KernelComponent (rootCharHom a))
    (hq : CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom a) i))
    (h3 : 3 ∣ Nat.card (rationalComponent S.ρ S.Γ (rootCharHom a) i)) :
    GLAPComponent 3 (Subgroup.centralizer ({x} : Set C))
      ((rationalComponent S.ρ S.Γ (rootCharHom a) i).comap ι) ∧
      3 ∣ Nat.card ↥((rationalComponent S.ρ S.Γ (rootCharHom a) i).comap ι) := by
  classical
  set d := rootDiagUnit Tag.G2 a with hd
  set R := rationalComponent S.ρ S.Γ (rootCharHom a) i with hR
  obtain ⟨hle, hsub⟩ := langSubnormal_of_mem_torus S hT i
  have hcompR : IsComponentOf R (S.Γ ⊓ Subgroup.centralizer {d}) :=
    ⟨hle, (CFSG.Open.IsSubnormal.iff_subgroupOf hle).2 hsub, open_isQuasisimple hq⟩
  have hCdrange : S.Γ ⊓ Subgroup.centralizer {d} ≤ ι.range := fun y hy => by
    rw [hrange]
    exact (Subgroup.mem_inf.1 hy).1
  have hRrange : R ≤ ι.range := hle.trans hCdrange
  have hcomapC : (S.Γ ⊓ Subgroup.centralizer {d}).comap ι = Subgroup.centralizer {x} := by
    ext c
    simp only [Subgroup.mem_comap, Subgroup.mem_inf, Subgroup.mem_centralizer_singleton_iff]
    have hc := hconj c
    rw [MulAut.conj_apply] at hc
    constructor
    · rintro ⟨-, h⟩
      have h2 : d * ι c * d⁻¹ = ι c := by rw [← h, mul_inv_cancel_right]
      have h3 : x * c * x⁻¹ = c := hι (by rw [hc, h2])
      exact (mul_inv_eq_iff_eq_mul.1 h3).symm
    · intro h
      refine ⟨?_, ?_⟩
      · have : ι c ∈ ι.range := ⟨c, rfl⟩
        rwa [hrange] at this
      · have h1 : x * c * x⁻¹ = c := mul_inv_eq_iff_eq_mul.2 h.symm
        rw [h1] at hc
        exact eq_mul_inv_iff_mul_eq.1 hc
  have hcomp := isComponentOf_comap_of_injective ι hι hRrange hCdrange hcompR
  rw [hcomapC] at hcomp
  obtain ⟨hle', hsn', hq'⟩ := hcomp
  have hmap : (R.comap ι).map ι = R := Subgroup.map_comap_eq_self hRrange
  have e : ↥(R.comap ι) ≃* ↥R :=
    (Subgroup.equivMapOfInjective (R.comap ι) ι hι).trans (MulEquiv.subgroupCongr hmap)
  have h3' : 3 ∣ Nat.card ↥(R.comap ι) := by
    rw [Nat.card_congr e.toEquiv]
    exact h3
  exact ⟨i253_glaPComponent_of_subnormal hle' hsn' hq' h3', h3'⟩

end Classes

section Setup

theorem kd147c_baseChangeGL_mem {τ : Tag} {K₁ K₂ : Type} [Field K₁] [Field K₂] (f : K₁ →+* K₂)
    {g : ModGL τ K₁} (hg : g ∈ adjointGroup τ K₁) :
    baseChangeGL f g ∈ adjointGroup τ K₂ := by
  induction hg using Subgroup.closure_induction with
  | mem y hy =>
    obtain ⟨i, c, h | h⟩ := hy
    · rw [show y = xUnit τ K₁ i c from Units.ext h, baseChangeGL_xUnit]
      exact xUnit_mem_adjointGroup _ _
    · rw [show y = yUnit τ K₁ i c from Units.ext h, baseChangeGL_yUnit]
      exact yUnit_mem_adjointGroup _ _
  | one => simpa using one_mem _
  | mul x y _ _ hx hy => simpa using mul_mem hx hy
  | inv x _ hx => simpa using inv_mem hx

theorem kd147c_natCast_ne_zero {K : Type} [Field K] [Finite K] {p : ℕ} (hp : p.Prime)
    (hpK : ¬ p ∣ Nat.card K) : ((p : ℕ) : AlgebraicClosure K) ≠ 0 := by
  classical
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨n, hℓ, hn⟩ := FiniteField.card K (ringChar K)
  have : CharP K (ringChar K) := ringChar.charP K
  have : CharP (AlgebraicClosure K) (ringChar K) :=
    charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective _
  rw [Ne, CharP.cast_eq_zero_iff (AlgebraicClosure K) (ringChar K)]
  intro h
  have hpe : ringChar K = p := (Nat.prime_dvd_prime_iff_eq hℓ hp).1 h
  apply hpK
  rw [Nat.card_eq_fintype_card, hn, hpe]
  exact dvd_pow_self p n.pos.ne'

theorem kd147c_langSetup {K : Type} [Field K] [Finite K] (hpK : ¬ 3 ∣ Nat.card K)
    (hq4 : 4 ≤ Nat.card K) (x : ↥(adjointGroup Tag.G2 K)) (hx : orderOf x = 3) :
    ∃ (S : LangSetup Tag.G2 (AlgebraicClosure K) 3) (a : Fin Tag.G2.rank → (AlgebraicClosure K)ˣ)
      (ι : ↥(adjointGroup Tag.G2 K) →* ModGL Tag.G2 (AlgebraicClosure K)),
      S.D.q = Nat.card K ∧ rootDiagUnit Tag.G2 a ∈ S.D.torus ∧ (∀ i, a i ^ 3 = 1) ∧
        Function.Injective ι ∧ ι.range = S.Γ ∧
        ∀ c, ι (MulAut.conj x c) =
          rootDiagUnit Tag.G2 a * ι c * (rootDiagUnit Tag.G2 a)⁻¹ := by
  have hperf : commutator ↥(adjointGroup Tag.G2 K) = ⊤ :=
    (CFSG.LieType.Steinberg.Adjoint.isPerfect_g2_of_three_le_card K (by omega)).commutator_eq_top
  have hmon : MonomialToralAt Tag.G2 3 := monomialToralAt_three_of_block a2BlockToral_G2
  have hx3 : x ^ 3 = 1 := by rw [← hx]; exact pow_orderOf_eq_one x
  have hx1 : x ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hx
    omega
  have hhL : baseChangeGL (algebraMap K (AlgebraicClosure K)) (x : ModGL Tag.G2 K) ∈
      adjointGroup Tag.G2 (AlgebraicClosure K) := kd147c_baseChangeGL_mem _ x.2
  obtain ⟨S, a, ι, hSq, -, hT, hap, -, hinj, hrange, hconj⟩ :=
    exists_langSetup_of_inner_untw (Or.inl rfl) Nat.prime_three hpK (Or.inr hq4) hmon hperf
      (MulAut.conj x) (x : ModGL Tag.G2 K) hhL
      (fun c => by simp [MulAut.conj_apply])
      (by rw [← Subgroup.coe_pow, hx3]; rfl)
      (fun h => hx1 (Subtype.ext h))
  exact ⟨S, a, ι, hSq, hT, hap, hinj, hrange, hconj⟩

theorem kd147c_component {K : Type} [Field K] [Finite K] (hpK : ¬ 3 ∣ Nat.card K)
    (hq4 : 4 ≤ Nat.card K) (x : ↥(adjointGroup Tag.G2 K)) (hx : orderOf x = 3) :
    ∃ R : Subgroup ↥(adjointGroup Tag.G2 K),
      GLAPComponent 3 (Subgroup.centralizer ({x} : Set ↥(adjointGroup Tag.G2 K))) R ∧
        3 ∣ Nat.card R := by
  obtain ⟨S, a, ι, hSq, hT, hap, hinj, hrange, hconj⟩ := kd147c_langSetup hpK hq4 x hx
  obtain ⟨i, hq, h3⟩ := kd147c_exists_class S hT hap
    (kd147c_natCast_ne_zero Nat.prime_three hpK) (by rw [hSq]; exact hq4)
  exact ⟨_, kd147c_glaPComponent_of_rational S hT ι hinj hrange hconj i hq h3⟩

