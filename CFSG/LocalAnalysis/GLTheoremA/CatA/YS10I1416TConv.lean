@[expose] def pp7 : TauCeti.PrimePower := ⟨7, 1, by norm_num, Nat.one_pos⟩

theorem pp7_card : pp7.card = 7 := by simp [pp7, TauCeti.PrimePower.card_def]

theorem pp7_valid : (TauCeti.LieTypeIndex.A 1 pp7).Valid := by
  simp only [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
    TauCeti.LieTypeIndex.isDuplicateRepresentative_iff, pp7_card]
  norm_num

@[expose] def pp2 (n : ℕ) (hn : 0 < n) : TauCeti.PrimePower := ⟨2, n, Nat.prime_two, hn⟩

theorem pp2_p (n : ℕ) (hn : 0 < n) : (pp2 n hn).p = 2 := rfl

theorem pp2_card (n : ℕ) (hn : 0 < n) : (pp2 n hn).card = 2 ^ n := by
  simp [pp2, TauCeti.PrimePower.card_def]

theorem two_pow_cases (n : ℕ) (hn : 1 ≤ n) :
    (n = 1 ∧ 2 ^ n = 2) ∨ (n = 2 ∧ 2 ^ n = 4) ∨ 8 ≤ 2 ^ n := by
  rcases n with _ | _ | _ | n
  · omega
  · simp
  · simp
  · right; right
    rw [pow_add]
    have : 1 ≤ 2 ^ n := Nat.one_le_two_pow
    omega

theorem two_pow_dvd (n : ℕ) (hn : 1 ≤ n) : 2 ∣ 2 ^ n := dvd_pow_self 2 (by omega)

@[expose] def Chev2MinusInput : Prop :=
  ∀ (R : Type) [Group R] (r n : ℕ), 4 ≤ r → 1 ≤ n →
    CFSG.Blueprint.LieModel R .POmegaMinus r 2 n → IsChevSimple 2 R

