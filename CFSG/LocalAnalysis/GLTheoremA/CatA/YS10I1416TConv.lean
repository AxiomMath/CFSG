theorem conv_untw {R : Type} [Group R] {τ : Chevalley.Tag} {c : TauCeti.PrimePower → TauCeti.LieTypeIndex}
    (hB : CFSG.TauCetiBridge.Even.UntwistedBridgeAll τ c) (q : TauCeti.PrimePower) {Q : ℕ}
    (hq : q.card = Q) (hv : (c q).Valid) (hch : (c q).characteristic = 2)
    (h : UntwistedChevalleyModel R τ Q) : IsChevSimple 2 R := by
  obtain ⟨K, _, _, hK, ⟨φ⟩⟩ := h
  obtain ⟨ψ⟩ := hB q hv K (hK.trans hq.symm)
  exact conv_index (c q) hv hch ⟨φ.trans ψ⟩

theorem conv_tw {R : Type} [Group R] {t : Chevalley.TwistTag} {c : TauCeti.PrimePower → TauCeti.LieTypeIndex}
    (hB : CFSG.TauCetiBridge.Even.TwistedBridgeAll t c) (q : TauCeti.PrimePower) {Q : ℕ}
    (hq : q.card = Q) (hv : (c q).Valid) (hch : (c q).characteristic = 2)
    (h : TwistedChevalleyModel R t Q) : IsChevSimple 2 R := by
  obtain ⟨K, _, _, hK, σ, hσ, ⟨φ⟩⟩ := h
  obtain ⟨ψ⟩ := hB q hv K (by rw [hK, hq]) σ (fun x => by rw [hσ x, hq])
  exact conv_index (c q) hv hch ⟨φ.trans ψ⟩

theorem conv_sz {R : Type} [Group R] {f : ℕ} (h : SuzukiModel R 2 f) : IsChevSimple 2 R := by
  obtain ⟨-, a, ha, K, _, _, hf, hK, ⟨φ⟩⟩ := h
  have hv : (TauCeti.LieTypeIndex.suzuki a).Valid := by
    simp only [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
      TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
    exact ⟨ha, by simp⟩
  have hK' : Nat.card K = 2 ^ (2 * a + 1) := by rw [← hf]; exact hK
  exact conv_index (TauCeti.LieTypeIndex.suzuki a) hv (by simp)
    ⟨φ.trans ((CFSG.ShultStronglyClosedTI.SuzukiModel.suzukiGroupEquivSuzukiMatrixGroup hK').trans
      (CFSG.BenderSuzuki.Catalog.groupEquivSuzukiMatrixGroup hv).symm)⟩

theorem conv_reeF4 {R : Type} [Group R] {a : ℕ} (hv : (TauCeti.LieTypeIndex.reeF4 a).Valid)
    (K : Type) [Field K] [Finite K] (hK : Nat.card K = 2 ^ (2 * a + 1))
    (φ : R ≃* CFSG.Blueprint.DerivedCentralQuotient (reeFixedGroup .F4 K reeF4Perm
      fun i => if i ∈ reeF4Long then 2 ^ a else 2 ^ (a + 1))) : IsChevSimple 2 R := by
  haveI : CharP K 2 := CFSG.TauCetiBridge.charP_two_of_card_eq_two_pow hK
  have hhalf : (ReeF4LieIndex.of a hv).toSuzukiReeIndex.halfExponent = a :=
    SuzukiReeIndex.halfExponent_reeF4 a hv
  have hcard : Nat.card K = 2 ^ (2 * (ReeF4LieIndex.of a hv).toSuzukiReeIndex.halfExponent + 1) := by
    rw [hhalf, hK]
  obtain ⟨e₁⟩ := CFSG.TauCetiBridge.reeF4_candidate_equiv_of_card (ReeF4LieIndex.of a hv) hcard
  rw [hhalf] at e₁
  exact conv_index (TauCeti.LieTypeIndex.reeF4 a) hv (by simp)
    ⟨φ.trans ((CFSG.TauCetiBridge.ReeF4.nativeModelEquiv (K := K) a).trans e₁.symm)⟩

theorem conv_tits {R : Type} [Group R] (K : Type) [Field K] [Finite K] (hK : Nat.card K = 2)
    (φ : R ≃* CFSG.Blueprint.DerivedCentralQuotient (reeFixedGroup .F4 K reeF4Perm
      fun i => if i ∈ reeF4Long then 2 ^ 0 else 2 ^ (0 + 1))) : IsChevSimple 2 R := by
  haveI : CharP K 2 := CFSG.TauCetiBridge.charP_two_of_card_eq_two_pow (f := 1) (by rw [hK]; norm_num)
  obtain ⟨e₁⟩ := CFSG.TauCetiBridge.tits_candidate_equiv_of_card TitsLieIndex.of hK
  have hv : (TauCeti.LieTypeIndex.tits).Valid := by
    simp [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
      TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
  exact conv_index TauCeti.LieTypeIndex.tits hv (by simp)
    ⟨φ.trans ((CFSG.TauCetiBridge.ReeF4.nativeModelEquiv (K := K) 0).trans e₁.symm)⟩

theorem conv_B2der {R : Type} [Group R] (h : CFSG.Blueprint.LieModel R .PSL 2 3 2) :
    IsChevSimple 2 R := by
  have h6 : (5 : ℕ) ≤ 6 := by norm_num
  obtain ⟨e6⟩ := CFSG.StandardType.nonempty_alternatingGroup_of_psl_two_nine
    (h.statedClassicalModel (by simp [classicalTags]))
  exact conv_amb (TauCeti.CFSGIndex.alternating 6 h6) (Or.inr (Or.inl ⟨rfl, Or.inl rfl⟩))
    ⟨e6.trans (MulEquiv.subgroupCongr rfl)⟩

theorem conv_G2der {R : Type} [Group R] (h : CFSG.Blueprint.LieModel R .PSU 3 3 1) :
    IsChevSimple 2 R := by
  obtain ⟨eS⟩ := CFSG.GH74.KGroups.U33.equiv_of_lieModel h
  have hT := CFSG.StandardType.ChevTwo.statedClassicalModel_psu_three_three_of_twistedA_two
    small_pp3 small_valid_tw23 small_pp3_card (MulEquiv.refl _)
  obtain ⟨eT⟩ := CFSG.GH74.KGroups.U33.equiv_of_lieModel (Or.inl ⟨by simp [classicalTags], hT⟩)
  exact conv_amb (TauCeti.CFSGIndex.lie ⟨.twistedA 2 small_pp3, small_valid_tw23⟩)
    ⟨small_pp3_card, rfl⟩ ⟨eS.trans eT.symm⟩

theorem chev2MarkedConverse_of (hM : Chev2MinusInput) : Chev2MarkedConverse := by
  rintro R _ ⟨⟨tag, rank, n⟩, hlab, hMR⟩
  obtain ⟨hn, hcond⟩ := hlab
  dsimp only at hn hcond hMR
  have hn0 : 0 < n := hn
  cases tag with
  | A =>
    exact conv_A hcond.1 hn hcond.2 hMR
  | twA =>
    exact conv_twA hcond.1 hcond.2 hn hMR
  | B =>
    exact conv_B hcond.1 hcond.2 hn hMR
  | C =>
    exact conv_B hcond.1 hcond.2 hn hMR
  | D =>
    by_cases h3 : rank = 3
    · have hL : CFSG.Blueprint.LieModel R .PSL (3 + 1) 2 n := by
        subst h3
        exact hMR
      exact conv_A (r := 3) (by norm_num) hn (fun h => by omega) hL
    · have hL : CFSG.Blueprint.LieModel R .POmegaPlus rank 2 n := by
        have hMR' := hMR
        simp only [CFSG.StandardType.MarkedModel, CFSG.StandardType.markTag,
          CFSG.StandardType.markRank, CFSG.StandardType.markChar, CFSG.StandardType.markDeg,
          h3, if_false] at hMR'
        exact hMR'
      exact conv_Dp (by omega) hn hL
  | twD =>
    by_cases h2 : rank = 2
    · have hL : CFSG.Blueprint.LieModel R .PSL (1 + 1) 2 (2 * n) := by
        subst h2
        exact hMR
      exact conv_A (r := 1) (n := 2 * n) le_rfl (by omega) (fun _ => by omega) hL
    · by_cases h3 : rank = 3
      · have hL : CFSG.Blueprint.LieModel R .PSU (3 + 1) 2 n := by
          subst h3
          exact hMR
        exact conv_twA (r := 3) (by norm_num) (fun h => by omega) hn hL
      · have hL : CFSG.Blueprint.LieModel R .POmegaMinus rank 2 n := by
          have hMR' := hMR
          simp only [CFSG.StandardType.MarkedModel, CFSG.StandardType.markTag,
            CFSG.StandardType.markRank, CFSG.StandardType.markChar, CFSG.StandardType.markDeg,
            h2, h3, if_false] at hMR'
          exact hMR'
        exact hM R rank n (by omega) hn hL
  | E6 =>
    have hL : CFSG.Blueprint.LieModel R .E6 0 2 n := hMR
    have hC := hL.chevalleyExceptionalModel (by simp [chevalleyExceptionalTags])
    exact conv_untw CFSG.TauCetiBridge.Even.chevalleyBridgesAll.e6 (pp2 n hn0)
      (pp2_card n hn0)
      (by simp [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
        TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]) (by simp [pp2_p])
      (show StatedLieAdmissible .E6 0 2 n ∧ UntwistedChevalleyModel R .E6 (2 ^ n) from hC).2
  | E7 =>
    have hL : CFSG.Blueprint.LieModel R .E7 0 2 n := hMR
    have hC := hL.chevalleyExceptionalModel (by simp [chevalleyExceptionalTags])
    exact conv_untw CFSG.TauCetiBridge.Even.chevalleyBridgesAll.e7 (pp2 n hn0)
      (pp2_card n hn0)
      (by simp [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
        TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]) (by simp [pp2_p])
      (show StatedLieAdmissible .E7 0 2 n ∧ UntwistedChevalleyModel R .E7 (2 ^ n) from hC).2
  | E8 =>
    have hL : CFSG.Blueprint.LieModel R .E8 0 2 n := hMR
    have hC := hL.chevalleyExceptionalModel (by simp [chevalleyExceptionalTags])
    exact conv_untw CFSG.TauCetiBridge.Even.chevalleyBridgesAll.e8 (pp2 n hn0)
      (pp2_card n hn0)
      (by simp [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
        TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]) (by simp [pp2_p])
      (show StatedLieAdmissible .E8 0 2 n ∧ UntwistedChevalleyModel R .E8 (2 ^ n) from hC).2
  | F4 =>
    have hL : CFSG.Blueprint.LieModel R .F4 0 2 n := hMR
    have hC := hL.chevalleyExceptionalModel (by simp [chevalleyExceptionalTags])
    exact conv_untw CFSG.TauCetiBridge.Even.chevalleyBridgesAll.f4 (pp2 n hn0)
      (pp2_card n hn0)
      (by simp [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
        TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]) (by simp [pp2_p])
      (show StatedLieAdmissible .F4 0 2 n ∧ UntwistedChevalleyModel R .F4 (2 ^ n) from hC).2
  | twE6 =>
    have hL : CFSG.Blueprint.LieModel R .twistedE6 0 2 n := hMR
    have hC := hL.chevalleyExceptionalModel (by simp [chevalleyExceptionalTags])
    exact conv_tw CFSG.TauCetiBridge.Even.chevalleyBridgesAll.twistedE6 (pp2 n hn0)
      (pp2_card n hn0)
      (by simp [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
        TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]) (by simp [pp2_p])
      (show StatedLieAdmissible .twistedE6 0 2 n ∧ TwistedChevalleyModel R .E6 (2 ^ n) from hC).2
  | triD4 =>
    have hL : CFSG.Blueprint.LieModel R .trialityD4 0 2 n := hMR
    have hC := hL.chevalleyExceptionalModel (by simp [chevalleyExceptionalTags])
    exact conv_tw CFSG.TauCetiBridge.Even.chevalleyBridgesAll.trialityD4 (pp2 n hn0)
      (pp2_card n hn0)
      (by simp [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
        TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]) (by simp [pp2_p])
      (show StatedLieAdmissible .trialityD4 0 2 n ∧ TwistedChevalleyModel R .D4 (2 ^ n) from hC).2
  | G2 =>
    have hL : CFSG.Blueprint.LieModel R .G2 0 2 n := hMR
    have hC := hL.chevalleyExceptionalModel (by simp [chevalleyExceptionalTags])
    have h4 : 4 ≤ 2 ^ n := by
      have := Nat.pow_le_pow_right (by norm_num : 0 < 2) hcond.2
      simpa using this
    have hvG : (TauCeti.LieTypeIndex.G2 (pp2 n hn0)).Valid := by
      simp only [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
        TauCeti.LieTypeIndex.isDuplicateRepresentative_iff, pp2_card]
      refine ⟨?_, by simp⟩
      generalize (2 : ℕ) ^ n = x at h4 ⊢
      omega
    exact conv_untw CFSG.TauCetiBridge.Even.chevalleyBridgesAll.g2 (pp2 n hn0)
      (pp2_card n hn0) hvG (by simp [pp2_p])
      (show StatedLieAdmissible .G2 0 2 n ∧ UntwistedChevalleyModel R .G2 (2 ^ n) from hC).2
  | twB2 =>
    have hL : CFSG.Blueprint.LieModel R .twistedB2 0 2 n := hMR
    rcases hL with ⟨ht, -⟩ | ⟨-, ht, -⟩ | ⟨-, ht, -⟩ | ⟨-, -, h⟩
    · exact absurd ht (by simp [classicalTags])
    · exact absurd ht (by simp [chevalleyExceptionalTags])
    · exact absurd ht (by simp [reeTitsTags])
    · exact conv_sz h
  | twF4 =>
    have hL : CFSG.Blueprint.LieModel R .twistedF4 0 2 n := hMR
    have h3n : 3 ≤ n := hcond.2.2
    obtain ⟨-, hRT⟩ := hL.reeTitsModel (by simp [reeTitsTags])
    obtain ⟨-, a, hf, K, _, _, hK, ⟨φ⟩⟩ := hRT
    have hv : (TauCeti.LieTypeIndex.reeF4 a).Valid := by
      simp only [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
        TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
      exact ⟨by omega, by simp⟩
    exact conv_reeF4 hv K (by rw [← hf]; exact hK) φ
  | twF4der =>
    obtain ⟨hr0, hn1⟩ := hcond
    subst hr0
    subst hn1
    have hL : CFSG.Blueprint.LieModel R .Tits 0 2 1 := hMR
    obtain ⟨-, hRT⟩ := hL.reeTitsModel (by simp [reeTitsTags])
    obtain ⟨-, a, hf, K, _, _, hK, ⟨φ⟩⟩ := hRT
    obtain rfl : a = 0 := by omega
    exact conv_tits K (by simpa using hK) φ
  | B2der =>
    have hL : CFSG.Blueprint.LieModel R .PSL 2 3 2 := hMR
    exact conv_B2der hL
  | G2der =>
    have hL : CFSG.Blueprint.LieModel R .PSU 3 3 1 := hMR
    exact conv_G2der hL

theorem chev2Minus_holds : Chev2MinusInput := by
  intro R _ r n hr hn hM
  have hn0 : 0 < n := hn
  have hv : (TauCeti.LieTypeIndex.twistedD r (pp2 n hn0)).Valid := by
    simp only [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
      TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
    exact ⟨hr, by simp⟩
  have hY : CFSG.Blueprint.LieModel (ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.twistedD r (pp2 n hn0), hv⟩)
      .POmegaMinus r 2 n :=
    blueprintLieModel_of_modelsLieModel (t := .POmegaMinus) (by simp [classicalTags])
      (CFSG.Models.lieModel_twistedD r (pp2 n hn0) hv (MulEquiv.refl _))
  exact conv_index _ hv (by simp [pp2_p]) (conv_unique_minus (by omega) hM hY)

theorem chev2MarkedConverse_holds : Chev2MarkedConverse := chev2MarkedConverse_of chev2Minus_holds

