theorem conv_index {R : Type} [Group R] (i : TauCeti.LieTypeIndex) (hv : i.Valid)
    (hc : i.characteristic = 2) (e : Nonempty (R ≃* ValidLieTypeIndex.Group ⟨i, hv⟩)) :
    IsChevSimple 2 R :=
  Or.inl ⟨TauCeti.CFSGIndex.lie ⟨i, hv⟩, by simpa [onLie] using hc, e⟩

theorem conv_amb {R : Type} [Group R] (i : TauCeti.CFSGIndex) (hi : ambiguousChev 2 i)
    (e : Nonempty (R ≃* i.Group)) : IsChevSimple 2 R :=
  Or.inr ⟨i, hi, e⟩

theorem conv_unique {R Y : Type} [Group R] [Group Y] {t : CFSG.Open.StatedLieTag} {n f : ℕ}
    (ht : t = .PSL ∨ t = .PSU ∨ t = .PSp ∨ t = .POmegaPlus)
    (hX : CFSG.Blueprint.LieModel R t n 2 f) (hY : CFSG.Blueprint.LieModel Y t n 2 f) :
    Nonempty (R ≃* Y) := by
  have hc : t ∈ classicalTags := by
    rcases ht with rfl | rfl | rfl | rfl <;> simp [classicalTags]
  exact CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.Seitz2313Cover.statedClassicalModel_unique_even
    ht (hX.statedClassicalModel hc) (hY.statedClassicalModel hc)

theorem conv_unique_minus {R Y : Type} [Group R] [Group Y] {r f : ℕ} (hr : 1 ≤ r)
    (hX : CFSG.Blueprint.LieModel R .POmegaMinus r 2 f)
    (hY : CFSG.Blueprint.LieModel Y .POmegaMinus r 2 f) : Nonempty (R ≃* Y) := by
  obtain ⟨-, K₁, _, _, hc₁, b₁, c₁, hirr₁, ⟨e₁⟩⟩ :=
    hX.statedClassicalModel (by simp [classicalTags])
  obtain ⟨-, K₂, _, _, hc₂, b₂, c₂, hirr₂, ⟨e₂⟩⟩ :=
    hY.statedClassicalModel (by simp [classicalTags])
  let φ := CFSG.ClassicalInvolution.Upgrade.fieldIsoOfCard (hc₁.trans hc₂.symm)
  obtain ⟨e₃⟩ := CFSG.Blueprint.EvenSource.nonempty_statedOmegaMinus_equiv (K := K₂) hr
    (CFSG.ClassicalInvolution.Upgrade.irreducible_map φ hirr₁) hirr₂
  exact ⟨e₁.trans (((CFSG.Adapters.RankTwoModelTransports.statedProjCongr
    (CFSG.Adapters.RankTwoModelTransports.glCongr φ)
    (CFSG.ClassicalInvolution.Upgrade.map_statedOmega φ
      (CFSG.ClassicalInvolution.Upgrade.statedQuadMinus_comp φ rfl rfl))
    (CFSG.Adapters.RankTwoModelTransports.glCongr_statedScalars φ)).trans e₃).trans e₂.symm)⟩

theorem conv_A {R : Type} [Group R] {r n : ℕ} (hr : 1 ≤ r) (hn : 1 ≤ n) (hr1 : r = 1 → 2 ≤ n)
    (h : CFSG.Blueprint.LieModel R .PSL (r + 1) 2 n) : IsChevSimple 2 R := by
  by_cases hA5 : r = 1 ∧ n = 2
  · obtain ⟨rfl, rfl⟩ := hA5
    obtain ⟨eA⟩ := CFSG.GH74.KGroups.A5.equiv_of_lieModel22 h
    exact conv_amb (TauCeti.CFSGIndex.alternating 5 le_rfl) (Or.inl ⟨rfl, Or.inl rfl⟩)
      ⟨eA.trans (MulEquiv.subgroupCongr CFSG.GH74.KGroups.A5.QP_eq_alt)⟩
  by_cases hL7 : r = 2 ∧ n = 1
  · obtain ⟨rfl, rfl⟩ := hL7
    obtain ⟨eT⟩ := CFSG.GH74.KGroups.L27.equiv_of_lieModel3 h
    have hA : CFSG.Blueprint.LieModel (ValidLieTypeIndex.Group ⟨.A 1 pp7, pp7_valid⟩) .PSL 2 7 1 :=
      blueprintLieModel_of_modelsLieModel (t := .PSL) (by simp [classicalTags])
        (CFSG.Models.lieModel_A 1 pp7 pp7_valid (MulEquiv.refl _))
    obtain ⟨eI⟩ := CFSG.GH74.KGroups.L27.equiv_of_lieModel hA
    exact conv_amb (TauCeti.CFSGIndex.lie ⟨.A 1 pp7, pp7_valid⟩)
      (Or.inl ⟨pp7_card, rfl⟩) ⟨eT.trans eI.symm⟩
  by_cases hA8 : r = 3 ∧ n = 1
  · obtain ⟨rfl, rfl⟩ := hA8
    obtain ⟨e8⟩ := CFSG.GH74.Exceptional.nonempty_mulEquiv_alternating_eight_of_lieModel h
    have h8 : (5 : ℕ) ≤ 8 := by norm_num
    exact conv_amb (TauCeti.CFSGIndex.alternating 8 h8) (Or.inr (Or.inr ⟨rfl, rfl⟩))
      ⟨e8.trans (MulEquiv.subgroupCongr rfl)⟩
  have hn0 : 0 < n := hn
  have hr1' : r ≠ 1 ∨ 2 ≤ n := imp_iff_not_or.1 hr1
  have hv : (TauCeti.LieTypeIndex.A r (pp2 n hn0)).Valid := by
    have h2 := two_pow_cases n hn
    have h2' := two_pow_dvd n hn
    simp only [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
      TauCeti.LieTypeIndex.isDuplicateRepresentative_iff, pp2_card]
    refine ⟨⟨hr, fun h1 => ?_⟩, ?_⟩
    · have h4 := hr1 h1
      generalize (2 : ℕ) ^ n = x at h2 h2' ⊢
      omega
    · generalize (2 : ℕ) ^ n = x at h2 h2' ⊢
      omega
  have hY : CFSG.Blueprint.LieModel (ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.A r (pp2 n hn0), hv⟩)
      .PSL (r + 1) 2 n :=
    blueprintLieModel_of_modelsLieModel (t := .PSL) (by simp [classicalTags])
      (CFSG.Models.lieModel_A r (pp2 n hn0) hv (MulEquiv.refl _))
  exact conv_index _ hv (by simp [pp2_p]) (conv_unique (by simp) h hY)

theorem conv_twA {R : Type} [Group R] {r n : ℕ} (hr : 2 ≤ r) (hrn : r = 2 → 2 ≤ n) (hn : 1 ≤ n)
    (h : CFSG.Blueprint.LieModel R .PSU (r + 1) 2 n) : IsChevSimple 2 R := by
  have hn0 : 0 < n := hn
  have hrn' : r ≠ 2 ∨ 2 ≤ n := imp_iff_not_or.1 hrn
  have hv : (TauCeti.LieTypeIndex.twistedA r (pp2 n hn0)).Valid := by
    have h2 := two_pow_cases n hn
    simp only [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
      TauCeti.LieTypeIndex.isDuplicateRepresentative_iff, pp2_card]
    refine ⟨⟨hr, fun h1 => ?_⟩, by simp⟩
    have h4 := hrn h1
    generalize (2 : ℕ) ^ n = x at h2 ⊢
    omega
  have hc : ValidLieTypeIndex.characteristic ⟨.twistedA r (pp2 n hn0), hv⟩ = 2 :=
    (TauCeti.LieTypeIndex.characteristic_twistedA r _).trans (pp2_p n hn0)
  have hf : ValidLieTypeIndex.fieldExponent ⟨.twistedA r (pp2 n hn0), hv⟩ = n :=
    TauCeti.LieTypeIndex.fieldExponent_twistedA r _
  have hm := CFSG.Models.lieModel_twistedA r (pp2 n hn0) hv (MulEquiv.refl _)
  rw [hc, hf] at hm
  have hY : CFSG.Blueprint.LieModel (ValidLieTypeIndex.Group ⟨.twistedA r (pp2 n hn0), hv⟩)
      .PSU (r + 1) 2 n :=
    blueprintLieModel_of_modelsLieModel (t := .PSU) (by simp [classicalTags]) hm
  exact conv_index _ hv (by simp [pp2_p]) (conv_unique (by simp) h hY)

theorem conv_B {R : Type} [Group R] {r n : ℕ} (hr : 2 ≤ r) (hrn : r = 2 → 2 ≤ n) (hn : 1 ≤ n)
    (h : CFSG.Blueprint.LieModel R .PSp r 2 n) : IsChevSimple 2 R := by
  have hn0 : 0 < n := hn
  have hrn' : r ≠ 2 ∨ 2 ≤ n := imp_iff_not_or.1 hrn
  have hv : (TauCeti.LieTypeIndex.B r (pp2 n hn0)).Valid := by
    simp only [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
      TauCeti.LieTypeIndex.isDuplicateRepresentative_iff, pp2_card]
    have h2 := two_pow_cases n hn
    have h3 := two_pow_dvd n hn
    omega
  have hY : CFSG.Blueprint.LieModel (ValidLieTypeIndex.Group ⟨TauCeti.LieTypeIndex.B r (pp2 n hn0), hv⟩)
      .PSp r 2 n := by
    rcases CFSG.Models.lieModel_B r (pp2 n hn0) hv (MulEquiv.refl _) with h' | h'
    · exact blueprintLieModel_of_modelsLieModel (t := .PSp) (by simp [classicalTags]) h'
    · exact absurd h'.1.2.2.2 (fun h2 => h2 rfl)
  exact conv_index _ hv (by simp [pp2_p]) (conv_unique (by simp) h hY)

