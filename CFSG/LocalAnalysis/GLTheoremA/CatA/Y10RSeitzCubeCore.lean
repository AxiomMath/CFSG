theorem map_fixedPoints_mulAut_congr {K K' : Type} [Group K] [Group K'] (e : K ≃* K')
    (F : Subgroup (MulAut K)) :
    (fixedPoints F).map e.toMonoidHom =
      fixedPoints (F.map (MulAut.congr e).toMonoidHom) := by
  ext x'
  constructor
  · rintro ⟨x, hx, rfl⟩ φ' hφ'
    obtain ⟨φ, hφ, rfl⟩ := Subgroup.mem_map.1 hφ'
    show (MulAut.congr e φ) (e x) = e x
    rw [show (MulAut.congr e φ) (e x) = e (φ x) by simp [MulAut.congr_apply], hx φ hφ]
  · intro hx'
    refine ⟨e.symm x', fun φ hφ => ?_, by simp⟩
    have h := hx' (MulAut.congr e φ) (Subgroup.mem_map_of_mem _ hφ)
    have h' : (MulAut.congr e φ) x' = e (φ (e.symm x')) := by
      conv_lhs => rw [← e.apply_symm_apply x']
      simp [MulAut.congr_apply]
    rw [h'] at h
    exact e.injective (h.trans (e.apply_symm_apply x').symm)

theorem oPrimeResidualOf_top (p : ℕ) (S : Type) [Group S] :
    oPrimeResidualOf p (⊤ : Subgroup S) = oPrimeResidual p S := by
  unfold oPrimeResidualOf oPrimeResidual
  rw [MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨y, ⟨k, hk⟩, rfl⟩
    exact ⟨k, by simpa using congrArg Subtype.val hk⟩
  · rintro ⟨k, hk⟩
    exact ⟨⟨x, trivial⟩, ⟨k, Subtype.ext (by simpa using hk)⟩, rfl⟩

theorem normalClosure_singleton_eq_top_of_orderOf_two {S : Type} [Group S] [IsSimpleGroup S]
    {x : S} (hx : orderOf x = 2) : Subgroup.normalClosure ({x} : Set S) = ⊤ := by
  have hx1 : x ≠ 1 := by
    rintro rfl
    simp at hx
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal
      (Subgroup.normalClosure ({x} : Set S)) with h | h
  · exfalso
    apply hx1
    have hmem : x ∈ Subgroup.normalClosure ({x} : Set S) := Subgroup.subset_normalClosure (by simp)
    rw [h, Subgroup.mem_bot] at hmem
    exact hmem
  · exact h

theorem oPrimeResidual_two_eq_top_of_isSimpleGroup {S : Type} [Group S] [Finite S]
    (hs : IsSimpleGroup S) (h2 : 2 ∣ Nat.card S) : oPrimeResidual 2 S = ⊤ := by
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' 2 h2
  have htop : Subgroup.normalClosure ({x} : Set S) = ⊤ :=
    normalClosure_singleton_eq_top_of_orderOf_two hx
  have hle : Subgroup.normalClosure ({x} : Set S) ≤ oPrimeResidual 2 S := by
    rw [Subgroup.normalClosure, Subgroup.closure_le]
    rintro y hy
    rw [Group.mem_conjugatesOfSet_iff] at hy
    obtain ⟨a, ha, hconj⟩ := hy
    rw [Set.mem_singleton_iff] at ha
    subst ha
    have hord : orderOf y = 2 := (IsConj.orderOf_eq hconj).symm.trans hx
    exact Subgroup.subset_closure ⟨1, by rw [pow_one, ← hord, pow_orderOf_eq_one]⟩
  rw [htop] at hle
  exact top_le_iff.mp hle

@[expose] def SeitzTwoGen (S : Type) [Group S] [Finite S] : Prop :=
  ∀ q : ℕ, q.Prime → q ≠ 2 → ∀ E : Subgroup (MulAut S), IsPGroup q E →
    (∃ U : Subgroup S, U ≠ ⊥ ∧ IsPGroup 2 ↥U ∧ ∀ φ ∈ E, ∀ u ∈ U, φ u ∈ U) →
    ∃ Q₁ Q₂ : Subgroup S, IsPGroup 2 ↥Q₁ ∧ IsPGroup 2 ↥Q₂ ∧
      (∀ φ ∈ E, ∀ u ∈ Q₁, φ u ∈ Q₁) ∧ (∀ φ ∈ E, ∀ u ∈ Q₂, φ u ∈ Q₂) ∧ Q₁ ⊔ Q₂ = ⊤

theorem seitzSimpleStmt_of_twoGen {S : Type} [Group S] [Finite S] (h : SeitzTwoGen S) :
    SeitzSimpleStmt S := by
  intro q hq hq2 E hE hE0 _ ⟨U, hU0, hU2, hUinv⟩
  obtain ⟨Q₁, Q₂, hQ₁, hQ₂, hi₁, hi₂, hgen⟩ :=
    h q hq hq2 E hE.isPGroup ⟨U, hU0, hU2, hUinv⟩
  rw [eq_top_iff, ← hgen]
  exact sup_le
    (Seitz2313Aux.hyperplane_generation_of_invariant hq Nat.prime_two hq2 hE hE0 hQ₁ hi₁)
    (Seitz2313Aux.hyperplane_generation_of_invariant hq Nat.prime_two hq2 hE hE0 hQ₂ hi₂)

theorem seitzTwoGen_of_mulEquiv {S S' : Type} [Group S] [Finite S] [Group S'] [Finite S']
    (e : S ≃* S') (h : SeitzTwoGen S) : SeitzTwoGen S' := by
  intro q hq hq2 E hE ⟨U, hU0, hU2, hUinv⟩
  set E₀ : Subgroup (MulAut S) := E.map (MulAut.congr e.symm).toMonoidHom with hE₀
  set U₀ : Subgroup S := U.map e.symm.toMonoidHom with hU₀
  have hE₀p : IsPGroup q E₀ := by
    rw [hE₀]
    exact hE.map _
  have hU₀0 : U₀ ≠ ⊥ := fun hbot =>
    hU0 ((Subgroup.map_eq_bot_iff_of_injective U e.symm.injective).1 (hU₀ ▸ hbot))
  have hU₀2 : IsPGroup 2 U₀ := by
    rw [hU₀]
    exact hU2.map _
  have hU₀inv : ∀ φ ∈ E₀, ∀ u ∈ U₀, φ u ∈ U₀ := by
    intro φ hφ u hu
    rw [hE₀] at hφ
    rw [hU₀] at hu ⊢
    obtain ⟨φ₀, hφ₀, rfl⟩ := Subgroup.mem_map.1 hφ
    obtain ⟨u₀, hu₀, rfl⟩ := Subgroup.mem_map.1 hu
    have hφu : ((MulAut.congr e.symm).toMonoidHom φ₀) (e.symm.toMonoidHom u₀) =
        e.symm.toMonoidHom (φ₀ u₀) := by
      simp [MulAut.congr_apply]
    rw [hφu]
    exact Subgroup.mem_map_of_mem _ (hUinv φ₀ hφ₀ u₀ hu₀)
  obtain ⟨Q₁, Q₂, hQ₁, hQ₂, hi₁, hi₂, hgen⟩ :=
    h q hq hq2 E₀ hE₀p ⟨U₀, hU₀0, hU₀2, hU₀inv⟩
  have hφeq : ∀ φ : MulAut S',
      (MulAut.congr e).toMonoidHom ((MulAut.congr e.symm).toMonoidHom φ) = φ := by
    intro φ
    ext x
    simp [MulAut.congr_apply]
  refine ⟨Q₁.map e.toMonoidHom, Q₂.map e.toMonoidHom, hQ₁.map _, hQ₂.map _, ?_, ?_, ?_⟩
  · intro φ hφ u hu
    obtain ⟨u₀, hu₀, rfl⟩ := Subgroup.mem_map.1 hu
    have hφ₀ : (MulAut.congr e.symm) φ ∈ E₀ := Subgroup.mem_map_of_mem _ hφ
    have hφu : φ (e.toMonoidHom u₀) =
        e.toMonoidHom (((MulAut.congr e.symm).toMonoidHom φ) u₀) := by
      conv_lhs => rw [← hφeq φ]
      simp [MulAut.congr_apply]
    rw [hφu]
    exact Subgroup.mem_map_of_mem _ (hi₁ _ hφ₀ u₀ hu₀)
  · intro φ hφ u hu
    obtain ⟨u₀, hu₀, rfl⟩ := Subgroup.mem_map.1 hu
    have hφ₀ : (MulAut.congr e.symm) φ ∈ E₀ := Subgroup.mem_map_of_mem _ hφ
    have hφu : φ (e.toMonoidHom u₀) =
        e.toMonoidHom (((MulAut.congr e.symm).toMonoidHom φ) u₀) := by
      conv_lhs => rw [← hφeq φ]
      simp [MulAut.congr_apply]
    rw [hφu]
    exact Subgroup.mem_map_of_mem _ (hi₂ _ hφ₀ u₀ hu₀)
  · rw [← Subgroup.map_sup, hgen, Subgroup.map_top]
    exact MonoidHom.range_eq_top.2 e.surjective

theorem seitzSimpleStmt_of_mulEquiv {S S' : Type} [Group S] [Finite S] [Group S'] [Finite S']
    (e : S ≃* S') (h : SeitzSimpleStmt S) : SeitzSimpleStmt S' := by
  intro q hq hq2 E hE hE0 hcard ⟨U, hU0, hU2, hUinv⟩
  set E₀ : Subgroup (MulAut S) := E.map (MulAut.congr e.symm).toMonoidHom with hE₀
  set U₀ : Subgroup S := U.map e.symm.toMonoidHom with hU₀
  have hE₀el : IsElemAbelian q E₀ := by
    rw [hE₀]
    exact isElemAbelian_map_hom _ hE
  have hE₀0 : E₀ ≠ ⊥ := fun hbot =>
    hE0 ((Subgroup.map_eq_bot_iff_of_injective E (MulAut.congr e.symm).injective).1
      (hE₀ ▸ hbot))
  have hE₀card : Nat.card E₀ ≤ q ^ 3 := by
    rw [hE₀]
    exact (card_map_le_of_finite (MulAut.congr e.symm).toMonoidHom E).trans hcard
  have hU₀0 : U₀ ≠ ⊥ := fun hbot =>
    hU0 ((Subgroup.map_eq_bot_iff_of_injective U e.symm.injective).1 (hU₀ ▸ hbot))
  have hU₀2 : IsPGroup 2 U₀ := by
    rw [hU₀]
    exact hU2.map _
  have hU₀inv : ∀ φ ∈ E₀, ∀ u ∈ U₀, φ u ∈ U₀ := by
    intro φ hφ u hu
    rw [hE₀] at hφ
    rw [hU₀] at hu ⊢
    obtain ⟨φ₀, hφ₀, rfl⟩ := Subgroup.mem_map.1 hφ
    obtain ⟨u₀, hu₀, rfl⟩ := Subgroup.mem_map.1 hu
    have hφu : ((MulAut.congr e.symm).toMonoidHom φ₀) (e.symm.toMonoidHom u₀) =
        e.symm.toMonoidHom (φ₀ u₀) := by
      simp [MulAut.congr_apply]
    rw [hφu]
    exact Subgroup.mem_map_of_mem _ (hUinv φ₀ hφ₀ u₀ hu₀)
  have hmain := h q hq hq2 E₀ hE₀el hE₀0 hE₀card ⟨U₀, hU₀0, hU₀2, hU₀inv⟩
  have hE₀map : E₀.map (MulAut.congr e).toMonoidHom = E := by
    rw [hE₀, Subgroup.map_map]
    have hcomp : ((MulAut.congr e).toMonoidHom.comp (MulAut.congr e.symm).toMonoidHom) =
        MonoidHom.id (MulAut S') := by
      ext φ
      simp [MulAut.congr_apply]
    rw [hcomp, Subgroup.map_id]
  have hmap_top : (⨆ (F : Subgroup (MulAut S)) (_ : F ≤ E₀ ∧ F.relIndex E₀ = q),
      oPrimeResidualOf 2 (fixedPoints F)).map e.toMonoidHom = ⊤ := by
    rw [hmain, Subgroup.map_top]
    exact MonoidHom.range_eq_top.2 e.surjective
  have hsplit : (⨆ (F : Subgroup (MulAut S)) (_ : F ≤ E₀ ∧ F.relIndex E₀ = q),
      oPrimeResidualOf 2 (fixedPoints F)).map e.toMonoidHom =
      ⨆ (F : Subgroup (MulAut S)) (_ : F ≤ E₀ ∧ F.relIndex E₀ = q),
        oPrimeResidualOf 2 ((fixedPoints F).map e.toMonoidHom) := by
    rw [Subgroup.map_iSup]
    simp only [Subgroup.map_iSup]
    refine iSup_congr fun F => iSup_congr fun _ =>
      CFSG.RankThree.PartTwo.Sec21.map_oPrimeResidualOf e 2 (fixedPoints F)
  have hle : (⨆ (F : Subgroup (MulAut S)) (_ : F ≤ E₀ ∧ F.relIndex E₀ = q),
        oPrimeResidualOf 2 ((fixedPoints F).map e.toMonoidHom)) ≤
      (⨆ (F' : Subgroup (MulAut S')) (_ : F' ≤ E ∧ F'.relIndex E = q),
        oPrimeResidualOf 2 (fixedPoints F')) := by
    refine iSup₂_le fun F hF => ?_
    refine le_iSup₂_of_le (F.map (MulAut.congr e).toMonoidHom) ⟨?_, ?_⟩ ?_
    · have h1 : F.map (MulAut.congr e).toMonoidHom ≤
          E₀.map (MulAut.congr e).toMonoidHom := Subgroup.map_mono hF.1
      rwa [hE₀map] at h1
    · have hm := Subgroup.relIndex_map_map_of_injective
          (f := (MulAut.congr e).toMonoidHom) F E₀ (MulAut.congr e).injective
      rw [hE₀map] at hm
      exact hm.trans hF.2
    · rw [map_fixedPoints_mulAut_congr]
  exact top_le_iff.mp (by rw [← hmap_top, hsplit]; exact hle)

