theorem seitzTwoGen_of_oppRadGood {S : Type} [Group S] [Finite S]
    (h : ∀ Q : Subgroup S, Q ≠ ⊥ → GGRadicalTwo ⊤ Q → GGOppRadGood ⊤ Q) : SeitzTwoGen S := by
  intro q hq hq2 E hE ⟨U, hU0, hU2, hUinv⟩
  haveI : Fact q.Prime := ⟨hq⟩
  have hψinj : Function.Injective (SemidirectProduct.inl : S →* Hol S E) :=
    SemidirectProduct.inl_injective
  set T : Subgroup (Hol S E) := U.map (SemidirectProduct.inl : S →* Hol S E) with hT
  have hTK : T ≤ holK S E := fun x hx => by
    obtain ⟨u, -, rfl⟩ := hx
    exact mem_holK.2 ⟨u, rfl⟩
  have hT0 : T ≠ ⊥ := fun hbot =>
    hU0 ((Subgroup.map_eq_bot_iff_of_injective U hψinj).1 hbot)
  have hT2 : IsPGroup 2 T :=
    hU2.of_equiv (Subgroup.equivMapOfInjective U
      (SemidirectProduct.inl : S →* Hol S E) hψinj)
  have hET : holE S E ≤ Subgroup.normalizer (T : Set (Hol S E)) :=
    holE_le_normalizer_map hUinv
  have hEN : holE S E ≤ Subgroup.normalizer (holK S E : Set (Hol S E)) := by
    rw [Subgroup.normalizer_eq_top_iff.2 (holK_normal S E)]
    exact le_top
  have hEp : IsPGroup q ↥(holE S E) := IsPGroup.of_equiv hE (holEEquiv S E)
  have hgood : ∀ Q : Subgroup (Hol S E), Q ≠ ⊥ → GGRadicalTwo (holK S E) Q →
      GGOppRadGood (holK S E) Q := by
    intro Q hQ0 hQ
    have hQ' : GGRadicalTwo (SemidirectProduct.inl : S →* Hol S E).range Q := by
      rwa [range_inl_eq_holK]
    have hker : (SemidirectProduct.inl : S →* Hol S E).ker ≤ Subgroup.center S := by
      rw [(MonoidHom.ker_eq_bot_iff (SemidirectProduct.inl : S →* Hol S E)).2 hψinj]
      exact bot_le
    have hinv : ∀ z ∈ (SemidirectProduct.inl : S →* Hol S E).ker, z ^ 2 = 1 → z = 1 := by
      intro z hz _
      exact hψinj (by rw [MonoidHom.mem_ker.1 hz, map_one])
    have := CFSG.StandardType.GGOppRad.GGOppRadGood.of_lift
      (SemidirectProduct.inl : S →* Hol S E) hker hinv h hQ0 hQ'
    rwa [range_inl_eq_holK] at this
  obtain ⟨Q₁, Q₂, hQ₁K, hQ₂K, hQ₁, hQ₂, hn₁, hn₂, hgen⟩ :=
    CFSG.StandardType.GGTwoSig.exists_two_signalizers_of_count hq hq2 hEp hEN hTK hT0 hT2 hET
      (fun Q hQ0 hQ => CFSG.StandardType.GGOppRadGood.count hQ (hgood Q hQ0 hQ))
  refine ⟨Q₁.comap (SemidirectProduct.inl : S →* Hol S E),
    Q₂.comap (SemidirectProduct.inl : S →* Hol S E), isPGroup_comap_inl hQ₁,
    isPGroup_comap_inl hQ₂, invariant_comap_inl hn₁, invariant_comap_inl hn₂, ?_⟩
  apply Subgroup.map_injective (SemidirectProduct.inl_injective (N := S) (G := ↥E))
  rw [Subgroup.map_sup, Subgroup.map_comap_eq, Subgroup.map_comap_eq, range_inl_eq_holK,
    inf_of_le_right hQ₁K, inf_of_le_right hQ₂K, hgen, Subgroup.map_top, range_inl_eq_holK]

end Certs

theorem seitzSimpleStmt_of_vacuous {S : Type} [Group S] [Finite S] (hs : IsSimpleGroup S)
    (h2 : 2 ∣ Nat.card S)
    (hv : ∀ q : ℕ, q.Prime → q ≠ 2 → ∀ E : Subgroup (MulAut S), IsElemAbelian q E →
      q ^ 2 ≤ Nat.card E →
      ∀ U : Subgroup S, IsPGroup 2 ↥U → (∀ φ ∈ E, ∀ u ∈ U, φ u ∈ U) → U = ⊥) :
    SeitzSimpleStmt S := by
  intro q hq hq2 E hE hE0 _ ⟨U, hU0, hU2, hUinv⟩
  haveI : Fact q.Prime := ⟨hq⟩
  by_cases hbig : q ^ 2 ≤ Nat.card E
  · exact absurd (hv q hq hq2 E hE hbig U hU2 hUinv) hU0
  · push Not at hbig
    obtain ⟨n, hn⟩ := hE.isPGroup.exists_card_eq
    have hnne : n ≠ 0 := by
      rintro rfl
      rw [pow_zero] at hn
      exact hE0 (Subgroup.card_eq_one.mp hn)
    have hnlt : n < 2 := by
      rw [hn] at hbig
      exact (Nat.pow_lt_pow_iff_right hq.one_lt).1 hbig
    have hEcard : Nat.card E = q := by
      rw [hn, show n = 1 by omega, pow_one]
    have hfixbot : fixedPoints (⊥ : Subgroup (MulAut S)) = ⊤ := by
      ext x
      simp [mem_fixedPoints]
    have htop : oPrimeResidualOf 2 (fixedPoints (⊥ : Subgroup (MulAut S))) = ⊤ := by
      rw [hfixbot, oPrimeResidualOf_top]
      exact oPrimeResidual_two_eq_top_of_isSimpleGroup hs h2
    have hbotrel : (⊥ : Subgroup (MulAut S)).relIndex E = q := by
      rw [Subgroup.relIndex_bot_left, hEcard]
    exact top_le_iff.mp (le_trans (le_of_eq htop.symm)
      (le_iSup₂_of_le (⊥ : Subgroup (MulAut S)) ⟨bot_le, hbotrel⟩ le_rfl))

end CFSG.LocalAnalysis.GLTheoremA.Y10F
