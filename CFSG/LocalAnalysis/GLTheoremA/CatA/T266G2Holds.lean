theorem three_not_dvd_two_pow_sub_one {n : ℕ} (hn : Odd n) : ¬ 3 ∣ 2 ^ n - 1 := by
  obtain ⟨k, rfl⟩ := hn
  have h4 : 4 ^ k % 3 = 1 := by
    rw [Nat.pow_mod]
    norm_num
  have h2 : 2 ^ (2 * k + 1) = 2 * 4 ^ k := by
    rw [pow_succ, pow_mul]
    norm_num
    ring
  rw [h2]
  omega

theorem three_dvd_two_pow_sub_one {n : ℕ} (hn : Even n) : 3 ∣ 2 ^ n - 1 := by
  obtain ⟨k, rfl⟩ := hn
  have h : 2 ^ (k + k) = 4 ^ k := by rw [← two_mul, pow_mul]; norm_num
  rw [h]
  simpa using Nat.sub_dvd_pow_sub_pow 4 1 k

theorem factorization_three_mul_mul {a b c : ℕ} (ha : ¬ 3 ∣ a) (hb : ¬ 3 ∣ b) (hc : c ≠ 0) :
    (a * b * c).factorization 3 = c.factorization 3 := by
  have ha0 : a ≠ 0 := by rintro rfl; exact ha (dvd_zero 3)
  have hb0 : b ≠ 0 := by rintro rfl; exact hb (dvd_zero 3)
  rw [Nat.factorization_mul (mul_ne_zero ha0 hb0) hc, Nat.factorization_mul ha0 hb0,
    Finsupp.add_apply, Finsupp.add_apply, Nat.factorization_eq_zero_of_not_dvd ha,
    Nat.factorization_eq_zero_of_not_dvd hb, zero_add, zero_add]

