theorem card_SL2_eq {K : Type} [Field K] [Finite K] :
    Nat.card (SL(2, K)) = Nat.card K * ((Nat.card K - 1) * (Nat.card K + 1)) := by
  classical
  have := Fintype.ofFinite K
  have hq : 1 < Fintype.card K := Fintype.one_lt_card
  have h : Nat.card (SL(2, K)) = Nat.card K * (Nat.card K ^ 2 - 1) := by
    rw [Matrix.card_SL_field, Fin.prod_univ_two, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
      Nat.card_eq_fintype_card, show Fintype.card K ^ 2 - Fintype.card K =
        Fintype.card K * (Fintype.card K - 1) by rw [Nat.mul_sub_one, sq], ← mul_assoc,
      Nat.mul_div_cancel _ (by omega), mul_comm]
  rw [h]
  congr 1
  have h1 : 1 ≤ Nat.card K := Nat.card_pos
  zify [h1, Nat.one_le_pow 2 _ (by omega : 0 < Nat.card K)]
  ring

theorem map_centralizer_mulEquiv {A S : Type*} [Group A] [Group S] (Φ : A ≃* S) (X : Set A) :
    (Subgroup.centralizer X).map Φ.toMonoidHom = Subgroup.centralizer (Φ '' X) := by
  ext s
  constructor
  · rintro ⟨c, hc, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff] at hc
    rw [Subgroup.mem_centralizer_iff]
    rintro _ ⟨x, hx, rfl⟩
    simp only [MulEquiv.coe_toMonoidHom]
    rw [← map_mul, ← map_mul, hc x hx]
  · intro hs
    refine ⟨Φ.symm s, ?_, by simp⟩
    rw [Subgroup.mem_centralizer_iff] at hs
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
    intro x hx
    apply Φ.injective
    rw [map_mul, map_mul, MulEquiv.apply_symm_apply]
    exact hs (Φ x) ⟨x, hx, rfl⟩

theorem map_map_symm_mulEquiv {A S : Type*} [Group A] [Group S] (Φ : A ≃* S) (D : Subgroup S) :
    (D.map Φ.symm.toMonoidHom).map Φ.toMonoidHom = D := by
  rw [Subgroup.map_map]
  have h : Φ.toMonoidHom.comp Φ.symm.toMonoidHom = MonoidHom.id S := by
    ext x
    simp
  rw [h, Subgroup.map_id]

theorem nonempty_pSimple_equiv_of_simple_three {X : Type} [Group X] [Finite X] {J : Subgroup X}
    (hJ : IsSimpleGroup ↥J) (hna : ∃ x y : ↥J, x * y ≠ y * x) (h3 : 3 ∣ Nat.card J) :
    Nonempty (PSimple 3 J ≃* ↥J) := by
  haveI := hJ
  have hcop := GL83.PiGen.coprime_card_glaPPrimeCore Nat.prime_three ↥J
  have hN : GLAPPrimeCore 3 ↥J = ⊥ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (GLAPPrimeCore 3 ↥J) with h0 | h0
    · exact h0
    · exfalso
      rw [h0, Subgroup.card_top] at hcop
      exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).1 hcop h3
  let e₁ : PQuot 3 J ≃* ↥J :=
    (QuotientGroup.quotientMulEquivOfEq hN).trans QuotientGroup.quotientBot
  haveI : IsSimpleGroup (PQuot 3 J) := e₁.isSimpleGroup
  have hZ : Subgroup.center (PQuot 3 J) = ⊥ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center (PQuot 3 J)) with h0 | h0
    · exact h0
    · exfalso
      obtain ⟨x, y, hxy⟩ := hna
      apply hxy
      have hc := Subgroup.mem_center_iff.1 (h0 ▸ Subgroup.mem_top (e₁.symm y)) (e₁.symm x)
      have := congrArg e₁ hc
      simpa using this
  exact ⟨((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).trans e₁⟩

