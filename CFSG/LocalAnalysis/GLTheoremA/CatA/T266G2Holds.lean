theorem g2ShortSL2_normal_centralizer {ζ : Kˣ} (hζ : orderOf ζ = 3) {z₀ : ↥(adjointGroup .G2 K)}
    (hz₀ : (z₀ : ModGL .G2 K) = rootDiagUnit .G2 (fun j => ζ ^ Tag.G2.cartan g2ia j)) :
    ((g2ShortSL2 K).subgroupOf (Subgroup.centralizer ({z₀} : Set ↥(adjointGroup .G2 K)))).Normal := by
  refine ⟨fun n hn g => ?_⟩
  rw [Subgroup.mem_subgroupOf] at hn ⊢
  have hcomm := coe_comm_mem_Qv hζ hz₀ g.2 n.2
  have h1 : ((g : ↥(adjointGroup .G2 K)) * n * (g : ↥(adjointGroup .G2 K))⁻¹ * (n : _)⁻¹) ∈
      g2ShortSL2 K := hcomm
  have h2 := (g2ShortSL2 K).mul_mem h1 hn
  have e : ((g * n * g⁻¹ : ↥(Subgroup.centralizer ({z₀} : Set ↥(adjointGroup .G2 K)))) :
      ↥(adjointGroup .G2 K)) =
      (g : ↥(adjointGroup .G2 K)) * n * (g : ↥(adjointGroup .G2 K))⁻¹ * (n : _)⁻¹ * n := by
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    group
  rw [e]
  exact h2

theorem rootDiagUnit_conj_mem_rootSubgroup (b : Fin Tag.G2.rank → Kˣ) {u : ModGL .G2 K}
    (hu : u ∈ rootSubgroup .G2 K g2δ) :
    rootDiagUnit .G2 b * u * (rootDiagUnit .G2 b)⁻¹ ∈ rootSubgroup .G2 K g2δ := by
  obtain ⟨c, rfl⟩ := mem_rootSubgroup.1 hu
  rw [rootDiagUnit_conj_pinnedX b isRoot_g2δ c]
  exact mem_rootSubgroup.2 ⟨_, rfl⟩

theorem le_normalizer_rootSubgroup {E' : Subgroup ↥(adjointGroup .G2 K)}
    (hE' : ∀ z ∈ E', ∃ b : Fin Tag.G2.rank → Kˣ, (z : ModGL .G2 K) = rootDiagUnit .G2 b) :
    E' ≤ Subgroup.normalizer
      (((rootSubgroup .G2 K g2δ).comap (adjointGroup .G2 K).subtype : Subgroup _) :
        Set ↥(adjointGroup .G2 K)) := by
  intro z hz
  obtain ⟨b, hb⟩ := hE' z hz
  rw [Subgroup.mem_normalizer_iff]
  intro t
  simp only [SetLike.mem_coe, Subgroup.mem_comap, Subgroup.coe_subtype, Subgroup.coe_mul,
    Subgroup.coe_inv, hb]
  constructor
  · exact rootDiagUnit_conj_mem_rootSubgroup b
  · intro ht
    have hinv : (rootDiagUnit .G2 b)⁻¹ = rootDiagUnit .G2 b⁻¹ :=
      (map_inv (rootDiagUnitHom .G2 K) b).symm
    have e : (t : ModGL .G2 K) = rootDiagUnit .G2 b⁻¹ *
        (rootDiagUnit .G2 b * (t : ModGL .G2 K) * (rootDiagUnit .G2 b)⁻¹) *
          (rootDiagUnit .G2 b⁻¹)⁻¹ := by
      rw [← hinv]
      group
    rw [e]
    exact rootDiagUnit_conj_mem_rootSubgroup b⁻¹ ht

theorem isPGroup_rootSubgroup_comap [CharP K 2] :
    IsPGroup 2 ↥((rootSubgroup .G2 K g2δ).comap (adjointGroup .G2 K).subtype) := by
  intro t
  refine ⟨1, ?_⟩
  obtain ⟨c, hc⟩ := mem_rootSubgroup.1 (Subgroup.mem_comap.1 t.2)
  apply Subtype.ext
  apply Subtype.ext
  simp only [pow_one, Subgroup.coe_pow, Subgroup.coe_one]
  rw [Subgroup.coe_subtype] at hc
  rw [← hc, pow_two, ← pinnedX_add, CharTwo.add_self_eq_zero, pinnedX_zero]

theorem comm_rootSubgroup_comap (x y : ↥((rootSubgroup .G2 K g2δ).comap (adjointGroup .G2 K).subtype)) :
    x * y = y * x := by
  obtain ⟨c, hc⟩ := mem_rootSubgroup.1 (Subgroup.mem_comap.1 x.2)
  obtain ⟨d, hd⟩ := mem_rootSubgroup.1 (Subgroup.mem_comap.1 y.2)
  apply Subtype.ext
  apply Subtype.ext
  simp only [Subgroup.coe_mul]
  rw [Subgroup.coe_subtype] at hc hd
  rw [← hc, ← hd, ← pinnedX_add, ← pinnedX_add, add_comm]

theorem commutator_rootSubgroup_ne_bot {ζ : Kˣ} (hζ : orderOf ζ = 3) {E' : Subgroup ↥(adjointGroup .G2 K)}
    {z₁ : ↥(adjointGroup .G2 K)} (hz₁E : z₁ ∈ E')
    (hz₁ : (z₁ : ModGL .G2 K) = rootDiagUnit .G2 (Pi.mulSingle g2ir ζ)) :
    (⁅(rootSubgroup .G2 K g2δ).comap (adjointGroup .G2 K).subtype, E'⁆ :
      Subgroup ↥(adjointGroup .G2 K)) ≠ ⊥ := by
  set t₀ : ↥(adjointGroup .G2 K) := ⟨pinnedX .G2 K g2δ 1, pinnedX_mem_adjointGroup g2δ 1⟩
  have ht₀ : t₀ ∈ (rootSubgroup .G2 K g2δ).comap (adjointGroup .G2 K).subtype :=
    Subgroup.mem_comap.2 (mem_rootSubgroup.2 ⟨1, rfl⟩)
  intro h0
  have hc := Subgroup.commutator_mem_commutator ht₀ hz₁E
  rw [h0, Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm] at hc
  have hc' := congrArg Subtype.val hc
  simp only [Subgroup.coe_mul] at hc'
  rw [hz₁] at hc'
  have h1 : rootDiagUnit .G2 (Pi.mulSingle g2ir ζ) * pinnedX .G2 K g2δ 1 *
      (rootDiagUnit .G2 (Pi.mulSingle g2ir ζ))⁻¹ = pinnedX .G2 K g2δ 1 := by
    have ht : (t₀ : ModGL .G2 K) = pinnedX .G2 K g2δ 1 := rfl
    rw [ht] at hc'
    rw [← hc']
    group
  rw [rootDiagUnit_conj_pinnedX _ isRoot_g2δ 1, mul_one] at h1
  have h2 := pinnedX_injective .G2 K g2δ h1
  have h3 : rootChar (Pi.mulSingle g2ir ζ) g2δ = 1 := Units.ext (by rw [Units.val_one]; exact h2)
  rw [rootChar_g2] at h3
  have e0 : g2δ g2ia = 1 := rfl
  have e1 : g2δ g2ir = 2 := rfl
  rw [e0, e1, Pi.mulSingle_eq_of_ne (by decide), Pi.mulSingle_eq_same, one_zpow, one_mul,
    zpow_two] at h3
  have h4 : ζ ^ 2 = 1 := by rw [sq]; exact h3
  have := orderOf_dvd_of_pow_eq_one h4
  rw [hζ] at this
  norm_num at this

theorem exists_torus_frame [Finite K] (h31 : 3 ∣ Nat.card K - 1) {S : Type} [Group S]
    (e : ↥(adjointGroup .G2 K) ≃* S) {D : Subgroup S} (hD : IsElemAbelian 3 D)
    (hD9 : 9 ≤ Nat.card D) :
    ∃ (ζ : Kˣ) (Φ : ↥(adjointGroup .G2 K) ≃* S), orderOf ζ = 3 ∧
      (∀ z ∈ D.map Φ.symm.toMonoidHom, ∃ b : Fin Tag.G2.rank → Kˣ,
        (z : ModGL .G2 K) = rootDiagUnit .G2 b) ∧
      (∃ z₀ ∈ D.map Φ.symm.toMonoidHom,
        (z₀ : ModGL .G2 K) = rootDiagUnit .G2 (fun j => ζ ^ Tag.G2.cartan g2ia j)) ∧
      (∃ z₁ ∈ D.map Φ.symm.toMonoidHom,
        (z₁ : ModGL .G2 K) = rootDiagUnit .G2 (Pi.mulSingle g2ir ζ)) := by
  set E : Subgroup ↥(adjointGroup .G2 K) := D.map e.symm.toMonoidHom with hEdef
  have hE : IsElemAbelian 3 E := CFSG.SectionRank.isElemAbelian_map hD e.symm.toMonoidHom
  have hE9 : 9 ≤ Nat.card E := by
    rw [hEdef, Subgroup.card_map_of_injective e.symm.injective]
    exact hD9
  obtain ⟨g, hg⟩ := exists_conj_torus_of_elemAbelian h31 hE
  obtain ⟨ζ, hζ⟩ :=
    CFSG.RankThree.Chevalley.exists_units_orderOf_eq_of_dvd_card_sub_one Nat.prime_three h31
  have hζ3 : ζ ^ 3 = 1 := by rw [← hζ]; exact pow_orderOf_eq_one ζ
  have hb₀ : (fun j => ζ ^ Tag.G2.cartan g2ia j) ^ 3 = 1 := by
    funext j
    simp only [Pi.pow_apply, Pi.one_apply]
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hζ3, one_zpow]
  have hb₁ : (Pi.mulSingle g2ir ζ : Fin Tag.G2.rank → Kˣ) ^ 3 = 1 := by
    funext j
    simp only [Pi.pow_apply, Pi.one_apply]
    by_cases hj : j = g2ir
    · subst hj
      rw [Pi.mulSingle_eq_same, hζ3]
    · rw [Pi.mulSingle_eq_of_ne hj, one_pow]
  set Φ : ↥(adjointGroup .G2 K) ≃* S := (MulAut.conj g).symm.trans e with hΦ
  have hΦs : ∀ d : S, Φ.symm d = g * e.symm d * g⁻¹ := fun d => rfl
  have hmem : ∀ z, z ∈ D.map Φ.symm.toMonoidHom ↔ ∃ x ∈ E, g * x * g⁻¹ = z := by
    intro z
    constructor
    · rintro ⟨d, hd, rfl⟩
      exact ⟨e.symm d, Subgroup.mem_map_of_mem _ hd, (hΦs d).symm⟩
    · rintro ⟨x, ⟨d, hd, rfl⟩, rfl⟩
      exact ⟨d, hd, hΦs d⟩
  refine ⟨ζ, Φ, hζ, ?_, ?_, ?_⟩
  · intro z hz
    obtain ⟨x, hx, rfl⟩ := (hmem z).1 hz
    obtain ⟨b, -, hb⟩ := hg x hx
    exact ⟨b, hb⟩
  · obtain ⟨x, hx, hxb⟩ := forall_exists_of_nine_le hg hE9 _ hb₀
    exact ⟨g * x * g⁻¹, (hmem _).2 ⟨x, hx, rfl⟩, hxb⟩
  · obtain ⟨x, hx, hxb⟩ := forall_exists_of_nine_le hg hE9 _ hb₁
    exact ⟨g * x * g⁻¹, (hmem _).2 ⟨x, hx, rfl⟩, hxb⟩

end Even

