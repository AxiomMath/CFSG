theorem g2_adjoint_equiv {S : Type} [Group S] {n : ℕ} (h : catalogIs S (S10.isG2n n)) :
    2 ≤ n ∧ Nonempty (↥(adjointGroup .G2 (GaloisField 2 n)) ≃* S) := by
  obtain ⟨i, hi, ⟨eS⟩⟩ := h
  cases i with
  | cyclic _ _ => exact hi.elim
  | alternating _ _ => exact hi.elim
  | sporadic _ => exact hi.elim
  | lie j =>
    obtain ⟨d, hv⟩ := j
    cases d with
    | G2 q =>
      obtain ⟨hq2, hqn⟩ : q.p = 2 ∧ q.exponent = n := hi
      haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
      have hn0 : n ≠ 0 := by rw [← hqn]; exact q.exponent_pos.ne'
      have hcard : q.card = 2 ^ n := by rw [TauCeti.PrimePower.card_def, hq2, hqn]
      have hK : Nat.card (GaloisField 2 n) = q.card := by rw [GaloisField.card 2 n hn0, hcard]
      obtain ⟨eQ⟩ := CFSG.TauCetiBridge.Even.untwistedBridgeEven_G2 q hv hq2 (GaloisField 2 n) hK
      have hZ := center_adjointGroup_eq_bot (τ := Tag.G2) (K := GaloisField 2 n)
      have h3 : 3 ≤ q.card :=
        (TauCeti.LieTypeIndex.inStandardRange_iff _).1 ((TauCeti.LieTypeIndex.valid_iff _).1 hv).1
      refine ⟨?_, ⟨((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm.trans
        (eQ.trans eS.symm)⟩⟩
      rw [hcard] at h3
      rcases Nat.lt_or_ge n 2 with hlt | hge
      · interval_cases n <;> norm_num at h3
      · exact hge
    | _ => exact hi.elim

