theorem eq_HSL_of_comm_HSL {ζ : Kˣ} (hζ : ζ ^ 2 ≠ 1) {M : SL2 K} (h : M * HSL ζ = HSL ζ * M) :
    ∃ t : Kˣ, M = HSL t := by
  have hζ0 : (ζ : K) ≠ 0 := ζ.ne_zero
  have hne : (ζ : K) - (ζ : K)⁻¹ ≠ 0 := by
    intro h'
    apply hζ
    have h1 : (ζ : K) * (ζ : K) = 1 := by
      have : (ζ : K) = (ζ : K)⁻¹ := sub_eq_zero.1 h'
      nth_rewrite 2 [this]
      exact mul_inv_cancel₀ hζ0
    exact Units.ext (by rw [Units.val_pow_eq_pow_val, sq, h1, Units.val_one])
  have hM := congrArg (fun A : SL2 K => (A : Matrix (Fin 2) (Fin 2) K)) h
  simp only [Matrix.SpecialLinearGroup.coe_mul, coe_HSL] at hM
  have h01 := congrFun (congrFun hM 0) 1
  have h10 := congrFun (congrFun hM 1) 0
  simp [Matrix.mul_apply, Fin.sum_univ_two] at h01 h10
  have h01' : (M : Matrix (Fin 2) (Fin 2) K) 0 1 = 0 := by
    have key : (M : Matrix (Fin 2) (Fin 2) K) 0 1 * ((ζ : K) - (ζ : K)⁻¹) = 0 := by
      first | linear_combination h01 | linear_combination -h01
    exact (mul_eq_zero.1 key).resolve_right hne
  have h10' : (M : Matrix (Fin 2) (Fin 2) K) 1 0 = 0 := by
    have key : (M : Matrix (Fin 2) (Fin 2) K) 1 0 * ((ζ : K) - (ζ : K)⁻¹) = 0 := by
      first | linear_combination h10 | linear_combination -h10
    exact (mul_eq_zero.1 key).resolve_right hne
  have hdet := det_SL2 M
  rw [h01', zero_mul, sub_zero] at hdet
  have h00 : (M : Matrix (Fin 2) (Fin 2) K) 0 0 ≠ 0 := by
    intro h0
    rw [h0, zero_mul] at hdet
    exact zero_ne_one hdet
  refine ⟨Units.mk0 _ h00, Subtype.ext ?_⟩
  rw [coe_HSL]
  ext i j
  fin_cases i <;> fin_cases j
  · simp
  · simp [h01']
  · simp [h10']
  · simp only [Units.val_inv_eq_inv_val, Units.val_mk0]
    simp
    exact eq_inv_of_mul_eq_one_right hdet

