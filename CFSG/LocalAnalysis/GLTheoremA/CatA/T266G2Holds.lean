theorem three_not_dvd_card_torusGroup_of [Finite K] (hK3 : ¬ 3 ∣ Nat.card K - 1) (τ : Tag) :
    ¬ 3 ∣ Nat.card (torusGroup τ K) := by
  intro h3
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  haveI : Finite (ModGL τ K) := inferInstance
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := ↥(torusGroup τ K)) 3 h3
  have hcomm := (triangular_borel_structure.{0, 0} τ K).1
  have hexp : ∀ h ∈ torusGroup τ K, h ^ (Nat.card K - 1) = 1 := by
    intro h hh
    have hunit : ∀ t : Kˣ, t ^ (Nat.card K - 1) = 1 := by
      intro t
      rw [← Nat.card_units]
      exact pow_card_eq_one'
    induction hh using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨⟨j, t⟩, rfl⟩ := hx
      show (torusEltHom τ K j t) ^ (Nat.card K - 1) = 1
      rw [← map_pow, hunit t, map_one]
    | one => simp
    | mul x y hx hy ihx ihy =>
      have hc : Commute x y := hcomm x hx y hy
      rw [hc.mul_pow, ihx, ihy, one_mul]
    | inv x hx ihx =>
      rw [inv_pow, ihx, inv_one]
  have h1 : ((x : ModGL τ K)) ^ (Nat.card K - 1) = 1 := hexp _ x.2
  have hd : orderOf (x : ModGL τ K) ∣ Nat.card K - 1 := orderOf_dvd_of_pow_eq_one h1
  rw [Subgroup.orderOf_coe, hx] at hd
  exact hK3 hd

theorem card_le_three_of_le_parabolic_of_not_dvd [Finite K] [CharP K 2] (hK3 : ¬ 3 ∣ Nat.card K - 1)
    {τ : Tag} (i : Fin τ.rank) {E : Subgroup (ModGL τ K)} (hE : E ≤ parabolicSubgroup τ K {i})
    (hcomm : ∀ a b : E, a * b = b * a) (h3 : ∀ x : E, x ^ 3 = 1) : Nat.card E ≤ 3 := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set P := parabolicSubgroup τ K {i} with hP
  have hPcard := HDesc.card_parabolicSubgroup_singleton (τ := τ) (K := K) i
  have h3H := three_not_dvd_card_torusGroup_of hK3 τ
  have hq2 : ∃ m, Nat.card K = 2 ^ m := by
    have := Fintype.ofFinite K
    obtain ⟨m, hp, hm⟩ := FiniteField.card K 2
    exact ⟨(m : ℕ), by rw [Nat.card_eq_fintype_card, hm]⟩
  obtain ⟨m, hm⟩ := hq2
  have hq3 : ¬ 3 ∣ Nat.card K := by
    rw [hm]
    intro h
    have := Nat.Prime.dvd_of_dvd_pow Nat.prime_three h
    omega
  have hqN : ¬ 3 ∣ Nat.card K ^ {α : Fin τ.rank → ℤ | IsRoot τ α ∧ 0 < height α}.ncard := by
    intro h
    exact hq3 (Nat.Prime.dvd_of_dvd_pow Nat.prime_three h)
  have hq1 : 0 < Nat.card K := Nat.card_pos
  have hvP : (Nat.card P).factorization 3 = (Nat.card K + 1).factorization 3 := by
    rw [hPcard, add_comm 1 (Nat.card K)]
    exact factorization_three_mul_mul h3H hqN (by omega)
  have hvSL : (Nat.card (SL(2, K))).factorization 3 = (Nat.card K + 1).factorization 3 := by
    rw [card_SL2_eq, ← mul_assoc]
    exact factorization_three_mul_mul hq3 hK3 (by omega)
  obtain ⟨ρ, -, -, -, -, hrange, hker, -, -⟩ :=
    exceptional_ordinary_rank_one_central_image (τ := τ) (K := K) i
  have hinj : Function.Injective ρ := HDesc.rankOne_injective hker
  have hρP : ∀ g : SL2 K, ρ g ∈ P := by
    intro g
    have hg : ρ g ∈ ρ.range := ⟨g, rfl⟩
    rw [hrange] at hg
    refine (Subgroup.closure_le P).2 ?_ hg
    rintro _ (⟨c, rfl⟩ | ⟨c, rfl⟩)
    · exact borelGroup_le_parabolicSubgroup _ (xUnit_mem_borelGroup i c)
    · exact yUnit_mem_parabolicSubgroup i c
  let ρP : SL2 K →* ↥P := ρ.codRestrict P hρP
  have hρPinj : Function.Injective ρP := fun a b h => hinj (congrArg Subtype.val h)
  haveI : Finite (SL2 K) := inferInstance
  haveI : Finite (ModGL τ K) := inferInstance
  haveI : Finite ↥P := inferInstance
  obtain ⟨R⟩ : Nonempty (Sylow 3 (SL2 K)) := inferInstance
  set R₁ : Subgroup ↥P := (R : Subgroup (SL2 K)).map ρP with hR₁
  have hR₁card : Nat.card R₁ = 3 ^ (Nat.card K + 1).factorization 3 := by
    rw [hR₁, Subgroup.card_map_of_injective hρPinj, Sylow.card_eq_multiplicity R]
    exact congrArg _ hvSL
  have hR₁p : IsPGroup 3 R₁ := R.isPGroup'.map ρP
  have hR₁idx : ¬ 3 ∣ R₁.index := by
    intro hdvd
    have hmul := Subgroup.card_mul_index R₁
    have hP0 : Nat.card P ≠ 0 := Nat.card_pos.ne'
    have hidx0 : R₁.index ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hmul
      exact hP0 hmul.symm
    have hv : (Nat.card R₁ * R₁.index).factorization 3 = (Nat.card P).factorization 3 := by
      rw [hmul]
    rw [Nat.factorization_mul (by rw [hR₁card]; positivity) hidx0, Finsupp.add_apply, hR₁card,
      Nat.Prime.factorization_pow Nat.prime_three, Finsupp.single_eq_same, hvP] at hv
    have h0 : R₁.index.factorization 3 = 0 := by omega
    rw [Nat.factorization_eq_zero_iff] at h0
    rcases h0 with h0 | h0 | h0
    · exact h0 Nat.prime_three
    · exact h0 hdvd
    · exact hidx0 h0
  let S₁ : Sylow 3 ↥P := hR₁p.toSylow hR₁idx
  let EP : Subgroup ↥P := E.subgroupOf P
  have hEPmem : ∀ x : ↥P, x ∈ EP ↔ (x : ModGL τ K) ∈ E := fun x => Subgroup.mem_subgroupOf
  have hEP3 : IsPGroup 3 EP := by
    intro x
    refine ⟨1, ?_⟩
    have h := h3 ⟨(x.1 : ModGL τ K), (hEPmem x.1).1 x.2⟩
    apply Subtype.ext
