variable {K : Type} [Field K]

theorem exists_conj_torus_of_elemAbelian [Finite K] (h31 : 3 ∣ Nat.card K - 1)
    {E : Subgroup ↥(adjointGroup .G2 K)} (hE : IsElemAbelian 3 E) :
    ∃ g : ↥(adjointGroup .G2 K), ∀ x ∈ E, ∃ b : Fin Tag.G2.rank → Kˣ, b ^ 3 = 1 ∧
      ((g * x * g⁻¹ : ↥(adjointGroup .G2 K)) : ModGL .G2 K) = rootDiagUnit .G2 b := by
  obtain ⟨φ, hφinj, hφ⟩ := CFSG.GH74.GLS.Stage2.Bender.Thm1.exists_a2Hom_injective (K := K)
  have hEp : IsPGroup 3 E := by
    intro x
    exact ⟨1, Subtype.ext (by simpa using hE.2 x x.2)⟩
  obtain ⟨y, hy⟩ :=
    CFSG.GH74.GLS.Stage2.Bender.Thm1.exists_conj_le_range_of_three_dvd_sub_one h31 φ hφinj E hEp
  set X : Subgroup (Matrix.SpecialLinearGroup (Fin 3) K) :=
    (E.map (MulAut.conj y).toMonoidHom).comap φ with hX
  have hX3 : ∀ x ∈ X, x ^ 3 = 1 := by
    intro x hx
    obtain ⟨e, he, hex⟩ := Subgroup.mem_map.1 (Subgroup.mem_comap.1 hx)
    apply hφinj
    rw [map_pow, ← hex, ← map_pow, hE.2 e he, map_one, map_one]
  have hXc : ∀ x ∈ X, ∀ w ∈ X, x * w = w * x := by
    intro x hx w hw
    obtain ⟨e, he, hex⟩ := Subgroup.mem_map.1 (Subgroup.mem_comap.1 hx)
    obtain ⟨e', he', hex'⟩ := Subgroup.mem_map.1 (Subgroup.mem_comap.1 hw)
    apply hφinj
    rw [map_mul, map_mul, ← hex, ← hex', ← map_mul, ← map_mul]
    congr 1
    exact congrArg Subtype.val (hE.1.is_comm.comm ⟨e, he⟩ ⟨e', he'⟩)
  obtain ⟨ζ, hζ⟩ :=
    CFSG.RankThree.Chevalley.exists_units_orderOf_eq_of_dvd_card_sub_one Nat.prime_three h31
  obtain ⟨hω, hω1⟩ := primitive_cube_root_of_orderOf hζ
  obtain ⟨Y, hY⟩ := CFSG.GH74.GLS.Stage2.Bender.Thm1.exists_diagonalizing_of_commuting_cube_one
    (ζ : K) hω hω1 X hX3 hXc
  refine ⟨φ Y * y, fun x hx => ?_⟩
  obtain ⟨X0, hX0⟩ := hy (Subgroup.mem_map_of_mem (MulAut.conj y).toMonoidHom hx)
  have hX0X : X0 ∈ X := by
    show φ X0 ∈ E.map (MulAut.conj y).toMonoidHom
    rw [hX0]
    exact Subgroup.mem_map_of_mem _ hx
  have hd := CFSG.GH74.GLS.Stage2.Bender.Thm1.phi_diag_mem_torusGroup φ hφ (Y * X0 * Y⁻¹)
    (hY X0 hX0X)
  obtain ⟨b, hb⟩ := exists_rootDiagUnit_eq_of_mem_torusGroup hd
  have hgx : φ Y * y * x * (φ Y * y)⁻¹ = φ (Y * X0 * Y⁻¹) := by
    rw [map_mul, map_mul, map_inv, hX0]
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    group
  refine ⟨b, ?_, ?_⟩
  · apply rootDiagUnit_injective (τ := .G2) (K := K)
    change rootDiagUnitHom .G2 K (b ^ 3) = rootDiagUnitHom .G2 K 1
    rw [map_pow, map_one]
    change rootDiagUnit .G2 b ^ 3 = 1
    rw [← hb, ← hgx, ← Subgroup.coe_pow, conj_pow, hE.2 x hx, mul_one, mul_inv_cancel,
      Subgroup.coe_one]
  · rw [hgx]
    exact hb

theorem forall_exists_of_nine_le [Finite K] {g : ↥(adjointGroup .G2 K)}
    {E : Subgroup ↥(adjointGroup .G2 K)}
    (hg : ∀ x ∈ E, ∃ b : Fin Tag.G2.rank → Kˣ, b ^ 3 = 1 ∧
      ((g * x * g⁻¹ : ↥(adjointGroup .G2 K)) : ModGL .G2 K) = rootDiagUnit .G2 b)
    (h9 : 9 ≤ Nat.card E) (b : Fin Tag.G2.rank → Kˣ) (hb : b ^ 3 = 1) :
    ∃ x ∈ E, ((g * x * g⁻¹ : ↥(adjointGroup .G2 K)) : ModGL .G2 K) = rootDiagUnit .G2 b := by
  classical
  choose! F hF3 hF using hg
  have hmem : ∀ c : Fin Tag.G2.rank → Kˣ, c ^ 3 = 1 → ∀ j, c j ∈ rootsOfUnity 3 K := by
    intro c hc j
    rw [mem_rootsOfUnity]
    exact congrFun hc j
  let Ψ : E → (Fin Tag.G2.rank → rootsOfUnity 3 K) := fun x j => ⟨F x j, hmem _ (hF3 x x.2) j⟩
  have hΨ : Function.Injective Ψ := by
    intro x x' h
    have hFF : F x = F x' := funext fun j => congrArg Subtype.val (congrFun h j)
    have h1 : ((g * x * g⁻¹ : ↥(adjointGroup .G2 K)) : ModGL .G2 K) =
        ((g * x' * g⁻¹ : ↥(adjointGroup .G2 K)) : ModGL .G2 K) := by
      rw [hF x x.2, hF x' x'.2, hFF]
    have h2 : g * (x : ↥(adjointGroup .G2 K)) * g⁻¹ = g * x' * g⁻¹ := Subtype.ext h1
    exact Subtype.ext (by simpa using h2)
  have hR : Nat.card (rootsOfUnity 3 K) ≤ 3 := card_rootsOfUnity (R := K) (k := 3)
  have hcard : Nat.card (Fin Tag.G2.rank → rootsOfUnity 3 K) ≤ Nat.card E := by
    rw [Nat.card_fun]
    have h2 : Nat.card (Fin Tag.G2.rank) = 2 := by
      rw [Nat.card_eq_fintype_card, Fintype.card_fin]
      rfl
    rw [h2]
    calc Nat.card (rootsOfUnity 3 K) ^ 2 ≤ 3 ^ 2 := Nat.pow_le_pow_left hR 2
      _ = 9 := by norm_num
      _ ≤ Nat.card E := h9
  have hbij := hΨ.bijective_of_nat_card_le hcard
  obtain ⟨x, hx⟩ := hbij.2 (fun j => ⟨b j, hmem b hb j⟩)
  refine ⟨x, x.2, ?_⟩
  have hFx : F x = b := funext fun j => congrArg Subtype.val (congrFun hx j)
  rw [hF x x.2, hFx]

theorem coe_comm_mem_Qv {ζ : Kˣ} (hζ : orderOf ζ = 3) {z₀ c c' : ↥(adjointGroup .G2 K)}
    (hz₀ : (z₀ : ModGL .G2 K) = rootDiagUnit .G2 (fun j => ζ ^ Tag.G2.cartan g2ia j))
    (hc : c ∈ Subgroup.centralizer ({z₀} : Set ↥(adjointGroup .G2 K)))
    (hc' : c' ∈ Subgroup.centralizer ({z₀} : Set ↥(adjointGroup .G2 K))) :
    ((c * c' * c⁻¹ * c'⁻¹ : ↥(adjointGroup .G2 K)) : ModGL .G2 K) ∈
      rootSubgroup .G2 K g2δ ⊔ rootSubgroup .G2 K (-g2δ) := by
  have h1 := (mem_centralizer_iff_toral hz₀).1 hc
  have h2 := (mem_centralizer_iff_toral hz₀).1 hc'
  rw [toralCentralizer_torusA hζ] at h1 h2
  have := commutator_mem_of_mem_sup torus_comm
    (torusGroup_le_normalizer_rootPair (K := K) isRoot_g2δ) h1 h2
  simpa only [Subgroup.coe_mul, Subgroup.coe_inv] using this

theorem isSolvable_centralizer_of_torus3 {ζ : Kˣ} (hζ : orderOf ζ = 3)
    {E' : Subgroup ↥(adjointGroup .G2 K)} {z₀ z₁ : ↥(adjointGroup .G2 K)} (hz₀E : z₀ ∈ E')
    (hz₁E : z₁ ∈ E')
    (hz₀ : (z₀ : ModGL .G2 K) = rootDiagUnit .G2 (fun j => ζ ^ Tag.G2.cartan g2ia j))
    (hz₁ : (z₁ : ModGL .G2 K) = rootDiagUnit .G2 (Pi.mulSingle g2ir ζ)) :
    Group.IsSolvable ↥(Subgroup.centralizer (E' : Set ↥(adjointGroup .G2 K))) := by
  set C := Subgroup.centralizer (E' : Set ↥(adjointGroup .G2 K)) with hC
  have hζ2 : ζ ^ 2 ≠ 1 := by
    intro h
    have := orderOf_dvd_of_pow_eq_one h
    rw [hζ] at this
    norm_num at this
  have hkey : ∀ c ∈ C, ∀ c' ∈ C,
      ((c * c' * c⁻¹ * c'⁻¹ : ↥(adjointGroup .G2 K)) : ModGL .G2 K) ∈
        (rootDiagUnitHom .G2 K).range := by
    intro c hc c' hc'
    have hc0 : c ∈ Subgroup.centralizer ({z₀} : Set ↥(adjointGroup .G2 K)) :=
      Subgroup.centralizer_le (Set.singleton_subset_iff.2 hz₀E) hc
    have hc0' : c' ∈ Subgroup.centralizer ({z₀} : Set ↥(adjointGroup .G2 K)) :=
      Subgroup.centralizer_le (Set.singleton_subset_iff.2 hz₀E) hc'
    have hQ := coe_comm_mem_Qv hζ hz₀ hc0 hc0'
    rw [← range_rhoV] at hQ
    obtain ⟨M, hM⟩ := hQ
    have hwC : c * c' * c⁻¹ * c'⁻¹ ∈ C :=
      C.mul_mem (C.mul_mem (C.mul_mem hc hc') (C.inv_mem hc)) (C.inv_mem hc')
    have hw1 : z₁ * (c * c' * c⁻¹ * c'⁻¹) = (c * c' * c⁻¹ * c'⁻¹) * z₁ :=
      Subgroup.mem_centralizer_iff.1 hwC z₁ hz₁E
    have hw1' : rhoV K (HSL ζ) * rhoV K M = rhoV K M * rhoV K (HSL ζ) := by
      rw [rhoV_HSL, ← hz₁, hM]
      have := congrArg Subtype.val hw1
      simpa only [Subgroup.coe_mul] using this
    have hMc : M * HSL ζ = HSL ζ * M := by
      apply rhoV_injective
      rw [map_mul, map_mul]
      exact hw1'.symm
    obtain ⟨t, rfl⟩ := eq_HSL_of_comm_HSL hζ2 hMc
    exact ⟨Pi.mulSingle g2ir t, by rw [← hM, rhoV_HSL]; rfl⟩
  let ι : ↥C →* ModGL .G2 K := (adjointGroup .G2 K).subtype.comp C.subtype
  let T : Subgroup ↥C := (rootDiagUnitHom .G2 K).range.comap ι
  have hTcomm : ⁅T, T⁆ = ⊥ := by
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
    intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    obtain ⟨b, hb⟩ := hx
    obtain ⟨b', hb'⟩ := hy
    apply Subtype.ext
    apply Subtype.ext
    show ι y * ι x = ι x * ι y
    rw [← hb, ← hb', ← map_mul, ← map_mul, mul_comm]
  have hle : commutator ↥C ≤ T := by
    rw [commutator_def, Subgroup.commutator_le]
    intro g₁ _ g₂ _
    show ι ⁅g₁, g₂⁆ ∈ (rootDiagUnitHom .G2 K).range
    have := hkey g₁ g₁.2 g₂ g₂.2
    simpa [ι, commutatorElement_def] using this
  refine ⟨⟨2, ?_⟩⟩
  rw [show (2 : ℕ) = 1 + 1 from rfl, derivedSeries_succ, derivedSeries_one, eq_bot_iff, ← hTcomm]
  exact Subgroup.commutator_mono hle hle

theorem rhoV_mem_adjointGroup (M : SL2 K) : rhoV K M ∈ adjointGroup .G2 K := by
  have hM : rhoV K M ∈ (rhoV K).range := ⟨M, rfl⟩
  rw [range_rhoV] at hM
  exact sup_le (rootSubgroup_le_adjointGroup _) (rootSubgroup_le_adjointGroup _) hM

theorem nonempty_sl2_equiv_g2ShortSL2 : Nonempty (SL2 K ≃* ↥(g2ShortSL2 K)) := by
  let ρ : SL2 K →* ↥(adjointGroup .G2 K) := (rhoV K).codRestrict _ rhoV_mem_adjointGroup
  have hρ : Function.Injective ρ := fun a b h => rhoV_injective (congrArg Subtype.val h)
  have hr : ρ.range = g2ShortSL2 K := by
    ext x
    rw [mem_g2ShortSL2_iff]
    constructor
    · rintro ⟨M, rfl⟩
      exact ⟨M, rfl⟩
    · rintro ⟨M, hM⟩
      exact ⟨M, Subtype.ext hM⟩
  exact ⟨(MonoidHom.ofInjective hρ).trans (MulEquiv.subgroupCongr hr)⟩

theorem g2ShortSL2_le_centralizer {ζ : Kˣ} (hζ : orderOf ζ = 3) {z₀ : ↥(adjointGroup .G2 K)}
    (hz₀ : (z₀ : ModGL .G2 K) = rootDiagUnit .G2 (fun j => ζ ^ Tag.G2.cartan g2ia j)) :
    g2ShortSL2 K ≤ Subgroup.centralizer ({z₀} : Set ↥(adjointGroup .G2 K)) := by
  intro s hs
  have hs' : (s : ModGL .G2 K) ∈ rootSubgroup .G2 K g2δ ⊔ rootSubgroup .G2 K (-g2δ) := hs
  rw [mem_centralizer_iff_toral hz₀, toralCentralizer_torusA hζ]
