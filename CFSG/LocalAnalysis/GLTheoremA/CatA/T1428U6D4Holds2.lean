variable {K : Type} [Field K] [Finite K] [CharP K 2]

theorem t1428_mem_sup_of_central {α : MulAut (Om8 K)} (hα3 : α ^ 3 = 1)
    (hc : ∀ γ : MulAut (Om8 K), γ * α * γ⁻¹ * α⁻¹ ∈ Inn (Om8 K)) :
    α ∈ Inn (Om8 K) ⊔ (AutOm.fieldAutP (K := K) 4).range := by
  haveI : (Inn (Om8 K)).Normal := inner_normal _
  obtain ⟨ι, hι, k, c, hc', hαeq⟩ := exists_inner_mul_theta_pow_mul α
  have hρρ : AutOm.plusRefl (K := K) one_le_four * AutOm.plusRefl one_le_four = 1 :=
    AutOm.plusRefl_mul_self one_le_four
  have hρinv : (AutOm.plusRefl (K := K) one_le_four)⁻¹ = AutOm.plusRefl one_le_four :=
    inv_eq_of_mul_eq_one_right hρρ
  have hρc : AutOm.plusRefl (K := K) one_le_four * c = c * AutOm.plusRefl one_le_four := by
    obtain ⟨σ, rfl | rfl⟩ := hc'
    · exact AutOm.plusRefl_mul_fieldAutP one_le_four σ
    · rw [mul_assoc (AutOm.plusRefl one_le_four) (AutOm.fieldAutP 4 σ),
        ← AutOm.plusRefl_mul_fieldAutP one_le_four σ]
  have hρθ : AutOm.plusRefl (K := K) one_le_four * Triality.theta ^ k * (AutOm.plusRefl one_le_four)⁻¹ =
      (Triality.theta ^ k)⁻¹ := by
    rw [← conj_pow, hρinv, plusRefl_theta_plusRefl, inv_pow]
  have e2 : AutOm.plusRefl (K := K) one_le_four * c * (AutOm.plusRefl one_le_four)⁻¹ = c := by
    rw [hρc, mul_inv_cancel_right]
  have e1 : AutOm.plusRefl (K := K) one_le_four * α * (AutOm.plusRefl one_le_four)⁻¹ * α⁻¹ =
      (AutOm.plusRefl one_le_four * ι * (AutOm.plusRefl one_le_four)⁻¹) *
        (AutOm.plusRefl one_le_four * Triality.theta ^ k * (AutOm.plusRefl one_le_four)⁻¹) *
        (AutOm.plusRefl one_le_four * c * (AutOm.plusRefl one_le_four)⁻¹) * c⁻¹ * (Triality.theta ^ k)⁻¹ *
          ι⁻¹ := by
    rw [hαeq]
    group
  rw [hρθ, e2, mul_inv_cancel_right] at e1
  have hι' : AutOm.plusRefl (K := K) one_le_four * ι * (AutOm.plusRefl one_le_four)⁻¹ ∈
      Inn (Om8 K) := (inner_normal _).conj_mem ι hι _
  have h2 : (Triality.theta ^ k : MulAut (Om8 K))⁻¹ * (Triality.theta ^ k)⁻¹ ∈ Inn (Om8 K) := by
    have h3 : (Triality.theta ^ k : MulAut (Om8 K))⁻¹ * (Triality.theta ^ k)⁻¹ =
        (AutOm.plusRefl one_le_four * ι * (AutOm.plusRefl one_le_four)⁻¹)⁻¹ *
          (AutOm.plusRefl (K := K) one_le_four * α * (AutOm.plusRefl one_le_four)⁻¹ * α⁻¹) * ι := by
      rw [e1]
      group
    rw [h3]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ hι')
      (hc (AutOm.plusRefl one_le_four))) hι
  have hθ2 : (Triality.theta : MulAut (Om8 K)) ^ (2 * k) ∈ Inn (Om8 K) := by
    have h3 : ((Triality.theta ^ k : MulAut (Om8 K))⁻¹ * (Triality.theta ^ k)⁻¹)⁻¹ =
        Triality.theta ^ (2 * k) := by
      rw [mul_inv_rev, inv_inv, ← pow_add, show k + k = 2 * k by omega]
    rw [← h3]
    exact Subgroup.inv_mem _ h2
  have hθk : (Triality.theta : MulAut (Om8 K)) ^ k = 1 := by
    have h4 := (theta_pow_mul_mem_inner (K := K) (2 * k) (c := 1) (one_mem _)
      (by rw [mul_one]; exact hθ2)).1
    have hθ1 : (Triality.theta : MulAut (Om8 K)) ≠ 1 := fun h =>
      conjAct_ne_theta (K := K) 1 (by rw [map_one, h])
    have hθord : orderOf (Triality.theta : MulAut (Om8 K)) = 3 := orderOf_eq_prime theta_cube hθ1
    have h5 : 3 ∣ 2 * k := hθord ▸ orderOf_dvd_of_pow_eq_one h4
    have h6 : 3 ∣ k := by omega
    obtain ⟨j, rfl⟩ := h6
    rw [pow_mul, theta_cube, one_pow]
  rw [hθk, one_mul] at hαeq
  obtain ⟨σ, rfl | rfl⟩ := hc'
  · rw [hαeq]
    exact Subgroup.mul_mem_sup hι ⟨σ, rfl⟩
  · obtain ⟨γ, rfl⟩ := hι
    obtain ⟨γ', hγ'⟩ := conj_mul_cube (AutOm.plusRefl (K := K) one_le_four * AutOm.fieldAutP 4 σ) γ
    rw [← hαeq, hα3] at hγ'
    have hρφ : Commute (AutOm.plusRefl (K := K) one_le_four) (AutOm.fieldAutP 4 σ) :=
      AutOm.plusRefl_mul_fieldAutP one_le_four σ
    have hρ3 : (AutOm.plusRefl (K := K) one_le_four) ^ 3 = AutOm.plusRefl one_le_four := by
      rw [pow_succ, pow_two, hρρ, one_mul]
    have hx3 : (AutOm.plusRefl (K := K) one_le_four * AutOm.fieldAutP 4 σ) ^ 3 =
        AutOm.plusRefl one_le_four * AutOm.fieldAutP 4 (σ ^ 3) := by
      rw [hρφ.mul_pow, hρ3, map_pow]
    rw [hx3] at hγ'
    have hmem : AutOm.plusRefl (K := K) one_le_four * AutOm.fieldAutP 4 (σ ^ 3) ∈ Inn (Om8 K) := by
      have : AutOm.plusRefl (K := K) one_le_four * AutOm.fieldAutP 4 (σ ^ 3) = MulAut.conj γ'⁻¹ := by
        rw [map_inv]
        exact eq_inv_of_mul_eq_one_right hγ'.symm
      rw [this]
      exact ⟨_, rfl⟩
    have hbot : AutOm.plusRefl (K := K) one_le_four * AutOm.fieldAutP 4 (σ ^ 3) ∈
        Inn (Om8 K) ⊓ AutOm.plusCompl (K := K) one_le_four :=
      ⟨hmem, ⟨σ ^ 3, Or.inr rfl⟩⟩
    rw [AutOm.inner_inf_plusCompl (K := K) (n := 4) (by norm_num)] at hbot
    have h1' : AutOm.plusRefl (K := K) one_le_four * AutOm.fieldAutP 4 (σ ^ 3) = 1 := hbot
    have h2' : AutOm.plusRefl (K := K) one_le_four * AutOm.fieldAutP 4 σ =
        AutOm.fieldAutP 4 (σ⁻¹ ^ 2) := by
      have h3 : AutOm.plusRefl (K := K) one_le_four = (AutOm.fieldAutP 4 (σ ^ 3))⁻¹ :=
        eq_inv_of_mul_eq_one_left h1'
      rw [h3, ← map_inv, ← map_mul]
      congr 1
      group
    rw [hαeq, h2']
    exact Subgroup.mul_mem_sup ⟨γ, rfl⟩ ⟨σ⁻¹ ^ 2, rfl⟩

private theorem t1428_map_centralizer {A B : Type} [Group A] [Group B] (e : A ≃* B) (s : A) :
    (Subgroup.centralizer ({s} : Set A)).map (e : A →* B) =
      Subgroup.centralizer ({e s} : Set B) := by
  ext b
  simp only [Subgroup.mem_map, Subgroup.mem_centralizer_singleton_iff, MonoidHom.coe_coe]
  constructor
  · rintro ⟨a, ha, rfl⟩
    rw [← map_mul, ← map_mul, ha]
  · intro hb
    refine ⟨e.symm b, ?_, by simp⟩
    apply e.injective
    rw [map_mul, map_mul, e.apply_symm_apply]
    exact hb

private theorem t1428_map_congr {A B : Type} [Group A] [Group B] (e : A ≃* B) (α : MulAut A)
    (J : Subgroup A) :
    (J.map (e : A →* B)).map (MulAut.congr e α).toMonoidHom =
      (J.map α.toMonoidHom).map (e : A →* B) := by
  rw [Subgroup.map_map, Subgroup.map_map]
  congr 1
  ext a
  simp [MulAut.congr_apply]

theorem t1428_om8_map_eq (hpq : 3 ∣ Nat.card K + 1) {s : Om8 K} (hs : orderOf s = 3)
    {α : MulAut (Om8 K)} (hα3 : α ^ 3 = 1)
    (hα : α ∈ Inn (Om8 K) ⊔ (AutOm.fieldAutP (K := K) 4).range)
    (hαs : α * MulAut.conj s = MulAut.conj s * α) {J : Subgroup (Om8 K)}
    (hJ : CFSG.Open.IsComponentOf J (Subgroup.centralizer ({s} : Set (Om8 K)))) :
    J.map α.toMonoidHom = J := by
  obtain ⟨g, -, -, -, -, hg, -⟩ := CFSG.LocalAnalysis.GLTheoremA.D4YH.exists_pair_of_mem_sup hα
  have hd : 0 < 2 * 4 := by norm_num
  obtain ⟨hQ, hT⟩ := regular_coordinateQuadPlus 4 K (by norm_num)
  set E : Om8 K ≃* ProjOrthDerived (coordinateQuadPlus 4 K) :=
    projEquiv8.trans (coordBridge (coordinateQuadPlus 4 K) hd) with hE
  set ω : MulAut (ProjOrthDerived (coordinateQuadPlus 4 K)) := MulAut.congr E α with hωdef
  have himg : MulAut.congr (coordBridge (coordinateQuadPlus 4 K) hd).symm ω ∈
      matrixProjectiveImage (coordinateQuadPlus 4 K) := by
    have h1 : MulAut.congr (coordBridge (coordinateQuadPlus 4 K) hd).symm ω =
        MulAut.congr projEquiv8 α := by
      refine MulEquiv.ext fun y => ?_
      simp [hωdef, hE, MulAut.congr_apply]
    rw [h1, ← hg]
    exact congr_conjAct_mem_image g
  have hcomm : ω * MulAut.conj (E s) = MulAut.conj (E s) * ω := by
    rw [← CFSG.ComponentClassification.OuterAutomorphisms.congr_conj, hωdef, ← map_mul, ← map_mul,
      hαs]
  have hω3 : ω ^ 3 = 1 := by rw [hωdef, ← map_pow, hα3, map_one]
  have hEs : orderOf (E s) = 3 := by
    rw [MulEquiv.orderOf_eq]
    exact hs
  have hL : CFSG.Open.IsComponentOf (J.map (E : Om8 K →* ProjOrthDerived (coordinateQuadPlus 4 K)))
      (Subgroup.centralizer ({E s} : Set (ProjOrthDerived (coordinateQuadPlus 4 K)))) := by
    have := CFSG.SignalizerFunctorTheorem.TransportA.isComponentOf_map E hJ
    rwa [t1428_map_centralizer E s] at this
  have key := t1428_projOrth_map_eq hpq hd hQ hT hEs ω himg hcomm hω3 hL
  rw [hωdef, t1428_map_congr] at key
  exact Subgroup.map_injective E.injective key

end Om8

section Abstract

open CFSG.StandardType CFSG.StandardType.Triality
  CFSG.ComponentClassification.OuterAutomorphisms

theorem t1428_d4_map_eq {S : Type} [Group S] {K : Type} [Field K] [Finite K] [CharP K 2]
    (hpq : 3 ∣ Nat.card K + 1) (Φ : S ≃* Om8 K) {η β : MulAut S} (hηI : η ∈ Inn S)
    (hη3 : orderOf η = 3) (hβ3 : β ^ 3 = 1)
    (hβc : ∀ γ : MulAut S, γ * β * γ⁻¹ * β⁻¹ ∈ Inn S) (hβη : β * η = η * β)
    {J : Subgroup S}
    (hJ : CFSG.Open.IsComponentOf J (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup η)) :
    J.map β.toMonoidHom = J := by
  obtain ⟨u, rfl⟩ := hηI
  set α : MulAut (Om8 K) := MulAut.congr Φ β with hαdef
  have hα3 : α ^ 3 = 1 := by rw [hαdef, ← map_pow, hβ3, map_one]
  have hαc : ∀ γ : MulAut (Om8 K), γ * α * γ⁻¹ * α⁻¹ ∈ Inn (Om8 K) := by
    intro γ
    have h1 := hβc (MulAut.congr Φ.symm γ)
    have h2 := inner_map_congr Φ
    have hγ : MulAut.congr Φ (MulAut.congr Φ.symm γ) = γ :=
      MulEquiv.ext fun y => by simp [MulAut.congr_apply]
    have h3 : MulAut.congr Φ (MulAut.congr Φ.symm γ * β * (MulAut.congr Φ.symm γ)⁻¹ * β⁻¹) =
        γ * α * γ⁻¹ * α⁻¹ := by
      rw [map_mul, map_mul, map_mul, map_inv, map_inv, hγ]
    rw [← h3, ← h2]
    exact ⟨_, h1, rfl⟩
  have hαsup := t1428_mem_sup_of_central hα3 hαc
  have hconjinj : Function.Injective (MulAut.conj : Om8 K →* MulAut (Om8 K)) :=
    CFSG.LocalAnalysis.GLTheoremA.D4YF.conj_injective_om8'
  have hcongr : MulAut.congr Φ (MulAut.conj u) = MulAut.conj (Φ u) :=
    CFSG.ComponentClassification.OuterAutomorphisms.congr_conj Φ u
  have hs : orderOf (Φ u) = 3 := by
    rw [← orderOf_injective _ hconjinj, ← hcongr, MulEquiv.orderOf_eq]
    exact hη3
  have hαs : α * MulAut.conj (Φ u) = MulAut.conj (Φ u) * α := by
    rw [← hcongr, hαdef, ← map_mul, ← map_mul, hβη]
  have hJ' : CFSG.Open.IsComponentOf (J.map (Φ : S →* Om8 K))
      (Subgroup.centralizer ({Φ u} : Set (Om8 K))) := by
    have h1 := CFSG.SignalizerFunctorTheorem.TransportA.isComponentOf_map Φ hJ
    rwa [fixSubgroup_conj_eq_centralizer, t1428_map_centralizer Φ u] at h1
  have key := t1428_om8_map_eq hpq hs (α := α) hα3 hαsup hαs hJ'
  rw [hαdef, t1428_map_congr] at key
  exact Subgroup.map_injective Φ.injective key

end Abstract

end CFSG.LocalAnalysis.GLTheoremA.T1428

