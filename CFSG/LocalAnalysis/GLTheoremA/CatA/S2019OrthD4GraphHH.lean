theorem blockRepE_pow_eq_one {q : ℕ} [Fact q.Prime] [CharP K q] (hq5 : 5 ≤ q)
    (g : d4tData_valid.minGroup K)
    (hg3 : (((blockRep K g : V K ≃ₗ[K] V K) : V K →ₗ[K] V K) - 1) ^ 3 = 0) :
    blockRepE K g ^ q = 1 := by
