section Generic

variable {G : Type} [Group G]

theorem s2019FixCentralizes_of_isSimpleGroup (p : ℕ) (α : MulAut G) {J : Subgroup G}
    (hJC : J ≤ fixSubgroup α) (hcomm : ⁅fixSubgroup α, fixSubgroup α⁆ ≤ J)
    (hJs : IsSimpleGroup ↥J)
    (hJT : ∀ T : Subgroup G, IsPGroup 2 T → J ≤ Subgroup.normalizer (T : Set G) → ⁅T, J⁆ = ⊥) :
    S2019FixCentralizes p α := by
  intro L hL T hT2 hLT
  have hperf : ⁅L, L⁆ = L := CFSG.LocalAnalysis.GLTheoremB.glaPComponent_perfect hL
  have hLJ : L ≤ J := by
    rw [← hperf]
    exact (Subgroup.commutator_mono hL.1 hL.1).trans hcomm
  have hsn : IsSubnormal L J := by
    have h1 := hL.2.1.inf_of_le hJC
    rwa [inf_eq_left.2 hLJ] at h1
  rcases hsn.eq_bot_or_eq_of_isSimpleGroup hJs with h | h
  · rw [h, Subgroup.commutator_bot_right]
  · subst h
    exact hJT T hT2 hLT

end Generic

section HallHigman

variable {F V : Type*} [Field F] [Finite F] [AddCommGroup V] [Module F V] [FiniteDimensional F V]
  {q : ℕ} [hq : Fact q.Prime] [CharP F q]

theorem commutator_eq_bot_of_simple_sub_one_pow_lift {k : ℕ} (hk : k + 2 ≤ q) {S K : Type*}
    [Group S] [Group K] {J T : Subgroup S} (hJs : IsSimpleGroup ↥J)
    (hJT : J ≤ Subgroup.normalizer (T : Set S)) (hT : ∀ t ∈ T, ¬ q ∣ orderOf t)
    (π : K →* S) (hπ : Function.Surjective π) (hker : ∀ w ∈ π.ker, ¬ q ∣ orderOf w)
    (ρ : K →* LinearMap.GeneralLinearGroup F V) (hρ : Function.Injective ρ) {u : K}
    (huJ : π u ∈ J) (hu1 : π u ≠ 1) (huq : u ^ q = 1)
    (huk : (((ρ u : LinearMap.GeneralLinearGroup F V) : V →ₗ[F] V) - 1) ^ k = 0) :
    ⁅T, J⁆ = ⊥ := by
  classical
  set Tt : Subgroup (LinearMap.GeneralLinearGroup F V) := (T.comap π).map ρ with hTt
  have hTtq : ∀ g ∈ Tt, ¬ q ∣ orderOf g := by
    rintro _ ⟨w, hw, rfl⟩
    rw [orderOf_injective ρ hρ w]
    exact not_dvd_orderOf_of_mem_comap hT π hker hw
  have huN : π u ∈ Subgroup.normalizer (T : Set S) := hJT huJ
  have hnorm : ∀ g ∈ Tt, ρ u * g * (ρ u)⁻¹ ∈ Tt := by
    rintro _ ⟨w, hw, rfl⟩
    refine ⟨u * w * u⁻¹, ?_, by rw [map_mul, map_mul, map_inv]⟩
    change π (u * w * u⁻¹) ∈ T
    rw [map_mul, map_mul, map_inv]
    exact (Subgroup.mem_normalizer_iff.1 huN (π w)).1 hw
  have hcomm := commute_of_sub_one_pow_of_normalizes hk
    (by rw [← map_pow, huq, map_one]) huk hTtq hnorm
  have huC : π u ∈ Subgroup.centralizer (T : Set S) := by
    rw [Subgroup.mem_centralizer_iff]
    intro t ht
    obtain ⟨w, rfl⟩ := hπ t
    have h1 := hcomm (ρ w) ⟨w, ht, rfl⟩
    rw [← map_mul, ← map_mul] at h1
    rw [← map_mul, ← map_mul, hρ h1]
  set N : Subgroup ↥J := (Subgroup.centralizer (T : Set S)).subgroupOf J with hN
  have hNn : N.Normal := by
    refine ⟨fun n hn j => ?_⟩
    rw [Subgroup.mem_subgroupOf, Subgroup.mem_centralizer_iff] at hn ⊢
    intro t ht
    have hj : (j : S) ∈ Subgroup.normalizer (T : Set S) := hJT j.2
    have ht' : (j : S)⁻¹ * t * (j : S) ∈ T := by
      have := (Subgroup.mem_normalizer_iff.1 (Subgroup.inv_mem _ hj) t).1 ht
      simpa [mul_assoc] using this
    have h1 := hn _ ht'
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    calc t * ((j : S) * n * (j : S)⁻¹)
        = (j : S) * (((j : S)⁻¹ * t * (j : S)) * n) * (j : S)⁻¹ := by group
      _ = (j : S) * (n * ((j : S)⁻¹ * t * (j : S))) * (j : S)⁻¹ := by rw [h1]
      _ = (j : S) * n * (j : S)⁻¹ * t := by group
  haveI := hJs
  have hNtop : N = ⊤ := by
    haveI := hNn
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal N with h | h
    · exfalso
      have hmem : (⟨π u, huJ⟩ : ↥J) ∈ N := Subgroup.mem_subgroupOf.2 huC
      rw [h, Subgroup.mem_bot] at hmem
      exact hu1 (congrArg Subtype.val hmem)
    · exact h
  have hJC : J ≤ Subgroup.centralizer (T : Set S) := fun j hj => by
    have : (⟨j, hj⟩ : ↥J) ∈ N := hNtop ▸ Subgroup.mem_top _
    exact Subgroup.mem_subgroupOf.1 this
  rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
  exact Subgroup.le_centralizer_iff.1 hJC

end HallHigman

section Eichler

open CFSG.ClassicalGroups.Orthogonal QuadraticMap

private theorem add_pow_three_of_mul_eq_zero' {R : Type*} [Ring R] {a b : R} (hab : a * b = 0)
    (hba : b * a = 0) : (a + b) ^ 3 = a ^ 3 + b ^ 3 := by
  have h2 : (a + b) ^ 2 = a ^ 2 + b ^ 2 := by
    rw [pow_two, pow_two, pow_two, add_mul, mul_add, mul_add, hab, hba, add_zero, zero_add]
  have e1 : a ^ 2 * b = 0 := by rw [pow_two, mul_assoc, hab, mul_zero]
  have e2 : b ^ 2 * a = 0 := by rw [pow_two, mul_assoc, hba, mul_zero]
  rw [pow_succ, h2, add_mul, mul_add, mul_add, e1, e2, add_zero, zero_add, ← pow_succ,
    ← pow_succ]

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V] {Q : QuadraticForm K V}

theorem eichler_sub_one_apply {u w : V} (hu : Q u = 0) (hw : polar Q u w = 0) (x : V) :
    (((eichler Q u w : V ≃ₗ[K] V) : V →ₗ[K] V) - 1) x =
      polar Q x u • w - (polar Q x w + Q w * polar Q x u) • u := by
  rw [LinearMap.sub_apply, LinearEquiv.coe_coe, eichler_apply hu hw, Module.End.one_apply]
  abel

theorem eichler_sub_one_mul_eq_zero {u w u' w' : V} (hu : Q u = 0) (hw : polar Q u w = 0)
    (hu' : Q u' = 0) (hw' : polar Q u' w' = 0) (h1 : polar Q u' u = 0) (h2 : polar Q u' w = 0)
    (h3 : polar Q w' u = 0) (h4 : polar Q w' w = 0) :
    (((eichler Q u w : V ≃ₗ[K] V) : V →ₗ[K] V) - 1) *
      (((eichler Q u' w' : V ≃ₗ[K] V) : V →ₗ[K] V) - 1) = 0 := by
  have hu0 : (((eichler Q u w : V ≃ₗ[K] V) : V →ₗ[K] V) - 1) u' = 0 := by
    rw [eichler_sub_one_apply hu hw, h1, h2, zero_smul, mul_zero, add_zero, zero_smul, sub_zero]
  have hw0 : (((eichler Q u w : V ≃ₗ[K] V) : V →ₗ[K] V) - 1) w' = 0 := by
    rw [eichler_sub_one_apply hu hw, h3, h4, zero_smul, mul_zero, add_zero, zero_smul, sub_zero]
  refine LinearMap.ext fun x => ?_
  rw [Module.End.mul_apply, LinearMap.zero_apply, eichler_sub_one_apply hu' hw' x, map_sub,
    map_smul, map_smul, hu0, hw0, smul_zero, smul_zero, sub_zero]

theorem eichler_triple_sub_one_pow_three {u w₁ w₂ u' w' : V} (hu : Q u = 0)
    (hw₁ : polar Q u w₁ = 0) (hw₂ : polar Q u w₂ = 0) (hu' : Q u' = 0) (hw' : polar Q u' w' = 0)
    (h1 : polar Q u' u = 0) (h2 : polar Q u' w₁ = 0) (h3 : polar Q u' w₂ = 0)
    (h4 : polar Q w' u = 0) (h5 : polar Q w' w₁ = 0) (h6 : polar Q w' w₂ = 0) :
    ((((eichler Q u w₁ * eichler Q u' w' * eichler Q u w₂ : V ≃ₗ[K] V)) : V →ₗ[K] V) - 1) ^ 3 =
      0 := by
  have hw : polar Q u (w₁ + w₂) = 0 := by rw [polar_add_right, hw₁, hw₂, add_zero]
  have hu'' : polar Q u u' = 0 := by rw [polar_comm, h1]
  have huw' : polar Q u w' = 0 := by rw [polar_comm, h4]
  have h12 : polar Q u' (w₁ + w₂) = 0 := by rw [polar_add_right, h2, h3, add_zero]
  have h12' : polar Q w' (w₁ + w₂) = 0 := by rw [polar_add_right, h5, h6, add_zero]
  have hw12u' : polar Q (w₁ + w₂) u' = 0 := by rw [polar_comm, h12]
  have hw12w' : polar Q (w₁ + w₂) w' = 0 := by rw [polar_comm, h12']
  have hw₁u' : polar Q w₁ u' = 0 := by rw [polar_comm, h2]
  have hw₁w' : polar Q w₁ w' = 0 := by rw [polar_comm, h5]
  have hmul : ∀ f g : V ≃ₗ[K] V,
      ((f * g : V ≃ₗ[K] V) : V →ₗ[K] V) = (f : V →ₗ[K] V) * (g : V →ₗ[K] V) := fun _ _ => rfl
  set a₁ := ((eichler Q u w₁ : V ≃ₗ[K] V) : V →ₗ[K] V) - 1 with ha₁
  set a₂ := ((eichler Q u w₂ : V ≃ₗ[K] V) : V →ₗ[K] V) - 1 with ha₂
  set b := ((eichler Q u' w' : V ≃ₗ[K] V) : V →ₗ[K] V) - 1 with hb
  set A := ((eichler Q u (w₁ + w₂) : V ≃ₗ[K] V) : V →ₗ[K] V) - 1 with hA
  have hab₁ : a₁ * b = 0 := eichler_sub_one_mul_eq_zero hu hw₁ hu' hw' h1 h2 h4 h5
  have hba₂ : b * a₂ = 0 := eichler_sub_one_mul_eq_zero hu' hw' hu hw₂ hu'' huw'
    (by rw [polar_comm, h3]) (by rw [polar_comm, h6])
  have hAb : A * b = 0 := eichler_sub_one_mul_eq_zero hu hw hu' hw' h1 h12 h4 h12'
  have hbA : b * A = 0 := eichler_sub_one_mul_eq_zero hu' hw' hu hw hu'' huw' hw12u' hw12w'
  have e₁ : ((eichler Q u w₁ : V ≃ₗ[K] V) : V →ₗ[K] V) = a₁ + 1 := (sub_add_cancel _ _).symm
  have e₂ : ((eichler Q u w₂ : V ≃ₗ[K] V) : V →ₗ[K] V) = a₂ + 1 := (sub_add_cancel _ _).symm
  have e' : ((eichler Q u' w' : V ≃ₗ[K] V) : V →ₗ[K] V) = b + 1 := (sub_add_cancel _ _).symm
  have hP : ((eichler Q u w₁ * eichler Q u' w' * eichler Q u w₂ : V ≃ₗ[K] V) : V →ₗ[K] V) - 1 =
      A + b := by
    have hE : ((eichler Q u (w₁ + w₂) : V ≃ₗ[K] V) : V →ₗ[K] V) = (a₁ + 1) * (a₂ + 1) := by
      rw [← eichler_mul hw₁ hw₂, hmul, e₁, e₂]
    calc ((eichler Q u w₁ * eichler Q u' w' * eichler Q u w₂ : V ≃ₗ[K] V) : V →ₗ[K] V) - 1
        = (a₁ + 1) * (b + 1) * (a₂ + 1) - 1 := by rw [hmul, hmul, e₁, e₂, e']
      _ = a₁ * b * a₂ + a₁ * b + a₁ * a₂ + a₁ + b * a₂ + b + a₂ := by noncomm_ring
      _ = ((a₁ + 1) * (a₂ + 1) - 1) + b := by
          rw [hab₁, hba₂, zero_mul]
          noncomm_ring
      _ = A + b := by rw [hA, hE]
  rw [hP, add_pow_three_of_mul_eq_zero' hAb hbA, hA, hb, eichler_sub_one_pow_three hu hw,
    eichler_sub_one_pow_three hu' hw', add_zero]

end Eichler

section D4

open CFSG.Blueprint.Chevalley CFSG.HardMathSupport.Lang.Coordinator.D4Bridge
  CFSG.ClassicalGroups.Orthogonal CFSG.LieType.Universal.Spin CFSG.TauCetiBridge.Twisted
  QuadraticMap


variable {K : Type} [Field K] [Finite K]

theorem sq_eq_one_of_theta_eq_one {w : elementaryGroup (quadPlus 4 K)} (hw : theta K w = 1) :
    w ^ 2 = 1 := by
  set m := (omegaEquiv K).symm w with hm
  have hmw : omegaEquiv K m = w := MulEquiv.apply_symm_apply _ w
  have hmk : m ∈ (thetaOmega K).ker := by
    rw [MonoidHom.mem_ker]
    change theta K (omegaEquiv K m) = 1
    rw [hmw, hw]
  rw [CFSG.HardMathSupport.Dickson.Bal207.D4Graph.ker_thetaOmega] at hmk
  have hsc : toLinEquiv (Fin 4 ⊕ Fin 4) K (m : GL (Fin 4 ⊕ Fin 4) K) ∈ scalars K (V K) :=
    (mem_statedScalars_iff _).1 (Subgroup.mem_subgroupOf.1 hmk)
  have hwv : (w : V K ≃ₗ[K] V K) = toLinEquiv (Fin 4 ⊕ Fin 4) K (m : GL (Fin 4 ⊕ Fin 4) K) := by
    rw [← hmw]
    rfl
  obtain ⟨c, hc⟩ := mem_scalars.mp hsc
  set a : V K := Pi.single (Sum.inl 0) 1 + Pi.single (Sum.inr 0) 1 with ha
  have hQa : quadPlus 4 K a = 1 := by
    rw [quadPlus_apply]
    simp [ha, Fin.sum_univ_four, Pi.single_apply]
  have hO : (w : V K ≃ₗ[K] V K) ∈ TauCeti.QuadraticMap.orthogonalGroup (quadPlus 4 K) :=
    elementaryGroup_le_orthogonalGroup _ w.2
  have hQ := TauCeti.QuadraticMap.mem_orthogonalGroup_iff.mp hO a
  rw [hwv, hc, QuadraticMap.map_smul, hQa, smul_eq_mul, mul_one] at hQ
  apply Subtype.ext
  apply LinearEquiv.ext
  intro v
