      exact zero_ne_one hσ₁
    · rintro rfl
      rw [zero_mul] at hε₁
      exact zero_ne_one hε₁
  have hg3 : (((blockRep K g : V K ≃ₗ[K] V K) : V K →ₗ[K] V K) - 1) ^ 3 = 0 := by
    rw [hbr]
    have hp : ∀ {x y : Coord}, cIdx x ≠ cIdx y → ∀ a b : K,
        polar (quadPlus 4 K) (a • Pi.single x 1) (b • Pi.single y 1) = 0 :=
      fun h a b => polar_smul_single_eq_zero h a b
    exact eichler_triple_sub_one_pow_three
      (CFSG.HardMathSupport.Lang.Coordinator.D4Bridge.quadPlus_single _)
      (by simpa using hp (by decide : cIdx (Sum.inl 0 : Coord) ≠ cIdx (Sum.inr 3)) 1 s₁)
      (by simpa using hp (by decide : cIdx (Sum.inl 0 : Coord) ≠ cIdx (Sum.inl 3)) 1 s₂)
      (CFSG.HardMathSupport.Lang.Coordinator.D4Bridge.quadPlus_single _)
      (by simpa using hp (by decide : cIdx (Sum.inl 1 : Coord) ≠ cIdx (Sum.inl 2)) 1 s₃)
      (by simpa using hp (by decide : cIdx (Sum.inl 1 : Coord) ≠ cIdx (Sum.inl 0)) 1 1)
      (by simpa using hp (by decide : cIdx (Sum.inl 1 : Coord) ≠ cIdx (Sum.inr 3)) 1 s₁)
      (by simpa using hp (by decide : cIdx (Sum.inl 1 : Coord) ≠ cIdx (Sum.inl 3)) 1 s₂)
      (by simpa using hp (by decide : cIdx (Sum.inl 2 : Coord) ≠ cIdx (Sum.inl 0)) s₃ 1)
      (hp (by decide : cIdx (Sum.inl 2 : Coord) ≠ cIdx (Sum.inr 3)) s₃ s₁)
      (hp (by decide : cIdx (Sum.inl 2 : Coord) ≠ cIdx (Sum.inl 3)) s₃ s₂)
  have hg1 : blockRep K g ≠ 1 := by
    rw [hbr]
    exact frame_eichler_ne_one hs₁0
  have hgX : adjRep K g ∈ X := by
    rw [hgu]
    exact A2Nonsplit.gammaP_frameDiag B (uSL 1)
  have hgq : adjRep K g ^ ringChar K = 1 := adjRep_pow_eq_one hq5 g hg3
  have hord : orderOf (⟨adjRep K g, hgX⟩ : ↥X) ∣ ringChar K :=
    orderOf_dvd_of_pow_eq_one (Subtype.ext (by simpa using hgq))
  have hcop : Nat.Coprime 3 (orderOf (⟨adjRep K g, hgX⟩ : ↥X)) :=
    Nat.Coprime.coprime_dvd_right hord ((Nat.coprime_primes Nat.prime_three hpr).2 (Ne.symm hK3))
  have hgJ : adjRep K g ∈ J := ⟨_, hJmem _ hcop, rfl⟩
  exact commutator_eq_bot_of_blockRep_cube hq5 hJs hJT hT g hgJ hg1 hg3

