  have hmul : ∀ (f : V K ≃ₗ[K] V K) (n : ℕ),
      ((f ^ n : V K ≃ₗ[K] V K) : V K →ₗ[K] V K) = (f : V K →ₗ[K] V K) ^ n := by
    intro f n
    induction n with
    | zero => rfl
    | succ n ih => rw [pow_succ, pow_succ, ← ih]; rfl
  rw [Subgroup.coe_pow, hmul, coe_blockRepE, Subgroup.coe_one]
  exact CFSG.SignalizerFunctorTheorem.CatalogBridge.pow_eq_one_of_sub_one_pow_eq_zero (K := K)
    (by rw [show q - 1 = 3 + (q - 4) by omega, pow_add, hg3, zero_mul])

theorem adjRep_pow_eq_one {q : ℕ} [Fact q.Prime] [CharP K q] (hq5 : 5 ≤ q)
