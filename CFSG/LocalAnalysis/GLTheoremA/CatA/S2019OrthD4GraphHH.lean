private theorem isSimpleGroup_commutator_of_isPGLPiThree {X : Type} [Group X] {q : ℕ}
    (hq5 : 5 ≤ q)
    (hC : CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.OuterHigh3.IsPGLPiThree X q) :
    IsSimpleGroup ↥(commutator X) ∧ ∀ z : X, Nat.Coprime 3 (orderOf z) → z ∈ commutator X := by
  obtain ⟨π, p, f, F, _, hF, hpq, -, ⟨e⟩⟩ := hC
  subst hpq
  have := hF.finite
  have hq2 : 2 < p ^ f := by omega
  have hπ : π = false → CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData p f F :=
    fun h => by subst h; exact hF.unitary
  have hSP : projImage (Sec4.slPi π 3 (p ^ f) F) ≤ projImage (Sec4.glPi π 3 (p ^ f) F) :=
    Subgroup.map_mono (Sec4.slPi_le_glPi hπ)
  have hcomm : (commutator X).map e.toMonoidHom =
      (projImage (Sec4.slPi π 3 (p ^ f) F)).subgroupOf (projImage (Sec4.glPi π 3 (p ^ f) F)) := by
    rw [← Sec13.commutator_projImage_glPi hF hq2, commutator_def, commutator_def,
      Subgroup.map_commutator, ← MonoidHom.range_eq_map, MonoidHom.range_eq_top.2 e.surjective]
  refine ⟨?_, fun z hz => ?_⟩
  · haveI := Sec4.RonanK429Lie.isSimpleGroup_projImage_slPi hF (Or.inr hq2)
    exact (((commutator X).equivMapOfInjective e.toMonoidHom e.injective).trans
      ((MulEquiv.subgroupCongr hcomm).trans (Subgroup.subgroupOfEquivOfLe hSP))).isSimpleGroup
  · obtain ⟨m, hm⟩ := exists_pow_eq_self_of_coprime hz
    have h3 : e z ^ 3 ∈
        (projImage (Sec4.slPi π 3 (p ^ f) F)).subgroupOf (projImage (Sec4.glPi π 3 (p ^ f) F)) := by
      rw [Subgroup.mem_subgroupOf, Subgroup.coe_pow]
      exact Sec4.RonanK429Lie.pow_three_mem_projImage_slPi hF (e z).2
    have hez : e z ∈ (commutator X).map e.toMonoidHom := by
      rw [hcomm, ← hm, map_pow, map_pow]
      exact Subgroup.pow_mem _ h3 m
    obtain ⟨y, hy, hyz⟩ := hez
    rwa [← e.injective hyz]

