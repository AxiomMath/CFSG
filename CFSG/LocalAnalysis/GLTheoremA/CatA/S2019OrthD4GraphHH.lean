theorem s2019FixCentralizes_gammaP [Finite K] (hK2 : ringChar K ≠ 2) (hK3 : ringChar K ≠ 3)
    {B : SL2 K} (hB3 : B ^ 3 = 1) (hB1 : B ≠ 1) : S2019FixCentralizes 3 (gammaP K B) := by
  classical
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨n, hpr, hn⟩ := FiniteField.card K (ringChar K)
  haveI : Fact (ringChar K).Prime := ⟨hpr⟩
  have hq5 : 5 ≤ ringChar K := hpr.five_le_of_ne_two_of_ne_three hK2 hK3
  have hK5 : 5 ≤ Nat.card K := by
    rw [Nat.card_eq_fintype_card, hn]
    calc 5 ≤ ringChar K := hq5
      _ = ringChar K ^ 1 := (pow_one _).symm
      _ ≤ ringChar K ^ (n : ℕ) := Nat.pow_le_pow_right hpr.pos n.pos
  set X := fixSubgroup (gammaP K B) with hX
  have hXf : X = CFSG.RankThree.PartOne.CTP.fixedSubgroup (gammaP K B) :=
    Subgroup.ext fun _ => Iff.rfl
  have hC : CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.OuterHigh3.IsPGLPiThree ↥X
      (Nat.card K) := by
    rw [hXf]
    exact CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.OuterHighD4Odd.d4GraphA2FixIsoOdd_holds
      K hK2 hK3 hK5 B hB3 hB1
  obtain ⟨hJs', hJmem⟩ := isSimpleGroup_commutator_of_isPGLPiThree hK5 hC
  set J := (commutator ↥X).map X.subtype with hJ
  have hJs : IsSimpleGroup ↥J := by
    haveI := hJs'
    exact (Subgroup.equivMapOfInjective (commutator ↥X) X.subtype
      X.subtype_injective).symm.isSimpleGroup
  have hXX : ⁅X, X⁆ = J := by
    rw [hJ, commutator_def, Subgroup.map_commutator, ← MonoidHom.range_eq_map,
      Subgroup.range_subtype]
  refine s2019FixCentralizes_of_isSimpleGroup 3 (gammaP K B) (J := J)
    (Subgroup.map_subtype_le _) hXX.le hJs ?_
  intro T hT hJT
  obtain ⟨ε₁, hε₁, hk₁⟩ := (A2Nonsplit.isFrameHom_frameK₁ (K := K)).1
  obtain ⟨ε₃, hε₃, hk₃⟩ := (A2Nonsplit.isFrameHom_frameK₃ (K := K)).1
  obtain ⟨ε₂, hε₂, hk₂⟩ := (A2Nonsplit.isFrameHom_frameK₂ (K := K)).1
  obtain ⟨σ₁, hσ₁, hx₁⟩ := exists_adjRep_xm_fβ₁ (K := K)
  obtain ⟨σ₃, hσ₃, hx₃⟩ := exists_adjRep_xm_fβ₃ (K := K)
  obtain ⟨σ₂, hσ₂, hx₂⟩ := exists_adjRep_xm_fβ₂ (K := K)
  set g := d4tData_valid.xm K A2Nonsplit.fβ₁ (σ₁ * ε₁) *
    d4tData_valid.xm K A2Nonsplit.fβ₃ (σ₃ * ε₃) *
      d4tData_valid.xm K A2Nonsplit.fβ₂ (σ₂ * ε₂) with hg
  have hgu : adjRep K g = A2Nonsplit.frameDiag (uSL (1 : K)) := by
    have e : ∀ σ ε : K, σ * σ = 1 → σ * (σ * ε) = ε * 1 := fun σ ε h => by
      rw [← mul_assoc, h, one_mul, mul_one]
    rw [hg, map_mul, map_mul, hx₁, hx₃, hx₂, A2Nonsplit.frameDiag, hk₁, hk₃, hk₂, e σ₁ ε₁ hσ₁,
      e σ₃ ε₃ hσ₃, e σ₂ ε₂ hσ₂]
  have hr12 : Tag.D4.rootCertificate.root ((12 : Fin 24) : ℕ) = A2Nonsplit.fβ₁ := by
    decide +kernel
  have hr15 : Tag.D4.rootCertificate.root ((15 : Fin 24) : ℕ) = A2Nonsplit.fβ₃ := by
    decide +kernel
  have hr13 : Tag.D4.rootCertificate.root ((13 : Fin 24) : ℕ) = A2Nonsplit.fβ₂ := by
    decide +kernel
  set s₁ : K := ((-1 : ℤ) : K) * (σ₁ * ε₁) with hs₁
  set s₃ : K := ((-1 : ℤ) : K) * (σ₃ * ε₃) with hs₃
  set s₂ : K := ((-1 : ℤ) : K) * (σ₂ * ε₂) with hs₂
  have hbr : blockRep K g =
      eichler (quadPlus 4 K) (Pi.single (Sum.inl 0) 1) (s₁ • Pi.single (Sum.inr 3) 1) *
        eichler (quadPlus 4 K) (Pi.single (Sum.inl 1) 1) (s₃ • Pi.single (Sum.inl 2) 1) *
