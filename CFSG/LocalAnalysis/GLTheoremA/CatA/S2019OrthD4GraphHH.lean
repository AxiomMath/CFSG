    adjRep K g ^ q = 1 := by
  rw [← theta_blockRepE, ← map_pow, blockRepE_pow_eq_one hq5 g hg3, map_one]

theorem commutator_eq_bot_of_blockRep_cube {q : ℕ} [Fact q.Prime] [CharP K q] (hq5 : 5 ≤ q)
    {J T : Subgroup (adjointGroup Tag.D4 K)} (hJs : IsSimpleGroup ↥J)
    (hJT : J ≤ Subgroup.normalizer (T : Set (adjointGroup Tag.D4 K))) (hT : IsPGroup 2 T)
    (g : d4tData_valid.minGroup K) (hgJ : adjRep K g ∈ J) (hg1 : blockRep K g ≠ 1)
    (hg3 : (((blockRep K g : V K ≃ₗ[K] V K) : V K →ₗ[K] V K) - 1) ^ 3 = 0) :
    ⁅T, J⁆ = ⊥ := by
  have hqp : q.Prime := Fact.out
  have hq2 : q ≠ 2 := by omega
  set ρ : elementaryGroup (quadPlus 4 K) →* LinearMap.GeneralLinearGroup K (V K) :=
    (LinearMap.GeneralLinearGroup.generalLinearEquiv K (V K)).symm.toMonoidHom.comp
      (elementaryGroup (quadPlus 4 K)).subtype with hρdef
  have hρ : Function.Injective ρ :=
    (LinearMap.GeneralLinearGroup.generalLinearEquiv K (V K)).symm.injective.comp
      (elementaryGroup (quadPlus 4 K)).subtype_injective
  set u := blockRepE K g with hu
  have hρu : ((ρ u : LinearMap.GeneralLinearGroup K (V K)) : V K →ₗ[K] V K) =
      ((blockRep K g : V K ≃ₗ[K] V K) : V K →ₗ[K] V K) := by
    rw [← coe_blockRepE]
    rfl
  have hπu : theta K u = adjRep K g := theta_blockRepE K g
  have hker : ∀ w ∈ (theta K).ker, ¬ q ∣ orderOf w := fun w hw hdvd => by
    have hw2 := sq_eq_one_of_theta_eq_one (MonoidHom.mem_ker.1 hw)
    have h1 : q ∣ 2 := hdvd.trans (orderOf_dvd_of_pow_eq_one hw2)
    exact hq2 ((Nat.prime_dvd_prime_iff_eq hqp Nat.prime_two).1 h1)
  have hT' : ∀ t ∈ T, ¬ q ∣ orderOf t := by
    intro t ht hdvd
    obtain ⟨j, hj⟩ := hT ⟨t, ht⟩
    have h1 : orderOf t ∣ 2 ^ j := by
      apply orderOf_dvd_of_pow_eq_one
      have := congrArg Subtype.val hj
      simpa using this
    exact hq2 ((Nat.prime_dvd_prime_iff_eq hqp Nat.prime_two).1
      (hqp.dvd_of_dvd_pow (hdvd.trans h1)))
  have huq : u ^ q = 1 := blockRepE_pow_eq_one hq5 g hg3
  have hu1 : theta K u ≠ 1 := by
    intro h
    have hdvd : orderOf u ∣ q := orderOf_dvd_of_pow_eq_one huq
    rcases (Nat.dvd_prime hqp).1 hdvd with h1 | h1
    · apply hg1
      rw [← coe_blockRepE, ← hu, orderOf_eq_one_iff.1 h1]
      rfl
    · exact hker u (MonoidHom.mem_ker.2 h) (by rw [h1])
  exact commutator_eq_bot_of_simple_sub_one_pow_lift (k := 3) (by omega) hJs hJT hT' (theta K)
    (theta_surjective K) hker ρ hρ (by rw [hπu]; exact hgJ) hu1 huq (by rw [hρu]; exact hg3)

