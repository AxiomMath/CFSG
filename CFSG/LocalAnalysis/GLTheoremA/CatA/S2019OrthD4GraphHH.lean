    eichler_single_apply (by decide : cIdx (Sum.inl 0 : Coord) ≠ cIdx (Sum.inl 3))] at key
  simp [Pi.single_apply, dualC] at key
  exact hs₁ key

theorem s2019FixCentralizes_d4Graph_one [Finite K] (hK2 : ringChar K ≠ 2) (hK3 : ringChar K ≠ 3) :
    S2019FixCentralizes 3 (d4Graph K 1) := by
  classical
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨n, hpr, hn⟩ := FiniteField.card K (ringChar K)
  haveI : Fact (ringChar K).Prime := ⟨hpr⟩
  have hq5 : 5 ≤ ringChar K := hpr.five_le_of_ne_two_of_ne_three hK2 hK3
  have hK3' : 3 ≤ Nat.card K := by
    rw [Nat.card_eq_fintype_card, hn]
    calc 3 ≤ ringChar K := by omega
      _ = ringChar K ^ 1 := (pow_one _).symm
      _ ≤ ringChar K ^ (n : ℕ) := Nat.pow_le_pow_right hpr.pos n.pos
  have hsimple : IsSimpleGroup ↥(fixSubgroup (d4Graph K 1)) := by
    have hqs :=
      CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.isQuasisimple_fixSubgroup_d4Graph_one
        (K := K) hK3'
    set e := CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.fixSubgroupEquivG2 K hK3'
    have hZ : Subgroup.center ↥(fixSubgroup (d4Graph K 1)) = ⊥ := by
      rw [eq_bot_iff]
      intro z hz
      have hz' : e z ∈ Subgroup.center ↥(adjointGroup Tag.G2 K) := by
        rw [Subgroup.mem_center_iff] at hz ⊢
        intro y
        obtain ⟨x, rfl⟩ := e.surjective y
        rw [← map_mul, ← map_mul, hz x]
      rw [center_adjointGroup_eq_bot, Subgroup.mem_bot] at hz'
      rw [Subgroup.mem_bot]
      exact e.injective (by rw [hz', map_one])
    haveI : IsSimpleGroup (↥(fixSubgroup (d4Graph K 1)) ⧸
        Subgroup.center ↥(fixSubgroup (d4Graph K 1))) := hqs.2.1
    exact ((QuotientGroup.quotientMulEquivOfEq hZ).trans
      QuotientGroup.quotientBot).symm.isSimpleGroup
  refine s2019FixCentralizes_of_isSimpleGroup 3 (d4Graph K 1) le_rfl ?_ hsimple ?_
  · rw [Subgroup.commutator_le]
    intro a ha b hb
    rw [commutatorElement_def]
    exact mul_mem (mul_mem (mul_mem ha hb) (inv_mem ha)) (inv_mem hb)
  · intro T hT hJT
    have hroot : Tag.D4.rootCertificate.root ((2 : Fin 24) : ℕ) =
        Pi.single (⟨2, by decide⟩ : Fin Tag.D4.rank) 1 := by decide +kernel
    have hbr := blockRep_xm_of_root (K := K) 2 hroot 1
    have hc : (rS 2 : ℤ) = -1 := rfl
    refine commutator_eq_bot_of_blockRep_cube hq5 hsimple hJT hT
      (d4tData_valid.xm K (Pi.single ⟨2, by decide⟩ 1) 1) ?_ ?_ ?_
    · rw [adjRep_xm_single]
      exact (d4Graph_one_xPar_two (K := K) 1).1
    · rw [hbr]
      exact eichler_single_ne_one (by decide) (by rw [hc]; norm_num)
    · rw [hbr]
      exact eichler_single_sub_one_pow_three (by decide) _

