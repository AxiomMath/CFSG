variable {ℓ f : ℕ} {K : Type} [Field K]

theorem idForm_mulVec_of_mem_primeFormUnitary {h : UnitaryFieldData ℓ f K} {n : ℕ}
    {g : GL (Fin n) K} (hg : g ∈ primeFormUnitary h (idGram K n)) (v w : Fin n → K) :
    idForm h n ((g : Matrix (Fin n) (Fin n) K) *ᵥ v) ((g : Matrix (Fin n) (Fin n) K) *ᵥ w) =
      idForm h n v w :=
  (mem_sesqUnitaryGroup.mp (toLinU_mem ⟨g, hg⟩)) v w

theorem inv_mul_mul_mem_of_pow_three {G : Type*} [Group G] {T : Subgroup G} {D : G}
    (hD3 : D ^ 3 = 1) (hN : ∀ t ∈ T, D * t * D⁻¹ ∈ T) {t : G} (ht : t ∈ T) :
    D⁻¹ * t * D ∈ T := by
  have h1 : D * D = D⁻¹ := eq_inv_of_mul_eq_one_left (by rw [← pow_three', hD3])
  have h2 : D⁻¹ * D⁻¹ = D := by rw [← _root_.mul_inv_rev, h1, inv_inv]
  have e : D * (D * t * D⁻¹) * D⁻¹ = D⁻¹ * t * D := by
    calc D * (D * t * D⁻¹) * D⁻¹ = (D * D) * t * (D⁻¹ * D⁻¹) := by group
      _ = D⁻¹ * t * D := by rw [h1, h2]
  rw [← e]
  exact hN _ (hN t ht)

private theorem one_add_add_sq_eq_zero [CharP K 2] {x : K} (hx3 : x ^ 3 = 1) (hx1 : x ≠ 1) :
    1 + x + x ^ 2 = 0 := by
  have : (x - 1) * (1 + x + x ^ 2) = 0 := by linear_combination hx3
  exact (mul_eq_zero.1 this).resolve_left (sub_ne_zero.2 hx1)

theorem exists_eq_weight_of_isPGroup (h : UnitaryFieldData ℓ f K) [CharP K 2] {n : ℕ}
    {T : Subgroup (GL (Fin n) K)} (hT2 : IsPGroup 2 T) (hT : T ≠ ⊥)
    (hTU : T ≤ primeFormUnitary h (idGram K n)) {D₁ D₂ : GL (Fin n) K}
    (hD₁U : D₁ ∈ primeFormUnitary h (idGram K n)) (hD₂U : D₂ ∈ primeFormUnitary h (idGram K n))
    {d₁ d₂ : Fin n → K} (hD₁ : (D₁ : Matrix (Fin n) (Fin n) K) = diagonal d₁)
    (hD₂ : (D₂ : Matrix (Fin n) (Fin n) K) = diagonal d₂) (hd₁ : ∀ i, d₁ i ^ 3 = 1)
    (hd₂ : ∀ i, d₂ i ^ 3 = 1) (hN₁ : ∀ t ∈ T, D₁ * t * D₁⁻¹ ∈ T)
    (hN₂ : ∀ t ∈ T, D₂ * t * D₂⁻¹ ∈ T) :
    ∃ i j, i ≠ j ∧ d₁ i = d₁ j ∧ d₂ i = d₂ j := by
  classical
  have := h.finite
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
  set Fx : Set (Fin n → K) :=
    {w | ∀ t ∈ T, ((t : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ w = w} with hFx
  set Wp : Submodule K (Fin n → K) := ⨅ (w : Fin n → K) (_ : w ∈ Fx), LinearMap.ker (idForm h n w)
    with hWp
  have hmemWp : ∀ v, v ∈ Wp ↔ ∀ w ∈ Fx, idForm h n w v = 0 := by
    intro v
    simp only [hWp, Submodule.mem_iInf, LinearMap.mem_ker]
  have hTWp : ∀ t ∈ T, ∀ v ∈ Wp, ((t : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ v ∈ Wp := by
    intro t ht v hv
    rw [hmemWp] at hv ⊢
    intro w hw
    have e := idForm_mulVec_of_mem_primeFormUnitary (hTU ht) w v
    rw [show ((t : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ w = w from hw t ht] at e
    rw [e]
    exact hv w hw
  obtain ⟨v₀, hv₀0, hv₀F, hv₀W⟩ : ∃ v : Fin n → K, v ≠ 0 ∧ v ∈ Fx ∧ v ∈ Wp := by
    by_contra hcon
    push Not at hcon
    letI act : MulAction T Wp :=
      { smul := fun t v => ⟨((t : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ (v : Fin n → K),
          hTWp t t.2 v v.2⟩
        one_smul := fun v => Subtype.ext (show (((1 : T) : GL (Fin n) K) :
            Matrix (Fin n) (Fin n) K) *ᵥ (v : Fin n → K) = v by
          rw [Subgroup.coe_one, Units.val_one, Matrix.one_mulVec])
        mul_smul := fun s t v => Subtype.ext (show (((s * t : T) : GL (Fin n) K) :
            Matrix (Fin n) (Fin n) K) *ᵥ (v : Fin n → K) = ((s : GL (Fin n) K) :
            Matrix (Fin n) (Fin n) K) *ᵥ (((t : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ
            (v : Fin n → K)) by
          rw [Matrix.mulVec_mulVec, Subgroup.coe_mul, Units.val_mul]) }
    have hWp0 : ∀ v ∈ Wp, v = 0 := by
      intro v hv
      by_contra hv0
      have hmod := hT2.card_modEq_card_fixedPoints Wp
      have h2W : 2 ∣ Nat.card Wp := by
        have hx : (⟨v, hv⟩ : Wp) ≠ 0 := fun h0 => hv0 (congrArg Subtype.val h0)
        have h2x : 2 • (⟨v, hv⟩ : Wp) = 0 := by
          rw [two_nsmul, ← two_smul K, h2, zero_smul]
        rw [← addOrderOf_eq_prime h2x hx]
        exact addOrderOf_dvd_natCard _
      have hfix1 : Nat.card (MulAction.fixedPoints T Wp) = 1 := by
        rw [Nat.card_eq_one_iff_exists]
        refine ⟨⟨0, fun t => Subtype.ext (show (((t : T) : GL (Fin n) K) :
          Matrix (Fin n) (Fin n) K) *ᵥ (0 : Fin n → K) = 0 from Matrix.mulVec_zero _)⟩,
          fun y => ?_⟩
        apply Subtype.ext
        apply Subtype.ext
        by_contra hy0
        have hyF : ((y : Wp) : Fin n → K) ∈ Fx := fun t ht =>
          congrArg Subtype.val (y.2 ⟨t, ht⟩)
        exact hcon _ hy0 hyF (y : Wp).2
      rw [hfix1] at hmod
      unfold Nat.ModEq at hmod
      omega
    apply hT
    rw [eq_bot_iff]
    intro t ht
    rw [Subgroup.mem_bot]
    apply Units.ext
    rw [Units.val_one]
    refine Matrix.ext_iff_mulVec.2 fun v => ?_
    rw [Matrix.one_mulVec]
    have hmem : ((t : Matrix (Fin n) (Fin n) K) *ᵥ v - v) ∈ Wp := by
      rw [hmemWp]
      intro w hw
      rw [map_sub]
      have e := idForm_mulVec_of_mem_primeFormUnitary (hTU ht) w v
      rw [show (t : Matrix (Fin n) (Fin n) K) *ᵥ w = w from hw t ht] at e
      rw [e, sub_self]
    exact sub_eq_zero.1 (hWp0 _ hmem)
  have hFxadd : ∀ v w, v ∈ Fx → w ∈ Fx → v + w ∈ Fx := fun v w hv hw t ht => by
    rw [Matrix.mulVec_add, hv t ht, hw t ht]
  have hFxsmul : ∀ (c : K) v, v ∈ Fx → c • v ∈ Fx := fun c v hv t ht => by
    rw [Matrix.mulVec_smul, hv t ht]
  have hFxD : ∀ {D : GL (Fin n) K}, (∀ t ∈ T, D⁻¹ * t * D ∈ T) →
      ∀ v ∈ Fx, (D : Matrix (Fin n) (Fin n) K) *ᵥ v ∈ Fx := by
    intro D hN' v hv t ht
    have e : (t : Matrix (Fin n) (Fin n) K) * (D : Matrix (Fin n) (Fin n) K) =
        (D : Matrix (Fin n) (Fin n) K) * ((D⁻¹ * t * D : GL (Fin n) K) :
          Matrix (Fin n) (Fin n) K) := by
      rw [← Units.val_mul, ← Units.val_mul]
      congr 1
      group
    rw [Matrix.mulVec_mulVec, e, ← Matrix.mulVec_mulVec,
      show ((D⁻¹ * t * D : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ v = v from
        hv _ (hN' t ht)]
  have hWpD : ∀ {D : GL (Fin n) K}, D ∈ primeFormUnitary h (idGram K n) →
      (∀ t ∈ T, D * t * D⁻¹ ∈ T) → ∀ v ∈ Wp, (D : Matrix (Fin n) (Fin n) K) *ᵥ v ∈ Wp := by
    intro D hDU hN v hv
    rw [hmemWp] at hv ⊢
    intro w hw
    have hw' : ((D⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ w ∈ Fx :=
      hFxD (D := D⁻¹) (fun t ht => by rw [inv_inv]; exact hN t ht) w hw
    have e1 : (D : Matrix (Fin n) (Fin n) K) *ᵥ (((D⁻¹ : GL (Fin n) K) :
        Matrix (Fin n) (Fin n) K) *ᵥ w) = w := by
      rw [Matrix.mulVec_mulVec, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.one_mulVec]
    have e := idForm_mulVec_of_mem_primeFormUnitary hDU
      (((D⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ w) v
    rw [e1] at e
    rw [e]
    exact hv _ hw'
  have hD3 : ∀ {D : GL (Fin n) K} {d : Fin n → K}, (D : Matrix (Fin n) (Fin n) K) = diagonal d →
      (∀ i, d i ^ 3 = 1) → D ^ 3 = 1 := by
    intro D d hD hd
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, hD, diagonal_pow, Units.val_one]
    have : d ^ 3 = 1 := funext hd
    rw [this]
    exact diagonal_one
  have hproj : ∀ {D : GL (Fin n) K} {d : Fin n → K}, D ∈ primeFormUnitary h (idGram K n) →
      (D : Matrix (Fin n) (Fin n) K) = diagonal d → (∀ i, d i ^ 3 = 1) →
      (∀ t ∈ T, D * t * D⁻¹ ∈ T) → ∀ (c : K) (v : Fin n → K), v ∈ Fx → v ∈ Wp →
      (v + c • ((D : Matrix (Fin n) (Fin n) K) *ᵥ v) + c ^ 2 • ((D : Matrix (Fin n) (Fin n) K) *ᵥ
        ((D : Matrix (Fin n) (Fin n) K) *ᵥ v))) ∈ Fx ∧
      (v + c • ((D : Matrix (Fin n) (Fin n) K) *ᵥ v) + c ^ 2 • ((D : Matrix (Fin n) (Fin n) K) *ᵥ
        ((D : Matrix (Fin n) (Fin n) K) *ᵥ v))) ∈ Wp ∧
      ∀ j, (v + c • ((D : Matrix (Fin n) (Fin n) K) *ᵥ v) + c ^ 2 •
        ((D : Matrix (Fin n) (Fin n) K) *ᵥ ((D : Matrix (Fin n) (Fin n) K) *ᵥ v))) j =
          (1 + c * d j + (c * d j) ^ 2) * v j := by
    intro D d hDU hD hd hN c v hvF hvW
    have hN' : ∀ t ∈ T, D⁻¹ * t * D ∈ T := fun t ht =>
      inv_mul_mul_mem_of_pow_three (hD3 hD hd) hN ht
    refine ⟨hFxadd _ _ (hFxadd _ _ hvF (hFxsmul _ _ (hFxD hN' _ hvF)))
        (hFxsmul _ _ (hFxD hN' _ (hFxD hN' _ hvF))),
      Wp.add_mem (Wp.add_mem hvW (Wp.smul_mem _ (hWpD hDU hN _ hvW)))
        (Wp.smul_mem _ (hWpD hDU hN _ (hWpD hDU hN _ hvW))), fun j => ?_⟩
    rw [hD]
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Matrix.mulVec_diagonal]
    ring
  obtain ⟨j₀, hj₀⟩ : ∃ j, v₀ j ≠ 0 := by
    by_contra hc
    push Not at hc
    exact hv₀0 (funext hc)
  have hne0 : ∀ {x : K}, x ^ 3 = 1 → x ≠ 0 := fun hx h0 => by
    rw [h0] at hx
    norm_num at hx
  obtain ⟨v₁F, v₁W, hv₁⟩ := hproj hD₁U hD₁ hd₁ hN₁ (d₁ j₀)⁻¹ v₀ hv₀F hv₀W
  set v₁ := v₀ + (d₁ j₀)⁻¹ • ((D₁ : Matrix (Fin n) (Fin n) K) *ᵥ v₀) + ((d₁ j₀)⁻¹) ^ 2 •
    ((D₁ : Matrix (Fin n) (Fin n) K) *ᵥ ((D₁ : Matrix (Fin n) (Fin n) K) *ᵥ v₀)) with hv₁def
  obtain ⟨v₂F, v₂W, hv₂⟩ := hproj hD₂U hD₂ hd₂ hN₂ (d₂ j₀)⁻¹ v₁ v₁F v₁W
  set v₂ := v₁ + (d₂ j₀)⁻¹ • ((D₂ : Matrix (Fin n) (Fin n) K) *ᵥ v₁) + ((d₂ j₀)⁻¹) ^ 2 •
    ((D₂ : Matrix (Fin n) (Fin n) K) *ᵥ ((D₂ : Matrix (Fin n) (Fin n) K) *ᵥ v₁)) with hv₂def
  have hfac : ∀ {d : Fin n → K}, (∀ i, d i ^ 3 = 1) → ∀ j,
      (d j = d j₀ → 1 + (d j₀)⁻¹ * d j + ((d j₀)⁻¹ * d j) ^ 2 = 1) ∧
      (d j ≠ d j₀ → 1 + (d j₀)⁻¹ * d j + ((d j₀)⁻¹ * d j) ^ 2 = 0) := by
    intro d hd j
    have h0 := hne0 (hd j₀)
    refine ⟨fun hj => ?_, fun hj => ?_⟩
    · rw [hj, inv_mul_cancel₀ h0]
      linear_combination h2
    · refine one_add_add_sq_eq_zero ?_ ?_
      · rw [mul_pow, inv_pow, hd j₀, hd j, inv_one, one_mul]
      · rw [Ne, inv_mul_eq_one₀ h0]
        exact fun e => hj e.symm
  by_contra hcon
  push Not at hcon
  have hv₂j : ∀ j, v₂ j = if j = j₀ then v₀ j₀ else 0 := by
    intro j
    rw [hv₂ j, hv₁ j]
    split_ifs with hj
    · rw [hj, (hfac hd₁ j₀).1 rfl, (hfac hd₂ j₀).1 rfl, one_mul, one_mul]
    · by_cases h1 : d₁ j = d₁ j₀
      · rw [(hfac hd₂ j).2 (hcon j j₀ hj h1), zero_mul]
      · rw [(hfac hd₁ j).2 h1, zero_mul, mul_zero]
  have hiso : idForm h n v₂ v₂ = 0 := (hmemWp v₂).1 v₂W v₂ v₂F
  rw [idForm_eq_dotProduct, dotProduct, Finset.sum_eq_single j₀] at hiso
  · rw [hv₂j j₀, if_pos rfl] at hiso
    rcases mul_eq_zero.1 hiso with h0 | h0
    · exact hj₀ ((map_eq_zero h.bar).1 h0)
    · exact hj₀ h0
  · intro j _ hj
    rw [hv₂j j, if_neg hj, mul_zero]
  · intro h0
    exact absurd (Finset.mem_univ _) h0

