section Four

variable {ℓ f : ℕ} {K : Type} [Field K]

theorem eq_one_of_pow_four_eq_one [CharP K 2] {z : K} (hz : z ^ 4 = 1) : z = 1 := by
  have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
  have : (z - 1) ^ 4 = 0 := by
    linear_combination hz + (-2 * z ^ 3 + 3 * z ^ 2 - 2 * z + 1) * h2
  exact sub_eq_zero.1 ((pow_eq_zero_iff (by norm_num)).1 this)

theorem normOneScalars_four_eq_bot (h : UnitaryFieldData ℓ f K) [CharP K 2] :
    normOneScalars h (gramSU h (idGram K 4)) 4 = ⊥ := by
  rw [eq_bot_iff]
  intro g hg
  obtain ⟨c, -, hc4, hgc⟩ := mem_normOneScalars.1 hg
  rw [Subgroup.mem_bot]
  have hc : c = 1 := Units.ext (eq_one_of_pow_four_eq_one (by
    rw [← Units.val_pow_eq_pow_val, hc4, Units.val_one]))
  apply Subtype.ext
  rw [hgc, hc, map_one]
  rfl

theorem primeFormP_mk_injective_four (h : UnitaryFieldData ℓ f K) [CharP K 2] :
    Function.Injective (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K 4)) 4)) := by
  rw [← MonoidHom.ker_eq_bot_iff, QuotientGroup.ker_mk', normOneScalars_four_eq_bot]

theorem exists_eq_weight_of_primeFormP_four (h : UnitaryFieldData ℓ f K) [CharP K 2]
    {T : Subgroup (primeFormP h (idGram K 4))} (hT2 : IsPGroup 2 T) (hT : T ≠ ⊥)
    {X₁ X₂ : primeFormUnitary h (idGram K 4)} {d₁ d₂ : Fin 4 → K}
    (hX₁ : ((X₁ : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K) = diagonal d₁)
    (hX₂ : ((X₂ : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K) = diagonal d₂)
    (hd₁ : ∀ i, d₁ i ^ 3 = 1) (hd₂ : ∀ i, d₂ i ^ 3 = 1)
    (hN₁ : T.map (primeFormConjHom h (idGram K 4) X₁).toMonoidHom = T)
    (hN₂ : T.map (primeFormConjHom h (idGram K 4) X₂).toMonoidHom = T) :
    ∃ i j, i ≠ j ∧ d₁ i = d₁ j ∧ d₂ i = d₂ j := by
  classical
  set N := normOneScalars h (gramSU h (idGram K 4)) 4 with hN
  have hinj : Function.Injective (QuotientGroup.mk' N) := primeFormP_mk_injective_four h
  set Tl : Subgroup (GL (Fin 4) K) :=
    (T.comap (QuotientGroup.mk' N)).map (gramSU h (idGram K 4)).subtype with hTl
  have hNl : ∀ {X : primeFormUnitary h (idGram K 4)},
      T.map (primeFormConjHom h (idGram K 4) X).toMonoidHom = T →
      ∀ t ∈ Tl, (X : GL (Fin 4) K) * t * (X : GL (Fin 4) K)⁻¹ ∈ Tl := by
    intro X hX t ht
    obtain ⟨y, hy, rfl⟩ := ht
    refine ⟨⟨(X : GL (Fin 4) K) * y * (X : GL (Fin 4) K)⁻¹,
      conj_mem_gramSU h (idGram K 4) X.2 y.2⟩, ?_, rfl⟩
    show QuotientGroup.mk' N ⟨(X : GL (Fin 4) K) * y * (X : GL (Fin 4) K)⁻¹,
      conj_mem_gramSU h (idGram K 4) X.2 y.2⟩ ∈ T
    rw [← hX]
    exact ⟨QuotientGroup.mk' N y, hy, primeFormConjHom_mk h (idGram K 4) X y⟩
  refine exists_eq_weight_of_isPGroup h (T := Tl) ((hT2.comap_of_injective _ hinj).map _) ?_ ?_
    X₁.2 X₂.2 hX₁ hX₂ hd₁ hd₂ (hNl hN₁) (hNl hN₂)
  · obtain ⟨⟨x, hxT⟩, hx1⟩ := Subgroup.ne_bot_iff_exists_ne_one.1 hT
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N x
    intro hbot
    apply hx1
    apply Subtype.ext
    show QuotientGroup.mk' N y = 1
    have hy : (y : GL (Fin 4) K) ∈ Tl := ⟨y, hxT, rfl⟩
    rw [hbot, Subgroup.mem_bot] at hy
    have hy1 : y = 1 := Subtype.ext hy
    rw [hy1, map_one]
  · rintro _ ⟨y, -, rfl⟩
    exact y.2.1

theorem norm_det_of_mem_primeFormUnitary (h : UnitaryFieldData ℓ f K) {n : ℕ}
    {A : GL (Fin n) K} (hA : A ∈ primeFormUnitary h (idGram K n)) :
    h.norm (A : Matrix (Fin n) (Fin n) K).det = 1 := by
  have h1 := (mem_primeFormUnitary.1 hA)
  simp only [idGram, Units.val_one, Matrix.mul_one] at h1
  have h2 := congrArg Matrix.det h1
  rw [Matrix.det_mul, Matrix.det_transpose, ← RingHom.mapMatrix_apply, ← RingHom.map_det,
    Matrix.det_one] at h2
  rw [UnitaryFieldData.norm, mul_comm]
  exact h2

theorem exists_cube_root_four (h : UnitaryFieldData ℓ f K) {A : primeFormUnitary h (idGram K 4)}
    {α : Kˣ} (hαn : h.norm (α : K) = 1)
    (hA3 : (A : GL (Fin 4) K) ^ 3 = GeneralLinearGroup.scalar (Fin 4) α) :
    ∃ u : Kˣ, h.norm (u : K) = 1 ∧ u ^ 3 = α := by
  have hdet0 : ((A : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K).det ≠ 0 :=
    ((Matrix.isUnit_iff_isUnit_det _).1 (A : GL (Fin 4) K).isUnit).ne_zero
  have hα0 : (α : K) ≠ 0 := α.ne_zero
  have hdet3 : ((A : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K).det ^ 3 = (α : K) ^ 4 := by
    rw [← Matrix.det_pow, ← Units.val_pow_eq_pow_val, hA3, GeneralLinearGroup.coe_scalar,
      Matrix.scalar_apply, Matrix.det_diagonal, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin]
  refine ⟨Units.mk0 (((A : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K).det * (α : K)⁻¹)
    (mul_ne_zero hdet0 (inv_ne_zero hα0)), ?_, ?_⟩
  · rw [Units.val_mk0, norm_mul_eq h, norm_det_of_mem_primeFormUnitary h A.2,
      norm_inv_eq_one hαn, one_mul]
  · apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_mk0, mul_pow, hdet3, inv_pow]
    field_simp

theorem mul_comm_of_primeFormConjHom_comm_four (h : UnitaryFieldData ℓ f K) [CharP K 2]
    {A B : primeFormUnitary h (idGram K 4)}
    (hAB : primeFormConjHom h (idGram K 4) A * primeFormConjHom h (idGram K 4) B =
      primeFormConjHom h (idGram K 4) B * primeFormConjHom h (idGram K 4) A) :
    A * B = B * A := by
  have hne : ¬ (4 = 3 ∧ ℓ ^ f = 2) := fun h' => by omega
  have hz1 : primeFormConjHom h (idGram K 4) (A * B * A⁻¹ * B⁻¹) = 1 := by
    rw [map_mul, map_mul, map_mul, map_inv, map_inv, hAB]
    group
  obtain ⟨z, -, hz⟩ := (primeFormConjHom_eq_one_iff_of_ne (by norm_num) hne _).1 hz1
  have hdet := congrArg (fun g : GL (Fin 4) K => (g : Matrix (Fin 4) (Fin 4) K).det) hz
  simp only [Subgroup.coe_mul, Subgroup.coe_inv, Units.val_mul, Matrix.det_mul,
    GeneralLinearGroup.coe_scalar, Matrix.scalar_apply, Matrix.det_diagonal, Finset.prod_const,
    Finset.card_univ, Fintype.card_fin] at hdet
  have hinv : ∀ g : GL (Fin 4) K, (g : Matrix (Fin 4) (Fin 4) K).det *
      ((g⁻¹ : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K).det = 1 := fun g => by
    rw [← Matrix.det_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.det_one]
  have hz4 : (z : K) ^ 4 = 1 := by
    rw [← hdet]
    calc ((A : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K).det *
          ((B : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K).det *
          (((A : GL (Fin 4) K)⁻¹ : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K).det *
          (((B : GL (Fin 4) K)⁻¹ : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K).det
        = (((A : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K).det *
            (((A : GL (Fin 4) K)⁻¹ : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K).det) *
          (((B : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K).det *
            (((B : GL (Fin 4) K)⁻¹ : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K).det) := by ring
      _ = 1 := by rw [hinv, hinv, one_mul]
  have hz' : z = 1 := Units.ext (eq_one_of_pow_four_eq_one hz4)
  have hc : A * B * A⁻¹ * B⁻¹ = 1 := Subtype.ext (by rw [hz, hz', map_one]; rfl)
  calc A * B = (A * B * A⁻¹ * B⁻¹) * (B * A) := by group
    _ = B * A := by rw [hc, one_mul]

end Four

section Diag

variable {ℓ e : ℕ} {k : Type} [Field k]

theorem exists_unitary_conj_eq_diagonal_pair (h₀ : UnitaryFieldData ℓ e k) {n : ℕ}
    {M N : GL (Fin n) k} {b : Fin n → Fin n → k} (hb : IsOrthonormalFamily h₀ b)
    {μ ν : Fin n → k} (hμ : ∀ i, (M : Matrix (Fin n) (Fin n) k) *ᵥ b i = μ i • b i)
    (hν : ∀ i, (N : Matrix (Fin n) (Fin n) k) *ᵥ b i = ν i • b i) :
    ∃ R : GL (Fin n) k, R ∈ primeFormUnitary h₀ (idGram k n) ∧
      ((R * M * R⁻¹ : GL (Fin n) k) : Matrix (Fin n) (Fin n) k) = diagonal μ ∧
      ((R * N * R⁻¹ : GL (Fin n) k) : Matrix (Fin n) (Fin n) k) = diagonal ν := by
  set B : Matrix (Fin n) (Fin n) k := Matrix.of fun r c => b c r with hB
  have h1 : (B.map h₀.bar)ᵀ * B = 1 := by
    ext c c'
    have := hb c c'
    rw [idForm_eq_dotProduct] at this
    rw [Matrix.mul_apply, Matrix.one_apply, ← this]
    simp [hB, dotProduct]
  have h2 : B * (B.map h₀.bar)ᵀ = 1 := mul_eq_one_comm.1 h1
  have hMB : ∀ {M : GL (Fin n) k} {μ : Fin n → k},
      (∀ i, (M : Matrix (Fin n) (Fin n) k) *ᵥ b i = μ i • b i) →
      (M : Matrix (Fin n) (Fin n) k) * B = B * diagonal μ := by
    intro M μ hμ
    ext r c
    have := congrFun (hμ c) r
    simp only [Matrix.mulVec, dotProduct, Pi.smul_apply, smul_eq_mul] at this
    rw [Matrix.mul_diagonal, Matrix.mul_apply]
    simp only [hB, Matrix.of_apply]
    rw [this, mul_comm]
  have hBB : (((B.map h₀.bar)ᵀ).map h₀.bar)ᵀ = B := by
    ext i j
    simp [h₀.bar_bar]
  refine ⟨⟨(B.map h₀.bar)ᵀ, B, h1, h2⟩, ?_, ?_, ?_⟩
  · rw [mem_primeFormUnitary]
    simp only [idGram, Units.val_one, Matrix.mul_one]
    show (((B.map h₀.bar)ᵀ).map h₀.bar)ᵀ * (B.map h₀.bar)ᵀ = 1
    rw [hBB]
    exact h2
  · show (B.map h₀.bar)ᵀ * (M : Matrix (Fin n) (Fin n) k) * B = diagonal μ
    rw [Matrix.mul_assoc, hMB hμ, ← Matrix.mul_assoc, h1, Matrix.one_mul]
  · show (B.map h₀.bar)ᵀ * (N : Matrix (Fin n) (Fin n) k) * B = diagonal ν
    rw [Matrix.mul_assoc, hMB hν, ← Matrix.mul_assoc, h1, Matrix.one_mul]

theorem exists_pow_of_eq_off {ι : Type*} {a b : ι → k} {j l : ι}
    (hoff : ∀ x, x ≠ l → a x = a j ∧ b x = b j) (hal : a l ≠ a j) (ha3 : ∀ t, a t ^ 3 = 1)
    (hb3 : ∀ t, b t ^ 3 = 1) : ∃ (m : ℕ) (s : k), s ≠ 0 ∧ ∀ t, b t = s * a t ^ m := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hne0 : ∀ {x : k}, x ^ 3 = 1 → x ≠ 0 := fun hx h => by
    rw [h] at hx
    norm_num at hx
  have haj0 := hne0 (ha3 j)
  have hbj0 := hne0 (hb3 j)
  set r : k := a l / a j with hr
  have hr3 : r ^ 3 = 1 := by rw [hr, div_pow, ha3, ha3, div_one]
  have hr1 : r ≠ 1 := by
    rw [hr, Ne, div_eq_one_iff_eq haj0]
    exact hal
  have hrprim : IsPrimitiveRoot r 3 := by
    rw [IsPrimitiveRoot.iff_orderOf]
    exact orderOf_eq_prime hr3 hr1
  have hb3' : (b l / b j) ^ 3 = 1 := by rw [div_pow, hb3, hb3, div_one]
  obtain ⟨m, -, hm⟩ := hrprim.eq_pow_of_pow_eq_one hb3'
  refine ⟨m, b j / a j ^ m, div_ne_zero hbj0 (pow_ne_zero _ haj0), fun t => ?_⟩
  by_cases ht : t = l
  · subst ht
    have : b t = b j * r ^ m := by
      rw [hm]
      field_simp
    rw [this, hr, div_pow]
    field_simp
  · obtain ⟨hat, hbt⟩ := hoff t ht
    rw [hat, hbt]
    field_simp

end Diag

section FieldPartN

variable {ℓ f : ℕ} {K : Type} [Field K]

theorem card_le_three_mul_card_inf_primeFormD_of_le (h : UnitaryFieldData ℓ f K) {n : ℕ}
    (hn : 3 ≤ n) (hne : ¬ (n = 3 ∧ ℓ ^ f = 2))
    {B : Subgroup (MulAut (primeFormP h (idGram K n)))} (hB : ∀ b ∈ B, b ^ 3 = 1) :
    Nat.card B ≤ 3 * Nat.card (B ⊓ primeFormD h (idGram K n) :
      Subgroup (MulAut (primeFormP h (idGram K n)))) := by
  classical
  have := h.finite
  have hker := ker_primeFormFieldFactor h (isPrimeFormGram_idGram (K := K) (n := n)) hn hne
  let φ : B →* (K ≃+* K) :=
    (primeFormFieldFactor h (isPrimeFormGram_idGram (K := K) (n := n)) hn hne).comp B.subtype
  have hkerφ : Nat.card φ.ker = Nat.card (B ⊓ primeFormD h (idGram K n) :
      Subgroup (MulAut (primeFormP h (idGram K n)))) := by
    have h1 : φ.ker = (primeFormD h (idGram K n)).subgroupOf B := by
      ext x
      rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, ← hker, MonoidHom.mem_ker]
      rfl
    rw [h1, ← Subgroup.inf_subgroupOf_left]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe inf_le_left).toEquiv
  haveI : IsCyclic (K ≃+* K) := by
    obtain ⟨σ₀, -, -, htop, -⟩ :=
      CFSG.LocalAnalysis.ComponentInitial.finite_field_automorphism_fixed_field_cardinality h.prime
        (by have := h.one_le; omega) h.card
    exact isCyclic_iff_exists_zpowers_eq_top.mpr ⟨σ₀, htop⟩
  have hrange : Nat.card φ.range ∣ 3 := by
    rw [← IsCyclic.exponent_eq_card]
    refine Monoid.exponent_dvd_of_forall_pow_eq_one fun x => ?_
    obtain ⟨y, hy⟩ := x
    obtain ⟨b, rfl⟩ := MonoidHom.mem_range.1 hy
    apply Subtype.ext
    show φ b ^ 3 = 1
    rw [← map_pow, show b ^ 3 = 1 from Subtype.ext (hB b b.2), map_one]
  rw [← Subgroup.card_ker_mul_card_range φ, hkerφ, mul_comm]
  exact Nat.mul_le_mul_right _ (Nat.le_of_dvd (by norm_num) hrange)

end FieldPartN

open CFSG.ComponentClassification.CatFactsL4U4.TBlocks (bd bd_mul bd_one det_bd transpose_bd map_bd
  ul_bd lr_bd eq_bd)
open CFSG.ComponentClassification.CatFactsL4U4.HBlocks (IsBD ul lr)

section FourBlock

variable {k : Type} [Field k]

theorem apply_eq_zero_of_diagonal_comm {ι : Type*} [Fintype ι] [DecidableEq ι] {d : ι → k}
    {M : Matrix ι ι k} (h : diagonal d * M = M * diagonal d) {i j : ι} (hij : d i ≠ d j) :
    M i j = 0 := by
  have e := congrFun (congrFun h i) j
  rw [Matrix.diagonal_mul, Matrix.mul_diagonal] at e
  have : (d i - d j) * M i j = 0 := by linear_combination e
  exact (mul_eq_zero.1 this).resolve_left (sub_ne_zero.2 hij)

theorem diagonal_mul_bd_one {d : Fin 4 → k} (hd : d 0 = d 1) (B : Matrix (Fin 2) (Fin 2) k) :
    diagonal d * bd B 1 = bd B 1 * diagonal d := by
  ext i j
  rw [Matrix.diagonal_mul, Matrix.mul_diagonal]
  fin_cases i <;> fin_cases j <;> simp [bd, hd, mul_comm]

@[expose] def slBlkFour :
    Matrix.SpecialLinearGroup (Fin 2) k →* Matrix.SpecialLinearGroup (Fin 4) k where
  toFun g := ⟨bd (g : Matrix (Fin 2) (Fin 2) k) 1, by rw [det_bd, g.2, Matrix.det_one, mul_one]⟩
  map_one' := Subtype.ext (by
    show bd ((1 : Matrix.SpecialLinearGroup (Fin 2) k) : Matrix (Fin 2) (Fin 2) k) 1 = 1
    rw [Matrix.SpecialLinearGroup.coe_one, bd_one])
  map_mul' g g' := Subtype.ext (by
    show bd ((g * g' : Matrix.SpecialLinearGroup (Fin 2) k) : Matrix (Fin 2) (Fin 2) k) 1 =
      bd (g : Matrix (Fin 2) (Fin 2) k) 1 * bd (g' : Matrix (Fin 2) (Fin 2) k) 1
    rw [Matrix.SpecialLinearGroup.coe_mul, bd_mul, Matrix.mul_one])

end FourBlock

section SUBlockFour

variable {K : Type} [Field K] [CharP K 2]

@[expose] def suTwoPGLFour {ω : K} (hω : ω ^ 2 + ω + 1 = 0) : GL (Fin 4) K :=
  ⟨bd (suTwoP ω) 1, bd (suTwoPInv ω) 1, by
    rw [bd_mul, suTwoP_mul_suTwoPInv hω, Matrix.mul_one, bd_one], by
    rw [bd_mul, suTwoPInv_mul_suTwoP hω, Matrix.mul_one, bd_one]⟩

@[expose] def suTwoBlkGLFour {ω : K} (hω : ω ^ 2 + ω + 1 = 0) (F₀ : Subfield K) :
    Matrix.SpecialLinearGroup (Fin 2) F₀ →* GL (Fin 4) K :=
  (MulAut.conj (suTwoPGLFour hω)).toMonoidHom.comp (Matrix.SpecialLinearGroup.toGL.comp
    (slBlkFour.comp (Matrix.SpecialLinearGroup.map F₀.subtype)))

theorem coe_suTwoBlkGLFour {ω : K} (hω : ω ^ 2 + ω + 1 = 0) {F₀ : Subfield K}
    (g : Matrix.SpecialLinearGroup (Fin 2) F₀) :
    ((suTwoBlkGLFour hω F₀ g : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K) =
      bd (suTwoP ω * (g : Matrix (Fin 2) (Fin 2) F₀).map F₀.subtype * suTwoPInv ω) 1 := by
  show bd (suTwoP ω) 1 * bd ((g : Matrix (Fin 2) (Fin 2) F₀).map F₀.subtype) 1 *
    bd (suTwoPInv ω) 1 = _
  rw [bd_mul, bd_mul, Matrix.mul_one, Matrix.mul_one]

variable {ℓ f : ℕ}

theorem suTwoMat_unitary (h : UnitaryFieldData ℓ f K) {ω : K} (hω : ω ^ 2 + ω + 1 = 0)
    (hωb : h.bar ω = ω ^ 2) {F₀ : Subfield K} (hF₀ : ∀ c ∈ F₀, h.bar c = c)
    (g : Matrix.SpecialLinearGroup (Fin 2) F₀) :
    (((suTwoP ω * (g : Matrix (Fin 2) (Fin 2) F₀).map F₀.subtype * suTwoPInv ω).map h.bar)ᵀ *
      (suTwoP ω * (g : Matrix (Fin 2) (Fin 2) F₀).map F₀.subtype * suTwoPInv ω) = 1) ∧
    (suTwoP ω * (g : Matrix (Fin 2) (Fin 2) F₀).map F₀.subtype * suTwoPInv ω).det = 1 := by
  have hω3 : ω ^ 3 = 1 := by linear_combination (ω - 1) * hω
  set g' := (g : Matrix (Fin 2) (Fin 2) F₀).map F₀.subtype with hg'
  have hg'b : g'.map h.bar = g' := by
    ext i j
    exact hF₀ _ ((g : Matrix (Fin 2) (Fin 2) F₀) i j).2
  have hg'det : g'.det = 1 := by
    rw [hg', ← RingHom.mapMatrix_apply, ← RingHom.map_det, g.2, map_one]
  set B := suTwoP ω * g' * suTwoPInv ω with hB
  have hBb : B.map h.bar = suTwoJ * B * suTwoJ := by
    rw [hB, Matrix.map_mul, Matrix.map_mul, hg'b, map_suTwoP, map_suTwoPInv, hωb, suTwoP_sq hω3,
      suTwoPInv_sq hω3]
    simp only [Matrix.mul_assoc]
  have hBdet : B.det = 1 := by
    rw [hB, Matrix.det_mul, Matrix.det_mul, mul_right_comm, ← Matrix.det_mul,
      suTwoP_mul_suTwoPInv hω, Matrix.det_one, one_mul, hg'det]
  exact ⟨transpose_map_mul_eq_one hBb hBdet, hBdet⟩

theorem suTwoBlkGLFour_mem_gramSU (h : UnitaryFieldData ℓ f K) {ω : K} (hω : ω ^ 2 + ω + 1 = 0)
    (hωb : h.bar ω = ω ^ 2) {F₀ : Subfield K} (hF₀ : ∀ c ∈ F₀, h.bar c = c)
    (g : Matrix.SpecialLinearGroup (Fin 2) F₀) :
    suTwoBlkGLFour hω F₀ g ∈ gramSU h (idGram K 4) := by
  obtain ⟨hu, hdet⟩ := suTwoMat_unitary h hω hωb hF₀ g
  have hI : idGram K 4 = (1 : Matrix (Fin 4) (Fin 4) K) := Units.val_one
  refine ⟨?_, ?_⟩
  · rw [hI, Matrix.mul_one, coe_suTwoBlkGLFour, map_bd, transpose_bd, bd_mul, hu,
      Matrix.map_one _ (map_zero _) (map_one _), Matrix.transpose_one, Matrix.mul_one, bd_one]
  · rw [coe_suTwoBlkGLFour, det_bd, hdet, Matrix.det_one, mul_one]

@[expose] noncomputable def suTwoBlkFour (h : UnitaryFieldData ℓ f K) {ω : K}
    (hω : ω ^ 2 + ω + 1 = 0) (hωb : h.bar ω = ω ^ 2) {F₀ : Subfield K}
    (hF₀ : ∀ c ∈ F₀, h.bar c = c) :
    Matrix.SpecialLinearGroup (Fin 2) F₀ →* primeFormP h (idGram K 4) :=
  (QuotientGroup.mk' _).comp
    ((suTwoBlkGLFour hω F₀).codRestrict _ (suTwoBlkGLFour_mem_gramSU h hω hωb hF₀))

theorem exists_suTwoMat_eq (h : UnitaryFieldData ℓ f K) {ω : K} (hω : ω ^ 2 + ω + 1 = 0)
    (hωb : h.bar ω = ω ^ 2) {F₀ : Subfield K} (hF₀mem : ∀ c : K, h.bar c = c → c ∈ F₀)
    {Z' : Matrix (Fin 2) (Fin 2) K} (hZu : (Z'.map h.bar)ᵀ * Z' = 1) (hZdet : Z'.det = 1) :
    ∃ g : Matrix.SpecialLinearGroup (Fin 2) F₀,
      suTwoP ω * (g : Matrix (Fin 2) (Fin 2) F₀).map F₀.subtype * suTwoPInv ω = Z' := by
  have hω3 : ω ^ 3 = 1 := by linear_combination (ω - 1) * hω
  have hZ'b : Z'.map h.bar = suTwoJ * Z' * suTwoJ := map_eq_suTwoJ_mul_mul_suTwoJ hZu hZdet
  set g₁ := suTwoPInv ω * Z' * suTwoP ω with hg₁
  have hg₁b : g₁.map h.bar = g₁ := by
    rw [hg₁, Matrix.map_mul, Matrix.map_mul, hZ'b, map_suTwoP, map_suTwoPInv, hωb, suTwoP_sq hω3,
      suTwoPInv_sq hω3]
    simp only [Matrix.mul_assoc, suTwoJ_mul_suTwoJ_mul]
  have hmem : ∀ i j, g₁ i j ∈ F₀ := fun i j => hF₀mem _ (congrFun (congrFun hg₁b i) j)
  let g₀ : Matrix (Fin 2) (Fin 2) F₀ := fun i j => ⟨g₁ i j, hmem i j⟩
  have hg₀ : g₀.map F₀.subtype = g₁ := by
    ext i j
    rfl
  have hdet : g₀.det = 1 := by
    apply F₀.subtype.injective
    rw [map_one, RingHom.map_det, RingHom.mapMatrix_apply, hg₀, hg₁, Matrix.det_mul,
      Matrix.det_mul, mul_right_comm, ← Matrix.det_mul, suTwoPInv_mul_suTwoP hω, Matrix.det_one,
      one_mul, hZdet]
  refine ⟨⟨g₀, hdet⟩, ?_⟩
  show suTwoP ω * g₀.map F₀.subtype * suTwoPInv ω = Z'
  rw [hg₀, hg₁]
  simp only [Matrix.mul_assoc, suTwoP_mul_suTwoPInv hω, suTwoP_mul_suTwoPInv_mul hω,
    Matrix.mul_one]

end SUBlockFour

section CoreFour

variable {K : Type} [Field K] [CharP K 2]

theorem glaPLayer_ne_bot_of_unitary_diagonal_four {f : ℕ} (h : UnitaryFieldData 2 f K)
    (hf : 2 ≤ f) {ω : K} (hω : ω ^ 2 + ω + 1 = 0) (hωb : h.bar ω = ω ^ 2)
    {X₁ X₂ : primeFormUnitary h (idGram K 4)} {e₁ e₂ : Fin 4 → K}
    (hX₁ : ((X₁ : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K) = diagonal e₁)
    (hX₂ : ((X₂ : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K) = diagonal e₂)
    (h01₁ : e₁ 0 = e₁ 1) (h01₂ : e₂ 0 = e₂ 1)
    (hw2 : e₁ 2 ≠ e₁ 0 ∨ e₂ 2 ≠ e₂ 0) (hw3 : e₁ 3 ≠ e₁ 0 ∨ e₂ 3 ≠ e₂ 0) :
    GLAPLayer 3 (fixSubgroup (primeFormConjHom h (idGram K 4) X₁) ⊓
      fixSubgroup (primeFormConjHom h (idGram K 4) X₂)) ≠ ⊥ := by
  classical
  have := h.finite
  set F₀ := h.fixedField with hF₀def
  have hF₀b : ∀ c ∈ F₀, h.bar c = c := fun c hc => (UnitaryFieldData.mem_fixedField h).1 hc
  have hF₀mem : ∀ c : K, h.bar c = c → c ∈ F₀ := fun c hc =>
    (UnitaryFieldData.mem_fixedField h).2 hc
  have hF₀ : Nat.card F₀ = 2 ^ f := h.card_fixedField
  set N := normOneScalars h (gramSU h (idGram K 4)) 4 with hN
  have hinj : Function.Injective (QuotientGroup.mk' N) := primeFormP_mk_injective_four h
  set Y := fixSubgroup (primeFormConjHom h (idGram K 4) X₁) ⊓
      fixSubgroup (primeFormConjHom h (idGram K 4) X₂) with hYdef
  set φ := suTwoBlkFour h hω hωb hF₀b with hφdef
  have hφ : ∀ g, φ g = ((⟨suTwoBlkGLFour hω F₀ g, suTwoBlkGLFour_mem_gramSU h hω hωb hF₀b g⟩ :
      gramSU h (idGram K 4)) : primeFormP h (idGram K 4)) := fun g => rfl
  have hzero : ∀ {M : Matrix (Fin 4) (Fin 4) K}, diagonal e₁ * M = M * diagonal e₁ →
      diagonal e₂ * M = M * diagonal e₂ → IsBD M := by
    intro M h1 h2
    have z : ∀ i j, (e₁ i ≠ e₁ j ∨ e₂ i ≠ e₂ j) → M i j = 0 := by
      intro i j hij
      rcases hij with hij | hij
      · exact apply_eq_zero_of_diagonal_comm h1 hij
      · exact apply_eq_zero_of_diagonal_comm h2 hij
    have w2 : e₁ 0 ≠ e₁ 2 ∨ e₂ 0 ≠ e₂ 2 := hw2.imp Ne.symm Ne.symm
    have w3 : e₁ 0 ≠ e₁ 3 ∨ e₂ 0 ≠ e₂ 3 := hw3.imp Ne.symm Ne.symm
    have w12 : e₁ 1 ≠ e₁ 2 ∨ e₂ 1 ≠ e₂ 2 := by rw [← h01₁, ← h01₂]; exact w2
    have w13 : e₁ 1 ≠ e₁ 3 ∨ e₂ 1 ≠ e₂ 3 := by rw [← h01₁, ← h01₂]; exact w3
    exact ⟨z 0 2 w2, z 0 3 w3, z 1 2 w12, z 1 3 w13, z 2 0 (w2.imp Ne.symm Ne.symm),
      z 2 1 (w12.imp Ne.symm Ne.symm), z 3 0 (w3.imp Ne.symm Ne.symm),
      z 3 1 (w13.imp Ne.symm Ne.symm)⟩
  have hXB : ∀ {X : primeFormUnitary h (idGram K 4)} {e : Fin 4 → K},
      ((X : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K) = diagonal e → e 0 = e 1 →
      ∀ g, (X : GL (Fin 4) K) * suTwoBlkGLFour hω F₀ g = suTwoBlkGLFour hω F₀ g * X := by
    intro X e hX he g
    apply Units.ext
    rw [Units.val_mul, Units.val_mul, coe_suTwoBlkGLFour, hX]
    exact diagonal_mul_bd_one he _
  have hφinj : Function.Injective φ := by
    rw [injective_iff_map_eq_one]
    intro g hg
    rw [hφ] at hg
    have hg1 : (⟨suTwoBlkGLFour hω F₀ g, suTwoBlkGLFour_mem_gramSU h hω hωb hF₀b g⟩ :
        gramSU h (idGram K 4)) = 1 := hinj (by rw [map_one]; exact hg)
    have hc' := congrArg (fun x : gramSU h (idGram K 4) =>
      ((x : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K)) hg1
    simp only [Subgroup.coe_one, Units.val_one] at hc'
    rw [coe_suTwoBlkGLFour, ← bd_one] at hc'
    have hB1 := congrArg ul hc'
    rw [ul_bd, ul_bd] at hB1
    have hg'1 : (g : Matrix (Fin 2) (Fin 2) F₀).map F₀.subtype = 1 := by
      have e1 : suTwoPInv ω * (suTwoP ω * (g : Matrix (Fin 2) (Fin 2) F₀).map F₀.subtype *
          suTwoPInv ω) * suTwoP ω = (g : Matrix (Fin 2) (Fin 2) F₀).map F₀.subtype := by
        simp only [Matrix.mul_assoc, suTwoPInv_mul_suTwoP_mul hω, suTwoPInv_mul_suTwoP hω,
          Matrix.mul_one]
      rw [← e1, hB1, Matrix.mul_one, suTwoPInv_mul_suTwoP hω]
    have hg1' : (g : Matrix (Fin 2) (Fin 2) F₀) = 1 :=
      Matrix.map_injective (f := ((↑) : F₀ → K)) Subtype.val_injective
        (hg'1.trans (Matrix.map_one _ rfl rfl).symm)
    exact Subtype.ext hg1'
  have hJY : φ.range ≤ Y := by
    rintro _ ⟨g, rfl⟩
    refine Subgroup.mem_inf.2 ⟨?_, ?_⟩
    · rw [mem_fixSubgroup, hφ, primeFormConjHom_mk]
      congr 1
      apply Subtype.ext
      show (X₁ : GL (Fin 4) K) * suTwoBlkGLFour hω F₀ g * (X₁ : GL (Fin 4) K)⁻¹ =
        suTwoBlkGLFour hω F₀ g
      rw [hXB hX₁ h01₁ g, mul_inv_cancel_right]
    · rw [mem_fixSubgroup, hφ, primeFormConjHom_mk]
      congr 1
      apply Subtype.ext
      show (X₂ : GL (Fin 4) K) * suTwoBlkGLFour hω F₀ g * (X₂ : GL (Fin 4) K)⁻¹ =
        suTwoBlkGLFour hω F₀ g
      rw [hXB hX₂ h01₂ g, mul_inv_cancel_right]
  have hJn : (φ.range.subgroupOf Y).Normal := by
    rw [Subgroup.normal_subgroupOf_iff hJY]
    rintro _ y ⟨g, rfl⟩ hy
    obtain ⟨Y₁, rfl⟩ := QuotientGroup.mk_surjective y
    have hy1 := (Subgroup.mem_inf.1 hy).1
    have hy2 := (Subgroup.mem_inf.1 hy).2
    rw [mem_fixSubgroup] at hy1 hy2
    have hcomm : ∀ {X : primeFormUnitary h (idGram K 4)},
        primeFormConjHom h (idGram K 4) X (Y₁ : primeFormP h (idGram K 4)) = Y₁ →
        (X : GL (Fin 4) K) * Y₁ = Y₁ * X := by
      intro X hX
      rw [primeFormConjHom_mk] at hX
      have e := congrArg Subtype.val (hinj hX)
      calc (X : GL (Fin 4) K) * Y₁ = ((X : GL (Fin 4) K) * Y₁ * (X : GL (Fin 4) K)⁻¹) * X := by
            group
        _ = Y₁ * X := by rw [show (X : GL (Fin 4) K) * Y₁ * (X : GL (Fin 4) K)⁻¹ = Y₁ from e]
    have hm : ∀ {X : primeFormUnitary h (idGram K 4)} {e : Fin 4 → K},
        ((X : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K) = diagonal e →
        ∀ {u : GL (Fin 4) K}, (X : GL (Fin 4) K) * u = u * X →
        diagonal e * (u : Matrix (Fin 4) (Fin 4) K) = (u : Matrix (Fin 4) (Fin 4) K) * diagonal e := by
      intro X e hX u hu
      have := congrArg Units.val hu
      rwa [Units.val_mul, Units.val_mul, hX] at this
    have hinvc : ∀ {X u : GL (Fin 4) K}, X * u = u * X → X * u⁻¹ = u⁻¹ * X := by
      intro X u hu
      calc X * u⁻¹ = u⁻¹ * (u * X) * u⁻¹ := by group
        _ = u⁻¹ * (X * u) * u⁻¹ := by rw [hu]
        _ = u⁻¹ * X := by group
    obtain ⟨u, hu⟩ : ∃ u : GL (Fin 4) K, u = (Y₁ : GL (Fin 4) K) := ⟨_, rfl⟩
    have hu1 : (X₁ : GL (Fin 4) K) * u = u * X₁ := hu ▸ hcomm hy1
    have hu2 : (X₂ : GL (Fin 4) K) * u = u * X₂ := hu ▸ hcomm hy2
    have hBD := hzero (hm hX₁ hu1) (hm hX₂ hu2)
    have hBDi := hzero (hm hX₁ (hinvc hu1)) (hm hX₂ (hinvc hu2))
    have eu := eq_bd hBD
    have eui := eq_bd hBDi
    have hlr : lr (u : Matrix (Fin 4) (Fin 4) K) *
        lr ((u⁻¹ : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K) = 1 := by
      have h1 : (u : Matrix (Fin 4) (Fin 4) K) * ((u⁻¹ : GL (Fin 4) K) :
          Matrix (Fin 4) (Fin 4) K) = 1 := by
        rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
      rw [eu, eui, bd_mul, ← bd_one] at h1
      have := congrArg lr h1
      rwa [lr_bd, lr_bd] at this
    obtain ⟨B, hB⟩ : ∃ B : GL (Fin 4) K, B = suTwoBlkGLFour hω F₀ g := ⟨_, rfl⟩
    have hbm : (B : Matrix (Fin 4) (Fin 4) K) = bd (suTwoP ω *
        (g : Matrix (Fin 2) (Fin 2) F₀).map F₀.subtype * suTwoPInv ω) 1 := by
      rw [hB]
      exact coe_suTwoBlkGLFour hω g
    obtain ⟨Z, hZ⟩ : ∃ Z : GL (Fin 4) K, Z = u * B * u⁻¹ := ⟨_, rfl⟩
    obtain ⟨Z', hZ'⟩ : ∃ Z' : Matrix (Fin 2) (Fin 2) K, Z' = ul (u : Matrix (Fin 4) (Fin 4) K) *
        (suTwoP ω * (g : Matrix (Fin 2) (Fin 2) F₀).map F₀.subtype * suTwoPInv ω) *
        ul ((u⁻¹ : GL (Fin 4) K) : Matrix (Fin 4) (Fin 4) K) := ⟨_, rfl⟩
    have hZm : (Z : Matrix (Fin 4) (Fin 4) K) = bd Z' 1 := by
      rw [hZ, Units.val_mul, Units.val_mul, hbm, eu, eui, bd_mul, bd_mul, Matrix.mul_one, hlr, hZ']
    have humem : u ∈ gramSU h (idGram K 4) := hu ▸ Y₁.2
    have hBmem : B ∈ gramSU h (idGram K 4) := hB ▸ suTwoBlkGLFour_mem_gramSU h hω hωb hF₀b g
    have hZmem : Z ∈ gramSU h (idGram K 4) := by
      rw [hZ]
      exact mul_mem (mul_mem humem hBmem) (inv_mem humem)
    have hI : idGram K 4 = (1 : Matrix (Fin 4) (Fin 4) K) := Units.val_one
    have hZu : (Z'.map h.bar)ᵀ * Z' = 1 := by
      have h1 := hZmem.1
      rw [hI, Matrix.mul_one, hZm, map_bd, transpose_bd, bd_mul, ← bd_one] at h1
      have := congrArg ul h1
      rwa [ul_bd, ul_bd] at this
    have hZdet : Z'.det = 1 := by
      have h1 := hZmem.2
      rwa [hZm, det_bd, Matrix.det_one, mul_one] at h1
    obtain ⟨g'', hg''⟩ := exists_suTwoMat_eq h hω hωb hF₀mem hZu hZdet
    refine ⟨g'', ?_⟩
    rw [hφ g'', hφ g, ← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul]
    congr 1
    apply Subtype.ext
    show suTwoBlkGLFour hω F₀ g'' =
      (Y₁ : GL (Fin 4) K) * suTwoBlkGLFour hω F₀ g * (Y₁ : GL (Fin 4) K)⁻¹
    apply Units.ext
    rw [coe_suTwoBlkGLFour, hg'', ← hZm, hZ, hu, hB]
  haveI : Fintype F₀ := Fintype.ofFinite F₀
  haveI : IsSimpleGroup (Matrix.SpecialLinearGroup (Fin 2) F₀) :=
    CFSG.Quasithin.R3c21.isSimpleGroup_sl2_of_card_two_pow hf
      (by rw [← Nat.card_eq_fintype_card, hF₀])
  let eJ : Matrix.SpecialLinearGroup (Fin 2) F₀ ≃* φ.range := MonoidHom.ofInjective hφinj
  haveI : IsSimpleGroup φ.range := eJ.symm.isSimpleGroup
  have hnc : ∃ a b : φ.range, a * b ≠ b * a := by
    let t1 : Matrix.SpecialLinearGroup (Fin 2) F₀ := ⟨!![1, 1; 0, 1], by simp [Matrix.det_fin_two]⟩
    let t2 : Matrix.SpecialLinearGroup (Fin 2) F₀ := ⟨!![1, 0; 1, 1], by simp [Matrix.det_fin_two]⟩
    have ht1 : (t1 : Matrix (Fin 2) (Fin 2) F₀) = !![1, 1; 0, 1] := rfl
    have ht2 : (t2 : Matrix (Fin 2) (Fin 2) F₀) = !![1, 0; 1, 1] := rfl
    refine ⟨eJ t1, eJ t2, fun h => ?_⟩
    rw [← map_mul, ← map_mul] at h
    have h' := congrArg (fun A : Matrix.SpecialLinearGroup (Fin 2) F₀ =>
      (A : Matrix (Fin 2) (Fin 2) F₀) 0 0) (eJ.injective h)
    simp only [Matrix.SpecialLinearGroup.coe_mul, ht1, ht2] at h'
    simp [Matrix.mul_apply, Fin.sum_univ_two] at h'
  have h3J : 3 ∣ Nat.card φ.range := by
    rw [← Nat.card_congr eJ.toEquiv]
    have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
    have h2F : (2 : F₀) = 0 := F₀.subtype.injective (by rw [map_ofNat, map_zero]; exact h2)
    have h11 : (1 : F₀) + 1 = 0 := by rw [one_add_one_eq_two]; exact h2F
    let t3 : Matrix.SpecialLinearGroup (Fin 2) F₀ := ⟨!![0, 1; 1, 1], by
      rw [Matrix.det_fin_two_of]; linear_combination -h2F⟩
    have ht3 : t3 ^ 3 = 1 := by
      apply Subtype.ext
      rw [Matrix.SpecialLinearGroup.coe_pow, Matrix.SpecialLinearGroup.coe_one]
      show (!![0, 1; 1, 1] : Matrix (Fin 2) (Fin 2) F₀) ^ 3 = 1
      rw [pow_succ, pow_two, Matrix.mul_fin_two, Matrix.mul_fin_two, Matrix.one_fin_two]
      simp only [mul_zero, zero_mul, mul_one, one_mul, zero_add, add_zero, h11]
    have ht31 : t3 ≠ 1 := by
      intro h1
      have h1' := congrArg (fun A : Matrix.SpecialLinearGroup (Fin 2) F₀ =>
        (A : Matrix (Fin 2) (Fin 2) F₀) 0 0) h1
      simp [t3] at h1'
    haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    rw [← orderOf_eq_prime ht3 ht31]
    exact orderOf_dvd_natCard t3
  have hle := le_glaPLayer_of_normal_simple Nat.prime_three hJY hJn hnc h3J
  intro hbot
  rw [hbot] at hle
  obtain ⟨a, b, hab⟩ := hnc
  apply hab
  have ha : a = 1 := Subtype.ext (Subgroup.mem_bot.1 (hle a.2))
  have hb : b = 1 := Subtype.ext (Subgroup.mem_bot.1 (hle b.2))
  rw [ha, hb]

end CoreFour

end CFSG.LocalAnalysis.GLTheoremA.HDescUniRes

