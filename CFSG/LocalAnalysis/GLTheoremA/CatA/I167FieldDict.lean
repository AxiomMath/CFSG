@[expose] def fldClassicalLabel (t : StatedLieTag) (n f : ℕ) : LargeEvenLabel :=
  match t with
  | .PSL => ⟨.A, n - 1, f⟩
  | .POmegaPlus => ⟨.D, n, f⟩
  | _ => ⟨.twD, n, f⟩

@[expose] def FldRange (t : StatedLieTag) (n f : ℕ) : Prop :=
  1 ≤ f ∧ ((t = .PSL ∧ (5 ≤ n ∨ (n = 4 ∧ 2 ≤ f))) ∨ ((t = .POmegaPlus ∨ t = .POmegaMinus) ∧ 4 ≤ n))

theorem fld_label_eq_of_markParams {lab : LargeEvenLabel} {t : StatedLieTag} {n f : ℕ}
    (hr : FldRange t n f)
    (h : markTag lab = t ∧ markRank lab = n ∧ markChar lab = 2 ∧ markDeg lab = f) :
    lab = fldClassicalLabel t n f ∨ (t = .PSL ∧ n = 4 ∧ lab = ⟨.D, 3, f⟩) := by
  unfold FldRange at hr
  obtain ⟨hf, hcase⟩ := hr
  rcases lab with ⟨tag, r, m⟩
  rcases hcase with ⟨rfl, hn⟩ | ⟨ht, hn⟩
  · cases tag <;>
      simp only [markTag, markRank, markChar, markDeg, fldClassicalLabel,
        LargeEvenLabel.mk.injEq, reduceCtorEq] at h ⊢ <;>
      (try split_ifs at h ⊢) <;>
      simp_all <;> omega
  · rcases ht with rfl | rfl <;>
      cases tag <;>
      simp only [markTag, markRank, markChar, markDeg, fldClassicalLabel,
        LargeEvenLabel.mk.injEq, reduceCtorEq] at h ⊢ <;>
      (try split_ifs at h ⊢) <;>
      simp_all <;> omega

theorem fld_markParams_of_canonLabel {lab : LargeEvenLabel} {t : StatedLieTag} {n g : ℕ}
    (hr : FldRange t n g) (h : canonLabel lab = fldClassicalLabel t n g) :
    markTag lab = t ∧ markRank lab = n ∧ markChar lab = 2 ∧ markDeg lab = g := by
  unfold FldRange at hr
  obtain ⟨hf, hcase⟩ := hr
  rcases lab with ⟨tag, r, m⟩
  rcases hcase with ⟨rfl, hn⟩ | ⟨ht, hn⟩
  · cases tag <;>
      simp only [canonLabel, markTag, markRank, markChar, markDeg, fldClassicalLabel,
        LargeEvenLabel.mk.injEq, reduceCtorEq] at h ⊢ <;>
      (try split_ifs at h ⊢) <;>
      simp only [LargeEvenLabel.mk.injEq, reduceCtorEq, false_and, and_false, true_and,
        and_true, or_false, false_or] at h ⊢ <;>
      omega
  · rcases ht with rfl | rfl <;>
      cases tag <;>
      simp only [canonLabel, markTag, markRank, markChar, markDeg, fldClassicalLabel,
        LargeEvenLabel.mk.injEq, reduceCtorEq] at h ⊢ <;>
      (try split_ifs at h ⊢) <;>
      simp only [LargeEvenLabel.mk.injEq, reduceCtorEq, false_and, and_false, true_and,
        and_true, or_false, false_or] at h ⊢ <;>
      omega

private theorem fld_lieModel_of_isLnA_aux1 {q : TauCeti.PrimePower} {k : ℕ} (hk : 1 ≤ k)
    (h : q.card = 2 ^ k) : q.p = 2 ∧ q.exponent = k := by
  have hdvd : q.p ∣ 2 ^ k := by
    rw [← h, TauCeti.PrimePower.card_def]
    exact dvd_pow_self q.p q.exponent_pos.ne'
  have h2 : q.p ∣ 2 := by
    rcases k with _ | k
    · omega
    · exact q.prime_p.dvd_of_dvd_pow (n := k + 1) hdvd
  have hp : q.p = 2 := (Nat.prime_dvd_prime_iff_eq q.prime_p Nat.prime_two).1 h2
  refine ⟨hp, ?_⟩
  have hk' : q.p ^ q.exponent = 2 ^ k := (TauCeti.PrimePower.card_def q).symm.trans h
  rw [hp] at hk'
  exact Nat.pow_right_injective le_rfl hk'

private theorem fld_lieModel_of_isLnA_aux2 {i : TauCeti.CFSGIndex} {n q : ℕ}
    (h : onLie (isLnEps n q true) i) :
    ∃ (r : ℕ) (qq : TauCeti.PrimePower) (hv : (TauCeti.LieTypeIndex.A r qq).Valid),
      r + 1 = n ∧ qq.card = q ∧ i = TauCeti.CFSGIndex.lie ⟨.A r qq, hv⟩ := by
  cases i with
  | cyclic p hp => simp [onLie] at h
  | alternating m hm => simp [onLie] at h
  | sporadic s => simp [onLie] at h
  | lie idx =>
    obtain ⟨d, hv⟩ := idx
    cases d with
    | A r qq =>
      have h' : r + 1 = n ∧ qq.card = q := h
      exact ⟨r, qq, hv, h'.1, h'.2, rfl⟩
    | _ => simp [onLie, isLnEps] at h

theorem fld_lieModel_of_isLnA {S : Type} [Group S] {n : ℕ} (hn : 5 ≤ n)
    (h : catalogIs S (isLnA n 2)) : CFSG.Blueprint.LieModel S .PSL n 2 1 := by
  obtain ⟨i, hi, ⟨e⟩⟩ := h
  rcases hi with h1 | ⟨h2, -⟩ | ⟨h2, -⟩ | ⟨h3, -⟩ | ⟨h4, -⟩
  · obtain ⟨r, qq, hv, hr, hq, rfl⟩ := fld_lieModel_of_isLnA_aux2 h1
    obtain ⟨hp, he⟩ := fld_lieModel_of_isLnA_aux1 (k := 1) le_rfl (by simpa using hq)
    have hm := CFSG.Models.lieModel_A r qq hv e
    rw [hr, hp, he] at hm
    exact CFSG.Models.LieModel.toBlueprint (by simp [CFSG.Blueprint.classicalTags]) hm
  · omega
  · omega
  · omega
  · omega

