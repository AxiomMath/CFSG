  simp [q, PrimePower.card_def]

private theorem fld_lieOrd_gt_psl_aux1 (q n : ℕ) (hq : 2 ≤ q) (hn : 4 ≤ n) :
    (q ^ 2 - 1) * (q ^ 3 - 1) * (q ^ 4 - 1) ≤ ∏ i ∈ Finset.Icc 2 n, (q ^ i - 1) := by
  have hsub : ({2, 3, 4} : Finset ℕ) ⊆ Finset.Icc 2 n := by
    intro i hi
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi
    rcases hi with rfl | rfl | rfl <;> exact Finset.mem_Icc.mpr (by omega)
  have hle := Finset.prod_le_prod_of_subset_of_one_le hsub (fun i hi _ => by
    show 1 ≤ q ^ i - 1
    have hi2 : 2 ≤ i := (Finset.mem_Icc.mp hi).1
    have h2i : q ^ 2 ≤ q ^ i := Nat.pow_le_pow_right (by omega) hi2
    have h4 : 4 ≤ q ^ 2 := by
      have h : 2 * 2 ≤ q * q := Nat.mul_le_mul hq hq
      norm_num at h
      simpa [pow_two] using h
    omega)
  have hprod : ∏ i ∈ ({2, 3, 4} : Finset ℕ), (q ^ i - 1)
      = (q ^ 2 - 1) * (q ^ 3 - 1) * (q ^ 4 - 1) := by
    simp [Finset.prod_insert, mul_assoc]
  rwa [hprod] at hle

private theorem fld_lieOrd_gt_psl_aux2 {k q : ℕ} (hq : 2 ≤ q) (hA : 1024 ≤ q ^ k) :
    20161 ≤ q ^ k * (q + 1) * (q ^ 3 - 1) * (q ^ 4 - 1) := by
  have h3 : 3 ≤ q + 1 := by omega
  have h7 : 7 ≤ q ^ 3 - 1 := by
    have := Nat.pow_le_pow_left hq 3
    norm_num at this ⊢
    omega
  have h15 : 15 ≤ q ^ 4 - 1 := by
    have := Nat.pow_le_pow_left hq 4
    norm_num at this ⊢
    omega
  have hbase : 20161 ≤ 1024 * 3 * 7 * 15 := by norm_num
  have hmul : 1024 * 3 * 7 * 15 ≤ q ^ k * (q + 1) * (q ^ 3 - 1) * (q ^ 4 - 1) :=
    Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul hA h3) h7) h15
  exact le_trans hbase hmul

private theorem fld_lieOrd_gt_psl_aux3 {n q k : ℕ} (hq : 2 ≤ q) (hn : 4 ≤ n)
    (hA : 1024 ≤ q ^ k) :
    20161 * Nat.gcd n (q - 1) ≤ q ^ k * (∏ i ∈ Finset.Icc 2 n, (q ^ i - 1)) := by
  have hq1 : 0 < q - 1 := by omega
  have hgle : Nat.gcd n (q - 1) ≤ q - 1 :=
    Nat.le_of_dvd hq1 (Nat.gcd_dvd_right n (q - 1))
  have hq2sub : q ^ 2 - 1 = (q - 1) * (q + 1) := by
    have h := Nat.pow_two_sub_pow_two q 1
    rw [show (1 : ℕ) ^ 2 = 1 by norm_num] at h
    rw [h]; ring
  have hPge : (q ^ 2 - 1) * (q ^ 3 - 1) * (q ^ 4 - 1) ≤ ∏ i ∈ Finset.Icc 2 n, (q ^ i - 1) :=
    fld_lieOrd_gt_psl_aux1 q n hq hn
  have hX : 20161 ≤ q ^ k * (q + 1) * (q ^ 3 - 1) * (q ^ 4 - 1) :=
    fld_lieOrd_gt_psl_aux2 hq hA
  calc 20161 * Nat.gcd n (q - 1) ≤ 20161 * (q - 1) := Nat.mul_le_mul_left _ hgle
    _ ≤ (q ^ k * (q + 1) * (q ^ 3 - 1) * (q ^ 4 - 1)) * (q - 1) :=
        Nat.mul_le_mul_right _ hX
    _ = q ^ k * ((q ^ 2 - 1) * (q ^ 3 - 1) * (q ^ 4 - 1)) := by rw [hq2sub]; ring
    _ ≤ q ^ k * (∏ i ∈ Finset.Icc 2 n, (q ^ i - 1)) := Nat.mul_le_mul_left _ hPge

private theorem fld_lieOrd_gt_psl_aux4 {n f : ℕ} (hf : 1 ≤ f) (hn : 5 ≤ n ∨ (n = 4 ∧ 2 ≤ f)) :
    1024 ≤ (2 ^ f) ^ ((n - 1) * n / 2) := by
  rcases hn with hn5 | ⟨rfl, hf2⟩
  · have hk : 10 ≤ (n - 1) * n / 2 := by
      rw [Nat.le_div_iff_mul_le (by norm_num : 0 < 2)]
      have h : 4 * 5 ≤ (n - 1) * n := Nat.mul_le_mul (by omega) hn5
      norm_num at h ⊢
      omega
    have hfk : 10 ≤ f * ((n - 1) * n / 2) := by
      have : 1 * 10 ≤ f * ((n - 1) * n / 2) := Nat.mul_le_mul hf hk
      simpa using this
    calc 1024 = 2 ^ 10 := by norm_num
      _ ≤ 2 ^ (f * ((n - 1) * n / 2)) := Nat.pow_le_pow_right (by norm_num) hfk
      _ = (2 ^ f) ^ ((n - 1) * n / 2) := by rw [pow_mul]
  · have hq : 4 ≤ 2 ^ f := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf2
    rw [show (4 - 1) * 4 / 2 = 6 by norm_num]
    calc 1024 ≤ 4 ^ 6 := by norm_num
      _ ≤ (2 ^ f) ^ 6 := Nat.pow_le_pow_left hq 6

private theorem fld_lieOrd_gt_psl_aux5 {n q : ℕ} (hq : 2 ≤ q) (hn : 4 ≤ n)
    (hA : 1024 ≤ q ^ ((n - 1) * n / 2)) : 20160 < ordA (n - 1) q := by
  have hq1 : 0 < q - 1 := by omega
  have hgpos : 0 < Nat.gcd n (q - 1) := Nat.gcd_pos_of_pos_right n hq1
  have hord : ordA (n - 1) q
      = q ^ ((n - 1) * n / 2) * (∏ i ∈ Finset.Icc 2 n, (q ^ i - 1)) /
          Nat.gcd n (q - 1) := by
    unfold ordA
    rw [Nat.sub_add_cancel (by omega)]
  rw [hord]
  exact lt_of_lt_of_le (by norm_num)
    ((Nat.le_div_iff_mul_le hgpos).mpr (fld_lieOrd_gt_psl_aux3 hq hn hA))

theorem fld_lieOrd_gt_psl {n f : ℕ} (hf : 1 ≤ f) (hn : 5 ≤ n ∨ (n = 4 ∧ 2 ≤ f)) :
    20160 < CFSG.EvenSmallLie.CatalogOrders.lieOrd .PSL n (2 ^ f) := by
  have hq : 2 ≤ 2 ^ f := by
    have := Nat.pow_le_pow_right (show 0 < 2 by norm_num) hf
    simpa using this
  have hn4 : 4 ≤ n := by rcases hn with h | ⟨rfl, -⟩ <;> omega
  show 20160 < ordA (n - 1) (2 ^ f)
  exact fld_lieOrd_gt_psl_aux5 hq hn4 (fld_lieOrd_gt_psl_aux4 hf hn)

private theorem fld_lieOrd_gt_omegaPlus_aux1 (q n : ℕ) (hq : 2 ≤ q) (hn : 4 ≤ n) :
    q ^ 2 - 1 ≤ ∏ i ∈ Finset.Icc 1 (n - 1), (q ^ (2 * i) - 1) := by
  have hmem1 : 1 ∈ Finset.Icc 1 (n - 1) := Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
  have h := Finset.single_le_prod (s := Finset.Icc 1 (n - 1))
    (f := fun i => q ^ (2 * i) - 1) (fun i hi => by
      show 1 ≤ q ^ (2 * i) - 1
      have hi1 : 1 ≤ i := (Finset.mem_Icc.mp hi).1
      have h2 : 2 ≤ 2 * i := by omega
      have h4 : 4 ≤ q ^ 2 := by
        have h : 2 * 2 ≤ q * q := Nat.mul_le_mul hq hq
        norm_num at h
        simpa [pow_two] using h
      have hpow : q ^ 2 ≤ q ^ (2 * i) := Nat.pow_le_pow_right (by omega) h2
      omega) hmem1
  simpa using h

private theorem fld_lieOrd_gt_omegaPlus_aux2 {n q : ℕ} (hq : 2 ≤ q) (hqeven : Even q)
    (hn : 4 ≤ n) : 20160 < ordD n q := by
  have hEven : Even (q ^ n) := hqeven.pow_of_ne_zero (by omega)
  have hodd : Odd (q ^ n - 1) := by
    obtain ⟨m, hm⟩ := hEven
    have hm1 : 1 ≤ m := by
      have hpos : 0 < q ^ n := by positivity
      omega
    refine ⟨m - 1, ?_⟩
    rw [hm]; omega
  have hg : Nat.gcd 4 (q ^ n - 1) = 1 := by
    have h : Nat.Coprime (2 ^ 2) (q ^ n - 1) :=
      (Nat.coprime_pow_left_iff (by norm_num : 0 < 2) 2 (q ^ n - 1)).mpr
        (Nat.coprime_two_left.mpr hodd)
    simpa using h
  rw [ordD, hg, Nat.div_one]
  have hprod := fld_lieOrd_gt_omegaPlus_aux1 q n hq hn
  have hA : 4096 ≤ q ^ (n * (n - 1)) := by
    have hk : 12 ≤ n * (n - 1) := by
      have h : 4 * 3 ≤ n * (n - 1) := Nat.mul_le_mul hn (by omega)
      norm_num at h ⊢
      exact h
    calc 4096 = 2 ^ 12 := by norm_num
      _ ≤ 2 ^ (n * (n - 1)) := Nat.pow_le_pow_right (by norm_num) hk
      _ ≤ q ^ (n * (n - 1)) := Nat.pow_le_pow_left hq _
  have hB : 15 ≤ q ^ n - 1 := by
    have h16 : 16 ≤ q ^ n := by
      calc 16 = 2 ^ 4 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
        _ ≤ q ^ n := Nat.pow_le_pow_left hq _
    omega
  have hC : 3 ≤ q ^ 2 - 1 := by
    have h4 : 4 ≤ q ^ 2 := by
      have h : 2 * 2 ≤ q * q := Nat.mul_le_mul hq hq
      norm_num at h
      simpa [pow_two] using h
    omega
  have hkey : 20161 ≤ q ^ (n * (n - 1)) * (q ^ n - 1) * (q ^ 2 - 1) := by
    have hbase : 20161 ≤ 4096 * 15 * 3 := by norm_num
    have hmul : 4096 * 15 * 3 ≤ q ^ (n * (n - 1)) * (q ^ n - 1) * (q ^ 2 - 1) :=
      Nat.mul_le_mul (Nat.mul_le_mul hA hB) hC
    exact le_trans hbase hmul
  have hfull : q ^ (n * (n - 1)) * (q ^ n - 1) * (q ^ 2 - 1)
      ≤ q ^ (n * (n - 1)) * (q ^ n - 1) *
          (∏ i ∈ Finset.Icc 1 (n - 1), (q ^ (2 * i) - 1)) :=
    Nat.mul_le_mul_left _ hprod
  exact lt_of_lt_of_le (by norm_num) (le_trans hkey hfull)

theorem fld_lieOrd_gt_omegaPlus {n f : ℕ} (hf : 1 ≤ f) (hn : 4 ≤ n) :
    20160 < CFSG.EvenSmallLie.CatalogOrders.lieOrd .POmegaPlus n (2 ^ f) := by
  have hq : 2 ≤ 2 ^ f := by
    have := Nat.pow_le_pow_right (show 0 < 2 by norm_num) hf
    simpa using this
  have hqeven : Even (2 ^ f) := (even_two : Even (2 : ℕ)).pow_of_ne_zero (by omega)
  show 20160 < ordD n (2 ^ f)
  exact fld_lieOrd_gt_omegaPlus_aux2 hq hqeven hn

private theorem fld_lieOrd_gt_omegaMinus_aux1 {n q : ℕ} (hq : 2 ≤ q) (hqeven : Even q)
    (hn : 4 ≤ n) : 20160 < ordTwistedD n q := by
  have hEven : Even (q ^ n) := hqeven.pow_of_ne_zero (by omega)
  have hodd : Odd (q ^ n + 1) := by
    obtain ⟨m, hm⟩ := hEven
    refine ⟨m, ?_⟩
    rw [hm]; ring
  have hg : Nat.gcd 4 (q ^ n + 1) = 1 := by
    have h : Nat.Coprime (2 ^ 2) (q ^ n + 1) :=
      (Nat.coprime_pow_left_iff (by norm_num : 0 < 2) 2 (q ^ n + 1)).mpr
        (Nat.coprime_two_left.mpr hodd)
    simpa using h
  rw [ordTwistedD, hg, Nat.div_one]
  have hprod := fld_lieOrd_gt_omegaPlus_aux1 q n hq hn
  have hA : 4096 ≤ q ^ (n * (n - 1)) := by
    have hk : 12 ≤ n * (n - 1) := by
      have h : 4 * 3 ≤ n * (n - 1) := Nat.mul_le_mul hn (by omega)
      norm_num at h ⊢
      exact h
    calc 4096 = 2 ^ 12 := by norm_num
      _ ≤ 2 ^ (n * (n - 1)) := Nat.pow_le_pow_right (by norm_num) hk
      _ ≤ q ^ (n * (n - 1)) := Nat.pow_le_pow_left hq _
  have hB : 17 ≤ q ^ n + 1 := by
    have h16 : 16 ≤ q ^ n := by
      calc 16 = 2 ^ 4 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
        _ ≤ q ^ n := Nat.pow_le_pow_left hq _
    omega
  have hC : 3 ≤ q ^ 2 - 1 := by
    have h4 : 4 ≤ q ^ 2 := by
      have h : 2 * 2 ≤ q * q := Nat.mul_le_mul hq hq
      norm_num at h
      simpa [pow_two] using h
    omega
  have hkey : 20161 ≤ q ^ (n * (n - 1)) * (q ^ n + 1) * (q ^ 2 - 1) := by
    have hbase : 20161 ≤ 4096 * 17 * 3 := by norm_num
    have hmul : 4096 * 17 * 3 ≤ q ^ (n * (n - 1)) * (q ^ n + 1) * (q ^ 2 - 1) :=
      Nat.mul_le_mul (Nat.mul_le_mul hA hB) hC
    exact le_trans hbase hmul
  have hfull : q ^ (n * (n - 1)) * (q ^ n + 1) * (q ^ 2 - 1)
      ≤ q ^ (n * (n - 1)) * (q ^ n + 1) *
          (∏ i ∈ Finset.Icc 1 (n - 1), (q ^ (2 * i) - 1)) :=
    Nat.mul_le_mul_left _ hprod
  exact lt_of_lt_of_le (by norm_num) (le_trans hkey hfull)

theorem fld_lieOrd_gt_omegaMinus {n f : ℕ} (hf : 1 ≤ f) (hn : 4 ≤ n) :
    20160 < CFSG.EvenSmallLie.CatalogOrders.lieOrd .POmegaMinus n (2 ^ f) := by
  have hq : 2 ≤ 2 ^ f := by
    have := Nat.pow_le_pow_right (show 0 < 2 by norm_num) hf
    simpa using this
  have hqeven : Even (2 ^ f) := (even_two : Even (2 : ℕ)).pow_of_ne_zero (by omega)
  show 20160 < ordTwistedD n (2 ^ f)
  exact fld_lieOrd_gt_omegaMinus_aux1 hq hqeven hn

theorem fld_card_gt_of_lieModel {S : Type} [Group S] {t : StatedLieTag} {n f : ℕ} (hr : FldRange t n f)
    (h : CFSG.Blueprint.LieModel S t n 2 f) : 20160 < Nat.card S := by
  obtain ⟨hf, ⟨rfl, hn⟩ | ⟨rfl | rfl, hn⟩⟩ := hr
  · rw [h.card_eq_lieOrd (by omega)]
    exact fld_lieOrd_gt_psl hf hn
  · rw [h.card_eq_lieOrd (by omega)]
    exact fld_lieOrd_gt_omegaPlus hf hn
  · rw [h.card_eq_lieOrd (by omega)]
    exact fld_lieOrd_gt_omegaMinus hf hn

theorem fld_card_alt_le {S : Type} [Group S] {n : ℕ} (hn : n = 5 ∨ n = 6 ∨ n = 8)
    (e : S ≃* alternatingGroup (Fin n)) : Nat.card S ≤ 20160 := by
  rw [Nat.card_congr e.toEquiv]
  rcases hn with rfl | rfl | rfl <;>
    · rw [nat_card_alternatingGroup]
      norm_num [Nat.factorial]

private theorem fld_card_lie_amb_le_aux1 {l : ℕ} (hl : l.Prime) (q : TauCeti.PrimePower)
    (h : q.card = l) : q.p = l ∧ q.exponent = 1 := by
  have hdvd : q.p ∣ q.card := by
    rw [TauCeti.PrimePower.card_def]
    exact dvd_pow_self q.p q.exponent_pos.ne'
  rw [h] at hdvd
  have hp : q.p = l := (Nat.prime_dvd_prime_iff_eq q.prime_p hl).1 hdvd
  refine ⟨hp, ?_⟩
  have hc : q.p ^ q.exponent = l := (TauCeti.PrimePower.card_def q).symm.trans h
  rw [hp] at hc
  exact Nat.pow_right_injective hl.two_le (by simpa using hc)

theorem fld_card_lie_amb_le {S : Type} [Group S] {d : TauCeti.ValidLieTypeIndex}
    (hd : ambiguousChev 2 (TauCeti.CFSGIndex.lie d)) (e : S ≃* (TauCeti.CFSGIndex.lie d).Group) :
    Nat.card S ≤ 20160 := by
  obtain ⟨ld, hv⟩ := d
  cases ld with
  | A r q =>
    rcases r with _ | _ | r
    · simp [ambiguousChev] at hd
    · simp only [ambiguousChev] at hd
      rcases hd with ⟨h7, -⟩ | ⟨h8, h23⟩
      · obtain ⟨hp, he⟩ := fld_card_lie_amb_le_aux1 Nat.prime_seven q h7
        have hm : CFSG.Blueprint.LieModel S .PSL 2 7 1 := by
          have hthis := CFSG.Models.lieModel_A 1 q hv e
          rw [hp, he] at hthis
          exact hthis.toBlueprint (by decide)
        have := CFSG.Open.StatedAPI.card_of_statedClassicalModel_psl_two_seven
          (hm.statedClassicalModel (by decide))
        omega
      · simp at h23
    · simp [ambiguousChev] at hd
  | twistedA r q =>
    rcases r with _ | _ | _ | _ | r
    · simp [ambiguousChev] at hd
    · simp [ambiguousChev] at hd
    · simp only [ambiguousChev] at hd
      obtain ⟨h3, -⟩ := hd
      obtain ⟨hp, he⟩ := fld_card_lie_amb_le_aux1 Nat.prime_three q h3
      have hm : CFSG.Blueprint.LieModel S .PSU 3 3 1 := by
        have hthis := CFSG.Models.lieModel_twistedA 2 q hv e
        have hc : TauCeti.ValidLieTypeIndex.characteristic ⟨.twistedA 2 q, hv⟩ = q.p :=
          TauCeti.LieTypeIndex.characteristic_twistedA 2 q
        have hf : TauCeti.ValidLieTypeIndex.fieldExponent ⟨.twistedA 2 q, hv⟩ = q.exponent :=
          TauCeti.LieTypeIndex.fieldExponent_twistedA 2 q
        rw [hc, hf, hp, he] at hthis
        exact hthis.toBlueprint (by decide)
      have := CFSG.Blueprint.LieModel.card_psu_three_three hm
      omega
    · simp only [ambiguousChev] at hd
      obtain ⟨h2, h23⟩ := hd
      simp at h23
    · simp [ambiguousChev] at hd
  | _ => simp [ambiguousChev] at hd

theorem fld_card_le_of_ambiguousChev {S : Type} [Group S] (h : catalogIs S (ambiguousChev 2)) :
    Nat.card S ≤ 20160 := by
  obtain ⟨i, hi, ⟨e⟩⟩ := h
  cases i with
  | alternating n hn =>
    exact fld_card_alt_le (n := n) (by simp only [ambiguousChev] at hi; omega) e
  | lie d => exact fld_card_lie_amb_le hi e
  | _ => exact hi.elim

theorem fld_exists_char2_index {S : Type} [Group S] (h : IsChevSimple 2 S) (hbig : 20160 < Nat.card S) :
    ∃ d : TauCeti.ValidLieTypeIndex, d.1.characteristic = 2 ∧
      Nonempty (S ≃* (TauCeti.CFSGIndex.lie d).Group) := by
  rcases h with ⟨i, hi, ⟨e⟩⟩ | h
  · cases i with
    | lie d => exact ⟨d, hi, ⟨e⟩⟩
    | _ => exact hi.elim
  · exact absurd hbig (not_lt.2 (fld_card_le_of_ambiguousChev h))

