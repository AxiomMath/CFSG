theorem fld_lieModel_of_isOmMA {S : Type} [Group S] {n : ℕ} (hn : 4 ≤ n)
    (h : catalogIs S (isOmMA n 2)) : CFSG.Blueprint.LieModel S .POmegaMinus n 2 1 := by
  obtain ⟨i, hi, ⟨e⟩⟩ := h
