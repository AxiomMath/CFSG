    rw [hr, hp, he] at hm
    exact CFSG.Models.LieModel.toBlueprint (by simp [CFSG.Blueprint.classicalTags]) hm
  · omega

private theorem fld_lieModel_of_isOmPA_aux1 {i : TauCeti.CFSGIndex} {n q : ℕ}
    (h : isOmP n q i) :
    ∃ (r : ℕ) (qq : TauCeti.PrimePower) (hv : (TauCeti.LieTypeIndex.D r qq).Valid),
      r = n ∧ qq.card = q ∧ 4 ≤ r ∧ i = TauCeti.CFSGIndex.lie ⟨.D r qq, hv⟩ := by
  cases i with
  | cyclic p hp => simp [onLie, isOmP] at h
  | alternating m hm => simp [onLie, isOmP] at h
  | sporadic s => simp [onLie, isOmP] at h
  | lie idx =>
    obtain ⟨d, hv⟩ := idx
    cases d with
    | D r qq =>
      have h' : r = n ∧ qq.card = q := h
      have hrange : 4 ≤ r := by
        have hv' := ((TauCeti.LieTypeIndex.valid_iff (.D r qq)).mp hv).1
        simpa [TauCeti.LieTypeIndex.inStandardRange_iff] using hv'
      exact ⟨r, qq, hv, h'.1, h'.2, hrange, rfl⟩
    | _ => simp [onLie, isOmP] at h

theorem fld_lieModel_of_isOmPA {S : Type} [Group S] {n k : ℕ} (hk : 1 ≤ k) (hn : 3 ≤ n)
    (hnk : k = 1 → 5 ≤ n) (h : catalogIs S (isOmPA n (2 ^ k))) :
    (4 ≤ n ∧ CFSG.Blueprint.LieModel S .POmegaPlus n 2 k) ∨
      (n = 3 ∧ 2 ≤ k ∧ CFSG.Blueprint.LieModel S .PSL 4 2 k) := by
  obtain ⟨i, hi, ⟨e⟩⟩ := h
  rcases hi with h1 | ⟨hn3, h2⟩
  · obtain ⟨r, qq, hv, hr, hq, hrange, rfl⟩ := fld_lieModel_of_isOmPA_aux1 h1
    obtain ⟨hp, he⟩ := fld_lieModel_of_isLnA_aux1 hk hq
    have hn0 : n ≠ 0 := by omega
    have hm := CFSG.Models.lieModel_D r qq hv e
    rw [hr, hp, he] at hm
    exact Or.inl ⟨by omega, Or.inl ⟨by simp [CFSG.Blueprint.classicalTags],
      CFSG.Models.LieModel.statedClassicalModel_of_ne_zero hn0 hm⟩⟩
  · rcases h2 with h2a | ⟨h42, -⟩ | ⟨h42, -⟩ | ⟨h43, -⟩ | ⟨_, h2e⟩
    · obtain ⟨r, qq, hv, hr, hq, rfl⟩ := fld_lieModel_of_isLnA_aux2 h2a
      obtain ⟨hp, he⟩ := fld_lieModel_of_isLnA_aux1 hk hq
      have hdup := ((TauCeti.LieTypeIndex.valid_iff (.A r qq)).mp hv).2
      have hkne : k ≠ 1 := by
        intro hk1
        apply hdup
        rw [TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
        right; right
        exact ⟨by omega, by rw [hq, hk1]; norm_num⟩
      have h2k : 2 ≤ k := by omega
      have hm := CFSG.Models.lieModel_A r qq hv e
      rw [hr, hp, he] at hm
      exact Or.inr ⟨hn3, h2k, CFSG.Models.LieModel.toBlueprint
        (by simp [CFSG.Blueprint.classicalTags]) hm⟩
    · omega
    · omega
    · omega
    · obtain ⟨hk2, -⟩ := h2e
      have hk1 : k = 1 := Nat.pow_right_injective (a := 2) le_rfl (by simpa [hk2])
      have := hnk hk1
      omega

theorem fld_catalogIs_isLnA_of_lieModel {S : Type} [Group S] {n g : ℕ} (hr : FldRange .PSL n g)
    (h : CFSG.Blueprint.LieModel S .PSL n 2 g) : catalogIs S (isLnA n (2 ^ g)) := by
  have hn : 5 ≤ n ∨ (n = 4 ∧ 2 ≤ g) := by
    rcases hr.2 with ⟨-, h⟩ | ⟨h, -⟩
    · exact h
    · rcases h with h | h <;> exact absurd h (by decide)
  have hg : 1 ≤ g := hr.1
  have hS : StatedClassicalModel S .PSL n 2 g :=
    h.statedClassicalModel (by simp [CFSG.Blueprint.classicalTags])
  obtain ⟨K, hfield, hfinite, hK, e⟩ := hS.2
  let _ := hfield
  let _ := hfinite
  obtain ⟨e⟩ := e
  have hp : Nat.Prime 2 := Nat.prime_two
  let _ : Fact (Nat.Prime 2) := ⟨hp⟩
  let q : PrimePower := ⟨2, g, hp, hg⟩
  have h2g : 2 ≤ g → (2 : ℕ) ^ g ≠ 2 := by
    intro hg2 hc
    have : g = 1 := Nat.pow_right_injective (by norm_num : 2 ≤ 2) (hc.trans (pow_one 2).symm)
    omega
  have hdup : ¬ (LieTypeIndex.A (n - 1) q).IsDuplicateRepresentative := by
    rw [LieTypeIndex.isDuplicateRepresentative_iff]
    simp only [PrimePower.card_def, q]
    rintro (⟨hr1, -⟩ | ⟨hr2, -⟩ | ⟨hr3, hq⟩)
    · omega
    · omega
    · have hg2 : 2 ≤ g := by
        rcases hn with h | ⟨h4, hg2⟩
        · omega
        · exact hg2
      exact h2g hg2 hq
  have hv : (LieTypeIndex.A (n - 1) q).Valid :=
    CFSG.ClassicalModels.linearCatalog_index_valid n 2 g hS.1 hdup
  let eK := CFSG.ClassicalModels.statedLinearModelEquivGaloisPSL K n 2 g (by omega) hK
  have hdim : n - 1 + 1 = n := by omega
  have eC := CFSG.ClassicalModels.linearCatalogCandidateEquivPSL (n - 1) q hv
  have eC' : (ValidLieTypeIndex.Group ⟨LieTypeIndex.A (n - 1) q, hv⟩) ≃*
      Matrix.ProjectiveSpecialLinearGroup (Fin n) (GaloisField 2 g) := by
    rw [hdim] at eC
    exact eC
  refine ⟨.lie ⟨LieTypeIndex.A (n - 1) q, hv⟩, ?_, ⟨(e.trans eK).trans eC'.symm⟩⟩
  simp only [isLnA, onLie, isLnEps]
  exact Or.inl ⟨hdim, by simp [q, PrimePower.card_def]⟩

theorem fld_catalogIs_isOmMA_of_lieModel {S : Type} [Group S] {n g : ℕ} (hr : FldRange .POmegaMinus n g)
    (h : CFSG.Blueprint.LieModel S .POmegaMinus n 2 g) : catalogIs S (isOmMA n (2 ^ g)) := by
  have hn : 4 ≤ n := by
    rcases hr.2 with ⟨h, -⟩ | ⟨-, h⟩
    · exact absurd h (by decide)
    · exact h
  have hg : 1 ≤ g := hr.1
  have hS : StatedClassicalModel S .POmegaMinus n 2 g :=
    h.statedClassicalModel (by simp [CFSG.Blueprint.classicalTags])
  obtain ⟨K, hfield, hfinite, hK, b, c, hirr, ⟨θ⟩⟩ := hS.2
  let _ := hfield
  let _ := hfinite
  let q : PrimePower := ⟨2, g, Nat.prime_two, hg⟩
  have hv : (LieTypeIndex.twistedD n q).Valid := by
    rw [LieTypeIndex.valid_iff, LieTypeIndex.inStandardRange_iff,
      LieTypeIndex.isDuplicateRepresentative_iff]
    exact ⟨hn, not_false⟩
  obtain ⟨b₀, c₀, hirr₀, ⟨eT⟩⟩ :=
    CFSG.RankThree.PartTwo.Census.Carrier.SpinD.exists_typeTwistedDGroupEquivStatedProj_of_valid n q hv
  obtain ⟨φ⟩ := CFSG.ClassicalModels.nonempty_ringEquiv_validIndex_fixedField ⟨.twistedD n q, hv⟩ K (by
    simp [ValidLieTypeIndex.fieldOrder, q, hK])
  have _ : Finite ↥(ValidLieTypeIndex.fixedField ⟨.twistedD n q, hv⟩) :=
    CFSG.QuasithinUnique.SQTK.finite_validIndex_fixedField _
  obtain ⟨e2⟩ := CFSG.Blueprint.EvenSource.nonempty_statedOmegaMinus_equiv (n := n) (by omega)
    (CFSG.ClassicalInvolution.Upgrade.irreducible_map φ hirr) hirr₀
  let e1 := CFSG.Adapters.RankTwoModelTransports.statedProjCongr
    (CFSG.Adapters.RankTwoModelTransports.glCongr φ)
    (CFSG.ClassicalInvolution.Upgrade.map_statedOmega φ
      (CFSG.ClassicalInvolution.Upgrade.statedQuadMinus_comp (n := n) (b := b) (c := c) φ rfl rfl))
    (CFSG.Adapters.RankTwoModelTransports.glCongr_statedScalars φ)
  refine ⟨.lie ⟨.twistedD n q, hv⟩, Or.inl ⟨rfl, ?_⟩, ⟨((θ.trans e1).trans e2).trans eT.symm⟩⟩
  simp [q, PrimePower.card_def]

