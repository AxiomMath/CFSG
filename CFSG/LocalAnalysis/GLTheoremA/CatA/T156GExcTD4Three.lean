theorem fixAlt_of_fixSub_g2 {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {R : Type} [Group R]
    {I : Set (MulAut R)} {f : MulAut R} (hZ : Subgroup.center R = ⊥)
    (hI : ∀ φ ∈ I, φ ^ p = 1 → φ ∈ Set.range (MulAut.conj : R →* MulAut R))
    {k : Type} [Field k] [Finite k] {m : ℕ} (hm : 1 ≤ m) (hk : Nat.card k = 2 ^ m)
    (E : adjointGroup Tag.G2 k ≃* ↥(ggFixSub f)) : FixAlt p I f := by
  rcases Nat.lt_or_ge m 2 with hlt | hge
  ·
    have hk2 : Nat.card k = 2 := by rw [hk, show m = 1 by omega]; norm_num
    haveI : Fintype k := Fintype.ofFinite k
    haveI : CharP k 2 := charP_of_card_eq_prime_pow (p := 2) (f := 1)
      (by rw [← Nat.card_eq_fintype_card, hk2]; norm_num)
    have hC : StatedClassicalModel ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆ .PSU 3 3 1 := by
      rcases CFSG.Quasithin.EmptyFaithfulMultiple.g2TwoDerivedUnitaryTransport_holds k hk2 with
        ⟨-, h⟩ | ⟨h0, -⟩ | ⟨h0, -⟩ | ⟨h0, -⟩
      · exact h
      all_goals exact absurd h0 (by norm_num)
    obtain ⟨-, K₃, _, _, hK₃, ⟨eU⟩⟩ := hC
    haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    haveI : IsSimpleGroup (StatedProj (StatedSU 3 (3 ^ 1) K₃)) :=
      CFSG.ClassicalGroups.Unitary.isSimpleGroup_statedProj_statedSU K₃ 3 1 hK₃ 3 le_rfl
        (by decide)
    haveI : IsSimpleGroup ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆ := eU.isSimpleGroup
    haveI : Group.IsPerfect ↥(StatedSU 3 (3 ^ 1) K₃) :=
      CFSG.ClassicalGroups.Unitary.isPerfect_statedSU (p := 3) (f := 1) hK₃ le_rfl (by decide)
    haveI : Group.IsPerfect (StatedProj (StatedSU 3 (3 ^ 1) K₃)) :=
      Group.IsPerfect.ofSurjective (f := QuotientGroup.mk' _) (QuotientGroup.mk'_surjective _)
    obtain ⟨a, b, hab⟩ := exists_mul_ne_of_isPerfect (StatedProj (StatedSU 3 (3 ^ 1) K₃))
    have hnaX : ∃ a b : ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆, a * b ≠ b * a :=
      ⟨eU.symm a, eU.symm b, fun h => hab (by simpa using congrArg eU h)⟩
    have hZX := center_eq_bot_of_simple_noncomm hnaX
    have hsimp : IsSimpleGroup
        (LargeEvenCenterQuot ⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆) :=
      (centerQuotEquivOfBot hZX).isSimpleGroup
    have hnab : ∃ a b : LargeEvenCenterQuot ⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆,
        a * b ≠ b * a := by
      obtain ⟨a, b, hab⟩ := hnaX
      let eR := centerQuotEquivOfBot hZX
      exact ⟨eR.symm a, eR.symm b, fun h => hab (by simpa using congrArg eR h)⟩
    have hlab : GGHasLabel (⟨.G2der, 0, 1⟩ : LargeEvenLabel)
        (CFSG.Blueprint.DerivedCentralQuotient (adjointGroup Tag.G2 k)) := by
      unfold GGHasLabel CFSG.StandardType.LargeEvenRawDatum
      obtain ⟨eD⟩ := centerQuot_commutator_chevGroup_equiv k Tag.G2
      exact ⟨k, inferInstance, inferInstance, hk2, ⟨eD.symm⟩⟩
    have hmap : (commutator ↥(adjointGroup Tag.G2 k)).map E.toMonoidHom =
        commutator ↥(ggFixSub f) := by
      rw [commutator_def, commutator_def, Subgroup.map_commutator, ← MonoidHom.range_eq_map,
        MonoidHom.range_eq_top.2 E.surjective]
    have e1 : ↥(ggFixDer f) ≃* ↥⁅adjointGroup Tag.G2 k, adjointGroup Tag.G2 k⁆ :=
      (ggCommutatorEquiv (ggFixSub f)).trans
        (((Subgroup.equivMapOfInjective _ E.toMonoidHom E.injective).trans
          (MulEquiv.subgroupCongr hmap)).symm.trans
          (ggCommutatorEquiv (adjointGroup Tag.G2 k)).symm)
    have hpK : ∀ g ∈ ggFixSub f, g ^ p = 1 → g ∈ ggFixDer f :=
      pow_mem_ggFixDer_of_coprime fun g hg =>
        ⟨2, Nat.coprime_two_right.2 (hp.odd_of_ne_two hp2),
          sq_mem_ggFixDer_of_adjoint Tag.G2 E g hg⟩
    exact fixAlt_of_hasLabel (lab₀ := ⟨.G2der, 0, 1⟩)
      (R₀ := CFSG.Blueprint.DerivedCentralQuotient (adjointGroup Tag.G2 k)) hp hp2 hZ hI hpK
      ⟨le_rfl, rfl, rfl⟩ hsimp hnab hlab ⟨e1.trans (centerQuotEquivOfBot hZX).symm⟩
  ·
    have h3 : 3 ≤ Nat.card k := by
      rw [hk]
      calc 3 ≤ 2 ^ 2 := by norm_num
        _ ≤ 2 ^ m := Nat.pow_le_pow_right (by norm_num) hge
    have hq := CFSG.LieType.Steinberg.Adjoint.isQuasisimple_g2_of_three_le_card k h3
    haveI : Group.IsPerfect ↥(adjointGroup Tag.G2 k) := hq.1
    have hZk : Subgroup.center (adjointGroup Tag.G2 k) = ⊥ := center_adjointGroup_eq_bot
    have hPC : Group.IsPerfect ↥(ggFixSub f) :=
      Group.IsPerfect.ofSurjective (f := E.toMonoidHom) E.surjective
    have hdef : ggFixDer f = ggFixSub f := Subgroup.isPerfect_iff.1 hPC
    have hlab : GGHasLabel (⟨.G2, 0, m⟩ : LargeEvenLabel)
        (LargeEvenCenterQuot (adjointGroup Tag.G2 k)) := by
      unfold GGHasLabel CFSG.StandardType.LargeEvenRawDatum
      obtain ⟨eC⟩ := centerQuot_chevGroup_equiv k Tag.G2
      exact ⟨k, inferInstance, inferInstance, hk, ⟨eC.symm⟩⟩
    exact fixAlt_of_hasLabel (lab₀ := ⟨.G2, 0, m⟩) hp hp2 hZ hI (pow_mem_ggFixDer_of_eq hdef)
      ⟨hm, rfl, hge⟩ hq.2.1 hq.2.2 hlab
      ⟨(MulEquiv.subgroupCongr hdef).trans (E.symm.trans (centerQuotEquivOfBot hZk).symm)⟩

theorem factorization_card_ggTriD4R {n : ℕ} (hn : 1 ≤ n) {K : Type} [Field K] [Finite K]
    (hK : Nat.card K = (2 ^ n) ^ 3) :
    (Nat.card (GGTriD4R n K)).factorization 2 = 12 * n := by
  have hchev : CFSG.Blueprint.ChevalleyExceptionalModel (GGTriD4R n K) .trialityD4 2 n :=
    ⟨⟨Nat.prime_two, hn, rfl⟩, twistedChevalleyModel_largeEven .D4 hK⟩
  have hL : CFSG.Blueprint.LieModel (GGTriD4R n K) .trialityD4 0 2 n :=
    Or.inr (Or.inl ⟨rfl, by decide, hchev⟩)
  exact (CFSG.ComponentClassification.CatLeafProof.lieOrderFormulasInput (GGTriD4R n K)
    .trialityD4 0 2 n hchev.1 hL).2.2

theorem geomBody_td4_three {n : ℕ} (hn : 1 ≤ n) (K : Type) [Field K] [Finite K]
    (hK : Nat.card K = (2 ^ n) ^ 3) :
    GeomBody 3 ⟨.triD4, 0, n⟩ (GGTriD4R n K) (GGTriD4ID n K)
      (LargeEvenChevFieldImage LargeEvenCartanD4 K
        (LargeEvenTwistedH LargeEvenCartanD4 K LargeEvenRhoD4 n)) := by
  intro hS hna
  refine ⟨fun h => absurd ⟨rfl, rfl⟩ h, fun _ _ x hx3 hxni h2 => ?_⟩
  haveI := hS
  have hZ := center_eq_bot_of_simple_noncomm hna
  have hI : ∀ φ ∈ GGTriD4ID n K, φ ^ 3 = 1 →
      φ ∈ Set.range (MulAut.conj : GGTriD4R n K →* MulAut (GGTriD4R n K)) := by
    intro φ hφ _
    obtain ⟨r, hr⟩ := TableBExcSmallRest.chevIDImage_subset_inn_triD4 hn K hK hφ
    exact ⟨r, hr⟩
  have h6 : S10.twoPart (FP.fixNum x) = (2 ^ n) ^ 6 := by
    rw [h2]
    unfold S10.twoPart
    rw [factorization_card_ggTriD4R hn hK,
      show (2 : ℕ) ^ (12 * n) = (2 ^ n) ^ 6 * (2 ^ n) ^ 6 by ring, Nat.sqrt_eq]
  haveI : Fintype K := Fintype.ofFinite K
  haveI : CharP K 2 := charP_of_card_eq_prime_pow (p := 2) (f := n * 3)
    (by rw [← Nat.card_eq_fintype_card, hK, pow_mul])
  set σ₀ := iterateFrobeniusEquiv K 2 n with hσdef
  have hσ₀ : ∀ c, σ₀ c = c ^ 2 ^ n := fun c => by
    rw [hσdef, iterateFrobeniusEquiv_apply, iterateFrobenius_def]
  obtain ⟨e⟩ := TableBExcSmallRest.nonempty_triD4_equiv hn K hK σ₀ hσ₀
  set φ := MulAut.congr e x with hφdef
  have hφ3 : φ ^ 3 = 1 := by rw [hφdef, ← map_pow, hx3, map_one]
  have hφin : ¬ CFSG.RankThree.PartTwo.KFacts.IsInnerAut φ :=
    fun h => hxni ((CFSG.RankThree.PartTwo.KFacts.isInnerAut_congr e x).mp h)
  have e₁ : ↥(fixSubgroup x) ≃* ↥(fixSubgroup φ) := fixSubgroupCongrEquiv e x
  rcases CFSG.RankThree.PartTwo.Sec8.Item8KFacts2Proof.isStdGraphFieldConj_or_nonempty_autFix_equiv
      hn hK hσ₀ hφ3 hφin with ⟨β, hβ⟩ | he2
  ·
    obtain ⟨eG⟩ := CFSG.RankThree.PartTwo.KFacts.nonempty_fixedPoints_fieldActor_mulEquiv_g2 σ₀
      (ringChar.eq K 2)
    obtain ⟨γ, hγ, hφγ⟩ : ∃ γ : MulAut ↥(graphFixedRootGroup TwistTag.D4 K σ₀.toRingHom),
        fixSubgroup γ = (fieldActor (t := TwistTag.D4) σ₀ σ₀).toMonoidHom.eqLocus
          (MonoidHom.id _) ∧ φ = MulAut.congr β γ := by
      rcases hβ with h | h
      · exact ⟨fieldActor σ₀ σ₀, rfl, h.trans (MulEquiv.ext fun _ => rfl)⟩
      · refine ⟨(fieldActor σ₀ σ₀)⁻¹, Subgroup.ext fun y => ?_,
          h.trans (MulEquiv.ext fun _ => rfl)⟩
        show (fieldActor (t := TwistTag.D4) σ₀ σ₀)⁻¹ y = y ↔ fieldActor σ₀ σ₀ y = y
        rw [MulAut.inv_apply, MulEquiv.symm_apply_eq]
        exact eq_comm
    have hk := CFSG.RankThree.PartOne.card_fixSubfield_cube_row Nat.prime_two hn hK σ₀ hσ₀
    let E : adjointGroup Tag.G2 ↥(fixSubfield σ₀) ≃* ↥(ggFixSub x) :=
      eG.symm.trans ((MulEquiv.subgroupCongr hγ.symm).trans
        ((fixSubgroupCongrEquiv β γ).trans
          ((MulEquiv.subgroupCongr (congrArg fixSubgroup hφγ.symm)).trans
            (e₁.symm.trans (MulEquiv.subgroupCongr (Subgroup.ext fun _ => Iff.rfl))))))
    exact fixAlt_of_fixSub_g2 Nat.prime_three (by norm_num) hZ hI hn hk E
  ·
    exfalso
    obtain ⟨e2⟩ := he2
    have h3 := td4g2_pgl_case_twoPart hn hK hσ₀ e2
    have hc : Nat.card ↥(CFSG.RankThree.PartTwo.Sec4.autFix φ) = FP.fixNum x :=
      (Nat.card_congr (e₁.trans
        (MulEquiv.subgroupCongr (Subgroup.ext fun _ => Iff.rfl))).toEquiv).symm
    rw [hc, h6] at h3
    have h1 : 1 < 2 ^ n := Nat.one_lt_two_pow (by omega)
    exact absurd h3 (Nat.pow_lt_pow_right h1 (by norm_num)).ne'

theorem cAll_geomBody_td4_three {n : ℕ} (hn : 1 ≤ n) :
    MI.CAll ⟨.triD4, 0, n⟩ (GeomBody 3 ⟨.triD4, 0, n⟩) := by
  intro Q hQ
  dsimp only [CFSG.Assembly.LargeEvenRawDatum] at hQ ⊢
  exact recipeTwisted_and (fun K _ _ hK => geomBody_td4_three hn K hK) hQ

