private theorem inducesInnerMod_or_shape_of_innerDiagMarking
    {G : Type} [Group G] [Finite G] {p : ℕ} {L E : Subgroup G} {b : G}
    (hp : p.Prime) (hodd : p ≠ 2) (hmark : InnerDiagMarking E L)
    (hb : b ∈ E) (helem : IsElemAbelian p E)
    (hq : CFSG.Open.IsQuasisimple ↥L) (hdvd : p ∣ Nat.card ↥L) :
    InducesInnerMod p L b ∨ I171.I171LieShapeAt p L := by
  obtain ⟨-, lab, hlab, hraw⟩ :=
    CFSG.StandardType.Canonical.largeEvenMarking_markedModel hmark
  by_cases hpd : p ∣ CFSG.LocalAnalysis.GLTheoremA.rk2DiagIndex lab
  · right
    obtain ⟨R, _, I, F, hs, hna, θ, hP, hM⟩ :=
      CFSG.StandardType.Canonical.largeEvenRawDatum_exists hraw
    obtain ⟨eP⟩ := pSimple_equiv_centerQuot_of_dvd hp hq hdvd
    have hshapeR : catalogIs R (onLie (I171.I171LieShape p)) := by
      have h1 : ¬ p ∣ 1 := Nat.Prime.not_dvd_one hp
      cases htag : lab.tag
      case A => exact shape_A_of_label hp hlab htag hM hpd
      case twA => exact shape_twA_of_label hp hlab htag hM hpd
      case E6 => exact shape_E6_of_label hp hlab htag hM hpd
      case twE6 => exact shape_twE6_of_label hp hlab htag hM hpd
      all_goals
        exact absurd (by
          have h2 : CFSG.LocalAnalysis.GLTheoremA.rk2DiagIndex lab = 1 := by
            simp [CFSG.LocalAnalysis.GLTheoremA.rk2DiagIndex, htag]
          rw [h2] at hpd
          exact hpd) h1
    have hshapeZ : catalogIs (↥L ⧸ Subgroup.center ↥L) (onLie (I171.I171LieShape p)) :=
      (CFSG.LocalAnalysis.GLTheoremA.catalogIs_congr θ
        (Q := onLie (I171.I171LieShape p))).mpr hshapeR
    exact (CFSG.LocalAnalysis.GLTheoremA.catalogIs_congr eP
      (Q := onLie (I171.I171LieShape p))).mp hshapeZ
  · left
    haveI : Fact p.Prime := ⟨hp⟩
    have hstep : GLARawDatum lab (fun R _ I F =>
        (IsSimpleGroup R ∧ (∃ a b : R, a * b ≠ b * a) ∧
          ∃ θ : ↥L ⧸ Subgroup.center ↥L ≃* R,
            (E ≤ Subgroup.normalizer (L : Set G) ∧
              ∀ a ∈ E, ∃ φ ∈ I, LargeEvenInduces θ
                (fun l l' => (l' : G) = a⁻¹ * l * a) φ) ∧
            CFSG.StandardType.MarkedModel lab R) ∧
        (∀ E : Subgroup (MulAut R),
          E ≤ Subgroup.closure (I ∪ Set.range (MulAut.conj : R →* MulAut R)) →
            IsPGroup p E → E ≤ (MulAut.conj : R →* MulAut R).range)) :=
      CFSG.LocalAnalysis.GLTheoremA.rk2_pSubgroup_le_inn' (lab := lab) hlab hp
        hodd hpd (fun R _ I F =>
          (IsSimpleGroup R ∧ (∃ a b : R, a * b ≠ b * a) ∧
            ∃ θ : ↥L ⧸ Subgroup.center ↥L ≃* R,
              (E ≤ Subgroup.normalizer (L : Set G) ∧
                ∀ a ∈ E, ∃ φ ∈ I, LargeEvenInduces θ
                  (fun l l' => (l' : G) = a⁻¹ * l * a) φ) ∧
              CFSG.StandardType.MarkedModel lab R)) hraw
    obtain ⟨R, hR, I, F, hQ, hIinn⟩ :=
      CFSG.StandardType.Canonical.largeEvenRawDatum_exists hstep
    obtain ⟨hs, hna, θ, hP, hM⟩ := hQ
    have hbN : b ∈ Subgroup.normalizer (L : Set G) := hP.1 hb
    have hbp : b ^ p = 1 := helem.2 b hb
    obtain ⟨φ, hφI, hφind⟩ := hP.2 b hb
    have hφpow : φ ^ p = 1 := largeEvenInduces_pow_eq_one hbN hφind hbp
    have hφp : IsPGroup p (Subgroup.zpowers φ) := by
      rcases hp.eq_one_or_self_of_dvd (orderOf φ)
        (orderOf_dvd_of_pow_eq_one hφpow) with h1 | hp'
      · exact IsPGroup.of_card (n := 0) (by rw [Nat.card_zpowers, h1, pow_zero])
      · exact IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hp', pow_one])
    have hle : Subgroup.zpowers φ ≤
        Subgroup.closure (I ∪ Set.range (MulAut.conj : R →* MulAut R)) :=
      Subgroup.zpowers_le_of_mem (Subgroup.subset_closure (Set.mem_union_left _ hφI))
    have hinner : φ ∈ Set.range (MulAut.conj : R →* MulAut R) :=
      hIinn (Subgroup.zpowers φ) hle hφp (Subgroup.mem_zpowers φ)
    obtain ⟨r, hr⟩ := hinner
    refine inducesInnerMod_of_marked_conj (R := R) (θ := θ) (r := r) hbN ?_ ?_
    · exact Group.isPerfect_def.mpr hq.1
    · rw [hr]
      exact hφind

theorem outHalf_holds : OutHalf := by
  intro G _ _ p L J E d b hS hbE
  have hqO : CFSG.Open.IsQuasisimple ↥L :=
    (CFSG.Foundations.SteinbergCA.quasisimple_iff ↥L).2.2.1.mp hS.qs
  have hdvdJ : p ∣ Nat.card ↥J :=
    CFSG.LocalAnalysis.GLTheoremB.MovingAround.Claims1110d.prime_dvd_card_of_glaPComponent
      hS.prime hS.pcomp
  have hJleL : J ≤ L := hS.pcomp.1.trans inf_le_left
  have hdvdL : p ∣ Nat.card ↥L := hdvdJ.trans (Subgroup.card_dvd_of_le hJleL)
  have hLself : GLAPComponent p L L :=
    glaPComponent_self_of_dvd_card hS.prime hqO hdvdL
  have hmark : InnerDiagMarking E L := (innDiagOn_iff hLself hqO).2 hS.idiag
  exact inducesInnerMod_or_shape_of_innerDiagMarking hS.prime hS.odd hmark hbE hS.elem hqO hdvdL

end CFSG.LocalAnalysis.GLTheoremA.F151

