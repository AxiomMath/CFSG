theorem i67At_holds (G : Type) [Group G] [Finite G] (p : ℕ) : I67At G p := by
  intro hp hp2 X L B _hX hL hchev hevO hoddC hB hBN hcard
  obtain ⟨E, hE, hE3⟩ := exists_elemAb_chevAut hp hL hB hBN hcard
  have hGA : CFSG.Open.GriessAllModelsStatement :=
    CFSG.Milestones.cl_lit_griess_schur_multipliers_all_models_statement
  have hQ := isQuasisimple_QT hp hL
  have hQe := even_center_QT hevO hoddC
  have hφ := quotCenterQT hL
  rcases hchev with ⟨j, hj, ⟨f⟩⟩ | ⟨j, hj, ⟨f⟩⟩
  · cases j with
    | lie d =>
      have hc : d.1.characteristic = 2 := hj
      rcases evenLie hGA hQ hQe d hc (hφ.trans f) with h | h
      · exact ⟨_, h, ⟨f⟩⟩
      · exact (no_seven hp hp2 h f hE hE3).elim
    | _ => exact (show False from hj).elim
  · cases j with
    | alternating n h =>
      have h5 : n = 5 ∨ n = 6 ∨ n = 8 := by
        simp only [ambiguousChev] at hj
        rcases hj with ⟨h1, -⟩ | ⟨h1, -⟩ | ⟨h1, -⟩ <;> simp [h1]
      exact (no_seven hp hp2 (Or.inr (Or.inr (Or.inr (Or.inr ⟨n, h, rfl, h5⟩)))) f hE hE3).elim
    | lie d =>
      obtain ⟨d, hv⟩ := d
      cases d with
      | A r q =>
        exact (no_seven hp hp2 (sevenIdx_of_ambig_A hj) f hE hE3).elim
      | twistedA r q =>
        exact (not_even_of_ambig_twA hGA hQ hQe hj (hφ.trans f)).elim
      | _ => exact (show False from hj).elim
    | _ => exact (show False from hj).elim

