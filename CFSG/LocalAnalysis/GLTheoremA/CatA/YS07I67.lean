  obtain ⟨rfl, h2⟩ := exc_POmegaPlus_ne (chev2_exc_ne hGA hQ hm hev)
  have hc : q.card = 2 := by rw [PrimePower.card_def, hq2, h2]; norm_num
  exact Or.inl (Or.inr (Or.inl hc))

theorem evenTwD
    {r : ℕ} {q : PrimePower} (hv : (LieTypeIndex.twistedD r q).Valid) (hq2 : q.p = 2)
    (e : Q ⧸ Subgroup.center Q ≃* ValidLieTypeIndex.Group ⟨.twistedD r q, hv⟩) :
