  | tits => exact (chev2_trivial_exc_false hGA hQ hev (CFSG.Models.lieModel_of_namesTag
      (t := .Tits) (p := 2) (f := 1) ⟨Nat.prime_two, le_rfl, rfl, rfl, rfl⟩ ⟨_, hv⟩ ⟨rfl, rfl⟩ e)
