theorem conj_inj_of_center_bot {M : Type} [Group M] (hc : Subgroup.center M = ⊥) :
    Function.Injective (MulAut.conj : M →* MulAut M) := by
  rw [injective_iff_map_eq_one]
  intro g hg
  have hgz : g ∈ Subgroup.center M := by
    rw [Subgroup.mem_center_iff]
    intro h
    have := congrArg (fun φ : MulAut M => φ h) hg
    simp only [MulAut.conj_apply, MulAut.one_apply] at this
    calc h * g = (g * h * g⁻¹) * g := by rw [this]
      _ = g * h := by group
  rw [hc, Subgroup.mem_bot] at hgz
  exact hgz

theorem no_L27_core {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {F : Type} [Field F] [Finite F]
    (hF : Nat.card F = 7) {E : Subgroup (MulAut (CFSG.GorensteinWalter.PSL2 F))}
