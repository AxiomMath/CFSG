theorem exists_elemAb_chevAut {G : Type} [Group G] [Finite G] {p : ℕ} {X L B : Subgroup G}
    (hp : p.Prime) (hL : CFSG.Open.GLAPComponent p X L) (hB : CFSG.Open.IsElemAbelian p B)
    (hBN : B ≤ Subgroup.normalizer (L : Set G))
    (hcard : p ^ 3 * Nat.card ↥(B ⊓ centModSubgroup p L) ≤ Nat.card B) :
    ∃ E : Subgroup (MulAut (PSimple p L)), CFSG.Open.IsElemAbelian p E ∧ p ^ 3 ≤ Nat.card E := by
  let ψ : ↥B →* MulAut (PSimple p L) := (chevAut p L).comp (Subgroup.inclusion hBN)
  refine ⟨ψ.range, ⟨⟨⟨fun a b => ?_⟩⟩, ?_⟩, ?_⟩
  · rcases a with ⟨a, x, rfl⟩
    rcases b with ⟨b, y, rfl⟩
    apply Subtype.ext
    simp only [Subgroup.coe_mul, ← map_mul]
    rw [hB.1.is_comm.comm x y]
  · rintro _ ⟨x, rfl⟩
    have hxp : x ^ p = 1 := Subtype.ext (by simpa using hB.2 (x : G) x.2)
    rw [← map_pow, hxp, map_one]
  · have hkerle : Nat.card ψ.ker ≤ Nat.card ↥(B ⊓ centModSubgroup p L) := by
      have hsub : ψ.ker.map B.subtype ≤ B ⊓ centModSubgroup p L := by
        rintro _ ⟨b, hb, rfl⟩
        have h1 : chevAut p L ⟨(b : G), hBN b.2⟩ = 1 := hb
        exact Subgroup.mem_inf.2 ⟨b.2, centMod_iff.1 ((chevAut_eq_one_iff hp hL (hBN b.2)).1 h1)⟩
      rw [← Subgroup.card_map_of_injective (f := B.subtype) Subtype.val_injective]
      exact Subgroup.card_le_of_le hsub
    have hlag := Subgroup.card_eq_card_quotient_mul_card_subgroup ψ.ker
    have hquot : Nat.card (↥B ⧸ ψ.ker) = Nat.card ψ.range :=
      Nat.card_congr (QuotientGroup.quotientKerEquivRange ψ).toEquiv
    have hpos : 0 < Nat.card ↥(B ⊓ centModSubgroup p L) := Nat.card_pos
    rw [hlag, hquot] at hcard
    have h2 := le_trans hcard (Nat.mul_le_mul_left _ hkerle)
    exact Nat.le_of_mul_le_mul_right h2 hpos

