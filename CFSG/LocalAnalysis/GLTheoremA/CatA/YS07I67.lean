@[expose] def sevenIdx (j : TauCeti.CFSGIndex) : Prop :=
  (∃ (q : PrimePower) (hv : (LieTypeIndex.A 2 q).Valid), j = .lie ⟨.A 2 q, hv⟩ ∧ q.card = 4) ∨
  (∃ (q : PrimePower) (hv : (LieTypeIndex.G2 q).Valid), j = .lie ⟨.G2 q, hv⟩ ∧ q.card = 4) ∨
  (∃ (m : ℕ) (hv : (LieTypeIndex.suzuki m).Valid), j = .lie ⟨.suzuki m, hv⟩ ∧ m = 1) ∨
  (∃ (q : PrimePower) (hv : (LieTypeIndex.A 1 q).Valid), j = .lie ⟨.A 1 q, hv⟩ ∧ q.card = 7) ∨
  (∃ (n : ℕ) (h : 5 ≤ n), j = .alternating n h ∧ (n = 5 ∨ n = 6 ∨ n = 8))

@[expose] def evenList (j : TauCeti.CFSGIndex) : Prop := S9.isList67 j ∨ sevenIdx j

theorem odd_two_pow_sub_one {f : ℕ} (hf : 1 ≤ f) : Odd (2 ^ f - 1) := by
  have h1 : 2 ∣ 2 ^ f := dvd_pow_self 2 (by omega)
  have h2 : 1 ≤ 2 ^ f := Nat.one_le_two_pow
  rw [Nat.odd_iff]; omega

theorem odd_two_pow_add_one {f : ℕ} (hf : 1 ≤ f) : Odd (2 ^ f + 1) := by
  have h1 : 2 ∣ 2 ^ f := dvd_pow_self 2 (by omega)
  rw [Nat.odd_iff]; omega

theorem generic_two_odd {t : StatedLieTag} {n f : ℕ} (hadm : StatedLieAdmissible t n 2 f) :
    Odd ((genericOrders t n 2 f).1 * (genericOrders t n 2 f).2) := by
  have hf : 1 ≤ f := hadm.2.1
  have hq : Even (2 ^ f) := (Nat.even_pow).2 ⟨even_two, by omega⟩
  have hg : ∀ x m : ℕ, Odd m → Odd (Nat.gcd x m) := fun x m hm =>
    Odd.of_dvd_nat hm (Nat.gcd_dvd_right x m)
  cases t <;> simp only [genericOrders] <;> simp [hq]
  all_goals first
    | exact hg _ _ (odd_two_pow_sub_one hf)
    | exact hg _ _ (odd_two_pow_add_one hf)
    | exact hg _ _ (Even.add_one (Even.pow_of_ne_zero hq (by have := hadm.2.2; omega)))
    | exact (Odd.of_dvd_nat (by decide) (Nat.gcd_dvd_left _ _))
    | simp_all [StatedLieAdmissible]

theorem chev2_exc_ne (hGA : CFSG.Open.GriessAllModelsStatement) {Q : Type} [Group Q] [Finite Q]
    (hQ : CFSG.Open.IsQuasisimple Q) {t : StatedLieTag} {n f : ℕ}
    (hm : CFSG.Models.LieModel (Q ⧸ Subgroup.center Q) t n 2 f)
    (hev : Even (Nat.card (Subgroup.center Q))) : exceptionalOrders t n 2 f ≠ (1, 1) := by
  intro he
  have hodd := generic_two_odd hm.1
  have hdvd := card_center_dvd_of_table hGA hQ hm (a := (genericOrders t n 2 f).1)
    (b := (genericOrders t n 2 f).2) (c := 1) (d := 1) rfl he (by simpa using hodd.pos.ne')
  exact (Nat.not_even_iff_odd.2 (Odd.of_dvd_nat (by simpa using hodd) hdvd)) hev

theorem exc_PSL_ne {n f : ℕ} (h : exceptionalOrders .PSL n 2 f ≠ (1, 1)) :
    (n = 2 ∧ f = 2) ∨ (n = 3 ∧ f = 1) ∨ (n = 4 ∧ f = 1) ∨ (n = 3 ∧ f = 2) := by
  unfold exceptionalOrders at h
  split at h <;> simp_all

theorem exc_PSU_ne {n f : ℕ} (h : exceptionalOrders .PSU n 2 f ≠ (1, 1)) :
    (n = 4 ∧ f = 1) ∨ (n = 6 ∧ f = 1) := by
  unfold exceptionalOrders at h
  split at h <;> simp_all

theorem exc_PSp_ne {n f : ℕ} (h : exceptionalOrders .PSp n 2 f ≠ (1, 1)) : n = 3 ∧ f = 1 := by unfold exceptionalOrders at h; split at h <;> simp_all

theorem exc_POmegaPlus_ne {n f : ℕ} (h : exceptionalOrders .POmegaPlus n 2 f ≠ (1, 1)) :
    n = 4 ∧ f = 1 := by
  unfold exceptionalOrders at h
  split at h <;> simp_all

theorem exc_F4_ne {f : ℕ} (h : exceptionalOrders .F4 0 2 f ≠ (1, 1)) : f = 1 := by unfold exceptionalOrders at h; split at h <;> simp_all

theorem exc_G2_ne {f : ℕ} (h : exceptionalOrders .G2 0 2 f ≠ (1, 1)) : f = 2 := by unfold exceptionalOrders at h; split at h <;> simp_all

theorem exc_twistedE6_ne {f : ℕ} (h : exceptionalOrders .twistedE6 0 2 f ≠ (1, 1)) : f = 1 := by unfold exceptionalOrders at h; split at h <;> simp_all

theorem exc_twistedB2_ne {f : ℕ} (h : exceptionalOrders .twistedB2 0 2 f ≠ (1, 1)) : f = 3 := by unfold exceptionalOrders at h; split at h <;> simp_all

theorem chev2_trivial_exc_false (hGA : CFSG.Open.GriessAllModelsStatement) {Q : Type} [Group Q]
    [Finite Q] (hQ : CFSG.Open.IsQuasisimple Q) (hev : Even (Nat.card (Subgroup.center Q)))
    {t : StatedLieTag} {n f : ℕ} (hm : CFSG.Models.LieModel (Q ⧸ Subgroup.center Q) t n 2 f)
    (he : exceptionalOrders t n 2 f = (1, 1)) : False :=
  chev2_exc_ne hGA hQ hm hev he

