theorem evenF4
    {q : PrimePower} (hv : (LieTypeIndex.F4 q).Valid) (hq2 : q.p = 2)
    (e : Q ⧸ Subgroup.center Q ≃* ValidLieTypeIndex.Group ⟨.F4 q, hv⟩) :
    evenList (.lie ⟨.F4 q, hv⟩) := by
  have hm : CFSG.Models.LieModel (Q ⧸ Subgroup.center Q) .F4 0 2 q.exponent :=
    CFSG.Models.lieModel_of_namesTag (t := .F4) (p := 2) (f := q.exponent)
      ⟨Nat.prime_two, q.exponent_pos, rfl⟩ ⟨_, hv⟩ ⟨hq2, rfl⟩ e
  have hc : q.card = 2 := by
    rw [PrimePower.card_def, hq2, exc_F4_ne (chev2_exc_ne hGA hQ hm hev)]; norm_num
  exact Or.inl (Or.inr (Or.inr (Or.inl hc)))

theorem evenG2
    {q : PrimePower} (hv : (LieTypeIndex.G2 q).Valid) (hq2 : q.p = 2)
    (e : Q ⧸ Subgroup.center Q ≃* ValidLieTypeIndex.Group ⟨.G2 q, hv⟩) :
    evenList (.lie ⟨.G2 q, hv⟩) := by
  have h3 : 3 ≤ q.card := (LieTypeIndex.inStandardRange_iff _).mp ((LieTypeIndex.valid_iff _).mp hv).1
  have hcard : q.card = 2 ^ q.exponent := by rw [PrimePower.card_def, hq2]
  have hm : CFSG.Models.LieModel (Q ⧸ Subgroup.center Q) .G2 0 2 q.exponent :=
    CFSG.Models.lieModel_of_namesTag (t := .G2) (p := 2) (f := q.exponent)
      ⟨Nat.prime_two, q.exponent_pos, rfl, hcard ▸ h3⟩ ⟨_, hv⟩ ⟨hq2, rfl⟩ e
  have hf := exc_G2_ne (chev2_exc_ne hGA hQ hm hev)
  have hc : q.card = 4 := by rw [hcard, hf]; norm_num
  exact Or.inr (Or.inr (Or.inl ⟨q, hv, rfl, hc⟩))

theorem evenTwE6
    {q : PrimePower} (hv : (LieTypeIndex.twistedE6 q).Valid) (hq2 : q.p = 2)
    (e : Q ⧸ Subgroup.center Q ≃* ValidLieTypeIndex.Group ⟨.twistedE6 q, hv⟩) :
