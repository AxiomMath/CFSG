theorem evenA {r : ℕ} {q : PrimePower} (hv : (LieTypeIndex.A r q).Valid) (hq2 : q.p = 2)
    (e : Q ⧸ Subgroup.center Q ≃* ValidLieTypeIndex.Group ⟨.A r q, hv⟩) :
    evenList (.lie ⟨.A r q, hv⟩) := by
  have hm := CFSG.Models.lieModel_A r q hv e
  rw [hq2] at hm
  have hdup := ((LieTypeIndex.valid_iff _).1 hv).2
  rcases exc_PSL_ne (chev2_exc_ne hGA hQ hm hev) with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩
  · exfalso
    obtain rfl : r = 1 := by omega
    have hc : q.card = 4 := by rw [PrimePower.card_def, hq2, h2]; norm_num
    exact hdup ((LieTypeIndex.isDuplicateRepresentative_iff _).2 (Or.inl ⟨rfl, Or.inl hc⟩))
  · exfalso
    obtain rfl : r = 2 := by omega
    have hc : q.card = 2 := by rw [PrimePower.card_def, hq2, h2]; norm_num
    exact hdup ((LieTypeIndex.isDuplicateRepresentative_iff _).2 (Or.inr (Or.inl ⟨rfl, hc⟩)))
  · exfalso
    obtain rfl : r = 3 := by omega
    have hc : q.card = 2 := by rw [PrimePower.card_def, hq2, h2]; norm_num
    exact hdup ((LieTypeIndex.isDuplicateRepresentative_iff _).2 (Or.inr (Or.inr ⟨rfl, hc⟩)))
  · obtain rfl : r = 2 := by omega
    have hc : q.card = 4 := by rw [PrimePower.card_def, hq2, h2]; norm_num
    exact Or.inr (Or.inl ⟨q, hv, rfl, hc⟩)

theorem evenB
    {r : ℕ} {q : PrimePower} (hv : (LieTypeIndex.B r q).Valid) (hq2 : q.p = 2)
    (e : Q ⧸ Subgroup.center Q ≃* ValidLieTypeIndex.Group ⟨.B r q, hv⟩) :
    evenList (.lie ⟨.B r q, hv⟩) := by
  rcases CFSG.Models.lieModel_B r q hv e with hm | hm
  · rw [hq2] at hm
    obtain ⟨rfl, h2⟩ := exc_PSp_ne (chev2_exc_ne hGA hQ hm hev)
    have hc : q.card = 2 := by rw [PrimePower.card_def, hq2, h2]; norm_num
    exact Or.inl (Or.inl hc)
  · exact absurd hq2 hm.1.2.2.2

theorem evenTwA
    {r : ℕ} {q : PrimePower} (hv : (LieTypeIndex.twistedA r q).Valid) (hq2 : q.p = 2)
    (e : Q ⧸ Subgroup.center Q ≃* ValidLieTypeIndex.Group ⟨.twistedA r q, hv⟩) :
    evenList (.lie ⟨.twistedA r q, hv⟩) := by
  have hm := lieModel_twistedA' r q hv e
  rw [hq2] at hm
  rcases exc_PSU_ne (chev2_exc_ne hGA hQ hm hev) with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · obtain rfl : r = 3 := by omega
    have hc : q.card = 2 := by rw [PrimePower.card_def, hq2, h2]; norm_num
    exact Or.inl (Or.inr (Or.inr (Or.inr (Or.inl hc))))
  · obtain rfl : r = 5 := by omega
    have hc : q.card = 2 := by rw [PrimePower.card_def, hq2, h2]; norm_num
    exact Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hc)))))

theorem evenD
    {r : ℕ} {q : PrimePower} (hv : (LieTypeIndex.D r q).Valid) (hq2 : q.p = 2)
    (e : Q ⧸ Subgroup.center Q ≃* ValidLieTypeIndex.Group ⟨.D r q, hv⟩) :
