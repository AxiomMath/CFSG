theorem card_le_pRank {H : Type} [Group H] [Finite H] {p : ℕ} (hp : p.Prime) {A : Subgroup H}
    (hA : CFSG.Open.IsElemAbelian p A) (n : ℕ) (hn : Nat.card A = p ^ n) :
    n ≤ CFSG.pRank p H := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : CFSG.IsElementaryAbelian p A :=
    { toIsMulCommutative := hA.1
      exponent_dvd_p := Monoid.exponent_dvd_of_forall_pow_eq_one (fun g =>
        Subtype.ext (by simpa using hA.2 (g : H) g.2)) }
  unfold CFSG.pRank
  apply le_csSup
  · refine ⟨Nat.card H, ?_⟩
    rintro k ⟨B, _, hB⟩
    have h1 : Nat.card B ≤ Nat.card H :=
      Nat.le_of_dvd Nat.card_pos (Subgroup.card_subgroup_dvd_card B)
    have h2 : k < p ^ k := Nat.lt_pow_self hp.one_lt
    rw [hB] at h1
    omega
  · exact ⟨A, inferInstance, hn⟩

theorem no_L34 {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {S K : Type} [Group S] [Finite S] [Field K]
    [Finite K] (hK : Nat.card K = 4)
    (e : S ≃* CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL 3 K)
    {E : Subgroup (MulAut S)} (hE : CFSG.Open.IsElemAbelian p E) (h3 : p ^ 3 ≤ Nat.card E) :
