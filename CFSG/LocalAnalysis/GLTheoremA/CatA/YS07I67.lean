open scoped commutatorElement

variable {G : Type} [Group G]

abbrev QT (p : ℕ) (L : Subgroup G) : Type := ↥L ⧸ ⁅(⊤ : Subgroup ↥L), GLAPPrimeCore p ↥L⁆

theorem mem_center_QT {p : ℕ} {L : Subgroup G} {n : ↥L} (hn : n ∈ GLAPPrimeCore p ↥L) :
    (n : QT p L) ∈ Subgroup.center (QT p L) := by
  rw [Subgroup.mem_center_iff]
  intro g
  induction g using QuotientGroup.induction_on with
  | H l =>
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
    have hc : ⁅l⁻¹, n⁻¹⁆ ∈ ⁅(⊤ : Subgroup ↥L), GLAPPrimeCore p ↥L⁆ :=
      Subgroup.commutator_mem_commutator (Subgroup.mem_top l⁻¹) ((GLAPPrimeCore p ↥L).inv_mem hn)
    have h : (l * n)⁻¹ * (n * l) = (⁅l⁻¹, n⁻¹⁆)⁻¹ := by rw [commutatorElement_def]; group
    rw [h]; exact (⁅(⊤ : Subgroup ↥L), GLAPPrimeCore p ↥L⁆).inv_mem hc

@[expose] noncomputable def psiQT (p : ℕ) (L : Subgroup G) : QT p L →* PQuot p L :=
  QuotientGroup.map _ _ (MonoidHom.id ↥L) (fun _ hx => Subgroup.commutator_le_right _ _ hx)

theorem psiQT_mk {p : ℕ} {L : Subgroup G} (x : ↥L) :
    psiQT p L (QuotientGroup.mk x) = QuotientGroup.mk x := rfl

theorem psiQT_surj (p : ℕ) (L : Subgroup G) : Function.Surjective (psiQT p L) := by
  intro y
  obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective y
  exact ⟨QuotientGroup.mk x, rfl⟩

theorem ker_psiQT_le {p : ℕ} {L : Subgroup G} (w : QT p L) (hw : psiQT p L w = 1) :
    w ∈ Subgroup.center (QT p L) := by
  obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective w
  rw [psiQT_mk] at hw
  exact mem_center_QT ((QuotientGroup.eq_one_iff x).1 hw)

@[expose] noncomputable def phiQT (p : ℕ) (L : Subgroup G) : QT p L →* PSimple p L :=
  (QuotientGroup.mk' (Subgroup.center (PQuot p L))).comp (psiQT p L)

theorem phiQT_surj (p : ℕ) (L : Subgroup G) : Function.Surjective (phiQT p L) := by
  intro y
  obtain ⟨z, rfl⟩ := QuotientGroup.mk_surjective y
  obtain ⟨w, rfl⟩ := psiQT_surj p L z
  exact ⟨w, rfl⟩

theorem commutator_sub_top {p : ℕ} {X L : Subgroup G} (hL : GLAPComponent p X L) :
    ⁅(⊤ : Subgroup ↥L), (⊤ : Subgroup ↥L)⁆ = ⊤ := by
  have hmap : Subgroup.map L.subtype (⊤ : Subgroup ↥L) = L := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  apply Subgroup.map_injective (f := L.subtype) Subtype.val_injective
  rw [Subgroup.map_commutator, hmap]
  exact glaPComponent_perfect hL

theorem commutator_QT {p : ℕ} {X L : Subgroup G} (hL : GLAPComponent p X L) :
    ⁅(⊤ : Subgroup (QT p L)), (⊤ : Subgroup (QT p L))⁆ = ⊤ := by
  have hsurj : Function.Surjective (QuotientGroup.mk' (⁅(⊤ : Subgroup ↥L), GLAPPrimeCore p ↥L⁆) :
      ↥L →* QT p L) := QuotientGroup.mk'_surjective _
  have h1 := Subgroup.map_commutator (⊤ : Subgroup ↥L) (⊤ : Subgroup ↥L)
    (QuotientGroup.mk' (⁅(⊤ : Subgroup ↥L), GLAPPrimeCore p ↥L⁆) : ↥L →* QT p L)
  rw [commutator_sub_top hL, Subgroup.map_top_of_surjective _ hsurj] at h1
  exact h1.symm

theorem ker_phiQT {p : ℕ} {X L : Subgroup G} (hL : GLAPComponent p X L) :
    (phiQT p L).ker = Subgroup.center (QT p L) := by
  haveI : Group.IsPerfect (QT p L) := Group.isPerfect_def.2 (commutator_QT hL)
  ext x
  rw [MonoidHom.mem_ker]
  constructor
  · intro hx
    have hc : psiQT p L x ∈ Subgroup.center (PQuot p L) := (QuotientGroup.eq_one_iff _).1 hx
    have hcomm : ∀ g : QT p L, psiQT p L x * psiQT p L g = psiQT p L g * psiQT p L x :=
      fun g => (Subgroup.mem_center_iff.1 hc (psiQT p L g)).symm
    have hid := CFSG.ComponentClassification.PerfectAutomorphisms.hom_eq_id_of_central_displacement
      ((MulAut.conj x : MulAut (QT p L)) : QT p L →* QT p L) (fun g => by
        have hconj : ((MulAut.conj x : MulAut (QT p L)) : QT p L →* QT p L) g = x * g * x⁻¹ := rfl
        rw [hconj]
        apply ker_psiQT_le
        simp only [map_mul, map_inv]
        rw [show psiQT p L x * psiQT p L g * (psiQT p L x)⁻¹ = psiQT p L g by
          rw [hcomm g]; group]
        group)
    refine Subgroup.mem_center_iff.2 (fun g => ?_)
    have h' : x * g * x⁻¹ = g := congrArg (fun f : QT p L →* QT p L => f g) hid
    calc g * x = (x * g * x⁻¹) * x := by rw [h']
      _ = x * g := by group
  · intro hx
    refine (QuotientGroup.eq_one_iff _).2 (Subgroup.mem_center_iff.2 (fun y => ?_))
    obtain ⟨w, rfl⟩ := psiQT_surj p L y
    rw [← map_mul, ← map_mul, (Subgroup.mem_center_iff.1 hx w)]

noncomputable def quotCenterQT {p : ℕ} {X L : Subgroup G} (hL : GLAPComponent p X L) :
    QT p L ⧸ Subgroup.center (QT p L) ≃* PSimple p L :=
  (QuotientGroup.quotientMulEquivOfEq (ker_phiQT hL).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective (phiQT p L) (phiQT_surj p L))

theorem isQuasisimple_QT [Finite G] {p : ℕ} {X L : Subgroup G} (hp : p.Prime)
    (hL : GLAPComponent p X L) : CFSG.Open.IsQuasisimple (QT p L) := by
  refine ⟨commutator_QT hL, ?_⟩
  haveI : IsSimpleGroup (PSimple p L) := (isQuasisimple_pQuot_of_glaPComponent hp hL).2
  exact (quotCenterQT hL).isSimpleGroup

theorem even_center_QT {p : ℕ} {L : Subgroup G} (hO : Even (Nat.card (GLAPPrimeCoreOf p L)))
    (hC : Odd (Nat.card (⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G))) :
    Even (Nat.card (Subgroup.center (QT p L))) := by
  have hmap : Subgroup.map L.subtype (⊤ : Subgroup ↥L) = L := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  have hcardN : Nat.card ↥(GLAPPrimeCore p ↥L) = Nat.card ↥(GLAPPrimeCoreOf p L) :=
    (Subgroup.card_map_of_injective (f := L.subtype) Subtype.val_injective).symm
  have hcardN' : Nat.card ↥(⁅(⊤ : Subgroup ↥L), GLAPPrimeCore p ↥L⁆) =
      Nat.card ↥(⁅L, GLAPPrimeCoreOf p L⁆ : Subgroup G) := by
    rw [← Subgroup.card_map_of_injective (f := L.subtype) Subtype.val_injective,
      Subgroup.map_commutator, hmap]
    rfl
  let σ : ↥(GLAPPrimeCore p ↥L) →* QT p L :=
    (QuotientGroup.mk' ⁅(⊤ : Subgroup ↥L), GLAPPrimeCore p ↥L⁆).comp
      (GLAPPrimeCore p ↥L).subtype
  have hker : σ.ker.map (GLAPPrimeCore p ↥L).subtype = ⁅(⊤ : Subgroup ↥L), GLAPPrimeCore p ↥L⁆ := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact (QuotientGroup.eq_one_iff (y : ↥L)).1 hy
    · intro hx
      exact ⟨⟨x, Subgroup.commutator_le_right _ _ hx⟩, (QuotientGroup.eq_one_iff x).2 hx, rfl⟩
  have hcardker : Nat.card σ.ker = Nat.card ↥(⁅(⊤ : Subgroup ↥L), GLAPPrimeCore p ↥L⁆) := by
    have h := Subgroup.card_map_of_injective (f := (GLAPPrimeCore p ↥L).subtype) (K := σ.ker)
      Subtype.val_injective
    rw [hker] at h
    exact h.symm
  have hlag := Subgroup.card_eq_card_quotient_mul_card_subgroup σ.ker
  have hquot : Nat.card (↥(GLAPPrimeCore p ↥L) ⧸ σ.ker) = Nat.card σ.range :=
    Nat.card_congr (QuotientGroup.quotientKerEquivRange σ).toEquiv
  have hle : σ.range ≤ Subgroup.center (QT p L) := by
    rintro _ ⟨y, rfl⟩
    exact mem_center_QT y.2
  have h2N : 2 ∣ Nat.card ↥(GLAPPrimeCore p ↥L) := by
    rw [hcardN]; exact even_iff_two_dvd.1 hO
  have hodd : Odd (Nat.card σ.ker) := by rw [hcardker, hcardN']; exact hC
  rw [hlag, hquot] at h2N
  have hev : Even (Nat.card σ.range) := by
    rcases Nat.even_mul.1 (even_iff_two_dvd.2 h2N) with h | h
    · exact h
    · exact absurd h (Nat.not_even_iff_odd.2 hodd)
  exact even_iff_two_dvd.2 ((even_iff_two_dvd.1 hev).trans (Subgroup.card_dvd_of_le hle))

