theorem cube_dvd_of_elemAb {M : Type} [Group M] [Finite M] {p : ℕ} (hp : p.Prime)
    {E : Subgroup M} (hE : CFSG.Open.IsElemAbelian p E) (h3 : p ^ 3 ≤ Nat.card E) :
    p ^ 3 ∣ Nat.card E := by
