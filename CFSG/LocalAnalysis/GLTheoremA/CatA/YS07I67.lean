      ⟨Nat.prime_two, q.exponent_pos, rfl⟩ ⟨_, hv⟩ ⟨hq2, rfl⟩ e
  have hc : q.card = 2 := by
    rw [PrimePower.card_def, hq2, exc_twistedE6_ne (chev2_exc_ne hGA hQ hm hev)]; norm_num
  exact Or.inl (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr hc)))))

theorem evenSuz
    {m : ℕ} (hv : (LieTypeIndex.suzuki m).Valid)
    (e : Q ⧸ Subgroup.center Q ≃* ValidLieTypeIndex.Group ⟨.suzuki m, hv⟩) :
    evenList (.lie ⟨.suzuki m, hv⟩) := by
  have hm1 : 1 ≤ m := (LieTypeIndex.inStandardRange_iff _).mp ((LieTypeIndex.valid_iff _).mp hv).1
  have hm : CFSG.Models.LieModel (Q ⧸ Subgroup.center Q) .twistedB2 0 2 (2 * m + 1) :=
    CFSG.Models.lieModel_of_namesTag (t := .twistedB2) (p := 2) (f := 2 * m + 1)
      ⟨Nat.prime_two, by omega, rfl, rfl, odd_two_mul_add_one m, by omega⟩ ⟨_, hv⟩ ⟨rfl, rfl⟩ e
  have h3 := exc_twistedB2_ne (chev2_exc_ne hGA hQ hm hev)
  exact Or.inr (Or.inr (Or.inr (Or.inl ⟨m, hv, rfl, by omega⟩)))

theorem evenLie
    (d : ValidLieTypeIndex) (hc : d.1.characteristic = 2) (e : Q ⧸ Subgroup.center Q ≃* d.Group) :
    evenList (.lie d) := by
  obtain ⟨d, hv⟩ := d
  cases d with
  | A r q => exact evenA hGA hQ hev hv (by simpa using hc) e
  | twistedA r q => exact evenTwA hGA hQ hev hv (by simpa using hc) e
  | B r q => exact evenB hGA hQ hev hv (by simpa using hc) e
  | C r q => exact absurd (by simpa using hc) ((LieTypeIndex.inStandardRange_iff _).mp
      ((LieTypeIndex.valid_iff _).mp hv).1).2
  | D r q => exact evenD hGA hQ hev hv (by simpa using hc) e
  | twistedD r q => exact evenTwD hGA hQ hev hv (by simpa using hc) e
  | E6 q => exact (chev2_trivial_exc_false hGA hQ hev (CFSG.Models.lieModel_of_namesTag
      (t := .E6) (p := 2) (f := q.exponent) ⟨Nat.prime_two, q.exponent_pos, rfl⟩ ⟨_, hv⟩
      ⟨by simpa using hc, rfl⟩ e) rfl).elim
  | E7 q => exact (chev2_trivial_exc_false hGA hQ hev (CFSG.Models.lieModel_of_namesTag
      (t := .E7) (p := 2) (f := q.exponent) ⟨Nat.prime_two, q.exponent_pos, rfl⟩ ⟨_, hv⟩
      ⟨by simpa using hc, rfl⟩ e) rfl).elim
  | E8 q => exact (chev2_trivial_exc_false hGA hQ hev (CFSG.Models.lieModel_of_namesTag
      (t := .E8) (p := 2) (f := q.exponent) ⟨Nat.prime_two, q.exponent_pos, rfl⟩ ⟨_, hv⟩
      ⟨by simpa using hc, rfl⟩ e) rfl).elim
  | F4 q => exact evenF4 hGA hQ hev hv (by simpa using hc) e
  | G2 q => exact evenG2 hGA hQ hev hv (by simpa using hc) e
  | twistedE6 q => exact evenTwE6 hGA hQ hev hv (by simpa using hc) e
  | trialityD4 q => exact (chev2_trivial_exc_false hGA hQ hev (CFSG.Models.lieModel_of_namesTag
      (t := .trialityD4) (p := 2) (f := q.exponent) ⟨Nat.prime_two, q.exponent_pos, rfl⟩ ⟨_, hv⟩
      ⟨by simpa using hc, rfl⟩ e) rfl).elim
  | suzuki m => exact evenSuz hGA hQ hev hv e
  | reeG2 m => simp at hc
  | reeF4 m =>
    have hm1 : 1 ≤ m := (LieTypeIndex.inStandardRange_iff _).mp ((LieTypeIndex.valid_iff _).mp hv).1
    exact (chev2_trivial_exc_false hGA hQ hev (CFSG.Models.lieModel_of_namesTag
      (t := .twistedF4) (p := 2) (f := 2 * m + 1) ⟨Nat.prime_two, by omega, rfl, rfl,
