    exact Finite.card_le_one_iff_subsingleton.1
      (CFSG.ComponentClassification.ExcSelector.card_ringEquiv_le_one_of_card_seven hF)
  haveI := hsub
  rcases eq_or_ne p 3 with rfl | hp3
  · have hinner : E ≤ CFSG.ComponentClassification.OuterAutomorphisms.inner
        (CFSG.GorensteinWalter.PSL2 F) := by
      intro δ hδ
      have hfield : (CFSG.Quasithin.autFieldPart F) δ = 1 := Subsingleton.elim _ _
      obtain ⟨x, hx⟩ :=
        CFSG.HardMathSupport.Solomon.Coordinator.l514vexp_inner_of_fieldPart hfield (hE.2 δ hδ)
      exact ⟨x, hx⟩
    have hdvd : Nat.card E ∣ 168 := by
      rw [← hcard168]
      exact (Subgroup.card_dvd_of_le hinner).trans
        (Subgroup.card_range_dvd (MulAut.conj : CFSG.GorensteinWalter.PSL2 F →* _))
    have h27 := cube_dvd_of_elemAb Nat.prime_three hE h3
    exact absurd (h27.trans hdvd) (by norm_num)
  · have hinj := conj_inj_of_center_bot (CFSG.GorensteinWalter.psl2_center_eq_bot F)
    have hinn : Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.inner
        (CFSG.GorensteinWalter.PSL2 F)) = 168 := by
      rw [← hcard168]
      exact (Nat.card_congr (MonoidHom.ofInjective hinj).toEquiv).symm
    have hidx := Subgroup.card_eq_card_quotient_mul_card_subgroup
