theorem isElemAbelian_map {M N : Type} [Group M] [Group N] {p : ℕ} (f : M →* N) {E : Subgroup M}
    (hE : CFSG.Open.IsElemAbelian p E) : CFSG.Open.IsElemAbelian p (E.map f) := by
  obtain ⟨hc, he⟩ := hE
  refine ⟨⟨⟨fun a b => ?_⟩⟩, ?_⟩
  · obtain ⟨x, hx, hxa⟩ := Subgroup.mem_map.1 a.2
    obtain ⟨y, hy, hyb⟩ := Subgroup.mem_map.1 b.2
    apply Subtype.ext
    have := congrArg Subtype.val (hc.is_comm.comm ⟨x, hx⟩ ⟨y, hy⟩)
    simp only [Subgroup.coe_mul] at this
    show a.1 * b.1 = b.1 * a.1
    rw [← hxa, ← hyb, ← map_mul, ← map_mul, this]
  · intro z hz
    obtain ⟨x, hx, rfl⟩ := Subgroup.mem_map.1 hz
    rw [← map_pow, he x hx, map_one]

