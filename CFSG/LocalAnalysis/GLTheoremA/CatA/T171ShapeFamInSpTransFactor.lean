abbrev markingMap {G : Type} [Group G] {L : Subgroup G} {m : ℕ} {K : Type} [Field K]
    (θ : ↥L ⧸ Subgroup.center ↥L ≃* StatedProj (StatedSp m K)) :
    ↥L →* StatedProj (StatedSp m K) :=
  θ.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center ↥L))

theorem markingMap_surjective {G : Type} [Group G] {L : Subgroup G} {m : ℕ} {K : Type} [Field K]
    (θ : ↥L ⧸ Subgroup.center ↥L ≃* StatedProj (StatedSp m K)) :
    Function.Surjective (markingMap θ) := by
  intro z
  obtain ⟨q, rfl⟩ := θ.surjective z
  obtain ⟨l, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center ↥L) q
  exact ⟨l, rfl⟩

theorem conjAut_pow_eq_one_of_largeEvenInduces {G : Type} [Group G] {p : ℕ} {L : Subgroup G}
    {d : G} (hdN : d ∈ Subgroup.normalizer (L : Set G)) (hdp : d ^ p = 1)
    {m : ℕ} {K : Type} [Field K]
    {θ : ↥L ⧸ Subgroup.center ↥L ≃* StatedProj (StatedSp m K)} {x : StatedSp m K}
    (h : LargeEvenInduces θ (fun l l' : ↥L => (l' : G) = d⁻¹ * l * d)
      (MulAut.conj (proj m K x))) :
    MulAut.conj (proj m K x) ^ p = 1 := by
  let N : Subgroup G := Subgroup.normalizer (L : Set G)
  have hdN' : d⁻¹ ∈ N := Subgroup.inv_mem _ hdN
  let a : MulAut ↥L := ggGamma L (le_refl N) ⟨d⁻¹, hdN'⟩
  have hap : a ^ p = 1 := by
    have h1 : (⟨d⁻¹, hdN'⟩ : N) ^ p = 1 := by
      apply Subtype.ext
      simp only [Subgroup.coe_pow, Subgroup.coe_mk, Subgroup.coe_one]
      rw [inv_pow, hdp, inv_one]
    change (ggGamma L (le_refl N) ⟨d⁻¹, hdN'⟩) ^ p = 1
    rw [← map_pow, h1, map_one]
  have hαβ : ∀ l : ↥L, markingMap θ (a l) = MulAut.conj (proj m K x) (markingMap θ l) := by
    intro l
    have hrel : ((a l : ↥L) : G) = d⁻¹ * l * d := by
      rw [ggGamma_coe]
      simp
    exact (h l (a l) hrel).symm
  have key : ∀ k : ℕ, ∀ l : ↥L,
      (MulAut.conj (proj m K x) ^ k) (markingMap θ l) = markingMap θ ((a ^ k) l) := by
    intro k
    induction k with
    | zero => intro l; simp
    | succ k ih =>
      intro l
      have hstep : (a ^ (k + 1)) l = a ((a ^ k) l) := by
        rw [pow_succ', MulAut.mul_apply]
      rw [pow_succ', MulAut.mul_apply, ih, ← hαβ ((a ^ k) l), hstep]
  have hπc : Function.Surjective (markingMap θ) := markingMap_surjective θ
  ext z
  obtain ⟨l, rfl⟩ := hπc z
  rw [key p l, hap]
  rfl

theorem conjAut_commute_of_largeEvenInduces {G : Type} [Group G] {L : Subgroup G} {d b : G}
    (hdN : d ∈ Subgroup.normalizer (L : Set G)) (hbN : b ∈ Subgroup.normalizer (L : Set G))
    (hdb : b * d = d * b) {m : ℕ} {K : Type} [Field K]
    {θ : ↥L ⧸ Subgroup.center ↥L ≃* StatedProj (StatedSp m K)} {x y : StatedSp m K}
    (hx : LargeEvenInduces θ (fun l l' : ↥L => (l' : G) = d⁻¹ * l * d)
      (MulAut.conj (proj m K x)))
    (hy : LargeEvenInduces θ (fun l l' : ↥L => (l' : G) = b⁻¹ * l * b)
      (MulAut.conj (proj m K y))) :
    Commute (MulAut.conj (proj m K x)) (MulAut.conj (proj m K y)) := by
  let N : Subgroup G := Subgroup.normalizer (L : Set G)
  have hdN' : d⁻¹ ∈ N := Subgroup.inv_mem _ hdN
  have hbN' : b⁻¹ ∈ N := Subgroup.inv_mem _ hbN
  let a : MulAut ↥L := ggGamma L (le_refl N) ⟨d⁻¹, hdN'⟩
  let c : MulAut ↥L := ggGamma L (le_refl N) ⟨b⁻¹, hbN'⟩
  have hcommN : (⟨d⁻¹, hdN'⟩ : N) * ⟨b⁻¹, hbN'⟩ = ⟨b⁻¹, hbN'⟩ * ⟨d⁻¹, hdN'⟩ := by
    apply Subtype.ext
    simp only [Subgroup.coe_mul, Subgroup.coe_mk]
    rw [← mul_inv_rev, ← mul_inv_rev, hdb]
  have hcomm_ac : Commute a c := by
    have h := congrArg (ggGamma L (le_refl N)) hcommN
    exact (commute_iff_eq a c).mpr (by simpa only [map_mul, a, c] using h)
  have hαβ : ∀ l : ↥L, markingMap θ (a l) = MulAut.conj (proj m K x) (markingMap θ l) := by
    intro l
    have hrel : ((a l : ↥L) : G) = d⁻¹ * l * d := by
      rw [ggGamma_coe]
      simp
    exact (hx l (a l) hrel).symm
  have hγβ : ∀ l : ↥L, markingMap θ (c l) = MulAut.conj (proj m K y) (markingMap θ l) := by
    intro l
    have hrel : ((c l : ↥L) : G) = b⁻¹ * l * b := by
      rw [ggGamma_coe]
      simp
    exact (hy l (c l) hrel).symm
  have hπc : Function.Surjective (markingMap θ) := markingMap_surjective θ
  ext z
  obtain ⟨l, rfl⟩ := hπc z
  have hpt : (a * c) l = (c * a) l :=
    congrArg (fun f : MulAut ↥L => f l) hcomm_ac.eq
  have hpt' : markingMap θ (a (c l)) = markingMap θ (c (a l)) := by
    rw [show a (c l) = c (a l) by simpa only [MulAut.mul_apply] using hpt]
  calc MulAut.conj (proj m K x) (MulAut.conj (proj m K y) (markingMap θ l))
      = MulAut.conj (proj m K x) (markingMap θ (c l)) := by rw [hγβ l]
    _ = markingMap θ (a (c l)) := (hαβ (c l)).symm
    _ = markingMap θ (c (a l)) := hpt'
    _ = MulAut.conj (proj m K y) (markingMap θ (a l)) := hγβ (a l)
    _ = MulAut.conj (proj m K y) (MulAut.conj (proj m K x) (markingMap θ l)) :=
          congrArg (MulAut.conj (proj m K y)) (hαβ l)

theorem commute_symp_of_conjAut_commute {m : ℕ} {K : Type} [Field K] [Finite K] [CharP K 2]
    [NeZero m] (hZ : Subgroup.center (StatedProj (StatedSp m K)) = ⊥) {x y : StatedSp m K}
    (h : Commute (MulAut.conj (proj m K x)) (MulAut.conj (proj m K y))) :
    x * y = y * x := by
  have hz : ⁅proj m K x, proj m K y⁆ = 1 := by
    have h1 : MulAut.conj (⁅proj m K x, proj m K y⁆) = 1 := by
      rw [map_commutatorElement]
      exact commutatorElement_eq_one_iff_commute.mpr h
    have hmem : ⁅proj m K x, proj m K y⁆ ∈ Subgroup.center (StatedProj (StatedSp m K)) := by
      rw [Subgroup.mem_center_iff]
      intro g
      have h2 := congrArg (fun f : MulAut (StatedProj (StatedSp m K)) => f g) h1
      rw [MulAut.conj_apply, MulAut.one_apply] at h2
      have h3 : ⁅proj m K x, proj m K y⁆ * g = g * ⁅proj m K x, proj m K y⁆ := by
        calc ⁅proj m K x, proj m K y⁆ * g
            = (⁅proj m K x, proj m K y⁆ * g * ⁅proj m K x, proj m K y⁆⁻¹) *
                ⁅proj m K x, proj m K y⁆ := by group
          _ = g * ⁅proj m K x, proj m K y⁆ := by rw [h2]
      exact h3.symm
    rw [hZ, Subgroup.mem_bot] at hmem
    exact hmem
  have hcomm : proj m K x * proj m K y = proj m K y * proj m K x :=
    (commutatorElement_eq_one_iff_commute.mp hz).eq
  have hinj : Function.Injective (proj m K) :=
    (CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.proj_bijective_of_charTwo
      (r := m) (K := K)).1
  apply hinj
  rw [map_mul, map_mul]
  exact hcomm

@[expose] def SympCompMatrixAnalysis : Prop :=
  ∀ {G : Type} [Group G] [Finite G] (p : ℕ) (L J A : Subgroup G) (d b : G) (m n : ℕ)
      (K : Type) [Field K] [Finite K] (x y : StatedSp m K)
      (θ : ↥L ⧸ Subgroup.center ↥L ≃* StatedProj (StatedSp m K)),
    (hS : Setup p L J A d b) → Nat.card K = 2 ^ n → 2 ≤ m →
    LargeEvenInduces θ (fun l l' : ↥L => (l' : G) = d⁻¹ * l * d)
      (MulAut.conj (proj m K x)) →
    LargeEvenInduces θ (fun l l' : ↥L => (l' : G) = b⁻¹ * l * b)
      (MulAut.conj (proj m K y)) →
    x ^ p = 1 → y ^ p = 1 → x * y = y * x →
    b ∉ Subgroup.zpowers d → b ∉ Subgroup.centralizer (J : Set G) →
    (catalogIs (PSimple p J) (onLie isLinearCharTwoIdx) ∧
        CFSG.LocalAnalysis.GLTheoremA.MI.indAut p J b hS.b_norm ∈
          innAutDerived (PSimple p J)) ∨
      (catalogIs (PSimple p J) (onLie isUnitaryCharTwoIdx) ∧
        CFSG.LocalAnalysis.GLTheoremA.MI.indAut p J b hS.b_norm ∈
          innAutDerived (PSimple p J)) ∨
      InducesInnerMod p J b

