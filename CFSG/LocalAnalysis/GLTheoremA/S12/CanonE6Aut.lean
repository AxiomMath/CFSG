theorem le_conj_range_of_isElemAbelian_E6 {K : Type} [Field K] [Finite K] {f : ℕ}
    (hK : Nat.card K = 2 ^ f) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp3 : p ≠ 3) (hpf : ¬ p ∣ f)
    {E : Subgroup (MulAut (adjointGroup .E6 K))} (hE : IsElemAbelian p E) :
    E ≤ (MulAut.conj : adjointGroup .E6 K →* MulAut (adjointGroup .E6 K)).range := by
  obtain ⟨Θ, -, -, hker, -, -⟩ :=
    ordinary_E_field_graph_quotient_and_involutions .E6 (Or.inl rfl) K
  have hodd : Odd p := hp.odd_of_ne_two hp2
  have hsq : ∀ y : Multiplicative (ZMod (exactE .E6)), y ^ 2 = 1 := by
    have h0 : ∀ z : ZMod 2, z + z = 0 := by decide
    intro y
    rw [pow_two]
    exact congrArg Multiplicative.ofAdd (h0 (Multiplicative.toAdd y))
  have hcard :=
    (CFSG.LocalAnalysis.ComponentInitial.card_ringAut_and_isCyclic Nat.prime_two K hK).1
  intro e he
  have hep : e ^ p = 1 := hE.2 e he
  have h2 : (Θ e).2 = 1 := by
    refine TableBExc.eq_one_of_sq_of_pow_odd hodd (hsq _) ?_
    rw [← Prod.pow_snd, ← map_pow, hep, map_one, Prod.snd_one]
  have h1 : (Θ e).1 = 1 := by
    have hpσ : (Θ e).1 ^ p = 1 := by
      rw [← Prod.pow_fst, ← map_pow, hep, map_one, Prod.fst_one]
    have hdvd : orderOf (Θ e).1 ∣ f := by
      have := orderOf_dvd_natCard (Θ e).1
      rwa [hcard] at this
    have h3 : orderOf (Θ e).1 ∣ Nat.gcd p f := Nat.dvd_gcd (orderOf_dvd_of_pow_eq_one hpσ) hdvd
    rw [((Nat.Prime.coprime_iff_not_dvd hp).2 hpf).gcd_eq_one] at h3
    exact orderOf_eq_one_iff.1 (Nat.dvd_one.1 h3)
  have hΘ1 : Θ e = 1 := Prod.ext h1 h2
  obtain ⟨g, a, hga⟩ := (hker _).1 hΘ1
  have hα : e = MulAut.conj g * exactNormalAut .E6 K a 1 0 :=
    eq_conj_mul_exactNormalAut_of_apply (σ := 1) (ε := 0) fun h => by
      rw [hga h, exactQ_zero, AutSt.units_map_entrywiseHom_one, inv_one, mul_one, mul_one]
  obtain ⟨k, -, hk⟩ := Nat.exists_mul_mod_eq_one_of_coprime
    ((Nat.coprime_primes Nat.prime_three hp).2 (Ne.symm hp3)) hp.one_lt
  rw [← TableBExc.pow_mul_eq_self_of_mod hk hep, pow_mul]
  exact Subgroup.pow_mem _ (TableBExc.pow_three_mem_inn_of_eq hα) k

theorem not_pow_five_dvd_E6_four {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2 ^ 2) :
    ¬ 5 ^ 5 ∣ Nat.card (adjointGroup .E6 K) := by
  have hT : Nat.card (torusGroup .E6 K) ∣ 3 ^ 6 := by
    have h := CFSG.Timmesfeld.ExceptionalOrders.card_torusGroup_mul (τ := Tag.E6) (K := K)
    rw [hK] at h
    exact Dvd.intro _ (by simpa [Tag.rank] using h)
  rw [TableBExc.card_adjointGroup_E6_eq, hK]
  intro h
  have hcop : Nat.Coprime (5 ^ 5) (Nat.card (torusGroup .E6 K)) :=
    Nat.Coprime.coprime_dvd_right hT (by norm_num)
  have h' := hcop.dvd_of_dvd_mul_left h
  revert h'
  simp only [TableBExc.prodE6, CFSG.Timmesfeld.ExceptionalOrders.geomSum, Finset.sum_range_succ,
    Finset.sum_range_zero]
  norm_num

theorem card_le_five_pow_four_aut_E6 {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2 ^ 2)
    {E : Subgroup (MulAut (adjointGroup .E6 K))} (hE : IsElemAbelian 5 E) : Nat.card E ≤ 5 ^ 4 := by
  have : Finite (adjointGroup .E6 K) := generated_group_finite .E6 K
  have : Finite (MulAut (adjointGroup .E6 K)) := TableBSymp.finite_mulAut
  have hle := le_conj_range_of_isElemAbelian_E6 hK Nat.prime_five (by norm_num) (by norm_num)
    (by norm_num) hE
  have hinj : Function.Injective
      (MulAut.conj : adjointGroup .E6 K →* MulAut (adjointGroup .E6 K)) := by
    have hZ := center_adjointGroup_eq_bot (τ := Tag.E6) (K := K)
    rw [injective_iff_map_eq_one]
    intro g hg
    have hc : g ∈ Subgroup.center (adjointGroup .E6 K) := by
      rw [Subgroup.mem_center_iff]
      intro h
      have := congrArg (fun φ : MulAut (adjointGroup .E6 K) => φ h) hg
      simp only [MulAut.conj_apply, MulAut.one_apply] at this
      exact (mul_inv_eq_iff_eq_mul.1 this).symm
    rw [hZ, Subgroup.mem_bot] at hc
    exact hc
  have hNcard : Nat.card (MulAut.conj : adjointGroup .E6 K →* MulAut (adjointGroup .E6 K)).range =
      Nat.card (adjointGroup .E6 K) :=
    (Nat.card_congr (MonoidHom.ofInjective hinj).toEquiv).symm
  have hdvd : Nat.card E ∣ Nat.card (adjointGroup .E6 K) := hNcard ▸ Subgroup.card_dvd_of_le hle
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  obtain ⟨k, hk⟩ := (CFSG.Open.IsElemAbelian.isPGroup hE).exists_card_eq
  by_contra hgt
  have hk5 : 5 ≤ k := by
    rw [hk] at hgt
    by_contra hk4
    exact hgt (Nat.pow_le_pow_right (by norm_num) (by omega))
  exact not_pow_five_dvd_E6_four hK ((Nat.pow_dvd_pow 5 hk5).trans (hk ▸ hdvd))

theorem e6FourAutRank5_holds : E6FourAutRank5 := by
  intro Γ _ _ J B lab hlab htag hn hZ hBN hBe
  obtain ⟨K, iF, iFin, iC, hK, ⟨eA⟩⟩ := exists_adjointGroup_equiv_of_label_E6 hlab htag hn hZ
  let θ : ↥J ⧸ Subgroup.center ↥J ≃* adjointGroup Tag.E6 K :=
    ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).trans eA.symm
  have hperf : commutator ↥J = ⊤ := hlab.1
  have hker : (ggBeta J θ hBN).ker = (B ⊓ Subgroup.centralizer (J : Set Γ)).subgroupOf B := by
    ext b
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, Subgroup.mem_inf]
    constructor
    · intro h1
      exact ⟨b.2, mem_centralizer_of_ggLAut_eq_one J θ hperf (g := ⟨b, hBN b.2⟩) h1⟩
    · rintro ⟨-, hc⟩
      exact ggLAut_eq_one_of_mem_centralizer J θ (g := ⟨b, hBN b.2⟩) hc
  have hcardker : Nat.card (ggBeta J θ hBN).ker = Nat.card ↥(B ⊓ Subgroup.centralizer (J : Set Γ)) := by
    rw [hker]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe inf_le_left).toEquiv
  have hrange : IsElemAbelian 5 (ggBeta J θ hBN).range := by
    have h := (CFSG.Open.IsElemAbelian.subgroupOf hBe B).map (ggBeta J θ hBN)
    rwa [Subgroup.subgroupOf_self, ← MonoidHom.range_eq_map] at h
  have h2 := TableB.card_range_mul_card_ker (ggBeta J θ hBN)
  rw [hcardker] at h2
  have h3 := card_le_five_pow_four_aut_E6 hK hrange
  calc Nat.card B = Nat.card (ggBeta J θ hBN).range *
        Nat.card ↥(B ⊓ Subgroup.centralizer (J : Set Γ)) := h2.symm
    _ ≤ 5 ^ 4 * Nat.card ↥(B ⊓ Subgroup.centralizer (J : Set Γ)) := Nat.mul_le_mul_right _ h3

theorem E6FourResidualFacts.toE6FourFacts (h : E6FourResidualFacts) : E6FourFacts :=
  ⟨e6FourAutRank5_holds, e6FourLocal5_holds, h.cent, h.field, h.uni, h.omega, h.twE6, h.omegaRank⟩

