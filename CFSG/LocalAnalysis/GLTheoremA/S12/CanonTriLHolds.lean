theorem spRange_rootSpan_smul {τ : Tag} {K : Type} [Field K] (v : WeylGroup τ)
    {S : Set (Fin τ.rank → ℤ)} (hS : ∀ α ∈ S, IsRoot τ α) {m : ℕ}
    {Ψ : StatedSp m K →* ModGL τ K} (hker : Ψ.ker ≤ Subgroup.center (StatedSp m K))
