    (fun k => ρF (b3Node k)) (fun k => ⟨hρFi _, hρFr _⟩)
    (fun _ _ => ψ0)
    (fun i h => by
      obtain rfl : i = 0 := Fin.ext (by have := i.2; omega)
      exact hψ0a)
    (fun i h => by
      obtain rfl : i = 0 := Fin.ext (by have := i.2; omega)
