theorem false_of_G2_of_orthModel {J : Type} [Group J] [Finite J] {m s f : ℕ}
    (hJ : HasLabel J (fun l : GLALabel => l = ⟨.G2, 0, m⟩))
    (hM : StatedClassicalModel (J ⧸ Subgroup.center J) .POmegaPlus s 2 f ∨
      StatedClassicalModel (J ⧸ Subgroup.center J) .POmegaMinus s 2 f) : False := by
  have hD := CFSG.LocalAnalysis.GLTheoremA.Y10GFldOrth.orthLabelDict_of_ggLabelRigidInput
    ggLabelRigidInput_holds J ⟨.G2, 0, m⟩ s f hJ
  rcases hM with hM | hM
  · exact false_of_canonLabel_G2 (hD.1 hM) (by simp)
  · exact false_of_canonLabel_G2 (hD.2 hM) (by simp)

theorem pow_eq_one_of_conj_pow_eq_one {S : Type} [Group S] (hcen : Subgroup.center S = ⊥)
    {a : S} {p : ℕ} (h : MulAut.conj a ^ p = 1) : a ^ p = 1 := by
  have hc : a ^ p ∈ Subgroup.center S := by
    rw [Subgroup.mem_center_iff]
    intro z
    have hz := DFunLike.congr_fun (show MulAut.conj (a ^ p) = 1 by rw [map_pow, h]) z
    rw [MulAut.conj_apply, MulAut.one_apply] at hz
    exact (mul_inv_eq_iff_eq_mul.mp hz).symm
  rw [hcen] at hc
  exact Subgroup.mem_bot.mp hc

theorem false_of_G2_orth {S : Type} [Group S] [Finite S] {labL : GLALabel} {β : MulAut S} {p m : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) (hcen : Subgroup.center S = ⊥) (hF : FamOrth labL)
    (hin : InnDiagKind S labL β) (hβp : β ^ p = 1) {K : Subgroup S}
    (hK : CFSG.Open.IsComponentOf K (fixSubgroup β))
    (hKl : HasLabel ↥K (fun l : GLALabel => l = ⟨.G2, 0, m⟩)) : False := by
  obtain ⟨hmodel, a, rfl⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GInnOrthMark.innDiagKind_orth_data hcen hF hin
  have hap : a ^ p = 1 := pow_eq_one_of_conj_pow_eq_one hcen hβp
  obtain ⟨t, ht, hG⟩ : ∃ t : StatedLieTag, (t = .POmegaPlus ∨ t = .POmegaMinus) ∧
      StatedClassicalModel S t labL.rank 2 (canonLabel labL).n := by
    rcases hmodel with hG | hG
    · exact ⟨_, Or.inl rfl, hG⟩
    · exact ⟨_, Or.inr rfl, hG⟩
  obtain ⟨X, inst, -, hXLie, hfac, -, g, hg, hker⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieComp.exists_lieFactor_of_component_conj_omega_card
      CFSG.HardMathSupport.Solomon.Coordinator.LieComp.slFactorFacts_holds
      CFSG.HardMathSupport.Solomon.Coordinator.LieComp.suFactorFacts_holds
      CFSG.HardMathSupport.Solomon.Coordinator.LieComp.omegaFactorField_holds
      hp hp2 (Or.inr ht) hG hp2 a hap K hK
  letI := inst
  obtain ⟨eJ⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.center_quot_equiv_of_surjective
    hXLie.perfect g hg hker
  unfold CFSG.HardMathSupport.Solomon.Coordinator.LieComp.OrthFactorOver at hfac
  rcases hfac with hSL | hSU | hSp | hOm
  · obtain ⟨b, k, E, _, _, hb, hE, -, hφ⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.linCase_of_factor eJ hSL
    exact false_of_G2_of_quot_statedSL hb hE hKl hφ
  · obtain ⟨b, k, E, _, _, τ, hτ, hb, hτk, hE, -, hφ⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.uniCase_of_factor eJ hSU
    exact false_of_G2_of_quot_heldSU τ hτ hb hτk hE hKl hφ
  · obtain ⟨K', _, _, hK'card, hK'ring, s, hs2, hne, ⟨eX⟩⟩ := hSp
    haveI : Finite K' := Finite.of_fintype K'
    have hchar : CharP K' 2 := ringChar.of_eq hK'ring
    have hne' : ¬(s = 2 ∧ Nat.card K' = 2) := fun h => hne (by rw [h.1, h.2])
    obtain ⟨eXZ⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_sp
      (s := s) hs2 hne' hchar eX
    exact false_of_G2_of_quot_statedSp hs2 hK'card hne' hKl (eJ.trans eXZ)
  · obtain ⟨K', _, _, V, _, _, _, Q, hK'card, _, hQ, hd, hT, ⟨eX⟩⟩ := hOm
    obtain ⟨s, hs⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.Y10GInnOrthModel.exists_statedClassicalModel_quotCenter_orthDerived
        hK'card hQ hd hT eX
    rcases hs with hplus | hminus
    · exact false_of_G2_of_orthModel hKl
        (Or.inl (CFSG.Open.StatedAPI.statedClassicalModel_of_mulEquiv eJ.symm hplus))
    · exact false_of_G2_of_orthModel hKl
        (Or.inr (CFSG.Open.StatedAPI.statedClassicalModel_of_mulEquiv eJ.symm hminus))

theorem two_pow_twelve_dvd_of_G2 {S : Type} [Group S] [Finite S] {m : ℕ} {K : Subgroup S}
    (hKl : HasLabel ↥K (fun l : GLALabel => l = ⟨.G2, 0, m⟩)) : 2 ^ 12 ∣ Nat.card S := by
  have hG : CFSG.Blueprint.LieModel (↥K ⧸ Subgroup.center ↥K) .G2 0 2 m :=
    CFSG.LocalAnalysis.GLTheoremA.CanonSubcomp.markedModel_of_hasLabel hKl
  have h1 := CFSG.EvenSporadicStandard.Induction.two_pow_twelve_dvd_card_of_lieModel_G2 hG
  have h2 : Nat.card (↥K ⧸ Subgroup.center ↥K) ∣ Nat.card ↥K := Subgroup.index_dvd_card _
  exact h1.trans (h2.trans (Subgroup.card_subgroup_dvd_card K))

open CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher CFSG.LocalAnalysis.ComponentInitial.SymplecticFlag in
theorem innDiagKind_symp_data_BC {S : Type} [Group S] [Finite S] {labK : GLALabel} {α : MulAut S}
    (hcen : Subgroup.center S = ⊥) (ht : labK.tag = .B ∨ labK.tag = .C)
    (hin : InnDiagKind S labK α) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (m : ℕ), 2 ≤ m ∧ Nat.card K = 2 ^ labK.n ∧
      ∃ (e : S ≃* StatedProj (StatedSp m K)) (A : gsp m K),
        ∀ l : S, e (α l) = conjAut m K A (e l) := by
  unfold InnDiagKind CFSG.Assembly.LargeEvenMarking at hin
  obtain ⟨-, lab', hlam, hraw⟩ := hin
  obtain ⟨_, _, _, _, hQ⟩ := CFSG.StandardType.Canonical.largeEvenRawDatum_exists hraw
  obtain ⟨-, -, -, hlab, -⟩ := hQ
  subst lab'
  rcases ht with ht | ht
  all_goals
    have hm : 2 ≤ labK.rank := by
      have h := hlam
      simp only [CFSG.Assembly.LargeEvenInLambda2, ht] at h
      exact h.2.1
    unfold CFSG.Assembly.LargeEvenRawDatum at hraw
    simp only [ht] at hraw
    unfold CFSG.Assembly.LargeEvenRecipeSymplectic at hraw
    obtain ⟨K, hK, hKf, hcard, hQ'⟩ := hraw
    obtain ⟨-, -, θ, -, u, hu, hind⟩ := hQ'
    obtain ⟨A, hA⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.Y10GFldSympMark.exists_conjAut_eq_of_mem_matConjImage hu
    let e : S ≃* StatedProj (StatedSp labK.rank K) :=
      ((QuotientGroup.quotientMulEquivOfEq hcen).trans
        QuotientGroup.quotientBot).symm.trans θ
    have hαu : ∀ l : S, e (α l) = conjAut labK.rank K A (e l) := by
      intro l
      rw [hA]
      exact (hind l (α l) rfl).symm
    exact ⟨K, hK, hKf, labK.rank, hm, hcard, e, A, hαu⟩

open CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher CFSG.LocalAnalysis.ComponentInitial.SymplecticFlag in
theorem false_of_G2_symp {S : Type} [Group S] [Finite S] {labL : GLALabel} {β : MulAut S} {p m : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) (hcen : Subgroup.center S = ⊥)
    (ht : labL.tag = .B ∨ labL.tag = .C) (hin : InnDiagKind S labL β) (hβp : β ^ p = 1)
    {K : Subgroup S} (hK : CFSG.Open.IsComponentOf K (fixSubgroup β))
    (hKl : HasLabel ↥K (fun l : GLALabel => l = ⟨.G2, 0, m⟩)) : False := by
  classical
  obtain ⟨F, hF, hFf, r, hr, hcard, e, A, hαA⟩ := innDiagKind_symp_data_BC hcen ht hin
  have hn : 1 ≤ labL.n := by
    rcases Nat.eq_zero_or_pos labL.n with h0 | h0
    · exfalso
      rw [h0, pow_zero] at hcard
      have : 1 < Nat.card F := Finite.one_lt_card
      omega
    · exact h0
  have h2 : (2 : F) = 0 := by
    haveI := Fintype.ofFinite F
    obtain ⟨q, hq, k, hqp, hqcard⟩ := FiniteField.card' F
    have hc := hcard
    rw [Nat.card_eq_fintype_card, hqcard] at hc
    have hdvd : q ∣ 2 ^ labL.n := by
      rw [← hc]
      exact dvd_pow_self q (PNat.ne_zero k)
    have hq2 : q = 2 :=
      (Nat.prime_dvd_prime_iff_eq hqp Nat.prime_two).mp (hqp.dvd_of_dvd_pow hdvd)
    subst hq2
    exact_mod_cast CharP.cast_eq_zero F 2
  obtain ⟨x, hx⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GInnSympRed.exists_conjAut_eq_conj h2 A
  have hMEq : MulAut.congr e β = MulAut.conj (proj r F x) := by
    rw [← hx]
    ext z
    have h1 := hαA (e.symm z)
    rw [MulEquiv.apply_symm_apply] at h1
    exact h1
  have hZ : Subgroup.center (StatedProj (StatedSp r F)) = ⊥ := by
    rw [eq_bot_iff]
    intro z hz
    have hz' : e.symm z ∈ Subgroup.center S := by
      rw [Subgroup.mem_center_iff] at hz ⊢
      intro g
      apply e.injective
      simp only [map_mul, MulEquiv.apply_symm_apply]
      exact hz (e g)
    rw [hcen, Subgroup.mem_bot] at hz'
    rw [Subgroup.mem_bot]
    simpa using congrArg e hz'
  have hpow : MulAut.conj (proj r F x) ^ p = 1 := by
    rw [← hMEq, ← map_pow, hβp, map_one]
  have hxp : x ^ p = 1 :=
    CFSG.LocalAnalysis.GLTheoremA.Y10GInnSympRed.pow_eq_one_of_conj_pow_eq_one h2 hZ hpow
  have hK' := isComponentOf_transport e β hK
  rw [hMEq] at hK'
  have hKl' := hasLabel_transport e hKl
  obtain ⟨-, hcomp⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieComp.lieCompsCore_conj_sp_card (a6 := False)
      CFSG.HardMathSupport.Solomon.Coordinator.LieComp.slFactorFacts_holds
      CFSG.HardMathSupport.Solomon.Coordinator.LieComp.suFactorFacts_holds
      CFSG.HardMathSupport.Solomon.Coordinator.LieComp.spFactorFacts_holds
      CFSG.HardMathSupport.Solomon.Coordinator.LieComp.spFourTwoFacts_holds
      (fun h => h.elim) (fun h => h.elim) (fun h => h.elim)
      hp hp2 Nat.prime_two hn hcard (by omega) hp2 (fun h => h.elim) x hxp
  obtain ⟨X, inst, hXfin, ⟨hXLie, -⟩, hfac, f, hf, hker⟩ := hcomp _ hK'
  letI := inst
  obtain ⟨eJ⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.center_quot_equiv_of_surjective
    hXLie.perfect f hf hker
  unfold CFSG.HardMathSupport.Solomon.Coordinator.LieComp.SpFactorOver at hfac
  rcases hfac with hSL | hSU | hSp | hSp42
  · rw [hcard] at hSL
    obtain ⟨b, k, E, _, _, hb, hE, -, hφ⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.linCase_of_factor eJ hSL
    exact false_of_G2_of_quot_statedSL hb hE hKl' hφ
  · rw [hcard] at hSU
    obtain ⟨b, k, E, _, _, τ, hτ, hb, hτk, hE, -, hφ⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.uniCase_of_factor eJ hSU
    exact false_of_G2_of_quot_heldSU τ hτ hb hτk hE hKl' hφ
  · obtain ⟨-, -, s, hs2, hne, ⟨eX⟩⟩ := hSp
    have hne' : ¬(s = 2 ∧ Nat.card F = 2) := fun h => hne (by rw [h.1, h.2])
    have hchar : CharP F 2 := CFSG.RankThree.PartOne.charP_two_of_card_eq_pow hcard
    obtain ⟨eXZ⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_sp
      (s := s) hs2 hne' hchar eX
    exact false_of_G2_of_quot_statedSp hs2 hcard hne' hKl' (eJ.trans eXZ)
  ·
    obtain ⟨-, -, hK2, ⟨eX⟩⟩ := hSp42
    let f₀ : ↥(StatedSp 2 F) ≃* ↥CFSG.ComponentClassification.PresentationLocal.sympFour :=
      (CFSG.Monster.Existence.Compat.statedProjEquivOfBot (StatedSp 2 F)
        (CFSG.Monster.Existence.Compat.statedScalars_eq_bot hK2)).symm.trans
        (CFSG.RankThree.PartOne.KCSpComm.statedProjEquivSympFour hK2)
    have hmap : (commutator ↥(StatedSp 2 F)).map f₀.toMonoidHom =
        commutator ↥CFSG.ComponentClassification.PresentationLocal.sympFour := by
      rw [commutator_def, commutator_def, Subgroup.map_commutator, ← MonoidHom.range_eq_map,
        f₀.toMonoidHom.range_eq_top_of_surjective f₀.surjective]
    let eC : ↥(commutator ↥(StatedSp 2 F)) ≃*
        ↥(commutator ↥CFSG.ComponentClassification.PresentationLocal.sympFour) :=
      (f₀.subgroupMap _).trans (MulEquiv.subgroupCongr hmap)
    haveI : IsSimpleGroup
        ↥(commutator ↥CFSG.ComponentClassification.PresentationLocal.sympFour) :=
      CFSG.ComponentClassification.PresentationLocal.isSimpleGroup_commutator_sympFour
    haveI : Group.IsPerfect
        ↥(commutator ↥CFSG.ComponentClassification.PresentationLocal.sympFour) :=
      CFSG.ComponentClassification.PresentationLocal.isPerfect_commutator_sympFour
    have hcenC : Subgroup.center
        ↥(commutator ↥CFSG.ComponentClassification.PresentationLocal.sympFour) = ⊥ := by
      rcases (inferInstance : (Subgroup.center
          ↥(commutator ↥CFSG.ComponentClassification.PresentationLocal.sympFour)).Normal).eq_bot_or_eq_top
        with h | h
      · exact h
      · exact absurd (Subgroup.center_eq_top_iff.1 h) (Group.IsPerfect.not_isMulCommutative _)
    obtain ⟨eXZ⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_of_mulEquiv
      (eX.trans eC)
    let eA := (eJ.trans eXZ).trans ((CFSG.LocalAnalysis.GLTheoremA.CanonInn.quotCenterEquivOfBot hcenC).trans
      CFSG.ComponentClassification.PresentationLocal.commutatorEquivAlternating)
    exact false_of_canonLabel_G2
      (CFSG.LocalAnalysis.GLTheoremA.Y10GSympLabel.canonLabel_eq_of_quot_alternating
        ggLabelRigidInput_holds hKl' eA) (by simp)

theorem two_eq_zero_of_card {F : Type} [Field F] [Finite F] {n : ℕ} (hcard : Nat.card F = 2 ^ n) :
    (2 : F) = 0 := by
  haveI := CFSG.RankThree.PartOne.charP_two_of_card_eq_pow hcard
  exact_mod_cast CharP.cast_eq_zero F 2

theorem exists_card_eq_two_pow {F E : Type} [Field F] [Field E] [Algebra F E] [Finite E]
    (h2 : (2 : F) = 0) : ∃ k : ℕ, Nat.card E = 2 ^ k := by
  haveI : CharP F 2 := CharTwo.of_one_ne_zero_of_two_eq_zero one_ne_zero h2
  have hcharE : ringChar E = 2 := by rw [← Algebra.ringChar_eq F E, ringChar.eq F 2]
  haveI : CharP E 2 := ringChar.of_eq hcharE
  haveI := Fintype.ofFinite E
  obtain ⟨k, -, hk⟩ := FiniteField.card E 2
  exact ⟨k, by rw [Nat.card_eq_fintype_card, hk]⟩

theorem false_of_G2_lin {S : Type} [Group S] [Finite S] {labL : GLALabel} {β : MulAut S} {p m : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) (hcen : Subgroup.center S = ⊥) (hF : FamLin labL)
    (hin : InnDiagKind S labL β) (hβp : β ^ p = 1) {K : Subgroup S}
    (hK : CFSG.Open.IsComponentOf K (fixSubgroup β))
    (hKl : HasLabel ↥K (fun l : GLALabel => l = ⟨.G2, 0, m⟩)) : False := by
  classical
  obtain ⟨F, hF', hFf, d, hd, hcard, A, u, e, hαu, hu⟩ :=
    CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.innDiag_linear_data hcen hF hin
  have h2 : (2 : F) = 0 := two_eq_zero_of_card hcard
  have hue : MulAut.congr e β = u := by
    ext z
    obtain ⟨l, rfl⟩ := e.surjective z
    show e (β (e.symm (e l))) = u (e l)
    rw [MulEquiv.symm_apply_apply]
    exact hαu l
  have hupow : u ^ p = 1 := by rw [← hue, ← map_pow, hβp, map_one]
  obtain ⟨c, hc⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.isScalar_of_pow_trivial h2 A p u hu hupow
  have hodd := CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.odd_orderOf_of_pow_scalar h2 hd A
    (hp.odd_of_ne_two hp2) hc
  have hord := CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.cast_orderOf_ne_zero_of_odd h2 A hodd
  have hJ := isComponentOf_transport e β hK
  rw [hue] at hJ
  have hJl := hasLabel_transport e hKl
  obtain ⟨M, hM, hMJ⟩ := exists_isComponentOf_lift (LargeEvenProjMk (StatedSL d F))
    (QuotientGroup.mk'_surjective _) CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.ker_projMk_le_center
    (CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.conjSL A) u
    (fun k => (hu k (CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.conjSL A k) rfl).symm) hJ
  have hMinj : Function.Injective (StatedSL d F).subtype := Subtype.val_injective
  have hM' : CFSG.Open.IsComponentOf (M.map (StatedSL d F).subtype)
      (Subgroup.centralizer ({A} : Set (GL (Fin d) F)) ⊓ StatedSL d F) := by
    rw [← CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.map_fixSubgroup_conjSL A]
    refine CFSG.LocalAnalysis.GLTheoremA.I142N.isComponentOf_map _ (fun g hg => ?_) hM
    rw [show g = 1 from hMinj (by simpa using hg)]
    exact one_mem _
  obtain ⟨a, E, hEf, hEalg, hEfin, ha, ⟨eM⟩⟩ :=
    CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.held_linear_components_gl
      CFSG.LieType.SemisimpleCentralizers.Held.SLComponentsTrivial_holds A hord _ hM'
  obtain ⟨eJM⟩ := nonempty_centerQuot_of_map_eq (LargeEvenProjMk (StatedSL d F))
    CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.ker_projMk_le_center hM.2.2.1 hMJ
  obtain ⟨eMZ⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_of_mulEquiv
    (Subgroup.equivMapOfInjective M _ hMinj)
  letI := hEf
  letI := hEalg
  obtain ⟨k, hk⟩ := exists_card_eq_two_pow (F := F) (E := E) h2
  exact false_of_G2_of_quot_statedSL ha hk hJl ⟨(eJM.trans eMZ).trans eM⟩

open CFSG.LocalAnalysis.GLTheoremA.Y10GInnUni in
theorem false_of_G2_uni {S : Type} [Group S] [Finite S] {labL : GLALabel} {β : MulAut S} {p m : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) (hcen : Subgroup.center S = ⊥) (hFam : FamUni labL)
    (hin : InnDiagKind S labL β) (hβp : β ^ p = 1) {K : Subgroup S}
    (hK : CFSG.Open.IsComponentOf K (fixSubgroup β))
    (hKl : HasLabel ↥K (fun l : GLALabel => l = ⟨.G2, 0, m⟩)) : False := by
  classical
  obtain ⟨F, hF', hFf, d, τ, hτ, hτQ, hcardF, hd, hd3, A, u, e, hA, hαu, hu⟩ :=
    innDiag_unitary_data hcen hFam hin
  have h2 : (2 : F) = 0 := two_eq_zero_of_card (n := 2 * labL.n) (by rw [hcardF, ← pow_mul,
    Nat.mul_comm])
  generalize hQdef : 2 ^ labL.n = Q at *
  have hdQ : (d, Q) ≠ (3, 2) := by
    intro h
    obtain ⟨h1, h2'⟩ := Prod.mk.inj h
    have hn2 := hd3 h1
    have : 4 ≤ Q := by
      rw [← hQdef]
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ labL.n := Nat.pow_le_pow_right (by norm_num) hn2
    omega
  have hue : MulAut.congr e β = u := by
    ext z
    obtain ⟨l, rfl⟩ := e.surjective z
    show e (β (e.symm (e l))) = u (e l)
    rw [MulEquiv.symm_apply_apply]
    exact hαu l
  have hpow : u ^ p = 1 := by rw [← hue, ← map_pow, hβp, map_one]
  have hH : heldSU d F τ hτ = StatedSU d Q F :=
    CFSG.LieType.SemisimpleCentralizers.Held.hct_heldSU_eq_statedSU (a := d) hτQ
  have hnorm : ∀ g : GL (Fin d) F, g ∈ heldGU d F τ hτ → ∀ x ∈ StatedSU d Q F,
      g * x * g⁻¹ ∈ StatedSU d Q F := by
    intro g hg x hx
    rw [← hH] at hx ⊢
    exact heldSU_normal_in_heldGU hτ g hg x hx
  let cA : MulAut ↥(StatedSU d Q F) :=
    uniConjSub (StatedSU d Q F) A (hnorm A hA) (hnorm A⁻¹ (inv_mem hA))
  have hpowk : ∀ (k : ℕ) (h h' : ↥(StatedSU d Q F)),
      (h' : GL (Fin d) F) = A ^ k * (h : GL (Fin d) F) * (A ^ k)⁻¹ →
      (u ^ k) (LargeEvenProjMk (StatedSU d Q F) h) = LargeEvenProjMk (StatedSU d Q F) h' := by
    intro k
    induction k with
    | zero =>
      intro h h' hk
      have : h' = h := by
        apply Subtype.ext
        simpa using hk
      subst this
      simp
    | succ k ih =>
      intro h h' hk
      have step1 : u (LargeEvenProjMk (StatedSU d Q F) h) = LargeEvenProjMk (StatedSU d Q F) (cA h) :=
        hu h (cA h) rfl
      have step2 := ih (cA h) h' (by
        rw [hk, uniConjSub_apply_val, pow_succ]
        group)
      rw [pow_succ, MulAut.mul_apply, step1, step2]
  have hAp : A ^ p ∈ heldGU d F τ hτ := pow_mem hA p
  have hconjB : ∀ g : GL (Fin d) F, g ∈ StatedSU d Q F → ∃ c : F,
      ((A ^ p : GL (Fin d) F) : Matrix (Fin d) (Fin d) F) * (g : Matrix (Fin d) (Fin d) F) *
        (((A ^ p)⁻¹ : GL (Fin d) F) : Matrix (Fin d) (Fin d) F) = c • (g : Matrix (Fin d) (Fin d) F) := by
    intro g hg
    let h : ↥(StatedSU d Q F) := ⟨g, hg⟩
    let h' : ↥(StatedSU d Q F) := ⟨A ^ p * g * (A ^ p)⁻¹, hnorm (A ^ p) hAp g hg⟩
    have hk : (h' : GL (Fin d) F) = A ^ p * (h : GL (Fin d) F) * (A ^ p)⁻¹ := rfl
    have hmk : LargeEvenProjMk (StatedSU d Q F) h' = LargeEvenProjMk (StatedSU d Q F) h := by
      have h1 := hpowk p h h' hk
      rw [hpow] at h1
      simpa using h1.symm
    obtain ⟨c, hc⟩ := (projMk_eq_iff_uni (StatedSU d Q F) h' h).mp hmk
    have hh' : (h' : GL (Fin d) F) = (h : GL (Fin d) F) * (Matrix.GeneralLinearGroup.scalar (Fin d) c)⁻¹ := by
      rw [hc]
      group
    have hGL : A ^ p * g * (A ^ p)⁻¹ = g * (Matrix.GeneralLinearGroup.scalar (Fin d) c)⁻¹ := hh'
    refine ⟨(c : F)⁻¹, ?_⟩
    have hM := congrArg (fun X : GL (Fin d) F => (X : Matrix (Fin d) (Fin d) F)) hGL
    simp only [Units.val_mul] at hM
    rw [hM, ← map_inv, CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.val_scalar_gl, Units.val_inv_eq_inv_val,
      Matrix.mul_smul, Matrix.mul_one]
  obtain ⟨c0, hc0⟩ := uniScalar_holds F Q d τ hτ hτQ hcardF hd hdQ (A ^ p) hconjB
  have hodd : Odd (orderOf A) :=
    CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.odd_orderOf_of_pow_scalar h2 (by omega) A
      (hp.odd_of_ne_two hp2) hc0
  have hord : ((orderOf A : ℕ) : F) ≠ 0 :=
    CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.cast_orderOf_ne_zero_of_odd h2 A hodd
  have hJ := isComponentOf_transport e β hK
  rw [hue] at hJ
  have hJl := hasLabel_transport e hKl
  obtain ⟨M, hM, hMJ⟩ := exists_isComponentOf_lift (LargeEvenProjMk (StatedSU d Q F))
    (QuotientGroup.mk'_surjective _) (ker_projMk_uni_le_center (StatedSU d Q F)) cA u
    (fun k => (hu k (cA k) rfl).symm) hJ
  have hMinj : Function.Injective (StatedSU d Q F).subtype := Subtype.val_injective
  have hM' : CFSG.Open.IsComponentOf (M.map (StatedSU d Q F).subtype)
      (Subgroup.centralizer ({A} : Set (GL (Fin d) F)) ⊓ StatedSU d Q F) := by
    rw [← map_fixSubgroup_uniConjSub (StatedSU d Q F) A (hnorm A hA) (hnorm A⁻¹ (inv_mem hA))]
    refine CFSG.LocalAnalysis.GLTheoremA.I142N.isComponentOf_map _ (fun g hg => ?_) hM
    rw [show g = 1 from hMinj (by simpa using hg)]
    exact one_mem _
  have hcompH : CFSG.Open.IsComponentOf (M.map (StatedSU d Q F).subtype)
      (Subgroup.centralizer ({A} : Set (GL (Fin d) F)) ⊓ heldSU d F τ hτ) := by
    rw [hH]
    exact hM'
  have hcompGU := isComponentOf_centralizer_gu_of_su hτ A hcompH
  have hsized := held_unitary_components_gu_sized
    CFSG.LieType.SemisimpleCentralizers.Held.SUComponentsTrivial_holds
    CFSG.LieType.SemisimpleCentralizers.Held.SLComponentsTrivial_holds hτ hτQ hcardF A hA hord
    (M.map (StatedSU d Q F).subtype) hcompGU
  obtain ⟨eJM⟩ := nonempty_centerQuot_of_map_eq (LargeEvenProjMk (StatedSU d Q F))
    (ker_projMk_uni_le_center (StatedSU d Q F)) hM.2.2.1 hMJ
  obtain ⟨eMZ⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_of_mulEquiv
    (Subgroup.equivMapOfInjective M _ hMinj)
  rcases hsized with ⟨a, dd, E, hE, hEfin, τ', hτ', ha2, hτ'Q, hcardE, ⟨eM⟩⟩ |
    ⟨b, e', E, hE, hEfin, hb2, hcardE, ⟨eM⟩⟩
  · letI := hE
    have hpw : Q ^ dd = 2 ^ (labL.n * dd) := by rw [← hQdef, ← pow_mul]
    rw [hpw] at hτ'Q hcardE
    exact false_of_G2_of_quot_heldSU τ' hτ' ha2 hτ'Q hcardE hJl ⟨(eJM.trans eMZ).trans eM⟩
  · letI := hE
    have hpw : Q ^ (2 * e') = 2 ^ (labL.n * (2 * e')) := by rw [← hQdef, ← pow_mul]
    rw [hpw] at hcardE
    exact false_of_G2_of_quot_statedSL hb2 hcardE hJl ⟨(eJM.trans eMZ).trans eM⟩

theorem card_of_label_char_two {S : Type} [Group S] [Finite S] (hcen : Subgroup.center S = ⊥)
    {lab : GLALabel} (hS : HasLabel S (· = lab)) (hc : CFSG.StandardType.markChar lab = 2) :
    Nat.card S = CFSG.SeitzReduction.F4Pilot.evenLieOrder (CFSG.StandardType.markTag lab)
      (CFSG.StandardType.markRank lab) (CFSG.StandardType.markDeg lab) := by
