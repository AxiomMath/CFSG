theorem exists_spCover_of_spRange {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup τ L p₀) {ta : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ ta ∈ S.D.torus)
    (i : KernelComponent (rootCharHom ta))
    (hinner : twistInner (componentRoots (rootCharHom ta) i)
      ((S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ
        (componentRoots (rootCharHom ta) i)]))
    {m : ℕ} (hm : 2 ≤ m)
    (hrec : ∀ K : Subfield L, Finite ↥K →
      Nat.card ↥K = S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom ta) i) →
      ¬(m = 2 ∧ Nat.card ↥K = 2) ∧ ∃ Ψ : StatedSp m ↥K →* ModGL τ ↥K,
        Ψ.ker ≤ Subgroup.center (StatedSp m ↥K) ∧
        Ψ.range = componentRootSpan K (rootCharHom ta) i) :
    ∃ (K : Subfield L) (_ : Finite ↥K), ¬(m = 2 ∧ Nat.card ↥K = 2) ∧
      ∃ g : StatedSp m ↥K →* ↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i),
        Function.Surjective g ∧ g.ker ≤ Subgroup.center (StatedSp m ↥K) := by
  classical
  obtain ⟨σ, hfin, hcard, f, hf1, hker, hf2⟩ := exists_inner_cover S hT i hinner
  obtain ⟨hne, Ψ, hΨker, hΨrange⟩ := hrec (fixSubfield σ) hfin hcard
  haveI := hfin
  haveI : Fintype ↥(fixSubfield σ) := Fintype.ofFinite _
  have hne' : (m, Fintype.card ↥(fixSubfield σ)) ≠ (2, 2) := fun h =>
    hne ⟨(Prod.mk.inj h).1, by rw [Nat.card_eq_fintype_card]; exact (Prod.mk.inj h).2⟩
  have hSpPerf : commutator (StatedSp m ↥(fixSubfield σ)) = ⊤ :=
    (spFactorFacts_holds _ m hm hne').perfect
  have hCperf : ⁅componentRootSpan (fixSubfield σ) (rootCharHom ta) i,
      componentRootSpan (fixSubfield σ) (rootCharHom ta) i⁆ =
      componentRootSpan (fixSubfield σ) (rootCharHom ta) i := by
    rw [← hΨrange, MonoidHom.range_eq_map, ← Subgroup.map_commutator, ← commutator_def, hSpPerf]
  have hRf : f.range = rationalComponent S.ρ S.Γ (rootCharHom ta) i := le_antisymm (hf2 hCperf) hf1
  have hmemC : ∀ x, Ψ x ∈ componentRootSpan (fixSubfield σ) (rootCharHom ta) i := fun x => by
    rw [← hΨrange]
    exact ⟨x, rfl⟩
  let Ψ' := Ψ.codRestrict _ hmemC
  have hmemR : ∀ c, f c ∈ rationalComponent S.ρ S.Γ (rootCharHom ta) i := fun c => by
    rw [← hRf]
    exact ⟨c, rfl⟩
  let g₀ := f.codRestrict _ hmemR
  refine ⟨fixSubfield σ, hfin, hne, g₀.comp Ψ', ?_, ?_⟩
  · intro y
    obtain ⟨c, hc⟩ : ∃ c, f c = (y : ModGL τ L) := by
      have hy : (y : ModGL τ L) ∈ f.range := by
        rw [hRf]
        exact y.2
      exact hy
    obtain ⟨x, hx⟩ : ∃ x, Ψ x = (c : ModGL τ ↥(fixSubfield σ)) := by
      have hc' : (c : ModGL τ ↥(fixSubfield σ)) ∈ Ψ.range := by
        rw [hΨrange]
        exact c.2
      exact hc'
    refine ⟨x, Subtype.ext ?_⟩
    show f (Ψ' x) = (y : ModGL τ L)
    rw [show Ψ' x = c from Subtype.ext hx, hc]
  · intro x hx
    rw [MonoidHom.mem_ker] at hx
    have hΨ'x : Ψ' x ∈ Subgroup.center ↥(componentRootSpan (fixSubfield σ) (rootCharHom ta) i) :=
      hker (MonoidHom.mem_ker.mpr (congrArg Subtype.val hx))
    refine CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.mem_center_of_commutator_mem_center hSpPerf
      (fun y => hΨker ?_)
    rw [MonoidHom.mem_ker]
    have h1 : Ψ' ⁅x, y⁆ = 1 := by
      rw [map_commutatorElement]
      exact (commutatorElement_eq_one_iff_mul_comm).2
        (Subgroup.mem_center_iff.mp hΨ'x (Ψ' y)).symm
    exact congrArg Subtype.val h1

theorem card_subfield_eq_two_pow {L : Type} [Field L] (hch : ringChar L = 2) (K : Subfield L)
    [Finite ↥K] : ∃ k : ℕ, Nat.card ↥K = 2 ^ k := by
  haveI : Fintype ↥K := Fintype.ofFinite _
  have h1 : ringChar ↥K = 2 := by rw [ringChar_subfield' K, hch]
  haveI : CharP ↥K 2 := ringChar.of_eq h1
  obtain ⟨k, -, hk⟩ := FiniteField.card ↥K 2
  exact ⟨k, by rw [Nat.card_eq_fintype_card, hk]⟩

theorem false_of_G2_of_spCover {R : Type} [Group R] {m k mm : ℕ} {K : Type} [Field K] [Finite K]
    (hm : 2 ≤ m) (hne : ¬(m = 2 ∧ Nat.card K = 2)) (hK : Nat.card K = 2 ^ k)
    (g : StatedSp m K →* R) (hg : Function.Surjective g) (hker : g.ker ≤ Subgroup.center (StatedSp m K))
    (hRl : CFSG.LocalAnalysis.GLTheoremA.Y10F.HasLabel R (fun l : GLALabel => l = ⟨.G2, 0, mm⟩)) :
    False := by
  haveI : Fintype K := Fintype.ofFinite K
  have hne' : (m, Fintype.card K) ≠ (2, 2) := fun h =>
    hne ⟨(Prod.mk.inj h).1, by rw [Nat.card_eq_fintype_card]; exact (Prod.mk.inj h).2⟩
  have hSpPerf : commutator (StatedSp m K) = ⊤ := (spFactorFacts_holds K m hm hne').perfect
  obtain ⟨e₁⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.center_quot_equiv_of_surjective hSpPerf g hg hker
  have hchar : CharP K 2 := CFSG.RankThree.PartOne.charP_two_of_card_eq_pow hK
  obtain ⟨e₂⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_sp (s := m) hm hne hchar
    (MulEquiv.refl _)
  exact false_of_G2_of_quot_statedSp hm hK hne hRl (e₁.trans e₂)

theorem exists_sp42_equiv_rationalComponent {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup Tag.F4 L p₀) {a : Fin Tag.F4.rank → Lˣ}
    (hT : rootDiagUnit Tag.F4 a ∈ S.D.torus) (i : KernelComponent (rootCharHom a))
    (v : WeylGroup Tag.F4)
    (hroots : componentRoots (rootCharHom a) i = (fun α => v • α) '' parabolicRoots Tag.F4 f4LeviB2)
    (hinner : twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin Tag.F4.rank → ℤ) → _)^[componentOrbitLength S.ρ
        (componentRoots (rootCharHom a) i)]))
    (hQ : S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) < 3)
    (hqs : CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom a) i)) :
    ∃ (K' : Subfield L) (_ : Finite ↥K'), Nat.card ↥K' = 2 ∧
      Nonempty (↥(commutator ↥(StatedSp 2 ↥K')) ≃* ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) := by
  classical
  obtain ⟨hs0, -, -⟩ := outer_componentOrbitLength_spec S hT i
  obtain ⟨K', hfin, C, D, hC, hD, hcard, f, hf1, hker, hf2⟩ :=
    exists_inner_cover_derived_two S hT i hinner hQ
  haveI : Fintype ↥K' := Fintype.ofFinite _
  have hcard' : Fintype.card ↥K' = 2 := by rw [← Nat.card_eq_fintype_card]; exact hcard
  have hch : ringChar L = 2 := by
    have h2 := ringChar_eq_of_natCard_eq_pow Nat.prime_two (K := ↥K') (f := 1)
      (by rw [hcard]; norm_num) Nat.one_pos
    rw [← ringChar_subfield' K', h2]
  have hQ2 : S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 2 := by
    obtain ⟨r, e, hr, -, he, hq⟩ := exists_char_pow S
    have h2 : 2 ≤ S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) := by
      rw [hq, ← pow_mul]
      exact le_trans hr.two_le (Nat.le_self_pow (Nat.mul_pos he hs0).ne' r)
    omega
  obtain ⟨O⟩ := nonempty_commOrder_ofCartan (f4Datum ↥K').isFiniteType
    (Dv := (f4Datum ↥K').divisible) rfl
  obtain ⟨Cc, -, hCc⟩ := f4_commutatorFormula ↥K' O
  have hE := f4_chevalleyExtras ↥K' O Cc hCc
  choose ρF hρFi hρFr hρFv using exists_rankOne_param hE
  obtain ⟨φ, hφl, hφs⟩ : ∃ φ : StatedSp 2 ↥K' →* adjointGroup .F4 ↥K',
      φ.comp (spBlock ↥K' 1) = ρF (f4Node 1) ∧ φ.comp (spBlock ↥K' 0) = ρF (f4Node 2) := by
    obtain ⟨φ, e, -, he1, he2, he3, he4, hφ⟩ :=
      exists_b2Hom hE (s := f4Node 2) (l := f4Node 1) rfl f4_cartan_21 f4_cartan_12
    obtain ⟨hb0, hb1⟩ := hom_block_eq he1 he2 he3 he4 hφ (hρFv (f4Node 2)) (hρFv (f4Node 1))
    exact ⟨φ, hb1, hb0⟩
  have hφrange : φ.range = rankOne (f4Datum ↥K').rootGroup (f4Node 1) ⊔
      rankOne (f4Datum ↥K').rootGroup (f4Node 2) := by
    rw [ClassicalInvolution.Q3.Q3V.range_eq_sup_of_spBlocks hφs hφl, hρFr, hρFr, sup_comm]
  set n := canonicalRep (coxeterSystem Tag.F4) ↥K' v with hn
  set ψ : StatedSp 2 ↥K' →* ModGL Tag.F4 ↥K' :=
    (MulAut.conj n).toMonoidHom.comp ((adjointGroup .F4 ↥K').subtype.comp φ) with hψ
  have hψrange : ψ.range = C := by
    have hmap := (canonical_weyl_root_transport Tag.F4 ↥K').1 v (parabolicRoots Tag.F4 f4LeviB2)
      (fun α hα => hα.1)
    have hsub : subsystemGroup Tag.F4 ↥K' f4LeviB2 =
        rootSpan Tag.F4 ↥K' (parabolicRoots Tag.F4 f4LeviB2) :=
      CFSG.RankThree.Chevalley.subsystemGroup_eq_iSup_rootSubgroup (τ := Tag.F4) (J := f4LeviB2) ↥K'
    have hCeq : C = rootSpan Tag.F4 ↥K' ((fun α => v • α) '' parabolicRoots Tag.F4 f4LeviB2) := by
      rw [hC]
      show rootSpan Tag.F4 ↥K' (componentRoots (rootCharHom a) i) = _
      rw [hroots]
    rw [hCeq, ← hmap, ← hsub, ← map_subtype_sup_b2, ← hφrange, hψ, MonoidHom.range_comp,
      MonoidHom.range_comp]
  set X' : Subgroup (StatedSp 2 ↥K') := commutator (StatedSp 2 ↥K') with hX'
  have hDmap : D = X'.map ψ := by
    rw [hD, ← hψrange, MonoidHom.range_eq_map, ← Subgroup.map_commutator, hX', commutator_def]
  have hX : LieFactorData 2 ↥X' := spFourTwoFacts_holds ↥K' hcard'
  have hs : IsSimpleGroup ↥X' := isSimpleGroup_commutator_statedSp_two hcard
  have hXp : ⁅X', X'⁆ = X' := Subgroup.isPerfect_iff.1 (Group.isPerfect_def.2 hX.perfect)
  have hperfD : ⁅D, D⁆ = D := by
    rw [hDmap, ← Subgroup.map_commutator, hXp]
  have hRf := le_antisymm hf1 (hf2 hperfD)
  let ψX : ↥X' →* ↥D := (ψ.comp X'.subtype).codRestrict D (fun x => by
    rw [hDmap]
    exact ⟨x, x.2, rfl⟩)
  have hψXsurj : Function.Surjective ψX := by
    rintro ⟨y, hy⟩
    rw [hDmap] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    exact ⟨⟨x, hx⟩, rfl⟩
  have hΦrange : (f.comp ψX).range = f.range := by
    rw [MonoidHom.range_comp, MonoidHom.range_eq_top.2 hψXsurj, ← MonoidHom.range_eq_map]
  have hR1 : rationalComponent S.ρ S.Γ (rootCharHom a) i ≠ ⊥ := by
    intro h
    have hsimple : IsSimpleGroup (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
      Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) := hqs.2.1
    haveI := hsimple.toNontrivial
    obtain ⟨x, hx⟩ := exists_ne (1 : ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
      Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i))
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
    apply hx
    have : g = 1 := Subtype.ext ((Subgroup.eq_bot_iff_forall _).1 h g.1 g.2)
    rw [this]
    rfl
  set Φ : ↥X' →* ModGL Tag.F4 L := f.comp ψX with hΦ
  have hRΦ : rationalComponent S.ρ S.Γ (rootCharHom a) i = Φ.range := hRf.trans hΦrange.symm
  have hkerΦ : Φ.ker = ⊥ := by
    rcases hs.eq_bot_or_eq_top_of_normal Φ.ker with h | h
    · exact h
    · exfalso
      apply hR1
      rw [hRΦ, Subgroup.eq_bot_iff_forall]
      rintro _ ⟨x, rfl⟩
      exact MonoidHom.mem_ker.mp (h ▸ Subgroup.mem_top x)
  let eR : ↥X' ≃* ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) :=
    (MonoidHom.ofInjective ((MonoidHom.ker_eq_bot_iff Φ).1 hkerΦ)).trans
      (MulEquiv.subgroupCongr hRΦ.symm)
  exact ⟨K', hfin, hcard, ⟨eR⟩⟩

theorem false_of_G2_of_sp42 {R F : Type} [Group R] [Field F] [Finite F] (hK2 : Nat.card F = 2)
    (e : ↥(commutator ↥(StatedSp 2 F)) ≃* R) {mm : ℕ}
    (hRl : CFSG.LocalAnalysis.GLTheoremA.Y10F.HasLabel R (fun l : GLALabel => l = ⟨.G2, 0, mm⟩)) :
    False := by
  let f₀ : ↥(StatedSp 2 F) ≃* ↥CFSG.ComponentClassification.PresentationLocal.sympFour :=
    (CFSG.Monster.Existence.Compat.statedProjEquivOfBot (StatedSp 2 F)
      (CFSG.Monster.Existence.Compat.statedScalars_eq_bot hK2)).symm.trans
      (CFSG.RankThree.PartOne.KCSpComm.statedProjEquivSympFour hK2)
  have hmap : (commutator ↥(StatedSp 2 F)).map f₀.toMonoidHom =
      commutator ↥CFSG.ComponentClassification.PresentationLocal.sympFour := by
    rw [commutator_def, commutator_def, Subgroup.map_commutator, ← MonoidHom.range_eq_map,
      f₀.toMonoidHom.range_eq_top_of_surjective f₀.surjective]
  let eC : ↥(commutator ↥(StatedSp 2 F)) ≃*
      ↥(commutator ↥CFSG.ComponentClassification.PresentationLocal.sympFour) :=
    (f₀.subgroupMap _).trans (MulEquiv.subgroupCongr hmap)
  haveI : IsSimpleGroup
      ↥(commutator ↥CFSG.ComponentClassification.PresentationLocal.sympFour) :=
    CFSG.ComponentClassification.PresentationLocal.isSimpleGroup_commutator_sympFour
  haveI : Group.IsPerfect
      ↥(commutator ↥CFSG.ComponentClassification.PresentationLocal.sympFour) :=
    CFSG.ComponentClassification.PresentationLocal.isPerfect_commutator_sympFour
  have hcenC : Subgroup.center
      ↥(commutator ↥CFSG.ComponentClassification.PresentationLocal.sympFour) = ⊥ := by
    rcases (inferInstance : (Subgroup.center
        ↥(commutator ↥CFSG.ComponentClassification.PresentationLocal.sympFour)).Normal).eq_bot_or_eq_top
      with h | h
    · exact h
    · exact absurd (Subgroup.center_eq_top_iff.1 h) (Group.IsPerfect.not_isMulCommutative _)
  obtain ⟨eXZ⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_of_mulEquiv
    (e.symm.trans eC)
  let eA := eXZ.trans ((CFSG.LocalAnalysis.GLTheoremA.CanonInn.quotCenterEquivOfBot hcenC).trans
    CFSG.ComponentClassification.PresentationLocal.commutatorEquivAlternating)
  exact false_of_canonLabel_G2
    (CFSG.LocalAnalysis.GLTheoremA.Y10GSympLabel.canonLabel_eq_of_quot_alternating
      CFSG.StandardType.ggLabelRigidInput_holds hRl eA) (by simp)

theorem false_of_G2_f4_class_nonA {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup Tag.F4 L p₀) (hch : ringChar L = 2) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    {a : Fin Tag.F4.rank → Lˣ} (hT : rootDiagUnit Tag.F4 a ∈ S.D.torus) (hap : ∀ i, a i ^ p = 1)
    (h1 : rootDiagUnit Tag.F4 a ≠ 1) (i : KernelComponent (rootCharHom a))
    (hnonA : ¬ (1 ≤ compRank (componentRoots (rootCharHom a) i) ∧
      (componentRoots (rootCharHom a) i).ncard = compRank (componentRoots (rootCharHom a) i) *
        (compRank (componentRoots (rootCharHom a) i) + 1)))
    (hinner : twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin Tag.F4.rank → ℤ) → _)^[componentOrbitLength S.ρ
        (componentRoots (rootCharHom a) i)]))
    (hqs : CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom a) i)) {mm : ℕ}
    (hRl : CFSG.LocalAnalysis.GLTheoremA.Y10F.HasLabel ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)
      (fun l : GLALabel => l = ⟨.G2, 0, mm⟩)) : False := by
  classical
  have hp2' : p % 2 = 1 := (hp.eq_two_or_odd).resolve_left hp2
  have hℓp : ringChar L ≠ p := ringChar_ne_of_pow_eq_one hp hap h1
  have hpL : ((p : ℕ) : L) ≠ 0 := natCast_ne_zero_of_ringChar_ne hp hℓp
  have hTp := rootDiagUnit_pow_eq_one_of_forall hap
  rcases f4_nonA_casesP2 hp hp2' S hpL hTp h1 i hnonA with ⟨v, hroots, -, -⟩ |
      ⟨v, J, hJ, hroots, -, -⟩
  · by_cases hQ : 3 ≤ S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i)
    · obtain ⟨K', hfin, hne, g, hg, hker⟩ := exists_spCover_of_spRange S hT i hinner (m := 2) le_rfl
        (fun K' hfin hcardK' => by
          haveI := hfin
          obtain ⟨k, hk⟩ := card_subfield_eq_two_pow hch K'
          have h3 : 3 ≤ Nat.card ↥K' := hcardK' ▸ hQ
          have h4 : 4 ≤ Nat.card ↥K' := by
            rw [hk] at h3 ⊢
            rcases Nat.lt_or_ge k 2 with hk2 | hk2
            · interval_cases k <;> omega
            · calc 4 = 2 ^ 2 := by norm_num
                _ ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) hk2
          haveI : CharP ↥K' 2 := ringChar.of_eq (by rw [ringChar_subfield' K', hch])
          refine ⟨fun h => by omega, ?_⟩
          obtain ⟨Ψ, hΨker, hΨrange⟩ := spRange_f4_B2 h4
          rw [CFSG.RankThree.Chevalley.subsystemGroup_eq_iSup_rootSubgroup (τ := Tag.F4)
            (J := f4LeviB2) ↥K'] at hΨrange
          obtain ⟨Ψ', h', hr'⟩ := spRange_rootSpan_smul v (fun α hα => hα.1) hΨker hΨrange
          refine ⟨Ψ', h', ?_⟩
          rw [hr']
          show _ = rootSpan Tag.F4 ↥K' (componentRoots (rootCharHom a) i)
          rw [hroots])
      haveI := hfin
      obtain ⟨k, hk⟩ := card_subfield_eq_two_pow hch K'
      exact false_of_G2_of_spCover le_rfl hne hk g hg hker hRl
    · obtain ⟨K', hfin, hK2, ⟨eR⟩⟩ :=
        exists_sp42_equiv_rationalComponent S hT i v hroots hinner (not_le.1 hQ) hqs
      haveI := hfin
      exact false_of_G2_of_sp42 hK2 eR hRl
  · obtain ⟨K', hfin, hne, g, hg, hker⟩ := exists_spCover_of_spRange S hT i hinner (m := 3)
      (by norm_num) (fun K' hfin hcardK' => by
        haveI := hfin
        obtain ⟨k, hk⟩ := card_subfield_eq_two_pow hch K'
        have hk0 : 0 < k := by
          rcases Nat.eq_zero_or_pos k with h0 | h0
          · have : 1 < Nat.card ↥K' := Finite.one_lt_card
            rw [hk, h0] at this
            norm_num at this
          · exact h0
        refine ⟨fun h => by omega, ?_⟩
        obtain ⟨Ψ, hΨker, hΨrange⟩ := spRange_f4_levi hJ hk0 hk
        rw [CFSG.RankThree.Chevalley.subsystemGroup_eq_iSup_rootSubgroup (τ := Tag.F4)
          (J := J) ↥K'] at hΨrange
        obtain ⟨Ψ', h', hr'⟩ := spRange_rootSpan_smul v (fun α hα => hα.1) hΨker hΨrange
        refine ⟨Ψ', h', ?_⟩
        rw [hr']
        show _ = rootSpan Tag.F4 ↥K' (componentRoots (rootCharHom a) i)
        rw [hroots])
    haveI := hfin
    obtain ⟨k, hk⟩ := card_subfield_eq_two_pow hch K'
    exact false_of_G2_of_spCover (by norm_num) hne hk g hg hker hRl

theorem false_of_G2_adjointF4 {K : Type} [Field K] [Finite K] (hK2 : ringChar K = 2)
    {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    {β : MulAut ↥(adjointGroup .F4 K)} (hβmem : β ∈ innAutDerived ↥(adjointGroup .F4 K))
    (hβp : β ^ p = 1) (hβ1 : β ≠ 1) {J : Subgroup ↥(adjointGroup .F4 K)}
    (hJ : CFSG.Open.IsComponentOf J (fixSubgroup β)) {mm : ℕ}
    (hJl : CFSG.LocalAnalysis.GLTheoremA.Y10F.HasLabel ↥J (fun l : GLALabel => l = ⟨.G2, 0, mm⟩)) :
    False := by
  classical
  obtain ⟨h, hh, hβh, hp1, hh1⟩ := exists_inndiag_of_mem_innAutDerived_F4 β hβmem hβp hβ1
  haveI : Fintype K := Fintype.ofFinite K
  obtain ⟨f, hℓ, hcardK⟩ := FiniteField.card K (ringChar K)
  have hK : Nat.card K = ringChar K ^ (f : ℕ) := by rw [Nat.card_eq_fintype_card]; exact hcardK
  have hpℓ : p ≠ ringChar K := by rw [hK2]; exact hp2
  have hpK : ¬ p ∣ Nat.card K := fun h' =>
    hpℓ ((Nat.prime_dvd_prime_iff_eq hp hℓ).1 (hp.dvd_of_dvd_pow (hK ▸ h')))
  obtain ⟨p₀, hp₀, hp₀ℓ, hq₀⟩ := exists_setup_prime hℓ f.pos hp hp2 hpℓ
  have hp₀K : ¬ p₀ ∣ Nat.card K := fun hd =>
    hp₀ℓ ((Nat.prime_dvd_prime_iff_eq hp₀ hℓ).1 (hp₀.dvd_of_dvd_pow (hK ▸ hd)))
  have hq₀' : 5 ≤ p₀ ∨ 4 ≤ Nat.card K := by rw [hK]; exact hq₀
  have hmon : CFSG.HardMathSupport.Timmesfeld.CrossChar.MonomialToralAt .F4 p :=
    monomialToralAt_exc monomialToralAt_E6_five monomialToralAt_E7_five (by simp) hp hp2
  have hperf : commutator ↥(adjointGroup .F4 K) = ⊤ := single_edge_perfect .F4 K (by simp)
  obtain ⟨S, a, ι, hSq, -, hT, hap, h1, hinj, hrange, hconj⟩ :=
    exists_langSetup_of_inner_untw_of_prime (τ := .F4) (Or.inr (Or.inl rfl)) hp hpK hp₀ hp₀K hq₀'
      hmon hperf β h (baseChange_mem_adjointGroup_of_mem_inndiag hh) hβh hp1 hh1
  have hℓL : ringChar (AlgebraicClosure K) = ringChar K := ringChar_algebraicClosure K
  have hpL : ((p : ℕ) : AlgebraicClosure K) ≠ 0 :=
    natCast_ne_zero_of_ringChar_ne hp (by rw [hℓL]; exact hpℓ.symm)
  have hsmall : Tag.F4 = .G2 → 5 ≤ p ∨ 4 ≤ S.D.q := fun h => absurd h (by decide)
  have hTame := langSetup_hTame_of_prime S hp hpL hsmall hT hap h1
  obtain ⟨i, hqs, hJR⟩ := components_of_langSetup S hp ι hinj hrange β hconj hT hap h1 hTame hJ
  let eJ : ↥J ≃* ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) :=
    (J.equivMapOfInjective ι hinj).trans (MulEquiv.subgroupCongr hJR)
  have hRl := (CFSG.LocalAnalysis.GLTheoremA.Y10F.hasLabel_congr eJ _).1 hJl
  have hch : ringChar (AlgebraicClosure K) = 2 := by rw [hℓL, hK2]
  have hTp := rootDiagUnit_pow_eq_one_of_forall hap
  by_cases hA : 1 ≤ compRank (componentRoots (rootCharHom a) i) ∧
      (componentRoots (rootCharHom a) i).ncard = compRank (componentRoots (rootCharHom a) i) *
        (compRank (componentRoots (rootCharHom a) i) + 1)
  · obtain ⟨ν, f', -, -, -, hmodel⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.RationalModel.rationalComponent_typeA_model S hp hT hap h1 i hA hqs
    rw [hch] at hmodel
    have hG : CFSG.Blueprint.LieModel (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) .G2 0 2 mm :=
      CFSG.LocalAnalysis.GLTheoremA.CanonSubcomp.markedModel_of_hasLabel hRl
    rcases hmodel with hM | hM
    · exact CFSG.EvenSporadicStandard.Induction.false_of_lieModel_G2_of_ne hG (t := .PSL)
        (by decide) (Or.inl ⟨by decide, hM⟩)
    · exact CFSG.EvenSporadicStandard.Induction.false_of_lieModel_G2_of_ne hG (t := .PSU)
        (by decide) (Or.inl ⟨by decide, hM⟩)
  · by_cases hinner : twistInner (componentRoots (rootCharHom a) i)
        ((S.ρ : (Fin Tag.F4.rank → ℤ) → _)^[componentOrbitLength S.ρ
          (componentRoots (rootCharHom a) i)])
    · exact false_of_G2_f4_class_nonA S hch hp hp2 hT hap h1 i hA hinner hqs hRl
    · have hp2' : p % 2 = 1 := (hp.eq_two_or_odd).resolve_left hp2
      rcases f4_nonA_casesP hp hp2' S hpL hTp h1 i hA with ⟨hr, hn⟩ | ⟨v, J', -, -, hr, hn⟩
      · exact hinner (twistInner_of_shape S hT i 2 8 hr hn (by omega) (by omega) (by omega)
          (by omega))
      · exact hinner (twistInner_of_shape S hT i 3 18 hr hn (by omega) (by omega) (by omega)
          (by omega))

theorem false_of_G2_F4 {S : Type} [Group S] [Finite S] {labL : GLALabel} {β : MulAut S}
    {p m : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hcen : Subgroup.center S = ⊥)
    (hin : CFSG.LocalAnalysis.GLTheoremA.Y10GField.InnDiagKind S labL β) (hβp : β ^ p = 1)
    (hβ1 : β ≠ 1) (ht : labL.tag = .F4) {J : Subgroup S}
    (hJ : CFSG.Open.IsComponentOf J (fixSubgroup β))
    (hJl : CFSG.LocalAnalysis.GLTheoremA.Y10F.HasLabel ↥J (fun l : GLALabel => l = ⟨.G2, 0, m⟩)) :
    False := by
  classical
  have hS : CFSG.LocalAnalysis.GLTheoremA.Y10F.HasLabel S (· = labL) :=
    CFSG.StandardType.Canonical.largeEvenMarking_mono (fun _ _ _ _ _ _ h => h.1) hin
  have hβmem : β ∈ innAutDerived S := mem_innAutDerived_of_innDiagKind_exc hcen (Or.inl ht) hin
  have hM := CFSG.LocalAnalysis.GLTheoremA.CanonSubcomp.markedModel_of_hasLabel hS
  obtain ⟨t, r, n⟩ := labL
  simp only at ht
  subst ht
  have hLM : CFSG.Blueprint.LieModel (S ⧸ Subgroup.center S) .F4 0 2 n := hM
  have hce := CFSG.GH74.chevalleyExceptionalModel_of_lieModel (by decide) hLM
  obtain ⟨-, K, _, _, hK, ⟨e₀⟩⟩ := hce
  have hZ : Subgroup.center ↥(adjointGroup .F4 K) = ⊥ := center_adjointGroup_eq_bot
  let ψ : S ≃* ↥(adjointGroup .F4 K) :=
    (CFSG.LocalAnalysis.GLTheoremA.CanonInn.quotCenterEquivOfBot hcen).symm.trans
      (e₀.trans ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot))
  have hK2 : ringChar K = 2 := by
    haveI := CFSG.RankThree.PartOne.charP_two_of_card_eq_pow hK
    exact ringChar.eq K 2
  have hβ'mem : MulAut.congr ψ β ∈ innAutDerived _ := (mem_innAutDerived_congr ψ).2 hβmem
  have hβ'p : (MulAut.congr ψ β) ^ p = 1 := by rw [← map_pow, hβp, map_one]
  have hβ'1 : MulAut.congr ψ β ≠ 1 := fun h =>
    hβ1 ((MulAut.congr ψ).injective (by rw [h, map_one]))
  exact false_of_G2_adjointF4 hK2 hp hp2 hβ'mem hβ'p hβ'1 (isComponentOf_transport ψ β hJ)
    (CFSG.LocalAnalysis.GLTheoremA.Y10F.hasLabel_transport ψ hJl)

end F4Typed

