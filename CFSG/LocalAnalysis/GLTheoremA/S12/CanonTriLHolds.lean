theorem ordG2_le_ordG2 {q q' : ℕ} (hq : 1 ≤ q) (hqq : q ≤ q') : ordG2 q ≤ ordG2 q' := by
  unfold ordG2
  have h6 : q ^ 6 ≤ q' ^ 6 := Nat.pow_le_pow_left hqq 6
  have h2 : q ^ 2 ≤ q' ^ 2 := Nat.pow_le_pow_left hqq 2
  exact Nat.mul_le_mul (Nat.mul_le_mul h6 (Nat.sub_le_sub_right h6 1)) (Nat.sub_le_sub_right h2 1)

theorem ordSuzuki_lt_ordG2 {q : ℕ} (hq : 2 ≤ q) : ordSuzuki q < ordG2 q := by
  unfold ordSuzuki ordG2
  have h1 : 1 ≤ q := by omega
  have hq2 : q ^ 2 < q ^ 6 := Nat.pow_lt_pow_right hq (by norm_num)
  have hq4 : 4 ≤ q ^ 2 := by nlinarith
  have hq6' : q ^ 2 + 2 ≤ q ^ 6 := by
    have e : q ^ 6 = q ^ 2 * q ^ 4 := by ring
    have h44 : 4 ≤ q ^ 4 := by nlinarith
    rw [e]
    nlinarith
  have hq6 : q ^ 2 + 1 ≤ q ^ 6 - 1 := by omega
  have hq1 : q - 1 ≤ q ^ 2 - 1 := Nat.sub_le_sub_right (by nlinarith) 1
  have hpos : 0 < q - 1 := by omega
  have hpos2 : 0 < q ^ 2 + 1 := by positivity
  calc q ^ 2 * (q ^ 2 + 1) * (q - 1) < q ^ 6 * (q ^ 2 + 1) * (q - 1) :=
        Nat.mul_lt_mul_of_pos_right (Nat.mul_lt_mul_of_pos_right hq2 hpos2) hpos
    _ ≤ q ^ 6 * (q ^ 6 - 1) * (q ^ 2 - 1) :=
        Nat.mul_le_mul (Nat.mul_le_mul_left _ hq6) hq1

theorem ordTwistedF4_lt_ordG2_sq {q : ℕ} (hq : 2 ≤ q) : ordTwistedF4 q < ordG2 (q ^ 2) := by
  unfold ordTwistedF4 ordG2
  have h1 : 1 ≤ q := by omega
  have e1 : (q ^ 2) ^ 6 = q ^ 12 := by ring
  have e2 : (q ^ 2) ^ 2 = q ^ 4 := by ring
  rw [e1, e2]
  have hq4 : 1 ≤ q ^ 4 := Nat.one_le_pow _ _ (by omega)
  have hq12 : 1 ≤ q ^ 12 := Nat.one_le_pow _ _ (by omega)
  have hq6 : 2 ≤ q ^ 6 := le_trans hq (Nat.le_self_pow (by norm_num) q)
  zify [hq4, hq12, h1]
  have hq' : (2 : ℤ) ≤ q := by exact_mod_cast hq
  have hA : (0 : ℤ) < (q : ℤ) ^ 12 * ((q : ℤ) ^ 4 - 1) := by
    have : (1 : ℤ) < (q : ℤ) ^ 4 := by nlinarith [pow_le_pow_left₀ (by norm_num : (0:ℤ) ≤ 2) hq' 4]
    positivity
  have key : ((q : ℤ) ^ 6 + 1) * ((q : ℤ) ^ 3 + 1) * ((q : ℤ) - 1) < (q : ℤ) ^ 12 - 1 := by
    nlinarith [pow_le_pow_left₀ (by norm_num : (0:ℤ) ≤ 2) hq' 3,
      pow_le_pow_left₀ (by norm_num : (0:ℤ) ≤ 2) hq' 4, pow_le_pow_left₀ (by norm_num : (0:ℤ) ≤ 2) hq' 6]
  nlinarith [key, hA]

theorem ordTrialityD4_two_lt_ordG2 {m : ℕ} (hm : 2 ≤ m) : ordTrialityD4 2 < ordG2 (2 ^ m) := by
  have h4 : ordG2 4 ≤ ordG2 (2 ^ m) := ordG2_le_ordG2 (by norm_num)
    (by calc 4 = 2 ^ 2 := by norm_num
          _ ≤ 2 ^ m := Nat.pow_le_pow_right (by norm_num) hm)
  have : ordTrialityD4 2 < ordG2 4 := by decide
  omega

theorem card_fixSubgroup_lt {S : Type} [Group S] [Finite S] {β : MulAut S} (hβ1 : β ≠ 1) :
    Nat.card (fixSubgroup β) < Nat.card S := by
  have hfix : fixSubgroup β ≠ ⊤ := by
    intro h
    apply hβ1
    ext s
    have hs : s ∈ fixSubgroup β := by
      rw [h]
      exact Subgroup.mem_top s
    exact mem_fixSubgroup.1 hs
  calc Nat.card (fixSubgroup β) < Nat.card (⊤ : Subgroup S) :=
        Subgroup.card_lt_of_lt (lt_top_iff_ne_top.2 hfix)
    _ = Nat.card S := Subgroup.card_top

theorem card_quot_le {S : Type} [Group S] [Finite S] (K : Subgroup S) :
    Nat.card (↥K ⧸ Subgroup.center ↥K) ≤ Nat.card S :=
  (Nat.le_of_dvd Nat.card_pos (Subgroup.index_dvd_card _)).trans (Subgroup.card_le_card_group K)

theorem false_of_G2_small {S : Type} [Group S] [Finite S] {labL : GLALabel} {β : MulAut S} {m : ℕ}
    (hcen : Subgroup.center S = ⊥) (hin : InnDiagKind S labL β) (hβ1 : β ≠ 1)
    (hdvd : labL.n ∣ m)
    (ht : labL.tag = .B2der ∨ labL.tag = .G2der ∨ labL.tag = .twF4der ∨ labL.tag = .G2 ∨
      labL.tag = .twB2 ∨ (labL.tag = .triD4 ∧ labL.n = 1))
    {K : Subgroup S} (hK : CFSG.Open.IsComponentOf K (fixSubgroup β))
    (hKl : HasLabel ↥K (fun l : GLALabel => l = ⟨.G2, 0, m⟩)) : False := by
  have hS : HasLabel S (· = labL) :=
    CFSG.StandardType.Canonical.largeEvenMarking_mono (fun _ _ _ _ _ _ h => h.1) hin
  have hlam := CFSG.LocalAnalysis.GLTheoremA.CanonSubcomp.lambda2_of_hasLabel hS
  have h12 := two_pow_twelve_dvd_of_G2 hKl
  have hm2 := two_le_of_G2 hKl
  have hKq := card_quot_of_G2 hKl
  have hKS := card_quot_le K
  obtain ⟨t, r, n⟩ := labL
  simp only at ht hdvd
  rcases ht with rfl | rfl | rfl | rfl | rfl | ⟨rfl, rfl⟩
  ·
    obtain ⟨-, rfl, rfl⟩ := hlam
    have hM := CFSG.LocalAnalysis.GLTheoremA.CanonSubcomp.markedModel_of_hasLabel hS
    have h360 := CFSG.LocalAnalysis.GLTheoremA.card_of_B2der hM
    rw [Nat.card_congr (CFSG.LocalAnalysis.GLTheoremA.CanonInn.quotCenterEquivOfBot hcen).toEquiv]
      at h360
    rw [h360] at h12
    norm_num at h12
  ·
    obtain ⟨-, rfl, rfl⟩ := hlam
    have hM := CFSG.LocalAnalysis.GLTheoremA.CanonSubcomp.markedModel_of_hasLabel hS
    have h6048 := CFSG.LocalAnalysis.GLTheoremA.card_of_G2der hM
    rw [Nat.card_congr (CFSG.LocalAnalysis.GLTheoremA.CanonInn.quotCenterEquivOfBot hcen).toEquiv]
      at h6048
    rw [h6048] at h12
    norm_num at h12
  ·
    have hc := card_of_label_char_two hcen hS rfl
    rw [hc] at h12
    simp [CFSG.StandardType.markTag, CFSG.SeitzReduction.F4Pilot.evenLieOrder, ordTits] at h12
  ·
    have hc := card_of_label_char_two hcen hS rfl
    simp only [CFSG.StandardType.markTag, CFSG.StandardType.markDeg,
      CFSG.SeitzReduction.F4Pilot.evenLieOrder] at hc
    have hn1 : 1 ≤ n := hlam.1
    have hnm : n ≤ m := Nat.le_of_dvd (by omega) hdvd
    have hle := ordG2_le_ordG2 (Nat.one_le_two_pow) (Nat.pow_le_pow_right (by norm_num) hnm)
    have hlt := card_fixSubgroup_lt hβ1
    have hKfix : Nat.card (↥K ⧸ Subgroup.center ↥K) ≤ Nat.card (fixSubgroup β) :=
      (Nat.le_of_dvd Nat.card_pos (Subgroup.index_dvd_card _)).trans
        (Subgroup.card_le_of_le hK.1)
    omega
  ·
    have hc := card_of_label_char_two hcen hS rfl
    simp only [CFSG.StandardType.markTag, CFSG.StandardType.markDeg,
      CFSG.SeitzReduction.F4Pilot.evenLieOrder] at hc
    have hn3 : 3 ≤ n := by
      simp only [CFSG.Assembly.LargeEvenInLambda2] at hlam
      exact hlam.2.2.2
    have hnm : n ≤ m := Nat.le_of_dvd (by omega) hdvd
    have hle := ordG2_le_ordG2 (Nat.one_le_two_pow) (Nat.pow_le_pow_right (by norm_num) hnm)
    have hlt := ordSuzuki_lt_ordG2 (q := 2 ^ n) (by
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) (by omega))
    omega
  ·
    have hc := card_of_label_char_two hcen hS rfl
    simp only [CFSG.StandardType.markTag, CFSG.StandardType.markDeg,
      CFSG.SeitzReduction.F4Pilot.evenLieOrder, pow_one] at hc
    have hlt := ordTrialityD4_two_lt_ordG2 hm2
    omega
theorem two_pow_odd_modEq {n : ℕ} (hn : Odd n) : ((2 : ℤ) ^ n) ≡ 2 [ZMOD 3] := by
  obtain ⟨k, rfl⟩ := hn
  have h4 : (4 : ℤ) ≡ 1 [ZMOD 3] := by decide
  have h4k : (4 : ℤ) ^ k ≡ 1 [ZMOD 3] := by simpa using h4.pow k
  have e : (2 : ℤ) ^ (2 * k + 1) = 2 * 4 ^ k := by
    rw [pow_succ, pow_mul]; norm_num; ring
  rw [e]
  simpa using h4k.mul_left 2

theorem not_ordG2_dvd_ordTwistedF4 {n : ℕ} (hn : Odd n) :
    ¬ ordG2 (2 ^ n) ∣ ordTwistedF4 (2 ^ n) := by
  intro hdvd
  set q : ℕ := 2 ^ n with hq
  have hq2 : 2 ≤ q := by
    obtain ⟨k, rfl⟩ := hn
    rw [hq, pow_succ]
    have := Nat.one_le_two_pow (n := 2 * k)
    omega
  have hq1 : 1 ≤ q := by omega
  have hdZ : (ordG2 q : ℤ) ∣ (ordTwistedF4 q : ℤ) := Int.natCast_dvd_natCast.mpr hdvd
  set x : ℤ := (q : ℤ) with hx
  have hx2 : (2 : ℤ) ≤ x := by rw [hx]; exact_mod_cast hq2
  have hG : (ordG2 q : ℤ) = x ^ 6 * (x ^ 6 - 1) * (x ^ 2 - 1) := by
    unfold ordG2
    have h6 : 1 ≤ q ^ 6 := Nat.one_le_pow _ _ (by omega)
    have h2 : 1 ≤ q ^ 2 := Nat.one_le_pow _ _ (by omega)
    push_cast [Nat.cast_sub h6, Nat.cast_sub h2]
    ring
  have hF : (ordTwistedF4 q : ℤ) = x ^ 12 * (x ^ 6 + 1) * (x ^ 4 - 1) * (x ^ 3 + 1) * (x - 1) := by
    unfold ordTwistedF4
    have h4 : 1 ≤ q ^ 4 := Nat.one_le_pow _ _ (by omega)
    push_cast [Nat.cast_sub h4, Nat.cast_sub hq1]
    ring
  set N : ℤ := x ^ 2 + x + 1 with hN
  have hNG : N ∣ (ordG2 q : ℤ) := by
    rw [hG]
    exact Dvd.intro ((x - 1) * (x ^ 3 + 1) * x ^ 6 * (x ^ 2 - 1)) (by rw [hN]; ring) |>.trans
      (dvd_refl _)
  have hNF : N ∣ (ordTwistedF4 q : ℤ) := hNG.trans hdZ
  have h3 : x ^ 3 ≡ 1 [ZMOD N] := by
    apply Int.ModEq.symm
    rw [Int.modEq_iff_dvd]
    exact ⟨x - 1, by rw [hN]; ring⟩
  have h12 : x ^ 12 ≡ 1 [ZMOD N] := by
    have := h3.pow 4
    rw [← pow_mul] at this
    simpa using this
  have h6 : x ^ 6 + 1 ≡ 2 [ZMOD N] := by
    have := (h3.pow 2).add_right 1
    rw [← pow_mul] at this
    simpa [one_add_one_eq_two] using this
  have h4 : x ^ 4 - 1 ≡ x - 1 [ZMOD N] := by
    have := (h3.mul_right x).sub_right 1
    rw [← pow_succ] at this
    simpa using this
  have h3' : x ^ 3 + 1 ≡ 2 [ZMOD N] := by
    simpa [one_add_one_eq_two] using h3.add_right 1
  have hmod : (ordTwistedF4 q : ℤ) ≡ 4 * (x - 1) ^ 2 [ZMOD N] := by
    rw [hF]
    have := (((h12.mul h6).mul h4).mul h3').mul (Int.ModEq.refl (x - 1))
    calc x ^ 12 * (x ^ 6 + 1) * (x ^ 4 - 1) * (x ^ 3 + 1) * (x - 1)
        ≡ 1 * 2 * (x - 1) * 2 * (x - 1) [ZMOD N] := this
      _ = 4 * (x - 1) ^ 2 := by ring
  have hN4 : N ∣ 4 * (x - 1) ^ 2 := by
    have := (Int.modEq_zero_iff_dvd.mpr hNF).symm.trans hmod
    exact (Int.modEq_zero_iff_dvd.mp this.symm)
  have hx3 : x ≡ 2 [ZMOD 3] := by rw [hx, hq]; push_cast; exact two_pow_odd_modEq hn
  obtain ⟨t, ht⟩ : ∃ t : ℤ, x - 1 = 3 * t + 1 := by
    have := (Int.ModEq.sub_right 1 hx3)
    rw [Int.ModEq, show (2 : ℤ) - 1 = 1 by norm_num] at this
    exact ⟨(x - 1) / 3, by omega⟩
  have hcop1 : IsCoprime N (x - 1) := by
    refine ⟨-t, 1 + t * (x + 2), ?_⟩
    rw [hN]
    linear_combination ht
  obtain ⟨s, hs⟩ : ∃ s : ℤ, x = 2 * s := by
    obtain ⟨k, hk⟩ := hn
    refine ⟨(2 : ℤ) ^ (2 * k), ?_⟩
    rw [hx, hq, hk]
    push_cast
    ring
  have hcop2 : IsCoprime N 2 := by
    refine ⟨1, -(2 * s ^ 2 + s), ?_⟩
    rw [hN, hs]
    ring
  have hcop : IsCoprime N (4 * (x - 1) ^ 2) := by
    have h4' : (4 : ℤ) = 2 ^ 2 := by norm_num
    rw [h4']
    exact (hcop2.pow_right).mul_right hcop1.pow_right
  have hunit : IsUnit N := hcop.isUnit_of_dvd' (dvd_refl N) hN4
  rw [Int.isUnit_iff] at hunit
  rw [hN] at hunit
  rcases hunit with h | h <;> nlinarith

theorem false_of_G2_twF4 {S : Type} [Group S] [Finite S] {labL : GLALabel} {β : MulAut S} {m : ℕ}
    (hcen : Subgroup.center S = ⊥) (hin : InnDiagKind S labL β) (hdvd : labL.n ∣ m)
    (ht : labL.tag = .twF4) {K : Subgroup S}
    (hKl : HasLabel ↥K (fun l : GLALabel => l = ⟨.G2, 0, m⟩)) : False := by
  have hS : HasLabel S (· = labL) :=
    CFSG.StandardType.Canonical.largeEvenMarking_mono (fun _ _ _ _ _ _ h => h.1) hin
  have hlam := CFSG.LocalAnalysis.GLTheoremA.CanonSubcomp.lambda2_of_hasLabel hS
  have hKq := card_quot_of_G2 hKl
  have hm2 := two_le_of_G2 hKl
  obtain ⟨t, r, n⟩ := labL
  simp only at ht hdvd
  subst ht
  have hc := card_of_label_char_two hcen hS rfl
  simp only [CFSG.StandardType.markTag, CFSG.StandardType.markDeg,
    CFSG.SeitzReduction.F4Pilot.evenLieOrder] at hc
  simp only [CFSG.Assembly.LargeEvenInLambda2] at hlam
  obtain ⟨-, -, hodd, hn3⟩ := hlam
  obtain ⟨j, rfl⟩ := hdvd
  rcases Nat.lt_or_ge j 2 with hj | hj
  ·
    have hj1 : j = 1 := by
      rcases Nat.lt_or_ge j 1 with h0 | h0
      · have : j = 0 := by omega
        subst this
        omega
      · omega
    subst hj1
    rw [Nat.mul_one] at hKq
    have h1 : Nat.card (↥K ⧸ Subgroup.center ↥K) ∣ Nat.card S :=
      (Subgroup.index_dvd_card _).trans (Subgroup.card_subgroup_dvd_card K)
    rw [hKq, hc] at h1
    exact not_ordG2_dvd_ordTwistedF4 hodd h1
  ·
    have hle : ordG2 ((2 ^ n) ^ 2) ≤ ordG2 (2 ^ (n * j)) := by
      refine ordG2_le_ordG2 (Nat.one_le_pow _ _ (by positivity)) ?_
      rw [← pow_mul]
      exact Nat.pow_le_pow_right (by norm_num) (Nat.mul_le_mul_left n hj)
    have hlt := ordTwistedF4_lt_ordG2_sq (q := 2 ^ n) (by
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) (by omega))
    have hKS := card_quot_le K
    omega

