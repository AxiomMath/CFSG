theorem false_of_G2_of_quot_heldSU {J : Type} [Group J] [Finite J] {m a k : ℕ} {E : Type}
    [Field E] [Finite E] (τ' : E ≃+* E) (hτ' : ∀ x, τ' (τ' x) = x) (ha : 2 ≤ a)
    (hτ'k : ∀ x, τ' x = x ^ (2 ^ k)) (hE : Nat.card E = (2 ^ k) ^ 2)
    (hJ : HasLabel J (fun l : GLALabel => l = ⟨.G2, 0, m⟩))
    (hφ : Nonempty (J ⧸ Subgroup.center J ≃* heldSU a E τ' hτ' ⧸ Subgroup.center (heldSU a E τ' hτ'))) :
    False := by
  obtain ⟨φ⟩ := hφ
  obtain ⟨hlab, hs, hhas⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.ggHasLabel_of_hasLabel hJ
  haveI := hs
  have hk : 1 ≤ k := by
    by_contra hk0
    have h2 : 2 ≤ Nat.card E := Finite.one_lt_card
    rw [hE, show k = 0 by omega] at h2
    norm_num at h2
  rcases Nat.lt_or_ge a 3 with ha3 | ha3
  · obtain rfl : a = 2 := by omega
    obtain ⟨k', _, _, hk', ⟨ψ⟩⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.Y10GInnUni.exists_quot_heldSU_two_equiv_psl τ' hτ' hτ'k hE
    have h := CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.linLabelDict_of_ggLabelRigidInput
      ggLabelRigidInput_holds J ⟨.G2, 0, m⟩ 2 k k' le_rfl hk' hJ ⟨φ.trans ψ⟩
    exact false_of_canonLabel_G2 h (by simp)
  · by_cases h31 : a = 3 ∧ k = 1
    · obtain ⟨rfl, rfl⟩ := h31
      haveI := CFSG.LocalAnalysis.GLTheoremA.Y10GInnUni.isSolvable_quot_heldSU_three_two τ' hτ'
        (fun x => by simpa using hτ'k x) (by simpa using hE)
      exact CFSG.LocalAnalysis.GLTheoremA.Y10GInnUni.not_isSolvable_quot_center
        (solvable_of_surjective (f := φ.symm.toMonoidHom) φ.symm.surjective)
    · have hak : (a, 2 ^ k) ≠ (3, 2) := by
        intro h
        obtain ⟨h1, h2⟩ := Prod.mk.inj h
        exact h31 ⟨h1, Nat.pow_right_injective le_rfl (h2.trans (pow_one 2).symm)⟩
      obtain ⟨ψ⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GInnUni.nonempty_quot_heldSU_equiv_statedProj
        CFSG.LocalAnalysis.GLTheoremA.Y10GInnUni.uniScalar_holds τ' hτ' hτ'k hE ha3 hak
      obtain ⟨b, rfl⟩ : ∃ b, a = b + 1 := ⟨a - 1, by omega⟩
      have hiso : CFSG.StandardType.GGLabelIso ⟨.G2, 0, m⟩ ⟨.twA, b, k⟩ :=
        ggLabelRigidInput_holds ⟨.G2, 0, m⟩ ⟨.twA, b, k⟩ (J ⧸ Subgroup.center J) hlab
          (CFSG.LocalAnalysis.GLTheoremA.Y10GInnUni.largeEvenInLambda2_twA hk (by omega)
            fun hb => by omega) hhas
          (CFSG.LocalAnalysis.GLTheoremA.Y10GInnUni.ggHasLabel_twA hE (φ.trans ψ))
      have h := CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.canonLabel_eq_of_ggLabelIso hiso
      exact false_of_canonLabel_G2 h (by simp [canonLabel])

theorem false_of_G2_of_quot_statedSL {J : Type} [Group J] [Finite J] {m a k : ℕ} {E : Type}
