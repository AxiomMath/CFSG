    ← Nat.card_congr (CFSG.LocalAnalysis.GLTheoremA.CanonInn.quotCenterEquivOfBot hcen).toEquiv]

theorem card_quot_of_G2 {X : Type} [Group X] {m : ℕ}
    (hKl : HasLabel X (fun l : GLALabel => l = ⟨.G2, 0, m⟩)) :
    Nat.card (X ⧸ Subgroup.center X) = ordG2 (2 ^ m) := by
  have hG : CFSG.Blueprint.LieModel (X ⧸ Subgroup.center X) .G2 0 2 m :=
    CFSG.LocalAnalysis.GLTheoremA.CanonSubcomp.markedModel_of_hasLabel hKl
  exact CFSG.SeitzReduction.F4Pilot.card_eq_evenLieOrder hG

theorem two_le_of_G2 {X : Type} [Group X] {m : ℕ}
    (hKl : HasLabel X (fun l : GLALabel => l = ⟨.G2, 0, m⟩)) : 2 ≤ m := by
