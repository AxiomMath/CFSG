@[expose] def NotG2LieType (ℓ : ℕ) (X : Type) [Group X] : Prop :=
  ∃ (t : StatedLieTag) (r e : ℕ), t ≠ .G2 ∧
    CFSG.Blueprint.LieModel (X ⧸ Subgroup.center X) t r ℓ e

theorem NotG2LieType.of_mulEquiv {ℓ : ℕ} {X Y : Type} [Group X] [Group Y]
    (h : NotG2LieType ℓ X) (e : X ≃* Y) : NotG2LieType ℓ Y := by
  obtain ⟨t, r, f, ht, hm⟩ := h
  exact ⟨t, r, f, ht, CFSG.Blueprint.LieModel.of_mulEquiv
    (QuotientGroup.congr (Subgroup.center X) (Subgroup.center Y) e (Subgroup.map_center_eq e)) hm⟩

theorem NotG2LieType.of_surjective {ℓ : ℕ} {X Y : Type} [Group X] [Group Y]
    (h : NotG2LieType ℓ X) (hX : commutator X = ⊤) (f : X →* Y) (hf : Function.Surjective f)
    (hk : f.ker ≤ Subgroup.center X) : NotG2LieType ℓ Y := by
  obtain ⟨t, r, e, ht, hm⟩ := h
  obtain ⟨g⟩ := nonempty_centralQuotient_mulEquiv hX f hf hk
  exact ⟨t, r, e, ht, CFSG.Blueprint.LieModel.of_mulEquiv g hm⟩

theorem NotG2LieType.map_conj {G : Type} [Group G] {ℓ : ℕ} {R : Subgroup G} (φ : G ≃* G)
    (h : NotG2LieType ℓ ↥R) : NotG2LieType ℓ ↥(R.map φ.toMonoidHom) :=
  h.of_mulEquiv (R.equivMapOfInjective φ.toMonoidHom φ.injective)

