theorem canonLabel_G2 (m : ℕ) : canonLabel ⟨.G2, 0, m⟩ = ⟨.G2, 0, m⟩ := rfl

theorem false_of_canonLabel_G2 {m : ℕ} {lab : GLALabel} (h : canonLabel ⟨.G2, 0, m⟩ = lab)
    (ht : lab.tag ≠ .G2) : False := by
  rw [canonLabel_G2] at h
  exact ht (by rw [← h])

theorem ggFix_eq_fixSubgroup {H : Type*} [Group H] (a : MulAut H) :
    CFSG.StandardType.ggFix a = fixSubgroup a := by
  ext x
  rfl

theorem exists_isComponentOf_lift {X Q : Type} [Group X] [Group Q] (π : X →* Q)
    (hπ : Function.Surjective π) (hker : π.ker ≤ Subgroup.center X) (α : MulAut X)
    (β : MulAut Q) (hαβ : ∀ x, π (α x) = β (π x)) {A : Subgroup Q}
    (hA : IsComponentOf A (fixSubgroup β)) :
    ∃ J : Subgroup X, IsComponentOf J (fixSubgroup α) ∧ J.map π = A := by
  have hA' : CFSG.Assembly.IsComponentOf A (CFSG.StandardType.ggFix β) := by
    rw [ggFix_eq_fixSubgroup]
    exact CFSG.Assembly.isComponentOf_iff_open.2 hA
  obtain ⟨J, hJ, hJA⟩ := CFSG.StandardType.SCFourCover.exists_isComponentOf_map_eq hπ hker
    (a := α) (φ := β) (fun x => (hαβ x).symm) hA'
  rw [ggFix_eq_fixSubgroup] at hJ
  exact ⟨J, CFSG.Assembly.isComponentOf_iff_open.1 hJ, hJA⟩

theorem isComponentOf_transport {S R : Type} [Group S] [Group R] (e : S ≃* R) (β : MulAut S)
    {J : Subgroup S} (hJ : IsComponentOf J (fixSubgroup β)) :
    IsComponentOf (J.map e.toMonoidHom) (fixSubgroup (MulAut.congr e β)) := by
  rw [← fixSubgroup_map_congr e β]
  refine CFSG.LocalAnalysis.GLTheoremA.I142N.isComponentOf_map e.toMonoidHom (fun g hg => ?_) hJ
  have : g = 1 := e.injective (by simpa using hg)
  rw [this]
  exact one_mem _

theorem nonempty_centerQuot_of_map_eq {X Q : Type} [Group X] [Group Q] (π : X →* Q)
    (hker : π.ker ≤ Subgroup.center X) {M : Subgroup X} (hMperf : commutator ↥M = ⊤)
    {J : Subgroup Q} (hMJ : M.map π = J) :
    Nonempty (↥J ⧸ Subgroup.center ↥J ≃* ↥M ⧸ Subgroup.center ↥M) := by
  have hmemJ : ∀ x : ↥M, π (x : X) ∈ J := fun x => by
    rw [← hMJ]
    exact Subgroup.mem_map_of_mem _ x.2
  let fJ : ↥M →* ↥J := MonoidHom.codRestrict (π.comp M.subtype) J hmemJ
  have hfJ : Function.Surjective fJ := by
    rintro ⟨y, hy⟩
    rw [← hMJ] at hy
    obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.mp hy
    exact ⟨⟨z, hz⟩, rfl⟩
  have hkerJ : fJ.ker ≤ Subgroup.center ↥M := by
    intro x hx
    rw [MonoidHom.mem_ker] at hx
    have hπ1 : π (x : X) = 1 := congrArg Subtype.val hx
    have hxc : (x : X) ∈ Subgroup.center X := hker (MonoidHom.mem_ker.mpr hπ1)
    rw [Subgroup.mem_center_iff]
    intro y
    apply Subtype.ext
    simp only [Subgroup.coe_mul]
    exact Subgroup.mem_center_iff.mp hxc _
  exact CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.center_quot_equiv_of_surjective hMperf fJ hfJ hkerJ

