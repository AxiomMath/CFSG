section Inputs


theorem subcompField_of_inputs (hRig : GGLabelRigidInput) (hRest : GGInndiagCommRestInput)
    (hIdx : KD264Lie.LieCompIdx fun _ => True) : SubcompField := by
  intro Γ _ _ L K y labL labK p hp hp2 hyp hy hyL hM hK hlabK htwD
  have hLl : HasLabel ↥L (· = labL) :=
    CFSG.StandardType.Canonical.largeEvenMarking_mono (fun _ _ _ _ _ _ h => h.1) hM
  have hlamL := lambda2_of_hasLabel hLl
  rcases Nat.lt_or_ge labL.n 2 with hn1 | hn2
  · rw [show labL.n = 1 by have := hlamL.1; omega]
    exact one_dvd _
  have hq := hasLabel_isQuasisimple hLl
  obtain ⟨hcen, hin, hpow, hKb, hlb⟩ :=
    CanonInn.marked_bridge hy hyp hM hK ((labelOf_iff_hasLabel K labK).1 hlabK)
  have hβ1 := centerQuotAut_conjAut_ne_one hy hyL hq.1
  have hβD := mem_innAutDerived_of_innDiagKind hRest hcen hn2 hin
  have hc := markChar_eq_two_of_two_le hlamL hn2
  have hLM : CFSG.Blueprint.LieModel (↥L ⧸ Subgroup.center ↥L) (markTag labL) (markRank labL) 2
      (markDeg labL) := by
    have h := markedModel_of_hasLabel hLl
    unfold CFSG.StandardType.MarkedModel at h
    rwa [hc] at h
  have hKn : (canonLabel labK).n = labK.n := canonLabel_n_eq_self (lambda2_of_hasLabel hlb) htwD
  rcases exists_index_or_small_of_lieModel_two hLM with ⟨d, hd2, ⟨e⟩⟩ | h60 | h1
  ·
    obtain ⟨i, ⟨φ⟩, hrel⟩ := KD264Lie.compIdxAt_of_mulEquiv e.symm
      (hIdx d p hp hp2 (by rw [hd2]; exact hp2) trivial) _ hβD hpow hβ1 _ hKb
    have hfs := two_pow_canonLabel_n_of_lie hRig hLl d hd2 e
    rw [← hKn]
    exact (n_dvd_canonLabel_n hlamL).trans
      (dvd_canonLabel_n_of_compRelC hRig hlb hd2 hfs.symm φ hrel)
  ·
    exfalso
    have hfix : fixSubgroup (centerQuotAut ↥L (conjAut L y hy)) ≠ ⊤ := by
      intro h
      apply hβ1
      ext s
      have hs : s ∈ fixSubgroup (centerQuotAut ↥L (conjAut L y hy)) := by
        rw [h]
        exact Subgroup.mem_top s
      exact mem_fixSubgroup.1 hs
    set Kb := (K.subgroupOf L).map (QuotientGroup.mk' (Subgroup.center ↥L)) with hKbdef
    have hlt : Nat.card ↥Kb < 60 := by
      rw [← h60]
      calc Nat.card ↥Kb ≤ Nat.card ↥(fixSubgroup (centerQuotAut ↥L (conjAut L y hy))) :=
            Subgroup.card_le_of_le hKb.1
        _ < Nat.card ↥(⊤ : Subgroup (↥L ⧸ Subgroup.center ↥L)) :=
            Subgroup.card_lt_of_lt (lt_top_iff_ne_top.2 hfix)
        _ = Nat.card (↥L ⧸ Subgroup.center ↥L) := Subgroup.card_top
    haveI := CFSG.GroupTheory.groups_order_below_sixty_solvable hlt
    have hqK := hKb.2.2
    haveI := hqK.2
    haveI : Nontrivial ↥Kb := (QuotientGroup.mk'_surjective (Subgroup.center ↥Kb)).nontrivial
    exact (Group.IsSolvable.commutator_lt_top_of_nontrivial ↥Kb).ne hqK.1
  ·
    exfalso
    have h1' : (canonLabel labL).n = 1 := (canonLabel_n_eq_markDeg hlamL hc).trans h1
    have hdvd := n_dvd_canonLabel_n hlamL
    rw [h1'] at hdvd
    have := Nat.le_of_dvd one_pos hdvd
    omega

end Inputs

section Holds


theorem subcompField_holds : SubcompField :=
  subcompField_of_inputs CFSG.StandardType.ggLabelRigidInput_holds
    CFSG.StandardType.ggInndiagCommRestInput_holds KD264Lie.lieCompIdx_all

end Holds

