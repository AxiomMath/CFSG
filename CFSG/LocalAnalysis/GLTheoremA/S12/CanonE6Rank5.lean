theorem exists_of_ggTorusLift {Γ : Type} [Group Γ] [Finite Γ] {L : Subgroup Γ} {R : Type}
    [Group R] (hL : commutator ↥L = ⊤) (θ : ↥L ⧸ Subgroup.center ↥L ≃* R) {p r : ℕ}
    (hT : GGTorusLift p r R) :
    ∃ E U : Subgroup Γ, E ≤ L ∧ U ≤ L ∧ U ≠ ⊥ ∧ IsPGroup 2 U ∧
      E ≤ Subgroup.normalizer (U : Set Γ) ∧ IsElemAbelian p E ∧ Nat.card E = p ^ r ∧
        E ⊓ Subgroup.centralizer (L : Set Γ) = ⊥ := by
  obtain ⟨U, E, hU, hU2, hEU, hE, hEcard, hEker⟩ := hT L (ggQuotHom θ)
    (ggQuotHom_surjective θ) (by rw [ker_ggQuotHom]) hL
  rw [ker_ggQuotHom] at hEker
  refine ⟨E.map L.subtype, U.map L.subtype, Subgroup.map_subtype_le _, Subgroup.map_subtype_le _,
    fun h => hU ((Subgroup.map_eq_bot_iff_of_injective _ (f := L.subtype) L.subtype_injective).1 h),
    hU2.map _, (Subgroup.map_mono hEU).trans (Subgroup.le_normalizer_map L.subtype),
    IsElemAbelian.map hE L.subtype,
    by rw [Subgroup.card_map_of_injective L.subtype_injective, hEcard], ?_⟩
  rw [eq_bot_iff]
  rintro _ ⟨⟨e, he, rfl⟩, hc⟩
  have hec : e ∈ Subgroup.center ↥L := Subgroup.mem_center_iff.mpr fun l =>
    Subtype.ext (Subgroup.mem_centralizer_iff.mp hc l l.2)
  have h1 : e ∈ E ⊓ Subgroup.center ↥L := ⟨he, hec⟩
  rw [hEker, Subgroup.mem_bot] at h1
  rw [Subgroup.mem_bot, h1, map_one]

theorem exists_rank_of_ggTorusLift {Γ : Type} [Group Γ] [Finite Γ] {L : Subgroup Γ} {R : Type}
    [Group R] (hL : commutator ↥L = ⊤) (θ : ↥L ⧸ Subgroup.center ↥L ≃* R) {p r k : ℕ}
    (hp : 0 < p) (hk : k ≤ r) (hT : GGTorusLift p r R) :
    ∃ E U : Subgroup Γ, E ≤ L ∧ U ≤ L ∧ U ≠ ⊥ ∧ IsPGroup 2 U ∧
      E ≤ Subgroup.normalizer (U : Set Γ) ∧ IsElemAbelian p E ∧
        p ^ k * Nat.card ↥(E ⊓ Subgroup.centralizer (L : Set Γ)) ≤ Nat.card E := by
  obtain ⟨E, U, hEL, hUL, hU, hU2, hEU, hE, hEcard, hEC⟩ := exists_of_ggTorusLift hL θ hT
  refine ⟨E, U, hEL, hUL, hU, hU2, hEU, hE, ?_⟩
  rw [hEC, Subgroup.card_bot, mul_one, hEcard]
  exact Nat.pow_le_pow_right hp hk

theorem omegaMinusRank5_holds :
    OmegaMinusRank5 := by
  intro Γ _ _ L lab hlab htag hn hrank
  obtain ⟨hL, ⟨tg, rk, nn⟩, -, hraw⟩ := hlab
  obtain ⟨_, _, _, _, -, -, -, rfl⟩ := Canonical.largeEvenRawDatum_exists hraw
  simp only at htag hn hrank
  subst htag hn
  have h2 : rk ≠ 2 := by omega
  have h3 : rk ≠ 3 := by omega
  dsimp only [CFSG.Assembly.LargeEvenRawDatum] at hraw
  rw [if_neg h2, if_neg h3] at hraw
  obtain ⟨K, _, _, hK, b, c, hbc, -, -, θ, -⟩ := hraw
  exact exists_rank_of_ggTorusLift hL θ (by norm_num) (by omega : 5 ≤ rk - 1)
    (ggOrthRestTorusLiftInput_holds.1 K 2 (rk - 1) 5 b c hK (by omega) Nat.prime_five
      (by norm_num) hbc)

section TwE6


theorem twE6Rank5_holds : TwE6Rank5 := by
  intro Γ _ _ L lab hlab htag hn
  obtain ⟨hL, ⟨tg, rk, nn⟩, -, hraw⟩ := hlab
  obtain ⟨_, _, _, _, -, -, -, rfl⟩ := Canonical.largeEvenRawDatum_exists hraw
  simp only at htag hn
  subst htag hn
  dsimp only [CFSG.Assembly.LargeEvenRawDatum] at hraw
  obtain ⟨K, _, _, hK, -, -, θ, -⟩ := hraw
  exact exists_rank_of_ggTorusLift hL θ (by norm_num)
    (TwE6Delta.liftRank_of_ne (p := 5) (by norm_num)).ge
    (ggTorusLift_twE6Add_holds (n := 2) (by norm_num) hK Nat.prime_five (by norm_num))

theorem E6FourResidualFacts.of_four (hcent : E6FourCent5) (hfield : SubcompField)
    (huni : UnitaryNo5) (homega : OmegaMinus4Comp) : E6FourResidualFacts :=
  ⟨hcent, hfield, huni, homega, twE6Rank5_holds, omegaMinusRank5_holds⟩

