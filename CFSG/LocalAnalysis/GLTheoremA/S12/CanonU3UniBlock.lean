section Block

variable {ℓ f : ℕ} {K : Type} [Field K] {hK : UnitaryFieldData ℓ f K}
  {V : Type} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  {B : V →ₛₗ[hK.bar] V →ₗ[K] K} {x : LinearMap.GeneralLinearGroup K V}

theorem specialBlock_eq_kerImage {a : K[X]} {Ω : Type*} [Group Ω]
    (φ : orbitFactor B x a ≃* Ω) (ι : Ω →* blockGL (x : Module.End K V) a)
    (D : Ω →* (AdjoinRoot a)ˣ) (hD : ∀ w, D w = blockGLDet (x : Module.End K V) a (ι w))
    (hcompat : ∀ s : orbitFactor B x a,
      ι (φ s) = blockRestrict x a ⟨s.1, orbitFactor_le_gl_centralizer s.2⟩) :
    specialBlock B x a = kerImage (orbitFactor B x a) φ D := by
  ext g
  rw [mem_specialBlock, mem_kerImage]
  constructor
  · rintro ⟨hs, hg, h⟩
    refine ⟨hs, ?_⟩
    rw [hD, hcompat ⟨g, hs⟩]
    exact h
  · rintro ⟨hs, h⟩
    refine ⟨hs, orbitFactor_le_gl_centralizer hs, ?_⟩
    rw [hD, hcompat ⟨g, hs⟩] at h
    exact h

theorem nonempty_specialBlock_mulEquiv_SL {a : primaryFactors (x : Module.End K V)}
    (hP : PairedPrimaryBlock hK B x a) :
    Nonempty (↥(specialBlock B x (a : K[X])) ≃*
      SpecialLinearGroup (Fin (primaryMultiplicity (x : Module.End K V) (a : K[X])))
        (AdjoinRoot (a : K[X]))) := by
  obtain ⟨φ, hφ, -⟩ := exists_pairedFactor hP
  have hspec := specialBlock_eq_kerImage φ (MonoidHom.id _)
    (blockGLDet (x : Module.End K V) (a : K[X])) (fun _ => rfl)
    (fun s => blockGL_ext fun v hv => hφ s v hv)
  obtain ⟨e1⟩ := nonempty_kerImage_mulEquiv (orbitFactor B x (a : K[X])) φ
    (blockGLDet (x : Module.End K V) (a : K[X]))
  obtain ⟨e2⟩ := nonempty_specialLinearGroup_mulEquiv_ker_det (E := AdjoinRoot (a : K[X]))
    (W := primaryComponent (x : Module.End K V) (a : K[X]))
  exact ⟨((MulEquiv.subgroupCongr hspec).trans e1).trans e2.symm⟩

end Block

section SelfDualContainment

variable {ℓ f : ℕ} {K : Type} [Field K] {hK : UnitaryFieldData ℓ f K}
  {V : Type} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  {B : V →ₛₗ[hK.bar] V →ₗ[K] K} {x : LinearMap.GeneralLinearGroup K V}

theorem specialBlock_le_sesqSpecialUnitaryGroup_of_selfDual
    (H : UnitaryPrimaryData hK.bar B x)
    {a : primaryFactors (x : Module.End K V)}
    (hself : dualPoly hK.bar (a : K[X]) = a) :
    specialBlock B x (a : K[X]) ≤ sesqSpecialUnitaryGroup B := by
  classical
  obtain ⟨hE, Hf, hHf, hHfl, φ, hφ, hdetK⟩ :=
    exists_selfDualFactor hself (selfDualPrimaryBlock H a hself)
  have hcompat : ∀ s : orbitFactor B x (a : K[X]),
      ((φ s : sesqUnitaryGroup Hf) : blockGL (x : Module.End K V) (a : K[X])) =
        blockRestrict x (a : K[X]) ⟨s.1, orbitFactor_le_gl_centralizer s.2⟩ :=
    fun s => blockGL_ext fun v hv => hφ s v hv
  intro g hg
  obtain ⟨hs, hgc, hdet⟩ := mem_specialBlock.mp hg
  refine mem_sesqSpecialUnitaryGroup.mpr ⟨(specialBlock_le_unitaryCentralizer hg).1, ?_⟩
  refine hdetK ⟨g, hs⟩ ?_
  refine mem_sesqSpecialUnitaryGroup.mpr ⟨(φ ⟨g, hs⟩).2, ?_⟩
  have h1 : blockGLDet (x : Module.End K V) (a : K[X])
      ((φ ⟨g, hs⟩ : sesqUnitaryGroup Hf) : blockGL (x : Module.End K V) (a : K[X])) = 1 := by
    rw [hcompat ⟨g, hs⟩]
    simpa [blockDetHom] using hdet
  simpa [blockGLDet] using congrArg Units.val h1

end SelfDualContainment

section Surjection

variable {ℓ f n : ℕ} {K : Type} [Field K] {h : UnitaryFieldData ℓ f K}

theorem exists_surjective_specialBlock (hq : 2 ≤ ℓ ^ f)
    {x : LinearMap.GeneralLinearGroup K (Fin n → K)}
    (H : UnitaryPrimaryData h.bar (idForm h n) x)
    (a : {a : primaryFactors (x : Module.End K (Fin n → K)) // IsGoodBlock h x a})
    (T : Subgroup (primeFormP h (idGram K n)))
    (haT : T = ((specialBlock (idForm h n) x (a.1 : K[X])).comap (toLinSU h n)).map
      (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n))) :
    ∃ g : ↥(specialBlock (idForm h n) x (a.1 : K[X])) →* ↥T,
      Function.Surjective g ∧
        g.ker ≤ Subgroup.center ↥(specialBlock (idForm h n) x (a.1 : K[X])) ∧
        ∀ u : ↥(specialBlock (idForm h n) x (a.1 : K[X])),
          g u = 1 → ∃ v : ↥(gramSU h (idGram K n)),
            toLinSU h n v = (u : LinearMap.GeneralLinearGroup K (Fin n → K)) ∧
              v ∈ normOneScalars h (gramSU h (idGram K n)) n := by
  classical
  haveI := h.finite
  haveI : Finite ↥(gramSU h (idGram K n)) := inferInstance
  have hSle : specialBlock (idForm h n) x (a.1 : K[X]) ≤ (toLinSU h n).range := fun g hg =>
    mem_range_toLinSU (specialBlock_le_sesqSpecialUnitaryGroup_of_good H hq a.1 a.2 hg)
  let F : Subgroup ↥(gramSU h (idGram K n)) :=
    (specialBlock (idForm h n) x (a.1 : K[X])).comap (toLinSU h n)
  have hFmap : F.map (toLinSU h n) = specialBlock (idForm h n) x (a.1 : K[X]) :=
    Subgroup.map_comap_eq_self hSle
  let Φ : ↥F →* ↥(specialBlock (idForm h n) x (a.1 : K[X])) :=
    ((toLinSU h n).comp F.subtype).codRestrict _ fun v => Subgroup.mem_comap.mp v.2
  have hΦinj : Function.Injective Φ := by
    intro v w hvw
    apply Subtype.ext
    exact toLinSU_injective (congrArg Subtype.val hvw)
  have hΦsurj : Function.Surjective Φ := by
    intro u
    have hu2 : (u : LinearMap.GeneralLinearGroup K (Fin n → K)) ∈ F.map (toLinSU h n) := by
      rw [hFmap]
      exact u.2
    obtain ⟨v, hv, hvu⟩ := Subgroup.mem_map.mp hu2
    refine ⟨⟨v, ?_⟩, ?_⟩
    · exact (Subgroup.mem_comap).mpr (hvu ▸ u.2)
    · apply Subtype.ext
      exact hvu
  let ε : ↥(specialBlock (idForm h n) x (a.1 : K[X])) ≃* ↥F :=
    (MulEquiv.ofBijective Φ ⟨hΦinj, hΦsurj⟩).symm
  let π := QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K n)) n)
  subst haT
  have hεto : ∀ u, toLinSU h n (ε u : ↥(gramSU h (idGram K n))) =
      (u : LinearMap.GeneralLinearGroup K (Fin n → K)) := by
    intro u
    have h := congrArg Subtype.val (MulEquiv.apply_symm_apply
      (MulEquiv.ofBijective Φ ⟨hΦinj, hΦsurj⟩) u)
    exact h
  refine ⟨(π.subgroupMap F).comp ε.toMonoidHom,
    (MonoidHom.subgroupMap_surjective π F).comp ε.surjective, ?_, ?_⟩
  · intro u hu
    have h1 : π (ε u : ↥(gramSU h (idGram K n))) = 1 := congrArg Subtype.val hu
    have h2 : ((ε u : ↥F) : ↥(gramSU h (idGram K n))) ∈
        normOneScalars h (gramSU h (idGram K n)) n := (QuotientGroup.eq_one_iff _).1 h1
    have h3 := normOneScalars_le_center h _ n h2
    rw [Subgroup.mem_center_iff]
    intro w
    apply ε.injective
    rw [map_mul, map_mul]
    apply Subtype.ext
    rw [Subgroup.coe_mul, Subgroup.coe_mul]
    exact Subgroup.mem_center_iff.1 h3 _
  · intro u hu
    refine ⟨ε u, hεto u, ?_⟩
    have h1 : π (ε u : ↥(gramSU h (idGram K n))) = 1 := congrArg Subtype.val hu
    exact (QuotientGroup.eq_one_iff _).1 h1

end Surjection

section BlockImage

variable {f N : ℕ} {K : Type} [Field K]

@[expose] noncomputable def blockImage (h : UnitaryFieldData 2 f K)
    (x : LinearMap.GeneralLinearGroup K (Fin N → K)) (a : K[X]) :
    Subgroup (primeFormP h (idGram K N)) :=
  ((specialBlock (idForm h N) x a).comap (toLinSU h N)).map
    (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K N)) N))

end BlockImage

