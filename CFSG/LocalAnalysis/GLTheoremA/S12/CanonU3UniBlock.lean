variable {f N n : ℕ} {K : Type} [Field K]

theorem exists_block_of_component_primeForm (h : UnitaryFieldData 2 f K)
    (hN : N ≤ 6) (hn : Odd n)
    (A : primeFormUnitary h (idGram K N)) {c : Kˣ}
    (hA : (A : GL (Fin N) K) ^ 3 = Matrix.GeneralLinearGroup.scalar (Fin N) c)
    (hβ : primeFormConjHom h (idGram K N) A ≠ 1)
    {T : Subgroup (primeFormP h (idGram K N))}
    (hT : CFSG.Open.IsComponentOf T
      (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (primeFormConjHom h (idGram K N) A)))
    (hcard : Nat.card (↥T ⧸ Subgroup.center ↥T) = CFSG.Open.ordTwistedA 2 (2 ^ n)) :
    f = n ∧ ∃ μ : K, h.bar μ * μ = 1 ∧
      (X - C μ) ∈ primaryFactors
        ((Matrix.GeneralLinearGroup.toLin (A : GL (Fin N) K) : Module.End K (Fin N → K))) ∧
      primaryMultiplicity
        ((Matrix.GeneralLinearGroup.toLin (A : GL (Fin N) K) : Module.End K (Fin N → K)))
        (X - C μ) = 3 ∧
      primaryComponent
        ((Matrix.GeneralLinearGroup.toLin (A : GL (Fin N) K) : Module.End K (Fin N → K)))
        (X - C μ) ≠ ⊤ ∧
      T = blockImage h (Matrix.GeneralLinearGroup.toLin (A : GL (Fin N) K)) (X - C μ) := by
  classical
  haveI := h.finite
  haveI : CharP K 2 := h.charP
  have hq : 2 ≤ 2 ^ f := by
    have := Nat.one_lt_pow (by have := h.one_le; omega : f ≠ 0) h.prime.one_lt
    omega
  let x : LinearMap.GeneralLinearGroup K (Fin N → K) :=
    Matrix.GeneralLinearGroup.toLin (A : GL (Fin N) K)
  have hH : UnitaryPrimaryData h.bar (idForm h N) x :=
    primaryData_toLin' h A.2 Nat.prime_three (by norm_num) hA
  obtain ⟨a, haT⟩ := exists_good_block_of_component hq A rfl hH T hT
  haveI : Fact (Irreducible (a.1 : K[X])) :=
    ⟨irreducible_of_mem_primaryFactors a.1.2⟩
  have hm : 2 ≤ primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) := a.2.1
  have hd : 1 ≤ (a.1 : K[X]).natDegree :=
    Irreducible.natDegree_pos (irreducible_of_mem_primaryFactors a.1.2)
  have hfr : Module.finrank K (primaryComponent (x : Module.End K (Fin N → K)) (a.1 : K[X])) =
      (a.1 : K[X]).natDegree * primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) := by
    rw [finrank_primaryComponent]
  have hdm : (a.1 : K[X]).natDegree *
      primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) ≤ N := by
    have hle := Submodule.finrank_le (primaryComponent (x : Module.End K (Fin N → K)) (a.1 : K[X]))
    rw [hfr, Module.finrank_fin_fun] at hle
    exact hle
  have hdm6 : (a.1 : K[X]).natDegree *
      primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) ≤ 6 := by omega
  obtain ⟨gS, hgSsurj, hgSker, hgSkerProp⟩ := exists_surjective_specialBlock hq hH a T haT
  have hn1 : 1 ≤ n := by
    rcases hn with ⟨k, hk⟩
    omega
  obtain ⟨r, hr, hord⟩ :=
    CFSG.Quasithin.Vol2.Ch11.SecB.exists_odd_ordTwistedA_two (k := n) hn1
  by_cases hself : dualPoly h.bar (a.1 : K[X]) = (a.1 : K[X])
  · rcases exists_field_factor_of_selfDual hq hH a.1 hself a.2 with
      ⟨F, hF, hFt, hcharF, hFcard, h4, ⟨eSL2⟩⟩ |
      ⟨E, hE, hEt, hcharE, hEcard, hm3, hne, ⟨eSU⟩⟩
    · letI : Field F := hF
      letI : Fintype F := hFt
      exact (false_of_sl2_centralQuotient (f := f) (d := (a.1 : K[X]).natDegree) (n := n)
        hFcard h4 eSL2 gS hgSsurj hgSker hr hn hord hcard).elim
    · letI : Field E := hE
      letI : Fintype E := hEt
      have hN3 : 3 ≤ N := by
        have h3dm : 3 ≤ (a.1 : K[X]).natDegree *
            primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) := by
          calc 3 = 1 * 3 := by norm_num
            _ ≤ _ := Nat.mul_le_mul hd hm3
        exact h3dm.trans hdm
      have hN1 : 1 ≤ N := by omega
      let G := StatedSU
        (primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]))
        (2 ^ (f * (a.1 : K[X]).natDegree)) E
      have hperf : commutator G = ⊤ :=
        (CFSG.HardMathSupport.Solomon.Coordinator.LieComp.suFactorFacts_holds E
          (primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]))
          (2 ^ (f * (a.1 : K[X]).natDegree)) hEcard hm3 hne).perfect
      obtain ⟨g, hg, hker⟩ := exists_central_surjection_of_mulEquiv eSU gS hgSsurj hgSker
      haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
      have hEnat : Nat.card E = (2 ^ (f * (a.1 : K[X]).natDegree)) ^ 2 := by
        rw [Nat.card_eq_fintype_card]
        exact hEcard
      haveI : CharP E 2 :=
        CFSG.ClassicalGroups.Unitary.charP_of_card_sq (p := 2)
          (f := f * (a.1 : K[X]).natDegree) hEnat
      have hQ := CFSG.LieType.Universal.Unitary.isQuasisimple_statedSU_of_card
        (F := E) (p := 2) (f := f * (a.1 : K[X]).natDegree)
        (n := primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]))
        hEnat hm3 hne
      have hZcard : Nat.card (Subgroup.center G) =
          Nat.gcd (primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]))
            (2 ^ (f * (a.1 : K[X]).natDegree) + 1) := by
        rw [hQ.2]
        exact CFSG.LocalAnalysis.RankFourTheoremC.card_scalars_statedSU (K := E) (r := 2)
          (f := f * (a.1 : K[X]).natDegree)
          (n := primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]))
          hEnat (by omega)
      have hZodd : Odd (Nat.card (Subgroup.center G)) := by
        rw [hZcard]
        refine Odd.of_dvd_nat ?_ (Nat.gcd_dvd_right _ _)
        simpa using CFSG.Timmesfeld.Orders.odd_pow_add_one
          (f := f * (a.1 : K[X]).natDegree) (a := 1)
          (by have := Nat.mul_pos h.one_le hd; omega) (by norm_num)
      have hpad := CFSG.LieType.SemisimpleCentralizers.HeldLang.padicValNat_card_statedSU
        (K := E) (a := f * (a.1 : K[X]).natDegree)
        (d := primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]))
        (by have := Nat.mul_pos h.one_le hd; omega) (by omega) hEnat
      have hp2 := padicValNat_two_of_central_surjective hperf g hg hker hcard hZodd hr hord
      have heq : f * (a.1 : K[X]).natDegree *
          (primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) *
        (primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) - 1) / 2) =
        3 * n := by
        rw [hpad] at hp2
        exact hp2
      rcases su_block_solution (f := f) (d := (a.1 : K[X]).natDegree)
        (m := primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]))
        (n := n) h.one_le hd hm3 hdm6 hn heq with
        ⟨hm3eq, hd1, hfn⟩ | ⟨hm6eq, hd1, hn5f⟩
      · by_cases hN3eq : N = 3
        · have hVtop : primaryComponent (x : Module.End K (Fin N → K)) (a.1 : K[X]) = ⊤ := by
            apply Submodule.eq_top_of_finrank_eq
            simpa [hfr, hd1, hm3eq, hN3eq, Module.finrank_fin_fun]
          exact (hβ (primeFormConjHom_eq_one_of_primaryComponent_top hN1 A hd1 hVtop)).elim
        · have hVne : primaryComponent (x : Module.End K (Fin N → K)) (a.1 : K[X]) ≠ ⊤ := by
            intro htop
            have hfr3 : Module.finrank K
                (primaryComponent (x : Module.End K (Fin N → K)) (a.1 : K[X])) = 3 := by
              simpa [hfr, hd1, hm3eq]
            have hfrN : Module.finrank K
                (primaryComponent (x : Module.End K (Fin N → K)) (a.1 : K[X])) = N := by
              rw [htop, finrank_top, Module.finrank_fin_fun]
            omega
          obtain ⟨μ, hμeq⟩ : ∃ μ : K, (a.1 : K[X]) = X - C μ := by
            refine ⟨-(a.1 : K[X]).coeff 0, ?_⟩
            have h := (monic_of_mem_primaryFactors a.1.2).eq_X_add_C hd1
            rw [show X - C (-(a.1 : K[X]).coeff 0) =
              X + C ((a.1 : K[X]).coeff 0) from by rw [map_neg, sub_neg_eq_add]]
            exact h
          have hμ0 : μ ≠ 0 := by
            intro h0
            have hXeq : (a.1 : K[X]) = X := by rw [hμeq, h0, map_zero, sub_zero]
            have hX : dualPoly h.bar (X : K[X]) = 0 := by
              unfold dualPoly
              simp
            have hcontra : (0 : K[X]) = X := by
              rw [← hX, ← hXeq]
              exact hself
            have hc := congrArg (fun p : K[X] => p.coeff 1) hcontra
            simp at hc
          have hμnorm : h.bar μ * μ = 1 := by
            have hbar0 : h.bar μ ≠ 0 := (map_ne_zero h.bar).mpr hμ0
            have hdual : dualPoly h.bar (X - C μ) = X - C μ := by
              rw [← hμeq]
              exact hself
            have hinv : (h.bar μ)⁻¹ = μ := by
              have := congrArg (fun p : K[X] => p.coeff 0) hdual
              rw [CFSG.RankThree.PartOne.KCUnitaryBlock.dualPoly_X_sub_C hbar0] at this
              simpa using this
            calc h.bar μ * μ = h.bar μ * (h.bar μ)⁻¹ := by rw [hinv]
              _ = 1 := mul_inv_cancel₀ hbar0
          refine ⟨hfn, μ, hμnorm, ?_, ?_, ?_, ?_⟩
          · rw [← hμeq]
            exact a.1.2
          · rw [← hμeq]
            exact hm3eq
          · rw [← hμeq]
            exact hVne
          · rw [← hμeq]
            simpa [blockImage] using haT
      · have hdm6eq : (a.1 : K[X]).natDegree *
            primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) = 6 := by
          rw [hd1, hm6eq]
        have hN6 : N = 6 := by omega
        have hVtop : primaryComponent (x : Module.End K (Fin N → K)) (a.1 : K[X]) = ⊤ := by
          apply Submodule.eq_top_of_finrank_eq
          simpa [hfr, hd1, hm6eq, hN6, Module.finrank_fin_fun]
        exact (hβ (primeFormConjHom_eq_one_of_primaryComponent_top hN1 A hd1 hVtop)).elim
  · exact (false_of_paired_goodBlock (n := n) hH a hself hN hn hgSsurj hgSker hr hord hcard).elim

theorem three_dvd_card_center_of_component_primeForm (h : UnitaryFieldData 2 f K)
    (hN : N ≤ 6) (hn : Odd n)
    (A : primeFormUnitary h (idGram K N)) {c : Kˣ}
    (hA : (A : GL (Fin N) K) ^ 3 = Matrix.GeneralLinearGroup.scalar (Fin N) c)
    (hβ : primeFormConjHom h (idGram K N) A ≠ 1)
    {T : Subgroup (primeFormP h (idGram K N))}
    (hT : CFSG.Open.IsComponentOf T
      (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (primeFormConjHom h (idGram K N) A)))
    (hcard : Nat.card (↥T ⧸ Subgroup.center ↥T) = CFSG.Open.ordTwistedA 2 (2 ^ n)) :
    3 ∣ Nat.card ↥(Subgroup.center ↥T) := by
  classical
  haveI := h.finite
  haveI : CharP K 2 := h.charP
  let x : LinearMap.GeneralLinearGroup K (Fin N → K) :=
    Matrix.GeneralLinearGroup.toLin (A : GL (Fin N) K)
  have hH : UnitaryPrimaryData h.bar (idForm h N) x :=
    primaryData_toLin' h A.2 Nat.prime_three (by norm_num) hA
  obtain ⟨hfn, μ, hμnorm, hmem, hm3, hVne, hTb⟩ :=
    exists_block_of_component_primeForm h hN hn A hA hβ hT hcard
  let a : primaryFactors (x : Module.End K (Fin N → K)) := ⟨X - C μ, hmem⟩
  have ha : (a : K[X]) = X - C μ := rfl
  have hself : dualPoly h.bar (a : K[X]) = (a : K[X]) := by
    have hbar0 : h.bar μ ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at hμnorm
      exact zero_ne_one hμnorm
    rw [ha, CFSG.RankThree.PartOne.KCUnitaryBlock.dualPoly_X_sub_C hbar0,
      inv_eq_of_mul_eq_one_right hμnorm]
  have hVne' : primaryComponent (x : Module.End K (Fin N → K)) (a : K[X]) ≠ ⊤ := by
    simpa [a, x] using hVne
  obtain ⟨b, hbne⟩ := exists_ne_primaryFactor_of_primaryComponent_ne_top hH hVne'
  have hTb' : T = ((specialBlock (idForm h N) x (a : K[X])).comap (toLinSU h N)).map
      (QuotientGroup.mk' (normOneScalars h (gramSU h (idGram K N)) N)) := by
    simpa [blockImage, a, x] using hTb
  obtain ⟨gS, hgSsurj, -, hgSkerProp⟩ :=
    exists_surjective_specialBlock_of_selfDual hH a hself T hTb'
  haveI : Fact (Irreducible (a : K[X])) := ⟨irreducible_of_mem_primaryFactors a.2⟩
  obtain ⟨hE, Hf, hHf, hHfl, ⟨e₁⟩⟩ :=
    nonempty_specialBlock_mulEquiv_sesqSU hself (selfDualPrimaryBlock hH a hself)
  haveI : Finite (AdjoinRoot (a : K[X])) := Module.finite_of_finite K
  letI : Fintype (AdjoinRoot (a : K[X])) := Fintype.ofFinite _
  obtain ⟨β, hβbasis⟩ := hE.exists_orthonormal_basis hHf hHfl
  obtain ⟨e₂⟩ :=
    CFSG.RankThree.CentralLift.nonempty_sesqSpecialUnitaryGroup_mulEquiv_gramSU hE β
      (G := (1 : Matrix (Fin (primaryMultiplicity (x : Module.End K (Fin N → K)) (a : K[X])))
        (Fin (primaryMultiplicity (x : Module.End K (Fin N → K)) (a : K[X])))
        (AdjoinRoot (a : K[X]))))
      (fun i j => by rw [hβbasis i j, Matrix.one_apply])
  let G := StatedSU (primaryMultiplicity (x : Module.End K (Fin N → K)) (a : K[X]))
    (2 ^ (f * (a : K[X]).natDegree)) (AdjoinRoot (a : K[X]))
  let e₃ : ↥(specialBlock (idForm h N) x (a : K[X])) ≃* G :=
    (e₁.trans e₂).trans (MulEquiv.subgroupCongr
      (unitarySU_eq_gramSU hE
        (primaryMultiplicity (x : Module.End K (Fin N → K)) (a : K[X]))).symm)
  have hd1 : (a : K[X]).natDegree = 1 := by
    rw [ha, natDegree_X_sub_C]
  have hEnat : Nat.card (AdjoinRoot (a : K[X])) =
      (2 ^ (f * (a : K[X]).natDegree)) ^ 2 := hE.card_eq_sq
  have hqeq : 2 ^ (f * (a : K[X]).natDegree) = 2 ^ n := by
    rw [hd1, mul_one, hfn]
  have h3 : 3 ∣ 2 ^ (f * (a : K[X]).natDegree) + 1 := by
    rw [hqeq]
    exact CFSG.SignalizerFunctorTheorem.McBride.PSL2Even.three_dvd_pow_add_one hn
  have hZ3 : Nat.card (Subgroup.center ↥G) = 3 := by
    change Nat.card (Subgroup.center ↥(StatedSU
      (primaryMultiplicity (x : Module.End K (Fin N → K)) (a : K[X]))
      (2 ^ (f * (a : K[X]).natDegree)) (AdjoinRoot (a : K[X])))) = 3
    rw [hm3]
    exact CFSG.Open.StatedCenterThree.card_center_statedSU_three
      (K := AdjoinRoot (a : K[X])) hEnat h3
  haveI : Finite G := inferInstance
  exact three_dvd_card_center_of_center_card_three (n := f * (a : K[X]).natDegree)
    hH hself hbne e₃ hZ3 hgSsurj hgSkerProp

end Main

