    intro w
    apply ε.injective
    rw [map_mul, map_mul]
    apply Subtype.ext
    rw [Subgroup.coe_mul, Subgroup.coe_mul]
    exact Subgroup.mem_center_iff.1 h3 _
  · intro u hu
    refine ⟨ε u, hεto u, ?_⟩
    have h1 : π (ε u : ↥(gramSU h (idGram K n))) = 1 := congrArg Subtype.val hu
    exact (QuotientGroup.eq_one_iff _).1 h1

end SelfDualSurjection

section Kernel

variable {ℓ f n : ℕ} {K : Type} [Field K] {h : UnitaryFieldData ℓ f K}

theorem toLin_scalar_apply (c : Kˣ) (w : Fin n → K) :
    (Matrix.GeneralLinearGroup.toLin (GeneralLinearGroup.scalar (Fin n) c) :
      (Fin n → K) →ₗ[K] (Fin n → K)) w = (c : K) • w := by
  rw [Matrix.GeneralLinearGroup.toLin_apply]
  have hscalar : Matrix.scalar (Fin n) (c : K) =
      (c : K) • (1 : Matrix (Fin n) (Fin n) K) := by
    ext i j
    by_cases hij : i = j
    · subst hij
      simp [Matrix.scalar_apply]
    · simp [Matrix.scalar_apply, Matrix.one_apply, hij]
  change (Matrix.scalar (Fin n) (c : K)) *ᵥ w = (c : K) • w
  rw [hscalar, Matrix.smul_mulVec, Matrix.one_mulVec]

theorem eq_one_of_mem_specialBlock_of_mem_normOneScalars
    {x : LinearMap.GeneralLinearGroup K (Fin n → K)}
    (H : UnitaryPrimaryData h.bar (idForm h n) x)
    {a : primaryFactors (x : Module.End K (Fin n → K))}
    (hself : dualPoly h.bar (a : K[X]) = a)
    {b : primaryFactors (x : Module.End K (Fin n → K))} (hb : b ≠ a)
    {v : ↥(gramSU h (idGram K n))}
    (hvS : toLinSU h n v ∈ specialBlock (idForm h n) x (a : K[X]))
    (hvN : v ∈ normOneScalars h (gramSU h (idGram K n)) n) : v = 1 := by
  classical
  obtain ⟨c, -, -, hgsc⟩ := hvN
  obtain ⟨horb, -⟩ := mem_specialBlock.mp hvS
  have hbnot : (b : K[X]) ∉ ({(a : K[X]), dualPoly h.bar (a : K[X])} : Set K[X]) := by
    rintro (hba | hbba)
    · exact hb (Subtype.ext hba)
    · exact hb (Subtype.ext (hbba.trans hself))
  obtain ⟨v0, hv0mem, hv0ne⟩ :=
    Submodule.exists_mem_ne_zero_of_ne_bot (primaryComponent_ne_bot H.squarefree b.2)
  have hact1 : ((toLinSU h n v : LinearMap.GeneralLinearGroup K (Fin n → K)) :
      Module.End K (Fin n → K)) v0 = v0 :=
    horb.2 (b : K[X]) b.2 hbnot v0 hv0mem
  have hto : toLinSU h n v =
      Matrix.GeneralLinearGroup.toLin (GeneralLinearGroup.scalar (Fin n) c) := by
    rw [toLinSU_apply, hgsc]
  have hact2 : ((toLinSU h n v : LinearMap.GeneralLinearGroup K (Fin n → K)) :
      Module.End K (Fin n → K)) v0 = (c : K) • v0 := by
    rw [hto]
    exact toLin_scalar_apply c v0
  have hcv : (c : K) • v0 = v0 := by rw [← hact2, hact1]
  have hc1 : (c : K) = 1 := by
    have hzero : ((c : K) - 1) • v0 = 0 := by
      rw [sub_smul, hcv, one_smul, sub_self]
    have := (smul_eq_zero.mp hzero).resolve_right hv0ne
    exact sub_eq_zero.mp this
  apply Subtype.ext
  have hc1u : c = 1 := Units.ext hc1
  rw [hgsc, hc1u]
  exact map_one (GeneralLinearGroup.scalar (Fin n))

end Kernel

section Arithmetic

variable {n : ℕ}

open CFSG.Quasithin.Vol2.Ch11.SecB

theorem ordTwistedA_two_pow_mul_three (hn : Odd n) :
    ordTwistedA 2 (2 ^ n) * 3 =
      2 ^ (3 * n) * ((2 ^ (2 * n) - 1) * (2 ^ (3 * n) + 1)) := by
  have hq : 1 ≤ 2 ^ n := Nat.one_le_two_pow
  rw [ordTwistedA_two_eq hq]
  have hg : Nat.gcd 3 (2 ^ n + 1) = 3 := by
    exact Nat.gcd_eq_left (CFSG.SignalizerFunctorTheorem.McBride.PSL2Even.three_dvd_pow_add_one hn)
  rw [hg]
  have hpow3 : (2 ^ n) ^ 3 = 2 ^ (3 * n) := by rw [← pow_mul, Nat.mul_comm]
  have hpow2 : (2 ^ n) ^ 2 = 2 ^ (2 * n) := by rw [← pow_mul, Nat.mul_comm]
  rw [hpow3, hpow2]
  have hdiv : 3 ∣ (2 ^ (2 * n) - 1) * (2 ^ (3 * n) + 1) := by
    refine dvd_mul_of_dvd_left ?_ _
    have h3 : 3 ∣ (2 ^ n) ^ 2 - 1 :=
      (CFSG.SignalizerFunctorTheorem.McBride.PSL2Even.three_dvd_pow_add_one hn).trans
        (CFSG.Timmesfeld.Orders.add_one_dvd_sq_sub_one (2 ^ n))
    rwa [hpow2] at h3
  rw [Nat.div_mul_cancel (dvd_mul_of_dvd_right hdiv (2 ^ (3 * n)))]

theorem padicValNat_card_specialLinear {E : Type} [Field E] [Finite E] {m e : ℕ}
    (hm : 1 ≤ m) (he : 1 ≤ e) (hE : Nat.card E = 2 ^ e) :
    padicValNat 2 (Nat.card (SpecialLinearGroup (Fin m) E)) = e * (m * (m - 1) / 2) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rw [CFSG.LocalAnalysis.ComponentInitial.LinearFlag.card_SL_eq (K := E) (n := m) hm, hE]
  have hprodpos : 0 < ∏ j ∈ Finset.Icc 2 m, ((2 ^ e) ^ j - 1) := by
    refine Finset.prod_pos fun j hj => ?_
    have hj2 : 2 ≤ j := (Finset.mem_Icc.1 hj).1
    have h1 : 1 < (2 ^ e) ^ j :=
      Nat.one_lt_pow (by omega) (Nat.one_lt_pow (by omega) (by norm_num) : 1 < 2 ^ e)
    omega
  have hprododd : Odd (∏ j ∈ Finset.Icc 2 m, ((2 ^ e) ^ j - 1)) :=
    CFSG.Timmesfeld.Orders.odd_prod fun j hj =>
      CFSG.Timmesfeld.Orders.odd_pow_sub_one he (by
        have := (Finset.mem_Icc.1 hj).1
        omega)
  rw [padicValNat.mul (pow_ne_zero _ (pow_ne_zero _ (by norm_num))) hprodpos.ne',
    ← pow_mul, padicValNat.prime_pow,
    padicValNat.eq_zero_of_not_dvd hprododd.not_two_dvd_nat, add_zero]

theorem card_SL_two_ne_ordTwistedA {n : ℕ} (hn1 : 1 ≤ n) (hn : Odd n) :
    2 ^ (3 * n) * (2 ^ (2 * (3 * n)) - 1) ≠ ordTwistedA 2 (2 ^ n) := by
  intro h
  have hformula := ordTwistedA_two_pow_mul_three hn
  have h1 : (2 ^ (3 * n) * (2 ^ (2 * (3 * n)) - 1)) * 3 =
      2 ^ (3 * n) * ((2 ^ (2 * n) - 1) * (2 ^ (3 * n) + 1)) := by
    rw [h]
    exact hformula
  rw [show 2 * (3 * n) = 6 * n by ring] at h1
  have h1' : 2 ^ (3 * n) * ((2 ^ (6 * n) - 1) * 3) =
      2 ^ (3 * n) * ((2 ^ (2 * n) - 1) * (2 ^ (3 * n) + 1)) := by
    rw [← h1]
    ring
  have hApos : 0 < 2 ^ (3 * n) := pow_pos (by norm_num) _
  have hBC : (2 ^ (6 * n) - 1) * 3 =
      (2 ^ (2 * n) - 1) * (2 ^ (3 * n) + 1) :=
    Nat.mul_left_cancel hApos h1'
  have hB : 2 ^ (6 * n) - 1 = (2 ^ (3 * n) - 1) * (2 ^ (3 * n) + 1) := by
    have hsq : (2 ^ (3 * n)) ^ 2 = 2 ^ (6 * n) := by
      rw [← pow_mul]
      ring_nf
    have hsq' : (2 ^ (3 * n)) ^ 2 - 1 =
        (2 ^ (3 * n) - 1) * (2 ^ (3 * n) + 1) := by
      have h := Nat.sq_sub_sq (2 ^ (3 * n)) 1
      rw [one_pow] at h
      rw [h, Nat.mul_comm]
    rw [← hsq]
    exact hsq'
  have hU : 3 * (2 ^ (3 * n) - 1) = 2 ^ (2 * n) - 1 := by
    have hp : 0 < 2 ^ (3 * n) + 1 := by positivity
    rw [hB] at hBC
    rw [mul_assoc, Nat.mul_comm (2 ^ (3 * n) + 1) 3, ← mul_assoc] at hBC
    have h3 := Nat.mul_right_cancel hp hBC
    rwa [Nat.mul_comm] at h3
  have hUpos : 0 < 2 ^ (3 * n) - 1 := by
    have h8 : 8 ≤ 2 ^ (3 * n) := by
      calc 8 = 2 ^ 3 := by norm_num
        _ ≤ 2 ^ (3 * n) := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  have hVle : 2 ^ (2 * n) - 1 ≤ 2 ^ (3 * n) - 1 :=
    Nat.sub_le_sub_right (Nat.pow_le_pow_right (by norm_num) (by omega)) 1
  omega

end Arithmetic

section WholeSpace

variable {ℓ f n : ℕ} {K : Type} [Field K] {h : UnitaryFieldData ℓ f K}

theorem toLin_scalar_eq_algebraMap (c : Kˣ) :
    (Matrix.GeneralLinearGroup.toLin (GeneralLinearGroup.scalar (Fin n) c) :
      Module.End K (Fin n → K)) =
    algebraMap K (Module.End K (Fin n → K)) (c : K) := by
  apply LinearMap.ext
  intro w
  rw [toLin_scalar_apply, Algebra.algebraMap_eq_smul_one, LinearMap.smul_apply,
    Module.End.one_apply]

theorem exists_scalar_of_primaryComponent_eq_top (hn : 1 ≤ n)
    {A : GL (Fin n) K}
    {a : primaryFactors ((Matrix.GeneralLinearGroup.toLin A) : Module.End K (Fin n → K))}
    (hdeg : (a : K[X]).natDegree = 1)
    (hV : primaryComponent ((Matrix.GeneralLinearGroup.toLin A) : Module.End K (Fin n → K))
      (a : K[X]) = ⊤) :
    ∃ c : Kˣ, A = GeneralLinearGroup.scalar (Fin n) c := by
  classical
  haveI : Inhabited (Fin n) := ⟨Fin.mk 0 (by omega)⟩
  haveI : Nontrivial (Fin n → K) := Pi.nontrivial
  haveI : Nontrivial (Module.End K (Fin n → K)) := inferInstance
  have hmonic : (a : K[X]).Monic := monic_of_mem_primaryFactors a.2
  obtain ⟨β, hβ⟩ : ∃ β : K, (a : K[X]) = Polynomial.X - Polynomial.C β := by
    refine ⟨-(a : K[X]).coeff 0, ?_⟩
    have h := Polynomial.eq_X_add_C_of_natDegree_le_one (le_of_eq hdeg)
    have h1 : (a : K[X]).coeff 1 = 1 := by
      have hc := hmonic.coeff_natDegree
      rw [hdeg] at hc
      exact hc
    rw [h1, Polynomial.C_1, one_mul] at h
    rw [show Polynomial.X - Polynomial.C (-(a : K[X]).coeff 0) =
        Polynomial.X + Polynomial.C ((a : K[X]).coeff 0) by
      rw [map_neg, sub_neg_eq_add]]
    exact h
  have hzero : Polynomial.aeval
      ((Matrix.GeneralLinearGroup.toLin A : LinearMap.GeneralLinearGroup K (Fin n → K)) :
        Module.End K (Fin n → K)) (a : K[X]) = 0 := LinearMap.ker_eq_top.mp hV
  have hxeq : (Matrix.GeneralLinearGroup.toLin A : LinearMap.GeneralLinearGroup K (Fin n → K)) =
      algebraMap K (Module.End K (Fin n → K)) β := by
    rw [hβ, map_sub, Polynomial.aeval_X, Polynomial.aeval_C] at hzero
    exact sub_eq_zero.mp hzero
  have hβ0 : β ≠ 0 := by
    intro h0
    have hx0 : ((Matrix.GeneralLinearGroup.toLin A :
        LinearMap.GeneralLinearGroup K (Fin n → K)) : Module.End K (Fin n → K)) = 0 := by
      rw [hxeq, h0, map_zero]
    exact Units.ne_zero (Matrix.GeneralLinearGroup.toLin A) hx0
  refine ⟨Units.mk0 β hβ0, ?_⟩
  apply Matrix.GeneralLinearGroup.toLin.injective
  apply Units.ext
  rw [hxeq, toLin_scalar_eq_algebraMap]
  rfl

end WholeSpace

theorem su_block_solution {f d m n : ℕ} (hf : 1 ≤ f) (hd : 1 ≤ d) (hm : 3 ≤ m)
    (hmd : d * m ≤ 6) (hn : Odd n)
    (h : f * d * (m * (m - 1) / 2) = 3 * n) :
    (m = 3 ∧ d = 1 ∧ f = n) ∨ (m = 6 ∧ d = 1 ∧ n = 5 * f) := by
  have hnot : ¬ 2 ∣ n := hn.not_two_dvd_nat
  have hm6 : m ≤ 6 := by nlinarith
  have parity {c : ℕ} (hc : 2 ∣ c) (hfc : f * c = 3 * n) : False := by
    have h2 : 2 ∣ f * c := dvd_mul_of_dvd_right hc f
    rw [hfc] at h2
    rcases (Nat.prime_two.dvd_mul).mp h2 with h23 | h2n
    · norm_num at h23
    · exact hnot h2n
  interval_cases m
  · have hd2 : d ≤ 2 := by omega
    interval_cases d
    · left
      refine ⟨rfl, rfl, ?_⟩
      norm_num at h
      omega
    · exfalso
      have hfc : f * 6 = 3 * n := by
        rw [← h]
        ring
      exact parity (by norm_num : 2 ∣ 6) hfc
  · have hd1 : d = 1 := by omega
    subst d
    exfalso
    norm_num at h
    exact parity (by norm_num : 2 ∣ 6) h
  · have hd1 : d = 1 := by omega
    subst d
    exfalso
    norm_num at h
    exact parity (by norm_num : 2 ∣ 10) h
  · have hd1 : d = 1 := by omega
    subst d
    right
    refine ⟨rfl, rfl, ?_⟩
    norm_num at h
    omega

section CentralQuotient

theorem padicValNat_two_of_central_surjective {G T : Type*} [Group G] [Group T] [Finite G]
    (hperf : commutator G = ⊤) (f : G →* T) (hf : Function.Surjective f)
    (hker : f.ker ≤ Subgroup.center G) {t : ℕ}
    (hcard : Nat.card (T ⧸ Subgroup.center T) = t)
    (hZodd : Odd (Nat.card (Subgroup.center G))) {n r : ℕ} (hr : Odd r)
    (ht : t = 2 ^ (3 * n) * r) :
    padicValNat 2 (Nat.card G) = 3 * n := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hsplit :=
    card_eq_card_centerQuotient_mul_card_center_of_surjective
      hperf f hf hker
  rw [hcard, ht, mul_assoc] at hsplit
  have hRZ : 0 < r * Nat.card (Subgroup.center G) :=
    Nat.mul_pos hr.pos Nat.card_pos
  have hRZodd : Odd (r * Nat.card (Subgroup.center G)) := hr.mul hZodd
  rw [hsplit,
    padicValNat.mul (pow_ne_zero _ (by norm_num)) hRZ.ne',
    padicValNat.prime_pow,
    padicValNat.eq_zero_of_not_dvd hRZodd.not_two_dvd_nat, add_zero]

theorem card_eq_of_central_surjective_of_center_eq_one {G T : Type*} [Group G] [Group T]
    [Finite G] (hperf : commutator G = ⊤) (f : G →* T) (hf : Function.Surjective f)
    (hker : f.ker ≤ Subgroup.center G) {t : ℕ}
    (hcard : Nat.card (T ⧸ Subgroup.center T) = t)
    (hZ : Nat.card (Subgroup.center G) = 1) :
    Nat.card G = t := by
  rw [card_eq_card_centerQuotient_mul_card_center_of_surjective
    hperf f hf hker, hcard, hZ, mul_one]

end CentralQuotient

section SelfDualClassify

variable {ℓ f : ℕ} {K : Type} [Field K] {hK : UnitaryFieldData ℓ f K}
  {V : Type} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  {B : V →ₛₗ[hK.bar] V →ₗ[K] K} {x : LinearMap.GeneralLinearGroup K V}

theorem exists_field_factor_of_selfDual (hq : 2 ≤ ℓ ^ f)
    (H : UnitaryPrimaryData hK.bar B x)
    (a : primaryFactors (x : Module.End K V))
    (hself : dualPoly hK.bar (a : K[X]) = a) (ha : IsGoodBlock hK x a) :
    (∃ (F : Type) (_ : Field F) (_ : Fintype F), ringChar F = ℓ ∧
        Fintype.card F = ℓ ^ (f * (a : K[X]).natDegree) ∧ 4 ≤ Fintype.card F ∧
        Nonempty (↥(specialBlock B x (a : K[X])) ≃*
          Matrix.SpecialLinearGroup (Fin 2) F)) ∨
      (∃ (E : Type) (_ : Field E) (_ : Fintype E), ringChar E = ℓ ∧
        Fintype.card E = (ℓ ^ (f * (a : K[X]).natDegree)) ^ 2 ∧
        3 ≤ primaryMultiplicity (x : Module.End K V) (a : K[X]) ∧
        (primaryMultiplicity (x : Module.End K V) (a : K[X]),
          ℓ ^ (f * (a : K[X]).natDegree)) ≠ (3, 2) ∧
        Nonempty (↥(specialBlock B x (a : K[X])) ≃*
          ↥(StatedSU (primaryMultiplicity (x : Module.End K V) (a : K[X]))
            (ℓ ^ (f * (a : K[X]).natDegree)) E))) := by
  haveI := hK.finite
  haveI : CharP K ℓ := hK.charP
  have hd : 1 ≤ (a : K[X]).natDegree :=
    Irreducible.natDegree_pos (irreducible_of_mem_primaryFactors a.2)
  have hfd : 1 ≤ f * (a : K[X]).natDegree := Nat.mul_pos hK.one_le hd
  haveI : Finite (AdjoinRoot (a : K[X])) := Module.finite_of_finite K
  letI : Fintype (AdjoinRoot (a : K[X])) := Fintype.ofFinite _
  have hcharE : ringChar (AdjoinRoot (a : K[X])) = ℓ :=
    (Algebra.ringChar_eq K (AdjoinRoot (a : K[X]))).symm.trans (ringChar.eq K ℓ)
  have hm2 : 2 ≤ primaryMultiplicity (x : Module.End K V) (a : K[X]) := ha.1
  obtain ⟨hE, Hf, hHf, hHfl, ⟨e⟩⟩ :=
    nonempty_specialBlock_mulEquiv_sesqSU hself (selfDualPrimaryBlock H a hself)
  have hnum := isGoodBlock_numeric hq hself ha
  have hcardE : Fintype.card (AdjoinRoot (a : K[X])) =
      (ℓ ^ (f * (a : K[X]).natDegree)) ^ 2 := by
    rw [← Nat.card_eq_fintype_card]
    exact hE.card_eq_sq
  rcases Nat.lt_or_ge (primaryMultiplicity (x : Module.End K V) (a : K[X])) 3 with hm | hm
  · have hV : Module.finrank (AdjoinRoot (a : K[X]))
        (primaryComponent (x : Module.End K V) (a : K[X])) = 2 := by
      have h2 : primaryMultiplicity (x : Module.End K V) (a : K[X]) = 2 := by omega
      exact h2
    obtain ⟨e2⟩ :=
      CFSG.RankThree.Classical.nonempty_sesqSpecialUnitaryGroup_mulEquiv_SL2 hE hHf hHfl hV
    haveI : Finite hE.fixedField := inferInstance
    letI : Fintype hE.fixedField := Fintype.ofFinite _
    have hcardF : Fintype.card hE.fixedField = ℓ ^ (f * (a : K[X]).natDegree) := by
      rw [← Nat.card_eq_fintype_card]
      exact hE.card_fixedField
    haveI : Fact ℓ.Prime := ⟨hK.prime⟩
    haveI : CharP hE.fixedField ℓ := charP_of_card_eq_prime_pow hcardF
    have hcharF : ringChar hE.fixedField = ℓ := ringChar.eq _ _
    have h4 : 4 ≤ Fintype.card hE.fixedField := by
      rw [hcardF]
      exact hnum.1 (by omega)
    exact Or.inl ⟨hE.fixedField, inferInstance, inferInstance, hcharF, hcardF, h4,
      ⟨e.trans e2⟩⟩
  · obtain ⟨b, hb⟩ := hE.exists_orthonormal_basis hHf hHfl
    obtain ⟨e3⟩ :=
      CFSG.RankThree.CentralLift.nonempty_sesqSpecialUnitaryGroup_mulEquiv_gramSU hE b
        (G := (1 : Matrix (Fin (primaryMultiplicity (x : Module.End K V) (a : K[X])))
          (Fin (primaryMultiplicity (x : Module.End K V) (a : K[X])))
          (AdjoinRoot (a : K[X]))))
        (fun i j => by rw [hb i j, Matrix.one_apply])
    let e4 := (e.trans e3).trans (MulEquiv.subgroupCongr (unitarySU_eq_gramSU hE _).symm)
    have hne : (primaryMultiplicity (x : Module.End K V) (a : K[X]),
        ℓ ^ (f * (a : K[X]).natDegree)) ≠ (3, 2) := by
      intro hc
      have h1 := congrArg Prod.fst hc
      have h2 := congrArg Prod.snd hc
      simp only at h1 h2
      have := hnum.2 h1
      omega
    exact Or.inr ⟨AdjoinRoot (a : K[X]), inferInstance, inferInstance,
      hcharE, hcardE, hm, hne, ⟨e4⟩⟩

end SelfDualClassify

section ComponentFacts

variable {ℓ f n : ℕ} {K : Type} [Field K] {h : UnitaryFieldData ℓ f K}
  {V : Type} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  {B : V →ₛₗ[h.bar] V →ₗ[K] K} {x : LinearMap.GeneralLinearGroup K V}

theorem primeFormConjHom_eq_one_of_primaryComponent_top (hn : 1 ≤ n)
    (A : primeFormUnitary h (idGram K n))
    {a : primaryFactors ((Matrix.GeneralLinearGroup.toLin (A : GL (Fin n) K)) :
      Module.End K (Fin n → K))}
    (hdeg : (a : K[X]).natDegree = 1)
    (hV : primaryComponent ((Matrix.GeneralLinearGroup.toLin (A : GL (Fin n) K)) :
      Module.End K (Fin n → K)) (a : K[X]) = ⊤) :
    primeFormConjHom h (idGram K n) A = 1 := by
  obtain ⟨c, hAeq⟩ :=
    exists_scalar_of_primaryComponent_eq_top (n := n) hn hdeg hV
  have hmem : GeneralLinearGroup.scalar (Fin n) c ∈ primeFormUnitary h (idGram K n) := by
    rw [← hAeq]
    exact A.2
  have hδ : h.norm (c : K) = 1 :=
    norm_eq_one_of_scalar_mem_primeFormUnitary h hn (1 : GL (Fin n) K) hmem
  have hsub : (⟨(A : GL (Fin n) K), A.2⟩ : primeFormUnitary h (idGram K n)) =
      ⟨GeneralLinearGroup.scalar (Fin n) c, hmem⟩ := Subtype.ext hAeq
  change primeFormConjHom h (idGram K n) ⟨(A : GL (Fin n) K), A.2⟩ = 1
  rw [hsub]
  exact CFSG.HardMathSupport.Timmesfeld.CrossChar.primeFormConjHom_scalar_eq_one h
    (idGram K n) hδ

theorem exists_ne_primaryFactor_of_primaryComponent_ne_top
    (H : UnitaryPrimaryData h.bar B x)
    {a : primaryFactors (x : Module.End K V)}
    (hV : primaryComponent (x : Module.End K V) (a : K[X]) ≠ ⊤) :
    ∃ b : primaryFactors (x : Module.End K V), b ≠ a := by
  classical
  by_contra hno
  push Not at hno
  have hsubset : primaryFactors (x : Module.End K V) ⊆ ({(a : K[X])} : Finset K[X]) := by
    intro b hb
    rw [Finset.mem_singleton]
    exact congrArg Subtype.val (hno ⟨b, hb⟩)
  have hset : primaryFactors (x : Module.End K V) = {(a : K[X])} := by
    refine Finset.Subset.antisymm hsubset ?_
    intro b hb
    rw [Finset.mem_singleton] at hb
    subst b
    exact a.2
  have hmin : minpoly K (x : Module.End K V) = (a : K[X]) := by
    have hprod : (∏ b ∈ primaryFactors (x : Module.End K V), b) =
        minpoly K (x : Module.End K V) := prod_primaryFactors H.squarefree
    have hprod' : (∏ b ∈ primaryFactors (x : Module.End K V), b) = (a : K[X]) := by
      conv_lhs => rw [hset]
      simp
    exact hprod.symm.trans hprod'
  have hzero : Polynomial.aeval (x : Module.End K V) (a : K[X]) = 0 := by
    rw [← hmin]
    exact minpoly.aeval K (x : Module.End K V)
  exact hV (by
    rw [primaryComponent, hzero, LinearMap.ker_zero])

end ComponentFacts

theorem exists_central_surjection_of_mulEquiv {X Y T : Type*} [Group X] [Group Y] [Group T]
    (e : X ≃* Y) (g : X →* T) (hg : Function.Surjective g)
    (hk : g.ker ≤ Subgroup.center X) :
    ∃ f : Y →* T, Function.Surjective f ∧ f.ker ≤ Subgroup.center Y := by
  refine ⟨g.comp e.symm.toMonoidHom, hg.comp e.symm.surjective, ?_⟩
  intro y hy
  rw [MonoidHom.mem_ker] at hy
  have h1 : e.symm y ∈ g.ker := by
    rw [MonoidHom.mem_ker]
    exact hy
  have h2 := hk h1
  have hyeq : y = e (e.symm y) := (e.apply_symm_apply y).symm
  rw [hyeq]
  exact Subgroup.map_center_le_center e.surjective
    (Subgroup.mem_map.mpr ⟨e.symm y, h2, rfl⟩)

section BranchReductions

variable {f N n : ℕ} {K : Type} [Field K] {h : UnitaryFieldData 2 f K}

theorem false_of_paired_goodBlock
    {x : LinearMap.GeneralLinearGroup K (Fin N → K)}
    (H : UnitaryPrimaryData h.bar (idForm h N) x)
    (a : {a : primaryFactors (x : Module.End K (Fin N → K)) // IsGoodBlock h x a})
    (hself : dualPoly h.bar (a.1 : K[X]) ≠ (a.1 : K[X])) (hN : N ≤ 6) (hn : Odd n)
    {T : Subgroup (primeFormP h (idGram K N))}
    {gS : ↥(specialBlock (idForm h N) x (a.1 : K[X])) →* ↥T}
    (hgSsurj : Function.Surjective gS)
    (hgSker : gS.ker ≤ Subgroup.center ↥(specialBlock (idForm h N) x (a.1 : K[X])))
    {r : ℕ} (hr : Odd r)
    (hord : CFSG.Open.ordTwistedA 2 (2 ^ n) = 2 ^ (3 * n) * r)
    (hcard : Nat.card (↥T ⧸ Subgroup.center ↥T) = CFSG.Open.ordTwistedA 2 (2 ^ n)) :
    False := by
  classical
  haveI := h.finite
  haveI : Fact (Irreducible (a.1 : K[X])) :=
    ⟨irreducible_of_mem_primaryFactors a.1.2⟩
  have hm : 2 ≤ primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) := a.2.1
  have hd : 1 ≤ (a.1 : K[X]).natDegree :=
    Irreducible.natDegree_pos (irreducible_of_mem_primaryFactors a.1.2)
  have hfr : Module.finrank K (primaryComponent (x : Module.End K (Fin N → K)) (a.1 : K[X])) =
      (a.1 : K[X]).natDegree * primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) := by
    rw [finrank_primaryComponent]
  have hdm : (a.1 : K[X]).natDegree *
      primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) ≤ N := by
    have hle := Submodule.finrank_le (primaryComponent (x : Module.End K (Fin N → K)) (a.1 : K[X]))
    rw [hfr, Module.finrank_fin_fun] at hle
    exact hle
  have hP : PairedPrimaryBlock h (idForm h N) x a.1 :=
    pairedPrimaryBlock H a.1 (Ne.symm hself)
  obtain ⟨eSL⟩ := nonempty_specialBlock_mulEquiv_SL hP
  let E := AdjoinRoot (a.1 : K[X])
  haveI : Finite E := Module.finite_of_finite K
  letI : Fintype E := Fintype.ofFinite E
  have hEcard : Nat.card E = 2 ^ (2 * (f * (a.1 : K[X]).natDegree)) :=
    natCard_adjoinRoot (hK := h) (a := (a.1 : K[X]))
  have h4 : 4 ≤ Fintype.card E := by
    rw [← Nat.card_eq_fintype_card, hEcard]
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ (2 * (f * (a.1 : K[X]).natDegree)) :=
          Nat.pow_le_pow_right (by norm_num) (by have := h.one_le; nlinarith)
  let G := SpecialLinearGroup
    (Fin (primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]))) E
  have hperf : commutator G = ⊤ :=
    (CFSG.HardMathSupport.Solomon.Coordinator.LieComp.slFactorFacts_holds E
      (primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X])) hm (fun _ => h4)).perfect
  obtain ⟨g, hg, hker⟩ := exists_central_surjection_of_mulEquiv eSL gS hgSsurj hgSker
  have hZcard : Nat.card (Subgroup.center G) =
      Nat.gcd (primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]))
        (Nat.card E - 1) := by
    rw [← CFSG.LocalAnalysis.ComponentInitial.LinearFlag.scalars_eq_center,
      CFSG.LocalAnalysis.ComponentInitial.card_scalars_eq_gcd E (by omega)]
  have hZodd : Odd (Nat.card (Subgroup.center G)) := by
    rw [hZcard]
    refine Odd.of_dvd_nat ?_ (Nat.gcd_dvd_right _ _)
    rw [hEcard]
    simpa using CFSG.Timmesfeld.Orders.odd_pow_sub_one
      (f := 2 * (f * (a.1 : K[X]).natDegree)) (a := 1)
      (by have := Nat.mul_pos h.one_le hd; positivity) (by norm_num)
  have hfd1 : 1 ≤ 2 * (f * (a.1 : K[X]).natDegree) := by
    have hpos : 0 < f * (a.1 : K[X]).natDegree :=
      Nat.mul_pos (lt_of_lt_of_le zero_lt_one h.one_le)
        (lt_of_lt_of_le zero_lt_one hd)
    have := Nat.mul_pos (by norm_num : 0 < 2) hpos
    omega
  have hpad := padicValNat_card_specialLinear (E := E)
    (m := primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]))
    (e := 2 * (f * (a.1 : K[X]).natDegree)) (by omega) hfd1 hEcard
  have hp2 := padicValNat_two_of_central_surjective hperf g hg hker hcard hZodd hr hord
  have heq : 2 * (f * (a.1 : K[X]).natDegree) *
      (primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) *
        (primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) - 1) / 2) =
        3 * n := by
    rw [hpad] at hp2
    exact hp2
  have h2 : 2 ∣ 3 * n := by
    rw [← heq]
    exact ⟨(f * (a.1 : K[X]).natDegree) *
      (primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) *
        (primaryMultiplicity (x : Module.End K (Fin N → K)) (a.1 : K[X]) - 1) / 2),
      by ring⟩
  rcases (Nat.prime_two.dvd_mul).mp h2 with h23 | h2n
  · norm_num at h23
  · exact absurd h2n hn.not_two_dvd_nat

end BranchReductions

theorem false_of_sl2_centralQuotient {f d n : ℕ} {F : Type} [Field F] [Fintype F]
    (hFcard : Fintype.card F = 2 ^ (f * d)) (h4 : 4 ≤ Fintype.card F)
    {X T : Type*} [Group X] [Group T]
    (e : X ≃* SpecialLinearGroup (Fin 2) F)
    (gS : X →* T) (hgSsurj : Function.Surjective gS)
    (hgSker : gS.ker ≤ Subgroup.center X)
    {r : ℕ} (hr : Odd r) (hn : Odd n)
    (hord : CFSG.Open.ordTwistedA 2 (2 ^ n) = 2 ^ (3 * n) * r)
    (hcard : Nat.card (T ⧸ Subgroup.center T) = CFSG.Open.ordTwistedA 2 (2 ^ n)) :
    False := by
  classical
  let G := SpecialLinearGroup (Fin 2) F
  have h4' : 4 ≤ 2 ^ (f * d) := by
    rw [← hFcard]
    exact h4
  have hfd2 : 2 ≤ f * d := by
    by_contra h
    have hle : f * d ≤ 1 := by omega
    have h2 : 2 ^ (f * d) ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) hle
    norm_num at h2
    omega
  have hfd1 : 1 ≤ f * d := by omega
  have hperf : commutator G = ⊤ :=
    (CFSG.HardMathSupport.Solomon.Coordinator.LieComp.slFactorFacts_holds F 2
      (by norm_num) (fun _ => h4)).perfect
  obtain ⟨g, hg, hker⟩ := exists_central_surjection_of_mulEquiv e gS hgSsurj hgSker
  have hZcard : Nat.card (Subgroup.center G) = Nat.gcd 2 (Nat.card F - 1) := by
    rw [← CFSG.LocalAnalysis.ComponentInitial.LinearFlag.scalars_eq_center,
      CFSG.LocalAnalysis.ComponentInitial.card_scalars_eq_gcd F (by norm_num)]
  have hFodd : Odd (Nat.card F - 1) := by
    rw [Nat.card_eq_fintype_card, hFcard]
    simpa using CFSG.Timmesfeld.Orders.odd_pow_sub_one
      (f := f * d) (a := 1) (by omega) (by norm_num)
  have hZ : Nat.card (Subgroup.center G) = 1 := by
    rw [hZcard]
    exact Nat.coprime_iff_gcd_eq_one.mp (Nat.coprime_two_left.mpr hFodd)
  have hpad := padicValNat_card_specialLinear (E := F) (m := 2) (e := f * d)
    (by norm_num) hfd1 (by rw [Nat.card_eq_fintype_card]; exact hFcard)
  have hp2 := padicValNat_two_of_central_surjective hperf g hg hker hcard
    (hZ ▸ odd_one) hr hord
  have hfd : f * d = 3 * n := by
    rw [hpad] at hp2
    norm_num at hp2
    exact hp2
  have hSL2card : Nat.card G = Nat.card F * (Nat.card F ^ 2 - 1) := by
    rw [CFSG.LocalAnalysis.ComponentInitial.LinearFlag.card_SL_eq (K := F) (n := 2)
      (by norm_num)]
    norm_num [show Finset.Icc 2 2 = {2} by decide]
  have hcardG : Nat.card G = CFSG.Open.ordTwistedA 2 (2 ^ n) :=
    card_eq_of_central_surjective_of_center_eq_one hperf g hg hker hcard hZ
  have hpow : (2 ^ (f * d)) ^ 2 = 2 ^ (2 * (f * d)) := by
    rw [← pow_mul]
    ring_nf
  have hGeq : Nat.card G = 2 ^ (3 * n) * (2 ^ (2 * (3 * n)) - 1) := by
    rw [hSL2card, Nat.card_eq_fintype_card, hFcard, hpow, ← hfd]
  have hn1 : 1 ≤ n := by
    rcases hn with ⟨k, hk⟩
    omega
  exact (card_SL_two_ne_ordTwistedA hn1 hn) (hGeq.symm.trans hcardG)

theorem three_dvd_card_center_of_center_card_three {f N n : ℕ} {K : Type} [Field K]
    {h : UnitaryFieldData 2 f K}
    {x : LinearMap.GeneralLinearGroup K (Fin N → K)}
    (H : UnitaryPrimaryData h.bar (idForm h N) x)
    {a : primaryFactors (x : Module.End K (Fin N → K))}
    (hself : dualPoly h.bar (a : K[X]) = (a : K[X]))
    {b : primaryFactors (x : Module.End K (Fin N → K))} (hbne : b ≠ a)
    {T : Subgroup (primeFormP h (idGram K N))}
    {G : Type} [Group G] [Finite G]
    (e : ↥(specialBlock (idForm h N) x (a : K[X])) ≃* G)
    (hZ3 : Nat.card (Subgroup.center G) = 3)
    {gS : ↥(specialBlock (idForm h N) x (a : K[X])) →* ↥T}
    (hgSsurj : Function.Surjective gS)
    (hgSkerProp : ∀ u : ↥(specialBlock (idForm h N) x (a : K[X])), gS u = 1 →
      ∃ v : ↥(gramSU h (idGram K N)),
        toLinSU h N v = (u : LinearMap.GeneralLinearGroup K (Fin N → K)) ∧
          v ∈ normOneScalars h (gramSU h (idGram K N)) N) :
    3 ∣ Nat.card ↥(Subgroup.center ↥T) := by
  classical
  haveI : Nontrivial ↥(Subgroup.center G) :=
    Finite.one_lt_card_iff_nontrivial.mp (by rw [hZ3]; norm_num)
  obtain ⟨z0, hz0ne⟩ := exists_ne (1 : ↥(Subgroup.center G))
  have hpow3c : z0 ^ 3 = 1 := by
    have h := pow_card_eq_one' (G := ↥(Subgroup.center G)) (x := z0)
    rwa [hZ3] at h
  have hpow3 : (z0 : G) ^ 3 = 1 := by
    simpa using congrArg Subtype.val hpow3c
  let u : ↥(specialBlock (idForm h N) x (a : K[X])) := e.symm z0
  have hg_u_ne : gS u ≠ 1 := by
    intro hgu
    obtain ⟨v, hvto, hvN⟩ := hgSkerProp u hgu
    have hvS : toLinSU h N v ∈ specialBlock (idForm h N) x (a : K[X]) := by
      rw [hvto]
      exact u.2
    have hv1 := eq_one_of_mem_specialBlock_of_mem_normOneScalars H hself hbne hvS hvN
    have hu1 : u = 1 := by
      apply Subtype.ext
      rw [← hvto, hv1, map_one]
      rfl
    have hz01 : z0 = 1 := by
      have h := e.apply_symm_apply z0
      rw [show e.symm z0 = u from rfl, hu1, map_one] at h
      exact Subtype.ext h.symm
    exact hz0ne hz01
  let g3 := gS.comp e.symm.toMonoidHom
  have hg3 : Function.Surjective g3 := hgSsurj.comp e.symm.surjective
  have ht_ne : g3 z0 ≠ 1 := hg_u_ne
  have ht3 : (g3 z0) ^ 3 = 1 := by
    rw [← map_pow, hpow3, map_one]
  have ht_center : g3 z0 ∈ Subgroup.center ↥T := by
    rw [Subgroup.mem_center_iff]
    intro y
    obtain ⟨x', rfl⟩ := hg3 y
    change g3 x' * g3 z0 = g3 z0 * g3 x'
    rw [← map_mul, ← map_mul]
    exact congrArg g3 (Subgroup.mem_center_iff.mp z0.2 x')
  have hordt : orderOf (g3 z0) = 3 := orderOf_eq_prime ht3 ht_ne
  have hdv := Subgroup.orderOf_dvd_natCard (Subgroup.center ↥T) ht_center
  rwa [hordt] at hdv

