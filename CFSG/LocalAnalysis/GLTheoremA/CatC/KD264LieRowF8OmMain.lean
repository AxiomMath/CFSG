theorem kerOm_rational {K : Type} [Field K] [Finite K] {k : Subfield K} (hk : Nat.card k = 2 ^ 1)
    (hK : Nat.card K = 2 ^ (1 * 3)) {σ₀ : K ≃+* K} (hσ₀ : orderOf σ₀ = 3)
    (hfix : ∀ x, x ∈ k ↔ σ₀ x = x) (b c : k) (hirr : ∀ s : k, s ^ 2 + b * s + c ≠ 0)
    (hn1 : 1 ≤ 4)
    (A : Subgroup (MulAut (matrixProjectiveDerived (coordinateQuadMinus 4 K hn1 (b : K) (c : K)))))
    (hA : IsElemAbelian 3 A)
    (hout : ∀ a ∈ A, a ∉ (MulAut.conj : matrixProjectiveDerived (coordinateQuadMinus 4 K hn1 (b : K)
          (c : K)) →* MulAut (matrixProjectiveDerived (coordinateQuadMinus 4 K hn1 (b : K)
          (c : K)))).range →
      ∀ E : Subgroup (matrixProjectiveDerived (coordinateQuadMinus 4 K hn1 (b : K) (c : K))),
        E ≤ fixSubgroup a → IsElemAbelian 3 E →
        CFSG.Open.pRank 3 E + 1 ≤ CFSG.Open.pRank 3 A)
    (hnot : ¬ A ≤ innAutDerived (matrixProjectiveDerived (coordinateQuadMinus 4 K hn1 (b : K)
          (c : K)))) :
    KD264F8Datum (matrixProjectiveDerived (coordinateQuadMinus 4 K hn1 (b : K) (c : K))) A := by
  classical
  have hp : Nat.Prime 3 := Nat.prime_three
  have hp2 : (3 : ℕ) ≠ 2 := by norm_num
  have hK' : Nat.card K = 2 ^ 3 := by rw [hK]
  have hirrK : ∀ s : K, s ^ 2 + (b : K) * s + (c : K) ≠ 0 :=
    rootFree_of_odd_degree k hp hp2 (finrank_subfield_eq k Nat.prime_two le_rfl hk hK) b c hirr
  obtain ⟨hcen, hout3, hinn⟩ := om_aut_facts (n := 4) (ℓ := 2) (f := 3) (by norm_num) hn1
    Nat.prime_two (by norm_num) hK' (b : K) (c : K) hirrK
  have hk2 : Nat.card k = 2 := by simpa using hk
  obtain ⟨E0, -, hE0, hE0card⟩ := CFSG.GH74.Uniqueness.SU.SU1.exists_isElemAbelian_of_le_pRank
    (H := (⊤ : Subgroup (matrixProjectiveDerived (coordinateQuadMinus 4 k hn1 b c))))
    (k := CFSG.Open.pRank 3 (⊤ : Subgroup (matrixProjectiveDerived (coordinateQuadMinus 4 k hn1 b c))))
    hp le_rfl
  refine F8Asm.datum_of_core (G₀ := matrixProjectiveDerived (coordinateQuadMinus 4 k hn1 b c)) hcen
    A hA hnot (hout3 A hA) ?_ hout _ E0 hE0 hE0card ?_ ?_
  · intro a ha
    exact hinn a ha.2 (hA.2 a ha.1)
  · intro β hβ hβout
    have hβ3 : β ^ 3 = 1 := hA.2 β hβ
    have hβ1 : β ≠ 1 := fun h => hβout (h ▸ one_mem _)
    have hβo : IsOuterOfOrder 3 β := by
      refine ⟨orderOf_eq_prime hβ3 hβ1, fun g hg => hβout ?_⟩
      rw [hg]
      exact inner_le_innAutDerived _ ⟨g, rfl⟩
    obtain ⟨ι, hιinj, hιfix, hιrange⟩ := exists_descent_om (n := 4) (ℓ := 2) (e := 1) (by norm_num)
      hn1 Nat.prime_two (by norm_num) le_rfl hk hK hσ₀ hfix b c hirr hβo
    refine ⟨ι, hιinj, hιfix, fun x hx v => ?_, fun x hx _ => hιrange x hx⟩
    exact ι.range.mul_mem (ι.range.mul_mem (hιrange x hx) ⟨v, rfl⟩) (ι.range.inv_mem (hιrange x hx))
  · intro E hE hcard
    have hmaxE : ∀ E' : Subgroup (matrixProjectiveDerived (coordinateQuadMinus 4 k hn1 b c)),
        IsElemAbelian 3 E' → CFSG.Open.pRank 3 E' ≤ CFSG.Open.pRank 3 E := by
      intro E' hE'
      obtain ⟨j, hj⟩ := om_exists_card_eq_pow hp hE
      have h1 : CFSG.Open.pRank 3 E = j := om_pRank_eq_of_card hp hE hj
      have h2 : CFSG.Open.pRank 3 (⊤ : Subgroup (matrixProjectiveDerived
          (coordinateQuadMinus 4 k hn1 b c))) ≤ j := by
        by_contra hlt
        push Not at hlt
        have : 3 ^ j < 3 ^ CFSG.Open.pRank 3 (⊤ : Subgroup (matrixProjectiveDerived
            (coordinateQuadMinus 4 k hn1 b c))) := Nat.pow_lt_pow_right (by norm_num) hlt
        omega
      have h3 : CFSG.Open.pRank 3 E' ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (matrixProjectiveDerived
          (coordinateQuadMinus 4 k hn1 b c))) := CFSG.SectionRank.pRank_mono hp.one_lt le_top
      omega
    exact omCoreSingle_matrixProj hk2 hn1 b c hirr E hE hmaxE

theorem kerOm_model {S : Type} [Group S] [Finite S] (hM : StatedClassicalModel S .POmegaMinus 4 2 3)
    (A : Subgroup (MulAut S)) (hA : KD264F8Hyp S A) : KD264F8Datum S A := by
  classical
  have hp : Nat.Prime 3 := Nat.prime_three
  have hn1 : 1 ≤ 4 := by norm_num
  have hAab : IsElemAbelian 3 A := hA.1
  have hnot : ¬ A ≤ innAutDerived S := hA.2.2.2.2.2
  obtain ⟨b, hbA, hbout⟩ := SetLike.not_le_iff_exists.1 hnot
  have hb3 : b ^ 3 = 1 := hAab.2 b hbA
  have hb1 : b ≠ 1 := fun h => hbout (h ▸ one_mem _)
  have hbo : IsOuterOfOrder 3 b := by
    refine ⟨orderOf_eq_prime hb3 hb1, fun g hg => hbout ?_⟩
    rw [hg]
    exact inner_le_innAutDerived _ ⟨g, rfl⟩
  obtain ⟨e, K, _, _, k, σ, b', c', he, hf, hk, hK, hσ, hfix, hirr, ⟨ψ⟩⟩ :=
    exists_rational_model_minus_three (n := 4) (ℓ := 2) (f := 3) (p := 3) hn1 hM hp rfl hbo
  have he1 : e = 1 := by omega
  subst he1
  obtain ⟨hAab', hout', hnot'⟩ := F8Trans.hyp_transport ψ A hA
  exact F8Trans.datum_of_equiv ψ A (kerOm_rational hk hK hσ hfix b' c' hirr hn1 _ hAab' hout' hnot')

