namespace CFSG.LocalAnalysis.GLTheoremA.KD264Lie

theorem KD264F8KerOm_holds : KD264F8KerOm := by
  unfold KD264F8KerOm KD264F8Kernel
  intro d _hfin _hns _hk2 _hk3 _hov hP A hA
  obtain ⟨d1, hd1⟩ := d
  obtain ⟨q, rfl, hq⟩ := hP
  have hp2 : q.p = 2 := by
    have hdvd : q.p ∣ 2 ^ 3 := by
      have h8 : q.card = 2 ^ 3 := by rw [hq]; norm_num
      rw [← h8, TauCeti.PrimePower.card_def]
      exact dvd_pow_self q.p (Nat.pos_iff_ne_zero.1 q.exponent_pos)
    exact (Nat.prime_dvd_prime_iff_eq q.prime_p Nat.prime_two).1
      (q.prime_p.dvd_of_dvd_pow hdvd)
  have hexp : q.exponent = 3 := by
    have h8 : q.card = 2 ^ 3 := by rw [hq]; norm_num
    rw [TauCeti.PrimePower.card_def, hp2] at h8
    exact Nat.pow_right_injective (le_refl 2) h8
  have hm := CFSG.Models.lieModel_twistedD
    (G := (TauCeti.CFSGIndex.lie ⟨TauCeti.LieTypeIndex.twistedD 4 q, hd1⟩).Group) 4 q hd1
    (MulEquiv.refl _)
  obtain ⟨hadm, hSC | ⟨h0, -⟩⟩ := hm
  · rw [hp2, hexp] at hSC
    exact F8Om.kerOm_model hSC A hA
  · omega

end CFSG.LocalAnalysis.GLTheoremA.KD264Lie

