theorem statedClassicalModel_PSL_of_slCover_of_three_le {R : Type} [Group R]
    {K : Type} [Field K] [Finite K] {p f ν : ℕ} (hp : p.Prime) (hf : 1 ≤ f)
    (hK : Nat.card K = p ^ f) (hν : 3 ≤ ν)
    (g : SL(ν, K) →* R) (hg : Function.Surjective g)
    (hgk : g.ker ≤ Subgroup.center SL(ν, K)) :
    StatedClassicalModel (R ⧸ Subgroup.center R) .PSL ν p f := by
  have hperf : commutator SL(ν, K) = ⊤ :=
    (CFSG.LinearGroups.special_linear_dimension_at_least_three_perfect hν).commutator_eq_top
  obtain ⟨e⟩ := nonempty_centralQuotient_mulEquiv hperf g hg hgk
  refine ⟨⟨hp, hf, by omega, fun h => ?_, fun h => ?_⟩, K, inferInstance, inferInstance,
    hK, ⟨e.symm.trans
      (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj ν K)⟩⟩
  · have := congrArg Prod.fst h
    omega
  · have := congrArg Prod.fst h
    omega

theorem statedClassicalModel_PSU_of_suCover {R : Type} [Group R] {K : Type} [Field K] [Finite K]
    {p f ν : ℕ} (hp : p.Prime) (hf : 1 ≤ f)
    (hK : Nat.card K = (p ^ f) ^ 2) (hν : 3 ≤ ν) (hne : (ν, p ^ f) ≠ (3, 2))
    (g : ↥(StatedSU ν (p ^ f) K) →* R) (hg : Function.Surjective g)
    (hgk : g.ker ≤ Subgroup.center ↥(StatedSU ν (p ^ f) K)) :
    StatedClassicalModel (R ⧸ Subgroup.center R) .PSU ν p f := by
  classical
  letI : Fintype K := Fintype.ofFinite K
  haveI : Fact p.Prime := ⟨hp⟩
  have hK' : Fintype.card K = (p ^ f) ^ 2 := by
    rwa [← Nat.card_eq_fintype_card]
  have hperf : commutator ↥(StatedSU ν (p ^ f) K) = ⊤ :=
    (CFSG.HardMathSupport.Solomon.Coordinator.LieComp.suFactorFacts_holds K ν (p ^ f)
      hK' hν hne).perfect
  obtain ⟨e⟩ := nonempty_centralQuotient_mulEquiv hperf g hg hgk
  have hZ := (CFSG.LieType.Universal.Unitary.isQuasisimple_statedSU_of_card hK hν hne).2
  refine ⟨⟨hp, hf, hν, hne⟩, K, inferInstance, inferInstance, hK, ?_⟩
  exact ⟨e.symm.trans (QuotientGroup.quotientMulEquivOfEq hZ)⟩

theorem twistKind_eq_inner_of_compRank_eq_one
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup τ L p₀) {ta : Fin τ.rank → Lˣ}
    (i : KernelComponent (rootCharHom ta))
    (h1 : compRank (componentRoots (rootCharHom ta) i) = 1) :
    twistKind S.ρ (rootCharHom ta) i = .inner := by
  by_cases hin : twistInner (componentRoots (rootCharHom ta) i)
      ((S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ
        (componentRoots (rootCharHom ta) i)])
  · unfold twistKind
    rw [if_pos hin]
  · unfold twistKind
    rw [if_neg hin, if_neg (by rintro (⟨h, _⟩ | ⟨h, _⟩) <;> omega),
      if_neg (fun h => by omega), if_neg (fun h => by omega)]

