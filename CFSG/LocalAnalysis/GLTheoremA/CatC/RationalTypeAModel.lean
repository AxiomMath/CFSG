variable {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ} (S : LangSetup τ L p₀)

theorem exists_slCover_rationalComponent_rankOne
    {ta : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ ta ∈ S.D.torus) (i : KernelComponent (rootCharHom ta))
    (h1 : compRank (componentRoots (rootCharHom ta) i) = 1)
    (hn : (componentRoots (rootCharHom ta) i).ncard = 2)
    (hQS : CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom ta) i)) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (f : ℕ),
      1 ≤ f ∧ Nat.card K = ringChar L ^ f ∧
      ringChar L ^ f = S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom ta) i) ∧
      ringChar K = ringChar L ∧ 4 ≤ Nat.card K ∧
      ∃ g : SL(2, K) →* ↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i),
        Function.Surjective g ∧ g.ker ≤ Subgroup.center SL(2, K) := by
  classical
  obtain ⟨β, hβ, hΨ⟩ := exists_pair_of_rank_one i hn
  obtain ⟨hs0, hs, hmin⟩ := outer_componentOrbitLength_spec S hT i
  set s := componentOrbitLength S.ρ (componentRoots (rootCharHom ta) i) with hsdef
  have : NeZero s := ⟨hs0.ne'⟩
  have hinner : twistInner (componentRoots (rootCharHom ta) i)
      ((S.ρ : (Fin τ.rank → ℤ) → _)^[s]) :=
    twistInner_of_twistKind_eq_innerT S rootAutIsWeyl_holds hT i
      (twistKind_eq_inner_of_compRank_eq_one S i h1)
  obtain ⟨σ, z, hσ, hnorm, hz⟩ := exists_untwistT S hT i hs0 hinner
  obtain ⟨r, e, hr, hchar, he, hq⟩ := exists_char_pow S
  haveI : Fact r.Prime := ⟨hr⟩
  haveI : CharP L r := hchar
  have hrL : ringChar L = r := ringChar.eq L r
  have hσ' : ∀ c, σ c = c ^ (r ^ (e * s)) := fun c => by rw [hσ, hq, ← pow_mul]
  obtain ⟨hfinK, hKcard⟩ := finite_card_fixSubfield (L := L) (r := r) (n := e * s)
    (Nat.mul_pos he hs0) σ hσ'
  have hsL : ∃ u : Lˣ, u ^ 2 ≠ 1 := exists_unit_sq_ne_one_alg
  obtain ⟨f, hf1, hker, hf2⟩ :=
    rationalComponent_eq_range_componentRootSpanT S hT i hs hmin σ z hnorm hz hsL
  have hC : componentRootSpan (fixSubfield σ) (rootCharHom ta) i =
      (rootSL2 τ (fixSubfield σ) β).range := by
    rw [CFSG.RankThree.Chevalley.range_rootSL2_of_isRoot hβ]
    show rootSpan τ (fixSubfield σ) (componentRoots (rootCharHom ta) i) = _
    rw [hΨ]
    simp only [rootSpan, iSup_insert, iSup_singleton]
  let eSL : SL(2, ↥(fixSubfield σ)) ≃*
      ↥(componentRootSpan (fixSubfield σ) (rootCharHom ta) i) :=
    (MonoidHom.ofInjective (CFSG.RankThree.Chevalley.rootSL2_injective_of_field
      (K := ↥(fixSubfield σ)) β)).trans (MulEquiv.subgroupCongr hC.symm)
  have hker' := ker_comp_mulEquiv_le_center eSL f hker
  by_cases hQ4 : 4 ≤ r ^ (e * s)
  · obtain ⟨t, ht⟩ := exists_unit_sq_ne_one (L := L) σ hσ' (Nat.mul_pos he hs0) hQ4
    have hperfC := isPerfect_componentRootSpan_of_sq_ne_one (K := fixSubfield σ)
      (χ := rootCharHom ta) ht i
    have hRf : f.range = rationalComponent S.ρ S.Γ (rootCharHom ta) i :=
      le_antisymm (hf2 (Subgroup.isPerfect_iff.1 hperfC)) hf1
    let g : SL(2, ↥(fixSubfield σ)) →* ↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i) :=
      (f.comp eSL.toMonoidHom).codRestrict _ (fun c => by
        rw [← hRf]
        exact ⟨eSL c, rfl⟩)
    have hgsurj : Function.Surjective g := by
      rintro ⟨x, hx⟩
      obtain ⟨c, hc⟩ : x ∈ f.range := hRf ▸ hx
      obtain ⟨c', rfl⟩ := eSL.surjective c
      exact ⟨c', Subtype.ext hc⟩
    have hgker : g.ker ≤ Subgroup.center SL(2, ↥(fixSubfield σ)) := by
      intro c hc
      apply hker'
      rw [MonoidHom.mem_ker] at hc ⊢
      exact congrArg Subtype.val hc
    rw [hrL]
    refine ⟨↥(fixSubfield σ), inferInstance, hfinK, e * s, Nat.mul_pos he hs0, hKcard,
      ?_, ?_, ?_, g, hgsurj, hgker⟩
    · rw [pow_mul, ← hq]
    · exact (ringChar_subfield' _).trans hrL
    · rw [hKcard]
      exact hQ4
  · exfalso
    have hKle : Nat.card (fixSubfield σ) ≤ 3 := by rw [hKcard]; omega
    haveI : Group.IsSolvable SL(2, ↥(fixSubfield σ)) :=
      isSolvable_specialLinear_two_of_card_le_three hKle
    haveI : Group.IsSolvable ↥(componentRootSpan (fixSubfield σ) (rootCharHom ta) i) :=
      Group.isSolvable_of_isSolvable_injective (f := eSL.symm.toMonoidHom) eSL.symm.injective
    haveI : Group.IsSolvable ↥f.range :=
      Group.isSolvable_of_surjective (f := f.rangeRestrict) f.rangeRestrict_surjective
    haveI : Group.IsSolvable ↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i) :=
      Group.isSolvable_of_isSolvable_injective (Subgroup.inclusion_injective hf1)
    exact CFSG.HardMathSupport.Solomon.Coordinator.LieComp.not_isSolvable_of_isQuasisimple
      hQS inferInstance

theorem exists_slCover_rationalComponent_splitFrame {ta : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ ta ∈ S.D.torus) (i : KernelComponent (rootCharHom ta)) {ν : ℕ}
    (hν : 3 ≤ ν) {ψ : SL(ν, L) →* ModGL τ L} {σ : Fin ν → Fin ν → Fin τ.rank → ℤ}
    (hψ : IsSLFrame ψ σ) (hΨ : componentRoots (rootCharHom ta) i = frameRoots σ)
    (π : Equiv.Perm (Fin ν))
    (hπ : ∀ a b, a ≠ b → (S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ
      (componentRoots (rootCharHom ta) i)] (σ a b) = σ (π a) (π b)) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (f : ℕ),
      1 ≤ f ∧ Nat.card K = ringChar L ^ f ∧
      ringChar L ^ f = S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom ta) i) ∧
      ringChar K = ringChar L ∧
      ∃ g : SL(ν, K) →* ↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i),
        Function.Surjective g ∧ g.ker ≤ Subgroup.center SL(ν, K) := by
  classical
  obtain ⟨hs0, -, -⟩ := outer_componentOrbitLength_spec S hT i
  obtain ⟨r, e, hr, hchar, he, hq⟩ := exists_char_pow S
  haveI : Fact r.Prime := ⟨hr⟩
  haveI : CharP L r := hchar
  set s := componentOrbitLength S.ρ (componentRoots (rootCharHom ta) i) with hsdef
  have hrL : ringChar L = r := ringChar.eq L r
  obtain ⟨σQ, hσc, f, hf1, hfker, hf2⟩ := split_exists_hom S hT i hν hψ hΨ π hπ hr hchar he hq
  obtain ⟨hfinK, hKcard⟩ := finite_card_fixSubfield (L := L) (r := r) (n := e * s)
    (Nat.mul_pos he hs0) σQ hσc
  have hperf : Group.IsPerfect SL(ν, ↥(fixSubfield σQ)) :=
    CFSG.LinearGroups.special_linear_dimension_at_least_three_perfect hν
  have hRf : f.range = rationalComponent S.ρ S.Γ (rootCharHom ta) i :=
    le_antisymm (hf2 hperf) hf1
  let g : SL(ν, ↥(fixSubfield σQ)) →* ↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i) :=
    f.codRestrict _ (fun c => hRf ▸ ⟨c, rfl⟩)
  have hgsurj : Function.Surjective g := by
    rintro ⟨x, hx⟩
    obtain ⟨c, hc⟩ : x ∈ f.range := hRf ▸ hx
    exact ⟨c, Subtype.ext hc⟩
  have hgker : g.ker ≤ Subgroup.center SL(ν, ↥(fixSubfield σQ)) := by
    intro c hc
    apply hfker
    rw [MonoidHom.mem_ker] at hc ⊢
    exact congrArg Subtype.val hc
  rw [hrL]
  refine ⟨↥(fixSubfield σQ), inferInstance, hfinK, e * s, Nat.mul_pos he hs0, hKcard,
    ?_, ?_, g, hgsurj, hgker⟩
  · rw [pow_mul, ← hq]
  · exact (ringChar_subfield' _).trans hrL

theorem not_unitaryFrame_three_two {ta : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ ta ∈ S.D.torus) (i : KernelComponent (rootCharHom ta)) {ν : ℕ}
    (hν : 3 ≤ ν) {ψ : SL(ν, L) →* ModGL τ L} {σ : Fin ν → Fin ν → Fin τ.rank → ℤ}
    (hψ : IsSLFrame ψ σ) (hΨ : componentRoots (rootCharHom ta) i = frameRoots σ)
    (π : Equiv.Perm (Fin ν))
    (hπ : ∀ a b, a ≠ b → (S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ
      (componentRoots (rootCharHom ta) i)] (σ a b) = σ (π b) (π a))
    {r e : ℕ} (hr : r.Prime) (hchar : CharP L r) (he : 0 < e) (hq : S.D.q = r ^ e)
    (hQS : CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom ta) i)) :
    (ν, r ^ (e * componentOrbitLength S.ρ (componentRoots (rootCharHom ta) i))) ≠ (3, 2) := by
  classical
  obtain ⟨hs0, -, -⟩ := outer_componentOrbitLength_spec S hT i
  set s := componentOrbitLength S.ρ (componentRoots (rootCharHom ta) i) with hsdef
  have hes : 0 < e * s := Nat.mul_pos he hs0
  intro h32
  obtain ⟨σQ, hσc, f, hf1, -, -⟩ := two_suN_exists_hom S hT i hν hψ hΨ π hπ
    hr hchar he hq
  obtain ⟨hfin, -, hc216⟩ := stdUnitary_fixSubgroup (ν := ν) hr hes σQ hσc hν
  have hcard := hc216 h32
  haveI := hfin
  haveI := Fintype.ofFinite
    ↥(CFSG.RankThree.Classical2.fixSubgroup (stdUnitaryEquiv (ν := ν) σQ))
  haveI : Group.IsSolvable
      ↥(CFSG.RankThree.Classical2.fixSubgroup (stdUnitaryEquiv (ν := ν) σQ)) :=
    CFSG.Burnside.finite_group_isSolvable_of_card_eq_prime_pow_mul_prime_pow
      (p := 2) (q := 3) (a := 3) (b := 3) Nat.prime_two Nat.prime_three (by norm_num)
      (by rw [← Nat.card_eq_fintype_card, hcard]; norm_num)
  haveI : Group.IsSolvable ↥f.range :=
    Group.isSolvable_of_surjective (f := f.rangeRestrict) f.rangeRestrict_surjective
  haveI : Group.IsSolvable ↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i) :=
    Group.isSolvable_of_isSolvable_injective (Subgroup.inclusion_injective hf1)
  exact CFSG.HardMathSupport.Solomon.Coordinator.LieComp.not_isSolvable_of_isQuasisimple
    hQS inferInstance

theorem exists_suCover_rationalComponent_unitaryFrame {ta : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ ta ∈ S.D.torus) (i : KernelComponent (rootCharHom ta)) {ν : ℕ}
    (hν : 3 ≤ ν) {ψ : SL(ν, L) →* ModGL τ L} {σ : Fin ν → Fin ν → Fin τ.rank → ℤ}
    (hψ : IsSLFrame ψ σ) (hΨ : componentRoots (rootCharHom ta) i = frameRoots σ)
    (π : Equiv.Perm (Fin ν))
    (hπ : ∀ a b, a ≠ b → (S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ
      (componentRoots (rootCharHom ta) i)] (σ a b) = σ (π b) (π a))
    (hQS : CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom ta) i)) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (f : ℕ),
      1 ≤ f ∧ Nat.card K = (ringChar L ^ f) ^ 2 ∧
      ringChar L ^ f = S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom ta) i) ∧
      ringChar K = ringChar L ∧ (ν, ringChar L ^ f) ≠ (3, 2) ∧
      ∃ g : ↥(StatedSU ν (ringChar L ^ f) K) →* ↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i),
        Function.Surjective g ∧
          g.ker ≤ Subgroup.center ↥(StatedSU ν (ringChar L ^ f) K) := by
  classical
  obtain ⟨hs0, -, -⟩ := outer_componentOrbitLength_spec S hT i
  obtain ⟨r, e, hr, hchar, he, hq⟩ := exists_char_pow S
  haveI : Fact r.Prime := ⟨hr⟩
  haveI : CharP L r := hchar
  set s := componentOrbitLength S.ρ (componentRoots (rootCharHom ta) i) with hsdef
  have hes : 0 < e * s := Nat.mul_pos he hs0
  have hrL : ringChar L = r := ringChar.eq L r
  have h32r : (ν, r ^ (e * s)) ≠ (3, 2) :=
    not_unitaryFrame_three_two S hT i hν hψ hΨ π hπ hr hchar he hq hQS
  obtain ⟨σQ, hσc, f, hf1, hfker, hf2⟩ := two_suN_exists_hom S hT i hν hψ hΨ π hπ
    hr hchar he hq
  obtain ⟨hfin, hqsC, -⟩ := stdUnitary_fixSubgroup (ν := ν) hr hes σQ hσc hν
  have hCperf : Group.IsPerfect
      ↥(CFSG.RankThree.Classical2.fixSubgroup (stdUnitaryEquiv (ν := ν) σQ)) :=
    (hqsC h32r).1
  have hRf : f.range = rationalComponent S.ρ S.Γ (rootCharHom ta) i :=
    le_antisymm (hf2 hCperf) hf1
  let g : ↥(CFSG.RankThree.Classical2.fixSubgroup (stdUnitaryEquiv (ν := ν) σQ)) →*
      ↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i) :=
    f.codRestrict _ (fun c => hRf ▸ ⟨c, rfl⟩)
  have hgker : g.ker ≤ Subgroup.center
      ↥(CFSG.RankThree.Classical2.fixSubgroup (stdUnitaryEquiv (ν := ν) σQ)) := by
    intro c hc
    apply hfker
    rw [MonoidHom.mem_ker] at hc ⊢
    exact congrArg Subtype.val hc
  obtain ⟨F, hFcard, ⟨eC⟩⟩ := two_suN_exists_equiv hr hes σQ hσc hν
  haveI : Finite ↥F := Nat.finite_of_card_ne_zero (by
    rw [hFcard]
    exact (pow_pos (pow_pos hr.pos _) 2).ne')
  let g' : ↥(StatedSU ν (r ^ (e * s)) F) →*
      ↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i) := g.comp eC.toMonoidHom
  have hg'surj : Function.Surjective g' := by
    rintro ⟨x, hx⟩
    obtain ⟨c, hc⟩ : x ∈ f.range := hRf ▸ hx
    obtain ⟨c', rfl⟩ := eC.surjective c
    exact ⟨c', Subtype.ext hc⟩
  have hg'ker : g'.ker ≤ Subgroup.center ↥(StatedSU ν (r ^ (e * s)) F) :=
    ker_comp_mulEquiv_le_center eC g hgker
  have hring : ringChar ↥F = ringChar L := ringChar_subfield' _
  rw [hrL]
  refine ⟨↥F, inferInstance, inferInstance, e * s, Nat.mul_pos he hs0, hFcard,
    ?_, ?_, ?_, g', hg'surj, hg'ker⟩
  · rw [pow_mul, ← hq]
  · exact hring.trans hrL
  · exact h32r

theorem typeA_frame_cases
    {p : ℕ} (hp : p.Prime)
    {a : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ a ∈ S.D.torus) (hap : ∀ i, a i ^ p = 1) (h1 : rootDiagUnit τ a ≠ 1)
    (i : KernelComponent (rootCharHom a))
    (hA : 1 ≤ compRank (componentRoots (rootCharHom a) i) ∧
      (componentRoots (rootCharHom a) i).ncard = compRank (componentRoots (rootCharHom a) i) *
        (compRank (componentRoots (rootCharHom a) i) + 1)) :
    (compRank (componentRoots (rootCharHom a) i) = 1 ∧
        (componentRoots (rootCharHom a) i).ncard = 2) ∨
      (∃ (ν : ℕ) (ψ : SL(ν, L) →* ModGL τ L) (σ : Fin ν → Fin ν → Fin τ.rank → ℤ)
        (π : Equiv.Perm (Fin ν)),
        3 ≤ ν ∧ IsSLFrame ψ σ ∧ componentRoots (rootCharHom a) i = frameRoots σ ∧
          ∀ x y, x ≠ y → (S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ
            (componentRoots (rootCharHom a) i)] (σ x y) = σ (π x) (π y)) ∨
      (∃ (ν : ℕ) (ψ : SL(ν, L) →* ModGL τ L) (σ : Fin ν → Fin ν → Fin τ.rank → ℤ)
        (π : Equiv.Perm (Fin ν)),
        3 ≤ ν ∧ IsSLFrame ψ σ ∧ componentRoots (rootCharHom a) i = frameRoots σ ∧
          ∀ x y, x ≠ y → (S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ
            (componentRoots (rootCharHom a) i)] (σ x y) = σ (π y) (π x)) := by
  classical
  have hℓp : ringChar L ≠ p := ringChar_ne_of_pow_eq_one hp hap h1
  by_cases hr1 : compRank (componentRoots (rootCharHom a) i) = 1
  · exact Or.inl ⟨hr1, by rw [hA.2, hr1]⟩
  · have h2 : 2 ≤ compRank (componentRoots (rootCharHom a) i) := by omega
    have hTp := rootDiagUnit_pow_eq_one_of_forall hap
    have hpL : ((p : ℕ) : L) ≠ 0 := natCast_ne_zero_of_ringChar_ne hp hℓp
    obtain ⟨ν, ψ, σ, κ, hν, hψ, hκ, hnorm, hΨ⟩ := exists_frame_of_typeA_tag_T_of_prime
      g2LongA2Frame_proved S hp hpL hTp i h2 hA.2
    obtain ⟨hs0, hs, -⟩ := outer_componentOrbitLength_spec S hT i
    set s := componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) with hsdef
    have hmaps : ∀ x y, x ≠ y → (S.ρ : (Fin τ.rank → ℤ) → _)^[s] (σ x y) ∈ frameRoots σ := by
      intro x y hxy
      have h1 : σ x y ∈ componentRoots (rootCharHom a) i := by
        rw [hΨ]
        exact ⟨x, y, hxy, rfl⟩
      have h2 : (S.ρ : (Fin τ.rank → ℤ) → _)^[s] (σ x y) ∈
          (S.ρ : (Fin τ.rank → ℤ) → _)^[s] '' componentRoots (rootCharHom a) i := ⟨_, h1, rfl⟩
      rw [hs, hΨ] at h2
      exact h2
    have hneg : ∀ (n : ℕ) (γ : Fin τ.rank → ℤ),
        (S.ρ : (Fin τ.rank → ℤ) → _)^[n] (-γ) = -(S.ρ : (Fin τ.rank → ℤ) → _)^[n] γ := by
      intro n
      induction n with
      | zero => exact fun γ => rfl
      | succ n ih =>
        intro γ
        rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih, S.frob.neg_eq]
    rcases hψ.aut_cases hν hκ hnorm ((S.ρ : (Fin τ.rank → ℤ) → _)^[s]) hmaps (hneg s)
        (iform_rho_iterate S s) with ⟨π, hπ⟩ | ⟨π, hπ⟩
    · exact Or.inr (Or.inl ⟨ν, ψ, σ, π, hν, hψ, hΨ, hπ⟩)
    · exact Or.inr (Or.inr ⟨ν, ψ, σ, π, hν, hψ, hΨ, hπ⟩)

theorem rationalComponent_rankOne_model
    {ta : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ ta ∈ S.D.torus) (i : KernelComponent (rootCharHom ta))
    (h1 : compRank (componentRoots (rootCharHom ta) i) = 1)
    (hn : (componentRoots (rootCharHom ta) i).ncard = 2)
    (hQS : CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom ta) i)) :
    ∃ f, 1 ≤ f ∧ ringChar L ^ f =
        S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom ta) i) ∧
      StatedClassicalModel (↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i))
        .PSL 2 (ringChar L) f := by
  obtain ⟨K, hfield, hfinite, f, hf1, hKcard, hfeq, hring, hK4, g, hgsurj, hgker⟩ :=
    exists_slCover_rationalComponent_rankOne S hT i h1 hn hQS
  letI : Fintype K := Fintype.ofFinite K
  have hp : (ringChar L).Prime := by
    rw [← hring]
    exact CharP.prime_ringChar K
  have hK4' : 4 ≤ Fintype.card K := by
    rwa [Nat.card_eq_fintype_card] at hK4
  have hperf : commutator SL(2, K) = ⊤ :=
    (CFSG.HardMathSupport.Solomon.Coordinator.LieComp.slFactorFacts_holds K 2 le_rfl
      (fun _ => hK4')).perfect
  exact ⟨f, hf1, hfeq,
    statedClassicalModel_PSL_of_slCover hp hf1 hKcard hK4 g hgsurj hgker hperf⟩

theorem rationalComponent_splitFrame_model {ta : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ ta ∈ S.D.torus) (i : KernelComponent (rootCharHom ta)) {ν : ℕ}
    (hν : 3 ≤ ν) {ψ : SL(ν, L) →* ModGL τ L} {σ : Fin ν → Fin ν → Fin τ.rank → ℤ}
    (hψ : IsSLFrame ψ σ) (hΨ : componentRoots (rootCharHom ta) i = frameRoots σ)
    (π : Equiv.Perm (Fin ν))
    (hπ : ∀ a b, a ≠ b → (S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ
      (componentRoots (rootCharHom ta) i)] (σ a b) = σ (π a) (π b)) :
    ∃ f, 1 ≤ f ∧ ringChar L ^ f =
        S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom ta) i) ∧
      StatedClassicalModel (↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i))
        .PSL ν (ringChar L) f := by
  obtain ⟨K, hfield, hfinite, f, hf1, hKcard, hfeq, hring, g, hgsurj, hgker⟩ :=
    exists_slCover_rationalComponent_splitFrame S hT i hν hψ hΨ π hπ
  have hp : (ringChar L).Prime := by
    rw [← hring]
    exact CharP.prime_ringChar K
  exact ⟨f, hf1, hfeq,
    statedClassicalModel_PSL_of_slCover_of_three_le hp hf1 hKcard hν g hgsurj hgker⟩

theorem rationalComponent_unitaryFrame_model {ta : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ ta ∈ S.D.torus) (i : KernelComponent (rootCharHom ta)) {ν : ℕ}
    (hν : 3 ≤ ν) {ψ : SL(ν, L) →* ModGL τ L} {σ : Fin ν → Fin ν → Fin τ.rank → ℤ}
    (hψ : IsSLFrame ψ σ) (hΨ : componentRoots (rootCharHom ta) i = frameRoots σ)
    (π : Equiv.Perm (Fin ν))
    (hπ : ∀ a b, a ≠ b → (S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ
      (componentRoots (rootCharHom ta) i)] (σ a b) = σ (π b) (π a))
    (hQS : CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom ta) i)) :
    ∃ f, 1 ≤ f ∧ ringChar L ^ f =
        S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom ta) i) ∧
      StatedClassicalModel (↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom ta) i))
        .PSU ν (ringChar L) f := by
  obtain ⟨K, hfield, hfinite, f, hf1, hKcard, hfeq, hring, h32, g, hgsurj, hgker⟩ :=
    exists_suCover_rationalComponent_unitaryFrame S hT i hν hψ hΨ π hπ hQS
  have hp : (ringChar L).Prime := by
    rw [← hring]
    exact CharP.prime_ringChar K
  exact ⟨f, hf1, hfeq,
    statedClassicalModel_PSU_of_suCover hp hf1 hKcard hν h32 g hgsurj hgker⟩

theorem rationalComponent_typeA_model
    {p : ℕ} (hp : p.Prime)
    {a : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ a ∈ S.D.torus) (hap : ∀ i, a i ^ p = 1) (h1 : rootDiagUnit τ a ≠ 1)
    (i : KernelComponent (rootCharHom a))
    (hA : 1 ≤ compRank (componentRoots (rootCharHom a) i) ∧
      (componentRoots (rootCharHom a) i).ncard = compRank (componentRoots (rootCharHom a) i) *
        (compRank (componentRoots (rootCharHom a) i) + 1))
    (hQS : CFSG.IsQuasisimple (rationalComponent S.ρ S.Γ (rootCharHom a) i)) :
    ∃ ν f, 2 ≤ ν ∧ 1 ≤ f ∧ ringChar L ^ f =
        S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) ∧
      (StatedClassicalModel (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
          Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i))
          .PSL ν (ringChar L) f ∨
        StatedClassicalModel (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
          Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i))
          .PSU ν (ringChar L) f) := by
  rcases typeA_frame_cases S hp hT hap h1 i hA with ⟨hr1, hn⟩ | h | h
  · obtain ⟨f, hf1, hfeq, hmodel⟩ :=
      rationalComponent_rankOne_model S hT i hr1 hn hQS
    exact ⟨2, f, le_rfl, hf1, hfeq, Or.inl hmodel⟩
  · obtain ⟨ν, ψ, σ, π, hν, hψ, hΨ, hπ⟩ := h
    obtain ⟨f, hf1, hfeq, hmodel⟩ :=
      rationalComponent_splitFrame_model S hT i hν hψ hΨ π hπ
    exact ⟨ν, f, by omega, hf1, hfeq, Or.inl hmodel⟩
  · obtain ⟨ν, ψ, σ, π, hν, hψ, hΨ, hπ⟩ := h
    obtain ⟨f, hf1, hfeq, hmodel⟩ :=
      rationalComponent_unitaryFrame_model S hT i hν hψ hΨ π hπ hQS
    exact ⟨ν, f, by omega, hf1, hfeq, Or.inr hmodel⟩

end Components

end CFSG.LocalAnalysis.GLTheoremA.RationalModel
