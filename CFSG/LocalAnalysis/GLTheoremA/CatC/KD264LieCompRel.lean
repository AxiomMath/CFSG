@[expose] def IdxOver (ℓ Q : ℕ) : TauCeti.CFSGIndex → Prop
  | .lie e =>
      (e.1.characteristic = ℓ ∧ fieldSize e.1 = Q ∧ ¬ suzRee e.1) ∨
      (ℓ = 2 ∧ Q = 2 ∧ ((∃ q : TauCeti.PrimePower, e.1 = .A 1 q ∧ q.card = 7) ∨
        (∃ q : TauCeti.PrimePower, e.1 = .twistedA 2 q ∧ q.card = 3))) ∨
      (ℓ = 3 ∧ Q = 3 ∧ ∃ q : TauCeti.PrimePower, e.1 = .twistedA 3 q ∧ q.card = 2)
  | .alternating n _ =>
      (n = 5 ∧ ((ℓ = 2 ∧ Q = 4) ∨ (ℓ = 5 ∧ Q = 5))) ∨
      (n = 6 ∧ ((ℓ = 2 ∧ Q = 2) ∨ (ℓ = 3 ∧ Q = 9))) ∨
      (n = 8 ∧ ℓ = 2 ∧ Q = 2)
  | _ => False

@[expose] def CatalogueOver (ℓ Q : ℕ) (X : Type*) [Group X] : Prop :=
  ∃ i : TauCeti.CFSGIndex, Nonempty (X ⧸ Subgroup.center X ≃* i.Group) ∧ IdxOver ℓ Q i

private theorem eq_or_eq_sq_of_pow_eq_prime_sq {x j p : ℕ} (hp : p.Prime) (hx : 2 ≤ x)
    (hj : 1 ≤ j) (h : x ^ j = p ^ 2) : x = p ∨ x = p ^ 2 := by
  have hdvd : x ∣ p ^ 2 := h ▸ dvd_pow_self x (by omega : j ≠ 0)
  obtain ⟨k, hk, rfl⟩ := (Nat.dvd_prime_pow hp).1 hdvd
  interval_cases k
  · simp at hx
  · simp
  · simp

theorem compRelC_of_idxOver {d : TauCeti.LieTypeIndex} {i : TauCeti.CFSGIndex} {j : ℕ}
    (hj : 1 ≤ j) (h : IdxOver d.characteristic (fieldSize d ^ j) i) : compRelC d i := by
  cases i with
  | lie e =>
      simp only [IdxOver] at h
      rcases h with ⟨hch, hfs, hsuz⟩ | ⟨-, h2f, h7⟩ | ⟨-, h3f, h7⟩
      · simp only [compRelC, compRel]
        exact Or.inl ⟨hch, ⟨j, hj, hfs⟩, fun hs => absurd hs hsuz⟩
      · have hd2 : fieldSize d = 2 := ((Nat.Prime.pow_eq_iff Nat.prime_two).mp h2f).1
        simp only [compRelC, compRel]
        exact Or.inr (Or.inl ⟨hd2, h7⟩)
      · have hd3 : fieldSize d = 3 := ((Nat.Prime.pow_eq_iff Nat.prime_three).mp h3f).1
        simp only [compRelC, compRel]
        exact Or.inr (Or.inr ⟨hd3, h7⟩)
  | alternating n hn =>
      simp only [IdxOver] at h
      simp only [compRelC]
      rcases h with ⟨rfl, hcase⟩ | ⟨rfl, hcase⟩ | ⟨rfl, -, hq⟩
      · rcases hcase with ⟨-, hq⟩ | ⟨-, hq⟩
        · exact Or.inl ⟨rfl,
            Or.imp id Or.inl (eq_or_eq_sq_of_pow_eq_prime_sq Nat.prime_two
              (two_le_fieldSize d) hj hq)⟩
        · exact Or.inl ⟨rfl, Or.inr (Or.inr ((Nat.Prime.pow_eq_iff Nat.prime_five).mp hq).1)⟩
      · rcases hcase with ⟨-, hq⟩ | ⟨-, hq⟩
        · exact Or.inr (Or.inl ⟨rfl, Or.inl ((Nat.Prime.pow_eq_iff Nat.prime_two).mp hq).1⟩)
        · exact Or.inr (Or.inl ⟨rfl, Or.inr
            (eq_or_eq_sq_of_pow_eq_prime_sq Nat.prime_three (two_le_fieldSize d) hj hq)⟩)
      · exact Or.inr (Or.inr ⟨rfl, ((Nat.Prime.pow_eq_iff Nat.prime_two).mp hq).1⟩)
  | cyclic p hp => simp only [IdxOver] at h
  | sporadic s => simp only [IdxOver] at h

theorem CatalogueOver.of_mulEquiv {ℓ Q : ℕ} {X Y : Type*} [Group X] [Group Y]
    (h : CatalogueOver ℓ Q X) (e : X ≃* Y) : CatalogueOver ℓ Q Y := by
  obtain ⟨i, ⟨f⟩, hi⟩ := h
  refine ⟨i, ⟨(QuotientGroup.congr (Subgroup.center X) (Subgroup.center Y) e
    (Subgroup.map_center_eq e)).symm.trans f⟩, hi⟩

theorem CatalogueOver.of_surjective {ℓ Q : ℕ} {X Y : Type*} [Group X] [Group Y]
    (h : CatalogueOver ℓ Q X) (hX : commutator X = ⊤) (f : X →* Y)
    (hf : Function.Surjective f) (hk : f.ker ≤ Subgroup.center X) : CatalogueOver ℓ Q Y := by
  obtain ⟨i, ⟨e⟩, hi⟩ := h
  obtain ⟨g⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieComp.nonempty_centralQuotient_mulEquiv hX f hf hk
  exact ⟨i, ⟨g.symm.trans e⟩, hi⟩

private theorem catalogueOver_sl_duplicate (E : Type) [Field E] [Fintype E] (m : ℕ)
    (q : TauCeti.PrimePower) (hqc : q.card = Fintype.card E)
    (π : Matrix.SpecialLinearGroup (Fin m) E ⧸
        Subgroup.center (Matrix.SpecialLinearGroup (Fin m) E) ≃*
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL m E)
    (hdup : (TauCeti.LieTypeIndex.A (m - 1) q).IsDuplicateRepresentative) :
    CatalogueOver (ringChar E) (Fintype.card E) (Matrix.SpecialLinearGroup (Fin m) E) := by
  rw [TauCeti.LieTypeIndex.isDuplicateRepresentative_iff] at hdup
  rcases hdup with ⟨hr, hc | hc | hc⟩ | ⟨hr, hc⟩ | ⟨hr, hc⟩
  ·
    have hm2 : m = 2 := by omega
    subst hm2
    have hE4 : Fintype.card E = 4 := by rw [← hqc, hc]
    have hchar : ringChar E = 2 :=
      ringChar.eq_iff.2 (charP_of_card_eq_prime_pow (hp := ⟨Nat.prime_two⟩) (f := 2)
        (by rw [hE4]; norm_num))
    have h55 : 5 ≤ 5 := by norm_num
    obtain ⟨e⟩ :=
      CFSG.Adapters.CatalogueFieldBridges.nonempty_psl2_mulEquiv_alternating_five (k := E)
        (Or.inl (by rw [Nat.card_eq_fintype_card]; exact hE4))
    refine ⟨.alternating 5 h55, ⟨π.trans
      ((CFSG.LocalAnalysis.ComponentInitial.LinearCover.projectiveSpecialLinearEquivProjectiveSL
        2 E).symm.trans e)⟩, ?_⟩
    exact Or.inl ⟨rfl, Or.inl ⟨hchar, hE4⟩⟩
  ·
    have hm2 : m = 2 := by omega
    subst hm2
    have hE5 : Fintype.card E = 5 := by rw [← hqc, hc]
    have hchar : ringChar E = 5 :=
      ringChar.eq_iff.2 (charP_of_card_eq_prime_pow (hp := ⟨Nat.prime_five⟩) (f := 1)
        (by rw [hE5]; norm_num))
    have h55 : 5 ≤ 5 := by norm_num
    obtain ⟨e⟩ :=
      CFSG.Adapters.CatalogueFieldBridges.nonempty_psl2_mulEquiv_alternating_five (k := E)
        (Or.inr (by rw [Nat.card_eq_fintype_card]; exact hE5))
    refine ⟨.alternating 5 h55, ⟨π.trans
      ((CFSG.LocalAnalysis.ComponentInitial.LinearCover.projectiveSpecialLinearEquivProjectiveSL
        2 E).symm.trans e)⟩, ?_⟩
    exact Or.inl ⟨rfl, Or.inr ⟨hchar, hE5⟩⟩
  ·
    have hm2 : m = 2 := by omega
    subst hm2
    have hE9 : Fintype.card E = 9 := by rw [← hqc, hc]
    have hchar : ringChar E = 3 :=
      ringChar.eq_iff.2 (charP_of_card_eq_prime_pow (hp := ⟨Nat.prime_three⟩) (f := 2)
        (by rw [hE9]; norm_num))
    have h56 : 5 ≤ 6 := by norm_num
    obtain ⟨e⟩ :=
      CFSG.Adapters.CatalogueFieldBridges.nonempty_psl2_nine_mulEquiv_alternating_six (k := E)
        (by rw [Nat.card_eq_fintype_card]; exact hE9)
    refine ⟨.alternating 6 h56, ⟨π.trans
      ((CFSG.LocalAnalysis.ComponentInitial.LinearCover.projectiveSpecialLinearEquivProjectiveSL
        2 E).symm.trans e)⟩, ?_⟩
    exact Or.inr (Or.inl ⟨rfl, Or.inr ⟨hchar, hE9⟩⟩)
  ·
    have hm3 : m = 3 := by omega
    subst hm3
    have hE2 : Fintype.card E = 2 := by rw [← hqc, hc]
    have hchar : ringChar E = 2 :=
      ringChar.eq_iff.2 (charP_of_card_eq_prime_pow (hp := ⟨Nat.prime_two⟩) (f := 1)
        (by rw [hE2]; norm_num))
    obtain ⟨q', hv, hq'card, ⟨e⟩⟩ :=
      CFSG.Adapters.CatalogueFieldBridges.nonempty_projectiveSL_three_mulEquiv_catalogue
        (k := E) (by rw [Nat.card_eq_fintype_card]; exact hE2)
    refine ⟨.lie ⟨.A 1 q', hv⟩, ⟨π.trans e⟩, Or.inr (Or.inl ⟨hchar, hE2, ?_⟩)⟩
    exact Or.inl ⟨q', rfl, hq'card⟩
  ·
    have hm4 : m = 4 := by omega
    subst hm4
    have hE2 : Fintype.card E = 2 := by rw [← hqc, hc]
    have hchar : ringChar E = 2 :=
      ringChar.eq_iff.2 (charP_of_card_eq_prime_pow (hp := ⟨Nat.prime_two⟩) (f := 1)
        (by rw [hE2]; norm_num))
    have h58 : 5 ≤ 8 := by norm_num
    obtain ⟨e⟩ :=
      CFSG.Adapters.CatalogueFieldBridges.nonempty_projectiveSL_four_mulEquiv_alternating_eight
        (k := E) (by rw [Nat.card_eq_fintype_card]; exact hE2)
    exact ⟨.alternating 8 h58, ⟨π.trans e⟩,
      Or.inr (Or.inr ⟨rfl, hchar, hE2⟩)⟩

theorem catalogueOver_sl (E : Type) [Field E] [Fintype E] (m : ℕ) (hm : 2 ≤ m)
    (h4 : m = 2 → 4 ≤ Fintype.card E) :
    CatalogueOver (ringChar E) (Fintype.card E) (Matrix.SpecialLinearGroup (Fin m) E) := by
  classical
  haveI := ringChar.charP E
  obtain ⟨n, hp, hcard⟩ := FiniteField.card E (ringChar E)
  have hn : 0 < (n : ℕ) := n.pos
  let q : TauCeti.PrimePower := ⟨ringChar E, n, hp, hn⟩
  have hqc : q.card = Fintype.card E := by
    simp only [q, TauCeti.PrimePower.card_def]
    exact hcard.symm
  have hnk : Nat.card E = q.card := by rw [Nat.card_eq_fintype_card, hqc]
  let π : Matrix.SpecialLinearGroup (Fin m) E ⧸
        Subgroup.center (Matrix.SpecialLinearGroup (Fin m) E) ≃*
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL m E :=
    CFSG.LocalAnalysis.ComponentInitial.LinearCover.projectiveSpecialLinearEquivProjectiveSL m E
  have hrange : (TauCeti.LieTypeIndex.A (m - 1) q).InStandardRange := by
    rw [TauCeti.LieTypeIndex.inStandardRange_iff]
    refine ⟨by omega, fun hr => ?_⟩
    have hm2 : m = 2 := by omega
    rw [hqc]
    exact h4 hm2
  by_cases hdup : (TauCeti.LieTypeIndex.A (m - 1) q).IsDuplicateRepresentative
  · exact catalogueOver_sl_duplicate E m q hqc π hdup
  · have hv : (TauCeti.LieTypeIndex.A (m - 1) q).Valid := by
      rw [TauCeti.LieTypeIndex.valid_iff]
      exact ⟨hrange, hdup⟩
    obtain ⟨e⟩ := CFSG.Adapters.CatalogueFieldBridges.nonempty_projectiveSL_mulEquiv_lie
      (n := m - 1) q hv hnk
    rw [Nat.sub_add_cancel (by omega : 1 ≤ m)] at e
    refine ⟨.lie ⟨.A (m - 1) q, hv⟩, ⟨π.trans e⟩, Or.inl ⟨?_, ?_, ?_⟩⟩
    · exact TauCeti.LieTypeIndex.characteristic_A (m - 1) q
    · simp only [fieldSize]
      exact hqc
    · simp [suzRee]

theorem catalogueOver_su (K : Type) [Field K] [Fintype K] (m q : ℕ) (hK : Fintype.card K = q ^ 2)
    (hm : 3 ≤ m) (hne : (m, q) ≠ (3, 2)) :
    CatalogueOver (ringChar K) q ↥(StatedSU m q K) := by
  obtain ⟨q', hv, hq'p, hq'card, ⟨e⟩⟩ :=
    CFSG.Adapters.CatalogueFieldBridges.exists_twistedA_mulEquiv_centerQuotient_statedSU
      hK hm hne
  refine ⟨.lie ⟨.twistedA (m - 1) q', hv⟩, ⟨e⟩, Or.inl ⟨?_, ?_, ?_⟩⟩
  · rw [TauCeti.LieTypeIndex.characteristic_twistedA, hq'p]
  · simpa only [fieldSize] using hq'card
  · simp [suzRee]

theorem catalogueOver_of_surjective_sl {E : Type} [Field E] [Fintype E] {m : ℕ} (hm : 2 ≤ m)
    (h4 : m = 2 → 4 ≤ Fintype.card E) {X : Type*} [Group X]
    (g : Matrix.SpecialLinearGroup (Fin m) E →* X) (hg : Function.Surjective g)
    (hker : g.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin m) E)) :
    CatalogueOver (ringChar E) (Fintype.card E) X :=
  (catalogueOver_sl E m hm h4).of_surjective
    (CFSG.HardMathSupport.Solomon.Coordinator.LieComp.slFactorFacts_holds E m hm h4).perfect
    g hg hker

theorem catalogueOver_of_surjective_su {K : Type} [Field K] [Fintype K] {m q : ℕ}
    (hK : Fintype.card K = q ^ 2) (hm : 3 ≤ m) (hne : (m, q) ≠ (3, 2)) {X : Type*} [Group X]
    (g : ↥(StatedSU m q K) →* X) (hg : Function.Surjective g)
    (hker : g.ker ≤ Subgroup.center ↥(StatedSU m q K)) : CatalogueOver (ringChar K) q X :=
  (catalogueOver_su K m q hK hm hne).of_surjective
    (CFSG.HardMathSupport.Solomon.Coordinator.LieComp.suFactorFacts_holds K m q hK hm hne).perfect
    g hg hker

theorem catalogueOver_sp (E : Type) [Field E] [Fintype E] (m : ℕ) (hm : 2 ≤ m)
    (hne : (m, Fintype.card E) ≠ (2, 2)) :
    CatalogueOver (ringChar E) (Fintype.card E) ↥(StatedSp m E) := by
  classical
  haveI := ringChar.charP E
  obtain ⟨n, hp, hcard⟩ := FiniteField.card E (ringChar E)
  have hn : 0 < (n : ℕ) := n.pos
  let q : TauCeti.PrimePower := ⟨ringChar E, n, hp, hn⟩
  have hqc : q.card = Fintype.card E := by
    simp only [q, TauCeti.PrimePower.card_def]
    exact hcard.symm
  have hnk : Nat.card E = q.card := by rw [Nat.card_eq_fintype_card, hqc]
  let π := CFSG.LieType.Universal.Symplectic.centerQuotientEquiv m E
  rcases (show m = 2 ∨ 3 ≤ m by omega) with hm2 | hm3
  · subst hm2
    by_cases h3 : Fintype.card E = 3
    ·
      have hk3 : Nat.card E = 3 := by rw [Nat.card_eq_fintype_card]; exact h3
      have hchar : ringChar E = 3 :=
        ringChar.eq_iff.2 (charP_of_card_eq_prime_pow (hp := ⟨Nat.prime_three⟩) (f := 1)
          (by rw [h3]; norm_num))
      obtain ⟨e⟩ := CFSG.Adapters.CatalogueFieldBridges.nonempty_mulEquiv_lie_u42 hk3
      refine ⟨.lie CFSG.Adapters.CatalogueFieldBridges.u42Index, ⟨π.trans e⟩,
        Or.inr (Or.inr ⟨hchar, h3, ?_⟩)⟩
      exact ⟨CFSG.Adapters.CatalogueFieldBridges.u42q, rfl,
        by simp [CFSG.Adapters.CatalogueFieldBridges.u42q, TauCeti.PrimePower.card_def]⟩
    · have hq2 : q.card ≠ 2 := by
        rw [hqc]
        exact fun h => hne (by rw [h])
      have hq3 : q.card ≠ 3 := by rw [hqc]; omega
      have hv : (TauCeti.LieTypeIndex.B 2 q).Valid := by
        rw [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
          TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
        exact ⟨⟨le_rfl, fun h => hq2 h.2⟩, fun h => hq3 h.2⟩
      obtain ⟨e⟩ :=
        CFSG.Adapters.CatalogueFieldBridges.nonempty_mulEquiv_lie_B2_of_statedProj hv hnk
      refine ⟨.lie ⟨.B 2 q, hv⟩, ⟨π.trans e⟩, Or.inl ⟨?_, ?_, ?_⟩⟩
      · exact TauCeti.LieTypeIndex.characteristic_B 2 q
      · simp only [fieldSize]
        exact hqc
      · simp [suzRee]
  · by_cases h2 : ringChar E = 2
    · have hv : (TauCeti.LieTypeIndex.B m q).Valid := by
        rw [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
          TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
        exact ⟨⟨by omega, by omega⟩, by omega⟩
      obtain ⟨e⟩ :=
        CFSG.Adapters.CatalogueFieldBridges.nonempty_mulEquiv_lie_B_of_statedProj hv
          (by simpa [q] using h2) hm3 hnk
      refine ⟨.lie ⟨.B m q, hv⟩, ⟨π.trans e⟩, Or.inl ⟨?_, ?_, ?_⟩⟩
      · exact TauCeti.LieTypeIndex.characteristic_B m q
      · simp only [fieldSize]
        exact hqc
      · simp [suzRee]
    · have hv : (TauCeti.LieTypeIndex.C m q).Valid := by
        rw [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
          TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
        exact ⟨⟨hm3, by simpa [q] using h2⟩, by simp⟩
      obtain ⟨e⟩ :=
        CFSG.Adapters.CatalogueFieldBridges.nonempty_mulEquiv_lie_C_of_statedProj hv hnk
      refine ⟨.lie ⟨.C m q, hv⟩, ⟨π.trans e⟩, Or.inl ⟨?_, ?_, ?_⟩⟩
      · exact TauCeti.LieTypeIndex.characteristic_C m q
      · simp only [fieldSize]
        exact hqc
      · simp [suzRee]

theorem catalogueOver_sp_four_two (E : Type) [Field E] [Fintype E] (hE : Fintype.card E = 2) :
    CatalogueOver 2 2 ↥(commutator ↥(StatedSp 2 E)) := by
  have hk : Nat.card E = 2 := by rw [Nat.card_eq_fintype_card]; exact hE
  obtain ⟨e⟩ :=
    CFSG.Adapters.CatalogueFieldBridges.nonempty_commutator_statedSp_two_mulEquiv_alternating_six
      hk
  refine ⟨.alternating 6 (by norm_num), ⟨(QuotientGroup.congr (Subgroup.center _)
    (Subgroup.center (alternatingGroup (Fin 6))) e (Subgroup.map_center_eq e)).trans ?_⟩, ?_⟩
  · exact (QuotientGroup.quotientMulEquivOfEq
      (alternatingGroup.center_eq_bot (by norm_num))).trans QuotientGroup.quotientBot
  · exact Or.inr (Or.inl ⟨rfl, Or.inl ⟨rfl, rfl⟩⟩)

