theorem d4_fieldType_big {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2 ^ 3)
    {α : MulAut (adjointGroup Tag.D4 K)} (hα3 : α ^ 3 = 1) (g : adjointGroup Tag.D4 K)
    (a : Fin Tag.D4.rank → Kˣ) (σ : K ≃+* K) (hσ1 : σ ≠ 1) (hσ3 : σ ^ 3 = 1)
    (hαeq : α = MulAut.conj g * exactNormalAut Tag.D4 K a σ 0) :
    ∃ E : Subgroup (adjointGroup Tag.D4 K), E ≤ fixSubgroup α ∧ IsElemAbelian 3 E ∧
      3 ^ 4 ≤ Nat.card E := by
  classical
  have hα3' : (MulAut.conj g * exactNormalAut Tag.D4 K a σ 0) ^ 3 = 1 := by
    rw [← hαeq]
    exact hα3
  obtain ⟨ψ, hψ⟩ :=
    ExcCopy.exists_conj_eq_entrywiseAdjointAut .D4 Nat.prime_three g a σ hσ1 hσ3 hα3'
  rw [← hαeq] at hψ
  have hord : orderOf σ = 3 := orderOf_eq_prime hσ3 hσ1
  have hk : Nat.card (fixSubfield σ) = 2 := by
    obtain ⟨-, hc⟩ := card_fixSubfield Nat.prime_two (f := 3) (by norm_num) hK σ
    rw [hord] at hc
    simpa using hc
  haveI : Finite (fixSubfield σ) := Subtype.finite
  obtain ⟨ι, hιinj, hιfix, -⟩ := ExcCopy.exists_fixed_structure Tag.D4 σ
  obtain ⟨E₀, hE₀, hcard⟩ := bigElem_adjoint_D4_two hk
  refine ⟨(E₀.map ι).map (ψ⁻¹ : MulAut (adjointGroup Tag.D4 K)).toMonoidHom, ?_, ?_, ?_⟩
  · rintro _ ⟨y, ⟨v, hv, rfl⟩, rfl⟩
    have hy : entrywiseAdjointAut Tag.D4 σ (ι v) = ι v := mem_fixSubgroup.1 (hιfix ⟨v, rfl⟩)
    rw [mem_fixSubgroup]
    have h1 : (ψ * α * ψ⁻¹) (ι v) = ι v := by rw [hψ]; exact hy
    have h2 : ψ (α (ψ⁻¹ (ι v))) = ι v := by
      simpa [MulAut.mul_apply] using h1
    show α (ψ⁻¹ (ι v)) = ψ⁻¹ (ι v)
    apply ψ.injective
    rw [h2, MulAut.apply_inv_self]
  · exact isElemAbelian_map_gen _ (isElemAbelian_map_gen ι hE₀)
  · rw [Subgroup.card_map_of_injective (ψ⁻¹ : MulAut (adjointGroup Tag.D4 K)).injective,
      Subgroup.card_map_of_injective hιinj]
    exact hcard

theorem d4_graphField_model {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2 ^ 3)
    {α : MulAut (adjointGroup Tag.D4 K)} (hα3 : α ^ 3 = 1) (g : adjointGroup Tag.D4 K)
    (a : Fin Tag.D4.rank → Kˣ) (σ : K ≃+* K) (hσ1 : σ ≠ 1) (hσ3 : σ ^ 3 = 1) {ε : ℕ}
    (hε : ε = 1 ∨ ε = 2)
    (hαeq : α = MulAut.conj g * (exactNormalAut Tag.D4 K a σ 0 * d4Graph K ε)) :
    LieModel ↥(fixSubgroup α) .trialityD4 0 2 1 := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hchar : ringChar K = 2 := ringChar_eq_of_card_eq_pow Nat.prime_two (by norm_num) hK
  haveI : CharP K 2 := hchar ▸ ringChar.charP K
  have hord : orderOf σ = 3 := orderOf_eq_prime hσ3 hσ1
  have hK4 : 4 ≤ Nat.card K := by rw [hK]; norm_num
  obtain ⟨e, T, he, hef, hT, hσT⟩ :=
    exists_frobenius_eq_or_inv_of_orderOf_three Nat.prime_two (f := 3) (by norm_num) K hK σ hord
  have he1 : e = 1 := by omega
  subst he1
  have hK' : Nat.card K = (2 ^ 1) ^ 3 := by rw [hK]; norm_num
  have hj : ∀ j : ℤ, (j = (ε : ℤ) ∨ j = -(ε : ℤ)) → j % 3 = 1 ∨ j % 3 = 2 := by
    intro j hj'
    rcases hε with rfl | rfl <;> rcases hj' with rfl | rfl <;> norm_num
  have hmodel : ∀ {G : Type} [Group G], G ≃* ↥(graphFixedRootGroup TwistTag.D4 K T.toRingHom) →
      LieModel G .trialityD4 0 2 1 := fun e =>
    Or.inr (Or.inl ⟨rfl, by decide,
      CFSG.HardMathSupport.Dickson.Sec6.chevalleyExceptionalModel_trialityD4_of_equiv
        Nat.prime_two he hK' T hT e⟩)
  rcases hσT with hσT | hσT
  · have hαT : α = MulAut.conj g * (exactNormalAut Tag.D4 K a T 0 * d4Graph K ε) := by
      rw [hαeq, hσT]
    obtain ⟨ψ, hψ⟩ :=
      exists_conj_eq_twistedEntrywiseAut_of_normalForm K hK hK4 he hef T hT α hα3 g a ε hαT
    obtain ⟨eT⟩ := exists_fixedSubgroup_twistedEntrywiseAut_D4_equiv_graphFixed Nat.prime_two he
      hK' T hT (ε : ℤ) (hj _ (Or.inl rfl))
    let e' : ↥(fixSubgroup α) ≃*
        ↥(fixedSubgroup (twistedEntrywiseAut TwistTag.D4 (ε : ℤ) T)) :=
      (fixSubgroupConjEquiv ψ α).trans (MulEquiv.subgroupCongr (by rw [hψ]; rfl))
    exact hmodel (e'.trans eT)
  · have hαT : α = MulAut.conj g * (exactNormalAut Tag.D4 K a T⁻¹ 0 * d4Graph K ε) := by
      rw [hαeq, hσT]
    obtain ⟨ψ, hψ⟩ := exists_conj_inv_eq_twistedEntrywiseAut_of_normalForm K hK hK4 he hef T T⁻¹
      hT (mul_inv_cancel T) α hα3 g a ε hαT
    obtain ⟨eT⟩ := exists_fixedSubgroup_twistedEntrywiseAut_D4_equiv_graphFixed Nat.prime_two he
      hK' T hT (-(ε : ℤ)) (hj _ (Or.inr rfl))
    let e' : ↥(fixSubgroup α) ≃*
        ↥(fixedSubgroup (twistedEntrywiseAut TwistTag.D4 (-(ε : ℤ)) T)) :=
      (MulEquiv.subgroupCongr (fixSubgroup_inv_eq α)).symm.trans
        ((fixSubgroupConjEquiv ψ α⁻¹).trans (MulEquiv.subgroupCongr (by rw [hψ]; rfl)))
    exact hmodel (e'.trans eT)

theorem d4_outer_dichotomy {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2 ^ 3)
    {α : MulAut (adjointGroup Tag.D4 K)} (hα3 : α ^ 3 = 1)
    (hαout : α ∉ innAutDerived (adjointGroup Tag.D4 K)) :
    (∃ E : Subgroup (adjointGroup Tag.D4 K), E ≤ fixSubgroup α ∧ IsElemAbelian 3 E ∧
      3 ^ 4 ≤ Nat.card E) ∨ LieModel ↥(fixSubgroup α) .trialityD4 0 2 1 := by
  classical
  have hK3 : ringChar K ≠ 3 := by
    rw [ringChar_eq_of_card_eq_pow Nat.prime_two (by norm_num) hK]
    norm_num
  obtain ⟨g, a, σ, ε, hε3, hσ3, hαeq⟩ := exists_cube_normal_form_sigma α hα3
  interval_cases ε
  · have hα0 : α = MulAut.conj g * exactNormalAut Tag.D4 K a σ 0 := by
      rw [hαeq, d4Graph_zero, mul_one]
    by_cases hσ1 : σ = 1
    · exfalso
      subst hσ1
      rw [hα0] at hα3 hαout
      obtain ⟨h, hh⟩ := d4_inner_of_diag hK3 g a hα3
      exact hαout (hh ▸ (inner_le_innAutDerived _ ⟨h, rfl⟩))
    · exact Or.inl (d4_fieldType_big hK hα3 g a σ hσ1 hσ3 hα0)
  · by_cases hσ1 : σ = 1
    · exfalso
      subst hσ1
      exact hαout (hαeq ▸ mem_innAutDerived_of_graphType g a (Or.inl rfl) (by rw [← hαeq]; exact hα3))
    · exact Or.inr (d4_graphField_model hK hα3 g a σ hσ1 hσ3 (Or.inl rfl) hαeq)
  · by_cases hσ1 : σ = 1
    · exfalso
      subst hσ1
      exact hαout (hαeq ▸ mem_innAutDerived_of_graphType g a (Or.inr rfl) (by rw [← hαeq]; exact hα3))
    · exact Or.inr (d4_graphField_model hK hα3 g a σ hσ1 hσ3 (Or.inr rfl) hαeq)

