theorem lieOuterThreeAt_d4_of_cases (h : D4ThreeOuterCases) :
    LieOuterThreeAt CFSG.HardMathSupport.Dickson.Sec6.I923.FamD4 := by
  intro P _ _ t n f hadm hF hm ψ hψ3 hψ
  obtain ⟨rfl, rfl⟩ := hF
  obtain ⟨⟨-, hf, -⟩, K, _, _, hK, ⟨e⟩⟩ :=
    (CFSG.Blueprint.LieModel.classical_iff (by decide)).mp hm
  obtain ⟨e'⟩ :=
    CFSG.HardMathSupport.Lang.Coordinator.D4Bridge.nonempty_statedProj_equiv_adjointGroup K
  let E : P ≃* adjointGroup Tag.D4 K := e.trans e'
  refine outerSubThree_congr E ?_
  have hα3 : MulAut.congr E ψ ^ 3 = 1 := by rw [← map_pow, hψ3, map_one]
  have hα : MulAut.congr E ψ ∉ inner ↥(adjointGroup Tag.D4 K) := fun hin =>
    hψ ((CFSG.HardMathSupport.Dickson.Sec6.I923.congr_mem_inner_iff_of_equiv E ψ).mp hin)
  rcases h hK hf _ hα3 hα with ⟨d, T, δ, hdf, hT, hδ⟩ | hcomp
  · obtain rfl : f = 3 * d := by omega
    have hd : 1 ≤ d := by omega
    have hTc : Nat.card ↥(fixSubfield T) = 3 ^ d :=
      CFSG.RankThree.PartOne.KGD.card_fixSubfield_cube Nat.prime_three hd
        (by rw [hK, ← pow_mul, mul_comm]) T hT
    haveI : Finite ↥(fixSubfield T) := Subtype.finite
    have hfield : OuterSubThree .POmegaPlus 4 (3 * d)
        (fixSubgroup (entrywiseAdjointAut Tag.D4 T)) :=
      outerSubThree_entrywise_of_model T (by decide)
        (CFSG.HardMathSupport.Dickson.Sec6.I923.D4Aux.lieModel_adjointD4 Nat.prime_three hd _ hTc)
        (CFSG.HardMathSupport.Dickson.Sec6.I923.D4Aux.isSimple_adjointD4 _).1
    rcases hδ with hδ | hδ
    · refine outerSubThree_of_conj δ _ ?_
      rwa [hδ]
    · refine outerSubThree_of_conj_pow (r := 2) (j := 2) ?_ hδ hfield
      rw [← pow_mul, show 2 * 2 = 3 + 1 from rfl, pow_succ, hα3, one_mul]
  · intro A hA
    rcases hcomp A hA with hG | ⟨f', hf', hT⟩
    · exact Or.inl ⟨.G2, 0, f, Or.inr (Or.inl ⟨rfl, rfl, rfl, rfl, rfl⟩), hG⟩
    · exact Or.inl ⟨.trialityD4, 0, f', Or.inr (Or.inr (Or.inl ⟨rfl, rfl, rfl, rfl, hf'⟩)), hT⟩

end CFSG.LocalAnalysis.GLTheoremA.H1420

