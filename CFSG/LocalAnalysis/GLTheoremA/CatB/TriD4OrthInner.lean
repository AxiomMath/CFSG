private theorem fixSubgroup_conj {X : Type} [Group X] (a : X) :
    fixSubgroup (MulAut.conj a) = Subgroup.centralizer ({a} : Set X) := by
  ext g
  rw [mem_fixSubgroup, MulAut.conj_apply, mul_inv_eq_iff_eq_mul,
    Subgroup.mem_centralizer_singleton_iff]
  exact ⟨fun h => h.symm, fun h => h.symm⟩

private theorem exists_projOrth_model_gf2 {t : StatedLieTag}
    (ht : t = .POmegaPlus ∨ t = .POmegaMinus) {S : Type} [Group S] {n : ℕ}
    (hG : StatedClassicalModel S t n 2 1) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (V : Type) (_ : AddCommGroup V) (_ : Module K V)
      (_ : FiniteDimensional K V) (Q : QuadraticForm K V),
      (polarBilin Q).Nondegenerate ∧ Nat.card K = 2 ∧ Nonempty (S ≃* ProjOrthDerived Q) := by
  rcases ht with rfl | rfl
  · obtain ⟨hadm, K, hKf, hKfin, hcard, ⟨e⟩⟩ := hG
    have h4 : 4 ≤ n := hadm.2.2
    exact ⟨K, hKf, hKfin, _, inferInstance, inferInstance, inferInstance, _,
      (CFSG.ClassicalGroups.Orthogonal.regular_quadPlus (K := K) (n := n) (by omega)).1,
      hcard.trans (pow_one 2),
      ⟨e.trans (statedProjOrthEquiv (CFSG.LieType.Universal.Spin.coe_quadPlus (n := n) (K := K)))⟩⟩
  · obtain ⟨hadm, K, hKf, hKfin, hcard, b, c, hirr, ⟨e⟩⟩ := hG
    exact ⟨K, hKf, hKfin, _, inferInstance, inferInstance, inferInstance, _,
      (CFSG.ClassicalGroups.Orthogonal.regular_quadMinus (K := K) (n := n) hadm.2.2 hirr).1,
      hcard.trans (pow_one 2),
      ⟨e.trans (statedProjOrthEquiv (CFSG.LieType.Universal.Spin.coe_quadMinus n K b c))⟩⟩

theorem exists_conj_of_inner_omega_two {t : StatedLieTag}
    (ht : t = .POmegaPlus ∨ t = .POmegaMinus) {S : Type} [Group S] [Finite S] {n : ℕ}
    (hG : StatedClassicalModel S t n 2 1) {a b : S} (ha3 : a ^ 3 = 1) (ha1 : a ≠ 1)
    (hb3 : b ^ 3 = 1) (hab : a * b = b * a) {J : Subgroup S}
    (hJ : GLAPComponent 3 (fixSubgroup (MulAut.conj a)) J)
    (hT : catalogIs (PSimple 3 J) S9.isD4two) :
    ∃ j ∈ J, ∀ y ∈ J, b * y * b⁻¹ = j * y * j⁻¹ := by
  classical
  have hlayer := CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.perfectInLayer_conj_omega
    (Or.inr ht) hG Nat.prime_three (by norm_num) (by norm_num) a ha3
  have hcomp := (glaPComponent_isComponent_of_le_layer hJ
    (hlayer J hJ.1 (glaPComponent_perfect hJ))).1
  rw [fixSubgroup_conj] at hcomp
  have hcardJ : Nat.card (↥J ⧸ Subgroup.center ↥J) = ordD 4 2 := by
    rw [Nat.card_congr (S171.chevIso' Nat.prime_three hJ hcomp.2.2).toEquiv,
      (CFSG.Timmesfeld.card_statedClassicalModel_two (D4XF.statedModel_of_d4two hT)).2.2.2.1 rfl,
      pow_one]
  obtain ⟨K, _, _, V, _, _, _, Q, hQ, hK, ⟨e⟩⟩ := exists_projOrth_model_gf2 ht hG
  haveI : CharP K 2 := CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic
    Nat.prime_two le_rfl (hK.trans (pow_one 2).symm)
  have : Nontrivial V := by
    by_contra hV
    rw [not_nontrivial_iff_subsingleton] at hV
    haveI := hV
    refine ha1 (e.injective ?_)
    obtain ⟨g, hg⟩ := piOrth_surjective (Q := Q) (e a)
    have hg1 : g = 1 := Subtype.ext (LinearEquiv.ext fun _ => Subsingleton.elim _ _)
    rw [← hg, hg1, map_one, map_one]
  obtain ⟨x, hx⟩ := piOrth_surjective (Q := Q) (e a)
  obtain ⟨y, hy⟩ := piOrth_surjective (Q := Q) (e b)
  have hρ : Function.Injective (piOrth Q) := piOrth_injective hQ
  have hx3 : orderOf x = 3 := by
    rw [← orderOf_injective (piOrth Q) hρ x, hx, MulEquiv.orderOf_eq]
    exact orderOf_eq_prime ha3 ha1
  have hy3 : y ^ 3 = 1 := hρ (by rw [map_pow, hy, ← map_pow, hb3, map_one, map_one])
  have hxy : Commute x y := commute_of_piOrth_commute hQ (by
    rw [hx, hy]
    show e a * e b = e b * e a
    rw [← map_mul, ← map_mul, hab])
  have hcen : (Subgroup.centralizer ({a} : Set S)).map (e : S →* ProjOrthDerived Q) =
      Subgroup.centralizer ({piOrth Q x} : Set (ProjOrthDerived Q)) := by
    rw [hx]
    exact map_centralizer_singleton_mulEquiv_good e a
  have hL := CFSG.SignalizerFunctorTheorem.TransportA.isComponentOf_map e hcomp
  rw [hcen] at hL
  let φ : ↥J ≃* ↥(J.map (e : S →* ProjOrthDerived Q)) := J.equivMapOfInjective _ e.injective
  have hcardL : Nat.card (↥(J.map (e : S →* ProjOrthDerived Q)) ⧸
      Subgroup.center ↥(J.map (e : S →* ProjOrthDerived Q))) = ordD 4 2 := by
    rw [← hcardJ]
    exact Nat.card_congr (QuotientGroup.congr _ _ φ (Subgroup.map_center_eq φ)).toEquiv.symm
  obtain ⟨hW8, hLW⟩ := eq_fixedComponentImage_of_card_two hK hQ x hx3 hL hcardL
  have hpl : (3 : ℕ) ≠ ringChar K := by
    rw [ringChar.eq K 2]
    norm_num
  have hxo := oddOrderIsometry_of_orthDerived Nat.prime_three hpl hQ x hx3
  have hTW := exists_threeSingular_of_dim _ hxo.polarBilin_fixed_nondegenerate (m := 4)
    (by norm_num) (by rw [hW8])
  obtain ⟨j', hj', hconj⟩ := exists_fixedComponentImage_conj hQ hx3 hTW hxy hy3
  rw [← hLW] at hj' hconj
  obtain ⟨j, hj, rfl⟩ := hj'
  refine ⟨j, hj, fun z hz => e.injective ?_⟩
  have h1 := hconj ((e : S →* ProjOrthDerived Q) z) ⟨z, hz, rfl⟩
  simpa only [hy, map_mul, map_inv, MonoidHom.coe_coe] using h1

end CFSG.LocalAnalysis.GLTheoremA.TriD4

