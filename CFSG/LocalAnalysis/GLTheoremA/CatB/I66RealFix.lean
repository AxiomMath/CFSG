namespace CFSG.LocalAnalysis.GLTheoremA.CatB

open MulAction

theorem card_fixedBy_conj {G X : Type*} [Group G] [MulAction G X] (h g : G) :
    Nat.card (fixedBy X (h * g * h⁻¹)) = Nat.card (fixedBy X g) := by
  rw [← smul_fixedBy]
  exact Nat.card_image_of_injective (MulAction.injective h) _

theorem fixedBy_inv' {G X : Type*} [Group G] [MulAction G X] (g : G) :
    fixedBy X g⁻¹ = fixedBy X g := by
  ext x
  simp only [mem_fixedBy]
  constructor
  · intro h
    calc g • x = g • (g⁻¹ • x) := by rw [h]
      _ = x := smul_inv_smul g x
  · intro h
    calc g⁻¹ • x = g⁻¹ • (g • x) := by rw [h]
      _ = x := inv_smul_smul g x

theorem isConj_inv_of_fix_census {G X : Type*} [Group G] [MulAction G X] {ι : Type*} {r : ι → G}
    (hcen : ∀ u : G, orderOf u = 3 → ∃ i, IsConj u (r i))
    (hinj : ∀ i j, Nat.card (fixedBy X (r i)) = Nat.card (fixedBy X (r j)) → i = j)
    {u : G} (hu : orderOf u = 3) : IsConj u u⁻¹ := by
  obtain ⟨i, hi⟩ := hcen u hu
  obtain ⟨j, hj⟩ := hcen u⁻¹ (by rw [orderOf_inv, hu])
  have hfix : ∀ {v w : G}, IsConj v w → Nat.card (fixedBy X v) = Nat.card (fixedBy X w) := by
    intro v w hvw
    obtain ⟨c, rfl⟩ := isConj_iff.1 hvw
    exact (card_fixedBy_conj c v).symm
  have hij : i = j := hinj i j (by
    rw [← hfix hi, ← hfix hj, fixedBy_inv'])
  subst hij
  exact hi.trans hj.symm

end CFSG.LocalAnalysis.GLTheoremA.CatB

namespace CFSG.Sporadic.Th

open MulAction

theorem card_fixedBy_eq_of_rep {G : Type*} [Group G] {n : ℕ} [MulAction G (Fin n)] {T : Native.Table}
    {g : G} (hT : Rep n T g) :
    Nat.card (fixedBy (Fin n) g) = ((List.range n).filter fun i => Native.ap T i == i).length := by
  classical
  have hmem : ∀ x : Fin n, x ∈ fixedBy (Fin n) g ↔ Native.ap T x.val = x.val := by
    intro x
    rw [mem_fixedBy, hT x.val x.2, idx_of_lt g x.2]
    exact ⟨fun h => by rw [h], fun h => Fin.ext h⟩
  rw [← List.toFinset_card_of_nodup ((List.nodup_range).filter _)]
  rw [Nat.card_eq_card_toFinset]
  refine Finset.card_bij (fun x _ => x.val) ?_ ?_ ?_
  · intro x hx
    rw [Set.mem_toFinset] at hx
    simp only [List.mem_toFinset, List.mem_filter, List.mem_range, beq_iff_eq]
    exact ⟨x.2, (hmem x).1 hx⟩
  · intro a _ b _ hab
    exact Fin.ext hab
  · intro i hi
    simp only [List.mem_toFinset, List.mem_filter, List.mem_range, beq_iff_eq] at hi
    refine ⟨⟨i, hi.1⟩, ?_, rfl⟩
    rw [Set.mem_toFinset]
    exact (hmem ⟨i, hi.1⟩).2 hi.2

end CFSG.Sporadic.Th

