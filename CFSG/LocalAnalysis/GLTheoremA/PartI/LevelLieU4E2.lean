@[expose] def GoodCent (c : SU4) : Prop :=
  ∀ I : Subgroup SU4, GLAPComponent 3 (Subgroup.centralizer {c}) I →
    kLevel 3 (PSimple 3 I) ≤ 2

theorem kLevel_le_two_of_isU3eight (X : Type) [Group X] (h : catalogIs X S9.isU3eight) :
    kLevel 3 X ≤ 2 := by
  obtain ⟨i, hi, ⟨e⟩⟩ := h
  cases i with
  | lie d =>
    obtain ⟨ld, hv⟩ := d
    cases ld with
    | twistedA n q =>
      rcases n with _ | _ | _ | n
      · exact hi.elim
      · exact hi.elim
      · obtain ⟨hp, hex⟩ := CFSG.LocalAnalysis.GLTheoremA.primePower_eq_of_card_eq
          Nat.prime_two (s := 3) (by norm_num) hi
        exact CFSG.LocalAnalysis.GLTheoremA.LevelLieU.kLevel_le_two_of_k2 ⟨.lie ⟨.twistedA 2 q, hv⟩,
          ⟨rfl, hp, by rw [hex]; decide, by rw [hex]; norm_num⟩, ⟨e⟩⟩
      · exact hi.elim
    | _ => exact hi.elim
  | _ => exact hi.elim

theorem kLevel_W0_le_two : kLevel 3 (↥W0) ≤ 2 :=
  CFSG.LocalAnalysis.GLTheoremA.LevelLieU.kLevel_le_two_of_k2 catalogIs_W0_k2

theorem three_dvd_card_SU4 : 3 ∣ Nat.card SU4 := by
  rw [card_SU4_eq]
  exact Dvd.dvd.mul_right (dvd_pow_self 3 (by norm_num)) _

theorem not_isMulCommutative_SU4 : ¬ IsMulCommutative SU4 := by
  haveI : IsSimpleGroup SU4 := CFSG.RankThree.PartTwo.Sec4.Item434SmallTwoIVU48.isSimpleGroup_SU4
  intro h
  obtain ⟨a, b, hab⟩ := exists_noncomm_SU4
  exact hab (h.is_comm.comm a b)

theorem not_isMulCommutative_top : ¬ IsMulCommutative (⊤ : Subgroup SU4) := by
  intro h
  apply not_isMulCommutative_SU4
  exact ⟨⟨fun a b => by
    have := h.is_comm.comm ⟨a, Subgroup.mem_top a⟩ ⟨b, Subgroup.mem_top b⟩
    exact congrArg Subtype.val this⟩⟩

theorem goodCent_of_conj (h s : SU4) (hc : GoodCent (h * s * h⁻¹)) : GoodCent s := by
  intro I hI
  have hI' := glaPComponent_conj hI h
  rw [← centralizer_conj_eq] at hI'
  have hk := hc _ hI'
  obtain ⟨e⟩ := CFSG.LocalAnalysis.GLTheoremA.LevelLieU.pSimple_map_equiv 3 (MulAut.conj h) I
  rw [CFSG.LocalAnalysis.GLTheoremA.kLevel_congr 3 e] at hk
  exact hk

theorem goodCent_one (hk : kLevel 3 SU4 ≤ 2) : GoodCent 1 := by
  intro I hI
  have htop : Subgroup.centralizer ({1} : Set SU4) = ⊤ := by
    ext x
    simp [Subgroup.mem_centralizer_singleton_iff]
  rw [htop] at hI
  haveI : IsSimpleGroup SU4 := CFSG.RankThree.PartTwo.Sec4.Item434SmallTwoIVU48.isSimpleGroup_SU4
  have hIt : I = ⊤ := by
    rcases CFSG.Open.IsSubnormal.eq_bot_or_top hI.2.1 with h | h
    · exact absurd h (glaPComponent_ne_bot' hI)
    · exact h
  rw [hIt]
  haveI : IsSimpleGroup (⊤ : Subgroup SU4) := Subgroup.topEquiv.isSimpleGroup
  obtain ⟨e⟩ := pSimple_equiv_of_simple (⊤ : Subgroup SU4) not_isMulCommutative_top
    (by rw [Subgroup.card_top]; exact three_dvd_card_SU4)
  rw [CFSG.LocalAnalysis.GLTheoremA.kLevel_congr 3 e, CFSG.LocalAnalysis.GLTheoremA.kLevel_congr 3 Subgroup.topEquiv]
  exact hk


theorem not_three_dvd_ker_top :
    ¬ 3 ∣ Nat.card ((Subgroup.topEquiv : (⊤ : Subgroup SU4) ≃* SU4).toMonoidHom.ker) := by
  have h : (Subgroup.topEquiv : (⊤ : Subgroup SU4) ≃* SU4).toMonoidHom.ker = ⊥ := by
    rw [MonoidHom.ker_eq_bot_iff]
    exact (Subgroup.topEquiv : (⊤ : Subgroup SU4) ≃* SU4).injective
  rw [h, Subgroup.card_bot]
  norm_num

theorem goodCent_yStd (t : μ3) (ht : (t : Kˣ) ≠ 1) : GoodCent (yStd t) := by
  intro I hI
  obtain ⟨J, hJc, hJl, hJmap, ⟨ε⟩⟩ :=
    layerY (L := (⊤ : Subgroup SU4)) (Subgroup.topEquiv : (⊤ : Subgroup SU4) ≃* SU4).toMonoidHom
      Subgroup.topEquiv.surjective not_three_dvd_ker_top ht (Subgroup.mem_top (yStd t))
      (yStd_pow_three t) rfl
  have hJeq : J = Jblk := by
    rw [← hJmap]
    ext x
    constructor
    · intro hx
      exact ⟨⟨x, Subgroup.mem_top x⟩, Subgroup.mem_subgroupOf.2 hx, rfl⟩
    · rintro ⟨y, hy, rfl⟩
      exact Subgroup.mem_subgroupOf.1 hy
  have hIle : I ≤ J := by
    have hI2 : GLAPComponent 3 (⊤ ⊓ cx (yStd t)) I := by
      rw [top_inf_eq]
      exact hI
    have := le_sSup (s := {L | GLAPComponent 3 (⊤ ⊓ cx (yStd t)) L}) hI2
    rw [← hJl]
    exact this
  have hIC : I ≤ Cstd t := hI.1
  have hIJblk : I ≤ Jblk := fun x hx => by
    rw [← hJeq]
    exact hIle hx
  set Kc := (rho ht).ker with hKc
  have hI'ker : I.subgroupOf (Cstd t) ≤ Kc := by
    intro x hx
    have hxI : (x : SU4) ∈ I := Subgroup.mem_subgroupOf.1 hx
    have hxJ : (x : SU4) ∈ Jblk := hIJblk hxI
    rw [← map_ker_rho ht] at hxJ
    obtain ⟨k, hk, hkx⟩ := Subgroup.mem_map.1 hxJ
    have hkx' : k = x := Subtype.ext hkx
    rw [← hkx']
    exact hk
  have hI'sub : CFSG.Open.IsSubnormal (I.subgroupOf (Cstd t)) ⊤ :=
    CFSG.Open.IsSubnormal.of_mathlib
      ((CFSG.Assembly.isSubnormal_iff_open.2 hI.2.1).subgroupOf)
  have hI'Kc : CFSG.Open.IsSubnormal (I.subgroupOf (Cstd t)) Kc := by
    have h := hI'sub.inf_of_le (le_top : Kc ≤ ⊤)
    rwa [inf_eq_left.2 hI'ker] at h
  have hI'perf : ⁅I.subgroupOf (Cstd t), I.subgroupOf (Cstd t)⁆ = I.subgroupOf (Cstd t) := by
    apply Subgroup.map_injective (f := (Cstd t).subtype) (Cstd t).subtype_injective
    rw [Subgroup.map_commutator, Subgroup.map_subgroupOf_eq_of_le hIC]
    exact glaPComponent_perfect hI
  have hI'ne : I.subgroupOf (Cstd t) ≠ ⊥ := by
    intro h
    apply glaPComponent_ne_bot' hI
    rw [← Subgroup.map_subgroupOf_eq_of_le hIC, h, Subgroup.map_bot]
  have hEq : I.subgroupOf (Cstd t) = Kc :=
    eq_of_perfect_of_subnormal (isQuasisimple_ker ht) hI'Kc hI'perf hI'ne
  have hIJ : I = J := by
    calc I = Subgroup.map (Cstd t).subtype (I.subgroupOf (Cstd t)) :=
          (Subgroup.map_subgroupOf_eq_of_le hIC).symm
      _ = Subgroup.map (Cstd t).subtype Kc := by rw [hEq]
      _ = Jblk := map_ker_rho ht
      _ = J := hJeq.symm
  rw [hIJ]
  exact kLevel_le_two_of_isU3eight _ (catalogIs_psimple_of_pquot ε)


