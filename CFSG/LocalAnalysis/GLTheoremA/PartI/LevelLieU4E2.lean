theorem sl2_center_bot' {F : Type} [Field F] [CharP F 2] :
    Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) F) = ⊥ := by
  rw [eq_bot_iff]
  intro z hz
  obtain ⟨r, hr, hrz⟩ := Matrix.SpecialLinearGroup.mem_center_iff.1 hz
  have hr2 : r ^ 2 = 1 := by simpa using hr
  have h2 : (2 : F) = 0 := CharTwo.two_eq_zero
  have hr1 : r = 1 := by
    have h : (r + 1) ^ 2 = 0 := by linear_combination hr2 + (r + 1) * h2
    have h' : r + 1 = 0 := pow_eq_zero_iff (by norm_num) |>.1 h
    linear_combination h' - h2
  rw [Subgroup.mem_bot]
  apply Subtype.ext
  rw [← hrz, hr1]
  simp

theorem catalogIs_W0_k2 : catalogIs (↥W0) (k2 3) := by
  have hinj := blockEmb_injective (K := K) (p := 2) (f := 3) (by norm_num : 0 + 2 ≤ 4)
  let e1 : ↥W0 ≃* CFSG.ClassicalInvolution.Phan.Su K 2 3 2 := (MonoidHom.ofInjective hinj).symm
  let e2 : CFSG.ClassicalInvolution.Phan.Su K 2 3 2 ≃* Open.StatedSU 2 (2 ^ 3) K :=
    MulEquiv.subgroupCongr (CFSG.LieType.Universal.Unitary.SUid_eq_statedSU (F := K) (p := 2)
      (f := 3) card_K 2)
  obtain ⟨e3⟩ := CFSG.RankThree.SubgroupLists.nonempty_sl2_mulEquiv_statedSU_two (K := K)
    (r := 2) (f := 3) (card_K.trans (by norm_num))
  have hF : Nat.card (CFSG.LieType.Steinberg.fixedSubfield K 2 3) = 2 ^ 3 :=
    CFSG.LieType.Steinberg.card_fixedSubfield card_K
  obtain ⟨Q, _, hQc, ⟨φ⟩⟩ := exists_primePower_card_eq (CFSG.LieType.Steinberg.fixedSubfield K 2 3)
  have hv : (TauCeti.LieTypeIndex.A 1 Q).Valid := by
    rw [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
      TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
    simp only [hQc, hF]
    omega
  have hcen := sl2_center_bot' (F := CFSG.LieType.Steinberg.fixedSubfield K 2 3)
  let psl : Matrix.ProjectiveSpecialLinearGroup (Fin 2) (CFSG.LieType.Steinberg.fixedSubfield K 2 3)
      ≃* Matrix.SpecialLinearGroup (Fin 2) (CFSG.LieType.Steinberg.fixedSubfield K 2 3) :=
    (QuotientGroup.quotientMulEquivOfEq hcen).trans QuotientGroup.quotientBot
  let eW : ↥W0 ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2)
      (CFSG.LieType.Steinberg.fixedSubfield K 2 3) :=
    e1.trans ((e2.trans e3.symm).trans psl.symm)
  refine ⟨.lie ⟨.A 1 Q, hv⟩, ⟨rfl, ?_⟩, ⟨eW.trans ((CFSG.Adapters.RankTwoModelTransports.projectiveSpecialLinearGroupCongr (Fin 2) φ).trans
    (CFSG.ClassicalModels.linearCatalogCandidateEquivPSL 1 Q hv).symm)⟩⟩
  rw [hQc, hF]
  norm_num

