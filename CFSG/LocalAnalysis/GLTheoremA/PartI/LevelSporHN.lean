    (LeafType 5) (fun _ _ => True) (hn5_centShapeRk' hnFiveMoved_holds) ?_
  intro k hk1 hk5 T _ hT hd
  have hko : orderOf k = 5 := orderOf_eq_prime hk5 hk1
  exact kLevel_le_one_of_leafType_five hT hd
    (@not_dvd_card_centralizer_five ↥JH _ hfin fJ CFSG.Sporadic.HNOddCore.orderOf_fJ hcf
      (fun x hx hnot => hnFiveOrders_holds x hx hnot) k hko) |>.trans (by norm_num)

