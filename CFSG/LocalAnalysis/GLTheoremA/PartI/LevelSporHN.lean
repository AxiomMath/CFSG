theorem kdSporRow_of_centShapeRk' {name : TauCeti.SporadicName} {p : ℕ} {Q : Type} [Group Q]
    [Finite Q] [IsSimpleGroup Q]
    (hOut : CFSG.HardMathSupport.Timmesfeld.Coordinator.SporadicOuterLeTwo)
    (b : Q ≃* (TauCeti.CFSGIndex.sporadic name).Group) (hnc : ∃ a c : Q, a * c ≠ c * a)
    (hp : p.Prime) (hp2 : p ≠ 2) {Good Rk : ∀ (T : Type) [Group T], Prop}
    (h : CFSG.HardMathSupport.Dickson.I271.CentShapeRk' p Good Rk Q)
    (hlev : ∀ k : Q, k ≠ 1 → k ^ p = 1 → ∀ (T : Type) [Group T], Good T →
      Nat.card T ∣ Nat.card (Subgroup.centralizer ({k} : Set Q)) → kLevel p T ≤ 2) :
    KDSporRow name p := by
  set G := (TauCeti.CFSGIndex.sporadic name).Group
  haveI : IsSimpleGroup G := (MulEquiv.isSimpleGroup_congr b).1 inferInstance
  haveI : Finite G := Finite.of_equiv _ b.toEquiv
  have hncG : ∃ a c : G, a * c ≠ c * a := by
    obtain ⟨a, c, hac⟩ := hnc
    refine ⟨b a, b c, fun h' => hac ?_⟩
    have := congrArg b.symm h'
    simpa using this
  have hout := hOut G inferInstance hncG name ⟨MulEquiv.refl _⟩
  have hc : ∀ x : G, orderOf x = p → ∀ I : Subgroup G,
      GLAPComponent p (Subgroup.centralizer ({x} : Set G)) I → kLevel p (PSimple p I) ≤ 2 := by
    intro x hx I hI
    have hI' := CFSG.HardMathSupport.Dickson.I271.glaPComponent_map_equiv hp b.symm hI
    rw [CFSG.HardMathSupport.Solomon.Coordinator.map_centralizer_mulEquiv] at hI'
    have hk : orderOf (b.symm x) = p := by rw [MulEquiv.orderOf_eq, hx]
    have hk1 : b.symm x ≠ 1 := fun h1 => by rw [h1, orderOf_one] at hk; exact hp.one_lt.ne' hk.symm
    have hkp : b.symm x ^ p = 1 := by rw [← hk]; exact pow_orderOf_eq_one _
    rw [kLevel_congr (CFSG.HardMathSupport.Dickson.I271.pSimpleEquiv p
      (I.equivMapOfInjective b.symm.toMonoidHom b.symm.injective))]
    rcases h (b.symm x) hk1 hkp with hno | ⟨J0, hJ0, huniq, hg, -⟩
    · exact (hno _ hI').elim
    · rw [huniq _ hI']
      exact hlev _ hk1 hkp _ hg ((KDL227Rows.card_pSimple_dvd p J0).trans
        (Subgroup.card_dvd_of_le hJ0.1))
  exact ⟨fun h2 => downLe_of_centralizers hncG hout hp hp2 (kLevel_le_two ⟨_, h2, ⟨MulEquiv.refl _⟩⟩)
      hc,
    fun h3 => downLe_of_centralizers hncG hout hp hp2 (kLevel_le_three ⟨_, h3, ⟨MulEquiv.refl _⟩⟩)
      fun x hx I hI => (hc x hx I hI).trans (by norm_num)⟩

theorem kLevel_le_one_of_leafType_five {T : Type} [Group T]
    (h : CFSG.HardMathSupport.Dickson.I271.LeafType 5 T) {N : ℕ} (hd : Nat.card T ∣ N)
    (hN : ¬ 1814400 ∣ N) : kLevel 5 T ≤ 1 := by
  rcases h with ⟨hC, -, -⟩ | ⟨n, hn5, hn6, h5n, ⟨f⟩⟩
  · exact kLevel_le_one_of_chev hC
  · have hcT : Nat.card T = n.factorial / 2 := (Nat.card_congr f.toEquiv).trans
      (CFSG.HardMathSupport.Solomon.Coordinator.YS08.L3Char.card_alt n (by omega))
    have hn10 : n < 10 := by
      by_contra h10
      push Not at h10
      apply hN
      obtain ⟨c, hc⟩ := Nat.factorial_dvd_factorial h10
      have h2 : 2 ∣ Nat.factorial 10 := Nat.dvd_factorial (by norm_num) (by norm_num)
      have : n.factorial / 2 = Nat.factorial 10 / 2 * c := by
        rw [hc, Nat.div_mul_right_comm h2]
      refine Dvd.dvd.trans ⟨c, ?_⟩ (hcT ▸ hd)
      rw [this]
      norm_num [Nat.factorial]
    have hn : n = 5 := by
      obtain ⟨m, rfl⟩ := h5n
      omega
    subst hn
    refine kLevel_le_one_of_chev (Or.inr ⟨TauCeti.CFSGIndex.alternating 5 (by norm_num),
      Or.inl ⟨rfl, Or.inr rfl⟩, ⟨f.trans (MulEquiv.refl _)⟩⟩)

theorem not_dvd_card_centralizer_five {Y : Type} [Group Y] [Finite Y] {f : Y}
    (hf : orderOf f = 5) (hcf : Nat.card (Subgroup.centralizer ({f} : Set Y)) = 630000)
    (hcls : ∀ x : Y, orderOf x = 5 → (∀ e : ℕ, ¬ IsConj x (f ^ e)) →
      Nat.card (Subgroup.centralizer ({x} : Set Y)) ∣ 2 ^ 14 * 3 * 5 ^ 6)
    (x : Y) (hx : orderOf x = 5) :
    ¬ 1814400 ∣ Nat.card (Subgroup.centralizer ({x} : Set Y)) := by
  by_cases h : ∃ e : ℕ, IsConj x (f ^ e)
  · obtain ⟨e, he⟩ := h
    obtain ⟨c, hc⟩ := isConj_iff.1 he
    have hfe : orderOf (f ^ e) = 5 := by
      rw [← hc]
      exact (orderOf_injective (MulAut.conj c).toMonoidHom (MulAut.conj c).injective x).trans hx
    have hz : Subgroup.zpowers (f ^ e) = Subgroup.zpowers f :=
      Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.2 (pow_mem (Subgroup.mem_zpowers f) e))
        (by rw [Nat.card_zpowers, Nat.card_zpowers, hfe, hf])
    have hcent : Subgroup.centralizer ({f ^ e} : Set Y) = Subgroup.centralizer ({f} : Set Y) :=
      CFSG.HardMathSupport.Solomon.Coordinator.centralizer_singleton_eq_of_zpowers hz
    have hcx : Nat.card (Subgroup.centralizer ({f ^ e} : Set Y)) =
        Nat.card (Subgroup.centralizer ({x} : Set Y)) := by
      rw [← hc, CFSG.LocalAnalysis.GLTheoremA.S8.HNRows.centralizer_conj,
        Subgroup.card_map_of_injective (MulAut.conj c).injective]
    rw [← hcx, hcent, hcf]
    norm_num
  · push Not at h
    intro hd
    have := hd.trans (hcls x hx h)
    norm_num at this

