theorem pSimple_simple_nonab {G : Type} [Group G] [Finite G] {p : ℕ} (hp : p.Prime)
    {X I : Subgroup G} (hI : GLAPComponent p X I) :
    IsSimpleGroup (PSimple p I) ∧ ∃ a b : PSimple p I, a * b ≠ b * a := by
  have hq := isQuasisimple_pQuot_of_glaPComponent hp hI
  haveI hs : IsSimpleGroup (PSimple p I) := hq.2
  refine ⟨hs, ?_⟩
  by_contra hc
  push Not at hc
  have h1 : commutator (PSimple p I) = ⊥ := by
    rw [commutator_def, Subgroup.commutator_eq_bot_iff_le_centralizer]
    intro a _
    rw [Subgroup.mem_centralizer_iff]
    intro b _
    exact hc b a
  have h2 : commutator (PSimple p I) = ⊤ := by
    have hsurj : Function.Surjective (QuotientGroup.mk' (Subgroup.center (PQuot p I))) :=
      QuotientGroup.mk'_surjective _
    have := Subgroup.map_commutator (⊤ : Subgroup (PQuot p I)) ⊤
      (QuotientGroup.mk' (Subgroup.center (PQuot p I)))
    rw [Subgroup.map_top_of_surjective _ hsurj] at this
    rw [commutator_def, ← this, ← commutator_def, hq.1, Subgroup.map_top_of_surjective _ hsurj]
  have : (⊥ : Subgroup (PSimple p I)) = ⊤ := h1.symm.trans h2
  exact hs.toNontrivial.exists_pair_ne.elim fun a ha => ha.elim fun b hb =>
    hb (by
      have ha' : a ∈ (⊥ : Subgroup (PSimple p I)) := this ▸ Subgroup.mem_top a
      have hb' : b ∈ (⊥ : Subgroup (PSimple p I)) := this ▸ Subgroup.mem_top b
      rw [Subgroup.mem_bot] at ha' hb'
      rw [ha', hb'])

