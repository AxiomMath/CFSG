@[expose] def v1 : Perm (Fin 12) := swap 0 1 * swap 2 3
@[expose] def v2 : Perm (Fin 12) := swap 0 2 * swap 1 3
@[expose] def v3 : Perm (Fin 12) := swap 0 3 * swap 1 2

@[expose] def IsV (p : Perm (Fin 12)) : Prop := p = 1 ∨ p = v1 ∨ p = v2 ∨ p = v3

theorem isV_mul {a b : Perm (Fin 12)} (ha : IsV a) (hb : IsV b) : IsV (a * b) := by
  unfold IsV at *
  rcases ha with rfl | rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl | rfl <;>
    decide

theorem isV_inv {a : Perm (Fin 12)} (ha : IsV a) : IsV a⁻¹ := by
  unfold IsV at *
  rcases ha with rfl | rfl | rfl | rfl <;> decide

theorem isV_sign {a : Perm (Fin 12)} (ha : IsV a) : Perm.sign a = 1 := by
  rcases ha with rfl | rfl | rfl | rfl <;>
    simp [v1, v2, v3, Perm.sign_mul, Perm.sign_swap]

theorem isV_sq {a : Perm (Fin 12)} (ha : IsV a) : a ^ 2 = 1 := by
  rcases ha with rfl | rfl | rfl | rfl <;> decide

theorem isV_conj_tri {a : Perm (Fin 12)} (ha : IsV a) :
    IsV (tri 0 1 2 * a * (tri 0 1 2)⁻¹) ∧ IsV ((tri 0 1 2)⁻¹ * a * tri 0 1 2) := by
  unfold IsV at *
  rcases ha with rfl | rfl | rfl | rfl <;> decide

theorem isV_fix {a : Perm (Fin 12)} (ha : IsV a) :
    (∀ i : Fin 12, 4 ≤ i.val → a i = i) ∧ ∀ i : Fin 12, i.val < 4 → (a i).val < 4 := by
  rcases ha with rfl | rfl | rfl | rfl <;> decide

theorem isV_eq_v1 {a : Perm (Fin 12)} (ha : IsV a) (h : a 0 = 1) : a = v1 := by
  unfold IsV at ha
  rcases ha with rfl | rfl | rfl | rfl <;> revert h <;> decide

@[expose] def kleinV : Subgroup (alternatingGroup (Fin 12)) where
  carrier := {σ | IsV (σ : Perm (Fin 12))}
  mul_mem' ha hb := isV_mul ha hb
  one_mem' := Or.inl rfl
  inv_mem' ha := isV_inv ha

theorem kleinV_isPGroup : IsPGroup 2 kleinV := fun g =>
  ⟨1, Subtype.ext (Subtype.ext (by simpa using isV_sq g.2))⟩

@[expose] def v1A : alternatingGroup (Fin 12) :=
  ⟨v1, (mem_alternatingGroup).2 (isV_sign (Or.inr (Or.inl rfl)))⟩

theorem kleinV_ne_bot : kleinV ≠ ⊥ := by
  intro h
  have hm : v1A ∈ kleinV := Or.inr (Or.inl rfl)
  rw [h, Subgroup.mem_bot] at hm
  have := congrArg (fun σ : alternatingGroup (Fin 12) => (σ : Perm (Fin 12)) 0) hm
  revert this
  unfold v1A v1
  decide

theorem mem_normalizer_kleinV {g : alternatingGroup (Fin 12)}
    (h1 : ∀ a : Perm (Fin 12), IsV a → IsV ((g : Perm (Fin 12)) * a * (g : Perm (Fin 12))⁻¹))
    (h2 : ∀ a : Perm (Fin 12), IsV a → IsV ((g : Perm (Fin 12))⁻¹ * a * (g : Perm (Fin 12)))) :
    g ∈ Subgroup.normalizer (kleinV : Set (alternatingGroup (Fin 12))) := by
  rw [Subgroup.mem_normalizer_iff]
  intro h
  constructor
  · intro hh
    exact h1 _ hh
  · intro hh
    have := h2 _ hh
    have e : (g : Perm (Fin 12))⁻¹ * ((g * h * g⁻¹ : alternatingGroup (Fin 12)) : Perm (Fin 12)) *
        (g : Perm (Fin 12)) = h := by
      simp only [Subgroup.coe_mul, Subgroup.coe_inv]; group
    rw [e] at this
    exact this

theorem tri012A_mem_normalizer :
    tri012A ∈ Subgroup.normalizer (kleinV : Set (alternatingGroup (Fin 12))) :=
  mem_normalizer_kleinV (fun _ ha => (isV_conj_tri ha).1) (fun _ ha => (isV_conj_tri ha).2)

@[expose] def alt4 : Subgroup (alternatingGroup (Fin 12)) :=
  (fixingSubgroup (Perm (Fin 12)) {i : Fin 12 | i.val < 4}).comap
    (alternatingGroup (Fin 12)).subtype

theorem mem_alt4 (σ : alternatingGroup (Fin 12)) :
    σ ∈ alt4 ↔ ∀ i : Fin 12, i.val < 4 → (σ : Perm (Fin 12)) i = i := by
  rw [alt4, Subgroup.mem_comap, mem_fixingSubgroup_iff]
  exact ⟨fun h i hi => h i hi, fun h i hi => h i hi⟩

theorem alt4_le_alt3 : alt4 ≤ alt3 := fun σ hσ =>
  (mem_alt3 σ).2 fun i hi => (mem_alt4 σ).1 hσ i (by omega)

theorem comm_of_fix {k : ℕ} {σ a : Perm (Fin 12)} (hσ : ∀ i : Fin 12, i.val < k → σ i = i)
    (ha1 : ∀ i : Fin 12, k ≤ i.val → a i = i) (ha2 : ∀ i : Fin 12, i.val < k → (a i).val < k) :
    σ * a = a * σ := by
  ext i
  rw [Perm.mul_apply, Perm.mul_apply]
  by_cases hi : i.val < k
  · rw [hσ _ (ha2 i hi), hσ i hi]
  · have h2 : k ≤ (σ i).val := by
      by_contra hc
      have e := hσ (σ i) (by omega)
      exact hi (by rw [← σ.injective e]; omega)
    rw [ha1 i (by omega), ha1 _ h2]

theorem alt4_le_normalizer :
    alt4 ≤ Subgroup.normalizer (kleinV : Set (alternatingGroup (Fin 12))) := by
  intro σ hσ
  have hf := (mem_alt4 σ).1 hσ
  have hc : ∀ a : Perm (Fin 12), IsV a → (σ : Perm (Fin 12)) * a = a * σ := fun a ha =>
    comm_of_fix hf (isV_fix ha).1 (isV_fix ha).2
  refine mem_normalizer_kleinV (fun a ha => ?_) (fun a ha => ?_)
  · rw [hc a ha, mul_inv_cancel_right]; exact ha
  · rw [mul_assoc, ← hc a ha, inv_mul_cancel_left]; exact ha

theorem mem_alt4_of_normalizer {τ : alternatingGroup (Fin 12)} (hτ : τ ∈ alt3)
    (hN : τ ∈ Subgroup.normalizer (kleinV : Set (alternatingGroup (Fin 12)))) : τ ∈ alt4 := by
  have hf := (mem_alt3 τ).1 hτ
  set s : Perm (Fin 12) := (τ : Perm (Fin 12))
  have hconj : IsV (s * v1 * s⁻¹) := by
    have := (Subgroup.mem_normalizer_iff.1 hN v1A).1 (Or.inr (Or.inl rfl))
    exact this
  have h0 : s 0 = 0 := hf 0 (by decide)
  have h1 : s 1 = 1 := hf 1 (by decide)
  have h2 : s 2 = 2 := hf 2 (by decide)
  have hv : s * v1 * s⁻¹ = v1 := by
    apply isV_eq_v1 hconj
    have hs0 : s⁻¹ 0 = 0 := by rw [Perm.inv_eq_iff_eq]; exact h0.symm
    rw [Perm.mul_apply, Perm.mul_apply, hs0]
    have : v1 0 = 1 := by unfold v1; decide
    rw [this, h1]
  have hcomm : s * v1 = v1 * s := by
    calc s * v1 = s * v1 * s⁻¹ * s := by group
      _ = v1 * s := by rw [hv]
  have e := congrArg (fun f : Perm (Fin 12) => f 3) hcomm
  simp only [Perm.mul_apply] at e
  have hv3 : v1 3 = 2 := by unfold v1; decide
  rw [hv3, h2] at e
  have h3 : s 3 = 3 := by
    have := congrArg v1 e
    have hvv : ∀ x, v1 (v1 x) = x := by unfold v1; decide
    rw [hvv] at this
    rw [← this]
    unfold v1; decide
  refine (mem_alt4 τ).2 fun i hi => ?_
  interval_cases hv' : i.val
  · rw [show i = 0 from Fin.ext hv']; exact h0
  · rw [show i = 1 from Fin.ext hv']; exact h1
  · rw [show i = 2 from Fin.ext hv']; exact h2
  · rw [show i = 3 from Fin.ext hv']; exact h3

theorem decomp_facts {Q : Type*} [Group Q] {C A Z : Subgroup Q}
    (hdec : ∀ c ∈ C, ∃ z ∈ Z, ∃ a ∈ A, c = z * a) (hZA : ∀ z ∈ Z, ∀ a ∈ A, z * a = a * z)
    (hcen : ∀ a ∈ A, (∀ b ∈ A, a * b = b * a) → a = 1) :
    (∀ g ∈ C, ∀ l ∈ A, g * l * g⁻¹ ∈ A) ∧ C ⊓ Subgroup.centralizer (A : Set Q) ≤ Z := by
  constructor
  · intro g hg l hl
    obtain ⟨z, hz, a, ha, rfl⟩ := hdec g hg
    have : z * a * l * (z * a)⁻¹ = a * l * a⁻¹ := by
      have h1 := hZA z hz (a * l * a⁻¹) (A.mul_mem (A.mul_mem ha hl) (A.inv_mem ha))
      calc z * a * l * (z * a)⁻¹ = z * (a * l * a⁻¹) * z⁻¹ := by group
        _ = a * l * a⁻¹ := by rw [h1]; group
    rw [this]
    exact A.mul_mem (A.mul_mem ha hl) (A.inv_mem ha)
  · rintro c ⟨hc, hcA⟩
    obtain ⟨z, hz, a, ha, rfl⟩ := hdec c hc
    have ha1 : a = 1 := by
      refine hcen a ha fun b hb => ?_
      have h1 := (Subgroup.mem_centralizer_iff.1 hcA) b hb
      have h2 := hZA z hz b hb
      have : z * (a * b) = z * (b * a) := by
        calc z * (a * b) = z * a * b := by group
          _ = b * (z * a) := h1.symm
          _ = (b * z) * a := by group
          _ = z * (b * a) := by rw [← h2]; group
      exact mul_left_cancel this
    rw [ha1, mul_one]
    exact hz

theorem alt3_center {σ : alternatingGroup (Fin 12)} (hσ : σ ∈ alt3)
    (h : ∀ b ∈ alt3, σ * b = b * σ) : σ = 1 := by
  have := alt3_simple
  have hnab : ∃ a b : alt3, a * b ≠ b * a := by
    by_contra hc
    push Not at hc
    have hcomm : commutator alt3 = ⊥ := by
      rw [commutator_def, Subgroup.commutator_eq_bot_iff_le_centralizer]
      intro x _
      rw [Subgroup.mem_centralizer_iff]
      intro y _
      exact hc y x
    rw [commutator_alt3] at hcomm
    have : Nat.card alt3 = 1 := by
      rw [← Subgroup.card_top (G := alt3), hcomm, Subgroup.card_bot]
    rw [card_alt3] at this
    norm_num at this
  have hZ := CFSG.HardMathSupport.Dickson.I271.center_eq_bot_of_simple_nonab hnab
  have hmem : (⟨σ, hσ⟩ : alt3) ∈ Subgroup.center alt3 := by
    rw [Subgroup.mem_center_iff]
    intro b
    exact Subtype.ext (h b b.2).symm
  rw [hZ, Subgroup.mem_bot] at hmem
  exact congrArg Subtype.val hmem

@[expose] def shift4 : Fin 8 ≃ {i : Fin 12 // 4 ≤ i.val} where
  toFun j := ⟨⟨j.val + 4, by omega⟩, by simp⟩
  invFun i := ⟨i.1.val - 4, by have := i.1.isLt; omega⟩
  left_inv j := by ext; simp
  right_inv i := by
    apply Subtype.ext
    apply Fin.ext
    have := i.2
    simp only
    omega

abbrev ext4 : Perm (Fin 8) →* Perm (Fin 12) := extendDomainHom shift4

theorem ext4_fix (τ : Perm (Fin 8)) {i : Fin 12} (hi : i.val < 4) : ext4 τ i = i := by
  rw [extendDomainHom_apply]
  exact extendDomain_apply_not_subtype τ shift4 (by omega)

theorem ext4_mem (τ : alternatingGroup (Fin 8)) : ext4 τ ∈ alternatingGroup (Fin 12) := by
  rw [mem_alternatingGroup, extendDomainHom_apply, sign_extendDomain]
  exact τ.2

@[expose] def alt8Hom : alternatingGroup (Fin 8) →* alt4 where
  toFun τ := ⟨⟨ext4 τ, ext4_mem τ⟩, (mem_alt4 _).2 fun _ hi => ext4_fix τ hi⟩
  map_one' := by ext; simp
  map_mul' a b := by ext; simp

theorem alt8Hom_injective : Function.Injective alt8Hom := fun _ _ h =>
  Subtype.ext (extendDomainHom_injective shift4 (congrArg (fun x : alt4 =>
    ((x : alternatingGroup (Fin 12)) : Perm (Fin 12))) h))

theorem alt8Hom_surjective : Function.Surjective alt8Hom := by
  rintro ⟨⟨σ, hσ⟩, hfix⟩
  have hfix' := (mem_alt4 _).1 hfix
  have hge : ∀ i : Fin 12, 4 ≤ i.val → 4 ≤ (σ i).val := by
    intro i hi
    by_contra h
    have e := hfix' (σ i) (by omega)
    exact absurd (σ.injective e) (by intro h'; rw [h'] at h; omega)
  have hge' : ∀ i : Fin 12, 4 ≤ i.val → 4 ≤ (σ⁻¹ i).val := by
    intro i hi
    by_contra h
    have e := hfix' (σ⁻¹ i) (by omega)
    rw [Perm.coe_inv, Equiv.apply_symm_apply] at e
    rw [Perm.coe_inv, ← e] at h
    omega
  let τ : Perm (Fin 8) :=
    { toFun := fun j => shift4.symm ⟨σ (shift4 j), hge _ (shift4 j).2⟩
      invFun := fun j => shift4.symm ⟨σ⁻¹ (shift4 j), hge' _ (shift4 j).2⟩
      left_inv := fun j => by simp
      right_inv := fun j => by simp }
  have hτ : ext4 τ = σ := by
    ext i
    by_cases hi : 4 ≤ i.val
    · rw [extendDomainHom_apply]
      have := extendDomain_apply_subtype τ shift4 (b := i) hi
      rw [this]
      simp [τ]
    · rw [ext4_fix τ (by omega), hfix' i (by omega)]
  refine ⟨⟨τ, ?_⟩, ?_⟩
  · rw [mem_alternatingGroup, ← sign_extendDomain τ shift4, ← extendDomainHom_apply, hτ]
    exact hσ
  · apply Subtype.ext
    apply Subtype.ext
    exact hτ

@[expose] noncomputable def alt8Equiv : alternatingGroup (Fin 8) ≃* alt4 :=
  MulEquiv.ofBijective alt8Hom ⟨alt8Hom_injective, alt8Hom_surjective⟩

theorem alt4_simple : IsSimpleGroup alt4 := by
  have : IsSimpleGroup (alternatingGroup (Fin 8)) := alternatingGroup.isSimpleGroup (by simp)
  exact MulEquiv.isSimpleGroup alt8Equiv.symm

theorem card_alt4 : Nat.card alt4 = 20160 := by
  rw [← Nat.card_congr alt8Equiv.toEquiv, Nat.card_eq_fintype_card, card_alternatingGroup,
    Fintype.card_fin]
  decide

theorem exists_noncomm_of_simple {S : Type*} [Group S] [Finite S] [IsSimpleGroup S]
    (h : ¬ (Nat.card S).Prime) : ∃ a b : S, a * b ≠ b * a := by
  by_contra hc
  push Not at hc
  letI : CommGroup S := { (inferInstance : Group S) with mul_comm := hc }
  exact h (IsSimpleGroup.prime_card (α := S))

theorem center_trivial_of_simple {Q : Type} [Group Q] {A : Subgroup Q} [Finite A]
    [IsSimpleGroup A] (h : ¬ (Nat.card A).Prime) {σ : Q} (hσ : σ ∈ A)
    (hc : ∀ b ∈ A, σ * b = b * σ) : σ = 1 := by
  have hZ := CFSG.HardMathSupport.Dickson.I271.center_eq_bot_of_simple_nonab
    (exists_noncomm_of_simple h)
  have hmem : (⟨σ, hσ⟩ : A) ∈ Subgroup.center A := by
    rw [Subgroup.mem_center_iff]
    intro b
    exact Subtype.ext (hc b b.2).symm
  rw [hZ, Subgroup.mem_bot] at hmem
  exact congrArg Subtype.val hmem

theorem zpowers_tri_comm {z a : alternatingGroup (Fin 12)} (hz : z ∈ Subgroup.zpowers tri012A)
    (ha : a ∈ alt3) : z * a = a * z := by
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hz
  exact ((Commute.zpow_left (centralizer_tri012.2.2 a ha).symm k)).eq

theorem centralizer_tri_decomp {c : alternatingGroup (Fin 12)}
    (hc : c ∈ Subgroup.centralizer {tri012A}) :
    ∃ z ∈ Subgroup.zpowers tri012A, ∃ a ∈ alt3, c = z * a := by
  obtain ⟨k, hτ⟩ := exists_tri012_decomp hc
  exact ⟨tri012A ^ k, Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _, _, hτ, by group⟩

theorem centralizer_normalizer_decomp {c : alternatingGroup (Fin 12)}
    (hc : c ∈ Subgroup.centralizer {tri012A} ⊓
      Subgroup.normalizer (kleinV : Set (alternatingGroup (Fin 12)))) :
    ∃ z ∈ Subgroup.zpowers tri012A, ∃ a ∈ alt4, c = z * a := by
  obtain ⟨k, hτ⟩ := exists_tri012_decomp hc.1
  refine ⟨tri012A ^ k, Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _, _,
    mem_alt4_of_normalizer hτ ?_, by group⟩
  exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (Subgroup.pow_mem _ tri012A_mem_normalizer _)) hc.2

theorem alt3_le_centralizer : alt3 ≤ Subgroup.centralizer {tri012A} := fun σ hσ =>
  Subgroup.mem_centralizer_singleton_iff.2 (centralizer_tri012.2.2 σ hσ)

theorem alt4_le_inf : alt4 ≤ Subgroup.centralizer {tri012A} ⊓
    Subgroup.normalizer (kleinV : Set (alternatingGroup (Fin 12))) := fun σ hσ =>
  ⟨alt3_le_centralizer (alt4_le_alt3 hσ), alt4_le_normalizer hσ⟩

theorem alt3_facts :
    (∀ g ∈ Subgroup.centralizer {tri012A}, ∀ l ∈ alt3, g * l * g⁻¹ ∈ alt3) ∧
      Subgroup.centralizer {tri012A} ⊓ Subgroup.centralizer (alt3 : Set (alternatingGroup (Fin 12)))
        ≤ Subgroup.zpowers tri012A :=
  decomp_facts (fun _ hc => centralizer_tri_decomp hc) (fun _ hz _ ha => zpowers_tri_comm hz ha)
    (fun _ ha hc => alt3_center ha hc)

theorem alt4_facts :
    (∀ g ∈ Subgroup.centralizer {tri012A} ⊓
      Subgroup.normalizer (kleinV : Set (alternatingGroup (Fin 12))), ∀ l ∈ alt4, g * l * g⁻¹ ∈ alt4) ∧
      Subgroup.centralizer {tri012A} ⊓
        Subgroup.normalizer (kleinV : Set (alternatingGroup (Fin 12))) ⊓
        Subgroup.centralizer (alt4 : Set (alternatingGroup (Fin 12))) ≤ Subgroup.zpowers tri012A := by
  have := alt4_simple
  exact decomp_facts (fun _ hc => centralizer_normalizer_decomp hc)
    (fun _ hz _ ha => zpowers_tri_comm hz (alt4_le_alt3 ha))
    (fun _ ha hc => center_trivial_of_simple (by rw [card_alt4]; norm_num) ha hc)

end CFSG.LocalAnalysis.GLTheoremA.S8.HNRows
