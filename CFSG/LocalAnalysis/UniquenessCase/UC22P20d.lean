theorem uc22p20d_false_of_rank (D : Data G) (hB : ListBNonabelian) (h20_1 : S20_1_124 D)
    (h1930 : H1930 D) {H : Subgroup G} (hH : H ∈ hSet D.T D.M)
    {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {E : Subgroup G} (hEH : E ≤ H)
    (hE : IsElemAbelian p E) (hcard : Nat.card E = p ^ 5)
    (hloc : p = 3 ∨ ∃ Z : Subgroup G, D.T ≤ Z ∧ Z ≤ H ∧ Group.IsSolvable ↥Z ∧ E ≤ Z) :
    False := by
  have h4 : 5 ≤ CFSG.Open.pRank p H := CFSG.SectionRank.le_pRank hp.one_lt hEH hE hcard
  obtain ⟨h1, h2, -⟩ := h20_1 h1930 H hH
  rcases hloc with rfl | ⟨Z, hTZ, hZH, hZs, hEZ⟩
  · omega
  · have hZM : Z ≤ D.M := uc22p20b_le_M_of_solvable D hB h1930 hH hTZ hZH hZs
    have hEHM : E ≤ H ⊓ D.M := le_inf hEH (hEZ.trans hZM)
    have h5 : 5 ≤ CFSG.Open.pRank p (H ⊓ D.M) := CFSG.SectionRank.le_pRank hp.one_lt hEHM hE hcard
    have h6 := h2 p hp hp2 (by omega)
    omega


open scoped Pointwise in
theorem uc22p20d_card_sup {X : Type*} [Group X] (A B : Subgroup X)
    (hcomm : ∀ a ∈ A, ∀ b ∈ B, a * b = b * a) (hdisj : Disjoint A B) :
    Nat.card (A ⊔ B : Subgroup X) = Nat.card A * Nat.card B := by
  have hnormal : B ≤ Subgroup.normalizer (A : Set X) := fun b hb =>
    Subgroup.centralizer_le_normalizer _
      (Subgroup.mem_centralizer_iff.2 fun a ha => hcomm a ha b hb)
  let toSup : A × B → ↑(A ⊔ B) := fun z =>
    ⟨(z.1 : X) * (z.2 : X), Subgroup.mul_mem_sup z.1.2 z.2.2⟩
  have hinj : Function.Injective toSup := by
    intro x y hxy
    apply Subgroup.mul_injective_of_disjoint hdisj
    exact congrArg Subtype.val hxy
  have hsurj : Function.Surjective toSup := by
    intro z
    have hz : (z : X) ∈ (A : Set X) * (B : Set X) := by
      rw [← Subgroup.coe_mul_of_right_le_normalizer_left A B hnormal]
      exact z.2
    rcases hz with ⟨a, ha, b, hb, hab⟩
    exact ⟨(⟨a, ha⟩, ⟨b, hb⟩), Subtype.ext hab⟩
  calc
    Nat.card (A ⊔ B : Subgroup X) = Nat.card (A × B) :=
      Nat.card_congr (Equiv.ofBijective toSup ⟨hinj, hsurj⟩).symm
    _ = Nat.card A * Nat.card B := Nat.card_prod A B

theorem uc22p20d_card_zpowers {X : Type*} [Group X] (p : ℕ) (hp : p.Prime) (g : X)
    (hg : g ^ p = 1) (hg1 : g ≠ 1) : Nat.card (Subgroup.zpowers g) = p := by
  rw [Nat.card_zpowers]
  rcases (Nat.dvd_prime hp).1 (orderOf_dvd_of_pow_eq_one hg) with h | h
  · exact absurd (orderOf_eq_one_iff.1 h) hg1
  · exact h

theorem uc22p20d_disjoint_zpowers {X : Type*} [Group X] [Finite X] (p : ℕ) (hp : p.Prime) (g : X)
    (hg : g ^ p = 1) (hg1 : g ≠ 1) (C : Subgroup X) (hgC : g ∉ C) :
    Disjoint (Subgroup.zpowers g) C := by
  rw [Subgroup.disjoint_def]
  intro y hyg hyC
  by_contra hy1
  have hyp : y ^ p = 1 := by
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hyg
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hg, one_zpow]
  have hle : Subgroup.zpowers y ≤ Subgroup.zpowers g := Subgroup.zpowers_le.2 hyg
  have heq : Subgroup.zpowers y = Subgroup.zpowers g :=
    Subgroup.eq_of_le_of_card_ge hle
      (by rw [uc22p20d_card_zpowers p hp g hg hg1, uc22p20d_card_zpowers p hp y hyp hy1])
  apply hgC
  have hgy : g ∈ Subgroup.zpowers y := heq ▸ Subgroup.mem_zpowers g
  exact Subgroup.zpowers_le.2 hyC hgy

theorem uc22p20d_card_closure {X : Type*} [Group X] [Finite X] (p n : ℕ) (hp : p.Prime)
    (A : Fin n → Subgroup X) (x : Fin n → X)
    (hcomm : ∀ i j, i ≠ j → ∀ a ∈ A i, ∀ b ∈ A j, a * b = b * a)
    (hx : ∀ i, x i ∈ A i) (hxp : ∀ i, x i ^ p = 1)
    (hxz : ∀ i, ∃ a ∈ A i, a * x i ≠ x i * a) (S : Finset (Fin n)) :
    Nat.card (Subgroup.closure (x '' (S : Set (Fin n)))) = p ^ S.card := by
  induction S using Finset.induction_on with
  | empty => simp
  | insert i S hi ih =>
    have hx1 : x i ≠ 1 := by
      intro h
      obtain ⟨a, _, ha⟩ := hxz i
      exact ha (by rw [h, mul_one, one_mul])
    have hnot : x i ∉ Subgroup.centralizer (A i : Set X) := by
      intro h
      obtain ⟨a, ha, hne⟩ := hxz i
      exact hne (Subgroup.mem_centralizer_iff.1 h a ha)
    have hle : Subgroup.closure (x '' (S : Set (Fin n))) ≤ Subgroup.centralizer (A i : Set X) := by
      rw [Subgroup.closure_le]
      rintro _ ⟨j, hj, rfl⟩
      rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
      intro a ha
      have hji : j ≠ i := by
        rintro rfl
        exact hi hj
      exact (hcomm j i hji (x j) (hx j) a ha).symm
    have hcx : ∀ a ∈ Subgroup.closure (x '' (S : Set (Fin n))), Commute a (x i) := fun a ha =>
      (Subgroup.mem_centralizer_iff.1 (hle ha) (x i) (hx i)).symm
    have hdisj : Disjoint (Subgroup.closure (x '' (S : Set (Fin n)))) (Subgroup.zpowers (x i)) :=
      ((uc22p20d_disjoint_zpowers p hp (x i) (hxp i) hx1 _ hnot).mono_right hle).symm
    have hsup : Subgroup.closure (x '' ((insert i S : Finset (Fin n)) : Set (Fin n))) =
        Subgroup.closure (x '' (S : Set (Fin n))) ⊔ Subgroup.zpowers (x i) := by
      rw [Finset.coe_insert, Set.image_insert_eq, Set.insert_eq, Subgroup.closure_union,
        ← Subgroup.zpowers_eq_closure, sup_comm]
    have hcommZ : ∀ a ∈ Subgroup.closure (x '' (S : Set (Fin n))), ∀ b ∈ Subgroup.zpowers (x i),
        a * b = b * a := by
      intro a ha b hb
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hb
      exact (Commute.zpow_right (hcx a ha) k).eq
    rw [hsup, uc22p20d_card_sup _ _ hcommZ hdisj, ih,
      uc22p20d_card_zpowers p hp (x i) (hxp i) hx1, Finset.card_insert_of_notMem hi, pow_succ]

theorem uc22p20d_elemAbelian_of_commuting {X : Type*} [Group X] [Finite X] (p n : ℕ) (hp : p.Prime)
    (A : Fin n → Subgroup X) (x : Fin n → X)
    (hcomm : ∀ i j, i ≠ j → ∀ a ∈ A i, ∀ b ∈ A j, a * b = b * a)
    (hx : ∀ i, x i ∈ A i) (hxp : ∀ i, x i ^ p = 1)
    (hxz : ∀ i, ∃ a ∈ A i, a * x i ≠ x i * a) :
    ∃ E : Subgroup X, E ≤ Subgroup.closure (Set.range x) ∧ IsElemAbelian p E ∧
      Nat.card E = p ^ n := by
  have hpair : (Set.range x).Pairwise Commute := by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ hne
    exact hcomm i j (fun h => hne (congrArg x h)) (x i) (hx i) (x j) (hx j)
  haveI hcommE : IsMulCommutative (Subgroup.closure (Set.range x)) :=
    Subgroup.isMulCommutative_closure hpair
  refine ⟨Subgroup.closure (Set.range x), le_rfl, And.intro hcommE ?_, ?_⟩
  · intro y hy
    induction hy using Subgroup.closure_induction with
    | mem z hz =>
      obtain ⟨i, rfl⟩ := hz
      exact hxp i
    | one => exact one_pow p
    | mul a b ha hb iha ihb =>
      rw [(show Commute a b from setLike_mul_comm ha hb).mul_pow, iha, ihb, one_mul]
    | inv a ha iha => rw [inv_pow, iha, inv_one]
  · simpa [Set.image_univ] using
      uc22p20d_card_closure p n hp A x hcomm hx hxp hxz Finset.univ


theorem uc22p20d_lift_elemAbelian {A : Type*} [Group A] [Finite A] (N : Subgroup A) [N.Normal]
    (hN : IsPGroup 2 N) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (B : Subgroup A)
    (E₀ : Subgroup (A ⧸ N)) (hE₀ : IsElemAbelian p E₀) {n : ℕ} (hn : Nat.card E₀ = p ^ n)
    (hle : E₀ ≤ B.map (QuotientGroup.mk' N)) :
    ∃ E : Subgroup A, E ≤ B ∧ IsElemAbelian p E ∧ Nat.card E = p ^ n := by
  set f : A →* A ⧸ N := QuotientGroup.mk' N with hf
  have hmap : (B ⊓ E₀.comap f).map f = E₀ := by
    refine le_antisymm ?_ ?_
    · rintro _ ⟨x, hx, rfl⟩
      exact hx.2
    · intro y hy
      obtain ⟨b, hb, rfl⟩ := hle hy
      exact ⟨b, ⟨hb, hy⟩, rfl⟩
  have hdvd : p ^ n ∣ Nat.card (B ⊓ E₀.comap f : Subgroup A) := by
    rw [← hn]
    conv_lhs => rw [← hmap]
    exact Subgroup.card_map_dvd _ f
  obtain ⟨S, hScard, -, hSB'⟩ :=
    Sylow.exists_subgroup_card_pow_prime_le_le hp (H := ⊥) (L := B ⊓ E₀.comap f)
      (by simp) hdvd bot_le
  have hSB : S ≤ B := hSB'.trans inf_le_left
  have hSE : ∀ x ∈ S, f x ∈ E₀ := fun x hx => (hSB' hx).2
  obtain ⟨k, hk⟩ := hN.exists_card_eq
  have hcop : Nat.Coprime (Nat.card S) (Nat.card N) := by
    rw [hScard, hk]
    exact Nat.Coprime.pow _ _ ((Nat.coprime_primes hp Nat.prime_two).2 hp2)
  have hdisj : Disjoint S N := Subgroup.disjoint_of_coprime_natCard hcop
  have hinj : ∀ x ∈ S, f x = 1 → x = 1 := by
    intro x hxS hx1
    have hxN : x ∈ N := (QuotientGroup.eq_one_iff x).1 hx1
    simpa using hdisj.le_bot ⟨hxS, hxN⟩
  have hinjOn : Set.InjOn f (S : Set A) := (Set.injOn_iff_map_eq_one f S).2 hinj
  refine ⟨S, hSB, ⟨?_, ?_⟩, hScard⟩
  ·
    refine IsMulCommutative.of_setLike_mul_comm fun x hx y hy => ?_
    refine hinjOn (S.mul_mem hx hy) (S.mul_mem hy hx) ?_
    rw [map_mul, map_mul]
    haveI : IsMulCommutative E₀ := hE₀.1
    exact setLike_mul_comm (hSE x hx) (hSE y hy)
  ·
    intro x hx
    refine hinj _ (S.pow_mem hx p) ?_
    rw [map_pow]
    exact hE₀.2 _ (hSE x hx)


theorem uc22p20d_inv_mul_mem_normalizer {X : Type} [Group X] [Finite X] {C : Subgroup X} {a b : X}
    (h : uc22p20bCj a C = uc22p20bCj b C) : a⁻¹ * b ∈ normalizer (C : Set X) := by
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  have h1 : uc22p20bCj (a⁻¹ * b) C = C := by
    rw [← uc22p20b_cj_cj, ← h, uc22p20b_cj_cj, inv_mul_cancel, uc22p20b_cj_one]
  exact h1

theorem uc22p20d_card_quotient_le {X : Type} [Group X] [Finite X] (C : Subgroup X)
    (hC : ∀ g : Fin 5 → X, ¬ Function.Injective (fun i => uc22p20bCj (g i) C)) :
    Nat.card (X ⧸ normalizer (C : Set X)) ≤ 4 := by
  by_contra hlt
  push Not at hlt
  haveI : Fintype (X ⧸ normalizer (C : Set X)) := Fintype.ofFinite _
  have hle : Fintype.card (Fin 5) ≤ Fintype.card (X ⧸ normalizer (C : Set X)) := by
    rw [Fintype.card_fin, ← Nat.card_eq_fintype_card]
    omega
  obtain ⟨e⟩ := Function.Embedding.nonempty_of_card_le hle
  refine hC (fun i => (e i).out) fun i j hij => ?_
  apply e.injective
  have h := uc22p20d_inv_mul_mem_normalizer hij
  rw [← QuotientGroup.out_eq' (e i), ← QuotientGroup.out_eq' (e j)]
  exact (QuotientGroup.eq).2 h

theorem uc22p20d_perfectCore_le_normalizer {X : Type} [Group X] [Finite X] (C : Subgroup X)
    (hC : ∀ g : Fin 5 → X, ¬ Function.Injective (fun i => uc22p20bCj (g i) C)) :
    CFSG.Quasithin.perfectCore (⊤ : Subgroup X) ≤ normalizer (C : Set X) := by
  set N : Subgroup X := normalizer (C : Set X)
  have hcard := uc22p20d_card_quotient_le C hC
  haveI : Group.IsSolvable (Equiv.Perm (X ⧸ N)) := Equiv.Perm.isSolvable hcard
  haveI : Group.IsPerfect (CFSG.Quasithin.perfectCore (⊤ : Subgroup X)) :=
    Subgroup.isPerfect_iff.mpr (CFSG.Quasithin.perfectCore_perfect ⊤)
  let ψ : CFSG.Quasithin.perfectCore (⊤ : Subgroup X) →* Equiv.Perm (X ⧸ N) :=
    (MulAction.toPermHom X (X ⧸ N)).comp (Subgroup.subtype _)
  have h1 : ψ = 1 := CFSG.ComponentClassification.SolvableKernelContainment.hom_eq_one ψ
  intro x hx
  have h2 : ψ ⟨x, hx⟩ = 1 := by rw [h1]; rfl
  have h3 := Equiv.congr_fun h2 ((1 : X) : X ⧸ N)
  have h4 : ((x : X) : X ⧸ N) = ((1 : X) : X ⧸ N) := by
    simpa [ψ, MulAction.toPermHom_apply] using h3
  have h5 : x⁻¹ * 1 ∈ N := QuotientGroup.eq.1 h4
  simpa using N.inv_mem h5

theorem uc22p20d_outSolvable_of_isSolvable_outer {X : Type} [Group X]
    (h : Group.IsSolvable (CFSG.ComponentClassification.OuterAutomorphisms.Outer X)) :
    CFSG.Quasithin.OutSolvable X := by
  obtain ⟨n, hn⟩ := h.solvable
  refine ⟨n, fun x hx => ?_⟩
  have hmap := map_derivedSeries_eq
    (f := QuotientGroup.mk' (CFSG.ComponentClassification.OuterAutomorphisms.inner X))
    (QuotientGroup.mk'_surjective _) n
  have hx' : QuotientGroup.mk' (CFSG.ComponentClassification.OuterAutomorphisms.inner X) x ∈
      (derivedSeries (MulAut X) n).map
        (QuotientGroup.mk' (CFSG.ComponentClassification.OuterAutomorphisms.inner X)) :=
    ⟨x, hx, rfl⟩
  rw [hmap, hn] at hx'
  exact (QuotientGroup.eq_one_iff x).mp (Subgroup.mem_bot.mp hx')

theorem uc22p20d_outSolvable_component {Q : Type} [Group Q] [Finite Q] (hQ : CFSG.Open.IsKGroup Q)
    (hSch : CFSG.LocalAnalysis.ComponentInitial.SchreierFor CFSG.Assembly.InCatalog)
    {K : Subgroup Q} (hK : CFSG.IsComponent K) : CFSG.Quasithin.OutSolvable ↥K := by
  have hq : CFSG.Open.IsQuasisimple ↥K := CFSG.Quasithin.A3.isQuasisimple_iff_open.1 hK.1
  have hKK : CFSG.Open.IsKGroup ↥K := hQ.subgroup K
  haveI : Group.IsPerfect ↥K := ⟨hq.1⟩
  haveI : IsSimpleGroup (↥K ⧸ Subgroup.center ↥K) := hq.2
  have hnab : ∃ a b : ↥K ⧸ Subgroup.center ↥K, a * b ≠ b * a :=
    CFSG.ComponentClassification.Helpers.quasisimple_central_quotient_nonabelian ↥K hq
  have hcat : CFSG.Open.IsCatalogGroup (↥K ⧸ Subgroup.center ↥K) :=
    hKK.isCatalogGroup_of_surjective ⊤ hnab
      ((QuotientGroup.mk' (Subgroup.center ↥K)).comp (Subgroup.topEquiv (G := ↥K)).toMonoidHom)
      ((QuotientGroup.mk'_surjective _).comp (Subgroup.topEquiv (G := ↥K)).surjective)
  haveI : Group.IsSolvable
      (CFSG.ComponentClassification.OuterAutomorphisms.Outer (↥K ⧸ Subgroup.center ↥K)) :=
    hSch _ hnab hcat
  exact uc22p20d_outSolvable_of_isSolvable_outer
    (CFSG.ComponentClassification.OuterAutomorphisms.solvable_of_centerQuotient ↥K)

theorem uc22p20d_cj_map {X Q : Type} [Group X] [Group Q] (f : X →* Q) (x : X) (C : Subgroup X) :
    uc22p20bCj (f x) (C.map f) = (uc22p20bCj x C).map f := by
  have hcomp : (MulAut.conj (f x)).toMonoidHom.comp f = f.comp (MulAut.conj x).toMonoidHom := by
    ext y
    simp [MulAut.conj_apply]
  unfold uc22p20bCj
  rw [Subgroup.map_map, Subgroup.map_map, hcomp]

theorem uc22p20d_map_normalizer_le {X Q : Type} [Group X] [Group Q] (f : X →* Q) (C : Subgroup X) :
    (normalizer (C : Set X)).map f ≤ normalizer ((C.map f : Subgroup Q) : Set Q) := by
  rintro _ ⟨x, hx, rfl⟩
  replace hx : x ∈ normalizer (C : Set X) := hx
  rw [Subgroup.mem_normalizer_iff_map_conj_eq] at hx ⊢
  have hx' : uc22p20bCj x C = C := hx
  show uc22p20bCj (f x) (C.map f) = C.map f
  rw [uc22p20d_cj_map, hx']

theorem uc22p20d_perfectCore_le_oInftyE {X : Type} [Group X] [Finite X] (hX : CFSG.Open.IsKGroup X)
    (hSch : CFSG.LocalAnalysis.ComponentInitial.SchreierFor CFSG.Assembly.InCatalog)
    (hC : ∀ C ∈ CFSG.Quasithin.cComp (⊤ : Subgroup X), ∀ g : Fin 5 → X,
      ¬ Function.Injective (fun i => uc22p20bCj (g i) C)) :
    CFSG.Quasithin.perfectCore (⊤ : Subgroup X) ≤ CFSG.Quasithin.oInftyE X := by
  have hRs : Group.IsSolvable (CFSG.solvableRadical X) := CFSG.Quasithin.A3.solvableRadical_isSolvable
  have hQK : CFSG.Open.IsKGroup (X ⧸ CFSG.solvableRadical X) := hX.quotient _
  show CFSG.Quasithin.perfectCore (⊤ : Subgroup X) ≤
    (CFSG.layer (X ⧸ CFSG.solvableRadical X)).comap (QuotientGroup.mk' _)
  rw [← Subgroup.map_le_iff_le_comap, CFSG.Quasithin.map_perfectCore,
    Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
  refine CFSG.Quasithin.A38.perfectCore_le_layer
    (CFSG.Quasithin.A3.solvableRadical_quotient_eq_bot X) ?_ ?_
  · intro K hK
    have hKc : K ∈ CFSG.Quasithin.cComp (⊤ : Subgroup (X ⧸ CFSG.solvableRadical X)) :=
      CFSG.Quasithin.mem_cComp_top_of_isComponent hK
    rw [← CFSG.Quasithin.image_cComp_quotient (CFSG.solvableRadical X) hRs] at hKc
    obtain ⟨L, hL, rfl⟩ := hKc
    have h1 := uc22p20d_perfectCore_le_normalizer L (hC L hL)
    have h2 := Subgroup.map_mono (f := QuotientGroup.mk' (CFSG.solvableRadical X)) h1
    rw [CFSG.Quasithin.map_perfectCore,
      Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] at h2
    exact h2.trans (uc22p20d_map_normalizer_le _ _)
  · intro K hK
    exact uc22p20d_outSolvable_component hQK hSch hK

theorem uc22p20d_perfectResidual_eq (X : Type) [Group X] :
    CFSG.perfectResidual X = CFSG.Quasithin.perfectCore (⊤ : Subgroup X) := by
  have h : ∀ n : ℕ, derivedSeries X n = CFSG.Quasithin.derivedSeriesOf (⊤ : Subgroup X) n := by
    intro n
    induction n with
    | zero => rw [derivedSeries_zero]; rfl
    | succ n ih => rw [derivedSeries_succ, CFSG.Quasithin.derivedSeriesOf_succ, ih]
  unfold CFSG.perfectResidual CFSG.Quasithin.perfectCore
  exact iInf_congr h

theorem uc22p20d_exists_five (hKP : CFSG.Open.IsKProper G)
    (hSch : CFSG.LocalAnalysis.ComponentInitial.SchreierFor CFSG.Assembly.InCatalog)
    {H : Subgroup G} (hH : H ≠ ⊤)
    (hnot : ¬ Hinf H ≤ (CFSG.Quasithin.oInftyE ↥H).map H.subtype) :
    ∃ K ∈ CFSG.Quasithin.cComp H, ∃ g : Fin 5 → G, (∀ i, g i ∈ H) ∧
      Function.Injective (fun i => uc22p20bCj (g i) K) := by
  by_contra hcon
  have hcon' : ∀ K ∈ CFSG.Quasithin.cComp H, ∀ g : Fin 5 → G, (∀ i, g i ∈ H) →
      ¬ Function.Injective (fun i => uc22p20bCj (g i) K) :=
    fun K hK g hg hinj => hcon ⟨K, hK, g, hg, hinj⟩
  refine hnot ?_
  have hXK : CFSG.Open.IsKGroup ↥H := hKP.isKGroup H hH
  have key := uc22p20d_perfectCore_le_oInftyE hXK hSch (X := ↥H) fun C hC g hinj => by
    refine hcon' (C.map H.subtype) (CFSG.Quasithin.map_subtype_mem_cComp hC)
      (fun i => ((g i : ↥H) : G)) (fun i => (g i).2) fun i j hij => hinj ?_
    have hmap : ∀ i, uc22p20bCj ((g i : ↥H) : G) (C.map H.subtype) =
        (uc22p20bCj (g i) C).map H.subtype := fun i => uc22p20d_cj_map H.subtype (g i) C
    simp only [hmap] at hij
    exact Subgroup.map_injective H.subtype_injective hij
  show (CFSG.perfectResidual ↥H).map H.subtype ≤ (CFSG.Quasithin.oInftyE ↥H).map H.subtype
  exact Subgroup.map_mono (by rw [uc22p20d_perfectResidual_eq]; exact key)


theorem uc22p20d_bar2Equiv {L K : Subgroup G} (hKL : K ≤ L) (hsub : CFSG.Open.IsSubnormal K L) :
    ∃ e : Bar2 K ≃* ↥((K.subgroupOf L).map (QuotientGroup.mk' (CFSG.pCore 2 ↥L))),
      ∀ k : ↥K, ((e (QuotientGroup.mk k) :
          ↥((K.subgroupOf L).map (QuotientGroup.mk' (CFSG.pCore 2 ↥L)))) :
          ↥L ⧸ CFSG.pCore 2 ↥L) = QuotientGroup.mk (Subgroup.inclusion hKL k) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI hPn : (CFSG.pCore 2 ↥L).Normal := CFSG.pCore_normal
  let φ : ↥K →* ↥L ⧸ CFSG.pCore 2 ↥L :=
    (QuotientGroup.mk' (CFSG.pCore 2 ↥L)).comp (Subgroup.inclusion hKL)
  have hrange : φ.range = (K.subgroupOf L).map (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) := by
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨Subgroup.inclusion hKL x, x.2, rfl⟩
    · rintro ⟨x, hx, rfl⟩
      exact ⟨⟨x, hx⟩, rfl⟩
  have hker : φ.ker = CFSG.pCore 2 ↥K := by
    have key : ∀ x : ↥K, x ∈ φ.ker ↔ ((x : ↥K) : G) ∈ pCoreOf 2 L := by
      intro x
      rw [MonoidHom.mem_ker]
      change (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) (Subgroup.inclusion hKL x) = 1 ↔ _
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      constructor
      · intro h
        exact ⟨Subgroup.inclusion hKL x, h, rfl⟩
      · rintro ⟨y, hy, hyx⟩
        have : y = Subgroup.inclusion hKL x := Subtype.ext hyx
        exact this ▸ hy
    ext x
    rw [key]
    have key2 : x ∈ CFSG.pCore 2 ↥K ↔ ((x : ↥K) : G) ∈ pCoreOf 2 K := by
      constructor
      · intro h
        exact ⟨x, h, rfl⟩
      · rintro ⟨y, hy, hyx⟩
        have : y = x := Subtype.ext hyx
        exact this ▸ hy
    rw [key2]
    constructor
    · intro h
      refine uc22p20b_le_pCoreOf (K := K) (P := K ⊓ pCoreOf 2 L) inf_le_left
        ((uc22p20b_isPGroup_pCoreOf L).to_inf_right) ?_ ⟨x.2, h⟩
      intro k hk y hy
      exact ⟨K.mul_mem (K.mul_mem hk hy.1) (K.inv_mem hk),
        uc22p20b_conj_mem_pCoreOf_self (hKL hk) hy.2⟩
    · intro h
      exact uc22p20b_pCoreOf_le_of_subnormal hsub h
  refine ⟨((QuotientGroup.quotientMulEquivOfEq hker.symm).trans
      (QuotientGroup.quotientKerEquivRange φ)).trans (MulEquiv.subgroupCongr hrange), fun k => ?_⟩
  rfl

theorem uc22p20d_pCore_solvable (L : Subgroup G) : Group.IsSolvable ↥(CFSG.pCore 2 ↥L) := by
  haveI : Group.IsNilpotent ↥(CFSG.pCore 2 ↥L) := (CFSG.pCore_isPGroup (p := 2)).isNilpotent
  infer_instance

theorem uc22p20d_isComponent_image {L C : Subgroup G} (hL : OTwoE ↥L = ⊤)
    (hC : C ∈ CFSG.Quasithin.cComp L) :
    CFSG.IsComponent ((C.subgroupOf L).map (QuotientGroup.mk' (CFSG.pCore 2 ↥L))) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI hPn : (CFSG.pCore 2 ↥L).Normal := CFSG.pCore_normal
  have hlayer : CFSG.layer (↥L ⧸ CFSG.pCore 2 ↥L) = ⊤ := by
    have h1 : (CFSG.layer (↥L ⧸ CFSG.pCore 2 ↥L)).comap (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) =
        ⊤ := hL
    have h2 := Subgroup.map_comap_eq_self_of_surjective
      (QuotientGroup.mk'_surjective (CFSG.pCore 2 ↥L)) (CFSG.layer (↥L ⧸ CFSG.pCore 2 ↥L))
    rw [h1, Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] at h2
    exact h2.symm
  haveI hPs := uc22p20d_pCore_solvable L
  have hK' : C.subgroupOf L ∈ CFSG.Quasithin.cComp (⊤ : Subgroup ↥L) :=
    CFSG.Quasithin.subgroupOf_mem_cComp hC
  have hKbar := CFSG.Quasithin.map_mem_cComp_top (QuotientGroup.mk' (CFSG.pCore 2 ↥L))
    (QuotientGroup.mk'_surjective _) (by rw [QuotientGroup.ker_mk']; exact hPs) hK'
  exact ⟨uc22p20b_isQuasisimple_cComp_of_layer hlayer hKbar,
    CFSG.Quasithin.A3.subnormal_top_iff.mp (CFSG.Quasithin.subnormal_of_mem_cComp hKbar)⟩

theorem uc22p20d_commute_images {L C C' : Subgroup G} (hL : OTwoE ↥L = ⊤)
    (hC : C ∈ CFSG.Quasithin.cComp L) (hC' : C' ∈ CFSG.Quasithin.cComp L) (hne : C ≠ C') :
    ∀ a ∈ (C.subgroupOf L).map (QuotientGroup.mk' (CFSG.pCore 2 ↥L)),
      ∀ b ∈ (C'.subgroupOf L).map (QuotientGroup.mk' (CFSG.pCore 2 ↥L)), a * b = b * a := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI hPn : (CFSG.pCore 2 ↥L).Normal := CFSG.pCore_normal
  haveI hPs := uc22p20d_pCore_solvable L
  have hA := uc22p20d_isComponent_image hL hC
  have hA' := uc22p20d_isComponent_image hL hC'
  rcases CFSG.LocalCores.distinct_components_commute hA hA' with h | h
  · exfalso
    apply hne
    have hbij := CFSG.Quasithin.cComp_quotient_bijOn (CFSG.pCore 2 ↥L) hPs
    have h1 := hbij.injOn (CFSG.Quasithin.subgroupOf_mem_cComp hC)
      (CFSG.Quasithin.subgroupOf_mem_cComp hC') h
    have h2 : C ⊓ L = C' ⊓ L := Subgroup.subgroupOf_inj.mp h1
    rwa [inf_eq_left.mpr (CFSG.Quasithin.le_of_mem_cComp hC),
      inf_eq_left.mpr (CFSG.Quasithin.le_of_mem_cComp hC')] at h2
  · intro a ha b hb
    exact (Subgroup.mem_centralizer_iff.mp
      ((Subgroup.commutator_eq_bot_iff_le_centralizer.mp h) ha) b hb).symm

@[expose] def uc22p20dB (U C : Subgroup G) : Subgroup G :=
  normalizer ((U ⊓ C : Subgroup G) : Set G) ⊓ C

@[expose] def uc22p20dD (U : Subgroup G) (𝒪 : Set (Subgroup G)) : Subgroup G :=
  ⨆ C ∈ 𝒪, uc22p20dB U C

theorem uc22p20dB_le (U C : Subgroup G) : uc22p20dB U C ≤ C := inf_le_right

theorem uc22p20d_solvable_normalizer_sylow {P C : Subgroup G}
    (hP : CFSG.ABGLocalTools.IsSylowOf 2 P C) :
    Group.IsSolvable ↥(normalizer (P : Set G) ⊓ C) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set N : Subgroup G := normalizer (P : Set G) ⊓ C with hN
  have hPC : P ≤ C := hP.le
  have hPN : P ≤ N := le_inf Subgroup.le_normalizer hPC
  have hnorm : (P.subgroupOf N).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hPN).2 inf_le_left
  haveI := hnorm
  haveI hPs : Group.IsSolvable ↥P := by
    haveI : Group.IsNilpotent ↥P := hP.isPGroup.isNilpotent
    infer_instance
  haveI hPs' : Group.IsSolvable ↥(P.subgroupOf N) :=
    Group.isSolvable_of_isSolvable_injective
      (f := (Subgroup.subgroupOfEquivOfLe hPN).toMonoidHom)
      (Subgroup.subgroupOfEquivOfLe hPN).injective
  have hodd : Odd (Nat.card (↥N ⧸ P.subgroupOf N)) := by
    have h1 := (CFSG.ABGLocalTools.isSylowOf_iff.1 hP).2.2
    have h2 : P.relIndex N ∣ P.relIndex C := by
      rw [← Subgroup.relIndex_mul_relIndex P N C hPN inf_le_right]
      exact dvd_mul_right _ _
    have h3 : ¬ 2 ∣ (P.subgroupOf N).index := fun h => h1 (h.trans h2)
    rw [← Subgroup.index_eq_card]
    exact Nat.odd_iff.2 (by omega)
  haveI : Group.IsSolvable (↥N ⧸ P.subgroupOf N) := CFSG.FeitThompson.isSolvable_of_odd_natCard _ hodd
  exact Group.isSolvable_of_ker_le_range (P.subgroupOf N).subtype
    (QuotientGroup.mk' (P.subgroupOf N)) (by rw [QuotientGroup.ker_mk', Subgroup.range_subtype])

theorem uc22p20d_conj_mem_B {T Y U : Subgroup G} (hU : U = T ⊓ Y) {t : G} (htT : t ∈ T)
    (htY : t ∈ normalizer (Y : Set G)) {C : Subgroup G} {x : G} (hx : x ∈ uc22p20dB U C) :
    t * x * t⁻¹ ∈ uc22p20dB U (uc22p20bCj t C) := by
  have htU : ∀ u : G, u ∈ U ↔ t * u * t⁻¹ ∈ U := by
    intro u
    rw [hU]
    simp only [Subgroup.mem_inf]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨T.mul_mem (T.mul_mem htT h1) (T.inv_mem htT),
        (Subgroup.mem_normalizer_iff.mp htY u).mp h2⟩
    · rintro ⟨h1, h2⟩
      refine ⟨?_, (Subgroup.mem_normalizer_iff.mp htY u).mpr h2⟩
      have := T.mul_mem (T.mul_mem (T.inv_mem htT) h1) htT
      simpa [mul_assoc] using this
  have hconj : ∀ y : G, y ∈ U ⊓ C ↔ t * y * t⁻¹ ∈ U ⊓ uc22p20bCj t C := by
    intro y
    rw [Subgroup.mem_inf, Subgroup.mem_inf, htU y, uc22p20b_mem_cj]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨h1, y, h2, rfl⟩
    · rintro ⟨h1, z, hz, hzy⟩
      have : z = y := by simpa using hzy
      exact ⟨h1, this ▸ hz⟩
  refine Subgroup.mem_inf.2 ⟨?_, uc22p20b_mem_cj.2 ⟨x, hx.2, rfl⟩⟩
  rw [Subgroup.mem_normalizer_iff]
  intro u
  have h1 := hconj (t⁻¹ * u * t)
  have h2 := Subgroup.mem_normalizer_iff.mp hx.1 (t⁻¹ * u * t)
  have h3 := hconj (x * (t⁻¹ * u * t) * x⁻¹)
  have e1 : t * (t⁻¹ * u * t) * t⁻¹ = u := by group
  have e2 : t * (x * (t⁻¹ * u * t) * x⁻¹) * t⁻¹ = (t * x * t⁻¹) * u * (t * x * t⁻¹)⁻¹ := by group
  rw [e1] at h1
  rw [e2] at h3
  exact h1.symm.trans (h2.trans h3)

theorem uc22p20d_T_le_normalizer_D {T Y U : Subgroup G} (hU : U = T ⊓ Y)
    (hTY : T ≤ normalizer (Y : Set G)) (𝒪 : Set (Subgroup G))
    (h𝒪 : ∀ t ∈ T, ∀ C ∈ 𝒪, uc22p20bCj t C ∈ 𝒪) :
    T ≤ normalizer (uc22p20dD U 𝒪 : Set G) := by
  have key : ∀ g ∈ T, ∀ x ∈ uc22p20dD U 𝒪, g * x * g⁻¹ ∈ uc22p20dD U 𝒪 := by
    intro g hg x hx
    have hmap : (uc22p20dD U 𝒪).map (MulAut.conj g).toMonoidHom ≤ uc22p20dD U 𝒪 := by
      rw [uc22p20dD, Subgroup.map_iSup]
      refine iSup_le fun C => ?_
      rw [Subgroup.map_iSup]
      refine iSup_le fun hC => ?_
      rintro _ ⟨z, hz, rfl⟩
      exact (le_iSup₂ (f := fun (C' : Subgroup G) (_ : C' ∈ 𝒪) => uc22p20dB U C')
        (uc22p20bCj g C) (h𝒪 g hg C hC)) (uc22p20d_conj_mem_B hU hg (hTY hg) hz)
    exact hmap ⟨x, hx, by simp [MulAut.conj_apply]⟩
  intro g hg
  rw [Subgroup.mem_normalizer_iff]
  intro x
  refine ⟨key g hg x, fun h => ?_⟩
  have := key g⁻¹ (T.inv_mem hg) _ h
  simpa [mul_assoc] using this

theorem uc22p20d_solvable_D {Y U : Subgroup G} (hOY : OTwoE ↥Y = ⊤)
    (hspan : sSup (CFSG.Quasithin.cComp Y) = Y) (hU : CFSG.ABGLocalTools.IsSylowOf 2 U Y) :
    Group.IsSolvable ↥(uc22p20dD U (CFSG.Quasithin.cComp Y)) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI hPn : (CFSG.pCore 2 ↥Y).Normal := CFSG.pCore_normal
  have hnorm : ∀ C ∈ CFSG.Quasithin.cComp Y, Y ≤ normalizer (C : Set G) := fun C hC => by
    have h := CFSG.Quasithin.cComp_normal_span_of_le hC
    have h2 := (Subgroup.normal_subgroupOf_iff_le_normalizer h.1).1 h.2
    rwa [show CFSG.Quasithin.cCompSpan Y = Y from hspan] at h2
  have hSyl : ∀ C ∈ CFSG.Quasithin.cComp Y, CFSG.ABGLocalTools.IsSylowOf 2 (U ⊓ C) C :=
    fun C hC => hU.inf_of_le_normalizer (CFSG.Quasithin.le_of_mem_cComp hC) (hnorm C hC)
  have hBs : ∀ C ∈ CFSG.Quasithin.cComp Y, Group.IsSolvable ↥(uc22p20dB U C) := fun C hC =>
    uc22p20d_solvable_normalizer_sylow (hSyl C hC)
  have hBY : ∀ C ∈ CFSG.Quasithin.cComp Y, uc22p20dB U C ≤ Y := fun C hC =>
    (uc22p20dB_le U C).trans (CFSG.Quasithin.le_of_mem_cComp hC)
  let φ : ↥Y →* ↥Y ⧸ CFSG.pCore 2 ↥Y := QuotientGroup.mk' (CFSG.pCore 2 ↥Y)
  let Bbar : Subgroup G → Subgroup (↥Y ⧸ CFSG.pCore 2 ↥Y) := fun C =>
    ((uc22p20dB U C).subgroupOf Y).map φ
  let Bj : Subgroup (↥Y ⧸ CFSG.pCore 2 ↥Y) := ⨆ C ∈ CFSG.Quasithin.cComp Y, Bbar C
  have hBbs : ∀ C ∈ CFSG.Quasithin.cComp Y, Group.IsSolvable ↥(Bbar C) := fun C hC => by
    haveI := hBs C hC
    haveI : Group.IsSolvable ↥((uc22p20dB U C).subgroupOf Y) :=
      Group.isSolvable_of_isSolvable_injective
        (f := (Subgroup.subgroupOfEquivOfLe (hBY C hC)).toMonoidHom)
        (Subgroup.subgroupOfEquivOfLe (hBY C hC)).injective
    exact Group.isSolvable_of_surjective (f := φ.subgroupMap ((uc22p20dB U C).subgroupOf Y))
      (φ.subgroupMap_surjective _)
  have hcomm : ∀ C ∈ CFSG.Quasithin.cComp Y, ∀ C' ∈ CFSG.Quasithin.cComp Y, C ≠ C' →
      ∀ a ∈ Bbar C, ∀ b ∈ Bbar C', a * b = b * a := by
    intro C hC C' hC' hne a ha b hb
    have h1 : (uc22p20dB U C).subgroupOf Y ≤ C.subgroupOf Y := fun x hx => uc22p20dB_le U C hx
    have h2 : (uc22p20dB U C').subgroupOf Y ≤ C'.subgroupOf Y := fun x hx => uc22p20dB_le U C' hx
    exact uc22p20d_commute_images hOY hC hC' hne a (Subgroup.map_mono h1 ha) b
      (Subgroup.map_mono h2 hb)
  have hBjn : ∀ C ∈ CFSG.Quasithin.cComp Y, Bj ≤ normalizer (Bbar C : Set _) := by
    intro C hC
    refine iSup₂_le fun C' hC' => ?_
    by_cases hCC : C' = C
    · subst hCC
      exact Subgroup.le_normalizer
    · intro b hb
      exact (Subgroup.centralizer_le_normalizer _) (Subgroup.mem_centralizer_iff.2 fun a ha =>
        hcomm C hC C' hC' (fun h => hCC h.symm) a ha b hb)
  have hBjC : ∀ C ∈ CFSG.Quasithin.cComp Y, Bbar C ≤ Bj := fun C hC =>
    le_iSup₂ (f := fun (C' : Subgroup G) (_ : C' ∈ CFSG.Quasithin.cComp Y) => Bbar C') C hC
  have hBjle : ∀ C ∈ CFSG.Quasithin.cComp Y, Bbar C ≤ CFSG.Quasithin.solvRad Bj := fun C hC =>
    CFSG.Quasithin.le_solvRad (hBjC C hC)
      ((Subgroup.normal_subgroupOf_iff_le_normalizer (hBjC C hC)).2 (hBjn C hC)) (hBbs C hC)
  have hBjs : Group.IsSolvable ↥Bj := by
    have hle : Bj ≤ CFSG.Quasithin.solvRad Bj := iSup₂_le hBjle
    haveI := CFSG.Quasithin.solvRad_isSolvable Bj
    exact Group.isSolvable_of_isSolvable_injective (f := Subgroup.inclusion hle)
      (Subgroup.inclusion_injective hle)
  set D : Subgroup G := uc22p20dD U (CFSG.Quasithin.cComp Y) with hD
  have hDY : D ≤ Y := iSup₂_le fun C hC => hBY C hC
  have hDsub : D ≤ (Bj.comap φ).map Y.subtype := by
    refine iSup₂_le fun C hC x hx => ?_
    have hxY : x ∈ Y := hBY C hC hx
    refine ⟨⟨x, hxY⟩, ?_, rfl⟩
    show φ ⟨x, hxY⟩ ∈ Bj
    exact hBjC C hC (Subgroup.mem_map_of_mem φ (Subgroup.mem_subgroupOf.2 hx))
  let ψ : ↥D →* ↥Y ⧸ CFSG.pCore 2 ↥Y := φ.comp (Subgroup.inclusion hDY)
  have hψ : ∀ d : ↥D, ψ d ∈ Bj := by
    intro d
    obtain ⟨y, hy, hyd⟩ := hDsub d.2
    have e : Subgroup.inclusion hDY d = y := Subtype.ext hyd.symm
    show φ (Subgroup.inclusion hDY d) ∈ Bj
    rw [e]
    exact hy
  let g : ↥D →* ↥Bj := ψ.codRestrict Bj hψ
  haveI hker : Group.IsSolvable ↥g.ker := by
    have hk : ∀ x : ↥g.ker, Subgroup.inclusion hDY (x : ↥D) ∈ CFSG.pCore 2 ↥Y := by
      intro x
      have h1 : g x = 1 := x.2
      have h2 : ψ x = 1 := congrArg Subtype.val h1
      exact (QuotientGroup.eq_one_iff _).1 h2
    let k : ↥g.ker →* ↥(CFSG.pCore 2 ↥Y) :=
      ((Subgroup.inclusion hDY).comp g.ker.subtype).codRestrict _ hk
    haveI := uc22p20d_pCore_solvable Y
    refine Group.isSolvable_of_isSolvable_injective (f := k) (fun a b hab => ?_)
    have h1 : Subgroup.inclusion hDY (a : ↥D) = Subgroup.inclusion hDY (b : ↥D) :=
      congrArg Subtype.val hab
    exact Subtype.ext (Subtype.ext (congrArg (fun z : ↥Y => (z : G)) h1))
  haveI := hBjs
  exact Group.isSolvable_of_ker_le_range g.ker.subtype g (by rw [Subgroup.range_subtype])


theorem uc22p20d_transport_sylow {X X' : Type} [Group X] [Group X'] [Finite X] (e : X ≃* X')
    {p : ℕ}
    (h : ∀ P : Sylow 2 X, ∃ x ∈ Subgroup.normalizer ((P : Subgroup X) : Set X), orderOf x = p ∧
      x ∉ Subgroup.center X) :
    ∀ P' : Sylow 2 X', ∃ x ∈ Subgroup.normalizer ((P' : Subgroup X') : Set X'), orderOf x = p ∧
      x ∉ Subgroup.center X' := by
  intro P'
  obtain ⟨P, hP⟩ := Sylow.mapSurjective_surjective (f := (e : X →* X')) e.surjective 2 P'
  obtain ⟨x, hx, hxo, hxz⟩ := h P
  have hP' : (P' : Subgroup X') = (P : Subgroup X).map (e : X →* X') := by
    rw [← hP]; rfl
  refine ⟨e x, ?_, ?_, ?_⟩
  · rw [hP', Subgroup.mem_normalizer_iff]
    intro y
    obtain ⟨z, rfl⟩ := e.surjective y
    have h1 := Subgroup.mem_normalizer_iff.mp hx z
    constructor
    · rintro ⟨z', hz', hzz'⟩
      have : z' = z := e.injective hzz'
      subst this
      exact ⟨x * z' * x⁻¹, h1.mp hz', by simp⟩
    · rintro ⟨w, hw, hwy⟩
      have : w = x * z * x⁻¹ := e.injective (by simpa using hwy)
      subst this
      exact ⟨z, h1.mpr hw, rfl⟩
  · rw [← hxo]
    exact orderOf_injective (e : X →* X') e.injective x
  · intro hcen
    apply hxz
    rw [Subgroup.mem_center_iff]
    intro z
    apply e.injective
    rw [map_mul, map_mul]
    exact Subgroup.mem_center_iff.mp hcen (e z)

theorem uc22p20d_bar2_conj (g : G) (K : Subgroup G) :
    Nonempty (Bar2 K ≃* Bar2 (uc22p20bCj g K)) :=
  ⟨QuotientGroup.congr (CFSG.pCore 2 ↥K) (CFSG.pCore 2 ↥(uc22p20bCj g K))
    (MulEquiv.subgroupMap (MulAut.conj g) K)
    (CFSG.pCore_map_iso 2 (MulEquiv.subgroupMap (MulAut.conj g) K))⟩

theorem uc22p20d_image_props {Y C : Subgroup G} (hCY : C ≤ Y)
    (hsub : CFSG.Open.IsSubnormal C Y) {p : ℕ} (c : ↥C)
    (hp : (QuotientGroup.mk c : Bar2 C) ^ p = 1)
    (hz : (QuotientGroup.mk c : Bar2 C) ∉ Subgroup.center (Bar2 C)) :
    ((QuotientGroup.mk (Subgroup.inclusion hCY c) : ↥Y ⧸ CFSG.pCore 2 ↥Y)) ^ p = 1 ∧
      ∃ a ∈ (C.subgroupOf Y).map (QuotientGroup.mk' (CFSG.pCore 2 ↥Y)),
        a * (QuotientGroup.mk (Subgroup.inclusion hCY c) : ↥Y ⧸ CFSG.pCore 2 ↥Y) ≠
          (QuotientGroup.mk (Subgroup.inclusion hCY c) : ↥Y ⧸ CFSG.pCore 2 ↥Y) * a := by
  obtain ⟨e, he⟩ := uc22p20d_bar2Equiv hCY hsub
  have hy := he c
  refine ⟨?_, ?_⟩
  · rw [← hy, ← Subgroup.coe_pow, ← map_pow, hp, map_one]
    rfl
  · rw [Subgroup.mem_center_iff] at hz
    push Not at hz
    obtain ⟨a', ha'⟩ := hz
    refine ⟨(e a' : ↥Y ⧸ CFSG.pCore 2 ↥Y), (e a').2, ?_⟩
    rw [← hy]
    intro h
    apply ha'
    apply e.injective
    apply Subtype.ext
    simpa using h

theorem uc22p20d_mem_B {C U : Subgroup G} (hU : CFSG.ABGLocalTools.IsSylowOf 2 (U ⊓ C) C)
    (p : ℕ)
    (hP : ∀ P : Sylow 2 (Bar2 C), ∃ x ∈ Subgroup.normalizer ((P : Subgroup (Bar2 C)) : Set (Bar2 C)),
      orderOf x = p ∧ x ∉ Subgroup.center (Bar2 C)) :
    ∃ c : ↥C, ((c : ↥C) : G) ∈ uc22p20dB U C ∧ orderOf (QuotientGroup.mk c : Bar2 C) = p ∧
      (QuotientGroup.mk c : Bar2 C) ∉ Subgroup.center (Bar2 C) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨Q, hQ⟩ := hU.exists_sylow_eq_subgroupOf
  haveI hOn : (CFSG.pCore 2 ↥C).Normal := CFSG.pCore_normal
  have hOQ : CFSG.pCore 2 ↥C ≤ (Q : Subgroup ↥C) :=
    (CFSG.pCore_isPGroup (p := 2) (G := ↥C)).le_sylow_of_normal Q
  have hπ : Function.Surjective (QuotientGroup.mk' (CFSG.pCore 2 ↥C)) :=
    QuotientGroup.mk'_surjective _
  obtain ⟨x₀, hx₀N, hx₀o, hx₀z⟩ := hP (Q.mapSurjective hπ)
  obtain ⟨c, rfl⟩ := QuotientGroup.mk_surjective x₀
  refine ⟨c, ?_, hx₀o, hx₀z⟩
  have hmemQ : ∀ q : ↥C, q ∈ (Q : Subgroup ↥C) ↔
      QuotientGroup.mk' (CFSG.pCore 2 ↥C) q ∈ (Q.mapSurjective hπ : Subgroup (Bar2 C)) := by
    intro q
    have h := Subgroup.comap_map_eq_self (f := QuotientGroup.mk' (CFSG.pCore 2 ↥C))
      (H := (Q : Subgroup ↥C)) (by rwa [QuotientGroup.ker_mk'])
    have h' : q ∈ (Q : Subgroup ↥C) ↔
        q ∈ ((Q : Subgroup ↥C).map (QuotientGroup.mk' (CFSG.pCore 2 ↥C))).comap
          (QuotientGroup.mk' (CFSG.pCore 2 ↥C)) := by rw [h]
    rw [h', Subgroup.mem_comap]
    exact Iff.rfl
  have hcQ : ∀ q : ↥C, q ∈ (Q : Subgroup ↥C) ↔ c * q * c⁻¹ ∈ (Q : Subgroup ↥C) := by
    intro q
    rw [hmemQ q, hmemQ (c * q * c⁻¹)]
    have := Subgroup.mem_normalizer_iff.mp hx₀N (QuotientGroup.mk' (CFSG.pCore 2 ↥C) q)
    simpa using this
  refine Subgroup.mem_inf.2 ⟨?_, c.2⟩
  rw [Subgroup.mem_normalizer_iff]
  intro u
  by_cases hu : u ∈ C
  · have hmem : ∀ w : ↥C, w ∈ (Q : Subgroup ↥C) ↔ ((w : ↥C) : G) ∈ U ⊓ C := by
      intro w
      rw [hQ]
      exact Subgroup.mem_subgroupOf
    have h1 := hmem ⟨u, hu⟩
    have h2 := hmem (c * ⟨u, hu⟩ * c⁻¹)
    have h3 := hcQ ⟨u, hu⟩
    have e : (((c * ⟨u, hu⟩ * c⁻¹ : ↥C) : ↥C) : G) = (c : G) * u * (c : G)⁻¹ := rfl
    rw [e] at h2
    exact h1.symm.trans (h3.trans h2)
  · have h2 : (c : G) * u * (c : G)⁻¹ ∉ C := by
      intro h
      apply hu
      have := C.mul_mem (C.mul_mem (C.inv_mem c.2) h) c.2
      simpa [mul_assoc] using this
    exact ⟨fun h => absurd (Subgroup.mem_inf.1 h).2 hu, fun h => absurd (Subgroup.mem_inf.1 h).2 h2⟩

theorem uc22p20d_isElemAbelian_map {A B : Type*} [Group A] [Group B] (f : A →* B)
    (hf : Function.Injective f) {p : ℕ} {E : Subgroup A} (hE : IsElemAbelian p E) :
    IsElemAbelian p (E.map f) := by
  refine ⟨?_, ?_⟩
  · haveI := hE.1
    refine IsMulCommutative.of_setLike_mul_comm fun x hx y hy => ?_
    obtain ⟨a, ha, rfl⟩ := hx
    obtain ⟨b, hb, rfl⟩ := hy
    rw [← map_mul, ← map_mul]
    exact congrArg f (setLike_mul_comm ha hb)
  · rintro _ ⟨a, ha, rfl⟩
    rw [← map_pow, hE.2 a ha, map_one]


@[expose] def QuasisimpleDichotomy : Prop :=
  ∀ (X : Type) [Group X] [Finite X], CFSG.Open.IsQuasisimple X →
    CFSG.Assembly.InCatalog (X ⧸ Subgroup.center X) →
    (∃ x : X, orderOf x = 3 ∧ x ∉ Subgroup.center X) ∨
    ∃ p : ℕ, p.Prime ∧ p ≠ 2 ∧ ∀ P : Sylow 2 X,
      ∃ x ∈ Subgroup.normalizer ((P : Subgroup X) : Set X), orderOf x = p ∧
        x ∉ Subgroup.center X

@[expose] def SuzukiCoverFact : Prop :=
  ∀ (X : Type) [Group X] [Finite X], CFSG.Open.IsQuasisimple X →
    (∃ f : ℕ, CFSG.Blueprint.SuzukiModel (X ⧸ Subgroup.center X) 2 f) →
    ∃ p : ℕ, p.Prime ∧ p ≠ 2 ∧ ∀ P : Sylow 2 X,
      ∃ x ∈ Subgroup.normalizer ((P : Subgroup X) : Set X), orderOf x = p ∧
        x ∉ Subgroup.center X

@[expose] def ThreeNoncentralFact : Prop :=
  ∀ (X : Type) [Group X] [Finite X], CFSG.Open.IsQuasisimple X →
    CFSG.Assembly.InCatalog (X ⧸ Subgroup.center X) →
    3 ∣ Nat.card (X ⧸ Subgroup.center X) → ∃ x : X, orderOf x = 3 ∧ x ∉ Subgroup.center X

theorem quasisimpleDichotomy_of_parts
    (hKPSz : ∀ (S : Type) [Group S] [Finite S] [IsSimpleGroup S], (∃ a b : S, a * b ≠ b * a) →
      CFSG.Assembly.InCatalog S → ¬ 3 ∣ Nat.card S → ∃ f : ℕ, CFSG.Blueprint.SuzukiModel S 2 f)
    (hS : SuzukiCoverFact) (h3 : ThreeNoncentralFact) : QuasisimpleDichotomy := by
  intro X _ _ hq hcat
  by_cases h : 3 ∣ Nat.card (X ⧸ Subgroup.center X)
  · exact Or.inl (h3 X hq hcat h)
  · refine Or.inr (hS X hq ?_)
    haveI : IsSimpleGroup (X ⧸ Subgroup.center X) := hq.2
    have hnab := CFSG.ComponentClassification.Helpers.quasisimple_central_quotient_nonabelian X hq
    exact hKPSz _ hnab hcat h

@[expose] def S20_2Alt (K : Subgroup G) : Prop :=
  ((∃ r : ℕ, r.Prime ∧ r ≠ 2 ∧
      ∀ C ∈ CFSG.Quasithin.cComp K, IsL2Odd (BarInf C) r ∨ IsL3Odd (BarInf C) r) ∨
    ∀ C ∈ CFSG.Quasithin.cComp K, IsAlt (BarInf C) 6 ∨ IsAlt (BarInf C) 7) ∧
    ∃ p : ℕ, p.Prime ∧ p ≠ 2 ∧ 1 < CFSG.Open.pRank p (CFSG.Quasithin.E1.oTwoP ↥K p)

@[expose] def FiveConjugatesNotAlt (D : Data G) : Prop :=
  ∀ H ∈ hSet D.T D.M, CFSG.Open.pRank 3 H ≤ 3 → ∀ K ∈ CFSG.Quasithin.cComp H, ∀ g : Fin 5 → G, (∀ i, g i ∈ H) →
    Function.Injective (fun i => uc22p20bCj (g i) K) → ¬ S20_2Alt (uc22p20bOrb H K)

theorem uc22p20d_isSylowOf_inf_comp {Y U : Subgroup G}
    (hspan : sSup (CFSG.Quasithin.cComp Y) = Y) (hU : CFSG.ABGLocalTools.IsSylowOf 2 U Y) :
    ∀ C ∈ CFSG.Quasithin.cComp Y, CFSG.ABGLocalTools.IsSylowOf 2 (U ⊓ C) C := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  intro C hC
  have h := CFSG.Quasithin.cComp_normal_span_of_le hC
  have h2 := (Subgroup.normal_subgroupOf_iff_le_normalizer h.1).1 h.2
  rw [show CFSG.Quasithin.cCompSpan Y = Y from hspan] at h2
  exact hU.inf_of_le_normalizer (CFSG.Quasithin.le_of_mem_cComp hC) h2

theorem uc22p20d_not_mem_center_map {X X' : Type*} [Group X] [Group X'] (e : X ≃* X') {x : X}
    (hx : x ∉ Subgroup.center X) : e x ∉ Subgroup.center X' := by
  intro hcen
  apply hx
  rw [Subgroup.mem_center_iff]
  intro z
  apply e.injective
  rw [map_mul, map_mul]
  exact Subgroup.mem_center_iff.mp hcen (e z)

theorem uc22p20d_inCatalog_bar2 (hKP : CFSG.Open.IsKProper G) {K : Subgroup G} (hK : K ≠ ⊤)
    (hq : CFSG.Open.IsQuasisimple (Bar2 K)) :
    CFSG.Assembly.InCatalog (Bar2 K ⧸ Subgroup.center (Bar2 K)) := by
  haveI : (CFSG.pCore 2 ↥K).Normal := CFSG.pCore_normal
  have hKK : CFSG.Open.IsKGroup ↥K := hKP.isKGroup K hK
  have hB : CFSG.Open.IsKGroup (Bar2 K) := hKK.quotient _
  haveI : IsSimpleGroup (Bar2 K ⧸ Subgroup.center (Bar2 K)) := hq.2
  have hnab :=
    CFSG.ComponentClassification.Helpers.quasisimple_central_quotient_nonabelian (Bar2 K) hq
  exact hB.isCatalogGroup_of_surjective ⊤ hnab
    ((QuotientGroup.mk' (Subgroup.center (Bar2 K))).comp
      (Subgroup.topEquiv (G := Bar2 K)).toMonoidHom)
    ((QuotientGroup.mk'_surjective _).comp (Subgroup.topEquiv (G := Bar2 K)).surjective)


theorem uc22p20d_rank_data (D : Data G) (hQ : QuasisimpleDichotomy) {H : Subgroup G}
    (hHtop : H ≠ ⊤) (hH : H ∈ hSet D.T D.M) {K : Subgroup G} (hK : K ∈ CFSG.Quasithin.cComp H)
    (g : Fin 5 → G) (hg : ∀ i, g i ∈ H) (hinj : Function.Injective fun i => uc22p20bCj (g i) K)
    (hO : OTwoE ↥(uc22p20bOrb H K) = ⊤) :
    ∃ p : ℕ, p.Prime ∧ p ≠ 2 ∧ ∃ E : Subgroup G, E ≤ H ∧ IsElemAbelian p E ∧
      Nat.card E = p ^ 5 ∧
      (p = 3 ∨ ∃ Z : Subgroup G, D.T ≤ Z ∧ Z ≤ H ∧ Group.IsSolvable ↥Z ∧ E ≤ Z) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set Y : Subgroup G := uc22p20bOrb H K with hYdef
  have hKH : K ≤ H := CFSG.Quasithin.le_of_mem_cComp hK
  have hYH : Y ≤ H := uc22p20b_orb_le le_rfl hKH
  have hHn : H ≤ normalizer (Y : Set G) := uc22p20b_le_normalizer_orb H K
  have hspan : sSup (CFSG.Quasithin.cComp Y) = Y := uc22p20b_sSup_cComp_orb hK le_rfl
  have hcC : CFSG.Quasithin.cComp Y = Set.range (fun t : H => uc22p20bCj (t : G) K) :=
    uc22p20b_cComp_orb hK le_rfl
  have hKi : ∀ i, uc22p20bCj (g i) K ∈ CFSG.Quasithin.cComp Y := fun i => by
    rw [hcC]; exact ⟨⟨g i, hg i⟩, rfl⟩
  have hK0 : K ∈ CFSG.Quasithin.cComp Y := by
    rw [hcC]; exact ⟨⟨1, H.one_mem⟩, uc22p20b_cj_one K⟩
  have hqs : CFSG.Open.IsQuasisimple (Bar2 K) := uc22p20b_isQuasisimple_bar2 hO hK0
  have hKiY : ∀ i, uc22p20bCj (g i) K ≤ Y := fun i => CFSG.Quasithin.le_of_mem_cComp (hKi i)
  have hKisub : ∀ i, CFSG.Open.IsSubnormal (uc22p20bCj (g i) K) Y := fun i =>
    CFSG.Quasithin.subnormal_of_mem_cComp (hKi i)
  have hne : ∀ i j, i ≠ j → uc22p20bCj (g i) K ≠ uc22p20bCj (g j) K :=
    fun i j h h' => h (hinj h')
  have e : ∀ i, Bar2 K ≃* Bar2 (uc22p20bCj (g i) K) := fun i =>
    (uc22p20d_bar2_conj (g i) K).some
  haveI hPn : (CFSG.pCore 2 ↥Y).Normal := CFSG.pCore_normal
  let φ : ↥Y →* ↥Y ⧸ CFSG.pCore 2 ↥Y := QuotientGroup.mk' (CFSG.pCore 2 ↥Y)
  let A : Fin 5 → Subgroup (↥Y ⧸ CFSG.pCore 2 ↥Y) := fun i =>
    ((uc22p20bCj (g i) K).subgroupOf Y).map φ
  have hcomm : ∀ i j, i ≠ j → ∀ a ∈ A i, ∀ b ∈ A j, a * b = b * a := fun i j hij =>
    uc22p20d_commute_images hO (hKi i) (hKi j) (hne i j hij)
  have hmemA : ∀ (i : Fin 5) (c : ↥(uc22p20bCj (g i) K)),
      (QuotientGroup.mk (Subgroup.inclusion (hKiY i) c) : ↥Y ⧸ CFSG.pCore 2 ↥Y) ∈ A i :=
    fun i c => Subgroup.mem_map.2 ⟨Subgroup.inclusion (hKiY i) c,
      Subgroup.mem_subgroupOf.2 c.2, rfl⟩
  have hcat : CFSG.Assembly.InCatalog (Bar2 K ⧸ Subgroup.center (Bar2 K)) :=
    uc22p20d_inCatalog_bar2 D.standing.kProper
      (fun h => hHtop (top_le_iff.mp (h ▸ hKH))) hqs
  rcases hQ (Bar2 K) hqs hcat with ⟨x₀, hx₀o, hx₀z⟩ | ⟨p, hp, hp2, hP⟩
  ·
    have hsel : ∀ i, ∃ c : ↥(uc22p20bCj (g i) K),
        (QuotientGroup.mk c : Bar2 (uc22p20bCj (g i) K)) = e i x₀ := fun i =>
      QuotientGroup.mk_surjective (e i x₀)
    choose c hc using hsel
    have hx₀p : x₀ ^ 3 = 1 := by rw [← hx₀o]; exact pow_orderOf_eq_one x₀
    have hprops := fun i => uc22p20d_image_props (hKiY i) (hKisub i) (p := 3) (c i)
      (by rw [hc i, ← map_pow, hx₀p, map_one])
      (by rw [hc i]; exact uc22p20d_not_mem_center_map (e i) hx₀z)
    obtain ⟨E₀, -, hE₀, hE₀c⟩ := uc22p20d_elemAbelian_of_commuting
      (X := ↥Y ⧸ CFSG.pCore 2 ↥Y) 3 5 Nat.prime_three A
      (fun i => (QuotientGroup.mk (Subgroup.inclusion (hKiY i) (c i)) : ↥Y ⧸ CFSG.pCore 2 ↥Y))
      hcomm (fun i => hmemA i (c i)) (fun i => (hprops i).1) (fun i => (hprops i).2)
    obtain ⟨E, -, hE, hEc⟩ := uc22p20d_lift_elemAbelian (CFSG.pCore 2 ↥Y)
      (CFSG.pCore_isPGroup) Nat.prime_three (by norm_num) (⊤ : Subgroup ↥Y) E₀ hE₀ hE₀c
      (by rw [Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]; exact le_top)
    refine ⟨3, Nat.prime_three, by norm_num, E.map Y.subtype,
      (Subgroup.map_subtype_le E).trans hYH,
      uc22p20d_isElemAbelian_map Y.subtype Y.subtype_injective hE, ?_, Or.inl rfl⟩
    rw [Subgroup.card_map_of_injective Y.subtype_injective, hEc]
  ·
    set U : Subgroup G := D.T ⊓ Y with hU
    have hTH : CFSG.ABGLocalTools.IsSylowOf 2 D.T H := D.sylowG.of_le hH.1 le_top
    have hUY : CFSG.ABGLocalTools.IsSylowOf 2 U Y := hTH.inf_of_le_normalizer hYH hHn
    have hSyl := uc22p20d_isSylowOf_inf_comp hspan hUY
    have hsel : ∀ i, ∃ c : ↥(uc22p20bCj (g i) K),
        ((c : ↥(uc22p20bCj (g i) K)) : G) ∈ uc22p20dB U (uc22p20bCj (g i) K) ∧
          orderOf (QuotientGroup.mk c : Bar2 (uc22p20bCj (g i) K)) = p ∧
          (QuotientGroup.mk c : Bar2 (uc22p20bCj (g i) K)) ∉
            Subgroup.center (Bar2 (uc22p20bCj (g i) K)) := fun i =>
      uc22p20d_mem_B (hSyl _ (hKi i)) p (uc22p20d_transport_sylow (e i) hP)
    choose c hcB hco hcz using hsel
    have hprops := fun i => uc22p20d_image_props (hKiY i) (hKisub i) (p := p) (c i)
      (by rw [← hco i]; exact pow_orderOf_eq_one _) (hcz i)
    obtain ⟨E₀, hE₀le, hE₀, hE₀c⟩ := uc22p20d_elemAbelian_of_commuting
