theorem rankThreeGamma_le_of_isSL3Four_of_three_le {M L R : Subgroup G} {p : ℕ} [Fact p.Prime]
    (hp2 : p ≠ 2) (hp3 : p ≠ 3) (hsp : IsStronglyPEmbedded p M) (h76 : Conclusion76 M p)
    (hpM : 3 ≤ CFSG.Open.pRank p M) (hL : L ∈ calC M) (hc2 : (conjSetOf M L).ncard ≤ 2)
    (hSL : IsSL3Four (Bar2 L)) (hR : CFSG.ABGLocalTools.IsSylowOf 3 R L) :
    CFSG.Open.rankThreeGamma 1 3 R ≤ M := by
  classical
  have hpp : p.Prime := Fact.out
  have hLM : L ≤ M := hL.1.le
  have hLrank_ge : 2 ≤ CFSG.Open.pRank 3 L := by
    rw [← CFSG.LocalAnalysis.UniquenessCase.UC22.pRank_bar2_eq_of_odd
      (Y := L) (p := 3) Nat.prime_three (by norm_num : (3 : ℕ) ≠ 2)]
    refine CFSG.GroupTheory.two_le_pRank_of_quotient (Y := Bar2 L)
      (N := Subgroup.center (Bar2 L)) (p := 3) Nat.prime_three
      (by norm_num : (3 : ℕ) ≠ 2) ?_
    obtain ⟨K, hfield, hfin, hKcard, ⟨e⟩⟩ :=
      CFSG.RankThree.PartOne.AUTSL.exists_projectiveSL_equiv_of_lieModel hSL.1.2
    letI := hfield
    letI := hfin
    have hk : Nat.card K = 4 := by rw [hKcard]; norm_num
    rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv (p := 3) (by norm_num) e]
    simpa only [CFSG.SectionRank.pRank_eq_open_pRank_top] using
      (CFSG.RankThree.PartTwo.KFacts.L34.pRank_three_projectiveSL hk).ge
  have hRrank : 2 ≤ CFSG.Open.pRank 3 R := by
    rw [CFSG.LocalAnalysis.RankFourTheoremC.pRank_eq_of_isSylowOf Nat.prime_three hR]
    exact hLrank_ge
  have hRM : R ≤ M := hR.le.trans hLM
  set N : Subgroup G := M ⊓ Subgroup.normalizer (L : Set G) with hNdef
  have hNle : N ≤ Subgroup.normalizer (L : Set G) := inf_le_right
  have hMN : CFSG.Open.pRank p M = CFSG.Open.pRank p N := by
    refine le_antisymm ?_ (CFSG.SectionRank.pRank_mono hpp.one_lt inf_le_left)
    obtain ⟨E, hEM, hEel, hEcard⟩ := CFSG.SectionRank.exists_pRank hpp.one_lt M
    have hEN : E ≤ N := by
      refine le_inf hEM ?_
      rw [Subgroup.le_normalizer_iff]
      intro x hx y hy
      have hxM : x ∈ M := hEM hx
      have hpow : x ^ p = 1 := hEel.2 x hx
      have hodd : Odd (orderOf x) := by
        have hdvd : orderOf x ∣ p := orderOf_dvd_of_pow_eq_one hpow
        rcases (Nat.dvd_prime hpp).mp hdvd with h1 | hSp
        · rw [h1]; norm_num
        · rw [hSp]
          exact hpp.odd_of_ne_two hp2
      exact (Subgroup.mem_normalizer_iff.mp
        (mem_normalizer_of_ncard_conjSetOf_le_two_of_odd_order hc2 hxM hodd) y).mp hy
    exact CFSG.SectionRank.le_pRank hpp.one_lt hEN hEel hEcard
  have hrankIneq := CFSG.GroupTheory.pRank_le_pRank_map_ker_add_pRank_range
    (p := 2) (q := p) hpp L N hNle
  have hcardAut : Nat.card (MulAut (Bar2 L ⧸ Subgroup.center (Bar2 L))) =
      2 ^ 8 * 3 ^ 3 * 5 * 7 := by
    obtain ⟨K, hfield, hfin, hKcard, ⟨e⟩⟩ :=
      CFSG.RankThree.PartOne.AUTSL.exists_projectiveSL_equiv_of_lieModel hSL.1.2
    letI := hfield
    letI := hfin
    have hk : Nat.card K = 4 := by rw [hKcard]; norm_num
    rw [Nat.card_congr (MulAut.congr e).toEquiv,
      CFSG.RankThree.PartTwo.KFacts.L34.card_mulAut hk]
    norm_num
  have hrange : CFSG.Open.pRank p
      (CFSG.GroupTheory.conjModPCore 2 L N hNle).range ≤ 1 := by
    refine (CFSG.SectionRank.pRank_mono hpp.one_lt le_top).trans ?_
    have hperf : Group.IsPerfect (Bar2 L) := Group.isPerfect_def.mpr hSL.1.1.1
    have : Group.IsPerfect (Bar2 L) := hperf
    refine (CFSG.HardMathSupport.Timmesfeld.Tables.Multiplier.pRank_mulAut_le
      (J := Bar2 L) hpp).trans ?_
    refine CFSG.QuasithinUnique.Id2519.pRank_le_one_of_not_sq_dvd hpp ?_
    rw [hcardAut]
    exact CFSG.LocalAnalysis.UniquenessCase.PartTwo.S17.prime_sq_not_dvd_aut_L34 hpp hp2 hp3
  obtain ⟨Sₚ, hSₚ⟩ := CFSG.ABGLocalTools.exists_isSylowOf (p := p)
    ((CFSG.GroupTheory.conjModPCore 2 L N hNle).ker.map N.subtype)
  have hSpRank : CFSG.Open.pRank p Sₚ =
      CFSG.Open.pRank p ((CFSG.GroupTheory.conjModPCore 2 L N hNle).ker.map N.subtype) :=
    CFSG.LocalAnalysis.RankFourTheoremC.pRank_eq_of_isSylowOf hpp hSₚ
  have hSpK : Sₚ ≤ (CFSG.GroupTheory.conjModPCore 2 L N hNle).ker.map N.subtype := hSₚ.le
  have hSpM : Sₚ ≤ M := (hSpK.trans (Subgroup.map_subtype_le _)).trans inf_le_left
  have hSpN : Sₚ ≤ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
    (hSpK.trans (Subgroup.map_subtype_le _)).trans
      (hNle.trans (CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf (r := 2) L))
  have hRN : R ≤ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
    hR.le.trans (CFSG.LieType.BorelTits.le_normalizer_pCoreOf (r := 2) L)
  have hcomm : ⁅Sₚ, R⁆ ≤ pCoreOf 2 L := by
    rw [Subgroup.commutator_le]
    intro s hs r hr
    have hsK : s ∈ (CFSG.GroupTheory.conjModPCore 2 L N hNle).ker.map N.subtype := hSpK hs
    have hmem := ((CFSG.GroupTheory.mem_map_ker_conjModPCore_iff 2 L N hNle).1 hsK).2
      r (hR.le hr)
    simpa [commutatorElement_def] using hmem
  have hpCore : ¬ p ∣ Nat.card (pCoreOf 2 L) :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup
      (CFSG.LieType.BorelTits.pCoreOf_isPGroup (r := 2) L) hpp hp2
  have h3Core : ¬ 3 ∣ Nat.card (pCoreOf 2 L) :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup
      (CFSG.LieType.BorelTits.pCoreOf_isPGroup (r := 2) L)
      Nat.prime_three (by norm_num : (3 : ℕ) ≠ 2)
  have hkey : 2 ≤ CFSG.Open.pRank p (M ⊓ Subgroup.centralizer (R : Set G)) := by
    have hKle : CFSG.Open.pRank p
        ((CFSG.GroupTheory.conjModPCore 2 L N hNle).ker.map N.subtype) ≤
        CFSG.Open.pRank p (M ⊓ Subgroup.centralizer (R : Set G)) := by
      rw [← hSpRank]
      exact CFSG.GroupTheory.pRank_le_pRank_inf_centralizer_of_commutator_le
        (p := p) (q := 3) (M := M) (N := pCoreOf 2 L)
        (R := Sₚ) (B := R) hSpM
        ((CFSG.LieType.BorelTits.pCoreOf_le 2 L).trans hLM)
        hSpN hRN hSₚ.isPGroup hR.isPGroup hpCore h3Core hcomm
    omega
  exact Section7.rankThreeGamma_le_of_two_le_pRank_inf_centralizer
    hsp h76 hRM hR.isPGroup hRrank hkey

theorem rankThreeGamma_le_of_isSL3Four_of_mem_sig (D : Data G) (hSg : UC6S846.SigmaStd D)
    (h76 : ∀ p ∈ D.sig, p ≠ 3 → IsStronglyPEmbedded p D.M → Conclusion76 D.M p)
    {p : ℕ} (hp : p ∈ D.sig) (hp3 : p ≠ 3) {L R : Subgroup G} (hL : L ∈ calC D.M)
    (hc2 : (conjSetOf D.M L).ncard ≤ 2) (hSL : IsSL3Four (Bar2 L))
    (hR : CFSG.ABGLocalTools.IsSylowOf 3 R L) :
    CFSG.Open.rankThreeGamma 1 3 R ≤ D.M := by
  obtain ⟨hpp, hp2⟩ := D.sig_prime p hp
  have : Fact p.Prime := ⟨hpp⟩
  have hsp : IsStronglyPEmbedded p D.M :=
    UC6S846.sp_of_mem_sig hSg (UC6S846.not_solvable_of_mem_calC hL) hp
  exact rankThreeGamma_le_of_isSL3Four_of_three_le hp2 hp3 hsp (h76 p hp hp3 hsp)
    (hSg.three_le p hp) hL hc2 hSL hR

