theorem coverCoreG_of_choiceX_of_uniqueSet {G : Type} [Group G] [Finite G] (D : Data G)
    (hSg : CFSG.LocalAnalysis.UniquenessCase.UC6S846.SigmaStd D) (h69 : UC6.R6_9 D)
    (h857 : R857 D) (h859 : R859 D) {L Q P X : Subgroup G}
    (hXL : ⁅L, X⁆ ≤ pCoreOf 2 L) (h : ChoiceX D L Q P X)
    (hcov : IsA6Z3 (Bar2 L) ∨ IsA7Z3 (Bar2 L) ∨ IsM22Z3 (Bar2 L))
    (hLM : D.M ≤ normalizer (L : Set G))
    (hU : ∀ Y : Subgroup G, Y ≤ P → normalizer (Y : Set G) ≤ D.M → Y ∈ uniqueSet D.M) :
    ∃ LX : Subgroup G, CoverCoreG D.M (centralizer (X : Set G)) (ZOf Q) Q LX := by
  have hcex : Cex856 D L Q P := h.cex
  have hQext : IsExtraspecialExpP 3 1 ↥Q := (h857 L Q P hcex).2.2 hcov
  have hZcard : Nat.card (ZOf Q) = 3 := card_ZOf_of_isExtraspecialExpP hQext
  have hZQ : ZOf Q ≤ Q := inf_le_left
  have hNZ : normalizer (ZOf Q : Set G) ≤ D.M :=
    normalizer_le_of_card_three_of_gamma hcex.gamma hZQ hZcard
  have hZU : ZOf Q ∈ uniqueSet D.M := hU (ZOf Q) (hZQ.trans hcex.le) hNZ
  have hwc : IsWeaklyClosedIn (ZOf Q) (normalizer (ZOf Q : Set G)) :=
    isWeaklyClosedIn_normalizer_of_uniqueSet hZU (cover_weakClosure_local h hcov hLM h857)
  have hQC : Q ≤ centralizer (X : Set G) := fun a ha =>
    mem_centralizer_iff.mpr fun x hx => h.centralizes_sylowQ h859 hXL x hx a ha
  have hZC : ZOf Q ≤ centralizer (X : Set G) := fun z hz => hQC (hZQ hz)
  have hXbot : X ≠ ⊥ := by
    intro hb
    have := h.card
    rw [hb, Subgroup.card_bot] at this
    omega
  have hsub : D.sig ⊆ D.sig1 :=
    CFSG.LocalAnalysis.UniquenessCase.UC6S846.sig_subset_sig1 hSg
      (CFSG.LocalAnalysis.UniquenessCase.UC6S846.not_solvable_of_mem_calC hcex.mem)
  have hrk : CFSG.Open.pRank 3 D.M ≤ 3 :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.R8107E3.pRank_three_le_three_of_not_sp hSg
      hcex.notStrong hcex.mem
  obtain ⟨LX, hLXle, hLXq, hLXcov, hQLX, hZLX, hLXnorm⟩ :=
    quasisimple_centralizer_cover h hcov hLM h69 hsub h857 h859 hXL
  refine ⟨LX, ?_⟩
  exact
    { kgroup := isKGroup_centralizer_of_ne_bot D.standing hXbot
      rank := pRank_top_le_three_of_mem_uniqueSet hZU hZC hZcard hrk
      zcard := hZcard
      wc := hwc
      zq := rfl
      qext := hQext
      ql := hQLX
      lC := hLXle.trans inf_le_right
      lM := hLXle.trans (inf_le_left.trans hcex.mem.1.le)
      lq := hLXq
      lcov := hLXcov
      lcz := le_centralizer_iff.mpr hZLX
      lnorm := hLXnorm
      nq := fun A hAQ hA =>
        normalizer_le_of_ne_bot_of_gamma hcex.gamma hcex.sylowQ.isPGroup hAQ hA
      o3 := fun O hQO hO => le_of_isExtraspecialExpP_of_gamma hcex.gamma hQO hO hQext
      kn := cover_not_le_of_notLe h hcov h857 hQC hwc }

theorem coverCoreG_of_choiceX {G : Type} [Group G] [Finite G] (D : Data G)
    (hSg : CFSG.LocalAnalysis.UniquenessCase.UC6S846.SigmaStd D) (h69 : UC6.R6_9 D)
    (h857 : R857 D) (h859 : R859 D) (h862 : R862 D) {L Q P X : Subgroup G}
    (hXL : ⁅L, X⁆ ≤ pCoreOf 2 L) (h : ChoiceX D L Q P X)
    (hcov : IsA6Z3 (Bar2 L) ∨ IsA7Z3 (Bar2 L) ∨ IsM22Z3 (Bar2 L))
    (hLM : D.M ≤ normalizer (L : Set G)) :
    ∃ LX : Subgroup G, CoverCoreG D.M (centralizer (X : Set G)) (ZOf Q) Q LX :=
  coverCoreG_of_choiceX_of_uniqueSet D hSg h69 h857 h859 hXL h hcov hLM (h862 L Q P h.cex).2

