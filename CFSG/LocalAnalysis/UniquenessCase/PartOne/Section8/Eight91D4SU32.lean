private abbrev r891w : CFSG.F4 := CFSG.F4.omega
private def r891lmS : Matrix (Fin 3) (Fin 3) CFSG.F4 := !![0, 0, 1; 1, 0, 0; 0, 1, 0]
private def r891lmD : Matrix (Fin 3) (Fin 3) CFSG.F4 := !![1, 0, 0; 0, r891w, 0; 0, 0, r891w ^ 2]
private def r891lmP : Matrix (Fin 3) (Fin 3) CFSG.F4 := !![1, 0, 0; 0, 0, 1; 0, 1, 0]
private def r891lmF : Matrix (Fin 3) (Fin 3) CFSG.F4 := !![1, 1, 1; 1, r891w, r891w ^ 2; 1,
  r891w ^ 2, r891w]
private def r891lmG : Matrix (Fin 3) (Fin 3) CFSG.F4 := !![1, r891w ^ 2, r891w ^ 2; r891w,
  r891w, r891w ^ 2; r891w, r891w ^ 2, r891w]
private def r891lmZ : Matrix (Fin 3) (Fin 3) CFSG.F4 := !![r891w, 0, 0; 0, r891w, 0; 0, 0, r891w]

private noncomputable def r891suMkL (M : Matrix (Fin 3) (Fin 3) CFSG.F4)
    (h1 : M.det = 1) (h2 : (M.map (· ^ 2))ᵀ * M = 1) : SUg CFSG.F4 :=
  ⟨Matrix.GeneralLinearGroup.mk'' M (h1 ▸ isUnit_one), by
    apply Subgroup.subset_closure
    exact ⟨by simpa using h1, by simpa using h2⟩⟩

private noncomputable def r891lS : SUg CFSG.F4 := r891suMkL r891lmS (by decide +kernel) (by
  decide +kernel)
private noncomputable def r891lD : SUg CFSG.F4 := r891suMkL r891lmD (by decide +kernel) (by
  decide +kernel)
private noncomputable def r891lP : SUg CFSG.F4 := r891suMkL r891lmP (by decide +kernel) (by
  decide +kernel)
private noncomputable def r891lF : SUg CFSG.F4 := r891suMkL r891lmF (by decide +kernel) (by
  decide +kernel)
private noncomputable def r891lG : SUg CFSG.F4 := r891suMkL r891lmG (by decide +kernel) (by
  decide +kernel)
private noncomputable def r891lZ : SUg CFSG.F4 := r891suMkL r891lmZ (by decide +kernel) (by
  decide +kernel)

private theorem r891inv_eq_cube {G : Type} [Group G] {x : G} (h : x ^ 4 = 1) : x⁻¹ = x ^ 3 := by
  calc x⁻¹ = x⁻¹ * 1 := by rw [mul_one]
    _ = x⁻¹ * x ^ 4 := by rw [h, mul_one]
    _ = x ^ 3 := by group

private theorem r891natCard_F4 : Nat.card CFSG.F4 = 4 := by
  rw [Nat.card_eq_fintype_card]
  exact CFSG.F4.card

private theorem r891lF4 : r891lF ^ 4 = 1 := by decide +kernel
private theorem r891lG4 : r891lG ^ 4 = 1 := by decide +kernel
private theorem r891lFF : r891lF * r891lF = r891lP := by decide +kernel
private theorem r891lGG : r891lG * r891lG = r891lP := by decide +kernel
private theorem r891lGF : r891lG * r891lF * r891lG⁻¹ = r891lF⁻¹ := by
  rw [r891inv_eq_cube r891lG4, r891inv_eq_cube r891lF4]
  decide +kernel

private noncomputable def r891qLift : QuaternionGroup 2 →* SUg CFSG.F4 :=
  CFSG.ClassicalInvolution.Q3.Sec13.L711.quatLift r891lF r891lG r891lF4 (r891lFF ▸ r891lGG) r891lGF

private theorem r891qLift_inj : Function.Injective r891qLift := by
  intro a b hab
  revert a b
  decide +kernel

private noncomputable def r891qSub : Subgroup (SUg CFSG.F4) := r891qLift.range

private theorem r891qSub_card : Nat.card r891qSub = 8 := by
  change Nat.card (Set.range r891qLift) = 8
  rw [Nat.card_range_of_injective r891qLift_inj, Nat.card_eq_fintype_card, QuaternionGroup.card]

private noncomputable def r891eList : List (SUg CFSG.F4) :=
  ((List.range 3).map fun a =>
    ((List.range 3).map fun b =>
      ((List.range 3).map fun c => r891lZ ^ a * r891lD ^ b * r891lS ^ c))).flatten.flatten

private noncomputable def r891eSet : Finset (SUg CFSG.F4) := r891eList.toFinset

private theorem r891mem_eSet {x : SUg CFSG.F4} : x ∈ (r891eSet : Set (SUg CFSG.F4)) ↔ x ∈
  r891eList := by
  simp [r891eSet]

private theorem r891eList_length : r891eList.length = 27 := by decide +kernel
private theorem r891eList_nodup : r891eList.Nodup := by decide +kernel
private theorem r891eList_mul : ∀ a ∈ r891eList, ∀ b ∈ r891eList, a * b ∈ r891eList := by
  have h := List.all_eq_true.mp (show r891eList.all (fun a => r891eList.all (fun b =>
    decide (a * b ∈ r891eList))) = true by decide +kernel)
  intro a ha b hb
  exact of_decide_eq_true (List.all_eq_true.mp (h a ha) b hb)
private theorem r891eList_sq : ∀ a ∈ r891eList, a * a ∈ r891eList := by
  have h := List.all_eq_true.mp (show r891eList.all (fun a => decide (a * a ∈ r891eList)) = true
    by decide +kernel)
  intro a ha
  exact of_decide_eq_true (h a ha)
private theorem r891eList_cube : ∀ a ∈ r891eList, a ^ 3 = 1 := by
  have h := List.all_eq_true.mp (show r891eList.all (fun a => decide (a ^ 3 = 1)) = true
    by decide +kernel)
  intro a ha
  exact of_decide_eq_true (h a ha)

private noncomputable def r891Esub : Subgroup (SUg CFSG.F4) where
  carrier := ↑r891eSet
  one_mem' := by
    rw [r891mem_eSet]
    decide +kernel
  mul_mem' := by
    intro a b ha hb
    rw [r891mem_eSet] at ha hb ⊢
    exact r891eList_mul a ha b hb
  inv_mem' := by
    intro a ha
    rw [r891mem_eSet] at ha ⊢
    have h3 := r891eList_cube a ha
    have hinv : a⁻¹ = a * a := by
      calc a⁻¹ = a⁻¹ * 1 := by rw [mul_one]
        _ = a⁻¹ * a ^ 3 := by rw [h3, mul_one]
        _ = a * a := by rw [← pow_two]; group
    rw [hinv]
    exact r891eList_sq a ha

private theorem r891Esub_card : Nat.card r891Esub = 27 := by
  have h : Nat.card r891Esub = r891eSet.card := by
    change Nat.card ↥r891eSet = r891eSet.card
    rw [Nat.card_eq_fintype_card]
    exact Fintype.card_coe r891eSet
  rw [h, r891eSet, List.toFinset_card_of_nodup r891eList_nodup, r891eList_length]

end R891T

