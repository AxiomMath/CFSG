open CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8
open scoped commutatorElement

private theorem r891OddCore_le_normalizer {Y : Type} [Group Y] {R E : Subgroup Y}
    (h : R891OddCore R E) : R ≤ Subgroup.normalizer (E : Set Y) := by
  intro r hr
  rw [Subgroup.mem_normalizer_iff]
  intro e
  constructor
  · intro he
    have hR : r * e * r⁻¹ ∈ R :=
      R.mul_mem (R.mul_mem hr (h.2.1 he)) (R.inv_mem hr)
    have hord : orderOf (r * e * r⁻¹) = orderOf e := by
      simpa [MulAut.conj_apply] using (MulEquiv.orderOf_eq (MulAut.conj r) e)
    exact h.2.2.1 _ hR (by rw [hord]; exact h.2.2.2.1 e he)
  · intro hconj
    have hE : r * e * r⁻¹ ∈ E := hconj
    have hRconj : r * e * r⁻¹ ∈ R := h.2.1 hE
    have heR : e ∈ R := by
      have : r⁻¹ * (r * e * r⁻¹) * r ∈ R :=
        R.mul_mem (R.mul_mem (R.inv_mem hr) hRconj) hr
      simpa [mul_assoc] using this
    have hodd : Odd (orderOf (r * e * r⁻¹)) := h.2.2.2.1 _ hE
    have hord : orderOf (r * e * r⁻¹) = orderOf e := by
      simpa [MulAut.conj_apply] using (MulEquiv.orderOf_eq (MulAut.conj r) e)
    exact h.2.2.1 e heR (by rw [← hord]; exact hodd)

private theorem r891OddCore_map {Y Y' : Type} [Group Y] [Group Y'] [Finite Y] (f : Y →* Y')
    {R E : Subgroup Y} (h : R891OddCore R E) (hker : ∀ x ∈ f.ker, Odd (orderOf x)) :
    R891OddCore (R.map f) (E.map f) := by
  refine ⟨?_, Subgroup.map_mono h.2.1, ?_, ?_, ?_, ?_⟩
  · apply le_antisymm
    · rw [Opp, CFSG.RankThree.PartOne.pElementSubgroup, Subgroup.closure_le]
      intro y hy
      exact hy.1
    · rw [← h.1]
      rw [Opp, CFSG.RankThree.PartOne.pElementSubgroup] at *
      rw [MonoidHom.map_closure, Subgroup.closure_le]
      rintro y ⟨x, hx, rfl⟩
      obtain ⟨hxR, k, hk⟩ := hx
      rw [Opp, CFSG.RankThree.PartOne.pElementSubgroup]
      apply Subgroup.subset_closure
      refine ⟨Subgroup.subset_closure (Set.mem_image_of_mem f ⟨hxR, k, hk⟩), ?_⟩
      have hdvd : orderOf (f x) ∣ 2 ^ k := by
        rw [← hk]
        exact orderOf_map_dvd f x
      obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hdvd
      exact ⟨j, hj⟩
  · intro y hyR hyOdd
    rw [Subgroup.mem_map] at hyR
    obtain ⟨x, hxR, rfl⟩ := hyR
    have hm : Odd (orderOf (f x)) := hyOdd
    have hmem : x ^ orderOf (f x) ∈ f.ker := by
      rw [MonoidHom.mem_ker]
      simp
    have hxodd : Odd (orderOf x) := by
      have hdiv : orderOf x ∣ orderOf (f x) * orderOf (x ^ orderOf (f x)) := by
        apply orderOf_dvd_of_pow_eq_one
        rw [pow_mul]
        exact pow_orderOf_eq_one _
      exact Odd.of_dvd_nat (hm.mul (hker _ hmem)) hdiv
    exact Subgroup.mem_map_of_mem f (h.2.2.1 x hxR hxodd)
  · intro y hy
    obtain ⟨x, hxE, rfl⟩ := Subgroup.mem_map.mp hy
    exact (h.2.2.2.1 x hxE).of_dvd_nat (orderOf_map_dvd f x)
  · rw [← Subgroup.map_commutator, h.2.2.2.2.1]
  · intro Wbar hWbar hrel
    let W : Subgroup Y := Wbar.comap f ⊓ E
    have hWE : W ≤ E := inf_le_right
    have hWrel : W.relIndex E = 3 := by
      have hNindex : (Wbar.subgroupOf (E.map f)).index = 3 := by
        simpa [Subgroup.relIndex] using hrel
      let fE : ↥E →* ↥(E.map f) :=
        (f.domRestrict E).codRestrict (E.map f) (fun x => Subgroup.mem_map_of_mem f x.2)
      have hsurj : Function.Surjective fE := by
        rintro ⟨y, hy⟩
        rw [Subgroup.mem_map] at hy
        obtain ⟨x, hx, rfl⟩ := hy
        exact ⟨⟨x, hx⟩, Subtype.ext rfl⟩
      have hcomap : W.subgroupOf E = (Wbar.subgroupOf (E.map f)).comap fE := by
        ext x
        constructor
        · intro hx
          rw [Subgroup.mem_comap, Subgroup.mem_subgroupOf]
          have hx' := Subgroup.mem_subgroupOf.mp hx
          have hxbar : f (x : Y) ∈ Wbar := Subgroup.mem_comap.mp hx'.1
          change f (x : Y) ∈ Wbar
          exact hxbar
        · intro hx
          rw [Subgroup.mem_subgroupOf]
          have hxbar : f (x : Y) ∈ Wbar := by
            have := Subgroup.mem_subgroupOf.mp hx
            change f (x : Y) ∈ Wbar at this
            exact this
          exact ⟨Subgroup.mem_comap.mpr hxbar, x.2⟩
      rw [show W.relIndex E = (W.subgroupOf E).index from rfl, hcomap,
        Subgroup.index_comap_of_surjective _ hsurj, hNindex]
    obtain ⟨k, hkR, hkW⟩ := h.2.2.2.2.2 W hWE hWrel
    refine ⟨f k, Subgroup.mem_map_of_mem f hkR, ?_⟩
    intro hWbarInv
    have hle : W.map (MulAut.conj k).toMonoidHom ≤ W := by
      intro y hy
      obtain ⟨x, hxW, rfl⟩ := Subgroup.mem_map.mp hy
      refine ⟨?_, ?_⟩
      · change (MulAut.conj k) x ∈ Wbar.comap f
        rw [Subgroup.mem_comap]
        have hxbar : f x ∈ Wbar := Subgroup.mem_comap.mp hxW.1
        have hmem : (MulAut.conj (f k)) (f x) ∈
            Wbar.map (MulAut.conj (f k)).toMonoidHom :=
          Subgroup.mem_map_of_mem _ hxbar
        rw [hWbarInv] at hmem
        simpa [MulAut.conj_apply] using hmem
      · have hnorm := r891OddCore_le_normalizer h hkR
        exact (Subgroup.mem_normalizer_iff.mp hnorm x).mp hxW.2
    have hcard : Nat.card (W.map (MulAut.conj k).toMonoidHom) = Nat.card W :=
      Subgroup.card_map_of_injective (MulAut.conj k).injective
    have heq : W.map (MulAut.conj k).toMonoidHom = W :=
      Subgroup.eq_of_le_of_card_ge hle (by rw [hcard])
    exact hkW heq

end R891T

namespace R891T
open CFSG.Open CFSG.PGLModel Matrix Subgroup CFSG.RankThree.PartTwo
open CFSG.LocalAnalysis.ComponentInitial
open CFSG.GH74.QTGen4.Leaves.F112
open CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8
open scoped commutatorElement

private noncomputable abbrev r891P (F : Type) [Field F] :
    Subgroup (ProjGenLinGroup (Fin 3) F) :=
  CFSG.PGLModel.projImage (Sec4.glPi false 3 2 F)

private noncomputable def r891Rho (hF : Nat.card F = 4) :
    ↥(StatedSU 3 2 F) →* ↥(r891P F) := by
  classical
  let hU : UnitaryFieldData 2 1 F := ⟨Nat.prime_two, by norm_num, by simpa using hF⟩
  let f : ↥(StatedSU 3 2 F) →* ProjGenLinGroup (Fin 3) F :=
    (ProjGenLinGroup.mk : GL (Fin 3) F →* ProjGenLinGroup (Fin 3) F).comp
      (StatedSU 3 2 F).subtype
  refine f.codRestrict (r891P F) ?_
  intro A
  refine Subgroup.mem_map_of_mem _ ?_
  exact (Sec4.slPi_le_glPi (π := false) (n := 3) (p := 2) (f := 1) (K := F)
    (fun _ => hU)) A.2

omit [Finite F] in
private theorem r891Rho_apply (hF : Nat.card F = 4) (x : ↥(StatedSU 3 2 F)) :
    ((r891Rho hF x : ↥(r891P F)) : ProjGenLinGroup (Fin 3) F) =
      ProjGenLinGroup.mk (x : GL (Fin 3) F) := rfl

omit [Finite F] in
private theorem r891Rho_ker_eq (hF : Nat.card F = 4) :
    (r891Rho hF).ker = (StatedScalars (Fin 3) F).subgroupOf (StatedSU 3 2 F) := by
  ext x
  rw [MonoidHom.mem_ker]
  constructor
  · intro hx
    have hx' : (x : GL (Fin 3) F) ∈ StatedScalars (Fin 3) F := by
      have h := congrArg (fun y : ↥(r891P F) => (y : ProjGenLinGroup (Fin 3) F)) hx
      rw [r891Rho_apply] at h
      have h' : ProjGenLinGroup.mk (x : GL (Fin 3) F) = 1 := by simpa using h
      rw [CFSG.Open.StatedAPI.statedScalars_eq_center]
      exact ProjGenLinGroup.mk_eq_one.mp h'
    exact Subgroup.mem_subgroupOf.mpr hx'
  · intro hx
    have hx' : (x : GL (Fin 3) F) ∈ StatedScalars (Fin 3) F :=
      Subgroup.mem_subgroupOf.mp hx
    have hx'' : ProjGenLinGroup.mk (x : GL (Fin 3) F) = 1 := by
      rw [CFSG.Open.StatedAPI.statedScalars_eq_center] at hx'
      exact ProjGenLinGroup.mk_eq_one.mpr hx'
    apply Subtype.ext
    rw [r891Rho_apply]
    simpa using hx''

private theorem r891Rho_ker_card (hF : Nat.card F = 4) :
    Nat.card (r891Rho hF).ker = 3 := by
  rw [r891Rho_ker_eq hF]
  exact (Nat.card_congr (Subgroup.subgroupOfEquivOfLe
    (R891Card.r891statedScalars_le_statedSU hF)).toEquiv).trans
    (R891Card.r891card_statedScalars hF)

omit [Finite F] in
private theorem r891Rho_ker_pow_three (hF : Nat.card F = 4)
    {x : ↥(StatedSU 3 2 F)} (hx : x ∈ (r891Rho hF).ker) : x ^ 3 = 1 := by
  have hxscalar : (x : GL (Fin 3) F) ∈ StatedScalars (Fin 3) F := by
    have hx' := hx
    rw [r891Rho_ker_eq hF] at hx'
    exact Subgroup.mem_subgroupOf.mp hx'
  have hxdet : ((x : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F).det = 1 :=
    CFSG.Open.StatedAPI.det_of_mem_statedSU x.2
  have h := CFSG.Open.StatedAPI.pow_three_eq_one_of_mem_statedScalars hxscalar hxdet
  exact Subtype.ext h

omit [Finite F] in
private theorem r891Rho_ker_le (hF : Nat.card F = 4)
    {E₀ : Subgroup ↥(StatedSU 3 2 F)} (hE₀ : R891OddCore ⊤ E₀) :
    (r891Rho hF).ker ≤ E₀ := by
  intro x hx
  exact hE₀.2.2.1 x (Subgroup.mem_top x)
    (Odd.of_dvd_nat (by norm_num : Odd 3)
      (orderOf_dvd_of_pow_eq_one (r891Rho_ker_pow_three hF hx)))

omit [Finite F] in
private theorem r891_commutator_mem_map (hF : Nat.card F = 4) :
    ∀ a b : ↥(r891P F), a * b * a⁻¹ * b⁻¹ ∈
      (⊤ : Subgroup ↥(StatedSU 3 2 F)).map (r891Rho hF) := by
  classical
  let hU : UnitaryFieldData 2 1 F := ⟨Nat.prime_two, by norm_num, by simpa using hF⟩
  intro a b
  have ha : (a : ProjGenLinGroup (Fin 3) F) ∈
      (Sec4.glPi false 3 2 F).map
        (ProjGenLinGroup.mk : GL (Fin 3) F →* ProjGenLinGroup (Fin 3) F) := by
    simpa [r891P, CFSG.PGLModel.projImage] using a.2
  obtain ⟨A, hA, hAa⟩ := Subgroup.mem_map.mp ha
  have hb : (b : ProjGenLinGroup (Fin 3) F) ∈
      (Sec4.glPi false 3 2 F).map
        (ProjGenLinGroup.mk : GL (Fin 3) F →* ProjGenLinGroup (Fin 3) F) := by
    simpa [r891P, CFSG.PGLModel.projImage] using b.2
  obtain ⟨B, hB, hBb⟩ := Subgroup.mem_map.mp hb
  let C : GL (Fin 3) F := A * B * A⁻¹ * B⁻¹
  have hCgl : C ∈ Sec4.glPi false 3 2 F := by
    dsimp [C]
    exact Subgroup.mul_mem _
      (Subgroup.mul_mem _ (Subgroup.mul_mem _ hA hB) (Subgroup.inv_mem _ hA))
      (Subgroup.inv_mem _ hB)
  have hCdet : ((C : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F).det = 1 := by
    have h : GeneralLinearGroup.det C = 1 := by
      have hc : GeneralLinearGroup.det C =
          ⁅GeneralLinearGroup.det A, GeneralLinearGroup.det B⁆ := by
        simp [C, commutatorElement_def]
      rw [hc, commutatorElement_eq_one_iff_mul_comm.mpr (mul_comm _ _)]
    rw [← GeneralLinearGroup.val_det_apply, h, Units.val_one]
  have hCSU : C ∈ StatedSU 3 2 F := by
    have h := (Sec4.mem_slPi_iff (π := false) (n := 3) (p := 2) (f := 1) (K := F)
      (fun _ => hU)).mpr ⟨hCgl, hCdet⟩
    simpa [Sec4.slPi] using h
  refine Subgroup.mem_map.mpr ⟨⟨C, hCSU⟩, Subgroup.mem_top _, ?_⟩
  apply Subtype.ext
  simp only [Subgroup.coe_mul, Subgroup.coe_inv, r891Rho_apply]
  rw [← hAa, ← hBb]
  simp [C]

private theorem r891Rho_map_card (hF : Nat.card F = 4)
    {E₀ : Subgroup ↥(StatedSU 3 2 F)} (hE₀ : R891OddCore ⊤ E₀)
    (hextra : IsExtraspecialExpP 3 1 ↥E₀) :
    Nat.card ↥(E₀.map (r891Rho hF)) = 9 := by
  classical
  let f : ↥E₀ →* ↥(r891P F) := (r891Rho hF).comp E₀.subtype
  have hker : f.ker = (r891Rho hF).ker.subgroupOf E₀ := by
    change ((r891Rho hF).comp E₀.subtype).ker = _
    rw [← MonoidHom.comap_ker, Subgroup.comap_subtype]
  have hker_card : Nat.card ↥f.ker = 3 := by
    rw [hker]
    exact (Nat.card_congr (Subgroup.subgroupOfEquivOfLe
      (r891Rho_ker_le hF hE₀)).toEquiv).trans (r891Rho_ker_card hF)
  have hrange : f.range = E₀.map (r891Rho hF) := by
    change ((r891Rho hF).comp E₀.subtype).range = _
    rw [MonoidHom.range_comp, Subgroup.range_subtype]
  have hcard := Subgroup.card_ker_mul_card_range f
  rw [hker_card, hrange] at hcard
  have hE0card : Nat.card ↥E₀ = 27 := by
    have h := hextra
    unfold IsExtraspecialExpP at h
    rw [h.1]
    norm_num
  rw [hE0card] at hcard
  omega

private theorem r891E9_map (hF : Nat.card F = 4)
    {E₀ : Subgroup ↥(StatedSU 3 2 F)}
    (hextra : IsExtraspecialExpP 3 1 ↥E₀)
    (hcard : Nat.card ↥(E₀.map (r891Rho hF)) = 9) :
    R891E9 ↥(E₀.map (r891Rho hF)) := by
  classical
  have hexp : Monoid.exponent ↥E₀ = 3 := by
    have h := hextra
    unfold IsExtraspecialExpP at h
    exact h.2.1
  have h3 : ∀ g : ↥(E₀.map (r891Rho hF)), g ^ 3 = 1 := by
    intro g
    obtain ⟨e, he, hge⟩ := Subgroup.mem_map.mp g.2
    have he3 : e ^ 3 = 1 := by
      have h := Monoid.pow_exponent_eq_one (⟨e, he⟩ : ↥E₀)
      rw [hexp] at h
      simpa using h
    apply Subtype.ext
    simp only [Subgroup.coe_pow, Subgroup.coe_one]
    rw [← hge, ← map_pow, he3, map_one]
  have hcard32 : Nat.card ↥(E₀.map (r891Rho hF)) = 3 ^ 2 := by
    rw [hcard]
    norm_num
  obtain ⟨e⟩ := @CFSG.HardMathSupport.Timmesfeld.CrossChar.exists_mulEquiv_z3_two
    ↥(E₀.map (r891Rho hF))
    (CommGroup.mk (IsPGroup.commutative_of_card_eq_prime_sq (p := 3) hcard32))
    (inferInstance : Finite ↥(E₀.map (r891Rho hF))) h3 hcard
  exact ⟨e⟩

end R891T

theorem exists_oddCore_pgu_two (hF : Nat.card F = 4) :
    ∃ R E : Subgroup ↥(CFSG.PGLModel.projImage (Sec4.glPi false 3 2 F)),
      (∀ a b : ↥(CFSG.PGLModel.projImage (Sec4.glPi false 3 2 F)), a * b * a⁻¹ * b⁻¹ ∈ R) ∧
        R891OddCore R E ∧ R891E9 ↥E := by
  classical
  obtain ⟨E₀, hcore, hextra⟩ := exists_oddCore_statedSU_two hF
  let ρ := R891T.r891Rho hF
  let R : Subgroup ↥(R891T.r891P F) := (⊤ : Subgroup ↥(StatedSU 3 2 F)).map ρ
  let E : Subgroup ↥(R891T.r891P F) := E₀.map ρ
  have hEcard : Nat.card ↥(E₀.map (R891T.r891Rho hF)) = 9 :=
    R891T.r891Rho_map_card hF hcore hextra
  have hE9 : R891E9 ↥(E₀.map (R891T.r891Rho hF)) :=
    R891T.r891E9_map hF hextra hEcard
  refine ⟨R, E, ?_, ?_, ?_⟩
  · simpa [R, ρ, R891T.r891P] using R891T.r891_commutator_mem_map hF
  · simpa [R, E, ρ] using R891T.r891OddCore_map ρ hcore
      (fun x hx => Odd.of_dvd_nat (by norm_num : Odd 3)
        (orderOf_dvd_of_pow_eq_one (R891T.r891Rho_ker_pow_three hF hx)))
  · simpa [E, ρ] using hE9

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8
