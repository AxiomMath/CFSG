  have hcS : r891lF * r891lS * r891lF⁻¹ = r891lD := by rw [r891lF_S]; group
  have hcD : r891lF * r891lD * r891lF⁻¹ = r891lS * r891lS := by rw [r891lF_D]; group
  have hA : r891lS⁻¹ * r891lD ∈ ⁅r891Esub, (⊤ : Subgroup (SUg CFSG.F4))⁆ := by
    have hmem : ⁅r891lS⁻¹, r891lF⁆ ∈ ⁅r891Esub, (⊤ : Subgroup (SUg CFSG.F4))⁆ :=
