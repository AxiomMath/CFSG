private theorem r891inv_eq_sq_of_cube {G : Type} [Group G] {x : G} (h : x ^ 3 = 1) :
    x⁻¹ = x * x := by
  calc x⁻¹ = x⁻¹ * 1 := by rw [mul_one]
    _ = x⁻¹ * x ^ 3 := by rw [h, mul_one]
    _ = x * x := by rw [← pow_two]; group

private theorem r891lZ_mem_closure : r891lZ ∈ Subgroup.closure ({r891lS, r891lD} : Set (SUg
  CFSG.F4)) := by
  have hS : r891lS ∈ Subgroup.closure ({r891lS, r891lD} : Set (SUg CFSG.F4)) :=
