      Subgroup.map_top_of_surjective s.subtype hsurj
    have h := R891OddCore.comap_map (Y := ↥(StatedSU 3 2 F)) eTop hcore
    rw [Subgroup.comap_top, htop] at h
    exact h
  · obtain ⟨ee⟩ := nonempty_mulEquiv_comap_map eTop E₀
    exact isExtraspecialExpP_of_mulEquiv ee hextra

