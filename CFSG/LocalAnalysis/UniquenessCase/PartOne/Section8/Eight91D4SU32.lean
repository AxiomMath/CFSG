    have h := hcomm_le hzE_comm
    have h' : ((r891zE : ↥r891Esub) : SUg CFSG.F4) ∈ W := Subgroup.mem_subgroupOf.mp h
    simpa [r891zE] using h'
  have hZW : Subgroup.zpowers r891lZ ≤ W := Subgroup.zpowers_le.mpr hzW
  have hZcard : Nat.card (Subgroup.zpowers r891lZ) = 3 := by
    rw [Nat.card_zpowers, r891orderOf_lZ]
  have hnotle : ¬ W ≤ Subgroup.zpowers r891lZ := by
    intro hle
    have hlecard := Subgroup.card_le_of_le hle
    rw [hWcard, hZcard] at hlecard
    omega
  obtain ⟨w, hwW, hwZ⟩ : ∃ w ∈ W, w ∉ Subgroup.zpowers r891lZ := by
    by_contra h
    push Not at h
    exact hnotle h
  have hwList : w ∈ r891eList := r891mem_Esub.mp (hW hwW)
  have hw1 : w ≠ 1 := by
    intro h; exact hwZ (by rw [h]; exact Subgroup.one_mem _)
  have hwz : w ≠ r891lZ := by
    intro h; exact hwZ (by rw [h]; exact Subgroup.mem_zpowers _)
