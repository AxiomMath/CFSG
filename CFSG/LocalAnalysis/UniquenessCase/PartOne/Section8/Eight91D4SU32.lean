private theorem r891_index_three (W : Subgroup (SUg CFSG.F4)) (hW : W ≤ r891Esub)
    (hrel : W.relIndex r891Esub = 3) :
    ∃ k ∈ (⊤ : Subgroup (SUg CFSG.F4)), W.map (MulAut.conj k).toMonoidHom ≠ W := by
  refine ⟨r891lF, Subgroup.mem_top _, ?_⟩
