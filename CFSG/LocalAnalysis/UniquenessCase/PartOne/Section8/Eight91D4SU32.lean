  let eTop : ↥(⊤ : Subgroup ↥(StatedSU 3 2 F)) ≃* ↥(StatedSU 3 2 CFSG.F4) :=
    (Subgroup.topEquiv).trans g
  refine ⟨(E₀.comap eTop.toMonoidHom).map (⊤ : Subgroup ↥(StatedSU 3 2 F)).subtype, ?_, ?_⟩
  · let s : Subgroup ↥(StatedSU 3 2 F) := ⊤
