    exact (Subgroup.eq_of_le_of_card_ge hclosure_le_W hcard).symm
  have hconjW : (MulAut.conj r891lF) w ∈ W := by
    have h := Subgroup.mem_map_of_mem (MulAut.conj r891lF).toMonoidHom hwW
