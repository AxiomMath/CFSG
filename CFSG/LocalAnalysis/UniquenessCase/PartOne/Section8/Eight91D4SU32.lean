private theorem r891odd_dvd_eight_eq_one {n : ℕ} (ho : Odd n) (h : n ∣ 8) : n = 1 := by
  have h2 : Nat.Coprime n 2 := ho.coprime_two_right
  have hcop : Nat.Coprime n 8 := by
    have := h2.pow_right 3
    simpa using this
  have h1 : n ∣ 1 := hcop.dvd_of_dvd_mul_left (by simpa using h)
  exact Nat.dvd_one.mp h1

private theorem r891odd_mem_Esub {r : SUg CFSG.F4} (hr : Odd (orderOf r)) : r ∈ r891Esub := by
  have : r891Esub.Normal := r891Esub_normal
  have hquot : Nat.card (SUg CFSG.F4 ⧸ r891Esub) = 8 := by
    have h := Subgroup.card_eq_card_quotient_mul_card_subgroup r891Esub
    rw [R891Card.r891card_SUg r891natCard_F4, r891Esub_card] at h
    omega
  let q : SUg CFSG.F4 →* SUg CFSG.F4 ⧸ r891Esub := QuotientGroup.mk' r891Esub
  have hdvd : orderOf (q r) ∣ orderOf r := orderOf_map_dvd q r
  have hodd : Odd (orderOf (q r)) := hr.of_dvd_nat hdvd
  have h8 : orderOf (q r) ∣ 8 := by
    have := Subgroup.orderOf_dvd_natCard (⊤ : Subgroup (SUg CFSG.F4 ⧸ r891Esub))
      (Subgroup.mem_top (q r))
    simpa [Subgroup.card_top, hquot] using this
  have hone : orderOf (q r) = 1 := r891odd_dvd_eight_eq_one hodd h8
  have hq1 : q r = 1 := orderOf_eq_one_iff.mp hone
  exact (QuotientGroup.eq_one_iff (N := r891Esub) r).mp hq1

private theorem r891Esub_odd {e : SUg CFSG.F4} (he : e ∈ r891Esub) : Odd (orderOf e) := by
  have h3 : e ^ 3 = 1 := r891eList_cube e (r891mem_Esub.mp he)
  have hd : orderOf e ∣ 3 := orderOf_dvd_of_pow_eq_one h3
  rcases (Nat.dvd_prime Nat.prime_three).mp hd with h | h
  · rw [h]; exact odd_one
  · rw [h]; norm_num

end R891T

