  have hZ : r891lZ ∈ N := by
    have hcomm : r891lS * r891lD * r891lS⁻¹ * r891lD⁻¹ = r891lZ ^ 2 := by
      rw [r891inv_eq_sq_of_cube (r891eList_cube r891lS r891mem_eList_S),
