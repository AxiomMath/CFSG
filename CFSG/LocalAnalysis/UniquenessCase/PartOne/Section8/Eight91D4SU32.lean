    · exact Subgroup.mul_mem _ hG (Subgroup.pow_mem _ hF i.val)
  have htop : (⊤ : Subgroup (SUg CFSG.F4)) ≤ N := by
    rw [← r891Esub_sup_qSub]
    exact sup_le hE hq
  exact top_unique htop

