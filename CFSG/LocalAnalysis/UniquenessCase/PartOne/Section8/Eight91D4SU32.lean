private theorem r891qSub_le_normalizer : r891qSub ≤ Subgroup.normalizer (r891Esub : Set (SUg
  CFSG.F4)) := by
  intro x hx
  obtain ⟨q, rfl⟩ := hx
  rcases q with i | i
  · exact Subgroup.pow_mem _ r891mem_normalizer_Esub_F i.val
  · exact Subgroup.mul_mem _ r891mem_normalizer_Esub_G (Subgroup.pow_mem _
    r891mem_normalizer_Esub_F i.val)

private theorem r891Esub_sup_qSub : r891Esub ⊔ r891qSub = ⊤ := by
  have hdvdE : Nat.card r891Esub ∣ Nat.card (r891Esub ⊔ r891qSub : Subgroup (SUg CFSG.F4)) :=
    Subgroup.card_dvd_of_le le_sup_left
  have hdvdQ : Nat.card r891qSub ∣ Nat.card (r891Esub ⊔ r891qSub : Subgroup (SUg CFSG.F4)) :=
    Subgroup.card_dvd_of_le le_sup_right
  rw [r891Esub_card] at hdvdE
  rw [r891qSub_card] at hdvdQ
  have hdvd : 216 ∣ Nat.card (r891Esub ⊔ r891qSub : Subgroup (SUg CFSG.F4)) := by
    have hc : Nat.Coprime 27 8 := by norm_num
    simpa using hc.mul_dvd_of_dvd_of_dvd hdvdE hdvdQ
  have hle : Nat.card (r891Esub ⊔ r891qSub : Subgroup (SUg CFSG.F4)) ≤ 216 := by
    calc Nat.card (r891Esub ⊔ r891qSub : Subgroup (SUg CFSG.F4))
        ≤ Nat.card (⊤ : Subgroup (SUg CFSG.F4)) := Subgroup.card_le_of_le le_top
