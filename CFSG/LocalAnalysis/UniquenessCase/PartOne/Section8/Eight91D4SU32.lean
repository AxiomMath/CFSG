  have hxcent := Subgroup.mem_center_iff.mp hx
  have hb := r891eList_center_check
  have hcheck : ∀ a ∈ r891eList, (∀ b ∈ r891eList, a * b = b * a) →
      a = 1 ∨ a = r891lZ ∨ a = r891lZ * r891lZ := by
    intro a ha hcent
