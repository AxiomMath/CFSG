private theorem r891orderOf_eq_four_of_pow {G : Type} [Group G] {x : G} (h4 : x ^ 4 = 1)
    (h2 : x ^ 2 ≠ 1) : orderOf x = 4 := by
  have hdvd : orderOf x ∣ 4 := orderOf_dvd_of_pow_eq_one h4
  rw [show (4:ℕ) = 2 ^ 2 by norm_num] at hdvd
  obtain ⟨k, _, hkx⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hdvd
  have hk2 : k ≤ 2 := by
    have hle : 2 ^ k ≤ 2 ^ 2 := by rw [← hkx]; exact Nat.le_of_dvd (by norm_num) hdvd
    exact (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).mp hle
  interval_cases k
  · rw [pow_zero] at hkx
    have hx1 : x = 1 := orderOf_eq_one_iff.mp hkx
    exact absurd (by rw [hx1]; simp) h2
  · rw [pow_one] at hkx
    exact absurd (by rw [← hkx]; exact pow_orderOf_eq_one x) h2
  · rw [show (2:ℕ)^2 = 4 by norm_num] at hkx
    exact hkx

private theorem r891orderOf_lF : orderOf r891lF = 4 :=
  r891orderOf_eq_four_of_pow r891lF4 (by
    intro h
    exact (by decide +kernel : r891lP ≠ 1) (by simpa [pow_two, r891lFF] using h))

private theorem r891orderOf_lG : orderOf r891lG = 4 :=
  r891orderOf_eq_four_of_pow r891lG4 (by
    intro h
    exact (by decide +kernel : r891lP ≠ 1) (by simpa [pow_two, r891lGG] using h))

