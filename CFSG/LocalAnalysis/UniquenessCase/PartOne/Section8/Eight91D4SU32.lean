private theorem r891Esub_map_conj_F_le : r891Esub.map (MulAut.conj r891lF).toMonoidHom ≤
  r891Esub := by
  intro x hx
  rw [Subgroup.mem_map] at hx
  obtain ⟨y, hy, rfl⟩ := hx
  have hy' : y ∈ r891eList := (r891mem_eSet.mp hy)
  have hany := r891eList_F_conj y hy'
  obtain ⟨z, hz, hzy⟩ := List.any_eq_true.mp hany
  rw [r891mem_Esub]
  change (MulAut.conj r891lF) y ∈ r891eList
  have hzy' : r891lF * y = z * r891lF := of_decide_eq_true hzy
  rw [show MulAut.conj r891lF y = z by
    change r891lF * y * r891lF⁻¹ = z
    rw [hzy']
    group]
  exact hz

private theorem r891Esub_map_conj_G_le : r891Esub.map (MulAut.conj r891lG).toMonoidHom ≤
  r891Esub := by
  intro x hx
  rw [Subgroup.mem_map] at hx
  obtain ⟨y, hy, rfl⟩ := hx
  have hy' : y ∈ r891eList := (r891mem_eSet.mp hy)
  have hany := r891eList_G_conj y hy'
  obtain ⟨z, hz, hzy⟩ := List.any_eq_true.mp hany
  rw [r891mem_Esub]
  change (MulAut.conj r891lG) y ∈ r891eList
  have hzy' : r891lG * y = z * r891lG := of_decide_eq_true hzy
  rw [show MulAut.conj r891lG y = z by
    change r891lG * y * r891lG⁻¹ = z
    rw [hzy']
    group]
  exact hz

