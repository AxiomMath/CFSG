    (M := ↥r891Esub) (N := W.subgroupOf r891Esub) Nat.prime_three hNindex
  have hzE_comm : r891zE ∈ commutator ↥r891Esub := by
    have hcommEq : commutator ↥r891Esub = center ↥r891Esub := by
      have h := r891Esub_extraspecial
