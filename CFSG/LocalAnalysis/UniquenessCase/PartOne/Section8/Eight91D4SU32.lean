  have hB : r891lD⁻¹ * (r891lS * r891lS) ∈ ⁅r891Esub, (⊤ : Subgroup (SUg CFSG.F4))⁆ := by
    have hmem : ⁅r891lD⁻¹, r891lF⁆ ∈ ⁅r891Esub, (⊤ : Subgroup (SUg CFSG.F4))⁆ :=
      Subgroup.commutator_mem_commutator hDinv (Subgroup.mem_top r891lF)
    have heq : ⁅r891lD⁻¹, r891lF⁆ = r891lD⁻¹ * (r891lS * r891lS) := by
      rw [commutatorElement_def]
      calc r891lD⁻¹ * r891lF * (r891lD⁻¹)⁻¹ * r891lF⁻¹ = r891lD⁻¹ * (r891lF * r891lD *
        r891lF⁻¹) := by group
