  have hSmem : r891lS ∈ ⁅r891Esub, (⊤ : Subgroup (SUg CFSG.F4))⁆ := by
    have h : (r891lS⁻¹ * r891lD) * (r891lD⁻¹ * (r891lS * r891lS)) ∈ ⁅r891Esub, (⊤ : Subgroup
      (SUg CFSG.F4))⁆ :=
      Subgroup.mul_mem _ hA hB
    rwa [show (r891lS⁻¹ * r891lD) * (r891lD⁻¹ * (r891lS * r891lS)) = r891lS by group] at h
  have hDmem : r891lD ∈ ⁅r891Esub, (⊤ : Subgroup (SUg CFSG.F4))⁆ := by
