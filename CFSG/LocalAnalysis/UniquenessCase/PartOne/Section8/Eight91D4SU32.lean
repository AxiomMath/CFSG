open CFSG.Open Subgroup CFSG.GH74.QTGen4.Leaves.F112

private theorem r891card_units_three {F : Type} [Field F] (hF : Nat.card F = 4) :
    Nat.card Fˣ = 3 := by
  rw [Nat.card_units, hF]

private theorem r891statedScalars_le_statedSU {F : Type} [Field F] [Finite F] (hF : Nat.card F
  = 4) :
    StatedScalars (Fin 3) F ≤ StatedSU 3 2 F := by
  classical
  have : Fintype F := Fintype.ofFinite F
  rintro A ⟨u, rfl⟩
  have hu3 : u ^ 3 = 1 := by
    have h := pow_card_eq_one (x := u)
    rwa [show Fintype.card Fˣ = 3 by
      rw [← Nat.card_eq_fintype_card, r891card_units_three hF]] at h
  have hu : (u : F) ^ 3 = 1 := by simpa using congrArg Units.val hu3
  apply Subgroup.subset_closure
  constructor
  · rw [Matrix.GeneralLinearGroup.coe_scalar]
    exact CFSG.GH74.QTGen4.Leaves.F112.det_scalar' (u : F) hu
  · rw [Matrix.GeneralLinearGroup.coe_scalar]
    exact CFSG.GH74.QTGen4.Leaves.F112.unit_scalar (u : F) hu

private theorem r891card_statedScalars {F : Type} [Field F] [Finite F] (hF : Nat.card F = 4) :
    Nat.card (StatedScalars (Fin 3) F) = 3 := by
  classical
  have : Fintype F := Fintype.ofFinite F
  change Nat.card (Set.range (Matrix.GeneralLinearGroup.scalar (Fin 3) :
    Fˣ → GL (Fin 3) F)) = 3
  rw [Nat.card_range_of_injective (f := (Matrix.GeneralLinearGroup.scalar (Fin 3) :
    Fˣ → GL (Fin 3) F)) ?_,
    r891card_units_three hF]
  intro u v huv
  apply Units.ext
  have h := congrArg (fun A : GL (Fin 3) F => (A : Matrix (Fin 3) (Fin 3) F) 0 0) huv
  simpa [Matrix.GeneralLinearGroup.coe_scalar, Matrix.scalar_apply] using h

private theorem r891card_SUg {F : Type} [Field F] [Finite F] (hF : Nat.card F = 4) :
    Nat.card (SUg F) = 216 := by
  have hquot : Nat.card (StatedProj (StatedSU 3 2 F)) = 72 := by
    have h := CFSG.Timmesfeld.ClassicalOrders.card_statedProj_statedSU (K := F) (p := 2) (f := 1)
      (n := 3) Nat.prime_two (by norm_num) (by simpa using hF) (by norm_num)
    simp only [pow_one] at h
    rw [h]
    norm_num [Finset.prod_Icc_succ_top]
  let Z := (StatedScalars (Fin 3) F).subgroupOf (StatedSU 3 2 F)
  have hZ : Nat.card Z = 3 := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe (r891statedScalars_le_statedSU hF)).toEquiv,
      r891card_statedScalars hF]
  have h := Subgroup.card_eq_card_quotient_mul_card_subgroup Z
  rw [hZ, hquot] at h
  exact h.trans (by norm_num)

end R891Card

