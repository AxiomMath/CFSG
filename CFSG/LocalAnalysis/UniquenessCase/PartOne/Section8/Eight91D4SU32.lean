private theorem r891opp_top_eq_top : Opp 2 (⊤ : Subgroup (SUg CFSG.F4)) = ⊤ := by
  set N : Subgroup (SUg CFSG.F4) := Opp 2 (⊤ : Subgroup (SUg CFSG.F4)) with hNdef
  have hN : N.Normal := CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p22r_pElementSubgroup_normal
  have hF : r891lF ∈ N := r891F_mem_opp
  have hG : r891lG ∈ N := r891G_mem_opp
  have hFinv : r891lF⁻¹ ∈ N := Subgroup.inv_mem _ hF
  have hA : r891lS⁻¹ * r891lD ∈ N := by
    have h1 : r891lS⁻¹ * r891lF * r891lS * r891lF⁻¹ ∈ N :=
      Subgroup.mul_mem _ (hN.conj_mem r891lF hF r891lS⁻¹) hFinv
    have hc : r891lF * r891lS * r891lF⁻¹ = r891lD := by rw [r891lF_S]; group
    have heq : r891lS⁻¹ * r891lF * r891lS * r891lF⁻¹ = r891lS⁻¹ * r891lD := by
      rw [show r891lS⁻¹ * r891lF * r891lS * r891lF⁻¹ = r891lS⁻¹ * (r891lF * r891lS * r891lF⁻¹)
        by group, hc]
    rwa [heq] at h1
  have hB : r891lD⁻¹ * (r891lS * r891lS) ∈ N := by
    have h1 : r891lD⁻¹ * r891lF * r891lD * r891lF⁻¹ ∈ N :=
      Subgroup.mul_mem _ (hN.conj_mem r891lF hF r891lD⁻¹) hFinv
    have hc : r891lF * r891lD * r891lF⁻¹ = r891lS * r891lS := by rw [r891lF_D]; group
    have heq : r891lD⁻¹ * r891lF * r891lD * r891lF⁻¹ = r891lD⁻¹ * (r891lS * r891lS) := by
      rw [show r891lD⁻¹ * r891lF * r891lD * r891lF⁻¹ = r891lD⁻¹ * (r891lF * r891lD * r891lF⁻¹)
        by group, hc]
    rwa [heq] at h1
  have hS : r891lS ∈ N := by
    have h : (r891lS⁻¹ * r891lD) * (r891lD⁻¹ * (r891lS * r891lS)) ∈ N := Subgroup.mul_mem _ hA hB
    rwa [show (r891lS⁻¹ * r891lD) * (r891lD⁻¹ * (r891lS * r891lS)) = r891lS by group] at h
