private theorem k1513b_plane {H A : Type} [Group H] [CommGroup A] [Finite A] {r : ℕ}
    (hr : r.Prime) (hrA : r ∣ Nat.card A) {T : Subgroup H} (e : T ≃* A × A) :
    ∃ E : Subgroup H, E ≤ T ∧ (∀ x ∈ E, x ^ r = 1) ∧ Nat.card E = r ^ 2 := by
  have : Fact r.Prime := ⟨hr⟩
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := A) r hrA
  have hxr : x ^ r = 1 := by rw [← hx]; exact pow_orderOf_eq_one x
  have hBc : Nat.card (Subgroup.zpowers x) = r := by rw [Nat.card_zpowers, hx]
  have hB1 : ∀ b ∈ Subgroup.zpowers x, b ^ r = 1 := by
    intro b hb
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hb
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hxr, one_zpow]
  have hPc : Nat.card ((Subgroup.zpowers x).prod (Subgroup.zpowers x)) = r ^ 2 := by
    rw [Nat.card_congr (Subgroup.prodEquiv _ _).toEquiv, Nat.card_prod, hBc, sq]
  refine ⟨(((Subgroup.zpowers x).prod (Subgroup.zpowers x)).map e.symm.toMonoidHom).map
    T.subtype, Subgroup.map_subtype_le _, ?_, ?_⟩
  · rintro _ ⟨_, ⟨p, hp, rfl⟩, rfl⟩
    have hp1 : p ^ r = 1 := Prod.ext (hB1 _ hp.1) (hB1 _ hp.2)
    rw [← map_pow, ← map_pow, hp1, map_one, map_one]
  · rw [Subgroup.card_map_of_injective T.subtype_injective,
      Subgroup.card_map_of_injective e.symm.injective, hPc]

private theorem k1513b_sylow_le {H : Type} [Group H] [Finite H] {r : ℕ} (hr : r.Prime)
    {T : Subgroup H} (hidx : ¬ r ∣ T.index) : ∃ S : Sylow r H, (S : Subgroup H) ≤ T := by
  have : Fact r.Prime := ⟨hr⟩
  obtain ⟨S₀⟩ : Nonempty (Sylow r T) := inferInstance
  have hS : IsPGroup r ((S₀ : Subgroup T).map T.subtype) := S₀.isPGroup'.map _
  have hSi : ¬ r ∣ ((S₀ : Subgroup T).map T.subtype).index := by
    rw [Subgroup.index_map_subtype]
    exact fun h => (hr.dvd_mul.1 h).elim S₀.not_dvd_index hidx
  exact ⟨hS.toSylow hSi, by
    rw [IsPGroup.toSylow_coe]
    exact Subgroup.map_subtype_le _⟩

private theorem k1513b_core {H A : Type} [Group H] [Finite H] [CommGroup A] [Finite A] {r : ℕ}
    (hr : r.Prime) (hrA : r ∣ Nat.card A) {T : Subgroup H} (e : T ≃* A × A)
    (S₁ : Sylow r H) (hS₁ : (S₁ : Subgroup H) ≤ T) :
    ∃ S : Sylow r H, IsMulCommutative ↥(S : Subgroup H) ∧
      ∃ E : Subgroup H, E ≤ (S : Subgroup H) ∧ (∀ x ∈ E, x ^ r = 1) ∧ Nat.card E = r ^ 2 := by
  have : Fact r.Prime := ⟨hr⟩
  obtain ⟨E, -, hE1, hEc⟩ := k1513b_plane hr hrA e
  have hEp : IsPGroup r E := IsPGroup.of_card hEc
  obtain ⟨S, hES⟩ := hEp.exists_le_sylow
  have hS₁c : IsMulCommutative ↥(S₁ : Subgroup H) := by
    refine IsMulCommutative.of_comm fun a b => ?_
    have h : (⟨a, hS₁ a.2⟩ : T) * ⟨b, hS₁ b.2⟩ = ⟨b, hS₁ b.2⟩ * ⟨a, hS₁ a.2⟩ :=
      e.injective (by rw [map_mul, map_mul]; exact mul_comm _ _)
    exact Subtype.ext (congrArg (Subtype.val : T → H) h)
  have hSe : ↥(S : Subgroup H) ≃* ↥(S₁ : Subgroup H) := Sylow.equiv S S₁
  refine ⟨S, IsMulCommutative.of_comm fun a b => hSe.injective ?_, E, hES, hE1, hEc⟩
  rw [map_mul, map_mul]
  exact mul_comm' (hSe a) (hSe b)

private theorem k1513b_transport {K H : Type} [Group K] [Group H] [Finite H] {r : ℕ}
    (e : K ≃* H)
    (h : ∃ S : Sylow r H, IsMulCommutative ↥(S : Subgroup H) ∧
      ∃ E : Subgroup H, E ≤ (S : Subgroup H) ∧ (∀ x ∈ E, x ^ r = 1) ∧ Nat.card E = r ^ 2) :
    ∃ S : Sylow r K, IsMulCommutative ↥(S : Subgroup K) ∧
      ∃ E : Subgroup K, E ≤ (S : Subgroup K) ∧ (∀ x ∈ E, x ^ r = 1) ∧ Nat.card E = r ^ 2 := by
  obtain ⟨S, hSc, E, hES, hE1, hEc⟩ := h
  obtain ⟨φ, hφ⟩ : ∃ φ : K →* H, ∀ x, φ x = e x := ⟨e.toMonoidHom, fun _ => rfl⟩
  have hinj : Function.Injective φ := fun a b h => e.injective (by rw [← hφ, ← hφ]; exact h)
  have hrange : (S : Subgroup H) ≤ φ.range := fun x _ => ⟨e.symm x, by rw [hφ]; simp⟩
  refine ⟨S.comapOfInjective φ hinj hrange, ?_, E.map e.symm.toMonoidHom, ?_, ?_, ?_⟩
  · rw [Sylow.coe_comapOfInjective]
    refine IsMulCommutative.of_comm fun a b => Subtype.ext (hinj ?_)
    have h : (⟨φ a, a.2⟩ : (S : Subgroup H)) * ⟨φ b, b.2⟩ = ⟨φ b, b.2⟩ * ⟨φ a, a.2⟩ :=
      mul_comm' _ _
    simpa [map_mul] using congrArg Subtype.val h
  · rw [Sylow.coe_comapOfInjective]
    rintro _ ⟨y, hy, rfl⟩
    show φ (e.symm y) ∈ (S : Subgroup H)
    rw [hφ, MulEquiv.apply_symm_apply]
    exact hES hy
  · rintro _ ⟨y, hy, rfl⟩
    rw [← map_pow, hE1 y hy, map_one]
  · rw [Subgroup.card_map_of_injective e.symm.injective, hEc]

private theorem k1513b_g2_roots (Kf : Type) [Field Kf] [Finite Kf]
    (S : Subgroup (Fin Tag.G2.rank → (AlgebraicClosure Kf)ˣ))
    (hS : ∀ c, c ∈ S ↔ ∀ i, c i ^ (Nat.card Kf + 1) = 1) :
    Nat.card (rootsOfUnity (Nat.card Kf + 1) (AlgebraicClosure Kf)) = Nat.card Kf + 1 ∧
      Nonempty (S ≃* rootsOfUnity (Nat.card Kf + 1) (AlgebraicClosure Kf) ×
        rootsOfUnity (Nat.card Kf + 1) (AlgebraicClosure Kf)) := by
  classical
  have : Fintype Kf := Fintype.ofFinite Kf
  set q := Nat.card Kf with hq
  have hqK : ((q : ℕ) : Kf) = 0 := by
    rw [hq, Nat.card_eq_fintype_card]
    exact FiniteField.cast_card_eq_zero Kf
  have hdK : ((q + 1 : ℕ) : Kf) = 1 := by
    push_cast
    rw [hqK, zero_add]
  have : NeZero ((q + 1 : ℕ) : Kf) := ⟨by rw [hdK]; exact one_ne_zero⟩
  have : NeZero (q + 1) := ⟨Nat.succ_ne_zero q⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.prim (M := AlgebraicClosure Kf) (n := q + 1)
  refine ⟨hζ.card_rootsOfUnity, ⟨?_⟩⟩
  let f : S ≃* (Fin Tag.G2.rank → rootsOfUnity (q + 1) (AlgebraicClosure Kf)) :=
    { toFun := fun c i => ⟨c.1 i, (mem_rootsOfUnity _ _).2 ((hS c.1).1 c.2 i)⟩
      invFun := fun b => ⟨fun i => (b i : (AlgebraicClosure Kf)ˣ), (hS _).2 fun i =>
        (mem_rootsOfUnity _ _).1 (b i).2⟩
      left_inv := fun c => Subtype.ext rfl
      right_inv := fun b => funext fun i => Subtype.ext rfl
      map_mul' := fun c d => rfl }
  exact f.trans (MulEquiv.mk' (finTwoArrowEquiv _) fun _ _ => rfl)

private theorem k1513b_frobenius {p f : ℕ} (hp : p.Prime) (hf : 1 ≤ f) (Kf : Type) [Field Kf]
    (hK : Nat.card Kf = (p ^ f) ^ 3) :
    ∃ Fr : AlgebraicClosure Kf →+* AlgebraicClosure Kf, ∀ c, Fr c = c ^ (p ^ f) := by
  have : Finite Kf := Nat.finite_of_card_ne_zero (by
    rw [hK]
    exact pow_ne_zero _ (pow_ne_zero _ hp.ne_zero))
  have : Fact p.Prime := ⟨hp⟩
  have hK3 : Nat.card Kf = p ^ (f * 3) := by rw [hK, pow_mul]
  have : CharP Kf p :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic hp (by omega) hK3
  have : CharP (AlgebraicClosure Kf) p :=
    charP_of_injective_algebraMap (algebraMap Kf (AlgebraicClosure Kf)).injective p
  exact ⟨iterateFrobenius (AlgebraicClosure Kf) p f, fun c => by rw [iterateFrobenius_def]⟩

theorem g2NonsplitSylowInput_holds :
    G2NonsplitSylowInput := by
  intro K _ _ p f r hK hr hr5 hrd
  obtain ⟨Kf, hKF, hKFin, hKcard, ⟨e0⟩⟩ := (hK.chevalleyExceptionalModel (by decide)).2
  let : Field Kf := hKF
  let : Finite Kf := hKFin
  obtain ⟨T, S, ⟨eT⟩, hS⟩ := exists_twistedTorus_G2 Kf g2w0
  obtain ⟨hA, ⟨eS⟩⟩ := k1513b_g2_roots Kf S fun c => by rw [hS c, forall_rootChar_g2w0_iff]
  have hrd' : r ∣ Nat.card Kf + 1 := by rw [hKcard]; exact hrd
  have hT : Nat.card T = (Nat.card Kf + 1) ^ 2 := by
    rw [Nat.card_congr (eT.trans eS).toEquiv, Nat.card_prod, hA, sq]
  obtain ⟨S₁, hS₁⟩ := k1513b_sylow_le hr
    (not_dvd_index_of_card_negOne Kf hr (by omega) hrd' T hT)
  have : Finite (rootsOfUnity (Nat.card Kf + 1) (AlgebraicClosure Kf)) :=
    Nat.finite_of_card_ne_zero (by rw [hA]; omega)
  have hrA : r ∣ Nat.card (rootsOfUnity (Nat.card Kf + 1) (AlgebraicClosure Kf)) := by
    rw [hA]
    exact hrd'
  let eZ : CFSG.Blueprint.AdjointQuotient .G2 Kf ≃* adjointGroup .G2 Kf :=
    (QuotientGroup.quotientMulEquivOfEq
      (center_adjointGroup_eq_bot (τ := .G2) (K := Kf))).trans QuotientGroup.quotientBot
  exact k1513b_transport (e0.trans eZ) (k1513b_core hr hrA (eT.trans eS) S₁ hS₁)

theorem trialityTorusSylowInput_holds :
    TrialityTorusSylowInput := by
  intro K _ _ p f r hK hr hr5 hrd
  have hadm := hK.admissible
  obtain ⟨Kf, hKF, hKFin, σ, hKcard, hσ, ⟨e⟩⟩ := exists_mulEquiv_graphFixedRootGroup_card
    (t := .D4) hadm.1 hadm.2.1 (hK.chevalleyExceptionalModel (by decide)).2
  let : Field Kf := hKF
  let : Finite Kf := hKFin
  have hK3 : Nat.card Kf = (p ^ f) ^ 3 := hKcard
  obtain ⟨Fr, hFr⟩ := k1513b_frobenius hadm.1 hadm.2.1 Kf hK3
  have : Finite (graphFixedRootGroup TwistTag.D4 Kf σ.toRingHom) := Subtype.finite
  obtain ⟨-, ⟨g, hgG, hFg⟩, -, hall⟩ := triality_three_six_tori_Sylow_and_root_kernels hadm.1
    hadm.2.1 Kf hK3 σ hσ (AlgebraicClosure Kf) Fr hFr (ε := 1) (Or.inl rfl)
    (d := (p ^ f) ^ 2 + p ^ f + 1) (by push_cast; ring)
  obtain ⟨-, ⟨eT⟩, hall'⟩ := hall g hgG hFg
  obtain ⟨⟨S₁, hS₁⟩, -⟩ := hall' r hr (by omega) hrd
  have : NeZero ((p ^ f) ^ 2 + p ^ f + 1) := ⟨Nat.succ_ne_zero _⟩
  have hA : Nat.card (Multiplicative (ZMod ((p ^ f) ^ 2 + p ^ f + 1))) =
      (p ^ f) ^ 2 + p ^ f + 1 := by
    rw [Nat.card_congr Multiplicative.toAdd]
    exact Nat.card_zmod _
  exact k1513b_transport e (k1513b_core hr (by rw [hA]; exact hrd) eT S₁ hS₁)

