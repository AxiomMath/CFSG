private theorem covsmall_ZOf_eq_map {G : Type} [Group G] (Q : Subgroup G) :
    ZOf Q = (Subgroup.center ↥Q).map Q.subtype := by
  ext x
  rw [ZOf, Subgroup.mem_inf, Subgroup.mem_map, Subgroup.mem_centralizer_iff]
  constructor
  · rintro ⟨hxQ, hx⟩
    refine ⟨⟨x, hxQ⟩, Subgroup.mem_center_iff.mpr fun y => Subtype.ext (hx y y.2), rfl⟩
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y.2, fun h hh => congrArg Subtype.val (Subgroup.mem_center_iff.mp hy ⟨h, hh⟩)⟩

theorem card_ZOf_of_isExtraspecialExpP {G : Type} [Group G] [Finite G] {Q : Subgroup G}
    (hQ : IsExtraspecialExpP 3 1 ↥Q) : Nat.card (ZOf Q) = 3 := by
  rw [covsmall_ZOf_eq_map]
  exact center_card_three_of_isExtraspecialExpP hQ

theorem normalizer_le_of_ne_bot_of_gamma {G : Type} [Group G] [Finite G] {M Q A : Subgroup G}
    (hΓ : rankThreeGamma 1 3 Q ≤ M) (hQ : IsPGroup 3 Q) (hAQ : A ≤ Q) (hA : A ≠ ⊥) :
    normalizer (A : Set G) ≤ M := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hA3 : IsPGroup 3 A := hQ.to_le hAQ
  have hnt : Nontrivial A := (Subgroup.nontrivial_iff_ne_bot A).mpr hA
  obtain ⟨n, hn, hcard⟩ := hA3.nontrivial_iff_card.mp hnt
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' 3 (hcard ▸ dvd_pow_self 3 hn.ne')
  have hyord : orderOf (x : G) = 3 := by rw [Subgroup.orderOf_coe]; exact hx
  have hzA : zpowers (x : G) ≤ A := by rw [Subgroup.zpowers_le]; exact x.2
  have hzcard : Nat.card (zpowers (x : G)) = 3 := by rw [Nat.card_zpowers, hyord]
  have hel : IsElemAbelian 3 (zpowers (x : G)) :=
    CFSG.GroupTheory.isElemAbelian_of_card_prime hzcard
  have hrank : 1 ≤ CFSG.Open.pRank 3 A :=
    CFSG.SectionRank.le_pRank (p := 3) (by norm_num) hzA hel (by rw [hzcard]; norm_num)
  exact (CFSG.HardMathSupport.Solomon.Proving.normalizer_le_glbCore (p := 3) (k := 1) hAQ
    hrank).trans hΓ

private theorem covgweak_conjugate_center {Y : Type} [Group Y] (g : Y) :
    CFSG.conjugate (Subgroup.center Y) g = Subgroup.center Y :=
  Subgroup.map_center_eq (MulAut.conj g⁻¹)

private theorem covgweak_center_eq_ZOf {Y : Type} [Group Y] [Finite Y] (S : Sylow 3 Y)
    (hS : Nat.card (ZOf (S : Subgroup Y)) = 3) (hY : Nat.card (Subgroup.center Y) = 3) :
    Subgroup.center Y = ZOf (S : Subgroup Y) :=
  Subgroup.eq_of_le_of_card_ge
    (le_inf ((IsPGroup.of_card (n := 1) (by simpa using hY)).le_sylow_of_normal S)
      (Subgroup.center_le_centralizer _))
    (by rw [hS, hY])

private theorem covgweak_sylowCenterWeaklyClosed {Y : Type} [Group Y] [Finite Y]
    (S : Sylow 3 Y) (hS : Nat.card (ZOf (S : Subgroup Y)) = 3)
    (hY : Nat.card (Subgroup.center Y) = 3) : SylowCenterWeaklyClosed Y := by
  refine sylowCenterWeaklyClosed_of_exists_sylow S fun Z hZS hZc hZcard g _ => ?_
  have h2 : Z = ZOf (S : Subgroup Y) :=
    Subgroup.eq_of_le_of_card_ge (le_inf hZS hZc) (by rw [hS, hZcard])
  rw [h2, ← covgweak_center_eq_ZOf S hS hY]
  exact covgweak_conjugate_center g

private theorem covgweak_card_center {Y : Type} [Group Y]
    (hcov : IsA6Z3 Y ∨ IsA7Z3 Y ∨ IsM22Z3 Y) : Nat.card (Subgroup.center Y) = 3 := by
  rcases hcov with h | h | h <;> exact h.2.1

private theorem covgweak_exists_sylow_bar {G : Type} [Group G] [Finite G] {L Q : Subgroup G}
    (hQL : Q ≤ L) (hQsyl : ∃ S : Sylow 3 ↥L, (S : Subgroup ↥L) = Q.subgroupOf L)
    (hQO2 : Q ⊓ pCoreOf 2 L = ⊥)
    (hQZ : Nat.card ((Subgroup.center ↥Q).map Q.subtype) = 3) :
    ∃ Pb : Sylow 3 (Bar2 L),
      (Pb : Subgroup (Bar2 L)) =
          ((QuotientGroup.mk' (CFSG.pCore 2 ↥L)).comp (Subgroup.inclusion hQL)).range ∧
        Nat.card (ZOf (Pb : Subgroup (Bar2 L))) = 3 := by
  obtain ⟨Pb, hPb⟩ := exists_sylow_map_subgroupOf_mk' hQsyl
  let f : ↥Q →* Bar2 L := (QuotientGroup.mk' (CFSG.pCore 2 ↥L)).comp (Subgroup.inclusion hQL)
  have hf : Function.Injective f := injective_comp_subgroupOf_mk' hQL hQO2
  have hPb' : (Pb : Subgroup (Bar2 L)) = f.range :=
    hPb.trans (range_comp_subgroupOf_mk' hQL).symm
  refine ⟨Pb, hPb', ?_⟩
  have h2 := card_center_map_eq_of_injective f hf
  rw [Subgroup.card_map_of_injective hf,
    ← Subgroup.card_map_of_injective (f := Q.subtype) Q.subtype_injective, hQZ, ← hPb'] at h2
  rw [covsmall_ZOf_eq_map]
  exact h2

theorem cover_weakClosure_local {G : Type} [Group G] [Finite G] {D : Data G} {L Q P X : Subgroup G}
    (h : ChoiceX D L Q P X) (hcov : IsA6Z3 (Bar2 L) ∨ IsA7Z3 (Bar2 L) ∨ IsM22Z3 (Bar2 L))
    (hLM : D.M ≤ normalizer (L : Set G)) (h857 : R857 D) :
    ∀ m ∈ D.M, CFSG.conjugate (ZOf Q) m ≤ normalizer (ZOf Q : Set G) →
      CFSG.conjugate (ZOf Q) m = ZOf Q := by
  intro m hm hmZ
  have hQ : IsExtraspecialExpP 3 1 ↥Q := (h857 L Q P h.cex).2.2 hcov
  have hLMle : L ≤ D.M := h.cex.mem.1.le
  have hQL : Q ≤ L := h.cex.sylowQ.le
  have hQsyl := h.cex.sylowQ.exists_sylow_eq_subgroupOf
  have hQO2 : Q ⊓ pCoreOf 2 L = ⊥ := h.cex.inf_pCore_eq_bot
  have hQZ := center_card_three_of_isExtraspecialExpP hQ
  obtain ⟨Pb, -, hPb⟩ := covgweak_exists_sylow_bar hQL hQsyl hQO2 hQZ
  exact conjugate_eq_of_sylowCenterWeaklyClosed_bar
    (covgweak_sylowCenterWeaklyClosed Pb hPb (covgweak_card_center hcov)) hLMle
    ((Subgroup.normal_subgroupOf_iff_le_normalizer hLMle).mpr hLM) inf_le_left inf_le_right
    (card_ZOf_of_isExtraspecialExpP hQ) hQL hQsyl hQO2 hQZ hm hmZ

private theorem covgquasi_le_center_of_card_le_two {H : Type} [Group H] [Finite H]
    (K : Subgroup H) [K.Normal] (hK : Nat.card K ≤ 2) : K ≤ Subgroup.center H := by
  intro t ht
  rw [Subgroup.mem_center_iff]
  intro g
  by_cases ht1 : t = 1
  · rw [ht1, mul_one, one_mul]
  have hconj : g * t * g⁻¹ ∈ K := (inferInstance : K.Normal).conj_mem t ht g
  have hne : g * t * g⁻¹ ≠ 1 := fun h => ht1 (by
    have h' : t = g⁻¹ * (g * t * g⁻¹) * g := by group
    rw [h', h]
    group)
  have hnt : Nontrivial K := ⟨⟨⟨t, ht⟩, 1, fun h => ht1 (congrArg Subtype.val h)⟩⟩
  have h2 : Nat.card K = 2 := le_antisymm hK (Finite.one_lt_card (α := K))
  obtain ⟨y, -, hy⟩ := (Nat.card_eq_two_iff' (1 : K)).mp h2
  have h1 : (⟨g * t * g⁻¹, hconj⟩ : K) = y := hy _ fun h => hne (congrArg Subtype.val h)
  have h1' : (⟨t, ht⟩ : K) = y := hy _ fun h => ht1 (congrArg Subtype.val h)
  have hgt : g * t * g⁻¹ = t := congrArg Subtype.val (h1.trans h1'.symm)
  calc g * t = g * t * g⁻¹ * g := by group
    _ = t * g := by rw [hgt]

private theorem covgquasi_pow_three {G : Type} [Group G] {Q : Subgroup G}
    (hQ : IsExtraspecialExpP 3 1 ↥Q) (a : G) (ha : a ∈ Q) : a ^ 3 = 1 := by
  unfold IsExtraspecialExpP at hQ
  have := Monoid.pow_exponent_eq_one (⟨a, ha⟩ : Q)
  rw [hQ.2.1] at this
  exact congrArg Subtype.val this

private theorem covgquasi_mem_commutator {H : Type} [Group H] [Finite H] (R : Subgroup H)
    [R.Normal] (hRc : R ≤ Subgroup.center H) (hR2 : Nat.card R ≤ 2)
    (hsup : _root_.commutator H ⊔ R = ⊤) {q : H} (hq : q ^ 3 = 1) :
    q ∈ _root_.commutator H := by
  have hq' : q ∈ _root_.commutator H ⊔ R := hsup ▸ Subgroup.mem_top q
  obtain ⟨k, hk, z, hz, rfl⟩ := Subgroup.mem_sup_of_normal_right.mp hq'
  have hzc : Commute k z := Subgroup.mem_center_iff.mp (hRc hz) k
  have hz2 : z ^ 2 = 1 := by
    have h1 : z ^ Nat.card R = 1 := congrArg Subtype.val
      (pow_card_eq_one' (G := R) (x := ⟨z, hz⟩))
    have hpos : 0 < Nat.card R := Nat.card_pos
    rcases (by omega : Nat.card R = 1 ∨ Nat.card R = 2) with h | h
    · rw [h, pow_one] at h1
      rw [h1, one_pow]
    · rwa [h] at h1
  have h3 : k ^ 3 * z = 1 := by
    rw [hzc.mul_pow 3, show z ^ 3 = z by rw [pow_succ, hz2, one_mul]] at hq
    exact hq
  have hzK : z ∈ _root_.commutator H := by
    rw [eq_inv_of_mul_eq_one_right h3]
    exact Subgroup.inv_mem _ (Subgroup.pow_mem _ hk 3)
  exact Subgroup.mul_mem _ hk hzK

private theorem covgquasi_coverShape_of_cover {Y : Type} [Group Y]
    (hcov : IsA6Z3 Y ∨ IsA7Z3 Y ∨ IsM22Z3 Y) : IsCoverShape Y := by
  rcases hcov with ⟨hq, hc, ha⟩ | ⟨hq, hc, ha⟩ | ⟨hq, hc, ha⟩
  · exact ⟨hq, by rw [hc], Or.inl ha⟩
  · exact ⟨hq, by rw [hc], Or.inr (Or.inl ha)⟩
  · exact ⟨hq, by rw [hc], Or.inr (Or.inr ha)⟩

private theorem covgquasi_isCoverShape_of_surjective {K Y : Type} [Group K] [Group Y]
    (hK : Group.IsPerfect K) (f : K →* Y) (hf : Function.Surjective f)
    (hker : f.ker ≤ Subgroup.center K) (hY : IsCoverShape Y) : IsCoverShape K := by
  obtain ⟨hq, h3, hs⟩ := hY
  have := hK
  have e := CFSG.ComponentClassification.PerfectCentralQuotient.equivalence f hf hker
  refine ⟨(CFSG.LocalCores.isQuasisimple_iff_of_surjective hK f hf hker).mpr hq, ?_, ?_⟩
  · have hmap : (Subgroup.center K).map f = Subgroup.center Y := by
      rw [← CFSG.LocalCores.comap_center_eq_of_perfect hK f hf hker]
      exact Subgroup.map_comap_eq_self_of_surjective hf _
    exact h3.trans (by rw [← hmap]; exact Subgroup.card_map_dvd _ f)
  · rcases hs with ha | ha | ha
    · obtain ⟨a⟩ := ha
      exact Or.inl ⟨e.trans a⟩
    · obtain ⟨a⟩ := ha
      exact Or.inr (Or.inl ⟨e.trans a⟩)
    · obtain ⟨a⟩ := ha
      exact Or.inr (Or.inr ⟨e.trans a⟩)

private theorem covgquasi_derived {H Y : Type} [Group H] [Group Y] (f : H →* Y)
    (hf : Function.Surjective f) (hker : f.ker ≤ Subgroup.center H) (hY : IsCoverShape Y) :
    CFSG.IsQuasisimple ↥(_root_.commutator H) ∧ IsCoverShape ↥(_root_.commutator H) ∧
      _root_.commutator H ⊔ f.ker = ⊤ ∧
      ∀ x ∈ _root_.commutator H, f x ∈ Subgroup.center Y →
        ∀ y ∈ _root_.commutator H, y * x = x * y := by
  obtain ⟨hsup, hperf, hsurj⟩ :=
    CFSG.LocalCores.central_extension_derived_of_surjective f hf hker hY.1.1
  have hker' : (f.comp (_root_.commutator H).subtype).ker ≤
      Subgroup.center ↥(_root_.commutator H) := fun x hx =>
    Subgroup.mem_center_iff.mpr fun y =>
      Subtype.ext (Subgroup.mem_center_iff.mp (hker (MonoidHom.mem_ker.mpr hx)) y)
  refine ⟨CFSG.LocalCores.quasisimple_central_extension_derived_of_surjective f hf hker hY.1,
    covgquasi_isCoverShape_of_surjective hperf _ hsurj hker' hY, hsup, ?_⟩
  intro x hx hfx y hy
  have hxc : (⟨x, hx⟩ : ↥(_root_.commutator H)) ∈ Subgroup.center ↥(_root_.commutator H) := by
    rw [← CFSG.LocalCores.comap_center_eq_of_perfect hperf _ hsurj hker']
    exact hfx
  exact congrArg Subtype.val (Subgroup.mem_center_iff.mp hxc ⟨y, hy⟩)

private theorem covgquasi_sup_eq {G : Type} [Group G] [Finite G] {D : Data G}
    {L Q P X : Subgroup G} (h : ChoiceX D L Q P X) (h859 : R859 D)
    (hXL : ⁅L, X⁆ ≤ pCoreOf 2 L) :
    L ⊓ centralizer (X : Set G) ⊔ pCoreOf 2 L = L := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hXN : X ≤ normalizer (L : Set G) := h.le.trans (h859 L Q P h.cex)
  have hX3 : IsPGroup 3 X := IsPGroup.of_card (n := 1) (by rw [h.card]; norm_num)
  have hN : ¬ 3 ∣ Nat.card (pCoreOf 2 L) := by
    obtain ⟨n, hn⟩ :=
      (IsPGroup.iff_card (p := 2)).mp (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 L)
    rw [hn]
    exact fun hd => by
      have := Nat.Prime.dvd_of_dvd_pow Nat.prime_three hd
      omega
  exact CFSG.GroupTheory.inf_centralizer_sup_eq_of_commutator_le (p := 3)
    (Subgroup.map_subtype_le _) hXN
    (hXN.trans
      (CFSG.RankThreeCoreUniqueness.Helpers.normalizer_localGroup_le_normalizer_pCoreOf 2 L))
    hX3 hN hXL

private theorem covgquasi_card_le {G : Type} [Group G] [Finite G] {D : Data G}
    {L Q P X : Subgroup G} (h : ChoiceX D L Q P X) (hLM : D.M ≤ normalizer (L : Set G))
    (h69 : UC6.R6_9 D) (hsub : D.sig ⊆ D.sig1) (hQ : IsExtraspecialExpP 3 1 ↥Q)
    (hQC : Q ≤ centralizer (X : Set G)) :
    Nat.card ↥(pCoreOf 2 L ⊓ centralizer (X : Set G)) ≤ 2 := by
  obtain ⟨E, hEQ, hEel, hEcard⟩ := exists_elemAbelian_nine_le_of_isExtraspecialExpP hQ
  have hPM : P ≤ D.M := h.cex.sylowP.le
  have hEM : E ≤ D.M := hEQ.trans (h.cex.le.trans hPM)
  have hΓ : rankThreeGamma 1 3 E ≤ D.M :=
    (CFSG.HardMathSupport.Solomon.Proving.GLBCore_mono hEQ).trans h.cex.gamma
  have hEN : E ≤ normalizer (X : Set G) :=
    (hEQ.trans hQC).trans (Subgroup.centralizer_le_normalizer _)
  have hnot : ¬ normalizer (X : Set G) ≤ D.M := fun hle =>
    h.notLe ((Subgroup.centralizer_le_normalizer _).trans hle)
  have key := (h69 hsub 3 Nat.prime_three (by norm_num) E hEM hEel (by rw [hEcard]; norm_num) hΓ
    3 X Nat.prime_three (h.le.trans hPM) h.card hEN hnot P hPM h.cex.sylowP.isPGroup h.le).1.1
  exact (Subgroup.card_le_of_le (inf_le_inf_right _
    (CFSG.GroupTheory.pCoreOf_le_pCoreOf_of_le_normalizer 2 h.cex.mem.1.le hLM))).trans key

private theorem covgquasi_exists_map {G : Type} [Group G] [Finite G] {D : Data G}
    {L Q P X : Subgroup G} (h : ChoiceX D L Q P X) (hLM : D.M ≤ normalizer (L : Set G))
    (h69 : UC6.R6_9 D) (hsub : D.sig ⊆ D.sig1) (h859 : R859 D) (hXL : ⁅L, X⁆ ≤ pCoreOf 2 L)
    (hQ : IsExtraspecialExpP 3 1 ↥Q) (hQC : Q ≤ centralizer (X : Set G)) :
    ∃ f : ↥(L ⊓ centralizer (X : Set G)) →* Bar2 L, Function.Surjective f ∧ Nat.card f.ker ≤ 2 ∧
      ∀ x : ↥(L ⊓ centralizer (X : Set G)),
        f x = QuotientGroup.mk' (CFSG.pCore 2 ↥L) ⟨x.1, x.2.1⟩ := by
  let f : ↥(L ⊓ centralizer (X : Set G)) →* Bar2 L :=
    (QuotientGroup.mk' (CFSG.pCore 2 ↥L)).comp (Subgroup.inclusion inf_le_left)
  refine ⟨f, ?_, ?_, fun x => rfl⟩
  · intro y
    obtain ⟨l, rfl⟩ := QuotientGroup.mk'_surjective (CFSG.pCore 2 ↥L) y
    have hl : (l : G) ∈ (↑(L ⊓ centralizer (X : Set G) ⊔ pCoreOf 2 L) : Set G) := by
      rw [covgquasi_sup_eq h h859 hXL]
      exact l.2
    rw [Subgroup.coe_mul_of_left_le_normalizer_right _ _ (inf_le_left.trans
      (CFSG.RankThreeCoreUniqueness.Helpers.localGroup_le_normalizer_pCoreOf 2 L))] at hl
    obtain ⟨a, ha, n, hn, hln⟩ := Set.mem_mul.mp hl
    obtain ⟨n', hn', rfl⟩ := Subgroup.mem_map.mp hn
    refine ⟨⟨a, ha⟩, ?_⟩
    have hl' : Subgroup.inclusion (inf_le_left : L ⊓ centralizer (X : Set G) ≤ L) ⟨a, ha⟩ * n' =
        l := Subtype.ext hln
    have hn1 : QuotientGroup.mk' (CFSG.pCore 2 ↥L) n' = 1 := (QuotientGroup.eq_one_iff n').mpr hn'
    show QuotientGroup.mk' (CFSG.pCore 2 ↥L) (Subgroup.inclusion _ ⟨a, ha⟩) =
      QuotientGroup.mk' (CFSG.pCore 2 ↥L) l
    rw [← hl', map_mul, hn1, mul_one]
  · have hmem : ∀ x : f.ker, ((x : ↥(L ⊓ centralizer (X : Set G))) : G) ∈
        pCoreOf 2 L ⊓ centralizer (X : Set G) := by
      intro x
      have hx : f x.1 = 1 := x.2
      have hx' : Subgroup.inclusion (inf_le_left : L ⊓ centralizer (X : Set G) ≤ L) x.1 ∈
          CFSG.pCore 2 ↥L := (QuotientGroup.eq_one_iff _).mp hx
      exact ⟨Subgroup.mem_map.mpr ⟨_, hx', rfl⟩, x.1.2.2⟩
    have hinj : Function.Injective fun x : f.ker =>
        (⟨((x : ↥(L ⊓ centralizer (X : Set G))) : G), hmem x⟩ :
          ↥(pCoreOf 2 L ⊓ centralizer (X : Set G))) := by
      intro a b hab
      have h1 := congrArg Subtype.val hab
      exact Subtype.ext (Subtype.ext h1)
    exact (Nat.card_le_card_of_injective _ hinj).trans (covgquasi_card_le h hLM h69 hsub hQ hQC)

private theorem covgquasi_ZOf_le {G : Type} [Group G] (Q : Subgroup G) : ZOf Q ≤ Q := inf_le_left

private theorem covgquasi_mk_mem_center {G : Type} [Group G] [Finite G] {L Q : Subgroup G}
    (hQL : Q ≤ L) (hQsyl : ∃ S : Sylow 3 ↥L, (S : Subgroup ↥L) = Q.subgroupOf L)
    (hQO2 : Q ⊓ pCoreOf 2 L = ⊥) (hQZ : Nat.card ((Subgroup.center ↥Q).map Q.subtype) = 3)
    (hY : Nat.card (Subgroup.center (Bar2 L)) = 3) {z : G} (hz : z ∈ ZOf Q) :
    QuotientGroup.mk' (CFSG.pCore 2 ↥L) ⟨z, hQL (covgquasi_ZOf_le Q hz)⟩ ∈
      Subgroup.center (Bar2 L) := by
  obtain ⟨Pb, hPb, hcard⟩ := covgweak_exists_sylow_bar hQL hQsyl hQO2 hQZ
  rw [covgweak_center_eq_ZOf Pb hcard hY]
  rw [covsmall_ZOf_eq_map] at hz
  obtain ⟨c, hc, rfl⟩ := Subgroup.mem_map.mp hz
  let f : ↥Q →* Bar2 L := (QuotientGroup.mk' (CFSG.pCore 2 ↥L)).comp (Subgroup.inclusion hQL)
  refine ⟨?_, Subgroup.mem_centralizer_iff.mpr fun p hp => ?_⟩
  · rw [hPb]
    exact ⟨c, rfl⟩
  · rw [hPb] at hp
    obtain ⟨q, rfl⟩ := hp
    change f q * f c = f c * f q
    rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.mp hc q]

private theorem covgquasi_normal {G : Type} [Group G] {M L C : Subgroup G}
    (hLM : M ≤ normalizer (L : Set G)) (hLMle : L ≤ M) :
    (((_root_.commutator ↥(L ⊓ C)).map (L ⊓ C).subtype).subgroupOf (M ⊓ C)).Normal := by
  have hLX : (_root_.commutator ↥(L ⊓ C)).map (L ⊓ C).subtype ≤ M ⊓ C :=
    (Subgroup.map_subtype_le _).trans (inf_le_inf_right C hLMle)
  rw [Subgroup.normal_subgroupOf_iff_le_normalizer hLX, Subgroup.map_subtype_commutator]
  intro y hy
  have hyL : y ∈ normalizer (L : Set G) := hLM hy.1
  have hyC : y ∈ normalizer (C : Set G) := Subgroup.le_normalizer hy.2
  have hyH : y ∈ normalizer ((L ⊓ C : Subgroup G) : Set G) := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq] at hyL hyC ⊢
    rw [Subgroup.map_inf _ _ _ (MulAut.conj y).injective, hyL, hyC]
  rw [Subgroup.mem_normalizer_iff_map_conj_eq] at hyH ⊢
  rw [Subgroup.map_commutator, hyH]

theorem quasisimple_centralizer_cover {G : Type} [Group G] [Finite G] {D : Data G}
    {L Q P X : Subgroup G} (h : ChoiceX D L Q P X)
    (hcov : IsA6Z3 (Bar2 L) ∨ IsA7Z3 (Bar2 L) ∨ IsM22Z3 (Bar2 L))
    (hLM : D.M ≤ normalizer (L : Set G)) (h69 : UC6.R6_9 D) (hsub : D.sig ⊆ D.sig1)
    (h857 : R857 D) (h859 : R859 D) (hXL : ⁅L, X⁆ ≤ pCoreOf 2 L) :
    ∃ LX : Subgroup G, LX ≤ L ⊓ centralizer (X : Set G) ∧ IsQuasisimple ↥LX ∧
      IsCoverShape ↥LX ∧ Q ≤ LX ∧ ZOf Q ≤ centralizer (LX : Set G) ∧
      (LX.subgroupOf (D.M ⊓ centralizer (X : Set G))).Normal := by
  have hQext : IsExtraspecialExpP 3 1 ↥Q := (h857 L Q P h.cex).2.2 hcov
  have hQL : Q ≤ L := h.cex.sylowQ.le
  have hQC : Q ≤ centralizer (X : Set G) := fun a ha => Subgroup.mem_centralizer_iff.mpr
    fun x hx => h.centralizes_sylowQ h859 hXL x hx a ha
  have hQsyl := h.cex.sylowQ.exists_sylow_eq_subgroupOf
  have hQO2 : Q ⊓ pCoreOf 2 L = ⊥ := h.cex.inf_pCore_eq_bot
  have hQZ := center_card_three_of_isExtraspecialExpP hQext
  have hY : Nat.card (Subgroup.center (Bar2 L)) = 3 := covgweak_card_center hcov
  obtain ⟨f, hf, hfker, hfeq⟩ := covgquasi_exists_map h hLM h69 hsub h859 hXL hQext hQC
  have hker : f.ker ≤ Subgroup.center ↥(L ⊓ centralizer (X : Set G)) :=
    covgquasi_le_center_of_card_le_two f.ker hfker
  obtain ⟨hKq, hKcov, hsup, hKc⟩ :=
    covgquasi_derived f hf hker (covgquasi_coverShape_of_cover hcov)
  have hQLX : Q ≤ (_root_.commutator ↥(L ⊓ centralizer (X : Set G))).map
      (L ⊓ centralizer (X : Set G)).subtype := fun q hq =>
    ⟨⟨q, hQL hq, hQC hq⟩, covgquasi_mem_commutator f.ker hker hfker hsup
      (Subtype.ext (covgquasi_pow_three hQext q hq)), rfl⟩
  let e := Subgroup.equivMapOfInjective (_root_.commutator ↥(L ⊓ centralizer (X : Set G)))
    (L ⊓ centralizer (X : Set G)).subtype (L ⊓ centralizer (X : Set G)).subtype_injective
  refine ⟨(_root_.commutator ↥(L ⊓ centralizer (X : Set G))).map
    (L ⊓ centralizer (X : Set G)).subtype, Subgroup.map_subtype_le _,
    CFSG.IsQuasisimple.of_mulEquiv e.symm hKq, IsCoverShape.of_mulEquiv e hKcov, hQLX, ?_,
    covgquasi_normal hLM h.cex.mem.1.le⟩
  intro z hz
  obtain ⟨k, hk, rfl⟩ := hQLX (covgquasi_ZOf_le Q hz)
  refine Subgroup.mem_centralizer_iff.mpr fun w hw => ?_
  obtain ⟨y, hy, rfl⟩ := hw
  have hfk : f k ∈ Subgroup.center (Bar2 L) := by
    rw [hfeq]
    exact covgquasi_mk_mem_center hQL hQsyl hQO2 hQZ hY hz
  exact congrArg Subtype.val (hKc k hk hfk y hy)

private theorem covgkn_exists_sylow {G : Type} [Group G] [Finite G] {C Z : Subgroup G}
    (hZC : Z ≤ C) (hZ3 : IsPGroup 3 Z) :
    ∃ S : Subgroup G, CFSG.ABGLocalTools.IsSylowOf 3 S C ∧ Z ≤ S := by
  obtain ⟨T, hT⟩ := (hZ3.comap_subtype (K := C)).exists_le_sylow
  exact ⟨(T : Subgroup ↥C).map C.subtype, ⟨T, rfl⟩, fun z hz =>
    Subgroup.mem_map.mpr ⟨⟨z, hZC hz⟩, hT (Subgroup.mem_subgroupOf.mpr hz), rfl⟩⟩

private theorem covgkn_le {G : Type} [Group G] {C Z : Subgroup G} (hZC : Z ≤ C) :
    Subgroup.closure {x : G | ∃ c ∈ C, ∃ z ∈ Z, x = c⁻¹ * z * c} ≤ C := by
  refine (Subgroup.closure_le C).mpr ?_
  rintro x ⟨c, hc, z, hz, rfl⟩
  exact C.mul_mem (C.mul_mem (C.inv_mem hc) (hZC hz)) hc

private theorem covgkn_normal {G : Type} [Group G] {C Z : Subgroup G} (hZC : Z ≤ C) :
    ((Subgroup.closure {x : G | ∃ c ∈ C, ∃ z ∈ Z, x = c⁻¹ * z * c}).subgroupOf C).Normal := by
  rw [Subgroup.normal_subgroupOf_iff_le_normalizer (covgkn_le hZC)]
  have hconj : ∀ g ∈ C, ∀ h ∈ Subgroup.closure {x : G | ∃ c ∈ C, ∃ z ∈ Z, x = c⁻¹ * z * c},
      g * h * g⁻¹ ∈ Subgroup.closure {x : G | ∃ c ∈ C, ∃ z ∈ Z, x = c⁻¹ * z * c} := by
    intro g hg h hh
    induction hh using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨c, hc, z, hz, rfl⟩ := hx
      refine Subgroup.subset_closure ⟨c * g⁻¹, C.mul_mem hc (C.inv_mem hg), z, hz, ?_⟩
      group
    | one => simp
    | mul x y _ _ hx hy =>
      have e : g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) := by group
      rw [e]
      exact Subgroup.mul_mem _ hx hy
    | inv x _ hx =>
      have e : g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ := by group
      rw [e]
      exact Subgroup.inv_mem _ hx
  intro g hg
  rw [Subgroup.mem_normalizer_iff]
  intro h
  refine ⟨hconj g hg h, fun hh => ?_⟩
  have e : g⁻¹ * (g * h * g⁻¹) * g⁻¹⁻¹ = h := by group
  have := hconj g⁻¹ (C.inv_mem hg) _ hh
  rwa [e] at this

theorem cover_not_le_of_notLe {G : Type} [Group G] [Finite G] {D : Data G} {L Q P X : Subgroup G}
    (h : ChoiceX D L Q P X) (hcov : IsA6Z3 (Bar2 L) ∨ IsA7Z3 (Bar2 L) ∨ IsM22Z3 (Bar2 L))
    (h857 : R857 D) (hQC : Q ≤ centralizer (X : Set G))
    (hwc : IsWeaklyClosedIn (ZOf Q) (normalizer (ZOf Q : Set G))) :
    ¬ Subgroup.closure {x : G | ∃ c ∈ centralizer (X : Set G), ∃ z ∈ ZOf Q, x = c⁻¹ * z * c} ≤
      D.M := by
  intro hKM
  have hQext : IsExtraspecialExpP 3 1 ↥Q := (h857 L Q P h.cex).2.2 hcov
  have hZC : ZOf Q ≤ centralizer (X : Set G) := (covgquasi_ZOf_le Q).trans hQC
  have hZcard : Nat.card (ZOf Q) = 3 := card_ZOf_of_isExtraspecialExpP hQext
  have hNM : normalizer (ZOf Q : Set G) ≤ D.M :=
    normalizer_le_of_card_three_of_gamma h.cex.gamma (covgquasi_ZOf_le Q) hZcard
  have hZ3 : IsPGroup 3 (ZOf Q) := IsPGroup.of_card (n := 1) (by simpa using hZcard)
  obtain ⟨S, hS, hZS⟩ := covgkn_exists_sylow hZC hZ3
  have hZK : ZOf Q ≤
      Subgroup.closure {x : G | ∃ c ∈ centralizer (X : Set G), ∃ z ∈ ZOf Q, x = c⁻¹ * z * c} :=
    fun z hz => Subgroup.subset_closure ⟨1, Subgroup.one_mem _, z, hz, by group⟩
  have hKeq := eq_sup_inf_normalizer_of_isWeaklyClosedIn_normalizer (covgkn_le hZC)
    (covgkn_normal hZC) hZK hS hZS hwc
  exact h.notLe (hKeq.le.trans (sup_le hKM (inf_le_left.trans hNM)))

private theorem covgtrans_zOf_subgroupOf {G : Type} [Group G] {Q C : Subgroup G} (hQC : Q ≤ C) :
    ZOf (Q.subgroupOf C) = (ZOf Q).subgroupOf C := by
  ext x
  simp only [ZOf, Subgroup.mem_inf, Subgroup.mem_subgroupOf, Subgroup.mem_centralizer_iff,
    SetLike.mem_coe]
  constructor
  · rintro ⟨hx, hc⟩
    exact ⟨hx, fun y hy => congrArg Subtype.val (hc ⟨y, hQC hy⟩ hy)⟩
  · rintro ⟨hx, hc⟩
    exact ⟨hx, fun y hy => Subtype.ext (hc y.1 hy)⟩

private theorem covgtrans_card {G : Type} [Group G] {Z C : Subgroup G} (hZC : Z ≤ C)
    (hZ : Nat.card Z = 3) : Nat.card (Z.subgroupOf C) = 3 := by
  rw [← hZ]
  exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hZC).toEquiv

private theorem covgtrans_lnorm {G : Type} [Group G] {M C Z L : Subgroup G}
    (hZM : normalizer (Z : Set G) ≤ M) (hZC : Z ≤ C) (hLM : L ≤ M)
    (hln : (L.subgroupOf (M ⊓ C)).Normal) :
    ((L.subgroupOf C).subgroupOf
      (centralizer ((Z.subgroupOf C : Subgroup ↥C) : Set ↥C))).Normal := by
  refine ⟨fun n hn g => ?_⟩
  have hgZ : ((g : ↥C) : G) ∈ centralizer (Z : Set G) :=
    Subgroup.mem_centralizer_iff.mpr fun z hz =>
      congrArg Subtype.val (Subgroup.mem_centralizer_iff.mp g.2 ⟨z, hZC hz⟩
        (Subgroup.mem_subgroupOf.mpr hz))
  have hgMC : ((g : ↥C) : G) ∈ M ⊓ C :=
    Subgroup.mem_inf.mpr ⟨hZM (Subgroup.centralizer_le_normalizer _ hgZ), (g : ↥C).2⟩
  have hnL : (((n : ↥C) : ↥C) : G) ∈ L := hn
  have hnMC : (((n : ↥C) : ↥C) : G) ∈ M ⊓ C :=
    Subgroup.mem_inf.mpr ⟨hLM hnL, ((n : ↥C) : ↥C).2⟩
  exact hln.conj_mem ⟨(((n : ↥C) : ↥C) : G), hnMC⟩ hnL ⟨((g : ↥C) : G), hgMC⟩

private theorem covgtrans_nq {G : Type} [Group G] {M C Q : Subgroup G}
    (hnq : ∀ A : Subgroup G, A ≤ Q → A ≠ ⊥ → normalizer (A : Set G) ≤ M)
    (A : Subgroup ↥C) (hA : A ≤ Q.subgroupOf C) (hA0 : A ≠ ⊥) :
    normalizer (A : Set ↥C) ≤ (M ⊓ C).subgroupOf C := by
  have hAQ : A.map C.subtype ≤ Q := Subgroup.map_le_iff_le_comap.mpr hA
  have hAbot : A.map C.subtype ≠ ⊥ := fun hb =>
    hA0 ((Subgroup.map_eq_bot_iff_of_injective A C.subtype_injective).mp hb)
  intro y hy
  exact Subgroup.mem_subgroupOf.mpr
    (Subgroup.mem_inf.mpr ⟨hnq _ hAQ hAbot (Subgroup.le_normalizer_map C.subtype
      (Subgroup.mem_map_of_mem C.subtype hy)), y.2⟩)

private theorem covgtrans_pPrimeCore_le {G : Type} [Group G] [Finite G] {M C Q : Subgroup G}
    (ho3 : ∀ O : Subgroup G, Q ≤ normalizer (O : Set G) → Nat.Coprime 3 (Nat.card O) → O ≤ M)
    (hQC : Q ≤ C) : (CFSG.pPrimeCore 3 ↥C).map C.subtype ≤ M := by
  refine ho3 _ ?_ ?_
  · rw [Subgroup.le_normalizer_iff]
    intro q hq x hx
    obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.mp hx
    refine Subgroup.mem_map.mpr ⟨⟨q, hQC hq⟩ * z * ⟨q, hQC hq⟩⁻¹, ?_, ?_⟩
    · exact (CFSG.pPrimeCore_normal (p := 3) (G := ↥C)).conj_mem z hz ⟨q, hQC hq⟩
    · simp
  · rw [Subgroup.card_map_of_injective C.subtype_injective]
    exact CFSG.pPrimeCore_coprime_card

private theorem covgtrans_kn {G : Type} [Group G] [Finite G] {M C Z Q : Subgroup G}
    (ho3 : ∀ O : Subgroup G, Q ≤ normalizer (O : Set G) → Nat.Coprime 3 (Nat.card O) → O ≤ M)
    (hZC : Z ≤ C) (hQC : Q ≤ C)
    (hkn : ¬ Subgroup.closure {x : G | ∃ c ∈ C, ∃ z ∈ Z, x = c⁻¹ * z * c} ≤ M) :
    ¬ Subgroup.normalClosure ((Z.subgroupOf C : Subgroup ↥C) : Set ↥C) ≤
      (M ⊓ C).subgroupOf C ⊔ CFSG.pPrimeCore 3 ↥C := by
  intro hle
  have hO : (CFSG.pPrimeCore 3 ↥C).map C.subtype ≤ M := covgtrans_pPrimeCore_le ho3 hQC
  have hsup : (M ⊓ C) ⊓ C ⊔ (CFSG.pPrimeCore 3 ↥C).map C.subtype ≤ M :=
    sup_le (inf_le_left.trans inf_le_left) hO
  refine hkn ((Subgroup.closure_le M).mpr ?_)
  rintro x ⟨c, hc, z, hz, rfl⟩
  have hz' : (⟨z, hZC hz⟩ : ↥C) ∈ Z.subgroupOf C := Subgroup.mem_subgroupOf.mpr hz
  have hw : (⟨c, hc⟩ : ↥C)⁻¹ * ⟨z, hZC hz⟩ * (⟨c, hc⟩ : ↥C) ∈
      Subgroup.normalClosure ((Z.subgroupOf C : Subgroup ↥C) : Set ↥C) := by
    have := Subgroup.normalClosure_normal.conj_mem _ (Subgroup.subset_normalClosure hz')
      (⟨c, hc⟩ : ↥C)⁻¹
    rwa [inv_inv] at this
  have hmem := Subgroup.mem_map_of_mem C.subtype (hle hw)
  rw [Subgroup.map_sup, Subgroup.subgroupOf_map_subtype] at hmem
  exact hsup hmem

theorem coverCore_of_coverCoreG {G : Type} [Group G] [Finite G] {M C Z Q L : Subgroup G}
    (h : CoverCoreG M C Z Q L) :
    CoverCore (Z.subgroupOf C) (Q.subgroupOf C) (L.subgroupOf C) ((M ⊓ C).subgroupOf C) := by
  have hZQ : Z ≤ Q := h.zq.le.trans (covgquasi_ZOf_le Q)
  have hQC : Q ≤ C := h.ql.trans h.lC
  have hZC : Z ≤ C := hZQ.trans hQC
  have hZbot : Z ≠ ⊥ := fun hb => by
    have h3 := h.zcard
    rw [hb, Subgroup.card_bot] at h3
    omega
  exact
    { kgroup := h.kgroup
      rank := h.rank
      zcard := covgtrans_card hZC h.zcard
      wc := isWeaklyClosedIn_subgroupOf_normalizer hZC h.wc
      zq := by rw [covgtrans_zOf_subgroupOf hQC, ← h.zq]
      qext := isExtraspecialExpP_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hQC) h.qext
      ql := fun x hx => Subgroup.mem_subgroupOf.mpr (h.ql (Subgroup.mem_subgroupOf.mp hx))
      lq := CFSG.IsQuasisimple.of_mulEquiv (Subgroup.subgroupOfEquivOfLe h.lC) h.lq
      lcov := IsCoverShape.of_mulEquiv (Subgroup.subgroupOfEquivOfLe h.lC).symm h.lcov
      lcz := fun l hl => Subgroup.mem_centralizer_iff.mpr fun z hz => Subtype.ext
        ((Subgroup.mem_centralizer_iff.mp (h.lcz (Subgroup.mem_subgroupOf.mp hl))) z.1
          (Subgroup.mem_subgroupOf.mp hz))
      lnorm := covgtrans_lnorm (h.nq Z hZQ hZbot) hZC h.lM h.lnorm
      nq := fun A hA hA0 => covgtrans_nq h.nq A hA hA0
      kn := covgtrans_kn h.o3 hZC hQC h.kn }

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8
