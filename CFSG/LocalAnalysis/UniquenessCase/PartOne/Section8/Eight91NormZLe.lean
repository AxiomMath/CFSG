theorem s891_norm_z_not_le {G : Type} [Group G] [Finite G] (D : Data G)
    (hSg : SigmaStd D) (h63 : UC6.R6_3 D) (L S R A : Subgroup G) (n : ℕ)
    (hset : R891Set D L S n) (hbasic : R891Basic D L S) (hctx : R891Ctx D L S n R A)
