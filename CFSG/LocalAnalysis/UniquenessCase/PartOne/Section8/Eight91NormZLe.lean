private theorem k891normzle_normalizer_map_conj {G : Type} [Group G] (H : Subgroup G) (g : G) :
    Subgroup.normalizer ((H.map (MulAut.conj g).toMonoidHom : Subgroup G) : Set G) =
      (Subgroup.normalizer (H : Set G)).map (MulAut.conj g).toMonoidHom := by
  refine le_antisymm ?_ (Subgroup.le_normalizer_map (H := H)
    (f := (MulAut.conj g).toMonoidHom))
  have hcomp : (MulAut.conj g⁻¹).toMonoidHom.comp (MulAut.conj g).toMonoidHom =
      MonoidHom.id G := by
    ext x
    simp [MulAut.conj_apply]
    group
  have hH : (H.map (MulAut.conj g).toMonoidHom).map (MulAut.conj g⁻¹).toMonoidHom = H := by
    rw [Subgroup.map_map, hcomp, Subgroup.map_id]
  have hle := Subgroup.le_normalizer_map (H := H.map (MulAut.conj g).toMonoidHom)
    (f := (MulAut.conj g⁻¹).toMonoidHom)
  rw [hH] at hle
  have h2 := Subgroup.map_mono (f := (MulAut.conj g).toMonoidHom) hle
  rw [Subgroup.map_map] at h2
  have hcomp' : (MulAut.conj g).toMonoidHom.comp (MulAut.conj g⁻¹).toMonoidHom =
      MonoidHom.id G := by
    ext x
    simp [MulAut.conj_apply]
    group
  rw [hcomp', Subgroup.map_id] at h2
  exact h2

private theorem k891normzle_map_conj_self {G : Type} [Group G] {H : Subgroup G} {h : G}
    (hh : h ∈ H) : H.map (MulAut.conj h).toMonoidHom = H :=
  Subgroup.mem_normalizer_iff_map_conj_eq.mp (Subgroup.le_normalizer hh)

private theorem k891normzle_eq_one_or_eq_of_card_two {M : Type} [Group M] [Finite M]
    (hcard : Nat.card M = 2) {y : M} (hy : y ≠ 1) (x : M) : x = 1 ∨ x = y := by
  classical
  have : Fintype M := Fintype.ofFinite M
  have hcard2 : (insert 1 ({y} : Finset M)).card = 2 := by
    rw [Finset.card_insert_of_notMem
      (by rw [Finset.mem_singleton]; exact fun h => hy h.symm), Finset.card_singleton]
  have hcardU : (Finset.univ : Finset M).card = 2 := by
    rw [Finset.card_univ, Fintype.card_eq_nat_card, hcard]
  have huniv : (insert 1 ({y} : Finset M)) = Finset.univ :=
    Finset.eq_of_subset_of_card_le (Finset.subset_univ _) (by rw [hcard2, hcardU])
  have hx : x ∈ (insert 1 ({y} : Finset M)) := by rw [huniv]; exact Finset.mem_univ x
  simpa [Finset.mem_insert, Finset.mem_singleton] using hx

private theorem k891normzle_pi_mem_zOf_barImage {G : Type} [Group G] [Finite G]
    {L P0 : Subgroup G} (hP0L : P0 ≤ L) {z : G} (hz : z ∈ ZOf P0) :
    uc22p21cPi L ⟨z, hP0L hz.1⟩ ∈ ZOf (barImage L P0) := by
  rw [ZOf, Subgroup.mem_inf]
  constructor
  · exact uc22p21c_mem_barImage.2 ⟨⟨z, hP0L hz.1⟩, hz.1, rfl⟩
  · rw [Subgroup.mem_centralizer_iff]
    intro y hy
    obtain ⟨p, hpP0, rfl⟩ := uc22p21c_mem_barImage.1 hy
    have hcomm : (p : ↥L) * ⟨z, hP0L hz.1⟩ =
        ⟨z, hP0L hz.1⟩ * p := by
      ext
      exact Subgroup.mem_centralizer_iff.mp hz.2 (p : G) hpP0
    rw [← map_mul, ← map_mul, hcomm]

private theorem k891normzle_dvd_card_normalizer_z {G : Type} [Group G] [Finite G] (D : Data G)
    (hSg : SigmaStd D) {L S : Subgroup G} {n : ℕ} (hset : R891Set D L S n)
    (hbasic : R891Basic D L S) (hrank : R891Rank893 D L) (hLM : L ≤ D.M)
    {p : ℕ} (hp : p ∈ D.sig) :
    p ∣ Nat.card (Subgroup.normalizer (ZOf (S ⊓ L) : Set G)) := by
  obtain ⟨hpPrime, hp2⟩ := D.sig_prime p hp
  have : Fact p.Prime := ⟨hpPrime⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hns : ¬ Group.IsSolvable ↥D.M :=
    CFSG.LocalAnalysis.UniquenessCase.UC6S846.not_solvable_of_mem_calC hset.mem
  have hp3 : 3 ≠ p := by
    intro h
    exact hset.notStrong (h ▸
      CFSG.LocalAnalysis.UniquenessCase.UC6S846.sp_of_mem_sig hSg hns hp)
  have hcent1 : CFSG.Open.pRank p (CentOverO2 D.M L) = 1 := (hrank p hp).2
  have hZX : ZOf (S ⊓ L) ≤ L :=
    (inf_le_left : ZOf (S ⊓ L) ≤ S ⊓ L).trans hbasic.sylowL.le
  have hZp : IsPGroup 3 (ZOf (S ⊓ L)) := hbasic.sylowL.isPGroup.to_le inf_le_left
  have hle_cent :=
    CFSG.LocalAnalysis.UniquenessCase.PartTwo.pRank_centOverO2_le_pRank_inf_centralizer
      (X := L) (M := D.M) (R := ZOf (S ⊓ L)) hLM hbasic.normal hpPrime hp2 Nat.prime_three
      (by norm_num) hp3 hZX hZp
  have h1 : 1 ≤ CFSG.Open.pRank p (D.M ⊓ centralizer (ZOf (S ⊓ L) : Set G)) := by
    rw [hcent1] at hle_cent
    exact hle_cent
  have hp_dvd_cent : p ∣ Nat.card ↥(D.M ⊓ centralizer (ZOf (S ⊓ L) : Set G)) :=
    CFSG.GroupTheory.dvd_card_of_one_le_pRank hpPrime h1
  have hle_norm : D.M ⊓ centralizer (ZOf (S ⊓ L) : Set G) ≤
      Subgroup.normalizer (ZOf (S ⊓ L) : Set G) :=
    (inf_le_right : D.M ⊓ centralizer (ZOf (S ⊓ L) : Set G) ≤
      centralizer (ZOf (S ⊓ L) : Set G)).trans (Subgroup.centralizer_le_normalizer _)
  exact hp_dvd_cent.trans (Subgroup.card_dvd_of_le hle_norm)


private theorem k891normzle_not_centralizer {G : Type} [Group G] [Finite G] (D : Data G)
    {L S : Subgroup G} {n : ℕ} (hset : R891Set D L S n)
    (hbasic : R891Basic D L S)
    (hNotNorm : ¬ Subgroup.normalizer (ZOf (S ⊓ L) : Set G) ≤ D.M) :
    ¬ Subgroup.centralizer (ZOf (S ⊓ L) : Set G) ≤ D.M := by
  classical
  intro hCent
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hZX : ZOf (S ⊓ L) ≤ L :=
    (inf_le_left : ZOf (S ⊓ L) ≤ S ⊓ L).trans hbasic.sylowL.le
  have hZp : IsPGroup 3 (ZOf (S ⊓ L)) := hbasic.sylowL.isPGroup.to_le inf_le_left
  have hZcard : Nat.card (ZOf (S ⊓ L)) = 3 := hbasic.zOrder
  have hPsyl : CFSG.ABGLocalTools.IsSylowOf 3 (barImage L (S ⊓ L)) ⊤ := by
    obtain ⟨hPgrp, hPidx⟩ := isPGroup_barImage_of_isSylowOf Nat.prime_three hbasic.sylowL
    rw [CFSG.ABGLocalTools.isSylowOf_iff]
    exact ⟨le_top, hPgrp, by rwa [Subgroup.relIndex_top_right]⟩
  obtain ⟨z₀, hz₀Z, hz₀3, hZz₀⟩ :=
    CFSG.GroupTheory.exists_generator_of_card_prime Nat.prime_three hZcard
  have hz₀bar := k891normzle_pi_mem_zOf_barImage hbasic.sylowL.le hz₀Z
  have hz₀pow' : z₀ ^ 3 = 1 := by rw [← hz₀3]; exact pow_orderOf_eq_one z₀
  have hz₀pow : (⟨z₀, hbasic.sylowL.le hz₀Z.1⟩ : ↥L) ^ 3 = 1 :=
    Subtype.ext (by simpa using hz₀pow')
  obtain ⟨gbar, hgbar₀⟩ := r891_exists_inv_of_central_sylow hset.d4 hPsyl
    (fun p hp => Subgroup.mem_centralizer_iff.mp hz₀bar.2 p hp)
    (by rw [← map_pow, hz₀pow, map_one])
  have hgbar : ∀ z (hz : z ∈ ZOf (S ⊓ L)),
      gbar * uc22p21cPi L ⟨z, hbasic.sylowL.le hz.1⟩ * gbar⁻¹ =
        (uc22p21cPi L ⟨z, hbasic.sylowL.le hz.1⟩)⁻¹ := by
    intro z hz
    have hz' : z ∈ Subgroup.zpowers z₀ := hZz₀ ▸ hz
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hz'
    have hpk : (⟨z₀ ^ k, hbasic.sylowL.le hz.1⟩ : ↥L) = ⟨z₀, hbasic.sylowL.le hz₀Z.1⟩ ^ k :=
      Subtype.ext (by simp)
    rw [hpk, map_zpow, ← conj_zpow, hgbar₀, inv_zpow]
  obtain ⟨lL, hlL⟩ := uc22p21c_pi_surjective L gbar
  have hmap : (ZOf (S ⊓ L)).map (MulAut.conj (lL : G)).toMonoidHom ≤
      ZOf (S ⊓ L) ⊔ pCoreOf 2 L := by
    intro x hx
    obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.mp hx
    have hgz : gbar * (uc22p21cPi L ⟨z, hbasic.sylowL.le hz.1⟩) * gbar⁻¹ =
        (uc22p21cPi L ⟨z, hbasic.sylowL.le hz.1⟩)⁻¹ :=
      hgbar z hz
    have hlz : uc22p21cPi L (lL * ⟨z, hbasic.sylowL.le hz.1⟩ * lL⁻¹) =
        (uc22p21cPi L ⟨z, hbasic.sylowL.le hz.1⟩)⁻¹ := by
      rw [map_mul, map_mul, map_inv, hlL, hgz]
    have hprod : ((lL * ⟨z, hbasic.sylowL.le hz.1⟩ * lL⁻¹) *
        ⟨z, hbasic.sylowL.le hz.1⟩) ∈ CFSG.pCore 2 ↥L := by
      rw [← QuotientGroup.eq_one_iff]
      show uc22p21cPi L ((lL * ⟨z, hbasic.sylowL.le hz.1⟩ * lL⁻¹) *
        ⟨z, hbasic.sylowL.le hz.1⟩) = 1
      rw [map_mul, hlz, inv_mul_cancel]
    have h1 : (((lL * ⟨z, hbasic.sylowL.le hz.1⟩ * lL⁻¹) *
        ⟨z, hbasic.sylowL.le hz.1⟩ : ↥L) : G) ∈ pCoreOf 2 L :=
      Subgroup.mem_map.mpr ⟨_, hprod, rfl⟩
    have h2 : z⁻¹ ∈ ZOf (S ⊓ L) := (ZOf (S ⊓ L)).inv_mem hz
    have heq : (lL : G) * z * (lL : G)⁻¹ =
        (((lL * ⟨z, hbasic.sylowL.le hz.1⟩ * lL⁻¹) *
          ⟨z, hbasic.sylowL.le hz.1⟩ : ↥L) : G) * z⁻¹ := by
      simp only [Subgroup.coe_mul, Subgroup.coe_inv]
      group
    change (lL : G) * z * (lL : G)⁻¹ ∈ ZOf (S ⊓ L) ⊔ pCoreOf 2 L
    rw [heq]
    exact ((ZOf (S ⊓ L) ⊔ pCoreOf 2 L)).mul_mem
      ((le_sup_right : pCoreOf 2 L ≤ ZOf (S ⊓ L) ⊔ pCoreOf 2 L) h1)
      ((le_sup_left : ZOf (S ⊓ L) ≤ ZOf (S ⊓ L) ⊔ pCoreOf 2 L) h2)
  have hNp : IsPGroup 2 (pCoreOf 2 L) :=
    (CFSG.pCore_isPGroup (p := 2) (G := ↥L)).map L.subtype
  have hK_le_L : ZOf (S ⊓ L) ⊔ pCoreOf 2 L ≤ L :=
    sup_le hZX (CFSG.LieType.BorelTits.pCoreOf_le 2 L)
  have hdisj : Disjoint (pCoreOf 2 L) (ZOf (S ⊓ L)) :=
    (IsPGroup.disjoint_of_ne 3 2 (by norm_num) (ZOf (S ⊓ L)) (pCoreOf 2 L) hZp hNp).symm
  have hZn : ZOf (S ⊓ L) ≤ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
    hZX.trans (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 L)
  have hcardK : Nat.card ↥(ZOf (S ⊓ L) ⊔ pCoreOf 2 L) =
      Nat.card ↥(pCoreOf 2 L) * Nat.card ↥(ZOf (S ⊓ L)) := by
    rw [sup_comm]
    exact CFSG.GorensteinWalter.card_sup_eq_mul_of_disjoint_of_le_normalizer
      (pCoreOf 2 L) (ZOf (S ⊓ L)) hZn hdisj
  have hnot3N : ¬ 3 ∣ Nat.card ↥(pCoreOf 2 L) := by
    obtain ⟨m, hm⟩ := IsPGroup.iff_card.mp hNp
    rw [hm]
    intro h
    exact absurd (Nat.prime_three.dvd_of_dvd_pow h) (by norm_num)
  have hidx : (ZOf (S ⊓ L)).relIndex (ZOf (S ⊓ L) ⊔ pCoreOf 2 L) =
      Nat.card ↥(pCoreOf 2 L) := by
    have h := Subgroup.relIndex_mul_card (ZOf (S ⊓ L))
      (ZOf (S ⊓ L) ⊔ pCoreOf 2 L)
    have hinf : (ZOf (S ⊓ L)) ⊓ (ZOf (S ⊓ L) ⊔ pCoreOf 2 L) = ZOf (S ⊓ L) :=
      inf_eq_left.mpr le_sup_left
    rw [hinf, hcardK, hZcard] at h
    exact Nat.mul_right_cancel (by norm_num : 0 < 3) h
  have hSylZ : CFSG.ABGLocalTools.IsSylowOf 3 (ZOf (S ⊓ L))
      (ZOf (S ⊓ L) ⊔ pCoreOf 2 L) := by
    rw [CFSG.ABGLocalTools.isSylowOf_iff]
    exact ⟨le_sup_left, hZp, by rw [hidx]; exact hnot3N⟩
  have hcardZl : Nat.card ↥((ZOf (S ⊓ L)).map (MulAut.conj (lL : G)).toMonoidHom) = 3 := by
    rw [Subgroup.card_map_of_injective (MulAut.conj (lL : G)).injective, hZcard]
  have hidxZ : ((ZOf (S ⊓ L)).map (MulAut.conj (lL : G)).toMonoidHom).relIndex
      (ZOf (S ⊓ L) ⊔ pCoreOf 2 L) = Nat.card ↥(pCoreOf 2 L) := by
    have h := Subgroup.relIndex_mul_card
      ((ZOf (S ⊓ L)).map (MulAut.conj (lL : G)).toMonoidHom)
      (ZOf (S ⊓ L) ⊔ pCoreOf 2 L)
    have hinf : ((ZOf (S ⊓ L)).map (MulAut.conj (lL : G)).toMonoidHom) ⊓
        (ZOf (S ⊓ L) ⊔ pCoreOf 2 L) =
        ((ZOf (S ⊓ L)).map (MulAut.conj (lL : G)).toMonoidHom) :=
      inf_eq_left.mpr hmap
    rw [hinf, hcardK, hcardZl, hZcard] at h
    exact Nat.mul_right_cancel (by norm_num : 0 < 3) h
  have hSylZl : CFSG.ABGLocalTools.IsSylowOf 3
      ((ZOf (S ⊓ L)).map (MulAut.conj (lL : G)).toMonoidHom)
      (ZOf (S ⊓ L) ⊔ pCoreOf 2 L) := by
    rw [CFSG.ABGLocalTools.isSylowOf_iff]
    exact ⟨hmap, hZp.map _, by rw [hidxZ]; exact hnot3N⟩
  obtain ⟨k, hkK, hkconj⟩ :=
