            CFSG.GroupTheory.dvd_card_of_one_le_pRank Nat.prime_three hQrank
          rw [hk] at h3dvd
          exact absurd (Nat.le_of_dvd (by norm_num) h3dvd) (by norm_num)
        · rw [pow_one] at hk
          exact hNB Q (hQE.trans hESL |>.trans inf_le_right) hk
        · rw [pow_two] at hk
          exfalso
          exact hQeq (Subgroup.eq_of_le_of_card_ge hQE (by rw [hk, hEcard]; norm_num))
    have hE9contain : ∀ x ∈ S ⊓ L, orderOf x = 3 →
        ∃ E : Subgroup G, x ∈ E ∧ E ≤ S ⊓ L ∧ IsElemAbelian 3 E ∧ Nat.card E = 9 := by
      intro x hx hxord
      by_cases hxZ : x ∈ ZOf (S ⊓ L)
      · have hRex : Nat.card ↥R = 3 ^ (1 + 2 * 1) ∧ Monoid.exponent ↥R = 3 ∧
            commutator ↥R = center ↥R ∧ Nat.card (center ↥R) = 3 := by
          have h := hctx.xShape.rExtra
          unfold CFSG.LocalAnalysis.RankThreeUC.SmallClassTwoGroups.IsExtraspecialExpP at h
          exact h
        have hRcard : Nat.card ↥R = 3 ^ 3 := by
          have h : Nat.card ↥R = 3 ^ (1 + 2 * 1) := hRex.1
          norm_num at h ⊢
          exact h
        have hZR : ZOf (S ⊓ L) ≤ R := hctx.xShape.zLe
        have hZltR : ZOf (S ⊓ L) < R := by
          refine lt_of_le_of_ne hZR ?_
          intro hEq
          have hc : Nat.card (ZOf (S ⊓ L)) = Nat.card R := by rw [hEq]
          rw [hZcard, hRcard] at hc
          norm_num at hc
        obtain ⟨t, htR, htZ⟩ := Set.exists_of_ssubset hZltR
        have ht1 : t ≠ 1 := fun h => htZ (h ▸ (ZOf (S ⊓ L)).one_mem)
        have htpow : t ^ 3 = 1 := by
          have hexp : Monoid.exponent ↥R = 3 := hRex.2.1
          have h3 : Monoid.exponent ↥R ∣ 3 := by rw [hexp]
          have h := (Monoid.exponent_dvd_iff_forall_pow_eq_one (G := ↥R) (n := 3)).mp h3
            ⟨t, htR⟩
          exact congrArg Subtype.val h
        have htord : orderOf t = 3 := orderOf_eq_prime htpow ht1
        have htcomm : ∀ z ∈ ZOf (S ⊓ L), z * t = t * z := by
          intro z hz
          have hzR : z ∈ Subgroup.centralizer (R : Set G) :=
            Subgroup.centralizer_le (show (R : Set G) ⊆ ((S ⊓ L : Subgroup G) : Set G) from
              hctx.xShape.rSylow) (hZ_cent hz)
          exact (Subgroup.mem_centralizer_iff.mp hzR t htR).symm
        obtain ⟨hel, hcard⟩ :=
          CFSG.GroupTheory.isElemAbelian_sup_zpowers_of_commute (r := 3) hZcard htord htZ htcomm
        refine ⟨ZOf (S ⊓ L) ⊔ Subgroup.zpowers t, Subgroup.mem_sup_left hxZ, ?_, hel, ?_⟩
        · refine sup_le inf_le_left ?_
          exact Subgroup.zpowers_le.mpr (hctx.xShape.rSylow htR)
        · rw [hcard]
          norm_num
      · have hxpow : x ^ 3 = 1 := by
          rw [← hxord]
          exact pow_orderOf_eq_one x
        have hcomm : ∀ z ∈ ZOf (S ⊓ L), z * x = x * z := by
          intro z hz
          have hz' := (Subgroup.mem_centralizer_iff.mp (hZ_cent hz)) x hx
          exact hz'.symm
        obtain ⟨hel, hcard⟩ :=
          CFSG.GroupTheory.isElemAbelian_sup_zpowers_of_commute (r := 3) hZcard hxord hxZ hcomm
        refine ⟨ZOf (S ⊓ L) ⊔ Subgroup.zpowers x, Subgroup.mem_sup_right (Subgroup.mem_zpowers x),
          ?_, hel, ?_⟩
        · refine sup_le inf_le_left ?_
          exact Subgroup.zpowers_le.mpr hx
        · rw [hcard]
          norm_num
    exact hΓ (rankThreeGamma_le_of_forall_e9 hbasic.sylowL.isPGroup hSinfL_M hE9contain hE9
      (fun E hEM hEel hEcard hΓE =>
        h63 3 Nat.prime_three (by norm_num) E hEM hEel (by rw [hEcard]; norm_num) hΓE))
  exact ⟨hNotNorm, k891normzle_not_centralizer D hset hbasic hNotNorm⟩

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8
