    have hE9 : ∀ E : Subgroup G, E ≤ S ⊓ L → IsElemAbelian 3 E → Nat.card E = 9 →
        rankThreeGamma 1 3 E ≤ D.M := by
      intro E hESL hEel hEcard
      refine CFSG.HardMathSupport.Solomon.Proving.GLBCore_le_of_forall ?_
      intro Q hQE hQrank
      by_cases hQeq : Q = E
