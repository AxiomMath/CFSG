          have hEZ_L : E ⊔ ZOf (S ⊓ L) ≤ L :=
            sup_le (hESL.trans inf_le_right) (inf_le_left.trans hbasic.sylowL.le)
          have h3 : 3 ≤ CFSG.Open.pRank 3 (E ⊔ ZOf (S ⊓ L)) := by
