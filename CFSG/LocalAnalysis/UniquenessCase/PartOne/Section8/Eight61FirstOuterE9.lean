theorem outerFixesE9_of_exceptionalOuterCapable
    (hE9 : OuterFixedE9)
    {K : Type} [Group K] [Finite K] (hE : ExceptionalOuterCapable K)
    (hrk : CFSG.Open.pRank 3 (⊤ : Subgroup K) ≤ 3) : OuterFixesE9 K := by
  obtain ⟨d, hshape, ⟨e⟩⟩ :
      ∃ d : ValidLieTypeIndex,
        ((∃ q, d.1 = .G2 q) ∨ (∃ q, d.1 = .trialityD4 q) ∨ (∃ a, d.1 = .reeF4 a)) ∧
        Nonempty (K ≃* (CFSGIndex.lie d).Group) := by
    rcases hE with ⟨p, f, hLM⟩ | ⟨p, f, hLM⟩ | ⟨f, hLM⟩
    · obtain ⟨hadm, hm⟩ := hLM.chevalleyExceptionalModel (t := .G2) (by decide)
      have hp : p.Prime := hadm.1
      have hf : 1 ≤ f := hadm.2.1
      let q : PrimePower := ⟨p, f, hp, hf⟩
      have hq : q.card = p ^ f := PrimePower.card_def q
      obtain ⟨K', _, _, hK, ⟨e'⟩⟩ := hm
      have hv : (LieTypeIndex.G2 q).Valid := by
        refine (LieTypeIndex.valid_iff _).2 ⟨?_, ?_⟩
        · simpa [LieTypeIndex.inStandardRange_iff, hq] using hadm.2.2.2
        · simp [LieTypeIndex.isDuplicateRepresentative_iff]
      obtain ⟨b⟩ := (CFSG.TauCetiBridge.Even.chevalleyBridgesAll).g2 q hv K'
        (by rw [hK, hq])
      exact ⟨⟨.G2 q, hv⟩, Or.inl ⟨q, rfl⟩, ⟨e'.trans b⟩⟩
    · obtain ⟨hadm, hm⟩ := hLM.chevalleyExceptionalModel (t := .trialityD4) (by decide)
      have hp : p.Prime := hadm.1
      have hf : 1 ≤ f := hadm.2.1
      let q : PrimePower := ⟨p, f, hp, hf⟩
      have hq : q.card = p ^ f := PrimePower.card_def q
      obtain ⟨K', _, _, hK, σ, hσ, ⟨e'⟩⟩ := hm
      have hv : (LieTypeIndex.trialityD4 q).Valid := by simp
      obtain ⟨b⟩ := (CFSG.TauCetiBridge.Even.chevalleyBridgesAll).trialityD4 q hv K'
        (by rw [hK, hq]) σ (fun x => by rw [hq]; exact hσ x)
      exact ⟨⟨.trialityD4 q, hv⟩, Or.inr (Or.inl ⟨q, rfl⟩), ⟨e'.trans b⟩⟩
    · have hRT : ReeTitsModel K .twistedF4 2 f := (hLM.reeTitsModel (by decide)).2
      obtain ⟨hadm, a, hfa, hm⟩ := hRT
      obtain ⟨-, -, -, -, -, hf3⟩ := hadm
      have ha : 1 ≤ a := by omega
      have hv : (LieTypeIndex.reeF4 a).Valid := by
        refine (LieTypeIndex.valid_iff _).2 ⟨?_, ?_⟩
        · simpa [LieTypeIndex.inStandardRange_iff] using ha
        · simp [LieTypeIndex.isDuplicateRepresentative_iff]
      obtain ⟨K', _, _, hK, ⟨e'⟩⟩ := hm
      have : CharP K' 2 := CFSG.TauCetiBridge.charP_two_of_card_eq_two_pow hK
      have hhalf : (ReeF4LieIndex.of a hv).toSuzukiReeIndex.halfExponent = a :=
        SuzukiReeIndex.halfExponent_reeF4 a hv
      have hcard : Nat.card K' =
          2 ^ (2 * (ReeF4LieIndex.of a hv).toSuzukiReeIndex.halfExponent + 1) := by
        rw [hhalf, ← hfa]
        exact hK
      obtain ⟨e₁⟩ :=
        CFSG.TauCetiBridge.reeF4_candidate_equiv_of_card (ReeF4LieIndex.of a hv) hcard
      rw [hhalf] at e₁
      exact ⟨⟨.reeF4 a, hv⟩, Or.inr (Or.inr ⟨a, rfl⟩),
        ⟨(e'.trans (CFSG.TauCetiBridge.ReeF4.nativeModelEquiv a)).trans e₁.symm⟩⟩
  have hchar : d.1.characteristic ≠ 3 := by
    intro hd3
    have hd :=
      CFSG.LocalAnalysis.RankThreeTheoremC.KFactProofs.T29.Chev3.rank_dichotomy d hd3 e
    rcases hshape with ⟨q, hq⟩ | ⟨q, hq⟩ | ⟨a, ha⟩
    · rcases hd with h4 | ⟨q', hq'⟩ | ⟨q', hq'⟩ | ⟨q', hq'⟩
      · omega
      · exact absurd (hq.symm.trans hq'.1) (by simp)
      · exact absurd (hq.symm.trans hq'.1) (by simp)
      · exact absurd (hq.symm.trans hq'.1) (by simp)
    · rcases hd with h4 | ⟨q', hq'⟩ | ⟨q', hq'⟩ | ⟨q', hq'⟩
      · omega
      · exact absurd (hq.symm.trans hq'.1) (by simp)
      · exact absurd (hq.symm.trans hq'.1) (by simp)
      · exact absurd (hq.symm.trans hq'.1) (by simp)
    · rw [ha] at hd3
      norm_num at hd3
  have hrank : IsRankTwoIndex d.1 ∨ IsRankThreeIndex d.1 := by
    rcases hshape with ⟨q, hq⟩ | ⟨q, hq⟩ | ⟨a, ha⟩
    · exact Or.inl (by rw [hq]; simp [IsRankTwoIndex])
    · exact Or.inl (by rw [hq]; simp [IsRankTwoIndex])
    · exact Or.inl (by rw [ha]; simp [IsRankTwoIndex])
  intro α hα3 hαo
  exact hE9 d hchar hrank K ⟨e⟩ α hα3 hαo

theorem two_le_pRank_autFixedSubgroup_of_outerFixesE9 {K : Type} [Group K] [Finite K]
    (h : OuterFixesE9 K) {φ : MulAut K} (hφ3 : φ ^ 3 = 1) (hφ : φ ∉ inner K) :
    2 ≤ CFSG.Open.pRank 3 (CFSG.autFixedSubgroup φ) := by
  change φ ∉ (MulAut.conj : K →* MulAut K).range at hφ
  obtain ⟨E, hEab, hEcard, hfix⟩ := h φ hφ3 hφ
  refine CFSG.SectionRank.le_pRank (p := 3) (by norm_num) ?_ hEab (k := 2) ?_
  · intro e he
    rw [CFSG.mem_autFixedSubgroup]
    exact hfix e he
  · rw [hEcard]
    norm_num

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8
