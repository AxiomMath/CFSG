open CFSG.ComponentClassification.OuterAutomorphisms (Outer inner)

theorem not_three_dvd_card_outer_of_lieModel_psu3
    {X : Type} [Group X] [Finite X]
    (h : CFSG.Blueprint.LieModel X .PSU 3 3 1) :
    ¬ 3 ∣ Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.Outer X) := by
  obtain ⟨e⟩ := CFSG.Timmesfeld.nonempty_mulEquiv_PSU3_of_lieModel h
  rw [CFSG.SignalizerFunctorTheorem.CatalogBridge.card_outer_eq_of_mulEquiv e]
  exact not_three_dvd_card_outer_psu3

theorem not_three_dvd_card_outer_of_lieModel_psl3
    {X : Type} [Group X] [Finite X]
    (h : CFSG.Blueprint.LieModel X .PSL 3 3 1) :
    ¬ 3 ∣ Nat.card (Outer X) :=
  not_three_dvd_card_outer_of_shapeL33 h

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8
