@[expose] def GraphFieldQuotTrivial : Prop :=
  ∀ (K : Type) [Group K] [Finite K] (β : MulAut K) (P : Type) [Group P], Group.IsPerfect P →
    IsGraphFieldAut (β : K ≃* K) → β * β = 1 → ∀ ρ : P →* MulAut K, (∀ p, ρ p * β = β * ρ p) →
      ∀ (p : P) (k : K), ρ p k * k⁻¹ ∈ Subgroup.center K

