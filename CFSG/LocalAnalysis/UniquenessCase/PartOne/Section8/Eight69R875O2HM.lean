private noncomputable abbrev r5oout_phi : PSL(3, F4) ≃* projectiveSL 3 F4 :=
  CFSG.LocalAnalysis.ComponentInitial.LinearCover.projectiveSpecialLinearEquivProjectiveSL 3 F4

private noncomputable abbrev r5oout_c : MulAut (projectiveSL 3 F4) :=
  fieldAut 3 F4 (frobeniusEquiv F4 2) * dualAut 3 F4

private theorem r5oout_hk : Nat.card F4 = 4 := by
  rw [GaloisField.card 2 2 (by norm_num)]
  norm_num

private theorem r5oout_hsigma (a : F4) : frobeniusEquiv F4 2 a = a ^ 2 := by
  rw [coe_frobeniusEquiv, frobenius_def]

private theorem r5oout_phi_symm_proj (g : SL(3, F4)) :
    r5oout_phi.symm (proj 3 F4 g) = (g : PSL(3, F4)) := by
  rw [MulEquiv.symm_apply_eq]
  exact (QuotientGroup.quotientMulEquivOfEq_mk (scalars_eq_center 3 F4).symm g).symm

private theorem r5oout_congr_apply_proj (α : MulAut PSL(3, F4)) (g : SL(3, F4)) :
    MulAut.congr r5oout_phi α (proj 3 F4 g) = r5oout_phi (α (g : PSL(3, F4))) := by
  rw [MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.trans_apply, r5oout_phi_symm_proj]

private theorem r5oout_sigma_toRingHom :
    (frobeniusEquiv F4 2).toRingHom = frobenius F4 2 := by
  ext x
  rw [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, coe_frobeniusEquiv]

private theorem r5oout_congr_graphFieldPSL3 :
    MulAut.congr r5oout_phi (graphFieldPSL3 : MulAut PSL(3, F4)) = r5oout_c := by
  ext x
  obtain ⟨g, rfl⟩ := proj_surjective 3 F4 x
  rw [r5oout_congr_apply_proj]
  have h1 : (graphFieldPSL3 : MulAut PSL(3, F4)) (g : PSL(3, F4)) =
      (graphFieldSL3 g : PSL(3, F4)) := by
    change QuotientGroup.congr _ _ graphFieldSL3 _
      (QuotientGroup.mk g) = QuotientGroup.mk (graphFieldSL3 g)
    rw [QuotientGroup.congr_mk]
  rw [h1]
  have h2 : r5oout_phi (graphFieldSL3 g : PSL(3, F4)) = proj 3 F4 (graphFieldSL3 g) :=
    QuotientGroup.quotientMulEquivOfEq_mk (scalars_eq_center 3 F4).symm (graphFieldSL3 g)
  rw [h2]
  rw [MulAut.mul_apply, dualAut_proj, fieldAut_proj, r5oout_sigma_toRingHom]
  change proj 3 F4 (invTransposeSL (Fin 3) F4 (fieldSL3 g)) =
    proj 3 F4 (fieldSL3 (invTransposeSL (Fin 3) F4 g))
  rw [fieldSL3_invTranspose]

private theorem r5oout_mem_inner_iff (x : MulAut PSL(3, F4)) :
    x ∈ inner PSL(3, F4) ↔ MulAut.congr r5oout_phi x ∈ inner (projectiveSL 3 F4) := by
  rw [← CFSG.ComponentClassification.OuterAutomorphisms.inner_map_congr r5oout_phi]
  constructor
  · exact fun hx => ⟨x, hx, rfl⟩
  · rintro ⟨y, hy, hyx⟩
    rwa [show y = x from (MulAut.congr r5oout_phi).injective hyx] at hy

private theorem r5oout_c_notin : r5oout_c ∉ inner (projectiveSL 3 F4) := by
  intro hmem
  obtain ⟨-, -, ⟨e, -, hef, hed⟩, -, -, -, -⟩ :=
    CFSG.LocalAnalysis.ComponentInitial.LinearThreeFourOuter.linear_three_four_outer_quotient_rank_two_restriction
      F4 r5oout_hk (frobeniusEquiv F4 2) r5oout_hsigma
  have h1 : (r5oout_c : MulAut (projectiveSL 3 F4) ⧸ inner (projectiveSL 3 F4)) = 1 :=
    (QuotientGroup.eq_one_iff r5oout_c).2 hmem
  have h2 : e (r5oout_c : MulAut (projectiveSL 3 F4) ⧸ inner (projectiveSL 3 F4)) = 1 := by
    rw [h1]
    exact map_one e
  have h3 : e (r5oout_c : MulAut (projectiveSL 3 F4) ⧸ inner (projectiveSL 3 F4)) =
      SemidirectProduct.inr
        (Multiplicative.ofAdd (1 : ZMod 2), Multiplicative.ofAdd (1 : ZMod 2)) := by
    change e ((fieldAut 3 F4 (frobeniusEquiv F4 2) * dualAut 3 F4 :
      MulAut (projectiveSL 3 F4)) : _) = _
    rw [QuotientGroup.mk_mul, map_mul, hef, hed, ← map_mul]
    simp
  rw [h3] at h2
  have hne : SemidirectProduct.inr
      (Multiplicative.ofAdd (1 : ZMod 2), Multiplicative.ofAdd (1 : ZMod 2)) ≠
      (1 : F4ˣ ⋊[CFSG.LocalAnalysis.ComponentInitial.LinearThreeFourOuter.inversionAction F4ˣ]
        (Multiplicative (ZMod 2) × Multiplicative (ZMod 2))) := by
    intro h
    rw [← map_one SemidirectProduct.inr] at h
    have hx : (Multiplicative.ofAdd (1 : ZMod 2), Multiplicative.ofAdd (1 : ZMod 2)) = 1 :=
      SemidirectProduct.inr_injective h
    simp [Prod.ext_iff, ofAdd_eq_one] at hx
  exact hne h2

private theorem r5oout_class_central (β' : MulAut (projectiveSL 3 F4)) :
    β' * r5oout_c * β'⁻¹ * r5oout_c⁻¹ ∈ inner (projectiveSL 3 F4) := by
  obtain ⟨-, -, ⟨e, -, -, -⟩, -, -, hcenter, -⟩ :=
    CFSG.LocalAnalysis.ComponentInitial.LinearThreeFourOuter.linear_three_four_outer_quotient_rank_two_restriction
      F4 r5oout_hk (frobeniusEquiv F4 2) r5oout_hsigma
  have hmem : β' * r5oout_c * β'⁻¹ * r5oout_c⁻¹ ∈
      CFSG.LocalAnalysis.ComponentInitial.LinearThreeFourOuter.innerAutGroup (projectiveSL 3 F4) := by
    rw [← QuotientGroup.eq_one_iff (β' * r5oout_c * β'⁻¹ * r5oout_c⁻¹)]
    simp only [QuotientGroup.mk_mul, QuotientGroup.mk_inv]
    have hcomm : ↑β' * ((↑(fieldAut 3 F4 (frobeniusEquiv F4 2)) :
          MulAut (projectiveSL 3 F4) ⧸ CFSG.LocalAnalysis.ComponentInitial.LinearThreeFourOuter.innerAutGroup (projectiveSL 3 F4)) *
          ↑(dualAut 3 F4)) =
        ((↑(fieldAut 3 F4 (frobeniusEquiv F4 2)) :
          MulAut (projectiveSL 3 F4) ⧸ CFSG.LocalAnalysis.ComponentInitial.LinearThreeFourOuter.innerAutGroup (projectiveSL 3 F4)) *
          ↑(dualAut 3 F4)) * ↑β' := by
      simpa only [QuotientGroup.mk_mul] using (Subgroup.mem_center_iff.1 hcenter) (β' : _)
    rw [hcomm]
    group
  exact hmem

end R5oout


theorem r5o_graphField_outer :
    (graphFieldPSL3 : MulAut PSL(3, F4)) ∉ inner PSL(3, F4) ∧
      ∀ β : MulAut PSL(3, F4),
        β * (graphFieldPSL3 : MulAut PSL(3, F4)) * β⁻¹ * (graphFieldPSL3 : MulAut PSL(3, F4))⁻¹ ∈
          inner PSL(3, F4) := by
  refine ⟨?_, ?_⟩
  · intro hmem
    have h' := (r5oout_mem_inner_iff (graphFieldPSL3 : MulAut PSL(3, F4))).1 hmem
    rw [r5oout_congr_graphFieldPSL3] at h'
    exact r5oout_c_notin h'
  · intro β
    rw [r5oout_mem_inner_iff]
    have hmap : MulAut.congr r5oout_phi
        (β * (graphFieldPSL3 : MulAut PSL(3, F4)) * β⁻¹ *
          (graphFieldPSL3 : MulAut PSL(3, F4))⁻¹) =
        MulAut.congr r5oout_phi β * r5oout_c * (MulAut.congr r5oout_phi β)⁻¹ *
          r5oout_c⁻¹ := by
      rw [map_mul, map_mul, map_mul, map_inv, map_inv, r5oout_congr_graphFieldPSL3]
    rw [hmap]
    exact r5oout_class_central _

private noncomputable abbrev r5oqt_inner : Subgroup (MulAut PSL(3, F4)) :=
  CFSG.ComponentClassification.OuterAutomorphisms.inner PSL(3, F4)

private noncomputable def r5oqt_desc (K : Type) [Group K] :
    MulAut K →* MulAut (K ⧸ Subgroup.center K) where
  toFun φ := QuotientGroup.congr (Subgroup.center K) (Subgroup.center K) φ
    (Subgroup.map_center_eq φ)
  map_one' := by
    ext x
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
    rfl
  map_mul' φ ψ := by
    ext x
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
    rfl

private theorem r5oqt_desc_mk (K : Type) [Group K] (φ : MulAut K) (k : K) :
    r5oqt_desc K φ (QuotientGroup.mk k) = QuotientGroup.mk (φ k) :=
  rfl

private theorem r5oqt_alpha_eq (K : Type) [Group K] {β : MulAut K}
    {e : K ⧸ Subgroup.center K ≃* PSL(3, F4)} {c : PSL(3, F4)}
    (hec : ∀ k : K, e ((β k : K) : K ⧸ Subgroup.center K) =
      c * graphFieldPSL3 (e (k : K ⧸ Subgroup.center K)) * c⁻¹) :
    MulAut.congr e (r5oqt_desc K β) =
      (MulAut.conj c : MulAut PSL(3, F4)) * graphFieldPSL3 := by
  apply MulEquiv.ext
  intro x
  obtain ⟨y, rfl⟩ := e.surjective x
  obtain ⟨k, rfl⟩ := QuotientGroup.mk_surjective y
  rw [MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.trans_apply,
    MulEquiv.symm_apply_apply, r5oqt_desc_mk, hec k]
  simp [MulAut.conj_apply]

private theorem r5oqt_alpha_sq (K : Type) [Group K] {β : MulAut K}
    {e : K ⧸ Subgroup.center K ≃* PSL(3, F4)} (hββ : β * β = 1) :
    (MulAut.congr e (r5oqt_desc K β)) ^ 2 = 1 := by
  have h1 : r5oqt_desc K β * r5oqt_desc K β = 1 := by
    rw [← map_mul, hββ, map_one]
  rw [sq]
  show MulAut.congr e (r5oqt_desc K β) * MulAut.congr e (r5oqt_desc K β) = 1
  rw [← map_mul, h1, map_one]

private theorem r5oqt_alpha_not_inner {c : PSL(3, F4)} {α : MulAut PSL(3, F4)}
    (hout : (graphFieldPSL3 : MulAut PSL(3, F4)) ∉ r5oqt_inner)
    (hα : α = (MulAut.conj c : MulAut PSL(3, F4)) * graphFieldPSL3) :
    α ∉ r5oqt_inner := by
  intro hmem
  apply hout
  have hκ : (MulAut.conj c : MulAut PSL(3, F4)) ∈ r5oqt_inner := ⟨c, rfl⟩
  have h := r5oqt_inner.mul_mem (r5oqt_inner.inv_mem hκ) hmem
  rw [hα] at h
  simpa using h

private theorem r5oqt_alpha_central
    (hcentral : ∀ β : MulAut PSL(3, F4),
      β * (graphFieldPSL3 : MulAut PSL(3, F4)) * β⁻¹ * (graphFieldPSL3 : MulAut PSL(3, F4))⁻¹ ∈
        r5oqt_inner)
    {c : PSL(3, F4)} {α : MulAut PSL(3, F4)}
    (hα : α = (MulAut.conj c : MulAut PSL(3, F4)) * graphFieldPSL3) :
    ∀ β' : MulAut PSL(3, F4), β' * α * β'⁻¹ * α⁻¹ ∈ r5oqt_inner := by
  intro β'
  have hκ : (MulAut.conj c : MulAut PSL(3, F4)) ∈ r5oqt_inner := ⟨c, rfl⟩
  have h1 : β' * (MulAut.conj c : MulAut PSL(3, F4)) * β'⁻¹ ∈ r5oqt_inner :=
    (CFSG.ComponentClassification.OuterAutomorphisms.inner_normal PSL(3, F4)).conj_mem _ hκ β'
  have h2 : β' * (graphFieldPSL3 : MulAut PSL(3, F4)) * β'⁻¹ *
      (graphFieldPSL3 : MulAut PSL(3, F4))⁻¹ ∈ r5oqt_inner := hcentral β'
  have h3 : (MulAut.conj c : MulAut PSL(3, F4))⁻¹ ∈ r5oqt_inner :=
    r5oqt_inner.inv_mem hκ
  have hprod : (β' * (MulAut.conj c : MulAut PSL(3, F4)) * β'⁻¹) *
      (β' * (graphFieldPSL3 : MulAut PSL(3, F4)) * β'⁻¹ *
        (graphFieldPSL3 : MulAut PSL(3, F4))⁻¹) *
      (MulAut.conj c : MulAut PSL(3, F4))⁻¹ ∈ r5oqt_inner :=
    r5oqt_inner.mul_mem (r5oqt_inner.mul_mem h1 h2) h3
  have heq : β' * α * β'⁻¹ * α⁻¹ =
      (β' * (MulAut.conj c : MulAut PSL(3, F4)) * β'⁻¹) *
        (β' * (graphFieldPSL3 : MulAut PSL(3, F4)) * β'⁻¹ *
          (graphFieldPSL3 : MulAut PSL(3, F4))⁻¹) *
        (MulAut.conj c : MulAut PSL(3, F4))⁻¹ := by
    rw [hα]
    group
  rw [heq]
  exact hprod

private theorem r5oqt_lieModel : CFSG.Blueprint.LieModel PSL(3, F4) .PSL 3 2 2 :=
  Or.inl ⟨by decide, ⟨Nat.prime_two, by norm_num, by norm_num, by decide, by decide⟩,
    GaloisField 2 2, inferInstance, inferInstance, GaloisField.card 2 2 (by norm_num),
    ⟨CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj 3 (GaloisField 2 2)⟩⟩

theorem r5o_graphField_quotTrivial : GraphFieldQuotTrivial := by
  have hOut := r5o_graphField_outer
  intro K _ _ β P _ hperf hgf hββ ρ hρβ p k
  have : Group.IsPerfect P := hperf
  obtain ⟨hOut1, hOut2⟩ := hOut
  obtain ⟨e, c, hec⟩ := hgf
  let α : MulAut PSL(3, F4) := MulAut.congr e (r5oqt_desc K β)
  let rhoBar : P →* MulAut PSL(3, F4) :=
    ((MulAut.congr e).toMonoidHom.comp (r5oqt_desc K)).comp ρ
  have hαeq : α = (MulAut.conj c : MulAut PSL(3, F4)) * graphFieldPSL3 :=
    r5oqt_alpha_eq K hec
  have hαsq : α ^ 2 = 1 := r5oqt_alpha_sq K hββ
  have hαout : α ∉ r5oqt_inner := r5oqt_alpha_not_inner hOut1 hαeq
  have hαcen : ∀ β' : MulAut PSL(3, F4), β' * α * β'⁻¹ * α⁻¹ ∈ r5oqt_inner :=
    r5oqt_alpha_central hOut2 hαeq
  have hsol : IsSolvable ↥(Subgroup.centralizer ({α} : Set (MulAut PSL(3, F4)))) :=
    isSolvable_centralizer_of_graphField_psl_three_four r5oqt_lieModel α hαsq hαout hαcen
  have hcomm : ∀ q : P, rhoBar q * α = α * rhoBar q := by
    intro q
    have h := congrArg ((MulAut.congr e).toMonoidHom.comp (r5oqt_desc K)) (hρβ q)
    simpa only [rhoBar, α, MonoidHom.comp_apply, map_mul, MulEquiv.coe_toMonoidHom] using h
  have hle : rhoBar.range ≤ Subgroup.centralizer ({α} : Set (MulAut PSL(3, F4))) := by
    rintro x ⟨q, rfl⟩
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact hcomm q
  have : Group.IsSolvable ↥(Subgroup.centralizer ({α} : Set (MulAut PSL(3, F4)))) := hsol
  have hslv : IsSolvable ↥(rhoBar.range) :=
    Group.isSolvable_of_isSolvable_injective (f := Subgroup.inclusion hle)
      (Subgroup.inclusion_injective hle)
  have hperfρ : Group.IsPerfect ↥(rhoBar.range) := Group.IsPerfect.range rhoBar
  have : Group.IsPerfect ↥(rhoBar.range) := hperfρ
  have hsub : Subsingleton ↥(rhoBar.range) := by
    by_contra h
    have : Nontrivial ↥(rhoBar.range) := not_subsingleton_iff_nontrivial.mp h
    exact Group.IsPerfect.not_isSolvable ↥(rhoBar.range) hslv
  have hrhoBarp : rhoBar p = 1 := by
    have h := Subsingleton.elim (⟨rhoBar p, ⟨p, rfl⟩⟩ : ↥(rhoBar.range)) (1 : ↥(rhoBar.range))
    exact congrArg Subtype.val h
  have hdesc : r5oqt_desc K (ρ p) = 1 := by
    apply (MulAut.congr e).injective
    change rhoBar p = MulAut.congr e 1
    rw [hrhoBarp, map_one]
  have hmk : ((ρ p) k : K ⧸ Subgroup.center K) = (k : K ⧸ Subgroup.center K) := by
    have h := congrArg (fun f : MulAut (K ⧸ Subgroup.center K) =>
      f (QuotientGroup.mk k)) hdesc
    simpa [r5oqt_desc, QuotientGroup.congr_mk, MulAut.one_apply] using h
  rw [QuotientGroup.eq_iff_div_mem] at hmk
  simpa [div_eq_mul_inv] using hmk

private theorem r5ogfc_conjOn_mul_self {G : Type} [Group G] {K : Subgroup G} {t : G}
    (ht : orderOf t = 2) (htK : t ∈ normalizer (K : Set G)) :
    UC6.conjOn K htK * UC6.conjOn K htK = 1 := by
  ext k
  simp only [MulAut.mul_apply, MulAut.one_apply, UC6.conjOn, MulEquiv.coe_mk, Equiv.coe_fn_mk]
  have h2 : t * t = 1 := by
    have := pow_orderOf_eq_one t
    rw [ht] at this
    simpa [pow_two] using this
  have hinv : t⁻¹ = t := inv_eq_of_mul_eq_one_right h2
  rw [hinv]
  calc t * (t * ↑k * t) * t = (t * t) * ↑k * (t * t) := by group
    _ = ↑k := by rw [h2]; group

private theorem r5ogfc_conjOn_comm {G : Type} [Group G] {K : Subgroup G} {x t : G}
    (hxK : x ∈ normalizer (K : Set G)) (htK : t ∈ normalizer (K : Set G))
    (hxt : x * t = t * x) :
    UC6.conjOn K hxK * UC6.conjOn K htK = UC6.conjOn K htK * UC6.conjOn K hxK := by
  ext k
  simp only [MulAut.mul_apply, UC6.conjOn, MulEquiv.coe_mk, Equiv.coe_fn_mk]
  have h2 : t⁻¹ * x⁻¹ = x⁻¹ * t⁻¹ := by
    rw [← mul_inv_rev x t, hxt, mul_inv_rev t x]
  calc x * (t * ↑k * t⁻¹) * x⁻¹
      = (x * t) * ↑k * (t⁻¹ * x⁻¹) := by group
    _ = (t * x) * ↑k * (x⁻¹ * t⁻¹) := by rw [hxt, h2]
    _ = t * (x * ↑k * x⁻¹) * t⁻¹ := by group

private noncomputable def r5ogfc_conjHom {G : Type} [Group G] (K X : Subgroup G)
    (hXN : X ≤ normalizer (K : Set G)) : ↥X →* MulAut ↥K :=
  MonoidHom.mk' (fun x => UC6.conjOn K (hXN x.2)) (by
    intro x y
    ext k
    simp only [MulAut.mul_apply, UC6.conjOn, MulEquiv.coe_mk, Equiv.coe_fn_mk,
      Subgroup.coe_mul]
    group)

private theorem r5ogfc_commutator_le_center {G : Type} [Group G] [Finite G]
    (hQT : GraphFieldQuotTrivial) {X K : Subgroup G} {t : G}
    (hperf : ⁅X, X⁆ = X) (hXN : X ≤ normalizer (K : Set G))
    (hXt : X ≤ centralizer ({t} : Set G)) (ht : orderOf t = 2)
    (hind : UC6.InducesGraphField t K) :
    ⁅X, K⁆ ≤ (Subgroup.center ↥K).map K.subtype := by
  obtain ⟨ht', hgf⟩ := hind
  let β : MulAut ↥K := UC6.conjOn K ht'
  have hββ : β * β = 1 := r5ogfc_conjOn_mul_self ht ht'
  let ρ : ↥X →* MulAut ↥K := r5ogfc_conjHom K X hXN
  have hcomm : ∀ p : ↥X, ρ p * β = β * ρ p := by
    intro p
    have hxt : (p : G) * t = t * (p : G) :=
      Subgroup.mem_centralizer_singleton_iff.1 (hXt p.2)
    exact r5ogfc_conjOn_comm (hXN p.2) ht' hxt
  have hperf' : Group.IsPerfect ↥X := Subgroup.isPerfect_iff.mpr hperf
  have hcenter := hQT ↥K β ↥X hperf' hgf hββ ρ hcomm
  rw [Subgroup.commutator_le]
  intro x hx k hk
  have hmem := hcenter ⟨x, hx⟩ ⟨k, hk⟩
  rw [Subgroup.mem_map]
  refine ⟨ρ ⟨x, hx⟩ ⟨k, hk⟩ * ⟨k, hk⟩⁻¹, hmem, ?_⟩
  simp only [Subgroup.subtype_apply, map_mul, map_inv, ρ, r5ogfc_conjHom,
    MonoidHom.mk'_apply, UC6.conjOn, MulEquiv.coe_mk, Equiv.coe_fn_mk, commutatorElement_def]

private theorem r5ogfc_psl_case {G : Type} [Group G] {X K : Subgroup G}
    (hcomm : ⁅X, K⁆ ≤ (Subgroup.center ↥K).map K.subtype)
    (e : ↥K ≃* PSL(3, F4)) :
    X ≤ centralizer (K : Set G) := by
  have hk : Nat.card F4 = 4 := by
    rw [GaloisField.card 2 2 (by norm_num)]
    norm_num
  let e' : ↥K ≃* CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL 3 F4 :=
    e.trans (CFSG.LocalAnalysis.ComponentInitial.LinearCover.projectiveSpecialLinearEquivProjectiveSL 3 F4)
  have hmap : (Subgroup.center ↥K).map
      (e' : ↥K →* CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL 3 F4) = ⊥ := by
    rw [Subgroup.map_center_eq e',
      CFSG.LocalAnalysis.ComponentInitial.LinearThreeFourOuter.center_projectiveSL_three_eq_bot hk]
  have hcenter : Subgroup.center ↥K = ⊥ := by
    rw [eq_bot_iff]
    intro z hz
    rw [Subgroup.mem_bot]
    have hz1 : e' z = 1 := by
      simpa using (Subgroup.map_eq_bot_iff (Subgroup.center ↥K)).mp hmap hz
    exact e'.injective (by rw [hz1, map_one])
  have hcomm' : ⁅X, K⁆ = ⊥ := by
    rw [hcenter] at hcomm
    exact le_bot_iff.mp (by simpa using hcomm)
  exact Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcomm'

private theorem r5ogfc_sl_case {G : Type} [Group G] {X K : Subgroup G}
    (hcomm : ⁅X, K⁆ ≤ (Subgroup.center ↥K).map K.subtype)
    (e : ↥K ≃* SL(3, F4)) :
    X ≤ centralizer (K : Set G) := by
  have hperfSL : Group.IsPerfect (SL(3, F4)) :=
    CFSG.LinearGroups.special_linear_dimension_at_least_three_perfect (K := F4) (by norm_num)
  have hperfK : Group.IsPerfect ↥K :=
    Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  have hKX : ⁅K, X⁆ ≤ (Subgroup.center ↥K).map K.subtype := by
    rw [Subgroup.commutator_comm]
    exact hcomm
  have hZc : (Subgroup.center ↥K).map K.subtype ≤ centralizer (K : Set G) := by
    intro z hz
    rw [Subgroup.mem_map] at hz
    obtain ⟨z', hz', rfl⟩ := hz
    rw [Subgroup.mem_centralizer_iff]
    intro k hk
    exact congrArg Subtype.val (Subgroup.mem_center_iff.mp hz' ⟨k, hk⟩)
  have hdouble : ⁅⁅K, X⁆, K⁆ = ⊥ :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mpr (hKX.trans hZc)
  have hKXbot : ⁅K, X⁆ = ⊥ := CFSG.LocalCores.perfect_double_commutator hperfK hdouble
  have hXKbot : ⁅X, K⁆ = ⊥ := by rw [Subgroup.commutator_comm]; exact hKXbot
  exact Subgroup.commutator_eq_bot_iff_le_centralizer.mp hXKbot

theorem r5o_graphField_commute (hQT : GraphFieldQuotTrivial) {G : Type} [Group G] [Finite G]
    {X K : Subgroup G} {t : G}
    (hK : Nonempty (↥K ≃* PSL(3, F4)) ∨ Nonempty (↥K ≃* SL(3, F4)))
    (hind : UC6.InducesGraphField t K) (ht : orderOf t = 2) (hperf : ⁅X, X⁆ = X)
    (hXN : X ≤ normalizer (K : Set G)) (hXt : X ≤ centralizer ({t} : Set G)) :
    X ≤ centralizer (K : Set G) := by
  have hcomm := r5ogfc_commutator_le_center hQT hperf hXN hXt ht hind
  rcases hK with hK | hK
  · obtain ⟨e⟩ := hK
    exact r5ogfc_psl_case hcomm e
  · obtain ⟨e⟩ := hK
    exact r5ogfc_sl_case hcomm e

private theorem r5oprd_sl34_quasisimple : CFSG.IsQuasisimple (SL(3, F4)) :=
  CFSG.ComponentClassification.CatalogueBGeneralLinear.specialLinear_quasisimple 3 F4
    (by norm_num) (Or.inl (by norm_num)) (Or.inl (by norm_num))

private theorem r5oprd_isQuasisimple_of_sl {G : Type} [Group G] {K : Subgroup G}
    (hK : Nonempty (↥K ≃* SL(3, F4))) : CFSG.IsQuasisimple ↥K := by
  obtain ⟨e⟩ := hK
  exact CFSG.IsQuasisimple.of_mulEquiv e r5oprd_sl34_quasisimple

private theorem r5oprd_card_eq {G : Type} [Group G] {K : Subgroup G}
    (hK : Nonempty (↥K ≃* SL(3, F4))) : Nat.card K = Nat.card (SL(3, F4)) := by
  obtain ⟨e⟩ := hK
  exact Nat.card_congr e.toEquiv

private theorem r5oprd_conj_image_mem {G : Type} [Group G] {K₁ L : Subgroup G} {x a k : G}
    (hL : L ≤ Subgroup.normalizer (K₁ : Set G))
    (hxL : x ∈ Subgroup.normalizer (L : Set G))
    (ha : a ∈ L) (hk : k ∈ K₁.map (MulAut.conj x).toMonoidHom) :
    a * k * a⁻¹ ∈ K₁.map (MulAut.conj x).toMonoidHom := by
  obtain ⟨k₁, hk₁, hfk⟩ := Subgroup.mem_map.1 hk
  have hz : x⁻¹ * a * x ∈ L := (Subgroup.mem_normalizer_iff''.1 hxL a).mp ha
  have hzk : (x⁻¹ * a * x) * k₁ * (x⁻¹ * a * x)⁻¹ ∈ K₁ :=
    (Subgroup.le_normalizer_iff.1 hL) _ hz k₁ hk₁
  have hmem : (MulAut.conj x).toMonoidHom
        ((x⁻¹ * a * x) * k₁ * (x⁻¹ * a * x)⁻¹) ∈
      K₁.map (MulAut.conj x).toMonoidHom :=
    Subgroup.mem_map_of_mem _ hzk
  have hconj : (MulAut.conj x).toMonoidHom
        ((x⁻¹ * a * x) * k₁ * (x⁻¹ * a * x)⁻¹) =
      a * (MulAut.conj x).toMonoidHom k₁ * a⁻¹ := by
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    group
  rw [hconj, hfk] at hmem
  exact hmem

private theorem r5oprd_center_map_le_centralizer {G : Type} [Group G] (K : Subgroup G) :
    (Subgroup.center ↥K).map K.subtype ≤ Subgroup.centralizer (K : Set G) := by
  intro z hz
  obtain ⟨c, hc, rfl⟩ := Subgroup.mem_map.1 hz
  rw [Subgroup.mem_centralizer_iff]
  intro y hy
  exact congrArg Subtype.val (Subgroup.mem_center_iff.1 hc ⟨y, hy⟩)

private theorem r5oprd_inf_le_center_map {G : Type} [Group G] {K K₁ : Subgroup G}
    (h : K.subgroupOf K₁ ≤ Subgroup.center ↥K₁) :
    K ⊓ K₁ ≤ (Subgroup.center ↥K₁).map K₁.subtype := by
  intro y hy
  exact ⟨⟨y, hy.2⟩, h hy.1, rfl⟩

private theorem r5oprd_centralizer_sup {G : Type} [Group G] (H K : Subgroup G) :
    Subgroup.centralizer ((H ⊔ K : Subgroup G) : Set G) =
      Subgroup.centralizer (H : Set G) ⊓ Subgroup.centralizer (K : Set G) := by
  rw [Subgroup.sup_eq_closure, Subgroup.centralizer_closure]
  ext x
  rw [Subgroup.mem_inf, Subgroup.mem_centralizer_iff, Subgroup.mem_centralizer_iff,
    Subgroup.mem_centralizer_iff]
  constructor
  · intro h
    exact ⟨fun a ha => h a (Or.inl ha), fun b hb => h b (Or.inr hb)⟩
  · rintro ⟨h₁, h₂⟩ a (ha | ha)
    · exact h₁ a ha
    · exact h₂ a ha

private theorem r5oprd_conj_mem_of_eq {G : Type} [Group G] {K₁ K₂ : Subgroup G} {x y : G}
    (hx : K₁.map (MulAut.conj x).toMonoidHom = K₂)
    (hy : K₁.map (MulAut.conj y).toMonoidHom = K₂) :
    y⁻¹ * x ∈ Subgroup.normalizer (K₁ : Set G) := by
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  change K₁.map (MulAut.conj (y⁻¹ * x)).toMonoidHom = K₁
  have hcomp : K₁.map (MulAut.conj (y⁻¹ * x)).toMonoidHom =
      (K₁.map (MulAut.conj x).toMonoidHom).map (MulAut.conj y⁻¹).toMonoidHom := by
    rw [Subgroup.map_map]
    have h : (MulAut.conj (y⁻¹ * x)).toMonoidHom =
        (MulAut.conj y⁻¹).toMonoidHom.comp (MulAut.conj x).toMonoidHom := by
      ext z
      simp [MulAut.conj_apply, mul_assoc]
    rw [h]
  rw [hcomp, hx]
  have hcancel : (K₂.map (MulAut.conj y⁻¹).toMonoidHom) = K₁ := by
    have h1 : (K₁.map (MulAut.conj y).toMonoidHom).map (MulAut.conj y⁻¹).toMonoidHom = K₁ := by
      rw [Subgroup.map_map]
      have h : (MulAut.conj y⁻¹).toMonoidHom.comp (MulAut.conj y).toMonoidHom =
          MonoidHom.id G := by
        ext z
        simp [MulAut.conj_apply, mul_assoc]
      rw [h, Subgroup.map_id]
    rwa [hy] at h1
  exact hcancel

private theorem r5oprd_le_normalizer_map_conj {G : Type} [Group G] {K₁ L : Subgroup G} {x : G}
    (hL : L ≤ Subgroup.normalizer (K₁ : Set G))
    (hxL : x ∈ Subgroup.normalizer (L : Set G)) :
    L ≤ Subgroup.normalizer (K₁.map (MulAut.conj x).toMonoidHom : Subgroup G) := by
  rw [Subgroup.le_normalizer_iff]
  intro a ha k hk
  exact r5oprd_conj_image_mem hL hxL ha hk

private theorem r5oprd_central_contra {G : Type} [Group G] [Finite G]
    {K K₁ K₂ L : Subgroup G}
    (hcomm : ∀ a ∈ K₁, ∀ b ∈ K₂, a * b = b * a) (hLdef : L = K₁ ⊔ K₂)
    (hKL : K ≤ L) (hKN₁ : K ≤ Subgroup.normalizer (K₁ : Set G))
    (hKN₂ : K ≤ Subgroup.normalizer (K₂ : Set G))
    (hK₁N : K₁ ≤ Subgroup.normalizer (K : Set G))
    (hK₂N : K₂ ≤ Subgroup.normalizer (K : Set G))
    (hqsK : CFSG.IsQuasisimple ↥K)
    (hc₁ : K.subgroupOf K₁ ≤ Subgroup.center ↥K₁)
    (hc₂ : K.subgroupOf K₂ ≤ Subgroup.center ↥K₂) : False := by
  have hK₂c : K₂ ≤ Subgroup.centralizer (K₁ : Set G) := by
    intro b hb
    rw [Subgroup.mem_centralizer_iff]
    intro a ha
    exact hcomm a ha b hb
  have hK₁c : K₁ ≤ Subgroup.centralizer (K₂ : Set G) := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    exact (hcomm a ha b hb).symm
  have hKZ₁ : K ⊓ K₁ ≤ (Subgroup.center ↥K₁).map K₁.subtype :=
    r5oprd_inf_le_center_map hc₁
  have hKZ₂ : K ⊓ K₂ ≤ (Subgroup.center ↥K₂).map K₂.subtype :=
    r5oprd_inf_le_center_map hc₂
  have hcm₁K : ⁅K, K₁⁆ ≤ K := by
    rw [Subgroup.commutator_comm]
    exact Subgroup.le_normalizer_iff_commutator_le_right.mp hK₁N
  have hcm₁K₁ : ⁅K, K₁⁆ ≤ K₁ :=
    Subgroup.le_normalizer_iff_commutator_le_right.mp hKN₁
  have hcm₁ : ⁅K, K₁⁆ ≤ (Subgroup.center ↥K₁).map K₁.subtype :=
    (le_inf hcm₁K hcm₁K₁).trans hKZ₁
  have hcm₂K : ⁅K, K₂⁆ ≤ K := by
    rw [Subgroup.commutator_comm]
    exact Subgroup.le_normalizer_iff_commutator_le_right.mp hK₂N
  have hcm₂K₂ : ⁅K, K₂⁆ ≤ K₂ :=
    Subgroup.le_normalizer_iff_commutator_le_right.mp hKN₂
  have hcm₂ : ⁅K, K₂⁆ ≤ (Subgroup.center ↥K₂).map K₂.subtype :=
    (le_inf hcm₂K hcm₂K₂).trans hKZ₂
  have hZ₁K₁ : (Subgroup.center ↥K₁).map K₁.subtype ≤ K₁ := by
    rintro z ⟨c, hc, rfl⟩
    exact c.2
  have hZ₁L : (Subgroup.center ↥K₁).map K₁.subtype ≤ Subgroup.centralizer (L : Set G) := by
    rw [hLdef, r5oprd_centralizer_sup]
    exact le_inf (r5oprd_center_map_le_centralizer K₁) (hZ₁K₁.trans hK₁c)
  have hZ₂K₂ : (Subgroup.center ↥K₂).map K₂.subtype ≤ K₂ := by
    rintro z ⟨c, hc, rfl⟩
    exact c.2
  have hZ₂L : (Subgroup.center ↥K₂).map K₂.subtype ≤ Subgroup.centralizer (L : Set G) := by
    rw [hLdef, r5oprd_centralizer_sup]
    exact le_inf (hZ₂K₂.trans hK₂c) (r5oprd_center_map_le_centralizer K₂)
  have hcm₁_bot : ⁅⁅K, K₁⁆, K⁆ = ⊥ := by
    apply le_bot_iff.mp
    calc ⁅⁅K, K₁⁆, K⁆ ≤ ⁅(Subgroup.center ↥K₁).map K₁.subtype, K⁆ :=
          Subgroup.commutator_mono_left hcm₁
      _ = ⊥ := by
          rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
          exact hZ₁L.trans
            (Subgroup.centralizer_le (show (K : Set G) ⊆ (L : Set G) from hKL))
  have hcm₂_bot : ⁅⁅K, K₂⁆, K⁆ = ⊥ := by
    apply le_bot_iff.mp
    calc ⁅⁅K, K₂⁆, K⁆ ≤ ⁅(Subgroup.center ↥K₂).map K₂.subtype, K⁆ :=
          Subgroup.commutator_mono_left hcm₂
      _ = ⊥ := by
          rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
          exact hZ₂L.trans
            (Subgroup.centralizer_le (show (K : Set G) ⊆ (L : Set G) from hKL))
  have hcm₁' : ⁅K, K₁⁆ = ⊥ :=
    CFSG.LocalCores.perfect_double_commutator hqsK.1 hcm₁_bot
  have hcm₂' : ⁅K, K₂⁆ = ⊥ :=
    CFSG.LocalCores.perfect_double_commutator hqsK.1 hcm₂_bot
  have hKcent₁ : K ≤ Subgroup.centralizer (K₁ : Set G) :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcm₁'
  have hKcent₂ : K ≤ Subgroup.centralizer (K₂ : Set G) :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcm₂'
  have hKLcent : K ≤ Subgroup.centralizer (L : Set G) := by
    rw [hLdef, r5oprd_centralizer_sup]
    exact le_inf hKcent₁ hKcent₂
  have hKcent : K ≤ Subgroup.centralizer (K : Set G) :=
    hKLcent.trans (Subgroup.centralizer_le (show (K : Set G) ⊆ (L : Set G) from hKL))
  have hKperf : Group.IsPerfect ↥K := hqsK.1
  have hKntriv : Nontrivial ↥K := CFSG.LocalCores.isQuasisimple_nontrivial hqsK
  exact absurd (Subgroup.le_centralizer_iff_isMulCommutative.mp hKcent)
    (Group.IsPerfect.not_isMulCommutative ↥K)

private theorem r5oprd_map_conj_eq {G : Type} [Group G] [Finite G] {X K₁ K₂ : Subgroup G}
    (hcomm : ∀ a ∈ K₁, ∀ b ∈ K₂, a * b = b * a) (h₁ : Nonempty (↥K₁ ≃* SL(3, F4)))
    (h₂ : Nonempty (↥K₂ ≃* SL(3, F4)))
    (hXN : X ≤ Subgroup.normalizer ((K₁ ⊔ K₂ : Subgroup G) : Set G)) (x : ↥X) :
    K₁.map (MulAut.conj (x : G)).toMonoidHom = K₁ ∨
      K₁.map (MulAut.conj (x : G)).toMonoidHom = K₂ := by
  have hqs₁ : CFSG.IsQuasisimple ↥K₁ := r5oprd_isQuasisimple_of_sl h₁
  have hqs₂ : CFSG.IsQuasisimple ↥K₂ := r5oprd_isQuasisimple_of_sl h₂
  have hq₁ : CFSG.Open.IsQuasisimple ↥K₁ :=
    CFSG.ComponentClassification.CatalogueBAlternating.quasisimple_iff_native.mp hqs₁
  have hq₂ : CFSG.Open.IsQuasisimple ↥K₂ :=
    CFSG.ComponentClassification.CatalogueBAlternating.quasisimple_iff_native.mp hqs₂
  have hcard₁ : Nat.card K₁ = Nat.card (SL(3, F4)) := r5oprd_card_eq h₁
  have hcard₂ : Nat.card K₂ = Nat.card (SL(3, F4)) := r5oprd_card_eq h₂
  set L : Subgroup G := K₁ ⊔ K₂ with hLdef
  have hK₂c : K₂ ≤ Subgroup.centralizer (K₁ : Set G) := by
    intro b hb
    rw [Subgroup.mem_centralizer_iff]
    intro a ha
    exact hcomm a ha b hb
  have hK₁c : K₁ ≤ Subgroup.centralizer (K₂ : Set G) := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    exact (hcomm a ha b hb).symm
  have hL₁ : L ≤ Subgroup.normalizer (K₁ : Set G) := by
    rw [hLdef]
    exact sup_le (Subgroup.le_normalizer)
      (hK₂c.trans (Subgroup.centralizer_le_normalizer (K₁ : Set G)))
  have hL₂ : L ≤ Subgroup.normalizer (K₂ : Set G) := by
    rw [hLdef]
    exact sup_le (hK₁c.trans (Subgroup.centralizer_le_normalizer (K₂ : Set G)))
      (Subgroup.le_normalizer)
  have hxL : (x : G) ∈ Subgroup.normalizer (L : Set G) := hXN x.2
  set K : Subgroup G := K₁.map (MulAut.conj (x : G)).toMonoidHom with hKdef
  have hKL : K ≤ L := by
    rw [hKdef]
    calc K₁.map (MulAut.conj (x : G)).toMonoidHom
        ≤ L.map (MulAut.conj (x : G)).toMonoidHom := Subgroup.map_mono le_sup_left
      _ = L := Subgroup.mem_normalizer_iff_map_conj_eq.1 hxL
  have hLK : L ≤ Subgroup.normalizer (K : Set G) := by
    rw [hKdef]
    exact r5oprd_le_normalizer_map_conj hL₁ hxL
  have hKN₁ : K ≤ Subgroup.normalizer (K₁ : Set G) := hKL.trans hL₁
  have hKN₂ : K ≤ Subgroup.normalizer (K₂ : Set G) := hKL.trans hL₂
  have hK₁N : K₁ ≤ Subgroup.normalizer (K : Set G) :=
    (show K₁ ≤ L from le_sup_left).trans hLK
  have hK₂N : K₂ ≤ Subgroup.normalizer (K : Set G) :=
    (show K₂ ≤ L from le_sup_right).trans hLK
  have hnorm₁ : (K.subgroupOf K₁).Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer hK₁N
  have hnorm₂ : (K.subgroupOf K₂).Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer hK₂N
  have hqsK : CFSG.IsQuasisimple ↥K :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv
      (K₁.equivMapOfInjective (MulAut.conj (x : G)).toMonoidHom
        (MulAut.conj (x : G)).injective) hqs₁
  have hcardK₁ : Nat.card K = Nat.card K₁ := by
    rw [hKdef]
    exact (Nat.card_congr (K₁.equivMapOfInjective (MulAut.conj (x : G)).toMonoidHom
      (MulAut.conj (x : G)).injective).toEquiv).symm
  have hcardK₂ : Nat.card K = Nat.card K₂ := by
    rw [hcardK₁, hcard₁, hcard₂]
  have hcent : (K.subgroupOf K₁ ≤ Subgroup.center ↥K₁) ∨ (K.subgroupOf K₁ = ⊤) :=
    CFSG.ComponentClassification.Quasisimple.normal_le_center_or_eq_top hq₁ (K.subgroupOf K₁)
  have hcent' : (K.subgroupOf K₂ ≤ Subgroup.center ↥K₂) ∨ (K.subgroupOf K₂ = ⊤) :=
    CFSG.ComponentClassification.Quasisimple.normal_le_center_or_eq_top hq₂ (K.subgroupOf K₂)
  rcases hcent with hc₁ | ht₁
  · rcases hcent' with hc₂ | ht₂
    · exfalso
      exact r5oprd_central_contra hcomm hLdef hKL hKN₁ hKN₂ hK₁N hK₂N hqsK hc₁ hc₂
    · right
      have hle : K₂ ≤ K := Subgroup.subgroupOf_eq_top.mp ht₂
      exact (Subgroup.eq_of_le_of_card_ge hle (le_of_eq hcardK₂)).symm
  · left
    have hle : K₁ ≤ K := Subgroup.subgroupOf_eq_top.mp ht₁
    exact (Subgroup.eq_of_le_of_card_ge hle (le_of_eq hcardK₁)).symm

private theorem r5oprd_index_arg {G : Type} [Group G] [Finite G] {X K₁ K₂ : Subgroup G}
    (hstep : ∀ x : ↥X, K₁.map (MulAut.conj (x : G)).toMonoidHom = K₁ ∨
      K₁.map (MulAut.conj (x : G)).toMonoidHom = K₂) (hperf : ⁅X, X⁆ = X) :
    X ≤ Subgroup.normalizer (K₁ : Set G) := by
  let S : Subgroup ↥X := (Subgroup.normalizer (K₁ : Set G)).subgroupOf X
  have hS_top : S = ⊤ := by
    by_contra hSne
    obtain ⟨a, haS⟩ : ∃ a : ↥X, a ∉ S := by
      by_contra h
      push Not at h
      exact hSne ((Subgroup.eq_top_iff' S).mpr h)
    have haN : (a : G) ∉ Subgroup.normalizer (K₁ : Set G) :=
      fun h => haS ((Subgroup.mem_subgroupOf).mpr h)
    have haK : K₁.map (MulAut.conj (a : G)).toMonoidHom = K₂ := by
      rcases hstep a with h | h
      · exact absurd (Subgroup.mem_normalizer_iff_map_conj_eq.mpr h) haN
      · exact h
    have hxor : ∀ b : ↥X, Xor (b * a ∈ S) (b ∈ S) := by
      intro b
      by_cases hb : b ∈ S
      · refine Or.inr ⟨hb, fun hba => haS ?_⟩
        have : a = b⁻¹ * (b * a) := by group
        rw [this]
        exact S.mul_mem (S.inv_mem hb) hba
      · refine Or.inl ⟨?_, hb⟩
        have hbN : (b : G) ∉ Subgroup.normalizer (K₁ : Set G) :=
          fun h => hb ((Subgroup.mem_subgroupOf).mpr h)
        have hb'invS : (b⁻¹ : ↥X) ∉ S := fun h => hb (by
          have := S.inv_mem h
          simpa using this)
        have hbinvK : K₁.map (MulAut.conj (((b⁻¹ : ↥X) : G))).toMonoidHom = K₂ := by
          rcases hstep (b⁻¹) with h | h
          · exact absurd (Subgroup.mem_normalizer_iff_map_conj_eq.mpr h) hb'invS
          · exact h
        have hmem : ((b⁻¹ : ↥X) : G)⁻¹ * (a : G) ∈ Subgroup.normalizer (K₁ : Set G) :=
          r5oprd_conj_mem_of_eq haK hbinvK
        apply (Subgroup.mem_subgroupOf).mpr
        simpa using hmem
    have hIndex : S.index = 2 := Subgroup.index_eq_two_iff.mpr ⟨a, hxor⟩
    have hSnorm : S.Normal := Subgroup.normal_of_index_eq_two hIndex
    have hcardq : Nat.card (↥X ⧸ S) = 2 := hIndex
    have hScyc : IsCyclic (↥X ⧸ S) := isCyclic_of_prime_card (p := 2) hcardq
    have hcommS : commutator ↥X ≤ S := by
      have := Abelianization.commutator_subset_ker (QuotientGroup.mk' S)
      rwa [QuotientGroup.ker_mk'] at this
    have htop : commutator ↥X = ⊤ :=
      Group.isPerfect_def.mp (Subgroup.isPerfect_iff.mpr hperf)
    exact hSne (top_le_iff.mp (htop ▸ hcommS))
  intro x hx
  have : (⟨x, hx⟩ : ↥X) ∈ S := by rw [hS_top]; exact Subgroup.mem_top _
  exact (Subgroup.mem_subgroupOf).mp this

private theorem r5oprd_normalizes_left {G : Type} [Group G] [Finite G] {X K₁ K₂ : Subgroup G}
    (hcomm : ∀ a ∈ K₁, ∀ b ∈ K₂, a * b = b * a) (h₁ : Nonempty (↥K₁ ≃* SL(3, F4)))
    (h₂ : Nonempty (↥K₂ ≃* SL(3, F4))) (hperf : ⁅X, X⁆ = X)
    (hXN : X ≤ Subgroup.normalizer ((K₁ ⊔ K₂ : Subgroup G) : Set G)) :
    X ≤ Subgroup.normalizer (K₁ : Set G) :=
  r5oprd_index_arg (fun x => r5oprd_map_conj_eq hcomm h₁ h₂ hXN x) hperf

theorem r5o_prod_normalizes {G : Type} [Group G] [Finite G] {X K₁ K₂ : Subgroup G}
    (hcomm : ∀ a ∈ K₁, ∀ b ∈ K₂, a * b = b * a) (h₁ : Nonempty (↥K₁ ≃* SL(3, F4)))
    (h₂ : Nonempty (↥K₂ ≃* SL(3, F4))) (hperf : ⁅X, X⁆ = X)
    (hXN : X ≤ normalizer ((K₁ ⊔ K₂ : Subgroup G) : Set G)) :
    X ≤ normalizer (K₁ : Set G) ∧ X ≤ normalizer (K₂ : Set G) := by
  refine ⟨r5oprd_normalizes_left hcomm h₁ h₂ hperf hXN, ?_⟩
  exact r5oprd_normalizes_left (fun a ha b hb => (hcomm b hb a ha).symm) h₂ h₁ hperf (by
    simpa [sup_comm] using hXN)

private theorem r5op9_twoGroup_case {G : Type} [Group G] [Finite G] (X : Subgroup G)
    (hperf : ⁅X, X⁆ = X) (φ : ↥X →* Equiv.Perm (Fin 9))
    (htop : φ.ker.map (QuotientGroup.mk' (CFSG.pCore 2 ↥X)) = ⊤) : φ = 1 := by
  have hsup : φ.ker ⊔ CFSG.pCore 2 ↥X = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : QuotientGroup.mk' (CFSG.pCore 2 ↥X) x ∈
        φ.ker.map (QuotientGroup.mk' (CFSG.pCore 2 ↥X)) := by
      rw [htop]; exact Subgroup.mem_top _
    obtain ⟨k, hk, hkπ⟩ := Subgroup.mem_map.mp hx
    have hmem : k⁻¹ * x ∈ (QuotientGroup.mk' (CFSG.pCore 2 ↥X)).ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hkπ, inv_mul_cancel]
    rw [QuotientGroup.ker_mk'] at hmem
    have hx' : x = k * (k⁻¹ * x) := by group
    rw [hx']
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hk) (Subgroup.mem_sup_right hmem)
  have hrange : φ.range = (CFSG.pCore 2 ↥X).map φ := by
    rw [MonoidHom.range_eq_map, ← hsup, Subgroup.map_sup, Subgroup.map_ker_self, bot_sup_eq]
  have h2 : IsPGroup 2 φ.range := by
    rw [hrange]
    exact IsPGroup.map (CFSG.pCore_isPGroup (p := 2) (G := ↥X)) φ
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hnil : Group.IsNilpotent φ.range := IsPGroup.isNilpotent h2
  have : Group.IsPerfect ↥X := Subgroup.isPerfect_iff.mpr hperf
  have : Group.IsPerfect φ.range := Group.IsPerfect.range φ
  have hsub : Subsingleton φ.range := by
    by_contra h
    have : Nontrivial φ.range := not_subsingleton_iff_nontrivial.mp h
    exact Group.IsPerfect.not_isNilpotent φ.range hnil
  have hbot : φ.range = ⊥ := by
    rw [Subgroup.eq_bot_iff_forall]
    intro x hx
    exact congrArg Subtype.val (Subsingleton.elim (⟨x, hx⟩ : φ.range) 1)
  exact MonoidHom.range_eq_bot_iff.mp hbot

private theorem r5op9_center_case {G : Type} [Group G] [Finite G] (X : Subgroup G)
    (hbar : IsSL3 (Bar2 X) 2 ∨ IsSU3 (Bar2 X) 3)
    (φ : ↥X →* Equiv.Perm (Fin 9))
    (hle : φ.ker.map (QuotientGroup.mk' (CFSG.pCore 2 ↥X)) ≤ Subgroup.center (Bar2 X)) :
    φ = 1 := by
  let Q := Bar2 X
  let π : ↥X →* Q := QuotientGroup.mk' (CFSG.pCore 2 ↥X)
  have hπ : Function.Surjective π := QuotientGroup.mk'_surjective _
  let ψ : ↥X →* φ.range := φ.rangeRestrict
  have hψ : Function.Surjective ψ := MonoidHom.rangeRestrict_surjective φ
  let K : Subgroup ↥X := ψ.ker
  have hK_eq : K = φ.ker := MonoidHom.ker_rangeRestrict φ
  let Z : Subgroup ↥X := (Subgroup.center Q).comap π
  have hKZ : K ≤ Z := by
    intro x hx
    rw [Subgroup.mem_comap]
    exact hle (Subgroup.mem_map_of_mem π (hK_eq ▸ hx))
  let e : ↥X ⧸ K ≃* φ.range := QuotientGroup.quotientKerEquivOfSurjective ψ hψ
  have hcomp : (e : ↥X ⧸ K →* φ.range).comp (QuotientGroup.mk' K) = ψ := by
    apply MonoidHom.ext
    intro x
    change (QuotientGroup.kerLift ψ) (x : ↥X ⧸ K) = ψ x
    rw [QuotientGroup.kerLift_mk]
  let N : Subgroup φ.range := Z.map ψ
  have hN : N.Normal := Subgroup.Normal.map inferInstance ψ hψ
  have hZmap : (Z.map (QuotientGroup.mk' K)).Normal :=
    Subgroup.Normal.map inferInstance (QuotientGroup.mk' K) (QuotientGroup.mk'_surjective K)
  have he : (Z.map (QuotientGroup.mk' K)).map (e : ↥X ⧸ K →* φ.range) = N := by
    dsimp only [N]
    rw [Subgroup.map_map, hcomp]
  have hgker : ((QuotientGroup.mk' (Subgroup.center Q)).comp π).ker = Z := by
    rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk']
  have hsurj : Function.Surjective ((QuotientGroup.mk' (Subgroup.center Q)).comp π) := by
    intro x
    obtain ⟨y, hy⟩ := QuotientGroup.mk'_surjective (Subgroup.center Q) x
    obtain ⟨z, hz⟩ := hπ y
    exact ⟨z, by rw [MonoidHom.comp_apply, hz, hy]⟩
  let isoQ : ↥X ⧸ Z ≃* Q ⧸ Subgroup.center Q :=
    (QuotientGroup.quotientMulEquivOfEq hgker).symm.trans
      (QuotientGroup.quotientKerEquivOfSurjective
        ((QuotientGroup.mk' (Subgroup.center Q)).comp π) hsurj)
  let iso : φ.range ⧸ N ≃* Q ⧸ Subgroup.center Q :=
    (QuotientGroup.congr (Z.map (QuotientGroup.mk' K)) N (e : ↥X ⧸ K ≃* φ.range) he).symm.trans
      ((QuotientGroup.quotientQuotientEquivQuotient K Z hKZ).trans isoQ)
  have hL : CFSG.Blueprint.LieModel (Q ⧸ Subgroup.center Q) .PSL 3 2 2 ∨
      CFSG.Blueprint.LieModel (Q ⧸ Subgroup.center Q) .PSU 3 2 3 := by
    rcases hbar with h | h
    · exact Or.inl h.2
    · exact Or.inr h.2
  exfalso
  exact not_nonempty_mulEquiv_quotient_perm_fin_nine_L34_or_U38 (L := Q ⧸ Subgroup.center Q) hL
    φ.range N ⟨iso⟩

theorem r5o_perm_nine :
    ∀ {G : Type} [Group G] [Finite G] (X : Subgroup G), ⁅X, X⁆ = X →
      (IsSL3 (Bar2 X) 2 ∨ IsSU3 (Bar2 X) 3) → ∀ φ : ↥X →* Equiv.Perm (Fin 9), φ = 1 := by
  intro G _ _ X hperf hbar φ
  let Q := Bar2 X
  let π : ↥X →* Q := QuotientGroup.mk' (CFSG.pCore 2 ↥X)
  have hπ : Function.Surjective π := QuotientGroup.mk'_surjective _
  have hKn : (φ.ker.map π).Normal :=
    Subgroup.Normal.map (inferInstance : φ.ker.Normal) π hπ
  have hq : CFSG.Open.IsQuasisimple Q := hbar.elim (fun h => h.1) (fun h => h.1)
  rcases CFSG.ComponentClassification.Quasisimple.normal_le_center_or_eq_top hq (φ.ker.map π) with
    hle | htop
  · exact r5op9_center_case X hbar φ hle
  · exact r5op9_twoGroup_case X hperf φ htop

private theorem r5oalt_conjOn_val {G : Type} [Group G] {L : Subgroup G} {t : G}
    (ht : t ∈ Subgroup.normalizer (L : Set G)) (x : ↥L) :
    ((UC6.conjOn L ht x : ↥L) : G) = t * x * t⁻¹ := rfl

private noncomputable def r5oalt_conjHom {G : Type} [Group G] (X L : Subgroup G)
    (hXN : X ≤ Subgroup.normalizer (L : Set G)) : ↥X →* MulAut ↥L :=
  MonoidHom.mk' (fun x => UC6.conjOn L (hXN x.2)) (by
    intro x y
    apply MulEquiv.ext
    intro z
    apply Subtype.ext
    rw [MulAut.mul_apply]
    simp only [r5oalt_conjOn_val, Subgroup.coe_mul]
    group)

private theorem r5oalt_conjHom_val {G : Type} [Group G] {X L : Subgroup G}
    (hXN : X ≤ Subgroup.normalizer (L : Set G)) (x : ↥X) (y : ↥L) :
    ((r5oalt_conjHom X L hXN x y : ↥L) : G) = (x : G) * y * (x : G)⁻¹ := rfl

private noncomputable def r5oalt_permAutBij
    (hbij : Function.Bijective (MulAut.conjNormal (H := alternatingGroup (Fin 11)) :
      Equiv.Perm (Fin 11) →* MulAut (alternatingGroup (Fin 11)))) :
    MulAut (alternatingGroup (Fin 11)) ≃* Equiv.Perm (Fin 11) :=
  (MulEquiv.ofBijective (MulAut.conjNormal (H := alternatingGroup (Fin 11)) :
      Equiv.Perm (Fin 11) →* MulAut (alternatingGroup (Fin 11))) hbij).symm

private theorem r5oalt_permAutBij_spec
    (hbij : Function.Bijective (MulAut.conjNormal (H := alternatingGroup (Fin 11)) :
      Equiv.Perm (Fin 11) →* MulAut (alternatingGroup (Fin 11))))
    (φ : MulAut (alternatingGroup (Fin 11))) :
    MulAut.conjNormal (H := alternatingGroup (Fin 11)) (r5oalt_permAutBij hbij φ) = φ := by
  unfold r5oalt_permAutBij
  exact MulEquiv.ofBijective_apply_symm_apply
    (MulAut.conjNormal (H := alternatingGroup (Fin 11)) :
      Equiv.Perm (Fin 11) →* MulAut (alternatingGroup (Fin 11))) hbij

private noncomputable def r5oalt_psi {G : Type} [Group G] {X L : Subgroup G}
    (hXN : X ≤ Subgroup.normalizer (L : Set G))
    (e : ↥L ≃* alternatingGroup (Fin 11))
    (hbij : Function.Bijective (MulAut.conjNormal (H := alternatingGroup (Fin 11)) :
      Equiv.Perm (Fin 11) →* MulAut (alternatingGroup (Fin 11)))) :
    ↥X →* Equiv.Perm (Fin 11) :=
  MonoidHom.mk' (fun x => r5oalt_permAutBij hbij (MulAut.congr e (r5oalt_conjHom X L hXN x)))
    (by intro x y; simp only [map_mul])

private theorem r5oalt_psi_spec {G : Type} [Group G] {X L : Subgroup G}
    (hXN : X ≤ Subgroup.normalizer (L : Set G))
    (e : ↥L ≃* alternatingGroup (Fin 11))
    (hbij : Function.Bijective (MulAut.conjNormal (H := alternatingGroup (Fin 11)) :
      Equiv.Perm (Fin 11) →* MulAut (alternatingGroup (Fin 11))))
    (x : ↥X) :
    MulAut.conjNormal (H := alternatingGroup (Fin 11)) (r5oalt_psi hXN e hbij x) =
      MulAut.congr e (r5oalt_conjHom X L hXN x) := by
  change MulAut.conjNormal (r5oalt_permAutBij hbij
    (MulAut.congr e (r5oalt_conjHom X L hXN x))) = _
  exact r5oalt_permAutBij_spec hbij _

private theorem r5oalt_congr_apply {G H : Type} [Group G] [Group H]
    (ϕ : G ≃* H) (f : MulAut G) (x : H) :
    MulAut.congr ϕ f x = ϕ (f (ϕ.symm x)) := rfl

private theorem r5oalt_psi_coe {G : Type} [Group G] {X L : Subgroup G}
    (hXN : X ≤ Subgroup.normalizer (L : Set G))
    (e : ↥L ≃* alternatingGroup (Fin 11))
    (hbij : Function.Bijective (MulAut.conjNormal (H := alternatingGroup (Fin 11)) :
      Equiv.Perm (Fin 11) →* MulAut (alternatingGroup (Fin 11))))
    (x : ↥X) (y : ↥L) :
    ((e (r5oalt_conjHom X L hXN x y) : alternatingGroup (Fin 11)) : Equiv.Perm (Fin 11)) =
      r5oalt_psi hXN e hbij x * (e y : Equiv.Perm (Fin 11)) *
        (r5oalt_psi hXN e hbij x)⁻¹ := by
  have h := congrArg (fun f : MulAut (alternatingGroup (Fin 11)) =>
      ((f (e y) : alternatingGroup (Fin 11)) : Equiv.Perm (Fin 11)))
    (r5oalt_psi_spec hXN e hbij x)
  rw [MulAut.conjNormal_apply, r5oalt_congr_apply, MulEquiv.symm_apply_apply] at h
  exact h.symm

private theorem r5oalt_conjNormal_swap {G : Type} [Group G] {L : Subgroup G} {t : G}
    (ht : t ∈ Subgroup.normalizer (L : Set G))
    (e : ↥L ≃* alternatingGroup (Fin 11)) {a b : Fin 11}
    (hτ : ∀ y : ↥L,
      ((e (UC6.conjOn L ht y) : alternatingGroup (Fin 11)) : Equiv.Perm (Fin 11)) =
        Equiv.swap a b * (e y : Equiv.Perm (Fin 11)) * (Equiv.swap a b)⁻¹) :
    MulAut.conjNormal (H := alternatingGroup (Fin 11)) (Equiv.swap a b) =
      MulAut.congr e (UC6.conjOn L ht) := by
  apply MulEquiv.ext
  intro z
  apply Subtype.ext
  rw [MulAut.conjNormal_apply, r5oalt_congr_apply]
  simpa using (hτ (e.symm z)).symm

private theorem r5oalt_conjHom_comm {G : Type} [Group G] {X L : Subgroup G} {t : G}
    (hXN : X ≤ Subgroup.normalizer (L : Set G)) (ht : t ∈ Subgroup.normalizer (L : Set G))
    (hXt : X ≤ Subgroup.centralizer ({t} : Set G)) (x : ↥X) :
    r5oalt_conjHom X L hXN x * UC6.conjOn L ht =
      UC6.conjOn L ht * r5oalt_conjHom X L hXN x := by
  have hxt : (x : G) * t = t * (x : G) :=
    Subgroup.mem_centralizer_singleton_iff.mp (hXt x.2)
  apply MulEquiv.ext
  intro z
  apply Subtype.ext
  rw [MulAut.mul_apply, MulAut.mul_apply]
  simp only [r5oalt_conjHom_val, r5oalt_conjOn_val]
  calc (x : G) * (t * z * t⁻¹) * (x : G)⁻¹
      = ((x : G) * t) * z * (t⁻¹ * (x : G)⁻¹) := by group
    _ = (t * (x : G)) * z * ((x : G)⁻¹ * t⁻¹) := by
          rw [hxt, ← mul_inv_rev, hxt, mul_inv_rev]
    _ = t * ((x : G) * z * (x : G)⁻¹) * t⁻¹ := by group

private theorem r5oalt_psi_comm_swap {G : Type} [Group G] {X L : Subgroup G} {t : G}
    (hXN : X ≤ Subgroup.normalizer (L : Set G)) (hXt : X ≤ Subgroup.centralizer ({t} : Set G))
    (e : ↥L ≃* alternatingGroup (Fin 11)) {a b : Fin 11}
    (hbij : Function.Bijective (MulAut.conjNormal (H := alternatingGroup (Fin 11)) :
      Equiv.Perm (Fin 11) →* MulAut (alternatingGroup (Fin 11))))
    (htn : t ∈ Subgroup.normalizer (L : Set G))
    (hτ : ∀ y : ↥L,
      ((e (UC6.conjOn L htn y) : alternatingGroup (Fin 11)) : Equiv.Perm (Fin 11)) =
        Equiv.swap a b * (e y : Equiv.Perm (Fin 11)) * (Equiv.swap a b)⁻¹) (x : ↥X) :
    r5oalt_psi hXN e hbij x * Equiv.swap a b =
      Equiv.swap a b * r5oalt_psi hXN e hbij x := by
  have hρ := r5oalt_conjHom_comm hXN htn hXt x
  have h2 : MulAut.congr e (r5oalt_conjHom X L hXN x) *
        MulAut.congr e (UC6.conjOn L htn) =
      MulAut.congr e (UC6.conjOn L htn) *
        MulAut.congr e (r5oalt_conjHom X L hXN x) := by
    have := congrArg (MulAut.congr e) hρ
    rwa [map_mul, map_mul] at this
  have h1 : MulAut.congr e (r5oalt_conjHom X L hXN x) =
      MulAut.conjNormal (H := alternatingGroup (Fin 11)) (r5oalt_psi hXN e hbij x) :=
    (r5oalt_psi_spec hXN e hbij x).symm
  have h3 : MulAut.congr e (UC6.conjOn L htn) =
      MulAut.conjNormal (H := alternatingGroup (Fin 11)) (Equiv.swap a b) :=
    (r5oalt_conjNormal_swap htn e hτ).symm
  rw [h1, h3] at h2
  have hmul : MulAut.conjNormal (H := alternatingGroup (Fin 11))
        (r5oalt_psi hXN e hbij x * Equiv.swap a b) =
      MulAut.conjNormal (H := alternatingGroup (Fin 11))
        (Equiv.swap a b * r5oalt_psi hXN e hbij x) := by
    rw [map_mul, map_mul]
    exact h2
  exact hbij.1 hmul

private theorem r5oalt_perm_preserves_swap_pair {f : Equiv.Perm (Fin 11)} {a b : Fin 11}
    (hab : a ≠ b) (hcomm : f * Equiv.swap a b = Equiv.swap a b * f) (y : Fin 11) :
    (f y = a ∨ f y = b) ↔ (y = a ∨ y = b) := by
  have hswap : Equiv.swap (f a) (f b) = Equiv.swap a b := by
    rw [Equiv.swap_apply_apply, hcomm]
    group
  have hconj : f * Equiv.swap a b * f⁻¹ = Equiv.swap a b := by
    rw [← Equiv.swap_apply_apply]
    exact hswap
  have hmap : (Equiv.swap a b).support.map f.toEmbedding = (Equiv.swap a b).support := by
    rw [← Equiv.Perm.support_conj, hconj]
  rw [Equiv.Perm.support_swap hab] at hmap
  have hmem : ∀ z : Fin 11, f z ∈ ({a, b} : Finset (Fin 11)) ↔
      z ∈ ({a, b} : Finset (Fin 11)) := by
    intro z
    conv_lhs => rw [← hmap]
    rw [Finset.mem_map]
    exact ⟨fun ⟨w, hw, hwz⟩ => by rwa [f.injective hwz] at hw,
      fun hz => ⟨z, hz, rfl⟩⟩
  simpa using hmem y

private theorem r5oalt_card_pair {a b : Fin 11} (hab : a ≠ b) :
    Fintype.card {y : Fin 11 // y = a ∨ y = b} = 2 := by
  rw [Fintype.card_of_subtype ({a, b} : Finset (Fin 11)) (fun y => by simp)]
  exact Finset.card_pair hab

private theorem r5oalt_card_S {a b : Fin 11} (hab : a ≠ b) :
    Fintype.card {y : Fin 11 // y ≠ a ∧ y ≠ b} = 9 := by
  rw [Fintype.card_of_subtype (({a, b} : Finset (Fin 11))ᶜ) (fun y => by simp)]
  rw [Finset.card_compl, Fintype.card_fin,
    show ({a, b} : Finset (Fin 11)).card = 2 from Finset.card_pair hab]

private theorem r5oalt_psi_fixes_pair {G : Type} [Group G] {X : Subgroup G}
    (hperf : ⁅X, X⁆ = X) {a b : Fin 11} (hab : a ≠ b)
    (ψ : ↥X →* Equiv.Perm (Fin 11))
    (hpres : ∀ x y, (ψ x y = a ∨ ψ x y = b) ↔ (y = a ∨ y = b)) :
    ∀ x, ψ x a = a ∧ ψ x b = b := by
  have : Group.IsPerfect ↥X := Subgroup.isPerfect_iff.mpr hperf
  let pairHom : ↥X →* Equiv.Perm {y : Fin 11 // y = a ∨ y = b} :=
    MonoidHom.mk' (fun x => (ψ x).subtypePerm (fun y => hpres x y)) (by
      intro x y
      ext z
      simp only [Equiv.Perm.subtypePerm_apply, Equiv.Perm.mul_apply, map_mul])
  have hcardperm : Nat.card (Equiv.Perm {y : Fin 11 // y = a ∨ y = b}) = 2 := by
    rw [Nat.card_perm, Nat.card_eq_fintype_card, r5oalt_card_pair hab]
    norm_num
  have : IsMulCommutative (Equiv.Perm {y : Fin 11 // y = a ∨ y = b}) := by
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    exact (isCyclic_of_prime_card (p := 2) hcardperm).isMulCommutative
  have hrange : pairHom.range = ⊥ := by
    have : Group.IsPerfect ↥(pairHom.range) := Group.IsPerfect.range pairHom
    have : IsMulCommutative ↥(pairHom.range) := inferInstance
    exact Subgroup.eq_bot_of_subsingleton _
  have h1 : pairHom = 1 := MonoidHom.range_eq_bot_iff.mp hrange
  intro x
  constructor
  · have hx : (ψ x).subtypePerm (fun y => hpres x y)
        (⟨a, Or.inl rfl⟩ : {y : Fin 11 // y = a ∨ y = b}) = ⟨a, Or.inl rfl⟩ :=
      DFunLike.congr_fun (DFunLike.congr_fun h1 x) ⟨a, Or.inl rfl⟩
    exact Subtype.ext_iff.mp hx
  · have hx : (ψ x).subtypePerm (fun y => hpres x y)
        (⟨b, Or.inr rfl⟩ : {y : Fin 11 // y = a ∨ y = b}) = ⟨b, Or.inr rfl⟩ :=
      DFunLike.congr_fun (DFunLike.congr_fun h1 x) ⟨b, Or.inr rfl⟩
    exact Subtype.ext_iff.mp hx

private theorem r5oalt_psi_eq_one {G : Type} [Group G] [Finite G] {X : Subgroup G}
    (hperf : ⁅X, X⁆ = X)
    (hbar : IsSL3 (Bar2 X) 2 ∨ IsSU3 (Bar2 X) 3)
    {a b : Fin 11} (hab : a ≠ b)
    (ψ : ↥X →* Equiv.Perm (Fin 11))
    (hpres : ∀ x y, (ψ x y = a ∨ ψ x y = b) ↔ (y = a ∨ y = b)) :
    ∀ x, ψ x = 1 := by
  have hP9 := @r5o_perm_nine
  have hfix := r5oalt_psi_fixes_pair hperf hab ψ hpres
  let restHom : ↥X →* Equiv.Perm {y : Fin 11 // y ≠ a ∧ y ≠ b} :=
    MonoidHom.mk' (fun x => (ψ x).subtypePerm (fun y =>
        not_or.symm.trans ((not_congr (hpres x y)).trans not_or))) (by
      intro x y
      ext z
      simp only [Equiv.Perm.subtypePerm_apply, Equiv.Perm.mul_apply, map_mul])
  let e9 : {y : Fin 11 // y ≠ a ∧ y ≠ b} ≃ Fin 9 :=
    Fintype.equivFinOfCardEq (r5oalt_card_S hab)
  let φ : ↥X →* Equiv.Perm (Fin 9) := (Equiv.permCongrHom e9).toMonoidHom.comp restHom
  have hφ : φ = 1 := hP9 X hperf hbar φ
  intro x
  apply Equiv.ext
  intro y
  by_cases hy : y = a ∨ y = b
  · rcases hy with rfl | rfl
    · exact (hfix x).1
    · exact (hfix x).2
  · push Not at hy
    have hx' : e9.permCongrHom (restHom x) = 1 := by
      simpa [φ] using DFunLike.congr_fun hφ x
    have hx : restHom x = 1 := (Equiv.permCongrHom e9).injective (by
      rw [hx', map_one])
    have hz : (ψ x).subtypePerm (fun y =>
          not_or.symm.trans ((not_congr (hpres x y)).trans not_or))
        (⟨y, hy⟩ : {y : Fin 11 // y ≠ a ∧ y ≠ b}) = ⟨y, hy⟩ :=
      DFunLike.congr_fun hx (⟨y, hy⟩ : {y : Fin 11 // y ≠ a ∧ y ≠ b})
    exact Subtype.ext_iff.mp hz

theorem r5o_alt_commute {G : Type} [Group G] [Finite G]
    {X L₀ : Subgroup G} {t : G} (hperf : ⁅X, X⁆ = X)
    (hbar : IsSL3 (Bar2 X) 2 ∨ IsSU3 (Bar2 X) 3)
    (hXN : X ≤ normalizer (L₀ : Set G)) (hXt : X ≤ centralizer ({t} : Set G))
    (hA : UC6.InducesTransposition t L₀) : X ≤ centralizer (L₀ : Set G) := by
  obtain ⟨htn, e, τ, hτ, heτ⟩ := hA
  obtain ⟨a, b, hab, rfl⟩ := hτ
  have hbij := CFSG.GroupTheory.AutAlternating.aut_alternatingGroup_bijective_conj 11
    (by norm_num) (by norm_num)
  have hcomm : ∀ x : ↥X, r5oalt_psi hXN e hbij x * Equiv.swap a b =
      Equiv.swap a b * r5oalt_psi hXN e hbij x :=
    fun x => r5oalt_psi_comm_swap hXN hXt e hbij htn heτ x
  have hpres : ∀ x : ↥X, ∀ y : Fin 11,
      (r5oalt_psi hXN e hbij x y = a ∨ r5oalt_psi hXN e hbij x y = b) ↔
        (y = a ∨ y = b) :=
    fun x y => r5oalt_perm_preserves_swap_pair hab (hcomm x) y
  have hpsi : ∀ x : ↥X, r5oalt_psi hXN e hbij x = 1 :=
    r5oalt_psi_eq_one hperf hbar hab (r5oalt_psi hXN e hbij) hpres
  intro x hx
  rw [Subgroup.mem_centralizer_iff]
  intro y hy
  have hρ : r5oalt_conjHom X L₀ hXN ⟨x, hx⟩ = 1 := by
    have h := r5oalt_psi_spec hXN e hbij ⟨x, hx⟩
    rw [hpsi ⟨x, hx⟩, map_one] at h
    exact (MulAut.congr e).injective (by rw [h.symm, map_one])
  have hy' : r5oalt_conjHom X L₀ hXN ⟨x, hx⟩ ⟨y, hy⟩ = ⟨y, hy⟩ := by rw [hρ]; rfl
  have hxy : x * y * x⁻¹ = y := by
    have := r5oalt_conjHom_val hXN ⟨x, hx⟩ ⟨y, hy⟩
    rw [hy'] at this
    exact this.symm
  calc y * x = (x * y * x⁻¹) * x := by rw [hxy]
    _ = x * y := by group

theorem r5o_exists_sylow {G : Type} [Group G] [Finite G] {X N : Subgroup G} (hXN : X ≤ N) :
    ∃ Q : Subgroup G, IsSylowOf 3 Q N ∧ IsSylowOf 3 (Q ⊓ X) X := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨P₀, hP₀⟩ := CFSG.ABGLocalTools.exists_isSylowOf 3 X
  have hP₀N : P₀ ≤ N := hP₀.le.trans hXN
  obtain ⟨S, hS⟩ := (hP₀.isPGroup.comap_subtype (K := N)).exists_le_sylow
  let Q : Subgroup G := (S : Subgroup ↥N).map N.subtype
  have hQ : IsSylowOf 3 Q N := ⟨S, rfl⟩
  have hP₀Q : P₀ ≤ Q := by
    rw [← Subgroup.map_subgroupOf_eq_of_le hP₀N]
    exact Subgroup.map_mono hS
  refine ⟨Q, hQ, ?_⟩
  have hQX : Q ⊓ X = P₀ :=
    hP₀.eq_of_le (le_inf hP₀Q hP₀.le) inf_le_right (hQ.isPGroup.to_le inf_le_left)
  rw [hQX]
  exact hP₀

theorem r5o_centralizes_of_pCoreOf {G : Type} [Group G] {N X : Subgroup G} {t : G}
    (hXN : X ≤ N) (ht : orderOf t = 2) (hpt : pCoreOf 2 N = Subgroup.zpowers t) :
    X ≤ centralizer ({t} : Set G) := by
  intro x hx
  have hxn : x ∈ normalizer ((pCoreOf 2 N : Subgroup G) : Set G) :=
    CFSG.RankThreeCoreUniqueness.Helpers.localGroup_le_normalizer_pCoreOf 2 N (hXN hx)
  rw [hpt] at hxn
  have hmem : x * t * x⁻¹ ∈ Subgroup.zpowers t :=
    (Subgroup.mem_normalizer_iff.1 hxn t).1 (Subgroup.mem_zpowers t)
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.1 hmem
  have ht1 : t ≠ 1 := by
    intro h
    rw [h, orderOf_one] at ht
    omega
  have hmod : t ^ (n % 2) = t ^ n := by
    have := zpow_mod_orderOf t n
    rw [ht] at this
    exact_mod_cast this
  have hcases : n % 2 = 0 ∨ n % 2 = 1 := by omega
  rw [Subgroup.mem_centralizer_singleton_iff]
  rcases hcases with h0 | h1
  · exfalso
    rw [h0, zpow_zero] at hmod
    apply ht1
    have h : x * t * x⁻¹ = 1 := hn.symm.trans hmod.symm
    exact conj_eq_one_iff.1 h
  · rw [h1, zpow_one] at hmod
    have h : x * t * x⁻¹ = t := hn.symm.trans hmod.symm
    exact mul_inv_eq_iff_eq_mul.1 h

theorem r875O2HM_of_inputs {G : Type} [Group G] [Finite G] (D : Data G)
    (hSg : UC6S846.SigmaStd D) (h873 : R873Mod D) (h874 : R874 D) (h67 : UC6.R6_7 D) :
    R875O2HM D := by
  have _ : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  intro L X H hmin
  by_contra hne
  obtain ⟨hHtop, hHM, hXHM⟩ := eight70_config hmin
  have hperf : ⁅X, X⁆ = X := eight70_perfect hmin
  obtain ⟨hr2, hbar⟩ := h873 L X H hmin
  obtain ⟨Q, hQ, hQX⟩ := r5o_exists_sylow hXHM
  obtain ⟨-, hΓ⟩ := h874 L X H hmin Q hQ hQX
  have hPrank : 2 ≤ CFSG.Open.pRank 3 (Q ⊓ X) :=
    hr2.trans (CFSG.pRank_le_of_isSylowOf_le Nat.prime_three hQX.le hQX le_rfl)
  obtain ⟨E, hEP, hEel, hEcard⟩ :=
    UC6S846.exists_elemAbelian_card_of_le_pRank (M := Q ⊓ X) Nat.prime_three (k := 2) hPrank
  have hEX : E ≤ X := hEP.trans inf_le_right
  have hXM : X ≤ D.M := hXHM.trans inf_le_right
  have hEM : E ≤ D.M := hEX.trans hXM
  have hEH : E ≤ H := hEX.trans hmin.mem.2
  have hΓE : CFSG.Open.rankThreeGamma 1 3 E ≤ D.M := by
    have hmono : CFSG.Open.rankThreeGamma 1 3 E ≤ CFSG.Open.rankThreeGamma 1 3 (Q ⊓ X) := by
      simpa [CFSG.Open.rankThreeGamma] using
        CFSG.HardMathSupport.Solomon.Proving.GLBCore_mono (p := 3) (k := 1) hEP
    exact hmono.trans hΓ
  have hEnt : ∃ e ∈ E, e ≠ 1 := by
    by_contra hcon
    push Not at hcon
    have h1 : Nat.card E = 1 := by
      rw [Nat.card_eq_one_iff_unique]
      refine ⟨⟨fun a b => Subtype.ext ?_⟩, ⟨1⟩⟩
      rw [hcon a a.2, hcon b b.2]
    rw [hEcard] at h1
    norm_num at h1
  obtain ⟨e, heE, he1⟩ := hEnt
  have hns : ¬ Group.IsSolvable ↥D.M := by
    intro hsol
    have : Group.IsSolvable ↥X :=
      Group.isSolvable_of_isSolvable_injective (f := Subgroup.inclusion hXM)
        (Subgroup.inclusion_injective hXM)
    have hXtop : commutator ↥X = ⊤ := by
      apply Subgroup.map_injective X.subtype_injective
      rw [Subgroup.map_top, Subgroup.range_subtype, _root_.commutator_def, Subgroup.map_commutator,
        Subgroup.map_top, Subgroup.range_subtype]
      exact hperf
    have : Nontrivial ↥X :=
      nontrivial_of_ne (⟨e, hEX heE⟩ : ↥X) 1 fun h => he1 (congrArg Subtype.val h)
    exact (IsSolvable.commutator_lt_top_of_nontrivial ↥X).ne hXtop
  have hsig : D.sig ⊆ D.sig1 := UC6S846.sig_subset_sig1 hSg hns
  obtain ⟨-, t, ht2, hpt, L₀, hL₀H, hL₀n, hHeq, hshape⟩ :=
    h67 hsig 3 Nat.prime_three (by norm_num) E hEM hEel hEcard hΓE H hEH hHtop hne hHM
  have hXt : X ≤ centralizer ({t} : Set G) := r5o_centralizes_of_pCoreOf hXHM ht2 hpt
  have hXN : X ≤ normalizer (L₀ : Set G) :=
    hmin.mem.2.trans ((Subgroup.normal_subgroupOf_iff_le_normalizer hL₀H).1 hL₀n)
  have hXc : X ≤ centralizer (L₀ : Set G) := by
    rcases hshape with hgf | ⟨-, hA⟩
    · rcases hgf with ⟨hK, hind⟩ | ⟨K₁, K₂, hL₀eq, hcomm, h₁, h₂, -, hi₁, hi₂⟩
      · exact r5o_graphField_commute r5o_graphField_quotTrivial hK hind ht2
          hperf hXN hXt
      · rw [hL₀eq] at hXN ⊢
        obtain ⟨hN₁, hN₂⟩ := r5o_prod_normalizes hcomm h₁ h₂ hperf hXN
        have hc₁ := r5o_graphField_commute r5o_graphField_quotTrivial
          (Or.inr h₁) hi₁ ht2 hperf hN₁ hXt
        have hc₂ := r5o_graphField_commute r5o_graphField_quotTrivial
          (Or.inr h₂) hi₂ ht2 hperf hN₂ hXt
        intro x hx
        have hx₁ := Subgroup.mem_centralizer_iff.1 (hc₁ hx)
        have hx₂ := Subgroup.mem_centralizer_iff.1 (hc₂ hx)
        refine Subgroup.mem_centralizer_iff.2 fun y hy => ?_
        have hle : K₁ ⊔ K₂ ≤ centralizer ({x} : Set G) :=
          sup_le (fun k hk => Subgroup.mem_centralizer_singleton_iff.2 (hx₁ k hk))
            (fun k hk => Subgroup.mem_centralizer_singleton_iff.2 (hx₂ k hk))
        exact Subgroup.mem_centralizer_singleton_iff.1 (hle hy)
    · exact r5o_alt_commute hperf hbar hXN hXt hA
  have he3 : e ^ 3 = 1 := hEel.2 e heE
  have hord : orderOf e = 3 := orderOf_eq_prime he3 he1
  have hY : Subgroup.zpowers e ≤ E := Subgroup.zpowers_le.2 heE
  have hYcard : Nat.card (Subgroup.zpowers e) = 3 ^ 1 := by
    rw [Nat.card_zpowers, hord]
    norm_num
  have hYrank : 1 ≤ CFSG.Open.pRank 3 (Subgroup.zpowers e) :=
    CFSG.SectionRank.le_pRank Nat.prime_three.one_lt le_rfl (hEel.mono hY) hYcard
  have hNM : normalizer ((Subgroup.zpowers e : Subgroup G) : Set G) ≤ D.M :=
    (CFSG.RankThreeCoreUniqueness.Helpers.gamma_le_iff 1 3 E D.M).1 hΓE (Subgroup.zpowers e) hY
      hYrank
  have hL₀M : L₀ ≤ D.M := by
    intro l hl
    apply hNM
    have hlc : l ∈ centralizer ({e} : Set G) :=
      Subgroup.mem_centralizer_singleton_iff.2
        (Subgroup.mem_centralizer_iff.1 (hXc (hEX heE)) l hl)
    have hlc' : l ∈ centralizer ((Subgroup.zpowers e : Subgroup G) : Set G) := by
      rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
      exact hlc
    exact Subgroup.centralizer_le_normalizer _ hlc'
  exact hHM (hHeq ▸ sup_le inf_le_right hL₀M)

