    rw [← MonoidHom.comap_ker (QuotientGroup.mk' N) (Subgroup.inclusion hKJ),
      QuotientGroup.ker_mk']
  have hN2 : IsPGroup 2 N := CFSG.LieType.BorelTits.pCore_isPGroup 2
  rw [hker_eq]
  exact hN2.comap_of_injective (Subgroup.inclusion hKJ) (Subgroup.inclusion_injective hKJ)

private theorem r90s7b_perfInter_sup {G : Type} [Group G] [Finite G] {D : Data G}
    {L P J Y : Subgroup G} {n : ℕ} (c : Cfg890 D L P J Y n) (h889 : R889 D)
    (hcomm : ⁅L, J⁆ ≤ pCoreOf 2 L ⊓ pCoreOf 2 J) :
    perfInter890 J (centralizer (Y : Set G)) ⊔ pCoreOf 2 J = J := by
  set H : Subgroup G := J ⊓ centralizer (Y : Set G) with hH
  have hHJ : H ≤ J := inf_le_left
  have hsup : H ⊔ pCoreOf 2 J = J := r90s7b_inf_centralizer_sup c h889 hcomm
  have hperfJ : Group.IsPerfect (Bar2 J) := ⟨c.memJ.2.2.1⟩
  let N : Subgroup ↥J := CFSG.pCore 2 ↥J
  let f : ↥H →* Bar2 J := (QuotientGroup.mk' N).comp (Subgroup.inclusion hHJ)
  have hfsurj : Function.Surjective f := r90s7b_map_surj hHJ hsup
  have hmapf := @CFSG.RankThreeCoreUniqueness.Helpers.finite_perfectResidual_surjects_to_perfect_image
      ↥H (Bar2 J) _ _ _ hperfJ f hfsurj
  have hKJ : perfInter890 J (centralizer (Y : Set G)) ≤ J :=
    r890_perfInter_le_left J (centralizer (Y : Set G))
  have hEq : ((CFSG.perfectResidual ↥H).map (Subgroup.inclusion hHJ)) =
      (perfInter890 J (centralizer (Y : Set G))).subgroupOf J := by
    apply Subgroup.map_injective J.subtype_injective
    rw [Subgroup.map_map]
    rw [show J.subtype.comp (Subgroup.inclusion hHJ) = H.subtype from rfl]
    rw [Subgroup.subgroupOf_map_subtype]
    exact (inf_eq_left.mpr hKJ).symm
  have hKmap : ((perfInter890 J (centralizer (Y : Set G))).subgroupOf J).map
      (QuotientGroup.mk' N) = ⊤ := by
    rw [← hEq]
    rw [Subgroup.map_map]
    change ((CFSG.perfectResidual ↥H).map f) = ⊤
    exact hmapf
  have hKsup_sub : ((perfInter890 J (centralizer (Y : Set G))).subgroupOf J) ⊔ N = ⊤ := by
    have hc : Subgroup.comap (QuotientGroup.mk' N)
        (((perfInter890 J (centralizer (Y : Set G))).subgroupOf J).map
          (QuotientGroup.mk' N)) = ⊤ := by
      rw [hKmap, Subgroup.comap_top]
    rw [QuotientGroup.comap_map_mk', sup_comm] at hc
    exact hc
  have hfinal := congrArg (Subgroup.map J.subtype) hKsup_sub
  rw [Subgroup.map_sup, Subgroup.map_top, Subgroup.map_subgroupOf_eq_of_le hKJ,
    Subgroup.range_subtype] at hfinal
  have hNmap : N.map J.subtype = pCoreOf 2 J := rfl
  rwa [hNmap] at hfinal

