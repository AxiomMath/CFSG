private theorem r90s7h_minimal_invariant
    {G : Type} [Group G] [Finite G] {L : Subgroup G}
    {V : Type} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]
    (ρ : Representation (ZMod 2) (Bar2 L) V) (hV : Nontrivial V) :
    ∃ (U₀ : Submodule (ZMod 2) V) (ρ₀ : Bar2 L →* (↥U₀ ≃ₗ[ZMod 2] ↥U₀)),
      U₀ ≠ ⊥ ∧
      (∀ (x : Bar2 L) (v : ↥U₀), ((ρ₀ x v : ↥U₀) : V) = ρ x (v : V)) ∧
      (∀ W : Submodule (ZMod 2) ↥U₀,
        (∀ x : Bar2 L, W.map (ρ₀ x : ↥U₀ →ₗ[ZMod 2] ↥U₀) ≤ W) → W = ⊥ ∨ W = ⊤) := by
  classical
  obtain ⟨v₀, hv₀⟩ := exists_ne (0 : V)
  have hU : (⊤ : Submodule (ZMod 2) V) ≠ ⊥ := by
    intro h
    have hmem : v₀ ∈ (⊥ : Submodule (ZMod 2) V) := by rw [← h]; trivial
    exact hv₀ (by simpa using hmem)
  obtain ⟨U₀, -, hU₀ne, hU₀inv, hU₀min⟩ :=
    CFSG.GroupTheory.exists_minimal_invariant_submodule ρ (U := ⊤) hU (fun _ _ _ => trivial)
  let hsub : ∀ g : Bar2 L, U₀ ≤ U₀.comap (ρ g) := fun g v hv => hU₀inv g v hv
  let ρsub : Representation (ZMod 2) (Bar2 L) ↥U₀ := ρ.subrepresentation U₀ hsub
  let ρ₀ : Bar2 L →* (↥U₀ ≃ₗ[ZMod 2] ↥U₀) :=
    (LinearMap.GeneralLinearGroup.generalLinearEquiv (ZMod 2) ↥U₀).toMonoidHom.comp
      (MonoidHom.toHomUnits ρsub)
  have hρ₀ : ∀ (x : Bar2 L) (v : ↥U₀), ((ρ₀ x v : ↥U₀) : V) = ρ x (v : V) := fun _ _ => rfl
  refine ⟨U₀, ρ₀, hU₀ne, hρ₀, ?_⟩
  intro W hWinv
  have hW'le : W.map U₀.subtype ≤ U₀ := Submodule.map_subtype_le U₀ W
  have hW'inv : ∀ x : Bar2 L, ∀ v ∈ W.map U₀.subtype, ρ x v ∈ W.map U₀.subtype := by
    intro x v hv
    obtain ⟨w, hw, rfl⟩ := hv
    have h1 : ρ₀ x w ∈ W := hWinv x (Submodule.mem_map_of_mem
      (f := (ρ₀ x : ↥U₀ →ₗ[ZMod 2] ↥U₀)) hw)
    exact ⟨ρ₀ x w, h1, hρ₀ x w⟩
  rcases hU₀min (W.map U₀.subtype) hW'le hW'inv with hbot | htop
  · left
    apply Submodule.map_injective_of_injective U₀.subtype_injective
    simpa using hbot
  · right
    apply Submodule.map_injective_of_injective U₀.subtype_injective
    rw [Submodule.map_subtype_top U₀]
    exact htop

private theorem r90s7h_fixed_zpowers
    {G : Type} [Group G] {L : Subgroup G} {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) (Bar2 L) V) {v : V} {x : Bar2 L}
    (hx : ρ x v = v) : ∀ z ∈ Subgroup.zpowers x, ρ z v = v := by
  let K : Subgroup (Bar2 L) :=
    { carrier := {z | ρ z v = v}
      one_mem' := by
        show ρ 1 v = v
        rw [map_one, Module.End.one_apply]
      mul_mem' := fun {a b} ha hb => by
        have ha' : ρ a v = v := ha
        have hb' : ρ b v = v := hb
        show ρ (a * b) v = v
        rw [map_mul, Module.End.mul_apply, hb', ha']
      inv_mem' := fun {a} ha => by
        have ha' : ρ a v = v := ha
        show ρ a⁻¹ v = v
        have h : (ρ a⁻¹ * ρ a) v = v := by
          rw [← map_mul, inv_mul_cancel, map_one, Module.End.one_apply]
        rwa [Module.End.mul_apply, ha'] at h }
  intro z hz
  exact Subgroup.zpowers_le.mpr (show x ∈ K from hx) hz

private theorem r90s7h_order_centralizer
    {G : Type} [Group G] [Finite G] {L Y : Subgroup G}
    (hYleL : Y ≤ L) (hYcard : Nat.card Y = 3) :
    ∃ (ybar : Bar2 L),
      orderOf ybar = 3 ∧
      barImg_890 L Y = Subgroup.zpowers ybar ∧
      Subgroup.centralizer (barImg_890 L Y : Set (Bar2 L)) =
        Subgroup.centralizer ({ybar} : Set (Bar2 L)) := by
  classical
  have : Fact (Nat.Prime 3) := Nat.fact_prime_three
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨y₀, hy₀ord⟩ := exists_prime_orderOf_dvd_card' (G := ↥Y) 3 (by rw [hYcard])
  have hy₀L : ((y₀ : ↥Y) : G) ∈ L := hYleL y₀.2
  let ybar : Bar2 L := QuotientGroup.mk' (CFSG.pCore 2 ↥L) ⟨(y₀ : G), hy₀L⟩
  have hord : orderOf ((y₀ : ↥Y) : G) = 3 := by
    rw [Subgroup.orderOf_coe]; exact hy₀ord
  have hybarord : orderOf ybar = 3 := by
    have hdvd : orderOf ybar ∣ 3 := by
      have h1 : orderOf ybar ∣ orderOf ((⟨(y₀ : G), hy₀L⟩ : ↥L)) :=
        orderOf_map_dvd (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) ⟨(y₀ : G), hy₀L⟩
      rw [← Subgroup.orderOf_coe, hord] at h1
      exact h1
    have hne : orderOf ybar ≠ 1 := by
      intro h1
      have hz1 : ybar = 1 := by rw [← orderOf_eq_one_iff]; exact h1
      have hzO2 : ((y₀ : ↥Y) : G) ∈ pCoreOf 2 L := by
        have hmem : (⟨(y₀ : G), hy₀L⟩ : ↥L) ∈ CFSG.pCore 2 ↥L :=
          (QuotientGroup.eq_one_iff (N := CFSG.pCore 2 ↥L) (x := ⟨(y₀ : G), hy₀L⟩)).mp hz1
        exact Subgroup.mem_map.mpr ⟨⟨(y₀ : G), hy₀L⟩, hmem, rfl⟩
      have hz2 : orderOf ((y₀ : ↥Y) : G) ∣ Nat.card (pCoreOf 2 L) :=
        Subgroup.orderOf_dvd_natCard (pCoreOf 2 L) hzO2
      obtain ⟨k, hk⟩ := IsPGroup.exists_card_eq
        (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 L)
      have h3dvd : 3 ∣ 2 ^ k := by
        rw [hk] at hz2
        simpa [hord] using hz2
      have h32 : 3 = 2 := Nat.prime_eq_prime_of_dvd_pow Nat.prime_three Nat.prime_two h3dvd
      omega
    rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
    · exact absurd h1 hne
    · exact h3
  have hbarImg : barImg_890 L Y = Subgroup.zpowers ybar := by
    symm
    apply Subgroup.eq_of_le_of_card_ge
    · rw [Subgroup.zpowers_le]
      exact Subgroup.mem_map_of_mem (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) (by
        rw [Subgroup.mem_subgroupOf]; exact y₀.2)
    · have hYp : IsPGroup 3 (Y.subgroupOf L) := by
        apply IsPGroup.of_card_dvd_pow (n := 1)
        rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hYleL).toEquiv, hYcard, pow_one]
      have hO2p : IsPGroup 2 (CFSG.pCore 2 ↥L) := CFSG.pCore_isPGroup (p := 2) (G := ↥L)
      have hker : (Y.subgroupOf L) ⊓ (QuotientGroup.mk' (CFSG.pCore 2 ↥L)).ker = ⊥ := by
        rw [QuotientGroup.ker_mk']
        exact (IsPGroup.disjoint_of_ne 3 2 (by decide) _ _ hYp hO2p).eq_bot
      have hcard : Nat.card (barImg_890 L Y) = 3 := by
        rw [barImg_890, CFSG.card_map_eq_card_of_inf_ker_eq_bot _ hker,
          Nat.card_congr (Subgroup.subgroupOfEquivOfLe hYleL).toEquiv, hYcard]
      rw [hcard, Nat.card_zpowers, hybarord]
  refine ⟨ybar, hybarord, hbarImg, ?_⟩
  rw [hbarImg, Subgroup.zpowers_eq_closure]
  exact Subgroup.centralizer_closure {ybar}

private theorem r90s7h_fixed_to_mem
    {G : Type} [Group G] [Finite G] {L J A B Y : Subgroup G}
    (hch : CFSG.ABGLocalTools.IsChiefFactorUnder 2 (L ⊔ J) A B)
    [(B.subgroupOf A).Normal] [IsElementaryAbelian 2 (A ⧸ B.subgroupOf A)]
    (hYleL : Y ≤ L)
    (ρ : Representation (ZMod 2) (Bar2 L) (Additive (A ⧸ B.subgroupOf A)))
    (hρ : ∀ (l : ↥L), ρ (QuotientGroup.mk' (CFSG.pCore 2 ↥L) l) =
      (Units.coeHom _) (CFSG.ABGLocalTools.chiefRep (p := 2) hch.2.1 hch.2.2.1
        (⟨l.1, (le_sup_left : L ≤ L ⊔ J) l.2⟩ : ↥(L ⊔ J))))
    {ybar : Bar2 L} (hbarImg : barImg_890 L Y = Subgroup.zpowers ybar)
    {v : Additive (A ⧸ B.subgroupOf A)} (hvne : v ≠ 0) (hvfix : ρ ybar v = v) :
    ∃ a ∈ A, a ∉ B ∧ ∀ y ∈ Y, ⁅a, y⁆ ∈ B := by
  classical
  obtain ⟨a, ha⟩ := CFSG.ABGLocalTools.exists_ofMul_mk v
  refine ⟨(a : G), a.2, ?_, ?_⟩
  · intro haB
    apply hvne
    have h1 : (a : A ⧸ B.subgroupOf A) = 1 :=
      (QuotientGroup.eq_one_iff a).mpr (Subgroup.mem_subgroupOf.mpr haB)
    rw [ha, h1]
    rfl
  · intro y hy
    have hyL : y ∈ L := hYleL hy
    have hmem : QuotientGroup.mk' (CFSG.pCore 2 ↥L) ⟨y, hyL⟩ ∈ Subgroup.zpowers ybar := by
      rw [← hbarImg]
      exact Subgroup.mem_map_of_mem (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) (by
        rw [Subgroup.mem_subgroupOf]; exact hy)
    have hfixy : ρ (QuotientGroup.mk' (CFSG.pCore 2 ↥L) ⟨y, hyL⟩) v = v :=
      r90s7h_fixed_zpowers ρ hvfix _ hmem
    have h1 : (Units.coeHom _) (CFSG.ABGLocalTools.chiefRep (p := 2) hch.2.1 hch.2.2.1
        (⟨y, (le_sup_left : L ≤ L ⊔ J) hyL⟩ : ↥(L ⊔ J)))
        (Additive.ofMul (a : A ⧸ B.subgroupOf A)) =
        Additive.ofMul (a : A ⧸ B.subgroupOf A) := by
      have h2 : (Units.coeHom _) (CFSG.ABGLocalTools.chiefRep (p := 2) hch.2.1 hch.2.2.1
          (⟨y, (le_sup_left : L ≤ L ⊔ J) hyL⟩ : ↥(L ⊔ J))) v = v := by
        rw [← hρ ⟨y, hyL⟩]
        exact hfixy
      rwa [ha] at h2
    have h3 : y * (a : G) * y⁻¹ * (a : G)⁻¹ ∈ B :=
      CFSG.LocalAnalysis.UniquenessCase.PartOne.Section9.conj_mem_of_apply_eq
        (K := L ⊔ J) (U := A) (W := B) (r := 2) hch
        (ρ := (Units.coeHom _).comp (CFSG.ABGLocalTools.chiefRep (p := 2) hch.2.1 hch.2.2.1))
        (fun k u => CFSG.ABGLocalTools.chiefRep_apply_mk hch.2.1 hch.2.2.1 k u)
        (k := (⟨y, (le_sup_left : L ≤ L ⊔ J) hyL⟩ : ↥(L ⊔ J))) (u := a) h1
    have h4 : ⁅(a : G), y⁆ = (y * (a : G) * y⁻¹ * (a : G)⁻¹)⁻¹ := by
      rw [commutatorElement_def]; group
    rw [h4]
    exact B.inv_mem h3

theorem r890_step6 : Step6_890 := by
  intro hFix G _ _ D L P J Y n hCfg hR885 hR889 A B hChief hComm hY3B
  classical
  have hYleL : Y ≤ L := hCfg.le_P.trans (hR889 L P hCfg.set880)
