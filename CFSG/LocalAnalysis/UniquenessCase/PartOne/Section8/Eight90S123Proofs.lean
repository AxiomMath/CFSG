private theorem r90l11_card_P {G : Type} [Group G] [Finite G] {D : Data G}
    {L P : Subgroup G} (hset : Set880 D L P) (_h885 : R885 D) (h886 : R886 D)
    (h889 : R889 D) (hBarCard : Nat.card (Bar2 L) = 604800) :
    Nat.card P = 27 ∧ ¬ IsMulCommutative ↥P := by
  have : Fact (Nat.Prime 3) := Nat.fact_prime_three
  have hPL : P ≤ L := h889 L P hset
  have hLM : L ≤ D.M := hset.mem.1.le
  have hPLsyl : CFSG.ABGLocalTools.IsSylowOf 3 P L := hset.sylow.of_le hPL hLM
  have hPcard_exp : Nat.card P = 3 ^ (Nat.card L).factorization 3 := hPLsyl.card_eq
  have hFac604800 : (604800 : ℕ).factorization 3 = 3 := by
    have h : (604800 : ℕ) = 3 ^ 3 * 22400 := by norm_num
    rw [h, Nat.factorization_mul (by norm_num) (by norm_num)]
    change (3 ^ 3).factorization 3 + (22400 : ℕ).factorization 3 = 3
    rw [Nat.factorization_pow_self (by norm_num),
      Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 3 ∣ 22400)]
  have hLfac : (Nat.card L).factorization 3 = 3 := by
    have hpc2 : IsPGroup 2 (CFSG.pCore 2 ↥L) := CFSG.pCore_isPGroup
    obtain ⟨k, hk⟩ := hpc2.exists_card_eq
    have hLcard : Nat.card L = Nat.card (Bar2 L) * Nat.card (CFSG.pCore 2 ↥L) :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup (CFSG.pCore 2 ↥L)
    rw [hLcard, hBarCard, hk,
      Nat.factorization_mul (by norm_num) (pow_ne_zero k (by norm_num))]
    change (604800 : ℕ).factorization 3 + (2 ^ k : ℕ).factorization 3 = 3
    have h2 : (2 ^ k : ℕ).factorization 3 = 0 :=
      Nat.factorization_eq_zero_of_not_dvd (by
        intro h3
        exact absurd (Nat.Prime.dvd_of_dvd_pow Nat.prime_three h3) (by norm_num))
    rw [hFac604800, h2, add_zero]
  have hPcard : Nat.card P = 27 := by
    rw [hPcard_exp, hLfac]
    norm_num
  have hZcard : Nat.card (ZOf (P ⊓ L)) = 3 := (h886 L P hset).1
  refine ⟨hPcard, ?_⟩
  intro hab
  have hInf : P ⊓ L = P := inf_eq_left.mpr hPL
  have hZcardP : Nat.card (ZOf P) = 3 := by rwa [hInf] at hZcard
  have hZeqP : ZOf P = P := by
    rw [ZOf, inf_eq_left.mpr (Subgroup.le_centralizer_iff_isMulCommutative.mpr hab)]
  have hthree : Nat.card P = 3 := by rw [← hZeqP]; exact hZcardP
  omega

private theorem r90l11_center_le_of_card_ge {G : Type} [Group G] [Finite G]
    {P U Z : Subgroup G} (hUP : U ≤ P) (hZP : Z ≤ P) (hZcard : Nat.card Z = 3)
    (hZcent : Z ≤ Subgroup.centralizer (P : Set G)) (hPcard : Nat.card P = 27)
    (hPnonab : ¬ IsMulCommutative ↥P) (hUcard : 9 ≤ Nat.card U) : Z ≤ U := by
  have : Fact (Nat.Prime 3) := Nat.fact_prime_three
  by_contra hZU
  have hZinf : Z ⊓ U = ⊥ := by
    by_contra hne
    have hdiv : Nat.card (Z ⊓ U : Subgroup G) ∣ 3 := by
      rw [← hZcard]
      exact Subgroup.card_dvd_of_le inf_le_left
    have hne1 : Nat.card (Z ⊓ U : Subgroup G) ≠ 1 := by
      intro h1
      exact hne (Subgroup.card_eq_one.mp h1)
    have hcard3 : Nat.card (Z ⊓ U : Subgroup G) = 3 := by
      rcases (Nat.dvd_prime Nat.prime_three).mp hdiv with h | h
      · exact absurd h hne1
      · exact h
    have hZinf_eq : Z ⊓ U = Z :=
      Subgroup.eq_of_le_of_card_ge (inf_le_left : Z ⊓ U ≤ Z) (by rw [hcard3, hZcard])
    exact hZU (hZinf_eq ▸ inf_le_right)
  have hdisj : Disjoint Z U := disjoint_iff.mpr hZinf
  have hZnorm : U ≤ Subgroup.normalizer (Z : Set G) :=
    hUP.trans ((Subgroup.le_centralizer_iff.mp hZcent).trans
      (Subgroup.centralizer_le_normalizer (Z : Set G)))
  have hcardsup : Nat.card (Z ⊔ U : Subgroup G) = Nat.card Z * Nat.card U :=
    CFSG.GorensteinWalter.card_sup_eq_mul_of_disjoint_of_le_normalizer Z U hZnorm hdisj
  have hle : Z ⊔ U ≤ P := sup_le hZP hUP
  have hcardle : Nat.card (Z ⊔ U : Subgroup G) ≤ Nat.card P := Subgroup.card_le_of_le hle
  have hUle9 : Nat.card U ≤ 9 := by
    rw [hcardsup, hZcard, hPcard] at hcardle
    omega
  have hUeq9 : Nat.card U = 9 := le_antisymm hUle9 hUcard
  have hsup_eq : Z ⊔ U = P :=
    Subgroup.eq_of_le_of_card_ge hle (by rw [hcardsup, hZcard, hUeq9, hPcard])
  have hUab : IsMulCommutative ↥U :=
    IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 3) (by rw [hUeq9]; norm_num)
  have hUcentU : U ≤ Subgroup.centralizer (U : Set G) :=
    Subgroup.le_centralizer_iff_isMulCommutative.mpr hUab
  have hUcentZ : U ≤ Subgroup.centralizer (Z : Set G) :=
    hUP.trans (Subgroup.le_centralizer_iff.mp hZcent)
  have hZle_centU : Z ≤ Subgroup.centralizer (U : Set G) :=
    Subgroup.le_centralizer_iff.mpr hUcentZ
  have hZle : Z ≤ Subgroup.centralizer ((Z ⊔ U : Subgroup G) : Set G) :=
    hZcent.trans (Subgroup.centralizer_le (show ((Z ⊔ U : Subgroup G) : Set G) ⊆ (P : Set G)
      from fun _ hx => hle hx))
  have hUle : U ≤ Subgroup.centralizer ((Z ⊔ U : Subgroup G) : Set G) :=
    Subgroup.le_centralizer_iff.mp (sup_le hZle_centU hUcentU)
  have hcent : (Z ⊔ U : Subgroup G) ≤
      Subgroup.centralizer ((Z ⊔ U : Subgroup G) : Set G) := sup_le hZle hUle
  rw [hsup_eq] at hcent
  exact hPnonab (Subgroup.le_centralizer_iff_isMulCommutative.mp hcent)

theorem r890_lemma1_1 : Lemma1_1_890 := by
  intro G _ _ D h856 h881 h885 h886 h887 h888 h889 hJ2 hT L P hset
