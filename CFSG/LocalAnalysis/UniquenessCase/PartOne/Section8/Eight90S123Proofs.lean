  have hWN : (pCoreOf 2 J).subgroupOf J = CFSG.pCore 2 ↥J := by
    apply Subgroup.map_injective J.subtype_injective
    rw [Subgroup.subgroupOf_map_subtype]
    exact inf_eq_left.mpr (CFSG.LieType.BorelTits.pCoreOf_le 2 J)
  rwa [hWN] at h1

private theorem r90s7b_map_surj {G : Type} [Group G] [Finite G] {J K : Subgroup G}
    (hKJ : K ≤ J) (hsup : K ⊔ pCoreOf 2 J = J) :
    Function.Surjective
      ((QuotientGroup.mk' (CFSG.pCore 2 ↥J)).comp (Subgroup.inclusion hKJ)) := by
  let N : Subgroup ↥J := CFSG.pCore 2 ↥J
  let f : ↥K →* Bar2 J := (QuotientGroup.mk' N).comp (Subgroup.inclusion hKJ)
  have hHsub : (K.subgroupOf J) ⊔ N = ⊤ := r90s7b_subgroupOf_sup_top hKJ hsup
  have htop : ((K.subgroupOf J).map (QuotientGroup.mk' N)).comap (QuotientGroup.mk' N) = ⊤ := by
    rw [QuotientGroup.comap_map_mk', sup_comm, hHsub]
  have hmap : (K.subgroupOf J).map (QuotientGroup.mk' N) = ⊤ :=
    Subgroup.comap_injective (QuotientGroup.mk'_surjective N)
      (by rw [htop, Subgroup.comap_top])
  have hrange : f.range = ⊤ := by
    calc f.range = (⊤ : Subgroup ↥K).map f := MonoidHom.range_eq_map f
      _ = ((⊤ : Subgroup ↥K).map (Subgroup.inclusion hKJ)).map (QuotientGroup.mk' N) := by
            rw [Subgroup.map_map]
      _ = (K.subgroupOf J).map (QuotientGroup.mk' N) := by
            rw [Subgroup.map_top, Subgroup.inclusion_range]
      _ = ⊤ := hmap
  exact MonoidHom.range_eq_top.mp hrange

private theorem r90s7b_map_ker {G : Type} [Group G] [Finite G] {J K : Subgroup G}
    (hKJ : K ≤ J) :
