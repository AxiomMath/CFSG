  obtain ⟨U₀, ρ₀, hU₀ne, hρ₀, hirr⟩ := r90s7h_minimal_invariant ρ hVnt
  have : Nontrivial ↥U₀ := Submodule.nontrivial_iff_ne_bot.mpr hU₀ne
  obtain ⟨ybar, hybarord, hbarImg, hcen⟩ := r90s7h_order_centralizer hYleL hCfg.card_Y
  have hcen3 : (Nat.card (Subgroup.centralizer ({ybar} : Set (Bar2 L)))).factorization 3 = 2 := by
