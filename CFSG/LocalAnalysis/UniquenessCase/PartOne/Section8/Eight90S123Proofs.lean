private theorem r90s7d_oddPCore_eq_bot {X : Type} [Group X] [Finite X]
    (hperf : Group.IsPerfect X) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hsimple : IsSimpleGroup (X ⧸ CFSG.pCore 2 X)) : CFSG.pCore p X = ⊥ := by
  have : Fact p.Prime := ⟨hp⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have := hperf
  let π : X →* X ⧸ CFSG.pCore 2 X := QuotientGroup.mk' (CFSG.pCore 2 X)
  have hmap_normal : ((CFSG.pCore p X).map π).Normal :=
    (inferInstance : (CFSG.pCore p X).Normal).map π
      (QuotientGroup.mk'_surjective (CFSG.pCore 2 X))
  have := hmap_normal
  have hmap_nil : Group.IsNilpotent ↥((CFSG.pCore p X).map π) :=
    (CFSG.pCore_isPGroup (p := p) (G := X)).map π |>.isNilpotent
  rcases hsimple.eq_bot_or_eq_top_of_normal ((CFSG.pCore p X).map π) with hbot | htop
  · have hle : CFSG.pCore p X ≤ CFSG.pCore 2 X := by
      intro x hx
      have hx' : π x = 1 := by
        have hmem := Subgroup.mem_map_of_mem π hx
        rw [hbot] at hmem
        simpa using hmem
      have hker : x ∈ π.ker := hx'
      rwa [QuotientGroup.ker_mk'] at hker
    have hdisj : Disjoint (CFSG.pCore p X) (CFSG.pCore 2 X) :=
      IsPGroup.disjoint_of_ne p 2 hp2 _ _ (CFSG.pCore_isPGroup (p := p) (G := X))
        (CFSG.pCore_isPGroup (p := 2) (G := X))
    rw [disjoint_iff, inf_eq_left.mpr hle] at hdisj
    exact hdisj
  · have hmap_nil' : Group.IsNilpotent ↥(⊤ : Subgroup (X ⧸ CFSG.pCore 2 X)) := by
      rwa [htop] at hmap_nil
    have : Group.IsNilpotent ↥(⊤ : Subgroup (X ⧸ CFSG.pCore 2 X)) := hmap_nil'
    have hnil : Group.IsNilpotent (X ⧸ CFSG.pCore 2 X) :=
      Group.nilpotent_of_mulEquiv (Subgroup.topEquiv (G := X ⧸ CFSG.pCore 2 X))
    exact absurd hnil (Group.IsPerfect.not_isNilpotent (X ⧸ CFSG.pCore 2 X))

