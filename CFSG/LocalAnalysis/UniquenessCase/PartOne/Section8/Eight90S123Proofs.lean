private theorem r90s7c_exists_conj_of_barImage_eq_of_card_three
    {G : Type} [Group G] [Finite G] {L X Y : Subgroup G}
    (hXL : X ≤ L) (hYL : Y ≤ L)
    (hXc : Nat.card X = 3) (hYc : Nat.card Y = 3)
    (hbar : barImg_890 L X = barImg_890 L Y) :
    ∃ h ∈ pCoreOf 2 L, X = Y.map (MulAut.conj h).toMonoidHom := by
  classical
  let J : Subgroup ↥L := CFSG.pCore 2 ↥L
  let X' : Subgroup ↥L := X.subgroupOf L
  let Y' : Subgroup ↥L := Y.subgroupOf L
  have hJ2 : IsPGroup 2 J := CFSG.pCore_isPGroup
  have hX'c : Nat.card X' = 3 := by
    dsimp only [X']
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hXL).toEquiv, hXc]
  have hY'c : Nat.card Y' = 3 := by
    dsimp only [Y']
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hYL).toEquiv, hYc]
  obtain hXbot | ⟨x, hxX, hxne'⟩ := Subgroup.bot_or_exists_ne_one X'
  · rw [hXbot] at hX'c; simp at hX'c
  have hxord : orderOf x = 3 := by
    have hdvd : orderOf x ∣ Nat.card X' := Subgroup.orderOf_dvd_natCard X' hxX
    rw [hX'c] at hdvd
    rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h | h
    · exact absurd (orderOf_eq_one_iff.mp h) hxne'
    · exact h
  have hX'eq : X' = Subgroup.zpowers x := by
    symm
    apply Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hxX)
    rw [Nat.card_zpowers, hxord, hX'c]
  obtain hYbot | ⟨y, hyY, hyne'⟩ := Subgroup.bot_or_exists_ne_one Y'
