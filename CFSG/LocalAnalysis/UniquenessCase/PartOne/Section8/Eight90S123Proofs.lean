private theorem r90s7g_exists_commutator_not_mem {G : Type} [Group G]
    {A J B : Subgroup G} (hAJ : ¬ ⁅A, J⁆ ≤ B) :
    ∃ k ∈ J, ∃ r ∈ A, k * r * k⁻¹ * r⁻¹ ∉ B := by
  by_contra h
  push Not at h
  apply hAJ
  rw [Subgroup.commutator_le]
  intro r hr k hk
  have hkr : k * r * k⁻¹ * r⁻¹ ∈ B := h k hk r hr
  have heq : ⁅r, k⁆ = (k * r * k⁻¹ * r⁻¹)⁻¹ := by
    rw [commutatorElement_def]; group
  rw [heq]
  exact B.inv_mem hkr

private theorem r90s7g_fixed_coset_of_coprime {G : Type} [Group G] [Finite G]
    {A B Y : Subgroup G} {a y₀ : G}
    (hy₀ : Subgroup.zpowers y₀ = Y)
    (hYB : Y ≤ Subgroup.normalizer (B : Set G))
    (hcop : Nat.Coprime (orderOf y₀) (Nat.card B))
    (ha : a ∈ A) (hBA : B ≤ A)
    (ha_normB : a ∈ Subgroup.normalizer (B : Set G))
    (hay : ∀ y ∈ Y, ⁅a, y⁆ ∈ B) :
    ∃ a' ∈ A, a' ∈ Subgroup.centralizer (Y : Set G) ∧ ∃ b ∈ B, a' = a * b := by
  have hy₀Y : y₀ ∈ Y := hy₀ ▸ Subgroup.mem_zpowers y₀
  have hy₀_normB : y₀ ∈ Subgroup.normalizer (B : Set G) := hYB hy₀Y
  have hN : ∀ n ∈ B, y₀ * n * y₀⁻¹ ∈ B :=
    fun n hn => (Subgroup.mem_normalizer_iff.mp hy₀_normB n).mp hn
  have hz : ⁅a, y₀⁆⁻¹ ∈ B := inv_mem (hay y₀ hy₀Y)
  have hg : a⁻¹ * (y₀ * a * y₀⁻¹) ∈ B := by
    have hmem : a⁻¹ * ⁅a, y₀⁆⁻¹ * a ∈ B :=
      (Subgroup.mem_normalizer_iff''.mp ha_normB ⁅a, y₀⁆⁻¹).mp hz
    have heq : a⁻¹ * (y₀ * a * y₀⁻¹) = a⁻¹ * ⁅a, y₀⁆⁻¹ * a := by
      rw [commutatorElement_def]; group
    rw [heq]; exact hmem
  obtain ⟨b, hbB, hfix⟩ :=
    CFSG.GroupTheory.exists_fixed_mem_coset_of_coprime (G := G) B hN hg hcop
  refine ⟨a * b, ?_, ?_, b, hbB, rfl⟩
  · exact mul_mem ha (hBA hbB)
  · have hfix' : y₀ * (a * b) * y₀⁻¹ = a * b := hfix
    have hcomm : (a * b) * y₀ = y₀ * (a * b) := by
      have h := congrArg (· * y₀) hfix'
      simpa [mul_assoc] using h.symm
    have hsingle : a * b ∈ Subgroup.centralizer ({y₀} : Set G) := by
      rw [Subgroup.mem_centralizer_singleton_iff]
      exact hcomm
    have hzp : a * b ∈ Subgroup.centralizer ((Subgroup.zpowers y₀ : Subgroup G) : Set G) := by
      rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
      exact hsingle
    simpa [hy₀] using hzp

private theorem r90s7g_zpowers_commutator_sup_le {G : Type} [Group G]
    {A B J K P W : Subgroup G} {a' : G}
    (hJ : K ⊔ P = J)
    (hAO2 : ⁅A, P⁆ ≤ B)
    (hWK : ⁅W, K⁆ = ⊥)
    (hK_normB : K ≤ Subgroup.normalizer (B : Set G))
    (hP_normB : P ≤ Subgroup.normalizer (B : Set G))
    (ha'A : a' ∈ A) (ha'W : a' ∈ W)
    (ha'_normB : a' ∈ Subgroup.normalizer (B : Set G)) :
    ⁅Subgroup.zpowers a', J⁆ ≤ B := by
  have hKW : ⁅K, W⁆ = ⊥ := by
    rw [Subgroup.commutator_comm (H₁ := K) (H₂ := W)]; exact hWK
  have hKcent : K ≤ Subgroup.centralizer (W : Set G) :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp hKW
  have hKa' : ∀ k ∈ K, ⁅k, a'⁆ ∈ B := by
    intro k hk
    have h1 : ⁅k, a'⁆ = 1 :=
      (Subgroup.mem_centralizer_iff_commutator_eq_one'.mp (hKcent hk)) a' ha'W
    rw [h1]; exact B.one_mem
  have hKcomm : ⁅K, Subgroup.zpowers a'⁆ ≤ B :=
    CFSG.GroupTheory.commutator_zpowers_le_of_forall_mem ha'_normB hKa'
  have hPcomm : ⁅P, Subgroup.zpowers a'⁆ ≤ B :=
    CFSG.GroupTheory.commutator_zpowers_le_of_forall_mem (A := P) (N := B) (c := a')
      ha'_normB (fun x hx => by
        have h2 : ⁅a', x⁆ ∈ B := Subgroup.commutator_le.mp hAO2 a' ha'A x hx
        simpa [commutatorElement_inv] using B.inv_mem h2)
  have hKcomm' : ⁅Subgroup.zpowers a', K⁆ ≤ B := by
    rw [Subgroup.commutator_comm (H₁ := Subgroup.zpowers a') (H₂ := K)]
    exact hKcomm
  have hPcomm' : ⁅Subgroup.zpowers a', P⁆ ≤ B := by
    rw [Subgroup.commutator_comm (H₁ := Subgroup.zpowers a') (H₂ := P)]
    exact hPcomm
  have hsup : ⁅Subgroup.zpowers a', K ⊔ P⁆ ≤ B :=
    CFSG.GroupTheory.commutator_sup_right_le_of_le_normalizer hK_normB hP_normB hKcomm' hPcomm'
  rwa [hJ] at hsup

private theorem r90s7g_mem_of_commutator_chief {G : Type} [Group G] [Finite G]
    {L J A B : Subgroup G} {a' : G}
    (hL_normJ : L ≤ Subgroup.normalizer (J : Set G))
    (hchief : LJChief_890 L J A B)
    (hAJ : ¬ ⁅A, J⁆ ≤ B)
    (hJcomm : ⁅J, Subgroup.zpowers a'⁆ ≤ B)
    (ha'A : a' ∈ A) :
    a' ∈ B := by
  have hpCore_le_J : CFSG.Open.pCoreOf 2 J ≤ J := CFSG.openPCoreOf_le 2 J
  have hKN : J ≤ L ⊔ J := le_sup_right
  have hNK : L ⊔ J ≤ Subgroup.normalizer (J : Set G) :=
    sup_le hL_normJ Subgroup.le_normalizer
  have hR : B < A := lt_of_le_of_ne hchief.le hchief.ne
  have hN₁ : L ⊔ J ≤ Subgroup.normalizer (A : Set G) :=
    sup_le hchief.normA_L hchief.normA_J
  have hN₂ : L ⊔ J ≤ Subgroup.normalizer (B : Set G) :=
    sup_le hchief.normB_L hchief.normB_J
  have hR₁₂ : A ≤ Subgroup.normalizer (B : Set G) :=
    (hchief.le_core.trans hpCore_le_J).trans hchief.normB_J
  have hmin : ∀ X : Subgroup G, B ≤ X → X ≤ A →
      L ⊔ J ≤ Subgroup.normalizer (X : Set G) → X = B ∨ X = A := by
    intro X hBX hXA hNX
    exact hchief.minimal X hBX hXA (le_sup_left.trans hNX) (le_sup_right.trans hNX)
  have hK : ∃ k ∈ J, ∃ r ∈ A, k * r * k⁻¹ * r⁻¹ ∉ B :=
    r90s7g_exists_commutator_not_mem hAJ
  have hrK : ∀ k ∈ J, k * a' * k⁻¹ * a'⁻¹ ∈ B := by
    intro k hk
    have h1 : ⁅k, a'⁆ ∈ B :=
      (Subgroup.commutator_le.mp hJcomm) k hk a' (Subgroup.mem_zpowers a')
    simpa [commutatorElement_def] using h1
  exact CFSG.GroupTheory.mem_of_commutator_mem_of_chief hKN hNK hR hN₁ hN₂ hR₁₂ hmin hK ha'A hrK

theorem r890_step5 : Step5_890 := by
  intro G _ _ D L P J Y n hc h889 A B hchief hAO2 hAJ hJ hW a ha hay
