private theorem r90s7h_isChiefFactorUnder {G : Type} [Group G]
    {L J A B : Subgroup G} (h : LJChief_890 L J A B) :
    CFSG.ABGLocalTools.IsChiefFactorUnder 2 (L ⊔ J) A B := by
  refine ⟨lt_of_le_of_ne h.le h.ne, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact sup_le h.normA_L h.normA_J
  · exact sup_le h.normB_L h.normB_J
  · intro x hx y hy
    have hmem : ⁅x, y⁆ ∈ B := h.comm_le (Subgroup.commutator_mem_commutator hx (h.le hy))
    have hconj : x * y * x⁻¹ = ⁅x, y⁆ * y := by
      rw [commutatorElement_def]; group
    rw [hconj]
    exact mul_mem hmem hy
  · intro x hx y hy
    exact h.comm_le (Subgroup.commutator_mem_commutator hx hy)
  · intro x hx
    exact h.sq_mem x hx
  · intro X hBX hXA hNX
    exact h.minimal X hBX hXA (le_sup_left.trans hNX) (le_sup_right.trans hNX)

private theorem r90s7h_bar2_rep {G : Type} [Group G] [Finite G]
