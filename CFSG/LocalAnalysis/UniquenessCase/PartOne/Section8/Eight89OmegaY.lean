private theorem k89oy_center_bar2_eq_bot {G : Type} [Group G]
    [Finite G] {L : Subgroup G} (hJ : IsSpor (Bar2 L) .J2) :
    Subgroup.center (Bar2 L) = ⊥ :=
  r889_center_eq_bot_of_isSpor_J2 hJ

private theorem k89oy_pRank_eq_of_isSylowOf {G : Type} [Group G] [Finite G] {p : ℕ}
    (hp : p.Prime) {Y S : Subgroup G} (hS : IsSylowOf p S Y) :
    CFSG.Open.pRank p S = CFSG.Open.pRank p Y := by
  obtain ⟨T, hT⟩ := hS.exists_sylow_eq_subgroupOf
  have : Fact p.Prime := ⟨hp⟩
  have hSY : S ≤ Y := hS.le
  have h1 : CFSG.Open.pRank p S = CFSG.Open.pRank p (S.subgroupOf Y) :=
    (CFSG.SectionRank.pRank_eq_pRank_top_subgroup S).trans
      ((CFSG.SectionRank.pRank_top_eq_of_mulEquiv hp.one_lt
          (Subgroup.subgroupOfEquivOfLe hSY).symm).trans
        (CFSG.SectionRank.pRank_eq_pRank_top_subgroup (S.subgroupOf Y)).symm)
  have h2 : CFSG.Open.pRank p (S.subgroupOf Y) = CFSG.Open.pRank p (⊤ : Subgroup ↥Y) := by
    rw [← hT]
    exact (CFSG.SectionRank.pRank_sylow T).1
  rw [h1, h2, CFSG.SectionRank.pRank_eq_pRank_top_subgroup Y]

private theorem k89oy_inf_le_pCoreOf {G : Type} [Group G] [Finite G] {L M : Subgroup G}
    (hZ : Subgroup.center (Bar2 L) = ⊥) :
    L ⊓ CentOverO2 M L ≤ pCoreOf 2 L := by
  intro x hx
  obtain ⟨hxL, hxR⟩ := hx
  have hxT : ∀ l ∈ L, x * l * x⁻¹ * l⁻¹ ∈ pCoreOf 2 L :=
    (CFSG.LocalAnalysis.UniquenessCase.PartTwo.mem_centOverO2_iff.mp hxR).2
  have hcent : (QuotientGroup.mk (⟨x, hxL⟩ : ↥L) : Bar2 L) ∈ Subgroup.center (Bar2 L) := by
    rw [Subgroup.mem_center_iff]
    intro q
    induction q using QuotientGroup.induction_on with
    | H l =>
      rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq_iff_div_mem]
      have hcoe : (((l * ⟨x, hxL⟩) / (⟨x, hxL⟩ * l) : ↥L) : G) =
          (x * l * x⁻¹ * l⁻¹)⁻¹ := by
        simp [div_eq_mul_inv, mul_assoc]
      have hG : (((l * ⟨x, hxL⟩) / (⟨x, hxL⟩ * l) : ↥L) : G) ∈ pCoreOf 2 L := by
        rw [hcoe]
        exact (pCoreOf 2 L).inv_mem (hxT l l.2)
      obtain ⟨p, hp, hpeq⟩ := Subgroup.mem_map.mp hG
      have hp_eq : p = (l * ⟨x, hxL⟩) / (⟨x, hxL⟩ * l) := L.subtype_injective hpeq
      rwa [← hp_eq]
  rw [hZ] at hcent
  have hcore : (⟨x, hxL⟩ : ↥L) ∈ CFSG.pCore 2 ↥L :=
    (QuotientGroup.eq_one_iff _).mp (Subgroup.mem_bot.mp hcent)
  exact Subgroup.mem_map_of_mem (f := L.subtype) (K := CFSG.pCore 2 ↥L) hcore

private theorem k89oy_P_le_sup
    {G : Type} [Group G] [Finite G] (D : Data G) {L P : Subgroup G} (hS : Set880 D L P)
    (hJ2 : IsSpor (Bar2 L) .J2) (hZ : Subgroup.center (Bar2 L) = ⊥)
    (hMnorm : D.M ≤ normalizer (L : Set G)) :
    P ≤ (P ⊓ L) ⊔ (P ⊓ CentOverO2 D.M L) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hPM : P ≤ D.M := hS.sylow.le
  have hPN : P ≤ normalizer (L : Set G) := hPM.trans hMnorm
  let ρ : ↥P →* MulAut (Bar2 L) := (rhoL L).comp (Subgroup.inclusion hPN)
  have hPpg : IsPGroup 3 P := hS.sylow.isPGroup
  have hρrange : IsPGroup 3 ρ.range := by
    rw [MonoidHom.range_eq_map]
    exact (hPpg.to_subgroup (⊤ : Subgroup ↥P)).map ρ
  have hρinner : ρ.range ≤ Inn (Bar2 L) := by
    rintro _ ⟨p, rfl⟩
    refine mem_inner_of_isPGroup_three_of_isSpor_J2 hJ2 ?_
    have hzp : IsPGroup 3 (Subgroup.zpowers p) := hPpg.to_subgroup (Subgroup.zpowers p)
    have hmap := hzp.map ρ
    rwa [MonoidHom.map_zpowers] at hmap
  let Sbar : Subgroup (Bar2 L) :=
    ρ.range.comap (MulAut.conj : Bar2 L →* MulAut (Bar2 L))
  have hSbar_pg : IsPGroup 3 Sbar :=
    hρrange.comap_of_injective _ (CFSG.HardMathSupport.Lang.Triality.conj_injective_of_center_eq_bot hZ)
  have hQbar_le : imBar2 L (P ⊓ L) ≤ Sbar := by
    intro y hy
    rw [Subgroup.mem_comap]
    rw [imBar2] at hy
    obtain ⟨l, hl, hly⟩ := Subgroup.mem_map.mp hy
    have hlL : (l : G) ∈ L := l.2
    have hlQ : (l : G) ∈ P ⊓ L := Subgroup.mem_subgroupOf.mp hl
    have h1 : ρ ⟨(l : G), hlQ.1⟩ = MulAut.conj (QuotientGroup.mk (⟨(l : G), hlL⟩ : ↥L)) := by
      change rhoL L (Subgroup.inclusion hPN ⟨(l : G), hlQ.1⟩) = _
      rw [show Subgroup.inclusion hPN ⟨(l : G), hlQ.1⟩ =
          ⟨(l : G), Subgroup.le_normalizer hlL⟩ from Subtype.ext rfl]
      exact rhoL_inner L (l : G) hlL
    rw [← hly]
    exact ⟨⟨(l : G), hlQ.1⟩, h1⟩
  have hSbar_eq : Sbar = imBar2 L (P ⊓ L) :=
    (isSylowOf_imBar2 (hS.sylow.inf_of_le_normalizer (r889_le_M hS) hMnorm)).eq_of_le
      hQbar_le le_top hSbar_pg
  have hconj_Sbar : Sbar.map (MulAut.conj : Bar2 L →* MulAut (Bar2 L)) = ρ.range := by
    rw [show Sbar = ρ.range.comap (MulAut.conj : Bar2 L →* MulAut (Bar2 L)) from rfl,
      Subgroup.map_comap_eq]
    rw [show (MulAut.conj : Bar2 L →* MulAut (Bar2 L)).range = Inn (Bar2 L) from rfl]
    exact le_antisymm inf_le_right (le_inf hρinner le_rfl)
  intro p hp
  have hpρ : ρ ⟨p, hp⟩ ∈ ρ.range := ⟨⟨p, hp⟩, rfl⟩
  rw [← hconj_Sbar] at hpρ
  obtain ⟨y, hySbar, hy⟩ := Subgroup.mem_map.mp hpρ
  rw [hSbar_eq] at hySbar
  rw [imBar2] at hySbar
  obtain ⟨l, hl, hly⟩ := Subgroup.mem_map.mp hySbar
  have hlL : (l : G) ∈ L := l.2
  have hlQ : (l : G) ∈ P ⊓ L := Subgroup.mem_subgroupOf.mp hl
  have hρl : ρ ⟨(l : G), hlQ.1⟩ = MulAut.conj y := by
    rw [← hly]
    change rhoL L (Subgroup.inclusion hPN ⟨(l : G), hlQ.1⟩) = _
    rw [show Subgroup.inclusion hPN ⟨(l : G), hlQ.1⟩ =
        ⟨(l : G), Subgroup.le_normalizer hlL⟩ from Subtype.ext rfl]
    exact rhoL_inner L (l : G) hlL
  have hρ_eq : ρ ⟨(l : G), hlQ.1⟩ = ρ ⟨p, hp⟩ := hρl.trans hy
  have hker : (⟨(l : G), hlQ.1⟩ : ↥P)⁻¹ * ⟨p, hp⟩ ∈ ρ.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hρ_eq, inv_mul_cancel]
  set z : G := (l : G)⁻¹ * p with hzdef
  have hzP : z ∈ P := P.mul_mem (P.inv_mem hlQ.1) hp
  have hzN : z ∈ normalizer (L : Set G) := hPN hzP
  have hprod : (⟨(l : G), hlQ.1⟩ : ↥P)⁻¹ * ⟨p, hp⟩ = ⟨z, hzP⟩ := by
    apply Subtype.ext
    simp [z]
  have hzρ : rhoL L ⟨z, hzN⟩ = 1 := by
    have h1 : ρ ⟨z, hzP⟩ = 1 := by
      rw [← hprod]
      exact MonoidHom.mem_ker.mp hker
    rwa [show ρ ⟨z, hzP⟩ = rhoL L ⟨z, hzN⟩ from by
      change rhoL L (Subgroup.inclusion hPN ⟨z, hzP⟩) = rhoL L ⟨z, hzN⟩
      rw [show Subgroup.inclusion hPN ⟨z, hzP⟩ = ⟨z, hzN⟩ from Subtype.ext rfl]] at h1
  have hzC : z ∈ CentOverO2 D.M L := by
    rw [CFSG.LocalAnalysis.UniquenessCase.PartTwo.mem_centOverO2_iff]
    refine ⟨hPM hzP, fun m hm => ?_⟩
    exact (rhoL_fix_iff L ⟨z, hzN⟩ ⟨m, hm⟩).mp (by rw [hzρ, MulAut.one_apply])
  have hp_eq : p = (l : G) * z := by simp [z]
  rw [hp_eq]
  exact Subgroup.mul_mem_sup hlQ ⟨hzP, hzC⟩

private theorem k89oy_commute {G : Type} [Group G] [Finite G] (D : Data G) {L P : Subgroup G}
    (hPpg : IsPGroup 3 P) :
    ∀ q ∈ P ⊓ L, ∀ r ∈ P ⊓ CentOverO2 D.M L, q * r = r * q := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  intro q hq r hr
  have hqP : q ∈ P := hq.1
  have hrP : r ∈ P := hr.1
  have hqL : q ∈ L := hq.2
  have hrT : r * q * r⁻¹ * q⁻¹ ∈ pCoreOf 2 L :=
    (CFSG.LocalAnalysis.UniquenessCase.PartTwo.mem_centOverO2_iff.mp hr.2).2 q hqL
  have hcomm : q * r * q⁻¹ * r⁻¹ ∈ pCoreOf 2 L := by
    have := (pCoreOf 2 L).inv_mem hrT
    convert this using 1
    group
  have hmem : q * r * q⁻¹ * r⁻¹ ∈ P ⊓ pCoreOf 2 L :=
    ⟨P.mul_mem (P.mul_mem (P.mul_mem hqP hrP) (P.inv_mem hqP)) (P.inv_mem hrP), hcomm⟩
  have hbot : P ⊓ pCoreOf 2 L = ⊥ :=
    (IsPGroup.disjoint_of_ne 3 2 (by norm_num) P (pCoreOf 2 L) hPpg
      (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 L)).eq_bot
  rw [hbot] at hmem
  have h1 : q * r * q⁻¹ * r⁻¹ = 1 := Subgroup.mem_bot.mp hmem
  calc q * r = (q * r * q⁻¹ * r⁻¹) * (r * q) := by group
    _ = r * q := by rw [h1, one_mul]

private theorem k89oy_disjoint {G : Type} [Group G] [Finite G] (D : Data G) {L P : Subgroup G}
    (hZ : Subgroup.center (Bar2 L) = ⊥) (hPpg : IsPGroup 3 P) :
    (P ⊓ L) ⊓ (P ⊓ CentOverO2 D.M L) = ⊥ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hbot : P ⊓ pCoreOf 2 L = ⊥ :=
    (IsPGroup.disjoint_of_ne 3 2 (by norm_num) P (pCoreOf 2 L) hPpg
      (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 L)).eq_bot
  rw [eq_bot_iff]
  intro x hx
  have hxO : x ∈ pCoreOf 2 L := k89oy_inf_le_pCoreOf (M := D.M) hZ ⟨hx.1.2, hx.2.2⟩
  have : x ∈ P ⊓ pCoreOf 2 L := ⟨hx.1.1, hxO⟩
  rw [hbot] at this
  exact this

private theorem k89oy_R3_cyclic {G : Type} [Group G] [Finite G] (D : Data G) {L P : Subgroup G}
    (hPpg : IsPGroup 3 P) (hPrank : CFSG.Open.pRank 3 P ≤ 3)
    (hQ2 : CFSG.Open.pRank 3 (P ⊓ L) = 2)
    (hcomm : ∀ q ∈ P ⊓ L, ∀ r ∈ P ⊓ CentOverO2 D.M L, q * r = r * q)
    (hdisj : (P ⊓ L) ⊓ (P ⊓ CentOverO2 D.M L) = ⊥) :
    IsCyclic ↥(P ⊓ CentOverO2 D.M L) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set Q : Subgroup G := P ⊓ L with hQ
  set R : Subgroup G := P ⊓ CentOverO2 D.M L with hR
  have hRpg : IsPGroup 3 R := hPpg.to_le inf_le_left
  by_contra hcyc
  have hR2 : 2 ≤ CFSG.Open.pRank 3 R := by
    by_contra h
    exact hcyc (CFSG.isCyclic_of_le_of_pRank_le_one Nat.prime_three (by norm_num) hRpg
      le_rfl (by omega))
  obtain ⟨E, hER, hEel, hEcard⟩ := CFSG.SectionRank.exists_pRank (p := 3) (by norm_num) R
  obtain ⟨E', hE'Q, hE'el, hE'card⟩ := CFSG.SectionRank.exists_pRank (p := 3) (by norm_num) Q
  have hE'card' : Nat.card E' = 9 := by rw [hE'card, hQ2]; norm_num
  have hcommEE' : ∀ e ∈ E, ∀ e' ∈ E', e * e' = e' * e := fun e he e' he' =>
    (hcomm e' (hE'Q he') e (hER he)).symm
  have hdisjEE' : E ⊓ E' = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    rw [← hdisj]
    exact ⟨hE'Q hx.2, hER hx.1⟩
  have hEsupel : IsElemAbelian 3 (E ⊔ E') := hEel.sup_of_commute hE'el hcommEE'
  have hEsupcard : Nat.card ↥(E ⊔ E') = 3 ^ (CFSG.Open.pRank 3 R + 2) := by
    rw [CFSG.card_sup_eq_mul_of_commute E E' hcommEE' hdisjEE', hEcard, hE'card, hQ2,
      ← pow_add]
  have hEsupP : E ⊔ E' ≤ P :=
    sup_le (hER.trans inf_le_left) (hE'Q.trans inf_le_left)
  have hle := CFSG.SectionRank.le_pRank (p := 3) (by norm_num) hEsupP hEsupel hEsupcard
  omega

theorem s889_y
    {G : Type} [Group G] [Finite G] (D : Data G) (hrank : Rank889 D) (h869N : R869N D)
    (h881 : R881 D) (h882 : R882 D) (h885 : R885 D) (h886 : R886 D) (h888 : R888 D) :
    ∀ L P : Subgroup G, Set880 D L P → ¬ P ≤ L → ∃ Y : Subgroup G, Y889 D L P Y := by
  intro L P hS hPL
  classical
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hJ2 : IsSpor (Bar2 L) .J2 := (h885 L P hS).1
  have hZcard : Nat.card (ZOf (P ⊓ L)) = 3 := (h886 L P hS).1
  have hZmem : ZOf (P ⊓ L) ∈ uniqueSet D.M := h888 L P hS
  have hLM : L ≤ D.M := r889_le_M hS
  have hMnorm : D.M ≤ normalizer (L : Set G) := r889_normalizes_of_inputs h882 h885 hS
  have hLrank : CFSG.Open.pRank 3 L = 2 := h881 L P hS
  have hQsyl : IsSylowOf 3 (P ⊓ L) L := hS.sylow.inf_of_le_normalizer hLM hMnorm
  have hQrank : CFSG.Open.pRank 3 (P ⊓ L) = 2 := by
    rw [k89oy_pRank_eq_of_isSylowOf Nat.prime_three hQsyl, hLrank]
  have hPpg : IsPGroup 3 P := hS.sylow.isPGroup
  have hPrank : CFSG.Open.pRank 3 P ≤ 3 :=
    (CFSG.SectionRank.pRank_mono (by norm_num) hS.sylow.le).trans
      (hrank L P hS D.M D.maxLocal.1).1
  have hZbot : Subgroup.center (Bar2 L) = ⊥ := k89oy_center_bar2_eq_bot hJ2
  have hPsup : P ≤ (P ⊓ L) ⊔ (P ⊓ CentOverO2 D.M L) :=
    k89oy_P_le_sup D hS hJ2 hZbot hMnorm
  have hcomm : ∀ q ∈ P ⊓ L, ∀ r ∈ P ⊓ CentOverO2 D.M L, q * r = r * q :=
    k89oy_commute D hPpg
  have hdisj : (P ⊓ L) ⊓ (P ⊓ CentOverO2 D.M L) = ⊥ :=
    k89oy_disjoint D hZbot hPpg
  have hcycR : IsCyclic ↥(P ⊓ CentOverO2 D.M L) :=
    k89oy_R3_cyclic D hPpg hPrank hQrank hcomm hdisj
  have hP_eq : P = (P ⊓ L) ⊔ (P ⊓ CentOverO2 D.M L) :=
    le_antisymm hPsup (sup_le inf_le_left inf_le_left)
  have hRne : (P ⊓ CentOverO2 D.M L) ≠ ⊥ := by
    intro hbot
    apply hPL
    rw [hP_eq, hbot, sup_bot_eq]
    exact inf_le_right
  have hRcomm : ∀ a b : ↥(P ⊓ CentOverO2 D.M L), a * b = b * a := by
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := ↥(P ⊓ CentOverO2 D.M L))
    intro a b
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hg a)
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hg b)
    rw [← hm, ← hk, ← zpow_add, ← zpow_add, add_comm]
  have hRpg : IsPGroup 3 ↥(P ⊓ CentOverO2 D.M L) := IsPGroup.to_inf_left hPpg
  have h3dvd : 3 ∣ Nat.card ↥(P ⊓ CentOverO2 D.M L) := by
    obtain ⟨n, hn⟩ : ∃ n, Nat.card ↥(P ⊓ CentOverO2 D.M L) = 3 ^ n := hRpg.exists_card_eq
    by_cases hn0 : n = 0
    · have h1 : Nat.card ↥(P ⊓ CentOverO2 D.M L) = 1 := by rw [hn, hn0, pow_zero]
      exact absurd (Subgroup.eq_bot_of_card_eq (H := P ⊓ CentOverO2 D.M L) h1) hRne
    · rw [hn]
      exact dvd_pow_self 3 (by omega)
  obtain ⟨y, hyord⟩ := exists_prime_orderOf_dvd_card' (G := ↥(P ⊓ CentOverO2 D.M L)) 3 h3dvd
  have hyR : (y : G) ∈ P ⊓ CentOverO2 D.M L := y.2
  have hyord' : orderOf (y : G) = 3 := by rw [Subgroup.orderOf_coe, hyord]
  set Y : Subgroup G := Subgroup.zpowers (y : G) with hYdef
  have hYcard : Nat.card Y = 3 := by rw [hYdef, Nat.card_zpowers, hyord']
  have hYP : Y ≤ P := Subgroup.zpowers_le.mpr hyR.1
  have hYR : Y ≤ P ⊓ CentOverO2 D.M L := Subgroup.zpowers_le.mpr hyR
  have hRcentQ : P ⊓ CentOverO2 D.M L ≤ centralizer ((P ⊓ L : Subgroup G) : Set G) := by
    intro r hr
    rw [Subgroup.mem_centralizer_iff]
    intro q hq
    exact hcomm q hq r hr
  have hQcentZ : P ⊓ L ≤ centralizer (ZOf (P ⊓ L) : Set G) :=
    Subgroup.le_centralizer_iff.mp (inf_le_right : ZOf (P ⊓ L) ≤ centralizer ((P ⊓ L : Subgroup G) : Set G))
  have hRcentZ : P ⊓ CentOverO2 D.M L ≤ centralizer (ZOf (P ⊓ L) : Set G) :=
    hRcentQ.trans (Subgroup.centralizer_le (inf_le_left : ZOf (P ⊓ L) ≤ P ⊓ L))
  have hQnormZ : P ⊓ L ≤ normalizer (ZOf (P ⊓ L) : Set G) :=
    hQcentZ.trans (Subgroup.centralizer_le_normalizer _)
  have hRnormZ : P ⊓ CentOverO2 D.M L ≤ normalizer (ZOf (P ⊓ L) : Set G) :=
    hRcentZ.trans (Subgroup.centralizer_le_normalizer _)
  have hPnormQR : ((P ⊓ L) ⊔ (P ⊓ CentOverO2 D.M L) : Subgroup G) ≤
      normalizer (ZOf (P ⊓ L) : Set G) := sup_le hQnormZ hRnormZ
  have hPnormZ : P ≤ normalizer (ZOf (P ⊓ L) : Set G) := by
    conv_lhs => rw [hP_eq]
    exact hPnormQR
  have hZcentQR : ZOf (P ⊓ L) ≤
      centralizer (((P ⊓ L) ⊔ (P ⊓ CentOverO2 D.M L) : Subgroup G) : Set G) :=
    Subgroup.le_centralizer_iff.mpr (sup_le
      (Subgroup.le_centralizer_iff.mp (inf_le_right :
        ZOf (P ⊓ L) ≤ centralizer ((P ⊓ L : Subgroup G) : Set G)))
      hRcentZ)
  have hZcentP : ZOf (P ⊓ L) ≤ centralizer (P : Set G) := by
    conv_rhs => rw [hP_eq]
    exact hZcentQR
  have hYcentP : Y ≤ centralizer (P : Set G) := by
    rw [hP_eq]
    have hYcentQ : Y ≤ centralizer ((P ⊓ L : Subgroup G) : Set G) :=
      Subgroup.zpowers_le.mpr (Subgroup.mem_centralizer_iff.mpr (fun q hq => hcomm q hq (y : G) hyR))
    have hYcentR : Y ≤ centralizer ((P ⊓ CentOverO2 D.M L : Subgroup G) : Set G) :=
      Subgroup.zpowers_le.mpr (Subgroup.mem_centralizer_iff.mpr
        (fun r hr => congrArg Subtype.val (hRcomm ⟨(y : G), hyR⟩ ⟨r, hr⟩).symm))
    exact Subgroup.le_centralizer_iff.mpr
      (sup_le (Subgroup.le_centralizer_iff.mp hYcentQ) (Subgroup.le_centralizer_iff.mp hYcentR))
  have hYmem : Y ≤ P ⊓ centralizer (P : Set G) := le_inf hYP hYcentP
  have hRL : (P ⊓ CentOverO2 D.M L) ⊓ L = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    have : x ∈ (P ⊓ L) ⊓ (P ⊓ CentOverO2 D.M L) := ⟨⟨hx.1.1, hx.2⟩, hx.1⟩
    rw [hdisj] at this
    exact this
  have hYdisj : Disjoint Y L := by
    rw [disjoint_iff]
    apply le_bot_iff.mp
    refine le_trans (inf_le_inf_right L hYR) ?_
    rw [hRL]
  have hYpg : IsPGroup 3 Y := IsPGroup.of_card (n := 1) (by rw [hYcard]; norm_num)
  have hN3 : ¬ 3 ∣ Nat.card ↥(pCoreOf 2 L) := by
    obtain ⟨m, hm⟩ := (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 L).exists_card_eq
    rw [hm]
    intro h
    have : 3 ∣ 2 := Nat.Prime.dvd_of_dvd_pow Nat.prime_three h
    norm_num at this
  have hcommLY : ⁅L, Y⁆ ≤ pCoreOf 2 L := by
    rw [Subgroup.commutator_le]
    intro l hl y' hy'
    have hy'C : y' ∈ CentOverO2 D.M L := (Subgroup.zpowers_le.mpr hyR.2) hy'
    have hyl : y' * l * y'⁻¹ * l⁻¹ ∈ pCoreOf 2 L :=
      (CFSG.LocalAnalysis.UniquenessCase.PartTwo.mem_centOverO2_iff.mp hy'C).2 l hl
    have hinv := (pCoreOf 2 L).inv_mem hyl
    have hcommut : ⁅l, y'⁆ = (y' * l * y'⁻¹ * l⁻¹)⁻¹ := by
      rw [commutatorElement_def]; group
    rwa [hcommut]
  have hcover : (L ⊓ centralizer (Y : Set G)) ⊔ pCoreOf 2 L = L :=
    CFSG.GroupTheory.inf_centralizer_sup_eq_of_commutator_le (p := 3)
      (CFSG.LieType.BorelTits.pCoreOf_le 2 L)
      (hYP.trans (hS.sylow.le.trans hMnorm))
      ((hYP.trans (hS.sylow.le.trans hMnorm)).trans
        (CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf 2 L))
      hYpg hN3 hcommLY
  have hYnorm : normalizer (Y : Set G) ≤ D.M :=
    h869N L hLM hMnorm (isProdOfCalC_of_mem hS.mem) (r889_not_thin_of_r881 h881 hS)
      3 Nat.prime_three (by norm_num) Y (hYP.trans hS.sylow.le) (by rw [hYcard]) hcover
  have hnormP : normalizer (P : Set G) ≤ D.M :=
    r889_normalizer_le_of_le_normalizer D.maxLocal hZmem (inf_le_left.trans inf_le_left) hPnormZ
  have hZYnorm : normalizer ((ZOf (P ⊓ L) ⊔ Y : Subgroup G) : Set G) ≤ D.M := by
    refine r889_normalizer_le_of_le_normalizer D.maxLocal hZmem le_sup_left ?_
    apply sup_le
    · exact Subgroup.le_normalizer
    · exact hYcentP.trans ((Subgroup.centralizer_le (inf_le_left.trans inf_le_left :
        ZOf (P ⊓ L) ≤ P)).trans (Subgroup.centralizer_le_normalizer _))
  have hsylow3 : IsSylowOf 3 P ⊤ := by
    obtain ⟨S, hPS⟩ : ∃ Q : Sylow 3 G, P ≤ Q := IsPGroup.exists_le_sylow (p := 3) hPpg
    have hSP : (S : Subgroup G) ≤ P := by
      by_contra hSP
      have hlt : P < (S : Subgroup G) := lt_of_le_of_ne hPS (fun h => hSP (le_of_eq h.symm))
      obtain ⟨x, hxS, hxN, hxP⟩ := r889_exists_mem_normalizer_of_lt S.isPGroup' hlt
      have hxM : x ∈ D.M := hnormP hxN
      have hxpg : IsPGroup 3 (Subgroup.zpowers x) :=
        S.isPGroup'.to_le (Subgroup.zpowers_le.mpr hxS)
      have hsuppg : IsPGroup 3 ↥(Subgroup.zpowers x ⊔ P) :=
        r889_isPGroup_sup hxpg hPpg (Subgroup.zpowers_le.mpr hxN)
      have hsupM : Subgroup.zpowers x ⊔ P ≤ D.M :=
        sup_le (Subgroup.zpowers_le.mpr hxM) hS.sylow.le
      have heq : Subgroup.zpowers x ⊔ P = P :=
        IsSylowOf.eq_of_le hS.sylow le_sup_right hsupM hsuppg
      exact hxP (heq ▸ Subgroup.mem_sup_left (Subgroup.mem_zpowers x))
    have hSPeq : (S : Subgroup G) = P := le_antisymm hSP hPS
    rw [← hSPeq]
    exact CFSG.ABGLocalTools.isSylowOf_of_card le_top
      (by rw [Sylow.card_eq_multiplicity, Subgroup.card_top])
  exact ⟨Y, hYcard, hYmem, hZcentP, hYR.trans inf_le_right, hYdisj, hYnorm, hZYnorm,
    hsylow3, hnormP⟩

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8
