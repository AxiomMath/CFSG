open CFSG.ABGLocalTools (IsSylowOf)
open CFSG.LocalAnalysis.UniquenessCase.UC22.F08 (IsSU5)

private theorem isPGroup_of_isSylowOf {X : Type} [Group X] [Finite X] {Q : Subgroup X}
    (hQ : IsSylowOf 3 Q ⊤) : IsPGroup 3 Q :=
  (CFSG.ABGLocalTools.isSylowOf_iff.mp hQ).2.1

private noncomputable def toSylow {X : Type} [Group X] [Finite X] {Q : Subgroup X}
    (hQ : IsSylowOf 3 Q ⊤) : Sylow 3 X :=
  (isPGroup_of_isSylowOf hQ).toSylow (by
    simpa [Subgroup.relIndex_top_right] using (CFSG.ABGLocalTools.isSylowOf_iff.mp hQ).2.2)

private theorem rank_le_two_of_sylow_comm {X : Type} [Group X] [Finite X]
    (hc : ∀ S : Sylow 3 X, IsMulCommutative (S : Subgroup X))
    (hr : CFSG.Open.pRank 3 (⊤ : Subgroup X) ≤ 2) {Q : Subgroup X} (hQ : IsSylowOf 3 Q ⊤) :
    Group.rank ↥Q ≤ 2 := by
  have hS : ((toSylow hQ : Sylow 3 X) : Subgroup X) = Q := IsPGroup.toSylow_coe _ _
  have hcQ := hc (toSylow hQ)
  rw [hS] at hcQ
  exact rank_le_two_of_comm (isPGroup_of_isSylowOf hQ)
    (fun a b => (hcQ.is_comm.comm a b)) ((pRank_top_le Q).trans hr)

private theorem rank_le_two_of_not_dvd {X : Type} [Group X] [Finite X] (h81 : ¬ 81 ∣ Nat.card X)
    (hr : CFSG.Open.pRank 3 (⊤ : Subgroup X) ≤ 2) {Q : Subgroup X} (hQ : IsSylowOf 3 Q ⊤) :
    Group.rank ↥Q ≤ 2 := by
  obtain ⟨k, hk⟩ := (IsPGroup.iff_card).mp (isPGroup_of_isSylowOf hQ)
  have hdvd : 3 ^ k ∣ Nat.card X := hk ▸ Subgroup.card_subgroup_dvd_card Q
  have hk3 : k ≤ 3 := by
    by_contra hlt
    exact h81 ((Nat.pow_dvd_pow 3 (by omega : 4 ≤ k)).trans hdvd)
  exact rank_le_two_of_card_dvd_cube (hk ▸ Nat.pow_dvd_pow 3 hk3)
    ((pRank_top_le Q).trans hr)

private theorem sylow_comm_of_quotient {X : Type} [Group X] [Finite X] {p : ℕ} [Fact p.Prime]
    (Z : Subgroup X) [Z.Normal] (hZ : ¬ p ∣ Nat.card Z)
    (h : ∀ S : Sylow p (X ⧸ Z), IsMulCommutative (S : Subgroup (X ⧸ Z))) :
    ∀ S : Sylow p X, IsMulCommutative (S : Subgroup X) := by
  intro S
  refine ⟨⟨fun a b => Subtype.ext ?_⟩⟩
  set c : X := (a : X) * b * (a : X)⁻¹ * (b : X)⁻¹ with hc
  have hcS : c ∈ (S : Subgroup X) := by
    have := a.2; have := b.2
    exact mul_mem (mul_mem (mul_mem a.2 b.2) (inv_mem a.2)) (inv_mem b.2)
  have hcZ : c ∈ Z := by
    have hmap : IsPGroup p ((S : Subgroup X).map (QuotientGroup.mk' Z)) :=
      S.isPGroup'.map _
    obtain ⟨T, hT⟩ := hmap.exists_le_sylow
    have hT' := h T
    have ha : QuotientGroup.mk' Z (a : X) ∈ (T : Subgroup (X ⧸ Z)) := hT ⟨a, a.2, rfl⟩
    have hb : QuotientGroup.mk' Z (b : X) ∈ (T : Subgroup (X ⧸ Z)) := hT ⟨b, b.2, rfl⟩
    have hab := congrArg Subtype.val (hT'.is_comm.comm ⟨_, ha⟩ ⟨_, hb⟩)
    have hab' : ((a : X) : X ⧸ Z) * ((b : X) : X ⧸ Z) = ((b : X) : X ⧸ Z) * ((a : X) : X ⧸ Z) :=
      hab
    rw [← QuotientGroup.eq_one_iff, hc, QuotientGroup.mk_mul, QuotientGroup.mk_mul,
      QuotientGroup.mk_mul, QuotientGroup.mk_inv, QuotientGroup.mk_inv, hab']
    group
  have hc1 : c = 1 := by
    obtain ⟨k, hk⟩ := (S.isPGroup') ⟨c, hcS⟩
    have h1 : orderOf c ∣ p ^ k := by
      rw [orderOf_dvd_iff_pow_eq_one]
      exact congrArg Subtype.val hk
    have h2 : orderOf c ∣ Nat.card Z := by
      have h := orderOf_dvd_natCard (⟨c, hcZ⟩ : Z)
      rw [← Subgroup.orderOf_coe] at h
      exact h
    have hcop : Nat.Coprime (p ^ k) (Nat.card Z) :=
      Nat.Coprime.pow_left _ ((Nat.coprime_comm.mp ((Nat.Prime.coprime_iff_not_dvd Fact.out).mpr hZ)).symm)
    exact orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_coprimes hcop h1 h2)
  have : (a : X) * b = b * a := by
    have := hc1
    rw [hc] at this
    calc (a : X) * b = c * (b * a) := by rw [hc]; group
      _ = b * a := by rw [hc1, one_mul]
  exact this

private theorem sylow_comm_of_isSp4 {X : Type} [Group X] [Finite X] {n : ℕ}
    (h : LieModel X .PSp 2 2 n) : ∀ S : Sylow 3 X, IsMulCommutative (S : Subgroup X) := by
  obtain ⟨-, F, _, _, hF, ⟨e⟩⟩ := h.statedClassicalModel_of_ne_zero (by norm_num)
  have hF3 : ¬ 3 ∣ Nat.card F := by
    rw [hF]
    intro h3
    exact absurd (Nat.Prime.dvd_of_dvd_pow Nat.prime_three h3) (by norm_num)
  have : Finite (CFSG.Open.StatedProj (CFSG.Open.StatedSp 2 F)) := Finite.of_equiv X e.toEquiv
  exact CFSG.LocalAnalysis.RankThreeTheoremC.WeakClosureHeis.sylow_comm_of_surjective
    e.symm.toMonoidHom e.symm.surjective
    (CFSG.LocalAnalysis.RankThreeTheoremC.KFactProofs.T29.Parrott.sylow_comm_projSp_two hF3)

private theorem rank_sylow_three_le_two_of_isSp4 {X : Type} [Group X] [Finite X] {n : ℕ}
    (h : LieModel X .PSp 2 2 n) (hr : CFSG.Open.pRank 3 (⊤ : Subgroup X) ≤ 2) {Q : Subgroup X}
    (hQ : IsSylowOf 3 Q ⊤) : Group.rank ↥Q ≤ 2 :=
  rank_le_two_of_sylow_comm (sylow_comm_of_isSp4 h) hr hQ

private theorem sylow_three_comm_of_isSU5_even
    {X : Type} [Group X] [Finite X] {m : ℕ} (h : IsSU5 X m)
    (hm : Even m) : ∀ S : Sylow 3 X, IsMulCommutative (S : Subgroup X) := by
  refine sylow_comm_of_quotient (center X) (not_three_dvd_card_center_of_isSU5 h) ?_
  have hU : LieModel (X ⧸ center X) .PSU 5 2 m := h.2
  obtain ⟨-, L, _, _, hL, ⟨e⟩⟩ := hU.statedClassicalModel_of_ne_zero (by norm_num)
  have hq3 : ¬ 3 ∣ 2 ^ m := fun h3 =>
    absurd (Nat.Prime.dvd_of_dvd_pow Nat.prime_three h3) (by norm_num)
  have hq1 : 2 ^ m % 3 = 1 := by
    obtain ⟨k, rfl⟩ := hm
    rw [← two_mul, pow_mul, Nat.pow_mod]
    norm_num
  have hlt : 5 / orderOf (-((2 ^ m : ℕ) : ZMod 3)) < 3 := by
    have h2 : (-((2 ^ m : ℕ) : ZMod 3)) = ((2 : ℕ) : ZMod 3) := by
      rw [← ZMod.natCast_mod, hq1]; decide
    rw [h2, CFSG.LocalAnalysis.RankThreeTheoremC.A6.I1435Chev.orderOf_card_zmod_three (by norm_num)]
    norm_num
  have : Finite (CFSG.Open.StatedProj (CFSG.Open.StatedSU 5 (2 ^ m) L)) :=
    Finite.of_equiv _ e.toEquiv
  exact CFSG.LocalAnalysis.RankThreeTheoremC.WeakClosureHeis.sylow_comm_of_surjective
    e.symm.toMonoidHom e.symm.surjective
    (CFSG.LocalAnalysis.RankThreeTheoremC.KFactProofs.T29.Parrott.sylow_comm_projSU hL hq3
      (by norm_num) hlt)

private theorem three_le_pRank_three_of_isSU5_odd
    {X : Type} [Group X] [Finite X] {m : ℕ} (h : IsSU5 X m)
    (hm : Odd m) : 3 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup X) := by
  have hU : LieModel (X ⧸ center X) .PSU 5 2 m := h.2
  obtain ⟨-, F, _, _, hcard, ⟨e⟩⟩ := hU.statedClassicalModel_of_ne_zero (by norm_num)
  have h3 : 3 ∣ 2 ^ m + 1 := by
    obtain ⟨k, rfl⟩ := hm
    apply Nat.dvd_of_mod_eq_zero
    rw [Nat.add_mod, pow_succ, pow_mul, Nat.mul_mod, Nat.pow_mod]
    norm_num
  set H : Subgroup (GL (Fin 5) F) := CFSG.Open.StatedSU 5 (2 ^ m) F with hH
  set D : Subgroup H := (CFSG.Open.StatedScalars (Fin 5) F).subgroupOf H with hD
  have hTor := (CFSG.SectionRank.OddCover.scalar_quotient_diagonal_torus_rank (K := F) (p := 2)
    (f := m) (n := 5) (r := 3) Nat.prime_two (by norm_num) (by norm_num)
    (Or.inr ⟨hcard, rfl, h3⟩) D le_rfl).1
  have : Finite (CFSG.Open.StatedProj H) := Finite.of_equiv _ e.toEquiv
  rw [← CFSG.SectionRank.pRank_quotient_eq (center X) (not_three_dvd_card_center_of_isSU5 h),
    CFSG.SectionRank.pRank_top_eq_of_mulEquiv (by norm_num) e]
  simpa using hTor

end

