open CFSG.ABGLocalTools (IsSylowOf)

private theorem rank_le_two_of_comm {G : Type} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hG : IsPGroup p G) (hc : ∀ a b : G, a * b = b * a)
    (hr : CFSG.Open.pRank p (⊤ : Subgroup G) ≤ 2) : Group.rank G ≤ 2 := by
  have : IsMulCommutative G := ⟨⟨hc⟩⟩
  have : Fact (IsPGroup p G) := ⟨hG⟩
  have hcard : Nat.card (CFSG.omega₁ (G := G) (p := p)) = p ^ CFSG.generatorRank G :=
    CFSG.omega₁_card_eq_pow_generatorRank_of_commutative_pgroup (p := p) G
  have hΩelem : CFSG.IsElementaryAbelian p (CFSG.omega₁ (G := G) (p := p)) :=
    CFSG.IsElementaryAbelian.omega₁_of_isMulCommutative G
  have hE : CFSG.Open.IsElemAbelian p (CFSG.omega₁ (G := G) (p := p)) := by
    refine ⟨⟨⟨fun x y => Subtype.ext (hc x y)⟩⟩, fun x hx => ?_⟩
    exact CFSG.elemPow_eq_one_of_isElementaryAbelian (p := p)
      (A := CFSG.omega₁ (G := G) (p := p)) x hx
  have hle := CFSG.HardMathSupport.Solomon.Coordinator.le_pRank_of_elemAbelian
    (Fact.out : p.Prime).one_lt le_top hE hcard
  rw [← CFSG.generatorRank_eq_group_rank]
  omega

private theorem comm_of_card_le_sq {H : Type} [Group H] {p j : ℕ} [hp : Fact p.Prime]
    (hH : Nat.card H = p ^ j) (hj : j ≤ 2) : ∀ a b : H, a * b = b * a := by
  interval_cases j
  · have : Subsingleton H := (Nat.card_eq_one_iff_unique.mp (by simpa using hH)).1
    intro a b; exact Subsingleton.elim _ _
  · have : IsCyclic H := isCyclic_of_prime_card (by simpa using hH)
    have : IsMulCommutative H := IsCyclic.commutative
    intro a b; exact (IsMulCommutative.is_comm (M := H)).comm a b
  · exact IsPGroup.commutative_of_card_eq_prime_sq hH

private theorem rank_le_two_of_card_dvd_cube {G : Type} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (hcard : Nat.card G ∣ p ^ 3) (hr : CFSG.Open.pRank p (⊤ : Subgroup G) ≤ 2) :
    Group.rank G ≤ 2 := by
  classical
  obtain ⟨k, hk3, hk⟩ := (Nat.dvd_prime_pow Fact.out).mp hcard
  by_cases hc : ∀ a b : G, a * b = b * a
  · exact rank_le_two_of_comm (IsPGroup.of_card hk) hc hr
  · push Not at hc
    obtain ⟨x, y, hxy⟩ := hc
    set H := Subgroup.closure ({x, y} : Set G) with hH
    obtain ⟨j, hjk, hj⟩ : ∃ j ≤ k, Nat.card H = p ^ j :=
      (Nat.dvd_prime_pow Fact.out).mp (hk ▸ Subgroup.card_subgroup_dvd_card H)
    have hj3 : 3 ≤ j := by
      by_contra hlt
      have hcomm := comm_of_card_le_sq hj (by omega)
      have hx : x ∈ H := Subgroup.subset_closure (by simp)
      have hy : y ∈ H := Subgroup.subset_closure (by simp)
      exact hxy (congrArg Subtype.val (hcomm ⟨x, hx⟩ ⟨y, hy⟩))
    have htop : H = ⊤ := Subgroup.eq_top_of_card_eq H (by rw [hj, hk]; congr 1; omega)
    have hcl : Subgroup.closure (({x, y} : Finset G) : Set G) = ⊤ := by
      rw [Finset.coe_pair]; exact htop
    exact (Group.rank_le hcl).trans Finset.card_le_two

private theorem pRank_top_le {X : Type} [Group X] [Finite X] {p : ℕ} [Fact p.Prime] (Q : Subgroup X) :
    CFSG.Open.pRank p (⊤ : Subgroup ↥Q) ≤ CFSG.Open.pRank p (⊤ : Subgroup X) := by
  rw [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup Q, ← CFSG.SectionRank.pRank_coe_eq_openPRank]
  exact CFSG.RankThree.PartTwo.Sec4.Census.pRank_le_pRank_top Fact.out Q

