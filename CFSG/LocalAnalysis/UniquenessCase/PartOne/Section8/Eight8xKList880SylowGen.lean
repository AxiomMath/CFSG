open Subgroup
open scoped MatrixGroups Pointwise

private def dgFun {K : Type} [Field K] (ab : Kˣ × Kˣ) : SL(3, K) :=
  ⟨Matrix.diagonal ![(ab.1 : K), ab.2, ((ab.1 * ab.2)⁻¹ : Kˣ)], by
    have h : (ab.1 : K) * ab.2 * ((ab.1 * ab.2)⁻¹ : Kˣ) = 1 := by
      rw [← Units.val_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one]
    rw [Matrix.det_diagonal, Fin.prod_univ_three]
    simpa using h⟩

private theorem dgFun_coe
    {K : Type} [Field K]
    (ab : Kˣ × Kˣ) : ((dgFun ab : SL(3, K)) : Matrix (Fin 3) (Fin 3) K) =
    Matrix.diagonal ![(ab.1 : K), ab.2, ((ab.1 * ab.2)⁻¹ : Kˣ)] := rfl

private def dg {K : Type} [Field K] : Kˣ × Kˣ →* SL(3, K) where
  toFun := dgFun
  map_one' := by
    apply Subtype.ext
    rw [dgFun_coe, Matrix.SpecialLinearGroup.coe_one]
    ext i j
    fin_cases i <;> fin_cases j <;> simp
  map_mul' a b := by
    apply Subtype.ext
    rw [Matrix.SpecialLinearGroup.coe_mul, dgFun_coe, dgFun_coe, dgFun_coe,
      Matrix.diagonal_mul_diagonal]
    congr 1
    funext i
    have h3 : ((a * b).1 * (a * b).2)⁻¹ = (a.1 * a.2)⁻¹ * (b.1 * b.2)⁻¹ := by
      rw [Prod.fst_mul, Prod.snd_mul, ← mul_inv, mul_mul_mul_comm]
    fin_cases i
    · simp
    · simp
    · simp only [Fin.reduceFinMk, Matrix.cons_val]
      rw [h3, Units.val_mul]

private theorem dg_coe
    {K : Type} [Field K]
    (ab : Kˣ × Kˣ) : ((dg ab : SL(3, K)) : Matrix (Fin 3) (Fin 3) K) =
    Matrix.diagonal ![(ab.1 : K), ab.2, ((ab.1 * ab.2)⁻¹ : Kˣ)] := rfl

private theorem dg_injective {K : Type} [Field K] : Function.Injective (dg (K := K)) := by
  refine (injective_iff_map_eq_one _).mpr fun ab h => ?_
  have h00 := congrFun (congrFun (congrArg Subtype.val h) 0) 0
  have h11 := congrFun (congrFun (congrArg Subtype.val h) 1) 1
  rw [dg_coe] at h00 h11
  simp at h00 h11
  exact Prod.ext h00 h11

private def pm
    {K : Type} [Field K]
    : SL(3, K) := ⟨!![0, 1, 0; 0, 0, 1; 1, 0, 0], by simp [Matrix.det_fin_three]⟩

private theorem pm_mul_dg
    {K : Type} [Field K]
    (α β : Kˣ) : pm * dg (α, β) = dg (β, (α * β)⁻¹) * pm := by
  have hu : (β * (α * β)⁻¹)⁻¹ = α := by group
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, dg_coe, dg_coe]
  simp only [hu]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [pm, Matrix.mul_apply, Matrix.diagonal_apply]

private theorem pm_conj_dg
    {K : Type} [Field K]
    (α β : Kˣ) : pm * dg (α, β) * pm⁻¹ = dg (β, (α * β)⁻¹) := by
  rw [pm_mul_dg, mul_inv_cancel_right]

private theorem pm_pow_three {K : Type} [Field K] : (pm : SL(3, K)) ^ 3 = 1 := by
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_pow, Matrix.SpecialLinearGroup.coe_one]
  simp [pm, pow_succ, Matrix.one_fin_three]

private theorem pm_not_mem_range {K : Type} [Field K] : (pm : SL(3, K)) ∉ (dg (K := K)).range := by
  rintro ⟨ab, h⟩
  have h01 := congrFun (congrFun (congrArg Subtype.val h) 0) 1
  rw [dg_coe] at h01
  simp [pm] at h01

private theorem pm_ne_one {K : Type} [Field K] : (pm : SL(3, K)) ≠ 1 := fun h =>
  pm_not_mem_range (h ▸ (dg (K := K)).range.one_mem)

private theorem orderOf_pm
    {K : Type} [Field K]
    : orderOf (pm : SL(3, K)) = 3 := orderOf_eq_prime pm_pow_three pm_ne_one

private theorem card_sup_of_le_normalizer {G : Type*} [Group G] [Finite G] (A C : Subgroup G)
    (hC : C ≤ normalizer (A : Set G)) (hAC : A ⊓ C = ⊥) :
    Nat.card ↥(A ⊔ C) = Nat.card A * Nat.card C := by
  classical
  have hset : ((A ⊔ C : Subgroup G) : Set G) = (A : Set G) * (C : Set G) :=
    Subgroup.coe_mul_of_right_le_normalizer_left A C hC
  let f : A × C → ↥(A ⊔ C) := fun ac => ⟨ac.1 * ac.2, by
    rw [← SetLike.mem_coe, hset]; exact Set.mul_mem_mul ac.1.2 ac.2.2⟩
  have hf : Function.Bijective f := by
    constructor
    · rintro ⟨a, c⟩ ⟨a', c'⟩ h
      have h' : (a : G) * c = a' * c' := congrArg Subtype.val h
      have hx : (a' : G)⁻¹ * a = c' * (c : G)⁻¹ := by
        calc (a' : G)⁻¹ * a = (a' : G)⁻¹ * (a * c) * (c : G)⁻¹ := by group
          _ = c' * (c : G)⁻¹ := by rw [h']; group
      have hmem : (a' : G)⁻¹ * a ∈ A ⊓ C :=
        Subgroup.mem_inf.mpr ⟨A.mul_mem (A.inv_mem a'.2) a.2, hx ▸ C.mul_mem c'.2 (C.inv_mem c.2)⟩
      rw [hAC, Subgroup.mem_bot, inv_mul_eq_one] at hmem
      have hcc : (c : G) = c' := by
        rw [hmem] at h'
        exact mul_left_cancel h'
      exact Prod.ext (Subtype.ext hmem.symm) (Subtype.ext hcc)
    · rintro ⟨x, hx⟩
      rw [← SetLike.mem_coe, hset] at hx
      obtain ⟨a, ha, c, hc, rfl⟩ := hx
      exact ⟨(⟨a, ha⟩, ⟨c, hc⟩), rfl⟩
  rw [← Nat.card_prod]
  exact (Nat.card_congr (Equiv.ofBijective f hf)).symm

private theorem exists_orderOf_eq {K : Type} [Field K] [Finite K] :
    ∃ l : Kˣ, orderOf l = 3 ^ (Nat.card K - 1).factorization 3 := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Kˣ)
  have hog : orderOf g = Nat.card K - 1 := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hg, Nat.card_units]
  refine ⟨g ^ (orderOf g / 3 ^ (Nat.card K - 1).factorization 3), ?_⟩
  have hK : 1 < Nat.card K := Finite.one_lt_card
  refine orderOf_pow_orderOf_div (by rw [hog]; omega) ?_
  rw [hog]
  exact Nat.ordProj_dvd _ _

private theorem rank_sylow_SL3_le_two
    {K : Type} [Field K] [Finite K]
    (hq : Nat.card K % 3 = 1) (P : Sylow 3 SL(3, K)) :
    Group.rank ↥(P : Subgroup SL(3, K)) ≤ 2 := by
  classical
  set a := (Nat.card K - 1).factorization 3 with ha
  obtain ⟨l, hl⟩ := exists_orderOf_eq (K := K)
  set μ : Subgroup Kˣ := zpowers l with hμ
  set A : Subgroup SL(3, K) := (μ.prod μ).map dg with hA
  set C : Subgroup SL(3, K) := zpowers pm with hC
  have hcA : Nat.card A = 3 ^ a * 3 ^ a := by
    rw [hA, Subgroup.card_map_of_injective dg_injective,
      Nat.card_congr (Subgroup.prodEquiv μ μ).toEquiv, Nat.card_prod, hμ, Nat.card_zpowers, hl]
  have hcC : Nat.card C = 3 := by rw [hC, Nat.card_zpowers, orderOf_pm]
  have hfwd : ∀ y ∈ A, pm * y * pm⁻¹ ∈ A := by
    rintro _ ⟨⟨α, β⟩, ⟨hα, hβ⟩, rfl⟩
    rw [pm_conj_dg]
    exact ⟨(β, (α * β)⁻¹), Subgroup.mem_prod.mpr ⟨hβ, μ.inv_mem (μ.mul_mem hα hβ)⟩, rfl⟩
  have hpmN : pm ∈ normalizer (A : Set SL(3, K)) := by
    rw [Subgroup.mem_normalizer_iff]
    intro y
    refine ⟨hfwd y, fun hy => ?_⟩
    have h := hfwd _ (hfwd _ hy)
    have e : pm * (pm * (pm * y * pm⁻¹) * pm⁻¹) * pm⁻¹ = y := by
      calc pm * (pm * (pm * y * pm⁻¹) * pm⁻¹) * pm⁻¹ = (pm * pm * pm) * y * (pm * pm * pm)⁻¹ := by
            group
        _ = y := by rw [← pow_three', pm_pow_three]; group
    rwa [e] at h
  have hCN : C ≤ normalizer (A : Set SL(3, K)) := (Subgroup.zpowers_le).mpr hpmN
  have hAC : A ⊓ C = ⊥ := by
    have hd := Subgroup.card_dvd_of_le (inf_le_right : A ⊓ C ≤ C)
    rw [hcC] at hd
    rcases (Nat.dvd_prime Nat.prime_three).mp hd with h1 | h3
    · exact Subgroup.eq_bot_of_card_eq _ h1
    · exfalso
      have hle : A ⊓ C = C := Subgroup.eq_of_le_of_card_ge inf_le_right (by rw [h3, hcC])
      have hpmA : pm ∈ A := (hle ▸ inf_le_left : C ≤ A) (mem_zpowers pm)
      exact pm_not_mem_range (Subgroup.map_le_range dg _ hpmA)
  set H : Subgroup SL(3, K) := A ⊔ C with hH
  have hcH : Nat.card H = 3 ^ (2 * a + 1) := by
    rw [hH, card_sup_of_le_normalizer A C hCN hAC, hcA, hcC]
    ring
  have hS : Nat.card SL(3, K) = Nat.card K ^ 3 * (Nat.card K ^ 2 - 1) * (Nat.card K ^ 3 - 1) := by
    rw [CFSG.LocalAnalysis.ComponentInitial.LinearFlag.card_SL_eq (by norm_num),
      show Finset.Icc 2 3 = {2, 3} by decide, Finset.prod_pair (by norm_num), mul_assoc]
  have hv : (Nat.card SL(3, K)).factorization 3 = 2 * a + 1 := by
    rw [hS]
    exact CFSG.RankThree.PartTwo.Sec11.Item1120V0Bar.factorization_card_sl3_order true _ hq
      Finite.one_lt_card
  let S : Sylow 3 SL(3, K) := Sylow.ofCard H (by rw [hcH, hv])
  set t : SL(3, K) := dg (l, l⁻¹) with ht
  have hgen : H = closure ((({t, pm} : Finset SL(3, K))) : Set SL(3, K)) := by
    rw [Finset.coe_pair]
    apply le_antisymm
    · have htc : t ∈ closure ({t, pm} : Set SL(3, K)) := subset_closure (by simp)
      have hpc : pm ∈ closure ({t, pm} : Set SL(3, K)) := subset_closure (by simp)
      have h10 : dg (l, 1) ∈ closure ({t, pm} : Set SL(3, K)) := by
        have h := inv_mem (mul_mem (mul_mem hpc htc) (inv_mem hpc))
        rw [ht, pm_conj_dg] at h
        convert h using 2
        rw [← map_inv]
        congr 1
        ext <;> simp
      have h01 : dg (1, l) ∈ closure ({t, pm} : Set SL(3, K)) := by
        have h := mul_mem (inv_mem htc) h10
        rw [ht, ← map_inv, ← map_mul] at h
        convert h using 2
        ext <;> simp
      refine sup_le ?_ ((Subgroup.zpowers_le).mpr hpc)
      rintro _ ⟨⟨α, β⟩, ⟨hα, hβ⟩, rfl⟩
      obtain ⟨i, rfl⟩ := mem_zpowers_iff.mp hα
      obtain ⟨j, rfl⟩ := mem_zpowers_iff.mp hβ
      have e : ((l ^ i, l ^ j) : Kˣ × Kˣ) = (l, 1) ^ i * (1, l) ^ j := by
        ext <;> simp
      rw [e, map_mul, map_zpow, map_zpow]
      exact mul_mem (zpow_mem h10 i) (zpow_mem h01 j)
    · rw [closure_le]
      intro x hx
      rcases hx with rfl | rfl
      · exact le_sup_left (a := A) ⟨(l, l⁻¹), Subgroup.mem_prod.mpr ⟨mem_zpowers l, μ.inv_mem (mem_zpowers l)⟩, rfl⟩
      · exact le_sup_right (a := A) (mem_zpowers pm)
  have hrankH : Group.rank ↥H ≤ 2 := by
    have h := Subgroup.rank_closure_finset_le_card ({t, pm} : Finset SL(3, K))
    rw [Group.rank_congr (MulEquiv.subgroupCongr hgen)]
    exact h.trans Finset.card_le_two
  have : Finite (Sylow 3 SL(3, K)) := inferInstance
  have e : ↥(P : Subgroup SL(3, K)) ≃* ↥H :=
    (Sylow.equiv P S).trans (MulEquiv.subgroupCongr (Sylow.coe_ofCard _ _))
  rw [Group.rank_congr e]
  exact hrankH

end

