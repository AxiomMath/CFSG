@[expose] def Shape3 (K : Type) [Group K] (t : CFSG.Open.StatedLieTag) (p f : ℕ) : Prop :=
  CFSG.Open.IsQuasisimple K ∧ LieModel (K ⧸ Subgroup.center K) t 3 p f

@[expose] def OmegaCentral : Prop :=
  (∀ {X : Type} [Group X] [Finite X] {n r : ℕ}, LieModel X .PSL 3 2 n → r.Prime → 5 ≤ r →
      r ∣ 2 ^ n - 1 → ∀ R : Subgroup (MulAut X), IsPGroup r ↥R →
        Nat.card ↥(R ⊓ inner X) = r ^ (Nat.card X).factorization r →
          ∀ a ∈ R ⊓ inner X, a ^ r = 1 → ∀ b ∈ R, a * b = b * a) ∧
    (∀ {X : Type} [Group X] [Finite X] {n r : ℕ}, LieModel X .PSU 3 2 n → r.Prime → 5 ≤ r →
      r ∣ 2 ^ n + 1 → ∀ R : Subgroup (MulAut X), IsPGroup r ↥R →
        Nat.card ↥(R ⊓ inner X) = r ^ (Nat.card X).factorization r →
          ∀ a ∈ R ⊓ inner X, a ^ r = 1 → ∀ b ∈ R, a * b = b * a)

@[expose] def OutPComplement : Prop :=
  ∀ (K : Type) [Group K] [Finite K], CFSG.Open.IsQuasisimple K →
    CFSG.Open.IsCatalogGroup (K ⧸ Subgroup.center K) → ∀ p : ℕ, p.Prime → p ≠ 2 →
      CFSG.Open.pRank p (⊤ : Subgroup K) ≤ 1 → CFSG.HasNormalPComplement p (Outer K)

@[expose] def Eight73YLieModel {G : Type} [Group G] [Finite G] (D : Data G) : Prop :=
  ∀ {p : ℕ}, p ≠ 2 → ∀ {L Q : Subgroup G}, L ∈ calC D.M →
    (LieModel (BarInf L) .PSL 3 p 1 ∨ LieModel (BarInf L) .PSU 3 p 1) →
    CFSG.Open.pRank p D.M ≤ 3 → IsSylowOf p Q L → rankThreeGamma 1 p Q ≤ D.M →
      IsStronglyPEmbedded p D.M

theorem eight73YLieModel_of_inputs {G : Type} [Group G] [Finite G]
    (hGA : GriessAllModelsStatement) (hK35w : UCK.K35w) (hKZ : StronglyEmbeddedCentralFree)
    {D : Data G} (h63 : UC6.R6_3 D) : Eight73YLieModel D := by
  intro p hp2 L Q hL hX hM3 hQ hΓ
  exact isStronglyPEmbedded_of_eight73Y_lieModel hGA hK35w hKZ h63 hp2 hL hX hM3 hQ hΓ

theorem Shape3.of_mulEquiv {K K' : Type} [Group K] [Group K'] (e : K ≃* K')
    {t : CFSG.Open.StatedLieTag} {p f : ℕ} (h : Shape3 K t p f) : Shape3 K' t p f :=
  ⟨CFSG.Open.IsQuasisimple.of_mulEquiv e.symm h.1,
    CFSG.Blueprint.LieModel.of_mulEquiv
      (QuotientGroup.congr (Subgroup.center K) (Subgroup.center K') e
        (Subgroup.map_center_eq e)) h.2⟩

theorem r873_pRank_bar2 {G : Type} [Group G] [Finite G] (L : Subgroup G) {q : ℕ} (hq : q.Prime)
    (hq2 : q ≠ 2) :
    CFSG.Open.pRank q (⊤ : Subgroup (Bar2 L)) = CFSG.Open.pRank q L := by
  have : Fact q.Prime := ⟨hq⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h3 : ¬ q ∣ Nat.card (CFSG.pCore 2 ↥L) :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup (p := 2) (q := q)
      (CFSG.pCore_isPGroup (p := 2) (G := ↥L)) hq hq2
  rw [CFSG.SectionRank.pRank_quotient_eq (p := q) (N := CFSG.pCore 2 ↥L) h3,
    ← CFSG.SectionRank.pRank_eq_pRank_top_subgroup L]

theorem r873_pRank_X {G : Type} [Group G] [Finite G] {L X : Subgroup G}
    (hsup : X ⊔ pCoreOf 2 L = L) {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) :
    CFSG.Open.pRank q X = CFSG.Open.pRank q L := by
  obtain ⟨e⟩ := nonempty_bar2_equiv_of_sup_pCore L X hsup
  rw [← r873_pRank_bar2 X hq hq2, ← r873_pRank_bar2 L hq hq2]
  exact CFSG.SectionRank.pRank_top_eq_of_mulEquiv hq.one_lt e

private theorem r873s3_exists_noncomm_of_factorization {K : Type} [Group K] [Finite K]
    {p f : ℕ} (hsimple : IsSimpleGroup K) (hp : p.Prime)
    (hfac : (Nat.card K).factorization p = 3 * f) (hf : 1 ≤ f) :
    ∃ a b : K, a * b ≠ b * a := by
  by_contra hcon
  have hcomm : ∀ a b : K, a * b = b * a := by
    intro a b
    by_contra h
    exact hcon ⟨a, b, h⟩
  have hcommI : IsMulCommutative K := isMulCommutative_iff.mpr hcomm
  have hprime : (Nat.card K).Prime :=
    (@Group.is_simple_iff_prime_card K _ hcommI).mp hsimple
  have hn0 : Nat.card K ≠ 0 := hprime.ne_zero
  have hdvd : p ∣ Nat.card K := by
    rw [Nat.Prime.dvd_iff_one_le_factorization hp hn0, hfac]
    omega
  have hpn : p = Nat.card K := (Nat.prime_dvd_prime_iff_eq hp hprime).mp hdvd
  have h1 : 3 * f = 1 := by
    rw [← hfac, hpn, Nat.Prime.factorization_self hprime]
  omega

private theorem r873s3_center_eq_bot {K : Type} [Group K] [IsSimpleGroup K]
    (hna : ∃ a b : K, a * b ≠ b * a) : Subgroup.center K = ⊥ := by
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center K) with h | h
  · exact h
  · exfalso
    obtain ⟨a, b, hab⟩ := hna
    have hmem := Subgroup.mem_center_iff.mp (h ▸ Subgroup.mem_top a) b
    exact hab hmem.symm

private theorem r873s3_commutator_eq_top {K : Type} [Group K] [IsSimpleGroup K]
    (hna : ∃ a b : K, a * b ≠ b * a) : commutator K = ⊤ := by
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (commutator K) with h | h
  · exfalso
    obtain ⟨a, b, hab⟩ := hna
    have h1 : ⁅a, b⁆ ∈ commutator K :=
      commutator_mem_commutator (Subgroup.mem_top a) (Subgroup.mem_top b)
    rw [h, Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm] at h1
    exact hab h1
  · exact h

private theorem r873s3_open_isQuasisimple {K : Type} [Group K] [IsSimpleGroup K]
    (hna : ∃ a b : K, a * b ≠ b * a) : CFSG.Open.IsQuasisimple K := by
  refine ⟨r873s3_commutator_eq_top hna, ?_⟩
  have hZ := r873s3_center_eq_bot hna
  have e : K ⧸ Subgroup.center K ≃* K :=
    (QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot
  exact e.isSimpleGroup_congr.mpr inferInstance

private theorem r873s3_shape3_psl {K : Type} [Group K] [Finite K] {p f : ℕ}
    (h : LieModel K .PSL 3 p f) : Shape3 K .PSL p f := by
  have hsimple : IsSimpleGroup K :=
    CFSG.Blueprint.LieModel.isSimpleGroup_of_mem_classicalTags (by decide) h
  have hna : ∃ a b : K, a * b ≠ b * a :=
    r873s3_exists_noncomm_of_factorization hsimple h.admissible.1
      (CFSG.Blueprint.LieModel.factorization_card_psl3 h) h.admissible.2.1
  exact ⟨@r873s3_open_isQuasisimple K _ hsimple hna,
    CFSG.Blueprint.LieModel.quotient_center (@r873s3_center_eq_bot K _ hsimple hna) h⟩

private theorem r873s3_shape3_psu {K : Type} [Group K] [Finite K] {p f : ℕ}
    (h : LieModel K .PSU 3 p f) : Shape3 K .PSU p f := by
  have hsimple : IsSimpleGroup K :=
    CFSG.Blueprint.LieModel.isSimpleGroup_of_mem_classicalTags (by decide) h
  have hna : ∃ a b : K, a * b ≠ b * a :=
    r873s3_exists_noncomm_of_factorization hsimple h.admissible.1
      (CFSG.Blueprint.LieModel.factorization_card_psu3 h) h.admissible.2.1
  exact ⟨@r873s3_open_isQuasisimple K _ hsimple hna,
    CFSG.Blueprint.LieModel.quotient_center (@r873s3_center_eq_bot K _ hsimple hna) h⟩

theorem r873_shape3_of_sl3PiType {K : Type} [Group K] [Finite K] (h : IsSL3PiType K) :
    ∃ p f : ℕ, (p ^ f % 3 = 1 ∧ Shape3 K .PSL p f) ∨ (p ^ f % 3 = 2 ∧ Shape3 K .PSU p f) := by
  rcases h with ⟨p, f, hmod, hL⟩ | ⟨p, f, hmod, hL⟩ | ⟨p, f, hmod, hC⟩ | ⟨p, f, hmod, hC⟩
  · exact ⟨p, f, Or.inl ⟨hmod, r873s3_shape3_psl hL⟩⟩
  · exact ⟨p, f, Or.inr ⟨hmod, r873s3_shape3_psu hL⟩⟩
  · exact ⟨p, f, Or.inl ⟨hmod, ⟨hC.1, hC.2.2⟩⟩⟩
  · exact ⟨p, f, Or.inr ⟨hmod, ⟨hC.1, hC.2.2⟩⟩⟩

private theorem r873s3_perfect_of_isProdOfCalC {G : Type} [Group G] [Finite G]
    {M L : Subgroup G}
    (h : CFSG.LocalAnalysis.UniquenessCase.UC22.F08.IsProdOfCalC M L) : ⁅L, L⁆ = L := by
  obtain ⟨k, S, hS, hLset⟩ := h
  have hpair : ∀ A ∈ List.ofFn S, ∀ B ∈ List.ofFn S,
      A ≤ Subgroup.normalizer (B : Set G) := by
    intro A hA B hB
    obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hA
    obtain ⟨j, rfl⟩ := List.mem_ofFn.1 hB
    by_cases hij : S j = S i
    · rw [hij]
      exact Subgroup.le_normalizer
    · exact CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p22u_calC_normalizes (hS j) (hS i) hij
  have hLeq : L = ⨆ A ∈ List.ofFn S, A := by
    apply SetLike.coe_injective
    rw [hLset, ← CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p22u_prod_list_eq_iSup
      (List.ofFn S) hpair, List.map_ofFn]
    rfl
  have hle : ∀ A ∈ List.ofFn S, A ≤ L := fun A hA => by
    rw [hLeq]
    exact le_iSup₂ (f := fun A (_ : A ∈ List.ofFn S) => A) A hA
  refine le_antisymm (CFSG.Quasithin.A3.commutator_self_le L) ?_
  calc L = ⨆ A ∈ List.ofFn S, A := hLeq
    _ ≤ ⁅L, L⁆ := iSup₂_le fun A hA => by
      obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hA
      calc S i = ⁅S i, S i⁆ := (hS i).2.1.symm
        _ ≤ ⁅L, L⁆ := Subgroup.commutator_mono (hle _ hA) (hle _ hA)

theorem r873_calC_of_quasisimple {G : Type} [Group G] [Finite G] {D : Data G} {L X : Subgroup G}
    (h : Hyp869 D L X) (hq : CFSG.Open.IsQuasisimple (Bar2 L)) : L ∈ calC D.M := by
  rcases h.1 with hL | ⟨hLM, hML, hprod⟩
  · exact hL
  · refine ⟨?_, r873s3_perfect_of_isProdOfCalC hprod, hq⟩
    exact CFSG.Open.IsSubnormal.step hLM
      ((Subgroup.normal_subgroupOf_iff_le_normalizer hLM).2 hML)
      (CFSG.Open.IsSubnormal.refl D.M)

theorem r873_normal {G : Type} [Group G] [Finite G] {D : Data G} (hSg : UC6S846.SigmaStd D)
    (h870 : R870 D) {L X H : Subgroup G} (hmin : MinCex869 D L X H) {r : ℕ} (hr : r.Prime)
    (hr2 : r ≠ 2) (hX : 2 ≤ CFSG.Open.pRank r X)
    (hZ : ¬ r ∣ Nat.card (Subgroup.center (Bar2 L))) :
    D.M ≤ Subgroup.normalizer (L : Set G) := by
  rcases hmin.hyp.1 with hL | ⟨-, hN, -⟩
  · by_contra hnN
    have hXL : CFSG.Open.pRank r X = CFSG.Open.pRank r L :=
      r873_pRank_X hmin.hyp.2.2.1 hr hr2
    obtain ⟨E, hEL, hEab, hEcard⟩ :=
      UC6S846.exists_elemAbelian_card_of_le_pRank (M := L) hr (k := 2) (by omega)
    have h4 := UC6S846.calCRankTwice D.M L hL hnN r hr hr2 hZ E hEL hEab 2 hEcard
    have h3 := pRank_le_three_of_minCex hSg h870 hmin hr hr2 (by omega)
    omega
  · exact hN

private theorem r873cen_pRank_quotient_center_le_one {K : Type} [Group K] [Finite K] {p : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) (Z : Subgroup K) [Z.Normal]
    (h1 : CFSG.Open.pRank p (⊤ : Subgroup K) ≤ 1) :
    CFSG.Open.pRank p (⊤ : Subgroup (K ⧸ Z)) ≤ 1 := by
  have : Fact p.Prime := ⟨hp⟩
  obtain ⟨S⟩ : Nonempty (Sylow p K) := inferInstance
  have hS1 : CFSG.Open.pRank p (S : Subgroup K) ≤ 1 := by
    rw [(CFSG.SectionRank.pRank_sylow S).1]
    exact h1
  have hScyc : IsCyclic ↥(S : Subgroup K) := by
    refine CFSG.isCyclic_of_pRank_le_one hp hp2 S.isPGroup' ?_
    rw [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup (S : Subgroup K)]
    exact hS1
  have : IsCyclic ↥(S : Subgroup K) := hScyc
  have hTcyc : IsCyclic ↥((S : Subgroup K).map (QuotientGroup.mk' Z)) :=
    isCyclic_of_surjective ((QuotientGroup.mk' Z).subgroupMap (S : Subgroup K))
      ((QuotientGroup.mk' Z).subgroupMap_surjective (S : Subgroup K))
  let T : Sylow p (K ⧸ Z) := S.mapSurjective (QuotientGroup.mk'_surjective Z)
  have hT1 : CFSG.Open.pRank p (T : Subgroup (K ⧸ Z)) ≤ 1 := by
    rw [CFSG.SectionRank.pRank_eq_pRank_top_subgroup (T : Subgroup (K ⧸ Z))]
    exact CFSG.pRank_le_one_of_isCyclic hp hTcyc
  rw [← (CFSG.SectionRank.pRank_sylow T).1]
  exact hT1

theorem r873_centralizing {G : Type} [Group G] [Finite G] {D : Data G}
    (hSg : UC6S846.SigmaStd D) (h638 : UC6.R6_38 D) (hOut : OutPComplement) {L : Subgroup G}
    (hL : L ∈ calC D.M) (hML : D.M ≤ Subgroup.normalizer (L : Set G)) {p : ℕ} (hp : p ∈ D.sig)
    (h1 : CFSG.Open.pRank p L ≤ 1) :
    ∃ A : Subgroup G, A ≤ D.M ∧ IsElemAbelian p A ∧ Nat.card A = p ^ 2 ∧
      ∀ a ∈ A, ∀ l ∈ L, a * l * a⁻¹ * l⁻¹ ∈ pCoreOf 2 L := by
  classical
  have hσ := D.sig_prime p hp
  have hOp : UC22.F10.OpRes p D.M = D.M := h638 p hσ.1 hσ.2 (Or.inl hp)
  have hLne : L ≠ ⊤ := by
    intro htop
    exact CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p20a_M_ne_top D
      (top_le_iff.mp (htop ▸ hL.1.le))
  have hCat : CFSG.Open.IsCatalogGroup (Bar2 L ⧸ Subgroup.center (Bar2 L)) :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p20d_inCatalog_bar2
      D.standing.kProper hLne hL.2.2
  have hRank : CFSG.Open.pRank p (⊤ : Subgroup (Bar2 L)) ≤ 1 := by
    rw [r873_pRank_bar2 L hσ.1 hσ.2]
    exact h1
  have hOut' : CFSG.HasNormalPComplement p (Outer (Bar2 L)) :=
    hOut (Bar2 L) hL.2.2 hCat p hσ.1 hσ.2 hRank
  have hbound :=
    CFSG.LocalAnalysis.UniquenessCase.PartTwo.pRank_le_add_pRank_centOverO2
      hL.1.le hML hσ.1 hOut' hOp
  have hq1 : CFSG.Open.pRank p (⊤ : Subgroup (Bar2 L ⧸ Subgroup.center (Bar2 L))) ≤ 1 :=
    r873cen_pRank_quotient_center_le_one hσ.1 hσ.2 (Subgroup.center (Bar2 L)) hRank
  have h2 : 2 ≤ CFSG.Open.pRank p
      (CFSG.LocalAnalysis.UniquenessCase.UC22.F08.CentOverO2 D.M L) := by
    have h3 := hSg.three_le p hp
    omega
  obtain ⟨A, hA, hAel, hAcard⟩ :=
    UC6S846.exists_elemAbelian_card_of_le_pRank
      (M := CFSG.LocalAnalysis.UniquenessCase.UC22.F08.CentOverO2 D.M L) hσ.1 (k := 2) h2
  refine ⟨A, ?_, hAel, hAcard, ?_⟩
  · intro a ha
    exact (CFSG.LocalAnalysis.UniquenessCase.PartTwo.mem_centOverO2_iff.mp (hA ha)).1
  · intro a ha l hl
    exact (CFSG.LocalAnalysis.UniquenessCase.PartTwo.mem_centOverO2_iff.mp (hA ha)).2 l hl

theorem r873_gamma_of_centralizing {G : Type} [Group G] [Finite G] {D : Data G}
    (hSg : UC6S846.SigmaStd D) (hns : ¬ Group.IsSolvable ↥D.M) (h76 : UC22.F07.R76 D)
    {L : Subgroup G} (hLM : L ≤ D.M) (hML : D.M ≤ Subgroup.normalizer (L : Set G)) {p : ℕ}
    (hp : p ∈ D.sig) {A : Subgroup G} (hAM : A ≤ D.M) (hAel : IsElemAbelian p A)
    (hAc : Nat.card A = p ^ 2) (hAL : ∀ a ∈ A, ∀ l ∈ L, a * l * a⁻¹ * l⁻¹ ∈ pCoreOf 2 L)
    {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2) {E : Subgroup G} (hEL : E ≤ L)
    (hEel : IsElemAbelian r E) (hEc : Nat.card E = r ^ 2) : rankThreeGamma 1 r E ≤ D.M := by
  have hσ := D.sig_prime p hp
  have hsp : IsStronglyPEmbedded p D.M := UC6S846.sp_of_mem_sig hSg hns hp
  have hNO := UC6S846.normalizer_le_normalizer_pCoreOf L
  obtain ⟨A', hA'C, hA'le, ⟨eA⟩⟩ := UC6S846.exists_centralizing_copy hr hr2 hσ.1 hσ.2
    (pCoreOf 2 L) A E (UC6S846.isPGroup_pCoreOf L) ((hAM.trans hML).trans hNO)
    ((hEL.trans Subgroup.le_normalizer).trans hNO) hAel.isPGroup hEel.isPGroup
    (fun e he a ha => by
      have h3 : e * a * e⁻¹ * a⁻¹ = (a * e * a⁻¹ * e⁻¹)⁻¹ := by group
      rw [h3]
      exact inv_mem (hAL a ha e (hEL he)))
  have hA'M : A' ≤ D.M :=
    hA'le.trans (sup_le hAM ((Subgroup.map_subtype_le _).trans hLM))
  have hA'el : IsElemAbelian p A' := UC6S846.isElemAbelian_of_mulEquiv eA hAel
  have hA'c : Nat.card A' = p ^ 2 := by rw [Nat.card_congr eA.toEquiv, hAc]
  have h2 : 2 ≤ CFSG.Open.pRank p (D.M ⊓ Subgroup.centralizer (E : Set G)) :=
    UC6S846.le_pRank' hσ.1 (le_inf hA'M hA'C) hA'el hA'c
  refine h76 p hσ.1 hσ.2 hsp r hr E (hEL.trans hLM) hEel hEc (by omega) ?_
  intro X hXE _
  refine lt_of_lt_of_le (by norm_num)
    (h2.trans (CFSG.SectionRank.pRank_mono hσ.1.one_lt ?_))
  exact inf_le_inf_left _ ((Subgroup.centralizer_le hXE).trans
    (Subgroup.centralizer_le_normalizer _))

theorem r873_gamma_all {G : Type} [Group G] [Finite G] {D : Data G} (hSg : UC6S846.SigmaStd D)
    (h870 : R870 D) (h76 : UC22.F07.R76 D) (h638 : UC6.R6_38 D) (hOut : OutPComplement)
    {L X H : Subgroup G} (hmin : MinCex869 D L X H) (hLc : L ∈ calC D.M)
    (hML : D.M ≤ Subgroup.normalizer (L : Set G)) {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2)
    {E : Subgroup G} (hEL : E ≤ L) (hEel : IsElemAbelian r E) (hEc : Nat.card E = r ^ 2) :
    rankThreeGamma 1 r E ≤ D.M := by
  have hns : ¬ Group.IsSolvable ↥D.M := UC6S846.not_solvable_of_mem_calC hLc
  have hLM : L ≤ D.M := hLc.1.le
  obtain ⟨p, hp⟩ := hSg.nonempty
  have hσ := D.sig_prime p hp
  have h1 : CFSG.Open.pRank p L ≤ 1 := by
    by_contra h
    have hX : 1 < CFSG.Open.pRank p X := by
      rw [r873_pRank_X hmin.hyp.2.2.1 hσ.1 hσ.2]
      omega
    exact h870 L X H hmin p hσ.1 hσ.2 hX (UC6S846.sp_of_mem_sig hSg hns hp)
  obtain ⟨A, hAM, hAel, hAc, hAL⟩ := r873_centralizing hSg h638 hOut hLc hML hp h1
  exact r873_gamma_of_centralizing hSg hns h76 hLM hML hp hAM hAel hAc hAL hr hr2 hEL hEel hEc

theorem r873_strong_false {G : Type} [Group G] [Finite G] {D : Data G} (hSg : UC6S846.SigmaStd D)
    (h870 : R870 D) (h614 : UC6.R6_14 D) {L X H : Subgroup G} (hmin : MinCex869 D L X H)
    (hLc : L ∈ calC D.M) {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2) {R E : Subgroup G}
    (hR : IsSylowOf r R D.M) (hEL : E ≤ L) (hEcen : E ≤ R ⊓ Subgroup.centralizer (R : Set G))
    (hEel : IsElemAbelian r E) (hEc : Nat.card E = r ^ 2) (hΓ : rankThreeGamma 1 r E ≤ D.M) :
    False := by
  have hns : ¬ Group.IsSolvable ↥D.M := UC6S846.not_solvable_of_mem_calC hLc
  have hX : 1 < CFSG.Open.pRank r X := by
    rw [r873_pRank_X hmin.hyp.2.2.1 hr hr2]
    have := UC6S846.le_pRank' hr hEL hEel (k := 2) hEc
    omega
  have hsp : IsStronglyPEmbedded r D.M := by
    by_cases hσ : r ∈ D.sig
    · exact UC6S846.sp_of_mem_sig hSg hns hσ
    · exact h614 (UC6S846.sig_subset_sig1 hSg hns) r hr hr2 hσ R hR E hEcen hEel hEc hΓ
  exact h870 L X H hmin r hr hr2 hX hsp

private theorem r873om_card_comap_eq_card_mul_card_ker {L R : Type} [Group L] [Finite L] [Group R]
    (π : L →* R) (hπ : Function.Surjective π) (E : Subgroup R) :
    Nat.card (E.comap π) = Nat.card E * Nat.card π.ker := by
  let N : Subgroup L := E.comap π
  let Z : Subgroup L := π.ker
  have hZN : Z ≤ N := by
    intro z hz
    exact Subgroup.mem_comap.mpr (by rw [MonoidHom.mem_ker.mp hz]; exact E.one_mem)
  let f : N →* E :=
    { toFun := fun x => ⟨π x, x.2⟩
      map_one' := by ext; simp
      map_mul' := by intro x y; ext; simp }
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨x, hx⟩ := hπ y.1
    refine ⟨⟨x, ?_⟩, ?_⟩
    · rw [Subgroup.mem_comap]; rw [hx]; exact y.2
    · ext; exact hx
  have hker : f.ker = Z.subgroupOf N := by
    ext x
    constructor
    · intro hx
      rw [Subgroup.mem_subgroupOf]
      have hx' : f x = 1 := MonoidHom.mem_ker.mp hx
      have hv : π (x : L) = 1 := by
        have := congrArg Subtype.val hx'
        simpa [f] using this
      exact MonoidHom.mem_ker.mpr hv
    · intro hx
      rw [MonoidHom.mem_ker]
      ext
      exact Subgroup.mem_subgroupOf.mp hx
  have hmap : Subgroup.map N.subtype (Z.subgroupOf N) = Z := by
    rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hZN]
  have hcardZ : Nat.card (Z.subgroupOf N) = Nat.card Z := by
    rw [← Subgroup.card_map_of_injective (K := Z.subgroupOf N) N.subtype_injective, hmap]
  calc
    Nat.card N = Nat.card f.ker * Nat.card E :=
      (Subgroup.card_ker_mul_card_of_surjective (f := f) hf).symm
    _ = Nat.card (Z.subgroupOf N) * Nat.card E := by rw [hker]
    _ = Nat.card Z * Nat.card E := by rw [hcardZ]
    _ = Nat.card E * Nat.card Z := Nat.mul_comm _ _

private theorem r873om_mulAut_conj_eq_one_iff {X : Type} [Group X] (g : X) :
    MulAut.conj g = 1 ↔ g ∈ Subgroup.center X := by
  rw [Subgroup.mem_center_iff]
  constructor
  · intro h y
    have hy : MulAut.conj g y = y := by rw [h]; rfl
    rw [MulAut.conj_apply, mul_inv_eq_iff_eq_mul] at hy
    exact hy.symm
  · intro h
    ext y
    rw [MulAut.conj_apply, MulAut.one_apply, ← h y, mul_inv_cancel_right]

private theorem r873om_centerQuotientHom_conj_eq_one_iff {X : Type} [Group X]
    [Group.IsPerfect X] (g : X) :
    CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom X (MulAut.conj g) = 1 ↔
      g ∈ Subgroup.center X := by
  rw [← r873om_mulAut_conj_eq_one_iff]
  constructor
  · intro h
    apply CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom_injective X
    rw [h, map_one]
  · intro h
    rw [h, map_one]

private theorem r873om_conj_injective_of_center_eq_bot {Y : Type} [Group Y]
    (h : Subgroup.center Y = ⊥) : Function.Injective (MulAut.conj : Y →* MulAut Y) := by
  rw [injective_iff_map_eq_one]
  intro g hg
  have hmem : g ∈ Subgroup.center Y := (r873om_mulAut_conj_eq_one_iff g).1 hg
  rw [h] at hmem
  exact Subgroup.mem_bot.1 hmem

private theorem r873om_inner_card {X : Type} [Group X] [Finite X]
    (h : Subgroup.center X = ⊥) :
    Nat.card (inner X) = Nat.card X := by
  rw [CFSG.ComponentClassification.OuterAutomorphisms.inner]
  exact Nat.card_congr
    (MonoidHom.ofInjective (r873om_conj_injective_of_center_eq_bot h)).toEquiv.symm

private theorem r873om_generic_dvd_three {t : CFSG.Open.StatedLieTag} {n : ℕ}
    (ht : t = .PSL ∨ t = .PSU) :
    (CFSG.Blueprint.Multiplier.genericOrders t 3 2 n).1 *
      (CFSG.Blueprint.Multiplier.genericOrders t 3 2 n).2 ∣ 3 := by
  rcases ht with rfl | rfl
  · simpa only [CFSG.Blueprint.Multiplier.genericOrders, mul_one] using
      Nat.gcd_dvd_left 3 (2 ^ n - 1)
  · simpa only [CFSG.Blueprint.Multiplier.genericOrders, mul_one] using
      Nat.gcd_dvd_left 3 (2 ^ n + 1)

private theorem r873om_exceptional_dvd_sixteen {t : CFSG.Open.StatedLieTag} {n : ℕ}
    (ht : t = .PSL ∨ t = .PSU) :
    (CFSG.Blueprint.Multiplier.exceptionalOrders t 3 2 n).1 *
      (CFSG.Blueprint.Multiplier.exceptionalOrders t 3 2 n).2 ∣ 16 := by
  rcases ht with rfl | rfl
  · simp only [CFSG.Blueprint.Multiplier.exceptionalOrders]
    split <;> simp_all
  · norm_num [CFSG.Blueprint.Multiplier.exceptionalOrders]

private theorem r873om_not_dvd_48 {r : ℕ} (hr : r.Prime) (h5 : 5 ≤ r) : ¬ r ∣ 48 := by
  intro h
  have h' : r ∣ 2 ^ 4 * 3 := by simpa using h
  rcases (Nat.Prime.dvd_mul hr).1 h' with h2 | h3
  · have hr2 : r = 2 := (Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).1 (hr.dvd_of_dvd_pow h2)
    omega
  · have hr3 : r = 3 := (Nat.prime_dvd_prime_iff_eq hr Nat.prime_three).1 h3
    omega

private theorem r873om_fact_mul_eq {a b c r : ℕ} (ha : a ≠ 0) (hb : ¬ r ∣ b) (hc : ¬ r ∣ c) :
    ((a * b) * c).factorization r = a.factorization r := by
  have hb0 : b ≠ 0 := fun h => hb (by rw [h]; exact dvd_zero r)
  have hc0 : c ≠ 0 := fun h => hc (by rw [h]; exact dvd_zero r)
  rw [Nat.factorization_mul (Nat.mul_ne_zero ha hb0) hc0, Nat.factorization_mul ha hb0]
  simp only [Finsupp.add_apply]
  rw [Nat.factorization_eq_zero_of_not_dvd hb, Nat.factorization_eq_zero_of_not_dvd hc]
  simp

theorem r873_omega_central_lift {G : Type} [Group G] [Finite G] (hOmega : OmegaCentral)
    (hGA : GriessAllModelsStatement) {L R E : Subgroup G} {t : CFSG.Open.StatedLieTag}
    {n r : ℕ} (hr : r.Prime) (h5 : 5 ≤ r)
    (hdvd : (t = .PSL ∧ r ∣ 2 ^ n - 1) ∨ (t = .PSU ∧ r ∣ 2 ^ n + 1))
    (hsh : Shape3 (Bar2 L) t 2 n) (hRN : R ≤ Subgroup.normalizer (L : Set G))
    (hRp : IsPGroup r ↥R) (hsyl : IsSylowOf r (R ⊓ L) L) (hEel : IsElemAbelian r E)
    (hEc : Nat.card E = r ^ 2) (hER : E ≤ R ⊓ L) :
    E ≤ Subgroup.centralizer (R : Set G) := by
  classical
  have _hEc := hEc
  have : Fact r.Prime := ⟨hr⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hr2 : r ≠ 2 := by omega
  have hperf : Group.IsPerfect (Bar2 L) := Group.isPerfect_def.mpr hsh.1.1
  have ht2 : t = .PSL ∨ t = .PSU := hdvd.elim (fun h => Or.inl h.1) (fun h => Or.inr h.1)
  have htclassical : t ∈ CFSG.Blueprint.classicalTags := by
    rcases ht2 with rfl | rfl <;> decide
  have hZ48 : Nat.card (Subgroup.center (Bar2 L)) ∣ 48 := by
    have hd := CFSG.RankThree.PartOne.card_center_dvd_of_model hGA
      ((CFSG.Quasithin.A3.isQuasisimple_iff_open (Q := Bar2 L)).2 hsh.1)
      (hsh.2.statedClassicalModel htclassical)
    have hg := r873om_generic_dvd_three (t := t) (n := n) ht2
    have he := r873om_exceptional_dvd_sixteen (t := t) (n := n) ht2
    exact hd.trans ((Nat.mul_dvd_mul hg he).trans (by norm_num))
  have hZr : ¬ r ∣ Nat.card (Subgroup.center (Bar2 L)) :=
    fun h => r873om_not_dvd_48 hr h5 (h.trans hZ48)
  have hPr : ¬ r ∣ Nat.card (CFSG.pCore 2 ↥L) :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup (p := 2) (q := r)
      (CFSG.pCore_isPGroup (p := 2) (G := ↥L)) hr hr2
  have hLfac : (Nat.card ↥L).factorization r =
      (Nat.card (Bar2 L ⧸ Subgroup.center (Bar2 L))).factorization r := by
    have h1 : Nat.card ↥L = Nat.card (Bar2 L) * Nat.card (CFSG.pCore 2 ↥L) :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup (CFSG.pCore 2 ↥L)
    have h2 : Nat.card (Bar2 L) =
        Nat.card (Bar2 L ⧸ Subgroup.center (Bar2 L)) *
          Nat.card (Subgroup.center (Bar2 L)) :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup (Subgroup.center (Bar2 L))
    rw [h1, h2]
    exact r873om_fact_mul_eq (Nat.card_pos.ne') hZr hPr
  let Xq := Bar2 L ⧸ Subgroup.center (Bar2 L)
  let ρ : ↥R →* MulAut Xq :=
    (CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom (Bar2 L)).comp
      ((CFSG.LocalAnalysis.UniquenessCase.UC6S846.rhoL L).comp (Subgroup.inclusion hRN))
  let Rρ : Subgroup (MulAut Xq) := ρ.range
  let ρS : ↥(R ⊓ L) →* MulAut Xq := ρ.comp (Subgroup.inclusion inf_le_left)
  let Simg : Subgroup (MulAut Xq) := ρS.range
  let K : Subgroup ↥L :=
    (Subgroup.center (Bar2 L)).comap (QuotientGroup.mk' (CFSG.pCore 2 ↥L))
  have hKcard : Nat.card K =
      Nat.card (Subgroup.center (Bar2 L)) * Nat.card (CFSG.pCore 2 ↥L) := by
    rw [r873om_card_comap_eq_card_mul_card_ker
      (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) (QuotientGroup.mk'_surjective _)
      (Subgroup.center (Bar2 L)), QuotientGroup.ker_mk']
  have hnrK : ¬ r ∣ Nat.card K := by
    rw [hKcard]
    intro h
    rcases (Nat.Prime.dvd_mul hr).1 h with h1 | h2
    · exact hZr h1
    · exact hPr h2
  have hρ_eq : ∀ (x : ↥R) (hxL : (x : G) ∈ L),
      ρ x = CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom (Bar2 L)
        (MulAut.conj (QuotientGroup.mk (⟨(x : G), hxL⟩ : ↥L))) := by
    intro x hxL
    show CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom (Bar2 L)
        ((CFSG.LocalAnalysis.UniquenessCase.UC6S846.rhoL L)
          (Subgroup.inclusion hRN x)) = _
    rw [show (Subgroup.inclusion hRN x : ↥(Subgroup.normalizer (L : Set G))) =
        (⟨(x : G), Subgroup.le_normalizer hxL⟩ : ↥(Subgroup.normalizer (L : Set G)))
        from Subtype.ext rfl,
      CFSG.LocalAnalysis.UniquenessCase.UC6S846.rhoL_inner L (x : G) hxL]
  have hρS_eq : ∀ x : ↥(R ⊓ L), ρS x = ρ ⟨(x : G), x.2.1⟩ := by
    intro x
    show ρ (Subgroup.inclusion inf_le_left x) = ρ ⟨(x : G), x.2.1⟩
    exact congrArg ρ (Subtype.ext rfl)
  have hSimg_le_Rρ : Simg ≤ Rρ := by
    rintro _ ⟨x, rfl⟩
    exact ⟨⟨(x : G), x.2.1⟩, (hρS_eq x).symm⟩
  have hSimg_le_inner : Simg ≤ CFSG.ComponentClassification.OuterAutomorphisms.inner Xq := by
    rintro _ ⟨x, rfl⟩
    refine ⟨(QuotientGroup.mk' (Subgroup.center (Bar2 L)))
      (QuotientGroup.mk (⟨(x : G), x.2.2⟩ : ↥L)), ?_⟩
    rw [hρS_eq x, hρ_eq ⟨(x : G), x.2.1⟩ x.2.2]
    exact (CFSG.ComponentClassification.OuterAutomorphisms.centerQuotient_conj
      (G := Bar2 L) (QuotientGroup.mk (⟨(x : G), x.2.2⟩ : ↥L))).symm
  have hρS_inj : Function.Injective ρS := by
    rw [injective_iff_map_eq_one]
    intro x hx
    have hx' : CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom (Bar2 L)
        (MulAut.conj (QuotientGroup.mk (⟨(x : G), x.2.2⟩ : ↥L))) = 1 := by
      rw [← hρ_eq ⟨(x : G), x.2.1⟩ x.2.2, ← hρS_eq x]
      exact hx
    have hxcen : QuotientGroup.mk (⟨(x : G), x.2.2⟩ : ↥L) ∈ Subgroup.center (Bar2 L) :=
      (r873om_centerQuotientHom_conj_eq_one_iff
        (QuotientGroup.mk (⟨(x : G), x.2.2⟩ : ↥L))).1 hx'
    have hxK : (⟨(x : G), x.2.2⟩ : ↥L) ∈ K := Subgroup.mem_comap.mpr hxcen
    obtain ⟨k, hk⟩ := hRp ⟨(x : G), x.2.1⟩
    have hxk : (⟨(x : G), x.2.2⟩ : ↥L) ^ r ^ k = 1 := by
      apply Subtype.ext
      have hk' : (x : G) ^ (r ^ k) = 1 := by
        have := congrArg Subtype.val hk
        simpa using this
      simpa using hk'
    have hcop : Nat.Coprime (r ^ k) (Nat.card K) :=
      (hr.coprime_iff_not_dvd.mpr hnrK).pow_left k
    have hone : orderOf (⟨(x : G), x.2.2⟩ : ↥L) = 1 :=
      Nat.eq_one_of_dvd_coprimes hcop (orderOf_dvd_of_pow_eq_one hxk)
        (Subgroup.orderOf_dvd_natCard K hxK)
    have hone' : (⟨(x : G), x.2.2⟩ : ↥L) = 1 := orderOf_eq_one_iff.mp hone
    exact Subtype.ext (congrArg (fun y : ↥L => (y : G)) hone')
  have hcardSimg1 : Nat.card Simg = Nat.card ↥(R ⊓ L) := by
    change Nat.card ↥(ρS.range) = Nat.card ↥(R ⊓ L)
    exact Nat.card_congr (MonoidHom.ofInjective hρS_inj).toEquiv.symm
  have hcardSimg : Nat.card Simg = r ^ (Nat.card Xq).factorization r := by
    rw [hcardSimg1, IsSylowOf.card_eq hsyl]
    exact congrArg (fun m => r ^ m) hLfac
  have hcenterXq : Subgroup.center Xq = ⊥ :=
    Group.IsPerfect.center_quotient_center_eq_bot (Bar2 L)
  have hcardInner : Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.inner Xq) = Nat.card Xq := r873om_inner_card hcenterXq
  have hRρ_pgroup : IsPGroup r ↥Rρ := by
    change IsPGroup r ↥(ρ.range)
    exact hRp.of_surjective ρ.rangeRestrict ρ.rangeRestrict_surjective
  have hSimg_sylow : IsSylowOf r Simg (CFSG.ComponentClassification.OuterAutomorphisms.inner Xq) :=
    CFSG.ABGLocalTools.isSylowOf_of_card hSimg_le_inner
      (by rw [hcardSimg, hcardInner])
  have hRρ_inf_pgroup : IsPGroup r ↥(Rρ ⊓ CFSG.ComponentClassification.OuterAutomorphisms.inner Xq) := hRρ_pgroup.to_inf_left
  have hEq : Rρ ⊓ CFSG.ComponentClassification.OuterAutomorphisms.inner Xq = Simg :=
    hSimg_sylow.eq_of_le (le_inf hSimg_le_Rρ hSimg_le_inner) inf_le_right hRρ_inf_pgroup
  have hcardRρ : Nat.card ↥(Rρ ⊓ CFSG.ComponentClassification.OuterAutomorphisms.inner Xq) = r ^ (Nat.card Xq).factorization r := by
    rw [hEq, hcardSimg]
  have hcomm : ∀ a ∈ Rρ ⊓ CFSG.ComponentClassification.OuterAutomorphisms.inner Xq, a ^ r = 1 → ∀ b ∈ Rρ, a * b = b * a := by
    rcases hdvd with ⟨ht, hdvd'⟩ | ⟨ht, hdvd'⟩
    · subst ht
      exact hOmega.1 (X := Xq) (n := n) (r := r) hsh.2 hr h5 hdvd' Rρ hRρ_pgroup hcardRρ
    · subst ht
      exact hOmega.2 (X := Xq) (n := n) (r := r) hsh.2 hr h5 hdvd' Rρ hRρ_pgroup hcardRρ
  intro e he
  rw [Subgroup.mem_centralizer_iff]
  intro b hb
  have heR : e ∈ R := (Subgroup.mem_inf.mp (hER he)).1
  have heL : e ∈ L := (Subgroup.mem_inf.mp (hER he)).2
  set c : G := e * b * e⁻¹ * b⁻¹ with hc
  have hcR : c ∈ R := by
    rw [hc]
    exact R.mul_mem (R.mul_mem (R.mul_mem heR hb) (R.inv_mem heR)) (R.inv_mem hb)
  have hcL : c ∈ L := by
    rw [hc]
    have hbe : b * e⁻¹ * b⁻¹ ∈ L :=
      (Subgroup.mem_normalizer_iff.mp (hRN hb) e⁻¹).mp (L.inv_mem heL)
    simpa [mul_assoc] using L.mul_mem heL hbe
  have hρe : ρ ⟨e, heR⟩ ∈ Rρ ⊓ CFSG.ComponentClassification.OuterAutomorphisms.inner Xq := by
    refine ⟨⟨⟨e, heR⟩, rfl⟩, ?_⟩
    refine ⟨(QuotientGroup.mk' (Subgroup.center (Bar2 L)))
      (QuotientGroup.mk (⟨e, heL⟩ : ↥L)), ?_⟩
    rw [hρ_eq ⟨e, heR⟩ heL]
    exact (CFSG.ComponentClassification.OuterAutomorphisms.centerQuotient_conj
      (G := Bar2 L) (QuotientGroup.mk (⟨e, heL⟩ : ↥L))).symm
  have hρe_pow : (ρ ⟨e, heR⟩) ^ r = 1 := by
    rw [← map_pow]
    rw [show (⟨e, heR⟩ : ↥R) ^ r = 1 by
      apply Subtype.ext
      simpa using hEel.2 e he, map_one]
  have hab := hcomm (ρ ⟨e, heR⟩) hρe hρe_pow (ρ ⟨b, hb⟩) ⟨⟨b, hb⟩, rfl⟩
  have hρc : ρ ⟨c, hcR⟩ = 1 := by
    have hceq : (⟨e, heR⟩ * ⟨b, hb⟩ * ⟨e, heR⟩⁻¹ * ⟨b, hb⟩⁻¹ : ↥R) = ⟨c, hcR⟩ := by
      apply Subtype.ext
      show e * b * e⁻¹ * b⁻¹ = c
      rw [hc]
    rw [← hceq]
    simp only [map_mul, map_inv, hab]
    group
  have hcK : (⟨c, hcL⟩ : ↥L) ∈ K := by
    refine Subgroup.mem_comap.mpr ?_
    have hρc' : CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom (Bar2 L)
        (MulAut.conj (QuotientGroup.mk (⟨c, hcL⟩ : ↥L))) = 1 := by
      rw [← hρ_eq ⟨c, hcR⟩ hcL]
      exact hρc
    exact (r873om_centerQuotientHom_conj_eq_one_iff
      (QuotientGroup.mk (⟨c, hcL⟩ : ↥L))).1 hρc'
  obtain ⟨k, hk⟩ := hRp ⟨c, hcR⟩
  have hck : (⟨c, hcL⟩ : ↥L) ^ r ^ k = 1 := by
    apply Subtype.ext
    have hk' : c ^ (r ^ k) = 1 := by
      have := congrArg Subtype.val hk
      simpa using this
    simpa using hk'
  have hcop : Nat.Coprime (r ^ k) (Nat.card K) :=
    (hr.coprime_iff_not_dvd.mpr hnrK).pow_left k
  have hone : orderOf (⟨c, hcL⟩ : ↥L) = 1 :=
    Nat.eq_one_of_dvd_coprimes hcop (orderOf_dvd_of_pow_eq_one hck)
      (Subgroup.orderOf_dvd_natCard K hcK)
  have hone' : (⟨c, hcL⟩ : ↥L) = 1 := orderOf_eq_one_iff.mp hone
  have hc1 : c = 1 := congrArg Subtype.val hone'
  have hebeq : e * b = b * e := by
    have h : e * b * e⁻¹ * b⁻¹ = 1 := by rw [← hc]; exact hc1
    have h1 : e * b * e⁻¹ = b := by
      have := congrArg (fun x => x * b) h
      simpa [mul_assoc] using this
    have h2 : e * b = b * e := by
      have := congrArg (fun x => x * e) h1
      simpa [mul_assoc] using this
    exact h2
  exact hebeq.symm

private theorem r873tor_not_dvd_center {G : Type} [Group G] [Finite G]
    (hGA : GriessAllModelsStatement) {L : Subgroup G}
    {t : CFSG.Open.StatedLieTag} {n r : ℕ} (hr : r.Prime) (h5 : 5 ≤ r)
    (hdvd : (t = .PSL ∧ r ∣ 2 ^ n - 1) ∨ (t = .PSU ∧ r ∣ 2 ^ n + 1))
    (hsh : Shape3 (Bar2 L) t 2 n) :
    ¬ r ∣ Nat.card (Subgroup.center (Bar2 L)) := by
  have ht2 : t = .PSL ∨ t = .PSU := hdvd.elim (fun h => Or.inl h.1) (fun h => Or.inr h.1)
  have htclassical : t ∈ CFSG.Blueprint.classicalTags := by
    rcases ht2 with rfl | rfl <;> decide
  have hZ48 : Nat.card (Subgroup.center (Bar2 L)) ∣ 48 := by
    have hd := CFSG.RankThree.PartOne.card_center_dvd_of_model hGA
      ((CFSG.Quasithin.A3.isQuasisimple_iff_open (Q := Bar2 L)).2 hsh.1)
      (hsh.2.statedClassicalModel htclassical)
    have hg := r873om_generic_dvd_three (t := t) (n := n) ht2
    have he := r873om_exceptional_dvd_sixteen (t := t) (n := n) ht2
    exact hd.trans ((Nat.mul_dvd_mul hg he).trans (by norm_num))
  exact fun h => r873om_not_dvd_48 hr h5 (h.trans hZ48)

private theorem r873tor_two_le_pRank {G : Type} [Group G] [Finite G] {L : Subgroup G}
    {t : CFSG.Open.StatedLieTag} {n r : ℕ} (hr : r.Prime) (h5 : 5 ≤ r)
    (hdvd : (t = .PSL ∧ r ∣ 2 ^ n - 1) ∨ (t = .PSU ∧ r ∣ 2 ^ n + 1))
    (hsh : Shape3 (Bar2 L) t 2 n)
    (hZ : ¬ r ∣ Nat.card (Subgroup.center (Bar2 L))) :
    2 ≤ CFSG.Open.pRank r L := by
  have : Fact r.Prime := ⟨hr⟩
  have hr2 : r ≠ 2 := by rintro rfl; omega
  have hXq : 2 ≤ CFSG.Open.pRank r
      (⊤ : Subgroup (Bar2 L ⧸ Subgroup.center (Bar2 L))) := by
    rcases hdvd with ⟨ht, hd⟩ | ⟨ht, hd⟩
    · subst ht
      exact CFSG.Blueprint.LieModel.two_le_pRank_psl3_of_dvd hsh.2 hr hd
    · subst ht
      exact CFSG.Blueprint.LieModel.two_le_pRank_psu3_of_dvd hsh.2 hr hd
  rw [CFSG.SectionRank.pRank_quotient_eq (Subgroup.center (Bar2 L)) hZ,
    r873_pRank_bar2 L hr hr2] at hXq
  exact hXq

theorem r873_torus_false {G : Type} [Group G] [Finite G] {D : Data G}
    (hGA : GriessAllModelsStatement) (hSg : UC6S846.SigmaStd D) (h870 : R870 D)
    (h614 : UC6.R6_14 D) (h76 : UC22.F07.R76 D) (h638 : UC6.R6_38 D) (hOut : OutPComplement)
    (hOmega : OmegaCentral) {L X H : Subgroup G} (hmin : MinCex869 D L X H) (hLc : L ∈ calC D.M)
    {t : CFSG.Open.StatedLieTag} {n r : ℕ} (hr : r.Prime) (h5 : 5 ≤ r)
    (hdvd : (t = .PSL ∧ r ∣ 2 ^ n - 1) ∨ (t = .PSU ∧ r ∣ 2 ^ n + 1))
    (hsh : Shape3 (Bar2 L) t 2 n) : False := by
  classical
  have : Fact r.Prime := ⟨hr⟩
  have hr2 : r ≠ 2 := by rintro rfl; omega
  have hZ : ¬ r ∣ Nat.card (Subgroup.center (Bar2 L)) :=
    r873tor_not_dvd_center hGA hr h5 hdvd hsh
  have hmL : 2 ≤ CFSG.Open.pRank r L :=
    r873tor_two_le_pRank hr h5 hdvd hsh hZ
  have hX2 : 2 ≤ CFSG.Open.pRank r X := by
    rw [r873_pRank_X hmin.hyp.2.2.1 hr hr2]
    exact hmL
  have hML : D.M ≤ Subgroup.normalizer (L : Set G) :=
    r873_normal hSg h870 hmin hr hr2 hX2 hZ
  have hLM : L ≤ D.M := hLc.1.le
  obtain ⟨E, hEL, hEel, hEc⟩ :=
    UC6S846.exists_elemAbelian_card_of_le_pRank (M := L) hr (k := 2) hmL
  obtain ⟨S, hES⟩ := (hEel.isPGroup.comap_subtype (K := L)).exists_le_sylow
  let R₀ : Subgroup G := (S : Subgroup ↥L).map L.subtype
  have hR0 : IsSylowOf r R₀ L := ⟨S, rfl⟩
  have hER0 : E ≤ R₀ := by
    intro e he
    refine Subgroup.mem_map.mpr ⟨⟨e, hEL he⟩, hES ?_, rfl⟩
    exact he
  obtain ⟨R, hR, hRinf⟩ :=
    CFSG.GroupTheory.exists_isSylowOf_inf_eq_of_le (p := r) (M := D.M) (P := L)
      (Q0 := R₀) hLM hR0
  have hR0' : IsSylowOf r (R ⊓ L) L := by rw [hRinf]; exact hR0
  have hEQL : E ≤ R ⊓ L := by rw [hRinf]; exact hER0
  have hER : E ≤ R := hEQL.trans inf_le_left
  have hΓ : rankThreeGamma 1 r E ≤ D.M :=
    r873_gamma_all hSg h870 h76 h638 hOut hmin hLc hML hr hr2 hEL hEel hEc
  have hcen : E ≤ Subgroup.centralizer (R : Set G) :=
    r873_omega_central_lift hOmega hGA hr h5 hdvd hsh (hR.le.trans hML) hR.isPGroup
      hR0' hEel hEc hEQL
  exact r873_strong_false hSg h870 h614 hmin hLc hr hr2 hR hEL (le_inf hER hcen) hEel hEc hΓ

private theorem r873odf_rank_ge_four {G : Type} [Group G] [Finite G]
    {t : CFSG.Open.StatedLieTag} {p f : ℕ} (hp2 : p ≠ 2)
    (hf : 2 ≤ f) (h : StatedClassicalModel G t 3 p f) :
