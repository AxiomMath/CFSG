private theorem r873od1_two_le_pRank_of_card_exp {G : Type} [Group G] [Finite G]
    {Q : Subgroup G} {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hcard : Nat.card Q = p ^ 3) (hexp : ∀ x ∈ Q, x ^ p = 1) :
    2 ≤ CFSG.Open.pRank p Q := by
  have : Fact p.Prime := ⟨hp⟩
  have hQp : IsPGroup p ↥Q := by
    rw [isPGroup_iff_pow_pow_eq_one]
    intro x
    exact ⟨1, by simpa using Subtype.ext (hexp x x.2)⟩
  have hncyc : ¬ IsCyclic ↥Q := by
    intro hcyc
    obtain ⟨g, hg⟩ := (isCyclic_iff_exists_zpowers_eq_top (α := ↥Q)).mp hcyc
    have hgen : orderOf g = Nat.card ↥Q := orderOf_eq_card_of_zpowers_eq_top hg
    have hgpow : g ^ p = 1 := by
      apply Subtype.ext
      simpa using hexp (g : G) g.2
    have hdvd : orderOf g ∣ p := orderOf_dvd_of_pow_eq_one hgpow
    have hcarddvd : Nat.card ↥Q ∣ p := hgen ▸ hdvd
    have hle : Nat.card ↥Q ≤ p := Nat.le_of_dvd hp.pos hcarddvd
    have hge : p ^ 3 ≤ Nat.card ↥Q := by rw [hcard]
    have hlt : p < p ^ 3 := by
      simpa using (Nat.pow_lt_pow_right hp.one_lt (by norm_num : 1 < 3))
    omega
  have : Fact (IsPGroup p ↥Q) := ⟨hQp⟩
  obtain ⟨S, -, hScard, hSelem⟩ := CFSG.lemma_4_5_a (R := ↥Q) (p := p) hp2 hncyc
  let E : Subgroup G := S.map Q.subtype
  have hEcard : Nat.card E = p ^ 2 := by
    rw [Subgroup.card_map_of_injective Q.subtype_injective, hScard]
  have hEel : CFSG.Open.IsElemAbelian p E :=
    CFSG.SectionRank.isElemAbelian_map
      ((CFSG.SectionRank.isElementaryAbelian_iff_isElemAbelian p S).1 hSelem) Q.subtype
  exact CFSG.SectionRank.le_pRank hp.one_lt (Subgroup.map_subtype_le S) hEel (by rw [hEcard])

private theorem r873od1_Q_exp_card {G : Type} [Group G] [Finite G]
    {L Q : Subgroup G} {t : CFSG.Open.StatedLieTag} {p : ℕ}
    (hq : CFSG.Open.IsQuasisimple (Bar2 L)) (hp : p.Prime) (hp2 : p ≠ 2)
    (hZ : ¬ p ∣ Nat.card (Subgroup.center (Bar2 L)))
    (hInf : LieModel (BarInf L) t 3 p 1) (ht : t = .PSL ∨ t = .PSU)
    (hQ : IsSylowOf p Q L) :
    (∀ x ∈ Q, x ^ p = 1) ∧ Nat.card Q = p ^ 3 := by
  have : Fact p.Prime := ⟨hp⟩
  have hRnot : ¬ p ∣ Nat.card (CFSG.solvableRadical ↥L) :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.not_dvd_card_solvableRadical hq hp hp2 hZ
  have hfactBar : (Nat.card (BarInf L)).factorization p = 3 := by
    rcases ht with rfl | rfl
    · simpa using hInf.factorization_card_psl3 (f := 1)
    · simpa using hInf.factorization_card_psu3 (f := 1)
  have hcardL : Nat.card ↥L = Nat.card (BarInf L) * Nat.card (CFSG.solvableRadical ↥L) :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup (CFSG.solvableRadical ↥L)
  have hfactL : (Nat.card ↥L).factorization p = 3 := by
    rw [hcardL, Nat.factorization_mul (Nat.card_pos.ne') (Nat.card_pos.ne'),
      Finsupp.add_apply, Nat.factorization_eq_zero_of_not_dvd hRnot, add_zero, hfactBar]
  have hQcard : Nat.card Q = p ^ 3 := by rw [hQ.card_eq, hfactL]
  have hQpL : IsPGroup p (Q.subgroupOf L) := hQ.isPGroup.comap_subtype (K := L)
  have hQR : Q.subgroupOf L ⊓ CFSG.solvableRadical ↥L = ⊥ := by
    rw [← disjoint_iff]
    refine Subgroup.disjoint_of_coprime_natCard ?_
    obtain ⟨k, hk⟩ := hQpL.exists_card_eq
    rw [hk]
    exact (hp.coprime_iff_not_dvd.mpr hRnot).pow_left k
  have hQexp : ∀ x ∈ Q, x ^ p = 1 := by
    intro x hx
    let x' : ↥L := ⟨x, hQ.le hx⟩
    have hx'Q : x' ∈ Q.subgroupOf L := hx
    obtain ⟨k, hk⟩ := hQpL ⟨x', hx'Q⟩
    have hkx : x' ^ p ^ k = 1 := by simpa using congrArg Subtype.val hk
    have himg : ∃ k : ℕ,
        ((QuotientGroup.mk' (CFSG.solvableRadical ↥L)) x') ^ p ^ k = 1 := by
      refine ⟨k, ?_⟩
      rw [← map_pow, hkx, map_one]
    have hpow : ((QuotientGroup.mk' (CFSG.solvableRadical ↥L)) x') ^ p = 1 := by
      rcases ht with rfl | rfl
      · exact hInf.pow_eq_one_of_psl3 hp2 himg
      · exact hInf.pow_eq_one_of_psu3 hp2 himg
    have hmemR : x' ^ p ∈ CFSG.solvableRadical ↥L := by
      have h1 : (QuotientGroup.mk' (CFSG.solvableRadical ↥L)) (x' ^ p) = 1 := by
        rw [map_pow, hpow]
      exact (QuotientGroup.eq_one_iff (x' ^ p)).mp h1
    have hmemQ : x' ^ p ∈ Q.subgroupOf L := by
      rw [Subgroup.mem_subgroupOf]
      simpa using Q.pow_mem hx p
    have hbot : x' ^ p = 1 := by
      have hmem : x' ^ p ∈ Q.subgroupOf L ⊓ CFSG.solvableRadical ↥L := ⟨hmemQ, hmemR⟩
      rwa [hQR, Subgroup.mem_bot] at hmem
    simpa using congrArg Subtype.val hbot
  exact ⟨hQexp, hQcard⟩

private theorem r873od1_normalizer_Q_le {G : Type} [Group G] [Finite G] {D : Data G}
    (hSg : UC6S846.SigmaStd D) (h870 : R870 D) (h76 : UC22.F07.R76 D)
    (h638 : UC6.R6_38 D) (hOut : OutPComplement) {L X H : Subgroup G}
    (hmin : MinCex869 D L X H) (hLc : L ∈ calC D.M)
    (hML : D.M ≤ Subgroup.normalizer (L : Set G)) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    {Q : Subgroup G} (hQ : IsSylowOf p Q L)
    (hQ2 : 2 ≤ CFSG.Open.pRank p Q) (hZcard : Nat.card (Subgroup.center ↥Q) = p) :
    Subgroup.normalizer (Q : Set G) ≤ D.M := by
  have : Fact p.Prime := ⟨hp⟩
  let Z : Subgroup G := (Subgroup.center ↥Q).map Q.subtype
  have hZle : Z ≤ Q := Subgroup.map_subtype_le _
  have hZcard' : Nat.card Z = p := by
    rw [Subgroup.card_map_of_injective Q.subtype_injective]
    exact hZcard
  have hNQNZ : Subgroup.normalizer (Q : Set G) ≤ Subgroup.normalizer (Z : Set G) := by
    have hsub : Z.subgroupOf Q = Subgroup.center ↥Q := by
      ext x
      constructor
      · intro hx
        obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp (Subgroup.mem_subgroupOf.mp hx)
        rwa [Q.subtype_injective hyx] at hy
      · intro hx
        exact Subgroup.mem_subgroupOf.mpr (Subgroup.mem_map.mpr ⟨x, hx, rfl⟩)
    have hchar : (Z.subgroupOf Q).Characteristic := by rw [hsub]; infer_instance
    exact CFSG.CGT.PushingUp.normalizer_le_normalizer_of_characteristic' hZle hchar
  obtain ⟨E, hZE, hEQ, hEel, hEcard⟩ :=
    CFSG.GroupTheory.exists_isElemAbelian_card_sq_of_le_of_card_prime hQ.isPGroup hQ2 hZle hZcard'
  have hEL : E ≤ L := hEQ.trans hQ.le
  have hΓE : rankThreeGamma 1 p E ≤ D.M :=
    r873_gamma_all hSg h870 h76 h638 hOut hmin hLc hML hp hp2 hEL hEel hEcard
  have hZrank : 1 ≤ CFSG.Open.pRank p Z := by
    refine CFSG.SectionRank.le_pRank hp.one_lt le_rfl
      (CFSG.GroupTheory.isElemAbelian_of_card_prime hZcard') ?_
    rw [hZcard', pow_one]
  have hNZ : Subgroup.normalizer (Z : Set G) ≤ D.M :=
    (CFSG.HardMathSupport.Solomon.Proving.normalizer_le_glbCore hZE hZrank).trans hΓE
  exact hNQNZ.trans hNZ

private theorem r873od1_gamma_sylow {G : Type} [Group G] [Finite G] {D : Data G}
    (hSg : UC6S846.SigmaStd D) (h870 : R870 D) (h76 : UC22.F07.R76 D)
    (h638 : UC6.R6_38 D) (hOut : OutPComplement) {L X H : Subgroup G}
    (hmin : MinCex869 D L X H) (hLc : L ∈ calC D.M)
    (hML : D.M ≤ Subgroup.normalizer (L : Set G)) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    {Q : Subgroup G} (hQ : IsSylowOf p Q L) (hQ2 : 2 ≤ CFSG.Open.pRank p Q)
    (hQcard : Nat.card Q = p ^ 3) (hQexp : ∀ x ∈ Q, x ^ p = 1)
    (hNQ : Subgroup.normalizer (Q : Set G) ≤ D.M) :
    rankThreeGamma 1 p Q ≤ D.M := by
  have : Fact p.Prime := ⟨hp⟩
  refine CFSG.HardMathSupport.Solomon.Proving.GLBCore_le_of_forall ?_
  intro Y hYQ hY1
  by_cases hYeq : Y = Q
  · subst hYeq; exact hNQ
  · have hYlt : Y < Q := lt_of_le_of_ne hYQ hYeq
    have hYdvd : Nat.card Y ∣ p ^ 3 := by
      rw [← hQcard]; exact Subgroup.card_dvd_of_le hYQ
    obtain ⟨k, hk3, hk⟩ := (Nat.dvd_prime_pow hp).1 hYdvd
    have hYlt' : Nat.card Y < p ^ 3 := by
      rw [← hQcard]; exact Subgroup.card_lt_of_lt hYlt
    have hYge : p ≤ Nat.card Y :=
      Nat.le_of_dvd Nat.card_pos (CFSG.GroupTheory.dvd_card_of_one_le_pRank hp hY1)
    have hk1 : 1 ≤ k := by
      by_contra hk0
      have hk0' : k = 0 := by omega
      rw [hk, hk0', pow_zero] at hYge
      have := hp.two_le
      omega
    have hk2 : k ≤ 2 := by
      by_contra hk2
      have hk3' : k = 3 := by omega
      rw [hk, hk3'] at hYlt'
      exact lt_irrefl _ hYlt'
    obtain ⟨E, hYE, hEQ, hEel, hEcard⟩ :
        ∃ E, Y ≤ E ∧ E ≤ Q ∧ CFSG.Open.IsElemAbelian p E ∧ Nat.card E = p ^ 2 := by
      rcases (show k = 1 ∨ k = 2 by omega) with hk1' | hk2'
      · exact CFSG.GroupTheory.exists_isElemAbelian_card_sq_of_le_of_card_prime hQ.isPGroup hQ2 hYQ
          (by rw [hk, hk1', pow_one])
      · have hYab : IsMulCommutative Y :=
          IsPGroup.isMulCommutative_of_card_eq_prime_sq (by rw [hk, hk2'])
        refine ⟨Y, le_rfl, hYQ, ⟨hYab, fun a ha => hQexp a (hYQ ha)⟩, ?_⟩
        rw [hk, hk2']
    have hEL : E ≤ L := hEQ.trans hQ.le
    have hΓE : rankThreeGamma 1 p E ≤ D.M :=
      r873_gamma_all hSg h870 h76 h638 hOut hmin hLc hML hp hp2 hEL hEel hEcard
    exact (CFSG.HardMathSupport.Solomon.Proving.normalizer_le_glbCore hYE hY1).trans hΓE

theorem r873_odd_f1_false {G : Type} [Group G] [Finite G] {D : Data G}
    (hGA : GriessAllModelsStatement) (hSg : UC6S846.SigmaStd D) (h870 : R870 D)
    (h76 : UC22.F07.R76 D) (h638 : UC6.R6_38 D) (hOut : OutPComplement)
    (hY : Eight73YLieModel D) {L X H : Subgroup G} (hmin : MinCex869 D L X H)
    (hLc : L ∈ calC D.M) {t : CFSG.Open.StatedLieTag} (ht : t = .PSL ∨ t = .PSU) {p : ℕ}
    (hp2 : p ≠ 2) (hsh : Shape3 (Bar2 L) t p 1) : False := by
  classical
  have hp : p.Prime := hsh.2.admissible.1
  have : Fact p.Prime := ⟨hp⟩
  obtain ⟨e⟩ := CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p21k_barInf_equiv hsh.1
  have hInf : LieModel (BarInf L) t 3 p 1 :=
    CFSG.Blueprint.LieModel.of_mulEquiv e.symm hsh.2
  have hZ : ¬ p ∣ Nat.card (Subgroup.center (Bar2 L)) :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.uc22s213_not_dvd_card_center_of_rank_three_odd hGA hLc ht hp2 hInf
  obtain ⟨Q, hQ⟩ := CFSG.ABGLocalTools.exists_isSylowOf p L
  obtain ⟨hQexp, hQcard⟩ := r873od1_Q_exp_card hsh.1 hp hp2 hZ hInf ht hQ
  have hQ2 : 2 ≤ CFSG.Open.pRank p Q :=
    r873od1_two_le_pRank_of_card_exp hp hp2 hQcard hQexp
  have hQrank : CFSG.Open.pRank p Q ≤ 2 := by
    have hle : CFSG.Open.pRank p Q ≤ CFSG.Open.pRank p L :=
      CFSG.SectionRank.pRank_mono hp.one_lt hQ.le
    have hL : CFSG.Open.pRank p L = CFSG.Open.pRank p (⊤ : Subgroup (BarInf L)) := by
      rw [← r873_pRank_bar2 L hp hp2,
        ← CFSG.SectionRank.pRank_quotient_eq (p := p) (Subgroup.center (Bar2 L)) hZ,
        ← CFSG.SectionRank.pRank_top_eq_of_mulEquiv hp.one_lt e]
    rw [hL] at hle
    exact hle.trans (r873od1_pRank_barInf_le_two hp hInf ht hp2)
  have hnc : ∃ a b : Q, a * b ≠ b * a :=
    r873od1_nonabelian_of_pRank_le_two hQcard hQexp hQrank
  have hZcard : Nat.card (Subgroup.center ↥Q) = p :=
    r873od1_center_card hQcard hnc
  have hX2 : 2 ≤ CFSG.Open.pRank p X := by
    rw [r873_pRank_X hmin.hyp.2.2.1 hp hp2]
    exact hQ2.trans (CFSG.SectionRank.pRank_mono hp.one_lt hQ.le)
  have hX1 : 1 < CFSG.Open.pRank p X := by omega
  have hM3 : CFSG.Open.pRank p D.M ≤ 3 :=
    pRank_le_three_of_minCex hSg h870 hmin hp hp2 hX1
  have hML : D.M ≤ Subgroup.normalizer (L : Set G) :=
    r873_normal hSg h870 hmin hp hp2 hX2 hZ
  have hNQ : Subgroup.normalizer (Q : Set G) ≤ D.M :=
    r873od1_normalizer_Q_le hSg h870 h76 h638 hOut hmin hLc hML hp hp2 hQ hQ2 hZcard
  have hΓ : rankThreeGamma 1 p Q ≤ D.M :=
    r873od1_gamma_sylow hSg h870 h76 h638 hOut hmin hLc hML hp hp2 hQ hQ2 hQcard hQexp hNQ
  rcases ht with rfl | rfl
  · exact h870 L X H hmin p hp hp2 hX1 (hY hp2 hLc (Or.inl hInf) hM3 hQ hΓ)
  · exact h870 L X H hmin p hp hp2 hX1 (hY hp2 hLc (Or.inr hInf) hM3 hQ hΓ)

theorem r873_odd_false {G : Type} [Group G] [Finite G] {D : Data G}
    (hGA : GriessAllModelsStatement) (hSg : UC6S846.SigmaStd D) (h870 : R870 D)
    (h76 : UC22.F07.R76 D) (h638 : UC6.R6_38 D) (hOut : OutPComplement)
    (hY : Eight73YLieModel D) {L X H : Subgroup G} (hmin : MinCex869 D L X H)
    (hLc : L ∈ calC D.M) {t : CFSG.Open.StatedLieTag} (ht : t = .PSL ∨ t = .PSU) {p f : ℕ}
    (hp2 : p ≠ 2) (hsh : Shape3 (Bar2 L) t p f) : False := by
  have hf : 1 ≤ f := hsh.2.admissible.2.1
  rcases Nat.lt_or_ge f 2 with h | h
  · have hf1 : f = 1 := by omega
    subst hf1
    exact r873_odd_f1_false hGA hSg h870 h76 h638 hOut hY hmin hLc ht hp2 hsh
  · exact r873_odd_f_false hGA hSg h870 hmin hLc ht hp2 h hsh

private theorem r873l2_outer_not_dvd {G : Type} [Group G] [Finite G] {L : Subgroup G}
    {s k : ℕ} (hs : s.Prime) (h5 : 5 ≤ s) (hk : k = 2 ∨ k = 3)
    (hLie : LieModel (Bar2 L) .PSL 2 s k) :
    ¬ s ∣ Nat.card (Outer (Bar2 L)) := by
  have : Fact s.Prime := ⟨hs⟩
  have hs2 : s ≠ 2 := by omega
  obtain ⟨F, hFf, -, e, -, hFcard⟩ :=
    CFSG.GH74.GLS.EvenSelP.exists_l2Field_of_lieModel' hs hs2 hLie
  let : Field F := hFf
  have hdvd : Nat.card (Outer (Bar2 L)) ∣ k * Nat.gcd 2 (s ^ k - 1) :=
    (CFSG.LocalAnalysis.ComponentInitial.linear_two_outer_order_divisor hs F hFcard).2
      (Bar2 L) ⟨CFSG.GH74.GLS.IVK.toPSL e⟩
  have hnot : ¬ s ∣ k * Nat.gcd 2 (s ^ k - 1) := by
    intro hd
    rcases hs.dvd_mul.mp hd with h1 | h1
    · rcases hk with rfl | rfl
      · have := Nat.le_of_dvd (by norm_num : 0 < 2) h1
        omega
      · have := Nat.le_of_dvd (by norm_num : 0 < 3) h1
        omega
    · have := Nat.le_of_dvd (by norm_num : 0 < 2)
        (h1.trans (Nat.gcd_dvd_left 2 (s ^ k - 1)))
      omega
  intro hsO
  exact hnot (hsO.trans hdvd)

private theorem r873l2_inf_commutative {G : Type} [Group G] [Finite G] {L R : Subgroup G}
    (hab : IsMulCommutative (((R ⊓ L).subgroupOf L).map
      (QuotientGroup.mk' (CFSG.pCore 2 ↥L))))
    (hInt : R ⊓ L ⊓ CFSG.Open.pCoreOf 2 L = ⊥) :
    ∀ x ∈ R ⊓ L, ∀ y ∈ R ⊓ L, x * y = y * x := by
  intro x hx y hy
  have hxL : x ∈ L := hx.2
  have hyL : y ∈ L := hy.2
  let x' : ↥L := ⟨x, hxL⟩
  let y' : ↥L := ⟨y, hyL⟩
  have hxU : QuotientGroup.mk x' ∈ ((R ⊓ L).subgroupOf L).map
      (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) :=
    Subgroup.mem_map_of_mem _ (Subgroup.mem_subgroupOf.mpr hx)
  have hyU : QuotientGroup.mk y' ∈ ((R ⊓ L).subgroupOf L).map
      (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) :=
    Subgroup.mem_map_of_mem _ (Subgroup.mem_subgroupOf.mpr hy)
  have hcommSub :
      (⟨QuotientGroup.mk x', hxU⟩ : ↥(((R ⊓ L).subgroupOf L).map
          (QuotientGroup.mk' (CFSG.pCore 2 ↥L)))) *
        ⟨QuotientGroup.mk y', hyU⟩ =
      (⟨QuotientGroup.mk y', hyU⟩ : ↥(((R ⊓ L).subgroupOf L).map
          (QuotientGroup.mk' (CFSG.pCore 2 ↥L)))) *
        ⟨QuotientGroup.mk x', hxU⟩ :=
    isMulCommutative_iff.mp hab _ _
  have hcomm : (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) x' *
        (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) y' =
      (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) y' *
        (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) x' :=
    congrArg Subtype.val hcommSub
  have hker : x' * y' * x'⁻¹ * y'⁻¹ ∈ CFSG.pCore 2 ↥L := by
    rw [← QuotientGroup.eq_one_iff]
    show (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) (x' * y' * x'⁻¹ * y'⁻¹) = 1
    rw [map_mul, map_mul, map_mul, map_inv, map_inv, hcomm]
    group
  have hmemR : x * y * x⁻¹ * y⁻¹ ∈ R ⊓ L :=
    ⟨R.mul_mem (R.mul_mem (R.mul_mem hx.1 hy.1) (R.inv_mem hx.1)) (R.inv_mem hy.1),
      L.mul_mem (L.mul_mem (L.mul_mem hxL hyL) (L.inv_mem hxL)) (L.inv_mem hyL)⟩
  have hmemO : x * y * x⁻¹ * y⁻¹ ∈ CFSG.Open.pCoreOf 2 L := by
    have hz : ((x' * y' * x'⁻¹ * y'⁻¹ : ↥L) : G) = x * y * x⁻¹ * y⁻¹ := rfl
    rw [← hz]
    exact Subgroup.mem_map_of_mem L.subtype hker
  have hone : x * y * x⁻¹ * y⁻¹ = 1 := by
    have hbot : x * y * x⁻¹ * y⁻¹ ∈ (⊥ : Subgroup G) := by
      rw [← hInt]
      exact ⟨hmemR, hmemO⟩
    exact Subgroup.mem_bot.mp hbot
  calc x * y = (x * y * x⁻¹ * y⁻¹) * (y * x) := by group
    _ = 1 * (y * x) := by rw [hone]
    _ = y * x := one_mul _

private theorem r873l2_inf_le_center {G : Type} [Group G] [Finite G] {D : Data G}
    {L R : Subgroup G} {s k : ℕ} (hs : s.Prime) (h5 : 5 ≤ s) (hk : k = 2 ∨ k = 3)
    (hLie : LieModel (Bar2 L) .PSL 2 s k)
    (hLM : L ≤ D.M) (hML : D.M ≤ Subgroup.normalizer (L : Set G))
    (hR : IsSylowOf s R D.M) (hR0 : IsSylowOf s (R ⊓ L) L) :
    (R ⊓ L).subgroupOf R ≤ Subgroup.center ↥R := by
  have : Fact s.Prime := ⟨hs⟩
  have hs2 : s ≠ 2 := by omega
  have houts : ¬ s ∣ Nat.card (Outer (Bar2 L)) := r873l2_outer_not_dvd hs h5 hk hLie
  have hRN : R ≤ Subgroup.normalizer (L : Set G) := hR.le.trans hML
  have hRinfN : R ≤ Subgroup.normalizer ((R ⊓ L : Subgroup G) : Set G) :=
    (le_inf le_normalizer hRN).trans Subgroup.inf_normalizer_le_normalizer_inf
  have hQnormP : ((R ⊓ L).subgroupOf R).Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer hRinfN
  have hdecomp : R ≤ (R ⊓ L) ⊔ centralizerBar R L :=
    le_sup_centralizerBar_of_inner_prime inf_le_left inf_le_right rfl hQnormP hR0
      hR.isPGroup hRN le_rfl fun x hx =>
        exists_conj_of_not_dvd_outer x (hRN hx)
          (hR.isPGroup.to_le (Subgroup.zpowers_le.mpr hx)) houts
  have hQO2 : R ⊓ L ⊓ CFSG.Open.pCoreOf 2 L = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    exact Subgroup.mem_bot.mpr (UC6S846.eq_one_of_mem_isPGroup_of_mem_isPGroup hs hs2
      (hR.isPGroup.to_inf_left (K := L)) (UC6S846.isPGroup_pCoreOf L) hx.1 hx.2)
  have hSylL : IsSylowOf s ((R ⊓ L).subgroupOf L) ⊤ := by
    have h1 := (CFSG.ABGLocalTools.isSylowOf_map_subtype_iff (p := s) L
      (A := (R ⊓ L).subgroupOf L) (B := ⊤)).1
    refine h1 ?_
    rw [Subgroup.map_subgroupOf_eq_of_le inf_le_right, Subgroup.map_top,
      Subgroup.range_subtype]
    exact hR0
  have hkerL : ¬ s ∣ Nat.card ↥(MonoidHom.ker
      (QuotientGroup.mk' (CFSG.pCore 2 ↥L) : ↥L →* Bar2 L)) := by
    rw [QuotientGroup.ker_mk']
    exact CFSG.GroupTheory.not_dvd_card_of_isPGroup
      (CFSG.pCore_isPGroup (p := 2) (G := ↥L)) hs hs2
  have hŪsyl : IsSylowOf s (((R ⊓ L).subgroupOf L).map
      (QuotientGroup.mk' (CFSG.pCore 2 ↥L))) ⊤ := by
    have h1 := CFSG.isSylowOf_map_of_not_dvd_card_ker
      (QuotientGroup.mk' (CFSG.pCore 2 ↥L))
