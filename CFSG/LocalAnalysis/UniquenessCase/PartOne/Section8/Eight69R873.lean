  rcases ht with rfl | rfl
  · obtain ⟨K, hfield, hfinite, hKcard, ⟨e⟩⟩ := hSCM.2
    let : Field K := hfield
    let : Finite K := hfinite
    have hK : Nat.card K = p := by rwa [pow_one] at hKcard
    rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv hp.one_lt e]
    exact r873od1_pRank_projSL_le_two hp hK
  · obtain ⟨K, hfield, hfinite, hKcard, ⟨e⟩⟩ := hSCM.2
    let : Field K := hfield
    let : Finite K := hfinite
    have hK : Nat.card K = p ^ 2 := by rwa [pow_one] at hKcard
    rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv (G := BarInf L)
      (G' := StatedProj (StatedSU 3 (p ^ 1) K)) hp.one_lt e]
    rw [pow_one]
    exact r873od1_pRank_projSU_le_two hp hp2 hK

private theorem r873od1_nonabelian_of_pRank_le_two {G : Type} [Group G] [Finite G]
    {Q : Subgroup G} {p : ℕ} [Fact p.Prime] (hcard : Nat.card Q = p ^ 3)
    (hexp : ∀ x ∈ Q, x ^ p = 1) (hrank : CFSG.Open.pRank p Q ≤ 2) :
