theorem r873CaseB_of_inputs {G : Type} [Group G] [Finite G] {D : Data G}
    (hGA : GriessAllModelsStatement) (hSg : UC6S846.SigmaStd D) (h870 : R870 D) (h871 : R871 D)
    (h614 : UC6.R6_14 D) (h76 : UC22.F07.R76 D) (h638 : UC6.R6_38 D) (hOut : OutPComplement)
    (hOmega : OmegaCentral) (hY : Eight73YLieModel D) {L X H : Subgroup G}
    (hmin : MinCex869 D L X H) (h2 : 2 ≤ CFSG.Open.pRank 3 X) :
    IsSL3 (Bar2 X) 2 ∨ IsSU3 (Bar2 X) 3 := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨P, hP⟩ := CFSG.ABGLocalTools.exists_isSylowOf 3 X
  rcases h871 L X H hmin P hP with h1 | ⟨hPi, -⟩
  · omega
  obtain ⟨p, f, hpf⟩ := r873_shape3_of_sl3PiType hPi
  obtain ⟨e⟩ := nonempty_bar2_equiv_of_sup_pCore L X hmin.hyp.2.2.1
  rcases hpf with ⟨hmod, hsh⟩ | ⟨hmod, hsh⟩
  ·
    have hshL : Shape3 (Bar2 L) .PSL p f := Shape3.of_mulEquiv e hsh
    have hLc : L ∈ calC D.M := r873_calC_of_quasisimple hmin.hyp hshL.1
    have hadm := hsh.2.admissible
    by_cases hp2 : p = 2
    · subst hp2
      have hfe : Even f := by
        rcases r873_two_pow_mod_three f with ⟨he', _⟩ | ⟨_, hm⟩
        · exact he'
        · omega
      obtain ⟨k, hk⟩ := hfe
      have hf1 : 1 ≤ f := hadm.2.1
      by_cases hf2 : f = 2
      · subst hf2
        exact Or.inl hsh
      · obtain ⟨r, hr, h5, hdvd⟩ :=
          r873_exists_prime_pow_sub_even (f := f) (by omega) ⟨k, hk⟩
        exact (r873_torus_false hGA hSg h870 h614 h76 h638 hOut hOmega hmin hLc hr h5
          (Or.inl ⟨rfl, hdvd⟩) hshL).elim
    · exact (r873_odd_false hGA hSg h870 h76 h638 hOut hY hmin hLc (Or.inl rfl) hp2 hshL).elim
  ·
    have hshL : Shape3 (Bar2 L) .PSU p f := Shape3.of_mulEquiv e hsh
    have hLc : L ∈ calC D.M := r873_calC_of_quasisimple hmin.hyp hshL.1
    have hadm := hsh.2.admissible
    by_cases hp2 : p = 2
    · subst hp2
      have hfo : Odd f := by
        rcases r873_two_pow_mod_three f with ⟨_, hm⟩ | ⟨ho, _⟩
        · omega
        · exact ho
      obtain ⟨k, hk⟩ := hfo
      obtain ⟨-, hf1, -, hne⟩ := hadm
      have hf1' : f ≠ 1 := fun h => hne (by simp [h])
      by_cases hf3 : f = 3
      · subst hf3
        exact Or.inr hsh
      · obtain ⟨r, hr, h5, hdvd⟩ :=
          r873_exists_prime_pow_add_odd (f := f) (by omega) ⟨k, hk⟩
        exact (r873_torus_false hGA hSg h870 h614 h76 h638 hOut hOmega hmin hLc hr h5
          (Or.inr ⟨rfl, hdvd⟩) hshL).elim
    · exact (r873_odd_false hGA hSg h870 h76 h638 hOut hY hmin hLc (Or.inr rfl) hp2 hshL).elim

theorem r873CaseA_of_inputs {G : Type} [Group G] [Finite G] {D : Data G}
    (hGA : GriessAllModelsStatement) (hSp : CFSG.CGT.PushingUpLit.CGT6.SporadicThreeCenterSmallPrimes)
    (hK32 : UCK.K32) (hSg : UC6S846.SigmaStd D)
    (h870 : R870 D) (h614 : UC6.R6_14 D) (h76 : UC22.F07.R76 D) (h638 : UC6.R6_38 D)
    (hOut : OutPComplement) (hOmega : OmegaCentral) (hY : Eight73YLieModel D)
    {L X H : Subgroup G} (hmin : MinCex869 D L X H) (h3 : CFSG.Open.pRank 3 X = 1) : False := by
  by_cases hL : L ∈ calC D.M
  · have hq : CFSG.Open.IsQuasisimple (Bar2 L) := hL.2.2
    have hLne : L ≠ ⊤ := by
      intro htop
      exact CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p20a_M_ne_top D
        (top_le_iff.mp (htop ▸ hL.1.le))
    have hKL : CFSG.Open.IsKGroup ↥L := D.standing.kProper.isKGroup L hLne
    have hX3 : CFSG.Open.pRank 3 L = 1 := by
      rw [← r873_pRank_X hmin.hyp.2.2.1 Nat.prime_three (by norm_num)]
      exact h3
    have hnt : ¬ ∀ q : ℕ, q.Prime → q ≠ 2 → CFSG.Open.pRank q L ≤ 1 := hmin.hyp.2.2.2
    have hle : ∀ q : ℕ, q.Prime → q ≠ 2 → 2 ≤ CFSG.Open.pRank q L →
        CFSG.Open.pRank q L ≤ 3 := by
      intro q hq hq2 h2
      have hX : 1 < CFSG.Open.pRank q X := by
        rw [r873_pRank_X hmin.hyp.2.2.1 hq hq2]
        omega
      exact (CFSG.SectionRank.pRank_mono hq.one_lt hL.1.le).trans
        (pRank_le_three_of_minCex hSg h870 hmin hq hq2 hX)
    obtain ⟨hSK, hnab, h3S⟩ := r873_A_simple hKL hq hX3
    have hS32 := hK32 (Bar2 L ⧸ Subgroup.center (Bar2 L)) hSK hq.2 hnab h3S
    rcases r873_A_sort hGA hSp hq hX3 hnt hle hS32 with
      ⟨t, p, f, ht, hp2, hsh⟩ | ⟨f, ⟨hodd, h3f, hsh⟩ | ⟨heven, h2f, hsh⟩⟩ |
        ⟨s, k, hs, h5, hk, hsh⟩
    · exact r873_odd_false hGA hSg h870 h76 h638 hOut hY hmin hL ht hp2 hsh
    · obtain ⟨r, hr, h5, hdvd⟩ := r873_exists_prime_pow_sub_odd h3f hodd
      exact r873_torus_false hGA hSg h870 h614 h76 h638 hOut hOmega hmin hL hr h5
        (Or.inl ⟨rfl, hdvd⟩) hsh
    · obtain ⟨r, hr, h5, hdvd⟩ := r873_exists_prime_pow_add_even h2f heven
      exact r873_torus_false hGA hSg h870 h614 h76 h638 hOut hOmega hmin hL hr h5
        (Or.inr ⟨rfl, hdvd⟩) hsh
    · exact r873_L2_false hGA hSg h870 h614 h76 h638 hOut hmin hL hs h5 hk hsh
  · obtain ⟨-, -, k, S, hS, hLset⟩ := hmin.hyp.1.resolve_left hL
    by_cases hall : ∀ i, Thin8 (S i)
    · obtain ⟨S₁, S₂, hS₁, hS₂, hT₁, hT₂, hLS, hN₁, hN₂, hcomm, -, -, q, hq, hq2, h₁, h₂⟩ :=
        r873_prod_shape hmin h3 hL hS hLset hall
      exact r873_prod_two_false hSg h870 h614 h76 h638 hOut hmin hS₁ hS₂ hT₁ hT₂ hLS hN₁ hN₂
        hcomm hq hq2 h₁ h₂
    · push Not at hall
      obtain ⟨i, hi⟩ := hall
      exact r873_prod_nonthin_false hmin hL hS hLset i hi

theorem r873Mod_of_inputs {G : Type} [Group G] [Finite G] {D : Data G}
    (hGA : GriessAllModelsStatement) (hSp : CFSG.CGT.PushingUpLit.CGT6.SporadicThreeCenterSmallPrimes)
    (hK32 : UCK.K32) (hSg : UC6S846.SigmaStd D)
    (h870 : R870 D) (h871 : R871 D) (h872 : R872 D) (h614 : UC6.R6_14 D)
    (h76 : UC22.F07.R76 D) (h638 : UC6.R6_38 D) (hOut : OutPComplement)
    (hOmega : OmegaCentral) (hY : Eight73YLieModel D) : R873Mod D := by
  intro L X H hmin
  have h1 : 1 ≤ CFSG.Open.pRank 3 X := h872 L X H hmin
  by_cases h2 : 2 ≤ CFSG.Open.pRank 3 X
  · exact ⟨h2, r873CaseB_of_inputs hGA hSg h870 h871 h614 h76 h638 hOut hOmega hY hmin h2⟩
  · exact (r873CaseA_of_inputs hGA hSp hK32 hSg h870 h614 h76 h638 hOut hOmega hY hmin
      (by omega)).elim

