    exact hfourL
  have hle3 := pRank_le_three_of_minCex hSg h870 hmin hp hp2 (by omega)
  have hfourM : 4 ≤ CFSG.Open.pRank p D.M :=
    hfourL.trans (CFSG.SectionRank.pRank_mono hp.one_lt (CFSG.Quasithin.A3.subnormal_le hLc.1))
  omega

private theorem r873od1_pRank_projSU_le_two {K : Type} [Field K] [Finite K] {p : ℕ}
    (hp : p.Prime) (_hp2 : p ≠ 2) (hK : Nat.card K = p ^ 2) :
    CFSG.Open.pRank p (⊤ : Subgroup (StatedProj (StatedSU 3 p K))) ≤ 2 := by
  have : Fact p.Prime := ⟨hp⟩
  obtain ⟨J, hJ, -, hfix0⟩ :=
    CFSG.UnitaryThreeRecognition.Model.exists_standardHermitianForm (K := K) p 1 (by rwa [pow_one])
  have hfix : Nat.card {x : K // J.conj x = x} = p := by rwa [pow_one] at hfix0
  obtain ⟨e⟩ := CFSG.UnitaryThreeRecognition.Model.nonempty_psu_equiv_statedProj J p hK hfix
  rw [← CFSG.SectionRank.pRank_top_eq_of_mulEquiv hp.one_lt e]
  have hrootcard : Nat.card (CFSG.UnitaryThreeRecognition.Model.rootGroup J hJ) = p ^ 3 :=
    (CFSG.UnitaryThreeRecognition.Model.huppert_explicit J hJ p hK hfix).2.2.2.2.2.2.2.1
  have hcomm : commutator (CFSG.UnitaryThreeRecognition.Model.rootGroup J hJ) =
      Subgroup.center (CFSG.UnitaryThreeRecognition.Model.rootGroup J hJ) :=
    (CFSG.UnitaryThreeRecognition.Model.huppert_explicit J hJ p hK hfix).2.2.2.2.2.2.2.2.1
  have hcommcard : Nat.card (commutator
      (CFSG.UnitaryThreeRecognition.Model.rootGroup J hJ)) = p :=
    (CFSG.UnitaryThreeRecognition.Model.huppert_explicit J hJ p hK hfix).2.2.2.2.2.2.2.2.2.1
  have hcentercard : Nat.card (Subgroup.center
      (CFSG.UnitaryThreeRecognition.Model.rootGroup J hJ)) = p := by
    rw [← hcomm]; exact hcommcard
  refine CFSG.SectionRank.pRank_le hp.one_lt ?_
  intro E _ hEel
  obtain ⟨g, hg⟩ := CFSG.RankThree.PartTwo.Sec20.F3U3.exists_le_conj_rootGroup J hJ hK hfix
    (CFSG.Open.IsElemAbelian.isPGroup hEel)
  set R : Subgroup (CFSG.BenderSuzuki.MatrixGroups.ProjectiveSpecialUnitaryMatrixGroup J) :=
    (CFSG.UnitaryThreeRecognition.Model.rootGroup J hJ).map (MulAut.conj g).toMonoidHom with hR
  have hcardR : Nat.card R = p ^ 3 := by
    rw [hR, Subgroup.card_map_of_injective (MulAut.conj g).injective, hrootcard]
  have hdvd : Nat.card E ∣ p ^ 3 := by
    rw [← hcardR]; exact Subgroup.card_dvd_of_le hg
  have hne : E ≠ R := by
    intro heq
    have hRcomm : IsMulCommutative R := heq ▸ hEel.1
    have hrootcomm : IsMulCommutative
        (CFSG.UnitaryThreeRecognition.Model.rootGroup J hJ) := by
      refine ⟨⟨fun a b => ?_⟩⟩
      have ha : (MulAut.conj g) (a : CFSG.BenderSuzuki.MatrixGroups.ProjectiveSpecialUnitaryMatrixGroup J) ∈ R :=
        ⟨a, a.2, rfl⟩
      have hb : (MulAut.conj g) (b : CFSG.BenderSuzuki.MatrixGroups.ProjectiveSpecialUnitaryMatrixGroup J) ∈ R :=
        ⟨b, b.2, rfl⟩
      have h := hRcomm.is_comm.comm
        ⟨(MulAut.conj g) (a : CFSG.BenderSuzuki.MatrixGroups.ProjectiveSpecialUnitaryMatrixGroup J), ha⟩
        ⟨(MulAut.conj g) (b : CFSG.BenderSuzuki.MatrixGroups.ProjectiveSpecialUnitaryMatrixGroup J), hb⟩
      refine Subtype.ext ?_
      have h' : (MulAut.conj g)
          ((a : CFSG.BenderSuzuki.MatrixGroups.ProjectiveSpecialUnitaryMatrixGroup J) *
            (b : CFSG.BenderSuzuki.MatrixGroups.ProjectiveSpecialUnitaryMatrixGroup J)) =
          (MulAut.conj g)
          ((b : CFSG.BenderSuzuki.MatrixGroups.ProjectiveSpecialUnitaryMatrixGroup J) *
            (a : CFSG.BenderSuzuki.MatrixGroups.ProjectiveSpecialUnitaryMatrixGroup J)) := by
        rw [map_mul, map_mul]
        exact congrArg Subtype.val h
      exact (MulAut.conj g).injective h'
    rw [Subgroup.center_eq_top, Subgroup.card_top, hrootcard] at hcentercard
    exact absurd hcentercard (by intro hc; nlinarith [hp.two_le])
  have hlt : Nat.card E < p ^ 3 := by
    by_contra hge
    have heq : Nat.card E = p ^ 3 := by
      refine le_antisymm ?_ (by omega)
      rw [← hcardR]
      exact card_le_of_le hg
    exact hne (Subgroup.eq_of_le_of_card_ge hg (by rw [heq, hcardR]))
  obtain ⟨k, hk3, hk⟩ := (Nat.dvd_prime_pow hp).1 hdvd
  have hk2 : k ≤ 2 := by
    by_contra hk2
    have hk3' : k = 3 := by omega
    rw [hk, hk3'] at hlt
    exact lt_irrefl _ hlt
  rw [hk]
  exact Nat.pow_le_pow_right hp.pos hk2

private theorem r873od1_pRank_projSL_le_two {K : Type} [Field K] [Finite K] {p : ℕ}
    (hp : p.Prime) (hK : Nat.card K = p) :
    CFSG.Open.pRank p (⊤ : Subgroup (StatedProj (StatedSL 3 K))) ≤ 2 := by
  have : Fact p.Prime := ⟨hp⟩
  have : Fintype K := Fintype.ofFinite K
  have : CharP K p := charP_of_card_eq_prime (by rw [← Nat.card_eq_fintype_card, hK])
  have h1 : CFSG.Open.pRank p (StatedSL 3 K) = 1 * (3 ^ 2 / 4) :=
    CFSG.HardMathSupport.GuralnickMalle.pRank_statedSL 3 p 1 K hp (by rw [pow_one]; exact hK)
  have h2 : 3 ^ 2 / 4 = 2 := by norm_num
  rw [h2, one_mul] at h1
  have hN : ¬ p ∣ Nat.card ((StatedScalars (Fin 3) K).subgroupOf (StatedSL 3 K)) := by
    refine CFSG.Open.StatedAPI.not_dvd_card_statedScalars_subgroupOf (M := StatedSL 3 K)
      (d := Nat.card K - 1) hp ?_ ?_
    · rw [hK]
      intro hd
      have h1 : p ∣ p - (p - 1) := Nat.dvd_sub (dvd_refl p) hd
      rw [Nat.sub_sub_self hp.one_le] at h1
      exact hp.not_dvd_one h1
    · intro c _
      have hcardU : Nat.card Kˣ = Nat.card K - 1 := Nat.card_units K
      rw [← hcardU]
      exact pow_card_eq_one' (x := c)
  rw [CFSG.SectionRank.pRank_quotient_eq (p := p)
    ((StatedScalars (Fin 3) K).subgroupOf (StatedSL 3 K)) hN]
  rw [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup (StatedSL 3 K)]
  omega

private theorem r873od1_pRank_barInf_le_two {G : Type} [Group G] [Finite G]
    {L : Subgroup G} {t : CFSG.Open.StatedLieTag} {p : ℕ} (hp : p.Prime)
    (hInf : LieModel (BarInf L) t 3 p 1) (ht : t = .PSL ∨ t = .PSU) (hp2 : p ≠ 2) :
    CFSG.Open.pRank p (⊤ : Subgroup (BarInf L)) ≤ 2 := by
