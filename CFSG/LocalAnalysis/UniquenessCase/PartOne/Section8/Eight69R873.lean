  · rcases hb with ⟨hn, hle⟩ | ⟨hn, hle⟩ | hle
    · omega
    · omega
    · exact hle
  · rcases hb with ⟨hn, hle⟩ | hle
    · omega
    · exact hle
  · rcases hb with ⟨hn, hle⟩ | hle
    · omega
    · exact hle
  · exact hb

theorem r873_odd_f_false {G : Type} [Group G] [Finite G] {D : Data G}
    (hGA : GriessAllModelsStatement) (hSg : UC6S846.SigmaStd D) (h870 : R870 D)
    {L X H : Subgroup G} (hmin : MinCex869 D L X H) (hLc : L ∈ calC D.M)
    {t : CFSG.Open.StatedLieTag} (ht : t = .PSL ∨ t = .PSU) {p f : ℕ} (hp2 : p ≠ 2)
    (hf : 2 ≤ f) (hsh : Shape3 (Bar2 L) t p f) : False := by
  have htclassical : t ∈ CFSG.Blueprint.classicalTags := by
    rcases ht with rfl | rfl <;> decide
  obtain ⟨hp, hfour⟩ :=
    r873odf_rank_ge_four hp2 hf (hsh.2.statedClassicalModel htclassical)
  have hpZ : ¬ p ∣ Nat.card (Subgroup.center (Bar2 L)) := by
    obtain ⟨e⟩ := UC22.uc22p21k_barInf_equiv hLc.2.2
    exact UC22.uc22s213_not_dvd_card_center_of_rank_three_odd hGA hLc ht hp2
      (LieModel.of_mulEquiv e.symm hsh.2)
  have hquot : CFSG.Open.pRank p (⊤ : Subgroup (Bar2 L ⧸ Subgroup.center (Bar2 L))) =
      CFSG.Open.pRank p (⊤ : Subgroup (Bar2 L)) :=
    CFSG.SectionRank.pRank_quotient_eq (hp := ⟨hp⟩) (Subgroup.center (Bar2 L)) hpZ
  have hfourL : 4 ≤ CFSG.Open.pRank p L := by
    rw [← r873_pRank_bar2 L hp hp2, ← hquot]
    exact hfour
  have hfourX : 4 ≤ CFSG.Open.pRank p X := by
