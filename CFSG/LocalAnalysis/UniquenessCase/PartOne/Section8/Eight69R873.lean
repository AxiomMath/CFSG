  have hjoin : L = ⨆ j, S j := r873shp_join hS hLset
  have hSL : S i ≤ L := by rw [hjoin]; exact le_iSup S i
  exact ⟨CFSG.Quasithin.A3.subnormal_of_le_of_le (hS i).1 hSL hLM, (hS i).2.1, (hS i).2.2⟩

private theorem r873shp_calC_L_eq_range {G : Type} [Group G] [Finite G] {M L : Subgroup G} {k : ℕ}
    {S : Fin k → Subgroup G} (hS : ∀ i, S i ∈ UC22.calC M)
    (hLset : (L : Set G) = (List.ofFn fun i => (S i : Set G)).prod) (hLM : L ≤ M) :
    ∀ C ∈ UC22.calC L, ∃ i, C = S i := by
  intro C hC
  by_contra hcon
  push Not at hcon
  have hCbar : CFSG.IsComponent (UC22.barImage L C) := UC22.uc22p22l_barImage_isComponent hC
  have hSbar : ∀ i, CFSG.IsComponent (UC22.barImage L (S i)) :=
    fun i => UC22.uc22p22l_barImage_isComponent (r873shp_calC_L hS hLset hLM i)
  have hne : ∀ i, UC22.barImage L C ≠ UC22.barImage L (S i) := by
    intro i h
    exact hcon i (UC22.uc22p22u_calC_ext hC (r873shp_calC_L hS hLset hLM i) h)
  have hcomm : ∀ i, UC22.barImage L C ≤
      Subgroup.centralizer (UC22.barImage L (S i) : Set (Bar2 L)) := by
    intro i
    rcases CFSG.LocalCores.distinct_components_commute hCbar (hSbar i) with h | h
    · exact absurd h (hne i)
    · exact Subgroup.commutator_eq_bot_iff_le_centralizer.mp h
  have hle := CFSG.subgroup_le_centralizer_iSup_of_le_centralizer
    (fun i => UC22.barImage L (S i)) hcomm
  rw [r873shp_barImage_top hS hLset] at hle
  rw [Subgroup.coe_top] at hle
  have hle_self : UC22.barImage L C ≤ Subgroup.centralizer (UC22.barImage L C : Set (Bar2 L)) :=
    hle.trans (Subgroup.centralizer_le (Set.subset_univ _))
  have hbot_comm : ⁅UC22.barImage L C, UC22.barImage L C⁆ = ⊥ :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hle_self
  have hne_bot : UC22.barImage L C ≠ ⊥ :=
    CFSG.Quasithin.ne_bot_of_mem_cComp
      (CFSG.Quasithin.mem_cComp_top_of_isComponent hCbar)
  exact hne_bot (((Subgroup.isPerfect_iff).mp hCbar.1.1).symm.trans hbot_comm)

private theorem r873shp_conj_mem_range {G : Type} [Group G] [Finite G] {M L : Subgroup G} {k : ℕ}
    {S : Fin k → Subgroup G} (hS : ∀ i, S i ∈ UC22.calC M)
    (hLset : (L : Set G) = (List.ofFn fun i => (S i : Set G)).prod) (hLM : L ≤ M)
    (hML : M ≤ Subgroup.normalizer (L : Set G)) {m : G} (hm : m ∈ M) (i : Fin k) :
    ∃ j, uniqueFourConj m (S i) = S j := by
  have hSLi : S i ≤ L := by
    rw [r873shp_join hS hLset]; exact le_iSup S i
  have hconj : uniqueFourConj m (S i) ∈ UC22.calC M :=
    UC22.uc22p22u_calC_conj (Subgroup.le_normalizer) (hS i) hm
  have hminv : m⁻¹ ∈ Subgroup.normalizer (L : Set G) :=
    (Subgroup.normalizer (L : Set G)).inv_mem (hML hm)
  have hLmap : L.map (MulAut.conj m⁻¹).toMonoidHom = L :=
    (Subgroup.mem_normalizer_iff_map_conj_eq).mp hminv
  have hle : uniqueFourConj m (S i) ≤ L := by
    rw [uniqueFourConj, ← hLmap]
    exact Subgroup.map_mono hSLi
  exact r873shp_calC_L_eq_range hS hLset hLM _
    ⟨CFSG.Quasithin.A3.subnormal_of_le_of_le hconj.1 hle hLM, hconj.2.1, hconj.2.2⟩

private theorem r873shp_inf_centralizer_eq_center_map {X : Type} [Group X] (H : Subgroup X) :
    H ⊓ Subgroup.centralizer (H : Set X) = (Subgroup.center ↥H).map H.subtype := by
  ext x
  constructor
  · rintro ⟨hxH, hc⟩
    exact ⟨⟨x, hxH⟩,
      Subgroup.mem_center_iff.2 fun g => Subtype.ext (Subgroup.mem_centralizer_iff.1 hc (g : X) g.2),
      rfl⟩
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y.2, Subgroup.mem_centralizer_iff.2 fun g hg =>
      congrArg Subtype.val (Subgroup.mem_center_iff.1 hy ⟨g, hg⟩)⟩

private theorem r873shp_card_inf_centralizer {X : Type} [Group X] (H : Subgroup X) :
    Nat.card ↥(H ⊓ Subgroup.centralizer (H : Set X)) = Nat.card (Subgroup.center ↥H) := by
  rw [r873shp_inf_centralizer_eq_center_map, Subgroup.card_map_of_injective H.subtype_injective]

private theorem r873shp_pRank_barImage {G : Type} [Group G] [Finite G] {L K : Subgroup G}
    (hK : K ∈ UC22.calC L) {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) :
    CFSG.Open.pRank q (UC22.barImage L K) = CFSG.Open.pRank q K := by
  obtain ⟨e, -⟩ := UC22.uc22p22l_barImage_equiv hK
  have h1 : CFSG.Open.pRank q (⊤ : Subgroup (Bar2 K)) =
      CFSG.Open.pRank q (UC22.barImage L K) := by
    rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv hq.one_lt e,
      CFSG.SectionRank.pRank_eq_pRank_top_subgroup (UC22.barImage L K)]
  exact h1.symm.trans (r873_pRank_bar2 K hq hq2)

private theorem r873shp_not_dvd_center {G : Type} [Group G] [Finite G] {L : Subgroup G}
    {K : Subgroup G} (hK : K ∈ UC22.calC L) (hthin : Thin8 K) {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) :
    ¬ q ∣ Nat.card ↥(UC22.barImage L K ⊓
      Subgroup.centralizer (UC22.barImage L K : Set (Bar2 L))) := by
  rw [r873shp_card_inf_centralizer]
  have hqFact : Fact q.Prime := ⟨hq⟩
  have hJq : CFSG.Open.pRank q (UC22.barImage L K) ≤ 1 := by
    rw [r873shp_pRank_barImage hK hq hq2]
    exact hthin q hq hq2
  by_cases hdvd : q ∣ Nat.card ↥(UC22.barImage L K)
  · have hperfect : Group.IsPerfect ↥(UC22.barImage L K) :=
      (UC22.uc22p22l_barImage_isComponent hK).1.1
    have h1 : 1 ≤ CFSG.Open.pRank q (⊤ : Subgroup ↥(UC22.barImage L K)) := by
      obtain ⟨x, hxord⟩ := exists_prime_orderOf_dvd_card' q hdvd
      have hxq : x ^ q = 1 := by rw [← hxord]; exact pow_orderOf_eq_one x
      have hcard : Nat.card ↥(Subgroup.zpowers x) = q ^ 1 := by
        rw [Nat.card_zpowers, hxord, pow_one]
      exact CFSG.SectionRank.le_pRank hq.one_lt (H := (⊤ : Subgroup ↥(UC22.barImage L K)))
        (E := Subgroup.zpowers x) le_top (CFSG.Open.isElemAbelian_zpowers hxq) hcard
    have hrank1 : CFSG.Open.pRank q (⊤ : Subgroup ↥(UC22.barImage L K)) = 1 := by
      refine le_antisymm ?_ h1
      rwa [CFSG.SectionRank.pRank_eq_pRank_top_subgroup] at hJq
    exact CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.not_dvd_card_center_of_pRank_eq_one
      hq2 hrank1
  · exact fun h => hdvd (h.trans (Subgroup.card_subgroup_dvd_card _))

private theorem r873shp_pRank_conj {G : Type} [Group G] [Finite G] {A : Subgroup G} (m : G)
    {q : ℕ} (hq1 : 1 < q) :
    CFSG.Open.pRank q (uniqueFourConj m A) = CFSG.Open.pRank q A := by
  have e : A ≃* uniqueFourConj m A :=
    Subgroup.equivMapOfInjective A (MulAut.conj m⁻¹).toMonoidHom
      (MulAut.conj m⁻¹).injective
  rw [CFSG.SectionRank.pRank_eq_pRank_top_subgroup (uniqueFourConj m A),
    ← CFSG.SectionRank.pRank_top_eq_of_mulEquiv hq1 e,
    ← CFSG.SectionRank.pRank_eq_pRank_top_subgroup A]

private theorem r873shp_barImage_sup_pair {G : Type} [Group G] [Finite G] {L A B : Subgroup G}
    (hAL : A ≤ L) (hBL : B ≤ L) :
    UC22.barImage L (A ⊔ B) = UC22.barImage L A ⊔ UC22.barImage L B := by
  rw [UC22.barImage, UC22.barImage, UC22.barImage, Subgroup.subgroupOf_sup hAL hBL,
    Subgroup.map_sup]

private theorem r873shp_pRank_top_sum {G : Type} [Group G] [Finite G] {M L : Subgroup G} {k : ℕ}
    {S : Fin k → Subgroup G} (hS : ∀ i, S i ∈ UC22.calC M)
    (hLset : (L : Set G) = (List.ofFn fun i => (S i : Set G)).prod) (hLM : L ≤ M)
    (hthin : ∀ i, Thin8 (S i)) {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2)
    [DecidableEq (Subgroup G)] :
    CFSG.Open.pRank q (⊤ : Subgroup (Bar2 L)) =
      ∑ A ∈ (List.ofFn S).toFinset, CFSG.Open.pRank q A := by
  have htop : (⨆ A ∈ (List.ofFn S).toFinset, UC22.barImage L A) = ⊤ := by
    have h1 : (⨆ A ∈ (List.ofFn S).toFinset, UC22.barImage L A) =
        (⨆ A ∈ List.ofFn S, UC22.barImage L A) := by
      refine le_antisymm ?_ ?_
      · refine iSup₂_le fun A hA => ?_
        exact le_iSup₂ (f := fun A (_ : A ∈ List.ofFn S) => UC22.barImage L A) A
          (List.mem_toFinset.mp hA)
      · refine iSup₂_le fun A hA => ?_
        exact le_iSup₂ (f := fun A (_ : A ∈ (List.ofFn S).toFinset) => UC22.barImage L A) A
          (List.mem_toFinset.mpr hA)
    rw [h1]
    have h2 : (⨆ A ∈ List.ofFn S, UC22.barImage L A) = ⨆ i, UC22.barImage L (S i) := by
      refine le_antisymm ?_ ?_
      · refine iSup₂_le fun A hA => ?_
        obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hA
        exact le_iSup (fun i => UC22.barImage L (S i)) i
      · refine iSup_le fun i => ?_
        exact le_iSup₂ (f := fun A (_ : A ∈ List.ofFn S) => UC22.barImage L A) (S i)
          (List.mem_ofFn.mpr ⟨i, rfl⟩)
    rw [h2, r873shp_barImage_top hS hLset]
  have hmem : ∀ A ∈ (List.ofFn S).toFinset, A ∈ UC22.calC L := by
    intro A hA
    obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hA)
    exact hi ▸ r873shp_calC_L hS hLset hLM i
  have hcomm : ∀ A ∈ (List.ofFn S).toFinset, ∀ B ∈ (List.ofFn S).toFinset, A ≠ B →
      UC22.barImage L A ≤ Subgroup.centralizer (UC22.barImage L B : Set (Bar2 L)) := by
    intro A hA B hB hAB
    rcases CFSG.LocalCores.distinct_components_commute
      (UC22.uc22p22l_barImage_isComponent (hmem A hA))
      (UC22.uc22p22l_barImage_isComponent (hmem B hB)) with h | h
    · exfalso
      exact hAB (UC22.uc22p22u_calC_ext (hmem A hA) (hmem B hB) h)
    · exact Subgroup.commutator_eq_bot_iff_le_centralizer.mp h
  have hZ : ∀ A ∈ (List.ofFn S).toFinset, ¬ q ∣ Nat.card ↥(UC22.barImage L A ⊓
      Subgroup.centralizer (UC22.barImage L A : Set (Bar2 L))) := by
    intro A hA
    obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hA)
    exact hi ▸ r873shp_not_dvd_center (r873shp_calC_L hS hLset hLM i) (hthin i) hq hq2
  have hsum := CFSG.GroupTheory.pRank_iSup_eq_sum_of_commute_of_not_dvd hq
    (List.ofFn S).toFinset (fun A => UC22.barImage L A) hcomm hZ
  rw [htop] at hsum
  rw [hsum]
  refine Finset.sum_congr rfl fun A hA => ?_
  exact r873shp_pRank_barImage (hmem A hA) hq hq2

private theorem r873shp_card_filter_of_sum {ι : Type} (t : Finset ι) (f : ι → ℕ)
    (hf : ∀ A ∈ t, f A ≤ 1) (h2 : 2 ≤ ∑ A ∈ t, f A) :
    2 ≤ (t.filter fun A => 1 ≤ f A).card := by
  have hb : (∑ A ∈ t, if 1 ≤ f A then 1 else 0) =
      (t.filter fun A => 1 ≤ f A).card := by
    simp
  rw [← hb]
  refine h2.trans ?_
  refine Finset.sum_le_sum fun A hA => ?_
  have := hf A hA
  by_cases h : 1 ≤ f A
  · rw [if_pos h]; omega
  · rw [if_neg h]; omega

private theorem r873shp_card_filter_eq_one {ι : Type} (t : Finset ι) (f : ι → ℕ)
    (hf : ∀ A ∈ t, f A ≤ 1) (h1 : ∑ A ∈ t, f A = 1) :
    (t.filter fun A => 1 ≤ f A).card = 1 := by
  have hb : (∑ A ∈ t, if 1 ≤ f A then 1 else 0) =
      (t.filter fun A => 1 ≤ f A).card := by
    simp
  rw [← hb]
  trans ∑ A ∈ t, f A
  · refine Finset.sum_congr rfl fun A hA => ?_
    have := hf A hA
    by_cases h : 1 ≤ f A
    · rw [if_pos h]; omega
    · rw [if_neg h]; omega
  · exact h1

theorem r873shp_pRank_sum {G : Type} [Group G] [Finite G] {M L : Subgroup G} {k : ℕ}
    {S : Fin k → Subgroup G} (hS : ∀ i, S i ∈ UC22.calC M)
    (hLset : (L : Set G) = (List.ofFn fun i => (S i : Set G)).prod) (hLM : L ≤ M)
    (hthin : ∀ i, Thin8 (S i)) {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2)
    [DecidableEq (Subgroup G)] :
    CFSG.Open.pRank q L = ∑ A ∈ (List.ofFn S).toFinset, CFSG.Open.pRank q A := by
  rw [← r873_pRank_bar2 L hq hq2]
  exact r873shp_pRank_top_sum hS hLset hLM hthin hq hq2

private theorem r873shp_subgroupOf_pCoreOf {G : Type} [Group G] (L : Subgroup G) :
    (pCoreOf 2 L).subgroupOf L = CFSG.pCore 2 ↥L := by
  rw [pCoreOf]
  exact Subgroup.comap_map_eq_self_of_injective L.subtype_injective _

private theorem r873shp_barImage_sup_pCore {G : Type} [Group G] [Finite G] {L P : Subgroup G}
    (hPL : P ≤ L) :
    UC22.barImage L (P ⊔ pCoreOf 2 L) = UC22.barImage L P := by
  rw [UC22.barImage, UC22.barImage, Subgroup.subgroupOf_sup hPL (UC22.uc22p21c_pCoreOf_le L),
    Subgroup.map_sup, r873shp_subgroupOf_pCoreOf L]
  have hbot : (CFSG.pCore 2 ↥L).map (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) = ⊥ := by
    rw [Subgroup.map_eq_bot_iff]
    exact (QuotientGroup.ker_mk' _).ge
  rw [hbot, sup_bot_eq]

private theorem r873shp_barImage_iSup_finset {G : Type} [Group G] [Finite G] {L : Subgroup G}
    (s : Finset (Subgroup G)) (hs : ∀ A ∈ s, A ≤ L) :
    UC22.barImage L (⨆ A ∈ s, A) = ⨆ A ∈ s, UC22.barImage L A := by
  have h1 : (⨆ A ∈ s, A) = ⨆ A : {A // A ∈ s}, A.1 := iSup_subtype'
  have h2 : (⨆ A ∈ s, UC22.barImage L A) =
      ⨆ A : {A // A ∈ s}, UC22.barImage L A.1 := iSup_subtype'
  rw [h1, h2, UC22.barImage,
    CFSG.subgroupOf_iSup (fun A : {A // A ∈ s} => A.1) (fun A => hs A.1 A.2),
    Subgroup.map_iSup]
  rfl

private theorem r873shp_not_le_sup {G : Type} [Group G] [Finite G] {M L : Subgroup G} {k : ℕ}
    {S : Fin k → Subgroup G} (hS : ∀ i, S i ∈ UC22.calC M)
    (hLset : (L : Set G) = (List.ofFn fun i => (S i : Set G)).prod) (hLM : L ≤ M)
    [DecidableEq (Subgroup G)]
    (s : Finset (Subgroup G)) (hs : ∀ A ∈ s, A ∈ (List.ofFn S).toFinset)
    (hproper : ∃ C ∈ (List.ofFn S).toFinset, C ∉ s) :
    ¬ L ≤ (⨆ A ∈ s, A) ⊔ pCoreOf 2 L := by
  have hmemL : ∀ A ∈ (List.ofFn S).toFinset, A ∈ UC22.calC L := by
    intro A hA
    obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hA)
    exact hi ▸ r873shp_calC_L hS hLset hLM i
  intro hle
  obtain ⟨C, hCt, hCs⟩ := hproper
  have hCL : C ∈ UC22.calC L := hmemL C hCt
  have hCLle : C ≤ L := CFSG.Quasithin.A3.subnormal_le hCL.1
  have hsL : ∀ A ∈ s, A ≤ L := fun A hA =>
    CFSG.Quasithin.A3.subnormal_le (hmemL A (hs A hA)).1
  have hsLt : (⨆ A ∈ s, A) ≤ L := iSup₂_le hsL
  have hOC : C ≤ (⨆ A ∈ s, A) ⊔ pCoreOf 2 L := hCLle.trans hle
  have hLeq : L = (⨆ A ∈ s, A) ⊔ pCoreOf 2 L :=
    le_antisymm hle (sup_le hsLt (UC22.uc22p21c_pCoreOf_le L))
  have hcenter : UC22.barImage L C ≤
      Subgroup.centralizer (Set.univ : Set (Bar2 L)) := by
    have hcomm : ∀ A ∈ s, UC22.barImage L C ≤
        Subgroup.centralizer (UC22.barImage L A : Set (Bar2 L)) := by
      intro A hA
      have hAL : A ∈ UC22.calC L := hmemL A (hs A hA)
      have hne : C ≠ A := fun h => hCs (h ▸ hA)
      rcases CFSG.LocalCores.distinct_components_commute
        (UC22.uc22p22l_barImage_isComponent hCL)
        (UC22.uc22p22l_barImage_isComponent hAL) with h | h
      · exfalso
        exact hne (UC22.uc22p22u_calC_ext hCL hAL h)
      · exact Subgroup.commutator_eq_bot_iff_le_centralizer.mp h
    have hle' := CFSG.subgroup_le_centralizer_iSup_of_le_centralizer
      (fun A : {A // A ∈ s} => UC22.barImage L A.1)
      (fun A => hcomm A.1 A.2)
    have hsup_eq : (⨆ A : {A // A ∈ s}, UC22.barImage L A.1) =
        ⨆ A ∈ s, UC22.barImage L A := by
      refine le_antisymm ?_ ?_
      · refine iSup_le fun A => ?_
        exact le_iSup₂ (f := fun A (_ : A ∈ s) => UC22.barImage L A) A.1 A.2
      · refine iSup₂_le fun A hA => ?_
        exact le_iSup (fun A : {A // A ∈ s} => UC22.barImage L A.1) ⟨A, hA⟩
    rw [hsup_eq] at hle'
    have htop : (⨆ A ∈ s, UC22.barImage L A) = ⊤ := by
      rw [← r873shp_barImage_iSup_finset s hsL, ← r873shp_barImage_sup_pCore hsLt, ← hLeq,
        UC22.barImage, Subgroup.subgroupOf_self,
        Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
    rw [htop, Subgroup.coe_top] at hle'
    exact hle'
  have hbot_comm : ⁅UC22.barImage L C, UC22.barImage L C⁆ = ⊥ :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mpr
      (hcenter.trans (Subgroup.centralizer_le (Set.subset_univ _)))
  have hne_bot : UC22.barImage L C ≠ ⊥ :=
    CFSG.Quasithin.ne_bot_of_mem_cComp
      (CFSG.Quasithin.mem_cComp_top_of_isComponent (UC22.uc22p22l_barImage_isComponent hCL))
  exact hne_bot (((Subgroup.isPerfect_iff).mp
    (UC22.uc22p22l_barImage_isComponent hCL).1.1).symm.trans hbot_comm)

private theorem r873shp_barImage_iSup_set {G : Type} [Group G] [Finite G] {L : Subgroup G}
    (s : Set (Subgroup G)) (hs : ∀ A ∈ s, A ≤ L) :
    UC22.barImage L (⨆ A ∈ s, A) = ⨆ A ∈ s, UC22.barImage L A := by
  have h1 : (⨆ A ∈ s, A) = ⨆ A : s, A.1 := iSup_subtype'
  have h2 : (⨆ A ∈ s, UC22.barImage L A) = ⨆ A : s, UC22.barImage L A.1 := iSup_subtype'
  rw [h1, h2, UC22.barImage,
    CFSG.subgroupOf_iSup (fun A : s => A.1) (fun A => hs A.1 A.2),
    Subgroup.map_iSup]
  rfl

private theorem r873shp_conjClosure_cover {G : Type} [Group G] [Finite G] {M L : Subgroup G} {k : ℕ}
    {S : Fin k → Subgroup G} (hS : ∀ i, S i ∈ UC22.calC M)
    (hLset : (L : Set G) = (List.ofFn fun i => (S i : Set G)).prod) (hLM : L ≤ M)
    (hML : M ≤ Subgroup.normalizer (L : Set G)) [DecidableEq (Subgroup G)] (B : Subgroup G)
    (hB : B ∈ (List.ofFn S).toFinset)
    (hcover : L ≤ UC22.conjClosure M B ⊔ pCoreOf 2 L) :
    ∀ C ∈ (List.ofFn S).toFinset, ∃ m ∈ M, uniqueFourConj m B = C := by
  have hmemL : ∀ A ∈ (List.ofFn S).toFinset, A ∈ UC22.calC L := by
    intro A hA
    obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hA)
    exact hi ▸ r873shp_calC_L hS hLset hLM i
  have hCL : ∀ A ∈ (List.ofFn S).toFinset, A ≤ L := fun A hA =>
    CFSG.Quasithin.A3.subnormal_le (hmemL A hA).1
  have hmemM : ∀ A ∈ (List.ofFn S).toFinset, A ∈ UC22.calC M := by
    intro A hA
    obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hA)
    exact hi ▸ hS i
  have hconjL : ∀ K ∈ UC22.conjSetOf M B, K ∈ UC22.calC L := by
    rintro K ⟨g, hg, rfl⟩
    have hK : B.map (MulAut.conj g).toMonoidHom ∈ UC22.calC M := by
      have h := UC22.uc22p22u_calC_conj (Subgroup.le_normalizer) (hmemM B hB)
        (M.inv_mem hg)
      simpa only [uniqueFourConj, inv_inv] using h
    have hKL : B.map (MulAut.conj g).toMonoidHom ≤ L := by
      have hLmap : L.map (MulAut.conj g).toMonoidHom = L :=
        (Subgroup.mem_normalizer_iff_map_conj_eq).mp (hML hg)
      calc B.map (MulAut.conj g).toMonoidHom ≤ L.map (MulAut.conj g).toMonoidHom :=
            Subgroup.map_mono (hCL B hB)
        _ = L := hLmap
    exact ⟨CFSG.Quasithin.A3.subnormal_of_le_of_le hK.1 hKL hLM, hK.2.1, hK.2.2⟩
  have hcoverL : L = UC22.conjClosure M B ⊔ pCoreOf 2 L :=
    le_antisymm hcover
      (sup_le (UC22.uc22p22u_conjClosure_isProd hLM hML (hmemL B hB)).1
        (UC22.uc22p21c_pCoreOf_le L))
  intro C hC
  by_contra hcon
  push Not at hcon
  have hCL' : C ∈ UC22.calC L := hmemL C hC
  have hnotmem : C ∉ UC22.conjSetOf M B := by
    rintro ⟨g, hg, hgC⟩
    exact hcon g⁻¹ (M.inv_mem hg) (by
      rw [uniqueFourConj, hgC]; simp [inv_inv])
  have hbar_top : UC22.barImage L (UC22.conjClosure M B) = ⊤ := by
    rw [← r873shp_barImage_sup_pCore
        (UC22.uc22p22u_conjClosure_isProd hLM hML (hmemL B hB)).1,
      ← hcoverL, UC22.barImage, Subgroup.subgroupOf_self,
      Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
  have hcomm : ∀ K ∈ UC22.conjSetOf M B, UC22.barImage L C ≤
      Subgroup.centralizer (UC22.barImage L K : Set (Bar2 L)) := by
    intro K hK
    have hKL : K ∈ UC22.calC L := hconjL K hK
    have hne : C ≠ K := fun h => hnotmem (h ▸ hK)
    rcases CFSG.LocalCores.distinct_components_commute
      (UC22.uc22p22l_barImage_isComponent hCL')
      (UC22.uc22p22l_barImage_isComponent hKL) with h | h
    · exact absurd (UC22.uc22p22u_calC_ext hCL' hKL h) hne
    · exact Subgroup.commutator_eq_bot_iff_le_centralizer.mp h
  have hle' := CFSG.subgroup_le_centralizer_iSup_of_le_centralizer
    (fun K : UC22.conjSetOf M B => UC22.barImage L K.1) (fun K => hcomm K.1 K.2)
  have hsup_eq : (⨆ K : UC22.conjSetOf M B, UC22.barImage L K.1) =
      ⨆ K ∈ UC22.conjSetOf M B, UC22.barImage L K := by
    refine le_antisymm ?_ ?_
    · refine iSup_le fun K => ?_
      exact le_iSup₂ (f := fun K (_ : K ∈ UC22.conjSetOf M B) => UC22.barImage L K) K.1 K.2
    · refine iSup₂_le fun K hK => ?_
      exact le_iSup (fun K : UC22.conjSetOf M B => UC22.barImage L K.1) ⟨K, hK⟩
  rw [hsup_eq] at hle'
  have hbar_conj : (⨆ K ∈ UC22.conjSetOf M B, UC22.barImage L K) =
      UC22.barImage L (UC22.conjClosure M B) := by
    rw [UC22.conjClosure]
    exact (r873shp_barImage_iSup_set (UC22.conjSetOf M B)
      (fun K hK => (hconjL K hK).1.le)).symm
  rw [hbar_conj, hbar_top, Subgroup.coe_top] at hle'
  have hbot_comm : ⁅UC22.barImage L C, UC22.barImage L C⁆ = ⊥ :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mpr
      (hle'.trans (Subgroup.centralizer_le (Set.subset_univ _)))
  have hne_bot : UC22.barImage L C ≠ ⊥ :=
    CFSG.Quasithin.ne_bot_of_mem_cComp
      (CFSG.Quasithin.mem_cComp_top_of_isComponent (UC22.uc22p22l_barImage_isComponent hCL'))
  exact hne_bot (((Subgroup.isPerfect_iff).mp
    (UC22.uc22p22l_barImage_isComponent hCL').1.1).symm.trans hbot_comm)

private theorem r873shp_fixed {G : Type} [Group G] [Finite G] {D : Data G} {L X H : Subgroup G}
    {k : ℕ} {S : Fin k → Subgroup G} (hmin : MinCex869 D L X H) (hL : L ∉ UC22.calC D.M)
    (hS : ∀ i, S i ∈ UC22.calC D.M)
    (hLset : (L : Set G) = (List.ofFn fun i => (S i : Set G)).prod)
    (hthin : ∀ i, Thin8 (S i)) (h3L : CFSG.Open.pRank 3 L = 1)
    [DecidableEq (Subgroup G)] (h2t : 2 ≤ (List.ofFn S).toFinset.card) :
    ∀ A ∈ (List.ofFn S).toFinset, ∀ m ∈ D.M, uniqueFourConj m A = A := by
  have hdata := hmin.hyp.1.resolve_left hL
  have hLM : L ≤ D.M := hdata.1
  have hML : D.M ≤ Subgroup.normalizer (L : Set G) := hdata.2.1
  have hmemL : ∀ A ∈ (List.ofFn S).toFinset, A ∈ UC22.calC L := by
    intro A hA
    obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hA)
    exact hi ▸ r873shp_calC_L hS hLset hLM i
  have hmemM : ∀ A ∈ (List.ofFn S).toFinset, A ∈ UC22.calC D.M := by
    intro A hA
    obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hA)
    exact hi ▸ hS i
  intro A hA m hm
  by_contra hne
  have hAL : A ∈ UC22.calC L := hmemL A hA
  have hisprod := UC22.uc22p22u_conjClosure_isProd hLM hML hAL
  have hK' : uniqueFourConj m A ∈ UC22.calC L := by
    have hM : uniqueFourConj m A ∈ UC22.calC D.M :=
      UC22.uc22p22u_calC_conj (Subgroup.le_normalizer) (hmemM A hA) hm
    have hle : uniqueFourConj m A ≤ L := by
      rw [uniqueFourConj, ← (Subgroup.mem_normalizer_iff_map_conj_eq).mp
        ((Subgroup.normalizer (L : Set G)).inv_mem (hML hm))]
      exact Subgroup.map_mono (CFSG.Quasithin.A3.subnormal_le hAL.1)
    exact ⟨CFSG.Quasithin.A3.subnormal_of_le_of_le hM.1 hle hLM, hM.2.1, hM.2.2⟩
  have hAle : A ≤ UC22.conjClosure D.M A := by
    rw [UC22.conjClosure]
    exact le_iSup₂_of_le (f := fun K (_ : K ∈ UC22.conjSetOf D.M A) => K) A
      (CFSG.LocalAnalysis.UniquenessCase.PartTwo.self_mem_conjSetOf D.M A) le_rfl
  have hK'le : uniqueFourConj m A ≤ UC22.conjClosure D.M A := by
    rw [UC22.conjClosure]
    exact le_iSup₂_of_le (f := fun K (_ : K ∈ UC22.conjSetOf D.M A) => K) (uniqueFourConj m A)
      ⟨m⁻¹, D.M.inv_mem hm, rfl⟩ le_rfl
  have hnt : ¬ Thin8 (UC22.conjClosure D.M A) :=
    UC22.uc22p22u_not_thin_of_conj hAL hK' hne ⟨m, rfl⟩ hAle hK'le hisprod.1
  by_cases hcov : L ≤ UC22.conjClosure D.M A ⊔ pCoreOf 2 L
  · have hcover := r873shp_conjClosure_cover hS hLset hLM hML A hA hcov
    have hp3 : ∀ E ∈ (List.ofFn S).toFinset, CFSG.Open.pRank 3 E = CFSG.Open.pRank 3 A := by
      intro E hE
      obtain ⟨g, hg, hgE⟩ := hcover E hE
      rw [← hgE]
      exact r873shp_pRank_conj g (by norm_num)
    have hsum := r873shp_pRank_sum hS hLset hLM hthin Nat.prime_three (by norm_num)
    rw [hsum] at h3L
    have hconst : (∑ E ∈ (List.ofFn S).toFinset, CFSG.Open.pRank 3 E) =
        (List.ofFn S).toFinset.card * CFSG.Open.pRank 3 A := by
      rw [Finset.sum_congr rfl hp3, Finset.sum_const, smul_eq_mul]
    rw [hconst] at h3L
    rcases Nat.eq_zero_or_pos (CFSG.Open.pRank 3 A) with h0 | hpos
    · rw [h0, mul_zero] at h3L; omega
    · have h2c : 2 ≤ (List.ofFn S).toFinset.card * CFSG.Open.pRank 3 A := by
        calc 2 = 2 * 1 := by ring
          _ ≤ _ := Nat.mul_le_mul h2t hpos
      omega
  · exact (r869_replace_false hmin hisprod.1 (hLM.trans hisprod.2.1)
      (Or.inr ⟨hisprod.1.trans hLM, hisprod.2.1, hisprod.2.2⟩) hnt hcov).elim

private theorem r873shp_isProdOfCalC_sup {G : Type} [Group G] [Finite G] {M A B : Subgroup G}
    (hA : A ∈ UC22.calC M) (hB : B ∈ UC22.calC M) (hAB : A ≠ B) :
    UC22.F08.IsProdOfCalC M (A ⊔ B) := by
  have hpair : A ≤ Subgroup.normalizer (B : Set G) :=
    UC22.uc22p22u_calC_normalizes hB hA (Ne.symm hAB)
  have hset : ((A ⊔ B : Subgroup G) : Set G) = (A : Set G) * (B : Set G) :=
    Subgroup.coe_mul_of_left_le_normalizer_right A B hpair
  refine ⟨2, fun i : Fin 2 => if i = 0 then A else B, ?_, ?_⟩
  · intro i
    fin_cases i
    · simpa using hA
    · simpa using hB
  · rw [hset]
    simp [List.ofFn_succ]

private theorem r873shp_not_thin_sup {G : Type} [Group G] [Finite G] {L A B : Subgroup G}
    (hAL : A ∈ UC22.calC L) (hBL : B ∈ UC22.calC L) (hAB : A ≠ B)
    (hthinA : Thin8 A) {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2)
    (hAq : 1 ≤ CFSG.Open.pRank q A) (hBq : 1 ≤ CFSG.Open.pRank q B) :
    ¬ Thin8 (A ⊔ B) := by
  have hAL' : A ≤ L := CFSG.Quasithin.A3.subnormal_le hAL.1
  have hBL' : B ≤ L := CFSG.Quasithin.A3.subnormal_le hBL.1
  have hcommAB : ⁅UC22.barImage L A, UC22.barImage L B⁆ = ⊥ := by
    rcases CFSG.LocalCores.distinct_components_commute
      (UC22.uc22p22l_barImage_isComponent hAL)
      (UC22.uc22p22l_barImage_isComponent hBL) with h | h
    · exact absurd (UC22.uc22p22u_calC_ext hAL hBL h) hAB
    · exact h
  have hcomm : UC22.barImage L A ≤
      Subgroup.centralizer (UC22.barImage L B : Set (Bar2 L)) :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcommAB
  have hcomm' : UC22.barImage L B ≤
      Subgroup.centralizer (UC22.barImage L A : Set (Bar2 L)) :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp (by rwa [Subgroup.commutator_comm])
  have hndvd : ¬ q ∣ Nat.card ↥(UC22.barImage L A ⊓ UC22.barImage L B) := by
    intro hd
    have hle : UC22.barImage L A ⊓ UC22.barImage L B ≤
        UC22.barImage L A ⊓ Subgroup.centralizer (UC22.barImage L A : Set (Bar2 L)) :=
      inf_le_inf_left _ hcomm'
    exact r873shp_not_dvd_center hAL hthinA hq hq2 (hd.trans (Subgroup.card_dvd_of_le hle))
  have h2 : 2 ≤ CFSG.Open.pRank q (A ⊔ B) := by
    have h1 : CFSG.Open.pRank q (A ⊔ B) = CFSG.Open.pRank q (UC22.barImage L (A ⊔ B)) :=
      (CFSG.LocalAnalysis.UniquenessCase.PartTwo.s13_pRank_barImage hq hq2
        (sup_le hAL' hBL')).symm
    rw [h1, r873shp_barImage_sup_pair hAL' hBL',
      CFSG.GroupTheory.pRank_sup_eq_add_of_commute_of_not_dvd hq hcomm hndvd]
    have h1a : 1 ≤ CFSG.Open.pRank q (UC22.barImage L A) := by
      rw [r873shp_pRank_barImage hAL hq hq2]; exact hAq
    have h1b : 1 ≤ CFSG.Open.pRank q (UC22.barImage L B) := by
      rw [r873shp_pRank_barImage hBL hq hq2]; exact hBq
    omega
  intro hthin
  have := hthin q hq hq2
  omega

private theorem r873shp_pair_replace {G : Type} [Group G] [Finite G] {D : Data G} {L X H : Subgroup G}
    {k : ℕ} {S : Fin k → Subgroup G} (hmin : MinCex869 D L X H) (hL : L ∉ UC22.calC D.M)
    (hS : ∀ i, S i ∈ UC22.calC D.M)
    (hLset : (L : Set G) = (List.ofFn fun i => (S i : Set G)).prod)
    (hthin : ∀ i, Thin8 (S i)) [DecidableEq (Subgroup G)]
    {A B : Subgroup G} (hA : A ∈ (List.ofFn S).toFinset) (hB : B ∈ (List.ofFn S).toFinset)
    (hAB : A ≠ B) {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2)
    (hAq : 1 ≤ CFSG.Open.pRank q A) (hBq : 1 ≤ CFSG.Open.pRank q B)
    (hNA : D.M ≤ Subgroup.normalizer (A : Set G)) (hNB : D.M ≤ Subgroup.normalizer (B : Set G)) :
    (List.ofFn S).toFinset ⊆ {A, B} := by
  have hdata := hmin.hyp.1.resolve_left hL
  have hLM : L ≤ D.M := hdata.1
  have hML : D.M ≤ Subgroup.normalizer (L : Set G) := hdata.2.1
  have hmemL : ∀ A ∈ (List.ofFn S).toFinset, A ∈ UC22.calC L := by
    intro A hA
    obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hA)
    exact hi ▸ r873shp_calC_L hS hLset hLM i
  have hmemM : ∀ A ∈ (List.ofFn S).toFinset, A ∈ UC22.calC D.M := by
    intro A hA
    obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hA)
    exact hi ▸ hS i
  have hthin_t : ∀ A ∈ (List.ofFn S).toFinset, Thin8 A := by
    intro A hA
    obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hA)
    exact hi ▸ hthin i
  intro C hC
  by_contra hCnot
  have hAL : A ∈ UC22.calC L := hmemL A hA
  have hBL : B ∈ UC22.calC L := hmemL B hB
  have hNsup : D.M ≤ Subgroup.normalizer ((A ⊔ B : Subgroup G) : Set G) :=
    (le_inf hNA hNB).trans (Subgroup.inf_normalizer_le_normalizer_sup A B)
  have hisprod : UC22.F08.IsProdOfCalC D.M (A ⊔ B) :=
    r873shp_isProdOfCalC_sup (hmemM A hA) (hmemM B hB) hAB
  have hnt : ¬ Thin8 (A ⊔ B) :=
    r873shp_not_thin_sup hAL hBL hAB (hthin_t A hA) hq hq2 hAq hBq
  have hne : ¬ L ≤ (A ⊔ B) ⊔ pCoreOf 2 L := by
    have hsub : ({A, B} : Finset (Subgroup G)) ⊆ (List.ofFn S).toFinset := by
      intro X hX
      rcases Finset.mem_insert.mp hX with rfl | hX
      · exact hA
      · rw [Finset.mem_singleton.mp hX]; exact hB
    have hproper : ∃ C ∈ (List.ofFn S).toFinset, C ∉ ({A, B} : Finset (Subgroup G)) :=
      ⟨C, hC, hCnot⟩
    have h := r873shp_not_le_sup hS hLset hLM ({A, B} : Finset (Subgroup G)) hsub hproper
    have hsup_eq : (⨆ X ∈ ({A, B} : Finset (Subgroup G)), X) = A ⊔ B := by
      apply le_antisymm
      · refine iSup₂_le fun X hX => ?_
        rcases Finset.mem_insert.mp hX with rfl | hX
        · exact le_sup_left
        · rw [Finset.mem_singleton.mp hX]; exact le_sup_right
      · refine sup_le ?_ ?_
        · exact le_iSup₂ (f := fun X (_ : X ∈ ({A, B} : Finset (Subgroup G))) => X) A
            (Finset.mem_insert_self A {B})
        · exact le_iSup₂ (f := fun X (_ : X ∈ ({A, B} : Finset (Subgroup G))) => X) B
            (Finset.mem_insert_of_mem (Finset.mem_singleton_self B))
    rwa [hsup_eq] at h
  exact (r869_replace_false hmin
    (sup_le (CFSG.Quasithin.A3.subnormal_le hAL.1) (CFSG.Quasithin.A3.subnormal_le hBL.1))
    (hLM.trans hNsup)
    (Or.inr ⟨(sup_le (CFSG.Quasithin.A3.subnormal_le hAL.1)
      (CFSG.Quasithin.A3.subnormal_le hBL.1)).trans hLM, hNsup, hisprod⟩) hnt hne).elim

theorem r873_prod_shape {G : Type} [Group G] [Finite G] {D : Data G} {L X H : Subgroup G}
    (hmin : MinCex869 D L X H) (h3 : CFSG.Open.pRank 3 X = 1) (hL : L ∉ calC D.M) {k : ℕ}
    {S : Fin k → Subgroup G} (hS : ∀ i, S i ∈ calC D.M)
    (hLset : (L : Set G) = (List.ofFn fun i => (S i : Set G)).prod)
    (hthin : ∀ i, Thin8 (S i)) :
    ∃ S₁ S₂ : Subgroup G, S₁ ∈ calC D.M ∧ S₂ ∈ calC D.M ∧ Thin8 S₁ ∧ Thin8 S₂ ∧
      (L : Set G) = (S₁ : Set G) * (S₂ : Set G) ∧
      D.M ≤ Subgroup.normalizer (S₁ : Set G) ∧ D.M ≤ Subgroup.normalizer (S₂ : Set G) ∧
      (∀ a ∈ S₁, ∀ b ∈ S₂, a * b * a⁻¹ * b⁻¹ ∈ pCoreOf 2 L) ∧
      CFSG.Open.pRank 3 S₁ = 0 ∧ CFSG.Open.pRank 3 S₂ = 1 ∧
      ∃ q : ℕ, q.Prime ∧ q ≠ 2 ∧ 1 ≤ CFSG.Open.pRank q S₁ ∧ 1 ≤ CFSG.Open.pRank q S₂ := by
  classical
  have hdata := hmin.hyp.1.resolve_left hL
  have hLM : L ≤ D.M := hdata.1
  have hML : D.M ≤ Subgroup.normalizer (L : Set G) := hdata.2.1
  have hsup : X ⊔ pCoreOf 2 L = L := hmin.hyp.2.2.1
  have hntL : ¬ Thin8 L := hmin.hyp.2.2.2
  have hmemM : ∀ A ∈ (List.ofFn S).toFinset, A ∈ calC D.M := by
    intro A hA
    obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hA)
    exact hi ▸ hS i
  have hmemL : ∀ A ∈ (List.ofFn S).toFinset, A ∈ calC L := by
    intro A hA
    obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hA)
    exact hi ▸ r873shp_calC_L hS hLset hLM i
  have hthin_t : ∀ A ∈ (List.ofFn S).toFinset, Thin8 A := by
    intro A hA
    obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hA)
    exact hi ▸ hthin i
  have h3L : CFSG.Open.pRank 3 L = 1 := by
    rw [← r873_pRank_X hsup Nat.prime_three (by norm_num)]; exact h3
  have hntL' : ¬ (∀ p : ℕ, p.Prime → p ≠ 2 → CFSG.Open.pRank p L ≤ 1) := by
    simpa only [Thin8] using hntL
  push Not at hntL'
  obtain ⟨q, hq, hq2, hqle⟩ := hntL'
  have hq2le : 2 ≤ CFSG.Open.pRank q L := by omega
  have hqt : 2 ≤ ((List.ofFn S).toFinset.filter fun A => 1 ≤ CFSG.Open.pRank q A).card :=
    r873shp_card_filter_of_sum _ _ (fun A hA => hthin_t A hA q hq hq2)
      (by rw [← r873shp_pRank_sum hS hLset hLM hthin hq hq2]; exact hq2le)
  have h2t : 2 ≤ (List.ofFn S).toFinset.card := hqt.trans (Finset.card_filter_le _ _)
  have h1card : 1 < ((List.ofFn S).toFinset.filter fun A => 1 ≤ CFSG.Open.pRank q A).card := by
    omega
  obtain ⟨A, hA, B, hB, hAB⟩ := Finset.one_lt_card.mp h1card
  have hAt : A ∈ (List.ofFn S).toFinset := (Finset.mem_filter.mp hA).1
  have hBt : B ∈ (List.ofFn S).toFinset := (Finset.mem_filter.mp hB).1
  have hAq : 1 ≤ CFSG.Open.pRank q A := (Finset.mem_filter.mp hA).2
  have hBq : 1 ≤ CFSG.Open.pRank q B := (Finset.mem_filter.mp hB).2
  have hfix := r873shp_fixed hmin hL hS hLset hthin h3L h2t
  have hNA : D.M ≤ Subgroup.normalizer (A : Set G) := by
    intro m hm
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    have h := hfix A hAt m⁻¹ (D.M.inv_mem hm)
    rwa [uniqueFourConj, inv_inv] at h
  have hNB : D.M ≤ Subgroup.normalizer (B : Set G) := by
    intro m hm
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    have h := hfix B hBt m⁻¹ (D.M.inv_mem hm)
    rwa [uniqueFourConj, inv_inv] at h
  have hsub := r873shp_pair_replace hmin hL hS hLset hthin hAt hBt hAB hq hq2 hAq hBq hNA hNB
  have htab : (List.ofFn S).toFinset = {A, B} := by
    refine Finset.Subset.antisymm hsub ?_
    intro X hX
    rcases Finset.mem_insert.mp hX with rfl | hX
    · exact hAt
    · rw [Finset.mem_singleton.mp hX]; exact hBt
  have h3sum : CFSG.Open.pRank 3 A + CFSG.Open.pRank 3 B = 1 := by
    have h := r873shp_pRank_sum hS hLset hLM hthin Nat.prime_three (by norm_num)
    rw [h3L] at h
    rw [htab] at h
    have hsumAB : (∑ E ∈ ({A, B} : Finset (Subgroup G)), CFSG.Open.pRank 3 E) =
        CFSG.Open.pRank 3 A + CFSG.Open.pRank 3 B := by
      rw [Finset.sum_insert (by simp [hAB]), Finset.sum_singleton]
    rw [hsumAB] at h
    omega
  have hpair : A ≤ Subgroup.normalizer (B : Set G) :=
    UC22.uc22p22u_calC_normalizes (hmemM B hBt) (hmemM A hAt) (Ne.symm hAB)
  have hjoinAB : (⨆ i, S i) = A ⊔ B := by
    apply le_antisymm
    · refine iSup_le fun i => ?_
      have hi : S i ∈ ({A, B} : Finset (Subgroup G)) := by
        rw [← htab]
        exact List.mem_toFinset.mpr (List.mem_ofFn.mpr ⟨i, rfl⟩)
      rcases Finset.mem_insert.mp hi with h | h
      · rw [h]; exact le_sup_left
      · rw [Finset.mem_singleton.mp h]; exact le_sup_right
    · refine sup_le ?_ ?_
      · obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hAt)
        rw [← hi]; exact le_iSup S i
      · obtain ⟨i, hi⟩ := List.mem_ofFn.1 (List.mem_toFinset.mp hBt)
        rw [← hi]; exact le_iSup S i
  have hLsetAB : (L : Set G) = (A : Set G) * (B : Set G) := by
    rw [r873shp_join hS hLset, hjoinAB]
    exact Subgroup.coe_mul_of_left_le_normalizer_right A B hpair
  have hcommAB : ∀ a ∈ A, ∀ b ∈ B, a * b * a⁻¹ * b⁻¹ ∈ pCoreOf 2 L := by
    intro a ha b hb
    have hAL : A ≤ L := CFSG.Quasithin.A3.subnormal_le (hmemL A hAt).1
    have hBL : B ≤ L := CFSG.Quasithin.A3.subnormal_le (hmemL B hBt).1
    have hcomm' := UC22.uc22p22l_barImage_commute (hmemL A hAt) (hmemL B hBt) hAB
    have hxa : UC22.uc22p21cPi L ⟨a, hAL ha⟩ ∈ UC22.barImage L A :=
      UC22.uc22p21c_mem_barImage.2 ⟨⟨a, hAL ha⟩, ha, rfl⟩
    have hxb : UC22.uc22p21cPi L ⟨b, hBL hb⟩ ∈ UC22.barImage L B :=
      UC22.uc22p21c_mem_barImage.2 ⟨⟨b, hBL hb⟩, hb, rfl⟩
    exact UC22.uc22p22u_commutator_mem_pCoreOf (hAL ha) (hBL hb) (hcomm' _ hxa _ hxb)
  rcases eq_or_ne (CFSG.Open.pRank 3 A) 0 with hA3 | hA3
  · refine ⟨A, B, hmemM A hAt, hmemM B hBt, hthin_t A hAt, hthin_t B hBt, hLsetAB,
      hNA, hNB, hcommAB, hA3, ?_, q, hq, hq2, hAq, hBq⟩
    omega
  · have hA3' : CFSG.Open.pRank 3 A = 1 := by
      have := hthin_t A hAt 3 Nat.prime_three (by norm_num); omega
    have hB3 : CFSG.Open.pRank 3 B = 0 := by omega
    refine ⟨B, A, hmemM B hBt, hmemM A hAt, hthin_t B hBt, hthin_t A hAt, ?_, hNB, hNA, ?_,
      hB3, hA3', q, hq, hq2, hBq, hAq⟩
    · rw [hLsetAB, UC22.uc22p22u_calC_permute (hmemM B hBt) (hmemM A hAt)]
    · intro b hb a ha
      have h := (pCoreOf 2 L).inv_mem (hcommAB a ha b hb)
      convert h using 1
      group

theorem r873_two_le_normal {G : Type} [Group G] [Finite G] {D : Data G} {L S₁ S₂ : Subgroup G}
    (hS₁ : S₁ ∈ calC D.M) (hS₂ : S₂ ∈ calC D.M)
    (hLset : (L : Set G) = (S₁ : Set G) * (S₂ : Set G))
    (hN₁ : D.M ≤ Subgroup.normalizer (S₁ : Set G))
    (hN₂ : D.M ≤ Subgroup.normalizer (S₂ : Set G)) :
    L ≤ D.M ∧ D.M ≤ Subgroup.normalizer (L : Set G) := by
  have h1 : S₁ ≤ D.M := hS₁.1.le
  have h2 : S₂ ≤ D.M := hS₂.1.le
  have key : ∀ m ∈ D.M, ∀ h ∈ L, m * h * m⁻¹ ∈ L := by
    intro m hm h hh
    have hh' : h ∈ (L : Set G) := hh
    rw [hLset] at hh'
    obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_mul.mp hh'
    have ha' : m * a * m⁻¹ ∈ S₁ := (Subgroup.mem_normalizer_iff.1 (hN₁ hm) a).1 ha
    have hb' : m * b * m⁻¹ ∈ S₂ := (Subgroup.mem_normalizer_iff.1 (hN₂ hm) b).1 hb
    have hmem : m * (a * b) * m⁻¹ ∈ (S₁ : Set G) * (S₂ : Set G) :=
      ⟨m * a * m⁻¹, ha', m * b * m⁻¹, hb', by group⟩
    rw [← hLset] at hmem
    exact hmem
  refine ⟨?_, fun m hm => ?_⟩
  · intro l hl
    have hl' : l ∈ (L : Set G) := hl
    rw [hLset] at hl'
    obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_mul.mp hl'
    exact D.M.mul_mem (h1 ha) (h2 hb)
  · rw [Subgroup.mem_normalizer_iff]
    intro h
    refine ⟨key m hm h, fun hmh => ?_⟩
    have h' := key m⁻¹ (D.M.inv_mem hm) _ hmh
    have e : m⁻¹ * (m * h * m⁻¹) * m⁻¹⁻¹ = h := by group
    rw [e] at h'
    exact h'

private theorem r873cn2_le_of_set_mul {G : Type} [Group G] {S₁ S₂ L : Subgroup G}
    (hLset : (L : Set G) = (S₁ : Set G) * (S₂ : Set G)) : S₁ ≤ L ∧ S₂ ≤ L := by
  constructor
  · intro x hx
    have hmem : x ∈ (S₁ : Set G) * (S₂ : Set G) := ⟨x, hx, 1, S₂.one_mem, mul_one x⟩
    rwa [← hLset] at hmem
  · intro x hx
    have hmem : x ∈ (S₁ : Set G) * (S₂ : Set G) := ⟨1, S₁.one_mem, x, hx, one_mul x⟩
    rwa [← hLset] at hmem

private theorem r873cn2_commutator_le {G : Type} [Group G] {S₁ S₂ L : Subgroup G}
    (hcomm : ∀ a ∈ S₁, ∀ b ∈ S₂, a * b * a⁻¹ * b⁻¹ ∈ pCoreOf 2 L) :
    ⁅S₁, S₂⁆ ≤ pCoreOf 2 L := by
  rw [Subgroup.commutator_le]
  intro a ha b hb
  rw [commutatorElement_def]
  exact hcomm a ha b hb

private theorem r873cn2_pRank_inner_eq_zero {G : Type} [Group G] [Finite G]
    {S : Subgroup G} {p : ℕ} (hp : p.Prime) (h : ¬ p ∣ Nat.card (Bar2 S)) :
    CFSG.Open.pRank p (inner (Bar2 S)) = 0 := by
  have hinner_dvd : Nat.card (inner (Bar2 S)) ∣ Nat.card (Bar2 S) := by
    change Nat.card (MulAut.conj : Bar2 S →* MulAut (Bar2 S)).range ∣ Nat.card (Bar2 S)
    exact Subgroup.card_range_dvd _
  rw [CFSG.SectionRank.pRank_eq_pRank_top_subgroup]
  exact CFSG.pRank_eq_zero_of_not_dvd_card hp (fun hh => h (hh.trans hinner_dvd))

private theorem r873cn2_pRank_inner_eq_one {G : Type} [Group G] [Finite G] {D : Data G}
    {S : Subgroup G} (hS : S ∈ calC D.M) {p : ℕ} (hσ : p.Prime ∧ p ≠ 2)
    (hp : p ∣ Nat.card (Bar2 S)) (hpS : CFSG.Open.pRank p S ≤ 1) :
    CFSG.Open.pRank p (inner (Bar2 S)) = 1 := by
  have hp_prime : Fact p.Prime := ⟨hσ.1⟩
  have hperf : Group.IsPerfect (Bar2 S) := Group.isPerfect_def.mpr hS.2.2.1
  have hrank1 : CFSG.Open.pRank p (⊤ : Subgroup (Bar2 S)) = 1 := by
    have hle : CFSG.Open.pRank p (⊤ : Subgroup (Bar2 S)) ≤ 1 := by
      rw [r873_pRank_bar2 S hσ.1 hσ.2]; exact hpS
    have hge : 1 ≤ CFSG.Open.pRank p (⊤ : Subgroup (Bar2 S)) :=
      CFSG.one_le_pRank_of_dvd_card hσ.1 hp
    omega
  have hZ : ¬ p ∣ Nat.card (Subgroup.center (Bar2 S)) :=
    CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.not_dvd_card_center_of_pRank_eq_one
      hσ.2 hrank1
  have hkerConj : (MulAut.conj : Bar2 S →* MulAut (Bar2 S)).ker = Subgroup.center (Bar2 S) := by
    ext x
    rw [MonoidHom.mem_ker, Subgroup.mem_center_iff]
    constructor
    · intro hx y
      have h := congrArg (fun f : MulAut (Bar2 S) => f y) hx
      simp only [MulAut.conj_apply, MulAut.one_apply] at h
      exact (calc x * y = x * y * x⁻¹ * x := by group
        _ = y * x := by rw [h]).symm
    · intro hx
      ext y
      rw [MulAut.conj_apply, MulAut.one_apply]
      calc x * y * x⁻¹ = y * x * x⁻¹ := by rw [← hx y]
        _ = y := by group
  let e : Bar2 S ⧸ Subgroup.center (Bar2 S) ≃* inner (Bar2 S) :=
    (QuotientGroup.quotientMulEquivOfEq hkerConj.symm).trans
      (QuotientGroup.quotientKerEquivRange (MulAut.conj : Bar2 S →* MulAut (Bar2 S)))
  have hinner : CFSG.Open.pRank p (inner (Bar2 S)) =
      CFSG.Open.pRank p (⊤ : Subgroup (Bar2 S ⧸ Subgroup.center (Bar2 S))) := by
    rw [CFSG.SectionRank.pRank_eq_pRank_top_subgroup]
    exact (CFSG.SectionRank.pRank_top_eq_of_mulEquiv hσ.1.one_lt e).symm
  have hquot : CFSG.Open.pRank p (⊤ : Subgroup (Bar2 S ⧸ Subgroup.center (Bar2 S))) =
      CFSG.Open.pRank p (⊤ : Subgroup (Bar2 S)) :=
    CFSG.SectionRank.pRank_quotient_eq (Subgroup.center (Bar2 S)) hZ
  rw [hinner, hquot, hrank1]

private theorem r873cn2_pRank_inner_le_one {G : Type} [Group G] [Finite G] {D : Data G}
    {S : Subgroup G} (hS : S ∈ calC D.M) {p : ℕ} (hσ : p.Prime ∧ p ≠ 2)
    (hpS : CFSG.Open.pRank p S ≤ 1) :
    CFSG.Open.pRank p (inner (Bar2 S)) ≤ 1 := by
  by_cases hp : p ∣ Nat.card (Bar2 S)
  · rw [r873cn2_pRank_inner_eq_one hS hσ hp hpS]
  · rw [r873cn2_pRank_inner_eq_zero hσ.1 hp]; omega

private theorem r873cn2_rhoL_eq_one_of_not_dvd {G : Type} [Group G] [Finite G]
    {D : Data G} {S : Subgroup G} (hN : D.M ≤ Subgroup.normalizer (S : Set G))
    {p : ℕ} (hσ : p.Prime ∧ p ≠ 2) (hOut : CFSG.HasNormalPComplement p (Outer (Bar2 S)))
    (hOp : UC22.F10.OpRes p D.M = D.M)
    {E : Subgroup G} (hEM : E ≤ D.M) (hEel : IsElemAbelian p E)
    (hpS : ¬ p ∣ Nat.card (Bar2 S)) :
    ∀ a : ↥D.M, (a : G) ∈ E → ((UC6S846.rhoL S).comp (Subgroup.inclusion hN)) a = 1 := by
  intro a ha
  have hmap := PartTwo.map_rhoL_le_inner_of_hasNormalPComplement hN hσ.1 hOut hOp hEM hEel.isPGroup
  have hmem : ((UC6S846.rhoL S).comp (Subgroup.inclusion hN)) a ∈ inner (Bar2 S) :=
    hmap (Subgroup.mem_map_of_mem _ (Subgroup.mem_subgroupOf.2 ha))
  have hinner_dvd : Nat.card (inner (Bar2 S)) ∣ Nat.card (Bar2 S) := by
    change Nat.card (MulAut.conj : Bar2 S →* MulAut (Bar2 S)).range ∣ Nat.card (Bar2 S)
    exact Subgroup.card_range_dvd _
  have hp_inner : ¬ p ∣ Nat.card (inner (Bar2 S)) := fun h => hpS (h.trans hinner_dvd)
  have hpow : (((UC6S846.rhoL S).comp (Subgroup.inclusion hN)) a) ^ p = 1 := by
    have h1 : (Subgroup.inclusion hN a) ^ p = 1 := by
      apply Subtype.ext
      simp only [Subgroup.coe_pow, Subgroup.coe_one]
      exact hEel.2 (a : G) ha
    change (UC6S846.rhoL S (Subgroup.inclusion hN a)) ^ p = 1
    rw [← map_pow, h1, map_one]
  exact orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes (hσ.1.coprime_iff_not_dvd.mpr hp_inner)
      (orderOf_dvd_of_pow_eq_one hpow) (Subgroup.orderOf_dvd_natCard (inner (Bar2 S)) hmem))

private theorem r873cn2_not_both {G : Type} [Group G] [Finite G] {D : Data G}
    {S₁ S₂ L : Subgroup G} (hS₂ : S₂ ∈ calC D.M)
    (hLset : (L : Set G) = (S₁ : Set G) * (S₂ : Set G))
    (hcomm : ∀ a ∈ S₁, ∀ b ∈ S₂, a * b * a⁻¹ * b⁻¹ ∈ pCoreOf 2 L)
    {p : ℕ} (hp : p ∈ D.sig) (h1 : CFSG.Open.pRank p L ≤ 1) :
    ¬ (p ∣ Nat.card (Bar2 S₁) ∧ p ∣ Nat.card (Bar2 S₂)) := by
  rintro ⟨hp1, hp2⟩
  have hσ := D.sig_prime p hp
  have hp_prime : Fact p.Prime := ⟨hσ.1⟩
  obtain ⟨hS1L, hS2L⟩ := r873cn2_le_of_set_mul hLset
  have hpS2 : p ∣ Nat.card S₂ := by
    have h := hp2.trans (Subgroup.card_quotient_dvd_card (CFSG.pCore 2 ↥S₂))
    simpa using h
  have hcomm' : ⁅S₁, S₂⁆ ≤ pCoreOf 2 L := r873cn2_commutator_le hcomm
  have h21 : CFSG.Open.pRank p S₁ + 1 ≤ CFSG.Open.pRank p L :=
    CFSG.GroupTheory.pRank_add_one_le_of_commutator_le_pCoreOf hσ.2 hS1L hS2L hcomm' hS₂.2.1 hpS2
  have hpS1 : p ∣ Nat.card S₁ := by
    have h := hp1.trans (Subgroup.card_quotient_dvd_card (CFSG.pCore 2 ↥S₁))
    simpa using h
  have h1le : 1 ≤ CFSG.Open.pRank p S₁ := by
    have h := CFSG.one_le_pRank_of_dvd_card (G := ↥S₁) hσ.1 hpS1
    rwa [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup S₁] at h
  omega

private theorem r873cn2_final {G : Type} [Group G] [Finite G] {D : Data G}
    {S₁ S₂ L : Subgroup G} (hN₁ : D.M ≤ Subgroup.normalizer (S₁ : Set G))
    (hN₂ : D.M ≤ Subgroup.normalizer (S₂ : Set G))
    (hLset : (L : Set G) = (S₁ : Set G) * (S₂ : Set G))
    (hLM : L ≤ D.M) (a : ↥D.M)
    (hρ1a : ((UC6S846.rhoL S₁).comp (Subgroup.inclusion hN₁)) a = 1)
    (hρ2a : ((UC6S846.rhoL S₂).comp (Subgroup.inclusion hN₂)) a = 1) :
    ∀ l ∈ L, (a : G) * l * (a : G)⁻¹ * l⁻¹ ∈ pCoreOf 2 L := by
  intro l hl
  obtain ⟨hS1L, hS2L⟩ := r873cn2_le_of_set_mul hLset
  have hl' : l ∈ (L : Set G) := hl
  rw [hLset] at hl'
  obtain ⟨s₁, hs₁, s₂, hs₂, rfl⟩ := Set.mem_mul.mp hl'
  have hLNS1 : L ≤ Subgroup.normalizer (S₁ : Set G) := hLM.trans hN₁
  have hLNS2 : L ≤ Subgroup.normalizer (S₂ : Set G) := hLM.trans hN₂
  have hcom1 : (a : G) * s₁ * (a : G)⁻¹ * s₁⁻¹ ∈ pCoreOf 2 S₁ := by
    have hfix : UC6S846.rhoL S₁ (Subgroup.inclusion hN₁ a) (QuotientGroup.mk ⟨s₁, hs₁⟩) =
        QuotientGroup.mk ⟨s₁, hs₁⟩ := by
      have hone : UC6S846.rhoL S₁ (Subgroup.inclusion hN₁ a) = 1 := by
        simpa only [MonoidHom.comp_apply] using hρ1a
      rw [hone, MulAut.one_apply]
    exact (UC6S846.rhoL_fix_iff S₁ (Subgroup.inclusion hN₁ a) ⟨s₁, hs₁⟩).1 hfix
  have hcom2 : (a : G) * s₂ * (a : G)⁻¹ * s₂⁻¹ ∈ pCoreOf 2 S₂ := by
    have hfix : UC6S846.rhoL S₂ (Subgroup.inclusion hN₂ a) (QuotientGroup.mk ⟨s₂, hs₂⟩) =
        QuotientGroup.mk ⟨s₂, hs₂⟩ := by
      have hone : UC6S846.rhoL S₂ (Subgroup.inclusion hN₂ a) = 1 := by
        simpa only [MonoidHom.comp_apply] using hρ2a
      rw [hone, MulAut.one_apply]
    exact (UC6S846.rhoL_fix_iff S₂ (Subgroup.inclusion hN₂ a) ⟨s₂, hs₂⟩).1 hfix
  have hpco1 : pCoreOf 2 S₁ ≤ pCoreOf 2 L :=
    CFSG.LieType.BorelTits.le_pCoreOf_of_le_normalizer 2
      ((CFSG.LieType.BorelTits.pCoreOf_le 2 S₁).trans hS1L)
      (hLNS1.trans (UC6S846.normalizer_le_normalizer_pCoreOf S₁))
      (UC6S846.isPGroup_pCoreOf S₁)
  have hpco2 : pCoreOf 2 S₂ ≤ pCoreOf 2 L :=
    CFSG.LieType.BorelTits.le_pCoreOf_of_le_normalizer 2
      ((CFSG.LieType.BorelTits.pCoreOf_le 2 S₂).trans hS2L)
      (hLNS2.trans (UC6S846.normalizer_le_normalizer_pCoreOf S₂))
      (UC6S846.isPGroup_pCoreOf S₂)
  have hmem1 : (a : G) * s₁ * (a : G)⁻¹ * s₁⁻¹ ∈ pCoreOf 2 L := hpco1 hcom1
  have hmem2 : (a : G) * s₂ * (a : G)⁻¹ * s₂⁻¹ ∈ pCoreOf 2 L := hpco2 hcom2
  have hconj2 : s₁ * ((a : G) * s₂ * (a : G)⁻¹ * s₂⁻¹) * s₁⁻¹ ∈ pCoreOf 2 L := by
    have hNL : L ≤ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
      Subgroup.le_normalizer.trans (UC6S846.normalizer_le_normalizer_pCoreOf L)
    exact (Subgroup.mem_normalizer_iff.mp (hNL (hS1L hs₁))
      ((a : G) * s₂ * (a : G)⁻¹ * s₂⁻¹)).mp hmem2
  have hprod : ((a : G) * s₁ * (a : G)⁻¹ * s₁⁻¹) *
      (s₁ * ((a : G) * s₂ * (a : G)⁻¹ * s₂⁻¹) * s₁⁻¹) ∈ pCoreOf 2 L :=
    (pCoreOf 2 L).mul_mem hmem1 hconj2
  have heq : (a : G) * (s₁ * s₂) * (a : G)⁻¹ * (s₁ * s₂)⁻¹ =
      ((a : G) * s₁ * (a : G)⁻¹ * s₁⁻¹) *
        (s₁ * ((a : G) * s₂ * (a : G)⁻¹ * s₂⁻¹) * s₁⁻¹) := by group
  rw [heq]; exact hprod

theorem r873_centralizing_two {G : Type} [Group G] [Finite G] {D : Data G}
    (hSg : UC6S846.SigmaStd D) (h638 : UC6.R6_38 D) (hOut : OutPComplement)
    {S₁ S₂ L : Subgroup G} (hS₁ : S₁ ∈ calC D.M) (hS₂ : S₂ ∈ calC D.M)
    (hLset : (L : Set G) = (S₁ : Set G) * (S₂ : Set G))
    (hN₁ : D.M ≤ Subgroup.normalizer (S₁ : Set G))
    (hN₂ : D.M ≤ Subgroup.normalizer (S₂ : Set G))
    (hcomm : ∀ a ∈ S₁, ∀ b ∈ S₂, a * b * a⁻¹ * b⁻¹ ∈ pCoreOf 2 L) {p : ℕ} (hp : p ∈ D.sig)
    (h1 : CFSG.Open.pRank p L ≤ 1) :
    ∃ A : Subgroup G, A ≤ D.M ∧ IsElemAbelian p A ∧ Nat.card A = p ^ 2 ∧
      ∀ a ∈ A, ∀ l ∈ L, a * l * a⁻¹ * l⁻¹ ∈ pCoreOf 2 L := by
  classical
  have hσ := D.sig_prime p hp
  have h3 := hSg.three_le p hp
  have hOp : UC22.F10.OpRes p D.M = D.M := h638 p hσ.1 hσ.2 (Or.inl hp)
  obtain ⟨hS1L, hS2L⟩ := r873cn2_le_of_set_mul hLset
  have hLM : L ≤ D.M := by
    intro x hx
    have hx' : x ∈ (L : Set G) := hx
    rw [hLset] at hx'
    obtain ⟨u, hu, v, hv, rfl⟩ := Set.mem_mul.mp hx'
    exact D.M.mul_mem (hS₁.1.le hu) (hS₂.1.le hv)
  have hnotboth := r873cn2_not_both hS₂ hLset hcomm hp h1
  have hS1ne : S₁ ≠ ⊤ := fun h => UC22.uc22p20a_M_ne_top D (top_le_iff.mp (h ▸ hS₁.1.le))
  have hS2ne : S₂ ≠ ⊤ := fun h => UC22.uc22p20a_M_ne_top D (top_le_iff.mp (h ▸ hS₂.1.le))
  have hcat1 : CFSG.Open.IsCatalogGroup (Bar2 S₁ ⧸ Subgroup.center (Bar2 S₁)) :=
    UC22.uc22p20d_inCatalog_bar2 D.standing.kProper hS1ne hS₁.2.2
  have hcat2 : CFSG.Open.IsCatalogGroup (Bar2 S₂ ⧸ Subgroup.center (Bar2 S₂)) :=
    UC22.uc22p20d_inCatalog_bar2 D.standing.kProper hS2ne hS₂.2.2
  have hpS1 : CFSG.Open.pRank p S₁ ≤ 1 :=
    (CFSG.SectionRank.pRank_mono hσ.1.one_lt hS1L).trans h1
  have hpS2 : CFSG.Open.pRank p S₂ ≤ 1 :=
    (CFSG.SectionRank.pRank_mono hσ.1.one_lt hS2L).trans h1
  have hpRank1 : CFSG.Open.pRank p (⊤ : Subgroup (Bar2 S₁)) ≤ 1 := by
    rw [r873_pRank_bar2 S₁ hσ.1 hσ.2]; exact hpS1
  have hpRank2 : CFSG.Open.pRank p (⊤ : Subgroup (Bar2 S₂)) ≤ 1 := by
    rw [r873_pRank_bar2 S₂ hσ.1 hσ.2]; exact hpS2
  have hOut1 : CFSG.HasNormalPComplement p (Outer (Bar2 S₁)) :=
    hOut (Bar2 S₁) hS₁.2.2 hcat1 p hσ.1 hσ.2 hpRank1
  have hOut2 : CFSG.HasNormalPComplement p (Outer (Bar2 S₂)) :=
    hOut (Bar2 S₂) hS₂.2.2 hcat2 p hσ.1 hσ.2 hpRank2
  obtain ⟨E₀, hE₀M, hE₀el, hE₀card⟩ :=
    UC6S846.exists_elemAbelian_card_of_le_pRank (M := D.M) hσ.1 (k := 3) h3
  have hE₀M_el : IsElemAbelian p (E₀.subgroupOf D.M) := hE₀el.subgroupOf D.M
  have hE₀M_card : Nat.card (E₀.subgroupOf D.M) = p ^ 3 := by
    rw [← hE₀card]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hE₀M).toEquiv
  have hE₀M_rank : CFSG.Open.pRank p (E₀.subgroupOf D.M) = 3 := by
    have h := CFSG.GroupTheory.card_eq_pow_pRank_of_isElemAbelian hσ.1 hE₀M_el
    rw [hE₀M_card] at h
    exact (Nat.pow_right_injective hσ.1.two_le h).symm
  let ρ₁ : ↥D.M →* MulAut (Bar2 S₁) := (UC6S846.rhoL S₁).comp (Subgroup.inclusion hN₁)
  let ρ₂ : ↥D.M →* MulAut (Bar2 S₂) := (UC6S846.rhoL S₂).comp (Subgroup.inclusion hN₂)
  by_cases hp2 : p ∣ Nat.card (Bar2 S₂)
  · have hp1 : ¬ p ∣ Nat.card (Bar2 S₁) := fun h => hnotboth ⟨h, hp2⟩
    have hρ1 := r873cn2_rhoL_eq_one_of_not_dvd hN₁ hσ hOut1 hOp hE₀M hE₀el hp1
    have hinner2 := r873cn2_pRank_inner_le_one hS₂ hσ hpS2
    have hmap2 : (E₀.subgroupOf D.M).map ρ₂ ≤ inner (Bar2 S₂) :=
      PartTwo.map_rhoL_le_inner_of_hasNormalPComplement hN₂ hσ.1 hOut2 hOp hE₀M hE₀el.isPGroup
    have himg2 : CFSG.Open.pRank p ((E₀.subgroupOf D.M).map ρ₂) ≤ 1 :=
      (CFSG.SectionRank.pRank_mono hσ.1.one_lt hmap2).trans hinner2
    have hineq := CFSG.AGLEmbedding.pRank_le_pRank_inf_ker_add_pRank_map
      (H := MulAut (Bar2 S₂)) hσ.1 ρ₂ (E₀.subgroupOf D.M)
    have hker : 2 ≤ CFSG.Open.pRank p ((E₀.subgroupOf D.M) ⊓ ρ₂.ker) := by
      have htmp := hineq
      rw [hE₀M_rank] at htmp
      omega
    obtain ⟨A', hA'le, hA'el, hA'card⟩ :=
      UC6S846.exists_elemAbelian_card_of_le_pRank (M := (E₀.subgroupOf D.M) ⊓ ρ₂.ker)
        hσ.1 (k := 2) hker
    refine ⟨A'.map D.M.subtype, Subgroup.map_subtype_le _, hA'el.map _, ?_, ?_⟩
    · rw [Subgroup.card_map_of_injective D.M.subtype_injective, hA'card]
    · intro a ha
      obtain ⟨a', ha', rfl⟩ := Subgroup.mem_map.mp ha
      have ha'inf := hA'le ha'
      have ha'E₀ : (a' : G) ∈ E₀ := Subgroup.mem_subgroupOf.mp (Subgroup.mem_inf.mp ha'inf).1
      have hρ2a : ρ₂ a' = 1 := MonoidHom.mem_ker.mp (Subgroup.mem_inf.mp ha'inf).2
      have hρ1a : ρ₁ a' = 1 := hρ1 a' ha'E₀
      exact r873cn2_final hN₁ hN₂ hLset hLM a' hρ1a hρ2a
  · have hρ2 := r873cn2_rhoL_eq_one_of_not_dvd hN₂ hσ hOut2 hOp hE₀M hE₀el hp2
    have hinner1 := r873cn2_pRank_inner_le_one hS₁ hσ hpS1
    have hmap1 : (E₀.subgroupOf D.M).map ρ₁ ≤ inner (Bar2 S₁) :=
      PartTwo.map_rhoL_le_inner_of_hasNormalPComplement hN₁ hσ.1 hOut1 hOp hE₀M hE₀el.isPGroup
    have himg1 : CFSG.Open.pRank p ((E₀.subgroupOf D.M).map ρ₁) ≤ 1 :=
      (CFSG.SectionRank.pRank_mono hσ.1.one_lt hmap1).trans hinner1
    have hineq := CFSG.AGLEmbedding.pRank_le_pRank_inf_ker_add_pRank_map
      (H := MulAut (Bar2 S₁)) hσ.1 ρ₁ (E₀.subgroupOf D.M)
    have hker : 2 ≤ CFSG.Open.pRank p ((E₀.subgroupOf D.M) ⊓ ρ₁.ker) := by
      have htmp := hineq
      rw [hE₀M_rank] at htmp
      omega
    obtain ⟨A', hA'le, hA'el, hA'card⟩ :=
      UC6S846.exists_elemAbelian_card_of_le_pRank (M := (E₀.subgroupOf D.M) ⊓ ρ₁.ker)
        hσ.1 (k := 2) hker
    refine ⟨A'.map D.M.subtype, Subgroup.map_subtype_le _, hA'el.map _, ?_, ?_⟩
    · rw [Subgroup.card_map_of_injective D.M.subtype_injective, hA'card]
    · intro a ha
      obtain ⟨a', ha', rfl⟩ := Subgroup.mem_map.mp ha
      have ha'inf := hA'le ha'
      have ha'E₀ : (a' : G) ∈ E₀ := Subgroup.mem_subgroupOf.mp (Subgroup.mem_inf.mp ha'inf).1
      have hρ1a : ρ₁ a' = 1 := MonoidHom.mem_ker.mp (Subgroup.mem_inf.mp ha'inf).2
      have hρ2a : ρ₂ a' = 1 := hρ2 a' ha'E₀
      exact r873cn2_final hN₁ hN₂ hLset hLM a' hρ1a hρ2a

theorem r873_gamma_two {G : Type} [Group G] [Finite G] {D : Data G} (hSg : UC6S846.SigmaStd D)
    (h870 : R870 D) (h76 : UC22.F07.R76 D) (h638 : UC6.R6_38 D) (hOut : OutPComplement)
    {L X H : Subgroup G} (hmin : MinCex869 D L X H) {S₁ S₂ : Subgroup G}
    (hS₁ : S₁ ∈ calC D.M) (hS₂ : S₂ ∈ calC D.M)
    (hLset : (L : Set G) = (S₁ : Set G) * (S₂ : Set G))
    (hN₁ : D.M ≤ Subgroup.normalizer (S₁ : Set G))
    (hN₂ : D.M ≤ Subgroup.normalizer (S₂ : Set G))
    (hcomm : ∀ a ∈ S₁, ∀ b ∈ S₂, a * b * a⁻¹ * b⁻¹ ∈ pCoreOf 2 L) {r : ℕ} (hr : r.Prime)
    (hr2 : r ≠ 2) {E : Subgroup G} (hEL : E ≤ L) (hEel : IsElemAbelian r E)
    (hEc : Nat.card E = r ^ 2) : rankThreeGamma 1 r E ≤ D.M := by
  have hns : ¬ Group.IsSolvable ↥D.M := UC6S846.not_solvable_of_mem_calC hS₁
  obtain ⟨hLM, hML⟩ := r873_two_le_normal hS₁ hS₂ hLset hN₁ hN₂
  obtain ⟨p, hp⟩ := hSg.nonempty
  have hσ := D.sig_prime p hp
  have h1 : CFSG.Open.pRank p L ≤ 1 := by
    by_contra h
    have hX : 1 < CFSG.Open.pRank p X := by
      rw [r873_pRank_X hmin.hyp.2.2.1 hσ.1 hσ.2]
      omega
    exact h870 L X H hmin p hσ.1 hσ.2 hX (UC6S846.sp_of_mem_sig hSg hns hp)
  obtain ⟨A, hAM, hAel, hAc, hAL⟩ :=
    r873_centralizing_two hSg h638 hOut hS₁ hS₂ hLset hN₁ hN₂ hcomm hp h1
  exact r873_gamma_of_centralizing hSg hns h76 hLM hML hp hAM hAel hAc hAL hr hr2 hEL hEel hEc

private theorem r873tw2_normal_card_eq_prime_le_centralizer
    {G : Type} [Group G] [Finite G] {q : ℕ} (hq : q.Prime) {R N : Subgroup G}
    (hR : IsPGroup q R) (hNR : N ≤ R) (hNnorm : R ≤ Subgroup.normalizer (N : Set G))
    (hNcard : Nat.card N = q) :
    N ≤ Subgroup.centralizer (R : Set G) := by
  have : Fact q.Prime := ⟨hq⟩
  have : Fact (IsPGroup q R) := ⟨hR⟩
  have hNsub : (N.subgroupOf R).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hNR).2 hNnorm
  let : (N.subgroupOf R).Normal := hNsub
  have hcard : Nat.card (N.subgroupOf R) = q := by
    rw [CFSG.natCard_subgroupOf_eq N R hNR, hNcard]
  have hle := CFSG.normal_subgroup_card_eq_prime_le_center (N.subgroupOf R) hcard
  intro n hn
  rw [Subgroup.mem_centralizer_iff]
  intro r hr
  have hmem : (⟨n, hNR hn⟩ : ↥R) ∈ Subgroup.center ↥R :=
    hle (show (⟨n, hNR hn⟩ : ↥R) ∈ N.subgroupOf R from Subgroup.mem_subgroupOf.mpr hn)
  have hcomm := Subgroup.mem_center_iff.mp hmem (⟨r, hr⟩ : ↥R)
  exact congrArg Subtype.val hcomm

private theorem r873tw2_inf_le_normalizer
    {G : Type} [Group G] {R S M : Subgroup G}
    (hMS : M ≤ Subgroup.normalizer (S : Set G)) (hRM : R ≤ M) :
    R ≤ Subgroup.normalizer (R ⊓ S : Set G) := by
  intro r hr
  change r ∈ Subgroup.normalizer ((R ⊓ S : Subgroup G) : Set G)
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · rintro ⟨hxR, hxS⟩
    exact ⟨R.mul_mem (R.mul_mem hr hxR) (R.inv_mem hr),
      (Subgroup.mem_normalizer_iff.mp (hMS (hRM hr)) x).mp hxS⟩
  · rintro ⟨hxR, hxS⟩
    constructor
    · have h : r⁻¹ * (r * x * r⁻¹) * r ∈ R :=
        R.mul_mem (R.mul_mem (R.inv_mem hr) hxR) hr
      rwa [show r⁻¹ * (r * x * r⁻¹) * r = x from by group] at h
    · have h : r⁻¹ * (r * x * r⁻¹) * r ∈ S := by
        simpa using (Subgroup.mem_normalizer_iff.mp (hMS (hRM (R.inv_mem hr)))
          (r * x * r⁻¹)).mp hxS
      rwa [show r⁻¹ * (r * x * r⁻¹) * r = x from by group] at h

private theorem r873tw2_isCyclic_inf
    {G : Type} [Group G] [Finite G] {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2)
    {M R S : Subgroup G} (hsub : CFSG.Open.IsSubnormal S M)
    (hR : IsSylowOf q R M) (hT : Thin8 S) :
    IsCyclic ↥(R ⊓ S) := by
  have : Fact q.Prime := ⟨hq⟩
  exact CFSG.isCyclic_of_le_of_pRank_le_one hq hq2
    (hR.inf_of_isSubnormal hsub).isPGroup inf_le_right (hT q hq hq2)

private theorem r873tw2_dvd_card_inf
    {G : Type} [Group G] [Finite G] {q : ℕ} (hq : q.Prime)
    {M R S : Subgroup G} (hsub : CFSG.Open.IsSubnormal S M)
    (hR : IsSylowOf q R M) (h1 : 1 ≤ CFSG.Open.pRank q S) :
    q ∣ Nat.card ↥(R ⊓ S) := by
  have : Fact q.Prime := ⟨hq⟩
  obtain ⟨E₀, hE₀S, -, hE₀card⟩ :=
    UC6S846.exists_elemAbelian_card_of_le_pRank (M := S) hq (k := 1) h1
  have hqS : q ∣ Nat.card S := by
    have h := Subgroup.card_subgroup_dvd_card (E₀.subgroupOf S)
    rw [CFSG.natCard_subgroupOf_eq E₀ S hE₀S] at h
    rw [hE₀card] at h
    simpa using h
  have hfac : 0 < (Nat.card S).factorization q :=
    Nat.Prime.factorization_pos_of_dvd hq (Nat.card_pos.ne') hqS
  have hQsyl : IsSylowOf q (R ⊓ S) S := hR.inf_of_isSubnormal hsub
  rw [hQsyl.card_eq]
  simpa using pow_dvd_pow q (Nat.succ_le_of_lt hfac)

private theorem r873tw2_omega1_inf_le_centralizer
    {G : Type} [Group G] [Finite G] {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2)
    {M R S : Subgroup G} (hsub : CFSG.Open.IsSubnormal S M)
    (hMS : M ≤ Subgroup.normalizer (S : Set G))
    (hR : IsSylowOf q R M) (hT : Thin8 S) (h1 : 1 ≤ CFSG.Open.pRank q S) :
    ∃ E : Subgroup G, E ≤ S ∧ E ≤ R ∧ Nat.card E = q ∧
      E ≤ Subgroup.centralizer (R : Set G) ∧ IsElemAbelian q E := by
  have : Fact q.Prime := ⟨hq⟩
  let Q : Subgroup G := R ⊓ S
  have hQp : IsPGroup q ↥Q := (hR.inf_of_isSubnormal hsub).isPGroup
  have hQcyc : IsCyclic ↥Q := r873tw2_isCyclic_inf hq hq2 hsub hR hT
  have : IsCyclic ↥Q := hQcyc
  have hqQ : q ∣ Nat.card Q := r873tw2_dvd_card_inf hq hsub hR h1
  have hQnorm : R ≤ Subgroup.normalizer (Q : Set G) :=
    r873tw2_inf_le_normalizer hMS hR.le
  have hcard : Nat.card ((CFSG.omega₁ ↥Q (p := q)).map Q.subtype) = q := by
    rw [Subgroup.card_map_of_injective Q.subtype_injective, CFSG.card_omega₁_of_isCyclic,
      Nat.gcd_eq_right hqQ]
  have : (CFSG.omega₁ ↥Q (p := q)).Characteristic := CFSG.omega₁_characteristic ↥Q
  have hnormE : R ≤ Subgroup.normalizer
      ((CFSG.omega₁ ↥Q (p := q)).map Q.subtype : Set G) :=
    hQnorm.trans (CFSG.LieType.BorelTits.normalizer_le_normalizer_map_of_characteristic
      (CFSG.omega₁ ↥Q (p := q)))
  have hEel : IsElemAbelian q ((CFSG.omega₁ ↥Q (p := q)).map Q.subtype) := by
    let : CommGroup ↥Q := IsCyclic.commGroup
    have : IsMulCommutative ↥Q := ⟨⟨fun a b => mul_comm a b⟩⟩
    have : CFSG.IsElementaryAbelian q (CFSG.omega₁ ↥Q (p := q)) :=
      CFSG.IsElementaryAbelian.omega₁_of_isMulCommutative ↥Q
    exact (CFSG.Open.isElemAbelian_of_isElementaryAbelian (E := CFSG.omega₁ ↥Q (p := q))).map
      Q.subtype
  refine ⟨(CFSG.omega₁ ↥Q (p := q)).map Q.subtype, ?_, ?_, hcard, ?_, hEel⟩
  · exact (Subgroup.map_subtype_le _).trans inf_le_right
  · exact (Subgroup.map_subtype_le _).trans inf_le_left
  · exact r873tw2_normal_card_eq_prime_le_centralizer hq hR.isPGroup
      ((Subgroup.map_subtype_le _).trans inf_le_left) hnormE hcard

private theorem r873tw2_mem_pCoreOf_of_central_image
    {G : Type} [Group G] [Finite G] {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2)
    {S : Subgroup G} (hperf : Group.IsPerfect (Bar2 S))
    (hrank : CFSG.Open.pRank q (⊤ : Subgroup (Bar2 S)) = 1)
    {x : G} (hxS : x ∈ S) (hxq : x ^ q = 1)
    (hcomm : ∀ s ∈ S, s * x * s⁻¹ * x⁻¹ ∈ pCoreOf 2 S) :
    x ∈ pCoreOf 2 S := by
  have : Fact q.Prime := ⟨hq⟩
  have : Group.IsPerfect (Bar2 S) := hperf
  have hZq : ¬ q ∣ Nat.card (Subgroup.center (Bar2 S)) :=
    PartOne.Theorem82.not_dvd_card_center_of_pRank_eq_one (X := Bar2 S) hq2 hrank
  let z : Bar2 S := QuotientGroup.mk' (CFSG.pCore 2 ↥S) ⟨x, hxS⟩
  have hcent : z ∈ Subgroup.center (Bar2 S) := by
    rw [Subgroup.mem_center_iff]
    intro g
    obtain ⟨s, rfl⟩ := QuotientGroup.mk'_surjective (N := CFSG.pCore 2 ↥S) g
    change (QuotientGroup.mk' (CFSG.pCore 2 ↥S)) s *
        (QuotientGroup.mk' (CFSG.pCore 2 ↥S)) ⟨x, hxS⟩ =
      (QuotientGroup.mk' (CFSG.pCore 2 ↥S)) ⟨x, hxS⟩ *
        (QuotientGroup.mk' (CFSG.pCore 2 ↥S)) s
    rw [← map_mul, ← map_mul]
    apply (QuotientGroup.eq_iff_div_mem (N := CFSG.pCore 2 ↥S)).mpr
    have hval : (((s * ⟨x, hxS⟩) / (⟨x, hxS⟩ * s) : ↥S) : G) =
        (s : G) * x * (s : G)⁻¹ * x⁻¹ := by
      simp [div_eq_mul_inv, mul_assoc]
    rw [CFSG.Quasithin.F1.mem_pCore_iff_coe, hval]
    exact hcomm (s : G) s.2
  have hzq : z ^ q = 1 := by
    have h1 : (⟨x, hxS⟩ : ↥S) ^ q = 1 := Subtype.ext (by simpa using hxq)
    change (QuotientGroup.mk' (CFSG.pCore 2 ↥S)) ⟨x, hxS⟩ ^ q = 1
    rw [← map_pow, h1, map_one]
  have hz1 : z = 1 := by
    by_contra hne
    have horder : orderOf z ∣ q := orderOf_dvd_of_pow_eq_one hzq
    rcases (Nat.dvd_prime hq).mp horder with h1 | h1
    · exact hne (orderOf_eq_one_iff.mp h1)
    · have hdvd : q ∣ Nat.card (Subgroup.center (Bar2 S)) := by
        have hle : Subgroup.zpowers z ≤ Subgroup.center (Bar2 S) :=
          Subgroup.zpowers_le.mpr hcent
        have h := Subgroup.card_subgroup_dvd_card
          ((Subgroup.zpowers z).subgroupOf (Subgroup.center (Bar2 S)))
        rw [CFSG.natCard_subgroupOf_eq _ _ hle] at h
        rw [Nat.card_zpowers, h1] at h
        exact h
      exact hZq hdvd
  have hmem : (⟨x, hxS⟩ : ↥S) ∈ CFSG.pCore 2 ↥S :=
    (QuotientGroup.eq_one_iff _).mp hz1
  exact (CFSG.Quasithin.F1.mem_pCore_iff_coe ⟨x, hxS⟩).mp hmem

private theorem r873tw2_inf_E_eq_bot
    {G : Type} [Group G] [Finite G] {L S₁ S₂ E₁ E₂ : Subgroup G} {q : ℕ}
    (hq : q.Prime) (hq2 : q ≠ 2) (hS₁L : S₁ ≤ L)
    (hcomm : ∀ a ∈ S₁, ∀ b ∈ S₂, a * b * a⁻¹ * b⁻¹ ∈ pCoreOf 2 L)
    (hE₁S : E₁ ≤ S₁) (hE₂S : E₂ ≤ S₂) (hE₁el : IsElemAbelian q E₁)
    (hperf : Group.IsPerfect (Bar2 S₁))
    (hrank : CFSG.Open.pRank q (⊤ : Subgroup (Bar2 S₁)) = 1) :
    E₁ ⊓ E₂ = ⊥ := by
  rw [Subgroup.eq_bot_iff_forall]
  intro x hx
  obtain ⟨hxE₁, hxE₂⟩ := Subgroup.mem_inf.mp hx
  have hxS₁ : x ∈ S₁ := hE₁S hxE₁
  have hxq : x ^ q = 1 := hE₁el.2 x hxE₁
  have hcommS₁ : ∀ s ∈ S₁, s * x * s⁻¹ * x⁻¹ ∈ pCoreOf 2 S₁ := by
    intro s hs
    have hmemL : s * x * s⁻¹ * x⁻¹ ∈ pCoreOf 2 L := hcomm s hs x (hE₂S hxE₂)
    have hmemS₁ : s * x * s⁻¹ * x⁻¹ ∈ S₁ :=
      S₁.mul_mem (S₁.mul_mem (S₁.mul_mem hs hxS₁) (S₁.inv_mem hs)) (S₁.inv_mem hxS₁)
    have hle : pCoreOf 2 L ⊓ S₁ ≤ pCoreOf 2 S₁ := by
      rw [inf_comm]
      exact CFSG.GroupTheory.inf_pCoreOf_le_pCoreOf 2 hS₁L
    exact hle ⟨hmemL, hmemS₁⟩
  have hxO : x ∈ pCoreOf 2 S₁ :=
    r873tw2_mem_pCoreOf_of_central_image hq hq2 hperf hrank hxS₁ hxq hcommS₁
  exact UC6S846.eq_one_of_mem_isPGroup_of_mem_isPGroup hq hq2
    (CFSG.Open.IsElemAbelian.isPGroup hE₁el)
    (CFSG.ClassicalGroups.PCoreSection.isPGroup_pCoreOf 2 S₁) hxE₁ hxO

theorem r873_prod_two_false {G : Type} [Group G] [Finite G] {D : Data G}
    (hSg : UC6S846.SigmaStd D) (h870 : R870 D) (h614 : UC6.R6_14 D) (h76 : UC22.F07.R76 D)
    (h638 : UC6.R6_38 D) (hOut : OutPComplement) {L X H : Subgroup G}
    (hmin : MinCex869 D L X H) {S₁ S₂ : Subgroup G} (hS₁ : S₁ ∈ calC D.M) (hS₂ : S₂ ∈ calC D.M)
    (hT₁ : Thin8 S₁) (hT₂ : Thin8 S₂) (hLset : (L : Set G) = (S₁ : Set G) * (S₂ : Set G))
    (hN₁ : D.M ≤ Subgroup.normalizer (S₁ : Set G))
    (hN₂ : D.M ≤ Subgroup.normalizer (S₂ : Set G))
    (hcomm : ∀ a ∈ S₁, ∀ b ∈ S₂, a * b * a⁻¹ * b⁻¹ ∈ pCoreOf 2 L) {q : ℕ} (hq : q.Prime)
    (hq2 : q ≠ 2) (h₁ : 1 ≤ CFSG.Open.pRank q S₁) (h₂ : 1 ≤ CFSG.Open.pRank q S₂) : False := by
  have : Fact q.Prime := ⟨hq⟩
  obtain ⟨hLM, hML⟩ := r873_two_le_normal hS₁ hS₂ hLset hN₁ hN₂
  have hS₁L : S₁ ≤ L := by
    intro a ha
    have hmem : a ∈ ((S₁ : Set G) * (S₂ : Set G)) :=
      Set.mem_mul.mpr ⟨a, ha, 1, S₂.one_mem, by simp⟩
    rwa [← hLset] at hmem
  have hS₂L : S₂ ≤ L := by
    intro a ha
    have hmem : a ∈ ((S₁ : Set G) * (S₂ : Set G)) :=
      Set.mem_mul.mpr ⟨1, S₁.one_mem, a, ha, by simp⟩
    rwa [← hLset] at hmem
  obtain ⟨R, hR⟩ := CFSG.ABGLocalTools.exists_isSylowOf q D.M
  obtain ⟨E₁, hE₁S, hE₁R, hE₁card, hE₁cen, hE₁el⟩ :=
    r873tw2_omega1_inf_le_centralizer hq hq2 hS₁.1 hN₁ hR hT₁ h₁
  obtain ⟨E₂, hE₂S, hE₂R, hE₂card, hE₂cen, hE₂el⟩ :=
    r873tw2_omega1_inf_le_centralizer hq hq2 hS₂.1 hN₂ hR hT₂ h₂
  have hperf₁ : Group.IsPerfect (Bar2 S₁) := ⟨hS₁.2.2.1⟩
  have hrank₁ : CFSG.Open.pRank q (⊤ : Subgroup (Bar2 S₁)) = 1 := by
    rw [r873_pRank_bar2 S₁ hq hq2]
    have := hT₁ q hq hq2
    omega
  have hinfE : E₁ ⊓ E₂ = ⊥ :=
    r873tw2_inf_E_eq_bot hq hq2 hS₁L hcomm hE₁S hE₂S hE₁el hperf₁ hrank₁
  let E : Subgroup G := E₁ ⊔ E₂
  have hEcomm : ∀ a ∈ E₁, ∀ b ∈ E₂, a * b = b * a := by
    intro a ha b hb
    exact (Subgroup.mem_centralizer_iff.mp (hE₁cen ha) b (hE₂R hb)).symm
  have hEel : IsElemAbelian q E :=
    CFSG.Open.IsElemAbelian.sup_of_commute hE₁el hE₂el hEcomm
  have hEp : IsPGroup q E := CFSG.Open.IsElemAbelian.isPGroup hEel
  obtain ⟨m, hm⟩ := IsPGroup.iff_card.mp hEp
  have hm1 : 1 ≤ m := by
    have hle : Nat.card E₁ ≤ Nat.card E := Subgroup.card_le_of_le le_sup_left
    rw [hE₁card, hm] at hle
    exact (Nat.pow_le_pow_iff_right hq.one_lt).mp (by simpa using hle)
  have hmne : m ≠ 1 := by
    intro hm_eq
    have hEeq : E = E₁ := by
      symm
      refine Subgroup.eq_of_le_of_card_ge le_sup_left ?_
      rw [hm, hm_eq, hE₁card]
      simp
    have hle₂ : E₂ ≤ E₁ := by
      rw [← hEeq]
      exact le_sup_right
    have hbot : E₂ = ⊥ := by
      have h := inf_eq_right.mpr hle₂
      rw [hinfE] at h
      exact h.symm
    have hcard₂ : Nat.card E₂ = 1 := by rw [hbot, Subgroup.card_bot]
    have hq1 : q = 1 := by rw [← hE₂card, hcard₂]
    exact hq.ne_one hq1
  have h2m : 2 ≤ m := by omega
  have hq2le : q ^ 2 ≤ Nat.card E := by
    rw [hm]
    exact Nat.pow_le_pow_right hq.pos h2m
  obtain ⟨E', hE'E, hE'el, hE'card⟩ := UC6S846.exists_card_p_sq hq hEel hq2le
  have hE'L : E' ≤ L := hE'E.trans (sup_le (hE₁S.trans hS₁L) (hE₂S.trans hS₂L))
  have hE'cenR : E' ≤ R ⊓ Subgroup.centralizer (R : Set G) :=
    le_inf (hE'E.trans (sup_le hE₁R hE₂R)) (hE'E.trans (sup_le hE₁cen hE₂cen))
  have hΓ : rankThreeGamma 1 q E' ≤ D.M :=
    r873_gamma_two hSg h870 h76 h638 hOut hmin hS₁ hS₂ hLset hN₁ hN₂ hcomm hq hq2
      hE'L hE'el hE'card
  have hns : ¬ Group.IsSolvable ↥D.M := UC6S846.not_solvable_of_mem_calC hS₁
  have hX : 1 < CFSG.Open.pRank q X := by
    rw [r873_pRank_X hmin.hyp.2.2.1 hq hq2]
    have := UC6S846.le_pRank' hq hE'L hE'el (k := 2) hE'card
    omega
  have hsp : IsStronglyPEmbedded q D.M := by
    by_cases hσ : q ∈ D.sig
    · exact UC6S846.sp_of_mem_sig hSg hns hσ
    · exact h614 (UC6S846.sig_subset_sig1 hSg hns) q hq hq2 hσ R hR E' hE'cenR hE'el hE'card hΓ
  exact h870 L X H hmin q hq hq2 hX hsp

private theorem r873num_two_pow_mod_three (f : ℕ) :
    (Even f ∧ 2 ^ f % 3 = 1) ∨ (Odd f ∧ 2 ^ f % 3 = 2) := by
  induction f with
  | zero => exact Or.inl ⟨⟨0, by norm_num⟩, by norm_num⟩
  | succ n ih =>
    rcases ih with ⟨he, hm⟩ | ⟨ho, hm⟩
    · right
      refine ⟨he.add_one, ?_⟩
      rw [pow_succ]
      omega
    · left
      refine ⟨ho.add_one, ?_⟩
      rw [pow_succ]
      omega

private theorem r873num_five_le_of_prime {p : ℕ} (hp : p.Prime) (h2 : p ≠ 2) (h3 : p ≠ 3) :
    5 ≤ p := by
  obtain ⟨k, hk⟩ := hp.odd_of_ne_two h2
  have h2p := hp.two_le
  omega

private theorem r873num_odd_pow_two_sub_one {f : ℕ} (hf : 1 ≤ f) : Odd (2 ^ f - 1) := by
  have h2 : Even (2 ^ f) := even_two.pow_of_ne_zero (by omega)
  exact Nat.Even.sub_odd Nat.one_le_two_pow h2 odd_one

private theorem r873num_odd_pow_two_add_one {f : ℕ} (hf : 1 ≤ f) : Odd (2 ^ f + 1) := by
  have h2 : Even (2 ^ f) := even_two.pow_of_ne_zero (by omega)
  exact h2.add_odd odd_one

private theorem r873num_three_mul_add_one_le_two_pow (n : ℕ) :
    3 * (n + 5) + 1 ≤ 2 ^ (n + 5) := by
  induction n with
  | zero => norm_num
  | succ n ih =>
    have h1 : 3 * (n + 1 + 5) + 1 ≤ 2 * (3 * (n + 5) + 1) := by omega
    have h2 : 2 * (3 * (n + 5) + 1) ≤ 2 * 2 ^ (n + 5) := Nat.mul_le_mul_left 2 ih
    have h3 : 2 * 2 ^ (n + 5) = 2 ^ (n + 1 + 5) := by
      rw [show n + 1 + 5 = n + 5 + 1 by omega]
      exact (pow_succ' 2 (n + 5)).symm
    exact h1.trans (h2.trans (le_of_eq h3))

private theorem r873num_three_mul_lt_two_pow_add_one {f : ℕ} (hf : 5 ≤ f) :
    3 * f < 2 ^ f + 1 := by
  have h := r873num_three_mul_add_one_le_two_pow (f - 5)
  rw [Nat.sub_add_cancel hf] at h
  omega

theorem r873_exists_prime_pow_sub_even {f : ℕ} (hf : 4 ≤ f) (he : Even f) :
    ∃ r : ℕ, r.Prime ∧ 5 ≤ r ∧ r ∣ 2 ^ f - 1 := by
  obtain ⟨g, rfl⟩ := even_iff_exists_two_mul.mp he
  have hg2 : 2 ≤ g := by omega
  have hp : 2 ^ (2 * g) = (2 ^ g) ^ 2 := by rw [mul_comm 2 g, pow_mul]
  have hfac : 2 ^ (2 * g) - 1 = (2 ^ g - 1) * (2 ^ g + 1) := by
    rw [hp]
    have h := Nat.sq_sub_sq (2 ^ g) 1
    rw [one_pow] at h
    rw [h]
    exact mul_comm _ _
  have hA1 : 2 ^ g - 1 ≠ 1 := by
    have hle : 2 ^ 2 ≤ 2 ^ g := pow_le_pow_right' (by norm_num) hg2
    omega
  have hB1 : 2 ^ g + 1 ≠ 1 := by
    have hle : 2 ^ 2 ≤ 2 ^ g := pow_le_pow_right' (by norm_num) hg2
    omega
  have hnotboth : ¬ (3 ∣ 2 ^ g - 1 ∧ 3 ∣ 2 ^ g + 1) := by
    rintro ⟨h1, h2⟩
    rw [Nat.dvd_iff_mod_eq_zero] at h1 h2
    have hB : 2 ^ g + 1 = (2 ^ g - 1) + 2 := by
      have : 1 ≤ 2 ^ g := Nat.one_le_two_pow
      omega
    rw [hB, Nat.add_mod, h1] at h2
    omega
  by_cases h3A : 3 ∣ 2 ^ g - 1
  · have h3B : ¬ 3 ∣ 2 ^ g + 1 := fun h => hnotboth ⟨h3A, h⟩
    obtain ⟨r, hr, hrd⟩ := Nat.exists_prime_and_dvd hB1
    have hr3 : r ≠ 3 := by
      intro h; rw [h] at hrd; exact h3B hrd
    have hodd : Odd (2 ^ g + 1) := r873num_odd_pow_two_add_one (by omega)
    have hr2 : r ≠ 2 := by
      intro h; rw [h] at hrd; exact hodd.not_two_dvd_nat hrd
    refine ⟨r, hr, r873num_five_le_of_prime hr hr2 hr3, ?_⟩
    rw [hfac]
    exact dvd_mul_of_dvd_right hrd _
  · obtain ⟨r, hr, hrd⟩ := Nat.exists_prime_and_dvd hA1
    have hr3 : r ≠ 3 := by
      intro h; rw [h] at hrd; exact h3A hrd
    have hodd : Odd (2 ^ g - 1) := r873num_odd_pow_two_sub_one (by omega)
    have hr2 : r ≠ 2 := by
      intro h; rw [h] at hrd; exact hodd.not_two_dvd_nat hrd
    refine ⟨r, hr, r873num_five_le_of_prime hr hr2 hr3, ?_⟩
    rw [hfac]
    exact dvd_mul_of_dvd_left hrd _

theorem r873_exists_prime_pow_add_odd {f : ℕ} (hf : 5 ≤ f) (ho : Odd f) :
    ∃ r : ℕ, r.Prime ∧ 5 ≤ r ∧ r ∣ 2 ^ f + 1 := by
  have hnotpow : ∀ n, 2 ^ f + 1 ≠ 3 ^ n := by
    intro n hpow
    have hval := padicValNat.pow_add_pow (p := 3) (x := 2) (y := 1)
      (by norm_num : Odd 3) (by norm_num : 3 ∣ 2 + 1) (by norm_num : ¬ 3 ∣ 2)
      (n := f) ho
    have hval' : padicValNat 3 (2 ^ f + 1) = 1 + padicValNat 3 f := by
      have h3 : padicValNat 3 3 = 1 := by simp
      simpa [h3] using hval
    have hn : n = 1 + padicValNat 3 f := by
      have h3n : padicValNat 3 (3 ^ n) = n := padicValNat.prime_pow n
      rw [← hpow] at h3n
      rw [h3n] at hval'
      exact hval'
    have hdvd : 3 ^ padicValNat 3 f ∣ f :=
      (padicValNat_dvd_iff_le (a := f) (n := padicValNat 3 f) (by omega)).mpr (le_refl _)
    have hle : 3 ^ padicValNat 3 f ≤ f := Nat.le_of_dvd (by omega) hdvd
    have hbound : 3 * f < 2 ^ f + 1 := r873num_three_mul_lt_two_pow_add_one hf
    rw [hn, pow_add, pow_one] at hpow
    have : 3 * 3 ^ padicValNat 3 f ≤ 3 * f := Nat.mul_le_mul_left 3 hle
    omega
  have hex : ∃ r, r.Prime ∧ r ∣ 2 ^ f + 1 ∧ r ≠ 3 := by
    by_contra! h
    have h' : ∀ {d}, d.Prime → d ∣ 2 ^ f + 1 → d = 3 := by
      intro d hd hdd
      exact h d hd hdd
    have hpos : 2 ^ f + 1 ≠ 0 := Nat.succ_ne_zero _
    exact hnotpow (Nat.primeFactorsList (2 ^ f + 1)).length
      (Nat.eq_prime_pow_of_unique_prime_dvd hpos h')
  obtain ⟨r, hr, hrdvd, hr3⟩ := hex
  have hodd : Odd (2 ^ f + 1) := r873num_odd_pow_two_add_one (by omega)
  have hr2 : r ≠ 2 := by
    intro h; rw [h] at hrdvd; exact hodd.not_two_dvd_nat hrdvd
  exact ⟨r, hr, r873num_five_le_of_prime hr hr2 hr3, hrdvd⟩

theorem r873_exists_prime_pow_sub_odd {f : ℕ} (hf : 3 ≤ f) (ho : Odd f) :
    ∃ r : ℕ, r.Prime ∧ 5 ≤ r ∧ r ∣ 2 ^ f - 1 := by
  have hmod : 2 ^ f % 3 = 2 := by
    rcases r873num_two_pow_mod_three f with ⟨he, _⟩ | ⟨_, hm⟩
    · exact (Nat.not_even_iff_odd.mpr ho he).elim
    · exact hm
  have h3notdvd : ¬ 3 ∣ 2 ^ f - 1 := by
    rw [Nat.dvd_iff_mod_eq_zero]
    have h1 : 1 ≤ 2 ^ f := Nat.one_le_two_pow
    omega
  have hodd : Odd (2 ^ f - 1) := r873num_odd_pow_two_sub_one (by omega)
  have hgt : 2 ^ f - 1 ≠ 1 := by
    have hle : 2 ^ 3 ≤ 2 ^ f := pow_le_pow_right' (by norm_num) hf
    omega
  obtain ⟨r, hr, hrdvd⟩ := Nat.exists_prime_and_dvd hgt
  have hr2 : r ≠ 2 := by
    intro h; rw [h] at hrdvd; exact hodd.not_two_dvd_nat hrdvd
  have hr3 : r ≠ 3 := by
    intro h; rw [h] at hrdvd; exact h3notdvd hrdvd
  exact ⟨r, hr, r873num_five_le_of_prime hr hr2 hr3, hrdvd⟩

theorem r873_exists_prime_pow_add_even {f : ℕ} (hf : 2 ≤ f) (he : Even f) :
    ∃ r : ℕ, r.Prime ∧ 5 ≤ r ∧ r ∣ 2 ^ f + 1 := by
  have hmod : 2 ^ f % 3 = 1 := by
    rcases r873num_two_pow_mod_three f with ⟨_, hm⟩ | ⟨ho, _⟩
    · exact hm
    · exact (Nat.not_odd_iff_even.mpr he ho).elim
  have h3notdvd : ¬ 3 ∣ 2 ^ f + 1 := by
    rw [Nat.dvd_iff_mod_eq_zero]
    omega
  have hodd : Odd (2 ^ f + 1) := r873num_odd_pow_two_add_one (by omega)
  have hgt : 2 ^ f + 1 ≠ 1 := by
    have hle : 2 ^ 2 ≤ 2 ^ f := pow_le_pow_right' (by norm_num) hf
    omega
  obtain ⟨r, hr, hrdvd⟩ := Nat.exists_prime_and_dvd hgt
  have hr2 : r ≠ 2 := by
    intro h; rw [h] at hrdvd; exact hodd.not_two_dvd_nat hrdvd
  have hr3 : r ≠ 3 := by
    intro h; rw [h] at hrdvd; exact h3notdvd hrdvd
  exact ⟨r, hr, r873num_five_le_of_prime hr hr2 hr3, hrdvd⟩

private theorem r873_two_pow_mod_three (f : ℕ) :
    (Even f ∧ 2 ^ f % 3 = 1) ∨ (Odd f ∧ 2 ^ f % 3 = 2) := by
  induction f with
  | zero => exact Or.inl ⟨⟨0, by norm_num⟩, by norm_num⟩
  | succ n ih =>
    rcases ih with ⟨he, hm⟩ | ⟨ho, hm⟩
    · right
      refine ⟨he.add_one, ?_⟩
      rw [pow_succ]
      omega
    · left
