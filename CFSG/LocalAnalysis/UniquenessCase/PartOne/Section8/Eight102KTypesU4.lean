variable {F : Type} [Field F] [Finite F] [CharP F 2] {b : ℕ}

omit [Finite F] [CharP F 2] in
private theorem u4_card_zpowers_torusD {v : D8Mod 3 F} (hv3 : v ^ 3 = 1)
    (hv1 : v.1 ≠ 1) : Nat.card (Subgroup.zpowers (torusD v)) = 3 := by
  rw [Nat.card_zpowers]
  refine orderOf_eq_prime (p := 3) ?_ ?_
  · rw [← map_pow, hv3, map_one]
  · intro h
    apply hv1
    have h00 := congrArg (fun g : GL (Fin 4) F =>
      ((g : Matrix (Fin 4) (Fin 4) F) 0 0)) h
    simp only [coe_torusD, Matrix.diagonal_apply_eq] at h00
    exact Subtype.ext (Units.ext h00)

private theorem u4_zpowers_torusD_le_SU (hbe : Even b) (v : D8Mod 3 F) :
    Subgroup.zpowers (torusD v) ≤ SU (unitaryInvolution F 2 b) 4 := by
  refine Subgroup.zpowers_le.mpr ?_
  rw [torusD_apply]
  exact d8Vec_mem_SU (Or.inl rfl) d8Comb_four (unitaryInvolution F 2 b)
    (unitaryInvolution_rootsOfUnity hbe) v

private theorem u4_card_bar2_line_one (hb : 0 < b) (hbe : Even b)
    (hF : Nat.card F = (2 ^ b) ^ 2) {ω : rootsOfUnity 3 F} (hω : ω ≠ 1) :
    Nat.card (Bar2 (F08.DerInf8 (SU (unitaryInvolution F 2 b) 4 ⊓
      centralizer (Subgroup.zpowers (torusD ((ω, 1) : D8Mod 3 F)) :
        Set (GL (Fin 4) F))))) = 2 ^ b * (4 ^ b - 1) := by
  obtain ⟨e⟩ := nonempty_bar2_derInf8_line_one hb hbe hF hω
  rw [Nat.card_congr e.toEquiv, CFSG.GorensteinWalter.sl2_card_formula,
    GaloisField.card 2 b (by omega)]
  have h4 : (2 ^ b) ^ 2 = 4 ^ b := by
    rw [← pow_mul, mul_comm b 2, pow_mul]
    norm_num
  rw [h4]

private theorem u4_card_bar2_line_three (hb : 0 < b) (hbe : Even b)
    (hF : Nat.card F = (2 ^ b) ^ 2) {ω : rootsOfUnity 3 F} (hω : ω ≠ 1) :
    Nat.card (Bar2 (F08.DerInf8 (SU (unitaryInvolution F 2 b) 4 ⊓
      centralizer (Subgroup.zpowers (torusD ((ω, ω) : D8Mod 3 F)) :
        Set (GL (Fin 4) F))))) = 2 ^ (2 * b) * (4 ^ (2 * b) - 1) := by
  obtain ⟨e⟩ := nonempty_bar2_derInf8_line_three hb hbe hF hω
  rw [Nat.card_congr e.toEquiv, CFSG.GorensteinWalter.sl2_card_formula,
    GaloisField.card 2 (2 * b) (by omega)]
  have h4 : (2 ^ (2 * b)) ^ 2 = 4 ^ (2 * b) := by
    rw [← pow_mul, mul_comm (2 * b) 2, pow_mul]
    norm_num
  rw [h4]

theorem u4_notationA (hb : 0 < b) (hbe : Even b) (hF : Nat.card F = (2 ^ b) ^ 2)
    {ω : rootsOfUnity 3 F} (hω : ω ≠ 1) {p : ℕ} (hp : p.Prime) (hpq : p ∣ 2 ^ b + 1) :
    F08.NotationA8103 (SU (unitaryInvolution F 2 b) 4) (SU (unitaryInvolution F 2 b) 4) p b
      (zpowers (torusD ((ω, 1) : D8Mod 3 F))) := by
  have hω3 : ω ^ 3 = 1 := by
    apply Subtype.ext
    simpa using (mem_rootsOfUnity 3 (ω : Fˣ)).mp ω.2
  have hv3 : ((ω, 1) : D8Mod 3 F) ^ 3 = 1 := by
    ext <;> simp [hω3]
  have hb2 : 2 ≤ b := by
    obtain ⟨k, hk⟩ := hbe
    omega
  have hp2 : p ≠ 2 := by
    rintro rfl
    have hodd : Odd (2 ^ b + 1) := by
      simpa using CFSG.Timmesfeld.ClassicalOrders.odd_two_pow_pow_add_one
        (f := 1) (n := b) (by norm_num) (by omega)
    exact (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr hpq)
  refine ⟨u4_card_zpowers_torusD hv3 (by simpa using hω),
    u4_zpowers_torusD_le_SU hbe ((ω, 1) : D8Mod 3 F), Or.inr ?_, ?_⟩
  · obtain ⟨e⟩ := nonempty_bar2_derInf8_line_one hb hbe hF hω
    let instF : Fintype (GaloisField 2 b) := Fintype.ofFinite (GaloisField 2 b)
    have hK : @Fintype.card (GaloisField 2 b) instF = 2 ^ b := by
      rw [← @Nat.card_eq_fintype_card (GaloisField 2 b) instF,
        GaloisField.card 2 b (by omega)]
    exact @CFSG.CGT.PushingUpLit.CGT6K1.lieModel_PSL_two_of_mulEquiv_SL_two
      _ _ b hb2 (GaloisField 2 b) _ instF hK e
  · exact le_antisymm
      (pRank_centralizer_line_le hb hbe hF hω hp hp2)
      (two_le_pRank_centralizer_line hb hF hp hpq)

theorem u4_notationB (hb : 0 < b) (hbe : Even b) (hF : Nat.card F = (2 ^ b) ^ 2)
    {ω : rootsOfUnity 3 F} (hω : ω ≠ 1) :
    F08.NotationB8103 (SU (unitaryInvolution F 2 b) 4) (SU (unitaryInvolution F 2 b) 4) b
      (zpowers (torusD ((ω, ω) : D8Mod 3 F))) := by
  have hω3 : ω ^ 3 = 1 := by
    apply Subtype.ext
    simpa using (mem_rootsOfUnity 3 (ω : Fˣ)).mp ω.2
  have hv3 : ((ω, ω) : D8Mod 3 F) ^ 3 = 1 := by
    ext <;> simp [hω3]
  refine ⟨u4_card_zpowers_torusD hv3 (by simpa using hω),
    u4_zpowers_torusD_le_SU hbe ((ω, ω) : D8Mod 3 F), ?_⟩
  obtain ⟨e⟩ := nonempty_bar2_derInf8_line_three hb hbe hF hω
  let instF : Fintype (GaloisField 2 (2 * b)) :=
    Fintype.ofFinite (GaloisField 2 (2 * b))
  have hK : @Fintype.card (GaloisField 2 (2 * b)) instF = 2 ^ (2 * b) := by
    rw [← @Nat.card_eq_fintype_card (GaloisField 2 (2 * b)) instF,
      GaloisField.card 2 (2 * b) (by omega)]
  have hL2 := @CFSG.CGT.PushingUpLit.CGT6K1.lieModel_PSL_two_of_mulEquiv_SL_two
    _ _ (2 * b) (by omega) (GaloisField 2 (2 * b)) _ instF hK e
  change IsL2 (Bar2 (F08.DerInf8 (SU (unitaryInvolution F 2 b) 4 ⊓
    centralizer (Subgroup.zpowers (torusD ((ω, ω) : D8Mod 3 F)) :
      Set (GL (Fin 4) F))))) (2 * b)
  exact hL2

theorem u4_dvd (hb : 0 < b) (hbe : Even b) (hF : Nat.card F = (2 ^ b) ^ 2)
    {ω : rootsOfUnity 3 F} (hω : ω ≠ 1) {p : ℕ} (hpq : p ∣ 2 ^ b + 1) :
    p ∣ Nat.card (Bar2 (F08.DerInf8 (SU (unitaryInvolution F 2 b) 4 ⊓
      centralizer (zpowers (torusD ((ω, 1) : D8Mod 3 F)) : Set (GL (Fin 4) F))))) := by
  rw [u4_card_bar2_line_one hb hbe hF hω]
  have hpow : (2 ^ b) ^ 2 = 4 ^ b := by
    rw [← pow_mul, mul_comm b 2, pow_mul]
    norm_num
  have hdiv : 2 ^ b + 1 ∣ 4 ^ b - 1 := by
    have hsq : (2 ^ b) ^ 2 - 1 = (2 ^ b + 1) * (2 ^ b - 1) := by
      simpa using Nat.sq_sub_sq (2 ^ b) 1
    rw [← hpow, hsq]
    exact dvd_mul_right _ _
  exact dvd_mul_of_dvd_right (hpq.trans hdiv) (2 ^ b)

theorem u4_not_notationB_line (hb : 0 < b) (hbe : Even b) (hF : Nat.card F = (2 ^ b) ^ 2)
    {ω : rootsOfUnity 3 F} (hω : ω ≠ 1) :
    ¬ F08.NotationB8103 (SU (unitaryInvolution F 2 b) 4) (SU (unitaryInvolution F 2 b) 4) b
      (zpowers (torusD ((ω, 1) : D8Mod 3 F))) := by
  rintro ⟨-, -, hL2⟩
  let X := Bar2 (F08.KOf8103 (SU (unitaryInvolution F 2 b) 4)
    (Subgroup.zpowers (torusD ((ω, 1) : D8Mod 3 F))))
  change IsL2 X (2 * b) at hL2
  have hcard1 : Nat.card X = 2 ^ b * (4 ^ b - 1) := by
    simpa [X, F08.KOf8103] using u4_card_bar2_line_one hb hbe hF hω
  have hcard2 : Nat.card X = 2 ^ (2 * b) * (4 ^ (2 * b) - 1) := by
    have hSC : StatedClassicalModel X .PSL 2 2 (2 * b) :=
      CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by omega) hL2
    have hc := CFSG.Open.StatedAPI.card_of_statedClassicalModel_psl_two_two hSC
    have h4 : (2 ^ (2 * b)) ^ 2 = 4 ^ (2 * b) := by
      rw [← pow_mul, mul_comm (2 * b) 2, pow_mul]
      norm_num
    rwa [h4] at hc
  have hodd1 : Odd (4 ^ (2 * b) - 1) := by
    simpa using CFSG.Timmesfeld.ClassicalOrders.odd_two_pow_pow_sub_one
      (f := 2) (n := 2 * b) (by norm_num) (by omega)
  have hodd2 : Odd (4 ^ b - 1) := by
    simpa using CFSG.Timmesfeld.ClassicalOrders.odd_two_pow_pow_sub_one
      (f := 2) (n := b) (by norm_num) (by omega)
  have heq : 2 ^ (2 * b) * (4 ^ (2 * b) - 1) = 2 ^ b * (4 ^ b - 1) := by
    rw [← hcard2, hcard1]
  have hx := CFSG.Timmesfeld.Orders.eq_of_two_pow_mul_odd hodd1 hodd2 heq
  omega

theorem u4_not_notationA_line (hb : 0 < b) (hbe : Even b) (hF : Nat.card F = (2 ^ b) ^ 2)
    {ω : rootsOfUnity 3 F} (hω : ω ≠ 1) (p : ℕ) :
    ¬ F08.NotationA8103 (SU (unitaryInvolution F 2 b) 4) (SU (unitaryInvolution F 2 b) 4) p b
      (zpowers (torusD ((ω, ω) : D8Mod 3 F))) := by
  rintro ⟨-, -, hOr, -⟩
  let X := Bar2 (F08.DerInf8 (SU (unitaryInvolution F 2 b) 4 ⊓
    centralizer (Subgroup.zpowers (torusD ((ω, ω) : D8Mod 3 F)) :
      Set (GL (Fin 4) F))))
  change IsU3 X 2 ∨ IsL2 X b at hOr
  have hcard : Nat.card X = 2 ^ (2 * b) * (4 ^ (2 * b) - 1) := by
    simpa [X] using u4_card_bar2_line_three hb hbe hF hω
  have hodd1 : Odd (4 ^ (2 * b) - 1) := by
    simpa using CFSG.Timmesfeld.ClassicalOrders.odd_two_pow_pow_sub_one
      (f := 2) (n := 2 * b) (by norm_num) (by omega)
  have hodd2 : Odd (4 ^ b - 1) := by
    simpa using CFSG.Timmesfeld.ClassicalOrders.odd_two_pow_pow_sub_one
      (f := 2) (n := b) (by norm_num) (by omega)
  rcases hOr with hU3 | hL2
  · have hSC : StatedClassicalModel X .PSU 3 2 2 :=
      CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by norm_num) hU3
    have hc : Nat.card X = 62400 :=
      CFSG.Open.StatedAPI.card_of_statedClassicalModel_psu_three_four hSC
    have heq : 2 ^ (2 * b) * (4 ^ (2 * b) - 1) = 2 ^ 6 * 975 := by
      rw [← hcard, hc]
      norm_num
    have hx := CFSG.Timmesfeld.Orders.eq_of_two_pow_mul_odd hodd1 (by norm_num : Odd 975) heq
    obtain ⟨k, hk⟩ := hbe
    omega
  · have hcardL2 : Nat.card X = 2 ^ b * (4 ^ b - 1) := by
      have hSC : StatedClassicalModel X .PSL 2 2 b :=
        CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by omega) hL2
      have hc := CFSG.Open.StatedAPI.card_of_statedClassicalModel_psl_two_two hSC
      have h4 : (2 ^ b) ^ 2 = 4 ^ b := by
        rw [← pow_mul, mul_comm b 2, pow_mul]
        norm_num
      simpa [h4] using hc
    have heq : 2 ^ (2 * b) * (4 ^ (2 * b) - 1) = 2 ^ b * (4 ^ b - 1) := by
      rw [← hcard, hcardL2]
    have hx := CFSG.Timmesfeld.Orders.eq_of_two_pow_mul_odd hodd1 hodd2 heq
    omega

theorem u4_kTypesAt (hb : 0 < b) (hbe : Even b) (hF : Nat.card F = (2 ^ b) ^ 2)
    {ω : rootsOfUnity 3 F} (hω : ω ≠ 1) {p : ℕ} (hp : p.Prime) (hpq : p ∣ 2 ^ b + 1) :
    KTypesAt (GL (Fin 4) F) (SU (unitaryInvolution F 2 b) 4) p b :=
  kTypesAt_of_reps (fun _ hℓ h3 => u4_conj_line hbe hF hω hℓ h3)
    (u4_notationA hb hbe hF hω hp hpq) (u4_notationB hb hbe hF hω) (u4_dvd hb hbe hF hω hpq)
    (u4_not_notationB_line hb hbe hF hω) (u4_not_notationA_line hb hbe hF hω p)

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8.KTypes
