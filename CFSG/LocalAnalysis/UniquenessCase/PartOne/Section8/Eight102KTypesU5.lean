private theorem isU3_bar2_derInf8_bA6 (hK : Nat.card K = (2 ^ 2) ^ 2) {ζ : Kˣ}
    (hζ : unitaryInvolution K 2 2 (ζ : K) = ζ) (h1 : ζ ≠ 1) (h3 : ζ ^ 3 = 1) :
    IsU3 (Bar2 (F08.DerInf8 ((⊤ : Subgroup (StatedProj (StatedSU 5 (2 ^ 2) K))) ⊓
      centralizer (zpowers (suQ 5 hK (bA6 (unitaryInvolution K 2 2) ζ hζ)) :
        Set (StatedProj (StatedSU 5 (2 ^ 2) K)))))) 2 := by
  unfold IsU3
  let D : Subgroup (StatedProj (StatedSU 5 (2 ^ 2) K)) :=
    F08.DerInf8 ((⊤ : Subgroup (StatedProj (StatedSU 5 (2 ^ 2) K))) ⊓
      centralizer (zpowers (suQ 5 hK (bA6 (unitaryInvolution K 2 2) ζ hζ)) :
        Set (StatedProj (StatedSU 5 (2 ^ 2) K))))
  change LieModel (Bar2 D) .PSU 3 2 2
  obtain ⟨e⟩ := nonempty_derInf8_bA6 hK hζ h1 h3
  have hSU3 : LieModel ↥(SU (unitaryInvolution K 2 2) 3) .PSU 3 2 2 :=
    CFSG.RankThree.PartOne.lieModel_of_scm_psu
      (CFSG.RankThree.PartTwo.Sec21.U5Lines.statedClassicalModel_SU_three hK)
  have hSUsimp : IsSimpleGroup ↥(SU (unitaryInvolution K 2 2) 3) :=
    CFSG.LocalAnalysis.EvenBN.GMSK.isSimpleGroup_of_lieModel_PSU3 hSU3
  have hDsimp : IsSimpleGroup ↥D := by
    have :=hSUsimp
    exact MulEquiv.isSimpleGroup e
  have hD : LieModel ↥D .PSU 3 2 2 :=
    CFSG.LieType.CurtisTits.lieModel_of_mulEquiv e.symm hSU3
  have hcardD : Nat.card ↥D = 62400 := by
    calc Nat.card ↥D = Nat.card ↥(SU (unitaryInvolution K 2 2) 3) := Nat.card_congr e.toEquiv
      _ = 62400 := by
        have hc := CFSG.LocalAnalysis.EvenBN.GMSK.card_of_lieModel_PSU3 hSU3
        norm_num at hc ⊢
        exact hc
  have hnot2 : ¬ IsPGroup 2 ↥D := by
    intro hp
    obtain ⟨n, hn⟩ := hp.exists_card_eq
    have h5 : 5 ∣ 2 ^ n := by rw [← hn, hcardD]; norm_num
    have h52 : 5 ∣ 2 := Nat.Prime.dvd_of_dvd_pow Nat.prime_five h5
    norm_num at h52
  have hbot : CFSG.pCore 2 ↥D = ⊥ := by
    have :=hDsimp
    exact CFSG.CGT.PushingUpLit.CGT6.pCore_eq_bot_of_simple hnot2
  have hbar : Bar2 D ≃* ↥D :=
    (QuotientGroup.quotientMulEquivOfEq hbot).trans QuotientGroup.quotientBot
  exact CFSG.LieType.CurtisTits.lieModel_of_mulEquiv hbar.symm hD

private theorem isL2_bar2_derInf8_b6 (hK : Nat.card K = (2 ^ 2) ^ 2) {ζ : Kˣ}
    (hζ : unitaryInvolution K 2 2 (ζ : K) = ζ) (h1 : ζ ≠ 1) (h3 : ζ ^ 3 = 1) :
    IsL2 (Bar2 (F08.DerInf8 ((⊤ : Subgroup (StatedProj (StatedSU 5 (2 ^ 2) K))) ⊓
      centralizer (zpowers (suQ 5 hK (b6 (unitaryInvolution K 2 2) ζ hζ)) :
        Set (StatedProj (StatedSU 5 (2 ^ 2) K)))))) (2 * 2) := by
  unfold IsL2
  let D : Subgroup (StatedProj (StatedSU 5 (2 ^ 2) K)) :=
    F08.DerInf8 ((⊤ : Subgroup (StatedProj (StatedSU 5 (2 ^ 2) K))) ⊓
      centralizer (zpowers (suQ 5 hK (b6 (unitaryInvolution K 2 2) ζ hζ)) :
        Set (StatedProj (StatedSU 5 (2 ^ 2) K))))
  change LieModel (Bar2 D) .PSL 2 2 (2 * 2)
  obtain ⟨e⟩ := nonempty_derInf8_b6 hK hζ h1 h3
  have hK4 : Nat.card K = 2 ^ 4 := by rw [hK]; norm_num
  have hSLsimp : IsSimpleGroup (Matrix.SpecialLinearGroup (Fin 2) K) :=
    CFSG.Quasithin.Vol2.Ch10.SecD.isSimpleGroup_of_sl2 (MulEquiv.refl _) (by norm_num) hK4
  have hDsimp : IsSimpleGroup ↥D := by
    have :=hSLsimp
    exact MulEquiv.isSimpleGroup e
  have hSL : LieModel (Matrix.SpecialLinearGroup (Fin 2) K) .PSL 2 2 4 := by
    have hK4' : @Fintype.card K (Fintype.ofFinite K) = 2 ^ 4 := by
      rw [← @Nat.card_eq_fintype_card K (Fintype.ofFinite K), hK]
      norm_num
    have h := @CFSG.CGT.PushingUpLit.CGT6K1.lieModel_PSL_two_of_mulEquiv_SL_two
      (Matrix.SpecialLinearGroup (Fin 2) K) _ 4 (by norm_num) K _ (Fintype.ofFinite K) hK4'
      (MulEquiv.refl _)
    simpa using h
  have hD : LieModel ↥D .PSL 2 2 4 :=
    CFSG.LieType.CurtisTits.lieModel_of_mulEquiv e.symm hSL
  have hcardD : Nat.card ↥D = 4080 := by
    calc Nat.card ↥D = Nat.card (Matrix.SpecialLinearGroup (Fin 2) K) :=
        Nat.card_congr e.toEquiv
      _ = 4080 := by
        have hc := CFSG.Quasithin.H13.Lem11.card_of_lieModel_psl_two hSL
        norm_num at hc ⊢
        exact hc
  have hnot2 : ¬ IsPGroup 2 ↥D := by
    intro hp
    obtain ⟨n, hn⟩ := hp.exists_card_eq
    have h3dvd : 3 ∣ 2 ^ n := by rw [← hn, hcardD]; norm_num
    have h32 : 3 ∣ 2 := Nat.Prime.dvd_of_dvd_pow Nat.prime_three h3dvd
    norm_num at h32
  have hbot : CFSG.pCore 2 ↥D = ⊥ := by
    have :=hDsimp
    exact CFSG.CGT.PushingUpLit.CGT6.pCore_eq_bot_of_simple hnot2
  have hbar : Bar2 D ≃* ↥D :=
    (QuotientGroup.quotientMulEquivOfEq hbot).trans QuotientGroup.quotientBot
  exact CFSG.LieType.CurtisTits.lieModel_of_mulEquiv hbar.symm hD

