private theorem bA6_pow_three {ζ : Kˣ} (hζ : unitaryInvolution K 2 2 (ζ : K) = ζ)
    (h3 : ζ ^ 3 = 1) :
    bA6 (unitaryInvolution K 2 2) ζ hζ ^ 3 = 1 := by
  apply Subtype.ext
  change ((bA6 (unitaryInvolution K 2 2) ζ hζ : ↥(SU (unitaryInvolution K 2 2) 5)) :
      GL (Fin 5) K) ^ 3 = 1
  rw [coe_bA6, diagU_pow, ← diagU_one]
  congr 1
  funext i
  fin_cases i <;> simp [dvec5, Pi.pow_apply, inv_pow, h3]

private theorem bA6_ne_one {ζ : Kˣ} (hζ : unitaryInvolution K 2 2 (ζ : K) = ζ)
    (h1 : ζ ≠ 1) : bA6 (unitaryInvolution K 2 2) ζ hζ ≠ 1 := by
  intro h
  have hentry := congrFun (congrFun (congrArg (fun g : ↥(SU (unitaryInvolution K 2 2) 5) =>
    ((g : GL (Fin 5) K) : Matrix (Fin 5) (Fin 5) K)) h) 1) 1
  simp [coe_bA6, diagU_val, Matrix.diagonal_apply_eq, dvec5] at hentry
  exact h1 hentry

private theorem card_zpowers_suQ_bA6 (hK : Nat.card K = (2 ^ 2) ^ 2) {ζ : Kˣ}
    (hζ : unitaryInvolution K 2 2 (ζ : K) = ζ) (h1 : ζ ≠ 1) (h3 : ζ ^ 3 = 1) :
    Nat.card (zpowers (suQ 5 hK (bA6 (unitaryInvolution K 2 2) ζ hζ))) = 3 := by
  have hcube : bA6 (unitaryInvolution K 2 2) ζ hζ ^ 3 = 1 := bA6_pow_three hζ h3
  have hQ : CFSG.RankThree.PartOne.KFU.IsCentralPQuot 3 (suQ 5 hK) :=
    CFSG.RankThree.PartOne.isCentralPQuot_suQ Nat.prime_three (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) hK
  have hne : suQ 5 hK (bA6 (unitaryInvolution K 2 2) ζ hζ) ≠ 1 := by
    intro h
    exact bA6_ne_one hζ h1 (hQ.eq_one_of_pow_eq_one (MonoidHom.mem_ker.mpr h) hcube)
  have hpow : (suQ 5 hK (bA6 (unitaryInvolution K 2 2) ζ hζ)) ^ 3 = 1 := by
    rw [← map_pow, hcube, map_one]
  have hord : orderOf (suQ 5 hK (bA6 (unitaryInvolution K 2 2) ζ hζ)) = 3 := by
    exact orderOf_eq_prime hpow hne
  rw [Nat.card_zpowers, hord]

