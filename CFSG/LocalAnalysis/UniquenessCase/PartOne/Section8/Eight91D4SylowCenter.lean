private lemma r891_normalizer_inf_B {P₀ : Subgroup X}
    (hP₀normB : P₀ ≤ Subgroup.normalizer (B : Set X)) :
    P₀ ≤ Subgroup.normalizer ((P₀ ⊓ B : Subgroup X) : Set X) := by
  intro x hx
  rw [Subgroup.mem_normalizer_iff]
  intro z
  constructor
  · intro hz
    rw [Subgroup.mem_inf] at hz ⊢
    exact ⟨P₀.mul_mem (P₀.mul_mem hx hz.1) (P₀.inv_mem hx),
      (Subgroup.mem_normalizer_iff.mp (hP₀normB hx) z).mp hz.2⟩
  · intro hz
    rw [Subgroup.mem_inf] at hz ⊢
    refine ⟨?_, ?_⟩
    · have hmem := P₀.mul_mem (P₀.mul_mem (P₀.inv_mem hx) hz.1) hx
      have heq : x⁻¹ * (x * z * x⁻¹) * x = z := by group
      rwa [heq] at hmem
    · exact (Subgroup.mem_normalizer_iff.mp (hP₀normB hx) z).mpr hz.2

private lemma r891_exists_central_three {P₀ : Subgroup X} {b : X}
    (hP₀IsPGroup : IsPGroup 3 P₀) (hbB : b ∈ B) (hbP₀ : b ∈ P₀) (hbne1 : b ≠ 1)
    (hQeq : P₀ ⊓ B = zpowers b)
    (hQnormal : ((P₀ ⊓ B).subgroupOf P₀).Normal) :
    ∃ t ∈ B, t ^ 3 = 1 ∧ t ≠ 1 ∧ P₀ ≤ Subgroup.centralizer ({t} : Set X) := by
  have hbH : (⟨b, hbP₀⟩ : ↥P₀) ∈ (P₀ ⊓ B).subgroupOf P₀ := by
    rw [Subgroup.mem_subgroupOf, hQeq]
    exact Subgroup.mem_zpowers b
  have hHne : (P₀ ⊓ B).subgroupOf P₀ ≠ ⊥ := by
    intro hbot
    have hb1 : (⟨b, hbP₀⟩ : ↥P₀) = 1 := by
      have hmem := hbH
      rw [hbot] at hmem
      simpa using hmem
    exact hbne1 (congrArg Subtype.val hb1)
  have : Group.IsNilpotent ↥P₀ := hP₀IsPGroup.isNilpotent
  have : ((P₀ ⊓ B).subgroupOf P₀).Normal := hQnormal
  have hcenter : (P₀ ⊓ B).subgroupOf P₀ ⊓ Subgroup.center ↥P₀ ≠ ⊥ :=
    Group.IsNilpotent.inf_center_ne_bot_of_normal hHne
  obtain ⟨c, hc1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hcenter
  obtain ⟨hcH, hcZ⟩ := Subgroup.mem_inf.mp c.2
  set z : X := ((c : ↥P₀) : X) with hz_def
  have hzQ : z ∈ P₀ ⊓ B := by
    rw [hz_def]
    exact Subgroup.mem_subgroupOf.mp hcH
  have hzB : z ∈ B := by
    rw [hQeq] at hzQ
    exact Subgroup.zpowers_le.mpr hbB hzQ
  have hzcent : ∀ x ∈ P₀, x * z = z * x := by
    intro x hx
    have h := Subgroup.mem_center_iff.mp hcZ ⟨x, hx⟩
    simpa [hz_def] using congrArg Subtype.val h
  obtain ⟨k, hk⟩ := hP₀IsPGroup.exists_orderOf_eq_pow (⟨z, hzQ.1⟩ : ↥P₀)
  have hk' : orderOf z = 3 ^ k := by
    rw [show z = ((⟨z, hzQ.1⟩ : ↥P₀) : X) from rfl, Subgroup.orderOf_coe]
    exact hk
  have hz1 : z ≠ 1 := by
    intro h
    apply hc1
    apply Subtype.ext
    apply Subtype.ext
    simpa [hz_def] using h
  have hk0 : k ≠ 0 := by
    intro hk0
    have h1 : orderOf z = 1 := by rw [hk', hk0, pow_zero]
    exact hz1 (orderOf_eq_one_iff.mp h1)
  obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk0
  set t : X := z ^ 3 ^ j with ht_def
  have htorder : orderOf t = 3 := by
    rw [ht_def, orderOf_pow, hk']
    have hdvd : 3 ^ j ∣ 3 ^ (j + 1) := pow_dvd_pow 3 (by omega)
    rw [Nat.gcd_eq_right hdvd]
    rw [show 3 ^ (j + 1) = 3 ^ j * 3 by rw [pow_succ]]
    exact Nat.mul_div_cancel_left 3 (pow_pos (by norm_num) j)
  have htB : t ∈ B := by
    rw [ht_def]
    exact B.pow_mem hzB _
  refine ⟨t, htB, ?_, ?_, ?_⟩
  · have h := pow_orderOf_eq_one t
    rwa [htorder] at h
  · intro ht1
    rw [ht1, orderOf_one] at htorder
    norm_num at htorder
  · intro x hx
    rw [Subgroup.mem_centralizer_singleton_iff]
    rw [ht_def]
    exact (Commute.pow_right (hzcent x hx) (3 ^ j)).eq

private lemma r891_not_normalize (h : R891D4Setup n S B) {e : ℕ} {P₀ : Subgroup X} {y b : X}
    (he : 1 ≤ e) (hP₀IsSylow : IsSylowOf 3 P₀ ⊤) (hP₀IsPGroup : IsPGroup 3 P₀)
    (hbP₀ : b ∈ P₀) (hyS : y ∈ S) (hbB : b ∈ B)
    (hyorder : orderOf y = 3 ^ (e + 1)) (hborder : orderOf b = 3 ^ e)
    (hbne1 : b ≠ 1) (hBfac : (Nat.card B).factorization 3 = e) :
    ∃ x ∈ P₀, x * y ^ 3 ^ (e - 1) * x⁻¹ ∉ zpowers (y ^ 3 ^ (e - 1)) := by
  set y₁ : X := y ^ 3 ^ (e - 1) with hy₁_def
  have hy₁S : y₁ ∈ S := by
    rw [hy₁_def]
    exact S.pow_mem hyS _
  have hy₁order : orderOf y₁ = 9 := by
    rw [hy₁_def, orderOf_pow, hyorder]
    have hdvd : 3 ^ (e - 1) ∣ 3 ^ (e + 1) := pow_dvd_pow 3 (by omega)
    rw [Nat.gcd_eq_right hdvd]
    have hpow : 3 ^ (e + 1) = 3 ^ (e - 1) * 9 := by
      rw [show e + 1 = (e - 1) + 2 by omega, pow_add]
      norm_num
    rw [hpow, Nat.mul_div_cancel_left 9 (pow_pos (by norm_num) (e - 1))]
  have hy₁pow9 : y₁ ^ 3 ^ 2 = 1 := by
    rw [show 3 ^ 2 = 9 by norm_num, ← hy₁order]
    exact pow_orderOf_eq_one y₁
  have hy₁3ne1 : y₁ ^ 3 ≠ 1 := by
    intro h3
    have hdvd : orderOf y₁ ∣ 3 := orderOf_dvd_of_pow_eq_one h3
    rw [hy₁order] at hdvd
    have hle : 9 ≤ 3 := Nat.le_of_dvd (by norm_num) hdvd
    omega
  by_contra hno
  have hall : ∀ x ∈ P₀, x * y₁ * x⁻¹ ∈ zpowers y₁ := by
    intro x hx
    by_contra hcon
    exact hno ⟨x, hx, hcon⟩
  have hnormB : P₀ ≤ Subgroup.normalizer (B : Set X) := by
    intro x hx
    exact h.norm y₁ hy₁S ⟨2, hy₁pow9⟩ hy₁3ne1 x (hall x hx)
  have hQeq : P₀ ⊓ B = zpowers b :=
    r891_inf_eq_zpowers_b hP₀IsPGroup hbB hbP₀ hborder hBfac
  have hP₀normQ := r891_normalizer_inf_B hnormB
  have hQnormal : ((P₀ ⊓ B).subgroupOf P₀).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer inf_le_left).mpr hP₀normQ
  obtain ⟨t, htB, ht3, ht1, htcent⟩ :=
    r891_exists_central_three hP₀IsPGroup hbB hbP₀ hbne1 hQeq hQnormal
  exact (h.sylow P₀ hP₀IsSylow t htB ht3 ht1) htcent

private lemma r891_zOf_conj {P P₀ : Subgroup X} {s : X}
    (hP₀ : IsSylowOf 3 P₀ ⊤) (hP : IsSylowOf 3 P ⊤) (hZ : ZOf P₀ = zpowers s) :
    ∃ g : X, ZOf P = (zpowers s).map (MulAut.conj g).toMonoidHom := by
  obtain ⟨g, -, hg⟩ := hP₀.exists_mem_conj hP
  refine ⟨g, ?_⟩
  have hPmap : P = P₀.map (MulAut.conj g).toMonoidHom := by
    ext x
    rw [hg x, Subgroup.mem_map_equiv, MulAut.conj_symm_apply]
  calc ZOf P = ZOf (P₀.map (MulAut.conj g).toMonoidHom) := by rw [hPmap]
    _ = (ZOf P₀).map (MulAut.conj g).toMonoidHom := r891_ZOf_map_conj _ _
    _ = (zpowers s).map (MulAut.conj g).toMonoidHom := by rw [hZ]

theorem exists_zOf_eq (h : R891D4Setup n S B) {P : Subgroup X} (hP : IsSylowOf 3 P ⊤) :
    ∃ s ∈ S, s ^ 3 = 1 ∧ s ≠ 1 ∧
      ∃ g : X, ZOf P = (zpowers s).map (MulAut.conj g).toMonoidHom := by
  classical
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hq2 : 2 ≤ 2 ^ n := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) h.one_le
  have hq3 : ¬ 3 ∣ 2 ^ n := by
    intro hdvd
    have h32 : (3 : ℕ) ∣ 2 := Nat.prime_three.dvd_of_dvd_pow hdvd
    norm_num at h32
  set e : ℕ := ((2 ^ n) ^ 2 - 1).factorization 3 with he_def
  obtain ⟨he, hXfac, hBfac⟩ := r891_card_factorizations h he_def hq2 hq3
  obtain ⟨y, hyS, hyorder⟩ := r891_exists_y h he_def hq2 hq3
  obtain ⟨b, hbB, hborder, hbne1⟩ := r891_exists_b h he hBfac
  obtain ⟨hyb, hdisj⟩ := r891_commute_disj h hyS hbB
  obtain ⟨P₀, hP₀IsSylow, hyP₀, hbP₀, hP₀card⟩ :=
    r891_exists_sylow_containing hyorder hborder hyb hXfac
  have hP₀IsPGroup : IsPGroup 3 P₀ := hP₀IsSylow.isPGroup
  have hbZ : b ^ 3 ^ (e - 1) ∉ ZOf P₀ :=
    r891_b_pow_not_mem_ZOf h he hbB hborder hP₀IsSylow
  have hyN : ∃ x ∈ P₀, x * y ^ 3 ^ (e - 1) * x⁻¹ ∉ zpowers (y ^ 3 ^ (e - 1)) :=
    r891_not_normalize h he hP₀IsSylow hP₀IsPGroup hbP₀ hyS hbB hyorder hborder
      hbne1 hBfac
  have hZ : ZOf P₀ = zpowers (y ^ 3 ^ e) :=
    zOf_eq_zpowers_of_index_three (P := P₀) (y := y) (b := b) (e := e)
      he hyP₀ hbP₀ hyorder hborder hyb hdisj hP₀card hbZ hyN
  obtain ⟨k, hk⟩ := r891_zOf_conj hP₀IsSylow hP hZ
  have hsorder : orderOf (y ^ 3 ^ e) = 3 := by
    rw [orderOf_pow, hyorder]
    have hdvd : 3 ^ e ∣ 3 ^ (e + 1) := pow_dvd_pow 3 (by omega)
    rw [Nat.gcd_eq_right hdvd]
    rw [show 3 ^ (e + 1) = 3 ^ e * 3 by rw [pow_succ]]
    exact Nat.mul_div_cancel_left 3 (pow_pos (by norm_num) e)
  refine ⟨y ^ 3 ^ e, S.pow_mem hyS _, ?_, ?_, k, hk⟩
  · have h := pow_orderOf_eq_one (y ^ 3 ^ e)
    rwa [hsorder] at h
  · intro hs1
    rw [hs1, orderOf_one] at hsorder
    norm_num at hsorder

end R891D4Setup

