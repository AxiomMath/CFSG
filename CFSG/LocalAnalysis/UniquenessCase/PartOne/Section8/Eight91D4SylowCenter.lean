private lemma r891_ZOf_map_conj {G : Type} [Group G] (Q : Subgroup G) (g : G) :
    ZOf (Q.map (MulAut.conj g).toMonoidHom) = (ZOf Q).map (MulAut.conj g).toMonoidHom := by
  unfold ZOf
  rw [Subgroup.map_inf _ _ _ (MulAut.conj g).injective, CFSG.GroupTheory.centralizer_map_conj]

private lemma r891_exists_sl2_order {F : Type} [Field F] [Finite F]
    (hchar : ringChar F = 2) {d : ℕ}
    (hfac : (Nat.card (Matrix.SpecialLinearGroup (Fin 2) F)).factorization 3 = d) :
    ∃ g : Matrix.SpecialLinearGroup (Fin 2) F, orderOf g = 3 ^ d := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨Q⟩ := (inferInstance : Nonempty (Sylow 3 (Matrix.SpecialLinearGroup (Fin 2) F)))
  have : IsCyclic ↥Q := isCyclic_sylow_three_sl2 hchar Q
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := ↥Q)
  refine ⟨g, ?_⟩
  calc orderOf (g : Matrix.SpecialLinearGroup (Fin 2) F)
      = orderOf g := Subgroup.orderOf_coe g
    _ = Nat.card Q := orderOf_eq_card_of_forall_mem_zpowers hg
    _ = 3 ^ (Nat.card (Matrix.SpecialLinearGroup (Fin 2) F)).factorization 3 :=
        Sylow.card_eq_multiplicity Q
    _ = 3 ^ d := by rw [hfac]

namespace R891D4Setup

variable {X : Type} [Group X] {n : ℕ} {S B : Subgroup X}

private lemma r891_card_factorizations (h : R891D4Setup n S B) {e : ℕ}
    (he_def : e = ((2 ^ n) ^ 2 - 1).factorization 3)
    (hq2 : 2 ≤ 2 ^ n) (hq3 : ¬ 3 ∣ 2 ^ n) :
    1 ≤ e ∧ (Nat.card X).factorization 3 = 2 * e + 2 ∧
      (Nat.card B).factorization 3 = e := by
  have hqfac : ∀ q : ℕ, 2 ≤ q → ¬ 3 ∣ q →
      (q * (q ^ 2 - 1)).factorization 3 = (q ^ 2 - 1).factorization 3 := by
    intro q hq2' hq3'
    have hq0 : q ≠ 0 := by omega
    have hq2sub : q ^ 2 - 1 ≠ 0 := by
      have h4 : 4 ≤ q ^ 2 := by
        calc 4 = 2 ^ 2 := by norm_num
          _ ≤ q ^ 2 := Nat.pow_le_pow_left hq2' 2
      omega
    rw [Nat.factorization_mul hq0 hq2sub, Finsupp.add_apply,
      Nat.factorization_eq_zero_of_not_dvd hq3', zero_add]
  have he : 1 ≤ e := by
    rw [he_def]
    have hpos : (2 ^ n) ^ 2 - 1 ≠ 0 := by
      have h4 : 4 ≤ (2 ^ n) ^ 2 := by
        calc 4 = 2 ^ 2 := by norm_num
          _ ≤ (2 ^ n) ^ 2 := Nat.pow_le_pow_left hq2 2
      omega
    exact (Nat.prime_three.dvd_iff_one_le_factorization hpos).mp
      (three_dvd_sq_sub_one_of_not_dvd hq3)
  have hBfac : (Nat.card B).factorization 3 = e := by
    rw [h.card_B, hqfac (2 ^ n) hq2 hq3]
    exact he_def.symm
  have hXfac : (Nat.card X).factorization 3 = 2 * e + 2 := by
    rw [h.card, factorization_ordTrialityD4 hq2 hq3, ← he_def]
  exact ⟨he, hXfac, hBfac⟩

private lemma r891_exists_y (h : R891D4Setup n S B) {e : ℕ}
    (he_def : e = ((2 ^ n) ^ 2 - 1).factorization 3)
    (hq2 : 2 ≤ 2 ^ n) (hq3 : ¬ 3 ∣ 2 ^ n) :
    ∃ y ∈ S, orderOf y = 3 ^ (e + 1) := by
  obtain ⟨K, hKfield, hKfinite, hKcard, ⟨φS⟩⟩ := h.sl2S
  let : Field K := hKfield
  let : Finite K := hKfinite
  have hKcard' : Nat.card K = 2 ^ (3 * n) := by
    rw [hKcard, ← pow_mul]
    congr 1
    omega
  have : CharP K 2 :=
    CFSG.ABGLocalTools.SL2Facts.charP_of_card_eq_prime_pow Nat.prime_two hKcard'
  have hKchar : ringChar K = 2 := ringChar.eq K 2
  obtain ⟨gS, hgS⟩ := r891_exists_sl2_order hKchar (d := e + 1) (by
    rw [CFSG.BenderSuzuki.External.huppert614_card_specialLinearGroup, hKcard,
      factorization_card_SL2_cube hq2 hq3, ← he_def])
  refine ⟨((φS.symm gS : ↥S) : X), (φS.symm gS).2, ?_⟩
  rw [Subgroup.orderOf_coe, MulEquiv.orderOf_eq, hgS]

private lemma r891_exists_b (h : R891D4Setup n S B) {e : ℕ}
    (he : 1 ≤ e) (hBfac : (Nat.card B).factorization 3 = e) :
    ∃ b ∈ B, orderOf b = 3 ^ e ∧ b ≠ 1 := by
  obtain ⟨L, hLfield, hLfinite, hLcard, ⟨φB⟩⟩ := h.sl2B
  let : Field L := hLfield
  let : Finite L := hLfinite
  have : CharP L 2 :=
    CFSG.ABGLocalTools.SL2Facts.charP_of_card_eq_prime_pow Nat.prime_two hLcard
  have hLchar : ringChar L = 2 := ringChar.eq L 2
  obtain ⟨gB, hgB⟩ := r891_exists_sl2_order hLchar (d := e) (by
    rw [CFSG.BenderSuzuki.External.huppert614_card_specialLinearGroup, hLcard,
      ← h.card_B]
    exact hBfac)
  have hborder : orderOf ((φB.symm gB : ↥B) : X) = 3 ^ e := by
    rw [Subgroup.orderOf_coe, MulEquiv.orderOf_eq, hgB]
  refine ⟨((φB.symm gB : ↥B) : X), (φB.symm gB).2, hborder, ?_⟩
  intro hb1
  have h1 : orderOf ((φB.symm gB : ↥B) : X) = 1 := by rw [hb1, orderOf_one]
  rw [hborder] at h1
  have hge : 3 ≤ 3 ^ e := by
    calc 3 = 3 ^ 1 := by norm_num
      _ ≤ 3 ^ e := Nat.pow_le_pow_right (by norm_num) he
  omega

private lemma r891_commute_disj (h : R891D4Setup n S B) {y b : X}
    (hyS : y ∈ S) (hbB : b ∈ B) :
    Commute y b ∧ zpowers y ⊓ zpowers b = ⊥ := by
  have hyb : Commute y b := by
    have hbcent : b ∈ Subgroup.centralizer (S : Set X) := by
      rw [← h.cent]
      exact hbB
    exact Subgroup.mem_centralizer_iff.mp hbcent y hyS
  have hdisj : zpowers y ⊓ zpowers b = ⊥ := by
    have hle : zpowers y ⊓ zpowers b ≤ S ⊓ B :=
      inf_le_inf (Subgroup.zpowers_le.mpr hyS) (Subgroup.zpowers_le.mpr hbB)
    rw [h.inf_eq_bot] at hle
    exact le_bot_iff.mp hle
  exact ⟨hyb, hdisj⟩

variable [Finite X]

private lemma r891_exists_sylow_containing {e : ℕ} {y b : X}
    (hyorder : orderOf y = 3 ^ (e + 1)) (hborder : orderOf b = 3 ^ e)
    (hyb : Commute y b) (hXfac : (Nat.card X).factorization 3 = 2 * e + 2) :
    ∃ P₀ : Subgroup X, IsSylowOf 3 P₀ ⊤ ∧ y ∈ P₀ ∧ b ∈ P₀ ∧
      Nat.card P₀ = 3 ^ (2 * e + 2) := by
  have hApg : IsPGroup 3 ↥(zpowers y ⊔ zpowers b) := by
    refine IsPGroup.to_sup_of_normal_right' ?_ ?_ ?_
    · refine IsPGroup.of_card (n := e + 1) ?_
      rw [Nat.card_zpowers, hyorder]
    · refine IsPGroup.of_card (n := e) ?_
      rw [Nat.card_zpowers, hborder]
    · refine (Subgroup.zpowers_le.mpr ?_).trans (Subgroup.centralizer_le_normalizer _)
      rw [Subgroup.mem_centralizer_iff]
      intro z hz
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hz
      exact (hyb.zpow_right k).eq.symm
  obtain ⟨P₀, hP₀le⟩ := hApg.exists_le_sylow
  have hP₀IsPGroup : IsPGroup 3 (P₀ : Subgroup X) := P₀.isPGroup'
  have hP₀IsSylow : IsSylowOf 3 (P₀ : Subgroup X) ⊤ :=
    CFSG.ABGLocalTools.isSylowOf_iff.mpr
      ⟨le_top, hP₀IsPGroup, by simpa using P₀.not_dvd_index⟩
  refine ⟨(P₀ : Subgroup X), hP₀IsSylow,
    hP₀le (Subgroup.mem_sup_left (Subgroup.mem_zpowers y)),
    hP₀le (Subgroup.mem_sup_right (Subgroup.mem_zpowers b)), ?_⟩
  rw [Sylow.card_eq_multiplicity P₀, hXfac]

private lemma r891_b_pow_not_mem_ZOf (h : R891D4Setup n S B) {e : ℕ} {b : X}
    {P₀ : Subgroup X} (he : 1 ≤ e) (hbB : b ∈ B)
    (hborder : orderOf b = 3 ^ e) (hP₀IsSylow : IsSylowOf 3 P₀ ⊤) :
    b ^ 3 ^ (e - 1) ∉ ZOf P₀ := by
  have hb₁order : orderOf (b ^ 3 ^ (e - 1)) = 3 := by
    rw [orderOf_pow, hborder]
    have hdvd : 3 ^ (e - 1) ∣ 3 ^ e := pow_dvd_pow 3 (by omega)
    rw [Nat.gcd_eq_right hdvd]
    have hpow : 3 ^ e = 3 ^ (e - 1) * 3 := by
      calc 3 ^ e = 3 ^ (e - 1 + 1) := by rw [Nat.sub_add_cancel he]
        _ = 3 ^ (e - 1) * 3 := pow_succ _ _
    rw [hpow]
    exact Nat.mul_div_cancel_left 3 (pow_pos (by norm_num) (e - 1))
  have hb₁ne1 : b ^ 3 ^ (e - 1) ≠ 1 := by
    intro hb1
    have h1 : orderOf (b ^ 3 ^ (e - 1)) = 1 := by rw [hb1, orderOf_one]
    rw [hb₁order] at h1
    norm_num at h1
  intro hbZ
  change b ^ 3 ^ (e - 1) ∈ P₀ ⊓ Subgroup.centralizer (P₀ : Set X) at hbZ
  have hb₁B : b ^ 3 ^ (e - 1) ∈ B := B.pow_mem hbB _
  have hb₁central : P₀ ≤ Subgroup.centralizer ({b ^ 3 ^ (e - 1)} : Set X) := by
    intro x hx
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact (Subgroup.mem_centralizer_iff.mp (Subgroup.mem_inf.mp hbZ).2) x hx
  exact (h.sylow P₀ hP₀IsSylow (b ^ 3 ^ (e - 1)) hb₁B
    (by
      have h := pow_orderOf_eq_one (b ^ 3 ^ (e - 1))
      rwa [hb₁order] at h)
    hb₁ne1) hb₁central

private lemma r891_inf_eq_zpowers_b {e : ℕ} {P₀ : Subgroup X} {b : X}
    (hP₀IsPGroup : IsPGroup 3 P₀) (hbB : b ∈ B) (hbP₀ : b ∈ P₀)
    (hborder : orderOf b = 3 ^ e) (hBfac : (Nat.card B).factorization 3 = e) :
    P₀ ⊓ B = zpowers b := by
  set Q : Subgroup X := P₀ ⊓ B with hQdef
  have hQp : IsPGroup 3 Q := by
    rw [hQdef]
    exact hP₀IsPGroup.to_inf_left
  have hQeq : Q = zpowers b := by
    have hzb_le : zpowers b ≤ Q := by
      rw [hQdef]
      exact Subgroup.zpowers_le.mpr (Subgroup.mem_inf.mpr ⟨hbP₀, hbB⟩)
    have hQdvdB : Nat.card Q ∣ Nat.card B := by
      rw [hQdef]
      exact Subgroup.card_dvd_of_le inf_le_right
    obtain ⟨m, hm⟩ := hQp.exists_card_eq
    have hmle : m ≤ e := by
      have hdvd : 3 ^ m ∣ Nat.card B := by
        rw [← hm]
        exact hQdvdB
      have := (Nat.prime_three.pow_dvd_iff_le_factorization (Nat.card_pos.ne' :
        Nat.card B ≠ 0)).mp hdvd
      rwa [hBfac] at this
    have hQcard_le : Nat.card Q ≤ 3 ^ e := by
      rw [hm]
      exact Nat.pow_le_pow_right (by norm_num) hmle
    exact (Subgroup.eq_of_le_of_card_ge hzb_le (by
      rw [Nat.card_zpowers, hborder]
      exact hQcard_le)).symm
  exact hQeq

