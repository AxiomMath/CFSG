private theorem pRank_top_eq_zero_of_not_dvd {X : Type} [Group X] [Finite X] {p : ℕ}
    (hp : p.Prime) (h : ¬ p ∣ Nat.card X) : CFSG.Open.pRank p (⊤ : Subgroup X) = 0 :=
  CFSG.pRank_eq_zero_of_not_dvd_card hp h

private theorem pRank_le_one_of_model {X K : Type} [Group X] [Finite X] [Field K] [Finite K]
    {n : ℕ} (hn : 1 ≤ n) (hK : Nat.card K = (2 ^ n) ^ 3) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ 2 ^ n) {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p)
    (hpd : p ∣ (2 ^ n) ^ 4 - (2 ^ n) ^ 2 + 1)
    (e : X ≃* ↥(CFSG.LieType.Chevalley.graphFixedRootGroup
      CFSG.Blueprint.Chevalley.TwistTag.D4 K σ.toRingHom)) :
    CFSG.Open.pRank p (⊤ : Subgroup X) ≤ 1 := by
  rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv hp.one_lt e,
    ← CFSG.SectionRank.pRank_eq_open_pRank_top p
      ↥(CFSG.LieType.Chevalley.graphFixedRootGroup CFSG.Blueprint.Chevalley.TwistTag.D4 K
        σ.toRingHom)]
  exact CFSG.RankThree.PartOne.K128.pRank_le_one_D4_twelve (ℓ := 2) (f := n)
    Nat.prime_two hn K hK σ hσ hp hp5 hpd

theorem pRank_d4_le_one {X : Type} [Group X] [Finite X] {n : ℕ} (h : Is3D4 X n) {p : ℕ}
    (hp : p.Prime) (hp5 : 5 ≤ p) (hpd : ¬ p ∣ 2 ^ (6 * n) - 1) :
    CFSG.Open.pRank p (⊤ : Subgroup X) ≤ 1 := by
  have hcard : Nat.card X = ordTrialityD4 (2 ^ n) :=
    CFSG.Timmesfeld.card_chevalleyExceptionalModel_two
      (CFSG.Blueprint.LieModel.chevalleyExceptionalModel h (by decide))
  by_cases hpX : p ∣ Nat.card X
  · have hpd' : p ∣ (2 ^ n) ^ 4 - (2 ^ n) ^ 2 + 1 := by
      have h12 : p ∣ 2 ^ (4 * n) - 2 ^ (2 * n) + 1 := by
        rcases dvd_or_dvd_of_dvd_ordTrialityD4 hp hp5 (hcard ▸ hpX) with h6 | h12
        · exact absurd h6 hpd
        · exact h12
      have h4 : (2 ^ n) ^ 4 = 2 ^ (4 * n) := by rw [← pow_mul, Nat.mul_comm]
      have h2 : (2 ^ n) ^ 2 = 2 ^ (2 * n) := by rw [← pow_mul, Nat.mul_comm]
      rw [h4, h2]
      exact h12
    obtain ⟨hn, K, _, _, _, σ, _, hσ, hK, _, ⟨e⟩⟩ := uc22s218_d4_exists_model h
    exact pRank_le_one_of_model hn hK σ hσ hp hp5 hpd' e
  · rw [pRank_top_eq_zero_of_not_dvd hp hpX]
    exact Nat.zero_le 1

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8.R891Core
