theorem eq_sup_inf_normalizer_of_weaklyClosed {G : Type} [Group G] [Finite G]
    {C K Z P : Subgroup G}
    (hKC : K ≤ C) (hKn : (K.subgroupOf C).Normal) (hZK : Z ≤ K)
    (hP : CFSG.ABGLocalTools.IsSylowOf 3 P C) (hwc : WeaklyClosedIn P Z) :
    C = K ⊔ (Subgroup.normalizer (Z : Set G) ⊓ C) := by
  have hKn' : C ≤ Subgroup.normalizer (K : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hKC).mp hKn
  have hSK : CFSG.ABGLocalTools.IsSylowOf 3 (P ⊓ K) K :=
    hP.inf_of_le_normalizer hKC hKn'
  refine le_antisymm ?_ (sup_le hKC inf_le_right)
  intro c hc
  have hTK : rightConjugate Z c ≤ K := by
    have hcN : c⁻¹ ∈ Subgroup.normalizer (K : Set G) :=
      (Subgroup.normalizer (K : Set G)).inv_mem (hKn' hc)
    have hKc : K.conjBy c⁻¹ = K :=
      (Subgroup.mem_normalizer_iff_map_conj_eq (H := K) (g := c⁻¹)).mp hcN
    change Z.map (MulAut.conj c⁻¹).toMonoidHom ≤ K
    calc Z.map (MulAut.conj c⁻¹).toMonoidHom
        ≤ K.map (MulAut.conj c⁻¹).toMonoidHom := Subgroup.map_mono hZK
      _ = K := by simpa [Subgroup.conjBy] using hKc
  have hZp : IsPGroup 3 Z := hP.isPGroup.to_le hwc.1
  have hTp : IsPGroup 3 (rightConjugate Z c) := by
    change IsPGroup 3 (Z.map (MulAut.conj c⁻¹).toMonoidHom)
    exact hZp.map (MulAut.conj c⁻¹).toMonoidHom
  have hTpK : IsPGroup 3 ((rightConjugate Z c).subgroupOf K) := hTp.comap_subtype
  obtain ⟨Q, hTQ⟩ := hTpK.exists_le_sylow
  have hQ : CFSG.ABGLocalTools.IsSylowOf 3
      ((Q : Subgroup ↥K).map K.subtype) K := ⟨Q, rfl⟩
  obtain ⟨k, hkK, hconj⟩ :=
    CFSG.ABGLocalTools.IsSylowOf.exists_mem_conj hSK hQ
  have hright_le : rightConjugate (rightConjugate Z c) k ≤ P := by
    intro y hy
    obtain ⟨y', hy', rfl⟩ := Subgroup.mem_map.mp hy
    have hy'K : y' ∈ K := hTK hy'
    have hy'Q : y' ∈ (Q : Subgroup ↥K).map K.subtype :=
      Subgroup.mem_map.mpr ⟨⟨y', hy'K⟩, hTQ hy', rfl⟩
    have hmem : MulAut.conj k⁻¹ y' ∈ P ⊓ K := by
      simpa [MulAut.conj_apply] using (hconj y').mp hy'Q
    exact (inf_le_left : P ⊓ K ≤ P) hmem
  have hcomp : rightConjugate (rightConjugate Z c) k = rightConjugate Z (c * k) := by
    simp [rightConjugate, Subgroup.conjBy_conjBy, mul_inv_rev]
  have hweak : rightConjugate Z (c * k) = Z := by
    apply hwc.2 (c * k)
    rwa [← hcomp]
  have hmem_inv : (c * k)⁻¹ ∈ Subgroup.normalizer (Z : Set G) := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    simpa [rightConjugate, Subgroup.conjBy] using hweak
  have hmem : c * k ∈ Subgroup.normalizer (Z : Set G) := by
    simpa using (Subgroup.normalizer (Z : Set G)).inv_mem hmem_inv
  have h1 : c * k ∈ Subgroup.normalizer (Z : Set G) ⊓ C :=
    ⟨hmem, C.mul_mem hc (hKC hkK)⟩
  have h2 : k⁻¹ ∈ K := K.inv_mem hkK
  have hc_eq : c = (c * k) * k⁻¹ := by group
  rw [hc_eq]
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_right h1) (Subgroup.mem_sup_left h2)

theorem le_normalizer_of_isWeaklyClosedIn_normalizer {G : Type} [Group G] [Finite G]
    {Z P : Subgroup G}
    (hZP : Z ≤ P) (hP : IsPGroup 3 P)
    (hwc : CFSG.ASVolI.ChIJK.IsWeaklyClosedIn Z (Subgroup.normalizer (Z : Set G))) :
    P ≤ Subgroup.normalizer (Z : Set G) := by
  classical
  by_contra hPN
  obtain ⟨R, hRmem⟩ : ∃ R : Subgroup G, ∀ g : G, g ∈ R ↔
      g ∈ P ∧ g ∈ Subgroup.normalizer (Z : Set G) :=
    ⟨P ⊓ Subgroup.normalizer (Z : Set G), fun g => Subgroup.mem_inf⟩
  have hRP : R < P := by
    refine lt_of_le_of_ne (fun g hg => ((hRmem g).mp hg).1) (fun h => hPN ?_)
    intro g hg
    rw [← h] at hg
    exact ((hRmem g).mp hg).2
  have hnil : Group.IsNilpotent ↥P := hP.isNilpotent
  have hnc : NormalizerCondition ↥P := Group.normalizerCondition_of_isNilpotent (h := hnil)
  have hnc' : ∀ H : Subgroup ↥P, H < ⊤ →
      H < Subgroup.normalizer (H : Set ↥P) := hnc
  have hH'top : R.subgroupOf P < ⊤ := by
    refine lt_of_le_of_ne le_top (fun h => ?_)
    exact lt_irrefl R (lt_of_lt_of_le hRP (Subgroup.subgroupOf_eq_top.mp h))
  obtain ⟨g', hg'N, hg'H⟩ := SetLike.exists_of_lt (hnc' _ hH'top)
  have hgR : ∀ z ∈ Z, (g' : G) * z * (g' : G)⁻¹ ∈ R := by
    intro z hz
    have hzP : z ∈ P := hZP hz
    have hzN : z ∈ Subgroup.normalizer (Z : Set G) := Subgroup.le_normalizer hz
    have hx : (⟨z, hzP⟩ : ↥P) ∈ R.subgroupOf P :=
      Subgroup.mem_subgroupOf.mpr ((hRmem z).mpr ⟨hzP, hzN⟩)
    exact Subgroup.mem_subgroupOf.mp ((Subgroup.mem_normalizer_iff.mp hg'N _).mp hx)
  have hmapN : Z.map (MulAut.conj (g' : G)).toMonoidHom ≤
      Subgroup.normalizer (Z : Set G) := by
    rintro y hy
    obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.mp hy
    simpa [MulAut.conj_apply] using ((hRmem _).mp (hgR z hz)).2
  have hconj : Z.map (MulAut.conj (g' : G)).toMonoidHom = Z := by
    have hle : CFSG.conjugate Z (g' : G)⁻¹ ≤ Subgroup.normalizer (Z : Set G) := by
      simpa [CFSG.conjugate] using hmapN
    have h := hwc (g' : G)⁻¹ hle
    simpa [CFSG.conjugate] using h
  have hgN : (g' : G) ∈ Subgroup.normalizer (Z : Set G) := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    simpa using hconj
  have hg'P : (g' : G) ∈ R := (hRmem _).mpr ⟨g'.2, hgN⟩
  exact hg'H (Subgroup.mem_subgroupOf.mpr hg'P)

theorem le_centralizer_of_isWeaklyClosedIn_normalizer {G : Type} [Group G] [Finite G]
    {Z P : Subgroup G}
    (hZP : Z ≤ P) (hP : IsPGroup 3 P) (hZ3 : Nat.card Z = 3)
    (hwc : CFSG.ASVolI.ChIJK.IsWeaklyClosedIn Z (Subgroup.normalizer (Z : Set G))) :
    Z ≤ Subgroup.centralizer (P : Set G) := by
  have hPN : P ≤ Subgroup.normalizer (Z : Set G) :=
    le_normalizer_of_isWeaklyClosedIn_normalizer hZP hP hwc
  obtain ⟨x, hxZ, hxord⟩ : ∃ x ∈ Z, orderOf x = 3 := by
    obtain ⟨y, hy⟩ := exists_prime_orderOf_dvd_card' (G := ↥Z) 3 (by omega)
    exact ⟨(y : G), y.2, (Subgroup.orderOf_coe y).trans hy⟩
  have hx1 : x ≠ 1 := by
    rintro rfl
    rw [orderOf_one] at hxord
    exact absurd hxord (by norm_num)
  have hx3 : x ^ 3 = 1 := by
    rw [← hxord]
    exact pow_orderOf_eq_one x
  have hzp : Subgroup.zpowers x = Z := by
    apply Subgroup.eq_of_le_of_card_ge
    · exact Subgroup.zpowers_le.mpr hxZ
    · exact le_of_eq (by rw [Nat.card_zpowers, hxord, hZ3])
  have hcls : ∀ w ∈ Z, w = 1 ∨ w = x ∨ w = x⁻¹ := by
    intro w hw
    have hwz : w ∈ Subgroup.zpowers x := by
      rw [hzp]
      exact hw
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hwz
    have hmod := zpow_mod_orderOf x k
    rw [hxord] at hmod
    push_cast at hmod
    rcases (by omega : k % 3 = 0 ∨ k % 3 = 1 ∨ k % 3 = 2) with h | h | h
    · left
      rw [h, zpow_zero] at hmod
      rw [← hmod]
    · right
      left
      rw [h, zpow_one] at hmod
      rw [← hmod]
    · right
      right
      rw [h] at hmod
      rw [← hmod, zpow_ofNat]
      exact eq_inv_of_mul_eq_one_left (by rw [← pow_succ]; exact hx3)
  have hcomm : ∀ p ∈ P, Commute p x := by
    intro p hp
    have hwZ : p * x * p⁻¹ ∈ Z := (Subgroup.mem_normalizer_iff.mp (hPN hp) x).mp hxZ
    rcases hcls _ hwZ with h1 | h1 | h1
    · exfalso
      apply hx1
      calc x = p⁻¹ * (p * x * p⁻¹) * p := by group
        _ = 1 := by rw [h1]; group
    · show p * x = x * p
      calc p * x = p * x * p⁻¹ * p := by group
        _ = x * p := by rw [h1]
    · exfalso
      have hsq : p ^ 2 * x * (p ^ 2)⁻¹ = x := by
        calc p ^ 2 * x * (p ^ 2)⁻¹ = p * (p * x * p⁻¹) * p⁻¹ := by rw [sq]; group
          _ = p * x⁻¹ * p⁻¹ := by rw [h1]
          _ = (p * x * p⁻¹)⁻¹ := by group
          _ = x := by rw [h1, inv_inv]
      have hodd : ∀ j : ℕ, p ^ (2 * j + 1) * x * (p ^ (2 * j + 1))⁻¹ = x⁻¹ := by
        intro j
        induction j with
        | zero => simpa using h1
        | succ n ih =>
          calc p ^ (2 * (n + 1) + 1) * x * (p ^ (2 * (n + 1) + 1))⁻¹
              = p ^ 2 * (p ^ (2 * n + 1) * x * (p ^ (2 * n + 1))⁻¹) * (p ^ 2)⁻¹ := by group
            _ = p ^ 2 * x⁻¹ * (p ^ 2)⁻¹ := by rw [ih]
            _ = (p ^ 2 * x * (p ^ 2)⁻¹)⁻¹ := by group
            _ = x⁻¹ := by rw [hsq]
      obtain ⟨m, hm⟩ := isPGroup_iff_pow_pow_eq_one.mp hP ⟨p, hp⟩
      have hpm : p ^ 3 ^ m = 1 := by
        have := congrArg Subtype.val hm
        simpa using this
      obtain ⟨j, hj⟩ : Odd (3 ^ m) := Odd.pow (⟨1, by norm_num⟩ : Odd (3 : ℕ))
      have hxj := hodd j
      rw [← hj, hpm, one_mul, inv_one, mul_one] at hxj
      have hx2 : x ^ 2 = 1 := by
        rw [sq]
        exact mul_eq_one_iff_eq_inv.mpr hxj
      have hdvd : orderOf x ∣ 2 := orderOf_dvd_of_pow_eq_one hx2
      rw [hxord] at hdvd
      omega
  intro z hz
  have hzx : z ∈ Subgroup.zpowers x := by
    rw [hzp]
    exact hz
  obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp hzx
  rw [Subgroup.mem_centralizer_iff]
  intro p hp
  exact (hcomm p hp).zpow_right j

theorem weaklyClosedIn_of_isWeaklyClosedIn_normalizer {G : Type} [Group G] [Finite G]
    {Z P : Subgroup G}
    (hZP : Z ≤ P) (hP : IsPGroup 3 P)
    (hwc : CFSG.ASVolI.ChIJK.IsWeaklyClosedIn Z (Subgroup.normalizer (Z : Set G))) :
    WeaklyClosedIn P Z := by
  have hPN : P ≤ Subgroup.normalizer (Z : Set G) :=
    le_normalizer_of_isWeaklyClosedIn_normalizer hZP hP hwc
  refine ⟨hZP, fun g hg => ?_⟩
  apply hwc g
  simpa [CFSG.conjugate, rightConjugate, Subgroup.conjBy] using hg.trans hPN

theorem eq_sup_inf_normalizer_of_isWeaklyClosedIn_normalizer {G : Type} [Group G] [Finite G]
    {C K Z P : Subgroup G}
    (hKC : K ≤ C) (hKn : (K.subgroupOf C).Normal) (hZK : Z ≤ K)
    (hP : CFSG.ABGLocalTools.IsSylowOf 3 P C) (hZP : Z ≤ P)
    (hwc : CFSG.ASVolI.ChIJK.IsWeaklyClosedIn Z (Subgroup.normalizer (Z : Set G))) :
    C = K ⊔ (Subgroup.normalizer (Z : Set G) ⊓ C) :=
  eq_sup_inf_normalizer_of_weaklyClosed hKC hKn hZK hP
    (weaklyClosedIn_of_isWeaklyClosedIn_normalizer hZP hP.isPGroup hwc)

theorem isSylowOf_three_centralizer_of_mem_uniqueSet {G : Type} [Group G] [Finite G]
    {D : Data G} {P X Z : Subgroup G}
    (hZU : Z ∈ uniqueSet D.M) (hP : CFSG.ABGLocalTools.IsSylowOf 3 P D.M) (hZP : Z ≤ P)
    (hPX : P ≤ Subgroup.centralizer (X : Set G)) :
    CFSG.ABGLocalTools.IsSylowOf 3 P (Subgroup.centralizer (X : Set G)) := by
  set C : Subgroup G := Subgroup.centralizer (X : Set G) with hC
  have hPC : P ≤ C := hPX
  have hPpC : IsPGroup 3 (P.subgroupOf C) := hP.isPGroup.comap_subtype
  obtain ⟨S, hPS⟩ := hPpC.exists_le_sylow
  have hS' : CFSG.ABGLocalTools.IsSylowOf 3 ((S : Subgroup ↥C).map C.subtype) C :=
    ⟨S, rfl⟩
  have hPS' : P ≤ (S : Subgroup ↥C).map C.subtype := by
    intro x hx
    exact Subgroup.mem_map.mpr ⟨⟨x, hPC hx⟩, hPS (Subgroup.mem_subgroupOf.mpr hx), rfl⟩
  have hS'M : (S : Subgroup ↥C).map C.subtype ≤ D.M :=
    CFSG.LocalAnalysis.UniquenessCase.PartOne.Section9.le_of_mem_uniqueSet_of_isPGroup
      D.maxLocal hZU (hZP.trans hPS') hS'.isPGroup
  have hS'eq : (S : Subgroup ↥C).map C.subtype = P :=
    CFSG.ABGLocalTools.IsSylowOf.eq_of_le hP hPS' hS'M hS'.isPGroup
  rwa [← hS'eq]

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8
