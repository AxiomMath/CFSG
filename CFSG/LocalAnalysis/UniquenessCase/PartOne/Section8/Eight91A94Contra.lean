private theorem k891a94contra_isElemAbelian_of_mulEquiv {G : Type} [Group G] {p : ℕ}
    {A B : Subgroup G} (e : ↥A ≃* ↥B) (hB : IsElemAbelian p B) : IsElemAbelian p A := by
  refine ⟨?_, ?_⟩
  · refine IsMulCommutative.of_comm (fun a b => ?_)
    apply e.injective
    rw [map_mul, map_mul]
    exact hB.1.is_comm.comm (e a) (e b)
  · intro x hx
    have h : (⟨x, hx⟩ : ↥A) ^ p = 1 := by
      apply e.injective
      show e ((⟨x, hx⟩ : ↥A) ^ p) = e 1
      rw [map_pow, map_one]
      refine Subtype.ext ?_
      simpa using hB.2 (e ⟨x, hx⟩) (e ⟨x, hx⟩).2
    exact congrArg Subtype.val h

private theorem k891a94contra_disjoint_of_isPGroup {G : Type} [Group G] [Finite G]
    {A B : Subgroup G} {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q)
    (hA : IsPGroup p A) (hB : IsPGroup q B) : A ⊓ B = ⊥ := by
  have hpF : Fact p.Prime := ⟨hp⟩
  have hqF : Fact q.Prime := ⟨hq⟩
  obtain ⟨m, hm⟩ := IsPGroup.iff_card.mp hA
  obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp hB
  have hcop : Nat.Coprime (Nat.card A) (Nat.card B) := by
    rw [hm, hn]
    exact Nat.coprime_pow_primes m n hp hq hpq
  exact (Subgroup.disjoint_of_coprime_natCard hcop).eq_bot

private theorem k891a94contra_inf_le_pCoreOf {G : Type} [Group G] [Finite G] {L M : Subgroup G}
    (hZ : Subgroup.center (Bar2 L) = ⊥) :
    L ⊓ CentOverO2 M L ≤ pCoreOf 2 L := by
  intro x hx
  obtain ⟨hxL, hxR⟩ := hx
  have hxT : ∀ l ∈ L, x * l * x⁻¹ * l⁻¹ ∈ pCoreOf 2 L :=
    (CFSG.LocalAnalysis.UniquenessCase.PartTwo.mem_centOverO2_iff.mp hxR).2
  have hcent : (QuotientGroup.mk (⟨x, hxL⟩ : ↥L) : Bar2 L) ∈ Subgroup.center (Bar2 L) := by
    rw [Subgroup.mem_center_iff]
    intro q
    induction q using QuotientGroup.induction_on with
    | H l =>
      rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq_iff_div_mem]
      have hcoe : (((l * ⟨x, hxL⟩) / (⟨x, hxL⟩ * l) : ↥L) : G) =
          (x * l * x⁻¹ * l⁻¹)⁻¹ := by
        simp [div_eq_mul_inv, mul_assoc]
      have hG : (((l * ⟨x, hxL⟩) / (⟨x, hxL⟩ * l) : ↥L) : G) ∈ pCoreOf 2 L := by
        rw [hcoe]
        exact (pCoreOf 2 L).inv_mem (hxT l l.2)
      obtain ⟨p, hp, hpeq⟩ := Subgroup.mem_map.mp hG
      have hp_eq : p = (l * ⟨x, hxL⟩) / (⟨x, hxL⟩ * l) := L.subtype_injective hpeq
      rwa [← hp_eq]
  rw [hZ] at hcent
  have hcore : (⟨x, hxL⟩ : ↥L) ∈ CFSG.pCore 2 ↥L :=
    (QuotientGroup.eq_one_iff _).mp (Subgroup.mem_bot.mp hcent)
  exact Subgroup.mem_map_of_mem (f := L.subtype) (K := CFSG.pCore 2 ↥L) hcore

private theorem k891a94contra_pCoreOf_le_inf {G : Type} [Group G] [Finite G] {L M : Subgroup G}
    (hLM : L ≤ M) :
    pCoreOf 2 L ≤ L ⊓ CentOverO2 M L := by
  refine le_inf (CFSG.LieType.BorelTits.pCoreOf_le 2 L) ?_
  intro x hx
  rw [CFSG.LocalAnalysis.UniquenessCase.PartTwo.mem_centOverO2_iff]
  refine ⟨hLM (CFSG.LieType.BorelTits.pCoreOf_le 2 L hx), ?_⟩
  intro l hl
  have hxN : x ∈ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
    CFSG.LocalAnalysis.UniquenessCase.UC6S846.normalizer_le_normalizer_pCoreOf L
      (Subgroup.le_normalizer (CFSG.LieType.BorelTits.pCoreOf_le 2 L hx))
  have hlN : l ∈ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
    CFSG.LocalAnalysis.UniquenessCase.UC6S846.normalizer_le_normalizer_pCoreOf L
      (Subgroup.le_normalizer hl)
  have h1 : l * x⁻¹ * l⁻¹ ∈ pCoreOf 2 L :=
    (Subgroup.mem_normalizer_iff.1 hlN x⁻¹).1 ((pCoreOf 2 L).inv_mem hx)
  have h2 : x * (l * x⁻¹ * l⁻¹) ∈ pCoreOf 2 L := (pCoreOf 2 L).mul_mem hx h1
  have h3 : x * l * x⁻¹ * l⁻¹ = x * (l * x⁻¹ * l⁻¹) := by group
  rwa [h3]

private theorem k891a94contra_C_le_M {G : Type} [Group G] [Finite G] {L M : Subgroup G} :
    CentOverO2 M L ≤ M := fun _ hx =>
  (CFSG.LocalAnalysis.UniquenessCase.PartTwo.mem_centOverO2_iff.mp hx).1



private theorem k891a94contra_inf_eq_pCoreOf {G : Type} [Group G] [Finite G] {L M : Subgroup G}
    (hLM : L ≤ M) (hZ : Subgroup.center (Bar2 L) = ⊥) :
    L ⊓ CentOverO2 M L = pCoreOf 2 L :=
  le_antisymm (k891a94contra_inf_le_pCoreOf hZ) (k891a94contra_pCoreOf_le_inf hLM)


private theorem k891a94contra_pRank_C_le_one {G : Type} [Group G] [Finite G]
    (D : Data G) (hM3 : CFSG.Open.pRank 3 D.M ≤ 3) {L : Subgroup G}
    (hLM : L ≤ D.M) (hMN : D.M ≤ Subgroup.normalizer (L : Set G))
    (hZ : Subgroup.center (Bar2 L) = ⊥) (hrank : CFSG.Open.pRank 3 L = 2) :
    CFSG.Open.pRank 3 (CentOverO2 D.M L) ≤ 1 := by
  classical
  set C : Subgroup G := CentOverO2 D.M L with hCdef
  set O : Subgroup G := pCoreOf 2 L with hOdef
  by_contra hcon
  have hCM : C ≤ D.M := by rw [hCdef]; exact k891a94contra_C_le_M
  have hOC : O ≤ C := by
    rw [hOdef, hCdef]
    exact (k891a94contra_pCoreOf_le_inf (M := D.M) hLM).trans inf_le_right
  have hO2 : IsPGroup 2 O := by
    rw [hOdef]
    exact (CFSG.pCore_isPGroup (p := 2) (G := ↥L)).map (Subgroup.subtype L)
  have hMO : D.M ≤ Subgroup.normalizer (O : Set G) := by
    rw [hOdef]
    exact hMN.trans (CFSG.LocalAnalysis.UniquenessCase.UC6S846.normalizer_le_normalizer_pCoreOf L)
  obtain ⟨Q, hQL, hQel, hQcard⟩ := CFSG.SectionRank.exists_pRank (p := 3) (by norm_num) L
  have hQcard' : Nat.card Q = 3 ^ 2 := by rw [hQcard, hrank]
  obtain ⟨Ae, hAeC, hAeel, hAecard⟩ := CFSG.SectionRank.exists_pRank (p := 3) (by norm_num) C
  have hAeO : Ae ≤ Subgroup.normalizer (O : Set G) := hAeC.trans (hCM.trans hMO)
  have hQO : Q ≤ Subgroup.normalizer (O : Set G) := hQL.trans (hLM.trans hMO)
  have hAeP : IsPGroup 3 Ae := hAeel.isPGroup
  have hQP : IsPGroup 3 Q := hQel.isPGroup
  have hcomm : ∀ e ∈ Q, ∀ a ∈ Ae, e * a * e⁻¹ * a⁻¹ ∈ O := by
    intro q hq a ha
    have haC : a ∈ CentOverO2 D.M L := by rw [← hCdef]; exact hAeC ha
    have h1 : a * q * a⁻¹ * q⁻¹ ∈ O := by
      have := (CFSG.LocalAnalysis.UniquenessCase.PartTwo.mem_centOverO2_iff.mp haC).2 q (hQL hq)
      rwa [hOdef]
    have h2 : q * a * q⁻¹ * a⁻¹ = (a * q * a⁻¹ * q⁻¹)⁻¹ := by group
    rw [h2]
    exact O.inv_mem h1
  obtain ⟨A', hA'cent, hA'sup, ⟨eA'⟩⟩ :=
    CFSG.LocalAnalysis.UniquenessCase.UC6S846.exists_centralizing_copy
      (ℓ := 3) (p := 3) Nat.prime_three (by norm_num) Nat.prime_three (by norm_num)
      O Ae Q hO2 hAeO hQO hAeP hQP hcomm
  have hA'el : IsElemAbelian 3 A' := k891a94contra_isElemAbelian_of_mulEquiv eA' hAeel
  have hA'P : IsPGroup 3 A' := hA'el.isPGroup
  have hA'card : Nat.card A' = 3 ^ CFSG.Open.pRank 3 C := by
    rw [← hAecard]
    exact Nat.card_congr eA'.toEquiv
  have hA'C : A' ≤ C := hA'sup.trans (sup_le hAeC hOC)
  have hA'O : A' ⊓ O = ⊥ :=
    k891a94contra_disjoint_of_isPGroup Nat.prime_three Nat.prime_two (by norm_num) hA'P hO2
  have hLC : L ⊓ C = O := by rw [hOdef, hCdef]; exact k891a94contra_inf_eq_pCoreOf hLM hZ
  have hdisj : Q ⊓ A' = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    have hxO : x ∈ O := by
      have hxLC : x ∈ L ⊓ C := ⟨hQL hx.1, hA'C hx.2⟩
      rwa [hLC] at hxLC
    have hxA'O : x ∈ A' ⊓ O := ⟨hx.2, hxO⟩
    rw [hA'O] at hxA'O
    exact hxA'O
  have hcomm2 : ∀ a ∈ Q, ∀ b ∈ A', a * b = b * a := by
    intro a ha b hb
    exact Subgroup.mem_centralizer_iff.1 (hA'cent hb) a ha
  have hsup_el : IsElemAbelian 3 (Q ⊔ A') := hQel.sup_of_commute hA'el hcomm2
  have hcard : Nat.card (Q ⊔ A' : Subgroup G) = 3 ^ (2 + CFSG.Open.pRank 3 C) := by
    have h := (CFSG.GroupTheory.card_sup_mul_card_inf_of_commute Q A' hcomm2).1
    rw [hdisj, Subgroup.card_bot, mul_one, hQcard', hA'card, ← pow_add] at h
    exact h
  have hleM : Q ⊔ A' ≤ D.M := sup_le (hQL.trans hLM) (hA'C.trans hCM)
  have hle := CFSG.SectionRank.le_pRank (p := 3) (by norm_num : 1 < 3) hleM hsup_el hcard
  omega


private theorem k891a94contra_pRank_quotient_le_one {K : Type} [Group K] [Finite K] {p : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) (Z : Subgroup K) [Z.Normal]
    (h1 : CFSG.Open.pRank p (⊤ : Subgroup K) ≤ 1) :
    CFSG.Open.pRank p (⊤ : Subgroup (K ⧸ Z)) ≤ 1 := by
  have : Fact p.Prime := ⟨hp⟩
  obtain ⟨S⟩ : Nonempty (Sylow p K) := inferInstance
  have hS1 : CFSG.Open.pRank p (S : Subgroup K) ≤ 1 := by
    rw [(CFSG.SectionRank.pRank_sylow S).1]
    exact h1
  have hScyc : IsCyclic ↥(S : Subgroup K) := by
    refine CFSG.isCyclic_of_pRank_le_one hp hp2 S.isPGroup' ?_
    rw [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup (S : Subgroup K)]
    exact hS1
  have hTcyc : IsCyclic ↥((S : Subgroup K).map (QuotientGroup.mk' Z)) :=
    isCyclic_of_surjective ((QuotientGroup.mk' Z).subgroupMap (S : Subgroup K))
      ((QuotientGroup.mk' Z).subgroupMap_surjective (S : Subgroup K))
  let T : Sylow p (K ⧸ Z) := S.mapSurjective (QuotientGroup.mk'_surjective Z)
  have hT1 : CFSG.Open.pRank p (T : Subgroup (K ⧸ Z)) ≤ 1 := by
    rw [CFSG.SectionRank.pRank_eq_pRank_top_subgroup (T : Subgroup (K ⧸ Z))]
    exact CFSG.pRank_le_one_of_isCyclic hp hTcyc
  rw [← (CFSG.SectionRank.pRank_sylow T).1]
  exact hT1

private theorem k891a94contra_normal_dichotomy {Q : Type} [Group Q]
    (hQ : CFSG.Open.IsQuasisimple Q) {N : Subgroup Q} (hN : N.Normal) :
    N = ⊤ ∨ N ≤ Subgroup.center Q := by
  obtain ⟨hp, hs⟩ := hQ
  have := hN
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal
    (N.map (QuotientGroup.mk' (Subgroup.center Q))) with h | h
  · right
    rwa [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at h
  · left
    have hsup : N ⊔ Subgroup.center Q = ⊤ := by
      have hc := Subgroup.comap_map_eq (QuotientGroup.mk' (Subgroup.center Q)) N
      rw [h, Subgroup.comap_top, QuotientGroup.ker_mk'] at hc
      exact hc.symm
    have hcomm : commutator Q ≤ N :=
      Subgroup.Normal.commutator_le_of_self_sup_commutative_eq_top hsup inferInstance
    exact eq_top_iff.mpr (hp ▸ hcomm)

private theorem k891a94contra_normal_dichotomy_simple {Q : Type} [Group Q] [IsSimpleGroup Q]
    {N : Subgroup Q} (hN : N.Normal) : N = ⊤ ∨ N ≤ Subgroup.center Q := by
  have := hN
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal N with h | h
  · exact Or.inr (h ▸ bot_le)
  · exact Or.inl h

private theorem k891a94contra_dichotomy {Q : Type} [Group Q]
    (h : CFSG.Open.IsQuasisimple Q ∨ IsSimpleGroup Q) {N : Subgroup Q} (hN : N.Normal) :
    N = ⊤ ∨ N ≤ Subgroup.center Q := by
  rcases h with h | h
  · exact k891a94contra_normal_dichotomy h hN
  · have := h
    exact k891a94contra_normal_dichotomy_simple hN

private theorem k891a94contra_conj_injective {X : Type} [Group X]
    (hZ : Subgroup.center X = ⊥) :
    Function.Injective (MulAut.conj : X →* MulAut X) := by
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro x hx
  rw [MonoidHom.mem_ker] at hx
  have hxZ : x ∈ Subgroup.center X := by
    rw [Subgroup.mem_center_iff]
    intro y
    have h1 : x * y * x⁻¹ = y := by
      have h2 := congrArg (fun f : MulAut X => f y) hx
      simpa [MulAut.conj_apply] using h2
    have h3 : x * y = y * x := by
      have h4 := congrArg (fun z => z * x) h1
      simpa [mul_assoc] using h4
    exact h3.symm
  rw [hZ] at hxZ
  exact hxZ


private theorem k891a94contra_le_of_commutator_le {C : Type} [Group C] (U P : Subgroup C)
    (hU : ∀ a b : C, a * b * a⁻¹ * b⁻¹ ∈ U) (hP : ⁅P, P⁆ = P) : P ≤ U := by
  have hle : ⁅P, P⁆ ≤ U := by
    rw [Subgroup.commutator_le]
    intro a ha b hb
    simpa [commutatorElement_def] using hU a b
  rwa [hP] at hle

