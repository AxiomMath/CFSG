private theorem k891a94contra_step3
    {G : Type} [Group G] [Finite G]
    (D : Data G) (hM3 : CFSG.Open.pRank 3 D.M ≤ 3) (hRank3 : R891ThreeRankCore)
    {L S A K K₀ : Subgroup G} {n : ℕ} (hn : 2 ≤ n)
    (hset : R891Set D L S n) (hbasic : R891Basic D L S) (_hA : R891Classes L S A)
    (hX1 : R891X1Shape L A n) (hcfg : R891Cfg894 D A K K₀ n)
    (hKLC : K ≤ L ⊔ CentOverO2 D.M L)
    (hK0 : K₀ = K) (hKK : ⁅K, K⁆ = K)
    (hshape : IsG2 (Bar2 K₀) n ∨ R891SL3Two (Bar2 K₀) n ∨ R891L3Pi (Bar2 K₀) n) :
    False := by
  classical
  have hLM : L ≤ D.M := CFSG.Open.IsSubnormal.le hset.mem.1
  have hMN : D.M ≤ Subgroup.normalizer (L : Set G) := hbasic.normal
  have hZ : Subgroup.center (Bar2 L) = ⊥ := hbasic.centerBot
  set C : Subgroup G := CentOverO2 D.M L with hCdef
  have hCM : C ≤ D.M := by rw [hCdef]; exact k891a94contra_C_le_M
  have hLCeq : L ⊓ C = pCoreOf 2 L := by
    rw [hCdef]; exact k891a94contra_inf_eq_pCoreOf hLM hZ
  have hC_le_NL : C ≤ Subgroup.normalizer (L : Set G) := hCM.trans hMN
