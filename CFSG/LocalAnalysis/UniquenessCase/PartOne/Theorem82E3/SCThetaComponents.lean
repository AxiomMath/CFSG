private theorem isPerfect_of_direct_simple
    {G : Type} [Group G] {S : Set (Subgroup G)} {K : Subgroup G}
    (hD : CFSG.SignalizerFunctorTheorem.McBride.IsDirectProduct S K)
    (hS : ∀ J ∈ S, IsSimpleGroup J ∧ ¬ IsMulCommutative J) : Group.IsPerfect K := by
  apply Subgroup.isPerfect_iff.mpr
  apply le_antisymm (Subgroup.commutator_le_self _) _
  rw [← hD.sSup_eq]
  apply sSup_le
  intro J hJ
  have : IsSimpleGroup J := (hS J hJ).1
  have : Group.IsPerfect J := TauCeti.IsSimpleGroup.isPerfect_of_not_isMulCommutative
    (hS J hJ).2
  rw [← Subgroup.commutator_eq_self (H := J)]
  exact Subgroup.commutator_mono (le_sSup hJ) (le_sSup hJ)

private theorem pCore_two_eq_bot_of_direct_simple
    {G : Type} [Group G] [Finite G] {S : Set (Subgroup G)} {K : Subgroup G}
    (hD : CFSG.SignalizerFunctorTheorem.McBride.IsDirectProduct S K)
    (hS : ∀ J ∈ S, IsSimpleGroup J ∧ ¬ IsMulCommutative J) : CFSG.pCore 2 K = ⊥ := by
  apply le_bot_iff.mp
  intro x hx
  apply Subgroup.mem_bot.mpr
  apply Subtype.ext
  have hx1 : x = (1 : K) := by
    apply hD.ext_coord
    intro J hJ
    rw [map_one]
    have : IsSimpleGroup J := (hS J hJ).1
    have : Group.IsPerfect J := TauCeti.IsSimpleGroup.isPerfect_of_not_isMulCommutative
      (hS J hJ).2
    have hJ2 : CFSG.pCore 2 J = ⊥ := by
      have hnab : ∃ a b : J, a * b ≠ b * a := by
        by_contra h
        push Not at h
        exact (hS J hJ).2 (isMulCommutative_iff.mpr h)
      rcases (hS J hJ).1.eq_bot_or_eq_top_of_normal (CFSG.pCore 2 J) with hbot | htop
      · exact hbot
      · exfalso
        have : Nontrivial J := CFSG.LocalCores.isQuasisimple_nontrivial
          (CFSG.LocalCores.isQuasisimple_of_isSimpleGroup hnab).1
        have h2 : IsPGroup 2 (⊤ : Subgroup J) := htop ▸ CFSG.pCore_isPGroup (p := 2) (G := J)
        have : Group.IsNilpotent (⊤ : Subgroup J) := h2.isNilpotent
        have hnil : Group.IsNilpotent J :=
          Group.nilpotent_of_mulEquiv (Subgroup.topEquiv (G := J))
        exact Group.IsPerfect.not_isNilpotent J hnil
    have hsurj : Function.Surjective (hD.coord hJ) := by
      intro j
      exact ⟨⟨j, hD.le hJ j.2⟩, Subtype.ext (hD.coord_of_mem hJ j.2)⟩
    have hm := CFSG.LieType.BorelTits.map_pCore_le 2 (hD.coord hJ) hsurj
    rw [hJ2] at hm
    exact Subgroup.mem_bot.mp (hm (Subgroup.mem_map_of_mem _ hx))
  exact congrArg Subtype.val hx1

theorem dvd_card_centralizer_AA_of_cyclic_component_orbit
    {G : Type} [Group G] [Finite G]
    (d : CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.SylowThreeData G)
    {x : G} (hx : x ∈ d.AA)
    (hAxis : ∀ i, centralizer (d.A i : Set G) ≤ d.M)
    {J : Subgroup (centralizer ({x} : Set G) ⧸ aschbacherSolvableCore 3 (centralizer ({x} : Set G)))}
    (hJ : CFSG.IsComponent J) (hJ3 : ¬ 3 ∣ Nat.card J)
    (hmove : ¬ (d.AA.subgroupOf (centralizer ({x} : Set G))).map
      (QuotientGroup.mk' (aschbacherSolvableCore 3 (centralizer ({x} : Set G)))) ≤
        normalizer (J : Set (centralizer ({x} : Set G) ⧸
          aschbacherSolvableCore 3 (centralizer ({x} : Set G)))))
    (hcyclic :
      let C := centralizer ({x} : Set G)
      let ρ := QuotientGroup.mk' (aschbacherSolvableCore 3 C)
      let A := (d.AA.subgroupOf C).map ρ
      let K := CFSG.SignalizerFunctorTheorem.McBride.orbitClosure J A
      ∃ i : Fin 3, ∃ a : C, (a : G) ∈ d.A i ∧
        A ≤ centralizer (K : Set (C ⧸ aschbacherSolvableCore 3 C)) ⊔ zpowers (ρ a))
    {r : ℕ} (hr : r.Prime) (hrJ : r ∣ Nat.card J) :
    r ∣ Nat.card ↥(d.M ⊓ centralizer (d.AA : Set G)) := by
  classical
  let C := centralizer ({x} : Set G)
  let θ := aschbacherSolvableCore 3 C
  let ρ := QuotientGroup.mk' θ
  let A := (d.AA.subgroupOf C).map ρ
  let K := CFSG.SignalizerFunctorTheorem.McBride.orbitClosure J A
  have : Fact r.Prime := ⟨hr⟩
  have hAC : d.AA ≤ C := fun a ha => Subgroup.mem_centralizer_singleton_iff.mpr
    (d.S_commute a x (d.AA_le_S ha) (d.AA_le_S hx))
  have hAe : CFSG.Open.IsElemAbelian 3 A := by
    refine ⟨⟨⟨fun a b => Subtype.ext ?_⟩⟩, ?_⟩
    · obtain ⟨u, hu, heu⟩ := a.2
      obtain ⟨v, hv, hev⟩ := b.2
      change (a : C ⧸ θ) * (b : C ⧸ θ) = (b : C ⧸ θ) * (a : C ⧸ θ)
      rw [← heu, ← hev]
      exact congrArg ρ (Subtype.ext (d.S_commute u v (d.AA_le_S hu) (d.AA_le_S hv)))
    · intro a ha
      obtain ⟨u, hu, rfl⟩ := ha
      rw [← map_pow]
      have hu3 : u ^ 3 = 1 := Subtype.ext (d.isElemAbelian_AA.2 u hu)
      rw [hu3, map_one]
  have hsJ : IsSimpleGroup J :=
    (CFSG.RankThree.ThetaFree.isSimpleGroup_of_center_eq_bot hJ
      (CFSG.RankThree.PartTwo.Sec11.component_center_bot_of_prime_three
        (CFSG.RankThree.theta_quotient_core_and_ranks (G := C)).1 hJ hJ3)).1
  have hnJ : ¬ IsMulCommutative J := by
    intro h
    have : Group.IsPerfect J := hJ.1.1
    have : Nontrivial J := CFSG.LocalCores.isQuasisimple_nontrivial hJ.1
    have : IsMulCommutative J := h
    exact Group.IsPerfect.not_isSolvable J inferInstance
  have hjl : J ∈ CFSG.SignalizerFunctorTheorem.McBride.lcal (⊤ : Subgroup (C ⧸ θ)) :=
    CFSG.SignalizerFunctorTheorem.McBride.mem_lcal_iff.mpr ⟨le_top, hJ.2.subgroupOf, hsJ, hnJ⟩
  have hAtop : A ≤ normalizer ((⊤ : Subgroup (C ⧸ θ)) : Set (C ⧸ θ)) := by
    rw [Subgroup.normalizer_eq_top]
    exact le_top
  have hd := (CFSG.SignalizerFunctorTheorem.McBride.Near.Lemma27.diagSetting_orbitClosure
    Nat.prime_three hAe hAtop hjl).1
  have hjK : J ∈ CFSG.SignalizerFunctorTheorem.McBride.lcal K :=
    (CFSG.SignalizerFunctorTheorem.McBride.Near.Lemma27.diagSetting_orbitClosure
      Nat.prime_three hAe hAtop hjl).2.symm ▸
        CFSG.SignalizerFunctorTheorem.McBride.Nonsolv.L514.self_mem_conjOrbit A J
  obtain ⟨i, a, hai, hact⟩ := hcyclic
  let b : C ⧸ θ := ρ a
  have haA : (a : G) ∈ d.AA := by
    rw [d.AA_def]
    fin_cases i
    · exact Subgroup.mem_sup_left (Subgroup.mem_sup_left hai)
    · exact Subgroup.mem_sup_left (Subgroup.mem_sup_right hai)
    · exact Subgroup.mem_sup_right hai
  have hbA : b ∈ A := Subgroup.mem_map_of_mem ρ haA
  have hb3 : b ^ 3 = 1 := hAe.2 b hbA
  have hbJ : b ∉ normalizer (J : Set (C ⧸ θ)) := by
    intro hn
    apply hmove
    have hCK : centralizer (K : Set (C ⧸ θ)) ≤ normalizer (J : Set (C ⧸ θ)) :=
      (Subgroup.centralizer_le (CFSG.SignalizerFunctorTheorem.McBride.lcal_le hjK)).trans
        (Subgroup.centralizer_le_normalizer _)
    exact hact.trans (sup_le hCK (Subgroup.zpowers_le.mpr hn))
  obtain ⟨e⟩ := CFSG.SignalizerFunctorTheorem.McBride.Near.Lemma27.exists_mulEquiv_diagOf
    Nat.prime_three hd.direct (hd.normalizes hbA) hb3 hjK hbJ
  let Z := CFSG.SignalizerFunctorTheorem.McBride.Near.Lemma27.diagOf K b J
  have hZA : Z ≤ centralizer (A : Set (C ⧸ θ)) := by
    have hZK := CFSG.SignalizerFunctorTheorem.McBride.Near.Lemma27.diagOf_le_cen K b J
    intro z hz c hc
    have hzK : z ∈ K := (hZK hz).1
    have hzb : z ∈ centralizer ({b} : Set (C ⧸ θ)) := (hZK hz).2
    have hDcent : centralizer (K : Set (C ⧸ θ)) ⊔ zpowers b ≤ centralizer ({z} : Set (C ⧸ θ)) := by
      apply sup_le
      · intro w hw
        exact Subgroup.mem_centralizer_singleton_iff.mpr (Subgroup.mem_centralizer_iff.mp hw z hzK).symm
      · apply Subgroup.zpowers_le.mpr
        exact Subgroup.mem_centralizer_singleton_iff.mpr
          (Subgroup.mem_centralizer_singleton_iff.mp hzb).symm
    exact Subgroup.mem_centralizer_singleton_iff.mp (hDcent (hact hc))
  have hrZ : r ∣ Nat.card Z := by rwa [Nat.card_congr e.toEquiv]
  let X : Subgroup G := (K.comap ρ).map C.subtype
  have hXC : X ≤ C := Subgroup.map_subtype_le _
  have hsubX : X.subgroupOf C = K.comap ρ := Subgroup.comap_map_eq_self_of_injective C.subtype_injective _
  have hXmap : (X.subgroupOf C).map ρ = K := by
    rw [hsubX, Subgroup.map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective θ)]
  have hK3 : ¬ 3 ∣ Nat.card K := by
    have hN3 : K ≤ CFSG.pPrimeCore 3 (C ⧸ θ) := by
      change CFSG.SignalizerFunctorTheorem.McBride.orbitClosure J A ≤ _
      rw [CFSG.SignalizerFunctorTheorem.McBride.Nonsolv.L514.orbitClosure_eq_sSup]
      apply sSup_le
      intro L hL
      obtain ⟨g, hg, rfl⟩ := hL
      have hs := (CFSG.LocalCores.isComponent_map_mulEquiv (MulAut.conj g) hJ).2
      exact CFSG.LocalAnalysis.RankThreeTheoremC.thc_le_pPrimeCore hs
        ((Nat.prime_three.coprime_iff_not_dvd).mpr (by
          rwa [Subgroup.card_map_of_injective (MulAut.conj g).injective]))
    exact fun h => (Nat.prime_three.coprime_iff_not_dvd.mp
      (CFSG.coprime_card_pPrimeCore 3 (C ⧸ θ))) (h.trans (Subgroup.card_dvd_of_le hN3))
  have hX3 : ¬ 3 ∣ Nat.card (X.subgroupOf C) := by
    rw [hsubX, CFSG.GroupTheory.card_comap_eq_card_ker_mul_card ρ
      (QuotientGroup.mk'_surjective θ), QuotientGroup.ker_mk']
    exact fun h => (Nat.prime_three.dvd_mul.mp h).elim
      CFSG.RankThree.three_not_dvd_card_aschbacherSolvableCore hK3
  have hAX : d.AA.subgroupOf C ≤ normalizer ((X.subgroupOf C : Subgroup C) : Set C) := by
    rw [hsubX]
    intro c hc
    exact Subgroup.le_normalizer_comap ρ (hd.normalizes (Subgroup.mem_map_of_mem ρ hc))
  have hAel : CFSG.Open.IsElemAbelian 3 (d.AA.subgroupOf C) :=
    d.isElemAbelian_AA.comap C.subtype_injective
  have hfix : ((X.subgroupOf C) ⊓ centralizer (d.AA.subgroupOf C : Set C)).map ρ =
      K ⊓ centralizer (A : Set (C ⧸ θ)) := by
    rw [← hXmap]
    exact CFSG.SignalizerFunctor.Helpers.coprime_centralizer_image_elementary
      3 Nat.prime_three ρ _ _ hAel hAX ((Nat.prime_three.coprime_iff_not_dvd).mpr hX3)
  have hrF : r ∣ Nat.card ↥((X.subgroupOf C) ⊓ centralizer (d.AA.subgroupOf C : Set C)) := by
    have hZle : Z ≤ K ⊓ centralizer (A : Set (C ⧸ θ)) :=
      le_inf (CFSG.SignalizerFunctorTheorem.McBride.Near.Lemma27.diagOf_le_cen K b J |>.trans inf_le_left) hZA
    have hrd : r ∣ Nat.card ↥(K ⊓ centralizer (A : Set (C ⧸ θ))) :=
      hrZ.trans (Subgroup.card_dvd_of_le hZle)
    rw [← hfix] at hrd
    exact hrd.trans (by
      simpa only [MonoidHom.range_comp, Subgroup.range_subtype] using
        Subgroup.card_range_dvd (ρ.comp ((X.subgroupOf C) ⊓ centralizer (d.AA.subgroupOf C : Set C)).subtype))
  let F : Subgroup C := (X.subgroupOf C) ⊓ centralizer (d.AA.subgroupOf C : Set C)
  have hFG : F.map C.subtype ≤ d.M ⊓ centralizer (d.AA : Set G) := by
    rintro z ⟨u, hu, rfl⟩
    have hc : (u : G) ∈ centralizer (d.AA : Set G) := by
      intro c hc
      have h := Subgroup.mem_centralizer_iff.mp hu.2 ⟨c, hAC hc⟩ hc
      exact congrArg Subtype.val h
    have hm : (u : G) ∈ d.M := by
      apply hAxis 0
      intro c hcA
      exact Subgroup.mem_centralizer_iff.mp hc c (by
        rw [d.AA_def]; exact Subgroup.mem_sup_left (Subgroup.mem_sup_left hcA))
    exact ⟨hm, hc⟩
  have hrFG : r ∣ Nat.card (F.map C.subtype) := by
    rw [Subgroup.card_map_of_injective C.subtype_injective]
    exact hrF
  exact hrFG.trans (Subgroup.card_dvd_of_le hFG)

theorem perfect_complement_lift_of_le_axis_pair
    {G : Type} [Group G] [Finite G] (d : SylowThreeData G)
    (hcal : ∀ i, d.Lf i ∈ calC d.M) {i j k : Fin 3}
    (hki : k ≠ i) (hkj : k ≠ j) {b : G} (hb : b ∈ d.A i ⊔ d.A j) :
    let X := d.Lf k ⊔ CFSG.Open.pCoreOf 2 d.M
    let C := X ⊓ centralizer ({b} : Set G)
    let Q := CFSG.Quasithin.perfectCore C
    Q ≤ d.Lf k ∧ Group.IsPerfect Q ∧ d.A k ≤ Q ∧
      ∃ π : Q →* Bar2 (d.Lf k), Function.Surjective π ∧ IsPGroup 2 π.ker := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let R := CFSG.Open.pCoreOf 2 d.M
  let X := d.Lf k ⊔ R
  let C := X ⊓ centralizer ({b} : Set G)
  let Q := CFSG.Quasithin.perfectCore C
  have hRM : R ≤ d.M := CFSG.LieType.BorelTits.pCoreOf_le 2 d.M
  have hXM : X ≤ d.M := sup_le (d.hLM k) hRM
  have hRN : d.M ≤ normalizer (R : Set G) := CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 d.M
  have hXRN : X ≤ normalizer (R : Set G) := hXM.trans hRN
  have hRX : R ≤ X := le_sup_right
  have hR2 : IsPGroup 2 R := CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 d.M
  have hR3 : ¬ 3 ∣ Nat.card R := CFSG.GroupTheory.not_dvd_card_of_isPGroup hR2 Nat.prime_three (by norm_num)
  have hAi : d.A i ≤ d.Lf i := (d.A_le_H i).trans (d.H_le_Lf i)
  have hAj : d.A j ≤ d.Lf j := (d.A_le_H j).trans (d.H_le_Lf j)
  have hAiAA : d.A i ≤ d.AA := by
    rw [d.AA_def]
    fin_cases i
    · exact le_sup_left.trans le_sup_left
    · exact le_sup_right.trans le_sup_left
    · exact le_sup_right
  have hAjAA : d.A j ≤ d.AA := by
    rw [d.AA_def]
    fin_cases j
    · exact le_sup_left.trans le_sup_left
    · exact le_sup_right.trans le_sup_left
    · exact le_sup_right
  have hbAA : b ∈ d.AA := (sup_le hAiAA hAjAA) hb
  let B := zpowers b
  have hBAA : B ≤ d.AA := Subgroup.zpowers_le.mpr hbAA
  have hBM : B ≤ d.M := hBAA.trans (d.AA_le_S.trans d.hS.le |>.trans (by
    rw [d.hL]
    exact sup_le (sup_le (d.hLM 0) (d.hLM 1)) (d.hLM 2)))
  have hB3 : IsPGroup 3 B := d.hS.isPGroup.to_le (hBAA.trans d.AA_le_S)
  have hBLN : B ≤ normalizer (d.Lf k : Set G) :=
    (Subgroup.zpowers_le.mpr hb).trans (sup_le (hAi.trans (d.hLnorm k i)) (hAj.trans (d.hLnorm k j)))
  have hBX : B ≤ normalizer (X : Set G) := fun z hz =>
    Subgroup.mem_normalizer_iff_map_conj_eq.mpr (by
      rw [Subgroup.map_sup, Subgroup.mem_normalizer_iff_map_conj_eq.mp (hBLN hz),
        Subgroup.mem_normalizer_iff_map_conj_eq.mp (hRN (hBM hz))])
  have hcomm : ⁅X, B⁆ ≤ R := by
    have hBi : ⁅d.A i, d.Lf k⁆ ≤ R := (Subgroup.commutator_mono hAi le_rfl).trans (d.hcomm i k hki.symm)
    have hBj : ⁅d.A j, d.Lf k⁆ ≤ R := (Subgroup.commutator_mono hAj le_rfl).trans (d.hcomm j k hkj.symm)
    have hB : ⁅B, d.Lf k⁆ ≤ R :=
      (Subgroup.commutator_mono (Subgroup.zpowers_le.mpr hb) le_rfl).trans
        (CFSG.GorensteinWalter.commutator_sup_le_of_commutator_le_and_normalize
          (d.A i) (d.A j) (d.Lf k) R hBi hBj (hAi.trans (d.hLM i) |>.trans hRN)
            (hAj.trans (d.hLM j) |>.trans hRN))
    have hRB : ⁅R, B⁆ ≤ R := (Subgroup.le_normalizer_iff_commutator_le_left).mp (hBM.trans hRN)
    rw [Subgroup.commutator_comm] at hB
    exact CFSG.GorensteinWalter.commutator_sup_le_of_commutator_le_and_normalize
      (d.Lf k) R B R hB hRB ((d.hLM k).trans hRN) Subgroup.le_normalizer
  have hcover : C ⊔ R = X := by
    have h := CFSG.GroupTheory.inf_centralizer_sup_eq_of_commutator_le
      hRX hBX (hBM.trans hRN) hB3 hR3 hcomm
    change X ⊓ centralizer (zpowers b : Set G) ⊔ R = X at h
    rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure] at h
    exact h
  have hcoreX : CFSG.Quasithin.perfectCore X = d.Lf k :=
    CFSG.GroupTheory.perfectCore_sup_pCoreOf_eq (d.hLM k) (hcal k).1 (d.hperf k)
  have hQX : Q ≤ X := (CFSG.Quasithin.perfectCore_le C).trans inf_le_left
  have hQL : Q ≤ d.Lf k := by
    rw [← hcoreX]
    exact CFSG.Quasithin.le_perfectCore_of_perfect hQX (CFSG.Quasithin.perfectCore_perfect C)
  have hRfk : R.subgroupOf (d.Lf k) = CFSG.pCore 2 (d.Lf k) := by
    apply Subgroup.map_injective (d.Lf k).subtype_injective
    rw [Subgroup.subgroupOf_map_subtype]
    change R ⊓ d.Lf k = CFSG.Open.pCoreOf 2 (d.Lf k)
    rw [CFSG.pCoreOf_eq_inf_pCoreOf_of_isSubnormal (hcal k).1, inf_comm]
  have hRnorm : (R.subgroupOf X).Normal := Subgroup.normal_subgroupOf_of_le_normalizer hXRN
  have hRfknorm : (R.subgroupOf (d.Lf k)).Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer ((d.hLM k).trans hRN)
  let e : (X ⧸ R.subgroupOf X) ≃* Bar2 (d.Lf k) :=
    (QuotientGroup.quotientInfEquivProdNormalizerQuotient (d.Lf k) R ((d.hLM k).trans hRN)).symm.trans
      (QuotientGroup.quotientMulEquivOfEq hRfk)
  let ρ : X →* Bar2 (d.Lf k) := e.toMonoidHom.comp (QuotientGroup.mk' (R.subgroupOf X))
  have hρ : Function.Surjective ρ := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hker : ρ.ker = R.subgroupOf X := by
    ext x
    change e (QuotientGroup.mk' (R.subgroupOf X) x) = 1 ↔ x ∈ R.subgroupOf X
    constructor
    · intro h
      apply (QuotientGroup.eq_one_iff x).mp
      exact e.injective (h.trans (map_one e).symm)
    · intro h
      have hx : QuotientGroup.mk' (R.subgroupOf X) x = 1 :=
        (QuotientGroup.eq_one_iff x).mpr h
      rw [hx, map_one]
  have hker2 : IsPGroup 2 ρ.ker := by
    rw [hker]
    exact hR2.of_equiv (Subgroup.subgroupOfEquivOfLe hRX).symm
  have hmapC : (C.subgroupOf X).map ρ = ⊤ := by
    have h := congrArg (fun K : Subgroup G => (K.subgroupOf X).map ρ) hcover
    rw [Subgroup.subgroupOf_sup inf_le_left hRX, Subgroup.map_sup,
      Subgroup.subgroupOf_self, Subgroup.map_top, MonoidHom.range_eq_top.mpr hρ] at h
    have hRmap : (R.subgroupOf X).map ρ = ⊥ := by
      rw [Subgroup.map_eq_bot_iff]
      exact le_of_eq hker.symm
    rwa [hRmap, sup_bot_eq] at h
  have hpcC : CFSG.Quasithin.perfectCore (C.subgroupOf X) = Q.subgroupOf X := by
    apply Subgroup.map_injective X.subtype_injective
    rw [CFSG.Quasithin.map_perfectCore, Subgroup.subgroupOf_map_subtype,
      inf_eq_left.mpr inf_le_left, Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hQX]
  have hmapQ : (Q.subgroupOf X).map ρ = ⊤ := by
    rw [← hpcC, CFSG.Quasithin.map_perfectCore, hmapC]
    have hperf : Group.IsPerfect (Bar2 (d.Lf k)) := by
      have : Group.IsPerfect (d.Lf k) := Subgroup.isPerfect_iff.mpr (d.hperf k)
      exact Group.IsPerfect.ofSurjective (f := QuotientGroup.mk' (CFSG.pCore 2 (d.Lf k))) (QuotientGroup.mk'_surjective _)
    exact CFSG.Quasithin.perfectCore_eq_self_of_perfect (Subgroup.isPerfect_iff.mp (Group.IsPerfect.top_iff.mpr hperf))
  let π : Q →* Bar2 (d.Lf k) := ρ.comp (Subgroup.inclusion hQX)
  have hπ : Function.Surjective π := by
    apply MonoidHom.range_eq_top.mp
    rw [MonoidHom.range_comp, Subgroup.inclusion_range]
    exact hmapQ
  have hπker2 : IsPGroup 2 π.ker := by
    let f : π.ker →* ρ.ker :=
      { toFun := fun x => ⟨Subgroup.inclusion hQX x, x.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl }
    have hf : Function.Injective f := by
      intro x y h
      apply Subtype.ext
      apply Subtype.ext
      exact congrArg (fun z : ρ.ker => ((z : X) : G)) h
    exact hker2.of_injective f hf
  have hAkC : d.A k ≤ C := by
    apply le_inf
    · exact ((d.A_le_H k).trans (d.H_le_Lf k)).trans le_sup_left
    · intro z hz
      exact Subgroup.mem_centralizer_singleton_iff.mpr (d.S_commute z b (d.A_le_S k hz) (d.AA_le_S hbAA))
  have hAkQ : d.A k ≤ Q := by
    have hQnormal : (Q.subgroupOf C).Normal := CFSG.Quasithin.perfectCore_normal C
    let ρC := ρ.comp (Subgroup.inclusion (show C ≤ X from inf_le_left))
    have hρCker2 : IsPGroup 2 ρC.ker := by
      let f : ρC.ker →* ρ.ker :=
        { toFun := fun x => ⟨Subgroup.inclusion (show C ≤ X from inf_le_left) x, x.2⟩
          map_one' := rfl
          map_mul' := fun _ _ => rfl }
      have hf : Function.Injective f := by
        intro x y h
        apply Subtype.ext
        apply Subtype.ext
        exact congrArg (fun z : ρ.ker => ((z : X) : G)) h
      exact hker2.of_injective f hf
    have hCQmap : (Q.subgroupOf C).map ρC = ⊤ := by
      rw [← Subgroup.map_map]
      have h : (Q.subgroupOf C).map (Subgroup.inclusion (show C ≤ X from inf_le_left)) = Q.subgroupOf X := by
        ext x
        constructor
        · rintro ⟨u, hu, rfl⟩
          exact hu
        · intro hx
          exact ⟨⟨x, (CFSG.Quasithin.perfectCore_le C) hx⟩, hx, rfl⟩
      rw [h]
      exact hmapQ
    intro z hz
    have hzC : z ∈ C := hAkC hz
    have hord : Odd (orderOf (⟨z, hzC⟩ : C)) := by
      rw [Subgroup.orderOf_mk]
      exact (by norm_num : Odd 3).of_dvd_nat (by rw [← d.card_A k]; exact Subgroup.orderOf_dvd_natCard (d.A k) hz)
    exact CFSG.LocalAnalysis.UniquenessCase.PartTwo.S17.mem_of_map_eq_top_of_odd
      ρC (Q.subgroupOf C) hCQmap hρCker2 hord
  exact ⟨hQL, Subgroup.isPerfect_iff.mpr (CFSG.Quasithin.perfectCore_perfect C), hAkQ, π, hπ, hπker2⟩

theorem exists_perfect_cyclic_component_lift
    {G : Type} [Group G] [Finite G] (d : SylowThreeData G)
    {x : G} (hx : x ∈ d.AA)
    {J : Subgroup (centralizer ({x} : Set G) ⧸ aschbacherSolvableCore 3 (centralizer ({x} : Set G)))}
    (hJ : CFSG.IsComponent J) (hJ3 : ¬ 3 ∣ Nat.card J)
    (hmove : ¬ (d.AA.subgroupOf (centralizer ({x} : Set G))).map
      (QuotientGroup.mk' (aschbacherSolvableCore 3 (centralizer ({x} : Set G)))) ≤
        normalizer (J : Set (centralizer ({x} : Set G) ⧸ aschbacherSolvableCore 3 (centralizer ({x} : Set G)))))
    (hcyclic :
      let C := centralizer ({x} : Set G)
      let ρ := QuotientGroup.mk' (aschbacherSolvableCore 3 C)
      let A := (d.AA.subgroupOf C).map ρ
      let K := orbitClosure J A
      ∃ k : Fin 3, ∃ a : C, (a : G) ∈ d.A k ∧ A ≤ centralizer (K : Set (C ⧸ aschbacherSolvableCore 3 C)) ⊔ zpowers (ρ a)) :
    ∃ (i j k : Fin 3) (b : G) (B Y : Subgroup G),
      i ≠ j ∧ k ≠ i ∧ k ≠ j ∧ b ∈ d.A i ⊔ d.A j ∧ b ≠ 1 ∧
      B ≤ d.AA ∧ Y ≤ centralizer ({b} : Set G) ∧ Group.IsPerfect Y ∧
      ¬ 3 ∣ Nat.card Y ∧ d.AA ≤ normalizer (Y : Set G) ∧ ⁅Y, d.AA⁆ = Y ∧
      B ≤ centralizer (Y : Set G) ∧ d.AA = B ⊔ d.A k ∧ Y ≠ ⊥ := by
  classical
  let C := centralizer ({x} : Set G)
  let θ := aschbacherSolvableCore 3 C
  let ρ := QuotientGroup.mk' θ
  let A := (d.AA.subgroupOf C).map ρ
  let K := orbitClosure J A
  have hAC : d.AA ≤ C := fun a ha => Subgroup.mem_centralizer_singleton_iff.mpr
    (d.S_commute a x (d.AA_le_S ha) (d.AA_le_S hx))
  have hAiAA : ∀ i, d.A i ≤ d.AA := by
    intro i
    rw [d.AA_def]
    fin_cases i
    · exact le_sup_left.trans le_sup_left
    · exact le_sup_right.trans le_sup_left
    · exact le_sup_right
  have hAe : CFSG.Open.IsElemAbelian 3 A := by
    refine ⟨⟨⟨fun a b => Subtype.ext ?_⟩⟩, ?_⟩
    · obtain ⟨u, hu, heu⟩ := a.2
      obtain ⟨v, hv, hev⟩ := b.2
      change (a : C ⧸ θ) * (b : C ⧸ θ) = (b : C ⧸ θ) * (a : C ⧸ θ)
      rw [← heu, ← hev]
      exact congrArg ρ (Subtype.ext (d.S_commute u v (d.AA_le_S hu) (d.AA_le_S hv)))
    · intro a ha
      obtain ⟨u, hu, rfl⟩ := ha
      rw [← map_pow]
      have h : u ^ 3 = 1 := Subtype.ext (d.isElemAbelian_AA.2 u hu)
      rw [h, map_one]
  have hcenter := CFSG.RankThree.PartTwo.Sec11.component_center_bot_of_prime_three
    (CFSG.RankThree.theta_quotient_core_and_ranks (G := C)).1 hJ hJ3
  have hsJ := (CFSG.RankThree.ThetaFree.isSimpleGroup_of_center_eq_bot hJ hcenter).1
  have hJn : ¬ IsMulCommutative J := by
    have : Group.IsPerfect J := hJ.1.1
    have : Nontrivial J := CFSG.LocalCores.isQuasisimple_nontrivial hJ.1
    intro hn
    have : IsMulCommutative J := hn
    exact Group.IsPerfect.not_isSolvable J inferInstance
  have hjl : J ∈ lcal (⊤ : Subgroup (C ⧸ θ)) :=
    mem_lcal_iff.mpr ⟨le_top, hJ.2.subgroupOf, hsJ, hJn⟩
  have hAtop : A ≤ normalizer ((⊤ : Subgroup (C ⧸ θ)) : Set (C ⧸ θ)) := by
    rw [Subgroup.normalizer_eq_top]
    exact le_top
  have hd := (Near.Lemma27.diagSetting_orbitClosure Nat.prime_three hAe hAtop hjl).1
  have hjK : J ∈ lcal K := (Near.Lemma27.diagSetting_orbitClosure Nat.prime_three hAe hAtop hjl).2.symm ▸
    CFSG.SignalizerFunctorTheorem.McBride.Nonsolv.L514.self_mem_conjOrbit A J
  have hK3 : ¬ 3 ∣ Nat.card K := by
    have hN : K ≤ CFSG.pPrimeCore 3 (C ⧸ θ) := by
      change orbitClosure J A ≤ CFSG.pPrimeCore 3 (C ⧸ θ)
      rw [CFSG.SignalizerFunctorTheorem.McBride.Nonsolv.L514.orbitClosure_eq_sSup]
      apply sSup_le
      intro L hL
      obtain ⟨g, hg, rfl⟩ := hL
      have hs := (CFSG.LocalCores.isComponent_map_mulEquiv (MulAut.conj g) hJ).2
      exact CFSG.LocalAnalysis.RankThreeTheoremC.thc_le_pPrimeCore hs
        ((Nat.prime_three.coprime_iff_not_dvd).mpr (by rwa [Subgroup.card_map_of_injective (MulAut.conj g).injective]))
    exact fun h => ((Nat.prime_three.coprime_iff_not_dvd).mp (CFSG.coprime_card_pPrimeCore 3 (C ⧸ θ)))
      (h.trans (Subgroup.card_dvd_of_le hN))
  obtain ⟨k, a, hak, hact⟩ := hcyclic
  let B : Subgroup G := d.AA ⊓ ((centralizer (K : Set (C ⧸ θ))).comap ρ).map C.subtype
  have hBA : B ≤ d.AA := inf_le_left
  have haA : (a : G) ∈ d.AA := hAiAA k hak
  have hba : ρ a ∈ A := Subgroup.mem_map_of_mem ρ haA
  have haN : ρ a ∉ normalizer (J : Set (C ⧸ θ)) := by
    intro hn
    apply hmove
    have hCN : centralizer (K : Set (C ⧸ θ)) ≤ normalizer (J : Set (C ⧸ θ)) :=
      (Subgroup.centralizer_le (lcal_le hjK)).trans (Subgroup.centralizer_le_normalizer _)
    exact hact.trans (sup_le hCN (Subgroup.zpowers_le.mpr hn))
  have ha1 : (a : G) ≠ 1 := by
    intro h
    have ha : a = 1 := Subtype.ext h
    exact haN (by rw [ha, map_one]; exact Subgroup.one_mem _)
  have hAk : d.A k = zpowers (a : G) := (Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hak)
    (by rw [d.card_A k, Nat.card_zpowers, orderOf_eq_prime (d.isElemAbelian_AA.2 a haA) ha1])).symm
  have haB : (a : G) ∉ B := by
    intro haB
    obtain ⟨u, hu, he⟩ := haB.2
    have heu : u = a := Subtype.ext he
    have hc : ρ a ∈ centralizer (K : Set (C ⧸ θ)) := heu ▸ hu
    exact haN ((Subgroup.centralizer_le (lcal_le hjK)).trans (Subgroup.centralizer_le_normalizer _) hc)
  have hAprod : d.AA = B ⊔ zpowers (a : G) := by
    apply le_antisymm
    · intro y hy
      have hya : ρ ⟨y, hAC hy⟩ ∈ A := Subgroup.mem_map_of_mem ρ hy
      have hcomm : zpowers (ρ a) ≤ normalizer (centralizer (K : Set (C ⧸ θ)) : Set (C ⧸ θ)) := by
        apply Subgroup.zpowers_le.mpr
        have : (centralizer (K : Set (C ⧸ θ)) |>.subgroupOf <| normalizer (K : Set (C ⧸ θ))).Normal := inferInstance
        have hbK : ρ a ∈ normalizer (K : Set (C ⧸ θ)) := hd.normalizes hba
        have hn := Subgroup.normal_subgroupOf_centralizer_normalizer (K : Set (C ⧸ θ))
        exact Subgroup.mem_normalizer_iff.mpr (by
          intro z
          have h := (Subgroup.normal_subgroupOf_iff_le_normalizer (Subgroup.centralizer_le_normalizer (K : Set (C ⧸ θ)))).mp hn
          exact Subgroup.mem_normalizer_iff.mp (h hbK) z)
      have hm : ρ ⟨y, hAC hy⟩ ∈ (centralizer (K : Set (C ⧸ θ)) : Set (C ⧸ θ)) * (zpowers (ρ a) : Set (C ⧸ θ)) := by
        rw [← Subgroup.coe_mul_of_right_le_normalizer_left _ _ hcomm]
        exact hact hya
      obtain ⟨c0, hc0, z, hz, hcz⟩ := hm
      obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hz
      have hyB : y * (a : G) ^ (-n) ∈ B := by
        refine ⟨d.AA.mul_mem hy (d.AA.zpow_mem haA _), ?_⟩
        refine ⟨⟨y * (a : G) ^ (-n), hAC (d.AA.mul_mem hy (d.AA.zpow_mem haA _))⟩, ?_, rfl⟩
        change ρ (⟨y, hAC hy⟩ * a ^ (-n)) ∈ centralizer (K : Set (C ⧸ θ))
        rw [map_mul, map_zpow]
        have h : ρ ⟨y, hAC hy⟩ * (ρ a) ^ (-n) = c0 := by
          rw [← hcz, ← hn]
          group
        rw [h]
        exact hc0
      have hyprod : y = (y * (a : G) ^ (-n)) * (a : G) ^ n := by group
      rw [hyprod]
      exact Subgroup.mul_mem_sup hyB (Subgroup.zpow_mem (zpowers (a : G)) (Subgroup.mem_zpowers (a : G)) n)
    · exact sup_le hBA (Subgroup.zpowers_le.mpr haA)
  have hAA : d.AA = B ⊔ d.A k := by rw [hAk]; exact hAprod
  have hB9 : Nat.card B = 9 := CFSG.RankThree.PartTwo.Sec13.card_plane_eq_nine
    d.isElemAbelian_AA d.card_AA haA (by rw [sup_comm]; exact hAprod) haB
  obtain ⟨i, j, hij, hki, hkj⟩ : ∃ i j : Fin 3, i ≠ j ∧ k ≠ i ∧ k ≠ j := by
    fin_cases k
    · exact ⟨1, 2, by decide, by decide, by decide⟩
    · exact ⟨0, 2, by decide, by decide, by decide⟩
    · exact ⟨0, 1, by decide, by decide, by decide⟩
  let E := d.A i ⊔ d.A j
  have hEA : E ≤ d.AA := sup_le (hAiAA i) (hAiAA j)
  have hE9 : Nat.card E = 9 := by simpa using d.card_A_sup_A hij
  have hBE : B ⊓ E ≠ ⊥ := CFSG.RankThree.PartTwo.Sec16.Proof169.inf_ne_bot_of_nine_le
    hBA hEA d.card_AA hB9.ge hE9.ge
  obtain ⟨b, hbBE, hb1⟩ : ∃ b ∈ B ⊓ E, b ≠ 1 := by
    by_contra h
    push Not at h
    apply hBE
    rw [Subgroup.eq_bot_iff_forall]
    exact h
  let X := (K.comap ρ).map C.subtype
  let U := X ⊓ centralizer (B : Set G)
  let Y := CFSG.Quasithin.perfectCore U
  have hXC : X ≤ C := Subgroup.map_subtype_le _
  have hXsub : X.subgroupOf C = K.comap ρ := Subgroup.comap_map_eq_self_of_injective C.subtype_injective _
  have hXmap : (X.subgroupOf C).map ρ = K := by
    rw [hXsub, Subgroup.map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective θ)]
  have hX3 : ¬ 3 ∣ Nat.card X := by
    rw [Subgroup.card_map_of_injective C.subtype_injective,
      CFSG.GroupTheory.card_comap_eq_card_ker_mul_card ρ (QuotientGroup.mk'_surjective θ), QuotientGroup.ker_mk']
    exact fun h => (Nat.prime_three.dvd_mul.mp h).elim CFSG.RankThree.three_not_dvd_card_aschbacherSolvableCore hK3
  have hAX : d.AA ≤ normalizer (X : Set G) := by
    apply CFSG.LocalAnalysis.GLTheoremA.I113.le_normalizer_map_subtype hAC
    intro c hc
    exact Subgroup.le_normalizer_comap ρ (hd.normalizes (Subgroup.mem_map_of_mem ρ hc))
  have hAAcB : d.AA ≤ centralizer (B : Set G) := fun y hy z hz =>
    d.S_commute z y (d.AA_le_S (hBA hz)) (d.AA_le_S hy)
  have hAU : d.AA ≤ normalizer (U : Set G) := fun y hy =>
    Subgroup.inf_normalizer_le_normalizer_inf ⟨hAX hy, Subgroup.le_normalizer (hAAcB hy)⟩
  have hAY : d.AA ≤ normalizer (Y : Set G) := hAU.trans (CFSG.Quasithin.normalizer_le_normalizer_perfectCore U)
  have hYC : Y ≤ C := (CFSG.Quasithin.perfectCore_le U).trans (inf_le_left.trans hXC)
  have hY3 : ¬ 3 ∣ Nat.card Y := fun h => hX3 (h.trans (Subgroup.card_dvd_of_le
    ((CFSG.Quasithin.perfectCore_le U).trans inf_le_left)))
  have hBcen : ((B.subgroupOf C).map ρ) ≤ centralizer (K : Set (C ⧸ θ)) := by
    rintro c ⟨u, hu, rfl⟩
    obtain ⟨v, hv, he⟩ := hu.2
    have he' : v = u := Subtype.ext he
    exact he' ▸ hv
  have hmapU : (U.subgroupOf C).map ρ = K := by
    have hB3 : CFSG.Open.IsElemAbelian 3 (B.subgroupOf C) := d.isElemAbelian_AA.comap C.subtype_injective |>.mono (Subgroup.subgroupOf_mono C hBA)
    have hBX : B.subgroupOf C ≤ normalizer (X.subgroupOf C : Set C) := by
      intro b hb
      rw [Subgroup.mem_normalizer_iff]
      intro z
      exact (Subgroup.mem_normalizer_iff.mp (hAX (hBA hb)) (z : G))
    have hXsub3 : ¬ 3 ∣ Nat.card (X.subgroupOf C) := by rwa [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hXC).toEquiv]
    have hUeq : (X.subgroupOf C) ⊓ centralizer (B.subgroupOf C : Set C) = U.subgroupOf C := by
      ext z
      change ((z : G) ∈ X ∧ z ∈ centralizer (B.subgroupOf C : Set C)) ↔ ((z : G) ∈ X ∧ (z : G) ∈ centralizer (B : Set G))
      refine and_congr_right fun hz => ?_
      rw [Subgroup.mem_centralizer_iff, Subgroup.mem_centralizer_iff]
      constructor
      · intro h b hb
        exact congrArg Subtype.val (h ⟨b, hAC (hBA hb)⟩ hb)
      · intro h b hb
        exact Subtype.ext (h b hb)
    rw [← hUeq]
    have h := CFSG.SignalizerFunctor.Helpers.coprime_centralizer_image_elementary
      3 Nat.prime_three ρ _ _ hB3 hBX ((Nat.prime_three.coprime_iff_not_dvd).mpr hXsub3)
    rw [h, hXmap]
    exact inf_eq_left.mpr (Subgroup.le_centralizer_iff.mp hBcen)
  have hKperf : Group.IsPerfect K := by
    exact Subgroup.isPerfect_iff.mpr (by
      apply le_antisymm (CFSG.Quasithin.A3.commutator_self_le K)
      change orbitClosure J A ≤ ⁅orbitClosure J A, orbitClosure J A⁆
      rw [← hd.direct.sSup_eq]
      apply sSup_le
      intro L hL
      have h := mem_lcal_iff.mp hL
      have : IsSimpleGroup L := h.2.2.1
      have : Group.IsPerfect L := TauCeti.IsSimpleGroup.isPerfect_of_not_isMulCommutative h.2.2.2
      rw [← Subgroup.commutator_eq_self (H := L)]
      exact Subgroup.commutator_mono (le_sSup hL) (le_sSup hL))
  have hpc : CFSG.Quasithin.perfectCore (U.subgroupOf C) = Y.subgroupOf C := by
    apply Subgroup.map_injective C.subtype_injective
    rw [CFSG.Quasithin.map_perfectCore, Subgroup.subgroupOf_map_subtype,
      inf_eq_left.mpr (inf_le_left.trans hXC), Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hYC]
  have hmapY : (Y.subgroupOf C).map ρ = K := by
    rw [← hpc, CFSG.Quasithin.map_perfectCore, hmapU]
    exact CFSG.Quasithin.perfectCore_eq_self_of_perfect (Subgroup.isPerfect_iff.mp hKperf)
  have hgenK : ⁅K, A⁆ = K := by
    have hS := Near.Lemma27.isSemisimple_of_isDirectProduct hd.direct (fun L hL => by
      have h := mem_lcal_iff.mp hL
      exact ⟨h.2.2.1, by
        by_contra hn
        push Not at hn
        exact h.2.2.2 (isMulCommutative_iff.mpr (fun u v => Subtype.ext (hn u u.2 v v.2)))⟩)
    change ⁅orbitClosure J A, A⁆ = orbitClosure J A
    rw [commutator_eq_sSup_not_centralized hS hd.normalizes]
    apply le_antisymm (sSup_le fun L hL => lcal_le hL.1)
    conv_lhs => rw [← hd.direct.sSup_eq]
    apply sSup_le
    intro L hL
    apply le_sSup
    refine ⟨hL, ?_⟩
    intro hcent
    have hN := Near.Lemma27.stabilizer_eq hd hjK hL
    have hAnL : A ≤ normalizer (L : Set (C ⧸ θ)) := (Subgroup.le_centralizer_iff.mpr hcent).trans (Subgroup.centralizer_le_normalizer _)
    have hAnJ : A ≤ normalizer (J : Set (C ⧸ θ)) := by
      intro a ha
      have : a ∈ A ⊓ normalizer (L : Set (C ⧸ θ)) := ⟨ha, hAnL ha⟩
      rw [← hN] at this
      exact this.2
    exact hmove hAnJ
  have hgenY : ⁅Y, d.AA⁆ = Y := by
    have hcommY : ⁅Y, d.AA⁆ ≤ Y := Subgroup.le_normalizer_iff_commutator_le_left.mp hAY
    have hAAmap : (d.AA.subgroupOf C).map C.subtype = d.AA := by
      rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hAC]
    have hYmap : (Y.subgroupOf C).map C.subtype = Y := by
      rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hYC]
    have hcommMap : (⁅Y, d.AA⁆.subgroupOf C).map C.subtype = ⁅Y, d.AA⁆ := by
      rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr (hcommY.trans hYC)]
    have hmapcomm : (⁅Y, d.AA⁆.subgroupOf C).map ρ = K := by
      have heq : ⁅Y, d.AA⁆.subgroupOf C = ⁅Y.subgroupOf C, d.AA.subgroupOf C⁆ := by
        apply Subgroup.map_injective C.subtype_injective
        rw [hcommMap, Subgroup.map_commutator, hYmap, hAAmap]
      rw [heq, Subgroup.map_commutator, hmapY]
      exact hgenK
    have hnY : (⁅Y, d.AA⁆.subgroupOf Y).Normal :=
      Subgroup.normal_subgroupOf_of_le_normalizer (Subgroup.normalizer_commutator_ge_left Y d.AA)
    have hYperf : Group.IsPerfect Y := Subgroup.isPerfect_iff.mpr (CFSG.Quasithin.perfectCore_perfect U)
    have : Group.IsPerfect (Y.subgroupOf C) := Group.IsPerfect.ofSurjective
      (f := (Subgroup.subgroupOfEquivOfLe hYC).symm.toMonoidHom)
      (Subgroup.subgroupOfEquivOfLe hYC).symm.surjective
    let ρY := ρ.comp (Subgroup.inclusion hYC)
    have hkerSol : Group.IsSolvable ρY.ker := by
      let ι : ρY.ker →* θ :=
        { toFun := fun u => ⟨⟨u, hYC u.1.2⟩, (QuotientGroup.eq_one_iff (⟨u, hYC u.1.2⟩ : C)).mp u.2⟩
          map_one' := rfl
          map_mul' := fun _ _ => rfl }
      have : Group.IsSolvable θ := (solvable_prime_complement_core_characterization Nat.prime_three).1
      have hi : Function.Injective ι := by
        intro u v h
        apply Subtype.ext
        apply Subtype.ext
        exact congrArg (fun z : θ => ((z : C) : G)) h
      exact Group.isSolvable_of_isSolvable_injective hi
    have hmapcommY : (⁅Y, d.AA⁆.subgroupOf Y).map ρY = K := by
      rw [← Subgroup.map_map]
      have he : (⁅Y, d.AA⁆.subgroupOf Y).map (Subgroup.inclusion hYC) = ⁅Y, d.AA⁆.subgroupOf C := by
        ext z
        constructor
        · rintro ⟨u, hu, rfl⟩
          exact hu
        · intro hz
          exact ⟨⟨z, hcommY hz⟩, hz, rfl⟩
      rw [he]
      exact hmapcomm
    have hmaptop : (⊤ : Subgroup Y).map ρY = K := by
      rw [Subgroup.map_top, MonoidHom.range_comp, Subgroup.inclusion_range]
      exact hmapY
    have : Group.IsSolvable ρY.ker := hkerSol
    have h := CFSG.ComponentClassification.SolvableKernelContainment.perfect_containment
      ρY (⊤ : Subgroup Y) (⁅Y, d.AA⁆.subgroupOf Y) (by rw [hmaptop, hmapcommY])
    have hg := Subgroup.map_mono (f := Y.subtype) h
    rw [Subgroup.map_top, Subgroup.range_subtype, Subgroup.subgroupOf_map_subtype,
      inf_eq_left.mpr hcommY] at hg
    exact le_antisymm hcommY hg
  have hYbot : Y ≠ ⊥ := by
    intro hbot
    rw [hbot, Subgroup.bot_subgroupOf, Subgroup.map_bot] at hmapY
    have hJbot : J = ⊥ := le_bot_iff.mp (hmapY.symm ▸ lcal_le hjK)
    exact hJn (by rw [hJbot]; infer_instance)
  refine ⟨i, j, k, b, B, Y, hij, hki, hkj, hbBE.2, hb1, hBA, ?_,
    Subgroup.isPerfect_iff.mpr (CFSG.Quasithin.perfectCore_perfect U), hY3, hAY, hgenY, ?_, hAA, hYbot⟩
  · exact (CFSG.Quasithin.perfectCore_le U).trans (inf_le_right.trans (by
      intro z hz
      exact Subgroup.mem_centralizer_singleton_iff.mpr ((Subgroup.mem_centralizer_iff.mp hz b hbBE.1).symm)))
  · exact Subgroup.le_centralizer_iff.mpr ((CFSG.Quasithin.perfectCore_le U).trans inf_le_right)

