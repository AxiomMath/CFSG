theorem orbit_ncard_le_six_of_le_perfectCoreL
    {G : Type} [Group G] [Finite G] {D : CFSG.LocalAnalysis.UniquenessCase.UC22.Data G}
    (c : Ctx82E3 D) {b : G} {Q J : Subgroup G}
    (hQI : Q ≤ ONan.perfectCoreL c b) (hJ : J ∈ CFSG.RankThree.thetaComponentsAt 3 b)
    (hJ3 : ¬ 3 ∣ Nat.card J) : (orbitConjugates Q J).ncard ≤ 6 := by
  have hI : (orbitConjugates (ONan.perfectCoreL c b) J).ncard ≤ 6 := by
    by_contra h
    have hge : 7 ≤ (orbitConjugates (ONan.perfectCoreL c b) J).ncard := by omega
    obtain ⟨r, H, hr, hr2, hH, hHr⟩ := ONan.twoLocal_rank_four_of_orbit c hJ hJ3 hge
    have hle := CFSG.RankThreeCoreUniqueness.Helpers.local_pRank_le_evenRank r hr hr2 H hH
    rw [c.rank] at hle
    omega
  have hsub : orbitConjugates Q J ⊆ orbitConjugates (ONan.perfectCoreL c b) J := by
    rintro K ⟨q, hq, rfl⟩
    exact ⟨q, hQI hq, rfl⟩
  exact (Set.ncard_le_ncard hsub).trans hI

theorem le_normalizer_theta_component_of_perfect_simple_quotient
    {G : Type} [Group G] [Finite G] {D : CFSG.LocalAnalysis.UniquenessCase.UC22.Data G}
    (c : Ctx82E3 D) {b : G} {Q J : Subgroup G}
    (hQI : Q ≤ ONan.perfectCoreL c b) (hQ : Group.IsPerfect Q)
    {S : Type} [Group S] [Finite S] [IsSimpleGroup S]
    (π : Q →* S) (hπ : Function.Surjective π) (hsol : Group.IsSolvable π.ker)
    {p : ℕ} (hp : p.Prime) (hp5 : 5 < p) (hpS : p ∣ Nat.card S)
    (hJ : J ∈ CFSG.RankThree.thetaComponentsAt 3 b) (hJ3 : ¬ 3 ∣ Nat.card J) :
    Q ≤ normalizer (J : Set G) := by
  classical
  let : MulAction Q (Subgroup G) :=
    MulAction.compHom (Subgroup G) (MulAut.conj.comp Q.subtype)
  have hsmul : ∀ (q : Q) (K : Subgroup G), q • K = K.map (MulAut.conj (q : G)).toMonoidHom := by
    intro q K
    change (MulAut.conj (q : G)) • K = _
    rw [Subgroup.pointwise_smul_def]
    rfl
  have horbit : MulAction.orbit Q J = orbitConjugates Q J := by
    ext K
    constructor
    · rintro ⟨q, rfl⟩
      refine ⟨(q : G)⁻¹, Q.inv_mem q.2, ?_⟩
      change q • J = CFSG.conjugate J ((q : G)⁻¹)
      rw [hsmul, CFSG.conjugate]
      simp
    · rintro ⟨q, hq, rfl⟩
      refine ⟨⟨q⁻¹, Q.inv_mem hq⟩, ?_⟩
      change (⟨q⁻¹, Q.inv_mem hq⟩ : Q) • J = CFSG.conjugate J q
      rw [hsmul, CFSG.conjugate]
  let O := MulAction.orbit Q J
  let φ : Q →* Equiv.Perm O := MulAction.toPermHom Q O
  have hOcard : Nat.card O < p := by
    rw [Nat.card_coe_set_eq]
    change (MulAction.orbit Q J).ncard < p
    rw [horbit]
    have hle := orbit_ncard_le_six_of_le_perfectCoreL c hQI hJ hJ3
    have hp6 : p ≠ 6 := by intro h; subst p; norm_num at hp
    omega
  have hφ := CFSG.GroupTheory.perm_eq_one_of_perfect_simple_solvable_kernel hQ π hπ hsol hp hpS hOcard φ
  intro q hq
  have heq : (⟨q, hq⟩ : Q) • J = J := by
    have h := congrArg (fun f : Equiv.Perm O => f ⟨J, MulAction.mem_orbit_self J⟩)
      (congrArg (fun f : Q →* Equiv.Perm O => f ⟨q, hq⟩) hφ)
    exact congrArg Subtype.val h
  rw [hsmul] at heq
  exact Subgroup.mem_normalizer_iff_map_conj_eq.mpr heq

theorem le_normalizer_theta_component_of_perfect_quasisimple_quotient
    {G : Type} [Group G] [Finite G] {D : CFSG.LocalAnalysis.UniquenessCase.UC22.Data G}
    (c : Ctx82E3 D) {b : G} {Q J : Subgroup G}
    (hQI : Q ≤ ONan.perfectCoreL c b) (hQ : Group.IsPerfect Q)
    {S : Type} [Group S] [Finite S] (hS : CFSG.IsQuasisimple S)
    (π : Q →* S) (hπ : Function.Surjective π) (hsol : Group.IsSolvable π.ker)
    {p : ℕ} (hp : p.Prime) (hp5 : 5 < p) (hpS : p ∣ Nat.card (S ⧸ center S))
    (hJ : J ∈ CFSG.RankThree.thetaComponentsAt 3 b) (hJ3 : ¬ 3 ∣ Nat.card J) :
    Q ≤ normalizer (J : Set G) := by
  have : IsSimpleGroup (S ⧸ center S) := hS.2.1
  exact le_normalizer_theta_component_of_perfect_simple_quotient c hQI hQ
    ((QuotientGroup.mk' (center S)).comp π)
    ((QuotientGroup.mk'_surjective (center S)).comp hπ)
    (CFSG.GroupTheory.isSolvable_ker_center_quotient_comp π hsol) hp hp5 hpS hJ hJ3

theorem commutator_theta_quotient_eq_bot_of_perfect_quasisimple_quotient
    {G : Type} [Group G] [Finite G] {D : CFSG.LocalAnalysis.UniquenessCase.UC22.Data G}
    (c : Ctx82E3 D) (hSz : CFSG.RankThree.PartTwo.KFacts.KPSz)
    {b : G} {Q J : Subgroup G}
    (hQI : Q ≤ ONan.perfectCoreL c b) (hQ : Group.IsPerfect Q)
    {S : Type} [Group S] [Finite S] (hS : CFSG.IsQuasisimple S)
    (π : Q →* S) (hπ : Function.Surjective π) (hsol : Group.IsSolvable π.ker)
    {p : ℕ} (hp : p.Prime) (hp5 : 5 < p) (hpS : p ∣ Nat.card (S ⧸ center S))
    (hS3 : 3 ∣ Nat.card (S ⧸ center S))
    (hJ : J ∈ CFSG.RankThree.thetaComponentsAt 3 b) (hJ3 : ¬ 3 ∣ Nat.card J)
    (hC : CFSG.Open.IsKGroup (centralizer ({b} : Set G))) :
    let C := centralizer ({b} : Set G)
    let ρ := QuotientGroup.mk' (CFSG.RankThree.LocalRank.aschbacherSolvableCore 3 C)
    ⁅(Q.subgroupOf C).map ρ, (J.subgroupOf C).map ρ⁆ = ⊥ := by
  let C := centralizer ({b} : Set G)
  let θ := CFSG.RankThree.LocalRank.aschbacherSolvableCore 3 C
  let ρ := QuotientGroup.mk' θ
  let I := (J.subgroupOf C).map ρ
  have hJC : J ≤ C := by
    obtain ⟨J0, -, he⟩ := hJ
    rw [← he]
    exact Subgroup.map_subtype_le _
  have hQC : Q ≤ C := hQI.trans (ONan.perfectCoreL_le c b |>.trans inf_le_right)
  have hJN := le_normalizer_theta_component_of_perfect_quasisimple_quotient
    c hQI hQ hS π hπ hsol hp hp5 hpS hJ hJ3
  have hJs : J.subgroupOf C ∈ CFSG.RankThree.thetaComponents 3 C := by
    obtain ⟨J0, hJ0, he⟩ := hJ
    rw [← he, Subgroup.subgroupOf, Subgroup.comap_map_eq_self_of_injective C.subtype_injective]
    exact hJ0
  have hcompI : CFSG.IsComponent I := CFSG.RankThree.isComponent_map_of_mem_thetaComponents Nat.prime_three hJs
  have hI3 : ¬ 3 ∣ Nat.card I := by
    intro hi
    have hc : Nat.card I ∣ Nat.card (J.subgroupOf C) := by
      simpa only [MonoidHom.range_comp, Subgroup.range_subtype] using Subgroup.card_range_dvd (ρ.comp (J.subgroupOf C).subtype)
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hJC).toEquiv] at hc
    exact hJ3 (hi.trans hc)
  have hcenter := CFSG.RankThree.PartTwo.Sec11.component_center_bot_of_prime_three
    (CFSG.RankThree.theta_quotient_core_and_ranks (G := C)).1 hcompI hI3
  have hsI := (CFSG.RankThree.ThetaFree.isSimpleGroup_of_center_eq_bot hcompI hcenter).1
  have : IsSimpleGroup I := hsI
  have hInab : ∃ a b : I, a * b ≠ b * a := by
    have : Group.IsPerfect I := hcompI.1.1
    have : Nontrivial I := CFSG.LocalCores.isQuasisimple_nontrivial hcompI.1
    by_contra hn
    push Not at hn
    have : IsMulCommutative I := ⟨⟨hn⟩⟩
    exact Group.IsPerfect.not_isSolvable I inferInstance
  have hcat := (hC.quotient θ).isCatalogGroup_of_surjective I hInab (MonoidHom.id I) Function.surjective_id
  obtain ⟨f, hf⟩ := hSz I hInab hcat hI3
  have hcyc := (CFSG.LieType.Suzuki.Suzuki_model_and_perfect_cover_outer_cyclicity.{0} I 2 f hf).1.1
  have hOut : Group.IsSolvable (CFSG.ComponentClassification.OuterAutomorphisms.Outer I) := by
    have : IsCyclic (CFSG.ComponentClassification.OuterAutomorphisms.Outer I) := hcyc
    infer_instance
  have hQn : Q.subgroupOf C ≤ normalizer (J.subgroupOf C : Set C) := by
    intro q hq
    rw [Subgroup.mem_normalizer_iff]
    intro j
    exact (Subgroup.mem_normalizer_iff.mp (hJN hq) (j : G))
  have hQnI : (Q.subgroupOf C).map ρ ≤ normalizer (I : Set (C ⧸ θ)) :=
    (Subgroup.map_mono hQn).trans (Subgroup.le_normalizer_map ρ)
  let α : Q →* MulAut I := (Subgroup.normalizerMonoidHom I).comp
    { toFun := fun q => ⟨ρ ⟨q, hQC q.2⟩, hQnI (Subgroup.mem_map_of_mem ρ q.2)⟩
      map_one' := Subtype.ext (map_one ρ)
      map_mul' := fun q r => Subtype.ext (map_mul ρ ⟨q, hQC q.2⟩ ⟨r, hQC r.2⟩) }
  have hα := CFSG.GroupTheory.mulAut_eq_one_of_perfect_quasisimple_solvable_kernel hQ hS π hπ hsol hS3 hI3 hOut α
  rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
  rintro a ⟨q, hq, rfl⟩
  intro j hj
  have h := congrArg (fun α : Q →* MulAut I => α ⟨q, hq⟩ ⟨j, hj⟩) hα
  have heq : ρ q * j * (ρ q)⁻¹ = j := congrArg Subtype.val h
  exact (mul_inv_eq_iff_eq_mul.mp heq).symm

theorem commutator_pPrimeCore_image_eq_bot_of_perfect_quasisimple_quotient
    {G : Type} [Group G] [Finite G] {D : CFSG.LocalAnalysis.UniquenessCase.UC22.Data G}
    (c : Ctx82E3 D) (hSz : CFSG.RankThree.PartTwo.KFacts.KPSz)
    {b : G} {Q : Subgroup G}
    (hQI : Q ≤ ONan.perfectCoreL c b) (hQ : Group.IsPerfect Q)
    {S : Type} [Group S] [Finite S] (hS : CFSG.IsQuasisimple S)
    (π : Q →* S) (hπ : Function.Surjective π) (hsol : Group.IsSolvable π.ker)
    {p : ℕ} (hp : p.Prime) (hp5 : 5 < p) (hpS : p ∣ Nat.card (S ⧸ center S))
    (hS3 : 3 ∣ Nat.card (S ⧸ center S))
    (hC : CFSG.Open.IsKGroup (centralizer ({b} : Set G))) :
    let C := centralizer ({b} : Set G)
    let ρ := QuotientGroup.mk' (aschbacherSolvableCore 3 C)
    ⁅(Q.subgroupOf C).map ρ, (CFSG.pPrimeCore 3 C).map ρ⁆ = ⊥ := by
  classical
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let C := centralizer ({b} : Set G)
  let θ := aschbacherSolvableCore 3 C
  let ρ := QuotientGroup.mk' θ
  let N := (CFSG.pPrimeCore 3 C).map ρ
  let A := (Q.subgroupOf C).map ρ
  have hQC : Q ≤ C := hQI.trans (ONan.perfectCoreL_le c b |>.trans inf_le_right)
  have hNnorm : N.Normal := (CFSG.pPrimeCore_normal (p := 3) (G := C)).map ρ (QuotientGroup.mk'_surjective θ)
  have hN3 : ¬ 3 ∣ Nat.card N := fun h =>
    ((Nat.prime_three.coprime_iff_not_dvd).mp (CFSG.coprime_card_pPrimeCore 3 C))
      (h.trans (by
        simpa only [MonoidHom.range_comp, Subgroup.range_subtype] using
          Subgroup.card_range_dvd (ρ.comp (CFSG.pPrimeCore 3 C).subtype)))
  have hNtheta : aschbacherSolvableCore 3 N = ⊥ := by
    have hsub : N.IsSubnormal := hNnorm.isSubnormal
    have h := CFSG.RankThree.solvable_prime_complement_core_subnormal_intersection Nat.prime_three hsub
    rw [(CFSG.RankThree.theta_quotient_core_and_ranks (G := C)).1, inf_bot_eq] at h
    change (aschbacherSolvableCore 3 N).map N.subtype = ⊥ at h
    exact (Subgroup.map_eq_bot_iff_of_injective _ N.subtype_injective).mp h
  have hrad : CFSG.solvableRadical N = ⊥ := by
    rw [← CFSG.RankThree.PartTwo.Sec16.Proof166Three.aschbacherSolvableCore_eq_solvableRadical hN3]
    exact hNtheta
  have hAN : A ≤ normalizer (N : Set (C ⧸ θ)) := by
    have hEq := Subgroup.normalizer_eq_top_iff.mpr hNnorm
    rw [hEq]
    exact le_top
  let α : Q →* MulAut N := (Subgroup.normalizerMonoidHom N).comp
    { toFun := fun q => ⟨ρ ⟨q, hQC q.2⟩, hAN (Subgroup.mem_map_of_mem ρ q.2)⟩
      map_one' := Subtype.ext (map_one ρ)
      map_mul' := fun q r => Subtype.ext (map_mul ρ ⟨q, hQC q.2⟩ ⟨r, hQC r.2⟩) }
  have hfixcomp : ∀ I : Subgroup N, CFSG.IsComponent I → ∀ q : Q, ∀ n ∈ I, α q n = n := by
    intro I hI q n hn
    let J := I.map N.subtype
    have : N.Normal := hNnorm
    have hJ : CFSG.IsComponent J := CFSG.RankThree.PartTwo.Sec4.Item432Proof.isComponent_map_subtype hI
    obtain ⟨L, hL, hLmap⟩ := (CFSG.RankThree.theta_component_quotient_correspondence (H := C) Nat.prime_three).1.surjOn hJ
    change L.map ρ = J at hLmap
    have hL3 : ¬ 3 ∣ Nat.card L := by
      have hJ3 : ¬ 3 ∣ Nat.card J := by
        rw [Subgroup.card_map_of_injective N.subtype_injective]
        exact fun h => hN3 (h.trans (Subgroup.card_subgroup_dvd_card I))
      have hle : L ≤ J.comap ρ := by
        rw [← hLmap]
        exact Subgroup.le_comap_map _ _
      have hp : ¬ 3 ∣ Nat.card (J.comap ρ) := by
        rw [CFSG.GroupTheory.card_comap_eq_card_ker_mul_card ρ (QuotientGroup.mk'_surjective θ), QuotientGroup.ker_mk']
        exact fun h => (Nat.prime_three.dvd_mul.mp h).elim CFSG.RankThree.three_not_dvd_card_aschbacherSolvableCore hJ3
      exact fun h => hp (h.trans (Subgroup.card_dvd_of_le hle))
    let LG := L.map C.subtype
    have hLG : LG ∈ CFSG.RankThree.thetaComponentsAt 3 b := ⟨L, hL, rfl⟩
    have hLG3 : ¬ 3 ∣ Nat.card LG := by rwa [Subgroup.card_map_of_injective C.subtype_injective]
    have hm := commutator_theta_quotient_eq_bot_of_perfect_quasisimple_quotient
      c hSz hQI hQ hS π hπ hsol hp hp5 hpS hS3 hLG hLG3 hC
    have hsub : LG.subgroupOf C = L := Subgroup.comap_map_eq_self_of_injective C.subtype_injective _
    change ⁅A, (LG.subgroupOf C).map ρ⁆ = ⊥ at hm
    rw [hsub, hLmap] at hm
    have hc : ρ ⟨q, hQC q.2⟩ ∈ centralizer (J : Set (C ⧸ θ)) :=
      Subgroup.commutator_eq_bot_iff_le_centralizer.mp hm (Subgroup.mem_map_of_mem ρ q.2)
    apply Subtype.ext
    change ρ ⟨q, hQC q.2⟩ * (n : C ⧸ θ) * (ρ ⟨q, hQC q.2⟩)⁻¹ = (n : C ⧸ θ)
    have hnJ : (n : C ⧸ θ) ∈ J := Subgroup.mem_map_of_mem N.subtype hn
    rw [← Subgroup.mem_centralizer_iff.mp hc _ hnJ]
    group
  have hfix : ∀ q : Q, ∀ n ∈ CFSG.generalizedFitting N, α q n = n := by
    intro q
    rw [CFSG.SignalizerFunctorTheorem.McBride.generalizedFitting_eq_layer_of_solvableRadical_eq_bot hrad]
    have hcen : (CFSG.layer N) ≤ ((α q).toMonoidHom.eqLocus (MonoidHom.id N)) := by
      rw [CFSG.layer]
      apply sSup_le
      intro I hI n hn
      exact hfixcomp I hI q n hn
    intro n hn
    exact hcen hn
  have : Group.IsPerfect Q := hQ
  have hα := CFSG.RankThree.PartTwo.Sec16.Res6Act.eq_one_of_fix_generalizedFitting α hfix
  rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
  rintro a ⟨q, hq, rfl⟩
  intro n hn
  have h := congrArg (fun α : Q →* MulAut N => α ⟨q, hq⟩ ⟨n, hn⟩) hα
  have heq : ρ q * n * (ρ q)⁻¹ = n := congrArg Subtype.val h
  exact (mul_inv_eq_iff_eq_mul.mp heq).symm

end ComponentOrbit

