variable {G : Type} [Group G] [Finite G]

theorem pRank_le_one_of_isSec_sylowThreeData
    (d : SylowThreeData G) {S : Type} [Group S] [Finite S] [IsSimpleGroup S]
    (h3 : 3 ∣ Nat.card S) (hSec : IsSec S d.L) : CFSG.pRank 3 S ≤ 1 := by
  have hq : IsSec S d.Q := hSec.quotient_of_not_dvd h3
    (SylowThreeData.three_not_dvd_Kbar d)
  have hp : IsSec S ((d.Lb 0 × d.Lb 1) × d.Lb 2) :=
    IsSec.of_surjective (MonoidHom.range_eq_top.mp (SylowThreeData.mu_range_top d)) hq
  have hr : ∀ i : Fin 3, IsSec S (d.Lb i) → CFSG.pRank 3 S ≤ 1 := by
    intro i hi
    obtain ⟨H, φ, hφ⟩ := hi
    have hH : CFSG.pRank 3 H ≤ 1 := by
      rw [CFSG.SectionRank.pRank_coe_eq_openPRank]
      exact (CFSG.SectionRank.pRank_mono (by norm_num) (le_top : H ≤ ⊤)).trans
        (d.pRank_Lb i).le
    exact pRank_le_one_of_surjective Nat.prime_three (by norm_num) hH φ hφ
  rcases isSec_prod hp with h01 | h2
  · rcases isSec_prod h01 with h0 | h1
    · exact hr 0 h0
    · exact hr 1 h1
  · exact hr 2 h2

theorem normal_L_of_permutes_factors (d : SylowThreeData G)
    (hperm : ∀ m ∈ d.M, ∀ i,
      ∃ j, (d.Lf i).map (MulAut.conj m).toMonoidHom = d.Lf j) :
    (d.L.subgroupOf d.M).Normal := by
  have hLM : d.L ≤ d.M := by
    rw [d.hL]
    exact sup_le (sup_le (d.hLM 0) (d.hLM 1)) (d.hLM 2)
  apply (normal_subgroupOf_iff_le_normalizer hLM).mpr
  intro m hm
  have hmap : d.L.map (MulAut.conj m).toMonoidHom ≤ d.L := by
    rw [d.hL, Subgroup.map_sup, Subgroup.map_sup, ← d.hL]
    have h : ∀ i : Fin 3, (d.Lf i).map (MulAut.conj m).toMonoidHom ≤ d.L := by
      intro i
      obtain ⟨j, hj⟩ := hperm m hm i
      rw [hj]
      exact d.Lf_le_L j
    exact sup_le (sup_le (h 0) (h 1)) (h 2)
  apply mem_normalizer_iff_map_conj_eq.mpr
  exact Subgroup.eq_of_le_of_card_ge hmap
    (by rw [Subgroup.card_map_of_injective (MulAut.conj m).injective])

theorem pRank_le_one_of_isSec_M_of_actual_sylow
    (d : SylowThreeData G)
    (hS : CFSG.ABGLocalTools.IsSylowOf 3 d.S d.M)
    (hperm : ∀ m ∈ d.M, ∀ i,
      ∃ j, (d.Lf i).map (MulAut.conj m).toMonoidHom = d.Lf j)
    {S : Type} [Group S] [Finite S] [IsSimpleGroup S]
    (h3 : 3 ∣ Nat.card S) (hSec : IsSec S d.M) : CFSG.pRank 3 S ≤ 1 := by
  have : (d.L.subgroupOf d.M).Normal := normal_L_of_permutes_factors d hperm
  have hLM : d.L ≤ d.M := by
    rw [d.hL]
    exact sup_le (sup_le (d.hLM 0) (d.hLM 1)) (d.hLM 2)
  have hidx : ¬ 3 ∣ (d.L.subgroupOf d.M).index := by
    have hn := (CFSG.ABGLocalTools.isSylowOf_iff.mp hS).2.2
    intro hd
    apply hn
    rw [← relIndex_mul_relIndex d.S d.L d.M d.hS.le hLM]
    exact hd.mul_left _
  have hL : IsSec S d.L := (hSec.of_index_not_dvd h3 hidx).of_mulEquiv
    (subgroupOfEquivOfLe hLM)
  exact pRank_le_one_of_isSec_sylowThreeData d h3 hL

theorem pRank_le_one_of_isSec_of_factorization_of_simple_sections
    (M : Subgroup G)
    (hRank : ∀ (T : Type) [Group T] [Finite T] [IsSimpleGroup T],
      3 ∣ Nat.card T → IsSec T M → CFSG.pRank 3 T ≤ 1)
    (C : Subgroup G)
    (hfac : C = (C ⊓ M) ⊔ (CFSG.pPrimeCore 3 C).map C.subtype)
    {S : Type} [Group S] [Finite S] [IsSimpleGroup S]
    (h3 : 3 ∣ Nat.card S) (hSec : IsSec S C) : CFSG.pRank 3 S ≤ 1 := by
  classical
  let N := CFSG.pPrimeCore 3 C
  let π := QuotientGroup.mk' N
  let H : Subgroup G := C ⊓ M
  let f : H →* C ⧸ N := π.comp (Subgroup.inclusion inf_le_left)
  have hf : Function.Surjective f := by
    intro q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N q
    have hx : (x : G) ∈ H ⊔ N.map C.subtype := by
      rw [← hfac]
      exact x.2
    have hcomm : H ⊔ N.map C.subtype = N.map C.subtype ⊔ H := sup_comm _ _
    rw [hcomm] at hx
    have hnrm : H ≤ normalizer ((N.map C.subtype : Subgroup G) : Set G) :=
      CFSG.LocalAnalysis.GLTheoremA.I113.le_normalizer_map_subtype
        (show H ≤ C from inf_le_left) (by
          have : N.Normal := inferInstance
          rw [Subgroup.normalizer_eq_top]; exact le_top)
    have hprodset : ((H ⊔ N.map C.subtype : Subgroup G) : Set G) =
        (H : Set G) * ((N.map C.subtype : Subgroup G) : Set G) :=
      Subgroup.coe_mul_of_left_le_normalizer_right H (N.map C.subtype) hnrm
    have hx' : (x : G) ∈ ((H ⊔ N.map C.subtype : Subgroup G) : Set G) := by
      change (x : G) ∈ H ⊔ N.map C.subtype
      rw [sup_comm]
      exact hx
    rw [hprodset] at hx'
    obtain ⟨h, hh, n, hn, he⟩ := hx'
    obtain ⟨n', hn', hen⟩ := hn
    let nc : C := ⟨n, by rw [← hen]; exact n'.2⟩
    let hc : C := ⟨h, hh.1⟩
    have hnc : nc ∈ N := by
      change n' ∈ N at hn'
      have hne : nc = n' := Subtype.ext hen.symm
      exact hne ▸ hn'
    have hprod : hc * nc = x := Subtype.ext he
    have hnc1 : π nc = 1 := (QuotientGroup.eq_one_iff nc).mpr hnc
    refine ⟨⟨h, hh⟩, ?_⟩
    change π hc = π x
    rw [← hprod, map_mul, hnc1, mul_one]
  have hN : ¬ 3 ∣ Nat.card N :=
    (Nat.prime_three.coprime_iff_not_dvd).mp (CFSG.coprime_card_pPrimeCore 3 C)
  have hq : IsSec S (C ⧸ N) := hSec.quotient_of_not_dvd h3 hN
  have hH : IsSec S H := IsSec.of_surjective hf hq
  have hHM : H ≤ M := inf_le_right
  have hM : IsSec S M := CFSG.SignalizerFunctorTheorem.IsSectionOf.of_injective hH
    (Subgroup.inclusion hHM) (Subgroup.inclusion_injective hHM)
  exact hRank S h3 hM

theorem pRank_thetaQuot_le_one_of_actual_sylow_of_simple_sections
    (d : SylowThreeData G)
    {x : G} (hS : CFSG.ABGLocalTools.IsSylowOf 3 d.S (centralizer ({x} : Set G)))
    (hRank : ∀ (T : Type) [Group T] [Finite T] [IsSimpleGroup T],
      3 ∣ Nat.card T → IsSec T d.M → CFSG.pRank 3 T ≤ 1)
    (hx : x ∈ d.AA)
    {J : Subgroup (centralizer ({x} : Set G))}
    (hJ : J ∈ CFSG.RankThree.thetaComponents 3 (centralizer ({x} : Set G)))
    (hdiv : 3 ∣ Nat.card J)
    (hfac : centralizer ({x} : Set G) =
      (centralizer ({x} : Set G) ⊓ d.M) ⊔
        (CFSG.pPrimeCore 3 (centralizer ({x} : Set G))).map
          (centralizer ({x} : Set G)).subtype) :
    CFSG.pRank 3 (J ⧸ aschbacherSolvableCore 3 J) ≤ 1 := by
  have hs := isSimpleGroup_theta_quotient_of_actual_sylow d hS hx hJ
  have : IsSimpleGroup (J ⧸ aschbacherSolvableCore 3 J) := hs
  have hθ : ¬ 3 ∣ Nat.card (aschbacherSolvableCore 3 J) :=
    CFSG.RankThree.three_not_dvd_card_aschbacherSolvableCore
  have h3q : 3 ∣ Nat.card (J ⧸ aschbacherSolvableCore 3 J) := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (aschbacherSolvableCore 3 J)] at hdiv
    exact (Nat.prime_three.dvd_mul.mp hdiv).resolve_right hθ
  have hSec : IsSec (J ⧸ aschbacherSolvableCore 3 J) (centralizer ({x} : Set G)) :=
    (isSec_of_surjective (QuotientGroup.mk' (aschbacherSolvableCore 3 J))
      (QuotientGroup.mk'_surjective _)).of_subgroup
  exact pRank_le_one_of_isSec_of_factorization_of_simple_sections d.M hRank _ hfac h3q hSec

theorem isCyclic_autIn_of_abelian_sylow_of_pRank_le_one
    {H : Type} [Group H] [Finite H]
    (hInner : CFSG.LocalAnalysis.RankThreeTheoremC.KFactInnerAction)
    {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (P : Sylow p H)
    (hP : ∀ a ∈ (P : Subgroup H), ∀ b ∈ (P : Subgroup H), a * b = b * a)
    {K : Subgroup H} (hK : CFSG.IsComponent K)
    [IsSimpleGroup K] (hcat : CFSG.Open.IsCatalogGroup K)
    (hdiv : p ∣ Nat.card K) (hr : CFSG.pRank p K ≤ 1) :
    IsCyclic (autIn (P : Subgroup H) K) := by
  classical
  have : Fact p.Prime := ⟨hp⟩
  obtain ⟨T, hT⟩ := CFSG.Walter.exists_sylow_map_eq_inf_of_isSubnormal P hK.2
  have hTcomm : IsMulCommutative (T : Subgroup K) := by
    refine ⟨⟨fun a b => Subtype.ext (Subtype.ext ?_)⟩⟩
    have ha : (a : H) ∈ (P : Subgroup H) :=
      (hT ▸ Subgroup.mem_map_of_mem _ a.2).1
    have hb : (b : H) ∈ (P : Subgroup H) :=
      (hT ▸ Subgroup.mem_map_of_mem _ b.2).1
    exact hP a ha b hb
  have hnonab : ∃ a b : K, a * b ≠ b * a := by
    have : Group.IsPerfect K := hK.1.1
    by_contra hab
    push Not at hab
    have : IsMulCommutative K := ⟨⟨hab⟩⟩
    have : Group.IsSolvable K := inferInstance
    exact Group.IsPerfect.not_isSolvable K inferInstance
  have hc : IsCyclic (T : Subgroup K) :=
    isCyclic_sylow_of_pRank_le_one hp hp2 hr T
  let f : (T : Subgroup K) →* MulAut K := MulAut.conj.comp (T : Subgroup K).subtype
  have hle : autIn (P : Subgroup H) K ≤ f.range := by
    intro φ hφ
    obtain ⟨g, hgN, hgP, rfl⟩ := mem_autIn_iff.mp hφ
    have hpow : ∃ n : ℕ, (K.normalizerMonoidHom ⟨g, hgN⟩) ^ (p ^ n) = 1 := by
      obtain ⟨n, hn⟩ := P.isPGroup' ⟨g, hgP⟩
      refine ⟨n, ?_⟩
      have hgpow : g ^ (p ^ n) = 1 :=
        congrArg (fun y : (P : Subgroup H) => (y : H)) hn
      have hgn : (⟨g, hgN⟩ : normalizer (K : Set H)) ^ (p ^ n) = 1 :=
        Subtype.ext hgpow
      rw [← map_pow, hgn, map_one]
    have hcomm : ∀ t ∈ (T : Subgroup K),
        (K.normalizerMonoidHom ⟨g, hgN⟩) * MulAut.conj t =
          MulAut.conj t * (K.normalizerMonoidHom ⟨g, hgN⟩) := by
      intro t ht
      have htP : (t : H) ∈ (P : Subgroup H) :=
        (hT ▸ Subgroup.mem_map_of_mem _ ht).1
      have hfix : K.normalizerMonoidHom ⟨g, hgN⟩ t = t := by
        apply Subtype.ext
        change g * (t : H) * g⁻¹ = (t : H)
        rw [mul_inv_eq_iff_eq_mul]
        exact hP g hgP t htP
      ext y
      simp only [MulAut.mul_apply, MulAut.conj_apply, map_mul, map_inv, hfix]
    obtain ⟨t, ht, he⟩ := hInner p hp hp2 K inferInstance hnonab
      hcat T (T.ne_bot_of_dvd_card hdiv) hTcomm _ hpow hcomm
    exact ⟨⟨t, ht⟩, he.symm⟩
  have : IsCyclic f.range := isCyclic_of_surjective f.rangeRestrict f.rangeRestrict_surjective
  exact isCyclic_of_injective (Subgroup.inclusion hle) (Subgroup.inclusion_injective hle)

theorem autThetaQuot_card_le_three_of_actual_sylow_of_simple_sections
    (hInner : CFSG.LocalAnalysis.RankThreeTheoremC.KFactInnerAction)
    (d : SylowThreeData G) {x : G} (hS : CFSG.ABGLocalTools.IsSylowOf 3 d.S (centralizer ({x} : Set G)))
    (hRank : ∀ (T : Type) [Group T] [Finite T] [IsSimpleGroup T],
      3 ∣ Nat.card T → IsSec T d.M → CFSG.pRank 3 T ≤ 1)
    (hx : x ∈ d.AA)
    {J : Subgroup (centralizer ({x} : Set G))}
    (hJ : J ∈ CFSG.RankThree.thetaComponents 3 (centralizer ({x} : Set G)))
    (hK : CFSG.Open.IsKGroup (centralizer ({x} : Set G)))
    (hdiv : 3 ∣ Nat.card J)
    (hfac : centralizer ({x} : Set G) =
      (centralizer ({x} : Set G) ⊓ d.M) ⊔
        (CFSG.pPrimeCore 3 (centralizer ({x} : Set G))).map
          (centralizer ({x} : Set G)).subtype) :
    Nat.card (autThetaQuot (d.AA.subgroupOf (centralizer ({x} : Set G))) J) ≤ 3 := by
  classical
  let C : Subgroup G := centralizer ({x} : Set G)
  let θ := aschbacherSolvableCore 3 C
  let ρ := QuotientGroup.mk' θ
  let K : Subgroup (C ⧸ θ) := J.map ρ
  let A : Subgroup C := d.AA.subgroupOf C
  obtain ⟨η, hη⟩ := CFSG.RankThree.exists_thetaQuotient_mulEquiv_map Nat.prime_three hJ.2.1
  have hs := isSimpleGroup_theta_quotient_of_actual_sylow d hS hx hJ
  have : IsSimpleGroup (J ⧸ aschbacherSolvableCore 3 J) := hs
  have : IsSimpleGroup K := (MulEquiv.isSimpleGroup_congr η).mp hs
  have hnJ : ∃ a b : J ⧸ aschbacherSolvableCore 3 J, a * b ≠ b * a := by
    have : Group.IsPerfect (J ⧸ aschbacherSolvableCore 3 J) := hJ.2.2.1
    have : Nontrivial (J ⧸ aschbacherSolvableCore 3 J) := CFSG.LocalCores.isQuasisimple_nontrivial hJ.2.2
    by_contra hab
    push Not at hab
    have : IsMulCommutative (J ⧸ aschbacherSolvableCore 3 J) := ⟨⟨hab⟩⟩
    have : Group.IsSolvable (J ⧸ aschbacherSolvableCore 3 J) := inferInstance
    exact Group.IsPerfect.not_isSolvable (J ⧸ aschbacherSolvableCore 3 J) inferInstance
  have hcatJ := hK.isCatalogGroup_of_surjective J hnJ
    (QuotientGroup.mk' (aschbacherSolvableCore 3 J)) (QuotientGroup.mk'_surjective _)
  have hcat : CFSG.Open.IsCatalogGroup K := CFSG.Open.isCatalogGroup_isoInvariant η.symm hcatJ
  have hrJ := pRank_thetaQuot_le_one_of_actual_sylow_of_simple_sections d hS hRank hx hJ hdiv hfac
  have hr : CFSG.pRank 3 K ≤ 1 := (CFSG.pRank_congr_of_mulEquiv η 3) ▸ hrJ
  have hθJ : ¬ 3 ∣ Nat.card (aschbacherSolvableCore 3 J) :=
    CFSG.RankThree.three_not_dvd_card_aschbacherSolvableCore
  have hdivK : 3 ∣ Nat.card K := by
    rw [← Nat.card_congr η.toEquiv]
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (aschbacherSolvableCore 3 J)] at hdiv
    exact (Nat.prime_three.dvd_mul.mp hdiv).resolve_right hθJ
  obtain ⟨P, hP, hAP⟩ := exists_abelian_sylow_theta_quotient_of_actual_sylow d hS hx
  have hcyc := isCyclic_autIn_of_abelian_sylow_of_pRank_le_one hInner Nat.prime_three (by norm_num) P hP
    (CFSG.RankThree.isComponent_map_of_mem_thetaComponents Nat.prime_three hJ) hcat hdivK hr
  have hle : autIn (A.map ρ) K ≤ autIn (P : Subgroup (C ⧸ θ)) K :=
    CFSG.RankThree.PartTwo.Sec4.Item422Proof.autIn_mono hAP
  have : IsCyclic (autIn (A.map ρ) K) :=
    isCyclic_of_injective (Subgroup.inclusion hle) (Subgroup.inclusion_injective hle)
  have heq := CFSG.RankThree.PartTwo.Sec4.Item422Proof.map_autThetaQuot_eq_autIn hJ η hη A
  have : IsCyclic (autThetaQuot A J) := by
    have hm : IsCyclic ((autThetaQuot A J).map (MulAut.congr η).toMonoidHom) := heq ▸ inferInstance
    exact isCyclic_of_injective
      ((MulAut.congr η).toMonoidHom.subgroupMap (autThetaQuot A J))
      (by intro a b hab; exact Subtype.ext ((MulAut.congr η).injective (congrArg Subtype.val hab)))
  exact CFSG.LocalAnalysis.RankThreeTheoremC.KFactProofs.T29.card_le_three_of_cyclic fun τ => by
    apply Subtype.ext
    change (τ : MulAut (J ⧸ aschbacherSolvableCore 3 J)) ^ 3 = 1
    obtain ⟨a, haN, haA, he⟩ := mem_autThetaQuot_iff.mp τ.2
    rw [← he, ← map_pow, ← map_pow]
    have ha3 : (⟨a, haN⟩ : normalizer (J : Set C)) ^ 3 = 1 :=
      Subtype.ext (Subtype.ext (d.isElemAbelian_AA.2 a haA))
    rw [ha3, map_one, map_one]

theorem autThetaQuot_card_le_three_of_mem_thetaComponentsAt_of_simple_sections
    (hInner : CFSG.LocalAnalysis.RankThreeTheoremC.KFactInnerAction)
    (d : SylowThreeData G) {x : G} (hS : CFSG.ABGLocalTools.IsSylowOf 3 d.S (centralizer ({x} : Set G)))
    (hRank : ∀ (T : Type) [Group T] [Finite T] [IsSimpleGroup T],
      3 ∣ Nat.card T → IsSec T d.M → CFSG.pRank 3 T ≤ 1)
    (hx : x ∈ d.AA)
    {L : Subgroup G} (hL : L ∈ CFSG.RankThree.thetaComponentsAt 3 x)
    (hK : CFSG.Open.IsKGroup (centralizer ({x} : Set G)))
    (hdiv : 3 ∣ Nat.card L)
    (hfac : centralizer ({x} : Set G) =
      (centralizer ({x} : Set G) ⊓ d.M) ⊔
        (CFSG.pPrimeCore 3 (centralizer ({x} : Set G))).map
          (centralizer ({x} : Set G)).subtype) :
    Nat.card (autThetaQuot d.AA L) ≤ 3 := by
  classical
  obtain ⟨J, hJ, rfl⟩ := hL
  have hdivJ : 3 ∣ Nat.card J := by
    rwa [Subgroup.card_map_of_injective (centralizer ({x} : Set G)).subtype_injective] at hdiv
  have hh := autThetaQuot_card_le_three_of_actual_sylow_of_simple_sections hInner d hS hRank hx hJ hK hdivJ hfac
  let C : Subgroup G := centralizer ({x} : Set G)
  have hAC : d.AA ≤ C := fun a ha => mem_centralizer_singleton_iff.mpr
    (d.S_commute a x (d.AA_le_S ha) (d.AA_le_S hx))
  have hAAmap : (d.AA.subgroupOf C).map C.subtype = d.AA := by
    rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hAC]
  have heq := CFSG.RankThree.PartTwo.Sec13.map_autThetaQuot_sub C (d.AA.subgroupOf C) J
  rw [hAAmap] at heq
  have hcard : Nat.card (autThetaQuot d.AA (J.map C.subtype)) =
      Nat.card (autThetaQuot (d.AA.subgroupOf C) J) := by
    rw [← heq]
    exact Subgroup.card_map_of_injective
      (MulAut.congr (CFSG.RankThree.PartTwo.Sec13.thetaQuotEquivSub C J)).injective
  exact hcard ▸ hh

theorem autThetaQuot_card_le_three_of_mem_thetaComponentsAt_of_dvd
    (hInner : CFSG.LocalAnalysis.RankThreeTheoremC.KFactInnerAction)
    (d : SylowThreeData G) {x : G} (hS : CFSG.ABGLocalTools.IsSylowOf 3 d.S (centralizer ({x} : Set G)))
