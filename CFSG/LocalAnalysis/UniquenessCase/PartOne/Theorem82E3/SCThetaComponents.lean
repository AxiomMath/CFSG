theorem noSzSection_mulAut_of_catalog_of_three_rank_one
    (S : Type) [Group S] [Finite S] [IsSimpleGroup S]
    (hnab : ∃ a b : S, a * b ≠ b * a) (hcat : CFSG.Open.IsCatalogGroup S)
    (hr : CFSG.pRank 3 S = 1) : NoSzSection (MulAut S) := by
  classical
  obtain ⟨i, ⟨e⟩⟩ := hcat
  have hr' : CFSG.Open.pRank 3 (⊤ : Subgroup S) = 1 := by
    rwa [← CFSG.SectionRank.pRank_eq_open_pRank_top]
  have htype := CFSG.RankThree.PartTwo.Sec18.isRankOneType189_of_index inferInstance hnab i e hr'
  rcases htype with ⟨p, f, hpf, hp3, hf, ⟨eS⟩⟩ | ⟨p, f, hpf, hf, hmod, ⟨eS⟩⟩ |
      ⟨p, f, hpf, hf, hmod, ⟨eS⟩⟩ | ⟨eS⟩
  · have : Fact p.Prime := hpf
    exact noSzSection_mulAut_of_mulEquiv (eS.trans (projSLEquivPSLn 2 (GaloisField p f)))
      (noSzSection_mulAut_pslTwo _)
  · have : Fact p.Prime := hpf
    exact noSzSection_mulAut_of_mulEquiv (eS.trans (projSLEquivProjectiveSL 3 (GaloisField p f)))
      (noSzSection_mulAut_projectiveSL_three _)
  · have : Fact p.Prime := hpf
    have hq : 2 < p ^ f := by
      have h2 : 2 ≤ p ^ f := le_trans (Fact.out : p.Prime).two_le (Nat.le_self_pow (by omega) _)
      omega
    let hU : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData p f (GaloisField p (2 * f)) :=
      (CFSG.RankThree.PartTwo.Sec13.piField_galoisField_two p f hf).unitary
    obtain ⟨eU⟩ := nonempty_unitaryPSU_mulEquiv_projSU hU
    exact noSzSection_mulAut_of_mulEquiv (eS.trans eU.symm)
      (noSzSection_mulAut_unitaryPSU_three hU hq)
  · obtain ⟨eS'⟩ := eS
    exact noSzSection_mulAut_of_mulEquiv eS' noSzSection_mulAut_J1

theorem noSzSection_mulAut_of_quasisimple_of_three_rank_one
    (K : Type) [Group K] [Finite K] (hQ : CFSG.IsQuasisimple K)
    (hK : CFSG.Open.IsKGroup K) (hr : CFSG.pRank 3 K = 1) : NoSzSection (MulAut K) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have : Group.IsPerfect K := hQ.1
  have : IsSimpleGroup (K ⧸ Subgroup.center K) := hQ.2.1
  have hZ : ¬ 3 ∣ Nat.card (Subgroup.center K) :=
    CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.not_dvd_card_center_of_pRank_eq_one
      (by norm_num) (by rwa [← CFSG.SectionRank.pRank_eq_open_pRank_top])
  have hrQ : CFSG.pRank 3 (K ⧸ Subgroup.center K) = 1 :=
    (CFSG.GroupTheory.PRankCoprimeQuotient.pRank_quotient_eq_of_not_dvd Nat.prime_three _ hZ).trans hr
  have hcat := hK.isCatalogGroup_of_surjective (⊤ : Subgroup K) hQ.2.2
    ((QuotientGroup.mk' (Subgroup.center K)).comp (⊤ : Subgroup K).subtype)
    (by intro q; obtain ⟨k, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center K) q; exact ⟨⟨k, trivial⟩, rfl⟩)
  have hNo := noSzSection_mulAut_of_catalog_of_three_rank_one _ hQ.2.2 hcat hrQ
  exact noSzSection_of_injective (CFSG.RankThree.mulAutQuotientHom (Subgroup.center K))
    CFSG.RankThree.PartTwo.Sec10.Sec10XProof.mulAutQuotientHom_center_injective hNo

theorem commutator_L_le_pCoreOf_of_perfect_three_prime_calC
    {G : Type} [Group G] [Finite G]
    (d : CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.SylowThreeData G)
    (hcalC : ∀ i, d.Lf i ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.calC d.M)
    (hLf : Function.Injective d.Lf) (hM3 : CFSG.Open.pRank 3 d.M ≤ 3)
    (hK : CFSG.Open.IsKGroup d.M)
    {X : Subgroup G} (hXM : X ≤ d.M) (hXperf : Group.IsPerfect X)
    (hX3 : ¬ 3 ∣ Nat.card X) : ⁅X, d.L⁆ ≤ CFSG.Open.pCoreOf 2 d.M := by
  have hPn := d.perfect_le_normalizer_Lf_of_three_calC hcalC hLf hM3 hXM hXperf
  let φ : (i : Fin 3) → X →* MulAut (CFSG.LocalAnalysis.UniquenessCase.UC22.Bar2 (d.Lf i)) :=
    fun i => CFSG.GroupTheory.conjModPCore 2 (d.Lf i) X (hPn i)
  have hXK : CFSG.IsKGroup X :=
    CFSG.LocalAnalysis.GLTheoremB.Prop95Parts.isKGroup_catalog_of_open (hK.of_le hXM)
  have hφ : ∀ i, φ i = 1 := by
    intro i
    have hq : CFSG.IsQuasisimple (CFSG.LocalAnalysis.UniquenessCase.UC22.Bar2 (d.Lf i)) := (CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_native _).mp
      ((CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_open _).mpr (hcalC i).2.2)
    have hr : CFSG.pRank 3 (CFSG.LocalAnalysis.UniquenessCase.UC22.Bar2 (d.Lf i)) = 1 := by
      rw [CFSG.GroupTheory.PRankCoprimeQuotient.pRank_quotient_eq_of_not_dvd Nat.prime_three
        (CFSG.pCore 2 (d.Lf i))
        (CFSG.GroupTheory.not_dvd_card_of_isPGroup
          (CFSG.pCore_isPGroup (p := 2) (G := d.Lf i)) Nat.prime_three (by norm_num)),
        CFSG.SectionRank.pRank_coe_eq_openPRank, d.hrank i]
    have hLK := (hK.of_le (d.hLM i)).quotient (CFSG.pCore 2 (d.Lf i))
    have hNo := noSzSection_mulAut_of_quasisimple_of_three_rank_one _ hq hLK hr
    exact hom_eq_one_of_perfect_three_prime_of_noSz hXK hXperf hX3 hNo (φ i)
  have hcommK : ∀ i, ⁅d.Lf i, X⁆ ≤ CFSG.Open.pCoreOf 2 (d.Lf i) := by
    intro i
    have hker : X ≤ (φ i).ker.map X.subtype := by
      rw [hφ i, MonoidHom.ker_one, Subgroup.map_top, Subgroup.range_subtype]
    exact (CFSG.GroupTheory.le_map_ker_conjModPCore_iff_commutator 2 (d.Lf i) X X
      (hPn i) le_rfl).mp hker
  have hcommR : ∀ i : Fin 3, ⁅d.Lf i, X⁆ ≤ CFSG.Open.pCoreOf 2 d.M := by
    intro i
    exact (hcommK i).trans
      (CFSG.Quasithin.pCoreOf_le_pCoreOf_of_isSubnormal (hcalC i).1)
  have hMR : d.M ≤ Subgroup.normalizer (CFSG.Open.pCoreOf 2 d.M : Set G) :=
    CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 d.M
  have hN0 : d.Lf 0 ≤ Subgroup.normalizer (CFSG.Open.pCoreOf 2 d.M : Set G) :=
    (d.hLM 0).trans hMR
  have hN1 : d.Lf 1 ≤ Subgroup.normalizer (CFSG.Open.pCoreOf 2 d.M : Set G) :=
    (d.hLM 1).trans hMR
  have hN2 : d.Lf 2 ≤ Subgroup.normalizer (CFSG.Open.pCoreOf 2 d.M : Set G) :=
    (d.hLM 2).trans hMR
  have h01 : ⁅d.Lf 0 ⊔ d.Lf 1, X⁆ ≤ CFSG.Open.pCoreOf 2 d.M :=
    CFSG.GorensteinWalter.commutator_sup_le_of_commutator_le_and_normalize
      (d.Lf 0) (d.Lf 1) X (CFSG.Open.pCoreOf 2 d.M)
      (hcommR 0) (hcommR 1) hN0 hN1
  have h012 : ⁅d.Lf 0 ⊔ d.Lf 1 ⊔ d.Lf 2, X⁆ ≤ CFSG.Open.pCoreOf 2 d.M :=
    CFSG.GorensteinWalter.commutator_sup_le_of_commutator_le_and_normalize
      (d.Lf 0 ⊔ d.Lf 1) (d.Lf 2) X (CFSG.Open.pCoreOf 2 d.M)
      h01 (hcommR 2) (sup_le hN0 hN1) hN2
  rw [Subgroup.commutator_comm]
  rw [d.hL]
  exact h012

theorem le_normalizer_theta_component_of_three_prime_of_le_M
    {G : Type} [Group G] [Finite G]
    (d : CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.SylowThreeData G)
    (hcalC : ∀ i, d.Lf i ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.calC d.M)
    (hLf : Function.Injective d.Lf) (hM3 : CFSG.Open.pRank 3 d.M ≤ 3)
    (hK : CFSG.Open.IsKGroup d.M)
    {x : G} (hx : x ∈ d.AA) {L : Subgroup G}
    (hL : L ∈ CFSG.RankThree.thetaComponentsAt 3 x)
    (hL3 : ¬ 3 ∣ Nat.card L) (hLM : L ≤ d.M) :
    d.AA ≤ Subgroup.normalizer (L : Set G) := by
  classical
  let C : Subgroup G := Subgroup.centralizer ({x} : Set G)
  let Y : Subgroup G := C ⊓ d.M
  let R : Subgroup G := CFSG.Open.pCoreOf 2 d.M ⊓ C
  have hLC : L ≤ C := by
    obtain ⟨J, hJ, he⟩ := hL
    rw [← he]
    exact Subgroup.map_subtype_le _
  have hLY : L ≤ Y := le_inf hLC hLM
  have hAC : d.AA ≤ C := fun a ha => Subgroup.mem_centralizer_singleton_iff.mpr
    (d.S_commute a x (d.AA_le_S ha) (d.AA_le_S hx))
  have hLsub : L.subgroupOf C ∈ CFSG.RankThree.thetaComponents 3 C := by
    obtain ⟨J, hJ, he⟩ := hL
    rw [← he, Subgroup.subgroupOf, Subgroup.comap_map_eq_self_of_injective C.subtype_injective]
    exact hJ
  have hJY : L.subgroupOf Y ∈ CFSG.RankThree.thetaComponents 3 Y :=
    CFSG.RankThree.PartOne.subgroupOf_mem_thetaComponents_of_le Nat.prime_three hLY inf_le_left hLsub
  have : Group.IsPerfect (L.subgroupOf Y) := hJY.1
  have : Group.IsPerfect L := Group.IsPerfect.ofSurjective
    (f := (Subgroup.subgroupOfEquivOfLe hLY).toMonoidHom) (Subgroup.subgroupOfEquivOfLe hLY).surjective
  have hcommL := commutator_L_le_pCoreOf_of_perfect_three_prime_calC
    d hcalC hLf hM3 hK hLM inferInstance hL3
  have hAL : ⁅L, d.AA⁆ ≤ CFSG.Open.pCoreOf 2 d.M :=
    (Subgroup.commutator_mono le_rfl d.AA_le_L).trans hcommL
  have hALC : ⁅L, d.AA⁆ ≤ C :=
    (Subgroup.commutator_mono hLC hAC).trans
      (Subgroup.commutator_le.mpr fun a ha b hb => C.mul_mem (C.mul_mem (C.mul_mem ha hb) (C.inv_mem ha)) (C.inv_mem hb))
  have hALR : ⁅L, d.AA⁆ ≤ R := le_inf hAL hALC
  have hR2 : IsPGroup 2 R := (CFSG.pCore_isPGroup (p := 2) (G := d.M)).map d.M.subtype |>.to_le inf_le_left
  have hYN : Y ≤ Subgroup.normalizer (R : Set G) := fun c hc =>
    Subgroup.inf_normalizer_le_normalizer_inf
      ⟨CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 d.M hc.2, Subgroup.le_normalizer hc.1⟩
  have hRY : R ≤ Y := le_inf inf_le_right (inf_le_left.trans (Subgroup.map_subtype_le _))
  have hsol : Group.IsSolvable R := by
    have : Group.IsNilpotent R := hR2.isNilpotent
    infer_instance
  have h3 : ¬ 3 ∣ Nat.card R := CFSG.GroupTheory.not_dvd_card_of_isPGroup hR2 Nat.prime_three (by norm_num)
  have hθRY : R ≤ CFSG.inSubgroup (CFSG.RankThree.LocalRank.aschbacherSolvableCore 3) Y :=
    CFSG.RankThree.PartTwo.Sec6.le_theta_of_normal hRY hYN hsol h3
  have hAY : d.AA ≤ Y := le_inf hAC (d.AA_le_S.trans d.hS.le |>.trans (by
    rw [d.hL]; exact sup_le (sup_le (d.hLM 0) (d.hLM 1)) (d.hLM 2)))
  let ρ := QuotientGroup.mk' (CFSG.RankThree.LocalRank.aschbacherSolvableCore 3 Y)
  have hmap : ⁅(L.subgroupOf Y).map ρ, (d.AA.subgroupOf Y).map ρ⁆ = ⊥ := by
    rw [← Subgroup.map_commutator, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
    intro t ht
    have h : (t : G) ∈ ⁅L, d.AA⁆ := by
      have hm : ⁅L.subgroupOf Y, d.AA.subgroupOf Y⁆.map Y.subtype ≤ ⁅L, d.AA⁆ := by
        rw [Subgroup.map_commutator]
        exact Subgroup.commutator_mono
          (by rw [Subgroup.subgroupOf_map_subtype]; exact inf_le_left)
          (by rw [Subgroup.subgroupOf_map_subtype]; exact inf_le_left)
      exact hm (Subgroup.mem_map_of_mem _ ht)
    have hθ := hθRY (hALR h)
    obtain ⟨v, hv, hvEq⟩ := hθ
    exact (Subtype.ext hvEq : v = t) ▸ hv
  have hN := (Subgroup.commutator_eq_bot_iff_le_centralizer.mp
    (Subgroup.commutator_comm _ _ |>.trans hmap)).trans
    (Subgroup.centralizer_le_normalizer _)
  have hn : d.AA.subgroupOf Y ≤ Subgroup.normalizer ((L.subgroupOf Y : Subgroup Y) : Set Y) := by
    exact ((CFSG.RankThree.theta_component_quotient_structure Nat.prime_three hJY).2.2.2.2.2.2.2.2.2.2
      (d.AA.subgroupOf Y)).mpr hN
  have h := CFSG.LocalAnalysis.GLTheoremA.I113.le_normalizer_map_subtype hAY hn
  rwa [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hLY] at h

theorem commutator_AA_le_pCoreOf_of_perfect_three_prime_calC
    {G : Type} [Group G] [Finite G]
    (d : CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.SylowThreeData G)
    (hcalC : ∀ i, d.Lf i ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.calC d.M)
    (hLf : Function.Injective d.Lf) (hM3 : CFSG.Open.pRank 3 d.M ≤ 3)
    (hK : CFSG.Open.IsKGroup d.M)
    {Y : Subgroup G} (hYM : Y ≤ d.M) (hYperf : Group.IsPerfect Y)
    (hY3 : ¬ 3 ∣ Nat.card Y) (hAY : d.AA ≤ normalizer (Y : Set G)) :
    ⁅Y, d.AA⁆ ≤ CFSG.Open.pCoreOf 2 Y := by
  have hcomm := commutator_L_le_pCoreOf_of_perfect_three_prime_calC
    d hcalC hLf hM3 hK hYM hYperf hY3
  exact (le_inf ((Subgroup.le_normalizer_iff_commutator_le_left).mp hAY)
    ((Subgroup.commutator_mono le_rfl d.AA_le_L).trans hcomm)).trans
    (CFSG.GroupTheory.inf_pCoreOf_le_pCoreOf 2 hYM)

theorem commutator_map_eq_bot_of_perfect_three_prime_calC
    {G : Type} [Group G] [Finite G]
    (d : CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.SylowThreeData G)
    (hcalC : ∀ i, d.Lf i ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.calC d.M)
    (hLf : Function.Injective d.Lf) (hM3 : CFSG.Open.pRank 3 d.M ≤ 3)
    (hK : CFSG.Open.IsKGroup d.M)
    {C Y : Subgroup G} (hYM : Y ≤ d.M) (hYperf : Group.IsPerfect Y)
    (hY3 : ¬ 3 ∣ Nat.card Y) (hAY : d.AA ≤ normalizer (Y : Set G))
    (hYC : Y ≤ C) (hAC : d.AA ≤ C)
    {Q : Type} [Group Q] [Finite Q] (ρ : C →* Q)
    (hQ : CFSG.pCore 2 ((Y.subgroupOf C).map ρ) = ⊥) :
    ⁅(Y.subgroupOf C).map ρ, (d.AA.subgroupOf C).map ρ⁆ = ⊥ := by
  have hcore := commutator_AA_le_pCoreOf_of_perfect_three_prime_calC
    d hcalC hLf hM3 hK hYM hYperf hY3 hAY
  have hcoreC : ⁅Y.subgroupOf C, d.AA.subgroupOf C⁆ ≤
      CFSG.Open.pCoreOf 2 (Y.subgroupOf C) := by
    rw [CFSG.GroupTheory.pCoreOf_subgroupOf 2 hYC]
    intro t ht
    have hm : ⁅Y.subgroupOf C, d.AA.subgroupOf C⁆.map C.subtype = ⁅Y, d.AA⁆ := by
      rw [Subgroup.map_commutator, Subgroup.subgroupOf_map_subtype,
        Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hYC, inf_eq_left.mpr hAC]
    exact hcore (hm ▸ Subgroup.mem_map_of_mem C.subtype ht)
  have hmap : (CFSG.Open.pCoreOf 2 (Y.subgroupOf C)).map ρ = ⊥ := by
    let f := ρ.subgroupMap (Y.subgroupOf C)
    have hf := CFSG.LieType.BorelTits.map_pCore_le 2 f
      (ρ.subgroupMap_surjective (Y.subgroupOf C))
    rw [hQ] at hf
    apply (Subgroup.map_eq_bot_iff (CFSG.Open.pCoreOf 2 (Y.subgroupOf C))).mpr
    rintro t ⟨u, hu, rfl⟩
    have h := le_bot_iff.mp hf
    have hu' : f u ∈ (⊥ : Subgroup ((Y.subgroupOf C).map ρ)) :=
      h ▸ Subgroup.mem_map_of_mem f hu
    exact MonoidHom.mem_ker.mpr (congrArg Subtype.val (Subgroup.mem_bot.mp hu'))
  apply le_bot_iff.mp
  rw [← Subgroup.map_commutator, ← hmap]
  exact Subgroup.map_mono hcoreC

theorem fixed_image_le_centralizer_AA_of_axis
    {G : Type} [Group G] [Finite G]
    (d : CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.SylowThreeData G)
    (hcalC : ∀ i, d.Lf i ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.calC d.M)
    (hLf : Function.Injective d.Lf) (hM3 : CFSG.Open.pRank 3 d.M ≤ 3)
    (hK : CFSG.Open.IsKGroup d.M)
    {C X D : Subgroup G} (hXC : X ≤ C) (hAC : d.AA ≤ C)
    (hX3 : ¬ 3 ∣ Nat.card X) (hAX : d.AA ≤ normalizer (X : Set G)) (hDA : D ≤ d.AA)
    {i : Fin 3} (hAiD : d.A i ≤ D) (hAiM : centralizer (d.A i : Set G) ≤ d.M)
    {Q : Type} [Group Q] [Finite Q] (ρ : C →* Q)
    (hTp : Group.IsPerfect ↥((X.subgroupOf C).map ρ ⊓
      centralizer (((D.subgroupOf C).map ρ : Subgroup Q) : Set Q)))
    (hT2 : CFSG.pCore 2 ↥((X.subgroupOf C).map ρ ⊓
      centralizer (((D.subgroupOf C).map ρ : Subgroup Q) : Set Q)) = ⊥) :
    (X.subgroupOf C).map ρ ⊓ centralizer (((D.subgroupOf C).map ρ : Subgroup Q) : Set Q) ≤
      centralizer (((d.AA.subgroupOf C).map ρ : Subgroup Q) : Set Q) := by
  classical
  let U := X ⊓ centralizer (D : Set G)
  let Y := CFSG.Quasithin.perfectCore U
  let T := (X.subgroupOf C).map ρ ⊓ centralizer (((D.subgroupOf C).map ρ : Subgroup Q) : Set Q)
  have hDC : D ≤ C := hDA.trans hAC
  have hUC : U ≤ C := inf_le_left.trans hXC
  have hYC : Y ≤ C := (CFSG.Quasithin.perfectCore_le _).trans hUC
  have hYX : Y ≤ X := (CFSG.Quasithin.perfectCore_le _).trans inf_le_left
  have hYM : Y ≤ d.M := (CFSG.Quasithin.perfectCore_le _).trans
    (inf_le_right.trans ((Subgroup.centralizer_le hAiD).trans hAiM))
  have hAAcD : d.AA ≤ centralizer (D : Set G) := by
    intro a ha x hx
    exact d.S_commute x a (d.AA_le_S (hDA hx)) (d.AA_le_S ha)
  have hAN : d.AA ≤ normalizer (U : Set G) := fun a ha =>
    Subgroup.inf_normalizer_le_normalizer_inf ⟨hAX ha, Subgroup.le_normalizer (hAAcD ha)⟩
  have hAY : d.AA ≤ normalizer (Y : Set G) :=
    hAN.trans (CFSG.Quasithin.normalizer_le_normalizer_perfectCore _)
  have hD : CFSG.Open.IsElemAbelian 3 (D.subgroupOf C) := by
    refine ⟨⟨⟨fun a b => Subtype.ext (Subtype.ext ?_)⟩⟩, fun a ha => Subtype.ext ?_⟩
    · exact d.S_commute a b (d.AA_le_S (hDA a.2)) (d.AA_le_S (hDA b.2))
    · exact d.isElemAbelian_AA.2 a (hDA ha)
  have hDX : D.subgroupOf C ≤ normalizer ((X.subgroupOf C : Subgroup C) : Set C) := by
    intro a ha
    rw [Subgroup.mem_normalizer_iff]
    intro x
    exact (Subgroup.mem_normalizer_iff.mp (hAX (hDA ha)) (x : G))
  have h3XC : ¬ 3 ∣ Nat.card (X.subgroupOf C) := by
    rwa [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hXC).toEquiv]
  have hU : (X.subgroupOf C) ⊓ centralizer (D.subgroupOf C : Set C) = U.subgroupOf C := by
    ext x
    change ((x : G) ∈ X ∧ x ∈ centralizer (D.subgroupOf C : Set C)) ↔
      ((x : G) ∈ X ∧ (x : G) ∈ centralizer (D : Set G))
    refine and_congr_right fun hx => ?_
    rw [Subgroup.mem_centralizer_iff, Subgroup.mem_centralizer_iff]
    constructor
    · intro h a ha
      exact congrArg Subtype.val (h ⟨a, hDC ha⟩ ha)
    · intro h a ha
      exact Subtype.ext (h a ha)
  have hmapU : (U.subgroupOf C).map ρ = T := by
    rw [← hU]
    exact CFSG.SignalizerFunctor.Helpers.coprime_centralizer_image_elementary
      3 Nat.prime_three ρ _ _ hD hDX ((Nat.prime_three.coprime_iff_not_dvd).mpr h3XC)
  have hpc : CFSG.Quasithin.perfectCore (U.subgroupOf C) = Y.subgroupOf C := by
    apply Subgroup.map_injective C.subtype_injective
    rw [CFSG.Quasithin.map_perfectCore, Subgroup.subgroupOf_map_subtype,
      inf_eq_left.mpr hUC, Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hYC]
  have hYT : (Y.subgroupOf C).map ρ = T := by
    rw [← hpc, CFSG.Quasithin.map_perfectCore, hmapU]
    exact CFSG.Quasithin.perfectCore_eq_self_of_perfect (Subgroup.isPerfect_iff.mp hTp)
  have hYp : Group.IsPerfect Y := Subgroup.isPerfect_iff.mpr (CFSG.Quasithin.perfectCore_perfect _)
  have hcomm := commutator_map_eq_bot_of_perfect_three_prime_calC d hcalC hLf hM3 hK
    hYM hYp (fun h => hX3 (h.trans (Subgroup.card_dvd_of_le hYX))) hAY hYC hAC ρ
    (hYT.symm ▸ hT2)
  rw [hYT] at hcomm
  exact Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcomm

theorem cyclic_component_orbit_action_of_three_prime
    {G : Type} [Group G] [Finite G]
    (d : CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.SylowThreeData G)
    (hcalC : ∀ i, d.Lf i ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.calC d.M)
    (hLf : Function.Injective d.Lf) (hM3 : CFSG.Open.pRank 3 d.M ≤ 3)
    (hK : CFSG.Open.IsKGroup d.M) (hAxis : ∀ i, centralizer (d.A i : Set G) ≤ d.M)
    {x : G} (hx : x ∈ d.AA)
    {J : Subgroup (centralizer ({x} : Set G) ⧸ aschbacherSolvableCore 3 (centralizer ({x} : Set G)))}
    (hJ : CFSG.IsComponent J) (hJ3 : ¬ 3 ∣ Nat.card J)
    (hmove : ¬ (d.AA.subgroupOf (centralizer ({x} : Set G))).map
      (QuotientGroup.mk' (aschbacherSolvableCore 3 (centralizer ({x} : Set G)))) ≤
        normalizer (J : Set (centralizer ({x} : Set G) ⧸
          aschbacherSolvableCore 3 (centralizer ({x} : Set G))))) :
    let C := centralizer ({x} : Set G)
    let ρ := QuotientGroup.mk' (aschbacherSolvableCore 3 C)
    let A := (d.AA.subgroupOf C).map ρ
    let K := CFSG.SignalizerFunctorTheorem.McBride.orbitClosure J A
    ∃ i : Fin 3, ∃ a : C, (a : G) ∈ d.A i ∧
      A ≤ centralizer (K : Set (C ⧸ aschbacherSolvableCore 3 C)) ⊔ zpowers (ρ a) := by
  classical
  let C := centralizer ({x} : Set G)
  let θ := aschbacherSolvableCore 3 C
  let ρ := QuotientGroup.mk' θ
  let A := (d.AA.subgroupOf C).map ρ
  have hAC : d.AA ≤ C := fun a ha => Subgroup.mem_centralizer_singleton_iff.mpr
    (d.S_commute a x (d.AA_le_S ha) (d.AA_le_S hx))
  have hAe : CFSG.Open.IsElemAbelian 3 A := by
    refine ⟨⟨⟨fun a b => Subtype.ext ?_⟩⟩, ?_⟩
    · obtain ⟨u, hu, heu⟩ := a.2
      obtain ⟨v, hv, hev⟩ := b.2
      change (a : C ⧸ θ) * (b : C ⧸ θ) = (b : C ⧸ θ) * (a : C ⧸ θ)
      rw [← heu, ← hev]
      exact congrArg ρ (Subtype.ext (d.S_commute u v (d.AA_le_S hu) (d.AA_le_S hv)))
    · intro a ha
      obtain ⟨u, hu, rfl⟩ := ha
      rw [← map_pow]
      have hu3 : u ^ 3 = 1 := Subtype.ext (d.isElemAbelian_AA.2 u hu)
      rw [hu3, map_one]
  have hcenter : center J = ⊥ :=
    CFSG.RankThree.PartTwo.Sec11.component_center_bot_of_prime_three
      (CFSG.RankThree.theta_quotient_core_and_ranks (G := C)).1 hJ hJ3
  have hsJ : IsSimpleGroup J :=
    (CFSG.RankThree.ThetaFree.isSimpleGroup_of_center_eq_bot hJ hcenter).1
  have hJn : ¬ IsMulCommutative J := by
    have : Group.IsPerfect J := hJ.1.1
    have : Nontrivial J := CFSG.LocalCores.isQuasisimple_nontrivial hJ.1
    intro hn
    have : IsMulCommutative J := hn
    exact Group.IsPerfect.not_isSolvable J inferInstance
  have hjl : J ∈ CFSG.SignalizerFunctorTheorem.McBride.lcal (⊤ : Subgroup (C ⧸ θ)) :=
    CFSG.SignalizerFunctorTheorem.McBride.mem_lcal_iff.mpr
      ⟨le_top, hJ.2.subgroupOf, hsJ, hJn⟩
  let K := CFSG.SignalizerFunctorTheorem.McBride.orbitClosure J A
  have hAtop : A ≤ normalizer ((⊤ : Subgroup (C ⧸ θ)) : Set (C ⧸ θ)) := by
    rw [Subgroup.normalizer_eq_top]
    exact le_top
  have hd := (CFSG.SignalizerFunctorTheorem.McBride.Near.Lemma27.diagSetting_orbitClosure
    Nat.prime_three hAe hAtop hjl).1
  let N := A ⊓ normalizer (J : Set (C ⧸ θ))
  have hjK : J ∈ CFSG.SignalizerFunctorTheorem.McBride.lcal K :=
    (CFSG.SignalizerFunctorTheorem.McBride.Near.Lemma27.diagSetting_orbitClosure
      Nat.prime_three hAe hAtop hjl).2.symm ▸
        CFSG.SignalizerFunctorTheorem.McBride.Nonsolv.L514.self_mem_conjOrbit A J
  have hN : ∀ L ∈ CFSG.SignalizerFunctorTheorem.McBride.lcal K,
      N = A ⊓ normalizer (L : Set (C ⧸ θ)) := fun L hL =>
    CFSG.SignalizerFunctorTheorem.McBride.Near.Lemma27.stabilizer_eq hd hjK hL
  have hAiAA : ∀ i : Fin 3, d.A i ≤ d.AA := by
    intro i
    rw [d.AA_def]
    fin_cases i
    · exact le_sup_left.trans le_sup_left
    · exact le_sup_right.trans le_sup_left
    · exact le_sup_right
  have hAi : ∃ i : Fin 3, ∃ a : C, (a : G) ∈ d.A i ∧ ρ a ∉ N := by
    by_contra h
    push Not at h
    apply hmove
    have hnormal : d.AA ≤ ((normalizer (J : Set (C ⧸ θ))).comap ρ).map C.subtype := by
      rw [d.AA_def]
      apply sup_le (sup_le ?_ ?_) ?_
      all_goals
        intro a ha
        exact ⟨⟨a, hAC (hAiAA _ ha)⟩, (h _ ⟨a, hAC (hAiAA _ ha)⟩ ha).2, rfl⟩
    intro a ha
    obtain ⟨u, hu, rfl⟩ := ha
    obtain ⟨v, hv, he⟩ := hnormal hu
    have he' : v = u := Subtype.ext he
    exact he' ▸ hv
  obtain ⟨i, ac, hai, han⟩ := hAi
  let a : G := ac
  have haiAA : a ∈ d.AA := hAiAA i hai
  let b : C ⧸ θ := ρ ac
  have hbA : b ∈ A := Subgroup.mem_map_of_mem ρ haiAA
  have hbN : b ∉ N := han
  have hKb : Group.IsPerfect ↥(K ⊓ centralizer ({b} : Set (C ⧸ θ))) := by
    have hdb := (CFSG.SignalizerFunctorTheorem.McBride.Near.Lemma27.diagSetting_centralizer
      hd hN hbA hbN).1
    exact isPerfect_of_direct_simple hdb.direct (fun L hL =>
      let h := CFSG.SignalizerFunctorTheorem.McBride.mem_lcal_iff.mp hL; ⟨h.2.2.1, h.2.2.2⟩)
  have hKb2 : CFSG.pCore 2 ↥(K ⊓ centralizer ({b} : Set (C ⧸ θ))) = ⊥ := by
    have hdb := (CFSG.SignalizerFunctorTheorem.McBride.Near.Lemma27.diagSetting_centralizer
      hd hN hbA hbN).1
    exact pCore_two_eq_bot_of_direct_simple hdb.direct (fun L hL =>
      let h := CFSG.SignalizerFunctorTheorem.McBride.mem_lcal_iff.mp hL; ⟨h.2.2.1, h.2.2.2⟩)
  let X : Subgroup G := (K.comap ρ).map C.subtype
  have hXC : X ≤ C := Subgroup.map_subtype_le _
  have hsubX : X.subgroupOf C = K.comap ρ := Subgroup.comap_map_eq_self_of_injective C.subtype_injective _
  have hXmap : (X.subgroupOf C).map ρ = K := by
    rw [hsubX, Subgroup.map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective θ)]
  have hK3 : ¬ 3 ∣ Nat.card K := by
    have hN3 : K ≤ CFSG.pPrimeCore 3 (C ⧸ θ) := by
      change CFSG.SignalizerFunctorTheorem.McBride.orbitClosure J A ≤ _
      rw [CFSG.SignalizerFunctorTheorem.McBride.Nonsolv.L514.orbitClosure_eq_sSup]
      apply sSup_le
      intro L hL
      obtain ⟨g, hg, rfl⟩ := hL
      have hs := (CFSG.LocalCores.isComponent_map_mulEquiv (MulAut.conj g) hJ).2
      exact CFSG.LocalAnalysis.RankThreeTheoremC.thc_le_pPrimeCore hs
        ((Nat.prime_three.coprime_iff_not_dvd).mpr (by
          rwa [Subgroup.card_map_of_injective (MulAut.conj g).injective]))
    exact fun h => (Nat.prime_three.coprime_iff_not_dvd.mp
      (CFSG.coprime_card_pPrimeCore 3 (C ⧸ θ))) (h.trans (Subgroup.card_dvd_of_le hN3))
  have hX3 : ¬ 3 ∣ Nat.card X := by
    rw [Subgroup.card_map_of_injective C.subtype_injective,
      CFSG.GroupTheory.card_comap_eq_card_ker_mul_card ρ (QuotientGroup.mk'_surjective θ),
      QuotientGroup.ker_mk']
    exact fun h => (Nat.prime_three.dvd_mul.mp h).elim
      CFSG.RankThree.three_not_dvd_card_aschbacherSolvableCore hK3
  have hAX : d.AA ≤ normalizer (X : Set G) := by
    apply CFSG.LocalAnalysis.GLTheoremA.I113.le_normalizer_map_subtype hAC
    intro c hc
    exact Subgroup.le_normalizer_comap ρ (hd.normalizes (Subgroup.mem_map_of_mem ρ hc))
  have ha1 : a ≠ 1 := by
    intro ha1
    have hac1 : ac = 1 := Subtype.ext ha1
    have hb1 : b = 1 := by simp only [b, hac1, map_one]
    exact hbN (hb1.symm ▸ ⟨A.one_mem, (normalizer _).one_mem⟩)
  have hDmap : ((d.A i).subgroupOf C).map ρ = zpowers b := by
    have hp : d.A i = zpowers a :=
      (Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hai) (by
        rw [d.card_A i, Nat.card_zpowers,
          orderOf_eq_prime (d.isElemAbelian_AA.2 a haiAA) ha1])).symm
    have hdC : (d.A i).subgroupOf C = zpowers ac := by
      apply Subgroup.map_injective C.subtype_injective
      rw [Subgroup.subgroupOf_map_subtype,
        inf_eq_left.mpr ((hAiAA i).trans hAC), MonoidHom.map_zpowers]
      exact hp
    rw [hdC, MonoidHom.map_zpowers]
  have hfix : K ⊓ centralizer ({b} : Set (C ⧸ θ)) ≤ centralizer (A : Set (C ⧸ θ)) := by
    have h := fixed_image_le_centralizer_AA_of_axis d hcalC hLf hM3 hK hXC hAC hX3 hAX
      (hAiAA i) le_rfl
      (hAxis i) ρ (by
        rw [hXmap, hDmap, Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
        exact hKb) (by
        rw [hXmap, hDmap, Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
        exact hKb2)
    change (X.subgroupOf C).map ρ ⊓ centralizer (((d.A i).subgroupOf C).map ρ : Set (C ⧸ θ)) ≤
      centralizer (A : Set (C ⧸ θ)) at h
    rwa [hXmap, hDmap, Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure] at h
  refine ⟨i, ac, hai, ?_⟩
  change A ≤ centralizer (K : Set (C ⧸ θ)) ⊔ zpowers b
  intro c hc
  have h := CFSG.SignalizerFunctorTheorem.McBride.Near.Lemma27.mem_sup_of_centralizer_le
    hd hN hbA hc hbN (fun y hy => Subgroup.mem_centralizer_singleton_iff.mpr
      (Subgroup.mem_centralizer_iff.mp (hfix hy) c hc).symm)
  exact (sup_le (inf_le_right.trans le_sup_left) le_sup_right :
    (A ⊓ centralizer (K : Set (C ⧸ θ))) ⊔ zpowers b ≤
      centralizer (K : Set (C ⧸ θ)) ⊔ zpowers b) h

theorem le_normalizer_component_of_dvd_of_actual_data
    {G : Type} [Group G] [Finite G]
    (d : CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.SylowThreeData G)
    (hcalC : ∀ i, d.Lf i ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.calC d.M)
    (hLf : Function.Injective d.Lf) (hM3 : CFSG.Open.pRank 3 d.M ≤ 3)
    (hK : CFSG.Open.IsKGroup d.M) (hAxis : ∀ i, centralizer (d.A i : Set G) ≤ d.M)
    {x : G} (hx : x ∈ d.AA)
    {J : Subgroup (centralizer ({x} : Set G) ⧸ aschbacherSolvableCore 3 (centralizer ({x} : Set G)))}
    (hJ : CFSG.IsComponent J) (hJ3 : ¬ 3 ∣ Nat.card J)
    {p : ℕ} (hp : p.Prime) (hpJ : p ∣ Nat.card J)
    (hdelta : ¬ p ∣ Nat.card ↥(d.M ⊓ centralizer (d.AA : Set G))) :
    (d.AA.subgroupOf (centralizer ({x} : Set G))).map
      (QuotientGroup.mk' (aschbacherSolvableCore 3 (centralizer ({x} : Set G)))) ≤
        normalizer (J : Set (centralizer ({x} : Set G) ⧸
          aschbacherSolvableCore 3 (centralizer ({x} : Set G)))) := by
  by_contra hm
  have hc := cyclic_component_orbit_action_of_three_prime d hcalC hLf hM3 hK hAxis hx hJ hJ3 hm
  exact hdelta (dvd_card_centralizer_AA_of_cyclic_component_orbit d hx hAxis hJ hJ3 hm hc hp hpJ)

theorem le_normalizer_component_of_five_prime_actual_data
    {G : Type} [Group G] [Finite G]
    (hSz : CFSG.RankThree.PartTwo.KFacts.KPSz)
    (d : CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.SylowThreeData G)
    (hcalC : ∀ i, d.Lf i ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.calC d.M)
    (hLf : Function.Injective d.Lf) (hM3 : CFSG.Open.pRank 3 d.M ≤ 3)
    (hK : CFSG.Open.IsKGroup d.M) (hAxis : ∀ i, centralizer (d.A i : Set G) ≤ d.M)
    {x : G} (hx : x ∈ d.AA)
    (hC : CFSG.Open.IsKGroup (centralizer ({x} : Set G)))
    {J : Subgroup (centralizer ({x} : Set G) ⧸ aschbacherSolvableCore 3 (centralizer ({x} : Set G)))}
    (hJ : CFSG.IsComponent J) (hJ3 : ¬ 3 ∣ Nat.card J)
    (hdelta : ¬ 5 ∣ Nat.card ↥(d.M ⊓ centralizer (d.AA : Set G))) :
    (d.AA.subgroupOf (centralizer ({x} : Set G))).map
      (QuotientGroup.mk' (aschbacherSolvableCore 3 (centralizer ({x} : Set G)))) ≤
        normalizer (J : Set (centralizer ({x} : Set G) ⧸
          aschbacherSolvableCore 3 (centralizer ({x} : Set G)))) := by
  let C := centralizer ({x} : Set G)
  let θ := aschbacherSolvableCore 3 C
  let ρ := QuotientGroup.mk' θ
  have hsJ : IsSimpleGroup J :=
    (CFSG.RankThree.ThetaFree.isSimpleGroup_of_center_eq_bot hJ
      (CFSG.RankThree.PartTwo.Sec11.component_center_bot_of_prime_three
        (CFSG.RankThree.theta_quotient_core_and_ranks (G := C)).1 hJ hJ3)).1
  have hnJ : ∃ a b : J, a * b ≠ b * a := by
    have : Nontrivial J := CFSG.LocalCores.isQuasisimple_nontrivial hJ.1
    have : Group.IsPerfect J := hJ.1.1
    by_contra hn
    push Not at hn
    have : IsMulCommutative J := ⟨⟨hn⟩⟩
    exact Group.IsPerfect.not_isSolvable J inferInstance
  have : IsSimpleGroup J := hsJ
  have hcat := (hC.quotient θ).isCatalogGroup_of_surjective J hnJ (MonoidHom.id J) Function.surjective_id
  obtain ⟨f, hf⟩ := hSz J hnJ hcat hJ3
  have h5 := CFSG.RankThree.PartTwo.Sec16.KSL3PiNoSzProof.five_dvd_card_of_suzukiModel hf
  exact le_normalizer_component_of_dvd_of_actual_data d hcalC hLf hM3 hK hAxis hx hJ hJ3
    (by norm_num) h5 hdelta

theorem le_pPrimeCore_of_perfect_commutator_eq_of_factorization
    {G : Type} [Group G] [Finite G] (d : SylowThreeData G)
    (hcal : ∀ i, d.Lf i ∈ calC d.M) (hinj : Function.Injective d.Lf)
    (hM3 : CFSG.Open.pRank 3 d.M ≤ 3) (hM : CFSG.Open.IsKGroup d.M)
    {C Y : Subgroup G} (hAC : d.AA ≤ C) (hYC : Y ≤ C) (hY : Group.IsPerfect Y)
    (hY3 : ¬ 3 ∣ Nat.card Y) (hAY : d.AA ≤ normalizer (Y : Set G))
    (hgen : ⁅Y, d.AA⁆ = Y)
    (hfactor : C = (C ⊓ d.M) ⊔ (CFSG.pPrimeCore 3 C).map C.subtype) :
    Y ≤ (CFSG.pPrimeCore 3 C).map C.subtype := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let N : Subgroup G := (CFSG.pPrimeCore 3 C).map C.subtype
  let ρ := QuotientGroup.mk' (CFSG.pPrimeCore 3 C)
  let V : Subgroup G := Y ⊔ N
  let Z : Subgroup G := V ⊓ d.M
  let T := (Y.subgroupOf C).map ρ
  have hNC : N ≤ C := Subgroup.map_subtype_le _
  have hNN : C ≤ normalizer (N : Set G) := by
    intro x hx
    have hn : (⟨x, hx⟩ : C) ∈ normalizer (CFSG.pPrimeCore 3 C : Set C) := by
      have hnEq : normalizer (CFSG.pPrimeCore 3 C : Set C) = ⊤ :=
        Subgroup.normalizer_eq_top_iff.mpr (CFSG.pPrimeCore_normal (p := 3) (G := C))
      rw [hnEq]
      exact Subgroup.mem_top _
    exact Subgroup.le_normalizer_map C.subtype (Subgroup.mem_map_of_mem C.subtype hn)
  have hN3 : ¬ 3 ∣ Nat.card N := by
    rw [Subgroup.card_map_of_injective C.subtype_injective]
    exact (Nat.prime_three.coprime_iff_not_dvd).mp (CFSG.coprime_card_pPrimeCore 3 C)
  have hV3 : ¬ 3 ∣ Nat.card V := by
    have h := CFSG.LocalAnalysis.RankThreeUC.coprime_card_sup_of_le_normalizer
      (hYC.trans hNN) ((Nat.prime_three.coprime_iff_not_dvd).mpr hN3)
      ((Nat.prime_three.coprime_iff_not_dvd).mpr hY3)
    rw [sup_comm] at h
    exact (Nat.prime_three.coprime_iff_not_dvd).mp h
  have hVC : V ≤ C := sup_le hYC hNC
  have hZC : Z ≤ C := inf_le_left.trans hVC
  have hAN : d.AA ≤ normalizer (N : Set G) := hAC.trans hNN
  have hAV : d.AA ≤ normalizer (V : Set G) := by
    intro a ha
    apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
    rw [Subgroup.map_sup, Subgroup.mem_normalizer_iff_map_conj_eq.mp (hAY ha),
      Subgroup.mem_normalizer_iff_map_conj_eq.mp (hAN ha)]
  have hAM : d.AA ≤ d.M := d.AA_le_S.trans d.hS.le |>.trans (by
    rw [d.hL]
    exact sup_le (sup_le (d.hLM 0) (d.hLM 1)) (d.hLM 2))
  have hAZ : d.AA ≤ normalizer (Z : Set G) := fun a ha =>
    Subgroup.inf_normalizer_le_normalizer_inf ⟨hAV ha, Subgroup.le_normalizer (hAM ha)⟩
  have hNsub : N.subgroupOf C = CFSG.pPrimeCore 3 C :=
    Subgroup.comap_map_eq_self_of_injective C.subtype_injective _
  have hNmap : (N.subgroupOf C).map ρ = ⊥ := by
    rw [hNsub, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
  have hmapV : (V.subgroupOf C).map ρ = T := by
    rw [Subgroup.subgroupOf_sup hYC hNC, Subgroup.map_sup, hNmap, sup_bot_eq]
  have hmapZ : (Z.subgroupOf C).map ρ = T := by
    apply le_antisymm
    · exact (Subgroup.map_mono (Subgroup.subgroupOf_mono C inf_le_left)).trans (le_of_eq hmapV)
    · rintro t ⟨y, hy, rfl⟩
      have hyC : (y : G) ∈ (C ⊓ d.M) ⊔ N := by
        rw [← hfactor]
        exact y.2
      have hNnorm : (N.subgroupOf C).Normal := Subgroup.normal_subgroupOf_of_le_normalizer hNN
      have hySup : y ∈ (C ⊓ d.M).subgroupOf C ⊔ N.subgroupOf C := by
        rw [← Subgroup.subgroupOf_sup (show C ⊓ d.M ≤ C from inf_le_left) hNC]
        exact hyC
      obtain ⟨m, hm, n, hn, hmn⟩ := Subgroup.mem_sup_of_normal_right.mp hySup
      have hn0 : ρ n = 1 := (QuotientGroup.eq_one_iff n).mpr (hNsub ▸ hn)
      have hmV : (m : G) ∈ V := by
        have hm : m = y * n⁻¹ := by rw [← hmn]; group
        rw [hm]
        exact V.mul_mem (Subgroup.mem_sup_left hy) (Subgroup.mem_sup_right (N.inv_mem hn))
      refine ⟨m, ⟨hmV, hm.2⟩, ?_⟩
      rw [← hmn, map_mul, hn0, mul_one]
  let W := CFSG.Quasithin.perfectCore Z
  have hWC : W ≤ C := (CFSG.Quasithin.perfectCore_le Z).trans hZC
  have hWM : W ≤ d.M := (CFSG.Quasithin.perfectCore_le Z).trans inf_le_right
  have hAW : d.AA ≤ normalizer (W : Set G) := hAZ.trans (CFSG.Quasithin.normalizer_le_normalizer_perfectCore Z)
  have hW : Group.IsPerfect W := Subgroup.isPerfect_iff.mpr (CFSG.Quasithin.perfectCore_perfect Z)
  have hW3 : ¬ 3 ∣ Nat.card W := fun h => hV3 (h.trans
    (Subgroup.card_dvd_of_le ((CFSG.Quasithin.perfectCore_le Z).trans inf_le_left)))
  have hT : Group.IsPerfect T := by
    have : Group.IsPerfect (Y.subgroupOf C) := Group.IsPerfect.ofSurjective
      (f := (Subgroup.subgroupOfEquivOfLe hYC).symm.toMonoidHom)
      (Subgroup.subgroupOfEquivOfLe hYC).symm.surjective
    exact Group.IsPerfect.ofSurjective (f := ρ.subgroupMap (Y.subgroupOf C)) (ρ.subgroupMap_surjective _)
  have hpc : CFSG.Quasithin.perfectCore (Z.subgroupOf C) = W.subgroupOf C := by
    apply Subgroup.map_injective C.subtype_injective
    rw [CFSG.Quasithin.map_perfectCore, Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hZC,
      Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hWC]
  have hmapW : (W.subgroupOf C).map ρ = T := by
    rw [← hpc, CFSG.Quasithin.map_perfectCore, hmapZ]
    exact CFSG.Quasithin.perfectCore_eq_self_of_perfect (Subgroup.isPerfect_iff.mp hT)
  have hmapgen : ⁅T, (d.AA.subgroupOf C).map ρ⁆ = T := by
    have h : ⁅Y.subgroupOf C, d.AA.subgroupOf C⁆ = Y.subgroupOf C := by
      apply Subgroup.map_injective C.subtype_injective
      rw [Subgroup.map_commutator, Subgroup.subgroupOf_map_subtype,
        Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hYC, inf_eq_left.mpr hAC,
        hgen]
    rw [← Subgroup.map_commutator, h]
  have hcommW := commutator_AA_le_pCoreOf_of_perfect_three_prime_calC
    d hcal hinj hM3 hM hWM hW hW3 hAW
  have hcommWC : ⁅W.subgroupOf C, d.AA.subgroupOf C⁆ ≤ CFSG.Open.pCoreOf 2 (W.subgroupOf C) := by
    rw [CFSG.GroupTheory.pCoreOf_subgroupOf 2 hWC]
    intro x hx
    have hm : ⁅W.subgroupOf C, d.AA.subgroupOf C⁆.map C.subtype = ⁅W, d.AA⁆ := by
      rw [Subgroup.map_commutator, Subgroup.subgroupOf_map_subtype,
        Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hWC, inf_eq_left.mpr hAC]
    exact hcommW (hm ▸ Subgroup.mem_map_of_mem C.subtype hx)
  have hT2 : IsPGroup 2 T := by
    have heq : ⁅(W.subgroupOf C).map ρ, (d.AA.subgroupOf C).map ρ⁆ = T := by rw [hmapW]; exact hmapgen
    have hle : T ≤ (CFSG.Open.pCoreOf 2 (W.subgroupOf C)).map ρ := by
      rw [← heq, ← Subgroup.map_commutator]
      exact Subgroup.map_mono hcommWC
    exact ((CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 (W.subgroupOf C)).map ρ).to_le hle
  have hTbot : T = ⊥ := CFSG.Quasithin.H13.U3.eq_bot_of_isPerfect_of_isPGroup
    (Subgroup.isPerfect_iff.mp hT) hT2
  have hYN : Y.subgroupOf C ≤ ρ.ker := (Subgroup.map_eq_bot_iff _).mp hTbot
  rw [QuotientGroup.ker_mk'] at hYN
  intro y hy
  exact ⟨⟨y, hYC hy⟩, hYN hy, rfl⟩

theorem eq_bot_of_perfect_cyclic_lift_of_actual_complement
    {G : Type} [Group G] [Finite G] {D : Data G} (c : Ctx82E3 D)
    (hSz : CFSG.RankThree.PartTwo.KFacts.KPSz) (d : SylowThreeData G)
    (hcal : ∀ i, d.Lf i ∈ calC d.M) (hinj : Function.Injective d.Lf)
    (hM3 : CFSG.Open.pRank 3 d.M ≤ 3) (hM : CFSG.Open.IsKGroup d.M)
    (hdL : d.L = c.L) {i j k : Fin 3} (hki : k ≠ i) (hkj : k ≠ j)
    {p : ℕ} (hp : p.Prime) (hp5 : 5 < p) (hRank : CFSG.Open.pRank p (d.Lf k) = 1)
    {b : G} (hb : b ∈ d.A i ⊔ d.A j)
    (hC : CFSG.Open.IsKGroup (centralizer ({b} : Set G)))
    (hfactor : centralizer ({b} : Set G) =
      (centralizer ({b} : Set G) ⊓ d.M) ⊔ (CFSG.pPrimeCore 3 (centralizer ({b} : Set G))).map (centralizer ({b} : Set G)).subtype)
    {Y B : Subgroup G} (hYC : Y ≤ centralizer ({b} : Set G))
    (hY : Group.IsPerfect Y) (hY3 : ¬ 3 ∣ Nat.card Y) (hAY : d.AA ≤ normalizer (Y : Set G))
    (hgen : ⁅Y, d.AA⁆ = Y) (hB : B ≤ d.AA) (hBY : B ≤ centralizer (Y : Set G))
    (hAA : d.AA = B ⊔ d.A k) : Y = ⊥ := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have : Fact p.Prime := ⟨hp⟩
  let C := centralizer ({b} : Set G)
  let θ := aschbacherSolvableCore 3 C
  let ρ := QuotientGroup.mk' θ
  let N := (CFSG.pPrimeCore 3 C).map C.subtype
  have hAC : d.AA ≤ C := by
    have hAi : d.A i ≤ d.AA := by
      rw [d.AA_def]
      fin_cases i
      · exact le_sup_left.trans le_sup_left
      · exact le_sup_right.trans le_sup_left
      · exact le_sup_right
    have hAj : d.A j ≤ d.AA := by
      rw [d.AA_def]
      fin_cases j
      · exact le_sup_left.trans le_sup_left
      · exact le_sup_right.trans le_sup_left
      · exact le_sup_right
    have hbAA : b ∈ d.AA := (sup_le hAi hAj) hb
    intro a ha
    exact Subgroup.mem_centralizer_singleton_iff.mpr (d.S_commute a b (d.AA_le_S ha) (d.AA_le_S hbAA))
  have hAkAA : d.A k ≤ d.AA := by rw [hAA]; exact le_sup_right
  have hYN : Y ≤ N := le_pPrimeCore_of_perfect_commutator_eq_of_factorization
    d hcal hinj hM3 hM hAC hYC hY hY3 hAY hgen hfactor
  obtain ⟨hQL, hQperf, hAkQ, π, hπ, hπ2⟩ :=
    perfect_complement_lift_of_le_axis_pair d hcal hki hkj hb
  let Q := CFSG.Quasithin.perfectCore ((d.Lf k ⊔ CFSG.Open.pCoreOf 2 d.M) ⊓ C)
  have hQC : Q ≤ C := (CFSG.Quasithin.perfectCore_le _).trans inf_le_right
  have hQCL : Q ≤ c.L ⊓ C := le_inf (hQL.trans (d.Lf_le_L k) |>.trans (le_of_eq hdL)) hQC
  have hQI : Q ≤ ONan.perfectCoreL c b := by
    have h := CFSG.Quasithin.le_perfectCore_of_perfect hQCL (Subgroup.isPerfect_iff.mp hQperf)
    rw [CFSG.Quasithin.perfectCore_eq_map_perfectResidual] at h
    exact h
  have hQsimple : CFSG.IsQuasisimple (Bar2 (d.Lf k)) :=
    (CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_native _).mp
      ((CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_open _).mpr (hcal k).2.2)
  have hπsol : Group.IsSolvable π.ker := by
    have : Group.IsNilpotent π.ker := hπ2.isNilpotent
    infer_instance
  have hp2 : p ≠ 2 := by omega
  have hqRank : CFSG.Open.pRank p (⊤ : Subgroup (Bar2 (d.Lf k))) = 1 := by
    rw [← CFSG.SectionRank.pRank_eq_open_pRank_top,
      CFSG.GroupTheory.PRankCoprimeQuotient.pRank_quotient_eq_of_not_dvd hp
        (CFSG.pCore 2 (d.Lf k))
        (CFSG.GroupTheory.not_dvd_card_of_isPGroup CFSG.pCore_isPGroup hp hp2),
      CFSG.SectionRank.pRank_coe_eq_openPRank, hRank]
  have hqRank3 : CFSG.Open.pRank 3 (⊤ : Subgroup (Bar2 (d.Lf k))) = 1 := by
    rw [← CFSG.SectionRank.pRank_eq_open_pRank_top,
      CFSG.GroupTheory.PRankCoprimeQuotient.pRank_quotient_eq_of_not_dvd Nat.prime_three
        (CFSG.pCore 2 (d.Lf k))
        (CFSG.GroupTheory.not_dvd_card_of_isPGroup CFSG.pCore_isPGroup Nat.prime_three (by norm_num)),
      CFSG.SectionRank.pRank_coe_eq_openPRank, d.hrank k]
  have hQbarperf : Group.IsPerfect (Bar2 (d.Lf k)) := hQsimple.1
  have hpZ := @CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.not_dvd_card_center_of_pRank_eq_one
    (Bar2 (d.Lf k)) _ _ hQbarperf p inferInstance hp2 hqRank
  have h3Z := @CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.not_dvd_card_center_of_pRank_eq_one
    (Bar2 (d.Lf k)) _ _ hQbarperf 3 inferInstance (by norm_num) hqRank3
  have hpBar := CFSG.GroupTheory.dvd_card_of_one_le_pRank hp hqRank.ge
  have h3Bar := CFSG.GroupTheory.dvd_card_of_one_le_pRank Nat.prime_three hqRank3.ge
  rw [Nat.card_congr (Subgroup.topEquiv (G := Bar2 (d.Lf k))).toEquiv] at hpBar h3Bar
  have hpSimple : p ∣ Nat.card (Bar2 (d.Lf k) ⧸ center (Bar2 (d.Lf k))) := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (center (Bar2 (d.Lf k)))] at hpBar
    exact (hp.dvd_mul.mp hpBar).resolve_right hpZ
  have h3Simple : 3 ∣ Nat.card (Bar2 (d.Lf k) ⧸ center (Bar2 (d.Lf k))) := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (center (Bar2 (d.Lf k)))] at h3Bar
    exact (Nat.prime_three.dvd_mul.mp h3Bar).resolve_right h3Z
  have hcoreComm := commutator_pPrimeCore_image_eq_bot_of_perfect_quasisimple_quotient
    c hSz hQI hQperf hQsimple π hπ hπsol hp hp5 hpSimple h3Simple hC
  change ⁅(Q.subgroupOf C).map ρ, (CFSG.pPrimeCore 3 C).map ρ⁆ = ⊥ at hcoreComm
  have hcommAk : ⁅Y, d.A k⁆ ≤ (θ.map C.subtype : Subgroup G) := by
    have hNsub : N.subgroupOf C = CFSG.pPrimeCore 3 C :=
      Subgroup.comap_map_eq_self_of_injective C.subtype_injective _
    have hmap : ⁅(Y.subgroupOf C).map ρ, ((d.A k).subgroupOf C).map ρ⁆ = ⊥ := by
      apply le_bot_iff.mp
      rw [Subgroup.commutator_comm] at hcoreComm
      rw [← hcoreComm]
      refine Subgroup.commutator_mono ?_ ?_
      · rw [← hNsub]
        exact Subgroup.map_mono (Subgroup.subgroupOf_mono C hYN)
      · exact Subgroup.map_mono (Subgroup.subgroupOf_mono C hAkQ)
    have hle : ⁅Y.subgroupOf C, (d.A k).subgroupOf C⁆ ≤ θ := by
      rw [← Subgroup.map_commutator, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at hmap
      exact hmap
    have h := Subgroup.map_mono (f := C.subtype) hle
    rw [Subgroup.map_commutator, Subgroup.subgroupOf_map_subtype,
      Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hYC,
      inf_eq_left.mpr (hAkAA.trans hAC)] at h
    exact h
  have hθC : C ≤ normalizer (θ.map C.subtype : Set G) := by
    intro x hx
    have hN : (⟨x, hx⟩ : C) ∈ normalizer (θ : Set C) := by
      rw [Subgroup.normalizer_eq_top_iff.mpr (inferInstance : θ.Normal)]
      exact Subgroup.mem_top _
    exact Subgroup.le_normalizer_map C.subtype (Subgroup.mem_map_of_mem C.subtype hN)
  have hcommB : ⁅B, Y⁆ = ⊥ := Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hBY
  have hYA : ⁅Y, d.AA⁆ ≤ θ.map C.subtype := by
    rw [hAA, Subgroup.commutator_comm]
    exact CFSG.GorensteinWalter.commutator_sup_le_of_commutator_le_and_normalize B (d.A k) Y
      (θ.map C.subtype) (hcommB ▸ bot_le) (by rw [Subgroup.commutator_comm]; exact hcommAk)
      (hB.trans hAC |>.trans hθC) (hAkAA.trans hAC |>.trans hθC)
  have hYθ : Y ≤ θ.map C.subtype := hgen ▸ hYA
  have hθsol : Group.IsSolvable (θ.map C.subtype) := by
    have : Group.IsSolvable θ := (solvable_prime_complement_core_characterization (H := C) Nat.prime_three).1
    exact Group.isSolvable_of_surjective (f := C.subtype.subgroupMap θ) (C.subtype.subgroupMap_surjective _)
  have hYsol : Group.IsSolvable Y := by
    have : Group.IsSolvable (θ.map C.subtype) := hθsol
    exact Group.isSolvable_of_isSolvable_injective (Subgroup.inclusion_injective hYθ)
  by_contra hYbot
  have : Group.IsPerfect Y := hY
  have : Nontrivial Y := (Subgroup.nontrivial_iff_ne_bot Y).mpr hYbot
  exact Group.IsPerfect.not_isSolvable Y hYsol

theorem le_normalizer_component_of_cyclic_orbit_of_actual_data
    {G : Type} [Group G] [Finite G] {D : Data G} (c : Ctx82E3 D)
    (d : SylowThreeData G) (hcal : ∀ i, d.Lf i ∈ calC d.M)
    (hinj : Function.Injective d.Lf) (hM3 : CFSG.Open.pRank 3 d.M ≤ 3)
    (hM : CFSG.Open.IsKGroup d.M) (hdL : d.L = c.L)
    {p : ℕ} (hp : p.Prime) (hp5 : 5 < p) (hRank : ∀ i, CFSG.Open.pRank p (d.Lf i) = 1)
    (hFactor : ∀ i j : Fin 3, i ≠ j → ∀ b ∈ d.A i ⊔ d.A j, b ≠ 1 →
      let C := centralizer ({b} : Set G)
      C = (C ⊓ d.M) ⊔ (CFSG.pPrimeCore 3 C).map C.subtype)
    {x : G} (hx : x ∈ d.AA)
    {J : Subgroup (centralizer ({x} : Set G) ⧸ aschbacherSolvableCore 3 (centralizer ({x} : Set G)))}
    (hJ : CFSG.IsComponent J) (hJ3 : ¬ 3 ∣ Nat.card J)
    (hcyclic :
      let C := centralizer ({x} : Set G)
      let ρ := QuotientGroup.mk' (aschbacherSolvableCore 3 C)
      let A := (d.AA.subgroupOf C).map ρ
      let K := orbitClosure J A
      ∃ k : Fin 3, ∃ a : C, (a : G) ∈ d.A k ∧
        A ≤ centralizer (K : Set (C ⧸ aschbacherSolvableCore 3 C)) ⊔ zpowers (ρ a)) :
    (d.AA.subgroupOf (centralizer ({x} : Set G))).map
      (QuotientGroup.mk' (aschbacherSolvableCore 3 (centralizer ({x} : Set G)))) ≤
        normalizer (J : Set (centralizer ({x} : Set G) ⧸ aschbacherSolvableCore 3 (centralizer ({x} : Set G)))) := by
  by_contra hm
  obtain ⟨i, j, k, b, B, Y, hij, hki, hkj, hb, hb1, hBA, hYC, hY, hY3, hAY, hgen, hBY, hAA, hYbot⟩ :=
    exists_perfect_cyclic_component_lift d hx hJ hJ3 hm hcyclic
  have hCb : CFSG.Open.IsKGroup (centralizer ({b} : Set G)) := by
    have hAi : ∀ i, d.A i ≤ d.AA := by
      intro i
      rw [d.AA_def]
      fin_cases i
      · exact le_sup_left.trans le_sup_left
      · exact le_sup_right.trans le_sup_left
      · exact le_sup_right
    have hbAA := (sup_le (hAi i) (hAi j)) hb
    have hc : Nat.card (zpowers b) = 3 := by
      rw [Nat.card_zpowers]
      exact orderOf_eq_prime (d.isElemAbelian_AA.2 b hbAA) hb1
    have h := CFSG.LocalAnalysis.GLTheoremA.S3.isKGroup_cen D.standing.simple D.standing.nonab c.kProper
      (E := zpowers b) (by intro h; rw [h, Subgroup.card_bot] at hc; norm_num at hc)
    rwa [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure] at h
  exact hYbot (eq_bot_of_perfect_cyclic_lift_of_actual_complement c CFSG.RankThree.PartTwo.KFacts.kpSz
    d hcal hinj hM3 hM hdL hki hkj hp hp5 (hRank k) hb hCb (hFactor i j hij b hb hb1)
    hYC hY hY3 hAY hgen hBA hBY hAA)

theorem le_normalizer_component_of_three_prime_of_actual_data
    {G : Type} [Group G] [Finite G] {D : Data G} (c : Ctx82E3 D)
    (d : SylowThreeData G) (hcal : ∀ i, d.Lf i ∈ calC d.M)
    (hinj : Function.Injective d.Lf) (hM3 : CFSG.Open.pRank 3 d.M ≤ 3)
    (hM : CFSG.Open.IsKGroup d.M) (hdL : d.L = c.L)
    {p : ℕ} (hp : p.Prime) (hp5 : 5 < p) (hRank : ∀ i, CFSG.Open.pRank p (d.Lf i) = 1)
    (hAxis : ∀ i, centralizer (d.A i : Set G) ≤ d.M)
    (hFactor : ∀ i j : Fin 3, i ≠ j → ∀ b ∈ d.A i ⊔ d.A j, b ≠ 1 →
      let C := centralizer ({b} : Set G)
      C = (C ⊓ d.M) ⊔ (CFSG.pPrimeCore 3 C).map C.subtype)
    {x : G} (hx : x ∈ d.AA)
    {J : Subgroup (centralizer ({x} : Set G) ⧸ aschbacherSolvableCore 3 (centralizer ({x} : Set G)))}
    (hJ : CFSG.IsComponent J) (hJ3 : ¬ 3 ∣ Nat.card J) :
    (d.AA.subgroupOf (centralizer ({x} : Set G))).map
      (QuotientGroup.mk' (aschbacherSolvableCore 3 (centralizer ({x} : Set G)))) ≤
        normalizer (J : Set (centralizer ({x} : Set G) ⧸ aschbacherSolvableCore 3 (centralizer ({x} : Set G)))) := by
  by_contra hm
  have hcyc := cyclic_component_orbit_action_of_three_prime d hcal hinj hM3 hM hAxis hx hJ hJ3 hm
  exact hm (le_normalizer_component_of_cyclic_orbit_of_actual_data c d hcal hinj hM3 hM hdL hp hp5 hRank hFactor hx hJ hJ3 hcyc)

