theorem hom_eq_one_of_perfect_three_prime_of_noSz
    {X H : Type} [Group X] [Finite X] [Group H] [Finite H]
    (hK : CFSG.IsKGroup X) (hperf : Group.IsPerfect X)
    (h3 : ¬ 3 ∣ Nat.card X) (hH : NoSzSection H) (φ : X →* H) : φ = 1 := by
  classical
  have hKR : CFSG.IsKGroup φ.range := hK.of_surjective φ.rangeRestrict φ.rangeRestrict_surjective
  have hpR : Group.IsPerfect φ.range := Group.IsPerfect.range φ
  have h3R : ¬ 3 ∣ Nat.card φ.range := fun h => h3 (h.trans (Subgroup.card_range_dvd φ))
  have hNo : NoSzSection φ.range := noSzSection_of_injective φ.range.subtype φ.range.subtype_injective hH
  have hbot : φ.range = ⊥ := by
    by_contra hne
    have : Nontrivial φ.range := (Subgroup.nontrivial_iff_ne_bot _).mpr hne
    obtain ⟨N, hN, f, hmodel⟩ :=
      CFSG.RankThree.PartTwo.Sec14.Ronan148K.exists_suzuki_section_of_isPerfect hKR hpR h3R inferInstance
    have : N.Normal := hN
    exact false_of_surjective hNo (QuotientGroup.mk' N) (QuotientGroup.mk'_surjective N) hmodel
  apply MonoidHom.ext
  intro x
  exact (Subgroup.mem_bot.mp (hbot ▸ (show φ x ∈ φ.range from ⟨x, rfl⟩)))

