variable {H : Type*} [Group H] [Finite H]

theorem mem_normalizer_component_of_centralizes_sylow_of_dvd
    {p : ℕ} [Fact p.Prime] (P : Sylow p H) {z : H}
    (hz : z ∈ centralizer ((P : Subgroup H) : Set H))
    {K : Subgroup H} (hK : CFSG.IsComponent K) (hdiv : p ∣ Nat.card K) :
    z ∈ normalizer (K : Set H) := by
  by_contra hnorm
  let J : Subgroup H := K.map (MulAut.conj z⁻¹).toMonoidHom
  have hmemJ : ∀ x : H, x ∈ J ↔ z * x * z⁻¹ ∈ K :=
    CFSG.QuasithinUnique.mem_map_conj_inv_iff K z
  have hJ : CFSG.IsComponent J :=
    CFSG.LocalCores.isComponent_map_mulEquiv (MulAut.conj z⁻¹) hK
  have hne : K ≠ J := fun h =>
    hnorm (Subgroup.mem_normalizer_iff.mpr fun x => (SetLike.ext_iff.mp h x).trans (hmemJ x))
  have hcomm : ⁅K, J⁆ = ⊥ :=
    (CFSG.LocalCores.distinct_components_commute hK hJ).resolve_left hne
  obtain ⟨T, hT⟩ := CFSG.Walter.exists_sylow_map_eq_inf_of_isSubnormal P hK.2
  have : Group.IsPerfect K := hK.1.1
  have hTZ : (T : Subgroup K) ≤ center K := by
    intro t ht
    rw [Subgroup.mem_center_iff]
    intro k
    have htP : (t : H) ∈ (P : Subgroup H) ⊓ K :=
      hT ▸ Subgroup.mem_map_of_mem _ ht
    have hfix : z * (t : H) * z⁻¹ = t := by
      rw [mul_inv_eq_iff_eq_mul]
      exact (Subgroup.mem_centralizer_iff.mp hz t htP.1).symm
    have htJ : (t : H) ∈ J := (hmemJ t).mpr (by rw [hfix]; exact t.2)
    exact Subtype.ext ((Subgroup.mem_centralizer_iff.mp
      (Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcomm k.2) t htJ).symm)
  exact T.ne_bot_of_dvd_card hdiv (CFSG.QuasithinUnique.sylow_eq_bot_of_le_center T hTZ)

theorem le_normalizer_component_of_abelian_sylow_of_dvd
    (P : Sylow 3 H)
    (hP : ∀ a ∈ (P : Subgroup H), ∀ b ∈ (P : Subgroup H), a * b = b * a)
    {K : Subgroup H} (hK : CFSG.IsComponent K) (hdiv : 3 ∣ Nat.card K) :
    (P : Subgroup H) ≤ normalizer (K : Set H) := by
  intro a ha
  exact mem_normalizer_component_of_centralizes_sylow_of_dvd P
    (mem_centralizer_iff.mpr fun b hb => hP b hb a ha) hK hdiv

theorem isSimpleGroup_component_of_abelian_sylow_of_theta_eq_bot
    (hθ : aschbacherSolvableCore 3 H = ⊥) (P : Sylow 3 H)
    (hP : ∀ a ∈ (P : Subgroup H), ∀ b ∈ (P : Subgroup H), a * b = b * a)
    {K : Subgroup H} (hK : CFSG.IsComponent K) : IsSimpleGroup K := by
  have hZmap : (center K).map K.subtype ≤ (P : Subgroup H) :=
    (CFSG.RankThree.Theta.center_map_le_pCore_three hθ hK).trans
      ((CFSG.pCore_isPGroup (p := 3) (G := H)).le_sylow_of_normal P)
  obtain ⟨T, hT⟩ := CFSG.Walter.exists_sylow_map_eq_inf_of_isSubnormal P hK.2
  have : Group.IsPerfect K := hK.1.1
  have : IsMulCommutative (T : Subgroup K) := by
    refine ⟨⟨fun a b => Subtype.ext (Subtype.ext ?_)⟩⟩
    have ha : (a : H) ∈ (P : Subgroup H) :=
      (hT ▸ Subgroup.mem_map_of_mem _ a.2).1
    have hb : (b : H) ∈ (P : Subgroup H) :=
      (hT ▸ Subgroup.mem_map_of_mem _ b.2).1
    exact hP a ha b hb
  have hZ : center K = ⊥ := by
    refine le_bot_iff.mp ?_
    intro z hz
    have hzP := hZmap (Subgroup.mem_map_of_mem K.subtype hz)
    have hzT : z ∈ (T : Subgroup K) := by
      have hm : (z : H) ∈ (T : Subgroup K).map K.subtype := hT.symm ▸ ⟨hzP, z.2⟩
      obtain ⟨w, hw, he⟩ := hm
      exact (Subtype.ext he : w = z) ▸ hw
    exact (CFSG.Quasithin.SBd19F.sylow_inf_center_eq_bot T) ▸ ⟨hzT, hz⟩
  exact (((QuotientGroup.quotientMulEquivOfEq hZ).trans
    (QuotientGroup.quotientBot (G := K))).isSimpleGroup_congr).mp hK.1.2.1

theorem exists_abelian_sylow_theta_quotient_of_actual_sylow
    {G : Type} [Group G] [Finite G] (d : SylowThreeData G)
    {x : G} (hS : CFSG.ABGLocalTools.IsSylowOf 3 d.S (centralizer ({x} : Set G))) (hx : x ∈ d.AA) :
    ∃ P : Sylow 3 ((centralizer ({x} : Set G)) ⧸
        aschbacherSolvableCore 3 (centralizer ({x} : Set G))),
      (∀ a ∈ (P : Subgroup ((centralizer ({x} : Set G)) ⧸ aschbacherSolvableCore 3 (centralizer ({x} : Set G)))), ∀ b ∈ (P : Subgroup ((centralizer ({x} : Set G)) ⧸ aschbacherSolvableCore 3 (centralizer ({x} : Set G)))), a * b = b * a) ∧
      (d.AA.subgroupOf (centralizer ({x} : Set G))).map
        (QuotientGroup.mk' (aschbacherSolvableCore 3 (centralizer ({x} : Set G)))) ≤
          (P : Subgroup ((centralizer ({x} : Set G)) ⧸ aschbacherSolvableCore 3 (centralizer ({x} : Set G)))) := by
  classical
  let C : Subgroup G := centralizer ({x} : Set G)
  let θ := aschbacherSolvableCore 3 C
  let ρ := QuotientGroup.mk' θ
  have hSC : d.S ≤ C := by
    intro s hs
    exact mem_centralizer_singleton_iff.mpr (d.S_commute s x hs (d.AA_le_S hx))
  obtain ⟨P, hP⟩ := hS.exists_sylow_eq_subgroupOf
  let Pb : Sylow 3 (C ⧸ θ) := P.mapSurjective (QuotientGroup.mk'_surjective θ)
  have hPcomm : ∀ a ∈ (P : Subgroup C), ∀ b ∈ (P : Subgroup C), a * b = b * a := by
    intro a ha b hb
    have haS : a ∈ d.S.subgroupOf C := hP ▸ ha
    have hbS : b ∈ d.S.subgroupOf C := hP ▸ hb
    exact Subtype.ext (d.S_commute a b haS hbS)
  have hPbcomm : ∀ a ∈ (Pb : Subgroup (C ⧸ θ)),
      ∀ b ∈ (Pb : Subgroup (C ⧸ θ)), a * b = b * a := by
    rw [Sylow.coe_mapSurjective]
    rintro a ⟨a', ha', rfl⟩ b ⟨b', hb', rfl⟩
    exact (map_mul ρ a' b').symm.trans
      ((congrArg ρ (hPcomm a' ha' b' hb')).trans (map_mul ρ b' a'))
  have hAb : (d.AA.subgroupOf C).map ρ ≤ (Pb : Subgroup (C ⧸ θ)) := by
    rw [Sylow.coe_mapSurjective, hP]
    exact Subgroup.map_mono (fun a ha => d.AA_le_S ha)
  exact ⟨Pb, hPbcomm, hAb⟩

theorem normalizes_theta_component_of_actual_sylow
    {G : Type} [Group G] [Finite G] (d : SylowThreeData G)
    {x : G} (hS : CFSG.ABGLocalTools.IsSylowOf 3 d.S (centralizer ({x} : Set G)))
    (hx : x ∈ d.AA) {J : Subgroup (centralizer ({x} : Set G))}
    (hJ : J ∈ CFSG.RankThree.thetaComponents 3 (centralizer ({x} : Set G)))
    (hdiv : 3 ∣ Nat.card J) :
    d.AA ≤ normalizer ((J.map (centralizer ({x} : Set G)).subtype : Subgroup G) : Set G) := by
  classical
  let C : Subgroup G := centralizer ({x} : Set G)
  let θ := aschbacherSolvableCore 3 C
  let ρ := QuotientGroup.mk' θ
  have hAC : d.AA ≤ C := fun a ha => mem_centralizer_singleton_iff.mpr
    (d.S_commute a x (d.AA_le_S ha) (d.AA_le_S hx))
  obtain ⟨Pb, hPbcomm, hAb⟩ := exists_abelian_sylow_theta_quotient_of_actual_sylow d hS hx
  have hJcomp := CFSG.RankThree.isComponent_map_of_mem_thetaComponents Nat.prime_three hJ
  have hJdiv : 3 ∣ Nat.card (J.map ρ) := by
    let f := ρ.subgroupMap J
    have hker : ¬ 3 ∣ Nat.card f.ker := by
      have hle : f.ker ≤ θ.subgroupOf J := by
        intro j hj
        exact (QuotientGroup.eq_one_iff (j : C)).mp
          (show ρ (j : C) = 1 from congrArg Subtype.val hj)
      have hnd : ¬ 3 ∣ Nat.card θ :=
        (solvable_prime_complement_core_characterization (H := C) Nat.prime_three).2.2.1
      intro h3
      have hd := h3.trans (Subgroup.card_dvd_of_le hle)
      have hcard : Nat.card (θ.subgroupOf J) ∣ Nat.card θ := by
        rw [← Subgroup.card_map_of_injective J.subtype_injective,
          Subgroup.subgroupOf_map_subtype]
        exact Subgroup.card_dvd_of_le inf_le_left
      exact hnd (hd.trans hcard)
    have heq := Subgroup.card_ker_mul_card_of_surjective (ρ.subgroupMap_surjective J)
    have hd : 3 ∣ Nat.card f.ker * Nat.card (J.map ρ) := heq ▸ hdiv
    exact (Nat.prime_three.dvd_mul.mp hd).resolve_left hker
  have hJnorm : d.AA.subgroupOf C ≤ normalizer (J : Set C) :=
    ((CFSG.RankThree.theta_component_quotient_structure Nat.prime_three hJ).2.2.2.2.2.2.2.2.2.2
      (d.AA.subgroupOf C)).mpr
      (hAb.trans (le_normalizer_component_of_abelian_sylow_of_dvd Pb hPbcomm hJcomp hJdiv))
  exact CFSG.LocalAnalysis.GLTheoremA.I113.le_normalizer_map_subtype hAC hJnorm

theorem le_normalizer_theta_component_of_actual_sylow_of_dvd
    {G : Type} [Group G] [Finite G] (d : SylowThreeData G)
    {x : G} (hS : CFSG.ABGLocalTools.IsSylowOf 3 d.S (centralizer ({x} : Set G))) (hx : x ∈ d.AA)
    {L : Subgroup G} (hL : L ∈ CFSG.RankThree.thetaComponentsAt 3 x)
    (hdiv : 3 ∣ Nat.card L) : d.AA ≤ normalizer (L : Set G) := by
  obtain ⟨J, hJ, rfl⟩ := hL
  have hdivJ : 3 ∣ Nat.card J := by
    rwa [Subgroup.card_map_of_injective (centralizer ({x} : Set G)).subtype_injective] at hdiv
  exact normalizes_theta_component_of_actual_sylow d hS hx hJ hdivJ

theorem isSimpleGroup_theta_quotient_of_actual_sylow
    {G : Type} [Group G] [Finite G] (d : SylowThreeData G)
    {x : G} (hS : CFSG.ABGLocalTools.IsSylowOf 3 d.S (centralizer ({x} : Set G))) (hx : x ∈ d.AA)
    {J : Subgroup (centralizer ({x} : Set G))}
    (hJ : J ∈ CFSG.RankThree.thetaComponents 3 (centralizer ({x} : Set G))) :
    IsSimpleGroup (J ⧸ aschbacherSolvableCore 3 J) := by
  classical
  let C : Subgroup G := centralizer ({x} : Set G)
  let θ := aschbacherSolvableCore 3 C
  obtain ⟨Pb, hPbcomm, -⟩ := exists_abelian_sylow_theta_quotient_of_actual_sylow d hS hx
  have hθs := (solvable_prime_complement_core_characterization (H := C) Nat.prime_three).1
  have hθp := (solvable_prime_complement_core_characterization (H := C) Nat.prime_three).2.2.1
  have hθ : aschbacherSolvableCore 3 (C ⧸ θ) = ⊥ :=
    (solvable_prime_complement_core_quotient_centralizers Nat.prime_three θ hθs hθp).2.2.1
  have hJs := isSimpleGroup_component_of_abelian_sylow_of_theta_eq_bot hθ Pb hPbcomm
    (CFSG.RankThree.isComponent_map_of_mem_thetaComponents Nat.prime_three hJ)
  obtain ⟨η, -⟩ := CFSG.RankThree.exists_thetaQuotient_mulEquiv_map Nat.prime_three hJ.2.1
  exact (MulEquiv.isSimpleGroup_congr η).mpr hJs

theorem isSimpleGroup_thetaQuot_of_mem_thetaComponentsAt_of_not_dvd
    {G : Type} [Group G] [Finite G] {x : G} {L : Subgroup G}
    (hL : L ∈ CFSG.RankThree.thetaComponentsAt 3 x) (hL3 : ¬ 3 ∣ Nat.card L) :
    IsSimpleGroup (L ⧸ aschbacherSolvableCore 3 L) := by
  obtain ⟨J, hJ, he⟩ := hL
  have hG : J.map (centralizer ({x} : Set G)).subtype = L := he
  have hs := CFSG.RankThree.PartTwo.Sec16.Steps166.isSimpleGroup_thetaQuot_of_not_three_dvd
    (show J.map (centralizer ({x} : Set G)).subtype ∈
      CFSG.RankThree.PartTwo.thetaComponentsIn (centralizer ({x} : Set G)) from ⟨J, hJ, rfl⟩)
    (hG.symm ▸ hL3)
  exact hG ▸ hs

theorem autThetaQuot_card_ne_nine_of_mem_thetaComponentsAt_of_not_dvd
    {G : Type} [Group G] [Finite G]
    (hSz : CFSG.RankThree.PartTwo.KFacts.KPSz) (d : SylowThreeData G)
    {x : G}
    {L : Subgroup G} (hL : L ∈ CFSG.RankThree.thetaComponentsAt 3 x)
    (hK : CFSG.Open.IsKGroup (centralizer ({x} : Set G)))
    (hLp : ¬ 3 ∣ Nat.card L) :
    Nat.card (CFSG.RankThree.PartTwo.Sec4.autThetaQuot d.AA L) ≠ 9 := by
  classical
  let C : Subgroup G := centralizer ({x} : Set G)
  have hLmem := hL
  obtain ⟨J, hJ, he⟩ := hL
  subst L
  have hsL := isSimpleGroup_thetaQuot_of_mem_thetaComponentsAt_of_not_dvd hLmem hLp
  have hs := (MulEquiv.isSimpleGroup_congr (CFSG.RankThree.PartTwo.Sec13.thetaQuotEquivSub C J)).mpr hsL
  have hnJ : ∃ a b : J ⧸ aschbacherSolvableCore 3 J, a * b ≠ b * a := by
    have : Nontrivial (J ⧸ aschbacherSolvableCore 3 J) :=
      CFSG.LocalCores.isQuasisimple_nontrivial hJ.2.2
    have : Group.IsPerfect (J ⧸ aschbacherSolvableCore 3 J) := hJ.2.2.1
    by_contra hn
    push Not at hn
    have : IsMulCommutative (J ⧸ aschbacherSolvableCore 3 J) := ⟨⟨hn⟩⟩
    have : Group.IsSolvable (J ⧸ aschbacherSolvableCore 3 J) := inferInstance
    exact Group.IsPerfect.not_isSolvable (J ⧸ aschbacherSolvableCore 3 J) inferInstance
  have : IsSimpleGroup (J ⧸ aschbacherSolvableCore 3 J) := hs
  have hcat := hK.isCatalogGroup_of_surjective J hnJ
    (QuotientGroup.mk' (aschbacherSolvableCore 3 J)) (QuotientGroup.mk'_surjective _)
  let e := (CFSG.RankThree.PartTwo.Sec13.thetaQuotEquivSub C J).symm
  have : IsSimpleGroup ((J.map C.subtype) ⧸ aschbacherSolvableCore 3 (J.map C.subtype)) := hsL
  have hnL : ∃ a b : (J.map C.subtype) ⧸ aschbacherSolvableCore 3 (J.map C.subtype),
      a * b ≠ b * a := by
    obtain ⟨a, b, hab⟩ := hnJ
    refine ⟨e.symm a, e.symm b, fun h => ?_⟩
    apply hab
    simpa only [map_mul, MulEquiv.apply_symm_apply] using congrArg e h
  have hcatL : CFSG.Assembly.InCatalog
      ((J.map C.subtype) ⧸ aschbacherSolvableCore 3 (J.map C.subtype)) :=
    CFSG.Open.isCatalogGroup_isoInvariant e hcat
  have hpq : ¬ 3 ∣ Nat.card ((J.map C.subtype) ⧸ aschbacherSolvableCore 3 (J.map C.subtype)) :=
    fun h3 => hLp (h3.trans (Subgroup.card_quotient_dvd_card _))
  obtain ⟨f, hf⟩ := hSz ((J.map C.subtype) ⧸ aschbacherSolvableCore 3 (J.map C.subtype)) hnL hcatL hpq
  have hpow : ∀ τ ∈ CFSG.RankThree.PartTwo.Sec4.autThetaQuot d.AA (J.map C.subtype), τ ^ 3 = 1 := by
    intro τ hτ
    obtain ⟨a, haN, ha, rfl⟩ := CFSG.RankThree.PartTwo.Sec4.mem_autThetaQuot_iff.mp hτ
    rw [← map_pow, ← map_pow]
    have h3 : (⟨a, haN⟩ : normalizer ((J.map C.subtype) : Set G)) ^ 3 = 1 :=
      Subtype.ext (d.isElemAbelian_AA.2 a ha)
    rw [h3, map_one, map_one]
  have hdiv := CFSG.RankThree.PartTwo.KFacts.KP7.card_dvd_three_of_pow_three hf hpow
  intro h9
  rw [h9] at hdiv
  norm_num at hdiv

theorem autThetaQuot_card_ne_nine_of_actual_sylow_of_not_three_dvd
    {G : Type} [Group G] [Finite G]
    (hSz : CFSG.RankThree.PartTwo.KFacts.KPSz) (d : SylowThreeData G)
    {x : G} (_hS : CFSG.ABGLocalTools.IsSylowOf 3 d.S (centralizer ({x} : Set G))) (_hx : x ∈ d.AA)
    {L : Subgroup G} (hL : L ∈ CFSG.RankThree.thetaComponentsAt 3 x)
    (hK : CFSG.Open.IsKGroup (centralizer ({x} : Set G)))
    (hLp : ¬ 3 ∣ Nat.card L) :
