      (Subgroup.topEquiv : (⊤ : Subgroup (GL (Fin 3) K)) ≃* GL (Fin 3) K).surjective hh
  let c : GL (Fin 3) K →* linearAutGroup 3 K :=
    (conjAut 3 K).codRestrict _ conjAut_mem_linearAutGroup
