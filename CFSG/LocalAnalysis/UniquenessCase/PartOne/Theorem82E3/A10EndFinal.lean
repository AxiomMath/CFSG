private theorem exists_inCalVStar : ∃ V : Subgroup G, PartTwo.InCalVStar D.M V := by
  obtain ⟨V, -, hVmax⟩ :=
    (Set.toFinite {W : Subgroup G | UC22.InCalV D.M W}).exists_le_maximal
      (CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p22e_inCalV_U D)
  exact ⟨V, hVmax.1, fun W hW hVW => le_antisymm (hVmax.2 hW hVW) hVW⟩

private theorem exists_hyperplane_not_le_centralizer (F : A10Frame c) {V : Subgroup G}
    (hV : UC22.InCalV D.M V) (hVA : ¬ F.A ≤ Subgroup.centralizer (V : Set G))
    {B : Subgroup G} (hBA : B ≤ F.A) (hB3 : Nat.card B = 3) (hB9 : F.deg B = 9) :
    ∃ e ∈ F.A, e ≠ 1 ∧
      ¬ V ⊓ Subgroup.centralizer ({e} : Set G) ≤ Subgroup.centralizer (F.A : Set G) ∧
      ∀ a ∈ B ⊔ Subgroup.zpowers e, F.deg (Subgroup.zpowers a) ≠ 3 := by
  classical
  obtain ⟨d, hdA, hB3card, hno3⟩ := F.exists_hyperplane_deg_ne_three hBA hB3 hB9
  have hB3ea : CFSG.Open.IsElemAbelian 3 (B ⊔ Subgroup.zpowers d) :=
    (F.elemAbelian.mono hBA).sup_of_commute
      (CFSG.Open.isElemAbelian_zpowers (F.elemAbelian.2 d hdA))
      (fun a ha b hb => F.elemAbelian.comm (hBA ha) (Subgroup.zpowers_le.mpr hdA hb))
  have hV2 : IsPGroup 2 V := hV.2.2.2.isPGroup
  obtain ⟨n, hn⟩ := hV2.exists_card_eq
  have h3V : ¬ 3 ∣ Nat.card V := by
    rw [hn]
    intro h
    have h32 : 3 ∣ 2 := Nat.prime_three.dvd_of_dvd_pow h
    norm_num at h32
  have hB3norm : B ⊔ Subgroup.zpowers d ≤ Subgroup.normalizer (V : Set G) :=
    (sup_le hBA (Subgroup.zpowers_le.mpr hdA)).trans (F.A_le_M.trans hV.2.2.1)
  have hgen := CFSG.LocalAnalysis.GLTheoremB.MovingAround.Lemma123.le_iSup_inf_centralizer
    (p := 3) hB3ea (by rw [hB3card]; norm_num) h3V hB3norm
  have hex : ∃ e ∈ B ⊔ Subgroup.zpowers d, e ≠ 1 ∧
      ¬ V ⊓ Subgroup.centralizer ({e} : Set G) ≤ Subgroup.centralizer (F.A : Set G) := by
    by_contra hcon
    have hall : ∀ e ∈ B ⊔ Subgroup.zpowers d, e ≠ 1 →
        V ⊓ Subgroup.centralizer ({e} : Set G) ≤ Subgroup.centralizer (F.A : Set G) := by
      intro e he he1
      by_contra h
      exact hcon ⟨e, he, he1, h⟩
    refine hVA ?_
    rw [Subgroup.le_centralizer_iff]
    refine hgen.trans ?_
    exact iSup_le fun e => iSup_le fun he => iSup_le fun he1 => hall e he he1
  obtain ⟨e, heB3, he1, hnot⟩ := hex
  refine ⟨e, (sup_le hBA (Subgroup.zpowers_le.mpr hdA)) heB3, he1, hnot, ?_⟩
  intro a ha
  exact hno3 a ((sup_le le_sup_left (Subgroup.zpowers_le.mpr heB3)) ha)

private theorem exists_twoLocal_data
    (F : A10Frame c) (hF : A10Facts F)
    (hC : ∀ B ≤ F.A, Nat.card B = 3 →
      Subgroup.centralizer (B : Set G) ≤ (Subgroup.centralizer (B : Set G) ⊓ D.M) ⊔
        CFSG.Open.relPPrimeCore 3 (Subgroup.centralizer (B : Set G)))
    (hKPSz : CFSG.RankThree.PartTwo.KFacts.KPSz) {V : Subgroup G} (hV : UC22.InCalV D.M V)
    {e : G} (heA : e ∈ F.A) (he1 : e ≠ 1)
    (hnot : ¬ V ⊓ Subgroup.centralizer ({e} : Set G) ≤ Subgroup.centralizer (F.A : Set G)) :
    ∃ N Q U : Subgroup G,
      CFSG.Open.IsTwoLocal N ∧ IsPGroup 2 Q ∧ Q = CFSG.Open.pCoreOf 2 N ∧
      F.A ≤ Subgroup.normalizer (Q : Set G) ∧
      U ≤ V ∧ U ≠ ⊥ ∧ c.L ≤ Subgroup.normalizer (U : Set G) ∧
      (∀ w ∈ U, (Subgroup.centralizer ({w} : Set G)).relIndex Q ≤ 4) ∧
      Subgroup.centralizer (Subgroup.zpowers e : Set G) ≤ N := by
  classical
  let Y : Subgroup G := Subgroup.zpowers e
  have hY3 : Nat.card Y = 3 := F.card_zpowers_of_mem_A heA he1
  have hYleA : Y ≤ F.A := Subgroup.zpowers_le.mpr heA
  have hCe : Subgroup.centralizer (Y : Set G) = Subgroup.centralizer ({e} : Set G) := by
    simp only [Y, Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
  have hO : CFSG.Open.pCoreOf 2 (Subgroup.centralizer (Y : Set G)) ≠ ⊥ := by
    intro hbot
    have hE : CFSG.GorensteinWalter.componentLayerOf (Subgroup.centralizer (Y : Set G)) ≤ D.M :=
      F.componentLayerOf_centralizer_le hF hC hKPSz hYleA hY3 hbot
    have hle : V ⊓ Subgroup.centralizer (Y : Set G) ≤ Subgroup.centralizer (F.A : Set G) :=
      F.inf_centralizer_le_centralizer_A hF hV hYleA hY3 hbot hE
    exact hnot (by rwa [hCe] at hle)
  let S : Subgroup G := CFSG.Open.pCoreOf 2 (Subgroup.centralizer (Y : Set G))
  let N : Subgroup G := Subgroup.normalizer (S : Set G)
  let Q : Subgroup G := CFSG.Open.pCoreOf 2 N
  have hS2 : IsPGroup 2 S := CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 _
  have hQ2 : IsPGroup 2 Q := CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 N
  have hN2 : CFSG.Open.IsTwoLocal N := ⟨S, hO, hS2, rfl⟩
  have hCY_N : Subgroup.centralizer (Y : Set G) ≤ N :=
    CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 _
  have hA_CY : F.A ≤ Subgroup.centralizer (Y : Set G) := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    exact F.elemAbelian.comm (hYleA hy) ha
  have hAQ : F.A ≤ Subgroup.normalizer (Q : Set G) :=
    (hA_CY.trans hCY_N).trans (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 N)
  obtain ⟨U, hUV, hUne, hLU, hrel⟩ := F.exists_le_relIndex_le_four hF hC hV hQ2 hAQ
  exact ⟨N, Q, U, hN2, hQ2, rfl, hAQ, hUV, hUne, hLU, hrel, hCY_N⟩

private theorem le_centralizer_pCoreOf_three (F : A10Frame c) (hF : A10Facts F)
    {B V W : Subgroup G} (hBA : B ≤ F.A) (hB3 : Nat.card B = 3) (hB9 : F.deg B = 9)
    (hO : CFSG.Open.pCoreOf 2 (Subgroup.centralizer (B : Set G)) = ⊥)
    (hV : UC22.InCalV D.M V) (hWV : W ≤ V)
    (hWH : W ≤ Subgroup.centralizer (B : Set G)) :
    W ≤ Subgroup.centralizer
      (CFSG.Open.pCoreOf 3 (Subgroup.centralizer (B : Set G)) : Set G) := by
  let H : Subgroup G := Subgroup.centralizer (B : Set G)
  let X : Subgroup G := CFSG.Open.pCoreOf 3 H
  have hXH : X ≤ H := CFSG.LieType.BorelTits.pCoreOf_le 3 H
  have hXn : (X.subgroupOf H).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hXH).mpr
      (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 3 H)
  have hA_H : F.A ≤ H := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    exact F.elemAbelian.comm (hBA hb) ha
  have hAX : F.A ≤ Subgroup.normalizer (X : Set G) :=
    hA_H.trans (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 3 H)
  have hAsup : IsPGroup 3 ↥(F.A ⊔ X) :=
    F.elemAbelian.isPGroup.to_sup_of_normal_right'
      (CFSG.LieType.BorelTits.pCoreOf_isPGroup 3 H) hAX
  have hXM : X ≤ D.M :=
    (le_sup_right : X ≤ F.A ⊔ X).trans
      (F.le_M_of_isPGroup hF.normalizer_A hAsup le_sup_left)
  have hXV : X ≤ Subgroup.normalizer (V : Set G) := hXM.trans hV.2.2.1
  exact A10Gen.le_centralizer_of_pCoreOf_eq_bot hXH hXn hXV hV.2.2.2.isPGroup hWV hWH hO

private theorem not_mem_of_centralizes_pCoreOf_two (D : Data G) {N Q : Subgroup G} {y : G} {p : ℕ}
    (hp : p.Prime) (hp7 : 7 ≤ p) (hN : CFSG.Open.IsTwoLocal N)
    (hQ2 : IsPGroup 2 Q) (hQeq : Q = CFSG.Open.pCoreOf 2 N)
    (hyOrd : orderOf y = p) (hyN : y ∈ N)
    (hyCQ : y ∈ Subgroup.centralizer (Q : Set G)) : False := by
  have hyQmem : y ∈ Q := by
    rw [hQeq] at hyCQ ⊢
    exact D.standing.charTwo N hN ⟨hyN, hyCQ⟩
  have hpdvd : p ∣ Nat.card Q := by
    have h := orderOf_dvd_natCard (⟨y, hyQmem⟩ : Q)
    have h' : orderOf (⟨y, hyQmem⟩ : Q) = p := by
      rw [← Subgroup.orderOf_coe]
      exact hyOrd
    rwa [h'] at h
  obtain ⟨n, hn⟩ := hQ2.exists_card_eq
  have hp2 : p ∣ 2 := hp.dvd_of_dvd_pow (hn ▸ hpdvd)
  have hle : p ≤ 2 := Nat.le_of_dvd (by norm_num) hp2
  omega

private theorem le_centralizer_pCoreOf_large (F : A10Frame c) (hF : A10Facts F)
    {B V W Y N Q U : Subgroup G} {p : ℕ} (hp : p.Prime) (hp7 : 7 ≤ p)
    (hBA : B ≤ F.A) (hB3 : Nat.card B = 3) (hB9 : F.deg B = 9)
    (hV : UC22.InCalV D.M V) (hYA : Y ≤ F.A)
    (hno3 : ∀ a ∈ B ⊔ Y, F.deg (Subgroup.zpowers a) ≠ 3)
    (hN : CFSG.Open.IsTwoLocal N) (hQ2 : IsPGroup 2 Q)
    (hQeq : Q = CFSG.Open.pCoreOf 2 N)
    (hCY_N : Subgroup.centralizer (Y : Set G) ≤ N)
    (hWU : W ≤ U) (hWV : W ≤ V)
    (hWH : W ≤ Subgroup.centralizer (B : Set G))
    (hWCA : W ≤ Subgroup.centralizer (F.A : Set G))
    (hrel : ∀ w ∈ U, (Subgroup.centralizer ({w} : Set G)).relIndex Q ≤ 4) :
    W ≤ Subgroup.centralizer
      (CFSG.Open.pCoreOf p (Subgroup.centralizer (B : Set G)) : Set G) := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  let H : Subgroup G := Subgroup.centralizer (B : Set G)
  let X : Subgroup G := CFSG.Open.pCoreOf p H
  have hXH : X ≤ H := CFSG.LieType.BorelTits.pCoreOf_le p H
  have hXn : (X.subgroupOf H).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hXH).mpr
      (CFSG.LieType.BorelTits.le_normalizer_pCoreOf p H)
  have hHnorm : H ≤ Subgroup.normalizer (X : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hXH).mp hXn
  have hXCY : X ≤ Subgroup.centralizer (Y : Set G) :=
    F.pCoreOf_centralizer_le_centralizer hF hp (by omega) hBA hB3 hB9 hYA hno3
  have hXN : X ≤ N := hXCY.trans hCY_N
  have hW_CY : W ≤ Subgroup.centralizer (Y : Set G) :=
    hWCA.trans (Subgroup.centralizer_le hYA)
  have hWN : W ≤ N := hW_CY.trans hCY_N
  have hWQ : W ≤ Subgroup.normalizer (Q : Set G) := by
    rw [hQeq]
    exact hWN.trans (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 N)
  intro w hw
  rw [Subgroup.mem_centralizer_iff]
  intro x hx
  by_contra hxw
  have hact : ∃ h ∈ X, w * h ≠ h * w := ⟨x, hx, fun h => hxw h.symm⟩
  have ha2 : w ^ 2 = 1 := hV.2.2.2.2 w (hWV hw)
  have haP : ∀ h ∈ X, w * h * w⁻¹ ∈ X := fun h hh =>
    (Subgroup.mem_normalizer_iff.mp (hHnorm (hWH hw)) h).mp hh
  obtain ⟨i, hiX, hi1, hiInv⟩ :=
    CFSG.Quasithin.EmptyFaithfulMultiple.exists_inverted (P := X) (a := w) ha2 haP hact
  obtain ⟨y, hyZp, hyOrd, hyInv⟩ :=
    CFSG.Goldschmidt.G55.exists_orderOf_eq_prime_of_conj_eq_inv hp
      (CFSG.LieType.BorelTits.pCoreOf_isPGroup p H) hiX hi1 hiInv
  have hyX : y ∈ X := Subgroup.zpowers_le.mpr hiX hyZp
  have hyQ : y ∈ Subgroup.normalizer (Q : Set G) := by
    rw [hQeq]
    exact (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 N) (hXN hyX)
  have hidx : (Subgroup.centralizer ({w} : Set G)).relIndex Q ≤ 4 := hrel w (hWU hw)
  have hQy : Q ≤ Subgroup.centralizer ({y} : Set G) :=
    A10Gen.le_centralizer_of_inverts hp7 hQ2 hyQ (hWQ hw) hyOrd ha2 hyInv hidx
  have hyCQ : y ∈ Subgroup.centralizer (Q : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro q hq
    exact (Subgroup.mem_centralizer_iff.mp (hQy hq) y (by simp)).symm
  exact not_mem_of_centralizes_pCoreOf_two D hp hp7 hN hQ2 hQeq hyOrd (hXN hyX) hyCQ

private theorem le_centralizer_componentLayer
    (F : A10Frame c) (hF : A10Facts F)
    (hC : ∀ B ≤ F.A, Nat.card B = 3 →
      Subgroup.centralizer (B : Set G) ≤ (Subgroup.centralizer (B : Set G) ⊓ D.M) ⊔
        CFSG.Open.relPPrimeCore 3 (Subgroup.centralizer (B : Set G)))
    (hKPSz : CFSG.RankThree.PartTwo.KFacts.KPSz) {B V W : Subgroup G}
    (hBA : B ≤ F.A) (hB3 : Nat.card B = 3)
    (hO : CFSG.Open.pCoreOf 2 (Subgroup.centralizer (B : Set G)) = ⊥)
    (hV : UC22.InCalV D.M V) (hWV : W ≤ V)
    (hWH : W ≤ Subgroup.centralizer (B : Set G)) :
    W ≤ Subgroup.centralizer
      (CFSG.GorensteinWalter.componentLayerOf (Subgroup.centralizer (B : Set G)) : Set G) := by
  let H : Subgroup G := Subgroup.centralizer (B : Set G)
  let E : Subgroup G := CFSG.GorensteinWalter.componentLayerOf H
  have hEH : E ≤ H := (CFSG.GorensteinWalter.componentLayerOf_isNormalIn H).1
  have hEn : (E.subgroupOf H).Normal := inferInstance
  have hEM : E ≤ D.M := F.componentLayerOf_centralizer_le hF hC hKPSz hBA hB3 hO
  have hEV : E ≤ Subgroup.normalizer (V : Set G) := hEM.trans hV.2.2.1
  exact A10Gen.le_centralizer_of_pCoreOf_eq_bot hEH hEn hEV hV.2.2.2.isPGroup hWV hWH hO

private theorem le_centralizer_pCoreOf_all (F : A10Frame c) (hF : A10Facts F)
    {B V Y N Q U W : Subgroup G}
    (hBA : B ≤ F.A) (hB3 : Nat.card B = 3) (hB9 : F.deg B = 9)
    (hnot3 : ¬ CFSG.Open.relPPrimeCore 3 (Subgroup.centralizer (B : Set G)) ≤ D.M)
    (hO2 : CFSG.Open.pCoreOf 2 (Subgroup.centralizer (B : Set G)) = ⊥)
    (hV : UC22.InCalV D.M V) (hYA : Y ≤ F.A)
    (hno3 : ∀ a ∈ B ⊔ Y, F.deg (Subgroup.zpowers a) ≠ 3)
    (hN : CFSG.Open.IsTwoLocal N) (hQ2 : IsPGroup 2 Q)
    (hQeq : Q = CFSG.Open.pCoreOf 2 N)
    (hCY_N : Subgroup.centralizer (Y : Set G) ≤ N)
    (hWU : W ≤ U) (hWV : W ≤ V)
    (hWH : W ≤ Subgroup.centralizer (B : Set G))
    (hWCA : W ≤ Subgroup.centralizer (F.A : Set G))
    (hrel : ∀ w ∈ U, (Subgroup.centralizer ({w} : Set G)).relIndex Q ≤ 4) :
    ∀ p : ℕ, p.Prime →
      W ≤ Subgroup.centralizer
        (CFSG.Open.pCoreOf p (Subgroup.centralizer (B : Set G)) : Set G) := by
  intro p hp
  by_cases hp2 : p = 2
  · subst hp2
    rw [hO2]
    intro w hw
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    rw [Subgroup.mem_bot.mp hx, one_mul, mul_one]
  by_cases hp3 : p = 3
  · subst hp3
    exact le_centralizer_pCoreOf_three F hF hBA hB3 hB9 hO2 hV hWV hWH
  by_cases hp5 : p = 5
  · subst hp5
    have hcore : CFSG.Open.relPPrimeCore 3 (Subgroup.centralizer (B : Set G)) ≤
        Subgroup.centralizer (B : Set G) :=
      CFSG.LocalAnalysis.RankThreeTheoremC.KFactProofs.Stroth.AlmostSimple.relPPrimeCore_le
        (Subgroup.centralizer (B : Set G))
    have hHM : ¬ Subgroup.centralizer (B : Set G) ≤ D.M := fun h => hnot3 (hcore.trans h)
    have hbot : CFSG.Open.pCoreOf 5 (Subgroup.centralizer (B : Set G)) = ⊥ :=
      F.pCoreOf_five_centralizer_eq_bot (B := B) hBA hB3 hHM
    rw [hbot]
    intro w hw
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    rw [Subgroup.mem_bot.mp hx, one_mul, mul_one]
  · have hp7 : 7 ≤ p := by
      have hge : 2 ≤ p := hp.two_le
      have hmod : p % 2 = 1 := (hp.eq_two_or_odd).resolve_left hp2
      omega
    exact le_centralizer_pCoreOf_large F hF hp hp7 hBA hB3 hB9 hV hYA hno3
      hN hQ2 hQeq hCY_N hWU hWV hWH hWCA hrel

theorem false_of_a10Frame
    (F : A10Frame c)
    (hF : A10Facts F)
    (hC : ∀ B ≤ F.A, Nat.card B = 3 →
      Subgroup.centralizer (B : Set G) ≤ (Subgroup.centralizer (B : Set G) ⊓ D.M) ⊔
        CFSG.Open.relPPrimeCore 3 (Subgroup.centralizer (B : Set G)))
    (hStar : KFactE27Signalizer) (hKPSz : CFSG.RankThree.PartTwo.KFacts.KPSz)
    (h639 : PartTwo.R6_39 D) : False := by
  classical
  obtain ⟨B, hBA, hB3, hB9, hnot3, hO2⟩ :=
    F.exists_pCoreOf_centralizer_eq_bot hF hC hStar hKPSz
  obtain ⟨V, hVstar⟩ := exists_inCalVStar (D := D)
  have hVA : ¬ F.A ≤ Subgroup.centralizer (V : Set G) :=
    F.not_le_centralizer_of_inCalVStar h639 hVstar
  obtain ⟨e, heA, he1, hne, hno3⟩ :=
    exists_hyperplane_not_le_centralizer F hVstar.1 hVA hBA hB3 hB9
  obtain ⟨N, Q, U, hN2, hQ2, hQeq, hAQ, hUV, hUne, hLU, hrel, hCY_N⟩ :=
    exists_twoLocal_data F hF hC hKPSz hVstar.1 heA he1 hne
  let Y : Subgroup G := Subgroup.zpowers e
  let H : Subgroup G := Subgroup.centralizer (B : Set G)
  let W : Subgroup G := U ⊓ H
  have hYleA : Y ≤ F.A := Subgroup.zpowers_le.mpr heA
  have hV2 : IsPGroup 2 V := hVstar.1.2.2.2.isPGroup
  have hU2 : IsPGroup 2 U := hV2.to_le hUV
  have hWne : W ≠ ⊥ := F.inf_centralizer_ne_bot_of_deg_nine hU2 hUne hLU hBA hB3 hB9
  have hE : CFSG.GorensteinWalter.componentLayerOf H ≤ D.M :=
    F.componentLayerOf_centralizer_le hF hC hKPSz hBA hB3 hO2
  have hWCA : W ≤ Subgroup.centralizer (F.A : Set G) :=
    (le_inf (inf_le_left.trans hUV) inf_le_right).trans
      (F.inf_centralizer_le_centralizer_A hF hVstar.1 hBA hB3 hO2 hE)
  have hWH : W ≤ H := inf_le_right
  have hWV : W ≤ V := inf_le_left.trans hUV
  have hWU : W ≤ U := inf_le_left
  have hW2 : IsPGroup 2 W := hV2.to_le hWV
  have hpCore : ∀ p : ℕ, p.Prime →
      W ≤ Subgroup.centralizer (CFSG.Open.pCoreOf p H : Set G) :=
    le_centralizer_pCoreOf_all F hF hBA hB3 hB9 hnot3 hO2 hVstar.1 hYleA hno3
      hN2 hQ2 hQeq hCY_N hWU hWV hWH hWCA hrel
  have hWcomp : W ≤ Subgroup.centralizer
      (CFSG.GorensteinWalter.componentLayerOf H : Set G) :=
    le_centralizer_componentLayer F hF hC hKPSz hBA hB3 hO2 hVstar.1 hWV hWH
  exact hWne (A10Gen.eq_bot_of_le_centralizer_pCoreOf hW2 hWH hO2 hpCore hWcomp)

theorem false_of_inputs
    (F : A10Frame c)
    (hF : A10Facts F) (hK : UC22.InS3.UC326.K326P2S)
    (hKPSz : CFSG.RankThree.PartTwo.KFacts.KPSz) (hI : A10EndInputs D) : False :=
  F.false_of_a10Frame hF (fun _ hBA hB3 => F.centralizer_le_of_card_eq_three hF hK hBA hB3)
    (kFactE27Signalizer_of_layer hI.star) hKPSz hI.r639

