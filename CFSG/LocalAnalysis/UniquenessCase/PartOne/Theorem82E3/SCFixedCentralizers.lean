theorem normalizer_S_le_normalizer_AA (d : SylowThreeData G) :
    normalizer (d.S : Set G) ≤ normalizer (d.AA : Set G) := by
    intro g hg
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    apply Subgroup.eq_of_le_of_card_ge
    · rintro a ⟨x, hx, rfl⟩
      apply d.mem_AA_of_pow_eq_one
      · have hmap := Subgroup.mem_normalizer_iff_map_conj_eq.mp hg
        rw [← hmap]
        exact ⟨x, d.AA_le_S hx, rfl⟩
      · rw [← map_pow, d.isElemAbelian_AA.2 x hx, map_one]
    · rw [Subgroup.card_map_of_injective (MulAut.conj g).injective]

theorem map_axis_eq_of_mem_normalizer_S
    (d : SylowThreeData G) (hinj : Function.Injective d.Lf)
    (hperm : ∀ m ∈ d.M, ∀ i, ∃ j, (d.Lf i).map (MulAut.conj m).toMonoidHom = d.Lf j)
    {m : G} (hmM : m ∈ d.M) (hmS : m ∈ normalizer (d.S : Set G)) (i : Fin 3) :
    (d.A i).map (MulAut.conj m).toMonoidHom = d.A (d.permHom hinj hperm ⟨m, hmM⟩ i) := by
  have hAAmap : d.AA.map (MulAut.conj m).toMonoidHom = d.AA :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp (normalizer_S_le_normalizer_AA d hmS)
  rw [d.A_eq_AA_inf_Lf i, Subgroup.map_inf _ _ _ (MulAut.conj m).injective,
    hAAmap, d.map_conj_Lf_eq hinj hperm ⟨m, hmM⟩ i]
  exact (d.A_eq_AA_inf_Lf _).symm

theorem mem_centralizer_axis_of_fullSupport
    (d : SylowThreeData G) {B : Subgroup G} (hBA : B ≤ d.AA) (hB3 : Nat.card B = 3)
    (hfull : ∀ i j : Fin 3, i ≠ j → ¬ B ≤ d.A i ⊔ d.A j)
    {w : G} (hwB : w ∈ centralizer (B : Set G))
    (π : Equiv.Perm (Fin 3))
    (hπ : ∀ i, (d.A i).map (MulAut.conj w).toMonoidHom = d.A (π i))
    {k : Fin 3} (hfix : π k = k) : w ∈ centralizer (d.A k : Set G) := by
  classical
  obtain ⟨i, j, hij, hik, hjk⟩ : ∃ i j : Fin 3, i ≠ j ∧ i ≠ k ∧ j ≠ k := by
    fin_cases k <;> decide
  have hA : ∀ t, d.A t ≤ d.AA := fun t => by
    rw [d.A_eq_AA_inf_Lf t]
    exact inf_le_left
  have hAA : d.AA = d.A k ⊔ (d.A i ⊔ d.A j) := by
    apply le_antisymm
    · rw [d.AA_def]
      have hall : ∀ (i j k : Fin 3), i ≠ j → i ≠ k → j ≠ k →
          ∀ t : Fin 3, t = k ∨ t = i ∨ t = j := by decide
      have hcover := hall i j k hij hik hjk
      have hm : ∀ t, d.A t ≤ d.A k ⊔ (d.A i ⊔ d.A j) := by
        intro t
        rcases hcover t with h | h | h
        · rw [h]; exact le_sup_left
        · rw [h]; exact le_sup_left.trans le_sup_right
        · rw [h]; exact le_sup_right.trans le_sup_right
      exact sup_le (sup_le (hm 0) (hm 1)) (hm 2)
    · exact sup_le (hA k) (sup_le (hA i) (hA j))
  have hBne : B ≠ ⊥ := by intro h; rw [h, Subgroup.card_bot] at hB3; norm_num at hB3
  obtain ⟨b0, hb0⟩ := (Subgroup.ne_bot_iff_exists_ne_one (H := B)).mp hBne
  let b : G := b0
  have hbB : b ∈ B := b0.2
  have hbA : b ∈ d.AA := hBA hbB
  have hb1 : b ≠ 1 := fun h => hb0 (Subtype.ext h)
  have hb3 : b ^ 3 = 1 := d.isElemAbelian_AA.2 b hbA
  have hBgen : zpowers b = B :=
    Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hbB)
      (by rw [Nat.card_zpowers, orderOf_eq_prime hb3 hb1, hB3])
  have hbAA : b ∈ d.A k ⊔ (d.A i ⊔ d.A j) := by rwa [← hAA]
  obtain ⟨a, ha, c, hc, hac⟩ := CFSG.GroupTheory.exists_mul_of_mem_sup_of_commute
    (fun a ha c hc => d.S_commute a c (d.A_le_S k ha)
      (d.AA_le_S ((sup_le (hA i) (hA j)) hc))) hbAA
  have ha1 : a ≠ 1 := by
    intro haone
    have hbplane : b ∈ d.A i ⊔ d.A j := by rw [← hac, haone, one_mul]; exact hc
    exact hfull i j hij (by rw [← hBgen]; exact zpowers_le.mpr hbplane)
  have ha3 : a ^ 3 = 1 := d.isElemAbelian_AA.2 a (hA k ha)
  have hagen : zpowers a = d.A k :=
    Subgroup.eq_of_le_of_card_ge (zpowers_le.mpr ha)
      (by rw [Nat.card_zpowers, orderOf_eq_prime ha3 ha1, d.card_A k])
  have hother : ∀ t : Fin 3, t ≠ k → t = i ∨ t = j := by
    intro t htk
    have hneij : i.val ≠ j.val := fun h => hij (Fin.ext h)
    have hneik : i.val ≠ k.val := fun h => hik (Fin.ext h)
    have hnejk : j.val ≠ k.val := fun h => hjk (Fin.ext h)
    have hnetk : t.val ≠ k.val := fun h => htk (Fin.ext h)
    have ht : t.val = i.val ∨ t.val = j.val := by omega
    exact ht.elim (fun h => Or.inl (Fin.ext h)) (fun h => Or.inr (Fin.ext h))
  have hπne : ∀ t, t ≠ k → π t ≠ k := by
    intro t ht he
    exact ht (π.injective (he.trans hfix.symm))
  have hmapPlane : (d.A i ⊔ d.A j).map (MulAut.conj w).toMonoidHom ≤ d.A i ⊔ d.A j := by
    rw [Subgroup.map_sup, hπ i, hπ j]
    have hh : ∀ t, t ≠ k → d.A (π t) ≤ d.A i ⊔ d.A j := by
      intro t ht
      rcases hother (π t) (hπne t ht) with h | h
      · rw [h]; exact le_sup_left
      · rw [h]; exact le_sup_right
    exact sup_le (hh i hik) (hh j hjk)
  have haw : (MulAut.conj w) a ∈ d.A k := by
    have h := Subgroup.mem_map_of_mem (MulAut.conj w).toMonoidHom ha
    rwa [hπ k, hfix] at h
  have hcw : (MulAut.conj w) c ∈ d.A i ⊔ d.A j :=
    hmapPlane (Subgroup.mem_map_of_mem (MulAut.conj w).toMonoidHom hc)
  have hbfix : (MulAut.conj w) b = b := by
    change w * b * w⁻¹ = b
    rw [← Subgroup.mem_centralizer_iff.mp hwB b hbB, mul_assoc, mul_inv_cancel, mul_one]
  have hprod : (MulAut.conj w) a * (MulAut.conj w) c = a * c := by
    calc (MulAut.conj w) a * (MulAut.conj w) c = (MulAut.conj w) (a * c) := (map_mul (MulAut.conj w) a c).symm
      _ = (MulAut.conj w) b := congrArg (MulAut.conj w) hac
      _ = b := hbfix
      _ = a * c := hac.symm
  have hdelta : a⁻¹ * (MulAut.conj w) a = c * ((MulAut.conj w) c)⁻¹ := by
    calc a⁻¹ * (MulAut.conj w) a
        = a⁻¹ * ((MulAut.conj w) a * (MulAut.conj w) c) * ((MulAut.conj w) c)⁻¹ := by group
      _ = a⁻¹ * (a * c) * ((MulAut.conj w) c)⁻¹ := by rw [hprod]
      _ = c * ((MulAut.conj w) c)⁻¹ := by group
  have hxA : a⁻¹ * (MulAut.conj w) a ∈ d.A k := (d.A k).mul_mem ((d.A k).inv_mem ha) haw
  have hxplane : a⁻¹ * (MulAut.conj w) a ∈ d.A i ⊔ d.A j := by
    rw [hdelta]
    exact (d.A i ⊔ d.A j).mul_mem hc ((d.A i ⊔ d.A j).inv_mem hcw)
  have hx1 := d.eq_one_of_mem_Lf_of_mem_sup hik.symm hjk.symm hij
    (d.A_le_S k hxA) ((d.A_le_H k).trans (d.H_le_Lf k) hxA)
    ((sup_le ((d.A_le_H i).trans (d.H_le_Lf i) |>.trans le_sup_left)
      ((d.A_le_H j).trans (d.H_le_Lf j) |>.trans le_sup_right)) hxplane)
  have hawfix : (MulAut.conj w) a = a := (inv_mul_eq_one.mp hx1).symm
  have hacom : Commute a w := by
    change a * w = w * a
    have hh : w * a * w⁻¹ = a := hawfix
    rw [mul_inv_eq_iff_eq_mul] at hh
    exact hh.symm
  rw [← hagen, Subgroup.mem_centralizer_iff]
  intro x hx
  obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
  exact (hacom.zpow_left m).eq

theorem exists_axis_centralized_by_fullSupport_sylow_normalizer
    (d : SylowThreeData G) (hinj : Function.Injective d.Lf)
    (hperm : ∀ m ∈ d.M, ∀ i, ∃ j, (d.Lf i).map (MulAut.conj m).toMonoidHom = d.Lf j)
    (hS : CFSG.ABGLocalTools.IsSylowOf 3 d.S ⊤)
    (hNA : normalizer (d.AA : Set G) ≤ d.M)
    {B : Subgroup G} (hBA : B ≤ d.AA) (hB3 : Nat.card B = 3)
    (hfull : ∀ i j : Fin 3, i ≠ j → ¬ B ≤ d.A i ⊔ d.A j) :
    ∃ k : Fin 3, centralizer (B : Set G) ⊓ normalizer (d.S : Set G) ≤
      centralizer (d.A k : Set G) := by
  classical
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hNS := normalizer_S_le_normalizer_AA d
  let W : Subgroup G := centralizer (B : Set G) ⊓ normalizer (d.S : Set G)
  have hWM : W ≤ d.M := inf_le_right.trans (hNS.trans hNA)
  let φ : W →* Equiv.Perm (Fin 3) :=
    (d.permHom hinj hperm).comp (Subgroup.inclusion hWM)
  have hSW : d.S ≤ W := by
    refine le_inf ?_ Subgroup.le_normalizer
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    exact d.S_commute b a (d.AA_le_S (hBA hb)) ha
  have hSinj : Function.Injective (fun k : Fin 3 => (d.A k).subgroupOf d.AA) :=
    (d.exists_four_full_support_lines).1
  have hcompat : ∀ (w : W) (i : Fin 3),
      (d.A i).map (MulAut.conj (w : G)).toMonoidHom = d.A (φ w i) := by
    intro w i
    have hAAmap : d.AA.map (MulAut.conj (w : G)).toMonoidHom = d.AA :=
      Subgroup.mem_normalizer_iff_map_conj_eq.mp (hNS w.2.2)
    rw [d.A_eq_AA_inf_Lf i, Subgroup.map_inf _ _ _ (MulAut.conj (w : G)).injective,
      hAAmap, d.map_conj_Lf_eq hinj hperm ⟨(w : G), hWM w.2⟩ i]
    exact (d.A_eq_AA_inf_Lf (φ w i)).symm
  have hSK : d.S.subgroupOf W ≤ φ.ker := by
    intro x hx
    rw [MonoidHom.mem_ker]
    apply Equiv.ext
    intro i
    have hmap : (d.A i).map (MulAut.conj (x : G)).toMonoidHom = d.A i := by
      apply Subgroup.mem_normalizer_iff_map_conj_eq.mp
      apply Subgroup.centralizer_le_normalizer (d.A i : Set G)
      rw [Subgroup.mem_centralizer_iff]
      intro a ha
      exact d.S_commute a x (d.A_le_S i ha) hx
    apply hSinj
    have he := (hcompat x i).symm.trans hmap
    exact congrArg (fun H : Subgroup G => H.subgroupOf d.AA) he
  have hSylW := hS.of_le hSW le_top
  have hno3 : ¬ 3 ∣ (d.S.subgroupOf W).index := by
    simpa [Subgroup.relIndex] using (CFSG.ABGLocalTools.isSylowOf_iff.mp hSylW).2.2
  have hno3φ : ¬ 3 ∣ Nat.card φ.range := by
    intro hd
    have hker : 3 ∣ φ.ker.index := (Subgroup.index_ker φ).symm ▸ hd
    exact hno3 (hker.trans (Subgroup.index_dvd_of_le hSK))
  have h6 : Nat.card φ.range ∣ 6 := by
    have hh := Subgroup.card_subgroup_dvd_card φ.range
    have hpermCard : Nat.card (Equiv.Perm (Fin 3)) = 6 := by
      rw [Nat.card_perm, Nat.card_eq_fintype_card, Fintype.card_fin]
      norm_num
    rwa [hpermCard] at hh
  have h2 : Nat.card φ.range ∣ 2 := by
    have hcop : Nat.Coprime (Nat.card φ.range) 3 :=
      ((Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr hno3φ).symm
    exact hcop.dvd_mul_right.mp (show Nat.card φ.range ∣ 2 * 3 by simpa using h6)
  have hφtwo : IsPGroup 2 φ.range := IsPGroup.of_card_dvd_pow (n := 1) (by simpa using h2)
  obtain ⟨k, hk⟩ := hφtwo.nonempty_fixed_point_of_prime_not_dvd_card
    (Fin 3) (by norm_num)
  refine ⟨k, ?_⟩
  intro w hw
  have hfix : φ ⟨w, hw⟩ k = k := by
    have hh := MulAction.mem_fixedPoints.mp hk (⟨φ ⟨w, hw⟩, ⟨⟨w, hw⟩, rfl⟩⟩ : φ.range)
    simpa [Subgroup.smul_def, Equiv.Perm.smul_def] using hh
  exact mem_centralizer_axis_of_fullSupport d hBA hB3 hfull hw.1
    (φ ⟨w, hw⟩) (hcompat ⟨w, hw⟩) hfix

theorem fullSupport_centralizer_factorization_of_sylow
    (d : SylowThreeData G) (hinj : Function.Injective d.Lf)
    (hperm : ∀ m ∈ d.M, ∀ i, ∃ j, (d.Lf i).map (MulAut.conj m).toMonoidHom = d.Lf j)
    (hS : CFSG.ABGLocalTools.IsSylowOf 3 d.S ⊤)
    (hrank : CFSG.Open.pRank 3 d.S ≤ 3)
    (hNA : normalizer (d.AA : Set G) ≤ d.M)
    (hAxis : ∀ i, centralizer (d.A i : Set G) ≤ d.M)
    (hK332 : CFSG.LocalAnalysis.UniquenessCase.UCK.K332ThreeAb)
    {B : Subgroup G} (hBA : B ≤ d.AA) (hB3 : Nat.card B = 3)
    (hfull : ∀ i j : Fin 3, i ≠ j → ¬ B ≤ d.A i ⊔ d.A j)
    (hK : CFSG.Open.IsKGroup ↥(centralizer (B : Set G))) :
    let H : Subgroup G := centralizer (B : Set G)
    H = (H ⊓ d.M) ⊔ (CFSG.pPrimeCore 3 ↥H).map H.subtype := by
  classical
  obtain ⟨k, hk⟩ := exists_axis_centralized_by_fullSupport_sylow_normalizer
    d hinj hperm hS hNA hBA hB3 hfull
  let H : Subgroup G := centralizer (B : Set G)
  have hSH : d.S ≤ H := by
    intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    exact d.S_commute b x (d.AA_le_S (hBA hb)) hx
  have hAH : d.AA ≤ H := d.AA_le_S.trans hSH
  have hA : ∀ i, d.A i ≤ d.AA := fun i => by
    rw [d.A_eq_AA_inf_Lf i]
    exact inf_le_left
  let T : Subgroup H := d.S.subgroupOf H
  let Z : Subgroup H := (d.A k).subgroupOf H
  have hAkH : d.A k ≤ H := (hA k).trans hAH
  have hT : CFSG.ABGLocalTools.IsSylowOf 3 T ⊤ := by
    rw [← CFSG.ABGLocalTools.isSylowOf_map_subtype_iff (K := H)]
    rw [show T.map H.subtype = d.S from Subgroup.map_subgroupOf_eq_of_le hSH,
      Subgroup.map_top, Subgroup.range_subtype]
    exact hS.of_le hSH le_top
  have hTab : ∀ x ∈ T, ∀ y ∈ T, x * y = y * x := by
    intro x hx y hy
    apply Subtype.ext
    exact d.S_commute x y hx hy
  have hTr : CFSG.Open.pRank 3 T ≤ 3 := by
    rw [← CFSG.SectionRank.pRank_coe_eq_openPRank 3 T,
      CFSG.pRank_congr_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hSH) 3,
      CFSG.SectionRank.pRank_coe_eq_openPRank 3 d.S]
    exact hrank
  have hZT : Z ≤ T := Subgroup.subgroupOf_mono H (d.A_le_S k)
  have hZ3 : Nat.card Z = 3 := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAkH).toEquiv, d.card_A k]
  have hTZ : normalizer (T : Set H) ≤ centralizer (Z : Set H) := by
    intro x hx
    have hxS : (x : G) ∈ normalizer (d.S : Set G) := by
      have hx' : x ∈ normalizer ((d.S.subgroupOf H) : Set H) := hx
      rw [← Subgroup.subgroupOf_normalizer_eq hSH] at hx'
      exact hx'
    have hxAk := hk ⟨x.2, hxS⟩
    rw [Subgroup.mem_centralizer_iff]
    intro z hz
    apply Subtype.ext
    exact Subgroup.mem_centralizer_iff.mp hxAk (z : G) hz
  have hfac := centralizer_sup_pPrimeCore_eq_top_of_abelian_sylow_normalizer
    hK332 hK hT hTab hTr hZT hZ3 hTZ
  have hCM : centralizer (Z : Set H) ≤ d.M.subgroupOf H := by
    intro x hx
    apply hAxis k
    rw [Subgroup.mem_centralizer_iff]
    intro a ha
    exact congrArg Subtype.val (Subgroup.mem_centralizer_iff.mp hx ⟨a, hAkH ha⟩ ha)
  have htop : d.M.subgroupOf H ⊔ CFSG.pPrimeCore 3 H = ⊤ := by
    apply top_le_iff.mp
    rw [← hfac]
    exact sup_le (hCM.trans le_sup_left) le_sup_right
  have hmap := congrArg (fun J : Subgroup H => J.map H.subtype) htop
  rw [Subgroup.map_sup, Subgroup.subgroupOf_map_subtype, inf_comm d.M H,
    Subgroup.map_top, Subgroup.range_subtype] at hmap
  exact hmap.symm


theorem perm_fixes_complement_of_supportTwo
    (d : SylowThreeData G) {i j k : Fin 3} (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k)
    {B : Subgroup G} (hB : B ≤ d.A i ⊔ d.A j) (hB3 : Nat.card B = 3)
    (hBi : B ≠ d.A i) (hBj : B ≠ d.A j)
    {w : G} (hwB : w ∈ centralizer (B : Set G))
    (π : Equiv.Perm (Fin 3))
    (hπ : ∀ t, (d.A t).map (MulAut.conj w).toMonoidHom = d.A (π t)) : π k = k := by
  classical
  have hA : ∀ t, d.A t ≤ d.AA := fun t => by
    rw [d.A_eq_AA_inf_Lf t]
    exact inf_le_left
  obtain ⟨e, haxis, hplane⟩ := d.exists_axis_coordinates
  have hinf : (d.A i ⊔ d.A j) ⊓ (d.A i ⊔ d.A k) = d.A i := by
    have h := inf_plane_eq_axis_G hA haxis hplane hij.symm hjk hik
    simpa [sup_comm] using h
  have hinf' : (d.A i ⊔ d.A j) ⊓ (d.A j ⊔ d.A k) = d.A j :=
    inf_plane_eq_axis_G hA haxis hplane hij hik hjk
  have hBfix : B.map (MulAut.conj w).toMonoidHom = B := by
    exact Subgroup.mem_normalizer_iff_map_conj_eq.mp
      (Subgroup.centralizer_le_normalizer (B : Set G) hwB)
  have hBimage : B ≤ d.A (π i) ⊔ d.A (π j) := by
    have h := Subgroup.map_mono (f := (MulAut.conj w).toMonoidHom) hB
    rwa [hBfix, Subgroup.map_sup, hπ i, hπ j] at h
  by_contra hne
  have htable : ∀ (i j k : Fin 3) (π : Equiv.Perm (Fin 3)),
      i ≠ j → i ≠ k → j ≠ k → π k ≠ k →
      (π i = i ∧ π j = k) ∨ (π i = k ∧ π j = i) ∨
      (π i = j ∧ π j = k) ∨ (π i = k ∧ π j = j) := by decide
  rcases htable i j k π hij hik hjk hne with h | h | h | h
  · rw [h.1, h.2] at hBimage
    have hb : B ≤ d.A i := by rw [← hinf]; exact le_inf hB hBimage
    exact hBi (Subgroup.eq_of_le_of_card_ge hb (by rw [hB3, d.card_A i]))
  · rw [h.1, h.2, sup_comm (d.A k) (d.A i)] at hBimage
    have hb : B ≤ d.A i := by rw [← hinf]; exact le_inf hB hBimage
    exact hBi (Subgroup.eq_of_le_of_card_ge hb (by rw [hB3, d.card_A i]))
  · rw [h.1, h.2] at hBimage
    have hb : B ≤ d.A j := by rw [← hinf']; exact le_inf hB hBimage
    exact hBj (Subgroup.eq_of_le_of_card_ge hb (by rw [hB3, d.card_A j]))
  · rw [h.1, h.2, sup_comm (d.A k) (d.A j)] at hBimage
    have hb : B ≤ d.A j := by rw [← hinf']; exact le_inf hB hBimage
    exact hBj (Subgroup.eq_of_le_of_card_ge hb (by rw [hB3, d.card_A j]))

theorem normalizes_diagonal_of_supportTwo
    (d : SylowThreeData G) {i j k : Fin 3} (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k)
    {a c w : G} (ha : a ∈ d.A i) (hc : c ∈ d.A j)
    (hw : (MulAut.conj w) (a * c) = a * c)
    (π : Equiv.Perm (Fin 3)) (hfix : π k = k)
    (hπ : ∀ t, (d.A t).map (MulAut.conj w).toMonoidHom = d.A (π t)) :
    w ∈ normalizer (zpowers (a * c⁻¹) : Set G) := by
  classical
  have htable : ∀ (i j k : Fin 3) (π : Equiv.Perm (Fin 3)),
      i ≠ j → i ≠ k → j ≠ k → π k = k →
      (π i = i ∧ π j = j) ∨ (π i = j ∧ π j = i) := by decide
  have hdisj : Disjoint (d.A i) (d.A j) := by
    rw [Subgroup.disjoint_def]
    intro x hx hx'
    exact d.eq_one_of_mem_Lf_of_mem_sup hij hik hjk (d.A_le_S i hx)
      ((d.A_le_H i).trans (d.H_le_Lf i) hx)
      (Subgroup.mem_sup_left ((d.A_le_H j).trans (d.H_le_Lf j) hx'))
  have hwa : (MulAut.conj w) a ∈ d.A (π i) := by
    have h := Subgroup.mem_map_of_mem (MulAut.conj w).toMonoidHom ha
    rwa [hπ i] at h
  have hwc : (MulAut.conj w) c ∈ d.A (π j) := by
    have h := Subgroup.mem_map_of_mem (MulAut.conj w).toMonoidHom hc
    rwa [hπ j] at h
  have hprod : (MulAut.conj w) a * (MulAut.conj w) c = a * c :=
    (map_mul (MulAut.conj w) a c).symm.trans hw
  rw [Subgroup.mem_normalizer_iff_map_conj_eq, MonoidHom.map_zpowers]
  change zpowers ((MulAut.conj w) (a * c⁻¹)) = zpowers (a * c⁻¹)
  rcases htable i j k π hij hik hjk hfix with h | h
  · rw [h.1] at hwa
    rw [h.2] at hwc
    obtain ⟨ha', hc'⟩ := CFSG.RankThree.PartTwo.Sec13.L3Proof.eq_and_eq_of_mul_eq
      hdisj hwa ha hwc hc hprod
    have hh : (MulAut.conj w) (a * c⁻¹) = a * c⁻¹ := by rw [map_mul, map_inv, ha', hc']
    rw [hh]
  · rw [h.1] at hwa
    rw [h.2] at hwc
    have hprod' : (MulAut.conj w) c * (MulAut.conj w) a = a * c := by
      rw [d.S_commute _ _ (d.A_le_S j hwa) (d.A_le_S i hwc)] at hprod
      exact hprod
    obtain ⟨hc', ha'⟩ := CFSG.RankThree.PartTwo.Sec13.L3Proof.eq_and_eq_of_mul_eq
      hdisj hwc ha hwa hc hprod'
    have hh : (MulAut.conj w) (a * c⁻¹) = (a * c⁻¹)⁻¹ := by
      calc (MulAut.conj w) (a * c⁻¹) = c * a⁻¹ := by rw [map_mul, map_inv, ha', hc']
        _ = (a * c⁻¹)⁻¹ := by group
    rw [hh, Subgroup.zpowers_inv]

theorem exists_generators_of_supportTwo
    (d : SylowThreeData G) {i j : Fin 3}
    {B : Subgroup G} (hB : B ≤ d.A i ⊔ d.A j) (hB3 : Nat.card B = 3)
    (hBi : B ≠ d.A i) (hBj : B ≠ d.A j) :
    ∃ a ∈ d.A i, ∃ c ∈ d.A j, a ≠ 1 ∧ c ≠ 1 ∧ zpowers (a * c) = B := by
  classical
  have hBne : B ≠ ⊥ := by intro h; rw [h, Subgroup.card_bot] at hB3; norm_num at hB3
  obtain ⟨b, hb⟩ := (Subgroup.ne_bot_iff_exists_ne_one (H := B)).mp hBne
  obtain ⟨a, ha, c, hc, heq⟩ := CFSG.GroupTheory.exists_mul_of_mem_sup_of_commute
    (fun a ha c hc => d.S_commute a c (d.A_le_S i ha) (d.A_le_S j hc)) (hB b.2)
  have hA : ∀ t, d.A t ≤ d.AA := fun t => by
    rw [d.A_eq_AA_inf_Lf t]
    exact inf_le_left
  have hb1 : (b : G) ≠ 1 := fun h => hb (Subtype.ext h)
  have hb3 : (b : G) ^ 3 = 1 := d.isElemAbelian_AA.2 b
    ((sup_le (hA i) (hA j)) (hB b.2))
  have hgen : zpowers (b : G) = B := Subgroup.eq_of_le_of_card_ge
    (zpowers_le.mpr b.2) (by rw [Nat.card_zpowers, orderOf_eq_prime hb3 hb1, hB3])
  have ha1 : a ≠ 1 := by
    intro hone
    have hbc : (b : G) ∈ d.A j := by rw [← heq, hone, one_mul]; exact hc
    have hle : B ≤ d.A j := by rw [← hgen]; exact zpowers_le.mpr hbc
    exact hBj (Subgroup.eq_of_le_of_card_ge hle (by rw [hB3, d.card_A j]))
  have hc1 : c ≠ 1 := by
    intro hone
    have hba : (b : G) ∈ d.A i := by rw [← heq, hone, mul_one]; exact ha
    have hle : B ≤ d.A i := by rw [← hgen]; exact zpowers_le.mpr hba
    exact hBi (Subgroup.eq_of_le_of_card_ge hle (by rw [hB3, d.card_A i]))
  exact ⟨a, ha, c, hc, ha1, hc1, heq ▸ hgen⟩

theorem plane_eq_line_sup_diagonal
    (d : SylowThreeData G) {i j : Fin 3}
    {a c : G} (ha : a ∈ d.A i) (hc : c ∈ d.A j) (ha1 : a ≠ 1) (hc1 : c ≠ 1) :
    d.A i ⊔ d.A j = zpowers (a * c) ⊔ zpowers (a * c⁻¹) := by
  have hA : ∀ t, d.A t ≤ d.AA := fun t => by
    rw [d.A_eq_AA_inf_Lf t]
    exact inf_le_left
  have ha3 : a ^ 3 = 1 := d.isElemAbelian_AA.2 a (hA i ha)
  have hc3 : c ^ 3 = 1 := d.isElemAbelian_AA.2 c (hA j hc)
  have hagen : zpowers a = d.A i := Subgroup.eq_of_le_of_card_ge (zpowers_le.mpr ha)
    (by rw [Nat.card_zpowers, orderOf_eq_prime ha3 ha1, d.card_A i])
  have hcgen : zpowers c = d.A j := Subgroup.eq_of_le_of_card_ge (zpowers_le.mpr hc)
    (by rw [Nat.card_zpowers, orderOf_eq_prime hc3 hc1, d.card_A j])
  have hcomm : Commute a c := d.S_commute a c (d.A_le_S i ha) (d.A_le_S j hc)
  let J : Subgroup G := zpowers (a * c) ⊔ zpowers (a * c⁻¹)
  have hab : a * c ∈ J := Subgroup.mem_sup_left (mem_zpowers _)
  have habi : a * c⁻¹ ∈ J := Subgroup.mem_sup_right (mem_zpowers _)
  have haSq : a * a = a⁻¹ := by
    apply eq_inv_of_mul_eq_one_left
    simpa [pow_succ, mul_assoc] using ha3
  have hprod : (a * c) * (a * c⁻¹) = a⁻¹ := by
    rw [mul_assoc a c (a * c⁻¹), ← mul_assoc c a c⁻¹, ← hcomm.eq]
    calc a * (a * c * c⁻¹) = a * a := by group
      _ = a⁻¹ := haSq
  have haJ : a ∈ J := by
    have hh := J.mul_mem hab habi
    rw [hprod] at hh
    simpa using J.inv_mem hh
  have hcJ : c ∈ J := by
    have hh := J.mul_mem (J.inv_mem haJ) hab
    simpa [mul_assoc] using hh
  apply le_antisymm
  · rw [← hagen, ← hcgen]
    exact sup_le (zpowers_le.mpr haJ) (zpowers_le.mpr hcJ)
  · exact sup_le (zpowers_le.mpr (Subgroup.mul_mem_sup ha hc))
      (zpowers_le.mpr (Subgroup.mul_mem_sup ha ((d.A j).inv_mem hc)))

theorem supportTwo_centralizer_factorization_of_sylow
    (d : SylowThreeData G) (hinj : Function.Injective d.Lf)
    (hperm : ∀ m ∈ d.M, ∀ i, ∃ j, (d.Lf i).map (MulAut.conj m).toMonoidHom = d.Lf j)
    (hrank : CFSG.Open.pRank 3 d.S ≤ 3)
    (hNA : normalizer (d.AA : Set G) ≤ d.M)
    (hAxis : ∀ i, centralizer (d.A i : Set G) ≤ d.M)
    (hK332 : CFSG.LocalAnalysis.UniquenessCase.UCK.K332ThreeAb)
    {i j : Fin 3} (hij : i ≠ j) {B : Subgroup G}
    (hB : B ≤ d.A i ⊔ d.A j) (hB3 : Nat.card B = 3)
    (hBi : B ≠ d.A i) (hBj : B ≠ d.A j)
    (hK : CFSG.Open.IsKGroup ↥(centralizer (B : Set G)))
    (hS : IsSylowOf 3 d.S (centralizer (B : Set G))) :
    let H : Subgroup G := centralizer (B : Set G)
    H = (H ⊓ d.M) ⊔ (CFSG.pPrimeCore 3 ↥H).map H.subtype := by
  classical
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨k, hik, hjk⟩ : ∃ k : Fin 3, i ≠ k ∧ j ≠ k := by
    have ht : ∀ (i j : Fin 3), i ≠ j → ∃ k : Fin 3, i ≠ k ∧ j ≠ k := by decide
    exact ht i j hij
  obtain ⟨a, ha, c, hc, ha1, hc1, hgen⟩ := exists_generators_of_supportTwo d hB hB3 hBi hBj
  let D₁ : Subgroup G := d.A k
  let D₂ : Subgroup G := zpowers (a * c⁻¹)
  have hA : ∀ t, d.A t ≤ d.AA := fun t => by
    rw [d.A_eq_AA_inf_Lf t]
    exact inf_le_left
  have hBA : B ≤ d.AA := hB.trans (sup_le (hA i) (hA j))
  have hDA₂ : D₂ ≤ d.AA := zpowers_le.mpr (d.AA.mul_mem (hA i ha) (d.AA.inv_mem (hA j hc)))
  have hdplane : D₂ ≤ d.A i ⊔ d.A j :=
    zpowers_le.mpr (Subgroup.mul_mem_sup ha ((d.A j).inv_mem hc))
  have hD₂1 : a * c⁻¹ ≠ 1 := by
    intro hh
    have heq : a = c := mul_inv_eq_one.mp hh
    have hC : c ∈ d.A i := heq ▸ ha
    have hco := d.eq_one_of_mem_Lf_of_mem_sup hij.symm hjk hik
      (d.A_le_S j hc) ((d.A_le_H j).trans (d.H_le_Lf j) hc)
      (Subgroup.mem_sup_left ((d.A_le_H i).trans (d.H_le_Lf i) hC))
    exact hc1 hco
  have hD₁3 : Nat.card D₁ = 3 := d.card_A k
  have hD₂3 : Nat.card D₂ = 3 := by
    rw [show D₂ = zpowers (a * c⁻¹) from rfl, Nat.card_zpowers]
    exact orderOf_eq_prime (d.isElemAbelian_AA.2 _ (hDA₂ (mem_zpowers _))) hD₂1
  have hD₁₂ : D₁ ≠ D₂ := by
    intro hh
    have hle : d.A k ≤ d.A i ⊔ d.A j := by
      change D₁ ≤ d.A i ⊔ d.A j
      rw [hh]
      exact hdplane
    have hc₁ : Nat.card (d.A k) = 1 := by
      apply Subgroup.card_eq_one.mpr
      rw [eq_bot_iff]
      intro x hx
      exact d.eq_one_of_mem_Lf_of_mem_sup hik.symm hjk.symm hij (d.A_le_S k hx)
        ((d.A_le_H k).trans (d.H_le_Lf k) hx)
        ((sup_le ((d.A_le_H i).trans (d.H_le_Lf i) |>.trans le_sup_left)
          ((d.A_le_H j).trans (d.H_le_Lf j) |>.trans le_sup_right)) (hle hx))
    rw [d.card_A k] at hc₁
    norm_num at hc₁
  have hplane : B ⊔ D₂ = d.A i ⊔ d.A j := by
    rw [← hgen]
    exact (plane_eq_line_sup_diagonal d ha hc ha1 hc1).symm
  have hAA : d.AA ≤ D₁ ⊔ D₂ ⊔ B := by
    have hcover : ∀ (i j k : Fin 3), i ≠ j → i ≠ k → j ≠ k →
        ∀ t : Fin 3, t = i ∨ t = j ∨ t = k := by decide
    have heq : D₁ ⊔ D₂ ⊔ B = d.A k ⊔ (d.A i ⊔ d.A j) := by
      rw [sup_assoc, sup_comm D₂ B, hplane]
    rw [heq, d.AA_def]
    have hle : ∀ t, d.A t ≤ d.A k ⊔ (d.A i ⊔ d.A j) := by
      intro t
      rcases hcover i j k hij hik hjk t with ht | ht | ht
      · rw [ht]; exact le_sup_left.trans le_sup_right
      · rw [ht]; exact le_sup_right.trans le_sup_right
      · rw [ht]; exact le_sup_left
    exact sup_le (sup_le (hle 0) (hle 1)) (hle 2)
  let H : Subgroup G := centralizer (B : Set G)
  have hSH : d.S ≤ H := by
    intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    exact d.S_commute b x (d.AA_le_S (hBA hb)) hx
  have hAH : d.AA ≤ H := d.AA_le_S.trans hSH
  let T : Subgroup H := d.S.subgroupOf H
  let A : Subgroup H := d.AA.subgroupOf H
  let Z₁ : Subgroup H := D₁.subgroupOf H
  let Z₂ : Subgroup H := D₂.subgroupOf H
  let B' : Subgroup H := B.subgroupOf H
  let Y : Subgroup H := d.M.subgroupOf H
  have hTZ₁ : Z₁ ≤ A := Subgroup.subgroupOf_mono H (hA k)
  have hTZ₂ : Z₂ ≤ A := Subgroup.subgroupOf_mono H hDA₂
  have hT : IsSylowOf 3 T ⊤ := by
    rw [← CFSG.ABGLocalTools.isSylowOf_map_subtype_iff (K := H)]
    rw [show T.map H.subtype = d.S from Subgroup.map_subgroupOf_eq_of_le hSH,
      Subgroup.map_top, Subgroup.range_subtype]
    exact hS
  have hTab : ∀ x ∈ T, ∀ y ∈ T, x * y = y * x := by
    intro x hx y hy
    exact Subtype.ext (d.S_commute x y hx hy)
  have hTr : CFSG.Open.pRank 3 T ≤ 3 := by
    rw [← CFSG.SectionRank.pRank_coe_eq_openPRank 3 T,
      CFSG.pRank_congr_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hSH) 3,
      CFSG.SectionRank.pRank_coe_eq_openPRank 3 d.S]
    exact hrank
  have hAc : ∀ x ∈ T, x ^ 3 = 1 → x ∈ A := by
    intro x hx hx3
    exact d.mem_AA_of_pow_eq_one hx (congrArg Subtype.val hx3)
  have hZ₁3 : Nat.card Z₁ = 3 :=
    (Nat.card_congr (Subgroup.subgroupOfEquivOfLe ((hA k).trans hAH)).toEquiv).trans hD₁3
  have hZ₂3 : Nat.card Z₂ = 3 :=
    (Nat.card_congr (Subgroup.subgroupOfEquivOfLe (hDA₂.trans hAH)).toEquiv).trans hD₂3
  have hZne : Z₁ ≠ Z₂ := by
    intro hh
    apply hD₁₂
    have hm := congrArg (fun J : Subgroup H => J.map H.subtype) hh
    rwa [Subgroup.map_subgroupOf_eq_of_le ((hA k).trans hAH),
      Subgroup.map_subgroupOf_eq_of_le (hDA₂.trans hAH)] at hm
  have hNT : ∀ x ∈ normalizer (T : Set H),
      (x : G) ∈ normalizer (d.S : Set G) := by
    intro x hx
    have hx' : x ∈ normalizer ((d.S.subgroupOf H) : Set H) := hx
    rw [← Subgroup.subgroupOf_normalizer_eq hSH] at hx'
    exact hx'
  have haxis : ∀ x ∈ normalizer (T : Set H),
      D₁.map (MulAut.conj (x : G)).toMonoidHom = D₁ ∧
      D₂.map (MulAut.conj (x : G)).toMonoidHom = D₂ := by
    intro x hx
    have hxS := hNT x hx
    have hxA := normalizer_S_le_normalizer_AA d hxS
    have hxM := hNA hxA
    let π := d.permHom hinj hperm ⟨(x : G), hxM⟩
    have hπ : ∀ t, (d.A t).map (MulAut.conj (x : G)).toMonoidHom = d.A (π t) :=
      map_axis_eq_of_mem_normalizer_S d hinj hperm hxM hxS
    have hfix := perm_fixes_complement_of_supportTwo d hij hik hjk hB hB3 hBi hBj x.2 π hπ
    have hpt : (MulAut.conj (x : G)) (a * c) = a * c := by
      change (x : G) * (a * c) * (x : G)⁻¹ = a * c
      have hh := Subgroup.mem_centralizer_iff.mp x.2 (a * c)
        (hgen ▸ mem_zpowers (a * c))
      rw [← hh, mul_assoc, mul_inv_cancel, mul_one]
    refine ⟨(hπ k).trans (congrArg d.A hfix), ?_⟩
    exact Subgroup.mem_normalizer_iff_map_conj_eq.mp
      (normalizes_diagonal_of_supportTwo d hij hik hjk ha hc hpt π hfix hπ)
  have hweak : ∀ {D : Subgroup G}, D ≤ d.AA →
      (∀ x ∈ normalizer (T : Set H), D.map (MulAut.conj (x : G)).toMonoidHom = D) →
      IsWeaklyClosedIn (D.subgroupOf H) T := by
    intro D hDA hnorm
    apply isWeaklyClosedIn_of_abelian_sylow_normalizer hT hTab
      (Subgroup.subgroupOf_mono H (hDA.trans d.AA_le_S))
    intro x hx
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    apply Subgroup.map_injective H.subtype_injective
    have hcomp : H.subtype.comp (MulAut.conj x).toMonoidHom =
        (MulAut.conj (x : G)).toMonoidHom.comp H.subtype := by ext a; rfl
    change ((D.subgroupOf H).map (MulAut.conj x).toMonoidHom).map H.subtype =
      (D.subgroupOf H).map H.subtype
    calc ((D.subgroupOf H).map (MulAut.conj x).toMonoidHom).map H.subtype
        = (D.subgroupOf H).map (H.subtype.comp (MulAut.conj x).toMonoidHom)  := Subgroup.map_map (D.subgroupOf H) H.subtype (MulAut.conj x).toMonoidHom
      _ = (D.subgroupOf H).map ((MulAut.conj (x : G)).toMonoidHom.comp H.subtype) := congrArg (fun f : H →* G => (D.subgroupOf H).map f) hcomp
      _ = ((D.subgroupOf H).map H.subtype).map (MulAut.conj (x : G)).toMonoidHom := (Subgroup.map_map (D.subgroupOf H) (MulAut.conj (x : G)).toMonoidHom H.subtype).symm
      _ = D.map (MulAut.conj (x : G)).toMonoidHom := by rw [Subgroup.map_subgroupOf_eq_of_le (hDA.trans hAH)]
      _ = D := hnorm x hx
      _ = (D.subgroupOf H).map H.subtype := (Subgroup.map_subgroupOf_eq_of_le (hDA.trans hAH)).symm
  have hw₁ : IsWeaklyClosedIn Z₁ T := hweak (hA k) (fun x hx => (haxis x hx).1)
  have hw₂ : IsWeaklyClosedIn Z₂ T := hweak hDA₂ (fun x hx => (haxis x hx).2)
  have hBcent : B' ≤ Subgroup.center H := by
    intro b hb
    rw [Subgroup.mem_center_iff]
    intro x
    exact Subtype.ext (Subgroup.mem_centralizer_iff.mp x.2 (b : G) hb).symm
  have hAg : A ≤ Z₁ ⊔ Z₂ ⊔ B' := by
    rw [← Subgroup.subgroupOf_sup ((hA k).trans hAH) (hDA₂.trans hAH),
      ← Subgroup.subgroupOf_sup ((sup_le (hA k) hDA₂).trans hAH) (hBA.trans hAH)]
    exact Subgroup.subgroupOf_mono H hAA
  have hCY₁ : centralizer (Z₁ : Set H) ≤ Y := by
    intro x hx
    apply hAxis k
    rw [Subgroup.mem_centralizer_iff]
    intro a ha
    exact congrArg Subtype.val (Subgroup.mem_centralizer_iff.mp hx ⟨a, (hA k).trans hAH ha⟩ ha)
  have hCY₂ : centralizer (Z₂ : Set H) ≤ Y := by
    intro x hx
    apply hAxis i
    have hBcx : B ≤ centralizer ({(x : G)} : Set G) := by
      intro b hb
      exact Subgroup.mem_centralizer_singleton_iff.mpr
        (Subgroup.mem_centralizer_iff.mp x.2 b hb)
    have hDcx : D₂ ≤ centralizer ({(x : G)} : Set G) := by
      intro d hd
      have hh := congrArg Subtype.val (Subgroup.mem_centralizer_iff.mp hx ⟨d, hDA₂.trans hAH hd⟩ hd)
      exact Subgroup.mem_centralizer_singleton_iff.mpr hh
    have hpcx : d.A i ⊔ d.A j ≤ centralizer ({(x : G)} : Set G) :=
      hplane ▸ sup_le hBcx hDcx
    rw [Subgroup.mem_centralizer_iff]
    intro a ha
    exact Subgroup.mem_centralizer_singleton_iff.mp (hpcx (Subgroup.mem_sup_left ha))
  have hNAY : normalizer (A : Set H) ≤ Y := by
    intro x hx
    have hx' : x ∈ normalizer ((d.AA.subgroupOf H) : Set H) := hx
    rw [← Subgroup.subgroupOf_normalizer_eq hAH] at hx'
    exact hNA hx'
  have htop := top_le_sup_pPrimeCore_of_abelian_sylow_weaklyClosed hK332 hK hT hTab hTr
    (Subgroup.subgroupOf_mono H d.AA_le_S) (d.isElemAbelian_AA.subgroupOf H) hAc
    hTZ₁ hTZ₂ hZ₁3 hZ₂3 hZne hw₁ hw₂ hBcent hAg hCY₁ hCY₂ hNAY
  have heq := congrArg (fun J : Subgroup H => J.map H.subtype) (top_le_iff.mp htop)
  rw [Subgroup.map_sup, Subgroup.subgroupOf_map_subtype, inf_comm d.M H,
    Subgroup.map_top, Subgroup.range_subtype] at heq
  exact heq.symm

theorem centralizer_factorization_of_abelian_sylow
    (d : SylowThreeData G) (hinj : Function.Injective d.Lf)
    (hperm : ∀ m ∈ d.M, ∀ i, ∃ j, (d.Lf i).map (MulAut.conj m).toMonoidHom = d.Lf j)
    (hS : IsSylowOf 3 d.S ⊤) (hrank : CFSG.Open.pRank 3 d.S ≤ 3)
    (hNA : normalizer (d.AA : Set G) ≤ d.M)
    (hAxis : ∀ i, centralizer (d.A i : Set G) ≤ d.M)
    (hK332 : CFSG.LocalAnalysis.UniquenessCase.UCK.K332ThreeAb)
    {B : Subgroup G} (hBA : B ≤ d.AA) (hB3 : Nat.card B = 3)
    (hK : CFSG.Open.IsKGroup ↥(centralizer (B : Set G))) :
    let H : Subgroup G := centralizer (B : Set G)
    H = (H ⊓ d.M) ⊔ (CFSG.pPrimeCore 3 ↥H).map H.subtype := by
  classical
  by_cases hax : ∃ i, B = d.A i
  · obtain ⟨i, rfl⟩ := hax
    change centralizer (d.A i : Set G) =
      (centralizer (d.A i : Set G) ⊓ d.M) ⊔ (CFSG.pPrimeCore 3 ↥(centralizer (d.A i : Set G))).map (centralizer (d.A i : Set G)).subtype
    rw [inf_eq_left.mpr (hAxis i)]
    exact (sup_eq_left.mpr (Subgroup.map_subtype_le _)).symm
  · by_cases hpl : ∃ i j : Fin 3, i ≠ j ∧ B ≤ d.A i ⊔ d.A j
    · obtain ⟨i, j, hij, hB⟩ := hpl
      exact supportTwo_centralizer_factorization_of_sylow d hinj hperm hrank hNA hAxis
        hK332 hij hB hB3 (fun hh => hax ⟨i, hh⟩) (fun hh => hax ⟨j, hh⟩) hK
        (hS.of_le (by
          intro a ha
          rw [Subgroup.mem_centralizer_iff]
          intro b hb
          exact d.S_commute b a (d.AA_le_S (hBA hb)) ha) le_top)
    · have hfull : ∀ i j : Fin 3, i ≠ j → ¬ B ≤ d.A i ⊔ d.A j :=
        fun i j hij hh => hpl ⟨i, j, hij, hh⟩
      exact fullSupport_centralizer_factorization_of_sylow d hinj hperm hS hrank hNA hAxis
        hK332 hBA hB3 hfull hK

theorem exists_centralizer_not_le_of_factorization_of_plane
    {p : ℕ} (hp : p.Prime)
    {A E M : Subgroup G} (hA : CFSG.Open.IsElemAbelian p A)
    (hEA : E ≤ A) (hE : Nat.card E = p ^ 2) {a : G} (ha : a ∈ A)
    (hfac : centralizer ({a} : Set G) =
      (centralizer ({a} : Set G) ⊓ M) ⊔
        (CFSG.pPrimeCore p (centralizer ({a} : Set G))).map
          (centralizer ({a} : Set G)).subtype)
    (hEscape : ¬ centralizer ({a} : Set G) ≤ M) :
    ∃ b ∈ E, b ≠ 1 ∧ ¬ centralizer ({b} : Set G) ≤ M := by
  classical
  by_contra h
  push Not at h
  let C : Subgroup G := centralizer ({a} : Set G)
  let N : Subgroup G := (CFSG.pPrimeCore p C).map C.subtype
  have hAC : A ≤ C := by
    intro b hb
    exact mem_centralizer_singleton_iff.mpr
      (congrArg Subtype.val (hA.1.is_comm.comm ⟨b, hb⟩ ⟨a, ha⟩))
  have hCN : C ≤ normalizer (N : Set G) :=
    CFSG.ABGLocalTools.le_normalizer_map_subtype C (CFSG.pPrimeCore p C)
  have hNp : ¬ p ∣ Nat.card N := by
    change ¬ p ∣ Nat.card ((CFSG.pPrimeCore p C).map C.subtype)
    rw [Subgroup.card_map_of_injective C.subtype_injective]
    exact (hp.coprime_iff_not_dvd).mp (CFSG.coprime_card_pPrimeCore p C)
  have hpow : ∀ b : E, b ^ p = 1 := fun b =>
    Subtype.ext (hA.2 b (hEA b.2))
  have hgen := CFSG.RankThreeEvenClassification.Helpers.coprime_centralizer_generation_of_plane
    p hp E N hpow hE hNp (hEA.trans (hAC.trans hCN))
  have hNM : N ≤ M := by
    rw [hgen]
    refine iSup_le fun b => iSup_le fun hb => ?_
    exact inf_le_right.trans (h b b.2 (fun he => hb (Subtype.ext he)))
  apply hEscape
  rw [hfac]
  exact sup_le inf_le_right hNM


theorem centralizer_le_of_factorization_of_gamma_two_le
    (d : SylowThreeData G) {B : Subgroup G} (hBA : B ≤ d.AA)
    (hfac : centralizer (B : Set G) =
      (centralizer (B : Set G) ⊓ d.M) ⊔
        (CFSG.pPrimeCore 3 (centralizer (B : Set G))).map (centralizer (B : Set G)).subtype)
    (hΓ : CFSG.Open.rankThreeGamma 2 3 d.AA ≤ d.M) : centralizer (B : Set G) ≤ d.M := by
  have hAH : d.AA ≤ centralizer (B : Set G) := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    exact d.S_commute b a (d.AA_le_S (hBA hb)) (d.AA_le_S ha)
  have hcore := d.relPPrimeCore_le_of_AA_le_of_gamma_two_le hΓ hAH
  rw [CFSG.LocalAnalysis.RankThreeTheoremC.KFactProofs.Stroth.AlmostSimple.relPPrimeCore_eq_map Nat.prime_three] at hcore
  rw [hfac]
  exact sup_le inf_le_right hcore

theorem centralizer_le_of_abelian_sylow_of_gamma_two_le
    (d : SylowThreeData G) (hinj : Function.Injective d.Lf)
    (hperm : ∀ m ∈ d.M, ∀ i, ∃ j, (d.Lf i).map (MulAut.conj m).toMonoidHom = d.Lf j)
    (hS : IsSylowOf 3 d.S ⊤) (hrank : CFSG.Open.pRank 3 d.S ≤ 3)
    (hNA : normalizer (d.AA : Set G) ≤ d.M)
    (hAxis : ∀ i, centralizer (d.A i : Set G) ≤ d.M)
    (hK332 : CFSG.LocalAnalysis.UniquenessCase.UCK.K332ThreeAb)
    {B : Subgroup G} (hBA : B ≤ d.AA) (hB3 : Nat.card B = 3)
    (hK : CFSG.Open.IsKGroup ↥(centralizer (B : Set G)))
    (hΓ : CFSG.Open.rankThreeGamma 2 3 d.AA ≤ d.M) : centralizer (B : Set G) ≤ d.M  := by
  exact centralizer_le_of_factorization_of_gamma_two_le d hBA
    (centralizer_factorization_of_abelian_sylow
      d hinj hperm hS hrank hNA hAxis hK332 hBA hB3 hK) hΓ

