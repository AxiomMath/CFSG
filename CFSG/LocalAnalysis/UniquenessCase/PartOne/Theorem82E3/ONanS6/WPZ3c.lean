  have hZ3 : ∀ J ∈ thetaComponentsAt 3 e, 3 ∣ Nat.card J →
      Nat.card (autThetaQuot (zSub P c.L) J) = 1 :=
    fun J hJ h3 => z_acts_trivially_threeComp' c hK hK12 hK9o hK9out hK9f hK9r hK2 hK9b hK4
      hSch hON h7 hP hNZ he he3 heZ hJ h3
  have hStep2 : ComponentsStepTwoConfig (D := D) c P e :=
    componentsStepTwoConfig_holds' K3_holds' K8Cat_holds hPSz hSzB hSzO hSzF c hON h7
      hP hNZ hP3 hZ3 he he3 heZ
  have hStep3 : SuzukiComponentStep (D := D) hPSz hSzB hSzO hSzF c hON h7
      P hNZ e hP3 hZ3 he he3 heZ :=
    suzukiComponentStep_holds_conditional hPSz hSzB hSzO hSzF c hON h7 P hNZ e hP3 hZ3
      he he3 heZ
