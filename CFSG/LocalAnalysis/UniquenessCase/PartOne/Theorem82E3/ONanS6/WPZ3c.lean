  change W ≤ theta3 H
  have hK6 : K6ONanClasses := K6_of_K2 hK2
  have hP1 : CFSG.ABGLocalTools.IsSylowOf 3
      (P ⊓ Subgroup.centralizer ({e} : Set G)) (Subgroup.centralizer ({e} : Set G)) :=
    pcore_centralizer_le_theta_P1' hK2 hK6 c hON h7 hP hNZ he he3 heZ
  have hP3 : CFSG.Open.pRank 7 (Subgroup.centralizer ({e} : Set G)) = 1 := by
    simpa using pcore_centralizer_le_theta_P3' hK4 c hON h7 hP hNZ he he3 heZ
  have hQ2 : IsPGroup 2 (CFSG.Open.pCoreOf 2 D.M) :=
    CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 D.M
  have hWQ : W ≤ CFSG.Open.pCoreOf 2 D.M := inf_le_right
  have hWQ2 : IsPGroup 2 (W.subgroupOf (CFSG.Open.pCoreOf 2 D.M)) :=
    hQ2.to_subgroup (W.subgroupOf (CFSG.Open.pCoreOf 2 D.M))
  have hW2G : IsPGroup 2 W :=
    hWQ2.of_equiv (Subgroup.subgroupOfEquivOfLe hWQ)
  have hW2 : IsPGroup 2 (W.subgroupOf H) :=
    hW2G.of_equiv (Subgroup.subgroupOfEquivOfLe (inf_le_left : W ≤ H)).symm
  have hO3 : (W.subgroupOf H).map
        (QuotientGroup.mk' (CFSG.RankThree.LocalRank.aschbacherSolvableCore 3 ↥H)) ≤
      Subgroup.centralizer
        ((CFSG.pCore 3 (H ⧸ CFSG.RankThree.LocalRank.aschbacherSolvableCore 3 ↥H) :
          Subgroup _) : Set _) := by
    simpa [W, H] using
