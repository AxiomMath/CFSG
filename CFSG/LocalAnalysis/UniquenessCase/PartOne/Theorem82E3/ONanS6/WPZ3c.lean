theorem z_acts_trivially_threeComp'
    (hK : K332Z3) (hK12 : K12SL) (hK9o : K9J2Order)
    (hK9out : K9J2Out) (hK9f : K9Five) (hK9r : K9G2Rank) (hK2 : K2ONanCentralizer)
    (hK9b : K9bIn) (hK4 : K4) (hSch : CFSG.AGLEmbedding.KFactCatalogSchreier)
    (hON : UCK.ThreeCover (fun Y _ => IsSpor Y .ONan) c.Lbar) (h7 : D.sig = {7})
    (hP : CFSG.ABGLocalTools.IsSylowOf 3 P D.M)
    (hNZ : Subgroup.normalizer ((zSub P c.L : Subgroup G) : Set G) ≤ D.M)
    (haL : a ∈ P ⊓ c.L) (ha3 : orderOf a = 3) (haZ : a ∉ zSub P c.L)
    {J : Subgroup G} (hJ : J ∈ thetaComponentsAt 3 a) (h3 : 3 ∣ Nat.card J) :
    Nat.card (autThetaQuot (zSub P c.L) J) = 1 := by
  have hZcard : Nat.card (zSub P c.L) = 3 := zSub_card' c hON h7 hP
  have hZJ : zSub P c.L ≤ Subgroup.normalizer (J : Set G) :=
    zSub_le_normalizer_of_threeComp c hON h7 hP hNZ haL ha3 haZ hJ h3
  refine card_autThetaQuot_eq_one_of_forall (fun z hzZ hzN => ?_)
  by_cases hz1 : z = 1
  · subst hz1
    rw [show (⟨(1 : G), hzN⟩ : Subgroup.normalizer (J : Set G)) = 1 from rfl, map_one, map_one]
  · have hz3 : orderOf z = 3 := by
      have hdvd : orderOf z ∣ Nat.card (zSub P c.L) :=
        (zSub P c.L).orderOf_dvd_natCard hzZ
      rw [hZcard] at hdvd
      rcases Nat.prime_three.eq_one_or_self_of_dvd (orderOf z) hdvd with h | h
      · exact absurd h (orderOf_eq_one_iff.not.mpr hz1)
      · exact h
    exact thetaQuotMulAut_eq_one_of_threeComp'' c hK hK12 hK9o hK9out hK9f hK9r hK2 hK9b hK4
      hSch hON h7 hP hNZ haL ha3 haZ hJ h3 hzZ hz3 (hZJ hzZ)

end
