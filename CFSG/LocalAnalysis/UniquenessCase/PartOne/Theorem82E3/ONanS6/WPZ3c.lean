theorem alpha_ne_bot
    (hK : K332Z3) (hK12 : K12SL) (hK9o : K9J2Order)
    (hK9out : K9J2Out) (hK9f : K9Five) (hK9r : K9G2Rank) (hK2 : K2ONanCentralizer)
    (hK9b : K9bIn) (hK4 : K4) (hSch : CFSG.AGLEmbedding.KFactCatalogSchreier)
    (hPSz : CFSG.RankThree.PartTwo.KFacts.KPSz)
    (hSzB : Sz.SzBorel) (hSzO : Sz.SzOutOdd) (hSzF : Sz.SzFix) (c : Ctx82E3 D)
    (hON : UCK.ThreeCover (fun Y _ => IsSpor Y .ONan) c.Lbar) (h7 : D.sig = {7})
    {P : Subgroup G} (hP : CFSG.ABGLocalTools.IsSylowOf 3 P D.M)
    (hNZ : Subgroup.normalizer ((zSub P c.L : Subgroup G) : Set G) ≤ D.M)
    (hZcard : Nat.card (zSub P c.L) = 3)
    {e : G} (he : e ∈ P ⊓ c.L) (he3 : orderOf e = 3) (heZ : e ∉ zSub P c.L) :
    CFSG.Open.IsElemAbelian 3 (zSub P c.L ⊔ Subgroup.zpowers e) ∧
      Nat.card (zSub P c.L ⊔ Subgroup.zpowers e : Subgroup G) = 9 ∧
      (zSub P c.L ⊔ Subgroup.zpowers e) ≤ P ∧
      thetaAlpha 3 (zSub P c.L ⊔ Subgroup.zpowers e) ≠ ⊥ := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hcomm : ∀ a ∈ zSub P c.L, a * e = e * a := by
    intro a ha
    change a ∈ ((P ⊓ c.L : Subgroup G) ⊓
      Subgroup.centralizer ((P ⊓ c.L : Subgroup G) : Set G)) at ha
    exact (Subgroup.mem_centralizer_iff.mp ha.2 e he).symm
  obtain ⟨hea, hcard⟩ :=
    CFSG.GroupTheory.isElemAbelian_sup_zpowers_of_commute (r := 3) hZcard he3 heZ hcomm
  have hEcard : Nat.card (zSub P c.L ⊔ Subgroup.zpowers e : Subgroup G) = 9 := by
    rw [hcard]
    norm_num
  have hEP : (zSub P c.L ⊔ Subgroup.zpowers e) ≤ P :=
    sup_le (inf_le_left.trans inf_le_left) (Subgroup.zpowers_le.mpr he.1)
  refine ⟨hea, hEcard, hEP, ?_⟩
  intro hbot
  refine thetaJ_ne_bot' hK hK12 hK9o hK9out hK9f hK9r hK2 hK9b hK4 hSch hPSz hSzB hSzO hSzF
    c hON h7 hP hNZ he he3 heZ ?_
  have hle : thetaJ 3 (zSub P c.L ⊔ Subgroup.zpowers e) ≤
      thetaAlpha 3 (zSub P c.L ⊔ Subgroup.zpowers e) := le_sup_left
  rw [hbot] at hle
  exact le_bot_iff.mp hle

theorem onanCentralizerSetup_of_inputs
    (hSQ : Section7.StronglyEmbeddedSolvableQ) (hSE5 : Section7.StronglyEmbeddedFive)
    (hSE3 : Section7.StronglyEmbeddedThree)
    (hK341 : CFSG.LocalAnalysis.UniquenessCase.UC22.InS3.K341)
    (hK : K332Z3) (hK35w : UCK.K35w) (hK4 : K4) (hK5 : K5Gen) (hK8 : K8Cat)
    (hK2 : K2ONanCentralizer) (hK6 : K6ONanClasses) (hK9o : K9J2Order) (hK9out : K9J2Out)
    (hK9f : K9Five) (hK9r : K9G2Rank) (hK9b : K9bIn) (hK12 : K12SL)
    (hSch : CFSG.AGLEmbedding.KFactCatalogSchreier)
