    (hSzB : Sz.SzBorel) (hSzO : Sz.SzOutOdd) (hSzF : Sz.SzFix) :
    ONanCentralizerSetup := by
  intro G _ _ hS hUC hC S hSig c h811 hON hsig P hP hNZ x hx hx3 hxZ
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hZcard : Nat.card (zSub P c.L) = 3 := c.card_inf_centralizer_of_onan hON hP
  have hlocal : ∀ A : Subgroup G, CFSG.Open.IsElemAbelian 3 A → Nat.card A = 27 →
      zSub P c.L ≤ A → A ≤ P ⊓ c.L →
      ∀ E ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.InS3.hyperplanes 3 A,
        ∀ E' ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.InS3.hyperplanes 3 A,
          thetaAlpha 3 E = thetaAlpha 3 E' :=
    fun A hA hA27 hZA hAPL =>
      (k341_local_at hK341 hK hK12 hK9o hK9out hK9f hK9r hK2 hK9b hK4 hK8 hSch hPSz
        c hON hsig hP hNZ hA hA27 hZA hAPL).2
  have hconst := alpha_const_of_local'' c hON hsig hP hNZ hlocal
  obtain ⟨hE₀ea, hE₀card, hE₀P, hαne⟩ :=
    alpha_ne_bot hK hK12 hK9o hK9out hK9f hK9r hK2 hK9b hK4 hSch hPSz hSzB hSzO hSzF
      c hON hsig hP hNZ hZcard hx hx3 hxZ
  let E₀ : Subgroup G := zSub P c.L ⊔ Subgroup.zpowers x
  obtain ⟨A, hAea, hA27, hZA, hAPL⟩ := exists_E27_frame' c hON hsig hP hNZ
  obtain ⟨B, hBcard⟩ := Sylow.exists_subgroup_card_pow_prime_of_le_card
    (G := ↥A) (n := 2) Nat.prime_three hAea.isPGroup (by rw [hA27]; norm_num)
  let H : Subgroup G := B.map A.subtype
  have hHA : H ≤ A := Subgroup.map_subtype_le B
  have hHcard : Nat.card H = 9 := by
    rw [Subgroup.card_map_of_injective A.subtype_injective, hBcard]
    norm_num
  have hHea : CFSG.Open.IsElemAbelian 3 H := hAea.mono hHA
  have hHP : H ≤ P := hHA.trans (hAPL.trans inf_le_left)
  have hH : H ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.InS3.hyperplanes 3 A :=
    (CFSG.LocalAnalysis.UniquenessCase.UC22.InS3.mem_hyperplanes_three_iff hA27).mpr
      ⟨hHA, hHcard⟩
  have hαH := (k341_local_at hK341 hK hK12 hK9o hK9out hK9f hK9r hK2 hK9b hK4 hK8 hSch hPSz
    c hON hsig hP hNZ hAea hA27 hZA hAPL).1 H hH
  have hαeq : thetaAlpha 3 E₀ = thetaAlpha 3 H :=
    hconst E₀ H hE₀P hHP hE₀ea hE₀card hHea hHcard
  have hαsolv : Group.IsSolvable ↥(thetaAlpha 3 E₀) := by
    rw [hαeq]; exact hαH.1
  have hα3 : Nat.Coprime 3 (Nat.card ↥(thetaAlpha 3 E₀)) := by
    rw [hαeq]; exact hαH.2
  have hN := normalizer_le_normalizer_alpha c hON hsig hP hNZ hE₀P hE₀ea hE₀card hconst
  have hNM := normalizer_alpha_le_M' hK5 (UC22.kf7Use_dataOfSetup hSQ hSE5 hSE3 hS S)
    c hON hsig hP hNZ hE₀P hαne hαsolv hα3 hN
  exact centralizer_le_of_gamma' hK35w hK2 hK6 c hON hsig hP hNZ
    (fun U hU hnc => (hN U hU hnc).trans hNM) x hx hx3 hxZ

