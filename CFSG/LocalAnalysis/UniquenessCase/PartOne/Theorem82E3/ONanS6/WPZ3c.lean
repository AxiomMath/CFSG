theorem commutator_le_of_le_normalizer {J Z : Subgroup G}
    (hZJ : Z ≤ Subgroup.normalizer (J : Set G)) : ⁅J, Z⁆ ≤ J := by
  refine Subgroup.commutator_le.mpr ?_
  intro x hx z hz
  have hzx : z * x⁻¹ * z⁻¹ ∈ J :=
    (Subgroup.mem_normalizer_iff.mp (hZJ hz) x⁻¹).mp (J.inv_mem hx)
  have h : x * (z * x⁻¹ * z⁻¹) ∈ J := J.mul_mem hx hzx
  simpa [commutatorElement_def, mul_assoc] using h

theorem commutator_le_normalizer_commutator {J Z : Subgroup G} :
    J ≤ Subgroup.normalizer ((⁅J, Z⁆ : Subgroup G) : Set G) := by
  rw [Subgroup.le_normalizer_iff]
  intro h hh k hk
  have hmap : Subgroup.map (MulAut.conj h).toMonoidHom (⁅J, Z⁆ : Subgroup G) ≤ ⁅J, Z⁆ := by
    rw [Subgroup.commutator_def, MonoidHom.map_closure]
    refine (Subgroup.closure_le _).mpr ?_
    rintro y ⟨x, ⟨j, hj, z, hz, rfl⟩, rfl⟩
    have h1 : (MulAut.conj h) ⁅j, z⁆ = ⁅h * j, z⁆ * ⁅h, z⁆⁻¹ := by
      rw [MulAut.conj_apply, commutatorElement_mul_left_eq_conj_mul]
      group
    rw [show (MulAut.conj h).toMonoidHom ⁅j, z⁆ = ⁅h * j, z⁆ * ⁅h, z⁆⁻¹ from h1]
    exact (⁅J, Z⁆).mul_mem
      (Subgroup.commutator_mem_commutator (J.mul_mem hh hj) hz)
      ((⁅J, Z⁆).inv_mem (Subgroup.commutator_mem_commutator hh hz))
  have hmem := hmap (Subgroup.mem_map_of_mem (MulAut.conj h).toMonoidHom hk)
  simpa [MulAut.conj_apply] using hmem

theorem exists_commutator_not_mem_theta_wPZ3c {J : Subgroup G} {z : G}
    (hzN : z ∈ Subgroup.normalizer (J : Set G))
    (hπ : thetaQuotMulAut J (J.normalizerMonoidHom ⟨z, hzN⟩) ≠ 1) :
    ∃ x ∈ J, ⁅x, z⁆ ∉ inSubgroup (aschbacherSolvableCore 3) J := by
  classical
  have hex : ∃ q : Jtilde J, thetaQuotMulAut J (J.normalizerMonoidHom ⟨z, hzN⟩) q ≠ q := by
    by_contra h
    push Not at h
    exact hπ (by ext q; exact h q)
  obtain ⟨q, hq⟩ := hex
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (aschbacherSolvableCore 3 ↥J) q
  refine ⟨x, x.2, fun hmem => hq ?_⟩
  have hzxmem : z * (x : G) * z⁻¹ ∈ J := (Subgroup.mem_normalizer_iff.mp hzN x).mp x.2
  have hcommJ : ⁅z, (x : G)⁆ ∈ J := by
    have h1 : z * (x : G) * z⁻¹ ∈ J := hzxmem
    have h2 : (x : G)⁻¹ ∈ J := J.inv_mem x.2
    simpa [commutatorElement_def] using J.mul_mem h1 h2
  have hmem_inv : ⁅z, (x : G)⁆ ∈ inSubgroup (aschbacherSolvableCore 3) J := by
    rw [← commutatorElement_inv]
    exact Subgroup.inv_mem _ hmem
  have hmemθ : (⟨⁅z, (x : G)⁆, hcommJ⟩ : ↥J) ∈ aschbacherSolvableCore 3 ↥J := by
    rw [inSubgroup] at hmem_inv
    obtain ⟨y, hy, hyval⟩ := Subgroup.mem_map.mp hmem_inv
    rwa [show (⟨⁅z, (x : G)⁆, hcommJ⟩ : ↥J) = y from Subtype.ext hyval.symm]
  have hzero : (QuotientGroup.mk' (aschbacherSolvableCore 3 ↥J))
      (⟨⁅z, (x : G)⁆, hcommJ⟩ : ↥J) = 1 :=
    (QuotientGroup.eq_one_iff _).mpr hmemθ
  change thetaQuotMulAut J (J.normalizerMonoidHom ⟨z, hzN⟩) (x : Jtilde J) = (x : Jtilde J)
  rw [thetaQuotMulAut_mk]
  have hzx : (J.normalizerMonoidHom ⟨z, hzN⟩ x : ↥J) =
      ⟨z * (x : G) * z⁻¹, hzxmem⟩ :=
    Subtype.ext (normalizerMonoidHom_apply_coe hzN x)
  rw [hzx]
  have hsub : (⟨z * (x : G) * z⁻¹, hzxmem⟩ : ↥J) =
      (⟨⁅z, (x : G)⁆, hcommJ⟩ : ↥J) * x := by
    ext
    simp only [Subgroup.coe_mul, Subgroup.coe_mk]
    rw [commutatorElement_def]
    group
  rw [hsub]
  change (QuotientGroup.mk' (aschbacherSolvableCore 3 ↥J))
      ((⟨⁅z, (x : G)⁆, hcommJ⟩ : ↥J) * x) =
    (QuotientGroup.mk' (aschbacherSolvableCore 3 ↥J)) x
  rw [map_mul, hzero, one_mul]

theorem commutator_map_theta_eq_top {J : Subgroup G}
    (hJ : J ∈ thetaComponentsAt 3 a)
    (hZJ : zSub P c.L ≤ Subgroup.normalizer (J : Set G))
    {z : G} (hzZ : z ∈ zSub P c.L)
    (hzN : z ∈ Subgroup.normalizer (J : Set G))
    (hπ : thetaQuotMulAut J (J.normalizerMonoidHom ⟨z, hzN⟩) ≠ 1) :
    Subgroup.map (QuotientGroup.mk' (aschbacherSolvableCore 3 ↥J))
      ((⁅J, zSub P c.L⁆).subgroupOf J) = ⊤ := by
  classical
  let K : Subgroup G := ⁅J, zSub P c.L⁆
  let KJ : Subgroup ↥J := K.subgroupOf J
  let π : ↥J →* Jtilde J := QuotientGroup.mk' (aschbacherSolvableCore 3 ↥J)
  have hKle : K ≤ J := commutator_le_of_le_normalizer hZJ
  have hKJnormal : KJ.Normal := by
    simpa only [KJ, K] using Subgroup.normal_subgroupOf_of_le_normalizer
      (commutator_le_normalizer_commutator (J := J) (Z := zSub P c.L))
  let N : Subgroup (Jtilde J) := KJ.map π
  have hNnormal : N.Normal := hKJnormal.map π (QuotientGroup.mk'_surjective _)
  have hJquasi : CFSG.IsQuasisimple (Jtilde J) :=
    CFSG.RankThree.PartTwo.Sec6.isQuasisimple_of_mem_thetaComponentsAt hJ
  have hcommJ : ∀ x : ↥J, ⁅(x : G), z⁆ ∈ J := by
    intro x
    have h1 : z * (x : G) * z⁻¹ ∈ J := (Subgroup.mem_normalizer_iff.mp hzN x).mp x.2
    have h2 : ⁅z, (x : G)⁆ ∈ J := by
      simpa [commutatorElement_def] using J.mul_mem h1 (J.inv_mem x.2)
    rw [← commutatorElement_inv]
    exact J.inv_mem h2
  have hNne : N ≠ ⊥ := by
    intro hbot
    obtain ⟨x, hxJ, hxθ⟩ := exists_commutator_not_mem_theta_wPZ3c hzN hπ
    have hcommK : ⁅x, z⁆ ∈ K := Subgroup.commutator_mem_commutator hxJ hzZ
    have hcommJ' : ⁅x, z⁆ ∈ J := hKle hcommK
    let y : ↥J := ⟨⁅x, z⁆, hcommJ'⟩
    have hyKJ : y ∈ KJ := Subgroup.mem_subgroupOf.mpr hcommK
    have hyN : π y ∈ N := Subgroup.mem_map_of_mem π hyKJ
    rw [hbot, Subgroup.mem_bot] at hyN
    have hyθ : y ∈ aschbacherSolvableCore 3 ↥J := (QuotientGroup.eq_one_iff y).mp hyN
    exact hxθ ⟨y, hyθ, rfl⟩
  rcases CFSG.LocalCores.quasisimple_normal_subgroups hJquasi hNnormal with htop | hcenter
  · exact htop
  · exfalso
    let σ : MulAut (Jtilde J) := thetaQuotMulAut J (J.normalizerMonoidHom ⟨z, hzN⟩)
    have hcomm_center : ∀ x : ↥J,
        π (⟨⁅(x : G), z⁆, hcommJ x⟩ : ↥J) ∈ Subgroup.center (Jtilde J) := by
      intro x
      have hmemK : ⁅(x : G), z⁆ ∈ K := Subgroup.commutator_mem_commutator x.2 hzZ
      have hmemKJ : (⟨⁅(x : G), z⁆, hcommJ x⟩ : ↥J) ∈ KJ := Subgroup.mem_subgroupOf.mpr hmemK
      have hmemN : π (⟨⁅(x : G), z⁆, hcommJ x⟩ : ↥J) ∈ N := Subgroup.mem_map_of_mem π hmemKJ
      exact hcenter hmemN
    have hσcenter :
        CFSG.ClassicalInvolution.Disconnected.AschTight.centerQuotientAut (Jtilde J) σ = 1 := by
      ext q
      induction q using QuotientGroup.induction_on with
      | H y =>
        obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (aschbacherSolvableCore 3 ↥J) y
        rw [show (QuotientGroup.mk' (aschbacherSolvableCore 3 ↥J)) x = (x : Jtilde J) from rfl]
        rw [CFSG.ClassicalInvolution.Disconnected.AschTight.centerQuotientAut_mk, MulAut.one_apply]
        rw [QuotientGroup.eq_iff_div_mem]
        have hzxmem : z * (x : G) * z⁻¹ ∈ J := (Subgroup.mem_normalizer_iff.mp hzN x).mp x.2
        have hσx : σ (x : Jtilde J) =
            QuotientGroup.mk' (aschbacherSolvableCore 3 ↥J)
              (⟨z * (x : G) * z⁻¹, hzxmem⟩ : ↥J) := by
          change thetaQuotMulAut J (J.normalizerMonoidHom ⟨z, hzN⟩) (x : Jtilde J) = _
          rw [thetaQuotMulAut_mk]
          rw [show (J.normalizerMonoidHom ⟨z, hzN⟩) x = ⟨z * (x : G) * z⁻¹, hzxmem⟩ from
            Subtype.ext (normalizerMonoidHom_apply_coe hzN x)]
          rfl
        have hu : (⟨z * (x : G) * z⁻¹, hzxmem⟩ : ↥J) * x⁻¹ =
            (⟨⁅(x : G), z⁆, hcommJ x⟩ : ↥J)⁻¹ := by
          ext
          simp only [Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_mk]
          rw [commutatorElement_def]
          group
        have hdiv : σ (x : Jtilde J) / (x : Jtilde J) =
            (π (⟨⁅(x : G), z⁆, hcommJ x⟩ : ↥J))⁻¹ := by
          rw [hσx, div_eq_mul_inv]
          change (QuotientGroup.mk' (aschbacherSolvableCore 3 ↥J)
              (⟨z * (x : G) * z⁻¹, hzxmem⟩ : ↥J)) *
              ((QuotientGroup.mk' (aschbacherSolvableCore 3 ↥J)) x)⁻¹ = _
          rw [← map_inv, ← map_mul, hu, map_inv]
        rw [hdiv]
        exact (Subgroup.center (Jtilde J)).inv_mem (hcomm_center x)
    have hσ : σ = 1 := by
      haveI : Group.IsPerfect (Jtilde J) := jtilde_perfect (a := a) hJ
      exact CFSG.ClassicalInvolution.Disconnected.AschTight.eq_one_of_centerQuotientAut_eq_one
        hσcenter
    exact hπ hσ

theorem two_le_pRank_three_jtilde_of_f9 (hF9 : F9Input c P a)
    (hON : UCK.ThreeCover (fun Y _ => IsSpor Y .ONan) c.Lbar) (h7 : D.sig = {7})
    (hP : CFSG.ABGLocalTools.IsSylowOf 3 P D.M)
    (hNZ : Subgroup.normalizer ((zSub P c.L : Subgroup G) : Set G) ≤ D.M)
    (haL : a ∈ P ⊓ c.L) (ha3 : orderOf a = 3) (haZ : a ∉ zSub P c.L)
    {J : Subgroup G} (hJ : J ∈ thetaComponentsAt 3 a) (h3 : 3 ∣ Nat.card J)
    {z : G} (hzZ : z ∈ zSub P c.L) (hz3 : orderOf z = 3)
    (hzN : z ∈ Subgroup.normalizer (J : Set G))
    (hSch : CFSG.AGLEmbedding.KFactCatalogSchreier)
    (hπ : thetaQuotMulAut J (J.normalizerMonoidHom ⟨z, hzN⟩) ≠ 1) :
    2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (Jtilde J)) := by
  classical
  haveI hIperf : Group.IsPerfect ↥(Ia c a) := Ia_perfect c a
  have hIJ : Ia c a ≤ Subgroup.normalizer (J : Set G) :=
    Ia_le_normalizer_of_f9_c c hF9 hON h7 hP hNZ haL ha3 haZ hJ h3
  have hzI : z ∈ Ia c a := hF9.2.1 hzZ
  have hinner : (piJ c hIJ).range ≤
      (MulAut.conj : Jtilde J →* MulAut (Jtilde J)).range :=
    piJ_range_le_conj c hIJ hJ ha3 hSch
  let O : Subgroup ↥(Ia c a) := CFSG.pCore 2 ↥(Ia c a)
  have hO2 : IsPGroup 2 O := CFSG.pCore_isPGroup
  let φ : ↥(Ia c a) →* MulAut (Jtilde J) := piJ c hIJ
  let A : Subgroup (MulAut (Jtilde J)) := φ.range
  let Q : Subgroup A := O.map φ.rangeRestrict
  have hQ2 : IsPGroup 2 Q := hO2.map φ.rangeRestrict
  haveI hQnorm : Q.Normal :=
    (CFSG.pCore_normal (p := 2) (G := ↥(Ia c a))).map φ.rangeRestrict
      φ.rangeRestrict_surjective
  let T := ↥(Ia c a) ⧸ O
  have hTtriple : IsTripleCover T ↥(alternatingGroup (Fin 6)) := hF9.1
  have hTperf : Group.IsPerfect T :=
    Group.IsPerfect.ofSurjective (f := QuotientGroup.mk' O) (QuotientGroup.mk'_surjective O)
  let ψ : ↥(Ia c a) →* A ⧸ Q := (QuotientGroup.mk' Q).comp φ.rangeRestrict
  have hOker : O ≤ ψ.ker := by
    intro x hx
    rw [MonoidHom.mem_ker]
    have hxQ : (φ.rangeRestrict x : A) ∈ Q := Subgroup.mem_map_of_mem φ.rangeRestrict hx
    have hmk : (QuotientGroup.mk (φ.rangeRestrict x) : A ⧸ Q) = 1 :=
      (QuotientGroup.eq_one_iff _).mpr hxQ
    simpa [ψ] using hmk
  let g : T →* A ⧸ Q := QuotientGroup.lift (N := O) ψ hOker
  have hψsurj : Function.Surjective ψ := by
    intro t
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective Q t
    obtain ⟨x, hx⟩ := φ.rangeRestrict_surjective a
    exact ⟨x, by simp [ψ, hx]⟩
  have hgsurj : Function.Surjective g :=
    QuotientGroup.lift_surjective_of_surjective (N := O) ψ hψsurj hOker
  let zI : ↥(Ia c a) := ⟨z, hzI⟩
  let ζ : T := QuotientGroup.mk zI
  have hζZ : ζ ∈ Subgroup.center T := by
    rw [Subgroup.mem_center_iff]
    intro t
    obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective t
    have hmem : ⁅y, zI⁆ ∈ O := by
      have hG : ⁅(y : G), z⁆ ∈ CFSG.Open.pCoreOf 2 (Ia c a) :=
        (Subgroup.commutator_le.mp hF9.2.2.1) y y.2 z hzZ
      have hG' : ⁅(y : G), z⁆ ∈ O.map (Ia c a).subtype := by
        rwa [CFSG.Open.pCoreOf] at hG
      obtain ⟨w, hwO, hw⟩ := Subgroup.mem_map.mp hG'
      have hcoe : ((⁅y, zI⁆ : ↥(Ia c a)) : G) = ⁅(y : G), z⁆ :=
        map_commutatorElement (Ia c a).subtype y zI
      have hweq : (⁅y, zI⁆ : ↥(Ia c a)) = w := Subtype.ext (hcoe.trans hw.symm)
      rwa [hweq]
    have h1 : ⁅(QuotientGroup.mk' O) y, (QuotientGroup.mk' O) zI⁆ = 1 :=
      (map_commutatorElement (QuotientGroup.mk' O) y zI).symm.trans
        ((QuotientGroup.eq_one_iff _).mpr hmem)
    exact commutatorElement_eq_one_iff_mul_comm.mp h1
  have hzI3 : orderOf zI = 3 := by
    rw [Subgroup.orderOf_mk]
    exact hz3
  have hζ3 : orderOf ζ = 3 := by
    have hne : ζ ≠ 1 := by
      intro hζ
      have hzO : zI ∈ O := (QuotientGroup.eq_one_iff zI).mp hζ
      have hdvd : orderOf zI ∣ Nat.card O := Subgroup.orderOf_dvd_natCard O hzO
      obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp hO2
      rw [hn, hzI3] at hdvd
      have hcop : Nat.Coprime 3 (2 ^ n) := Nat.Coprime.pow_right n (by norm_num)
      have hone : 3 = 1 := Nat.eq_one_of_dvd_coprimes hcop dvd_rfl hdvd
      norm_num at hone
    have hdvd : orderOf ζ ∣ 3 := by
      apply orderOf_dvd_of_pow_eq_one
      have h3 : zI ^ 3 = 1 := by simpa [hzI3] using pow_orderOf_eq_one zI
      show ((QuotientGroup.mk' O) zI) ^ 3 = 1
      rw [← map_pow, h3, map_one]
    rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
    · exact absurd (orderOf_eq_one_iff.mp h1) hne
    · exact h3
  have hζB : g ζ ≠ 1 := by
    intro hgζ
    have hψz : ψ zI = 1 := by
      rw [show g ζ = ψ zI from QuotientGroup.lift_mk' (N := O) hOker zI] at hgζ
      exact hgζ
    have hmemQ : (φ.rangeRestrict zI : A) ∈ Q := (QuotientGroup.eq_one_iff _).mp hψz
    have hmap : (O.map φ.rangeRestrict).map A.subtype = O.map φ := by
      rw [Subgroup.map_map, MonoidHom.subtype_comp_rangeRestrict]
    have hmem : φ zI ∈ O.map φ := by
      rw [← hmap]
      exact Subgroup.mem_map_of_mem A.subtype hmemQ
    obtain ⟨w, hwO, hwe⟩ := Subgroup.mem_map.mp hmem
    have hφz3 : orderOf (φ zI) = 3 := orderOf_piJ_apply_z c hIJ hzI hz3 hzN hπ
    have hdvd : orderOf (φ zI) ∣ Nat.card O := by
      have h1 : orderOf (φ zI) ∣ orderOf w := by
        rw [← hwe]
        exact orderOf_map_dvd φ w
      exact h1.trans (Subgroup.orderOf_dvd_natCard O hwO)
    obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp hO2
    rw [hn, hφz3] at hdvd
    have hcop : Nat.Coprime 3 (2 ^ n) := Nat.Coprime.pow_right n (by norm_num)
    have hone : 3 = 1 := Nat.eq_one_of_dvd_coprimes hcop dvd_rfl hdvd
    norm_num at hone
  have hker : g.ker = ⊥ :=
    ker_eq_bot_of_isTripleCover hTperf hTtriple g hgsurj hζZ hζ3 hζB
  have hbij : Function.Bijective g :=
    ⟨(MonoidHom.ker_eq_bot_iff g).mp hker, hgsurj⟩
  let e : T ≃* A ⧸ Q := MulEquiv.ofBijective g hbij
  have hTrank : 2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup T) := by
    obtain ⟨eT⟩ := hTtriple.2
    exact CFSG.Quasithin.H13.Rank8.two_le_pRank_of_isHatAlt (n := 6) (Or.inl rfl)
      hTtriple.1 eT
  have hQArank : 2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (A ⧸ Q)) := by
    rw [← CFSG.SectionRank.pRank_top_eq_of_mulEquiv (p := 3) (by norm_num) e]
    exact hTrank
  have hArank : 2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup A) := by
    rw [← CFSG.SectionRank.pRank_quotient_two_group Q hQ2 (r := 3) Nat.prime_three
      (by norm_num)]
    exact hQArank
  have hArank' : 2 ≤ CFSG.Open.pRank 3 (A : Subgroup (MulAut (Jtilde J))) := by
    rw [CFSG.SectionRank.pRank_eq_pRank_top_subgroup]
    exact hArank
  have hinner' : A ≤ (MulAut.conj : Jtilde J →* MulAut (Jtilde J)).range := by
    simpa only [A, φ] using hinner
  have hInnrank : 2 ≤ CFSG.Open.pRank 3
      ((MulAut.conj : Jtilde J →* MulAut (Jtilde J)).range) :=
    hArank'.trans (CFSG.SectionRank.pRank_mono (p := 3) (by norm_num) hinner')
  have hJ0rank : 2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (J0 J)) := by
    have hInnrank' : 2 ≤ CFSG.Open.pRank 3
        (⊤ : Subgroup ↥((MulAut.conj : Jtilde J →* MulAut (Jtilde J)).range)) := by
      rw [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup]
      exact hInnrank
    let eInn : J0 J ≃* ↥((MulAut.conj : Jtilde J →* MulAut (Jtilde J)).range) :=
      (QuotientGroup.quotientMulEquivOfEq (conj_ker (H := Jtilde J)).symm).trans
        (QuotientGroup.quotientKerEquivRange (MulAut.conj : Jtilde J →* MulAut (Jtilde J)))
    rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv (p := 3) (by norm_num) eInn]
    exact hInnrank'
  haveI : Group.IsPerfect (Jtilde J) := jtilde_perfect (a := a) hJ
  exact CFSG.QuasithinUnique.Vol2Native.two_le_pRank_of_quotient_center
    (L := Jtilde J) Nat.prime_three (by norm_num) hJ0rank

theorem commutator_subgroupOf_le_Xcl {J : Subgroup G} :
    (⁅J, zSub P c.L⁆).subgroupOf (G0 c P J) ≤ Xcl c P J := by
  have hKleXmap : ⁅J, zSub P c.L⁆ ≤ (Xcl c P J).map (G0 c P J).subtype := by
    rw [Subgroup.commutator_def]
    refine (Subgroup.closure_le _).mpr ?_
    rintro y ⟨j, hj, z, hz, rfl⟩
    let j0 : ↥(G0 c P J) := ⟨j, Subgroup.mem_sup_left hj⟩
    let z0 : ↥(G0 c P J) := ⟨z, Subgroup.mem_sup_right hz⟩
    have hzX : z0 ∈ Xcl c P J :=
      Subgroup.subset_normalClosure (Subgroup.mem_subgroupOf.mpr hz)
    have hprod : j0 * z0 * j0⁻¹ * z0⁻¹ ∈ Xcl c P J := by
      have hconj : j0 * z0 * j0⁻¹ ∈ Xcl c P J :=
        (Subgroup.normalClosure_normal (s := ((Z0 c P J : Subgroup ↥(G0 c P J)) :
          Set ↥(G0 c P J)))).conj_mem z0 hzX j0
      exact (Xcl c P J).mul_mem hconj ((Xcl c P J).inv_mem hzX)
    exact Subgroup.mem_map.mpr ⟨j0 * z0 * j0⁻¹ * z0⁻¹, hprod,
      by simp [j0, z0, commutatorElement_def]⟩
  intro x hx
  rw [Subgroup.mem_subgroupOf] at hx
  have hxmap : ((x : ↥(G0 c P J)) : G) ∈ (Xcl c P J).map (G0 c P J).subtype := hKleXmap hx
  obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hxmap
  rwa [show y = x from Subtype.ext hyx] at hy

theorem rank_two_of_f9' (hF9 : F9Input c P a)
    (hON : UCK.ThreeCover (fun Y _ => IsSpor Y .ONan) c.Lbar) (h7 : D.sig = {7})
    (hP : CFSG.ABGLocalTools.IsSylowOf 3 P D.M)
    (hNZ : Subgroup.normalizer ((zSub P c.L : Subgroup G) : Set G) ≤ D.M)
    (haL : a ∈ P ⊓ c.L) (ha3 : orderOf a = 3) (haZ : a ∉ zSub P c.L)
    {J : Subgroup G} (hJ : J ∈ thetaComponentsAt 3 a) (h3 : 3 ∣ Nat.card J)
    {z : G} (hzZ : z ∈ zSub P c.L) (hz3 : orderOf z = 3)
    (hzN : z ∈ Subgroup.normalizer (J : Set G))
    (hSch : CFSG.AGLEmbedding.KFactCatalogSchreier)
    (hπ : thetaQuotMulAut J (J.normalizerMonoidHom ⟨z, hzN⟩) ≠ 1) :
    2 ≤ CFSG.Open.pRank 3 (Xcl c P J) := by
  classical
  let Z : Subgroup G := zSub P c.L
  let K : Subgroup G := ⁅J, Z⁆
  have hIJ : Ia c a ≤ Subgroup.normalizer (J : Set G) :=
    Ia_le_normalizer_of_f9_c c hF9 hON h7 hP hNZ haL ha3 haZ hJ h3
  have hZJ : Z ≤ Subgroup.normalizer (J : Set G) := by
    simpa only [Z] using hF9.2.1.trans hIJ
  have hKle : K ≤ J := by
    simpa only [K, Z] using commutator_le_of_le_normalizer hZJ
  have hKG0 : K ≤ G0 c P J := hKle.trans le_sup_left
  have hπtop : Subgroup.map (QuotientGroup.mk' (aschbacherSolvableCore 3 ↥J))
      (K.subgroupOf J) = ⊤ := by
    simpa only [K, Z] using commutator_map_theta_eq_top c hJ hZJ hzZ hzN hπ
  have hJtrrank : 2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (Jtilde J)) :=
    two_le_pRank_three_jtilde_of_f9 c hF9 hON h7 hP hNZ haL ha3 haZ hJ h3 hzZ hz3 hzN hSch hπ
  let KJ : Subgroup ↥J := K.subgroupOf J
  let πJ : ↥J →* Jtilde J := QuotientGroup.mk' (aschbacherSolvableCore 3 ↥J)
  have hKJnormal : KJ.Normal := by
    simpa only [KJ, K, Z] using Subgroup.normal_subgroupOf_of_le_normalizer
      (commutator_le_normalizer_commutator (J := J) (Z := Z))
  let f : ↥KJ →* Jtilde J := πJ.comp KJ.subtype
  have hfsurj : Function.Surjective f := by
    have hrange : f.range = ⊤ := by
      rw [MonoidHom.range_eq_map]
      change Subgroup.map (πJ.comp KJ.subtype) ⊤ = ⊤
      rw [← Subgroup.map_map]
      rw [show Subgroup.map KJ.subtype (⊤ : Subgroup ↥KJ) = KJ from by
        rw [← MonoidHom.range_eq_map]
        exact Subgroup.subtype_range KJ]
      exact hπtop
    exact MonoidHom.range_eq_top.mp hrange
  have hkerEq : f.ker = aschbacherSolvableCore 3 ↥KJ := by
    rw [show f.ker = πJ.ker.comap KJ.subtype from (MonoidHom.comap_ker πJ KJ.subtype).symm]
    rw [show πJ.ker = aschbacherSolvableCore 3 ↥J from
      QuotientGroup.ker_mk' (N := aschbacherSolvableCore 3 ↥J)]
    exact (aschbacherSolvableCore_eq_subgroupOf Nat.prime_three hKJnormal.isSubnormal).symm
  have hker3 : ¬ 3 ∣ Nat.card ↥f.ker := by
    rw [hkerEq]
    exact (solvable_prime_complement_core_characterization Nat.prime_three).2.2.1
  have hKJrank : 2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup ↥KJ) := by
    have heq := CFSG.pRank_map_eq_of_not_dvd_card_ker f hfsurj Nat.prime_three hker3
      (⊤ : Subgroup ↥KJ)
    rw [Subgroup.map_top_of_surjective f hfsurj] at heq
    rw [← heq]
    exact hJtrrank
  have hKrank : 2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup ↥K) := by
    rw [← CFSG.SectionRank.pRank_top_eq_of_mulEquiv (p := 3) (by norm_num)
      (Subgroup.subgroupOfEquivOfLe hKle)]
    exact hKJrank
  have hKsubrank : 2 ≤ CFSG.Open.pRank 3 (K.subgroupOf (G0 c P J)) := by
    rw [CFSG.SectionRank.pRank_eq_pRank_top_subgroup]
    rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv (p := 3) (by norm_num)
      (Subgroup.subgroupOfEquivOfLe hKG0)]
    exact hKrank
  have hKX : K.subgroupOf (G0 c P J) ≤ Xcl c P J := by
    simpa only [K, Z] using commutator_subgroupOf_le_Xcl (c := c) (P := P) (J := J)
  exact hKsubrank.trans (CFSG.SectionRank.pRank_mono (p := 3) (by norm_num) hKX)

end
