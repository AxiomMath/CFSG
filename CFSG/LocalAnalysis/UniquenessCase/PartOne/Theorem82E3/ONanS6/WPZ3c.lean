    (hPSz : CFSG.RankThree.PartTwo.KFacts.KPSz)
    (hSzB : Sz.SzBorel) (hSzO : Sz.SzOutOdd) (hSzF : Sz.SzFix) (c : Ctx82E3 D)
    (hON : UCK.ThreeCover (fun Y _ => IsSpor Y .ONan) c.Lbar) (h7 : D.sig = {7})
    {P : Subgroup G} (hP : CFSG.ABGLocalTools.IsSylowOf 3 P D.M)
    (hNZ : Subgroup.normalizer ((zSub P c.L : Subgroup G) : Set G) ≤ D.M)
    (hZcard : Nat.card (zSub P c.L) = 3)
    {e : G} (he : e ∈ P ⊓ c.L) (he3 : orderOf e = 3) (heZ : e ∉ zSub P c.L) :
    thetaJ 3 (zSub P c.L ⊔ Subgroup.zpowers e) ≠ ⊥ := by
  classical
  letI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hZcent : zSub P c.L ≤
      Subgroup.centralizer ((P ⊓ c.L : Subgroup G) : Set G) := inf_le_right
  have hcomm : ∀ a ∈ zSub P c.L, a * e = e * a := by
    intro a ha
    exact (Subgroup.mem_centralizer_iff.mp (hZcent ha) e he).symm
  obtain ⟨hEea, hEcard⟩ :=
    CFSG.GroupTheory.isElemAbelian_sup_zpowers_of_commute (r := 3) hZcard he3 heZ hcomm
  have hEcard9 : Nat.card ↥(zSub P c.L ⊔ Subgroup.zpowers e) = 9 := by
    rw [hEcard]; norm_num
  have hE_le_PL : zSub P c.L ⊔ Subgroup.zpowers e ≤ P ⊓ c.L :=
    sup_le inf_le_left (Subgroup.zpowers_le.mpr he)
  have hE_le_M : zSub P c.L ⊔ Subgroup.zpowers e ≤ D.M :=
    hE_le_PL.trans (inf_le_left.trans hP.le)
  have hQ2 : IsPGroup 2 (CFSG.Open.pCoreOf 2 D.M) :=
    (show IsPGroup 2 (CFSG.pCore 2 ↥D.M) from CFSG.pCore_isPGroup).map D.M.subtype
  have hMnormQ : D.M ≤ Subgroup.normalizer ((CFSG.Open.pCoreOf 2 D.M : Subgroup G) : Set G) :=
    CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 D.M
  have hEN : zSub P c.L ⊔ Subgroup.zpowers e ≤
      Subgroup.normalizer ((CFSG.Open.pCoreOf 2 D.M : Subgroup G) : Set G) :=
    hE_le_M.trans hMnormQ
  have hθ : ∀ f ∈ zSub P c.L ⊔ Subgroup.zpowers e, f ≠ 1 →
      CFSG.Open.pCoreOf 2 D.M ⊓ Subgroup.centralizer ({f} : Set G) ≤
        inSubgroup (aschbacherSolvableCore 3) (Subgroup.centralizer ({f} : Set G)) := by
    intro f hf hf1
    have hf3 : orderOf f = 3 :=
      orderOf_eq_prime (p := 3) (hEea.2 f hf) hf1
    by_cases hfZ : f ∈ zSub P c.L
    ·
      have hC_le_M : Subgroup.centralizer ({f} : Set G) ≤ D.M :=
        centralizer_le_of_mem_zSub_wPT c hZcard hNZ hf3 hfZ
      have hCnormQ : Subgroup.centralizer ({f} : Set G) ≤
          Subgroup.normalizer ((CFSG.Open.pCoreOf 2 D.M : Subgroup G) : Set G) :=
        hC_le_M.trans hMnormQ
      have hnormal : ((CFSG.Open.pCoreOf 2 D.M ⊓
          Subgroup.centralizer ({f} : Set G)).subgroupOf
            (Subgroup.centralizer ({f} : Set G))).Normal :=
        (Subgroup.normal_subgroupOf_iff_le_normalizer inf_le_right).mpr fun x hx =>
          Subgroup.inf_normalizer_le_normalizer_inf
            ⟨hCnormQ hx, Subgroup.le_normalizer hx⟩
      have hQinf2 : IsPGroup 2 ↥(CFSG.Open.pCoreOf 2 D.M ⊓
          Subgroup.centralizer ({f} : Set G)) := hQ2.to_le inf_le_left
      have hQsolv : Group.IsSolvable ↥(CFSG.Open.pCoreOf 2 D.M ⊓
          Subgroup.centralizer ({f} : Set G)) := by
        have : Group.IsNilpotent ↥(CFSG.Open.pCoreOf 2 D.M ⊓
            Subgroup.centralizer ({f} : Set G)) := hQinf2.isNilpotent
        infer_instance
      have hQcop : ¬ 3 ∣ Nat.card ↥(CFSG.Open.pCoreOf 2 D.M ⊓
          Subgroup.centralizer ({f} : Set G)) :=
        CFSG.GroupTheory.not_dvd_card_of_isPGroup (p := 2) hQinf2 Nat.prime_three (by norm_num)
      have hle := normal_solvable_primeComplement_le_thetaCoreOf
        3 (CFSG.Open.pCoreOf 2 D.M ⊓ Subgroup.centralizer ({f} : Set G))
        (Subgroup.centralizer ({f} : Set G)) inf_le_right hnormal hQsolv hQcop
      simpa only [theta3,
        CFSG.RankThree.LocalRank.inSubgroup_aschbacherSolvableCore_eq_thetaCoreOf
          Nat.prime_three] using hle
    ·
      have hfPL : f ∈ P ⊓ c.L := hE_le_PL hf
      have hle := pcore_centralizer_le_theta'' hK hK12 hK9o hK9out hK9f hK9r hK2 hK9b hK4
        hSch hPSz hSzB hSzO hSzF c hON h7 hP hNZ hfPL hf3 hfZ
      simpa only [inf_comm] using hle
  have hnc : ¬ zSub P c.L ⊔ Subgroup.zpowers e ≤
      Subgroup.centralizer ((CFSG.Open.pCoreOf 2 D.M : Subgroup G) : Set G) := by
    intro hEc
    have heC : e ∈ Subgroup.centralizer ((CFSG.Open.pCoreOf 2 D.M : Subgroup G) : Set G) :=
      hEc (Subgroup.mem_sup_right (Subgroup.mem_zpowers e))
    have heM : e ∈ D.M := hP.le he.1
    have heQ : e ∈ CFSG.Open.pCoreOf 2 D.M :=
      D.standing.charTwo D.M D.maxLocal.1 (Subgroup.mem_inf.mpr ⟨heM, heC⟩)
    have hdvd : 3 ∣ Nat.card ↥(CFSG.Open.pCoreOf 2 D.M) := by
      rw [← he3, ← Nat.card_zpowers]
      exact Subgroup.card_dvd_of_le (Subgroup.zpowers_le.mpr heQ)
    exact (CFSG.GroupTheory.not_dvd_card_of_isPGroup hQ2 Nat.prime_three (by norm_num)) hdvd
  haveI : CFSG.IsElementaryAbelian 3 ↥(zSub P c.L ⊔ Subgroup.zpowers e) :=
    hEea.isElementaryAbelian
  exact thetaJ_ne_bot_of_le_theta (E := zSub P c.L ⊔ Subgroup.zpowers e)
    (Q := CFSG.Open.pCoreOf 2 D.M) hQ2 hEN hEcard9 hθ hnc

