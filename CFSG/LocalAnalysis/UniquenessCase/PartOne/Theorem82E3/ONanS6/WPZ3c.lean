theorem k341_hyps_noncenter'
    (hK : K332Z3) (hK12 : K12SL) (hK9o : K9J2Order)
    (hK9out : K9J2Out) (hK9f : K9Five) (hK9r : K9G2Rank) (hK2 : K2ONanCentralizer)
    (hK9b : K9bIn) (hK4 : K4) (hK8 : K8Cat)
    (hSch : CFSG.AGLEmbedding.KFactCatalogSchreier)
    (hPSz : CFSG.RankThree.PartTwo.KFacts.KPSz) (c : Ctx82E3 D)
    (hON : UCK.ThreeCover (fun Y _ => IsSpor Y .ONan) c.Lbar) (h7 : D.sig = {7})
    {P A : Subgroup G} (hP : CFSG.ABGLocalTools.IsSylowOf 3 P D.M)
    (hNZ : Subgroup.normalizer ((zSub P c.L : Subgroup G) : Set G) ≤ D.M)
    (hA : CFSG.Open.IsElemAbelian 3 A) (hA27 : Nat.card A = 27) (hZA : zSub P c.L ≤ A)
    (hAPL : A ≤ P ⊓ c.L)
    {x : G} (hx : x ∈ A) (hxZ : x ∉ zSub P c.L) :
    (∀ L ∈ thetaComponentsAt 3 x, A ≤ Subgroup.normalizer (L : Set G)) ∧
    (∀ L ∈ thetaComponentsAt 3 x, Nat.card (autThetaQuot A L) ≠ 9) := by
  classical
  have hx1 : x ≠ 1 := by
    intro h
    rw [h] at hxZ
    exact hxZ (Subgroup.one_mem _)
  have hxPL : x ∈ P ⊓ c.L := hAPL hx
  have hx3 : x ^ 3 = 1 := hA.2 x hx
  have hxord : orderOf x = 3 := orderOf_eq_prime hx3 hx1
  have hAp : IsPGroup 3 A := IsPGroup.of_card (n := 3) (by rw [hA27]; norm_num)
  have h1 : ∀ L ∈ thetaComponentsAt 3 x, A ≤ Subgroup.normalizer (L : Set G) := by
    intro L hL u huA
    by_cases h3L : 3 ∣ Nat.card L
    · refine normalizer_thetaComp_of_three_element' c hON h7 hP hNZ hxPL hxord hxZ hL h3L ?_ ?_
      · refine Subgroup.mem_centralizer_singleton_iff.mpr ?_
        exact congrArg Subtype.val
          (hA.1.is_comm.comm (⟨u, huA⟩ : A) (⟨x, hx⟩ : A))
      · exact hAp.to_le (Subgroup.zpowers_le.mpr huA)
    · exact normalizer_suzukiComp'' c hPSz hK8 hON h7 hP hNZ hA hA27 hZA hAPL hx hxZ hL h3L huA
  refine ⟨h1, ?_⟩
  intro L hL
  by_cases h3L : 3 ∣ Nat.card L
  ·
    have hZ3 : Nat.card (autThetaQuot (zSub P c.L) L) = 1 :=
      z_acts_trivially_threeComp' c hK hK12 hK9o hK9out hK9f hK9r hK2 hK9b hK4 hSch
        hON h7 hP hNZ hxPL hxord hxZ hL h3L
    have hbot : autThetaQuot (zSub P c.L) L = ⊥ :=
      Subgroup.eq_bot_of_card_eq _ hZ3
    have hAN : A ≤ Subgroup.normalizer (L : Set G) := h1 L hL
    have hZK : zSub P c.L ≤ thetaQuotCentralizer L := by
      intro z hz
      have hzN : z ∈ Subgroup.normalizer (L : Set G) := hAN (hZA hz)
      have hzmem : thetaQuotMulAut L (L.normalizerMonoidHom ⟨z, hzN⟩) ∈
          autThetaQuot (zSub P c.L) L :=
        mem_autThetaQuot_iff.mpr ⟨z, hzN, hz, rfl⟩
      have hz1 : thetaQuotMulAut L (L.normalizerMonoidHom ⟨z, hzN⟩) = 1 := by
        rw [hbot] at hzmem
        exact Subgroup.mem_bot.mp hzmem
      exact Subgroup.mem_map.mpr ⟨⟨z, hzN⟩, MonoidHom.mem_ker.mpr hz1, rfl⟩
    have hxK : x ∈ thetaQuotCentralizer L := by
      have hxN : x ∈ Subgroup.normalizer (L : Set G) := hAN hx
      have hLle : L ≤ Subgroup.centralizer ({x} : Set G) :=
        (CFSG.RankThree.PartOne.mem_thetaComponentsAt_iff.mp hL).1
      have hx1' : thetaQuotMulAut L (L.normalizerMonoidHom ⟨x, hxN⟩) = 1 := by
        have hσ : L.normalizerMonoidHom ⟨x, hxN⟩ = 1 := by
          refine MulEquiv.ext fun l => Subtype.ext ?_
          change x * (l : G) * x⁻¹ = (l : G)
          have hl : (l : G) * x = x * (l : G) :=
            Subgroup.mem_centralizer_singleton_iff.mp (hLle l.2)
          rw [← hl]
          group
        rw [hσ, map_one]
      exact Subgroup.mem_map.mpr ⟨⟨x, hxN⟩, MonoidHom.mem_ker.mpr hx1', rfl⟩
    have hZKle : zSub P c.L ≤ A ⊓ thetaQuotCentralizer L := le_inf hZA hZK
    have hxKle : x ∈ A ⊓ thetaQuotCentralizer L := ⟨hx, hxK⟩
    have hZne : zSub P c.L ≠ ⊥ := by
      intro hZbot
      have htop : Subgroup.normalizer ((zSub P c.L : Subgroup G) : Set G) = ⊤ := by
        rw [hZbot]
        simpa using (Subgroup.normalizer_eq_top (H := (⊥ : Subgroup G)))
      exact c.M_ne_top (top_le_iff.mp (htop ▸ hNZ))
    have hprod : Nat.card (A ⊓ thetaQuotCentralizer L : Subgroup G) *
        Nat.card (autThetaQuot A L) = 27 := by
      have := CFSG.RankThree.PartTwo.Sec13.card_inf_mul_card_autThetaQuot (A := A) (L := L) hAN
      simpa [hA27] using this
    intro h9
    have hcard3 : Nat.card (A ⊓ thetaQuotCentralizer L : Subgroup G) = 3 := by
      rw [h9] at hprod
      omega
    have hZcard : Nat.card (zSub P c.L) = 3 := by
      have hdvd : Nat.card (zSub P c.L) ∣
          Nat.card (A ⊓ thetaQuotCentralizer L : Subgroup G) :=
        Subgroup.card_dvd_of_le hZKle
      rw [hcard3] at hdvd
      have hne1 : Nat.card (zSub P c.L) ≠ 1 :=
        fun h1 => hZne (Subgroup.eq_bot_of_card_eq _ h1)
      rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h | h
      · exact absurd h hne1
      · exact h
    have hZeq : zSub P c.L = A ⊓ thetaQuotCentralizer L :=
      Subgroup.eq_of_le_of_card_ge hZKle (by omega)
    exact hxZ (by rw [hZeq]; exact hxKle)
  ·
    have hout : IsCyclic (Outer (L ⧸ aschbacherSolvableCore 3 L)) :=
      isCyclic_outer_thetaQuot_of_mem_thetaComponentsAt hPSz c hx1 hL h3L
    have h3Q : ¬ 3 ∣ Nat.card (L ⧸ aschbacherSolvableCore 3 L) := by
      intro h
      exact h3L (h.trans (Subgroup.card_quotient_dvd_card (aschbacherSolvableCore 3 L)))
    have hle : Nat.card (autThetaQuot A L) ≤ 3 :=
      card_le_three_of_isCyclic_outer h3Q hout
        (fun τ hτ => CFSG.RankThree.PartTwo.Sec13.autThetaQuot_pow_three (fun a ha => hA.2 a ha) hτ)
    intro h9
    omega

end
