          (QuotientGroup.mk' (CFSG.RankThree.LocalRank.aschbacherSolvableCore 3 ↥H)) ≤
        Subgroup.centralizer (J : Set _) := by
    intro J hJ
    simpa [W, H] using
      pcore_centralizer_le_theta_components' hPSz hSzB hSzO hSzF c hON h7 hP hNZ hP3 hZ3
        he he3 heZ hStep2 hStep3 J hJ
  have hle : W.subgroupOf H ≤
      CFSG.RankThree.LocalRank.aschbacherSolvableCore 3 ↥H :=
    CFSG.RankThree.GroupTheory.le_solvableCore_of_centralizes_pCore_three_and_components
      (H := ↥H) (W := W.subgroupOf H)
      hW2 hO3 hcomp
  have hmap : (W.subgroupOf H).map H.subtype = W :=
    Subgroup.map_subgroupOf_eq_of_le (inf_le_left : W ≤ H)
