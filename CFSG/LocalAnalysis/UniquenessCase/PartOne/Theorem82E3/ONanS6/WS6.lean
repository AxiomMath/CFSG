open CFSG.Open
open CFSG.RankThree CFSG.RankThree.LocalRank CFSG.RankThree.PartTwo.Sec4
open CFSG.RankThree.PartOne (IsStronglyPEmbedded)
open CFSG.LocalAnalysis.UniquenessCase.UC22 (Data IsSpor IsAlt)
open CFSG.ASVolI.ChIJK (IsWeaklyClosedIn)
open CFSG.Blueprint (LieModel)
variable {G : Type} [Group G] [Finite G]

abbrev zSub (P L : Subgroup G) : Subgroup G :=
  (P ⊓ L) ⊓ Subgroup.centralizer ((P ⊓ L : Subgroup G) : Set G)

@[expose] def GammaP (P M : Subgroup G) : Prop :=
  ∀ U : Subgroup G, U ≤ P → ¬ IsCyclic U → Subgroup.normalizer (U : Set G) ≤ M

noncomputable abbrev theta3 (X : Subgroup G) : Subgroup G :=
  inSubgroup (aschbacherSolvableCore 3) X

theorem strongly_embedded_quot_of_gamma {M P T : Subgroup G} {x : G}
    [((Subgroup.zpowers x).subgroupOf (Subgroup.centralizer ({x} : Set G))).Normal]
    (hT : CFSG.ABGLocalTools.IsSylowOf 3 T (Subgroup.centralizer ({x} : Set G)))
    (hx3 : orderOf x = 3) (hxT : Subgroup.zpowers x < T)
    (hTP : T ≤ P) (hPM : P ≤ M) (hΓ : GammaP P M)
    (hnc : ∀ U : Subgroup G, U ≤ T → Subgroup.zpowers x < U → ¬ IsCyclic U)
    (hlt : ¬ Subgroup.centralizer ({x} : Set G) ≤ M) :
    IsStronglyPEmbedded 3
      (((Subgroup.centralizer ({x} : Set G) ⊓ M).subgroupOf
          (Subgroup.centralizer ({x} : Set G))).map
        (QuotientGroup.mk' ((Subgroup.zpowers x).subgroupOf
          (Subgroup.centralizer ({x} : Set G))))) := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set C : Subgroup G := Subgroup.centralizer ({x} : Set G) with hCdef
  set K : Subgroup C := (Subgroup.zpowers x).subgroupOf C with hKdef
  set N : Subgroup C := (C ⊓ M).subgroupOf C with hNdef
  set Nstar : Subgroup (C ⧸ K) := N.map (QuotientGroup.mk' K) with hNstardef
  change CFSG.RankThree.PartOne.IsStronglyPEmbedded 3 Nstar
  haveI hKnormal : K.Normal := by
    rw [hKdef, hCdef]
    exact inferInstance
  have hxC : x ∈ C := by
    rw [hCdef]
    exact Subgroup.mem_centralizer_singleton_iff.mpr rfl
  have hzxC : Subgroup.zpowers x ≤ C := Subgroup.zpowers_le.mpr hxC
  have hzxT : Subgroup.zpowers x ≤ T := le_of_lt hxT
  have hTM : T ≤ M := hTP.trans hPM
  have hKcard : Nat.card K = 3 := by
    rw [hKdef]
    calc Nat.card ((Subgroup.zpowers x).subgroupOf C)
        = Nat.card (Subgroup.zpowers x) :=
          Nat.card_congr (Subgroup.subgroupOfEquivOfLe hzxC).toEquiv
      _ = orderOf x := Nat.card_zpowers x
      _ = 3 := hx3
  have hKp : IsPGroup 3 K := IsPGroup.of_card (n := 1) (by simpa using hKcard)
  have hKN : K ≤ N := by
    intro k hk
    rw [hNdef]
    exact Subgroup.mem_subgroupOf.mpr
      ⟨k.2, hTM (hzxT (Subgroup.mem_subgroupOf.mp hk))⟩
  have hKT : K ≤ T.subgroupOf C := by
    intro k hk
    exact Subgroup.mem_subgroupOf.mpr (hzxT (Subgroup.mem_subgroupOf.mp hk))
  have hNne : Nstar ≠ ⊤ := by
    intro htop
    obtain ⟨h, hhC, hhM⟩ := Set.not_subset.mp hlt
    let hC : C := ⟨h, hhC⟩
    have hmem : QuotientGroup.mk' K hC ∈ Nstar := by
      rw [htop]
      exact Subgroup.mem_top _
    rw [hNstardef, Subgroup.mem_map] at hmem
    obtain ⟨n, hn, hmn⟩ := hmem
    have hker : n⁻¹ * hC ∈ K := by
      refine (QuotientGroup.eq_one_iff (n⁻¹ * hC)).mp ?_
      calc QuotientGroup.mk' K (n⁻¹ * hC)
          = (QuotientGroup.mk' K n)⁻¹ * (QuotientGroup.mk' K hC) := by
            rw [map_mul, map_inv]
        _ = 1 := by rw [hmn, inv_mul_cancel]
    have hhN : hC ∈ N := by
      have hmem' : n * (n⁻¹ * hC) ∈ N := N.mul_mem hn (hKN hker)
      rwa [mul_inv_cancel_left] at hmem'
    exact hhM (Subgroup.mem_subgroupOf.mp hhN).2
  set S : Subgroup (C ⧸ K) := (T.subgroupOf C).map (QuotientGroup.mk' K) with hSdef
  have hTCN : T.subgroupOf C ≤ N := by
    intro t ht
    rw [hNdef]
    exact Subgroup.mem_subgroupOf.mpr
      ⟨t.2, hTM (Subgroup.mem_subgroupOf.mp ht)⟩
  have hSle : S ≤ Nstar := by
    rw [hSdef, hNstardef]
    exact Subgroup.map_mono hTCN
  have hTCp : IsPGroup 3 (T.subgroupOf C) :=
    hT.isPGroup.of_equiv (Subgroup.subgroupOfEquivOfLe hT.le).symm
  have hSp : IsPGroup 3 S := by
    rw [hSdef]
    exact hTCp.map (QuotientGroup.mk' K)
  have hTCne : T.subgroupOf C ≠ K := by
    intro hEq
    have hcardTC : Nat.card (T.subgroupOf C) = Nat.card T :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hT.le).toEquiv
    have hcardT : 3 < Nat.card T := by
      have := Subgroup.card_lt_of_lt hxT
      rwa [Nat.card_zpowers, hx3] at this
    rw [hEq, hKcard] at hcardTC
    omega
  have hSne : S ≠ ⊥ := by
    rw [hSdef]
    intro hbot
    have hle : T.subgroupOf C ≤ K := by
      have h := (Subgroup.map_eq_bot_iff (H := T.subgroupOf C) (f := QuotientGroup.mk' K)).mp hbot
      rwa [QuotientGroup.ker_mk'] at h
    exact hTCne (le_antisymm hle hKT)
  have hpS : 3 ∣ Nat.card S :=
    (hSp.card_eq_or_dvd).resolve_left fun h => hSne (Subgroup.card_eq_one.mp h)
  have hdiv : 3 ∣ Nat.card Nstar :=
    dvd_trans hpS (Subgroup.card_dvd_of_le hSle)
  refine CFSG.LocalAnalysis.RankThreeUC.isStronglyPEmbedded_of_normalizer_le hNne hdiv ?_
  intro Q' hQ'ne hQ'p hQ'le
  set U : Subgroup C := Q'.comap (QuotientGroup.mk' K) with hUdef
  have hKU : K ≤ U := by
    intro k hk
    rw [hUdef, Subgroup.mem_comap]
    have hk1 : QuotientGroup.mk' K k = 1 := (QuotientGroup.eq_one_iff k).mpr hk
    rw [hk1]
    exact Q'.one_mem
  have hU_le_N : U ≤ N := by
    intro u hu
    have hmu : QuotientGroup.mk' K u ∈ Nstar := hQ'le (Subgroup.mem_comap.mp hu)
    rw [hNstardef, Subgroup.mem_map] at hmu
    obtain ⟨n, hn, hmn⟩ := hmu
    have hker : n⁻¹ * u ∈ K := by
      refine (QuotientGroup.eq_one_iff (n⁻¹ * u)).mp ?_
      calc QuotientGroup.mk' K (n⁻¹ * u)
          = (QuotientGroup.mk' K n)⁻¹ * (QuotientGroup.mk' K u) := by
            rw [map_mul, map_inv]
        _ = 1 := by rw [hmn, inv_mul_cancel]
    have huN : u ∈ N := by
      have hmem : n * (n⁻¹ * u) ∈ N := N.mul_mem hn (hKN hker)
      rwa [mul_inv_cancel_left] at hmem
    exact huN
  have hUp : IsPGroup 3 U := by
    rw [hUdef]
    exact IsPGroup.comap_of_ker_isPGroup hQ'p (QuotientGroup.mk' K)
      (by rw [QuotientGroup.ker_mk']; exact hKp)
  have hKU_lt : K < U := by
    refine lt_of_le_of_ne hKU ?_
    intro hEq
    have hmap : U.map (QuotientGroup.mk' K) = Q' := by
      rw [hUdef]
      exact Subgroup.map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective K) Q'
    have hbot : Q' = ⊥ := by
      rw [← hmap, ← hEq, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
    exact hQ'ne hbot
  set U_G : Subgroup G := U.map C.subtype with hUGdef
  have hUG_le_CM : U_G ≤ C ⊓ M := by
    intro g hg
    rw [hUGdef, Subgroup.mem_map] at hg
    obtain ⟨u, hu, rfl⟩ := hg
    exact ⟨u.2, (Subgroup.mem_subgroupOf.mp (hU_le_N hu)).2⟩
  have hUGp : IsPGroup 3 U_G := by
    rw [hUGdef]
    exact hUp.map C.subtype
  have hTCM : T ≤ C ⊓ M := le_inf hT.le hTM
  have hT_CM : CFSG.ABGLocalTools.IsSylowOf 3 T (C ⊓ M) := hT.of_le hTCM inf_le_left
  obtain ⟨P, hP, hUP⟩ :=
    CFSG.LocalAnalysis.UniquenessCase.UCK.N588A.exists_isSylowOf_ge_of_le hUG_le_CM hUGp
  obtain ⟨c, hcCM, hconj⟩ :=
    CFSG.ABGLocalTools.IsSylowOf.exists_mem_conj hT_CM hP
  have hcC : c ∈ C := hcCM.1
  have hcM : c ∈ M := hcCM.2
  set U0 : Subgroup G := U_G.map ((MulAut.conj c)⁻¹).toMonoidHom with hU0def
  have hU0T : U0 ≤ T := by
    intro g hg
    rw [hU0def, Subgroup.mem_map] at hg
    obtain ⟨u, hu, rfl⟩ := hg
    change (MulAut.conj c)⁻¹ u ∈ T
    rw [MulAut.conj_inv_apply]
    exact (hconj u).mp (hUP hu)
  have hzxU : Subgroup.zpowers x ≤ U_G := by
    have hKmap : K.map C.subtype = Subgroup.zpowers x := by
      rw [hKdef, Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hzxC]
    rw [← hKmap]
    exact Subgroup.map_mono hKU
  have hzxU0 : Subgroup.zpowers x ≤ U0 := by
    intro z hz
    rw [hU0def, Subgroup.mem_map]
    refine ⟨z, hzxU hz, ?_⟩
    change (MulAut.conj c)⁻¹ z = z
    rw [MulAut.conj_inv_apply]
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hz
    have hcx : Commute c x :=
      (commute_iff_eq c x).mpr (Subgroup.mem_centralizer_singleton_iff.mp hcC)
    have hcz : c * z = z * c := by
      rw [← hn]
      exact (hcx.zpow_right n).eq
    have hcz' : c⁻¹ * z = z * c⁻¹ :=
      ((commute_iff_eq c z).mpr hcz).inv_left.eq
    rw [hcz']
    group
  have hU0card : 3 < Nat.card U0 := by
    have h1 : Nat.card U0 = Nat.card U_G :=
      Subgroup.card_map_of_injective ((MulAut.conj c)⁻¹).injective
    have h2 : Nat.card U_G = Nat.card U :=
      Subgroup.card_map_of_injective C.subtype_injective
    have h3 : Nat.card K < Nat.card U := Subgroup.card_lt_of_lt hKU_lt
    calc 3 = Nat.card K := hKcard.symm
      _ < Nat.card U := h3
      _ = Nat.card U_G := h2.symm
      _ = Nat.card U0 := h1.symm
  have hzxU0_lt : Subgroup.zpowers x < U0 := by
    refine lt_of_le_of_ne hzxU0 ?_
    intro hEq
    have hcard : Nat.card U0 = 3 := by
      rw [← hEq, Nat.card_zpowers, hx3]
    omega
  have hncU0 : ¬ IsCyclic U0 := hnc U0 hU0T hzxU0_lt
  have hN0 : Subgroup.normalizer (U0 : Set G) ≤ M := hΓ U0 (hU0T.trans hTP) hncU0
  have hU_G_eq : U_G = U0.map (MulAut.conj c).toMonoidHom := by
    rw [hU0def, Subgroup.map_map]
    have hcomp : ((MulAut.conj c).toMonoidHom).comp (((MulAut.conj c)⁻¹).toMonoidHom) =
        MonoidHom.id G := by
      ext y
      change (MulAut.conj c) (((MulAut.conj c)⁻¹) y) = y
      rw [MulAut.conj_inv_apply, MulAut.conj_apply]
      group
    rw [hcomp, Subgroup.map_id]
  have hNUG : Subgroup.normalizer (U_G : Set G) ≤ M := by
    have hmapN := Subgroup.map_equiv_normalizer_eq U0 (MulAut.conj c)
    rw [← hU_G_eq] at hmapN
    rw [← hmapN]
    intro g hg
    rw [Subgroup.mem_map] at hg
    obtain ⟨n, hn, hgn⟩ := hg
    rw [← hgn]
    change (MulAut.conj c) n ∈ M
    rw [MulAut.conj_apply]
    exact M.mul_mem (M.mul_mem hcM (hN0 hn)) (M.inv_mem hcM)
  intro q hq
  obtain ⟨h, rfl⟩ := QuotientGroup.mk'_surjective K q
  have hh_normU : h ∈ Subgroup.normalizer (U : Set C) := by
    have hmem : h ∈ (Subgroup.normalizer (Q' : Set (C ⧸ K))).comap (QuotientGroup.mk' K) :=
      Subgroup.mem_comap.mpr hq
    rw [Subgroup.comap_normalizer_eq_of_surjective Q' (QuotientGroup.mk'_surjective K)] at hmem
    simpa [hUdef] using hmem
  have hh_normUG : (h : G) ∈ Subgroup.normalizer (U_G : Set G) := by
    have hmem := Subgroup.le_normalizer_map C.subtype (Subgroup.mem_map_of_mem C.subtype hh_normU)
    simpa [hUGdef] using hmem
  have hhM : (h : G) ∈ M := hNUG hh_normUG
  have hhN : h ∈ N := by
    rw [hNdef]
    exact Subgroup.mem_subgroupOf.mpr ⟨h.2, hhM⟩
  rw [hNstardef]
  exact Subgroup.mem_map_of_mem (QuotientGroup.mk' K) hhN

end
end CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82E3.ONan

