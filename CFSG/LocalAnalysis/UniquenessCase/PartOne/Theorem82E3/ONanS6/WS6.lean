@[expose] def K9bIn : Prop :=
  ∀ (S : Type) [Group S] [Finite S], IsSimpleGroup S → (∃ a b : S, a * b ≠ b * a) →
    CFSG.Assembly.InCatalog S → Nat.card S ∣ 6480 → IsAlt S 5 ∨ IsAlt S 6

theorem K9bIn_holds :
    K9bIn := by
  intro S _ _ hS hnonab hIn hcard
  haveI := hS
  exact K9bCat_holds S hS hnonab
    (CFSG.QuasithinUnique.B1.catalog_of_inCatalog
      CFSG.RankThree.PartOne.TCB.catalogBridgeFor_all S hIn) hcard

@[expose] def K5Gen : Prop :=
  ∀ (Y : Type) [Group Y] [Finite Y], IsSpor Y .ONan →
    ∀ S : Subgroup Y, CFSG.ABGLocalTools.IsSylowOf 3 S ⊤ →
      (⨆ (U : Subgroup Y) (_ : U ≤ S) (_ : ¬ IsCyclic U), Subgroup.normalizer (U : Set Y)) = ⊤

theorem k4_of_theta
    (h : K4Theta) : K4 := by
  intro Y _ _ hY H hH σ hσ hσ3
  exact ⟨K4ord_holds Y hY H hH σ hσ hσ3, h Y hY H hH σ hσ hσ3⟩

end
