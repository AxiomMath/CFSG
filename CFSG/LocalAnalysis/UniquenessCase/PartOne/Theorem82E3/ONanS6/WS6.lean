theorem maximal_elemAbelian_of_card27 (c : Ctx82E3 D)
    {P A : Subgroup G} (hP : CFSG.ABGLocalTools.IsSylowOf 3 P D.M)
    (hA : CFSG.Open.IsElemAbelian 3 A) (hA27 : Nat.card A = 27)
    (hZA : zSub P c.L ≤ A) (hAPL : A ≤ P ⊓ c.L)
    (hNZ : Subgroup.normalizer ((zSub P c.L : Subgroup G) : Set G) ≤ D.M) :
    Maximal (fun B : Subgroup G => CFSG.Open.IsElemAbelian 3 B) A := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  refine ⟨hA, ?_⟩
  intro B hB hAB
  have hBz : zSub P c.L ≤ B := hZA.trans hAB
  have hBcent : B ≤ Subgroup.centralizer (B : Set G) :=
    Subgroup.le_centralizer_iff_isMulCommutative.mpr hB.1
  have hcent_le : Subgroup.centralizer (B : Set G) ≤
      Subgroup.centralizer ((zSub P c.L : Subgroup G) : Set G) :=
    Subgroup.centralizer_le (fun z hz => hBz hz)
  have hBM : B ≤ D.M :=
    (hBcent.trans hcent_le).trans
      ((Subgroup.centralizer_le_normalizer ((zSub P c.L : Subgroup G) : Set G)).trans hNZ)
  obtain ⟨k, hk⟩ := (IsPGroup.iff_card (p := 3) (G := ↥B)).mp hB.isPGroup
  have hk3 : k ≤ 3 := by
    have h := CFSG.SectionRank.le_pRank (p := 3) (by norm_num) hBM hB hk
    rwa [c.pRank_three_M] at h
  have hBcard : Nat.card B ≤ 27 := by
    calc Nat.card B = 3 ^ k := hk
      _ ≤ 3 ^ 3 := Nat.pow_le_pow_right (by norm_num) hk3
      _ = 27 := by norm_num
  have hEq : A = B := Subgroup.eq_of_le_of_card_ge hAB (by
    calc Nat.card B ≤ 27 := hBcard
      _ = Nat.card A := hA27.symm)
  exact le_of_eq hEq.symm

theorem isKGroup_centralizer (c : Ctx82E3 D) {x : G} (hx1 : x ≠ 1) :
    CFSG.Open.IsKGroup ↥(Subgroup.centralizer ({x} : Set G)) := by
  haveI : IsSimpleGroup G := D.standing.simple
  refine D.standing.kProper.isKGroup _ ?_
  intro htop
  have hxcent : x ∈ Subgroup.center G := by
    rw [Subgroup.mem_center_iff]
    intro g
    have hg : g ∈ Subgroup.centralizer ({x} : Set G) := by
      rw [htop]
      exact Subgroup.mem_top g
    exact Subgroup.mem_centralizer_singleton_iff.mp hg
  have hne : Subgroup.center G ≠ ⊥ := by
    intro hbot
    have hxbot : x ∈ (⊥ : Subgroup G) := by rw [← hbot]; exact hxcent
    exact hx1 (by simpa using hxbot)
  have htop' : Subgroup.center G = ⊤ :=
    (IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center G)).resolve_left hne
  obtain ⟨a, b, hab⟩ := D.standing.nonab
  refine hab ?_
  exact (Subgroup.mem_center_iff.mp (htop' ▸ Subgroup.mem_top a) b).symm

theorem twoLocalPrimeRank_centralizer_le (c : Ctx82E3 D)
    {P A : Subgroup G} (hP : CFSG.ABGLocalTools.IsSylowOf 3 P D.M)
    (hA : CFSG.Open.IsElemAbelian 3 A) (hA27 : Nat.card A = 27)
    (hAPL : A ≤ P ⊓ c.L) {x : G} (hxA : x ∈ A) (hx1 : x ≠ 1) :
    CFSG.Open.twoLocalPrimeRank 3 ↥(Subgroup.centralizer ({x} : Set G)) ≤ 3 := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set C : Subgroup G := Subgroup.centralizer ({x} : Set G) with hC
  change CFSG.Open.twoLocalPrimeRank 3 ↥C ≤ 3
  unfold CFSG.Open.twoLocalPrimeRank
  apply csSup_le'
  rintro k ⟨H, hH, hk⟩
  rw [← hk]
  obtain ⟨Q, hQne, hQ2, rfl⟩ := hH
  have hQne' : Q.map C.subtype ≠ ⊥ := by
    intro hbot
    exact hQne ((Subgroup.map_eq_bot_iff_of_injective (H := Q) C.subtype_injective).mp hbot)
  have hQ2' : IsPGroup 2 (Q.map C.subtype) := hQ2.map C.subtype
  have hloc : CFSG.Open.IsTwoLocal
      (Subgroup.normalizer ((Q.map C.subtype : Subgroup G) : Set G)) :=
    ⟨Q.map C.subtype, hQne', hQ2', rfl⟩
  have hstep1 : CFSG.Open.pRank 3 (Subgroup.normalizer (Q : Set ↥C)) ≤
      CFSG.Open.pRank 3 ((Subgroup.normalizer (Q : Set ↥C)).map C.subtype) :=
    CFSG.SectionRank.pRank_le_map (p := 3) (by norm_num) C.subtype C.subtype_injective _
  have hstep2 : CFSG.Open.pRank 3 ((Subgroup.normalizer (Q : Set ↥C)).map C.subtype) ≤
      CFSG.Open.pRank 3 (Subgroup.normalizer ((Q.map C.subtype : Subgroup G) : Set G)) :=
    CFSG.SectionRank.pRank_mono (p := 3) (by norm_num)
      (Subgroup.le_normalizer_map (H := Q) C.subtype)
  have hstep3 : CFSG.Open.pRank 3
      (Subgroup.normalizer ((Q.map C.subtype : Subgroup G) : Set G)) ≤ 3 :=
    (CFSG.RankThreeCoreUniqueness.Helpers.local_pRank_le_evenRank 3 Nat.prime_three
      (by norm_num) _ hloc).trans (le_of_eq c.rank)
  exact hstep1.trans (hstep2.trans hstep3)

theorem normalizer_le_normalizer_alpha (c : Ctx82E3 D)
    (hON : UCK.ThreeCover (fun Y _ => IsSpor Y .ONan) c.Lbar) (h7 : D.sig = {7})
    {P : Subgroup G} (hP : CFSG.ABGLocalTools.IsSylowOf 3 P D.M)
    (hNZ : Subgroup.normalizer ((zSub P c.L : Subgroup G) : Set G) ≤ D.M)
    {E₀ : Subgroup G} (hE₀P : E₀ ≤ P) (hE₀ea : CFSG.Open.IsElemAbelian 3 E₀)
    (hE₀card : Nat.card E₀ = 9)
    (hconst : ∀ E E' : Subgroup G, E ≤ P → E' ≤ P → CFSG.Open.IsElemAbelian 3 E →
      Nat.card E = 9 → CFSG.Open.IsElemAbelian 3 E' → Nat.card E' = 9 →
        thetaAlpha 3 E = thetaAlpha 3 E') :
    ∀ U : Subgroup G, U ≤ P → ¬ IsCyclic U →
      Subgroup.normalizer (U : Set G) ≤
        Subgroup.normalizer (thetaAlpha 3 E₀ : Set G) := by
  intro U hUP hnc g hg
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hUp : IsPGroup 3 U := hP.isPGroup.to_le hUP
  obtain ⟨B, hBea, hBcard⟩ :=
    CFSG.GroupTheory.SteinbergBK.odd_noncyclic_pgroup_rank_two (p := 3)
      (by norm_num : Odd 3) (P := ↥U) hUp hnc
  let E : Subgroup G := B.map U.subtype
  have hEU : E ≤ U := Subgroup.map_subtype_le B
  have hEea : CFSG.Open.IsElemAbelian 3 E :=
    (CFSG.Open.isElemAbelian_iff_isElementaryAbelian.mpr hBea).map U.subtype
  have hEcard : Nat.card E = 9 := by
    rw [Subgroup.card_map_of_injective U.subtype_injective, hBcard]
    norm_num
  have hUg : U.map (MulAut.conj g).toMonoidHom = U :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp hg
  have hEgU : E.map (MulAut.conj g).toMonoidHom ≤ U := by
    rw [← hUg]
    exact Subgroup.map_mono hEU
  have hEgP : E.map (MulAut.conj g).toMonoidHom ≤ P := hEgU.trans hUP
  have hEgea : CFSG.Open.IsElemAbelian 3 (E.map (MulAut.conj g).toMonoidHom) :=
    hEea.map (MulAut.conj g).toMonoidHom
  have hEgcard : Nat.card (E.map (MulAut.conj g).toMonoidHom) = 9 := by
    rw [Subgroup.card_map_of_injective (MulAut.conj g).injective, hEcard]
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  calc (thetaAlpha 3 E₀).map (MulAut.conj g).toMonoidHom
      = (thetaAlpha 3 E).map (MulAut.conj g).toMonoidHom := by
        rw [hconst E₀ E hE₀P (hEU.trans hUP) hE₀ea hE₀card hEea hEcard]
    _ = thetaAlpha 3 (E.map (MulAut.conj g).toMonoidHom) :=
        thetaAlpha_map_equiv Nat.prime_three (MulAut.conj g) E
    _ = thetaAlpha 3 E₀ :=
        hconst (E.map (MulAut.conj g).toMonoidHom) E₀ hEgP hE₀P hEgea hEgcard hE₀ea hE₀card

end
