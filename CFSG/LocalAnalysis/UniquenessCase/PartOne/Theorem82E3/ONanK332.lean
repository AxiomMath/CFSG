private theorem isWeaklyClosedIn_map_mk' {G : Type} [Group G] [Finite G] {S Z N : Subgroup G}
    [N.Normal] (hS : IsSylowOf 3 S ⊤) (hZS : Z ≤ S) (hZp : IsPGroup 3 Z)
    (hwc : IsWeaklyClosedIn Z S) :
    IsWeaklyClosedIn (Z.map (QuotientGroup.mk' N)) (S.map (QuotientGroup.mk' N)) := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hconj : ∀ {s : G}, s ∈ S → CFSG.conjugate Z s = Z := fun {s} hs => by
    apply hwc s
    intro x hx
    rw [UCK.N588A.mem_conjugate_iff] at hx
    have e : x = s⁻¹ * (s * x * s⁻¹) * s := by group
    rw [e]
    exact S.mul_mem (S.mul_mem (S.inv_mem hs) (hZS hx)) hs
  intro gbar hgbar
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective N gbar
  have hle : CFSG.conjugate Z g ≤ S ⊔ N := by
    intro x hx
    have hfx : QuotientGroup.mk' N x ∈ S.map (QuotientGroup.mk' N) := by
      apply hgbar
      rw [UCK.N588A.mem_conjugate_iff, ← map_inv, ← map_mul, ← map_mul]
      exact Subgroup.mem_map_of_mem _ (UCK.N588A.mem_conjugate_iff.mp hx)
    have hx' : x ∈ (S.map (QuotientGroup.mk' N)).comap (QuotientGroup.mk' N) := hfx
    rwa [Subgroup.comap_map_eq, QuotientGroup.ker_mk'] at hx'
  have hSSN : IsSylowOf 3 S (S ⊔ N) := hS.of_le le_sup_left le_top
  obtain ⟨Q, hQ, hZgQ⟩ := UCK.N588A.exists_isSylowOf_ge_of_le hle (hZp.map _)
  obtain ⟨k, hk, hkQ⟩ := hSSN.exists_mem_conj hQ
  have h1 : CFSG.conjugate Z (g * k) = Z := by
    apply hwc
    intro x hx
    rw [UCK.N588A.mem_conjugate_iff] at hx
    have hx' : k * x * k⁻¹ ∈ CFSG.conjugate Z g := by
      rw [UCK.N588A.mem_conjugate_iff]
      simpa [mul_assoc] using hx
    have hxS := (hkQ _).mp (hZgQ hx')
    simpa [mul_assoc] using hxS
  have h2 : CFSG.conjugate Z g = CFSG.conjugate Z k⁻¹ := by
    have e := congrArg (fun H => CFSG.conjugate H k⁻¹) h1
    simpa only [UCK.N588A.conjugate_conjugate, mul_inv_cancel_right] using e
  have hk' : k ∈ ((S ⊔ N : Subgroup G) : Set G) := hk
  rw [Subgroup.mul_normal] at hk'
  obtain ⟨s, hs, n, hn, rfl⟩ := hk'
  have hfn : QuotientGroup.mk' N n = 1 := (QuotientGroup.eq_one_iff n).mpr hn
  rw [← UCK.N588A.map_conjugate, h2, UCK.N588A.map_conjugate, map_inv, map_mul, hfn, mul_one,
    ← map_inv, ← UCK.N588A.map_conjugate, hconj (S.inv_mem hs)]

private theorem descend332' {G : Type} [Group G] [Finite G] (hK : CFSG.Open.IsKGroup G)
    {S Z : Subgroup G} (hS : IsSylowOf 3 S ⊤) (hrk : CFSG.Open.pRank 3 S ≤ 3) (hZS : Z ≤ S)
    (hZ3 : Nat.card Z = 3) (hwc : IsWeaklyClosedIn Z S) :
    let N := CFSG.pPrimeCore 3 G
    CFSG.Open.IsKGroup (G ⧸ N) ∧
      IsSylowOf 3 (S.map (QuotientGroup.mk' N)) ⊤ ∧
      CFSG.Open.pRank 3 (S.map (QuotientGroup.mk' N)) ≤ 3 ∧
      Z.map (QuotientGroup.mk' N) ≤ S.map (QuotientGroup.mk' N) ∧
      Nat.card (Z.map (QuotientGroup.mk' N)) = 3 ∧
      IsWeaklyClosedIn (Z.map (QuotientGroup.mk' N)) (S.map (QuotientGroup.mk' N)) := by
  intro N
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hN : Nat.Coprime 3 (Nat.card N) := CFSG.pPrimeCore_coprime_card
  obtain ⟨P, hPS⟩ := UCK.N588A.exists_sylow_of_isSylowOf_top hS
  have hSp : IsPGroup 3 S := hPS ▸ P.isPGroup'
  have hZp : IsPGroup 3 Z := IsPGroup.of_card (n := 1) (by rw [pow_one]; exact hZ3)
  have hSN : S ⊓ N = ⊥ := UCK.N588A.inf_eq_bot_of_coprime hSp hN
  have hker : ∀ x ∈ S, QuotientGroup.mk' N x = 1 → x = 1 := fun x hx h1 => by
    have hx' : x ∈ S ⊓ N := ⟨hx, (QuotientGroup.eq_one_iff x).mp h1⟩
    rwa [hSN, Subgroup.mem_bot] at hx'
  refine ⟨hK.quotient N, ?_, ?_, Subgroup.map_mono hZS, ?_,
    isWeaklyClosedIn_map_mk' hS hZS hZp hwc⟩
  · have hs := UCK.N588A.isSylowOf_top_of_sylow (P.mapSurjective (QuotientGroup.mk'_surjective N))
    rwa [Sylow.coe_mapSurjective, hPS] at hs
  · calc CFSG.Open.pRank 3 (S.map (QuotientGroup.mk' N))
          ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (G ⧸ N)) :=
          CFSG.SectionRank.pRank_mono (by norm_num) le_top
      _ = CFSG.Open.pRank 3 (⊤ : Subgroup G) :=
          CFSG.SectionRank.pRank_quotient_eq N
            ((Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mp hN)
      _ ≤ 3 := (UCK.N588A.pRank_le_of_isSylowOf Nat.prime_three hS ⊤).trans hrk
  · rw [UCK.N588A.card_map_of_injOn _ (fun x hx => hker x (hZS hx)), hZ3]

theorem k332Z3_route
    {G₀ : Type} [Group G₀] [Finite G₀] (hK : CFSG.Open.IsKGroup G₀)
    {S Z : Subgroup G₀} (hS : IsSylowOf 3 S ⊤) (hrk : CFSG.Open.pRank 3 S ≤ 3) (hZS : Z ≤ S)
    (hZ3 : Nat.card Z = 3) (hwc : IsWeaklyClosedIn Z S)
    (h2 : 2 ≤ CFSG.Open.pRank 3 (Subgroup.normalClosure (Z : Set G₀))) :
    CFSG.RankThree.PartTwo.Sec4.IsoGTwoPrime (Subgroup.normalClosure
        ((Z.map (QuotientGroup.mk' (CFSG.pPrimeCore 3 G₀)) : Subgroup (G₀ ⧸ CFSG.pPrimeCore 3 G₀)) :
          Set (G₀ ⧸ CFSG.pPrimeCore 3 G₀))) ∨
      Nonempty (Subgroup.normalClosure
        ((Z.map (QuotientGroup.mk' (CFSG.pPrimeCore 3 G₀)) : Subgroup (G₀ ⧸ CFSG.pPrimeCore 3 G₀)) :
          Set (G₀ ⧸ CFSG.pPrimeCore 3 G₀)) ≃* CFSG.Blueprint.NativeSporadic.J2) := by
  have hrow : UCK.K332Route.Row332 :=
    UCK.K332Route.row332_of_rows UCK.K332Route.k33_holds UCK.K332Route.k332Rows_holds
  obtain ⟨hK', hS', hrk', hZS', hZ3', hwc'⟩ :=
    descend332' hK hS hrk hZS hZ3 hwc
  set N := CFSG.pPrimeCore 3 G₀ with hN
  have hcore : CFSG.pPrimeCore 3 (G₀ ⧸ N) = ⊥ := by
    haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    exact CFSG.Semidihedral.Local.pPrimeCore_quotient_self_eq_bot G₀ 3
  have hrkT : CFSG.Open.pRank 3 (⊤ : Subgroup (G₀ ⧸ N)) ≤ 3 :=
    (UCK.N588A.pRank_le_of_isSylowOf Nat.prime_three hS' ⊤).trans hrk'
  have hmain := UCK.K332Route.item332_of_row hrow (G₀ ⧸ N)
    (UCK.K332Route.components_PL332 hK' hrkT fun K hKc =>
      CFSG.RankThree.PartTwo.Sec4.Item432Proof.isPGroup_center_of_isSubnormal hcore hKc.2)
    hcore (Z.map (QuotientGroup.mk' N)) hZ3' (UCK.K332Route.wc_normalizer hS' hZS' hwc')
  rcases hmain with h1 | hrest
  · exfalso
    have h3 := UCK.K332Route.pullback332 hZ3 h1
    omega
  · exact hrest

@[expose] def K332Z3 : Prop :=
  ∀ (G₀ : Type) [Group G₀] [Finite G₀], CFSG.Open.IsKGroup G₀ →
    ∀ S Z : Subgroup G₀, IsSylowOf 3 S ⊤ → CFSG.Open.pRank 3 S ≤ 3 → Z ≤ S →
      Nat.card Z = 3 → IsWeaklyClosedIn Z S →
      2 ≤ CFSG.Open.pRank 3 (Subgroup.normalClosure (Z : Set G₀)) →
        CFSG.RankThree.PartTwo.Sec4.IsoGTwoPrime (Subgroup.normalClosure
            ((Z.map (QuotientGroup.mk' (CFSG.pPrimeCore 3 G₀)) :
                Subgroup (G₀ ⧸ CFSG.pPrimeCore 3 G₀)) :
              Set (G₀ ⧸ CFSG.pPrimeCore 3 G₀))) ∨
          Nonempty (Subgroup.normalClosure
            ((Z.map (QuotientGroup.mk' (CFSG.pPrimeCore 3 G₀)) :
                Subgroup (G₀ ⧸ CFSG.pPrimeCore 3 G₀)) :
              Set (G₀ ⧸ CFSG.pPrimeCore 3 G₀)) ≃* CFSG.Blueprint.NativeSporadic.J2)

theorem k332Z3_holds
    :
    K332Z3 := fun G₀ _ _ hK S Z hS hrk hZS hZ3 hwc h2 =>
  k332Z3_route hK hS hrk hZS hZ3 hwc h2

