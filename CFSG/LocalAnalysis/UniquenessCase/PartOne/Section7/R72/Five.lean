theorem r72Shape_of_sz32 (k : Sec7Core4 G) {H : Subgroup G}
    (hH : k.Config H) (h5 : k.p = 5)
    (hiso : CFSG.RankThree.PartOne.Census3.IsoLie ↥(CFSG.generalizedFitting (QuotK7 k.p H))
      (.suzuki 2))
    (P : Sylow k.p (QuotK7 k.p H))
    (hcyc : IsCyclic ↥((P : Subgroup (QuotK7 k.p H)) ⊓ CFSG.generalizedFitting (QuotK7 k.p H)))
    (hrk : 2 ≤ CFSG.Open.pRank k.p (P : Subgroup (QuotK7 k.p H))) :
    R72Shape k.p (LKQuot7 k.p H) := by
  haveI : Fact k.p.Prime := ⟨k.prime⟩
  obtain ⟨-, -, hKn, hKC⟩ := k.isSimpleGroup_generalizedFitting_quotient hH
  haveI := hKn
  set K := CFSG.generalizedFitting (QuotK7 k.p H)
  have hout : Nat.card (MulAut ↥K ⧸ (MulAut.conj : ↥K →* MulAut ↥K).range) = 5 :=
    CFSG.LocalAnalysis.RankThreeTheoremC.Generic41Spor.sz32_outer _ ⟨rfl, hiso⟩
  have hle : Nat.card (QuotK7 k.p H ⧸ K) ≤
      Nat.card (MulAut ↥K ⧸ (MulAut.conj : ↥K →* MulAut ↥K).range) :=
    CFSG.RankThree.PartOne.CTP.card_quotient_le_outer K hKC
  have hdvd : k.p ∣ Nat.card (QuotK7 k.p H ⧸ K) := by
    by_contra hnd
    have hPK := CFSG.RankThree.PartOne.CTP.le_of_isPGroup_of_not_dvd_card_quotient P.isPGroup' hnd
    rw [inf_eq_left.2 hPK] at hcyc
    have := CFSG.SectionRank.pRank_le_one_of_isCyclic k.prime hcyc
    omega
  have hcard : Nat.card (QuotK7 k.p H ⧸ K) = 5 := by
    have := Nat.le_of_dvd Nat.card_pos hdvd
    omega
  have hLK := imageModK_opp_eq_top k hH ⟨1, by rw [Subgroup.index_eq_card, hcard, h5, pow_one]⟩
  haveI : Finite (MulAut ↥K) :=
    Finite.of_injective (fun f : MulAut ↥K => (f : ↥K → ↥K)) DFunLike.coe_injective
  have hAut : Nat.card (MulAut ↥K) ≤ Nat.card (QuotK7 k.p H) := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (MulAut.conj : ↥K →* MulAut ↥K).range,
      Subgroup.card_eq_card_quotient_mul_card_subgroup K, hcard, hout]
    exact Nat.mul_le_mul le_rfl
      (Nat.card_le_card_of_surjective _ (MulAut.conj : ↥K →* MulAut ↥K).rangeRestrict_surjective)
  have hbij := Function.Injective.bijective_of_nat_card_le
    (CFSG.RankThree.PartOne.CTP.conjNormal_injective_of_centralizer K hKC) hAut
  have hSz : UC22.IsSz ↥K 5 :=
    Or.inr (Or.inr (Or.inr ⟨rfl, rfl, CFSG.RankThree.PartOne.CTP.suzukiModel_of_isoLie 2 hiso⟩))
  exact r72Shape_lkQuot7_of_eq_top hLK (Or.inr (Or.inr (Or.inr (Or.inl ⟨h5, Or.inl
    ⟨↥K, inferInstance, hSz, ⟨MulEquiv.ofBijective (MulAut.conjNormal (H := K)) hbij⟩⟩⟩))))

section Certified


theorem r72Shape_of_isSmallStrongP
    (hbr : ∀ s : TauCeti.SporadicName,
      Nonempty (CFSG.Blueprint.NativeSporadic.Carrier s ≃* (TauCeti.CFSGIndex.sporadic s).Group))
    (k : Sec7Core4 G) (hp5 : 5 ≤ k.p) (hno : k.KIDExcluded) (h75 : k.Step75)
    {H : Subgroup G} (hH : k.Config H)
    (hinn : ∀ f : MulAut ↥(CFSG.generalizedFitting (QuotK7 k.p H)), (∃ n : ℕ, f ^ k.p ^ n = 1) →
      f ∈ (MulAut.conj : ↥(CFSG.generalizedFitting (QuotK7 k.p H)) →*
        MulAut ↥(CFSG.generalizedFitting (QuotK7 k.p H))).range)
    (hs : CFSG.AGLEmbedding.IsSmallStrongP k.p ↥(CFSG.generalizedFitting (QuotK7 k.p H))) :
    R72Shape k.p (LKQuot7 k.p H) := by
  haveI : Fact k.p.Prime := ⟨k.prime⟩
  obtain ⟨-, -, hKn, hKC⟩ := k.isSimpleGroup_generalizedFitting_quotient hH
  haveI := hKn
  have hLK := imageModK_opp_eq_generalizedFitting k hH fun _ _ hx =>
    UCK.mem_of_forall_inner _ hKC hinn hx
  have hspor : ∀ s : TauCeti.SporadicName,
      CFSG.AGLEmbedding.IsSporadicGroup s ↥(CFSG.generalizedFitting (QuotK7 k.p H)) →
        UC22.IsSpor ↥(CFSG.generalizedFitting (QuotK7 k.p H)) s :=
    fun s ⟨e⟩ => ⟨e.trans (hbr s).some.symm⟩
  rcases hs with ⟨d, hd, ⟨e⟩⟩ | ⟨d, ⟨q, hqp, -, hq⟩, ⟨e⟩⟩ | hA | ⟨h3, -⟩ |
      ⟨h5, ⟨⟨d₀, hv⟩, hd, ⟨e⟩⟩ | hM | hF⟩ | ⟨h11, hJ⟩
  · exact r72Shape_of_isLinTwoIndex k hH hd e
  · exact r72Shape_of_isUnitaryIndex k hH ⟨q, hqp, hq⟩ e
  · obtain ⟨e⟩ : Nonempty (↥(CFSG.generalizedFitting (QuotK7 k.p H)) ≃*
        alternatingGroup (Fin (2 * k.p))) := hA
    by_cases h5 : k.p = 5
    · refine r72Shape_lkQuot7_of_eq hLK
        (Or.inr (Or.inr (Or.inr (Or.inl ⟨h5, Or.inr (Or.inr (Or.inr ?_))⟩))))
      generalize hn : 2 * k.p = n at e
      obtain rfl : n = 10 := by omega
      exact ⟨e⟩
    · have h6 : k.p ≠ 6 := fun h => by
        rcases k.prime.eq_one_or_self_of_dvd 2 ⟨3, by omega⟩ with h' | h' <;> omega
      exact ((not_alt_of_kIDExcluded k hno h75 hH (by omega : 13 ≤ 2 * k.p)).false e).elim
  · omega
  · obtain rfl : d₀ = .tits := hd
    exact r72Shape_lkQuot7_of_eq hLK (Or.inr (Or.inr (Or.inr (Or.inl
      ⟨h5, Or.inr (Or.inl (CFSG.HardMathSupport.Dickson.Sec6.blueprintLieModel_tits hv e))⟩))))
  · exact r72Shape_lkQuot7_of_eq hLK
      (Or.inr (Or.inr (Or.inr (Or.inl ⟨h5, Or.inr (Or.inr (Or.inl (hspor _ hM)))⟩))))
  · exact absurd hF (not_isFi22_of_kIDExcluded k hno h75 hH)
  · exact r72Shape_lkQuot7_of_eq hLK (Or.inr (Or.inr (Or.inr (Or.inr ⟨h11, hspor _ hJ⟩))))

theorem r72Shape_five (hId : CFSG.AGLEmbedding.KFactSmallIdent)
    (hLie : CFSG.AGLEmbedding.KFactOneLieIdent)
    (hCyc : CFSG.LocalAnalysis.RankThreeTheoremC.StronglyEmbeddedCyclicOuterKFact)
    (hOutP : CFSG.AGLEmbedding.KFactSmallOutPPrime)
    (hbr : ∀ s : TauCeti.SporadicName,
      Nonempty (CFSG.Blueprint.NativeSporadic.Carrier s ≃* (TauCeti.CFSGIndex.sporadic s).Group))
    (k : Sec7Core4 G) (hp5 : 5 ≤ k.p) (hno : k.KIDExcluded) (h75 : k.Step75)
    {H : Subgroup G} (hH : k.Config H) : R72Shape k.p (LKQuot7 k.p H) := by
  classical
  haveI : Fact k.p.Prime := ⟨k.prime⟩
  have hp2 : k.p ≠ 2 := by omega
  obtain ⟨hKs, hKnab, hKn, hKC⟩ := k.isSimpleGroup_generalizedFitting_quotient hH
  haveI := hKn
  haveI := hKs
  have hN := k.isStronglyPEmbedded_map_quotient_pPrimeCore hH
  have hX : CFSG.Open.IsKGroup (QuotK7 k.p H) :=
    CFSG.LocalAnalysis.GLTheoremB.isKGroup_quotient'
      (CFSG.LocalAnalysis.GLTheoremB.isKGroup_of_isKProper k.standing.kProper hH.ne_top) _
  set K := CFSG.generalizedFitting (QuotK7 k.p H)
  have hcat : CFSG.Open.IsCatalogGroup ↥K :=
    hX.isCatalogGroup_of_surjective K hKnab (MonoidHom.id _) Function.surjective_id
  obtain ⟨P, hPN, -, T, hT, hΓT⟩ := exists_sylow_glbCore_ne_top_of_isStronglyPEmbedded
    (CFSG.pPrimeCore_quotient_eq_bot k.prime) ((Subgroup.nontrivial_iff_ne_bot K).1 inferInstance)
    hN
  have hrk : 2 ≤ CFSG.Open.pRank k.p (P : Subgroup (QuotK7 k.p H)) := by
    rw [(CFSG.SectionRank.pRank_sylow P).1]
    exact k.two_le_pRank_quotient_pPrimeCore hH
  by_cases hcyc : IsCyclic (T : Subgroup ↥K)
  · have hcycP : IsCyclic ↥((P : Subgroup (QuotK7 k.p H)) ⊓ K) := by
      rw [hT] at hcyc
      exact isCyclic_of_surjective (Subgroup.subgroupOfEquivOfLe inf_le_right)
        (Subgroup.subgroupOfEquivOfLe inf_le_right).surjective
    have hΓ : CFSG.Open.rankThreeGamma 1 k.p (P : Subgroup (QuotK7 k.p H)) ≠ ⊤ :=
      ne_top_of_le_ne_top hN.1 (UCK.glbCore_le_of_isStronglyPEmbedded hN P.isPGroup' hPN)
    rcases hCyc (QuotK7 k.p H) K hKn hKs hKnab hcat hKC k.p k.prime hp2 P hcycP hrk hΓ with
      ⟨h3, -⟩ | ⟨h5, hiso⟩
    · omega
    · exact r72Shape_of_sz32 k hH h5 hiso P hcycP hrk
  · by_cases hAut : CFSG.Open.pRank k.p (⊤ : Subgroup (MulAut ↥K)) ≤ 2
    · have hK2 : CFSG.Open.pRank k.p (⊤ : Subgroup ↥K) ≤ 2 :=
        (CFSG.AGLEmbedding.pRank_le_pRank_mulAut_of_nonabelian hKnab k.prime.one_lt
          (le_refl (CFSG.Open.pRank k.p (⊤ : Subgroup ↥K)))).trans hAut
      have hrank : CFSG.pRank k.p ↥(⊤ : Subgroup ↥K) = CFSG.Open.pRank k.p (⊤ : Subgroup ↥K) :=
        (CFSG.SectionRank.pRank_eq_open_pRank_top k.p ↥(⊤ : Subgroup ↥K)).trans
          (CFSG.SectionRank.pRank_eq_pRank_top_subgroup (⊤ : Subgroup ↥K)).symm
      refine r72Shape_of_isSmallStrongP hbr k hp5 hno h75 hH
        (hOutP ↥K hKs hKnab hcat k.p k.prime hp2 T hcyc hΓT hAut fun h => absurd h.1 (by omega))
        (hId ↥K hKs hKnab hcat k.p k.prime hp2 T hcyc hΓT ?_)
      rw [hrank]
      exact hK2
    · obtain ⟨d, hd, ⟨e⟩⟩ := hLie ↥K hKs hKnab hcat k.p k.prime hp2 T hcyc hΓT hAut
      rcases hd with ⟨n, -, hd⟩ | ⟨hd, -⟩ | ⟨h3, -⟩
      · exact r72Shape_of_isLinTwoIndex k hH hd e
      · exact r72Shape_of_isUnitaryIndex k hH hd e
      · omega

end Certified

