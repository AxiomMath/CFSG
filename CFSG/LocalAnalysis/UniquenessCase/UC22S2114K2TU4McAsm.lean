theorem uc22mc_exists_of_offender (hPA : RankThreeUC.PartAAbstract)
    (hK2 : PartOne.Section8.KU45Syl3) (D : Data G) {L P B₀ : Subgroup G} {n : ℕ}
    (hLM : L ≤ D.M) (hML : D.M ≤ normalizer (L : Set G)) (hU4 : IsU4 (Bar2 L) n) (hn : Even n)
    (hn1 : 1 ≤ n) (hP : IsSylowOf 3 P L) (hB₀ : F08.NotationB8103 L P n B₀)
    (hUB₀ : D.U ⊓ centralizer (B₀ : Set G) = ⊥) {A : Subgroup G} (hA : IsMaxElemAbelian D.T A)
    (hAL : ¬ ⁅A, L⁆ ≤ pCoreOf 2 L) :
    ∃ P' B : Subgroup G, IsSylowOf 3 P' L ∧ F08.NotationB8103 L P' n B ∧
      F08.KOf8103 L B ⊔ P' ≤ normalizer (proofS D : Set G) := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨hUO, hUel⟩ := uc22p22c_U_facts D
  have hUM : D.U ≤ D.M :=
    hUO.trans (inf_le_left.trans (CFSG.LieType.BorelTits.pCoreOf_le 2 D.M))
  have hMU : D.M ≤ normalizer (D.U : Set G) := RankThreeUC.le_normalizer_uCore D.M D.T
  have hO2U : pCoreOf 2 D.M ≤ centralizer (D.U : Set G) := by
    intro x hx
    rw [mem_centralizer_iff]
    intro u hu
    exact (mem_centralizer_iff.mp (hUO hu).2 x hx).symm
  have : IsMulCommutative ↥D.U := hUel.1
  have hU2 : ∀ v ∈ D.U, v ^ 2 = 1 := hUel.2
  have hexp : ∀ v : ↥D.U, v ^ 2 = 1 := fun v => Subtype.ext (by simpa using hU2 v v.2)
  have hLU : L ≤ normalizer (D.U : Set G) := hLM.trans hMU
  have hTU : D.T ≤ normalizer (D.U : Set G) := D.sylowM.le.trans hMU
  have hTL : D.T ≤ normalizer (L : Set G) := D.sylowM.le.trans hML
  have hsimple : IsSimpleGroup (Bar2 L) :=
    CFSG.Blueprint.LieModel.isSimpleGroup_of_mem_classicalTags (by decide) hU4
  obtain ⟨b₀, hb₀B, hb₀3, hb₀c⟩ := uc22mc_exists_gen hB₀.1
  have hB₀L : B₀ ≤ L := hB₀.2.1.trans hP.le
  have hb₀L : b₀ ∈ L := hB₀L hb₀B
  have hfixU : ∀ v ∈ D.U, b₀ * v * b₀⁻¹ = v → v = 1 := by
    intro v hv h
    have hvc : v ∈ centralizer (B₀ : Set G) := hb₀c v (by
      calc v * b₀ = b₀ * v * b₀⁻¹ * b₀ := by rw [h]
        _ = b₀ * v := by group)
    have : v ∈ D.U ⊓ centralizer (B₀ : Set G) := ⟨hv, hvc⟩
    rw [hUB₀] at this
    exact this
  have hnc : ¬ L ≤ centralizer (D.U : Set G) := by
    intro h
    apply uc22main1_Z_ne_bot D
    rw [eq_bot_iff]
    intro z hz
    have hzU := uc22main1_Z_le_U D hz
    have hzc : z ∈ centralizer (B₀ : Set G) := by
      rw [mem_centralizer_iff]
      intro b hb
      exact (mem_centralizer_iff.mp (h (hB₀L hb)) z hzU).symm
    have : z ∈ D.U ⊓ centralizer (B₀ : Set G) := ⟨hzU, hzc⟩
    rw [hUB₀] at this
    exact this
  have hker := RankThreeUC.inf_centralizer_subgroupOf_eq_pCore hLM hMU hML hO2U hsimple hnc
  have hLCU : L ⊓ centralizer (D.U : Set G) ≤ pCoreOf 2 L := by
    intro x hx
    have hx' : (⟨x, hx.1⟩ : ↥L) ∈ (L ⊓ centralizer (D.U : Set G)).subgroupOf L := hx
    rw [hker] at hx'
    exact ⟨_, hx', rfl⟩
  obtain ⟨β, hβdef⟩ : ∃ β : ↥(autOn L D.U), β = RankThreeUC.actOn L D.U hLU ⟨b₀, hb₀L⟩ :=
    ⟨_, rfl⟩
  have hβapp : ∀ s : ↥D.U, (((β : MulAut ↥D.U) s : ↥D.U) : G) = b₀ * s * b₀⁻¹ := fun s => by
    rw [hβdef]
    exact RankThreeUC.coe_actOn_apply hLU _ s
  have hβ3 : β ^ 3 = 1 := by
    rw [hβdef, ← map_pow]
    have : (⟨b₀, hb₀L⟩ : ↥L) ^ 3 = 1 := Subtype.ext (by simpa using hb₀3)
    rw [this, map_one]
  have hβ3' : (β : MulAut ↥D.U) ^ 3 = 1 := by
    rw [← Subgroup.coe_pow, hβ3, Subgroup.coe_one]
  have hβfix : ∀ s : ↥D.U, (β : MulAut ↥D.U) s = s → s = 1 := by
    intro s hs
    have h1 := congrArg Subtype.val hs
    rw [hβapp] at h1
    exact Subtype.ext (hfixU s s.2 h1)
  have hcommV : commV (autOn L D.U) = ⊤ :=
    RankThreeUC.U4Mc.commV_eq_top_of_fixedPointFree hexp β.2 hβ3' hβfix
  have hfixV : fixV (autOn L D.U) = ⊥ := RankThreeUC.U4Mc.fixV_eq_bot_of_fixedPointFree β.2 hβfix
  obtain ⟨q, hv, hqp, hqf, ⟨e⟩⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.KSExact.exists_twistedA_of_statedClassicalModel_PSU
      (m := 3) (CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by norm_num) hU4)
  have hU4G : RankThreeUC.IsU4Group n (autOn L D.U) :=
    RankThreeUC.isU4Group_autOn hLU hker ⟨⟨.twistedA 3 q, hv⟩, ⟨q, hqp, hqf, rfl⟩, ⟨e⟩⟩
  have hsylTM := CFSG.QuasithinUnique.Setup.X6.isSylowTwoOf_iff_isSylowOf.mpr D.sylowM
  have hoffU : ∀ A' : Subgroup G, IsMaxElemAbelian D.T A' →
      autOn A' D.U ≤ autOn D.T D.U ∧ IsElemAbelian2 (autOn A' D.U) ∧
        Nat.card ↥D.U ≤ Nat.card (autOn A' D.U) * Nat.card (fixV (autOn A' D.U)) := by
    intro A' hA'
    have hA'M : IsMaxElemAbelian D.M A' := CFSG.Quasithin.B6.isMaxElemAbelian_of_sylow hsylTM hA'
    refine ⟨CFSG.Quasithin.AutOn.autOn_mono hA'.1,
      CFSG.Quasithin.AutOn.isElemAbelian2_autOn hA'.2.1, ?_⟩
    have h := RankThreeUC.offender_autOn hU2 hUM hA'M.1 hMU hA'M ⊤
    have hcent : autOn A' D.U ⊓ centSub (⊤ : Subgroup ↥D.U) = ⊥ := by
      rw [eq_bot_iff]
      intro g hg
      exact Subgroup.mem_bot.mpr (MulEquiv.ext fun s => hg.2 s (Subgroup.mem_top s))
    rw [hcent, Subgroup.relIndex_bot_left, top_inf_eq, Subgroup.card_top] at h
    exact h
  obtain ⟨a, ha, l, hl, hal⟩ : ∃ a ∈ A, ∃ l ∈ L, ⁅a, l⁆ ∉ pCoreOf 2 L := by
    by_contra h
    push Not at h
    exact hAL (commutator_le.mpr h)
  have hAU : A ≤ normalizer (D.U : Set G) := hA.1.trans hTU
  have hnoncomm : conjAct D.U ⟨a, hAU ha⟩ * conjAct D.U ⟨l, hLU hl⟩ ≠
      conjAct D.U ⟨l, hLU hl⟩ * conjAct D.U ⟨a, hAU ha⟩ := by
    intro hcomm
    apply hal
    have h1 : conjAct D.U (⟨a, hAU ha⟩ * ⟨l, hLU hl⟩ * (⟨a, hAU ha⟩)⁻¹ * (⟨l, hLU hl⟩)⁻¹) = 1 := by
      rw [map_mul, map_mul, map_mul, map_inv, map_inv, hcomm]
      group
    have hc : ⁅a, l⁆ ∈ centralizer (D.U : Set G) := (CFSG.Quasithin.AutOn.conjAct_eq_one_iff _).mp h1
    have hcL : ⁅a, l⁆ ∈ L := by
      have h2 : a * l * a⁻¹ ∈ L := (mem_normalizer_iff.mp (hTL (hA.1 ha)) l).mp hl
      rw [commutatorElement_def]
      exact L.mul_mem h2 (L.inv_mem hl)
    exact hLCU ⟨hcL, hc⟩
  have hdata : RankThreeUC.U4OffenderData n (autOn L D.U) (autOn A D.U) :=
    ⟨hU4G, CFSG.Quasithin.AutOn.isElemAbelian2_autOn hA.2.1,
      CFSG.Quasithin.AutOn.autOn_le_normalizer_autOn (hA.1.trans hTL),
      ⟨_, CFSG.Quasithin.AutOn.conjAct_mem_autOn_of_mem (hAU ha) ha, _,
        CFSG.Quasithin.AutOn.conjAct_mem_autOn_of_mem (hLU hl) hl, hnoncomm⟩,
      fun Y _ => RankThreeUC.offender_autOn hU2 hUM
        (CFSG.Quasithin.B6.isMaxElemAbelian_of_sylow hsylTM hA).1 hMU
        (CFSG.Quasithin.B6.isMaxElemAbelian_of_sylow hsylTM hA) Y⟩
  have hAh1 : autOn A D.U ≠ ⊥ := by
    intro h
    apply hnoncomm
    have h1 : conjAct D.U ⟨a, hAU ha⟩ = 1 := by
      have := CFSG.Quasithin.AutOn.conjAct_mem_autOn_of_mem (hAU ha) ha
      rw [h, Subgroup.mem_bot] at this
      exact this
    rw [h1, one_mul, mul_one]
  have hnat := hPA ↥D.U hexp n (autOn L D.U) (autOn A D.U) hdata
  rcases RankThreeUC.U4Mc.natSU4_or_omega_of_abstract hnat hcommV hfixV with
    ⟨F, hF, hFin, hcard, ⟨N⟩⟩ | ⟨F, hF, hFin, b, c, hcard, hirr, ε, ψ, hεψ⟩
  swap
  ·
    exfalso
    have : Fintype F := Fintype.ofFinite F
    have : CharP F 2 := charP_of_card_eq_prime_pow (p := 2) (f := n)
      (by rw [← Nat.card_eq_fintype_card, hcard])
    have hvec : ∀ s : ↥D.U, Multiplicative.toAdd (ψ ((β : MulAut ↥D.U) s)) =
        ((ε β : GL (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) F) :
          Matrix (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) F) *ᵥ
          Multiplicative.toAdd (ψ s) := fun s => by
      rw [hεψ β s]
      rfl
    have hβ3s : ∀ s : ↥D.U, (β : MulAut ↥D.U) ((β : MulAut ↥D.U) ((β : MulAut ↥D.U) s)) = s :=
      fun s => by
        have := congrArg (fun γ : MulAut ↥D.U => γ s) hβ3'
        simpa [pow_succ, MulAut.mul_apply] using this
    refine RankThreeUC.U4Mc.false_of_omegaMinus hcard hn hirr (ε β).2 (fun v => ?_) (fun v hv => ?_)
    · obtain ⟨s, rfl⟩ : ∃ s : ↥D.U, Multiplicative.toAdd (ψ s) = v :=
        ⟨ψ.symm (Multiplicative.ofAdd v), by simp⟩
      rw [← hvec, ← hvec, ← hvec, hβ3s]
    · obtain ⟨s, rfl⟩ : ∃ s : ↥D.U, Multiplicative.toAdd (ψ s) = v :=
        ⟨ψ.symm (Multiplicative.ofAdd v), by simp⟩
      rw [← hvec] at hv
      have hs : (β : MulAut ↥D.U) s = s := ψ.injective (Multiplicative.toAdd.injective hv)
      rw [hβfix s hs, map_one, toAdd_one]
  have : CharP F 2 := CFSG.ClassicalGroups.Unitary.charP_of_card_sq (p := 2) (f := n) hcard
  have hH2 : IsPGroup 2 ↥(autOn D.T D.U) := CFSG.Quasithin.AutOn.isPGroup_autOn D.sylowM.isPGroup
  have hHN : autOn D.T D.U ≤ normalizer ((autOn L D.U : Subgroup (MulAut ↥D.U)) : Set _) :=
    CFSG.Quasithin.AutOn.autOn_le_normalizer_autOn hTL
  obtain ⟨W, hWti, hW2, hoff, hHW⟩ := RankThreeUC.U4Mc.exists_plane_of_offenders hexp hn1 hcard N
    hH2 hHN (hoffU A hA).1 (hoffU A hA).2.1 hAh1 (hoffU A hA).2.2
  set WS : Subgroup ↥D.U := planeSub N W with hWS
  set WG : Subgroup G := WS.map D.U.subtype with hWG
  have hWGU : WG ≤ D.U := Subgroup.map_subtype_le _
  have hWG2 : ∀ w ∈ WG, w ^ 2 = 1 := fun w hw => hU2 w (hWGU hw)
  have hstab : ∀ x : G, ∀ hx : x ∈ normalizer (D.U : Set G),
      (∀ s : ↥D.U, N.vec s ∈ W → N.vec (conjAct D.U ⟨x, hx⟩ s) ∈ W) →
      (∀ s : ↥D.U, N.vec s ∈ W → N.vec (conjAct D.U ⟨x⁻¹, inv_mem hx⟩ s) ∈ W) →
        x ∈ normalizer (WG : Set G) := by
    intro x hx h1 h2
    refine uc22mc_mem_normalizer_map (fun s hs => ⟨_, h1 s hs, ?_⟩) (fun s hs => ⟨_, h2 s hs, ?_⟩)
    · exact CFSG.Quasithin.AutOn.coe_conjAct_apply _ _ _
    · rw [CFSG.Quasithin.AutOn.coe_conjAct_apply]
      simp
  have hTWG : D.T ≤ normalizer (WG : Set G) := fun t ht =>
    hstab t (hTU ht)
      (fun s hs => hHW _ (CFSG.Quasithin.AutOn.conjAct_mem_autOn_of_mem (hTU ht) ht) s hs)
      (fun s hs => hHW _ (CFSG.Quasithin.AutOn.conjAct_mem_autOn_of_mem (inv_mem (hTU ht))
        (inv_mem ht)) s hs)
  set PL : Subgroup G := L ⊓ normalizer (WG : Set G) with hPL
  set X : Subgroup G := PL ⊔ D.T with hX
  have hTPL : D.T ≤ normalizer (PL : Set G) := by
    intro t ht
    rw [mem_normalizer_iff]
    intro x
    have h1 := mem_normalizer_iff.mp (hTL ht) x
    have h2 := mem_normalizer_iff.mp (Subgroup.le_normalizer (hTWG ht)) x
    exact ⟨fun hx => ⟨h1.mp hx.1, h2.mp hx.2⟩, fun hx => ⟨h1.mpr hx.1, h2.mpr hx.2⟩⟩
  have hTX : D.T ≤ X := le_sup_right
  have hXM : X ≤ D.M := sup_le (inf_le_left.trans hLM) D.sylowM.le
  have hXU : X ≤ normalizer (D.U : Set G) := hXM.trans hMU
  have hXW : X ≤ normalizer (WG : Set G) := sup_le inf_le_right hTWG
  have hCXU : IsPGroup 2 ↥(X ⊓ centralizer (D.U : Set G)) := by
    refine uc22mc_isPGroup_of_le_sup hTPL D.sylowM.isPGroup inf_le_left ?_
    refine (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 L).to_le fun x hx => ?_
    exact hLCU ⟨hx.2.1, hx.1.2⟩
  set Rx := uc22mcRad X D.U WG hXU with hRx
  have hRx2 : IsPGroup 2 ↥Rx := uc22mcRad_isPGroup hXU hWG2 hCXU
  have hRxN : X ≤ normalizer (Rx : Set G) := uc22mcRad_le_normalizer hXU hXW
  have hRxO : Rx ≤ pCoreOf 2 X :=
    CFSG.LieType.BorelTits.le_pCoreOf_of_le_normalizer 2 uc22mcRad_le hRxN hRx2
  have hvecG : ∀ s : ↥D.U, s ∈ WS ↔ N.vec s ∈ W := fun s => mem_planeSub N W s
  have hJRx : jOf D.T ≤ Rx := by
    rw [show jOf D.T = thompsonJ D.T from
      CFSG.Quasithin.elemThompson_map_subtype_eq_thompsonJ D.T]
    refine iSup₂_le fun A' hA' x hx => ?_
    obtain ⟨-, hq', hf'⟩ := hoff (autOn A' D.U) (hoffU A' hA').1 (hoffU A' hA').2.1
      (hoffU A' hA').2.2
    have hxU := hTU (hA'.1 hx)
    have hmem := CFSG.Quasithin.AutOn.conjAct_mem_autOn_of_mem hxU hx
    refine ⟨hTX (hA'.1 hx), ?_, fun v hv => ?_⟩
    · rw [mem_centralizer_iff]
      rintro _ ⟨s, hs, rfl⟩
      have h1 := congrArg Subtype.val (hf' _ hmem s ((hvecG s).mp hs))
      rw [CFSG.Quasithin.AutOn.coe_conjAct_apply] at h1
      calc (s : G) * x = x * s * x⁻¹ * x := by rw [h1]
        _ = x * s := by group
    · have h1 := hq' _ hmem ⟨v, hv⟩
      have h2 : conjAct D.U ⟨x, hxU⟩ ⟨v, hv⟩ * (⟨v, hv⟩ : ↥D.U)⁻¹ ∈ WS := by
        rw [hvecG, N.vec_mul, N.vec_inv, ← sub_eq_add_neg]
        exact h1
      refine ⟨_, h2, ?_⟩
      rw [Subgroup.coe_subtype, Subgroup.coe_mul, CFSG.Quasithin.AutOn.coe_conjAct_apply,
        Subgroup.coe_inv]
  have hXR : X ≤ normalizer (pCoreOf 2 X : Set G) :=
    (Subgroup.le_normalizer : X ≤ normalizer (X : Set G)).trans
      (CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf 2 X)
  have hRT : pCoreOf 2 X ≤ D.T :=
    CFSG.ClassicalInvolution.GlaubermanAut.isSylowOf_le_of_le_normalizer
      (D.sylowM.of_le hTX hXM) (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 X)
      (CFSG.LieType.BorelTits.pCoreOf_le 2 X) hXR
  have hWGE : WG ≤ proofE D := by
    intro z hz
    refine uc22p22e_mem_omegaZJ'.mpr ⟨uc22p22c_pCoreOf_le_T D ((hUO (hWGU hz)).1), fun j hj => ?_,
      hWG2 z hz⟩
    exact (mem_centralizer_iff.mp (hJRx hj).2.1 z hz).symm
  have hCXW : IsPGroup 2 ↥(X ⊓ centralizer (WG : Set G)) := by
    refine uc22mc_isPGroup_of_le_sup hTPL D.sylowM.isPGroup inf_le_left (hRx2.to_le ?_)
    intro y hy
    obtain ⟨⟨hyX, hyC⟩, hyL, hyN⟩ := hy
    refine ⟨hyX, hyC, fun v hv => ?_⟩
    set ly : ↥(autOn L D.U) := RankThreeUC.actOn L D.U hLU ⟨y, hyL⟩ with hly
    have hlyapp : ∀ s : ↥D.U, (((ly : MulAut ↥D.U) s : ↥D.U) : G) = y * s * y⁻¹ := fun s =>
