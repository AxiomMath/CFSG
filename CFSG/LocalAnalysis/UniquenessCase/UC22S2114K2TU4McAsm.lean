    have h1 := RankThreeUC.U4Mc.sub_mem_of_fix_plane hcard N hWti hW2 hfix ⟨v, hv⟩
    have h2 : (ly : MulAut ↥D.U) ⟨v, hv⟩ * (⟨v, hv⟩ : ↥D.U)⁻¹ ∈ WS := by
