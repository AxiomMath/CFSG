  obtain ⟨gh, hgh⟩ := RankThreeUC.U4Mc.exists_conj_stab_plane hcard hn N hWti hW2 β hβ3 hβfix
  obtain ⟨⟨g, hgL⟩, hgg⟩ := RankThreeUC.actOn_surjective L D.U hLU gh
