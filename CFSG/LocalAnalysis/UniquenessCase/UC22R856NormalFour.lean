theorem le_center_of_abelian_normal_of_sup
    {W : Type} [Group W] [Group.IsNilpotent W] {A X : Subgroup W}
    [A.Normal] (hA : IsMulCommutative A) (hsup : A ⊔ X = ⊤)
    (hX : X ≤ centralizer ((Subgroup.upperCentralSeries W 2 : Subgroup W) : Set W)) :
    A ≤ center W := by
  apply CFSG.ComponentClassification.AS81.Sec2.le_center_of_inf_le A
  intro a ha
  rw [Subgroup.mem_center_iff]
  intro w
  have hXA : X ≤ centralizer ({a} : Set W) := by
    intro x hx
    exact mem_centralizer_singleton_iff.mpr
      (mem_centralizer_iff.mp (hX hx) a ha.2).symm
  have hAA : A ≤ centralizer ({a} : Set W) := by
    intro b hb
    exact mem_centralizer_singleton_iff.mpr
      (congrArg Subtype.val (hA.is_comm.comm (⟨a, ha.1⟩ : A) ⟨b, hb⟩)).symm
  have htop : (⊤ : Subgroup W) ≤ centralizer ({a} : Set W) := by
    rw [← hsup]
    exact sup_le hAA hXA
  exact mem_centralizer_singleton_iff.mp (htop (mem_top w))

