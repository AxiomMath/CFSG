    apply Subtype.ext
    apply Subtype.ext
    change (a : G) * (b : G) = (b : G) * (a : G)
    exact congrArg Subtype.val
      (hAb.is_comm.comm (⟨(a : G), a.2⟩ : A) ⟨(b : G), b.2⟩)
  have hsup : A.subgroupOf W ⊔ X.subgroupOf W = ⊤ :=
    codisjoint_iff.mp (Subgroup.codisjoint_subgroupOf_sup A X)
