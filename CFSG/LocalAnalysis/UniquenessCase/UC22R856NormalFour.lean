  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hZ := CFSG.RankThree.PartTwo.Sec4.RonanK432.card_center_eq_three_of_card_27 hP hna
  have hCount := CFSG.RankThree.PartTwo.Sec4.RonanK432.card_pow_three_eq_one_of_card_27 hP hna
  by_contra hn
  have hall : ∀ a : P, a ^ 3 = 1 → a ∈ center P := by
    intro a ha
    by_cases h1 : a = 1
    · rw [h1]
      exact (center P).one_mem
    · by_contra hnot
      exact hn ⟨a,orderOf_eq_prime ha h1,hnot⟩
  let φ : {a : P // a ^ 3 = 1} → center P := fun a => ⟨a,hall a a.2⟩
  have hi : Function.Injective φ := by
    intro a b h
    apply Subtype.ext
    exact congrArg (fun z : center P => (z:P)) h
  have hle := Nat.card_le_card_of_injective φ hi
