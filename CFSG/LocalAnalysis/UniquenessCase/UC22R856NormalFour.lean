    exact (commute_of_mem_upperCentral_two_of_R6_9 h69 hsub Nat.prime_three (by norm_num)
      hE hEel hEcard hGamma Nat.prime_three hXM hXcard hEX hN
      (sup_le hAM hXM) hW3 hXW (mem_map.mpr ⟨y, hy, rfl⟩) hx).symm
