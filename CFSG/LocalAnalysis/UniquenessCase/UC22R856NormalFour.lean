theorem exists_stable_three_lift
    {G : Type} [Group G] [Finite G] {L : Subgroup G} {x : G}
    (hxN : x ∈ normalizer (L : Set G)) (hx3 : x ^ 3 = 1)
    {Ab : Subgroup (Bar2 L)} (hAb : IsPGroup 3 Ab)
    (hAbx : ∀ a ∈ Ab, barConjAut (L := L) x a ∈ Ab) :
    ∃ A : Subgroup G, A ≤ L ∧ IsPGroup 3 A ∧
      Subgroup.zpowers x ≤ normalizer (A : Set G) ∧
      (A.subgroupOf L).map (QuotientGroup.mk' (CFSG.pCore 2 L)) = Ab := by
  classical
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let π : L →* Bar2 L := QuotientGroup.mk' (CFSG.pCore 2 L)
  let H : Subgroup L := Ab.comap π
  let φ : MulAut L := (normalizerMonoidHom L) ⟨x, hxN⟩
  have hφ3 : φ ^ 3 = 1 := by
    rw [← map_pow]
    have he : (⟨x, hxN⟩ : normalizer (L : Set G)) ^ 3 = 1 := Subtype.ext hx3
    rw [he, map_one]
  have hφH : ∀ h ∈ H, φ h ∈ H := by
    intro h hh
    have he : π (φ h) = barConjAut (L := L) x (π h) := by
      rw [barConjAut_of_mem hxN]
      exact (barAction_mk L ⟨x, hxN⟩ h).symm
    change π (φ h) ∈ Ab
    rw [he]
    exact hAbx _ hh
  have hφstab : φ ∈ CFSG.GroupActions.subgroupStabAut H := by
    change H.map φ.toMonoidHom = H
    apply Subgroup.eq_of_le_of_card_ge
    · rintro a ⟨b, hb, rfl⟩
      exact hφH b hb
    · exact (Subgroup.card_map_of_injective (K := H) φ.injective).symm.le
  have hzφ : zpowers φ ≤ CFSG.GroupActions.subgroupStabAut H := zpowers_le.mpr hφstab
  have hA3 : IsPGroup 3 (zpowers φ) := by
    rcases (Nat.dvd_prime Nat.prime_three).mp (orderOf_dvd_of_pow_eq_one hφ3) with h1 | h1
    · exact IsPGroup.of_card (n := 0) (by rw [Nat.card_zpowers, h1, pow_zero])
    · exact IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, h1, pow_one])
  let ψ : zpowers φ →* MulAut L := (zpowers φ).subtype
  obtain ⟨T, hTH, hTcard, hTinv⟩ :=
    CFSG.HardMathSupport.Solomon.LocalBalance.exists_fixed_sylow_of_action Nat.prime_three hA3 ψ
      (fun a h hh => CFSG.GroupActions.apply_mem_of_mem_subgroupStabAut (hzφ a.2) hh)
  have hKer : π.ker = CFSG.pCore 2 L := QuotientGroup.ker_mk' _
  have hmapH : H.map π = Ab := by
    exact Subgroup.map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective _) Ab
  have hNnot3 : ¬ 3 ∣ Nat.card (CFSG.pCore 2 L) := by
    obtain ⟨n, hn⟩ := (CFSG.pCore_isPGroup (p := 2) (G := L)).exists_card_eq
    rw [hn]
    exact fun h => (by norm_num : ¬ (3 : ℕ) ∣ 2) (Nat.prime_three.dvd_of_dvd_pow h)
  obtain ⟨n, hn⟩ := hAb.exists_card_eq
  have hCardH : Nat.card H = Nat.card (CFSG.pCore 2 L) * Nat.card Ab := QuotientGroup.card_preimage_mk _ _
  have hfac : (Nat.card H).factorization 3 = n := by
    rw [hCardH, hn, Nat.factorization_mul Nat.card_pos.ne' (pow_ne_zero _ (by norm_num)),
      Finsupp.add_apply, Nat.factorization_eq_zero_of_not_dvd hNnot3,
      Nat.Prime.factorization_pow Nat.prime_three, Finsupp.single_eq_same, zero_add]
  have hT3 : IsPGroup 3 T := IsPGroup.of_card (by rwa [hfac] at hTcard)
  have hTker : T ⊓ π.ker = ⊥ := by
    rw [hKer]
    exact (IsPGroup.disjoint_of_ne 3 2 (by norm_num) T (CFSG.pCore 2 L) hT3
      (CFSG.pCore_isPGroup (p := 2) (G := L))).eq_bot
  have hTmapcard : Nat.card (T.map π) = Nat.card Ab := by
    rw [CFSG.card_map_eq_card_of_inf_ker_eq_bot π hTker, hTcard, hfac, hn]
  have hTmap : T.map π = Ab := Subgroup.eq_of_le_of_card_ge
    (by rintro a ⟨t, ht, rfl⟩; exact hTH ht) (by rw [hTmapcard])
  let A : Subgroup G := T.map L.subtype
  have hAL : A ≤ L := map_subtype_le _
  have hNorm : x ∈ normalizer (A : Set G) := by
    apply mem_normalizer_iff_map_conj_eq.mpr
    apply Subgroup.eq_of_le_of_card_ge
    · rintro y ⟨a, ⟨t, ht, rfl⟩, rfl⟩
      exact mem_map.mpr ⟨φ t, hTinv ⟨φ, mem_zpowers φ⟩ t ht, rfl⟩
    · exact (Subgroup.card_map_of_injective (K := A) (MulAut.conj x).injective).symm.le
  refine ⟨A, hAL, hT3.map L.subtype, zpowers_le.mpr hNorm, ?_⟩
  have hTA : A.subgroupOf L = T := by
    change (T.map L.subtype).comap L.subtype = T
    exact Subgroup.comap_map_eq_self_of_injective L.subtype_injective T
  rw [hTA]
  exact hTmap

