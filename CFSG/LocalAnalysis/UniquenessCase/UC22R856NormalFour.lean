theorem le_center_of_inner_of_rank_le_two
    {W : Type} [Group W] [Finite W] (hW : IsPGroup 3 W)
    {Q X C : Subgroup W} (hQr : CFSG.Open.pRank 3 Q ≤ 2)
    (hsup : Q ⊔ X = ⊤) (hXpow : ∀ x ∈ X, x ^ 3 = 1)
    (hQC : ∀ q ∈ Q, ∀ c ∈ C, q * c = c * q)
    (hCc : ∀ c ∈ C, ∀ c' ∈ C, c * c' = c' * c)
    (hcap : Q ⊓ C = ⊥) (hdecomp : X ≤ Q ⊔ C)
    (hcent : ∀ A : Subgroup W, A ≤ Q → IsMulCommutative A →
      X ≤ normalizer (A : Set W) → X ≤ centralizer (A : Set W))
    (hpush : X ≤ Subgroup.upperCentralSeries W 2 → X ≤ center W) :
    X ≤ center W := by
  classical
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨A0, hA0n, hA0c, hA0self⟩ :=
    CFSG.GroupTheory.exists_normal_commutative_centralizer_le (hW.to_subgroup Q)
  let A : Subgroup W := A0.map Q.subtype
  have hAQ : A ≤ Q := Subgroup.map_subtype_le _
  have hAc : IsMulCommutative A := by
    refine ⟨⟨fun a b => ?_⟩⟩
    apply Subtype.ext
    change (a : W) * (b : W) = (b : W) * (a : W)
    obtain ⟨a0, ha0, ha⟩ := a.2
    obtain ⟨b0, hb0, hb⟩ := b.2
    rw [← ha, ← hb]
    exact congrArg (fun z : Q => (z : W))
      (congrArg Subtype.val (hA0c.is_comm.comm (⟨a0, ha0⟩ : A0) ⟨b0, hb0⟩))
  have hQA : Q ≤ normalizer (A : Set W) := by
    intro q hq
    rw [mem_normalizer_iff]
    intro a
    constructor
    · rintro ⟨a0, ha0, rfl⟩
      exact ⟨(⟨q, hq⟩ : Q) * a0 * (⟨q, hq⟩ : Q)⁻¹,
        hA0n.conj_mem _ ha0 _, rfl⟩
    · intro ha
      obtain ⟨a0, ha0, heq⟩ := ha
      have hqinv : q⁻¹ ∈ Q := Q.inv_mem hq
      refine ⟨(⟨q⁻¹, hqinv⟩ : Q) * a0 * (⟨q⁻¹, hqinv⟩ : Q)⁻¹,
        hA0n.conj_mem _ ha0 _, ?_⟩
      have heq' : q * a * q⁻¹ = (a0 : W) := heq.symm
      simp only [map_mul, map_inv]
      change q⁻¹ * (a0 : W) * (q⁻¹)⁻¹ = a
      rw [← heq']
      group
  have hCA : C ≤ centralizer (A : Set W) := by
    intro c hc
    rw [mem_centralizer_iff]
    exact fun a ha => hQC a (hAQ ha) c hc
  have hXA : X ≤ normalizer (A : Set W) :=
    hdecomp.trans (sup_le hQA (hCA.trans (centralizer_le_normalizer _)))
  have hAn : A.Normal := by
    apply Subgroup.normalizer_eq_top_iff.mp
    exact top_unique (hsup ▸ sup_le hQA hXA)
  have hXAc : X ≤ centralizer (A : Set W) := hcent A hAQ hAc hXA
  have hAb : ∀ a ∈ A, ∀ b ∈ A, a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (hAc.is_comm.comm (⟨a, ha⟩ : A) ⟨b, hb⟩)
  let Omega : Subgroup W := CFSG.Walter.omegaOneOfComm 3 A hAb
  have hOmegaA : Omega ≤ A := CFSG.Walter.omegaOneOfComm_le A hAb
  have hOmegaN : Omega.Normal := by
    refine ⟨fun o ho w => ?_⟩
    exact ⟨hAn.conj_mem o ho.1 w, by rw [conj_pow, ho.2]; group⟩
  let : Omega.Normal := hOmegaN
  have hAr : CFSG.Open.pRank 3 A ≤ 2 :=
    (CFSG.SectionRank.pRank_mono Nat.prime_three.one_lt hAQ).trans hQr
  have hOmegac : Nat.card Omega ∣ 3 ^ 2 := by
    rw [CFSG.Walter.card_omegaOneOfComm Nat.prime_three A hAb (hW.to_subgroup A)]
    exact pow_dvd_pow 3 hAr
  have hOmegaZ2 : Omega ≤ Subgroup.upperCentralSeries W 2 :=
    CFSG.ComponentClassification.AS81.Sec2.le_upperCentralSeries_of_normal hW 2 Omega hOmegac
  have hX2 : X ≤ Subgroup.upperCentralSeries W 2 := by
    intro x hx
    obtain ⟨q, hq, c, hc, hxc⟩ := exists_mul_mem_sup_of_commute
      (fun c hc q hq => (hQC q hq c hc).symm) (hdecomp hx)
    have hxA : ∀ a ∈ A, x * a = a * x := fun a ha =>
      (mem_centralizer_iff.mp (hXAc hx) a ha).symm
    have hqA : ∀ a ∈ A, q * a = a * q := by
      intro a ha
      have hca := hQC a (hAQ ha) c hc
      have hxa := hxA a ha
      rw [hxc] at hxa
      calc q * a = (q * c * a) * c⁻¹ := by
            calc q * a = q * (a * c) * c⁻¹ := by group
              _ = q * (c * a) * c⁻¹ := by rw [hca]
              _ = (q * c * a) * c⁻¹ := by group
        _ = (a * (q * c)) * c⁻¹ := by rw [hxa]
        _ = a * q := by group
    have hq0 : (⟨q, hq⟩ : Q) ∈ centralizer (A0 : Set Q) := by
      rw [mem_centralizer_iff]
      intro a ha
      apply Subtype.ext
      exact (hqA (a : W) (mem_map.mpr ⟨a, ha, rfl⟩)).symm
    have hqmem : q ∈ A := mem_map.mpr ⟨⟨q, hq⟩, hA0self hq0, rfl⟩
    have hq3 : q ^ 3 = 1 := by
      have hprod : q ^ 3 * c ^ 3 = 1 := by
        rw [← Commute.mul_pow (hQC q hq c hc) 3, ← hxc]
        exact hXpow x hx
      have hqC : q ^ 3 ∈ C := by
        rw [eq_inv_of_mul_eq_one_left hprod]
        exact C.inv_mem (C.pow_mem hc 3)
      exact mem_bot.mp (hcap ▸ (show q ^ 3 ∈ Q ⊓ C from ⟨Q.pow_mem hq 3, hqC⟩))
    have hqZ2 : q ∈ Subgroup.upperCentralSeries W 2 := hOmegaZ2 ⟨hqmem, hq3⟩
    have hcZ : c ∈ center W := by
      rw [mem_center_iff]
      intro w
      have hQCc : Q ≤ centralizer ({c} : Set W) := fun q hq =>
        mem_centralizer_singleton_iff.mpr (hQC q hq c hc)
      have hXCc : X ≤ centralizer ({c} : Set W) := by
        intro z hz
        obtain ⟨qz, hqz, cz, hcz, rfl⟩ := exists_mul_mem_sup_of_commute
          (fun c hc q hq => (hQC q hq c hc).symm) (hdecomp hz)
        rw [mem_centralizer_singleton_iff]
        calc qz * cz * c = qz * (cz * c) := by group
          _ = qz * (c * cz) := by rw [hCc cz hcz c hc]
          _ = c * (qz * cz) := by
                calc qz * (c * cz) = (qz * c) * cz := by group
                  _ = (c * qz) * cz := by rw [hQC qz hqz c hc]
                  _ = c * (qz * cz) := by group
      have ht : (⊤ : Subgroup W) ≤ centralizer ({c} : Set W) := by
        rw [← hsup]
        exact sup_le hQCc hXCc
      exact mem_centralizer_singleton_iff.mp (ht (mem_top w))
    rw [hxc]
    exact (Subgroup.upperCentralSeries W 2).mul_mem hqZ2
      ((Subgroup.upperCentralSeries_mono W (by omega : 1 ≤ 2))
        (by simpa only [Subgroup.upperCentralSeries_one] using hcZ))
  exact hpush hX2

