theorem exists_twenty_seven_noncentral_order_three_of_three_part
    {G : Type} [Group G] [Finite G] (hG : ¬ 3 ^ 4 ∣ Nat.card G)
    (hH : ∃ H : Subgroup G, IsPGroup 3 H ∧ ∃ u ∈ H, ∃ v ∈ H, u * v ≠ v * u) :
    ∃ H : Subgroup G, Nat.card H = 27 ∧
      ∃ a ∈ H, orderOf a = 3 ∧ a ∉ (center H).map H.subtype := by
  classical
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨H,hH3,u,hu,v,hv,huv⟩ := hH
  obtain ⟨n,hn⟩ := hH3.exists_card_eq
  have hn3 : n ≤ 3 := by
    by_contra h
    apply hG
    exact (pow_dvd_pow 3 (by omega : 4 ≤ n)).trans (hn ▸ Subgroup.card_subgroup_dvd_card H)
  have hnc : ¬ IsMulCommutative H := by
    intro hc
    exact huv (congrArg Subtype.val (hc.is_comm.comm (⟨u,hu⟩ : H) ⟨v,hv⟩))
  have hnEq : n = 3 := by
    have hn2 : ¬ n ≤ 2 := by
      intro h
      obtain rfl | rfl | rfl : n = 0 ∨ n = 1 ∨ n = 2 := by omega
      · have : Subsingleton H := (Nat.card_eq_one_iff_unique.mp (by simpa using hn)).1
        exact hnc ⟨⟨fun a b => Subsingleton.elim _ _⟩⟩
      · have : IsCyclic H := isCyclic_of_prime_card (p := 3) (by simpa using hn)
        exact hnc inferInstance
      · exact hnc (IsPGroup.isMulCommutative_of_card_eq_prime_sq hn)
    omega
  have hcard : Nat.card H = 27 := by simpa [hnEq] using hn
  obtain ⟨a,ha3,haz⟩ := exists_noncentral_order_three_of_card_twenty_seven hcard
    ⟨⟨u,hu⟩,⟨v,hv⟩, fun h => huv (congrArg Subtype.val h)⟩
  refine ⟨H,hcard,a,a.2,?_,?_⟩
  · simpa only [Subgroup.orderOf_coe] using ha3
  · intro h
    obtain ⟨b,hb,heq⟩ := h
    have hba : b = a := Subtype.ext heq
    exact haz (hba ▸ hb)



theorem order_twenty_seven_witness_map
    {Y Z : Type*} [Group Y] [Group Z] (φ : Y →* Z) (hφ : Function.Injective φ) {a : Y}
    (hR : ∃ R : Subgroup Y, Nat.card R = 27 ∧ a ∈ R ∧ a ∉ (center R).map R.subtype) :
    ∃ S : Subgroup Z, Nat.card S = 27 ∧ φ a ∈ S ∧
      φ a ∉ (center S).map S.subtype := by
  obtain ⟨R,hcard,haR,hnot⟩ := hR
  refine ⟨R.map φ, by rw [Subgroup.card_map_of_injective hφ,hcard], mem_map.mpr ⟨a,haR,rfl⟩,?_⟩
  intro hz
  obtain ⟨s,hs,heq⟩ := hz
  apply hnot
  refine mem_map.mpr ⟨⟨a,haR⟩,?_,rfl⟩
  rw [Subgroup.mem_center_iff]
  intro b
  apply Subtype.ext
  apply hφ
  change φ ((b:Y) * a) = φ (a * (b:Y))
  rw [map_mul,map_mul]
  have hb : φ (b:Y) ∈ R.map φ := mem_map.mpr ⟨b,b.2,rfl⟩
  have hcomm := congrArg Subtype.val (mem_center_iff.mp hs ⟨φ b,hb⟩)
  change φ (b:Y) * (s:Z) = (s:Z) * φ (b:Y) at hcomm
  change (s:Z) = φ a at heq
  simpa only [heq] using hcomm

