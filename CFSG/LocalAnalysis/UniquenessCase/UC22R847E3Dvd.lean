variable {G : Type} [Group G] [Finite G]

theorem r847E3Dvd_dataOfSetup (hSE : StronglyEmbeddedFive) (hSEZ : StronglyEmbeddedFiveZ)
    (hgr : GriessAllModelsStatement) (hS : Standing G) (S : Setup G) :
    R847E3Dvd (dataOfSetup hS S) := by
  intro Y hY hYN n hYn X hXY q hq hq2 hqn hXc p hp hp5 hpn
  have hSg := UC6S846.sigmaStd_dataOfSetup hS S
  obtain ⟨hpp, hp2⟩ := (dataOfSetup hS S).sig_prime p hp
  haveI : Fact p.Prime := ⟨hpp⟩
  haveI : Fact q.Prime := ⟨hq⟩
  have hsp := UC6S846.sp_of_mem_sig hSg (UC6S846.not_solvable_of_mem_calC hY) hp
  have hYM : Y ≤ S.M := hY.1.le
  have hMN : S.M ≤ normalizer (Y : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hYM).1 hYN
  obtain ⟨B, hBM, hB, hBc⟩ :=
    UC6S846.exists_elemAbelian_card_of_le_pRank hpp (hSg.three_le p hp)
  have hBN : B ≤ normalizer (Y : Set G) := hBM.trans hMN
  have hinn := uc22ine229_map_rhoL_le_inner hMN hYn hpp (by omega)
    (UC6.opRes_eq_of_stronglyEmbedded_uc6 hS.simple hS.nonab hpp hsp) hBM hB
  obtain ⟨xb, gb, hxb, hgxb, Q₀, hQ₀, hfix⟩ := R847E3.exists_invPairOf_index_le hgr hYn hpp hp5
    hpn hq hq2 hqn (P := B)
    (fun u => Subtype.ext (by rw [Subgroup.coe_pow, Subgroup.coe_one]; exact hB.2 _ u.2))
    ((UC6S846.rhoL Y).comp (inclusion hBN))
    (by rw [MonoidHom.range_comp, Subgroup.inclusion_range]; exact hinn)
  obtain ⟨Q, hQB, hQc, x, hxY, hxq, t, ht, ht2, hc⟩ :=
    R847O3.exists_involution_of_fixed_invPair hpp hp2 hq hq2 hBN hB hxb hgxb hQ₀ hfix
  have hr : CFSG.Open.pRank q Y ≤ 1 := (uc22ine229_pRank_le_bar Y hq hq2).trans
    (uc22ine229_pRank_le_one_of_isSU3 hYn hq hq2 (uc22ine229_not_dvd_two_pow_add_one hq hq2 hqn)
      (uc22ine229_not_dvd_card_center hgr hYn hq hq2 hqn))
  obtain ⟨c, hcY, hcX⟩ := RankThreeUC.exists_mem_map_conj_eq_of_card_eq_prime hr hXY
    (zpowers_le.2 hxY) hXc (by rw [Nat.card_zpowers, hxq])
  suffices hN : normalizer ((zpowers x : Subgroup G) : Set G) ≤ S.M by
    intro g hg
    have hcg : c * g * c⁻¹ ∈ normalizer ((zpowers x : Subgroup G) : Set G) := by
      rw [← hcX, ← map_equiv_normalizer_eq]
      exact ⟨g, hg, rfl⟩
    have hcM := hYM hcY
    have h := mul_mem (mul_mem (inv_mem hcM) (hN hcg)) hcM
    rwa [show c⁻¹ * (c * g * c⁻¹) * c = g by group] at h
  by_contra hnot
  obtain ⟨j, hj⟩ := IsPGroup.iff_card.1 (hB.isPGroup.to_le hQB)
  have hj2 : 2 ≤ j := by
    by_contra hlt
    have h1 : p * Nat.card Q ≤ p ^ 2 := by
      rw [hj, ← pow_succ']
      exact Nat.pow_le_pow_right hpp.pos (by omega)
    exact absurd ((hBc ▸ hQc).trans h1) (not_le.2 (Nat.pow_lt_pow_right hpp.one_lt (by norm_num)))
  obtain ⟨A, hAc, -, hAQ⟩ := Sylow.exists_subgroup_card_pow_prime_le_le hpp (H := ⊥) (L := Q)
    (n := 2) (by rw [Subgroup.card_bot]; exact one_dvd _) (by rw [hj]; exact pow_dvd_pow p hj2)
    bot_le
  have hA : IsElemAbelian p A := hB.mono (hAQ.trans hQB)
  have hAN : A ≤ normalizer ((zpowers x : Subgroup G) : Set G) := fun a ha =>
    centralizer_le_normalizer _ (mem_centralizer_iff.2 (by
      rintro _ ⟨i, rfl⟩
      exact ((show Commute a x from (hc a (hAQ ha)).1).zpow_right i).eq.symm))
  have hx1 : x ≠ 1 := fun h => by
    rw [h, orderOf_one] at hxq
    exact hq.one_lt.ne hxq
  let k : Sec7Core4 G := Sec7Core4.ofThree hS S.M S.witness.maxLocal p hpp hp2 hsp
    (PartTwo.Three.normalizer_le_of_mem_sigmaOf S hp)
  have h75 := k.step75 hp5 hSE
  have hH := k.config_normalizer (zpowers_ne_bot.2 hx1) (zpowers_le.2 (hYM hxY))
    (CFSG.SectionRank.le_pRank hpp.one_lt (le_inf (hAQ.trans (hQB.trans hBM)) hAN) hA hAc) hnot
  exact k.false_of_involution h75 hH (k.goodZ_of_kIDExcluded hp5
    (k.kIDExcluded_of_evenRank_le_three (le_of_eq hS.rank)) hH hSEZ h75).1
    (le_inf hAN (hAQ.trans (hQB.trans hBM))) hA hAc (mem_inf.2 ⟨ht.2, hYM ht.1⟩) ht2
    fun a ha => (hc a (hAQ ha)).2

