  rcases hrow with ⟨rfl, rfl | ⟨rfl, h5⟩⟩ | ⟨rfl, rfl | ⟨rfl, h5⟩⟩ | ⟨rfl, rfl⟩
  · have huniq : ∀ K K' : Subgroup (BarInf L), IsFundamentalOver (p ^ 1) K →
