theorem uc22s13xc_center_eq_bot_of_isU3_quot
    {X : Type} [Group X] [Finite X]
    (hX : CFSG.Open.IsQuasisimple X) {n : ℕ} (hn : Even n)
    (hU : IsU3 (X ⧸ Subgroup.center X) n) : Subgroup.center X = ⊥ := by
  obtain ⟨hp, hf, F, _, _, hFcard, ⟨e₀⟩⟩ := CFSG.GH74.Generic.lieModel_psu_data hU
  haveI : Fact (Nat.Prime 2) := ⟨hp⟩
  haveI : CharP F 2 := CFSG.LieType.Steinberg.charP_of_card_eq_sq_pow hp hFcard
  haveI : Group.IsPerfect X := Group.isPerfect_def.mpr hX.1
  have hX' : CFSG.IsQuasisimple X :=
    (CFSG.Foundations.SteinbergCA.quasisimple_iff X).2.2.1.mpr hX
  have hne : ((3 : ℕ), 2 ^ n) ≠ (3, 2) := by
    intro h2
    have h2' : 2 ^ n = 2 ^ 1 := by simpa using (Prod.mk.inj h2).2
    have h1 : n = 1 := Nat.pow_right_injective le_rfl h2'
    rw [h1] at hn
    exact absurd hn (by decide)
  obtain ⟨-, ⟨eM⟩⟩ := CFSG.LieType.Steinberg.CentralExt.SUOdd.psu_odd_hopfMultiplier
    (hF := hFcard) (hf := hf) (n := 3) (by norm_num) (by decide) hne
  have hcard : Nat.card (CFSG.Open.griessHopfMultiplier (X ⧸ Subgroup.center X)) =
      Nat.gcd 3 (2 ^ n + 1) := by
    rw [Nat.card_congr
        ((CFSG.LieType.Steinberg.CentralExt.griessHopfMultiplierCongr e₀).trans eM).toEquiv,
      Nat.card_congr Multiplicative.toAdd, Nat.card_zmod]
  have hgcd : Nat.gcd 3 (2 ^ n + 1) = 1 :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).2 (uc22p2121d_not_three_dvd_two_pow_add_one hn)
  have hdvd := CFSG.ClassicalInvolution.Q3.TL4.E3S3M.natCard_center_dvd hX'
    (MulEquiv.refl (X ⧸ Subgroup.center X))
  rw [hcard, hgcd] at hdvd
  exact Subgroup.eq_bot_of_card_eq _ (Nat.dvd_one.1 hdvd)

theorem uc22s13xc_isU3_of_isSU3
    {X : Type} [Group X] [Finite X] {n : ℕ} (hn : Even n)
    (h : IsSU3 X n) : IsU3 X n := by
  obtain ⟨hq, hU⟩ := h
  have hZ := uc22s13xc_center_eq_bot_of_isU3_quot hq hn hU
  exact LieModel.of_mulEquiv
    ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot) hU

theorem uc22s13xc_shape_of_isPowTwo
    {D : Data G} {Ch : Choice2011 G} (h1930 : H1930 D)
    (c : Ctx21 D Ch) (hH : Hyp2120 D c) (h216 : S21_16 D Ch)
    (hpow : ∀ L ∈ calC D.M, ∀ n, IsSU3 (Bar2 L) n → IsPowTwo n) {L : Subgroup G}
    (hL : L ∈ calC D.M) :
    (∃ n, IsL2 (Bar2 L) n) ∨ (∃ n, IsSz (Bar2 L) n) ∨ (∃ k, 1 ≤ k ∧ IsU3 (Bar2 L) (2 ^ k)) ∨
      (∃ q, q.Prime ∧ q ≠ 2 ∧ IsL2Odd (Bar2 L) q) ∨ IsJ1 (Bar2 L) := by
  rcases uc22p2121e_types_of_isPowTwo h1930 c hH h216 hpow hL with h | h | ⟨k, hk, hSU⟩ | h | h
  · exact Or.inl h
  · exact Or.inr (Or.inl h)
  · have heven : Even (2 ^ k) := (Nat.even_pow' (by omega)).2 even_two
    exact Or.inr (Or.inr (Or.inl ⟨k, hk, uc22s13xc_isU3_of_isSU3 heven hSU⟩))
  · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr h)))

theorem uc22s13xc_thinOrU3_of_isPowTwo
    {D : Data G} {Ch : Choice2011 G} (h1930 : H1930 D) (c : Ctx21 D Ch) (hH : Hyp2120 D c)
    (h216 : S21_16 D Ch) (hpow : ∀ L ∈ calC D.M, ∀ n, IsSU3 (Bar2 L) n → IsPowTwo n) :
    ∀ L ∈ calC D.M, F13.Thin13 L ∨ ∃ n : ℕ, (∃ k : ℕ, n = 2 ^ k) ∧ IsU3 (Bar2 L) n := by
  intro L hL
  rcases uc22s13xc_shape_of_isPowTwo h1930 c hH h216 hpow hL with ⟨n, h⟩ | ⟨n, h⟩ | ⟨k, -, hU⟩ |
      ⟨q, -, -, h⟩ | h
  · exact Or.inl (uc22s13a_thin8_of_isL2_or_isSz (Or.inl h))
  · exact Or.inl (uc22s13a_thin8_of_isL2_or_isSz (Or.inr h))
  · exact Or.inr ⟨2 ^ k, ⟨k, rfl⟩, hU⟩
  · exact Or.inl (PartTwo.S17.thin8_of_isL2Odd h)
  · exact Or.inl (PartTwo.S17.thin8_of_isJ1 h)

