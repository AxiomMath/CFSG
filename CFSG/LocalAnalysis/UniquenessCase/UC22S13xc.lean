theorem uc22s13xc_psl_two_orders_ne {p f n : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (h5 : 5 < p ^ f)
    (hn1 : 1 ≤ n) : p ^ f * ((p ^ f) ^ 2 - 1) ≠ 2 * (2 ^ n * ((2 ^ n) ^ 2 - 1)) := by
  intro h
  have hQ2 : 2 ≤ 2 ^ n := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn1
  have hqodd : Odd (p ^ f) := (hp.odd_of_ne_two hp2).pow
  have hcop2 : Nat.Coprime (p ^ f) 2 := Nat.coprime_two_right.mpr hqodd
  have hdvd : p ^ f ∣ 2 * (2 ^ n * ((2 ^ n) ^ 2 - 1)) := ⟨(p ^ f) ^ 2 - 1, h.symm⟩
  have hdvd2 : p ^ f ∣ (2 ^ n) ^ 2 - 1 :=
    (Nat.Coprime.pow_right n hcop2).dvd_of_dvd_mul_left (hcop2.dvd_of_dvd_mul_left hdvd)
  obtain ⟨R, hR⟩ : ∃ R, 2 ^ n = R + 1 := ⟨2 ^ n - 1, by omega⟩
  have hfac : (2 ^ n) ^ 2 - 1 = R * (R + 2) := by
    have : (R + 1) ^ 2 = R * (R + 2) + 1 := by ring
    rw [hR]
    omega
  rw [hfac] at hdvd2
  have hle : p ^ f ≤ 2 ^ n + 1 := by
    by_cases hpR : p ∣ R + 2
    · have hpR' : ¬ p ∣ R := fun h' => by
        have h2 : p ∣ (R + 2) - R := Nat.dvd_sub hpR h'
        rw [show R + 2 - R = 2 by omega] at h2
        exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 h2)
      have hcop : Nat.Coprime (p ^ f) R :=
        Nat.Coprime.pow_left f ((Nat.Prime.coprime_iff_not_dvd hp).2 hpR')
      have := Nat.le_of_dvd (by omega) (hcop.dvd_of_dvd_mul_left hdvd2)
      omega
    · have hcop : Nat.Coprime (p ^ f) (R + 2) :=
        Nat.Coprime.pow_left f ((Nat.Prime.coprime_iff_not_dvd hp).2 hpR)
      have := Nat.le_of_dvd (by omega) (hcop.dvd_of_dvd_mul_right hdvd2)
      omega
  have hQ8 : 8 ≤ 2 ^ n := by
    rcases Nat.lt_or_ge n 3 with hn3 | hn3
    · interval_cases n <;> simp at hle <;> omega
    · calc 8 = 2 ^ 3 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn3
  have hmono : p ^ f * ((p ^ f) ^ 2 - 1) ≤ (R + 2) * ((R + 2) ^ 2 - 1) :=
    Nat.mul_le_mul (by omega) (Nat.sub_le_sub_right (Nat.pow_le_pow_left (by omega) 2) 1)
  have e1 : (R + 2) ^ 2 - 1 = (R + 1) * (R + 3) := by
    have : (R + 2) ^ 2 = (R + 1) * (R + 3) + 1 := by ring
    omega
  have hlt : (R + 2) * ((R + 2) ^ 2 - 1) < 2 * ((R + 1) * (R * (R + 2))) := by
    rw [e1]
    calc (R + 2) * ((R + 1) * (R + 3)) = (R + 1) * (R + 2) * (R + 3) := by ring
      _ < (R + 1) * (R + 2) * (2 * R) :=
          Nat.mul_lt_mul_of_pos_left (by omega) (Nat.mul_pos (by omega) (by omega))
      _ = 2 * ((R + 1) * (R * (R + 2))) := by ring
  rw [hfac, hR] at h
  omega

theorem uc22s13xc_not_isL2_of_psl_two_odd {X : Type} [Group X] {p f n : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (h5 : 5 < p ^ f) (h : LieModel X .PSL 2 p f) : ¬ IsL2 X n := by
  intro hL
  have hn1 : 1 ≤ n := hL.admissible.2.1
  have hA : Nat.card X = ordA 1 (p ^ f) := by
    simpa [CFSG.EvenSmallLie.CatalogOrders.lieOrd] using h.card_eq_lieOrd (by norm_num)
  have hB : Nat.card X = ordA 1 (2 ^ n) := by
    simpa [CFSG.EvenSmallLie.CatalogOrders.lieOrd] using hL.card_eq_lieOrd (by norm_num)
  have hP : 2 * ordA 1 (p ^ f) = p ^ f * ((p ^ f) ^ 2 - 1) :=
    UC6.N588.two_mul_ordA_one (hp.odd_of_ne_two hp2).pow
  have hN : ordA 1 (2 ^ n) = 2 ^ n * ((2 ^ n) ^ 2 - 1) := by
    rw [UC6.N588.ordA_one_eq]
    have hgcd : Nat.gcd 2 (2 ^ n - 1) = 1 :=
      Nat.coprime_two_left.mpr (CFSG.Timmesfeld.Orders.odd_two_pow_sub_one hn1)
    rw [hgcd, Nat.div_one]
  exact uc22s13xc_psl_two_orders_ne hp hp2 h5 hn1 (by rw [← hP, ← hA, hB, hN])

theorem uc22s13xc_not_isSz_of_psl_two_odd {X : Type} [Group X] {p f n : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (h : LieModel X .PSL 2 p f) : ¬ IsSz X n := by
  intro hSz
  have hA : Nat.card X = ordA 1 (p ^ f) := by
    simpa [CFSG.EvenSmallLie.CatalogOrders.lieOrd] using h.card_eq_lieOrd (by norm_num)
  have hP : 2 * ordA 1 (p ^ f) = p ^ f * ((p ^ f) ^ 2 - 1) :=
    UC6.N588.two_mul_ordA_one (hp.odd_of_ne_two hp2).pow
  have h3 : 3 ∣ 2 * Nat.card X := by
    rw [hA, hP]
    exact CFSG.GH74.GLS.TwoThin.three_dvd_mul_sq_sub_one _
  exact CFSG.LocalAnalysis.EvenBN.GMSK.not_three_dvd_card_of_lieModel_twistedB2 hSz
    ((by norm_num : Nat.Coprime 3 2).dvd_of_dvd_mul_left h3)

theorem uc22s13xc_not_isU3_of_psl_two_odd {X : Type} [Group X] {p f n : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (h5 : 5 < p ^ f) (h : LieModel X .PSL 2 p f) (hn : 2 ≤ n) : ¬ IsU3 X n := by
  intro hsu
  have hqodd : Odd (p ^ f) := (hp.odd_of_ne_two hp2).pow
  have hA : Nat.card X = ordA 1 (p ^ f) := by
    simpa [CFSG.EvenSmallLie.CatalogOrders.lieOrd] using h.card_eq_lieOrd (by norm_num)
  have hU : Nat.card X = ordTwistedA 2 (2 ^ n) := by
    simpa [CFSG.EvenSmallLie.CatalogOrders.lieOrd] using hsu.card_eq_lieOrd (by norm_num)
  obtain ⟨r, -, hr⟩ := CFSG.GroupTheory.two_part_ordTwistedA_two (by omega : 1 ≤ n)
  have hdvd : 2 ^ (n * 3) ∣ ordA 1 (p ^ f) := by
    rw [← hA, hU, hr]
    exact dvd_mul_right _ _
  have hge := CFSG.GroupTheory.ordA_one_ge hqodd
    (CFSG.GroupTheory.two_pow_le_of_dvd_ordA_one hqodd (by omega) hdvd)
  have hsmall := CFSG.GroupTheory.ordTwistedA_two_small hn
  rw [← hA, hU] at hge
  omega

theorem uc22s13xc_notAmong_of_isPowTwo
    {D : Data G} {Ch : Choice2011 G}
    (h1930 : H1930 D) (c : Ctx21 D Ch) (hH : Hyp2120 D c) (h216 : S21_16 D Ch)
    (hpow : ∀ L ∈ calC D.M, ∀ n, IsSU3 (Bar2 L) n → IsPowTwo n) (h19 : S21_19 D Ch) :
    ∀ L ∈ calC D.M,
