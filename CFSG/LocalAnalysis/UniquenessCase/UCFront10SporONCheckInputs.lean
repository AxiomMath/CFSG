@[expose] def onKIsPerm (n : ℕ) (t : Tab) : Bool :=
  t.size == n && pisInv n t (pinvCand n t) && pisInv n (pinvCand n t) t

@[expose] def onKCentOK (E : Array Tab) (y : Tab) (r : ℕ) : Bool :=
  (anyBelow E.size fun k => E[k]! == y) && onKPow 120 y r == idTab 120 && !(y == idTab 120) &&
    (allBelow (r - 1) fun k => (centTabs 120 E (onKPow 120 y (k + 1))).size == r)

@[expose] def onKRCheck : Bool :=
  let E := m120Enum.tabs
  (allBelow 2 fun j => onKIsPerm 120 Data.M120Chain.generators[j]!) && onKCentOK E onKY5 5 &&
    onKCentOK E onKY7 7

@[expose] def onKW (t : ℕ) : Tab :=
  let gs := Data.T32Chain.generators
  if t < 36 then
    comp 32 (comp 32 (comp 32 gs[t / 6]! gs[t % 6]!) (pinvCand 32 gs[t / 6]!))
      (pinvCand 32 gs[t % 6]!)
  else onKPow 32 gs[t - 36]! 4

@[expose] def onKComm (a b : Tab) : Bool := comp 32 a b == comp 32 b a

@[expose] def onKInvCase (t : Tab) : Bool :=
  let gs := Data.T32Chain.generators
  !(comp 32 t t == idTab 32) || t == idTab 32 ||
    !(allBelow 6 fun j => onKComm t (comp 32 (comp 32 gs[j]! t) (pinvCand 32 gs[j]!))) ||
    anyBelow 7 fun i => t == onKD[i]!

@[expose] def onKWitPair (a b : Tab) : Bool :=
  let z := Data.T32z
  !(onKComm a b) || a == z || b == z || b == a || b == comp 32 a z ||
    anyBelow 42 fun t => !(onKComm (onKW t) a && onKComm (onKW t) b)

@[expose] def onKECase (t : Tab) : Bool :=
  onKComm t onKE || comp 32 t onKE == comp 32 (comp 32 onKE Data.T32z) t

@[expose] def onKTCheck : Bool :=
  let E := t32Enum.tabs
  (allBelow 7 fun i => onKIsPerm 32 onKD[i]!) && (allBelow E.size fun k => onKInvCase E[k]!) &&
    (allBelow 7 fun i => allBelow 7 fun j => onKWitPair onKD[i]! onKD[j]!) &&
    (anyBelow E.size fun k => E[k]! == onKE) && comp 32 onKE onKE == idTab 32 &&
    !(onKE == idTab 32) && !(onKE == Data.T32z) && (allBelow E.size fun k => onKECase E[k]!)

@[expose] def onKCheck : Bool :=
  onKRCheck && onKTCheck && onKCert.check RN.enc && onKCert.tleOK RN.enc

end CFSG.LocalAnalysis.UniquenessCase.UC22.F10.ONK
