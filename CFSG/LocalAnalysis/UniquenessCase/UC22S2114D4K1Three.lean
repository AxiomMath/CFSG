theorem false_of_perfect_of_solvable_quot {P S Q : Type*} [Group P] [Group S] [Group Q]
    [Finite P] (φ : P →* S) (hφ : Function.Surjective φ) (hS : _root_.commutator S = ⊤)
    (hS2 : 2 ∣ Nat.card S) (ψ : P →* Q) (hψ : Group.IsSolvable ψ.range)
    (hodd : Odd (Nat.card ψ.ker)) : False := by
  set N := ψ.ker
  set N' := N.map φ
  have hN' : N'.Normal := ψ.normal_ker.map φ hφ
  have hsolvPN : Group.IsSolvable (P ⧸ N) :=
    solvable_of_surjective (f := (QuotientGroup.quotientKerEquivRange ψ).symm.toMonoidHom)
      (QuotientGroup.quotientKerEquivRange ψ).symm.surjective
  let θ : P ⧸ N →* S ⧸ N' := QuotientGroup.map N N' φ (Subgroup.le_comap_map φ N)
  have hθ : Function.Surjective θ := by
    intro y
    obtain ⟨s, rfl⟩ := QuotientGroup.mk'_surjective N' y
    obtain ⟨p, rfl⟩ := hφ s
    exact ⟨QuotientGroup.mk p, rfl⟩
  have hsolv : Group.IsSolvable (S ⧸ N') := solvable_of_surjective hθ
  have hperf : _root_.commutator (S ⧸ N') = ⊤ := by
    rw [_root_.commutator, ← Subgroup.map_top_of_surjective (QuotientGroup.mk' N')
      (QuotientGroup.mk'_surjective N'), ← Subgroup.map_commutator, ← _root_.commutator, hS]
  have htop : N' = ⊤ := by
    by_contra hne
    have : Nontrivial (S ⧸ N') := by
      rw [← not_subsingleton_iff_nontrivial]
      intro hsub
      refine hne (eq_top_iff.2 fun s _ => ?_)
      exact (QuotientGroup.eq_one_iff s).1 (Subsingleton.elim _ _)
    exact (IsSolvable.commutator_lt_top_of_nontrivial (S ⧸ N')).ne hperf
  have hdvd : Nat.card S ∣ Nat.card N := by
    have h := Subgroup.card_map_dvd N φ
    rwa [show N.map φ = N' from rfl, htop, Subgroup.card_top] at h
  exact (Nat.not_even_iff_odd.2 (hodd.of_dvd_nat hdvd)) (even_iff_two_dvd.2 hS2)

private theorem exists_pow_orderOf_eq {A B : Type*} [Group A] [Finite A] [Group B] (π : A →* B)
    (hker : IsPGroup 2 π.ker) {a : A} {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2)
    (ha : orderOf (π a) = r) : ∃ m : ℕ, ¬ r ∣ m ∧ orderOf (a ^ m) = r := by
  have hra : r ∣ orderOf a := ha ▸ orderOf_map_dvd π a
  have hpos : orderOf a ≠ 0 := (orderOf_pos a).ne'
  have hmem : a ^ r ∈ π.ker := by rw [MonoidHom.mem_ker, map_pow, ← ha, pow_orderOf_eq_one]
  obtain ⟨n, hn⟩ := hker ⟨_, hmem⟩
  have hdvd : orderOf a ∣ r * 2 ^ n := by
    refine orderOf_dvd_of_pow_eq_one ?_
    rw [pow_mul]
    simpa using congrArg Subtype.val hn
  obtain ⟨m, hm⟩ := hra
  refine ⟨m, ?_, ?_⟩
  · have hm2 : m ∣ 2 ^ n := by
      rw [hm] at hdvd
      exact Nat.dvd_of_mul_dvd_mul_left hr.pos hdvd
    intro hrm
    exact hr2 ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).1 (hr.dvd_of_dvd_pow (hrm.trans hm2)))
  · have h := orderOf_pow_orderOf_div hpos ⟨m, hm⟩
    rwa [hm, Nat.mul_div_cancel_left m hr.pos] at h

