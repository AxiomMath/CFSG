variable {G : Type} [Group G] [Finite G]

theorem exists_fixed_lift_conj {K : Subgroup G} {g : G} (hg : g ∈ normalizer (K : Set G)) {r : ℕ}
    [Fact r.Prime] (hgr : g ^ r = 1) {B : Type*} [Group B] (π : ↥K →* B) (φ' : MulAut B)
    (hcomm : ∀ k : ↥K, π (Subgroup.normalizerMonoidHom K ⟨g, hg⟩ k) = φ' (π k))
    (hker : ¬ r ∣ Nat.card π.ker) {x : B} (hx : x ∈ π.range) (hfix : φ' x = x) :
    ∃ k : ↥K, π k = x ∧ g * (k : G) = (k : G) * g := by
  set α := Subgroup.normalizerMonoidHom K ⟨g, hg⟩ with hα_def
  have hα : α ^ r = 1 := by
    have h : (⟨g, hg⟩ : ↥(normalizer (K : Set G))) ^ r = 1 := Subtype.ext (by simpa using hgr)
    rw [hα_def, ← map_pow, h, map_one]
  obtain ⟨a, rfl⟩ := hx
  have hN : ∀ n ∈ π.ker, α n ∈ π.ker := by
    intro n hn
    rw [MonoidHom.mem_ker] at hn ⊢
    rw [hcomm, hn, map_one]
  have hxa : α a * a⁻¹ ∈ π.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hcomm, hfix, mul_inv_cancel]
  obtain ⟨k, hk, hαk⟩ :=
    CFSG.GroupTheory.CoprimeActionSupport.CoprimeAutomorphismFixedQuotientLift.fixed_lift
      α hα π.ker π.normal_ker hN hker a hxa
  refine ⟨k, ?_, ?_⟩
  · rwa [MonoidHom.mem_ker, map_mul, map_inv, mul_inv_eq_one] at hk
  · have h : g * (k : G) * g⁻¹ = k := by simpa [hα_def] using congrArg Subtype.val hαk
    calc g * (k : G) = g * (k : G) * g⁻¹ * g := by group
      _ = k * g := by rw [h]

theorem exists_lift_mem_centralizer {L : Subgroup G} {b : G} (hbL : b ∈ L) {r : ℕ} [Fact r.Prime]
    (hr2 : r ≠ 2) (hbr : b ^ r = 1) {s : Bar2 L}
    (hs : s ∈ centralizer {(QuotientGroup.mk ⟨b, hbL⟩ : Bar2 L)}) :
    ∃ k : ↥L, (QuotientGroup.mk k : Bar2 L) = s ∧ b * (k : G) = (k : G) * b := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hcomm : ∀ k : ↥L, QuotientGroup.mk' (CFSG.pCore 2 ↥L)
      (Subgroup.normalizerMonoidHom L ⟨b, Subgroup.le_normalizer hbL⟩ k) =
        MulAut.conj (QuotientGroup.mk ⟨b, hbL⟩ : Bar2 L)
          (QuotientGroup.mk' (CFSG.pCore 2 ↥L) k) := by
    intro k
    rw [← UC6S846.rhoL_inner L b hbL]
    rfl
  have hker : ¬ r ∣ Nat.card (QuotientGroup.mk' (CFSG.pCore 2 ↥L)).ker := by
    rw [QuotientGroup.ker_mk']
    exact CFSG.GroupTheory.not_dvd_card_of_isPGroup CFSG.pCore_isPGroup Fact.out hr2
  have hfix : MulAut.conj (QuotientGroup.mk ⟨b, hbL⟩ : Bar2 L) s = s := by
    rw [MulAut.conj_apply, ← Subgroup.mem_centralizer_singleton_iff.1 hs, mul_inv_cancel_right]
  exact exists_fixed_lift_conj (Subgroup.le_normalizer hbL) hbr _ _ hcomm hker
    (QuotientGroup.mk'_surjective _ s) hfix

theorem exists_lift_of_le_centralizer {L : Subgroup G} {b : G} (hbL : b ∈ L) {r : ℕ}
    [Fact r.Prime] (hr2 : r ≠ 2) (hbr : b ^ r = 1) {S : Subgroup (Bar2 L)}
    (hS : S ≤ centralizer {(QuotientGroup.mk ⟨b, hbL⟩ : Bar2 L)}) :
    ∃ P : Subgroup G, P ≤ L ⊓ centralizer {b} ∧
      ∃ φ : ↥P →* ↥S, Function.Surjective φ ∧ IsPGroup 2 φ.ker := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set π : ↥L →* Bar2 L := QuotientGroup.mk' (CFSG.pCore 2 ↥L) with hπ
  set P : Subgroup G := L ⊓ centralizer {b} ⊓ (S.comap π).map L.subtype with hP
  have hPL : P ≤ L := inf_le_left.trans inf_le_left
  have hmem : ∀ x : ↥P, π (Subgroup.inclusion hPL x) ∈ S := by
    intro x
    obtain ⟨k, hk, hkx⟩ := Subgroup.mem_map.1 (Subgroup.mem_inf.1 x.2).2
    have h : Subgroup.inclusion hPL x = k := Subtype.ext hkx.symm
    rw [h]
    exact hk
  let φ : ↥P →* ↥S := (π.comp (Subgroup.inclusion hPL)).codRestrict S hmem
  refine ⟨P, inf_le_left, φ, ?_, ?_⟩
  · rintro ⟨s, hs⟩
    obtain ⟨k, hk, hkb⟩ := exists_lift_mem_centralizer hbL hr2 hbr (hS hs)
    have hkP : (k : G) ∈ P :=
      ⟨⟨k.2, Subgroup.mem_centralizer_singleton_iff.2 hkb.symm⟩,
        ⟨k, Subgroup.mem_comap.2 (by rw [hπ, QuotientGroup.mk'_apply, hk]; exact hs), rfl⟩⟩
    refine ⟨⟨k, hkP⟩, Subtype.ext ?_⟩
    show π (Subgroup.inclusion hPL ⟨k, hkP⟩) = s
    rw [← hk]
    rfl
  · intro x
    have h1 : π (Subgroup.inclusion hPL (x : ↥P)) = 1 :=
      congrArg Subtype.val (MonoidHom.mem_ker.1 x.2)
    have h2 : Subgroup.inclusion hPL (x : ↥P) ∈ CFSG.pCore 2 ↥L :=
      (QuotientGroup.eq_one_iff _).1 h1
    obtain ⟨n, hn⟩ := CFSG.pCore_isPGroup (p := 2) (G := ↥L) ⟨_, h2⟩
    refine ⟨n, Subtype.ext (Subtype.ext ?_)⟩
    simpa using congrArg (fun y : ↥(CFSG.pCore 2 ↥L) => ((y : ↥L) : G)) hn

theorem two_le_pRank_of_lift {L : Subgroup G} {b : G} (hbL : b ∈ L) (hb7 : b ^ 7 = 1)
    {A : Subgroup (Bar2 L)} (hAC : A ≤ centralizer {(QuotientGroup.mk ⟨b, hbL⟩ : Bar2 L)})
    (hAel : IsElemAbelian 3 A) (hAcard : Nat.card A = 3 ^ 2) :
    2 ≤ CFSG.Open.pRank 3 (L ⊓ centralizer {b}) := by
  have : Fact (Nat.Prime 7) := ⟨Nat.prime_seven⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨P, hP, φ, hφ, hker⟩ := exists_lift_of_le_centralizer hbL (by norm_num) hb7 hAC
  have h1 : 2 ≤ CFSG.Open.pRank 3 A := CFSG.SectionRank.le_pRank (by norm_num) le_rfl hAel hAcard
  have h2 : CFSG.Open.pRank 3 (⊤ : Subgroup ↥P) = CFSG.Open.pRank 3 (⊤ : Subgroup ↥A) :=
    CFSG.RankThreeCoreUniqueness.Helpers.pRank_top_eq_of_coprime_kernel 3 Nat.prime_three φ hφ
      ((Nat.Prime.coprime_iff_not_dvd Nat.prime_three).2
        (CFSG.GroupTheory.not_dvd_card_of_isPGroup hker Nat.prime_three (by norm_num)))
  rw [CFSG.SectionRank.pRank_eq_pRank_top_subgroup (p := 3) A, ← h2,
    ← CFSG.SectionRank.pRank_eq_pRank_top_subgroup (p := 3) P] at h1
  exact h1.trans (CFSG.SectionRank.pRank_mono (by norm_num) hP)

theorem exists_sylow_bar2_normalizer {M L T : Subgroup G}
    (hT : CFSG.ABGLocalTools.IsSylowOf 2 T M) (hLM : L ≤ M) (hMN : M ≤ normalizer (L : Set G))
    {b : G} (hbL : b ∈ L) (hbT : b ∈ normalizer (T : Set G)) :
    ∃ U : Subgroup (Bar2 L), IsSylowTwoOf U ⊤ ∧
      (QuotientGroup.mk ⟨b, hbL⟩ : Bar2 L) ∈ normalizer (U : Set (Bar2 L)) := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hTL : CFSG.ABGLocalTools.IsSylowOf 2 (T ⊓ L) L := hT.inf_of_le_normalizer hLM hMN
  obtain ⟨-, hTLp, hTLodd⟩ := CFSG.ABGLocalTools.isSylowOf_iff.1 hTL
  set π : ↥L →* Bar2 L := QuotientGroup.mk' (CFSG.pCore 2 ↥L) with hπ
  set V : Subgroup ↥L := (T ⊓ L).subgroupOf L with hV
  have hO2 : pCoreOf 2 L ≤ T ⊓ L :=
    CFSG.Quasithin.pCoreOf_two_le_of_sylowIn inf_le_right hTLp hTLodd
  have hker : π.ker ≤ V := by
    intro x hx
    rw [hπ, QuotientGroup.ker_mk'] at hx
    exact Subgroup.mem_subgroupOf.2 (hO2 (Subgroup.mem_map_of_mem L.subtype hx))
  refine ⟨V.map π, ⟨le_top, hTLp.comap_subtype.map π, ?_⟩, ?_⟩
  · rw [show ((V.map π).subgroupOf ⊤).index = (V.map π).index from
      Subgroup.relIndex_top_right _, Subgroup.index_map_eq V (QuotientGroup.mk'_surjective _) hker]
    exact hTLodd
  · refine Subgroup.le_normalizer_map π (Subgroup.mem_map_of_mem π ?_)
    rw [Subgroup.mem_normalizer_iff]
    intro h
    have hhL : (h : G) ∈ L := h.2
    have hcL : b * (h : G) * b⁻¹ ∈ L := L.mul_mem (L.mul_mem hbL hhL) (L.inv_mem hbL)
    rw [hV, Subgroup.mem_subgroupOf, Subgroup.mem_subgroupOf, Subgroup.mem_inf, Subgroup.mem_inf]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    rw [← Subgroup.mem_normalizer_iff.1 hbT (h : G)]
    exact ⟨fun hh => ⟨hh.1, hcL⟩, fun hh => ⟨hh.1, hhL⟩⟩

