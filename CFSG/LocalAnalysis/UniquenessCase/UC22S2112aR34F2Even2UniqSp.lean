private theorem uc22s2112r34_uniqsp_blockMat_mulVec_apply
    {κ : Type*} [Fintype κ] [DecidableEq κ] {K : Type} [Field K] {p q : κ} (hpq : p ≠ q)
    (A : Matrix (Fin 2) (Fin 2) K) (u : κ → K)
    (hu : ∀ t, t ≠ p → t ≠ q → u t = 0) :
    (blockMat p q A *ᵥ u) p = A 0 0 * u p + A 0 1 * u q ∧
      (blockMat p q A *ᵥ u) q = A 1 0 * u p + A 1 1 * u q := by
  constructor
  · change (∑ t, blockMat p q A p t * u t) = A 0 0 * u p + A 0 1 * u q
    rw [Finset.sum_eq_add p q hpq]
    · simp [blockMat, hpq.symm]
    · intro c _ hc
      rw [hu c hc.1 hc.2, mul_zero]
    · simp
    · simp
  · change (∑ t, blockMat p q A q t * u t) = A 1 0 * u p + A 1 1 * u q
    rw [Finset.sum_eq_add p q hpq]
    · simp [blockMat, hpq.symm]
    · intro c _ hc
      rw [hu c hc.1 hc.2, mul_zero]
    · simp
    · simp

private theorem uc22s2112r34_uniqsp_fix_eq_zero_of_mem
    {K : Type} [Field K] {p : ℕ} [CharP K p] (h2 : (2 : K) ≠ 0) {n : ℕ}
    {P : Submodule K (Fin n ⊕ Fin n → K)} (hP : IsHyperbolicPlane P) {a : StatedSp n K}
    (haP : a ∈ planeGroup P) (ha1 : a ≠ 1) (hp : p.Prime) {r : ℕ} (hr : r.Prime) (hrp : r ≠ p)
    (har : a ^ r = 1) {v : Fin n ⊕ Fin n → K} (hvP : v ∈ P) (hv : mat n K a *ᵥ v = v) :
    v = 0 := by
  obtain ⟨i, hi, hP_eq⟩ := exists_isLongRootSp2_of_isHyperbolicPlane h2 hP
  obtain ⟨k, g, hL, hi_eq⟩ := hi
  have haL : a ∈ (longRootSp2 K n k).map (MulAut.conj g).toMonoidHom := by
    rw [← hL]
    exact haP
  obtain ⟨b, hb, hba⟩ := Subgroup.mem_map.mp haL
  obtain ⟨A, rfl⟩ := MonoidHom.mem_range.mp hb
  have ha_eq : a = g * longBlock K n k A * g⁻¹ := by
    simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] using hba.symm
  have hconj : ∀ m : ℕ, (g * longBlock K n k A * g⁻¹) ^ m =
      g * longBlock K n k (A ^ m) * g⁻¹ := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
        rw [pow_succ, ih, pow_succ, map_mul]
        group
  have hAr : A ^ r = 1 := by
    apply longBlock_injective k
    rw [map_one]
    have h1 : g * longBlock K n k (A ^ r) * g⁻¹ = 1 := by
      rw [← hconj r, ← ha_eq]
      exact har
    calc longBlock K n k (A ^ r) =
          g⁻¹ * (g * longBlock K n k (A ^ r) * g⁻¹) * g := by group
      _ = g⁻¹ * 1 * g := by rw [h1]
      _ = 1 := by group
  let u : Fin n ⊕ Fin n → K := mat n K g⁻¹ *ᵥ v
  have hv_i : v ∈ minusSpace i := by
    rw [hP_eq]
    exact hvP
  have hu_mem : u ∈ minusSpace (longInv K n k) :=
    (mem_minusSpace_conj (i := longInv K n k) (g := g)).1 (by
      rw [← hi_eq]
      exact hv_i)
  have hu_coords : ∀ t, t ∉ coords k → u t = 0 :=
    (mem_minusSpace_longInv h2 k).mp hu_mem
  have hfix_u : mat n K (longBlock K n k A) *ᵥ u = u := by
    have h := hv
    rw [ha_eq, map_mul, map_mul] at h
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec] at h
    have h2 := congrArg (fun w => mat n K g⁻¹ *ᵥ w) h
    rw [mulVec_inv_mulVec] at h2
    exact h2
  have hfix_block : blockMat (Sum.inl k) (Sum.inr k) (A : Matrix (Fin 2) (Fin 2) K) *ᵥ u =
      u := by
    rwa [mat_longBlock] at hfix_u
  let w : Fin 2 → K := ![u (Sum.inl k), u (Sum.inr k)]
  have hu_supp : ∀ t, t ≠ Sum.inl k → t ≠ Sum.inr k → u t = 0 := by
    intro t ht1 ht2
    exact hu_coords t (by
      rw [mem_coords]
      exact fun h => h.elim ht1 ht2)
  have hb := uc22s2112r34_uniqsp_blockMat_mulVec_apply
    (K := K) (p := Sum.inl k) (q := Sum.inr k) Sum.inl_ne_inr A u hu_supp
  have hw0 : ((A : Matrix (Fin 2) (Fin 2) K) *ᵥ w) 0 = w 0 := by
    rw [show ((A : Matrix (Fin 2) (Fin 2) K) *ᵥ w) 0 =
        A 0 0 * u (Sum.inl k) + A 0 1 * u (Sum.inr k) by
      simp [w, Matrix.mulVec, dotProduct, Fin.sum_univ_two]]
    exact hb.1.symm.trans (congrFun hfix_block (Sum.inl k))
  have hw1 : ((A : Matrix (Fin 2) (Fin 2) K) *ᵥ w) 1 = w 1 := by
    rw [show ((A : Matrix (Fin 2) (Fin 2) K) *ᵥ w) 1 =
        A 1 0 * u (Sum.inl k) + A 1 1 * u (Sum.inr k) by
      simp [w, Matrix.mulVec, dotProduct, Fin.sum_univ_two]]
    exact hb.2.symm.trans (congrFun hfix_block (Sum.inr k))
  have hwfix : (A : Matrix (Fin 2) (Fin 2) K) *ᵥ w = w := by
    ext i
    fin_cases i
    · simpa using hw0
    · simpa using hw1
  by_cases hw : w = 0
  · have hu0 : u = 0 := by
      funext t
      by_cases ht : t ∈ coords k
      · rcases mem_coords.1 ht with rfl | rfl
        · simpa [w] using congrFun hw 0
        · simpa [w] using congrFun hw 1
      · exact hu_coords t ht
    rw [show v = mat n K g *ᵥ u from (mulVec_mulVec_inv g v).symm, hu0, Matrix.mulVec_zero]
  · have hAp : A ^ p = 1 :=
      CFSG.Wreathed.OriginalAllPrime.V4InputsW.pow_char_eq_one_of_mulVec_eq hw hwfix
    have hcop : Nat.Coprime p r := (Nat.coprime_primes hp hr).mpr hrp.symm
    have hAord : orderOf A = 1 :=
      Nat.eq_one_of_dvd_coprimes hcop (orderOf_dvd_of_pow_eq_one hAp)
        (orderOf_dvd_of_pow_eq_one hAr)
    have hA1 : A = 1 := orderOf_eq_one_iff.mp hAord
    exact absurd (show a = 1 by rw [ha_eq, hA1, map_one, mul_one, mul_inv_cancel]) ha1

private theorem uc22s2112r34_uniqsp_fixSet_eq_orthSet
    {K : Type} [Field K] {p : ℕ} [CharP K p] (hp : p.Prime) (h2 : (2 : K) ≠ 0) {n : ℕ}
    {P : Submodule K (Fin n ⊕ Fin n → K)} (hP : IsHyperbolicPlane P) {a : StatedSp n K}
    (haP : a ∈ planeGroup P) (ha1 : a ≠ 1) {r : ℕ} (hr : r.Prime) (hrp : r ≠ p)
    (har : a ^ r = 1) :
    {v : Fin n ⊕ Fin n → K | mat n K a *ᵥ v = v} =
      orthSet (P : Set (Fin n ⊕ Fin n → K)) := by
  obtain ⟨i, hi, hP_eq⟩ := exists_isLongRootSp2_of_isHyperbolicPlane h2 hP
  have hfix : (fixSpace i : Set (Fin n ⊕ Fin n → K)) =
      orthSet (P : Set (Fin n ⊕ Fin n → K)) := by
    rw [hi.fixSpace_eq_orthSet h2, hP_eq]
  have hcen : a * i = i * a :=
    Subgroup.mem_centralizer_singleton_iff.mp ((hi.isClassicalSL2 h2).le_centralizer haP)
  have hi2 : i * i = 1 := by
    have hpow : i ^ 2 = 1 := by
      rw [← (hi.isClassicalSL2 h2).orderOf_eq_two]
      exact pow_orderOf_eq_one i
    simpa [pow_two] using hpow
  have hcompl := CFSG.ClassicalInvolution.ModelFacts.TG3.isCompl_minusSpace_fixSpace h2 hi2
  have haFix : a ∈ fixing (fixSpace i : Set (Fin n ⊕ Fin n → K)) := by
    change a ∈ longRootGroup i
    rw [← hi.eq_longRootGroup h2]
    exact haP
  ext v
  constructor
  · intro hv
    rw [← hfix]
    change mat n K i *ᵥ v = v
    obtain ⟨q, hq, p, hpf, hqp⟩ := Submodule.mem_sup.mp
      (hcompl.sup_eq_top ▸ (Submodule.mem_top : v ∈ (⊤ : Submodule K (Fin n ⊕ Fin n → K))))
    have hap : mat n K a *ᵥ p = p := (mem_fixing.mp haFix) p hpf
    have hqeq : mat n K a *ᵥ q = q := by
      have h2' : mat n K a *ᵥ q + p = q + p := by
        calc mat n K a *ᵥ q + p = mat n K a *ᵥ q + mat n K a *ᵥ p := by rw [hap]
          _ = mat n K a *ᵥ (q + p) := (Matrix.mulVec_add (mat n K a) q p).symm
          _ = mat n K a *ᵥ v := by rw [hqp]
          _ = q + p := by rw [hv, hqp]
      exact add_right_cancel h2'
    have hq0 : q = 0 :=
      uc22s2112r34_uniqsp_fix_eq_zero_of_mem h2 hP haP ha1 hp hr hrp har
        (hP_eq ▸ hq) hqeq
    have hvp : v = p := by rw [← hqp, hq0, zero_add]
    rw [hvp]
    exact mem_fixSpace.mp hpf
  · exact fun hv => (mem_fixing.mp haP) v hv

theorem uc22s2112r34_planeGroup_eq_of_mem {K : Type} [Field K] {p : ℕ} [CharP K p]
    (hp : p.Prime) (h2 : (2 : K) ≠ 0) {n : ℕ} {P P' : Submodule K (Fin n ⊕ Fin n → K)}
    (hP : IsHyperbolicPlane P) (hP' : IsHyperbolicPlane P') {a : StatedSp n K}
    (haP : a ∈ planeGroup P) (haP' : a ∈ planeGroup P') (ha1 : a ≠ 1) {r : ℕ} (hr : r.Prime)
    (hrp : r ≠ p) (har : a ^ r = 1) : planeGroup P = planeGroup P' := by
  have hfixP := uc22s2112r34_uniqsp_fixSet_eq_orthSet hp h2 hP haP ha1 hr hrp har
  have hfixP' := uc22s2112r34_uniqsp_fixSet_eq_orthSet hp h2 hP' haP' ha1 hr hrp har
  rw [planeGroup, planeGroup, ← hfixP, ← hfixP']


theorem uc22s2112r34_eq_of_mem_inf_psp {X : Type} [Group X] [Finite X] [IsSimpleGroup X]
    {n p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hn : 2 ≤ n)
    (hadm : StatedLieAdmissible .PSp n p f) (hX : CFSG.Blueprint.LieModel X .PSp n p f)
    {K K' : Subgroup X} (hK : IsFundamentalOver (p ^ f) K) (hK' : IsFundamentalOver (p ^ f) K')
    {x : X} (hxK : x ∈ K) (hxK' : x ∈ K') (hxr : (orderOf x).Prime) (hx2 : orderOf x ≠ 2)
    (hxp : orderOf x ≠ p) : K = K' := by
  classical
  let : Fact p.Prime := ⟨hp⟩
  let F := GaloisField p f
  have h2 : (2 : F) ≠ 0 :=
    CFSG.ClassicalInvolution.ModelFacts.two_ne_zero_galoisField f hp2
  obtain ⟨ψ0, hψ0, hker0⟩ := CFSG.ClassicalInvolution.Upgrade.lieModelCentralCover
    .PSp n p f hp hp2 (by trivial) hadm X hX
  let ψ : StatedSp n F →* X := ψ0
  have hψ : Function.Surjective ψ := hψ0
  have hker : ψ.ker ≤ Subgroup.center (StatedSp n F) := hker0
  obtain ⟨-, -, hL2, -⟩ := fundamental_ambient_of_lieModel hp hp2 hadm hX (by simp) hK
  obtain ⟨R, hR, hKR, hRker⟩ :=
    exists_mem_fundamentalSubgroups_of_isFundamentalOver_general hp hp2 hadm hX (by trivial)
      (by simp) hL2 ψ hψ hker hK
  obtain ⟨R', hR', hKR', hR'ker⟩ :=
    exists_mem_fundamentalSubgroups_of_isFundamentalOver_general hp hp2 hadm hX (by trivial)
      (by simp) hL2 ψ hψ hker hK'
  let R₀ : Subgroup (StatedSp n F) := R
  let R₀' : Subgroup (StatedSp n F) := R'
  have hR₀ : R₀ ∈ CFSG.ClassicalInvolution.Generic.fundamentalSubgroups .PSp
      (CFSG.ClassicalInvolution.Generic.modelUniv .PSp n p f hp).D := hR
  have hR₀' : R₀' ∈ CFSG.ClassicalInvolution.Generic.fundamentalSubgroups .PSp
      (CFSG.ClassicalInvolution.Generic.modelUniv .PSp n p f hp).D := hR'
  have hKR₀ : K = R₀.map ψ := hKR
  have hKR₀' : K' = R₀'.map ψ := hKR'
  have hRker₀ : R₀ ⊓ ψ.ker = ⊥ := hRker
  have hR'ker₀ : R₀' ⊓ ψ.ker = ⊥ := hR'ker
  obtain ⟨P, hP, hRP⟩ := (mem_fundamentalSubgroups_PSp_iff hadm R₀).mp hR₀
  obtain ⟨P', hP', hR'P'⟩ := (mem_fundamentalSubgroups_PSp_iff hadm R₀').mp hR₀'
  have hxKmap : x ∈ R₀.map ψ := by
    rw [← hKR₀]
    exact hxK
  have hxK'map : x ∈ R₀'.map ψ := by
    rw [← hKR₀']
    exact hxK'
  obtain ⟨a, haR, hψa⟩ := Subgroup.mem_map.mp hxKmap
  obtain ⟨b, hbR', hψb⟩ := Subgroup.mem_map.mp hxK'map
  have ha_r : a ^ orderOf x = 1 := by
    have hmem : a ^ orderOf x ∈ R₀ ⊓ ψ.ker := by
      refine ⟨pow_mem haR _, ?_⟩
      change ψ (a ^ orderOf x) = 1
      rw [map_pow, hψa, pow_orderOf_eq_one]
    have hbot : a ^ orderOf x ∈ (⊥ : Subgroup (StatedSp n F)) := hRker₀ ▸ hmem
    simpa using hbot
  have hb_r : b ^ orderOf x = 1 := by
    have hmem : b ^ orderOf x ∈ R₀' ⊓ ψ.ker := by
      refine ⟨pow_mem hbR' _, ?_⟩
      change ψ (b ^ orderOf x) = 1
      rw [map_pow, hψb, pow_orderOf_eq_one]
    have hbot : b ^ orderOf x ∈ (⊥ : Subgroup (StatedSp n F)) := hR'ker₀ ▸ hmem
    simpa using hbot
  have ha1 : a ≠ 1 := by
    intro ha
    have hx1 : x = 1 := by rw [← hψa, ha, map_one]
    exact hxr.ne_one (by rw [hx1, orderOf_one])
  let ζ : StatedSp n F := a * b⁻¹
  have hζker : ζ ∈ ψ.ker := by
    rw [MonoidHom.mem_ker]
    change ψ (a * b⁻¹) = 1
    rw [map_mul, map_inv, hψa, hψb, mul_inv_cancel]
  have hζcenter : ζ ∈ Subgroup.center (StatedSp n F) := hker hζker
  have hζcomm : Commute ζ b := (Subgroup.mem_center_iff.mp hζcenter b).symm
  have haeq : a = ζ * b := by
    change a = (a * b⁻¹) * b
    group
  have hζpow : ζ ^ orderOf x = 1 := by
    have h1 : a ^ orderOf x = (ζ ^ orderOf x) * (b ^ orderOf x) := by
      rw [haeq]
      exact hζcomm.mul_pow (orderOf x)
    rw [ha_r, hb_r, mul_one] at h1
    exact h1.symm
  have hodd : Odd (orderOf x) := hxr.odd_of_ne_two hx2
  rcases (CFSG.ClassicalInvolution.Q3.Q3Z.mem_center_iff_negOne (n := n) (F := F)
    (by omega : 1 ≤ n)).mp hζcenter with hζ1 | hζneg
  · have hab : a = b := by
      have h : a * b⁻¹ = 1 := hζ1
      exact mul_inv_eq_one.mp h
    have haR' : a ∈ R₀' := by
      rw [hab]
      exact hbR'
    have hgroups : planeGroup P = planeGroup P' :=
      uc22s2112r34_planeGroup_eq_of_mem hp h2 hP hP' (hRP ▸ haR) (hR'P' ▸ haR') ha1 hxr
        hxp ha_r
    have hRR' : R₀ = R₀' := by rw [hRP, hR'P', hgroups]
    rw [hKR₀, hKR₀', hRR']
  · exfalso
    have hnegpow : CFSG.ClassicalInvolution.Q3.Q3Z.negOne n F ^ orderOf x =
        CFSG.ClassicalInvolution.Q3.Q3Z.negOne n F := by
      apply mat_injective
      rw [map_pow, CFSG.ClassicalInvolution.Q3.Q3Z.mat_negOne, hodd.neg_one_pow]
    have hnegne : CFSG.ClassicalInvolution.Q3.Q3Z.negOne n F ≠ 1 :=
      CFSG.ClassicalInvolution.Q3.Q3Z.negOne_ne_one h2 (by omega)
    rw [hζneg] at hζpow
    rw [hnegpow] at hζpow
    exact hnegne hζpow

