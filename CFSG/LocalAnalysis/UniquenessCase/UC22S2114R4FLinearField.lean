private noncomputable def linearDiagPairSL {K : Type} [Field K] {m : ℕ} (hm : 3 ≤ m) :
    (Kˣ × Kˣ) →* SpecialLinearGroup (Fin m) K where
  toFun a := ⟨((uc22s2114r3f_diagGL a.1 a.2 : GL (Fin m) K) :
      Matrix (Fin m) (Fin m) K), by
    rw [uc22s2114r3f_coe_diagGL, det_diagonal, ← Units.coe_prod,
      uc22s2114r3f_prod_diagUnits hm, Units.val_one]⟩
  map_one' := Subtype.ext (congrArg (fun A : GL (Fin m) K =>
    (A : Matrix (Fin m) (Fin m) K)) uc22s2114r3f_diagGL_one)
  map_mul' a b := Subtype.ext (congrArg (fun A : GL (Fin m) K =>
    (A : Matrix (Fin m) (Fin m) K)) (uc22s2114r3f_diagGL_mul a.1 b.1 a.2 b.2))

noncomputable def linearDiagPairHom {K : Type} [Field K] {m : ℕ} (hm : 3 ≤ m) :
    (Kˣ × Kˣ) →* projectiveSL m K :=
  (proj m K).comp (linearDiagPairSL hm)

theorem linearDiagPairHom_injective {K : Type} [Field K] {m : ℕ} (hm : 4 ≤ m) :
    Function.Injective (linearDiagPairHom (K := K) (by omega : 3 ≤ m)) := by
  refine (injective_iff_map_eq_one _).2 fun a ha => ?_
  change proj m K (linearDiagPairSL (by omega) a) = 1 at ha
  obtain ⟨c, -, hc⟩ := mem_scalars.1 (proj_eq_one_iff.1 ha)
  change ((uc22s2114r3f_diagGL a.1 a.2 : GL (Fin m) K) : Matrix (Fin m) (Fin m) K) =
    scalar (Fin m) (c : K) at hc
  rw [uc22s2114r3f_coe_diagGL, scalar_apply] at hc
  have hd := diagonal_injective hc
  have hc1 : (1 : K) = c := by
    simpa [uc22s2114r3f_diagUnits] using congrFun hd ⟨3, by omega⟩
  have h0 : (a.1 : K) = c := by
    simpa [uc22s2114r3f_diagUnits] using congrFun hd ⟨0, by omega⟩
  have h1 : (a.2 : K) = c := by
    simpa [uc22s2114r3f_diagUnits] using congrFun hd ⟨1, by omega⟩
  exact Prod.ext (Units.ext (h0.trans hc1.symm)) (Units.ext (h1.trans hc1.symm))

theorem fieldAut_linearDiagPairHom {K : Type} [Field K] {m : ℕ} (hm : 3 ≤ m)
    (σ : K ≃+* K) (a : Kˣ × Kˣ) :
    fieldAut m K σ (linearDiagPairHom hm a) =
      linearDiagPairHom hm (Units.map σ.toMonoidHom a.1, Units.map σ.toMonoidHom a.2) := by
  change fieldAut m K σ (proj m K (linearDiagPairSL hm a)) =
    proj m K (linearDiagPairSL hm _)
  rw [fieldAut_proj]
  congr 1
  apply Subtype.ext
  ext i j
  change σ ((diagonal (fun i : Fin m => (uc22s2114r3f_diagUnits a.1 a.2 i : K))) i j) =
    (diagonal (fun i : Fin m => (uc22s2114r3f_diagUnits
      (Units.map σ.toMonoidHom a.1) (Units.map σ.toMonoidHom a.2) i : K))) i j
  by_cases hij : i = j
  · subst j
    simp only [diagonal_apply_eq]
    unfold uc22s2114r3f_diagUnits
    split_ifs <;> simp
  · simp [hij]

theorem uc22s2114r4f_exists_fixed_split_prime_linear {K : Type} [Field K] [Finite K]
    {m p : ℕ} (hm : 4 ≤ m) (σ : K ≃+* K) (hp : p.Prime)
    (hpd : p ∣ Nat.card (semilinearFixedSubfield σ) - 1) :
    ∃ X : Subgroup (projectiveSL m K), IsPGroup p X ∧ ¬ IsCyclic X ∧
      ∀ x ∈ X, fieldAut m K σ x = x := by
  have : Fact p.Prime := ⟨hp⟩
  let k := semilinearFixedSubfield σ
  obtain ⟨ζ, hζ⟩ := exists_prime_orderOf_dvd_card' (G := kˣ) p (by
    rw [Nat.card_units]
    exact hpd)
  have hprim : IsPrimitiveRoot ζ p := by rw [← hζ]; exact IsPrimitiveRoot.orderOf ζ
  have hcard : Nat.card (rootsOfUnity p k) = p := hprim.card_rootsOfUnity'
  let A := rootsOfUnity p k × rootsOfUnity p k
  have hAp : IsPGroup p A := IsPGroup.of_card (n := 2) (by
    change Nat.card (rootsOfUnity p k × rootsOfUnity p k) = p ^ 2
    rw [Nat.card_prod, hcard]
    ring)
  have hAc : ¬ IsCyclic A := by
    intro hc
    have h := (Group.isCyclic_prod_iff.1 hc).2.2
    simp only [hcard] at h
    exact hp.ne_one (Nat.coprime_self p |>.1 h)
  let ιk : kˣ →* Kˣ := Units.map k.subtype.toMonoidHom
  have hιk : Function.Injective ιk := by
    intro a b hab
    apply Units.ext
    exact Subtype.ext (congrArg Units.val hab)
  let j : A →* Kˣ × Kˣ := (ιk.comp (rootsOfUnity p k).subtype).prodMap
    (ιk.comp (rootsOfUnity p k).subtype)
  let ι : A →* projectiveSL m K := (linearDiagPairHom (by omega)).comp j
  have hι : Function.Injective ι := (linearDiagPairHom_injective hm).comp (by
    intro a b h
    exact Prod.ext (Subtype.ext (hιk (congrArg Prod.fst h)))
      (Subtype.ext (hιk (congrArg Prod.snd h))))
  let ε := MonoidHom.ofInjective hι
  refine ⟨ι.range, hAp.of_equiv ε, fun hc => hAc (ε.isCyclic.2 hc), ?_⟩
  rintro _ ⟨a, rfl⟩
  change fieldAut m K σ (linearDiagPairHom (by omega) (j a)) = linearDiagPairHom (by omega) (j a)
  rw [fieldAut_linearDiagPairHom]
  apply congrArg (linearDiagPairHom (by omega : 3 ≤ m))
  apply Prod.ext <;> apply Units.ext
  · exact a.1.1.1.2
  · exact a.2.1.1.2

theorem uc22s2114r4f_exists_ppd_psl {f r : ℕ} (hf : 1 ≤ f) (hr : r.Prime)
    (hr5 : 5 ≤ r) (hrf : r ∣ f) :
    ∃ q : ℕ, q.Prime ∧ 7 ≤ q ∧ q ≠ r ∧ q ∣ 2 ^ f - 1 ∧
      ¬ q ∣ 2 ^ (f / r) - 1 := by
  have hrfle : r ≤ f := Nat.le_of_dvd (by omega) hrf
  have hf6 : f ≠ 6 := by
    rintro rfl
    have hrd : r ∣ 2 * 3 := by simpa using hrf
    rcases hr.dvd_mul.1 hrd with h2 | h3
    · have := Nat.le_of_dvd (by norm_num) h2
      omega
    · have := Nat.le_of_dvd (by norm_num) h3
      omega
  obtain ⟨q, hq, hqd, hprim⟩ :=
    CFSG.Timmesfeld.exists_primitive_prime_dvd_two_pow_sub_one f (by omega) hf6
  have hpp : CFSG.Timmesfeld.IsPrimitivePrimeDivisor q f := ⟨hq, hqd, hprim⟩
  have hfq := CFSG.SeitzReduction.RankOne.LieTwo.lt_of_isPrimitivePrimeDivisor hpp (by omega)
  have hq7 : 7 ≤ q := by
    by_contra h
    have : q = 6 := by omega
    subst this
    exact absurd hq (by decide)
  exact ⟨q, hq, hq7, by omega, hqd,
    hprim (f / r) (Nat.div_pos hrfle hr.pos) (Nat.div_lt_self (by omega) hr.one_lt)⟩

theorem uc22s2114r4f_exists_fpf_linear {K : Type} [Field K] [Finite K] {m f r : ℕ}
    (hm : 4 ≤ m) (hf : 1 ≤ f) (hK : Nat.card K = 2 ^ f) (hr : r.Prime) (hr5 : 5 ≤ r)
    (σ : K ≃+* K) (hσ : orderOf σ = r) :
    ∃ q : ℕ, q.Prime ∧ 7 ≤ q ∧ q ≠ r ∧ q ∣ 2 ^ f - 1 ∧
      ∃ (A : Type) (_ : CommGroup A) (_ : Finite A), IsPGroup q A ∧ ¬ IsCyclic A ∧
        ∃ κ : A →* A, (∀ a, κ a = a → a = 1) ∧
          ∃ ι : A →* projectiveSL m K, Function.Injective ι ∧
            ∀ a, fieldAut m K σ (ι a) = ι (κ a) := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : CharP K 2 := CFSG.SectionRank.ClassicalOdd.charP_of_card hK
  obtain ⟨hrf, hcard⟩ := card_semilinearFixedSubfield Nat.prime_two hf hK hσ
  obtain ⟨q, hq, hq7, hqr, hqd, hqnot⟩ := uc22s2114r4f_exists_ppd_psl hf hr hr5 hrf
  have : Fact q.Prime := ⟨hq⟩
  have : NeZero q := ⟨hq.ne_zero⟩
  obtain ⟨ζ, hζ⟩ := exists_prime_orderOf_dvd_card' (G := Kˣ) q
    (by rw [Nat.card_units, hK]; exact hqd)
  have hζp : IsPrimitiveRoot ζ q := by rw [← hζ]; exact IsPrimitiveRoot.orderOf ζ
  have hμ : Nat.card (rootsOfUnity q K) = q := hζp.card_rootsOfUnity'
  let A := rootsOfUnity q K × rootsOfUnity q K
  have hAp : IsPGroup q A := IsPGroup.of_card (n := 2) (by
    change Nat.card (rootsOfUnity q K × rootsOfUnity q K) = q ^ 2
    rw [Nat.card_prod, hμ]
    ring)
  have hAc : ¬ IsCyclic A := by
    intro hcyc
    have hcop := (Group.isCyclic_prod_iff.1 hcyc).2.2
    simp only [hμ] at hcop
    exact hq.ne_one (Nat.coprime_self q |>.1 hcop)
  let κ : A →* A := (restrictRootsOfUnity σ q).prodMap (restrictRootsOfUnity σ q)
  have hfix : ∀ a : rootsOfUnity q K, restrictRootsOfUnity σ q a = a → a = 1 := by
    intro a ha
    have haσ : σ ((a : Kˣ) : K) = ((a : Kˣ) : K) := by
      rw [← restrictRootsOfUnity_coe_apply σ a, ha]
    let k := semilinearFixedSubfield σ
    let u : kˣ := Units.mk0 ⟨((a : Kˣ) : K), haσ⟩
      (fun h0 => (a : Kˣ).ne_zero (congrArg Subtype.val h0))
    have hu : u ^ q = 1 := by
      apply Units.ext
      apply Subtype.ext
      change ((a : Kˣ) : K) ^ q = 1
      rw [← Units.val_pow_eq_pow_val, (mem_rootsOfUnity q _).1 a.2, Units.val_one]
    have hd : orderOf u ∣ q := orderOf_dvd_of_pow_eq_one hu
    have hk : orderOf u ∣ 2 ^ (f / r) - 1 := by
      rw [← hcard, ← Nat.card_units]
      exact orderOf_dvd_natCard u
    have hu1 : u = 1 := by
      apply orderOf_eq_one_iff.1
      rcases (Nat.dvd_prime hq).1 hd with h1 | h1
      · exact h1
      · exact (hqnot (h1 ▸ hk)).elim
    exact Subtype.ext (Units.ext (congrArg (fun v : kˣ => ((v : k) : K)) hu1))
  have hκ : ∀ a : A, κ a = a → a = 1 := by
    intro a ha
    exact Prod.ext (hfix a.1 (congrArg Prod.fst ha)) (hfix a.2 (congrArg Prod.snd ha))
  let j : A →* Kˣ × Kˣ := (rootsOfUnity q K).subtype.prodMap (rootsOfUnity q K).subtype
  let ι : A →* projectiveSL m K := (linearDiagPairHom (by omega)).comp j
  have hι : Function.Injective ι := (linearDiagPairHom_injective hm).comp (by
    intro a b hab
    exact Prod.ext (Subtype.ext (congrArg Prod.fst hab)) (Subtype.ext (congrArg Prod.snd hab)))
  refine ⟨q, hq, hq7, hqr, hqd, A, inferInstance, inferInstance, hAp, hAc, κ, hκ, ι, hι, ?_⟩
  intro a
  change fieldAut m K σ (linearDiagPairHom (by omega) (j a)) =
