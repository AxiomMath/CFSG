private theorem exists_fixed_nonsplit_parameter {K : Type} [Field K] [Finite K] [CharP K 2]
    (σ : K ≃+* K) (hodd : Odd (orderOf σ)) :
    ∃ a : K, σ a = a ∧ ∀ b : K, b ^ 2 + b ≠ a := by
  let k := semilinearFixedSubfield σ
  obtain ⟨a, ha⟩ := CFSG.StandardType.OrdPNsOm.exists_not_mem_range_wp (K := k)
  have hroot : ∀ b : k, b ^ 2 + 1 * b + a ≠ 0 := by
    intro b hb
    apply ha
    refine ⟨b, ?_⟩
    rw [CFSG.StandardType.OrdPNsOm.wp_apply]
    have h2 : (2 : k) = 0 := CharP.cast_eq_zero k 2
    linear_combination hb - a * h2
  have hrootK := CFSG.StandardType.RecipeFieldOmega.rootFree_of_odd (K₀ := k) hodd
    (pow_orderOf_eq_one σ) (fun x => Iff.rfl) hroot
  refine ⟨a, a.2, fun b hb => hrootK b ?_⟩
  rw [OneMemClass.coe_one, one_mul, hb]
  exact CharTwo.add_self_eq_zero _

noncomputable def linearBlockPairHom {K : Type} [Field K] (c : ℕ) :
    (SpecialLinearGroup (Fin 2) K × SpecialLinearGroup (Fin 2) K) →*
      projectiveSL (c + 4) K :=
  (proj (c + 4) K).comp ((CFSG.LieType.SpecialLinear.blockEmbed222 c K).comp
    { toFun := fun a => (a.1, 1, a.2)
      map_one' := rfl
      map_mul' := fun a b => by simp })

theorem linearBlockPairHom_injective {K : Type} [Field K] {c : ℕ} (hc : 1 ≤ c) :
    Function.Injective (linearBlockPairHom (K := K) c) := by
  refine (injective_iff_map_eq_one _).2 fun a ha => ?_
  change proj (c + 4) K (CFSG.LieType.SpecialLinear.blockEmbed222 c K (a.1, 1, a.2)) = 1 at ha
  obtain ⟨z, -, hz⟩ := mem_scalars.1 (proj_eq_one_iff.1 ha)
  let i : Fin c := ⟨0, by omega⟩
  have hmid := congrArg (fun A : Matrix (Fin (c + 4)) (Fin (c + 4)) K =>
    A (CFSG.LieType.SpecialLinear.e222 c (Sum.inr (Sum.inl i)))
      (CFSG.LieType.SpecialLinear.e222 c (Sum.inr (Sum.inl i)))) hz
  rw [CFSG.LieType.SpecialLinear.coe_blockEmbed222_apply_inr_inl_inl] at hmid
  have hz1 : (z : K) = 1 := by simpa [scalar_apply] using hmid.symm
  have hleft : a.1 = 1 := by
    apply Subtype.ext
    ext i j
    have h := congrArg (fun A : Matrix (Fin (c + 4)) (Fin (c + 4)) K =>
      A (CFSG.LieType.SpecialLinear.e222 c (Sum.inl i))
        (CFSG.LieType.SpecialLinear.e222 c (Sum.inl j))) hz
    rw [CFSG.LieType.SpecialLinear.coe_blockEmbed222_apply_inl_inl] at h
    simpa [scalar_apply, hz1, Matrix.one_apply] using h
  have hright : a.2 = 1 := by
    apply Subtype.ext
    ext i j
    have h := congrArg (fun A : Matrix (Fin (c + 4)) (Fin (c + 4)) K =>
      A (CFSG.LieType.SpecialLinear.e222 c (Sum.inr (Sum.inr i)))
        (CFSG.LieType.SpecialLinear.e222 c (Sum.inr (Sum.inr j)))) hz
    rw [CFSG.LieType.SpecialLinear.coe_blockEmbed222_apply_inr_inr_inr] at h
    simpa [scalar_apply, hz1, Matrix.one_apply] using h
  exact Prod.ext hleft hright

theorem fieldAut_linearBlockPairHom {K : Type} [Field K] (c : ℕ) (σ : K ≃+* K)
    (a : SpecialLinearGroup (Fin 2) K × SpecialLinearGroup (Fin 2) K) :
    fieldAut (c + 4) K σ (linearBlockPairHom c a) =
      linearBlockPairHom c (SpecialLinearGroup.map σ.toRingHom a.1,
        SpecialLinearGroup.map σ.toRingHom a.2) := by
  change fieldAut (c + 4) K σ
    (proj (c + 4) K (CFSG.LieType.SpecialLinear.blockEmbed222 c K (a.1, 1, a.2))) =
    proj (c + 4) K (CFSG.LieType.SpecialLinear.blockEmbed222 c K
      (SpecialLinearGroup.map σ.toRingHom a.1, 1, SpecialLinearGroup.map σ.toRingHom a.2))
  rw [fieldAut_proj]
  congr 1
  apply Subtype.ext
  ext i j
  obtain ⟨i, rfl⟩ := (CFSG.LieType.SpecialLinear.e222 c).surjective i
  obtain ⟨j, rfl⟩ := (CFSG.LieType.SpecialLinear.e222 c).surjective j
  rcases i with i | (i | i) <;> rcases j with j | (j | j) <;>
    simp [SpecialLinearGroup.map_apply_coe, CFSG.LieType.SpecialLinear.coe_blockEmbed222,
      Matrix.coe_reindexAlgEquiv, Matrix.reindex_apply, CFSG.LieType.SpecialLinear.triDiagMat,
      Matrix.one_apply]

theorem uc22s2114r4f_exists_nonsplit_prime {f r : ℕ} (hf : 1 ≤ f) (hr : r.Prime)
    (hr5 : 5 ≤ r) (hrf : r ∣ f) :
    ∃ q : ℕ, q.Prime ∧ 7 ≤ q ∧ q ≠ r ∧ q ∣ 2 ^ f + 1 ∧
      ¬ q ∣ 2 ^ f - 1 ∧ ¬ q ∣ 2 ^ (2 * (f / r)) - 1 := by
  have hrfle := Nat.le_of_dvd (by omega : 0 < f) hrf
  obtain ⟨q, hq, hqd, hprim⟩ := CFSG.Timmesfeld.exists_primitive_prime_dvd_two_pow_sub_one
    (2 * f) (by omega) (by omega)
  have hpp : CFSG.Timmesfeld.IsPrimitivePrimeDivisor q (2 * f) := ⟨hq, hqd, hprim⟩
  have hlt := CFSG.SeitzReduction.RankOne.LieTwo.lt_of_isPrimitivePrimeDivisor hpp (by omega)
  have hqm : ¬ q ∣ 2 ^ f - 1 := hprim f (by omega) (by omega)
  have hfac : 2 ^ (2 * f) - 1 = (2 ^ f + 1) * (2 ^ f - 1) := by
    rw [show 2 * f = f * 2 by ring, pow_mul, ← Nat.sq_sub_sq (2 ^ f) 1, one_pow]
  refine ⟨q, hq, by omega, by omega, (hq.dvd_mul.1 (hfac ▸ hqd)).resolve_right hqm, hqm, ?_⟩
  exact hprim (2 * (f / r)) (by have := Nat.div_pos hrfle hr.pos; omega)
    (by have := Nat.div_lt_self (by omega : 0 < f) hr.one_lt; omega)

private theorem sl2_fixed_eq_one_of_not_dvd {K : Type} [Field K] [Finite K] [CharP K 2]
    {f q : ℕ} (σ : K ≃+* K) (hcard : Nat.card (semilinearFixedSubfield σ) = 2 ^ f)
    (hq : q.Prime) (hq2 : q ≠ 2) (hqf : ¬ q ∣ 2 ^ (2 * f) - 1)
    {g : SpecialLinearGroup (Fin 2) K} (hgq : g ^ q = 1)
    (hgσ : SpecialLinearGroup.map σ.toRingHom g = g) : g = 1 := by
  have hfields : CFSG.GH74.GLS.IVK.fixedField σ = semilinearFixedSubfield σ := by
    ext x
    exact CFSG.GH74.GLS.IVK.mem_fixedField_iff σ x
  obtain ⟨g₀, hg₀⟩ := CFSG.RankThree.PartTwo.Sec4.Item424Res3.exists_slMap_subtype_eq hgσ
  have hj := CFSG.RankThree.PartTwo.Sec4.Item424Res3.slMap_subtype_injective (n := 2) σ
  have hg₀q : g₀ ^ q = 1 := hj (by rw [map_pow, hg₀, hgq, map_one])
  have hd : orderOf g₀ ∣ q := orderOf_dvd_of_pow_eq_one hg₀q
  have hG : Nat.card (SpecialLinearGroup (Fin 2) (CFSG.GH74.GLS.IVK.fixedField σ)) =
      2 ^ f * (2 ^ (2 * f) - 1) := by
    rw [CFSG.CGT.Timmesfeld75.card_sl2, hfields, hcard, ← pow_mul,
      show f * 2 = 2 * f by omega]
  have hnot : ¬ q ∣ Nat.card (SpecialLinearGroup (Fin 2) (CFSG.GH74.GLS.IVK.fixedField σ)) := by
    rw [hG]
    intro h
    rcases hq.dvd_mul.1 h with h2 | hq'
    · exact hq2 ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).1 (hq.dvd_of_dvd_pow h2))
    · exact hqf hq'
  have hg₀1 : g₀ = 1 := by
    apply orderOf_eq_one_iff.1
    rcases (Nat.dvd_prime hq).1 hd with h1 | h1
    · exact h1
    · exact (hnot (h1 ▸ orderOf_dvd_natCard g₀)).elim
  rw [← hg₀, hg₀1, map_one]

theorem uc22s2114r4f_exists_fpf_nonsplit_sl2 {K : Type} [Field K] [Finite K] {f r : ℕ}
    (hf : 1 ≤ f) (hK : Nat.card K = 2 ^ f) (hr : r.Prime) (hr5 : 5 ≤ r)
    (σ : K ≃+* K) (hσ : orderOf σ = r) :
    ∃ q : ℕ, q.Prime ∧ 7 ≤ q ∧ q ≠ r ∧ q ∣ 2 ^ f + 1 ∧ ¬ q ∣ 2 ^ f - 1 ∧
      ∃ (Q : Type) (_ : CommGroup Q) (_ : Finite Q), Nat.card Q = q ∧
        ∃ κ : Q →* Q, (∀ a, κ a = a → a = 1) ∧
          ∃ ι : Q →* SpecialLinearGroup (Fin 2) K, Function.Injective ι ∧
            ∀ a, SpecialLinearGroup.map σ.toRingHom (ι a) = ι (κ a) := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : CharP K 2 := CFSG.SectionRank.ClassicalOdd.charP_of_card hK
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨hrf, hcard⟩ := card_semilinearFixedSubfield Nat.prime_two hf hK hσ
  obtain ⟨q, hq, hq7, hqr, hqplus, hqminus, hqfix⟩ := uc22s2114r4f_exists_nonsplit_prime hf hr hr5 hrf
  have : Fact q.Prime := ⟨hq⟩
  obtain ⟨a, haσ, ha⟩ := exists_fixed_nonsplit_parameter σ (hσ ▸ hr.odd_of_ne_two (by omega))
  have : Fact (Irreducible (Polynomial.X ^ 2 - Polynomial.X - Polynomial.C a : Polynomial K)) :=
    ⟨CFSG.LocalAnalysis.SteinbergBS.irreducible_X_sq_sub_X_sub_C ha⟩
  let T := CFSG.LocalAnalysis.SteinbergBS.nonsplitTorus a
  have : IsCyclic T := CFSG.LocalAnalysis.SteinbergBS.isCyclic_nonsplitTorus a
  let : CommGroup T := IsCyclic.commGroup
  have hT : Nat.card T = 2 ^ f + 1 := by
    rw [CFSG.LocalAnalysis.SteinbergBS.natCard_nonsplitTorus, ← Nat.card_eq_fintype_card, hK]
  let τ : T →* T :=
    ((SpecialLinearGroup.map σ.toRingHom).comp T.subtype).codRestrict T (by
      intro g
      obtain ⟨x, y, hxy, hg⟩ := g.2
      refine ⟨σ x, σ y, ?_, ?_⟩
      · simpa [haσ] using congrArg σ hxy
      · change (SpecialLinearGroup.map σ.toRingHom (g : SpecialLinearGroup (Fin 2) K) :
          Matrix (Fin 2) (Fin 2) K) = !![σ x, a * σ y; σ y, σ x + σ y]
        rw [SpecialLinearGroup.map_apply_coe, hg]
        ext i j
        fin_cases i <;> fin_cases j <;> simp [haσ])
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' (G := T) q (hT ▸ hqplus)
  let Q : Subgroup T := zpowers z
  have hQ : Nat.card Q = q := by rw [Nat.card_zpowers, hz]
  have hτ : ∀ x ∈ Q, τ x ∈ Q := by
    intro x hx
    have hxq : x ^ q = 1 := by
      rw [← hz]
      exact orderOf_dvd_iff_pow_eq_one.1 (orderOf_dvd_of_mem_zpowers hx)
    have hd : orderOf (τ x) ∣ q := orderOf_dvd_of_pow_eq_one (by rw [← map_pow, hxq, map_one])
    have hle : zpowers (τ x) ≤ Q := by
      rw [IsCyclic.subgroup_le_iff_card_dvd, Nat.card_zpowers, hQ]
      exact hd
    exact hle (mem_zpowers _)
  let κ : Q →* Q := (τ.comp Q.subtype).codRestrict Q (fun x => hτ x x.2)
  let ι : Q →* SpecialLinearGroup (Fin 2) K := T.subtype.comp Q.subtype
  have hι : Function.Injective ι := T.subtype_injective.comp Q.subtype_injective
  refine ⟨q, hq, hq7, hqr, hqplus, hqminus, Q, inferInstance, inferInstance, hQ,
    κ, ?_, ι, hι, fun x => rfl⟩
  intro x hx
  apply hι
  rw [map_one]
  have hxq : ι x ^ q = 1 := by
    rw [← map_pow, ← hQ, pow_card_eq_one', map_one]
  have hxσ : SpecialLinearGroup.map σ.toRingHom (ι x) = ι x :=
    congrArg ι hx
  exact sl2_fixed_eq_one_of_not_dvd σ hcard hq (by omega) hqfix hxq hxσ

theorem uc22s2114r4f_exists_fpf_nonsplit_linear {K : Type} [Field K] [Finite K] {m f r : ℕ}
    (hm : 5 ≤ m) (hf : 1 ≤ f) (hK : Nat.card K = 2 ^ f) (hr : r.Prime) (hr5 : 5 ≤ r)
    (σ : K ≃+* K) (hσ : orderOf σ = r) :
    ∃ q : ℕ, q.Prime ∧ 7 ≤ q ∧ q ≠ r ∧ ¬ q ∣ 2 ^ f - 1 ∧
      ∃ (A : Type) (_ : CommGroup A) (_ : Finite A), IsPGroup q A ∧ ¬ IsCyclic A ∧
        ∃ κ : A →* A, (∀ a, κ a = a → a = 1) ∧
          ∃ ι : A →* projectiveSL m K, Function.Injective ι ∧
            ∀ a, fieldAut m K σ (ι a) = ι (κ a) := by
  obtain ⟨c, rfl⟩ : ∃ c : ℕ, m = c + 4 := ⟨m - 4, by omega⟩
  obtain ⟨q, hq, hq7, hqr, -, hqm, Q, _, _, hQ, κ, hκ, j, hj, hσj⟩ :=
    uc22s2114r4f_exists_fpf_nonsplit_sl2 hf hK hr hr5 σ hσ
  let A := Q × Q
  let κA : A →* A := κ.prodMap κ
  let ι : A →* projectiveSL (c + 4) K := (linearBlockPairHom c).comp (j.prodMap j)
  have hAp : IsPGroup q A := IsPGroup.of_card (n := 2) (by
    change Nat.card (Q × Q) = q ^ 2
    rw [Nat.card_prod, hQ]
    ring)
  have hAc : ¬ IsCyclic A := by
    intro hc
    have h := (Group.isCyclic_prod_iff.1 hc).2.2
    simp only [hQ] at h
    exact hq.ne_one (Nat.coprime_self q |>.1 h)
  have hκA : ∀ a : A, κA a = a → a = 1 := fun a ha =>
    Prod.ext (hκ a.1 (congrArg Prod.fst ha)) (hκ a.2 (congrArg Prod.snd ha))
