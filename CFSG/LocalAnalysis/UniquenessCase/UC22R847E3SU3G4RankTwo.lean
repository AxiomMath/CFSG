section LiftNormalizer

variable {J Q : Type} [Group J] [Finite J] [Group Q] [Finite Q]

theorem R847E3.two_le_pRank_normalizer_of_quotient
    (f : J →* Q) (hf : Function.Surjective f) (hk : IsPGroup 2 f.ker)
    {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) {X : Subgroup J} (hXq : IsPGroup q X)
    (hR : 2 ≤ CFSG.Open.pRank 3 (normalizer (X.map f : Set Q))) :
    2 ≤ CFSG.Open.pRank 3 (normalizer (X : Set J)) := by
  let N : Subgroup J := f.ker
  have : N.Normal := inferInstance
  let e : (J ⧸ N) ≃* Q := QuotientGroup.quotientKerEquivOfSurjective f hf
  have hcop : Nat.Coprime q (Nat.card N) := by
    obtain ⟨j, hj⟩ := hk.exists_card_eq
    rw [hj]
    exact Nat.Coprime.pow_right _ ((Nat.coprime_primes hq Nat.prime_two).2 hq2)
  have hnorm : (normalizer (X : Set J)).map f = normalizer (X.map f : Set Q) := by
    have himg := CFSG.SignalizerFunctor.Helpers.coprime_quotient_normalizer_image q hq N X
      hcop hXq
    have hcomp : e.toMonoidHom.comp (QuotientGroup.mk' N) = f := by
      ext x
      rfl
    rw [← hcomp, ← Subgroup.map_map, himg]
    simpa only [Subgroup.map_map] using
      Subgroup.map_equiv_normalizer_eq (X.map (QuotientGroup.mk' N)) e
  let φ : normalizer (X : Set J) →* normalizer (X.map f : Set Q) :=
    (f.comp (normalizer (X : Set J)).subtype).codRestrict
      (normalizer (X.map f : Set Q)) (fun x => by
        rw [← hnorm]
        exact ⟨x, x.2, rfl⟩)
  have hφ : Function.Surjective φ := by
    intro y
    obtain ⟨x, hx, hxy⟩ := show (y : Q) ∈ (normalizer (X : Set J)).map f from by
      rw [hnorm]
      exact y.2
    refine ⟨⟨x, hx⟩, Subtype.ext ?_⟩
    exact hxy
  have htop : 2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (normalizer (X.map f : Set Q))) := by
    rw [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup]
    exact hR
  obtain ⟨E, hEa, hEc⟩ := uc22ine229u3e9_exists_elemAbelian_sq φ hφ Nat.prime_three
    (by norm_num) htop
  exact CFSG.SectionRank.le_pRank Nat.prime_three.one_lt (Subgroup.map_subtype_le E)
    (hEa.map _) (by rw [Subgroup.card_map_of_injective (Subgroup.subtype_injective _), hEc])

end LiftNormalizer

