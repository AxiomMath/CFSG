theorem R847E3.mem_suConj_range_of_opRes (h : UnitaryFieldData 2 n F)
    (hn : 2 < 2 ^ n) (H : Subgroup (MulAut (unitarySU 2 n F 3)))
    (hgen : closure {a | a ∈ H ∧ ¬ 3 ∣ orderOf a} = H)
    {a : MulAut (unitarySU 2 n F 3)} (ha : a ∈ H) (ha3 : a ^ 3 = 1) :
    a ∈ (suConj h).range := by
  let N : Subgroup (MulAut (unitarySU 2 n F 3)) :=
    (psuConj h).range.comap (suDescend h hn)
  have : (psuConj h).range.Normal := (stdPinnedPSU3_stable (h := h) hn).normal
  have : N.Normal := inferInstance
  have : Finite F := h.finite
  have : IsCyclic (F ≃+* F) := CFSG.RankThree.GF2n.Stroth80.isCyclic_ringEquiv F
  have hNconj : ∀ b : unitaryIsom3 h, suConj h b ∈ N := by
    intro b
    change suDescend h hn (suConj h b) ∈ (psuConj h).range
    rw [suDescend_suConj]
    exact ⟨b, rfl⟩
  have hcyc : IsCyclic (MulAut (unitarySU 2 n F 3) ⧸ N) := by
    refine isCyclic_of_surjective ((QuotientGroup.mk' N).comp (suField h)) ?_
    intro z
    induction z using QuotientGroup.induction_on with
    | H b =>
      obtain ⟨B, σ, rfl⟩ := exists_suConj_mul_suField h hn b
      refine ⟨σ, ?_⟩
      change QuotientGroup.mk' N (suField h σ) =
        QuotientGroup.mk' N (suConj h B * suField h σ)
      have hB1 : QuotientGroup.mk' N (suConj h B) = 1 :=
        (QuotientGroup.eq_one_iff _).2 (hNconj B)
      rw [map_mul, hB1, one_mul]
  have haN : a ∈ N := UC6S846.mem_inner_of_pPow N N H hcyc
    (fun b hb => N.pow_mem hb 3) Nat.prime_three (Or.inr le_rfl) hgen ha
    (k := 1) (by simpa using ha3)
  obtain ⟨B, hB⟩ := haN
  refine ⟨B, eq_of_suDescend_eq h hn ?_⟩
  rw [suDescend_suConj]
  exact hB

theorem R847E3.exists_prime_order_commuting_of_type_two
    (hK : PiField false 2 n F) (hmod : ModThree false (2 ^ n))
    {y : GL (Fin 3) F} (hy : Type123 false (2 ^ n) F y 2)
    {q : ℕ} (hq : q.Prime) (hqn : q ∣ 2 ^ n - 1) :
    ∃ x : slPi false 3 (2 ^ n) F, orderOf x = q ∧
      y * (x : GL (Fin 3) F) = (x : GL (Fin 3) F) * y := by
  have : Fact q.Prime := ⟨hq⟩
  have : Finite F := hK.finite
  let h : UnitaryFieldData 2 n F := hK.unitary
  obtain ⟨ε, hε3, hε1, z, hz, g, hg, hdiag⟩ := hy
  obtain ⟨e⟩ := centralizer_diagE_mulEquiv hK hε1
  have hGU : glPi false 2 (2 ^ n) F = CFSG.LieType.SeitzGeneration.gu2 h := by
    ext a
    rw [mem_glPi_false h, CFSG.LieType.SeitzGeneration.mem_gu2 h]
  have hqGU : q ∣ Nat.card ↥(glPi false 2 (2 ^ n) F) := by
    rw [hGU, CFSG.LieType.SeitzGeneration.card_gu2 h]
    exact (hqn.trans (Nat.sub_one_dvd_pow_sub_one (2 ^ n) 2)).trans
      ((dvd_mul_left _ _).trans (dvd_mul_right _ _))
