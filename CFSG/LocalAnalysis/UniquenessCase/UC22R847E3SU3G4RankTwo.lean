  exact R847E3.normalizer_le_of_split_nine hG3 hRee hK3 k hp3 hXY hY.1.le hYN hKC hq
    (by omega) hXq hEM (hEC.trans (centralizer_le_normalizer _)) hEa hEc hE hAY hBC hnotY
    hnotC hr ⟨ht.2, hY.1.le ht.1⟩ ht2 htC

theorem R847E3.exists_orderOf_nine_normalizing_of_center_ne_bot
    (hgr : GriessAllModelsStatement) {Y : Subgroup G}
    {n : ℕ} (hYn : IsSU3 (Bar2 Y) n) (hn : 2 < n) (h9 : 9 ∣ 2 ^ n + 1)
    (hZ : center (Bar2 Y) ≠ ⊥) {X : Subgroup G} (hXY : X ≤ Y)
    {q : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q) (hqn : q ∣ 2 ^ n - 1) (hXq : Nat.card X = q) :
    ∃ x ∈ Y ⊓ normalizer (X : Set G), orderOf x = 9 := by
  have hq2 : q ≠ 2 := by omega
  have h3n : 3 ∣ 2 ^ n + 1 := (by norm_num : 3 ∣ 9).trans h9
  have hZ3 : Nat.card (center (Bar2 Y)) = 3 := by
    have hdvd := (uc22ine229_card_center_dvd hgr hYn).trans (Nat.gcd_dvd_left 3 _)
    rcases (Nat.dvd_prime Nat.prime_three).1 hdvd with h | h
    · exact (hZ (Subgroup.card_eq_one.1 h)).elim
    · exact h
  have hcl := CFSG.Blueprint.LieModel.statedClassicalModel hYn.2 (by decide)
  obtain ⟨-, F, _, _, hFcard, ⟨e⟩⟩ := hcl
  have : CharP F 2 := uc22pwlie_charP_two (n := 2 * n)
    (by rw [hFcard, ← pow_mul, mul_comm])
  have hperf : Group.IsPerfect (Bar2 Y) := ⟨hYn.1.1⟩
  obtain ⟨α⟩ := CFSG.HardMathSupport.Timmesfeld.FieldBonus.mulEquiv_statedSU_of_three_cover hgr
    Nat.prime_two (by omega) hFcard h3n (by
      have h8 : 2 ^ 3 ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) (by omega)
      norm_num at h8
      omega) hperf hZ3 e
  let β : CFSG.LieType.Universal.Unitary.SU (unitaryInvolution F 2 n) 3 ≃* Bar2 Y :=
    (equivStatedSU hFcard 3).trans α.symm
  let T : Subgroup (Bar2 Y) := (uc22pwsu3H (unitaryInvolution F 2 n)).map β.toMonoidHom
  have hTc : IsCyclic T := by
    have : IsCyclic (uc22pwsu3H (unitaryInvolution F 2 n)) := uc22pwsu3H_cyclic
    exact isCyclic_of_surjective (β.toMonoidHom.subgroupMap _) (β.toMonoidHom.subgroupMap_surjective _)
  have hTc0 : Nat.card T = 2 ^ (2 * n) - 1 := by
    rw [Subgroup.card_map_of_injective β.injective]
    change Nat.card (levelTorus (unitaryInvolution F 2 n) (0 : Fin (3 / 2))) = _
    rw [CFSG.LieType.Steinberg.card_levelTorus_three hFcard, pow_mul']
  have hqT : q ∣ Nat.card T := by
    rw [hTc0, pow_mul']
    exact hqn.trans (Nat.sub_one_dvd_pow_sub_one (2 ^ n) 2)
  have h9T : 9 ∣ Nat.card T := by
    rw [hTc0, pow_mul', uc22pwsu3_sq_sub_one (by omega : 1 ≤ n)]
    exact h9.trans (dvd_mul_left _ _)
  have : IsCyclic T := hTc
  obtain ⟨z, hz⟩ := UCK.l3_exists_orderOf_eq (H := T) h9T
  have hrq : CFSG.Open.pRank q (⊤ : Subgroup (Bar2 Y)) ≤ 1 :=
    uc22ine229_pRank_le_one_of_isSU3 hYn hq hq2
      (uc22ine229_not_dvd_two_pow_add_one hq hq2 hqn)
      (uc22ine229_not_dvd_card_center hgr hYn hq hq2 hqn)
  obtain ⟨g, hg⟩ := uc22ine229_exists_conj_centralizer hXY hq hq2 hXq hrq hTc hqT
  obtain ⟨y, hyN, hy⟩ := uc22ine229_exists_lift hXY hq hq2
    (IsPGroup.of_card (n := 1) (by rw [hXq, pow_one])) (centralizer_le_normalizer _ (hg z z.2))
  have hz9 : orderOf (g * (z : Bar2 Y) * g⁻¹) = 9 := by
    change orderOf ((MulAut.conj g).toMonoidHom (z : Bar2 Y)) = 9
    rw [orderOf_injective _ (MulAut.conj g).injective, Subgroup.orderOf_coe, hz]
  have h9y : 9 ∣ orderOf (y : G) := by
    rw [Subgroup.orderOf_coe, ← hz9, ← hy]
    exact orderOf_map_dvd _ _
  refine ⟨(y : G) ^ (orderOf (y : G) / 9),
    pow_mem (show (y : G) ∈ Y ⊓ normalizer (X : Set G) from ⟨y.2, hyN⟩) _, ?_⟩
  exact orderOf_pow_orderOf_div (orderOf_pos _).ne' h9y


theorem R847E3.normalizer_le_of_center_ne_bot_of_two_le
    (hG3 : CFSG.HardMathSupport.RichardWeiss.RecognitionPresentation.StrongThree.Gls3StronglyThreeEmbeddedPlus)
    (hRee : CFSG.AGLEmbedding.KFactReeInvolution)
    (hK3 : CFSG.LocalAnalysis.UniquenessCase.PartOne.Section7.StronglyEmbeddedThree)
    (hgr : GriessAllModelsStatement) (hCart : uc22pwCartanSU3)
    (k : CFSG.LocalAnalysis.UniquenessCase.PartOne.Section7.Sec7Core4 G) (hp3 : k.p = 3)
    {Y : Subgroup G} (hY : Y ∈ calC k.M) {n : ℕ} (hYn : IsSU3 (Bar2 Y) n)
    (hn : 2 < n) (h9 : 9 ∣ 2 ^ n + 1) (hZ : center (Bar2 Y) ≠ ⊥)
    {X : Subgroup G} (hXY : X ≤ Y) {q : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q)
    (hqn : q ∣ 2 ^ n - 1) (hXq : Nat.card X = q)
    (hr : 2 ≤ CFSG.Open.pRank 3 (normalizer (X : Set G) ⊓ k.M)) :
    normalizer (X : Set G) ≤ k.M := by
  by_contra hnot
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hq2 : q ≠ 2 := by omega
  have hX1 : X ≠ ⊥ := by
    rintro rfl
    rw [Subgroup.card_bot] at hXq
    exact hq.one_lt.ne hXq
  have hH := k.config_normalizer hX1 (hXY.trans hY.1.le)
    (by simpa [hp3, inf_comm] using hr) hnot
  obtain ⟨P, hP⟩ := CFSG.ABGLocalTools.exists_isSylowOf 3 (normalizer (X : Set G) ⊓ k.M)
  obtain ⟨hexp, halt⟩ := k.r7_8At3_of_config hG3 hRee hK3 hp3 hH (hp3.symm ▸ hP)
  rcases halt with ⟨-, -, hPO⟩ | ⟨-, S, hS, -, -, -, hSC⟩
  · rw [← hPO, hp3] at hexp
    obtain ⟨x, hx, hx9⟩ := R847E3.exists_orderOf_nine_normalizing_of_center_ne_bot hgr hYn hn h9
      hZ hXY hq hq5 hqn hXq
    have hx3 : IsPGroup 3 (zpowers x) :=
      IsPGroup.of_card (n := 2) (by rw [Nat.card_zpowers, hx9]; norm_num)
    obtain ⟨g, hg, hgx⟩ := CFSG.LocalAnalysis.RankThreeUC.exists_conj_mem_of_isSylowOf hP hx3
      (zpowers_le.2 ⟨hx.2, hY.1.le hx.1⟩)
    have he := hexp _ (hgx x (mem_zpowers x))
    have hcub : x ^ 3 = 1 := by
      rw [conj_pow] at he
      have h := congrArg (fun y : G => g⁻¹ * y * g) he
      simpa [mul_assoc] using h
    have hdvd := orderOf_dvd_of_pow_eq_one hcub
    rw [hx9] at hdvd
    norm_num at hdvd
  · have hrq := uc22ine229_pRank_le_one_of_isSU3 hYn hq hq2
      (uc22ine229_not_dvd_two_pow_add_one hq hq2 hqn)
      (uc22ine229_not_dvd_card_center hgr hYn hq hq2 hqn)
    obtain ⟨t, ht, ht2, htC⟩ := R847E3.exists_two_element_not_centralizing_of_cartan hCart hY.2.2
      hn hYn hq hq2 hqn hrq hXY hXq
    exact R847E3.not_ree_alternative_of_two_element k hp3 hq (by omega) hXq
      ⟨ht.2, hY.1.le ht.1⟩ ht2 htC (by simpa [hp3] using hS) hSC


theorem R847E3.normalizer_le_of_isSU3_of_three_le
    (hG3 : Gls3StronglyThreeEmbeddedPlus) (hRee : CFSG.AGLEmbedding.KFactReeInvolution)
    (hK3 : StronglyEmbeddedThree) (hgr : GriessAllModelsStatement) (hT : uc22pwTorusSU3)
    (k : Sec7Core4 G) (hp3 : k.p = 3) {Y : Subgroup G} (hY : Y ∈ calC k.M)
    (hYN : (Y.subgroupOf k.M).Normal) {n : ℕ} (hYn : IsSU3 (Bar2 Y) n)
    (hn : Odd n) (hn3 : 3 ≤ n) (h9 : 9 ∣ 2 ^ n + 1) {X : Subgroup G}
    (hXY : X ≤ Y) {q : ℕ} (hq : q.Prime) (hq5 : 5 ≤ q) (hqn : q ∣ 2 ^ n - 1)
    (hXq : Nat.card X = q) (hr : 3 ≤ CFSG.Open.pRank 3 (normalizer (X : Set G) ⊓ k.M)) :
    normalizer (X : Set G) ≤ k.M := by
  by_contra hnot
  have hYM : Y ≤ k.M := hY.1.le
  have hnorm : k.M ≤ normalizer (Y : Set G) :=
    (normal_subgroupOf_iff_le_normalizer hYM).1 hYN
  have hX1 : X ≠ ⊥ := by
    rintro rfl
    rw [Subgroup.card_bot] at hXq
    exact hq.one_lt.ne hXq
  have hH := k.config_normalizer hX1 (hXY.trans hYM)
    (by simpa only [hp3, inf_comm] using (by omega : 2 ≤
      CFSG.Open.pRank 3 (normalizer (X : Set G) ⊓ k.M))) hnot
  have hYrank : CFSG.Open.pRank 3 Y ≤ 2 :=
    (uc22ine229_pRank_le_bar Y Nat.prime_three (by norm_num)).trans
      (pRank_three_le_two_of_isSU3 hgr hYn hn hn3)
  have hn3' : 2 < n := by omega
  obtain ⟨ρ, hρ, hρ3, y, hy, hne⟩ :=
    uc22ine229_exists_three_noncentral hT hgr hY hn3' hYn h9 hq hq5 hqn hXY hXq
  have hρ1 : ρ ≠ 1 := by
    rintro rfl
    apply hne
    simp
  have hρdiv : 3 ∣ Nat.card ↥(Y ⊓ normalizer (X : Set G)) := by
    obtain ⟨j, hj⟩ := hρ3.exists_card_eq
    have hj0 : j ≠ 0 := by
      intro hj0
      have hcard : Nat.card (zpowers ρ) = 1 := by simpa [hj0] using hj
      have hb : zpowers ρ = ⊥ := Subgroup.card_eq_one.1 hcard
      exact hρ1 (Subgroup.zpowers_eq_bot.1 hb)
    have h3pow : 3 ∣ Nat.card (zpowers ρ) := by
      rw [hj]
      exact dvd_pow_self 3 hj0
    exact h3pow.trans (Subgroup.card_dvd_of_le (zpowers_le.2 hρ))
  exact k.not_dvd_card_inf_of_pRank_le_two hG3 hRee hK3 hp3 hH hr hnorm hYM hYrank hρdiv

