theorem R847E3.two_le_pRank_normalizer_of_pgl_kernel_three
    (hK : PiField false 2 n F) (hmod : ModThree false (2 ^ n))
    (e : L ≃* slPi false 3 (2 ^ n) F) {A : Subgroup J}
    (hA : Maximal (fun B : Subgroup J => CFSG.Assembly.IsElemAbelian 3 B) A)
    (hA27 : Nat.card A = 27) {c : J} (hc3 : orderOf c = 3)
    (hAc : A ⊓ centralizer (L : Set J) = zpowers c)
    (hpgl : ∀ a ∈ A, ∃ y, IsPGLAt e a y)
    {q : ℕ} (hq : q.Prime) (hqn : q ∣ 2 ^ n - 1)
    (hqr : CFSG.Open.pRank q L ≤ 1) {X : Subgroup J} (hXL : X ≤ L) (hXq : Nat.card X = q) :
    2 ≤ CFSG.Open.pRank 3 (normalizer (X : Set J)) := by
  have : Fact q.Prime := ⟨hq⟩
  have hAa : CFSG.Open.IsElemAbelian 3 A := hA.1
  have hcAC : c ∈ A ⊓ centralizer (L : Set J) := hAc ▸ mem_zpowers c
  obtain ⟨hcL, hLC⟩ := mem_and_inf_centralizer_eq hK hmod e hA hc3 hAc
  by_cases hAL : A ⊓ L ≤ zpowers c
  · have hcard : Nat.card ↥(A ⊓ L) ≤ 3 := by
      have h := card_le_of_le hAL
      rwa [Nat.card_zpowers, hc3] at h
    have htwo := R847E3.two_le_pRank_normalizer_inf_of_card Nat.prime_three
      (by norm_num) hq le_top le_top (by rw [normalizer_eq_top]; exact le_top)
      hAa (by
        calc _ ≤ 3 ^ 2 * 3 := Nat.mul_le_mul_left _ hcard
          _ = Nat.card A := by rw [hA27]; norm_num) hqr hXL hXq
    simpa using htwo
  obtain ⟨b, hb, hbc⟩ := SetLike.not_le_iff_exists.1 hAL
  have hbC : b ∉ centralizer (L : Set J) := fun h => hbc (hLC ▸ ⟨hb.2, h⟩)
  have hR : Nat.card (pglHom hK hmod A hpgl).range = 9 :=
    (card_eq_of_pgl hK hmod hA (by omega) hc3 hAc hpgl).2
  obtain ⟨a, haA, haL, y, hya, hy2⟩ :=
    R847E3.exists_type_two_of_pgl hK hmod e hAa hpgl hR hb.1 hb.2 hbC
  have ha3 : orderOf a = 3 := by
    have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    exact orderOf_eq_prime (hAa.2 a haA) (fun h => haL (h ▸ one_mem _))
  have hcZ : zpowers c ≤ L := zpowers_le.2 hcL
  have hca : zpowers c ≤ centralizer (zpowers a : Set J) := by
    rw [le_centralizer_iff]
    exact (zpowers_le.2 haA).trans (le_centralizer_iff.1
      (zpowers_le.2 (show c ∈ centralizer (A : Set J) from by
        rw [mem_centralizer_iff]
        intro a ha
        exact CFSG.Open.IsElemAbelian.comm hAa ha hcAC.1)))
  obtain ⟨hEel, hEc⟩ := uc22s217u3b_sup_elemAbelian Nat.prime_three ha3 haL hcZ hca
    (by rw [Nat.card_zpowers, hc3])
  let E : Subgroup J := zpowers a ⊔ zpowers c
  obtain ⟨x, hxq, hxy⟩ := R847E3.exists_prime_order_commuting_of_type_two hK hmod hy2 hq hqn
  let x' : J := e.symm x
  have hx'L : x' ∈ L := (e.symm x).2
  have hx'q : orderOf x' = q := by
    change orderOf ((e.symm x : L) : J) = q
    rw [Subgroup.orderOf_coe]
    exact (orderOf_injective e.symm.toMonoidHom e.symm.injective x).trans hxq
  have hax : a * x' = x' * a := by
    have hfix : slAct e ⟨a, mem_normalizer_of_normal a⟩ x = x := by
      apply Subtype.ext
      rw [hya.2, hxy, mul_inv_cancel_right]
    have h1 := congrArg (fun s => (e.symm s : J)) hfix
    rw [slAct_apply, MulEquiv.symm_apply_apply] at h1
    change a * x' * a⁻¹ = x' at h1
    calc a * x' = (a * x' * a⁻¹) * a := by group
      _ = x' * a := by rw [h1]
  have hEX : E ≤ centralizer (zpowers x' : Set J) := by
    refine sup_le ?_ ?_
    · rw [zpowers_le, mem_centralizer_iff]
      intro x hx
      obtain ⟨j, rfl⟩ := mem_zpowers_iff.1 hx
      exact (show Commute x' a from hax.symm).zpow_left j
    · exact (zpowers_le.2 hcAC.2).trans (centralizer_le (SetLike.coe_subset_coe.2
        (zpowers_le.2 hx'L)))
  obtain ⟨g, hgL, hgX⟩ := CFSG.LocalAnalysis.RankThreeUC.exists_mem_map_conj_eq_of_card_eq_prime
    hqr hXL (zpowers_le.2 hx'L) hXq (by rw [Nat.card_zpowers, hx'q])
  let E' : Subgroup J := E.map (MulAut.conj g⁻¹).toMonoidHom
  have hE'X : E' ≤ centralizer (X : Set J) := by
    rintro _ ⟨a', ha', rfl⟩
    rw [mem_centralizer_iff]
    intro x hx
    have hx' : g * x * g⁻¹ ∈ zpowers x' := by
      rw [← hgX]
