theorem R847E3.not_ree_alternative_of_two_element
    (k : Sec7Core4 G) (hp3 : k.p = 3) {X : Subgroup G} {q : ℕ}
    (hq : q.Prime) (hq3 : q ≠ 3) (hXc : Nat.card X = q)
    {t : G} (ht : t ∈ normalizer (X : Set G) ⊓ k.M)
    (ht2 : IsPGroup 2 (zpowers t)) (htC : t ∉ centralizer (X : Set G))
    {S : Subgroup G}
    (hS : CFSG.ABGLocalTools.IsSylowOf 2 S (normalizer (X : Set G) ⊓ k.M))
    (hSC : S ≤ centralizer (F07.PPrimeCoreIn k.p (normalizer (X : Set G)) : Set G)) : False := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hXC : X ≤ F07.PPrimeCoreIn k.p (normalizer (X : Set G)) := by
    rw [hp3]
    exact uc22ine229_le_pPrimeCore_normalizer Nat.prime_three hq hq3 hXc
  obtain ⟨g, hg, hgt⟩ := CFSG.GH74.GLS.C3.Layer1.U1a.exists_mem_conj_le hS
    (zpowers_le.2 ht) ht2
  have hgtC : g⁻¹ * t * g ∈ centralizer (X : Set G) :=
    (hSC (hgt t (mem_zpowers t))) |> (centralizer_le (SetLike.coe_subset_coe.2 hXC))
  have hgN : g ∈ normalizer (X : Set G) := hg.1
  have hNC : normalizer (X : Set G) ≤ normalizer (centralizer (X : Set G) : Set G) :=
    CFSG.BenderSuzuki.normalizer_le_normalizer_centralizer _
  have htc : g * (g⁻¹ * t * g) * g⁻¹ ∈ centralizer (X : Set G) :=
    (mem_normalizer_iff.1 (hNC hgN) _).1 hgtC
  exact htC (by simpa [mul_assoc] using htc)

theorem R847E3.normalizer_le_of_split_nine
    (hG3 : Gls3StronglyThreeEmbeddedPlus) (hRee : CFSG.AGLEmbedding.KFactReeInvolution)
    (hK3 : StronglyEmbeddedThree) (k : Sec7Core4 G) (hp3 : k.p = 3)
    {Y X C E A B : Subgroup G} (hXY : X ≤ Y) (hYM : Y ≤ k.M)
    (hYN : k.M ≤ normalizer (Y : Set G)) (hCN : k.M ≤ normalizer (C : Set G))
    {q : ℕ} (hq : q.Prime) (hq3 : q ≠ 3) (hXc : Nat.card X = q)
    (hEM : E ≤ k.M) (hEX : E ≤ normalizer (X : Set G))
    (hEa : IsElemAbelian 3 E) (hEc : Nat.card E = 9)
    (hE : E = A ⊔ B) (hAY : A ≤ Y) (hBC : B ≤ C)
    (hnotY : ¬ E ≤ Y) (hnotC : ¬ E ≤ C)
    (hr : CFSG.Open.pRank 3 (normalizer (X : Set G) ⊓ k.M) ≤ 2)
    {t : G} (ht : t ∈ normalizer (X : Set G) ⊓ k.M)
    (ht2 : IsPGroup 2 (zpowers t)) (htC : t ∉ centralizer (X : Set G)) :
    normalizer (X : Set G) ≤ k.M := by
  by_contra hnot
  have hEHM := le_inf hEX hEM
  have h2 : 2 ≤ CFSG.Open.pRank 3 (normalizer (X : Set G) ⊓ k.M) :=
    CFSG.SectionRank.le_pRank Nat.prime_three.one_lt hEHM hEa (by simpa using hEc)
  have hX1 : X ≠ ⊥ := by
    rintro rfl
    rw [Subgroup.card_bot] at hXc
    exact hq.one_lt.ne hXc
  have hH := k.config_normalizer hX1 (hXY.trans hYM) (by simpa [hp3, inf_comm] using h2) hnot
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let HM : Subgroup G := normalizer (X : Set G) ⊓ k.M
  obtain ⟨P₀, hP₀⟩ := (hEa.isPGroup.comap_subtype (K := HM)).exists_le_sylow
  let P : Subgroup G := (P₀ : Subgroup HM).map HM.subtype
  have hP : CFSG.ABGLocalTools.IsSylowOf 3 P (normalizer (X : Set G) ⊓ k.M) := ⟨P₀, rfl⟩
  have hEP : E ≤ P := by
    intro e he
    exact ⟨⟨e, hEHM he⟩, hP₀ (mem_subgroupOf.2 he), rfl⟩
  obtain ⟨hexp, halt⟩ := k.r7_8At3_of_config hG3 hRee hK3 hp3 hH (hp3.symm ▸ hP)
  rcases halt with ⟨hMN, hirr, hPO⟩ | ⟨-, S, hS, -, -, -, hSC⟩
  · rw [← hPO] at hexp hirr
    rw [hp3] at hexp
    have hNle : CFSG.Open.rankThreeLayer (normalizer (X : Set G)) ⊓ normalizer (P : Set G) ≤ k.M := by
      refine (le_inf (inf_le_left.trans (CFSG.LocalAnalysis.RankThreeTheoremC.rankThreeLayer_le _))
        inf_le_right).trans ?_
      rw [← hMN]
      exact inf_le_right
    have hPr : CFSG.Open.pRank 3 P ≤ 2 :=
      (CFSG.SectionRank.pRank_mono Nat.prime_three.one_lt hP.le).trans hr
    exact Sec7Core4.false_of_elemAbelian_sup_of_irreducible hP.isPGroup hexp hPr inf_le_right hirr
      (hNle.trans hYN) (hNle.trans hCN) hEP hEc hE hAY hBC hnotY hnotC
  · exact R847E3.not_ree_alternative_of_two_element k hp3 hq hq3 hXc ht ht2 htC
      (by simpa [hp3] using hS) hSC

theorem R847E3.exists_two_element_not_centralizing_of_cartan (hC : uc22pwCartanSU3) {Y : Subgroup G}
    (hY : CFSG.Open.IsQuasisimple (Bar2 Y)) {n : ℕ} (hn : 2 < n) (hX : IsSU3 (Bar2 Y) n) {q : ℕ} (hq : q.Prime)
    (hq2 : q ≠ 2) (hqn : q ∣ 2 ^ n - 1)
    (hrank : CFSG.Open.pRank q (⊤ : Subgroup (Bar2 Y)) ≤ 1) {X : Subgroup G} (hXY : X ≤ Y)
    (hXc : Nat.card X = q) : ∃ t ∈ Y ⊓ normalizer (X : Set G),
      IsPGroup 2 (zpowers t) ∧ t ∉ centralizer (X : Set G) := by
  have : Fact q.Prime := ⟨hq⟩
  obtain ⟨U⟩ : Nonempty (Sylow 2 (Bar2 Y)) := inferInstance
  obtain ⟨e, m', hm', hnm⟩ := Nat.exists_eq_two_pow_mul_odd (show n ≠ 0 by omega)
  obtain ⟨E, -, -, -, -, hπ, -, -, w, hw2, hwE, -⟩ := hC (Bar2 Y) hY n hn hX U Unit
    (IsPGroup.of_card (n := 0) (by simp)) 1 (fun _ _ => Iff.rfl) e m' hm' hnm
  have hqE : q ∣ Nat.card E := by
    have h : q ∈ piSet E := hπ ▸ (⟨hq, hqn⟩ : q ∈ etaSet n)
    exact h.2
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' q hqE
  have hZc : Nat.card (zpowers (x : Bar2 Y)) = q := by
    rw [Nat.card_zpowers, Subgroup.orderOf_coe, hx]
  obtain ⟨g, hg⟩ :=
    CFSG.AGLEmbeddingD2.Tits.OrdinaryProofs.isConj_of_natCard_eq_prime_of_sylow_cyclic
      (fun Q => RankFourTheoremC.Nongeneration.isCyclic_sylow_of_pRank_le_one hq2 hrank Q) hZc
      (uc22ine229_card_map hXY hq hq2 hXc)
  have hwZ : w ∈ normalizer ((zpowers (x : Bar2 Y)) : Set (Bar2 Y)) := by
    rw [UC6S846.mem_normalizer_iff_map_conj, MonoidHom.map_zpowers]
    show zpowers (w * (x : Bar2 Y) * w⁻¹) = _
    rw [hwE x x.2, Subgroup.zpowers_inv]
  have hw' : MulAut.conj g w ∈ normalizer
      (((X.subgroupOf Y).map (QuotientGroup.mk' (CFSG.pCore 2 ↥Y))) : Set (Bar2 Y)) := by
    rw [← hg, ← Subgroup.map_equiv_normalizer_eq]
    exact Subgroup.mem_map_of_mem _ hwZ
  have hw1 : MulAut.conj g w ≠ 1 := by
    intro h
    have hw : w = 1 := (MulAut.conj g).injective (h.trans (map_one _).symm)
    have h1 := hwE x x.2
    rw [hw, one_mul, inv_one, mul_one] at h1
    have h2 : (x : Bar2 Y) ^ 2 = 1 := by
      rw [sq]
      exact mul_eq_one_iff_eq_inv.2 h1
    have h3 := orderOf_dvd_of_pow_eq_one h2
    rw [Subgroup.orderOf_coe, hx] at h3
    exact hq2 ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).1 h3)
  obtain ⟨y, hyN, hy⟩ := uc22ine229_exists_lift hXY hq hq2
    (IsPGroup.of_card (n := 1) (by rw [hXc, pow_one])) hw'
  have h2 : y ^ 2 ∈ CFSG.pCore 2 ↥Y := by
    rw [← QuotientGroup.ker_mk' (CFSG.pCore 2 ↥Y), MonoidHom.mem_ker, map_pow, hy,
      MulAut.conj_apply, conj_pow, hw2, mul_one, mul_inv_cancel]
  obtain ⟨k, hk⟩ := CFSG.pCore_isPGroup (p := 2) (G := ↥Y) ⟨y ^ 2, h2⟩
  have hyk : (y : G) ^ 2 ^ (k + 1) = 1 := by
    have h : (y ^ 2) ^ 2 ^ k = 1 := by simpa using congrArg Subtype.val hk
    have h' : y ^ 2 ^ (k + 1) = 1 := by
      rw [pow_succ', pow_mul]
      exact h
    simpa using congrArg Subtype.val h'
  have hyC : (y : G) ∉ centralizer (X : Set G) := by
    intro hc
    have hwC := uc22ine229_mk_mem_centralizer (y := y) hc
    rw [hy] at hwC
    have hw'C : w ∈ centralizer (zpowers (x : Bar2 Y) : Set (Bar2 Y)) := by
      rw [mem_centralizer_iff]
      intro x' hx'
      have hgm : MulAut.conj g x' ∈ (X.subgroupOf Y).map (QuotientGroup.mk' (CFSG.pCore 2 Y)) := by
        rw [← hg]
        exact mem_map_of_mem (MulAut.conj g).toMonoidHom hx'
      apply (MulAut.conj g).injective
      simpa only [map_mul] using (mem_centralizer_iff.1 hwC) _ hgm
    have hxZ : (x : Bar2 Y) ∈ zpowers (x : Bar2 Y) := mem_zpowers _
    have hcomm := (mem_centralizer_iff.1 hw'C) _ hxZ
    have hinv : w * (x : Bar2 Y) * w⁻¹ = (x : Bar2 Y) := by
      rw [← hcomm, mul_inv_cancel_right]
    have hxi : (x : Bar2 Y) = (x : Bar2 Y)⁻¹ := hinv.symm.trans (hwE x x.2)
    have hx2 : (x : Bar2 Y) ^ 2 = 1 := by
      rw [sq]
      exact mul_eq_one_iff_eq_inv.2 hxi
    have hdvd := orderOf_dvd_of_pow_eq_one hx2
    rw [Subgroup.orderOf_coe, hx] at hdvd
    exact hq2 ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).1 hdvd)
  refine ⟨y, ⟨y.2, hyN⟩, ?_, hyC⟩
  rintro ⟨z, hz⟩
  obtain ⟨i, rfl⟩ := mem_zpowers_iff.1 hz
  refine ⟨k + 1, Subtype.ext ?_⟩
  change ((y : G) ^ i) ^ (2 ^ (k + 1)) = 1
  rw [← zpow_natCast, ← _root_.zpow_mul, mul_comm, _root_.zpow_mul, zpow_natCast, hyk,
    one_zpow]


theorem R847E3.normalizer_le_of_isSU3_of_center_eq_bot_of_rank_le_two
    (hG3 : Gls3StronglyThreeEmbeddedPlus) (hRee : CFSG.AGLEmbedding.KFactReeInvolution)
