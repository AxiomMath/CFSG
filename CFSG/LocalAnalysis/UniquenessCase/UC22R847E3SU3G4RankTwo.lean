    (hE'X.trans (centralizer_le_normalizer _)) (hEel.map _)
    (by rw [Subgroup.card_map_of_injective (MulAut.conj g⁻¹).injective, hEc])

theorem R847E3.two_le_pRank_normalizer_of_pgl
    (hK : PiField false 2 n F) (hmod : ModThree false (2 ^ n))
    (e : L ≃* slPi false 3 (2 ^ n) F) {A : Subgroup J}
    (hA : Maximal (fun B : Subgroup J => CFSG.Assembly.IsElemAbelian 3 B) A)
    (hA27 : Nat.card A = 27) (hpgl : ∀ a ∈ A, ∃ y, IsPGLAt e a y)
    {q : ℕ} (hq : q.Prime) (hqn : q ∣ 2 ^ n - 1)
    (hqr : CFSG.Open.pRank q L ≤ 1) {X : Subgroup J} (hXL : X ≤ L) (hXq : Nat.card X = q) :
    2 ≤ CFSG.Open.pRank 3 (normalizer (X : Set J)) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let C : Subgroup J := A ⊓ centralizer (L : Set J)
  have hC : CFSG.Open.IsElemAbelian 3 C := hA.1.mono inf_le_left
  by_cases hC9 : 9 ≤ Nat.card C
  · obtain ⟨E, hEC, hEa, hEc⟩ := UC6S846.exists_card_p_sq Nat.prime_three hC (by simpa using hC9)
    exact CFSG.SectionRank.le_pRank Nat.prime_three.one_lt
      ((hEC.trans inf_le_right).trans ((centralizer_le (SetLike.coe_subset_coe.2 hXL)).trans
        (centralizer_le_normalizer _))) hEa hEc
  obtain ⟨τ, hτ, hτ1⟩ := exists_tau hK hmod
  have hτ0 : τ ≠ 0 := by
    rintro rfl
    simp at hτ
  let ε : Fˣ := Units.mk0 τ hτ0
  let t : slPi false 3 (2 ^ n) F :=
    ⟨GeneralLinearGroup.scalar (Fin 3) ε, scalar_mem_slPi_of_cube hK hmod (by simpa [ε] using hτ)⟩
  have ht : ((t : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) = τ • 1 := by
    rw [coe_scalar_eq_smul]
    rfl
  have ht3 : t ^ 3 = 1 := by
    apply Subtype.ext
    apply Units.ext
    rw [Subgroup.coe_pow, Units.val_pow_eq_pow_val, ht, smul_pow, hτ, one_pow, one_smul]
    rfl
  have ht1 : t ≠ 1 := by
    intro h1
    have h00 := congrArg (fun x : slPi false 3 (2 ^ n) F =>
      ((x : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) 0 0) h1
    exact hτ1 (by simpa [ht] using h00)
  let c : J := e.symm t
  have hcL : c ∈ L := (e.symm t).2
  have hc3 : orderOf c = 3 := by
    change orderOf ((e.symm t : L) : J) = 3
    rw [Subgroup.orderOf_coe]
    exact (orderOf_injective e.symm.toMonoidHom e.symm.injective t).trans
      (orderOf_eq_prime ht3 ht1)
  have hcC : c ∈ centralizer (L : Set J) := by
    rw [mem_centralizer_iff]
    intro l hl
    have hcomm : e ⟨l, hl⟩ * t = t * e ⟨l, hl⟩ := Subtype.ext
      (CFSG.ClassicalGroups.UnitaryFlag.commute_scalar ε (e ⟨l, hl⟩ : GL (Fin 3) F)).eq
    have h := congrArg (fun x => (e.symm x : J)) hcomm
    simpa only [map_mul, Subgroup.coe_mul, MulEquiv.symm_apply_apply] using h
  have hcA : c ∈ A := by
    refine mem_of_maximal_of_commute hA (by rw [← hc3]; exact pow_orderOf_eq_one _) ?_
    intro a ha
    have hfix := mulAut_scalar_tau_eq hK hmod hτ hτ1 ht
      (slAct_pow_three e (hA.1.2 a ha))
    have h1 := congrArg (fun x => (e.symm x : J)) hfix
    rw [slAct_apply, MulEquiv.symm_apply_apply] at h1
    change a * c * a⁻¹ = c at h1
    calc a * c = (a * c * a⁻¹) * a := by group
      _ = c * a := by rw [h1]
  have hcK : zpowers c ≤ C := zpowers_le.2 ⟨hcA, hcC⟩
  have hCc : Nat.card C = 3 := by
    have h3dvd : 3 ∣ Nat.card C := by
      rw [← hc3, ← Nat.card_zpowers]
      exact Subgroup.card_dvd_of_le hcK
    obtain ⟨j, hj⟩ := hC.isPGroup.exists_card_eq
    rw [hj] at hC9 h3dvd ⊢
    have hj0 : j ≠ 0 := by
      intro h0
      rw [h0, pow_zero] at h3dvd
      norm_num at h3dvd
    have hj2 : j < 2 := by
      by_contra h2
      have h9 := Nat.pow_le_pow_right (by norm_num : 0 < (3 : ℕ)) (by omega : 2 ≤ j)
      norm_num at h9
      omega
    obtain rfl : j = 1 := by omega
    simp
  have hAc : A ⊓ centralizer (L : Set J) = zpowers c :=
    (Subgroup.eq_of_le_of_card_ge hcK (by rw [hCc, Nat.card_zpowers, hc3])).symm
  exact R847E3.two_le_pRank_normalizer_of_pgl_kernel_three hK hmod e hA hA27 hc3 hAc hpgl
    hq hqn hqr hXL hXq

theorem R847E3.two_le_pRank_normalizer_of_su3
    (hK : PiField false 2 n F) (hmod : ModThree false (2 ^ n)) (hn : 2 < 2 ^ n)
    (e : L ≃* slPi false 3 (2 ^ n) F)
