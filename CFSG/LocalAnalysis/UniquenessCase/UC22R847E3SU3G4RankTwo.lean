variable {J : Type} [Group J] [Finite J]

theorem R847E3.two_le_pRank_normalizer_of_bar_su3
    {M Y : Subgroup J} (hYM : Y ≤ M) (hYN : M ≤ normalizer (Y : Set J))
    (hOp : F10.OpRes 3 M = M) (hMr : CFSG.Open.pRank 3 M = 3)
    (hK : PiField false 2 n F) (hmod : ModThree false (2 ^ n)) (hn : 2 < 2 ^ n)
    (e : Bar2 Y ≃* slPi false 3 (2 ^ n) F)
    {X : Subgroup J} (hXY : X ≤ Y) {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2)
    (hqn : q ∣ 2 ^ n - 1) (hXc : Nat.card X = q) (hYr : CFSG.Open.pRank q Y ≤ 1) :
    2 ≤ CFSG.Open.pRank 3 (normalizer (X : Set J) ⊓ M) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have : Fact q.Prime := ⟨hq⟩
  let π : M →* Bar2 M := QuotientGroup.mk' (CFSG.pCore 2 M)
  let Ym : Subgroup M := Y.subgroupOf M
  let Yb : Subgroup (Bar2 M) := Ym.map π
  let Xm : Subgroup M := X.subgroupOf M
  let Xb : Subgroup (Bar2 M) := Xm.map π
  have hYm : Ym.Normal := (normal_subgroupOf_iff_le_normalizer hYM).2 hYN
  have hYb : Yb.Normal := hYm.map π (QuotientGroup.mk'_surjective _)
  have hYsn : CFSG.Open.IsSubnormal Ym ⊤ := by
    have htop : (Ym.subgroupOf (⊤ : Subgroup M)).Normal :=
      (normal_subgroupOf_iff_le_normalizer le_top).2 (by rw [normalizer_eq_top])
    exact CFSG.Quasithin.A3.subnormal_of_normal le_top htop
  let eYm : Ym ≃* Y := subgroupOfEquivOfLe hYM
  let eYb : Yb ≃* slPi false 3 (2 ^ n) F :=
    (UC6S846.barIso hYsn).symm.trans ((UC6S846.bar2Equiv eYm).trans e)
  have hπk : IsPGroup 2 π.ker := by
    rw [QuotientGroup.ker_mk']
    exact CFSG.pCore_isPGroup
  have hcop3 : ¬ 3 ∣ Nat.card (CFSG.pCore 2 M) := by
    intro hd
    obtain ⟨j, hj⟩ := CFSG.pCore_isPGroup (p := 2) (G := M) |>.exists_card_eq
    rw [hj] at hd
    have := Nat.prime_three.dvd_of_dvd_pow hd
    norm_num at this
  have hMbr : CFSG.Open.pRank 3 (⊤ : Subgroup (Bar2 M)) = 3 := by
    rw [CFSG.SectionRank.pRank_quotient_eq _ hcop3,
      ← CFSG.SectionRank.pRank_eq_pRank_top_subgroup, hMr]
  have hgen : closure {g : M | g ∈ (⊤ : Subgroup M) ∧ ¬ 3 ∣ orderOf g} = ⊤ := by
    have h' := UC6S846.closure_pPrime_subgroupOf (le_refl M) hOp
    simpa only [Subgroup.subgroupOf_self] using h'
  have hgenb : closure {g : Bar2 M | ¬ 3 ∣ orderOf g} = ⊤ := by
    have h' := UC6S846.closure_pPrime_map π ⊤ hgen
    have htop : (⊤ : Subgroup M).map π = ⊤ :=
      Subgroup.map_top_of_surjective π (QuotientGroup.mk'_surjective _)
    simpa only [htop, mem_top, true_and] using h'
  have hXmY : Xm ≤ Ym := fun x hx => hXY hx
  have hXbY : Xb ≤ Yb := Subgroup.map_mono hXmY
  have hXmp : IsPGroup q Xm :=
    (IsPGroup.of_card (n := 1) (by rw [hXc, pow_one]) : IsPGroup q X).comap_subtype
  have hXmd : Disjoint Xm π.ker := Subgroup.disjoint_def.2 fun hx hk =>
    UC6S846.eq_one_of_mem_isPGroup_of_mem_isPGroup hq hq2 hXmp hπk hx hk
  have hXbc : Nat.card Xb = q := by
    rw [UC6S846.card_map_of_disjoint_ker π Xm hXmd,
      Nat.card_congr (subgroupOfEquivOfLe (hXY.trans hYM)).toEquiv, hXc]
  have hYmqr : CFSG.Open.pRank q Ym ≤ 1 := by
    rw [CFSG.SectionRank.pRank_eq_pRank_top_subgroup,
      CFSG.SectionRank.pRank_top_eq_of_mulEquiv hq.one_lt eYm,
      ← CFSG.SectionRank.pRank_eq_pRank_top_subgroup]
    exact hYr
  have hYbr : CFSG.Open.pRank q Yb ≤ 1 := by
    rw [CFSG.PreuniquenessRankFour.Helpers.pRank_quotient_map_of_coprime_normal q hq
      (CFSG.pCore 2 M) (by
        intro hd
        obtain ⟨j, hj⟩ := CFSG.pCore_isPGroup (p := 2) (G := M) |>.exists_card_eq
        rw [hj] at hd
        exact hq2 ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).1 (hq.dvd_of_dvd_pow hd)))]
    exact hYmqr
  have hb := R847E3.two_le_pRank_normalizer_of_su3 hK hmod hn eYb hgenb hMbr hq hqn
    hYbr hXbY hXbc
  have hMnorm := R847E3.two_le_pRank_normalizer_of_quotient π (QuotientGroup.mk'_surjective _)
    hπk hq hq2 hXmp hb
  have hnm : normalizer (Xm : Set M) = (normalizer (X : Set J) ⊓ M).subgroupOf M := by
    rw [← Subgroup.subgroupOf_normalizer_eq (hXY.trans hYM)]
    ext x
    change (x : J) ∈ normalizer (X : Set J) ↔
      (x : J) ∈ normalizer (X : Set J) ∧ (x : J) ∈ M
    simp only [x.2, and_true]
  rw [hnm, CFSG.SectionRank.pRank_eq_pRank_top_subgroup,
    CFSG.SectionRank.pRank_top_eq_of_mulEquiv Nat.prime_three.one_lt
      (subgroupOfEquivOfLe (inf_le_right : normalizer (X : Set J) ⊓ M ≤ M)),
    ← CFSG.SectionRank.pRank_eq_pRank_top_subgroup] at hMnorm
  exact hMnorm

end OriginalGroup

