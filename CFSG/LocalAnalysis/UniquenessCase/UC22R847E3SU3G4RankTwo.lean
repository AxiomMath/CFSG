variable {G : Type} [Group G] [Finite G]

theorem not_dvd_card_inf_of_pRank_le_two (hG3 : Gls3StronglyThreeEmbeddedPlus)
    (hRee : CFSG.AGLEmbedding.KFactReeInvolution) (hK3 : StronglyEmbeddedThree)
    (k : Sec7Core4 G) (hp3 : k.p = 3) {H : Subgroup G} (hH : Config k H)
    (hr : 3 ≤ CFSG.Open.pRank 3 (H ⊓ k.M)) {Y : Subgroup G}
    (hYN : k.M ≤ normalizer (Y : Set G))
    (hYM : Y ≤ k.M) (hY3 : CFSG.Open.pRank 3 Y ≤ 2) :
    ¬ 3 ∣ Nat.card ↥(Y ⊓ H) := by
  intro hdiv
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨P, hP⟩ := CFSG.ABGLocalTools.exists_isSylowOf 3 (H ⊓ k.M)
  have hP' : CFSG.ABGLocalTools.IsSylowOf k.p P (H ⊓ k.M) := hp3.symm ▸ hP
  obtain ⟨-, hMN, hirr⟩ := r7_8p3_of_config hG3 hRee hK3 k hp3 hH
    (by simpa only [hp3] using hr) hP'
  have hPY : CFSG.ABGLocalTools.IsSylowOf 3 (P ⊓ (Y ⊓ H)) (Y ⊓ H) :=
    hP.inf_of_le_normalizer (le_inf inf_le_right (inf_le_left.trans hYM))
      ((le_inf (inf_le_right.trans hYN) (inf_le_left.trans le_normalizer)).trans
        inf_normalizer_le_normalizer_inf)
  have hPY1 : P ⊓ (Y ⊓ H) ≠ ⊥ :=
    CFSG.ABGTheoremB.V56.ne_bot_of_isSylowOf Nat.prime_three hPY hdiv
  have hPH : P ≤ H := hP.le.trans inf_le_left
  have hPHM : P ⊓ (Y ⊓ H) = P ⊓ Y := by
    rw [← inf_assoc, inf_eq_left.2 (inf_le_left.trans hPH)]
  rw [hPHM] at hPY1
  have hNHM : CFSG.Open.rankThreeLayer H ⊓ normalizer (P : Set G) ≤ H ⊓ k.M := by
    rw [hMN]
    exact inf_le_inf_right _ (CFSG.LocalAnalysis.RankThreeTheoremC.rankThreeLayer_le H)
  have hNY : CFSG.Open.rankThreeLayer H ⊓ normalizer (P : Set G) ≤
      normalizer ((P ⊓ Y : Subgroup G) : Set G) :=
    (le_inf inf_le_right (hNHM.trans (inf_le_right.trans hYN))).trans
      inf_normalizer_le_normalizer_inf
  rcases hirr (P ⊓ Y) inf_le_left hNY with hbot | hall
  · exact hPY1 hbot
  · have hPYle : P ≤ Y := by rw [← hall]; exact inf_le_right
    have hPr : CFSG.Open.pRank 3 P = CFSG.Open.pRank 3 (H ⊓ k.M) :=
      CFSG.LocalAnalysis.RankThreeTheoremC.pRank_eq_of_isSylowOf3 Nat.prime_three hP
    have hle := CFSG.SectionRank.pRank_mono Nat.prime_three.one_lt hPYle
    omega

theorem false_of_elemAbelian_sup_of_irreducible
    {P N Y C E A B : Subgroup G} (hP3 : IsPGroup 3 P)
    (hexp : ∀ x ∈ P, x ^ 3 = 1) (hr : CFSG.Open.pRank 3 P ≤ 2)
    (hNP : N ≤ normalizer (P : Set G))
    (hirr : IrrOnMod N P (CFSG.inSubgroup frattini P))
    (hNY : N ≤ normalizer (Y : Set G)) (hNC : N ≤ normalizer (C : Set G))
    (hEP : E ≤ P) (hEc : Nat.card E = 9) (hE : E = A ⊔ B)
    (hAY : A ≤ Y) (hBC : B ≤ C) (hnotY : ¬ E ≤ Y) (hnotC : ¬ E ≤ C) : False := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let Φ : Subgroup G := CFSG.inSubgroup frattini P
  have hΦP : Φ ≤ P := Subgroup.map_subtype_le _
  have hΦeq : Φ = CFSG.Quasithin.frattiniIn P := rfl
  have hNΦ : N ≤ normalizer (Φ : Set G) :=
    hNP.trans (CFSG.LocalAnalysis.RankThreeTheoremC.normalizer_le_normalizer_map_of_characteristic
      (frattini P))
  have hsmall := (CFSG.SectionRank.Ccomm.rank_two_exponent_prime_order_bound hP3
    (fun x : P => Subtype.ext (hexp x x.2)) (by
      rw [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup]
      exact hr)).1
  have hP9 : 3 ^ 2 ≤ Nat.card P := by
    have hcard := card_le_of_le hEP
    rw [hEc] at hcard
    omega
  have hΦc : Nat.card Φ ≤ 3 := by
    rw [hΦeq, CFSG.Quasithin.Ch1Sec3.frattiniIn_eq_commutator hP3 hexp]
    exact CFSG.Quasithin.H13.NQCore.card_commutator_le hexp hP9 hsmall
  have restrict : ∀ Z : Subgroup G, N ≤ normalizer (Z : Set G) → ¬ E ≤ Z →
      P ⊓ Z ≤ Φ := by
    intro Z hNZ hnot
    have hNW : N ≤ normalizer ((P ⊓ Z : Subgroup G) : Set G) :=
      (le_inf hNP hNZ).trans inf_normalizer_le_normalizer_inf
    have hNs : N ≤ normalizer (((P ⊓ Z) ⊔ Φ : Subgroup G) : Set G) :=
      (le_inf hNW hNΦ).trans (inf_normalizer_le_normalizer_sup _ _)
    rcases hirr ((P ⊓ Z) ⊔ Φ) le_sup_right (sup_le inf_le_left hΦP) hNs with hf | hp
    · have hf' : (P ⊓ Z) ⊔ Φ = Φ := hf
      rw [← hf']
      exact le_sup_left
    · have heq : P ⊓ Z = P :=
        CFSG.Quasithin.Ch1Sec3.eq_of_sup_frattiniIn_eq inf_le_left hp
      exact (hnot (hEP.trans (by rw [← heq]; exact inf_le_right))).elim
  have hAYP : A ≤ P ⊓ Y := le_inf (by rw [hE] at hEP; exact le_sup_left.trans hEP) hAY
  have hBCP : B ≤ P ⊓ C := le_inf (by rw [hE] at hEP; exact le_sup_right.trans hEP) hBC
  have hEΦ : E ≤ Φ := by
    rw [hE]
    exact sup_le (hAYP.trans (restrict Y hNY hnotY)) (hBCP.trans (restrict C hNC hnotC))
  have := card_le_of_le hEΦ
  omega

end CFSG.LocalAnalysis.UniquenessCase.PartOne.Section7.Sec7Core4

