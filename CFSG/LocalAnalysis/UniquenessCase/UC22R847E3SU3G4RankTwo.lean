variable {G : Type} [Group G] [Finite G]

theorem pRank_three_le_two_of_isSU3 (hgr : CFSG.Open.GriessAllModelsStatement)
    {X : Type} [Group X] [Finite X] {n : Nat}
    (hX : IsSU3 X n)
    (hn : Odd n) (hn3 : 3 ≤ n) :
    CFSG.Open.pRank 3 (⊤ : Subgroup X) ≤ 2 := by
  have hperf : Group.IsPerfect X := ⟨hX.1.1⟩
  have hSCMq : CFSG.Open.StatedClassicalModel (X ⧸ Subgroup.center X) .PSU 3 2 n :=
    CFSG.Blueprint.LieModel.statedClassicalModel hX.2 (by decide)
  have hdvd : Nat.card (Subgroup.center X) ∣ 3 := by
    have h1 : Nat.card (Subgroup.center X) ∣
        Nat.card (CFSG.RankThree.PerfectCover.hopfMultiplier (X ⧸ Subgroup.center X)) :=
      CFSG.Quasithin.B69K.OddCovers.card_center_dvd_hopfMultiplier hperf
        (MulEquiv.refl (X ⧸ Subgroup.center X))
    rw [CFSG.Quasithin.B69K.OddCovers.card_hopfMultiplier_psu3 hgr hSCMq] at h1
    exact h1.trans (Nat.gcd_dvd_left 3 (2 ^ n + 1))
  rcases (Nat.dvd_prime Nat.prime_three).1 hdvd with hZ | hZ
  ·
    have hZbot : Subgroup.center X = ⊥ := Subgroup.card_eq_one.1 hZ
    have hLM : CFSG.Blueprint.LieModel X .PSU 3 2 n :=
      CFSG.Blueprint.LieModel.of_quotient_center hZbot hX.2
    have hSCM : CFSG.Open.StatedClassicalModel X .PSU 3 2 n :=
      CFSG.Blueprint.LieModel.statedClassicalModel hLM (by decide)
    exact CFSG.Quasithin.B69K.pRank_le_two_of_psu3 hSCM Nat.prime_three (by norm_num)
  ·
    have h3dvd : 3 ∣ 2 ^ n + 1 := by
      simpa using Odd.nat_add_dvd_pow_add_pow 2 1 hn
    have hM : Nat.card
        (CFSG.RankThree.PerfectCover.hopfMultiplier (X ⧸ Subgroup.center X)) = 3 * 1 := by
      rw [CFSG.Quasithin.B69K.OddCovers.card_hopfMultiplier_psu3 hgr hSCMq,
        Nat.gcd_eq_left h3dvd, mul_one]
    obtain ⟨-, K, hKfield, hKfinite, hKcard, ⟨e⟩⟩ := hSCMq
    exact CFSG.Quasithin.B69K.OddCovers.pRank_three_le_two_of_psu3_cover hperf
      (by omega) hKcard e hZ h3dvd (Nat.coprime_one_right 3) hM


theorem R847E3.exists_split_nine_of_isSU3_of_center_eq_bot
    (hgr : GriessAllModelsStatement) (hT : uc22pwTorusSU3)
    {M Y : Subgroup G} (hY : Y ∈ calC M) (hYN : M ≤ normalizer (Y : Set G))
