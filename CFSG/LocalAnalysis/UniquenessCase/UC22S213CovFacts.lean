theorem uc22s213_typeFacts_m22z3
    {X : Type} [Group X] [Finite X]
    (h : F08.IsM22Z3 X) :
    Nat.card (center X) ≤ 3 ∧ (∀ S : Sylow 3 X, Nat.card (center (S : Subgroup X)) = 3) ∧
      (∀ p : ℕ, p.Prime → p ≠ 2 → p ≠ 3 → CFSG.Open.pRank p (⊤ : Subgroup (MulAut X)) ≤ 1) ∧
      2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup X) := by
  obtain ⟨hq, hZ, ⟨e⟩⟩ := h
  obtain ⟨b⟩ := CFSG.Sporadic.Bridge.M22.nonempty_mulEquiv
  obtain ⟨hZS, hm3⟩ := uc22s213_sylow_facts_of_cube fun R =>
    HardMathSupport.Solomon.Coordinator.t112m_sylow_hatM22
      ⟨hq.1.commutator_eq_top, hZ, ⟨e.trans b⟩⟩ R
  refine ⟨hZ.le, hZS, fun p hp hp2 hp3 => ?_, hm3⟩
  have : Group.IsPerfect X := hq.1
  have : Finite (CFSG.Blueprint.NativeSporadic.Carrier .M22) := Finite.of_equiv _ e.toEquiv
  refine (HardMathSupport.Timmesfeld.Tables.Multiplier.pRank_mulAut_le hp).trans ?_
  rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv hp.one_lt (MulAut.congr e)]
  exact PartTwo.S17.pRank_mulAut_m22_le_one hp hp2 hp3

theorem uc22s213_pRank_mulAut_sl3Four {X : Type} [Group X] [Finite X]
    (h : PartTwo.Inputs1719.PartOne.IsSL3Four X) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hp3 : p ≠ 3) : CFSG.Open.pRank p (⊤ : Subgroup (MulAut X)) ≤ 1 := by
  have : Group.IsPerfect X := Group.isPerfect_def.mpr h.1.1.1
  refine (HardMathSupport.Timmesfeld.Tables.Multiplier.pRank_mulAut_le hp).trans ?_
  obtain ⟨K, hK, hKf, hKc, ⟨eK⟩⟩ :=
    CFSG.RankThree.PartOne.AUTSL.exists_projectiveSL_equiv_of_lieModel h.1.2
  have hk : Nat.card K = 4 := by rw [hKc]; norm_num
  refine CFSG.QuasithinUnique.Id2519.pRank_le_one_of_not_sq_dvd hp ?_
  rw [Nat.card_congr (MulAut.congr eK).toEquiv, CFSG.RankThree.PartTwo.KFacts.L34.card_mulAut hk]
  exact PartTwo.S17.prime_sq_not_dvd_aut_L34 hp hp2 hp3

theorem uc22s213_typeFacts_sl3Four
    {X : Type} [Group X] [Finite X]
    (h : PartTwo.Inputs1719.PartOne.IsSL3Four X) :
    Nat.card (center X) ≤ 3 ∧ (∀ S : Sylow 3 X, Nat.card (center (S : Subgroup X)) = 3) ∧
      (∀ p : ℕ, p.Prime → p ≠ 2 → p ≠ 3 → CFSG.Open.pRank p (⊤ : Subgroup (MulAut X)) ≤ 1) ∧
      2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup X) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  refine ⟨h.2.le, fun S => ?_, fun _ hp hp2 hp3 => uc22s213_pRank_mulAut_sl3Four h hp hp2 hp3,
    (PartOne.Section8.pRank_three_eq_two_of_isSL3Four h).ge⟩
  have := (PartOne.Section8.isExtraspecial_sylow_three_of_isSL3Four_of_certificates h
    (uc22s206o_isSylowOf_top S)).1
  exact CFSG.IsExtraspecial.center_order_p 3 _

theorem uc22s213_typeFacts_of_five
    {X : Type} [Group X] [Finite X]
    (h : F08.IsA6Z3 X ∨ F08.IsA7Z3 X ∨ F08.IsM22Z3 X ∨ PartTwo.Inputs1719.PartOne.IsSL3Four X ∨
      (IsSU3 X 3 ∧ Nat.card (center X) = 3)) :
    Nat.card (center X) ≤ 3 ∧ (∀ S : Sylow 3 X, Nat.card (center (S : Subgroup X)) = 3) ∧
      (∀ p : ℕ, p.Prime → p ≠ 2 → p ≠ 3 → CFSG.Open.pRank p (⊤ : Subgroup (MulAut X)) ≤ 1) ∧
      2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup X) := by
  rcases h with h | h | h | h | ⟨hX, hZ⟩
  · exact uc22s213_typeFacts_a6z3 h
  · exact uc22s213_typeFacts_a7z3 h
  · exact uc22s213_typeFacts_m22z3 h
  · exact uc22s213_typeFacts_sl3Four h
  · exact uc22s213_typeFacts_su38 hX hZ

