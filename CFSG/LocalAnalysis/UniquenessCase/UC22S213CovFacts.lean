theorem uc22s213_sylow_facts_of_cube {X : Type} [Group X] [Finite X]
    (h : ∀ R : Sylow 3 X, Nat.card (R : Subgroup X) = 27 ∧
      (∃ r ∈ (R : Subgroup X), ∃ s ∈ (R : Subgroup X), r * s ≠ s * r) ∧
        ∀ r ∈ (R : Subgroup X), r ^ 3 = 1) :
    (∀ S : Sylow 3 X, Nat.card (center (S : Subgroup X)) = 3) ∧
      2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup X) := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  refine ⟨fun S => ?_, ?_⟩
  · obtain ⟨h27, ⟨r, hr, s, hs, hrs⟩, -⟩ := h S
    exact (SectionRank.Ccomm.nonabelian_prime_cube_central_structure (S := ↥(S : Subgroup X))
      (by rw [h27]; norm_num) ⟨⟨r, hr⟩, ⟨s, hs⟩, fun he => hrs (congrArg Subtype.val he)⟩).2.1
  · obtain ⟨R⟩ : Nonempty (Sylow 3 X) := inferInstance
    obtain ⟨h27, -, h3⟩ := h R
    obtain ⟨E, -, hEel, hEc⟩ := RankThreeTheoremC.exists_isElemAbelian_card_sq_of_card_cube
      (p := 3) (by rw [h27]; norm_num) h3
    exact CFSG.SectionRank.le_pRank (by norm_num) le_top hEel hEc

theorem uc22s213_typeFacts_a6z3 {X : Type} [Group X] [Finite X] (h : F08.IsA6Z3 X) :
    Nat.card (center X) ≤ 3 ∧ (∀ S : Sylow 3 X, Nat.card (center (S : Subgroup X)) = 3) ∧
      (∀ p : ℕ, p.Prime → p ≠ 2 → p ≠ 3 → CFSG.Open.pRank p (⊤ : Subgroup (MulAut X)) ≤ 1) ∧
      2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup X) := by
  obtain ⟨hq, hZ, ⟨e⟩⟩ := h
  obtain ⟨hZS, hm3⟩ := uc22s213_sylow_facts_of_cube fun R =>
    HardMathSupport.Solomon.Coordinator.t112m_sylow_hatSix ⟨hq.1.commutator_eq_top, hZ, ⟨e⟩⟩ R
  refine ⟨hZ.le, hZS, fun p hp hp2 hp3 => ?_, hm3⟩
  refine (HardMathSupport.Timmesfeld.Tables.Alt.pRank_aut_le_top ⟨6, ⟨e⟩⟩
    ⟨hq.1.commutator_eq_top, hq.2.1⟩ hp hp2).trans ?_
  refine CFSG.QuasithinUnique.Id2519.pRank_le_one_of_not_sq_dvd hp fun hsq =>
    PartTwo.S17.prime_sq_not_dvd_aut_L34 hp hp2 hp3 (hsq.trans ?_)
  rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (center X), Nat.card_congr e.toEquiv, hZ,
    nat_card_alternatingGroup, Nat.card_eq_fintype_card, Fintype.card_fin]
  decide

