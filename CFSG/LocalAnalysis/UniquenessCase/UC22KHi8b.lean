theorem KLift.isNaturalL2Prime (D : Data G) (Ch : Choice2011 G) (h3 : S22_3_3 D Ch) (h51 : S22_5_1 D Ch)
    (hH : H1930 D) (c : Ctx22c D Ch) {m : ℕ} {Nb : Fin m → Subgroup (MBar D.M D.U)} (hNb : NbarSplit D Nb)
    {i : Fin m} (hK : KLift D (Nb i) K) (h6 : 6 < Nat.card ↥(Nb i)) :
    ∃ n : ℕ, CFSG.Quasithin.IsNaturalL2Prime n K (proofIi D (preN D (Nb i))) := by
  classical
  obtain ⟨Umod, _, _, _, e, ρ, hc⟩ :=
    uc22br4_exists_conjModule D.M D.U (uc22p22xf_hV D) (uc22p22xf_hel D)
  have d := natDec_of_data D Ch h3 h51 hH c hNb e ρ hc
  have hV := uc22p22xf_hV D
  set Nbar : Subgroup (MBar D.M D.U) := mbarImage D.M D.U (proofN D) with hNbardef
  set Ni : Subgroup G := preN D (Nb i) with hNidef
  set Ii : Subgroup G := proofIi D Ni with hIidef
  have hKM : K ≤ D.M := hK.le_M
  have hNbN : Nb i ≤ Nbar := d.le i
  have hIU : Ii ≤ D.U := P22x.proofIi_le D (preN_le_M D (Nb i))
  have hb : bsub e Ii = natIi ρ Nbar (Nb i) := bsub_proofIi D e ρ hc hNbN
  obtain ⟨n, hn, F, _, _, hF, -, -, -, φ, ψ, hψB, hψA, hψs, hψφ⟩ := d.nat i
  haveI := P22y.charP_two_of_card hF
  have hLIi : K ≤ normalizer (Ii : Set G) := hK.le_normalizer_proofIi
  have hVL : ⁅Ii, K⁆ ≤ Ii := commutator_le_of_normalizer le_rfl hLIi
  have hVLU : ⁅Ii, K⁆ ≤ D.U := hVL.trans hIU
  have hLnorm : K ≤ normalizer ((⁅Ii, K⁆ : Subgroup G) : Set G) := fun l hl =>
    mem_normalizer_commutator (hLIi hl) (Subgroup.le_normalizer hl)
  have hπmem : ∀ l : ↥K, ((QuotientGroup.mk' (kerAct D.M D.U).normalCore).comp (Subgroup.inclusion hKM)) l ∈ Nb i :=
    fun l => hK.mk_mem l.2
  set πL : ↥K →* ↥(Nb i) :=
    ((QuotientGroup.mk' (kerAct D.M D.U).normalCore).comp (Subgroup.inclusion hKM)).codRestrict (Nb i) hπmem
    with hπLdef
  have hπL : ∀ l : ↥K, ((πL l : ↥(Nb i)) : MBar D.M D.U) = QuotientGroup.mk ⟨l, hKM l.2⟩ := fun l => rfl
  have hπsurj : Function.Surjective πL := by
    intro y
    obtain ⟨k, hk, hkM, hky⟩ := hK.exists_mk_eq y.2
    exact ⟨⟨k, hk⟩, Subtype.ext hky⟩
  set α₀ : ↥K →* ↥(StatedSL 2 F) := φ.toMonoidHom.comp πL with hα₀def
  have hαsurj : Function.Surjective α₀ := by
    rw [hα₀def, MonoidHom.coe_comp]
    exact φ.surjective.comp hπsurj
  set β₀ : ↥⁅Ii, K⁆ →* Multiplicative (Fin 2 → F) :=
    (AddMonoidHom.toMultiplicative ψ).comp (e.toMonoidHom.comp (Subgroup.inclusion hVLU)) with hβ₀def
  have hβ₀ : ∀ v : ↥⁅Ii, K⁆, Multiplicative.toAdd (β₀ v) =
      ψ (Multiplicative.toAdd (e (Subgroup.inclusion hVLU v))) := fun v => rfl
  have hxv : ∀ v : ↥⁅Ii, K⁆, iota e (Multiplicative.toAdd (e (Subgroup.inclusion hVLU v))) = (v : G) := by
    intro v
    simp [iota]
  have hxI : ∀ v : ↥⁅Ii, K⁆, Multiplicative.toAdd (e (Subgroup.inclusion hVLU v)) ∈ natIi ρ Nbar (Nb i) := by
    intro v
    rw [← hb, mem_bsub, hxv]
    exact hVL v.2
  have hequi : ∀ (l : ↥K) (u v : ↥⁅Ii, K⁆), (v : G) = l * u * l⁻¹ →
      Multiplicative.toAdd (β₀ v) = (((α₀ l : ↥(StatedSL 2 F)) : GL (Fin 2) F) :
        Matrix (Fin 2) (Fin 2) F).mulVec (Multiplicative.toAdd (β₀ u)) := by
    intro l u v huv
    have h1 := hc ⟨l, hKM l.2⟩ (Subgroup.inclusion hVLU u) (Subgroup.inclusion hVLU v) huv
    rw [hβ₀, hβ₀, h1, toAdd_ofAdd]
    have h2 := hψφ (πL l) _ (hxI u)
    rw [hπL] at h2
    exact h2
  have hcard : Nat.card ↥(Nb i) = 2 ^ n * ((2 ^ n) ^ 2 - 1) := by
    rw [Nat.card_congr φ.toEquiv, card_statedSL_two, hF]
  have h3dvd : 3 ∣ Nat.card ↥(Nb i) := by
    rw [hcard]
    apply Dvd.dvd.mul_left
    have h4 : (2 ^ n) ^ 2 = 4 ^ n := by rw [← pow_mul, mul_comm, pow_mul]; norm_num
    rw [h4]
    simpa using Nat.sub_dvd_pow_sub_pow 4 1 n
  haveI : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  obtain ⟨g, hg⟩ := exists_prime_orderOf_dvd_card' 3 h3dvd
  obtain ⟨l₃, hl₃⟩ := hπsurj g
  set g₃ : ↥(StatedSL 2 F) := α₀ l₃ with hg₃def
  have hg₃o : orderOf g₃ = 3 := by
    rw [hg₃def, hα₀def, MonoidHom.coe_comp, Function.comp_apply, hl₃,
      orderOf_injective φ.toMonoidHom φ.injective]
    exact hg
  have hg3 : g₃ ^ 3 = 1 := by rw [← hg₃o]; exact pow_orderOf_eq_one g₃
  have hg1 : g₃ ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hg₃o
    omega
  have hαker : α₀.ker = (K ⊓ centralizer (Ii : Set G)).subgroupOf K := by
    ext l
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
    constructor
    · intro h
      have h1 : πL l = 1 := φ.injective (by rw [map_one]; exact h)
      have h2 : (QuotientGroup.mk ⟨l, hKM l.2⟩ : MBar D.M D.U) = 1 := by
        rw [← hπL, h1]
        rfl
      have h3' := (uc22br_gt_mk_eq_one_iff hV ⟨l, hKM l.2⟩).1 h2
      exact ⟨l.2, Subgroup.centralizer_le hIU h3'⟩
    · rintro ⟨-, hlc⟩
      have hfix := (P22sp.mem_centralizer_iff_fix D e ρ hc hNbN (hKM l.2)).1 hlc
      have h1 : ((πL l : ↥(Nb i)) : MBar D.M D.U) = 1 := by
        rw [hπL]
        exact d.faithful i (by rw [← hπL]; exact (πL l).2) hfix
      have h2 : πL l = 1 := Subtype.ext h1
      change φ (πL l) = 1
      rw [h2, map_one]
  have hβker : β₀.ker = (⁅Ii, K⁆ ⊓ centralizer (K : Set G)).subgroupOf ⁅Ii, K⁆ := by
    ext v
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
    have hβ1 : β₀ v = 1 ↔ ψ (Multiplicative.toAdd (e (Subgroup.inclusion hVLU v))) = 0 := by
      rw [← hβ₀]
      exact ⟨fun h => by rw [h]; rfl, fun h => by
        apply Multiplicative.toAdd.injective
        rw [h]
        rfl⟩
    rw [hβ1]
    constructor
    · intro h0
      refine ⟨v.2, Subgroup.mem_centralizer_iff.2 fun l hl => ?_⟩
      have hC := (hψA _ (hxI v) h0).2
      have hfix := natC_fix (d.le i (πL ⟨l, hl⟩).2) hC
      rw [hπL] at hfix
      have h1 := iota_rho hV e ρ hc ⟨l, hKM hl⟩ (Multiplicative.toAdd (e (Subgroup.inclusion hVLU v)))
      rw [hfix, hxv] at h1
      calc l * (v : G) = (l * v * l⁻¹) * l := by group
        _ = v * l := by rw [← h1]
    · rintro ⟨-, hvc⟩
      have hcomm : (v : G) = l₃ * v * (l₃ : G)⁻¹ := by
        have := Subgroup.mem_centralizer_iff.1 hvc l₃ l₃.2
        calc (v : G) = (v * l₃) * (l₃ : G)⁻¹ := by group
          _ = l₃ * v * (l₃ : G)⁻¹ := by rw [this]
      have h1 := hequi l₃ v v hcomm
      rw [hβ₀] at h1
      exact eq_zero_of_mulVec_eq_self hg3 hg1 h1.symm
  have hβsurj : Function.Surjective β₀ := by
    intro y
    obtain ⟨u, hu⟩ := exists_mulVec_sub_eq hg3 hg1 (Multiplicative.toAdd y)
    obtain ⟨x, hxA, hxu⟩ := hψs u
    have hw : iota e x ∈ Ii := by
      rw [← hb] at hxA
      exact mem_bsub.1 hxA
    set w : G := iota e x with hwdef
    have hcmem : (l₃ : G) * w * (l₃ : G)⁻¹ * w⁻¹ ∈ ⁅Ii, K⁆ := by
      have h1 := Subgroup.commutator_mem_commutator hw l₃.2
      have h2 := (⁅Ii, K⁆).inv_mem h1
      rw [commutatorElement_inv, commutatorElement_def] at h2
      exact h2
    have hcU : (l₃ : G) * w * (l₃ : G)⁻¹ * w⁻¹ ∈ D.U := hVLU hcmem
    have hcx : iota e (ρ (QuotientGroup.mk ⟨l₃, hKM l₃.2⟩) x - x) = (l₃ : G) * w * (l₃ : G)⁻¹ * w⁻¹ := by
      rw [iota_sub, iota_rho hV e ρ hc ⟨l₃, hKM l₃.2⟩ x]
    refine ⟨⟨_, hcmem⟩, ?_⟩
    apply Multiplicative.toAdd.injective
    rw [hβ₀]
    have hx' : Multiplicative.toAdd (e (Subgroup.inclusion hVLU ⟨_, hcmem⟩)) =
        ρ (QuotientGroup.mk ⟨l₃, hKM l₃.2⟩) x - x := by
      apply iota_injective e
      rw [hxv, hcx]
    rw [hx', map_sub]
    have h2 := hψφ (πL l₃) x hxA
    rw [hπL] at h2
    rw [h2, hxu]
    exact hu
  have hn2 : 1 < n := by
    by_contra hn2
    have hn1 : n = 1 := by omega
    subst hn1
    rw [hcard] at h6
    norm_num at h6
  letI : Fintype F := Fintype.ofFinite F
  exact ⟨n, Or.inl ⟨hn2, F, inferInstance, inferInstance, by rw [← Nat.card_eq_fintype_card, hF],
    hLnorm, α₀, hαsurj, hαker, β₀, hβsurj, hβker, hequi⟩⟩

theorem baum_sup_eq (D : Data G) (K : Subgroup G) :
    CFSG.Quasithin.baum (D.T ⊓ K ⊔ proofS D) = proofS D := by
  have hjt : ∀ X : Subgroup G, jOf X = CFSG.Quasithin.thompsonJ X := fun X =>
    CFSG.Quasithin.elemThompson_map_subtype_eq_thompsonJ X
  have hJ : CFSG.Quasithin.thompsonJ (D.T ⊓ K ⊔ proofS D) = CFSG.Quasithin.thompsonJ D.T := by
    rw [← hjt, ← hjt, jOf_sup_eq D K]
  have hS := uc22p22se_proofS_eq D
  unfold CFSG.Quasithin.baum at hS ⊢
  rw [hJ]
  exact le_antisymm ((inf_le_inf_right _ (sup_le inf_le_left inf_le_left)).trans hS.ge)
    (le_inf le_sup_right (hS.le.trans inf_le_right))

theorem KLift.le_commutator (D : Data G) (Ch : Choice2011 G) (h2 : S22_3_2 D Ch) (h3 : S22_3_3 D Ch)
    (h51 : S22_5_1 D Ch) (hH : H1930 D) (c : Ctx22c D Ch) {m : ℕ} {Nb : Fin m → Subgroup (MBar D.M D.U)}
    (hNb : NbarSplit D Nb) {i : Fin m} (hK : KLift D (Nb i) K) (h6 : 6 < Nat.card ↥(Nb i)) :
    K ≤ ⁅proofS D, K⁆ := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hV := uc22p22xf_hV D
  have hKM : K ≤ D.M := hK.le_M
  have hWK : ⁅proofS D, K⁆ ≤ K := by
    rw [Subgroup.commutator_comm]
    exact Subgroup.le_normalizer_iff_commutator_le_left.mp hK.le_normalizer_S
  have hKW : K ≤ normalizer ((⁅proofS D, K⁆ : Subgroup G) : Set G) :=
    Subgroup.normalizer_commutator_ge_right (proofS D) K
  obtain ⟨n, hL2, -⟩ := h51 hH c m Nb hNb i
  haveI := P22y.isSimpleGroup_of_isL2Ev hL2 (P22y.two_le_of_isL2Ev_of_card hL2 h6)
  set Q : Subgroup ↥(Nb i) := (mbarImage D.M D.U ⁅proofS D, K⁆).subgroupOf (Nb i) with hQdef
  have hQle : mbarImage D.M D.U ⁅proofS D, K⁆ ≤ Nb i := by
    rw [← hK.image]
    exact mbarImage_mono D.M D.U hWK
  have hQn : Q.Normal := by
    constructor
    intro q hq y
    obtain ⟨w, hw, hwq⟩ := hq
    obtain ⟨n, hn, hnM, hny⟩ := hK.exists_mk_eq y.2
    have hwW : (w : G) ∈ ⁅proofS D, K⁆ := hw
    have hcW : n * w * n⁻¹ ∈ ⁅proofS D, K⁆ := (mem_normalizer_iff.1 (hKW hn) w).1 hwW
    refine ⟨⟨n, hnM⟩ * w * ⟨n, hnM⟩⁻¹, hcW, ?_⟩
    change (QuotientGroup.mk' _ (⟨n, hnM⟩ * w * ⟨n, hnM⟩⁻¹) : MBar D.M D.U) =
      ((y * q * y⁻¹ : ↥(Nb i)) : MBar D.M D.U)
    rw [map_mul, map_mul, map_inv]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    rw [← hny]
    congr 2
  rcases hQn.eq_bot_or_eq_top with hbot | htop
  ·
    exfalso
    have hSC : proofS D ≤ (K ⊔ proofS D) ⊓ preMbar D (centralizer (Nb i : Set (MBar D.M D.U))) := by
      intro s hs
      have hsM : s ∈ D.M := proofS_le_M D hs
      refine ⟨Subgroup.mem_sup_right hs, (mem_preMbar D).2 ⟨hsM, Subgroup.mem_centralizer_iff.2 fun g hg => ?_⟩⟩
      obtain ⟨k, hk, hkM, rfl⟩ := hK.exists_mk_eq hg
      have hcW : s * k * s⁻¹ * k⁻¹ ∈ ⁅proofS D, K⁆ := Subgroup.commutator_mem_commutator hs hk
      have hcM : s * k * s⁻¹ * k⁻¹ ∈ D.M := hKM (hWK hcW)
      have hcQ : (⟨QuotientGroup.mk ⟨s * k * s⁻¹ * k⁻¹, hcM⟩, hQle ⟨⟨_, hcM⟩, hcW, rfl⟩⟩ : ↥(Nb i)) ∈ Q :=
        ⟨⟨_, hcM⟩, hcW, rfl⟩
      rw [hbot, Subgroup.mem_bot] at hcQ
      have hc1 : (QuotientGroup.mk ⟨s * k * s⁻¹ * k⁻¹, hcM⟩ : MBar D.M D.U) = 1 := congrArg Subtype.val hcQ
      have e : (⟨s * k * s⁻¹ * k⁻¹, hcM⟩ : ↥D.M) = ⟨s, hsM⟩ * ⟨k, hkM⟩ * ⟨s, hsM⟩⁻¹ * ⟨k, hkM⟩⁻¹ := rfl
      rw [e, QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv,
        QuotientGroup.mk_inv] at hc1
      have hcomm := mul_inv_eq_one.1 hc1
      show (QuotientGroup.mk ⟨k, hkM⟩ : MBar D.M D.U) * QuotientGroup.mk ⟨s, hsM⟩ =
        QuotientGroup.mk ⟨s, hsM⟩ * QuotientGroup.mk ⟨k, hkM⟩
      calc (QuotientGroup.mk ⟨k, hkM⟩ : MBar D.M D.U) * QuotientGroup.mk ⟨s, hsM⟩
          = (QuotientGroup.mk ⟨s, hsM⟩ * QuotientGroup.mk ⟨k, hkM⟩ * (QuotientGroup.mk ⟨s, hsM⟩)⁻¹) *
              QuotientGroup.mk ⟨s, hsM⟩ := by rw [hcomm]
        _ = QuotientGroup.mk ⟨s, hsM⟩ * QuotientGroup.mk ⟨k, hkM⟩ := by group
    have hSI : proofS D ≤ centralizer (proofIi D (preN D (Nb i)) : Set G) :=
      (hSC.trans (KLift.kerN_le_pCoreOf D Ch h2 h3 h51 hH c hNb hK)).trans
        (KLift.pCoreOf_le_centralizer D Ch h2 h3 h51 hH c hNb hK)
    have hEi : proofEiHat D (preN D (Nb i)) = ⊥ := by
      change ⁅proofIi D (preN D (Nb i)), jOf D.T⁆ = ⊥
      rw [Subgroup.commutator_comm, Subgroup.commutator_eq_bot_iff_le_centralizer]
      exact (jOf_le_proofS D).trans hSI
    exact (uc22p22xg_proofEiHat_ne_bot D Ch h2 h3 h51 hH c m Nb hNb i).1 hEi
  ·
    refine le_of_commutator_eq_self (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 K)
      ((CFSG.LieType.BorelTits.pCoreOf_le 2 K).trans hKW) (fun k hk => ?_) hK.perfect
    have hkb : (⟨_, hK.mk_mem hk⟩ : ↥(Nb i)) ∈ Q := by
      rw [htop]
      exact Subgroup.mem_top _
    obtain ⟨w, hw, hwk⟩ := hkb
    have hwW : (w : G) ∈ ⁅proofS D, K⁆ := hw
    have hc : (w : G)⁻¹ * k ∈ centralizer (D.U : Set G) := by
      have hwk' : (QuotientGroup.mk w : MBar D.M D.U) = QuotientGroup.mk ⟨k, hKM hk⟩ := hwk
      have h1 : (QuotientGroup.mk (w⁻¹ * ⟨k, hKM hk⟩) : MBar D.M D.U) = 1 := by
        rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv, hwk', inv_mul_cancel]
      exact (uc22br_gt_mk_eq_one_iff hV _).1 h1
    have hO : (w : G)⁻¹ * k ∈ pCoreOf 2 K := hK.ker_le ⟨K.mul_mem (K.inv_mem (hWK hwW)) hk, hc⟩
    have e : k = (w : G) * ((w : G)⁻¹ * k) := by group
    rw [e]
    exact Subgroup.mul_mem_sup hwW hO

theorem KLift.isSylowTwoOf_sup (D : Data G) (Ch : Choice2011 G) (h2 : S22_3_2 D Ch) (h3 : S22_3_3 D Ch)
    (h51 : S22_5_1 D Ch) (hH : H1930 D) (c : Ctx22c D Ch) {m : ℕ} {Nb : Fin m → Subgroup (MBar D.M D.U)}
    (hNb : NbarSplit D Nb) {i : Fin m} (hK : KLift D (Nb i) K) (h6 : 6 < Nat.card ↥(Nb i)) :
    CFSG.QuasithinUnique.IsSylowTwoOf (proofS D) (K ⊔ proofS D) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨Mx, hMP⟩ := KLift.exists_minParabolic D Ch h2 h3 h51 hH c hNb hK
  have hF : quasithinGenFitting (K ⊔ proofS D) = pCoreOf 2 (K ⊔ proofS D) :=
    (CFSG.Quasithin.quasithinGenFitting_eq_pCoreOf_iff (K ⊔ proofS D) 2).2 hK.charTwo
  have hred := KLift.isTwoReducedIn D Ch h2 h3 h51 hH c hNb hK
  have hsub : CFSG.Open.IsSubnormal K (K ⊔ proofS D) :=
    CFSG.Quasithin.A3.subnormal_of_normal le_sup_left
      ((Subgroup.normal_subgroupOf_iff_le_normalizer le_sup_left).2
        (sup_le Subgroup.le_normalizer hK.le_normalizer_S))
  obtain ⟨n, hnat⟩ := KLift.isNaturalL2Prime D Ch h3 h51 hH c hNb hK h6
  have hJT : CFSG.Quasithin.thompsonJ (D.T ⊓ K ⊔ proofS D) = jOf D.T := by
    rw [← CFSG.Quasithin.elemThompson_map_subtype_eq_thompsonJ]
    exact jOf_sup_eq D K
  have hJ : ⁅proofIi D (preN D (Nb i)), CFSG.ASVolI.ChB.Jj (D.T ⊓ K ⊔ proofS D) 0⁆ ≠ ⊥ := by
    rw [P22s.Jj_zero, hJT]
    exact (uc22p22xg_proofEiHat_ne_bot D Ch h2 h3 h51 hH c m Nb hNb i).1
  obtain ⟨-, hsylX, -⟩ := CFSG.ASVolI.as_B_6_10 G (K ⊔ proofS D) (D.T ⊓ K ⊔ proofS D) Mx
    (proofIi D (preN D (Nb i))) K n hMP hF hred hsub hnat hJ
  rw [P22s.baumOf_eq, baum_sup_eq D K] at hsylX
  have hKSK := KLift.le_commutator D Ch h2 h3 h51 hH c hNb hK h6
  have hSX : proofS D ≤ ⨆ l ∈ K, (proofS D).map (MulAut.conj l).toMonoidHom := fun s hs =>
    Subgroup.mem_iSup_of_mem 1 (Subgroup.mem_iSup_of_mem K.one_mem ⟨s, hs, by simp⟩)
  have hX : (⨆ l ∈ K, (proofS D).map (MulAut.conj l).toMonoidHom) = K ⊔ proofS D := by
    refine le_antisymm (iSup₂_le fun l hl => ?_) (sup_le (hKSK.trans ?_) hSX)
    · rintro _ ⟨s, hs, rfl⟩
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      exact (K ⊔ proofS D).mul_mem ((K ⊔ proofS D).mul_mem (Subgroup.mem_sup_left hl)
        (Subgroup.mem_sup_right hs)) ((K ⊔ proofS D).inv_mem (Subgroup.mem_sup_left hl))
    · rw [Subgroup.commutator_le]
      intro s hs l hl
      have hmem : l * s⁻¹ * l⁻¹ ∈ ⨆ l ∈ K, (proofS D).map (MulAut.conj l).toMonoidHom :=
        Subgroup.mem_iSup_of_mem l (Subgroup.mem_iSup_of_mem hl ⟨s⁻¹, (proofS D).inv_mem hs, by simp⟩)
      have e : ⁅s, l⁆ = s * (l * s⁻¹ * l⁻¹) := by rw [commutatorElement_def]; group
      rw [e]
      exact mul_mem (hSX hs) hmem
  exact hX ▸ hsylX

theorem KLift.inClassG (D : Data G) (Ch : Choice2011 G) (h2 : S22_3_2 D Ch) (h3 : S22_3_3 D Ch)
    (h51 : S22_5_1 D Ch) (hH : H1930 D) (c : Ctx22c D Ch) {m : ℕ} {Nb : Fin m → Subgroup (MBar D.M D.U)}
    (hNb : NbarSplit D Nb) {i : Fin m} (hK : KLift D (Nb i) K) (h6 : 6 < Nat.card ↥(Nb i)) :
    InClassG ↥(proofS D) ↥(K ⊔ proofS D) (Subgroup.inclusion le_sup_right) := by
  obtain ⟨n, X, _, φ, hn, hφ, ⟨e⟩, hker⟩ := KLift.exists_quotient D Ch h2 h3 h51 hH c hNb hK
  have hsyl := KLift.isSylowTwoOf_sup D Ch h2 h3 h51 hH c hNb hK h6
  exact inClassG_inclusion le_sup_right hsyl.2.1 hsyl.2.2 hK.charTwo φ hφ hn e hker

theorem KLift.not_le_centralizer (D : Data G) (Ch : Choice2011 G) (h2 : S22_3_2 D Ch) (h3 : S22_3_3 D Ch)
    (h51 : S22_5_1 D Ch) (hH : H1930 D) (c : Ctx22c D Ch) {m : ℕ} {Nb : Fin m → Subgroup (MBar D.M D.U)}
    (hNb : NbarSplit D Nb) {i : Fin m} (hK : KLift D (Nb i) K) :
    ¬ K ≤ centralizer (proofEiHat D (preN D (Nb i)) : Set G) := by
  intro hKE
  have hV := uc22p22xf_hV D
  have hEU : proofEiHat D (preN D (Nb i)) ≤ D.U := (uc22p22xg_proofEiHat_ne_bot D Ch h2 h3 h51 hH c m Nb hNb i).2
  apply uc22p22sb_not_preN_le_centralizer D Ch h2 h3 h51 hH c m Nb hNb i
  intro x hx
  obtain ⟨-, hxM, hxY⟩ := (mem_preN D).1 hx
  obtain ⟨k, hk, hkM, hkx⟩ := hK.exists_mk_eq hxY
  have hc : k⁻¹ * x ∈ centralizer (D.U : Set G) := by
    have h1 : (QuotientGroup.mk ((⟨k, hkM⟩ : ↥D.M)⁻¹ * ⟨x, hxM⟩) : MBar D.M D.U) = 1 := by
      rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv, hkx, inv_mul_cancel]
    exact (uc22br_gt_mk_eq_one_iff hV _).1 h1
  have e : x = k * (k⁻¹ * x) := by group
  rw [e]
  exact mul_mem (hKE hk) (Subgroup.centralizer_le hEU hc)

theorem KLift.sup_not_le_centralizer (D : Data G) (Ch : Choice2011 G) (h2 : S22_3_2 D Ch) (h3 : S22_3_3 D Ch)
    (h51 : S22_5_1 D Ch) (hH : H1930 D) (c : Ctx22c D Ch) {m : ℕ} {Nb : Fin m → Subgroup (MBar D.M D.U)}
    (hNb : NbarSplit D Nb) {i : Fin m} (hK : KLift D (Nb i) K) :
    ¬ K ⊔ proofS D ≤ centralizer (proofEiHat D (preN D (Nb i)) : Set G) ∧
      ¬ K ⊔ proofS D ≤ centralizer (omegaOneCenterIn (proofS D) : Set G) := by
  have hn := KLift.not_le_centralizer D Ch h2 h3 h51 hH c hNb hK
  refine ⟨fun h => hn (le_sup_left.trans h), fun h => hn ((le_sup_left.trans h).trans
    (Subgroup.centralizer_le (uc22p22sb_proofEiHat_le_omegaOneCenterIn D Ch h2 h3 h51 hH c m Nb hNb i)))⟩

