theorem R847E3.exists_kernel {M Y : Subgroup G} (hY : IsSubnormal Y M) {p k : ℕ}
    (hp : p.Prime) {B : Subgroup G} (hBN : B ≤ normalizer (Y : Set G)) (hBel : IsElemAbelian p B)
    (hBc : Nat.card B = p ^ (k + 2))
    (hR : Nat.card ((B.subgroupOf (normalizer (Y : Set G))).map (UC6S846.rhoL Y)) ≤ p ^ k) :
    ∃ B₀ : Subgroup G, B₀ ≤ B ∧ IsElemAbelian p B₀ ∧ Nat.card B₀ = p ^ 2 ∧
      ∀ b ∈ B₀, ∀ y ∈ Y, b * y * b⁻¹ * y⁻¹ ∈ pCoreOf 2 M := by
  haveI : Fact p.Prime := ⟨hp⟩
  let BN : Subgroup ↥(normalizer (Y : Set G)) := B.subgroupOf (normalizer (Y : Set G))
  let φ : ↥BN →* MulAut (Bar2 Y) := (UC6S846.rhoL Y).comp BN.subtype
  have hφrange : φ.range = BN.map (UC6S846.rhoL Y) := by
    ext y
    simp only [φ, MonoidHom.mem_range, Subgroup.mem_map, MonoidHom.comp_apply,
      Subgroup.coe_subtype]
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨a, a.2, rfl⟩
    · rintro ⟨a, ha, rfl⟩
      exact ⟨⟨a, ha⟩, rfl⟩
  have hBNcard : Nat.card BN = p ^ (k + 2) := by
    rw [← hBc]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hBN).toEquiv
  have hker : p ^ (k + 2) = Nat.card φ.range * Nat.card φ.ker := by
    rw [← hBNcard, Subgroup.card_eq_card_quotient_mul_card_subgroup φ.ker,
      Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv]
  let K : Subgroup G := (φ.ker.map BN.subtype).map (normalizer (Y : Set G)).subtype
  have hKB : K ≤ B :=
    calc K ≤ BN.map (normalizer (Y : Set G)).subtype :=
          Subgroup.map_mono (Subgroup.map_subtype_le _)
      _ = B := Subgroup.map_subgroupOf_eq_of_le hBN
  have hKc : p ^ 2 ≤ Nat.card K := by
    rw [Subgroup.card_map_of_injective (Subgroup.subtype_injective _),
      Subgroup.card_map_of_injective (Subgroup.subtype_injective _)]
    have h1 : p ^ k * p ^ 2 ≤ p ^ k * Nat.card φ.ker :=
      calc p ^ k * p ^ 2 = p ^ (k + 2) := by ring
        _ = _ := hker
        _ ≤ p ^ k * Nat.card φ.ker := Nat.mul_le_mul_right _ (hφrange ▸ hR)
    exact Nat.le_of_mul_le_mul_left h1 (pow_pos hp.pos k)
  obtain ⟨B₀, hB₀K, hB₀el, hB₀c⟩ := UC6S846.exists_card_p_sq hp (hBel.mono hKB) hKc
  refine ⟨B₀, hB₀K.trans hKB, hB₀el, hB₀c, fun b hb y hy => ?_⟩
  obtain ⟨_, ⟨m, hm, rfl⟩, rfl⟩ := hB₀K hb
  have h1 : UC6S846.rhoL Y (m : ↥(normalizer (Y : Set G))) = 1 := (MonoidHom.mem_ker).1 hm
  exact uc22ine229_pCoreOf_le_of_isSubnormal hY
    ((UC6S846.rhoL_fix_iff Y (m : ↥(normalizer (Y : Set G))) ⟨y, hy⟩).1
      (by rw [h1, MulAut.one_apply]))

theorem R847E3.isMulCommutative_outer_of_thin (hThin : PartTwo.ThinList13)
    (hCyc : CFSG.RankThree.PartTwo.Sec11.CyclicSylowThreeOutAbelian) {M : Subgroup G}
    (hK : CFSG.Open.IsKGroup ↥M) {Y : Subgroup G} (hY : Y ∈ calC M) (hthin : F08.Thin8 Y) :
    IsSimpleGroup (Bar2 Y) ∧ IsMulCommutative (Outer (Bar2 Y)) := by
  have hKY : CFSG.IsKGroup (Bar2 Y) :=
    uc22br4_isKGroup_catalog_of_open ((hK.of_le hY.1.le).quotient (CFSG.pCore 2 ↥Y))
  have hs : IsSimpleGroup (Bar2 Y) := (hThin (Bar2 Y) hKY hY.2.2 (PartTwo.s13_pCore_bar_eq_bot Y)
    fun r hr hr2 => PartTwo.s13_pRank_bar_le_one hthin hr hr2).1
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hsyl : ∀ P : Sylow 3 (Bar2 Y), IsCyclic ↥(P : Subgroup (Bar2 Y)) := fun P =>
    RankFourTheoremC.Nongeneration.isCyclic_sylow_of_pRank_le_one (by norm_num)
      ((uc22s206c_pRank_le Y Nat.prime_three (by norm_num)).trans
        (hthin 3 Nat.prime_three (by norm_num))) P
  have hout := hCyc (Bar2 Y) hKY hs (PartTwo.s13_nonabelian_bar hY) hsyl
  refine ⟨hs, ⟨⟨fun a b => ?_⟩⟩⟩
  induction a using QuotientGroup.induction_on with | H σ =>
  induction b using QuotientGroup.induction_on with | H τ =>
  rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
  have h := hout τ⁻¹ σ⁻¹
  rw [inv_inv, inv_inv] at h
  rw [show (σ * τ)⁻¹ * (τ * σ) = τ⁻¹ * σ⁻¹ * τ * σ by group]
  exact h

theorem R847E3.exists_B₁_of_thin (hThin : PartTwo.ThinList13)
    (hCyc : CFSG.RankThree.PartTwo.Sec11.CyclicSylowThreeOutAbelian) {M : Subgroup G}
    (hK : CFSG.Open.IsKGroup ↥M) {Y : Subgroup G} (hY : Y ∈ calC M)
    (hYN : M ≤ normalizer (Y : Set G)) (hthin : F08.Thin8 Y) {p : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (hOp : F10.OpRes p M = M) (h3 : 3 ≤ CFSG.Open.pRank p M) {X : Subgroup G}
    (hXY : X ≤ Y) {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) (hXq : IsPGroup q X) :
    ∃ B₁ : Subgroup G, B₁ ≤ M ∧ IsElemAbelian p B₁ ∧ Nat.card B₁ = p ^ 2 ∧
      B₁ ≤ centralizer (X : Set G) ∧ ∀ b ∈ B₁, ∀ y ∈ Y, b * y * b⁻¹ * y⁻¹ ∈ pCoreOf 2 M := by
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨hs, hcomm⟩ := R847E3.isMulCommutative_outer_of_thin hThin hCyc hK hY hthin
  have hbound := PartTwo.pRank_le_add_pRank_centOverO2 hY.1.le hYN hp
    (CFSG.LocalAnalysis.GLTheoremB.MovingAround.InputsMisc7.hasNormalPComplement_of_isMulCommutative
      (p := p) hcomm) hOp
  have hZ : center (Bar2 Y) = ⊥ := by
    rcases @IsSimpleGroup.eq_bot_or_eq_top_of_normal _ _ hs (center (Bar2 Y)) inferInstance
      with h | h
    · exact h
    · obtain ⟨a, b, hab⟩ := PartTwo.s13_nonabelian_bar hY
      exact absurd (Subgroup.mem_center_iff.1 (h ▸ Subgroup.mem_top a) b).symm hab
  have hquot : CFSG.Open.pRank p (⊤ : Subgroup (Bar2 Y ⧸ center (Bar2 Y))) ≤ 1 := by
    rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv hp.one_lt
      ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot)]
    exact (uc22s206c_pRank_le Y hp hp2).trans (hthin p hp hp2)
  obtain ⟨B₀, hB₀C, hB₀el, hB₀c⟩ := UC6S846.exists_elemAbelian_card_of_le_pRank
    (M := F08.CentOverO2 M Y) (k := 2) hp (by omega)
  have hB₀ : ∀ b ∈ B₀, b ∈ M ∧ ∀ y ∈ Y, b * y * b⁻¹ * y⁻¹ ∈ pCoreOf 2 Y := fun b hb =>
    PartTwo.mem_centOverO2_iff.1 (hB₀C hb)
  exact uc22ine229_exists_copy hY.1.le hp hp2 hq hq2 (fun b hb => (hB₀ b hb).1) hB₀el hB₀c
    (fun b hb y hy => uc22ine229_pCoreOf_le_of_isSubnormal hY.1 ((hB₀ b hb).2 y hy)) hXY hXq

theorem R847E3.exists_B₁_of_isSU3 {M Y : Subgroup G} (hY : Y ∈ calC M)
    (hYN : M ≤ normalizer (Y : Set G)) {n : ℕ} (hYn : IsSU3 (Bar2 Y) n) {p : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (hpn : ¬ p ∣ 2 ^ n + 1) (hOp : F10.OpRes p M = M)
    (h3 : 3 ≤ CFSG.Open.pRank p M) {X : Subgroup G} (hXY : X ≤ Y) {q : ℕ} (hq : q.Prime)
    (hq2 : q ≠ 2) (hXq : IsPGroup q X) :
    ∃ B₁ : Subgroup G, B₁ ≤ M ∧ IsElemAbelian p B₁ ∧ Nat.card B₁ = p ^ 2 ∧
      B₁ ≤ centralizer (X : Set G) ∧ ∀ b ∈ B₁, ∀ y ∈ Y, b * y * b⁻¹ * y⁻¹ ∈ pCoreOf 2 M := by
  obtain ⟨B, hBM, hBel, hBc⟩ := UC6S846.exists_elemAbelian_card_of_le_pRank hp h3
  obtain ⟨B₀, hB₀B, hB₀el, hB₀c, hB₀Y⟩ := R847E3.exists_kernel (k := 1) hY.1 hp (hBM.trans hYN)
    hBel hBc (by
      rw [pow_one]
      exact UCK.u3RankOne (Bar2 Y) n hYn p hp hp2 hpn _
        (UC6S846.map_rhoL_le_inner hYN hYn hp hpn hOp hBM hBel) ((hBel.subgroupOf _).map _))
  exact uc22ine229_exists_copy hY.1.le hp hp2 hq hq2 (hB₀B.trans hBM) hB₀el hB₀c hB₀Y hXY hXq

