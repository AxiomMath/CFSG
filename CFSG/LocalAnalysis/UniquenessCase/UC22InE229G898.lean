theorem uc22ine229_mem_inner {X : Type} [Group X] [Finite X] {n : ℕ} (hX : IsSU3 X n) {p : ℕ}
    (hp : p.Prime) (hp3 : p ≠ 3) (hpn : ¬ p ∣ 2 * n) {φ : MulAut X} (hφ : φ ^ p = 1) :
    φ ∈ (MulAut.conj : X →* MulAut X).range := by
  obtain ⟨e, hB⟩ := CFSG.SeitzReduction.RankOne.exists_benderType_of_lieModel_psu3
    (UCK.u3Range X n hX) hX.2
  obtain ⟨Dd, hDn, -, hDcard, -, hQcard⟩ := hB.outer_unitary
  set o : Outer (X ⧸ center X) := QuotientGroup.mk' (inner (X ⧸ center X)) (UCK.autQuot φ)
    with ho
  have hop : o ^ p = 1 := by rw [ho, ← map_pow, ← map_pow, hφ, map_one, map_one]
  have hoD : o ∈ Dd := by
    have h1 : orderOf (QuotientGroup.mk' Dd o) ∣ Nat.gcd p (2 * n) := by
      refine Nat.dvd_gcd (orderOf_dvd_of_pow_eq_one (by rw [← map_pow, hop, map_one])) ?_
      rw [← hQcard]
      exact _root_.orderOf_dvd_natCard _
    rw [((Nat.Prime.coprime_iff_not_dvd hp).2 hpn).gcd_eq_one, Nat.dvd_one,
      orderOf_eq_one_iff] at h1
    exact (QuotientGroup.eq_one_iff o).1 h1
  have ho1 : o = 1 := by
    have h1 : orderOf o ∣ Nat.gcd p 3 := by
      refine Nat.dvd_gcd (orderOf_dvd_of_pow_eq_one hop) ?_
      rw [← Subgroup.orderOf_mk o hoD]
      exact (_root_.orderOf_dvd_natCard _).trans (hDcard ▸ Nat.gcd_dvd_left 3 _)
    rwa [((Nat.coprime_primes hp Nat.prime_three).2 hp3).gcd_eq_one, Nat.dvd_one,
      orderOf_eq_one_iff] at h1
  obtain ⟨x, hx⟩ := UCK.exists_conj_autQuot (X := X) ((QuotientGroup.eq_one_iff _).1 ho1)
  exact ⟨x, UCK.autQuot_injective hX.1.1 hx⟩

theorem uc22ine229_card_le_of_le_inner {X : Type} [Group X] [Finite X] {n : ℕ}
    (hX : IsSU3 X n) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {R : Subgroup (MulAut X)}
    (hRinn : R ≤ (MulAut.conj : X →* MulAut X).range) (hRel : IsElemAbelian p R) :
    Nat.card R ≤ p ^ 2 := by
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨e⟩ := CFSG.RankThree.PartOne.projSU_of_statedClassicalModel
    (CFSG.SeitzReduction.RankOne.statedClassicalModel_of_lieModel_psu3 hX.2)
  have hrank : CFSG.Open.pRank p (⊤ : Subgroup (X ⧸ center X)) ≤ 2 := by
    rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv hp.one_lt e]
    exact CFSG.RankThree.PartOne.LIT.pRank_projSU_three_le
      (le_trans (by norm_num) (UCK.u3Range X n hX)) hp hp2
  let ι := UCK.innerEquivQuot X
  let A : Subgroup (X ⧸ center X) :=
    (R.subgroupOf (MulAut.conj : X →* MulAut X).range).map ι.toMonoidHom
  have hAel : IsElemAbelian p A := (hRel.subgroupOf _).map _
  have hAcard : Nat.card A = Nat.card R := by
    rw [Subgroup.card_map_of_injective ι.injective,
      Nat.card_congr (subgroupOfEquivOfLe hRinn).toEquiv]
  obtain ⟨k, hk⟩ := hAel.isPGroup.exists_card_eq
  rw [← hAcard, hk]
  exact Nat.pow_le_pow_right hp.pos
    ((CFSG.SectionRank.le_pRank hp.one_lt le_top hAel hk).trans hrank)

theorem uc22ine229_normalizes_of_pRank_le_three {M L : Subgroup G} (hL : L ∈ calC M) {y : G}
    (hy : y ∈ M) {r q : ℕ} (hr : r.Prime) (hr5 : 5 ≤ r) (hyr : orderOf y = r) (hq : q.Prime)
    (hq2 : q ≠ 2) {X : Subgroup G} (hXL : X ≤ L) (hXc : Nat.card X = q)
    (hZ : ¬ q ∣ Nat.card (center (Bar2 L))) (hrank : CFSG.Open.pRank q M ≤ 3) :
    y ∈ normalizer (L : Set G) := by
  classical
  by_contra hyn
  let f : ℕ → MulAut G := fun i => MulAut.conj (y ^ i)
  have hM : ∀ i, M.map (f i).toMonoidHom = M := fun i =>
    UC6S846.mem_normalizer_iff_map_conj.1 (Subgroup.le_normalizer (M.pow_mem hy i))
  have hLi : ∀ i, L.map (f i).toMonoidHom ∈ calC M := fun i => UC6S846.calC_map M (f i) (hM i) hL
  have hLiM : ∀ i, L.map (f i).toMonoidHom ≤ M := fun i => (hLi i).1.le
  have hdist : ∀ i j : ℕ, i < j → j < 4 → L.map (f i).toMonoidHom ≠ L.map (f j).toMonoidHom := by
    intro i j hij hj4 heq
    have hcomp : f j = f i * f (j - i) := by
      show MulAut.conj (y ^ j) = MulAut.conj (y ^ i) * MulAut.conj (y ^ (j - i))
      rw [← map_mul, ← pow_add]
      congr 2
      omega
    have h1 : L.map (f j).toMonoidHom = (L.map (f (j - i)).toMonoidHom).map (f i).toMonoidHom := by
      rw [hcomp, Subgroup.map_map]
      rfl
    rw [h1] at heq
    have h2 : L = L.map (f (j - i)).toMonoidHom :=
      Subgroup.map_injective (f i).injective heq
    have hk : y ^ (j - i) ∈ normalizer (L : Set G) :=
      UC6S846.mem_normalizer_iff_map_conj.2 h2.symm
    have hk3 : 0 < j - i ∧ j - i < 4 := by omega
    have hcop : Nat.Coprime (j - i) r := by
      rw [Nat.coprime_comm]
      exact (Nat.Prime.coprime_iff_not_dvd hr).2 (fun hd => by
        have := Nat.le_of_dvd hk3.1 hd
        omega)
    obtain ⟨t, ht⟩ := exists_pow_eq_self_of_coprime (x := y) (n := j - i) (by rw [hyr]; exact hcop)
    have hyt : y = (y ^ (j - i)) ^ t := ht.symm
    apply hyn
    rw [hyt]
    exact (Subgroup.normalizer _).pow_mem hk t
  have hXel : IsElemAbelian q X := UC6S898.isElemAbelian_of_card_prime hq hXc
  have hEi : ∀ i, (X.map (f i).toMonoidHom) ≤ L.map (f i).toMonoidHom := fun i =>
    Subgroup.map_mono hXL
  have hcalC := fun i => UC6S846.calC_subgroupOf (hLi i)
  obtain ⟨W, hWel, hWcard⟩ := UC6S898.rank_sum_of_family (Y := ↥M) (ι := Fin 4)
    (A := fun i => (L.map (f (i : ℕ)).toMonoidHom).subgroupOf M)
    (E := fun i => (X.map (f (i : ℕ)).toMonoidHom).subgroupOf M) (q := q) (a := fun _ => 1) hq hq2
    (fun i => (hcalC (i : ℕ)).1) (fun i => (hcalC (i : ℕ)).2.1) (fun i => (hcalC (i : ℕ)).2.2.1)
    (by
      intro i j hij
      by_contra hne
      have hne' : (i : ℕ) ≠ (j : ℕ) := fun h => hne (Fin.ext h)
      have hmap := congrArg (Subgroup.map M.subtype) hij
      rw [Subgroup.map_subgroupOf_eq_of_le (hLiM i), Subgroup.map_subgroupOf_eq_of_le (hLiM j)]
        at hmap
      rcases Nat.lt_or_gt_of_ne hne' with hlt | hgt
      · exact hdist i j hlt j.2 hmap
      · exact hdist j i hgt i.2 hmap.symm)
    (fun i => by
      rw [(hcalC (i : ℕ)).2.2.2, UC6S846.card_center_bar2_map]
      exact hZ)
    (fun i x hx => hEi i hx) (fun i => (hXel.map _).subgroupOf M)
    (fun i => by
      have hEM : X.map (f i).toMonoidHom ≤ M := (hEi i).trans (hLiM i)
      show Nat.card ((X.map (f (i : ℕ)).toMonoidHom).subgroupOf M) = q ^ 1
      rw [pow_one, Nat.card_congr (Subgroup.subgroupOfEquivOfLe hEM).toEquiv,
        Subgroup.card_map_of_injective (f i).injective, hXc])
    Finset.univ
  have hsum : (∑ i ∈ (Finset.univ : Finset (Fin 4)), (fun _ : Fin 4 => 1) i) = 4 := by simp
  rw [hsum] at hWcard
  have h4 := UC6S846.le_pRank' hq (E := W.map M.subtype) (H := M) (Subgroup.map_subtype_le W)
    (hWel.map _) (by rw [Subgroup.card_map_of_injective M.subtype_injective, hWcard])
  omega

theorem uc22ine229_two_le_pRank_centralizer {M L : Subgroup G} (hLM : L ≤ M) {n : ℕ}
    (hX : IsSU3 (Bar2 L) n) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hp3 : p ≠ 3)
    (hpn : ¬ p ∣ 2 * n) {B : Subgroup G} (hBM : B ≤ M) (hBN : B ≤ normalizer (L : Set G))
    (hBel : IsElemAbelian p B) (hBcard : Nat.card B = p ^ 4) {q : ℕ} (hq : q.Prime)
    (hq2 : q ≠ 2) {E : Subgroup G} (hEL : E ≤ L) (hE : IsPGroup q E) :
    2 ≤ CFSG.Open.pRank p (M ⊓ centralizer (E : Set G)) := by
  haveI : Fact p.Prime := ⟨hp⟩
  let φ : ↥B →* MulAut (Bar2 L) := (UC6S846.rhoL L).comp (Subgroup.inclusion hBN)
  have hpow : ∀ b : ↥B, φ b ^ p = 1 := by
    intro b
    rw [← map_pow]
    have : b ^ p = 1 := Subtype.ext (by simpa using hBel.2 _ b.2)
    rw [this, map_one]
  have hinn : φ.range ≤ (MulAut.conj : Bar2 L →* MulAut (Bar2 L)).range := by
    rintro _ ⟨b, rfl⟩
    exact uc22ine229_mem_inner hX hp hp3 hpn (hpow b)
  have hRel : IsElemAbelian p φ.range := by
    rw [MonoidHom.range_eq_map, ← Subgroup.subgroupOf_self B]
    exact (hBel.subgroupOf B).map φ
  have hR : Nat.card φ.range ≤ p ^ 2 := uc22ine229_card_le_of_le_inner hX hp hp2 hinn hRel
  have hKc : p ^ 2 ≤ Nat.card φ.ker := by
    have h1 : p ^ 2 * p ^ 2 ≤ p ^ 2 * Nat.card φ.ker :=
      calc p ^ 2 * p ^ 2 = Nat.card φ.ker * Nat.card φ.range := by
            rw [Subgroup.card_ker_mul_card_range, hBcard]
            ring
        _ ≤ Nat.card φ.ker * p ^ 2 := Nat.mul_le_mul_left _ hR
        _ = p ^ 2 * Nat.card φ.ker := mul_comm _ _
    exact Nat.le_of_mul_le_mul_left h1 (pow_pos hp.pos 2)
  let K : Subgroup G := φ.ker.map B.subtype
  have hKB : K ≤ B := Subgroup.map_subtype_le _
  have hKcard : p ^ 2 ≤ Nat.card K := by
    rw [Subgroup.card_map_of_injective B.subtype_injective]
    exact hKc
  obtain ⟨A, hAK, hAel, hAc⟩ := UC6S846.exists_card_p_sq hp (hBel.mono hKB) hKcard
  have hNO := UC6S846.normalizer_le_normalizer_pCoreOf L
  obtain ⟨A', hA'C, hA'le, ⟨eA⟩⟩ := UC6S846.exists_centralizing_copy hq hq2 hp hp2
    (pCoreOf 2 L) A E (UC6S846.isPGroup_pCoreOf L) ((hAK.trans (hKB.trans hBN)).trans hNO)
    ((hEL.trans Subgroup.le_normalizer).trans hNO) hAel.isPGroup hE (fun e he a ha => by
      obtain ⟨b, hb, rfl⟩ := hAK ha
      have h1 : UC6S846.rhoL L (Subgroup.inclusion hBN b) = 1 := hb
      have h2 : (b : G) * e * (b : G)⁻¹ * e⁻¹ ∈ pCoreOf 2 L :=
        (UC6S846.rhoL_fix_iff L (Subgroup.inclusion hBN b) ⟨e, hEL he⟩).1
          (by rw [h1, MulAut.one_apply])
      have h3 : e * (b : G) * e⁻¹ * (b : G)⁻¹ = ((b : G) * e * (b : G)⁻¹ * e⁻¹)⁻¹ := by group
      change e * (b : G) * e⁻¹ * (b : G)⁻¹ ∈ pCoreOf 2 L
      rw [h3]
      exact inv_mem h2)
  have hA'M : A' ≤ M :=
    hA'le.trans (sup_le (hAK.trans (hKB.trans hBM)) ((Subgroup.map_subtype_le _).trans hLM))
  have hA'el : IsElemAbelian p A' := UC6S846.isElemAbelian_of_mulEquiv eA hAel
  have hA'c : Nat.card A' = p ^ 2 := by rw [Nat.card_congr eA.toEquiv, hAc]
  exact UC6S846.le_pRank' hp (le_inf hA'M hA'C) hA'el hA'c

theorem uc22ine229_not_dvd_two_mul {n p : ℕ} (hn : n = 3 ∨ n = 21) (hp : p.Prime) (hp2 : p ≠ 2)
    (hp3 : p ≠ 3) (hp7 : p ≠ 7) : ¬ p ∣ 2 * n := by
  intro h
  have h42 : p ∣ 2 * 3 * 7 := by
    rcases hn with rfl | rfl
    · exact h.trans (by norm_num)
    · exact h.trans (by norm_num)
  rcases (Nat.Prime.dvd_mul hp).1 h42 with h6 | h7
  · rcases (Nat.Prime.dvd_mul hp).1 h6 with h2 | h3
    · exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 h2)
    · exact hp3 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).1 h3)
  · exact hp7 ((Nat.prime_dvd_prime_iff_eq hp (by norm_num)).1 h7)

theorem r898Gamma_of_conclusion76 (D : Data G) (hSg : UC6S846.SigmaStd D) (hCen : UCK.U3Center)
    (h4 : ∀ p ∈ D.sig, 4 ≤ CFSG.Open.pRank p D.M)
    (h76 : D.k = 2 → ∀ p ∈ D.sig, IsStronglyPEmbedded p D.M → Conclusion76 D.M p) :
    UC6S898.R898Gamma D := by
  intro L hL n hX hn X hXL hXc h7 E hEL hEel hEc
  have hLM : L ≤ D.M := hL.1.le
  have hEM : E ≤ D.M := hEL.trans hLM
  by_cases h3 : IsStronglyPEmbedded 3 D.M
  · exact h3.rankThreeGamma_one_le_of_le Nat.prime_three hEel.isPGroup hEM
  have hns := UC6S846.not_solvable_of_mem_calC hL
  obtain ⟨p, hpσ⟩ := hSg.nonempty
  obtain ⟨hp, hp2⟩ := D.sig_prime p hpσ
  have hsp := UC6S846.sp_of_mem_sig hSg hns hpσ
  have hp3 : p ≠ 3 := by
    rintro rfl
    exact h3 hsp
  have hp7 : p ≠ 7 := by
    rintro rfl
    exact h7 hsp
  have hp5 : 5 ≤ p := by
    have := hp.two_le
    by_contra h
    interval_cases p
    · exact hp2 rfl
    · exact hp3 rfl
    · exact absurd hp (by norm_num)
  have h76p := h76 ((Data.k_eq_two_iff D).2 h3) p hpσ hsp
  obtain ⟨B, hBM, hBel, hBc⟩ := UC6S846.exists_elemAbelian_card_of_le_pRank hp (h4 p hpσ)
