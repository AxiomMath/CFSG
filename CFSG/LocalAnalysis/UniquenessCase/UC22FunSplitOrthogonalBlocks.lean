section Conjugation

theorem conjPermHom_mem_blockStab_of_uniqueInvolutions
    {X ι : Type} [Group X] {Δ : Set (Subgroup X)}
    (ePair : ι × Bool ≃ Δ) (z : ι → X) (hinj : Function.Injective z)
    (huniq : ∀ k, IsUniqueInvolution (ePair k : Subgroup X) (z k.1)) :
    ∀ g : conjSetStab Δ,
      ePair.symm.permCongrHom (conjPermHom (le_refl (conjSetStab Δ)) g) ∈
        CFSG.HardMathSupport.Cooperstein.AlternatingGeometry.blockStab ι := by
  intro g
  let σ := ePair.symm.permCongrHom (conjPermHom (le_refl (conjSetStab Δ)) g)
  have hconj : ∀ k, (ePair (σ k) : Subgroup X) = conjSub (g : X) (ePair k) := by
    intro k
    change (ePair (ePair.symm (conjPermHom (le_refl (conjSetStab Δ)) g (ePair k))) :
      Subgroup X) = _
    rw [ePair.apply_symm_apply, conjPermHom_apply]
    simp only [CFSG.ComponentClassification.AschbacherTightEmbedding.rightConjugate,
      inv_inv, conjSub]
  have hz : ∀ k, z (σ k).1 = (g : X) * z k.1 * (g : X)⁻¹ := by
    intro k
    apply (huniq (σ k)).eq
    rw [hconj]
    exact (huniq k).conj g
  change ∀ x y, (σ x).1 = (σ y).1 ↔ x.1 = y.1
  intro x y
  constructor
  · intro h
    apply hinj
    apply (MulAut.conj (g : X)).injective
    exact (hz x).symm.trans ((congrArg z h).trans (hz y))
  · intro h
    apply hinj
    rw [hz x, hz y, h]

end Conjugation

section Frames

variable {F V : Type} [Field F] [Finite F] [AddCommGroup V] [Module F V]
  [FiniteDimensional F V] {Q : QuadraticForm F V}
  {U X : Type} [Group U] [Group X] {m : ℕ}

theorem exists_uniqueInvolution_of_paired_frame_maps
    (hm : 0 < m) (hodd : Odd (Nat.card F)) (hdim : Module.finrank F V ≠ 8)
    (π : U →* (V ≃ₗ[F] V)) (hπker : π.ker ≤ center U)
    (hπZ : ∀ z ∈ center U, π z ∈ scalars F V)
    (A : Fin m → OFrame Q) (horth : ∀ i j, i ≠ j → SpanOrth (A i) (A j))
    (R : Fin m × Bool → Subgroup U)
    (hR : ∀ k, (R k).map π =
      if k.2 then (A k.1).swap.La.range else (A k.1).La.range)
    (huniq : ∀ k, ∃ x, IsUniqueInvolution (R k) x)
    (hπinj : ∀ k, ∀ x ∈ R k, π x = 1 → x = 1)
    (ψ : U →* X) (hψ : Function.Surjective ψ) (hψker : ψ.ker ≤ center U)
    (hψinj : ∀ k, ∀ x ∈ R k, ψ x = 1 → x = 1) (hX : center X = ⊥) :
    ∃ z : Fin m → X, Function.Injective z ∧
      ∀ k, IsUniqueInvolution ((R k).map ψ) (z k.1) := by
  classical
  have h2 : (2 : F) ≠ 0 := IsFundamental.two_ne_zero_of_odd hodd
  have hincl : Function.Injective
      ((A ⟨0, hm⟩).incl : Matrix (Fin 2) (Fin 2) F → V) := by
    intro x y h
    simpa only [Frame.coords_incl] using congrArg ((A ⟨0, hm⟩).coords) h
  have : Nontrivial V := hincl.nontrivial
  choose x hx using huniq
  have hxπ : ∀ k, π (x k) = (A k.1).La (-1) := by
    rintro ⟨i, b⟩
    have hi := CFSG.ClassicalInvolution.Asc77.isUniqueInvolution_map_of_injOn
      π (hπinj (i, b)) (hx (i, b))
    have hord : orderOf (π (x (i, b))) = 2 :=
      orderOf_eq_prime (by simpa only [pow_two] using hi.sq) hi.ne_one
    rw [hR (i, b)] at hi
    cases b
    · exact IsFundamental.eq_of_orderOf_eq_two hodd (IsFundamental.of_frame (A i))
        hi.mem hord
    · simpa only [Frame.La_swap_neg_one] using
        IsFundamental.eq_of_orderOf_eq_two hodd (IsFundamental.of_frame (A i).swap)
          hi.mem hord
  have hkill : center U ≤ ψ.ker := ψ.center_le_ker hψ hX
  have hsame : ∀ i, ψ (x (i, true)) = ψ (x (i, false)) := by
    intro i
    have hker : x (i, true) * (x (i, false))⁻¹ ∈ π.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hxπ, hxπ, mul_inv_cancel]
    have h := hkill (hπker hker)
    rw [MonoidHom.mem_ker, map_mul, map_inv, mul_inv_eq_one] at h
    exact h
  let z : Fin m → X := fun i => ψ (x (i, false))
  have himage : ∀ k, ψ (x k) = z k.1 := by
    rintro ⟨i, b⟩
    cases b
    · rfl
    · exact hsame i
  refine ⟨z, ?_, fun k => ?_⟩
  · intro i j hij
    let c := x (j, false) * (x (i, false))⁻¹
    have hc : c ∈ center U := by
      apply hψker
      rw [MonoidHom.mem_ker]
      change ψ (x (j, false) * (x (i, false))⁻¹) = 1
      rw [map_mul, map_inv, show ψ (x (j, false)) = ψ (x (i, false)) from hij.symm]
      exact mul_inv_cancel _
    have hcx : c * x (i, false) = x (j, false) := by dsimp [c]; group
    have hc2 : c * c = 1 :=
      CFSG.ClassicalInvolution.Models.Transfer.sq_eq_one_of_mul_sq_eq_one
        (hx (i, false)).sq hc (by rw [hcx]; exact (hx (j, false)).sq)
    have hπc2 : π c * π c = 1 := by rw [← map_mul, hc2, map_one]
    have hlin : (A j).La (-1) = π c * (A i).La (-1) := by
      rw [← hxπ (j, false), ← hxπ (i, false), ← map_mul, hcx]
    rcases CFSG.ClassicalInvolution.Models.Transfer.eq_one_or_eq_neg_of_mem_scalars
        (hπZ c hc) hπc2 with hpos | hneg
    · rw [hpos, one_mul] at hlin
      have hspan : (A i).span = (A j).span := by
        rw [← negSpace_La_neg_one h2 (A i), ← negSpace_La_neg_one h2 (A j), hlin]
      by_contra hne
      have ho := horth i j hne
      have hbot : (A i).span = ⊥ := by
        apply le_antisymm _ bot_le
        intro v hv
        rw [Submodule.mem_bot]
        exact (A i).polarNondegOn_span v hv fun w hw =>
          ho.polar_zero hv (hspan ▸ hw)
      have hfour := (A i).finrank_span
      rw [hbot, finrank_bot] at hfour
      omega
    · rw [hneg] at hlin
      exact (hdim (CFSG.ClassicalInvolution.Asc77.finrank_eq_eight_of_proj
        hodd (A i) (A j) hlin)).elim
  · rw [← himage k]
    exact CFSG.ClassicalInvolution.Asc77.isUniqueInvolution_map_of_injOn
      ψ (hψinj k) (hx k)

end Frames

section Models

variable {F V : Type} [Field F] [Finite F] [AddCommGroup V] [Module F V]
  [FiniteDimensional F V] {Q : QuadraticForm F V}
  {X : Type} [Group X] [IsSimpleGroup X]
  {p n e m : ℕ} [hp : Fact p.Prime] {t : StatedLieTag}


theorem exists_uniqueInvolution_paired_model_frames
    (hp2 : p ≠ 2) (hfund : IsFundTag t) (hadm : StatedLieAdmissible t n p e)
    (hA1 : ¬ (t = .PSL ∧ n = 2)) (hm : 0 < m)
    (hodd : Odd (Nat.card F)) (hdim : Module.finrank F V ≠ 8)
    (π : (modelUniv t n p e hp.out).K →* (V ≃ₗ[F] V))
    (hπker : π.ker ≤ center (modelUniv t n p e hp.out).K)
    (hπZ : ∀ z ∈ center (modelUniv t n p e hp.out).K, π z ∈ scalars F V)
    (A : Fin m → OFrame Q) (horth : ∀ i j, i ≠ j → SpanOrth (A i) (A j))
    (R : Fin m × Bool → Subgroup (modelUniv t n p e hp.out).K)
    (hR : ∀ k, R k ∈ fundamentalSubgroups t (modelUniv t n p e hp.out).D ∧
      (R k).map π = if k.2 then (A k.1).swap.La.range else (A k.1).La.range)
    (ψ : (modelUniv t n p e hp.out).K →* X) (hψ : Function.Surjective ψ)
    (hψker : ψ.ker ≤ center (modelUniv t n p e hp.out).K) :
    ∃ z : Fin m → X, Function.Injective z ∧
      ∀ k, IsUniqueInvolution ((R k).map ψ) (z k.1) := by
  have huniq : ∀ k, ∃ x, IsUniqueInvolution (R k) x := fun k =>
    CFSG.ClassicalInvolution.ModelFacts.exists_isUniqueInvolution_of_mem_fundamentalSubgroups
      hp2 hfund hadm (hR k).1
  have inj : ∀ {Y : Type} [Group Y]
      (φ : (modelUniv t n p e hp.out).K →* Y),
      φ.ker ≤ center (modelUniv t n p e hp.out).K →
      ∀ k, ∀ x ∈ R k, φ x = 1 → x = 1 := by
    intro Y _ φ hφ k x hx h1
    have heq :=
      CFSG.LocalAnalysis.UniquenessCase.PartTwo.Inputs1719.inf_ker_eq_bot_of_mem_fundamentalSubgroups
        hfund hadm hA1 φ hφ (hR k).1
    have hmem : x ∈ R k ⊓ φ.ker := ⟨hx, h1⟩
    simpa only [heq, Subgroup.mem_bot] using hmem
  have hnc : ∃ a b : X, a * b ≠ b * a := by
    let k : Fin m × Bool := (⟨0, hm⟩, false)
    rcases CFSG.ClassicalInvolution.ModelFacts.nonempty_equiv_sl2_galoisField_of_mem_fundamentalSubgroups
        hp2 hfund hadm (hR k).1 with ⟨⟨eR⟩⟩ | ⟨_, ⟨eR⟩⟩
    all_goals
      obtain ⟨a, _, b, _, hab⟩ := F14.exists_noncommuting_map_of_equiv_sl2 ψ hψker eR
      exact ⟨ψ a, ψ b, hab⟩
  have hX : center X = ⊥ :=
    TauCeti.IsSimpleGroup.center_eq_bot_of_not_isMulCommutative (by
      intro h
      obtain ⟨a, b, hab⟩ := hnc
      exact hab (h.is_comm.comm a b))
  exact exists_uniqueInvolution_of_paired_frame_maps hm hodd hdim π hπker hπZ A horth R
    (fun k => (hR k).2) huniq (inj π hπker) ψ hψ hψker (inj ψ hψker) hX

theorem conjPermHom_mem_blockStab_of_paired_model_frames
    (hp2 : p ≠ 2) (hfund : IsFundTag t) (hadm : StatedLieAdmissible t n p e)
    (hA1 : ¬ (t = .PSL ∧ n = 2)) (hm : 0 < m)
    (hodd : Odd (Nat.card F)) (hdim : Module.finrank F V ≠ 8)
    (π : (modelUniv t n p e hp.out).K →* (V ≃ₗ[F] V))
    (hπker : π.ker ≤ center (modelUniv t n p e hp.out).K)
    (hπZ : ∀ z ∈ center (modelUniv t n p e hp.out).K, π z ∈ scalars F V)
    (A : Fin m → OFrame Q) (horth : ∀ i j, i ≠ j → SpanOrth (A i) (A j))
    (R : Fin m × Bool → Subgroup (modelUniv t n p e hp.out).K)
    (hR : ∀ k, R k ∈ fundamentalSubgroups t (modelUniv t n p e hp.out).D ∧
      (R k).map π = if k.2 then (A k.1).swap.La.range else (A k.1).La.range)
    (ψ : (modelUniv t n p e hp.out).K →* X) (hψ : Function.Surjective ψ)
    (hψker : ψ.ker ≤ center (modelUniv t n p e hp.out).K)
    (Δ : Set (Subgroup X)) (ePair : Fin m × Bool ≃ Δ)
    (hPair : ∀ k, (ePair k : Subgroup X) = (R k).map ψ) :
    ∀ g : conjSetStab Δ,
      ePair.symm.permCongrHom (conjPermHom (le_refl (conjSetStab Δ)) g) ∈
        CFSG.HardMathSupport.Cooperstein.AlternatingGeometry.blockStab (Fin m) := by
  obtain ⟨z, hinj, huniq⟩ := exists_uniqueInvolution_paired_model_frames
    hp2 hfund hadm hA1 hm hodd hdim π hπker hπZ A horth R hR ψ hψ hψker
  exact conjPermHom_mem_blockStab_of_uniqueInvolutions ePair z hinj
    (fun k => by rw [hPair]; exact huniq k)

end Models

end CFSG.LocalAnalysis.UniquenessCase.UC22
