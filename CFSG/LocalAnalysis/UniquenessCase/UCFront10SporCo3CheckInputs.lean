@[expose] def co3KBytes : ByteArray := co3KText.toUTF8

@[expose] def co3KArr (L : Nat) : Array Nat := hexLine co3KBytes 3 276 L

@[expose] def co3KE : Array Nat := co3KArr 0

@[expose] def co3KT1 : Array Nat := co3KArr 1

@[expose] def co3KG1 : Array Nat := co3KArr 2

@[expose] def co3KX5 : Array Nat := co3KArr 3

@[expose] def co3KX7 : Array Nat := co3KArr 4

@[expose] def co3KD : Array (Array Nat) := Array.ofFn (n := 23) fun j => co3KArr (5 + j.val)

@[expose] def co3KGens : Array (Array Nat) := co3TArrs.extract 0 8

@[expose] def co3KGensInv : Array (Array Nat) := co3KGens.map (invCand 276)

@[expose] def co3KPow (a : Array Nat) : Nat → Array Nat
  | 0 => idA 276
  | k + 1 => compA 276 a (co3KPow a k)

@[expose] def co3KW : Array (Array Nat) :=
  Array.ofFn (n := 72) fun t =>
    if t.val < 64 then commA 276 co3KGens (t.val / 8) (t.val % 8)
    else co3KPow co3KGens[t.val - 64]! 4

@[expose] def co3KKappa (a : Array Nat) : Array Nat :=
  renameA 36 co3CspArr (restrictA co3IzArr a)

@[expose] def co3KAllProd3 (L : Array Level) (p : Array Nat → Bool) : Bool :=
  allLt L[0]!.pts.size fun a => allLt L[1]!.pts.size fun b => allLt L[2]!.pts.size fun c =>
    p (compA 276 (compA 276 L[0]!.tr[a]! L[1]!.tr[b]!) L[2]!.tr[c]!)

@[expose] def co3KECheck (L : Array Level) (e z : Array Nat) : Bool :=
  co3KAllProd3 L fun g =>
    eqA 276 (compA 276 g e) (compA 276 e g) || eqA 276 (compA 276 g e) (compA 276 (compA 276 e z) g)

@[expose] def co3KK3Check (L : Array Level) (G Ginv D : Array (Array Nat)) : Bool :=
  co3KAllProd3 L fun g =>
    !(eqA 276 (compA 276 g g) (idA 276)) || eqA 276 g (idA 276) ||
      !(allLt G.size fun k => commutesA 276 g (compA 276 (compA 276 G[k]! g) Ginv[k]!)) ||
      anyLt D.size fun i => eqA 276 g D[i]!

@[expose] def co3KK5Check (D W : Array (Array Nat)) (z : Array Nat) : Bool :=
  allLt D.size fun i => allLt D.size fun j =>
    !(commutesA 276 D[i]! D[j]!) || eqA 276 D[i]! z || eqA 276 D[j]! z || eqA 276 D[j]! D[i]! ||
      eqA 276 D[j]! (compA 276 D[i]! z) ||
      anyLt W.size fun k => !(commutesA 276 W[k]! D[i]! && commutesA 276 W[k]! D[j]!)

@[expose] def co3KFix1 (a : Array Nat) : Bool :=
  anyLt 36 fun p => allLt 36 fun i => (a[i]! == i) == (i == p)

@[expose] def co3KCheck : Bool :=
  (allLt 28 fun L => isInvA 276 (co3KArr L) (invCand 276 (co3KArr L))) &&
  siftA 276 co3TLevels co3TBaseArr 0 co3KE &&
  eqA 276 (compA 276 co3KE co3KE) (idA 276) &&
  !(eqA 276 co3KE (idA 276)) && !(eqA 276 co3KE co3ZArr) &&
  co3KECheck co3TLevels co3KE co3ZArr &&
  siftA 276 co3TLevels co3TBaseArr 0 co3KT1 &&
  eqA 276 (compA 276 co3KT1 co3KE) (compA 276 (compA 276 co3KE co3ZArr) co3KT1) &&
  siftA 276 co3ChainLevels co3ChainBaseArr 0 co3KG1 &&
  eqA 276 (compA 276 co3KG1 co3KE) (compA 276 co3ZArr co3KG1) &&
  siftA 276 co3MLevels co3MBaseArr 0 co3KX5 &&
  eqA 276 (co3KPow co3KX5 5) (idA 276) && !(eqA 276 co3KX5 (idA 276)) &&
  co3KFix1 (co3KKappa co3KX5) &&
  siftA 276 co3MLevels co3MBaseArr 0 co3KX7 &&
  eqA 276 (co3KPow co3KX7 7) (idA 276) && !(eqA 276 co3KX7 (idA 276)) &&
  co3KFix1 (co3KKappa co3KX7) &&
  co3KK3Check co3TLevels co3KGens co3KGensInv co3KD &&
  co3KK5Check co3KD co3KW co3ZArr

