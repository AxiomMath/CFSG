theorem r3lf_exists_fpf_orthogonalMinus {K : Type} [Field K] [Finite K] [CharP K 2]
    {f r : ℕ} (hf : 1 ≤ f) (hK : Nat.card K = 2 ^ f) (hr : r.Prime) (hr5 : 5 ≤ r)
