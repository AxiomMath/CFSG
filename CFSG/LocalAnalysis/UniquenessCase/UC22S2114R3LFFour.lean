    Nat.prime_two hf hK hσ
  obtain ⟨q, hq, hq7, hqr, hqd, hqnot⟩ := uc22s2114r4f_exists_ppd_psl hf hr hr5 hrf
  have : Fact q.Prime := ⟨hq⟩
