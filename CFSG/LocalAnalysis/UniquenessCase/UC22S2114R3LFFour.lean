          ∃ ι : A →* matrixProjectiveDerived (coordinateQuadMinus 4 K (by norm_num) (b : K) (c : K)),
            Function.Injective ι ∧ ∀ a,
              fieldAutT _ σ (coordinateQuadMinus_fieldAut _ 4 (by norm_num) (fun _ => Iff.rfl) b c)
