variable {G : Type} [Group G] [Finite G]

theorem uc22s2112r34_exists_sylow_barInf {D : Data G} {L : Subgroup G} (hL : L ∈ calC D.M) :
    ∃ P : Sylow 2 (BarInf L), (P : Subgroup (BarInf L)) =
      ((D.T ⊓ L).subgroupOf L).map (QuotientGroup.mk' (CFSG.solvableRadical ↥L)) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨Q, hQ⟩ := (uc22p2214_isSylowOf_inf D.sylowM hL.1).exists_sylow_eq_subgroupOf
  exact ⟨Q.mapSurjective (QuotientGroup.mk'_surjective _), by rw [Sylow.coe_mapSurjective, hQ]⟩

theorem uc22s2112r34_funHyp_barInf {M L : Subgroup G} (hL : L ∈ calC M) {t : StatedLieTag}
    {n p f : ℕ} (hp : p.Prime) (hX : LieModel (BarInf L) t n p f)
    (hno : ∀ f : ℕ, ¬ LieModel (BarInf L) .PSL 2 p f) (hL3 : ¬ IsL3EpsOdd17 (BarInf L) p)
    (hree : ∀ f : ℕ, ¬ LieModel (BarInf L) .twistedG2 0 3 f) :
    CFSG.Open.IsQuasisimple (BarInf L) ∧ Odd (Nat.card (center (BarInf L))) ∧
      LieModel (BarInf L ⧸ center (BarInf L)) t n p f ∧
      ¬ IsL2Over17 (BarInf L ⧸ center (BarInf L)) (p ^ f) ∧
      ¬ IsL3EpsOdd17 (BarInf L ⧸ center (BarInf L)) p ∧ ¬ IsReeOver17 (BarInf L) (p ^ f) := by
  obtain ⟨hs, a, b, hab⟩ := uc22p20c_barInf_simple (uc22p20e_cComp_of_calC hL)
  have hZ : center (BarInf L) = ⊥ := center_barInf_eq_bot hL.2.2
  let e : BarInf L ⧸ center (BarInf L) ≃* BarInf L :=
    (QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot
  refine ⟨⟨?_, e.isSimpleGroup⟩, ?_, hX.of_mulEquiv e.symm, ?_, ?_, ?_⟩
  · rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (commutator (BarInf L)) with h | h
    · have ha : a ∈ center (BarInf L) := by
        rw [(commutator_eq_bot_iff_center_eq_top _).1 h]
        exact mem_top a
      exact absurd (mem_center_iff.1 ha b).symm hab
    · exact h
  · rw [hZ, card_bot]
    exact odd_one
  · rintro ⟨r, e', hr, -, hq, he', hm⟩
    have hrq : r ∣ p ^ f := by
      rw [hq]
      exact dvd_pow_self r (by omega)
    obtain rfl := (Nat.prime_dvd_prime_iff_eq hr hp).1 (hr.dvd_of_dvd_pow hrq)
    exact hno e' (hm.of_mulEquiv e)
  · rintro (h | h)
    · exact hL3 (Or.inl (h.of_mulEquiv e))
    · exact hL3 (Or.inr (h.of_mulEquiv e))
  · rintro ⟨m, -, hm⟩
    exact hree _ hm

section Nonempty


theorem uc22s2112r34_funSet_nonempty_barInf {M L : Subgroup G} (hL : L ∈ calC M)
    {t : StatedLieTag} {n p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hX : LieModel (BarInf L) t n p f) (hno : ∀ f : ℕ, ¬ LieModel (BarInf L) .PSL 2 p f)
    (hL3 : ¬ IsL3EpsOdd17 (BarInf L) p)
    (hree : ∀ f : ℕ, ¬ LieModel (BarInf L) .twistedG2 0 3 f) (hq : 3 < p ^ f)
    (P : Sylow 2 (BarInf L)) :
    (FunSet (fundPred (p ^ f)) (BarInf L) (P : Subgroup (BarInf L))).Nonempty := by
  obtain ⟨hqs, hodd, hXZ, h2, h3, hR⟩ := uc22s2112r34_funHyp_barInf hL hp hX hno hL3 hree
  exact k_FunNonempty_holds (BarInf L) p (p ^ f) hp hp2 ⟨t, n, f, hX.admissible, rfl, hXZ⟩ hqs
    hodd h2 h3 hR hq P

end Nonempty

section Fund


theorem uc22s2112r34_funSet_commute_barInf (hKC : K_FunCommute) {M L : Subgroup G}
    (hL : L ∈ calC M) {t : StatedLieTag} {n p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hX : LieModel (BarInf L) t n p f) (hno : ∀ f : ℕ, ¬ LieModel (BarInf L) .PSL 2 p f)
    (hL3 : ¬ IsL3EpsOdd17 (BarInf L) p)
    (hree : ∀ f : ℕ, ¬ LieModel (BarInf L) .twistedG2 0 3 f) (hq : 3 < p ^ f)
    (P : Sylow 2 (BarInf L)) {K₁ K₂ : Subgroup (BarInf L)}
    (h₁ : K₁ ∈ FunSet (fundPred (p ^ f)) (BarInf L) (P : Subgroup (BarInf L)))
    (h₂ : K₂ ∈ FunSet (fundPred (p ^ f)) (BarInf L) (P : Subgroup (BarInf L))) (hne : K₁ ≠ K₂) :
    ⁅K₁, K₂⁆ = ⊥ := by
  obtain ⟨hqs, hodd, hXZ, h2, h3, hR⟩ := uc22s2112r34_funHyp_barInf hL hp hX hno hL3 hree
  exact hKC (BarInf L) p (p ^ f) hp hp2 ⟨t, n, f, hX.admissible, rfl, hXZ⟩ hqs hodd h2 h3 hR hq P
    K₁ h₁ K₂ h₂ hne

theorem uc22s2112r34_le_pRank_of_isFundamentalOver {X : Type} [Group X] [Finite X] {p f : ℕ}
    (hp : p.Prime) (hf : 1 ≤ f) {K : Subgroup X} (hK : IsFundamentalOver (p ^ f) K) :
    f ≤ CFSG.Open.pRank p K := by
  classical
  obtain ⟨p', e₀, e, _, hp'2, he₀, hq, he, φ, rfl, hker⟩ := uc22s2112r34_exists_sl2_cover hK
  have hp' : p'.Prime := Fact.out
  have hpp : p' = p := by
    have h1 : p' ∣ p ^ f := by
      rw [hq]
      exact dvd_pow_self p' (by omega)
    exact (Nat.prime_dvd_prime_iff_eq hp' hp).1 (hp'.dvd_of_dvd_pow h1)
  rw [hpp] at hq
  have hfe₀ : f = e₀ := Nat.pow_right_injective hp.two_le hq
  have hfe : f ≤ e := by rcases he with h | h <;> omega
  rw [← hpp]
  have hsq : ∀ z ∈ center SL(2, GaloisField p' e), z ^ 2 = 1 := fun z hz => by
    rcases Matrix.SpecialLinearGroup.mem_center_iff_eq_one_or_eq_neg_one.1 hz with rfl | rfl
    · exact one_pow 2
    · rw [sq, neg_mul_neg, mul_one]
  have hcop : ∀ N : Subgroup SL(2, GaloisField p' e), N ≤ center SL(2, GaloisField p' e) →
      p'.Coprime (Nat.card N) := by
    intro N hN
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    have h2 : IsPGroup 2 N := fun z => ⟨1, by
      rw [pow_one]
      exact Subtype.ext (hsq _ (hN z.2))⟩
    obtain ⟨k, hk⟩ := h2.exists_card_eq
    rw [hk]
    exact Nat.Coprime.pow_right k ((Nat.coprime_primes hp' Nat.prime_two).2 hp'2)
  have h1 : CFSG.Open.pRank p' (⊤ : Subgroup SL(2, GaloisField p' e)) =
      CFSG.Open.pRank p' (⊤ : Subgroup φ.range) :=
    CFSG.RankThreeCoreUniqueness.Helpers.pRank_top_eq_of_coprime_kernel p' hp' φ.rangeRestrict
      φ.rangeRestrict_surjective (by rw [MonoidHom.ker_rangeRestrict]; exact hcop _ hker)
  have h2 : CFSG.Open.pRank p' (⊤ : Subgroup SL(2, GaloisField p' e)) =
      CFSG.Open.pRank p' (⊤ : Subgroup PSL(2, GaloisField p' e)) :=
    CFSG.RankThreeCoreUniqueness.Helpers.pRank_top_eq_of_coprime_kernel p' hp'
      (QuotientGroup.mk' _) (QuotientGroup.mk'_surjective _)
      (by rw [QuotientGroup.ker_mk']; exact hcop _ le_rfl)
  have h3 := CFSG.Quasithin.H13.S3320.le_pRank_of_psl2 (p := p') (f := e) (by omega)
    (MulEquiv.refl PSL(2, GaloisField p' e))
  rw [CFSG.SectionRank.pRank_eq_open_pRank_top] at h3
  rw [CFSG.SectionRank.pRank_eq_pRank_top_subgroup, ← h1, h2]
  omega

end Fund

section Exc


theorem uc22s2112r34_not_isL3EpsOdd17_of_exc {X : Type} [Group X] {t : StatedLieTag} {n p : ℕ}
    (hp : p.Prime) (hX : LieModel X t n p 1) (ht : (t = .PSp ∧ n = 2) ∨ t = .G2) :
    ¬ IsL3EpsOdd17 X p := by
  have : Fact p.Prime := ⟨hp⟩
  have hv : padicValNat p (Nat.card X) ≠ 3 := by
    rcases ht with ⟨rfl, rfl⟩ | rfl
    · have hc : Nat.card X = ordBC 2 (p ^ 1) := (hX.card_eq_lieOrd (by norm_num)).trans rfl
      rw [hc, CFSG.ClassicalInvolution.RouteD.TWR.v_ordBC2 (p := p) Nat.one_pos]
      norm_num
    · have hc : Nat.card X = ordG2 (p ^ 1) :=
        (CFSG.EvenSmallLie.CatalogOrders.card_eq_lieOrd_of_exceptional
          (hX.chevalleyExceptionalModel (by decide))).trans rfl
      rw [hc, CFSG.ClassicalInvolution.RouteD.TWR.padicValNat_ordG2 (p := p) rfl Nat.one_pos]
      norm_num
  rintro (h | h)
  · have hc : Nat.card X = ordA 2 (p ^ 1) := (h.card_eq_lieOrd (by norm_num)).trans rfl
    rw [hc, CFSG.ClassicalInvolution.RouteD.TWR.v_ordA2 (p := p) Nat.one_pos] at hv
    exact hv (by norm_num)
  · have hc : Nat.card X = ordTwistedA 2 (p ^ 1) := (h.card_eq_lieOrd (by norm_num)).trans rfl
    rw [hc, CFSG.ClassicalInvolution.RouteD.TWR.v_ordTA2 (p := p) Nat.one_pos] at hv
    exact hv (by norm_num)

end Exc

