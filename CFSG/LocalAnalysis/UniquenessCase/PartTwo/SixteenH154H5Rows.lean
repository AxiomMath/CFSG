theorem s16h_H5_block
    {W : Type} [CommGroup W] [Finite W] (hW : ∀ w : W, w ^ 2 = 1)
    {A L : Subgroup (MulAut W)} {t : MulAut W} (htA : t ∈ A) (ht2 : t ^ 2 = 1) (ht1 : t ≠ 1)
    (htr : rk ↥(commSub ⊤ (Subgroup.zpowers t)) ≤ 3) (hconc : Conc4_136W A t L)
    (hcomp : IsComponentOf L A)
    (hthin : ∀ q : ℕ, q.Prime → q ≠ 2 → CFSG.Open.pRank q L ≤ 1) :
    ∀ q : ℕ, q.Prime → q ≠ 2 → ∀ E : Subgroup (MulAut W),
        E ≤ A ⊓ normalizer (L : Set (MulAut W)) → IsElemAbelian q E →
        Nat.card E ≤ q ^ 2 * Nat.card ↥(E ⊓ centSub (commSub ⊤ L)) := by
  have hc : s16h_H5Cfg A L t := ⟨hW, htA, ht2, ht1, htr, hconc, hcomp, hthin⟩
  rcases hconc.2.2 with h1 | h2 | h3 | h4
  · exact (s16h_H5_not_pgroup hc h1).elim
  · exact (s16h_H5_not_tensor hc h2).elim
  · obtain ⟨-, hsum, -⟩ := h3
    rcases s16h_H5_thin_sum hc hsum with hr | hr
    · exact s16h_H5_row_L3 hc hr
    · exact s16h_H5_row_A5 hc hr
  · obtain ⟨-, -, -, h135⟩ := h4
    rcases s16h_H5_thin_one hc h135 with hr | hr | hr | hr | hr | hr | hr
    · exact s16h_H5_row_L3 hc hr
    · exact s16h_H5_row_A5 hc hr
    · exact s16h_H5_row_SL2_four hc hr
    · exact s16h_H5_row_SL2_eight hc hr
    · exact s16h_H5_row_O4_two hc hr
    · exact s16h_H5_row_O4_three hc hr
    · exact s16h_H5_row_St8 hc hr

theorem s16h_H5_rows
    (hJP : K_JonesParshallH1) {W : Type} [CommGroup W] [Finite W]
    (hW : ∀ w : W, w ^ 2 = 1)
    {A L : Subgroup (MulAut W)} {t : MulAut W} (htA : t ∈ A) (ht2 : t ^ 2 = 1) (ht1 : t ≠ 1)
    (htr : rk ↥(commSub ⊤ (Subgroup.zpowers t)) ≤ 3) (hconc : Conc4_136W A t L)
    (hcomp : IsComponentOf L A)
    (hthin : ∀ q : ℕ, q.Prime → q ≠ 2 → CFSG.Open.pRank q L ≤ 1) :
    (∀ q : ℕ, q.Prime → q ≠ 2 → ∀ E : Subgroup (MulAut W),
        E ≤ A ⊓ normalizer (L : Set (MulAut W)) → IsElemAbelian q E →
        Nat.card E ≤ q ^ 2 * Nat.card ↥(E ⊓ centSub (commSub ⊤ L))) ∧
      (commSub ⊤ L ⊓ fixV L = ⊥ ∨
        ∀ T : Subgroup (MulAut W), T ≤ A ⊓ normalizer (L : Set (MulAut W)) →
          (∀ g ∈ A ⊓ normalizer (L : Set (MulAut W)), ∀ x ∈ T, g * x * g⁻¹ ∈ T) →
          (∀ x ∈ T, ∃ n : ℕ, x ^ 2 ^ n ∈ centSub (commSub ⊤ L ⊓ fixV L)) →
          (∃ f ∈ A ⊓ normalizer (L : Set (MulAut W)), ∃ q : ℕ, q.Prime ∧ q ≠ 2 ∧
            f ∉ centSub (commSub ⊤ L ⊓ fixV L) ∧ f ^ q ∈ centSub (commSub ⊤ L ⊓ fixV L)) →
          T ≤ centSub (commSub ⊤ L ⊓ fixV L)) :=
  ⟨s16h_H5_block hW htA ht2 ht1 htr hconc hcomp hthin,
    s16h_H5_zcond hJP hW htA ht2 ht1 htr hconc hcomp hthin⟩

