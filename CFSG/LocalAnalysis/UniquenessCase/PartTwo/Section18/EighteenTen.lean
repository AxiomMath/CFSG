@[expose] def K_18_10_Sp : Prop :=
  ∀ {W : Type} [CommGroup W] [Finite W], (∀ w : W, w ^ 2 = 1) →
    ∀ (H : Subgroup (MulAut W)) (f p : ℕ), p.Prime →
      (2 : ℤ) ^ f ≡ -1 [ZMOD (p : ℤ)] →
      IsSp4 ↥H f → NatSpn H ⊤ (CFSG.Quasithin.fixV H) 4 f →
        ∀ v : W, v ∉ CFSG.Quasithin.fixV H →
          p ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.piSet (centVec H v)

@[expose] def K_18_10_G2 : Prop :=
  ∀ {W : Type} [CommGroup W] [Finite W], (∀ w : W, w ^ 2 = 1) →
    ∀ (H : Subgroup (MulAut W)) (f p : ℕ), 2 ≤ f → p.Prime →
      (2 : ℤ) ^ f ≡ -1 [ZMOD (p : ℤ)] →
      IsG2 ↥H f → CFSG.Quasithin.G2Natural H ⊤ (CFSG.Quasithin.fixV H) f →
        ∀ v : W, v ∉ CFSG.Quasithin.fixV H →
          p ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.piSet (centVec H v)

@[expose] def Gap_18_10_piCV_a (D : Data G) (V₀ V : Subgroup G) (p : ℕ) (L : Subgroup G)
    (h : Hyp18 D V₀ V p L) : Prop :=
  P18_6_2 D V₀ V p L h →
    (¬ ∃ n : ℕ,
      IsSUn ↥(barSub V₀ V h.hyp125.isElemAbelian (conjClosure D.M L)) 4 n ∨
        IsOmegaMinus ↥(barSub V₀ V h.hyp125.isElemAbelian (conjClosure D.M L)) 6 n ∨
        IsOmegaPlus ↥(barSub V₀ V h.hyp125.isElemAbelian (conjClosure D.M L)) 4 n) →
      p ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.piSet (D.M ⊓ centralizer (V : Set G))

@[expose] def Gap_18_10_piCV_b (D : Data G) (V₀ V : Subgroup G) (p : ℕ) (L : Subgroup G)
    (h : Hyp18 D V₀ V p L) : Prop :=
  P18_6_2 D V₀ V p L h →
    (((∃ f : ℕ,
          Even f ∧
            IsOmegaMinus ↥(barSub V₀ V h.hyp125.isElemAbelian (conjClosure D.M L)) 4 (f / 2) ∧
            NatOmegaMinus (barSub V₀ V h.hyp125.isElemAbelian (conjClosure D.M L)) ⊤
              (CFSG.Quasithin.fixV
                (barSub V₀ V h.hyp125.isElemAbelian (conjClosure D.M L))) 4 (f / 2)) ∨
        (∃ f : ℕ,
          IsL2 ↥(barSub V₀ V h.hyp125.isElemAbelian (conjClosure D.M L)) f ∧
            CFSG.Quasithin.BinaryNaturalSL
              (barSub V₀ V h.hyp125.isElemAbelian (conjClosure D.M L)) ⊤
              (CFSG.Quasithin.fixV
                (barSub V₀ V h.hyp125.isElemAbelian (conjClosure D.M L))) 2 f)) →
      2 ≤ CFSG.Open.pRank p (D.M ⊓ centralizer (V : Set G)))

