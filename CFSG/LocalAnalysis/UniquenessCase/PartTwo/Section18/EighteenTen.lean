theorem omega1_center_le_cClos (D : Data G) (V : Subgroup G) (k : ℕ) :
    F11.Omega1p 2 (CFSG.Quasithin.centerOf D.T) ≤ CFSG.Quasithin.E3.cClos V k D.T := by
  refine (Subgroup.closure_le (CFSG.Quasithin.E3.cClos V k D.T)).2 ?_
  rintro x ⟨hx, hx2⟩
  exact mem_cClos_of_mem_center D V k hx.1 (fun t ht => (hx.2 t ht).symm)

theorem mBarGT_k_of_hyp1669 (D : Data G) {V₀ V : Subgroup G}
    (h1669 : Nat.card V₀ ≤ 4 → MBarGT D.M V₀ V 3) (hV₀ : V₀ = ⊥) :
    MBarGT D.M V₀ V D.k := by
  have hk : D.k ≤ 3 := by
    unfold Data.k CFSG.LocalAnalysis.RankThreeUC.kParam
    split_ifs <;> norm_num
  refine TwelveShort.mBarGT_mono (h1669 ?_) hk
  rw [hV₀, Subgroup.card_bot]
  norm_num

theorem fixes_of_actTil_tilOf_eq_of_odd {V₀ V : Subgroup G} (hV : IsElemAbelian 2 V)
    (hV₀ : V₀ ≤ V) (hcard : Nat.card V₀ ≤ 2) {g : G} (hgs : g ∈ stabTil V₀ V)
    {v : G} (hv : v ∈ V)
    (hfix : actTil V₀ V hV ⟨g, hgs⟩ (tilOf V₀ V hV v hv) = tilOf V₀ V hV v hv)
    (hodd : Odd (orderOf g)) : g * v * g⁻¹ = v := by
  have hcV₀ : g * v * g⁻¹ * v⁻¹ ∈ V₀ := by
    have h2 : mkTil V₀ V hV
        (actStab V₀ V hV ⟨g, hgs⟩ (CFSG.Quasithin.IntMod.mk hV ⟨v, hv⟩)) =
        mkTil V₀ V hV (CFSG.Quasithin.IntMod.mk hV ⟨v, hv⟩) := by
      rw [← actTil_mk]
      exact hfix
    have h3 := (mkTil_eq_iff V₀ V hV _ _).1 h2
    rwa [actStab_apply_val] at h3
  set c := g * v * g⁻¹ * v⁻¹ with hcdef
  by_cases hc1 : c = 1
  · have h1 : g * v * g⁻¹ = c * v := by rw [hcdef]; group
    rw [h1, hc1, one_mul]
  · have hc2 : c * c = 1 := by
      have h := hV.2 c (hV₀ hcV₀)
      rwa [pow_two] at h
    have hcard2 : Nat.card V₀ = 2 := by
      refine le_antisymm hcard ?_
      have h1 : 1 < Nat.card V₀ := by
        rw [Finite.one_lt_card_iff_nontrivial]
        exact ⟨⟨⟨c, hcV₀⟩, 1, fun h => hc1 (Subtype.ext_iff.mp h)⟩⟩
      omega
    have hgc : g * c * g⁻¹ = c := by
      have hmem : g * c * g⁻¹ ∈ V₀ :=
        (Subgroup.mem_normalizer_iff.1 (stabTil_le_normalizer₀ V₀ V hgs) c).1 hcV₀
      have hne1 : g * c * g⁻¹ ≠ 1 := by
        intro h
        apply hc1
        calc c = g⁻¹ * (g * c * g⁻¹) * g := by group
          _ = 1 := by rw [h]; group
      obtain ⟨z, -, hzu⟩ := (Nat.card_eq_two_iff' (1 : V₀)).1 hcard2
      have e1 : (⟨g * c * g⁻¹, hmem⟩ : V₀) = z :=
        hzu _ (fun h => hne1 (Subtype.ext_iff.mp h))
      have e2 : (⟨c, hcV₀⟩ : V₀) = z :=
        hzu _ (fun h => hc1 (Subtype.ext_iff.mp h))
      exact Subtype.ext_iff.mp (e1.trans e2.symm)
    have hpow : ∀ k : ℕ, g ^ k * v * (g ^ k)⁻¹ = c ^ k * v := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        have hcu : g * v * g⁻¹ = c * v := by rw [hcdef]; group
        have hgk : g * c ^ k * g⁻¹ = c ^ k := by
          have := congrArg (fun z => z ^ k) hgc
          simpa [conj_pow] using this
        calc g ^ (k + 1) * v * (g ^ (k + 1))⁻¹
            = g * (g ^ k * v * (g ^ k)⁻¹) * g⁻¹ := by group
          _ = g * (c ^ k * v) * g⁻¹ := by rw [ih]
          _ = (g * c ^ k * g⁻¹) * (g * v * g⁻¹) := by group
          _ = c ^ k * (c * v) := by rw [hgk, hcu]
          _ = c ^ (k + 1) * v := by group
    have hc2' : c ^ 2 = 1 := by rw [pow_two]; exact hc2
    have hco : c ^ orderOf g = c := by
      obtain ⟨m, hm⟩ := hodd
      rw [hm, pow_succ, pow_mul, hc2', one_pow, one_mul]
    have hfin := hpow (orderOf g)
    rw [pow_orderOf_eq_one, hco, one_mul, inv_one] at hfin
    exfalso
    exact hc1 (by
      have hfin' : c * v = v := by simpa using hfin.symm
      have h5 := congrArg (· * v⁻¹) hfin'
      simpa [mul_assoc] using h5)

theorem false_of_realizesVia_fixV_eq_top {W : Type} [CommGroup W]
    {D : CFSG.Quasithin.FFModel} {H : Subgroup (MulAut W)} {π : D.Gam →* ↥H}
    (h : D.RealizesVia H ⊤ (CFSG.Quasithin.fixV H) π)
    (hH : H = ⊥) {s : D.Amb} (hsSec : s ∈ D.sec) (hs : s ∉ D.ker) : False := by
  subst H
  have hfix : CFSG.Quasithin.fixV (⊥ : Subgroup (MulAut W)) = ⊤ := by
    ext w
    simp [CFSG.Quasithin.mem_fixV]
  rw [hfix] at h
  obtain ⟨-, -, -, -, -, -, -, β, hβsurj, hβker, -⟩ := h
  have hβ1 : β = 1 := by
    ext u
    rw [MonoidHom.one_apply]
    exact (hβker u).2 (Subgroup.mem_top _)
  let s' : D.sec := ⟨s, hsSec⟩
  have h1 : (QuotientGroup.mk s' : ↥D.sec ⧸ D.ker.subgroupOf D.sec) = 1 := by
    obtain ⟨u, hu⟩ := hβsurj (QuotientGroup.mk s' : ↥D.sec ⧸ D.ker.subgroupOf D.sec)
    rw [← hu, hβ1, MonoidHom.one_apply]
  exact hs (Subgroup.mem_subgroupOf.1
    ((QuotientGroup.eq_one_iff (N := D.ker.subgroupOf D.sec) s').1 h1))

theorem barSub_ne_bot_of_natSpn {W : Type} [CommGroup W] [Finite W]
    {H : Subgroup (MulAut W)} {f : ℕ}
    (h : NatSpn H ⊤ (CFSG.Quasithin.fixV H) 4 f) : H ≠ ⊥ := by
  intro hH
  obtain ⟨-, K, hKfield, hKfin, hKcard, π, hreal⟩ := h
  letI := hKfield
  have hs : ((Multiplicative.ofAdd (fun _ : Fin 2 ⊕ Fin 2 => (1 : K))) :
      Multiplicative (Fin 2 ⊕ Fin 2 → K)) ∉
      (CFSG.Quasithin.FFModel.nat (StatedSp 2 K)).ker := by
    change (Multiplicative.ofAdd (fun _ : Fin 2 ⊕ Fin 2 => (1 : K))) ∉
      (⊥ : Subgroup (Multiplicative (Fin 2 ⊕ Fin 2 → K)))
    intro h1
    have h2 := congrArg (fun x : Multiplicative (Fin 2 ⊕ Fin 2 → K) =>
      (Multiplicative.toAdd x) (Sum.inl 0)) h1
    simpa using h2
  exact false_of_realizesVia_fixV_eq_top
    (D := CFSG.Quasithin.FFModel.nat (StatedSp 2 K)) hreal hH
    (s := Multiplicative.ofAdd (fun _ : Fin 2 ⊕ Fin 2 => (1 : K)))
    (Subgroup.mem_top _) hs

theorem barSub_ne_bot_of_g2Natural {W : Type} [CommGroup W] [Finite W]
    {H : Subgroup (MulAut W)} {f : ℕ}
    (h : CFSG.Quasithin.G2Natural H ⊤ (CFSG.Quasithin.fixV H) f) : H ≠ ⊥ := by
  intro hH
  obtain ⟨K, hKfield, hKfin, hKcard, π, hreal⟩ := h
  letI := hKfield
  let x : CFSG.Open.quasithinZorn K := (0, fun _ => 1, fun _ => 0, 0)
  have hxO : x ∈ CFSG.Quasithin.zornO0 K := by
    show x.1 + x.2.2.2 = 0
    simp [x]
  have hxR : (Multiplicative.ofAdd x : Multiplicative (CFSG.Open.quasithinZorn K)) ∉
      CFSG.Quasithin.zornR K := by
    rintro ⟨c, hc⟩
    have h2 : x = (c, 0, 0, c) := Multiplicative.ofAdd.injective hc
    have h3 := congrArg (fun y : CFSG.Open.quasithinZorn K => y.2.1) h2
    have h4 := congrFun h3 0
    simp [x] at h4
  exact false_of_realizesVia_fixV_eq_top
    (D := CFSG.Quasithin.FFModel.zornQ (CFSG.Open.quasithinG2 K)) hreal hH
    (s := Multiplicative.ofAdd x) hxO hxR

theorem exists_not_mem_fixV_of_ne_bot {W : Type} [CommGroup W]
    {H : Subgroup (MulAut W)}
    (hH : H ≠ ⊥) : ∃ u : W, u ∉ CFSG.Quasithin.fixV H := by
  by_contra h
  push Not at h
  apply hH
  ext x
  constructor
  · intro hx
    ext w
    exact h w x hx
  · intro hx
    rw [Subgroup.mem_bot] at hx
    rw [hx]
    exact H.one_mem

theorem exists_pElement_centVec_of_pointStabilizer {W : Type} [CommGroup W] [Finite W]
    {H : Subgroup (MulAut W)} {p : ℕ} (hp : p.Prime) (hH : H ≠ ⊥)
    (hpoint : ∀ u : W, u ∉ CFSG.Quasithin.fixV H →
      p ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.piSet (centVec H u))
    (w : W) :
    ∃ xbar : ↥H, (xbar : MulAut W) ∈ centVec H w ∧ orderOf xbar = p := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hget : ∀ u : W, u ∉ CFSG.Quasithin.fixV H →
      ∃ xbar : ↥H, (xbar : MulAut W) ∈ centVec H u ∧ orderOf xbar = p := by
    intro u hu
    have hpi := hpoint u hu
    obtain ⟨x, hxord⟩ := exists_prime_orderOf_dvd_card' p hpi.2
    refine ⟨⟨(x : MulAut W), (centVec.le H u) x.2⟩, x.2, ?_⟩
    rw [Subgroup.orderOf_mk, Subgroup.orderOf_coe, hxord]
  by_cases hw : w ∈ CFSG.Quasithin.fixV H
  · obtain ⟨u, hu⟩ := exists_not_mem_fixV_of_ne_bot hH
    obtain ⟨xbar, -, hxbarord⟩ := hget u hu
    refine ⟨xbar, ?_, hxbarord⟩
    rw [centVec.mem_centVec]
    exact ⟨xbar.2, (CFSG.Quasithin.mem_fixV.1 hw) xbar xbar.2⟩
  · exact hget w hw

theorem two_le_pRank_of_pointStabilizer {D : Data G} {V₀ V : Subgroup G} {p : ℕ}
    {L : Subgroup G} (h : Hyp18 D V₀ V p L)
    (hX1 : barSub V₀ V h.hyp125.isElemAbelian L ≠ ⊥)
    (hsimple : IsSimpleGroup (Bar2 L))
    (hpa : p ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.piSet
      (D.M ⊓ centralizer (V : Set G)))
    {v : G} (hv : v ∈ V)
    (hw : ∃ xbar : ↥(barSub V₀ V h.hyp125.isElemAbelian L),
      (xbar : MulAut (Vtil V₀ V h.hyp125.isElemAbelian)) ∈
        centVec (barSub V₀ V h.hyp125.isElemAbelian L)
          (tilOf V₀ V h.hyp125.isElemAbelian v hv) ∧ orderOf xbar = p) :
    2 ≤ CFSG.Open.pRank p (D.M ⊓ centralizer ({v} : Set G)) := by
  classical
  have hV := h.hyp125.isElemAbelian
  have hp : p.Prime := (D.sig_prime p h.hp).1
  have hp2 : p ≠ 2 := (D.sig_prime p h.hp).2
  haveI : Fact p.Prime := ⟨hp⟩
  set S : Subgroup (MulAut (Vtil V₀ V hV)) := barSub V₀ V hV L with hSdef
  have hLS : L ≤ stabTil V₀ V :=
    h.hL.1.1.le.trans
      (le_stabTil h.hyp125.pairFacts.le_normalizer h.hyp125.pairFacts.le_normalizer₀)
  let φ : ↥L →* ↥S :=
    ((actTil V₀ V hV).comp (Subgroup.inclusion hLS)).codRestrict S
      (fun x => actTil_mem_barSub V₀ V hV x.2 (hLS x.2))
  have hφsurj : Function.Surjective φ := by
    intro y
    obtain ⟨g, hgL, hgy⟩ := (mem_barSub V₀ V hV L (y : MulAut _)).1 y.2
    exact ⟨⟨(g : G), hgL⟩, Subtype.ext (by
      change actTil V₀ V hV ⟨(g : G), hLS hgL⟩ = (y : MulAut _)
      rw [← hgy])⟩
  have hker2 : IsPGroup 2 φ.ker := by
    refine (CFSG.pCore_isPGroup (p := 2) (G := ↥L)).to_le ?_
    intro x hx
    rw [MonoidHom.mem_ker] at hx
    have hact : actTil V₀ V hV ⟨(x : G), hLS x.2⟩ = 1 := by
      have hx' := congrArg Subtype.val hx
      dsimp [φ] at hx'
      exact hx'
    have hxpc : (x : G) ∈ pCoreOf 2 L :=
      mem_pCoreOf_of_actTil_eq_one h.hyp125 h.hL.1.1 hsimple hX1 x.2 (hLS x.2) hact
    obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.1 hxpc
    have hyx' : y = x := Subtype.ext hyx
    simpa [hyx'] using hy
  obtain ⟨xbar, hxbarC, hxbarord⟩ := hw
  obtain ⟨y, hyφ⟩ := hφsurj xbar
  obtain ⟨a, m, hm_odd, hm⟩ := Nat.exists_eq_two_pow_mul_odd (orderOf_pos y).ne'
  let x : ↥L := y ^ 2 ^ a
  have hxord_m : orderOf x = m := by
    dsimp [x]
    rw [CFSG.GH74.GLS.IVK.orderOf_pow_two_part y hm]
  have hφx : φ x = xbar ^ 2 ^ a := by rw [map_pow, hyφ]
  have hφxord : orderOf (φ x) = p := by
    rw [hφx, orderOf_pow' _ (pow_ne_zero _ two_ne_zero), hxbarord,
      Nat.coprime_iff_gcd_eq_one.mp
        (Nat.Coprime.pow_right a (Nat.coprime_two_right.mpr (hp.odd_of_ne_two hp2))),
      Nat.div_one]
  have hmapord : orderOf (φ x) = orderOf x :=
    CFSG.Quasithin.Vol2.Ch10.SecB.C11AmS.orderOf_map_eq_of_odd φ hker2 (hxord_m ▸ hm_odd)
  have hm_eq_p : m = p := by omega
  have hxordp : orderOf x = p := by rw [hxord_m, hm_eq_p]
  have hxbarpow : ((xbar : MulAut (Vtil V₀ V hV)) ^ 2 ^ a) ∈
      centVec S (tilOf V₀ V hV v hv) := (centVec S _).pow_mem hxbarC _
  have hφxmem : ((φ x : ↥S) : MulAut (Vtil V₀ V hV)) ∈
      centVec S (tilOf V₀ V hV v hv) := by
    simpa [hφx] using hxbarpow
  have hφxfix : ((φ x : ↥S) : MulAut (Vtil V₀ V hV)) (tilOf V₀ V hV v hv) =
      tilOf V₀ V hV v hv :=
    centVec.apply_eq hφxmem
  have hxfix : actTil V₀ V hV ⟨(x : G), hLS x.2⟩ (tilOf V₀ V hV v hv) =
      tilOf V₀ V hV v hv := by
    change ((φ x : ↥S) : MulAut (Vtil V₀ V hV)) (tilOf V₀ V hV v hv) =
      tilOf V₀ V hV v hv
    exact hφxfix
  have hxMv : (x : G) ∈ D.M ⊓ centralizer ({v} : Set G) := by
    refine ⟨h.hL.1.1.le x.2, ?_⟩
    change (x : G) ∈ Subgroup.centralizer ({v} : Set G)
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    rw [Set.mem_singleton_iff] at hw
    subst w
    have hfx := fixes_of_actTil_tilOf_eq_of_odd hV h.hyp125.pairFacts.le
      ((mSub_le_one_iff h.hyp125.pairFacts.elemAbelian₀).1 h.small) (hLS x.2) hv hxfix
      (by rw [Subgroup.orderOf_coe, hxordp]; exact hp.odd_of_ne_two hp2)
    have h1 : (x : G) * v = v * (x : G) := by
      calc (x : G) * v = ((x : G) * v * (x : G)⁻¹) * (x : G) := by group
        _ = v * (x : G) := by rw [hfx]
    exact h1.symm
  set Hv : Subgroup G := D.M ⊓ centralizer ({v} : Set G) with hHvdef
  set N : Subgroup G := D.M ⊓ centralizer (V : Set G) with hNdef
  have hpaN : p ∣ Nat.card N := hpa.2
  have hNHv : N ≤ Hv := by
    refine inf_le_inf_left _ ?_
    exact Subgroup.centralizer_le (by
      intro w hw
      rw [Set.mem_singleton_iff] at hw
      exact hw ▸ hv)
  have hMnormC : D.M ≤ normalizer (centralizer (V : Set G) : Set G) :=
    CFSG.GroupTheory.FT63ChII.le_normalizer_centralizer h.hyp125.pairFacts.le_normalizer
  have hMN : D.M ≤ normalizer (N : Set G) := by
    refine (le_inf D.M.le_normalizer hMnormC).trans ?_
    exact Subgroup.inf_normalizer_le_normalizer_inf
  have hHvN : Hv ≤ normalizer (N : Set G) := inf_le_left.trans hMN
  have hNnormal : (N.subgroupOf Hv).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hNHv).2 hHvN
  have hφx_ne : φ x ≠ 1 := by
    intro h1
    have hord := hφxord
    rw [h1] at hord
    simp at hord
    exact hp.ne_one hord.symm
  have hactx_ne : actTil V₀ V hV ⟨(x : G), hLS x.2⟩ ≠ 1 := by
    intro h1
    apply hφx_ne
    exact Subtype.ext (by
      change ((φ x : ↥S) : MulAut (Vtil V₀ V hV)) = 1
      exact h1)
  have hxN : (x : G) ∉ N := by
    intro hxN
    apply hactx_ne
    rw [actTil_eq_one_iff]
    intro w hw
    have hcomm := Subgroup.mem_centralizer_iff.mp hxN.2 w hw
    have h1 : (x : G) * w * (x : G)⁻¹ * w⁻¹ = 1 := by rw [← hcomm]; group
    rw [h1]
    exact V₀.one_mem
  by_contra hrank
  push Not at hrank
  have hrank' : CFSG.Open.pRank p Hv ≤ 1 := by omega
  have hxordG : orderOf (x : G) = p := by rw [Subgroup.orderOf_coe, hxordp]
  have hxN' := CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.KPCov.mem_of_normal_of_dvd
    (K₀ := Hv) (H := N) hrank' hNHv hNnormal hpaN hxMv hxordG
  exact hxN hxN'

section CertifiedTransfer


theorem transfer_18_10 (D : Data G) {V₀ V : Subgroup G} {p : ℕ} {L : Subgroup G}
    (h : Hyp18 D V₀ V p L) (h1742 : S17.R17_42At D V₀ V)
    (hpia : Gap_18_10_piCV_a D V₀ V p L h) (hpib : Gap_18_10_piCV_b D V₀ V p L h)
    (hSp : K_18_10_Sp) (hG2 : K_18_10_G2) (h62 : P18_6_2 D V₀ V p L h)
    (hnot : ¬ ∃ n : ℕ,
      IsSUn ↥(barSub V₀ V h.hyp125.isElemAbelian (conjClosure D.M L)) 4 n ∨
        IsOmegaMinus ↥(barSub V₀ V h.hyp125.isElemAbelian (conjClosure D.M L)) 6 n ∨
        IsOmegaPlus ↥(barSub V₀ V h.hyp125.isElemAbelian (conjClosure D.M L)) 4 n) :
    ∀ v ∈ V, v ≠ 1 → 2 ≤ CFSG.Open.pRank p (D.M ⊓ centralizer ({v} : Set G)) := by
  intro v hv hv1
  have hV := h.hyp125.isElemAbelian
  have hp : p.Prime := (D.sig_prime p h.hp).1
  have hsub : ({v} : Set G) ⊆ (V : Set G) := by
    intro w hw
    rw [Set.mem_singleton_iff] at hw
    exact hw ▸ hv
  have hCV : D.M ⊓ centralizer (V : Set G) ≤ D.M ⊓ centralizer ({v} : Set G) :=
    inf_le_inf_left _ (Subgroup.centralizer_le hsub)
  by_cases hw0 : tilOf V₀ V hV v hv = 1
  ·
    have hv0 : v ∈ V₀ := by
      have h1 : (1 : Vtil V₀ V hV) = mkTil V₀ V hV (1 : CFSG.Quasithin.IntMod V hV) :=
        (map_one (mkTil V₀ V hV)).symm
      rw [tilOf, h1, mkTil_eq_iff] at hw0
      simp only [CFSG.Quasithin.IntMod.val_one, inv_one, mul_one] at hw0
      exact hw0
    have hcard2 : Nat.card V₀ = 2 := by
      refine le_antisymm
        ((mSub_le_one_iff h.hyp125.pairFacts.elemAbelian₀).1 h.small) ?_
      have h1 : 1 < Nat.card V₀ := by
        rw [Finite.one_lt_card_iff_nontrivial]
        exact ⟨⟨⟨v, hv0⟩, 1, fun h2 => hv1 (Subtype.ext_iff.mp h2)⟩⟩
      omega
    have hMcent : D.M ≤ centralizer ({v} : Set G) := by
      intro m hm
      rw [Subgroup.mem_centralizer_iff]
      intro w hw
      rw [Set.mem_singleton_iff] at hw
      subst w
      have hmv : m * v * m⁻¹ ∈ V₀ :=
        (Subgroup.mem_normalizer_iff.mp (h.hyp125.pairFacts.le_normalizer₀ hm) v).1 hv0
      obtain ⟨z, -, hzu⟩ := (Nat.card_eq_two_iff' (1 : V₀)).1 hcard2
      have e1 : (⟨m * v * m⁻¹, hmv⟩ : V₀) = z := by
        refine hzu _ ?_
        intro h1
        apply hv1
        have h2 : m * v * m⁻¹ = 1 := Subtype.ext_iff.mp h1
        have h3 : m * v = m * 1 := by
          calc m * v = (m * v * m⁻¹) * m := by group
            _ = 1 * m := by rw [h2]
            _ = m * 1 := by group
        exact mul_left_cancel h3
      have e2 : (⟨v, hv0⟩ : V₀) = z :=
        hzu _ (fun h1 => hv1 (Subtype.ext_iff.mp h1))
      have heq : m * v * m⁻¹ = v := Subtype.ext_iff.mp (e1.trans e2.symm)
      calc v * m = (m * v * m⁻¹) * m := by rw [heq]
        _ = m * v := by group
    have hHeq : D.M ⊓ centralizer ({v} : Set G) = D.M :=
      le_antisymm inf_le_left (le_inf le_rfl hMcent)
    rw [hHeq]
    exact D.sig_rank p h.hp
  ·
    have h62' := h62
    obtain ⟨f, hcases⟩ := h62'
    have hpa : p ∈ piSet (D.M ⊓ centralizer (V : Set G)) := hpia h62 hnot
    rcases hcases with hsp | hg2 | hsUn | hOm6 | hOp4 | hOm4 | hL2
    ·
      obtain ⟨hXL, hnof, hf1, hfodd, hcong, hk1, hmore⟩ :=
        isSp4_or_isG2_bar2_cong_more h h1742 (Or.inl hsp.1)
      have hsimpleC : IsSimpleGroup (Bar2 (conjClosure D.M L)) :=
        LieModel.isSimpleGroup_of_mem_classicalTags (by decide) hsp.1
      have hX1C : barSub V₀ V hV (conjClosure D.M L) ≠ ⊥ :=
        barSub_ne_bot_of_natSpn hsp.2
      obtain ⟨e⟩ := barSubBar2Equiv_conjClosure_of_isSimpleGroup h.hyp125 h.hL.1
        hsimpleC hX1C
      have hSpS : IsSp4 ↥(barSub V₀ V hV (conjClosure D.M L)) f :=
        LieModel.of_mulEquiv e hsp.1
      have hNatSpn : NatSpn (barSub V₀ V hV (conjClosure D.M L)) ⊤
          (CFSG.Quasithin.fixV (barSub V₀ V hV (conjClosure D.M L))) 4 f := hsp.2
      rw [hXL] at hSpS hNatSpn hX1C hsimpleC
      have hsimpleL : IsSimpleGroup (Bar2 L) := hsimpleC
      have hpoint : ∀ u : Vtil V₀ V hV, u ∉ CFSG.Quasithin.fixV (barSub V₀ V hV L) →
          p ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.piSet (centVec (barSub V₀ V hV L) u) := by
        intro u hu
        exact hSp (s15_Infra_vtil_sq_eq_one V₀ V hV) (barSub V₀ V hV L) f p hp hcong
          hSpS hNatSpn u hu
      obtain ⟨xbar, hxbarC, hxbarord⟩ :=
        exists_pElement_centVec_of_pointStabilizer hp hX1C hpoint (tilOf V₀ V hV v hv)
      exact two_le_pRank_of_pointStabilizer h hX1C hsimpleL hpa hv
        ⟨xbar, hxbarC, hxbarord⟩
    ·
      obtain ⟨hXL, hnof, hf1, hfodd, hcong, hk1, hmore⟩ :=
        isSp4_or_isG2_bar2_cong_more h h1742 (Or.inr hg2.1)
      have hf2 : 2 ≤ f := by
        have hadm := CFSG.Blueprint.LieModel.admissible hg2.1
        have h3 : 3 ≤ 2 ^ f := hadm.2.2.2
        rcases Nat.eq_zero_or_pos f with rfl | hfpos
        · norm_num at h3
        · have hf1' : f ≠ 1 := by
            rintro rfl
            norm_num at h3
          omega
      have hsimpleC : IsSimpleGroup (Bar2 (conjClosure D.M L)) :=
        (CFSG.LieType.Simplicity.fam_g2_simplicity (Bar2 (conjClosure D.M L)) 2 f
          (LieModel.chevalleyExceptionalModel hg2.1 (by decide))).2
      have hX1C : barSub V₀ V hV (conjClosure D.M L) ≠ ⊥ :=
        barSub_ne_bot_of_g2Natural hg2.2
      obtain ⟨e⟩ := barSubBar2Equiv_conjClosure_of_isSimpleGroup h.hyp125 h.hL.1
        hsimpleC hX1C
      have hG2S : IsG2 ↥(barSub V₀ V hV (conjClosure D.M L)) f :=
        LieModel.of_mulEquiv e hg2.1
      have hNatG2 : CFSG.Quasithin.G2Natural (barSub V₀ V hV (conjClosure D.M L)) ⊤
          (CFSG.Quasithin.fixV (barSub V₀ V hV (conjClosure D.M L))) f := hg2.2
      rw [hXL] at hG2S hNatG2 hX1C hsimpleC
      have hsimpleL : IsSimpleGroup (Bar2 L) := hsimpleC
      have hpoint : ∀ u : Vtil V₀ V hV, u ∉ CFSG.Quasithin.fixV (barSub V₀ V hV L) →
          p ∈ CFSG.LocalAnalysis.UniquenessCase.UC22.piSet (centVec (barSub V₀ V hV L) u) := by
        intro u hu
        exact hG2 (s15_Infra_vtil_sq_eq_one V₀ V hV) (barSub V₀ V hV L) f p hf2 hp hcong
          hG2S hNatG2 u hu
      obtain ⟨xbar, hxbarC, hxbarord⟩ :=
        exists_pElement_centVec_of_pointStabilizer hp hX1C hpoint (tilOf V₀ V hV v hv)
      exact two_le_pRank_of_pointStabilizer h hX1C hsimpleL hpa hv
        ⟨xbar, hxbarC, hxbarord⟩
    ·
      exact absurd ⟨f, Or.inl hsUn.1⟩ hnot
    ·
      exact absurd ⟨f, Or.inr (Or.inl hOm6.1)⟩ hnot
    ·
      exact absurd ⟨f, Or.inr (Or.inr hOp4.1)⟩ hnot
    ·
      exact le_trans (hpib h62 (Or.inl ⟨f, hOm4⟩))
        (CFSG.SectionRank.pRank_mono hp.one_lt hCV)
    ·
      exact le_trans (hpib h62 (Or.inr ⟨f, hL2.1, hL2.2⟩))
        (CFSG.SectionRank.pRank_mono hp.one_lt hCV)

theorem eighteen_ten (D : Data G) {V₀ V : Subgroup G} {p : ℕ} {L : Subgroup G}
    (h : Hyp18 D V₀ V p L) (h127 : R127 D) (h61 : UC6.R6_1 D)
    (h1742 : S17.R17_42At D V₀ V)
    (hSp : K_18_10_Sp) (hG2 : K_18_10_G2)
    (hpia : Gap_18_10_piCV_a D V₀ V p L h) (hpib : Gap_18_10_piCV_b D V₀ V p L h) :
    R18_10At D V₀ V p L h := by
  intro h62
  have h62' := h62
  unfold P18_6_2 at h62
  rcases h62 with ⟨f, hd | hd | hd | hd | hd | hd | hd⟩
  ·
    by_contra hconcl
    have hTI : CFSG.CGT.Timmesfeld75.IsTI V := by
      refine s16_TI_of_pRank D h61 h.hyp125.isElemAbelian h.hyp125.inCalV.2.2.1 ?_
      intro v hv hv1
      exact ⟨p, h.hp, transfer_18_10 D h h1742 hpia hpib hSp hG2 h62' hconcl v hv hv1⟩
    exact (twelve_nine D h127 h.hyp125).1 hTI
  ·
    by_contra hconcl
    have hTI : CFSG.CGT.Timmesfeld75.IsTI V := by
      refine s16_TI_of_pRank D h61 h.hyp125.isElemAbelian h.hyp125.inCalV.2.2.1 ?_
      intro v hv hv1
      exact ⟨p, h.hp, transfer_18_10 D h h1742 hpia hpib hSp hG2 h62' hconcl v hv hv1⟩
    exact (twelve_nine D h127 h.hyp125).1 hTI
  ·
    exact ⟨f, Or.inl hd.1⟩
  ·
    exact ⟨f, Or.inr (Or.inl hd.1)⟩
  ·
    exact ⟨f, Or.inr (Or.inr hd.1)⟩
  ·
    by_contra hconcl
    have hTI : CFSG.CGT.Timmesfeld75.IsTI V := by
      refine s16_TI_of_pRank D h61 h.hyp125.isElemAbelian h.hyp125.inCalV.2.2.1 ?_
      intro v hv hv1
      exact ⟨p, h.hp, transfer_18_10 D h h1742 hpia hpib hSp hG2 h62' hconcl v hv hv1⟩
    exact (twelve_nine D h127 h.hyp125).1 hTI
  ·
    by_contra hconcl
    have hTI : CFSG.CGT.Timmesfeld75.IsTI V := by
      refine s16_TI_of_pRank D h61 h.hyp125.isElemAbelian h.hyp125.inCalV.2.2.1 ?_
      intro v hv hv1
      exact ⟨p, h.hp, transfer_18_10 D h h1742 hpia hpib hSp hG2 h62' hconcl v hv hv1⟩
    exact (twelve_nine D h127 h.hyp125).1 hTI

