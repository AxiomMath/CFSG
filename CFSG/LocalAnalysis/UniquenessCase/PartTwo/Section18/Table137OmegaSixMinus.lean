theorem k_Table13_7_Omega6MinusOn_holds :
    ∀ {W : Type} [CommGroup W] [Finite W] (H : Subgroup (MulAut W)) (p n : ℕ),
      2 ≤ n → IsOmegaMinus ↥H 6 n → p.Prime → (2 : ℤ) ^ n ≡ -1 [ZMOD (p : ℤ)] →
        ∀ (W' : Subgroup W) (hW' : ∀ x ∈ H, ∀ s ∈ W', x s ∈ W'),
          NatOmegaMinus H W' ⊥ 6 n →
            ∀ (F : Type) [Field F] [Finite F] (b c : F), Nat.card F = 2 ^ n →
              (∀ s : F, s ^ 2 + b * s + c ≠ 0) →
                ∀ (ε : ↥H ≃* ↥(StatedOmega (StatedQuadMinus 3 F b c)))
                  (ψ : W' ≃* Multiplicative (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2 → F)),
                  NatCoordsOmegaMinusOn H W' hW' F b c ε ψ → ∀ v : W', v ≠ 1 →
                    (StatedQuadMinus 3 F b c
                          (Multiplicative.toAdd (ψ v)) = 0 →
                        IsL2 (Bar2 (Opp p (centVec H (v : W)))) (2 * n)) ∧
                      (StatedQuadMinus 3 F b c
                            (Multiplicative.toAdd (ψ v)) ≠ 0 →
                          IsSp4 (Bar2 (Opp p (centVec H (v : W)))) n) := by
  classical
  intro W _ _ H p n hn _ hp hcong W' hW' _ F _ _ b c hF hirr ε ψ hψ v hv
  have : CharP F 2 := CFSG.ABGLocalTools.SL2Facts.charP_of_card_eq_prime_pow Nat.prime_two hF
  have hn1 : 1 ≤ n := by omega
  set w : Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2 → F := Multiplicative.toAdd (ψ v) with hwdef
  have hiff : ∀ l : ↥H, (l : MulAut W) (v : W) = v ↔
      ((ε l : GL (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) F) :
        Matrix (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) F) *ᵥ w =
          w := by
    intro l
    have h1 := hψ l v
    constructor
    · intro h
      have hv' : (⟨(l : MulAut W) v, hW' l.1 l.2 v.1 v.2⟩ : W') = v := Subtype.ext h
      rw [hv'] at h1
      exact (congrArg Multiplicative.toAdd h1).symm
    · intro h
      have h2 : ψ ⟨(l : MulAut W) v, hW' l.1 l.2 v.1 v.2⟩ = ψ v := by
        rw [h1, h]
        rfl
      exact congrArg Subtype.val (ψ.injective h2)
  have hw0 : w ≠ 0 := by
    intro h0
    apply hv
    apply ψ.injective
    rw [map_one]
    exact congrArg Multiplicative.ofAdd h0
  have hpq : p ∣ Nat.card F + 1 := by
    rw [hF]
    exact CFSG.LocalAnalysis.UniquenessCase.UC22.P2214R.dvd_of_cong hcong
  have hodd : Odd (Nat.card F + 1) := by
    rw [hF]
    exact Even.add_one (Nat.even_pow.mpr ⟨even_two, by omega⟩)
  have hpodd : Odd p := Odd.of_dvd_nat hodd hpq
  obtain ⟨g₀, hg₀Ω, hg₀p, hg₀w, -⟩ := exists_fix_two hirr hF hn1 hp hpq w w
  let y : ↥(KTabC.vecStab (StatedOmega (StatedQuadMinus 3 F b c)).subtype w) :=
    ⟨⟨g₀, hg₀Ω⟩, mem_vecStab_subtype.mpr hg₀w⟩
  have hy : orderOf y = p := by
    show orderOf (⟨⟨g₀, hg₀Ω⟩, mem_vecStab_subtype.mpr hg₀w⟩ :
      ↥(KTabC.vecStab (StatedOmega (StatedQuadMinus 3 F b c)).subtype w)) = p
    rw [Subgroup.orderOf_mk, Subgroup.orderOf_mk, hg₀p]
  let eC := centVecEquivVecStab ε (v : W) w hiff
  refine ⟨fun hsing => ?_, fun hns => ?_⟩
  · obtain ⟨σ, hker, hle, hσodd⟩ := exists_vecStab_OmegaMinus6_sing_hom hn1 hF hirr hw0 hsing
    obtain ⟨hsimp, hcomm, hna⟩ :=
      CFSG.ComponentClassification.RankTwoClassical.isSimpleGroup_statedOmega_quadMinus_small
        (K := F) (n := 2) (Or.inl rfl) hirr
    have hZ : Subgroup.center ↥(StatedOmega (StatedQuadMinus 2 F b c)) = ⊥ := by
      rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal
          (Subgroup.center ↥(StatedOmega (StatedQuadMinus 2 F b c))) with h | h
      · exact h
      · exact absurd (fun a b => (Subgroup.mem_center_iff.mp (h ▸ Subgroup.mem_top a) b).symm) hna
    have hSq : CFSG.Open.IsQuasisimple ↥(StatedOmega (StatedQuadMinus 2 F b c)) :=
      ⟨hcomm,
        ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).isSimpleGroup⟩
    have hS2 : CFSG.pCore 2 ↥(StatedOmega (StatedQuadMinus 2 F b c)) = ⊥ :=
      le_bot_iff.mp (hZ ▸ GL83.I243.pCore_le_center Nat.prime_two hSq)
    have hσy : σ y ∈ StatedOmega (StatedQuadMinus 2 F b c) :=
      hσodd y (Odd.of_dvd_nat hpodd (hy ▸ orderOf_map_dvd σ y))
    have hσy1 : σ y ≠ 1 := by
      intro h1
      obtain ⟨k, hk⟩ := hker ⟨y, h1⟩
      have hyk : y ^ (2 ^ k) = 1 := congrArg Subtype.val hk
      have hd := orderOf_dvd_of_pow_eq_one hyk
      rw [hy] at hd
      have := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp (hp.dvd_of_dvd_pow hd)
      rw [this] at hpodd
      exact absurd hpodd (by decide)
    let x : ↥(StatedOmega (StatedQuadMinus 2 F b c)) := ⟨σ y, hσy⟩
    have hx : x ∉ Subgroup.center ↥(StatedOmega (StatedQuadMinus 2 F b c)) := by
      rw [hZ, Subgroup.mem_bot]
      intro h1
      exact hσy1 (congrArg Subtype.val h1)
    have hxp : ∃ k : ℕ, orderOf x = p ^ k := by
      have hd : orderOf x ∣ p := by
        rw [Subgroup.orderOf_mk, ← hy]
        exact orderOf_map_dvd σ y
      rcases (Nat.dvd_prime hp).mp hd with h | h
      · exact ⟨0, by rw [h, pow_zero]⟩
      · exact ⟨1, by rw [h, pow_one]⟩
    have hker'' : IsPGroup 2 (σ.comp eC.toMonoidHom).ker := by
      have h := hker.comap_of_injective eC.toMonoidHom eC.injective
      rwa [MonoidHom.comap_ker] at h
    have hle' : StatedOmega (StatedQuadMinus 2 F b c) ≤ (σ.comp eC.toMonoidHom).range := by
      intro t ht
      obtain ⟨z, hz⟩ := hle ht
      exact ⟨eC.symm z, by simp [hz]⟩
    have hpS : ∀ d : ↥(centVec H (v : W)), (∃ k : ℕ, orderOf d = p ^ k) →
        (σ.comp eC.toMonoidHom) d ∈ StatedOmega (StatedQuadMinus 2 F b c) := by
      rintro d ⟨k, hk⟩
      refine hσodd _ (Odd.of_dvd_nat (hpodd.pow (n := k)) ?_)
      rw [← hk, ← MulEquiv.orderOf_eq eC d]
      exact orderOf_map_dvd σ _
    obtain ⟨e'⟩ := nonempty_bar2_opp_equiv_of_le_range hp (centVec H (v : W))
      (σ.comp eC.toMonoidHom) hker'' hle' hpS hSq hS2 hx hxp
    exact CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p22d_isL2_of_omegaMinus4 hn1 hF b c hirr e'
  · obtain ⟨e4⟩ := exists_vecStab_OmegaMinus6_nonsing_equiv hn hF hirr hns
    have h4 : 4 ≤ Nat.card F := by
      rw [hF]
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
    have hq := CFSG.LieType.Universal.Symplectic.isQuasisimple 2 F (by norm_num)
      (Or.inl (Or.inr h4))
    have hSq : CFSG.Open.IsQuasisimple ↥(StatedSp 2 F) := ⟨hq.1.commutator_eq_top, hq.2.1⟩
    have hZ : Subgroup.center ↥(StatedSp 2 F) = ⊥ :=
      CFSG.Timmesfeld.Transvection.center_statedSp_eq_bot (K := F) (n := 2) (by norm_num)
    have hS2 : CFSG.pCore 2 ↥(StatedSp 2 F) = ⊥ :=
      le_bot_iff.mp (hZ ▸ GL83.I243.pCore_le_center Nat.prime_two hSq)
    have hx : e4 y ∉ Subgroup.center ↥(StatedSp 2 F) := by
      rw [hZ, Subgroup.mem_bot]
      intro h1
      have := congrArg orderOf h1
      rw [MulEquiv.orderOf_eq, hy, orderOf_one] at this
      exact hp.one_lt.ne' this
    obtain ⟨e'⟩ := nonempty_bar2_opp_centVec_equiv ε (v : W) w hiff e4.toMonoidHom e4.surjective
      (IsPGroup.ker_isPGroup_of_injective e4.injective) hSq hS2 hp hx
      ⟨1, by rw [pow_one, MulEquiv.orderOf_eq, hy]⟩
    exact CFSG.SeitzReduction.SymplecticPilot.lieModel_of_mulEquiv_statedSp e' hF le_rfl
      (fun h => by
        have h2 : n = 1 := congrArg Prod.snd h
        omega)

end CFSG.LocalAnalysis.UniquenessCase.PartTwo.S18
