private theorem o4pTwoNatIso_toAddMap_matHom_scalar (c : K) (hc : c ≠ 0) (v : ι → K) :
    toAddMap (matHom (Matrix.GeneralLinearGroup.scalar ι (Units.mk0 c hc))) v = c • v := by
  rw [matHom_apply, toAddMap_matAut, Matrix.GeneralLinearGroup.coe_scalar, Units.val_mk0,
    Matrix.scalar_apply, Matrix.diagonal_const_mulVec]

private theorem o4pTwoNatIso_commute_matHom_scalar {c : K} (hc : c ≠ 0)
    {g : MulAut (StdMod ι K)} (hg : IsSemilinear g (RingEquiv.refl K)) :
    matHom (Matrix.GeneralLinearGroup.scalar ι (Units.mk0 c hc)) * g =
      g * matHom (Matrix.GeneralLinearGroup.scalar ι (Units.mk0 c hc)) := by
  obtain ⟨A, rfl⟩ := exists_matAut_of_mem_linSub (mem_linSub.mpr hg)
  rw [← matHom_apply A, ← map_mul, ← map_mul,
    Matrix.GeneralLinearGroup.scalar_commute]

private theorem o4pTwoNatIso_matHom_scalar_mem_natNorm {Γ : Subgroup (GL ι K)} {c : K}
    (hc : c ≠ 0) :
    matHom (Matrix.GeneralLinearGroup.scalar ι (Units.mk0 c hc)) ∈ natNorm Γ := by
  rw [natNorm]
  refine Subgroup.centralizer_le_normalizer
    (natImage Γ : Set (MulAut (StdMod ι K))) ?_
  refine Subgroup.mem_centralizer_iff.mpr fun g hg => ?_
  obtain ⟨γ, rfl⟩ := hg
  exact (o4pTwoNatIso_commute_matHom_scalar hc (isSemilinear_matAut (γ : GL ι K))).symm

private theorem omegaPlusTwoNatIso_aux (K : Type) [Field K] [Finite K] [CharP K 2]
    {W : Type} [CommGroup W] [Finite W]
    {X H : Subgroup (MulAut W)} (hXH : X ≤ H)
    (hHN : H ≤ Subgroup.normalizer (X : Set (MulAut W)))
    (hK4 : Nat.card K = 4)
    {π : ↥(StatedOmega (StatedQuadPlus 2 K)) →* ↥X}
    (hsum : SumOfNatVia (FFModel.nat (StatedOmega (StatedQuadPlus 2 K))) X ⊤ ⊥ 2 π)
    {w : MulAut W} (hwH : w ∈ H) (hw1 : w ≠ 1) (hw2 : w ^ 2 = 1)
    (hm : E3.mQuot ⊤ (CFSG.Quasithin.fixV (Subgroup.zpowers w)) = 4) :
    (∀ c ∈ H ⊓ Subgroup.centralizer (X : Set (MulAut W)), c * w = w * c) ∧
    5 ∣ Nat.card ↥(X ⊓ Subgroup.centralizer ({w} : Set (MulAut W))) ∧
    ∀ y ∈ H, (∀ v ∈ CFSG.Quasithin.fixV (Subgroup.zpowers w), y v = v) → y = 1 ∨ y = w := by
  classical
  let ι : Type := Fin 2 ⊕ Fin 2
  let Γ : Subgroup (GL ι K) := StatedOmega (StatedQuadPlus 2 K)
  have h4 : 4 ≤ Nat.card K := by omega
  have hK2 : Nat.card K = 2 ^ 2 := by rw [hK4]; norm_num
  have hΓ : HasScalarCommutant Γ := hasScalarCommutant_statedOmegaPlus h4
  have hsum' : SumOfNatVia (FFModel.nat Γ) X ⊤ ⊥ 2 π := hsum
  obtain ⟨J, φ, hrealJ, he, hcoordJ⟩ := exists_coords_of_sumOfNatVia Γ hsum'
  have hπsurj : Function.Surjective π := (hrealJ 0).1
  let X' : Subgroup (MulAut (StdMod (Fin 2 × ι) K)) := natImage (diagSub 2 Γ)
  let H' : Subgroup (MulAut (StdMod (Fin 2 × ι) K)) := H.map (congrHom φ)
  have hXmap : X.map (congrHom φ) = X' := map_congrHom_eq_natImage_diag Γ hπsurj φ he
  have hX'leH' : X' ≤ H' := by
    rw [← hXmap]
    exact Subgroup.map_mono hXH
  have hH'leN : H' ≤ natNorm (diagSub 2 Γ) := by
    have hmapN : (Subgroup.normalizer (X : Set (MulAut W))).map (congrHom φ) =
        Subgroup.normalizer (X.map (congrHom φ) :
          Set (MulAut (StdMod (Fin 2 × ι) K))) := by
      simpa [congrHom] using Subgroup.map_equiv_normalizer_eq X (MulAut.congr φ)
    have hmap : H.map (congrHom φ) ≤
        (Subgroup.normalizer (X : Set (MulAut W))).map (congrHom φ) :=
      Subgroup.map_mono hHN
    rw [hmapN, hXmap] at hmap
    exact hmap
  let T : MulAut (StdMod (Fin 2 × ι) K) := congrHom φ w
  have hTH : T ∈ H' := Subgroup.mem_map_of_mem (congrHom φ) hwH
  have hTN : T ∈ natNorm (diagSub 2 Γ) := hH'leN hTH
  have hT2 : T ^ 2 = 1 := by
    change congrHom φ w ^ 2 = 1
    rw [← map_pow, hw2, map_one]
  have hTne : T ≠ 1 := by
    intro h
    have h' : congrHom φ w = congrHom φ 1 := by
      change T = congrHom φ 1
      rw [h, map_one]
    exact hw1 (congrHom_injective φ h')
  have hzT : (Subgroup.zpowers w).map (congrHom φ) = Subgroup.zpowers T := by
    rw [MonoidHom.map_zpowers]
  have hrkT : rkIdx (fixV (Subgroup.zpowers T)) = 4 := by
    rw [← hzT, rkIdx_fixV_map_congrHom, ← CFSG.GroupTheory.mQuot_top_eq_rkIdx]
    exact hm
  obtain ⟨A, σ, B, hAN, hAsemi, hTsemi, hTform, hconj⟩ :=
    exists_of_mem_normalizer_diag (k := 2) (ι := ι) (Γ := Γ) hΓ hTN
  have hσ : σ = RingEquiv.refl K := by
    by_contra hσne
    have h2 := (rkIdx_fixV_of_semilinear_two (ι := Fin 2 × ι) (n := 2)
      (by norm_num) hK2 hTsemi hσne hT2).2
    have hcard : Fintype.card (Fin 2 × ι) = 8 := by simp [ι]
    rw [hcard, hrkT] at h2
    omega
  have hAlin : IsSemilinear A (RingEquiv.refl K) := by
    rw [hσ] at hAsemi
    exact hAsemi
  have hBscalar : ∃ c : K, (B : Matrix (Fin 2) (Fin 2) K) = c • 1 := by
    by_contra h
    push Not at h
    have hbig := le_rkIdx_fixV_of_nonscalar (ι := ι) (n := 2) (k := 2) hK2
      hAlin hTform (B := (B : Matrix (Fin 2) (Fin 2) K)) h
    have hcard : Fintype.card ι = 4 := by simp [ι]
    rw [hcard, hrkT] at hbig
    omega
  obtain ⟨c, hBc⟩ := hBscalar
  have hc0 : c ≠ 0 := by
    intro hc
    have hB0 : (B : Matrix (Fin 2) (Fin 2) K) = 0 := by simpa [hc] using hBc
    have hmul : (B : Matrix (Fin 2) (Fin 2) K) *
        ((B⁻¹ : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) = 1 :=
      Units.mul_inv B
    rw [hB0, Matrix.zero_mul] at hmul
    exact one_ne_zero hmul.symm
  let sm : MulAut (StdMod ι K) :=
    matHom (Matrix.GeneralLinearGroup.scalar ι (Units.mk0 c hc0))
  have hsm : ∀ v : ι → K, toAddMap sm v = c • v := o4pTwoNatIso_toAddMap_matHom_scalar c hc0
  let a : MulAut (StdMod ι K) := sm * A
  have hsmA : sm * A = A * sm := o4pTwoNatIso_commute_matHom_scalar hc0 hAlin
  have hAlin' : IsSemilinear a (RingEquiv.refl K) := by
    intro c' v
    change toAddMap sm (toAddMap A (c' • v)) = c' • toAddMap sm (toAddMap A v)
    rw [hAlin c' v, hsm, hsm, smul_comm]
    simp
  have hsumB : ∀ (v : Fin 2 × ι → K) (p : Fin 2 × ι),
      (fun i => ∑ j, (B : Matrix (Fin 2) (Fin 2) K) p.1 j * v (j, i)) =
        c • (fun i => v (p.1, i)) := by
    intro v p
    funext i
    rw [hBc, Finset.sum_eq_single p.1]
    · simp [Pi.smul_apply, smul_eq_mul]
    · intro j _ hj
      simp [Matrix.smul_apply, Matrix.one_apply, hj, Ne.symm hj]
    · intro hp
      exact (hp (Finset.mem_univ _)).elim
  have hTdiag : ∀ (v : Fin 2 × ι → K) (p : Fin 2 × ι),
      toAddMap T v p = toAddMap a (fun i => v (p.1, i)) p.2 := by
    intro v p
    rw [hTform v p, hsumB v p, hAlin]
    change c • toAddMap A (fun i => v (p.1, i)) p.2 =
      toAddMap (sm * A) (fun i => v (p.1, i)) p.2
    rw [toAddMap_mul, hsm]
    rfl
  let S := stdOmegaModel (K := K) h4
  have hlinS : ∀ (c' : K) (w : StdMod ι K),
      a (S.smul c' w) = S.smul c' (a w) := by
    intro c' w
    change a (Multiplicative.ofAdd (c' • Multiplicative.toAdd w)) =
      Multiplicative.ofAdd (c' • Multiplicative.toAdd (a w))
    exact congrArg Multiplicative.ofAdd (hAlin' c' (Multiplicative.toAdd w))
  obtain ⟨γa, hγa⟩ := S.exists_actHom_of_smul_comm hlinS
  have hγa' : matHom γa = a := by
    have h := hγa
    change S.actHom γa = a at h
    rw [stdOmegaModel.actHom] at h
    rwa [matHom_apply]
  have hTmat : T = matHom (diagGL 2 γa) := by
    apply toAddMap_injective
    intro v
    funext p
    rw [hTdiag, matHom_apply, toAddMap_matAut, diagGL_mulVec]
    rw [← hγa', matHom_apply, toAddMap_matAut]
  have ha2 : a ^ 2 = 1 := by
    have h1 : matHom (diagGL 2 (γa ^ 2)) = 1 := by
      calc matHom (diagGL 2 (γa ^ 2)) = matHom ((diagGL 2 γa) ^ 2) := by rw [map_pow]
        _ = matHom (diagGL 2 γa) ^ 2 := by rw [map_pow]
        _ = T ^ 2 := by rw [← hTmat]
        _ = 1 := hT2
    have h2 : diagGL 2 (γa ^ 2) = 1 := by
      apply matHom_injective
      rw [map_one]
      exact h1
    have h3 : γa ^ 2 = 1 := diagGL_injective 2 (by simpa using h2)
    calc a ^ 2 = matHom γa ^ 2 := by rw [hγa']
      _ = matHom (γa ^ 2) := by rw [map_pow]
      _ = 1 := by rw [h3, map_one]
  have hrk : rkIdx (fixV (Subgroup.zpowers a)) = 2 := by
    have h := rkIdx_fixV_of_diag_formula (k := 2) (T := T) (A := a) hTdiag
    rw [hrkT] at h
    omega
  have ha_norm : a ∈ natNorm Γ := by
    rw [show a = sm * A from rfl]
    exact Subgroup.mul_mem _ (o4pTwoNatIso_matHom_scalar_mem_natNorm hc0) hAN
  obtain ⟨e, heQ, hae⟩ := exists_reflection_of_rkIdx_two (K := K) hK4 ha_norm hAlin' ha2 hrk
  have hconcl1 : ∀ c ∈ H ⊓ Subgroup.centralizer (X : Set (MulAut W)), c * w = w * c := by
    intro c hc
    obtain ⟨hcH, hcC⟩ := Subgroup.mem_inf.mp hc
    have hc'C : congrHom φ c ∈
        Subgroup.centralizer (X' : Set (MulAut (StdMod (Fin 2 × ι) K))) := by
      rw [Subgroup.mem_centralizer_iff]
      intro z hz
      rw [← hXmap] at hz
      obtain ⟨x, hxX, rfl⟩ := Subgroup.mem_map.mp hz
      have h1 := hcC x hxX
      rw [← map_mul, ← map_mul, h1]
    obtain ⟨B', hB'⟩ := (mem_centralizer_diag_iff (Γ := Γ) hΓ).mp hc'C
    have hcomm : congrHom φ c * T = T * congrHom φ c := by
      rw [hB', hTmat]
      rw [← matHom_apply (kronGL (ι := ι) 2 B')]
      rw [← map_mul, ← map_mul, kronGL_commute_diagGL 2 B' γa]
    have h1 : congrHom φ (c * w) = congrHom φ (w * c) := by
      rw [map_mul, map_mul]
      exact hcomm
    exact congrHom_injective φ h1
  have hconcl2 : 5 ∣ Nat.card ↥(X ⊓ Subgroup.centralizer ({w} : Set (MulAut W))) := by
    obtain ⟨η, hηΓ, hηord, hηe⟩ := exists_orderOf_five_fix (K := K) hK4 heQ
    have hQη : ∀ v : ι → K,
        StatedQuadPlus 2 K ((η : Matrix ι ι K) *ᵥ v) = StatedQuadPlus 2 K v :=
      fun v => CFSG.Quasithin.G11.SzG11S.Two.Om4.isometry_of_mem_omega
        (StatedQuadPlus 2 K) hηΓ v
    have hpolη : ∀ v : ι → K, polQ ((η : Matrix ι ι K) *ᵥ v) e = polQ v e := by
      intro v
      have hpol : ∀ v w : ι → K,
          polQ ((η : Matrix ι ι K) *ᵥ v) ((η : Matrix ι ι K) *ᵥ w) = polQ v w := by
        intro v w
        simp only [polQ, ← Matrix.mulVec_add, hQη]
      calc polQ ((η : Matrix ι ι K) *ᵥ v) e
          = polQ ((η : Matrix ι ι K) *ᵥ v) ((η : Matrix ι ι K) *ᵥ e) :=
            congrArg (fun z => polQ ((η : Matrix ι ι K) *ᵥ v) z) hηe.symm
        _ = polQ v e := hpol v e
    have ha_eta : a * matHom η = matHom η * a := by
      apply toAddMap_injective
      intro v
      funext i
      change toAddMap a (toAddMap (matHom η) v) i =
        toAddMap (matHom η) (toAddMap a v) i
      rw [hae, hae]
      simp only [matHom_apply, toAddMap_matAut]
      rw [hpolη v, Matrix.mulVec_add, Matrix.mulVec_smul, hηe]
    have hγa_eta : γa * η = η * γa := by
      apply matHom_injective
      rw [map_mul, map_mul, hγa']
      exact ha_eta
    let x : MulAut (StdMod (Fin 2 × ι) K) := matHom (diagGL 2 η)
    have hxX' : x ∈ X' := by
      exact ⟨⟨diagGL 2 η, Subgroup.mem_map_of_mem (diagGL 2) hηΓ⟩, rfl⟩
    have hxT : x * T = T * x := by
      rw [hTmat]
      change matHom (diagGL 2 η) * matHom (diagGL 2 γa) =
        matHom (diagGL 2 γa) * matHom (diagGL 2 η)
      have hd : diagGL 2 η * diagGL 2 γa = diagGL 2 γa * diagGL 2 η := by
        rw [← map_mul, ← map_mul]
        exact (congrArg (diagGL 2) hγa_eta).symm
      rw [show matHom (diagGL 2 η) * matHom (diagGL 2 γa) =
          matHom (diagGL 2 η * diagGL 2 γa) from
        (map_mul matHom (diagGL 2 η) (diagGL 2 γa)).symm,
        show matHom (diagGL 2 γa) * matHom (diagGL 2 η) =
          matHom (diagGL 2 γa * diagGL 2 η) from
        (map_mul matHom (diagGL 2 γa) (diagGL 2 η)).symm, hd]
    have hxord : orderOf x = 5 := by
      have h1 : orderOf (matHom (diagGL 2 η)) = orderOf (diagGL 2 η) :=
        orderOf_injective matHom matHom_injective _
      have h2 : orderOf (diagGL 2 η) = orderOf η :=
        orderOf_injective (diagGL 2) (diagGL_injective 2) _
      rw [show x = matHom (diagGL 2 η) from rfl, h1, h2, hηord]
    have hxX : x ∈ X.map (congrHom φ) := by rwa [hXmap]
    obtain ⟨x₀, hx₀X, hx₀eq⟩ := Subgroup.mem_map.mp hxX
    have hx₀ord : orderOf x₀ = 5 := by
      have h := orderOf_injective (congrHom φ) (congrHom_injective φ) x₀
      rw [hx₀eq, hxord] at h
      exact h.symm
    have hx₀w : x₀ * w = w * x₀ := by
      apply congrHom_injective φ
      rw [map_mul, map_mul, hx₀eq]
      exact hxT
    let K' : Subgroup (MulAut W) := X ⊓ Subgroup.centralizer ({w} : Set (MulAut W))
    have hx₀K' : x₀ ∈ K' := by
      refine Subgroup.mem_inf.mpr ⟨hx₀X, ?_⟩
      rw [Subgroup.mem_centralizer_singleton_iff]
      exact hx₀w
    have h5 := Subgroup.card_subgroup_dvd_card
      (Subgroup.zpowers (⟨x₀, hx₀K'⟩ : ↥K'))
    have hcard5 : Nat.card ↥(Subgroup.zpowers (⟨x₀, hx₀K'⟩ : ↥K')) = 5 := by
      rw [Nat.card_zpowers]
      rw [show orderOf (⟨x₀, hx₀K'⟩ : ↥K') = orderOf x₀ from by
        simpa using orderOf_injective (Subgroup.subtype K') Subtype.val_injective
          (⟨x₀, hx₀K'⟩ : ↥K')]
      exact hx₀ord
    rwa [hcard5] at h5
  have hconcl3 : ∀ y ∈ H, (∀ v ∈ CFSG.Quasithin.fixV (Subgroup.zpowers w), y v = v) →
      y = 1 ∨ y = w := by
    intro y hyH hyfix
    let Y : MulAut (StdMod (Fin 2 × ι) K) := congrHom φ y
    have hYH' : Y ∈ H' := Subgroup.mem_map_of_mem (congrHom φ) hyH
    have hYN : Y ∈ natNorm (diagSub 2 Γ) := hH'leN hYH'
    obtain ⟨A', σ', B', hA'N, hA'semi, hYTsemi, hYform, hYconj⟩ :=
      exists_of_mem_normalizer_diag (k := 2) (ι := ι) (Γ := Γ) hΓ hYN
    have hfixY : ∀ v : StdMod (Fin 2 × ι) K, T v = v → Y v = v := by
      intro v hv
      have hfixmap : fixV (Subgroup.zpowers T) =
          (fixV (Subgroup.zpowers w)).map φ.toMonoidHom := by
        rw [← hzT, fixV_map_congrHom]
      have hvT : v ∈ fixV (Subgroup.zpowers T) :=
        (CFSG.Quasithin.mem_fixV_zpowers_iff_apply).mpr hv
      rw [hfixmap] at hvT
      obtain ⟨u, hu, heu⟩ := Subgroup.mem_map.mp hvT
      have hyu := hyfix u hu
      calc Y v = φ (y (φ.symm v)) := congrHom_apply φ y v
        _ = φ (y u) := by
          rw [show φ.symm v = u from by
            apply φ.injective
            rw [MulEquiv.apply_symm_apply]
            exact heu.symm]
        _ = φ u := by rw [hyu]
        _ = v := heu
    have hTblock : ∀ (p : Fin 2) (x : ι → K), polQ x e = 0 →
        T (lineEmb (ι := ι) (Pi.single p (1 : K)) (Multiplicative.ofAdd x)) =
        lineEmb (ι := ι) (Pi.single p (1 : K)) (Multiplicative.ofAdd x) := by
      intro p x hx
      have hTdiag1 : ∀ (v : Fin 2 × ι → K) (r : Fin 2 × ι),
          toAddMap T v r = toAddMap a (fun i => ∑ j,
            (1 : Matrix (Fin 2) (Fin 2) K) r.1 j * v (j, i)) r.2 := by
        intro v r
        rw [hTdiag]
        congr 1
        funext i
        rw [Finset.sum_eq_single r.1]
        · simp
        · intro b _ hb
          simp [Matrix.one_apply, Ne.symm hb]
        · intro hr
          exact (hr (Finset.mem_univ _)).elim
      have hline := normalForm_lineEmb (k := 2) (T := T) (A := a)
        (σ := RingEquiv.refl K) hAlin' hTdiag1 (Pi.single p (1 : K))
        (Multiplicative.ofAdd x)
      rw [Matrix.one_mulVec] at hline
      rw [hline]
      have hax : a (Multiplicative.ofAdd x) = Multiplicative.ofAdd x := by
        have h := congrArg Multiplicative.ofAdd (hae x)
        rw [hx] at h
        simpa using h
      rw [hax]
      rfl
    have hcoord : ∀ (p q : Fin 2) (x : ι → K), polQ x e = 0 → ∀ i : ι,
        σ' (B' q p) * toAddMap A' x i =
          (Pi.single p (1 : K) : Fin 2 → K) q * x i := by
      intro p q x hx i
      have hYfix := hfixY _ (hTblock p x hx)
      have hform := normalForm_lineEmb (k := 2) (T := Y) (A := A') (σ := σ')
        hA'semi hYform (Pi.single p (1 : K)) (Multiplicative.ofAdd x)
      rw [hform] at hYfix
      have h1 := congrFun (congrArg Multiplicative.toAdd hYfix) (q, i)
      have hBu : (B' : Matrix (Fin 2) (Fin 2) K) *ᵥ
          (Pi.single p (1 : K) : Fin 2 → K) = fun j => B' j p := by
        funext j
        rw [Matrix.mulVec, dotProduct]
        rw [Finset.sum_eq_single p]
        · simp
        · intro b _ hb
          simp [Pi.single_eq_of_ne hb]
        · intro hp
          exact (hp (Finset.mem_univ p)).elim
      rw [lineEmb_toAdd, hBu, lineEmb_toAdd] at h1
      simpa [toAddMap, Pi.smul_apply, smul_eq_mul] using h1
    have he0 : e ≠ 0 := by
      intro h
      apply heQ
      rw [h]
      simp [StatedQuadPlus, CFSG.MatrixModel.plusQuadCore]
    have hA'e0 : toAddMap A' e ≠ 0 := by
      intro h
      exact he0 ((toAddMap_eq_zero_iff A' (v := e)).mp h)
    have hBoff : ∀ q p : Fin 2, q ≠ p → B' q p = 0 := by
      intro q p hqp
      obtain ⟨i, hi⟩ : ∃ i, toAddMap A' e i ≠ 0 := by
        by_contra h
        push Not at h
        exact hA'e0 (funext h)
      have h1 := hcoord p q e (by rw [polQ_self]) i
      rw [Pi.single_eq_of_ne hqp, zero_mul] at h1
      have h2 : σ' (B' q p) = 0 := (mul_eq_zero.mp h1).resolve_right hi
      exact σ'.injective (by rw [h2, map_zero])
    have hdiag : ∀ p : Fin 2, σ' (B' p p) • toAddMap A' e = e := by
      intro p
      funext i
      have h1 := hcoord p p e (by rw [polQ_self]) i
      rw [Pi.single_eq_same, one_mul] at h1
      simpa [toAddMap, Pi.smul_apply, smul_eq_mul] using h1
    have hσ' : σ' = RingEquiv.refl K := by
      ext c'
      obtain ⟨i, hi⟩ : ∃ i, e i ≠ 0 := by
        by_contra h
        push Not at h
        exact he0 (funext h)
      have h1 := hcoord 0 0 (c' • e)
        (by rw [polQ_smul_left, polQ_self, mul_zero]) i
      rw [Pi.single_eq_same, one_mul] at h1
      rw [hA'semi c' e] at h1
      have h2 := congrFun (hdiag 0) i
      have h3 : σ' (B' 0 0) * (σ' c' * toAddMap A' e i) = c' * e i := by
        simpa [toAddMap, Pi.smul_apply, smul_eq_mul] using h1
      have h4 : σ' (B' 0 0) * toAddMap A' e i = e i := by
        simpa only [Pi.smul_apply, smul_eq_mul] using h2
      have h5 : σ' c' * e i = c' * e i := by
        calc σ' c' * e i = σ' c' * (σ' (B' 0 0) * toAddMap A' e i) := by rw [h4]
          _ = σ' (B' 0 0) * (σ' c' * toAddMap A' e i) := by ring
          _ = c' * e i := h3
      exact mul_right_cancel₀ hi h5
    have hA'lin : IsSemilinear A' (RingEquiv.refl K) := by
      rw [hσ'] at hA'semi
      exact hA'semi
    let b : K := B' 0 0
    have hdiag' : ∀ p : Fin 2, B' p p • toAddMap A' e = e := by
      intro p
      simpa [hσ'] using hdiag p
    have hbk : ∀ p : Fin 2, B' p p = b := by
      intro p
      obtain ⟨i, hi⟩ : ∃ i, toAddMap A' e i ≠ 0 := by
        by_contra h
        push Not at h
        exact hA'e0 (funext h)
      have h1 := congrFun (hdiag' p) i
      have h0 := congrFun (hdiag' 0) i
      simp only [Pi.smul_apply, smul_eq_mul, b] at h1 h0
      exact mul_right_cancel₀ hi (h1.trans h0.symm)
    have hb0 : b ≠ 0 := by
      intro hb
      have hzero : e = 0 := by
        funext i
        have h0 := congrFun (hdiag' 0) i
        simp only [Pi.smul_apply, smul_eq_mul] at h0
        change b * toAddMap A' e i = e i at h0
        rw [hb, zero_mul] at h0
        simpa using h0.symm
      exact he0 hzero
    have hA'fix : ∀ x : ι → K, polQ x e = 0 → toAddMap A' x = b⁻¹ • x := by
      intro x hx
      have h1 : b • toAddMap A' x = x := by
        funext i
        have h := hcoord 0 0 x hx i
        rw [Pi.single_eq_same, one_mul] at h
        rw [hσ'] at h
        simpa only [b, RingEquiv.refl_apply, Pi.smul_apply, smul_eq_mul] using h
      calc toAddMap A' x = b⁻¹ • (b • toAddMap A' x) := by
            rw [smul_smul, inv_mul_cancel₀ hb0, one_smul]
        _ = b⁻¹ • x := by rw [h1]
    let bsm : MulAut (StdMod ι K) :=
      matHom (Matrix.GeneralLinearGroup.scalar ι (Units.mk0 b hb0))
    have hbsm : ∀ v : ι → K, toAddMap bsm v = b • v :=
      o4pTwoNatIso_toAddMap_matHom_scalar b hb0
    let ay : MulAut (StdMod ι K) := bsm * A'
    have haylin : IsSemilinear ay (RingEquiv.refl K) := by
      intro c' v
      change toAddMap bsm (toAddMap A' (c' • v)) = c' • toAddMap bsm (toAddMap A' v)
      rw [hA'lin c' v, hbsm, hbsm, smul_comm]
      simp
    have hB'val : (B' : Matrix (Fin 2) (Fin 2) K) =
        b • (1 : Matrix (Fin 2) (Fin 2) K) := by
      ext q p
      by_cases hqp : q = p
      · rw [hqp]
        simpa [Matrix.smul_apply, Matrix.one_apply, smul_eq_mul] using hbk p
      · rw [hBoff q p hqp]
        simp [Matrix.smul_apply, Matrix.one_apply, hqp]
    have hYdiag : ∀ (v : Fin 2 × ι → K) (r : Fin 2 × ι),
        toAddMap Y v r = toAddMap ay (fun i => v (r.1, i)) r.2 := by
      intro v r
      rw [hYform v r, hB'val]
      have hsum : (fun i => ∑ j, (b • (1 : Matrix (Fin 2) (Fin 2) K)) r.1 j *
          v (j, i)) = b • (fun i => v (r.1, i)) := by
        funext i
        rw [Finset.sum_eq_single r.1]
        · simp [Pi.smul_apply, smul_eq_mul]
        · intro j _ hj
          simp [Matrix.smul_apply, Matrix.one_apply, hj, Ne.symm hj]
        · intro hr
          exact (hr (Finset.mem_univ _)).elim
      rw [hsum, hA'lin]
      change b • toAddMap A' (fun i => v (r.1, i)) r.2 =
        toAddMap (bsm * A') (fun i => v (r.1, i)) r.2
      rw [toAddMap_mul, hbsm]
      rfl
    have hlinS2 : ∀ (c' : K) (w : StdMod ι K),
        ay (S.smul c' w) = S.smul c' (ay w) := by
      intro c' w
      change ay (Multiplicative.ofAdd (c' • Multiplicative.toAdd w)) =
        Multiplicative.ofAdd (c' • Multiplicative.toAdd (ay w))
      exact congrArg Multiplicative.ofAdd (haylin c' (Multiplicative.toAdd w))
    obtain ⟨γy, hγy⟩ := S.exists_actHom_of_smul_comm hlinS2
    have hγy' : matHom γy = ay := by
      have h := hγy
      change S.actHom γy = ay at h
      rw [stdOmegaModel.actHom] at h
      rwa [matHom_apply]
    have hay_norm : ay ∈ natNorm Γ := by
      rw [show ay = bsm * A' from rfl]
      exact Subgroup.mul_mem _ (o4pTwoNatIso_matHom_scalar_mem_natNorm hb0) hA'N
    have hfix_ay : ∀ x : ι → K, polQ x e = 0 → toAddMap ay x = x := by
      intro x hx
      rw [show ay = bsm * A' from rfl, toAddMap_mul, hbsm, hA'fix x hx,
        smul_smul, mul_inv_cancel₀ hb0, one_smul]
    have hcases := eq_one_or_reflection_of_fix (K := K) h4 hay_norm heQ hfix_ay
    rcases hcases with hay1 | hayrefl
    · left
      have hY1 : Y = 1 := by
        apply toAddMap_injective
        intro v
        funext r
        rw [hYdiag, hay1]
        rfl
      have h1 : congrHom φ y = congrHom φ 1 := by
        change Y = congrHom φ 1
        rw [hY1, map_one]
      exact congrHom_injective φ h1
    · right
      have hay_eq : ay = a := by
        apply toAddMap_injective
        intro v
        rw [hayrefl v, hae v]
      have hYT : Y = T := by
        apply toAddMap_injective
        intro v
        funext r
        rw [hYdiag, hTdiag, hay_eq]
      have h1 : congrHom φ y = congrHom φ w := hYT
      exact congrHom_injective φ h1
  exact ⟨hconcl1, hconcl2, hconcl3⟩

theorem k_OmegaPlusFour_twoNat_inv_of_isoMod {W : Type} [CommGroup W] [Finite W]
    (hW : ∀ w : W, w ^ 2 = 1) {X H : Subgroup (MulAut W)}
    (hXH : X ≤ H) (hHN : H ≤ Subgroup.normalizer (X : Set (MulAut W)))
    (hX : IsOmegaPlus ↥X 4 2)
    (hsum : SumOfNatIsoMod (fun H U Z => NatOmegaPlus H U Z 4 2) X ⊤ ⊥ 2)
    {w : MulAut W} (hwH : w ∈ H) (hw1 : w ≠ 1) (hw2 : w ^ 2 = 1)
    (hm : E3.mQuot ⊤ (CFSG.Quasithin.fixV (Subgroup.zpowers w)) = 4) :
    (∀ c ∈ H ⊓ Subgroup.centralizer (X : Set (MulAut W)), c * w = w * c) ∧
    5 ∣ Nat.card ↥(X ⊓ Subgroup.centralizer ({w} : Set (MulAut W))) ∧
    ∀ y ∈ H, (∀ v ∈ CFSG.Quasithin.fixV (Subgroup.zpowers w), y v = v) → y = 1 ∨ y = w := by
  classical
  obtain ⟨I, hZ, hind, hsup, hN, hiso⟩ := hsum
  obtain ⟨-, K, hKfield, hKfinite, hKcard, hreal⟩ := hN 0
  obtain ⟨π, hπ⟩ := hreal
  have hK4 : Nat.card K = 4 := by rw [hKcard]; norm_num
  have hchar : CharP K 2 :=
    CFSG.ABGLocalTools.SL2Facts.charP_of_card_eq_prime_pow (r := 2) (n := 2)
      Nat.prime_two (by rw [hK4]; norm_num)
  have hsumvia : SumOfNatVia (FFModel.nat (StatedOmega (StatedQuadPlus 2 K)))
      X ⊤ ⊥ 2 π := sumOfNatVia_of_isoMod hind hsup 0 hπ (fun i => hiso 0 i)
  exact @omegaPlusTwoNatIso_aux K hKfield hKfinite hchar W _ _
    X H hXH hHN hK4 π hsumvia w hwH hw1 hw2 hm

end CFSG.LocalAnalysis.UniquenessCase.PartTwo.S18
