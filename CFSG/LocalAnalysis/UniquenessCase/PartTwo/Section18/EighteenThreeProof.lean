theorem le_M_of_normalizer_wClos_le (D : Data G) {V S : Subgroup G} {i : ℕ}
    (hS2 : IsPGroup 2 S) (hWS : E3.wClos V i D.T ≤ S)
    (hN : normalizer (E3.wClos V i D.T : Set G) ≤ D.M) : S ≤ D.M := by
  have hTsyl : IsSylowIn 2 D.T D.M := CFSG.ABGLocalTools.isSylowOf_iff.mp D.sylowM
  set S₀ : Subgroup G := S ⊓ D.M with hS₀
  have hS0M : S₀ ≤ D.M := by
    rw [hS₀]
    exact inf_le_right
  have hS02 : IsPGroup 2 S₀ := by
    rw [hS₀]
    exact hS2.to_inf_left
  have hWS0 : E3.wClos V i D.T ≤ S₀ := by
    rw [hS₀]
    exact le_inf hWS ((E3.wClos_le i D.T).trans D.sylowM.le)
  have hN0 : normalizer (S₀ : Set G) ≤ normalizer (E3.wClos V i D.T : Set G) :=
    E3.e3_15_normalizer hTsyl hS0M hS02 hWS0
  have hN0M : normalizer (S₀ : Set G) ≤ D.M := hN0.trans hN
  have hNS : S ⊓ normalizer (S₀ : Set G) ≤ S₀ :=
    (le_inf inf_le_left (inf_le_right.trans hN0M)).trans hS₀.ge
  have hEq : S₀ = S := by
    refine le_antisymm ?_ ?_
    · rw [hS₀]
      exact inf_le_left
    · by_contra hnot
      have hlt : S₀ < S :=
        lt_of_le_of_ne (by rw [hS₀]; exact inf_le_left) (fun h => hnot h.ge)
      have hgrowth : S₀ < S ⊓ normalizer (S₀ : Set G) :=
        CFSG.GroupTheory.lt_inf_normalizer_of_isPGroup hS2 hlt
      exact absurd hNS (not_le_of_gt hgrowth)
  rw [← hEq, hS₀]
  exact inf_le_right

theorem A5Data18.exists_second_pair
    {D : Data G} {V₀ V L : Subgroup G} (c : A5Data18 D V₀ V L)
    (h1768 : S17.R17_68At D V₀ V) :
