theorem exists_conj_mem_bar_centralizer {J : Subgroup G} (hAlt : IsAlt (Bar2 J) 5)
    {x : G} (hxJ : x ∈ normalizer (J : Set G)) (hodd : Odd (orderOf x)) :
    ∃ j ∈ J, (j⁻¹ * x) ∈ normalizer (J : Set G) ∧
      ∀ a ∈ J, (j⁻¹ * x) * a * (j⁻¹ * x)⁻¹ * a⁻¹ ∈
        (CFSG.pCore 2 ↥J).map J.subtype := by
  let N : Subgroup ↥J := CFSG.pCore 2 ↥J
  let e₀ : (↥(⊤ : Subgroup ↥J) ⧸ N.subgroupOf ⊤) ≃* (↥J ⧸ N) :=
    QuotientGroup.congr (N.subgroupOf ⊤) N Subgroup.topEquiv
      (Subgroup.map_subgroupOf_eq_of_le le_top)
  obtain ⟨eA⟩ := hAlt
  let e : (↥(⊤ : Subgroup ↥J) ⧸ N.subgroupOf ⊤) ≃* alternatingGroup (Fin 5) := e₀.trans eA
  let β : MulAut ↥J := J.normalizerMonoidHom ⟨x, hxJ⟩
  have hβ : β ∈ L139A5.stb (⊤ : Subgroup ↥J) N := by
    refine L139A5.mem_stb_of_maps (fun a _ => Subgroup.mem_top _) ?_
    intro a ha
    show β a ∈ CFSG.pCore 2 ↥J
    have hmap := (Subgroup.characteristic_iff_map_eq.mp
      (CFSG.pCore_characteristic (p := 2) (G := ↥J))) β
    rw [← hmap]
    exact Subgroup.mem_map.mpr ⟨a, ha, rfl⟩
  have hoddβ : Odd (orderOf β) := by
    have hdiv : orderOf β ∣
        orderOf (⟨x, hxJ⟩ : ↥(Subgroup.normalizer (J : Set G))) :=
      orderOf_map_dvd (J.normalizerMonoidHom) ⟨x, hxJ⟩
    have hxord : orderOf (⟨x, hxJ⟩ : ↥(Subgroup.normalizer (J : Set G))) = orderOf x := by
      simpa using (Subgroup.orderOf_coe ⟨x, hxJ⟩).symm
    exact Odd.of_dvd_nat (hxord.symm ▸ hodd) hdiv
  obtain ⟨ℓ, hℓ, hspec⟩ := CFSG.GroupTheory.exists_inner_sec_of_odd_order e
    (le_top : N ≤ ⊤) hβ hoddβ
  refine ⟨((ℓ : ↥J) : G), (ℓ : ↥J).2, ?_, ?_⟩
  · have hjJ : ((ℓ : ↥J) : G) ∈ J := (ℓ : ↥J).2
    exact (Subgroup.normalizer (J : Set G)).mul_mem
      ((Subgroup.normalizer (J : Set G)).inv_mem (Subgroup.le_normalizer hjJ)) hxJ
  · intro a ha
    set j : G := ((ℓ : ↥J) : G) with hj
    set o : G := (x * a * x⁻¹)⁻¹ * (j * a * j⁻¹) with ho
    have hβcoe : ((β ⟨a, ha⟩ : ↥J) : G) = x * a * x⁻¹ := by
      show ((J.normalizerMonoidHom ⟨x, hxJ⟩ ⟨a, ha⟩ : ↥J) : G) = x * a * x⁻¹
      simp
    have hG : o ∈ N.map J.subtype := by
      let a' : ↥J := ⟨a, ha⟩
      have hspec' := hspec a' (Subgroup.mem_top _)
      refine Subgroup.mem_map.mpr ⟨(β a')⁻¹ * (ℓ * a' * ℓ⁻¹), hspec', ?_⟩
      show ((β a' : ↥J) : G)⁻¹ * ((ℓ * a' * ℓ⁻¹ : ↥J) : G) = o
      rw [hβcoe]
      rfl
    have hRnorm : ∀ g ∈ J, ∀ r ∈ N.map J.subtype, g * r * g⁻¹ ∈ N.map J.subtype := by
      intro g hg r hr
      obtain ⟨r', hr', rfl⟩ := Subgroup.mem_map.mp hr
      have hconj : (⟨g, hg⟩ : ↥J) * r' * (⟨g, hg⟩ : ↥J)⁻¹ ∈ N :=
        (CFSG.pCore_normal (p := 2) (G := ↥J)).conj_mem r' hr' ⟨g, hg⟩
      exact Subgroup.mem_map.mpr ⟨_, hconj, by simp [mul_assoc]⟩
    have hjJ : j ∈ J := (ℓ : ↥J).2
    have hinv : j⁻¹ * o⁻¹ * j ∈ N.map J.subtype := by
      simpa using hRnorm j⁻¹ (J.inv_mem hjJ) o⁻¹ (Subgroup.inv_mem _ hG)
    have hfin : a * (j⁻¹ * o⁻¹ * j) * a⁻¹ ∈ N.map J.subtype :=
      hRnorm a ha _ hinv
    have hxax : x * a * x⁻¹ = (j * a * j⁻¹) * o⁻¹ := by
      rw [ho]; group
    have heq : (j⁻¹ * x) * a * (j⁻¹ * x)⁻¹ * a⁻¹ =
        a * (j⁻¹ * o⁻¹ * j) * a⁻¹ := by
      have h1 : (j⁻¹ * x) * a * (j⁻¹ * x)⁻¹ = j⁻¹ * (x * a * x⁻¹) * j := by
        group
      rw [h1, hxax]
      group
    rw [heq]
    exact hfin

theorem opp_three_eq_of_isAlt_five {M J Y : Subgroup G} (hJY : J ≤ Y)
    (hJ : J ∈ calC M) (hAlt : IsAlt (Bar2 J) 5)
    (hN : Opp 3 Y ≤ normalizer (J : Set G))
    (h3 : CFSG.Open.pRank 3 (Opp 3 Y) ≤ 1) : Opp 3 Y = J := by
  have hJX : J ≤ Opp 3 Y :=
    (opp_three_eq_self_of_bar2 hJ (S19.isSimpleGroup_bar2_of_isAlt_five hAlt)
      (S19.three_dvd_bar2_of_isAlt hAlt)).ge.trans (s13_Thirteen2_pElementSubgroup_mono hJY)
  have hthree : ∀ x ∈ Opp 3 Y, (∃ k, orderOf x = 3 ^ k) → x ∈ J := by
    intro x hxX hxpow
    obtain ⟨k, hxord⟩ := hxpow
    have hxN : x ∈ normalizer (J : Set G) := hN hxX
    have hodd : Odd (orderOf x) := by
      rw [hxord]
      exact (show Odd 3 by norm_num).pow
    obtain ⟨j, hjJ, hcjN, hcent⟩ := exists_conj_mem_bar_centralizer hAlt hxN hodd
    set c : G := j⁻¹ * x with hc
    have hcX : c ∈ Opp 3 Y := by
      rw [hc]
      exact (Opp 3 Y).mul_mem ((Opp 3 Y).inv_mem (hJX hjJ)) hxX
    have hnot3 : ¬ 3 ∣ orderOf c := by
      intro h3dvd
      let R : Subgroup G := (CFSG.pCore 2 ↥J).map J.subtype
      have hRJ : R ≤ J := Subgroup.map_subtype_le _
      have hRpg : IsPGroup 2 R := (CFSG.pCore_isPGroup (p := 2) (G := ↥J)).map J.subtype
      have hXR : Opp 3 Y ≤ Subgroup.normalizer (R : Set G) := by
        have hconj_for : ∀ {h : G}, h ∈ Opp 3 Y → ∀ y ∈ R, h * y * h⁻¹ ∈ R := by
          intro h hh y hy
          obtain ⟨o, ho, rfl⟩ := Subgroup.mem_map.mp hy
          let α : MulAut ↥J := J.normalizerMonoidHom ⟨h, hN hh⟩
          have hfix : α o ∈ CFSG.pCore 2 ↥J := by
            have hmap := (Subgroup.characteristic_iff_map_eq.mp
              (CFSG.pCore_characteristic (p := 2) (G := ↥J))) α
            rw [← hmap]
            exact Subgroup.mem_map.mpr ⟨o, ho, rfl⟩
          refine Subgroup.mem_map.mpr ⟨α o, hfix, ?_⟩
          show ((α o : ↥J) : G) = h * ((o : ↥J) : G) * h⁻¹
          simp [α]
        intro g hg
        rw [Subgroup.mem_normalizer_iff]
        intro y
        constructor
        · intro hy
          exact hconj_for hg y hy
        · intro hy
          have := hconj_for ((Opp 3 Y).inv_mem hg) (g * y * g⁻¹) hy
          simpa [mul_assoc] using this
      have hRnormX : ∀ g ∈ Opp 3 Y, ∀ r ∈ R, g * r * g⁻¹ ∈ R := by
        intro g hg r hr
        exact (Subgroup.mem_normalizer_iff.mp (hXR hg) r).mp hr
      obtain ⟨m, hm⟩ := h3dvd
      have hmpos : 0 < m := by
        have := orderOf_pos c
        omega
      set c' : G := c ^ m with hc'
      have hc'ord : orderOf c' = 3 := by
        rw [hc', orderOf_pow' c hmpos.ne', hm]
        rw [Nat.gcd_mul_left_left, Nat.mul_div_cancel 3 hmpos]
      have hc'X : c' ∈ Opp 3 Y := (Opp 3 Y).pow_mem hcX m
      have hcent_pow : ∀ n : ℕ, ∀ a ∈ J, (c^n) * a * (c^n)⁻¹ * a⁻¹ ∈ R := by
        intro n
        induction n with
        | zero => intro a ha; simp
        | succ n ih =>
            intro a ha
            set r : G := (c^n * a * (c^n)⁻¹) * a⁻¹ with hr
            have hrR : r ∈ R := ih a ha
            have hcr : c * r * c⁻¹ ∈ R := hRnormX c hcX r hrR
            have hca : c * a * c⁻¹ * a⁻¹ ∈ R := hcent a ha
            have h2 : c^n * a * (c^n)⁻¹ = r * a := by rw [hr]; group
            have hEq : c^(n+1) * a * (c^(n+1))⁻¹ * a⁻¹ =
                (c * r * c⁻¹) * (c * a * c⁻¹ * a⁻¹) := by
              rw [pow_succ']
              have h3 : c * c^n * a * (c * c^n)⁻¹ =
                  c * (c^n * a * (c^n)⁻¹) * c⁻¹ := by group
              rw [h3, h2]
              group
            rw [hEq]
            exact R.mul_mem hcr hca
      have hcent_pow_inv : ∀ n : ℕ, ∀ a ∈ J, ((c^n)⁻¹) * a * (c^n) * a⁻¹ ∈ R := by
        intro n a ha
        have h := hcent_pow n a ha
        have hinv : a * (c^n) * a⁻¹ * (c^n)⁻¹ ∈ R := by
          have h' := R.inv_mem h
          convert h' using 1
          group
        have hcnX : c^n ∈ Opp 3 Y := (Opp 3 Y).pow_mem hcX n
        have hconj := hRnormX (c^n)⁻¹ ((Opp 3 Y).inv_mem hcnX) _ hinv
        have heq : ((c^n)⁻¹) * a * (c^n) * a⁻¹ =
            (c^n)⁻¹ * (a * (c^n) * a⁻¹ * (c^n)⁻¹) * (c^n) := by group
        rw [heq]
        simpa using hconj
      have hcent_c'_zpow : ∀ jj : ℤ, ∀ a ∈ J, (c'^jj) * a * (c'^jj)⁻¹ * a⁻¹ ∈ R := by
        intro jj a ha
        rcases Int.eq_nat_or_neg jj with ⟨n, rfl | rfl⟩
        · rw [zpow_natCast, hc', ← pow_mul]
          exact hcent_pow (m * n) a ha
        · rw [zpow_neg, zpow_natCast, hc', ← pow_mul]
          simpa using hcent_pow_inv (m * n) a ha
      have hnat_dvd : ∀ {y : G}, orderOf y = 3 → ∀ n : ℕ, y^n ∈ R → 3 ∣ n := by
        intro y hyord n hnR
        have horddvd : orderOf (y^n) ∣ 3 :=
          (orderOf_pow_dvd n).trans (by rw [hyord])
        obtain ⟨r, hr⟩ := (IsPGroup.iff_orderOf.mp hRpg) ⟨y^n, hnR⟩
        have hr' : orderOf (y^n) = 2 ^ r := by simpa using hr
        have h2r : 2 ^ r ∣ 3 := hr' ▸ horddvd
        have h2r1 : 2 ^ r = 1 := by
          rcases Nat.eq_zero_or_pos r with h0 | hpos
          · rw [h0, pow_zero]
          · exfalso
            have h2dvd : 2 ∣ 3 := (dvd_pow_self 2 hpos.ne').trans h2r
            norm_num at h2dvd
        have hy1 : y^n = 1 := by
          apply orderOf_eq_one_iff.mp
          rw [hr', h2r1]
        have := orderOf_dvd_of_pow_eq_one hy1
        rwa [hyord] at this
      have hz_dvd : ∀ {y : G}, orderOf y = 3 → ∀ i : ℤ, y^i ∈ R → (3:ℤ) ∣ i := by
        intro y hyord i hiR
        rcases Int.eq_nat_or_neg i with ⟨n, rfl | rfl⟩
        · exact Int.natCast_dvd_natCast.mpr (hnat_dvd hyord n (by simpa using hiR))
        · have hnR : y^n ∈ R := by
            have h := R.inv_mem hiR
            simpa [zpow_neg, zpow_natCast] using h
          exact dvd_neg.mpr (Int.natCast_dvd_natCast.mpr (hnat_dvd hyord n hnR))
      have hAltQ : CFSG.Quasithin.IsAlt 5 (ModO2 J) := hAlt
      obtain ⟨a₀, ha₀J, ha₀ord⟩ := Q9.exists_orderOf_three_of_isAlt_five hAltQ
      have ha₀X : a₀ ∈ Opp 3 Y := hJX ha₀J
      have hcomm : a₀ * c' * a₀⁻¹ * c'⁻¹ ∈ R := by
        have h := hcent_c'_zpow (1 : ℤ) a₀ ha₀J
        have heq : a₀ * c' * a₀⁻¹ * c'⁻¹ = (c' * a₀ * c'⁻¹ * a₀⁻¹)⁻¹ := by group
        rw [heq]
        exact R.inv_mem (by simpa using h)
      have hind : ∀ i jj : ℤ, a₀^i * c'^jj ∈ R → (3:ℤ) ∣ i ∧ (3:ℤ) ∣ jj := by
        intro i jj hmem
        have hcjJ : c'^jj ∈ J := by
          have haiJ : a₀^i ∈ J := J.zpow_mem ha₀J i
          have hprodJ : a₀^i * c'^jj ∈ J := hRJ hmem
          have heq : c'^jj = (a₀^i)⁻¹ * (a₀^i * c'^jj) := by group
          rw [heq]
          exact J.mul_mem (J.inv_mem haiJ) hprodJ
        have hcjR : c'^jj ∈ R := by
          have hZbar : Subgroup.center (Bar2 J) = ⊥ := by
            obtain ⟨eA⟩ := hAlt
            have hmap := Subgroup.map_center_eq eA
            rw [alternatingGroup.center_eq_bot (by norm_num : 4 ≤ Nat.card (Fin 5))] at hmap
            exact (Subgroup.map_eq_bot_iff_of_injective _ eA.injective).mp hmap
          let qJ : ↥J →* Bar2 J := QuotientGroup.mk' (CFSG.pCore 2 ↥J)
          have hcenter : qJ ⟨c'^jj, hcjJ⟩ ∈ Subgroup.center (Bar2 J) := by
            rw [Subgroup.mem_center_iff]
            intro y
            obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective (CFSG.pCore 2 ↥J) y
            have hc := hcent_c'_zpow jj (b : G) b.2
            have hxR : ((⟨c'^jj, hcjJ⟩ * b * ⟨c'^jj, hcjJ⟩⁻¹ * b⁻¹ : ↥J) : G) ∈ R := by
              simpa using hc
            obtain ⟨o, ho, hoo⟩ := Subgroup.mem_map.mp hxR
            have hxeq : (⟨c'^jj, hcjJ⟩ * b * ⟨c'^jj, hcjJ⟩⁻¹ * b⁻¹ : ↥J) = o :=
              Subtype.ext (by simpa using hoo.symm)
            have hq1 : qJ (⟨c'^jj, hcjJ⟩ * b * ⟨c'^jj, hcjJ⟩⁻¹ * b⁻¹) = 1 := by
              rw [hxeq]
              simpa [qJ] using (QuotientGroup.eq_one_iff o).mpr ho
            simp only [map_mul, map_inv] at hq1
            have h2 : qJ ⟨c'^jj, hcjJ⟩ * qJ b * (qJ ⟨c'^jj, hcjJ⟩)⁻¹ = qJ b :=
              mul_inv_eq_one.mp hq1
            have hcommq : qJ b * qJ ⟨c'^jj, hcjJ⟩ =
                qJ ⟨c'^jj, hcjJ⟩ * qJ b := by
              calc qJ b * qJ ⟨c'^jj, hcjJ⟩
                  = (qJ ⟨c'^jj, hcjJ⟩ * qJ b * (qJ ⟨c'^jj, hcjJ⟩)⁻¹) *
                      qJ ⟨c'^jj, hcjJ⟩ := by rw [h2]
                _ = qJ ⟨c'^jj, hcjJ⟩ * qJ b := by group
            exact hcommq
          have hq1 : qJ ⟨c'^jj, hcjJ⟩ = 1 := by
            have := hcenter
            rw [hZbar] at this
            simpa using this
          have ho : (⟨c'^jj, hcjJ⟩ : ↥J) ∈ CFSG.pCore 2 ↥J :=
            (QuotientGroup.eq_one_iff _).mp hq1
          exact Subgroup.mem_map.mpr ⟨_, ho, rfl⟩
        exact ⟨hz_dvd ha₀ord i (by
            have heq : a₀^i = (a₀^i * c'^jj) * (c'^jj)⁻¹ := by group
            rw [heq]
            exact R.mul_mem hmem (R.inv_mem hcjR)),
          hz_dvd hc'ord jj hcjR⟩
      have hrank := Q9.two_le_pRank_of_commute_mod_two_group hRpg hXR ha₀X hc'X
        (by rw [← ha₀ord]; exact pow_orderOf_eq_one a₀)
        (by rw [← hc'ord]; exact pow_orderOf_eq_one c') hcomm hind
      omega
    have hcJ : c ∈ J := by
      let X : Subgroup G := Opp 3 Y
      have hJn : (J.subgroupOf X).Normal :=
        Subgroup.normal_subgroupOf_of_le_normalizer (by simpa [X] using hN)
      let q : ↥X →* ↥X ⧸ J.subgroupOf X := QuotientGroup.mk' (J.subgroupOf X)
      have hquot : q ⟨x, hxX⟩ = q ⟨c, hcX⟩ := by
        change (QuotientGroup.mk ⟨x, hxX⟩ : ↥X ⧸ J.subgroupOf X) =
          QuotientGroup.mk ⟨c, hcX⟩
        rw [QuotientGroup.eq, Subgroup.mem_subgroupOf]
        have hxeq : x = j * c := by rw [hc]; group
        have hcoe : ((⟨x, hxX⟩ : ↥X)⁻¹ * ⟨c, hcX⟩ : ↥X) =
            ⟨c⁻¹ * j⁻¹ * c, X.mul_mem (X.mul_mem (X.inv_mem hcX)
              (X.inv_mem (hJX hjJ))) hcX⟩ := by
          apply Subtype.ext
          simp [hxeq, mul_assoc]
        rw [hcoe]
        simpa using (Subgroup.mem_normalizer_iff.mp
          ((Subgroup.normalizer (J : Set G)).inv_mem hcjN) j⁻¹).mp (J.inv_mem hjJ)
      have hqcdvd : orderOf (q ⟨c, hcX⟩) ∣ orderOf c := by
        have h1 := orderOf_map_dvd q ⟨c, hcX⟩
        have hco : orderOf (⟨c, hcX⟩ : ↥X) = orderOf c := by
          simpa using (Subgroup.orderOf_coe ⟨c, hcX⟩).symm
        rwa [hco] at h1
      have hqxdvd : orderOf (q ⟨x, hxX⟩) ∣ 3 ^ k := by
        have h1 := orderOf_map_dvd q ⟨x, hxX⟩
        have hxo : orderOf (⟨x, hxX⟩ : ↥X) = orderOf x := by
          simpa using (Subgroup.orderOf_coe ⟨x, hxX⟩).symm
        rw [hxo, hxord] at h1
        exact h1
      have hq3 : orderOf (q ⟨c, hcX⟩) ∣ 3 ^ k := by
        rw [← hquot]
        exact hqxdvd
      have hnot3q : ¬ 3 ∣ orderOf (q ⟨c, hcX⟩) := by
        intro h
        exact hnot3 (h.trans hqcdvd)
      have hq1 : orderOf (q ⟨c, hcX⟩) = 1 := by
        obtain ⟨r, hrle, hr⟩ := (Nat.dvd_prime_pow Nat.prime_three).mp hq3
        by_contra hne
        have hr0 : r ≠ 0 := by
          intro h0
          rw [h0, pow_zero] at hr
          exact hne hr
        exact hnot3q (by rw [hr]; exact dvd_pow_self 3 hr0)
      have hqeq : q ⟨c, hcX⟩ = 1 := by
        rw [← orderOf_eq_one_iff]
        exact hq1
      have hmem : (⟨c, hcX⟩ : ↥X) ∈ J.subgroupOf X := (QuotientGroup.eq_one_iff _).mp hqeq
      simpa [X] using (Subgroup.mem_subgroupOf.mp hmem)
    have hxeq : x = j * c := by rw [hc]; group
    rw [hxeq]
    exact J.mul_mem hjJ hcJ
  have hXJ : Opp 3 Y ≤ J := by
    refine (Subgroup.closure_le J).mpr ?_
    rintro x ⟨hxY, hxord⟩
    exact hthree x (Subgroup.subset_closure ⟨hxY, hxord⟩) hxord
  exact le_antisymm hXJ hJX

end Opp

