theorem exists_solvable_of_hyp97 (D : Data G) {Y H D₃ S' S : Subgroup G}
    (h97 : F09.Hyp97 D Y H D₃ S') (h914 : PartOne.R9_14S D)
    (hH : H = (H ⊓ D.M) ⊔ F07.PPrimeCoreIn 3 H) (hHM : ¬ H ≤ D.M)
    (hS : CFSG.ABGLocalTools.IsSylowOf 2 S H) (hSM : S ≤ D.M) :
    ∃ X : Subgroup G, S ≤ X ∧ X ≤ H ∧ ¬ X ≤ D.M ∧ Group.IsSolvable ↥X := by
  classical
  let I := F07.PPrimeCoreIn 3 H
  have hIH : I ≤ H := Subgroup.map_subtype_le _
  have hInorm : (I.subgroupOf H).Normal := by
    have h : (CFSG.pPrimeCore 3 ↥H).Normal := CFSG.pPrimeCore_normal
    simpa [I, F07.PPrimeCoreIn] using h
  have hIM : ¬ I ≤ D.M := by
    intro hle
    apply hHM
    calc H = (H ⊓ D.M) ⊔ I := hH
      _ ≤ D.M := sup_le inf_le_right hle
  obtain ⟨A, hAI, hAmin⟩ := Finite.exists_le_minimal
    (p := fun A : Subgroup G => A ≤ I ∧ (A.subgroupOf H).Normal ∧ ¬ A ≤ D.M)
    (a := I) ⟨le_rfl, hInorm, hIM⟩
  have hAnorm : (A.subgroupOf H).Normal := hAmin.prop.2.1
  have hAM : ¬ A ≤ D.M := hAmin.prop.2.2
  have hAH : A ≤ H := hAI.trans hIH
  have hAne : A ≠ ⊥ := by
    intro hbot
    exact hAM (hbot ▸ bot_le)
  obtain ⟨B, -, hBmax⟩ := Finite.exists_le_maximal
    (p := fun B : Subgroup G => B < A ∧ (B.subgroupOf H).Normal) (a := ⊥)
    ⟨bot_lt_iff_ne_bot.mpr hAne, inferInstance⟩
  have hBlt : B < A := hBmax.prop.1
  have hBnorm : (B.subgroupOf H).Normal := hBmax.prop.2
  have hBA : B ≤ A := le_of_lt hBlt
  have hBH : B ≤ H := hBA.trans hAH
  have hBHM : B ≤ D.M := by
    by_contra hBM
    have hpB : B ≤ I ∧ (B.subgroupOf H).Normal ∧ ¬ B ≤ D.M :=
      ⟨hBA.trans hAI, hBnorm, hBM⟩
    exact hBlt.ne (hAmin.eq_of_le hpB hBA)
  have hHnormA : H ≤ Subgroup.normalizer (A : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hAH).mp hAnorm
  have hHnormB : H ≤ Subgroup.normalizer (B : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hBH).mp hBnorm
  have hBnormA : (B.subgroupOf A).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hBA).mpr (hAH.trans hHnormB)
  have hChief : IsChiefFactorOf H A B := by
    refine ⟨⟨hBH, hHnormB⟩, ⟨hAH, hHnormA⟩, hBlt, ?_⟩
    intro K hK hBK hKA
    rcases eq_or_lt_of_le hBK with hKB | hlt
    · exact Or.inl hKB.symm
    · right
      by_contra hKAne
      have hKlt : K < A := lt_of_le_of_ne hKA hKAne
      have hKnorm : (K.subgroupOf H).Normal :=
        (Subgroup.normal_subgroupOf_iff_le_normalizer hK.1).mpr hK.2
      exact hlt.ne' (hBmax.eq_of_le ⟨hKlt, hKnorm⟩ hBK).symm
  have hbridge : IsSolvableSection A B ↔ Group.IsSolvable (↥A ⧸ B.subgroupOf A) :=
    (CFSG.isSolvable_quotient_iff_exists_derivedSeries_le (G := ↥A)
      (N := B.subgroupOf A)).symm
  have hABsec : IsSolvableSection A B := by
    by_contra hns
    have hnsq := fun hq => hns (hbridge.mpr hq)
    have hAeq : A = (A ⊓ D.M) ⊔ B :=
      h914 Y H D₃ S' h97 S hS hSM A B hChief hAI hnsq
    exact hAM (hAeq ▸ sup_le inf_le_right hBHM)
  have hAB : Group.IsSolvable (↥A ⧸ B.subgroupOf A) := hbridge.mp hABsec
  have hSsyl : CFSG.QuasithinUnique.IsSylowTwoOf S H := by
    obtain ⟨hSH, hS2, hSidx⟩ := (CFSG.ABGLocalTools.isSylowOf_iff (p := 2)).mp hS
    exact ⟨hSH, hS2, hSidx⟩
  have hSH : S ≤ H := hSsyl.1
  have hSAH : S ⊔ A ≤ H := sup_le hSH hAH
  have hSylB : CFSG.QuasithinUnique.IsSylowTwoOf (S ⊓ B) B :=
    CFSG.Quasithin.B6.isSylowTwoOf_inf_normal hSsyl hBH hHnormB
  have hBN' : (B.subgroupOf (S ⊔ A)).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer (hBA.trans le_sup_right)).mpr
      (hSAH.trans hHnormB)
  have hAN' : (A.subgroupOf (S ⊔ A)).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer le_sup_right).mpr (hSAH.trans hHnormA)
  have hAN : (A.subgroupOf S).Normal := by
    have h := Subgroup.inf_subgroupOf_inf_normal_of_left (A' := A) (A := H) (B := S)
    rw [inf_eq_right.mpr hSH, Subgroup.inf_subgroupOf_right] at h
    exact h
  let X := (S ⊔ A) ⊓ Subgroup.normalizer (S ⊓ B)
  have hXsolv : Group.IsSolvable ↥X := by
    have hBH_le : B ≤ H := hBA.trans hAH
    have hFT : Group.IsSolvable ↥(B ⊓ Subgroup.normalizer (S ⊓ B)) :=
      CFSG.Quasithin.isSolvable_inf_normalizer_of_isSylowTwoOf hSylB
    have hSsolv : Group.IsSolvable ↥S := by
      have hnil : Group.IsNilpotent ↥S := hSsyl.2.1.isNilpotent
      infer_instance
    let e := QuotientGroup.quotientInfEquivProdNormalizerQuotient S A (hSH.trans hHnormA)
    have hq : Group.IsSolvable (↥S ⧸ A.subgroupOf S) := by infer_instance
    have hSAsolvR : Group.IsSolvable (↥(S ⊔ A) ⧸ A.subgroupOf (S ⊔ A)) :=
      Group.isSolvable_of_surjective (f := e.toMonoidHom) e.surjective
    let f : ↥A ⧸ B.subgroupOf A →* ↥(S ⊔ A) ⧸ B.subgroupOf (S ⊔ A) :=
      QuotientGroup.map (B.subgroupOf A) (B.subgroupOf (S ⊔ A))
        (Subgroup.inclusion le_sup_right)
        (by
          intro x hx
          rw [Subgroup.mem_comap]
          show ((Subgroup.inclusion le_sup_right x : ↥(S ⊔ A)) : G) ∈ B
          exact Subgroup.mem_subgroupOf.mp hx)
    let g : ↥(S ⊔ A) ⧸ B.subgroupOf (S ⊔ A) →*
        ↥(S ⊔ A) ⧸ A.subgroupOf (S ⊔ A) :=
      QuotientGroup.map (B.subgroupOf (S ⊔ A)) (A.subgroupOf (S ⊔ A)) (MonoidHom.id _)
        (by intro x hx; exact hBA hx)
    have hfg : g.ker ≤ f.range := by
      intro y hy
      obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (B.subgroupOf (S ⊔ A)) y
      have hx : x ∈ A.subgroupOf (S ⊔ A) := by
        have h1 : QuotientGroup.mk' (A.subgroupOf (S ⊔ A)) x = 1 := hy
        exact (QuotientGroup.eq_one_iff x).mp h1
      refine ⟨QuotientGroup.mk' (B.subgroupOf A) ⟨(x : G), Subgroup.mem_subgroupOf.mp hx⟩, ?_⟩
      dsimp only [f]
      rfl
    have hSAsolv : Group.IsSolvable (↥(S ⊔ A) ⧸ B.subgroupOf (S ⊔ A)) :=
      Group.isSolvable_of_ker_le_range f g hfg (hG' := hAB) (hG'' := hSAsolvR)
    have hXB : ((S ⊔ A) ⊓ Subgroup.normalizer (S ⊓ B)) ⊓ B =
        B ⊓ Subgroup.normalizer (S ⊓ B) := by
      ext x
      simp only [Subgroup.mem_inf]
      constructor
      · rintro ⟨⟨-, hxN⟩, hxB⟩
        exact ⟨hxB, hxN⟩
      · rintro ⟨hxB, hxN⟩
        exact ⟨⟨(hBA.trans le_sup_right) hxB, hxN⟩, hxB⟩
    have hFTX : Group.IsSolvable ↥(((S ⊔ A) ⊓ Subgroup.normalizer (S ⊓ B)) ⊓ B) := by
      rw [hXB]
      exact hFT
    let fX : ↥(((S ⊔ A) ⊓ Subgroup.normalizer (S ⊓ B)) ⊓ B) →*
        ↥((S ⊔ A) ⊓ Subgroup.normalizer (S ⊓ B)) := Subgroup.inclusion inf_le_left
    let gX : ↥((S ⊔ A) ⊓ Subgroup.normalizer (S ⊓ B)) →*
        ↥(S ⊔ A) ⧸ B.subgroupOf (S ⊔ A) :=
      (QuotientGroup.mk' (B.subgroupOf (S ⊔ A))).comp (Subgroup.inclusion inf_le_left)
    have hfgX : gX.ker ≤ fX.range := by
      intro x hx
      have hx' : (x : G) ∈ B :=
        Subgroup.mem_subgroupOf.mp
          ((QuotientGroup.eq_one_iff (⟨(x : G), (inf_le_left : _ ≤ S ⊔ A) x.2⟩ :
            ↥(S ⊔ A))).mp hx)
      refine ⟨⟨(x : G), ⟨x.2, hx'⟩⟩, ?_⟩
      rfl
    exact Group.isSolvable_of_ker_le_range fX gX hfgX (hG' := hFTX) (hG'' := hSAsolv)
  refine ⟨X, ?_, ?_, ?_, hXsolv⟩
  ·
    refine le_inf le_sup_left ?_
    intro g hg
    exact Subgroup.inf_normalizer_le_normalizer_inf
      ⟨Subgroup.le_normalizer hg, hHnormB (hSH hg)⟩
  · exact inf_le_left.trans hSAH
  ·
    intro hXM
    have hfr : S ⊔ A ≤ B ⊔ X := by
      simpa [X] using
        (CFSG.Quasithin.B6.frattini_two (N := B) (S := S ⊓ B)
          (hBA.trans le_sup_right) (hSAH.trans hHnormB) hSylB)
    have hA_le : A ≤ D.M := by
      calc A ≤ S ⊔ A := le_sup_right
        _ ≤ B ⊔ X := hfr
        _ ≤ D.M := sup_le hBHM hXM
    exact hAM hA_le

