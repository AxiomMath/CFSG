theorem opp_three_le_normalizer (c : A5Pair18 D V₀ V L K) (hV₀ : V₀ = ⊥) :
    Opp 3 D.M ≤ normalizer (L : Set G) ∧
      Opp 3 D.M ≤ normalizer (K : Set G) := by
  subst hV₀
  rcases c.dichotomy with hsw | hnorm
  · obtain ⟨-, x, hxM, hKx⟩ := hsw
    have hKe : K ∈ conjSetOf D.M L := ⟨x⁻¹, D.M.inv_mem hxM, hKx⟩
    have hLe : L ∈ conjSetOf D.M L := by
      refine ⟨1, D.M.one_mem, ?_⟩
      rw [show MulAut.conj (1 : G) = 1 from map_one _,
        show (1 : MulAut G).toMonoidHom = MonoidHom.id G from rfl, Subgroup.map_id]
    have hsub : conjSetOf D.M L ⊆ {L, K} := by
      intro J hJ
      have hJC := uc22p2214_calC_of_mem_conjSetOf c.mem_calC_L hJ
      rcases c.calC_eq J hJC with h | h <;> simp [h]
    have hpair : conjSetOf D.M L = {L, K} := by
      refine Set.Subset.antisymm hsub ?_
      intro J hJ
      rcases hJ with rfl | rfl
      · exact hLe
      · exact hKe
    have hc2 : (conjSetOf D.M L).ncard = 2 := by
      rw [hpair, Set.ncard_pair c.ne_L.symm]
    have hc2K : (conjSetOf D.M K).ncard = 2 := by
