theorem wi_one_le_normalizer (c : A5Pair18 D V₀ V L K) (hV₀ : V₀ = ⊥) (h61 : UC6.R6_1 D)
    (h127 : R127 D) (hW1 : ⁅E3.wClos V 1 D.T, V⁆ = ⊥) :
    F12.Wi 1 D.T V ≤ normalizer (L : Set G) ∧
      F12.Wi 1 D.T V ≤ normalizer (K : Set G) := by
  subst hV₀
  have hp := c.data.hyp.hyp125
  have hV : IsElemAbelian 2 V := hp.isElemAbelian
  have hMS : D.M ≤ stabTil (⊥ : Subgroup G) V :=
    le_stabTil hp.pairFacts.le_normalizer hp.pairFacts.le_normalizer₀
  have hW1c : F12.Wi 1 D.T V ≤ centralizer (V : Set G) := by
    rw [S17.Wi_eq_wClos 1 D.T V hV]
    exact Subgroup.commutator_eq_bot_iff_le_centralizer.1 hW1
  have hW1M : F12.Wi 1 D.T V ≤ D.M :=
    ((S17.Wi_eq_wClos 1 D.T V hV).le.trans (E3.wClos_le 1 D.T)).trans D.sylowM.le
  rcases c.dichotomy with hsw | hnorm
  · have hne := barSub_ne_bot_of_swap c h61 h127 hsw
    have hneq := barSub_L_ne_barSub_K c rfl hne.1 hne.2
    have key : ∀ J : Subgroup G, J ∈ calC D.M →
        barSub (⊥ : Subgroup G) V hV J ≠ ⊥ →
        F12.Wi 1 D.T V ≤ normalizer (J : Set G) := by
      intro J hJC hJne w hw
      have hwM : w ∈ D.M := hW1M hw
      have hwStab : w⁻¹ ∈ stabTil (⊥ : Subgroup G) V := hMS (D.M.inv_mem hwM)
      have hJS : J ≤ stabTil (⊥ : Subgroup G) V := hJC.1.le.trans hMS
      have hmem : J.map (MulAut.conj w⁻¹).toMonoidHom ∈ conjSetOf D.M J :=
        ⟨w⁻¹, D.M.inv_mem hwM, rfl⟩
      have hJ'C : J.map (MulAut.conj w⁻¹).toMonoidHom ∈ calC D.M :=
        uc22p2214_calC_of_mem_conjSetOf hJC hmem
      have hbar : barSub (⊥ : Subgroup G) V hV
            (J.map (MulAut.conj w⁻¹).toMonoidHom) =
            barSub (⊥ : Subgroup G) V hV J := by
        rw [TwelveTwentyThree.barSub_map_conj (V₀ := ⊥) (V := V) hV hJS hwStab]
        have hact : actTil (⊥ : Subgroup G) V hV ⟨w⁻¹, hwStab⟩ = 1 := by
          rw [actTil_eq_one_iff]
          intro v hv
          rw [Subgroup.mem_bot]
          have hcomm : w⁻¹ * v = v * w⁻¹ :=
            (Subgroup.mem_centralizer_iff.1
              ((Subgroup.centralizer (V : Set G)).inv_mem (hW1c hw)) v hv).symm
          calc w⁻¹ * v * (w⁻¹)⁻¹ * v⁻¹ = (w⁻¹ * v) * w * v⁻¹ := by group
            _ = (v * w⁻¹) * w * v⁻¹ := by rw [hcomm]
            _ = v * v⁻¹ := by group
            _ = 1 := mul_inv_cancel v
        rw [hact]
        rw [show MulAut.conj (1 : MulAut (Vtil (⊥ : Subgroup G) V hV)) = 1 from map_one _,
          show (1 : MulAut (MulAut (Vtil (⊥ : Subgroup G) V hV))).toMonoidHom =
            MonoidHom.id (MulAut (Vtil (⊥ : Subgroup G) V hV)) from rfl, Subgroup.map_id]
      have hcases : J.map (MulAut.conj w⁻¹).toMonoidHom = L ∨
          J.map (MulAut.conj w⁻¹).toMonoidHom = K := c.calC_eq _ hJ'C
      have hmemN : w⁻¹ ∈ normalizer (J : Set G) := by
        refine Subgroup.mem_normalizer_iff_map_conj_eq.mpr ?_
        rcases c.calC_eq J hJC with hJ | hJ
        · subst hJ
          rcases hcases with h | h
          · exact h
          · exfalso
            refine hneq ?_
            exact hbar.symm.trans (congrArg (fun X => barSub (⊥) V hV X) h)
        · subst hJ
          rcases hcases with h | h
          · exfalso
            refine hneq ?_
            exact (congrArg (fun X => barSub (⊥) V hV X) h.symm).trans hbar
          · exact h
      simpa using (normalizer (J : Set G)).inv_mem hmemN
    exact ⟨key L c.mem_calC_L hne.1, key K c.mem_calC hne.2⟩
  · obtain ⟨-, hLn, hKn⟩ := hnorm
    have hNL : D.M ≤ normalizer (L : Set G) :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer c.mem_calC_L.1.le).mp hLn
    have hNK : D.M ≤ normalizer (K : Set G) :=
