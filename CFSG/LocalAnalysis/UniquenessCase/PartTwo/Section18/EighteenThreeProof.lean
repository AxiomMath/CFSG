theorem uniqueMax_sup_wi_one (D : Data G) {V : Subgroup G} (hp : Hyp125 D ⊥ V)
    {J D₃ : Subgroup G} (hJ : J ∈ calC D.M) (hAlt : IsAlt (Bar2 J) 5)
    (hD₃J : D₃ ≤ J) (hD₃ : Nat.card D₃ = 3)
    (hU3 : D₃ ∈ CFSG.LocalAnalysis.RankThreeUC.uniqueSet D.M)
    (hWJ : F12.Wi 1 D.T V ≤ normalizer (J : Set G))
    (h3N : Opp 3 D.M ≤ normalizer (J : Set G))
    (h919 : Inputs1719.NineNineteenA5.R9_19A5 D) (h922 : PartOne.R9_22sp5 D)
    (h914 : PartOne.R9_14S D)
    (hsp5 : CFSG.RankThree.PartOne.IsStronglyPEmbedded 5 D.M)
    (h111 : W3Thm111 G) (hm2 : MBarGT D.M ⊥ V 2)
    (hN : UniqueMax D.M (D.M ⊓ normalizer (F12.Wi 1 D.T V : Set G))) :
