local notation "pRank" => CFSG.Open.pRank

variable {G : Type} [Group G] [Finite G]

theorem hasNormalPComplement_outer_of_centerQuotient {X : Subgroup G} [Group.IsPerfect (Bar2 X)]
    {p : ℕ}
    (h : CFSG.HasNormalPComplement p (Outer (Bar2 X ⧸ center (Bar2 X)))) :
    CFSG.HasNormalPComplement p (Outer (Bar2 X)) :=
  CFSG.LocalAnalysis.GLTheoremB.MovingAround.InputsMisc5.hasNormalPComplement_of_injective
    (CFSG.ComponentClassification.OuterAutomorphisms.centerQuotientOuterHom (Bar2 X))
    (CFSG.ComponentClassification.OuterAutomorphisms.centerQuotient_outer_injective (Bar2 X)) h

theorem map_rhoL_le_inner_of_hasNormalPComplement {X M : Subgroup G}
    (hMN : M ≤ normalizer (X : Set G)) {p : ℕ} (hp : p.Prime)
    (hOut : CFSG.HasNormalPComplement p (Outer (Bar2 X))) (hOp : UC22.F10.OpRes p M = M)
    {A : Subgroup G} (hAM : A ≤ M) (hAp : IsPGroup p A) :
    (A.subgroupOf M).map ((rhoL X).comp (Subgroup.inclusion hMN)) ≤ inner (Bar2 X) := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  let ρ : ↥M →* MulAut (Bar2 X) := (rhoL X).comp (Subgroup.inclusion hMN)
  let ψ : ↥M →* Outer (Bar2 X) := (QuotientGroup.mk' (inner (Bar2 X))).comp ρ
  let H : Subgroup (Outer (Bar2 X)) := (M.subgroupOf M).map ψ
  obtain ⟨K, hKN, hcK, hqK⟩ := hOut
  haveI := hKN
  have hgen : Subgroup.closure {y | y ∈ H ∧ ¬ p ∣ orderOf y} = H := by
    simpa [H, ψ] using closure_pPrime_map ψ (M.subgroupOf M)
      (closure_pPrime_subgroupOf (le_refl M) (p := p) hOp)
  have hHle : H ≤ K := by
    have hSle : Subgroup.closure {y | y ∈ H ∧ ¬ p ∣ orderOf y} ≤ K := by
      rw [Subgroup.closure_le]
      rintro y ⟨-, hyp⟩
      exact (CFSG.GroupTheory.le_of_normal_coprime_of_isPGroup_quotient (p := p) K
        (Subgroup.zpowers y) hqK (by rwa [Nat.card_zpowers])) (Subgroup.mem_zpowers y)
    rwa [hgen] at hSle
  rintro _ ⟨a, ha, rfl⟩
  have haA : (a : G) ∈ A := ha
  have haSub : a ∈ M.subgroupOf M := Subgroup.mem_subgroupOf.2 (hAM haA)
  have hψK : ψ a ∈ K := hHle (Subgroup.mem_map_of_mem ψ haSub)
  obtain ⟨k, hk⟩ := hAp ⟨(a : G), haA⟩
  have hkM : a ^ p ^ k = 1 := by
    apply Subtype.ext
    simpa using congrArg Subtype.val hk
  have hψpow : (ψ a) ^ p ^ k = 1 := by
    rw [← map_pow, hkM, map_one]
  have hdvd : orderOf (ψ a) ∣ Nat.card K :=
    Subgroup.orderOf_dvd_natCard K hψK
  have hone : orderOf (ψ a) = 1 :=
    Nat.eq_one_of_dvd_coprimes (hcK.pow_left k) (orderOf_dvd_of_pow_eq_one hψpow) hdvd
  have hψa : ψ a = 1 := orderOf_eq_one_iff.mp hone
  exact (QuotientGroup.eq_one_iff (N := inner (Bar2 X)) (ρ a)).1 (by simpa [ψ] using hψa)

theorem pRank_le_add_pRank_centOverO2 {X M : Subgroup G} (hXM : X ≤ M)
    (hMN : M ≤ normalizer (X : Set G)) {p : ℕ} (hp : p.Prime)
    (hOut : CFSG.HasNormalPComplement p (Outer (Bar2 X))) (hOp : UC22.F10.OpRes p M = M) :
    pRank p M ≤ pRank p (⊤ : Subgroup (Bar2 X ⧸ center (Bar2 X))) +
      pRank p (F08.CentOverO2 M X) := by
  classical
  have hp1 : 1 < p := hp.one_lt
  let ρ : ↥M →* MulAut (Bar2 X) := (rhoL X).comp (Subgroup.inclusion hMN)
  obtain ⟨E, hEM, hEel, hEcard⟩ := exists_pRank hp1 M
  have hEeq : pRank p E = pRank p M := by
    refine le_antisymm (pRank_mono hp1 hEM) ?_
    exact le_pRank hp1 le_rfl hEel hEcard
  have hmap := CFSG.AGLEmbedding.pRank_le_pRank_inf_ker_add_pRank_map
    (G := ↥M) (H := MulAut (Bar2 X)) hp ρ (E.subgroupOf M)
  have hsub : pRank p (E.subgroupOf M) = pRank p E := by
    rw [pRank_eq_pRank_top_subgroup (E.subgroupOf M), pRank_eq_pRank_top_subgroup E]
    exact pRank_top_eq_of_mulEquiv hp1 (Subgroup.subgroupOfEquivOfLe hEM)
  have hker : pRank p (E.subgroupOf M ⊓ ρ.ker) ≤ pRank p (F08.CentOverO2 M X) := by
    have hKmap : ((E.subgroupOf M ⊓ ρ.ker).map M.subtype) ≤ F08.CentOverO2 M X := by
      rw [centOverO2_eq_ker_map hMN]
      exact Subgroup.map_mono (inf_le_right : E.subgroupOf M ⊓ ρ.ker ≤ ρ.ker)
    exact (pRank_le_map hp1 M.subtype M.subtype_injective _).trans (pRank_mono hp1 hKmap)
  have hkerConj : (MulAut.conj : Bar2 X →* MulAut (Bar2 X)).ker = center (Bar2 X) := by
    ext x
    rw [MonoidHom.mem_ker, Subgroup.mem_center_iff]
    constructor
    · intro hx y
      have h := congrArg (fun f : MulAut (Bar2 X) => f y) hx
      simp only [MulAut.conj_apply, MulAut.one_apply] at h
      exact (calc x * y = x * y * x⁻¹ * x := by group
        _ = y * x := by rw [h]).symm
    · intro hx
      ext y
      rw [MulAut.conj_apply, MulAut.one_apply]
      calc x * y * x⁻¹ = y * x * x⁻¹ := by rw [← hx y]
        _ = y := by group
  let e : Bar2 X ⧸ center (Bar2 X) ≃* inner (Bar2 X) :=
    (QuotientGroup.quotientMulEquivOfEq hkerConj.symm).trans
      (QuotientGroup.quotientKerEquivRange (MulAut.conj : Bar2 X →* MulAut (Bar2 X)))
  have hinner : pRank p (inner (Bar2 X)) =
      pRank p (⊤ : Subgroup (Bar2 X ⧸ center (Bar2 X))) := by
    rw [pRank_eq_pRank_top_subgroup]
    exact (pRank_top_eq_of_mulEquiv hp1 e).symm
  have himg : pRank p ((E.subgroupOf M).map ρ) ≤
      pRank p (⊤ : Subgroup (Bar2 X ⧸ center (Bar2 X))) := by
    have hle : (E.subgroupOf M).map ρ ≤ inner (Bar2 X) := by
      simpa [ρ] using map_rhoL_le_inner_of_hasNormalPComplement hMN hp hOut hOp hEM hEel.isPGroup
    exact (pRank_mono hp1 hle).trans_eq hinner
  calc
    pRank p M = pRank p (E.subgroupOf M) := (hsub.trans hEeq).symm
    _ ≤ pRank p (E.subgroupOf M ⊓ ρ.ker) + pRank p ((E.subgroupOf M).map ρ) := hmap
    _ ≤ pRank p (F08.CentOverO2 M X) +
        pRank p (⊤ : Subgroup (Bar2 X ⧸ center (Bar2 X))) := add_le_add hker himg
    _ = pRank p (⊤ : Subgroup (Bar2 X ⧸ center (Bar2 X))) +
        pRank p (F08.CentOverO2 M X) := Nat.add_comm _ _

end CFSG.LocalAnalysis.UniquenessCase.PartTwo
