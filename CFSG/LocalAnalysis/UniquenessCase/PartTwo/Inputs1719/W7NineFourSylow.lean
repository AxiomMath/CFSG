theorem isTwoPrimeComponent_of_perfectCore {H L : Subgroup G}
    (hLc : L = CFSG.Quasithin.perfectCore (L ⊔ pCoreOf 2 H))
    (hc : F12.IsComponentModO2 H (L ⊔ pCoreOf 2 H)) : IsTwoPrimeComponent H L := by
  set J : Subgroup G := L ⊔ pCoreOf 2 H with hJ
  have hcJ : F12.IsComponentModO2 H J := by rw [hJ]; exact hc
  have hJH : J ≤ H := hcJ.2.1
  have hsn : CFSG.Open.IsSubnormal J H := hcJ.2.2.1
  have hLcJ : L = CFSG.Quasithin.perfectCore J := by rw [hJ]; exact hLc
  have hLJ : L ≤ J := by rw [hLcJ]; exact CFSG.Quasithin.perfectCore_le J
  have hLH : L ≤ H := hLJ.trans hJH
  have hQH : pCoreOf 2 H ≤ H := CFSG.LieType.BorelTits.pCoreOf_le 2 H
  have hLsnJ : CFSG.Open.IsSubnormal L J := by
    rw [hLcJ]
    exact CFSG.Quasithin.A3.subnormal_of_normal (CFSG.Quasithin.perfectCore_le J)
      (CFSG.Quasithin.perfectCore_normal J)
  have hLsn : CFSG.Open.IsSubnormal L H := CFSG.Quasithin.A3.subnormal_trans hLsnJ hsn
  have hperf : ⁅L, L⁆ = L := by
    rw [hLcJ]; exact CFSG.Quasithin.perfectCore_perfect J
  have hbarQ : barM H (pCoreOf 2 H) = ⊥ := by
    unfold barM
    rw [show (pCoreOf 2 H).subgroupOf H = CFSG.pCore 2 ↥H from by
      rw [CFSG.Open.pCoreOf, Subgroup.subgroupOf,
        Subgroup.comap_map_eq_self_of_injective H.subtype_injective]]
    refine (Subgroup.map_eq_bot_iff _).mpr ?_
    simpa only [QuotientGroup.ker_mk'] using
      (le_rfl : CFSG.pCore 2 ↥H ≤ CFSG.pCore 2 ↥H)
  have hbar : barM H J = barM H L := by
    rw [hJ]
    calc barM H (L ⊔ pCoreOf 2 H)
        = barM H L ⊔ barM H (pCoreOf 2 H) := by
          unfold barM
          rw [Subgroup.subgroupOf_sup hLH hQH, Subgroup.map_sup]
      _ = barM H L := by rw [hbarQ, sup_bot_eq]
  have hsub : CFSG.Open.IsSubnormal (barM H L) ⊤ := by
    have h := ((CFSG.Quasithin.isSubnormal_iff_subgroupOf hLH).1 hLsn).map
      (QuotientGroup.mk'_surjective (CFSG.pCore 2 ↥H))
    exact CFSG.Open.IsSubnormal.of_mathlib (by simpa only [barM] using h)
  have hq : CFSG.Open.IsQuasisimple (barM H L) := by
    have hJcomp : CFSG.IsComponent (barM H J) := by
      simpa only [barM] using TwelveTwentyFive.isComponent_map hcJ
    have hJq : CFSG.IsQuasisimple (barM H J) := hJcomp.1
    rw [hbar] at hJq
    exact CFSG.Quasithin.A3.isQuasisimple_iff_open.mp hJq
  refine ⟨hLH, hLsn, hperf, le_top, hsub, hq⟩

theorem opp_opp (A : Subgroup G) : Opp 2 (Opp 2 A) = Opp 2 A := by
  apply le_antisymm
  · unfold Opp CFSG.RankThree.PartOne.pElementSubgroup
    refine (Subgroup.closure_le _).2 ?_
    rintro x ⟨hx, -⟩
    exact hx
  · unfold Opp CFSG.RankThree.PartOne.pElementSubgroup
    refine (Subgroup.closure_le _).2 ?_
    rintro x ⟨hxA, hx2⟩
    exact Subgroup.subset_closure ⟨Subgroup.subset_closure ⟨hxA, hx2⟩, hx2⟩

theorem isSylowTwoOf_of_isSylowTwoOf_opp {P A : Subgroup G} (h : IsSylowTwoOf P (Opp 2 A)) :
    IsSylowTwoOf P A := by
  have hPA : P ≤ A := h.1.trans ((Subgroup.closure_le A).2 fun _ hx => hx.1)
  refine isSylowTwoOf_of_forall_normalizer_le hPA h.2.1 ?_
  intro V hVA hV2 hPV _
  exact le_of_eq (isSylowTwoOf_eq_of_le h
    (le_pElementSubgroup_of_isPGroup Nat.prime_two hV2 hVA) hV2 hPV)

theorem isSylowTwoOf_opp_of_isPGroup {A : Subgroup G} (h : IsPGroup 2 (Opp 2 A)) :
    IsSylowTwoOf (Opp 2 A) A := by
  refine isSylowTwoOf_of_forall_normalizer_le ((Subgroup.closure_le A).2 fun _ hx => hx.1) h ?_
  intro U hUA hU2 _ _
  exact le_pElementSubgroup_of_isPGroup Nat.prime_two hU2 hUA

theorem normalizer_le_normalizer_opp (A : Subgroup G) :
    normalizer (A : Set G) ≤ normalizer (Opp 2 A : Set G) := by
  intro w hw
  have h1 : A.map (MulAut.conj w).toMonoidHom = A :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp hw
  have h2 := CFSG.RankThree.PartOne.Equivariance.pElementSubgroup_conjBy 2 w A
  unfold CFSG.RankThree.PartOne.conjBy at h2
  rw [h1] at h2
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  exact h2.symm

theorem le_normalizer_of_commutator_opp_le {A B P : Subgroup G}
    (hc : ⁅Opp 2 A, B⁆ ≤ pCoreOf 2 (Opp 2 A)) (hP : IsSylowTwoOf P (Opp 2 A)) :
    B ≤ normalizer (P : Set G) ∧ B ≤ normalizer (Opp 2 A : Set G) := by
  have hQP : pCoreOf 2 (Opp 2 A) ≤ P :=
    le_of_isSylowTwoOf_of_le_normalizer hP (CFSG.LieType.BorelTits.pCoreOf_le 2 _)
      (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 _)
      (CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 _)
  have hQO : pCoreOf 2 (Opp 2 A) ≤ Opp 2 A := CFSG.LieType.BorelTits.pCoreOf_le 2 _
  have hcomm : ∀ b ∈ B, ∀ x ∈ Opp 2 A, ⁅b, x⁆ ∈ pCoreOf 2 (Opp 2 A) := by
    intro b hb x hx
    refine hc ?_
    rw [Subgroup.commutator_comm]
    exact Subgroup.commutator_mem_commutator hb hx
  have hfwdP : ∀ b ∈ B, ∀ x ∈ P, b * x * b⁻¹ ∈ P := by
    intro b hb x hx
    have heq : b * x * b⁻¹ = ⁅b, x⁆ * x := by
      rw [commutatorElement_def]; group
    rw [heq]
    exact P.mul_mem (hQP (hcomm b hb x (hP.1 hx))) hx
  have hfwdO : ∀ b ∈ B, ∀ x ∈ Opp 2 A, b * x * b⁻¹ ∈ Opp 2 A := by
    intro b hb x hx
    have heq : b * x * b⁻¹ = ⁅b, x⁆ * x := by
      rw [commutatorElement_def]; group
    rw [heq]
    exact (Opp 2 A).mul_mem (hQO (hcomm b hb x hx)) hx
  constructor
  · intro b hb
    rw [Subgroup.mem_normalizer_iff]
    intro x
    exact ⟨hfwdP b hb x, fun hx => by
      have h := hfwdP b⁻¹ (B.inv_mem hb) (b * x * b⁻¹) hx
      rwa [show b⁻¹ * (b * x * b⁻¹) * (b⁻¹)⁻¹ = x by group] at h⟩
  · intro b hb
    rw [Subgroup.mem_normalizer_iff]
    intro x
    exact ⟨hfwdO b hb x, fun hx => by
      have h := hfwdO b⁻¹ (B.inv_mem hb) (b * x * b⁻¹) hx
      rwa [show b⁻¹ * (b * x * b⁻¹) * (b⁻¹)⁻¹ = x by group] at h⟩

theorem w7_9_le_normalizer_sup_zpowers {H L : Subgroup G} (hL : IsTwoPrimeComponent H L)
    {x : G} (hx : x ∈ H) (hne : L.map (MulAut.conj x).toMonoidHom ≠ L) {k : G}
    (hkL : k ∈ L) (hkLx : k ∈ L.map (MulAut.conj x).toMonoidHom) :
    L ≤ Subgroup.normalizer ((Subgroup.zpowers k ⊔ pCoreOf 2 H : Subgroup G) : Set G) := by
  set Lx : Subgroup G := L.map (MulAut.conj x).toMonoidHom with hLxdef
  have hLx : IsTwoPrimeComponent H Lx := by rw [hLxdef]; exact hL.map_conj hx
  have hne' : L ≠ Lx := by rw [hLxdef]; exact Ne.symm hne
  have hcomm : ⁅L, Lx⁆ ≤ pCoreOf 2 H := hL.commutator_le hLx hne'
  have hkLx' : k ∈ Lx := by rw [hLxdef]; exact hkLx
  have hHQ : H ≤ Subgroup.normalizer (pCoreOf 2 H : Set G) :=
    CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 H
  set T : Subgroup G := Subgroup.zpowers k ⊔ pCoreOf 2 H with hTdef
  have hmap_of : ∀ u ∈ L, T.map (MulAut.conj u).toMonoidHom ≤ T := by
    intro u hu
    have huQ : u ∈ Subgroup.normalizer (pCoreOf 2 H : Set G) := hHQ (hL.le hu)
    have huQmap : (pCoreOf 2 H).map (MulAut.conj u).toMonoidHom = pCoreOf 2 H :=
      Subgroup.mem_normalizer_iff_map_conj_eq.mp huQ
    have huk : u * k * u⁻¹ ∈ T := by
      have hcm : ⁅u, k⁆ ∈ ⁅L, Lx⁆ := Subgroup.commutator_mem_commutator hu hkLx'
      have hcmQ : ⁅u, k⁆ ∈ pCoreOf 2 H := hcomm hcm
      have heq : u * k * u⁻¹ = ⁅u, k⁆ * k := by rw [commutatorElement_def]; group
      rw [heq]
      have h1 : ⁅u, k⁆ ∈ Subgroup.zpowers k ⊔ pCoreOf 2 H :=
        le_sup_right (a := Subgroup.zpowers k) (b := pCoreOf 2 H) hcmQ
      have h2 : k ∈ Subgroup.zpowers k ⊔ pCoreOf 2 H :=
        le_sup_left (a := Subgroup.zpowers k) (b := pCoreOf 2 H) (Subgroup.mem_zpowers k)
      exact (Subgroup.zpowers k ⊔ pCoreOf 2 H).mul_mem h1 h2
    rw [hTdef, Subgroup.map_sup, MonoidHom.map_zpowers]
    refine sup_le ?_ ?_
    · rw [Subgroup.zpowers_le]
      simpa [MulAut.conj_apply] using huk
    · rw [huQmap]
      exact le_sup_right
  have hLnorm : L ≤ Subgroup.normalizer (T : Set G) := by
    intro l hl
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    refine le_antisymm (hmap_of l hl) ?_
    have h1 := Subgroup.map_mono (f := (MulAut.conj l).toMonoidHom)
      (hmap_of l⁻¹ (L.inv_mem hl))
    have hcomp : (MulAut.conj l).toMonoidHom.comp (MulAut.conj l⁻¹).toMonoidHom =
        MonoidHom.id G := by
      ext y
      simp [mul_assoc]
    rwa [Subgroup.map_map, hcomp, Subgroup.map_id] at h1
  exact hLnorm

theorem w7_9_mem_pCoreOf_of_mem_conj {H L : Subgroup G} (hL : IsTwoPrimeComponent H L)
    {x : G} (hx : x ∈ H) (hne : L.map (MulAut.conj x).toMonoidHom ≠ L) {k : G}
    (hkL : k ∈ L) (hkLx : k ∈ L.map (MulAut.conj x).toMonoidHom)
    (hk2 : ∃ m : ℕ, orderOf k = 2 ^ m) : k ∈ pCoreOf 2 H := by
  obtain ⟨m, hkm⟩ := hk2
  have hQH : pCoreOf 2 H ≤ H := CFSG.LieType.BorelTits.pCoreOf_le 2 H
  have hQ2 : IsPGroup 2 (pCoreOf 2 H) := CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 H
  have hHQ : H ≤ Subgroup.normalizer (pCoreOf 2 H : Set G) :=
    CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 H
  have hzk : IsPGroup 2 (Subgroup.zpowers k) :=
    IsPGroup.of_card (n := m) (by rw [Nat.card_zpowers, hkm])
  have hzkN : Subgroup.zpowers k ≤ Subgroup.normalizer (pCoreOf 2 H : Set G) :=
    Subgroup.zpowers_le.mpr (hHQ (hL.le hkL))
  set T : Subgroup G := Subgroup.zpowers k ⊔ pCoreOf 2 H with hTdef
  have hT2 : IsPGroup 2 T := by
    rw [hTdef]
    exact IsPGroup.to_sup_of_normal_right' hzk hQ2 hzkN
  have hLnorm : L ≤ Subgroup.normalizer (T : Set G) :=
    w7_9_le_normalizer_sup_zpowers hL hx hne hkL hkLx
  have hMsn : CFSG.Open.IsSubnormal (L ⊔ pCoreOf 2 H) H := by
    rw [CFSG.Quasithin.isSubnormal_iff_subgroupOf (sup_le hL.le hQH)]
    rw [Subgroup.subgroupOf_sup hL.le hQH]
    exact CFSG.GroupTheory.isSubnormal_sup
      ((CFSG.Quasithin.isSubnormal_iff_subgroupOf hL.le).1 hL.subnormal)
      (Subgroup.normal_subgroupOf_of_le_normalizer hHQ).isSubnormal
  have hTM : T ≤ L ⊔ pCoreOf 2 H := by
    rw [hTdef]
    exact sup_le (Subgroup.zpowers_le.mpr (le_sup_left (a := L) (b := pCoreOf 2 H) hkL))
      le_sup_right
  have hMnorm : L ⊔ pCoreOf 2 H ≤ Subgroup.normalizer (T : Set G) :=
    sup_le hLnorm fun q hq =>
      Subgroup.le_normalizer
        (le_sup_right (a := Subgroup.zpowers k) (b := pCoreOf 2 H) hq)
  have hTsn : CFSG.Open.IsSubnormal T H :=
    CFSG.Quasithin.A3.subnormal_trans
      (CFSG.Quasithin.A3.subnormal_of_normal hTM
