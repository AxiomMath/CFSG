    have hVinf2 : IsPGroup 2 ↥(V ⊓ L) := hV2.to_le (show V ⊓ L ≤ V from inf_le_left)
    have hP₁V : P₁ ≤ V ⊓ L := le_inf (hP₁U.trans hUV) (hP₁.1.trans inf_le_right)
