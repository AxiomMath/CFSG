private theorem borelData_L2Four {A : Type} [Group A] [Finite A]
    (hA : IsL2 A 2) (S : Sylow 2 A) :
    IsMulCommutative (normalizerQuotient (S : Subgroup A)) ∧
      3 ∣ Nat.card (normalizerQuotient (S : Subgroup A)) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hcardA : Nat.card A = 60 := by
    rw [card_of_isL2 hA]
    norm_num
  have : IsSimpleGroup A :=
    CFSG.Blueprint.LieModel.isSimpleGroup_of_mem_classicalTags (by decide) hA
  obtain ⟨eA⟩ :=
    CFSG.QuasithinUnique.nonempty_mulEquiv_alternatingGroup_five_of_card_sixty hcardA
  let P : Sylow 2 (alternatingGroup (Fin 5)) :=
    S.mapSurjective (f := eA.toMonoidHom) eA.surjective
  have hcardS : Nat.card (S : Subgroup A) = 4 := by
    rw [← Subgroup.card_map_of_injective (f := eA.toMonoidHom) eA.injective,
      ← Sylow.coe_mapSurjective (P := S) (f := eA.toMonoidHom) eA.surjective]
    exact CFSG.GroupTheory.AlternatingFive.card_sylow_two_eq P
  have hcardN : Nat.card (Subgroup.normalizer ((S : Subgroup A) : Set A)) = 12 := by
    rw [← Subgroup.card_map_of_injective (f := eA.toMonoidHom) eA.injective,
      Subgroup.map_equiv_normalizer_eq (S : Subgroup A) eA,
      ← Sylow.coe_mapSurjective (P := S) (f := eA.toMonoidHom) eA.surjective]
    exact CFSG.GroupTheory.AlternatingFive.card_normalizer_sylow_two P
  have hsub : Nat.card ((S : Subgroup A).subgroupOf
      (Subgroup.normalizer ((S : Subgroup A) : Set A))) = 4 := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe
      (Subgroup.le_normalizer (H := (S : Subgroup A)))).toEquiv, hcardS]
  have hmul := Subgroup.card_eq_card_quotient_mul_card_subgroup
    ((S : Subgroup A).subgroupOf (Subgroup.normalizer ((S : Subgroup A) : Set A)))
  rw [hcardN, hsub] at hmul
  have hcardQ : Nat.card (normalizerQuotient (S : Subgroup A)) = 3 := by
    have hq : Nat.card (normalizerQuotient (S : Subgroup A)) * 4 = 12 := hmul.symm
    have h3 : (3 : ℕ) * 4 = 12 := by norm_num
    exact Nat.eq_of_mul_eq_mul_right (by norm_num : 0 < 4) (hq.trans h3.symm)
  have : IsCyclic (normalizerQuotient (S : Subgroup A)) := isCyclic_of_prime_card hcardQ
  exact ⟨IsCyclic.isMulCommutative, hcardQ ▸ dvd_rfl⟩

private theorem borelData_U3Four {B : Type} [Group B] [Finite B]
    (hB : IsU3 B 2) (S : Sylow 2 B) :
    IsMulCommutative (normalizerQuotient (S : Subgroup B)) ∧
      3 ∣ Nat.card (normalizerQuotient (S : Subgroup B)) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hSC : StatedClassicalModel B .PSU 3 2 2 :=
    CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by norm_num) hB
  have hcardB : Nat.card B = 62400 := by
    have h := card_mul_gcd_of_isU3 hB
    rw [show Nat.gcd 3 (2 ^ 2 + 1) = 1 by norm_num, mul_one] at h
    calc Nat.card B
        = 2 ^ (3 * 2) * ((2 ^ (2 * 2) - 1) * (2 ^ (3 * 2) + 1)) := h
      _ = 62400 := by norm_num
  have hSyl : Nat.card (Sylow 2 B) = 65 := by
    have h := CFSG.CGT.Timmesfeld75.card_sylow_psu3 hSC
    calc Nat.card (Sylow 2 B) = 2 ^ (3 * 2) + 1 := h
      _ = 65 := by norm_num
  have : Finite (Sylow 2 B) := Nat.finite_of_card_ne_zero (by rw [hSyl]; norm_num)
  have hidx : (Subgroup.normalizer ((S : Subgroup B) : Set B)).index = 65 := by
    have h := Sylow.card_eq_index_normalizer S
    rw [hSyl] at h
    exact h.symm
  have hmulN := Subgroup.card_mul_index
    (Subgroup.normalizer ((S : Subgroup B) : Set B))
  rw [hidx, hcardB] at hmulN
  have hcardN : Nat.card (Subgroup.normalizer ((S : Subgroup B) : Set B)) = 960 := by
    omega
  have hcardS : Nat.card (S : Subgroup B) = 64 := by
    have h :=
      (CFSG.LocalAnalysis.EvenBN.GMSK.fusionBenderBorel_of_lieModel_PSU3 hB S).2.2.2.2
    calc Nat.card (S : Subgroup B) = (2 ^ 2) ^ 3 := h
      _ = 64 := by norm_num
  have hsub : Nat.card ((S : Subgroup B).subgroupOf
      (Subgroup.normalizer ((S : Subgroup B) : Set B))) = 64 := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe
      (Subgroup.le_normalizer (H := (S : Subgroup B)))).toEquiv, hcardS]
  have hmulQ := Subgroup.card_eq_card_quotient_mul_card_subgroup
    ((S : Subgroup B).subgroupOf (Subgroup.normalizer ((S : Subgroup B) : Set B)))
  rw [hcardN, hsub] at hmulQ
  have hcardQ : Nat.card (normalizerQuotient (S : Subgroup B)) = 15 := by
    have hq : Nat.card (normalizerQuotient (S : Subgroup B)) * 64 = 960 := hmulQ.symm
    have h15 : (15 : ℕ) * 64 = 960 := by norm_num
    exact Nat.eq_of_mul_eq_mul_right (by norm_num : 0 < 64) (hq.trans h15.symm)
  have : IsCyclic (normalizerQuotient (S : Subgroup B)) :=
    CFSG.Sporadic.Co1Schreier.OddGen.isCyclic_of_card_dvd_fifteen (by rw [hcardQ])
  exact ⟨IsCyclic.isMulCommutative, by rw [hcardQ]; norm_num⟩

private theorem borelData_prod
    {X A B : Type} [Group X] [Finite X] [Group A] [Finite A] [Group B] [Finite B]
    (e : X ≃* A × B) (S : Sylow 2 X)
    (hAcomm : ∀ T : Sylow 2 A, IsMulCommutative (normalizerQuotient (T : Subgroup A)))
    (hAcard : ∀ T : Sylow 2 A, 3 ∣ Nat.card (normalizerQuotient (T : Subgroup A)))
    (hBcomm : ∀ T : Sylow 2 B, IsMulCommutative (normalizerQuotient (T : Subgroup B)))
    (hBcard : ∀ T : Sylow 2 B, 3 ∣ Nat.card (normalizerQuotient (T : Subgroup B))) :
    IsMulCommutative (normalizerQuotient (S : Subgroup X)) ∧
      ∃ E : Subgroup (normalizerQuotient (S : Subgroup X)),
        IsElemAbelian 3 E ∧ Nat.card E = 9 := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨SA⟩ := Sylow.nonempty (p := 2) (G := A)
  obtain ⟨SB⟩ := Sylow.nonempty (p := 2) (G := B)
  have hSA : IsSylowTwoOf (SA : Subgroup A) ⊤ := isSylowTwoOf_top_of_sylow SA
  have hSB : IsSylowTwoOf (SB : Subgroup B) ⊤ := isSylowTwoOf_top_of_sylow SB
  let R : Subgroup (A × B) := (SA : Subgroup A).prod (SB : Subgroup B)
  have hR : IsSylowTwoOf R ⊤ := isSylowTwoOf_prod hSA hSB
  let eN : normalizerQuotient (S : Subgroup X) ≃* normalizerQuotient R :=
    (normalizerQuotient_equiv_of_isSylowTwoOf (Y := X) (Y' := A × B)
      (S := (S : Subgroup X)) (S' := R) e (isSylowTwoOf_top_of_sylow S) hR).some
  let eP : normalizerQuotient R ≃*
      normalizerQuotient (SA : Subgroup A) × normalizerQuotient (SB : Subgroup B) :=
    (normalizerQuotient_prodMulEquiv (SA : Subgroup A) (SB : Subgroup B)).some
  let eQ : normalizerQuotient (S : Subgroup X) ≃*
      normalizerQuotient (SA : Subgroup A) × normalizerQuotient (SB : Subgroup B) :=
    eN.trans eP
  have : IsMulCommutative (normalizerQuotient (SA : Subgroup A)) := hAcomm SA
  have : IsMulCommutative (normalizerQuotient (SB : Subgroup B)) := hBcomm SB
  have hcommAB : IsMulCommutative (normalizerQuotient (SA : Subgroup A) ×
      normalizerQuotient (SB : Subgroup B)) := inferInstance
  have hcommX : IsMulCommutative (normalizerQuotient (S : Subgroup X)) :=
    CFSG.QuasiDihedralFusion.isMulCommutative_of_mulEquiv eQ.symm hcommAB
  obtain ⟨a, ha⟩ := exists_prime_orderOf_dvd_card' 3 (hAcard SA)
  obtain ⟨b, hb⟩ := exists_prime_orderOf_dvd_card' 3 (hBcard SB)
  obtain ⟨E, hEea, hEcard⟩ := exists_isElemAbelian_nine_prod_of_orderOf_three ha hb
  refine ⟨hcommX, ⟨E.map eQ.symm.toMonoidHom, hEea.map eQ.symm.toMonoidHom, ?_⟩⟩
  rw [Subgroup.card_map_of_injective (f := eQ.symm.toMonoidHom) eQ.symm.injective, hEcard]

theorem k_A5U34BorelQuotient_holds : K_A5U34BorelQuotient := by
  intro X _ _ n hn hshape
  subst n
  refine ⟨k_OutL2U3Product_holds X 2 (by norm_num) ⟨1, by norm_num⟩ hshape, ?_⟩
  intro S
  rcases hshape with hsq | hprod
  · obtain ⟨A, B, gA, gB, ⟨e⟩, hA, hB⟩ := hsq
    let : Group A := gA
    let : Group B := gB
    have : Finite A := CFSG.LieType.Simplicity.finite_of_statedClassicalModel
      (CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by norm_num) hA)
    have : Finite B := CFSG.LieType.Simplicity.finite_of_statedClassicalModel
      (CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by norm_num) hB)
    exact borelData_prod e S
      (fun T => (borelData_L2Four hA T).1) (fun T => (borelData_L2Four hA T).2)
      (fun T => (borelData_L2Four hB T).1) (fun T => (borelData_L2Four hB T).2)
  · obtain ⟨A, B, gA, gB, ⟨e⟩, hA, hB⟩ := hprod
    let : Group A := gA
    let : Group B := gB
    have : Finite A := CFSG.LieType.Simplicity.finite_of_statedClassicalModel
      (CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by norm_num) hA)
    have : Finite B := CFSG.LieType.Simplicity.finite_of_statedClassicalModel
      (CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by norm_num) hB)
    exact borelData_prod e S
      (fun T => (borelData_L2Four hA T).1) (fun T => (borelData_L2Four hA T).2)
      (fun T => (borelData_U3Four hB T).1) (fun T => (borelData_U3Four hB T).2)

