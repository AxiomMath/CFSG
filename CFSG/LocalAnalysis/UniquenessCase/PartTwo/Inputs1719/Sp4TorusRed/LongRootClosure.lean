local notation "spMat " g =>
  (((g : StatedSp 2 K) : GL (Fin 2 ⊕ Fin 2) K) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) K)

@[expose] def centres (H : Subgroup (StatedSp 2 K)) : Set (Fin 2 ⊕ Fin 2 → K) :=
  {v | ∀ c : K, K7.trv v c ∈ H}

theorem bil_single_inl (x : Fin 2 ⊕ Fin 2 → K) (i : Fin 2) :
    Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) x (Pi.single (Sum.inl i) 1) =
      - x (Sum.inr i) := by
  rw [CFSG.Quasithin.Vol2.KGNat.toBilin'_spJ_apply]
  simp [Pi.single_apply]

theorem bil_single_inr (x : Fin 2 ⊕ Fin 2 → K) (i : Fin 2) :
    Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) x (Pi.single (Sum.inr i) 1) =
      x (Sum.inl i) := by
  rw [CFSG.Quasithin.Vol2.KGNat.toBilin'_spJ_apply]
  simp [Pi.single_apply]

theorem bil_single_inl_left (w : Fin 2 ⊕ Fin 2 → K) (i : Fin 2) :
    Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) (Pi.single (Sum.inl i) 1) w =
      w (Sum.inr i) := by
  rw [CFSG.Quasithin.Vol2.KGNat.toBilin'_spJ_apply]
  simp [Pi.single_apply]

theorem bil_single_inr_left (w : Fin 2 ⊕ Fin 2 → K) (i : Fin 2) :
    Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) (Pi.single (Sum.inr i) 1) w =
      - w (Sum.inl i) := by
  rw [CFSG.Quasithin.Vol2.KGNat.toBilin'_spJ_apply]
  simp [Pi.single_apply]

theorem trv_single_inl (i : Fin 2) (s : K) :
    K7.trv (Pi.single (Sum.inl i) (1 : K)) s =
      pairRootElt (Sum.inl_ne_inr : (Sum.inl i : Fin 2 ⊕ Fin 2) ≠ Sum.inr i) (-s) := by
  refine K7.sp_ext fun x => ?_
  rw [K7.trv_mulVec, bil_single_inl,
    CFSG.LieType.Universal.Symplectic.SpExtras.mat_apply, coe_pairRootElt,
    pairRootMat_inl_inr_self, Matrix.add_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec,
    Matrix.single_mulVec_eq, smul_smul, one_mul]
  rw [show s * -x (Sum.inr i) = -s * x (Sum.inr i) by ring]

theorem trv_single_inr (i : Fin 2) (s : K) :
    K7.trv (Pi.single (Sum.inr i) (1 : K)) s =
      pairRootElt (Sum.inr_ne_inl : (Sum.inr i : Fin 2 ⊕ Fin 2) ≠ Sum.inl i) s := by
  refine K7.sp_ext fun x => ?_
  rw [K7.trv_mulVec, bil_single_inr,
    CFSG.LieType.Universal.Symplectic.SpExtras.mat_apply, coe_pairRootElt,
    pairRootMat_inr_inl_self, Matrix.add_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec,
    Matrix.single_mulVec_eq, smul_smul, one_mul]

theorem single_mem_centres_iff {H : Subgroup (StatedSp 2 K)} (a : Fin 2 ⊕ Fin 2) :
    Pi.single a 1 ∈ centres H ↔ ∀ s : K, pairRootElt (swap_ne_self a).symm s ∈ H := by
  rcases a with i | i
  · constructor
    · intro h s
      simpa [trv_single_inl] using h (-s)
    · intro h s
      simpa [trv_single_inl] using h (-s)
  · constructor
    · intro h s
      simpa [trv_single_inr] using h s
    · intro h s
      simpa [trv_single_inr] using h s

theorem smul_mem_centres {H : Subgroup (StatedSp 2 K)} {v : Fin 2 ⊕ Fin 2 → K}
    (hv : v ∈ centres H) (a : K) : a • v ∈ centres H := by
  intro c
  rw [K7.trv_smul]
  exact hv (a ^ 2 * c)

theorem mulVec_mem_centres {H : Subgroup (StatedSp 2 K)} {v : Fin 2 ⊕ Fin 2 → K}
    (hv : v ∈ centres H) {h : StatedSp 2 K} (hh : h ∈ H) : (spMat h) *ᵥ v ∈ centres H := by
  intro c
  change K7.trv ((CFSG.LieType.Universal.Symplectic.SpExtras.mat 2 K h) *ᵥ v) c ∈ H
  rw [← K7.trv_conj h v c]
  exact H.mul_mem (H.mul_mem hh (hv c)) (H.inv_mem hh)

theorem torus_mulVec_mem_centres {H : Subgroup (StatedSp 2 K)}
    (hT : torus 2 K ≤ Subgroup.normalizer (H : Set (StatedSp 2 K))) {v : Fin 2 ⊕ Fin 2 → K}
    (hv : v ∈ centres H) {d : StatedSp 2 K} (hd : d ∈ torus 2 K) :
    (spMat d) *ᵥ v ∈ centres H := by
  intro c
  change K7.trv ((CFSG.LieType.Universal.Symplectic.SpExtras.mat 2 K d) *ᵥ v) c ∈ H
  rw [← K7.trv_conj d v c]
  exact (Subgroup.mem_normalizer_iff.mp (hT hd) (K7.trv v c)).mp (hv c)

theorem add_smul_mem_centres {H : Subgroup (StatedSp 2 K)} {v w : Fin 2 ⊕ Fin 2 → K}
    (hv : v ∈ centres H) (hw : w ∈ centres H)
    (hvw : Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) v w ≠ 0) (α β : K) :
    α • v + β • w ∈ centres H := by
  have hwv : Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) w v ≠ 0 := by
    rw [((CFSG.Quasithin.Vol2.KGNat.toBilin'_spJ_isAlt (K := K)).neg_eq v w).symm]
    exact neg_ne_zero.mpr hvw
  have hleft : ∀ γ : K, v + γ • w ∈ centres H := by
    intro γ c
    have hmem := mulVec_mem_centres hv
      (hw (γ * (Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) v w)⁻¹)) c
    change K7.trv ((CFSG.LieType.Universal.Symplectic.SpExtras.mat 2 K
      (K7.trv w (γ * (Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) v w)⁻¹))) *ᵥ v) c ∈ H
      at hmem
    rwa [K7.trv_mulVec,
      show γ * (Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) v w)⁻¹ *
        Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) v w = γ by
        rw [mul_assoc, inv_mul_cancel₀ hvw, mul_one]] at hmem
  have hright : ∀ γ : K, w + γ • v ∈ centres H := by
    intro γ c
    have hmem := mulVec_mem_centres hw
      (hv (γ * (Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) w v)⁻¹)) c
    change K7.trv ((CFSG.LieType.Universal.Symplectic.SpExtras.mat 2 K
      (K7.trv v (γ * (Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) w v)⁻¹))) *ᵥ w) c ∈ H
      at hmem
    rwa [K7.trv_mulVec,
      show γ * (Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) w v)⁻¹ *
        Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) w v = γ by
        rw [mul_assoc, inv_mul_cancel₀ hwv, mul_one]] at hmem
  by_cases hα : α = 0
  · subst α
    simpa using smul_mem_centres hw β
  · have hαβ : α • v + β • w = α • (v + (β / α) • w) := by
      rw [smul_add, smul_smul, mul_div_cancel₀ β hα]
    rw [hαβ]
    exact smul_mem_centres (hleft (β / α)) α

theorem torusHom_mulVec_apply (s : Fin 2 → Kˣ) (x : Fin 2 ⊕ Fin 2 → K) (k : Fin 2 ⊕ Fin 2) :
    ((spMat (torusHom s)) *ᵥ x) k =
      (Sum.elim (fun i => (s i : K)) (fun i => (((s i)⁻¹ : Kˣ) : K)) k) * x k := by
  rw [coe_torusHom, Matrix.mulVec_diagonal]

theorem torus_mulSingle_mulVec_apply (a : Kˣ) (i : Fin 2) (x : Fin 2 ⊕ Fin 2 → K)
    (k : Fin 2 ⊕ Fin 2) :
    ((spMat (torusHom (Pi.mulSingle i a))) *ᵥ x) k =
      (if k = Sum.inl i then (a : K) else if k = Sum.inr i then ((a⁻¹ : Kˣ) : K) else 1) *
        x k := by
  rw [torusHom_mulVec_apply]
  rcases k with k | k <;> by_cases h : k = i <;> simp [Pi.mulSingle_apply, h]

theorem torus_mulSingle_mulVec (a : Kˣ) (i : Fin 2) (x : Fin 2 ⊕ Fin 2 → K) :
    (spMat (torusHom (Pi.mulSingle i a))) *ᵥ x =
      x + (((a : K) - 1) * x (Sum.inl i)) • Pi.single (Sum.inl i) 1 +
        ((((a⁻¹ : Kˣ) : K) - 1) * x (Sum.inr i)) • Pi.single (Sum.inr i) 1 := by
  funext k
  rw [torus_mulSingle_mulVec_apply]
  rcases k with k | k <;> by_cases h : k = i
  · subst h
    simp
    ring
  · simp [h]
  · subst h
    simp
    ring
  · simp [h]

theorem single_mem_centres_of_smul {H : Subgroup (StatedSp 2 K)} {c : K} (hc : c ≠ 0)
    {k : Fin 2 ⊕ Fin 2} (h : c • Pi.single k 1 ∈ centres H) :
    Pi.single k 1 ∈ centres H := by
  have := smul_mem_centres h c⁻¹
  rwa [smul_smul, inv_mul_cancel₀ hc, one_smul] at this

theorem bil_plane (i : Fin 2) (c d c' d' : K) :
    Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K)
        (c • Pi.single (Sum.inl i) 1 + d • Pi.single (Sum.inr i) 1)
        (c' • Pi.single (Sum.inl i) 1 + d' • Pi.single (Sum.inr i) 1) =
      c * d' - d * c' := by
  simp only [K7.bil_add_right, K7.bil_smul_right, bil_single_inl, bil_single_inr,
    Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.single_apply, mul_neg]
  simp only [Sum.inr_ne_inl, Sum.inl_ne_inr, if_false, if_true]
  ring

theorem bil_single_left (x : Fin 2 ⊕ Fin 2 → K) (i : Fin 2) (c d : K) :
    Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) x
        (c • Pi.single (Sum.inl i) 1 + d • Pi.single (Sum.inr i) 1) =
      c * -x (Sum.inr i) + d * x (Sum.inl i) := by
  rw [K7.bil_add_right, K7.bil_smul_right, K7.bil_smul_right, bil_single_inl, bil_single_inr]

theorem exists_sp4_unit_ne_one [Finite K] [CharP K 2] (hK : 8 ≤ Nat.card K) :
    ∃ a : Kˣ, (a : K) ≠ 1 ∧ (a : K) ^ 2 ≠ 1 := by
  obtain ⟨t, ht⟩ :=
    CFSG.LocalAnalysis.UniquenessCase.PartTwo.Inputs1719.TorusQS.exists_torusHom_diag_injective
      (K := K) hK
  refine ⟨t 0, ?_, ?_⟩
  · intro h
    refine (by decide : (Sum.inl (0 : Fin 2) : Fin 2 ⊕ Fin 2) ≠ Sum.inr 0) (ht ?_)
    simp [h]
  · intro h
    have h' : (t 0 : K) * (t 0 : K) = 1 := by simpa [sq] using h
    have ha : (t 0 : K) = (((t 0)⁻¹ : Kˣ) : K) := by
      simpa using eq_inv_of_mul_eq_one_right h'
    refine (by decide : (Sum.inl (0 : Fin 2) : Fin 2 ⊕ Fin 2) ≠ Sum.inr 0) (ht ?_)
    simpa using ha

