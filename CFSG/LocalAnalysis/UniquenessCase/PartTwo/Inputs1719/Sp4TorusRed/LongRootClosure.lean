theorem exists_sp4_torus_pair_data {H : Subgroup (StatedSp 2 K)}
    (hT : torus 2 K ≤ Subgroup.normalizer (H : Set (StatedSp 2 K))) {u : Fin 2 ⊕ Fin 2 → K}
    (hu : u ∈ centres H) {i : Fin 2} (h1 : u (Sum.inl i) ≠ 0) (h2 : u (Sum.inr i) ≠ 0)
    {a : Kˣ} (ha1 : (a : K) ≠ 1) (ha2 : (a : K) ^ 2 ≠ 1) :
    ∃ (u0 w0 : Fin 2 ⊕ Fin 2 → K) (ce cf : K),
      u0 ∈ centres H ∧ w0 ∈ centres H ∧
      u0 = ce • Pi.single (Sum.inl i) 1 + cf • Pi.single (Sum.inr i) 1 ∧
      w0 = ((a : K) * ce) • Pi.single (Sum.inl i) 1 +
        ((((a⁻¹ : Kˣ) : K) * cf) • Pi.single (Sum.inr i) 1) ∧
      ce ≠ 0 ∧ cf ≠ 0 ∧
      Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) u0 w0 ≠ 0 := by
  have hainv1 : (((a⁻¹ : Kˣ) : K)) ≠ 1 := by
    intro h
    apply ha1
    have h' : a⁻¹ = 1 := Units.ext h
    rw [← inv_inv a, h', inv_one]
    rfl
  have hainv_ne : (((a⁻¹ : Kˣ) : K)) ≠ (a : K) := by
    intro h
    apply ha2
    have hmul : (a : K) * (((a⁻¹ : Kˣ) : K)) = 1 := by
      rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
    rw [h] at hmul
    simpa [sq] using hmul
  have h1a : ((a : K) - 1) ≠ 0 := sub_ne_zero.mpr ha1
  have h1ia : ((((a⁻¹ : Kˣ) : K)) - 1) ≠ 0 := sub_ne_zero.mpr hainv1
  set e : Fin 2 ⊕ Fin 2 → K := Pi.single (Sum.inl i) 1 with he
  set f : Fin 2 ⊕ Fin 2 → K := Pi.single (Sum.inr i) 1 with hf
  set d : StatedSp 2 K := torusHom (Pi.mulSingle i a) with hd
  set ce : K := ((a : K) - 1) * u (Sum.inl i) with hce
  set cf : K := ((((a⁻¹ : Kˣ) : K)) - 1) * u (Sum.inr i) with hcf
  set w : Fin 2 ⊕ Fin 2 → K := (spMat d) *ᵥ u with hw
  have hdT : d ∈ torus 2 K := torusHom_mem_torus (Pi.mulSingle i a)
  have hwC : w ∈ centres H := torus_mulVec_mem_centres hT hu hdT
  have hw_form : w = u + ce • e + cf • f := by
    rw [hw, hd, torus_mulSingle_mulVec, he, hf, hce, hcf]
  have hce0 : ce ≠ 0 := by
    rw [hce]
    exact mul_ne_zero h1a h1
  have hcf0 : cf ≠ 0 := by
    rw [hcf]
    exact mul_ne_zero h1ia h2
  have hsub : (((a⁻¹ : Kˣ) : K)) - (a : K) ≠ 0 := sub_ne_zero.mpr hainv_ne
  have hBuw : Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) u w ≠ 0 := by
    rw [hw_form]
    rw [show u + ce • e + cf • f = u + (ce • e + cf • f) by abel]
    rw [K7.bil_add_right, K7.bil_self, zero_add, bil_single_left]
    intro hzero
    have hprod : (((a⁻¹ : Kˣ) : K) - (a : K)) * u (Sum.inl i) * u (Sum.inr i) ≠ 0 :=
      mul_ne_zero (mul_ne_zero hsub h1) h2
    apply hprod
    rw [hce, hcf] at hzero
    linear_combination hzero
  have hu0 : u + w ∈ centres H := by
    have h := add_smul_mem_centres hu hwC hBuw 1 1
    simpa using h
  have hu0_form : u + w = ce • e + cf • f := by
    rw [hw_form]
    calc u + (u + ce • e + cf • f) = (u + u) + (ce • e + cf • f) := by abel
      _ = ce • e + cf • f := by rw [CharTwo.add_self_eq_zero, zero_add]
  have hw0 : (spMat d) *ᵥ (u + w) ∈ centres H := torus_mulVec_mem_centres hT hu0 hdT
  have hw0_form : (spMat d) *ᵥ (u + w) =
      ((a : K) * ce) • e + ((((a⁻¹ : Kˣ) : K) * cf) • f) := by
    calc (spMat d) *ᵥ (u + w) = (spMat d) *ᵥ (ce • e + cf • f) := by rw [hu0_form]
      _ = ((a : K) * ce) • e + ((((a⁻¹ : Kˣ) : K) * cf) • f) := by
        rw [hd, torus_mulSingle_mulVec]
        ext k
        rcases k with k | k <;> by_cases h : k = i
        · subst h
          simp [he, hf]
          ring
        · simp [he, hf, h]
        · subst h
          simp [he, hf]
          ring
        · simp [he, hf, h]
  have hB0 : Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) (u + w)
      ((spMat d) *ᵥ (u + w)) ≠ 0 := by
    rw [hw0_form, hu0_form, bil_plane]
    intro hzero
    have hprod : (((a⁻¹ : Kˣ) : K) - (a : K)) * ce * cf ≠ 0 :=
      mul_ne_zero (mul_ne_zero hsub hce0) hcf0
    apply hprod
    linear_combination hzero
  exact ⟨u + w, (spMat d) *ᵥ (u + w), ce, cf, hu0, hw0, hu0_form, hw0_form,
    hce0, hcf0, hB0⟩

omit [Finite K] in
theorem single_pair_mem_centres_of_data {H : Subgroup (StatedSp 2 K)} {i : Fin 2} {a : Kˣ}
    (ha2 : (a : K) ^ 2 ≠ 1) {u0 w0 : Fin 2 ⊕ Fin 2 → K} {ce cf : K}
    (hu0 : u0 ∈ centres H) (hw0 : w0 ∈ centres H)
    (hu0_form : u0 = ce • Pi.single (Sum.inl i) 1 + cf • Pi.single (Sum.inr i) 1)
    (hw0_form : w0 = ((a : K) * ce) • Pi.single (Sum.inl i) 1 +
      ((((a⁻¹ : Kˣ) : K) * cf) • Pi.single (Sum.inr i) 1))
    (hce : ce ≠ 0) (hcf : cf ≠ 0)
    (hB0 : Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) u0 w0 ≠ 0) :
    Pi.single (Sum.inl i) 1 ∈ centres H ∧ Pi.single (Sum.inr i) 1 ∈ centres H := by
  have hak_inv : (a : K) * (((a⁻¹ : Kˣ) : K)) = 1 := by
    rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  have hsum1 : u0 + (a : K) • w0 ∈ centres H := by
    have h := add_smul_mem_centres hu0 hw0 hB0 1 (a : K)
    simpa using h
  have hsum2 : u0 + (((a⁻¹ : Kˣ) : K)) • w0 ∈ centres H := by
    have h := add_smul_mem_centres hu0 hw0 hB0 1 (((a⁻¹ : Kˣ) : K))
    simpa using h
  have hsum1_form : u0 + (a : K) • w0 =
      ((1 + (a : K) ^ 2) * ce) • Pi.single (Sum.inl i) 1 := by
    rw [hu0_form, hw0_form]
    ext k
    rcases k with k | k <;> by_cases h : k = i
    · subst h
      simp
      ring
    · simp [h]
    · subst h
      simp
      exact CharTwo.add_self_eq_zero cf
    · simp [h]
  have hsum2_form : u0 + (((a⁻¹ : Kˣ) : K)) • w0 =
      ((1 + (((a⁻¹ : Kˣ) : K)) ^ 2) * cf) • Pi.single (Sum.inr i) 1 := by
    rw [hu0_form, hw0_form]
    ext k
    rcases k with k | k <;> by_cases h : k = i
    · subst h
      simp
      exact CharTwo.add_self_eq_zero ce
    · simp [h]
    · subst h
      simp
      ring
    · simp [h]
  have h1a2 : 1 + (a : K) ^ 2 ≠ 0 := by
    intro h
    apply ha2
    have h' : (a : K) ^ 2 - 1 = 0 := by
      simpa [sub_eq_add_neg, CharTwo.neg_eq, add_comm] using h
    exact sub_eq_zero.mp h'
  have h1ainv2 : 1 + (((a⁻¹ : Kˣ) : K)) ^ 2 ≠ 0 := by
    intro h
    apply ha2
    have h' : (((a⁻¹ : Kˣ) : K)) ^ 2 = 1 := by
      have h'' : (((a⁻¹ : Kˣ) : K)) ^ 2 - 1 = 0 := by
        simpa [sub_eq_add_neg, CharTwo.neg_eq, add_comm] using h
      exact sub_eq_zero.mp h''
    rw [Units.val_inv_eq_inv_val, inv_pow] at h'
    exact inv_eq_one.mp h'
  constructor
  · have hc : (1 + (a : K) ^ 2) * ce ≠ 0 := mul_ne_zero h1a2 hce
    have h := single_mem_centres_of_smul hc (by rw [← hsum1_form]; exact hsum1)
    simpa using h
  · have hc : (1 + (((a⁻¹ : Kˣ) : K)) ^ 2) * cf ≠ 0 := mul_ne_zero h1ainv2 hcf
    have h := single_mem_centres_of_smul hc (by rw [← hsum2_form]; exact hsum2)
    simpa using h

theorem single_mem_centres_of_apply_ne_zero (hK : 8 ≤ Nat.card K) {H : Subgroup (StatedSp 2 K)}
    (hT : torus 2 K ≤ Subgroup.normalizer (H : Set (StatedSp 2 K))) {u : Fin 2 ⊕ Fin 2 → K}
    (hu : u ∈ centres H) {i : Fin 2} (h1 : u (Sum.inl i) ≠ 0) (h2 : u (Sum.inr i) ≠ 0) :
    Pi.single (Sum.inl i) 1 ∈ centres H ∧ Pi.single (Sum.inr i) 1 ∈ centres H := by
  obtain ⟨a, ha1, ha2⟩ := exists_sp4_unit_ne_one (K := K) hK
  obtain ⟨u0, w0, ce, cf, hu0, hw0, hu0_form, hw0_form, hce, hcf, hB0⟩ :=
    exists_sp4_torus_pair_data hT hu h1 h2 ha1 ha2
  exact single_pair_mem_centres_of_data ha2 hu0 hw0 hu0_form hw0_form hce hcf hB0

omit [Finite K] [CharP K 2] in
theorem torus_mulSingle_mulVec_single_inl (a : Kˣ) (i : Fin 2) :
    (spMat (torusHom (Pi.mulSingle i a))) *ᵥ Pi.single (Sum.inl i) 1 =
      (a : K) • Pi.single (Sum.inl i) 1 := by
  funext k
  rw [torus_mulSingle_mulVec_apply]
  rcases k with k | k <;> by_cases h : k = i <;> simp [h]

omit [Finite K] [CharP K 2] in
theorem torus_mulSingle_mulVec_single_inr (a : Kˣ) (i : Fin 2) :
    (spMat (torusHom (Pi.mulSingle i a))) *ᵥ Pi.single (Sum.inr i) 1 =
      (((a⁻¹ : Kˣ) : K)) • Pi.single (Sum.inr i) 1 := by
  funext k
  rw [torus_mulSingle_mulVec_apply]
  rcases k with k | k <;> by_cases h : k = i <;> simp [h]

omit [Finite K] [CharP K 2] in
theorem torus_mulSingle_mulVec_smul_inl (a : Kˣ) (i : Fin 2) (c : K) :
    (spMat (torusHom (Pi.mulSingle i a))) *ᵥ (c • Pi.single (Sum.inl i) 1) =
      (a : K) • (c • Pi.single (Sum.inl i) 1) := by
  rw [Matrix.mulVec_smul, torus_mulSingle_mulVec_single_inl, smul_smul, smul_smul, mul_comm]

omit [Finite K] [CharP K 2] in
theorem torus_mulSingle_mulVec_smul_inr (a : Kˣ) (i : Fin 2) (c : K) :
    (spMat (torusHom (Pi.mulSingle i a))) *ᵥ (c • Pi.single (Sum.inr i) 1) =
      (((a⁻¹ : Kˣ) : K)) • (c • Pi.single (Sum.inr i) 1) := by
  rw [Matrix.mulVec_smul, torus_mulSingle_mulVec_single_inr, smul_smul, smul_smul, mul_comm]

omit [Finite K] [CharP K 2] in
theorem torus_mulSingle_fixes_off (a : Kˣ) (i : Fin 2) (w : Fin 2 ⊕ Fin 2 → K)
    (h1 : w (Sum.inl i) = 0) (h2 : w (Sum.inr i) = 0) :
    (spMat (torusHom (Pi.mulSingle i a))) *ᵥ w = w := by
  funext k
  rw [torus_mulSingle_mulVec_apply]
  rcases k with k | k <;> by_cases h : k = i
  · subst h
    simp [h1]
  · simp [h]
  · subst h
    simp [h2]
  · simp [h]

omit [Finite K] in
theorem trv_four_mul {y vB : Fin 2 ⊕ Fin 2 → K}
    (hy : Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) y vB = 0) (a c : K) :
    K7.trv (a • y + vB) c * K7.trv (a • y) c * K7.trv (y + vB) (c * a) *
        K7.trv y (c * a) =
      K7.trv vB (c * (1 + a)) := by
  have hy' : Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) vB y = 0 := by
    rw [K7.bil_comm, hy]
  refine K7.sp_ext fun x => ?_
  simp only [map_mul, ← Matrix.mulVec_mulVec]
  rw [K7.trv_mulVec, K7.trv_mulVec, K7.trv_mulVec, K7.trv_mulVec, K7.trv_mulVec]
  simp only [K7.bil_add_left, K7.bil_add_right, K7.bil_smul_left, K7.bil_smul_right,
    K7.bil_self, hy, hy', mul_zero, add_zero, smul_smul]
  match_scalars <;> ring_nf <;> simp [CharTwo.two_eq_zero]

omit [Finite K] in
theorem proj_mem_centres_of_data {H : Subgroup (StatedSp 2 K)}
    (hT : torus 2 K ≤ Subgroup.normalizer (H : Set (StatedSp 2 K))) {y vB v' : Fin 2 ⊕ Fin 2 → K}
    (hy : y ∈ centres H) (hv' : v' ∈ centres H) (hv'_eq : v' = y + vB)
    (hB : Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) y vB = 0)
    {a : K} (ha : a ≠ 1) {d : StatedSp 2 K} (hd : d ∈ torus 2 K)
    (hdy : (spMat d) *ᵥ y = a • y) (hdvB : (spMat d) *ᵥ vB = vB) :
    vB ∈ centres H := by
  have hdv' : (spMat d) *ᵥ v' ∈ centres H := torus_mulVec_mem_centres hT hv' hd
  have hdyv : a • y + vB ∈ centres H := by
    have h := hdv'
    rw [hv'_eq, Matrix.mulVec_add, hdy, hdvB] at h
    exact h
  have hay : a • y ∈ centres H := smul_mem_centres hy a
  have hyv : y + vB ∈ centres H := by simpa [hv'_eq] using hv'
  have key : ∀ c : K, K7.trv vB (c * (1 + a)) ∈ H := by
    intro c
    have hmul : K7.trv (a • y + vB) c * K7.trv (a • y) c *
        K7.trv (y + vB) (c * a) * K7.trv y (c * a) ∈ H :=
      H.mul_mem (H.mul_mem (H.mul_mem (hdyv c) (hay c)) (hyv (c * a))) (hy (c * a))
    rwa [trv_four_mul hB a c] at hmul
  have h1a : 1 + a ≠ 0 := by
    intro h
    apply ha
    have h' : a - 1 = 0 := by
      simpa [sub_eq_add_neg, CharTwo.neg_eq, add_comm] using h
    exact sub_eq_zero.mp h'
  intro s
  have h := key (s * (1 + a)⁻¹)
  rwa [mul_assoc, inv_mul_cancel₀ h1a, mul_one] at h

theorem proj_mem_centres (hK : 8 ≤ Nat.card K) {H : Subgroup (StatedSp 2 K)}
    (hT : torus 2 K ≤ Subgroup.normalizer (H : Set (StatedSp 2 K))) {i : Fin 2}
    (he : Pi.single (Sum.inl i) 1 ∈ centres H) (hf : Pi.single (Sum.inr i) 1 ∈ centres H)
    {v : Fin 2 ⊕ Fin 2 → K} (hv : v ∈ centres H) :
    (fun k => if k = Sum.inl i ∨ k = Sum.inr i then 0 else v k) ∈ centres H := by
  obtain ⟨a, ha1, ha2⟩ := exists_sp4_unit_ne_one (K := K) hK
  set vB : Fin 2 ⊕ Fin 2 → K :=
    fun k => if k = Sum.inl i ∨ k = Sum.inr i then 0 else v k with hvB
  have hvB_inl : vB (Sum.inl i) = 0 := by simp [hvB]
  have hvB_inr : vB (Sum.inr i) = 0 := by simp [hvB]
  by_cases h2 : v (Sum.inr i) = 0
  · set y : Fin 2 ⊕ Fin 2 → K := v (Sum.inl i) • Pi.single (Sum.inl i) 1 with hydef
    have hy : y ∈ centres H := smul_mem_centres he _
    have hv'_eq : v = y + vB := by
      funext k
      rcases k with k | k <;> by_cases h : k = i <;>
        simp [y, vB, h, h2]
    have hB : Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) y vB = 0 := by
      rw [hydef, K7.bil_smul_left, bil_single_inl_left, hvB_inr, mul_zero]
    have hdy : (spMat (torusHom (Pi.mulSingle i a))) *ᵥ y = (a : K) • y := by
      rw [hydef, torus_mulSingle_mulVec_smul_inl]
    have hdvB : (spMat (torusHom (Pi.mulSingle i a))) *ᵥ vB = vB :=
      torus_mulSingle_fixes_off a i vB hvB_inl hvB_inr
    exact proj_mem_centres_of_data hT hy hv hv'_eq hB ha1
      (torusHom_mem_torus (Pi.mulSingle i a)) hdy hdvB
  · set y : Fin 2 ⊕ Fin 2 → K := v (Sum.inr i) • Pi.single (Sum.inr i) 1 with hydef
    have hy : y ∈ centres H := smul_mem_centres hf _
    have hBe : Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) v
        (Pi.single (Sum.inl i) 1) ≠ 0 := by
      rw [bil_single_inl]
      exact neg_ne_zero.mpr h2
    have hv' : v - v (Sum.inl i) • Pi.single (Sum.inl i) 1 ∈ centres H := by
      have h := add_smul_mem_centres hv he hBe 1 (-(v (Sum.inl i)))
      simpa [sub_eq_add_neg, neg_smul] using h
    have hv'_eq : v - v (Sum.inl i) • Pi.single (Sum.inl i) 1 = y + vB := by
      funext k
      rcases k with k | k <;> by_cases h : k = i <;>
        simp [y, vB, h]
    have hB : Matrix.toBilin' (CFSG.Quasithin.Vol2.KGNat.spJ K) y vB = 0 := by
      rw [hydef, K7.bil_smul_left, bil_single_inr_left, hvB_inl, neg_zero, mul_zero]
    have hdy : (spMat (torusHom (Pi.mulSingle i (a⁻¹)))) *ᵥ y = (a : K) • y := by
      rw [hydef, torus_mulSingle_mulVec_smul_inr]
      simp
    have hdvB : (spMat (torusHom (Pi.mulSingle i (a⁻¹)))) *ᵥ vB = vB :=
      torus_mulSingle_fixes_off (a⁻¹) i vB hvB_inl hvB_inr
    exact proj_mem_centres_of_data hT hy hv' hv'_eq hB ha1
      (torusHom_mem_torus (Pi.mulSingle i (a⁻¹))) hdy hdvB

