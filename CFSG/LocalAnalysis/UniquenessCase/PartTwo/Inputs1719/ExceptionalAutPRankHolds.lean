theorem k_ExceptionalAutPRank_holds :
    ∀ (X : Type) [Group X] [Finite X] (r p : ℕ),
      r.Prime → r ≠ 2 → p.Prime → p ≠ 2 → p ≠ r →
      CFSG.Open.IsQuasisimple X →
      (LieModel (X ⧸ Subgroup.center X) .G2 0 r 1 ∨
        LieModel (X ⧸ Subgroup.center X) .PSp 2 r 1) →
      ¬ p ∣ r ^ 2 - 1 →
      CFSG.Open.pRank p (⊤ : Subgroup (MulAut X)) ≤ 1 := by
  intro X _ _ r p hr hr2 hp hp2 hpr hq hexc hnd
  have hp1 : 1 < p := hp.one_lt
  have : Fact p.Prime := ⟨hp⟩
  have hp5 : 5 ≤ p := by
    have hp3 : p ≠ 3 := by
      rintro rfl
      have hr3 : r ≠ 3 := fun h => hpr h.symm
      have hr1 : 1 ≤ r := hr.one_le
      have hmod : r % 3 = 1 ∨ r % 3 = 2 := by
        have h0 : r % 3 ≠ 0 := by
          intro h0
          exact hr3 (((Nat.prime_dvd_prime_iff_eq Nat.prime_three hr).1
            (Nat.dvd_of_mod_eq_zero h0)).symm)
        omega
      have hfac : r ^ 2 - 1 = (r - 1) * (r + 1) := by
        zify [hr1, Nat.one_le_pow 2 r hr1]
        ring
      rcases hmod with h1 | h2
      · have hdvd : 3 ∣ r - 1 := Nat.dvd_of_mod_eq_zero (by omega)
        apply hnd
        rw [hfac]
        exact Dvd.dvd.mul_right hdvd (r + 1)
      · have hdvd : 3 ∣ r + 1 := Nat.dvd_of_mod_eq_zero (by omega)
        apply hnd
        rw [hfac]
        exact Dvd.dvd.mul_left hdvd (r - 1)
    exact Nat.Prime.five_le_of_ne_two_of_ne_three hp hp2 hp3
  refine (CFSG.HardMathSupport.Timmesfeld.ComponentBalance.pRank_mulAut_le_of_quasisimple
    hp1 hq).trans ?_
  rcases hexc with hG2 | hPSp
  ·
    have hcheb : ChevalleyExceptionalModel (X ⧸ Subgroup.center X) .G2 r 1 :=
      LieModel.chevalleyExceptionalModel hG2 (by decide)
    obtain ⟨K, hKf, hKfin, hK, ⟨e⟩⟩ :=
      CFSG.LieType.Chevalley.nonempty_mulEquiv_adjointGroup .G2 hcheb.2
    have hK' : Nat.card K = r := by simpa using hK
    have hKodd : Odd (Nat.card K) := by
      rw [hK']
      exact hr.odd_of_ne_two hr2
    have hpQ : ¬ p ∣ Nat.card K := by
      rw [hK']
      intro hd
      exact hpr ((Nat.prime_dvd_prime_iff_eq hp hr).1 hd)
    have hndK : ¬ p ∣ Nat.card K ^ 2 - 1 := by
      rwa [hK']
    have : Finite (adjointGroup .G2 K) := Finite.of_equiv (X ⧸ Subgroup.center X) e.toEquiv
    have hAut : CFSG.Open.pRank p (⊤ : Subgroup (MulAut (X ⧸ Subgroup.center X))) =
        CFSG.Open.pRank p (⊤ : Subgroup (MulAut (adjointGroup .G2 K))) :=
      CFSG.SectionRank.pRank_top_eq_of_mulEquiv hp1 (MulAut.congr e)
    rw [hAut]
    have hinner : CFSG.Open.pRank p (⊤ : Subgroup (adjointGroup .G2 K)) ≤ 1 := by
      by_cases hdvd : p ∣ Nat.card (adjointGroup .G2 K)
      · have h := pRank_le_one_G2_odd K hKodd hp hp5 hpQ hdvd hndK
        rwa [← CFSG.HardMathSupport.Timmesfeld.ComponentBalance.open_pRank_top_eq_pRank] at h
      · have h := GL83.I713.pRank_top_eq_zero_of_not_dvd hp hdvd
        omega
    have hZ : Subgroup.center (adjointGroup .G2 K) = ⊥ :=
      CFSG.LieType.Chevalley.center_adjointGroup_eq_bot
    have hAutLe := GL83.I713.pRank_mulAut_le (K := adjointGroup .G2 K) hp hZ
    have houter : CFSG.Open.pRank p (⊤ : Subgroup (Outer (adjointGroup .G2 K))) = 0 := by
      by_cases hr3 : r = 3
      · subst hr3
        have hcheb3 : ChevalleyExceptionalModel (X ⧸ Subgroup.center X) .G2 3 1 := hcheb
        have hcardL : Nat.card (Outer (X ⧸ Subgroup.center X)) = 2 :=
          OutFixCentralThree.card_outer_G2_three (X ⧸ Subgroup.center X) hcheb3
        have hcard : Nat.card (Outer (adjointGroup .G2 K)) = 2 := by
          rw [← Nat.card_congr (equivalence e).toEquiv]
          exact hcardL
        refine GL83.I713.pRank_top_eq_zero_of_not_dvd hp ?_
        rw [hcard]
        intro hd
        have := Nat.le_of_dvd (by norm_num) hd
        omega
      · have hcard : Nat.card (Outer (adjointGroup .G2 K)) = 1 := by
          obtain ⟨-, Θ, -, hsurj, hker, -⟩ :=
            CFSG.LieType.Chevalley.odd_F4_and_nonexceptional_G2_automorphism_normal_form
              (f := 1) hr hr2 (le_refl 1) K (by simpa using hK') .G2 (Or.inr ⟨rfl, hr3⟩)
          rw [CFSG.LieType.Chevalley.card_outer_eq_of_ker_eq_inner Θ hsurj hker,
            (CFSG.LocalAnalysis.ComponentInitial.card_ringAut_and_isCyclic (n := 1) hr K
              (by simpa using hK')).1]
        refine GL83.I713.pRank_top_eq_zero_of_not_dvd hp ?_
        rw [hcard]
        exact hp.not_dvd_one
    omega
  ·
    obtain ⟨-, -, F, hFf, hFfin, hFcard, ⟨e⟩⟩ :=
      CFSG.GH74.Generic.lieModel_psp_data hPSp
    have hF' : Nat.card F = r := by simpa using hFcard
    have hpF : ¬ p ∣ Nat.card F := by
      rw [hF']
      intro hd
      exact hpr ((Nat.prime_dvd_prime_iff_eq hp hr).1 hd)
    have hndF : ¬ p ∣ Nat.card F ^ 2 - 1 := by
      rwa [hF']
    have h3ord : 3 ≤ orderOf (Nat.card F : ZMod p) := by
      rw [← CFSG.GroupTheory.WeirSylow.ordMod_natCast]
      refine CFSG.GroupTheory.WeirSylow.three_le_ordMod_of_not_dvd_sq_sub_one ?_ ?_
      · intro hd
        have hd' : p ∣ Nat.card F := by exact_mod_cast hd
        exact hpF hd'
      · exact CFSG.GroupTheory.WeirSylow.not_intCast_dvd_sq_sub_one_of_not_dvd hndF
    have hdiv : (if Even (orderOf (Nat.card F : ZMod p)) then 2 * 2 else 2) /
        orderOf (Nat.card F : ZMod p) ≤ 1 := by
      by_cases he : Even (orderOf (Nat.card F : ZMod p))
      · rw [if_pos he]
        have h4 : 4 ≤ orderOf (Nat.card F : ZMod p) := by
          rcases he with ⟨k, hk⟩
          omega
        exact Nat.div_le_of_le_mul (by omega)
      · rw [if_neg he]
        exact Nat.div_le_of_le_mul (by omega)
    have : Finite (StatedProj (StatedSp 2 F)) :=
      Finite.of_equiv (X ⧸ Subgroup.center X) e.toEquiv
    have hSp : CFSG.Open.pRank p (⊤ : Subgroup (StatedSp 2 F)) ≤ 1 := by
      rw [CFSG.HardMathSupport.Timmesfeld.ComponentBalance.open_pRank_top_eq_pRank]
      exact CFSG.RankThree.PartOne.pRank_statedSp_le_one hp hp2 hpF hdiv
    have hScal : ∀ c : Fˣ,
        Matrix.GeneralLinearGroup.scalar (Fin 2 ⊕ Fin 2) c ∈ StatedSp 2 F → c ^ 2 = 1 :=
      fun c hc => (CFSG.Open.StatedAPI.scalar_mem_statedSp_iff (by norm_num) c).1 hc
    have hp2d : ¬ p ∣ 2 := by
      intro hd
      exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 hd)
    have hM : CFSG.Open.pRank p (⊤ : Subgroup (StatedProj (StatedSp 2 F))) ≤ 1 := by
      rw [CFSG.GroupTheory.WeirSylow.pRank_top_statedProj_eq (d := 2) hp2d hScal]
      exact hSp
    have hoddF : Odd (Nat.card F) := by
      rw [hF']
      exact hr.odd_of_ne_two hr2
    have hZ : Subgroup.center (StatedProj (StatedSp 2 F)) = ⊥ :=
      center_psp4_eq_bot (CFSG.ABGLocalTools.ringChar_ne_two_of_odd_card hoddF)
    have hAutLe := GL83.I713.pRank_mulAut_le (K := StatedProj (StatedSp 2 F)) hp hZ
    have hSC : StatedClassicalModel (StatedProj (StatedSp 2 F)) .PSp 2 r 1 :=
      LieModel.statedClassicalModel (LieModel.of_mulEquiv e hPSp) (by decide)
    have houter : CFSG.Open.pRank p (⊤ : Subgroup (Outer (StatedProj (StatedSp 2 F)))) = 0 := by
      have houtDvd : Nat.card (Outer (StatedProj (StatedSp 2 F))) ∣
          2 * 1 * Nat.gcd 2 (r - 1) := by
        simpa using
          (symplectic_model_outer_two_part_bound (StatedProj (StatedSp 2 F)) 2 r 1 hSC).2.1
      refine GL83.I713.pRank_top_eq_zero_of_not_dvd hp ?_
      intro hd
      have hd4 : p ∣ 4 := by
        refine hd.trans (houtDvd.trans ?_)
        have hg : Nat.gcd 2 (r - 1) ∣ 2 := Nat.gcd_dvd_left 2 (r - 1)
        calc 2 * 1 * Nat.gcd 2 (r - 1) = 2 * Nat.gcd 2 (r - 1) := by ring
          _ ∣ 2 * 2 := Nat.mul_dvd_mul (dvd_refl 2) hg
          _ = 4 := by norm_num
      have := Nat.le_of_dvd (by norm_num) hd4
      omega
    have hAut : CFSG.Open.pRank p (⊤ : Subgroup (MulAut (X ⧸ Subgroup.center X))) =
        CFSG.Open.pRank p (⊤ : Subgroup (MulAut (StatedProj (StatedSp 2 F)))) :=
      CFSG.SectionRank.pRank_top_eq_of_mulEquiv hp1 (MulAut.congr e)
    rw [hAut]
    omega

end CFSG.LocalAnalysis.UniquenessCase.PartTwo.Inputs1719
