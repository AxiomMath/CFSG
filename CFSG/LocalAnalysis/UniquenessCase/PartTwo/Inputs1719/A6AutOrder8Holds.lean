theorem isM10_of_mulEquiv {X X' : Type} [Group X] [Group X'] (e : X ≃* X') (h : IsM10 X') :
    IsM10 X := by
  obtain ⟨φ, hφ, ⟨eK⟩, hinv⟩ := h
  refine ⟨φ.comp e.toMonoidHom, hφ.comp e.surjective, ⟨?_⟩, fun x hx hx2 => ?_⟩
  · have hker : ((φ.comp e.toMonoidHom).ker).map e.toMonoidHom = φ.ker := by
      rw [← MonoidHom.comap_ker, Subgroup.map_comap_eq_self_of_surjective e.surjective]
    exact ((MulEquiv.subgroupMap e _).trans (MulEquiv.subgroupCongr hker)).trans eK
  · exact hinv (e x) (fun hk => hx (MonoidHom.mem_ker.mpr (MonoidHom.mem_ker.mp hk)))
      (by rw [← map_pow, hx2, map_one])

theorem isPGL2_of_mulEquiv {X X' : Type} [Group X] [Group X'] (e : X ≃* X') {q : ℕ}
    (h : CFSG.Quasithin.F6.IsPGL2 q X') : CFSG.Quasithin.F6.IsPGL2 q X := by
  obtain ⟨K, hK, hKf, hc, ⟨f⟩⟩ := h
  exact ⟨K, hK, hKf, hc, ⟨e.trans f⟩⟩

theorem isAutOf_of_mulEquiv {X X' L : Type} [Group X] [Group X'] [Group L] (e : X ≃* X')
    (h : IsAutOf X' L) : IsAutOf X L := by
  obtain ⟨f⟩ := h
  exact ⟨e.trans f⟩

theorem isM10_m10 : IsM10 ↥A6Models.m10 := by
  obtain ⟨-, ψ, -, -⟩ := CFSG.QuasithinUnique.Unc25K1.A6Model.exists_pslEquiv
  set N : Subgroup ↥A6Models.m10 := A6Models.psl29.subgroupOf A6Models.m10 with hN
  have hNc : Nat.card N = 360 := by
    rw [hN, Nat.card_congr (Subgroup.subgroupOfEquivOfLe Out21.A6.psl29_le_m10).toEquiv,
      card_psl29]
  have hidx : N.index = 2 := by
    have h := Subgroup.card_mul_index N
    rw [hNc, Out21.A6.card_m10] at h
    omega
  have : N.Normal := Subgroup.normal_of_index_eq_two hidx
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hq : Nat.card (↥A6Models.m10 ⧸ N) = 2 := by
    rw [← Subgroup.index_eq_card, hidx]
  have h2 : Nat.card (Multiplicative (ZMod 2)) = 2 := by
    rw [Nat.card_eq_fintype_card]; rfl
  let ι : (↥A6Models.m10 ⧸ N) ≃* Multiplicative (ZMod 2) := mulEquivOfPrimeCardEq hq h2
  let φ : ↥A6Models.m10 →* Multiplicative (ZMod 2) := ι.toMonoidHom.comp (QuotientGroup.mk' N)
  have hker : φ.ker = N := by
    ext x
    simp [φ, MonoidHom.mem_ker, QuotientGroup.eq_one_iff]
  refine ⟨φ, ι.surjective.comp (QuotientGroup.mk'_surjective N), ⟨?_⟩, fun x hx hx2 => hx ?_⟩
  · exact ((MulEquiv.subgroupCongr hker).trans
      (Subgroup.subgroupOfEquivOfLe Out21.A6.psl29_le_m10)).trans ψ
  · rw [hker, hN, Subgroup.mem_subgroupOf]
    refine Out21.A6.m10_involution_mem_psl29 x.2 ?_
    have := congrArg Subtype.val hx2
    simpa [pow_two] using this

