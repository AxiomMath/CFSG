open CFSG.QuasithinUnique.Unc25K1.A6Model in
theorem exists_autA6_embedding {A : Type} [Group A] (L₀ : Subgroup A) [L₀.Normal]
    (e₀ : ↥L₀ ≃* ↥(alternatingGroup (Fin 6))) (hC : Subgroup.centralizer (L₀ : Set A) = ⊥) :
    ∃ ι : A →* ↥A6Models.autA6, Function.Injective ι ∧
      A6Models.psl29 ≤ ι.range.map A6Models.autA6.subtype := by
  obtain ⟨θ, ψ, hθinj, hψθ⟩ := exists_pslEquiv
  let φ : ↥L₀ ≃* ↥A6Models.psl29 := e₀.trans ψ.symm
  let c : A →* MulAut ↥L₀ := MulAut.conjNormal (H := L₀)
  have hc : Function.Injective c :=
    CFSG.LocalAnalysis.EvenBN.Tits.I21L.a6aut_conjNormal_injective L₀ hC
  let ι : A →* ↥A6Models.autA6 := (thetaEquiv φ).toMonoidHom.comp c
  refine ⟨ι, (thetaEquiv φ).injective.comp hc, fun x hx => ?_⟩
  have hpslA : A6Models.psl29 ≤ A6Models.autA6 := psl29_le_s6.trans s6_le_autA6
  set l : ↥L₀ := φ.symm ⟨x, hx⟩ with hl
  have hιl : ι (l : A) = ⟨x, hpslA hx⟩ := by
    apply thetaEquiv_eq φ (c l)
    intro k
    have hck : c (l : A) k = l * k * l⁻¹ := by
      apply Subtype.ext
      simp [c, MulAut.conjNormal_apply]
    rw [hck, map_mul, map_mul, map_inv]
    simp [hl]
  exact ⟨ι l, ⟨l, rfl⟩, by rw [hιl]; rfl⟩

open CFSG.QuasithinUnique.Unc25K1.A6Model in
theorem k_A6AutOrder8_of_pgl29 (hP : CFSG.Quasithin.F6.IsPGL2 9 ↥A6Models.pgl29) :
    K_A6AutOrder8 := by
  intro A _ _ L₀ hL₀ hA6 hC ha
  have := hL₀
  obtain ⟨e₀⟩ := hA6
  obtain ⟨a, ha4, n, han⟩ := ha
  obtain ⟨θ, -, hθinj, -⟩ := exists_pslEquiv
  obtain ⟨ι, hι, hpsl⟩ := exists_autA6_embedding L₀ e₀ hC
  let B : Subgroup P10 := ι.range.map A6Models.autA6.subtype
  have hBle : B ≤ A6Models.autA6 := by
    rintro _ ⟨x, -, rfl⟩
    exact x.2
  have hσ : ∃ σ ∈ B, σ ∉ s6 := by
    refine ⟨(ι a : P10), ⟨ι a, ⟨a, rfl⟩, rfl⟩, fun hs => ha4 ?_⟩
    have hpow : (θ ⟨(ι a : P10), hs⟩) ^ 2 ^ n = 1 := by
      rw [← map_pow]
      have : (⟨(ι a : P10), hs⟩ : ↥s6) ^ 2 ^ n = 1 := by
        apply Subtype.ext
        simp only [SubmonoidClass.mk_pow, OneMemClass.coe_one]
        rw [← Subgroup.coe_pow, ← map_pow, han, map_one]
        rfl
      rw [this, map_one]
    have h4 := CFSG.Quasithin.H13.A6.perm6_pow_four_of_two hpow
    rw [← map_pow] at h4
    have h4' : (⟨(ι a : P10), hs⟩ : ↥s6) ^ 4 = 1 := hθinj (h4.trans (map_one θ).symm)
    have h4'' : ι (a ^ 4) = 1 := by
      rw [map_pow]
      apply Subtype.ext
      have := congrArg Subtype.val h4'
      simpa using this
    exact (map_eq_one_iff ι hι).mp h4''
  have hAB : A ≃* ↥B :=
    (MonoidHom.ofInjective hι).trans
      (ι.range.equivMapOfInjective _ A6Models.autA6.subtype_injective)
  rcases classify B hBle hpsl hσ with h | h | h
  · exact Or.inr (Or.inr (isPGL2_of_mulEquiv (hAB.trans (MulEquiv.subgroupCongr h)) hP))
  · exact Or.inr (Or.inl (isM10_of_mulEquiv (hAB.trans (MulEquiv.subgroupCongr h)) isM10_m10))
  · exact Or.inl (isAutOf_of_mulEquiv (hAB.trans (MulEquiv.subgroupCongr h)) isAutOf_autA6)


theorem pgl29_outer_eq : A6Models.tInv * A6Models.tMul ^ 3 =
    A6Models.perm10 [[0, 9], [1, 4], [5, 6], [3, 7], [2, 8]] := by decide +kernel

theorem pgl29_outer_mem : A6Models.tInv * A6Models.tMul ^ 3 ∈ A6Models.pgl29 :=
  A6Models.pgl29.mul_mem (Out21.A6.psl29_le_pgl29 Out21.A6.tInv_mem_psl29)
    (A6Models.pgl29.pow_mem Out21.A6.tMul_mem_pgl29 3)

theorem pgl29_outer_sq :
    (A6Models.tInv * A6Models.tMul ^ 3) * (A6Models.tInv * A6Models.tMul ^ 3) = 1 := by
  decide +kernel

theorem pgl29_outer_not_mem : A6Models.tInv * A6Models.tMul ^ 3 ∉ A6Models.psl29 := by
  rw [pgl29_outer_eq, mem_psl29_iff]
  decide +kernel

theorem map_inf_centralizer_pgl29 (t : ↥A6Models.pgl29) :
    (A6Models.psl29.subgroupOf A6Models.pgl29 ⊓
        Subgroup.centralizer ({t} : Set ↥A6Models.pgl29)).map A6Models.pgl29.subtype =
      A6Models.psl29 ⊓ Subgroup.centralizer ({(t : P10)} : Set P10) := by
  ext x
  simp only [Subgroup.mem_map, Subgroup.mem_inf, Subgroup.mem_subgroupOf,
    Subgroup.mem_centralizer_singleton_iff, Subgroup.coe_subtype]
  constructor
  · rintro ⟨y, ⟨hyJ, hyC⟩, rfl⟩
    exact ⟨hyJ, congrArg Subtype.val hyC⟩
  · rintro ⟨hx, hxC⟩
    exact ⟨⟨x, Out21.A6.psl29_le_pgl29 hx⟩, ⟨hx, Subtype.ext hxC⟩, rfl⟩

open CFSG.LocalAnalysis.EvenBN.Tits CFSG.LocalAnalysis.EvenBN.Tits.I21L in
theorem isPGL2_nine_pgl29 : CFSG.Quasithin.F6.IsPGL2 9 ↥A6Models.pgl29 := by
  set J : Subgroup ↥A6Models.pgl29 := A6Models.psl29.subgroupOf A6Models.pgl29 with hJ
  have hJc : Nat.card J = 360 := by
    rw [hJ, Nat.card_congr (Subgroup.subgroupOfEquivOfLe Out21.A6.psl29_le_pgl29).toEquiv,
      card_psl29]
  have hJn : J.Normal := by
    constructor
    intro x hx g
    rw [hJ, Subgroup.mem_subgroupOf] at hx ⊢
    exact psl29_normal g (Out21.A6.pgl29_le_autA6 g.2) x hx
  have hC : Subgroup.centralizer (J : Set ↥A6Models.pgl29) = ⊥ := by
    rw [eq_bot_iff]
    intro g hg
    rw [Subgroup.mem_bot]
    apply Subtype.ext
    refine centralizer_psl29 (Out21.A6.pgl29_le_autA6 g.2) fun x hx => ?_
    have hxJ : (⟨x, Out21.A6.psl29_le_pgl29 hx⟩ : ↥A6Models.pgl29) ∈ J := by
      rw [hJ, Subgroup.mem_subgroupOf]
      exact hx
    have h := congrArg Subtype.val (Subgroup.mem_centralizer_iff.mp hg _ hxJ)
    exact h.symm
  have hPSL : IsPSLTwo J 9 := by
    obtain ⟨-, ψ, -, -⟩ := CFSG.QuasithinUnique.Unc25K1.A6Model.exists_pslEquiv
    exact isPSLTwo_nine_of_A6 ((Subgroup.subgroupOfEquivOfLe Out21.A6.psl29_le_pgl29).trans ψ)
  set t : ↥A6Models.pgl29 := ⟨A6Models.tInv * A6Models.tMul ^ 3, pgl29_outer_mem⟩ with ht
  have ht2 : t * t = 1 := Subtype.ext pgl29_outer_sq
  have htJ : t ∉ J := by
    rw [hJ, Subgroup.mem_subgroupOf]
    exact pgl29_outer_not_mem
  have hmap := map_inf_centralizer_pgl29 t
  have h10 : Nat.card ↥(J ⊓ Subgroup.centralizer ({t} : Set ↥A6Models.pgl29)) = 10 := by
    rw [← Subgroup.card_map_of_injective A6Models.pgl29.subtype_injective, hJ, hmap]
    exact Out21.A6.card_psl29_centralizer_pgl29 pgl29_outer_mem pgl29_outer_sq
      pgl29_outer_not_mem
  have hpgl : PGLTwoSquareOuter J t := by
    rcases sec622_outer_L2_nine hJn hC hPSL (t := t) (by rw [pow_two]; exact ht2) htJ with
      ⟨-, h⟩ | h24
    · exact h
    · rw [h10] at h24
      exact absurd h24 (by norm_num)
  obtain ⟨F, hF, hFf, hF9, ⟨Φ⟩⟩ := pglP_iso J hJc ht2 htJ hpgl
  have htop : J ⊔ Subgroup.zpowers t = ⊤ :=
    Subgroup.eq_top_of_card_eq _ (by rw [pglP_card_sup J ht2 htJ, hJc, Out21.A6.card_pgl29])
  exact ⟨F, hF, hFf, hF9, ⟨((Subgroup.topEquiv.symm.trans
    (MulEquiv.subgroupCongr htop.symm)).trans Φ).trans
      (CFSG.Quasithin.F6.PGL2Res.statedEquiv F).symm⟩⟩

theorem k_A6AutOrder8_holds : K_A6AutOrder8 :=
  k_A6AutOrder8_of_pgl29 isPGL2_nine_pgl29

