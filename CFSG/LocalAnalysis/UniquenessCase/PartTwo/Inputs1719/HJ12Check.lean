  let A1 := enumGrp a1
  let A2 := enumGrp a2
  let invs := X1.filter isInvol
  let e16 : Array Nat → Bool := fun t =>
    let C := invs.filter fun s => s != t && commR s t
    C.any fun s =>
      let g2 := [idR, t, s, mulR t s]
      C.any fun r =>
        !g2.contains r && commR r s &&
          let g3 := g2 ++ g2.map (fun y => mulR y r)
          C.any fun q => !g3.contains q && commR q s && commR q r
  gensOKN g1 && gensOKN (a1 ++ a2) &&
    closedCheck g0 X0 && closedCheck g1 X1 && X0.dedup.length == 128 && X1.dedup.length == 256 &&
    closedCheck a1 A1 && closedCheck a2 A2 && A1.dedup.length == 16 && A2.dedup.length == 16 &&
    A1.all (fun x => X0.contains x && mulR x x == idR) &&
    A2.all (fun x => X0.contains x && mulR x x == idR) &&
    A1.all (fun x => A1.all fun y => commR x y) && A2.all (fun x => A2.all fun y => commR x y) &&
    A1.any (fun x => !A2.contains x) &&
    (invs.filter fun t => !A1.contains t && !A2.contains t).all (fun t => !e16 t) &&
    invs.all fun t =>
