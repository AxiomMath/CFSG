def fixCodes (g : Array Nat) : List Nat := (List.range 4096).filter fun v => appN g v == v

def isInvol (g : Array Nat) : Bool := g != idR && mulR g g == idR

def commR (g h : Array Nat) : Bool := mulR g h == mulR h g

def gensOKN (gs : List (Array Nat)) : Bool :=
  gs.all fun g => okRows g && okRows (invR g) && mulR g (invR g) == idR && mulR (invR g) g == idR

