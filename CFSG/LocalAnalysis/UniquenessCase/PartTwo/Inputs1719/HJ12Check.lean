def gammaOK (aw : List (List Nat)) (bw : List Nat) (g : Nat) (xw : List Nat) : Bool :=
  let gs := aw.map wordR
  let A := enumGrp gs
  let b := wordR bw
  let x := wordR xw
  gensOKN gs && closedCheck gs A && A.contains b && b != idR && appN b g == g &&
    A.contains x && (orbitOf gensL 1024).contains (g ^^^ appN x g)

