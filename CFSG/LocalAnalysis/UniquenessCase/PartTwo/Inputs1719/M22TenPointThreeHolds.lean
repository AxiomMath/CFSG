@[expose] def sqArr (a : Array ℕ) : Array ℕ := ((List.range 24).map fun j => a[a[j]!]!).toArray

theorem t10Arr_ok : ∀ i < 216, InvPairOK 24 t10Arr[i]! (sqArr t10Arr[i]!) = true ∧
    autArrOK t10Arr[i]! (sqArr t10Arr[i]!) = true ∧ (t10Arr[i]!)[0]! = 0 ∧ (t10Arr[i]!)[1]! = 1 ∧
    (∀ j < 24, (t10Arr[i]!)[(t10Arr[i]!)[(t10Arr[i]!)[j]!]!]! = j) ∧
    t10MovC[i]! < 2 ^ 10 ∧ actC10 t10Arr[i]! t10MovC[i]! ≠ t10MovC[i]! ∧
    t10MovD[i]! < 2 ^ 10 ∧ act10 t10Arr[i]! t10MovD[i]! ≠ t10MovD[i]! := by
  decide +kernel

theorem t10_code_fix : ∀ m < 2 ^ 10, m ≠ 0 →
    t10CodeIdx[m]! < 216 ∧ actC10 t10Arr[t10CodeIdx[m]!]! m = m := by
  have h : ∀ i < 216, (permCols t10Arr[i]! == M22TK.PCL.getD i []) = true := by decide +kernel
  set_option maxRecDepth 100000 in
  exact M22TK.fix_of rfl rfl (fun i hi => beq_iff_eq.1 (h i hi)) M22TK.code_check

theorem t10_cocode_fix : ∀ m < 2 ^ 10, m ≠ 0 →
    t10CocodeIdx[m]! < 216 ∧ act10 t10Arr[t10CocodeIdx[m]!]! m = m := by
  have h : ∀ i < 216, (permCols t10Arr[i]! == M22TK.PCL.getD i []) = true := by decide +kernel
  set_option maxRecDepth 100000 in
  exact M22TK.fix_of rfl rfl (fun i hi => beq_iff_eq.1 (h i hi)) M22TK.cocode_check

@[expose] noncomputable def t10Elt (i : ℕ) (hi : i < 216) : ↥mog22 :=
  ⟨permOfArr 24 t10Arr[i]! (sqArr t10Arr[i]!) (t10Arr_ok i hi).1,
    ⟨⟨mem_AutPerm_of_arr (t10Arr_ok i hi).1 (t10Arr_ok i hi).2.1,
        (mem_stab_iff 0 _).2 (Fin.ext (by
          rw [hasArr_permOfArr (t10Arr_ok i hi).1 0]
          exact (t10Arr_ok i hi).2.2.1))⟩,
      (mem_stab_iff 1 _).2 (Fin.ext (by
        rw [hasArr_permOfArr (t10Arr_ok i hi).1 1]
        exact (t10Arr_ok i hi).2.2.2.1))⟩⟩

theorem hasArr_t10Elt (i : ℕ) (hi : i < 216) :
    HasArr ((t10Elt i hi : ↥mog22) : Equiv.Perm (Fin 24)) t10Arr[i]! :=
  hasArr_permOfArr (t10Arr_ok i hi).1

theorem t10Elt_pow_three (i : ℕ) (hi : i < 216) : t10Elt i hi ^ 3 = 1 := by
  have h1 := hasArr_t10Elt i hi
  apply Subtype.ext
  refine Equiv.ext fun j => Fin.ext ?_
  rw [Subgroup.coe_pow, Subgroup.coe_one, pow_succ, pow_two, Equiv.Perm.mul_apply,
    Equiv.Perm.mul_apply, Equiv.Perm.one_apply, h1, h1, h1]
  exact (t10Arr_ok i hi).2.2.2.2.1 j j.2

theorem orderOf_eq_three_of_moves {Γ W : Type*} [Group Γ] [Group W] (R : Γ →* MulAut W)
    {γ : Γ} (h3 : γ ^ 3 = 1) {w : W} (hw : R γ w ≠ w) : orderOf (R γ) = 3 := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  refine orderOf_eq_prime (by rw [← map_pow, h3, map_one]) fun h1 => hw ?_
  rw [h1, MulAut.one_apply]

theorem exists_code_three (w : W10) (hw : w ≠ 1) :
    ∃ γ : ↥mog22, rhoC10 mog22 mog22_le_mog22plus γ w = w ∧
      orderOf (rhoC10 mog22 mog22_le_mog22plus γ) = 3 := by
  obtain ⟨m, hm, rfl⟩ := toW_surj 10 w
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hw (toW_zero 10)
  obtain ⟨hi, hfix⟩ := t10_code_fix m hm hm0
  obtain ⟨-, -, -, -, -, hlt, hmv, -, -⟩ := t10Arr_ok _ hi
  refine ⟨t10Elt _ hi, ?_, orderOf_eq_three_of_moves _ (t10Elt_pow_three _ hi)
    (w := toW 10 t10MovC[t10CodeIdx[m]!]!) ?_⟩
  · rw [rhoC10_toW _ _ _ (hasArr_t10Elt _ hi), hfix]
  · rw [rhoC10_toW _ _ _ (hasArr_t10Elt _ hi)]
    exact fun h => hmv (toW_inj (actC10_lt _ _) hlt h)

theorem exists_cocode_three (w : W10) (hw : w ≠ 1) :
    ∃ γ : ↥mog22, rho10 mog22 mog22_le_mog22plus γ w = w ∧
      orderOf (rho10 mog22 mog22_le_mog22plus γ) = 3 := by
  obtain ⟨m, hm, rfl⟩ := toW_surj 10 w
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hw (toW_zero 10)
  obtain ⟨hi, hfix⟩ := t10_cocode_fix m hm hm0
  obtain ⟨-, -, -, -, -, -, -, hlt, hmv⟩ := t10Arr_ok _ hi
  refine ⟨t10Elt _ hi, ?_, orderOf_eq_three_of_moves _ (t10Elt_pow_three _ hi)
    (w := toW 10 t10MovD[t10CocodeIdx[m]!]!) ?_⟩
  · rw [rho10_toW _ _ _ (hasArr_t10Elt _ hi), hfix]
  · rw [rho10_toW _ _ _ (hasArr_t10Elt _ hi)]
    exact fun h => hmv (toW_inj (act10_lt _ _) hlt h)

theorem exists_three_fix_of_map_eq {V W Γ : Type*} [CommGroup V] [CommGroup W] [Group Γ]
    {L : Subgroup (MulAut V)} {R : Γ →* MulAut W} (e : V ≃* W)
    (he : L.map (congrHom e) = R.range)
    (hR : ∀ w : W, w ≠ 1 → ∃ γ : Γ, R γ w = w ∧ orderOf (R γ) = 3) {v : V} (hv : v ≠ 1) :
    ∃ g ∈ L, orderOf g = 3 ∧ g v = v := by
  obtain ⟨γ, hγw, hγo⟩ := hR (e v) fun h => hv ((map_eq_one_iff e e.injective).1 h)
  obtain ⟨g, hgL, hg⟩ : R γ ∈ L.map (congrHom e) := he ▸ ⟨γ, rfl⟩
  refine ⟨g, hgL, ?_, e.injective ?_⟩
  · rw [← hγo, ← hg, orderOf_injective _ (congrHom_injective e)]
  · have h := congrArg (fun f : MulAut W => f (e v)) hg
    simp only [congrHom_apply, MulEquiv.symm_apply_apply] at h
    rw [h, hγw]

theorem k_M22TenPointThree_holds :
    K_M22TenPointThree := by
  intro W _ _ hW2 hcard L hL hirr w hw
  rcases mathieuSmallIrr22_holds W hW2 L hL hirr (by rw [hcard]; norm_num) with h | h
  · obtain ⟨e, he⟩ := code22_std h
    exact exists_three_fix_of_map_eq e he exists_code_three hw
  · obtain ⟨e, he⟩ := cocode22_std h
    exact exists_three_fix_of_map_eq e he exists_cocode_three hw

