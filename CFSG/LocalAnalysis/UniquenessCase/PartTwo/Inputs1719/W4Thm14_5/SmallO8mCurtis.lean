private theorem conj_shortWeyl_long {i j : Fin 3} (hij : i ≠ j) :
    (minusFrame 4 b c).longWeyl hij true false * shortWeyl 4 hirrQ j *
        ((minusFrame 4 b c).longWeyl hij true false)⁻¹ = shortWeyl 4 hirrQ i := by
  have hsign : (longWeylSign i j : K) = 1 := by
    simp [longWeylSign, hij.symm]
  have hx : ∀ t : Bool,
      (minusFrame 4 b c).longWeyl hij true false *
        twShortRoot 4 hirrQ j t (.ofAdd planeOne) *
          ((minusFrame 4 b c).longWeyl hij true false)⁻¹ =
      twShortRoot 4 hirrQ i t (.ofAdd planeOne) := by
    intro t
    rw [longWeyl_conj_twShortRoot, longWeylBool_true_false, Equiv.swap_apply_right, hsign,
      one_smul]
  rw [shortWeyl_eq, shortWeyl_eq]
  calc
    (minusFrame 4 b c).longWeyl hij true false *
        (shortPosHom 4 hirrQ j (.ofAdd planeOne) * shortNegHom 4 hirrQ j (.ofAdd planeOne) *
          shortPosHom 4 hirrQ j (.ofAdd planeOne)) *
          ((minusFrame 4 b c).longWeyl hij true false)⁻¹ =
      ((minusFrame 4 b c).longWeyl hij true false * shortPosHom 4 hirrQ j (.ofAdd planeOne) *
        ((minusFrame 4 b c).longWeyl hij true false)⁻¹) *
      ((minusFrame 4 b c).longWeyl hij true false * shortNegHom 4 hirrQ j (.ofAdd planeOne) *
        ((minusFrame 4 b c).longWeyl hij true false)⁻¹) *
      ((minusFrame 4 b c).longWeyl hij true false * shortPosHom 4 hirrQ j (.ofAdd planeOne) *
        ((minusFrame 4 b c).longWeyl hij true false)⁻¹) := by group
    _ = _ := by
      have hx1 := hx true
      have hx0 := hx false
      simp only [twShortRoot_true, twShortRoot_false] at hx1 hx0
      rw [hx1, hx0]

