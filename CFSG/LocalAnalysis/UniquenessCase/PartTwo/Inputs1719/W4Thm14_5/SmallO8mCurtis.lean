@[expose] noncomputable def curtisDatum {K : Type} [Field K] [Finite K] [CharP K 2]
    (m : ℕ) (hm : 4 ≤ m) {b c : K} (hirrQ : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    CurtisDatum (spinGroup (quadMinus m K b c))
      (coxeterMatrix (isFiniteType_cartanB (m - 1))).toCoxeterSystem 2 := by
  have : Finite (spinGroup (quadMinus m K b c)) :=
    finite_spinGroup_of_ker _ (coe_ker_spinMatrix_quadMinus hirrQ)
  exact curtisDatumOf (minusDatum_isCTGroupDatum m hirrQ hm)
    (minusDatum_steinbergExtras m hirrQ) (SpinMinusClosed.bruhatExtras hirrQ hm) 2
    (fun _ hγ => isPGroup_minusRootGroup hirrQ hγ)

theorem curtisDatum_splitOver {K k : Type} [Field K] [Finite K] [CharP K 2] [Field k]
    [IsAlgClosed k] {b c : K} (hirrQ : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    SplitOver k (curtisDatum 4 (by norm_num) hirrQ).H := by
  intro h _
  have : Finite (spinGroup (quadMinus 4 K b c)) := inferInstance
  refine ⟨orderOf h, pow_orderOf_eq_one h, ?_⟩
  have hpos : 0 < orderOf h := orderOf_pos h
  let f : Polynomial k := Polynomial.X ^ orderOf h - 1
  have hm : f.Monic := Polynomial.monic_X_pow_sub_C (1 : k) (Nat.ne_of_gt hpos)
  have heq := (IsAlgClosed.splits f).eq_prod_roots_of_monic hm
  refine ⟨f.roots.toList, ?_⟩
  have hlist : Multiset.map (fun a => Polynomial.X - Polynomial.C a) f.roots =
      ((f.roots.toList.map fun a => (Polynomial.X - Polynomial.C a : Polynomial k) : List _) :
        Multiset _) := by
    rw [← Multiset.map_coe, Multiset.coe_toList]
  rw [hlist, Multiset.prod_coe] at heq
  exact heq

@[expose] noncomputable def naturalRep {K k : Type} [Field K] [Field k]
    (m : ℕ) (b c : K) (φ : K →+* k) :
    Representation k (spinGroup (quadMinus m K b c))
      (Fin (m - 1) ⊕ Fin (m - 1) ⊕ Fin 2 → k) where
  toFun g := Matrix.toLin' ((matHom m g).map φ)
  map_one' := by simp; rfl
  map_mul' g h := by
    rw [map_mul, Matrix.map_mul, Matrix.toLin'_mul]
    rfl

theorem naturalRep_apply {K k : Type} [Field K] [Field k] (m : ℕ) (b c : K)
    (φ : K →+* k) (g : spinGroup (quadMinus m K b c))
    (v : Fin (m - 1) ⊕ Fin (m - 1) ⊕ Fin 2 → k) :
    naturalRep m b c φ g v = (mat m g).map φ *ᵥ v := by
  simp [naturalRep, Matrix.toLin'_apply, matHom]

theorem naturalRep_isIrreducible {K : Type} [Field K] [Finite K] [CharP K 2]
    {m : ℕ} (hm : 4 ≤ m) {b c : K} (hirrQ : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    (naturalRep m b c (RingHom.id K)).IsIrreducible := by
  rw [CFSG.QuasithinUnique.Setup.SL2Modules.isIrreducible_iff]
  refine ⟨inferInstance, fun U hU => ?_⟩
  apply CFSG.RankThree.GF2n.Stroth80.natIrred_statedOmegaMinus_of_three_le
    (by omega) hirrQ U
  intro g hg v hv
  obtain ⟨x, hx⟩ := show g ∈ (spinMatrix (quadMinus m K b c)).range from
    (range_spinMatrix_quadMinus hm hirrQ).symm ▸ hg
  have h := hU x v hv
  simpa [naturalRep_apply, mat, hx] using h

theorem naturalRep_isAbsolutelyIrreducible {K : Type} [Field K] [Finite K] [CharP K 2]
    {m : ℕ} (hm : 4 ≤ m) {b c : K} (hirrQ : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    CFSG.Theory.Representation.IsAbsolutelyIrreducible (naturalRep m b c (RingHom.id K)) := by
  let ρ := naturalRep m b c (RingHom.id K)
  have : ρ.IsIrreducible := naturalRep_isIrreducible hm hirrQ
  apply (CFSG.Theory.Representation.isAbsolutelyIrreducible_iff_surjective ρ).mpr
  intro f
  have hcomm : ∀ g ∈ StatedOmega (StatedQuadMinus m K b c), ∀ v,
      f ((g : Matrix _ _ K) *ᵥ v) = (g : Matrix _ _ K) *ᵥ f v := by
    intro g hg v
    obtain ⟨x, hx⟩ := show g ∈ (spinMatrix (quadMinus m K b c)).range from
      (range_spinMatrix_quadMinus hm hirrQ).symm ▸ hg
    have h := Representation.IntertwiningMap.isIntertwining ρ ρ f x v
    simpa [ρ, naturalRep_apply, mat, hx] using h
  obtain ⟨a, ha⟩ := CFSG.RankThree.GF2n.Stroth80.addCommutantScalar_statedOmegaMinus
    (by omega : 2 ≤ m) hirrQ f.toLinearMap.toAddMonoidHom hcomm
  refine ⟨a, CFSG.Theory.Representation.RepMap.ext fun v => ?_⟩
  change a • v = f v
  exact (ha v).symm

theorem naturalRep_isSimple {K k : Type} [Field K] [Finite K] [CharP K 2] [Field k]
    {m : ℕ} (hm : 4 ≤ m) {b c : K} (hirrQ : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (φ : K →+* k) : IsSimpleRep (naturalRep m b c φ) := by
  let : Algebra K k := φ.toAlgebra
  let ρ := naturalRep m b c (RingHom.id K)
  have : CFSG.Theory.Representation.IsAbsolutelyIrreducible ρ :=
    naturalRep_isAbsolutelyIrreducible hm hirrQ
  let σ := CFSG.Theory.Representation.extendScalars k ρ
  have : σ.IsIrreducible :=
    CFSG.Theory.Representation.IsAbsolutelyIrreducible.irreducible_of_extension ρ k
  have hsimp : IsSimpleRep σ :=
    (CFSG.QuasithinUnique.Setup.SL2Modules.isIrreducible_iff σ).mp inferInstance
  let β := TensorProduct.piScalarRight K k k (Fin (m - 1) ⊕ Fin (m - 1) ⊕ Fin 2)
  have hβ : ∀ g v, β (σ g v) = naturalRep m b c φ g (β v) := by
    intro g v
    change β ((Matrix.toLin' ((mat m g).map (RingHom.id K))).baseChange k v) =
      (mat m g).map φ *ᵥ β v
    simp only [Matrix.toLin'_apply']
    exact CFSG.HardMathSupport.Meierfrankenfeld.PSUScalar.piScalarRight_baseChange_mulVec
      (F := K) (k := k) (mat m g) v
  refine ⟨inferInstance, fun U hU => ?_⟩
  rcases hsimp.2 (U.comap β.toLinearMap) (fun g v hv => by
    change β (σ g v) ∈ U
    rw [hβ]
    exact hU g _ hv) with h0 | h1
  · left
    ext v
    constructor
    · intro hv
      have h : β.symm v ∈ U.comap β.toLinearMap := by simpa using hv
      rw [h0, Submodule.mem_bot] at h
      exact (Submodule.mem_bot _).mpr (by simpa using congrArg β h)
    · rintro (rfl : v = 0)
      exact U.zero_mem
  · right
    exact eq_top_iff.mpr fun v _ => by
      have h : β.symm v ∈ U.comap β.toLinearMap := h1 ▸ Submodule.mem_top
      simpa using h

