variable {K k : Type} [Field K] [Finite K] [CharP K 2] [Field k]
  {b c : K} (hirrQ : ∀ s : K, s ^ 2 + b * s + c ≠ 0) (φ : K →+* k)

local instance : Finite (spinGroup (quadMinus 4 K b c)) := by
  have : FiniteDimensional K (CliffordAlgebra (quadMinus 4 K b c)) :=
    finiteDimensional_cliffordAlgebra' _
  have : Finite (CliffordAlgebra (quadMinus 4 K b c)) := Module.finite_of_finite K
  infer_instance

@[expose] def highestVec : Fin 3 ⊕ Fin 3 ⊕ Fin 2 → k := Pi.single (.inl 0) 1

@[expose] noncomputable def highestChar (g : spinGroup (quadMinus 4 K b c)) : k :=
  φ (mat 4 g (.inl 0) (.inl 0))

private theorem highest_degree (a : Fin 3 ⊕ Fin 3 ⊕ Fin 2) :
    epsHt 4 (minusWt 4 a) ≤ 3 := by
  rcases a with a | a | a
  all_goals fin_cases a <;> norm_num [epsHt, minusWt, Fin.sum_univ_succ, Pi.single_apply]

theorem naturalRep_highestVec_mem_fixU :
    highestVec (k := k) ∈
      (curtisDatum 4 (by norm_num) hirrQ).fixU (naturalRep 4 b c φ) := by
  rw [CurtisDatum.mem_fixU]
  intro g hg
  change g ∈ CFSG.LieType.Steinberg.posUnipotent (minusDatum 4 hirrQ) at hg
  change g ∈ ⨆ γ ∈ {γ | γ ∈ roots (isFiniteType_cartanB 3) ∅ ∧ 0 < ht γ},
    minusRootGroup 4 hirrQ γ at hg
  have htri := idBelow_of_mem_iSup 4 hirrQ 1
    {γ | γ ∈ roots (isFiniteType_cartanB 3) ∅ ∧ 0 < ht γ}
    (fun γ hγ => by
      change γ ∈ roots (isFiniteType_cartanB 3) ∅ ∧ 0 < ht γ at hγ
      exact ⟨hγ.1, by simpa only [one_mul] using hγ.2⟩) hg
  have hcol : ∀ a : Fin 3 ⊕ Fin 3 ⊕ Fin 2,
      mat 4 g a (.inl 0) =
        (1 : Matrix (Fin 3 ⊕ Fin 3 ⊕ Fin 2) (Fin 3 ⊕ Fin 3 ⊕ Fin 2) K) a (.inl 0) := by
    intro a
    apply htri a (.inl 0)
    have h := highest_degree a
    have h0 : epsHt 4 (minusWt 4 (.inl 0)) = 3 := by
      norm_num [epsHt, minusWt, Fin.sum_univ_succ, Pi.single_apply]
    simpa only [AddMonoidHom.smul_apply, one_smul, h0] using
      (show epsHt 4 (minusWt 4 a) - 3 < 1 by omega)
  rw [naturalRep_apply]
  ext a
  simp only [highestVec, Matrix.mulVec_single_one, Matrix.col_apply,
    Matrix.map_apply, hcol, Matrix.one_apply, Pi.single_apply]
  split_ifs <;> simp

theorem naturalRep_highestChar {g : spinGroup (quadMinus 4 K b c)}
    (hg : g ∈ (curtisDatum 4 (by norm_num) hirrQ).H) :
    naturalRep 4 b c φ g highestVec = highestChar φ g • highestVec := by
  have hdiag : BlockDiag 4 (mat 4 g) := by
    change g ∈ ⨆ j, minusTorus 4 hirrQ j at hg
    exact Subgroup.iSup_induction (minusTorus 4 hirrQ)
      (C := fun g => BlockDiag 4 (mat 4 g)) hg
      (fun j x hx => blockDiag_mat_of_mem_minusTorus 4 hirrQ j hx)
      (by rw [mat_one]; exact blockDiag_one 4)
      (fun x y hx hy => by rw [mat_mul]; exact blockDiag_mul 4 hx hy)
  ext a
  simp only [naturalRep_apply, highestVec, Matrix.mulVec_single_one, Matrix.col_apply,
    Matrix.map_apply]
  by_cases ha : a = .inl 0
  · subst ha
    simp [highestChar]
  · rw [hdiag.apply_eq_zero 4 ha (Or.inr (fun t => by simp))]
    simp [ha]

omit [Finite K] [CharP K 2] in
private theorem naturalRep_map_vector (g : spinGroup (quadMinus 4 K b c))
    (v : Fin 3 ⊕ Fin 3 ⊕ Fin 2 → K) :
    naturalRep 4 b c φ g (fun a => φ (v a)) =
      fun a => φ (spinAction (quadMinus 4 K b c) g v a) := by
  rw [naturalRep_apply]
  have hact : (mat 4 g) *ᵥ v = spinAction (quadMinus 4 K b c) g v := by
    rw [mat, coe_spinMatrix]
    exact LinearMap.toMatrix'_mulVec _ v
  rw [← hact]
  ext a
  simp [Matrix.mulVec_apply_eq_sum, map_sum, map_mul]

omit [Finite K] in
private theorem naturalRep_Weyl_highest (i : Fin 3) :
    naturalRep 4 b c φ (minusWeyl 4 hirrQ i) highestVec =
      if i = 0 then Pi.single (.inl 1) 1 else highestVec := by
  have hact : spinAction (quadMinus 4 K b c) (minusWeyl 4 hirrQ i) (eVec 4 0) =
      if i = 0 then eVec 4 1 else eVec 4 0 := by
    fin_cases i
    · change spinAction (quadMinus 4 K b c) (minusWeyl 4 hirrQ 0) (eVec 4 0) = _
      rw [minusWeyl_of_lt 4 hirrQ (k := 0) (by norm_num)]
      have h := (minusFrame 4 b c).toHypFrame.spinAction_longWeyl_vec_left
        (succ_ne_of_lt 4 (k := 0) (by norm_num)) true false
      simpa [minusFrame_vec, minusVec_true, eVec, CharTwo.neg_eq] using h
    · change spinAction (quadMinus 4 K b c) (minusWeyl 4 hirrQ 1) (eVec 4 0) = _
      rw [minusWeyl_of_lt 4 hirrQ (k := 1) (by norm_num)]
      have h := (minusFrame 4 b c).toHypFrame.spinAction_longWeyl_vec_of_ne
        (succ_ne_of_lt 4 (k := 1) (by norm_num)) true false
        (k := 0) (by decide) (by decide) true
      simpa [minusFrame_vec, minusVec_true] using h
    · change spinAction (quadMinus 4 K b c) (minusWeyl 4 hirrQ 2) (eVec 4 0) = _
      rw [minusWeyl_of_not_lt 4 hirrQ (k := 2) (by norm_num)]
      simpa [shortWeyl] using spinAction_shortWeylElt_eVec_of_ne 4 hirrQ (i := 2) (j := 0)
        (by decide) planeOne
  have h := naturalRep_map_vector φ (minusWeyl 4 hirrQ i) (eVec 4 0)
  rw [hact] at h
  have hvec : ∀ j : Fin 3, (fun a => φ (eVec 4 j a)) =
      (Pi.single (.inl j) 1 : Fin 3 ⊕ Fin 3 ⊕ Fin 2 → k) := by
    intro j
    ext a
    simp [eVec, Pi.single_apply]
  simp only [hvec] at h
  split_ifs at h ⊢ <;> simpa only [hvec, highestVec] using h

omit [Finite K] [CharP K 2] in
private theorem naturalRep_first_X_next (a : K) :
    naturalRep 4 b c φ
        ((minusFrame 4 b c).longRoot (succ_ne_of_lt 4 (k := 0) (by norm_num)) true false
          (.ofAdd a)) (Pi.single (.inl 1) 1) =
      Pi.single (.inl 1) 1 + φ a • highestVec := by
  have hact := (minusFrame 4 b c).toHypFrame.spinAction_longRoot_vec_not_right
    (succ_ne_of_lt 4 (k := 0) (by norm_num)) true false a
  have h := naturalRep_map_vector φ
    ((minusFrame 4 b c).longRoot (succ_ne_of_lt 4 (k := 0) (by norm_num)) true false
      (.ofAdd a)) (eVec 4 1)
  rw [show spinAction (quadMinus 4 K b c)
        ((minusFrame 4 b c).longRoot (succ_ne_of_lt 4 (k := 0) (by norm_num)) true false
          (.ofAdd a)) (eVec 4 1) = eVec 4 1 + a • eVec 4 0 from
        hact] at h
  have hvec : (fun i => φ (eVec 4 1 i)) =
      (Pi.single (.inl 1) 1 : Fin 3 ⊕ Fin 3 ⊕ Fin 2 → k) := by
    ext i
    simp [eVec, Pi.single_apply]
  rw [hvec] at h
  convert h using 1
  ext i
  simp [highestVec, eVec, Pi.single_apply, map_add, Pi.smul_apply]
  split_ifs <;> simp_all

theorem naturalRep_heckeT_highestVec [CharP k 2] (hK : 4 ≤ Nat.card K) (i : Fin 3) :
    (curtisDatum 4 (by norm_num) hirrQ).heckeT (naturalRep 4 b c φ) i highestVec = 0 := by
  classical
  have : Finite (spinGroup (quadMinus 4 K b c)) :=
    finite_spinGroup_of_ker _ (coe_ker_spinMatrix_quadMinus hirrQ)
  let D := curtisDatum 4 (by norm_num) hirrQ
  have : Fintype (D.X i) := Fintype.ofFinite _
  have : Fintype K := Fintype.ofFinite _
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hcount : (Fintype.card (D.X i) : k) = 0 := by
    rw [← Nat.card_eq_fintype_card]
    exact (CharP.cast_eq_zero_iff k 2 _).mpr (D.dvd_card_X i)
  change D.heckeT (naturalRep 4 b c φ) i highestVec = 0
  rw [D.heckeT_apply]
  have hn : D.n i = minusWeyl 4 hirrQ i := rfl
  have hmul : ∀ x : D.X i,
      naturalRep 4 b c φ ((x : spinGroup _) * D.n i) highestVec =
        naturalRep 4 b c φ (x : spinGroup _)
          (naturalRep 4 b c φ (D.n i) highestVec) := by
    intro x
    rw [map_mul, Module.End.mul_apply]
  have hsum : (∑ x : D.X i,
      naturalRep 4 b c φ ((x : spinGroup _) * D.n i) highestVec) =
      ∑ x : D.X i, naturalRep 4 b c φ (x : spinGroup _)
        (if i = 0 then Pi.single (.inl 1) 1 else highestVec) :=
    Finset.sum_congr rfl fun x _ => by rw [hmul, hn, naturalRep_Weyl_highest hirrQ φ i]
  rw [hsum]
  by_cases hi : i = 0
  · subst hi
    let f : K → D.X 0 := fun a =>
      ⟨(minusFrame 4 b c).longRoot (succ_ne_of_lt 4 (k := 0) (by norm_num)) true false (.ofAdd a),
        by
          change _ ∈ minusRootGroup 4 hirrQ (Pi.single 0 1)
          rw [minusRootGroup_single_of_lt 4 hirrQ (k := 0) (by norm_num)]
          exact ⟨.ofAdd a, rfl⟩⟩
    have hf : Function.Bijective f := by
      refine ⟨fun a a' h => ?_, ?_⟩
      · have hx := congrArg Subtype.val h
        exact Multiplicative.ofAdd.injective
          ((minusFrame 4 b c).toHypFrame.longRoot_injective
            (succ_ne_of_lt 4 (k := 0) (by norm_num)) true false hx)
      · intro x
        have hx : (x : spinGroup _) ∈ minusRootGroup 4 hirrQ (Pi.single 0 1) := x.2
        rw [minusRootGroup_single_of_lt 4 hirrQ (k := 0) (by norm_num)] at hx
        obtain ⟨a, ha⟩ := hx
        exact ⟨a.toAdd, Subtype.ext ha⟩
    rw [if_pos rfl]
    rw [← (Equiv.ofBijective f hf).sum_comp]
    simp_rw [Equiv.ofBijective_apply, show ∀ a : K,
      naturalRep 4 b c φ (f a : spinGroup _) (Pi.single (.inl 1) 1) =
        Pi.single (.inl 1) 1 + φ a • highestVec from
      fun a => naturalRep_first_X_next φ a]
    rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ,
      ← Nat.cast_smul_eq_nsmul k, ← Finset.sum_smul, ← map_sum]
    have hcard : (Fintype.card K : k) = 0 := by
      obtain ⟨n, -, hn⟩ := FiniteField.card K 2
      rw [hn, Nat.cast_pow, Nat.cast_ofNat, CharTwo.two_eq_zero, zero_pow (PNat.ne_zero n)]
    have hsum : ∑ a : K, a = 0 := by
      simpa using FiniteField.sum_pow_lt_card_sub_one K 1 (by
        rw [← Nat.card_eq_fintype_card]; omega)
    rw [hcard, zero_smul, hsum, map_zero, zero_smul, add_zero]
  · rw [if_neg hi]
    have hfix : ∀ x : D.X i, naturalRep 4 b c φ (x : spinGroup _) highestVec = highestVec :=
      fun x => (D.mem_fixU (naturalRep 4 b c φ)).mp (naturalRep_highestVec_mem_fixU hirrQ φ) _
        (D.X_le i x.2)
    simp_rw [hfix, Finset.sum_const, Finset.card_univ, ← Nat.cast_smul_eq_nsmul k,
      hcount, zero_smul]

theorem naturalRep_isCurtisType [CharP k 2] (hK : 4 ≤ Nat.card K) :
    (curtisDatum 4 (by norm_num) hirrQ).IsCurtisType (naturalRep 4 b c φ)
      highestVec (highestChar φ) 0 := by
  refine ⟨naturalRep_highestVec_mem_fixU hirrQ φ, ?_,
    fun g hg => naturalRep_highestChar hirrQ φ hg, fun i => ?_⟩
  · intro h
    have := congrFun h (.inl 0)
    simp [highestVec] at this
  · simpa using naturalRep_heckeT_highestVec hirrQ φ hK i

end Eight

section ShortBlock

open CFSG.ClassicalGroups.Orthogonal

theorem commute_short_roots_of_fix_block {K : Type} [Field K] {n : ℕ} {b c : K}
    (hirrQ : ∀ s : K, s ^ 2 + b * s + c ≠ 0) (i : Fin (n - 1))
    (r : Vm n K ≃ₗ[K] Vm n K)
    (hr : r ∈ TauCeti.QuadraticMap.orthogonalGroup (quadMinus n K b c))
    (he : r (eVec n i) = eVec n i) (hf : r (fVec n i) = fVec n i)
    (hp : ∀ p : Fin 2 → K, r (planeVec n p) = planeVec n p) :
    ∀ g ∈ (shortPosHom n hirrQ i).range ⊔ (shortNegHom n hirrQ i).range,
      r * spinAction (quadMinus n K b c) g = spinAction (quadMinus n K b c) g * r := by
  have hroot : ∀ (s : Bool) (p : Fin 2 → K),
      r * spinAction (quadMinus n K b c) (twShortRoot n hirrQ i s (.ofAdd p)) =
        spinAction (quadMinus n K b c) (twShortRoot n hirrQ i s (.ofAdd p)) * r := by
    intro s p
    have hvec : r (minusVec n i s) = minusVec n i s := by
      cases s
      · exact hf
      · exact he
    have hc : r * spinAction (quadMinus n K b c) (twShortRoot n hirrQ i s (.ofAdd p)) *
        r⁻¹ = spinAction (quadMinus n K b c) (twShortRoot n hirrQ i s (.ofAdd p)) := by
      rw [spinAction_twShortRoot_eq_eichler, eichler_conj hr, hvec, hp]
    calc
      r * spinAction (quadMinus n K b c) (twShortRoot n hirrQ i s (.ofAdd p)) =
          (r * spinAction (quadMinus n K b c) (twShortRoot n hirrQ i s (.ofAdd p)) *
            r⁻¹) * r := by group
      _ = spinAction (quadMinus n K b c) (twShortRoot n hirrQ i s (.ofAdd p)) * r := by rw [hc]
  let C := (Subgroup.centralizer {r}).comap (spinAction (quadMinus n K b c))
  have hle : (shortPosHom n hirrQ i).range ⊔ (shortNegHom n hirrQ i).range ≤ C := by
    apply sup_le
    · rintro _ ⟨p, rfl⟩
      change spinAction (quadMinus n K b c) (shortPosHom n hirrQ i p) ∈
        Subgroup.centralizer {r}
      rw [Subgroup.mem_centralizer_iff]
      intro x hx
      rw [Set.mem_singleton_iff.mp hx, ← ofAdd_toAdd p]
      exact hroot true p.toAdd
    · rintro _ ⟨p, rfl⟩
      change spinAction (quadMinus n K b c) (shortNegHom n hirrQ i p) ∈
        Subgroup.centralizer {r}
      rw [Subgroup.mem_centralizer_iff]
      intro x hx
      rw [Set.mem_singleton_iff.mp hx, ← ofAdd_toAdd p]
      exact hroot false p.toAdd
  intro g hg
  exact Subgroup.mem_centralizer_iff.mp (hle hg) r rfl

theorem aut_eq_self_on_short_roots_of_fix_block {K : Type} [Field K] [Finite K] [CharP K 2]
    {b c : K} (hirrQ : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (r : Vm 4 K ≃ₗ[K] Vm 4 K)
    (hr : r ∈ TauCeti.QuadraticMap.orthogonalGroup (quadMinus 4 K b c))
    (he : r (eVec 4 2) = eVec 4 2) (hf : r (fVec 4 2) = fVec 4 2)
    (hp : ∀ p : Fin 2 → K, r (planeVec 4 p) = planeVec 4 p)
    (α : MulAut (spinGroup (quadMinus 4 K b c)))
    (hα : ∀ g, spinAction (quadMinus 4 K b c) (α g) =
      r * spinAction (quadMinus 4 K b c) g * r⁻¹) :
    ∀ g ∈ (shortPosHom 4 hirrQ 2).range ⊔ (shortNegHom 4 hirrQ 2).range, α g = g := by
  have hinj : Function.Injective (spinAction (quadMinus 4 K b c)) := by
    rw [← MonoidHom.ker_eq_bot_iff]
    apply le_antisymm
    · exact (ker_spinAction_le_center _).trans (by
        rw [CFSG.RankThree.PartOne.CTP.center_spinGroup_quadMinus_eq_bot
          (by norm_num : 4 ≤ 4) hirrQ])
    · exact bot_le
  intro g hg
  apply hinj
  rw [hα g, commute_short_roots_of_fix_block hirrQ 2 r hr he hf hp g hg]
  group

end ShortBlock

section CoordinateAction

open CFSG.ComponentClassification.CatalogueBOrthogonalPointData
  CFSG.ComponentClassification.CatalogueBOrthogonalPointReindexCovariance
  CFSG.ComponentClassification.CatalogueBOrthogonalSemilinear

variable {K : Type} [Field K] [Finite K] [CharP K 2] {b c : K}
  (hirrQ : ∀ s : K, s ^ 2 + b * s + c ≠ 0)

theorem coordinateSpinEquiv_vector (g : spinGroup (quadMinus 4 K b c)) (v : Vm 4 K) :
    matrixLinearIso (coordinateSpinEquiv hirrQ g).val
        (coordinateMinusIsometry 4 K (by norm_num : 1 ≤ 4) b c v) =
      coordinateMinusIsometry 4 K (by norm_num : 1 ≤ 4) b c
        (spinAction (quadMinus 4 K b c) g v) := by
  change matrixLinearEquiv
      (statedDerivedReindexEquiv (minusIndexEquiv 4 (by norm_num))
        (quadMinus 4 K b c) (coe_quadMinus 4 K b c)
        (CFSG.SeitzReduction.SymplecticPilot.peRhoMEquiv (by norm_num : 4 ≤ 4) hirrQ g)).val
      (reindexVectorEquiv (minusIndexEquiv 4 (by norm_num)) v) =
    reindexVectorEquiv (minusIndexEquiv 4 (by norm_num))
      (spinAction (quadMinus 4 K b c) g v)
  rw [statedDerivedReindexEquiv_vector]
  congr 1
  exact CFSG.SeitzReduction.SymplecticPilot.peRhoM_mulVec (by norm_num : 4 ≤ 4) hirrQ g v

theorem spinAction_conj_of_coordinate
    (α : MulAut (spinGroup (quadMinus 4 K b c)))
    (s : matrixIsometries (coordinateQuadMinus 4 K (by norm_num) b c))
    (hα : ∀ g, coordinateEquiv hirrQ (α g) =
      matrixProjectiveConjugationHom _ (matrixIsometryInclusion _ s)
        (coordinateEquiv hirrQ g)) :
    ∀ g, spinAction (quadMinus 4 K b c) (α g) =
      let E := coordinateMinusIsometry 4 K (by norm_num : 1 ≤ 4) b c
      let r := (E.toLinearEquiv.trans (matrixLinearIso s.val)).trans E.symm.toLinearEquiv
      r * spinAction (quadMinus 4 K b c) g * r⁻¹ := by
  let Q := coordinateQuadMinus 4 K (by norm_num) b c
  let E := coordinateMinusIsometry 4 K (by norm_num : 1 ≤ 4) b c
  let S := matrixLinearIso s.val
  let r := (E.toLinearEquiv.trans S).trans E.symm.toLinearEquiv
  let Θ := coordinateSpinEquiv hirrQ
  have hproj : Function.Injective (matrixProjectiveProjection Q) :=
    (CFSG.RankThree.PartOne.AUTSL.derivedProjEquiv Q
      (coordinateMinus_ne_zero (b := b) (c := c))).injective
  have hconj : ∀ g, Θ (α g) = matrixDerivedConjugation Q (matrixIsometryInclusion Q s) (Θ g) := by
    intro g
    apply hproj
    have h := hα g
    rw [coordinateEquiv_apply, coordinateEquiv_apply] at h
    change matrixProjectiveProjection Q (Θ (α g)) =
      matrixProjectiveConjugation Q (matrixIsometryInclusion Q s)
        (matrixProjectiveProjection Q (Θ g)) at h
    rwa [matrixProjectiveConjugation_mk] at h
  have hlin : ∀ g, matrixLinearIso (Θ (α g)).val =
      S * matrixLinearIso (Θ g).val * S⁻¹ := by
    intro g
    rw [hconj, matrixDerivedConjugation_val]
    change matrixLinearIso (s.val *
      CFSG.ComponentClassification.CatalogueBHigherLinearField.glFieldAut _ K 1 (Θ g).val *
        s.val⁻¹) = S * matrixLinearIso (Θ g).val * S⁻¹
    rw [map_one, MulAut.one_apply, map_mul, map_mul, map_inv]
  have hvec : ∀ g v, matrixLinearIso (Θ g).val (E v) =
      E (spinAction (quadMinus 4 K b c) g v) := coordinateSpinEquiv_vector hirrQ
  have hr : ∀ v, E (r v) = S (E v) := by
    intro v
    change E (E.symm (S (E v))) = S (E v)
    exact E.apply_symm_apply _
  have hri : ∀ v, E (r⁻¹ v) = S⁻¹ (E v) := by
    intro v
    change E (E.symm (S.symm (E v))) = S.symm (E v)
    exact E.apply_symm_apply _
  intro g
  change spinAction (quadMinus 4 K b c) (α g) = r * spinAction (quadMinus 4 K b c) g * r⁻¹
  apply LinearEquiv.ext
  intro v
  apply E.injective
  change E (spinAction (quadMinus 4 K b c) (α g) v) =
    E ((r * spinAction (quadMinus 4 K b c) g * r⁻¹) v)
  rw [← hvec, hlin]
  change S (matrixLinearIso (Θ g).val (S⁻¹ (E v))) =
    E (r (spinAction (quadMinus 4 K b c) g (r⁻¹ v)))
  rw [hr, ← hvec, hri]

theorem aut_eq_self_on_short_roots_of_coordinate_fix_block
    (α : MulAut (spinGroup (quadMinus 4 K b c)))
    (s : matrixIsometries (coordinateQuadMinus 4 K (by norm_num) b c))
    (hα : ∀ g, coordinateEquiv hirrQ (α g) =
      matrixProjectiveConjugationHom _ (matrixIsometryInclusion _ s)
        (coordinateEquiv hirrQ g))
    (he : let E := coordinateMinusIsometry 4 K (by norm_num : 1 ≤ 4) b c
      let r := (E.toLinearEquiv.trans (matrixLinearIso s.val)).trans E.symm.toLinearEquiv
      r (eVec 4 2) = eVec 4 2)
    (hf : let E := coordinateMinusIsometry 4 K (by norm_num : 1 ≤ 4) b c
      let r := (E.toLinearEquiv.trans (matrixLinearIso s.val)).trans E.symm.toLinearEquiv
      r (fVec 4 2) = fVec 4 2)
    (hp : let E := coordinateMinusIsometry 4 K (by norm_num : 1 ≤ 4) b c
      let r := (E.toLinearEquiv.trans (matrixLinearIso s.val)).trans E.symm.toLinearEquiv
      ∀ p : Fin 2 → K, r (planeVec 4 p) = planeVec 4 p) :
    ∀ g ∈ (shortPosHom 4 hirrQ 2).range ⊔ (shortNegHom 4 hirrQ 2).range, α g = g := by
  let E := coordinateMinusIsometry 4 K (by norm_num : 1 ≤ 4) b c
  let r := (E.toLinearEquiv.trans (matrixLinearIso s.val)).trans E.symm.toLinearEquiv
  have hr : r ∈ TauCeti.QuadraticMap.orthogonalGroup (quadMinus 4 K b c) := by
    rw [TauCeti.QuadraticMap.mem_orthogonalGroup_iff]
    intro v
    change quadMinus 4 K b c (E.symm (matrixLinearIso s.val (E v))) = quadMinus 4 K b c v
    rw [E.symm.map_app]
    have hs := TauCeti.QuadraticMap.mem_orthogonalGroup_iff.mp s.2 (E v)
    change coordinateQuadMinus 4 K (by norm_num) b c (matrixLinearIso s.val (E v)) =
      coordinateQuadMinus 4 K (by norm_num) b c (E v) at hs
    exact hs.trans (E.map_app v)
  exact aut_eq_self_on_short_roots_of_fix_block hirrQ r hr he hf hp α
    (spinAction_conj_of_coordinate hirrQ α s hα)

end CoordinateAction

section ScalarExtension

variable {G : Type*} [Group G] [Finite G] {B : Type*} {M : CoxeterMatrix B}
  {Weyl : Type*} [Group Weyl] {cs : CoxeterSystem M Weyl} {p : ℕ}
  {k V k' : Type*} [Field k] [Field k'] [Algebra k k'] [AddCommGroup V] [Module k V]

theorem isCurtisType_extendScalars (D : CurtisDatum G cs p)
    (σ : Representation k G V) {y : V} {χ : G → k} {μ : B → k}
    (ht : D.IsCurtisType σ y χ μ) :
    D.IsCurtisType (CFSG.Theory.Representation.extendScalars k' σ)
      ((1 : k') ⊗ₜ[k] y) (fun g => algebraMap k k' (χ g))
      (fun i => algebraMap k k' (μ i)) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro u hu
    rw [CFSG.Theory.Representation.extendScalars_apply, LinearMap.baseChange_tmul,
      ht.1 u hu]
  · intro h
    exact ht.2.1 ((Module.FaithfullyFlat.one_tmul_eq_zero_iff k V (A := k') y).mp h)
  · intro h hh
    rw [CFSG.Theory.Representation.extendScalars_apply, LinearMap.baseChange_tmul,
      ht.2.2.1 h hh, TensorProduct.tmul_smul]
    simp
  · intro i
    rw [CFSG.HardMathSupport.GuralnickMalle.heckeT_extendScalars_tmul,
      ht.2.2.2 i, TensorProduct.tmul_smul]
    simp

end ScalarExtension

section CharacterDescent

variable {K : Type} [Field K] [Finite K] [CharP K 2] {b c : K}
  (hirrQ : ∀ s : K, s ^ 2 + b * s + c ≠ 0)

theorem natural_character_descends {k k' : Type} [Field k] [Field k']
    (ι : k →+* k') {χ : spinGroup (quadMinus 4 K b c) → k} {μ : Fin 3 → k}
    (hμ : ∀ i, ι (μ i) = 0) (ψ : K →+* k')
    (hχ : ∀ h ∈ (curtisDatum 4 (by norm_num) hirrQ).H, ι (χ h) = highestChar ψ h) :
    μ = 0 ∧ ∃ φ : K →+* k,
      ∀ h ∈ (curtisDatum 4 (by norm_num) hirrQ).H, χ h = highestChar φ h := by
  classical
  have hrange : ∀ a : K, ∃ c : k, ι c = ψ a := by
    intro a
    by_cases ha : a = 0
    · exact ⟨0, by rw [ha, map_zero, map_zero]⟩
    let u := Units.mk0 a ha
    let h := (minusFrame 4 b c).longTorus
      (succ_ne_of_lt 4 (k := (0 : Fin 3)) (by norm_num)) true false u
    have hh : h ∈ (curtisDatum 4 (by norm_num) hirrQ).H := by
      refine Subgroup.mem_iSup_of_mem (0 : Fin 3) ?_
      rw [minusTorus_of_lt 4 hirrQ (k := (0 : Fin 3)) (by norm_num)]
      exact ⟨u, rfl⟩
    refine ⟨χ h, ?_⟩
    have heq := hχ h hh
    change ι (χ h) = ψ (mat 4 h (.inl 0) (.inl 0)) at heq
    have hentry : mat 4 h (.inl 0) (.inl 0) = a := by
      simpa [h, u, minusPos] using mat_longTorus_eVec 4 (b := b) (c := c)
        (j := (0 : Fin 3)) (by norm_num) u 0
    rwa [hentry] at heq
  let f : K → k := fun a => (hrange a).choose
  have hf : ∀ a, ι (f a) = ψ a := fun a => (hrange a).choose_spec
  let φ : K →+* k :=
    { toFun := f
      map_one' := ι.injective (by rw [hf, map_one, map_one])
      map_mul' := fun a d => ι.injective (by rw [hf, map_mul ι, hf, hf, map_mul ψ])
      map_zero' := ι.injective (by rw [hf, map_zero, map_zero])
      map_add' := fun a d => ι.injective (by rw [hf, map_add ι, hf, hf, map_add ψ]) }
  refine ⟨funext fun i => ι.injective ((hμ i).trans (map_zero ι).symm), φ, ?_⟩
  intro h hh
  apply ι.injective
  change ι (χ h) = ι (f (mat 4 h (.inl 0) (.inl 0)))
  rw [hf]
  exact hχ h hh

end CharacterDescent

section FirstShortGeneration

variable {K : Type} [Field K] [Finite K] [CharP K 2] {b c : K}
  (hirrQ : ∀ s : K, s ^ 2 + b * s + c ≠ 0)

private theorem reduced_cons {ω : List (Fin 3)} {i : Fin 3}
    (hω : (coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.IsReduced ω)
    (hnot : ¬ (coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.IsLeftDescent
      ((coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.wordProd ω) i) :
    (coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.IsReduced (i :: ω) := by
  change (coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.length
    ((coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.wordProd (i :: ω)) = (i :: ω).length
  have hlen := ((coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.not_isLeftDescent_iff).mp hnot
  rw [CoxeterSystem.wordProd_cons, hlen, hω.eq, List.length_cons]

theorem reduced_first_short :
    (coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.IsReduced
      ([0, 1, 2, 1, 0] : List (Fin 3)) := by
  have hn0 : (coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.IsReduced
      ([] : List (Fin 3)) := by
    simp [CoxeterSystem.IsReduced]
  have step : ∀ (ω : List (Fin 3)) (i k : Fin 3),
      (coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.IsReduced ω →
      0 < weylAction (isFiniteType_cartanB 3)
        ((coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.wordProd ω)⁻¹
        (Pi.single i 1) k →
      (coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.IsReduced (i :: ω) := by
    intro ω i k hω hcoord
    apply reduced_cons hω
    rw [← CoxeterSystem.isRightDescent_inv_iff, isRightDescent_iff]
    intro hle
    have hk : weylAction (isFiniteType_cartanB 3)
      ((coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.wordProd ω)⁻¹
      (Pi.single i 1) k ≤ 0 := hle k
    exact (not_lt_of_ge hk) hcoord
  have h0 := step [] 0 0 hn0 (by simp)
  have h10 := step [0] 1 1 h0 (by
    simp only [CoxeterSystem.wordProd_cons, CoxeterSystem.wordProd_nil,
      mul_one, CoxeterSystem.inv_simple, weylAction_simple]
    norm_num [reflection_apply, cartanB, Fin.sum_univ_succ, Pi.single_apply])
  have h210 := step [1, 0] 2 2 h10 (by
    simp only [CoxeterSystem.wordProd_cons, CoxeterSystem.wordProd_nil,
      mul_one, mul_inv_rev, CoxeterSystem.inv_simple, weylAction_mul_apply, weylAction_simple]
    norm_num [reflection_apply, cartanB, Fin.sum_univ_succ, Pi.single_apply])
  have h1210 := step [2, 1, 0] 1 2 h210 (by
    simp only [CoxeterSystem.wordProd_cons, CoxeterSystem.wordProd_nil,
      mul_one, mul_inv_rev, CoxeterSystem.inv_simple, weylAction_mul_apply, weylAction_simple]
    norm_num [reflection_apply, cartanB, Fin.sum_univ_succ, Pi.single_apply])
  exact step [1, 2, 1, 0] 0 2 h1210 (by
    simp only [CoxeterSystem.wordProd_cons, CoxeterSystem.wordProd_nil,
      mul_one, mul_inv_rev, CoxeterSystem.inv_simple, weylAction_mul_apply, weylAction_simple]
    norm_num [reflection_apply, cartanB, Fin.sum_univ_succ, Pi.single_apply])


