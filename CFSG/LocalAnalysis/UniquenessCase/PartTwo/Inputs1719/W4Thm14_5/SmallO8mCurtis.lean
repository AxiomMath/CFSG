@[expose] noncomputable def coordinateSpinEquiv :
    spinGroup (quadMinus 4 K b c) ≃*
      matrixDerived (coordinateQuadMinus 4 K (by norm_num) b c) :=
  (CFSG.SeitzReduction.SymplecticPilot.peRhoMEquiv (by norm_num : 4 ≤ 4) hirrQ).trans
    (statedDerivedReindexEquiv (minusIndexEquiv 4 (by norm_num))
      (quadMinus 4 K b c) (coe_quadMinus 4 K b c))

omit [Finite K] [CharP K 2] in
theorem coordinateMinus_ne_zero :
    ∃ v, coordinateQuadMinus 4 K (by norm_num) b c v ≠ 0 := by
  refine ⟨coordinateMinusIsometry 4 K (by norm_num : 1 ≤ 4) b c (eVec 4 0 + fVec 4 0), ?_⟩
  rw [QuadraticMap.IsometryEquiv.map_app]
  norm_num [quadMinus_apply, eVec, fVec, Pi.single_apply, Fin.sum_univ_succ]

@[expose] noncomputable def coordinateEquiv :
    spinGroup (quadMinus 4 K b c) ≃*
      matrixProjectiveDerived (coordinateQuadMinus 4 K (by norm_num) b c) :=
  (coordinateSpinEquiv hirrQ).trans
    (CFSG.RankThree.PartOne.AUTSL.derivedProjEquiv _ (coordinateMinus_ne_zero (b := b) (c := c)))

theorem coordinateEquiv_apply (g : spinGroup (quadMinus 4 K b c)) :
    coordinateEquiv hirrQ g = matrixProjectiveProjection
      (coordinateQuadMinus 4 K (by norm_num) b c) (coordinateSpinEquiv hirrQ g) := rfl

theorem exists_isometry_of_involutive_aut {e : ℕ} (he : 1 ≤ e) (hK : Nat.card K = 2 ^ e)
    (α : MulAut (spinGroup (quadMinus 4 K b c))) (hα : α * α = 1) :
    ∃ s : matrixIsometries (coordinateQuadMinus 4 K (by norm_num) b c), s * s = 1 ∧
      ∀ g, coordinateEquiv hirrQ (α g) = matrixProjectiveConjugationHom
        (coordinateQuadMinus 4 K (by norm_num) b c)
        (matrixIsometryInclusion _ s) (coordinateEquiv hirrQ g) := by
  obtain ⟨s, hs, hconj⟩ :=
    CFSG.SeitzReduction.SymplecticPilot.exists_isometry_eq_of_mul_self_minus he hK
      (by norm_num : 4 ≤ 4) hirrQ (α := MulAut.congr (coordinateEquiv hirrQ) α)
      (by rw [← map_mul, hα, map_one])
  exact ⟨s, hs, fun g => by
    have h := congrArg (fun β => β (coordinateEquiv hirrQ g)) hconj
    simpa using h⟩

