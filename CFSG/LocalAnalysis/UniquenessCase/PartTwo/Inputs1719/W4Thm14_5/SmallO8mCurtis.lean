theorem first_short_eq_word :
    shortWeyl 4 hirrQ 0 =
      (([0, 1, 2, 1, 0] : List (Fin 3)).map (minusWeyl 4 hirrQ)).prod := by
  have h0 := conj_shortWeyl_long hirrQ (i := 0) (j := 1) (by decide)
  have h1 := conj_shortWeyl_long hirrQ (i := 1) (j := 2) (by decide)
  have hi0 : (minusWeyl 4 hirrQ 0)⁻¹ = minusWeyl 4 hirrQ 0 :=
    inv_eq_of_mul_eq_one_left (minusWeyl_sq hirrQ 0)
  have hi1 : (minusWeyl 4 hirrQ 1)⁻¹ = minusWeyl 4 hirrQ 1 :=
    inv_eq_of_mul_eq_one_left (minusWeyl_sq hirrQ 1)
  have e0 : shortWeyl 4 hirrQ 0 = minusWeyl 4 hirrQ 0 * shortWeyl 4 hirrQ 1 *
      minusWeyl 4 hirrQ 0 := by
    rw [minusWeyl_of_lt 4 hirrQ (by norm_num : (0 : Fin 3).val + 1 < 4 - 1)] at hi0
    have hh : (minusFrame 4 b c).longWeyl (by decide : (0 : Fin 3) ≠ 1) true false *
        shortWeyl 4 hirrQ 1 * (minusFrame 4 b c).longWeyl (by decide : (0 : Fin 3) ≠ 1)
          true false = shortWeyl 4 hirrQ 0 := by simpa only [hi0] using h0
    simpa only [minusWeyl_of_lt 4 hirrQ (by norm_num : (0 : Fin 3).val + 1 < 4 - 1)] using hh.symm
  have e1 : shortWeyl 4 hirrQ 1 = minusWeyl 4 hirrQ 1 * minusWeyl 4 hirrQ 2 *
      minusWeyl 4 hirrQ 1 := by
    rw [minusWeyl_of_lt 4 hirrQ (by norm_num : (1 : Fin 3).val + 1 < 4 - 1)] at hi1
    rw [minusWeyl_of_not_lt 4 hirrQ (by norm_num : ¬(2 : Fin 3).val + 1 < 4 - 1)]
    have hh : (minusFrame 4 b c).longWeyl (by decide : (1 : Fin 3) ≠ 2) true false *
        shortWeyl 4 hirrQ 2 * (minusFrame 4 b c).longWeyl (by decide : (1 : Fin 3) ≠ 2)
          true false = shortWeyl 4 hirrQ 1 := by simpa only [hi1] using h1
    simpa only [minusWeyl_of_lt 4 hirrQ (by norm_num : (1 : Fin 3).val + 1 < 4 - 1)] using hh.symm
  rw [e0, e1]
  simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
  group


private theorem n_mem_of_word_head {P : Subgroup (spinGroup (quadMinus 4 K b c))}
    (hP : (curtisDatum 4 (by norm_num) hirrQ).U ⊔
      (curtisDatum 4 (by norm_num) hirrQ).H ≤ P)
    {ω : List (Fin 3)} {i : Fin 3}
    (hred : (coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.IsReduced (i :: ω))
    (hword : ((i :: ω).map (minusWeyl 4 hirrQ)).prod ∈ P) :
    minusWeyl 4 hirrQ i ∈ P := by
  let D := curtisDatum 4 (by norm_num) hirrQ
  have hborel : borel (minusDatum 4 hirrQ) (minusTorus 4 hirrQ) ≤ P := by
    change D.H ⊔ D.U ≤ P
    rw [sup_comm]
    exact hP
  have htail : (coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.IsReduced ω := by
    simpa using hred.drop 1
  have hnot : ¬ (coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.IsLeftDescent
      ((coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.wordProd ω) i := by
    rw [CoxeterSystem.not_isLeftDescent_iff]
    have h := hred.eq
    rw [CoxeterSystem.wordProd_cons, List.length_cons, ← htail.eq] at h
    exact h
  apply CFSG.LieType.TitsSimplicity.n_mem_of_nrep_simple_mul_mem
    (minusDatum_isCTGroupDatum 4 hirrQ (by norm_num)) (minusDatum_steinbergExtras 4 hirrQ)
    hborel hnot
  have hprod := nrep_wordProd (minusDatum_isCTGroupDatum 4 hirrQ (by norm_num)) hred
  have hnrep : nrep (minusDatum_isCTGroupDatum 4 hirrQ (by norm_num))
      ((coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.wordProd (i :: ω)) ∈ P := by
    exact hprod.symm ▸ hword
  convert hnrep using 1
  rfl

theorem borel_sup_first_short_eq_top :
    ((curtisDatum 4 (by norm_num) hirrQ).U ⊔
      (curtisDatum 4 (by norm_num) hirrQ).H) ⊔
      ((shortPosHom 4 hirrQ 0).range ⊔ (shortNegHom 4 hirrQ 0).range) = ⊤ := by
  let D := curtisDatum 4 (by norm_num) hirrQ
  let P := (D.U ⊔ D.H) ⊔
    ((shortPosHom 4 hirrQ 0).range ⊔ (shortNegHom 4 hirrQ 0).range)
  have hP : D.U ⊔ D.H ≤ P := le_sup_left
  have hword : (([0, 1, 2, 1, 0] : List (Fin 3)).map (minusWeyl 4 hirrQ)).prod ∈ P := by
    rw [← first_short_eq_word hirrQ]
    exact (le_sup_right :
      ((shortPosHom 4 hirrQ 0).range ⊔ (shortNegHom 4 hirrQ 0).range) ≤ P)
        (shortWeyl_mem 4 hirrQ 0)
  have hred := reduced_first_short
  have hn0 : minusWeyl 4 hirrQ 0 ∈ P := n_mem_of_word_head hirrQ hP hred hword
  have hword1 : (([1, 2, 1, 0] : List (Fin 3)).map (minusWeyl 4 hirrQ)).prod ∈ P := by
    have h := P.mul_mem (P.inv_mem hn0) hword
    simpa only [List.map_cons, List.prod_cons, inv_mul_cancel_left] using h
  have hred1 : (coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.IsReduced
      ([1, 2, 1, 0] : List (Fin 3)) := by simpa using hred.drop 1
  have hn1 : minusWeyl 4 hirrQ 1 ∈ P := n_mem_of_word_head hirrQ hP hred1 hword1
  have hword2 : (([2, 1, 0] : List (Fin 3)).map (minusWeyl 4 hirrQ)).prod ∈ P := by
    have h := P.mul_mem (P.inv_mem hn1) hword1
    simpa only [List.map_cons, List.prod_cons, inv_mul_cancel_left] using h
  have hred2 : (coxeterMatrix (isFiniteType_cartanB 3)).toCoxeterSystem.IsReduced
      ([2, 1, 0] : List (Fin 3)) := by simpa using hred.drop 2
  have hn2 : minusWeyl 4 hirrQ 2 ∈ P := n_mem_of_word_head hirrQ hP hred2 hword2
  apply CFSG.LieType.TitsSimplicity.eq_top_of_forall_n_mem
    (minusDatum_isCTGroupDatum 4 hirrQ (by norm_num))
  · change D.H ⊔ D.U ≤ P
    rw [sup_comm]
    exact hP
  · intro i
    fin_cases i
    · exact hn0
    · exact hn1
    · exact hn2

