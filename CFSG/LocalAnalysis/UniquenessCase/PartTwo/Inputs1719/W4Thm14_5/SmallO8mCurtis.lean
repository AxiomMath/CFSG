private theorem minusWeyl_sq (i : Fin 3) : minusWeyl 4 hirrQ i * minusWeyl 4 hirrQ i = 1 := by
  by_cases hi : i.val < 2
  · rw [minusWeyl_of_lt 4 hirrQ (by omega),
      (minusFrame 4 b c).toHypFrame.longWeyl_mul_self]
    have hneg : (-1 : Kˣ) = 1 := by
