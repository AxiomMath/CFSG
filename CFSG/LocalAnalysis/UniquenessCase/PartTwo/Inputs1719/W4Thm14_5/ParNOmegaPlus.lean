private theorem pCore_eq_bot_of_isL2 {X : Type} [Group X] [Finite X] {k : ℕ} (h : IsL2 X k) :
    CFSG.pCore 2 X = ⊥ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hq := NatParMax.isQuasisimple_of_isL2 h
  have : IsSimpleGroup X := CFSG.Blueprint.LieModel.isSimpleGroup_psl_two h
  rcases (CFSG.pCore_normal (p := 2) (G := X)).eq_bot_or_eq_top with h1 | h1
  · exact h1
  · exfalso
    have hp : IsPGroup 2 ↥(CFSG.pCore 2 X) := CFSG.pCore_isPGroup
    rw [h1] at hp
    have hp' : IsPGroup 2 X := hp.of_equiv Subgroup.topEquiv
    have : Group.IsPerfect X := ⟨hq.1⟩
    exact Group.IsPerfect.not_isNilpotent X hp'.isNilpotent

private theorem nonempty_bar2_equiv_of_pCore_eq_bot {G Y : Type} [Group G] [Group Y]
    {X : Subgroup G} (ψ : ↥X ≃* Y) (hY : CFSG.pCore 2 Y = ⊥) : Nonempty (Bar2 X ≃* Y) := by
  have hX : CFSG.pCore 2 ↥X = ⊥ := by
    rw [← CFSG.pCore_map_iso 2 ψ.symm, hY, Subgroup.map_bot]
  exact ⟨(QuotientGroup.quotientMulEquivOfEq hX).trans (QuotientGroup.quotientBot.trans ψ)⟩

private theorem map_conj_eq_of_mem_normalizer {W : Type} [CommGroup W]
    {X : Subgroup (MulAut W)} {r : MulAut W} (hr : r ∈ normalizer (X : Set (MulAut W))) :
    X.map (MulAut.conj r).toMonoidHom = X := by
  apply le_antisymm
  · rintro _ ⟨y, hy, rfl⟩
    simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] using
      (Subgroup.mem_normalizer_iff.mp hr y).mp hy
  · intro z hz
    refine ⟨r⁻¹ * z * r, ?_, ?_⟩
    · have h := (Subgroup.mem_normalizer_iff.mp ((normalizer (X : Set (MulAut W))).inv_mem hr) z).mp
        hz
      rw [inv_inv] at h
      exact h
    · simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      group

private theorem prodFirstFactor_trans_prodComm {X A B : Type} [Group X] [Group A] [Group B]
    (e : X ≃* A × B) : prodFirstFactor (e.trans (MulEquiv.prodComm)) = prodSecondFactor e := by
  ext x
  rw [mem_prodFirstFactor_iff, mem_prodSecondFactor_iff]
  simp [Subgroup.mem_prod]

variable {W : Type} [CommGroup W]

private theorem eq_of_factor_le [Finite W] {H R S P : Subgroup (MulAut W)} {k n : ℕ}
    {A B : Type} [Group A] [Group B] [Finite A] [Finite B] (e : ↥H ≃* A × B)
    (hLA : IsL2 A k) (hLB : IsL2 B k) (hperf : ⁅H, H⁆ = H) (hS : IsSylowIn 2 S H)
    (hRH : R ≤ normalizer (H : Set (MulAut W))) (hRS : R ≤ normalizer (S : Set (MulAut W)))
    (hBP : H ⊓ normalizer (S : Set (MulAut W)) ≤ P) (hPH : P ≤ H)
    (hRP : R ≤ normalizer (P : Set (MulAut W)))
    (hmin : ∀ Q : Subgroup (MulAut W), Q < P → H ⊓ normalizer (S : Set (MulAut W)) ≤ Q →
      R ≤ normalizer (Q : Set (MulAut W)) → Hinf Q = ⊥)
    (hN : NParam (Hinf P) n)
    (hborel : Hinf (normalizer (((hS.toSylow : Sylow 2 ↥H) : Subgroup ↥H) : Set ↥H)) = ⊥)
    (hF : prodFirstFactor e ≤ P.subgroupOf H) : n = k := by
  have : Finite (MulAut W) :=
    Finite.of_injective (fun f : MulAut W => (f : W → W)) DFunLike.coe_injective
  have hqA := NatParMax.isQuasisimple_of_isL2 hLA
  have hqB := NatParMax.isQuasisimple_of_isL2 hLB
  have h₁ := NatParMax.isComponentOf_map_prodFirstFactor e hqA
  have h₂ := NatParMax.isComponentOf_map_prodSecondFactor e hqB
  have hH := NatParMax.map_prodFirstFactor_sup_map_prodSecondFactor e
  have hH₁P : (prodFirstFactor e).map H.subtype ≤ P :=
    NatParMax.map_prodFirstFactor_le_of_le_subgroupOf e hF
  have hperf₁ : ⁅(prodFirstFactor e).map H.subtype, (prodFirstFactor e).map H.subtype⁆ =
      (prodFirstFactor e).map H.subtype := by
    have : Group.IsPerfect ↥((prodFirstFactor e).map H.subtype) := ⟨h₁.2.2.1⟩
    exact Subgroup.commutator_eq_self
  by_cases hR1 : ∀ r ∈ R,
      ((prodFirstFactor e).map H.subtype).map (MulAut.conj r).toMonoidHom =
        (prodFirstFactor e).map H.subtype
  ·
    set N' : Subgroup ↥H :=
      normalizer (((hS.toSylow : Sylow 2 ↥H) : Subgroup ↥H) : Set ↥H) with hN'
    have hN'map : N'.map H.subtype = H ⊓ normalizer (S : Set (MulAut W)) := by
      rw [hN', IsSylowIn.coe_toSylow hS, NatParMax.normalizer_subgroupOf_eq hS.le,
        Subgroup.subgroupOf_map_subtype, inf_comm]
    have hQ₁ : (prodFirstFactor e ⊔ N').map H.subtype =
        (prodFirstFactor e).map H.subtype ⊔ (H ⊓ normalizer (S : Set (MulAut W))) := by
      rw [Subgroup.map_sup, hN'map]
    have hQ₁P : (prodFirstFactor e ⊔ N').map H.subtype ≤ P := hQ₁ ▸ sup_le hH₁P hBP
    have hBQ₁ : H ⊓ normalizer (S : Set (MulAut W)) ≤ (prodFirstFactor e ⊔ N').map H.subtype :=
      hQ₁ ▸ le_sup_right
    have hRQ₁ : R ≤ normalizer (((prodFirstFactor e ⊔ N').map H.subtype : Subgroup (MulAut W)) :
        Set (MulAut W)) := by
      intro r hr
      refine mem_normalizer_of_map_conj_le ?_
      rw [hQ₁, Subgroup.map_sup, hR1 r hr]
      refine sup_le_sup_left ?_ _
      intro x hx
      have hrinv : r⁻¹ ∈ normalizer (S : Set (MulAut W)) := (normalizer _).inv_mem (hRS hr)
      refine ⟨r⁻¹ * x * r, ⟨?_, ?_⟩, by simp [MulAut.conj_apply, mul_assoc]⟩
      · simpa using (Subgroup.mem_normalizer_iff.mp ((normalizer _).inv_mem (hRH hr)) x).mp hx.1
      · exact (normalizer _).mul_mem ((normalizer _).mul_mem hrinv hx.2) (hRS hr)
    have hH₁ne : (prodFirstFactor e).map H.subtype ≠ ⊥ := by
      intro hbot
      have : Subsingleton ↥((prodFirstFactor e).map H.subtype) := by
        rw [hbot]
        infer_instance
      have hsimp := h₁.2.2.2
      exact not_subsingleton _ ((QuotientGroup.mk'_surjective _).subsingleton :
        Subsingleton (↥((prodFirstFactor e).map H.subtype) ⧸
          Subgroup.center ↥((prodFirstFactor e).map H.subtype)))
    have hQ₁inf : Hinf ((prodFirstFactor e ⊔ N').map H.subtype) ≠ ⊥ := by
      intro hbot
      apply hH₁ne
      rw [eq_bot_iff, ← hbot]
      exact uc22p21c_le_Hinf (hQ₁ ▸ le_sup_left) hperf₁
    have hQ₁eq : (prodFirstFactor e ⊔ N').map H.subtype = P := by
      by_contra hne
      exact hQ₁inf (hmin _ (lt_of_le_of_ne hQ₁P hne) hBQ₁ hRQ₁)
    set π₂ : ↥H →* B := (MonoidHom.snd A B).comp e.toMonoidHom with hπ₂
    have hker : π₂.ker = prodFirstFactor e := by
      ext x
      rw [MonoidHom.mem_ker, mem_prodFirstFactor_iff, Subgroup.mem_prod]
      simp [hπ₂]
    have hF₁map : (prodFirstFactor e).map π₂ = ⊥ := by
      rw [Subgroup.map_eq_bot_iff, hker]
    have hinf_le : Hinf (prodFirstFactor e ⊔ N') ≤ prodFirstFactor e := by
      have h1 : (Hinf (prodFirstFactor e ⊔ N')).map π₂ = ⊥ := by
        rw [Hinf_map π₂, Subgroup.map_sup, hF₁map, bot_sup_eq, ← Hinf_map π₂, hborel,
          Subgroup.map_bot]
      have h2 := (Subgroup.map_eq_bot_iff _).mp h1
      rwa [hker] at h2
    have hperfF₁ : ⁅prodFirstFactor e, prodFirstFactor e⁆ = prodFirstFactor e := by
      apply Subgroup.map_injective H.subtype_injective
      rw [Subgroup.map_commutator]
      exact hperf₁
    have hle_inf : prodFirstFactor e ≤ Hinf (prodFirstFactor e ⊔ N') :=
      uc22p21c_le_Hinf le_sup_left hperfF₁
    have hHinfP : Hinf P = (prodFirstFactor e).map H.subtype := by
      rw [← hQ₁eq, ← Hinf_map H.subtype, le_antisymm hinf_le hle_inf]
    let ψ : ↥(Hinf P) ≃* A :=
      (MulEquiv.subgroupCongr hHinfP).trans
        (((prodFirstFactor e).equivMapOfInjective H.subtype H.subtype_injective).symm.trans
          (prodFirstFactorMulEquiv e))
    obtain ⟨χ⟩ := nonempty_bar2_equiv_of_pCore_eq_bot ψ (pCore_eq_bot_of_isL2 hLA)
    exact kNshape_holds _ _ n k hN (Or.inl (CFSG.Blueprint.LieModel.of_mulEquiv χ.symm hLA))
  ·
    push Not at hR1
    obtain ⟨r, hr, hne⟩ := hR1
    have hcomp : IsComponentOf (((prodFirstFactor e).map H.subtype).map
        (MulAut.conj r).toMonoidHom) H := by
      have h := CFSG.Goldschmidt.G37.open_isComponentOf_map (MulAut.conj r) h₁
      rwa [map_conj_eq_of_mem_normalizer (hRH hr)] at h
    have hH₂ : ((prodFirstFactor e).map H.subtype).map (MulAut.conj r).toMonoidHom =
        (prodSecondFactor e).map H.subtype :=
      (NatParMax.eq_factor_of_isComponentOf hH h₁ h₂ hcomp).resolve_left hne
    have hH₂P : (prodSecondFactor e).map H.subtype ≤ P := by
      rw [← hH₂, ← map_conj_eq_of_mem_normalizer (hRP hr)]
      exact Subgroup.map_mono hH₁P
    have hPeq : P = H := le_antisymm hPH (hH ▸ sup_le hH₁P hH₂P)
    have hHinf : Hinf P = H := by
      rw [hPeq]
      exact le_antisymm (uc22p21c_Hinf_le H) (uc22p21c_le_Hinf le_rfl hperf)
    let ψ : ↥(Hinf P) ≃* A × B := (MulEquiv.subgroupCongr hHinf).trans e
    obtain ⟨χ⟩ := nonempty_bar2_equiv_of_pCore_eq_bot ψ
      (KTabD.pCore_prod_eq_bot (pCore_eq_bot_of_isL2 hLA) (pCore_eq_bot_of_isL2 hLB))
    exact kNshape_holds _ _ n k hN (Or.inr ⟨A, B, inferInstance, inferInstance, ⟨χ⟩, hLA, hLB⟩)

theorem eq_of_omegaPlusFour [Finite W] {H R S P : Subgroup (MulAut W)} {k n : ℕ}
    (hΩ : IsOmegaPlus ↥H 4 k) (hNat : NatOmegaPlus H ⊤ ⊥ 4 k) (hk : 2 ≤ k)
    (hperf : ⁅H, H⁆ = H) (hS : IsSylowIn 2 S H)
    (hRH : R ≤ normalizer (H : Set (MulAut W))) (hRS : R ≤ normalizer (S : Set (MulAut W)))
    (hBP : H ⊓ normalizer (S : Set (MulAut W)) ≤ P) (hPH : P ≤ H)
    (hRP : R ≤ normalizer (P : Set (MulAut W)))
    (hcomm : commSub (fixV S) (Hinf P) ≠ ⊥)
    (hmin : ∀ Q : Subgroup (MulAut W), Q < P → H ⊓ normalizer (S : Set (MulAut W)) ≤ Q →
      R ≤ normalizer (Q : Set (MulAut W)) → Hinf Q = ⊥)
    (hN : NParam (Hinf P) n) : n = k := by
  have : Finite (MulAut W) :=
    Finite.of_injective (fun f : MulAut W => (f : W → W)) DFunLike.coe_injective
  have hSN : S ≤ normalizer (S : Set (MulAut W)) := Subgroup.le_normalizer
  have hSP : S ≤ P := fun s hs => hBP ⟨hS.le hs, hSN hs⟩
  have hPnot : ¬ P ≤ stabSub (fixV S) := not_le_stabSub_of_commSub_ne_bot hS hSP hPH hcomm
  obtain ⟨A, B, hAg, hBg, ⟨eAB⟩, hLA, hLB⟩ := isL2Square_of_isOmegaPlus hk hΩ
  let : Group A := hAg
  let : Group B := hBg
  have : Finite (A × B) := Finite.of_injective (eAB.symm : A × B → ↥H) eAB.symm.injective
  have : Finite A := Finite.of_surjective (MonoidHom.fst A B) (fun a => ⟨(a, 1), rfl⟩)
  have : Finite B := Finite.of_surjective (MonoidHom.snd A B) (fun b => ⟨(1, b), rfl⟩)
  have hborel : Hinf (normalizer (((hS.toSylow : Sylow 2 ↥H) : Subgroup ↥H) : Set ↥H)) = ⊥ := by
    obtain ⟨-, K, hKf, hKfin, hKcard, hreal⟩ := hNat
    let : Field K := hKf
    have : Finite K := hKfin
    have : CharP K 2 := CFSG.Timmesfeld.ClassicalOrders.charP_two_of_card_eq hKcard
    have h4 : 4 ≤ Nat.card K := by
      rw [hKcard]
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) hk
    obtain ⟨φ, hφ⟩ := KTabD.exists_mulEquiv_pointStab_eq_map hreal (KTabC.sylowFixedLine_plus K h4)
      hS.toSylow
    have hpt : Hinf (KTabD.pointStab H hS.toSylow) = ⊥ := by
      rw [hφ]
      exact (KTabD.hinf_map_mulEquiv_eq_bot_iff φ _).mpr
        (Hinf_eq_bot_of_isSolvable KTabD.isSolvable_lineStab_statedOmegaPlus_two)
    rw [eq_bot_iff, ← hpt]
    exact uc22p21c_le_Hinf ((uc22p21c_Hinf_le _).trans
      (normalizer_sylow_le_stabilizer_fixedPointSubgroup H hS.toSylow)) (uc22p21c_Hinf_perfect _)
  have hA : ∀ (T : Sylow 2 A) (Q : Subgroup A), (T : Subgroup A) ≤ Q → Q ≠ ⊤ →
      Q ≤ normalizer (T : Set A) :=
    fun T Q h1 h2 => l2_sylow_le_normalizer hk hLA T Q h1 h2
  have hB : ∀ (T : Sylow 2 B) (Q : Subgroup B), (T : Subgroup B) ≤ Q → Q ≠ ⊤ →
      Q ≤ normalizer (T : Set B) :=
    fun T Q h1 h2 => l2_sylow_le_normalizer hk hLB T Q h1 h2
  have hcA : ∀ T : Sylow 2 A, ⁅(⊤ : Subgroup A), normalizer (T : Set A)⁆ = ⊤ :=
    fun T => commutator_top_normalizer_eq_top hk hLA T
  have hcB : ∀ T : Sylow 2 B, ⁅(⊤ : Subgroup B), normalizer (T : Set B)⁆ = ⊤ :=
    fun T => commutator_top_normalizer_eq_top hk hLB T
  have hY : normalizer (((hS.toSylow : Sylow 2 ↥H) : Subgroup ↥H) : Set ↥H) ≤ P.subgroupOf H := by
    intro y hy
    have hy' : y ∈ (normalizer (S : Set (MulAut W))).subgroupOf H := by
      rw [← NatParMax.normalizer_subgroupOf_eq hS.le, ← IsSylowIn.coe_toSylow hS]
      exact hy
    exact Subgroup.mem_subgroupOf.mpr (hBP ⟨y.2, Subgroup.mem_subgroupOf.mp hy'⟩)
  rcases NatParMax.le_normalizer_or_prodFactor_le eAB hA hB hcA hS.toSylow hY with
    hYle | hF1 | hF2
  · exfalso
    apply hPnot
    have hPN : P ≤ normalizer (S : Set (MulAut W)) := by
      refine NatParMax.le_normalizer_of_subgroupOf_le hS.le hPH ?_
      rw [← IsSylowIn.coe_toSylow hS]
      exact hYle
    exact (le_inf hPH hPN).trans (NatParMax.inf_normalizer_le_inf_stabSub H S) |>.trans inf_le_right
  · exact eq_of_factor_le eAB hLA hLB hperf hS hRH hRS hBP hPH hRP hmin hN hborel hF1
  · refine eq_of_factor_le (eAB.trans MulEquiv.prodComm) hLB hLA hperf hS hRH hRS hBP hPH hRP
      hmin hN hborel ?_
    rw [prodFirstFactor_trans_prodComm]
    exact hF2

end CFSG.LocalAnalysis.UniquenessCase.PartTwo.Inputs1719.Thm14_5
