theorem stableUnder_of_natOmegaMinus {H : Subgroup (MulAut W)} {I Z : Subgroup W} {n k : ℕ}
    (h : NatOmegaMinus H I Z n k) : StableUnder H I := by
  obtain ⟨-, K, hKf, hKfin, b, c, -, -, π, hπ⟩ := h
  exact fun x hx w hw => hπ.2.2.2.1 ⟨x, hx⟩ w hw

theorem one_le_of_natOmegaMinus_sec {H : Subgroup (MulAut W)} {I Z : Subgroup W} {n k : ℕ}
    (h : NatOmegaMinus H I Z n k) : 1 ≤ k := by
  obtain ⟨-, K, hKf, hKfin, b, c, hK, -, -⟩ := h
  let : Field K := hKf
  have : Finite K := hKfin
  have h1 : 1 < Nat.card K := Finite.one_lt_card
  rw [hK] at h1
  exact Nat.pos_of_ne_zero fun hk0 => by
    rw [hk0, pow_zero] at h1
    exact lt_irrefl 1 h1

private theorem exists_equiv_of_natOmegaMinus {H : Subgroup (MulAut W)} {I : Subgroup W} {k : ℕ}
    (h : NatOmegaMinus H I ⊥ 4 k) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (_ : CharP K 2) (b c : K), Nat.card K = 2 ^ k ∧
      (∀ s : K, s ^ 2 + b * s + c ≠ 0) ∧
      ∃ (π : ↥(StatedOmega (StatedQuadMinus 2 K b c)) →* ↥H)
        (e : ↥I ≃* Multiplicative (Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K)),
        Function.Surjective π ∧
        ∀ (γ : ↥(StatedOmega (StatedQuadMinus 2 K b c))) (u : ↥I)
          (hu : ((π γ : ↥H) : MulAut W) (u : W) ∈ I),
          e ⟨_, hu⟩ = natAct _ γ (e u) := by
  obtain ⟨-, K, hKf, hKfin, b, c, hKc, hirr, π, hπ⟩ := h
  let : Field K := hKf
  have : Finite K := hKfin
  have : CharP K 2 := CFSG.Timmesfeld.ClassicalOrders.charP_two_of_card_eq hKc
  have hπ' : (FFModel.nat (StatedOmega (StatedQuadMinus 2 K b c))).RealizesVia H I ⊥ π := hπ
  obtain ⟨e, he⟩ := CFSG.Quasithin.H.SL3Pair.exists_mulEquiv_of_realizesVia_sub _ hπ'
  exact ⟨K, hKf, hKfin, inferInstance, b, c, hKc, hirr, π, e, hπ'.1, he⟩

theorem ne_bot_of_natOmegaMinus {H : Subgroup (MulAut W)} {I : Subgroup W} {k : ℕ}
    (h : NatOmegaMinus H I ⊥ 4 k) : I ≠ ⊥ := by
  obtain ⟨K, _, _, _, b, c, -, -, π, e, -, -⟩ := exists_equiv_of_natOmegaMinus h
  intro hI
  let m : ↥I := e.symm (Multiplicative.ofAdd (Pi.single (Sum.inr (Sum.inr 0)) 1))
  have hm : (m : W) = 1 := by
    have h0 : (m : W) ∈ (⊥ : Subgroup W) := by
      rw [← hI]
      exact m.2
    exact Subgroup.mem_bot.mp h0
  have h1 : m = 1 := Subtype.ext hm
  have h2 := congrArg (fun x => Multiplicative.toAdd (e x) (Sum.inr (Sum.inr 0))) h1
  simp [m] at h2

theorem sq_eq_one_of_natOmegaMinus {H : Subgroup (MulAut W)} {I : Subgroup W} {k : ℕ}
    (h : NatOmegaMinus H I ⊥ 4 k) : ∀ v ∈ I, v ^ 2 = 1 := by
  obtain ⟨K, _, _, _, b, c, -, -, π, e, -, -⟩ := exists_equiv_of_natOmegaMinus h
  intro v hv
  have h2 : e (⟨v, hv⟩ ^ 2) = e 1 := by
    rw [map_pow, map_one, sq]
    apply Multiplicative.toAdd.injective
    ext i
    simp [CharTwo.add_self_eq_zero]
  have h3 := congrArg Subtype.val (e.injective h2)
  simpa using h3

theorem eq_bot_or_eq_of_natOmegaMinus {H : Subgroup (MulAut W)} {I : Subgroup W} {k : ℕ}
    (h : NatOmegaMinus H I ⊥ 4 k) :
    ∀ J : Subgroup W, StableUnder H J → J ≤ I → J = ⊥ ∨ J = I := by
  have hIs := stableUnder_of_natOmegaMinus h
  obtain ⟨K, _, _, _, b, c, -, hirr, π, e, -, he⟩ := exists_equiv_of_natOmegaMinus h
  intro J hJ hJI
  let A : AddSubgroup (Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K) :=
    Subgroup.toAddSubgroup' ((J.subgroupOf I).comap e.symm.toMonoidHom)
  have hmemA : ∀ v, v ∈ A ↔ ((e.symm (Multiplicative.ofAdd v) : ↥I) : W) ∈ J := fun v => Iff.rfl
  have hAinv : ∀ γ ∈ StatedOmega (StatedQuadMinus 2 K b c), ∀ v ∈ A,
      (γ : Matrix _ _ K) *ᵥ v ∈ A := by
    intro γ hγ v hv
    rw [hmemA] at hv ⊢
    set u : ↥I := e.symm (Multiplicative.ofAdd v)
    have hu : ((π ⟨γ, hγ⟩ : ↥H) : MulAut W) (u : W) ∈ I := hIs _ (π ⟨γ, hγ⟩).2 _ u.2
    have h1 := he ⟨γ, hγ⟩ u hu
    rw [MulEquiv.apply_symm_apply] at h1
    have h2 : e.symm (Multiplicative.ofAdd ((γ : Matrix _ _ K) *ᵥ v)) = ⟨_, hu⟩ := by
      rw [MulEquiv.symm_apply_eq, h1]
      rfl
    rw [h2]
    exact hJ _ (π ⟨γ, hγ⟩).2 _ hv
  rcases OmegaMinusFourIrr.isNatIrr_statedOmegaMinus_two hirr A hAinv with hA | hA
  · left
    rw [eq_bot_iff]
    intro w hw
    have hwA : Multiplicative.toAdd (e ⟨w, hJI hw⟩) ∈ A := by
      rw [hmemA, ofAdd_toAdd, MulEquiv.symm_apply_apply]
      exact hw
    rw [hA, AddSubgroup.mem_bot] at hwA
    have h1 : e ⟨w, hJI hw⟩ = 1 := by
      rw [← ofAdd_toAdd (e ⟨w, hJI hw⟩), hwA, ofAdd_zero]
    have h2 := congrArg Subtype.val ((MulEquiv.map_eq_one_iff e).mp h1)
    simpa using h2
  · right
    refine le_antisymm hJI fun w hw => ?_
    have hwA : Multiplicative.toAdd (e ⟨w, hw⟩) ∈ A := by
      rw [hA]
      exact AddSubgroup.mem_top _
    rw [hmemA, ofAdd_toAdd, MulEquiv.symm_apply_apply] at hwA
    exact hwA

theorem eq_one_of_natOmegaMinus {H : Subgroup (MulAut W)} {I : Subgroup W} {k : ℕ}
    (h : NatOmegaMinus H I ⊥ 4 k) : ∀ g ∈ H, (∀ v ∈ I, g v = v) → g = 1 := by
  obtain ⟨K, _, _, _, b, c, -, -, π, e, hπs, he⟩ := exists_equiv_of_natOmegaMinus h
  intro g hg hgI
  obtain ⟨γ, hγ⟩ := hπs ⟨g, hg⟩
  have hγ1 : γ = 1 := by
    refine natAct_faithful _ γ fun m => ?_
    set u : ↥I := e.symm m
    have hgu : ((π γ : ↥H) : MulAut W) (u : W) = (u : W) := by
      rw [hγ]
      exact hgI u u.2
    have hu : ((π γ : ↥H) : MulAut W) (u : W) ∈ I := by
      rw [hgu]
      exact u.2
    have h1 := he γ u hu
    have h2 : (⟨((π γ : ↥H) : MulAut W) (u : W), hu⟩ : ↥I) = u := Subtype.ext hgu
    rw [h2, MulEquiv.apply_symm_apply] at h1
    rw [← h1, mul_inv_cancel]
  have : (⟨g, hg⟩ : ↥H) = 1 := by rw [← hγ, hγ1, map_one]
  exact congrArg Subtype.val this

theorem exists_card_inf_fixV_le_of_natOmegaMinus {H : Subgroup (MulAut W)} {I : Subgroup W}
    {k : ℕ} (h : NatOmegaMinus H I ⊥ 4 k) :
    ∃ S : Subgroup (MulAut W), S ≤ H ∧ IsPGroup 2 S ∧ Nat.card ↥(I ⊓ fixV S) ≤ 2 ^ k := by
  obtain ⟨K, _, _, _, b, c, hKc, hirr, π, e, -, he⟩ := exists_equiv_of_natOmegaMinus h
  obtain ⟨U, hU, hfix⟩ := KTabA.exists_fixedLine_statedOmega_minus_single (K := K) le_rfl hirr
  refine ⟨(U.map π).map H.subtype, Subgroup.map_subtype_le _, (hU.map π).map H.subtype, ?_⟩
  have hline : ∀ w : ↥(I ⊓ fixV ((U.map π).map H.subtype)),
      Multiplicative.toAdd (e ⟨w, (Subgroup.mem_inf.1 w.2).1⟩) ∈
        Submodule.span K {(Pi.single (Sum.inl ⟨0, by omega⟩) 1 :
          Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2 → K)} := by
    intro w
    refine hfix _ fun γ hγ => ?_
    have hwI : (w : W) ∈ I := (Subgroup.mem_inf.1 w.2).1
    have hγw : ((π γ : ↥H) : MulAut W) (w : W) = w :=
      mem_fixV.1 (Subgroup.mem_inf.1 w.2).2 _ ⟨π γ, ⟨γ, hγ, rfl⟩, rfl⟩
    have hu : ((π γ : ↥H) : MulAut W) (w : W) ∈ I := hγw.symm ▸ hwI
    have h1 := he γ ⟨w, hwI⟩ hu
    have h2 : (⟨((π γ : ↥H) : MulAut W) (w : W), hu⟩ : ↥I) = ⟨w, hwI⟩ := Subtype.ext hγw
    rw [h2] at h1
    exact (congrArg Multiplicative.toAdd h1).symm
  let f : ↥(I ⊓ fixV ((U.map π).map H.subtype)) → K := fun w =>
    Multiplicative.toAdd (e ⟨w, (Subgroup.mem_inf.1 w.2).1⟩) (Sum.inl ⟨0, by omega⟩)
  have hf : Function.Injective f := by
    intro w w' hww'
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp (hline w)
    obtain ⟨a', ha'⟩ := Submodule.mem_span_singleton.mp (hline w')
    have h1 : a = a' := by
      have := hww'
      simp only [f, ← ha, ← ha'] at this
      simpa using this
    have h2 : e ⟨w, (Subgroup.mem_inf.1 w.2).1⟩ = e ⟨w', (Subgroup.mem_inf.1 w'.2).1⟩ := by
      apply Multiplicative.toAdd.injective
      rw [← ha, ← ha', h1]
    have h3 := congrArg Subtype.val (e.injective h2)
    exact Subtype.ext h3
  calc Nat.card ↥(I ⊓ fixV ((U.map π).map H.subtype)) ≤ Nat.card K :=
        Nat.card_le_card_of_injective f hf
    _ = 2 ^ k := hKc

theorem aParam_autSub_normalizer_le_of_natOmegaMinus [Finite W] {H : Subgroup (MulAut W)}
    {I : Subgroup W} {k : ℕ} (hΩ : IsOmegaMinus ↥H 4 k) (h : NatOmegaMinus H I ⊥ 4 k) :
    E3.aParam (autSub (Subgroup.normalizer (H : Set (MulAut W))) I) ≤ k := by
  have hst : H ≤ stabSub I := le_stabSub_of_stableUnder (stableUnder_of_natOmegaMinus h)
  have hfaith := eq_one_of_natOmegaMinus h
  let ρ : ↥H ≃* ↥(autSub H I) := FFC.resEquiv hst hfaith
  have hΩ' : IsOmegaMinus ↥(autSub H I) 4 k := by
    obtain ⟨hev, K, hKf, hKfin, b, c, hKc, hirr, ⟨φ⟩⟩ := hΩ
    exact ⟨hev, K, hKf, hKfin, b, c, hKc, hirr, ⟨ρ.symm.trans φ⟩⟩
  have hN' : NatOmegaMinus (autSub H I) ⊤ ⊥ 4 k := by
    obtain ⟨hev, K, hKf, hKfin, b, c, hKc, hirr, hR⟩ := h
    have hR' := FFC.B59.realizes_comap hst hfaith hR
    have hbot : (⊥ : Subgroup W).comap I.subtype = ⊥ := by
      ext x
      simp
    rw [hbot] at hR'
    exact ⟨hev, K, hKf, hKfin, b, c, hKc, hirr, hR'⟩
  have hle : autSub H I ≤ autSub (Subgroup.normalizer (H : Set (MulAut W))) I :=
    autSub_mono Subgroup.le_normalizer I
  have hnorm : autSub (Subgroup.normalizer (H : Set (MulAut W))) I ≤
      Subgroup.normalizer ((autSub H I : Subgroup (MulAut ↥I)) : Set (MulAut ↥I)) := by
    intro φ hφ
    obtain ⟨g, hgN, rfl⟩ := mem_autSub.mp hφ
    rw [Subgroup.mem_normalizer_iff]
    intro ψ
    constructor
    · intro hψ
      obtain ⟨g', hg'H, rfl⟩ := mem_autSub.mp hψ
      rw [← map_inv, ← map_mul, ← map_mul]
      refine mem_autSub.mpr ⟨g * g' * g⁻¹, ?_, rfl⟩
      exact (Subgroup.mem_normalizer_iff.mp hgN g').mp hg'H
    · intro hψ
      obtain ⟨g'', hg''H, hg''⟩ := mem_autSub.mp hψ
      have h1 : ψ = resHom I (g⁻¹ * g'' * g) := by
        rw [map_mul, map_mul, hg'', map_inv]
        group
      rw [h1]
      refine mem_autSub.mpr ⟨g⁻¹ * g'' * g, ?_, rfl⟩
      have h2 := (Subgroup.mem_normalizer_iff.mp ((Subgroup.normalizer _).inv_mem hgN)
        (g'' : MulAut W)).mp hg''H
      simpa [mul_assoc] using h2
  exact kNatOm4mA_holds ↥I (autSub H I) _ k hΩ' hN' hle hnorm

