open CFSG.Open CFSG.LocalAnalysis.UniquenessCase.UC22 Subgroup

theorem nonempty_bar2_hinf_equiv_of_subgroupOf_eq_map {G Γ : Type} [Group G] [Finite G]
    [Group Γ] [Finite Γ] {H P : Subgroup G} (hPH : P ≤ H) (φ : Γ ≃* ↥H) {Q : Subgroup Γ}
    (hPQ : P.subgroupOf H = Q.map φ.toMonoidHom) :
    Nonempty (Bar2 (Hinf P) ≃* Bar2 (Hinf Q)) := by
  obtain ⟨χ₁⟩ := nonempty_bar2_hinf_subgroupOf hPH
  rw [hPQ] at χ₁
  obtain ⟨χ₂⟩ := nonempty_bar2_hinf_map_mulEquiv φ Q
  exact ⟨χ₁.trans χ₂⟩

variable {G : Type} [Group G] [Finite G] {L : Subgroup G} {K : Type} [Field K] [Finite K]

theorem nParam_eq_of_mulEquiv_sl2_prod {k n : ℕ} (hk : 2 ≤ k) (hK : Nat.card K = 2 ^ k)
    (hN : NParam L n)
    (e : Bar2 L ≃* Matrix.SpecialLinearGroup (Fin 2) K × Matrix.SpecialLinearGroup (Fin 2) K) :
    n = k :=
  kNshape_holds G L n k hN (Or.inr ⟨_, _, inferInstance, inferInstance, ⟨e⟩,
    KTabD.isL2_of_mulEquiv_sl2 hk hK (MulEquiv.refl _),
    KTabD.isL2_of_mulEquiv_sl2 hk hK (MulEquiv.refl _)⟩)

theorem nParam_eq_of_mulEquiv_sl3 {k n : ℕ} (hk : 2 ≤ k) (hK : Nat.card K = 2 ^ k)
    (hN : NParam L n) (e : Bar2 L ≃* Matrix.SpecialLinearGroup (Fin 3) K) : n = k :=
  nParam_eq_of_isSL3 hN (isSL3_of_isSLn_three
    ⟨K, inferInstance, inferInstance, hK,
      ⟨e.trans (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 3 K)⟩⟩ hk)

theorem not_nParam_of_mulEquiv_sl2_prod_statedOmegaMinus {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) {k n : ℕ} (hk : 2 ≤ k) (hK : Nat.card K = 2 ^ k)
    (e : Bar2 L ≃* Matrix.SpecialLinearGroup (Fin 2) K × ↥(StatedOmega (StatedQuadMinus 2 K b c))) :
    ¬ NParam L n :=
  not_nParam_of_mulEquiv_prod_isL2 e (KTabD.isL2_of_mulEquiv_sl2 hk hK (MulEquiv.refl _))
    (NatBorelIrr.isL2_statedOmega_quadMinus_two hirr (by omega) hK) (by omega)

