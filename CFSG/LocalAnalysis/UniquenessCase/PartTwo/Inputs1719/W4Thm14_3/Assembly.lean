theorem sSupIndep_insert_of_disjoint_of_irreducible {α : Type*} [CompleteLattice α]
    [IsModularLattice α]
    {s : Set α} {a : α} (hs : sSupIndep s) (ha : a ∉ s) (hd : Disjoint a (sSup s)) :
    sSupIndep (insert a s) := by
  intro b hb
  rcases hb with rfl | hb
  · rwa [Set.insert_sdiff_of_mem s (Set.mem_singleton b), Set.diff_singleton_eq_self ha]
  · have hba : a ∉ ({b} : Set α) := fun h => ha (Set.mem_singleton_iff.mp h ▸ hb)
    rw [Set.insert_sdiff_of_notMem s hba, sSup_insert]
    have h2 : Disjoint (b ⊔ sSup (s \ {b})) a :=
      (hd.mono_right (sup_le (le_sSup hb) (sSup_le_sSup Set.diff_subset))).symm
    have h := (hs hb).disjoint_sup_right_of_disjoint_sup_left h2
    rwa [sup_comm] at h

theorem exists_sSupIndep_spanning_of_family {W : Type} [CommGroup W] [Finite W]
    {L : Subgroup (MulAut W)} {S : Set (Subgroup W)} {I : Subgroup W}
    (hI : I ∈ S) (hSirr : ∀ K ∈ S, K ∈ irrSet L)
    (hSfix : ∀ K ∈ S, K ⊓ fixV L = ⊥) (hSspan : sSup S = ⊤) :
    ∃ s : Set (Subgroup W), I ∈ s ∧ s ⊆ S ∧ sSupIndep s ∧ sSup s = ⊤ := by
  classical
  haveI : Finite (Subgroup W) :=
    Finite.of_injective (fun K : Subgroup W => (K : Set W)) SetLike.coe_injective
  obtain ⟨s, hs⟩ := (Set.toFinite
    {s : Set (Subgroup W) | I ∈ s ∧ s ⊆ S ∧ sSupIndep s}).exists_maximal
    ⟨{I}, Set.mem_singleton I, Set.singleton_subset_iff.mpr hI, sSupIndep_singleton I⟩
  obtain ⟨hIs, hsS, hsind⟩ := hs.prop
  refine ⟨s, hIs, hsS, hsind, ?_⟩
  apply le_antisymm le_top
  rw [← hSspan]
  refine sSup_le fun K hK => ?_
  by_contra hKs
  have hstable : StableUnder L (sSup s) := by
    rw [sSup_eq_iSup]
    exact stableUnder_iSup fun K => stableUnder_iSup fun hK =>
      stableUnder_of_mem_irrSet (hSirr K (hsS hK))
  rcases (hSirr K hK).2.2.2.2 (K ⊓ sSup s)
      (stableUnder_inf (hSirr K hK).2.2.1 hstable) (by rw [hSfix K hK]; exact bot_le)
      inf_le_left with h | h
  · have hKnot : K ∉ s := fun hm => hKs (le_sSup hm)
    have hmem : insert K s ∈ {s : Set (Subgroup W) | I ∈ s ∧ s ⊆ S ∧ sSupIndep s} :=
      ⟨Set.mem_insert_of_mem K hIs, Set.insert_subset hK hsS,
        sSupIndep_insert_of_disjoint_of_irreducible hsind hKnot
          (disjoint_iff.mpr (h.trans (hSfix K hK)))⟩
    exact hKnot (hs.2 hmem (Set.subset_insert K s) (Set.mem_insert K s))
  · exact hKs (by rw [← h]; exact inf_le_right)

theorem exists_second_summand_of_rank_two {W : Type} [CommGroup W] [Finite W]
    (hW : ∀ w : W, w ^ 2 = 1) {L : Subgroup (MulAut W)} {S : Set (Subgroup W)}
    {I : Subgroup W} (hI : I ∈ S) (hSirr : ∀ K ∈ S, K ∈ irrSet L)
    (hSfix : ∀ K ∈ S, K ⊓ fixV L = ⊥) (hSspan : sSup S = ⊤)
    (hSrk : ∀ K ∈ S, rk ↥K = rk ↥I) (hr : 0 < rk ↥I)
    (hWrk : rk ↥(⊤ : Subgroup W) = 2 * rk ↥I) :
    ∃ J ∈ S, J ≠ I ∧ I ⊓ J = ⊥ ∧ I ⊔ J = ⊤ := by
  classical
  haveI : Finite (Subgroup W) :=
    Finite.of_injective (fun K : Subgroup W => (K : Set W)) SetLike.coe_injective
  obtain ⟨s, hs⟩ := (Set.toFinite
    {s : Set (Subgroup W) | I ∈ s ∧ s ⊆ S ∧ sSupIndep s}).exists_maximal
    ⟨{I}, Set.mem_singleton I, Set.singleton_subset_iff.mpr hI, sSupIndep_singleton I⟩
  obtain ⟨hIs, hsS, hsind⟩ := hs.prop
  have hsup : sSup s = ⊤ := by
    apply le_antisymm le_top
    rw [← hSspan]
    refine sSup_le fun K hK => ?_
    by_contra hKs
    have hstable : StableUnder L (sSup s) := by
      rw [sSup_eq_iSup]
      exact stableUnder_iSup fun K => stableUnder_iSup fun hK =>
        stableUnder_of_mem_irrSet (hSirr K (hsS hK))
    rcases (hSirr K hK).2.2.2.2 (K ⊓ sSup s)
        (stableUnder_inf (hSirr K hK).2.2.1 hstable) (by rw [hSfix K hK]; exact bot_le)
        inf_le_left with h | h
    · have hKnot : K ∉ s := fun hm => hKs (le_sSup hm)
      have hmem : insert K s ∈ {s : Set (Subgroup W) | I ∈ s ∧ s ⊆ S ∧ sSupIndep s} :=
        ⟨Set.mem_insert_of_mem K hIs, Set.insert_subset hK hsS,
          sSupIndep_insert_of_disjoint_of_irreducible hsind hKnot
            (disjoint_iff.mpr (h.trans (hSfix K hK)))⟩
      exact hKnot (hs.2 hmem (Set.subset_insert K s) (Set.mem_insert K s))
    · exact hKs (by rw [← h]; exact inf_le_right)
  have hcard : s.ncard = 2 := by
    have h := s15_Lin_rk_sSup_eq_finsum hsind
    rw [hsup] at h
    have hconst : ∑ᶠ U ∈ s, rk ↥U = s.ncard * rk ↥I :=
      s15_Two_finsum_mem_eq_ncard_mul s (fun U => rk ↥U) (rk ↥I) (Set.toFinite s)
        (fun U hU => hSrk U (hsS hU))
    rw [hconst, hWrk] at h
    have h2 : rk ↥I * s.ncard = rk ↥I * 2 := by
      rw [mul_comm (rk ↥I) s.ncard, mul_comm (rk ↥I) 2]
      exact h.symm
    exact Nat.eq_of_mul_eq_mul_left hr h2
  obtain ⟨J, hJ, hJI⟩ := Set.exists_ne_of_one_lt_ncard (by omega : 1 < s.ncard) I
  have hJS : J ∈ S := hsS hJ
  have hpair : sSupIndep ({I, J} : Set (Subgroup W)) :=
    hsind.mono (by
      intro K hK
      rcases hK with rfl | rfl
      · exact hIs
      · exact hJ)
  have hdisj : I ⊓ J = ⊥ := disjoint_iff.mp ((sSupIndep_pair hJI.symm).1 hpair)
  have hrkJ : rk ↥J = rk ↥I := hSrk J hJS
  have hsuprk : rk ↥(I ⊔ J) = 2 * rk ↥I := by
    have h := rk_sup_add_rk_inf I J
    rw [hdisj, rk_bot, add_zero, hrkJ] at h
    omega
  have hsupIJ : I ⊔ J = ⊤ := by
    refine eq_of_le_of_rk_le hW le_top ?_
    rw [hsuprk, hWrk]
  exact ⟨J, hJS, hJI, hdisj, hsupIJ⟩

theorem exists_spanning_family_rank_r
    {W : Type} [CommGroup W] [Finite W] (hW : ∀ w : W, w ^ 2 = 1)
    {Y L : Subgroup (MulAut W)}
    (hO : O2Trivial Y) (hB : IsBasicModule Y) (hLn : (L.subgroupOf Y).Normal)
    (hcomp : IsComponentOf L Y)
    (hfixLq : fixV (autQuot L (fixV L)) = ⊥)
    {I₀ : Subgroup W} (hI₀ : I₀ ∈ irrSet L)
    {Iq : Subgroup (W ⧸ fixV L)} (hIq : Iq = I₀.map (QuotientGroup.mk' (fixV L)))
    (hsumTop : (⨆ I ∈ irrSet L, I) = ⊤) :
    ∃ S : Set (Subgroup (W ⧸ fixV L)),
      Iq ∈ S ∧
      S = Set.range (fun I : irrSet L =>
        (I : Subgroup W).map (QuotientGroup.mk' (fixV L))) ∧
      (∀ K ∈ S, K ∈ irrSet (autQuot L (fixV L))) ∧
      (∀ K ∈ S, K ⊓ fixV (autQuot L (fixV L)) = ⊥) ∧
      sSup S = ⊤ := by
  classical
  let S : Set (Subgroup (W ⧸ (fixV L))) :=
    Set.range (fun I : irrSet L => (I : Subgroup W).map (QuotientGroup.mk' (fixV L)))
  have hIqS : Iq ∈ S := ⟨⟨I₀, hI₀⟩, hIq.symm⟩
  have hS_irr : ∀ K ∈ S, K ∈ irrSet (autQuot L (fixV L)) := by
    rintro K ⟨I, rfl⟩
    exact (FixVQuot.map_mem_irrSet_autQuot hW hO hB hcomp hLn I.2).1
  have hS_fix : ∀ K ∈ S, K ⊓ fixV (autQuot L (fixV L)) = ⊥ := by
    intro K _
    rw [hfixLq, inf_bot_eq]
  have hS_span : sSup S = ⊤ := by
    have hS' : S = Set.range (fun I : irrSet L =>
        (I : Subgroup W).map (QuotientGroup.mk' (fixV L))) := rfl
    have hmap : (⨆ I : irrSet L, (I : Subgroup W)).map (QuotientGroup.mk' (fixV L)) =
        ⨆ I : irrSet L, (I : Subgroup W).map (QuotientGroup.mk' (fixV L)) :=
      Subgroup.map_iSup _ _
    have htop : (⨆ I : irrSet L, (I : Subgroup W)) = ⊤ := by
      refine le_antisymm le_top ?_
      rw [← hsumTop]
      refine iSup_le fun I => iSup_le fun hI => ?_
      exact le_iSup (fun J : irrSet L => (J : Subgroup W)) ⟨I, hI⟩
    rw [hS', sSup_range, ← hmap, htop]
    exact Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)
  exact ⟨S, hIqS, rfl, hS_irr, hS_fix, hS_span⟩

theorem rank_eq_of_spanning_family
    {W : Type} [CommGroup W] [Finite W]
    {Y L : Subgroup (MulAut W)} (hCbot : fixV L = ⊥)
    {I₀ : Subgroup W} (hI₀ : I₀ ∈ irrSet L)
    {S : Set (Subgroup (W ⧸ fixV L))}
    (hS_range : S = Set.range (fun I : irrSet L =>
      (I : Subgroup W).map (QuotientGroup.mk' (fixV L))))
    (hIrrSpan : IrrSpanTrans Y L) :
    ∀ K ∈ S, rk ↥K = rk ↥I₀ := by
  intro K hK
  rw [hS_range] at hK
  obtain ⟨I, rfl⟩ := hK
  have hrankK : rk ↥(I : Subgroup W) = rk ↥I₀ := by
    obtain ⟨g, -, hsec⟩ := hIrrSpan.2 I₀ hI₀ (I : Subgroup W) I.2
    rw [hCbot, sup_bot_eq, sup_bot_eq] at hsec
    obtain ⟨-, -, -, -, -, -, β, hβ1, hβ2, hβ3, -⟩ := hsec
    have hcard : Nat.card ↥((I₀ : Subgroup W).map
        (g : MulAut W).toMonoidHom) = Nat.card ↥(I : Subgroup W) := by
      refine Nat.card_eq_of_bijective (fun a => ⟨β a, hβ1 a⟩)
        ⟨fun a b hab => ?_, fun b => ?_⟩
      · have h1 : β (a * b⁻¹) ∈ (⊥ : Subgroup W) := by
          rw [map_mul, map_inv, Subgroup.mem_bot, mul_inv_eq_one]
          exact congrArg Subtype.val hab
        have h2 := (hβ2 (a * b⁻¹)).mp h1
        rw [Subgroup.mem_bot] at h2
        exact mul_inv_eq_one.mp (Subtype.ext h2)
      · obtain ⟨a, ha⟩ := hβ3 b b.2
        rw [Subgroup.mem_bot, mul_inv_eq_one] at ha
        exact ⟨a, Subtype.ext ha⟩
    unfold rk
    rw [← hcard, Subgroup.card_map_of_injective g.injective]
  calc rk ↥((I : Subgroup W).map (QuotientGroup.mk' (fixV L))) =
      rk ↥(I : Subgroup W) := by
        rw [hCbot]
        exact Thm14_5.rk_map_mk_bot (I : Subgroup W)
    _ = rk ↥I₀ := hrankK

theorem Rr_eq_two_mul_r_of_spanning_family
    {W : Type} [CommGroup W] [Finite W]
    {L : Subgroup (MulAut W)}
    {Iq : Subgroup (W ⧸ fixV L)} {S : Set (Subgroup (W ⧸ fixV L))}
    (hIqS : Iq ∈ S)
    (hS_irr : ∀ K ∈ S, K ∈ irrSet (autQuot L (fixV L)))
    (hS_fix : ∀ K ∈ S, K ⊓ fixV (autQuot L (fixV L)) = ⊥)
    (hS_span : sSup S = ⊤)
    {r : ℕ} (hS_rk : ∀ K ∈ S, rk ↥K = r) (hrpos : 0 < r)
    {Rr : ℕ} (hRr_def : Rr = rk ↥(commV (autQuot L (fixV L))))
    (hcommLq : commV (autQuot L (fixV L)) = ⊤)
    (h2r : 2 * r ≤ Rr) (hlt3 : Rr < 3 * r) :
    Rr = 2 * r ∧ rk ↥(⊤ : Subgroup (W ⧸ fixV L)) = 2 * r := by
  have hRr_top : Rr = rk ↥(⊤ : Subgroup (W ⧸ (fixV L))) := by
    rw [hRr_def, hcommLq]
  obtain ⟨s, -, hsS, hsind, hsup⟩ :=
    exists_sSupIndep_spanning_of_family (L := (autQuot L (fixV L))) (S := S) (I := Iq)
      hIqS hS_irr hS_fix hS_span
  have hsumrk : rk ↥(⊤ : Subgroup (W ⧸ (fixV L))) = s.ncard * r := by
    have h := s15_Lin_rk_sSup_eq_finsum hsind
    rw [hsup] at h
    have hconst : ∑ᶠ U ∈ s, rk ↥U = s.ncard * r :=
      s15_Two_finsum_mem_eq_ncard_mul s (fun U => rk ↥U) r (Set.toFinite s)
        (fun U hU => hS_rk U (hsS hU))
    rwa [hconst] at h
  have hncard : s.ncard = 2 := by
    have h2 : 2 ≤ s.ncard := by
      refine Nat.le_of_mul_le_mul_right ?_ hrpos
      calc 2 * r ≤ Rr := h2r
        _ = rk ↥(⊤ : Subgroup (W ⧸ (fixV L))) := hRr_top
        _ = s.ncard * r := hsumrk
    have h3 : s.ncard < 3 := by
      have hlt : s.ncard * r < 3 * r := by
        calc s.ncard * r = rk ↥(⊤ : Subgroup (W ⧸ (fixV L))) := hsumrk.symm
          _ = Rr := hRr_top.symm
          _ < 3 * r := hlt3
      exact Nat.lt_of_mul_lt_mul_right hlt
    omega
  have hWrk : rk ↥(⊤ : Subgroup (W ⧸ (fixV L))) = 2 * r := by
    rw [hsumrk, hncard]
  exact ⟨by rw [hRr_top, hWrk], hWrk⟩

theorem exists_second_summand_of_rank_r
    {W : Type} [CommGroup W] [Finite W]
    {L : Subgroup (MulAut W)}
    (hWq : ∀ w : W ⧸ fixV L, w ^ 2 = 1)
    {Iq : Subgroup (W ⧸ fixV L)} {S : Set (Subgroup (W ⧸ fixV L))}
    (hIqS : Iq ∈ S)
    (hS_range : S = Set.range (fun I : irrSet L =>
      (I : Subgroup W).map (QuotientGroup.mk' (fixV L))))
    (hS_irr : ∀ K ∈ S, K ∈ irrSet (autQuot L (fixV L)))
    (hS_fix : ∀ K ∈ S, K ⊓ fixV (autQuot L (fixV L)) = ⊥)
    (hS_span : sSup S = ⊤)
    (hS_rk : ∀ K ∈ S, rk ↥K = rk ↥Iq) (hr : 0 < rk ↥Iq)
    (hWrk : rk ↥(⊤ : Subgroup (W ⧸ fixV L)) = 2 * rk ↥Iq) :
    ∃ (Jq : Subgroup (W ⧸ fixV L)) (J : Subgroup W),
      J ∈ irrSet L ∧ J.map (QuotientGroup.mk' (fixV L)) = Jq ∧
      Jq ∈ irrSet (autQuot L (fixV L)) ∧
      Jq ⊓ fixV (autQuot L (fixV L)) = ⊥ ∧
      Iq ⊓ Jq = ⊥ ∧ Iq ⊔ Jq = ⊤ := by
  classical
  obtain ⟨Jq, hJqS, hJq_ne, hIJq, hsupJq⟩ :=
    exists_second_summand_of_rank_two hWq hIqS hS_irr hS_fix hS_span hS_rk hr hWrk
  have hJqS' := hJqS
  rw [hS_range] at hJqS'
  obtain ⟨J, hJq_eq⟩ := hJqS'
  exact ⟨Jq, (J : Subgroup W), J.2, hJq_eq, hS_irr Jq hJqS, hS_fix Jq hJqS, hIJq, hsupJq⟩

theorem natOmegaMinus_of_second_summand
    {W : Type} [CommGroup W] [Finite W]
    {Y L : Subgroup (MulAut W)} (hCbot : fixV L = ⊥)
    {I₀ : Subgroup W} (hI₀ : I₀ ∈ irrSet L)
    {Iq : Subgroup (W ⧸ fixV L)} (hIq : Iq = I₀.map (QuotientGroup.mk' (fixV L)))
    (hIqmem : Iq ∈ irrSet (autQuot L (fixV L)))
    (hIqfix : Iq ⊓ fixV (autQuot L (fixV L)) = ⊥)
    (hLIq : autQuot L (fixV L) ≤ stabSub Iq)
    (hinj_of : ∀ (K : Subgroup (W ⧸ fixV L)),
      K ∈ irrSet (autQuot L (fixV L)) → K ⊓ fixV (autQuot L (fixV L)) = ⊥ →
      ∀ l ∈ autQuot L (fixV L), (∀ u ∈ K, l u = u) → l = 1)
    {J : Subgroup W} (hJ : J ∈ irrSet L)
    {Jq : Subgroup (W ⧸ fixV L)}
    (hJq_eq : J.map (QuotientGroup.mk' (fixV L)) = Jq)
    (hJq : Jq ∈ irrSet (autQuot L (fixV L)))
    (hJqfix : Jq ⊓ fixV (autQuot L (fixV L)) = ⊥)
    (hIrrSpan : IrrSpanTrans Y L)
    (hnormLq : autQuot Y (fixV L) ≤
      Subgroup.normalizer ((autQuot L (fixV L) : Subgroup (MulAut (W ⧸ fixV L))) :
        Set (MulAut (W ⧸ fixV L))))
    {k : ℕ}
    (hOmH : IsOmegaMinus ↥(autSub (autQuot L (fixV L)) Iq) 4 k)
    (hNatH : NatOmegaMinus (autSub (autQuot L (fixV L)) Iq) ⊤ ⊥ 4 k) :
    IsOmegaMinus ↥(autQuot L (fixV L)) 4 k ∧
      NatOmegaMinus (autQuot L (fixV L)) Iq ⊥ 4 k ∧
      NatOmegaMinus (autQuot L (fixV L)) Jq ⊥ 4 k := by
  classical
  obtain ⟨g, hgY, hsec⟩ := hIrrSpan.2 I₀ hI₀ J hJ
  rw [hCbot, sup_bot_eq, sup_bot_eq] at hsec
  let g₀ : stabSub (fixV L) :=
    ⟨g, by
      rw [hCbot]
      exact CFSG.Quasithin.B5.Ln.stabSub_bot_le ⊤ (Subgroup.mem_top g)⟩
  let gq : MulAut (W ⧸ (fixV L)) := quotHom (fixV L) g₀
  have hgqY : gq ∈ (autQuot Y (fixV L)) := mem_autQuot.mpr ⟨g₀, hgY, rfl⟩
  have hgq_conj : (autQuot L (fixV L)).map (MulAut.conj gq).toMonoidHom =
      (autQuot L (fixV L)) :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp (hnormLq hgqY)
  have hmap_eq : (I₀.map (g : MulAut W).toMonoidHom).map
      (QuotientGroup.mk' (fixV L)) = Iq.map gq := by
    rw [hIq, Subgroup.map_map, Subgroup.map_map]
    rfl
  have hsec' : SecIsoOn L ((I₀.map (g : MulAut W).toMonoidHom) ⊔ fixV L)
      (fixV L) (J ⊔ fixV L) (fixV L) := by
    simpa [hCbot] using hsec
  have hsecq : SecIsoOn (autQuot L (fixV L)) (Iq.map gq) ⊥ Jq ⊥ := by
    have h := FixVQuot.secIsoOn_autQuot hsec'
    rw [hmap_eq, hJq_eq] at h
    exact h
  have hLJq : (autQuot L (fixV L)) ≤ stabSub Jq := Thm14_5.le_stabSub_of_mem_irrSet hJq
  have hinjJq : ∀ l ∈ (autQuot L (fixV L)), (∀ u ∈ Jq, l u = u) → l = 1 :=
    hinj_of Jq hJq hJqfix
  obtain ⟨ψ, hψ⟩ :=
    Thm14_5.exists_mulEquiv_autSub_eq_map hgq_conj hLIq hLJq hsecq
  have hNatJq' : NatOmegaMinus (autSub (autQuot L (fixV L)) Jq) ⊤ ⊥ 4 k := by
    refine natOmegaMinus_of_map_congrHom ψ.symm ?_ hNatH
    rw [hψ, Subgroup.map_map, H.LU.congrHom_symm_comp, Subgroup.map_id]
  have hNatJq : NatOmegaMinus (autQuot L (fixV L)) Jq ⊥ 4 k :=
    Thm14_5.natOmegaMinus_of_autSub hLJq hinjJq hNatJq'
  have hinjIq : ∀ l ∈ (autQuot L (fixV L)), (∀ u ∈ Iq, l u = u) → l = 1 :=
    hinj_of Iq hIqmem hIqfix
  have hΩLq : IsOmegaMinus ↥(autQuot L (fixV L)) 4 k :=
    IsOmegaMinus.of_mulEquiv (FFC.resEquiv hLIq hinjIq).symm hOmH
  have hNatIq : NatOmegaMinus (autQuot L (fixV L)) Iq ⊥ 4 k :=
    Thm14_5.natOmegaMinus_of_autSub hLIq hinjIq hNatH
  exact ⟨hΩLq, hNatIq, hNatJq⟩

theorem false_of_aParam_le_of_two_natOmegaMinus_summands
    {W : Type} [CommGroup W] [Finite W]
    {Y L : Subgroup (MulAut W)} (hCbot : fixV L = ⊥)
    {Iq Jq : Subgroup (W ⧸ fixV L)} {k u : ℕ}
    (hΩ : IsOmegaMinus ↥(autQuot L (fixV L)) 4 k)
    (hNatI : NatOmegaMinus (autQuot L (fixV L)) Iq ⊥ 4 k)
    (hNatJ : NatOmegaMinus (autQuot L (fixV L)) Jq ⊥ 4 k)
    (hIJq : Iq ⊓ Jq = ⊥) (hsupJq : Iq ⊔ Jq = ⊤)
    (hnormLq : autQuot Y (fixV L) ≤
      Subgroup.normalizer ((autQuot L (fixV L) : Subgroup (MulAut (W ⧸ fixV L))) :
        Set (MulAut (W ⧸ fixV L))))
    (hb : bParam L Y + 2 ≥ E3.mParam Y)
    (h2u : 2 * u ≤ E3.mParam Y) (hku : k ≤ u) (hk3 : 3 ≤ k) :
    False := by
  classical
  have haYq : E3.aParam (autSub (autQuot Y (fixV L)) ⊤) ≤ k :=
    Thm14_5.aParam_autSub_le_of_natOmegaMinus_sum (W := W ⧸ (fixV L))
      (L := (autQuot L (fixV L))) (X := (autQuot Y (fixV L))) (I := Iq) (J := Jq) (M := ⊤)
      hΩ hNatI hNatJ hIJq (fun _ _ _ _ => Subgroup.mem_top _)
      (by rw [hsupJq]) (fun x hx => hnormLq hx.1)
  have haY : E3.aParam Y ≤ k := by
    rw [← FixVQuot.aParam_autSub_autQuot_bot_top Y]
    have h := haYq
    rw [hCbot] at h
    exact h
  have hb_le : bParam L Y ≤ k := bParam_le_aParam.trans haY
  have hm_le : E3.mParam Y ≤ k + 2 := by omega
  have hm_ge : 2 * k ≤ E3.mParam Y := by omega
  omega

theorem false_of_two_natOmegaMinus
    {W : Type} [CommGroup W] [Finite W] (hW : ∀ w : W, w ^ 2 = 1)
    {Y L : Subgroup (MulAut W)}
    (hO : O2Trivial Y) (hB : IsBasicModule Y) (hLn : (L.subgroupOf Y).Normal)
    (hcomp : IsComponentOf L Y) (hCbot : fixV L = ⊥)
    (hfixLq : fixV (autQuot L (fixV L)) = ⊥)
    (hnormLq : autQuot Y (fixV L) ≤
      Subgroup.normalizer ((autQuot L (fixV L) : Subgroup (MulAut (W ⧸ fixV L))) :
        Set (MulAut (W ⧸ fixV L))))
    {I₀ : Subgroup W} (hI₀ : I₀ ∈ irrSet L)
    {Iq : Subgroup (W ⧸ fixV L)} (hIq : Iq = I₀.map (QuotientGroup.mk' (fixV L)))
    (hIqmem : Iq ∈ irrSet (autQuot L (fixV L)))
    (hIqfix : Iq ⊓ fixV (autQuot L (fixV L)) = ⊥)
    (hLIq : autQuot L (fixV L) ≤ stabSub Iq)
    (hinj_of : ∀ (K : Subgroup (W ⧸ fixV L)),
      K ∈ irrSet (autQuot L (fixV L)) → K ⊓ fixV (autQuot L (fixV L)) = ⊥ →
      ∀ l ∈ autQuot L (fixV L), (∀ u ∈ K, l u = u) → l = 1)
    (hIrrSpan : IrrSpanTrans Y L) (hsumTop : (⨆ I ∈ irrSet L, I) = ⊤)
    (hcommLq : commV (autQuot L (fixV L)) = ⊤)
    {r Rr k u : ℕ} (hr_def : r = rk ↥Iq)
    (hRr_def : Rr = rk ↥(commV (autQuot L (fixV L))))
    (hrpos : 0 < r) (h2r : 2 * r ≤ Rr) (hlt3 : Rr < 3 * r)
    (hOmH : IsOmegaMinus ↥(autSub (autQuot L (fixV L)) Iq) 4 k)
    (hNatH : NatOmegaMinus (autSub (autQuot L (fixV L)) Iq) ⊤ ⊥ 4 k)
    (h2u : 2 * u ≤ E3.mParam Y) (hku : k ≤ u) (hk3 : 3 ≤ k)
    (hb : bParam L Y + 2 ≥ E3.mParam Y) :
    False := by
  classical
  obtain ⟨S, hIqS, hS_range, hS_irr, hS_fix, hS_span⟩ :=
    exists_spanning_family_rank_r hW hO hB hLn hcomp hfixLq hI₀ hIq hsumTop
  have hS_rk₀ := rank_eq_of_spanning_family hCbot hI₀ hS_range hIrrSpan
  have hrI₀ : r = rk ↥I₀ := by
    calc r = rk ↥Iq := hr_def
      _ = rk ↥(I₀.map (QuotientGroup.mk' (fixV L))) := by rw [hIq]
      _ = rk ↥I₀ := by
        rw [hCbot]
        exact Thm14_5.rk_map_mk_bot I₀
  have hS_rk : ∀ K ∈ S, rk ↥K = r :=
    fun K hK => (hS_rk₀ K hK).trans hrI₀.symm
  have hS_rkq : ∀ K ∈ S, rk ↥K = rk ↥Iq :=
    fun K hK => (hS_rk K hK).trans hr_def
  have hr : 0 < rk ↥Iq := by rw [← hr_def]; exact hrpos
  obtain ⟨-, hWrk⟩ :=
    Rr_eq_two_mul_r_of_spanning_family hIqS hS_irr hS_fix hS_span hS_rk hrpos
      hRr_def hcommLq h2r hlt3
  have hWrk' : rk ↥(⊤ : Subgroup (W ⧸ fixV L)) = 2 * rk ↥Iq := by
    rw [hWrk, hr_def]
  have hWq : ∀ w : W ⧸ fixV L, w ^ 2 = 1 := by
    intro w
    induction w using QuotientGroup.induction_on with
    | H w => rw [← QuotientGroup.mk_pow, hW w, QuotientGroup.mk_one]
  obtain ⟨Jq, J, hJ, hJq_eq, hJq, hJqfix, hIJq, hsupJq⟩ :=
    exists_second_summand_of_rank_r hWq hIqS hS_range hS_irr hS_fix hS_span hS_rkq hr hWrk'
  obtain ⟨hΩLq, hNatIq, hNatJq⟩ :=
    natOmegaMinus_of_second_summand hCbot hI₀ hIq hIqmem hIqfix hLIq hinj_of
      hJ hJq_eq hJq hJqfix hIrrSpan hnormLq hOmH hNatH
  exact false_of_aParam_le_of_two_natOmegaMinus_summands hCbot hΩLq hNatIq hNatJq
    hIJq hsupJq hnormLq hb h2u hku hk3


theorem w4Thm14_3_of_kFacts
    (h43c : W3Lem45_2Chief) (hSmall : Thm14_5.K14_5Small)
    (hFix : K14_3FixT) (hExt : K14_3Ext) (hExc : K14_3Exc) : W4Thm14_3 := by
  intro W _ _ hW Y L n hK hO hB hLY hLn hshape h3 hn4 hb
  classical
  haveI : Finite (MulAut W) :=
    Finite.of_injective (fun f : MulAut W => (f : W → W)) DFunLike.coe_injective
  have hcomp : IsComponentOf L Y :=
    ⟨hLY, CFSG.Open.IsSubnormal.step hLY hLn (CFSG.Open.IsSubnormal.refl Y),
      (by
        rcases hshape with h2 | hsz
        · exact CFSG.LocalAnalysis.UniquenessCase.UC22.NatParMax.isQuasisimple_of_isL2 h2
        · haveI := CFSG.LocalAnalysis.EvenBN.GMSK.isSimpleGroup_of_lieModel_twistedB2 hsz
          exact CFSG.Quasithin.A3.isQuasisimple_iff_open.mp
            (CFSG.LocalCores.isQuasisimple_of_isSimpleGroup
              (CFSG.LocalAnalysis.EvenBN.GMSK.exists_mul_ne_of_lieModel_twistedB2 hsz)).1)⟩
  have hqL : CFSG.Open.IsQuasisimple ↥L := hcomp.2.2
  have hLne : L ≠ ⊥ := B15P4.ne_bot_of_isComponentOf hcomp
