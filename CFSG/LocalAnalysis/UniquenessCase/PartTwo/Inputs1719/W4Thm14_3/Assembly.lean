theorem two_mul_le_dMinDeg_of_nParam_of
    (hSz : ∀ (X : Type) [Group X] (f : ℕ), IsSz X f → Nat.card X = CFSG.Open.ordSuzuki (2 ^ f))
    {G : Type} [Group G] [Finite G] {L P : Subgroup G} (hL : CFSG.Open.IsQuasisimple ↥L)
    (hPL : P ≤ L) {n : ℕ} (hN : NParam (Hinf P) n) (hn : 2 < n) :
    2 * n ≤ PartTwo.dMinDeg ↥L := by
  obtain ⟨T, _, _, hTL, hT⟩ :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.MinDegLow.exists_leviData_sec hSz hPL hN hn
  have := hT.simple
  have := CFSG.LocalAnalysis.UniquenessCase.UC22.MinDegLow.nontrivial_of_isQuasisimple hL
  apply CFSG.LocalAnalysis.UniquenessCase.UC22.MinDegLow.le_dMinDeg
  intro d f hf
  have hnot : ¬ IsSolvable T :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.MinDegLow.not_isSolvable_of_isSimpleGroup
      hT.nonab
  have hTL' : IsSec T ↥L :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.MinDegLow.isSec_trans hTL
      (isSec_of_surjective (QuotientGroup.mk' (CFSG.pCore 2 ↥L))
        (QuotientGroup.mk'_surjective (CFSG.pCore 2 ↥L)))
  have hTS : IsSec T (↥L ⧸ Subgroup.center ↥L) :=
    hTL'.quotient_of_isSolvable hnot
      (Group.isSolvable_of_comm fun a b => Subtype.ext (Subgroup.mem_center_iff.mp b.2 a))
  obtain ⟨m, hm2, -, ⟨t, ht⟩, -⟩ := hT.bound
  obtain ⟨s, hs⟩ :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.MinDegLow.exists_orderOf_eq_of_isSec hTS t
  obtain ⟨g, hg⟩ :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.MinDegLow.exists_orderOf_eq_of_quotient hL
      (QuotientGroup.mk' (Subgroup.center ↥L)) (QuotientGroup.mk'_surjective _)
      (CFSG.LocalAnalysis.UniquenessCase.UC22.MinDegLow.center_quotient_center_eq_bot hL)
      f hf s
  have hd := ht d g (hg.trans hs)
  have h2 := Nat.mul_le_mul_right n hm2
  omega

theorem nParam_self_of_isL2_or_isSz {G : Type} [Group G] [Finite G] {L : Subgroup G} {n : ℕ}
    (hs : IsSimpleGroup ↥L) (h : IsL2 ↥L n ∨ IsSz ↥L n) : NParam L n := by
  have hnt : ∃ a b : ↥L, a * b ≠ b * a := by
    rcases h with h2 | hsz
    · exact CFSG.Quasithin.G11.G117.exists_mul_ne_of_isQuasisimple
        (CFSG.LocalAnalysis.UniquenessCase.UC22.NatParMax.isQuasisimple_of_isL2 h2)
    · exact CFSG.LocalAnalysis.EvenBN.GMSK.exists_mul_ne_of_lieModel_twistedB2 hsz
  obtain ⟨a, b, hab⟩ := hnt
  have hO : CFSG.pCore 2 ↥L = ⊥ :=
    CFSG.Quasithin.H13.KG12614.pCore_eq_bot_of_simple hs hab
  let e : Bar2 L ≃* ↥L :=
    (QuotientGroup.quotientMulEquivOfEq hO).trans QuotientGroup.quotientBot
  refine Or.inl (uc22ine229_nParamSingle_of_prod ?_)
  rcases h with h2 | hsz
  · exact Or.inr (Or.inl (LieModel.of_mulEquiv e.symm h2))
  · exact Or.inl (LieModel.of_mulEquiv e.symm hsz)

