    have himg : Multiplicative.ofAdd (v ((z : K) * 1)) = Multiplicative.ofAdd (v 1) := by
      rw [← hc1]
      have heq : (⟨(D z : MulAut W) (y 1 : W), hDmem⟩ : ↥J) = y 1 := by
