variable {K : Type} [Field K] [CharP K 2]

private theorem coe_statedSLEquivSL_symm (x : SL(2, K)) :
    (((H13.A5.statedSLEquivSL 2 K).symm x : ↥(StatedSL 2 K)) : GL (Fin 2) K) =
      (x : GL (Fin 2) K) := rfl

private theorem mulVec_uElt (s l : K) :
    ((uElt s : SL(2, K)) : Matrix (Fin 2) (Fin 2) K).mulVec
        (![l, 0] : Fin 2 → K) = ![l, 0] := by
  rw [uElt_mulVec]
  simp

private theorem mulVec_dElt (z : Kˣ) (l : K) :
    ((dElt z : SL(2, K)) : Matrix (Fin 2) (Fin 2) K).mulVec
        (![l, 0] : Fin 2 → K) = ![((z : K) * l), 0] := by
  ext i
  fin_cases i <;> simp [dElt, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

private theorem natAct_uElt_one (s l : K) :
    natAct (StatedSL 2 K) ((H13.A5.statedSLEquivSL 2 K).symm (uElt s))
        (Multiplicative.ofAdd (![l, 0] : Fin 2 → K)) = Multiplicative.ofAdd ![l, 0] := by
  apply congrArg Multiplicative.ofAdd
  rw [coe_statedSLEquivSL_symm, Matrix.SpecialLinearGroup.coe_GL_coe_matrix]
  exact mulVec_uElt s l

private theorem natAct_dElt_one (z : Kˣ) (l : K) :
    natAct (StatedSL 2 K) ((H13.A5.statedSLEquivSL 2 K).symm (dElt z))
        (Multiplicative.ofAdd (![l, 0] : Fin 2 → K)) =
      Multiplicative.ofAdd (![((z : K) * l), 0] : Fin 2 → K) := by
  apply congrArg Multiplicative.ofAdd
  rw [coe_statedSLEquivSL_symm, Matrix.SpecialLinearGroup.coe_GL_coe_matrix]
  exact mulVec_dElt z l

end Delta

theorem exists_fixed_uElt_of_realizesVia {W : Type} [CommGroup W] [Finite W]
    (hW : ∀ w : W, w ^ 2 = 1) {L : Subgroup (MulAut W)} {J J₀ : Subgroup W} {K : Type}
    [Field K] [Finite K] [CharP K 2] (h8 : 8 ≤ Nat.card K) (π : ↥(StatedSL 2 K) →* ↥L)
    (hπ : (FFModel.nat (StatedSL 2 K)).RealizesVia L J J₀ π) (hJ₀ : J₀ ≤ fixV L) :
    ∃ x ∈ J,
      (∀ s : K, ((π ((H13.A5.statedSLEquivSL 2 K).symm (uElt s)) : ↥L) : MulAut W) x = x) ∧
      ∀ z : Kˣ, z ≠ 1 →
        ((π ((H13.A5.statedSLEquivSL 2 K).symm (dElt z)) : ↥L) : MulAut W) x ≠ x := by
  classical
  have hJinv : ∀ h : ↥L, ∀ u ∈ J, (h : MulAut W) u ∈ J := hπ.2.2.2.1
  let M := FFModel.nat (StatedSL 2 K)
  obtain ⟨c, hc, hcact⟩ := CFSG.Quasithin.C124.YL.coord_of_realizes
    (D := M) (fun m => Subgroup.mem_top m) (fun m hm => Subgroup.mem_bot.mp hm) hπ
  let c' : ↥J →* Multiplicative (Fin 2 → K) := c
  have hc' : CFSG.Quasithin.C124.YL.IsCoord J J₀ c' := hc
  have hcact' : ∀ (γ : ↥(StatedSL 2 K)) (u : ↥J)
      (hu : ((π γ : ↥L) : MulAut W) (u : W) ∈ J),
      c' ⟨((π γ : ↥L) : MulAut W) (u : W), hu⟩ = natAct (StatedSL 2 K) γ (c' u) := hcact
  let e := H13.A5.statedSLEquivSL 2 K
  let v : K → Fin 2 → K := fun l => ![l, 0]
  let y : K → ↥J := fun l => Classical.choose (hc'.surj (Multiplicative.ofAdd (v l)))
  have hy : ∀ l : K, c' (y l) = Multiplicative.ofAdd (v l) := fun l =>
    Classical.choose_spec (hc'.surj (Multiplicative.ofAdd (v l)))
  have hv_add : ∀ a b : K, v (a + b) = v a + v b := by
    intro a b
    ext i
    fin_cases i <;> simp [v]
  have hv_inj : Function.Injective v := by
    intro a b h
    have := congrFun h 0
    simpa [v] using this
  let U : K → ↥L := fun t => π (e.symm (uElt t))
  let D : Kˣ → ↥L := fun z => π (e.symm (dElt z))
  have hU_add : ∀ s t : K, U (s + t) = U s * U t := by
    intro s t
    simp only [U, uElt_add, map_mul]
  have hconj : ∀ (z : Kˣ) (t : K),
      e.symm (dElt z) * e.symm (uElt t) * (e.symm (dElt z))⁻¹ =
        e.symm (uElt ((z : K) ^ 2 * t)) := by
    intro z t
    calc e.symm (dElt z) * e.symm (uElt t) * (e.symm (dElt z))⁻¹
        = e.symm (dElt z * uElt t) * e.symm ((dElt z)⁻¹) := by
            rw [map_mul, map_inv]
      _ = e.symm (dElt z * uElt t * (dElt z)⁻¹) := by rw [← map_mul]
      _ = e.symm (uElt ((z : K) ^ 2 * t)) := by
            rw [CFSG.RankThree.GF2n.Stroth80.Sp6NoEmb.dElt_conj_uElt]
  have hD_conj : ∀ (z : Kˣ) (t : K), D z * U t * (D z)⁻¹ = U ((z : K) ^ 2 * t) := by
    intro z t
    have h := congrArg (fun x : ↥(StatedSL 2 K) => π x) (hconj z t)
    simpa only [D, U, map_mul, map_inv] using h
  have hcactU : ∀ (t l : K),
      c' ⟨(U t : MulAut W) (y l : W), hJinv (U t) (y l) (y l).2⟩ =
        natAct (StatedSL 2 K) (e.symm (uElt t)) (c' (y l)) := by
    intro t l
    simpa only [U] using hcact' (e.symm (uElt t)) (y l) (hJinv (U t) (y l) (y l).2)
  have hcactD : ∀ (z : Kˣ) (l : K),
      c' ⟨(D z : MulAut W) (y l : W), hJinv (D z) (y l) (y l).2⟩ =
        natAct (StatedSL 2 K) (e.symm (dElt z)) (c' (y l)) := by
    intro z l
    simpa only [D] using hcact' (e.symm (dElt z)) (y l) (hJinv (D z) (y l) (y l).2)
  have hmem : ∀ (l t : K), (U t : MulAut W) (y l : W) * (y l : W)⁻¹ ∈ J := fun l t =>
    J.mul_mem (hJinv (U t) (y l) (y l).2) (J.inv_mem (y l).2)
  let ψ : K → K → ↥J₀ := fun l t =>
    ⟨(U t : MulAut W) (y l : W) * (y l : W)⁻¹, by
      refine (hc'.ker ⟨_, hmem l t⟩).mp ?_
      have hsplit : (⟨(U t : MulAut W) (y l : W) * (y l : W)⁻¹, hmem l t⟩ : ↥J) =
          ⟨(U t : MulAut W) (y l : W), hJinv (U t) (y l) (y l).2⟩ * (y l)⁻¹ := rfl
      rw [hsplit, map_mul, map_inv, hcactU t l, hy l, natAct_uElt_one]
      rw [show v l = ![l, 0] from rfl, mul_inv_cancel]⟩
  have hkey : ∀ (l t : K) (a : ↥J), c' a = Multiplicative.ofAdd (v l) →
      (U t : MulAut W) (a : W) * (a : W)⁻¹ = ((ψ l t : ↥J₀) : W) := by
    intro l t a ha
    set d : ↥J := a * (y l)⁻¹ with hddef
    have hd : (d : W) ∈ J₀ := by
      refine (hc'.ker d).mp ?_
      rw [hddef, map_mul, map_inv, ha, hy l, mul_inv_cancel]
    have hdfix : (U t : MulAut W) (d : W) = (d : W) :=
      (mem_fixV.mp (hJ₀ hd)) (U t) (U t).2
    have hda : (a : W) = (d : W) * (y l : W) := by
      rw [hddef, Subgroup.coe_mul, Subgroup.coe_inv]
      group
    show (U t : MulAut W) (a : W) * (a : W)⁻¹ = ((ψ l t : ↥J₀) : W)
    rw [hda, map_mul, mul_inv_rev, hdfix]
    simp only [ψ]
    calc (d : W) * ((U t : MulAut W) (y l : W)) * ((y l : W)⁻¹ * (d : W)⁻¹)
        = ((d : W) * (d : W)⁻¹) * ((U t : MulAut W) (y l : W) * (y l : W)⁻¹) := by
          ac_rfl
      _ = (U t : MulAut W) (y l : W) * (y l : W)⁻¹ := by rw [mul_inv_cancel, one_mul]
  have hψ_add_left : ∀ l m t : K, ψ (l + m) t = ψ l t * ψ m t := by
    intro l m t
    apply Subtype.ext
    have hb : c' (y l * y m) = Multiplicative.ofAdd (v (l + m)) := by
      rw [map_mul, hy l, hy m]
      exact (congrArg Multiplicative.ofAdd (hv_add l m)).symm
    calc ((ψ (l + m) t : ↥J₀) : W)
        = (U t : MulAut W) (y (l + m) : W) * (y (l + m) : W)⁻¹ :=
            (hkey (l + m) t (y (l + m)) (hy (l + m))).symm
      _ = (U t : MulAut W) ((y l * y m : ↥J) : W) * ((y l * y m : ↥J) : W)⁻¹ := by
            rw [hkey (l + m) t (y (l + m)) (hy (l + m)),
              hkey (l + m) t (y l * y m) hb]
      _ = ((ψ l t * ψ m t : ↥J₀) : W) := by
            simp only [Subgroup.coe_mul, map_mul, mul_inv_rev, ψ]
            ac_rfl
  have hψ_add_right : ∀ l t s : K, ψ l (t + s) = ψ l t * ψ l s := by
    intro l t s
    apply Subtype.ext
    have hU : (U (t + s) : MulAut W) = (U t : MulAut W) * (U s : MulAut W) := by
      rw [hU_add]
      rfl
    have hfix : (U t : MulAut W) ((ψ l s : ↥J₀) : W) = ((ψ l s : ↥J₀) : W) :=
      (mem_fixV.mp (hJ₀ (ψ l s).2)) (U t) (U t).2
    have hUs : (U s : MulAut W) (y l : W) * (y l : W)⁻¹ = ((ψ l s : ↥J₀) : W) := rfl
    have hUt : (U t : MulAut W) (y l : W) * (y l : W)⁻¹ = ((ψ l t : ↥J₀) : W) := rfl
    calc ((ψ l (t + s) : ↥J₀) : W)
        = (U (t + s) : MulAut W) (y l : W) * (y l : W)⁻¹ := rfl
      _ = (U t : MulAut W) ((U s : MulAut W) (y l : W)) * (y l : W)⁻¹ := by rw [hU]; rfl
      _ = ((U t : MulAut W) (((U s : MulAut W) (y l : W)) * (y l : W)⁻¹)) *
            ((U t : MulAut W) (y l : W) * (y l : W)⁻¹) := by
            rw [map_mul, map_inv]
            group
      _ = ((ψ l s : ↥J₀) : W) * ((ψ l t : ↥J₀) : W) := by
            rw [hUs, hfix, hUt]
      _ = ((ψ l t * ψ l s : ↥J₀) : W) := by
            simp only [Subgroup.coe_mul]
            ac_rfl
  have hψ_inv : ∀ (c₀ : K) (l t : K), c₀ ≠ 0 → ψ (c₀ * l) (c₀ ^ 2 * t) = ψ l t := by
    intro c₀ l t hc0
    apply Subtype.ext
    let z : Kˣ := Units.mk0 c₀ hc0
    have hzc : (z : K) = c₀ := rfl
    let a : ↥J := ⟨(D z : MulAut W) (y l : W), hJinv (D z) (y l) (y l).2⟩
    have haval : (a : W) = (D z : MulAut W) (y l : W) := rfl
    have hca : c' a = Multiplicative.ofAdd (v (c₀ * l)) := by
      have h := hcactD z l
      rw [show c' a = natAct (StatedSL 2 K) (e.symm (dElt z)) (c' (y l)) from h, hy l,
        natAct_dElt_one]
      rfl
    have hU_eq : (U (c₀ ^ 2 * t) : MulAut W) =
        (D z : MulAut W) * (U t : MulAut W) * (D z : MulAut W)⁻¹ := by
      have h := congrArg (fun x : ↥L => (x : MulAut W)) (hD_conj z t)
      simpa [hzc] using h.symm
    have hinv : (D z : MulAut W)⁻¹ (a : W) = (y l : W) := by
      rw [haval]
      exact MulEquiv.symm_apply_apply (D z : MulAut W) (y l : W)
    calc ((ψ (c₀ * l) (c₀ ^ 2 * t) : ↥J₀) : W)
        = (U (c₀ ^ 2 * t) : MulAut W) (a : W) * (a : W)⁻¹ :=
            (hkey (c₀ * l) (c₀ ^ 2 * t) a hca).symm
      _ = ((D z : MulAut W) * (U t : MulAut W) * (D z : MulAut W)⁻¹) (a : W) *
            (a : W)⁻¹ := by rw [hU_eq]
      _ = (D z : MulAut W) ((U t : MulAut W) ((D z : MulAut W)⁻¹ (a : W))) *
            (a : W)⁻¹ := rfl
      _ = (D z : MulAut W) ((U t : MulAut W) (y l : W)) *
            ((D z : MulAut W) (y l : W))⁻¹ := by rw [hinv, haval]
      _ = (D z : MulAut W) (((U t : MulAut W) (y l : W)) * (y l : W)⁻¹) := by
            rw [map_mul, map_inv]
      _ = (D z : MulAut W) ((ψ l t : ↥J₀) : W) := rfl
      _ = ((ψ l t : ↥J₀) : W) :=
            (mem_fixV.mp (hJ₀ (ψ l t).2)) (D z) (D z).2
  have hψ_sq : ∀ a b : K, ψ a b ^ 2 = 1 := by
    intro a b
    apply Subtype.ext
    simp only [Subgroup.coe_pow, Subgroup.coe_one]
    rw [show ((ψ a b : ↥J₀) : W) = (U b : MulAut W) (y a : W) * (y a : W)⁻¹ from rfl]
    exact hW _
  have hsquare : Function.Surjective (fun t : K => t ^ 2) :=
    Finite.surjective_of_injective CharTwo.sq_injective
  have hphi : ∀ a b : K, ψ a (b ^ 2) = 1 := by
    intro a b
    refine CFSG.Quasithin.Vol2.Ch11.SecH.eq_one_of_invariant_biadditive h8
      (fun x y => ψ x (y ^ 2)) (fun x x' y => hψ_add_left x x' (y ^ 2)) ?_
      (fun x y => hψ_sq x (y ^ 2)) ?_ a b
    · intro x u w
      have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
      rw [show (u + w) ^ 2 = u ^ 2 + w ^ 2 by
        calc (u + w) ^ 2 = u ^ 2 + 2 * u * w + w ^ 2 := add_sq u w
          _ = u ^ 2 + w ^ 2 := by rw [h2]; ring]
      exact hψ_add_right x (u ^ 2) (w ^ 2)
    · intro c₀ x u hc0
      rw [show (c₀ * u) ^ 2 = c₀ ^ 2 * u ^ 2 by ring]
      exact hψ_inv c₀ x (u ^ 2) hc0
