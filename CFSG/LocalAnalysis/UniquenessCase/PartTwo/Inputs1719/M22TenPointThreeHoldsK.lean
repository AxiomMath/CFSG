@[expose] noncomputable def walkI (f : ℕ → ℕ → Bool) (L : List ℕ) : ℕ → Bool :=
  List.rec (motive := fun _ => ℕ → Bool) (fun _ => true) (fun a _ r m => f m a && r (Nat.succ m)) L

theorem walkI_spec {f : ℕ → ℕ → Bool} : ∀ {L : List ℕ} {m : ℕ}, walkI f L m = true →
    ∀ k < L.length, f (m + k) (L.getD k 0) = true
  | [], _, _, k, hk => absurd hk (Nat.not_lt_zero k)
  | a :: L, m, h, k, hk => by
    change (f m a && walkI f L (Nat.succ m)) = true at h
    rw [Bool.and_eq_true] at h
    cases k with
    | zero => simpa using h.1
    | succ k =>
      have h2 := walkI_spec h.2 k (by simpa using hk)
      have e : Nat.succ m + k = m + (k + 1) := by omega
      rw [e] at h2
      rwa [List.getD_cons_succ]

@[expose] noncomputable def fixF (cols lift : List ℕ) (m i : ℕ) : Bool :=
  Nat.beq m 0 || (Nat.blt i 216 && Nat.beq (actM cols (actM (PCL.getD i []) (actM lift m))) m)

theorem code_check : walkI (fixF κC22Cols lift22Cols) IdxL 0 = true := by decide +kernel

theorem cocode_check : walkI (fixF cc10Cols lift10Cols) CIdxL 0 = true := by decide +kernel

theorem fix_of {A : Array (Array ℕ)} {I : Array ℕ} {L cols lift : List ℕ} (hI : I = L.toArray)
    (hlen : L.length = 1024) (hpc : ∀ i < 216, permCols A[i]! = PCL.getD i [])
    (hw : walkI (fixF cols lift) L 0 = true) :
    ∀ m < 2 ^ 10, m ≠ 0 → I[m]! < 216 ∧ actM cols (permM A[I[m]!]! (actM lift m)) = m := by
  intro m hm hm0
  have hmL : m < L.length := by
    rw [hlen]
    simpa using hm
  have h := walkI_spec hw m hmL
  rw [zero_add, fixF] at h
  simp only [Bool.or_eq_true, Bool.and_eq_true, Nat.beq_eq, Nat.blt_eq] at h
  rcases h with h | ⟨h1, h2⟩
  · exact absurd h hm0
  have hI' : I[m]! = L.getD m 0 := by
    rw [hI, List.getElem!_toArray, List.getElem!_eq_getElem?_getD,
      List.getD_eq_getElem?_getD] <;> rfl
  refine ⟨by rw [hI']; exact h1, ?_⟩
  rw [hI', permM, hpc _ h1]
  exact h2

