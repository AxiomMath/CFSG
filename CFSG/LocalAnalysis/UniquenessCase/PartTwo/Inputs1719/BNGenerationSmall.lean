theorem k_19_21_opp_of_trioShape {S : Type} [Group S] [Finite S] (hout : IsPGroup 2 (Outer S))
    (htrio : ∀ U : Subgroup S, CFSG.QuasithinUnique.IsSylowTwoOf U ⊤ →
      CFSG.Quasithin.SBd8.TrioShape S U) : K_19_21_opp S := by
  intro U _hU r hr hr2 Eh hEh hEhU
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hsyl : CFSG.QuasithinUnique.IsSylowTwoOf (U : Subgroup S) ⊤ :=
    CFSG.QuasithinUnique.isSylowTwoOf_top_of_sylow U
  obtain ⟨hN, P₀, P₁, -, hP₀t, hP₁t, hUP₀, -, -, -, hlat⟩ := htrio _ hsyl
  have hEh1 : ∀ α ∈ Eh, α = 1 := fun α hα => by
    obtain ⟨k, hk⟩ := hEh ⟨α, hα⟩
    have hαk : α ^ (r ^ k) = 1 := by simpa using congrArg Subtype.val hk
    exact CFSG.LieType.SteinbergBR.OddSylow.eq_one_of_odd U hN hout α
      ((hr.odd_of_ne_two hr2).pow.of_dvd_nat (orderOf_dvd_of_pow_eq_one hαk)) (hEhU α hα)
  have hcov : ¬ ((⊤ : Subgroup S) : Set S) ⊆ (P₀ : Set S) ∪ P₁ := fun h =>
    (SubgroupClass.subset_union.1 h).elim (fun h => hP₀t (eq_top_iff.2 h))
      (fun h => hP₁t (eq_top_iff.2 h))
  obtain ⟨n, -, hn⟩ := Set.not_subset.1 hcov
  rw [Set.mem_union, not_or] at hn
  obtain ⟨hn₀, hn₁⟩ := hn
  refine ⟨⊥, n, bot_le, ?_, fun α _ => Subgroup.map_bot _, fun α hα => ?_, fun h hh => ?_⟩
  · rw [Subgroup.normalizer_eq_top_iff.2 inferInstance]
    exact Subgroup.mem_top n
  · rw [hEh1 α hα]
    simp
  · rw [Subgroup.mem_bot] at hh
    subst hh
    rw [one_mul]
    have hnY : n ∈ (U : Subgroup S) ⊔ zpowers n := Subgroup.mem_sup_right (Subgroup.mem_zpowers n)
    rcases hlat ((U : Subgroup S) ⊔ zpowers n) le_sup_left with h | h | h | h
    · rw [h] at hnY
      exact absurd (hUP₀.le hnY) hn₀
    · rw [h] at hnY
      exact absurd hnY hn₀
    · rw [h] at hnY
      exact absurd hnY hn₁
    · exact h

