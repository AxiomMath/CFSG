theorem k_19_21_opp_of_u33
    {S : Type} [Group S] [Finite S]
    (h : CFSG.Blueprint.LieModel S .PSU 3 3 1) : K_19_21_opp S := by
  let e : S ≃* CFSG.Quasithin.U33G :=
    (CFSG.Timmesfeld.nonempty_mulEquiv_PSU3_of_lieModel h).some.trans
      CFSG.Quasithin.u33Pres_mulEquiv_PSU3.some.symm
  have : Finite CFSG.Quasithin.U33G := Finite.of_equiv S e.toEquiv
  exact k_19_21_opp_of_trioShape
    (CFSG.Quasithin.SzN22.isPGroup_outer_of_equiv e CFSG.Quasithin.SzN22.isPGroup_outer_u33G)
    fun _ hU => CFSG.Quasithin.SBd8.TrioShape.of_equiv_sylow e.symm
      CFSG.Quasithin.GoldS146R.isSylowTwoOf_u33_T CFSG.Quasithin.SBd8.trioShape_u33G hU

