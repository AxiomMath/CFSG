    (h : CFSG.LocalAnalysis.UniquenessCase.UC22.IsAlt S 6) : K_19_21_opp S :=
  k_19_21_opp_of_trioShape (CFSG.Quasithin.SzN22.isPGroup_outer_of_alt6 h)
