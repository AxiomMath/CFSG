private def sl2U (F : Type) [Field F] : Matrix.SpecialLinearGroup (Fin 2) F :=
  Matrix.SpecialLinearGroup.transvection (i := (0 : Fin 2)) (j := (1 : Fin 2))
    (by decide) (1 : F)

private def sl2L (F : Type) [Field F] : Matrix.SpecialLinearGroup (Fin 2) F :=
  Matrix.SpecialLinearGroup.transvection (i := (1 : Fin 2)) (j := (0 : Fin 2))
    (by decide) (1 : F)

private theorem sl2U_pow {F : Type} [Field F] {p : ℕ} [CharP F p] : sl2U F ^ p = 1 := by
  change Matrix.SpecialLinearGroup.transvection (i := (0 : Fin 2)) (j := (1 : Fin 2))
    (by decide) (1 : F) ^ p = 1
  rw [← ringChar.eq (R := F) p]
  exact CFSG.ClassicalInvolution.ModelFacts.LinearAut.transvection_pow_ringChar
    (i := (0 : Fin 2)) (j := (1 : Fin 2)) (by decide) (1 : F)

private theorem sl2_comm_apply_one {F : Type} [Field F] :
    (((⁅sl2U F, sl2L F⁆ : Matrix.SpecialLinearGroup (Fin 2) F)) :
      Matrix (Fin 2) (Fin 2) F) 0 1 = -1 := by
  rw [commutatorElement_def]
  simp [sl2U, sl2L, Matrix.SpecialLinearGroup.transvection_inv,
    Matrix.SpecialLinearGroup.transvection_coe]

private theorem sl2_comm_not_mem_center {F : Type} [Field F] :
    ⁅sl2U F, sl2L F⁆ ∉ Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) F) := by
  intro h
  have h' := (CFSG.ABGLocalTools.sl2_mem_center_iff (F := F)
    (A := ⁅sl2U F, sl2L F⁆)).mp h
  rcases h' with h1 | h1
  · have h01 := congrArg (fun g : Matrix.SpecialLinearGroup (Fin 2) F =>
      ((g : Matrix (Fin 2) (Fin 2) F) 0 1)) h1
    rw [sl2_comm_apply_one] at h01
    simp at h01
  · have h01 := congrArg (fun g : Matrix.SpecialLinearGroup (Fin 2) F =>
      ((g : Matrix (Fin 2) (Fin 2) F) 0 1)) h1
    rw [sl2_comm_apply_one] at h01
    simp [Matrix.SpecialLinearGroup.coe_neg] at h01


theorem aSet_eq_empty_of_not_l2_not_ree {W : Type} [CommGroup W] [Finite W]
    (hW : ∀ w : W, w ^ 2 = 1) {Y L : Subgroup (MulAut W)} {t : StatedLieTag} {n p e : ℕ}
    (hLY : L ≤ Y) (hLn : (L.subgroupOf Y).Normal) (hF : Fstar Y = L) (hLq : IsQuasisimple ↥L)
    (hO2 : O2Trivial L) (hp : p.Prime) (hp2 : p ≠ 2)
    (hm : LieModel (↥L ⧸ Subgroup.center ↥L) t n p e)
    (hL2 : ¬ IsL2Over17 (↥L ⧸ Subgroup.center ↥L) (p ^ e)) (hRee : ¬ IsReeOver17 ↥L (p ^ e))
    (hq3 : 3 < p ^ e) {k : ℕ} (hk : 3 ≤ k ∨ (2 ≤ k ∧ 9 < p ^ e)) : E3.aSet k Y = ∅ := by
  classical
  rw [Set.eq_empty_iff_forall_notMem]
  intro A hA
  have hAp : IsPGroup 2 A := E3.isPGroup_of_isElemAbelian2 hA.2.2.1
  obtain ⟨P₀, hP₀⟩ := (hAp.comap_subtype (K := Y)).exists_le_sylow
  let T : Subgroup (MulAut W) := (P₀ : Subgroup ↥Y).map Y.subtype
  have hTle : T ≤ Y := Subgroup.map_subtype_le _
  have hAT : A ≤ T := by
    intro a ha
    exact Subgroup.mem_map.mpr ⟨⟨a, hA.1 ha⟩, hP₀ (Subgroup.mem_subgroupOf.mpr ha), rfl⟩
  have hYnorm : Y ≤ Subgroup.normalizer (L : Set (MulAut W)) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hLY).mp hLn
  have hTsyl : CFSG.ABGLocalTools.IsSylowOf 2 T Y := ⟨P₀, rfl⟩
  obtain ⟨P, hP⟩ := (hTsyl.inf_of_le_normalizer hLY hYnorm).exists_sylow_eq_subgroupOf
  have hPcoe : (P : Subgroup ↥L) = T.subgroupOf L := by
    rw [hP, Subgroup.inf_subgroupOf_right]
  obtain ⟨K, hK⟩ := funSet_nonempty_of_lieModel (X := ↥L) (r := p) (q := p ^ e) hp hp2
    ⟨t, n, e, hm.admissible, rfl, hm⟩ hLq hL2 hRee hq3 P
  have hKfund : IsFundamentalOver (p ^ e) K := hK.1
  obtain ⟨F, hFld, hFfin, r, hr, hchar, hrdvd, h2F, hqF, φ, hφrange, hφker⟩ :=
    exists_sl2_cover_of_isFundamentalOver hKfund
  let : Field F := hFld
  let : Finite F := hFfin
  have hrp : r = p := Nat.prime_eq_prime_of_dvd_pow hr hp hrdvd
  have hF4 : 4 ≤ Nat.card F := by
    have := lt_of_lt_of_le hq3 hqF
    omega
  have hF3 : 3 < Nat.card F := lt_of_lt_of_le hq3 hqF
  have hSL2q : CFSG.IsQuasisimple (Matrix.SpecialLinearGroup (Fin 2) F) := by
    have h : CFSG.Open.IsQuasisimple (Matrix.SpecialLinearGroup (Fin 2) F) :=
      CFSG.ClassicalInvolution.isQuasisimple_specialLinearGroup_two hF4
    exact (CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_native _).mp
      ((CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_open _).mpr h)
  let φK : Matrix.SpecialLinearGroup (Fin 2) F →* ↥K :=
    φ.codRestrict K (fun x => hφrange ▸ MonoidHom.mem_range.mpr ⟨x, rfl⟩)
  have hφKsurj : Function.Surjective φK := by
    intro y
    have hy : (y : ↥L) ∈ φ.range := hφrange.symm ▸ y.2
    obtain ⟨x, hx⟩ := MonoidHom.mem_range.mp hy
    exact ⟨x, Subtype.ext hx⟩
  have hφKker : φK.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) F) := by
    intro x hx
    apply hφker
    have hx1 : ((φK x : ↥K) : ↥L) = 1 := by
      rw [MonoidHom.mem_ker.mp hx]
      rfl
    exact hx1
  have hKq : IsQuasisimple ↥K :=
    CFSG.LocalCores.isQuasisimple_of_surjective hSL2q φK hφKsurj hφKker
  let K' : Subgroup (MulAut W) := K.map L.subtype
  let incl : ↥K →* ↥K' :=
    { toFun := fun k => ⟨((k : ↥L) : MulAut W), Subgroup.mem_map.mpr ⟨k, k.2, rfl⟩⟩
      map_one' := by ext; rfl
      map_mul' := fun a b => by ext; rfl }
  let φ' : Matrix.SpecialLinearGroup (Fin 2) F →* ↥K' := incl.comp φK
  have hφ'surj : Function.Surjective φ' := by
    intro y
    obtain ⟨a, ha, hay⟩ := Subgroup.mem_map.mp y.2
    obtain ⟨x, hx⟩ := hφKsurj ⟨a, ha⟩
    refine ⟨x, Subtype.ext ?_⟩
    change ((incl (φK x) : ↥K') : MulAut W) = (y : MulAut W)
    rw [hx]
    exact hay
  have hφ'ker : φ'.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) F) := by
    intro x hx
    apply hφKker
    have hincl : incl (φK x) = 1 := hx
    have hval : ((incl (φK x) : ↥K') : MulAut W) = 1 := by rw [hincl]; rfl
    have hval' : L.subtype ((φK x : ↥K) : ↥L) = 1 := by simpa [incl] using hval
    exact Subtype.ext (L.subtype_injective (by simpa using hval'))
  have hlt : ∀ m, Nonempty (ACandidate ↥K' m) → m < k := by
    intro m hmc
    obtain ⟨c⟩ := hmc
    have hle := aCandidate_le_of_sl2 h2F hF3 φ' hφ'surj hφ'ker c
    rcases hk with hk3 | ⟨hk2, hk9⟩
    · have h2m : m ≤ 2 := hle.2
      omega
    · have h9F : 9 < Nat.card F := lt_of_lt_of_le hk9 hqF
      have h1m : m ≤ 1 := hle.1 h9F
      omega
  have hcomm : ∀ K₁ ∈ FunSet (fundPred (p ^ e)) ↥L (P : Subgroup ↥L),
      ∀ K₂ ∈ FunSet (fundPred (p ^ e)) ↥L (P : Subgroup ↥L),
      K₁ ≠ K₂ → ⁅K₁, K₂⁆ = ⊥ := by
    intro K₁ h₁ K₂ h₂ hne
    exact funSet_commute_of_lieModel hp hp2
      ⟨t, n, e, hm.admissible, rfl, hm⟩ hL2 P h₁ h₂ hne
  obtain ⟨H, hTH, hKH⟩ :=
    exists_isComponentOf_of_mem_funSet (hTle.trans hYnorm) P hPcoe hcomm hK hKq
  have hAH : A ∈ E3.aSet k H := ⟨hAT.trans hTH, hA.2⟩
  have hAK' : ⁅A, K'⁆ = ⊥ :=
    w4Lem7_7_holds (W := W) hW H K' A k hKH hAH hlt
  have : CharP F p := hrp ▸ hchar
  have hu_pow : sl2U F ^ p = 1 := sl2U_pow (F := F) (p := p)
  let x : MulAut W := (φ (sl2U F) : MulAut W)
  let X : Subgroup (MulAut W) := Subgroup.zpowers x
  have hxpow : x ^ p = 1 := by
    have h1 : ((φ (sl2U F)) ^ p : ↥L) = 1 := by
      rw [← map_pow, hu_pow, map_one]
    show ((φ (sl2U F) : ↥L) : MulAut W) ^ p = 1
    rw [← Subgroup.coe_pow, h1, Subgroup.coe_one]
  have hXp : IsPGroup p ↥X := by
    show IsPGroup p ↥(Subgroup.zpowers x)
    have hdvd : orderOf x ∣ p := orderOf_dvd_of_pow_eq_one hxpow
    rcases (Nat.dvd_prime hp).mp hdvd with h1 | hp'
    · exact IsPGroup.of_card (n := 0) (by rw [Nat.card_zpowers, h1, pow_zero])
    · exact IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hp', pow_one])
  have hXL : X ≤ L :=
    Subgroup.zpowers_le.mpr (φ (sl2U F)).2
  have hXZ : ¬ X ≤ (Subgroup.center ↥L).map L.subtype := by
    intro hXle
    have hxmem : ((φ (sl2U F) : ↥L) : MulAut W) ∈
        (Subgroup.center ↥L).map L.subtype :=
      hXle (Subgroup.mem_zpowers ((φ (sl2U F) : ↥L) : MulAut W))
    obtain ⟨c, hc, hceq⟩ := Subgroup.mem_map.mp hxmem
    have hc' : c = φ (sl2U F) := L.subtype_injective hceq
    have hxcent : φ (sl2U F) ∈ Subgroup.center ↥L := hc' ▸ hc
    have hker : ⁅sl2U F, sl2L F⁆ ∈ φ.ker := by
      rw [MonoidHom.mem_ker, map_commutatorElement]
      exact commutatorElement_eq_one_iff_mul_comm.mpr
        (Subgroup.mem_center_iff.mp hxcent (φ (sl2L F))).symm
