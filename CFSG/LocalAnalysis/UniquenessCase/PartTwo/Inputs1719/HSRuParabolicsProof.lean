      N1 = ((hsCtx.Y 1).map e'.symm.toMonoidHom).map K.subtype := ⟨_, rfl⟩
  set N3 : Subgroup Y := ((hsCtx.Y 3).map e'.symm.toMonoidHom).map K.subtype with hN3
  set N4 : Subgroup Y := ((hsCtx.Y 4).map e'.symm.toMonoidHom).map K.subtype with hN4
