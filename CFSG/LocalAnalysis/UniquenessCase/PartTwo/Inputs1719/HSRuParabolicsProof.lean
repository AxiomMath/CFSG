    (ruCtx.Y 4).map (α : ↥(J ruData) →* ↥(J ruData)) = ruCtx.Y 4 := by
  have hY1 := ru_Y1_invariant hα
  refine ru_Y4_unique ?_ (Subgroup.card_map_of_injective α.injective) ?_
  · rw [← hα]
    exact Subgroup.map_mono (ruCtx.S_le_Y 4)
  · intro hle
    have hY1symm : (ruCtx.Y 1).map (α.symm : ↥(J ruData) →* ↥(J ruData)) = ruCtx.Y 1 := by
      have h := congrArg (fun Z => Z.map (α.symm : ↥(J ruData) →* ↥(J ruData))) hY1
      simpa [Subgroup.map_map] using h.symm
    have h4le : ruCtx.Y 4 ≤ ruCtx.Y 1 := by
      have h := Subgroup.map_mono (f := (α.symm : ↥(J ruData) →* ↥(J ruData))) hle
      rw [hY1symm] at h
      simpa [Subgroup.map_map] using h
    exact absurd h4le
