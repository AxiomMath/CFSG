  by_cases hj5 : j < 5
  · simp only [memberOrTop, if_pos hj5] at hZ ⊢
    interval_cases j
    · rw [ru_member_card 0 (by norm_num)] at hZ
      norm_num at hZ
    · rfl
    · rw [ru_member_card 2 (by norm_num)] at hZ
      norm_num at hZ
    · rw [ru_member_card 3 (by norm_num)] at hZ
      norm_num at hZ
    · rw [ru_member_card 4 (by norm_num)] at hZ
      norm_num at hZ
  · exfalso
