theorem hs_Y1_unique
    {Z : Subgroup (J hsData)} (hUZ : hsCtx.S ≤ Z)
    (hZ : Nat.card Z = Nat.card (hsCtx.Y 1)) : Z = hsCtx.Y 1 := by
  obtain ⟨j, hj, rfl⟩ := hs_complete Z hUZ
  have hY1card : Nat.card (hsCtx.Y 1) = 7680 := by
    rw [hs_member_card 1 (by norm_num)]
    rfl
  rw [hY1card] at hZ
  by_cases hj5 : j < 5
  · simp only [memberOrTop, if_pos hj5] at hZ ⊢
    interval_cases j
    · rw [hs_member_card 0 (by norm_num)] at hZ
      norm_num at hZ
    · rfl
    · rw [hs_member_card 2 (by norm_num)] at hZ
      norm_num at hZ
    · rw [hs_member_card 3 (by norm_num)] at hZ
      norm_num at hZ
    · rw [hs_member_card 4 (by norm_num)] at hZ
      norm_num at hZ
  · exfalso
    have hj5' : j = 5 := by omega
    subst hj5'
    simp only [memberOrTop, if_neg (by omega)] at hZ
    rw [Subgroup.card_top, hs_card] at hZ
    norm_num at hZ

theorem hs_Y3_unique
    {Z : Subgroup (J hsData)} (hUZ : hsCtx.S ≤ Z)
    (hZ : Nat.card Z = Nat.card (hsCtx.Y 3)) (hZnot : ¬ Z ≤ hsCtx.Y 1) :
    Z = hsCtx.Y 3 := by
  obtain ⟨j, hj, rfl⟩ := hs_complete Z hUZ
  have hY3card : Nat.card (hsCtx.Y 3) = 1536 := by
    rw [hs_member_card 3 (by norm_num)]
    rfl
  rw [hY3card] at hZ
  by_cases hj5 : j < 5
  · simp only [memberOrTop, if_pos hj5] at hZ hZnot ⊢
    interval_cases j
    · rw [hs_member_card 0 (by norm_num)] at hZ
      norm_num at hZ
    · rw [hs_member_card 1 (by norm_num)] at hZ
      norm_num at hZ
    · rw [hs_member_card 2 (by norm_num)] at hZ
      norm_num at hZ
    · rfl
    · exact absurd ((hs_Y_le_iff (by norm_num) (by norm_num)).mpr (by decide)) hZnot
  · exfalso
    have hj5' : j = 5 := by omega
    subst hj5'
    simp only [memberOrTop, if_neg (by omega)] at hZ
    rw [Subgroup.card_top, hs_card] at hZ
    norm_num at hZ

theorem hs_Y1_invariant
    {α : MulAut ↥(J hsData)}
    (hα : hsCtx.S.map (α : ↥(J hsData) →* ↥(J hsData)) = hsCtx.S) :
    (hsCtx.Y 1).map (α : ↥(J hsData) →* ↥(J hsData)) = hsCtx.Y 1 :=
  map_eq_of_unique_card (hsCtx.S_le_Y 1) (fun Z hZ hc => hs_Y1_unique hZ hc) α hα

theorem hs_Y3_invariant
    {α : MulAut ↥(J hsData)}
    (hα : hsCtx.S.map (α : ↥(J hsData) →* ↥(J hsData)) = hsCtx.S) :
    (hsCtx.Y 3).map (α : ↥(J hsData) →* ↥(J hsData)) = hsCtx.Y 3 := by
  have hY1 := hs_Y1_invariant hα
  refine hs_Y3_unique ?_ (Subgroup.card_map_of_injective α.injective) ?_
  · rw [← hα]
    exact Subgroup.map_mono (hsCtx.S_le_Y 3)
  · intro hle
    have hY1symm : (hsCtx.Y 1).map (α.symm : ↥(J hsData) →* ↥(J hsData)) = hsCtx.Y 1 := by
      have h := congrArg (fun Z => Z.map (α.symm : ↥(J hsData) →* ↥(J hsData))) hY1
      simpa [Subgroup.map_map] using h.symm
    have h3le : hsCtx.Y 3 ≤ hsCtx.Y 1 := by
      have h := Subgroup.map_mono (f := (α.symm : ↥(J hsData) →* ↥(J hsData))) hle
      rw [hY1symm] at h
      simpa [Subgroup.map_map] using h
    exact absurd h3le
      (by rw [hs_Y_le_iff (by norm_num) (by norm_num)]; decide)

theorem hs_Y4_unique
    {Z : Subgroup (J hsData)} (hUZ : hsCtx.S ≤ Z)
    (hZ : Nat.card Z = Nat.card (hsCtx.Y 4)) (hZle : Z ≤ hsCtx.Y 1) :
    Z = hsCtx.Y 4 := by
  obtain ⟨j, hj, rfl⟩ := hs_complete Z hUZ
  have hY4card : Nat.card (hsCtx.Y 4) = 1536 := by
    rw [hs_member_card 4 (by norm_num)]
    rfl
  rw [hY4card] at hZ
  by_cases hj5 : j < 5
  · simp only [memberOrTop, if_pos hj5] at hZ hZle ⊢
    interval_cases j
    · rw [hs_member_card 0 (by norm_num)] at hZ
      norm_num at hZ
    · rw [hs_member_card 1 (by norm_num)] at hZ
      norm_num at hZ
    · rw [hs_member_card 2 (by norm_num)] at hZ
      norm_num at hZ
    · exact absurd hZle (by rw [hs_Y_le_iff (by norm_num) (by norm_num)]; decide)
    · rfl
  · exfalso
    have hj5' : j = 5 := by omega
    subst hj5'
    simp only [memberOrTop, if_neg (by omega)] at hZ
    rw [Subgroup.card_top, hs_card] at hZ
    norm_num at hZ

theorem hs_Y4_invariant
    {α : MulAut ↥(J hsData)}
    (hα : hsCtx.S.map (α : ↥(J hsData) →* ↥(J hsData)) = hsCtx.S) :
    (hsCtx.Y 4).map (α : ↥(J hsData) →* ↥(J hsData)) = hsCtx.Y 4 := by
  have hY1 := hs_Y1_invariant hα
  refine hs_Y4_unique ?_ (Subgroup.card_map_of_injective α.injective) ?_
  · rw [← hα]
    exact Subgroup.map_mono (hsCtx.S_le_Y 4)
  · calc (hsCtx.Y 4).map (α : ↥(J hsData) →* ↥(J hsData))
        ≤ (hsCtx.Y 1).map (α : ↥(J hsData) →* ↥(J hsData)) :=
          Subgroup.map_mono ((hs_Y_le_iff (by norm_num) (by norm_num)).mpr (by decide))
      _ = hsCtx.Y 1 := hY1

theorem hs_Y1_not_solvable :
    ¬ Group.IsSolvable ↥(hsCtx.Y 1) := by
  intro hsol
  have hUcard : Nat.card (hsCtx.S) = 512 := hs_card_S
  have hY1card : Nat.card (hsCtx.Y 1) = 7680 := by
    rw [hs_member_card 1 (by norm_num)]
    rfl
  obtain ⟨H, hUH, hHY1, k, hcard, hk2, hk5, hprime⟩ :=
    CFSG.Quasithin.ModH.M23Excl.exists_hall_overgroup (S := hsCtx.S) (Z := hsCtx.Y 1)
      hsCtx.S_isPGroup (hsCtx.S_le_Y 1) hsol 5 (by norm_num)
  have hdvd : 512 ∣ Nat.card H := by
    have h := Subgroup.card_dvd_of_le hUH
    rwa [hUcard] at h
  obtain ⟨m, hm⟩ := hdvd
  have hmk : m * k = 15 := by
    have h1 : Nat.card H * k = 7680 := by rw [hcard, hY1card]
    rw [hm] at h1
    have h2 : 512 * (m * k) = 512 * 15 := by
      rw [← mul_assoc, h1]

    exact Nat.eq_of_mul_eq_mul_left (by norm_num) h2
  have h15 : m ∣ 15 := ⟨k, hmk.symm⟩
  have h5m : 5 ∣ m := by
    have h5 : 5 ∣ m * k := by rw [hmk]; norm_num
    rcases Nat.prime_five.dvd_mul.mp h5 with h | h
    · exact h
    · exact absurd h hk5
  have hm5 : m = 5 := by
    have hmle : m ≤ 15 := Nat.le_of_dvd (by norm_num) h15
    interval_cases m
    · omega
    · norm_num at h5m
    · omega
    · norm_num at h5m
    · norm_num at h5m
    · rfl
    · norm_num at h5m
    · omega
    · norm_num at h5m
    · norm_num at h5m
    · omega
    · omega
    · norm_num at h5m
    · norm_num at h5m
    · norm_num at h5m
    · exfalso
      have h3 : 3 ∣ Nat.card H := by rw [hm]; norm_num
      rcases hprime 3 Nat.prime_three h3 with h | h <;> omega
  have hHcard : Nat.card H = 2560 := by
    rw [hm, hm5]

  obtain ⟨j, hj, hHj⟩ := hs_complete H hUH
  by_cases hj5 : j < 5
  · simp only [memberOrTop, if_pos hj5] at hHj
    rw [hHj] at hHcard
    interval_cases j
    · rw [hs_member_card 0 (by norm_num)] at hHcard
      norm_num at hHcard
    · rw [hs_member_card 1 (by norm_num)] at hHcard
      norm_num at hHcard
    · rw [hs_member_card 2 (by norm_num)] at hHcard
      norm_num at hHcard
    · rw [hs_member_card 3 (by norm_num)] at hHcard
      norm_num at hHcard
    · rw [hs_member_card 4 (by norm_num)] at hHcard
      norm_num at hHcard
  · exfalso
    have hj5' : j = 5 := by omega
    subst hj5'
    simp only [memberOrTop, if_neg (by omega)] at hHj
    rw [hHj, Subgroup.card_top, hs_card] at hHcard
    norm_num at hHcard

theorem hs_bar2_inFSq_two
    (A : Type) [Group A] [Finite A]
    {Y : Type} [Group Y] [Finite Y] {S N1 H1 H2in : Subgroup Y}
    (hS : CFSG.Quasithin.IsSylowIn 2 S ⊤)
    (hN1leH1 : N1 ≤ H1) (hH2inleH1 : H2in ≤ H1)
    (hH1card : Nat.card ↥H1 = 15 * Nat.card ↥S)
    (hH2incard : Nat.card ↥H2in = 3 * Nat.card ↥S)
    (eA : A ≃* ↥N1)
    (hN1quot : Nat.card ↥N1 = 120 * Nat.card (CFSG.pCore 2 A))
    (hN1core : CFSG.Open.pCoreOf 2 N1 = N1 ⊓ CFSG.Open.pCoreOf 2 H1)
    (hH1ns : ¬ Group.IsSolvable ↥H1) :
    CFSG.LocalAnalysis.WeakClosure81.InFSq 2 H1 := by
