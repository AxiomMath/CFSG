        ≤ (ruCtx.Y 1).map (α : ↥(J ruData) →* ↥(J ruData)) :=
          Subgroup.map_mono ((ru_Y_le_iff (by norm_num) (by norm_num)).mpr (by decide))
      _ = ruCtx.Y 1 := hY1

theorem ru_Y1_not_solvable :
    ¬ Group.IsSolvable ↥(ruCtx.Y 1) := by
  intro hsol
  have hUcard : Nat.card (ruCtx.S) = 16384 := ru_card_S
  have hY1card : Nat.card (ruCtx.Y 1) = 245760 := by
    rw [ru_member_card 1 (by norm_num)]
    rfl
  obtain ⟨H, hUH, hHY1, k, hcard, hk2, hk5, hprime⟩ :=
    CFSG.Quasithin.ModH.M23Excl.exists_hall_overgroup (S := ruCtx.S) (Z := ruCtx.Y 1)
      ruCtx.S_isPGroup (ruCtx.S_le_Y 1) hsol 5 (by norm_num)
  have hdvd : 16384 ∣ Nat.card H := by
    have h := Subgroup.card_dvd_of_le hUH
    rwa [hUcard] at h
  obtain ⟨m, hm⟩ := hdvd
  have hmk : m * k = 15 := by
    have h1 : Nat.card H * k = 245760 := by rw [hcard, hY1card]
    rw [hm] at h1
    have h2 : 16384 * (m * k) = 16384 * 15 := by
      rw [← mul_assoc, h1]
    exact Nat.eq_of_mul_eq_mul_left (by norm_num) h2
  have h15 : m ∣ 15 := ⟨k, hmk.symm⟩
  have h5m : 5 ∣ m := by
    have h5 : 5 ∣ m * k := by rw [hmk]; norm_num
    rcases Nat.prime_five.dvd_mul.mp h5 with h | h
    · exact h
    · exact absurd h hk5
  have hm5 : m = 5 := by
    have hmle : m ≤ 15 := Nat.le_of_dvd (by norm_num) h15
    interval_cases m
    · omega
    · norm_num at h5m
    · omega
    · norm_num at h5m
    · norm_num at h5m
    · rfl
    · norm_num at h5m
    · omega
    · norm_num at h5m
    · norm_num at h5m
    · omega
    · omega
    · norm_num at h5m
    · norm_num at h5m
    · norm_num at h5m
    · exfalso
      have h3 : 3 ∣ Nat.card H := by rw [hm]; norm_num
      rcases hprime 3 Nat.prime_three h3 with h | h <;> omega
  have hHcard : Nat.card H = 81920 := by
    rw [hm, hm5]
  obtain ⟨j, hj, hHj⟩ := ru_complete H hUH
  by_cases hj5 : j < 5
  · simp only [memberOrTop, if_pos hj5] at hHj
    rw [hHj] at hHcard
    interval_cases j
    · rw [ru_member_card 0 (by norm_num)] at hHcard
      norm_num at hHcard
    · rw [ru_member_card 1 (by norm_num)] at hHcard
      norm_num at hHcard
    · rw [ru_member_card 2 (by norm_num)] at hHcard
      norm_num at hHcard
    · rw [ru_member_card 3 (by norm_num)] at hHcard
      norm_num at hHcard
    · rw [ru_member_card 4 (by norm_num)] at hHcard
      norm_num at hHcard
  · exfalso
    have hj5' : j = 5 := by omega
    subst hj5'
    simp only [memberOrTop, if_neg (by omega)] at hHj
    rw [hHj, Subgroup.card_top, ru_card] at hHcard
    norm_num at hHcard

theorem k_HSRuParabolics_Ru
    {Y : Type} [Group Y] [Finite Y] {K S : Subgroup Y}
    (hKN : K.Normal) (hq : CFSG.Open.IsQuasisimple ↥K)
    (hodd : Odd (Nat.card (Subgroup.center ↥K)))
    (hcent : Subgroup.centralizer (K : Set Y) = (Subgroup.center ↥K).map K.subtype)
    (hidx : ∃ n : ℕ, K.index = 2 ^ n)
    (hspor : IsSpor (↥K ⧸ Subgroup.center ↥K) .Ru)
    (hS : CFSG.Quasithin.IsSylowIn 2 S ⊤) :
    ∃ H₁ H₂ : Subgroup Y, S ≤ H₁ ∧ S ≤ H₂ ∧ H₁ ⊔ H₂ = ⊤ ∧
      CFSG.LocalAnalysis.WeakClosure81.InFSq 2 H₁ ∧
        CFSG.LocalAnalysis.WeakClosure81.InFSq 2 H₂ ∧
          3 ∣ Nat.card ↥H₁ ∧ 3 ∣ Nat.card ↥H₂ := by
  have hperf : Group.IsPerfect ↥K := Group.isPerfect_def.mpr hq.1
  obtain ⟨eK⟩ := hspor
  have hZ : Subgroup.center ↥K = ⊥ :=
    center_eq_bot_of_perfect_odd_cover eK hodd
      CFSG.SectionRank.Ru_perfect_odd_cover_trivial
  obtain ⟨e0⟩ : Nonempty (↥K ≃* CFSG.Blueprint.NativeSporadic.Ru) :=
    ⟨((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm.trans eK⟩
  let e := e0.trans CFSG.Sporadic.Bridge.Ru.nativeEquiv
  have hSyl : CFSG.QuasithinUnique.IsSylowTwoOf S ⊤ := hS
  have hSK : CFSG.QuasithinUnique.IsSylowTwoOf (S ⊓ K) K :=
    CFSG.Quasithin.B6.isSylowTwoOf_inf_normal hSyl le_top fun x _ => by
      rw [Subgroup.normalizer_eq_top_iff.mpr hKN]
      trivial
  have hSKt : CFSG.QuasithinUnique.IsSylowTwoOf ((S ⊓ K).subgroupOf K) ⊤ :=
    CFSG.GroupTheory.PermSylowTwo.isSylowTwoOf_subgroupOf_top hSK
  obtain ⟨e', he'⟩ := CFSG.Quasithin.Stellmacher.L3YC.Row18.exists_equiv_sylow
    ru_S_sylow e hSKt
  have hUcard : Nat.card ↥ruCtx.S = 16384 := ru_card_S
  have hSKcard : Nat.card ↥(S ⊓ K) = 16384 := by
    have h1 : Nat.card ↥((S ⊓ K).subgroupOf K) = Nat.card ↥ruCtx.S := by
      rw [← he', Subgroup.card_map_of_injective e'.injective]
    have h2 : Nat.card ↥((S ⊓ K).subgroupOf K) = Nat.card ↥(S ⊓ K) :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe inf_le_right).toEquiv
    rw [h2, hUcard] at h1
    exact h1
  obtain ⟨N1, hN1⟩ : ∃ N1 : Subgroup Y,
      N1 = ((ruCtx.Y 1).map e'.symm.toMonoidHom).map K.subtype := ⟨_, rfl⟩
  obtain ⟨N3, hN3⟩ : ∃ N3 : Subgroup Y,
      N3 = ((ruCtx.Y 3).map e'.symm.toMonoidHom).map K.subtype := ⟨_, rfl⟩
  obtain ⟨N4, hN4⟩ : ∃ N4 : Subgroup Y,
      N4 = ((ruCtx.Y 4).map e'.symm.toMonoidHom).map K.subtype := ⟨_, rfl⟩
  obtain ⟨eY1⟩ : Nonempty (↥(ruCtx.Y 1) ≃* ↥N1) := by
    refine ⟨? _⟩
    rw [hN1]
    exact ((ruCtx.Y 1).equivMapOfInjective e'.symm.toMonoidHom e'.symm.injective).trans
      (((ruCtx.Y 1).map e'.symm.toMonoidHom).equivMapOfInjective K.subtype
        K.subtype_injective)
  set H1 : Subgroup Y := S ⊔ N1 with hH1
  set H2in : Subgroup Y := S ⊔ N3 with hH2in
  set H2 : Subgroup Y := S ⊔ N4 with hH2
  have hN1leK : N1 ≤ K := by rw [hN1]; exact pull_le e' _
  have hN3leK : N3 ≤ K := by rw [hN3]; exact pull_le e' _
  have hN4leK : N4 ≤ K := by rw [hN4]; exact pull_le e' _
  have hN1leH1 : N1 ≤ H1 := le_sup_right
  have hN3leH2in : N3 ≤ H2in := le_sup_right
  have hSleH1 : S ≤ H1 := le_sup_left
  have hSleH2in : S ≤ H2in := le_sup_left
  have hα1 : ∀ t ∈ S,
      ruCtx.S.map (autK e' t : ↥(J ruData) →* ↥(J ruData)) = ruCtx.S := by
    intro t ht
    have h := map_autK_of_mem_normalizer' (e := e') (t := t) inf_le_right
      (SporB.le_normalizer_inf hKN ht)
    rw [he'] at h
    exact h
  have hα3 : ∀ t ∈ S,
      ruCtx.S.map (autK e' t : ↥(J ruData) →* ↥(J ruData)) = ruCtx.S := hα1
  have hS_N1norm : S ≤ Subgroup.normalizer (N1 : Set Y) := by
    rw [hN1]
    intro t ht
    exact mem_normalizer_pull e' (ru_Y1_invariant (hα1 t ht))
  have hS_N3norm : S ≤ Subgroup.normalizer (N3 : Set Y) := by
    rw [hN3]
    intro t ht
    exact mem_normalizer_pull e' (ru_Y3_invariant (hα3 t ht))
  have hS_N4norm : S ≤ Subgroup.normalizer (N4 : Set Y) := by
    rw [hN4]
    intro t ht
    exact mem_normalizer_pull e' (ru_Y4_invariant (hα1 t ht))
  have hH1norm : H1 ≤ Subgroup.normalizer (N1 : Set Y) :=
    sup_le hS_N1norm Subgroup.le_normalizer
  have hN1card : Nat.card N1 = 245760 := by
    rw [hN1, Subgroup.card_map_of_injective K.subtype_injective,
      Subgroup.card_map_of_injective e'.symm.injective, ru_member_card 1 (by norm_num)]
    rfl
  have hN3card : Nat.card N3 = 49152 := by
    rw [hN3, Subgroup.card_map_of_injective K.subtype_injective,
      Subgroup.card_map_of_injective e'.symm.injective, ru_member_card 3 (by norm_num)]
    rfl
  have hN4card : Nat.card N4 = 49152 := by
    rw [hN4, Subgroup.card_map_of_injective K.subtype_injective,
      Subgroup.card_map_of_injective e'.symm.injective, ru_member_card 4 (by norm_num)]
    rfl
  have hSKleN1 : S ⊓ K ≤ N1 := by
    rw [hN1]
    exact (le_pull_iff e' inf_le_right).mpr (he' ▸ ruCtx.S_le_Y 1)
  have hSKleN3 : S ⊓ K ≤ N3 := by
    rw [hN3]
    exact (le_pull_iff e' inf_le_right).mpr (he' ▸ ruCtx.S_le_Y 3)
  have hSKleN4 : S ⊓ K ≤ N4 := by
    rw [hN4]
    exact (le_pull_iff e' inf_le_right).mpr (he' ▸ ruCtx.S_le_Y 4)
  have hSinfN1 : S ⊓ N1 = S ⊓ K :=
    le_antisymm (inf_le_inf_left _ hN1leK) (le_inf inf_le_left hSKleN1)
  have hSinfN3 : S ⊓ N3 = S ⊓ K :=
    le_antisymm (inf_le_inf_left _ hN3leK) (le_inf inf_le_left hSKleN3)
  have hSinfN4 : S ⊓ N4 = S ⊓ K :=
    le_antisymm (inf_le_inf_left _ hN4leK) (le_inf inf_le_left hSKleN4)
  have hH1card : Nat.card H1 = 15 * Nat.card S := by
    have h := CFSG.GroupTheory.CoprimeActionSupport.NormalSubgroupSylowJoin.card_sup_mul_card_inf
      (H := S) (K := N1) hS_N1norm
    rw [hSinfN1, hN1card, hSKcard] at h
    have h' : Nat.card ↥(S ⊔ N1) * 16384 = (15 * Nat.card ↥S) * 16384 := by
      rw [h]
      ring
    exact Nat.eq_of_mul_eq_mul_right (by norm_num) h'
  have hH2incard : Nat.card H2in = 3 * Nat.card S := by
    have h := CFSG.GroupTheory.CoprimeActionSupport.NormalSubgroupSylowJoin.card_sup_mul_card_inf
      (H := S) (K := N3) hS_N3norm
    rw [hSinfN3, hN3card, hSKcard] at h
    have h' : Nat.card ↥(S ⊔ N3) * 16384 = (3 * Nat.card ↥S) * 16384 := by
      rw [h]
      ring
    exact Nat.eq_of_mul_eq_mul_right (by norm_num) h'
  have hH2card : Nat.card H2 = 3 * Nat.card S := by
    have h := CFSG.GroupTheory.CoprimeActionSupport.NormalSubgroupSylowJoin.card_sup_mul_card_inf
      (H := S) (K := N4) hS_N4norm
    rw [hSinfN4, hN4card, hSKcard] at h
    have h' : Nat.card ↥(S ⊔ N4) * 16384 = (3 * Nat.card ↥S) * 16384 := by
      rw [h]
      ring
    exact Nat.eq_of_mul_eq_mul_right (by norm_num) h'
  have hN3leN1 : N3 ≤ N1 := by
    rw [hN1, hN3]
    exact pull_mono e' ((ru_Y_le_iff (j := 3) (jj := 1) (by norm_num) (by norm_num)).mpr
      (by decide))
  have hH2inleH1 : H2in ≤ H1 :=
    sup_le hSleH1 (hN3leN1.trans le_sup_right)
  have hH1ns : ¬ Group.IsSolvable ↥H1 := by
    intro hsol
    have hN1solv : Group.IsSolvable ↥N1 :=
      Group.isSolvable_of_isSolvable_injective (f := Subgroup.inclusion hN1leH1)
        (Subgroup.inclusion_injective hN1leH1)
    have hY1solv : Group.IsSolvable ↥(ruCtx.Y 1) :=
      Group.isSolvable_of_isSolvable_injective
        (f := (eY1 : ↥(ruCtx.Y 1) →* ↥N1)) eY1.injective
    exact ru_Y1_not_solvable hY1solv
  have hN1core : CFSG.Open.pCoreOf 2 N1 = N1 ⊓ CFSG.Open.pCoreOf 2 H1 := by
    refine le_antisymm (le_inf (Subgroup.map_subtype_le _) ?_) ?_
    · exact CFSG.GroupTheory.pCoreOf_le_pCoreOf_of_le_normalizer 2 hN1leH1 hH1norm
    · exact CFSG.GroupTheory.inf_pCoreOf_le_pCoreOf 2 hN1leH1
  have hpcoreY1 : Nat.card (CFSG.pCore 2 ↥(ruCtx.Y 1)) = 2048 := by
    simpa using CFSG.Quasithin.A312Ru.ru_row_one.1
  have hN1quot : Nat.card ↥N1 = 120 * Nat.card (CFSG.pCore 2 ↥(ruCtx.Y 1)) := by
    rw [hN1card, hpcoreY1]
  have hH1F : CFSG.LocalAnalysis.WeakClosure81.InFSq 2 H1 :=
    hs_bar2_inFSq_two ↥(ruCtx.Y 1) hS hN1leH1 hH2inleH1 hH1card
      hH2incard eY1 hN1quot hN1core hH1ns
  have hSH2 : S ≤ H2 := le_sup_left
  have hH2F : CFSG.LocalAnalysis.WeakClosure81.InFSq 2 H2 :=
    hs_H2_inFSq_two hKN hidx hS hSH2 hH2card
  have hYgen : ruCtx.Y 1 ⊔ ruCtx.Y 4 = ⊤ := by
    have hU : ruCtx.S ≤ ruCtx.Y 1 ⊔ ruCtx.Y 4 :=
      (ruCtx.S_le_Y 1).trans le_sup_left
    obtain ⟨j, hj, hEq⟩ := ru_complete (ruCtx.Y 1 ⊔ ruCtx.Y 4) hU
    by_cases hj5 : j < 5
    · have h1 : ruCtx.Y 1 ≤ memberOrTop 5 ruCtx.Y j := by
        rw [← hEq]
        exact le_sup_left
      have h3 : ruCtx.Y 4 ≤ memberOrTop 5 ruCtx.Y j := by
        rw [← hEq]
        exact le_sup_right
      simp only [memberOrTop, if_pos hj5] at h1 h3
      have hj1 : j ∈ ruIncl[1]! :=
        (ru_Y_le_iff (j := 1) (jj := j) (by norm_num) hj5).mp h1
      have hj3 : j ∈ ruIncl[4]! :=
        (ru_Y_le_iff (j := 4) (jj := j) (by norm_num) hj5).mp h3
      exfalso
      have hnot : ¬ (j ∈ ruIncl[1]! ∧ j ∈ ruIncl[4]!) := by
        interval_cases j <;> decide
      exact hnot ⟨hj1, hj3⟩
    · have hj5' : j = 5 := by omega
      rw [hEq, hj5']
      simp [memberOrTop]
  have hpullgen : N1 ⊔ N4 = K := by
    rw [hN1, hN4, ← pull_sup, hYgen, pull_top]
  have hKle : K ≤ H1 ⊔ H2 := by
    rw [← hpullgen]
    exact sup_le_sup le_sup_right le_sup_right
  have hgen : H1 ⊔ H2 = ⊤ := by
    have hSKtop : K ⊔ S = ⊤ := by
      have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
      have hidx' : ¬ 2 ∣ S.index := by
        have h := hS.2.2
        rwa [Subgroup.relIndex_top_right] at h
      exact CFSG.QuasiDihedralFusion.normal_sup_sylow_eq_top K hidx (hS.2.1.toSylow hidx')
    rw [eq_top_iff, ← hSKtop]
    exact sup_le hKle (le_sup_left.trans le_sup_left)
  refine ⟨H1, H2, le_sup_left, le_sup_left, hgen, hH1F, hH2F, ?_, ?_⟩
  · rw [hH1card]
    exact ⟨5 * Nat.card S, by ring⟩
  · rw [hH2card]
    exact ⟨Nat.card S, by ring⟩

