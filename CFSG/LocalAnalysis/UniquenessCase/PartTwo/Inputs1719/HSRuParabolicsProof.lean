        K.subtype_injective)
  set H1 : Subgroup Y := S ⊔ N1 with hH1
  set H2in : Subgroup Y := S ⊔ N4 with hH2in
  set H2 : Subgroup Y := S ⊔ N3 with hH2
  have hN1leK : N1 ≤ K := by rw [hN1]; exact pull_le e' _
  have hN3leK : N3 ≤ K := pull_le e' _
  have hN4leK : N4 ≤ K := pull_le e' _
  have hN1leH1 : N1 ≤ H1 := le_sup_right
  have hN4leH2in : N4 ≤ H2in := le_sup_right
  have hSleH1 : S ≤ H1 := le_sup_left
  have hSleH2in : S ≤ H2in := le_sup_left
