theorem ru_Y3_unique
    {Z : Subgroup (J ruData)} (hUZ : ruCtx.S ≤ Z)
    (hZ : Nat.card Z = Nat.card (ruCtx.Y 3)) (hZle : Z ≤ ruCtx.Y 1) :
    Z = ruCtx.Y 3 := by
  obtain ⟨j, hj, rfl⟩ := ru_complete Z hUZ
  have hY3card : Nat.card (ruCtx.Y 3) = 49152 := by
    rw [ru_member_card 3 (by norm_num)]
    rfl
  rw [hY3card] at hZ
  by_cases hj5 : j < 5
  · simp only [memberOrTop, if_pos hj5] at hZ hZle ⊢
    interval_cases j
    · rw [ru_member_card 0 (by norm_num)] at hZ
      norm_num at hZ
    · rw [ru_member_card 1 (by norm_num)] at hZ
      norm_num at hZ
    · rw [ru_member_card 2 (by norm_num)] at hZ
      norm_num at hZ
    · rfl
    · exact absurd hZle (by rw [ru_Y_le_iff (by norm_num) (by norm_num)]; decide)
  · exfalso
    have hj5' : j = 5 := by omega
    subst hj5'
    simp only [memberOrTop, if_neg (by omega)] at hZ
    rw [Subgroup.card_top, ru_card] at hZ
    norm_num at hZ

theorem ru_Y3_invariant
    {α : MulAut ↥(J ruData)}
    (hα : ruCtx.S.map (α : ↥(J ruData) →* ↥(J ruData)) = ruCtx.S) :
