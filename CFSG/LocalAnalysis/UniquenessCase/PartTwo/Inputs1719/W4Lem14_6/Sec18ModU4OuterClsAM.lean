  have hcycS : IsCyclic (Outer ↥S) := isCyclic_outer_of_lieModel_PSU4 hU4
  have hcyc : IsCyclic (Outer ↥S') := by
    have eS : ↥S ≃* ↥S' :=
      (Subgroup.equivMapOfInjective S (H.congrHom ψ) (H.congrHom_injective ψ)).trans
        (MulEquiv.subgroupCongr hS'def.symm)
    exact CFSG.RankThree.PartTwo.Late.isCyclic_outer_of_mulEquiv eS.symm hcycS
