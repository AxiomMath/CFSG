theorem k146U4AdjointAM_holds : K146U4AdjointAM := by
  intro U _ _ hU N S hSN hnorm hU4 hirr hAdj
  classical
  obtain ⟨F, hFfield, hFfin, b, c, hFcard, hbc, ε, ψ, hψ⟩ := hAdj
  letI : Field F := hFfield
  letI : Finite F := hFfin
  have hFchar : CharP F 2 :=
    CFSG.ABGLocalTools.SL2Facts.charP_of_card_eq_prime_pow (F := F) (n := 2)
      Nat.prime_two hFcard
  letI : CharP F 2 := hFchar
  haveI : Finite (Matrix Om6Idx Om6Idx F) := inferInstance
  haveI : Finite ↥(adjOmega6 F b) := Subtype.finite
  haveI : Finite (Multiplicative ↥(adjOmega6 F b)) :=
    Finite.of_equiv ↥(adjOmega6 F b) Multiplicative.ofAdd
  have hntU : Nontrivial U := by
    by_contra h
    rw [not_nontrivial_iff_subsingleton] at h
    haveI : Subsingleton (Subgroup U) := Subgroup.subsingleton_iff.mpr h
    exact hirr.1.ne (Subsingleton.elim _ _)
  haveI : Nontrivial U := hntU
  haveI : Nontrivial (Multiplicative ↥(adjOmega6 F b)) := Equiv.nontrivial ψ.toEquiv.symm
  set N' : Subgroup (MulAut (Multiplicative ↥(adjOmega6 F b))) :=
    N.map (H.congrHom ψ) with hN'def
  set S' : Subgroup (MulAut (Multiplicative ↥(adjOmega6 F b))) :=
    S.map (H.congrHom ψ) with hS'def
  set G : Subgroup (MulAut (Multiplicative ↥(adjOmega6 F b))) :=
    (adjAct F b c).range with hGdef
  have key : ∀ (l : ↥S) (g : ↥(omIsoGroup (StatedQuadMinus 3 F b c))),
      ((ε l : ↥(StatedOmega (StatedQuadMinus 3 F b c))) : GL Om6Idx F) =
        (g : GL Om6Idx F) →
      H.congrHom ψ l = adjAct F b c g := by
    intro l g hg
    apply MulEquiv.ext
    intro u
    obtain ⟨u₀, rfl⟩ := ψ.surjective u
    apply Multiplicative.toAdd.injective
    apply Subtype.ext
    rw [H.congrHom_apply, MulEquiv.symm_apply_apply, adjAct_apply, ← hg]
    exact hψ l u₀
  have hS'Ω : S' =
      ((StatedOmega (StatedQuadMinus 3 F b c)).subgroupOf
        (omIsoGroup (StatedQuadMinus 3 F b c))).map (adjAct F b c) := by
    rw [hS'def]
    apply le_antisymm
    · rintro x ⟨l, hl, rfl⟩
      let l' : ↥S := ⟨l, hl⟩
      refine Subgroup.mem_map.mpr
        ⟨⟨ε l', statedOmega_le_omIsoGroup _ (ε l').2⟩,
          Subgroup.mem_subgroupOf.mpr (ε l').2, ?_⟩
      exact (key l' ⟨ε l', statedOmega_le_omIsoGroup _ (ε l').2⟩ rfl).symm
    · rintro x ⟨g, hg, rfl⟩
      have hgS : ((g : ↥(omIsoGroup (StatedQuadMinus 3 F b c))) : GL Om6Idx F) ∈
          StatedOmega (StatedQuadMinus 3 F b c) := Subgroup.mem_subgroupOf.mp hg
      let l : ↥S := ε.symm ⟨(g : GL Om6Idx F), hgS⟩
      refine Subgroup.mem_map.mpr ⟨l, l.2, ?_⟩
      have hεl : ((ε l : ↥(StatedOmega (StatedQuadMinus 3 F b c))) : GL Om6Idx F) =
          (g : GL Om6Idx F) := by
        have h := MulEquiv.apply_symm_apply ε ⟨(g : GL Om6Idx F), hgS⟩
        exact congrArg Subtype.val h
      exact key l g hεl
  have hS'N' : S' ≤ N' := by
    rw [hS'def, hN'def]
    exact Subgroup.map_mono hSN
  have hN'norm : N' ≤
      Subgroup.normalizer (S' : Set (MulAut (Multiplicative ↥(adjOmega6 F b)))) := by
    intro n' hn'
    rw [hN'def] at hn'
    rw [hS'def]
    rw [Subgroup.mem_normalizer_iff]
    intro y
    constructor
    · intro hy
      obtain ⟨s, hs, rfl⟩ := Subgroup.mem_map.mp hy
      obtain ⟨n, hn, rfl⟩ := Subgroup.mem_map.mp hn'
      refine Subgroup.mem_map.mpr ⟨n * s * n⁻¹, ?_, ?_⟩
      · exact Subgroup.mem_subgroupOf.mp
          (hnorm.conj_mem ⟨s, hSN hs⟩ (Subgroup.mem_subgroupOf.mpr hs) ⟨n, hn⟩)
      · rw [map_mul, map_mul, map_inv]
    · intro hy
      obtain ⟨s, hs, hse⟩ := Subgroup.mem_map.mp hy
      obtain ⟨n, hn, rfl⟩ := Subgroup.mem_map.mp hn'
      refine Subgroup.mem_map.mpr ⟨n⁻¹ * s * n, ?_, ?_⟩
      · exact Subgroup.mem_subgroupOf.mp
          (hnorm.conj_mem ⟨s, hSN hs⟩ (Subgroup.mem_subgroupOf.mpr hs)
            ⟨n⁻¹, N.inv_mem hn⟩)
      · rw [map_mul, map_mul, map_inv, hse]
