        adjAct F b c g * y * (adjAct F b c g)⁻¹ ∈
          ((StatedOmega (StatedQuadMinus 3 F b c)).subgroupOf
            (omIsoGroup (StatedQuadMinus 3 F b c))).map (adjAct F b c) := by
      intro g y hy
      obtain ⟨γ, hγ, rfl⟩ := Subgroup.mem_map.mp hy
      have hconj : adjAct F b c g * adjAct F b c γ * (adjAct F b c g)⁻¹ =
          adjAct F b c (g * γ * g⁻¹) := by
        rw [map_mul, map_mul, map_inv]
      rw [hconj]
      refine Subgroup.mem_map.mpr ⟨g * γ * g⁻¹, ?_, rfl⟩
      refine Subgroup.mem_subgroupOf.mpr ?_
      have hgiso : ((g : ↥(omIsoGroup (StatedQuadMinus 3 F b c))) : GL Om6Idx F) ∈
          CFSG.ComponentClassification.HarrisLit.T1.P54.DB.isoGroup
            (StatedQuadMinus 3 F b c) := by
        intro v
        exact g.2 v
      have hγS : ((γ : ↥(omIsoGroup (StatedQuadMinus 3 F b c))) : GL Om6Idx F) ∈
          StatedOmega (StatedQuadMinus 3 F b c) := Subgroup.mem_subgroupOf.mp hγ
      exact CFSG.ComponentClassification.HarrisLit.T1.P54.DB.conj_mem_statedOmega hgiso hγS
    rw [hS'Ω, hGdef]
    rintro x hx
    obtain ⟨g, rfl⟩ := MonoidHom.mem_range.mp hx
    rw [Subgroup.mem_normalizer_iff]
    intro y
    constructor
    · exact hstep g y
    · intro hy
      have h1 := hstep g⁻¹ (adjAct F b c g * y * (adjAct F b c g)⁻¹) hy
      have h2 : adjAct F b c g⁻¹ * (adjAct F b c g * y * (adjAct F b c g)⁻¹) *
          (adjAct F b c g⁻¹)⁻¹ = y := by
        rw [map_inv]
        group
      rwa [h2] at h1
  have hidx : S'.relIndex G = 2 := by
    rw [hS'Ω, hGdef]
    rw [← Subgroup.map_top (f := adjAct F b c)]
    rw [Subgroup.relIndex_map_map_of_injective
      (H := (StatedOmega (StatedQuadMinus 3 F b c)).subgroupOf
        (omIsoGroup (StatedQuadMinus 3 F b c))) (K := ⊤) (adjAct_injective hbc)]
    rw [Subgroup.relIndex_top_right]
    exact CFSG.SeitzReduction.F4Pilot.omIndex_quadMinus_three hbc
  have hU2 : ∀ u : U, u * u = 1 := fun u => by rw [← pow_two]; exact hU u
  have hCoddS : Odd (Nat.card (Subgroup.centralizer (S : Set (MulAut U)))) :=
    CFSG.QuasithinUnique.Setup.X5.centralizer_odd hU2 S
      (fun W' hW' => hirr.2.2.2 W' hW' bot_le le_top)
  have hcardC : Nat.card
      (Subgroup.centralizer (S' : Set (MulAut (Multiplicative ↥(adjOmega6 F b))))) =
      Nat.card (Subgroup.centralizer (S : Set (MulAut U))) := by
    rw [hS'def, CFSG.SignalizerFunctorTheorem.McBride.centralizer_map_equiv
      (MulAut.congr ψ) S, Subgroup.card_map_of_injective (MulAut.congr ψ).injective]
  have hCodd : Odd (Nat.card
      (Subgroup.centralizer (S' : Set (MulAut (Multiplicative ↥(adjOmega6 F b)))))) := by
    rw [hcardC]
