  have hSG : S' ≤ G := by
    rw [hS'Ω, hGdef]
    exact Subgroup.map_le_range _ _
  have hGN : G ≤
      Subgroup.normalizer (S' : Set (MulAut (Multiplicative ↥(adjOmega6 F b)))) := by
    have hstep : ∀ (g : ↥(omIsoGroup (StatedQuadMinus 3 F b c)))
