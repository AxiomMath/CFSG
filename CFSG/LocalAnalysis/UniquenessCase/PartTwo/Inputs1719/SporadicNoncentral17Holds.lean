theorem sporadicNoncentral_HS :
    SporadicNoncentralThreeAt .HS := by
  intro Y _ _ K S hKY hK
  have : K.Normal := hKY.1
  obtain ⟨e₀⟩ := hK
  have hZ : Subgroup.center ↥K = ⊥ :=
    snc_center_eq_bot hKY e₀ CFSG.SectionRank.HS_perfect_odd_cover_trivial
  let eK : ↥K ≃* ↥(J hsData) :=
    (((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm.trans
      e₀).trans CFSG.Sporadic.Bridge.HS.nativeEquiv
  have hc : ∀ j < 5, Nat.card (hsCtx.Y j) = #[1, 15, 21, 3, 3][j]! * 2 ^ 9 := fun j hj => by
    rw [hs_member_card j hj]
    norm_num
  have hΓ : Nat.card (J hsData) = 86625 * 2 ^ 9 := by rw [hs_card]; ring
  have hu : ∀ a, (a = 1 ∨ a = 2) → ∀ Z : Subgroup (J hsData), hsCtx.S ≤ Z →
      Nat.card Z = Nat.card (hsCtx.Y a) → Z = hsCtx.Y a := by
    rintro a ha Z hZS hZc
