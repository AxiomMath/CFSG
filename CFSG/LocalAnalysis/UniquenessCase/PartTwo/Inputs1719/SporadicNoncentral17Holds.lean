@[expose] def SporadicNoncentralThreeAt (s : TauCeti.SporadicName) : Prop :=
  ∀ (Y : Type) [Group Y] [Finite Y] (K S : Subgroup Y),
    KYForm Y K S → IsSpor (↥K ⧸ Subgroup.center ↥K) s →
      ∃ E : Subgroup Y, E ≤ K ∧ E ≠ ⊥ ∧ IsPGroup 3 ↥E ∧ (∀ x ∈ E, x ^ 3 = 1) ∧
        ¬ E ≤ (Subgroup.center ↥K).map K.subtype ∧ Permutes E S

private theorem snc_center_eq_bot {Y : Type} [Group Y] [Finite Y] {K S : Subgroup Y}
    (hKY : KYForm Y K S) {Γ : Type} [Group Γ] (e : ↥K ⧸ Subgroup.center ↥K ≃* Γ)
    (h : ∀ {E : Type} [Group E] [Finite E] [Group.IsPerfect E] (π : E →* Γ),
      Function.Surjective π → π.ker ≤ Subgroup.center E → Odd (Nat.card π.ker) → π.ker = ⊥) :
    Subgroup.center ↥K = ⊥ := by
  have : Group.IsPerfect ↥K := Group.isPerfect_def.mpr hKY.2.1.1
  have hker := CFSG.GH74.Generic.centralQuotientMap_ker e
  rw [← hker]
  exact h _ (CFSG.GH74.Generic.centralQuotientMap_surjective e) hker.le (hker ▸ hKY.2.2.1)

private theorem snc_of_card_three {Y : Type} [Group Y] {K S E : Subgroup Y} (hEK : E ≤ K)
    (hE : Nat.card E = 3) (hEZ : ¬ E ≤ (Subgroup.center ↥K).map K.subtype)
    (hP : Permutes E S) :
    ∃ E : Subgroup Y, E ≤ K ∧ E ≠ ⊥ ∧ IsPGroup 3 ↥E ∧ (∀ x ∈ E, x ^ 3 = 1) ∧
      ¬ E ≤ (Subgroup.center ↥K).map K.subtype ∧ Permutes E S := by
  refine ⟨E, hEK, fun h => ?_, IsPGroup.of_card (n := 1) (by rw [hE, pow_one]), fun x hx => ?_,
    hEZ, hP⟩
  · rw [h, Subgroup.card_bot] at hE
    norm_num at hE
  · have hdvd : orderOf x ∣ 3 := by simpa [hE] using Subgroup.orderOf_dvd_natCard E hx
    exact orderOf_dvd_iff_pow_eq_one.mp hdvd

private theorem snc_of_overgroup {Y : Type} [Group Y] [Finite Y] {K S H : Subgroup Y}
    (hKY : KYForm Y K S) (hZ : Subgroup.center ↥K = ⊥) (hSH : S ≤ H)
    (hH : Nat.card H = 3 * Nat.card S) :
    ∃ E : Subgroup Y, E ≤ K ∧ E ≠ ⊥ ∧ IsPGroup 3 ↥E ∧ (∀ x ∈ E, x ^ 3 = 1) ∧
      ¬ E ≤ (Subgroup.center ↥K).map K.subtype ∧ Permutes E S := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨E, -, hEK, hEc, -, -, hP⟩ := exists_permutes_of_overgroup hKY.1 hKY.2.2.2.2.1
    hKY.2.2.2.2.2.2.1 hSH (p := 3) (n := 1) (by norm_num) (by rw [hH, pow_one])
  rw [pow_one] at hEc
  refine snc_of_card_three hEK hEc ?_ hP
  rw [hZ, Subgroup.map_bot, le_bot_iff]
  intro h
  rw [h, Subgroup.card_bot] at hEc
  norm_num at hEc

private theorem snc_card_inf {Γ : Type} [Group Γ] [Finite Γ] {P₁ P₂ Q : Subgroup Γ} {u : ℕ}
    (hQ : Q ≤ P₁ ⊓ P₂) (hQc : Nat.card Q = 3 * u) (h₁ : Nat.card P₁ = 15 * u)
    (h₂ : Nat.card P₂ = 21 * u) : Nat.card ↥(P₁ ⊓ P₂) = 3 * u := by
  refine Nat.dvd_antisymm ?_ (hQc ▸ Subgroup.card_dvd_of_le hQ)
  have h1 : Nat.card ↥(P₁ ⊓ P₂) ∣ 15 * u := h₁ ▸ Subgroup.card_dvd_of_le inf_le_left
  have h2 : Nat.card ↥(P₁ ⊓ P₂) ∣ 21 * u := h₂ ▸ Subgroup.card_dvd_of_le inf_le_right
  have h := Nat.dvd_gcd h1 h2
  rwa [Nat.gcd_mul_right, show Nat.gcd 15 21 = 3 by norm_num] at h

private theorem snc_map_inf {Γ : Type} [Group Γ] {U P₁ P₂ : Subgroup Γ} (h₁ : U ≤ P₁)
    (h₂ : U ≤ P₂) (hu₁ : ∀ Z : Subgroup Γ, U ≤ Z → Nat.card Z = Nat.card P₁ → Z = P₁)
    (hu₂ : ∀ Z : Subgroup Γ, U ≤ Z → Nat.card Z = Nat.card P₂ → Z = P₂) (α : MulAut Γ)
    (hα : U.map α.toMonoidHom = U) : (P₁ ⊓ P₂).map α.toMonoidHom = P₁ ⊓ P₂ := by
  rw [Subgroup.map_inf_eq _ _ _ α.injective, E2P.SporB.map_eq_of_unique_card h₁ hu₁ α hα,
    E2P.SporB.map_eq_of_unique_card h₂ hu₂ α hα]

open CFSG.Walter.J1Props in
theorem sporadicNoncentral_J1 : SporadicNoncentralThreeAt .J1 := by
  intro Y _ _ K S hKY hK
  have hZ : Subgroup.center ↥K = ⊥ := k_J1IsCenterless_holds ↥K hKY.2.1 hKY.2.2.1 hK
  obtain ⟨e₀⟩ := hK
  let eW : ↥K ≃* ↥CFSG.Open.walterJ1 :=
    (((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm.trans
      e₀).trans CFSG.Walter.walterJ1EquivNative.symm
  have hKtop : K = ⊤ := eq_top_of_inner_model hKY hZ eW fun φ => J3_aut φ
  have h3 : orderOf mJ = 3 := orderOf_yJ (p := 3) (by norm_num)
  have hdisj : Disjoint S₀ (Subgroup.zpowers mJ) := by
    apply Subgroup.disjoint_of_coprime_natCard
    rw [card_S₀, Nat.card_zpowers, h3]
    norm_num
  have hP : Nat.card ↥(S₀ ⊔ Subgroup.zpowers mJ) = 3 * 2 ^ 3 := by
    rw [CFSG.GorensteinWalter.card_sup_eq_mul_of_disjoint_of_le_normalizer _ _
      (Subgroup.zpowers_le.mpr mJ_mem_normalizer) hdisj, card_S₀, Nat.card_zpowers, h3]
    norm_num
  have hPi : ¬ 2 ∣ (S₀ ⊔ Subgroup.zpowers mJ).index := by
    have h1 := Subgroup.card_mul_index (S₀ ⊔ Subgroup.zpowers mJ)
    rw [hP, card_walterJ1] at h1
    omega
  obtain ⟨H, hSH, hH⟩ :=
    exists_overgroup_of_eq_top' hKtop hKY.2.2.2.2.2 hP (by norm_num) hPi eW
  exact snc_of_overgroup hKY hZ hSH hH

open CFSG.Quasithin.E2P.SporB CFSG.QuasithinUnique.Vol2Native.A312L.M12Lat in
theorem sporadicNoncentral_M12 :
    SporadicNoncentralThreeAt .M12 := by
  intro Y _ _ K S hKY hK
  have : K.Normal := hKY.1
  obtain ⟨e₀⟩ := hK
  have hZ : Subgroup.center ↥K = ⊥ :=
    snc_center_eq_bot hKY e₀ CFSG.SectionRank.M12_perfect_odd_cover_trivial
  let eK : ↥K ≃* ↥m12Grp :=
    (((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm.trans
      e₀).trans (MulEquiv.subgroupCongr mGens_closure).symm
  obtain ⟨U, P, _, hU, hUc, hUP, -, hPc, -, -, hinv⟩ := m12_pair_data
  obtain ⟨H, hSH, hH⟩ := exists_overgroup_of_invariant hU hUP 3 (by rw [hPc, hUc])
    (fun α hα => (hinv α hα).1) eK hKY.2.2.2.2.2
  exact snc_of_overgroup hKY hZ hSH hH

theorem sporadicNoncentral_M22 :
    SporadicNoncentralThreeAt .M22 := by
  intro Y _ _ K S hKY hK
  have : K.Normal := hKY.1
  have : Group.IsPerfect ↥K := Group.isPerfect_def.mpr hKY.2.1.1
  obtain ⟨E, X₁, X₂, -, hE9, -, hX₁K, hX₂K, hX₁3, hX₂3, hP₁, hP₂, hEle⟩ :=
    k_M22HexadPair_holds Y K S hKY hK
  obtain ⟨e₀⟩ := hK
  have hZ13 :=
    CFSG.Quasithin.Background.Harris.IrreducibleModulesAndBounds.m22_center_card_odd_cases
      hKY.2.2.1 e₀
  set Z : Subgroup Y := (Subgroup.center ↥K).map K.subtype
  by_cases h₁ : X₁ ≤ Z
  · by_cases h₂ : X₂ ≤ Z
    · exfalso
      have hZn : Z.Normal := by
        have : (Subgroup.center ↥K).Characteristic := Subgroup.centerCharacteristic
        exact ConjAct.normal_of_characteristic_of_normal (H := K) (K := Subgroup.center ↥K)
      have hZc : Nat.card Z = Nat.card (Subgroup.center ↥K) :=
        Subgroup.card_map_of_injective K.subtype_injective
      have hEZS : E ≤ S ⊔ Z := hEle.trans
        (sup_le (sup_le (h₁.trans le_sup_right) (h₂.trans le_sup_right)) le_sup_left)
      have h :=
        CFSG.GroupTheory.CoprimeActionSupport.NormalSubgroupSylowJoin.card_sup_mul_card_inf
          (H := S) (K := Z) (by rw [Subgroup.normalizer_eq_top_iff.mpr hZn]; exact le_top)
      have h9 : 9 ∣ Nat.card S * Nat.card Z := by
        rw [← h, ← hE9]
        exact Dvd.dvd.mul_right (Subgroup.card_dvd_of_le hEZS) _
      obtain ⟨k, hk⟩ := hKY.2.2.2.2.2.2.1.exists_card_eq
      rw [hk] at h9
      have h9' : 9 ∣ Nat.card Z :=
        (Nat.Coprime.pow_right k (by norm_num : Nat.Coprime 9 2)).dvd_of_dvd_mul_left h9
      rw [hZc] at h9'
      rcases hZ13 with h1 | h1 <;> rw [h1] at h9' <;> norm_num at h9'
    · exact snc_of_card_three hX₂K hX₂3 h₂ hP₂
  · exact snc_of_card_three hX₁K hX₁3 h₁ hP₁

