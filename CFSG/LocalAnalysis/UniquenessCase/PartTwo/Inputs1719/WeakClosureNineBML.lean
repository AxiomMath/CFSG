theorem l1_gens : [a1, b1].map code = l1GenC := by decide

theorem l2_gens : [a2, b2].map code = l2GenC := by decide

theorem l1_build : l1Lit = Core.buildCodes cid l1GenC l1Tree := by decide +kernel

theorem l2_build : l2Lit = Core.buildCodes cid l2GenC l2Tree := by decide +kernel

theorem l1_tbl : Core.tblCheckC cid l1GenC l1Lit l1Tbl = true := by decide +kernel

theorem l2_tbl : Core.tblCheckC cid l2GenC l2Lit l2Tbl = true := by decide +kernel

theorem l1_nodup : l1Lit.Nodup := by decide +kernel

theorem l1_length : l1Lit.length = 168 := by decide +kernel

theorem l2_nodup : l2Lit.Nodup := by decide +kernel

theorem l2_length : l2Lit.length = 168 := by decide +kernel

theorem l1_hi : ∀ c ∈ l1Lit, cfixHi c = true := by decide +kernel

theorem l2_lo : ∀ c ∈ l2Lit, cfixLo c = true := by decide +kernel

theorem l1_trans : ∀ k < 8, ∃ c ∈ l1Lit, c.getD 7 0 = k := by decide +kernel

theorem l2_trans : ∀ k < 16, 8 ≤ k → ∃ c ∈ l2Lit, c.getD 15 0 = k := by decide +kernel

theorem ldesc_of_closure {gens : List P16} {gc : List (List ℕ)} (hg : gens.map code = gc)
    {tree : List (ℕ × ℕ)} {tbl : List (List ℕ)} {L : List (List ℕ)}
    (hb : L = Core.buildCodes cid gc tree) (ht : Core.tblCheckC cid gc L tbl = true) :
    LDesc (closure {g | g ∈ gens}) L := by
  subst hb
  obtain ⟨hmem, hsurj⟩ := mem_closure_iff_of_tblN (n := 16) hg ht
  exact ⟨hmem, hsurj⟩

theorem l1_desc : LDesc L01 l1Lit := ldesc_of_closure l1_gens l1_build l1_tbl

theorem l2_desc : LDesc L02 l2Lit := ldesc_of_closure l2_gens l2_build l2_tbl

theorem card_L01 : Nat.card L01 = 168 := by rw [l1_desc.card l1_nodup, l1_length]

theorem L01_le_fixHiP : L01 ≤ fixHiP := fun σ hσ =>
  cfixHi_iff.1 (l1_hi _ ((l1_desc.mem σ).1 hσ))

theorem L02_le_fixLoP : L02 ≤ fixLoP := fun σ hσ =>
  cfixLo_iff.1 (l2_lo _ ((l2_desc.mem σ).1 hσ))

theorem commute_L01_L02 {x y : P16} (hx : x ∈ L01) (hy : y ∈ L02) : x * y = y * x :=
  commute_of_fixHiP_fixLoP (L01_le_fixHiP hx) (L02_le_fixLoP hy)

theorem fixHiP_inf_fixLoP : fixHiP ⊓ fixLoP = ⊥ := by
  rw [eq_bot_iff]
  rintro σ ⟨hσ1, hσ2⟩
  rw [mem_bot]
  ext k
  by_cases hk : k.val < 8
  · rw [hσ2 k hk]; rfl
  · rw [hσ1 k (by omega)]; rfl

theorem L01_inf_L02 : L01 ⊓ L02 = ⊥ :=
  eq_bot_iff.2 fun _ hσ => fixHiP_inf_fixLoP ▸ ⟨L01_le_fixHiP hσ.1, L02_le_fixLoP hσ.2⟩

theorem sig_inv : sig⁻¹ = sig := by decide

theorem L02_eq_map : L02 = L01.map (MulAut.conj sig).toMonoidHom := by
  rw [L01, L02, MonoidHom.map_closure]
  congr 1
  ext σ
  simp only [List.mem_cons, List.not_mem_nil, or_false, Set.mem_setOf_eq, Set.mem_image,
    MulEquiv.coe_toMonoidHom, MulAut.conj_apply, sig_inv]
  constructor
  · rintro (rfl | rfl)
    · exact ⟨a1, Or.inl rfl, a2_eq.symm⟩
    · exact ⟨b1, Or.inr rfl, b2_eq.symm⟩
  · rintro ⟨τ, (rfl | rfl), rfl⟩
    · exact Or.inl a2_eq.symm
    · exact Or.inr b2_eq.symm

theorem isSimpleGroup_L02 : IsSimpleGroup ↥L02 := by
  have := isSimpleGroup_L01
  rw [L02_eq_map]
  exact (L01.equivMapOfInjective _ (MulAut.conj sig).injective).symm.isSimpleGroup

theorem fix_a1b2 : ∀ k : Fin 16, (a1 * b2) k = k → k = 7 := by decide

theorem fix_a2b1 : ∀ k : Fin 16, (a2 * b1) k = k → k = 15 := by decide

theorem a1b2_seven : (a1 * b2) 7 = 7 := by decide

theorem a2b1_fifteen : (a2 * b1) 15 = 15 := by decide

theorem eq_one_of_commute {g : P16} (h1 : ∀ x ∈ L01, g * x = x * g)
    (h2 : ∀ x ∈ L02, g * x = x * g) : g = 1 := by
  have hc : ∀ x, x ∈ L01 ⊔ L02 → g * x = x * g := by
    intro x hx
    have hle : L01 ⊔ L02 ≤ centralizer {g} := sup_le (fun y hy => mem_centralizer_singleton_iff.2
      (h1 y hy).symm) (fun y hy => mem_centralizer_singleton_iff.2 (h2 y hy).symm)
    exact (mem_centralizer_singleton_iff.1 (hle hx)).symm
  have happ : ∀ x, x ∈ L01 ⊔ L02 → ∀ k, g (x k) = x (g k) := fun x hx k => by
    have := congrArg (fun p : P16 => p k) (hc x hx)
    simpa using this
  have hab : a1 * b2 ∈ L01 ⊔ L02 :=
    mul_mem (mem_sup_left (subset_closure (by simp))) (mem_sup_right (subset_closure (by simp)))
  have hba : a2 * b1 ∈ L01 ⊔ L02 :=
    mul_mem (mem_sup_right (subset_closure (by simp))) (mem_sup_left (subset_closure (by simp)))
  have h7 : g 7 = 7 := fix_a1b2 _ (by rw [← happ _ hab, a1b2_seven])
  have h15 : g 15 = 15 := fix_a2b1 _ (by rw [← happ _ hba, a2b1_fifteen])
  ext k
  change (g k : ℕ) = k
  congr 1
  by_cases hk : k.val < 8
  · obtain ⟨c, hc, hck⟩ := l1_trans k hk
    obtain ⟨w, hw, rfl⟩ := l1_desc.surj c hc
    have hk' : w 7 = k := by
      apply Fin.ext
      rw [← hck]
      exact (codeN_getD w 7).symm
    rw [← hk', happ w (mem_sup_left hw), h7]
  · obtain ⟨c, hc, hck⟩ := l2_trans k k.2 (by omega)
    obtain ⟨w, hw, rfl⟩ := l2_desc.surj c hc
    have hk' : w 15 = k := by
      apply Fin.ext
      rw [← hck]
      exact (codeN_getD w 15).symm
    rw [← hk', happ w (mem_sup_right hw), h15]

theorem fixLo_of_commute {g : P16} (hg : ∀ k : Fin 16, k.val < 8 → (g k).val < 8)
    (h1 : ∀ x ∈ L01, g * x = x * g) : g ∈ fixLoP := by
  have happ : ∀ x, x ∈ L01 → ∀ k, g (x k) = x (g k) := fun x hx k => by
    have := congrArg (fun p : P16 => p k) (h1 x hx)
    simpa using this
  have h7 : g 7 = 7 := by
    have ha : a1 (g 7) = g 7 := by
      rw [← happ a1 (subset_closure (by simp))]
      rfl
    have hlt := hg 7 (by decide)
    have key : ∀ k : Fin 16, k.val < 8 → a1 k = k → k = 7 := by decide
    exact key _ hlt ha
  intro k hk
  obtain ⟨c, hc, hck⟩ := l1_trans k hk
  obtain ⟨w, hw, rfl⟩ := l1_desc.surj c hc
  have hk' : w 7 = k := by
    apply Fin.ext
    rw [← hck]
    exact (codeN_getD w 7).symm
  rw [← hk', happ w hw, h7]

@[expose] def y3C : List ℕ := [7, 0, 4, 3, 6, 5, 2, 1, 8, 9, 10, 11, 12, 13, 14, 15]

theorem y3_mem : y3C ∈ l1Lit := by decide +kernel

theorem exists_three_L01 : ∃ y ∈ L01, orderOf y = 3 := by
  obtain ⟨y, hy, hyc⟩ := l1_desc.surj _ y3_mem
  refine ⟨y, hy, orderOf_eq_prime ?_ ?_⟩
  · apply code_injective
    rw [pow_succ, pow_two, code_mul, code_mul, hyc, code_one]
    decide
  · intro h
    rw [h, code_one] at hyc
    exact absurd hyc (by decide)

