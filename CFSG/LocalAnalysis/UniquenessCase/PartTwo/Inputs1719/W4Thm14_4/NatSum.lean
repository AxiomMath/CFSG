theorem fixV_eq_bot_of_isAlt_five_natural {W : Type} [CommGroup W] [Finite W]
    (hW : ∀ w : W, w ^ 2 = 1) {L : Subgroup (MulAut W)} (haL : IsAlt ↥L 5)
    (hSupL : (⨆ I ∈ irrSet L, I) = ⊤) (hNL : ∀ I ∈ irrSet L, BinaryNaturalSL L I ⊥ 2 2) :
    fixV L = ⊥ := by
  obtain ⟨eL⟩ := haL
  have h3 : (Equiv.swap (0 : Fin 5) 1 * Equiv.swap 0 2).IsThreeCycle :=
    Equiv.Perm.isThreeCycle_swap_mul_swap_same (by decide) (by decide) (by decide)
  let c : alternatingGroup (Fin 5) := ⟨_, h3.mem_alternatingGroup⟩
  have hz : orderOf ((eL.symm c : ↥L) : MulAut W) = 3 := by
    rw [Subgroup.orderOf_coe, MulEquiv.orderOf_eq, ← Subgroup.orderOf_coe]
    exact h3.orderOf
  have h := kA5NatFpf_holds W hW L ⟨eL⟩ hSupL hNL _ (eL.symm c).2 hz
  rw [eq_bot_iff, ← h]
  intro v hv x hx
  exact hv x (Subgroup.zpowers_le.mpr (eL.symm c).2 hx)

theorem kA5NatSum_holds : KA5NatSum := by
  intro W _ _ hW L₁ L₂ X hX hcomm ha₁ ha₂ hSup₁ hSup₂ hN₁ hN₂
  subst hX
  have hdisj : L₁ ⊓ L₂ = ⊥ := inf_eq_bot_of_commute_isAlt_five hcomm ha₁
  have hK : Nat.card (GaloisField 2 2) = 2 ^ 2 := GaloisField.card 2 2 (by norm_num)
  obtain ⟨Θ⟩ := CFSG.CGT.PushingUpLit.CGT6.sl2_four_equiv_alt5
  have hiso : ∀ L : Subgroup (MulAut W), IsAlt ↥L 5 →
      ∃ π : ↥(StatedSL 2 (GaloisField 2 2)) →* ↥L, Function.Bijective π := by
    rintro L ⟨eL⟩
    let σ : ↥(StatedSL 2 (GaloisField 2 2)) ≃* ↥L :=
      ((CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 2 (GaloisField 2 2)).symm.trans
        Θ).trans eL.symm
    exact ⟨σ.toMonoidHom, σ.bijective⟩
  obtain ⟨π₁, hπ₁⟩ := hiso L₁ ha₁
  obtain ⟨π₂, hπ₂⟩ := hiso L₂ ha₂
  have hnat : ∀ (L : Subgroup (MulAut W)) (π : ↥(StatedSL 2 (GaloisField 2 2)) →* ↥L),
      Function.Bijective π → fixV L = ⊥ → (∀ I ∈ irrSet L, BinaryNaturalSL L I ⊥ 2 2) →
      (∀ I ∈ irrSet L, IsIrrOn L I ⊥) ∧
        ∀ I ∈ irrSet L, (FFModel.nat (StatedSL 2 (GaloisField 2 2))).RealizesVia L I ⊥ π := by
    intro L π hπ hfix hNL
    have hirr : ∀ I ∈ irrSet L, IsIrrOn L I ⊥ := by
      intro I hI
      have h := hI.2
      rwa [hfix, inf_bot_eq] at h
    refine ⟨hirr, fun I hI => ?_⟩
    obtain ⟨K', _, _, hK', π', h'⟩ := hNL I hI
    exact realizesVia_nat_statedSL_two_of_bijective hW (hirr I hI) hK hK' hπ h'
  have hfix₁ := fixV_eq_bot_of_isAlt_five_natural hW ha₁ hSup₁ hN₁
  obtain ⟨hirr₁, hreal₁⟩ := hnat L₁ π₁ hπ₁ hfix₁ hN₁
  obtain ⟨hirr₂, hreal₂⟩ :=
    hnat L₂ π₂ hπ₂ (fixV_eq_bot_of_isAlt_five_natural hW ha₂ hSup₂ hN₂) hN₂
  obtain ⟨m, e, he₁⟩ := exists_coords_of_iSup_realizesVia (StatedSL 2 (GaloisField 2 2))
    (irrSet L₁) hSup₁ hirr₁ hreal₁
  obtain ⟨ψ, -, he₂⟩ := exists_hom_kronGL_of_commute (StatedSL 2 (GaloisField 2 2))
    (hasScalarCommutant_statedSL le_rfl) hπ₁.2 e he₁ hcomm
  obtain ⟨n, R, hRind, hRtop, hR2, hRinv, hRfaith⟩ :=
    exists_multSpace_decomp hK e ψ he₂ hπ₂.2 (irrSet L₂) hSup₂ hirr₂ hreal₂
  let I : Fin n → Subgroup W := fun i => (blockSub (ι := Fin 2) (R i)).comap e.toMonoidHom
  have hT : ∀ i, NatTensor (L₁ ⊔ L₂) (I i) ⊥ 2 2 := fun i =>
    natTensor_comap_blockSub hK hcomm hdisj e hπ₁.2 he₁ hπ₂ ψ he₂ (R i) (hR2 i) (hRinv i)
      (hRfaith i)
  have hind : ∀ i, I i ⊓ (⊥ ⊔ ⨆ (j : Fin n) (_ : j ≠ i), I j) ≤ ⊥ :=
    comap_blockSub_inf_le e hRind
  have hsup : (⊥ ⊔ ⨆ i, I i) = ⊤ := sup_iSup_comap_blockSub_eq_top e hRtop
  have hcard : ∀ i, Nat.card ↥(I i) = 2 ^ 8 := by
    intro i
    rw [natCard_comap_blockSub, Module.natCard_eq_pow_finrank (K := GaloisField 2 2), hR2 i, hK,
      Fintype.card_fin]
    norm_num
  have hfixX : fixV (L₁ ⊔ L₂) = ⊥ := by
    rw [eq_bot_iff, ← hfix₁]
    exact fun v hv x hx => hv x (le_sup_left (a := L₁) hx)
  refine ⟨fun J hJ => ?_, n, ?_, I, fun _ => bot_le, hind, hsup, fun i =>
    natOmegaPlus_of_natTensor le_rfl (hT i)⟩
  ·
    have hJirr : IsIrrOn (L₁ ⊔ L₂) J ⊥ := by
      have h := hJ.2
      rwa [hfixX, inf_bot_eq] at h
    obtain ⟨i, hi⟩ := exists_card_eq_of_isIrrOn I hind hsup
      (fun i => (natTensor_isIrrOn le_rfl (hT i)).1) hJirr
    show padicValNat 2 (Nat.card ↥J) = 8
    rw [hi, hcard i, padicValNat.prime_pow]
  ·
    show padicValNat 2 (Nat.card W) = 8 * n
    rw [card_eq_prod_of_indep I hind hsup]
    simp only [hcard, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    rw [← pow_mul, padicValNat.prime_pow]

