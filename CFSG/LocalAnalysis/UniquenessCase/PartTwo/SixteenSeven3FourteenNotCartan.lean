variable {G : Type} [Group G] [Finite G]

theorem s16c1614_k_cases (D : Data G) : D.k = 1 ∨ D.k = 2 := by
  unfold Data.k CFSG.LocalAnalysis.RankThreeUC.kParam
  split_ifs <;> simp

theorem s16c1614_sp_three_of_k_eq_one (D : Data G) (h : D.k = 1) : IsStronglyPEmbedded 3 D.M := by
  by_contra hn
  have h2 := (Data.k_eq_two_iff D).2 hn
  omega

theorem s16c1614_k_eq_one_of_sp (D : Data G) (h : IsStronglyPEmbedded 3 D.M) : D.k = 1 := by
  rcases s16c1614_k_cases D with h1 | h2
  · exact h1
  · exact absurd h ((Data.k_eq_two_iff D).1 h2)

theorem s16c1614_dvd_card_of_cartanBar (D : Data G) {V : Subgroup G} {hV : IsElemAbelian 2 V}
    {n : ℕ} {x : MulAut (Vtil (⊥ : Subgroup G) V hV)} (hx : CartanBar1614 D V hV n x) :
    2 ^ n - 1 ∣ Nat.card ↥(Mbar D.M ⊥ V hV) := by
  have h := orderOf_dvd_natCard (⟨x, hx.1⟩ : ↥(Mbar D.M ⊥ V hV))
  rwa [Subgroup.orderOf_mk, hx.2.1] at h

theorem s16c1614_eq_add_two_of_sp (D : Data G) {V U : Subgroup G} (hC : Cartan1614 D V U)
    {n : ℕ} (hn : rMV D.M V = n) (hkn : D.k < n) (hn2 : n ≤ D.k + 2)
    (hsp : IsStronglyPEmbedded (2 ^ (D.k + 1) - 1) D.M) : n = D.k + 2 := by
  by_contra hne
  have hn1 : n = D.k + 1 := by omega
  have hp : (2 ^ (D.k + 1) - 1).Prime := by
    rcases s16c1614_k_cases D with h | h <;> rw [h] <;> norm_num
  have h := s16c1614_not_dvd_of_cartan D hp hsp hC hn
  rw [hn1] at h
  exact h dvd_rfl

theorem s16c1614_cartanBar_of_min_cartan (D : Data G) {V L : Subgroup G}
    {hV : IsElemAbelian 2 V} (hc : Counterex16 D ⊥ V L hV) {U : Subgroup G}
    (hU : Min1614 D V U) (hC : Cartan1614 D V U) (hk : ((D.k : ℕ) : ℕ∞) < rMV D.M V) :
    ∃ n : ℕ, rMV D.M V = n ∧ D.k < n ∧ n ≤ D.k + 2 ∧ ∃ x, CartanBar1614 D V hV n x := by
  obtain ⟨-, -, hrU, hrk⟩ := hU
  obtain ⟨n, K, X, hrn, -, -, -, -, hXKM, hcyc, hcard, hCV, hreg⟩ := hC
  have hkn : D.k < n := by
    rw [hrn] at hk
    exact_mod_cast hk
  have hn2 : n ≤ D.k + 2 := by
    rw [hrn] at hrk
    exact_mod_cast hrk
  have hUV : U ≠ V := by
    rintro rfl
    rw [E3.mQuot_self, hrn] at hrU
    have h0 : (0 : ℕ) = n := by exact_mod_cast hrU
    omega
  have hH : Hyp125 D ⊥ V := hc.setting.hyp16.hyp125
  have hMs : D.M ≤ stabTil (⊥ : Subgroup G) V :=
    le_stabTil hH.pairFacts.le_normalizer hH.pairFacts.le_normalizer₀
  exact ⟨n, hrn, hkn, hn2,
    s16c1614_cartanBar_of_cartan D hV hMs (hXKM.trans inf_le_right) hcyc hcard hCV hUV hreg⟩

theorem s16c1614_cartanBar_three (D : Data G) (hSg : UC6S846.SigmaStd D)
    (h1219 : D.sig = D.sig1) (h3 : 3 ∈ D.sig) {V L : Subgroup G} {hV : IsElemAbelian 2 V}
    (hc : Counterex16 D ⊥ V L hV) {U : Subgroup G} (hU : Min1614 D V U)
    (hC : Cartan1614 D V U) (hk : ((D.k : ℕ) : ℕ∞) < rMV D.M V) :
    ∃ x, CartanBar1614 D V hV 3 x := by
  have hsp3 : IsStronglyPEmbedded 3 D.M := hSg.sig1_sp 3 (h1219 ▸ h3)
  have hk1 : D.k = 1 := s16c1614_k_eq_one_of_sp D hsp3
  obtain ⟨n, hrn, hkn, hn2, hx⟩ := s16c1614_cartanBar_of_min_cartan D hc hU hC hk
  have hn := s16c1614_eq_add_two_of_sp D hC hrn hkn hn2 (by rw [hk1]; simpa using hsp3)
  obtain rfl : n = 3 := by omega
  exact hx

theorem s16c1614_cartanBar_seven (D : Data G) (hSg : UC6S846.SigmaStd D)
    (h1219 : D.sig = D.sig1) (h7 : 7 ∈ D.sig) {V L : Subgroup G} {hV : IsElemAbelian 2 V}
    (hc : Counterex16 D ⊥ V L hV) {U : Subgroup G} (hU : Min1614 D V U)
    (hC : Cartan1614 D V U) (hk : ((D.k : ℕ) : ℕ∞) < rMV D.M V) :
    ∃ x, CartanBar1614 D V hV 4 x := by
  have hsp7 : IsStronglyPEmbedded 7 D.M := hSg.sig1_sp 7 (h1219 ▸ h7)
  obtain ⟨n, hrn, hkn, hn2, hx⟩ := s16c1614_cartanBar_of_min_cartan D hc hU hC hk
  have hn3 : n ≠ 3 := by
    rintro rfl
    exact s16c1614_not_dvd_of_cartan D (p := 7) (by norm_num) hsp7 hC hrn (by norm_num)
  rcases s16c1614_k_cases D with hk1 | hk2
  · have hsp3 : IsStronglyPEmbedded 3 D.M := s16c1614_sp_three_of_k_eq_one D hk1
    have hn := s16c1614_eq_add_two_of_sp D hC hrn hkn hn2 (by rw [hk1]; simpa using hsp3)
    omega
  · have hn := s16c1614_eq_add_two_of_sp D hC hrn hkn hn2 (by rw [hk2]; simpa using hsp7)
    obtain rfl : n = 4 := by omega
    exact hx

theorem s16c1614_false_of_cartan (D : Data G) (hSg : UC6S846.SigmaStd D)
    (h1219 : D.sig = D.sig1) (h13b : R16_13_2 D) {V L : Subgroup G} {hV : IsElemAbelian 2 V}
    (hc : Counterex16 D ⊥ V L hV) {U : Subgroup G} (hU : Min1614 D V U)
    (hC : Cartan1614 D V U) (hk : ((D.k : ℕ) : ℕ∞) < rMV D.M V) : False := by
  have hL : L ≤ D.M := hc.setting.hyp151.le
  have bar3 : 3 ∈ D.sig → ∃ x, CartanBar1614 D V hV 3 x := fun h3 =>
    s16c1614_cartanBar_three D hSg h1219 h3 hc hU hC hk
  have bar7 : 7 ∈ D.sig → ∃ x, CartanBar1614 D V hV 4 x := fun h7 =>
    s16c1614_cartanBar_seven D hSg h1219 h7 hc hU hC hk
  have d7 : ∀ x, CartanBar1614 D V hV 3 x → 7 ∣ Nat.card ↥(Mbar D.M ⊥ V hV) := fun x hx => by
    simpa using s16c1614_dvd_card_of_cartanBar D hx
  have d5 : ∀ x, CartanBar1614 D V hV 4 x → 5 ∣ Nat.card ↥(Mbar D.M ⊥ V hV) := fun x hx =>
    (show 5 ∣ 2 ^ 4 - 1 by norm_num).trans (s16c1614_dvd_card_of_cartanBar D hx)
  rcases h13b ⊥ V L hV hc with hS | ⟨p, hp, h4⟩ | h3 | h8 | h9 | ⟨p, hp, h10⟩ | h11
  · obtain ⟨x, hx⟩ := bar3 (by rw [hS.2.2]; exact Set.mem_singleton 3)
    exact s16c1614_false_of_case168_2Small_cartan D hV hL hS hx
  · rcases hp with rfl | rfl
    · obtain ⟨x, hx⟩ := bar3 h4.2.2
      exact s16c1614_not_seven_dvd_case168_4_three D hV h4 (d7 x hx)
    · obtain ⟨x, hx⟩ := bar7 h4.2.2
      exact s16c1614_not_five_dvd_case168_4_seven D hV h4 (d5 x hx)
  · obtain ⟨x, hx⟩ := bar3 (by rw [h3.2.2]; exact Set.mem_singleton 3)
    exact s16c1614_false_of_case168_3_cartan D hV h3 (s16c167_mbar_le_normalizer_lbar D hV hc h3) hx
  · obtain ⟨x, hx⟩ := bar3 (by rw [h8.2.2]; exact Set.mem_singleton 3)
    exact s16c1614_not_seven_dvd_case168_8 D hV h8 (d7 x hx)
  · obtain ⟨x, hx⟩ := bar7 (by rw [h9.2.2.2.2]; exact Set.mem_singleton 7)
    exact s16c1614_not_five_dvd_case168_9 D hV h9 (d5 x hx)
  · rcases hp with rfl | rfl
    · obtain ⟨x, hx⟩ := bar3 (by rw [h10.2.2.2.1]; exact Set.mem_singleton 3)
      exact s16c1614_not_seven_dvd_case168_10_three D hV h10 (d7 x hx)
    · obtain ⟨x, hx⟩ := bar7 (by rw [h10.2.2.2.1]; exact Set.mem_singleton 7)
      exact s16c1614_not_five_dvd_case168_10_seven D hV h10 (d5 x hx)
  · obtain ⟨x, hx⟩ := bar7 (by rw [h11.2.2.2]; exact Set.mem_singleton 7)
    exact s16c1614_not_five_dvd_case168_11 D hV hc h11 (d5 x hx)

end CFSG.LocalAnalysis.UniquenessCase.PartTwo
