@[expose] def sixChk2G (P A : List Nat) : Bool :=
  (List.range 111).all fun i => (List.range 111).all fun j =>
    i == j || !(A.getD i 0).testBit j ||
      (let a := sixInvTabs.getD i 0
       let b := sixInvTabs.getD j 0
       P.getD i 0 != P.getD j 0 ||
         P.getD j 0 != P.getD (sixIdx (sixTabComp a b)) 0)

theorem sixChk2_eq (K : Bool) : sixChk2 K = sixChk2G (sixInvProf K) sixInvAdj := rfl

@[expose] def sixChk3G (P A : List Nat) : Bool :=
  (List.range 111).all fun i => (List.range 111).all fun j =>
    i == j || !(A.getD i 0).testBit j ||
    (List.range 111).all fun k =>
      k == i || k == j || !(A.getD i 0).testBit k || !(A.getD j 0).testBit k ||
        (let a := sixInvTabs.getD i 0
         let b := sixInvTabs.getD j 0
         let c := sixInvTabs.getD k 0
         sixTabComp a b == c ||
           (let pa := P.getD i 0
            let pb := P.getD j 0
            let pc := P.getD k 0
            let pab := P.getD (sixIdx (sixTabComp a b)) 0
            let pac := P.getD (sixIdx (sixTabComp a c)) 0
            let pbc := P.getD (sixIdx (sixTabComp b c)) 0
            let e := pa &&& pb &&& pc
            (pa &&& pb) != e || (pa &&& pc) != e || (pb &&& pc) != e || (pa &&& pbc) != e ||
              (pb &&& pac) != e || (pc &&& pab) != e || (pab &&& pac) != e))

theorem sixChk3_eq (K : Bool) : sixChk3 K = sixChk3G (sixInvProf K) sixInvAdj := rfl

@[expose] def sixChk4G (A : List Nat) : Bool :=
  (List.range 111).all fun i => (List.range 111).all fun j =>
    i == j || !(A.getD i 0).testBit j ||
    (List.range 111).all fun k =>
      k == i || k == j || !(A.getD i 0).testBit k || !(A.getD j 0).testBit k ||
        (let a := sixInvTabs.getD i 0
         let b := sixInvTabs.getD j 0
         let c := sixInvTabs.getD k 0
         sixTabComp a b == c ||
           (let ab := sixTabComp a b
            let n := (A.getD i 0) &&& (A.getD j 0) &&& (A.getD k 0)
            (List.range 111).all fun l =>
              !n.testBit l ||
                (let d := sixInvTabs.getD l 0
                 d == a || d == b || d == c || d == ab || d == sixTabComp a c ||
                   d == sixTabComp b c || d == sixTabComp ab c)))

theorem sixChk4_eq : sixChk4 = sixChk4G sixInvAdj := rfl

@[expose] def sixChk4Row (A : List Nat) (i : Nat) : Bool :=
  (List.range 111).all fun j =>
    i == j || !(A.getD i 0).testBit j ||
    (List.range 111).all fun k =>
      k == i || k == j || !(A.getD i 0).testBit k || !(A.getD j 0).testBit k ||
        (let a := sixInvTabs.getD i 0
         let b := sixInvTabs.getD j 0
         let c := sixInvTabs.getD k 0
         sixTabComp a b == c ||
           (let ab := sixTabComp a b
            let n := (A.getD i 0) &&& (A.getD j 0) &&& (A.getD k 0)
            (List.range 111).all fun l =>
              !n.testBit l ||
                (let d := sixInvTabs.getD l 0
                 d == a || d == b || d == c || d == ab || d == sixTabComp a c ||
                   d == sixTabComp b c || d == sixTabComp ab c)))

theorem sixChk4G_eq (A : List Nat) : sixChk4G A = (List.range 111).all (sixChk4Row A) := rfl

