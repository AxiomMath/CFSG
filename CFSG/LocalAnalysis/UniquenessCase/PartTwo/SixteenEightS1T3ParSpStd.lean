private def s16t3_spCuts (m : ℕ) : Set ℕ := {c | 2 ≤ c ∧ c ≤ m ∧ Even c}

private def s16t3_spStarts (m : ℕ) : Finset (Fin (m + 1)) :=
  Finset.univ.filter fun a => Even (a : ℕ) ∧ 2 ≤ (a : ℕ)

private def s16t3_spSix (m : ℕ) : Finset (Fin (m + 1)) :=
  s16t3_spStarts m ∪ (if Odd m then {0} else ∅)

private theorem s16t3_spCuts_le {m : ℕ} (hm : 2 ≤ m) : ∀ i ∈ s16t3_spCuts m, i ≤ m :=
  fun _ hi => hi.2.1

private theorem s16t3_spCuts_one {m : ℕ} (hm : 2 ≤ m) : ∀ i ∈ s16t3_spCuts m, 1 ≤ i :=
  fun _ hi => by have := hi.1; omega

private theorem s16t3_sp_t_mem {m : ℕ} (hm : 2 ≤ m) : 2 * (m / 2) ∈ s16t3_spCuts m := by
  refine ⟨?_, ?_, ?_⟩
  · have : 1 ≤ m / 2 := (Nat.le_div_iff_mul_le (by norm_num : 0 < 2)).2 (by omega)
    omega
  · have := Nat.div_mul_le_self m 2
    omega
  · exact ⟨m / 2, by omega⟩

private theorem s16t3_spCuts_max {m : ℕ} (hm : 2 ≤ m) :
    ∀ c ∈ s16t3_spCuts m, c ≤ 2 * (m / 2) := by
  intro c hc
  obtain ⟨h2, hle, hev⟩ := hc
  rcases hev with ⟨k, hk⟩
  subst hk
  have : k ≤ m / 2 := (Nat.le_div_iff_mul_le (by norm_num : 0 < 2)).2 (by omega)
  omega

private theorem s16t3_sp_prev {m j : ℕ} (hj : j ∈ s16t3_spCuts m) :
    spFlagPrev (s16t3_spCuts m) j = j - 2 := by
  apply le_antisymm
  · rcases spFlagPrev_mem (s16t3_spCuts m) j with h0 | hmem
    · omega
    · obtain ⟨h2, hm', hev⟩ := hmem
      rcases hev with ⟨a, ha⟩
      rcases hj.2.2 with ⟨b, hb⟩
      have hp := spFlagPrev_le (s16t3_spCuts m) j
      omega
  · rcases Nat.eq_zero_or_pos (j - 2) with h0 | hpos
    · omega
    · have hmem : j - 2 ∈ s16t3_spCuts m := by
        rcases hj.2.2 with ⟨a, ha⟩
        have ha2 : 2 ≤ a := by omega
        refine ⟨?_, (Nat.sub_le j 2).trans hj.2.1, ⟨a - 1, by omega⟩⟩
        omega
      exact le_spFlagPrev hmem (Nat.sub_lt (by omega) (by norm_num))

private theorem s16t3_spStarts_mem {m : ℕ} (j : Fin (m + 1)) :
    j ∈ s16t3_spStarts m ↔ (j : ℕ) ∈ s16t3_spCuts m := by
  constructor
  · intro hj
    have hj' : Even (j : ℕ) ∧ 2 ≤ (j : ℕ) := by
      simpa [s16t3_spStarts] using hj
    exact ⟨hj'.2, by omega, hj'.1⟩
  · intro hj
    have hj' : 2 ≤ (j : ℕ) ∧ (j : ℕ) ≤ m ∧ Even (j : ℕ) := hj
    simp only [s16t3_spStarts, Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨hj'.2.2, hj'.1⟩

private theorem s16t3_spSix_mem {m : ℕ} (j : Fin (m + 1)) :
    j ∈ s16t3_spSix m ↔ (j : ℕ) ∈ s16t3_spCuts m ∨ ((j : ℕ) = 0 ∧ Odd m) := by
  rw [s16t3_spSix]
  by_cases ho : Odd m
  · simp only [if_pos ho, Finset.mem_union, Finset.mem_singleton, s16t3_spStarts_mem]
    constructor
    · rintro (h | h)
      · exact Or.inl h
      · exact Or.inr ⟨by simpa using congrArg Fin.val h, ho⟩
    · rintro (h | ⟨h0, -⟩)
      · exact Or.inl h
      · exact Or.inr (Fin.ext h0)
  · rw [if_neg ho]
    simp [ho, s16t3_spStarts_mem]

private theorem s16t3_spStarts_card (m : ℕ) : (s16t3_spStarts m).card = m / 2 := by
  classical
  let φ : Fin (m / 2) → Fin (m + 1) := fun i =>
    ⟨2 * (i : ℕ) + 2, by
      have hi : (i : ℕ) < m / 2 := i.isLt
      have hle : 2 * (m / 2) ≤ m := by
        have := Nat.div_mul_le_self m 2
        omega
      have h2 : 2 * (i : ℕ) + 2 ≤ 2 * (m / 2) := by
        have : (i : ℕ) + 1 ≤ m / 2 := by omega
        omega
      omega⟩
  have hφinj : Function.Injective φ := by
    intro i j hij
    apply Fin.ext
    have h : 2 * (i : ℕ) + 2 = 2 * (j : ℕ) + 2 := congrArg Fin.val hij
    omega
  have hS : s16t3_spStarts m = Finset.image φ Finset.univ := by
    ext a
    simp only [s16t3_spStarts, Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.mem_image]
    constructor
    · rintro ⟨hev, h2⟩
      obtain ⟨i, hi⟩ := hev
      have hai : (a : ℕ) < m + 1 := a.isLt
      refine ⟨⟨i - 1, ?_⟩, ?_⟩
      · have hile : i ≤ m / 2 := by
          have h2i : 2 * i ≤ m := by omega
          exact (Nat.le_div_iff_mul_le (by norm_num : 0 < 2)).2 (by omega)
        omega
      · apply Fin.ext
        show 2 * (i - 1) + 2 = (a : ℕ)
        omega
    · rintro ⟨i, rfl⟩
      change Even (2 * (i : ℕ) + 2) ∧ 2 ≤ 2 * (i : ℕ) + 2
      exact ⟨⟨(i : ℕ) + 1, by omega⟩, by omega⟩
  rw [hS, Finset.card_image_of_injective Finset.univ hφinj]
  simp

private theorem s16t3_spSix_card (m : ℕ) : (s16t3_spSix m).card = (m + 1) / 2 := by
  classical
  have hnot : (0 : Fin (m + 1)) ∉ s16t3_spStarts m := by
    rw [s16t3_spStarts_mem]
    intro h
    exact absurd h.1 (by simp)
  by_cases ho : Odd m
  · rw [s16t3_spSix, if_pos ho,
      Finset.card_union_of_disjoint (Finset.disjoint_singleton_right.mpr hnot),
      s16t3_spStarts_card, Finset.card_singleton]
    have hm1 : m + 1 = 2 * (m / 2 + 1) := by
      have := Nat.two_mul_div_two_add_one_of_odd ho
      omega
    rw [hm1]
    exact (Nat.mul_div_right (m / 2 + 1) (by norm_num : 0 < 2)).symm
  · rw [s16t3_spSix, if_neg ho, Finset.union_empty, s16t3_spStarts_card]
    have hev : Even m := Nat.not_odd_iff_even.mp ho
    have hm1 : m + 1 = 1 + 2 * (m / 2) := by
      have := Nat.two_mul_div_two_of_even hev
      omega
    rw [hm1, Nat.add_mul_div_left 1 (m / 2) (by norm_num : 0 < 2)]
    simp

private theorem s16t3_sp_card_gl_le_two {K : Type} [Field K] [Finite K]
    (hK : Nat.card K = 2) {k : ℕ} (hk : k ≤ 2) :
    Nat.card (GL (Fin k) K) = if k = 2 then 6 else 1 := by
  letI := Fintype.ofFinite K
  have hq : Fintype.card K = 2 := by rw [← Nat.card_eq_fintype_card]; exact hK
  rcases (by omega : k = 0 ∨ k = 1 ∨ k = 2) with rfl | rfl | rfl
  · rw [if_neg (by norm_num : ¬ (0 : ℕ) = 2), Matrix.card_GL_field]
    simp
  · rw [if_neg (by norm_num : ¬ (1 : ℕ) = 2), Matrix.card_GL_field, Fin.prod_univ_one]
    norm_num [hq, Fin.val_zero]
  · rw [if_pos rfl, Matrix.card_GL_field, Fin.prod_univ_two]
    norm_num [hq, Fin.val_zero, Fin.val_one]

private theorem s16t3_sp_res_card {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2)
    (m : ℕ) : Nat.card (StatedSp (m - 2 * (m / 2)) K) = if Even m then 1 else 6 := by
  rcases Nat.even_or_odd m with hev | ho
  · have h0 : m - 2 * (m / 2) = 0 := by
      have := Nat.two_mul_div_two_of_even hev
      omega
    rw [h0, SymplecticFlag.card_statedSp, if_pos hev]
    simp
  · have h1 : m - 2 * (m / 2) = 1 := by
      have := Nat.two_mul_div_two_add_one_of_odd ho
      omega
    rw [h1, SymplecticFlag.card_statedSp, hK, if_neg (Nat.not_even_iff_odd.mpr ho)]
    rw [show Finset.Icc 1 1 = {1} by decide, Finset.prod_singleton]
    norm_num

private theorem s16t3_sp_block_card {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2)
    (m : ℕ) (hm : 2 ≤ m) (j : Fin (m + 1)) :
    Nat.card ↥(spFlagLeviCoordBlock (K := K) (s16t3_spCuts_le hm) (2 * (m / 2)) j) =
      if j ∈ s16t3_spSix m then 6 else 1 := by
  classical
  by_cases hj0 : (j : ℕ) = 0
  · rw [spFlagLeviCoordBlock_of_eq_zero (s16t3_spCuts_le hm) (2 * (m / 2)) hj0]
    rw [← Nat.card_congr (MonoidHom.ofInjective
      (f := spFlagResEmb (r := m) (K := K) (2 * (m / 2)))
      (spFlagResEmb_injective _)).toEquiv]
    rw [s16t3_sp_res_card hK m]
    have hsix : (j ∈ s16t3_spSix m) ↔ Odd m := by
      rw [s16t3_spSix_mem j]
      constructor
      · rintro (hI | ⟨-, ho⟩)
        · exact absurd hI.1 (by omega)
        · exact ho
      · exact fun ho => Or.inr ⟨hj0, ho⟩
    by_cases ho : Odd m
    · rw [if_neg (Nat.not_even_iff_odd.mpr ho), if_pos (hsix.mpr ho)]
    · rw [if_pos (Nat.not_odd_iff_even.mp ho), if_neg (fun h => ho (hsix.mp h))]
  · by_cases hjI : (j : ℕ) ∈ s16t3_spCuts m
    · rw [spFlagLeviCoordBlock_of_mem (s16t3_spCuts_le hm) (2 * (m / 2)) hj0 hjI]
      have hprev : spFlagPrev (s16t3_spCuts m) j = (j : ℕ) - 2 := s16t3_sp_prev hjI
      have hk : (j : ℕ) - spFlagPrev (s16t3_spCuts m) j = 2 := by
        rw [hprev]
        have := hjI.1
        omega
      rw [← Nat.card_congr (MonoidHom.ofInjective
        (f := spFlagCutEmb (spFlagPrev (s16t3_spCuts m) j) (j : ℕ)
          (s16t3_spCuts_le hm j hjI)) (spFlagCutEmb_injective _ _ _)).toEquiv, hk]
      have hgl := s16t3_sp_card_gl_le_two hK (show (2 : ℕ) ≤ 2 by norm_num)
      rw [if_pos ((s16t3_spSix_mem j).mpr (Or.inl hjI))]
      simpa using hgl
    · rw [spFlagLeviCoordBlock_of_not_mem (s16t3_spCuts_le hm) (2 * (m / 2)) hj0 hjI,
        Subgroup.card_bot]
      rw [if_neg (fun h => by
        rcases (s16t3_spSix_mem j).mp h with h' | ⟨h0, -⟩
        · exact hjI h'
        · exact hj0 h0)]

private theorem s16t3_sp_exp_of_card {G : Type*} [Group G] [Finite G]
    (hcard : Nat.card G ∣ 6) (g : G) {k : ℕ} (hg : g ^ 3 ^ k = 1) : g ^ 3 = 1 := by
  have h6 : g ^ 6 = 1 := by
    obtain ⟨c, hc⟩ := hcard
    rw [hc, pow_mul]
    have h := pow_card_eq_one' (x := g)
    rw [h, one_pow]
  rw [← orderOf_dvd_iff_pow_eq_one]
  obtain ⟨i, -, hoi⟩ := (Nat.dvd_prime_pow Nat.prime_three).1
    (orderOf_dvd_of_pow_eq_one hg)
  have hdvd6 : 3 ^ i ∣ 6 := by
    rw [← hoi]
    exact orderOf_dvd_of_pow_eq_one h6
  have hi1 : i ≤ 1 := by
    by_contra hi
    have hle : 3 ^ 2 ≤ 3 ^ i := Nat.pow_le_pow_right (by norm_num) (by omega)
    have hle6 : 3 ^ i ≤ 6 := Nat.le_of_dvd (by norm_num) hdvd6
    norm_num at hle
    omega
  rw [hoi]
  exact pow_dvd_pow 3 hi1

private theorem s16t3_sp_block_prod {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2)
    (m : ℕ) (hm : 2 ≤ m) :
    Nat.card (∀ j : Fin (m + 1),
      ↥(spFlagLeviCoordBlock (K := K) (s16t3_spCuts_le hm) (2 * (m / 2)) j)) =
      2 ^ ((m + 1) / 2) * 3 ^ ((m + 1) / 2) := by
  rw [Nat.card_pi]
  calc ∏ j : Fin (m + 1),
        Nat.card ↥(spFlagLeviCoordBlock (K := K) (s16t3_spCuts_le hm) (2 * (m / 2)) j)
      = ∏ j : Fin (m + 1), (if j ∈ s16t3_spSix m then 6 else 1) :=
        Finset.prod_congr rfl fun j _ => s16t3_sp_block_card hK m hm j
    _ = ∏ j ∈ s16t3_spSix m, (6 : ℕ) := Fintype.prod_ite_mem _ _
    _ = 6 ^ (s16t3_spSix m).card := Finset.prod_const 6
    _ = 6 ^ ((m + 1) / 2) := by rw [s16t3_spSix_card]
    _ = 2 ^ ((m + 1) / 2) * 3 ^ ((m + 1) / 2) := by
        rw [show (6 : ℕ) = 2 * 3 by norm_num, mul_pow]

private theorem s16t3_spRange_card {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2)
    (m : ℕ) (hm : 2 ≤ m) :
    Nat.card ↥(spFlagLeviHom (K := K) (s16t3_spCuts_le hm) (s16t3_sp_t_mem hm)).range =
      2 ^ ((m + 1) / 2) * 3 ^ ((m + 1) / 2) := by
  have hrange := range_spFlagLeviHom (K := K) (s16t3_spCuts_le hm) (s16t3_sp_t_mem hm)
    (s16t3_spCuts_max hm)
  rw [hrange, Nat.card_congr (piSubgroupEquiv (spFlagLeviCoordBlock (K := K)
    (s16t3_spCuts_le hm) (2 * (m / 2)))).toEquiv]
  exact s16t3_sp_block_prod hK m hm

private theorem s16t3_sp_levi_exp {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2)
    (m : ℕ) (hm : 2 ≤ m) :
    ∀ h : ∀ j : Fin (m + 1),
      ↥(spFlagLeviCoordBlock (K := K) (s16t3_spCuts_le hm) (2 * (m / 2)) j),
      ∀ k : ℕ, h ^ 3 ^ k = 1 → h ^ 3 = 1 := by
  intro h k hh
  funext j
  change (h j) ^ 3 = 1
  refine s16t3_sp_exp_of_card ?_ (h j) (by simpa using congrFun hh j)
  rw [s16t3_sp_block_card hK m hm j]
  by_cases hsix : j ∈ s16t3_spSix m <;> simp [hsix]

private theorem s16t3_spRange_exp {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2)
    (m : ℕ) (hm : 2 ≤ m) :
    ∀ h : ↥(spFlagLeviHom (K := K) (s16t3_spCuts_le hm) (s16t3_sp_t_mem hm)).range,
      ∀ k : ℕ, h ^ 3 ^ k = 1 → h ^ 3 = 1 := by
  intro h k hh
  let e : ↥(spFlagLeviHom (K := K) (s16t3_spCuts_le hm) (s16t3_sp_t_mem hm)).range ≃*
      (∀ j : Fin (m + 1),
        ↥(spFlagLeviCoordBlock (K := K) (s16t3_spCuts_le hm) (2 * (m / 2)) j)) :=
    (MulEquiv.subgroupCongr (range_spFlagLeviHom (K := K) (s16t3_spCuts_le hm)
      (s16t3_sp_t_mem hm) (s16t3_spCuts_max hm))).trans
      (piSubgroupEquiv (spFlagLeviCoordBlock (K := K) (s16t3_spCuts_le hm) (2 * (m / 2))))
  have hh' : (e h) ^ 3 ^ k = 1 := by rw [← map_pow, hh, map_one]
  have h3 : (e h) ^ 3 = 1 := s16t3_sp_levi_exp hK m hm (e h) k hh'
  refine e.injective ?_
  rw [map_pow, h3, map_one]

theorem s16t3_sp_std {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2) {m : ℕ}
    (hm : 2 ≤ m) :
    ∃ Y P : Subgroup (Matrix.GeneralLinearGroup (Fin m ⊕ Fin m) K),
      CFSG.ABGLocalTools.IsSylowOf 2 Y (StatedSp m K) ∧ Y ≤ P ∧ P ≤ StatedSp m K ∧
      Nat.card ↥P = 3 ^ ((m + 1) / 2) * 2 ^ (Nat.card ↥(StatedSp m K)).factorization 2 ∧
      ∀ p ∈ P, ∀ k : ℕ, p ^ 3 ^ k = 1 → p ^ 3 = 1 := by
  classical
  haveI : Fintype K := Fintype.ofFinite K
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : CharP K 2 := charP_of_card_eq_prime (p := 2) (by
    rw [← Nat.card_eq_fintype_card]; exact hK)
  obtain ⟨S, hS⟩ := SymplecticFlag.exists_sylow_unipotent (K := K) 2 m
  let Q : Subgroup ↥(StatedSp m K) := SymplecticHigher.flagStabilizer m K (s16t3_spCuts m)
  let P : Subgroup (Matrix.GeneralLinearGroup (Fin m ⊕ Fin m) K) :=
    Q.map (StatedSp m K).subtype
  let Y : Subgroup (Matrix.GeneralLinearGroup (Fin m ⊕ Fin m) K) :=
    (SymplecticFlag.unipotent m K).map (StatedSp m K).subtype
  have hYeq : (S : Subgroup ↥(StatedSp m K)).map (StatedSp m K).subtype = Y := by
    have := congrArg (fun H : Subgroup ↥(StatedSp m K) =>
      H.map (StatedSp m K).subtype) hS
    simpa [Y] using this
  have hY : CFSG.ABGLocalTools.IsSylowOf 2 Y (StatedSp m K) := ⟨S, hYeq⟩
  have hYP : Y ≤ P := by
    change (SymplecticFlag.unipotent m K).map (StatedSp m K).subtype ≤
      (SymplecticHigher.flagStabilizer m K (s16t3_spCuts m)).map (StatedSp m K).subtype
    exact Subgroup.map_mono (SymplecticFlag.unipotent_le_borelSubgroup.trans
      (SymplecticHigher.borelSubgroup_le_flagStabilizer (I := s16t3_spCuts m)
        (s16t3_spCuts_le hm)))
  have hPle : P ≤ StatedSp m K := by
    change (SymplecticHigher.flagStabilizer m K (s16t3_spCuts m)).map
      (StatedSp m K).subtype ≤ StatedSp m K
    exact Subgroup.map_subtype_le _
  let β₀ : ↥Q →* (Fin (m + 1) → StatedSp m K) :=
    spFlagLeviHom (K := K) (s16t3_spCuts_le hm) (s16t3_sp_t_mem hm)
  let eQ : ↥Q ≃* ↥P :=
    Subgroup.equivMapOfInjective Q (StatedSp m K).subtype (StatedSp m K).subtype_injective
  let β : ↥P →* ↥(β₀.range) := (β₀.rangeRestrict).comp eQ.symm.toMonoidHom
  have hβ : Function.Surjective β := by
    intro y
    obtain ⟨x, hx⟩ := β₀.rangeRestrict_surjective y
    refine ⟨eQ x, ?_⟩
    change β₀.rangeRestrict (eQ.symm (eQ x)) = y
    rw [MulEquiv.symm_apply_apply]
    exact hx
  have hker : IsPGroup 2 β.ker := by
    have hker₀ : IsPGroup 2 β₀.ker :=
      isPGroup_ker_spFlagLeviHom (K := K) (s16t3_spCuts_le hm) (s16t3_sp_t_mem hm)
        (s16t3_spCuts_one hm)
    have h : β.ker = β₀.ker.comap eQ.symm.toMonoidHom := by
      change ((β₀.rangeRestrict).comp eQ.symm.toMonoidHom).ker =
        β₀.ker.comap eQ.symm.toMonoidHom
      rw [← MonoidHom.comap_ker (g := β₀.rangeRestrict) (f := eQ.symm.toMonoidHom),
        MonoidHom.ker_rangeRestrict]
    rw [h]
    exact hker₀.comap_of_injective eQ.symm.toMonoidHom eQ.symm.injective
  have hcardP := s16t3_card_of_surjective_isPGroup_ker
    (E := Matrix.GeneralLinearGroup (Fin m ⊕ Fin m) K) (G := StatedSp m K) (P := P) (Y := Y)
    (x := (m + 1) / 2) (a := (m + 1) / 2) hPle hY hYP β hβ hker (s16t3_spRange_card hK m hm)
  have hexp : ∀ p : ↥P, ∀ k : ℕ, p ^ 3 ^ k = 1 → p ^ 3 = 1 :=
    s16t3_pow_three_of_isPGroup_ker β hker (s16t3_spRange_exp hK m hm)
  refine ⟨Y, P, hY, hYP, hPle, hcardP, ?_⟩
  intro p hp k hpk
  have h := hexp ⟨p, hp⟩ k (Subtype.ext (by simpa using hpk))
  simpa using congrArg Subtype.val h

end CFSG.LocalAnalysis.UniquenessCase.PartTwo
