variable {K : Type*} [Field K] {n : ℕ}

private def s16t3_rotv (p q : Fin n) : (Fin n → K) →ₗ[K] (Fin n → K) where
  toFun x := fun i => if i = p then x q else if i = q then x p + x q else x i
  map_add' x y := by
    funext i
    simp only [Pi.add_apply]
    split_ifs <;> ring
  map_smul' c x := by
    funext i
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    split_ifs <;> ring

private lemma s16t3_rotv_apply (p q : Fin n) (x : Fin n → K) (i : Fin n) :
    s16t3_rotv p q x i =
      if i = p then x q else if i = q then x p + x q else x i := rfl

private lemma s16t3_rotv_apply_p (p q : Fin n) (x : Fin n → K) :
    s16t3_rotv p q x p = x q := by
  rw [s16t3_rotv_apply, if_pos rfl]

private lemma s16t3_rotv_apply_q {p q : Fin n} (hpq : p ≠ q) (x : Fin n → K) :
    s16t3_rotv p q x q = x p + x q := by
  rw [s16t3_rotv_apply, if_neg (Ne.symm hpq), if_pos rfl]

private lemma s16t3_rotv_apply_of_ne {p q : Fin n} {i : Fin n} (hip : i ≠ p) (hiq : i ≠ q)
    (x : Fin n → K) : s16t3_rotv p q x i = x i := by
  rw [s16t3_rotv_apply, if_neg hip, if_neg hiq]

private def s16t3_basis (i : Fin n) : Fin n → K := Pi.single i (1 : K)

private lemma s16t3_basis_apply (i : Fin n) : s16t3_basis i = Pi.single i (1 : K) := rfl

private lemma s16t3_rotv_eq_self {p q : Fin n} (hpq : p ≠ q) {y : Fin n → K}
    (hp : y p = 0) (hq : y q = 0) : s16t3_rotv p q y = y := by
  funext i
  rw [s16t3_rotv_apply]
  by_cases hip : i = p
  · rw [hip, if_pos rfl, hp, hq]
  · rw [if_neg hip]
    by_cases hiq : i = q
    · rw [hiq, if_pos rfl, hp, hq, zero_add]
    · rw [if_neg hiq]

private lemma s16t3_rotv_cube {p q : Fin n} (hpq : p ≠ q) (h2 : (2 : K) = 0)
    (x : Fin n → K) :
    s16t3_rotv p q (s16t3_rotv p q (s16t3_rotv p q x)) = x := by
  have hself : ∀ a : K, a + a = 0 := fun a => by rw [← two_mul a, h2, zero_mul]
  funext i
  by_cases hip : i = p
  · rw [hip]
    simp only [s16t3_rotv_apply_p, s16t3_rotv_apply_q hpq]
    rw [show x q + (x p + x q) = x p + (x q + x q) by ring, hself (x q)]
    ring
  · by_cases hiq : i = q
    · rw [hiq]
      simp only [s16t3_rotv_apply_p, s16t3_rotv_apply_q hpq]
      rw [show (x p + x q) + (x q + (x p + x q)) = x q + (x q + x q) + (x p + x p) by
        ring, hself (x q), hself (x p)]
      ring
    · simp only [s16t3_rotv_apply_of_ne hip hiq]

private lemma s16t3_rotv_commute {a b c d : Fin n} (hab : a ≠ b) (hcd : c ≠ d)
    (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (x : Fin n → K) :
    s16t3_rotv a b (s16t3_rotv c d x) = s16t3_rotv c d (s16t3_rotv a b x) := by
  funext i
  by_cases hia : i = a
  · rw [hia]
    simp [s16t3_rotv_apply, hab, hcd, hac, had, hbc, hbd,
      hab.symm, hcd.symm, hac.symm, had.symm, hbc.symm, hbd.symm]
  · by_cases hib : i = b
    · rw [hib]
      simp [s16t3_rotv_apply, hab, hcd, hac, had, hbc, hbd,
        hab.symm, hcd.symm, hac.symm, had.symm, hbc.symm, hbd.symm]
    · by_cases hic : i = c
      · rw [hic]
        simp [s16t3_rotv_apply, hab, hcd, hac, had, hbc, hbd,
          hab.symm, hcd.symm, hac.symm, had.symm, hbc.symm, hbd.symm]
      · by_cases hid : i = d
        · rw [hid]
          simp [s16t3_rotv_apply, hab, hcd, hac, had, hbc, hbd,
            hab.symm, hcd.symm, hac.symm, had.symm, hbc.symm, hbd.symm]
        · simp [s16t3_rotv_apply, hia, hib, hic, hid]

private noncomputable def s16t3_rotvMat (p q : Fin n) : Matrix (Fin n) (Fin n) K :=
  LinearMap.toMatrix' (s16t3_rotv p q)

private lemma s16t3_rotvMat_mulVec (p q : Fin n) (x : Fin n → K) :
    (s16t3_rotvMat p q : Matrix (Fin n) (Fin n) K) *ᵥ x = s16t3_rotv p q x :=
  LinearMap.toMatrix'_mulVec _ _

private lemma s16t3_rotvMat_pow_three {p q : Fin n} (hpq : p ≠ q) (h2 : (2 : K) = 0) :
    (s16t3_rotvMat p q : Matrix (Fin n) (Fin n) K) ^ 3 = 1 := by
  rw [show (s16t3_rotvMat p q : Matrix (Fin n) (Fin n) K) ^ 3 =
      (s16t3_rotvMat p q : Matrix (Fin n) (Fin n) K) *
        (s16t3_rotvMat p q : Matrix (Fin n) (Fin n) K) *
        (s16t3_rotvMat p q : Matrix (Fin n) (Fin n) K) by
    rw [pow_succ, pow_succ, pow_one]]
  rw [Matrix.ext_iff_mulVec]
  intro x
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, s16t3_rotvMat_mulVec,
    s16t3_rotvMat_mulVec, s16t3_rotvMat_mulVec, s16t3_rotv_cube hpq h2,
    Matrix.one_mulVec]

private noncomputable def s16t3_rotvGL {p q : Fin n} (hpq : p ≠ q) (h2 : (2 : K) = 0) :
    Matrix.GeneralLinearGroup (Fin n) K :=
  ⟨s16t3_rotvMat p q, s16t3_rotvMat p q * s16t3_rotvMat p q,
    by rw [← pow_two, ← pow_succ']; exact s16t3_rotvMat_pow_three hpq h2,
    by rw [← pow_two, ← pow_succ]; exact s16t3_rotvMat_pow_three hpq h2⟩

private lemma s16t3_rotvGL_mulVec {p q : Fin n} (hpq : p ≠ q) (h2 : (2 : K) = 0)
    (x : Fin n → K) :
    ((s16t3_rotvGL hpq h2 : Matrix.GeneralLinearGroup (Fin n) K) :
        Matrix (Fin n) (Fin n) K) *ᵥ x = s16t3_rotv p q x := by
  change (s16t3_rotvMat p q : Matrix (Fin n) (Fin n) K) *ᵥ x = s16t3_rotv p q x
  rw [s16t3_rotvMat_mulVec]

private lemma s16t3_rotvGL_pow_three {p q : Fin n} (hpq : p ≠ q) (h2 : (2 : K) = 0) :
    s16t3_rotvGL hpq h2 ^ 3 = 1 := by
  apply Units.ext
  change (s16t3_rotvMat p q : Matrix (Fin n) (Fin n) K) ^ 3 = 1
  exact s16t3_rotvMat_pow_three hpq h2

private lemma s16t3_rotvGL_commute {a b c d : Fin n} (hab : a ≠ b) (hcd : c ≠ d)
    (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (h2 : (2 : K) = 0) :
    s16t3_rotvGL hab h2 * s16t3_rotvGL hcd h2 =
      s16t3_rotvGL hcd h2 * s16t3_rotvGL hab h2 := by
  apply Units.ext
  rw [Matrix.ext_iff_mulVec]
  intro x
  change ((s16t3_rotvMat a b : Matrix (Fin n) (Fin n) K) *
      (s16t3_rotvMat c d : Matrix (Fin n) (Fin n) K)) *ᵥ x =
    ((s16t3_rotvMat c d : Matrix (Fin n) (Fin n) K) *
      (s16t3_rotvMat a b : Matrix (Fin n) (Fin n) K)) *ᵥ x
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, s16t3_rotvMat_mulVec,
    s16t3_rotvMat_mulVec, s16t3_rotvMat_mulVec, s16t3_rotvMat_mulVec]
  exact s16t3_rotv_commute hab hcd hac had hbc hbd x

private lemma s16t3_rotvGL_mulVec_single {p q i : Fin n} (hpq : p ≠ q) (h2 : (2 : K) = 0)
    (hip : i ≠ p) (hiq : i ≠ q) (c : K) :
    ((s16t3_rotvGL hpq h2 : Matrix.GeneralLinearGroup (Fin n) K) :
        Matrix (Fin n) (Fin n) K) *ᵥ Pi.single i c = Pi.single i c := by
  rw [s16t3_rotvGL_mulVec]
  exact s16t3_rotv_eq_self hpq (by rw [Pi.single_eq_of_ne' hip])
    (by rw [Pi.single_eq_of_ne' hiq])

private lemma s16t3_rotvGL_mulVec_single_p {p q : Fin n} (hpq : p ≠ q) (h2 : (2 : K) = 0) :
    ((s16t3_rotvGL hpq h2 : Matrix.GeneralLinearGroup (Fin n) K) :
        Matrix (Fin n) (Fin n) K) *ᵥ Pi.single p (1 : K) = Pi.single q (1 : K) := by
  rw [s16t3_rotvGL_mulVec]
  funext j
  rw [s16t3_rotv_apply]
  by_cases hjp : j = p
  · rw [hjp, if_pos rfl, Pi.single_eq_of_ne' hpq, Pi.single_eq_of_ne' hpq.symm]
  · rw [if_neg hjp]
    by_cases hjq : j = q
    · rw [hjq, if_pos rfl, Pi.single_eq_of_ne' hpq, Pi.single_eq_same, add_zero,
        Pi.single_eq_same]
    · rw [if_neg hjq, Pi.single_eq_of_ne hjp, Pi.single_eq_of_ne hjq]

private lemma s16t3_rotvGL_ne_one {p q : Fin n} (hpq : p ≠ q) (h2 : (2 : K) = 0) :
    s16t3_rotvGL hpq h2 ≠ 1 := by
  intro h
  have hh : ((s16t3_rotvGL hpq h2 : Matrix.GeneralLinearGroup (Fin n) K) :
      Matrix (Fin n) (Fin n) K) *ᵥ (Pi.single q (1 : K) : Fin n → K) =
      ((1 : Matrix.GeneralLinearGroup (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ
        (Pi.single q (1 : K) : Fin n → K) := by rw [h]
  have hcontra := congrFun hh p
  rw [s16t3_rotvGL_mulVec, s16t3_rotv_apply_p] at hcontra
  have hR : ((↑(1 : Matrix.GeneralLinearGroup (Fin n) K) :
      Matrix (Fin n) (Fin n) K) *ᵥ (Pi.single q (1 : K) : Fin n → K)) p = 0 := by
    rw [Units.val_one, Matrix.one_mulVec, Pi.single_eq_of_ne' hpq.symm]
  rw [hR, Pi.single_eq_same] at hcontra
  exact one_ne_zero hcontra

theorem s16t3_good_nat_sl {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2) {n : ℕ}
    (hn : 5 ≤ n) (x : Fin n → K) :
    ∃ F : Subgroup ↥(StatedSL n K), IsPGroup 3 ↥F ∧ ¬ IsCyclic ↥F ∧
      ∀ γ ∈ F, ((γ : Matrix.GeneralLinearGroup (Fin n) K) : Matrix (Fin n) (Fin n) K).mulVec x =
        x := by
  classical
  letI : Fintype K := Fintype.ofFinite K
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : CharP K 2 :=
    charP_of_card_eq_prime (p := 2) (by rw [← Nat.card_eq_fintype_card]; exact hK)
  have h2 : (2 : K) = 0 := CharP.cast_eq_zero K 2
  let i0 : Fin n := ⟨0, by omega⟩
  let i1 : Fin n := ⟨1, by omega⟩
  let i2 : Fin n := ⟨2, by omega⟩
  let i3 : Fin n := ⟨3, by omega⟩
  let i4 : Fin n := ⟨4, by omega⟩
  have h01 : i0 ≠ i1 := fun h => by have := congrArg Fin.val h; simp [i0, i1] at this
  have h02 : i0 ≠ i2 := fun h => by have := congrArg Fin.val h; simp [i0, i2] at this
  have h03 : i0 ≠ i3 := fun h => by have := congrArg Fin.val h; simp [i0, i3] at this
  have h04 : i0 ≠ i4 := fun h => by have := congrArg Fin.val h; simp [i0, i4] at this
  have h12 : i1 ≠ i2 := fun h => by have := congrArg Fin.val h; simp [i1, i2] at this
  have h13 : i1 ≠ i3 := fun h => by have := congrArg Fin.val h; simp [i1, i3] at this
  have h14 : i1 ≠ i4 := fun h => by have := congrArg Fin.val h; simp [i1, i4] at this
  have h23 : i2 ≠ i3 := fun h => by have := congrArg Fin.val h; simp [i2, i3] at this
  have h24 : i2 ≠ i4 := fun h => by have := congrArg Fin.val h; simp [i2, i4] at this
  have h34 : i3 ≠ i4 := fun h => by have := congrArg Fin.val h; simp [i3, i4] at this
  let u : Matrix.GeneralLinearGroup (Fin n) K := s16t3_rotvGL h12 h2
  let w : Matrix.GeneralLinearGroup (Fin n) K := s16t3_rotvGL h34 h2
  let F₀ : Subgroup (Matrix.GeneralLinearGroup (Fin n) K) :=
    Subgroup.closure ({u, w} : Set (Matrix.GeneralLinearGroup (Fin n) K))
  have hu3 : u ^ 3 = 1 := s16t3_rotvGL_pow_three h12 h2
  have hw3 : w ^ 3 = 1 := s16t3_rotvGL_pow_three h34 h2
  have hcomm : u * w = w * u := s16t3_rotvGL_commute h12 h34 h13 h14 h23 h24 h2
  have hu1 : u ≠ 1 := s16t3_rotvGL_ne_one h12 h2
  have hw1 : w ≠ 1 := s16t3_rotvGL_ne_one h34 h2
  have hu_fix3 : ((u : Matrix.GeneralLinearGroup (Fin n) K) :
      Matrix (Fin n) (Fin n) K) *ᵥ s16t3_basis i3 = s16t3_basis i3 :=
    s16t3_rotvGL_mulVec_single h12 h2 h13.symm h23.symm 1
  have hw_i3 : ((w : Matrix.GeneralLinearGroup (Fin n) K) :
      Matrix (Fin n) (Fin n) K) *ᵥ s16t3_basis i3 = s16t3_basis i4 :=
    s16t3_rotvGL_mulVec_single_p h34 h2
  have hu2_fix3 : ((u ^ 2 : Matrix.GeneralLinearGroup (Fin n) K) :
      Matrix (Fin n) (Fin n) K) *ᵥ s16t3_basis i3 = s16t3_basis i3 := by
    rw [pow_two, Units.val_mul, ← Matrix.mulVec_mulVec, hu_fix3, hu_fix3]
  have hwu : w ≠ u := by
    intro h
    have h' : ((w : Matrix.GeneralLinearGroup (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ
        s16t3_basis i3 = ((u : Matrix.GeneralLinearGroup (Fin n) K) :
          Matrix (Fin n) (Fin n) K) *ᵥ s16t3_basis i3 := by rw [h]
    rw [hw_i3, hu_fix3] at h'
    have hc := congrFun h' i3
    simp [s16t3_basis_apply, Pi.single_eq_same, Pi.single_eq_of_ne' h34.symm] at hc
  have hwu2 : w ≠ u ^ 2 := by
    intro h
    have h' : ((w : Matrix.GeneralLinearGroup (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ
        s16t3_basis i3 = ((u ^ 2 : Matrix.GeneralLinearGroup (Fin n) K) :
          Matrix (Fin n) (Fin n) K) *ᵥ s16t3_basis i3 := by rw [h]
    rw [hw_i3, hu2_fix3] at h'
    have hc := congrFun h' i3
    simp [s16t3_basis_apply, Pi.single_eq_same, Pi.single_eq_of_ne' h34.symm] at hc
  have hpair := s16c1g_closure_pair (G := Matrix.GeneralLinearGroup (Fin n) K)
    (a := u) (b := w) hu3 hw3 hcomm hu1 hw1 hwu hwu2
  have hpg : IsPGroup 3 ↥F₀ := hpair.1
  have hnc : ¬ IsCyclic ↥F₀ := hpair.2
  have hSL : StatedSL n K = ⊤ := CFSG.Open.StatedAPI.statedSL_eq_top_of_card_two hK n
  have hF₀ : F₀ ≤ StatedSL n K := by rw [hSL]; exact le_top
  have hu_e0 : ((u : Matrix.GeneralLinearGroup (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ
      s16t3_basis i0 = s16t3_basis i0 := s16t3_rotvGL_mulVec_single h12 h2 h01 h02 1
  have hw_e0 : ((w : Matrix.GeneralLinearGroup (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ
      s16t3_basis i0 = s16t3_basis i0 := s16t3_rotvGL_mulVec_single h34 h2 h03 h04 1
  have hfix₀ : ∀ f ∈ F₀, ((f : Matrix.GeneralLinearGroup (Fin n) K) :
      Matrix (Fin n) (Fin n) K) *ᵥ s16t3_basis i0 = s16t3_basis i0 := by
    let S : Subgroup (Matrix.GeneralLinearGroup (Fin n) K) :=
      { carrier := {g | ((g : Matrix.GeneralLinearGroup (Fin n) K) :
            Matrix (Fin n) (Fin n) K) *ᵥ s16t3_basis i0 = s16t3_basis i0}
        mul_mem' := by
          intro p q hp hq
          show ((p * q : Matrix.GeneralLinearGroup (Fin n) K) :
            Matrix (Fin n) (Fin n) K) *ᵥ s16t3_basis i0 = s16t3_basis i0
          rw [Units.val_mul, ← Matrix.mulVec_mulVec, hq, hp]
        one_mem' := by
          show ((1 : Matrix.GeneralLinearGroup (Fin n) K) :
            Matrix (Fin n) (Fin n) K) *ᵥ s16t3_basis i0 = s16t3_basis i0
          simp
        inv_mem' := by
          intro p hp
          show ((p⁻¹ : Matrix.GeneralLinearGroup (Fin n) K) :
            Matrix (Fin n) (Fin n) K) *ᵥ s16t3_basis i0 = s16t3_basis i0
          rw [← hp, Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one,
            Matrix.one_mulVec]
          exact hp.symm }
    have hle : F₀ ≤ S := by
      change Subgroup.closure ({u, w} : Set (Matrix.GeneralLinearGroup (Fin n) K)) ≤ S
      rw [Subgroup.closure_le]
      intro g hg
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
      rcases hg with rfl | rfl
      · exact hu_e0
      · exact hw_e0
    intro f hf
    exact hle hf
  by_cases hx : x = 0
  · subst hx
    refine s16t3_good_conj (H := StatedSL n K) (F₀ := F₀) hF₀ hpg hnc
      (x₀ := (0 : Fin n → K)) (fun f _ => by simp) (g := 1) ?_ ?_
    · rw [hSL]; exact Subgroup.mem_top 1
    · simp
  · obtain ⟨a, hxa⟩ := Function.ne_iff.mp hx
    let P : Matrix.GeneralLinearGroup (Fin n) K :=
      CFSG.AGLEmbeddingD2.McLaughlin.WeakBlockModuleData.permGL (Equiv.swap i0 a)
    have hP : ((P : Matrix.GeneralLinearGroup (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ
        s16t3_basis i0 = s16t3_basis a := by
      change ((CFSG.AGLEmbeddingD2.McLaughlin.WeakBlockModuleData.permGL (Equiv.swap i0 a) :
          Matrix.GeneralLinearGroup (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ
        Pi.single i0 (1 : K) = Pi.single a (1 : K)
      rw [CFSG.AGLEmbeddingD2.McLaughlin.WeakBlockModuleData.permGL_mulVec]
      funext i
      rw [Function.comp_apply,
        show (Equiv.swap i0 a)⁻¹ = Equiv.swap i0 a from Equiv.symm_swap i0 a]
      by_cases hia : i = a
      · subst hia
        simp
      · by_cases hi0 : i = i0
        · subst hi0
          simp [Pi.single_eq_of_ne' hia, Pi.single_eq_of_ne hia]
        · rw [Equiv.swap_apply_of_ne_of_ne hi0 hia]
          simp [hi0, hia]
    let C : Matrix.GeneralLinearGroup (Fin n) K :=
      CFSG.AGLEmbeddingD2.McLaughlin.WeakBlockModuleData.colUnit a x hxa
    have hC : ((C : Matrix.GeneralLinearGroup (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ
        s16t3_basis a = x := by
      change ((CFSG.AGLEmbeddingD2.McLaughlin.WeakBlockModuleData.colUnit a x hxa :
          Matrix.GeneralLinearGroup (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ
        Pi.single a (1 : K) = x
      rw [CFSG.AGLEmbeddingD2.McLaughlin.WeakBlockModuleData.colUnit_mulVec]
    have hgx : ((C * P : Matrix.GeneralLinearGroup (Fin n) K) :
        Matrix (Fin n) (Fin n) K) *ᵥ s16t3_basis i0 = x := by
      rw [Units.val_mul, ← Matrix.mulVec_mulVec, hP, hC]
    exact s16t3_good_conj (H := StatedSL n K) (F₀ := F₀) hF₀ hpg hnc
      (x₀ := s16t3_basis i0) hfix₀ (g := C * P)
      (by rw [hSL]; exact Subgroup.mem_top _) hgx



theorem s16t3_model_perfect_sl_four (m : Multiplicative (Fin 4 → ZMod 2)) :
    ∃ F : Subgroup ↥(StatedSL 4 (ZMod 2)), Group.IsPerfect ↥F ∧
      3 ∣ Nat.card ↥F ∧
      ∀ γ ∈ F, CFSG.Quasithin.natAct (StatedSL 4 (ZMod 2)) γ m = m := by
  classical
  let v : Fin 4 → ZMod 2 := Multiplicative.toAdd m
  by_cases hv : v = 0
  · refine ⟨⊤, ?_, ?_, ?_⟩
    · exact Group.IsPerfect.top_iff.mpr
        (CFSG.Open.StatedAPI.isPerfect_statedSL_of_three_le (n := 4) (by norm_num) (ZMod 2))
    · rw [Subgroup.card_top]
      rw [show Nat.card ↥(StatedSL 4 (ZMod 2)) = 20160 from by
        rw [CFSG.Open.StatedAPI.card_statedSL,
          CFSG.Quasithin.Vol2.Ch10.SecC.C10P4F.card_SL_four_two]]
      norm_num
    · intro γ _
      have hm : m = 1 := by
        apply Multiplicative.toAdd.injective
        rw [toAdd_one]
        exact hv
      rw [hm]
      simp only [CFSG.Quasithin.natAct, toAdd_one, Matrix.mulVec_zero, ofAdd_zero]
  · let S := CFSG.Quasithin.Vol2.Ch10.SecC.C10P4F.stabV v
    have hSperf : Group.IsPerfect ↥S :=
      Subgroup.isPerfect_iff.mpr
        (CFSG.ClassicalGroups.SpecialLinear.commutator_stabilizer_eq (by norm_num) hv)
    let e := CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 4 (ZMod 2)
    let F : Subgroup ↥(StatedSL 4 (ZMod 2)) := S.map e.toMonoidHom
    have he : ↥S ≃* ↥F := Subgroup.equivMapOfInjective S e.toMonoidHom e.injective
    have hFperf : Group.IsPerfect ↥F :=
      Group.IsPerfect.ofSurjective (f := he.toMonoidHom) he.surjective
    have hFcard : Nat.card ↥F = 1344 := by
      rw [← Nat.card_congr he.toEquiv]
      exact CFSG.Quasithin.Vol2.Ch10.SecC.C10P4F.card_stabV_four hv
    refine ⟨F, hFperf, by rw [hFcard]; norm_num, ?_⟩
    intro γ hγ
    rw [Subgroup.mem_map] at hγ
    obtain ⟨g, hg, rfl⟩ := hγ
    have hgv : ((g : Matrix.SpecialLinearGroup (Fin 4) (ZMod 2)) :
        Matrix (Fin 4) (Fin 4) (ZMod 2)) *ᵥ v = v :=
      (CFSG.Quasithin.Vol2.Ch10.SecC.C10P4F.mem_stabV).1 hg
    apply Multiplicative.toAdd.injective
    change Multiplicative.toAdd
      (CFSG.Quasithin.natAct (StatedSL 4 (ZMod 2)) (e g) m) = Multiplicative.toAdd m
    rw [show CFSG.Quasithin.natAct (StatedSL 4 (ZMod 2)) (e g) m =
        Multiplicative.ofAdd
          (((e g : StatedSL 4 (ZMod 2)) : GL (Fin 4) (ZMod 2)) *ᵥ v) from rfl]
    rw [toAdd_ofAdd]
    rw [CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL_coe]
    exact hgv

theorem s16t3_perfect_stabilizer_of_binaryNaturalSL_four
    {W : Type} [CommGroup W] [Finite W]
    {H : Subgroup (MulAut W)} {U Z : Subgroup W}
    (hnat : BinaryNaturalSL H U Z 4 1) (hZ : Z ≤ fixV H) {w : W} (hw : w ∈ U) :
    ∃ P : Subgroup (MulAut W), P ≤ H ∧ Group.IsPerfect P ∧
      3 ∣ Nat.card P ∧ ∀ g ∈ P, g w = w := by
  obtain ⟨π, hπ⟩ := CFSG.Quasithin.FFC.BinaryNaturalSL.exists_zmod hnat
  have hfaith : (FFModel.nat (StatedSL 4 (ZMod 2))).Faithful :=
    FFModel.nat_faithful (StatedSL 4 (ZMod 2))
  have hZ' : ∀ l ∈ H, ∀ z ∈ Z, l z = z :=
    fun l hl z hz => (mem_fixV.mp (hZ hz)) l hl
  have hF : ∀ m ∈ (FFModel.nat (StatedSL 4 (ZMod 2))).sec,
      ∃ F : Subgroup (StatedSL 4 (ZMod 2)), Group.IsPerfect ↥F ∧ 3 ∣ Nat.card ↥F ∧
        ∀ γ ∈ F, (FFModel.nat (StatedSL 4 (ZMod 2))).act γ m * m⁻¹ ∈
          (FFModel.nat (StatedSL 4 (ZMod 2))).ker := by
    intro m _
    obtain ⟨F, hperf, hcard, hfix⟩ := s16t3_model_perfect_sl_four m
    refine ⟨F, hperf, hcard, ?_⟩
    intro γ hγ
    have hker : (FFModel.nat (StatedSL 4 (ZMod 2))).ker = ⊥ := rfl
    rw [hker, Subgroup.mem_bot]
    exact mul_inv_eq_one.mpr (hfix γ hγ)
  exact s16t3_perfect_of_model hπ hfaith hZ' hF hw

