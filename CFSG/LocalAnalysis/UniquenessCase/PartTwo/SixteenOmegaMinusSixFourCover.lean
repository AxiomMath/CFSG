theorem isU4_of_natOmegaMinus_six {W : Type} [CommGroup W] [Finite W]
    {H : Subgroup (MulAut W)} {a : ℕ} (ha : 1 ≤ a)
    (hN : NatOmegaMinus H ⊤ ⊥ 6 a) :
    IsU4 ↥H a := by
  obtain ⟨F, hFfield, hFfin, b, c, hFcard, hbc, ε, -, -⟩ :=
    S18.exists_natCoords_of_natOmegaMinus hN
  let _hFieldF : Field F := hFfield
  let _hFiniteF : Finite F := hFfin
  have _hCharF : CharP F 2 := CFSG.Timmesfeld.ClassicalOrders.charP_two_of_card_eq hFcard
  obtain ⟨E, hEf, hEdata, ⟨eSU⟩⟩ :=
    CFSG.ComponentClassification.RankTwoClassical.nonempty_statedOmega_quadMinus_three_equiv
      (K := F) (m := a) (b := b) (c := c) hFcard hbc
  let _hFieldE : Field E := hEf
  have _hFiniteE : Finite E := hEdata.finite
  have _hCharE : CharP E 2 := hEdata.charP
  have hbot : (StatedScalars (Fin 4) E).subgroupOf (StatedSU 4 (2 ^ a) E) = ⊥ :=
    CFSG.SectionRank.EvenCover.statedScalars_subgroupOf_statedSU_four_eq_bot
      (K := E) (q := 2 ^ a)
  let eP : StatedSU 4 (2 ^ a) E ≃* StatedProj (StatedSU 4 (2 ^ a) E) :=
    ((QuotientGroup.quotientMulEquivOfEq hbot).trans
      QuotientGroup.quotientBot).symm
  refine (CFSG.Blueprint.LieModel.classical_iff (t := .PSU) (by decide)).2 ?_
  refine ⟨⟨Nat.prime_two, ha, by norm_num, ?_⟩, E, hEf, inferInstance, ?_, ?_⟩
  · intro h
    exact absurd (Prod.ext_iff.1 h).1 (by norm_num)
  · rw [hEdata.card, ← pow_mul, Nat.mul_comm]
  · exact ⟨ε.trans (eSU.trans eP)⟩

theorem isU4_commutator_eq_top_and_griessHopfMultiplier_subsingleton
    {X : Type} [Group X] {f : ℕ} (hf : 2 ≤ f) (h : IsU4 X f) :
    commutator X = ⊤ ∧ Subsingleton (CFSG.Open.griessHopfMultiplier X) := by
  have hmodel : CFSG.Open.StatedClassicalModel X .PSU 4 2 f :=
    (CFSG.Blueprint.LieModel.classical_iff (t := .PSU) (by decide)).1 h
  have hq : 4 ≤ 2 ^ f ∨ (2 ^ f = 2 ∧ 8 ≤ 4) ∨ (2 ^ f = 3 ∧ 6 ≤ 4) :=
    Or.inl ((show 4 ≤ 2 ^ 2 by norm_num).trans (Nat.pow_le_pow_right (by norm_num) hf))
  have hrow := CFSG.LieType.Steinberg.CentralExt.GriessClassical.psu_row hmodel (by decide) hq
  obtain ⟨hcomm, ⟨eG⟩⟩ := hrow
  have hgen : CFSG.Blueprint.Multiplier.genericOrders .PSU 4 2 f = (1, 1) := by
    simp only [CFSG.Blueprint.Multiplier.genericOrders]
    have hodd : Odd (2 ^ f + 1) := (Nat.even_pow.2 ⟨even_two, by omega⟩).add_one
    have hgcd : Nat.gcd 4 (2 ^ f + 1) = 1 := by
      have hdvd : Nat.gcd 4 (2 ^ f + 1) ∣ 4 := Nat.gcd_dvd_left 4 _
      have hoddg : Odd (Nat.gcd 4 (2 ^ f + 1)) :=
        Odd.of_dvd_nat hodd (Nat.gcd_dvd_right 4 _)
      have hdvd' : Nat.gcd 4 (2 ^ f + 1) ∣ 2 ^ 2 := by simpa using hdvd
      obtain ⟨i, hi, hgi⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hdvd'
      have hg_eq : Nat.gcd 4 (2 ^ f + 1) = 2 ^ i := hgi
      interval_cases i
      · simpa using hg_eq
      · rw [hg_eq] at hoddg
        norm_num at hoddg
      · rw [hg_eq] at hoddg
        norm_num at hoddg
    rw [hgcd]
  have hexc : CFSG.Blueprint.Multiplier.exceptionalOrders .PSU 4 2 f = (1, 1) := by
    unfold CFSG.Blueprint.Multiplier.exceptionalOrders
    split <;> simp_all
  have hcard : Nat.card (CFSG.Blueprint.Multiplier.generic .PSU 4 2 f ×
      CFSG.Blueprint.Multiplier.exceptional .PSU 4 2 f) = 1 := by
    rw [CFSG.RankThree.PartOne.card_generic_exceptional, hgen, hexc]
    norm_num
  have _hSubGenExc : Subsingleton (CFSG.Blueprint.Multiplier.generic .PSU 4 2 f ×
      CFSG.Blueprint.Multiplier.exceptional .PSU 4 2 f) :=
    (Nat.card_eq_one_iff_unique.mp hcard).1
  exact ⟨hcomm, eG.injective.subsingleton⟩

theorem quasisimple_kernel_center {Q B : Type} [Group Q] [Finite Q] [Group B] [Nontrivial B]
    (hQ : CFSG.Open.IsQuasisimple Q) (f : Q →* B) (hf : Function.Surjective f)
    (hZB : Subgroup.center B = ⊥)
    (hM : Subsingleton (CFSG.Open.griessHopfMultiplier B)) :
    f.ker = Subgroup.center Q ∧ Subgroup.center Q = ⊥ := by
  have _hPerfectQ : Group.IsPerfect Q := ⟨hQ.1⟩
  have hker_le : f.ker ≤ Subgroup.center Q := by
    rcases CFSG.LocalCores.quasisimple_normal_subgroups
      ((CFSG.Quasithin.A3.isQuasisimple_iff_open).mpr hQ) (MonoidHom.normal_ker f) with
      htop | hle
    · exfalso
      have _hSubB : Subsingleton B := ⟨fun a b => by
        obtain ⟨x, rfl⟩ := hf a
        obtain ⟨y, rfl⟩ := hf b
        have hx : f x = 1 := by
          rw [← MonoidHom.mem_ker, htop]
          exact Subgroup.mem_top x
        have hy : f y = 1 := by
          rw [← MonoidHom.mem_ker, htop]
          exact Subgroup.mem_top y
        rw [hx, hy]⟩
      exact not_subsingleton B inferInstance
    · exact hle
  have hZle : Subgroup.center Q ≤ f.ker := by
    intro z hz
    rw [MonoidHom.mem_ker]
    have hzB : f z ∈ Subgroup.center B :=
      Subgroup.map_center_le_center hf (Subgroup.mem_map_of_mem f hz)
    rwa [hZB, Subgroup.mem_bot] at hzB
  have hcenter : f.ker = Subgroup.center Q := le_antisymm hker_le hZle
  have hdiv : Nat.card (Subgroup.center Q) ∣ Nat.card (CFSG.Open.griessHopfMultiplier B) := by
    have hsurj := CFSG.RankThree.PerfectCover.hopfMultiplierToKer_surjective f hf hker_le
    have h1 : Nat.card f.ker ∣ Nat.card (CFSG.RankThree.PerfectCover.hopfMultiplier B) :=
      Subgroup.card_dvd_of_surjective hsurj
    rw [← Nat.card_congr (CFSG.RankThree.PerfectCover.hopfMultiplierEquivGriess B).toEquiv] at h1
    simpa [hcenter] using h1
  have htriv : Nat.card (CFSG.Open.griessHopfMultiplier B) = 1 :=
    Nat.card_eq_one_iff_unique.mpr ⟨hM, ⟨1⟩⟩
  rw [htriv, Nat.dvd_one] at hdiv
  exact ⟨hcenter, Subgroup.card_eq_one.1 hdiv⟩

noncomputable def s168e3_actualActionHom
    {D : Data G} {V₀ V L : Subgroup G} {hV : IsElemAbelian 2 V}
    (c : S168e3Ctx D V₀ V L hV) {C : Subgroup G} (hC : C ∈ calC D.M)
    (hbarC : barSub V₀ V hV C = lBar V₀ V hV L) :
    ↥C →* ↥(lBar V₀ V hV L) :=
  (MulEquiv.subgroupCongr hbarC).toMonoidHom.comp
    ((barSubBar2HomOfHyp125 c.setting.hyp151.hyp125 hC).comp
      (QuotientGroup.mk' (CFSG.pCore 2 ↥C)))

theorem s168e3_actualActionHom_ker
    {D : Data G} {V₀ V L : Subgroup G} {hV : IsElemAbelian 2 V}
    (c : S168e3Ctx D V₀ V L hV) {C : Subgroup G} (hC : C ∈ calC D.M)
    (hbarC : barSub V₀ V hV C = lBar V₀ V hV L)
    (hinj : Function.Injective (barSubBar2HomOfHyp125 c.setting.hyp151.hyp125 hC)) :
    (s168e3_actualActionHom c hC hbarC).ker = CFSG.pCore 2 ↥C := by
  ext x
  constructor
  · intro hx
    have hx' : (MulEquiv.subgroupCongr hbarC)
        ((barSubBar2HomOfHyp125 c.setting.hyp151.hyp125 hC)
          ((QuotientGroup.mk' (CFSG.pCore 2 ↥C)) x)) = 1 := by
      simpa [s168e3_actualActionHom] using hx
    have h1 : (barSubBar2HomOfHyp125 c.setting.hyp151.hyp125 hC)
        ((QuotientGroup.mk' (CFSG.pCore 2 ↥C)) x) = 1 :=
      (MulEquiv.subgroupCongr hbarC).map_eq_one_iff.mp hx'
    have h2 : (QuotientGroup.mk' (CFSG.pCore 2 ↥C)) x = 1 :=
      hinj (by simpa using h1)
    exact (QuotientGroup.eq_one_iff x).1 h2
  · intro hx
    have h2 : (QuotientGroup.mk' (CFSG.pCore 2 ↥C)) x = 1 :=
      (QuotientGroup.eq_one_iff x).2 hx
    have h2' : (↑x : Bar2 C) = 1 := h2
    simp [s168e3_actualActionHom, h2']

theorem s168e3_exists_normal_cover_omegaMinus_six_four
    (D : Data G) {V₀ V L : Subgroup G} {hV : IsElemAbelian 2 V}
    (c : S168e3Ctx D V₀ V L hV) (hs : s15 D.M V₀ V hV L = 1)
    (hN : NatOmegaMinus (lBar V₀ V hV L) (wTil V₀ V hV L) ⊥ 6 2) :
    ∃ (C : Subgroup G) (hC : C ∈ calC D.M)
      (_hbarC : barSub V₀ V hV C = lBar V₀ V hV L),
      D.M ≤ normalizer (C : Set G) ∧
      IsU4 (Bar2 C) 2 ∧
      Function.Injective (barSubBar2HomOfHyp125 c.setting.hyp151.hyp125 hC) := by
  classical
  have hH : Hyp125 D V₀ V := c.setting.hyp151.hyp125
  have hwT : wTil V₀ V hV L = ⊤ := wTil_eq_top_of_case163_2 c.conc hs
  have hNat : NatOmegaMinus (lBar V₀ V hV L) ⊤ ⊥ 6 2 := by
    have h := hN
    rwa [hwT] at h
  obtain ⟨F, hFfield, hFfin, b, c₀, hFcard, hbc, ε, -, -⟩ :=
    S18.exists_natCoords_of_natOmegaMinus hNat
  let _hFieldFm : Field F := hFfield
  let _hFiniteFm : Finite F := hFfin
  have _hCharFm : CharP F 2 := CFSG.Timmesfeld.ClassicalOrders.charP_two_of_card_eq hFcard
  have hU4L : IsU4 ↥(lBar V₀ V hV L) 2 :=
    isU4_of_natOmegaMinus_six (a := 2) (by norm_num) hNat
  have hsimpleL : IsSimpleGroup ↥(lBar V₀ V hV L) :=
    CFSG.Blueprint.LieModel.isSimpleGroup_of_mem_classicalTags (by decide) hU4L
  have hfacts :=
    CFSG.ComponentClassification.RankTwoClassical.isSimpleGroup_statedOmega_quadMinus_small
      (K := F) (n := 3) (Or.inr rfl) hbc
  have _hPerfectOmega : Group.IsPerfect ↥(StatedOmega (StatedQuadMinus 3 F b c₀)) :=
    Group.isPerfect_def.mpr hfacts.2.1
  have hperfL : Group.IsPerfect ↥(lBar V₀ V hV L) :=
    Group.IsPerfect.ofSurjective (f := ε.symm.toMonoidHom) ε.symm.surjective
  have _hPerfectL : Group.IsPerfect ↥(lBar V₀ V hV L) := hperfL
  have _hSimpleL : IsSimpleGroup ↥(lBar V₀ V hV L) := hsimpleL
  have hnaL : ¬ ∀ x y : ↥(lBar V₀ V hV L), x * y = y * x := fun h =>
    (Group.IsPerfect.not_isMulCommutative ↥(lBar V₀ V hV L))
      (IsMulCommutative.of_comm h)
  have hqL : CFSG.Open.IsQuasisimple ↥(lBar V₀ V hV L) :=
    (CFSG.Quasithin.A3.isQuasisimple_iff_open).1
      (CFSG.ComponentClassification.RankTwoClassical.isQuasisimple_of_isSimpleGroup hnaL).1
  have hZL : Subgroup.center ↥(lBar V₀ V hV L) = ⊥ :=
    (CFSG.ComponentClassification.RankTwoClassical.isQuasisimple_of_isSimpleGroup hnaL).2
  have hLbar_le : lBar V₀ V hV L ≤ Mbar D.M V₀ V hV :=
    barSub_mono V₀ V hV c.setting.hyp151.le
  have hnorm : Mbar D.M V₀ V hV ≤ Subgroup.normalizer
      (lBar V₀ V hV L : Set (MulAut (Vtil V₀ V hV))) := fun φ hφ =>
    Subgroup.mem_normalizer_iff_map_conj_eq.mpr (lBar_conj_eq_of_s15_eq_one hs hφ)
  have hLbarN : ((lBar V₀ V hV L).subgroupOf (Mbar D.M V₀ V hV)).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hLbar_le).mpr hnorm
  have hcompL : IsComponentOf (lBar V₀ V hV L) (Mbar D.M V₀ V hV) :=
    ⟨hLbar_le, CFSG.Quasithin.A3.subnormal_of_normal hLbar_le hLbarN, hqL⟩
  have hMultG : Subsingleton
      (CFSG.Open.griessHopfMultiplier ↥(lBar V₀ V hV L)) :=
    (isU4_commutator_eq_top_and_griessHopfMultiplier_subsingleton
      (f := 2) (by norm_num) hU4L).2
  have hMult : Subsingleton
      (CFSG.RankThree.PerfectCover.hopfMultiplier ↥(lBar V₀ V hV L)) :=
    (CFSG.RankThree.PerfectCover.hopfMultiplierEquivGriess
      ↥(lBar V₀ V hV L)).symm.injective.subsingleton
  have hcover : ∀ (Q : Type) [Group Q] [Finite Q],
      CFSG.Open.IsQuasisimple Q →
      Nonempty ((Q ⧸ Subgroup.center Q) ≃* ↥(lBar V₀ V hV L)) →
      ¬ 3 ∣ Nat.card (Subgroup.center Q) := by
    intro Q _ _ hQ ⟨e⟩
    have hdvd := CFSG.GH74.Generic.card_center_dvd_hopfMultiplier
      ((CFSG.Quasithin.A3.isQuasisimple_iff_open).2 hQ) e
    have htriv : Nat.card (CFSG.RankThree.PerfectCover.hopfMultiplier
        ↥(lBar V₀ V hV L)) = 1 :=
      Nat.card_eq_one_iff_unique.mpr ⟨hMult, ⟨1⟩⟩
    rw [htriv, Nat.dvd_one] at hdvd
    intro h3
    rw [hdvd] at h3
    norm_num at h3
  obtain ⟨Y, hYc, hYM, hYnorm, hbarY, -⟩ :=
    s168e3_exists_normal_cover_prime_free (B := lBar V₀ V hV L) c hcompL hsimpleL hnorm
      Nat.prime_three (by norm_num) hcover
  have hYN : D.M ≤ normalizer (Y : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hYM).1 hYnorm
  have hBnt : Nontrivial ↥(lBar V₀ V hV L) := hsimpleL.toNontrivial
  have hBcenter : Subgroup.center ↥(barSub V₀ V hV Y) = ⊥ := by
    rw [hbarY]
    exact hZL
  have hMultB : Subsingleton (CFSG.Open.griessHopfMultiplier ↥(barSub V₀ V hV Y)) := by
    rw [hbarY]
    exact hMultG
  have hBnt' : Nontrivial ↥(barSub V₀ V hV Y) := by
    rw [hbarY]
    exact hBnt
  have _hNontrivialB : Nontrivial ↥(barSub V₀ V hV Y) := hBnt'
  obtain ⟨hker_center, hcenter_bot⟩ :=
    quasisimple_kernel_center hYc.2.2 (barSubBar2HomOfHyp125 hH hYc)
      (barSubBar2HomOfHyp125_surjective hH hYc) hBcenter hMultB
  have hker : (barSubBar2HomOfHyp125 hH hYc).ker = ⊥ :=
    hker_center.trans hcenter_bot
  let ψY := barSubBar2HomOfHyp125 hH hYc
  have hψY : Function.Surjective ψY := barSubBar2HomOfHyp125_surjective hH hYc
  let eBarY : Bar2 Y ≃* ↥(barSub V₀ V hV Y) :=
    MulEquiv.ofBijective ψY ⟨(MonoidHom.ker_eq_bot_iff ψY).1 hker, hψY⟩
  let eY : Bar2 Y ≃* ↥(lBar V₀ V hV L) := eBarY.trans (MulEquiv.subgroupCongr hbarY)
  have hU4Y : IsU4 (Bar2 Y) 2 := CFSG.Blueprint.LieModel.of_mulEquiv eY.symm hU4L
  have hψYinj : Function.Injective (barSubBar2HomOfHyp125 hH hYc) :=
    (MonoidHom.ker_eq_bot_iff (barSubBar2HomOfHyp125 hH hYc)).1 hker
  exact ⟨Y, hYc, hbarY, hYN, hU4Y, hψYinj⟩

theorem s168e3_exists_normal_cover_omegaMinus_six_four_action
