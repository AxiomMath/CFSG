variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

theorem twelve_le_finrank {ρ : Representation (ZMod 2) G6 V} (hρ : IsSimpleRep ρ) [Finite V]
    {y : V} (hy : y ∈ fixU ρ) (hy0 : y ≠ 0) (h1 : Th ρ 1 y ≠ 0) :
    12 ≤ Module.finrank (ZMod 2) V :=
  card_le_finrank hρ hy hy0 repsB1 ctabB1 (fun i j => wE_inv_mul (spec_B1 i j).1)
    (fun i => (spec_B1 i i).2.1 rfl) fun i j hij => ⟨1, (spec_B1 i j).2.2 hij, h1⟩

theorem twentyfour_le_finrank {ρ : Representation (ZMod 2) G6 V} (hρ : IsSimpleRep ρ)
    [Finite V] {y : V} (hy : y ∈ fixU ρ) (hy0 : y ≠ 0) (h0 : Th ρ 0 y ≠ 0)
    (h2 : Th ρ 2 y ≠ 0) : 24 ≤ Module.finrank (ZMod 2) V := by
  refine card_le_finrank hρ hy hy0 repsB2 ctabB2 (fun i j => wE_inv_mul (spec_B2 i j).1)
    (fun i => (spec_B2 i i).2.1 rfl) fun i j hij => ?_
  rcases (spec_B2 i j).2.2 hij with h | h
  · exact ⟨0, h, h0⟩
  · exact ⟨2, h, h2⟩

