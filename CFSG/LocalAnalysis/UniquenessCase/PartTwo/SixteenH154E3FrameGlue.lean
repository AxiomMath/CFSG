private theorem s16h_e3_map_conj_one {T : Type*} [Group T] (X : Subgroup T) :
    X.map (MulAut.conj (1 : T)).toMonoidHom = X := by
  ext x
  simp [Subgroup.mem_map, MulAut.conj_apply]

private theorem s16h_e3_map_conj_mul {T : Type*} [Group T] (X : Subgroup T) (x y : T) :
    (X.map (MulAut.conj x).toMonoidHom).map (MulAut.conj y).toMonoidHom =
      X.map (MulAut.conj (y * x)).toMonoidHom := by
  rw [Subgroup.map_map]
  congr 1
  ext t
  simp [MulAut.conj_apply, mul_assoc]

private theorem s16h_e3_exists_conj_eq {D : Data G} {V₀ V L : Subgroup G}
    (h : Hyp151 D V₀ V L) (hV : IsElemAbelian 2 V) {φ : MulAut (Vtil V₀ V hV)}
    (hφ : φ ∈ Mbar D.M V₀ V hV) :
    ∃ m : G, m ∈ D.M ∧ barSub V₀ V hV (conjSubgroup L m) =
      (barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom := by
  obtain ⟨g, hgM, hgφ⟩ := (mem_barSub V₀ V hV D.M φ).1 hφ
  have hgm : (g : G)⁻¹ ∈ stabTil V₀ V := (stabTil _ _).inv_mem g.2
  have hgt : actTil V₀ V hV ⟨(g : G)⁻¹, hgm⟩ = (actTil V₀ V hV g)⁻¹ := by
    rw [show (⟨(g : G)⁻¹, hgm⟩ : stabTil V₀ V) = ⟨g, g.2⟩⁻¹ from rfl, map_inv]
  refine ⟨(g : G)⁻¹, D.M.inv_mem hgM, ?_⟩
  rw [← hgφ, s15_Infra_barSub_conjSubgroup V₀ V hV hgm L]
  congr 1
  rw [hgt, inv_inv]

private theorem s16h_e3_relIndex_stabilizer_eq_two {T : Type*} [Group T]
    {X K : Subgroup (MulAut T)} {x₁ : MulAut T} (hx₁ : x₁ ∈ X)
    (hx₁K : K.map (MulAut.conj x₁).toMonoidHom ≠ K)
    (huniq : ∀ a ∈ X, ∀ b ∈ X, K.map (MulAut.conj a).toMonoidHom ≠ K →
      K.map (MulAut.conj b).toMonoidHom ≠ K →
        K.map (MulAut.conj a).toMonoidHom = K.map (MulAut.conj b).toMonoidHom) :
    ((X ⊓ Subgroup.normalizer (K : Set (MulAut T))).subgroupOf X).index = 2 := by
  set K' := K.map (MulAut.conj x₁).toMonoidHom with hK'
  have hmemA : ∀ b : X, b ∈ (X ⊓ Subgroup.normalizer (K : Set (MulAut T))).subgroupOf X ↔
      K.map (MulAut.conj (b : MulAut T)).toMonoidHom = K := fun b => by
    rw [Subgroup.mem_subgroupOf, Subgroup.mem_inf]
    exact ⟨fun h => (Subgroup.mem_normalizer_iff_map_conj_eq).1 h.2,
      fun h => ⟨b.2, (Subgroup.mem_normalizer_iff_map_conj_eq).2 h⟩⟩
  have hinj : ∀ (b : MulAut T) (A₁ A₂ : Subgroup (MulAut T)),
      A₁.map (MulAut.conj b).toMonoidHom = A₂.map (MulAut.conj b).toMonoidHom → A₁ = A₂ :=
    fun b _ _ h => Subgroup.map_injective (MulAut.conj b).injective h
  rw [Subgroup.index_eq_two_iff]
  refine ⟨⟨x₁, hx₁⟩, fun b => xor_iff_iff_not.mpr ⟨fun hbg hb => ?_, fun hb => ?_⟩⟩
  · rw [hmemA, Subgroup.coe_mul, ← s16h_e3_map_conj_mul] at hbg
    rw [hmemA] at hb
    exact hx₁K (hinj b K' K (hbg.trans hb.symm))
  · rw [hmemA] at hb
    rw [hmemA, Subgroup.coe_mul, ← s16h_e3_map_conj_mul]
    by_contra hne
    have h1 := huniq _ (X.mul_mem b.2 hx₁) _ b.2
      (by rw [← s16h_e3_map_conj_mul]; exact hne) hb
    rw [← s16h_e3_map_conj_mul] at h1
    exact hx₁K (hinj b K' K h1)

private def s16h_e3_TwoData {T : Type*} [CommGroup T]
    (A H : Subgroup (MulAut T)) (U : Subgroup T) : Prop :=
  ∃ (ψ : MulAut T) (B : Subgroup (MulAut T)),
    ψ ∈ A ∧ B = H.map (MulAut.conj ψ).toMonoidHom ∧ B ≠ H ∧
      (∀ φ ∈ A, H.map (MulAut.conj φ).toMonoidHom = H ∨
        H.map (MulAut.conj φ).toMonoidHom = B) ∧
      U.map ψ.toMonoidHom = commSub ⊤ B ∧
      U ⊓ U.map ψ.toMonoidHom = ⊥ ∧ U ⊔ U.map ψ.toMonoidHom = ⊤ ∧
      (∀ a ∈ H, ∀ b ∈ B, a * b = b * a) ∧
      (∀ a ∈ H, ∀ w ∈ U.map ψ.toMonoidHom, a w = w) ∧
      (∀ b ∈ B, ∀ w ∈ U, b w = w)

private theorem s16h_e3_two_data (D : Data G) (h1217 : R1217 D)
    {V₀ V L : Subgroup G} (h : Hyp151 D V₀ V L)
    (hv1 : v1Sub D.M V₀ V h.isElemAbelian L = V₀)
    (hs : s15 D.M V₀ V h.isElemAbelian L = 2) :
    s16h_e3_TwoData (Mbar D.M V₀ V h.isElemAbelian)
      (lBar V₀ V h.isElemAbelian L) (wTil V₀ V h.isElemAbelian L) := by
  have hV := h.isElemAbelian
  have hMs : D.M ≤ stabTil V₀ V :=
    le_stabTil h.hyp125.pairFacts.le_normalizer h.hyp125.pairFacts.le_normalizer₀
  obtain ⟨x, y, hxy, hSxy⟩ := Set.ncard_eq_two.1 hs
  have hAS : lBar V₀ V hV L ∈ {X : Subgroup (MulAut (Vtil V₀ V hV)) |
      ∃ φ ∈ Mbar D.M V₀ V hV,
        X = (lBar V₀ V hV L).map (MulAut.conj φ).toMonoidHom} :=
    ⟨1, (Mbar D.M V₀ V hV).one_mem, (s16h_e3_map_conj_one _).symm⟩
  have hSxy' : {X : Subgroup (MulAut (Vtil V₀ V hV)) |
      ∃ φ ∈ Mbar D.M V₀ V hV,
        X = (lBar V₀ V hV L).map (MulAut.conj φ).toMonoidHom} = {x, y} := hSxy
  rw [hSxy'] at hAS
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hAS
  obtain ⟨B, hBA, hSAB⟩ : ∃ B : Subgroup (MulAut (Vtil V₀ V hV)),
      B ≠ lBar V₀ V hV L ∧
      {X : Subgroup (MulAut (Vtil V₀ V hV)) | ∃ φ ∈ Mbar D.M V₀ V hV,
        X = (lBar V₀ V hV L).map (MulAut.conj φ).toMonoidHom} =
        {lBar V₀ V hV L, B} := by
    rcases hAS with h1 | h1
    · exact ⟨y, fun hy => hxy (h1.symm.trans hy.symm), by rw [hSxy', h1]⟩
    · exact ⟨x, fun hx => hxy (hx.trans h1), by rw [hSxy', h1, Set.pair_comm]⟩
  have hBS : B ∈ {X : Subgroup (MulAut (Vtil V₀ V hV)) | ∃ φ ∈ Mbar D.M V₀ V hV,
      X = (lBar V₀ V hV L).map (MulAut.conj φ).toMonoidHom} := by
    rw [hSAB]
    exact Set.mem_insert_of_mem _ (Set.mem_singleton _)
  obtain ⟨ψ, hψM, hBψ⟩ := hBS
  have hAB : (lBar V₀ V hV L).map (MulAut.conj ψ).toMonoidHom = B := hBψ.symm
  obtain ⟨m₀, hm₀M, hKm₀⟩ := s16h_e3_exists_conj_eq h hV hψM
  have hKB : barSub V₀ V hV (conjSubgroup L m₀) = B := hKm₀.trans hAB
  have hne1 : m₀ * (1 : G)⁻¹ ∉ nBar D.M V₀ V hV L := by
    intro hmem
    have := (s15_Infra_mul_inv_mem_nBar_iff (L := L) h.hyp125 hV D.M.one_mem hm₀M).1 hmem
    rw [conjSubgroup_one, hKB] at this
    exact hBA this
  have hne2 : (1 : G) * m₀⁻¹ ∉ nBar D.M V₀ V hV L := by
    intro hmem
    have := (s15_Infra_mul_inv_mem_nBar_iff (L := L) h.hyp125 hV hm₀M D.M.one_mem).1 hmem
    rw [conjSubgroup_one, hKB] at this
    exact hBA this.symm
  have hc1 : ⁅lBar V₀ V hV L, B⁆ = ⊥ ∧
      commSub (commSub ⊤ (lBar V₀ V hV L)) B = ⊥ := by
    have := s15_Kbar_commute_conj h (m := 1) (m' := m₀) D.M.one_mem hm₀M hne1
    rwa [conjSubgroup_one, hKB] at this
  have hc2 : commSub (commSub ⊤ B) (lBar V₀ V hV L) = ⊥ := by
    have := (s15_Kbar_commute_conj h (m := m₀) (m' := 1) hm₀M D.M.one_mem hne2).2
    rwa [conjSubgroup_one, hKB] at this
  have hWB : (commSub ⊤ (lBar V₀ V hV L)).map ψ.toMonoidHom = commSub ⊤ B := by
    rw [← hAB, s15_Infra_commSub_top_map_conj]
  have hKcases : ∀ m : G, m ∈ D.M → barSub V₀ V hV (conjSubgroup L m) =
      lBar V₀ V hV L ∨ barSub V₀ V hV (conjSubgroup L m) = B := by
    intro m hm
    have hmem : barSub V₀ V hV (conjSubgroup L m) ∈
        {X : Subgroup (MulAut (Vtil V₀ V hV)) | ∃ φ ∈ Mbar D.M V₀ V hV,
          X = (lBar V₀ V hV L).map (MulAut.conj φ).toMonoidHom} :=
      ⟨(actTil V₀ V hV ⟨m, hMs hm⟩)⁻¹,
        Subgroup.inv_mem _ (actTil_mem_barSub V₀ V hV hm (hMs hm)),
        s15_Infra_barSub_conjSubgroup V₀ V hV (hMs hm) L⟩
    rw [hSAB] at hmem
    simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hmem
  have hL : lBar V₀ V hV L ≠ ⊥ := by
    intro hbot
    apply hBA
    rw [← hAB, hbot, Subgroup.map_bot]
  have hW : ∀ m : G, m ∈ D.M →
      imgTil V₀ V hV (conjSubgroup (wSub V₀ V hV L) m) =
        commSub ⊤ (barSub V₀ V hV (conjSubgroup L m)) := by
    intro m hm
    rw [← s15_Infra_wSub_conjSubgroup V₀ V L hV (hMs hm), wSub, imgTil_preTil]
    rfl
  have hinf : wTil V₀ V hV L ⊓ (wTil V₀ V hV L).map ψ.toMonoidHom = ⊥ := by
    show commSub ⊤ (lBar V₀ V hV L) ⊓ (commSub ⊤ (lBar V₀ V hV L)).map
      ψ.toMonoidHom = ⊥
    rw [hWB]
    have hbot := s15_Core_inf_iSup_imgTil_wSub_eq_bot h hL (1 : D.M)
    rw [hv1] at hbot
    have hA1 : commSub ⊤ (lBar V₀ V hV L) ≤
        imgTil V₀ V hV (conjSubgroup (wSub V₀ V hV L) ((1 : D.M) : G)) := by
      have := hW 1 D.M.one_mem
      rw [conjSubgroup_one, conjSubgroup_one] at this
      rw [show ((1 : D.M) : G) = 1 from rfl, conjSubgroup_one]
      exact this.symm.le
    have hcond : barSub V₀ V hV (conjSubgroup L ((⟨m₀, hm₀M⟩ : D.M) : G)) ≠
        barSub V₀ V hV (conjSubgroup L ((1 : D.M) : G)) := by
      show barSub V₀ V hV (conjSubgroup L m₀) ≠ barSub V₀ V hV (conjSubgroup L 1)
      rw [conjSubgroup_one, hKB]
      exact hBA
    have hB1 : commSub ⊤ B ≤ ⨆ (m' : D.M)
        (_ : barSub V₀ V hV (conjSubgroup L (m' : G)) ≠
          barSub V₀ V hV (conjSubgroup L ((1 : D.M) : G))),
        imgTil V₀ V hV (conjSubgroup (wSub V₀ V hV L) (m' : G)) := by
      have h1 := hW m₀ hm₀M
      rw [hKB] at h1
      rw [← h1]
      exact le_iSup₂ (f := fun (m' : D.M)
        (_ : barSub V₀ V hV (conjSubgroup L (m' : G)) ≠
          barSub V₀ V hV (conjSubgroup L ((1 : D.M) : G))) =>
        imgTil V₀ V hV (conjSubgroup (wSub V₀ V hV L) (m' : G)))
        ⟨m₀, hm₀M⟩ hcond
    exact le_bot_iff.1 ((inf_le_inf hA1 hB1).trans hbot.le)
  have hsup : wTil V₀ V hV L ⊔ (wTil V₀ V hV L).map ψ.toMonoidHom = ⊤ := by
    show commSub ⊤ (lBar V₀ V hV L) ⊔ (commSub ⊤ (lBar V₀ V hV L)).map
      ψ.toMonoidHom = ⊤
    rw [hWB]
    have htop := s15_Two_iSup_commSub_eq_top D h1217 h hL
    refine le_antisymm le_top ?_
    calc (⊤ : Subgroup (Vtil V₀ V hV))
        = ⨆ m : D.M, commSub ⊤ (barSub V₀ V hV (conjSubgroup L (m : G))) := htop.symm
      _ ≤ commSub ⊤ (lBar V₀ V hV L) ⊔ commSub ⊤ B := by
        refine iSup_le fun m => ?_
        rcases hKcases m m.2 with h1 | h1
        · exact (congrArg (commSub ⊤) h1).le.trans le_sup_left
        · exact (congrArg (commSub ⊤) h1).le.trans le_sup_right
  have hpairH : ∀ φ ∈ Mbar D.M V₀ V hV,
      (lBar V₀ V hV L).map (MulAut.conj φ).toMonoidHom = lBar V₀ V hV L ∨
        (lBar V₀ V hV L).map (MulAut.conj φ).toMonoidHom = B := by
    intro φ hφ
    have hmem : (lBar V₀ V hV L).map (MulAut.conj φ).toMonoidHom ∈
        {X : Subgroup (MulAut (Vtil V₀ V hV)) | ∃ ψ ∈ Mbar D.M V₀ V hV,
          X = (lBar V₀ V hV L).map (MulAut.conj ψ).toMonoidHom} := ⟨φ, hφ, rfl⟩
    rw [hSAB] at hmem
    simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hmem
  refine ⟨ψ, B, hψM, hBψ, hBA, hpairH, hWB, hinf, hsup, ?_, ?_, ?_⟩
  ·
    intro a ha b hb
    have hcent := Subgroup.commutator_eq_bot_iff_le_centralizer.mp hc1.1
    exact ((Subgroup.mem_centralizer_iff.1 (hcent ha)) b hb).symm
  ·
    intro a ha w hw
    have hw' : w ∈ (commSub ⊤ (lBar V₀ V hV L)).map ψ.toMonoidHom := hw
    rw [hWB] at hw'
    exact mem_fixV.1 (commSub_eq_bot_iff.1 hc2 hw') a ha
  ·
    intro b hb w hw
    exact mem_fixV.1 (commSub_eq_bot_iff.1 hc1.2 hw) b hb

theorem s16h_e3_frame_of_setting (D : Data G) (S : s16h_Std D) (h1217 : R1217 D)
    {V₀ V L : Subgroup G} (h : Setting16 D V₀ V L)
    (hs2 : s15 D.M V₀ V h.hyp151.isElemAbelian L = 2)
    (hZ : commSub ⊤ (lBar V₀ V h.hyp151.isElemAbelian L) ⊓
      fixV (lBar V₀ V h.hyp151.isElemAbelian L) = ⊥) :
    ∃ (L' : Subgroup (MulAut (Vtil V₀ V h.hyp151.isElemAbelian)))
      (U' : Subgroup (Vtil V₀ V h.hyp151.isElemAbelian)),
      s16h_E3Frame (Mbar D.M V₀ V h.hyp151.isElemAbelian) (lBar V₀ V h.hyp151.isElemAbelian L) L'
        (barSub V₀ V h.hyp151.isElemAbelian D.T) (wTil V₀ V h.hyp151.isElemAbelian L) U' := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hV := h.hyp151.isElemAbelian
  have hMs : D.M ≤ stabTil V₀ V :=
    le_stabTil h.hyp151.hyp125.pairFacts.le_normalizer
      h.hyp151.hyp125.pairFacts.le_normalizer₀
  have hv1 : v1Sub D.M V₀ V hV L = V₀ := by
    by_cases h0 : V₀ = ⊥
    · subst h0
      exact s16c167_v1Sub_eq_bot_of_inf_fixV D hV rfl hZ
    · exact v1Sub_of_ne_bot D.M V₀ V hV L h0
  obtain ⟨ψ, B, hψM, hB, hne, hpairH, hu'eq, hinf, hsup, hcomm, hfixA, hfixB⟩ :=
    s16h_e3_two_data D h1217 h.hyp151 hv1 hs2
  have hL : lBar V₀ V hV L ≠ ⊥ := by
    intro hbot
    exact hne (by rw [hB, hbot, Subgroup.map_bot])
  have hHle : lBar V₀ V hV L ≤ Mbar D.M V₀ V hV := barSub_mono V₀ V hV h.hyp151.le
  have hBle : B ≤ Mbar D.M V₀ V hV := by
    rw [hB]
    intro x hx
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.1 hx
    exact (Mbar D.M V₀ V hV).mul_mem
      ((Mbar D.M V₀ V hV).mul_mem hψM (hHle hy)) ((Mbar D.M V₀ V hV).inv_mem hψM)
  have hTsylOf : CFSG.ABGLocalTools.IsSylowOf 2
      (barSub V₀ V hV D.T) (Mbar D.M V₀ V hV) :=
    s16c7_isSylowOf_barSub (p := 2) V₀ V hV D.sylowM hMs
  have hTsyl := (CFSG.ABGLocalTools.isSylowOf_iff (p := 2)).1 hTsylOf
  have hidx : ((Mbar D.M V₀ V hV ⊓
      Subgroup.normalizer (lBar V₀ V hV L : Set (MulAut (Vtil V₀ V hV)))).subgroupOf
        (Mbar D.M V₀ V hV)).index = 2 := by
    refine s16h_e3_relIndex_stabilizer_eq_two (X := Mbar D.M V₀ V hV)
      (K := lBar V₀ V hV L) (x₁ := ψ) hψM ?_ ?_
    · rw [← hB]
      exact hne
    · intro a ha b hb hane hbne
      rcases hpairH a ha with h1 | h1
      · exact absurd h1 hane
      · rcases hpairH b hb with h2 | h2
        · exact absurd h2 hbne
        · rw [h1, h2]
  have ht_exists : ∃ t ∈ barSub V₀ V hV D.T,
      t ∉ Mbar D.M V₀ V hV ⊓
        Subgroup.normalizer (lBar V₀ V hV L : Set (MulAut (Vtil V₀ V hV))) := by
    by_contra hcon
    have hTN : barSub V₀ V hV D.T ≤ Mbar D.M V₀ V hV ⊓
        Subgroup.normalizer (lBar V₀ V hV L : Set (MulAut (Vtil V₀ V hV))) := by
      intro t ht
      by_contra hnt
      exact hcon ⟨t, ht, hnt⟩
    have hNA : Mbar D.M V₀ V hV ⊓
        Subgroup.normalizer (lBar V₀ V hV L : Set (MulAut (Vtil V₀ V hV))) ≤
        Mbar D.M V₀ V hV := inf_le_left
    have hmul := Subgroup.relIndex_mul_relIndex (barSub V₀ V hV D.T)
      (Mbar D.M V₀ V hV ⊓
        Subgroup.normalizer (lBar V₀ V hV L : Set (MulAut (Vtil V₀ V hV))))
      (Mbar D.M V₀ V hV) hTN hNA
    have hNrel : (Mbar D.M V₀ V hV ⊓
        Subgroup.normalizer (lBar V₀ V hV L : Set (MulAut (Vtil V₀ V hV)))).relIndex
          (Mbar D.M V₀ V hV) = 2 := hidx
    have hdvd : 2 ∣ (barSub V₀ V hV D.T).relIndex (Mbar D.M V₀ V hV) := by
      refine ⟨(barSub V₀ V hV D.T).relIndex (Mbar D.M V₀ V hV ⊓
        Subgroup.normalizer (lBar V₀ V hV L : Set (MulAut (Vtil V₀ V hV)))), ?_⟩
      rw [← hmul, hNrel]
      exact mul_comm _ 2
    exact hTsyl.2.2 hdvd
  obtain ⟨t, htT, htN⟩ := ht_exists
  have htA : t ∈ Mbar D.M V₀ V hV := hTsyl.1 htT
  have htnorm : t ∉ Subgroup.normalizer
      (lBar V₀ V hV L : Set (MulAut (Vtil V₀ V hV))) := by
    intro htn
    exact htN (Subgroup.mem_inf.2 ⟨htA, htn⟩)
  have hHtne : (lBar V₀ V hV L).map (MulAut.conj t).toMonoidHom ≠ lBar V₀ V hV L :=
    fun h => htnorm ((Subgroup.mem_normalizer_iff_map_conj_eq).2 h)
  have hHtB : (lBar V₀ V hV L).map (MulAut.conj t).toMonoidHom = B := by
    rcases hpairH t htA with h | h
    · exact absurd h hHtne
    · exact h
  have hWt : (wTil V₀ V hV L).map t.toMonoidHom =
      (wTil V₀ V hV L).map ψ.toMonoidHom := by
    rw [show (wTil V₀ V hV L).map t.toMonoidHom = commSub ⊤
      ((lBar V₀ V hV L).map (MulAut.conj t).toMonoidHom) from
        (s15_Infra_commSub_top_map_conj (lBar V₀ V hV L) t).symm,
      hHtB, ← hu'eq]
  refine ⟨B, (wTil V₀ V hV L).map ψ.toMonoidHom, ?_⟩
  refine
    { exp2 := fun w => s15_Infra_vtil_sq_eq_one V₀ V hV w
      inf_eq := hinf
      sup_eq := hsup
      le_x := hHle
      le_x' := hBle
      t_le := hTsyl.1
      t_two := hTsyl.2.1
      t_syl := hTsyl.2.2
      comm := hcomm
      fix_u := hfixB
      fix_u' := hfixA
      u_eq := rfl
      u'_eq := hu'eq
      perm := fun φ hφ => by
        have hinj : Function.Injective
            (Subgroup.map (MulAut.conj φ).toMonoidHom :
              Subgroup (MulAut (Vtil V₀ V hV)) → Subgroup (MulAut (Vtil V₀ V hV))) :=
          Subgroup.map_injective (MulAut.conj φ).injective
        have hS : {X : Subgroup (MulAut (Vtil V₀ V hV)) |
            ∃ θ ∈ Mbar D.M V₀ V hV,
              X = (lBar V₀ V hV L).map (MulAut.conj θ).toMonoidHom} =
            {lBar V₀ V hV L, B} := by
          have h2 : B ∈ {X : Subgroup (MulAut (Vtil V₀ V hV)) |
              ∃ θ ∈ Mbar D.M V₀ V hV,
                X = (lBar V₀ V hV L).map (MulAut.conj θ).toMonoidHom} :=
            ⟨ψ, hψM, hB⟩
          have h3 : lBar V₀ V hV L ∈ {X : Subgroup (MulAut (Vtil V₀ V hV)) |
              ∃ θ ∈ Mbar D.M V₀ V hV,
                X = (lBar V₀ V hV L).map (MulAut.conj θ).toMonoidHom} :=
            ⟨1, (Mbar D.M V₀ V hV).one_mem, (s16h_e3_map_conj_one _).symm⟩
          ext Y
          constructor
          · intro hY
            obtain ⟨θ, hθA, hYθ⟩ := hY
            rw [hYθ]
            rcases hpairH θ hθA with h | h
            · rw [h]; simp
            · rw [h]; simp
          · intro hY
            rcases hY with hY | hY
            · exact hY ▸ h3
            · exact hY ▸ h2
        have hBmap : B.map (MulAut.conj φ).toMonoidHom = B ∨
            B.map (MulAut.conj φ).toMonoidHom = lBar V₀ V hV L := by
          have hmem : B.map (MulAut.conj φ).toMonoidHom ∈
              {X : Subgroup (MulAut (Vtil V₀ V hV)) |
                ∃ θ ∈ Mbar D.M V₀ V hV,
                  X = (lBar V₀ V hV L).map (MulAut.conj θ).toMonoidHom} := by
            rw [hB, s16h_e3_map_conj_mul]
            exact ⟨φ * ψ, (Mbar D.M V₀ V hV).mul_mem hφ hψM, rfl⟩
          rw [hS] at hmem
          rcases (by simpa only [Set.mem_insert_iff, Set.mem_singleton_iff]
            using hmem) with h | h
          · exact Or.inr h
          · exact Or.inl h
        have hHmap : (lBar V₀ V hV L).map (MulAut.conj φ).toMonoidHom =
            lBar V₀ V hV L ∨ (lBar V₀ V hV L).map (MulAut.conj φ).toMonoidHom = B :=
          hpairH φ hφ
        have hUmap : (wTil V₀ V hV L).map φ.toMonoidHom = commSub ⊤
            ((lBar V₀ V hV L).map (MulAut.conj φ).toMonoidHom) :=
          (s15_Infra_commSub_top_map_conj (lBar V₀ V hV L) φ).symm
        have hWBmap : ((wTil V₀ V hV L).map ψ.toMonoidHom).map φ.toMonoidHom =
            commSub ⊤ (B.map (MulAut.conj φ).toMonoidHom) := by
          rw [hu'eq, ← s15_Infra_commSub_top_map_conj]
        rcases hHmap with hH | hH
        · rcases hBmap with hBm | hBm
          · exact Or.inl ⟨hH, hBm, by rw [hUmap, hH]; rfl,
              by rw [hWBmap, hBm, ← hu'eq]⟩
          · exfalso
            have hEq : B.map (MulAut.conj φ).toMonoidHom =
                (lBar V₀ V hV L).map (MulAut.conj φ).toMonoidHom := by rw [hBm, hH]
            exact hne (hinj hEq)
        · rcases hBmap with hBm | hBm
          · exfalso
            have hEq : B.map (MulAut.conj φ).toMonoidHom =
                (lBar V₀ V hV L).map (MulAut.conj φ).toMonoidHom := by rw [hBm, hH]
            exact hne (hinj hEq)
          · exact Or.inr ⟨hH, hBm, by rw [hUmap, hH, ← hu'eq],
              by rw [hWBmap, hBm]; rfl⟩
      swap := ⟨t, htT, hHtB, hWt⟩ }

end CFSG.LocalAnalysis.UniquenessCase.PartTwo
