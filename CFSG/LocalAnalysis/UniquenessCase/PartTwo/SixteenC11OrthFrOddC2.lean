theorem s16c11_fr_enc4_inj {t s : ℕ × ℕ × ℕ}
    (ht1 : t.1 < 256) (ht2 : t.2.1 < 256) (ht3 : t.2.2 < 256)
    (hs1 : s.1 < 256) (hs2 : s.2.1 < 256) (hs3 : s.2.2 < 256)
    (h : s16c11_fr_enc4 t = s16c11_fr_enc4 s) : t = s := by
  unfold s16c11_fr_enc4 at h
  have h1 : t.1 = s.1 := by omega
  have h2 : t.2.1 = s.2.1 := by omega
  have h3 : t.2.2 = s.2.2 := by omega
  exact Prod.ext h1 (Prod.ext h2 h3)

theorem s16c11_fr_trips4_lt4 : ∀ t ∈ s16c11_fr_trips4,
    t.1 < 256 ∧ t.2.1 < 256 ∧ t.2.2 < 256 := by
  have h : s16c11_fr_trips4.all
      (fun t => decide (t.1 < 256 ∧ t.2.1 < 256 ∧ t.2.2 < 256)) = true := by
    decide +kernel
  intro t ht
  exact of_decide_eq_true (List.all_eq_true.mp h t ht)

theorem s16c11_fr_mem_tableCodes4_of_mem_trips4 {t : ℕ × ℕ × ℕ}
    (h : t ∈ s16c11_fr_trips4) : t ∈ s16c11_fr_tableCodes4 := by
  obtain ⟨k, hk⟩ := List.mem_iff_get.1 h
  rw [s16c11_fr_tableCodes4]
  refine Finset.mem_image.2 ⟨⟨k.1, by simpa [s16c11_fr_trips4_length] using k.2⟩,
    Finset.mem_univ _, ?_⟩
  rw [s16c11_fr_codeTriple4,
    List.getD_eq_getElem (l := s16c11_fr_trips4) (d := (0, 0, 0))
      (by simpa [s16c11_fr_trips4_length] using k.2)]
  exact hk

theorem s16c11_fr_ofNat_ne_zero4 (i : Fin 256) :
    s16c11_fr_ofNat 4 i.1 ≠ 0 ↔ i.1 ≠ 0 := by
  constructor
  · intro h h0
    apply h
    rw [h0]
    decide
  · intro h h0
    apply h
    have hnat := s16c11_fr_nat_ofNat (m := 4) (Or.inr rfl) i.1 i.2
    rw [h0] at hnat
    have hz : s16c11_fr_nat 4 (0 : S16C11FrVec 4) = 0 := by decide
    rw [hz] at hnat
    exact hnat.symm

theorem s16c11_fr_add_ofNat4 (i j : Fin 256) :
    s16c11_fr_ofNat 4 i.1 + s16c11_fr_ofNat 4 j.1 = s16c11_fr_ofNat 4 (i.1 ^^^ j.1) := by
  have h := s16c11_fr_nat_add (m := 4) (Or.inr rfl)
    (s16c11_fr_ofNat 4 i.1) (s16c11_fr_ofNat 4 j.1)
  rw [s16c11_fr_nat_ofNat (m := 4) (Or.inr rfl) i.1 i.2,
    s16c11_fr_nat_ofNat (m := 4) (Or.inr rfl) j.1 j.2] at h
  rw [← h, s16c11_fr_ofNat_nat (Or.inr rfl)]

@[expose] def s16c11_fr_validCodeNat4 (i j : ℕ) : Bool :=
  decide (i ≠ 0) && decide (j ≠ 0) && decide (i ^^^ j ≠ 0) &&
    Nat.testBit s16c11_fr_QZ4 i && Nat.testBit s16c11_fr_QZ4 j &&
    Nat.testBit s16c11_fr_QZ4 (i ^^^ j)

theorem s16c11_fr_validCode4_iff (i j : Fin 256) :
    s16c11_fr_validCode 4 i.1 j.1 ↔ s16c11_fr_validCodeNat4 i.1 j.1 = true := by
  have hxor : i.1 ^^^ j.1 < 256 := by
    simpa using Nat.xor_lt_two_pow (n := 8) i.2 j.2
  simp only [s16c11_fr_validCode, s16c11_fr_validCodeNat4, Bool.and_eq_true_iff,
    decide_eq_true_eq, s16c11_fr_ofNat_ne_zero4 ⟨i.1, i.2⟩,
    s16c11_fr_ofNat_ne_zero4 ⟨j.1, j.2⟩,
    s16c11_fr_ofNat_ne_zero4 ⟨i.1 ^^^ j.1, hxor⟩, s16c11_fr_add_ofNat4,
    s16c11_fr_QZ4_spec ⟨i.1, i.2⟩, s16c11_fr_QZ4_spec ⟨j.1, j.2⟩,
    s16c11_fr_QZ4_spec ⟨i.1 ^^^ j.1, hxor⟩]
  tauto

theorem s16c11_fr_encKeys4_eq : s16c11_fr_encKeys4 = s16c11_fr_trips4.map s16c11_fr_enc4 := by
  decide +kernel

@[expose] def s16c11_fr_inTableNat4 (t : ℕ × ℕ × ℕ) : Bool :=
  s16c11_fr_encKeys4.elem (s16c11_fr_enc4 t)

theorem s16c11_fr_inTableNat4_imp {t : ℕ × ℕ × ℕ}
    (ht1 : t.1 < 256) (ht2 : t.2.1 < 256) (ht3 : t.2.2 < 256)
    (h : s16c11_fr_inTableNat4 t = true) : t ∈ s16c11_fr_tableCodes4 := by
  unfold s16c11_fr_inTableNat4 at h
  rw [List.elem_iff, s16c11_fr_encKeys4_eq, List.mem_map] at h
  obtain ⟨s, hs, hst⟩ := h
  obtain ⟨hs1, hs2, hs3⟩ := s16c11_fr_trips4_lt4 s hs
  have hst' : s = t := s16c11_fr_enc4_inj hs1 hs2 hs3 ht1 ht2 ht3 hst
  rw [← hst']
  exact s16c11_fr_mem_tableCodes4_of_mem_trips4 hs

theorem s16c11_fr_sort3_lt4 (i j : Fin 256) :
    (s16c11_fr_sort3 i.1 j.1 (i.1 ^^^ j.1)).1 < 256 ∧
      (s16c11_fr_sort3 i.1 j.1 (i.1 ^^^ j.1)).2.1 < 256 ∧
      (s16c11_fr_sort3 i.1 j.1 (i.1 ^^^ j.1)).2.2 < 256 :=
  s16c11_frK_sort3_lt i.1 j.1 i.2 j.2

@[expose] def s16c11_fr_complete4Row (i : ℕ) : Bool :=
  (List.range 256).all fun j =>
    !s16c11_fr_validCodeNat4 i j ||
      s16c11_fr_inTableNat4 (s16c11_fr_sort3 i j (i ^^^ j))

theorem s16c11_fr_complete4RowA : ∀ i : Fin 256, i.1 < 64 →
    s16c11_fr_complete4Row i.1 = true := by
  intro i _
  exact s16c11_frK_row s16c11_fr_validCodeNat4 rfl s16c11_fr_inTableNat4 (fun t ht => by
    rw [s16c11_fr_inTableNat4, List.elem_iff, s16c11_fr_encKeys4_eq]
    exact List.mem_map_of_mem ht) i.1 i.2

theorem s16c11_fr_complete4RowB : ∀ i : Fin 256, 64 ≤ i.1 → i.1 < 128 →
    s16c11_fr_complete4Row i.1 = true := by
  intro i _ _
  exact s16c11_frK_row s16c11_fr_validCodeNat4 rfl s16c11_fr_inTableNat4 (fun t ht => by
    rw [s16c11_fr_inTableNat4, List.elem_iff, s16c11_fr_encKeys4_eq]
    exact List.mem_map_of_mem ht) i.1 i.2

theorem s16c11_fr_complete4RowC : ∀ i : Fin 256, 128 ≤ i.1 → i.1 < 192 →
    s16c11_fr_complete4Row i.1 = true := by
  intro i _ _
  exact s16c11_frK_row s16c11_fr_validCodeNat4 rfl s16c11_fr_inTableNat4 (fun t ht => by
    rw [s16c11_fr_inTableNat4, List.elem_iff, s16c11_fr_encKeys4_eq]
    exact List.mem_map_of_mem ht) i.1 i.2

theorem s16c11_fr_complete4RowD : ∀ i : Fin 256, 192 ≤ i.1 →
    s16c11_fr_complete4Row i.1 = true := by
  intro i _
  exact s16c11_frK_row s16c11_fr_validCodeNat4 rfl s16c11_fr_inTableNat4 (fun t ht => by
    rw [s16c11_fr_inTableNat4, List.elem_iff, s16c11_fr_encKeys4_eq]
    exact List.mem_map_of_mem ht) i.1 i.2

theorem s16c11_fr_complete4Row_ok (i : Fin 256) : s16c11_fr_complete4Row i.1 = true := by
  rcases lt_or_ge i.1 64 with h | h
  · exact s16c11_fr_complete4RowA i h
  rcases lt_or_ge i.1 128 with h2 | h2
  · exact s16c11_fr_complete4RowB i (by omega) h2
  rcases lt_or_ge i.1 192 with h3 | h3
  · exact s16c11_fr_complete4RowC i (by omega) h3
  · exact s16c11_fr_complete4RowD i (by omega)

theorem s16c11_fr_complete4 :
    ∀ i j : Fin 256, s16c11_fr_validCode 4 i.1 j.1 →
      s16c11_fr_sort3 i.1 j.1 (i.1 ^^^ j.1) ∈ s16c11_fr_tableCodes4 := by
  intro i j hij
  have hnat : s16c11_fr_validCodeNat4 i.1 j.1 = true := (s16c11_fr_validCode4_iff i j).mp hij
  have hrow := s16c11_fr_complete4Row_ok i
  unfold s16c11_fr_complete4Row at hrow
  rw [List.all_eq_true] at hrow
  have hj := hrow j.1 (List.mem_range.mpr j.2)
  have hnot : (!s16c11_fr_validCodeNat4 i.1 j.1) = false := by rw [hnat]; rfl
  have htab : s16c11_fr_inTableNat4 (s16c11_fr_sort3 i.1 j.1 (i.1 ^^^ j.1)) = true := by
    have := hj
    rw [hnot] at this
    simpa using this
  obtain ⟨hb1, hb2, hb3⟩ := s16c11_fr_sort3_lt4 i j
  exact s16c11_fr_inTableNat4_imp hb1 hb2 hb3 htab

end CFSG.LocalAnalysis.UniquenessCase.PartTwo
