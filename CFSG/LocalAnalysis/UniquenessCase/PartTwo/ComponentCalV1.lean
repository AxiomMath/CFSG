theorem inCalV1_of_commutator_ne_bot {D : Data G} {W L : Subgroup G}
    (hW : InCalV D.M W) (hL : L ∈ calC D.M)
    (hLN : D.M ≤ Subgroup.normalizer (L : Set G))
    (hU : UniqueMax D.M (L ⊔ D.T)) (hLW : ⁅L, W⁆ ≠ ⊥) :
    InCalV1 D.M D.T W := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hLM : L ≤ D.M := hL.1.le
  have hLWn : L ≤ Subgroup.normalizer (W : Set G) := hLM.trans hW.2.2.1
  set C : Subgroup G := D.M ⊓ Subgroup.centralizer (W : Set G) with hCdef
  set K : Subgroup G := L ⊓ Subgroup.centralizer (W : Set G) with hKdef
  have hCL : C ≤ D.M := inf_le_left
  have hK_le_L : K ≤ L := inf_le_left
  have hK_le_C : K ≤ C := inf_le_inf hLM le_rfl
  have hconj_inf : ∀ l ∈ L, ∀ k ∈ K, l * k * l⁻¹ ∈ K := by
    intro l hl k hk
    refine Subgroup.mem_inf.2 ⟨?_, ?_⟩
    · exact L.mul_mem (L.mul_mem hl hk.1) (L.inv_mem hl)
    · exact CFSG.GroupTheory.conj_mem_centralizer_of_le_normalizer
        (A := Subgroup.centralizer (W : Set G)) (B := L) (K := W) hLWn le_rfl l hl k hk.2
  have hL_normalizes_K : L ≤ Subgroup.normalizer (K : Set G) := by
    intro l hl
    rw [Subgroup.mem_normalizer_iff]
    intro x
    refine ⟨fun hx => hconj_inf l hl x hx, fun hx => ?_⟩
    have h1 : l⁻¹ * (l * x * l⁻¹) * l ∈ K := by
      simpa using hconj_inf l⁻¹ (L.inv_mem hl) (l * x * l⁻¹) hx
    rwa [show l⁻¹ * (l * x * l⁻¹) * l = x from by group] at h1
  have hKn : (K.subgroupOf L).Normal := Subgroup.normal_subgroupOf_of_le_normalizer hL_normalizes_K
  have hKL : ¬ L ≤ K := by
    intro hLK
    apply hLW
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
    exact hLK.trans inf_le_right
  have hproper : ¬ L ≤ K ⊔ pCoreOf 2 L := by
    intro hle
    exact hKL (CFSG.Quasithin.perfect_le_of_le_sup_pGroup hL.2.1 hK_le_L hconj_inf
      (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 L) (CFSG.LieType.BorelTits.pCoreOf_le 2 L) hle)
  let π : ↥L →* Bar2 L := QuotientGroup.mk' (CFSG.pCore 2 ↥L)
  have hKbar_normal : ((K.subgroupOf L).map π).Normal :=
    hKn.map π (QuotientGroup.mk'_surjective _)
  have hKbar_ne_top : (K.subgroupOf L).map π ≠ ⊤ := by
    intro htop
    apply hproper
    intro x hxL
    have hxbar : π (⟨x, hxL⟩ : ↥L) ∈ (K.subgroupOf L).map π := by
      rw [htop]; exact Subgroup.mem_top _
    obtain ⟨k, hk, hkx⟩ := Subgroup.mem_map.1 hxbar
    have hkK : (k : G) ∈ K := Subgroup.mem_subgroupOf.1 hk
    have hmem : ((k⁻¹ * ⟨x, hxL⟩ : ↥L) : G) ∈ pCoreOf 2 L := by
      refine Subgroup.mem_map.mpr ⟨k⁻¹ * (⟨x, hxL⟩ : ↥L), ?_, rfl⟩
      rw [← QuotientGroup.eq_one_iff]
      change π (k⁻¹ * (⟨x, hxL⟩ : ↥L)) = 1
      rw [map_mul, map_inv, hkx, inv_mul_cancel]
    have hsup := (K ⊔ pCoreOf 2 L).mul_mem (Subgroup.mem_sup_left hkK)
      (Subgroup.mem_sup_right hmem)
    rwa [show (k : G) * ((k⁻¹ * ⟨x, hxL⟩ : ↥L) : G) = x from by simp] at hsup
  have hKbar_center : (K.subgroupOf L).map π ≤ Subgroup.center (Bar2 L) :=
    (CFSG.LocalCores.quasisimple_normal_subgroups
      (CFSG.Quasithin.A3.isQuasisimple_iff_open.mpr hL.2.2) hKbar_normal).resolve_left hKbar_ne_top
  have hcommLK : ⁅L, K⁆ ≤ pCoreOf 2 L := by
    rw [Subgroup.commutator_le]
    intro l hl k hk
    have hkL : k ∈ L := hK_le_L hk
    have hkbar : π (⟨k, hkL⟩ : ↥L) ∈ (K.subgroupOf L).map π :=
      Subgroup.mem_map_of_mem π (Subgroup.mem_subgroupOf.2 hk)
    have hcq : π (⟨l, hl⟩ : ↥L) * π (⟨k, hkL⟩ : ↥L) =
        π (⟨k, hkL⟩ : ↥L) * π (⟨l, hl⟩ : ↥L) :=
      Subgroup.mem_center_iff.1 (hKbar_center hkbar) (π (⟨l, hl⟩ : ↥L))
    have hmemL : ⁅l, k⁆ ∈ L := by
      rw [commutatorElement_def]
      exact L.mul_mem (L.mul_mem (L.mul_mem hl hkL) (L.inv_mem hl)) (L.inv_mem hkL)
    have h1 : π (⟨⁅l, k⁆, hmemL⟩ : ↥L) = 1 := by
      rw [show (⟨⁅l, k⁆, hmemL⟩ : ↥L) = ⁅(⟨l, hl⟩ : ↥L), (⟨k, hkL⟩ : ↥L)⁆ from
        Subtype.ext (by simp [commutatorElement_def])]
      rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm.mpr hcq]
    exact Subgroup.mem_map.mpr ⟨_, (QuotientGroup.eq_one_iff _).1 h1, rfl⟩
  have hLC_le_L : ⁅L, C⁆ ≤ L :=
    (Subgroup.commutator_mono le_rfl hCL).trans
      (Subgroup.le_normalizer_iff_commutator_le_left.mp hLN)
  have hLC_le_cent : ⁅L, C⁆ ≤ Subgroup.centralizer (W : Set G) :=
    CFSG.Goldschmidt75.commutator_le_centralizer_of_centralizes (A := C) (B := L) (K := W)
      inf_le_right hLWn
  have hLC_le_K : ⁅L, C⁆ ≤ K := le_inf hLC_le_L hLC_le_cent
  have hP_normal : D.M ≤ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
    hLN.trans (CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf 2 L)
  have h1 : ⁅⁅L, C⁆, L⁆ ≤ pCoreOf 2 L :=
    (Subgroup.commutator_mono hLC_le_K le_rfl).trans (by
      rw [Subgroup.commutator_comm K L]
      exact hcommLK)
  have h2 : ⁅⁅C, L⁆, L⁆ ≤ pCoreOf 2 L := by
    rw [Subgroup.commutator_comm C L]
    exact h1
  have hLC_le_pCore : ⁅L, C⁆ ≤ pCoreOf 2 L := by
    have h3 := CFSG.GroupTheory.commutator_commutator_le_of_rotate_normal hLM hCL
      ((CFSG.LieType.BorelTits.pCoreOf_le 2 L).trans hLM) hP_normal h1 h2
    rwa [hL.2.1] at h3
  have hpCoreL_le_pCoreM : pCoreOf 2 L ≤ pCoreOf 2 D.M :=
    uc22p22r_pCoreOf_le_of_isSubnormal hL.1
  have hLC_le_T : ⁅L, C⁆ ≤ D.T :=
    hLC_le_pCore.trans (hpCoreL_le_pCoreM.trans (uc22p22e_pCoreOf_le_T D))
  have hLCT_le : ⁅L, D.T ⊓ Subgroup.centralizer (W : Set G)⁆ ≤
      D.T ⊓ Subgroup.centralizer (W : Set G) := by
    refine le_inf ?_ ?_
    · exact (Subgroup.commutator_mono le_rfl
        (inf_le_inf D.sylowM.le (le_refl (Subgroup.centralizer (W : Set G))))).trans hLC_le_T
    · exact CFSG.Goldschmidt75.commutator_le_centralizer_of_centralizes
        (A := D.T ⊓ Subgroup.centralizer (W : Set G)) (B := L) (K := W) inf_le_right hLWn
  have hL_normCT : L ≤ Subgroup.normalizer
      ((D.T ⊓ Subgroup.centralizer (W : Set G) : Subgroup G) : Set G) := by
    rw [Subgroup.le_normalizer_iff_commutator_le_left]
    rw [Subgroup.commutator_comm]
    exact hLCT_le
  have hTCT_le : ⁅D.T, D.T ⊓ Subgroup.centralizer (W : Set G)⁆ ≤
      D.T ⊓ Subgroup.centralizer (W : Set G) := by
    refine le_inf ?_ ?_
    · rw [Subgroup.commutator_le]
      intro t ht c hc
      rw [commutatorElement_def]
      exact D.T.mul_mem (D.T.mul_mem (D.T.mul_mem ht hc.1) (D.T.inv_mem ht)) (D.T.inv_mem hc.1)
    · exact CFSG.Goldschmidt75.commutator_le_centralizer_of_centralizes
        (A := D.T ⊓ Subgroup.centralizer (W : Set G)) (B := D.T) (K := W) inf_le_right
        (D.sylowM.le.trans hW.2.2.1)
  have hT_normCT : D.T ≤ Subgroup.normalizer
      ((D.T ⊓ Subgroup.centralizer (W : Set G) : Subgroup G) : Set G) := by
    rw [Subgroup.le_normalizer_iff_commutator_le_left]
    rw [Subgroup.commutator_comm]
    exact hTCT_le
  refine ⟨hW, uc22p22u_uniqueMax_mono D ?_ inf_le_left hU⟩
  exact le_inf (sup_le hLM D.sylowM.le) (sup_le hL_normCT hT_normCT)

theorem barSub_ne_bot_of_uniqueMax {D : Data G} (h127 : R127 D) {V₀ V : Subgroup G}
    (h : Hyp125 D V₀ V) (h117 : C117 D V₀ V)
    {L : Subgroup G} (hL : L ∈ calC D.M) (hU : UniqueMax D.M L) :
    barSub V₀ V h.isElemAbelian L ≠ ⊥ := by
  intro hbot
  have hp := h.pairFacts
  have hLct : L ≤ F11.CTilde D.M V₀ V :=
    (CFSG.LocalAnalysis.WeakClosure81.barSub_eq_bot_iff h.isElemAbelian
      hp.le_normalizer hp.le_normalizer₀ hL.1.le).1 hbot
  have hCM : F11.CTilde D.M V₀ V ≤ D.M := by
    intro x hx
    simp only [F11.CTilde, Subgroup.mem_iInf] at hx
    exact (hx 1 V.one_mem).1
  have hsub : CFSG.Open.IsSubnormal L (F11.CTilde D.M V₀ V) := by
    have h := hL.1.inf (F11.CTilde D.M V₀ V)
    rwa [inf_eq_left.2 hLct, inf_eq_right.2 hCM] at h
  have hmem : L ∈ calC (F11.CTilde D.M V₀ V) := ⟨hsub, hL.2.1, hL.2.2⟩
  have hLN : D.M ≤ Subgroup.normalizer (L : Set G) := (h117 L hmem).1
  have hU' : UniqueMax D.M (L ⊔ D.T) :=
    uc22p22u_uniqueMax_mono D le_sup_left (sup_le hL.1.le D.sylowM.le) hU
  have hLV0 : ⁅L, V₀⁆ = ⊥ := by
    by_contra hLV0ne
    have hV0ne : V₀ ≠ ⊥ := by
      intro h0
      apply hLV0ne
      rw [h0, Subgroup.commutator_bot_right]
    have hV0 : InCalV D.M V₀ := by
      rcases h.1 with ⟨-, hbot⟩ | ⟨h0, -, -⟩
      · exact absurd hbot hV0ne
      · exact h0.1
    have h8 : 8 ≤ Nat.card V₀ := by
      by_contra hlt
      have hV04 : Nat.card V₀ ≤ 4 := by
        obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp
          (CFSG.Quasithin.B2F.isPGroup_of_isElemAbelian hV0.2.2.2)
        rw [hn] at hlt ⊢
        have h2 : n ≤ 2 := by
          by_contra h
          have h3 : 3 ≤ n := by omega
          have h4 : 2 ^ 3 ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) h3
          omega
        exact Nat.pow_le_pow_right (by norm_num) h2
      have hcent : L ≤ Subgroup.centralizer (V₀ : Set G) :=
        CFSG.SeitzReduction.LinearPilot.le_centralizer_of_perfect_of_card_le_four
          hL.2.1 (hL.1.le.trans hV0.2.2.1) hV04
      exact hLV0ne (Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hcent)
    have hnotV1 : ¬ InCalV1 D.M D.T V₀ := (twelve_nine D h127 h).2 h8 |>.1
    exact hnotV1 (inCalV1_of_commutator_ne_bot hV0 hL hLN hU' hLV0ne)
  have hLcent : L ≤ Subgroup.centralizer (V₀ : Set G) :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp hLV0
  have hLV_le : ⁅L, V⁆ ≤ V₀ := by
    rw [Subgroup.commutator_le]
    intro l hl v hv
    have hmem : l ∈ F11.CTilde D.M V₀ V := hLct hl
    simp only [F11.CTilde, Subgroup.mem_iInf] at hmem
    have hmem2 : l ∈ F11.CElt D.M V₀ v := hmem v hv
    simpa [commutatorElement_def] using hmem2.2.2
  have hLV : ⁅L, V⁆ = ⊥ :=
    CFSG.GroupTheory.commutator_eq_bot_of_commutator_le_of_centralizer hLV_le hLcent hL.2.1
  have hcentV : L ≤ Subgroup.centralizer (V : Set G) :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp hLV
  exact (twelve_nine D h127 h).1
    (uc22p22u_isTI_of_uniqueMax D h.isElemAbelian hp.le_normalizer hcentV hU)


theorem barSub_mem_compBar_of_uniqueMax {D : Data G} (h127 : R127 D) {V₀ V : Subgroup G}
    (h : Hyp125 D V₀ V) (h117 : C117 D V₀ V)
    {L : Subgroup G} (hL : L ∈ calC D.M) (hU : UniqueMax D.M L) :
    barSub V₀ V h.isElemAbelian L ∈ compBar D.M V₀ V h.isElemAbelian :=
  barSub_mem_compBar_of_ne_bot h hL
    (barSub_ne_bot_of_uniqueMax h127 h h117 hL hU)

theorem commutator_U_eq_bot_of_uniqueMax {D : Data G} {V₀ V L : Subgroup G}
    (h : Hyp125 D V₀ V) (hV₀ : V₀ ≠ ⊥)
    (hL : L ∈ calC D.M) (hLN : D.M ≤ Subgroup.normalizer (L : Set G))
    (hU : UniqueMax D.M (L ⊔ D.T)) :
    L ≤ Subgroup.centralizer (D.U : Set G) := by
  by_contra hcomm
  have hcomm' : ⁅L, D.U⁆ ≠ ⊥ := fun hbot =>
    hcomm (Subgroup.commutator_eq_bot_iff_le_centralizer.mp hbot)
  have hUin : InCalV D.M D.U := uc22p22e_inCalV_U D
  have hV1 : InCalV1 D.M D.T D.U :=
    inCalV1_of_commutator_ne_bot hUin hL hLN hU hcomm'
  have h8 : 8 ≤ Nat.card D.U := by
    by_contra hlt
    have hU4 : Nat.card D.U ≤ 4 := by
      obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp
        (CFSG.Quasithin.B2F.isPGroup_of_isElemAbelian hUin.2.2.2)
      rw [hn] at hlt ⊢
      have h2 : n ≤ 2 := by
        by_contra h
        have h3 : 3 ≤ n := by omega
        have h4 : 2 ^ 3 ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) h3
        omega
      exact Nat.pow_le_pow_right (by norm_num) h2
    have hcent : L ≤ Subgroup.centralizer (D.U : Set G) :=
      CFSG.SeitzReduction.LinearPilot.le_centralizer_of_perfect_of_card_le_four
        hL.2.1 (hL.1.le.trans hUin.2.2.1) hU4
    exact hcomm' (Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hcent)
  have hTwo : TwoReduced D.M D.U := by
    have hZ : D.Z ≤ Subgroup.centralizer (D.T : Set G) := fun x hx =>
      (CFSG.LocalAnalysis.RankThreeUC.omegaOneCenterIn_le_inf_centralizer D.T hx).2
    simpa [Data.U, Data.Z, CFSG.LocalAnalysis.RankThreeUC.uCore] using
      uc22p22na_twoReduced_iSup_conj D.sylowM hZ
  have hNoW : ∀ W : Subgroup G, ¬ InCalW D.M D.T W := by
