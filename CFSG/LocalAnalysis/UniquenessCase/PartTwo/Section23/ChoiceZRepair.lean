private theorem UC22pwrLift.pow_eq_one {L : Subgroup G} {F : Subgroup (Bar2 L)} {A : Subgroup G}
    (h : UC22pwrLift L F A) {k : ℕ} (hk : ∀ x ∈ F, x ^ k = 1) :
    ∀ a ∈ A, a ^ k = 1 := by
  intro a ha
  have h1 : h.equiv ((⟨a, ha⟩ : ↥A) ^ k) = h.equiv 1 := by
    rw [map_pow, map_one]
    exact Subtype.ext (hk _ (h.equiv ⟨a, ha⟩).2)
  simpa using congrArg Subtype.val (h.equiv.injective h1)

private theorem UC22pwrLift.exists_noncyclic {L : Subgroup G} {F : Subgroup (Bar2 L)}
    {A : Subgroup G} (h : UC22pwrLift L F A) {p : ℕ}
    (hnc : ∃ Q : Subgroup (Bar2 L), Q ≤ F ∧ ¬ IsCyclic ↥Q ∧ ∀ x ∈ Q, x ^ p = 1) :
    ∃ Q : Subgroup G, Q ≤ A ∧ ¬ IsCyclic ↥Q ∧ ∀ x ∈ Q, x ^ p = 1 := by
  obtain ⟨QF, hQF, hQFnc, hQFexp⟩ := hnc
  let Q : Subgroup G := uc22pwrRestrict h QF
  have hQl : UC22pwrLift L QF Q := h.restrict hQF
  refine ⟨Q, fun x hx => hx.1, ?_, ?_⟩
  · intro hQcyc
    letI : IsCyclic ↥Q := hQcyc
    exact hQFnc (isCyclic_of_surjective hQl.equiv hQl.equiv.surjective)
  · intro x hx
    have h1 : hQl.equiv ((⟨x, hx⟩ : ↥Q) ^ p) = hQl.equiv 1 := by
      rw [map_pow, map_one]
      exact Subtype.ext (hQFexp _ (hQl.maps x hx))
    simpa using congrArg Subtype.val (hQl.equiv.injective h1)

private theorem exists_lift_of_full_torus (D : Data G) {L : Subgroup G} (hL : L ∈ calL D.T D.M)
    {F : Subgroup (Bar2 L)} {k : ℕ}
    (hFU : F ≤ normalizer ((uc22p20iSylowBar D L : Subgroup (Bar2 L)) : Set (Bar2 L)))
    (hFodd : Odd (Nat.card F)) (hFab : IsMulCommutative ↥F) (hFsqf : Squarefree k)
    (hFpow : ∀ x ∈ F, x ^ k = 1)
    (hFnc : ∀ p : ℕ, p.Prime → p ∣ Nat.card F →
      ∃ Q ≤ F, ¬ IsCyclic ↥Q ∧ ∀ x ∈ Q, x ^ p = 1)
    (hFinv : ∀ (s : G) (hs : s ∈ normalizer (L : Set G)), s ∈ D.T → ∀ x ∈ F,
      uc22p20uInd L s hs x ∈ F ⊔ uc22p20iSylowBar D L) :
    ∃ A : Subgroup G, UC22pwrLift L F A ∧ IsMulCommutative ↥A ∧ Odd (Nat.card A) ∧
      Permutes A D.T ∧ (∀ x ∈ A, x ^ k = 1) ∧
      (∀ p : ℕ, p.Prime → p ∣ Nat.card A →
        ∃ Q ≤ A, ¬ IsCyclic ↥Q ∧ ∀ x ∈ Q, x ^ p = 1) ∧
      A ≤ normalizer ((D.T ⊓ L : Subgroup G) : Set G) ∧ piSet A = piSet F := by
  obtain ⟨A, hA⟩ := uc22pwr_exists_lift L hFodd
  haveI : IsMulCommutative ↥F := hFab
  have hAodd : Odd (Nat.card A) := by
    rw [hA.card_eq]
    exact hFodd
  have hAperm : Permutes A D.T :=
    uc22pwr_permutes D hL hA hFU fun s hs hsT x hx => hFinv s hs hsT x hx
  have hkA : ∀ x ∈ A, x ^ k = 1 := hA.pow_eq_one hFpow
  have hncA : ∀ p : ℕ, p.Prime → p ∣ Nat.card A →
      ∃ Q ≤ A, ¬ IsCyclic ↥Q ∧ ∀ x ∈ Q, x ^ p = 1 := by
    intro p hp hpA
    exact hA.exists_noncyclic (hFnc p hp (by rwa [← hA.card_eq]))
  refine ⟨A, hA, hA.isMulCommutative, hAodd, hAperm, hkA, hncA,
    hA.le_normalizer D hL hFU, ?_⟩
  unfold piSet
  rw [hA.card_eq]

private theorem exists_faithful_of_lift (D : Data G) {A : Subgroup G} {k : ℕ}
    (hAab : IsMulCommutative ↥A) (hAodd : Odd (Nat.card A)) (hAperm : Permutes A D.T)
    (hkA : ∀ x ∈ A, x ^ k = 1) (hsq : Squarefree k)
    (hncA : ∀ p : ℕ, p.Prime → p ∣ Nat.card A →
      ∃ Q ≤ A, ¬ IsCyclic ↥Q ∧ ∀ x ∈ Q, x ^ p = 1)
    (hcycA : IsCyclic ↥(A ⊓ Subgroup.centralizer (D.Z : Set G)))
    (hAZ : A ≤ Subgroup.normalizer (D.Z : Set G)) :
    ∃ B' : Subgroup G, B' ≤ A ∧ B' ≤ Subgroup.normalizer (D.T : Set G) ∧ IsCyclic B' ∧
      Squarefree (Nat.card B') ∧
      (∀ p : ℕ, p.Prime → (p ∣ Nat.card B' ↔ p ∣ Nat.card A)) ∧
      B' ⊓ Subgroup.centralizer (D.Z : Set G) = ⊥ := by
  have hTZ : D.T ≤ Subgroup.centralizer (D.Z : Set G) := le_centralizer_omegaOneCenterIn D.T
  refine exists_cyclic_le_normalizer_inf_centralizer_eq_bot hAab hkA hsq hncA hcycA ?_
  intro a ha
  exact exists_mul_mem_normalizer_mem_centralizer hAodd D.sylowM.isPGroup hAperm hAZ hTZ ha

private theorem invertedOutside_of_full_torus (D : Data G) (hB : ListBNonabelian)
    (h1930 : H1930 D) {L A : Subgroup G} (hL : L ∈ calL D.T D.M)
    {F : Subgroup (Bar2 L)}
    (hFU : F ≤ normalizer ((uc22p20iSylowBar D L : Subgroup (Bar2 L)) : Set (Bar2 L)))
    (hA : UC22pwrLift L F A) (hAodd : Odd (Nat.card A)) (w : Bar2 L) (hw2 : w ^ 2 = 1)
    (hwinvF : ∀ x ∈ F, w * x * w⁻¹ = x⁻¹)
    (hgen : normalizer ((uc22p20iSylowBar D L : Subgroup (Bar2 L)) : Set (Bar2 L)) ⊔
      Subgroup.zpowers w = ⊤) :
    InvertedOutside D.M L A := by
  have hinvA : ∀ a : ↥L, (a : G) ∈ A →
      w * QuotientGroup.mk a * w⁻¹ = (QuotientGroup.mk a)⁻¹ := by
    intro a ha
    have h1 := hwinvF _ (hA.maps _ ha)
    rwa [uc22pwrBar_of_mem a.2] at h1
  obtain ⟨r, ⟨j, hj⟩, hrw, hrinv⟩ := uc22pw_exists_inverting hA.le hAodd w hw2 hinvA
  refine ⟨(r : G), r.2, ?_, ⟨j, hj⟩, hrinv⟩
  refine uc22pw_not_mem_M D hB h1930 hL (r := r) ?_
  rw [hrw]
  exact hgen

theorem choice214U_of_le_normalizer (D : Data G) {L₀ B₀ : Subgroup G} (hodd : Odd (Nat.card B₀))
    (hBN : B₀ ≤ normalizer (D.T : Set G)) : Choice214U D L₀ B₀ := by
  have hc : ∀ t ∈ D.T, t ∈ normalizer (B₀ : Set G) → ∀ b ∈ B₀, t * b * t⁻¹ = b :=
    fun t htT htB b hb => ch214_conj_eq D.sylowM.isPGroup hodd hb (hBN hb) htT htB
  refine ⟨fun hne t htT htB hinv => hne ?_, fun _ s hsT t _ hsB _ hs _ => ?_⟩
  · rw [eq_bot_iff]
    intro b hb
    have h1 := hinv b hb
    rw [hc t htT htB b hb] at h1
    rw [Subgroup.mem_bot]
    refine ch214_eq_one_of_sq hodd hb ?_
    rw [sq]
    nth_rewrite 2 [h1]
    exact mul_inv_cancel b
  · obtain ⟨-, b, hb, hne⟩ := hs
    exact absurd (hc s hsT hsB b hb) hne

private theorem exists_choice2011Out_of_full_two (D : Data G) (hB : ListBNonabelian)
    (h1930 : H1930 D) {L : Subgroup G} (hL : L ∈ calL D.T D.M)
    (hNZ : L ⊓ Subgroup.normalizer ((D.T ⊓ L : Subgroup G) : Set G) ≤
      Subgroup.normalizer (D.Z : Set G))
    {F : Subgroup (Bar2 L)} {k m : ℕ}
    (hFU : F ≤ normalizer ((uc22p20iSylowBar D L : Subgroup (Bar2 L)) : Set (Bar2 L)))
    (hFab : IsMulCommutative ↥F) (hFodd : Odd (Nat.card F)) (hFsqf : Squarefree k)
    (hFpow : ∀ x ∈ F, x ^ k = 1) (hFpi : piSet F = etaSet m)
    (hFnc : ∀ p : ℕ, p.Prime → p ∣ Nat.card F →
      ∃ Q ≤ F, ¬ IsCyclic ↥Q ∧ ∀ x ∈ Q, x ^ p = 1)
    (hFinv : ∀ (s : G) (hs : s ∈ normalizer (L : Set G)), s ∈ D.T → ∀ x ∈ F,
      uc22p20uInd L s hs x ∈ F ⊔ uc22p20iSylowBar D L)
    {w : Bar2 L} (hw2 : w ^ 2 = 1) (hwinvF : ∀ x ∈ F, w * x * w⁻¹ = x⁻¹)
    (hgen : normalizer ((uc22p20iSylowBar D L : Subgroup (Bar2 L)) : Set (Bar2 L)) ⊔
      Subgroup.zpowers w = ⊤)
    (hcyc : ∀ A : Subgroup G, A ≤ L → IsMulCommutative ↥A → Odd (Nat.card ↥A) →
      Permutes A D.T → IsCyclic ↥(A ⊓ Subgroup.centralizer (D.Z : Set G))) :
    ∃ B' : Subgroup G, Choice214U D L B' ∧ Choice2011Out D L B' m ∧
      B' ⊓ Subgroup.centralizer (D.Z : Set G) = ⊥ := by
  obtain ⟨A, hA, hAab, hAodd, hAperm, hkA, hncA, hAS, hpiA⟩ :=
    exists_lift_of_full_torus D hL hFU hFodd hFab hFsqf hFpow hFnc hFinv
  have hAZ : A ≤ Subgroup.normalizer (D.Z : Set G) := (le_inf hA.le hAS).trans hNZ
  have hcycA : IsCyclic ↥(A ⊓ Subgroup.centralizer (D.Z : Set G)) :=
    hcyc A hA.le hAab hAodd hAperm
  obtain ⟨B', hB'A, hB'N, hB'cyc, hB'sqf, hB'dvd, hB'bot⟩ :=
    exists_faithful_of_lift D hAab hAodd hAperm hkA hFsqf hncA hcycA hAZ
  obtain ⟨r, hrL, hrM, hr2, hrinv⟩ :=
    invertedOutside_of_full_torus D hB h1930 hL hFU hA hAodd w hw2 hwinvF hgen
  have hB'L : B' ≤ L := hB'A.trans hA.le
  have hB'odd : Odd (Nat.card B') := Odd.of_dvd_nat hAodd (Subgroup.card_dvd_of_le hB'A)
  have hB'perm : Permutes B' D.T := by
    change (B' : Set G) * (D.T : Set G) = (D.T : Set G) * (B' : Set G)
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right B' D.T hB'N,
      ← Subgroup.coe_mul_of_right_le_normalizer_left D.T B' hB'N, sup_comm]
  have hpiB'A : piSet B' = piSet A := by
    ext p
    exact ⟨fun hp => ⟨hp.1, (hB'dvd p hp.1).1 hp.2⟩,
      fun hp => ⟨hp.1, (hB'dvd p hp.1).2 hp.2⟩⟩
  have hpiB' : piSet B' = etaSet m := hpiB'A.trans (hpiA.trans hFpi)
  have hB'M : B' ≤ D.M := by
    intro b hb
    have hbA : b ∈ A := hB'A hb
    have hbar : QuotientGroup.mk' (CFSG.pCore 2 ↥L) ⟨b, hA.le hbA⟩ ∈
        normalizer ((uc22p20iSylowBar D L : Subgroup (Bar2 L)) : Set (Bar2 L)) := by
      have := hFU (hA.maps b hbA)
      rwa [uc22pwrBar_of_mem (hA.le hbA)] at this
    exact uc22p20i_borel_le_M D hB h1930 hL ⟨b, hA.le hbA⟩ hbar
  have hB'alpha : AlphaCond D.T B' m := by
    intro e mm hm hnm
    exact (iSup₂_le fun N hN => hN.1).trans hB'N
  have hB'calB : B' ∈ calB D.T D.M L :=
    ⟨hB'L, hB'cyc, hB'sqf, hB'odd, hB'perm,
      ⟨r, hrL, hrM, hr2, fun x hx => hrinv x (hB'A hx)⟩⟩
  exact ⟨B', choice214U_of_le_normalizer D hB'odd hB'N,
    ⟨mem_calB1_of_mem_calB hB'calB, hpiB', hB'alpha, hB'M⟩, hB'bot⟩

theorem exists_faithful_choice2011Out_of_isL2Square (hE : UC22P20gExcFacts)
    (hR1 : uc22pwCartanRankOne) (hu38 : uc22p20oU38Witness) (hB : ListBNonabelian)
    {D : Data G} {Ch : Choice2011 G} (h207 : S20_7 D) (h1930 : H1930 D) (c : Ctx23L D Ch)
    (hsq : IsL2Square (Bar2 c.L0) (CFSG.Open.pRank 2 D.Z))
    (hcyc : ∀ A : Subgroup G, A ≤ c.L0 → IsMulCommutative ↥A → Odd (Nat.card ↥A) →
      Permutes A D.T → IsCyclic ↥(A ⊓ Subgroup.centralizer (D.Z : Set G)))
    (hNZ : c.L0 ⊓ Subgroup.normalizer ((D.T ⊓ c.L0 : Subgroup G) : Set G) ≤
      Subgroup.normalizer (D.Z : Set G)) :
    ∃ B' : Subgroup G, Choice214U D c.L0 B' ∧ Choice2011Out D c.L0 B' (CFSG.Open.pRank 2 D.Z) ∧
      B' ⊓ Subgroup.centralizer (D.Z : Set G) = ⊥ := by
  let m := CFSG.Open.pRank 2 D.Z
  have hnm : c.n = m := kNshape_holds G c.L0 c.n m c.hn (Or.inr hsq)
  have hn : NParam c.L0 m := hnm ▸ c.hn
  obtain ⟨hm2, hcases⟩ := uc22pw_cases hE D h1930 h207 c.hL0 hn
  rcases hcases with ⟨hq, -⟩ | ⟨hq, -⟩ |
    ⟨K, K₂, t, htT, hK, hK₂, hne, hLK, ht, hsh⟩
  · exact absurd hq (not_isQuasisimple_of_isL2Square hsq)
  · exact absurd hq (not_isQuasisimple_of_isL2Square hsq)
  · obtain ⟨F, k, hFU, hFab, hFodd, hFsqf, hFpow, hFpi, hFnc, hFinv, hFw⟩ :=
      uc22pw_full_two hR1 hu38 D c.hL0.prop hK hK₂ hne hLK htT ht hm2 hsh
    obtain ⟨w, hw2, hwinvF, hgen⟩ := hFw
    exact exists_choice2011Out_of_full_two D hB h1930 c.hL0.prop hNZ hFU hFab hFodd hFsqf
      hFpow hFpi hFnc hFinv hw2 hwinvF hgen hcyc

theorem choice2011ZRepair_choiceZ (hE : UC22P20gExcFacts) (hR1 : uc22pwCartanRankOne)
    (hu38 : uc22p20oU38Witness) (hB : ListBNonabelian) (D : Data G) (h207 : S20_7 D)
    (hL2 : S23_5_lineL2 D (ChoiceZ D)) (hOP : S23_5_lineOmegaPlus D (ChoiceZ D)) :
    Choice2011ZRepair D (ChoiceZ D) := by
  refine choice2011ZRepair_choiceZ_of fun h1930 c hcn => ?_
  let c₀ : Ctx23L D (ChoiceZ D) := { c with B := c.B0, hB := c.hB0, hle := le_rfl }
  rcases hL2 h1930 c₀ with ⟨-, hbot⟩ | h2m | hsq
