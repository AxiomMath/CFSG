theorem exists_mulEquiv_omegaMinusQZero {K : Type} [Field K] [Finite K] [CharP K 2] {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    ∃ φ : ↥(StatedOmega (StatedQuadMinus 4 K b c)) ≃* OmegaMinusE K b c,
      (omegaMinusQZero K b c).map φ.toMonoidHom = omegaMinusTailQZero K b c :=
  KTabD.exists_mulEquiv_lineStab_map_eq_orthParab hirr 1

theorem map_symm_omegaMinusTailQZero {K : Type} [Field K] {b c : K}
    (φ : ↥(StatedOmega (StatedQuadMinus 4 K b c)) ≃* OmegaMinusE K b c)
    (hφ : (omegaMinusQZero K b c).map φ.toMonoidHom = omegaMinusTailQZero K b c) :
    (omegaMinusTailQZero K b c).map φ.symm.toMonoidHom = omegaMinusQZero K b c := by
  rw [← hφ, Subgroup.map_map,
    show φ.symm.toMonoidHom.comp φ.toMonoidHom = MonoidHom.id _ from
      MulEquiv.toMonoidHom_symm_comp_toMonoidHom _, Subgroup.map_id]

theorem map_symm_omegaMinusTailQAlpha {K : Type} [Field K] {b c : K}
    (φ : ↥(StatedOmega (StatedQuadMinus 4 K b c)) ≃* OmegaMinusE K b c) :
    (omegaMinusTailQAlpha K b c).map φ.symm.toMonoidHom = omegaMinusQAlpha φ :=
  (Subgroup.comap_equiv_eq_map_symm' φ _).symm

theorem leastParabolic_omegaMinusQAlpha {K : Type} [Field K] [Finite K] [CharP K 2] {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (φ : ↥(StatedOmega (StatedQuadMinus 4 K b c)) ≃* OmegaMinusE K b c)
    (hφ : (omegaMinusQZero K b c).map φ.toMonoidHom = omegaMinusTailQZero K b c) :
    IsParabolicTwo ↥(StatedOmega (StatedQuadMinus 4 K b c)) (omegaMinusQAlpha φ) ∧
      (t3U K b c).map φ.symm.toMonoidHom ≤ omegaMinusQAlpha φ ∧
      ¬ omegaMinusQAlpha φ ≤ omegaMinusQZero K b c ∧
      ∀ P : Subgroup ↥(StatedOmega (StatedQuadMinus 4 K b c)),
        IsParabolicTwo ↥(StatedOmega (StatedQuadMinus 4 K b c)) P →
        (t3U K b c).map φ.symm.toMonoidHom ≤ P → ¬ P ≤ omegaMinusQZero K b c →
          omegaMinusQAlpha φ ≤ P := by
  have h := leastParabolic_map φ.symm rfl (isParabolicTwo_omegaMinusTailQAlpha hirr)
    (t3U_le_omegaMinusTailQAlpha hirr) (not_omegaMinusTailQAlpha_le_QZero hirr)
    (fun P hP hU hnot => omegaMinusTailQAlpha_le_of_parabolic hirr hP hU hnot)
  rwa [map_symm_omegaMinusTailQAlpha, map_symm_omegaMinusTailQZero φ hφ] at h

theorem kAdjAt_of_realizes_omegaMinusEight {W : Type} [CommGroup W] [Finite W]
    (H : Subgroup (MulAut W)) {K : Type} [Field K] [Finite K] [CharP K 2] {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) {n : ℕ} (hK : Nat.card K = 2 ^ n) (hn : 2 ≤ n)
    (hreal : (FFModel.nat (StatedOmega (StatedQuadMinus 4 K b c))).Realizes H ⊤ ⊥) :
    KAdjAt W H n := by
  obtain ⟨φ, hφ⟩ := exists_mulEquiv_omegaMinusQZero hirr
  obtain ⟨hpar, hUQ, hnot, hleast⟩ := leastParabolic_omegaMinusQAlpha hirr φ hφ
  refine kAdjAt_of_model H n n (Or.inl rfl) ((t3U K b c).map φ.symm.toMonoidHom)
    (omegaMinusQAlpha φ) (omegaMinusQZero K b c) ?_ hpar hUQ hnot hleast
    (fun r hr hr2 _ t ht hord =>
      kAdj_model_omegaMinusEight hirr hK hn (hr.odd_of_ne_two hr2) φ hφ ht hord)
  intro S
  have hUle : (t3U K b c).map φ.symm.toMonoidHom ≤ omegaMinusQZero K b c := by
    rw [← map_symm_omegaMinusTailQZero φ hφ]
    exact Subgroup.map_mono (t3U_le_omegaMinusTailQZero hirr)
  obtain ⟨U, hUc⟩ : ∃ U : Sylow 2 ↥(StatedOmega (StatedQuadMinus 4 K b c)),
      (U : Subgroup _) = (t3U K b c).map φ.symm.toMonoidHom :=
    ⟨(t3Sylow hirr).mapSurjective (f := φ.symm.toMonoidHom) φ.symm.surjective, by
      change ((t3Sylow hirr : Subgroup _)).map φ.symm.toMonoidHom = _
      rw [t3Sylow_coe]⟩
  obtain ⟨ψ, h1, h2⟩ := exists_mulEquiv_pointStab_eq_map_sylow hreal
    (KTabD.sylowFixedLine_omegaMinus (K := K) (m := 4) (b := b) (c := c) (by norm_num) hirr)
    U (hUc.symm ▸ hUle) S
  exact ⟨ψ, hUc ▸ h1, h2⟩

theorem kAdjAt_omegaMinusEight (W : Type) [CommGroup W] [Finite W] (H : Subgroup (MulAut W))
    (n : ℕ) (h : IsOmega8m ↥H n ∧ NatOmegaMinus H ⊤ ⊥ 8 n) (hn : 3 ≤ n) : KAdjAt W H n := by
  obtain ⟨-, -, K, hKf, hKfin, b, c, hcard, hirr, hreal⟩ := h
  letI : Field K := hKf
  haveI : Finite K := hKfin
  haveI : CharP K 2 := uc22p22d_charP_two (by omega) hcard
  exact kAdjAt_of_realizes_omegaMinusEight H hirr hcard (by omega) hreal

