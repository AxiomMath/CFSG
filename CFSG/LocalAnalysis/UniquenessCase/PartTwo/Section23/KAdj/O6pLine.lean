theorem omegaPlusEmb_eq_subtype_comp (K : Type) [Field K] :
    omegaPlusEmb K = (splitE K).subtype.comp (plusDerivedEquiv 3 K le_rfl).toMonoidHom :=
  rfl

theorem map_symm_plusFlagStab_alpha (K : Type) [Field K] :
    ((plusFlagStab K 3 ({2, 3} : Finset ℕ)).subgroupOf (splitE K)).map
      (plusDerivedEquiv 3 K le_rfl).symm.toMonoidHom = omegaPlusQAlpha K := by
  rw [← Subgroup.comap_equiv_eq_map_symm']
  rfl

theorem map_symm_plusFlagStab_one (K : Type) [Field K] :
    ((plusFlagStab K 3 ({1} : Finset ℕ)).subgroupOf (splitE K)).map
      (plusDerivedEquiv 3 K le_rfl).symm.toMonoidHom = omegaPlusQZero K := by
  have h := map_omegaPlusQZero K
  rw [omegaPlusEmb_eq_subtype_comp, ← Subgroup.map_map] at h
  rw [← h, Subgroup.subgroupOf,
    Subgroup.comap_map_eq_self_of_injective (splitE K).subtype_injective]
  rw [Subgroup.map_map, show (plusDerivedEquiv 3 K le_rfl).symm.toMonoidHom.comp
    (plusDerivedEquiv 3 K le_rfl).toMonoidHom = MonoidHom.id _ from
    MulEquiv.toMonoidHom_symm_comp_toMonoidHom _, Subgroup.map_id]

theorem map_symm_posUnip_subgroupOf (K : Type) [Field K] :
    ((posUnip 3 K).subgroupOf (splitE K)).map (plusDerivedEquiv 3 K le_rfl).symm.toMonoidHom =
      plusDerivedUnipotent 3 K := by
  rw [← plusDerivedUnipotent_map 3 K le_rfl, Subgroup.map_map,
    show (plusDerivedEquiv 3 K le_rfl).symm.toMonoidHom.comp
      (plusDerivedEquiv 3 K le_rfl).toMonoidHom = MonoidHom.id _ from
      MulEquiv.toMonoidHom_symm_comp_toMonoidHom _, Subgroup.map_id]

theorem exists_sylow_plusDerivedUnipotent (K : Type) [Field K] [Finite K] [CharP K 2] :
    ∃ U : Sylow 2 ↥(StatedOmega (StatedQuadPlus 3 K)),
      (U : Subgroup ↥(StatedOmega (StatedQuadPlus 3 K))) = plusDerivedUnipotent 3 K := by
  obtain ⟨S, hS⟩ := posUnip_isSylow (K := K) (p := 2) (r := 3) (by norm_num)
    (fun a ha => map_flag_top_ne_Xstar (K := K) (by norm_num) ha)
  refine ⟨S.mapSurjective (f := (plusDerivedEquiv 3 K le_rfl).symm.toMonoidHom)
    (plusDerivedEquiv 3 K le_rfl).symm.surjective, ?_⟩
  change (S : Subgroup _).map (plusDerivedEquiv 3 K le_rfl).symm.toMonoidHom = _
  rw [hS]
  exact map_symm_posUnip_subgroupOf K

theorem plusDerivedUnipotent_le_omegaPlusQZero (K : Type) [Field K] :
    plusDerivedUnipotent 3 K ≤ omegaPlusQZero K := by
  rw [← map_symm_posUnip_subgroupOf K, ← map_symm_plusFlagStab_one K]
  exact Subgroup.map_mono (posUnip_subgroupOf_le_plusFlagStab_one K)

theorem leastParabolic_omegaPlusQAlpha (K : Type) [Field K] [Finite K] [CharP K 2] :
    IsParabolicTwo ↥(StatedOmega (StatedQuadPlus 3 K)) (omegaPlusQAlpha K) ∧
      plusDerivedUnipotent 3 K ≤ omegaPlusQAlpha K ∧ ¬ omegaPlusQAlpha K ≤ omegaPlusQZero K ∧
      ∀ P : Subgroup ↥(StatedOmega (StatedQuadPlus 3 K)),
        IsParabolicTwo ↥(StatedOmega (StatedQuadPlus 3 K)) P → plusDerivedUnipotent 3 K ≤ P →
          ¬ P ≤ omegaPlusQZero K → omegaPlusQAlpha K ≤ P := by
  have h := leastParabolic_map (plusDerivedEquiv 3 K le_rfl).symm
    (map_symm_posUnip_subgroupOf K) (isParabolicTwo_plusFlagStab_alpha K)
    (posUnip_subgroupOf_le_plusFlagStab_alpha K) (not_plusFlagStab_alpha_le_one K)
    (fun P hP hU hnot => plusFlagStab_alpha_le_of_parabolic hP hU hnot)
  rwa [map_symm_plusFlagStab_alpha, map_symm_plusFlagStab_one] at h

theorem kAdjAt_of_realizes_omegaPlusSix {W : Type} [CommGroup W] [Finite W]
    (H : Subgroup (MulAut W)) {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ}
    (hK : Nat.card K = 2 ^ n) (hn : 2 ≤ n)
    (hreal : (FFModel.nat (StatedOmega (StatedQuadPlus 3 K))).Realizes H ⊤ ⊥) :
    KAdjAt W H n := by
  obtain ⟨hpar, hUQ, hnot, hleast⟩ := leastParabolic_omegaPlusQAlpha K
  refine kAdjAt_of_model H n n (Or.inl rfl) (plusDerivedUnipotent 3 K) (omegaPlusQAlpha K)
    (omegaPlusQZero K) ?_ hpar hUQ hnot hleast
    (fun r hr hr2 _ t ht hord =>
      kAdj_model_omegaPlusSix hK hn (hr.odd_of_ne_two hr2) ht hord)
  intro S
  obtain ⟨U, hU⟩ := exists_sylow_plusDerivedUnipotent K
  haveI : Nonempty (Fin 3 ⊕ Fin 3) := ⟨Sum.inl 0⟩
  obtain ⟨U₀, hU₀, hfix⟩ :=
    KTabA.exists_fixedLine_statedOmega_plus_single (K := K) (p := 2) (m := 3) (by norm_num)
  obtain ⟨φ, h1, h2⟩ := exists_mulEquiv_pointStab_eq_map_sylow hreal
    (KTabC.sylowFixedLine_of_isPGroup U₀ hU₀ _ hfix) U
    (hU ▸ plusDerivedUnipotent_le_omegaPlusQZero K) S
  exact ⟨φ, hU ▸ h1, h2⟩

theorem kAdjAt_omegaPlusSix (W : Type) [CommGroup W] [Finite W] (H : Subgroup (MulAut W))
    (n : ℕ) (h : IsOmegaPlus ↥H 6 n ∧ NatOmegaPlus H ⊤ ⊥ 6 n) (hn : 3 ≤ n) : KAdjAt W H n := by
  obtain ⟨-, -, K, hKf, hKfin, hKcard, hreal⟩ := h
  letI : Field K := hKf
  letI : Finite K := hKfin
  haveI : CharP K 2 := uc22p22d_charP_two (by omega) hKcard
  exact kAdjAt_of_realizes_omegaPlusSix H hKcard (by omega) hreal

