theorem om6m_exists_mulEquiv_pointStab {W : Type} [CommGroup W] [Finite W]
    {H : Subgroup (MulAut W)} {K : Type} [Field K] [Finite K] [CharP K 2] {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (hreal : (FFModel.nat (StatedOmega (StatedQuadMinus 3 K b c))).Realizes H ⊤ ⊥)
    (S : Sylow 2 ↥H) :
    ∃ φ : ↥(orthElementaryGroup (quadTail 2 (minusTailForm K b c))) ≃* ↥H,
      ((tailUnipotent 2 (minusTailForm K b c)).subgroupOf
          (orthElementaryGroup (quadTail 2 (minusTailForm K b c)))).map φ.toMonoidHom =
        (S : Subgroup ↥H) ∧
      KTabD.pointStab H S = (orthParab 2 (minusTailForm K b c) ![0, 1]).map φ.toMonoidHom := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨ψ, hψ⟩ : ∃ ψ : ↥(StatedOmega (StatedQuadMinus 3 K b c)) ≃*
      ↥(orthElementaryGroup (quadTail 2 (minusTailForm K b c))),
      (KTabD.lineStab (StatedOmega (StatedQuadMinus 3 K b c))
        (Pi.single (Sum.inl ⟨0, by omega⟩) 1)).map ψ.toMonoidHom =
          orthParab 2 (minusTailForm K b c) ![0, 1] :=
    KTabD.exists_mulEquiv_lineStab_map_eq_orthParab hirr 0
  have hline := KTabD.sylowFixedLine_omegaMinus (m := 3) (by norm_num) hirr
  obtain ⟨U₀, hU₀⟩ := om6m_exists_sylow_tailUnipotent hirr
  let U' : Sylow 2 ↥(StatedOmega (StatedQuadMinus 3 K b c)) :=
    U₀.mapSurjective (f := ψ.symm.toMonoidHom) ψ.symm.surjective
  have hQ : (orthParab 2 (minusTailForm K b c) ![0, 1]).map ψ.symm.toMonoidHom =
      KTabD.lineStab (StatedOmega (StatedQuadMinus 3 K b c))
        (Pi.single (Sum.inl ⟨0, by omega⟩) 1) :=
    (Subgroup.map_symm_eq_iff_map_eq _).mpr hψ
  have hU' : (U' : Subgroup ↥(StatedOmega (StatedQuadMinus 3 K b c))) ≤
      KTabD.lineStab (StatedOmega (StatedQuadMinus 3 K b c))
        (Pi.single (Sum.inl ⟨0, by omega⟩) 1) := by
    rw [← hQ]
    exact Subgroup.map_mono (hU₀ ▸ (om6m_tailUnipotent_le_orthParab hirr).trans inf_le_left)
  obtain ⟨φ', hφ'U, hφ'Q⟩ := exists_mulEquiv_pointStab_eq_map_sylow hreal hline U' hU' S
  refine ⟨ψ.symm.trans φ', ?_, ?_⟩
  · calc ((tailUnipotent 2 (minusTailForm K b c)).subgroupOf
          (orthElementaryGroup (quadTail 2 (minusTailForm K b c)))).map
            (ψ.symm.trans φ').toMonoidHom
        = ((U₀ : Subgroup _).map ψ.symm.toMonoidHom).map φ'.toMonoidHom := by
          rw [Subgroup.map_map, hU₀]; rfl
      _ = S := hφ'U
  · rw [hφ'Q, ← hQ, Subgroup.map_map]; rfl

theorem kAdjAt_of_realizes_om6m {W : Type} [CommGroup W] [Finite W] (H : Subgroup (MulAut W))
    {K : Type} [Field K] [Finite K] [CharP K 2] {b c : K} {n : ℕ} (hK : Nat.card K = 2 ^ n)
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (hreal : (FFModel.nat (StatedOmega (StatedQuadMinus 3 K b c))).Realizes H ⊤ ⊥) :
    KAdjAt W H n := by
  exact kAdjAt_of_model H n (2 * n) (Or.inr (Or.inl rfl))
    ((tailUnipotent 2 (minusTailForm K b c)).subgroupOf
      (orthElementaryGroup (quadTail 2 (minusTailForm K b c))))
    (orthParab 2 (minusTailForm K b c) ![0, 2]) (orthParab 2 (minusTailForm K b c) ![0, 1])
    (om6m_exists_mulEquiv_pointStab hirr hreal) (om6m_isParabolicTwo_orthParab_two hirr)
    ((om6m_tailUnipotent_le_orthParab hirr).trans inf_le_right)
    (om6m_not_orthParab_two_le_one hirr)
    (fun _ hP hU hnot => om6m_orthParab_two_le_of_parabolic hirr hP hU hnot)
    (fun _ _ _ hrc _ ht hord => kAdj_model_om6m_tail hK hirr (om6m_odd_of_hr hrc) ht hord)

theorem kAdjAt_om6m {W : Type} [CommGroup W] [Finite W] (H : Subgroup (MulAut W)) {n : ℕ}
    (h : IsOmegaMinus ↥H 6 n ∧ NatOmegaMinus H ⊤ ⊥ 6 n) : KAdjAt W H n := by
  obtain ⟨-, K, hKf, hKfin, b, c, hK, hirr, hreal⟩ := h.2
  letI := hKf
  letI := hKfin
  haveI : Fintype K := Fintype.ofFinite K
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rw [show (6 : ℕ) / 2 = 3 by norm_num] at hreal
  haveI : CharP K 2 :=
    charP_of_card_eq_prime_pow (f := n) (by rw [← Nat.card_eq_fintype_card, hK])
  exact kAdjAt_of_realizes_om6m H hK hirr hreal

