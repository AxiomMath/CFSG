variable {K : Type} [Field K] [Finite K] [CharP K 2] {b c : K}

private lemma four_le_sq_card_D10 (hK2 : 2 ≤ Nat.card K) :
    4 ≤ Nat.card K ^ 2 := by
  calc (4 : ℕ) = 2 ^ 2 := by norm_num
    _ ≤ Nat.card K ^ 2 := Nat.pow_le_pow_left hK2 2

private lemma exists_equiv_sl2_om6mX_D10 (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    ∃ (F : Type) (_ : Field F) (_ : Finite F), 4 ≤ Nat.card F ∧
      Nonempty (↥(om6mX b c) ≃* Matrix.SpecialLinearGroup (Fin 2) F) := by
  obtain ⟨F, _, _, hF, ⟨f⟩⟩ :=
    CFSG.RankThree.GF2n.Stroth80.exists_statedOmega_quadMinus_two_mulEquiv
      (K := K) (b := b) (c := c) hirr
  refine ⟨F, inferInstance, inferInstance, ?_, ⟨((om6mXEquiv hirr).trans
    ((CFSG.AGLEmbedding.LeviBlock.orthResDerEquivStatedOmega (b := b) (c := c) 1).trans
      f)).trans (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 2 F).symm⟩⟩
  rw [hF]
  exact four_le_sq_card_D10 (Nat.succ_le_of_lt (Finite.one_lt_card (α := K)))

private lemma isQuasisimple_sl2_D10 (F : Type) [Field F] [Finite F] (h4 : 4 ≤ Nat.card F) :
    CFSG.Open.IsQuasisimple (Matrix.SpecialLinearGroup (Fin 2) F) :=
  CFSG.AGLEmbedding.LeviBlock.isQuasisimple_SL_of_four_le (K := F) h4 (m := 2) le_rfl

private lemma isPerfect_om6mX_D10 (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    Group.IsPerfect ↥(om6mX b c) := by
  obtain ⟨F, _, _, h4, ⟨eX⟩⟩ := exists_equiv_sl2_om6mX_D10 (b := b) (c := c) hirr
  have hq := isQuasisimple_sl2_D10 F h4
  haveI : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin 2) F) :=
    Group.isPerfect_def.mpr hq.1
  exact Group.IsPerfect.ofSurjective (f := eX.symm.toMonoidHom) eX.symm.surjective

private lemma nontrivial_om6mX_D10 (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    Nontrivial ↥(om6mX b c) := by
  obtain ⟨F, _, _, h4, ⟨eX⟩⟩ := exists_equiv_sl2_om6mX_D10 (b := b) (c := c) hirr
  have hq := isQuasisimple_sl2_D10 F h4
  haveI : Nontrivial (Matrix.SpecialLinearGroup (Fin 2) F ⧸ Subgroup.center _) :=
    hq.2.toNontrivial
  haveI : Nontrivial (Matrix.SpecialLinearGroup (Fin 2) F) :=
    (QuotientGroup.mk_surjective (s := Subgroup.center _)).nontrivial
  exact Function.Injective.nontrivial eX.symm.injective

private lemma om6mX_le_orthParab_D10 (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    om6mX b c ≤ orthParab 2 (minusTailForm K b c) ![0, 1] := by
  intro x hx
  obtain ⟨B, _hB, hBx⟩ := Subgroup.mem_map.mp (Subgroup.mem_subgroupOf.mp hx)
  rw [CFSG.AGLEmbedding.LeviBlock.mem_orthParab]
  intro i
  rw [← hBx]
  exact CFSG.AGLEmbedding.LeviBlock.map_tailFlag_orthLeviRes (r := 2) (t := 1)
    (c := ![0, 1] i) (ht := _) (hc := by fin_cases i <;> decide) B

theorem om6m_isSLn_of_statedOmegaMinus_two {X : Type} [Group X] {n : ℕ}
    (hK : Nat.card K = 2 ^ n) (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (e : X ≃* ↥(StatedOmega (StatedQuadMinus 2 K b c))) : IsSLn X 2 (2 * n) := by
  obtain ⟨F, _, _, hF, ⟨f⟩⟩ :=
    CFSG.RankThree.GF2n.Stroth80.exists_statedOmega_quadMinus_two_mulEquiv
      (K := K) (b := b) (c := c) hirr
  refine ⟨F, inferInstance, inferInstance, ?_, ⟨e.trans f⟩⟩
  calc Nat.card F = Nat.card K ^ 2 := hF
    _ = (2 ^ n) ^ 2 := by rw [hK]
    _ = 2 ^ (n * 2) := (pow_mul 2 n 2).symm
    _ = 2 ^ (2 * n) := by rw [mul_comm n 2]

theorem om6m_isSLn_om6mX {n : ℕ} (hK : Nat.card K = 2 ^ n)
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) : IsSLn ↥(om6mX b c) 2 (2 * n) :=
  om6m_isSLn_of_statedOmegaMinus_two (b := b) (c := c) hK hirr
    ((om6mXEquiv hirr).trans
      (CFSG.AGLEmbedding.LeviBlock.orthResDerEquivStatedOmega (b := b) (c := c) 1))

theorem om6mX_le_hinf_orthParab (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    om6mX b c ≤ Hinf (orthParab 2 (minusTailForm K b c) ![0, 1]) :=
  CFSG.RankThree.PartTwo.Sec18.le_inSubgroup_perfectResidual
    (Subgroup.isPerfect_iff.mp (isPerfect_om6mX_D10 hirr)) (om6mX_le_orthParab_D10 hirr)

theorem om6m_commutator_om6mX (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    ⁅om6mX b c, om6mX b c⁆ = om6mX b c :=
  Subgroup.isPerfect_iff.mp (isPerfect_om6mX_D10 hirr)

theorem om6m_not_isPGroup_om6mX (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    ¬ IsPGroup 2 ↥(om6mX b c) := by
  intro hp
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hnil : Group.IsNilpotent ↥(om6mX b c) := hp.isNilpotent
  haveI : Group.IsPerfect ↥(om6mX b c) := isPerfect_om6mX_D10 hirr
  haveI : Nontrivial ↥(om6mX b c) := nontrivial_om6mX_D10 hirr
  exact Group.IsPerfect.not_isNilpotent ↥(om6mX b c) hnil

theorem om6m_isQuasisimple_bar2_hinf_orthParab (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    CFSG.Open.IsQuasisimple (Bar2 (Hinf (orthParab 2 (minusTailForm K b c) ![0, 1]))) := by
  obtain ⟨φ, hφ⟩ :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.KTabD.exists_mulEquiv_lineStab_map_eq_orthParab
      hirr 0
  obtain ⟨e1⟩ :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.KTabD.nonempty_bar2_hinf_map φ
      (KTabD.lineStab (StatedOmega (StatedQuadMinus (0 + 3) K b c))
        (Pi.single (Sum.inl ⟨0, by omega⟩) 1))
  rw [hφ] at e1
  obtain ⟨e2⟩ :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.KTabD.nonempty_bar2_hinf_lineStab_statedOmegaMinus
      hirr 0
  obtain ⟨F, _, _, hF, ⟨f⟩⟩ :=
    CFSG.RankThree.GF2n.Stroth80.exists_statedOmega_quadMinus_two_mulEquiv
      (K := K) (b := b) (c := c) hirr
  have h4 : 4 ≤ Nat.card F := by
    rw [hF]
    exact four_le_sq_card_D10 (Nat.succ_le_of_lt (Finite.one_lt_card (α := K)))
  refine CFSG.Open.IsQuasisimple.of_mulEquiv ?_ (isQuasisimple_sl2_D10 F h4)
  exact (e2.symm.trans e1).symm.trans
    (f.trans (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 2 F).symm)

theorem om6m_normal_closure_om6mX (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    ∀ N : Subgroup ↥(orthElementaryGroup (quadTail 2 (minusTailForm K b c))),
      N ≤ Hinf (orthParab 2 (minusTailForm K b c) ![0, 1]) →
        Hinf (orthParab 2 (minusTailForm K b c) ![0, 1]) ≤ Subgroup.normalizer (N : Set
          ↥(orthElementaryGroup (quadTail 2 (minusTailForm K b c)))) →
          om6mX b c ≤ N → N = Hinf (orthParab 2 (minusTailForm K b c) ![0, 1]) :=
  normal_closure_top_of_perfect (Hinf (orthParab 2 (minusTailForm K b c) ![0, 1]))
    (CFSG.RankThree.PartTwo.Sec18.commutator_inSubgroup_perfectResidual
      (orthParab 2 (minusTailForm K b c) ![0, 1]))
    (om6m_isQuasisimple_bar2_hinf_orthParab hirr) (om6mX b c)
    (om6mX_le_hinf_orthParab hirr) (om6m_commutator_om6mX hirr)
    (om6m_not_isPGroup_om6mX hirr)

end CFSG.LocalAnalysis.UniquenessCase.UC22.KAdjE
