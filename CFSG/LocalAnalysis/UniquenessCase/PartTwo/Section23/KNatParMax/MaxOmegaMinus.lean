theorem natParMax_of_isL2 {W : Type} [CommGroup W] [Finite W] {H S X : Subgroup (MulAut W)}
    {m : ℕ} (hH : IsL2 ↥H m) (hS : IsSylowIn 2 S H) (hXge : H ⊓ stabSub (fixV S) ≤ X)
    (hXlt : X < H) : X = H ⊓ stabSub (fixV S) := by
  haveI : Finite (MulAut W) := Finite.of_injective _ MulEquiv.toEquiv_injective
  haveI : Finite ↥H := inferInstance
  have hm : 2 ≤ m := s13_two_le_of_isL2 hH
  have hSX : S ≤ X := (le_inf hS.le Subgroup.le_normalizer).trans
    ((inf_normalizer_le_inf_stabSub H S).trans hXge)
  let Y : Subgroup ↥H := X.subgroupOf H
  have hYtop : Y ≠ ⊤ := by
    intro h
    exact hXlt.2 (Subgroup.subgroupOf_eq_top.1 h)
  have hSY : ((hS.toSylow : Sylow 2 ↥H) : Subgroup ↥H) ≤ Y := by
    rw [IsSylowIn.coe_toSylow]
    exact Subgroup.subgroupOf_mono H hSX
  have hN : Y ≤ Subgroup.normalizer (((hS.toSylow : Sylow 2 ↥H) : Subgroup ↥H) : Set ↥H) :=
    l2_sylow_le_normalizer hm hH hS.toSylow Y hSY hYtop
  rw [IsSylowIn.coe_toSylow] at hN
  have hNX : X ≤ Subgroup.normalizer (S : Set (MulAut W)) :=
    le_normalizer_of_subgroupOf_le hS.le hXlt.le hN
  exact le_antisymm ((le_inf hXlt.le hNX).trans (inf_normalizer_le_inf_stabSub H S)) hXge

theorem natParMax_of_isOmegaMinus_four {W : Type} [CommGroup W] [Finite W]
    {H S X : Subgroup (MulAut W)} {n : ℕ} (hΩ : IsOmegaMinus ↥H 4 n) (hS : IsSylowIn 2 S H)
    (hXge : H ⊓ stabSub (fixV S) ≤ X) (hXlt : X < H) : X = H ⊓ stabSub (fixV S) := by
  have hn : 1 ≤ n := by
    obtain ⟨-, K, hKfield, hKfin, b, c, hKcard, -, -⟩ := hΩ
    letI : Field K := hKfield
    letI : Finite K := hKfin
    have hKgt : 1 < Nat.card K := Finite.one_lt_card_iff_nontrivial.mpr inferInstance
    rw [hKcard] at hKgt
    exact Nat.one_le_iff_ne_zero.mpr (Nat.one_lt_two_pow_iff.mp hKgt)
  exact natParMax_of_isL2 (S18.isL2_of_isOmegaMinus_four hn hΩ) hS hXge hXlt

theorem maximal_of_map_eq {G G' : Type} [Group G] [Group G'] (φ : G ≃* G') {P : Subgroup G}
    {P' : Subgroup G'} (h : P.map φ.toMonoidHom = P')
    (hmax : ∀ Y : Subgroup G', P' ≤ Y → Y = P' ∨ Y = ⊤) :
    ∀ Y : Subgroup G, P ≤ Y → Y = P ∨ Y = ⊤ := by
  intro Y hPY
  have hmap : P' ≤ Y.map φ.toMonoidHom := by
    rw [← h]
    exact Subgroup.map_mono hPY
  rcases hmax _ hmap with hY | hY
  · left
    apply Subgroup.map_injective (f := φ.toMonoidHom) φ.injective
    rw [hY, h]
  · right
    apply Subgroup.map_injective (f := φ.toMonoidHom) φ.injective
    rw [hY, Subgroup.map_top_of_surjective _ φ.surjective]

section TailParabolic

variable {K : Type} [Field K] {A : Type} [AddCommGroup A] [Module K A]
  {qA : QuadraticForm K A} {r : ℕ}

private lemma mem_map_orthParab_one_iff_M03
    (x : ((Fin r ⊕ Fin r → K) × A) ≃ₗ[K] ((Fin r ⊕ Fin r → K) × A)) :
    x ∈ (orthParab r qA ![0, 1]).map (orthElementaryGroup (quadTail r qA)).subtype ↔
      x ∈ orthElementaryGroup (quadTail r qA) ∧
        (tailFlag K A r 1).map (x : ((Fin r ⊕ Fin r → K) × A) →ₗ[K] _) =
          tailFlag K A r 1 := by
  constructor
  · rintro ⟨y, hy, rfl⟩
    refine ⟨y.2, ?_⟩
    have h1 := (mem_orthParab.1 hy) (1 : Fin 2)
    simpa using h1
  · rintro ⟨hxE, hx1⟩
    rw [Subgroup.mem_map]
    refine ⟨⟨x, hxE⟩, ?_, rfl⟩
    rw [mem_orthParab, Fin.forall_fin_two]
    refine ⟨?_, ?_⟩
    · simp only [Matrix.cons_val_zero, tailFlag_zero, Submodule.map_bot]
    · simpa using hx1

private lemma tailBorel_le_map_orthParab_one_M03 (hr : 1 ≤ r) :
    tailBorel r qA ≤ (orthParab r qA ![0, 1]).map
      (orthElementaryGroup (quadTail r qA)).subtype := by
  intro b hb
  rw [mem_map_orthParab_one_iff_M03]
  exact ⟨(mem_tailBorel.1 hb).1, (mem_tailBorel.1 hb).2 1 le_rfl hr⟩

private lemma tailWeylElt_mem_map_orthParab_one_iff_M03 (hr : 1 ≤ r) (hani : qA.Anisotropic)
    {a₀ : A} (ha₀ : a₀ ≠ 0) (j : Fin r) :
    tailWeylElt r qA a₀ j ∈ (orthParab r qA ![0, 1]).map
        (orthElementaryGroup (quadTail r qA)).subtype ↔ j ≠ ⟨0, hr⟩ := by
  rw [mem_map_orthParab_one_iff_M03]
  constructor
  · rintro ⟨-, h1⟩
    have hs : tailWeylElt r qA a₀ j ∈
        MulAction.stabilizer (((Fin r ⊕ Fin r → K) × A) ≃ₗ[K] ((Fin r ⊕ Fin r → K) × A))
          (tailFlag K A r 1) :=
      Submodule.mem_stabilizer_submodule_iff_map_eq.2 h1
    rw [MulAction.mem_stabilizer_iff] at hs
    exact (tailWeylElt_smul_tailFlag (i := ⟨0, hr⟩) (j := j) hani ha₀).1 (by simpa using hs)
  · intro hj
    refine ⟨tailWeylElt_mem a₀ j, ?_⟩
    have hs : tailWeylElt r qA a₀ j ∈
        MulAction.stabilizer (((Fin r ⊕ Fin r → K) × A) ≃ₗ[K] ((Fin r ⊕ Fin r → K) × A))
          (tailFlag K A r 1) := by
      rw [MulAction.mem_stabilizer_iff]
      exact (tailWeylElt_smul_tailFlag (i := ⟨0, hr⟩) (j := j) hani ha₀).2 hj
    exact Submodule.mem_stabilizer_submodule_iff_map_eq.1 hs

end TailParabolic

theorem orthParab_one_maximal {K : Type} [Field K] {A : Type} [AddCommGroup A] [Module K A]
    [FiniteDimensional K A] {qA : QuadraticForm K A} (hani : qA.Anisotropic) {a₀ : A}
    (ha₀ : a₀ ≠ 0) {r : ℕ} (hr : 1 ≤ r)
    (Y : Subgroup ↥(orthElementaryGroup (quadTail r qA))) (hY : orthParab r qA ![0, 1] ≤ Y) :
    Y = orthParab r qA ![0, 1] ∨ Y = ⊤ := by
  let M : Subgroup (((Fin r ⊕ Fin r → K) × A) ≃ₗ[K] ((Fin r ⊕ Fin r → K) × A)) :=
    Y.map (orthElementaryGroup (quadTail r qA)).subtype
  have hME : M ≤ orthElementaryGroup (quadTail r qA) := Subgroup.map_subtype_le Y
  have hBM : tailBorel r qA ≤ M :=
    (tailBorel_le_map_orthParab_one_M03 (r := r) (qA := qA) hr).trans (Subgroup.map_mono hY)
  have hgen : M = Subgroup.closure ((tailBorel r qA : Set _) ∪
      tailWeylElt r qA a₀ '' {i | tailWeylElt r qA a₀ i ∈ M}) :=
    eq_closure_of_tailBorel_le hani ha₀ hME hBM
  by_cases hni : tailWeylElt r qA a₀ ⟨0, hr⟩ ∈ M
  · right
    have hI : {i : Fin r | tailWeylElt r qA a₀ i ∈ M} = Set.univ := by
      ext i
      simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
      by_cases hi : i = ⟨0, hr⟩
      · simpa [hi] using hni
      · exact (Subgroup.map_mono hY)
          ((tailWeylElt_mem_map_orthParab_one_iff_M03 hr hani ha₀ i).2 hi)
    have hEeq : orthElementaryGroup (quadTail r qA) =
        Subgroup.closure ((tailBorel r qA : Set _) ∪ tailWeylElt r qA a₀ '' Set.univ) := by
      have h := eq_closure_of_tailBorel_le hani ha₀
        (le_refl (orthElementaryGroup (quadTail r qA))) tailBorel_le
      rw [show {i : Fin r | tailWeylElt r qA a₀ i ∈ orthElementaryGroup (quadTail r qA)} =
          Set.univ from Set.eq_univ_iff_forall.2 fun i => tailWeylElt_mem a₀ i] at h
      exact h
    rw [hI] at hgen
    have hMeq : M = orthElementaryGroup (quadTail r qA) := hgen.trans hEeq.symm
    apply Subgroup.map_injective (orthElementaryGroup (quadTail r qA)).subtype_injective
    rw [Subgroup.map_top, Subgroup.range_subtype]
    exact hMeq
  · left
    have hI' : ∀ i : Fin r, tailWeylElt r qA a₀ i ∈ M → i ≠ ⟨0, hr⟩ := by
      intro i hi hii
      exact hni (hii ▸ hi)
    have hMP : M ≤ (orthParab r qA ![0, 1]).map
        (orthElementaryGroup (quadTail r qA)).subtype := by
      rw [hgen, Subgroup.closure_le]
      rintro x (hb | ⟨i, hiM, rfl⟩)
      · exact tailBorel_le_map_orthParab_one_M03 hr hb
      · exact (tailWeylElt_mem_map_orthParab_one_iff_M03 hr hani ha₀ i).2 (hI' i hiM)
    have hMpeq : M = (orthParab r qA ![0, 1]).map
        (orthElementaryGroup (quadTail r qA)).subtype :=
      le_antisymm hMP (Subgroup.map_mono hY)
    apply Subgroup.map_injective (orthElementaryGroup (quadTail r qA)).subtype_injective
    exact hMpeq

theorem lineStab_maximal_statedOmegaMinus {m : ℕ} (hm : 3 ≤ m) {K : Type} [Field K] [Finite K]
    [CharP K 2] {b c : K} (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    ∀ Y : Subgroup ↥(StatedOmega (StatedQuadMinus m K b c)),
      KTabD.lineStab (StatedOmega (StatedQuadMinus m K b c))
          (Pi.single (Sum.inl ⟨0, by omega⟩) 1) ≤ Y →
        Y = KTabD.lineStab (StatedOmega (StatedQuadMinus m K b c))
          (Pi.single (Sum.inl ⟨0, by omega⟩) 1) ∨ Y = ⊤ := by
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 3 := ⟨m - 3, by omega⟩
  obtain ⟨φ, hφ⟩ := KTabD.exists_mulEquiv_lineStab_map_eq_orthParab hirr k
  refine maximal_of_map_eq φ hφ fun Y hY => ?_
  exact orthParab_one_maximal (anisotropic_minusTailForm hirr)
    (a₀ := Pi.single (0 : Fin 2) (1 : K))
    (by
      intro h
      have h0 : (1 : K) = 0 := by simpa using congrFun h (0 : Fin 2)
      exact (one_ne_zero : (1 : K) ≠ 0) h0)
    (r := k + 2) (by omega) Y hY

end CFSG.LocalAnalysis.UniquenessCase.UC22.NatParMax
