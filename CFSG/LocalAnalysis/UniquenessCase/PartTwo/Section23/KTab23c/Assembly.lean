private lemma mulVec_mulAutConj {ι K : Type} [Fintype ι] [DecidableEq ι] [Field K]
    (a b : GL ι K) (v : ι → K) :
    ((MulAut.conj a b : GL ι K) : Matrix ι ι K) *ᵥ v =
      ((a : GL ι K) : Matrix ι ι K) *ᵥ
        (((b : GL ι K) : Matrix ι ι K) *ᵥ
          (((a⁻¹ : GL ι K) : Matrix ι ι K) *ᵥ v)) := by
  rw [MulAut.conj_apply, Units.val_mul, Units.val_mul, ← Matrix.mulVec_mulVec,
    ← Matrix.mulVec_mulVec]

theorem piSet_inf_eq_of_dvd {G : Type} [Group G] [Finite G] {B C : Subgroup G} {n : ℕ}
    (hn : 1 ≤ n) (h1 : Nat.card ↥(B ⊓ C) ∣ 2 ^ n + 1)
    (h2 : ((B ⊓ C).subgroupOf B).index ∣ 2 ^ n - 1) :
    piSet (B ⊓ C) = piSet B ∩ {p : ℕ | p.Prime ∧ p ∣ 2 ^ n + 1} := by
  ext p
  constructor
  · rintro ⟨hp, hdvd⟩
    exact ⟨⟨hp, hdvd.trans (Subgroup.card_dvd_of_le inf_le_left)⟩, hp, hdvd.trans h1⟩
  · rintro ⟨⟨hp, hpB⟩, -, hp1⟩
    refine ⟨hp, ?_⟩
    have hcard : Nat.card ↥B = Nat.card ↥(B ⊓ C) * ((B ⊓ C).subgroupOf B).index := by
      rw [← Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe (inf_le_left : B ⊓ C ≤ B)).toEquiv, Subgroup.card_mul_index]
    rw [hcard] at hpB
    rcases hp.dvd_mul.mp hpB with h | h
    · exact h
    · exfalso
      have hdvd : p ∣ 2 ^ n + 1 - (2 ^ n - 1) := Nat.dvd_sub hp1 (h.trans h2)
      have hsub : 2 ^ n + 1 - (2 ^ n - 1) = 2 := by
        have := Nat.one_le_pow n 2 (by norm_num)
        omega
      rw [hsub] at hdvd
      have hp2 : p = 2 := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp hdvd
      obtain ⟨k, hk⟩ := show 2 ∣ 2 ^ n + 1 from hp2 ▸ hp1
      obtain ⟨l, hl⟩ := show 2 ∣ 2 ^ n from dvd_pow_self 2 (by omega)
      omega

theorem kTab23c_minus_of_le_normalizer
    (hfix : ∀ (K : Type) [Field K] [Finite K] [CharP K 2] (b c : K),
      (∀ s : K, s ^ 2 + b * s + c ≠ 0) →
        SylowFixedLine (StatedOmega (StatedQuadMinus 2 K b c)) (e1M K))
    {W : Type} [CommGroup W] [Finite W] (H : Subgroup (MulAut W)) (n : ℕ)
    (hN : NatOmegaMinus H ⊤ ⊥ 4 n) :
    letI : MulDistribMulAction ↥H W := MulDistribMulAction.compHom W H.subtype
    letI : MulAction ↥H W := MulAction.compHom W H.subtype
    ∀ S : Sylow 2 ↥H,
      letI : MulDistribMulAction ↥S W :=
        MulDistribMulAction.compHom W (H.subtype.comp (S : Subgroup ↥H).subtype)
      ∀ B : Subgroup ↥H, Odd (Nat.card ↥B) →
        B ≤ Subgroup.normalizer ((S : Subgroup ↥H) : Set ↥H) →
        piSet (B ⊓ fixingSubgroupOf ↥H W (fixedPointSubgroup ↥S W : Set W)) =
          piSet B ∩ {p : ℕ | p.Prime ∧ p ∣ 2 ^ n + 1} := by
  obtain ⟨-, K, hK, hKfin, b, c, hKcard, hirr, hR⟩ := hN
  letI : Field K := hK
  letI : Finite K := hKfin
  haveI hchar : CharP K 2 := CFSG.Timmesfeld.ClassicalOrders.charP_two_of_card_eq hKcard
  have hn : 1 ≤ n := by
    have h2 : 1 < 2 ^ n := hKcard ▸ Finite.one_lt_card (α := K)
    rcases Nat.eq_zero_or_pos n with h | h
    · rw [h] at h2; simp at h2
    · exact h
  have hR' : (FFModel.nat (StatedOmega (StatedQuadMinus 2 K b c))).Realizes H ⊤ ⊥ := hR
  intro S B hodd hBN
  let Γ : Subgroup (GL ιM K) := StatedOmega (StatedQuadMinus 2 K b c)
  have hSFL : SylowFixedLine Γ (e1M K) := hfix K b c hirr
  have hRΓ : (FFModel.nat Γ).Realizes H ⊤ ⊥ := hR'
  obtain ⟨π, e, he⟩ := exists_natEquiv (K := K) (ι := ιM) hRΓ
  let ρ : ↥H →* GL ιM K := Γ.subtype.comp π.symm.toMonoidHom
  let S' : Sylow 2 ↥Γ := S.mapSurjective (f := π.symm.toMonoidHom) π.symm.surjective
  obtain ⟨x, hx⟩ := hSFL S'
  let w₀ : ιM → K := ((x : GL ιM K) : Matrix ιM ιM K) *ᵥ e1M K
  have hw₀def : w₀ = ((x : GL ιM K) : Matrix ιM ιM K) *ᵥ e1M K := rfl
  have he' : ∀ (h : ↥H) (w : W), Multiplicative.toAdd (e ((h : MulAut W) w)) =
      ((ρ h : GL ιM K) : Matrix ιM ιM K) *ᵥ Multiplicative.toAdd (e w) := by
    intro h w
    have h1 := he (π.symm h) w
    rwa [MulEquiv.apply_symm_apply] at h1
  have hS : ∀ v : ιM → K, (∀ s ∈ (S : Subgroup ↥H),
      ((ρ s : GL ιM K) : Matrix ιM ιM K) *ᵥ v = v) ↔ ∃ c : K, v = c • w₀ := by
    intro v
    exact (fixed_iff_fixed_sylowMap π S v).trans (hx v)
  have hCH : fixingSubgroupOf ↥H W (fixedPointSubgroup ↥S W : Set W) = vecStab ρ w₀ :=
    fixingSubgroupOf_fixedPointSubgroup_eq_vecStab he' S hS
  have hB : ∀ g ∈ B, ∃ c : K, ((ρ g : GL ιM K) : Matrix ιM ιM K) *ᵥ w₀ = c • w₀ :=
    fun g hg => exists_mulVec_eq_smul_of_mem_normalizer S hS (hBN hg)
  have hw₀ : w₀ ≠ 0 := by
    rw [hw₀def]
    intro h0
    have hcomp := congrArg (fun v => ((↑x⁻¹ : GL ιM K) : Matrix ιM ιM K) *ᵥ v) h0
    simp only [Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one,
      Matrix.one_mulVec, Matrix.mulVec_zero] at hcomp
    have h1 := congrFun hcomp (Sum.inl 0)
    simp [e1M] at h1
  let σ : ↥H →* ↥Γ := (MulAut.conj (x⁻¹)).toMonoidHom.comp π.symm.toMonoidHom
  have hσinj : Function.Injective (Γ.subtype.comp σ) :=
    (Subgroup.subtype_injective Γ).comp fun a b hab =>
      π.symm.injective ((MulAut.conj (x⁻¹)).injective hab)
  have hEcard : Nat.card ↥((B ⊓ vecStab ρ w₀).map (Γ.subtype.comp σ)) =
      Nat.card ↥(B ⊓ vecStab ρ w₀) := Subgroup.card_map_of_injective hσinj
  have hσy : ∀ y : ↥H, (σ y : ↥Γ) = x⁻¹ * π.symm y * x := by
    intro y
    show MulAut.conj (x⁻¹) (π.symm y) = x⁻¹ * π.symm y * x
    rw [MulAut.conj_apply, inv_inv]
  have hunit : ∀ y : ↥H, Γ.subtype (σ y) =
      ((x⁻¹ : ↥Γ) : GL ιM K) * ρ y * ((x : ↥Γ) : GL ιM K) := by
    intro y
    rw [hσy y, map_mul, map_mul]
    rfl
  have hx1 : (((x : ↥Γ) : GL ιM K) : Matrix ιM ιM K) *ᵥ e1M K = w₀ := rfl
  have hx2 : (((x⁻¹ : ↥Γ) : GL ιM K) : Matrix ιM ιM K) *ᵥ w₀ = e1M K := by
    rw [hw₀def, Matrix.mulVec_mulVec, ← Units.val_mul]
    simp
  have hx3 : ((x : ↥Γ) : GL ιM K) = (((x⁻¹ : ↥Γ) : GL ιM K))⁻¹ := by
    rw [Subgroup.coe_inv, inv_inv]
  have hEform : ∀ g ∈ (B ⊓ vecStab ρ w₀).map (Γ.subtype.comp σ), ∀ v,
      StatedQuadMinus 2 K b c (((g : GL ιM K) : Matrix ιM ιM K) *ᵥ v) =
        StatedQuadMinus 2 K b c v := by
    intro g hg v
    obtain ⟨y, -, rfl⟩ := Subgroup.mem_map.mp hg
    exact CFSG.GroupTheory.WeirSylow.apply_mulVec_of_mem_isometryCore
      (CFSG.GroupTheory.WeirSylow.statedOmega_le_isometryCore
        (StatedQuadMinus 2 K b c) (σ y).2) v
  have hEfix : ∀ g ∈ (B ⊓ vecStab ρ w₀).map (Γ.subtype.comp σ),
      ((g : GL ιM K) : Matrix ιM ιM K) *ᵥ e1M K = e1M K := by
    intro g hg
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hg
    have hy1 : ((ρ y : GL ιM K) : Matrix ιM ιM K) *ᵥ w₀ = w₀ := hy.2
    simp only [MonoidHom.comp_apply]
    rw [hunit y]
    calc (((((x⁻¹ : ↥Γ) : GL ιM K)) * ρ y * (((x : ↥Γ) : GL ιM K)) : GL ιM K) :
          Matrix ιM ιM K) *ᵥ e1M K
        = ((MulAut.conj ((x⁻¹ : ↥Γ) : GL ιM K) (ρ y) : GL ιM K) : Matrix ιM ιM K) *ᵥ
            e1M K := by
          rw [MulAut.conj_apply, hx3]
      _ = ( (((x⁻¹ : ↥Γ) : GL ιM K)) : Matrix ιM ιM K) *ᵥ
            (((ρ y : GL ιM K) : Matrix ιM ιM K) *ᵥ
              (((((x⁻¹ : ↥Γ) : GL ιM K))⁻¹ : GL ιM K) : Matrix ιM ιM K) *ᵥ e1M K) :=
          mulVec_mulAutConj _ _ _
      _ = e1M K := by
          rw [← hx3, hx1, hy1, hx2]
  have hEodd : Odd (Nat.card ↥((B ⊓ vecStab ρ w₀).map (Γ.subtype.comp σ))) := by
    rw [hEcard]
    exact hodd.of_dvd_nat (Subgroup.card_dvd_of_le inf_le_left)
  have hdvd := card_dvd_of_odd_of_fix hirr hEform hEodd hEfix
  rw [hEcard, hKcard] at hdvd
  have h2 : ((B ⊓ vecStab ρ w₀).subgroupOf B).index ∣ 2 ^ n - 1 := by
    have := index_vecStab_dvd ρ hw₀ hB
    rwa [hKcard] at this
  have key : ∀ C : Subgroup ↥H, C = vecStab ρ w₀ →
      piSet (B ⊓ C) = piSet B ∩ {p : ℕ | p.Prime ∧ p ∣ 2 ^ n + 1} := by
    intro C hC
    rw [hC]
    exact piSet_inf_eq_of_dvd hn hdvd h2
  exact key _ hCH

theorem kTab23c_plus_of_le_normalizer
    (hfix : ∀ (K : Type) [Field K] [Finite K] [CharP K 2], 4 ≤ Nat.card K →
      SylowFixedLine (StatedOmega (StatedQuadPlus 2 K)) (e1P K))
    {W : Type} [CommGroup W] [Finite W] (H : Subgroup (MulAut W)) (n : ℕ) (hn : 2 ≤ n)
    (hN : NatOmegaPlus H ⊤ ⊥ 4 n) :
    letI : MulDistribMulAction ↥H W := MulDistribMulAction.compHom W H.subtype
    letI : MulAction ↥H W := MulAction.compHom W H.subtype
    ∀ S : Sylow 2 ↥H,
      letI : MulDistribMulAction ↥S W :=
        MulDistribMulAction.compHom W (H.subtype.comp (S : Subgroup ↥H).subtype)
      ∀ B : Subgroup ↥H, Odd (Nat.card ↥B) →
        B ≤ Subgroup.normalizer ((S : Subgroup ↥H) : Set ↥H) →
        IsCyclic ↥(B ⊓ fixingSubgroupOf ↥H W (fixedPointSubgroup ↥S W : Set W)) ∧
          ∀ E : Subgroup ↥H, E ≤ B →
            E ⊓ fixingSubgroupOf ↥H W (fixedPointSubgroup ↥S W : Set W) = ⊥ → IsCyclic ↥E := by
  obtain ⟨-, K, hK, hKfin, hKcard, hR⟩ := hN
  letI : Field K := hK
  letI : Finite K := hKfin
  haveI hchar : CharP K 2 := CFSG.Timmesfeld.ClassicalOrders.charP_two_of_card_eq hKcard
  have h4 : 4 ≤ Nat.card K := by
    rw [hKcard]
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
  have hR' : (FFModel.nat (StatedOmega (StatedQuadPlus 2 K))).Realizes H ⊤ ⊥ := hR
  intro S B hodd hBN
  let Γ : Subgroup (GL ιP K) := StatedOmega (StatedQuadPlus 2 K)
  have hSFL : SylowFixedLine Γ (e1P K) := hfix K h4
  have hRΓ : (FFModel.nat Γ).Realizes H ⊤ ⊥ := hR'
  obtain ⟨π, e, he⟩ := exists_natEquiv (K := K) (ι := ιP) hRΓ
  let ρ : ↥H →* GL ιP K := Γ.subtype.comp π.symm.toMonoidHom
  let S' : Sylow 2 ↥Γ := S.mapSurjective (f := π.symm.toMonoidHom) π.symm.surjective
  obtain ⟨x, hx⟩ := hSFL S'
  let w₀ : ιP → K := ((x : GL ιP K) : Matrix ιP ιP K) *ᵥ e1P K
  have hw₀def : w₀ = ((x : GL ιP K) : Matrix ιP ιP K) *ᵥ e1P K := rfl
  have he' : ∀ (h : ↥H) (w : W), Multiplicative.toAdd (e ((h : MulAut W) w)) =
      ((ρ h : GL ιP K) : Matrix ιP ιP K) *ᵥ Multiplicative.toAdd (e w) := by
    intro h w
    have h1 := he (π.symm h) w
    rwa [MulEquiv.apply_symm_apply] at h1
  have hS : ∀ v : ιP → K, (∀ s ∈ (S : Subgroup ↥H),
      ((ρ s : GL ιP K) : Matrix ιP ιP K) *ᵥ v = v) ↔ ∃ c : K, v = c • w₀ := by
    intro v
    exact (fixed_iff_fixed_sylowMap π S v).trans (hx v)
  have hCH : fixingSubgroupOf ↥H W (fixedPointSubgroup ↥S W : Set W) = vecStab ρ w₀ :=
    fixingSubgroupOf_fixedPointSubgroup_eq_vecStab he' S hS
  have hB : ∀ g ∈ B, ∃ c : K, ((ρ g : GL ιP K) : Matrix ιP ιP K) *ᵥ w₀ = c • w₀ :=
    fun g hg => exists_mulVec_eq_smul_of_mem_normalizer S hS (hBN hg)
  have hw₀ : w₀ ≠ 0 := by
    rw [hw₀def]
    intro h0
    have hcomp := congrArg (fun v => ((↑x⁻¹ : GL ιP K) : Matrix ιP ιP K) *ᵥ v) h0
    simp only [Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one,
      Matrix.one_mulVec, Matrix.mulVec_zero] at hcomp
    have h1 := congrFun hcomp (Sum.inl 0)
    simp [e1P] at h1
  let σ : ↥H →* ↥Γ := (MulAut.conj (x⁻¹)).toMonoidHom.comp π.symm.toMonoidHom
  have hσinj : Function.Injective (Γ.subtype.comp σ) :=
    (Subgroup.subtype_injective Γ).comp fun a b hab =>
      π.symm.injective ((MulAut.conj (x⁻¹)).injective hab)
  have hEcard : Nat.card ↥((B ⊓ vecStab ρ w₀).map (Γ.subtype.comp σ)) =
      Nat.card ↥(B ⊓ vecStab ρ w₀) := Subgroup.card_map_of_injective hσinj
  have hσy : ∀ y : ↥H, (σ y : ↥Γ) = x⁻¹ * π.symm y * x := by
    intro y
    show MulAut.conj (x⁻¹) (π.symm y) = x⁻¹ * π.symm y * x
    rw [MulAut.conj_apply, inv_inv]
  have hunit : ∀ y : ↥H, Γ.subtype (σ y) =
      ((x⁻¹ : ↥Γ) : GL ιP K) * ρ y * ((x : ↥Γ) : GL ιP K) := by
    intro y
    rw [hσy y, map_mul, map_mul]
    rfl
  have hx1 : (((x : ↥Γ) : GL ιP K) : Matrix ιP ιP K) *ᵥ e1P K = w₀ := rfl
  have hx2 : (((x⁻¹ : ↥Γ) : GL ιP K) : Matrix ιP ιP K) *ᵥ w₀ = e1P K := by
    rw [hw₀def, Matrix.mulVec_mulVec, ← Units.val_mul]
    simp
  have hx3 : ((x : ↥Γ) : GL ιP K) = (((x⁻¹ : ↥Γ) : GL ιP K))⁻¹ := by
    rw [Subgroup.coe_inv, inv_inv]
  have hEform : ∀ g ∈ (B ⊓ vecStab ρ w₀).map (Γ.subtype.comp σ), ∀ v,
      StatedQuadPlus 2 K (((g : GL ιP K) : Matrix ιP ιP K) *ᵥ v) =
        StatedQuadPlus 2 K v := by
    intro g hg v
    obtain ⟨y, -, rfl⟩ := Subgroup.mem_map.mp hg
    exact CFSG.GroupTheory.WeirSylow.apply_mulVec_of_mem_isometryCore
      (CFSG.GroupTheory.WeirSylow.statedOmega_le_isometryCore
        (StatedQuadPlus 2 K) (σ y).2) v
  have hEfix : ∀ g ∈ (B ⊓ vecStab ρ w₀).map (Γ.subtype.comp σ),
      ((g : GL ιP K) : Matrix ιP ιP K) *ᵥ e1P K = e1P K := by
    intro g hg
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hg
    have hy1 : ((ρ y : GL ιP K) : Matrix ιP ιP K) *ᵥ w₀ = w₀ := hy.2
    simp only [MonoidHom.comp_apply]
    rw [hunit y]
    calc (((((x⁻¹ : ↥Γ) : GL ιP K)) * ρ y * (((x : ↥Γ) : GL ιP K)) : GL ιP K) :
          Matrix ιP ιP K) *ᵥ e1P K
        = ((MulAut.conj ((x⁻¹ : ↥Γ) : GL ιP K) (ρ y) : GL ιP K) : Matrix ιP ιP K) *ᵥ
            e1P K := by
          rw [MulAut.conj_apply, hx3]
      _ = ( (((x⁻¹ : ↥Γ) : GL ιP K)) : Matrix ιP ιP K) *ᵥ
            (((ρ y : GL ιP K) : Matrix ιP ιP K) *ᵥ
              (((((x⁻¹ : ↥Γ) : GL ιP K))⁻¹ : GL ιP K) : Matrix ιP ιP K) *ᵥ e1P K) :=
          mulVec_mulAutConj _ _ _
      _ = e1P K := by
          rw [← hx3, hx1, hy1, hx2]
  have hEodd : Odd (Nat.card ↥((B ⊓ vecStab ρ w₀).map (Γ.subtype.comp σ))) := by
    rw [hEcard]
    exact hodd.of_dvd_nat (Subgroup.card_dvd_of_le inf_le_left)
  have hcyc : IsCyclic ↥((B ⊓ vecStab ρ w₀).map (Γ.subtype.comp σ)) :=
    isCyclic_of_odd_of_fix hEform hEodd hEfix
  have key1 : ∀ C : Subgroup ↥H, C = vecStab ρ w₀ → IsCyclic ↥(B ⊓ C) := by
    intro C hC
    rw [hC]
    exact isCyclic_of_injective (Subgroup.equivMapOfInjective (B ⊓ vecStab ρ w₀)
      (Γ.subtype.comp σ) hσinj).toMonoidHom
      (Subgroup.equivMapOfInjective (B ⊓ vecStab ρ w₀) (Γ.subtype.comp σ) hσinj).injective
  have key2 : ∀ C : Subgroup ↥H, C = vecStab ρ w₀ → ∀ E : Subgroup ↥H, E ≤ B →
      E ⊓ C = ⊥ → IsCyclic ↥E := by
    intro C hC E hEB hE
    rw [hC] at hE
    exact isCyclic_of_inf_vecStab_eq_bot ρ hw₀ hB hEB hE
  exact ⟨key1 _ hCH, fun E hEB hE => key2 _ hCH E hEB hE⟩

theorem kTab23c_of_sylowFixedLine
    (hfixM : ∀ (K : Type) [Field K] [Finite K] [CharP K 2] (b c : K),
      (∀ s : K, s ^ 2 + b * s + c ≠ 0) →
        SylowFixedLine (StatedOmega (StatedQuadMinus 2 K b c)) (e1M K))
    (hfixP : ∀ (K : Type) [Field K] [Finite K] [CharP K 2], 4 ≤ Nat.card K →
      SylowFixedLine (StatedOmega (StatedQuadPlus 2 K)) (e1P K)) :
    KTab23c := by
  intro W _ _ H n hnat hperf S l CH B hcomm hodd hcard
  constructor
  · rintro ⟨hOm, hNm⟩
    have hn1 : 1 ≤ n := by
      obtain ⟨-, K, hK, hKfin, b, c, hKcard, -, -⟩ := hNm
      letI : Field K := hK
      letI : Finite K := hKfin
      have h2 : 1 < 2 ^ n := hKcard ▸ Finite.one_lt_card (α := K)
      rcases Nat.eq_zero_or_pos n with h | h
      · rw [h] at h2; simp at h2
      · exact h
    have hBN : B ≤ Subgroup.normalizer ((S : Subgroup ↥H) : Set ↥H) :=
      borelPositionTwo_of_isOmegaMinus_four hn1 hOm S B hcomm hodd hcard
    exact kTab23c_minus_of_le_normalizer hfixM H n hNm S B hodd hBN
  · rintro ⟨hOp, hNp⟩
    rcases Nat.eq_zero_or_pos n with hn0 | hnpos
    · subst hn0
      obtain ⟨-, K, hK, hKfin, hKcard, -⟩ := hNp
      letI : Field K := hK
      letI : Finite K := hKfin
      have h2 : 1 < Nat.card K := Finite.one_lt_card
      rw [hKcard] at h2
      simp at h2
    · rcases Nat.lt_or_ge n 2 with hlt | hge
      · have hn1 : n = 1 := by omega
        have hsub : Subsingleton ↥H :=
          subsingleton_of_isOmegaPlus_four_one (hn1 ▸ hOp) hperf
        refine ⟨?_, ?_⟩
        · haveI : Subsingleton ↥(B ⊓ CH) :=
            ⟨fun a b => Subtype.ext (Subsingleton.elim (a.1 : ↥H) b.1)⟩
          exact isCyclic_of_subsingleton
        · intro E hEB hE
          haveI : Subsingleton ↥E :=
            ⟨fun a b => Subtype.ext (Subsingleton.elim (a.1 : ↥H) b.1)⟩
          exact isCyclic_of_subsingleton
      · have hBN : B ≤ Subgroup.normalizer ((S : Subgroup ↥H) : Set ↥H) :=
          borelPositionTwo_of_isOmegaPlus_four hge hOp S B hcomm hodd hcard
        exact kTab23c_plus_of_le_normalizer hfixP H n hge hNp S B hodd hBN

end CFSG.LocalAnalysis.UniquenessCase.UC22.KTabC

