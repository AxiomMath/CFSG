variable {K : Type} [Field K]

private lemma coe_minusPairFlip_zero_one [Finite K] [CharP K 2] {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    ((minusPairFlip (b := b) (c := c) hirr (⟨0, by norm_num⟩ : Fin (3 - 1))
        (⟨1, by norm_num⟩ : Fin (3 - 1)) (by decide) :
        StatedOmega (StatedQuadMinus 3 K b c)) : GL
          (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) K) =
      permGL (minusFlip (3 - 1) ⟨0, by norm_num⟩) *
        permGL (minusFlip (3 - 1) ⟨1, by norm_num⟩) := by
  rw [coe_minusPairFlip]

private lemma minusPairFlip_zero_one_mulVec_single [Finite K] [CharP K 2] {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    (((minusPairFlip (b := b) (c := c) hirr (⟨0, by norm_num⟩ : Fin (3 - 1))
        (⟨1, by norm_num⟩ : Fin (3 - 1)) (by decide) :
        StatedOmega (StatedQuadMinus 3 K b c)) : GL
          (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) K) :
        Matrix (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2)
          (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) K) *ᵥ
      Pi.single (Sum.inl (⟨0, by norm_num⟩ : Fin (3 - 1))) 1 =
    Pi.single (Sum.inr (Sum.inl (⟨0, by norm_num⟩ : Fin (3 - 1)))) 1 := by
  rw [coe_minusPairFlip_zero_one hirr, Units.val_mul, ← Matrix.mulVec_mulVec,
    mulVec_permGL, mulVec_permGL, minusFlip_inv, minusFlip_inv]
  rw [Pi.single_comp_equiv, Pi.single_comp_equiv]
  rw [show (minusFlip (3 - 1) ⟨0, by norm_num⟩).symm = minusFlip (3 - 1) ⟨0, by norm_num⟩
      from minusFlip_inv _ _,
    show (minusFlip (3 - 1) ⟨1, by norm_num⟩).symm = minusFlip (3 - 1) ⟨1, by norm_num⟩
      from minusFlip_inv _ _]
  rw [minusFlip_apply_inl_of_ne (m := 3 - 1) (i := ⟨1, by norm_num⟩)
      (j := ⟨0, by norm_num⟩) (by decide), minusFlip_apply_inl]

theorem genLine_statedOmegaMinus_three [Finite K] [CharP K 2] {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    KGenProof.GenLine 3 (StatedOmega (StatedQuadMinus 3 K b c))
      (Pi.single (Sum.inl ⟨0, by norm_num⟩) 1 : Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2 → K) := by
  classical
  obtain ⟨E, hEinj, hEΩ, hEfix, hEcomm, hEflip⟩ := exists_omegaEmbed (K := K) b c
  obtain ⟨g₂, hg₂Ω, hg₂3, hg₂flip⟩ := exists_orderThree_flip (K := K) hirr
  let E' : ↥(StatedOmega (StatedQuadMinus 2 K b c)) →*
      ↥(StatedOmega (StatedQuadMinus 3 K b c)) :=
    (E.comp (StatedOmega (StatedQuadMinus 2 K b c)).subtype).codRestrict
      (StatedOmega (StatedQuadMinus 3 K b c)) (fun x => hEΩ (x : GL _ K) x.2)
  have hE'inj : Function.Injective E' := by
    intro x y hxy
    apply Subtype.ext
    apply hEinj
    exact congrArg (fun z : ↥(StatedOmega (StatedQuadMinus 3 K b c)) =>
      (z : GL (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) K)) hxy
  have hperf4 : Group.IsPerfect ↥(StatedOmega (StatedQuadMinus 2 K b c)) :=
    CFSG.RankThree.GF2n.Smith81.Smith23E1.kfs_perfect_minus hirr
  have hperf : ⁅E'.range, E'.range⁆ = E'.range := by
    have hp : ⁅(⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c))),
        (⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c)))⁆ =
        (⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c))) := by
      exact Group.isPerfect_def.mp hperf4
    calc ⁅E'.range, E'.range⁆
        = ⁅(⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c))).map E',
            (⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c))).map E'⁆ := by
          rw [MonoidHom.range_eq_map]
      _ = (⁅(⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c))),
            (⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c)))⁆).map E' :=
          (Subgroup.map_commutator
            (⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c)))
            (⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c))) E').symm
      _ = (⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c))).map E' := by rw [hp]
      _ = E'.range := (MonoidHom.range_eq_map E').symm
  have hfix : ∀ v ∈ E'.range,
      (((v : ↥(StatedOmega (StatedQuadMinus 3 K b c))) : GL
        (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) K) : Matrix (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2)
          (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) K) *ᵥ
        Pi.single (Sum.inl (⟨0, by norm_num⟩ : Fin (3 - 1))) 1 =
      Pi.single (Sum.inl (⟨0, by norm_num⟩ : Fin (3 - 1))) 1 := by
    rintro _ ⟨y, rfl⟩
    exact hEfix (y : GL (Fin (2 - 1) ⊕ Fin (2 - 1) ⊕ Fin 2) K)
  let g : ↥(StatedOmega (StatedQuadMinus 3 K b c)) := E' ⟨g₂, hg₂Ω⟩
  have hg : g ∈ E'.range := ⟨⟨g₂, hg₂Ω⟩, rfl⟩
  have hg3 : orderOf g = 3 := by
    rw [show orderOf g = orderOf (⟨g₂, hg₂Ω⟩ : ↥(StatedOmega (StatedQuadMinus 2 K b c)))
        from orderOf_injective E' hE'inj _]
    rw [show orderOf (⟨g₂, hg₂Ω⟩ : ↥(StatedOmega (StatedQuadMinus 2 K b c))) = orderOf g₂
        from (orderOf_injective (StatedOmega (StatedQuadMinus 2 K b c)).subtype
          Subtype.coe_injective ⟨g₂, hg₂Ω⟩).symm]
    exact hg₂3
  let w₀ : ↥(StatedOmega (StatedQuadMinus 3 K b c)) :=
    minusPairFlip (b := b) (c := c) hirr (⟨0, by norm_num⟩ : Fin (3 - 1))
      (⟨1, by norm_num⟩ : Fin (3 - 1)) (by decide)
  have hw₀GL : ((w₀ : GL (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) K)) =
      permGL (minusFlip (3 - 1) ⟨0, by norm_num⟩) *
        permGL (minusFlip (3 - 1) ⟨1, by norm_num⟩) :=
    coe_minusPairFlip_zero_one hirr
  have hmv : ((w₀ : GL (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) K) :
      Matrix (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2)
        (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) K) *ᵥ
      Pi.single (Sum.inl (⟨0, by norm_num⟩ : Fin (3 - 1))) 1 =
      Pi.single (Sum.inr (Sum.inl (⟨0, by norm_num⟩ : Fin (3 - 1)))) 1 :=
    minusPairFlip_zero_one_mulVec_single hirr
  have hw₀ : w₀ ∉ KTabD.lineStab (StatedOmega (StatedQuadMinus 3 K b c))
      (Pi.single (Sum.inl (⟨0, by norm_num⟩ : Fin (3 - 1))) 1) := by
    rintro ⟨c, hc⟩
    rw [hmv] at hc
    have h1 : (0 : K) = c := by
      simpa using congrFun hc (Sum.inl (⟨0, by norm_num⟩ : Fin (3 - 1)))
    have h2 : (1 : K) = 0 := by
      have h := congrFun hc (Sum.inr (Sum.inl (⟨0, by norm_num⟩ : Fin (3 - 1))))
      rw [← h1] at h
      simpa using h
    exact one_ne_zero h2
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hg₂flip
  have hconj1 : permGL (minusFlip (3 - 1) ⟨1, by norm_num⟩) * E g₂ *
      (permGL (minusFlip (3 - 1) ⟨1, by norm_num⟩))⁻¹ =
      E (permGL (minusFlip (2 - 1) ⟨0, by norm_num⟩) * g₂ *
        (permGL (minusFlip (2 - 1) ⟨0, by norm_num⟩))⁻¹) := by
    rw [← hEflip]
    rw [← map_mul, ← map_inv, ← map_mul]
  have hconj2 : permGL (minusFlip (3 - 1) ⟨0, by norm_num⟩) *
      E (permGL (minusFlip (2 - 1) ⟨0, by norm_num⟩) * g₂ *
        (permGL (minusFlip (2 - 1) ⟨0, by norm_num⟩))⁻¹) *
      (permGL (minusFlip (3 - 1) ⟨0, by norm_num⟩))⁻¹ =
      E (permGL (minusFlip (2 - 1) ⟨0, by norm_num⟩) * g₂ *
        (permGL (minusFlip (2 - 1) ⟨0, by norm_num⟩))⁻¹) := by
    have hc := hEcomm (permGL (minusFlip (2 - 1) ⟨0, by norm_num⟩) * g₂ *
      (permGL (minusFlip (2 - 1) ⟨0, by norm_num⟩))⁻¹)
    rw [← hc.eq, mul_assoc, mul_inv_cancel, mul_one]
  have hconj : w₀ * g * w₀⁻¹ = g ^ k := by
    apply Subtype.ext
    rw [Subgroup.coe_mul, Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_zpow]
    rw [hw₀GL]
    rw [show ((g : GL (Fin (3 - 1) ⊕ Fin (3 - 1) ⊕ Fin 2) K)) = E g₂ from rfl]
    calc (permGL (minusFlip (3 - 1) ⟨0, by norm_num⟩) *
          permGL (minusFlip (3 - 1) ⟨1, by norm_num⟩)) * E g₂ *
          (permGL (minusFlip (3 - 1) ⟨0, by norm_num⟩) *
            permGL (minusFlip (3 - 1) ⟨1, by norm_num⟩))⁻¹
        = permGL (minusFlip (3 - 1) ⟨0, by norm_num⟩) *
            (permGL (minusFlip (3 - 1) ⟨1, by norm_num⟩) * E g₂ *
              (permGL (minusFlip (3 - 1) ⟨1, by norm_num⟩))⁻¹) *
            (permGL (minusFlip (3 - 1) ⟨0, by norm_num⟩))⁻¹ := by group
      _ = permGL (minusFlip (3 - 1) ⟨0, by norm_num⟩) *
            E (permGL (minusFlip (2 - 1) ⟨0, by norm_num⟩) * g₂ *
              (permGL (minusFlip (2 - 1) ⟨0, by norm_num⟩))⁻¹) *
            (permGL (minusFlip (3 - 1) ⟨0, by norm_num⟩))⁻¹ := by rw [hconj1]
      _ = E (permGL (minusFlip (2 - 1) ⟨0, by norm_num⟩) * g₂ *
            (permGL (minusFlip (2 - 1) ⟨0, by norm_num⟩))⁻¹) := hconj2
      _ = E (g₂ ^ k) := by rw [← hk]
      _ = (E g₂) ^ k := MonoidHom.map_zpow E g₂ k
  have hwg : w₀ * g * w₀⁻¹ ∈ Subgroup.zpowers g :=
    Subgroup.mem_zpowers_iff.mpr ⟨k, hconj.symm⟩
  exact genLine_of_perfect hfix hperf hg hg3 (by norm_num) hw₀ hwg

end CFSG.LocalAnalysis.UniquenessCase.UC22.KGen
