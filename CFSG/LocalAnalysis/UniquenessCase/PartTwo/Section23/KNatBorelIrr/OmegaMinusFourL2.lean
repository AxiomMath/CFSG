open CFSG.Open

variable {K : Type} [Field K] [Finite K] {b c : K}

theorem exists_card_eq_two_pow_of_charP_two [CharP K 2] :
    ∃ n : ℕ, 1 ≤ n ∧ Nat.card K = 2 ^ n := by
  haveI : Fintype K := Fintype.ofFinite K
  obtain ⟨n, -, hn⟩ := FiniteField.card K 2
  refine ⟨(n : ℕ), n.pos, ?_⟩
  rw [Nat.card_eq_fintype_card]
  exact hn

theorem isL2_statedOmega_quadMinus_two (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) {n : ℕ}
    (hn : 1 ≤ n) (hK : Nat.card K = 2 ^ n) :
    IsL2 ↥(StatedOmega (StatedQuadMinus 2 K b c)) (2 * n) :=
  CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p22d_isL2_of_omegaMinus4
    (X := ↥(StatedOmega (StatedQuadMinus 2 K b c))) hn hK b c hirr (MulEquiv.refl _)

theorem le_normalizer_of_ne_top_omegaMinusFour [CharP K 2]
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (U : Sylow 2 ↥(StatedOmega (StatedQuadMinus 2 K b c)))
    {P : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c))}
    (hUP : (U : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c))) ≤ P) (hP : P ≠ ⊤) :
    P ≤ Subgroup.normalizer ((U : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c))) :
      Set ↥(StatedOmega (StatedQuadMinus 2 K b c))) := by
  obtain ⟨n, hn1, hnK⟩ := exists_card_eq_two_pow_of_charP_two (K := K)
  have hX : IsL2 ↥(StatedOmega (StatedQuadMinus 2 K b c)) (2 * n) :=
    isL2_statedOmega_quadMinus_two hirr hn1 hnK
  exact CFSG.LocalAnalysis.UniquenessCase.UC22.l2_sylow_le_normalizer
    (by omega) hX U P hUP hP

theorem commutator_top_statedOmega_quadMinus_two [CharP K 2]
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    ⁅(⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c))),
      (⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c)))⁆ = ⊤ := by
  obtain ⟨n, hn1, hnK⟩ := exists_card_eq_two_pow_of_charP_two (K := K)
  have hX : IsL2 ↥(StatedOmega (StatedQuadMinus 2 K b c)) (2 * n) :=
    isL2_statedOmega_quadMinus_two hirr hn1 hnK
  let S : Sylow 2 ↥(StatedOmega (StatedQuadMinus 2 K b c)) := default
  have hN := CFSG.LocalAnalysis.UniquenessCase.UC22.commutator_top_normalizer_eq_top
    (X := ↥(StatedOmega (StatedQuadMinus 2 K b c))) (by omega : 2 ≤ 2 * n) hX S
  refine le_antisymm le_top ?_
  calc (⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c)))
      = ⁅(⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c))),
          Subgroup.normalizer (S : Set ↥(StatedOmega (StatedQuadMinus 2 K b c)))⁆ := hN.symm
    _ ≤ ⁅(⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c))),
          (⊤ : Subgroup ↥(StatedOmega (StatedQuadMinus 2 K b c)))⁆ :=
        Subgroup.commutator_mono le_rfl le_top

end CFSG.LocalAnalysis.UniquenessCase.UC22.NatBorelIrr
