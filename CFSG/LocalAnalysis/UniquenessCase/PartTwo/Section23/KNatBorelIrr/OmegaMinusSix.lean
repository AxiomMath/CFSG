theorem orthCuts_zero_two_two : OrthCuts 2 (![0, 2] : Fin 2 → ℕ) :=
  ⟨Fin.strictMono_iff_lt_succ.2 (by decide), rfl, by decide⟩

private lemma orthBlockIdx_zero_two_eq_self_L23 (i : Fin 2) :
    orthBlockIdx orthCuts_zero_two_two 0 i = i := by
  fin_cases i <;> decide

private lemma extendMat_orthBlockIdx_zero_two_L23 {K : Type} [Field K]
    (B : Matrix (Fin 2) (Fin 2) K) (p q : Fin 2) :
    extendMat (orthBlockIdx_injective orthCuts_zero_two_two 0) B p q = B p q := by
  have hp : orthBlockIdx orthCuts_zero_two_two 0 p = p := orthBlockIdx_zero_two_eq_self_L23 p
  have hq : orthBlockIdx orthCuts_zero_two_two 0 q = q := orthBlockIdx_zero_two_eq_self_L23 q
  conv_lhs => rw [← hp, ← hq]
  exact extendMat_apply_map (orthBlockIdx_injective orthCuts_zero_two_two 0) B p q

theorem orthExtendGL_torusSL_two {K : Type} [Field K] (u : Kˣ) :
    orthExtendGL orthCuts_zero_two_two 0 (Matrix.SpecialLinearGroup.toGL (torusSL u)) =
      diagGL (rootTorusUnits 2 u) := by
  apply Units.ext
  rw [coe_orthExtendGL]
  change extendMat (orthBlockIdx_injective orthCuts_zero_two_two 0)
      (↑(Matrix.SpecialLinearGroup.toGL (torusSL u)) : Matrix (Fin 2) (Fin 2) K) =
    (↑(diagGL (rootTorusUnits 2 u)) : Matrix (Fin 2) (Fin 2) K)
  ext p q
  rw [extendMat_orthBlockIdx_zero_two_L23,
    Matrix.SpecialLinearGroup.coe_GL_coe_matrix]
  fin_cases p <;> fin_cases q <;>
    simp [torusSL, rootTorusUnits, diagGL, Matrix.diagonal_apply]

section Levi

variable {K : Type} [Field K] [Finite K] [CharP K 2] {b c : K}

theorem commutator_orthogonalGroup_quadTail_two (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    ⁅TauCeti.QuadraticMap.orthogonalGroup (quadTail 2 (minusTailForm K b c)),
      TauCeti.QuadraticMap.orthogonalGroup (quadTail 2 (minusTailForm K b c))⁆ =
        orthElementaryGroup (quadTail 2 (minusTailForm K b c)) := by
  let ψ : (quadTail 2 (minusTailForm K b c)).IsometryEquiv (quadMinus 3 K b c) :=
    minusTailIsometry 3 K b c
  apply Subgroup.map_injective (f := (LinearEquiv.autCongr ψ.toLinearEquiv).toMonoidHom)
    (LinearEquiv.autCongr ψ.toLinearEquiv).injective
  rw [orthMinus_map_autCongr_commutator ψ,
    commutator_orthogonalGroup_quadMinus_of_two_le (n := 3) (by norm_num) hirr]
  exact (CFSG.ComponentClassification.CatalogueBOrthogonalPointIsometry.elementaryGroup_map ψ).symm

theorem orthLeviGL_two_mem_orthElementaryGroup (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (hK : 4 ≤ Nat.card K) (B : SL(2, K)) :
    orthLeviGL (Fin 2 → K) orthCuts_zero_two_two 0 (Matrix.SpecialLinearGroup.toGL B) ∈
      orthElementaryGroup (quadTail 2 (minusTailForm K b c)) := by
  let ρ : SL(2, K) →* (((Fin 2 ⊕ Fin 2 → K) × (Fin 2 → K)) ≃ₗ[K]
      ((Fin 2 ⊕ Fin 2 → K) × (Fin 2 → K))) :=
    (orthLeviGL (Fin 2 → K) orthCuts_zero_two_two 0).comp Matrix.SpecialLinearGroup.toGL
  have hO : ρ.range ≤ TauCeti.QuadraticMap.orthogonalGroup (quadTail 2 (minusTailForm K b c)) := by
    rintro _ ⟨C, rfl⟩
    show dMap (orthExtendGL orthCuts_zero_two_two 0 (Matrix.SpecialLinearGroup.toGL C))
        (1 : (Fin 2 → K) ≃ₗ[K] (Fin 2 → K)) ∈
      TauCeti.QuadraticMap.orthogonalGroup (quadTail 2 (minusTailForm K b c))
    exact dMap_mem_orthogonalGroup _ (one_mem _)
  haveI : Group.IsPerfect (SL(2, K)) :=
    CFSG.ClassicalModels.specialLinear_isPerfect_two_of_four_le_card K hK
  haveI : Group.IsPerfect ↥ρ.range := Group.IsPerfect.range ρ
  have hle : ρ.range ≤ ⁅TauCeti.QuadraticMap.orthogonalGroup (quadTail 2 (minusTailForm K b c)),
      TauCeti.QuadraticMap.orthogonalGroup (quadTail 2 (minusTailForm K b c))⁆ := by
    calc ρ.range = ⁅ρ.range, ρ.range⁆ := (Subgroup.commutator_eq_self).symm
      _ ≤ _ := Subgroup.commutator_mono hO hO
  have hmem : ρ B ∈ orthElementaryGroup (quadTail 2 (minusTailForm K b c)) := by
    rw [← commutator_orthogonalGroup_quadTail_two hirr]
    exact hle (MonoidHom.mem_range.mpr ⟨B, rfl⟩)
  exact hmem

@[expose] noncomputable def rootHomTwo (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0)
    (hK : 4 ≤ Nat.card K) :
    SL(2, K) →* ↥(orthElementaryGroup (quadTail 2 (minusTailForm K b c))) :=
  ((orthLeviGL (Fin 2 → K) orthCuts_zero_two_two 0).comp
    Matrix.SpecialLinearGroup.toGL).codRestrict
      (orthElementaryGroup (quadTail 2 (minusTailForm K b c)))
      (orthLeviGL_two_mem_orthElementaryGroup hirr hK)

theorem rootHomTwo_range_le (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) (hK : 4 ≤ Nat.card K) :
    (rootHomTwo hirr hK).range ≤ orthParab 2 (minusTailForm K b c) ![0, 2] := by
  rintro _ ⟨C, rfl⟩
  exact mem_orthParab.2 fun i =>
    map_tailFlag_orthLeviGL orthCuts_zero_two_two 0 (Matrix.SpecialLinearGroup.toGL C) i

theorem rootHomTwo_torusSL (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) (hK : 4 ≤ Nat.card K)
    (u : Kˣ) :
    (rootHomTwo hirr hK (torusSL u)).val = tailDiag 2 (rootTorusUnits 2 u) 1 := by
  show orthLeviGL (Fin 2 → K) orthCuts_zero_two_two 0
      (Matrix.SpecialLinearGroup.toGL (torusSL u)) = tailDiag 2 (rootTorusUnits 2 u) 1
  rw [orthLeviGL_apply, orthExtendGL_torusSL_two]
  exact (tailDiag_eq_dMap (rootTorusUnits 2 u) 1).symm

