theorem orthCuts_zero_two_three : OrthCuts 3 (![0, 2, 3] : Fin 3 → ℕ) :=
  ⟨Fin.strictMono_iff_lt_succ.2 (by decide), rfl, by decide⟩

section Root

variable {K : Type} [Field K] [CharP K 2] {A : Type} [AddCommGroup A] [Module K A]

@[expose] noncomputable def rootHomThree (qA : QuadraticForm K A) :
    SL(2, K) →* ↥(orthElementaryGroup (quadTail 3 qA)) :=
  (orthParab 3 qA ![0, 2, 3]).subtype.comp (orthLeviSL orthCuts_zero_two_three qA (le_refl 3) 0)

private abbrev BlkThree_L22 : Type :=
  Fin (![0, 2, 3] (Fin.succ 0) - ![0, 2, 3] (Fin.castSucc 0))

private theorem notMem_range_orthBlockIdx_zero_two_L22 :
    (2 : Fin 3) ∉ Set.range (orthBlockIdx orthCuts_zero_two_three 0) := by
  rintro ⟨k, hk⟩
  have hk' : (k : ℕ) = 2 := by
    have h := congrArg Fin.val hk
    simpa [orthBlockIdx_val] using h
  have hklt : (k : ℕ) < 2 := by simpa using k.isLt
  omega

private theorem extendMat_diagonal_rootTorusUnits_three_L22 (u : Kˣ) :
    extendMat (orthBlockIdx_injective orthCuts_zero_two_three 0)
        (Matrix.diagonal fun i => (rootTorusUnits 2 u i : K)) =
      Matrix.diagonal (fun i : Fin 3 => (rootTorusUnits 3 u i : K)) := by
  unfold extendMat
  rw [← Matrix.diagonal_one]
  rw [Matrix.fromBlocks_diagonal, Matrix.submatrix_diagonal_equiv]
  rw [Matrix.diagonal_eq_diagonal_iff]
  intro x
  fin_cases x
  · change Sum.elim (fun i => (rootTorusUnits 2 u i : K)) (fun _ => (1 : K))
        (extendEquiv (orthBlockIdx_injective orthCuts_zero_two_three 0)
          (orthBlockIdx orthCuts_zero_two_three 0 ⟨0, by norm_num⟩)) =
        (rootTorusUnits 3 u (0 : Fin 3) : K)
    rw [extendEquiv_apply_map]
    simp [rootTorusUnits]
  · change Sum.elim (fun i => (rootTorusUnits 2 u i : K)) (fun _ => (1 : K))
        (extendEquiv (orthBlockIdx_injective orthCuts_zero_two_three 0)
          (orthBlockIdx orthCuts_zero_two_three 0 ⟨1, by norm_num⟩)) =
        (rootTorusUnits 3 u (1 : Fin 3) : K)
    rw [extendEquiv_apply_map]
    simp [rootTorusUnits]
  · change Sum.elim (fun i => (rootTorusUnits 2 u i : K)) (fun _ => (1 : K))
        (extendEquiv (orthBlockIdx_injective orthCuts_zero_two_three 0) (2 : Fin 3)) =
        (rootTorusUnits 3 u (2 : Fin 3) : K)
    rw [extendEquiv_apply_of_not_mem (orthBlockIdx_injective orthCuts_zero_two_three 0)
      notMem_range_orthBlockIdx_zero_two_L22]
    simp [rootTorusUnits]

theorem rootHomThree_range_le (qA : QuadraticForm K A) :
    (rootHomThree qA).range ≤ orthParab 3 qA ![0, 2, 3] := by
  rintro _ ⟨B, rfl⟩
  exact (orthLeviSL orthCuts_zero_two_three qA (le_refl 3) 0 B).2

theorem orthExtendGL_torusSL_three (u : Kˣ) :
    orthExtendGL orthCuts_zero_two_three 0 (Matrix.SpecialLinearGroup.toGL (torusSL u)) =
      diagGL (rootTorusUnits 3 u) := by
  have hB : (((Matrix.SpecialLinearGroup.toGL (torusSL u)) : GL BlkThree_L22 K) :
        Matrix BlkThree_L22 BlkThree_L22 K) =
      Matrix.diagonal (fun i : BlkThree_L22 => (rootTorusUnits 2 u i : K)) := by
    ext i j
    fin_cases i <;> fin_cases j
    · change (u : K) = (u : K); rfl
    · change (0 : K) = (0 : K); rfl
    · change (0 : K) = (0 : K); rfl
    · change (((u⁻¹ : Kˣ) : K)) = (((u⁻¹ : Kˣ) : K)); rfl
  apply Units.ext
  rw [coe_orthExtendGL]
  exact (congrArg (fun M => extendMat (orthBlockIdx_injective orthCuts_zero_two_three 0) M)
    hB).trans (extendMat_diagonal_rootTorusUnits_three_L22 u)

theorem rootHomThree_torusSL (qA : QuadraticForm K A) (u : Kˣ) :
    (rootHomThree qA (torusSL u)).val = tailDiag 3 (rootTorusUnits 3 u) 1 := by
  rw [tailDiag_eq_dMap, ← orthExtendGL_torusSL_three u]
  rw [← orthLeviGL_apply orthCuts_zero_two_three 0]
  rfl

end Root

theorem hasRootSL2_omegaMinusEight {K : Type} [Field K] [Finite K] [CharP K 2] {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) :
    HasRootSL2 (StatedOmega (StatedQuadMinus 4 K b c))
      (Pi.single (Sum.inl ⟨0, by omega⟩) 1) := by
  classical
  refine hasRootSL2_of_leastParabolic (K := K)
    (Γ := StatedOmega (StatedQuadMinus 4 K b c))
    (e₀ := Pi.single (Sum.inl ⟨0, by omega⟩) 1)
    (G := OmegaMinusE K b c)
    (minusPhi hirr 1).symm (t3Sylow hirr) (omegaMinusTailQAlpha K b c)
    (omegaMinusTailQZero K b c) (rootHomThree (minusTailForm K b c))
    (map_orthParab_minusPhi_symm hirr 1) ?_ ?_ ?_ ?_
  · rw [t3Sylow_coe]
    exact t3U_le_omegaMinusTailQZero hirr
  · intro P hP hU hnot
    rw [t3Sylow_coe] at hU
    exact omegaMinusTailQAlpha_le_of_parabolic hirr hP hU hnot
  · exact rootHomThree_range_le (minusTailForm K b c)
  · intro u
    refine ⟨?_, ?_⟩
    · rw [t3Sylow_coe, ← t3B_eq_normalizer hirr]
      exact Subgroup.mem_subgroupOf.mpr
        (mem_tailBorel_of_eq_tailDiag (rootHomThree_torusSL (minusTailForm K b c) u))
    · have hh : (rootHomThree (minusTailForm K b c) (torusSL u)).val
          (hypVec K (Fin 2 → K) (Sum.inl (0 : Fin (1 + 2)))) =
            (u : K) • hypVec K (Fin 2 → K) (Sum.inl (0 : Fin (1 + 2))) := by
        rw [rootHomThree_torusSL (minusTailForm K b c) u]
        exact tailDiag_rootTorusUnits_hypVec u 1
      exact minusPhi_symm_mulVec_e0 hirr 1
        (rootHomThree (minusTailForm K b c) (torusSL u)) (u : K) hh

