private theorem isExtraspecialExpP_sylow_of_isSpor_J4
    {X : Type} [Group X] [Finite X] (hX : IsSpor X .J4)
    (S : Sylow 3 X) : IsExtraspecialExpP 3 1 ↥(S : Subgroup X) := by
  obtain ⟨e⟩ := hX
  have : Finite (CFSG.Blueprint.NativeSporadic.Carrier .J4) := Finite.of_equiv X e.toEquiv
  have hcardX : Nat.card X = 86775571046077562880 := by
    rw [Nat.card_congr e.toEquiv]
    exact CFSG.Sporadic.J4.card_J4
  have hcardC : Nat.card (CFSG.Blueprint.NativeSporadic.Carrier .J4) =
      86775571046077562880 := (Nat.card_congr e.toEquiv).symm.trans hcardX
  have hfac : (Nat.card (CFSG.Blueprint.NativeSporadic.Carrier .J4)).factorization 3 = 3 :=
    CFSG.HardMathSupport.Timmesfeld.SporadicRank.factorization_eq_of_pow_dvd
      Nat.prime_three (by rw [hcardC]; norm_num)
      ⟨by rw [hcardC]; norm_num, by rw [hcardC]; norm_num⟩
  obtain ⟨x, y, -, hx, hy, hz, hzx, hzy, -, -⟩ := CFSG.SectionRank.J4_sylow3_cubic_witness
  exact isExtraspecialExpP_sylow_of_ex27 hx hy hzx hzy hz hfac e S

theorem r880J4G_dataOfSetup
    (hS : Standing G) (hUC : CFSG.Open.rankThreeUC G) (hC : AGL81TheoremC G) (S : Setup G) :
    UC22.F08.R880J4G (dataOfSetup hS S) := by
  classical
  intro L hL hJ4 hSE _ Q hQ hΓ
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hLM : L ≤ S.M := hL.1.le
  have hL3 : CFSG.Open.pRank 3 L = 2 :=
    (pRank_bar2_eq_of_odd (Y := L) Nat.prime_three (by norm_num)).symm.trans
      (pRank_three_eq_two_of_isSpor_J4 hJ4)
  have hZ : center (Bar2 L) = ⊥ :=
    CFSG.EvenSporadicStandard.J4Std.center_eq_bot_of_isSporadic hJ4
  have hML : S.M ≤ normalizer (L : Set G) := by
    by_contra hnN
    obtain ⟨E, hEL, hEel, hEcard⟩ := CFSG.SectionRank.exists_pRank (p := 3) (by norm_num) L
    have hZ3 : ¬ 3 ∣ Nat.card (center (Bar2 L)) := by
      rw [hZ, Subgroup.card_bot]
      norm_num
    have h4 := UC6S846.calCRankTwice S.M L hL hnN 3 Nat.prime_three (by norm_num) hZ3 E hEL hEel 2
      (by rw [hEcard, hL3])
    have h3 := pRank_le_three_dataOfSetup hS S Nat.prime_three (by norm_num) (le_refl S.M)
    omega
  have hQext : IsExtraspecialExpP 3 1 ↥Q :=
    isExtraspecialExpP_of_isSylowOf_bar hQ (isExtraspecialExpP_sylow_of_isSpor_J4 hJ4)
  have hOut := not_three_dvd_card_outer_of_isSpor_J4 hJ4
  obtain ⟨P, hP, hQP⟩ := exists_sylow_three_ge_of_le hLM hQ
