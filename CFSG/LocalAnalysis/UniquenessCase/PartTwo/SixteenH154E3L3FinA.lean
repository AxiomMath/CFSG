theorem s16h_C_pow_seven : s16h_C ^ 7 = 1 := by decide

theorem s16h_C_ne_one : s16h_C ≠ 1 := by decide

theorem s16h_C_orderOf : orderOf s16h_C = 7 := by
  haveI : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  exact orderOf_eq_prime s16h_C_pow_seven s16h_C_ne_one

theorem s16h_C_card_zpowers : Nat.card (Subgroup.zpowers s16h_C) = 7 := by
  rw [Nat.card_zpowers, s16h_C_orderOf]

private theorem s16h_Cp_mem_zpowers : ∀ x ∈ s16h_Cp, x ∈ Subgroup.zpowers s16h_C := by
  intro x hx
  simp only [s16h_Cp, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact Subgroup.mem_zpowers_iff.mpr ⟨0, by simp⟩
  · exact Subgroup.mem_zpowers_iff.mpr ⟨1, by simp⟩
  · exact Subgroup.mem_zpowers_iff.mpr ⟨2, by simp [zpow_ofNat]⟩
  · exact Subgroup.mem_zpowers_iff.mpr ⟨3, by simp [zpow_ofNat]⟩
  · exact Subgroup.mem_zpowers_iff.mpr ⟨4, by simp [zpow_ofNat]⟩
  · exact Subgroup.mem_zpowers_iff.mpr ⟨5, by simp [zpow_ofNat]⟩
  · exact Subgroup.mem_zpowers_iff.mpr ⟨6, by simp [zpow_ofNat]⟩

private theorem s16h_FList_conj_mem_Cp :
    ∀ x ∈ s16h_FList, x * s16h_C * x⁻¹ ∈ s16h_Cp := by
  intro x hx
  unfold s16h_FList at hx
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide

private theorem s16h_FList_inv_conj_mem_Cp :
    ∀ x ∈ s16h_FList, x⁻¹ * s16h_C * x ∈ s16h_Cp := by
  intro x hx
  unfold s16h_FList at hx
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  all_goals decide

theorem s16h_FSet_le_normalizer : ∀ x ∈ s16h_FSet,
    x ∈ Subgroup.normalizer (Subgroup.zpowers s16h_C : Set s16h_GL32) := by
  intro x hx
  have hx' : x ∈ s16h_FList := by simpa [s16h_FSet] using hx
  rw [Subgroup.mem_normalizer_iff]
  intro n
  constructor
  · intro hn
    have hle : Subgroup.zpowers s16h_C ≤
        (Subgroup.zpowers s16h_C).comap (MulAut.conj x).toMonoidHom := by
      rw [Subgroup.zpowers_le]
      simpa [MulAut.conj_apply] using s16h_Cp_mem_zpowers _
        (s16h_FList_conj_mem_Cp x hx')
    simpa [MulAut.conj_apply] using hle hn
  · intro hn
    have hle : Subgroup.zpowers s16h_C ≤
        (Subgroup.zpowers s16h_C).comap (MulAut.conj x⁻¹).toMonoidHom := by
      rw [Subgroup.zpowers_le]
      simpa [MulAut.conj_apply] using s16h_Cp_mem_zpowers _
        (s16h_FList_inv_conj_mem_Cp x hx')
    have h2 := hle hn
    rw [Subgroup.mem_comap] at h2
    have h3 : (MulAut.conj x⁻¹).toMonoidHom (x * n * x⁻¹) = n := by
      change x⁻¹ * (x * n * x⁻¹) * (x⁻¹)⁻¹ = n
      group
    rwa [h3] at h2

theorem s16h_cov_valid : ∀ p ∈ s16h_covF,
    p.1 ^ 3 = 1 ∧ p.2 ^ 3 = 1 ∧ p.2 ∈ s16h_FSet ∧ p ≠ (1, 1) := by
  decide +kernel

theorem s16h_cover : ∀ M : s16h_M3, M ≠ 0 → ∃ p ∈ s16h_covF,
    (p.1 : s16h_M3) * M * (p.2 : s16h_M3).transpose = M := by
  decide +kernel

