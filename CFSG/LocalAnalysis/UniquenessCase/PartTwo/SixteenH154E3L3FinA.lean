private def s16h_wit (M : s16h_M3) : ℕ := s16h_witTab.getD (s16h_code M) 0

private theorem s16h_cover_wit : ∀ M : s16h_M3, M ≠ 0 → s16h_wit M < s16h_covL.length ∧
    ((s16h_covL.getD (s16h_wit M) (1, 1)).1 : s16h_M3) * M *
      ((s16h_covL.getD (s16h_wit M) (1, 1)).2 : s16h_M3).transpose = M := by
  decide +kernel

theorem s16h_cover : ∀ M : s16h_M3, M ≠ 0 → ∃ p ∈ s16h_covF,
    (p.1 : s16h_M3) * M * (p.2 : s16h_M3).transpose = M := by
  intro M hM
  obtain ⟨hlt, hfix⟩ := s16h_cover_wit M hM
  refine ⟨_, ?_, hfix⟩
  rw [s16h_covF_eq, List.mem_toFinset, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hlt,
    Option.getD_some]
  exact List.getElem_mem hlt

