variable {W : Type} [CommGroup W] [Finite W]

noncomputable abbrev s16h_sl24_univModel (L : Subgroup (MulAut W))
    (hU : ∀ l ∈ L, ∀ u ∈ commSub ⊤ L, l u ∈ commSub ⊤ L) : FFModel where
  Gam := ↥(CFSG.Quasithin.H13.VolI.resHom L (commSub ⊤ L) hU).range
  Amb := W
  act := fun g w => by
    classical
    exact if h : w ∈ commSub ⊤ L then (((g : MulAut ↥(commSub ⊤ L)) ⟨w, h⟩ : ↥(commSub ⊤ L)) : W)
      else w
  sec := commSub ⊤ L
  ker := commSub ⊤ L ⊓ fixV L

theorem s16h_sl24_univ_bound (hW : ∀ w : W, w ^ 2 = 1) {L : Subgroup (MulAut W)}
    (hrow : s16h_H5RowSL2 L (commSub ⊤ L) (commSub ⊤ L ⊓ fixV L) 2)
    (hZ4 : 2 < Nat.card ↥(commSub ⊤ L ⊓ fixV L))
    (hU : ∀ l ∈ L, ∀ u ∈ commSub ⊤ L, l u ∈ commSub ⊤ L)
    {V' : Type} [CommGroup V'] [Finite V'] (hV2 : ∀ v : V', v ^ 2 = 1)
    (C : CFSG.Quasithin.H13.VolI.ModelCover (s16h_sl24_univModel L hU) V') :
    Nat.card C.β.ker ≤
      Nat.card ↥((s16h_sl24_univModel L hU).ker.subgroupOf (s16h_sl24_univModel L hU).sec) := by
  classical
  obtain ⟨K, hKf, hKfin, hKcard, hreal⟩ := hrow.2
  letI : Field K := hKf
  letI : Finite K := hKfin
  let π₀ : (FFModel.nat (StatedSL 2 K)).Gam →* ↥L := Classical.choose hreal
  have hπ₀ : (FFModel.nat (StatedSL 2 K)).RealizesVia L (commSub ⊤ L)
      (commSub ⊤ L ⊓ fixV L) π₀ := Classical.choose_spec hreal
  have hperf : Group.IsPerfect ↥L := by
    have hK4 : 4 ≤ Nat.card K := by rw [hKcard]; norm_num
    haveI : Group.IsPerfect (FFModel.nat (StatedSL 2 K)).Gam :=
      CFSG.Open.StatedAPI.isPerfect_statedSL_two_of_four_le_card hK4
    exact Group.IsPerfect.ofSurjective (f := π₀) hπ₀.1
  have hmem : ∀ l ∈ L, ∀ y ∈ (⊤ : Subgroup W), l y ∈ (⊤ : Subgroup W) :=
    fun l _ y _ => Subgroup.mem_top (l y)
  have hc : commSub (commSub ⊤ L) L = commSub ⊤ L :=
    s16jp_commSub_commSub hperf (Y := ⊤) hmem
  have hZ_le : Nat.card ↥(commSub ⊤ L ⊓ fixV L) ≤ 4 := by
    have hD0 : S16BoundCover (FFModel.nat (StatedSL 2 K)) 2 :=
      s16fh_cover_sl_two (K := K) (n := 2) (by norm_num) hKcard
    have h := s16fh_cover_restrict hD0 hW hU hc inf_le_right hreal
    simpa using h
  have hZ_eq_4 : Nat.card ↥(commSub ⊤ L ⊓ fixV L) = 4 := by
    have hpow : Nat.card ↥(commSub ⊤ L ⊓ fixV L) = 2 ^ rk ↥(commSub ⊤ L ⊓ fixV L) :=
      card_eq_two_pow hW _
    have hlt : 1 < rk ↥(commSub ⊤ L ⊓ fixV L) := by
      have h : 2 ^ 1 < 2 ^ rk ↥(commSub ⊤ L ⊓ fixV L) := by
        rw [pow_one, ← hpow]
        exact hZ4
      exact (Nat.pow_lt_pow_iff_right (by norm_num : 1 < 2)).1 h
    have hle : rk ↥(commSub ⊤ L ⊓ fixV L) ≤ 2 := by
      have h : 2 ^ rk ↥(commSub ⊤ L ⊓ fixV L) ≤ 2 ^ 2 := by
        rw [← hpow]
        exact hZ_le
      exact (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).1 h
    have hrk : rk ↥(commSub ⊤ L ⊓ fixV L) = 2 := by omega
    rw [hpow, hrk]
    norm_num
  have hbound : Nat.card C.β.ker ≤ 4 := by
    obtain ⟨K₂, hK₂f, hK₂fin, hK₂card, π, β, hπs, hβs, hβk, hβe⟩ :=
      s16h_sl24_cover_coord (L := L) (U := commSub ⊤ L) (Z := commSub ⊤ L ⊓ fixV L) hrow
    letI : Field K₂ := hK₂f
    letI : Finite K₂ := hK₂fin
    haveI : Fintype K₂ := Fintype.ofFinite K₂
    have hF : Fintype.card K₂ = 2 ^ 2 := by
      rw [← Nat.card_eq_fintype_card, hK₂card]
      norm_num
    haveI : CharP K₂ 2 := charP_of_card_eq_prime_pow hF
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    letI : Algebra (ZMod 2) K₂ := ZMod.algebra K₂ 2
    have hZk : (commSub ⊤ L ⊓ fixV L).subgroupOf (commSub ⊤ L) = β.ker := by
      ext x
      rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
      exact (hβk x).symm
    have hNβ : (commSub ⊤ L ⊓ fixV L).subgroupOf (commSub ⊤ L) ≤ β.ker := by rw [hZk]
    let e : (s16h_sl24_univModel L hU).Sec →* Multiplicative (Fin 2 → K₂) :=
      QuotientGroup.lift ((commSub ⊤ L ⊓ fixV L).subgroupOf (commSub ⊤ L)) β hNβ
    have he_mk : ∀ u : ↥(commSub ⊤ L), e (QuotientGroup.mk u) = β u :=
      fun u => QuotientGroup.lift_mk _ _ u
    have he_ker : e.ker = ⊥ := by
      ext w
      obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective w
      rw [MonoidHom.mem_ker, he_mk u, Subgroup.mem_bot, QuotientGroup.eq_one_iff,
        Subgroup.mem_subgroupOf]
      exact hβk u
    let gmap : ↥(StatedSL 2 K₂) →* (s16h_sl24_univModel L hU).Gam :=
      (CFSG.Quasithin.H13.VolI.resHom L (commSub ⊤ L) hU).rangeRestrict.comp π
    have hgmap_s : Function.Surjective gmap :=
      (MonoidHom.rangeRestrict_surjective _).comp hπs
    let π'' : ↥(StatedSL 2 K₂) →* ↥(C.ρ.range) := (C.ρ.rangeRestrict).comp gmap
    have hπ''s : Function.Surjective π'' :=
      (MonoidHom.rangeRestrict_surjective _).comp hgmap_s
    let β'' : ↥(⊤ : Subgroup V') →* Multiplicative (Fin 2 → K₂) :=
      e.comp (C.β.comp (⊤ : Subgroup V').subtype)
    have hβ''s : Function.Surjective β'' := by
      intro q
      obtain ⟨u, hu⟩ := hβs q
      obtain ⟨v, hv⟩ := C.surj (QuotientGroup.mk u)
      refine ⟨⟨v, Subgroup.mem_top v⟩, ?_⟩
      change e (C.β v) = q
      rw [hv, he_mk u]
      exact hu
    have hβ''k : ∀ v : ↥(⊤ : Subgroup V'), β'' v = 1 ↔ (v : V') ∈ C.β.ker := by
      intro v
      change e (C.β (v : V')) = 1 ↔ (v : V') ∈ C.β.ker
      constructor
      · intro h
        have h2 : C.β (v : V') ∈ e.ker := MonoidHom.mem_ker.2 h
        rw [he_ker, Subgroup.mem_bot] at h2
        exact MonoidHom.mem_ker.2 h2
      · intro h
        have h2 : C.β (v : V') = 1 := MonoidHom.mem_ker.1 h
        rw [h2, map_one]
    have hβ''e : ∀ (γ : ↥(StatedSL 2 K₂)) (v : ↥(⊤ : Subgroup V'))
        (hv : (π'' γ : MulAut V') (v : V') ∈ (⊤ : Subgroup V')),
        β'' ⟨(π'' γ : MulAut V') (v : V'), hv⟩ =
          Multiplicative.ofAdd ((SLCover.natRepQ 2 K₂) γ (Multiplicative.toAdd (β'' v))) := by
      intro γ v hv
      obtain ⟨m, hvm⟩ := QuotientGroup.mk_surjective (C.β (v : V'))
      have h4 : (s16h_sl24_univModel L hU).act (gmap γ) (m : W) =
          (π γ : MulAut W) (m : W) := by
        simp only [s16h_sl24_univModel]
        rw [dif_pos m.2]
        rfl
      have hmU : (s16h_sl24_univModel L hU).act (gmap γ) (m : W) ∈ commSub ⊤ L := by
        rw [h4]
        exact hU (π γ) (π γ).2 (m : W) m.2
      have h2 : C.β ((π'' γ : MulAut V') (v : V')) =
          QuotientGroup.mk (⟨(s16h_sl24_univModel L hU).act (gmap γ) (m : W), hmU⟩ :
            ↥(commSub ⊤ L)) := by
        rw [show ((π'' γ : ↥(C.ρ.range)) : MulAut V') = C.ρ (gmap γ) from rfl]
        exact C.equiv (gmap γ) (v : V') m hmU hvm.symm
      have h5 : β ⟨(s16h_sl24_univModel L hU).act (gmap γ) (m : W), hmU⟩ =
          Multiplicative.ofAdd ((SLCover.natRepQ 2 K₂) γ (Multiplicative.toAdd (β m))) := by
        have h5a : (⟨(s16h_sl24_univModel L hU).act (gmap γ) (m : W), hmU⟩ :
            ↥(commSub ⊤ L)) =
            ⟨(π γ : MulAut W) (m : W), hU (π γ) (π γ).2 (m : W) m.2⟩ :=
          Subtype.ext h4
        rw [h5a, hβe γ m (hU (π γ) (π γ).2 (m : W) m.2)]
        rfl
      have h6 : β'' v = e (C.β (v : V')) := rfl
      have h7 : β'' v = β m := by
        rw [h6, hvm.symm, he_mk m]
      have hL : β'' ⟨(π'' γ : MulAut V') (v : V'), hv⟩ =
          Multiplicative.ofAdd ((SLCover.natRepQ 2 K₂) γ (Multiplicative.toAdd (β m))) := by
        change e (C.β ((π'' γ : MulAut V') (v : V'))) = _
        rw [h2, he_mk, h5]
      rw [hL, h7]
    have hcard := card_le_pow_finrank_H1_dual (Γ := ↥(StatedSL 2 K₂)) hV2 (C.ρ.range) ⊤
      (C.β.ker) le_top (fun z hz x hx => by
        obtain ⟨γ, rfl⟩ := hx
        exact C.fix γ z (MonoidHom.mem_ker.1 hz))
      (fun x hx v hv => Subgroup.mem_top _)
      (MS93.ModelCover.commOf_range C) π'' hπ''s (SLCover.natRepQ 2 K₂) β'' hβ''s hβ''k hβ''e
    rw [CFSG.Quasithin.B513N.finrank_H1_SL2' hF (by omega) (SLCover.binaryNaturalSL_dual 2 K₂)]
      at hcard
    simpa using hcard
  have hZU : commSub ⊤ L ⊓ fixV L ≤ commSub ⊤ L := inf_le_left
  have hcard_eq : Nat.card ↥((commSub ⊤ L ⊓ fixV L).subgroupOf (commSub ⊤ L)) =
      Nat.card ↥(commSub ⊤ L ⊓ fixV L) :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hZU).toEquiv
  rw [hcard_eq, hZ_eq_4]
  exact hbound

end CFSG.LocalAnalysis.UniquenessCase.PartTwo
