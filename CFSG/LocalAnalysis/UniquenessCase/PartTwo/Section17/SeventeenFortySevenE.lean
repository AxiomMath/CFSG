@[expose] def K_L3AutOThreeRank : Prop :=
  ∀ (K : Type) [Group K] [Finite K] [Finite (MulAut K)] (f : ℕ),
    CFSG.Open.IsQuasisimple K → IsL3 (K ⧸ Subgroup.center K) f → 3 ∣ 2 ^ f - 1 →
      Odd (Nat.card (Subgroup.center K)) →
        Nat.card (Subgroup.center K) ∣ 3 ∧
          ∀ H : Subgroup (MulAut K), CFSG.GH74.GLS.oResidual 3 ↥H = ⊤ →
            CFSG.Open.pRank 3 H ≤ 2

theorem mem_centOverO2_conj {D : Data G} {L : Subgroup G}
    (hMN : D.M ≤ Subgroup.normalizer (L : Set G)) {m : G} (hm : m ∈ D.M)
    {y : G} (hy : y ∈ F08.CentOverO2 D.M L) :
    m * y * m⁻¹ ∈ F08.CentOverO2 D.M L := by
  rw [mem_centOverO2_iff] at hy ⊢
  refine ⟨D.M.mul_mem (D.M.mul_mem hm hy.1) (D.M.inv_mem hm), ?_⟩
  intro l hl
  have hml : m⁻¹ * l * m ∈ L := by
    have h1 := (Subgroup.mem_normalizer_iff.mp (hMN (D.M.inv_mem hm)) l).mp hl
    simpa [mul_assoc] using h1
  have h1 := hy.2 (m⁻¹ * l * m) hml
  have hMP : D.M ≤ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
    hMN.trans (CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf (r := 2) L)
  have h2 := (Subgroup.mem_normalizer_iff.mp (hMP hm) _).mp h1
  have h3 : m * (y * (m⁻¹ * l * m) * y⁻¹ * (m⁻¹ * l * m)⁻¹) * m⁻¹ =
      (m * y * m⁻¹) * l * (m * y * m⁻¹)⁻¹ * l⁻¹ := by group
  rwa [h3] at h2

theorem mem_pCoreOf_of_centralizesBar {L : Subgroup G} {x : G} (hxL : x ∈ L)
    (hcent : ∀ l ∈ L, x * l * x⁻¹ * l⁻¹ ∈ pCoreOf 2 L)
    (hZ : Subgroup.center (Bar2 L) = ⊥) : x ∈ pCoreOf 2 L := by
  have hxbar : (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) ⟨x, hxL⟩ ∈
      Subgroup.center (Bar2 L) := by
    rw [Subgroup.mem_center_iff]
    intro y
    obtain ⟨l, rfl⟩ := QuotientGroup.mk_surjective y
    have hcommL : ⁅(⟨x, hxL⟩ : ↥L), l⁆ ∈ CFSG.pCore 2 ↥L := by
      obtain ⟨z, hz, hzval⟩ := Subgroup.mem_map.mp (hcent (l : G) l.2)
      have hzeq : ⁅(⟨x, hxL⟩ : ↥L), l⁆ = z := by
        apply Subtype.ext
        simpa [commutatorElement_def, Subgroup.coe_mul, Subgroup.coe_inv] using hzval.symm
      rw [hzeq]
      exact hz
    have h1 : (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) ⁅(⟨x, hxL⟩ : ↥L), l⁆ = 1 :=
      (QuotientGroup.eq_one_iff _).mpr hcommL
    have h2 : ⁅(QuotientGroup.mk' (CFSG.pCore 2 ↥L)) ⟨x, hxL⟩,
        (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) l⁆ = 1 := by
      simpa [map_commutatorElement] using h1
    exact (commutatorElement_eq_one_iff_mul_comm.mp h2).symm
  rw [hZ] at hxbar
  have hxpcore : (⟨x, hxL⟩ : ↥L) ∈ CFSG.pCore 2 ↥L :=
    (QuotientGroup.eq_one_iff (⟨x, hxL⟩ : ↥L)).mp (Subgroup.mem_bot.mp hxbar)
  exact Subgroup.mem_map_of_mem L.subtype hxpcore

theorem s17_47_cartan_cent_caseA
    {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ} {C Dc : Subgroup G} {Gamma : Set G}
    (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (hL3 : IsL3 (BarInf L) n) (hLX : L = X)
    (hK3 : Inputs1719.K_BorelTorusAbelianRankTwoNotL34)
    (hK4 : Inputs1719.K_CartanRankLeThree)
    {r : ℕ} (hr : r.Prime) (hr5 : 5 ≤ r) (hrdvd : r ∣ 2 ^ n - 1)
    (hp : p.Prime) (hp2 : p ≠ 2) (hp3 : p ≠ 3) (hpdvd : p ∣ 2 ^ n - 1)
    {E : Subgroup G} (hEL : E ≤ L)
    (hEN : E ≤ Subgroup.normalizer ((D.T ⊓ L : Subgroup G) : Set G))
    (hEel : CFSG.Open.IsElemAbelian r E) :
    2 ≤ CFSG.Open.pRank p (D.M ⊓ Subgroup.centralizer (E : Set G)) := by
  classical
  have : Fact p.Prime := ⟨hp⟩
  have : Fact r.Prime := ⟨hr⟩
  have hL : L ∈ calC D.M := ctx.mem_calC
  have hqK : CFSG.Open.IsQuasisimple (Bar2 L) := hL.2.2
  have hoddK : Odd (Nat.card (Subgroup.center (Bar2 L))) := uc22p20p_odd_center_bar2 ↥L
  obtain ⟨e⟩ := uc22p21k_barInf_equiv_of_calC hL
  have hmodel : LieModel (Bar2 L ⧸ Subgroup.center (Bar2 L)) .PSL 3 2 n :=
    LieModel.of_mulEquiv e hL3
  have hB : Inputs1719.BorelChevOver (BarInf L) n :=
    Inputs1719.BorelChevOver.of_on hK3 hL3 ⟨by decide, fun ⟨_, _, hn⟩ => by
      subst hn; have h := Nat.le_of_dvd (by norm_num) hrdvd; norm_num at h; omega⟩
  have hC2 : 2 ≤ CFSG.Open.pRank p C := by
    have hbound := cartanRank_le_pRank_cartan_on (hK4 := hK4) (t := .PSL) (m := 3) (n := n)
      (r := p) hL ctx.cartan (by decide) hL3 hp hp2 hpdvd
      (fun _ hd => hp3 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp hd))
      (fun h => absurd h (by decide))
    simpa [CS17LieRank] using hbound
  obtain ⟨Q, hQ⟩ := CFSG.ABGLocalTools.exists_isSylowOf p C
  have hQp : IsPGroup p Q := (CFSG.ABGLocalTools.isSylowOf_iff.mp hQ).2.1
  have hQrank : CFSG.Open.pRank p Q = CFSG.Open.pRank p C :=
    CFSG.LocalAnalysis.RankThreeTheoremC.RankOneCent.pRank_eq_of_isSylowOf hQ
  let S : Subgroup G := D.T ⊓ L
  let B : Subgroup G := L ⊓ Subgroup.normalizer (S : Set G)
  have hSB : S ≤ B := fun x hx => ⟨hx.2, Subgroup.le_normalizer hx⟩
  have hqX := isMulCommutative_normalizer_inf_quotient_of_calC_of_borel (D := D) (L := L)
      (X := X) (n := n) ctx.mem_calC ctx.X_eq hB
  rw [← hLX] at hqX
  have hquot : IsMulCommutative (TauCeti.Subgroup.normalizerQuotient (S.subgroupOf B)) := hqX
  have hnorm : (S.subgroupOf B).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hSB).mpr inf_le_right
  have hab : ∀ a b : ↥B ⧸ S.subgroupOf B, a * b = b * a := by
    intro a b
    let ee : (↥B ⧸ S.subgroupOf B) ≃*
        TauCeti.Subgroup.normalizerQuotient (S.subgroupOf B) :=
      (TauCeti.Subgroup.normalizerQuotientEquivQuotientOfNormal (S.subgroupOf B)).symm
    refine ee.injective ?_
    rw [map_mul, map_mul]
    exact hquot.is_comm.comm _ _
  have hQB : Q ≤ B := le_inf (hQ.le.trans ctx.cartan.1) (hQ.le.trans ctx.cartan.2.2.1)
  have hEB : E ≤ B := le_inf hEL hEN
  have hcomm : ⁅Q, E⁆ ≤ S := by
    rw [Subgroup.commutator_le]
    intro q hq ee he
    exact CFSG.GroupTheory.commutatorElement_mem_of_isMulCommutative_subgroupOf hquot
      (hQB hq) (hEB he) (ctx.cartan.2.2.1 (hQ.le hq)) (hEN he)
  have hS2 : IsPGroup 2 S := D.sylowM.isPGroup.to_le inf_le_left
  have hpS : ¬ p ∣ Nat.card S :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup hS2 hp hp2
  have hrS : ¬ r ∣ Nat.card S :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup hS2 hr (by omega)
  have hle := CFSG.GroupTheory.pRank_le_pRank_inf_centralizer_of_commutator_le
    (p := p) (q := r) (M := D.M) (N := S) (R := Q) (B := E)
    (hRM := hQ.le.trans (ctx.cartan.1.trans hL.1.le))
    (hNM := inf_le_right.trans hL.1.le)
    (hRN := fun q hq => ctx.cartan.2.2.1 (hQ.le hq))
    (hBN := hEN) hQp hEel.isPGroup hpS hrS hcomm
  have h2Q : 2 ≤ CFSG.Open.pRank p Q := hC2.trans_eq hQrank.symm
  exact h2Q.trans hle

theorem s17_47_caseC_cartan_rank
    {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ} {C Dc : Subgroup G} {Gamma : Set G}
    (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (hL3 : IsL3 (BarInf L) n)
    (hK17 : Inputs1719.K_L3CartanThree)
    (h3dvd : 3 ∣ 2 ^ n - 1) :
    (if 3 ∣ Nat.card (Subgroup.center (Bar2 L)) then 2 else 1) ≤
      CFSG.Open.pRank 3 C := by
  classical
  have hL : L ∈ calC D.M := ctx.mem_calC
  have hq : CFSG.Open.IsQuasisimple (Bar2 L) := hL.2.2
  have hodd : Odd (Nat.card (Subgroup.center (Bar2 L))) := uc22p22l_odd_center_quotient
  have hnEven : Even n := by
    rw [← Nat.not_odd_iff_even]
    intro hnOdd
    have h2 : 2 ^ n % 3 = 2 := CFSG.two_pow_mod_three_of_odd hnOdd
    have hk : 2 ^ n = 3 * (2 ^ n / 3) + 2 := by
      have := Nat.div_add_mod (2 ^ n) 3
      omega
    have hmod : (2 ^ n - 1) % 3 = 1 := by
      rw [hk, show 3 * (2 ^ n / 3) + 2 - 1 = 3 * (2 ^ n / 3) + 1 by omega]
      rw [Nat.add_mod, Nat.mul_mod_right, Nat.mod_eq_of_lt (by norm_num)]
    have h0 := Nat.dvd_iff_mod_eq_zero.mp h3dvd
    omega
  obtain ⟨e⟩ := uc22p21k_barInf_equiv_of_calC hL
  have hmodel : LieModel (Bar2 L ⧸ Subgroup.center (Bar2 L)) .PSL 3 2 n :=
    LieModel.of_mulEquiv e hL3
  let Smap : Subgroup (Bar2 L) :=
    ((D.T ⊓ L).subgroupOf L).map (QuotientGroup.mk' (CFSG.pCore 2 ↥L))
  have hS : CFSG.QuasithinUnique.IsSylowTwoOf Smap ⊤ := isSylowTwoOf_sylowBar2 hL
  have happ := hK17 (Bar2 L) n hL3.admissible hnEven hmodel hq hodd Smap hS
  have hO2 : CFSG.pCore 2 ↥L ≤ (D.T ⊓ L).subgroupOf L := pCore_le_sylow_of_mem_calC hL
  have htrans : CFSG.Open.pRank 3 (⊤ : Subgroup
        (TauCeti.Subgroup.normalizerQuotient ((D.T ⊓ L).subgroupOf L))) =
      CFSG.Open.pRank 3 (⊤ : Subgroup (TauCeti.Subgroup.normalizerQuotient Smap)) :=
    CFSG.SectionRank.pRank_top_eq_of_mulEquiv (by norm_num : 1 < 3)
      (CFSG.GroupTheory.normalizerQuotient_quotientEquiv (CFSG.pCore 2 ↥L)
        ((D.T ⊓ L).subgroupOf L) hO2)
  have hcoeeq : CFSG.pRank 3 ↥(⊤ : Subgroup (TauCeti.Subgroup.normalizerQuotient Smap)) =
      CFSG.Open.pRank 3 (⊤ : Subgroup (TauCeti.Subgroup.normalizerQuotient Smap)) :=
    (CFSG.SectionRank.pRank_eq_open_pRank_top 3 _).trans
      (CFSG.SectionRank.pRank_eq_pRank_top_subgroup _).symm
  have hbridge := pRank_normalizerQuotient_le_pRank_cartan hL ctx.cartan
    Nat.prime_three (by norm_num)
  calc (if 3 ∣ Nat.card (Subgroup.center (Bar2 L)) then 2 else 1)
      ≤ CFSG.pRank 3 ↥(⊤ : Subgroup (TauCeti.Subgroup.normalizerQuotient Smap)) := happ
    _ = CFSG.Open.pRank 3 (⊤ : Subgroup (TauCeti.Subgroup.normalizerQuotient Smap)) := hcoeeq
    _ = CFSG.Open.pRank 3 (⊤ : Subgroup
          (TauCeti.Subgroup.normalizerQuotient ((D.T ⊓ L).subgroupOf L))) := htrans.symm
    _ ≤ CFSG.Open.pRank 3 C := hbridge

theorem s17_47_caseC_elements
    {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ} {C Dc : Subgroup G} {Gamma : Set G}
    (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (hL3 : IsL3 (BarInf L) n) (hLX : L = X)
    (hK3 : Inputs1719.K_BorelTorusAbelianRankTwoNotL34)
    (hK17 : Inputs1719.K_L3CartanThree)
    (hSg : CFSG.LocalAnalysis.UniquenessCase.UC6S846.SigmaStd D)
    (h638 : UC6.R6_38 D)
    (hKAut3 : K_L3AutOThreeRank)
    (hp3 : p = 3)
    {r : ℕ} (hr : r.Prime) (hr5 : 5 ≤ r) (hrdvd : r ∣ 2 ^ n - 1)
    (h3dvd : 3 ∣ 2 ^ n - 1)
    {E : Subgroup G} (hEL : E ≤ L)
    (hEN : E ≤ Subgroup.normalizer ((D.T ⊓ L : Subgroup G) : Set G))
    (hEel : CFSG.Open.IsElemAbelian r E) :
    Nat.card (Subgroup.center (Bar2 L)) ∣ 3 ∧
      (∃ t : G, t ∈ L ∧ t ∈ Subgroup.centralizer (E : Set G) ∧ orderOf t = 3 ∧
        t ∉ pCoreOf 2 L) ∧
      (∃ c : G, c ∈ F08.CentOverO2 D.M L ∧ c ∈ Subgroup.centralizer (E : Set G) ∧
        orderOf c = 3) := by
  classical
  subst hp3
  have : Fact r.Prime := ⟨hr⟩
  have hL : L ∈ calC D.M := ctx.mem_calC
  have hqK : CFSG.Open.IsQuasisimple (Bar2 L) := hL.2.2
