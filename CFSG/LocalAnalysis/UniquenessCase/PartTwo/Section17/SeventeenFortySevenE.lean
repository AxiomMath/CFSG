      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hbzp
      have hq : QuotientGroup.mk' N
          ((⟨c, hcY⟩ : ↥Y) * (⟨t, htY⟩ : ↥Y) ^ (-k)) = 1 := by
        rw [map_mul, map_zpow]
        have h2 : b * a ^ (-k) = 1 := by
          rw [← hk]
          group
        exact h2
      have hmem : (⟨c, hcY⟩ : ↥Y) * (⟨t, htY⟩ : ↥Y) ^ (-k) ∈ N :=
        (QuotientGroup.eq_one_iff _).mp hq
      have hmemP : c * t ^ (-k) ∈ P := by
        have := (Subgroup.mem_subgroupOf.mp hmem).2
        simpa [Subgroup.coe_mul, Subgroup.coe_zpow] using this
      have hPL : P ≤ L := CFSG.LieType.BorelTits.pCoreOf_le 2 L
      have hcL : c ∈ L := by
        have h1 : c = (c * t ^ (-k)) * t ^ k := by group
        rw [h1]
        exact L.mul_mem (hPL hmemP) (Subgroup.zpow_mem L htL k)
      have hcCentL : ∀ l ∈ L, c * l * c⁻¹ * l⁻¹ ∈ P :=
        fun l hl => (mem_centOverO2_iff.mp hcCent).2 l hl
      exact hcP (mem_pCoreOf_of_centralizesBar hcL hcCentL hZbot)
    have hquot2 : 2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (↥Y ⧸ N)) :=
      CFSG.GroupTheory.two_le_pRank_of_commute (p := 3) (H := ⊤)
        (x := a) (y := b) (Subgroup.mem_top a) (Subgroup.mem_top b) ha_ord hb_ord
        hcomm_ab hb_not
    have hq2 : 2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup ↥Y) :=
      CFSG.GroupTheory.two_le_pRank_of_quotient N Nat.prime_three (by norm_num) hquot2
    rw [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup Y] at hq2
    simpa [Y] using hq2

theorem s17_47_cartan_cent_caseB
    {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ} {C Dc : Subgroup G} {Gamma : Set G}
    (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (hL3 : IsL3 (BarInf L) n) (hLX : L = X) (h4 : 4 < 2 ^ n)
    (hSg : CFSG.LocalAnalysis.UniquenessCase.UC6S846.SigmaStd D)
    (h638 : UC6.R6_38 D)
    (hT : CFSG.LocalAnalysis.RankThreeUC.S15.LieOddRankChev)
    {r : ℕ} (hr : r.Prime) (hr5 : 5 ≤ r) (hrdvd : r ∣ 2 ^ n - 1)
    (hpnd : ¬ p ∣ 2 ^ n - 1)
    {E : Subgroup G} (hEL : E ≤ L) (hEel : CFSG.Open.IsElemAbelian r E) :
    2 ≤ CFSG.Open.pRank p (D.M ⊓ Subgroup.centralizer (E : Set G)) := by
  classical
  have hp' := D.sig_prime p ctx.p_mem
  have : Fact p.Prime := ⟨hp'.1⟩
  have hp2 : p ≠ 2 := hp'.2
  have hL : L ∈ calC D.M := ctx.mem_calC
  have hMN : D.M ≤ Subgroup.normalizer (L : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hL.1.le).mp
      (uc22p21j_normal_of_conjClosure_eq hL.1.le (hLX.trans ctx.X_eq))
  have hn3 : 3 ≤ n := by
    rcases Nat.lt_or_ge n 3 with hn | hn
    · interval_cases n <;> norm_num [Nat.pow_succ] at h4
    · exact hn
  have hqK : CFSG.Open.IsQuasisimple (Bar2 L) := hL.2.2
  have hoddK : Odd (Nat.card (Subgroup.center (Bar2 L))) := uc22p20p_odd_center_bar2 ↥L
  obtain ⟨e⟩ := uc22p21k_barInf_equiv_of_calC hL
  have hmodel : LieModel (Bar2 L ⧸ Subgroup.center (Bar2 L)) .PSL 3 2 n :=
    LieModel.of_mulEquiv e hL3
  have hS : CFSG.Open.StatedClassicalModel
      (Bar2 L ⧸ Subgroup.center (Bar2 L)) .PSL 3 2 n :=
    hmodel.statedClassicalModel (by simp [CFSG.Blueprint.classicalTags])
  have hdiag : ¬ p ∣ Nat.gcd 3 (2 ^ n - 1) := by
    intro hd
    exact hpnd (hd.trans (Nat.gcd_dvd_right 3 (2 ^ n - 1)))
  have hnice : CFSG.RankThree.PartOne.OutStructure.OutPNice p
      (Bar2 L ⧸ Subgroup.center (Bar2 L)) :=
    CFSG.RankThree.PartOne.OutStructure.outPNice_PSL_ge_three_odd (p := p) hp'.1 hp2
      (X := Bar2 L ⧸ Subgroup.center (Bar2 L)) (n := 3) (r := 2) (m := n) (by norm_num) hS hdiag
  have : Group.IsPerfect (Bar2 L) := Group.isPerfect_def.mpr hqK.1
  have hcomp : CFSG.HasNormalPComplement p
      (Outer (Bar2 L ⧸ Subgroup.center (Bar2 L))) :=
    hasNormalPComplement_outer_of_outPNice hp'.1 hnice
  have hOut : CFSG.HasNormalPComplement p (Outer (Bar2 L)) :=
    hasNormalPComplement_outer_of_centerQuotient hcomp
  have hOp : UC22.F10.OpRes p D.M = D.M := h638 p hp'.1 hp2 (Or.inl ctx.p_mem)
  have hbound := pRank_le_add_pRank_centOverO2 hL.1.le hMN hp'.1 hOut hOp
  let K' : Type := Bar2 L ⧸ Subgroup.center (Bar2 L)
  have hcenter_map : (Subgroup.center (Bar2 L)).map
      (QuotientGroup.mk' (Subgroup.center (Bar2 L))) = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.mp hx
    rw [Subgroup.mem_bot, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hz
  have hqKc : CFSG.IsQuasisimple (Bar2 L) :=
    (CFSG.Foundations.SteinbergCA.quasisimple_iff (Bar2 L)).2.2.1.mpr hqK
  obtain ⟨hqK'c, -, hcenter'⟩ :=
    CFSG.LocalCores.quasisimple_central_quotient hqKc (Subgroup.center (Bar2 L)) le_rfl
  have hqK' : CFSG.Open.IsQuasisimple K' :=
    (CFSG.Foundations.SteinbergCA.quasisimple_iff K').2.2.1.mp hqK'c
  have hcenterK' : Subgroup.center K' = ⊥ := by
    rw [hcenter', hcenter_map]
  have hbot : (K' ⧸ Subgroup.center K') ≃* K' :=
    (QuotientGroup.quotientMulEquivOfEq hcenterK').trans QuotientGroup.quotientBot
  have hS' : CFSG.Open.StatedClassicalModel (K' ⧸ Subgroup.center K') .PSL 3 2 n :=
    CFSG.Open.StatedAPI.statedClassicalModel_of_mulEquiv hbot.symm hS
  have htab := uc22p20w_pRank_psl hT hqK' (m := 3) (n := n) hS' (by norm_num) hn3 hp'.1 hp2
  have heP_ne : CFSG.LocalAnalysis.RankThreeUC.S15.eP (2 ^ n) p ≠ 1 := by
    intro h
    apply hpnd
    have hcast : ((2 ^ n : ℕ) : ZMod p) = 1 := by
      have := orderOf_eq_one_iff.mp h
      simpa [CFSG.LocalAnalysis.RankThreeUC.S15.eP] using this
    have hpow : (2 : ZMod p) ^ n = 1 := by
      simpa using hcast
    exact (CFSG.Timmesfeld.Bang.dvd_two_pow_sub_one_iff n).mpr hpow
  have heP2 : 2 ≤ CFSG.LocalAnalysis.RankThreeUC.S15.eP (2 ^ n) p := by
    have hdvd : CFSG.LocalAnalysis.RankThreeUC.S15.eP (2 ^ n) p ∣ p - 1 := by
      rw [CFSG.LocalAnalysis.RankThreeUC.S15.eP]
      have h2 : ((2 : ZMod p)) ^ n ≠ 0 :=
        pow_ne_zero n (CFSG.Timmesfeld.Bang.two_ne_zero_zmod hp2)
      exact ZMod.orderOf_dvd_card_sub_one (by simpa using h2)
    have hpos : 0 < CFSG.LocalAnalysis.RankThreeUC.S15.eP (2 ^ n) p :=
      Nat.pos_of_dvd_of_pos hdvd (by have := hp'.1.two_le; omega)
    omega
  have hdiv : 3 / CFSG.LocalAnalysis.RankThreeUC.S15.eP (2 ^ n) p ≤ 1 := by
    by_cases h3 : CFSG.LocalAnalysis.RankThreeUC.S15.eP (2 ^ n) p ≤ 3
    · have h23 : CFSG.LocalAnalysis.RankThreeUC.S15.eP (2 ^ n) p = 2 ∨
          CFSG.LocalAnalysis.RankThreeUC.S15.eP (2 ^ n) p = 3 := by omega
      rcases h23 with h | h <;> rw [h] <;> norm_num
    · push Not at h3
      rw [Nat.div_eq_of_lt h3]
      omega
  have hrk : CFSG.LocalAnalysis.RankThreeUC.S15.rkLin 3 true (2 ^ n) p
      (Nat.card (Subgroup.center K')) ≤ 1 := by
    rw [CFSG.LocalAnalysis.RankThreeUC.S15.rkLin]
    simp only [if_true]
    rw [if_neg heP_ne]
    exact hdiv
  have himg : CFSG.Open.pRank p (⊤ : Subgroup
      (Bar2 L ⧸ Subgroup.center (Bar2 L))) ≤ 1 := by
    rw [htab]
    exact hrk
  have h3 : 3 ≤ CFSG.Open.pRank p D.M := hSg.three_le p ctx.p_mem
  have hcent : 2 ≤ CFSG.Open.pRank p (F08.CentOverO2 D.M L) := by
    omega
  have hrp : r ≠ p := by
    intro h
    subst h
    exact hpnd hrdvd
  have hr2 : r ≠ 2 := by omega
  exact hcent.trans (pRank_centOverO2_le_pRank_inf_centralizer hL.1.le hMN hp'.1 hp2 hr
    hr2 hrp hEL hEel.isPGroup)

theorem s17_47_cartan_cent
    {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ} {C Dc : Subgroup G} {Gamma : Set G}
    (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (hL3 : IsL3 (BarInf L) n) (h4 : 4 < 2 ^ n) (hLX : L = X)
    (hSg : CFSG.LocalAnalysis.UniquenessCase.UC6S846.SigmaStd D)
    (h638 : UC6.R6_38 D)
    (hK3 : Inputs1719.K_BorelTorusAbelianRankTwoNotL34)
    (hK4 : Inputs1719.K_CartanRankLeThree)
    (hK17 : Inputs1719.K_L3CartanThree)
    (hKAut3 : K_L3AutOThreeRank)
    (hT : CFSG.LocalAnalysis.RankThreeUC.S15.LieOddRankChev)
    {r : ℕ} (hr : r.Prime) (hr5 : 5 ≤ r) (hrdvd : r ∣ 2 ^ n - 1)
    {E : Subgroup G} (hEL : E ≤ L)
    (hEN : E ≤ Subgroup.normalizer ((D.T ⊓ L : Subgroup G) : Set G))
    (hEel : CFSG.Open.IsElemAbelian r E) :
    2 ≤ CFSG.Open.pRank p (D.M ⊓ Subgroup.centralizer (E : Set G)) := by
  classical
  have hp' := D.sig_prime p ctx.p_mem
  have hp2 : p ≠ 2 := hp'.2
  by_cases hp3 : p = 3
  · subst hp3
    by_cases h3dvd : 3 ∣ 2 ^ n - 1
    · exact s17_47_cartan_cent_caseC ctx hL3 hLX hK3 hK17 hSg h638 hKAut3 rfl hr hr5 hrdvd
        h3dvd hEL hEN hEel
    · exact s17_47_cartan_cent_caseB ctx hL3 hLX h4 hSg h638 hT hr hr5 hrdvd h3dvd hEL hEel
  · by_cases hpdvd : p ∣ 2 ^ n - 1
    · exact s17_47_cartan_cent_caseA ctx hL3 hLX hK3 hK4 hr hr5 hrdvd hp'.1 hp2 hp3 hpdvd
        hEL hEN hEel
    · exact s17_47_cartan_cent_caseB ctx hL3 hLX h4 hSg h638 hT hr hr5 hrdvd hpdvd hEL hEel

end CFSG.LocalAnalysis.UniquenessCase.PartTwo.S17
