namespace CFSG.LocalAnalysis.UniquenessCase.PartTwo.S17

open Subgroup CFSG.Open
open CFSG.LocalAnalysis.UniquenessCase.UC22 (IsL3)

theorem k_L34AutRank_holds :
    ∀ (K : Type) [Group K] [Finite K] [Finite (MulAut K)],
      CFSG.Open.IsQuasisimple K → IsL3 (K ⧸ Subgroup.center K) 2 →
        ∀ p : ℕ, p.Prime → 5 ≤ p → CFSG.pRank p (MulAut K) ≤ 1 := by
  intro K _ _ _ hq hL3 p hp hp5
  classical
  have : Group.IsPerfect K := Group.isPerfect_def.mpr hq.1
  have : Finite (MulAut (K ⧸ Subgroup.center K)) :=
    inferInstanceAs (Finite ((K ⧸ Subgroup.center K) ≃* (K ⧸ Subgroup.center K)))
  have hQ := CFSG.LocalAnalysis.UniquenessCase.PartOne.Section8.kL34Data_holds
    (K ⧸ Subgroup.center K) hL3
  have hnotbig : ¬ p ^ 2 ∣ 2 ^ 8 * 3 ^ 3 * 5 * 7 := by
    intro hsq
    have hpd : p ∣ 2 ^ 8 * (3 ^ 3 * (5 * 7)) :=
      (by norm_num : (241920 : ℕ) = 2 ^ 8 * (3 ^ 3 * (5 * 7))) ▸
        (dvd_pow_self p (by norm_num : 2 ≠ 0)).trans hsq
    rcases (Nat.Prime.dvd_mul hp).mp hpd with h1 | h1
    · have h2 := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp (hp.dvd_of_dvd_pow h1)
      omega
    rcases (Nat.Prime.dvd_mul hp).mp h1 with h2 | h2
    · have h3 := (Nat.prime_dvd_prime_iff_eq hp (by norm_num : Nat.Prime 3)).mp
        (hp.dvd_of_dvd_pow h2)
      omega
    rcases (Nat.Prime.dvd_mul hp).mp h2 with h3 | h3
    · have hp_eq : p = 5 :=
        (Nat.prime_dvd_prime_iff_eq hp (by norm_num : Nat.Prime 5)).mp h3
      rw [hp_eq] at hsq
      norm_num at hsq
    · have hp_eq : p = 7 :=
        (Nat.prime_dvd_prime_iff_eq hp (by norm_num : Nat.Prime 7)).mp h3
      rw [hp_eq] at hsq
      norm_num at hsq
  have hnotdvd : ¬ p ^ 2 ∣ Nat.card (MulAut (K ⧸ Subgroup.center K)) := by
    rw [hQ.2.1]
    exact hnotbig
  have hbound :=
    CFSG.LocalAnalysis.RankThreeTheoremC.TwelveRanksNotLe.pRank_top_le_of_not_dvd_card
      (G := MulAut (K ⧸ Subgroup.center K)) hp (k := 1) (by simpa using hnotdvd)
  have hle :=
    CFSG.HardMathSupport.Timmesfeld.Tables.Multiplier.pRank_mulAut_le (J := K) hp
  rw [CFSG.SectionRank.pRank_eq_open_pRank_top p (MulAut K)]
  exact hle.trans hbound

end CFSG.LocalAnalysis.UniquenessCase.PartTwo.S17
