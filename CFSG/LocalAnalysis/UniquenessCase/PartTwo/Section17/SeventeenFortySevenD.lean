theorem s17_47_sl34_two_le_pRank_cartan {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ}
    {C Dc : Subgroup G} {Gamma : Set G} (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (h34 : IsSL3 (Bar2 L) 2) (hZ : Nat.card (Subgroup.center (Bar2 L)) = 3)
    (hK17 : Inputs1719.K_L3CartanThree) :
    2 ≤ CFSG.Open.pRank 3 C := by
  classical
  have hL : L ∈ calC D.M := ctx.mem_calC
  have hq : CFSG.Open.IsQuasisimple (Bar2 L) := hL.2.2
  have hodd : Odd (Nat.card (Subgroup.center (Bar2 L))) := uc22p22l_odd_center_quotient
  let Smap : Subgroup (Bar2 L) :=
    ((D.T ⊓ L).subgroupOf L).map (QuotientGroup.mk' (CFSG.pCore 2 ↥L))
  have hS : IsSylowTwoOf Smap ⊤ := isSylowTwoOf_sylowBar2 hL
  have happ := hK17 (Bar2 L) 2 h34.2.admissible ⟨1, rfl⟩ h34.2 hq hodd Smap hS
  have hO2 : CFSG.pCore 2 ↥L ≤ (D.T ⊓ L).subgroupOf L := pCore_le_sylow_of_mem_calC hL
  have htrans : CFSG.Open.pRank 3 (⊤ : Subgroup
        (TauCeti.Subgroup.normalizerQuotient ((D.T ⊓ L).subgroupOf L))) =
      CFSG.Open.pRank 3 (⊤ : Subgroup
        (TauCeti.Subgroup.normalizerQuotient Smap)) :=
    CFSG.SectionRank.pRank_top_eq_of_mulEquiv (by norm_num : 1 < 3)
      (CFSG.GroupTheory.normalizerQuotient_quotientEquiv (CFSG.pCore 2 ↥L)
        ((D.T ⊓ L).subgroupOf L) hO2)
  have hcoeeq : CFSG.pRank 3 ↥(⊤ : Subgroup (TauCeti.Subgroup.normalizerQuotient Smap)) =
      CFSG.Open.pRank 3 (⊤ : Subgroup (TauCeti.Subgroup.normalizerQuotient Smap)) :=
    (CFSG.SectionRank.pRank_eq_open_pRank_top 3 _).trans
      (CFSG.SectionRank.pRank_eq_pRank_top_subgroup _).symm
  have hbridge := pRank_normalizerQuotient_le_pRank_cartan hL ctx.cartan
    Nat.prime_three (by norm_num)
  have hif : (if 3 ∣ Nat.card (Subgroup.center (Bar2 L)) then 2 else 1) = 2 := by
    rw [hZ]; norm_num
  have htwo : 2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup
      (TauCeti.Subgroup.normalizerQuotient ((D.T ⊓ L).subgroupOf L))) := by
    rw [htrans]
    calc 2 = (if 3 ∣ Nat.card (Subgroup.center (Bar2 L)) then 2 else 1) := hif.symm
      _ ≤ CFSG.pRank 3 ↥(⊤ : Subgroup (TauCeti.Subgroup.normalizerQuotient Smap)) := happ
      _ = CFSG.Open.pRank 3 (⊤ : Subgroup (TauCeti.Subgroup.normalizerQuotient Smap)) :=
          hcoeeq
  exact htwo.trans hbridge

theorem s17_47_sl34_five_le_p {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ}
    {C Dc : Subgroup G} {Gamma : Set G} (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (hp : p ∈ D.sig) (h34 : IsSL3 (Bar2 L) 2)
    (hZ : Nat.card (Subgroup.center (Bar2 L)) = 3)
    (hSg : CFSG.LocalAnalysis.UniquenessCase.UC6S846.SigmaStd D)
    (h1 : R17_1At D V₀ V ctx.hyp125)
    (hK3 : Inputs1719.K_BorelTorusAbelianRankTwo)
    (hK17 : Inputs1719.K_L3CartanThree) :
    5 ≤ p := by
  classical
  by_contra hcon
  push Not at hcon
  have hp' := D.sig_prime p hp
  have hp3 : p = 3 := by
    have h2 : 2 ≤ p := hp'.1.two_le
    interval_cases p
    · exact absurd rfl hp'.2
    · rfl
    · exact absurd hp'.1 (by norm_num)
  have hns : ¬ Group.IsSolvable ↥D.M :=
    CFSG.LocalAnalysis.UniquenessCase.UC6S846.not_solvable_of_mem_calC ctx.mem_calC
  have hsp3 : CFSG.RankThree.PartOne.IsStronglyPEmbedded 3 D.M := by
    rw [← hp3]
    exact hSg.sig1_sp p (CFSG.LocalAnalysis.UniquenessCase.UC6S846.sig_subset_sig1 hSg hns hp)
  have hk : D.k = 1 := by
    show CFSG.LocalAnalysis.RankThreeUC.kParam D.M = 1
    rw [CFSG.LocalAnalysis.RankThreeUC.kParam, if_pos hsp3]
  obtain ⟨e⟩ := uc22p21k_barInf_equiv_of_calC ctx.mem_calC
  have hDc1 : CFSG.Open.pRank 3 Dc ≤ 1 :=
    pRank_three_Dc_le_one_of_k_one_of_borel ctx
      (Inputs1719.BorelChevOver.of_on hK3
        (CFSG.Blueprint.LieModel.of_mulEquiv e.symm h34.2) (by decide)) h1 hk
  have hC2 : 2 ≤ CFSG.Open.pRank 3 C :=
    s17_47_sl34_two_le_pRank_cartan ctx h34 hZ hK17
  have hDc2 : 2 ≤ CFSG.Open.pRank 3 Dc :=
    hC2.trans (pRank_cartan_le_pRank_Dc (ctx := ctx) Nat.prime_three)
  omega

theorem s17_47_sl34_pRank_cent {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ}
    {C Dc : Subgroup G} {Gamma : Set G} (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (hp : p ∈ D.sig) (hp5 : 5 ≤ p) (hLX : L = X) (h34 : IsSL3 (Bar2 L) 2)
    (hSg : CFSG.LocalAnalysis.UniquenessCase.UC6S846.SigmaStd D) :
    2 ≤ CFSG.Open.pRank p (F08.CentOverO2 D.M L) := by
  classical
  have : Finite (MulAut (Bar2 L)) := inferInstanceAs (Finite ((Bar2 L) ≃* (Bar2 L)))
  have hp' := D.sig_prime p hp
  have hp1 : 1 < p := hp'.1.one_lt
  have hMN : D.M ≤ Subgroup.normalizer (L : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer ctx.mem_calC.1.le).mp
      (uc22p21j_normal_of_conjClosure_eq ctx.mem_calC.1.le (hLX.trans ctx.X_eq))
  let ρ : ↥D.M →* MulAut (Bar2 L) := (rhoL L).comp (Subgroup.inclusion hMN)
  have hmap := CFSG.AGLEmbedding.pRank_le_pRank_inf_ker_add_pRank_map
    (G := ↥D.M) (H := MulAut (Bar2 L)) hp'.1 ρ ⊤
  have htop : CFSG.Open.pRank p (⊤ : Subgroup ↥D.M) = CFSG.Open.pRank p D.M :=
    (CFSG.SectionRank.pRank_eq_pRank_top_subgroup D.M).symm
  have hkerEq : ρ.ker.map D.M.subtype = F08.CentOverO2 D.M L :=
    (centOverO2_eq_ker_map hMN).symm
  have hker : CFSG.Open.pRank p (⊤ ⊓ ρ.ker) ≤
      CFSG.Open.pRank p (F08.CentOverO2 D.M L) := by
    calc CFSG.Open.pRank p (⊤ ⊓ ρ.ker) = CFSG.Open.pRank p ρ.ker := by rw [top_inf_eq]
      _ ≤ CFSG.Open.pRank p (ρ.ker.map D.M.subtype) :=
          CFSG.SectionRank.pRank_le_map hp1 D.M.subtype D.M.subtype_injective ρ.ker
      _ = CFSG.Open.pRank p (F08.CentOverO2 D.M L) := by rw [hkerEq]
  have himg : CFSG.Open.pRank p ((⊤ : Subgroup ↥D.M).map ρ) ≤ 1 := by
    have hle : CFSG.Open.pRank p ((⊤ : Subgroup ↥D.M).map ρ) ≤
        CFSG.Open.pRank p (⊤ : Subgroup (MulAut (Bar2 L))) :=
      CFSG.SectionRank.pRank_mono hp1 le_top
    have hK := k_L34AutRank_holds (Bar2 L) ctx.mem_calC.2.2 h34.2 p hp'.1 hp5
    rw [CFSG.SectionRank.pRank_eq_open_pRank_top] at hK
    omega
  have hmain : CFSG.Open.pRank p D.M ≤ CFSG.Open.pRank p (F08.CentOverO2 D.M L) + 1 := by
    calc CFSG.Open.pRank p D.M = CFSG.Open.pRank p (⊤ : Subgroup ↥D.M) := htop.symm
      _ ≤ CFSG.Open.pRank p (⊤ ⊓ ρ.ker) + CFSG.Open.pRank p ((⊤ : Subgroup ↥D.M).map ρ) :=
          hmap
      _ ≤ CFSG.Open.pRank p (F08.CentOverO2 D.M L) + 1 := add_le_add hker himg
  have h3 : 3 ≤ CFSG.Open.pRank p D.M := hSg.three_le p hp
  omega

theorem s17_47_sl34_exists_inP11 {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ}
    {C Dc : Subgroup G} {Gamma : Set G} (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (hp : p ∈ D.sig) (hLX : L = X) (h34 : IsSL3 (Bar2 L) 2)
    (hZ : Nat.card (Subgroup.center (Bar2 L)) = 3)
    (hSg : CFSG.LocalAnalysis.UniquenessCase.UC6S846.SigmaStd D)
    (h76 : F07.R76 D)
    (h1 : R17_1At D V₀ V ctx.hyp125)
    (hK3 : Inputs1719.K_BorelTorusAbelianRankTwo)
    (hK17 : Inputs1719.K_L3CartanThree) :
    ∃ E : Subgroup G, E ≤ L ∧ E ≤ Subgroup.normalizer ((D.T ⊓ L : Subgroup G) : Set G) ∧
      CFSG.Open.IsElemAbelian 3 E ∧ 2 ≤ CFSG.Open.pRank 3 E ∧ Permutes E D.T ∧
        F11.InP11 D E := by
  classical
  have hL : L ∈ calC D.M := ctx.mem_calC
  have hp' := D.sig_prime p hp
  have : Fact p.Prime := ⟨hp'.1⟩
  have hp2 : p ≠ 2 := hp'.2
  have hns : ¬ Group.IsSolvable ↥D.M :=
    CFSG.LocalAnalysis.UniquenessCase.UC6S846.not_solvable_of_mem_calC hL
  have hsp : CFSG.RankThree.PartOne.IsStronglyPEmbedded p D.M :=
    hSg.sig1_sp p (CFSG.LocalAnalysis.UniquenessCase.UC6S846.sig_subset_sig1 hSg hns hp)
  have h76' : Conclusion76 D.M p :=
    h76 p hp'.1 hp2 hsp
  have hp5 : 5 ≤ p := s17_47_sl34_five_le_p ctx hp h34 hZ hSg h1 hK3 hK17
  have hMN : D.M ≤ Subgroup.normalizer (L : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hL.1.le).mp
      (uc22p21j_normal_of_conjClosure_eq hL.1.le (hLX.trans ctx.X_eq))
  have hC2 : 2 ≤ CFSG.Open.pRank 3 C := s17_47_sl34_two_le_pRank_cartan ctx h34 hZ hK17
  have hL3 : 2 ≤ CFSG.Open.pRank 3 L :=
    hC2.trans (CFSG.SectionRank.pRank_mono (by norm_num : 1 < 3) ctx.cartan.1)
  have hbr : 2 ≤ CFSG.Open.pRank p (F08.CentOverO2 D.M L) :=
    s17_47_sl34_pRank_cent ctx hp hp5 hLX h34 hSg
  obtain ⟨e⟩ := uc22p21k_barInf_equiv_of_calC ctx.mem_calC
  have hB : Inputs1719.BorelChevOver (BarInf L) 2 :=
    Inputs1719.BorelChevOver.of_on hK3
      (CFSG.Blueprint.LieModel.of_mulEquiv e.symm h34.2) (by decide)
  obtain ⟨E, hEX, hEel, hEperm, hEC⟩ :=
    ctx.exists_permuting_elemAbelian_le_of_borel hB Nat.prime_three (by norm_num)
  have hEL : E ≤ L := hLX.symm ▸ hEX.trans inf_le_left
  have hEN : E ≤ Subgroup.normalizer ((D.T ⊓ L : Subgroup G) : Set G) := by
    rw [hLX]; exact hEX.trans inf_le_right
  have hEM : E ≤ D.M := hEL.trans hL.1.le
  have hE3 : 2 ≤ CFSG.Open.pRank 3 E := hC2.trans hEC
  have hEp : IsPGroup 3 ↥E := hEel.isPGroup
  have hEnc : ¬ IsCyclic ↥E := by
    intro hc
    have hle1 : CFSG.Open.pRank 3 E ≤ 1 :=
      CFSG.SectionRank.pRank_le_one_of_isCyclic Nat.prime_three hc
    omega
  have hF : 2 ≤ CFSG.Open.pRank p (D.M ⊓ Subgroup.centralizer (E : Set G)) :=
    hbr.trans (pRank_centOverO2_le_pRank_inf_centralizer hL.1.le hMN hp'.1 hp2
      Nat.prime_three (by norm_num) (by omega) hEL hEp)
  have hΓE : CFSG.Open.rankThreeGamma 1 3 E ≤ D.M :=
    rankThreeGamma_le_of_two_le_pRank_inf_centralizer hsp h76' hEM hEp hE3 hF
  obtain ⟨P, hP⟩ := CFSG.ABGLocalTools.exists_isSylowOf 3 D.M
  have hPL : P ≤ D.M := hP.le
  have hY : CFSG.ABGLocalTools.IsSylowOf 3 (P ⊓ L) L :=
    hP.inf_of_le_normalizer hL.1.le hMN
  have hY3 : IsPGroup 3 ↥(P ⊓ L) := (CFSG.ABGLocalTools.isSylowOf_iff.mp hY).2.1
  have hYrank : 2 ≤ CFSG.Open.pRank 3 (P ⊓ L) := by
    rw [CFSG.LocalAnalysis.RankThreeTheoremC.RankOneCent.pRank_eq_of_isSylowOf hY]
    exact hL3
  have hYnc : ¬ IsCyclic ↥(P ⊓ L) := by
    intro hc
    have hle1 : CFSG.Open.pRank 3 (P ⊓ L) ≤ 1 :=
      CFSG.SectionRank.pRank_le_one_of_isCyclic Nat.prime_three hc
    omega
  have hYLE : P ⊓ L ≤ L := inf_le_right
  have hPY : P ≤ Subgroup.normalizer ((P ⊓ L : Subgroup G) : Set G) := by
    intro x hx
    exact Subgroup.inf_normalizer_le_normalizer_inf (H := P) (K := L)
      ⟨Subgroup.le_normalizer hx, hMN (hPL hx)⟩
  have hFY : 2 ≤ CFSG.Open.pRank p
      (D.M ⊓ Subgroup.centralizer ((P ⊓ L : Subgroup G) : Set G)) :=
    hbr.trans (pRank_centOverO2_le_pRank_inf_centralizer hL.1.le hMN hp'.1 hp2
      Nat.prime_three (by norm_num) (by omega) hYLE hY3)
  have hΓY : CFSG.Open.rankThreeGamma 1 3 (P ⊓ L) ≤ D.M :=
    rankThreeGamma_le_of_two_le_pRank_inf_centralizer hsp h76'
      (inf_le_left.trans hPL) hY3 hYrank hFY
  exact ⟨E, hEL, hEN, hEel, hE3, hEperm, 3, Nat.prime_three, by norm_num, hEM, hEp,
    fun x hx => hEel.2 x hx, hEnc, hEperm,
    hΓE, Or.inr ⟨P ⊓ L, hYnc, ⟨P, hP, inf_le_left, hPY⟩, hΓY⟩⟩

