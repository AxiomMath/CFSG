variable {G : Type} [Group G] [Finite G]

@[expose] noncomputable def preDelta (L : Subgroup G) (A : Subgroup (Bar2 L)) : Subgroup G :=
  (A.comap (S18.piBar2 L)).map L.subtype

@[expose] noncomputable def perfDelta (L : Subgroup G) (A : Subgroup (Bar2 L)) : Subgroup G :=
  (CFSG.perfectResidual ↥(preDelta L A)).map (preDelta L A).subtype

@[expose] noncomputable def memberDelta (D : Data G) (L : Subgroup G)
    (A : Subgroup (Bar2 L)) : Subgroup G :=
  perfDelta L A ⊔ D.T

theorem preDelta_le (L : Subgroup G) (A : Subgroup (Bar2 L)) : preDelta L A ≤ L :=
  Subgroup.map_subtype_le _

theorem perfDelta_le_pre (L : Subgroup G) (A : Subgroup (Bar2 L)) :
    perfDelta L A ≤ preDelta L A := by
  intro x hx
  obtain ⟨y, -, rfl⟩ := Subgroup.mem_map.mp hx
  exact y.2

theorem perfDelta_le (L : Subgroup G) (A : Subgroup (Bar2 L)) : perfDelta L A ≤ L :=
  (perfDelta_le_pre L A).trans (preDelta_le L A)

theorem le_member (D : Data G) (L : Subgroup G) (A : Subgroup (Bar2 L)) :
    D.T ≤ memberDelta D L A := le_sup_right

theorem member_le_M (D : Data G) {L : Subgroup G} (hLM : L ≤ D.M)
    (A : Subgroup (Bar2 L)) : memberDelta D L A ≤ D.M :=
  sup_le ((perfDelta_le L A).trans hLM) D.sylowM.le

@[expose] noncomputable def preDeltaMap (L : Subgroup G) (A : Subgroup (Bar2 L)) :
    ↥(preDelta L A) →* Bar2 L :=
  (S18.piBar2 L).comp (Subgroup.inclusion (preDelta_le L A))

theorem preDeltaMap_apply (L : Subgroup G) (A : Subgroup (Bar2 L))
    (x : ↥(preDelta L A)) :
    preDeltaMap L A x = S18.piBar2 L ⟨(x : G), preDelta_le L A x.2⟩ := rfl

theorem preDeltaMap_range (L : Subgroup G) (A : Subgroup (Bar2 L)) :
    (preDeltaMap L A).range = A := by
  ext a
  constructor
  · rintro ⟨x, rfl⟩
    have hx : (x : G) ∈ (A.comap (S18.piBar2 L)).map L.subtype := x.2
    obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
    have hy' : (y : G) = (x : G) := hyx
    have hq : S18.piBar2 L y ∈ A := hy
    have hxy : (⟨(x : G), preDelta_le L A x.2⟩ : ↥L) = y := Subtype.ext hy'.symm
    rw [preDeltaMap_apply, hxy]
    exact hq
  · intro ha
    obtain ⟨y, hyq⟩ := QuotientGroup.mk'_surjective (CFSG.pCore 2 ↥L) a
    have hyP : (y : G) ∈ preDelta L A := by
      refine Subgroup.mem_map.mpr ⟨y, ?_, rfl⟩
      rw [Subgroup.mem_comap, hyq]
      exact ha
    refine ⟨⟨(y : G), hyP⟩, ?_⟩
    rw [preDeltaMap_apply, ← hyq]

theorem preDelta_contains_pCore (L : Subgroup G) (A : Subgroup (Bar2 L)) :
    (CFSG.pCore 2 ↥L).map L.subtype ≤ preDelta L A := by
  intro x hx
  obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hx
  refine Subgroup.mem_map.mpr ⟨y, ?_, rfl⟩
  change S18.piBar2 L y ∈ A
  rw [show S18.piBar2 L y = 1 from ?_]
  · exact A.one_mem
  · change (QuotientGroup.mk y : Bar2 L) = 1
    rw [QuotientGroup.eq_one_iff]
    exact hy

theorem perfDeltaMap_eq (L : Subgroup G) (A : Subgroup (Bar2 L)) (hAlt : IsAlt ↥A 5) :
    (CFSG.perfectResidual ↥(preDelta L A)).map (preDeltaMap L A) = A := by
  have h := (CFSG.perfect_residual_transport (preDeltaMap L A)).1
  rw [preDeltaMap_range] at h
  have hperfA : Group.IsPerfect ↥A := by
    obtain ⟨e⟩ := hAlt
    have : Group.IsPerfect ↥(alternatingGroup (Fin 5)) :=
      ⟨CFSG.GroupTheory.AlternatingFive.commutator_eq_top⟩
    exact Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  have : Group.IsPerfect ↥A := hperfA
  have hperfTop : Group.IsPerfect ↥(⊤ : Subgroup ↥A) :=
    Group.IsPerfect.ofSurjective
      (f := (Subgroup.topEquiv (G := ↥A)).symm.toMonoidHom)
      (Subgroup.topEquiv (G := ↥A)).symm.surjective
  have hperfRes : CFSG.perfectResidual ↥A = ⊤ :=
    top_le_iff.mp ((CFSG.perfect_residual_transport (MonoidHom.id ↥A)).2.2 ⊤ hperfTop)
  rw [h, hperfRes, Subgroup.map_top, Subgroup.range_subtype]

theorem preDeltaMap_ker (L : Subgroup G) (A : Subgroup (Bar2 L)) :
    (preDeltaMap L A).ker =
      (CFSG.pCore 2 ↥L).comap (Subgroup.inclusion (preDelta_le L A)) := by
  ext x
  rw [MonoidHom.mem_ker, Subgroup.mem_comap]
  constructor
  · intro hx
    have hx' : (QuotientGroup.mk (Subgroup.inclusion (preDelta_le L A) x) : Bar2 L) = 1 := by
      rw [preDeltaMap_apply] at hx
      exact hx
    exact (QuotientGroup.eq_one_iff _).mp hx'
  · intro hx
    rw [preDeltaMap_apply]
    exact (QuotientGroup.eq_one_iff _).mpr hx

theorem perfDelta_bar2_alt (L : Subgroup G) (A : Subgroup (Bar2 L)) (hAlt : IsAlt ↥A 5) :
    IsAlt (Bar2 (perfDelta L A)) 5 := by
  classical
  let P := preDelta L A
  let Q := perfDelta L A
  let f := preDeltaMap L A
  let g : ↥Q →* Bar2 L := f.comp (Subgroup.inclusion (perfDelta_le_pre L A))
  obtain ⟨eA⟩ := hAlt
  have : IsSimpleGroup ↥(alternatingGroup (Fin 5)) :=
    alternatingGroup.isSimpleGroup (by norm_num)
  have hsimpleA : IsSimpleGroup ↥A := eA.isSimpleGroup
  have hcard : Nat.card ↥A = 60 := by
    rw [Nat.card_congr eA.toEquiv, nat_card_alternatingGroup, Nat.card_fin]
    norm_num
  have hg_range : g.range = A := by
    ext a
    constructor
    · rintro ⟨x, rfl⟩
      have hmem : f (Subgroup.inclusion (perfDelta_le_pre L A) x) ∈ f.range :=
        ⟨Subgroup.inclusion (perfDelta_le_pre L A) x, rfl⟩
      rwa [preDeltaMap_range] at hmem
    · intro ha
      have hmem : a ∈ (CFSG.perfectResidual ↥P).map f := by
        rw [perfDeltaMap_eq L A ⟨eA⟩]
        exact ha
      obtain ⟨y, hy, hyf⟩ := Subgroup.mem_map.mp hmem
      have hyP : (P.subtype y : G) ∈ Q :=
        Subgroup.mem_map.mpr ⟨y, hy, rfl⟩
      refine ⟨⟨(P.subtype y : G), hyP⟩, ?_⟩
      exact hyf
  have hker_ambient : ∀ x : ↥Q, x ∈ g.ker → (x : G) ∈ CFSG.Open.pCoreOf 2 Q := by
    intro x hx
    have hfx : Subgroup.inclusion (perfDelta_le_pre L A) x ∈ f.ker := hx
    have hxcore : Subgroup.inclusion (perfDelta_le_pre L A) x ∈
        (CFSG.pCore 2 ↥L).comap (Subgroup.inclusion (preDelta_le L A)) := by
      rwa [← preDeltaMap_ker L A]
    have hxL : (x : G) ∈ CFSG.Open.pCoreOf 2 L := by
      rw [CFSG.Open.pCoreOf, Subgroup.mem_map]
      exact ⟨_, Subgroup.mem_comap.mp hxcore, rfl⟩
    have hNnorm : ((CFSG.Open.pCoreOf 2 L).subgroupOf L).Normal := by
      rw [CFSG.openPCoreOf_subgroupOf]
      exact CFSG.pCore_normal
    have hconj := (Subgroup.normal_subgroupOf_iff
      (CFSG.LieType.BorelTits.pCoreOf_le (r := 2) L)).mp hNnorm
    have hQnorm : (((CFSG.Open.pCoreOf 2 L) ⊓ Q).subgroupOf Q).Normal := by
      rw [Subgroup.normal_subgroupOf_iff inf_le_right]
      intro h k hh hk
      exact Subgroup.mem_inf.mpr ⟨hconj h k hh.1 (perfDelta_le L A hk),
        Q.mul_mem (Q.mul_mem hk hh.2) (Q.inv_mem hk)⟩
    refine (CFSG.LieType.BorelTits.le_pCoreOf (r := 2)
      (N := (CFSG.Open.pCoreOf 2 L) ⊓ Q) (H := Q) inf_le_right hQnorm ?_)
      (Subgroup.mem_inf.mpr ⟨hxL, x.2⟩)
    exact (CFSG.LieType.BorelTits.pCoreOf_isPGroup (r := 2) L).to_le inf_le_left
  have hker : g.ker = CFSG.pCore 2 ↥Q := by
    refine le_antisymm ?_ ?_
    · intro x hx
      have hxamb := hker_ambient x hx
      rw [← CFSG.openPCoreOf_subgroupOf]
      exact Subgroup.mem_subgroupOf.mpr hxamb
    · intro x hx
      have hxamb : (x : G) ∈ CFSG.Open.pCoreOf 2 Q := by
        have hxsub : x ∈ (CFSG.Open.pCoreOf 2 Q).subgroupOf Q := by
          rwa [CFSG.openPCoreOf_subgroupOf]
        exact Subgroup.mem_subgroupOf.mp hxsub
      have himg : (CFSG.pCore 2 ↥Q).map g.rangeRestrict = ⊥ := by
        have hnorm : ((CFSG.pCore 2 ↥Q).map g.rangeRestrict).Normal :=
          (CFSG.pCore_normal (p := 2) (G := ↥Q)).map g.rangeRestrict
            (MonoidHom.rangeRestrict_surjective g)
        have h2 : IsPGroup 2 ↥((CFSG.pCore 2 ↥Q).map g.rangeRestrict) :=
          (CFSG.pCore_isPGroup (p := 2) (G := ↥Q)).map g.rangeRestrict
        have : ((CFSG.pCore 2 ↥Q).map g.rangeRestrict).Normal := hnorm
        have : IsSimpleGroup ↥g.range := hg_range.symm ▸ hsimpleA
        rcases Subgroup.Normal.eq_bot_or_eq_top
          ((CFSG.pCore 2 ↥Q).map g.rangeRestrict) with h | h
        · exact h
        · exfalso
          rw [h] at h2
          have h2top : IsPGroup 2 ↥g.range :=
            IsPGroup.of_equiv h2 (Subgroup.topEquiv (G := ↥g.range))
          obtain ⟨n, hn⟩ := h2top.exists_card_eq
          rw [hg_range, hcard] at hn
          have hdvd : 2 ^ n ∣ 60 := hn ▸ dvd_rfl
          have hle : 2 ^ n ≤ 60 := Nat.le_of_dvd (by norm_num) hdvd
          have hn5 : n ≤ 5 := by
            by_contra h6
            have h64 : 2 ^ 6 ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) (by omega)
            omega
          interval_cases n <;> norm_num at hn
      have hxker : g x = 1 := by
        have hmem : (⟨g x, ⟨x, rfl⟩⟩ : ↥g.range) ∈
            (CFSG.pCore 2 ↥Q).map g.rangeRestrict :=
          Subgroup.mem_map.mpr ⟨x, hx, rfl⟩
        rw [himg, Subgroup.mem_bot] at hmem
        exact congrArg Subtype.val hmem
      exact MonoidHom.mem_ker.mpr hxker
  let eQ : Bar2 Q ≃* ↥A :=
    (QuotientGroup.quotientMulEquivOfEq hker.symm).trans
      ((QuotientGroup.quotientKerEquivRange g).trans (MulEquiv.subgroupCongr hg_range))
  exact ⟨eQ.trans eA⟩


theorem mem_preDelta_iff {L : Subgroup G} {A : Subgroup (Bar2 L)} {x : G} (hxL : x ∈ L) :
    x ∈ preDelta L A ↔ S18.piBar2 L ⟨x, hxL⟩ ∈ A := by
  constructor
  · intro hx
    obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
    have hxy : (⟨x, hxL⟩ : ↥L) = y := Subtype.ext hyx.symm
    rw [hxy]
    exact hy
  · intro hx
    exact Subgroup.mem_map.mpr ⟨⟨x, hxL⟩, hx, rfl⟩

theorem preDelta_conj_eq (L M : Subgroup G) (hM : M ≤ Subgroup.normalizer (L : Set G))
    (A : Subgroup (Bar2 L))
    (hA : ∀ m : ↥M, A.map (CFSG.GroupTheory.conjModPCore 2 L M hM m).toMonoidHom = A)
    (m : ↥M) :
    (preDelta L A).map (MulAut.conj (m : G)).toMonoidHom = preDelta L A := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    have hyL : (y : G) ∈ L := preDelta_le L A hy
    have hxL : (m : G) * (y : G) * (m : G)⁻¹ ∈ L := by
      have := (Subgroup.mem_normalizer_iff.mp (hM m.2) (y : G)).mp hyL
      simpa using this
    have hqy : S18.piBar2 L ⟨(y : G), hyL⟩ ∈ A := (mem_preDelta_iff hyL).mp hy
    have hconjq : (CFSG.GroupTheory.conjModPCore 2 L M hM m) (S18.piBar2 L ⟨(y : G), hyL⟩) =
        S18.piBar2 L ⟨(m : G) * (y : G) * (m : G)⁻¹, hxL⟩ := by
      change (CFSG.GroupTheory.conjModPCore 2 L M hM m)
        (QuotientGroup.mk (s := CFSG.pCore 2 ↥L) (⟨(y : G), hyL⟩ : ↥L)) = _
      rw [CFSG.GroupTheory.conjModPCore_mk]
      rfl
    change (m : G) * (y : G) * (m : G)⁻¹ ∈ preDelta L A
    rw [mem_preDelta_iff hxL, ← hconjq, ← hA m]
    exact Subgroup.mem_map.mpr ⟨_, hqy, rfl⟩
  · intro hx
    have hxL : x ∈ L := preDelta_le L A hx
    have hq : S18.piBar2 L ⟨x, hxL⟩ ∈ A := (mem_preDelta_iff hxL).mp hx
    set y : G := (m : G)⁻¹ * x * (m : G) with hydef
    have hyL : y ∈ L := by
      have := (Subgroup.mem_normalizer_iff.mp (hM (M.inv_mem m.2)) x).mp hxL
      simpa [hydef] using this
    have hqy : S18.piBar2 L ⟨y, hyL⟩ ∈ A := by
      have hconjq : (CFSG.GroupTheory.conjModPCore 2 L M hM (m⁻¹))
          (S18.piBar2 L ⟨x, hxL⟩) = S18.piBar2 L ⟨y, hyL⟩ := by
        change (CFSG.GroupTheory.conjModPCore 2 L M hM (m⁻¹))
          (QuotientGroup.mk (s := CFSG.pCore 2 ↥L) (⟨x, hxL⟩ : ↥L)) = _
        rw [CFSG.GroupTheory.conjModPCore_mk]
        congr 1
        exact Subtype.ext (by simp [hydef, mul_assoc])
      rw [← hconjq, ← hA (m⁻¹)]
      exact Subgroup.mem_map.mpr ⟨S18.piBar2 L ⟨x, hxL⟩, hq, rfl⟩
    have hyP : y ∈ preDelta L A := (mem_preDelta_iff hyL).mpr hqy
    refine Subgroup.mem_map.mpr ⟨y, hyP, ?_⟩
    change (m : G) * y * (m : G)⁻¹ = x
    rw [hydef]
    group


theorem pCore_le_sylow_of_le_normalizer (D : Data G) {L : Subgroup G} (hLM : L ≤ D.M)
    (hT : D.T ≤ Subgroup.normalizer (L : Set G)) :
    CFSG.Open.pCoreOf 2 L ≤ D.T := by
  have hTM : IsSylowIn 2 D.T D.M := TwelveShort.isSylowIn_of_le D D.sylowM.le
  have hO2M : CFSG.Open.pCoreOf 2 L ≤ D.M :=
    (CFSG.LieType.BorelTits.pCoreOf_le 2 L).trans hLM
  have hO2T : D.T ≤ Subgroup.normalizer (CFSG.Open.pCoreOf 2 L : Set G) :=
    hT.trans (CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf 2 L)
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h2 : IsPGroup 2 ↥(CFSG.Open.pCoreOf 2 L ⊔ D.T) :=
    (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 L).to_sup_of_normal_left'
      D.sylowM.isPGroup hO2T
  have hle : CFSG.Open.pCoreOf 2 L ⊔ D.T ≤ D.M := sup_le hO2M D.sylowM.le
  obtain ⟨S, hS, hSle⟩ := CFSG.Quasithin.exists_isSylowIn_ge 2 hle h2
  have hTS : D.T ≤ S := le_sup_right.trans hSle
  have heq : D.T = S := by
    apply Subgroup.eq_of_le_of_card_ge hTS
    rw [hTM.card_eq, hS.card_eq]
  have hsupT : CFSG.Open.pCoreOf 2 L ⊔ D.T ≤ D.T := heq ▸ hSle
  exact le_sup_left.trans hsupT

@[expose] noncomputable def perfDeltaMap (L : Subgroup G) (A : Subgroup (Bar2 L)) :
    ↥(perfDelta L A) →* Bar2 L :=
  (S18.piBar2 L).comp (Subgroup.inclusion (perfDelta_le L A))

theorem perfDeltaMap_eq_comp (L : Subgroup G) (A : Subgroup (Bar2 L)) :
    perfDeltaMap L A =
      (preDeltaMap L A).comp (Subgroup.inclusion (perfDelta_le_pre L A)) := by
  ext x
  rfl

theorem perfDeltaMap_range (L : Subgroup G) (A : Subgroup (Bar2 L)) (hAlt : IsAlt ↥A 5) :
    (perfDeltaMap L A).range = A := by
  rw [perfDeltaMap_eq_comp]
  ext a
  constructor
  · rintro ⟨x, rfl⟩
    have hxP : (x : G) ∈ preDelta L A := perfDelta_le_pre L A x.2
    obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp x.2
    change (preDeltaMap L A) ⟨(x : G), hxP⟩ ∈ A
    have hxy : (⟨(x : G), hxP⟩ : ↥(preDelta L A)) = ⟨(y : G), y.2⟩ :=
      Subtype.ext hyx.symm
    rw [hxy]
    have hmem : (preDeltaMap L A) ⟨(y : G), y.2⟩ ∈
        (CFSG.perfectResidual ↥(preDelta L A)).map (preDeltaMap L A) :=
      Subgroup.mem_map.mpr ⟨⟨(y : G), y.2⟩, hy, rfl⟩
    rwa [perfDeltaMap_eq L A hAlt] at hmem
  · intro ha
    have hmem : a ∈ (CFSG.perfectResidual ↥(preDelta L A)).map (preDeltaMap L A) := by
      rw [perfDeltaMap_eq L A hAlt]
      exact ha
    obtain ⟨y, hy, hyf⟩ := Subgroup.mem_map.mp hmem
    have hyP : ((preDelta L A).subtype y : G) ∈ perfDelta L A :=
      Subgroup.mem_map.mpr ⟨y, hy, rfl⟩
    exact ⟨⟨((preDelta L A).subtype y : G), hyP⟩, hyf⟩

theorem perfDelta_subgroupOf_iSup (L : Subgroup G) {ι : Type*} (Δ : Finset ι)
    (A : ι → Subgroup (Bar2 L)) :
    (⨆ i ∈ Δ, perfDelta L (A i)).subgroupOf L =
      ⨆ i ∈ Δ, (perfDelta L (A i)).subgroupOf L := by
  rw [show (⨆ i ∈ Δ, perfDelta L (A i)) =
      ⨆ i, ⨆ (_ : i ∈ Δ), perfDelta L (A i) from rfl]
  rw [CFSG.subgroupOf_iSup (fun i => ⨆ (_ : i ∈ Δ), perfDelta L (A i))
    (fun i => iSup_le fun _ => perfDelta_le L (A i))]
  rw [show (⨆ i, (⨆ (_ : i ∈ Δ), perfDelta L (A i)).subgroupOf L) =
      ⨆ i, ⨆ (_ : i ∈ Δ), (perfDelta L (A i)).subgroupOf L from by
    apply iSup_congr; intro i
    exact CFSG.subgroupOf_iSup (fun _ : i ∈ Δ => perfDelta L (A i))
      (fun _ => perfDelta_le L (A i))]

theorem perfDelta_subgroupOf_map (L : Subgroup G) (A : Subgroup (Bar2 L)) (hAlt : IsAlt ↥A 5) :
    ((perfDelta L A).subgroupOf L).map (S18.piBar2 L) = A := by
  ext a
  constructor
  · rintro ⟨x, hx, rfl⟩
    have hxQ : (x : G) ∈ perfDelta L A := hx
    have hmem : S18.piBar2 L x = (perfDeltaMap L A) ⟨(x : G), hxQ⟩ := by
      change (QuotientGroup.mk x : Bar2 L) = _
      rfl
    have hrange : S18.piBar2 L x ∈ (perfDeltaMap L A).range := ⟨⟨(x : G), hxQ⟩, hmem.symm⟩
    rwa [perfDeltaMap_range L A hAlt] at hrange
  · intro ha
    have hmem : a ∈ (perfDeltaMap L A).range := by
      rw [perfDeltaMap_range L A hAlt]; exact ha
    obtain ⟨q, hq⟩ := hmem
    refine ⟨⟨(q : G), perfDelta_le L A q.2⟩, q.2, ?_⟩
    change (QuotientGroup.mk ((Subgroup.inclusion (perfDelta_le L A)) q) : Bar2 L) = a
    simpa [perfDeltaMap, S18.piBar2] using hq

theorem perfDelta_map_iSup_eq_top (L : Subgroup G) {ι : Type*} (Δ : Finset ι)
    (A : ι → Subgroup (Bar2 L)) (hAlt : ∀ i ∈ Δ, IsAlt ↥(A i) 5)
    (hgen : (⨆ i ∈ Δ, A i) = ⊤) :
    (((⨆ i ∈ Δ, perfDelta L (A i)).subgroupOf L).map (S18.piBar2 L)) = ⊤ := by
  have hmap_i : ∀ i ∈ Δ, ((perfDelta L (A i)).subgroupOf L).map (S18.piBar2 L) = A i :=
    fun i hi => perfDelta_subgroupOf_map L (A i) (hAlt i hi)
  rw [perfDelta_subgroupOf_iSup, Subgroup.map_iSup]
  simp only [Subgroup.map_iSup]
  rw [show (⨆ i, ⨆ (_ : i ∈ Δ), ((perfDelta L (A i)).subgroupOf L).map (S18.piBar2 L)) =
      (⨆ i ∈ Δ, A i) from by
    apply iSup_congr; intro i
    apply iSup_congr; intro hi
    exact hmap_i i hi]
  rw [hgen]

theorem L_le_sup_perfDelta (D : Data G) {L : Subgroup G} (hLM : L ≤ D.M)
    (hT : D.T ≤ Subgroup.normalizer (L : Set G))
    {ι : Type*} (Δ : Finset ι) (A : ι → Subgroup (Bar2 L))
    (hAlt : ∀ i ∈ Δ, IsAlt ↥(A i) 5) (hgen : (⨆ i ∈ Δ, A i) = ⊤) :
    L ≤ (⨆ i ∈ Δ, perfDelta L (A i)) ⊔ D.T := by
  have hO2T : CFSG.Open.pCoreOf 2 L ≤ D.T := pCore_le_sylow_of_le_normalizer D hLM hT
  have hmap := perfDelta_map_iSup_eq_top L Δ A hAlt hgen
  have hle : (⨆ i ∈ Δ, perfDelta L (A i)) ≤ L :=
    iSup₂_le fun i _ => perfDelta_le L (A i)
  have hsup : (⨆ i ∈ Δ, perfDelta L (A i)).subgroupOf L ⊔
      CFSG.pCore 2 ↥L = ⊤ := by
    have h := Subgroup.comap_map_eq (S18.piBar2 L)
      ((⨆ i ∈ Δ, perfDelta L (A i)).subgroupOf L)
    rw [hmap, Subgroup.comap_top, QuotientGroup.ker_mk'] at h
    exact h.symm
  have hmapL : (⨆ i ∈ Δ, perfDelta L (A i)) ⊔ CFSG.Open.pCoreOf 2 L = L := by
    have := congrArg (Subgroup.map L.subtype) hsup
    rw [Subgroup.map_sup, Subgroup.map_subgroupOf_eq_of_le hle, Subgroup.map_top,
      Subgroup.range_subtype, ← CFSG.openPCoreOf_eq_map_pCore] at this
    exact this
  intro x hx
  have hx' : x ∈ (⨆ i ∈ Δ, perfDelta L (A i)) ⊔ CFSG.Open.pCoreOf 2 L := by
    rw [hmapL]
    exact hx
  exact (sup_le_sup_left hO2T _) hx'


theorem T_le_normalizer_perfDelta (D : Data G) {L : Subgroup G}
    (hT : D.T ≤ Subgroup.normalizer (L : Set G)) (A : Subgroup (Bar2 L))
    (hA : ∀ s ∈ (CFSG.GroupTheory.conjModPCore 2 L D.T hT).range,
      A.map s.toMonoidHom = A) :
    D.T ≤ Subgroup.normalizer (perfDelta L A : Set G) := by
  intro m hm
  have hP : m ∈ Subgroup.normalizer (preDelta L A : Set G) := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    exact preDelta_conj_eq L D.T hT A
      (fun m => hA _ ⟨m, rfl⟩) ⟨m, hm⟩
  exact CFSG.BenderSuzuki.External.hkt_normalizer_le_normalizer_map_subtype_of_characteristic
    (preDelta L A) (CFSG.perfectResidual ↥(preDelta L A)) hP

theorem perfDelta_perfect (L : Subgroup G) (A : Subgroup (Bar2 L)) :
    Group.IsPerfect ↥(perfDelta L A) := by
  have : Group.IsPerfect ↥(CFSG.perfectResidual ↥(preDelta L A)) :=
    (CFSG.perfect_residual_characterization (G := ↥(preDelta L A))).2.2.1
  exact Group.IsPerfect.map (H := CFSG.perfectResidual ↥(preDelta L A)) (preDelta L A).subtype

theorem memberDelta_inFSq (D : Data G) {L : Subgroup G}
    (hT : D.T ≤ Subgroup.normalizer (L : Set G)) (A : Subgroup (Bar2 L))
    (hAlt : IsAlt ↥A 5)
    (hA : ∀ s ∈ (CFSG.GroupTheory.conjModPCore 2 L D.T hT).range,
      A.map s.toMonoidHom = A) (hKc : K_L2SzAutRank) :
    CFSG.LocalAnalysis.WeakClosure81.InFSq 2 (memberDelta D L A) := by
  have hQN : D.T ≤ Subgroup.normalizer (perfDelta L A : Set G) :=
    T_le_normalizer_perfDelta D hT A hA
  have hperf : ⁅perfDelta L A, perfDelta L A⁆ = perfDelta L A :=
    Subgroup.isPerfect_iff.mp (perfDelta_perfect L A)
  have hAltBar : IsAlt (Bar2 (perfDelta L A)) 5 := perfDelta_bar2_alt L A hAlt
  have hL2 : IsL2 (Bar2 (perfDelta L A)) 2 := by
    obtain ⟨e⟩ := hAltBar
    exact CFSG.Quasithin.H13.A5.lieModel_of_alternating_five e
  have hKn : ((perfDelta L A).subgroupOf (memberDelta D L A)).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer (le_sup_left : perfDelta L A ≤
      perfDelta L A ⊔ D.T)).mpr (sup_le (Subgroup.le_normalizer) hQN)
  exact CFSG.LocalAnalysis.UniquenessCase.PartTwo.S18.inFSq_of_isL2_of_normal_sup
    (le_sup_left : perfDelta L A ≤ perfDelta L A ⊔ D.T)
    hKn (TwelveShort.isSylowIn_of_le D le_sup_right) rfl hperf hL2 hKc

theorem three_dvd_perfDelta (L : Subgroup G) (A : Subgroup (Bar2 L)) (hAlt : IsAlt ↥A 5) :
    3 ∣ Nat.card ↥(perfDelta L A) := by
  have hbar : 3 ∣ Nat.card (Bar2 (perfDelta L A)) := by
    obtain ⟨e⟩ := perfDelta_bar2_alt L A hAlt
    rw [Nat.card_congr e.toEquiv, nat_card_alternatingGroup, Nat.card_fin]
    norm_num
  rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (CFSG.pCore 2 ↥(perfDelta L A))]
  exact hbar.mul_right _

theorem memberDelta_residual_not_conj (D : Data G) {L : Subgroup G}
    (hT : D.T ≤ Subgroup.normalizer (L : Set G)) (A : Subgroup (Bar2 L))
    (hAlt : IsAlt ↥A 5)
    (hA : ∀ s ∈ (CFSG.GroupTheory.conjModPCore 2 L D.T hT).range,
      A.map s.toMonoidHom = A)
    (h3' : ∀ g : G, g ∉ D.M → ¬ 3 ∣ Nat.card ↥(L ⊓ conjSubgroup D.M g)) :
    ∀ g : G, g ∉ D.M → ¬ twoResidual (memberDelta D L A) ≤ conjSubgroup D.M g := by
  intro g hg hle
  have hQN : D.T ≤ Subgroup.normalizer (perfDelta L A : Set G) :=
    T_le_normalizer_perfDelta D hT A hA
  have hperf : ⁅perfDelta L A, perfDelta L A⁆ = perfDelta L A :=
    Subgroup.isPerfect_iff.mp (perfDelta_perfect L A)
  have hres : twoResidual (memberDelta D L A) = perfDelta L A :=
    CFSG.Quasithin.S151S4.twoResidual_sup_eq_self (L := perfDelta L A) (S := D.T)
      hQN D.sylowM.isPGroup hperf
  rw [hres] at hle
  have hle' : perfDelta L A ≤ L ⊓ conjSubgroup D.M g :=
    le_inf (perfDelta_le L A) hle
  have hdvd : 3 ∣ Nat.card ↥(L ⊓ conjSubgroup D.M g) := by
    have h1 := Subgroup.card_subgroup_dvd_card
      ((perfDelta L A).subgroupOf (L ⊓ conjSubgroup D.M g))
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle').toEquiv] at h1
    exact (three_dvd_perfDelta L A hAlt).trans h1
  exact h3' g hg hdvd


theorem exists_delta_of_normal (D : Data G)
    {V₀ V L : Subgroup G} (c : Ctx17_17 D V₀ V L) (hJ : IsJ1 (Bar2 L))
    (hT : D.T ≤ Subgroup.normalizer (L : Set G))
    (h3' : ∀ g : G, g ∉ D.M → ¬ 3 ∣ Nat.card ↥(L ⊓ conjSubgroup D.M g))
    (hU : UniqueMax D.M L) (hKJ1 : K_J1A5Gen) (hKc : K_L2SzAutRank) :
    ∃ Δ : Finset (Subgroup G),
      (∀ H ∈ Δ, D.T ≤ H ∧ H ≤ D.M) ∧ UniqueMax D.M (⨆ H ∈ Δ, H) ∧
        (∀ H ∈ Δ, CFSG.LocalAnalysis.WeakClosure81.InFSq 2 H) ∧
          (∀ H ∈ Δ, ∀ g : G, g ∉ D.M → ¬ twoResidual H ≤ conjSubgroup D.M g) := by
  classical
  let φ := CFSG.GroupTheory.conjModPCore 2 L D.T hT
  let S : Subgroup (MulAut (Bar2 L)) := φ.range
  have hS : IsPGroup 2 S := by
    have htop : IsPGroup 2 ↥(⊤ : Subgroup ↥D.T) :=
      D.sylowM.isPGroup.of_equiv (Subgroup.topEquiv (G := ↥D.T)).symm
    have h := IsPGroup.map htop φ
    rw [Subgroup.map_top] at h
    exact h
  obtain ⟨Δbar, hΔbar_ne, hΔbar, hgen⟩ := hKJ1 (Bar2 L) hJ S hS
  let toH : Subgroup (Bar2 L) → Subgroup G := fun A => memberDelta D L A
  have hΔmem : ∀ H ∈ Δbar.image toH, D.T ≤ H ∧ H ≤ D.M := by
    intro H hH
    obtain ⟨A, hA, rfl⟩ := Finset.mem_image.mp hH
    exact ⟨le_member D L A, member_le_M D c.mem_calC.1.le A⟩
  have hΔInFSq : ∀ H ∈ Δbar.image toH, CFSG.LocalAnalysis.WeakClosure81.InFSq 2 H := by
    intro H hH
    obtain ⟨A, hA, rfl⟩ := Finset.mem_image.mp hH
    exact memberDelta_inFSq D hT A (hΔbar A hA).1 (hΔbar A hA).2 hKc
  have hΔres : ∀ H ∈ Δbar.image toH, ∀ g : G, g ∉ D.M →
      ¬ twoResidual H ≤ conjSubgroup D.M g := by
    intro H hH
    obtain ⟨A, hA, rfl⟩ := Finset.mem_image.mp hH
    exact memberDelta_residual_not_conj D hT A (hΔbar A hA).1 (hΔbar A hA).2 h3'
  have hsup_eq : (⨆ H ∈ Δbar.image toH, H) = ⨆ A ∈ Δbar, toH A := by
    rw [show (⨆ H ∈ Δbar.image toH, H) = (Δbar.image toH).sup id from
      (Finset.sup_eq_iSup _ _).symm]
    rw [Finset.sup_image, Finset.sup_eq_iSup]
    rfl
  have hTsup : D.T ≤ ⨆ H ∈ Δbar.image toH, H := by
    obtain ⟨i0, hi0⟩ := hΔbar_ne
    have hmem : toH i0 ∈ Δbar.image toH := Finset.mem_image.mpr ⟨i0, hi0, rfl⟩
    exact (le_member D L i0).trans (le_iSup₂_of_le (toH i0) hmem le_rfl)
  have hLsup : L ≤ ⨆ H ∈ Δbar.image toH, H := by
    have hgenL : L ≤ (⨆ A ∈ Δbar, perfDelta L A) ⊔ D.T :=
      L_le_sup_perfDelta D c.mem_calC.1.le hT Δbar (fun A => A)
        (fun i hi => (hΔbar i hi).1) hgen
    have h1 : (⨆ A ∈ Δbar, perfDelta L A) ≤ ⨆ H ∈ Δbar.image toH, H := by
      refine iSup₂_le fun A hA => ?_
      have hmem : toH A ∈ Δbar.image toH := Finset.mem_image.mpr ⟨A, hA, rfl⟩
      exact (le_sup_left : perfDelta L A ≤ toH A).trans
        (le_iSup₂_of_le (toH A) hmem le_rfl)
    exact hgenL.trans (sup_le h1 hTsup)
  have hU' : UniqueMax D.M (⨆ H ∈ Δbar.image toH, H) := by
    unfold UniqueMax at hU ⊢
    ext N
    constructor
    · intro hN
      have hLN : L ≤ N := hLsup.trans hN.2
      have hmem : N ∈ calMOf L := ⟨hN.1, hLN⟩
      rw [hU] at hmem
      simpa using hmem
    · intro hN
      have hNM : N = D.M := by simpa using hN
      subst hNM
      exact ⟨D.maxLocal, iSup₂_le fun H hH => (hΔmem H hH).2⟩
  exact ⟨Δbar.image toH, hΔmem, hU', hΔInFSq, hΔres⟩

end CFSG.LocalAnalysis.UniquenessCase.PartTwo.S17
