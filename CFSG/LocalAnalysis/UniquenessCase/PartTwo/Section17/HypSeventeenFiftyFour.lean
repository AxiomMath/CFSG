theorem dvd_card_bar2_of_isL2 {L : Subgroup G} {p n : ℕ} (h : IsL2 (Bar2 L) n)
    (hdvd : p ∣ 2 ^ n + 1) : p ∣ Nat.card (Bar2 L) := by
  rw [card_of_isL2 h]
  exact dvd_mul_of_dvd_right
    (CFSG.RankThree.PartOne.K1320.dvd_two_pow_double_sub_one hdvd) _

theorem dvd_card_bar2_of_isSz {L : Subgroup G} {p n : ℕ} (h : IsSz (Bar2 L) n)
    (hdvd : p ∣ 2 ^ (2 * n) + 1) : p ∣ Nat.card (Bar2 L) := by
  have hsz : CFSG.Blueprint.SuzukiModel (Bar2 L) 2 n := by
    have h' := h
    unfold IsSz CFSG.Blueprint.LieModel at h'
    rcases h' with h1 | h2 | h3 | h4
    · exact absurd h1.1 (by decide)
    · exact absurd h2.2.1 (by decide)
    · exact absurd h3.2.1 (by decide)
    · exact h4.2.2
  obtain ⟨-, a, ha, K, hfield, hfinite, hf, hKcard, ⟨e⟩⟩ := hsz
  letI := hfield
  letI := hfinite
  have hKcard' : Nat.card K = 2 ^ (2 * a + 1) := by rw [← hf]; exact hKcard
  have hcard : Nat.card (Bar2 L) =
      Nat.card (CFSG.BenderSuzuki.MatrixGroups.SuzukiMatrixGroup a) := by
    rw [Nat.card_congr e.toEquiv,
      Nat.card_congr
        (CFSG.ShultStronglyClosedTI.SuzukiModel.suzukiGroupEquivSuzukiMatrixGroup
          hKcard').toEquiv]
  have hq : 2 ^ (2 * n) = (2 ^ (2 * a + 1)) ^ 2 := by
    rw [hf, mul_comm 2 (2 * a + 1), pow_mul]
  have hdvd' : p ∣ (2 ^ (2 * a + 1)) ^ 2 + 1 := by rwa [← hq]
  rw [hcard, CFSG.SectionRank.card_suzukiMatrixGroup a ha]
  exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_left hdvd' _) _

theorem dvd_card_bar2_of_isSp4 {L : Subgroup G} {p n : ℕ} (h : IsSp4 (Bar2 L) n)
    (hdvd : p ∣ 2 ^ n + 1) : p ∣ Nat.card (Bar2 L) := by
  have hcard := CFSG.SeitzReduction.F4Pilot.card_eq_evenLieOrder_of_mem_classicalTags
    (by decide) h
  rw [hcard]
  show p ∣ CFSG.SeitzReduction.F4Pilot.evenLieOrder .PSp 2 n
  rw [show CFSG.SeitzReduction.F4Pilot.evenLieOrder .PSp 2 n = ordBC 2 (2 ^ n) from rfl]
  have hn1 : 1 ≤ n := h.admissible.2.1
  rw [CFSG.GroupTheory.ordBC_two_two_pow hn1]
  have h2 : p ∣ (2 ^ n) ^ 2 - 1 := by
    have h := CFSG.RankThree.PartOne.K1320.dvd_two_pow_double_sub_one hdvd
    rwa [show 2 ^ (2 * n) = (2 ^ n) ^ 2 by rw [mul_comm 2 n, pow_mul]] at h
  exact dvd_mul_of_dvd_right (dvd_mul_of_dvd_left h2 _) _

theorem dvd_card_bar2_of_isG2
    {L : Subgroup G} {p n : ℕ} (h : IsG2 (Bar2 L) n)
    (hdvd : p ∣ 2 ^ n + 1) : p ∣ Nat.card (Bar2 L) := by
  have hcm := CFSG.Blueprint.LieModel.chevalleyExceptionalModel h
    (by decide : StatedLieTag.G2 ∈ CFSG.Blueprint.chevalleyExceptionalTags)
  have hcard := CFSG.Timmesfeld.ExceptionalOrders.card_of_untwistedChevalleyModel_G2 hcm.2
  rw [hcard]
  show p ∣ ordG2 (2 ^ n)
  unfold ordG2
  have h2 : p ∣ (2 ^ n) ^ 2 - 1 := by
    have h := CFSG.RankThree.PartOne.K1320.dvd_two_pow_double_sub_one hdvd
    simpa [show 2 ^ (2 * n) = (2 ^ n) ^ 2 by rw [mul_comm 2 n, pow_mul]] using h
  exact dvd_mul_of_dvd_right h2 _

theorem dvd_card_bar2_of_isU4 {L : Subgroup G} {p n : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (h : IsU4 (Bar2 L) n) (hdvd : p ∣ 2 ^ n + 1) :
    p ∣ Nat.card (Bar2 L) := by
  have hcard := CFSG.SeitzReduction.F4Pilot.card_eq_evenLieOrder_of_mem_classicalTags
    (by decide) h
  rw [hcard]
  show p ∣ CFSG.SeitzReduction.F4Pilot.evenLieOrder .PSU 4 n
  rw [show CFSG.SeitzReduction.F4Pilot.evenLieOrder .PSU 4 n = ordTwistedA 3 (2 ^ n)
    from rfl]
  rw [CFSG.ClassicalInvolution.RouteD.TWR.ordTwistedA_three_eq (2 ^ n) Nat.one_le_two_pow]
  set q := 2 ^ n with hq
  set g := Nat.gcd 4 (q + 1)
  have h2 : p ∣ q ^ 2 - 1 := by
    have h := CFSG.RankThree.PartOne.K1320.dvd_two_pow_double_sub_one hdvd
    have hpow : 2 ^ (2 * n) = q ^ 2 := by
      rw [hq, mul_comm 2 n, pow_mul]
    simpa [hpow] using h
  have hN : p ∣ q ^ 6 * ((q ^ 2 - 1) * ((q ^ 3 + 1) * (q ^ 4 - 1))) :=
    dvd_mul_of_dvd_right (dvd_mul_of_dvd_left h2 _) _
  have hgN : g ∣ q ^ 6 * ((q ^ 2 - 1) * ((q ^ 3 + 1) * (q ^ 4 - 1))) := by
    have hgq : g ∣ q + 1 := Nat.gcd_dvd_right 4 (q + 1)
    have hq2 : q + 1 ∣ q ^ 2 - 1 := by
      have hfact : q ^ 2 - 1 = (q - 1) * (q + 1) := by
        simpa [pow_two, mul_comm] using Nat.sq_sub_sq q 1
      rw [hfact]
      exact dvd_mul_of_dvd_right dvd_rfl (q - 1)
    have hgq2 : g ∣ q ^ 2 - 1 := hgq.trans hq2
    exact dvd_mul_of_dvd_right (dvd_mul_of_dvd_left hgq2 _) _
  have hcop : Nat.Coprime p g := by
    have hg4 : g ∣ 4 := Nat.gcd_dvd_left 4 (q + 1)
    have hp4 : Nat.Coprime p 4 := by
      have hp2' : Nat.Coprime p 2 := (Nat.coprime_primes hp Nat.prime_two).2 hp2
      simpa using hp2'.pow_right 2
    exact hp4.coprime_dvd_right hg4
  have hpgN : p * g ∣ q ^ 6 * ((q ^ 2 - 1) * ((q ^ 3 + 1) * (q ^ 4 - 1))) :=
    hcop.mul_dvd_of_dvd_of_dvd hN hgN
  exact (Nat.dvd_div_iff_mul_dvd hgN).2 (by simpa [mul_comm] using hpgN)

theorem five_dvd_card_bar2_of_isU5_two {L : Subgroup G} (h : IsU5 (Bar2 L) 2) :
    5 ∣ Nat.card (Bar2 L) := by
  have hcard := CFSG.SeitzReduction.F4Pilot.card_eq_evenLieOrder_of_mem_classicalTags
    (by decide) h
  rw [hcard]
  show 5 ∣ CFSG.SeitzReduction.F4Pilot.evenLieOrder .PSU 5 2
  rw [show CFSG.SeitzReduction.F4Pilot.evenLieOrder .PSU 5 2 = ordTwistedA 4 4 from rfl]
  decide +kernel

theorem normal_and_shape_of_p42_1 {D : Data G} {L X : Subgroup G} (hL : L ∈ calC D.M)
    (hXeq : X = conjClosure D.M L) (h1 : P17_42_1 D X) :
    (L.subgroupOf D.M).Normal ∧
      (F08.Thin8 L ∨ (∃ n : ℕ, IsU3 (Bar2 L) n) ∨ IsL3 (Bar2 L) 2) := by
  obtain ⟨hXM, hMX, -⟩ := conjSetOf_subset_calC_conjClosure hL
  by_cases hXL : X = L
  · have hLleM : L ≤ D.M := by rw [← hXL, hXeq]; exact hXM
    have hMnorm : D.M ≤ normalizer (L : Set G) := by
      rw [← hXL, hXeq]
      exact hMX
    have hnormal : (L.subgroupOf D.M).Normal :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer hLleM).2 hMnorm
    have hshape : F08.Thin8 L ∨ (∃ n : ℕ, IsU3 (Bar2 L) n) ∨ IsL3 (Bar2 L) 2 := by
      have h := h1
      rw [hXL] at h
      simpa [P17_42_1] using h
    exact ⟨hnormal, hshape⟩
  · exfalso
    rcases h1 with hthin | ⟨n, hU3⟩ | hL3
    · exact not_thin8_of_conjClosure_ne hL hXeq hXL hthin
    · refine hXL (hXeq.trans ?_)
      exact conjClosure_eq_self_of_isSimpleGroup_bar2 hL
        (LieModel.isSimpleGroup_of_mem_classicalTags (by decide) (hXeq ▸ hU3))
    · refine hXL (hXeq.trans ?_)
      exact conjClosure_eq_self_of_isSimpleGroup_bar2 hL
        (LieModel.isSimpleGroup_of_mem_classicalTags (by decide) (hXeq ▸ hL3))

private theorem mem_calL2_or_calL3_of_p42_2 {D : Data G} {p : ℕ}
    (hp : p ∈ D.sig) {L X : Subgroup G} (hL : L ∈ calC D.M)
    (hXdef : X = conjClosure D.M L) (h2 : P17_42_2 D L X p) :
    X ∈ calL2Star D p ∨ X ∈ calL3Star D p := by
  have hp_prime : p.Prime := (D.sig_prime p hp).1
  obtain ⟨n, x, hxM, hXsup, hXne, hshape, -⟩ := h2
  have hpL : p ∈ piSet L := by
    refine ⟨hp_prime, ?_⟩
    rcases hshape with ⟨hL2, hcong⟩ | ⟨hSz, hcong⟩
    · exact (dvd_card_bar2_of_isL2 hL2 (UC22.uc22p22r_dvd_succ hcong)).trans
        (Subgroup.card_quotient_dvd_card (CFSG.pCore 2 ↥L))
    · exact (dvd_card_bar2_of_isSz hSz (UC22.uc22p22r_dvd_succ hcong)).trans
        (Subgroup.card_quotient_dvd_card (CFSG.pCore 2 ↥L))
  have hXmem : X ∈ calLpStar D p := ⟨L, ⟨hL, hpL⟩, hXdef⟩
  by_cases hA5 : IsA5xA5 (Bar2 X)
  · exact Or.inr ⟨hXmem, hA5⟩
  · refine Or.inl ⟨hXmem, ?_, hA5⟩
    rintro ⟨hXcal, -⟩
    have hXLle : L ≤ X := by rw [hXsup]; exact le_sup_left
    have hLXcal : L ∈ calC X := uc22p22u_calC_of_le hL hXLle hXcal.1.le
    have hKmem : CFSG.Quasithin.conjSubgroup L x ∈ conjSetOf D.M L :=
      ⟨x⁻¹, D.M.inv_mem hxM, rfl⟩
    obtain ⟨-, -, hC⟩ := conjSetOf_subset_calC_conjClosure hL
    have hKXcal : CFSG.Quasithin.conjSubgroup L x ∈ calC X := hXdef ▸ hC _ hKmem
    have hKne : CFSG.Quasithin.conjSubgroup L x ≠ L := by
      intro h
      apply hXne
      rw [hXsup, h, sup_idem]
    have hqX : CFSG.Open.IsQuasisimple (Bar2 X) := hXcal.2.2
    have hcompL := uc22p22l_barImage_isComponent hLXcal
    have hcompK := uc22p22l_barImage_isComponent hKXcal
    have htopL : barImage X L = ⊤ :=
      uc22p22r_eq_top_of_quasisimple hqX
        ((CFSG.Quasithin.A3.isQuasisimple_iff_open).mp hcompL.1)
        (CFSG.Open.IsSubnormal.of_mathlib hcompL.2)
    have htopK : barImage X (CFSG.Quasithin.conjSubgroup L x) = ⊤ :=
      uc22p22r_eq_top_of_quasisimple hqX
        ((CFSG.Quasithin.A3.isQuasisimple_iff_open).mp hcompK.1)
        (CFSG.Open.IsSubnormal.of_mathlib hcompK.2)
    have himg : barImage X (CFSG.Quasithin.conjSubgroup L x) = barImage X L := by
      rw [htopK, htopL]
    exact hKne (uc22p22u_calC_ext hKXcal hLXcal himg)

private theorem mem_calL1_of_p42_3 {D : Data G} {p : ℕ}
    (hp : p ∈ D.sig) {L X : Subgroup G} (hL : L ∈ calC D.M)
    (hXdef : X = conjClosure D.M L) (h3 : P17_42_3 D X p) : X ∈ calL1Star D p := by
  have hp_prime : p.Prime := (D.sig_prime p hp).1
  obtain ⟨n, hU5, hn2, -, hp5, -⟩ := h3
  subst hn2
  have hsimple : IsSimpleGroup (Bar2 X) :=
    LieModel.isSimpleGroup_of_mem_classicalTags (by decide) hU5
  have hXL : X = L := hXdef.trans (conjClosure_eq_self_of_isSimpleGroup_bar2 hL (hXdef ▸ hsimple))
  have hU5L : IsU5 (Bar2 L) 2 := hXL ▸ hU5
  have hpL : p ∈ piSet L :=
    ⟨hp_prime, hp5 ▸ (five_dvd_card_bar2_of_isU5_two hU5L).trans
      (Subgroup.card_quotient_dvd_card (CFSG.pCore 2 ↥L))⟩
  exact ⟨⟨L, ⟨hL, hpL⟩, hXdef⟩, Or.inr hU5⟩

private theorem mem_calL1_of_p42_4
    {D : Data G}
    {p : ℕ} (hp : p ∈ D.sig) {L X : Subgroup G} (hL : L ∈ calC D.M)
    (hXdef : X = conjClosure D.M L) (h4 : P17_42_4 D X p) : X ∈ calL1Star D p := by
  have hp_prime : p.Prime := (D.sig_prime p hp).1
  obtain ⟨n, hshape, -, -, hcong, -, -⟩ := h4
  have hsimple : IsSimpleGroup (Bar2 X) := by
    rcases hshape with hSp4 | hG2
    · exact LieModel.isSimpleGroup_of_mem_classicalTags (by decide) hSp4
    · exact (CFSG.LieType.Simplicity.fam_g2_simplicity (Bar2 X) 2 n
        (LieModel.chevalleyExceptionalModel hG2 (by decide))).2
  have hXL : X = L := hXdef.trans (conjClosure_eq_self_of_isSimpleGroup_bar2 hL (hXdef ▸ hsimple))
  have hpL : p ∈ piSet L := by
    refine ⟨hp_prime, ?_⟩
    rcases hshape with hSp4 | hG2
    · exact (dvd_card_bar2_of_isSp4 (hXL ▸ hSp4)
        (UC22.uc22p22r_dvd_succ hcong)).trans
        (Subgroup.card_quotient_dvd_card (CFSG.pCore 2 ↥L))
    · exact (dvd_card_bar2_of_isG2 (hXL ▸ hG2)
        (UC22.uc22p22r_dvd_succ hcong)).trans
        (Subgroup.card_quotient_dvd_card (CFSG.pCore 2 ↥L))
  have hXmem : X ∈ calLpStar D p := ⟨L, ⟨hL, hpL⟩, hXdef⟩
  have hshape' : IsG2 (Bar2 X) n ∨ IsSp4 (Bar2 X) n ∨ IsU4 (Bar2 X) n := by
    rcases hshape with hSp4 | hG2
    · exact Or.inr (Or.inl hSp4)
    · exact Or.inl hG2
  exact ⟨hXmem, Or.inl ⟨n, hshape'⟩⟩

private theorem mem_calL1_of_p42_5 {D : Data G} {p : ℕ}
    (hp : p ∈ D.sig) {L X : Subgroup G} (hL : L ∈ calC D.M)
    (hXdef : X = conjClosure D.M L) (h5 : P17_42_5 D X p) : X ∈ calL1Star D p := by
  have hp_prime : p.Prime := (D.sig_prime p hp).1
  obtain ⟨n, hU4, -, hcong, -⟩ := h5
  have hsimple : IsSimpleGroup (Bar2 X) :=
    LieModel.isSimpleGroup_of_mem_classicalTags (by decide) hU4
  have hXL : X = L := hXdef.trans (conjClosure_eq_self_of_isSimpleGroup_bar2 hL (hXdef ▸ hsimple))
  have hpL : p ∈ piSet L :=
    ⟨hp_prime, (dvd_card_bar2_of_isU4 hp_prime (D.sig_prime p hp).2 (hXL ▸ hU4)
      (UC22.uc22p22r_dvd_succ hcong)).trans
      (Subgroup.card_quotient_dvd_card (CFSG.pCore 2 ↥L))⟩
  exact ⟨⟨L, ⟨hL, hpL⟩, hXdef⟩, Or.inl ⟨n, Or.inr (Or.inr hU4)⟩⟩

theorem hyp1754_clause_or_mem_calL123Star
    (D : Data G) {V₀ V : Subgroup G} (h42 : R17_42At D V₀ V) {p : ℕ} (hp : p ∈ D.sig)
    {L : Subgroup G} (hL : L ∈ calC D.M) :
    ((L.subgroupOf D.M).Normal ∧
        (F08.Thin8 L ∨ (∃ n : ℕ, IsU3 (Bar2 L) n) ∨ IsL3 (Bar2 L) 2)) ∨
      conjClosure D.M L ∈ calL1Star D p ∨ conjClosure D.M L ∈ calL2Star D p ∨
        conjClosure D.M L ∈ calL3Star D p := by
  by_cases hgood : (L.subgroupOf D.M).Normal ∧
      (F08.Thin8 L ∨ (∃ n : ℕ, IsU3 (Bar2 L) n) ∨ IsL3 (Bar2 L) 2)
  · exact Or.inl hgood
  · set X := conjClosure D.M L with hXdef
    have h42L : Concl17_42 D L X p := h42 L p hL hp
    rcases h42L with h1 | h2 | h3 | h4 | h5
    · exact absurd (normal_and_shape_of_p42_1 hL hXdef h1) hgood
    · rcases mem_calL2_or_calL3_of_p42_2 hp hL hXdef h2 with h | h
      · exact Or.inr (Or.inr (Or.inl h))
      · exact Or.inr (Or.inr (Or.inr h))
    · exact Or.inr (Or.inl (mem_calL1_of_p42_3 hp hL hXdef h3))
    · exact Or.inr (Or.inl (mem_calL1_of_p42_4 hp hL hXdef h4))
    · exact Or.inr (Or.inl (mem_calL1_of_p42_5 hp hL hXdef h5))

theorem hyp1754_of_mem_calL0Star
    (D : Data G) {V₀ V : Subgroup G} (h42 : R17_42At D V₀ V) {p : ℕ} (hp : p ∈ D.sig)
    {X : Subgroup G} (hX0 : X ∈ calL0Star D p) (h1 : X ∉ calL1Star D p)
    (h2 : X ∉ calL2Star D p) (h3 : X ∉ calL3Star D p) : Hyp1754 D p := by
  have hj := jM_mem_of_nonempty (D := D) (p := p) ⟨X, hX0⟩
  have h4 : 4 ≤ jM D p := by
    rcases Nat.lt_or_ge (jM D p) 4 with hlt | hge
    · have hcases : jM D p = 1 ∨ jM D p = 2 ∨ jM D p = 3 := by omega
      rcases hcases with h | h | h
      · exact absurd (by simpa [calL0Star, calLjStar, h] using hX0) h1
      · exact absurd (by simpa [calL0Star, calLjStar, h] using hX0) h2
      · exact absurd (by simpa [calL0Star, calLjStar, h] using hX0) h3
    · exact hge
  refine ⟨hp, ?_⟩
  intro L hL
  rcases hyp1754_clause_or_mem_calL123Star D h42 hp hL with hgood | hX1 | hX2 | hX3
  · exact hgood
  · have hempty : calL1Star D p = ∅ := by
      simpa [calLjStar] using hj.2.2.2 1 (by norm_num) (by omega)
    rw [hempty] at hX1
    exact absurd hX1 (by simp)
  · have hempty : calL2Star D p = ∅ := by
      simpa [calLjStar] using hj.2.2.2 2 (by norm_num) (by omega)
    rw [hempty] at hX2
    exact absurd hX2 (by simp)
  · have hempty : calL3Star D p = ∅ := by
      simpa [calLjStar] using hj.2.2.2 3 (by norm_num) (by omega)
    rw [hempty] at hX3
    exact absurd hX3 (by simp)

theorem hyp1754_of_thin_mem_calL0Star
    (D : Data G) {V₀ V : Subgroup G} (h42 : R17_42At D V₀ V) {p : ℕ} (hp : p ∈ D.sig)
    {L : Subgroup G} (hL : L ∈ calLp D p) (hL0 : L ∈ calL0Star D p)
    (hthin : F08.Thin8 L) : Hyp1754 D p := by
  have h1 : L ∉ calL1Star D p := by
    intro hmem
    rw [mem_calL1Star] at hmem
    rcases hmem.2 with ⟨f, hG2 | hSp4 | hU4⟩ | hU5
    · exact not_thin8_of_isG2_bar2 hG2 hthin
    · exact not_thin8_of_isSp4_bar2 hSp4 hthin
    · exact not_thin8_of_isU4_bar2 hU4 hthin
    · exact not_thin8_of_isU5_bar2 hU5 hthin
  have h2 : L ∉ calL2Star D p := by
    intro hmem
    rw [mem_calL2Star] at hmem
    exact hmem.2.1 hL
  have h3 : L ∉ calL3Star D p := by
    intro hmem
    rw [mem_calL3Star] at hmem
    exact not_isQuasisimple_of_isA5xA5 hmem.2 hL.1.2.2
  exact hyp1754_of_mem_calL0Star D h42 hp hL0 h1 h2 h3

