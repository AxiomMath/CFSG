open CFSG.Quasithin CFSG.Quasithin.B42Disp
open CFSG.Blueprint CFSG.Blueprint.Chevalley CFSG.LieType.Chevalley
open CFSG.LocalAnalysis.UniquenessCase.UC22
open CFSG.LocalAnalysis.UniquenessCase.PartTwo.Inputs1719.Thm14_5

theorem trialityD4IrredBound_holds :
    TrialityD4IrredBound := by
  intro X _ _ n hX _ U _ _ hU ρ _ l hl2 hρl
  classical
  have hCE : ChevalleyExceptionalModel X .trialityD4 2 n :=
    CFSG.Blueprint.LieModel.chevalleyExceptionalModel hX (by decide)
  have : IsSimpleGroup X :=
    (CFSG.LieType.Simplicity.fam_3d4_simplicity X 2 n hCE).2
  obtain ⟨hf, K, _, _, σ, hK, hσ, ⟨e⟩⟩ :=
    CFSG.QuasithinUnique.Setup.X6.exists_mulEquiv_triality_model hCE
  have : CharP K 2 := CFSG.Quasithin.B42D4.charP_two_of_card hf hK
  have hσ3 : σ.toRingHom ^ 3 = 1 := CFSG.Quasithin.B42D4.sigma_cube hK σ hσ
  have hρinj : Function.Injective ρ := FLc.injective_of_ne_one ρ ⟨l, hρl⟩
  let L : Subgroup (MulAut U) := ρ.range
  let C₀ : Subgroup (ModGL TwistTag.D4.tag K) :=
    graphFixedRootGroup TwistTag.D4 K σ.toRingHom
  let eX : X ≃* L := MonoidHom.ofInjective hρinj
  let φ : L ≃* C₀ := eX.symm.trans e
  let y : L := ⟨ρ l, ⟨l, rfl⟩⟩
  have hl2' : l * l = 1 := by
    have h := (orderOf_eq_prime_iff.mp hl2).1
    rwa [pow_two] at h
  have hy2 : y * y = 1 := by
    apply Subtype.ext
    show (ρ l) * (ρ l) = 1
    rw [← map_mul, hl2', map_one]
  have hy1 : y ≠ 1 := by
    intro h
    apply hρl
    have h1 : (y : MulAut U) = 1 := by rw [h]; rfl
    simpa [y] using h1
  have hξ2 : φ y * φ y = 1 := by rw [← map_mul, hy2, map_one]
  have hξ1 : φ y ≠ 1 := by
    intro h
    apply hy1
    apply φ.injective
    rw [h, map_one]
  have hclass := CFSG.Quasithin.B42D4.involution_conj σ hσ3 (φ y) hξ2 hξ1
  have hZL : Subgroup.center L = ⊥ := by
    have hZC : Subgroup.center C₀ = ⊥ :=
      CFSG.LieType.Chevalley.exceptional_fixed_center_trivial TwistTag.D4 K σ
    have hmap : (Subgroup.center L).map φ.toMonoidHom = Subgroup.center C₀ :=
      Subgroup.map_center_eq φ
    rw [hZC] at hmap
    exact (Subgroup.map_eq_bot_iff_of_injective _ φ.injective).1 hmap
  let e' : L ⧸ Subgroup.center L ≃* C₀ :=
    ((QuotientGroup.quotientMulEquivOfEq hZL).trans QuotientGroup.quotientBot).trans φ
  have hproj : ∀ z : L, modelProj L e' z = φ z := fun _ => rfl
  have hmain : 2 ^ (6 * n) ≤ (fixV (Subgroup.zpowers (ρ l))).index := by
    rcases hclass with hlong | hshort
    · have h := two_pow_six_mul_le_index_long_of_one_le hK σ hσ hf hU φ hlong
      simpa [y] using h
    · have h := CFSG.Quasithin.B45Tor.two_pow_le_index_classB hf hK σ hσ
          (fun v => by rw [← pow_two]; exact hU v) L hZL e' (x := y)
          (by rw [hproj]; exact hshort)
      have h' : 2 ^ (12 * n) ≤ (fixV (Subgroup.zpowers (ρ l))).index := by
        simpa [y] using h
      exact (Nat.pow_le_pow_right (by norm_num) (by omega : 6 * n ≤ 12 * n)).trans h'
  have hU2 : IsPGroup 2 U := fun u => ⟨1, hU u⟩
  rw [CFSG.Quasithin.H.index_eq_two_pow_rkIdx hU2] at hmain
  exact (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).mp hmain

end CFSG.LocalAnalysis.UniquenessCase.PartTwo.S17
