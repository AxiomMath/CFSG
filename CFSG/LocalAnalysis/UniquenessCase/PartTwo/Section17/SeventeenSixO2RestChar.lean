theorem gap17_6_O2RestChar_of_inputs (D : Data G) (V₀ V : Subgroup G)
    (hSg : UC6S846.SigmaStd D) (hKorder : K_G176FunOrder)
    (hKO1b : K_FunRankTwo) (hKO2 : K_LieOddRankFour) (hKexc : K_G176ExcRankThree)
    (h76 : CFSG.LocalAnalysis.UniquenessCase.UC22.F07.R76 D) :
    ∀ (L : Subgroup G) (r q : ℕ) (hC : Ctx17_6 D V₀ V L r q),
      Gap17_6_O2RestChar D V₀ V L r q hC := by
  classical
  intro L r q hC hV₀ hk2 h1 h2 hrsig H hH g hg hres
  obtain ⟨hqr, hexc, hZ⟩ := exceptional_data_of_not_mem_sig D hSg hC h1 h2 hKO2 hrsig
  obtain ⟨hr, hr2, -, -, -, -, -, -⟩ := hC.lie
  have hns : ¬ Group.IsSolvable ↥D.M := UC6S846.not_solvable_of_mem_calC hC.memL
  have hHM : H ≤ D.M := delta_le_M_mem D (fundPred q) hC hH
  have hH' := hH
  rw [Delta17_12, dif_neg h1, dif_neg h2] at hH'
  obtain ⟨x, hxM, X, hXLx, hO2, hHeq, hKb⟩ := hH'
  have hKb' : CFSG.LocalAnalysis.UniquenessCase.IsFundamentalOver q
      ((X.subgroupOf (L.map (MulAut.conj x).toMonoidHom)).map
        (QuotientGroup.mk' (CFSG.pCore 2 ↥(L.map (MulAut.conj x).toMonoidHom)))) :=
    hKb.1
  by_cases hall : ∀ p ∈ D.sig, p ∣ r ^ 2 - 1
  · obtain ⟨p, hpσ⟩ := hSg.nonempty
    have hp : p.Prime := (D.sig_prime p hpσ).1
    have hp2 : p ≠ 2 := (D.sig_prime p hpσ).2
    have hpdvd : p ∣ r ^ 2 - 1 := hall p hpσ
    have hpq : p ∣ q * (q ^ 2 - 1) := by
      rw [hqr]
      exact dvd_mul_of_dvd_right hpdvd r
    have hpKb : p ∣ Nat.card ↥((X.subgroupOf (L.map (MulAut.conj x).toMonoidHom)).map
        (QuotientGroup.mk' (CFSG.pCore 2 ↥(L.map (MulAut.conj x).toMonoidHom)))) :=
      hKorder _ q p _ hKb' hp hp2 hpq
    have hpX : p ∣ Nat.card X := by
      have h1' : p ∣ Nat.card (X.subgroupOf (L.map (MulAut.conj x).toMonoidHom)) :=
        hpKb.trans (Subgroup.card_map_dvd _ _)
      rwa [Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe hXLx).toEquiv] at h1'
    have hpH : p ∣ Nat.card H :=
      hpX.trans (Subgroup.card_dvd_of_le (by rw [hHeq]; exact le_sup_right))
    exact CFSG.GroupTheory.twoResidual_not_le_conjSubgroup_of_isStronglyPEmbedded hp hp2 hHM
      hpH (UC6S846.sp_of_mem_sig hSg hns hpσ) g hg hres
  · push Not at hall
    obtain ⟨p, hpσ, hpdvd⟩ := hall
    have hp : p.Prime := (D.sig_prime p hpσ).1
    have hp2 : p ≠ 2 := (D.sig_prime p hpσ).2
    have hsp : CFSG.RankThree.PartOne.IsStronglyPEmbedded r D.M :=
      stronglyPEmbedded_of_exceptional D hSg hC h1 h2 hKO1b hKO2 hKexc h76
        hrsig p hp hp2 hpσ hpdvd
    have hrH : r ∣ Nat.card H :=
      char_dvd_card_of_mem_delta_three D hKorder hC hXLx hHeq hKb
    exact CFSG.GroupTheory.twoResidual_not_le_conjSubgroup_of_isStronglyPEmbedded hr hr2 hHM
      hrH hsp g hg hres

theorem gap17_6_O2Rest_of_inputs_char (D : Data G) (V₀ V : Subgroup G)
    (h82 : F08.R82 D) (hSg : UC6S846.SigmaStd D)
    (hKexc : K_G176ExcRankThree)
