    refine ⟨⟨s.1, Subgroup.mem_subgroupOf.mp hs⟩, ?_⟩
    apply Subtype.ext
    exact hsr
  have hφ_center : (Subgroup.center (S : Subgroup G)).map φ ≤
      Subgroup.center (R : Subgroup (Bar2 L)) := by
    intro y hy
    obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.mp hy
    rw [Subgroup.mem_center_iff]
    intro w
    obtain ⟨s, rfl⟩ := hφ_surj w
    rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.mp hz s]
