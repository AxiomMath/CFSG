    (hKexc (Bar2 L) r hr hr2 hqBar hexc hZ hrankBar).2.2.1 R
  have hSne : S ≠ ⊥ := fun hbot => hE3Lne (le_bot_iff.mp (hbot ▸ hE3S))
  have hSp' : IsPGroup r (S.subgroupOf L) :=
    hS.isPGroup.of_equiv (Subgroup.subgroupOfEquivOfLe hSleL).symm
  have hdisjO2 : Disjoint (S.subgroupOf L) π.ker := by
    apply Subgroup.disjoint_of_coprime_natCard
    obtain ⟨a, ha⟩ := @IsPGroup.exists_card_eq r ↥(S.subgroupOf L) _ (Fact.mk hr) _ hSp'
    obtain ⟨b, hb⟩ := hker.exists_card_eq
    rw [ha, hb]
    exact Nat.Coprime.pow _ _ ((Nat.coprime_primes hr Nat.prime_two).2 hr2)
