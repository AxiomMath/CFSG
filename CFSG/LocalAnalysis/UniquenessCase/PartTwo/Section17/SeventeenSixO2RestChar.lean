@[expose] def K_G176ExcRankThree : Prop :=
  ∀ (X : Type) [Group X] [Finite X] (r : ℕ),
    r.Prime → r ≠ 2 → CFSG.Open.IsQuasisimple X →
    (LieModel (X ⧸ Subgroup.center X) .G2 0 r 1 ∨
      LieModel (X ⧸ Subgroup.center X) .PSp 2 r 1) →
    ¬ r ∣ Nat.card (Subgroup.center X) →
    CFSG.Open.pRank r (⊤ : Subgroup X) ≤ 3 →
    (∃ E : Subgroup X, IsElemAbelian r E ∧ Nat.card E = r ^ 3) ∧
    (∀ R : Sylow r X, ∀ y : X, y ∈ (R : Subgroup X) → orderOf y = r →
      ∃ E : Subgroup X, E ≤ (R : Subgroup X) ∧ IsElemAbelian r E ∧
        Nat.card E = r ^ 2 ∧ y ∈ E) ∧
    (∀ R : Sylow r X, Nat.card (Subgroup.center (R : Subgroup X)) = r) ∧
    ¬ r ∣ Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.Outer X)

theorem exceptional_data_of_not_mem_sig (D : Data G) (hSg : UC6S846.SigmaStd D)
    {V₀ V L : Subgroup G} {r q : ℕ} (hC : Ctx17_6 D V₀ V L r q)
    (h1 : ¬ P17_12_1 r q L) (h2 : ¬ P17_12_2 q L)
    (hKO2 : K_LieOddRankFour) (hrsig : r ∉ D.sig) :
    q = r ∧
      (LieModel (Bar2 L ⧸ Subgroup.center (Bar2 L)) .G2 0 r 1 ∨
        LieModel (Bar2 L ⧸ Subgroup.center (Bar2 L)) .PSp 2 r 1) ∧
      ¬ r ∣ Nat.card (Subgroup.center (Bar2 L)) := by
  classical
  obtain ⟨hr, hr2, t, n, f, hadm, hq_eq, hm⟩ := hC.lie
  have hqBar : CFSG.Open.IsQuasisimple (Bar2 L) := hC.memL.2.2
  have hodd : Odd (Nat.card (Subgroup.center (Bar2 L))) := by
    simpa [Bar2] using UC22.uc22p20p_odd_center_bar2 ↥L
  obtain ⟨eBar⟩ := UC22.uc22p21k_barInf_equiv_of_calC hC.memL
  have hmq : LieModel (Bar2 L ⧸ Subgroup.center (Bar2 L)) t n r f :=
    hm.of_mulEquiv eBar
  have hL2 : ¬ IsL2Over17 (Bar2 L ⧸ Subgroup.center (Bar2 L)) q := by
    intro hbad
    exact h1 (Or.inl (isL2Over17_of_mulEquiv eBar hbad))
  have hL3 : ¬ IsL3EpsOdd17 (Bar2 L ⧸ Subgroup.center (Bar2 L)) r := by
    intro hbad
    rw [IsL3EpsOdd17] at hbad
    exact h1 (Or.inr (by
      rcases hbad with hbad | hbad
      · exact Or.inl (LieModel.of_mulEquiv eBar.symm hbad)
      · exact Or.inr (LieModel.of_mulEquiv eBar.symm hbad)))
  have hRee : ¬ IsReeOver17 (Bar2 L) q := h2
  have hrank : CFSG.Open.pRank r D.M ≤ 3 := by
    by_contra hle
    have h4 : 4 ≤ CFSG.Open.pRank r D.M := by omega
    exact hrsig (hSg.four_mem r hr hr2 h4)
  have hres := hKO2 (Bar2 L) r q hr hr2 ⟨t, n, f, hadm, hq_eq, hmq⟩ hqBar hodd
    hL2 hL3 hRee
  rcases hres with h4 | ⟨hqr, hexc, hZ⟩
  · have h4L : 4 ≤ CFSG.Open.pRank r L := by
      rw [← pRank_bar2_eq_of_odd (Y := L) hr hr2]
      exact h4
    have h4M : 4 ≤ CFSG.Open.pRank r D.M :=
      h4L.trans (CFSG.SectionRank.pRank_mono hr.one_lt hC.memL.1.le)
    omega
  · exact ⟨hqr, hexc, hZ⟩

theorem normal_of_not_mem_sig (D : Data G) (hSg : UC6S846.SigmaStd D)
    {V₀ V L : Subgroup G} {r q : ℕ} (hC : Ctx17_6 D V₀ V L r q)
    (h1 : ¬ P17_12_1 r q L) (h2 : ¬ P17_12_2 q L)
    (hKO1b : K_FunRankTwo) (hKO2 : K_LieOddRankFour) (hrsig : r ∉ D.sig) :
    (L.subgroupOf D.M).Normal := by
  classical
  obtain ⟨hqr, hexc, hZ⟩ := exceptional_data_of_not_mem_sig D hSg hC h1 h2 hKO2 hrsig
  obtain ⟨hr, hr2, t, n, f, hadm, hq_eq, hm⟩ := hC.lie
  have hqBar : CFSG.Open.IsQuasisimple (Bar2 L) := hC.memL.2.2
  have hodd : Odd (Nat.card (Subgroup.center (Bar2 L))) := by
    simpa [Bar2] using UC22.uc22p20p_odd_center_bar2 ↥L
  obtain ⟨eBar⟩ := UC22.uc22p21k_barInf_equiv_of_calC hC.memL
  have hmq : LieModel (Bar2 L ⧸ Subgroup.center (Bar2 L)) t n r f :=
    hm.of_mulEquiv eBar
  have hL2 : ¬ IsL2Over17 (Bar2 L ⧸ Subgroup.center (Bar2 L)) q := by
    intro hbad
    exact h1 (Or.inl (isL2Over17_of_mulEquiv eBar hbad))
  have hL3 : ¬ IsL3EpsOdd17 (Bar2 L ⧸ Subgroup.center (Bar2 L)) r := by
    intro hbad
    rw [IsL3EpsOdd17] at hbad
    exact h1 (Or.inr (by
      rcases hbad with hbad | hbad
      · exact Or.inl (LieModel.of_mulEquiv eBar.symm hbad)
      · exact Or.inr (LieModel.of_mulEquiv eBar.symm hbad)))
  have hRee : ¬ IsReeOver17 (Bar2 L) q := h2
  obtain ⟨P, hPcoe⟩ := exists_sylow_syl2Bar D L hC.memL.1
  obtain ⟨E, K₁, K₂, hK₁, hK₂, hEel, hEcard, hEsup⟩ :=
    (hKO1b (Bar2 L) r q hr hr2 ⟨t, n, f, hadm, hq_eq, hmq⟩ hqBar hodd (Or.inr hZ)
      hL2 hL3 hRee P).1
  obtain ⟨E', hE'le, hE'el, hE'card⟩ :=
    exists_lift_barPreimage L hr hr2 K₁ K₂ E hEsup hEel hEcard
  have hE'L : E' ≤ L :=
    hE'le.trans (sup_le (uc22p21c_barPreimage_le L K₁) (uc22p21c_barPreimage_le L K₂))
  by_contra hnN
  have hnN' : ¬ D.M ≤ Subgroup.normalizer (L : Set G) := by
    intro hle
    exact hnN ((Subgroup.normal_subgroupOf_iff_le_normalizer hC.memL.1.le).2 hle)
  have h4 := UC6S846.calCRankTwice D.M L hC.memL hnN' r hr hr2 hZ E' hE'L hE'el 2 hE'card
  exact hrsig (hSg.four_mem r hr hr2 h4)

theorem not_dvd_card_centOverO2 (D : Data G) (hSg : UC6S846.SigmaStd D)
    {V₀ V L : Subgroup G} {r q : ℕ} (hC : Ctx17_6 D V₀ V L r q)
    (h1 : ¬ P17_12_1 r q L) (h2 : ¬ P17_12_2 q L)
    (hKO1b : K_FunRankTwo) (hKO2 : K_LieOddRankFour) (hKexc : K_G176ExcRankThree)
    (hrsig : r ∉ D.sig) :
    ¬ r ∣ Nat.card (F08.CentOverO2 D.M L) := by
  classical
  obtain ⟨hqr, hexc, hZ⟩ := exceptional_data_of_not_mem_sig D hSg hC h1 h2 hKO2 hrsig
  obtain ⟨hr, hr2, t, n, f, hadm, hq_eq, hm⟩ := hC.lie
  have hqBar : CFSG.Open.IsQuasisimple (Bar2 L) := hC.memL.2.2
  have hL2 : ¬ IsL2Over17 (Bar2 L ⧸ Subgroup.center (Bar2 L)) q := by
    obtain ⟨eBar⟩ := UC22.uc22p21k_barInf_equiv_of_calC hC.memL
    intro hbad
    exact h1 (Or.inl (isL2Over17_of_mulEquiv eBar hbad))
  have hL3 : ¬ IsL3EpsOdd17 (Bar2 L ⧸ Subgroup.center (Bar2 L)) r := by
    obtain ⟨eBar⟩ := UC22.uc22p21k_barInf_equiv_of_calC hC.memL
    intro hbad
    rw [IsL3EpsOdd17] at hbad
    exact h1 (Or.inr (by
      rcases hbad with hbad | hbad
      · exact Or.inl (LieModel.of_mulEquiv eBar.symm hbad)
      · exact Or.inr (LieModel.of_mulEquiv eBar.symm hbad)))
  have hrank : CFSG.Open.pRank r D.M ≤ 3 := by
    by_contra hle
    have h4 : 4 ≤ CFSG.Open.pRank r D.M := by omega
    exact hrsig (hSg.four_mem r hr hr2 h4)
  have hrankBar : CFSG.Open.pRank r (⊤ : Subgroup (Bar2 L)) ≤ 3 := by
    rw [pRank_bar2_eq_of_odd (Y := L) hr hr2]
    exact (CFSG.SectionRank.pRank_mono hr.one_lt hC.memL.1.le).trans hrank
  obtain ⟨⟨E3, hE3el, hE3card⟩, -, -, -⟩ :=
    hKexc (Bar2 L) r hr hr2 hqBar hexc hZ hrankBar
  let π : ↥L →* Bar2 L := QuotientGroup.mk' (CFSG.pCore 2 ↥L)
  have hker : IsPGroup 2 π.ker := by
    rw [show π.ker = CFSG.pCore 2 ↥L by
      simp [π, QuotientGroup.ker_mk']]
    exact CFSG.pCore_isPGroup
  obtain ⟨Q, hQp, hQmap, hQdisj⟩ :=
    UC6S846.exists_lift_pGroup π (QuotientGroup.mk'_surjective _) hker hr hr2 E3
      hE3el.isPGroup
  have hQel : IsElemAbelian r Q :=
    UC6S846.isElemAbelian_of_disjoint_ker π Q hQdisj (by rwa [hQmap])
  have hQcard : Nat.card Q = r ^ 3 := by
    rw [← hE3card, ← hQmap, UC6S846.card_map_of_disjoint_ker π Q hQdisj]
  let E0 : Subgroup G := Q.map L.subtype
  have hE0L : E0 ≤ L := Subgroup.map_subtype_le _
  have hE0el : IsElemAbelian r E0 := hQel.map _
  have hE0card : Nat.card E0 = r ^ 3 := by
    rw [show E0 = Q.map L.subtype from rfl,
      Subgroup.card_map_of_injective L.subtype_injective, hQcard]
  have hE0p : IsPGroup r E0 := hE0el.isPGroup
  have hO2p : IsPGroup 2 (pCoreOf 2 L) := CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 L
  have hO2r : ¬ r ∣ Nat.card (pCoreOf 2 L) := by
    obtain ⟨k, hk⟩ := hO2p.exists_card_eq
    rw [hk]
    intro hdvd
    exact hr2 ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).1 (hr.dvd_of_dvd_pow hdvd))
  have hLnorm : (L.subgroupOf D.M).Normal :=
    normal_of_not_mem_sig D hSg hC h1 h2 hKO1b hKO2 hrsig
  have hMN : D.M ≤ Subgroup.normalizer (L : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hC.memL.1.le).mp hLnorm
  intro hdvd
  obtain ⟨z, hzord⟩ :=
    exists_prime_orderOf_dvd_card' (G := F08.CentOverO2 D.M L) (p := r) (hp := ⟨hr⟩) hdvd
  have hzC : (z : G) ∈ F08.CentOverO2 D.M L := z.2
  have hzM : (z : G) ∈ D.M := (mem_centOverO2_iff.mp hzC).1
  have hzordG : orderOf (z : G) = r := (Subgroup.orderOf_coe z).trans hzord
  have hzpow : (z : G) ^ r = 1 := by
    rw [← hzordG]
    exact pow_orderOf_eq_one _
  have hz1 : (z : G) ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hzordG
    exact hr.ne_one hzordG.symm
  have hzNotL : (z : G) ∉ L := by
    intro hzL
    have hcommL : ∀ l ∈ L, (z : G) * l * (z : G)⁻¹ * l⁻¹ ∈ pCoreOf 2 L :=
      fun l hl => (mem_centOverO2_iff.mp hzC).2 l hl
    have hzcenter : (QuotientGroup.mk ⟨(z : G), hzL⟩ : Bar2 L) ∈ Subgroup.center (Bar2 L) :=
      CFSG.SectionRank.Ccomm.mk_mem_center_iff.mpr fun l =>
        (CFSG.mem_openPCoreOf_iff _).mp (by simpa [commutatorElement_def] using hcommL l l.2)
    have hpowbar : (QuotientGroup.mk ⟨(z : G), hzL⟩ : Bar2 L) ^ r = 1 := by
      have hsub : (⟨(z : G), hzL⟩ : ↥L) ^ r = 1 := Subtype.ext hzpow
      change (QuotientGroup.mk' (CFSG.pCore 2 ↥L) ⟨(z : G), hzL⟩) ^ r = 1
      rw [← map_pow, hsub, map_one]
    have horder_dvd : orderOf (QuotientGroup.mk ⟨(z : G), hzL⟩ : Bar2 L) ∣ r :=
      orderOf_dvd_of_pow_eq_one hpowbar
    have horder_ne : orderOf (QuotientGroup.mk ⟨(z : G), hzL⟩ : Bar2 L) ≠ 1 := by
      intro h1
      have hmk1 : (QuotientGroup.mk ⟨(z : G), hzL⟩ : Bar2 L) = 1 :=
        orderOf_eq_one_iff.mp h1
      have hzp : (⟨(z : G), hzL⟩ : ↥L) ∈ CFSG.pCore 2 ↥L :=
        (QuotientGroup.eq_one_iff _).mp hmk1
      have hzO2 : (z : G) ∈ pCoreOf 2 L := Subgroup.mem_map_of_mem L.subtype hzp
      have hdvdO2 : r ∣ Nat.card (pCoreOf 2 L) := by
        rw [← hzordG]
        exact Subgroup.orderOf_dvd_natCard _ hzO2
      exact hO2r hdvdO2
    have horder : orderOf (QuotientGroup.mk ⟨(z : G), hzL⟩ : Bar2 L) = r := by
      rcases (Nat.dvd_prime hr).mp horder_dvd with h1 | h1
      · exact absurd h1 horder_ne
      · exact h1
    exact hZ (by
      rw [← horder]
      exact Subgroup.orderOf_dvd_natCard _ hzcenter)
  let Z : Subgroup G := Subgroup.zpowers (z : G)
  have hZp : IsPGroup r Z :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hzordG, pow_one])
  have hZC : Z ≤ F08.CentOverO2 D.M L := Subgroup.zpowers_le.mpr hzC
  have hZM : Z ≤ D.M := fun x hx => (mem_centOverO2_iff.mp (hZC hx)).1
  have hZX : Z ≤ Subgroup.normalizer (L : Set G) := hZM.trans hMN
  have hZN : Z ≤ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
    hZX.trans (CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf 2 L)
  have hE0N : E0 ≤ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
    hE0L.trans (Subgroup.le_normalizer.trans
      (CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf 2 L))
  have hcomm : ⁅E0, Z⁆ ≤ pCoreOf 2 L := by
    rw [Subgroup.commutator_comm]
    refine Subgroup.commutator_le.mpr ?_
    intro z' hz' e he
    exact (mem_centOverO2_iff.mp (hZC hz')).2 e (hE0L he)
  obtain ⟨m, hmO2, hmcent⟩ :=
    @CFSG.GroupTheory.exists_map_conj_le_centralizer_of_commutator_le G _ _ r r
      (Fact.mk hr) (Fact.mk hr) (pCoreOf 2 L) E0 Z
      hE0N hZN hE0p hZp hO2r hO2r hcomm
  let E1 : Subgroup G := E0.map (MulAut.conj m).toMonoidHom
  have hE1el : IsElemAbelian r E1 := hE0el.map _
  have hE1card : Nat.card E1 = r ^ 3 := by
    rw [show E1 = E0.map (MulAut.conj m).toMonoidHom from rfl,
      Subgroup.card_map_of_injective (MulAut.conj m).injective, hE0card]
  have hmL : m ∈ L := (CFSG.LieType.BorelTits.pCoreOf_le 2 L) hmO2
  have hE1L : E1 ≤ L := by
    intro x hx
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hx
    exact L.mul_mem (L.mul_mem hmL (hE0L hy)) (L.inv_mem hmL)
  have hE1cent : E1 ≤ Subgroup.centralizer (Z : Set G) := hmcent
  have hZdisjL : Subgroup.zpowers (z : G) ⊓ L = ⊥ :=
    CFSG.zpowers_inf_eq_bot_of_not_mem hr hzpow hz1 hzNotL
  have hZdisjE1 : Disjoint Z E1 := by
    rw [disjoint_iff]
    exact le_bot_iff.mp (by
      calc Z ⊓ E1 ≤ Z ⊓ L := inf_le_inf_left Z hE1L
        _ = ⊥ := hZdisjL)
  have hZel : IsElemAbelian r Z := isElemAbelian_zpowers hzpow
  have hsupcomm : ∀ a ∈ Z, ∀ b ∈ E1, a * b = b * a := by
    intro a ha b hb
    have hb' : b ∈ Subgroup.centralizer (Z : Set G) := hE1cent hb
    exact Subgroup.mem_centralizer_iff.mp hb' a ha
  have hWel : IsElemAbelian r (Z ⊔ E1) :=
    IsElemAbelian.sup_of_commute hZel hE1el hsupcomm
  have hnormal : E1 ≤ Subgroup.normalizer (Z : Set G) :=
    hE1cent.trans (Subgroup.centralizer_le_normalizer (Z : Set G))
  have hWcard : Nat.card ↥(Z ⊔ E1) = r ^ 4 := by
    rw [CFSG.GorensteinWalter.card_sup_eq_mul_of_disjoint_of_le_normalizer
      (A := Z) (B := E1) hnormal hZdisjE1]
    have hZcard : Nat.card ↥Z = r := by
      rw [show Z = Subgroup.zpowers (z : G) from rfl, Nat.card_zpowers, hzordG]
    rw [hZcard, hE1card]
    ring
  have hWleM : Z ⊔ E1 ≤ D.M :=
    sup_le hZM (hE1L.trans hC.memL.1.le)
  have h4 : 4 ≤ CFSG.Open.pRank r D.M := by
    have h := CFSG.SectionRank.le_pRank hr.one_lt hWleM hWel (k := 4) hWcard
    simpa using h
  omega

theorem rSubgroup_le_of_exceptional (D : Data G)
    {V₀ V L : Subgroup G} {r q : ℕ} (hC : Ctx17_6 D V₀ V L r q)
    (hLnorm : (L.subgroupOf D.M).Normal)
    (hCnoR : ¬ r ∣ Nat.card (F08.CentOverO2 D.M L))
    (hOut : ¬ r ∣ Nat.card
      (CFSG.ComponentClassification.OuterAutomorphisms.Outer (Bar2 L))) :
    ∀ S : Subgroup G, S ≤ D.M → IsPGroup r S → S ≤ L := by
  classical
  obtain ⟨hr, hr2, -, -, -, -, -, -⟩ := hC.lie
  have hMN : D.M ≤ Subgroup.normalizer (L : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hC.memL.1.le).mp hLnorm
  let ρ : D.M →* MulAut (Bar2 L) :=
    (UC6S846.rhoL L).comp (Subgroup.inclusion hMN)
  have hCM : F08.CentOverO2 D.M L ≤ D.M :=
    fun x hx => (mem_centOverO2_iff.mp hx).1
  have hCL : F08.CentOverO2 D.M L ≤ Subgroup.normalizer (L : Set G) := hCM.trans hMN
  intro S hSM hSp
  have hSLC : S ≤ L ⊔ F08.CentOverO2 D.M L := by
    intro s hs
    have hsM : s ∈ D.M := hSM hs
    have hinner : ρ ⟨s, hsM⟩ ∈
        CFSG.ComponentClassification.OuterAutomorphisms.inner (Bar2 L) := by
      obtain ⟨k, hk⟩ := @IsPGroup.exists_card_eq r ↥S _ (Fact.mk hr) _ hSp
      have hsord : orderOf (⟨s, hsM⟩ : D.M) ∣ r ^ k := by
        rw [← hk]
        simpa using Subgroup.orderOf_dvd_natCard S hs
      have hαord : orderOf (ρ ⟨s, hsM⟩) ∣ r ^ k :=
        (orderOf_map_dvd ρ ⟨s, hsM⟩).trans hsord
      let β : CFSG.ComponentClassification.OuterAutomorphisms.Outer (Bar2 L) :=
        QuotientGroup.mk (ρ ⟨s, hsM⟩)
      have hβdvd : orderOf β ∣ r ^ k :=
        (orderOf_map_dvd
          (QuotientGroup.mk' (CFSG.ComponentClassification.OuterAutomorphisms.inner
            (Bar2 L))) (ρ ⟨s, hsM⟩)).trans hαord
      have hβnot : ¬ r ∣ orderOf β := fun hdvd =>
        hOut (hdvd.trans (orderOf_dvd_natCard β))
      have hβ1 : orderOf β = 1 := by
        by_contra hne
        obtain ⟨p, hp, hpdvd⟩ := Nat.exists_prime_and_dvd hne
        have hpr : p = r :=
          (Nat.prime_dvd_prime_iff_eq hp hr).1 (hp.dvd_of_dvd_pow (hpdvd.trans hβdvd))
        exact hβnot (hpr ▸ hpdvd)
      have hβeq : β = 1 := orderOf_eq_one_iff.mp hβ1
      exact (QuotientGroup.eq_one_iff (ρ ⟨s, hsM⟩)).mp hβeq
    exact mem_sup_centOverO2_of_mem_inner (M := D.M) (X := L) hC.memL.1.le hMN hinner
  exact CFSG.GroupTheory.le_of_le_sup_of_isPGroup_of_not_dvd_card hr hCL hSp hSLC hCnoR

theorem exists_conj_gamma_le_of_elemAbelian_sq (D : Data G)
    {V₀ V L : Subgroup G} {r q p : ℕ} (hC : Ctx17_6 D V₀ V L r q)
    (hLnorm : (L.subgroupOf D.M).Normal)
    (h76 : CFSG.LocalAnalysis.UniquenessCase.UC22.F07.R76 D)
    (hp : p.Prime) (hp2 : p ≠ 2)
    (hsp : CFSG.RankThree.PartOne.IsStronglyPEmbedded p D.M)
    (P : Subgroup G) (hPM : P ≤ D.M) (hPC : P ≤ F08.CentOverO2 D.M L)
    (hPel : IsElemAbelian p P) (hPrank : 2 ≤ CFSG.Open.pRank p P)
    (E : Subgroup G) (hEL : E ≤ L) (hEel : IsElemAbelian r E)
    (hEcard : Nat.card E = r ^ 2) :
    ∃ (E' : Subgroup G) (n : G), n ∈ L ∧
      E' = E.map (MulAut.conj n).toMonoidHom ∧
      CFSG.Open.rankThreeGamma 1 r E' ≤ D.M := by
  classical
  obtain ⟨hr, hr2, -, -, -, -, -, -⟩ := hC.lie
  have hMN : D.M ≤ Subgroup.normalizer (L : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hC.memL.1.le).mp hLnorm
  have hO2p : IsPGroup 2 (pCoreOf 2 L) := CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 L
  have hO2r : ¬ r ∣ Nat.card (pCoreOf 2 L) := by
    obtain ⟨k, hk⟩ := hO2p.exists_card_eq
    rw [hk]
    intro hdvd
    exact hr2 ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).1 (hr.dvd_of_dvd_pow hdvd))
  have hO2p' : ¬ p ∣ Nat.card (pCoreOf 2 L) := by
    obtain ⟨k, hk⟩ := hO2p.exists_card_eq
    rw [hk]
    intro hdvd
    exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 (hp.dvd_of_dvd_pow hdvd))
  have hL_N : L ≤ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
    Subgroup.le_normalizer.trans
      (CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf 2 L)
  have hE_N : E ≤ Subgroup.normalizer (pCoreOf 2 L : Set G) := hEL.trans hL_N
  have hP_N : P ≤ Subgroup.normalizer (pCoreOf 2 L : Set G) :=
    (hPC.trans (fun x hx => (mem_centOverO2_iff.mp hx).1)).trans hMN |>.trans
      (CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf 2 L)
  have hcomm : ⁅E, P⁆ ≤ pCoreOf 2 L := by
    rw [Subgroup.commutator_comm]
    refine Subgroup.commutator_le.mpr ?_
    intro x hx y hy
    exact (mem_centOverO2_iff.mp (hPC hx)).2 y (hEL hy)
  obtain ⟨n, hnO2, hncent⟩ :=
    @CFSG.GroupTheory.exists_map_conj_le_centralizer_of_commutator_le G _ _ r p
      (Fact.mk hr) (Fact.mk hp) (pCoreOf 2 L) E P
      hE_N hP_N hEel.isPGroup hPel.isPGroup hO2r hO2p' hcomm
  let E' : Subgroup G := E.map (MulAut.conj n).toMonoidHom
  have hE'el : IsElemAbelian r E' := hEel.map _
  have hE'card : Nat.card E' = r ^ 2 := by
    rw [show E' = E.map (MulAut.conj n).toMonoidHom from rfl,
      Subgroup.card_map_of_injective (MulAut.conj n).injective, hEcard]
  have hnL : n ∈ L := (CFSG.LieType.BorelTits.pCoreOf_le 2 L) hnO2
  have hE'L : E' ≤ L := by
    intro x hx
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hx
    exact L.mul_mem (L.mul_mem hnL (hEL hy)) (L.inv_mem hnL)
  have hE'M : E' ≤ D.M := hE'L.trans hC.memL.1.le
  have hE'cent : E' ≤ Subgroup.centralizer (P : Set G) := hncent
  have hPcent : P ≤ Subgroup.centralizer (E' : Set G) := by
    intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    exact (Subgroup.mem_centralizer_iff.mp (hE'cent hy) x hx).symm
  have hPCM : P ≤ D.M ⊓ Subgroup.centralizer (E' : Set G) := fun x hx => ⟨hPM hx, hPcent hx⟩
  have hcen : 0 < CFSG.Open.pRank p (D.M ⊓ Subgroup.centralizer (E' : Set G)) := by
    have hle : 2 ≤ CFSG.Open.pRank p (D.M ⊓ Subgroup.centralizer (E' : Set G)) :=
      hPrank.trans (CFSG.SectionRank.pRank_mono hp.one_lt hPCM)
    omega
  have hNor : ∀ X₀ : Subgroup G, X₀ ≤ E' → Nat.card X₀ = r →
      1 < CFSG.Open.pRank p (D.M ⊓ Subgroup.normalizer (X₀ : Set G)) := by
    intro X₀ hX₀ hcard₀
    have hPCX₀ : P ≤ Subgroup.centralizer (X₀ : Set G) :=
      hPcent.trans (Subgroup.centralizer_le (by
        intro y hy
        exact hX₀ hy))
    have hPN : P ≤ D.M ⊓ Subgroup.normalizer (X₀ : Set G) := fun x hx =>
      ⟨hPM hx, Subgroup.centralizer_le_normalizer (X₀ : Set G) (hPCX₀ hx)⟩
    have hle : 2 ≤ CFSG.Open.pRank p (D.M ⊓ Subgroup.normalizer (X₀ : Set G)) :=
      hPrank.trans (CFSG.SectionRank.pRank_mono hp.one_lt hPN)
    omega
  exact ⟨E', n, hnL, rfl,
    h76 p hp hp2 hsp r hr E' hE'M hE'el hE'card hcen hNor⟩

theorem exists_elemAbelian_sq_le_of_mem_image (L : Subgroup G) {r : ℕ} (hr : r.Prime)
    (hr2 : r ≠ 2) (S : Subgroup G) (hSL : S ≤ L) (hSp : IsPGroup r S)
    (E : Subgroup (Bar2 L)) (hEel : IsElemAbelian r E) (hEcard : Nat.card E = r ^ 2)
    (hEimage : E ≤ (S.subgroupOf L).map (QuotientGroup.mk' (CFSG.pCore 2 ↥L)))
    {x : G} (hxS : x ∈ S)
    (hximage : QuotientGroup.mk (⟨x, hSL hxS⟩ : ↥L) ∈ E) :
    ∃ E' : Subgroup G, E' ≤ S ∧ IsElemAbelian r E' ∧ Nat.card E' = r ^ 2 ∧ x ∈ E' := by
  classical
  let π : ↥L →* Bar2 L := QuotientGroup.mk' (CFSG.pCore 2 ↥L)
  let D : Subgroup ↥L := Subgroup.comap π E ⊓ S.subgroupOf L
  have hDS : D ≤ S.subgroupOf L := inf_le_right
  have hSp' : IsPGroup r (S.subgroupOf L) :=
    hSp.of_equiv (Subgroup.subgroupOfEquivOfLe hSL).symm
  have hDp : IsPGroup r D := hSp'.to_le hDS
  have hDmap : D.map π = E := by
    apply le_antisymm
    · intro e he
      obtain ⟨d, hd, rfl⟩ := Subgroup.mem_map.mp he
      exact hd.1
    · intro e he
      have heS : e ∈ (S.subgroupOf L).map π := hEimage he
      obtain ⟨s, hsS, hse⟩ := Subgroup.mem_map.mp heS
      have hsE : s ∈ E.comap π := by
        rw [Subgroup.mem_comap, hse]
        exact he
      exact Subgroup.mem_map.mpr ⟨s, ⟨hsE, hsS⟩, hse⟩
  have hkerp : IsPGroup 2 π.ker := by
    rw [show π.ker = CFSG.pCore 2 ↥L by
      simp [π, QuotientGroup.ker_mk']]
    exact CFSG.pCore_isPGroup
  have hdisj : Disjoint D π.ker := by
    apply Subgroup.disjoint_of_coprime_natCard
    obtain ⟨a, ha⟩ := @IsPGroup.exists_card_eq r ↥D _ (Fact.mk hr) _ hDp
    obtain ⟨b, hb⟩ := hkerp.exists_card_eq
    rw [ha, hb]
    exact Nat.Coprime.pow _ _ ((Nat.coprime_primes hr Nat.prime_two).2 hr2)
  have hDel : IsElemAbelian r D :=
    UC6S846.isElemAbelian_of_disjoint_ker π D hdisj (by rw [hDmap]; exact hEel)
  have hDcard : Nat.card D = r ^ 2 := by
    rw [← hEcard, ← hDmap, UC6S846.card_map_of_disjoint_ker π D hdisj]
  have hxD : (⟨x, hSL hxS⟩ : ↥L) ∈ D := by
    refine ⟨?_, ?_⟩
    · show π ⟨x, hSL hxS⟩ ∈ E
      exact hximage
    · exact Subgroup.mem_subgroupOf.mpr hxS
  have hE'S : D.map L.subtype ≤ S := by
    intro y hy
    obtain ⟨d, hd, rfl⟩ := Subgroup.mem_map.mp hy
    exact Subgroup.mem_subgroupOf.mp (hDS hd)
  refine ⟨D.map L.subtype, hE'S, hDel.map L.subtype, ?_, ?_⟩
  · rw [Subgroup.card_map_of_injective L.subtype_injective, hDcard]
  · exact Subgroup.mem_map.mpr ⟨⟨x, hSL hxS⟩, hxD, rfl⟩

theorem stronglyPEmbedded_of_exceptional (D : Data G) (hSg : UC6S846.SigmaStd D)
    {V₀ V L : Subgroup G} {r q : ℕ} (hC : Ctx17_6 D V₀ V L r q)
    (h1 : ¬ P17_12_1 r q L) (h2 : ¬ P17_12_2 q L)
    (hKO1b : K_FunRankTwo) (hKO2 : K_LieOddRankFour) (hKexc : K_G176ExcRankThree)
    (h76 : CFSG.LocalAnalysis.UniquenessCase.UC22.F07.R76 D) (hrsig : r ∉ D.sig)
    (p : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) (hpσ : p ∈ D.sig) (hpdvd : ¬ p ∣ r ^ 2 - 1) :
    CFSG.RankThree.PartOne.IsStronglyPEmbedded r D.M := by
  have hOutRank := k_ExceptionalAutPRank_holds
  classical
  obtain ⟨hqr, hexc, hZ⟩ := exceptional_data_of_not_mem_sig D hSg hC h1 h2 hKO2 hrsig
  obtain ⟨hr, hr2, t, n0, f, hadm, hq_eq, hm⟩ := hC.lie
  have hqBar : CFSG.Open.IsQuasisimple (Bar2 L) := hC.memL.2.2
  have hL2 : ¬ IsL2Over17 (Bar2 L ⧸ Subgroup.center (Bar2 L)) q := by
    obtain ⟨eBar⟩ := UC22.uc22p21k_barInf_equiv_of_calC hC.memL
    intro hbad
    exact h1 (Or.inl (isL2Over17_of_mulEquiv eBar hbad))
  have hL3 : ¬ IsL3EpsOdd17 (Bar2 L ⧸ Subgroup.center (Bar2 L)) r := by
    obtain ⟨eBar⟩ := UC22.uc22p21k_barInf_equiv_of_calC hC.memL
    intro hbad
    rw [IsL3EpsOdd17] at hbad
    exact h1 (Or.inr (by
      rcases hbad with hbad | hbad
      · exact Or.inl (LieModel.of_mulEquiv eBar.symm hbad)
      · exact Or.inr (LieModel.of_mulEquiv eBar.symm hbad)))
  have hrank : CFSG.Open.pRank r D.M ≤ 3 := by
    by_contra hle
    have h4 : 4 ≤ CFSG.Open.pRank r D.M := by omega
    exact hrsig (hSg.four_mem r hr hr2 h4)
  have hrankBar : CFSG.Open.pRank r (⊤ : Subgroup (Bar2 L)) ≤ 3 := by
    rw [pRank_bar2_eq_of_odd (Y := L) hr hr2]
    exact (CFSG.SectionRank.pRank_mono hr.one_lt hC.memL.1.le).trans hrank
  have hLnorm : (L.subgroupOf D.M).Normal :=
    normal_of_not_mem_sig D hSg hC h1 h2 hKO1b hKO2 hrsig
  have hMN : D.M ≤ Subgroup.normalizer (L : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hC.memL.1.le).mp hLnorm
  have hCnoR : ¬ r ∣ Nat.card (F08.CentOverO2 D.M L) :=
    not_dvd_card_centOverO2 D hSg hC h1 h2 hKO1b hKO2 hKexc hrsig
  obtain ⟨-, -, -, hOutBar⟩ :=
    hKexc (Bar2 L) r hr hr2 hqBar hexc hZ hrankBar
  have hpr : p ≠ r := fun h => hrsig (h ▸ hpσ)
  have hAut : CFSG.Open.pRank p (⊤ : Subgroup (MulAut (Bar2 L))) ≤ 1 :=
    hOutRank (Bar2 L) r p hr hr2 hp hp2 hpr hqBar hexc hpdvd
  obtain ⟨P, hPM, hPC, hPel, hPrank⟩ :=
    exists_elemAbelian_le_centOverO2 D L hC.memL.1.le hLnorm hp
      (hSg.three_le p hpσ) hAut
  obtain ⟨E3, hE3el, hE3card⟩ := (hKexc (Bar2 L) r hr hr2 hqBar hexc hZ hrankBar).1
  let π : ↥L →* Bar2 L := QuotientGroup.mk' (CFSG.pCore 2 ↥L)
  have hker : IsPGroup 2 π.ker := by
    rw [show π.ker = CFSG.pCore 2 ↥L by
      simp [π, QuotientGroup.ker_mk']]
    exact CFSG.pCore_isPGroup
  obtain ⟨Q3, hQ3p, hQ3map, hQ3disj⟩ :=
    UC6S846.exists_lift_pGroup π (QuotientGroup.mk'_surjective _) hker hr hr2 E3
      hE3el.isPGroup
  let E3L : Subgroup G := Q3.map L.subtype
  have hE3Lle : E3L ≤ L := Subgroup.map_subtype_le _
  have hE3Lel : IsElemAbelian r E3L :=
    (UC6S846.isElemAbelian_of_disjoint_ker π Q3 hQ3disj (by rwa [hQ3map])).map _
  have hE3Lcard : Nat.card E3L = r ^ 3 := by
    rw [show E3L = Q3.map L.subtype from rfl,
      Subgroup.card_map_of_injective L.subtype_injective,
      ← hE3card, ← hQ3map, UC6S846.card_map_of_disjoint_ker π Q3 hQ3disj]
  have hE3Lp : IsPGroup r E3L := hE3Lel.isPGroup
  have hE3Lne : E3L ≠ ⊥ := by
    intro hbot
    have h1card : Nat.card E3L = 1 := by rw [hbot, Subgroup.card_bot]
    rw [hE3Lcard] at h1card
    have h2 := hr.two_le
    have h3 : 1 < r ^ 3 := by
      calc 1 = r ^ 0 := by simp
        _ < r ^ 3 := Nat.pow_lt_pow_right hr.one_lt (by norm_num)
    omega
  obtain ⟨Q', hQ'⟩ :=
    (hE3Lp.comap_subtype (K := D.M)).exists_le_sylow
  let S : Subgroup G := (Q' : Subgroup ↥D.M).map D.M.subtype
  have hS : CFSG.ABGLocalTools.IsSylowOf r S D.M := ⟨Q', rfl⟩
  have hE3S : E3L ≤ S := by
    intro y hy
    exact ⟨⟨y, hE3Lle.trans hC.memL.1.le hy⟩, hQ' hy, rfl⟩
  have hSleL : S ≤ L :=
    rSubgroup_le_of_exceptional D hC hLnorm hCnoR hOutBar S hS.le hS.isPGroup
  have hS_syl_L : CFSG.ABGLocalTools.IsSylowOf r S L := by
    have : Fact r.Prime := ⟨hr⟩
    have h := CFSG.GH74.GLS.Stage2.Signalizer.Ivk8.YCfg.isSylowOf_inf_of_subnormalIn hS
      hC.memL.1.le hC.memL.1.subgroupOf
    rwa [inf_eq_left.mpr hSleL] at h
  obtain ⟨Q, hQmap⟩ := hS_syl_L
  have hQeq : (Q : Subgroup ↥L) = S.subgroupOf L := by
    apply Subgroup.map_injective L.subtype_injective
    rw [hQmap, Subgroup.map_subgroupOf_eq_of_le hSleL]
  let R : Sylow r (Bar2 L) :=
    @Sylow.mapSurjective r (↥L) _ _ (Bar2 L) _ π
      (QuotientGroup.mk'_surjective _) (Fact.mk hr) Q
  have hRcoe : (R : Subgroup (Bar2 L)) = (S.subgroupOf L).map π := by
    rw [@Sylow.coe_mapSurjective r (↥L) _ _ (Bar2 L) _ π
      (QuotientGroup.mk'_surjective _) (Fact.mk hr) Q, hQeq]
  have hO2p : IsPGroup 2 (pCoreOf 2 L) := CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 L
  have hO2r : ¬ r ∣ Nat.card (pCoreOf 2 L) := by
    obtain ⟨k, hk⟩ := hO2p.exists_card_eq
    rw [hk]
    intro hdvd
    exact hr2 ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).1 (hr.dvd_of_dvd_pow hdvd))
  have hO2p' : ¬ p ∣ Nat.card (pCoreOf 2 L) := by
    obtain ⟨k, hk⟩ := hO2p.exists_card_eq
    rw [hk]
    intro hdvd
