      ⟨⟨s.1, hSleL s.2⟩, Subgroup.mem_subgroupOf.mpr s.2, rfl⟩
  let φ : ↥S →* R := f.codRestrict R hfR
  have hφ_inj : Function.Injective φ := by
    intro a b hab
    have hπ : π ⟨a.1, hSleL a.2⟩ = π ⟨b.1, hSleL b.2⟩ := congrArg Subtype.val hab
    have hmem : (⟨b.1, hSleL b.2⟩ : ↥L)⁻¹ * ⟨a.1, hSleL a.2⟩ ∈
        (S.subgroupOf L) ⊓ π.ker := by
      refine ⟨Subgroup.mem_subgroupOf.mpr ?_, ?_⟩
      · exact S.mul_mem (S.inv_mem b.2) a.2
      · change π ((⟨b.1, hSleL b.2⟩ : ↥L)⁻¹ * ⟨a.1, hSleL a.2⟩) = 1
        rw [map_mul, map_inv, hπ, inv_mul_cancel]
    have h1 : (⟨b.1, hSleL b.2⟩ : ↥L)⁻¹ * ⟨a.1, hSleL a.2⟩ = 1 := by
