    ∀ (L : Subgroup G) (r q : ℕ) (hC : Ctx17_6 D V₀ V L r q),
      Gap17_6_O2Rest D V₀ V L r q hC := by
  have hKorder : K_G176FunOrder := K_G176FunOrder_holds
