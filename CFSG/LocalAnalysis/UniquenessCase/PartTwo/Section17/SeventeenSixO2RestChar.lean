    obtain ⟨E'', m, hmL, hE''eq, hgamma⟩ :=
      exists_conj_gamma_le_of_elemAbelian_sq D hC hLnorm h76 hp hp2
        (UC6S846.sp_of_mem_sig hSg (UC6S846.not_solvable_of_mem_calC hC.memL) hpσ)
        P hPM hPC hPel hPrank E' (hE'S.trans hSleL) hE'el hE'card
    have hxmE'' : (MulAut.conj m) x ∈ E'' := by
      rw [hE''eq]
      exact Subgroup.mem_map.mpr ⟨x, hxE', rfl⟩
    have hxord' : orderOf ((MulAut.conj m) x) = r := by
      rw [MulEquiv.orderOf_eq (MulAut.conj m) x, hxord]
    have hcent : Subgroup.centralizer ({(MulAut.conj m) x} : Set G) ≤ D.M :=
      @CFSG.RankThree.PartOne.centralizer_le_of_rankThreeGamma_le G _ _ r
        (Fact.mk hr) E'' D.M hgamma (MulAut.conj m x) hxmE'' hxord'
    have hconj : Subgroup.centralizer ({x} : Set G) ≤ D.M := by
      have h := CFSG.Monster.Existence.centralizer_conj_le_of_mem (M := D.M)
