      (IsPGroup.disjoint_of_ne 31 2 (by norm_num) A (CFSG.Open.pCoreOf 2 L) hA31 hO2).eq_bot
    rwa [hdisj] at hsub
  have hcent : (A ⊓ L) ≤ Subgroup.centralizer ((A ⊓ K : Subgroup G) : Set G) :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp hJbot
  have hcommA₁A₂ : ∀ u ∈ A ⊓ L, ∀ v ∈ A ⊓ K, u * v = v * u := by
    intro u hu v hv
    exact (Subgroup.mem_centralizer_iff.mp (hcent hu) v hv).symm
  have hcardSup : Nat.card ↥((A ⊓ L) ⊔ (A ⊓ K)) = 31 ^ 2 := by
    have h := (CFSG.GroupTheory.card_sup_mul_card_inf_of_commute
      (A ⊓ L) (A ⊓ K) hcommA₁A₂).1
    rw [hinf, hA₁card, hA₂card, Subgroup.card_bot] at h
    simpa using h
  have hAeq : (A ⊓ L) ⊔ (A ⊓ K) = A := by
    refine Subgroup.eq_of_le_of_card_ge (sup_le hA₁le hA₂le) ?_
    rw [hAcard, hcardSup]
  have hA₁ab : IsMulCommutative ↥(A ⊓ L) :=
    (isCyclic_of_prime_card (p := 31) hA₁card).isMulCommutative
  have hA₂ab : IsMulCommutative ↥(A ⊓ K) :=
    (isCyclic_of_prime_card (p := 31) hA₂card).isMulCommutative
  have hsupab : IsMulCommutative ↥((A ⊓ L) ⊔ (A ⊓ K)) :=
    isMulCommutative_sup_of_elementwise_commute hcommA₁A₂ hA₁ab hA₂ab
  have hAab : IsMulCommutative ↥A := by
    rw [← hAeq]
    exact hsupab
  have hBcard5 : Nat.card ↥B = 5 := hp5
  have hBA : B ≤ Subgroup.normalizer (A : Set G) := by
    rw [Subgroup.le_normalizer_iff_commutator_le_left, hAB]
  have hBodd : ∀ b ∈ B, Odd (orderOf b) := by
    intro b hb
    have hdvd : orderOf b ∣ 5 := by
      rw [← hBcard5]; exact Subgroup.orderOf_dvd_natCard B hb
    rcases (Nat.dvd_prime (by norm_num : Nat.Prime 5)).mp hdvd with h | h
    · rw [h]; norm_num
    · rw [h]; norm_num
  have hc2 : (conjSetOf D.M L).ncard = 2 := by
    rw [← hset]
    exact Set.ncard_pair hLKne
  have hc2K : (conjSetOf D.M K).ncard = 2 := by
    rw [uc22p2214_conjSetOf_eq hKconj, hc2]
  have hBL : B ≤ Subgroup.normalizer (L : Set G) := by
    intro b hb
    exact uc22p2214_mem_normalizer_of_odd hc2 (hBM hb) (hBodd b hb)
  have hBK : B ≤ Subgroup.normalizer (K : Set G) := by
    intro b hb
    exact uc22p2214_mem_normalizer_of_odd hc2K (hBM hb) (hBodd b hb)
  have hBn₁ : B ≤ Subgroup.normalizer ((A ⊓ L : Subgroup G) : Set G) := by
    intro b hb
    rw [Subgroup.mem_normalizer_iff]
    intro y
    constructor
    · intro hy
      exact Subgroup.mem_inf.mpr
        ⟨(Subgroup.mem_normalizer_iff.mp (hBA hb) y).mp hy.1,
          (Subgroup.mem_normalizer_iff.mp (hBL hb) y).mp hy.2⟩
    · intro hy
      exact Subgroup.mem_inf.mpr
        ⟨(Subgroup.mem_normalizer_iff.mp (hBA hb) y).mpr hy.1,
          (Subgroup.mem_normalizer_iff.mp (hBL hb) y).mpr hy.2⟩
  have hBn₂ : B ≤ Subgroup.normalizer ((A ⊓ K : Subgroup G) : Set G) := by
    intro b hb
    rw [Subgroup.mem_normalizer_iff]
    intro y
    constructor
    · intro hy
      exact Subgroup.mem_inf.mpr
        ⟨(Subgroup.mem_normalizer_iff.mp (hBA hb) y).mp hy.1,
          (Subgroup.mem_normalizer_iff.mp (hBK hb) y).mp hy.2⟩
    · intro hy
      exact Subgroup.mem_inf.mpr
        ⟨(Subgroup.mem_normalizer_iff.mp (hBA hb) y).mpr hy.1,
          (Subgroup.mem_normalizer_iff.mp (hBK hb) y).mpr hy.2⟩
  have hcop : Nat.Coprime (Nat.card ↥B) (Nat.card ↥A) := by
    rw [hBcard5, hAcard]; norm_num
  have hcentBot : A ⊓ Subgroup.centralizer (B : Set G) = ⊥ := by
    have h := CFSG.RankThree.Coprime.commutator_inf_centralizer_eq_bot
      (B := B) (K := A)
      (fun x hx y hy => congrArg Subtype.val (hAab.is_comm.comm ⟨x, hx⟩ ⟨y, hy⟩)) hBA hcop
    rwa [Subgroup.commutator_comm, hAB] at h
  refine ⟨hA₁card, hA₂card, hcent, hinf, hBcard5, hBn₁, hBn₂, hAeq, ?_⟩
  intro b hb hb1 a ha hab
  have hord : orderOf b = 5 := by
    have hdvd : orderOf b ∣ 5 := by
      rw [← hBcard5]; exact Subgroup.orderOf_dvd_natCard B hb
    rcases (Nat.dvd_prime (by norm_num : Nat.Prime 5)).mp hdvd with h | h
    · exact absurd h (by intro h1; exact hb1 (orderOf_eq_one_iff.mp h1))
    · exact h
  have hgen : Subgroup.zpowers b = B := by
    refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hb) ?_
    rw [Nat.card_zpowers, hord, hBcard5]
  have haA : a ∈ A := by rwa [hAeq] at ha
  have haC : a ∈ Subgroup.centralizer (B : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro c hc
    have hc' : c ∈ Subgroup.zpowers b := by rwa [hgen]
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hc'
    exact (Commute.zpow_right (show Commute a b from hab) k).eq.symm
  have hmem : a ∈ A ⊓ Subgroup.centralizer (B : Set G) := ⟨haA, haC⟩
  rw [hcentBot] at hmem
  exact Subgroup.mem_bot.mp hmem


end CFSG.LocalAnalysis.UniquenessCase.PartTwo.S17.SzFive
