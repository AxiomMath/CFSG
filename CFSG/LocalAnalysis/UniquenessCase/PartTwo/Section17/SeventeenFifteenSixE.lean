theorem s1715six_wSub_le_centralizer {D : Data G} {V L : Subgroup G} (h : Hyp125 D ⊥ V)
    (hL : L ∈ calC D.M)
    (hcompL : ∀ m ∈ D.M, barSub ⊥ V h.isElemAbelian (conjSubgroup L m) =
      barSub ⊥ V h.isElemAbelian L → conjSubgroup L m = L)
    (h2 : ∀ g ∈ Mbar D.M ⊥ V h.isElemAbelian, g ∉ normIn (Mbar D.M ⊥ V h.isElemAbelian)
      (barSub ⊥ V h.isElemAbelian L) →
      commSub (commSub ⊤ (barSub ⊥ V h.isElemAbelian L))
        ((barSub ⊥ V h.isElemAbelian L).map (MulAut.conj g).toMonoidHom) = ⊥)
    {x : G} (hx : x ∈ D.M) (hxN : x ∉ normalizer (L : Set G)) :
    wSub ⊥ V h.isElemAbelian L ≤ centralizer ((conjSubgroup L x : Subgroup G) : Set G) := by
  classical
  have hV := h.isElemAbelian
  have hLM : L ≤ D.M := CFSG.Quasithin.A3.subnormal_le hL.1
  have hMs : D.M ≤ stabTil ⊥ V :=
    le_stabTil h.pairFacts.le_normalizer (by
      rw [Subgroup.normalizer_eq_top]
      exact le_top)
  have hxs : x ∈ stabTil ⊥ V := hMs hx
  have hxL : conjSubgroup L x ≠ L := fun hh =>
    hxN (conjSubgroup_eq_iff_mem_normalizer.mp hh)
  have hxbar : barSub ⊥ V hV (conjSubgroup L x) ≠ barSub ⊥ V hV L :=
    fun hh => hxL (hcompL x hx hh)
  have hxbarN : (actTil ⊥ V hV ⟨x, hxs⟩)⁻¹ ∉
      normIn (Mbar D.M ⊥ V hV) (barSub ⊥ V hV L) := by
    rw [normIn, Subgroup.mem_inf]
    rintro ⟨-, hnorm⟩
    apply hxbar
    have hmap := (Subgroup.mem_normalizer_iff_map_conj_eq).1 hnorm
    exact (s15_Infra_barSub_conjSubgroup ⊥ V hV hxs L).trans hmap
  have h2x := h2 ((actTil ⊥ V hV ⟨x, hxs⟩)⁻¹)
    ((Mbar D.M ⊥ V hV).inv_mem (actTil_mem_barSub ⊥ V hV hx hxs)) hxbarN
  have hcomm : commSub (wTil ⊥ V hV L) (barSub ⊥ V hV (conjSubgroup L x)) = ⊥ := by
    rw [s15_Infra_barSub_conjSubgroup ⊥ V hV hxs L]
    simpa [wTil] using h2x
  have hfixW : wTil ⊥ V hV L ≤ fixV (barSub ⊥ V hV (conjSubgroup L x)) :=
    commSub_eq_bot_iff.mp hcomm
  have hLxM : conjSubgroup L x ≤ D.M := by
    intro l hl
    rw [mem_conjSubgroup_iff] at hl
    have hl' : l = x⁻¹ * (x * l * x⁻¹) * x := by group
    rw [hl']
    exact D.M.mul_mem (D.M.mul_mem (D.M.inv_mem hx) (hLM hl)) hx
  intro w hw
  rw [Subgroup.mem_centralizer_iff]
  intro l hl
  have hwV : w ∈ V := preTil_le ⊥ V hV _ hw
  have hwW : mkTil ⊥ V hV (IntMod.mk hV ⟨w, hwV⟩) ∈ wTil ⊥ V hV L :=
    (mem_preTil_iff_of_mem ⊥ V hV _ hwV).1 hw
  have hlM : l ∈ D.M := hLxM hl
  have hls : l ∈ stabTil ⊥ V := hMs hlM
  have hfixl : actTil ⊥ V hV ⟨l, hls⟩ (mkTil ⊥ V hV (IntMod.mk hV ⟨w, hwV⟩)) =
      mkTil ⊥ V hV (IntMod.mk hV ⟨w, hwV⟩) :=
    (mem_fixV.1 (hfixW hwW)) _ (actTil_mem_barSub ⊥ V hV hl hls)
  rw [actTil_mk, mkTil_eq_iff, actStab_apply_val, Subgroup.mem_bot] at hfixl
  have hfixl' : l * w * l⁻¹ * w⁻¹ = 1 := hfixl
  have h1 : l * w * l⁻¹ = w := by
    calc l * w * l⁻¹ = (l * w * l⁻¹ * w⁻¹) * w := by group
      _ = w := by rw [hfixl', one_mul]
  calc l * w = (l * w * l⁻¹) * l := by group
    _ = w * l := by rw [h1]

theorem s1715six_hyp151 {D : Data G} {V L : Subgroup G} (h : Hyp125 D ⊥ V)
    (hL : L ∈ calC D.M) (hLb : barSub ⊥ V h.isElemAbelian L ≠ ⊥)
    (h2 : ∀ g ∈ Mbar D.M ⊥ V h.isElemAbelian, g ∉ normIn (Mbar D.M ⊥ V h.isElemAbelian)
      (barSub ⊥ V h.isElemAbelian L) →
      commSub (commSub ⊤ (barSub ⊥ V h.isElemAbelian L))
        ((barSub ⊥ V h.isElemAbelian L).map (MulAut.conj g).toMonoidHom) = ⊥) :
    Hyp151 D ⊥ V L := by
  classical
  have hV := h.isElemAbelian
  have hLM : L ≤ D.M := CFSG.Quasithin.A3.subnormal_le hL.1
  have hMs : D.M ≤ stabTil ⊥ V :=
    le_stabTil h.pairFacts.le_normalizer (by
      rw [Subgroup.normalizer_eq_top]
      exact le_top)
  have hLstab : L ≤ stabTil ⊥ V := hLM.trans hMs
  have hLbar : barSub ⊥ V hV L ∈ compBar D.M ⊥ V hV ∨ barSub ⊥ V hV L = ⊥ := by
    by_cases hb : barSub ⊥ V hV L = ⊥
    · exact Or.inr hb
    · exact Or.inl (barSub_mem_compBar_of_ne_bot h hL hb)
  refine ⟨h, hLM, ?_, ?_, ?_⟩
  · exact CFSG.Quasithin.S151S4.twoResidual_eq_self_of_perfect hL.2.1
  · rcases hLbar with hc | hb
    · exact fstar_eq_self_of_isQuasisimple hc.2.2
    · rw [hb]
      exact le_bot_iff.1 (Subgroup.map_subtype_le _)
  · intro g hgM hgn
    have hgs : g ∈ stabTil ⊥ V := hMs hgM
    have hLgne : barSub ⊥ V hV (conjSubgroup L g) ≠ barSub ⊥ V hV L := by
      intro heq
      exact hgn ((s15_Infra_mem_nBar_iff h hV hgM).2 heq)
    have hLgcal : conjSubgroup L g ∈ calC D.M :=
      uc22p22u_calC_conj (X := D.M) (M := D.M) (K := L) Subgroup.le_normalizer hL
        (m := g) hgM
    have hneL : conjSubgroup L g ≠ L := by
      intro heq
      exact hLgne (by rw [heq])
    have hLgM : conjSubgroup L g ≤ D.M := by
      intro x hx
      rw [mem_conjSubgroup_iff] at hx
      have hx' : x = g⁻¹ * (g * x * g⁻¹) * g := by group
      rw [hx']
      exact D.M.mul_mem (D.M.mul_mem (D.M.inv_mem hgM) (hLM hx)) hgM
    have hLgstab : conjSubgroup L g ≤ stabTil ⊥ V := hLgM.trans hMs
    have hcommG : ⁅barSub ⊥ V hV L, barSub ⊥ V hV (conjSubgroup L g)⁆ = ⊥ := by
      have hle : ⁅L, conjSubgroup L g⁆ ≤ pCoreOf 2 L :=
        (calC_commutator_le_of_ne hL hLgcal hneL.symm).trans inf_le_left
      have hbotL : barSub ⊥ V hV (pCoreOf 2 L) = ⊥ :=
        TwelveTwentyThree.barSub_pCoreOf_eq_bot_of_isSubnormal hV hL.1
          (barSub_pCoreOf_eq_bot_of_hyp125 h)
      have hmap : barSub ⊥ V hV ⁅L, conjSubgroup L g⁆ = ⊥ :=
        le_bot_iff.1 (hbotL ▸ barSub_mono ⊥ V hV hle)
      have hlebar := S18.commutator_barSub_le (V₀ := ⊥) (V := V) hV hLstab hLgstab
      exact le_bot_iff.1 (hmap ▸ hlebar)
    refine ⟨hcommG, ?_⟩
    have hxbarN : (actTil ⊥ V hV ⟨g, hgs⟩)⁻¹ ∉
        normIn (Mbar D.M ⊥ V hV) (barSub ⊥ V hV L) := by
      rw [normIn, Subgroup.mem_inf]
      rintro ⟨-, hnorm⟩
      apply hLgne
      have hmap := (Subgroup.mem_normalizer_iff_map_conj_eq).1 hnorm
      exact (s15_Infra_barSub_conjSubgroup ⊥ V hV hgs L).trans hmap
    have h2g := h2 ((actTil ⊥ V hV ⟨g, hgs⟩)⁻¹)
      ((Mbar D.M ⊥ V hV).inv_mem (actTil_mem_barSub ⊥ V hV hgM hgs)) hxbarN
    rw [s15_Infra_barSub_conjSubgroup ⊥ V hV hgs L]
    simpa [wTil] using h2g

theorem s1715six_v1Sub_eq_bot {D : Data G} {V L : Subgroup G} (h : Hyp125 D ⊥ V)
    (hL : L ∈ calC D.M)
    (hcompL : ∀ m ∈ D.M, barSub ⊥ V h.isElemAbelian (conjSubgroup L m) =
      barSub ⊥ V h.isElemAbelian L → conjSubgroup L m = L)
    (h2 : ∀ g ∈ Mbar D.M ⊥ V h.isElemAbelian, g ∉ normIn (Mbar D.M ⊥ V h.isElemAbelian)
      (barSub ⊥ V h.isElemAbelian L) →
      commSub (commSub ⊤ (barSub ⊥ V h.isElemAbelian L))
        ((barSub ⊥ V h.isElemAbelian L).map (MulAut.conj g).toMonoidHom) = ⊥)
    (hcent : V ⊓ centralizer ((UC22.conjClosure D.M L : Subgroup G) : Set G) = ⊥) :
    v1Sub D.M ⊥ V h.isElemAbelian L = ⊥ := by
  classical
  have hV := h.isElemAbelian
  have hLM : L ≤ D.M := CFSG.Quasithin.A3.subnormal_le hL.1
  have hMs : D.M ≤ stabTil ⊥ V :=
    le_stabTil h.pairFacts.le_normalizer (by
      rw [Subgroup.normalizer_eq_top]
      exact le_top)
  have hWCL : wSub ⊥ V hV L ⊓ centralizer (L : Set G) = ⊥ := by
    rw [eq_bot_iff]
    intro a ha
    have haW : a ∈ wSub ⊥ V hV L := ha.1
    have haC : a ∈ centralizer (L : Set G) := ha.2
    have haV : a ∈ V := preTil_le ⊥ V hV _ haW
    have hsub : UC22.conjClosure D.M L ≤ centralizer ({a} : Set G) := by
      refine iSup₂_le fun K hK => ?_
      obtain ⟨g, hgM, rfl⟩ := hK
      have hKeq : L.map (MulAut.conj g).toMonoidHom = conjSubgroup L g⁻¹ := by
        unfold conjSubgroup
        rw [inv_inv]
      rw [hKeq]
      by_cases hxN : g⁻¹ ∈ normalizer (L : Set G)
      · rw [conjSubgroup_eq_iff_mem_normalizer.mpr hxN]
        intro l hl
        rw [Subgroup.mem_centralizer_singleton_iff]
        exact Subgroup.mem_centralizer_iff.mp haC l hl
      · intro l hl
        rw [Subgroup.mem_centralizer_singleton_iff]
        exact Subgroup.mem_centralizer_iff.mp
          (s1715six_wSub_le_centralizer h hL hcompL h2 (D.M.inv_mem hgM) hxN haW) l hl
    have haCc : a ∈ centralizer (UC22.conjClosure D.M L : Set G) := by
      rw [Subgroup.mem_centralizer_iff]
      intro k hk
      exact Subgroup.mem_centralizer_singleton_iff.mp (hsub hk)
    have hmem : a ∈ V ⊓ centralizer (UC22.conjClosure D.M L : Set G) := ⟨haV, haCc⟩
    rw [hcent] at hmem
    exact Subgroup.mem_bot.mp hmem
  rw [v1Sub_of_eq_bot D.M ⊥ V hV L rfl]
  simp [hWCL, E3.conjSubgroup_bot]

theorem s1715six_exists_not_normalizer {D : Data G} {V L : Subgroup G} (h : Hyp125 D ⊥ V)
    (hL : L ∈ calC D.M) (hLb : barSub ⊥ V h.isElemAbelian L ≠ ⊥)
    (h2 : ∀ g ∈ Mbar D.M ⊥ V h.isElemAbelian, g ∉ normIn (Mbar D.M ⊥ V h.isElemAbelian)
      (barSub ⊥ V h.isElemAbelian L) →
      commSub (commSub ⊤ (barSub ⊥ V h.isElemAbelian L))
        ((barSub ⊥ V h.isElemAbelian L).map (MulAut.conj g).toMonoidHom) = ⊥)
    (hbasic : IsBasicModule (Mbar D.M ⊥ V h.isElemAbelian))
    (hsimple : IsSimpleGroup ↥(barSub ⊥ V h.isElemAbelian L))
    (hfix : fixV (barSub ⊥ V h.isElemAbelian (UC22.conjClosure D.M L)) = ⊥)
    (hW : wTil ⊥ V h.isElemAbelian L ≠ ⊤) :
    ∃ x ∈ D.M, x ∉ normalizer (L : Set G) := by
  classical
  have h151 : Hyp151 D ⊥ V L := s1715six_hyp151 h hL hLb h2
  by_contra hcon
  push Not at hcon
  have hV := h.isElemAbelian
  have hLM : L ≤ D.M := CFSG.Quasithin.A3.subnormal_le hL.1
  have hMN : D.M ≤ normalizer (L : Set G) := hcon
  have hMs : D.M ≤ stabTil ⊥ V :=
    le_stabTil h.pairFacts.le_normalizer (by
      rw [Subgroup.normalizer_eq_top]
      exact le_top)
  have hLnormalM : (L.subgroupOf D.M).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hLM).2 hMN
  have hconj : UC22.conjClosure D.M L = L :=
    uc22p2214_conjClosure_eq_of_normal hLM hLnormalM
  have hfixL : fixV (barSub ⊥ V hV L) = ⊥ := by
    simpa [hconj] using hfix
  let Lb : Subgroup (MulAut (Vtil ⊥ V hV)) := barSub ⊥ V hV L
  let Mb : Subgroup (MulAut (Vtil ⊥ V hV)) := Mbar D.M ⊥ V hV
  let W : Subgroup (Vtil ⊥ V hV) := wTil ⊥ V hV L
  have hLbM : Lb ≤ Mb := barSub_mono ⊥ V hV hLM
  have hLnormal : (Lb.subgroupOf Mb).Normal :=
    barSub_subgroupOf_mbar_normal hV hLM hMN
  have hstabL : StableUnder Lb W := by
    intro x hx u hu
    exact CFSG.Quasithin.Asc81c.commSub_stable' hx (by simpa [W, wTil] using hu)
  have hstable : StableUnder Mb W := by
    intro φ hφ u hu
    obtain ⟨m, hmM, rfl⟩ := (mem_barSub ⊥ V hV D.M φ).1 hφ
    have hLm : conjSubgroup L (m : G) = L :=
      conjSubgroup_eq_iff_mem_normalizer.mpr (hMN hmM)
    have h1 : W = W.map ((actTil ⊥ V hV m)⁻¹).toMonoidHom := by
      simpa [W, wTil, hLm] using s15_Infra_wTil_conjSubgroup ⊥ V L hV m.2
    have hff : (actTil ⊥ V hV m).toMonoidHom.comp ((actTil ⊥ V hV m)⁻¹).toMonoidHom =
        MonoidHom.id (Vtil ⊥ V hV) := by
      ext x
      simp
    have h2 : W.map (actTil ⊥ V hV m).toMonoidHom = W := by
      conv_lhs => rw [h1]
      rw [Subgroup.map_map, hff, Subgroup.map_id]
    exact h2 ▸ Subgroup.mem_map_of_mem _ hu
  have hLbstab : Lb ≤ stabSub W := by
    intro x hx
    rw [mem_stabSub]
    intro u
    constructor
    · intro hu
      have hxinv : x⁻¹ ∈ Lb := Lb.inv_mem hx
      have h := hstabL x⁻¹ hxinv (x u) hu
      simpa using h
    · intro hu
      exact hstabL x hx u hu
  have hne : ¬ Lb ≤ centSub W := by
    intro hle
    have hcommW : commSub W Lb = ⊥ := by
      rw [commSub_eq_bot_iff]
      intro u hu x hx
      exact mem_centSub.mp (hle hx) u hu
    have hWcomm : commSub W Lb = W := by
      have h := s15_Core_commSub_wTil_conj h151 (m := (1 : G)) D.M.one_mem
      rw [conjSubgroup_one] at h
      simpa [W, wTil] using h
    have hWbot : W = ⊥ := by rw [← hWcomm, hcommW]
    have hLbbot : Lb = ⊥ := by
      apply s15_Lin_eq_bot_of_commSub_top_eq_bot (W := Vtil ⊥ V hV)
      simpa [Lb, W, wTil] using hWbot
    exact hLb hLbbot
  have hfaithL : Lb ⊓ centSub W = ⊥ :=
    CFSG.Quasithin.inf_centSub_eq_bot_of_isSimpleGroup hsimple hLbstab hne
  have hfaithful : ∀ y ∈ Mb, (∀ u ∈ W, y u = u) → y = 1 := by
    intro y hy hyfix
    have hycomm : ∀ l ∈ Lb, y * l = l * y := by
      intro l hl
      have hyl : y * l * y⁻¹ * l⁻¹ ∈ Lb := by
        have h1 : (⟨y, hy⟩ : ↥Mb) * ⟨l, hLbM hl⟩ * (⟨y, hy⟩ : ↥Mb)⁻¹ ∈
            Lb.subgroupOf Mb :=
          hLnormal.conj_mem ⟨l, hLbM hl⟩ (Subgroup.mem_subgroupOf.mpr hl) ⟨y, hy⟩
        have h1' : y * l * y⁻¹ ∈ Lb := Subgroup.mem_subgroupOf.mp h1
        exact Lb.mul_mem h1' (Lb.inv_mem hl)
      have hfixc : ∀ u ∈ W, (y * l * y⁻¹ * l⁻¹) u = u := by
        intro u hu
        have hlu : l⁻¹ u ∈ W := hstabL l⁻¹ (Lb.inv_mem hl) u hu
        have hy1 : y⁻¹ (l⁻¹ u) = l⁻¹ u := by
          apply y.injective
          rw [MulAut.apply_inv_self, hyfix (l⁻¹ u) hlu]
        have hyu : y u = u := hyfix u hu
        show y (l (y⁻¹ (l⁻¹ u))) = u
        rw [hy1]
        simp [hyu]
      have hc : y * l * y⁻¹ * l⁻¹ ∈ Lb ⊓ centSub W :=
        ⟨hyl, mem_centSub.mpr hfixc⟩
      rw [hfaithL, Subgroup.mem_bot] at hc
      calc y * l = (y * l * y⁻¹ * l⁻¹) * (l * y) := by group
        _ = l * y := by rw [hc, one_mul]
    ext v
    show y v = v
    have hmem : y v * v⁻¹ ∈ fixV Lb := by
      rw [mem_fixV]
      intro l hl
      have hlv : l v * v⁻¹ ∈ W := by
        change l v * v⁻¹ ∈ commSub ⊤ Lb
        exact Subgroup.subset_closure ⟨l, hl, v, trivial, rfl⟩
      have h1 : y (l v * v⁻¹) = l v * v⁻¹ := hyfix _ hlv
      have h2 : y (l v) = l (y v) := by
        simpa [MulAut.mul_apply] using
          congrArg (fun f : MulAut (Vtil ⊥ V hV) => f v) (hycomm l hl)
      have h3 : y (l v) = (l v * v⁻¹) * y v := by
        have h4 : y (l v) * (y v)⁻¹ = l v * v⁻¹ := by
          simpa [map_mul, map_inv] using h1
        calc y (l v) = (y (l v) * (y v)⁻¹) * y v := by group
          _ = (l v * v⁻¹) * y v := by rw [h4]
      calc l (y v * v⁻¹) = l (y v) * (l v)⁻¹ := by rw [map_mul, map_inv]
        _ = y (l v) * (l v)⁻¹ := by rw [← h2]
        _ = ((l v * v⁻¹) * y v) * (l v)⁻¹ := by rw [h3]
        _ = y v * v⁻¹ := by
          calc ((l v * v⁻¹) * y v) * (l v)⁻¹
              = (l v * (l v)⁻¹) * (v⁻¹ * y v) := by ac_rfl
            _ = v⁻¹ * y v := by rw [mul_inv_cancel, one_mul]
            _ = y v * v⁻¹ := by rw [mul_comm]
    rw [hfixL] at hmem
    have h1 : y v * v⁻¹ = 1 := Subgroup.mem_bot.mp hmem
    calc y v = (y v * v⁻¹) * v := by group
      _ = v := by rw [h1, one_mul]
  exact hW (hbasic.2 W hstable hfaithful)

theorem s1715six_cent_wSub_conj {D : Data G} {V L : Subgroup G} (hV : IsElemAbelian 2 V)
    (hE0 : ∀ y ∈ D.M, y ∉ normalizer (L : Set G) →
      wSub ⊥ V hV L ≤ Subgroup.centralizer (conjSubgroup L y : Set G))
    {x m : G} (hxM : x ∈ D.M) (hmM : m ∈ D.M)
    (hne : conjSubgroup L x ≠ conjSubgroup L m) :
    conjSubgroup (wSub ⊥ V hV L) m ≤
      Subgroup.centralizer (conjSubgroup L x : Set G) := by
  classical
  let y : G := x * m⁻¹
  have hyM : y ∈ D.M := D.M.mul_mem hxM (D.M.inv_mem hmM)
  have hyx : y * m = x := by simp [y, mul_assoc]
  have hyN : y ∉ normalizer (L : Set G) := by
    intro hyN
    apply hne
    have hyL : conjSubgroup L y = L := conjSubgroup_eq_iff_mem_normalizer.mpr hyN
    have h1 : conjSubgroup (conjSubgroup L y) m = conjSubgroup L (y * m) :=
      conjSubgroup_conjSubgroup L y m
    rw [hyL, hyx] at h1
    exact h1.symm
  calc conjSubgroup (wSub ⊥ V hV L) m
      ≤ conjSubgroup (Subgroup.centralizer (conjSubgroup L y : Set G)) m :=
        E3.conjSubgroup_mono_left m (hE0 y hyM hyN)
    _ = Subgroup.centralizer (conjSubgroup (conjSubgroup L y) m : Set G) :=
        E3.conjSubgroup_centralizer _ _
    _ = Subgroup.centralizer (conjSubgroup L x : Set G) := by
        rw [conjSubgroup_conjSubgroup, hyx]

theorem s1715six_hyp154 {D : Data G} (h1217 : R1217 D) {V L : Subgroup G}
    (h : Hyp125 D ⊥ V) (hL : L ∈ calC D.M) (hUL : UniqueMax D.M L)
    (hLb : barSub ⊥ V h.isElemAbelian L ≠ ⊥)
    (hcompL : ∀ m ∈ D.M, barSub ⊥ V h.isElemAbelian (conjSubgroup L m) =
      barSub ⊥ V h.isElemAbelian L → conjSubgroup L m = L)
    (h2 : ∀ g ∈ Mbar D.M ⊥ V h.isElemAbelian, g ∉ normIn (Mbar D.M ⊥ V h.isElemAbelian)
      (barSub ⊥ V h.isElemAbelian L) →
      commSub (commSub ⊤ (barSub ⊥ V h.isElemAbelian L))
        ((barSub ⊥ V h.isElemAbelian L).map (MulAut.conj g).toMonoidHom) = ⊥)
    (hfix : fixV (barSub ⊥ V h.isElemAbelian (UC22.conjClosure D.M L)) = ⊥)
    (hcent : V ⊓ centralizer ((UC22.conjClosure D.M L : Subgroup G) : Set G) = ⊥)
    (htwo : ∀ x₀ ∈ D.M, x₀ ∉ normalizer (L : Set G) → ∀ m ∈ D.M,
      conjSubgroup L m = L ∨ conjSubgroup L m = conjSubgroup L x₀)
    (hbasic : IsBasicModule (Mbar D.M ⊥ V h.isElemAbelian))
    (hsimple : IsSimpleGroup ↥(barSub ⊥ V h.isElemAbelian L))
    (hW : wTil ⊥ V h.isElemAbelian L ≠ ⊤) :
    Hyp154 D ⊥ V L := by
  classical
  have hV := h.isElemAbelian
  have hMs : D.M ≤ stabTil ⊥ V :=
    le_stabTil h.pairFacts.le_normalizer (by
      rw [Subgroup.normalizer_eq_top]
      exact le_top)
  have h151 : Hyp151 D ⊥ V L := s1715six_hyp151 h hL hLb h2
  obtain ⟨x, hxM, hxN⟩ :=
    s1715six_exists_not_normalizer h hL hLb h2 hbasic hsimple hfix hW
  have hLxM : conjSubgroup L x ≤ D.M := by
    intro l hl
    rw [mem_conjSubgroup_iff] at hl
    have hl' : l = x⁻¹ * (x * l * x⁻¹) * x := by group
    rw [hl']
    exact D.M.mul_mem (D.M.mul_mem (D.M.inv_mem hxM)
      (CFSG.Quasithin.A3.subnormal_le hL.1 hl)) hxM
  have hULx : UniqueMax D.M (conjSubgroup L x) := by
    have h := uniqueMax_conjSubgroup hUL x
    rwa [s15_Tools_conjSubgroup_M D hxM] at h
  have hWC : wSub ⊥ V hV L ≤ centralizer (conjSubgroup L x : Set G) :=
    s1715six_wSub_le_centralizer h hL hcompL h2 hxM hxN
  have hV1 : v1Sub D.M ⊥ V hV L = ⊥ := s1715six_v1Sub_eq_bot h hL hcompL h2 hcent
  refine ⟨h151, ?_, ?_, ?_⟩
  · intro w hw hw1
    rw [hV1, sup_bot_eq] at hw
    refine uc22p22u_uniqueMax_mono D ?_ inf_le_left hULx
    refine le_inf hLxM ?_
    intro l hl
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact Subgroup.mem_centralizer_iff.mp (hWC hw) l hl
  · intro x' hx'M y' hy'M _ w hw hw1
    rw [hV1, bot_sup_eq] at hw
    have hS : (⨆ X ∈ {X | X ∈ wConj D.M ⊥ V hV L ∧
        X ≠ conjSubgroup (wSub ⊥ V hV L) x' ∧
        X ≠ conjSubgroup (wSub ⊥ V hV L) y'}, X) ≤
        centralizer (conjSubgroup L x' : Set G) := by
      refine iSup_le fun X => iSup_le fun hX => ?_
      obtain ⟨m, hmM, rfl⟩ := hX.1
      have hne : conjSubgroup L x' ≠ conjSubgroup L m := by
        intro heq
        apply hX.2.1
        rw [← s15_Infra_wSub_conjSubgroup ⊥ V L hV (hMs hmM),
          ← s15_Infra_wSub_conjSubgroup ⊥ V L hV (hMs hx'M), heq]
      exact s1715six_cent_wSub_conj hV
        (fun y hy hyN => s1715six_wSub_le_centralizer h hL hcompL h2 hy hyN)
        hx'M hmM hne
    have hULx' : UniqueMax D.M (conjSubgroup L x') := by
      have h := uniqueMax_conjSubgroup hUL x'
      rwa [s15_Tools_conjSubgroup_M D hx'M] at h
    have hLx'M : conjSubgroup L x' ≤ D.M := by
      intro l hl
      rw [mem_conjSubgroup_iff] at hl
      have hl' : l = x'⁻¹ * (x' * l * x'⁻¹) * x' := by group
      rw [hl']
      exact D.M.mul_mem (D.M.mul_mem (D.M.inv_mem hx'M)
        (CFSG.Quasithin.A3.subnormal_le hL.1 hl)) hx'M
    refine uc22p22u_uniqueMax_mono D ?_ inf_le_left hULx'
    refine le_inf hLx'M ?_
    intro l hl
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact Subgroup.mem_centralizer_iff.mp (hS hw) l hl
  · intro g hgM X hX Y hY hXY hne
    have hs2 : s15 D.M ⊥ V hV L = 2 := by
      have hge : 2 ≤ s15 D.M ⊥ V hV L := by
        rw [← ncard_wConj D h151 hV]
        have hsub : ({X, Y} : Set (Subgroup G)) ⊆ wConj D.M ⊥ V hV L := by
          intro Z hZ
          rcases Set.mem_insert_iff.mp hZ with rfl | hZ'
          · exact hX
          · rw [Set.mem_singleton_iff.mp hZ']
            exact hY
        calc 2 = ({X, Y} : Set (Subgroup G)).ncard := (Set.ncard_pair hXY).symm
          _ ≤ (wConj D.M ⊥ V hV L).ncard := Set.ncard_le_ncard hsub
      have hle : s15 D.M ⊥ V hV L ≤ 2 := by
        rw [s15_Core_s15_eq_ncard_range h151]
        have hne' : barSub ⊥ V hV L ≠ barSub ⊥ V hV (conjSubgroup L x) := by
          intro heq
          exact hxN (conjSubgroup_eq_iff_mem_normalizer.mp (hcompL x hxM heq.symm))
        have hsub : (Set.range fun m : D.M =>
            barSub ⊥ V hV (conjSubgroup L (m : G))) ⊆
            ({barSub ⊥ V hV L, barSub ⊥ V hV (conjSubgroup L x)} :
              Set (Subgroup (MulAut (Vtil ⊥ V hV)))) := by
          rintro _ ⟨m, rfl⟩
          change barSub ⊥ V hV (conjSubgroup L (m : G)) ∈
            ({barSub ⊥ V hV L, barSub ⊥ V hV (conjSubgroup L x)} :
              Set (Subgroup (MulAut (Vtil ⊥ V hV))))
          rcases htwo x hxM hxN m m.2 with hm | hm
          · rw [hm]
            exact Set.mem_insert_iff.mpr (Or.inl rfl)
          · rw [hm]
            exact Set.mem_insert_iff.mpr (Or.inr rfl)
        calc (Set.range fun m : D.M => barSub ⊥ V hV (conjSubgroup L (m : G))).ncard
            ≤ ({barSub ⊥ V hV L, barSub ⊥ V hV (conjSubgroup L x)} :
                Set (Subgroup (MulAut (Vtil ⊥ V hV)))).ncard :=
              Set.ncard_le_ncard hsub
          _ = 2 := Set.ncard_pair hne'
      omega
    have hdelta : delta15 D.M ⊥ V hV L = 0 := by
      rw [delta15, hV1, bot_inf_eq]
      simp [mSub, rk]
    have hcomp := barSub_mem_compBar_of_ne_bot h hL hLb
    have hqC : CFSG.IsQuasisimple ↥(barSub ⊥ V hV L) :=
      CFSG.Quasithin.A3.isQuasisimple_iff_open.mpr hcomp.2.2
    have hsolv : ¬ Group.IsSolvable ↥(barSub ⊥ V hV L) := by
      intro hs
      have : Nontrivial ↥(barSub ⊥ V hV L) := (Subgroup.nontrivial_iff_ne_bot _).mpr hLb
      have : Group.IsPerfect ↥(barSub ⊥ V hV L) := hqC.1
      exact Group.IsPerfect.not_isSolvable _ hs
    have hγ := three_le_gamma15_of_not_solvable D h1217 h151 hsolv
    refine ⟨hs2, ?_⟩
    omega

