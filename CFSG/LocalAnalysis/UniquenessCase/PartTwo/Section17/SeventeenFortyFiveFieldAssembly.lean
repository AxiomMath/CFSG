theorem false_of_nonabComponent_field_linear_unitary
    (X : Type) [Group X] [Finite X] (L B ML : Subgroup X) (hLn : L.Normal)
    (hCL : centralizer (L : Set X) = ⊥) (hB5 : Nat.card B = 5) (hBL : ¬ B ≤ L)
    (hML : ML ≤ L) (hMLne : ML ≠ L) (hNB : L ⊓ normalizer (B : Set X) ≤ ML)
    (hC6 : 5 ∣ Nat.card L → CFSG.RankThree.PartOne.IsStronglyPEmbedded 5 (ML.subgroupOf L))
    (t : StatedLieTag) (n p f : ℕ) (ht : t = .PSL ∨ t = .PSU) (hn : 5 ≤ n)
    (hp : p.Prime) (hp2 : p ≠ 2) (hadm : StatedLieAdmissible t n p f) (hL : LieModel L t n p f)
    (hq5 : p ^ f % 5 = 2 ∨ p ^ f % 5 = 3) : False := by
  obtain ⟨θ, hθ, hout, hfix⟩ := exists_mulAut_of_not_le L B ML hCL hB5 hBL hNB
  have hM : ML.subgroupOf L ≠ ⊤ := fun h =>
    hMLne (le_antisymm hML (Subgroup.subgroupOf_eq_top.mp h))
  have hcent : ∀ x ∈ ML.subgroupOf L, orderOf x = 5 → ∀ g : L, Commute g x →
      g ∈ ML.subgroupOf L := fun x hx hx5 g hg =>
    mem_of_commute_of_isStronglyPEmbedded (by norm_num)
      (hC6 (hx5 ▸ orderOf_dvd_natCard x)) hx hx5 hg
  rcases ht with rfl | rfl
  · exact false_of_fieldAut_five_psl hp hn hadm hL hq5 θ hθ hout _ hM hfix hcent
  · exact false_of_fieldAut_five_psu hp hp2 hn hL hq5 θ hθ hout _ hM hfix hcent

@[expose] def Gap17_45_PhaseReduction : Prop :=
  ∀ (X : Type) [Group X] [Finite X] (L A₁ A₂ B T ML : Subgroup X),
    L.Normal → IsSimpleGroup L → ¬ IsMulCommutative L → CFSG.Open.IsKGroup L →
    centralizer (L : Set X) = ⊥ →
    Nat.card A₁ = 31 → Nat.card A₂ = 31 → A₁ ⊓ A₂ = ⊥ →
    A₁ ≤ centralizer (A₂ : Set X) →
    Nat.card B = 5 → B ≤ normalizer (A₁ : Set X) → B ≤ normalizer (A₂ : Set X) →
    ⁅A₁ ⊔ A₂, B⁆ = A₁ ⊔ A₂ →
    (∀ D : Subgroup X, D ≤ A₁ ⊔ A₂ → Nat.card D = 31 → B ≤ normalizer (D : Set X) →
      D = A₁ ∨ D = A₂) →
    IsPGroup 2 T →
    ((A₁ ⊔ A₂ : Subgroup X) : Set X) * (T : Set X) =
      (T : Set X) * ((A₁ ⊔ A₂ : Subgroup X) : Set X) →
    (B : Set X) * (T : Set X) = (T : Set X) * (B : Set X) →
    CFSG.ABGLocalTools.IsSylowOf 2 (T ⊓ L) L →
    ML ≤ L → ML ≠ L → T ⊓ L ≤ ML →
    (∀ C : Subgroup X, IsMulCommutative C → (A₁ ≤ C ∨ A₂ ≤ C ∨ B ≤ C) →
      L ⊓ normalizer (C : Set X) ≤ ML) →
    (5 ∣ Nat.card L → CFSG.RankThree.PartOne.IsStronglyPEmbedded 5 (ML.subgroupOf L)) →
    ∃ (t : StatedLieTag) (n p f : ℕ), (t = .PSL ∨ t = .PSU) ∧ 5 ≤ n ∧ p.Prime ∧ p ≠ 2 ∧
      p ≠ 5 ∧ StatedLieAdmissible t n p f ∧ LieModel L t n p f ∧ CFSG.Open.pRank 5 L ≤ 1


theorem gap17_45_nonabComponent_of_phaseReduction (hPR : Gap17_45_PhaseReduction) :
    Gap17_45_NonabComponent := by
  intro X _ _ L A₁ A₂ B T ML hLn hLs hLnab hLK hCL hA1 hA2 hA12 hA12c hB5 hBA1 hBA2 hcomm
    hlines hT hAT hBT hTL hML hMLne hTML hC5 hC6
  obtain ⟨t, n, p, f, ht, hn, hp, hp2, hp5, hadm, hL, h5⟩ := hPR X L A₁ A₂ B T ML hLn hLs
    hLnab hLK hCL hA1 hA2 hA12 hA12c hB5 hBA1 hBA2 hcomm hlines hT hAT hBT hTL hML hMLne hTML
    hC5 hC6
  by_cases hBL : B ≤ L
  · exact false_of_nonabComponent_inner_linear_unitary X L B T hLs hB5 hBT hTL hBL t n p f ht
      hn hp hp2 hp5 hadm hL h5
  · have hBab : IsMulCommutative B := by
      have : IsCyclic B := isCyclic_of_prime_card (p := 5) (hp := ⟨by norm_num⟩) hB5
      exact ⟨⟨IsCyclic.commGroup.mul_comm⟩⟩
    haveI : IsSimpleGroup L := hLs
    have h5' : CFSG.Open.pRank 5 (⊤ : Subgroup L) ≤ 1 := by
      rw [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup]
      exact h5
    have hq5 := pmod_five_of_pRank_five_le_one ht hn hp hp5 hadm hL h5'
    exact false_of_nonabComponent_field_linear_unitary X L B ML hLn hCL hB5 hBL hML hMLne
      (hC5 B hBab (Or.inr (Or.inr le_rfl))) hC6 t n p f ht hn hp hp2 hadm hL hq5

end CFSG.LocalAnalysis.UniquenessCase.PartTwo.S17.SzFive
