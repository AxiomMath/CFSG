theorem eq_one_or_three_of_dvd_twelve_of_odd {n : ℕ} (h : n ∣ 12) (ho : Odd n) :
    n = 1 ∨ n = 3 := by
  have hle : n ≤ 12 := Nat.le_of_dvd (by norm_num) h
  have hpos : 0 < n := Nat.pos_of_dvd_of_pos h (by norm_num)
  interval_cases n <;> simp_all [Nat.odd_iff]

theorem isMathieu_of_isSpor {X : Type} [Group X] {s : TauCeti.SporadicName}
    (hs : s = .M11 ∨ s = .M12 ∨ s = .M22 ∨ s = .M23 ∨ s = .M24) (h : IsSpor X s) :
    F08.IsMathieu X := by
  rcases hs with rfl | rfl | rfl | rfl | rfl
  exacts [Or.inl h, Or.inr (Or.inl h), Or.inr (Or.inr (Or.inl h)),
    Or.inr (Or.inr (Or.inr (Or.inl h))), Or.inr (Or.inr (Or.inr (Or.inr h)))]

theorem list880_of_isSpor {X : Type} [Group X] {s : TauCeti.SporadicName}
    (hs : s = .J2 ∨ s = .HS ∨ s = .Ru ∨ s = .J4) (h : IsSpor X s) : F08.List880 X := by
  rcases hs with rfl | rfl | rfl | rfl
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr (Or.inl h))
  · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))

theorem list880_of_isMathieu {X : Type} [Group X] (h : F08.IsMathieu X) : F08.List880 X :=
  Or.inl h

theorem list880_of_isM22Z3 {X : Type} [Group X] (h : F08.IsM22Z3 X) : F08.List880 X :=
  Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))

private theorem card_center_eq_one_of_multiplierRow {X : Type} [Group X] [Finite X]
    {s : TauCeti.SporadicName} (hK : CFSG.IsQuasisimple X)
    (e : X ⧸ Subgroup.center X ≃* CFSG.Blueprint.NativeSporadic.Carrier s)
    (hrow : Nat.card (CFSG.RankThree.PerfectCover.hopfMultiplier
        (CFSG.Blueprint.NativeSporadic.Carrier s)) =
        CFSG.RankThree.PartTwo.Sec4.Census.sporadicMultiplierOrder s)
    (hm : CFSG.RankThree.PartTwo.Sec4.Census.sporadicMultiplierOrder s = 1 ∨
      CFSG.RankThree.PartTwo.Sec4.Census.sporadicMultiplierOrder s = 2)
    (ho : Odd (Nat.card (Subgroup.center X))) :
    Nat.card (Subgroup.center X) = 1 := by
  have h : Nat.card (Subgroup.center X) ∣
      CFSG.RankThree.PartTwo.Sec4.Census.sporadicMultiplierOrder s := by
    have h := CFSG.GH74.Generic.card_center_dvd_hopfMultiplier hK e
    rwa [hrow] at h
  rcases hm with h1 | h2
  · rw [h1] at h; exact Nat.dvd_one.mp h
  · rw [h2] at h
    exact CFSG.ComponentClassification.RankTwoAlt.eq_one_of_dvd_two_of_odd h ho

section Multipliers
theorem sporadicCover880 :
    ∀ (X : Type) [Group X] [Finite X], CFSG.Open.IsQuasisimple X → CFSG.pCore 2 X = ⊥ →
      ∀ s : TauCeti.SporadicName,
        (s = .M11 ∨ s = .M12 ∨ s = .M22 ∨ s = .M23 ∨ s = .M24 ∨ s = .J2 ∨ s = .HS ∨
          s = .He ∨ s = .Ru ∨ s = .J4) →
        Nonempty (X ⧸ Subgroup.center X ≃* CFSG.Blueprint.NativeSporadic.Carrier s) →
        F08.List880 X ∨ IsSpor X .He := by
  intro X _ _ hq hpc s hslist ⟨e⟩
  have hK : CFSG.IsQuasisimple X :=
    CFSG.HardMathSupport.Solomon.Coordinator.YS08.isQuasisimple_native_of_open hq
  have hodd : Odd (Nat.card (Subgroup.center X)) :=
    CFSG.CGT.Timmesfeld75.odd_card_center fun _ hN hp =>
      le_bot_iff.1 (hpc ▸ CFSG.LieType.BorelTits.le_pCore 2 hN hp)
  rcases hslist with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · have hZ : Subgroup.center X = ⊥ :=
      Subgroup.eq_bot_of_card_eq _ <|
        card_center_eq_one_of_multiplierRow hK e CFSG.RankThree.PartTwo.Sec4.Census.Karpilovsky.Coordinator.nativeRow_M11 (Or.inl rfl) hodd
    exact Or.inl (list880_of_isMathieu (isMathieu_of_isSpor (Or.inl rfl)
      (isSpor_of_center_eq_bot e hZ)))
  · have hZ : Subgroup.center X = ⊥ :=
      Subgroup.eq_bot_of_card_eq _ <|
        card_center_eq_one_of_multiplierRow hK e CFSG.RankThree.PartTwo.Sec4.Census.Karpilovsky.Coordinator.nativeRow_M12 (Or.inr rfl) hodd
    exact Or.inl (list880_of_isMathieu (isMathieu_of_isSpor (Or.inr (Or.inl rfl))
      (isSpor_of_center_eq_bot e hZ)))
  ·
    have hdvd : Nat.card (Subgroup.center X) ∣
        CFSG.RankThree.PartTwo.Sec4.Census.sporadicMultiplierOrder .M22 := by
      have h := CFSG.GH74.Generic.card_center_dvd_hopfMultiplier hK e
      rwa [CFSG.RankThree.PartTwo.Sec4.Census.Karpilovsky.Coordinator.nativeRow_M22] at h
    have h13 : Nat.card (Subgroup.center X) = 1 ∨ Nat.card (Subgroup.center X) = 3 := by
      rw [show CFSG.RankThree.PartTwo.Sec4.Census.sporadicMultiplierOrder .M22 = 12 from rfl]
        at hdvd
      exact eq_one_or_three_of_dvd_twelve_of_odd hdvd hodd
    rcases h13 with h1 | h3
    · refine Or.inl (list880_of_isMathieu ?_)
      exact isMathieu_of_isSpor (Or.inr (Or.inr (Or.inl rfl)))
        (isSpor_of_center_eq_bot e (Subgroup.eq_bot_of_card_eq _ h1))
    · exact Or.inl (list880_of_isM22Z3 ⟨hK, h3, ⟨e⟩⟩)
  · have hZ : Subgroup.center X = ⊥ :=
      Subgroup.eq_bot_of_card_eq _ <|
        card_center_eq_one_of_multiplierRow hK e CFSG.RankThree.PartTwo.Sec4.Census.Karpilovsky.Coordinator.nativeRow_M23 (Or.inl rfl) hodd
    exact Or.inl (list880_of_isMathieu
      (isMathieu_of_isSpor (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
        (isSpor_of_center_eq_bot e hZ)))
  · have hZ : Subgroup.center X = ⊥ :=
      Subgroup.eq_bot_of_card_eq _ <|
        card_center_eq_one_of_multiplierRow hK e CFSG.RankThree.PartTwo.Sec4.Census.Karpilovsky.Coordinator.nativeRow_M24 (Or.inl rfl) hodd
    exact Or.inl (list880_of_isMathieu
      (isMathieu_of_isSpor (Or.inr (Or.inr (Or.inr (Or.inr rfl))))
        (isSpor_of_center_eq_bot e hZ)))
  · have hZ : Subgroup.center X = ⊥ :=
      Subgroup.eq_bot_of_card_eq _ <|
        card_center_eq_one_of_multiplierRow hK e CFSG.RankThree.PartTwo.Sec4.Census.Karpilovsky.Coordinator.nativeRow_J2 (Or.inr rfl) hodd
    exact Or.inl (list880_of_isSpor (Or.inl rfl) (isSpor_of_center_eq_bot e hZ))
  · have hZ : Subgroup.center X = ⊥ :=
      Subgroup.eq_bot_of_card_eq _ <|
        card_center_eq_one_of_multiplierRow hK e CFSG.RankThree.PartTwo.Sec4.Census.Karpilovsky.Coordinator.nativeRow_HS (Or.inr rfl) hodd
    exact Or.inl (list880_of_isSpor (Or.inr (Or.inl rfl)) (isSpor_of_center_eq_bot e hZ))
  · have hZ : Subgroup.center X = ⊥ :=
      Subgroup.eq_bot_of_card_eq _ <|
        card_center_eq_one_of_multiplierRow hK e CFSG.RankThree.PartTwo.Sec4.Census.Karpilovsky.Coordinator.nativeRow_He (Or.inl rfl) hodd
    exact Or.inr (isSpor_of_center_eq_bot e hZ)
  · have hZ : Subgroup.center X = ⊥ :=
      Subgroup.eq_bot_of_card_eq _ <|
        card_center_eq_one_of_multiplierRow hK e CFSG.RankThree.PartTwo.Sec4.Census.Karpilovsky.Coordinator.nativeRow_Ru (Or.inr rfl) hodd
    exact Or.inl (list880_of_isSpor (Or.inr (Or.inr (Or.inl rfl))) (isSpor_of_center_eq_bot e hZ))
  · have hZ : Subgroup.center X = ⊥ :=
      Subgroup.eq_bot_of_card_eq _ <|
        card_center_eq_one_of_multiplierRow hK e CFSG.RankThree.PartTwo.Sec4.Census.Karpilovsky.Coordinator.nativeRow_J4 (Or.inl rfl) hodd
    exact Or.inl (list880_of_isSpor (Or.inr (Or.inr (Or.inr rfl))) (isSpor_of_center_eq_bot e hZ))

