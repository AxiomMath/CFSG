theorem seventeen_twentytwo (D : Data G) (V₀ V : Subgroup G) (hV : Hyp125 D V₀ V)
    (h17_20 : R17_20At D V₀ V) (h17_21 : R17_21At D V₀ V)
    (h880 : F08.R880 D) :
    R17_22At D V₀ V := by
  intro L P Z c hP hZ
  have hk : D.k = 2 := h17_21 L c
  have hns : ¬ CFSG.RankThree.PartOne.IsStronglyPEmbedded 3 D.M := (Data.k_eq_two_iff D).1 hk
  obtain ⟨-, hLsub, s, hslist, hspor⟩ := h17_20 L c
  have hLM : L ≤ D.M := CFSG.Quasithin.A3.subnormal_le c.mem_calC.1
  have hq : CFSG.Open.IsQuasisimple (Bar2 L) := c.mem_calC.2.2
  have hpc : CFSG.pCore 2 (Bar2 L) = ⊥ := CFSG.ABGLocalTools.pCore_quotient_pCore_eq_bot
  obtain ⟨eBar⟩ := uc22p21k_barInf_equiv_of_calC (M := D.M) c.mem_calC
  obtain ⟨eSpor⟩ := hspor
  rcases sporadicCover880 (Bar2 L) hq hpc s hslist ⟨eBar.symm.trans eSpor⟩ with hList | hHe
  · obtain ⟨Q, hQ⟩ := CFSG.ABGLocalTools.exists_isSylowOf 3 D.M
    obtain ⟨hJ2, ⟨hsig, -⟩, hQleL, hGammaQ, hZQ, hSolv⟩ :=
      h880 L c.mem_calC hList hns Q hQ
    have hQ_L : CFSG.ABGLocalTools.IsSylowOf 3 Q L := hQ.of_le hQleL hLM
    obtain ⟨k, hkL, hconj⟩ := CFSG.ABGLocalTools.IsSylowOf.exists_mem_conj hP hQ_L
    have hkM : k ∈ D.M := hLM hkL
    have hPk : P.map (MulAut.conj k).toMonoidHom = Q := by
      ext x
      rw [CFSG.ClassicalInvolution.mem_map_conj_iff]
      exact (hconj x).symm
    have hPb : P = Q.map (MulAut.conj k⁻¹).toMonoidHom := by
      calc P = (P.map (MulAut.conj k).toMonoidHom).map (MulAut.conj k⁻¹).toMonoidHom :=
            (CFSG.Quasithin.MS93.map_conj_inv_map_conj P k).symm
        _ = Q.map (MulAut.conj k⁻¹).toMonoidHom := by rw [hPk]
    have hZc : Z = (centerOf Q).map (MulAut.conj k⁻¹).toMonoidHom := by
      rw [hZ, hPb, CFSG.Quasithin.SBc2.centerOf_map_conj]
    have hZQ' : centerOf Q ∈ CFSG.LocalAnalysis.RankThreeUC.uniqueSet D.M := hZQ
    have hZU : Z ∈ CFSG.LocalAnalysis.RankThreeUC.uniqueSet D.M := by
      rw [hZc]
      exact conj_mem_uniqueSet hZQ' (D.M.inv_mem hkM)
