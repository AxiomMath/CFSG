theorem mem_centSection_iff {M A B : Subgroup G} {x : G} :
    x ∈ centSection M A B ↔ x ∈ M ∧ x ∈ normalizer (A : Set G) ∧
      x ∈ normalizer (B : Set G) ∧ ∀ a ∈ A, x * a * x⁻¹ * a⁻¹ ∈ B := Iff.rfl

theorem centOverO2_eq_centSection {M L : Subgroup G} :
    F08.CentOverO2 M L = centSection M L (CFSG.Open.pCoreOf 2 L) := by
  have hQL : CFSG.Open.pCoreOf 2 L ≤ L := CFSG.LieType.BorelTits.pCoreOf_le 2 L
  ext x
  constructor
  · intro hx
    obtain ⟨hxM, hxL⟩ := mem_centOverO2_iff.1 hx
    have hxN : x ∈ normalizer (L : Set G) := by
      rw [CFSG.LocalAnalysis.UniquenessCase.UC6S846.mem_normalizer_iff_map_conj]
      apply Subgroup.eq_of_le_of_card_ge
      · rw [Subgroup.map_le_iff_le_comap]
        intro l hl
        rw [Subgroup.mem_comap]
        have hmem : (MulAut.conj x).toMonoidHom l = (x * l * x⁻¹ * l⁻¹) * l := by
          simp [MulAut.conj_apply, mul_assoc]
        rw [hmem]
        exact L.mul_mem (hQL (hxL l hl)) hl
      · rw [Subgroup.card_map_of_injective (MulAut.conj x).injective]
    have hxNQ : x ∈ normalizer ((CFSG.Open.pCoreOf 2 L : Subgroup G) : Set G) :=
      CFSG.LieType.BorelTits.normalizer_le_normalizer_pCoreOf 2 L hxN
    exact mem_centSection_iff.2 ⟨hxM, hxN, hxNQ, hxL⟩
  · rintro hx
    obtain ⟨hxM, -, -, hxL⟩ := mem_centSection_iff.1 hx
    exact mem_centOverO2_iff.2 ⟨hxM, hxL⟩

