theorem s1715six_prime_sq_dvd {p c : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hc : c ∣ 20160)
    (hdvd : p ^ 2 ∣ 168 * c) : p = 3 ∨ (p = 7 ∧ 7 ∣ c) := by
  have hdvd' : p ^ 2 ∣ 168 * 20160 := hdvd.trans (mul_dvd_mul_left 168 hc)
  have hpdvd : p ∣ 168 * 20160 :=
    (dvd_pow_self p (by norm_num : 2 ≠ 0)).trans hdvd'
  have hfac : 168 * 20160 = 2 ^ 9 * 3 ^ 3 * 5 * 7 ^ 2 := by norm_num
  rw [hfac] at hpdvd
  rcases (Nat.Prime.dvd_mul hp).1 hpdvd with h | h7sq
  · rcases (Nat.Prime.dvd_mul hp).1 h with h | h5
    · rcases (Nat.Prime.dvd_mul hp).1 h with h | h3
      · exact absurd ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1
          (Nat.Prime.dvd_of_dvd_pow hp h)) hp2
      · exact Or.inl ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).1
          (Nat.Prime.dvd_of_dvd_pow hp h3))
    · have hp5 : p = 5 :=
        (Nat.prime_dvd_prime_iff_eq hp (by norm_num : Nat.Prime 5)).1 h5
      exfalso
      subst hp5
      have h25 : 25 ∣ 168 * c := by
        have h1 : (5 : ℕ) ^ 2 = 25 := by norm_num
        rwa [h1] at hdvd
      have h25c : 25 ∣ c := (show Nat.Coprime 25 168 by norm_num).dvd_of_dvd_mul_left h25
      have : 25 ∣ 20160 := h25c.trans hc
      norm_num at this
  · have hp7 : p = 7 :=
      (Nat.prime_dvd_prime_iff_eq hp Nat.prime_seven).1 (Nat.Prime.dvd_of_dvd_pow hp h7sq)
    refine Or.inr ⟨hp7, ?_⟩
    subst hp7
    have h49 : 7 * 7 ∣ 7 * (24 * c) := by
      have heq : 7 * (24 * c) = 168 * c := by ring
      rw [heq]
      simpa [show (7 * 7 : ℕ) = 7 ^ 2 by norm_num] using hdvd
    have h7c : 7 ∣ 24 * c := (Nat.mul_dvd_mul_iff_left (by norm_num : 0 < 7)).mp h49
    exact (show Nat.Coprime 7 24 by norm_num).dvd_of_dvd_mul_left h7c

