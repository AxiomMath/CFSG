theorem sylowAutBoundAll_thirtyOne_split
    {τ : Tag} (hτ : τ = .G2 ∨ τ = .D4 ∨ τ = .F4)
    {K : Type} [Field K] [Finite K] (hK : 31 ∣ Nat.card K - 1) :
    CFSG.Quasithin.KGC31.SylowAutBoundAll 31 (Nat.card (WeylGroup τ)) (adjointGroup τ K) := by
  classical
  have : Fact (Nat.Prime 31) := ⟨by norm_num⟩
  have : Finite (ModGL τ K) := finite_modGL
  have hunits : 31 ∣ Nat.card Kˣ := by
    rw [Nat.card_units]
    exact hK
  obtain ⟨ζ, hζ⟩ := exists_prime_orderOf_dvd_card' (G := Kˣ) 31 hunits
  have hζ31 : ζ ^ 31 = 1 := by
    rw [← hζ]
    exact pow_orderOf_eq_one ζ
  have hW : ¬ 31 ∣ Nat.card (WeylGroup τ) := by
    rcases hτ with rfl | rfl | rfl
    · rw [CFSG.RankThree.PartOne.K133H.card_weylGroup_G2]
      norm_num
    · exact CFSG.RankThree.PartOne.KGD.not_dvd_card_weylGroup_D4 (by norm_num) (by norm_num)
    · rw [CFSG.RankThree.PartOne.K133H.card_weylGroup_F4]
      norm_num
  refine CFSG.Quasithin.KGC31.SylowAutBoundAll.of_abelian_index
    (D := (torusGroup τ K).subgroupOf (adjointGroup τ K)) ?_ ?_ ?_
  · intro a ha c hc
    exact Subtype.ext ((triangular_borel_structure.{0, 0} τ K).1 _
      (Subgroup.mem_subgroupOf.1 ha) _ (Subgroup.mem_subgroupOf.1 hc))
  · exact CFSG.LocalAnalysis.RankFourTheoremC.crossExc_not_dvd_index_torusGroup (p := 31)
      (by norm_num) hW hK
  intro P hPD u hu
  let C : Subgroup (ModGL τ K) := adjointGroup τ K
  let Ht : Subgroup (ModGL τ K) := torusGroup τ K
  let V : Subgroup (ModGL τ K) := (P : Subgroup C).map C.subtype
  have hVH : (V : Set (ModGL τ K)) ⊆ Ht := by
    rintro x hx
    obtain ⟨p, hp, rfl⟩ := Subgroup.mem_map.1 hx
    exact Subgroup.mem_subgroupOf.1 (hPD hp)
  have hTcomm : ∀ a ∈ Ht, ∀ b ∈ Ht, a * b = b * a :=
    fun a ha b hb => (triangular_borel_structure.{0, 0} τ K).1 a ha b hb
  have hDCcomm : ∀ a ∈ Ht.subgroupOf C, ∀ b ∈ Ht.subgroupOf C, a * b = b * a := by
    intro a ha b hb
    exact Subtype.ext (hTcomm a (Subgroup.mem_subgroupOf.1 ha) b
      (Subgroup.mem_subgroupOf.1 hb))
  have hCV : C ⊓ Subgroup.centralizer (V : Set (ModGL τ K)) = Ht := by
    refine le_antisymm ?_ (le_inf ?_ ?_)
    · intro y hy
      obtain ⟨hyC, hyV⟩ := Subgroup.mem_inf.1 hy
      have hc : ∀ t : Fin τ.rank → ZMod 31,
          y * rootDiagUnit τ (TableBExc.E6Three.zetaVec ζ hζ31 t) =
            rootDiagUnit τ (TableBExc.E6Three.zetaVec ζ hζ31 t) * y := by
        intro t
        set a : Fin τ.rank → Kˣ := TableBExc.E6Three.zetaVec ζ hζ31 t with ha
        have hd_adj : rootDiagUnit τ a ∈ C := by
          rcases hτ with rfl | rfl | rfl
          · exact CFSG.StandardType.RecipeExcLang.rootDiagUnit_mem_adjointGroup_of_det_one
              (Or.inl rfl) a
          · have hsq : ∃ b : Fin Tag.D4.rank → Kˣ, a = b ^ 2 := by
              have hsq' : ∀ j, ∃ b : Kˣ, a j = b ^ 2 := by
                intro j
                refine ⟨a j ^ 16, ?_⟩
                have h31 : a j ^ 31 = 1 := by
                  rw [ha, TableBExc.E6Three.zetaVec_apply, ← pow_mul, Nat.mul_comm,
                    pow_mul, hζ31, one_pow]
                rw [← pow_mul, show 16 * 2 = 31 + 1 by norm_num, pow_succ, h31, one_mul]
              choose b hb using hsq'
              exact ⟨b, funext hb⟩
            obtain ⟨b, hb⟩ := hsq
            rw [hb]
            exact CFSG.HardMathSupport.Lang.D4Three.rootDiagUnit_sq_mem_adjointGroup_D4 b
          · exact CFSG.StandardType.RecipeExcLang.rootDiagUnit_mem_adjointGroup_of_det_one
              (Or.inr (Or.inl rfl)) a
        have hd_H : rootDiagUnit τ a ∈ Ht :=
          CFSG.SeitzReduction.E6Pilot.rootDiagUnit_mem_torusGroup_of_mem_adjointGroup a hd_adj
        have hd_D : (⟨rootDiagUnit τ a, hd_adj⟩ : C) ∈ Ht.subgroupOf C :=
          Subgroup.mem_subgroupOf.2 hd_H
        have hd_pow : (⟨rootDiagUnit τ a, hd_adj⟩ : C) ^ 31 = 1 := by
          apply Subtype.ext
          change rootDiagUnit τ a ^ 31 = 1
          have ha31 : a ^ 31 = 1 := by
            funext j
            rw [Pi.pow_apply, ha, TableBExc.E6Three.zetaVec_apply, ← pow_mul, Nat.mul_comm,
              pow_mul, hζ31, one_pow]
            rfl
          rw [rootDiagUnit_pow, ha31, rootDiagUnit_one]
        have hd_P : (⟨rootDiagUnit τ a, hd_adj⟩ : C) ∈ (P : Subgroup C) :=
          CFSG.Quasithin.KGC31.sylow_mem_of_comm P hPD hDCcomm hd_D
            (CFSG.Quasithin.KGC31.zpowers_isPGroup_of_pow hd_pow)
        have hmemV : rootDiagUnit τ a ∈ V := Subgroup.mem_map_of_mem C.subtype hd_P
        exact ((Subgroup.mem_centralizer_iff.1 hyV) _ hmemV).symm
      exact CFSG.StandardType.PhiTwoRootGen.mem_torusGroup_of_forall_commute_zetaVec
        (p := 31) (τ := τ) (L := K) (by norm_num) hζ hζ31 hyC hc
    · intro y hy
      exact CFSG.LocalAnalysis.RankFourTheoremC.crossExc_torusGroup_le_adjointGroup hy
    · intro y hy
      rw [Subgroup.mem_centralizer_iff]
      intro x hx
      exact hTcomm x (hVH hx) y hy
  have hu_inf : (u : ModGL τ K) ∈ C ⊓ Subgroup.normalizer (V : Set (ModGL τ K)) := by
    refine Subgroup.mem_inf.2 ⟨u.2, ?_⟩
    rw [Subgroup.mem_set_normalizer_iff]
    intro x
    constructor
    · intro hx
      obtain ⟨p, hp, rfl⟩ := Subgroup.mem_map.1 hx
      exact Subgroup.mem_map_of_mem C.subtype ((Subgroup.mem_set_normalizer_iff.1 hu p).1 hp)
    · intro hx
      obtain ⟨q, hq, hqx⟩ := Subgroup.mem_map.1 hx
      refine Subgroup.mem_map.2 ⟨(u : C)⁻¹ * q * (u : C), ?_, ?_⟩
      · refine (Subgroup.mem_set_normalizer_iff.1 hu _).2 ?_
        rw [show (u : C) * ((u : C)⁻¹ * q * (u : C)) * (u : C)⁻¹ = q by group]
        exact hq
      · change (u : ModGL τ K)⁻¹ * (q : ModGL τ K) * (u : ModGL τ K) = x
        have hqx' : (q : ModGL τ K) = (u : ModGL τ K) * x * (u : ModGL τ K)⁻¹ := hqx
        rw [hqx']
        group
  obtain ⟨h, hh, w, hueq⟩ :=
    CFSG.RankThree.Chevalley.exists_eq_mul_canonicalRep_of_mem_normalizer
      (τ := τ) (k := K) (V := (V : Set (ModGL τ K))) hVH hCV hu_inf
  have huM : (u : ModGL τ K) ∈ monomialSubgroup τ K := by
    rw [hueq]
    exact mul_mem (torusGroup_le_monomialSubgroup hh)
      (canonicalRep_mem_monomialSubgroup (τ := τ) K w)
  have hpowM : (u : ModGL τ K) ^ Nat.card (WeylGroup τ) ∈ monomialSubgroup τ K :=
    pow_mem huM _
  have hquo :
      weylQuotientHom τ K ⟨(u : ModGL τ K) ^ Nat.card (WeylGroup τ), hpowM⟩ = 1 := by
    have h1 : (⟨(u : ModGL τ K) ^ Nat.card (WeylGroup τ), hpowM⟩ : monomialSubgroup τ K) =
        (⟨(u : ModGL τ K), huM⟩ : monomialSubgroup τ K) ^ Nat.card (WeylGroup τ) :=
      Subtype.ext rfl
    rw [h1, map_pow, pow_card_eq_one']
  have huPowH : (u : ModGL τ K) ^ Nat.card (WeylGroup τ) ∈ Ht :=
    CFSG.HardMathSupport.Timmesfeld.CrossChar.mem_torusGroup_of_weylQuotientHom_eq_one
      hpowM hquo
  rw [Subgroup.mem_centralizer_iff]
  intro p hp
  have hpM : (p : ModGL τ K) ∈ Ht := Subgroup.mem_subgroupOf.1 (hPD hp)
  apply Subtype.ext
  change (p : ModGL τ K) * (u : ModGL τ K) ^ Nat.card (WeylGroup τ) =
    (u : ModGL τ K) ^ Nat.card (WeylGroup τ) * (p : ModGL τ K)
  exact hTcomm (p : ModGL τ K) hpM _ huPowH

end CFSG.LocalAnalysis.UniquenessCase.PartTwo.S17.SzFive
