theorem seventeen_fortyfour_three_core {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ}
    {C Dc : Subgroup G} {Gamma : Set G} (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (h1 : R17_1At D V₀ V ctx.hyp125)
    (hSg : CFSG.LocalAnalysis.UniquenessCase.UC6S846.SigmaStd D)
    (h82 : F08.R82 D) (h8108 : Inputs1719.PartOne.R8_108 D)
    (h33 : R17_33_2At D V₀ V) (h43 : R17_43At D V₀ V)
    (hK3 : Inputs1719.K_BorelTorusAbelian) (hK4 : Inputs1719.K_CartanRank)
    (hK : Inputs1719.K_ThreeCentralRankTwo) (hk : D.k = 2)
    (hX3 : 2 < CFSG.Open.pRank 3 X) : False := by
  classical
  have hL : L ∈ calC D.M := ctx.mem_calC
  have hns : ¬ Group.IsSolvable ↥D.M :=
    CFSG.LocalAnalysis.UniquenessCase.UC6S846.not_solvable_of_mem_calC hL
  have hnsp : ¬ CFSG.RankThree.PartOne.IsStronglyPEmbedded 3 D.M :=
    (Data.k_eq_two_iff D).1 hk
  have hM3 : CFSG.Open.pRank 3 D.M ≤ 3 := by
    by_contra hc
    exact hnsp (CFSG.LocalAnalysis.UniquenessCase.UC6S846.sp_of_mem_sig hSg hns
      (hSg.four_mem 3 Nat.prime_three (by norm_num) (by omega)))
  have hXM : X ≤ D.M := by
    rw [ctx.X_eq]
    exact TwelveTwentyThree.conjClosure_le hL.1.le
  have hX3' : CFSG.Open.pRank 3 X = 3 := by
    have := CFSG.SectionRank.pRank_mono (p := 3) (by norm_num) hXM
    omega
  have hL2 : CFSG.Open.pRank 3 L ≤ 2 := pRank_three_L_le_two hL h82 hk
  have hXsup := Ctx17_42.X_eq_iSup_Gamma ctx
  by_cases hZ : 3 ∣ Nat.card (Subgroup.center (Bar2 L))
  · obtain ⟨t, m, hadm, hmodel⟩ := ctx.chev
    have hq : CFSG.Open.IsQuasisimple (Bar2 L) := hL.2.2
    have hodd : Odd (Nat.card (Subgroup.center (Bar2 L))) :=
      uc22p22l_odd_center_quotient
    have hmodelK : LieModel (Bar2 L ⧸ Subgroup.center (Bar2 L)) t m 2 n :=
      LieModel.of_mulEquiv (uc22p21k_barInf_equiv_of_calC hL).some hmodel
    have hbar : CFSG.Open.pRank 3 (⊤ : Subgroup (Bar2 L)) =
        CFSG.Open.pRank 3 L := by
      have hcop : ¬ 3 ∣ Nat.card (CFSG.pCore 2 ↥L) :=
        CFSG.LocalAnalysis.SQTKTwoCoreQuotient.not_dvd_card_pCore_two Nat.prime_three
          (by norm_num)
      have hq3 := CFSG.PreuniquenessRankFour.Helpers.pRank_quotient_map_of_coprime_normal
        (source := ↥L) 3 Nat.prime_three (CFSG.pCore 2 ↥L) hcop ⊤
      rw [Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] at hq3
      rw [hq3, ← CFSG.SectionRank.pRank_eq_pRank_top_subgroup L]
    rcases hK (Bar2 L) t m n hadm hmodelK hq hodd hZ (by omega) with
      ⟨rfl, rfl, hev, hZ3, hrk2⟩ | ⟨rfl, rfl, hoddn⟩
    · have hG1 : Gamma.ncard ≠ 1 := by
        intro h1G
        obtain ⟨γ, rfl⟩ := Set.ncard_eq_one.mp h1G
        rw [hXsup, iSup_singleton, pRank_conjSubgroup_eq Nat.prime_three] at hX3'
        omega
      have hG3 : Gamma.ncard ≤ 2 := by
        have := Ctx17_42.ncard_add_one_le_pRank_X ctx hZ3 (by omega)
        omega
      have hG0 : Gamma.ncard ≠ 0 := by
        intro h0
        have hE : Gamma = ∅ := (Set.ncard_eq_zero (Set.toFinite _)).1 h0
        rw [hXsup, hE, iSup_emptyset, s13_Rank13_pRank_bot Nat.prime_three] at hX3'
        omega
      by_cases hn2 : n = 2
      · subst hn2
        apply hnsp
        refine h8108 L hL ⟨⟨hq, hmodelK⟩, hZ3⟩ ?_
        have h2 : (conjSetOf D.M L).ncard = 2 := by
