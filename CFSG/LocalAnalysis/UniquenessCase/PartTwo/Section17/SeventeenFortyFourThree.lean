      have hAcard : Nat.card (Subgroup.zpowers a) = 3 := by
        rw [Nat.card_zpowers, horder]
      have hArank : CFSG.Open.pRank 3 (Subgroup.zpowers a) = 1 := by
        have h := CFSG.GroupTheory.card_eq_pow_pRank_of_isElemAbelian
          Nat.prime_three hAel
        rw [hAcard] at h
        refine Nat.pow_right_injective (by norm_num : 2 ≤ 3) ?_
        change 3 ^ CFSG.Open.pRank 3 (Subgroup.zpowers a) = 3 ^ 1
        rw [← h]
      have hAdisj : Subgroup.zpowers a ⊓
          Subgroup.centralizer (K i : Set (Bar2 X)) = ⊥ := by
        rw [eq_bot_iff]
        intro x hx
