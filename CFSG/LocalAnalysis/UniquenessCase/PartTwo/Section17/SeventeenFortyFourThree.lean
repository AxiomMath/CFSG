      (fun h => hab (hinj ha hb h)) (fun h => hac (hinj ha hc h)) (fun h => hbc (hinj hb hc h))
      (by rw [pRank_conjSubgroup_eq Nat.prime_three, hL1])
      (by rw [pRank_conjSubgroup_eq Nat.prime_three, hL1])
      (by rw [pRank_conjSubgroup_eq Nat.prime_three, hL1]) (by rw [← hsup]; omega))

theorem seventeen_fortyfour_three {D : Data G} {V₀ V : Subgroup G} (hV : Hyp125 D V₀ V)
    (h1 : R17_1At D V₀ V hV) (hSg : CFSG.LocalAnalysis.UniquenessCase.UC6S846.SigmaStd D)
    (h82 : F08.R82 D) (h8108 : Inputs1719.PartOne.R8_108 D)
    (h33 : R17_33_2At D V₀ V) (h43 : R17_43At D V₀ V)
    (hK4 : Inputs1719.K_CartanRank)
    (hK : Inputs1719.K_ThreeCentralRankTwo) :
    R17_44_3At D V₀ V := by
  have hK3 : Inputs1719.K_BorelTorusAbelian := Inputs1719.k_BorelTorusAbelian_holds
  intro L X p n l C Dc Gamma ctx
  have hDX : CFSG.Open.pRank 3 Dc ≤ CFSG.Open.pRank 3 X :=
    CFSG.SectionRank.pRank_mono (by norm_num) ctx.Dc_le_X
  have hcore : D.k = 2 → 2 < CFSG.Open.pRank 3 X → False := fun hk hX =>
    seventeen_fortyfour_three_core ctx h1 hSg h82 h8108 h33 h43 hK3 hK4 hK hk hX
  have hk12 : D.k = 1 ∨ D.k = 2 := by
    unfold Data.k CFSG.LocalAnalysis.RankThreeUC.kParam
    split_ifs <;> simp
  rcases hk12 with hk | hk
  · have h1' := pRank_three_Dc_le_one_of_k_one ctx hK3 h1 hk
    exact ⟨by omega, fun _ => h1'⟩
  · refine ⟨?_, ?_⟩
    · by_contra hc
      exact hcore hk (by omega)
    · rintro (hk1 | hX)
      · omega
      · exact (hcore hk hX).elim

