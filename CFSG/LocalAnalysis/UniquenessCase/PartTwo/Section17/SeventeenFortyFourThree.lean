        have h2 : CFSG.Open.pRank 3 ((Subgroup.center (K i)).map (K i).subtype) =
            CFSG.Open.pRank 3 (Subgroup.center (K i)) :=
          CFSG.PreuniquenessRankFour.Helpers.pRank_map_of_injective 3 Nat.prime_three
            (K i).subtype (K i).subtype_injective (Subgroup.center (K i))
