theorem hyp81_of_three_of_pRank {M L₁ L₂ L₃ : Subgroup G} (h₁ : L₁ ∈ calC M)
    (h₂ : L₂ ∈ calC M) (h₃ : L₃ ∈ calC M) (h12 : L₁ ≠ L₂) (h13 : L₁ ≠ L₃) (h23 : L₂ ≠ L₃)
    (r₁ : CFSG.Open.pRank 3 L₁ = 1) (r₂ : CFSG.Open.pRank 3 L₂ = 1)
    (r₃ : CFSG.Open.pRank 3 L₃ = 1) (hrk : 2 < CFSG.Open.pRank 3 (L₁ ⊔ L₂ ⊔ L₃)) :
    F08.Hyp81 M (L₁ ⊔ L₂ ⊔ L₃) := by
  unfold F08.Hyp81
  exact ⟨isSubnormal_sup_sup h₁ h₂ h₃, commutator_sup_sup h₁ h₂ h₃, hrk,
    Or.inr ⟨L₁, L₂, L₃, h₁, h₂, h₃, r₁, r₂, r₃, le_sup_left.trans le_sup_left,
      le_sup_right.trans le_sup_left, le_sup_right, coe_sup_sup_eq_mul h₁ h₂ h₃ h12 h13 h23⟩⟩

theorem Ctx17_42.conjSubgroup_mem_calC {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ}
    {C Dc : Subgroup G} {Gamma : Set G} (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    {γ : G} (hγ : γ ∈ Gamma) : CFSG.Quasithin.conjSubgroup L γ ∈ calC D.M :=
  uc22p22u_calC_conj (X := D.M) (M := D.M) le_normalizer ctx.mem_calC (ctx.reps.1 hγ).1

theorem pRank_three_L_le_two {D : Data G} {L : Subgroup G} (hL : L ∈ calC D.M)
    (h82 : F08.R82 D) (hk : D.k = 2) : CFSG.Open.pRank 3 L ≤ 2 := by
  by_contra hc
  have hm3 : 2 < CFSG.Open.pRank 3 L := by omega
  have hsp := h82 L ⟨hL.1, hL.2.1, hm3, Or.inl (s15_Three_qs_of_open hL.2.2)⟩
  exact ((Data.k_eq_two_iff D).1 hk) hsp

theorem Ctx17_42.X_eq_iSup_Gamma {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ}
    {C Dc : Subgroup G} {Gamma : Set G} (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma) :
    X = ⨆ γ ∈ Gamma, CFSG.Quasithin.conjSubgroup L γ := by
  classical
  have hsub : (fun γ => CFSG.Quasithin.conjSubgroup L γ) '' Gamma ⊆ conjSetOf D.M L := by
    rintro K ⟨γ, hγ, rfl⟩
    exact ⟨γ⁻¹, D.M.inv_mem (ctx.reps.1 hγ).1, rfl⟩
  have hcard : (conjSetOf D.M L).ncard ≤
      ((fun γ => CFSG.Quasithin.conjSubgroup L γ) '' Gamma).ncard := by
    rw [ctx.conjSubgroup_injOn_Gamma.ncard_image, ctx.ncard_Gamma_eq_card_conjSet]
  have heq := Set.eq_of_subset_of_ncard_le hsub hcard (Set.toFinite _)
  rw [ctx.X_eq, conjClosure, ← heq, iSup_image]

theorem Ctx17_42.pRank_X_eq_ncard_mul {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ}
    {C Dc : Subgroup G} {Gamma : Set G} (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    {r : ℕ} (hr : r.Prime) (hr2 : r ≠ 2)
    (hZ : ¬ r ∣ Nat.card (Subgroup.center (Bar2 L))) :
    CFSG.Open.pRank r X = Gamma.ncard * CFSG.Open.pRank r L := by
  classical
  let P : G → Subgroup G := fun γ => CFSG.Quasithin.conjSubgroup L γ
  let K : G → Subgroup (Bar2 X) := fun γ => barImage X (P γ)
  have hΓfin : Gamma.Finite := Set.toFinite Gamma
  let s : Finset G := hΓfin.toFinset
  have hs : ∀ γ, γ ∈ s ↔ γ ∈ Gamma := fun γ => hΓfin.mem_toFinset
  have hscard : Gamma.ncard = s.card := Set.ncard_eq_toFinset_card Gamma hΓfin
  have hmemConj : ∀ γ ∈ Gamma, P γ ∈ conjSetOf D.M L := by
    intro γ hγ
    exact ⟨γ⁻¹, D.M.inv_mem (ctx.reps.1 hγ).1, rfl⟩
  have hcalC : ∀ γ ∈ Gamma, P γ ∈ calC X := fun γ hγ =>
    mem_calC_of_mem_conjSetOf ctx (hmemConj γ hγ)
  have hPle : ∀ γ ∈ Gamma, P γ ≤ X := fun γ hγ => (hcalC γ hγ).1.le
  have hcomp : ∀ γ ∈ s, CFSG.IsComponent (K γ) := fun γ hγ =>
    s13_barImage_isComponent (hcalC γ ((hs γ).mp hγ))
  have hsup_s : X = ⨆ γ ∈ s, P γ := by
    have h := Ctx17_42.X_eq_iSup_Gamma ctx
    have hset : (s : Set G) = Gamma := by ext γ; simp [hs]
    rw [h, ← hset]
    simp only [Finset.mem_coe, P]
  have hbar : barImage X (⨆ γ ∈ s, P γ) = ⨆ γ ∈ s, K γ := by
    rw [show (⨆ γ ∈ s, P γ) = ⨆ γ : {γ // γ ∈ s}, P γ from
      (iSup_subtype'' (s : Set G) P).symm]
    show ((⨆ γ : {γ // γ ∈ s}, P γ).subgroupOf X).map
        (QuotientGroup.mk' (CFSG.pCore 2 ↥X)) = _
    rw [CFSG.LieType.Steinberg.iSup_subgroupOf (F := X)
      (T := fun γ : {γ // γ ∈ s} => P γ)
      (fun γ => hPle γ ((hs γ).mp γ.2)), Subgroup.map_iSup]
    exact iSup_subtype'' (s : Set G) K
  have htop : (⊤ : Subgroup (Bar2 X)) = ⨆ γ ∈ s, K γ := by
    calc (⊤ : Subgroup (Bar2 X)) = barImage X X := (s13_barImage_self X).symm
      _ = barImage X (⨆ γ ∈ s, P γ) := by rw [hsup_s]
      _ = ⨆ γ ∈ s, K γ := hbar
  have hcommK : ∀ i ∈ s, ∀ j ∈ s, i ≠ j →
      K i ≤ Subgroup.centralizer (K j : Set (Bar2 X)) := by
    intro i hi j hj hij
    rcases CFSG.LocalCores.distinct_components_commute (hcomp i hi) (hcomp j hj) with
      heq | hcommut
    · exact absurd (ctx.barImage_conjSubgroup_injOn_Gamma ((hs i).mp hi) ((hs j).mp hj) heq)
        hij
    · exact Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcommut
  have hinfcenter : ∀ i ∈ s, K i ⊓ Subgroup.centralizer (K i : Set (Bar2 X)) ≤
      (Subgroup.center (K i)).map (K i).subtype := by
    intro i hi
    intro x hx
    refine Subgroup.mem_map.mpr ⟨⟨x, hx.1⟩, ?_, rfl⟩
    rw [Subgroup.mem_center_iff]
    intro y
    exact Subtype.ext (Subgroup.mem_centralizer_iff.mp hx.2 (y : Bar2 X) y.2)
  have hZK : ∀ i ∈ s,
      ¬ r ∣ Nat.card ↥(K i ⊓ Subgroup.centralizer (K i : Set (Bar2 X))) := by
    intro i hi hdvd
    have hcenter : ¬ r ∣ Nat.card (Subgroup.center (K i)) := by
      have hc := ctx.card_center_barImage_conjSubgroup ((hs i).mp hi)
      intro h
      rw [hc] at h
      exact hZ h
    have hdvd' : r ∣ Nat.card ↥((Subgroup.center (K i)).map (K i).subtype) :=
      hdvd.trans (Subgroup.card_dvd_of_le (hinfcenter i hi))
    rw [Subgroup.card_map_of_injective (K i).subtype_injective] at hdvd'
    exact hcenter hdvd'
  have hsum := CFSG.GroupTheory.pRank_iSup_eq_sum_of_commute_of_not_dvd
    (Y := Bar2 X) (p := r) hr s K hcommK hZK
  have hKi : ∀ i ∈ s, CFSG.Open.pRank r (K i) = CFSG.Open.pRank r L := by
    intro i hi
    rw [show K i = barImage X (P i) from rfl,
      s13_pRank_barImage hr hr2 (hPle i ((hs i).mp hi))]
    exact pRank_conjSubgroup_eq (C := L) (g := i) hr
  calc CFSG.Open.pRank r X
      = CFSG.Open.pRank r (⊤ : Subgroup (Bar2 X)) := (s13_pRank_bar_top hr hr2 X).symm
    _ = CFSG.Open.pRank r (⨆ γ ∈ s, K γ) := by rw [htop]
    _ = ∑ γ ∈ s, CFSG.Open.pRank r (K γ) := hsum
    _ = ∑ γ ∈ s, CFSG.Open.pRank r L := Finset.sum_congr rfl hKi
    _ = s.card * CFSG.Open.pRank r L := by
        rw [Finset.sum_const, smul_eq_mul]
    _ = Gamma.ncard * CFSG.Open.pRank r L := by rw [hscard]

theorem Ctx17_42.ncard_add_one_le_pRank_X {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ}
    {C Dc : Subgroup G} {Gamma : Set G} (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (hZ : Nat.card (Subgroup.center (Bar2 L)) = 3) (hL2 : 2 ≤ CFSG.Open.pRank 3 L) :
    Gamma.ncard + 1 ≤ CFSG.Open.pRank 3 X := by
  classical
  let P : G → Subgroup G := fun γ => CFSG.Quasithin.conjSubgroup L γ
  let K : G → Subgroup (Bar2 X) := fun γ => barImage X (P γ)
  have hΓfin : Gamma.Finite := Set.toFinite Gamma
  let s : Finset G := hΓfin.toFinset
  have hs : ∀ γ, γ ∈ s ↔ γ ∈ Gamma := fun γ => hΓfin.mem_toFinset
  have hscard : Gamma.ncard = s.card := Set.ncard_eq_toFinset_card Gamma hΓfin
  have hpos : 0 < Gamma.ncard := by
    let K' : Subgroup G := D.M ⊓ Subgroup.normalizer ((D.T ⊓ X : Subgroup G) : Set G)
    have h1K : (1 : G) ∈ K' := by
      refine Subgroup.mem_inf.mpr ⟨D.M.one_mem, ?_⟩
      exact (Subgroup.normalizer _).one_mem
    obtain ⟨γ, hγ, -⟩ := ctx.reps.2 1 h1K
    exact (Set.ncard_pos (Set.toFinite Gamma)).2 ⟨γ, hγ.1⟩
  have hs_pos : 0 < s.card := by rwa [← hscard]
  obtain ⟨i₀, hi₀⟩ := Finset.card_pos.mp hs_pos
  have hmemConj : ∀ γ ∈ Gamma, P γ ∈ conjSetOf D.M L := by
    intro γ hγ
    exact ⟨γ⁻¹, D.M.inv_mem (ctx.reps.1 hγ).1, rfl⟩
  have hcalC : ∀ γ ∈ Gamma, P γ ∈ calC X := fun γ hγ =>
    mem_calC_of_mem_conjSetOf ctx (hmemConj γ hγ)
  have hPle : ∀ γ ∈ Gamma, P γ ≤ X := fun γ hγ => (hcalC γ hγ).1.le
  have hcomp : ∀ γ ∈ s, CFSG.IsComponent (K γ) := fun γ hγ =>
    s13_barImage_isComponent (hcalC γ ((hs γ).mp hγ))
  have hsup_s : X = ⨆ γ ∈ s, P γ := by
    have h := Ctx17_42.X_eq_iSup_Gamma ctx
    have hset : (s : Set G) = Gamma := by ext γ; simp [hs]
    rw [h, ← hset]
    simp only [Finset.mem_coe, P]
  have hbar : barImage X (⨆ γ ∈ s, P γ) = ⨆ γ ∈ s, K γ := by
    rw [show (⨆ γ ∈ s, P γ) = ⨆ γ : {γ // γ ∈ s}, P γ from
      (iSup_subtype'' (s : Set G) P).symm]
    show ((⨆ γ : {γ // γ ∈ s}, P γ).subgroupOf X).map
        (QuotientGroup.mk' (CFSG.pCore 2 ↥X)) = _
    rw [CFSG.LieType.Steinberg.iSup_subgroupOf (F := X)
      (T := fun γ : {γ // γ ∈ s} => P γ)
      (fun γ => hPle γ ((hs γ).mp γ.2)), Subgroup.map_iSup]
    exact iSup_subtype'' (s : Set G) K
  have htop : (⊤ : Subgroup (Bar2 X)) = ⨆ γ ∈ s, K γ := by
    calc (⊤ : Subgroup (Bar2 X)) = barImage X X := (s13_barImage_self X).symm
      _ = barImage X (⨆ γ ∈ s, P γ) := by rw [hsup_s]
      _ = ⨆ γ ∈ s, K γ := hbar
  have hcommK : ∀ i ∈ s, ∀ j ∈ s, i ≠ j →
      K i ≤ Subgroup.centralizer (K j : Set (Bar2 X)) := by
    intro i hi j hj hij
    rcases CFSG.LocalCores.distinct_components_commute (hcomp i hi) (hcomp j hj) with
      heq | hcommut
    · exact absurd (ctx.barImage_conjSubgroup_injOn_Gamma ((hs i).mp hi) ((hs j).mp hj) heq)
        hij
    · exact Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcommut
  have hKi : ∀ i ∈ s, CFSG.Open.pRank 3 (K i) = CFSG.Open.pRank 3 L := by
    intro i hi
    rw [show K i = barImage X (P i) from rfl,
      s13_pRank_barImage Nat.prime_three (by norm_num) (hPle i ((hs i).mp hi))]
    exact pRank_conjSubgroup_eq (C := L) (g := i) Nat.prime_three
  have hZcard : ∀ i ∈ s, Nat.card (Subgroup.center (K i)) = 3 := by
    intro i hi
    rw [ctx.card_center_barImage_conjSubgroup ((hs i).mp hi)]
    exact hZ
  have hZrank : ∀ i ∈ s, CFSG.Open.pRank 3 (Subgroup.center (K i)) ≤ 1 := by
    intro i hi
    have hcard : Nat.card (Subgroup.center (K i)) = 3 := hZcard i hi
    refine CFSG.SectionRank.pRank_le (p := 3) (by norm_num) ?_
    intro E hE _
    have hdvd : Nat.card E ∣ Nat.card (Subgroup.center (K i)) := Subgroup.card_dvd_of_le hE
    rw [hcard] at hdvd
    calc Nat.card E ≤ 3 := Nat.le_of_dvd (by norm_num) hdvd
      _ = 3 ^ 1 := by norm_num
  let i₀' : {i // i ∈ s} := ⟨i₀, hi₀⟩
  have hA_exists : ∀ i : {i // i ∈ s}, ∃ A : Subgroup (Bar2 X),
      A ≤ K i ∧ CFSG.Open.IsElemAbelian 3 A ∧
        (i ≠ i₀' → CFSG.Open.pRank 3 A = 1 ∧
          A ⊓ Subgroup.centralizer (K i : Set (Bar2 X)) = ⊥) ∧
        (i = i₀' → 2 ≤ CFSG.Open.pRank 3 A) := by
    intro i
    by_cases hii : i = i₀'
    · subst hii
      have hK2 : 2 ≤ CFSG.Open.pRank 3 (K i₀') := by
        rw [hKi i₀ hi₀]
        exact hL2
      obtain ⟨E, hEK, hEel, hEcard⟩ :=
        CFSG.SectionRank.exists_pRank (p := 3) (by norm_num) (K i₀')
      have hErank : CFSG.Open.pRank 3 E = CFSG.Open.pRank 3 (K i₀') := by
        have h := CFSG.GroupTheory.card_eq_pow_pRank_of_isElemAbelian
          Nat.prime_three hEel
        rw [h] at hEcard
        exact Nat.pow_right_injective (by norm_num : 2 ≤ 3) hEcard
      refine ⟨E, hEK, hEel, ?_, ?_⟩
      · intro hne
        exact absurd rfl hne
      · intro _
        rwa [hErank]
    · have hKi2 : 2 ≤ CFSG.Open.pRank 3 (K i) := by
        rw [hKi i i.2]
        exact hL2
      obtain ⟨E, hEK, hEel, hEcard⟩ :=
        CFSG.SectionRank.exists_pRank (p := 3) (by norm_num) (K i)
      have hErank : CFSG.Open.pRank 3 E = CFSG.Open.pRank 3 (K i) := by
        have h := CFSG.GroupTheory.card_eq_pow_pRank_of_isElemAbelian
          Nat.prime_three hEel
        rw [h] at hEcard
        exact Nat.pow_right_injective (by norm_num : 2 ≤ 3) hEcard
      have hEnotZ : ¬ E ≤ (Subgroup.center (K i)).map (K i).subtype := by
        intro hle
        have h1 : CFSG.Open.pRank 3 E ≤
            CFSG.Open.pRank 3 ((Subgroup.center (K i)).map (K i).subtype) :=
