          CFSG.Open.pRank p (⊤ : Subgroup (Bar2 L)) :=
      CFSG.SectionRank.pRank_quotient_eq (Subgroup.center (Bar2 L)) hZcard
    rwa [heq]
  ·
    have hnice : CFSG.RankThree.PartOne.OutStructure.OutPNice p
        (Bar2 L ⧸ Subgroup.center (Bar2 L)) :=
