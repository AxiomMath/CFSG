private theorem pRank_center_le_one_of_card_dvd_three {K : Type} [Group K] [Finite K] {p : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) (h3 : Nat.card (Subgroup.center K) ∣ 3) :
    CFSG.Open.pRank p (Subgroup.center K) ≤ 1 := by
  rw [CFSG.SectionRank.pRank_eq_pRank_top_subgroup]
  refine GL83.I713.pRank_top_le_one_of_card_lt hp ?_
  have hle : Nat.card (Subgroup.center K) ≤ 3 := Nat.le_of_dvd (by norm_num) h3
  have hp3 : 3 ≤ p := by
    rcases Nat.lt_or_eq_of_le hp.two_le with h | h
    · omega
    · exact absurd h.symm hp2
  have h9 : 3 < p ^ 2 := by
    calc 3 < 3 ^ 2 := by norm_num
      _ ≤ p ^ 2 := Nat.pow_le_pow_left hp3 2
  omega

private theorem pRank_center_add_pRank_quotient {K : Type} [Group K] [Finite K] {p : ℕ}
    (hp : p.Prime) :
    CFSG.Open.pRank p (⊤ : Subgroup K) ≤
      CFSG.Open.pRank p (Subgroup.center K) +
        CFSG.Open.pRank p (⊤ : Subgroup (K ⧸ Subgroup.center K)) := by
  have h := CFSG.AGLEmbedding.pRank_le_pRank_inf_ker_add_pRank_map (p := p) hp
    (QuotientGroup.mk' (Subgroup.center K)) (⊤ : Subgroup K)
  have hker : (⊤ : Subgroup K) ⊓ (QuotientGroup.mk' (Subgroup.center K)).ker =
      Subgroup.center K := by
    ext x
    simp [QuotientGroup.ker_mk']
  have hmap : (⊤ : Subgroup K).map (QuotientGroup.mk' (Subgroup.center K)) = ⊤ :=
    Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)
  rwa [hker, hmap] at h

private theorem pRank_quotient_center_ge_sub_one {K : Type} [Group K] [Finite K] {p : ℕ}
    (hp : p.Prime) (hZ : CFSG.Open.pRank p (Subgroup.center K) ≤ 1) :
    CFSG.Open.pRank p (⊤ : Subgroup K) - 1 ≤
      CFSG.Open.pRank p (⊤ : Subgroup (K ⧸ Subgroup.center K)) := by
  have h := pRank_center_add_pRank_quotient (K := K) hp
  omega

private theorem eS_ne_one_of_not_dvd {q p : ℕ} (hq : 1 ≤ q) (hp : p.Prime)
    (hsub : ¬ p ∣ q - 1) (hadd : ¬ p ∣ q + 1) : eS q p ≠ 1 := by
  intro h
  have hdvd : p ∣ q ^ 2 - 1 := (eS_eq_one_iff hq).mp h
  exact hadd (dvd_add_one_of_dvd_sq_sub_one hp hq hdvd hsub)

private theorem div_le_div_two_of_ne_one {l e : ℕ} (he : e ≠ 1) : l / e ≤ l / 2 := by
  rcases Nat.eq_zero_or_pos e with rfl | hepos
  · simp
  · have h2 : 2 ≤ e := by omega
    exact Nat.div_le_div_left h2 (by norm_num)

private theorem six_div_le_two_of_eM {e : ℕ} (h1 : e ≠ 1) (h2 : e ≠ 2) : 6 / e ≤ 2 := by
  rcases Nat.eq_zero_or_pos e with rfl | hepos
  · simp
  · have h3 : 3 ≤ e := by omega
    calc 6 / e ≤ 6 / 3 := Nat.div_le_div_left h3 (by norm_num)
      _ = 2 := by norm_num

private theorem four_div_le_two_of_eS {e : ℕ} (he : e ≠ 1) : 4 / e ≤ 2 := by
  rcases Nat.eq_zero_or_pos e with rfl | hepos
  · simp
  · have h2 : 2 ≤ e := by omega
    have h : 4 / e ≤ 4 / 2 := Nat.div_le_div_left h2 (by norm_num)
    omega

private theorem card_center_dvd_three_of_psu_six (hN : uc22p20rNativeGriess) {K : Type}
    [Group K] [Finite K] (hq : CFSG.Open.IsQuasisimple K)
    (hodd : Odd (Nat.card (Subgroup.center K))) {n : ℕ}
    (hM : LieModel (K ⧸ Subgroup.center K) .PSU 6 2 n) :
    Nat.card (Subgroup.center K) ∣ 3 := by
  have hdvdGcd : Nat.card (Subgroup.center K) ∣ Nat.gcd 6 (2 ^ n + 1) := by
    simpa [CFSG.Blueprint.Multiplier.genericOrders] using
      (uc22p20v_card_center_dvd hN hq hodd hM)
  have hdvd6 : Nat.card (Subgroup.center K) ∣ 6 := hdvdGcd.trans (Nat.gcd_dvd_left _ _)
  have hcop : Nat.Coprime (Nat.card (Subgroup.center K)) 2 := Nat.coprime_two_right.mpr hodd
  have h6 : Nat.card (Subgroup.center K) ∣ 2 * 3 := by simpa using hdvd6
  exact hcop.dvd_of_dvd_mul_left h6

theorem three_le_pRank_center_quotient_of_core {D : Data G} {V₀ V L X : Subgroup G}
    {p n l : ℕ} {C Dc : Subgroup G} {Gamma : Set G}
    (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (core : S17_46Core D V₀ V L X p n l C Dc Gamma)
    (hT : LieOddRankChev) (hN : uc22p20rNativeGriess) :
    3 ≤ CFSG.Open.pRank p (⊤ : Subgroup (Bar2 L ⧸ Subgroup.center (Bar2 L))) := by
  classical
  obtain ⟨t, m, hmodel, hdisj⟩ := core.shape
  have hp : p.Prime := (D.sig_prime p ctx.p_mem).1
  have hp2 : p ≠ 2 := (D.sig_prime p ctx.p_mem).2
  haveI : Fact p.Prime := ⟨hp⟩
  have hqK : CFSG.Open.IsQuasisimple (Bar2 L) := ctx.mem_calC.2.2
  have hoddK : Odd (Nat.card (Subgroup.center (Bar2 L))) :=
    uc22p20p_odd_center_bar2 ↥L
  obtain ⟨e⟩ := uc22p21k_barInf_equiv_of_calC ctx.mem_calC
  have hmodelQuot : LieModel (Bar2 L ⧸ Subgroup.center (Bar2 L)) t m 2 n :=
    LieModel.of_mulEquiv e hmodel
  have hLM : L ≤ D.M := ctx.mem_calC.1.le
  have hML : D.M ≤ Subgroup.normalizer (L : Set G) := by
    rw [core.L_eq_X, ctx.X_eq]
    exact uc22p22v_le_normalizer_conjClosure D.M L
  rcases hdisj with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  ·
    have hS : StatedClassicalModel (Bar2 L ⧸ Subgroup.center (Bar2 L)) .PSL 4 2 n :=
      LieModel.statedClassicalModel hmodelQuot (by decide)
    have hnice : CFSG.RankThree.PartOne.OutStructure.OutPNice p
        (Bar2 L ⧸ Subgroup.center (Bar2 L)) := by
      refine CFSG.RankThree.PartOne.OutStructure.outPNice_PSL_ge_three_odd hp hp2
        (n := 4) (r := 2) (m := n) (by norm_num) hS ?_
      intro hd
      have hd4 : p ∣ 4 := hd.trans (Nat.gcd_dvd_left 4 (2 ^ n - 1))
      have hd2 : p ∣ 2 ^ 2 := by simpa using hd4
      exact hp2 ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp
        (hp.dvd_of_dvd_pow hd2))
    haveI : Group.IsPerfect (Bar2 L) := Group.isPerfect_def.mpr hqK.1
    have hcomp : CFSG.HasNormalPComplement p
        (Outer (Bar2 L ⧸ Subgroup.center (Bar2 L))) :=
