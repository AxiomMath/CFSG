theorem exists_lift_elemAbelian_pRank_centralizer {L M : Subgroup G} {r p : ℕ}
    (hr : r.Prime) (hr2 : r ≠ 2) (hp : p.Prime) (hp2 : p ≠ 2) (hLM : L ≤ M)
    {E : Subgroup (Bar2 L)} (hEel : IsElemAbelian r E) (hEcard : Nat.card E = r ^ 2) :
    ∃ (E' : Subgroup ↥L) (Etilde : Subgroup G),
      IsElemAbelian r E' ∧ E'.map (QuotientGroup.mk' (CFSG.pCore 2 ↥L)) = E ∧
        Etilde = E'.map L.subtype ∧ IsElemAbelian r Etilde ∧ Nat.card Etilde = r ^ 2 ∧
          CFSG.Open.pRank p (⊤ : Subgroup (Subgroup.centralizer (E : Set (Bar2 L)))) ≤
            CFSG.Open.pRank p (M ⊓ Subgroup.centralizer (Etilde : Set G)) := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Fact r.Prime := ⟨hr⟩
  let Q : Subgroup ↥L := CFSG.pCore 2 ↥L
  let π : ↥L →* Bar2 L := QuotientGroup.mk' Q
  have hπ : Function.Surjective π := QuotientGroup.mk'_surjective Q
  have hQr : ¬ r ∣ Nat.card Q :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup (CFSG.pCore_isPGroup (p := 2) (G := ↥L))
      hr hr2
  have hQp : ¬ p ∣ Nat.card Q :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup (CFSG.pCore_isPGroup (p := 2) (G := ↥L))
      hp hp2
  have hQr' : ¬ r ∣ Nat.card π.ker := by
    simpa [π, Q, QuotientGroup.ker_mk'] using hQr
  obtain ⟨E', hE'map, hE'dis⟩ :=
    CFSG.RankThree.PartOne.CTP.SeitzToral.exists_lift_of_coprime_ker π hπ hQr' E
      hEel.isPGroup
  have hE'mem : ∀ x ∈ E', π x ∈ E := fun x hx => hE'map ▸ ⟨x, hx, rfl⟩
  have hcommE : ∀ x ∈ E, ∀ y ∈ E, x * y = y * x := fun x hx y hy =>
    congrArg Subtype.val ((isMulCommutative_iff.mp hEel.1) (⟨x, hx⟩ : E) ⟨y, hy⟩)
  have hE'comm : ∀ a ∈ E', ∀ b ∈ E', a * b = b * a := by
    intro a ha b hb
    have hc : a * b * a⁻¹ * b⁻¹ ∈ E' :=
      E'.mul_mem (E'.mul_mem (E'.mul_mem ha hb) (E'.inv_mem ha)) (E'.inv_mem hb)
    have hk : a * b * a⁻¹ * b⁻¹ ∈ π.ker := by
      rw [MonoidHom.mem_ker]
      simp only [map_mul, map_inv]
      have h := hcommE _ (hE'mem a ha) _ (hE'mem b hb)
      rw [h]
      group
    have h1 := Subgroup.disjoint_def.mp hE'dis hc hk
    exact commutatorElement_eq_one_iff_mul_comm.mp h1
  have hE'exp : ∀ a ∈ E', a ^ r = 1 := by
    intro a ha
    have hk : a ^ r ∈ π.ker := by
      rw [MonoidHom.mem_ker, map_pow]
      exact hEel.2 _ (hE'mem a ha)
    exact Subgroup.disjoint_def.mp hE'dis (E'.pow_mem ha r) hk
  have hE'el : IsElemAbelian r E' :=
    ⟨IsMulCommutative.of_comm fun a b => Subtype.ext (hE'comm a a.2 b b.2), hE'exp⟩
  let fπ : E' →* E := (π.comp E'.subtype).codRestrict E (fun x => hE'mem x.1 x.2)
  have hfπsurj : Function.Surjective fπ := by
    intro e
    have he : (e : Bar2 L) ∈ E'.map π := hE'map ▸ e.2
    obtain ⟨x, hx, hxe⟩ := he
    exact ⟨⟨x, hx⟩, Subtype.ext hxe⟩
  have hfπinj : Function.Injective fπ := by
    intro x y hxy
    have h1 : π x.1 = π y.1 := congrArg Subtype.val hxy
    have h2 : x.1⁻¹ * y.1 ∈ π.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, h1, inv_mul_cancel]
    have h3 : x.1⁻¹ * y.1 = 1 :=
      Subgroup.disjoint_def.mp hE'dis (E'.mul_mem (E'.inv_mem x.2) y.2) h2
    exact Subtype.ext (inv_mul_eq_one.mp h3)
  have hcardE' : Nat.card E' = Nat.card E :=
    Nat.card_congr (Equiv.ofBijective fπ ⟨hfπinj, hfπsurj⟩)
  have hmapcent := CFSG.Holt.H78.lemma_1_8_centralizer (p := r) Q hQr (P := E') hE'el.isPGroup
  have hqmap := CFSG.PreuniquenessRankFour.Helpers.pRank_quotient_map_of_coprime_normal
    p hp Q hQp (Subgroup.centralizer (E' : Set ↥L))
  have hCeq : CFSG.Open.pRank p (⊤ : Subgroup (Subgroup.centralizer (E' : Set ↥L))) =
      CFSG.Open.pRank p (⊤ : Subgroup (Subgroup.centralizer (E : Set (Bar2 L)))) := by
    rw [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup
        (Subgroup.centralizer (E' : Set ↥L)),
      ← CFSG.SectionRank.pRank_eq_pRank_top_subgroup
        (Subgroup.centralizer (E : Set (Bar2 L)))]
    calc CFSG.Open.pRank p (Subgroup.centralizer (E' : Set ↥L))
        = CFSG.Open.pRank p ((Subgroup.centralizer (E' : Set ↥L)).map π) := hqmap.symm
      _ = CFSG.Open.pRank p (Subgroup.centralizer (E : Set (Bar2 L))) := by
          rw [hmapcent, hE'map]
  let Etilde : Subgroup G := E'.map L.subtype
  have hEtildeL : Etilde ≤ L := Subgroup.map_subtype_le E'
  have hEtildeel : IsElemAbelian r Etilde := CFSG.SectionRank.isElemAbelian_map hE'el L.subtype
  have hEtildecard : Nat.card Etilde = r ^ 2 := by
    have hcardmap : Nat.card Etilde = Nat.card E' :=
      Subgroup.card_map_of_injective (f := L.subtype) L.subtype_injective
    rw [hcardmap, hcardE', hEcard]
  have himage_le : (Subgroup.centralizer (E' : Set ↥L)).map L.subtype ≤
      M ⊓ Subgroup.centralizer (Etilde : Set G) := by
    refine le_inf ((Subgroup.map_subtype_le _).trans hLM) ?_
    rintro _ ⟨x, hx, rfl⟩
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    obtain ⟨y', hy', rfl⟩ := Subgroup.mem_map.mp hy
    exact congrArg L.subtype ((Subgroup.mem_centralizer_iff.mp hx) y' hy')
  have hle : CFSG.Open.pRank p (⊤ : Subgroup (Subgroup.centralizer (E' : Set ↥L))) ≤
      CFSG.Open.pRank p (M ⊓ Subgroup.centralizer (Etilde : Set G)) := by
    rw [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup
      (Subgroup.centralizer (E' : Set ↥L))]
    calc CFSG.Open.pRank p (Subgroup.centralizer (E' : Set ↥L))
        ≤ CFSG.Open.pRank p ((Subgroup.centralizer (E' : Set ↥L)).map L.subtype) :=
          CFSG.SectionRank.pRank_le_map hp.one_lt L.subtype L.subtype_injective _
      _ ≤ CFSG.Open.pRank p (M ⊓ Subgroup.centralizer (Etilde : Set G)) :=
          CFSG.SectionRank.pRank_mono hp.one_lt himage_le
  exact ⟨E', Etilde, hE'el, hE'map, rfl, hEtildeel, hEtildecard, hCeq ▸ hle⟩

theorem false_of_core_torus {D : Data G} {V₀ V L X : Subgroup G}
