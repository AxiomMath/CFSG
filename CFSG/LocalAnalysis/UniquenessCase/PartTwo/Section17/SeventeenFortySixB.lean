  have hLM : L ≤ D.M := ctx.mem_calC.1.le
  have hshapeK : (t = .PSU ∧ m = 6) ∨ (t = .POmegaMinus ∧ m = 4) ∨
      (t = .PSp ∧ m = 3) := by
    rcases hshape with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
  obtain ⟨E, hEel, hEcard, hEcent⟩ := hK7c (Bar2 L) t m n p r hadm hmodelQuot hqK hoddK
    core.odd_n hshapeK hp hp2 hAdd hr (by omega : 5 ≤ r) hrdvd
  obtain ⟨E', Etilde, hE'el, hE'map, hEtilde_eq, hEtildeel, hEtildecard, hle⟩ :=
    exists_lift_elemAbelian_pRank_centralizer hr hr2 hp hp2 hLM hEel hEcard
  have hEtildeL : Etilde ≤ L := by
    rw [hEtilde_eq]
    exact Subgroup.map_subtype_le E'
  have hcontra := hcentE Etilde hEtildeL hEtildeel hEtildecard
  rcases hshape with hU6 | hOm
  · obtain ⟨rfl, rfl⟩ := hU6
    have h2 : 2 ≤ CFSG.Open.pRank p (⊤ : Subgroup
        (Subgroup.centralizer (E : Set (Bar2 L)))) := by
      rw [← CFSG.SectionRank.pRank_coe_eq_openPRank p
        (⊤ : Subgroup (Subgroup.centralizer (E : Set (Bar2 L))))]
      simpa using hEcent
    clear hEcent
    omega
  · obtain ⟨rfl, rfl⟩ := hOm
    have h2 : 2 ≤ CFSG.Open.pRank p (⊤ : Subgroup
        (Subgroup.centralizer (E : Set (Bar2 L)))) := by
      rw [← CFSG.SectionRank.pRank_coe_eq_openPRank p
        (⊤ : Subgroup (Subgroup.centralizer (E : Set (Bar2 L))))]
      simpa using hEcent
    clear hEcent
    omega

theorem false_of_core_sp6 {D : Data G} {V₀ V L X : Subgroup G}
    {p n l : ℕ} {C Dc : Subgroup G} {Gamma : Set G}
    (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (core : S17_46Core D V₀ V L X p n l C Dc Gamma)
    {t : StatedLieTag} {m : ℕ} (hadm : StatedLieAdmissible t m 2 n)
    (hmodel : LieModel (BarInf L) t m 2 n)
    (hAdd : p ∣ 2 ^ n + 1) (hSp : t = .PSp ∧ m = 3)
    (hT : LieOddRankChev) (hN : uc22p20rNativeGriess)
    (hK7c : K_RankThreeCentTorus) : False := by
  classical
  obtain ⟨r, hr, hr7, hrdvd, hcentE⟩ := core.bang
  have hr2 : r ≠ 2 := by omega
  have hp : p.Prime := (D.sig_prime p ctx.p_mem).1
  have hp2 : p ≠ 2 := (D.sig_prime p ctx.p_mem).2
  haveI : Fact p.Prime := ⟨hp⟩
  have hqK : CFSG.Open.IsQuasisimple (Bar2 L) := ctx.mem_calC.2.2
  have hoddK : Odd (Nat.card (Subgroup.center (Bar2 L))) :=
    uc22p20p_odd_center_bar2 ↥L
  obtain ⟨e⟩ := uc22p21k_barInf_equiv_of_calC ctx.mem_calC
  obtain ⟨rfl, rfl⟩ := hSp
  have hmodelQuot : LieModel (Bar2 L ⧸ Subgroup.center (Bar2 L)) .PSp 3 2 n :=
    LieModel.of_mulEquiv e hmodel
  have hLM : L ≤ D.M := ctx.mem_calC.1.le
  have hML : D.M ≤ Subgroup.normalizer (L : Set G) := by
    rw [core.L_eq_X, ctx.X_eq]
    exact uc22p22v_le_normalizer_conjClosure D.M L
  have hoddq : Odd (2 ^ n - 1) :=
    Nat.Even.sub_odd Nat.one_le_two_pow
      (even_two.pow_of_ne_zero core.odd_n.pos.ne') odd_one
  have hgcd : Nat.gcd 2 (2 ^ n - 1) = 1 :=
    Nat.Coprime.gcd_eq_one (Nat.coprime_two_left.mpr hoddq)
  have hgen : CFSG.Blueprint.Multiplier.genericOrders .PSp 3 2 n = (1, 1) := by
    show (Nat.gcd 2 (2 ^ n - 1), 1) = (1, 1)
    rw [hgcd]
  have hZ : Subgroup.center (Bar2 L) = ⊥ :=
    uc22p20v_center_eq_bot hN hqK hoddK hmodelQuot hgen
  obtain ⟨E, hEel, hEcard, hEcent⟩ := hK7c (Bar2 L) .PSp 3 n p r hadm hmodelQuot hqK
    hoddK core.odd_n (Or.inr (Or.inr ⟨rfl, rfl⟩)) hp hp2 hAdd hr (by omega : 5 ≤ r) hrdvd
  obtain ⟨E', Etilde, hE'el, hE'map, hEtilde_eq, hEtildeel, hEtildecard, hle⟩ :=
    exists_lift_elemAbelian_pRank_centralizer hr hr2 hp hp2 hLM hEel hEcard
  have hEtildeL : Etilde ≤ L := by
    rw [hEtilde_eq]
    exact Subgroup.map_subtype_le E'
  have hEcent1 : 1 ≤ CFSG.Open.pRank p (⊤ : Subgroup
      (Subgroup.centralizer (E : Set (Bar2 L)))) := by
    rw [← CFSG.SectionRank.pRank_coe_eq_openPRank p
      (⊤ : Subgroup (Subgroup.centralizer (E : Set (Bar2 L))))]
    simpa using hEcent
  clear hEcent
  obtain ⟨A, -, hAel, hAcard⟩ := CFSG.SectionRank.exists_pRank hp.one_lt
    (⊤ : Subgroup (Subgroup.centralizer (E : Set (Bar2 L))))
  have hAcardPos : 0 < Nat.card A := by
    rw [hAcard]
    exact pow_pos hp.pos _
  have hAne : A ≠ ⊥ := by
    intro hbot
    have h1 : Nat.card A = 1 := by simp [hbot]
    have h2 : p ≤ Nat.card A := by
      rw [hAcard]
      simpa using Nat.pow_le_pow_right hp.pos hEcent1
    have hp2le : 2 ≤ p := hp.two_le
    omega
  obtain ⟨a, ha1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hAne
  let aC : ↥(Subgroup.centralizer (E : Set (Bar2 L))) := a
  have haord : orderOf aC = p := by
    have hdvd : orderOf aC ∣ p := by
      apply orderOf_dvd_of_pow_eq_one
      simpa [aC] using hAel.2 a a.2
    rcases (Nat.dvd_prime hp).mp hdvd with h1 | hp'
    · exact absurd (orderOf_eq_one_iff.mp h1) (by simpa [aC] using ha1)
    · exact hp'
  let ybar : Bar2 L := (aC : Bar2 L)
  have hybar_ord : orderOf ybar = p := by
    change orderOf ((aC : Bar2 L)) = p
    rw [Subgroup.orderOf_coe]
    exact haord
  have hybar_cent : ybar ∈ Subgroup.centralizer (E : Set (Bar2 L)) := aC.2
  let Q : Subgroup ↥L := CFSG.pCore 2 ↥L
  let π : ↥L →* Bar2 L := QuotientGroup.mk' Q
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Fact r.Prime := ⟨hr⟩
  have hQr : ¬ r ∣ Nat.card Q :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup (CFSG.pCore_isPGroup (p := 2) (G := ↥L))
      hr hr2
  have hQp : ¬ p ∣ Nat.card Q :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup (CFSG.pCore_isPGroup (p := 2) (G := ↥L))
      hp hp2
  have hmapcent := CFSG.Holt.H78.lemma_1_8_centralizer (p := r) Q hQr (P := E') hE'el.isPGroup
  have hcentmap : (Subgroup.centralizer (E' : Set ↥L)).map π =
      Subgroup.centralizer (E : Set (Bar2 L)) := by
    rw [hmapcent, hE'map]
  have hybarMem : ybar ∈ (Subgroup.centralizer (E' : Set ↥L)).map π := by
    rw [hcentmap]
    exact hybar_cent
  obtain ⟨x, hxcent, hxmap⟩ := hybarMem
  have hxmap' : π x = ybar := hxmap
  have hxpker : x ^ p ∈ π.ker := by
    rw [MonoidHom.mem_ker, map_pow, hxmap']
    exact hybar_ord ▸ pow_orderOf_eq_one ybar
  have hxpQ : x ^ p ∈ Q := by
    simpa [π, Q, QuotientGroup.ker_mk'] using hxpker
  have hm : (x ^ p) ^ Nat.card Q = 1 := by
    have h := pow_card_eq_one' (G := Q) (x := (⟨x ^ p, hxpQ⟩ : Q))
    exact congrArg Subtype.val h
  have hcop : Nat.Coprime (Nat.card Q) p :=
    (hp.coprime_iff_not_dvd.mpr hQp).symm
  obtain ⟨k, hkmap, hkord⟩ :=
    exists_pow_orderOf_eq_of_coprime_map (φ := π) (x := x) hp
      (by rw [hxmap']; exact hybar_ord) hm hcop
  have hycent : x ^ k ∈ Subgroup.centralizer (E' : Set ↥L) :=
    (Subgroup.centralizer (E' : Set ↥L)).pow_mem hxcent k
  let y : ↥L := x ^ k
  let yG : G := L.subtype y
  have hyG_L : yG ∈ L := y.2
  have hyG_cent : yG ∈ Subgroup.centralizer (Etilde : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    rw [hEtilde_eq] at hw
    obtain ⟨w', hw', rfl⟩ := Subgroup.mem_map.mp hw
    have hcomm := (Subgroup.mem_centralizer_iff.mp hycent) w' hw'
    exact congrArg L.subtype hcomm
  have hyG_ord : orderOf yG = p :=
    (Subgroup.orderOf_coe y).trans hkord
  have hyG_M : yG ∈ D.M := hLM hyG_L
  have htab := uc22p20w_pRank_psp hT hqK
    (LieModel.statedClassicalModel hmodelQuot (by decide)) hp hp2
  have heS1 : eS (2 ^ n) p = 1 := by
    refine (eS_eq_one_iff Nat.one_le_two_pow).mpr ?_
    have hfac : (2 ^ n) ^ 2 - 1 = (2 ^ n - 1) * (2 ^ n + 1) := by
      simpa [mul_comm] using Nat.sq_sub_sq (2 ^ n) 1
    rw [hfac]
    exact dvd_mul_of_dvd_right hAdd _
  have hrank3 : CFSG.Open.pRank p (⊤ : Subgroup (Bar2 L)) = 3 := by
    rw [htab, uc22p20v_rkSp_of_eS heS1]
  obtain ⟨F, hFld, hFin, hChar, -, ⟨eSp⟩⟩ :=
    CFSG.SeitzReduction.SymplecticPilot.exists_mulEquiv_statedSp_of_lieModel
      (L := Bar2 L) (LieModel.of_quotient_center hZ hmodelQuot)
  letI := hFld
  letI := hFin
  letI := hChar
  have hOut : IsCyclic (Outer (Bar2 L)) :=
    CFSG.SeitzReduction.SymplecticPilot.isCyclic_outer_of_mulEquiv_statedSp
      (K := F) (r := 3) (by norm_num) eSp
  have hrankLt : CFSG.Open.pRank p (⊤ : Subgroup (Bar2 L)) < CFSG.Open.pRank p D.M := by
    rw [hrank3]
    exact core.hM4
  obtain ⟨S, hScent, hSp, hSne, hSE⟩ :=
    exists_isPGroup_le_centralizer_centOverO2 hLM hML hZ hOut hp hp2 core.hOp hrankLt
      hr hr2 hEtildeL hEtildeel.isPGroup
  obtain ⟨kS, hkS⟩ := hSp.exists_card_eq
  have hkSpos : 1 ≤ kS := by
    rcases Nat.eq_zero_or_pos kS with h0 | h
    · rw [h0, pow_zero] at hkS
      exact absurd (Subgroup.card_eq_one.mp hkS) hSne
    · exact h
  have hpdvdS : p ∣ Nat.card S := by
    rw [hkS]
    exact dvd_pow_self p (by omega)
  obtain ⟨zS, hzSord⟩ := exists_prime_orderOf_dvd_card' (G := ↥S) p hpdvdS
  let z : G := (zS : S)
  have hzS : z ∈ S := zS.2
  have hz_ord : orderOf z = p := by simpa [z] using hzSord
  have hzM : z ∈ D.M := (mem_centOverO2_iff.mp (hScent hzS)).1
  have hzCent : ∀ l ∈ L, z * l * z⁻¹ * l⁻¹ ∈ pCoreOf 2 L :=
    (mem_centOverO2_iff.mp (hScent hzS)).2
  have hzCentE : z ∈ Subgroup.centralizer (Etilde : Set G) := hSE hzS
  let H : Subgroup G := D.M ⊓ Subgroup.centralizer (Etilde : Set G)
  have hHN : H ≤ Subgroup.normalizer (L : Set G) := inf_le_left.trans hML
  have hyH : yG ∈ H := ⟨hyG_M, hyG_cent⟩
  have hzH : z ∈ H := ⟨hzM, hzCentE⟩
  have h2 := two_le_pRank_of_centralizing_mod_pCore hp hp2 hZ hHN hyH hzH hyG_L
    hyG_ord hz_ord hzCent
  have h2' : 2 ≤ CFSG.Open.pRank p
      (D.M ⊓ Subgroup.centralizer (Etilde : Set G)) := by
    simpa [H] using h2
  have hcontra := hcentE Etilde hEtildeL hEtildeel hEtildecard
  omega

theorem le_three_of_R17_44_1 {D : Data G} {V₀ V L X : Subgroup G} {p n l : ℕ}
    {C Dc : Subgroup G} {Gamma : Set G} (ctx : Ctx17_42 D V₀ V L X p n l C Dc Gamma)
    (h43 : R17_43At D V₀ V) (h44_1 : R17_44_1AtB D V₀ V)
    (hK3 : Inputs1719.K_BorelTorusAbelianRankGeFour)
    (hK : K_CartanRankLarge) : l ≤ 3 := by
  classical
  obtain ⟨t, m, hadm, hmodel, hrank⟩ := ctx.rank
  by_contra hcon
  have hl4 : 4 ≤ CFSG.LocalAnalysis.UniquenessCase.PartTwo.S17.CS17LieRank t m := by omega
  have hB : Inputs1719.BorelChevOver (BarInf L) n :=
    Inputs1719.BorelChevOver.of_on hK3 hmodel hl4
  let K := Bar2 L
  let π : ↥L →* K := QuotientGroup.mk' (CFSG.pCore 2 ↥L)
  set S : Subgroup K := ((D.T ⊓ L).subgroupOf L).map π with hSdef
  have hL : L ∈ calC D.M := ctx.mem_calC
  have hq : CFSG.Open.IsQuasisimple K := hL.2.2
  have hodd : Odd (Nat.card (Subgroup.center K)) :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p20p_odd_center_bar2 ↥L
  obtain ⟨e⟩ := CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p21k_barInf_equiv_of_calC hL
  have hmodelK : LieModel (K ⧸ Subgroup.center K) t m 2 n :=
    CFSG.Blueprint.LieModel.of_mulEquiv e hmodel
  have hS : CFSG.QuasithinUnique.IsSylowTwoOf S ⊤ := isSylowTwoOf_sylowBar2 hL
  obtain ⟨r, hr, hr2, hrdvd, hrank4⟩ :=
    hK K t m n hadm (h43 L X p n l C Dc Gamma ctx) hmodelK hq hodd S hS hl4
  have hbridge := pRank_normalizerQuotient_le_pRank_cartan hL ctx.cartan hr hr2
  have hO2 : CFSG.pCore 2 ↥L ≤ (D.T ⊓ L).subgroupOf L :=
    pCore_le_sylow_of_mem_calC hL
  have htrans : CFSG.Open.pRank r (⊤ : Subgroup
        (TauCeti.Subgroup.normalizerQuotient ((D.T ⊓ L).subgroupOf L))) =
      CFSG.Open.pRank r (⊤ : Subgroup
        (TauCeti.Subgroup.normalizerQuotient
          (((D.T ⊓ L).subgroupOf L).map π))) :=
    CFSG.SectionRank.pRank_top_eq_of_mulEquiv hr.one_lt
      (CFSG.GroupTheory.normalizerQuotient_quotientEquiv (CFSG.pCore 2 ↥L)
        ((D.T ⊓ L).subgroupOf L) hO2)
  have hDc := pRank_cartan_le_pRank_Dc (ctx := ctx) hr
  have h4 : 3 < CFSG.Open.pRank r (⊤ : Subgroup
      (TauCeti.Subgroup.normalizerQuotient ((D.T ⊓ L).subgroupOf L))) := by
    rw [htrans]
    rwa [hSdef] at hrank4
  have h5 : 3 < CFSG.Open.pRank r C := lt_of_lt_of_le h4 hbridge
  have h6 : 3 < CFSG.Open.pRank r Dc := lt_of_lt_of_le h5 hDc
  have h3 := h44_1 L X p n l C Dc Gamma ctx n hB r hr hr2
  omega

theorem seventeen_fortysix
    {D : Data G} {V₀ V : Subgroup G}
    (h43 : R17_43At D V₀ V) (h45 : R17_45At D V₀ V)
    (hDE : DataExt D) (hSg : UC6S846.SigmaStd D) (h1219 : D.sig = D.sig1)
    (h76 : F07.R76 D) (h614 : UC6.R6_14 D) (h638 : UC6.R6_38 D)
    (h44_1 : R17_44_1AtB D V₀ V) (h44_2 : R17_44_2AtB D V₀ V) (h44_3 : R17_44_3AtB D V₀ V)
    (hN : uc22p20rNativeGriess) (hT : LieOddRankChev) :
    R17_46At D V₀ V := by
  have hK7a : K_CartanSylowAbelian := Inputs1719.k_CartanSylowAbelian_holds
  have hK7c : K_RankThreeCentTorus := Inputs1719.k_RankThreeCentTorus_holds
  have hK3' : Inputs1719.K_BorelTorusAbelianRankGeFour :=
    Inputs1719.k_BorelTorusAbelianRankGeFour_holds
  have hKLarge : Inputs1719.K_CartanRankLarge := Inputs1719.k_CartanRankLarge_holds
  have hK4 : Inputs1719.K_CartanRankLeThree := Inputs1719.k_CartanRankLeThree_of_griess hN
  have hK3 : Inputs1719.K_BorelTorusAbelianRankThreeNotU62 :=
    Inputs1719.k_BorelTorusAbelianRankThreeNotU62_of_griess hN
      (Inputs1719.k_BorelTorusAbelian_OmegaMinusEight_of_griess hN)
  intro L X p n l C Dc Gamma ctx
  by_contra hl2
  have h45' : 1 < l := h45 L X p n l C Dc Gamma ctx
  have hle3 : l ≤ 3 := le_three_of_R17_44_1 ctx h43 h44_1 hK3' hKLarge
  have hl : l = 3 := by omega
  have core : S17_46Core D V₀ V L X p n l C Dc Gamma :=
    s17_46_core ctx hl h43 hDE hSg h1219 h76 h614 h638 h44_1 h44_2 h44_3
      hK3 hK4 hK7a hN
  obtain ⟨t, m, hadm, hmodel, hrk⟩ := ctx.rank
  obtain ⟨hAdd, hshape3⟩ :=
    dvd_add_one_of_core ctx core hl hadm hmodel hrk h43 h44_3 hK3 hK4 hT hN
  rcases hshape3 with hU6 | hSp | hOm
  · exact false_of_core_torus ctx core hadm hmodel hAdd (Or.inl hU6) hK7c
  · exact false_of_core_sp6 ctx core hadm hmodel hAdd hSp hT hN hK7c
  · exact false_of_core_torus ctx core hadm hmodel hAdd (Or.inr hOm) hK7c

end CFSG.LocalAnalysis.UniquenessCase.PartTwo.S17
