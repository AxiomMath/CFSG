    have hOut : CFSG.HasNormalPComplement p (Outer (Bar2 L)) :=
      hasNormalPComplement_outer_of_centerQuotient hcomp
    have h := pRank_le_add_pRank_centOverO2 hLM hML hp hOut core.hOp
    have hM := core.hM4
    have hc := core.centOverO2
    omega
  ·
    by_cases hp3 : p = 3
    · subst hp3
      have hS : StatedClassicalModel (Bar2 L ⧸ Subgroup.center (Bar2 L)) .PSU 6 2 n :=
        LieModel.statedClassicalModel hmodelQuot (by decide)
      have htab := uc22p20w_pRank_psu hT hqK hS Nat.prime_three (by norm_num)
      have hZ3 : Nat.card (Subgroup.center (Bar2 L)) ∣ 3 :=
        card_center_dvd_three_of_psu_six hN hqK hoddK hmodelQuot
      have hZ1 : CFSG.Open.pRank 3 (Subgroup.center (Bar2 L)) ≤ 1 :=
        pRank_center_le_one_of_card_dvd_three Nat.prime_three (by norm_num) hZ3
      have h3 : 3 ∣ 2 ^ n + 1 := by
        have hmod : (2 ^ n + 1) % 3 = 0 := by
          rw [Nat.add_mod, CFSG.two_pow_mod_three_of_odd core.odd_n]
        exact Nat.dvd_iff_mod_eq_zero.mpr hmod
      have heM1 : CFSG.LocalAnalysis.RankThreeUC.S15.eM (2 ^ n) 3 = 1 :=
        eM_eq_one_iff.mpr h3
      have hK4 : 4 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (Bar2 L)) := by
        rw [htab]
        exact uc22p20v_rkLin_false_one (m := 6) heM1
      have h := pRank_quotient_center_ge_sub_one (K := Bar2 L) Nat.prime_three hZ1
      omega
    · have hnice : CFSG.RankThree.PartOne.OutStructure.OutPNice p
          (Bar2 L ⧸ Subgroup.center (Bar2 L)) := by
        refine CFSG.RankThree.PartOne.OutStructure.outPNice_PSU hp (n := 6) (m := n)
          (LieModel.statedClassicalModel hmodelQuot (by decide)) ?_
        intro hd
        have hd6 : p ∣ 6 := hd.trans (Nat.gcd_dvd_left 6 (2 ^ n + 1))
        rw [show 6 = 2 * 3 by norm_num] at hd6
