theorem nineteen_seven_four_le_gamma15 (D : Data G) {V₀ V : Subgroup G} {p : ℕ}
    {L K : Subgroup G} (hV : IsElemAbelian 2 V) (hS : Setting19_7 D V₀ V p L K hV) :
    4 ≤ gamma15 D.M V₀ V hV L := by
  rw [nineteen_seven_case_one_gamma15_eq_rk_wTil D hV hS]
  obtain ⟨x, hx5⟩ := nineteen_seven_case_one_exists_orderOf_five hV hS.l_alt
  have hy5 : orderOf (x : MulAut (Vtil V₀ V hV)) = 5 := (Subgroup.orderOf_coe x).trans hx5
  have hy5' : (x : MulAut (Vtil V₀ V hV)) ^ 5 = 1 := by
    rw [← hy5]
    exact pow_orderOf_eq_one _
  have hsq : ∀ w : Vtil V₀ V hV, w ^ 2 = 1 := s15_Infra_vtil_sq_eq_one V₀ V hV
  have hsq' : ∀ w : ↥(wTil V₀ V hV L), w * w = 1 := fun w => by
    apply Subtype.ext
    show ((w : Vtil V₀ V hV) * (w : Vtil V₀ V hV)) = 1
    have h1 := hsq (w : Vtil V₀ V hV)
    rwa [pow_two] at h1
  have hstab : (x : MulAut (Vtil V₀ V hV)) ∈ stabSub (wTil V₀ V hV L) := by
    refine CFSG.Quasithin.StabLat.mem_stabSub_commSub ?_ (Subgroup.le_normalizer x.2)
    rw [CFSG.Quasithin.mem_stabSub]
    intro u
    simp
  have hpsi5 : (resHom (wTil V₀ V hV L) ⟨(x : MulAut (Vtil V₀ V hV)), hstab⟩) ^ 5 = 1 := by
    rw [← map_pow, show (⟨(x : MulAut (Vtil V₀ V hV)), hstab⟩ :
      ↥(stabSub (wTil V₀ V hV L))) ^ 5 = 1 from Subtype.ext hy5', map_one]
  have hpsine : resHom (wTil V₀ V hV L) ⟨(x : MulAut (Vtil V₀ V hV)), hstab⟩ ≠ 1 := by
    intro h1
    have hfix : ∀ u : Vtil V₀ V hV, u ∈ wTil V₀ V hV L →
        (x : MulAut (Vtil V₀ V hV)) u = u := by
      intro u hu
      have h2 : resHom (wTil V₀ V hV L) ⟨(x : MulAut (Vtil V₀ V hV)), hstab⟩ ⟨u, hu⟩ =
          ⟨u, hu⟩ := by rw [h1]; rfl
      have h3 := congrArg (fun v : ↥(wTil V₀ V hV L) => (v : Vtil V₀ V hV)) h2
      rwa [CFSG.Quasithin.resHom_apply] at h3
    have hKC : Subgroup.zpowers (x : MulAut (Vtil V₀ V hV)) ≤
        centSub (wTil V₀ V hV L) := Subgroup.zpowers_le.mpr hfix
    have hKq : ∀ k ∈ Subgroup.zpowers (x : MulAut (Vtil V₀ V hV)),
        ∀ w : Vtil V₀ V hV, k w * w⁻¹ ∈ wTil V₀ V hV L := by
      intro k hk w
      have hkL : k ∈ barSub V₀ V hV L := Subgroup.zpowers_le.mpr x.2 hk
      exact Subgroup.subset_closure ⟨k, hkL, w, trivial, rfl⟩
    have h2group : IsPGroup 2 ↥(Subgroup.zpowers (x : MulAut (Vtil V₀ V hV))) :=
      s15_Lin_isPGroup_two_of_acts_trivially hsq hKC hKq
    obtain ⟨n, hn⟩ := h2group.exists_card_eq
    rw [Nat.card_zpowers, hy5] at hn
    have h52 : 5 ∣ 2 := Nat.Prime.dvd_of_dvd_pow (by norm_num : Nat.Prime 5) (by rw [← hn])
    exact absurd h52 (by norm_num)
  have hcard : 16 ≤ Nat.card ↥(wTil V₀ V hV L) :=
