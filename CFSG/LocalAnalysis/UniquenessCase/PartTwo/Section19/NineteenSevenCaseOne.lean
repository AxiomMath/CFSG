theorem nineteen_seven_hyp151 (D : Data G) {V₀ V : Subgroup G} {p : ℕ} {L K : Subgroup G}
    (hV : IsElemAbelian 2 V) (hS : Setting19_7 D V₀ V p L K hV)
    (hi : commSub (commSub (⊤ : Subgroup (Vtil V₀ V hV)) (barSub V₀ V hV L))
      (barSub V₀ V hV K) = ⊥) :
    Hyp151 D V₀ V L := by
  have h125 : Hyp125 D V₀ V := hS.ctx.hyp.hyp125
  have hLcal : L ∈ calC D.M := hS.ctx.hyp.hL.1
  have hMs : D.M ≤ stabTil V₀ V :=
    le_stabTil h125.pairFacts.le_normalizer h125.pairFacts.le_normalizer₀
  have hcomp : barSub V₀ V hV L ∈ compBar D.M V₀ V hV :=
    barSub_mem_compBar_of_ne_bot h125 hLcal hS.l_ne
  refine ⟨h125, hLcal.1.le, ?_, ?_, ?_⟩
  · exact CFSG.Quasithin.S151S4.twoResidual_eq_self_of_perfect hLcal.2.1
  · exact fstar_eq_self_of_isQuasisimple hcomp.2.2
  · intro g hgM hgn
    have hgs : g ∈ stabTil V₀ V := hMs hgM
    have hgs' : g⁻¹ ∈ stabTil V₀ V := (stabTil V₀ V).inv_mem hgs
    have hφ : actTil V₀ V hV ⟨g⁻¹, hgs'⟩ ∈ Mbar D.M V₀ V hV :=
      actTil_mem_barSub V₀ V hV (D.M.inv_mem hgM) hgs'
    have hv : (actTil V₀ V hV ⟨g, hgs⟩)⁻¹ = actTil V₀ V hV ⟨g⁻¹, hgs'⟩ := by
      rw [show (⟨g⁻¹, hgs'⟩ : stabTil V₀ V) = (⟨g, hgs⟩ : stabTil V₀ V)⁻¹ from rfl,
        map_inv]
    have hconj : barSub V₀ V hV (conjSubgroup L g) =
        (barSub V₀ V hV L).map (MulAut.conj (actTil V₀ V hV ⟨g⁻¹, hgs'⟩)).toMonoidHom := by
      rw [s15_Infra_barSub_conjSubgroup V₀ V hV hgs L, hv]
    have hne : barSub V₀ V hV (conjSubgroup L g) ≠ barSub V₀ V hV L := fun heq =>
      hgn ((s15_Infra_mem_nBar_iff h125 hV hgM).2 heq)
    have hKb : barSub V₀ V hV (conjSubgroup L g) = barSub V₀ V hV K := by
      rcases nineteen_seven_map_conj_eq D hV hS hφ with h | h
      · exact absurd (hconj.trans h) hne
      · exact hconj.trans h
    rw [hKb]
    exact ⟨hS.comm, hi⟩

theorem nineteen_seven_s15_eq_two (D : Data G) {V₀ V : Subgroup G} {p : ℕ} {L K : Subgroup G}
    (hV : IsElemAbelian 2 V) (hS : Setting19_7 D V₀ V p L K hV) :
    s15 D.M V₀ V hV L = 2 := by
  have hne : barSub V₀ V hV L ≠ barSub V₀ V hV K := by
    intro heq
    have hcomm' : ⁅barSub V₀ V hV L, barSub V₀ V hV L⁆ = ⊥ := by
      have h2 := hS.comm
      rwa [← heq] at h2
    have hcomm : IsMulCommutative ↥(barSub V₀ V hV L) :=
      Subgroup.le_centralizer_iff_isMulCommutative.mp
        (Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcomm')
    have hcomp : barSub V₀ V hV L ∈ compBar D.M V₀ V hV :=
      barSub_mem_compBar_of_ne_bot hS.ctx.hyp.hyp125 hS.ctx.hyp.hL.1 hS.l_ne
    have hqL : CFSG.IsQuasisimple ↥(barSub V₀ V hV L) :=
      CFSG.Quasithin.A3.isQuasisimple_iff_open.mpr hcomp.2.2
    exact CFSG.Quasithin.Insp9.qs_not_commutative hqL (isMulCommutative_iff.mp hcomm)
  have hset : {X : Subgroup (MulAut (Vtil V₀ V hV)) | ∃ φ ∈ Mbar D.M V₀ V hV,
      X = (barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom} =
      {barSub V₀ V hV L, barSub V₀ V hV K} := by
    ext X
    constructor
    · rintro ⟨φ, hφ, rfl⟩
      rcases nineteen_seven_map_conj_eq D hV hS hφ with h | h
      · exact Or.inl h
      · exact Or.inr h
    · rintro (rfl | rfl)
      · refine ⟨1, (Mbar D.M V₀ V hV).one_mem, ?_⟩
        have hone : (MulEquiv.toMonoidHom (MulAut.conj (1 : MulAut (Vtil V₀ V hV)))) =
            MonoidHom.id _ := by
          rw [show MulAut.conj (1 : MulAut (Vtil V₀ V hV)) = 1 from map_one _]
          rfl
        rw [hone, Subgroup.map_id]
      · obtain ⟨g, hg, hgK⟩ := hS.conj
        exact ⟨g, hg, hgK⟩
  unfold s15
  rw [hset, Set.ncard_pair hne]

theorem nineteen_seven_hyp154_kbar_perfect (D : Data G) {V₀ V : Subgroup G} {p : ℕ}
    {L K : Subgroup G} (hV : IsElemAbelian 2 V) (hS : Setting19_7 D V₀ V p L K hV) :
    Group.IsPerfect ↥(barSub V₀ V hV K) := by
  have hMs : D.M ≤ stabTil V₀ V :=
    le_stabTil hS.ctx.hyp.hyp125.pairFacts.le_normalizer
      hS.ctx.hyp.hyp125.pairFacts.le_normalizer₀
  have hKst : K ≤ stabTil V₀ V := (s13_le_of_mem_calC hS.ctx.hK).trans hMs
  haveI : Group.IsPerfect ↥K := Subgroup.isPerfect_iff.mpr hS.ctx.hK.2.1
  let ψ : ↥K →* MulAut (Vtil V₀ V hV) :=
    (actTil V₀ V hV).comp (Subgroup.inclusion hKst)
  have hrange : ψ.range = barSub V₀ V hV K := by
    ext φ
    rw [MonoidHom.mem_range, mem_barSub]
    constructor
    · rintro ⟨k, rfl⟩
      exact ⟨⟨(k : G), hKst k.2⟩, k.2, rfl⟩
    · rintro ⟨g, hg, hφ⟩
      exact ⟨⟨(g : G), hg⟩, hφ⟩
  exact hrange ▸ Group.IsPerfect.range ψ

theorem nineteen_seven_hyp154_five_dvd_kbar (D : Data G) {V₀ V : Subgroup G} {p : ℕ}
