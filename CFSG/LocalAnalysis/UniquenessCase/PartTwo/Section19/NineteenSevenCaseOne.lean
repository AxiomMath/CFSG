theorem nineteen_seven_hyp154_third_intersection_eq_bot (D : Data G) {V₀ V : Subgroup G}
    {p : ℕ} {L K : Subgroup G} (hV : IsElemAbelian 2 V)
    (hS : Setting19_7 D V₀ V p L K hV) (h3 : R19_3At D V₀ V p L K hS.ctx)
    (h5 : R19_5At D V₀ V p L K hS.ctx) (hSg : UC6S846.SigmaStd D)
    (h1219 : D.sig = D.sig1)
    (huniq : ∀ w ∈ wSub V₀ V hV L ⊔ v1Sub D.M V₀ V hV L, w ≠ 1 →
      UniqueMax D.M (D.M ⊓ centralizer ({w} : Set G))) :
    ∀ g : G, g ∉ D.M → ∀ X ∈ wConj D.M V₀ V hV L, ∀ Y ∈ wConj D.M V₀ V hV L,
      (X ⊔ Y ⊔ v1Sub D.M V₀ V hV L) ⊓
        conjSubgroup (wSub V₀ V hV L ⊔ v1Sub D.M V₀ V hV L) g = ⊥ := by
