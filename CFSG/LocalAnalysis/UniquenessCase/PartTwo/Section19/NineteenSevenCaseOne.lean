theorem nineteen_seven_case_one_card_barSub_eq_sixty {V₀ V : Subgroup G}
    (hV : IsElemAbelian 2 V) {L : Subgroup G} (h : IsAlt ↥(barSub V₀ V hV L) 5) :
    Nat.card ↥(barSub V₀ V hV L) = 60 := by
  obtain ⟨e⟩ := h
  rw [Nat.card_congr e.toEquiv, nat_card_alternatingGroup]
  norm_num [Nat.factorial]

theorem nineteen_seven_case_one_exists_orderOf_five {V₀ V : Subgroup G}
    (hV : IsElemAbelian 2 V) {L : Subgroup G} (h : IsAlt ↥(barSub V₀ V hV L) 5) :
    ∃ x : ↥(barSub V₀ V hV L), orderOf x = 5 := by
  have hcard := nineteen_seven_case_one_card_barSub_eq_sixty hV h
  exact exists_prime_orderOf_dvd_card' 5 (by rw [hcard]; norm_num)

theorem nineteen_seven_case_one_gamma15_eq_rk_wTil (D : Data G) {V₀ V : Subgroup G} {p : ℕ}
    {L K : Subgroup G} (hV : IsElemAbelian 2 V) (hS : Setting19_7 D V₀ V p L K hV) :
    gamma15 D.M V₀ V hV L = rk ↥(wTil V₀ V hV L) := by
  have h0 : V₀ ≠ ⊥ := by
    intro h
    have h1 : mSub V₀ = 0 := by
      rw [h, mSub, rk]
      simp
    have h2 := hS.ctx.hyp.big
    omega
  have hsub : imgTil V₀ V hV (wSub V₀ V hV L) = wTil V₀ V hV L := by
    unfold wSub
    exact imgTil_preTil V₀ V hV (wTil V₀ V hV L)
  have hkey : ∀ (V₁ : Subgroup G), V₁ = V₀ →
      rk ↥(imgTil V₁ V hV (wSub V₀ V hV L)) = rk ↥(wTil V₀ V hV L) := by
    rintro V₁ rfl
    rw [hsub]
  show rk ↥(wStar D.M V₀ V hV L) = rk ↥(wTil V₀ V hV L)
  exact hkey (v1Sub D.M V₀ V hV L) (v1Sub_of_ne_bot D.M V₀ V hV L h0)

theorem nineteen_seven_case_one_isSimpleGroup_of_isAlt {X : Type} [Group X]
    (h : CFSG.LocalAnalysis.UniquenessCase.UC22.IsAlt X 5) : IsSimpleGroup X := by
  obtain ⟨e⟩ := h
  haveI : IsSimpleGroup (alternatingGroup (Fin 5)) :=
    alternatingGroup.isSimpleGroup (by norm_num : 5 ≤ Nat.card (Fin 5))
  exact e.isSimpleGroup

theorem nineteen_seven_case_one_normal_left_aux {X : Type*} [Group X]
    {A B : Subgroup (MulAut X)} (hcomm : ⁅A, B⁆ = ⊥) :
    ∀ x ∈ A, ∀ h ∈ A ⊔ B, h * x * h⁻¹ ∈ A := by
  have hHle : A ⊔ B ≤ Subgroup.normalizer (A : Set (MulAut X)) := by
    refine sup_le Subgroup.le_normalizer ?_
    exact (Subgroup.le_centralizer_iff.mpr
      (Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcomm)).trans
      (Subgroup.centralizer_le_normalizer (A : Set (MulAut X)))
  intro x hx h hh
  have hh' : A.map (MulAut.conj h).toMonoidHom = A :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp (hHle hh)
  have hx' : MulAut.conj h x ∈ A.map (MulAut.conj h).toMonoidHom :=
    Subgroup.mem_map_of_mem _ hx
  rw [hh'] at hx'
  rwa [MulAut.conj_apply] at hx'

theorem nineteen_seven_case_one_normal_right_aux {X : Type*} [Group X]
    {A B : Subgroup (MulAut X)} (hcomm : ⁅A, B⁆ = ⊥) :
    ∀ x ∈ B, ∀ h ∈ A ⊔ B, h * x * h⁻¹ ∈ B := by
  have hcomm' : ⁅B, A⁆ = ⊥ := by rw [Subgroup.commutator_comm]; exact hcomm
  have h := nineteen_seven_case_one_normal_left_aux (A := B) (B := A) hcomm'
  rwa [sup_comm] at h

theorem nineteen_seven_case_one_normal_map_conj_aux {X : Type*} [Group X]
    {A H : Subgroup (MulAut X)} {φ : MulAut X} (hAH : A ≤ H)
    (hA : ∀ x ∈ A, ∀ h ∈ H, h * x * h⁻¹ ∈ A)
    (hHφ : ∀ h ∈ H, φ⁻¹ * h * φ ∈ H) :
    ∀ n ∈ A.map (MulAut.conj φ).toMonoidHom, ∀ h ∈ H,
      h * n * h⁻¹ ∈ A.map (MulAut.conj φ).toMonoidHom := by
  intro n hn h hh
  obtain ⟨l, hl, rfl⟩ := Subgroup.mem_map.mp hn
  have hh' : φ⁻¹ * h * φ ∈ H := hHφ h hh
  refine Subgroup.mem_map.mpr ⟨φ⁻¹ * h * φ * l * (φ⁻¹ * h * φ)⁻¹, hA l hl _ hh', ?_⟩
  simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
  group

theorem nineteen_seven_case_one_centralizes_of_inf_bot {X : Type*} [Group X]
    {A H N : Subgroup (MulAut X)} (hAH : A ≤ H) (hNH : N ≤ H)
    (hA : ∀ x ∈ A, ∀ h ∈ H, h * x * h⁻¹ ∈ A)
    (hN : ∀ x ∈ N, ∀ h ∈ H, h * x * h⁻¹ ∈ N)
    (hbot : N ⊓ A = ⊥) : ∀ n ∈ N, ∀ a ∈ A, n * a = a * n := by
  intro n hn a ha
  have h1 : ⁅n, a⁆ ∈ N := by
    have h2 : a * n⁻¹ * a⁻¹ ∈ N := hN n⁻¹ (N.inv_mem hn) a (hAH ha)
    have h3 : n * (a * n⁻¹ * a⁻¹) ∈ N := N.mul_mem hn h2
    rwa [show n * (a * n⁻¹ * a⁻¹) = ⁅n, a⁆ by rw [commutatorElement_def]; group] at h3
  have h2 : ⁅n, a⁆ ∈ A := by
    have h3 : n * a * n⁻¹ ∈ A := hA a ha n (hNH hn)
    have h4 : n * a * n⁻¹ * a⁻¹ ∈ A := A.mul_mem h3 (A.inv_mem ha)
    rwa [show n * a * n⁻¹ * a⁻¹ = ⁅n, a⁆ by rw [commutatorElement_def]] at h4
  have h5 : ⁅n, a⁆ ∈ N ⊓ A := ⟨h1, h2⟩
  rw [hbot] at h5
  exact commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp h5)

theorem nineteen_seven_map_conj_eq (D : Data G) {V₀ V : Subgroup G} {p : ℕ} {L K : Subgroup G}
    (hV : IsElemAbelian 2 V) (hS : Setting19_7 D V₀ V p L K hV) {φ : MulAut (Vtil V₀ V hV)}
    (hφ : φ ∈ Mbar D.M V₀ V hV) :
    (barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom = barSub V₀ V hV L ∨
      (barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom = barSub V₀ V hV K := by
  have hMbmap : (Mbar D.M V₀ V hV).map (MulAut.conj φ).toMonoidHom
      = Mbar D.M V₀ V hV := by
    refine Subgroup.eq_of_le_of_card_ge ?_ ?_
    · intro x hx
      obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hx
      exact (Mbar D.M V₀ V hV).mul_mem
        ((Mbar D.M V₀ V hV).mul_mem hφ hy) ((Mbar D.M V₀ V hV).inv_mem hφ)
    · rw [Subgroup.card_map_of_injective (MulAut.conj φ).injective]
  have hopp : (Opp 3 (Mbar D.M V₀ V hV)).map (MulAut.conj φ).toMonoidHom
      = Opp 3 (Mbar D.M V₀ V hV) := by
    unfold Opp
    rw [s13_pElementSubgroup_map (by norm_num) (MulAut.conj φ).toMonoidHom, hMbmap]
  have hHmap : (barSub V₀ V hV L ⊔ barSub V₀ V hV K).map (MulAut.conj φ).toMonoidHom
      = barSub V₀ V hV L ⊔ barSub V₀ V hV K := by
    rw [← hS.opp3, hopp]
  have hNle : (barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom
      ≤ barSub V₀ V hV L ⊔ barSub V₀ V hV K := by
    have h1 : (barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom
        ≤ (Opp 3 (Mbar D.M V₀ V hV)).map (MulAut.conj φ).toMonoidHom :=
      Subgroup.map_mono (hS.opp3 ▸ le_sup_left)
    rwa [hopp, hS.opp3] at h1
  have hLnorm := nineteen_seven_case_one_normal_left_aux (X := Vtil V₀ V hV)
    (A := barSub V₀ V hV L) (B := barSub V₀ V hV K) hS.comm
  have hKnorm := nineteen_seven_case_one_normal_right_aux (X := Vtil V₀ V hV)
    (A := barSub V₀ V hV L) (B := barSub V₀ V hV K) hS.comm
  have hHφ : ∀ h ∈ barSub V₀ V hV L ⊔ barSub V₀ V hV K,
      φ⁻¹ * h * φ ∈ barSub V₀ V hV L ⊔ barSub V₀ V hV K := by
    intro h hh
    obtain ⟨a, ha, haeq⟩ := Subgroup.mem_map.mp (hHmap ▸ hh)
    have hthis : φ⁻¹ * h * φ = a := by
      have h1 : (MulEquiv.toMonoidHom (MulAut.conj φ)) a = h := haeq
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at h1
      rw [← h1]
      group
    rwa [hthis]
  have hNnorm := nineteen_seven_case_one_normal_map_conj_aux (X := Vtil V₀ V hV)
    (A := barSub V₀ V hV L) (H := barSub V₀ V hV L ⊔ barSub V₀ V hV K) (φ := φ)
    le_sup_left hLnorm hHφ
  have hsimpleN : IsSimpleGroup ↥((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom) := by
    refine nineteen_seven_case_one_isSimpleGroup_of_isAlt ?_
    obtain ⟨e⟩ := hS.l_alt
    exact ⟨(MulEquiv.subgroupMap (MulAut.conj φ) (barSub V₀ V hV L)).symm.trans e⟩
  have hNLnormal : (((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom ⊓
      barSub V₀ V hV L).subgroupOf
      ((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom)).Normal := by
    refine ⟨fun x hx g => ?_⟩
    rw [Subgroup.mem_subgroupOf] at hx ⊢
    exact ⟨((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom).mul_mem
        (((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom).mul_mem g.2 hx.1)
        (((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom).inv_mem g.2),
      hLnorm x hx.2 _ (hNle g.2)⟩
  have hNKnormal : (((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom ⊓
      barSub V₀ V hV K).subgroupOf
      ((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom)).Normal := by
    refine ⟨fun x hx g => ?_⟩
    rw [Subgroup.mem_subgroupOf] at hx ⊢
    exact ⟨((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom).mul_mem
        (((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom).mul_mem g.2 hx.1)
        (((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom).inv_mem g.2),
      hKnorm x hx.2 _ (hNle g.2)⟩
  have hNL : ((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom ⊓ barSub V₀ V hV L = ⊥) ∨
      ((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom ≤ barSub V₀ V hV L) := by
    haveI := hsimpleN
    haveI := hNLnormal
    obtain h | h := Subgroup.Normal.eq_bot_or_eq_top
      (((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom ⊓ barSub V₀ V hV L).subgroupOf
        ((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom))
    · left
      have hd := Subgroup.subgroupOf_eq_bot.mp h
      rw [disjoint_iff] at hd
      rwa [inf_right_comm, inf_idem] at hd
    · right
      intro x hx
      exact (Subgroup.subgroupOf_eq_top.mp h hx).2
  have hNK : ((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom ⊓ barSub V₀ V hV K = ⊥) ∨
      ((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom ≤ barSub V₀ V hV K) := by
    haveI := hsimpleN
    haveI := hNKnormal
    obtain h | h := Subgroup.Normal.eq_bot_or_eq_top
      (((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom ⊓ barSub V₀ V hV K).subgroupOf
        ((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom))
    · left
      have hd := Subgroup.subgroupOf_eq_bot.mp h
      rw [disjoint_iff] at hd
      rwa [inf_right_comm, inf_idem] at hd
    · right
      intro x hx
      exact (Subgroup.subgroupOf_eq_top.mp h hx).2
  have hcardN : Nat.card ↥((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom)
      = Nat.card ↥(barSub V₀ V hV L) :=
    Subgroup.card_map_of_injective (MulAut.conj φ).injective
  rcases hNL with hNLbot | hNLle
  · rcases hNK with hNKbot | hNKle
    · exfalso
      have hcentL := nineteen_seven_case_one_centralizes_of_inf_bot (X := Vtil V₀ V hV)
        (A := barSub V₀ V hV L) (H := barSub V₀ V hV L ⊔ barSub V₀ V hV K)
        (N := (barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom)
        le_sup_left hNle hLnorm hNnorm hNLbot
      have hcentK := nineteen_seven_case_one_centralizes_of_inf_bot (X := Vtil V₀ V hV)
        (A := barSub V₀ V hV K) (H := barSub V₀ V hV L ⊔ barSub V₀ V hV K)
        (N := (barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom)
        le_sup_right hNle hKnorm hNnorm hNKbot
      have hNcentL : (barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom ≤
          Subgroup.centralizer (barSub V₀ V hV L : Set (MulAut (Vtil V₀ V hV))) := by
        intro n hn
        exact Subgroup.mem_centralizer_iff.mpr fun a ha => (hcentL n hn a ha).symm
      have hNcentK : (barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom ≤
          Subgroup.centralizer (barSub V₀ V hV K : Set (MulAut (Vtil V₀ V hV))) := by
        intro n hn
        exact Subgroup.mem_centralizer_iff.mpr fun a ha => (hcentK n hn a ha).symm
      have hNcent : (barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom ≤
          Subgroup.centralizer ((barSub V₀ V hV L ⊔ barSub V₀ V hV K :
            Subgroup (MulAut (Vtil V₀ V hV))) : Set (MulAut (Vtil V₀ V hV))) :=
        le_centralizer_sup_of_le_centralizers hNcentL hNcentK
      have hcommN : IsMulCommutative
          ↥((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom) := by
        refine Subgroup.le_centralizer_iff_isMulCommutative.mp (hNcent.trans ?_)
        exact Subgroup.centralizer_le (fun x hx => hNle hx)
      have hqN : CFSG.IsQuasisimple
          ↥((barSub V₀ V hV L).map (MulAut.conj φ).toMonoidHom) := by
        have hcomp : barSub V₀ V hV L ∈ compBar D.M V₀ V hV :=
          barSub_mem_compBar_of_ne_bot hS.ctx.hyp.hyp125 hS.ctx.hyp.hL.1 hS.l_ne
        have hqL : CFSG.IsQuasisimple ↥(barSub V₀ V hV L) :=
          CFSG.Quasithin.A3.isQuasisimple_iff_open.mpr hcomp.2.2
        exact CFSG.IsQuasisimple.of_mulEquiv
          (MulEquiv.subgroupMap (MulAut.conj φ) (barSub V₀ V hV L)).symm hqL
      exact CFSG.Quasithin.Insp9.qs_not_commutative hqN (isMulCommutative_iff.mp hcommN)
    · right
      refine Subgroup.eq_of_le_of_card_ge hNKle ?_
      rw [hcardN, nineteen_seven_case_one_card_barSub_eq_sixty hV hS.k_alt,
        nineteen_seven_case_one_card_barSub_eq_sixty hV hS.l_alt]
  · left
    refine Subgroup.eq_of_le_of_card_ge hNLle ?_
