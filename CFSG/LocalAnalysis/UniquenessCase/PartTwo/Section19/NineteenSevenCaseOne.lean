  have hcent : ∀ v ∈ V, v ≠ 1 →
      1 ≤ CFSG.Open.pRank p (D.M ⊓ centralizer ({v} : Set G)) := by
    rw [hS.ctx.p_eq]
    exact nineteen_seven_one_le_pRank_centralizer D hS.ctx h3 h5 hS.five_dvd
  have hU : ∀ u ∈ wSub V₀ V hV L ⊔ v1Sub D.M V₀ V hV L, u ≠ 1 →
      centralizer ({u} : Set G) ≤ D.M := by
    intro u hu hu1
    have huV : u ∈ V := c23_wSub_sup_v1Sub_le D hS.ctx.hyp.hyp125 hV hu
    have hu2 : ∃ n : ℕ, u ^ 2 ^ n = 1 := ⟨1, by simpa using hV.2 u huV⟩
    exact (centralizer_le_of_uniqueMax D.maxLocal hu1 hu2 (huniq u hu hu1)).1
  have hbot := nineteen_seven_conj_inf_eq_bot D hSg h1219
    (U := wSub V₀ V hV L ⊔ v1Sub D.M V₀ V hV L) (V := V) hS.ctx.hyp.hp hcent hU g hg
  obtain ⟨mx, hmx, rfl⟩ := hX
  obtain ⟨my, hmy, rfl⟩ := hY
  have hXV : conjSubgroup (wSub V₀ V hV L) mx ≤ V :=
    s15_Tools_conj_wSub_le D hS.ctx.hyp.hyp125 hV hmx
  have hYV : conjSubgroup (wSub V₀ V hV L) my ≤ V :=
    s15_Tools_conj_wSub_le D hS.ctx.hyp.hyp125 hV hmy
  have hV1V : v1Sub D.M V₀ V hV L ≤ V := s15_Infra_v1Sub_le hS.ctx.hyp.hyp125 hV
  have hXYV : conjSubgroup (wSub V₀ V hV L) mx ⊔
      conjSubgroup (wSub V₀ V hV L) my ⊔ v1Sub D.M V₀ V hV L ≤ V :=
    sup_le (sup_le hXV hYV) hV1V
  have hbot' : V ⊓ conjSubgroup (wSub V₀ V hV L ⊔ v1Sub D.M V₀ V hV L) g = ⊥ := by
    rw [inf_comm]
    exact hbot
  exact le_bot_iff.mp (hbot' ▸ inf_le_inf_right _ hXYV)

theorem nineteen_seven_hyp154 (D : Data G) {V₀ V : Subgroup G} {p : ℕ} {L K : Subgroup G}
