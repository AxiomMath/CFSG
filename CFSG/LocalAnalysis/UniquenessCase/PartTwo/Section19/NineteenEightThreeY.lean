theorem exists_five_elem_of_bar (D : Data G) {f : Bar2 D.M} (hf5 : orderOf f = 5)
    (hfn : ∀ m : Bar2 D.M, m * f * m⁻¹ ∈ Subgroup.zpowers f) :
    ∃ y ∈ D.M, orderOf y = 5 ∧ Permutes (Subgroup.zpowers y) D.T ∧
      InFSq 2 (Subgroup.zpowers y ⊔ D.T) ∧
      UC22.conjClosure D.M (Subgroup.zpowers y) ≤
        CFSG.Quasithin.twoResidual (Subgroup.zpowers y ⊔ D.T) ∧
      ∀ J : Subgroup G, J ≤ D.M → ⁅J, J⁆ = J →
        ⁅Subgroup.zpowers y, J⁆ ≤ pCoreOf 2 D.M := by
  classical
  have : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  have hker : (uc22p21cPi D.M).ker = CFSG.pCore 2 ↥D.M := QuotientGroup.ker_mk' _
  have hker2 : IsPGroup 2 (uc22p21cPi D.M).ker := by
    rw [hker]
    exact CFSG.pCore_isPGroup (p := 2) (G := ↥D.M)
  have hQb : IsPGroup 5 (Subgroup.zpowers f) := by
    refine IsPGroup.of_card (n := 1) ?_
    rw [Nat.card_zpowers, hf5, pow_one]
  obtain ⟨Q, -, hQmap, hQdisj⟩ := UC6S846.exists_lift_pGroup (uc22p21cPi D.M)
    (uc22p21c_pi_surjective D.M) hker2 Nat.prime_five (by norm_num) _ hQb
  have hQcard : Nat.card Q = 5 := by
    rw [← UC6S846.card_map_of_disjoint_ker (uc22p21cPi D.M) Q hQdisj, hQmap, Nat.card_zpowers,
      hf5]
  have hfmem : f ∈ Q.map (uc22p21cPi D.M) := by rw [hQmap]; exact Subgroup.mem_zpowers f
  obtain ⟨y₀, hy₀Q, hy₀f⟩ := Subgroup.mem_map.1 hfmem
  have hy₀5 : orderOf y₀ = 5 := by
    have hdvd : orderOf y₀ ∣ 5 := by
      rw [← hQcard]
      exact Subgroup.orderOf_dvd_natCard Q hy₀Q
    rcases (Nat.dvd_prime Nat.prime_five).1 hdvd with h1 | h1
    · exfalso
      rw [orderOf_eq_one_iff] at h1
      rw [h1, map_one] at hy₀f
      rw [← hy₀f, orderOf_one] at hf5
      omega
    · exact h1
  have hy5 : orderOf (y₀ : G) = 5 := by rw [Subgroup.orderOf_coe, hy₀5]
  have hfnorm : (Subgroup.zpowers f).Normal := by
    refine ⟨fun n hn m => ?_⟩
    obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp hn
    rw [← conj_zpow]
    exact Subgroup.zpow_mem _ (hfn m) i
  have hY₀M : barPreimage D.M (Subgroup.zpowers f) ≤ D.M := fun x hx =>
    (uc22p21c_mem_barPreimage.1 hx).1
  have hMY₀ : D.M ≤ normalizer (barPreimage D.M (Subgroup.zpowers f) : Set G) :=
    uc22p22u_barPreimage_normalizes
  have hyY₀ : (y₀ : G) ∈ barPreimage D.M (Subgroup.zpowers f) := by
    refine uc22p21c_mem_barPreimage.2 ⟨y₀.2, ?_⟩
    change uc22p21cPi D.M y₀ ∈ Subgroup.zpowers f
    rw [hy₀f]
    exact Subgroup.mem_zpowers f
  have hY₀le : barPreimage D.M (Subgroup.zpowers f) ≤
      Subgroup.zpowers (y₀ : G) ⊔ pCoreOf 2 D.M := by
    intro x hx
    obtain ⟨hxM, hxf⟩ := uc22p21c_mem_barPreimage.1 hx
    obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp hxf
    have hk : (y₀ ^ i)⁻¹ * ⟨x, hxM⟩ ∈ (uc22p21cPi D.M).ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, map_zpow, hy₀f, hi, inv_mul_cancel]
    rw [hker] at hk
    have hx : x = (y₀ : G) ^ i * (((y₀ ^ i)⁻¹ * ⟨x, hxM⟩ : ↥D.M) : G) := by
      simp
    rw [hx]
    exact Subgroup.mul_mem _
      (le_sup_left (a := Subgroup.zpowers (y₀ : G)) (Subgroup.zpow_mem_zpowers _ i))
      (le_sup_right (b := pCoreOf 2 D.M) ⟨_, hk, rfl⟩)
  have hOT : pCoreOf 2 D.M ≤ D.T := uc22p22e_pCoreOf_le_T D
  have hperm := ElevenNine.permutes_of_le_sup_pCore D.sylowM hY₀M hMY₀
    (Subgroup.zpowers_le.2 hyY₀) hY₀le
  have hT2 : IsPGroup 2 D.T := (CFSG.ABGLocalTools.isSylowOf_iff.mp D.sylowM).2.1
  have hF1 : InFSq 1 (Subgroup.zpowers (y₀ : G) ⊔ D.T) :=
    inFSq_one_of_prime_mul_two_group (Subgroup.zpowers (y₀ : G)) D.T 5 Nat.prime_five
      (by decide) (by rw [Nat.card_zpowers, hy5]) hT2 hperm
  have hcl : UC22.conjClosure D.M (Subgroup.zpowers (y₀ : G)) ≤
      CFSG.Quasithin.twoResidual (Subgroup.zpowers (y₀ : G) ⊔ D.T) := by
    refine iSup₂_le fun X hX => ?_
    obtain ⟨g, hgM, rfl⟩ := hX
    rw [Subgroup.map_le_iff_le_comap, Subgroup.zpowers_le, Subgroup.mem_comap]
    change g * (y₀ : G) * g⁻¹ ∈ _
    have hgy : g * (y₀ : G) * g⁻¹ ∈ barPreimage D.M (Subgroup.zpowers f) :=
      (mem_normalizer_iff.1 (hMY₀ hgM) _).1 hyY₀
    refine CFSG.Quasithin.F6.mem_twoResidual_of_odd
      ((hY₀le.trans (sup_le_sup_left hOT _)) hgy) ?_
    have hord : orderOf (g * (y₀ : G) * g⁻¹) = 5 := by
      rw [← hy5]
      exact (SemiconjBy.orderOf_eq g (show g * (y₀ : G) = g * (y₀ : G) * g⁻¹ * g by group)).symm
    rw [hord]
    decide
  have hcomm : ∀ J : Subgroup G, J ≤ D.M → ⁅J, J⁆ = J →
      ⁅Subgroup.zpowers (y₀ : G), J⁆ ≤ pCoreOf 2 D.M := by
    intro J hJM hJp
    have hperfsub : ⁅J.subgroupOf D.M, J.subgroupOf D.M⁆ = J.subgroupOf D.M := by
      apply Subgroup.map_injective D.M.subtype_injective
      rw [Subgroup.map_commutator, Subgroup.subgroupOf_map_subtype, inf_of_le_left hJM]
      exact hJp
    have hperfJb : ⁅(J.subgroupOf D.M).map (uc22p21cPi D.M),
        (J.subgroupOf D.M).map (uc22p21cPi D.M)⁆ = (J.subgroupOf D.M).map (uc22p21cPi D.M) := by
      rw [← Subgroup.map_commutator, hperfsub]
    have hJbN : (J.subgroupOf D.M).map (uc22p21cPi D.M) ≤
        Subgroup.normalizer (Subgroup.zpowers f : Set (Bar2 D.M)) := by
      rw [Subgroup.normalizer_eq_top]
      exact le_top
    have hJbC := CFSG.RankThree.PartTwo.Sec12.le_centralizer_of_isPerfect_of_le_normalizer_zpowers
      (Subgroup.isPerfect_iff.mpr hperfJb) hJbN
    rw [Subgroup.commutator_le]
    intro a ha j hj
    obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp ha
    have hjM : j ∈ D.M := hJM hj
    have hfj : uc22p21cPi D.M ⟨j, hjM⟩ * f = f * uc22p21cPi D.M ⟨j, hjM⟩ :=
      Subgroup.mem_centralizer_singleton_iff.mp
        (hJbC (Subgroup.mem_map_of_mem _ (Subgroup.mem_subgroupOf.2 hj)))
    have hk : ⁅y₀ ^ i, (⟨j, hjM⟩ : ↥D.M)⁆ ∈ (uc22p21cPi D.M).ker := by
      rw [MonoidHom.mem_ker, map_commutatorElement, map_zpow, hy₀f]
      exact commutatorElement_eq_one_iff_mul_comm.2 ((Commute.zpow_left hfj.symm i).eq)
    rw [hker] at hk
    exact ⟨_, hk, by simp [commutatorElement_def]⟩
  exact ⟨(y₀ : G), y₀.2, hy5, hperm, TwelveTwentyTwo.inFSq_mono (by norm_num) hF1, hcl, hcomm⟩

theorem exists_five_elem_19 (D : Data G) {V₀ V : Subgroup G}
    {p : ℕ} {L K : Subgroup G} (h : Ctx19_1 D V₀ V p L K) (h68 : S17.R17_68At D V₀ V)
    (hL2 : IsL2 (Bar2 L) 2) :
    ∃ y ∈ D.M, orderOf y = 5 ∧ Permutes (Subgroup.zpowers y) D.T ∧
      InFSq 2 (Subgroup.zpowers y ⊔ D.T) ∧
      UC22.conjClosure D.M (Subgroup.zpowers y) ≤
        CFSG.Quasithin.twoResidual (Subgroup.zpowers y ⊔ D.T) ∧
      ∀ J : Subgroup G, J ≤ D.M → ⁅J, J⁆ = J →
        ⁅Subgroup.zpowers y, J⁆ ≤ pCoreOf 2 D.M := by
  obtain ⟨f, hf5, hfn⟩ := exists_normal_zpowers_five_bar2 D h h68 hL2
  exact exists_five_elem_of_bar D hf5 hfn

end CFSG.LocalAnalysis.UniquenessCase.PartTwo.S19
