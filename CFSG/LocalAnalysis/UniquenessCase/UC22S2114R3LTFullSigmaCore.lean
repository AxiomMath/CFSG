section Centralizer

variable {G : Type} [Group G] [Finite G]

theorem exists_prime_order_centOverO2_inf_centralizer
    {M L E : Subgroup G} (hLM : L ≤ M) (hML : M ≤ normalizer (L : Set G))
    {p r : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hr : r.Prime) (hr2 : r ≠ 2)
    (hEL : E ≤ L) (hEr : IsPGroup r E)
    (hCp : p ∣ Nat.card (F08.CentOverO2 M L)) :
    ∃ z ∈ F08.CentOverO2 M L, orderOf z = p ∧ z ∈ centralizer (E : Set G) := by
  classical
  let C := F08.CentOverO2 M L
  have hMC : M ≤ normalizer (C : Set G) := by
    rw [show C = F08.CentOverO2 M L from rfl, centOverO2_eq_ker_map hML]
    exact CFSG.GroupTheory.FT63ChII.le_normalizer_map_subtype
      (R := M) ((rhoL L).comp (Subgroup.inclusion hML)).ker
  have hO2C : pCoreOf 2 L ≤ C := by
    intro x hx
    refine mem_centOverO2_iff.mpr
      ⟨hLM ((CFSG.LieType.BorelTits.pCoreOf_le 2 L) hx), ?_⟩
    intro l hl
    have hNl : l ∈ normalizer (pCoreOf 2 L : Set G) :=
      (le_normalizer.trans (normalizer_le_normalizer_pCoreOf L)) hl
    have hconj : l * x⁻¹ * l⁻¹ ∈ pCoreOf 2 L :=
      (Subgroup.mem_normalizer_iff.mp hNl x⁻¹).mp ((pCoreOf 2 L).inv_mem hx)
    simpa only [mul_assoc] using (pCoreOf 2 L).mul_mem hx hconj
  have hEC : E ≤ normalizer (C : Set G) := hEL.trans (hLM.trans hMC)
  have hEO : E ≤ normalizer (pCoreOf 2 L : Set G) :=
    hEL.trans (le_normalizer.trans (normalizer_le_normalizer_pCoreOf L))
  have hcomm : ⁅C, E⁆ ≤ pCoreOf 2 L := by
    rw [Subgroup.commutator_le]
    intro c hc e he
    rw [commutatorElement_def]
    exact (mem_centOverO2_iff.mp hc).2 e (hEL he)
  have hOr : ¬ r ∣ Nat.card (pCoreOf 2 L) :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup (isPGroup_pCoreOf L) hr hr2
  have hOp : ¬ p ∣ Nat.card (pCoreOf 2 L) :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup (isPGroup_pCoreOf L) hp hp2
  have : Fact r.Prime := ⟨hr⟩
  have : Fact p.Prime := ⟨hp⟩
  obtain ⟨P, hP, hPC⟩ :=
    CFSG.GroupTheory.exists_isSylowOf_le_centralizer_of_commutator_le
      (p := r) (q := p) (X := C) (N := pCoreOf 2 L) (R := E)
      hO2C hEC hEO hEr hOr hcomm hOp
  have hPp : p ∣ Nat.card P := by
    rw [hP.card_eq]
    exact dvd_pow_self p
      (hp.factorization_pos_of_dvd Nat.card_pos.ne' hCp).ne'
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' (G := P) p hPp
  exact ⟨z, hP.le z.2, (Subgroup.orderOf_coe z).trans hz, hPC z.2⟩

end Centralizer

section Symplectic

open Matrix CFSG.LocalAnalysis.ComponentInitial.SymplecticTorusWeyl

variable {F : Type} [Field F] [Finite F] {p r : ℕ}

theorem exists_elemAbelian_plane_centralizer_statedSp_three
    (hp : p.Prime) (hpq : p ∣ Nat.card F ^ 2 - 1)
    (hr : r.Prime) (hrq : r ∣ Nat.card F - 1) :
    ∃ E : Subgroup (StatedSp 3 F), IsElemAbelian r E ∧ Nat.card E = r ^ 2 ∧
      ∃ y : StatedSp 3 F, orderOf y = p ∧ y ∈ centralizer (E : Set (StatedSp 3 F)) := by
  classical
  have : Fact r.Prime := ⟨hr⟩
  obtain ⟨ζ, hζ⟩ := exists_prime_orderOf_dvd_card' (G := Fˣ) r (by rwa [Nat.card_units])
  have hprim : IsPrimitiveRoot ζ r := by rw [← hζ]; exact IsPrimitiveRoot.orderOf ζ
  have hμ : Nat.card (rootsOfUnity r F) = r := hprim.card_rootsOfUnity'
  let A := rootsOfUnity r F × rootsOfUnity r F
  let d : A →* (Fin 3 → Fˣ) :=
    MonoidHom.pi fun i => if i = 0 then (rootsOfUnity r F).subtype.comp (MonoidHom.fst _ _)
      else if i = 1 then (rootsOfUnity r F).subtype.comp (MonoidHom.snd _ _) else 1
  have hd : Function.Injective d := by
    intro a b h
    apply Prod.ext
    · exact Subtype.ext (by simpa [d, MonoidHom.fst] using congrFun h 0)
    · exact Subtype.ext (by simpa [d, MonoidHom.snd] using congrFun h 1)
  let ψ : A →* StatedSp 3 F := (torusHom (r := 3) (k := F)).comp d
  have hψ : Function.Injective ψ := torusHom_injective.comp hd
  have hAe : IsElemAbelian r (⊤ : Subgroup A) := by
    refine ⟨inferInstance, fun a _ => ?_⟩
    apply Prod.ext <;> apply Subtype.ext
    · exact (mem_rootsOfUnity r a.1.1).mp a.1.2
    · exact (mem_rootsOfUnity r a.2.1).mp a.2.2
  have hE : IsElemAbelian r ψ.range := by
    rw [MonoidHom.range_eq_map]
    exact hAe.map ψ
  have hcard : Nat.card ψ.range = r ^ 2 := by
    rw [← Nat.card_congr (MonoidHom.ofInjective hψ).toEquiv,
      Nat.card_prod, hμ, pow_two]
  obtain ⟨g, hg⟩ := CFSG.HardMathSupport.Seitz.Proving.exists_orderOf_eq_prime_SL2 hp hpq
  have hgψ : ∀ a : A, Commute (lam (2 : Fin 3) g) (ψ a) := by
    intro a
    have heq : ψ a = lam 0 (sl2Diag a.1.1) * lam 1 (sl2Diag a.2.1) := by
      change torusHom (d a) = _
      rw [lam_sl2Diag, lam_sl2Diag, ← map_mul]
      congr 1
      funext i
      fin_cases i <;> simp [d, MonoidHom.fst, MonoidHom.snd]
    rw [heq]
    exact (commute_lam_lam (by decide) g (sl2Diag a.1.1)).mul_right
      (commute_lam_lam (by decide) g (sl2Diag a.2.1))
  refine ⟨ψ.range, hE, hcard, lam 2 g, (orderOf_lam _ _).trans hg, ?_⟩
  rw [Subgroup.mem_centralizer_iff]
  rintro _ ⟨a, rfl⟩
  exact (hgψ a).eq.symm

theorem exists_elemAbelian_plane_centralizer_of_lieModel_psp_three
    {X : Type} [Group X] [Finite X] {f p r : ℕ}
    (hX : LieModel X .PSp 3 2 f) (hp : p.Prime)
    (hpq : p ∣ (2 ^ f) ^ 2 - 1) (hr : r.Prime) (hrq : r ∣ 2 ^ f - 1) :
    ∃ E : Subgroup X, IsElemAbelian r E ∧ Nat.card E = r ^ 2 ∧
      ∃ y : X, orderOf y = p ∧ y ∈ centralizer (E : Set X) := by
  obtain ⟨F, _, _, _, hF, ⟨e⟩⟩ :=
    CFSG.SeitzReduction.SymplecticPilot.exists_mulEquiv_statedSp_of_lieModel hX
  obtain ⟨E, hEe, hEc, y, hy, hyE⟩ :=
    exists_elemAbelian_plane_centralizer_statedSp_three hp
      (by rwa [hF]) hr (by rwa [hF])
  refine ⟨E.map e.symm.toMonoidHom, hEe.map _, ?_, e.symm y, ?_, ?_⟩
  · rw [Subgroup.card_map_of_injective e.symm.injective, hEc]
  · exact (orderOf_injective e.symm.toMonoidHom e.symm.injective y).trans hy
  · rw [Subgroup.mem_centralizer_iff]
    rintro _ ⟨x, hx, rfl⟩
    change e.symm x * e.symm y = e.symm y * e.symm x
    rw [← map_mul, ← map_mul]
    exact congrArg e.symm ((Subgroup.mem_centralizer_iff.mp hyE) x hx)

end Symplectic

