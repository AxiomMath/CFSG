open Matrix CFSG.ClassicalGroups.SpecialLinear CFSG.RankThree.PartOne.SRC

variable {F : Type} [Field F] [Finite F] {p r : ℕ}

theorem exists_elemAbelian_plane_centralizer_sl_four
    (hp : p.Prime) (hpq : p ∣ Nat.card F ^ 2 - 1)
    (hr : r.Prime) (hrq : r ∣ Nat.card F - 1) :
    ∃ E : Subgroup (SpecialLinearGroup (Fin 4) F),
      IsElemAbelian r E ∧ Nat.card E = r ^ 2 ∧
      ∃ y : SpecialLinearGroup (Fin 4) F, orderOf y = p ∧
        y ∈ centralizer (E : Set (SpecialLinearGroup (Fin 4) F)) := by
  classical
  have : Fact r.Prime := ⟨hr⟩
  obtain ⟨ζ, hζ⟩ := exists_prime_orderOf_dvd_card' (G := Fˣ) r (by rwa [Nat.card_units])
  have hprim : IsPrimitiveRoot ζ r := by rw [← hζ]; exact IsPrimitiveRoot.orderOf ζ
  have hμ : Nat.card (rootsOfUnity r F) = r := hprim.card_rootsOfUnity'
  let A := rootsOfUnity r F × rootsOfUnity r F
  let d : A →* (Fin 4 → Fˣ) :=
    { toFun := fun a => ![a.1.1, a.1.1, a.2.1, (a.1.1 ^ 2 * a.2.1)⁻¹]
      map_one' := by ext i; fin_cases i <;> simp
      map_mul' := by
        rintro ⟨a1, a2⟩ ⟨b1, b2⟩
        ext i
        fin_cases i <;>
          simp [A, mul_pow, _root_.mul_inv_rev, mul_comm, mul_left_comm, mul_assoc] }
  let D : A →* (prodHom 4 F).ker := d.codRestrict _ (by
    intro a
    rw [MonoidHom.mem_ker]
    simp [prodHom, d, Fin.prod_univ_four, pow_two, mul_assoc])
  let ψ : A →* SpecialLinearGroup (Fin 4) F := (diagSLHom 4 F).comp D
  have hψ : Function.Injective ψ := by
    intro a b h
    have h0 := congrArg (fun z : SpecialLinearGroup (Fin 4) F =>
      (z : Matrix (Fin 4) (Fin 4) F) 0 0) h
    have h2 := congrArg (fun z : SpecialLinearGroup (Fin 4) F =>
      (z : Matrix (Fin 4) (Fin 4) F) 2 2) h
    apply Prod.ext <;> apply Subtype.ext <;> apply Units.ext
    · simpa [ψ, D, d] using h0
    · simpa [ψ, D, d] using h2
  have hAe : IsElemAbelian r (⊤ : Subgroup A) := by
    refine ⟨inferInstance, fun a _ => ?_⟩
    apply Prod.ext <;> apply Subtype.ext
    · exact (mem_rootsOfUnity r a.1.1).mp a.1.2
    · exact (mem_rootsOfUnity r a.2.1).mp a.2.2
  have hEe : IsElemAbelian r ψ.range := by
    rw [MonoidHom.range_eq_map]
    exact hAe.map ψ
  have hEc : Nat.card ψ.range = r ^ 2 := by
    rw [← Nat.card_congr (MonoidHom.ofInjective hψ).toEquiv, Nat.card_prod, hμ, pow_two]
  obtain ⟨g, hg⟩ := CFSG.HardMathSupport.Seitz.Proving.exists_orderOf_eq_prime_SL2 hp hpq
  have hcomm : ∀ a : A, Commute (blockHom4 g) (ψ a) := by
    intro a
    ext i j
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul,
      coe_blockHom4]
    change (blockMat4 g * (diagSLHom 4 F (D a) : Matrix (Fin 4) (Fin 4) F)) i j =
      ((diagSLHom 4 F (D a) : Matrix (Fin 4) (Fin 4) F) * blockMat4 g) i j
    rw [coe_diagSLHom, Matrix.mul_diagonal, Matrix.diagonal_mul]
    fin_cases i <;> fin_cases j <;> simp [D, d, blockMat4, mul_comm]
  refine ⟨ψ.range, hEe, hEc, blockHom4 g,
    (orderOf_injective blockHom4 blockHom4_injective g).trans hg, ?_⟩
  rw [mem_centralizer_iff]
  rintro _ ⟨a, rfl⟩
  exact (hcomm a).eq.symm

theorem exists_elemAbelian_plane_centralizer_of_lieModel_psl_four
    {X : Type} [Group X] [Finite X] {f p r : ℕ}
    (hX : LieModel X .PSL 4 2 f) (hp : p.Prime)
    (hpq : p ∣ (2 ^ f) ^ 2 - 1) (hr : r.Prime) (hrq : r ∣ 2 ^ f - 1) :
    ∃ E : Subgroup X, IsElemAbelian r E ∧ Nat.card E = r ^ 2 ∧
      ∃ y : X, orderOf y = p ∧ y ∈ centralizer (E : Set X) := by
  obtain ⟨-, F, _, _, hF, ⟨e⟩⟩ :=
    hX.statedClassicalModel (by decide)
  have : CharP F 2 := CFSG.Timmesfeld.ClassicalOrders.charP_two_of_card_eq hF
  let eSL : X ≃* SpecialLinearGroup (Fin 4) F := e.trans
    ((CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj 4 F).symm.trans
      ((QuotientGroup.quotientMulEquivOfEq
        (CFSG.RankThree.PartOne.center_SL4_eq_bot (F := F))).trans QuotientGroup.quotientBot))
  obtain ⟨E, hEe, hEc, y, hy, hyE⟩ :=
    exists_elemAbelian_plane_centralizer_sl_four hp (by rwa [hF]) hr (by rwa [hF])
  refine ⟨E.map eSL.symm.toMonoidHom, hEe.map _, ?_, eSL.symm y, ?_, ?_⟩
  · rw [Subgroup.card_map_of_injective eSL.symm.injective, hEc]
  · exact (orderOf_injective eSL.symm.toMonoidHom eSL.symm.injective y).trans hy
  · rw [Subgroup.mem_centralizer_iff]
    rintro _ ⟨x, hx, rfl⟩
    change eSL.symm x * eSL.symm y = eSL.symm y * eSL.symm x
    rw [← map_mul, ← map_mul]
    exact congrArg eSL.symm ((Subgroup.mem_centralizer_iff.mp hyE) x hx)

end Linear

section Orthogonal

open Matrix CFSG.ClassicalGroups.Orthogonal
open CFSG.LocalAnalysis.UniquenessCase.PartTwo.Inputs1719

variable {F : Type} [Field F] [Finite F] {b c : F} {p r : ℕ}

theorem exists_elemAbelian_plane_centralizer_statedOmegaMinus_four
    (hp : p.Prime) (hpq : p ∣ Nat.card F ^ 2 - 1)
    (hr : r.Prime) (hr2 : r ≠ 2) (hrq : r ∣ Nat.card F - 1) :
    ∃ E : Subgroup (StatedOmega (StatedQuadMinus 4 F b c)),
      IsElemAbelian r E ∧ Nat.card E = r ^ 2 ∧
      ∃ y : StatedOmega (StatedQuadMinus 4 F b c), orderOf y = p ∧
        y ∈ centralizer (E : Set (StatedOmega (StatedQuadMinus 4 F b c))) := by
  classical
  have : Fact r.Prime := ⟨hr⟩
  have hrodd := hr.odd_of_ne_two hr2
  obtain ⟨ζ, hζ⟩ := exists_prime_orderOf_dvd_card' (G := Fˣ) r (by rwa [Nat.card_units])
  have hζr : ζ ^ r = 1 := by rw [← hζ]; exact pow_orderOf_eq_one ζ
  have hζne : ζ ≠ 1 := fun h => by
    rw [h, orderOf_one] at hζ
    exact hr.ne_one hζ.symm
  let g1 := omG1 (b := b) (c := c) hrodd ζ hζr
  let g2 := omG2 (b := b) (c := c) hrodd ζ hζr
  have hord1 : orderOf g1 = r := orderOf_omG1 hrodd hζr hζne
  have hord2 : orderOf g2 = r := orderOf_omG2 hrodd hζr hζne
  have hcomm : Commute g1 g2 := commute_minusDiagGL hrodd _ _ (omD1_pow hζr) (omD2_pow hζr)
  have hdisj : Disjoint (zpowers g1) (zpowers g2) := disjoint_zpowers_diag hrodd hζr
  have hnot : g2 ∉ zpowers g1 := by
    intro h
    have hbot := (disjoint_iff_inf_le.mp hdisj) ⟨h, mem_zpowers g2⟩
    have heq : g2 = 1 := mem_bot.mp hbot
    rw [heq, orderOf_one] at hord2
    exact hr.ne_one hord2.symm
  obtain ⟨hEe, hEc⟩ := CFSG.LocalAnalysis.RankThreeTheoremC.RankOne.elemAbelian_pair
    hr hord1 hord2 hnot hcomm.eq
  obtain ⟨g, hg⟩ := CFSG.HardMathSupport.Seitz.Proving.exists_orderOf_eq_prime_SL2 hp hpq
  let y := omLevi b c g
  have hcy : zpowers g1 ⊔ zpowers g2 ≤ centralizer ({y} : Set _) := by
    refine sup_le (zpowers_le.mpr ?_) (zpowers_le.mpr ?_) <;>
      rw [mem_centralizer_iff] <;> rintro _ rfl
