  rcases hshape with hX | hX | hX
  · rw [uc22s2114r3l_pRank_eq_rkLin hGA hL hf hX hp hp2]
    by_cases he : eP (2 ^ f) p = 1
    · refine ⟨by simp [rkLin, he], fun _ => ?_⟩
      have hd := (eP_eq_one_iff Nat.one_le_two_pow).mp he
      rw [show (2 ^ f) ^ 2 - 1 = (2 ^ f - 1) * (2 ^ f + 1) by
        simpa [mul_comm] using Nat.sq_sub_sq (2 ^ f) 1]
      exact dvd_mul_of_dvd_left hd _
    · simp only [rkLin, ↓reduceIte, if_neg he]
      refine ⟨(hdivBound he).trans (by norm_num), fun h => ?_⟩
      have h0 : eP (2 ^ f) p ≠ 0 := by intro h0; rw [h0] at h; simp at h
      have hle := hdiv h0 h
      have he2 : eP (2 ^ f) p = 2 := by omega
      exact (eS_eq_one_iff Nat.one_le_two_pow).mp (by
        rw [eS_eq_eP_div_gcd, he2]; norm_num)
  · rw [uc22s2114r3l_pRank_eq_rkSp hGA hL hX hp hp2]
    unfold rkSp
    refine ⟨Nat.div_le_self _ _, fun h => ?_⟩
    have h0 : eS (2 ^ f) p ≠ 0 := by intro h0; rw [h0] at h; simp at h
    have hle := hdiv h0 h
    exact (eS_eq_one_iff Nat.one_le_two_pow).mp (by omega)
  · rw [uc22s2114r3l_pRank_eq_rkOmMinus hGA hL hX hp hp2]
    by_cases he1 : eS (2 ^ f) p = 1
    · have hd : eP (2 ^ f) p ∣ 4 := by
        have hx : ((2 ^ f : ℕ) : ZMod p) ^ 2 = 1 := orderOf_eq_one_iff.mp he1
        exact (orderOf_dvd_of_pow_eq_one hx).trans (by norm_num : 2 ∣ 4)
      simp [rkOmMinus, he1, hd]
      exact (eS_eq_one_iff Nat.one_le_two_pow).mp he1
    · refine ⟨?_, fun h => ?_⟩
      · unfold rkOmMinus
        exact (Nat.sub_le _ _).trans ((hdivBound he1).trans (by norm_num))
      · have h0 : eS (2 ^ f) p ≠ 0 := by
          intro he0
          simp [rkOmMinus, he0] at h
        have he2 : eS (2 ^ f) p ≠ 2 := by
          intro he2
          have hd := rank_eq_two_of_in1512_aux_eS he2
          simp [rkOmMinus, he2, hd] at h
        have hsmall := hdivSmall h0 he1 he2
        have hle : rkOmMinus 4 (2 ^ f) p ≤ 1 :=
