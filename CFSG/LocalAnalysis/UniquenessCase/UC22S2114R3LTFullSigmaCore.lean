    CFSG.Open.pRank p L ≤ 3 ∧
      (2 ≤ CFSG.Open.pRank p L → p ∣ (2 ^ f) ^ 2 - 1) := by
  have hdiv : ∀ {m e : ℕ}, e ≠ 0 → 2 ≤ m / e → 2 * e ≤ m := by
    intro m e he h
    exact (Nat.le_div_iff_mul_le (Nat.pos_of_ne_zero he)).mp h
  have hdivBound : ∀ {e : ℕ}, e ≠ 1 → 4 / e ≤ 2 := by
    intro e he
    rcases Nat.eq_zero_or_pos e with rfl | hepos
    · simp
    · exact Nat.div_le_div_left (by omega : 2 ≤ e) (by norm_num)
  have hdivSmall : ∀ {e : ℕ}, e ≠ 0 → e ≠ 1 → e ≠ 2 → 4 / e ≤ 1 := by
    intro e h0 h1 h2
