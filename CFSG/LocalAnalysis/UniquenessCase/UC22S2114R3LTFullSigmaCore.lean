    {y : Bar2 L} (hy : orderOf y = p) (hyE : y ∈ centralizer (E : Set (Bar2 L))) :
    ∃ Etilde : Subgroup G, Etilde ≤ L ∧ IsElemAbelian r Etilde ∧
      Nat.card Etilde = r ^ 2 ∧
      2 ≤ CFSG.Open.pRank p (M ⊓ centralizer (Etilde : Set G)) := by
  classical
  have : Fact r.Prime := ⟨hr⟩
  obtain ⟨E', Etilde, hE'e, hE'map, hEtilde, hEt, hEtc, -⟩ :=
    PartTwo.S17.exists_lift_elemAbelian_pRank_centralizer hr hr2 hp hp2 hLM hEe hEc
  have hEtL : Etilde ≤ L := hEtilde ▸ Subgroup.map_subtype_le E'
  let π : L →* Bar2 L := QuotientGroup.mk' (CFSG.pCore 2 L)
  have hOr : ¬ r ∣ Nat.card (CFSG.pCore 2 L) :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup CFSG.pCore_isPGroup hr hr2
  have hOp : ¬ p ∣ Nat.card (CFSG.pCore 2 L) :=
    CFSG.GroupTheory.not_dvd_card_of_isPGroup CFSG.pCore_isPGroup hp hp2
  have hmapC := CFSG.Holt.H78.lemma_1_8_centralizer
    (p := r) (CFSG.pCore 2 L) hOr (P := E') hE'e.isPGroup
  have hyMap : y ∈ (centralizer (E' : Set L)).map π := by
    rw [hmapC, hE'map]
    exact hyE
  obtain ⟨x, hxC, hxπ⟩ := hyMap
  have hxp : x ^ p ∈ CFSG.pCore 2 L := by
    apply (QuotientGroup.eq_one_iff _).mp
    change π (x ^ p) = 1
    rw [map_pow, hxπ, ← hy]
    exact pow_orderOf_eq_one y
  have hpow : (x ^ p) ^ Nat.card (CFSG.pCore 2 L) = 1 :=
    congrArg Subtype.val (pow_card_eq_one' (G := CFSG.pCore 2 L) (x := ⟨x ^ p, hxp⟩))
  obtain ⟨k, -, hk⟩ := exists_pow_orderOf_eq_of_coprime_map (φ := π) (x := x) hp
    (by rwa [hxπ]) hpow (hp.coprime_iff_not_dvd.mpr hOp).symm
  let yL : L := x ^ k
  have hyLC : yL ∈ centralizer (E' : Set L) := (centralizer (E' : Set L)).pow_mem hxC k
  have hyGC : (yL : G) ∈ centralizer (Etilde : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro a ha
    rw [hEtilde] at ha
    obtain ⟨a', ha', rfl⟩ := ha
    exact congrArg L.subtype ((Subgroup.mem_centralizer_iff.mp hyLC) a' ha')
  obtain ⟨z, hzC, hzord, hzEt⟩ := exists_prime_order_centOverO2_inf_centralizer
    hLM hML hp hp2 hr hr2 hEtL hEt.isPGroup hCp
  refine ⟨Etilde, hEtL, hEt, hEtc, ?_⟩
  exact two_le_pRank_of_centralizing_mod_pCore hp hp2 hZ (inf_le_left.trans hML)
    ⟨hLM yL.2, hyGC⟩ ⟨(mem_centOverO2_iff.mp hzC).1, hzEt⟩ yL.2
    ((Subgroup.orderOf_coe yL).trans hk) hzord (mem_centOverO2_iff.mp hzC).2

