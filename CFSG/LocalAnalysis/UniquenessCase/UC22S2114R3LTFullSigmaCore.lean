theorem pRank_le_three_and_dvd_sq_sub_one_of_rank_three_model
    (hGA : GriessAllModelsStatement) {M L : Subgroup G} (hL : L ∈ calC M)
    {f p : ℕ} (hf : 2 ≤ f)
    (hshape : LieModel (BarInf L) .PSL 4 2 f ∨ LieModel (BarInf L) .PSp 3 2 f ∨
