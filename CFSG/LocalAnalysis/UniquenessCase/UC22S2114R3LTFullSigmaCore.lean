theorem two_le_pRank_plane_centralizer_of_section_element
    {M L : Subgroup G} (hLM : L ≤ M) (hML : M ≤ normalizer (L : Set G))
    (hZ : center (Bar2 L) = ⊥) {p r : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) (hr : r.Prime) (hr2 : r ≠ 2)
    (hCp : p ∣ Nat.card (F08.CentOverO2 M L))
