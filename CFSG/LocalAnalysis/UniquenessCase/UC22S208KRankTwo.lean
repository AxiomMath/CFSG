theorem s208k_not_isSzL2Product_of_rankTwo (hodd : Odd (Nat.card (center X)))
    (hX : IsL3 X m ∨ IsSL3 X m ∨ IsSp4 X m ∨ IsU4 X m ∨ IsG2 X m ∨ Is3D4 X m ∨
