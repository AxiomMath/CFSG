section TwoCoatoms

variable {X : Type} [Group X]

abbrev S208kTwoCoatoms (V : Subgroup X) : Prop :=
  ∃ P₀ P₁ : Subgroup X, ∀ M : Subgroup X, IsCoatom M → V ≤ M → M = P₀ ∨ M = P₁

theorem s208k_twoCoatoms_mono {V W : Subgroup X} (hVW : V ≤ W) (h : S208kTwoCoatoms V) :
    S208kTwoCoatoms W := by
  obtain ⟨P₀, P₁, h⟩ := h
  exact ⟨P₀, P₁, fun M hM hWM => h M hM (hVW.trans hWM)⟩

theorem s208k_twoCoatoms_of_residual {U : Subgroup X} {P : Fin 2 → Subgroup X}
    (h : CFSG.QuasithinUnique.Setup.X6.ResidualOvergroupsAt X U P) : S208kTwoCoatoms U := by
  refine ⟨P 0, P 1, fun M hM hUM => ?_⟩
  obtain ⟨j, rfl⟩ := (h.2.2.1 M hUM).mp (covBy_top_iff.mpr hM)
  fin_cases j
  · exact Or.inl rfl
  · exact Or.inr rfl

theorem s208k_twoCoatoms_map {Y : Type} [Group Y] (e : X ≃* Y) {V : Subgroup X}
    (h : S208kTwoCoatoms V) : S208kTwoCoatoms (V.map e.toMonoidHom) := by
  obtain ⟨P₀, P₁, h⟩ := h
  refine ⟨P₀.map e.toMonoidHom, P₁.map e.toMonoidHom, fun M hM hVM => ?_⟩
  have hM' : IsCoatom (M.comap e.toMonoidHom) := (Subgroup.isCoatom_comap e).mpr hM
  have hMe : (M.comap e.toMonoidHom).map e.toMonoidHom = M :=
    map_comap_eq_self_of_surjective (f := e.toMonoidHom) e.surjective M
  rcases h _ hM' (map_le_iff_le_comap.mp hVM) with h0 | h0
  · exact Or.inl (by rw [← hMe, h0])
  · exact Or.inr (by rw [← hMe, h0])

private theorem s208k_coe_smul_sylow (g : X) (U : Sylow 2 X) :
    ((g • U : Sylow 2 X) : Subgroup X) = (U : Subgroup X).map (MulAut.conj g).toMonoidHom := by
  ext x
  rw [Sylow.coe_subgroup_smul, Subgroup.mem_pointwise_smul_iff_inv_smul_mem,
    Subgroup.mem_map_equiv]
  rfl

variable [Finite X]

theorem s208k_twoCoatoms_normalizer (U' : Sylow 2 X)
    (h : S208kTwoCoatoms (normalizer ((U' : Subgroup X) : Set X))) (U : Sylow 2 X) :
    S208kTwoCoatoms (normalizer ((U : Subgroup X) : Set X)) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨g, rfl⟩ := MulAction.exists_smul_eq X U' U
  rw [s208k_coe_smul_sylow, ← map_equiv_normalizer_eq]
  exact s208k_twoCoatoms_map (MulAut.conj g) h

theorem s208k_twoCoatoms_of_isPGroup {W : Subgroup X} (hW : IsPGroup 2 W)
    (h : S208kTwoCoatoms W) (U : Sylow 2 X) :
    S208kTwoCoatoms (normalizer ((U : Subgroup X) : Set X)) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨U', hWU'⟩ := hW.exists_le_sylow
  exact s208k_twoCoatoms_normalizer U' (s208k_twoCoatoms_mono (hWU'.trans le_normalizer) h) U

end TwoCoatoms

section TitsSystem

variable {X : Type} [Group X] {B N : Subgroup X} [(cartan B N).Normal] {S : Set (WeylGroup B N)}

theorem s208k_subsingleton_of_twoCoatoms (hbn : IsBNPair B N S) (h2 : S208kTwoCoatoms B)
    {J : Set (WeylGroup B N)} (hJ : J ⊆ S) (hJP : parabolic B N J ≠ ⊤) : J.Subsingleton := by
  intro s hs t ht
  by_contra hst
  have hSJ : ¬ S ⊆ J := fun h => hJP (by rw [Set.Subset.antisymm hJ h, hbn.parabolic_univ])
  obtain ⟨r, hrS, hrJ⟩ := Set.not_subset.mp hSJ
  have hinj : ∀ x ∈ S, ∀ y ∈ S,
      parabolic B N (S \ {x}) = parabolic B N (S \ {y}) → x = y := by
    intro x hx y hy h
    have h' := hbn.parabolic_injOn Set.sdiff_subset Set.sdiff_subset h
    by_contra hxy
    have hxy' : x ∈ S \ {y} := ⟨hx, hxy⟩
    rw [← h'] at hxy'
    exact hxy'.2 rfl
  have hcoat : ∀ x ∈ S, IsCoatom (parabolic B N (S \ {x})) := by
    intro x hx
    refine ⟨fun h => ?_, fun K hK => ?_⟩
    · have h' := hbn.parabolic_injOn Set.sdiff_subset subset_rfl (h.trans hbn.parabolic_univ.symm)
      have hx' : x ∈ S \ {x} := by rw [h']; exact hx
      exact hx'.2 rfl
    · obtain ⟨K', hK', rfl⟩ :=
        hbn.exists_parabolic ((hbn.le_parabolic Set.sdiff_subset).trans hK.le)
      have hsub : S \ {x} ⊆ K' := (hbn.parabolic_le_iff Set.sdiff_subset hK').mp hK.le
      have hxK : x ∈ K' := by
        by_contra hxK
        refine hK.ne (congrArg (parabolic B N) (Set.Subset.antisymm hsub fun y hy => ?_))
        exact ⟨hK' hy, fun hyx => hxK ((Set.mem_singleton_iff.mp hyx) ▸ hy)⟩
      have hK'S : K' = S := by
        refine Set.Subset.antisymm hK' fun y hy => ?_
        by_cases hyx : y = x
        · rw [hyx]
          exact hxK
        · exact hsub ⟨hy, hyx⟩
      rw [hK'S, hbn.parabolic_univ]
  obtain ⟨P₀, P₁, hP⟩ := h2
  have hrs : r ≠ s := fun h => hrJ (h ▸ hs)
  have hrt : r ≠ t := fun h => hrJ (h ▸ ht)
  have hne : ∀ x ∈ S, ∀ y ∈ S, x ≠ y → parabolic B N (S \ {x}) ≠ parabolic B N (S \ {y}) :=
    fun x hx y hy hxy h => hxy (hinj x hx y hy h)
  rcases hP _ (hcoat s (hJ hs)) (hbn.le_parabolic Set.sdiff_subset) with hs' | hs' <;>
  rcases hP _ (hcoat t (hJ ht)) (hbn.le_parabolic Set.sdiff_subset) with ht' | ht' <;>
  rcases hP _ (hcoat r hrS) (hbn.le_parabolic Set.sdiff_subset) with hr' | hr' <;>
  first
    | exact hne s (hJ hs) t (hJ ht) hst (hs'.trans ht'.symm)
    | exact hne r hrS s (hJ hs) hrs (hr'.trans hs'.symm)
    | exact hne r hrS t (hJ ht) hrt (hr'.trans ht'.symm)

end TitsSystem

private theorem s208k_dc_map {X : Type} [Group X] (φ : X ≃* X) {B P : Subgroup X}
    (hdc : ∀ x ∈ P, x ∉ B → ∀ y ∈ P, y ∉ B → ∃ b₁ ∈ B, ∃ b₂ ∈ B, y = b₁ * x * b₂) :
    ∀ x ∈ P.map φ.toMonoidHom, x ∉ B.map φ.toMonoidHom → ∀ y ∈ P.map φ.toMonoidHom,
      y ∉ B.map φ.toMonoidHom →
        ∃ b₁ ∈ B.map φ.toMonoidHom, ∃ b₂ ∈ B.map φ.toMonoidHom, y = b₁ * x * b₂ := by
  intro x hx hxB y hy hyB
  rw [mem_map_equiv] at hx hxB hy hyB
  obtain ⟨b₁, hb₁, b₂, hb₂, he⟩ := hdc _ hx hxB _ hy hyB
  refine ⟨φ b₁, mem_map_of_mem φ.toMonoidHom hb₁, φ b₂, mem_map_of_mem φ.toMonoidHom hb₂, ?_⟩
  have h := congrArg φ he
  simpa using h

theorem s208k_not_isSzL2Product_of_splitBN {X : Type} [Group X]
    [Finite X] {B N : Subgroup X} (hBN : IsSplitBNPair 2 B N)
    (h2 : ∀ U : Sylow 2 X, S208kTwoCoatoms (normalizer ((U : Subgroup X) : Set X)))
    {P : Subgroup X} (hP : IsParabolicTwo X P) (hPX : P ≠ ⊤) {n : ℕ} (hn : 2 ≤ n)
    (hQ : IsSzL2Product (Bar2 (Hinf P)) n) : False := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : (cartan B N).Normal := hBN.normal_inter
  obtain ⟨U, hUB, hSU, -⟩ := uc22p20j_exists_splitUnit hBN
  obtain ⟨S, hbn⟩ := CFSG.ASVolI.ChIJK.burnsideI2BN_exists_isBNPair
    (CFSG.ASVolI.ChIJK.burnsideI2BN_toPre hBN)
  obtain ⟨S₀, hS₀P⟩ := hP
  obtain ⟨g, rfl⟩ := MulAction.exists_smul_eq X U S₀
  have hN : normalizer ((g • U : Sylow 2 X) : Set X) = B.map (MulAut.conj g).toMonoidHom := by
    show normalizer (((g • U : Sylow 2 X) : Subgroup X) : Set X) = _
    rw [s208k_coe_smul_sylow, ← map_equiv_normalizer_eq, hUB]
  have hPP' : (P.comap (MulAut.conj g).toMonoidHom).map (MulAut.conj g).toMonoidHom = P :=
    map_comap_eq_self_of_surjective (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).surjective P
  have hBP' : B ≤ P.comap (MulAut.conj g).toMonoidHom := by
    intro b hb
    rw [Subgroup.mem_comap]
    apply hS₀P
    rw [hN]
    exact mem_map_of_mem _ hb
  have hP'X : P.comap (MulAut.conj g).toMonoidHom ≠ ⊤ := fun h => hPX (by
    rw [← hPP', h, map_top_of_surjective (MulAut.conj g).toMonoidHom (MulAut.conj g).surjective])
  have hB2 : S208kTwoCoatoms B := by
    rw [← hUB]
    exact h2 U
  obtain ⟨J, hJ, hPJ⟩ := hbn.exists_parabolic hBP'
  rcases (s208k_subsingleton_of_twoCoatoms hbn hB2 hJ
      fun h => hP'X (hPJ.trans h)).eq_empty_or_singleton with rfl | ⟨s, rfl⟩
  · rw [parabolic_empty] at hPJ
    exact s208k_ne_normalizer (Or.inr (Or.inr hQ)) (g • U) (by rw [hN, ← hPJ, hPP'])
  · have hs : s ∈ S := Set.singleton_subset_iff.mp hJ
    have hsS : ({s} : Set (WeylGroup B N)) ⊆ S := hJ
    obtain ⟨k, -, hk⟩ := uc22p20k_relIndex_eq hbn hSU hs
    have hdc : ∀ x ∈ parabolic B N {s}, x ∉ B → ∀ y ∈ parabolic B N {s}, y ∉ B →
        ∃ b₁ ∈ B, ∃ b₂ ∈ B, y = b₁ * x * b₂ := by
      have hss : s * s = 1 := hbn.mul_self_eq_one hs
      have hmem : ∀ z ∈ parabolic B N {s}, z ∉ B → z ∈ dc B N s := by
        intro z hz hzB
        obtain ⟨w, hw, hzw⟩ := (hbn.mem_parabolic_iff hsS).1 hz
        rcases eq_one_or_eq_of_mem_closure_singleton hss hw with rfl | rfl
        · exact absurd (mem_dc_one.1 hzw) hzB
        · exact hzw
      intro x hx hxB y hy hyB
      refine dc_subset_of_biinv (T := {z | ∃ b₁ ∈ B, ∃ b₂ ∈ B, z = b₁ * x * b₂}) ?_
        (hmem x hx hxB) ⟨1, B.one_mem, 1, B.one_mem, by simp⟩ (hmem y hy hyB)
      rintro b hb z ⟨b₁, hb₁, b₂, hb₂, rfl⟩ b' hb'
      exact ⟨b * b₁, B.mul_mem hb hb₁, b₂ * b', B.mul_mem hb₂ hb', by group⟩
    have key := s208k_dc_map (MulAut.conj g) hdc
    rw [← hPJ, hPP', ← hN] at key
    refine s208k_not_isSzL2Product (k := k) (g • U) hS₀P key ?_ hn hQ
    rw [hN, ← hPP', hPJ, relIndex_map_map_of_injective (f := (MulAut.conj g).toMonoidHom) _ _
      (MulAut.conj g).injective, hk]

theorem s208k_twoCoatoms_of_isU4 {X : Type} [Group X] [Finite X] {m : ℕ} (hX : IsU4 X m)
    (U : Sylow 2 X) : S208kTwoCoatoms (normalizer ((U : Subgroup X) : Set X)) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨K, _, h, ⟨e⟩⟩ := CFSG.Quasithin.H13.U4Par.exists_hypSU_equiv_of_lieModel hX
  obtain ⟨-, ⟨P, hP⟩, -⟩ := CFSG.ClassicalGroups.UnitaryFlag.unitary_order_and_Sylow h
    (r := 2) (ε := 0) (by norm_num) (by norm_num)
  have hB : S208kTwoCoatoms (CFSG.ClassicalGroups.UnitaryFlag.hypBorel h 2 0) :=
    ⟨_, _, fun M hM hBM => CFSG.Quasithin.H13.U4Par.eq_parP_or_eq_parP2 h hM hBM⟩
  have he : Function.Surjective e.toMonoidHom := e.surjective
  have hN : normalizer (((P.mapSurjective he : Sylow 2 X) : Subgroup X) : Set X) =
      (CFSG.ClassicalGroups.UnitaryFlag.hypBorel h 2 0).map e.toMonoidHom := by
    rw [Sylow.coe_mapSurjective, hP, ← map_equiv_normalizer_eq,
      CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.normalizer_hypUnitriangular h
        (by norm_num) (by norm_num)]
  exact s208k_twoCoatoms_normalizer (P.mapSurjective he)
    (by rw [hN]; exact s208k_twoCoatoms_map e hB) U

section Certified


variable {X : Type} [Group X] [Finite X] {m : ℕ}

theorem s208k_twoCoatoms_of_ch10 (hX : IsL3 X m ∨ IsSp4 X m ∨ IsG2 X m) (U : Sylow 2 X) :
    S208kTwoCoatoms (normalizer ((U : Subgroup X) : Set X)) := by
  have hU := CFSG.QuasithinUnique.isSylowTwoOf_top_of_sylow U
  obtain ⟨P, hP⟩ : ∃ P : Fin 2 → Subgroup X,
      CFSG.QuasithinUnique.Setup.X6.ResidualOvergroupsAt X U P := by
    rcases hX with h | h | h
    · have hs := CFSG.Blueprint.LieModel.statedClassicalModel h (by decide)
      exact CFSG.Quasithin.Vol2.Ch10.SecB.Rank2.exists_residualOvergroupsAt hs.1.2.1
        (Or.inl hs) hU
    · have hs := CFSG.Blueprint.LieModel.statedClassicalModel h (by decide)
      exact CFSG.Quasithin.Vol2.Ch10.SecB.Rank2.exists_residualOvergroupsAt hs.1.2.1
        (Or.inr (Or.inr (Or.inl hs))) hU
    · have hs := CFSG.Blueprint.LieModel.chevalleyExceptionalModel h (by decide)
      exact CFSG.Quasithin.Vol2.Ch10.SecB.Rank2.exists_residualOvergroupsAt hs.1.2.1
        (Or.inr (Or.inr (Or.inr hs))) hU
  exact s208k_twoCoatoms_mono le_normalizer (s208k_twoCoatoms_of_residual hP)

private theorem s208k_twoCoatoms_of_isSL3 (hX : IsSL3 X m) (U : Sylow 2 X) :
    S208kTwoCoatoms (normalizer ((U : Subgroup X) : Set X)) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hπ := QuotientGroup.mk'_surjective (center X)
  have : Finite (X ⧸ center X) := Finite.of_surjective _ hπ
  have hs := CFSG.Blueprint.LieModel.statedClassicalModel hX.2 (by decide)
  obtain ⟨P, hP⟩ := CFSG.Quasithin.Vol2.Ch10.SecB.Rank2.exists_residualOvergroupsAt hs.1.2.1
    (Or.inl hs) (CFSG.QuasithinUnique.isSylowTwoOf_top_of_sylow (U.mapSurjective hπ))
  have h1 := s208k_twoCoatoms_of_residual hP
  rw [Sylow.coe_mapSurjective] at h1
  obtain ⟨P₀, P₁, h⟩ := s208k_twoCoatoms_mono (map_mono le_normalizer) h1
  have hZ : (QuotientGroup.mk' (center X)).ker ≤ normalizer ((U : Subgroup X) : Set X) := by
    rw [QuotientGroup.ker_mk']
    exact center_le_normalizer _
  refine ⟨P₀.comap (QuotientGroup.mk' (center X)), P₁.comap (QuotientGroup.mk' (center X)),
    fun M hM hNM => ?_⟩
  have hkM := hZ.trans hNM
  rcases h _ (CFSG.QuasithinUnique.Setup.Campbell.isCoatom_map_of_ker_le _ hπ hM hkM)
      (map_mono hNM) with h0 | h0
  · exact Or.inl (by rw [← h0, comap_map_eq_self hkM])
  · exact Or.inr (by rw [← h0, comap_map_eq_self hkM])

