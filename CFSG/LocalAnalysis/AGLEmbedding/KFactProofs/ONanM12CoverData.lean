   (cycPerm [[0,1,2,5,6,8,3,10,9,11,4]],
    [-1, 3, 1, -3, 1, -3, -3, -3, -1, 3, 1],
    [3, 3, 2, -3, -3, 1, -2, 3, -2])]

@[expose] def m12CoverReps : List (Equiv.Perm (Fin 12) × List ℤ × List ℤ) :=
  m12CoverReps0 ++ m12CoverReps1 ++ m12CoverReps2 ++ m12CoverReps3 ++ m12CoverReps4 ++
    m12CoverReps5 ++ m12CoverReps6 ++ m12CoverReps7 ++ m12CoverReps8 ++ m12CoverReps9

@[expose] def m12CoverNormTabs : List (Table × Table) :=
  m12CoverNorm.map fun n => (toTable n, toTable n⁻¹)

@[expose] def m12CoverRepTabs : List Table := m12CoverReps.map fun r => toTable r.1

@[expose] def m12CoverOrb : List Table :=
  m12CoverNormTabs.flatMap fun p => m12CoverRepTabs.map fun t => compT 12 p.1 (compT 12 t p.2)

@[expose] def m12CoverOrbSet : Std.HashSet Table := Std.HashSet.ofList m12CoverOrb

@[expose] def m12CoverCov (T : Table) : Bool :=
  (List.range 10).any fun k => m12CoverOrbSet.contains (powT 12 (k + 1) T)

@[expose] def m12CoverBad (T : Table) : Bool :=
  (ordTest 12 5 T || ordTest 12 11 T) && !m12CoverCov T

end CFSG.AGLEmbedding.KFactProofs.M12Cover
