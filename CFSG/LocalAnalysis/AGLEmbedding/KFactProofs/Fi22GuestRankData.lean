@[expose] def winv (w : Word) : Word := (w.map fun l => (l.1, !l.2)).reverse

@[expose] def wpow (w : Word) : Nat → Word
  | 0 => []
  | k + 1 => w ++ wpow w k

@[expose] def qWord : Nat → Word
  | 0 => wx
  | 1 => wy
  | k + 2 => wx ++ wpow wy (k + 1)

@[expose] def nWord (k : Nat) : Word := (nData.getD k (0, 0, [])).2.2

@[expose] def eLetterWord (s : Int) : Word :=
  if 0 < s then nWord (s.toNat - 1) else winv (nWord ((-s).toNat - 1))

@[expose] def nRel (t : Nat × Nat × Word) : Word :=
  t.2.2 ++ qWord t.1 ++ winv t.2.2 ++ winv (wpow (qWord t.1) t.2.1)

@[expose] def wordRels : List Word :=
  [wpow wx 5, wpow wy 5, wx ++ wy ++ winv wx ++ winv wy] ++ nData.map nRel

@[expose] def movesPt (n : Nat) (T : Table) : Bool := !(allIn 0 n fun i => ap T i == i)

@[expose] def eTab (n : Nat) (α αi β βi : Table) (i : Nat) : Table :=
  (eData.getD i []).foldr (fun s T => compT n (wordTab n α αi β βi (eLetterWord s)) T) (idT n)

@[expose] def eChecks (n : Nat) (E0 E1 E2 E3 : Table) : Bool :=
  [E0, E1, E2, E3].all (fun E => powT n 3 E == idT n) &&
  [E0, E1, E2, E3].all (fun E => [E0, E1, E2, E3].all fun F => compT n E F == compT n F E) &&
  [0, 1, 2].all fun a => [0, 1, 2].all fun b => [0, 1, 2].all fun c => [0, 1, 2].all fun d =>
    (a == 0 && b == 0 && c == 0 && d == 0) ||
      movesPt n (compT n (powT n a E0) (compT n (powT n b E1)
        (compT n (powT n c E2) (powT n d E3))))

@[noinline, expose] def guestCheck (n : Nat) (α αi β βi : Table) : Bool :=
  relCheck n α αi β βi wordRels &&
  nData.all (fun t => movesPt n (wordTab n α αi β βi (qWord t.1))) &&
  eChecks n (eTab n α αi β βi 0) (eTab n α αi β βi 1) (eTab n α αi β βi 2)
    (eTab n α αi β βi 3)

@[noinline, expose] def fi22GuestCheck : Bool :=
  let O := CFSG.Sporadic.Fi22.Native.orbitData ()
  guestCheck 3510 O.alpha O.alpha O.beta (invT 3510 O.beta)

end CFSG.AGLEmbedding.KFactProofs.Fi22Guest
