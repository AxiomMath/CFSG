open CFSG.Quasithin

@[expose] def sylowElemAt (i : ℕ) : Array GF8 := sylowElems.getD i oneArr

structure D4PlaneCert where
  idxs : List ℕ
  pool : List (List ℕ × ℕ)
  targets : List (List ℕ)

@[expose] def D4PlaneCert.elems (c : D4PlaneCert) : List (Array GF8) := c.idxs.map sylowElemAt

@[expose] def D4PlaneCert.poolArr (c : D4PlaneCert) : List (Array GF8) :=
  c.pool.map fun e => wordArr e.1

@[expose] def arrProd (l : List (Array GF8)) : Array GF8 := l.foldr mulArr oneArr

@[expose] def D4PlaneCert.poolOK (c : D4PlaneCert) : Bool :=
  c.pool.all fun e =>
    c.idxs.contains e.2 && sylowElemAt e.2 != oneArr && commutes (wordArr e.1) (sylowElemAt e.2)

@[expose] def D4PlaneCert.targetOK (c : D4PlaneCert) : Bool :=
  let pa := c.poolArr
  (List.range 18).all fun j =>
    arrProd ((c.targets.getD j []).map fun m => pa.getD m oneArr) == letterArr j

@[expose] def planeSpan (x y : Array GF8) : List (Array GF8) :=
  [oneArr, x, mulArr x x].flatMap fun u => [oneArr, y, mulArr y y].map fun v => mulArr u v

@[expose] def planeCoverCheck (cs : List D4PlaneCert) (Xs : List (Array GF8)) : Bool :=
  let Om := Xs.filter cube1
  let Es := cs.map D4PlaneCert.elems
  Om.all fun x =>
    x == oneArr || (Om.filter (commutes x)).all fun y =>
      [oneArr, x, mulArr x x].contains y ||
        let S := planeSpan x y
        Es.any fun E => E.contains x && E.contains y && E.all fun p => S.contains p

