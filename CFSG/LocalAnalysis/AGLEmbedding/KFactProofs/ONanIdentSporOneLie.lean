open CFSG.Open CFSG.Blueprint CFSG.ComponentClassification.OuterAutomorphisms

theorem oneLieIdentAtP_of_betaData {K : Type} [Group K] [Finite K] (hK : IsSimpleGroup K)
    (hnab : ∃ a b : K, a * b ≠ b * a) (h : SporadicBetaData K) (p : ℕ) :
    OneLieIdentAtP K p := by
  intro hp hp2 T _ hΓ hAut
  obtain ⟨hOut, hdata⟩ := h
  have hOutp : ¬ p ∣ Nat.card (Outer K) := fun hd => by
    have := Nat.le_of_dvd Nat.card_pos hd
    have := hp.two_le
    omega
  exfalso
  apply hAut
  refine (pRank_top_mulAut_le_of_not_dvd hp
    (center_eq_bot_of_isSimpleGroup_of_nonabelian hK hnab) hOutp).trans ?_
  rcases hdata p hp hp2 with h3 | ⟨h4, hpair⟩ | hfus
  · exact RankThree.PartTwo.Census.pRank_le_two_of_not_dvd hp h3
  · exact pRank_le_two_of_hasNoncommPair hp h4 hpair
  · exact absurd (glbCore_one_eq_top_of_fusionGenerationOf hp hfus T) hΓ

theorem oneLieIdentSporAt_of_betaData (s : TauCeti.SporadicName)
    (hbr : Nonempty (NativeSporadic.Carrier s ≃* (TauCeti.CFSGIndex.sporadic s).Group))
    (hdata : SporadicBetaData (NativeSporadic.Carrier s)) : OneLieIdentSporAt s := by
  intro K _ _ hs hnab ⟨e⟩ p
  obtain ⟨f⟩ := hbr
  exact oneLieIdentAtP_of_betaData hs hnab (hdata.of_mulEquiv (e.trans f.symm).symm) p

set_option linter.unusedSectionVars false

section Rows


theorem sporadicBetaData_of_ne
    (s : TauCeti.SporadicName) (hs : s ≠ .M) :
    SporadicBetaData (NativeSporadic.Carrier s) := by
  have hrem : SporadicBetaRemaining := sporadicBetaRemaining_of_rest
      (sporadicBetaData_B_of CFSG.Sporadic.Bridge.B.fusionGenerationOf_B_five)
  cases s with
  | M11 => exact sporadicBetaData_M11
  | M12 => exact sporadicBetaData_M12
  | M22 => exact sporadicBetaData_M22
  | M23 => exact sporadicBetaData_M23
  | M24 => exact sporadicBetaData_M24
  | J1 => exact sporadicBetaData_J1
  | J2 => exact sporadicBetaData_J2
  | J4 => exact sporadicBetaData_J4
  | HS => exact sporadicBetaData_HS
  | He => exact sporadicBetaData_He
  | Ru => exact sporadicBetaData_Ru
  | M => exact (hs rfl).elim
  | _ => exact hrem _ (by decide)

theorem oneLieIdentSporAt_of_ne
    (s : TauCeti.SporadicName) (hs : s ≠ .M) :
    OneLieIdentSporAt s :=
  oneLieIdentSporAt_of_betaData s (CFSG.RankThree.PartOne.TCB.nonempty_carrier_mulEquiv_group s)
    (sporadicBetaData_of_ne s hs)

end Rows

