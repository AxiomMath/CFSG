namespace CFSG.AGLEmbedding


open CFSG.HardMathSupport.Seitz.TrialityOdd CFSG.HardMathSupport.Curtis.Coordinator.SeitzTower
  CFSG.HardMathSupport.Foote.Coordinator CFSG.HardMathSupport.Solomon.Coordinator.SeitzOuterCube in
theorem p1ThreeLieOffChar_holds : P1ThreeLieOffChar := by
  have hGA := CFSG.ComponentClassification.TBLit.griessMultipliersAllModels_holds
  have hW : ∀ r : ℕ, 5 ≤ r → Coordinator.Phi6CoreW r := fun r hr =>
    Inner.phi6CoreW_of_placementSome hr (Inner.phi6PlacementSome_holds r hr)
      (Inner.phi6PlacementSomeThree_holds r hr)
  have hS : KFactSeitzOuterCubeRankTwo :=
    Exc.kFactSeitzOuterCubeRankTwo_of_open
      ⟨SplitFrame.seitzExcAnisotropicF4Class_three, TwistedFrame.seitzExcAnisotropicF4Class_six⟩
      ⟨TwistedFrame.seitzExcAnisotropicE6Class_six, SplitFrame.seitzExcAnisotropicE8Class_five,
        TwistedFrame.seitzExcAnisotropicE8Class_ten, TwistedFrame.seitzExcAnisotropicE8Class_twelve⟩
      Exc.TOdd.trialityOuterCubesThreeOdd_holds
  have hNN : P1OffCharAlmostSimpleNonNormal :=
    p1OffCharAlmostSimpleNonNormal_of_at fun ⟨d, hv⟩ => by
      by_cases hA : ∃ (m : ℕ) (q : TauCeti.PrimePower), d = .A m q
      · obtain ⟨m, q, rfl⟩ := hA
        exact p1OffCharAlmostSimpleNonNormalAt_A_all hv
      by_cases h6 : ∃ q : TauCeti.PrimePower, d = .E6 q
      · obtain ⟨q, rfl⟩ := h6
        exact p1OffCharAlmostSimpleNonNormalAt_E6 hv
      by_cases h7 : ∃ q : TauCeti.PrimePower, d = .E7 q
      · obtain ⟨q, rfl⟩ := h7
        exact p1OffCharAlmostSimpleNonNormalAt_E7 hv
      exact p1OffCharAlmostSimpleNonNormalAt_rest ⟨d, hv⟩ (fun m q h => hA ⟨m, q, h⟩)
        (fun q h => h6 ⟨q, h⟩) (fun q h => h7 ⟨q, h⟩)
  exact p1ThreeLieOffChar_of_cubesV10
    (CFSG.HardMathSupport.Lang.TwE6Step3.excCubeResidualsV4_of_phi6 fun r hr =>
      Coordinator.phiPlaneGenAt_neg_of_coreW hr (hW r hr))
    hGA (p1OffCharCoverThree hGA)
    (CFSG.HardMathSupport.Malle.Coordinator.CoverThreeNoInner.p1OffCharCoverThreeNoInner_holds hGA)
    hS hNN

end CFSG.AGLEmbedding
