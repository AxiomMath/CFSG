    : KFactCompParabNoG25 := by
  have hGA : CFSG.Open.GriessAllModelsStatement :=
    CFSG.Milestones.cl_lit_griess_schur_multipliers_all_models_statement
  have hZ : OddCenterRest := oddCenterRest_of_griess hGA
  exact kFactCompParabNoG25_of_families
    (kFactCompParabNoG25On_linear hGA)
    kFactCompParabNoG25On_twistedA
    (kFactCompParabNoG25On_idxB hZ)
    (kFactCompParabNoG25On_idxD hZ)
    (kFactCompParabNoG25On_twistedD hZ)
    (kFactCompParabNoG25On_g2 hGA)
    kFactCompParabNoG25_small

