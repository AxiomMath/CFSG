theorem kFactCompParabNoG25_of_families
    (hA : KFactCompParabNoG25On (IsLieOf IdxA))
    (h2A : KFactCompParabNoG25On (IsLieOf IdxTwistedA))
    (hB : KFactCompParabNoG25On (IsLieOf IdxB))
    (hD : KFactCompParabNoG25On (IsLieOf IdxD))
    (h2D : KFactCompParabNoG25On (IsLieOf IdxTwistedD))
    (hG : KFactCompParabNoG25On (IsLieOf IdxG2))
    (hS : KFactCompParabNoG25On IsSmallTwoOrG2) : KFactCompParabNoG25 := by
  intro Y _ _ L P hCP
  rcases isClassicalTwoOrG2_family_cases hCP.type with h | h | h | h | h | h | h
  exacts [hA Y L P hCP h, h2A Y L P hCP h, hB Y L P hCP h, hD Y L P hCP h, h2D Y L P hCP h,
    hG Y L P hCP h, hS Y L P hCP h]

