@[expose] def e7Col : ℕ → ℕ
  | 0 => e7Col0
  | 1 => e7Col1
  | 2 => e7Col2
  | 3 => e7Col3
  | 4 => e7Col4
  | 5 => e7Col5
  | 6 => e7Col6
  | _ => 0

@[expose] def tE (i r : ℕ) : ℕ := (e7Col i >>> (10 * r)) % 1024

@[expose] def parE (r : ℕ) : ℕ := (e7ParLab >>> (13 * r)) % 1024

@[expose] def labE (r : ℕ) : ℕ := (e7ParLab >>> (13 * r + 10)) % 8

@[expose] def fE (r : ℕ) : ℕ := (e7FTab >>> (10 * r)) % 1024

@[expose] def chainE (k : ℕ) : ℕ := [3, 2, 1, 0, 4, 5].getD k 0

@[expose] def oE (x : ℕ) : ℕ := [295, 266, 237, 209, 182, 156, 131].getD x 0

@[expose] def swapNat (k x : ℕ) : ℕ := if x = k then k + 1 else if x = k + 1 then k else x

@[expose] def applyRev (w : List ℕ) (r : ℕ) : ℕ := w.foldr (fun a y => tE a y) r

@[expose] def fWord : List ℕ := (List.replicate 9 (List.range 7)).flatten

@[expose] def checkPerm : Bool :=
  (List.range 7).all fun i => (List.range 576).all fun r => tE i r < 576 && tE i (tE i r) == r

@[expose] def checkRels : Bool :=
  (CFSG.YGroups.yRels 3 2 1).all fun w => (List.range 576).all fun r => applyRev w r == r

@[expose] def checkFix : Bool := (List.range 6).all fun j => tE j 0 == 0

@[expose] def checkTree : Bool :=
  (List.range 575).all fun k =>
    parE (k + 1) < k + 1 && labE (k + 1) < 7 && tE (labE (k + 1)) (parE (k + 1)) == k + 1

@[expose] def checkOrbit : Bool :=
  (List.range 6).all fun k => (List.range 7).all fun x => tE (chainE k) (oE x) == oE (swapNat k x)

@[expose] def checkF : Bool :=
  (List.range 576).all fun r => fE r < 576 && applyRev fWord r == fE r && fE (fE r) == r &&
    (List.range 7).all fun i => fE (tE i r) == tE i (fE r)

@[expose] def checkFne : Bool := fE 0 != 0

theorem e7_table_checks :
    checkPerm = true ∧ checkRels = true ∧ checkFix = true ∧ checkTree = true ∧
      checkOrbit = true ∧ checkF = true ∧ checkFne = true := by
  decide +kernel

end CFSG.LocalAnalysis.ComponentInitial.MonE7
