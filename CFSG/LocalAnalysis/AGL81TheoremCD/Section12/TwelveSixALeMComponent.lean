variable {G : Type} [Group G] [Finite G] {M : Subgroup G} {p : ℕ} {Q H : Subgroup G} {d : ℕ}
  {L₁ L₂ L₃ : Subgroup G} {n₁ n₂ n₃ : ℕ}

private theorem starImg_sup {A B : Subgroup G} (hA : A ≤ H) (hB : B ≤ H) :
    starImg p H (A ⊔ B) = starImg p H A ⊔ starImg p H B := by
  rw [starImg, starImg, starImg, Subgroup.subgroupOf_sup hA hB, Subgroup.map_sup]

private theorem starImg_eq_starImg_inf (p : ℕ) (H M : Subgroup G) :
    starImg p H M = starImg p H (H ⊓ M) := by
  rw [starImg, starImg]
  congr 1
  ext x
  simp

private theorem isComponent_le_starImg_inf_of_pLayerIn_le (hp : p.Prime) {H : Subgroup G}
    (hAM : pLayerIn p H ≤ M) {C : Subgroup (StarGroup p H)} (hC : CFSG.IsComponent C) :
    C ≤ starImg p H (H ⊓ M) := by
  calc C ≤ CFSG.layer (StarGroup p H) := le_sSup hC
    _ = starImg p H (pLayerIn p H) := (starImg_pLayerIn hp H).symm
    _ ≤ starImg p H M := Subgroup.map_mono (Subgroup.comap_mono hAM)
    _ = starImg p H (H ⊓ M) := starImg_eq_starImg_inf p H M

private theorem starImg_le_cStarL_of_forall_commute (hp : p.Prime) {H I : Subgroup G}
    (hcomm : ∀ C : Subgroup (StarGroup p H), CFSG.IsComponent C →
      ⁅C, starImg p H I⁆ = ⊥) :
    starImg p H I ≤ cStarL p H := by
  rw [cStarL_eq_centralizer_layer hp H, Subgroup.le_centralizer_iff, CFSG.layer.eq_sSup]
  exact sSup_le fun C hC =>
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp (hcomm C hC)

private theorem exists_isPComponentIn_le_of_not_commute (hp : p.Prime) {H I : Subgroup G}
    (hI : CFSG.Open.IsSubnormal I (H ⊓ M)) {C : Subgroup (StarGroup p H)}
    (hC : CFSG.IsComponent C) (hCX : C ≤ starImg p H (H ⊓ M))
    (hCne : ⁅C, starImg p H I⁆ ≠ ⊥) :
    ∃ J : Subgroup G, IsPComponentIn p J H ∧ starImg p H J ≤ starImg p H I := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hIle : I ≤ H ⊓ M := hI.le
  have hIsub : CFSG.Open.IsSubnormal (starImg p H I) (starImg p H (H ⊓ M)) := by
    have h1 : CFSG.Open.IsSubnormal (I.subgroupOf H) ((H ⊓ M).subgroupOf H) :=
      hI.comap H.subtype
    exact h1.map (QuotientGroup.mk' (primeComplementCore (G := ↥H) p))
  have hIleX : starImg p H I ≤ starImg p H (H ⊓ M) :=
    Subgroup.map_mono (Subgroup.comap_mono hIle)
  have hCcomp : CFSG.IsComponent (C.subgroupOf (starImg p H (H ⊓ M))) :=
    CFSG.LocalCores.component_overgroup hC hCX
  have hIsubX : ((starImg p H I).subgroupOf (starImg p H (H ⊓ M))).IsSubnormal :=
    hIsub.subgroupOf
  rcases CFSG.LocalCores.component_subnormal_subgroup hCcomp hIsubX with hle | hcomm'
  · have hC_le : C ≤ starImg p H I := by
      have h := Subgroup.map_mono (f := (starImg p H (H ⊓ M)).subtype) hle
      rwa [Subgroup.map_subgroupOf_eq_of_le hCX,
        Subgroup.map_subgroupOf_eq_of_le hIleX] at h
    obtain ⟨J, hJ, hJeq⟩ := exists_isPComponentIn_starImg_eq hp hC
    exact ⟨J, hJ, hJeq ▸ hC_le⟩
  · exfalso
    apply hCne
    have h := congrArg (Subgroup.map (starImg p H (H ⊓ M)).subtype) hcomm'
    rwa [Subgroup.map_commutator, Subgroup.map_subgroupOf_eq_of_le hCX,
      Subgroup.map_subgroupOf_eq_of_le hIleX, Subgroup.map_bot] at h

theorem starImg_le_cStarL_or_exists_isPComponentIn (hp : p.Prime) {I : Subgroup G}
    (hAM : pLayerIn p H ≤ M) (hI : CFSG.Open.IsSubnormal I (H ⊓ M)) :
    starImg p H I ≤ cStarL p H ∨
      ∃ J : Subgroup G, IsPComponentIn p J H ∧ starImg p H J ≤ starImg p H I := by
  classical
  by_cases hcomm : ∀ C : Subgroup (StarGroup p H), CFSG.IsComponent C →
      ⁅C, starImg p H I⁆ = ⊥
  · exact Or.inl (starImg_le_cStarL_of_forall_commute hp hcomm)
  · push Not at hcomm
    obtain ⟨C, hC, hCne⟩ := hcomm
    exact Or.inr (exists_isPComponentIn_le_of_not_commute hp hI hC
      (isComponent_le_starImg_inf_of_pLayerIn_le hp hAM hC) hCne)

private theorem notMem_of_isComponent_ne_of_mem_center {H J K : Subgroup G}
    (hcomm : ⁅starImg p H J, starImg p H K⁆ = ⊥)
    {x : ↥(starImg p H J)} (hxZ : x ∉ Subgroup.center ↥(starImg p H J)) :
    (x : StarGroup p H) ∉ starImg p H K := by
  intro hxK
  apply hxZ
  rw [Subgroup.mem_center_iff]
  intro z
  apply Subtype.ext
  change (z : StarGroup p H) * (x : StarGroup p H) =
    (x : StarGroup p H) * (z : StarGroup p H)
  have hmem := Subgroup.commutator_mem_commutator z.2 hxK
  rw [hcomm] at hmem
  exact commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp hmem)

private theorem two_le_pRank_starImg_of_components (hp : p.Prime) {H J K : Subgroup G}
    (hJ : IsPComponentIn p J H) (hK : IsPComponentIn p K H)
    (hcomm : ⁅starImg p H J, starImg p H K⁆ = ⊥)
    {x : ↥(starImg p H J)} {w : StarGroup p H} (hwK : w ∈ starImg p H K)
    (hwp : w ^ p = 1) (hw1 : w ≠ 1) (hxZ : x ∉ Subgroup.center ↥(starImg p H J))
    (hxp : x ^ p = 1) :
    2 ≤ CFSG.Open.pRank p (starImg p H (pLayerIn p H)) := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hxK : (x : StarGroup p H) ∉ starImg p H K :=
    notMem_of_isComponent_ne_of_mem_center hcomm hxZ
  have hx_not_zw : (x : StarGroup p H) ∉ Subgroup.zpowers w := fun hxw =>
    hxK (Subgroup.zpowers_le.mpr hwK hxw)
  have hcomm' : ⁅starImg p H K, starImg p H J⁆ = ⊥ := by
    rw [Subgroup.commutator_comm]; exact hcomm
  have hwx : ∀ a ∈ Subgroup.zpowers w, a * (x : StarGroup p H) =
      (x : StarGroup p H) * a := by
    intro a ha
    have hmem := Subgroup.commutator_mem_commutator
      (Subgroup.zpowers_le.mpr hwK ha) x.2
    rw [hcomm'] at hmem
    exact commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp hmem)
  have hxp' : (x : StarGroup p H) ^ p = 1 := by
    simpa using congrArg (fun t : ↥(starImg p H J) => (t : StarGroup p H)) hxp
  obtain ⟨hEabel, hEcard⟩ :=
    CFSG.Quasithin.H13.U3.elemAbelian_sup_zpowers (p := p)
      (A := Subgroup.zpowers w) (y := (x : StarGroup p H))
      ((CFSG.SectionRank.isElementaryAbelian_iff_isElemAbelian p _).mp
        (IsElementaryAbelian.zpowers_of_pow_eq_one hwp)) hx_not_zw hxp' hwx
  have hcardw : Nat.card ↥(Subgroup.zpowers w) = p := by
    rw [Nat.card_zpowers, orderOf_eq_prime hwp hw1]
  have hEcard' : Nat.card ↥(Subgroup.zpowers w ⊔ Subgroup.zpowers (x : StarGroup p H)) =
      p ^ 2 := by
    rw [hEcard, hcardw, pow_two]
  have hEsub : Subgroup.zpowers w ⊔ Subgroup.zpowers (x : StarGroup p H) ≤
      starImg p H (pLayerIn p H) := by
    refine sup_le ?_ ?_
    · exact (Subgroup.zpowers_le.mpr hwK).trans
        (Subgroup.map_mono (Subgroup.comap_mono (le_pLayerIn hK)))
    · exact (Subgroup.zpowers_le.mpr x.2).trans
        (Subgroup.map_mono (Subgroup.comap_mono (le_pLayerIn hJ)))
  exact CFSG.SectionRank.le_pRank hp.one_lt hEsub hEabel hEcard'

private theorem eq_of_isPComponentIn_of_pRank_le_one (hp : p.Prime) (hp2 : p ≠ 2)
    {H J K : Subgroup G} (hJ : IsPComponentIn p J H) (hK : IsPComponentIn p K H)
    (hrank : CFSG.Open.pRank p (pLayerIn p H) ≤ 1) : K = J := by
  haveI : Fact p.Prime := ⟨hp⟩
  by_contra hne
  have hJc : CFSG.IsComponent (starImg p H J) := isComponent_starImg hJ
  have hKc : CFSG.IsComponent (starImg p H K) := isComponent_starImg hK
  have hne' : starImg p H J ≠ starImg p H K := fun h =>
    hne (eq_of_starImg_eq hp hK hJ h.symm)
  have hcomm : ⁅starImg p H J, starImg p H K⁆ = ⊥ :=
    (CFSG.LocalCores.distinct_components_commute hJc hKc).resolve_left hne'
  have hO : CFSG.pPrimeCore p (StarGroup p H) = ⊥ :=
    CFSG.pPrimeCore_quotient_pPrimeCore_eq_bot (G := ↥H) p
  obtain ⟨x, hxp, hxZ⟩ :=
    CFSG.RankThree.PartOne.exists_pow_eq_one_not_mem_center_of_isPerfect (p := p) hp2
      hJc.1.1 (CFSG.RankThree.PartOne.Sec1511.p_dvd_card_component hO hJc)
  obtain ⟨w, hwK, hwp, hw1⟩ :=
    CFSG.RankThree.PartOne.Sec1511.exists_pElement_component hO hKc
  have h2 := two_le_pRank_starImg_of_components hp hJ hK hcomm hwK hwp hw1 hxZ hxp
  have hpr : CFSG.Open.pRank p (starImg p H (pLayerIn p H)) =
      CFSG.Open.pRank p (pLayerIn p H) :=
    pRank_starImg_eq hp (Subgroup.map_subtype_le (CFSG.pLayer ↥H p))
  rw [hpr] at h2
  omega

private theorem false_of_le_centralizer {Y : Type} [Group Y] {K : Subgroup Y}
    (hK : CFSG.IsQuasisimple ↥K) (hcent : K ≤ Subgroup.centralizer (K : Set Y)) : False := by
  have hcommK : IsMulCommutative ↥K :=
    Subgroup.le_centralizer_iff_isMulCommutative.mp hcent
  haveI : Group.IsPerfect ↥K := hK.1
  haveI : Nontrivial ↥K := CFSG.LocalCores.isQuasisimple_nontrivial hK
  exact Group.IsPerfect.not_isMulCommutative (G := ↥K) hcommK

private theorem starImg_eq_of_isPComponentIn_of_quasisimple (hp : p.Prime) {H K : Subgroup G}
    (hK : IsPComponentIn p K H)
    (hquasi : CFSG.IsQuasisimple ↥(starImg p H (pLayerIn p H))) :
    starImg p H K = starImg p H (pLayerIn p H) := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hAcomp : CFSG.IsComponent (starImg p H (pLayerIn p H)) := by
    refine ⟨hquasi, ?_⟩
    rw [starImg_pLayerIn hp H]
    haveI : (CFSG.layer (StarGroup p H)).Characteristic :=
      CFSG.LocalCores.layer_characteristic
    haveI : (CFSG.layer (StarGroup p H)).Normal := inferInstance
    exact (inferInstance : (CFSG.layer (StarGroup p H)).Normal).isSubnormal
  have hKle : starImg p H K ≤ starImg p H (pLayerIn p H) :=
    Subgroup.map_mono (Subgroup.comap_mono (le_pLayerIn hK))
  have hKc : CFSG.IsComponent (starImg p H K) := isComponent_starImg hK
  rcases CFSG.LocalCores.component_subnormal_subgroup hAcomp hKc.2 with hle | hcomm
  · exact le_antisymm hKle hle
  · exfalso
    have hcent : starImg p H (pLayerIn p H) ≤
        Subgroup.centralizer (starImg p H K : Set (StarGroup p H)) :=
      Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcomm
    exact false_of_le_centralizer hKc.1 (hKle.trans hcent)

private theorem le_normalizer_of_forall_eq {H J : Subgroup G} (hJ : IsPComponentIn p J H)
    (hEq : ∀ K : Subgroup G, IsPComponentIn p K H → K = J) :
    H ≤ normalizer (J : Set G) := by
  intro h hh
  exact Subgroup.mem_normalizer_iff_map_conj_eq.mpr (hEq _ (isPComponentIn_conj hJ hh))

private theorem mem_of_isPComponentIn_of_eq_sup {H a b c K : Subgroup G} (hp : p.Prime)
    (ha : IsPComponentIn p a H) (hb : IsPComponentIn p b H) (hc : IsPComponentIn p c H)
    (hsup : pLayerIn p H = a ⊔ b ⊔ c) (hK : IsPComponentIn p K H) :
    K ∈ ({a, b, c} : Set (Subgroup G)) := by
  haveI : Fact p.Prime := ⟨hp⟩
  by_contra hKS
  have haH : a ≤ H := ha.1
  have hbH : b ≤ H := hb.1
  have hcH : c ≤ H := hc.1
  have hsupstar : starImg p H (pLayerIn p H) =
      starImg p H a ⊔ starImg p H b ⊔ starImg p H c := by
    rw [hsup, starImg_sup (sup_le haH hbH) hcH, starImg_sup haH hbH]
  have hKcomp : CFSG.IsComponent (starImg p H K) := isComponent_starImg hK
  have hcommX : ∀ X : Subgroup G, X ∈ ({a, b, c} : Set (Subgroup G)) →
      ⁅starImg p H X, starImg p H K⁆ = ⊥ := by
    intro X hX
    have hX' : X ∈ ({a, b, c} : Set (Subgroup G)) := hX
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hX
    have hXp : IsPComponentIn p X H := by
      rcases hX with rfl | rfl | rfl
      · exact ha
      · exact hb
      · exact hc
    have hXcomp : CFSG.IsComponent (starImg p H X) := isComponent_starImg hXp
    rcases CFSG.LocalCores.distinct_components_commute hKcomp hXcomp with heq | hcomm
    · exfalso
      exact hKS (by rw [eq_of_starImg_eq hp hK hXp heq]; exact hX')
    · rw [Subgroup.commutator_comm]; exact hcomm
  have hAcent : starImg p H (pLayerIn p H) ≤
      Subgroup.centralizer (starImg p H K : Set (StarGroup p H)) := by
    rw [hsupstar]
    exact sup_le (sup_le
      (Subgroup.commutator_eq_bot_iff_le_centralizer.mp (hcommX a (by simp)))
      (Subgroup.commutator_eq_bot_iff_le_centralizer.mp (hcommX b (by simp))))
      (Subgroup.commutator_eq_bot_iff_le_centralizer.mp (hcommX c (by simp)))
  exact false_of_le_centralizer hKcomp.1
    ((Subgroup.map_mono (Subgroup.comap_mono (le_pLayerIn hK))).trans hAcent)

private theorem le_sup_inf_normalizer_of_conj {H M E J : Subgroup G} (hEH : E ≤ H)
    (hEM : E ≤ M)
    (hconj : ∀ h ∈ H, ∃ e ∈ E, J.map (MulAut.conj h).toMonoidHom =
      J.map (MulAut.conj e).toMonoidHom) :
    H ≤ (H ⊓ M) ⊔ (H ⊓ normalizer (J : Set G)) := by
  intro h hh
  obtain ⟨e, heE, heq⟩ := hconj h hh
  have hconj' : J.map (MulAut.conj (e⁻¹ * h)).toMonoidHom = J := by
    calc J.map (MulAut.conj (e⁻¹ * h)).toMonoidHom
        = (J.map (MulAut.conj h).toMonoidHom).map (MulAut.conj e⁻¹).toMonoidHom := by
          rw [Subgroup.map_map]
          congr 1
          ext x
          simp [MulAut.conj_apply, mul_assoc]
      _ = (J.map (MulAut.conj e).toMonoidHom).map (MulAut.conj e⁻¹).toMonoidHom := by
          rw [heq]
      _ = J := by
          rw [Subgroup.map_map]
          have hid : (MulAut.conj e⁻¹).toMonoidHom.comp (MulAut.conj e).toMonoidHom =
              MonoidHom.id G := by
            ext x
            simp [MulAut.conj_apply, mul_assoc]
          rw [hid, Subgroup.map_id]
  have hhe : e⁻¹ * h ∈ H ⊓ normalizer (J : Set G) :=
    ⟨H.mul_mem (H.inv_mem (hEH heE)) hh,
      Subgroup.mem_normalizer_iff_map_conj_eq.mpr hconj'⟩
  have heM : e ∈ H ⊓ M := ⟨hEH heE, hEM heE⟩
  have hsplit : h = e * (e⁻¹ * h) := by group
  rw [hsplit]
  exact Subgroup.mul_mem_sup heM hhe

theorem TwelveSixKCtx.le_of_inf_normalizer_le
    (hc : TwelveSixKCtx G M p Q H d L₁ L₂ L₃ n₁ n₂ n₃)
    (hA : pLayerIn p H ≤ M) {J : Subgroup G} (hJ : IsPComponentIn p J H)
    (hN : H ⊓ normalizer (J : Set G) ≤ M) : H ≤ M := by
  haveI : Fact p.Prime := ⟨hc.ctx.p_prime⟩
  have hJne : J ≠ ⊥ := CFSG.ComponentClassification.CatFactsSp4.ne_bot_of_isPComponent hJ.2
  have hAne : pLayerIn p H ≠ ⊥ := ne_bot_of_le_ne_bot hJne (le_pLayerIn hJ)
  obtain ⟨E, hEQ, hE, hEc, hΓ⟩ := hc.ctx.exists_E_sq
  have hB := (hc.h910 E hEQ hE hEc hΓ).2.1 hAne hA
  rcases hB with ⟨-, ⟨S, hScard, hScomp, hSsup, hSconj⟩, -, -⟩ |
      ⟨hpgt, -, hrank, -⟩ | ⟨-, -, -, hquasi, -⟩
  ·
    obtain ⟨a, b, c, -, -, -, rfl⟩ := Set.ncard_eq_three.mp hScard
    have ha : IsPComponentIn p a H := (hScomp a (by simp)).1
    have hb : IsPComponentIn p b H := (hScomp b (by simp)).1
    have hc' : IsPComponentIn p c H := (hScomp c (by simp)).1
    have hsup : pLayerIn p H = a ⊔ b ⊔ c := by
      simpa [sSup_insert, sSup_pair, sSup_singleton, sup_assoc] using hSsup
    have hJmem : J ∈ ({a, b, c} : Set (Subgroup G)) :=
      mem_of_isPComponentIn_of_eq_sup hc.ctx.p_prime ha hb hc' hsup hJ
    have hconj : ∀ h ∈ H, ∃ e ∈ E, J.map (MulAut.conj h).toMonoidHom =
        J.map (MulAut.conj e).toMonoidHom := fun h hh =>
      hSconj J hJmem _ (mem_of_isPComponentIn_of_eq_sup hc.ctx.p_prime ha hb hc' hsup
        (isPComponentIn_conj hJ hh))
    refine le_trans (le_sup_inf_normalizer_of_conj
      (hEH := fun e he => hc.ctx.Q_le_H (hEQ he))
      (hEM := fun e he => hc.ctx.Q_le_M (hEQ he)) hconj) (sup_le inf_le_right hN)
  ·
    have hp2 : p ≠ 2 := by
      rintro rfl
      omega
    have hHnorm : H ≤ normalizer (J : Set G) := le_normalizer_of_forall_eq hJ fun K hK =>
      eq_of_isPComponentIn_of_pRank_le_one hc.ctx.p_prime hp2 hJ hK (le_of_eq hrank)
    rw [inf_eq_left.mpr hHnorm] at hN
    exact hN
  ·
    have hHnorm : H ≤ normalizer (J : Set G) := le_normalizer_of_forall_eq hJ fun K hK =>
      eq_of_starImg_eq hc.ctx.p_prime hK hJ
        ((starImg_eq_of_isPComponentIn_of_quasisimple hc.ctx.p_prime hK hquasi).trans
          (starImg_eq_of_isPComponentIn_of_quasisimple hc.ctx.p_prime hJ hquasi).symm)
    rw [inf_eq_left.mpr hHnorm] at hN
    exact hN

end CFSG.LocalAnalysis.AGL81TheoremCD.Section12

