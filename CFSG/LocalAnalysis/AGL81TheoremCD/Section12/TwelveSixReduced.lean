private theorem prime_eq_three_or_seven_of_dvd_card_of_isL3TwoPow_one {L : Subgroup G} {q : ℕ}
    (hq : q.Prime) (hq2 : q ≠ 2) (hL3 : IsL3TwoPow 1 (↥L ⧸ pCore 2 ↥L))
    (hdvd : q ∣ Nat.card L) : q = 3 ∨ q = 7 := by
  have hqO : ¬ q ∣ Nat.card (pCore 2 ↥L) := by
    obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := 2) (G := ↥L)).exists_card_eq
    rw [hk]
    intro h
    exact hq2 ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).mp (hq.dvd_of_dvd_pow h))
  have hcard := Subgroup.card_eq_card_quotient_mul_card_subgroup (pCore 2 ↥L)
  rw [hcard] at hdvd
  rcases hq.dvd_mul.mp hdvd with h | h
  · have hqc : Nat.card (↥L ⧸ pCore 2 ↥L) = 168 := by
      have h := card_of_isL3TwoPow_of_odd (by decide : Odd 1) hL3
      norm_num at h ⊢
      exact h
    have h168 : q ∣ 168 := hqc ▸ h
    have h168' : q ∣ 2 ^ 3 * 3 * 7 := by simpa using h168
    rcases hq.dvd_mul.mp h168' with h2 | h7
    · rcases hq.dvd_mul.mp h2 with h2 | h3
      · exact absurd ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).mp
          (hq.dvd_of_dvd_pow h2)) hq2
      · exact Or.inl ((Nat.prime_dvd_prime_iff_eq hq (by norm_num : Nat.Prime 3)).mp h3)
    · exact Or.inr ((Nat.prime_dvd_prime_iff_eq hq (by norm_num : Nat.Prime 7)).mp h7)
  · exact absurd h hqO

private theorem exists_distinct_weakBlocks {M H L : Subgroup G}
    (hcard : 3 ≤ (weakBlockSet M H).ncard) (hL : L ∈ weakBlockSet M H) :
    ∃ A B : Subgroup G, A ∈ weakBlockSet M H ∧ B ∈ weakBlockSet M H ∧
      A ≠ L ∧ B ≠ L ∧ A ≠ B := by
  have hAex : ∃ A : Subgroup G, A ∈ weakBlockSet M H ∧ A ≠ L := by
    have hpos : 0 < (weakBlockSet M H \ {L}).ncard := by
      rw [Set.ncard_sdiff_singleton_of_mem hL]
      omega
    obtain ⟨A, hA⟩ := (Set.ncard_pos (Set.toFinite _)).mp hpos
    exact ⟨A, hA.1, by simpa using hA.2⟩
  obtain ⟨A, hA_mem, hA_ne⟩ := hAex
  have hBs : ∃ B : Subgroup G, B ∈ weakBlockSet M H ∧ B ≠ L ∧ B ≠ A := by
    have hmem : A ∈ weakBlockSet M H \ {L} := ⟨hA_mem, by simpa using hA_ne⟩
    have hpos : 0 < ((weakBlockSet M H \ {L}) \ {A}).ncard := by
      rw [Set.ncard_sdiff_singleton_of_mem hmem, Set.ncard_sdiff_singleton_of_mem hL]
      omega
    obtain ⟨B, hB⟩ := (Set.ncard_pos (Set.toFinite _)).mp hpos
    exact ⟨B, hB.1.1, by simpa using hB.1.2, by simpa using hB.2⟩
  obtain ⟨B, hB_mem, hB_ne_L, hB_ne_A⟩ := hBs
  exact ⟨A, B, hA_mem, hB_mem, hA_ne, hB_ne_L, hB_ne_A.symm⟩

private theorem barM_le_centralizer_of_weakBlock {M H L A W : Subgroup G}
    (hA : A ∈ weakBlockSet M H) (hL : L ∈ weakBlockSet M H) (hA_ne : A ≠ L)
    (hWL : W ≤ L)
    (hbar : barM M (Subgroup.centralizer (W : Set G) ⊓ M) =
      Subgroup.centralizer (barM M W)) :
    barM M A ≤ barM M (Subgroup.centralizer (W : Set G) ⊓ M) := by
  have hWLbar : barM M W ≤ barM M L := by
    intro x hx
    rw [barM] at hx ⊢
    exact Subgroup.map_mono (f := QuotientGroup.mk' (CFSG.pCore 2 ↥M))
      (fun y hy => hWL (Subgroup.mem_subgroupOf.mp hy)) hx
  have hc : barM M A ≤ Subgroup.centralizer (barM M L) :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp
      (CFSG.ComponentClassification.LocalComponents.commute_of_ne _ _
        hA.toIsTwoPrimeComponent.component hL.toIsTwoPrimeComponent.component
        fun he => hA_ne (hA.toIsTwoPrimeComponent.eq_of_barM_eq
          hL.toIsTwoPrimeComponent he))
  rw [hbar]
  intro x hx
  have hx' := hc hx
  rw [Subgroup.mem_centralizer_iff] at hx' ⊢
  exact fun w hw => hx' w (hWLbar hw)

private theorem two_le_pRank_barM_centralizer_of_elems {M A B W : Subgroup G} {d : ℕ}
    (hd : d.Prime)
    (hAcomp : IsTwoPrimeComponent M A) (hBcomp : IsTwoPrimeComponent M B) (hAB : A ≠ B)
    (hAX : barM M A ≤ barM M (Subgroup.centralizer (W : Set G) ⊓ M))
    (hBX : barM M B ≤ barM M (Subgroup.centralizer (W : Set G) ⊓ M))
    (y0 : ↥(barM M A)) (hy0ord : orderOf y0 = d)
    (hy0Z : ∃ l : ↥(barM M A), y0 * l ≠ l * y0)
    (y1 : ↥(barM M B)) (hy1ord : orderOf y1 = d)
    (hy1Z : ∃ l : ↥(barM M B), y1 * l ≠ l * y1) :
    2 ≤ CFSG.Open.pRank d (barM M (Subgroup.centralizer (W : Set G) ⊓ M)) := by
  let Y0 : ↥M ⧸ CFSG.pCore 2 ↥M := y0
  let Y1 : ↥M ⧸ CFSG.pCore 2 ↥M := y1
  have hY0ord : orderOf Y0 = d := by
    change orderOf (y0 : ↥M ⧸ CFSG.pCore 2 ↥M) = d
    rw [Subgroup.orderOf_coe, hy0ord]
  have hY1ord : orderOf Y1 = d := by
    change orderOf (y1 : ↥M ⧸ CFSG.pCore 2 ↥M) = d
    rw [Subgroup.orderOf_coe, hy1ord]
  have hY0Z : ∃ l ∈ barM M A, Y0 * l ≠ l * Y0 := by
    obtain ⟨l, hl⟩ := hy0Z
    exact ⟨(l : ↥M ⧸ CFSG.pCore 2 ↥M), l.2, fun h => hl (Subtype.ext h)⟩
  have hY1Z : ∃ l ∈ barM M B, Y1 * l ≠ l * Y1 := by
    obtain ⟨l, hl⟩ := hy1Z
    exact ⟨(l : ↥M ⧸ CFSG.pCore 2 ↥M), l.2, fun h => hl (Subtype.ext h)⟩
  let Lbar : Fin 2 → Subgroup (↥M ⧸ CFSG.pCore 2 ↥M) :=
    fun i => if i = 0 then barM M A else barM M B
  let yfun : Fin 2 → (↥M ⧸ CFSG.pCore 2 ↥M) :=
    fun i => if i = 0 then Y0 else Y1
  have hcomp : ∀ i, IsComponentOf (Lbar i) ⊤ := by
    intro i
    fin_cases i
    · simpa [Lbar] using hAcomp.component
    · simpa [Lbar] using hBcomp.component
  have hinj : Function.Injective Lbar := by
    intro i j hij
    fin_cases i <;> fin_cases j
    · rfl
    · exfalso
      simp [Lbar] at hij
      exact hAB (hAcomp.eq_of_barM_eq hBcomp hij)
    · exfalso
      simp [Lbar] at hij
      exact hAB (hBcomp.eq_of_barM_eq hAcomp hij).symm
    · rfl
  have hyA : ∀ i, yfun i ∈ barM M (Subgroup.centralizer (W : Set G) ⊓ M) := by
    intro i
    fin_cases i
    · change (y0 : ↥M ⧸ CFSG.pCore 2 ↥M) ∈
        barM M (Subgroup.centralizer (W : Set G) ⊓ M)
      exact hAX y0.2
    · change (y1 : ↥M ⧸ CFSG.pCore 2 ↥M) ∈
        barM M (Subgroup.centralizer (W : Set G) ⊓ M)
      exact hBX y1.2
  have hyL : ∀ i, yfun i ∈ Lbar i := by
    intro i
    fin_cases i
    · change (y0 : ↥M ⧸ CFSG.pCore 2 ↥M) ∈ barM M A
      exact y0.2
    · change (y1 : ↥M ⧸ CFSG.pCore 2 ↥M) ∈ barM M B
      exact y1.2
  have hyq : ∀ i, IsPGroup d (Subgroup.zpowers (yfun i)) := by
    intro i
    fin_cases i
    · refine IsPGroup.of_card (p := d) (n := 1) ?_
      simp [yfun, Nat.card_zpowers, hY0ord]
    · refine IsPGroup.of_card (p := d) (n := 1) ?_
      simp [yfun, Nat.card_zpowers, hY1ord]
  have hyZ : ∀ i, ∃ l ∈ Lbar i, yfun i * l ≠ l * yfun i := by
    intro i
    fin_cases i
    · simpa [yfun, Lbar] using hY0Z
    · simpa [yfun, Lbar] using hY1Z
  have h := le_pRank_of_components hd Lbar hcomp hinj
    (barM M (Subgroup.centralizer (W : Set G) ⊓ M)) yfun hyA hyL hyq hyZ
  simpa using h

private theorem two_le_pRank_barM_centralizer {M H A B W : Subgroup G} {d : ℕ}
    (hd : d.Prime) (hd2 : d ≠ 2)
    (hL3 : ∀ X : Subgroup G, X ∈ weakBlockSet M H →
      ∃ n : ℕ, Odd n ∧ IsL3TwoPow n (↥X ⧸ pCore 2 ↥X))
    (hdvdL : ∀ X : Subgroup G, X ∈ weakBlockSet M H → d ∣ Nat.card X)
    (hA : A ∈ weakBlockSet M H) (hB : B ∈ weakBlockSet M H) (hAB : A ≠ B)
    (hAX : barM M A ≤ barM M (Subgroup.centralizer (W : Set G) ⊓ M))
    (hBX : barM M B ≤ barM M (Subgroup.centralizer (W : Set G) ⊓ M)) :
    2 ≤ CFSG.Open.pRank d (barM M (Subgroup.centralizer (W : Set G) ⊓ M)) := by
  obtain ⟨y0, hy0ord, hy0Z⟩ := exists_orderOf_eq_not_commute_barM hd hd2
    hA.toIsTwoPrimeComponent (hL3 A hA) (hdvdL A hA)
  obtain ⟨y1, hy1ord, hy1Z⟩ := exists_orderOf_eq_not_commute_barM hd hd2
    hB.toIsTwoPrimeComponent (hL3 B hB) (hdvdL B hB)
  exact two_le_pRank_barM_centralizer_of_elems hd
    hA.toIsTwoPrimeComponent hB.toIsTwoPrimeComponent hAB hAX hBX
    y0 hy0ord hy0Z y1 hy1ord hy1Z

private theorem not_isPSolvable_barM_centralizer {M A W : Subgroup G} {d : ℕ}
    (hd : d.Prime) (hd2 : d ≠ 2) (hAcomp : IsTwoPrimeComponent M A)
    (hdvdA : d ∣ Nat.card A)
    (hAX : barM M A ≤ barM M (Subgroup.centralizer (W : Set G) ⊓ M)) :
    ¬ CFSG.HallHigman.IsPSolvable d
      ↥(barM M (Subgroup.centralizer (W : Set G) ⊓ M)) := by
  haveI : Fact d.Prime := ⟨hd⟩
  have hdvdAbar := dvd_card_barM_of_isTwoPrimeComponent hd hd2 hAcomp hdvdA
  have hnotAbar : ¬ CFSG.HallHigman.IsPSolvable d ↥(barM M A) :=
    CFSG.LocalAnalysis.RankThreeTheoremC.RankOneCent.not_isPSolvable_of_isQuasisimple
      hAcomp.component.2.2 hdvdAbar
  intro hsolv
  exact hnotAbar
    (CFSG.AGLEmbeddingD2.Tits.OrdinaryProofs.PSolvableClosure.isPSolvable_of_le
      hsolv hAX)

theorem centralizer_inputs_of_mem_weakBlockSet {M H L W : Subgroup G} {d : ℕ} (hd : d.Prime)
    (hd2 : d ≠ 2)
    (hL3 : ∀ A : Subgroup G, A ∈ weakBlockSet M H →
      ∃ n : ℕ, Odd n ∧ IsL3TwoPow n (↥A ⧸ pCore 2 ↥A))
    (hdvdL : ∀ A : Subgroup G, A ∈ weakBlockSet M H → d ∣ Nat.card A)
    (hcard : 3 ≤ (weakBlockSet M H).ncard) (hL : L ∈ weakBlockSet M H)
    (hW : Nat.card W = 3) (hWL : W ≤ L) :
    2 ≤ CFSG.Open.pRank d (Subgroup.centralizer (W : Set G) ⊓ M) ∧
      ¬ CFSG.HallHigman.IsPSolvable d ↥(Subgroup.centralizer (W : Set G) ⊓ M) := by
  classical
  haveI : Fact d.Prime := ⟨hd⟩
  obtain ⟨A, B, hA, hB, hAne, hBne, hAB⟩ := exists_distinct_weakBlocks hcard hL
  have hWM : W ≤ M := hWL.trans hL.le
  have hbar := barM_centralizer_inf_eq hWM hW
  have hAX := barM_le_centralizer_of_weakBlock hA hL hAne hWL hbar
  have hBX := barM_le_centralizer_of_weakBlock hB hL hBne hWL hbar
  have hrankBar := two_le_pRank_barM_centralizer hd hd2 hL3 hdvdL hA hB hAB hAX hBX
  have hXM : Subgroup.centralizer (W : Set G) ⊓ M ≤ M := inf_le_right
  have hrank : 2 ≤ CFSG.Open.pRank d (Subgroup.centralizer (W : Set G) ⊓ M) :=
    hrankBar.trans (pRank_barM_le hd hd2 M _ hXM)
  have hnotBar := not_isPSolvable_barM_centralizer hd hd2
    hA.toIsTwoPrimeComponent (hdvdL A hA) hAX
  have hnotX : ¬ CFSG.HallHigman.IsPSolvable d
      ↥(Subgroup.centralizer (W : Set G) ⊓ M) := by
    intro hsolv
    have hsolvTop : CFSG.HallHigman.IsPSolvable d
        ↥(⊤ : Subgroup ↥(Subgroup.centralizer (W : Set G) ⊓ M)) :=
      CFSG.AGLEmbeddingD2.Tits.OrdinaryProofs.QuasisimpleSolvableNormal.isPSolvable_of_mulEquiv
        (Subgroup.topEquiv (G := ↥(Subgroup.centralizer (W : Set G) ⊓ M))).symm hsolv
    have hmap := CFSG.AGLEmbeddingD2.Tits.OrdinaryProofs.PSolvableClosure.isPSolvable_map
      (p := d) (N := ⊤)
      (CFSG.HardMathSupport.Cooperstein.Proving.barMHomSub hXM) hsolvTop
    rw [Subgroup.map_top_of_surjective _
      (CFSG.HardMathSupport.Cooperstein.Proving.barMHomSub_surjective hXM)] at hmap
    exact hnotBar
      (QuasisimpleSolvableNormal.isPSolvable_of_mulEquiv Subgroup.topEquiv hmap)
  exact ⟨hrank, hnotX⟩

theorem odd_prime_divisors_of_n_eq_one {M H : Subgroup G} {d : ℕ} {L₁ L₂ L₃ : Subgroup G}
    {n₁ n₂ n₃ : ℕ} (hdata : TwelveFiveData M H d L₁ L₂ L₃ n₁ n₂ n₃) (h1 : n₁ = 1) (h2 : n₂ = 1)
    (h3 : n₃ = 1) :
    ∀ q : ℕ, q.Prime → q ≠ 2 → q ∣ Nat.card (jSub M H) → q = 3 ∨ q = 7 := by
  intro q hq hq2 hqJ
  have h21 : L₂ ≤ Subgroup.normalizer (L₁ : Set G) :=
    le_normalizer_of_mem_weakBlockSet hdata.mem₂ hdata.mem₁
  have hdiv12 : Nat.card (L₁ ⊔ L₂ : Subgroup G) ∣ Nat.card L₁ * Nat.card L₂ := by
    have h := CFSG.GroupTheory.CoprimeActionSupport.NormalSubgroupSylowJoin.card_sup_mul_card_inf
      h21
    rw [sup_comm L₂ L₁, inf_comm L₂ L₁, Nat.mul_comm (Nat.card L₂) (Nat.card L₁)] at h
    exact ⟨_, h.symm⟩
  have h3P : L₃ ≤ Subgroup.normalizer ((L₁ ⊔ L₂ : Subgroup G) : Set G) := by
    have h31 : L₃ ≤ Subgroup.normalizer (L₁ : Set G) :=
      le_normalizer_of_mem_weakBlockSet hdata.mem₃ hdata.mem₁
    have h32 : L₃ ≤ Subgroup.normalizer (L₂ : Set G) :=
      le_normalizer_of_mem_weakBlockSet hdata.mem₃ hdata.mem₂
    exact (le_inf h31 h32).trans (Subgroup.inf_normalizer_le_normalizer_sup L₁ L₂)
  have hdiv123 : Nat.card (L₁ ⊔ L₂ ⊔ L₃ : Subgroup G) ∣
      Nat.card (L₁ ⊔ L₂ : Subgroup G) * Nat.card L₃ := by
    have h := CFSG.GroupTheory.CoprimeActionSupport.NormalSubgroupSylowJoin.card_sup_mul_card_inf
      h3P
    rw [sup_comm L₃ (L₁ ⊔ L₂), inf_comm L₃ (L₁ ⊔ L₂),
      Nat.mul_comm (Nat.card L₃) (Nat.card (L₁ ⊔ L₂ : Subgroup G))] at h
    exact ⟨_, h.symm⟩
  have hqJ' : q ∣ Nat.card (L₁ ⊔ L₂ ⊔ L₃ : Subgroup G) := by
    simpa [hdata.join_eq] using hqJ
  have hqP : q ∣ Nat.card (L₁ ⊔ L₂ : Subgroup G) * Nat.card L₃ :=
    hqJ'.trans hdiv123
  have hqprod : q ∣ (Nat.card L₁ * Nat.card L₂) * Nat.card L₃ := by
    obtain ⟨k, hk⟩ := hdiv12
    obtain ⟨l, hl⟩ := hqP
    refine ⟨l * k, ?_⟩
    calc
      Nat.card L₁ * Nat.card L₂ * Nat.card L₃
          = (Nat.card (L₁ ⊔ L₂ : Subgroup G) * k) * Nat.card L₃ := by rw [hk]
      _ = (Nat.card (L₁ ⊔ L₂ : Subgroup G) * Nat.card L₃) * k := by ring
      _ = (q * l) * k := by rw [hl]
      _ = q * (l * k) := by ring
  rcases hq.dvd_mul.mp hqprod with hq12 | hq3
  · rcases hq.dvd_mul.mp hq12 with hq1 | hq2'
    · exact prime_eq_three_or_seven_of_dvd_card_of_isL3TwoPow_one hq hq2 (h1 ▸ hdata.type₁) hq1
    · exact prime_eq_three_or_seven_of_dvd_card_of_isL3TwoPow_one hq hq2 (h2 ▸ hdata.type₂) hq2'
  · exact prime_eq_three_or_seven_of_dvd_card_of_isL3TwoPow_one hq hq2 (h3 ▸ hdata.type₃) hq3

structure TwelveSixInputsV2 (M H : Subgroup G) (p d n₁ n₂ n₃ : ℕ) : Prop where
