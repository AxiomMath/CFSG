private noncomputable abbrev a9K (p : ℕ) (M H : Subgroup G) : Subgroup G := kSub p M H

private noncomputable abbrev a9A (M H Q : Subgroup G) : Subgroup G := Q ⊓ jSub M H

private noncomputable abbrev a9W (M H Q : Subgroup G) (L : Subgroup G) : Subgroup G := a9A M H Q ⊓ L

private noncomputable abbrev a9O (p : ℕ) (M H : Subgroup G) : Subgroup ↥(a9K p M H) :=
  CFSG.pCore 2 ↥(a9K p M H)

private abbrev a9Kbar (M H : Subgroup G) : Type := ↥(a9K 3 M H) ⧸ a9O 3 M H

private noncomputable abbrev a9π (p : ℕ) (M H : Subgroup G) :
    ↥(a9K p M H) →* (↥(a9K p M H) ⧸ a9O p M H) :=
  QuotientGroup.mk' (a9O p M H)

private noncomputable abbrev a9Abar (M H Q : Subgroup G) : Subgroup (a9Kbar M H) :=
  ((a9A M H Q).subgroupOf (a9K 3 M H)).map (a9π 3 M H)

private noncomputable abbrev a9Wbar (M H Q : Subgroup G) (L : Subgroup G) :
    Subgroup (a9Kbar M H) :=
  ((a9W M H Q L).subgroupOf (a9K 3 M H)).map (a9π 3 M H)

private theorem a9_isElemAbelian_inf_jSub_of_wreath {M H Q : Subgroup G}
    (e : ↥Q ≃* W3) (hcomm : IsMulCommutative (Q ⊓ jSub M H : Subgroup G))
    (hcard : Nat.card (Q ⊓ jSub M H : Subgroup G) = 27) :
    IsElemAbelian 3 (Q ⊓ jSub M H : Subgroup G) := by
  let A : Subgroup G := Q ⊓ jSub M H
  have hAQ : A ≤ Q := inf_le_left
  let A' : Subgroup W3 := (A.subgroupOf Q).map e.toMonoidHom
  have hA'comm : ∀ a ∈ A', ∀ b ∈ A', a * b = b * a := by
    rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
    rw [← map_mul, ← map_mul]
    refine congrArg e (Subtype.ext ?_)
    exact congrArg (fun z : ↥A => (z : G)) (hcomm.is_comm.comm
      ⟨(a : G), Subgroup.mem_subgroupOf.mp ha⟩
      ⟨(b : G), Subgroup.mem_subgroupOf.mp hb⟩)
  have hA'card : Nat.card A' = 27 := by
    change Nat.card ((A.subgroupOf Q).map e.toMonoidHom) = 27
    rw [Subgroup.card_map_of_injective e.injective,
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAQ).toEquiv, hcard]
  have hA'eq : A' = wBase := eq_wBase_of_comm hA'comm (by rw [hA'card])
  refine ⟨⟨⟨fun a b => ?_⟩⟩, fun x hx => ?_⟩
  · exact hcomm.is_comm.comm a b
  · have hx' : e ⟨x, hAQ hx⟩ ∈ wBase := by
      rw [← hA'eq]
      exact Subgroup.mem_map.mpr
        ⟨⟨x, hAQ hx⟩, Subgroup.mem_subgroupOf.mpr hx, rfl⟩
    have hcube : e ⟨x, hAQ hx⟩ ^ 3 = 1 :=
      CFSG.LocalAnalysis.RankThreeTheoremC.wreath_ker_isElemAbelian.2 _ hx'
    have hx3 : (⟨x, hAQ hx⟩ : ↥Q) ^ 3 = 1 := by
      apply e.injective
      rw [map_pow, hcube, map_one]
    exact congrArg Subtype.val hx3

private theorem a9_card_quotient_L₁
    (hd : TwelveFiveData M H d L₁ L₂ L₃ n₁ n₂ n₃)
    (h6 : TwelveSix M H p d L₁ L₂ L₃ n₁ n₂ n₃) :
    Nat.card (↥L₁ ⧸ pCore 2 ↥L₁) = 168 := by
  have htype : IsL3TwoPow 1 (↥L₁ ⧸ pCore 2 ↥L₁) := by
    have h := hd.type₁
    rwa [TwelveSix.n₁_eq_one hd h6] at h
  have h := card_of_isL3TwoPow_of_odd (n := 1) (by decide : Odd 1) htype
  norm_num at h ⊢
  exact h

private theorem a9_factorization_card_L₁
    (hd : TwelveFiveData M H d L₁ L₂ L₃ n₁ n₂ n₃)
    (h6 : TwelveSix M H p d L₁ L₂ L₃ n₁ n₂ n₃) :
    (Nat.card L₁).factorization 3 = 1 := by
  have hquot := a9_card_quotient_L₁ hd h6
  have hmul : Nat.card L₁ =
      Nat.card (↥L₁ ⧸ pCore 2 ↥L₁) * Nat.card (pCore 2 ↥L₁) :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup (pCore 2 ↥L₁)
  obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := 2) (G := ↥L₁)).exists_card_eq
  have hcardL : Nat.card L₁ = 168 * 2 ^ k := by
    rw [hmul, hquot, hk, Nat.mul_comm]
  have hne : Nat.card L₁ ≠ 0 := by
    haveI : Nonempty ↥L₁ := ⟨1⟩
    exact (Nat.card_pos (α := ↥L₁)).ne'
  have h1 : 3 ^ 1 ∣ Nat.card L₁ := by
    rw [hcardL]
    exact dvd_mul_of_dvd_left (by norm_num : 3 ∣ 168) (2 ^ k)
  have h2 : ¬ 3 ^ 2 ∣ Nat.card L₁ := by
    rw [hcardL]
    intro hdiv
    have hcop : Nat.Coprime 9 (2 ^ k) :=
      Nat.Prime.coprime_pow_of_not_dvd (p := 2) (m := k) Nat.prime_two (by norm_num)
    exact (by norm_num : ¬ (9 : ℕ) ∣ 168) ((Nat.Coprime.dvd_mul_right hcop).mp hdiv)
  have hge : 1 ≤ (Nat.card L₁).factorization 3 :=
    (Nat.Prime.pow_dvd_iff_le_factorization Nat.prime_three hne).mp h1
  have hlt : ¬ 2 ≤ (Nat.card L₁).factorization 3 := fun hle =>
    h2 ((Nat.Prime.pow_dvd_iff_le_factorization Nat.prime_three hne).mpr hle)
  omega

private theorem a9_card_thompson_inf_L₁
    (hd : TwelveFiveData M H d L₁ L₂ L₃ n₁ n₂ n₃)
    (h6 : TwelveSix M H p d L₁ L₂ L₃ n₁ n₂ n₃)
    (hQsyl : CFSG.ABGLocalTools.IsSylowOf 3 Q M) :
    Nat.card (Q ⊓ jSub M H ⊓ L₁ : Subgroup G) = 3 := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hJN : M ≤ Subgroup.normalizer (jSub M H : Set G) :=
    TwelveFiveData.le_normalizer_jSub hd
  have hAsyl : CFSG.ABGLocalTools.IsSylowOf 3 (Q ⊓ jSub M H) (jSub M H) :=
    hQsyl.inf_of_le_normalizer (jSub_le M H) hJN
  have hLN : jSub M H ≤ Subgroup.normalizer (L₁ : Set G) :=
    TwelveFiveData.jSub_le_normalizer_left hd
  have hWsyl : CFSG.ABGLocalTools.IsSylowOf 3 ((Q ⊓ jSub M H) ⊓ L₁) L₁ :=
    hAsyl.inf_of_le_normalizer (le_jSub hd.mem₁) hLN
  have hfac := a9_factorization_card_L₁ hd h6
  rw [hWsyl.card_eq, hfac, pow_one]

private theorem a9_card_map_mk'_eq {K W : Subgroup G} {O : Subgroup ↥K} [O.Normal]
    {n : ℕ}
    (hWK : W ≤ K) (hWcard : Nat.card W = n) (hN : ¬ 3 ∣ Nat.card O)
    (hW3 : IsPGroup 3 (W.subgroupOf K)) :
    Nat.card ((W.subgroupOf K).map (QuotientGroup.mk' O)) = n := by
  let π : ↥K →* (↥K ⧸ O) := QuotientGroup.mk' O
  have hWO : W.subgroupOf K ⊓ O = ⊥ :=
    CFSG.GroupTheory.SteinbergBS.inf_eq_bot_of_isPGroup_of_not_dvd (p := 3) hN hW3
  have hinj : Function.Injective (π.comp (W.subgroupOf K).subtype) := by
    rw [injective_iff_map_eq_one]
    intro x hx
    have hxO : (x : ↥K) ∈ O := (QuotientGroup.eq_one_iff (x : ↥K)).1 hx
    have hxbot : (x : ↥K) ∈ W.subgroupOf K ⊓ O := ⟨x.2, hxO⟩
    rw [hWO, Subgroup.mem_bot] at hxbot
    exact Subtype.ext hxbot
  have hcard := Subgroup.card_map_of_injective (f := π.comp (W.subgroupOf K).subtype)
    (K := ⊤) hinj
  rw [Subgroup.map_top] at hcard
  rw [MonoidHom.range_comp, Subgroup.range_subtype, Subgroup.card_top] at hcard
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hWK).toEquiv, hWcard] at hcard
  exact hcard

private theorem a9_subgroupOf_map_conj {K W : Subgroup G} (hWK : W ≤ K) (g : G)
    (hg : g ∈ K) :
    (W.subgroupOf K).map (MulAut.conj (⟨g, hg⟩ : ↥K)).toMonoidHom =
      (W.map (MulAut.conj g).toMonoidHom).subgroupOf K := by
  have h := Subgroup.conj_smul_subgroupOf hWK (⟨g, hg⟩ : ↥K)
  change (W.subgroupOf K).map (MulAut.conj (⟨g, hg⟩ : ↥K)).toMonoidHom =
      (W.map (MulAut.conj g).toMonoidHom).subgroupOf K at h
  exact h

private theorem a9_centralizer_subgroupOf {K W : Subgroup G} (hWK : W ≤ K) :
    Subgroup.centralizer ((W.subgroupOf K : Subgroup ↥K) : Set ↥K) =
      (Subgroup.centralizer (W : Set G) ⊓ K).subgroupOf K := by
  ext x
  rw [Subgroup.mem_centralizer_iff, Subgroup.mem_subgroupOf, Subgroup.mem_inf,
    Subgroup.mem_centralizer_iff]
  constructor
  · intro hx
    refine ⟨fun w hw => ?_, x.2⟩
    exact congrArg Subtype.val (hx ⟨w, hWK hw⟩ (Subgroup.mem_subgroupOf.mpr hw))
  · rintro ⟨hx, -⟩ w hw
    exact Subtype.ext (hx (w : G) (Subgroup.mem_subgroupOf.mp hw))

private theorem a9_centralizer_map_eq {K W : Subgroup G} {O : Subgroup ↥K} [O.Normal]
    (hWK : W ≤ K) (hWcard : Nat.card W = 3) (hN : ¬ 3 ∣ Nat.card O) :
    Subgroup.centralizer (((W.subgroupOf K).map (QuotientGroup.mk' O)) : Set (↥K ⧸ O)) =
      ((Subgroup.centralizer (W : Set G) ⊓ K).subgroupOf K).map
        (QuotientGroup.mk' O) := by
  let π : ↥K →* (↥K ⧸ O) := QuotientGroup.mk' O
  have hWsub3 : IsPGroup 3 (W.subgroupOf K) := by
    refine IsPGroup.of_card (n := 1) ?_
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hWK).toEquiv, hWcard]
    norm_num
  have hcent := CFSG.GroupTheory.SteinbergBS.centralizer_map_mk'_eq (p := 3) (N := O)
    hN (Q := W.subgroupOf K) hWsub3
  have hcentK := a9_centralizer_subgroupOf hWK
  rw [hcent, hcentK]

private theorem a9_normalizer_image_le {K A : Subgroup G} {O : Subgroup ↥K} [O.Normal]
    (hAK : A ≤ K) :
    ((K ⊓ Subgroup.normalizer (A : Set G)).subgroupOf K).map (QuotientGroup.mk' O) ≤
      Subgroup.normalizer (((A.subgroupOf K).map (QuotientGroup.mk' O)) : Set (↥K ⧸ O)) := by
  let π : ↥K →* (↥K ⧸ O) := QuotientGroup.mk' O
  have hH : (K ⊓ Subgroup.normalizer (A : Set G)).subgroupOf K =
      Subgroup.normalizer (A.subgroupOf K : Set ↥K) := by
    rw [← Subgroup.subgroupOf_normalizer_eq hAK]
    ext x
    simp [Subgroup.mem_subgroupOf]
  rw [hH]
  exact Subgroup.le_normalizer_map π

private theorem a9_centralizer_map_le_normalizer_map {K A W : Subgroup G}
    {O : Subgroup ↥K} [O.Normal] (hOsub : (CFSG.Open.pCoreOf 2 K).subgroupOf K = O)
    (hWK : W ≤ K) (hAK : A ≤ K) (hWcard : Nat.card W = 3)
    (hN : ¬ 3 ∣ Nat.card O) (hA3 : IsPGroup 3 (A.subgroupOf K))
    (hc : Subgroup.centralizer (W : Set G) ⊓ K ≤
      (K ⊓ Subgroup.normalizer (A : Set G)) ⊔ CFSG.Open.pCoreOf 2 K) :
    Subgroup.centralizer (((W.subgroupOf K).map (QuotientGroup.mk' O)) :
        Set (↥K ⧸ O)) ≤
      Subgroup.normalizer (((A.subgroupOf K).map (QuotientGroup.mk' O)) :
        Set (↥K ⧸ O)) := by
  let π : ↥K →* (↥K ⧸ O) := QuotientGroup.mk' O
  intro z hz
  rw [a9_centralizer_map_eq hWK hWcard hN] at hz
  obtain ⟨x, hx, rfl⟩ := hz
  have hx' : (x : G) ∈ Subgroup.centralizer (W : Set G) ⊓ K :=
    Subgroup.mem_subgroupOf.mp hx
  have hxsup : x ∈ (K ⊓ Subgroup.normalizer (A : Set G)).subgroupOf K ⊔ O := by
    have h1 : x ∈ ((K ⊓ Subgroup.normalizer (A : Set G)) ⊔
        CFSG.Open.pCoreOf 2 K).subgroupOf K :=
      Subgroup.mem_subgroupOf.mpr (hc hx')
    have hOmle : CFSG.Open.pCoreOf 2 K ≤ K := Subgroup.map_subtype_le _
    rwa [Subgroup.subgroupOf_sup inf_le_left hOmle, hOsub] at h1
  have hxH : π x ∈ ((K ⊓ Subgroup.normalizer (A : Set G)).subgroupOf K).map π := by
    have hmem : π x ∈ ((K ⊓ Subgroup.normalizer (A : Set G)).subgroupOf K ⊔ O).map π :=
      Subgroup.mem_map.mpr ⟨x, hxsup, rfl⟩
    rwa [Subgroup.map_sup, QuotientGroup.map_mk'_self, sup_bot_eq] at hmem
  exact a9_normalizer_image_le hAK hxH

private theorem a9_exists_lift_normalizer {K A : Subgroup G} {O : Subgroup ↥K} [O.Normal]
    (hAK : A ≤ K) (hN : ¬ 3 ∣ Nat.card O) (hA3 : IsPGroup 3 (A.subgroupOf K))
    {ybar : ↥K ⧸ O}
    (hybar : ybar ∈ Subgroup.normalizer
      (((A.subgroupOf K).map (QuotientGroup.mk' O)) : Set (↥K ⧸ O))) :
    ∃ y : ↥K, y ∈ Subgroup.normalizer (A.subgroupOf K : Set ↥K) ∧
      (QuotientGroup.mk' O) y = ybar := by
  have hnorm := CFSG.GroupTheory.normal_coprime_quotient_normalizer 3 O hN
    (A.subgroupOf K) hA3
  have hy_mem : ybar ∈ (Subgroup.normalizer (A.subgroupOf K : Set ↥K)).map
      (QuotientGroup.mk' O) := by
    rw [hnorm]
    exact hybar
  obtain ⟨y, hyN, hyy⟩ := Subgroup.mem_map.mp hy_mem
  exact ⟨y, hyN, hyy⟩

private theorem a9_mem_M_of_mem_normalizer {M H Q K A : Subgroup G} {d : ℕ}
    {L₁ L₂ L₃ : Subgroup G} {n₁ n₂ n₃ : ℕ}
    (hd : TwelveFiveData M H d L₁ L₂ L₃ n₁ n₂ n₃)
    (h6 : TwelveSix M H 3 d L₁ L₂ L₃ n₁ n₂ n₃)
    (hK : K = kSub 3 M H) (hAK : A ≤ K)
    (hJ : thompsonSubgroup Q = A)
    (hP : CFSG.ABGLocalTools.IsSylowOf 3 Q (kSub 3 M H ⊓ M))
    {y : ↥K} (hyN : y ∈ Subgroup.normalizer (A.subgroupOf K : Set ↥K)) :
    (y : G) ∈ M := by
  have hyNG : (y : G) ∈ Subgroup.normalizer (A : Set G) := by
    have h := hyN
    rw [← Subgroup.subgroupOf_normalizer_eq hAK] at h
    exact Subgroup.mem_subgroupOf.mp h
  have h := h6.part_six hd Q hP
  have hyKM : (y : G) ∈ kSub 3 M H ⊓ M := by
    rw [h]
    refine Subgroup.mem_sup_left ⟨hK ▸ y.2, ?_⟩
    rwa [hJ]
  exact hyKM.2

private theorem a9_map_conj_mem_blockSet {M H A W L : Subgroup G} {d : ℕ}
    {L₁ L₂ L₃ : Subgroup G} {n₁ n₂ n₃ : ℕ}
    (hd : TwelveFiveData M H d L₁ L₂ L₃ n₁ n₂ n₃)
    (hWL : W = A ⊓ L) (hL : L ∈ ({L₁, L₂, L₃} : Set (Subgroup G)))
    {y : G} (hyM : y ∈ M) (hyNG : y ∈ Subgroup.normalizer (A : Set G)) :
    W.map (MulAut.conj y).toMonoidHom ∈
      ({A ⊓ L₁, A ⊓ L₂, A ⊓ L₃} : Set (Subgroup G)) := by
  have hLmem : L.map (MulAut.conj y).toMonoidHom ∈
      ({L₁, L₂, L₃} : Set (Subgroup G)) :=
    hd.map_conj_mem hyM hL
  have hAconj : A.map (MulAut.conj y).toMonoidHom = A := by
    simpa using Subgroup.mem_normalizer_iff_map_conj_eq.mp hyNG
  rw [hWL, Subgroup.map_inf _ _ _ (MulAut.conj y).injective, hAconj]
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hLmem
  rcases hLmem with rfl | rfl | rfl <;> simp

private theorem a9_map_conj_image_eq {K W : Subgroup G} {O : Subgroup ↥K} [O.Normal]
    (hWK : W ≤ K) {y : ↥K} :
    ((W.subgroupOf K).map (QuotientGroup.mk' O)).map
        (MulAut.conj ((QuotientGroup.mk' O) y)).toMonoidHom =
      ((W.map (MulAut.conj (y : G)).toMonoidHom).subgroupOf K).map
        (QuotientGroup.mk' O) := by
  let π : ↥K →* (↥K ⧸ O) := QuotientGroup.mk' O
  have hcomp : (MulAut.conj (π y)).toMonoidHom.comp π =
      π.comp (MulAut.conj y).toMonoidHom := by
    ext x
    change (π y) * π x * (π y)⁻¹ = π (y * x * y⁻¹)
    rw [map_mul, map_mul, map_inv]
  have hsub := a9_subgroupOf_map_conj hWK (y : G) y.2
  calc ((W.subgroupOf K).map π).map (MulAut.conj (π y)).toMonoidHom
      = (W.subgroupOf K).map ((MulAut.conj (π y)).toMonoidHom.comp π) := by
        rw [Subgroup.map_map]
    _ = (W.subgroupOf K).map (π.comp (MulAut.conj y).toMonoidHom) := by rw [hcomp]
    _ = ((W.subgroupOf K).map (MulAut.conj y).toMonoidHom).map π := by
        rw [Subgroup.map_map]
    _ = ((W.map (MulAut.conj (y : G)).toMonoidHom).subgroupOf K).map π := by rw [hsub]

private theorem a9_map_conj_mem_blockImages
    {M H Q : Subgroup G} {d : ℕ} {L₁ L₂ L₃ : Subgroup G} {n₁ n₂ n₃ : ℕ}
    (hd : TwelveFiveData M H d L₁ L₂ L₃ n₁ n₂ n₃)
    (h6 : TwelveSix M H 3 d L₁ L₂ L₃ n₁ n₂ n₃)
    {K A : Subgroup G} {O : Subgroup ↥K} [O.Normal] (hK : K = kSub 3 M H)
    (hAK : A ≤ K) (hN : ¬ 3 ∣ Nat.card O)
    (hA3 : IsPGroup 3 (A.subgroupOf K))
    (hJ : thompsonSubgroup Q = A)
    (hP : CFSG.ABGLocalTools.IsSylowOf 3 Q (kSub 3 M H ⊓ M))
    {L W : Subgroup G} (hWL : W = A ⊓ L)
    (hL : L ∈ ({L₁, L₂, L₃} : Set (Subgroup G)))
    {ybar : ↥K ⧸ O}
    (hybar : ybar ∈ Subgroup.normalizer
      (((A.subgroupOf K).map (QuotientGroup.mk' O)) : Set (↥K ⧸ O))) :
    ((W.subgroupOf K).map (QuotientGroup.mk' O)).map (MulAut.conj ybar).toMonoidHom ∈
      ({((A ⊓ L₁).subgroupOf K).map (QuotientGroup.mk' O),
        ((A ⊓ L₂).subgroupOf K).map (QuotientGroup.mk' O),
        ((A ⊓ L₃).subgroupOf K).map (QuotientGroup.mk' O)} :
        Set (Subgroup (↥K ⧸ O))) := by
  have hWK : W ≤ K := by
    rw [hWL]
    exact fun x hx => hAK hx.1
  obtain ⟨y, hyN, hyy⟩ := a9_exists_lift_normalizer hAK hN hA3 hybar
  have hyNG : (y : G) ∈ Subgroup.normalizer (A : Set G) := by
    have h := hyN
    rw [← Subgroup.subgroupOf_normalizer_eq hAK] at h
    exact Subgroup.mem_subgroupOf.mp h
  have hyM := a9_mem_M_of_mem_normalizer hd h6 hK hAK hJ hP hyN
  have hWmap := a9_map_conj_mem_blockSet hd hWL hL hyM hyNG
  rw [← hyy, a9_map_conj_image_eq hWK]
  rcases hWmap with h | h | h
  · rw [h]; exact Or.inl rfl
  · rw [h]; exact Or.inr (Or.inl rfl)
  · rw [h]; exact Or.inr (Or.inr rfl)

private theorem a9_permCongr_comp_injective {Γ : Type} [Group Γ]
    (ψ : Γ ≃* alternatingGroup (Fin 9)) :
    Function.Injective ((eqPt.permCongrHom).toMonoidHom.comp
      ((alternatingGroup (Fin 9)).subtype.comp ψ.toMonoidHom)) := by
  intro x y hxy
  have h1 : eqPt.permCongrHom ((alternatingGroup (Fin 9)).subtype (ψ x)) =
      eqPt.permCongrHom ((alternatingGroup (Fin 9)).subtype (ψ y)) := hxy
  exact ψ.injective
    (Subgroup.subtype_injective _ (eqPt.permCongrHom.injective h1))

private theorem a9_permCongr_range :
    (alternatingGroup (Fin 9)).map eqPt.permCongrHom.toMonoidHom = alternatingGroup Pt := by
  ext τ
  constructor
  · rintro ⟨σ, hσ, rfl⟩
    have hσ' : Perm.sign σ = 1 := by
      simpa [Perm.mem_alternatingGroup] using hσ
    rw [Perm.mem_alternatingGroup]
    have hcoe : eqPt.permCongrHom σ = eqPt.permCongr σ :=
      congrFun (Equiv.permCongrHom_coe eqPt) σ
    change Perm.sign (eqPt.permCongrHom σ) = 1
    rw [hcoe, Perm.sign_permCongr, hσ']
  · intro hτ
    have hτ' : Perm.sign τ = 1 := by
      simpa [Perm.mem_alternatingGroup] using hτ
    refine ⟨eqPt.permCongrHom.symm τ, ?_, ?_⟩
    · show Perm.sign (eqPt.permCongrHom.symm τ) = 1
      rw [← hτ']
      exact Perm.sign_permCongr eqPt.symm τ
    · exact eqPt.permCongrHom.apply_symm_apply τ

private theorem a9_permCongr_comp_range {Γ : Type} [Group Γ]
    (ψ : Γ ≃* alternatingGroup (Fin 9)) :
    ((eqPt.permCongrHom).toMonoidHom.comp
      ((alternatingGroup (Fin 9)).subtype.comp ψ.toMonoidHom)).range =
      alternatingGroup Pt := by
  rw [MonoidHom.range_comp]
  have hinner : ((alternatingGroup (Fin 9)).subtype.comp ψ.toMonoidHom).range =
      alternatingGroup (Fin 9) := by
    rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr ψ.surjective, Subgroup.map_top,
      Subgroup.range_subtype]
  rw [hinner, a9_permCongr_range]

private theorem a9_exists_conj_embedding_baseGroup {Γ : Type} [Group Γ]
    (ψ : Γ ≃* alternatingGroup (Fin 9)) {E : Subgroup Γ}
    (hE : IsElemAbelian 3 E) (hEcard : Nat.card E = 27) :
    ∃ φ : Γ →* Perm Pt, Function.Injective φ ∧ φ.range = alternatingGroup Pt ∧
      E.map φ = baseGroup := by
  let φ₀ : Γ →* Perm Pt :=
    (eqPt.permCongrHom).toMonoidHom.comp
      ((alternatingGroup (Fin 9)).subtype.comp ψ.toMonoidHom)
  have hφ₀inj : Function.Injective φ₀ := a9_permCongr_comp_injective ψ
  have hφ₀range : φ₀.range = alternatingGroup Pt := a9_permCongr_comp_range ψ
  have hEel : IsElemAbelian 3 (E.map φ₀) := CFSG.SectionRank.isElemAbelian_map hE φ₀
  have hEcard' : Nat.card (E.map φ₀) = 3 ^ 3 := by
    rw [Subgroup.card_map_of_injective hφ₀inj, hEcard]
    norm_num
  obtain ⟨σ, hσ⟩ := exists_conj_eq_baseGroup hEel hEcard'
  refine ⟨(MulAut.conj σ).toMonoidHom.comp φ₀, ?_, ?_, ?_⟩
  · exact (MulAut.conj σ).injective.comp hφ₀inj
  · rw [MonoidHom.range_comp, hφ₀range]
    haveI : (alternatingGroup Pt).Normal := alternatingGroup.normal
    exact Subgroup.Normal.map_conj_eq (alternatingGroup Pt) σ
  · rw [← Subgroup.map_map]
    exact hσ

private theorem a9_basic_facts (h : TwelveCtx G M p Q H)
    (hd : TwelveFiveData M H d L₁ L₂ L₃ n₁ n₂ n₃)
    (h6 : TwelveSix M H p d L₁ L₂ L₃ n₁ n₂ n₃)
    (h3 : CFSG.Open.pRank 3 M ≤ 3) (hcard : (weakBlockSet M H).ncard = 3) :
    p = 3 ∧ CFSG.ABGLocalTools.IsSylowOf 3 Q (kSub 3 M H ⊓ M) ∧
      thompsonSubgroup Q = a9A M H Q ∧
      IsElemAbelian 3 (a9A M H Q) ∧ Nat.card (a9A M H Q) = 27 ∧
      Nat.card (a9W M H Q L₁) = 3 := by
  obtain ⟨hp, -, -, hQsylM, hA7⟩ := twelveSevenData h hd h6 h3 hcard
  subst hp
  obtain ⟨e, hcommA, hcardA⟩ := hA7
  have hJeq : thompsonSubgroup Q = a9A M H Q :=
    thompsonSubgroup_eq_inf_of_wreath e hcommA hcardA
  have hP : CFSG.ABGLocalTools.IsSylowOf 3 Q (kSub 3 M H ⊓ M) :=
    isSylowOf_three_inf h hd h6 h3 hcard
  have hAel : IsElemAbelian 3 (a9A M H Q) :=
    a9_isElemAbelian_inf_jSub_of_wreath e hcommA hcardA
  have hAsyl : CFSG.ABGLocalTools.IsSylowOf 3 (a9A M H Q) (jSub M H) :=
    hQsylM.inf_of_le_normalizer (jSub_le M H) (TwelveFiveData.le_normalizer_jSub hd)
  have hn : n₁ = 1 ∧ n₂ = 1 ∧ n₃ = 1 :=
    ⟨TwelveSix.n₁_eq_one hd h6, TwelveSix.n₂_eq_one hd h6, TwelveSix.n₃_eq_one hd h6⟩
  have hAcard : Nat.card (a9A M H Q) = 27 :=
    (TwelveFiveData.card_eq_and_comm_of_isSylowOf_jSub hd hn h3 hcard hAsyl).1
  have hWcard : Nat.card (a9W M H Q L₁) = 3 := by
    change Nat.card (Q ⊓ jSub M H ⊓ L₁ : Subgroup G) = 3
    exact a9_card_thompson_inf_L₁ hd h6 hQsylM
  exact ⟨rfl, hP, hJeq, hAel, hAcard, hWcard⟩

private theorem a9_pgroup_facts {A W : Subgroup G}
    (hA : A ≤ a9K 3 M H) (hW : W ≤ a9K 3 M H)
    (hAcard : Nat.card A = 27) (hWcard : Nat.card W = 3) :
    (¬ 3 ∣ Nat.card (a9O 3 M H)) ∧
      IsPGroup 3 (A.subgroupOf (a9K 3 M H)) ∧
      IsPGroup 3 (W.subgroupOf (a9K 3 M H)) := by
  have hO2 : IsPGroup 2 (a9O 3 M H) := CFSG.pCore_isPGroup
  have hN : ¬ 3 ∣ Nat.card (a9O 3 M H) := by
    obtain ⟨k, hk⟩ := hO2.exists_card_eq
    rw [hk]
    intro hdiv
    exact (by norm_num : (3 : ℕ) ≠ 2)
      ((Nat.prime_dvd_prime_iff_eq Nat.prime_three Nat.prime_two).mp
        (Nat.prime_three.dvd_of_dvd_pow hdiv))
  have hA3 : IsPGroup 3 (A.subgroupOf (a9K 3 M H)) := by
    refine IsPGroup.of_card (n := 3) ?_
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hA).toEquiv, hAcard]
    norm_num
  have hW3 : IsPGroup 3 (W.subgroupOf (a9K 3 M H)) := by
    refine IsPGroup.of_card (n := 1) ?_
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hW).toEquiv, hWcard]
    norm_num
  exact ⟨hN, hA3, hW3⟩

private theorem a9_elAbelian_facts {A : Subgroup G}
    (hA : A ≤ a9K 3 M H) (hAel : IsElemAbelian 3 A)
    (hN : ¬ 3 ∣ Nat.card (a9O 3 M H))
    (hA3 : IsPGroup 3 (A.subgroupOf (a9K 3 M H)))
    (hAcard : Nat.card A = 27) :
    IsElemAbelian 3 (A.subgroupOf (a9K 3 M H)) ∧
      IsElemAbelian 3 ((A.subgroupOf (a9K 3 M H)).map (a9π 3 M H)) ∧
      Nat.card ((A.subgroupOf (a9K 3 M H)).map (a9π 3 M H)) = 27 := by
  have hAel_sub : IsElemAbelian 3 (A.subgroupOf (a9K 3 M H)) := by
    refine ⟨⟨⟨fun a b => ?_⟩⟩, fun x hx => ?_⟩
    · have h := hAel.1.is_comm.comm
        ⟨(a : G), Subgroup.mem_subgroupOf.mp a.2⟩
        ⟨(b : G), Subgroup.mem_subgroupOf.mp b.2⟩
      refine Subtype.ext (Subtype.ext ?_)
      exact congrArg (fun z : ↥A => (z : G)) h
    · exact Subtype.ext (hAel.2 (x : G) (Subgroup.mem_subgroupOf.mp hx))
  have hEel : IsElemAbelian 3 ((A.subgroupOf (a9K 3 M H)).map (a9π 3 M H)) :=
    CFSG.SectionRank.isElemAbelian_map hAel_sub (a9π 3 M H)
  have hEcard : Nat.card ((A.subgroupOf (a9K 3 M H)).map (a9π 3 M H)) = 27 :=
    a9_card_map_mk'_eq hA hAcard hN hA3
  exact ⟨hAel_sub, hEel, hEcard⟩

private theorem a9_V1_le {A W : Subgroup G} {φ : a9Kbar M H →* Perm Pt}
    (hWA : W ≤ A)
    (hAbar : ((A.subgroupOf (a9K 3 M H)).map (a9π 3 M H)).map φ = baseGroup) :
    ((W.subgroupOf (a9K 3 M H)).map (a9π 3 M H)).map φ ≤ baseGroup := by
  have h1 : (W.subgroupOf (a9K 3 M H)).map (a9π 3 M H) ≤
      (A.subgroupOf (a9K 3 M H)).map (a9π 3 M H) :=
    Subgroup.map_mono (Subgroup.subgroupOf_mono (a9K 3 M H) hWA)
  calc ((W.subgroupOf (a9K 3 M H)).map (a9π 3 M H)).map φ
      ≤ ((A.subgroupOf (a9K 3 M H)).map (a9π 3 M H)).map φ := Subgroup.map_mono h1
    _ = baseGroup := hAbar

private theorem a9_V1_card {W : Subgroup G} {φ : a9Kbar M H →* Perm Pt}
    (hφinj : Function.Injective φ) (hW : W ≤ a9K 3 M H)
    (hWcard : Nat.card W = 3) (hN : ¬ 3 ∣ Nat.card (a9O 3 M H))
    (hW3 : IsPGroup 3 (W.subgroupOf (a9K 3 M H))) :
    Nat.card (((W.subgroupOf (a9K 3 M H)).map (a9π 3 M H)).map φ) = 3 := by
  have h1 : Nat.card ((W.subgroupOf (a9K 3 M H)).map (a9π 3 M H)) = 3 :=
    a9_card_map_mk'_eq hW hWcard hN hW3
  rw [Subgroup.card_map_of_injective hφinj, h1]

private theorem a9_special_mem {t : Perm Pt}
    (ht : t ∈ ({signAt 0, signAt 1, blockShift} : Set (Perm Pt))) :
    t ∈ alternatingGroup Pt ∧ t ∈ nrm := by
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ht
  rcases ht with rfl | rfl | rfl
  · exact ⟨signAt_mem_alternatingGroup 0, signAt_mem_nrm 0⟩
  · exact ⟨signAt_mem_alternatingGroup 1, signAt_mem_nrm 1⟩
  · exact ⟨blockShift_mem_alternatingGroup, blockShift_mem_nrm⟩

private theorem a9_mem_normalizer_of_mem_nrm {A : Subgroup G} {φ : a9Kbar M H →* Perm Pt}
    (hφinj : Function.Injective φ) (hφrange : φ.range = alternatingGroup Pt)
    (hAbar : ((A.subgroupOf (a9K 3 M H)).map (a9π 3 M H)).map φ = baseGroup)
    {ybar : a9Kbar M H} {t : Perm Pt} (hyt : φ ybar = t) (htN : t ∈ nrm) :
    ybar ∈ Subgroup.normalizer
      (((A.subgroupOf (a9K 3 M H)).map (a9π 3 M H)) : Set (a9Kbar M H)) := by
  let Abar : Subgroup (a9Kbar M H) := (A.subgroupOf (a9K 3 M H)).map (a9π 3 M H)
  have hAbar' : Abar.map φ = baseGroup := hAbar
  have hle : baseGroup ≤ φ.range := by
    rw [hφrange]
    exact baseGroup_le_alternatingGroup
  have hcomap : baseGroup.comap φ = Abar := by
    ext x
    rw [Subgroup.mem_comap, ← Subgroup.mem_map_iff_mem hφinj, hAbar']
  have h := Subgroup.comap_normalizer_eq_of_le_range (H := baseGroup) (f := φ) hle
  rw [hcomap] at h
  rw [← h, Subgroup.mem_comap, hyt]
  exact htN

private theorem a9_map_conj_mem_Vs {φ : a9Kbar M H →* Perm Pt}
    {ybar : a9Kbar M H} {t : Perm Pt} (hyt : φ ybar = t)
    {W' : Subgroup G} {V : Subgroup (Perm Pt)}
    (hV : V = ((W'.subgroupOf (a9K 3 M H)).map (a9π 3 M H)).map φ)
    {V₁ V₂ V₃ : Subgroup (Perm Pt)}
    (hV₁ : V₁ = (a9Wbar M H Q L₁).map φ)
    (hV₂ : V₂ = (a9Wbar M H Q L₂).map φ)
    (hV₃ : V₃ = (a9Wbar M H Q L₃).map φ)
    (hset : ((W'.subgroupOf (a9K 3 M H)).map (a9π 3 M H)).map
        (MulAut.conj ybar).toMonoidHom ∈
      ({a9Wbar M H Q L₁, a9Wbar M H Q L₂, a9Wbar M H Q L₃} :
        Set (Subgroup (a9Kbar M H)))) :
    V.map (MulAut.conj t).toMonoidHom ∈
      ({V₁, V₂, V₃} : Set (Subgroup (Perm Pt))) := by
  have hcomp : (MulAut.conj t).toMonoidHom.comp φ =
      φ.comp (MulAut.conj ybar).toMonoidHom := by
    refine MonoidHom.ext fun x => ?_
    change (MulAut.conj t) (φ x) = φ ((MulAut.conj ybar) x)
    rw [MulAut.conj_apply, MulAut.conj_apply, map_mul, map_mul, map_inv, hyt]
  have hmap : (((W'.subgroupOf (a9K 3 M H)).map (a9π 3 M H)).map φ).map
        (MulAut.conj t).toMonoidHom =
      (((W'.subgroupOf (a9K 3 M H)).map (a9π 3 M H)).map
        (MulAut.conj ybar).toMonoidHom).map φ := by
    have h1 := Subgroup.map_map (((W'.subgroupOf (a9K 3 M H)).map (a9π 3 M H)))
      (MulAut.conj t).toMonoidHom φ
    have h2 := (Subgroup.map_map (((W'.subgroupOf (a9K 3 M H)).map (a9π 3 M H))) φ
      (MulAut.conj ybar).toMonoidHom).symm
    rw [h1, hcomp, h2]
  rw [hV, hmap]
  rcases hset with h | h | h
  · rw [h, ← hV₁]; exact Or.inl rfl
  · rw [h, ← hV₂]; exact Or.inr (Or.inl rfl)
  · rw [h, ← hV₃]; exact Or.inr (Or.inr rfl)

private theorem a9_blocks_invariant
    (hd : TwelveFiveData M H d L₁ L₂ L₃ n₁ n₂ n₃)
    (h6 : TwelveSix M H 3 d L₁ L₂ L₃ n₁ n₂ n₃)
    (hAK : a9A M H Q ≤ a9K 3 M H)
    (hN : ¬ 3 ∣ Nat.card (a9O 3 M H))
    (hA3 : IsPGroup 3 ((a9A M H Q).subgroupOf (a9K 3 M H)))
    (hJ : thompsonSubgroup Q = a9A M H Q)
    (hP : CFSG.ABGLocalTools.IsSylowOf 3 Q (kSub 3 M H ⊓ M))
    {φ : a9Kbar M H →* Perm Pt}
    (hφinj : Function.Injective φ) (hφrange : φ.range = alternatingGroup Pt)
    (hφbase : (a9Abar M H Q).map φ = baseGroup)
    (V₁ V₂ V₃ : Subgroup (Perm Pt))
    (hV₁ : V₁ = (a9Wbar M H Q L₁).map φ)
    (hV₂ : V₂ = (a9Wbar M H Q L₂).map φ)
    (hV₃ : V₃ = (a9Wbar M H Q L₃).map φ) :
    ∀ t ∈ ({signAt 0, signAt 1, blockShift} : Set (Perm Pt)),
      ∀ V ∈ ({V₁, V₂, V₃} : Set (Subgroup (Perm Pt))),
        V.map (MulAut.conj t).toMonoidHom ∈
          ({V₁, V₂, V₃} : Set (Subgroup (Perm Pt))) := by
  intro t ht V hV
  obtain ⟨htA, htN⟩ := a9_special_mem ht
  obtain ⟨ybar, hyt⟩ := MonoidHom.mem_range.mp (by rw [hφrange]; exact htA)
  have hybarN := a9_mem_normalizer_of_mem_nrm hφinj hφrange hφbase hyt htN
  have hset1 := a9_map_conj_mem_blockImages (K := a9K 3 M H) (A := a9A M H Q)
    (O := a9O 3 M H) hd h6 rfl hAK hN hA3 hJ hP
    (rfl : a9W M H Q L₁ = a9A M H Q ⊓ L₁) (by simp) hybarN
  have hset2 := a9_map_conj_mem_blockImages (K := a9K 3 M H) (A := a9A M H Q)
    (O := a9O 3 M H) hd h6 rfl hAK hN hA3 hJ hP
    (rfl : a9W M H Q L₂ = a9A M H Q ⊓ L₂) (by simp) hybarN
  have hset3 := a9_map_conj_mem_blockImages (K := a9K 3 M H) (A := a9A M H Q)
    (O := a9O 3 M H) hd h6 rfl hAK hN hA3 hJ hP
    (rfl : a9W M H Q L₃ = a9A M H Q ⊓ L₃) (by simp) hybarN
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hV
  rcases hV with rfl | rfl | rfl
  · exact a9_map_conj_mem_Vs hyt hV₁ hV₁ hV₂ hV₃ hset1
  · exact a9_map_conj_mem_Vs hyt hV₂ hV₁ hV₂ hV₃ hset2
  · exact a9_map_conj_mem_Vs hyt hV₃ hV₁ hV₂ hV₃ hset3

private theorem a9_preimage_centralizer {φ : a9Kbar M H →* Perm Pt}
    (hφinj : Function.Injective φ) {k : ZMod 3}
    (hk : (a9Wbar M H Q L₁).map φ = Subgroup.zpowers (shiftPerm (Pi.single k 1)))
    {g : Perm Pt} (hgcomm : Commute g (shiftPerm (Pi.single k 1)))
    {gbar : a9Kbar M H} (hgbar : φ gbar = g) :
    gbar ∈ Subgroup.centralizer (a9Wbar M H Q L₁ : Set (a9Kbar M H)) := by
  rw [Subgroup.mem_centralizer_iff]
  intro w hw
  apply hφinj
  rw [map_mul, map_mul, hgbar]
  have hwV : φ w ∈ (a9Wbar M H Q L₁).map φ := Subgroup.mem_map_of_mem φ hw
  rw [hk] at hwV
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hwV
  rw [← hm]
  exact (hgcomm.zpow_right m).eq.symm

private theorem a9_map_normalizes_base {A : Subgroup G} {φ : a9Kbar M H →* Perm Pt}
    (hφbase : ((A.subgroupOf (a9K 3 M H)).map (a9π 3 M H)).map φ = baseGroup)
    {gbar : a9Kbar M H}
    (hgbarnorm : gbar ∈ Subgroup.normalizer
      (((A.subgroupOf (a9K 3 M H)).map (a9π 3 M H)) : Set (a9Kbar M H))) :
    φ gbar ∈ nrm := by
  have h := Subgroup.le_normalizer_map
    (H := (A.subgroupOf (a9K 3 M H)).map (a9π 3 M H)) φ
  rw [hφbase] at h
  exact h (Subgroup.mem_map_of_mem φ hgbarnorm)

private theorem a9_final_contradiction {φ : a9Kbar M H →* Perm Pt}
    (hφinj : Function.Injective φ) (hφrange : φ.range = alternatingGroup Pt)
    (hφbase : (a9Abar M H Q).map φ = baseGroup)
    (hCbar : Subgroup.centralizer (a9Wbar M H Q L₁ : Set (a9Kbar M H)) ≤
      Subgroup.normalizer (a9Abar M H Q : Set (a9Kbar M H)))
    {k : ZMod 3}
    (hk : (a9Wbar M H Q L₁).map φ = Subgroup.zpowers (shiftPerm (Pi.single k 1)))
    {g : Perm Pt} (hgA9 : g ∈ alternatingGroup Pt)
    (hgcomm : Commute g (shiftPerm (Pi.single k 1))) (hgnrm : g ∉ nrm) :
    False := by
  have hg_range : g ∈ φ.range := by rw [hφrange]; exact hgA9
  obtain ⟨gbar, hgbar⟩ := MonoidHom.mem_range.mp hg_range
  have hgbarcent := a9_preimage_centralizer hφinj hk hgcomm hgbar
  have hgbarnorm := hCbar hgbarcent
  have hfinal : g ∈ nrm := by
    rw [← hgbar]
    exact a9_map_normalizes_base hφbase hgbarnorm
  exact hgnrm hfinal

theorem a9ThreeCycleStep_of_twelveSix (h : TwelveCtx G M p Q H)
    (hd : TwelveFiveData M H d L₁ L₂ L₃ n₁ n₂ n₃) (h6 : TwelveSix M H p d L₁ L₂ L₃ n₁ n₂ n₃)
    (h3 : CFSG.Open.pRank 3 M ≤ 3) (hcard : (weakBlockSet M H).ncard = 3) :
    A9ThreeCycleStep M H L₁ L₂ L₃ p := by
  unfold A9ThreeCycleStep
  intro hA9
  obtain ⟨hp, hP, hJeq, hAel, hAcard, hWcard⟩ := a9_basic_facts h hd h6 h3 hcard
  subst hp
  have hQK : Q ≤ a9K 3 M H := hP.le.trans inf_le_left
  have hAK : a9A M H Q ≤ a9K 3 M H := fun x hx => hQK hx.1
  have hWK : a9W M H Q L₁ ≤ a9K 3 M H := fun x hx => hAK hx.1
  obtain ⟨hN, hA3, hW3⟩ := a9_pgroup_facts hAK hWK hAcard hWcard
  obtain ⟨-, hEel, hEcard⟩ := a9_elAbelian_facts hAK hAel hN hA3 hAcard
  obtain ⟨ψ⟩ := hA9
  obtain ⟨φ, hφinj, hφrange, hφbase⟩ :=
    a9_exists_conj_embedding_baseGroup ψ hEel hEcard
  let V₁ : Subgroup (Perm Pt) := (a9Wbar M H Q L₁).map φ
  let V₂ : Subgroup (Perm Pt) := (a9Wbar M H Q L₂).map φ
  let V₃ : Subgroup (Perm Pt) := (a9Wbar M H Q L₃).map φ
  have hV1le : V₁ ≤ baseGroup := by
    change (a9Wbar M H Q L₁).map φ ≤ baseGroup
    exact a9_V1_le inf_le_left hφbase
  have hV1card : Nat.card V₁ = 3 := by
    change Nat.card ((a9Wbar M H Q L₁).map φ) = 3
    exact a9_V1_card hφinj hWK hWcard hN hW3
  have hinv := a9_blocks_invariant hd h6 hAK hN hA3 hJeq hP
    hφinj hφrange hφbase V₁ V₂ V₃ rfl rfl rfl
  obtain ⟨k, hk⟩ := eq_zpowers_single_of_invariant hV1le hV1card hinv
  obtain ⟨g, hgA9, hgcomm, hgnrm⟩ := exists_commute_not_mem_nrm k
  refine ⟨Q, a9W M H Q L₁, hP, hWK, Or.inl inf_le_right, hWcard, ?_⟩
  intro hc
  rw [hJeq] at hc
  have hCbar := a9_centralizer_map_le_normalizer_map (CFSG.openPCoreOf_subgroupOf 2 (a9K 3 M H))
    hWK hAK hWcard hN hA3 hc
  exact a9_final_contradiction hφinj hφrange hφbase hCbar hk hgA9 hgcomm hgnrm

theorem twelveEight_of_twelveSix (h : TwelveCtx G M p Q H)
    (hd : TwelveFiveData M H d L₁ L₂ L₃ n₁ n₂ n₃) (h6 : TwelveSix M H p d L₁ L₂ L₃ n₁ n₂ n₃)
    (h3 : CFSG.Open.pRank 3 M ≤ 3) (hcard : (weakBlockSet M H).ncard = 3) :
    CFSG.Blueprint.LieModel (modTwoCore (kSub p M H)) .PSp 2 3 1 :=
  (TwelveSix.part_five hd h6).resolve_right
    (not_nonempty_modTwoCore_equiv_alternatingGroup_nine hd h6
      (a9ThreeCycleStep_of_twelveSix h hd h6 h3 hcard))

