variable {X : Type} [Group X] [Finite X]

theorem exists_mem_sSup_forall {𝓑 : Set (Subgroup X)}
    (hcomm : ∀ A ∈ 𝓑, ∀ B ∈ 𝓑, A ≠ B → A ≤ Subgroup.centralizer (B : Set X))
    (P : Subgroup X → X → Prop)
    (hP : ∀ B ∈ 𝓑, ∀ z : X, P B z → ∀ c ∈ Subgroup.centralizer (B : Set X), P B (z * c))
    {x : X} (hstep : ∀ B ∈ 𝓑, ∃ l ∈ B, P B (x * l)) :
    ∃ j ∈ sSup 𝓑, ∀ B ∈ 𝓑, P B (x * j) := by
  classical
  have hfin : Finite (Subgroup X) :=
    Finite.of_injective (fun H : Subgroup X => (H : Set X)) SetLike.coe_injective
  have key : ∀ s : Set (Subgroup X), s ⊆ 𝓑 →
      ∃ j ∈ sSup s, ∀ B ∈ s, P B (x * j) := by
    intro s
    refine Set.Finite.induction_on (motive := fun s _ => s ⊆ 𝓑 →
      ∃ j ∈ sSup s, ∀ B ∈ s, P B (x * j)) s
      (@Set.toFinite (Subgroup X) s (@Subtype.finite (Subgroup X) hfin
        (fun x => x ∈ s))) ?_ ?_
    · intro _
      exact ⟨1, by simp, by simp⟩
    · intro a t ha ht ih hsub
      have hat : a ∈ 𝓑 := hsub (Set.mem_insert a t)
      have htsub : t ⊆ 𝓑 := fun b hb => hsub (Set.mem_insert_of_mem a hb)
      obtain ⟨l, hl, hPl⟩ := hstep a hat
      obtain ⟨j, hj, hPj⟩ := ih htsub
      have htCa : sSup t ≤ Subgroup.centralizer (a : Set X) :=
        sSup_le fun b hb => hcomm b (htsub hb) a hat (fun hba => ha (hba ▸ hb))
      have hjC : j ∈ Subgroup.centralizer (a : Set X) := htCa hj
      have hlj : l * j = j * l := Subgroup.mem_centralizer_iff.mp hjC l hl
      refine ⟨l * j, ?_, ?_⟩
      · rw [sSup_insert]
        exact mul_mem (Subgroup.mem_sup_left hl) (Subgroup.mem_sup_right hj)
      · intro B hB
        rcases Set.mem_insert_iff.mp hB with hBa | hB
        · rw [hBa]
          simpa only [mul_assoc] using hP a hat (x * l) hPl j hjC
        · have haCB : a ≤ Subgroup.centralizer (B : Set X) :=
            hcomm a hat B (htsub hB) (fun hab => ha (hab ▸ hB))
          have hlCB : l ∈ Subgroup.centralizer (B : Set X) := haCB hl
          simpa only [mul_assoc, hlj] using hP B (htsub hB) (x * j) (hPj B hB) l hlCB
  exact key 𝓑 (fun _ hb => hb)

omit [Finite X] in
private lemma exists_mem_iSup_inv_mul_mem_iInf_centralizer_insert {a : Subgroup X}
    {t : Set (Subgroup X)}
    (hcomm : ∀ A ∈ insert a t, ∀ B ∈ insert a t, A ≠ B →
      A ≤ Subgroup.centralizer (B : Set X))
    (P : Subgroup X → Subgroup X) (hP : ∀ B ∈ insert a t, P B ≤ B) {x : X}
    (hxa : x ∈ P a ⊔ Subgroup.centralizer (a : Set X))
    (hq : ∃ q ∈ ⨆ B ∈ t, P B,
      q⁻¹ * x ∈ ⨅ B ∈ t, Subgroup.centralizer (B : Set X)) :
    ∃ q ∈ ⨆ B ∈ insert a t, P B,
      q⁻¹ * x ∈ ⨅ B ∈ insert a t, Subgroup.centralizer (B : Set X) := by
  obtain ⟨q, hq, hqz⟩ := hq
  by_cases ha : a ∈ t
  · rw [Set.insert_eq_of_mem ha]
    exact ⟨q, hq, hqz⟩
  have hCP : Subgroup.centralizer (a : Set X) ≤
      Subgroup.normalizer ((P a : Subgroup X) : Set X) :=
    (Subgroup.centralizer_le (SetLike.coe_subset_coe.mpr (hP a (Set.mem_insert a t)))).trans
      (Subgroup.centralizer_le_normalizer _)
  obtain ⟨p, hp, c, hc, hpc⟩ := Set.mem_image2.mp (by
    have h : x ∈ ((P a ⊔ Subgroup.centralizer (a : Set X) : Subgroup X) : Set X) := hxa
    rw [Subgroup.coe_mul_of_right_le_normalizer_left (P a)
      (Subgroup.centralizer (a : Set X)) hCP] at h
    exact h)
  have hpc' : p⁻¹ * x = c := by rw [← hpc]; simp
  have hqa : q ∈ Subgroup.centralizer (a : Set X) :=
    (iSup₂_le fun B hB => (hP B (Set.mem_insert_of_mem a hB)).trans
      (hcomm B (Set.mem_insert_of_mem a hB) a (Set.mem_insert a t)
        (fun hba => ha (hba ▸ hB)))) hq
  have hpq : p * q = q * p :=
    Subgroup.mem_centralizer_iff.mp hqa p (hP a (Set.mem_insert a t) hp)
  have hinv : p⁻¹ * q⁻¹ = q⁻¹ * p⁻¹ := by
    rw [← mul_inv_rev, ← mul_inv_rev, hpq]
  refine ⟨q * p, ?_, ?_⟩
  · rw [iSup_insert]
    exact mul_mem (Subgroup.mem_sup_right hq) (Subgroup.mem_sup_left hp)
  · rw [iInf_insert, Subgroup.mem_inf]
    refine ⟨?_, ?_⟩
    · have hza : q⁻¹ * c ∈ Subgroup.centralizer (a : Set X) :=
        mul_mem ((Subgroup.centralizer (a : Set X)).inv_mem hqa) hc
      simpa only [mul_inv_rev, hinv, mul_assoc, hpc'] using hza
    · rw [Subgroup.mem_iInf]
      intro B
      rw [Subgroup.mem_iInf]
      intro hB
      have hpCB : p ∈ Subgroup.centralizer (B : Set X) :=
        (hcomm a (Set.mem_insert a t) B (Set.mem_insert_of_mem a hB)
          (fun hab => ha (hab ▸ hB))) (hP a (Set.mem_insert a t) hp)
      have hzB : q⁻¹ * x ∈ Subgroup.centralizer (B : Set X) :=
        (Subgroup.mem_iInf.mp (Subgroup.mem_iInf.mp hqz B)) hB
      simpa only [mul_inv_rev, mul_assoc] using
        mul_mem ((Subgroup.centralizer (B : Set X)).inv_mem hpCB) hzB

theorem mem_iSup_sup_centralizer_sSup {𝓑 : Set (Subgroup X)}
    (hcomm : ∀ A ∈ 𝓑, ∀ B ∈ 𝓑, A ≠ B → A ≤ Subgroup.centralizer (B : Set X))
    (P : Subgroup X → Subgroup X) (hP : ∀ B ∈ 𝓑, P B ≤ B) {x : X}
    (hx : ∀ B ∈ 𝓑, x ∈ P B ⊔ Subgroup.centralizer (B : Set X)) :
    x ∈ (⨆ B ∈ 𝓑, P B) ⊔ Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X) := by
  classical
  have hfin : Finite (Subgroup X) :=
    Finite.of_injective (fun H : Subgroup X => (H : Set X)) SetLike.coe_injective
  have key : ∀ s : Set (Subgroup X), s ⊆ 𝓑 →
      ∃ q ∈ ⨆ B ∈ s, P B, q⁻¹ * x ∈ ⨅ B ∈ s, Subgroup.centralizer (B : Set X) := by
    intro s
    refine Set.Finite.induction_on (motive := fun s _ => s ⊆ 𝓑 →
      ∃ q ∈ ⨆ B ∈ s, P B, q⁻¹ * x ∈ ⨅ B ∈ s, Subgroup.centralizer (B : Set X)) s
      (@Set.toFinite (Subgroup X) s (@Subtype.finite (Subgroup X) hfin
        (fun x => x ∈ s))) ?_ ?_
    · intro _
      exact ⟨1, by simp, by simp⟩
    · intro a t ha ht ih hsub
      exact exists_mem_iSup_inv_mul_mem_iInf_centralizer_insert
        (fun A hA B hB hne => hcomm A (hsub hA) B (hsub hB) hne)
        P (fun B hB => hP B (hsub hB)) (hx a (hsub (Set.mem_insert a t)))
        (ih (fun b hb => hsub (Set.mem_insert_of_mem a hb)))
  obtain ⟨q, hq, hqz⟩ := key 𝓑 (fun _ hb => hb)
  have hzC : q⁻¹ * x ∈ Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X) := by
    rw [sSup_eq_iSup', Subgroup.iSup_eq_closure, Subgroup.centralizer_closure]
    rw [Subgroup.mem_centralizer_iff]
    intro g hg
    simp only [Set.mem_iUnion] at hg
    obtain ⟨B, hgB⟩ := hg
    exact Subgroup.mem_centralizer_iff.mp
      ((Subgroup.mem_iInf.mp (Subgroup.mem_iInf.mp hqz B)) B.2) g hgB
  simpa only [mul_inv_cancel_left] using Subgroup.mul_mem_sup hq hzC

omit [Finite X] in
private lemma conj_mem_centralizer_of_mem_normalizer {B : Subgroup X} {t c : X}
    (ht : t ∈ Subgroup.normalizer (B : Set X))
    (hc : c ∈ Subgroup.centralizer (B : Set X)) :
    t * c * t⁻¹ ∈ Subgroup.centralizer (B : Set X) := by
  rw [Subgroup.mem_centralizer_iff] at hc ⊢
  intro b hb
  have hb' : t⁻¹ * b * t ∈ B := (Subgroup.mem_normalizer_iff''.mp ht b).mp hb
  calc b * (t * c * t⁻¹) = t * (t⁻¹ * b * t * c) * t⁻¹ := by group
    _ = t * (c * (t⁻¹ * b * t)) * t⁻¹ := by rw [hc (t⁻¹ * b * t) hb']
    _ = (t * c * t⁻¹) * b := by group

omit [Finite X] in
private lemma conj_mem_sup_centralizer_of_mem_centralizer {B S : Subgroup X}
    (hSB : S ≤ Subgroup.normalizer (B : Set X))
    {c : X} (hc : c ∈ Subgroup.centralizer (B : Set X)) {t : X} (ht : t ∈ S) :
    c * t * c⁻¹ ∈ S ⊔ Subgroup.centralizer (B : Set X) := by
  have hu : t⁻¹ * c * t * c⁻¹ ∈ Subgroup.centralizer (B : Set X) := by
    simpa only [inv_inv] using
      mul_mem (conj_mem_centralizer_of_mem_normalizer (inv_mem (hSB ht)) hc) (inv_mem hc)
  have h : c * t * c⁻¹ = t * (t⁻¹ * c * t * c⁻¹) := by group
  rw [h]
  exact Subgroup.mul_mem_sup ht hu

omit [Finite X] in
private lemma exists_mul_mem_centralizer_of_mem_sup {B : Subgroup X} {x : X}
    (hx : x ∈ B ⊔ Subgroup.centralizer (B : Set X)) :
    ∃ b ∈ B, ∃ c ∈ Subgroup.centralizer (B : Set X), b * c = x := by
  have hx' : x ∈ (↑(B ⊔ Subgroup.centralizer (B : Set X)) : Set X) := hx
  rw [Subgroup.coe_mul_of_right_le_normalizer_left B (Subgroup.centralizer (B : Set X))
    (Subgroup.centralizer_le_normalizer (B : Set X)), Set.mem_mul] at hx'
  exact hx'

omit [Finite X] in
private lemma conj_mem_inf_normalizer_sup_centralizer_of_mem_centralizer {B S : Subgroup X}
    (hSB : S ≤ Subgroup.normalizer (B : Set X))
    (hinner : ∀ l ∈ B,
      (∀ s ∈ S, l * s * l⁻¹ ∈ S ⊔ Subgroup.centralizer (B : Set X)) →
        l ∈ Subgroup.normalizer (S : Set X))
    {y : X} (hyC : y ∈ Subgroup.centralizer (B : Set X))
    {s s' : X} (hs : s ∈ S) (hs' : s' ∈ S)
    (hB : y * s * y⁻¹ * s'⁻¹ ∈ B ⊔ Subgroup.centralizer (B : Set X)) :
    y * s * y⁻¹ * s'⁻¹ ∈ (B ⊓ Subgroup.normalizer (S : Set X)) ⊔
      Subgroup.centralizer (B : Set X) := by
  have hNC : Subgroup.normalizer (B : Set X) ≤
      Subgroup.normalizer (Subgroup.centralizer (B : Set X) : Set X) :=
    Subgroup.le_normalizer_of_normal_subgroupOf (Subgroup.centralizer_le_normalizer (B : Set X))
  obtain ⟨b, hb, c₂, hc₂, hw⟩ := exists_mul_mem_centralizer_of_mem_sup hB
  set u : X := y * s * y⁻¹ * s⁻¹ with hu
  have huC : u ∈ Subgroup.centralizer (B : Set X) := by
    have h1 : s * y⁻¹ * s⁻¹ ∈ Subgroup.centralizer (B : Set X) :=
      conj_mem_centralizer_of_mem_normalizer (hSB hs) (inv_mem hyC)
    have h2 : y * s * y⁻¹ * s⁻¹ ∈ Subgroup.centralizer (B : Set X) := by
      simpa only [mul_assoc] using mul_mem hyC h1
    rwa [← hu] at h2
  have hw' : b * c₂ = u * (s * s'⁻¹) := by rw [hw, hu]; group
  have hu₃ : u⁻¹ * c₂ ∈ Subgroup.centralizer (B : Set X) :=
    mul_mem (inv_mem huC) hc₂
  have hcomm : u⁻¹ * b = b * u⁻¹ :=
    (Subgroup.mem_centralizer_iff.mp (inv_mem huC) b hb).symm
  have hσ : s * s'⁻¹ ∈ S := mul_mem hs (inv_mem hs')
  have hσeq : s * s'⁻¹ = b * (u⁻¹ * c₂) := by
    calc s * s'⁻¹ = u⁻¹ * (u * (s * s'⁻¹)) := by group
      _ = u⁻¹ * (b * c₂) := by rw [← hw']
      _ = (u⁻¹ * b) * c₂ := by rw [mul_assoc]
      _ = (b * u⁻¹) * c₂ := by rw [hcomm]
      _ = b * (u⁻¹ * c₂) := by rw [mul_assoc]
  have hbP : b ∈ B ⊓ Subgroup.normalizer (S : Set X) := by
    refine ⟨hb, hinner b hb ?_⟩
    intro t ht
    have hx : (u⁻¹ * c₂)⁻¹ * t * (u⁻¹ * c₂) ∈ S ⊔
        Subgroup.centralizer (B : Set X) := by
      simpa only [inv_inv] using
        conj_mem_sup_centralizer_of_mem_centralizer hSB (inv_mem hu₃) ht
    have hσN : s * s'⁻¹ ∈ Subgroup.normalizer (S : Set X) ⊓
        Subgroup.normalizer (Subgroup.centralizer (B : Set X) : Set X) :=
      ⟨Subgroup.le_normalizer (H := S) hσ, hNC (hSB hσ)⟩
    have hconj := Subgroup.conj_mem_sup_of_mem_inf_normalizer_of_mem_inf hσN
      ((u⁻¹ * c₂)⁻¹ * t * (u⁻¹ * c₂)) hx
    have hb_eq : b = (s * s'⁻¹) * (u⁻¹ * c₂)⁻¹ := by rw [hσeq]; group
    have hgoal : b * t * b⁻¹ =
        (s * s'⁻¹) * ((u⁻¹ * c₂)⁻¹ * t * (u⁻¹ * c₂)) * (s * s'⁻¹)⁻¹ := by
      rw [hb_eq]; group
    rw [hgoal]
    exact hconj
  rw [← hw]
  exact Subgroup.mul_mem_sup hbP hc₂

omit [Finite X] in
private lemma conj_mem_inf_normalizer_sup_centralizer_of_mem_normalizer_inf {B S : Subgroup X}
    (hSB : S ≤ Subgroup.normalizer (B : Set X))
    {y : X} (hyP : y ∈ Subgroup.normalizer
      ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) : Set X))
    (hyInner : ∀ l ∈ B, l ∈ Subgroup.normalizer
      ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) : Set X) →
      l ∈ Subgroup.normalizer (S : Set X))
    {s s' : X} (hs : s ∈ S) (hs' : s' ∈ S)
    (hB : y * s * y⁻¹ * s'⁻¹ ∈ B ⊔ Subgroup.centralizer (B : Set X)) :
    y * s * y⁻¹ * s'⁻¹ ∈ (B ⊓ Subgroup.normalizer (S : Set X)) ⊔
      Subgroup.centralizer (B : Set X) := by
  have hP : ∀ x ∈ S, x ∈ Subgroup.normalizer
      ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) : Set X) := fun x hx =>
    Subgroup.inf_normalizer_le_normalizer_inf (H := B)
      (K := Subgroup.normalizer (S : Set X))
      ⟨hSB hx, Subgroup.le_normalizer (H := Subgroup.normalizer (S : Set X))
        (Subgroup.le_normalizer (H := S) hx)⟩
  have hwP : y * s * y⁻¹ * s'⁻¹ ∈ Subgroup.normalizer
      ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) : Set X) :=
    mul_mem (mul_mem (mul_mem hyP (hP s hs))
      (inv_mem hyP)) (inv_mem (hP s' hs'))
  obtain ⟨b, hb, c₂, hc₂, hw⟩ := exists_mul_mem_centralizer_of_mem_sup hB
  have hc₂P : c₂ ∈ Subgroup.normalizer
      ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) : Set X) :=
    Subgroup.centralizer_le_normalizer
      ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) : Set X)
      (Subgroup.centralizer_le (SetLike.coe_subset_coe.mpr inf_le_left) hc₂)
  have hbP : b ∈ Subgroup.normalizer
      ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) : Set X) := by
    rw [show b = (y * s * y⁻¹ * s'⁻¹) * c₂⁻¹ by rw [← hw]; group]
    exact mul_mem hwP (inv_mem hc₂P)
  rw [← hw]
  exact Subgroup.mul_mem_sup ⟨hb, hyInner b hb hbP⟩ hc₂

omit [Finite X] in
theorem conj_mul_inv_mem_inf_normalizer_sup_centralizer {B S : Subgroup X}
    (hSB : S ≤ Subgroup.normalizer (B : Set X))
    (hinner : ∀ l ∈ B, (∀ s ∈ S, l * s * l⁻¹ ∈ S ⊔ Subgroup.centralizer (B : Set X)) →
      l ∈ Subgroup.normalizer (S : Set X))
    {y : X} (hy : y ∈ Subgroup.centralizer (B : Set X) ∨
