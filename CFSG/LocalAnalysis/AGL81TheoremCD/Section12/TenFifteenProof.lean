        ∀ l ∈ B, l ∈ Subgroup.normalizer ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) :
          Set X) → l ∈ Subgroup.normalizer (S : Set X)))
    {s s' : X} (hs : s ∈ S) (hs' : s' ∈ S)
    (hB : y * s * y⁻¹ * s'⁻¹ ∈ B ⊔ Subgroup.centralizer (B : Set X)) :
    y * s * y⁻¹ * s'⁻¹ ∈ (B ⊓ Subgroup.normalizer (S : Set X)) ⊔
      Subgroup.centralizer (B : Set X) := by
  rcases hy with hyC | ⟨hyP, hyInner⟩
  · exact conj_mem_inf_normalizer_sup_centralizer_of_mem_centralizer hSB hinner hyC hs hs' hB
  · exact conj_mem_inf_normalizer_sup_centralizer_of_mem_normalizer_inf hSB hyP hyInner
      hs hs' hB

