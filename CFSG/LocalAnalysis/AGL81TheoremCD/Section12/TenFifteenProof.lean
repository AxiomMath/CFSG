theorem mem_normalizer_of_mem_normalizer_of_pCoreOf_le {S Y : Subgroup X} (hS : IsPGroup 2 S)
    (hSY : S ≤ Y) (hYS : Y ≤ Subgroup.normalizer (S : Set X))
    (hNY : Subgroup.normalizer (S : Set X) ≤ Subgroup.normalizer (Y : Set X))
    (hO : pCoreOf 2 (Subgroup.normalizer (S : Set X)) ≤ S) {y : X}
    (hy : y ∈ Subgroup.normalizer (Y : Set X)) : y ∈ Subgroup.normalizer (S : Set X) := by
  have hSO : S ≤ pCoreOf 2 Y :=
    CFSG.RankThreeCoreUniqueness.Helpers.normal_pGroup_le_pCoreOf 2 S Y hSY
      ((Subgroup.normal_subgroupOf_iff_le_normalizer hSY).mpr hYS) hS
  have hOS : pCoreOf 2 Y ≤ S :=
    (CFSG.GroupTheory.pCoreOf_le_pCoreOf_of_le_normalizer 2 hYS hNY).trans hO
  rw [← le_antisymm hOS hSO]
  exact CFSG.RankThreeCoreUniqueness.Helpers.normalizer_localGroup_le_normalizer_pCoreOf 2 Y hy

theorem exists_mem_sSup_mul_mem_normalizer {𝓑 : Set (Subgroup X)}
    (hcomm : ∀ A ∈ 𝓑, ∀ B ∈ 𝓑, A ≠ B → A ≤ Subgroup.centralizer (B : Set X))
    {S : Subgroup X} (hS : IsPGroup 2 S) (hSB : ∀ B ∈ 𝓑, S ≤ Subgroup.normalizer (B : Set X))
    (hW : Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X) ≤
      Subgroup.centralizer (S : Set X))
    (hinner : ∀ B ∈ 𝓑, ∀ l ∈ B,
      (∀ s ∈ S, l * s * l⁻¹ ∈ S ⊔ Subgroup.centralizer (B : Set X)) →
        l ∈ Subgroup.normalizer (S : Set X))
    (hperm : ∀ k ∈ Subgroup.normalizer (S : Set X), ∀ B ∈ 𝓑,
      B.map (MulAut.conj k).toMonoidHom ∈ 𝓑)
    (hO : pCoreOf 2 (Subgroup.normalizer (S : Set X)) ≤ S) {x : X}
    (hxN : x ∈ Subgroup.normalizer
      (((⨅ B ∈ 𝓑, (B ⊔ Subgroup.centralizer (B : Set X))) ⊔ S : Subgroup X) : Set X))
    (hxB : ∀ B ∈ 𝓑, x ∈ Subgroup.normalizer (B : Set X))
    (hstep : ∀ B ∈ 𝓑, ∃ l ∈ B,
      x * l ∈ Subgroup.centralizer (B : Set X) ∨
        (x * l ∈ Subgroup.normalizer
            ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) : Set X) ∧
          ∀ l' ∈ B, l' ∈ Subgroup.normalizer
            ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) : Set X) →
              l' ∈ Subgroup.normalizer (S : Set X))) :
    ∃ j ∈ sSup 𝓑, x * j ∈ Subgroup.normalizer (S : Set X) := by
  have hCP : ∀ B : Subgroup X, Subgroup.centralizer (B : Set X) ≤
      Subgroup.normalizer ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) : Set X) :=
    fun B => (Subgroup.centralizer_le (SetLike.coe_subset_coe.mpr inf_le_left)).trans
      (Subgroup.centralizer_le_normalizer _)
  obtain ⟨j, hj, hgood⟩ := exists_mem_sSup_forall hcomm
    (fun B z => z ∈ Subgroup.centralizer (B : Set X) ∨
      (z ∈ Subgroup.normalizer ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) : Set X) ∧
        ∀ l' ∈ B, l' ∈ Subgroup.normalizer ((B ⊓ Subgroup.normalizer (S : Set X) :
          Subgroup X) : Set X) → l' ∈ Subgroup.normalizer (S : Set X)))
    (fun B _ z hz c hc => hz.imp (fun hz => mul_mem hz hc)
      (fun hz => ⟨mul_mem hz.1 (hCP B hc), hz.2⟩)) hstep
  have hJA : sSup 𝓑 ≤ ⨅ B ∈ 𝓑, (B ⊔ Subgroup.centralizer (B : Set X)) :=
    sSup_le fun A hA => le_iInf₂ fun B hB => by
      by_cases hAB : A = B
      · subst hAB
        exact le_sup_left
      · exact (hcomm A hA B hB hAB).trans le_sup_right
  have hJN : ∀ B ∈ 𝓑, sSup 𝓑 ≤ Subgroup.normalizer (B : Set X) := fun B hB =>
    hJA.trans ((iInf₂_le B hB).trans
      (sup_le Subgroup.le_normalizer (Subgroup.centralizer_le_normalizer _)))
  have hyN : x * j ∈ Subgroup.normalizer
      (((⨅ B ∈ 𝓑, (B ⊔ Subgroup.centralizer (B : Set X))) ⊔ S : Subgroup X) : Set X) :=
    mul_mem hxN (Subgroup.le_normalizer (Subgroup.mem_sup_left (hJA hj)))
  have hyY := mem_normalizer_sup_iSup_of_conj_mem
    (fun B hB => mul_mem (hxB B hB) (hJN B hB hj))
    (fun B hB => (hgood B hB).elim (fun hc => hCP B hc) And.left)
    (fun s hs => conj_mem_sup_iSup_inf_normalizer hcomm hSB hinner hyN hgood hs)
  refine ⟨j, hj, mem_normalizer_of_mem_normalizer_of_pCoreOf_le hS
    (le_sup_left.trans le_sup_left) ?_ (normalizer_le_normalizer_sup_iSup hperm) hO hyY⟩
  exact sup_le (sup_le Subgroup.le_normalizer (hW.trans (Subgroup.centralizer_le_normalizer _)))
    (iSup₂_le fun B _ => inf_le_right)

