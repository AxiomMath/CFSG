private lemma le_normalizer_iInf_sup_centralizer {𝓑 : Set (Subgroup X)} {S : Subgroup X}
    (hSB : ∀ B ∈ 𝓑, S ≤ Subgroup.normalizer (B : Set X)) :
    S ≤ Subgroup.normalizer
      ((⨅ B ∈ 𝓑, (B ⊔ Subgroup.centralizer (B : Set X)) : Subgroup X) : Set X) := by
  have hNC : ∀ B ∈ 𝓑, Subgroup.normalizer (B : Set X) ≤
      Subgroup.normalizer (Subgroup.centralizer (B : Set X) : Set X) := fun B _ =>
    Subgroup.le_normalizer_of_normal_subgroupOf (Subgroup.centralizer_le_normalizer (B : Set X))
  have key : ∀ t ∈ S, ∀ h ∈ (⨅ B ∈ 𝓑,
      (B ⊔ Subgroup.centralizer (B : Set X)) : Subgroup X),
      t * h * t⁻¹ ∈ (⨅ B ∈ 𝓑, (B ⊔ Subgroup.centralizer (B : Set X)) : Subgroup X) := by
    intro t ht h hh
    simp only [Subgroup.mem_iInf] at hh ⊢
    exact fun B hB => Subgroup.conj_mem_sup_of_mem_inf_normalizer_of_mem_inf
      ⟨hSB B hB ht, hNC B hB (hSB B hB ht)⟩ h (hh B hB)
  intro t ht
  rw [Subgroup.mem_normalizer_iff]
  intro h
  constructor
  · exact key t ht h
  · intro hh
    have h' := key t⁻¹ (inv_mem ht) (t * h * t⁻¹) hh
    have hEq : t⁻¹ * (t * h * t⁻¹) * (t⁻¹)⁻¹ = h := by group
    rwa [hEq] at h'

theorem conj_mem_sup_iSup_inf_normalizer {𝓑 : Set (Subgroup X)}
    (hcomm : ∀ A ∈ 𝓑, ∀ B ∈ 𝓑, A ≠ B → A ≤ Subgroup.centralizer (B : Set X))
    {S : Subgroup X} (hSB : ∀ B ∈ 𝓑, S ≤ Subgroup.normalizer (B : Set X))
    (hinner : ∀ B ∈ 𝓑, ∀ l ∈ B,
      (∀ s ∈ S, l * s * l⁻¹ ∈ S ⊔ Subgroup.centralizer (B : Set X)) →
        l ∈ Subgroup.normalizer (S : Set X))
    {y : X} (hyN : y ∈ Subgroup.normalizer
      (((⨅ B ∈ 𝓑, (B ⊔ Subgroup.centralizer (B : Set X))) ⊔ S : Subgroup X) : Set X))
    (hy : ∀ B ∈ 𝓑, y ∈ Subgroup.centralizer (B : Set X) ∨
      (y ∈ Subgroup.normalizer ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) : Set X) ∧
        ∀ l ∈ B, l ∈ Subgroup.normalizer ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) :
          Set X) → l ∈ Subgroup.normalizer (S : Set X)))
    {s : X} (hs : s ∈ S) :
    y * s * y⁻¹ ∈ S ⊔ Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X) ⊔
      ⨆ B ∈ 𝓑, (B ⊓ Subgroup.normalizer (S : Set X)) := by
  have hSA : S ≤ Subgroup.normalizer
      ((⨅ B ∈ 𝓑, (B ⊔ Subgroup.centralizer (B : Set X)) : Subgroup X) : Set X) :=
    le_normalizer_iInf_sup_centralizer hSB
  have hyS : y * s * y⁻¹ ∈
      (↑((⨅ B ∈ 𝓑, (B ⊔ Subgroup.centralizer (B : Set X))) ⊔ S) : Set X) :=
    (Subgroup.mem_set_normalizer_iff.mp hyN s).mp (Subgroup.mem_sup_right hs)
  rw [Subgroup.coe_mul_of_right_le_normalizer_left
    (⨅ B ∈ 𝓑, (B ⊔ Subgroup.centralizer (B : Set X))) S hSA, Set.mem_mul] at hyS
  obtain ⟨a, ha, s₁, hs₁, haeq⟩ := hyS
  have ha' : a ∈ (⨅ B ∈ 𝓑, (B ⊔ Subgroup.centralizer (B : Set X)) : Subgroup X) := ha
  have hstep : ∀ B ∈ 𝓑, a ∈ (B ⊓ Subgroup.normalizer (S : Set X)) ⊔
      Subgroup.centralizer (B : Set X) := by
    intro B hB
    have haB : a ∈ B ⊔ Subgroup.centralizer (B : Set X) :=
      (Subgroup.mem_iInf.mp ((Subgroup.mem_iInf.mp ha') B)) hB
    have hw : y * s * y⁻¹ * s₁⁻¹ = a := by rw [← haeq]; group
    rw [← hw] at haB ⊢
    exact conj_mul_inv_mem_inf_normalizer_sup_centralizer (hSB B hB) (hinner B hB)
      (hy B hB) hs hs₁ haB
  have haY : a ∈ (⨆ B ∈ 𝓑, (B ⊓ Subgroup.normalizer (S : Set X))) ⊔
      Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X) :=
    mem_iSup_sup_centralizer_sSup hcomm (fun B => B ⊓ Subgroup.normalizer (S : Set X))
      (fun B _ => inf_le_left) hstep
  rw [show y * s * y⁻¹ = a * s₁ by rw [haeq]]
  have hle : ((⨆ B ∈ 𝓑, (B ⊓ Subgroup.normalizer (S : Set X))) ⊔
      Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X)) ⊔ S ≤
      S ⊔ Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X) ⊔
        ⨆ B ∈ 𝓑, (B ⊓ Subgroup.normalizer (S : Set X)) :=
    sup_le (sup_le le_sup_right (le_sup_right.trans le_sup_left))
      (le_sup_left.trans le_sup_left)
  exact hle (Subgroup.mul_mem_sup haY hs₁)

theorem mem_normalizer_sup_iSup_of_conj_mem {𝓑 : Set (Subgroup X)} {S : Subgroup X} {y : X}
    (hyB : ∀ B ∈ 𝓑, y ∈ Subgroup.normalizer (B : Set X))
    (hyP : ∀ B ∈ 𝓑,
      y ∈ Subgroup.normalizer ((B ⊓ Subgroup.normalizer (S : Set X) : Subgroup X) : Set X))
    (hyS : ∀ s ∈ S, y * s * y⁻¹ ∈ S ⊔ Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X) ⊔
      ⨆ B ∈ 𝓑, (B ⊓ Subgroup.normalizer (S : Set X))) :
    y ∈ Subgroup.normalizer ((S ⊔ Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X) ⊔
      ⨆ B ∈ 𝓑, (B ⊓ Subgroup.normalizer (S : Set X)) : Subgroup X) : Set X) := by
  set f : X →* X := (MulAut.conj y).toMonoidHom
  set C : Subgroup X := Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X)
  set P : Subgroup X := ⨆ B ∈ 𝓑, (B ⊓ Subgroup.normalizer (S : Set X))
  have hBmap : ∀ B ∈ 𝓑, B.map f = B := fun B hB =>
    Subgroup.mem_normalizer_iff_map_conj_eq.mp (hyB B hB)
  have hsSup : (sSup 𝓑).map f = sSup 𝓑 := by
    rw [sSup_eq_iSup, Subgroup.map_iSup]
    refine iSup_congr fun B => ?_
    rw [Subgroup.map_iSup]
    exact iSup_congr fun hB => hBmap B hB
  have himg : f '' ((sSup 𝓑 : Subgroup X) : Set X) =
      ((sSup 𝓑 : Subgroup X) : Set X) := by
    rw [← Subgroup.coe_map f (sSup 𝓑), hsSup]
  have hC : C.map f ≤ C := by
    refine (Subgroup.map_centralizer_le_centralizer_image _ _).trans ?_
    rw [himg]
  have hP : P.map f ≤ P := by
    rw [Subgroup.map_iSup]
    refine iSup_le fun B => ?_
    rw [Subgroup.map_iSup]
    refine iSup_le fun hB => ?_
    rw [show (B ⊓ Subgroup.normalizer (S : Set X)).map f =
        B ⊓ Subgroup.normalizer (S : Set X) from
      Subgroup.mem_normalizer_iff_map_conj_eq.mp (hyP B hB)]
    exact le_iSup₂_of_le B hB le_rfl
  have hY : (S ⊔ C ⊔ P).map f ≤ S ⊔ C ⊔ P := by
    rw [Subgroup.map_sup, Subgroup.map_sup]
    refine sup_le (sup_le ?_ ?_) ?_
    · rintro _ ⟨s, hs, rfl⟩
      exact hyS s hs
    · exact hC.trans (le_sup_right.trans le_sup_left)
    · exact hP.trans le_sup_right
  have hYeq : (S ⊔ C ⊔ P).map f = S ⊔ C ⊔ P :=
    Subgroup.eq_of_le_of_card_ge hY (by
      rw [Subgroup.card_map_of_injective (MulAut.conj y).injective])
  exact Subgroup.mem_normalizer_iff_map_conj_eq.mpr hYeq

omit [Finite X] in
private theorem conj_mem_centralizer_sSup {𝓑 : Set (Subgroup X)} {k c : X}
    (hperm : ∀ B ∈ 𝓑, B.map (MulAut.conj k⁻¹).toMonoidHom ∈ 𝓑)
    (hc : c ∈ Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X)) :
    k * c * k⁻¹ ∈ Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X) := by
  rw [Subgroup.mem_centralizer_iff] at hc ⊢
  intro b hb
  have hle : sSup 𝓑 ≤ Subgroup.centralizer ({(k * c * k⁻¹)} : Set X) := by
    refine sSup_le fun B hB => ?_
    intro b' hb'
    rw [Subgroup.mem_centralizer_singleton_iff]
    have hB' : B.map (MulAut.conj k⁻¹).toMonoidHom ∈ 𝓑 := hperm B hB
    have hb'' : k⁻¹ * b' * k ∈ B.map (MulAut.conj k⁻¹).toMonoidHom := by
      simpa [MulAut.conj_apply] using
        Subgroup.mem_map_of_mem (MulAut.conj k⁻¹).toMonoidHom hb'
    have hmem : k⁻¹ * b' * k ∈ sSup 𝓑 := le_sSup hB' hb''
    have hcomm := hc _ hmem
    calc b' * (k * c * k⁻¹) = k * ((k⁻¹ * b' * k) * c) * k⁻¹ := by group
      _ = k * (c * (k⁻¹ * b' * k)) * k⁻¹ := by rw [hcomm]
      _ = k * c * k⁻¹ * b' := by group
  exact Subgroup.mem_centralizer_singleton_iff.mp (hle hb)

theorem normalizer_le_normalizer_sup_iSup {𝓑 : Set (Subgroup X)} {S : Subgroup X}
    (hperm : ∀ k ∈ Subgroup.normalizer (S : Set X), ∀ B ∈ 𝓑,
      B.map (MulAut.conj k).toMonoidHom ∈ 𝓑) :
    Subgroup.normalizer (S : Set X) ≤ Subgroup.normalizer
      ((S ⊔ Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X) ⊔
        ⨆ B ∈ 𝓑, (B ⊓ Subgroup.normalizer (S : Set X)) : Subgroup X) : Set X) := by
  intro k hk
  set f : X →* X := (MulAut.conj k).toMonoidHom
  set C : Subgroup X := Subgroup.centralizer ((sSup 𝓑 : Subgroup X) : Set X)
  set P : Subgroup X := ⨆ B ∈ 𝓑, (B ⊓ Subgroup.normalizer (S : Set X))
  have hkinv : k⁻¹ ∈ Subgroup.normalizer (S : Set X) := inv_mem hk
  have hSfile : S.map f = S := Subgroup.mem_normalizer_iff_map_conj_eq.mp hk
  have hNfile : (Subgroup.normalizer (S : Set X)).map f =
      Subgroup.normalizer (S : Set X) := by
    rw [Subgroup.map_equiv_normalizer_eq S (MulAut.conj k), hSfile]
  have hP : P.map f ≤ P := by
    rw [Subgroup.map_iSup]
    refine iSup_le fun B => ?_
    rw [Subgroup.map_iSup]
    refine iSup_le fun hB => ?_
    rw [Subgroup.map_inf _ _ _ (MulAut.conj k).injective, hNfile]
    exact le_iSup₂_of_le (B.map f) (hperm k hk B hB) le_rfl
  have hC : C.map f ≤ C := by
    rintro _ ⟨c, hc, rfl⟩
    exact conj_mem_centralizer_sSup (fun B hB => hperm k⁻¹ hkinv B hB) hc
  have hY : (S ⊔ C ⊔ P).map f ≤ S ⊔ C ⊔ P := by
    rw [Subgroup.map_sup, Subgroup.map_sup]
    refine sup_le (sup_le ?_ ?_) ?_
    · rw [hSfile]
      exact le_sup_left.trans le_sup_left
    · exact hC.trans (le_sup_right.trans le_sup_left)
    · exact hP.trans le_sup_right
  have hYeq : (S ⊔ C ⊔ P).map f = S ⊔ C ⊔ P :=
    Subgroup.eq_of_le_of_card_ge hY (by
      rw [Subgroup.card_map_of_injective (MulAut.conj k).injective])
  exact Subgroup.mem_normalizer_iff_map_conj_eq.mpr hYeq

