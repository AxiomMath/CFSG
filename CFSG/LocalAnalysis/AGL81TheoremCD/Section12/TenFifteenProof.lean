theorem exists_isSylowOf_le_inf_sup_jSub_of_barM {M H : Subgroup G} (hQH : pCoreOf 2 M ≤ H)
    {d : ℕ} (hd : d.Prime) {D : Subgroup (↥M ⧸ CFSG.pCore 2 ↥M)} (hD : IsSylowOf d D ⊤)
    (hDle : D ≤ barM M H ⊔ barM M (jSub M H)) :
    ∃ D' : Subgroup G, IsSylowOf d D' M ∧ D' ≤ (H ⊓ M) ⊔ jSub M H := by
  have : Fact d.Prime := ⟨hd⟩
  set K : Subgroup G := (H ⊓ M) ⊔ jSub M H
  have hKle : K ≤ M := by
    rw [show K = (H ⊓ M) ⊔ jSub M H from rfl]
    exact sup_le inf_le_right (jSub_le M H)
  have hQK : pCoreOf 2 M ≤ K :=
    (le_inf hQH (Subgroup.map_subtype_le (CFSG.pCore 2 ↥M))).trans le_sup_left
  have hbarK : barM M K = barM M H ⊔ barM M (jSub M H) := by
    have hHM : barM M (H ⊓ M) = barM M H := by
      rw [barM, barM, Subgroup.inf_subgroupOf_right H M]
    rw [show K = (H ⊓ M) ⊔ jSub M H from rfl,
      barM_sup inf_le_right (jSub_le M H), hHM]
  have hDK : D ≤ barM M K := by
    rw [hbarK]
    exact hDle
  have hidx : ¬ d ∣ K.relIndex M := by
    have hDnot : ¬ d ∣ D.index := by
      have h := (isSylowOf_iff.mp hD).2.2
      rwa [Subgroup.relIndex_top_right] at h
    have hker : (QuotientGroup.mk' (CFSG.pCore 2 ↥M)).ker ≤ K.subgroupOf M := by
      rw [QuotientGroup.ker_mk']
      intro x hx
      exact Subgroup.mem_subgroupOf.mpr (hQK (Subgroup.mem_map_of_mem M.subtype hx))
    have hcomap : Subgroup.comap (QuotientGroup.mk' (CFSG.pCore 2 ↥M)) (barM M K) =
        K.subgroupOf M := by
      rw [barM]
      exact Subgroup.comap_map_eq_self hker
    have hKbar : K.relIndex M = (barM M K).index := by
      show (K.subgroupOf M).index = (barM M K).index
      rw [← hcomap,
        Subgroup.index_comap_of_surjective (barM M K) (QuotientGroup.mk'_surjective _)]
    intro hdK
    rw [hKbar] at hdK
    exact hDnot (dvd_trans hdK (Subgroup.index_dvd_of_le hDK))
  obtain ⟨D', hD'⟩ := exists_isSylowOf d K
  have hD'iff := isSylowOf_iff.mp hD'
  have hD'le : D' ≤ K := hD'iff.1
  refine ⟨D', isSylowOf_iff.mpr ⟨hD'le.trans hKle, hD'iff.2.1, ?_⟩, hD'le⟩
  rw [← Subgroup.relIndex_mul_relIndex D' K M hD'le hKle]
  exact fun h => (Nat.Prime.dvd_mul hd).mp h |>.elim hD'iff.2.2 hidx

