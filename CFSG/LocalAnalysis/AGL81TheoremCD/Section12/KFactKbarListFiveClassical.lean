theorem false_of_psl_two {K S : Type} [Group K] [Finite K] [Group S] [Finite S]
    {p f : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p) (hq : CFSG.IsQuasisimple K)
    (e : K ⧸ center K ≃* S) (hK : StatedClassicalModel K .PSL 2 p f)
    {E : Subgroup (MulAut S)} (hE : IsElemAbelian 3 E) (hc : Nat.card E = 27) : False := by
  have : IsSimpleGroup K := CFSG.Open.StatedAPI.isSimpleGroup_of_statedClassicalModel hK
  obtain ⟨-, F, instF, instFin, hF, ⟨a⟩⟩ := hK
  let ψ : S ≃* CFSG.GorensteinWalter.PSL2 F := ((equiv_of_centerQuotient hq e).symm.trans a).trans
    (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj 2 F).symm
  have : NeZero (3 : F) := ⟨Sec4.three_ne_zero_of_card hp (by omega) hF⟩
  have hno := CFSG.RankThree.PartOne.K133.NoRankThree.of_mulEquiv Nat.prime_three ψ
    (CFSG.RankThree.PartOne.K133.noRankThree_psl2 Nat.prime_three (by norm_num))
  exact hno ⟨E, (CFSG.SectionRank.isElementaryAbelian_iff_isElemAbelian 3 E).2 hE,
    by simpa using hc⟩

theorem false_of_psp_four_prime {K S : Type} [Group K] [Finite K] [Group S] [Finite S]
    {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p) (hq : CFSG.IsQuasisimple K)
    (e : K ⧸ center K ≃* S) (hK : StatedClassicalModel K .PSp 2 p 1)
    {E : Subgroup (MulAut S)} (hE : IsElemAbelian 3 E) (hc : Nat.card E = 27) : False := by
  have : IsSimpleGroup K := CFSG.Open.StatedAPI.isSimpleGroup_of_statedClassicalModel hK
  obtain ⟨-, F, instF, instFin, hF, ⟨a⟩⟩ := hK
  let ψ := (equiv_of_centerQuotient hq e).symm.trans a
  have hFp : Nat.card F = p := by simpa using hF
  have hodd : ringChar F ≠ 2 := by
    have : CharP F p := CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic
      hp (by norm_num : 1 ≤ 1) hF
    rw [ringChar.eq F p]
    omega
  have hout := Sec4.Item49OddChar.not_three_dvd_card_outer_psp4 hodd
    (Sec4.Item49OddChar.subsingleton_ringAut_of_card_prime hp hFp)
  have h3F : ¬ 3 ∣ Nat.card F := by
    rw [hFp]
    intro h
    have := (Nat.prime_dvd_prime_iff_eq Nat.prime_three hp).1 h
    omega
  have hno : NoE27 (StatedProj (StatedSp 2 F)) := by
    intro D hD
    have h3 : 3 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (StatedProj (StatedSp 2 F))) :=
      CFSG.SectionRank.le_pRank (by norm_num) le_top hD.1 (by simpa using hD.2)
    have h2 :=
      CFSG.LocalAnalysis.UniquenessCase.PartOne.Theorem82.K1Lin.pRank_three_projSp_two_le_two h3F
    omega
  have hZ := Sec6.BThreeCensus.center_statedProj_sp4_eq_bot_of_four_le (by omega : 4 ≤ Nat.card F)
  exact (AutNoE27.of_mulEquiv ψ (autNoE27_of_noE27 hout hZ hno)) E ⟨hE, hc⟩

end CFSG.LocalAnalysis.AGL81TheoremCD.Section12.KbarListFive

