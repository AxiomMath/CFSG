theorem false_of_perfect_surj_of_twelveCtx
    (h1 : CFSG.CGT.PushingUpLit.AschbacherTheoremOneK)
    (h2 : CFSG.CGT.PushingUpLit.AschbacherTheoremTwoK)
    (h25 : CFSG.CGT.PushingUpLit.SolomonAlternatingBlockK) (h93 : Asc81bNineThree)
    (hK6a : KFactBlockNoL33U35L37HeRankFree) (hK6b : KFactBlockNoG25RankFree)
    {M : Subgroup G} {p : ℕ} {Q H : Subgroup G} (h : TwelveCtx G M p Q H) {L : Subgroup G}
    (hL : L ∈ weakBlockSet M H) {V : Subgroup G}
    (hVHL : V ≤ H ⊓ L) (hN : H ⊓ L ≤ normalizer (V : Set G)) (hperf : ⁅V, V⁆ = V)
    {U : Type} [Group U] [Finite U] [IsSimpleGroup U] (ψ : ↥V →* U)
    (hψ : Function.Surjective ψ)
    (hU : IsL33U35L37HeOrder (Nat.card U) ∨ IsG25Order (Nat.card U)) : False := by
  have : IsSimpleGroup G := h.cstar.simple
  have hT : TwoLocalPhaseThree M H := h.twoLocalPhaseThree
  have hK : CFSG.Open.IsKGroup ↥M :=
    CFSG.LocalAnalysis.GLTheoremB.isKGroup_of_isKProper h.cstar.kProper
      (CFSG.RankThreeCoreUniqueness.Helpers.twoLocal_ne_top h.cstar.nonab M h.maxLocal.1)
  have h85 : Asc81bEightFive :=
    asc81bEightFive_of_factorization
      CFSG.LocalAnalysis.RankThreeTheoremC.aschbacherLocalFactorization_proved
  have hNX : CFSG.AGLEmbeddingD2.NoXBlockFor G :=
    noXBlockFor_of_standingGen h1 h2 h25 h.cstar.toStandingGen
  have hL' : IsWeakSBlock M (pCoreOf 2 H) L := hL
  have hNH : normalizer (pCoreOf 2 H : Set G) = H := hT.toTwoLocalPair.normalizer_twoCore_H
  have hPL : blockParabolic M (pCoreOf 2 H) L = barM M (H ⊓ L) := by
    show barM M (normalizer (pCoreOf 2 H : Set G) ⊓ L) = barM M (H ⊓ L)
    rw [hNH]
  have hVM : V ≤ M := hVHL.trans (inf_le_right.trans hL'.le)
  have hbar : barM M V ≤ blockParabolic M (pCoreOf 2 H) L := hPL ▸ barM_mono hVHL
  have hbot : blockParabolic M (pCoreOf 2 H) L ≤
      normalizer ((⊥ : Subgroup (↥M ⧸ CFSG.pCore 2 ↥M)) : Set _) := by
    rw [normalizer_eq_top]
    exact le_top
  have hcop : Nat.Coprime 3 (Nat.card (⊥ : Subgroup (↥M ⧸ CFSG.pCore 2 ↥M))) := by
    rw [card_bot]
    exact Nat.coprime_one_right 3
  have hsup : blockParabolic M (pCoreOf 2 H) L ≤
      normalizer (((barM M V ⊔ ⊥) : Subgroup (↥M ⧸ CFSG.pCore 2 ↥M)) : Set _) := by
    rw [sup_bot_eq, hPL]
    rintro x ⟨m, hm, rfl⟩
    exact mem_normalizer_barM m.2 (hN (mem_subgroupOf.mp hm))
  have hX : ¬ InClassXBlock L := (hT.nineThree_not_one hK h85 hNX hL').1
  have hSy := hT.not_isSylowTwoOf_inf hK h85 hNX hL'
  have h93c := hT.nineThree hK h93 hL'
  rcases hU with hU | hU
  · exact hK6a G M (pCoreOf 2 H) L hK hT.asc81bHyp hL' h93c hX hSy ⊥ V hVM bot_le hbar hbot
      hcop hsup hperf U ψ hψ hU
  · exact hK6b G M (pCoreOf 2 H) L hK hT.asc81bHyp hL' h93c hX hSy ⊥ V hVM bot_le hbar hbot
      hcop hsup hperf U ψ hψ hU

