theorem oUpperTwo_le_xSub_of_commutator_mem {M : Subgroup G} {p : ℕ} {H : Subgroup G} {d : ℕ}
    (hs : TwelveThreeCaseSpor M p H d) {I : Subgroup G} (hIB : I ≤ H ⊓ M)
    (hc : ∀ x ∈ I, ∀ y ∈ oPPrimeHull d (H ⊓ M), x * y * x⁻¹ * y⁻¹ ∈ xSub p M H) :
    CFSG.ComponentClassification.AS76b.oUpperTwo I ≤ xSub p M H := by
  refine (closure_le _).2 fun x hx => ?_
  obtain ⟨hxI, hxo⟩ := hx
  exact hs.2.2.2.2.1 x ⟨hIB hxI, hs.2.2.2.2.2 x (hIB hxI).1 hxo⟩ (hc x hxI)

theorem twelveFourASevenLeX_of_caseSpor {M : Subgroup G} {p : ℕ} {Q H : Subgroup G} {d : ℕ}
    {L : Subgroup G} (_h : TwelveCtx G M p Q H) (hdat : TwelveThreeData M p H d)
    (hs : TwelveThreeCaseSpor M p H d) (hL : L ∈ weakBlockSet M H)
    (hB : TwelveFourBlockFacts M H L) : TwelveFourASevenLeX M p H L := by
  intro h5
  have := xSub_subgroupOf_inf_normal hdat.common.xSub_normal
  obtain ⟨hle, hsn⟩ := isSubnormal_inf_of_mem_weakBlockSet hL
  rcases le_or_commutator_eq_bot_of_isSubnormal hdat hs
      (isSubnormal_barX_of_isSubnormal hle hsn) with hY | hc
  · exact (false_of_le_of_primes hdat hs hle (hB.aSeven_primes h5) hY).elim
  · exact oUpperTwo_le_xSub_of_commutator_mem hs hle
      (commutator_mem_xSub_of_commutator_eq_bot hle hc)

private theorem jOne_le_xSub_of_caseSpor_of_inputs
    (h1 : CFSG.CGT.PushingUpLit.AschbacherTheoremOneK)
    (h2 : CFSG.CGT.PushingUpLit.AschbacherTheoremTwoK)
    (h25 : CFSG.CGT.PushingUpLit.SolomonAlternatingBlockK) (h93 : Asc81bNineThree)
    (hK6a : KFactBlockNoL33U35L37HeRankFree) (hK6b : KFactBlockNoG25RankFree)
    {M : Subgroup G} {p : ℕ} {Q H : Subgroup G} (h : TwelveCtx G M p Q H) {d : ℕ}
    (hdat : TwelveThreeData M p H d) (hs : TwelveThreeCaseSpor M p H d)
    {L : Subgroup G} (hL : L ∈ weakBlockSet M H) :
    jOne H L ≤ xSub p M H := by
  have := xSub_subgroupOf_inf_normal hdat.common.xSub_normal
  refine iSup₂_le fun I hI => ?_
  have hIB : I ≤ H ⊓ M := (isSubnormal_barX_of_mem_cZero (p := p) hL hI).1
  rcases le_or_commutator_eq_bot hdat hs hL hI with hle | hc
  · exfalso
    rcases (show IsCZeroMember (H ⊓ L) I from hI).shape with hIc | ⟨-, hb⟩
    · obtain ⟨V, hVHL, hN, hperf, ψ, hψ⟩ := exists_perfect_surj_of_le hdat hs hL hI hle
      have := (isSimpleGroup_barX hdat hs).1
      obtain ⟨e⟩ := nonempty_mulEquiv_barX hdat hs
      have hcard : Nat.card ↥(barX p M H (oPPrimeHull d (H ⊓ M))) =
          Nat.card (modPrimeComplement d (oPPrimeHull d (H ⊓ M))) :=
        Nat.card_congr e.symm.toEquiv
      refine false_of_perfect_surj_of_twelveCtx h1 h2 h25 h93 hK6a hK6b h hL hVHL hN hperf
        ψ hψ ?_
      rw [hcard]
      rcases card_modPrimeComplement_of_caseSpor hs with hc | hc | hc | hc | hc <;> rw [hc]
      · exact Or.inl (Or.inl rfl)
      · exact Or.inl (Or.inr (Or.inl rfl))
      · exact Or.inr rfl
      · exact Or.inl (Or.inr (Or.inr (Or.inl rfl)))
      · exact Or.inl (Or.inr (Or.inr (Or.inr rfl)))
    · exact false_of_le_of_symThree hdat hs hIB hb hle
  · exact oUpperTwo_le_xSub_of_commutator_mem hs hIB
      (commutator_mem_xSub_of_commutator_eq_bot hIB hc)

