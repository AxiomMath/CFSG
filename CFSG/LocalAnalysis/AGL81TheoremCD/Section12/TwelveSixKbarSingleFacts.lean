@[expose] def NineSixMoreoverPairFive : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (M Q H E : Subgroup G) (p : ℕ),
    NineSettingGen G M p Q H E 2 → H ∈ H2Fam M Q →
      p ∉ CFSG.LocalAnalysis.RankThreeUC.S15.sigmaM G M → p ≠ 3 →
    ∀ L I : Subgroup G, IsPComponentIn p L H → ¬ L ≤ M → IsPComponentIn p I H → ¬ I ≤ M →
      L ≠ I → p = 5 ∧
        CFSG.RankThree.PartOne.Census3.IsoLie ↥(starImg p H L) (.suzuki 2) ∧
        CFSG.RankThree.PartOne.Census3.IsoLie ↥(starImg p H I) (.suzuki 2)

@[expose] def KFactSz32MulAutThreeFree : Prop :=
  ∀ (Y : Type) [Group Y] [Finite Y], CFSG.RankThree.PartOne.Census3.IsoLie Y (.suzuki 2) →
    ¬ 3 ∣ Nat.card (MulAut Y)

theorem kFactSz32MulAutThreeFree_holds :
    KFactSz32MulAutThreeFree := by
  intro Y _ _ hiso
  have hM : CFSG.Blueprint.SuzukiModel Y 2 5 :=
    CFSG.RankThree.PartOne.CTP.suzukiModel_of_isoLie 2 hiso
  have hcard : Nat.card Y = 32537600 :=
    CFSG.HardMathSupport.Dickson.Bal207.card_of_suzukiModel_two_five hM
  haveI : IsSimpleGroup Y := (CFSG.LieType.Simplicity.fam_2b2_simplicity Y 2 5 hM).2
  have hnab : ∃ a b : Y, a * b ≠ b * a := by
    by_contra h
    push Not at h
    haveI : IsMulCommutative Y := isMulCommutative_iff.mpr h
    have hprime : (Nat.card Y).Prime := (Group.is_simple_iff_prime_card).mp inferInstance
    rw [hcard] at hprime
    exact (by norm_num : ¬ Nat.Prime 32537600) hprime
  have hZ : Subgroup.center Y = ⊥ :=
    CFSG.RankThree.PartOne.K159F.center_eq_bot_of_simple hnab
  have hinj : Function.Injective (MulAut.conj : Y →* MulAut Y) :=
    CFSG.RankThree.PartOne.K159F.conj_injective_of_center_eq_bot hZ
  have hInnerCard : Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.inner Y) =
      Nat.card Y :=
    (Nat.card_congr (MonoidHom.ofInjective hinj).toEquiv).symm
  have hO : Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.Outer Y) ∣ 5 :=
    CFSG.RankThree.PartOne.K159F.card_outer_dvd_five hiso
  have h1 : Nat.card (MulAut Y) =
      Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.Outer Y) *
        Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.inner Y) :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup _
  rw [hInnerCard, hcard] at h1
  have hdiv : Nat.card (MulAut Y) ∣ 5 * 32537600 := by
    rw [h1]
    exact Nat.mul_dvd_mul hO (dvd_refl 32537600)
  intro h3
  exact (by norm_num : ¬ 3 ∣ 5 * 32537600) (h3.trans hdiv)

private theorem card_outer_psl28 {X : Type} [Group X] [Finite X]
    (e : X ≃* CFSG.AGLEmbedding.PSL2GF 2 3) :
    Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.Outer X) = 3 := by
  haveI : IsSimpleGroup X :=
    CFSG.GF2Type.Smith1979.OmegaPlus.isSimpleGroup_of_mulEquiv_psl28 e
  have hnab : ∃ a b : X, a * b ≠ b * a :=
    CFSG.GF2Type.Smith1979.OmegaPlus.exists_ne_comm_of_mulEquiv_psl28 e
  have hZ : Subgroup.center X = ⊥ :=
    CFSG.RankThree.PartOne.K159F.center_eq_bot_of_simple hnab
  have hinj : Function.Injective (MulAut.conj : X →* MulAut X) :=
    CFSG.RankThree.PartOne.K159F.conj_injective_of_center_eq_bot hZ
  have hInnerCard : Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.inner X) =
      Nat.card X :=
    (Nat.card_congr (MonoidHom.ofInjective hinj).toEquiv).symm
  have h1 : Nat.card (MulAut X) =
      Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.Outer X) *
        Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.inner X) :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup _
  have h2 : Nat.card (MulAut X) = 3 * Nat.card X :=
    CFSG.GF2Type.Smith1979.OmegaPlus.card_mulAut_of_mulEquiv_psl28 e
  rw [h2, hInnerCard] at h1
  haveI : Nonempty X := ⟨1⟩
  exact (Nat.mul_right_cancel Nat.card_pos h1).symm

theorem mem_range_conj_of_inv_of_psl28 {X : Type} [Group X] [Finite X]
    (e : X ≃* CFSG.AGLEmbedding.PSL2GF 2 3) {a τ : MulAut X} (ha : a ^ 3 = 1)
    (hτ : τ * a * τ⁻¹ = a⁻¹) : a ∈ (MulAut.conj : X →* MulAut X).range := by
  have hOuterCard : Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.Outer X) = 3 :=
    card_outer_psl28 e
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  haveI hcyc : IsCyclic (CFSG.ComponentClassification.OuterAutomorphisms.Outer X) :=
    isCyclic_of_prime_card hOuterCard
  haveI hcomm : IsMulCommutative (CFSG.ComponentClassification.OuterAutomorphisms.Outer X) :=
    hcyc.isMulCommutative
  let Inn : Subgroup (MulAut X) := CFSG.ComponentClassification.OuterAutomorphisms.inner X
  let π : MulAut X →* CFSG.ComponentClassification.OuterAutomorphisms.Outer X :=
    QuotientGroup.mk' Inn
  have hqa3 : (π a) ^ 3 = 1 := by
    rw [← map_pow, ha, map_one]
  have hconj : π τ * π a * (π τ)⁻¹ = (π a)⁻¹ := by
    have h := congrArg π hτ
    simpa [map_mul, map_inv] using h
  have hcommA : π a = (π a)⁻¹ := by
    rw [← hconj]
    rw [hcomm.is_comm.comm (π τ) (π a), mul_assoc, mul_inv_cancel, mul_one]
  have hsq : (π a) ^ 2 = 1 := by
    rw [pow_two]
    exact mul_eq_one_iff_eq_inv.mpr hcommA
  have hqa1 : π a = 1 := by
    have h3 : (π a) ^ 3 = (π a) ^ 2 * π a := by
      rw [show (3 : ℕ) = 2 + 1 by norm_num, pow_succ]
    rw [h3, hsq, one_mul] at hqa3
    exact hqa3
  have hmem : a ∈ Inn := by
    have hker : a ∈ (QuotientGroup.mk' Inn).ker := MonoidHom.mem_ker.mpr hqa1
    rwa [QuotientGroup.ker_mk'] at hker
  exact hmem

private theorem card_eq_three_pow_factorization {X : Type} [Group X] [Finite X]
    (hX : Nat.card X = 504) {A : Subgroup X} (hA : Nat.card A = 9) :
    Nat.card A = 3 ^ (Nat.card X).factorization 3 := by
  have hfac : (504 : ℕ).factorization 3 = 2 := by
    rw [show (504 : ℕ) = 3 ^ 2 * 56 by norm_num,
      Nat.factorization_mul (by norm_num) (by norm_num), Finsupp.add_apply,
      Nat.Prime.factorization_pow Nat.prime_three,
      Nat.factorization_eq_zero_of_not_dvd (by norm_num)]
    simp
  rw [hX, hfac, hA]
  norm_num

theorem card_ne_nine_of_isElemAbelian_of_psl28 {X : Type} [Group X] [Finite X]
    (e : X ≃* CFSG.AGLEmbedding.PSL2GF 2 3) {A : Subgroup X} (hA : IsElemAbelian 3 A) :
    Nat.card A ≠ 9 := by
  classical
  intro h9
  have hcardPSL : Nat.card (CFSG.AGLEmbedding.PSL2GF 2 3) = 504 := by
    have h := CFSG.Walter.psl2_even_card (f := 3) (by norm_num : (3 : ℕ) ≠ 0)
    rw [show CFSG.AGLEmbedding.PSL2GF 2 3 = PSL(2, GaloisField 2 3) from rfl, h]
    norm_num
  have hX : Nat.card X = 504 := (Nat.card_congr e.toEquiv).trans hcardPSL
  haveI : IsSimpleGroup X :=
    CFSG.GF2Type.Smith1979.OmegaPlus.isSimpleGroup_of_mulEquiv_psl28 e
  have hnab : ∃ a b : X, a * b ≠ b * a :=
    CFSG.GF2Type.Smith1979.OmegaPlus.exists_ne_comm_of_mulEquiv_psl28 e
  have hZ : Subgroup.center X = ⊥ :=
    CFSG.RankThree.PartOne.K159F.center_eq_bot_of_simple hnab
  have eQ : X ⧸ Subgroup.center X ≃* PSL(2, GaloisField 2 3) :=
    (QuotientGroup.quotientMulEquivOfEq hZ).trans (QuotientGroup.quotientBot.trans e)
  obtain ⟨y, hy⟩ :=
    CFSG.GF2Type.Smith1979.W4As.Surv.exists_orderOf_nine_of_psl28 eQ
  have hY9 : Nat.card ↥(Subgroup.zpowers y) = 9 := by
    rw [Nat.card_zpowers]
    exact hy
  have hAcard : Nat.card A = 3 ^ (Nat.card X).factorization 3 :=
    card_eq_three_pow_factorization hX h9
  have hYcard : Nat.card ↥(Subgroup.zpowers y) = 3 ^ (Nat.card X).factorization 3 :=
    card_eq_three_pow_factorization hX hY9
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let P : Sylow 3 X := Sylow.ofCard A hAcard
  let Q : Sylow 3 X := Sylow.ofCard (Subgroup.zpowers y) hYcard
  have hP : (P : Subgroup X) = A := Sylow.coe_ofCard A hAcard
  have hQ : (Q : Subgroup X) = Subgroup.zpowers y :=
    Sylow.coe_ofCard (Subgroup.zpowers y) hYcard
  have eAQ : ↥A ≃* ↥(Subgroup.zpowers y) :=
    (MulEquiv.subgroupCongr hP).symm |>.trans
      ((Sylow.equiv P Q).trans (MulEquiv.subgroupCongr hQ))
  have hcycA : IsCyclic ↥A := eAQ.isCyclic.mpr (Subgroup.isCyclic_zpowers y)
  haveI : IsElementaryAbelian 3 ↥A :=
    { toIsMulCommutative := hA.1
      exponent_dvd_p :=
        Monoid.exponent_dvd_of_forall_pow_eq_one fun x => Subtype.ext (hA.2 x x.2) }
  have hAncyc : ¬ IsCyclic ↥A :=
    CFSG.IsElementaryAbelian.not_isCyclic_of_card_eq_prime_sq (p := 3)
      (by rw [h9]; norm_num)
  exact hAncyc hcycA

private theorem pPrimeCore_three_le_solvableRadical_of_quot_altSix {G : Type} [Group G]
    [Finite G] {L : Subgroup G}
    (e : (↥L ⧸ CFSG.solvableRadical ↥L) ≃* alternatingGroup (Fin 6)) :
    CFSG.pPrimeCore 3 ↥L ≤ CFSG.solvableRadical ↥L := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  haveI : IsSimpleGroup (alternatingGroup (Fin 6)) :=
    alternatingGroup.isSimpleGroup (by simp)
  let N : Subgroup ↥L := CFSG.pPrimeCore 3 ↥L
  let R : Subgroup ↥L := CFSG.solvableRadical ↥L
  let π : ↥L →* ↥L ⧸ R := QuotientGroup.mk' R
  haveI : IsSimpleGroup (↥L ⧸ R) := e.isSimpleGroup
  have hDnormal : (N.map π).Normal :=
    (CFSG.pPrimeCore_normal (p := 3) (G := ↥L)).map π (QuotientGroup.mk'_surjective R)
  have hDcop : Nat.Coprime 3 (Nat.card (N.map π)) :=
    (CFSG.pPrimeCore_coprime_card (p := 3) (G := ↥L)).of_dvd_right
      (Subgroup.card_map_dvd N π)
  have hDbot : N.map π = ⊥ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (N.map π) with hbot | htop
    · exact hbot
    · exfalso
      have hA6 : Nat.card (alternatingGroup (Fin 6)) = 360 := by
        rw [nat_card_alternatingGroup, Nat.card_eq_fintype_card, Fintype.card_fin]
        norm_num
      have hcard : Nat.card (N.map π) = 360 := by
        rw [htop, Subgroup.card_top, Nat.card_congr e.toEquiv, hA6]
      have h3dvd : 3 ∣ Nat.card (N.map π) := by
        rw [hcard]
        norm_num
      have h31 := (Nat.gcd_eq_one_iff.mp (Nat.Coprime.gcd_eq_one hDcop)) 3 dvd_rfl h3dvd
      omega
  have hle : N ≤ (QuotientGroup.mk' R).ker := (Subgroup.map_eq_bot_iff N).mp hDbot
  rwa [QuotientGroup.ker_mk'] at hle

theorem nonempty_center_quot_equiv_altSix_of_isPComponentIn {G : Type} [Group G] [Finite G]
    {L H : Subgroup G} (hL : IsPComponentIn 3 L H)
    (h : Nonempty (↥L ⧸ CFSG.solvableRadical ↥L ≃* alternatingGroup (Fin 6))) :
    Nonempty ((↥L ⧸ CFSG.pPrimeCore 3 ↥L) ⧸ center (↥L ⧸ CFSG.pPrimeCore 3 ↥L) ≃*
      alternatingGroup (Fin 6)) := by
  classical
  obtain ⟨e₀⟩ := h
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let N : Subgroup ↥L := CFSG.pPrimeCore 3 ↥L
  let R : Subgroup ↥L := CFSG.solvableRadical ↥L
  have hNleR : N ≤ R :=
    pPrimeCore_three_le_solvableRadical_of_quot_altSix (L := L) e₀
  haveI : Group.IsSolvable ↥R := CFSG.ABGLocalTools.solvableRadical_isSolvable
  have hNsolv : Group.IsSolvable ↥N :=
    Group.isSolvable_of_isSolvable_injective (Subgroup.inclusion_injective hNleR)
  haveI : Group.IsSolvable ↥N := hNsolv
  let g : ↥L →* ↥L ⧸ N := QuotientGroup.mk' N
  have hq : CFSG.IsQuasisimple (↥L ⧸ N) := hL.isQuasisimple_quot Nat.prime_three
  have hq' : CFSG.Open.IsQuasisimple (↥L ⧸ N) :=
    (CFSG.Foundations.SteinbergCA.quasisimple_iff (↥L ⧸ N)).2.2.1.mp hq
  have hgker : g.ker = N := QuotientGroup.ker_mk' N
  have hgkersolv : Group.IsSolvable ↥g.ker := by
    rw [hgker]
    infer_instance
  have hsol : CFSG.solvableRadical ↥L = (Subgroup.center (↥L ⧸ N)).comap g :=
    CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p22a_sol_eq g
      (QuotientGroup.mk'_surjective N) hgkersolv hq'
  obtain ⟨e₁⟩ := CFSG.LocalAnalysis.UniquenessCase.UC22.uc22p22a_equiv_of_sol_eq g
    (QuotientGroup.mk'_surjective N) hsol
  exact ⟨e₁.symm.trans e₀⟩

end CFSG.LocalAnalysis.AGL81TheoremCD.Section12

