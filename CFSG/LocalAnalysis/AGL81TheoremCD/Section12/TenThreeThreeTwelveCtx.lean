theorem tenThreeThree_of_twelveCtx {M H Q : Subgroup G} {p : ℕ}
    (h : TwelveCtx G M p Q H) (hM3 : CFSG.Open.pRank 3 M ≤ 3)
    {L : Subgroup G} (hL : L ∈ weakBlockSet M H) {b : G}
    (hb : b ∈ H ⊓ M) (hbL : b ∈ normalizer (L : Set G))
    (hbo : Odd (orderOf b))
    (hbJ : ∀ x ∈ jZero H L, b * x * b⁻¹ * x⁻¹ ∈ pCoreOf 2 (jZero H L)) :
    (∀ l ∈ L, b * l * b⁻¹ * l⁻¹ ∈ pCoreOf 2 L) ∨
      (IsClassicalTwoOrG2 (↥(barM M L) ⧸ Subgroup.center ↥(barM M L)) ∧
        IsParabolicTwo (barM M L) (barM M (H ⊓ L)) ∧
        ¬ CFSG.QuasithinUnique.IsSylowTwoOf (pCoreOf 2 (barM M (H ⊓ L))) (barM M L)) ∨
      NineThreeFive M L := by
  have h1 := CFSG.HardMathSupport.Foote.Coordinator.aschbacherTheoremOneK_proved
  have h2 := CFSG.CGT.PushingUpLit.aschbacherTheoremTwoK_holds
  have h25 := CFSG.CGT.PushingUpLit.solomonAlternatingBlockK_holds
  have h84 := CFSG.AGLEmbedding.asc81bEightFour_of_factorization
      CFSG.LocalAnalysis.RankThreeTheoremC.aschbacherLocalFactorization_proved
  have h85 := CFSG.AGLEmbedding.asc81bEightFive_of_factorization
    CFSG.LocalAnalysis.RankThreeTheoremC.aschbacherLocalFactorization_proved
  have h93 := CFSG.LocalAnalysis.RankThreeTheoremC.BlockB.asc81bNineThree_holds
  have hNX := noXBlockFor_of_standingGen h1 h2 h25 h.cstar.toStandingGen
  have hKT := TenThreeThree.TransvW.kFactTransvectionW3_holds
  have hAlt := TenThreeThree.asc81bAltBlockAutNX_holds
  rcases tenThreeThree_of_inputs h1 h2 h25 h84 h85 h93 hNX hKT hAlt
    h hM3 hL hb hbL hbo hbJ with hc | hpar
  · exact Or.inl (commutator_mem_twoCore_of_component hL.toIsTwoPrimeComponent hbL hc)
  · exact Or.inr hpar

end Holds

