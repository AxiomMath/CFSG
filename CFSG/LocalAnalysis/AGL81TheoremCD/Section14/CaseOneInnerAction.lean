noncomputable abbrev starCentralizer (Y : Subgroup G) : Subgroup G :=
  quotientCentralizer (Subgroup.normalizer (Y : Set G)) Y (CFSG.pPrimeCore 3 ↥Y)
    Subgroup.le_normalizer le_rfl

private theorem conjQuotAction_eq_jStarAct (Y : Subgroup G) :
    conjQuotAction (Subgroup.normalizer (Y : Set G)) Y (CFSG.pPrimeCore 3 ↥Y)
      Subgroup.le_normalizer le_rfl = jStarAct Y := by
  apply MonoidHom.ext
  intro n
  apply MulEquiv.ext
  intro a
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (CFSG.pPrimeCore 3 ↥Y) a
  rw [conjQuotAction_apply_mk, jStarAct_apply_mk]

theorem mem_starCentralizer_iff {Y : Subgroup G} {x : G} :
    x ∈ starCentralizer Y ↔
      ∃ hx : x ∈ Subgroup.normalizer (Y : Set G), jStarAct Y ⟨x, hx⟩ = 1 := by
  rw [show starCentralizer Y = quotientCentralizer (Subgroup.normalizer (Y : Set G)) Y
      (CFSG.pPrimeCore 3 ↥Y) Subgroup.le_normalizer le_rfl from rfl,
    mem_quotientCentralizer]
  constructor
  · rintro ⟨n, rfl, hn⟩
    refine ⟨n.2, ?_⟩
    rwa [← conjQuotAction_eq_jStarAct Y, hn]
  · rintro ⟨hx, hx1⟩
    exact ⟨⟨x, hx⟩, rfl, by rwa [conjQuotAction_eq_jStarAct Y]⟩

theorem jStarAct_of_mem {J : Subgroup G} {g : G} (hg : g ∈ J) :
    jStarAct J ⟨g, Subgroup.le_normalizer hg⟩ = MulAut.conj
      (QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J) ⟨g, hg⟩) := by
  ext w
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (CFSG.pPrimeCore 3 ↥J) w
  rw [jStarAct_apply_mk, MulAut.conj_apply]
  change QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J) (⟨g, hg⟩ * x * ⟨g, hg⟩⁻¹) =
    QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J) ⟨g, hg⟩ *
      QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J) x *
      (QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J) ⟨g, hg⟩)⁻¹
  simp only [map_mul, map_inv]

private theorem pPrimeCore_map_le_of_isKComp {M N J' : Subgroup G}
    (h : HypCGen G M 3 E N) (hJ' : IsKComp M N J') :
    (CFSG.pPrimeCore 3 ↥J').map J'.subtype ≤ M := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hDJ' : (CFSG.pPrimeCore 3 ↥J').map J'.subtype ≤ J' :=
    Subgroup.map_subtype_le _
  have hDK : (CFSG.pPrimeCore 3 ↥J').map J'.subtype ≤ kSub 3 M N :=
    hDJ'.trans hJ'.1
  have hJ'D : J' ≤ Subgroup.normalizer
      ((CFSG.pPrimeCore 3 ↥J').map J'.subtype : Set G) :=
    Subgroup.le_normalizer.trans
      (CFSG.LieType.BorelTits.normalizer_le_normalizer_map_of_characteristic
        (CFSG.pPrimeCore 3 ↥J'))
  have hDnormal :
      ((((CFSG.pPrimeCore 3 ↥J').map J'.subtype).subgroupOf (kSub 3 M N)).subgroupOf
        (J'.subgroupOf (kSub 3 M N))).Normal := by
    refine ⟨fun n hn g => ?_⟩
    simp only [Subgroup.mem_subgroupOf] at hn ⊢
    exact (Subgroup.mem_normalizer_iff.mp
      (hJ'D (Subgroup.mem_subgroupOf.mp g.2)) ((n : ↥(kSub 3 M N)) : G)).mp hn
  have hDsub : (((CFSG.pPrimeCore 3 ↥J').map J'.subtype).subgroupOf
      (kSub 3 M N)).IsSubnormal :=
    Subgroup.IsSubnormal.step
      (((CFSG.pPrimeCore 3 ↥J').map J'.subtype).subgroupOf (kSub 3 M N))
      (J'.subgroupOf (kSub 3 M N))
      (fun x hx => Subgroup.mem_subgroupOf.mpr
        (hDJ' (Subgroup.mem_subgroupOf.mp hx)))
      hJ'.isSubnormal hDnormal
  have hcop : Nat.Coprime 3
      (Nat.card (((CFSG.pPrimeCore 3 ↥J').map J'.subtype).subgroupOf (kSub 3 M N))) := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hDK).toEquiv,
      Subgroup.card_map_of_injective J'.subtype_injective]
    exact CFSG.pPrimeCore_coprime_card
  have hle : (((CFSG.pPrimeCore 3 ↥J').map J'.subtype).subgroupOf (kSub 3 M N)) ≤
      CFSG.pPrimeCore 3 ↥(kSub 3 M N) :=
    CFSG.GH74.GLS.le_pPrimeCore_of_subnormal 3 hDsub hcop
  have hDleO : (CFSG.pPrimeCore 3 ↥J').map J'.subtype ≤
      (CFSG.pPrimeCore 3 ↥(kSub 3 M N)).map (kSub 3 M N).subtype := by
    have hmap := Subgroup.map_mono (f := (kSub 3 M N).subtype) hle
    rwa [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hDK] at hmap
  have hEK : E ≤ Subgroup.normalizer (kSub 3 M N : Set G) :=
    (le_inf h.E_le_H h.E_le_M).trans (inf_le_normalizer_kSub 3 M N)
  have hEOn : E ≤ Subgroup.normalizer
      ((CFSG.pPrimeCore 3 ↥(kSub 3 M N)).map (kSub 3 M N).subtype : Set G) :=
    hEK.trans (CFSG.LieType.BorelTits.normalizer_le_normalizer_map_of_characteristic
      (CFSG.pPrimeCore 3 ↥(kSub 3 M N)))
  have hOnot : ¬ 3 ∣ Nat.card
      ((CFSG.pPrimeCore 3 ↥(kSub 3 M N)).map (kSub 3 M N).subtype) := by
    rw [Subgroup.card_map_of_injective (kSub 3 M N).subtype_injective]
    exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mp CFSG.pPrimeCore_coprime_card
  exact hDleO.trans (h.invariant_coprime_le_M hOnot hEOn)

theorem HypCGen.eq_one_of_mem_starCentralizer (h : HypCGen G M 3 E N)
    (hLN : ¬ pLayerIn 3 N ≤ M) {J' : Subgroup G} (hJ' : IsKComp M N J') {e : G}
    (he : e ∈ E) (heJ : e ∈ starCentralizer J') : e = 1 := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  by_contra he1
  have hDJ' : (CFSG.pPrimeCore 3 ↥J').map J'.subtype ≤ J' := Subgroup.map_subtype_le _
  have hJ'D : J' ≤ Subgroup.normalizer
      ((CFSG.pPrimeCore 3 ↥J').map J'.subtype : Set G) :=
    Subgroup.le_normalizer.trans
      (CFSG.LieType.BorelTits.normalizer_le_normalizer_map_of_characteristic
        (CFSG.pPrimeCore 3 ↥J'))
  have heN : e ∈ Subgroup.normalizer (J' : Set G) :=
    quotientCentralizer_le (Subgroup.normalizer (J' : Set G)) J' (CFSG.pPrimeCore 3 ↥J')
      Subgroup.le_normalizer le_rfl heJ
  have heD : e ∈ Subgroup.normalizer ((CFSG.pPrimeCore 3 ↥J').map J'.subtype : Set G) :=
    (CFSG.LieType.BorelTits.normalizer_le_normalizer_map_of_characteristic
      (CFSG.pPrimeCore 3 ↥J')) heN
  have hcomm_mem : ∀ j ∈ J',
      e * j * e⁻¹ * j⁻¹ ∈ (CFSG.pPrimeCore 3 ↥J').map J'.subtype :=
    fun j hj => commutator_mem_map_of_mem_quotientCentralizer
      (CFSG.pPrimeCore 3 ↥J') Subgroup.le_normalizer le_rfl heJ hj
  have hcomm : ⁅Subgroup.zpowers e, J'⁆ ≤ (CFSG.pPrimeCore 3 ↥J').map J'.subtype := by
    have h1 : ⁅J', Subgroup.zpowers e⁆ ≤ (CFSG.pPrimeCore 3 ↥J').map J'.subtype := by
      refine CFSG.GroupTheory.commutator_zpowers_le_of_forall_mem (A := J')
        (N := (CFSG.pPrimeCore 3 ↥J').map J'.subtype) (c := e) heD ?_
      intro a ha
      have hmem := ((CFSG.pPrimeCore 3 ↥J').map J'.subtype).inv_mem (hcomm_mem a ha)
      simpa [commutatorElement_def, mul_assoc] using hmem
    rwa [Subgroup.commutator_comm] at h1
  have heB : IsPGroup 3 (Subgroup.zpowers e) := by
    apply IsPGroup.of_card_dvd_pow (n := 1)
    rw [Nat.card_zpowers, pow_one]
    exact orderOf_dvd_iff_pow_eq_one.mpr (h.elem.2 e he)
  have hDnot : ¬ 3 ∣ Nat.card ((CFSG.pPrimeCore 3 ↥J').map J'.subtype) := by
    rw [Subgroup.card_map_of_injective J'.subtype_injective]
    exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mp CFSG.pPrimeCore_coprime_card
  have hBN : Subgroup.zpowers e ≤
      Subgroup.normalizer ((CFSG.pPrimeCore 3 ↥J').map J'.subtype : Set G) :=
    Subgroup.zpowers_le.mpr heD
  have hcover : J' ≤ (J' ⊓ Subgroup.centralizer (Subgroup.zpowers e : Set G)) ⊔
      (CFSG.pPrimeCore 3 ↥J').map J'.subtype := by
    intro x hx
    obtain ⟨d, hdD, hxdJ, hxdC⟩ :=
      exists_coset_translate_centralizer (J := J') (B := Subgroup.zpowers e)
        (D := (CFSG.pPrimeCore 3 ↥J').map J'.subtype) heB hDJ' hJ'D hBN hDnot hcomm
        (x := ⟨x, hx⟩)
    have hmem : (x * d) * d⁻¹ ∈
        (J' ⊓ Subgroup.centralizer (Subgroup.zpowers e : Set G)) ⊔
          (CFSG.pPrimeCore 3 ↥J').map J'.subtype :=
      Subgroup.mul_mem_sup ⟨hxdJ, hxdC⟩ (((CFSG.pPrimeCore 3 ↥J').map J'.subtype).inv_mem hdD)
    have hxeq : (x * d) * d⁻¹ = x := by group
    rwa [hxeq] at hmem
  have hC : Subgroup.centralizer (Subgroup.zpowers e : Set G) ≤ M :=
    (Subgroup.centralizer_le (s := ({e} : Set G))
      (by intro y hy; rw [Set.mem_singleton_iff] at hy; rw [hy]
          exact Subgroup.mem_zpowers e)).trans
      (h.centralizer_le_of_mem he he1)
  have hDM : (CFSG.pPrimeCore 3 ↥J').map J'.subtype ≤ M :=
    pPrimeCore_map_le_of_isKComp h hJ'
  exact (IsKComp.not_le_M hJ' hLN)
    (hcover.trans (sup_le (inf_le_right.trans hC) hDM))

private theorem mulAut_congr_symm_conj {A B : Type*} [Group A] [Group B]
    (φ : A ≃* B) (y : B) :
    (MulAut.congr φ).symm (MulAut.conj y) = MulAut.conj (φ.symm y) := by
  apply (MulAut.congr φ).injective
  rw [MulEquiv.apply_symm_apply]
  ext x
  simp [MulAut.congr_apply, MulAut.conj_apply]

private theorem exists_conj_of_centerQuotient_eq_conj {S : Type*} [Group S]
    (hS : Group.IsPerfect S) {α : MulAut S} {z : S ⧸ Subgroup.center S}
    (h : CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom S α =
      MulAut.conj z) :
    ∃ y : S, QuotientGroup.mk' (Subgroup.center S) y = z ∧ α = MulAut.conj y := by
  haveI : Group.IsPerfect S := hS
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center S) z
  refine ⟨y, rfl, ?_⟩
  apply CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom_injective S
  rw [h]
  ext w
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center S) w
  change (MulAut.conj (QuotientGroup.mk' (Subgroup.center S) y))
      (QuotientGroup.mk' (Subgroup.center S) x) =
    CFSG.ComponentClassification.PerfectAutomorphisms.onCenterQuotient (MulAut.conj y)
      (QuotientGroup.mk' (Subgroup.center S) x)
  rw [CFSG.ComponentClassification.PerfectAutomorphisms.onCenterQuotient_apply_mk,
    MulAut.conj_apply, MulAut.conj_apply, ← map_inv, ← map_mul, ← map_mul]

theorem isPGroup_zpowers_of_pow_three_mem_center {S : Type*} [Group S]
    {y : S} (hZ : Nat.card (Subgroup.center S) ∣ 3) (hy : y ^ 3 ∈ Subgroup.center S) :
    IsPGroup 3 (Subgroup.zpowers y) := by
  have hy9 : y ^ 9 = 1 := by
    have hcent : ∀ z ∈ Subgroup.center S, z ^ 3 = 1 := by
      intro z hz
      obtain ⟨c, hc⟩ := hZ
      have h : z ^ Nat.card ↥(Subgroup.center S) = 1 :=
        congrArg Subtype.val
          (pow_card_eq_one' (x := (⟨z, hz⟩ : Subgroup.center S)))
      rw [hc, pow_mul, h, one_pow]
    have h := hcent (y ^ 3) hy
    have h9 : y ^ 9 = (y ^ 3) ^ 3 := by rw [← pow_mul]
    rwa [← h9] at h
  apply IsPGroup.of_card_dvd_pow (n := 2)
  rw [Nat.card_zpowers, show (3 : ℕ) ^ 2 = 9 by norm_num]
  exact orderOf_dvd_iff_pow_eq_one.mpr hy9

private theorem mem_of_isPGroup_of_mem_normalizer_sylow {S : Type*} [Group S] [Finite S]
    {P : Sylow 3 S} {y : S} (hyP : IsPGroup 3 (Subgroup.zpowers y))
    (hyN : y ∈ Subgroup.normalizer (P : Set S)) : y ∈ P := by
  have hHK : Subgroup.zpowers y ≤ Subgroup.normalizer (P : Set S) :=
    Subgroup.zpowers_le.mpr hyN
  have hP : IsPGroup 3 ↥((P : Subgroup S) ⊔ Subgroup.zpowers y) :=
    IsPGroup.to_sup_of_normal_left' P.isPGroup' hyP hHK
  have heq : ((P : Subgroup S) ⊔ Subgroup.zpowers y) = (P : Subgroup S) :=
    P.is_maximal' hP le_sup_left
  have hmem : y ∈ ((P : Subgroup S) ⊔ Subgroup.zpowers y) :=
    Subgroup.mem_sup_right (Subgroup.mem_zpowers y)
  rw [heq] at hmem
  exact hmem

private theorem mem_starCentralizer_of_mem_map_sylow {J' T : Subgroup G} {e : G}
    {y : threeStar J'} (hT : CFSG.ABGLocalTools.IsSylowOf 3 T J')
    (hJN : e ∈ Subgroup.normalizer (J' : Set G)) {x : ↥J'}
    (hxT : x ∈ T.subgroupOf J')
    (hxπ : QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J') x = y)
    (hy : jStarAct J' ⟨e, hJN⟩ = MulAut.conj y) :
    (x : G)⁻¹ * e ∈ starCentralizer J' := by
  have hxT' : (x : G) ∈ T := Subgroup.mem_subgroupOf.mp hxT
  have hxJ : (x : G) ∈ J' := hT.le hxT'
  have hxN : (x : G)⁻¹ ∈ Subgroup.normalizer (J' : Set G) :=
    (Subgroup.normalizer (J' : Set G)).inv_mem (Subgroup.le_normalizer hxJ)
  have hxeN : (x : G)⁻¹ * e ∈ Subgroup.normalizer (J' : Set G) :=
    (Subgroup.normalizer (J' : Set G)).mul_mem hxN hJN
  refine (mem_starCentralizer_iff).mpr ⟨hxeN, ?_⟩
  have hsplit : (⟨(x : G)⁻¹ * e, hxeN⟩ : ↥(Subgroup.normalizer (J' : Set G))) =
      (⟨(x : G), Subgroup.le_normalizer hxJ⟩ : ↥(Subgroup.normalizer (J' : Set G)))⁻¹ *
        ⟨e, hJN⟩ := Subtype.ext rfl
  rw [hsplit, map_mul, map_inv]
  have hxact : jStarAct J' ⟨(x : G), Subgroup.le_normalizer hxJ⟩ = MulAut.conj y := by
    rw [jStarAct_of_mem hxJ]
    rw [show (⟨(x : G), hxJ⟩ : ↥J') = x from Subtype.ext rfl, hxπ]
  rw [hxact, hy, inv_mul_cancel]

private theorem exists_mem_sylow_of_jStarAct_eq_conj {J' T : Subgroup G} {e : G}
    (hT : CFSG.ABGLocalTools.IsSylowOf 3 T J')
    (hJN : e ∈ Subgroup.normalizer (J' : Set G))
    (hTN : e ∈ Subgroup.normalizer (T : Set G)) (he3 : e ^ 3 = 1)
    (hZ : Nat.card (Subgroup.center (threeStar J')) = 3) {y : threeStar J'}
    (hy : jStarAct J' ⟨e, hJN⟩ = MulAut.conj y) :
    ∃ x ∈ T, x⁻¹ * e ∈ starCentralizer J' := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let π : ↥J' →* threeStar J' := QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J')
  let Tstar : Subgroup (threeStar J') := (T.subgroupOf J').map π
  obtain ⟨Q, hQ⟩ := hT.exists_sylow_eq_subgroupOf
  let Qbar : Sylow 3 (threeStar J') := Sylow.mapSurjective (p := 3) (f := π)
    (QuotientGroup.mk'_surjective (CFSG.pPrimeCore 3 ↥J')) Q
  have hQbarSub : (Qbar : Subgroup (threeStar J')) = Tstar := by
    rw [Sylow.coe_mapSurjective, hQ]
  have hQbar : ((Qbar : Subgroup (threeStar J')) : Set (threeStar J')) =
      (Tstar : Set (threeStar J')) :=
    congrArg (fun H : Subgroup (threeStar J') => (H : Set (threeStar J'))) hQbarSub
  have hy3c : y ^ 3 ∈ Subgroup.center (threeStar J') := by
    rw [← CFSG.QuasithinUnique.Setup.Layer.conj_eq_one_iff]
    calc MulAut.conj (y ^ 3) = (MulAut.conj y) ^ 3 := map_pow (MulAut.conj) y 3
      _ = (jStarAct J' ⟨e, hJN⟩) ^ 3 := by rw [hy]
      _ = jStarAct J' 1 := by
          rw [← map_pow, show (⟨e, hJN⟩ : ↥(Subgroup.normalizer (J' : Set G))) ^ 3 = 1
            from Subtype.ext he3, map_one]
      _ = 1 := map_one _
  have hZ' : Nat.card (Subgroup.center (threeStar J')) ∣ 3 := by
    simpa [hZ] using (dvd_refl 3 : 3 ∣ 3)
  have hyP : IsPGroup 3 (Subgroup.zpowers y) :=
    isPGroup_zpowers_of_pow_three_mem_center hZ' hy3c
  have himage : Tstar.map (jStarAct J' ⟨e, hJN⟩).toMonoidHom = Tstar := by
    apply Subgroup.eq_of_le_of_card_ge
    · rintro _ ⟨z, hz, rfl⟩
      obtain ⟨t, ht, rfl⟩ := Subgroup.mem_map.mp hz
      have htT : (t : G) ∈ T := Subgroup.mem_subgroupOf.mp ht
      have htJ : (t : G) ∈ J' := hT.le htT
      have hmemJ : e * (t : G) * e⁻¹ ∈ J' :=
        (Subgroup.mem_normalizer_iff.mp hJN (t : G)).mp htJ
      refine Subgroup.mem_map.mpr ⟨⟨e * (t : G) * e⁻¹, hmemJ⟩, ?_, ?_⟩
      · exact Subgroup.mem_subgroupOf.mpr
          ((Subgroup.mem_normalizer_iff.mp hTN (t : G)).mp htT)
      · show QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J')
            ⟨e * (t : G) * e⁻¹, hmemJ⟩ =
          jStarAct J' ⟨e, hJN⟩ (QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J') t)
        rw [jStarAct_apply_mk]
    · rw [Subgroup.card_map_of_injective (f := (jStarAct J' ⟨e, hJN⟩).toMonoidHom)
        (K := Tstar) (jStarAct J' ⟨e, hJN⟩).injective]
  have hyN : y ∈ Subgroup.normalizer (Tstar : Set (threeStar J')) := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    rw [← hy]
    exact himage
  have hyT : y ∈ (Qbar : Subgroup (threeStar J')) := by
    refine mem_of_isPGroup_of_mem_normalizer_sylow hyP ?_
    change y ∈ Subgroup.normalizer ((Qbar : Subgroup (threeStar J')) : Set (threeStar J'))
    rw [hQbar]
    exact hyN
  have hyTmap : y ∈ Tstar := by
    change y ∈ (Tstar : Set (threeStar J'))
    rw [← hQbar]
    exact hyT
  obtain ⟨x, hxT, hxπ⟩ := Subgroup.mem_map.mp hyTmap
  exact ⟨(x : G), Subgroup.mem_subgroupOf.mp hxT,
    mem_starCentralizer_of_mem_map_sylow hT hJN hxT hxπ hy⟩

private theorem exists_conj_jStarAct_of_isA6Type {M N J' : Subgroup G} {e : G}
    (hJ' : IsKComp M N J') (hJN : e ∈ Subgroup.normalizer (J' : Set G))
    (he3 : e ^ 3 = 1) (hA6 : IsA6Type (threeStar J')) :
    ∃ y : threeStar J', jStarAct J' ⟨e, hJN⟩ = MulAut.conj y := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨eA6⟩ := hA6
  let ᾱ : MulAut (threeStar J' ⧸ Subgroup.center (threeStar J')) := jBarAct J' ⟨e, hJN⟩
  let β : MulAut (alternatingGroup (Fin 6)) := (MulAut.congr eA6) ᾱ
  have hᾱ : ᾱ ^ 3 = 1 := by
    change (jBarAct J' ⟨e, hJN⟩) ^ 3 = 1
    rw [← map_pow, show (⟨e, hJN⟩ : ↥(Subgroup.normalizer (J' : Set G))) ^ 3 = 1
      from Subtype.ext he3, map_one]
  have hβ : β ^ 3 = 1 := by
    rw [show β = (MulAut.congr eA6) ᾱ from rfl, ← map_pow, hᾱ, map_one]
  obtain ⟨a, ha⟩ := CFSG.ClassicalInvolution.Sp62Rec.exists_conj_eq_of_pow_eq_one_of_odd
    (m := 3) (by norm_num) hβ
  have h1 : (MulAut.congr eA6).symm (MulAut.conj a) = ᾱ := by
    rw [ha, show β = (MulAut.congr eA6) ᾱ from rfl, MulEquiv.symm_apply_apply]
  have hbar : CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom
      (threeStar J') (jStarAct J' ⟨e, hJN⟩) = MulAut.conj (eA6.symm a) := by
    rw [show CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom
        (threeStar J') (jStarAct J' ⟨e, hJN⟩) = ᾱ from rfl, ← h1,
      mulAut_congr_symm_conj]
  obtain ⟨y, -, hy⟩ := exists_conj_of_centerQuotient_eq_conj hJ'.isQuasisimple.1 hbar
  exact ⟨y, hy⟩

private theorem jStarAct_eq_conj_of_commutator_le {J' : Subgroup G} {e k : G}
    (heN : e ∈ Subgroup.normalizer (J' : Set G)) (hk : k ∈ J')
    (hcomm : ∀ y ∈ J', e * y * e⁻¹ * (k * y * k⁻¹)⁻¹ ∈
      (CFSG.pPrimeCore 3 ↥J').map J'.subtype) :
    jStarAct J' ⟨e, heN⟩ = MulAut.conj
      (QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J') ⟨k, hk⟩) := by
  ext w
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (CFSG.pPrimeCore 3 ↥J') w
  rw [jStarAct_apply_mk, MulAut.conj_apply]
  have hmemB : k * (y : G) * k⁻¹ ∈ J' :=
    J'.mul_mem (J'.mul_mem hk y.2) (J'.inv_mem hk)
  have hmemA : e * (y : G) * e⁻¹ ∈ J' :=
    (Subgroup.mem_normalizer_iff.mp heN (y : G)).mp y.2
  have hB : QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J') ⟨k, hk⟩ *
      QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J') y *
      (QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J') ⟨k, hk⟩)⁻¹ =
      QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J') ⟨k * (y : G) * k⁻¹, hmemB⟩ := by
    simp only [← map_mul, ← map_inv]
    rfl
  rw [hB]
  have hmem : (⟨e * (y : G) * e⁻¹, hmemA⟩ : ↥J') *
      (⟨k * (y : G) * k⁻¹, hmemB⟩ : ↥J')⁻¹ ∈ CFSG.pPrimeCore 3 ↥J' := by
    rw [← Subgroup.mem_map_iff_mem J'.subtype_injective]
    have hc := hcomm (y : G) y.2
    have hc' : J'.subtype ((⟨e * (y : G) * e⁻¹, hmemA⟩ : ↥J') *
        (⟨k * (y : G) * k⁻¹, hmemB⟩ : ↥J')⁻¹) =
        (e * (y : G) * e⁻¹ * (k * (y : G) * k⁻¹)⁻¹) := rfl
    rw [hc']
    exact hc
  have hq : QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J')
      ((⟨e * (y : G) * e⁻¹, hmemA⟩ : ↥J') *
        (⟨k * (y : G) * k⁻¹, hmemB⟩ : ↥J')⁻¹) = 1 :=
    (QuotientGroup.eq_one_iff _).mpr hmem
  rw [map_mul, map_inv] at hq
  exact mul_inv_eq_one.mp hq

theorem gammaClBelow_le_of_rankThreeGamma_le {M E : Subgroup G}
    (hE : CFSG.Open.IsElemAbelian 3 E) (hcard : Nat.card E = 3 ^ 2)
    (hΓ : CFSG.Open.rankThreeGamma 1 3 E ≤ M) (Y : Subgroup G) :
    CFSG.HardMathSupport.Solomon.UniquenessMaximal.gammaClBelow E Y ≤ M := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hrankE : CFSG.Open.pRank 3 E = 2 :=
    CFSG.HardMathSupport.Solomon.Coordinator.i271_pRank_eq Nat.prime_three hE hcard
  unfold CFSG.HardMathSupport.Solomon.UniquenessMaximal.gammaClBelow
  refine iSup₂_le fun E' hE' => ?_
  have h1 : 1 ≤ CFSG.Open.pRank 3 E' := by
    have h2 := hE'.2
    rw [CFSG.HardMathSupport.Solomon.Coordinator.i271h_pRank_coe 3 E,
      CFSG.HardMathSupport.Solomon.Coordinator.i271h_pRank_coe 3 E'] at h2
    rw [hrankE] at h2
    norm_num at h2
    exact h2
  have hEM : Y ⊓ Subgroup.centralizer (E' : Set G) ≤ M :=
    inf_le_right.trans ((Subgroup.centralizer_le_normalizer (E' : Set G)).trans
      ((CFSG.HardMathSupport.Solomon.Proving.normalizer_le_glbCore (p := 3) (k := 1)
        hE'.1 h1).trans (by simpa only [CFSG.Open.rankThreeGamma] using hΓ)))
  refine sup_le ?_ ?_
  · unfold CFSG.Open.GLAPPrimeCoreOf
    exact (Subgroup.map_subtype_le _).trans hEM
  · unfold CFSG.Open.GLAPLayer
    exact (sSup_le fun _ hK => hK.1).trans hEM

theorem HypCGen.exists_inner_mul_mem_starCentralizer
    (h : HypCGen G M 3 E N)
    (hLN : ¬ pLayerIn 3 N ≤ M) {J' T : Subgroup G} (hJ' : IsKComp M N J')
    (htype : IsSL34Star J' ∨ Is3A6Star J')
    (hEJ : E ≤ Subgroup.normalizer (J' : Set G))
    (hT : CFSG.ABGLocalTools.IsSylowOf 3 T J')
    (hET : E ≤ Subgroup.normalizer (T : Set G)) {e : G} (he : e ∈ E) :
    ∃ x ∈ T, x⁻¹ * e ∈ starCentralizer J' := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have he3 : e ^ 3 = 1 := h.elem.2 e he
  have heJN : e ∈ Subgroup.normalizer (J' : Set G) := hEJ he
  have heTN : e ∈ Subgroup.normalizer (T : Set G) := hET he
  have hZ : Nat.card (Subgroup.center (threeStar J')) = 3 :=
    htype.elim (fun hSL => hSL.2) (fun hA6 => hA6.2)
  rcases htype with hSL | hA6
  · have hDM : (CFSG.pPrimeCore 3 ↥J').map J'.subtype ≤ M :=
      pPrimeCore_map_le_of_isKComp h hJ'
    have hcover : IsLThreeFour (threeStar J') ∨ IsSLThreeFour (threeStar J') :=
      isLThreeFour_or_isSLThreeFour_of_isL34Type hJ'.isQuasisimple
        (CFSG.pPrimeCore_quotient_eq_bot Nat.prime_three) hSL.1
    have hbar : IsLThreeFour (↥J' ⧸ GLAPPrimeCore 3 ↥J') ∨
        IsSLThreeFour (↥J' ⧸ GLAPPrimeCore 3 ↥J') := hcover
    have hGLA : GLAPComponent 3 N J' :=
      (CFSG.HardMathSupport.Solomon.Coordinator.i183_glaPComponent_iff_isPComponent
        Nat.prime_three).2 hJ'.isPComponentIn
    rcases CFSG.HardMathSupport.Solomon.UniquenessMaximal.input23_20_proved
      G N J' E hGLA hbar h.E_le_H h.elem hEJ with hle | ⟨hinn, -⟩
    · refine absurd (hle.trans (sup_le
          (gammaClBelow_le_of_rankThreeGamma_le h.elem h.card h.gamma J') ?_))
        (IsKComp.not_le_M hJ' hLN)
      simpa [CFSG.Open.GLAPPrimeCoreOf, CFSG.Open.GLAPPrimeCore] using hDM
    · obtain ⟨k, hk, hkcomm⟩ := hinn e he
      have hy : jStarAct J' ⟨e, heJN⟩ = MulAut.conj
          (QuotientGroup.mk' (CFSG.pPrimeCore 3 ↥J') ⟨k, hk⟩) := by
        refine jStarAct_eq_conj_of_commutator_le heJN hk (fun y hyJ => ?_)
        simpa only [CFSG.Open.GLAPPrimeCoreOf, CFSG.Open.GLAPPrimeCore] using hkcomm y hyJ
      exact exists_mem_sylow_of_jStarAct_eq_conj hT heJN heTN he3 hZ hy
  · obtain ⟨y, hy⟩ := exists_conj_jStarAct_of_isA6Type hJ' heJN he3 hA6.1
    exact exists_mem_sylow_of_jStarAct_eq_conj hT heJN heTN he3 hZ hy

