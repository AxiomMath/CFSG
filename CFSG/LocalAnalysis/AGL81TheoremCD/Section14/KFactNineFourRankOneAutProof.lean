theorem kFactNineFourRankOneAut_holds :
    KFactNineFourRankOneAut := by
  intro p hp h5 F _ _ hlist hrank
  obtain ⟨-, i, hi, ⟨e⟩⟩ := hlist
  cases i with
  | cyclic _ _ => exact hi.elim
  | alternating n _ =>
    rcases hi with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · omega
    · exact absurd (altTen e) (by omega)
  | sporadic s =>
    rcases hi with ⟨rfl, -⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · omega
    · exact absurd (of_carrier_noncomm (s := .McL) Nat.prime_five (by norm_num)
        CFSG.Sporadic.Bridge.McL.nonempty_mulEquiv
        CFSG.RankThree.PartOne.CTP.hasNoncommPair_McL e) (by omega)
    · exact absurd (sporEleven e) (by omega)
  | lie d =>
    rcases hi with ⟨q, hqp, h2, hd⟩ | ⟨q, hqp, hd⟩ | ⟨rfl, m, hm⟩ |
      ⟨rfl, ⟨q, hq2, hq3, hd⟩ | ⟨q, hq2, hq2', hd⟩⟩ | ⟨rfl, hd | hd⟩
    · exact absurd (linTwo hqp h2 hd e) (by omega)
    · exact absurd (unitary hqp hd e) (by omega)
    · omega
    · omega
    · omega
    ·
      obtain ⟨d1, hv⟩ := d
      obtain rfl : d1 = .suzuki 2 := hd
      have hSz : CFSG.LocalAnalysis.RankThreeTheoremC.Generic41Spor.IsSz32Type 5 F :=
        ⟨rfl, hv, ⟨e⟩⟩
      have hOut : Nat.card (Outer F) = 5 :=
        CFSG.LocalAnalysis.RankThreeTheoremC.Generic41Spor.sz32_outer F hSz
      have hcardF : Nat.card F = 32537600 :=
        (CFSG.RankThree.PartOne.K159.SzAbs.szSylow_of_isoLie hSz.2).card
      have hinner_dvd : Nat.card (inner F) ∣ Nat.card F :=
        Subgroup.card_dvd_of_surjective (f := (MulAut.conj : F →* MulAut F).rangeRestrict)
          (MonoidHom.rangeRestrict_surjective _)
      have hprod : Nat.card (inner F) * Nat.card (Outer F) = Nat.card (MulAut F) := by
        have := Subgroup.card_eq_card_quotient_mul_card_subgroup (inner F)
        rw [this, mul_comm]
      have h3inner : ¬ 3 ∣ Nat.card (inner F) := by
        intro h3
        have h' := h3.trans (hcardF ▸ hinner_dvd)
        norm_num at h'
      intro h3
      rw [← hprod, hOut] at h3
      rcases Nat.prime_three.dvd_mul.mp h3 with h3 | h3
      · exact h3inner h3
      · norm_num at h3
    · exact absurd (titsFive hd e) (by omega)

end CFSG.LocalAnalysis.AGL81TheoremCD.Section14
