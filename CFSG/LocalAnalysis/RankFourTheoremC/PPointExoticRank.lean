theorem card_le_pow_of_pRank_le {G : Type*} [Group G] [Finite G] {p a : ℕ} (hp : p.Prime)
    (hG : CFSG.Open.pRank p (⊤ : Subgroup G) ≤ a) {B : Subgroup G} (hB : IsElemAbelian p B) :
    Nat.card B ≤ p ^ a := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hpg : IsPGroup p B := fun x => ⟨1, Subtype.ext (by simpa using hB.2 x x.2)⟩
  obtain ⟨k, hk⟩ := IsPGroup.iff_card.1 hpg
  have hkB : k ≤ CFSG.Open.pRank p (⊤ : Subgroup G) :=
    CFSG.SectionRank.le_pRank hp.one_lt le_top hB hk
  rw [hk]
  exact Nat.pow_le_pow_right hp.pos (hkB.trans hG)

theorem pRank_le_one_of_sylow_isCyclic {E : Type} [Group E] [Finite E] {p : ℕ} (hp : p.Prime)
    (hcyc : ∀ R : Sylow p E, IsCyclic (R : Subgroup E)) :
    CFSG.Open.pRank p (⊤ : Subgroup E) ≤ 1 := by
  haveI : Fact p.Prime := ⟨hp⟩
  refine CFSG.SectionRank.pRank_le hp.one_lt fun B _ hB => ?_
  have hpg : IsPGroup p B := fun x => ⟨1, Subtype.ext (by simpa using hB.2 x x.2)⟩
  obtain ⟨R, hBR⟩ := hpg.exists_le_sylow
  haveI := hcyc R
  have hexp : Monoid.exponent (B.subgroupOf (R : Subgroup E)) ∣ p := by
    refine Monoid.exponent_dvd_of_forall_pow_eq_one fun g => ?_
    refine Subtype.ext (Subtype.ext ?_)
    have hg : ((g : (R : Subgroup E)) : E) ∈ B := Subgroup.mem_subgroupOf.1 g.2
    simpa using hB.2 _ hg
  have hcard : Nat.card (B.subgroupOf (R : Subgroup E)) = Nat.card B :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hBR).toEquiv
  have hdvd : Nat.card B ∣ p := by
    rw [← hcard, ← IsCyclic.exponent_eq_card]
    exact hexp
  rw [pow_one]
  exact Nat.le_of_dvd hp.pos hdvd

theorem card_le_pow_of_mulAut {K : Type} [Group K] [Finite K] {p a : ℕ} (hp : p.Prime)
    (hZ : Subgroup.center K = ⊥) (hK : CFSG.Open.pRank p (⊤ : Subgroup K) ≤ a)
    (h0 : CFSG.Open.pRank p (⊤ : Subgroup (Outer K)) = 0) {B : Subgroup (MulAut K)}
    (hB : IsElemAbelian p B) : Nat.card B ≤ p ^ a := by
  have : Finite (MulAut K) := MulEquiv.finite_left
  refine card_le_pow_of_pRank_le hp ?_ hB
  have h1 := GL83.I713.pRank_mulAut_le hp hZ
  omega

theorem card_le_pow_of_mulAut_add {K : Type} [Group K] [Finite K] {p a b : ℕ} (hp : p.Prime)
    (hZ : Subgroup.center K = ⊥) (hK : CFSG.Open.pRank p (⊤ : Subgroup K) ≤ a)
    (hO : CFSG.Open.pRank p (⊤ : Subgroup (Outer K)) ≤ b) {B : Subgroup (MulAut K)}
    (hB : IsElemAbelian p B) : Nat.card B ≤ p ^ (a + b) := by
  have : Finite (MulAut K) := MulEquiv.finite_left
  refine card_le_pow_of_pRank_le hp ?_ hB
  have h1 := GL83.I713.pRank_mulAut_le hp hZ
  omega

theorem not_prime_of_two_dvd {N : ℕ} (h2 : 2 ∣ N) (hN : 2 < N) : ¬ N.Prime := fun hp => by
  rcases hp.eq_one_or_self_of_dvd 2 h2 with h | h <;> omega

theorem center_eq_bot_of_simple_of_not_prime {K : Type} [Group K] [Finite K] [IsSimpleGroup K]
    (hK : ¬ (Nat.card K).Prime) : Subgroup.center K = ⊥ := by
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center K) with h | h
  · exact h
  · exfalso
    have hcomm : ∀ a b : K, a * b = b * a := fun a b => by
      have hb : b ∈ Subgroup.center K := h ▸ Subgroup.mem_top b
      exact Subgroup.mem_center_iff.mp hb a
    haveI : IsMulCommutative K := ⟨⟨fun a b => hcomm a b⟩⟩
    exact hK ((Group.is_simple_iff_prime_card (α := K)).mp inferInstance)

theorem autRankTwoAt_of_hasNoncommPair {K H : Type} [Group K] [Finite K] [Group H]
    [IsSimpleGroup H] {p : ℕ} (hp : p.Prime) (e : K ≃* H) (hK : ¬ (Nat.card K).Prime)
    (h4 : ¬ p ^ 4 ∣ Nat.card K) (hN : CFSG.RankThree.PartOne.StrongP.HasNoncommPair p H)
    (h0 : CFSG.Open.pRank p (⊤ : Subgroup (Outer K)) = 0) {B : Subgroup (MulAut K)}
    (hB : IsElemAbelian p B) : Nat.card B ≤ p ^ 2 := by
  haveI : IsSimpleGroup K := e.isSimpleGroup
  have hZ : Subgroup.center K = ⊥ := center_eq_bot_of_simple_of_not_prime hK
  have hN' : CFSG.RankThree.PartOne.StrongP.HasNoncommPair p K :=
    hN.map e.symm.toMonoidHom e.symm.injective
  have hK2 : CFSG.Open.pRank p (⊤ : Subgroup K) ≤ 2 :=
    CFSG.SectionRank.pRank_le hp.one_lt fun E _ hE =>
      PPointP.card_le_sq_of_hasNoncommPair hp h4 hN' hE
  exact card_le_pow_of_mulAut hp hZ hK2 h0 hB

theorem autRankTwoAt_alt (h : 5 ≤ 2 * 5) : AutRankTwoAt 5 (.alternating (2 * 5) h) := by
  intro K _ _ hK B hB
  obtain ⟨e⟩ := hK
  have e' : K ≃* alternatingGroup (Fin (2 * 5)) := e
  have hcard : Nat.card K = 1814400 := by
    rw [Nat.card_congr e'.toEquiv, Nat.card_eq_fintype_card, card_alternatingGroup,
      Fintype.card_fin]
    norm_num [Nat.factorial]
  haveI : IsSimpleGroup (alternatingGroup (Fin (2 * 5))) :=
    alternatingGroup.isSimpleGroup (by simp)
  haveI : IsSimpleGroup K := e'.isSimpleGroup
  have hZ : Subgroup.center K = ⊥ :=
    center_eq_bot_of_simple_of_not_prime
      (not_prime_of_two_dvd (by rw [hcard]; norm_num) (by rw [hcard]; norm_num))
  have hnot : ¬ 5 ^ 3 ∣ Nat.card K := by rw [hcard]; norm_num
  have hK2 : CFSG.Open.pRank 5 (⊤ : Subgroup K) ≤ 2 :=
    CFSG.SectionRank.pRank_le (by norm_num) fun E _ hE =>
      PPointP.card_le_sq_of_not_pow_three_dvd Nat.prime_five hnot hE
  have hO : ¬ 5 ∣ Nat.card (Outer K) := by
    rw [CFSG.RankThree.PartOne.card_outer_eq_of_mulEquiv e']
    exact CFSG.RankThree.PartOne.not_dvd_outer_alternating Nat.prime_five (by norm_num)
      (by norm_num)
  have h0 : CFSG.Open.pRank 5 (⊤ : Subgroup (Outer K)) = 0 :=
    GL83.I713.pRank_top_eq_zero_of_not_dvd Nat.prime_five hO
  exact card_le_pow_of_mulAut Nat.prime_five hZ hK2 h0 hB

theorem autRankTwoAt_mcl :
    AutRankTwoAt 5 (.sporadic .McL) := by
  intro K _ _ hK B hB
  obtain ⟨e⟩ := hK
  obtain ⟨b⟩ := CFSG.Sporadic.Bridge.McL.nonempty_mulEquiv
  obtain ⟨eK⟩ : Nonempty (K ≃* Blueprint.NativeSporadic.Carrier .McL) := ⟨e.trans b.symm⟩
  haveI : IsSimpleGroup (Blueprint.NativeSporadic.Carrier .McL) :=
    CFSG.Sporadic.McL.isSimpleGroup_McL
  have hcard : Nat.card K = 898128000 :=
    (Nat.card_congr eK.toEquiv).trans CFSG.Sporadic.McL.card_McL
  have hK' : ¬ (Nat.card K).Prime :=
    not_prime_of_two_dvd (by rw [hcard]; norm_num) (by rw [hcard]; norm_num)
  have h4 : ¬ 5 ^ 4 ∣ Nat.card K := by rw [hcard]; norm_num
  have hN : CFSG.RankThree.PartOne.StrongP.HasNoncommPair 5
      (Blueprint.NativeSporadic.Carrier .McL) :=
    CFSG.RankThree.PartOne.CTP.hasNoncommPair_McL
  have hO : ¬ 5 ∣ Nat.card (Outer K) :=
    CFSG.LocalAnalysis.RankThreeTheoremC.not_dvd_card_outer_McL e Nat.prime_five (by norm_num)
  have h0 : CFSG.Open.pRank 5 (⊤ : Subgroup (Outer K)) = 0 :=
    GL83.I713.pRank_top_eq_zero_of_not_dvd Nat.prime_five hO
  exact autRankTwoAt_of_hasNoncommPair Nat.prime_five eK hK' h4 hN h0 hB

theorem autRankTwoAt_jFour :
    AutRankTwoAt 11 (.sporadic .J4) := by
  intro K _ _ hK B hB
  obtain ⟨e⟩ := hK
  obtain ⟨b⟩ := CFSG.Sporadic.Bridge.J4.nonempty_mulEquiv
  obtain ⟨eK⟩ : Nonempty (K ≃* Blueprint.NativeSporadic.Carrier .J4) := ⟨e.trans b.symm⟩
  haveI : IsSimpleGroup (Blueprint.NativeSporadic.Carrier .J4) :=
    CFSG.Sporadic.J4Schreier.FAM_J4_certified_simplicity.2.1
  have hcard : Nat.card K = 86775571046077562880 :=
    (Nat.card_congr eK.toEquiv).trans CFSG.Sporadic.J4.card_J4
  have hK' : ¬ (Nat.card K).Prime :=
    not_prime_of_two_dvd (by rw [hcard]; norm_num) (by rw [hcard]; norm_num)
  have h4 : ¬ 11 ^ 4 ∣ Nat.card K := by rw [hcard]; norm_num
  have hN : CFSG.RankThree.PartOne.StrongP.HasNoncommPair 11
      (Blueprint.NativeSporadic.Carrier .J4) :=
    CFSG.RankThree.PartOne.CTP.hasNoncommPair_J4
  have hO1 : Nat.card (Outer K) = 1 :=
    (CFSG.RankThree.PartOne.card_outer_eq_of_mulEquiv eK).trans
      CFSG.AGLEmbedding.card_outer_J4
  have h0 : CFSG.Open.pRank 11 (⊤ : Subgroup (Outer K)) = 0 :=
    GL83.I713.pRank_top_eq_zero_of_not_dvd (by norm_num) (by rw [hO1]; norm_num)
  exact autRankTwoAt_of_hasNoncommPair (by norm_num) eK hK' h4 hN h0 hB

theorem autRankTwoAt_tits
    {d : TauCeti.ValidLieTypeIndex} (hd : d.1 = .tits) : AutRankTwoAt 5 (.lie d) := by
  obtain ⟨d1, hv⟩ := d
  have hd' : d1 = TauCeti.LieTypeIndex.tits := hd
  subst hd'
  intro K _ _ hK B hB
  obtain ⟨eK⟩ := hK
  have hR := CFSG.HardMathSupport.Timmesfeld.DefChar.lot_reeTitsModel_tits_of_index hv eK
  obtain ⟨eT⟩ := CFSG.Sporadic.Schreier.Tits.titsModelEquiv K 2 1 hR
  haveI : IsSimpleGroup K := by
    haveI := CFSG.Sporadic.Schreier.Tits.titsD_simple
    exact eT.isSimpleGroup
  have hcard : Nat.card K = 17971200 :=
    (Nat.card_congr eT.toEquiv).trans CFSG.Sporadic.Schreier.Tits.card_titsD
  have hK' : ¬ (Nat.card K).Prime :=
    not_prime_of_two_dvd (by rw [hcard]; norm_num) (by rw [hcard]; norm_num)
  have hZ : Subgroup.center K = ⊥ := center_eq_bot_of_simple_of_not_prime hK'
  have hnot : ¬ 5 ^ 3 ∣ Nat.card K := by rw [hcard]; norm_num
  have hK2 : CFSG.Open.pRank 5 (⊤ : Subgroup K) ≤ 2 :=
    CFSG.SectionRank.pRank_le (by norm_num) fun E _ hE =>
      PPointP.card_le_sq_of_not_pow_three_dvd Nat.prime_five hnot hE
  have hO : Nat.card (Outer K) = 2 :=
    CFSG.LocalAnalysis.RankThreeTheoremC.card_outer_of_tits ⟨hv, ⟨eK⟩⟩
  have h0 : CFSG.Open.pRank 5 (⊤ : Subgroup (Outer K)) = 0 :=
    GL83.I713.pRank_top_eq_zero_of_not_dvd Nat.prime_five (by rw [hO]; norm_num)
  exact card_le_pow_of_mulAut Nat.prime_five hZ hK2 h0 hB

open CFSG.SignalizerFunctorTheorem.CatalogBridge in
theorem autRankTwoAt_suzuki
    {d : TauCeti.ValidLieTypeIndex}
    (hd : d.1 = .suzuki 2) : AutRankTwoAt 5 (.lie d) := by
  obtain ⟨d1, hv⟩ := d
  have hd' : d1 = TauCeti.LieTypeIndex.suzuki 2 := hd
  subst hd'
  intro K _ _ hK B hB
  obtain ⟨eK⟩ := hK
  have hSM : CFSG.Blueprint.SuzukiModel K 2 5 :=
    CFSG.CGT.Timmesfeld75.suzukiModel_of_mulEquiv eK.symm
      (CFSG.RankThree.PartTwo.Sec4.Census.suzukiModel_of_index 2 hv)
  have hOut := GL83.I713.outClauseFor_suzuki hSM
  obtain ⟨-, a, ha, F, hFld, hFfin, hf, hF, ⟨eF⟩⟩ := hSM
  have ha2 : a = 2 := by omega
  subst ha2
  obtain ⟨hsimple, hnonab, -⟩ :=
    isSimpleGroup_and_not_isSolvable_of_equiv_suzukiGroup (by norm_num) hF eF
  haveI : IsSimpleGroup K := hsimple
  have hZ : Subgroup.center K = ⊥ := GL83.I713.center_eq_bot_of_simple hnonab
  have eKS : K ≃* CFSG.BenderSuzuki.MatrixGroups.SuzukiMatrixGroup 2 :=
    eK.trans (CFSG.BenderSuzuki.Catalog.groupEquivSuzukiMatrixGroup hv)
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  have hK1 : CFSG.Open.pRank 5 (⊤ : Subgroup K) ≤ 1 :=
    pRank_le_one_of_sylow_isCyclic Nat.prime_five fun R =>
      CFSG.BenderSuzuki.lemma114_suzuki_oddSylow_isCyclic_of_equiv eKS 5 (by norm_num) R
  have hO1 : CFSG.Open.pRank 5 (⊤ : Subgroup (Outer K)) ≤ 1 :=
    hOut 5 Nat.prime_five (by norm_num) hK1
  exact card_le_pow_of_mulAut_add Nat.prime_five hZ hK1 hO1 hB

theorem autRankTwoAt_of_exoticFive
    {p : ℕ} {i : TauCeti.CFSGIndex} (h : ExoticFive p i) : AutRankTwoAt p i := by
  cases h with
  | alt h hp => subst hp; exact autRankTwoAt_alt h
  | @suzuki d hp hd => subst hp; exact autRankTwoAt_suzuki hd
  | @tits d hp hd => subst hp; exact autRankTwoAt_tits hd
  | mcl hp => subst hp; exact autRankTwoAt_mcl
  | jFour hp => subst hp; exact autRankTwoAt_jFour

