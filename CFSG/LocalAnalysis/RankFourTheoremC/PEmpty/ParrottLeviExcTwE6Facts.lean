theorem fin_four_cases (j : Fin (CFSG.Blueprint.Chevalley.Tag.rank .F4)) :
    j = nf 0 ∨ j = nf 1 ∨ j = nf 2 ∨ j = nf 3 := by
  obtain ⟨j, hj⟩ := j
  have hj4 : j < 4 := hj
  simp only [Fin.ext_iff]
  omega

theorem eq_singleton_of_isIndecomposable {r : ℕ} {A : Matrix (Fin r) (Fin r) ℤ}
    {C : Finset (Fin r)}
    (hA : IsIndecomposable (A.submatrix (C.orderEmbOfFin rfl) (C.orderEmbOfFin rfl)))
    {t : Fin r} (ht : t ∈ C) (h0 : ∀ j ∈ C, j ≠ t → A t j = 0) : C = {t} := by
  have hrange : ∀ c ∈ C, ∃ i, C.orderEmbOfFin rfl i = c := fun c hc => by
    have : c ∈ Set.range (C.orderEmbOfFin rfl) := by
      rw [Finset.range_orderEmbOfFin]
      exact hc
    exact this
  refine Finset.Subset.antisymm (fun c hc => ?_) (Finset.singleton_subset_iff.2 ht)
  rcases isIndecomposable_iff.1 hA (Finset.univ.filter fun i => C.orderEmbOfFin rfl i = t)
      (fun i hi j hj => by
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi hj
        rw [Matrix.submatrix_apply, hi]
        exact h0 _ (C.orderEmbOfFin_mem rfl j) hj) with h | h
  · obtain ⟨i, rfl⟩ := hrange t ht
    have hi : i ∈ Finset.univ.filter fun i' => C.orderEmbOfFin rfl i' = C.orderEmbOfFin rfl i :=
      by simp
    rw [h] at hi
    exact absurd hi (Finset.notMem_empty i)
  · obtain ⟨i, rfl⟩ := hrange c hc
    have hi : i ∈ Finset.univ.filter fun i => C.orderEmbOfFin rfl i = t := by
      rw [h]
      exact Finset.mem_univ i
    simpa using hi

theorem not_dvd_six {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p) : ¬ p ∣ 6 := by
  intro h
  have h6 := Nat.le_of_dvd (by norm_num) h
  interval_cases p
  · omega
  · norm_num at hp

end PB4


variable {k : Type} [Field k] (θ : k →+* k)

theorem isPerfect_levi_twistedE6 [Finite k] [CharP k 2] (hθ : ∀ c, θ (θ c) = c) {q : ℕ}
    (hk : Nat.card k = q ^ 2) (hθq : ∀ c, θ c = c ^ q) (hq : q = 2 ∨ 4 ≤ q)
    (C : Finset (Fin (twistedDatum k θ).rank)) (hC : C.Nonempty)
    (hA : IsIndecomposable
      ((twistedDatum k θ).cartan.submatrix (C.orderEmbOfFin rfl) (C.orderEmbOfFin rfl)))
    {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p)
    (hdvd : p ∣ Nat.card (levi (twistedDatum k θ).rootGroup C)) :
    Group.IsPerfect ↥(levi (twistedDatum k θ).rootGroup C) := by
  have hct := twistedDatum_isCTGroupDatum θ hθ (iSup_twistedDatum_rootGroup θ hθ)
  have h4 : 4 ≤ Nat.card k := by
    rw [hk]
    rcases hq with rfl | hq
    · norm_num
    · nlinarith
  have hSL := CFSG.ClassicalModels.specialLinear_isPerfect_two_of_four_le_card k h4
  have hfix : Nat.card (fixedField θ) = q := card_fixedField θ hk hθq
  have hsing : q = 2 → ∀ i : Fin (twistedDatum k θ).rank, (i = nf 0 ∨ i = nf 1) → C = {i} →
      False := by
    rintro rfl i hi rfl
    rw [levi_singleton, card_rankOne_fixed θ hfix hi] at hdvd
    exact PB4.not_dvd_six hp hp5 hdvd
  refine BQ.isPerfect_levi_of_le_commutator rfl hct C fun j hj => ?_
  rcases PB4.fin_four_cases j with rfl | rfl | rfl | rfl
  · rcases hq with rfl | hq4
    · by_cases h1 : nf 1 ∈ C
      · exact rootGroup_long_le_commutator_levi_of_long θ hθ hj h1 (Or.inl rfl)
      refine (hsing rfl (nf 0) (Or.inl rfl)
        (PB4.eq_singleton_of_isIndecomposable hA hj fun j hjC hj0 => ?_)).elim
      rcases PB4.fin_four_cases j with rfl | rfl | rfl | rfl
      · exact absurd rfl hj0
      · exact absurd hjC h1
      · rfl
      · rfl
    · exact rootGroup_long_le_commutator_levi θ
        (CFSG.ClassicalModels.specialLinear_isPerfect_two_of_four_le_card _ (hfix ▸ hq4)) hj
        (Or.inl rfl)
  · rcases hq with rfl | hq4
    · by_cases h0 : nf 0 ∈ C
      · exact rootGroup_long_le_commutator_levi_of_long θ hθ h0 hj (Or.inr rfl)
      by_cases h2 : nf 2 ∈ C
      · exact rootGroup_one_le_commutator_levi_of_two θ hθ
          (fun c hc => exists_eq_add_of_fixed θ hk hθq hc) hj h2
      refine (hsing rfl (nf 1) (Or.inr rfl)
        (PB4.eq_singleton_of_isIndecomposable hA hj fun j hjC hj1 => ?_)).elim
      rcases PB4.fin_four_cases j with rfl | rfl | rfl | rfl
      · exact absurd hjC h0
      · exact absurd rfl hj1
      · exact absurd hjC h2
      · rfl
    · exact rootGroup_long_le_commutator_levi θ
        (CFSG.ClassicalModels.specialLinear_isPerfect_two_of_four_le_card _ (hfix ▸ hq4)) hj
        (Or.inr rfl)
  · exact rootGroup_short_le_commutator_levi θ hθ hSL hj (Or.inl rfl)
  · exact rootGroup_short_le_commutator_levi θ hθ hSL hj (Or.inr rfl)

end CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.ParrottLeviExc.TwE6
