theorem elemAbelian_card_eight_of_sylow {A : Type} [Group A] [Finite A] {L T : Subgroup A}
    (hT : CFSG.ABGLocalTools.IsSylowOf 2 T L)
    (h : ∀ Q : Sylow 2 ↥L, Nat.card (Q : Subgroup ↥L) = 8 ∧ IsMulCommutative (Q : Subgroup ↥L) ∧
      ∀ t ∈ (Q : Subgroup ↥L), t ^ 2 = 1) :
    IsElemAbelian 2 T ∧ Nat.card T = 8 := by
  obtain ⟨Q, hQ⟩ := hT.exists_sylow_eq_subgroupOf
  have hQ' := h Q
  rw [hQ] at hQ'
  obtain ⟨h8, hc, hsq⟩ := hQ'
  have hle : T ≤ L := hT.le
  refine ⟨⟨⟨⟨fun a b => ?_⟩⟩, fun x hx => ?_⟩, ?_⟩
  · have := hc.is_comm.comm (⟨⟨a.1, hle a.2⟩, a.2⟩ : ↥(T.subgroupOf L))
      ⟨⟨b.1, hle b.2⟩, b.2⟩
    exact Subtype.ext (congrArg (fun y : ↥(T.subgroupOf L) => ((y : ↥L) : A)) this)
  · have h1 := congrArg Subtype.val (hsq ⟨x, hle hx⟩ hx)
    simpa using h1
  · rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv.symm]
    exact h8

theorem exists_reeG2_of_isReeIndex {d : TauCeti.LieTypeIndex} (h : IsReeIndex d) :
    ∃ a, d = .reeG2 a := by
  cases d <;> first | exact ⟨_, rfl⟩ | exact False.elim h

section Ree


theorem kFactReeSylowTwo_holds : KFactReeSylowTwo := by
  intro A _ _ L E hsimp h hEsyl
  haveI := hsimp
  obtain ⟨i, hi, ⟨e⟩⟩ := h
  cases i with
  | lie d =>
    obtain ⟨d', hv⟩ := d
    obtain ⟨a, rfl⟩ := exists_reeG2_of_isReeIndex (show IsReeIndex d' from hi)
    obtain ⟨-, a', ha', hfa, hcard⟩ := CFSG.ClassicalInvolution.card_of_reeTitsModel_twistedG2
      (CFSG.RankThree.PartOne.CTP.reeTitsModel_reeG2 a ⟨hv, ⟨e⟩⟩)
    have hS := CFSG.Goldschmidt.GoldType.sylow_of_ree_or_j1 (K := ↥L)
      (Or.inl ⟨a', ha', by rw [hcard, hfa]⟩)
    exact elemAbelian_card_eight_of_sylow hEsyl fun Q => (hS Q).2
  | cyclic q hq => exact False.elim hi
  | alternating n hn => exact False.elim hi
  | sporadic s => exact False.elim hi

end Ree

section J1


theorem kFactJ1Sylow_holds : KFactJ1Sylow := by
  intro A _ _ L T hsimp e hT
  haveI := hsimp
  obtain ⟨e'⟩ := e
  obtain ⟨b⟩ := CFSG.RankThree.PartOne.TCB.nonempty_carrier_mulEquiv_group .J1
  have hJ : Nonempty (↥L ≃* CFSG.Open.goldschmidtJ1) :=
    CFSG.Open.goldschmidtJ1_iso_iff_native.mpr ⟨e'.trans b.symm⟩
  have hS := CFSG.Goldschmidt.GoldType.sylow_of_ree_or_j1 (K := ↥L) (Or.inr hJ)
  exact elemAbelian_card_eight_of_sylow hT fun Q => (hS Q).2

end J1

