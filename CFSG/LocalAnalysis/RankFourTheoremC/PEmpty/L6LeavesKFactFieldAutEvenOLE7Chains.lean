theorem olE7_parabolicSum_coat_eq (i : Fin Tag.E7.rank) (q : ℕ) :
    parabolicSum .E7 (maskSet .E7 (olE7Mask i)) q =
      ((olE7Fac i).map fun f => geomSum f.1 f.2 q).prod := by
  fin_cases i
  · have h := parabolicSum_eq_of_chainCheck q _ _ olE7Coat0_check
