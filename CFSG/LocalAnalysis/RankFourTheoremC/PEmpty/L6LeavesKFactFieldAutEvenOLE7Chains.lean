    exact h
  · have h := parabolicSum_eq_of_chainCheck q _ _ olE7Coat2_check
    rw [chain_prod_eq, chainFactors_olE7Coat2] at h
    exact h
  · have h := parabolicSum_eq_of_chainCheck q _ _ olE7Coat3_check
    rw [chain_prod_eq, chainFactors_olE7Coat3] at h
    exact h
  · have h := parabolicSum_eq_of_chainCheck q _ _ olE7Coat4_check
    rw [chain_prod_eq, chainFactors_olE7Coat4] at h
    exact h
  · have h := parabolicSum_eq_of_chainCheck q _ _ olE7Coat5_check
    rw [chain_prod_eq, chainFactors_olE7Coat5] at h
    exact h
  · have h := parabolicSum_eq_of_chainCheck q _ _ olE7Coat6_check
