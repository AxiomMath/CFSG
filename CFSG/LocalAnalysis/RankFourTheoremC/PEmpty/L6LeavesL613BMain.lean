variable {G : Type} [Group G] [Finite G]

theorem not_mem_rankThreePrimeCore {p : ℕ} [hp : Fact p.Prime] {Y : Subgroup G} {z : G}
    (hzord : orderOf z = p) : z ∉ rankThreePrimeCore p Y := by
  intro hzD
  have h1 : orderOf (⟨z, hzD⟩ : ↥(rankThreePrimeCore p Y)) ∣ Nat.card ↥(rankThreePrimeCore p Y) :=
    orderOf_dvd_natCard _
  rw [Subgroup.orderOf_mk, hzord] at h1
  exact hp.out.one_lt.ne' (Nat.Coprime.eq_one_of_dvd
    (CFSG.LocalAnalysis.RankThreeTheoremC.KFactProofs.Stroth.AlmostSimple.coprime_card_relPPrimeCore
      hp.out Y) h1)

theorem mem_rankThreePrimeCore_of_mem_pPrimeCore {p : ℕ} [hp : Fact p.Prime] {M Y : Subgroup G}
    (hYM : Y ≤ M) {y : G} (hy : y ∈ Y)
    (hyp : (⟨y, hYM hy⟩ : ↥M) ∈ CFSG.pPrimeCore p ↥M) : y ∈ rankThreePrimeCore p Y := by
  haveI : (CFSG.pPrimeCore p ↥M).Normal := CFSG.pPrimeCore_normal
  set K₁ : Subgroup ↥Y := (CFSG.pPrimeCore p ↥M).comap (Subgroup.inclusion hYM) with hK₁
  have hle : K₁.map Y.subtype ≤ rankThreePrimeCore p Y := by
    show K₁.map Y.subtype ≤ relPPrimeCore p Y
    refine le_sSup ?_
    refine ⟨by rintro _ ⟨k, -, rfl⟩; exact k.2, ?_, ?_⟩
    · show (Subgroup.comap Y.subtype (K₁.map Y.subtype)).Normal
      rw [Subgroup.comap_map_eq_self_of_injective Y.subtype_injective]
      exact Subgroup.Normal.comap inferInstance _
    · rw [Subgroup.card_map_of_injective Y.subtype_injective]
      have hdvd : Nat.card K₁ ∣ Nat.card (CFSG.pPrimeCore p ↥M) := by
        rw [← Subgroup.card_map_of_injective (Subgroup.inclusion_injective hYM)]
        refine Subgroup.card_dvd_of_le ?_
        rintro _ ⟨k, hk, rfl⟩
        exact hk
      exact Nat.Coprime.coprime_dvd_right hdvd CFSG.pPrimeCore_coprime_card
  have hmem : y ∈ K₁.map Y.subtype := ⟨⟨y, hy⟩, hyp, rfl⟩
  exact hle hmem

theorem exists_component_of_section {p : ℕ} [hp : Fact p.Prime] {M Y : Subgroup G} {z : G}
    (hYM : Y ≤ M) (hzY : z ∈ Y) (hzord : orderOf z = p)
    (hsec : S622IsSimpleSection Y (rankThreePrimeCore p Y))
    (hZ : ∀ C : CFSG.LocalCores.ComponentIndex (↥M ⧸ primeComplementCore (G := ↥M) p),
      Subgroup.center C.1 = ⊥)
    (hzL : ((⟨z, hYM hzY⟩ : ↥M) : ↥M ⧸ primeComplementCore (G := ↥M) p) ∈
      CFSG.layer (↥M ⧸ primeComplementCore (G := ↥M) p)) :
    ∃ C : CFSG.LocalCores.ComponentIndex (↥M ⧸ primeComplementCore (G := ↥M) p),
      (rankThreePrimeCore p Y).relIndex Y ∣ Nat.card C.1 := by
  classical
  haveI hYn : ((rankThreePrimeCore p Y).subgroupOf Y).Normal := hsec.2.1
  haveI hsimp : IsSimpleGroup (↥Y ⧸ (rankThreePrimeCore p Y).subgroupOf Y) :=
    L613.isSimpleGroup_quotient_of_section hsec
  let F : ↥Y →* (↥M ⧸ primeComplementCore (G := ↥M) p) :=
    (QuotientGroup.mk' (primeComplementCore (G := ↥M) p)).comp (Subgroup.inclusion hYM)
  have hker : F.ker ≤ (rankThreePrimeCore p Y).subgroupOf Y := by
    intro y hy
    have hy1 : (Subgroup.inclusion hYM y : ↥M) ∈ primeComplementCore (G := ↥M) p :=
      (QuotientGroup.eq_one_iff _).mp (MonoidHom.mem_ker.mp hy)
    rw [Subgroup.mem_subgroupOf]
    exact mem_rankThreePrimeCore_of_mem_pPrimeCore hYM y.2 hy1
  have hzD' : (⟨z, hzY⟩ : ↥Y) ∉ (rankThreePrimeCore p Y).subgroupOf Y := by
    rw [Subgroup.mem_subgroupOf]
    exact not_mem_rankThreePrimeCore hzord
  have hzL' : F ⟨z, hzY⟩ ∈ CFSG.layer (↥M ⧸ primeComplementCore (G := ↥M) p) := hzL
  obtain ⟨C, hC⟩ := card_dvd_component_of_simple_quotient hZ F
    ((rankThreePrimeCore p Y).subgroupOf Y) hsimp hker ⟨z, hzY⟩ hzD' hzL'
  exact ⟨C, hC⟩

end Coprime

