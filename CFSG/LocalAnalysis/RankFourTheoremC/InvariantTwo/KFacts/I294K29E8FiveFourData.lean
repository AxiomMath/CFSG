@[expose] def cinvNat : Fin 8 → Fin 8 → ℕ :=
  ![![4, 5, 7, 10, 8, 6, 4, 2], ![5, 8, 10, 15, 12, 9, 6, 3], ![7, 10, 14, 20, 16, 12, 8, 4],
    ![10, 15, 20, 30, 24, 18, 12, 6], ![8, 12, 16, 24, 20, 15, 10, 5],
    ![6, 9, 12, 18, 15, 12, 8, 4], ![4, 6, 8, 12, 10, 8, 6, 3], ![2, 3, 4, 6, 5, 4, 3, 2]]

@[expose] def normL (b : List ℕ) : ℕ :=
  (∑ j : Fin 8, ∑ k : Fin 8, cinvNat j k * b.getD j 0 * b.getD k 0) % 5

@[expose] def scaleL (lam : ℕ) (b : List ℕ) : List ℕ := b.map fun x => lam * x % 5

@[expose] def rows : List (List ℕ) := negCartanRowsP .E8 5

@[expose] def entryOK (e : Entry) : Bool :=
  (e.lam == 2 || e.lam == 3) && e.word.all (· < 8) && e.rep.length == 8 &&
    PrimeSteinNative.actL 5 rows e.word e.rep == scaleL e.lam e.rep &&
    e.basis.length == 3 && e.piv.length == 3 &&
    (List.range 3).all fun i =>
      (e.basis.getD i []).length == 8 &&
        PrimeSteinNative.actL 5 rows e.word (e.basis.getD i []) ==
          scaleL e.lam (e.basis.getD i []) &&
        (List.range 3).all fun j =>
          decide (e.piv.getD j 0 < 8) &&
            (e.basis.getD i []).getD (e.piv.getD j 0) 0 == if i = j then 1 else 0

@[expose] def entriesOK : Bool := entries.all entryOK

@[expose] def repCovered (r : List ℕ) : Bool :=
  normL r != 0 ||
    (entries.any (fun e => e.rep == r && e.lam == 2) &&
      entries.any (fun e => e.rep == r && e.lam == 3))

@[expose] def e8FiveFourCheck (_ : Unit := ()) : Bool :=
  entriesOK && kacRepsN.all repCovered

end CFSG.LocalAnalysis.RankFourTheoremC.E8FiveFour
