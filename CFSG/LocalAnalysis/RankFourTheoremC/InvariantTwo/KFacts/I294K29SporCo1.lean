theorem sporadicClassWitnessNative_Co1_five :
    ∀ (S : Type) [Group S] [Finite S],
      Nonempty (S ≃* CFSG.Blueprint.NativeSporadic.Carrier .Co1) →
      ∀ x : S, orderOf x = 5 → RankThreeWitness 5 x := by
  intro S _ _ ⟨e⟩ x hx
  have hG : Co1F.GOK := Certificates.certificate13670
  let f : S ≃* ↥CFSG.Sporadic.Co1Schreier.GA := e.trans CFSG.Sporadic.Co1Block.co1MatEquiv
  have hfx : orderOf (f x) = 5 := by rw [MulEquiv.orderOf_eq]; exact hx
  obtain ⟨c, a, hca⟩ := Co1F.fusion_exists hG (f x) hfx
  have hA : IsElemAbelian 5 (Co1F.A0 hG) := Co1F.A0_elemAbelian hG
  have hAc : Nat.card (Co1F.A0 hG) = 5 ^ 3 := by rw [Co1F.card_A0 hG]; norm_num
  have hmem : c * f x * c⁻¹ ∈ Co1F.A0 hG := by rw [hca]; exact ⟨_, rfl⟩
  refine rankThreeWitness_of_conj_mem (S := S) (T := ↥CFSG.Sporadic.Co1Schreier.GA) (p := 5)
    ?_ hA hAc c ?_
  · exact f
  · exact hmem

end CertificateInstances

