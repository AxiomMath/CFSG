namespace CFSG.LyonsUnitaryFour

inductive LyonsLabel
  | A1 | A2 | B1 | B2 | C1 | C2 | D1 | D2 | E1 | E2 | F | FReflected | G | GReflected
  | H | J | K | L | M | N | P | Q | R | S | T | U | V
  deriving DecidableEq, Repr

@[expose] def LyonsLabel.all : List LyonsLabel :=
  [.A1, .A2, .B1, .B2, .C1, .C2, .D1, .D2, .E1, .E2, .F, .FReflected, .G, .GReflected, .H, .J, .K,
    .L, .M, .N, .P, .Q, .R, .S, .T, .U, .V]

theorem LyonsLabel.mem_all (c : LyonsLabel) : c ∈ LyonsLabel.all := by
  cases c <;> decide

instance : Fintype LyonsLabel :=
  Fintype.ofList LyonsLabel.all LyonsLabel.mem_all

