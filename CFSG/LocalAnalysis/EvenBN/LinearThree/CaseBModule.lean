variable {S : Type*} [Group S]

theorem eq_id_or_eq_swap_of_diag [IsSimpleGroup S]
    (hZ : ∀ z : S, (∀ s : S, z * s = s * z) → z = 1) (Γ : S × S →* S × S)
    (hdiag : ∀ a, Γ (a, a) = (a, a)) (hswap : ∀ p, Γ p.swap = (Γ p).swap) :
    (∀ p, Γ p = p) ∨ (∀ p, Γ p = p.swap) := by
  set β : S →* S := (MonoidHom.fst S S).comp (Γ.comp (MonoidHom.inl S S)) with hβ
  set γ : S →* S := (MonoidHom.snd S S).comp (Γ.comp (MonoidHom.inl S S)) with hγ
  have hΓa1 : ∀ a, Γ (a, 1) = (β a, γ a) := fun a => rfl
  have hΓ1a : ∀ a, Γ (1, a) = (γ a, β a) := fun a => by
    have h := hswap (a, 1)
    rw [Prod.swap_prod_mk, hΓa1] at h
    rw [h, Prod.swap_prod_mk]
  have hsplit : ∀ p : S × S, p = (p.1, 1) * (1, p.2) := fun p => by
    ext <;> simp
  have hprod : ∀ a, β a * γ a = a := fun a => by
    have h := hdiag a
    have e : ((a, a) : S × S) = (a, 1) * (1, a) := by ext <;> simp
    rw [e, map_mul, hΓa1, hΓ1a] at h
    simpa using congrArg Prod.fst h
  have hcomm : ∀ a b, β a * γ b = γ b * β a := fun a b => by
    have h : ((a, 1) : S × S) * (1, b) = (1, b) * (a, 1) := by ext <;> simp
    have h' := congrArg Γ h
    rw [map_mul, map_mul, hΓa1, hΓ1a] at h'
    exact congrArg Prod.fst h'
  have hN : β.range.Normal := ⟨fun n hn s => by
    obtain ⟨a, rfl⟩ := hn
    refine ⟨s * a * s⁻¹, ?_⟩
    rw [map_mul, map_mul, map_inv]
    calc β s * β a * (β s)⁻¹ = β s * (β a * γ s) * (γ s)⁻¹ * (β s)⁻¹ := by group
      _ = β s * (γ s * β a) * (γ s)⁻¹ * (β s)⁻¹ := by rw [hcomm a s]
      _ = (β s * γ s) * β a * (β s * γ s)⁻¹ := by group
      _ = s * β a * s⁻¹ := by rw [hprod s]⟩
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal β.range with h | h
  · right
    have hβ1 : ∀ a, β a = 1 := fun a => by
      have : β a ∈ β.range := ⟨a, rfl⟩
      rwa [h, mem_bot] at this
    have hγ1 : ∀ a, γ a = a := fun a => by
      have := hprod a
      rwa [hβ1, one_mul] at this
    intro p
    have e := hsplit p
    rw [e, map_mul, hΓa1, hΓ1a, hβ1, hβ1, hγ1, hγ1]
    ext <;> simp
  · left
    have hγ1 : ∀ b, γ b = 1 := fun b => hZ _ fun s => by
      obtain ⟨a, rfl⟩ : s ∈ β.range := h ▸ mem_top s
      exact (hcomm a b).symm
    have hβ1 : ∀ a, β a = a := fun a => by
      have := hprod a
      rwa [hγ1, mul_one] at this
    intro p
    have e := hsplit p
    rw [e, map_mul, hΓa1, hΓ1a, hγ1, hγ1, hβ1, hβ1]

theorem eq_of_perfect_of_central {H : Type*} [Group H] (hH : commutator H = ⊤) (φ ψ : H →* S)
    (hc : ∀ h, (φ h)⁻¹ * ψ h ∈ center S) : φ = ψ := by
  let ε : H →* center S :=
    { toFun := fun h => ⟨(φ h)⁻¹ * ψ h, hc h⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun h₁ h₂ => Subtype.ext (by
        change (φ (h₁ * h₂))⁻¹ * ψ (h₁ * h₂) = (φ h₁)⁻¹ * ψ h₁ * ((φ h₂)⁻¹ * ψ h₂)
        have hz := mem_center_iff.mp (hc h₁) (φ h₂)⁻¹
        rw [map_mul, map_mul, _root_.mul_inv_rev]
        calc (φ h₂)⁻¹ * (φ h₁)⁻¹ * (ψ h₁ * ψ h₂) =
            ((φ h₂)⁻¹ * ((φ h₁)⁻¹ * ψ h₁)) * ψ h₂ := by group
          _ = ((φ h₁)⁻¹ * ψ h₁ * (φ h₂)⁻¹) * ψ h₂ := by rw [hz]
          _ = (φ h₁)⁻¹ * ψ h₁ * ((φ h₂)⁻¹ * ψ h₂) := by group) }
  have hker : ε.ker = ⊤ := by
    rw [eq_top_iff, ← hH]
    exact Abelianization.commutator_subset_ker ε
  ext h
  have h1 : ε h = 1 := (MonoidHom.mem_ker).mp (hker ▸ mem_top h)
  have h2 : (φ h)⁻¹ * ψ h = 1 := congrArg Subtype.val h1
  exact (inv_mul_eq_one.mp h2)

end Generic

variable {G : Type} [Group G] [Finite G] {A : Subgroup G} {d : Datum A} {Vi : Subgroup G}
  {f : ℕ}

omit [Finite G] in
@[expose] noncomputable def levQ {q : ℕ} (w : WData d Vi q) {K : Type} [Field K]
    (D : LeviData A Vi K) : Matrix.SpecialLinearGroup (Fin 2) K →* w.Nbar :=
  w.projBar.comp (D.lev.codRestrict w.N (w.lev_mem_N D))

omit [Finite G] in
theorem levQ_apply {q : ℕ} (w : WData d Vi q) {K : Type} [Field K] (D : LeviData A Vi K)
    (B : Matrix.SpecialLinearGroup (Fin 2) K) :
    levQ w D B = w.projBar ⟨D.lev B, w.lev_mem_N D B⟩ := rfl

omit [Finite G] in
theorem range_levQ {q : ℕ} (w : WData d Vi q) {K : Type} [Field K] (D : LeviData A Vi K) :
    (levQ w D).range = w.Lbar D.lev.range := by
  have h : D.lev.range.subgroupOf w.N = (D.lev.codRestrict w.N (w.lev_mem_N D)).range := by
    ext x
    simp only [mem_subgroupOf, MonoidHom.mem_range, MonoidHom.codRestrict_apply,
      Subtype.ext_iff]
  rw [levQ, MonoidHom.range_comp, WData.Lbar, h]

omit [Finite G] in
theorem levQ_injective {q : ℕ} (w : WData d Vi q) {K : Type} [Field K] (D : LeviData A Vi K) :
    Function.Injective (levQ w D) := by
  rw [injective_iff_map_eq_one]
  intro B hB
  have h1 : D.lev B ∈ w.W := (w.projBar_eq_one_iff _).mp hB
  have h2 : D.lev B ∈ Vi := by
    have h3 : D.lev B ∈ w.W ⊓ centralizer ({d.t} : Set G) :=
      ⟨h1, mem_centralizer_singleton_iff.mpr (d.comm_t_of_mem (D.lev_mem B))⟩
    rwa [w.fix] at h3
  have hB1 : ∀ v : Fin 2 → K, (B : Matrix (Fin 2) (Fin 2) K) *ᵥ v = v := by
    intro v
    have hc : D.lev B * D.ι (Multiplicative.ofAdd v) = D.ι (Multiplicative.ofAdd v) * D.lev B :=
      comm_of_isElemAbelian w.elem (w.le_W h2) (w.le_W (D.ι_mem_W _))
    have h3 := D.lev_conj B (Multiplicative.ofAdd v)
    rw [hc, mul_inv_cancel_right, toAdd_ofAdd] at h3
    exact (Multiplicative.ofAdd.injective (D.ι_injective h3)).symm
  exact Subtype.ext (Matrix.ext_iff_mulVec.mpr fun v => by
    rw [hB1 v, Matrix.SpecialLinearGroup.coe_one, Matrix.one_mulVec])

omit [Finite G] in
theorem tbar_inv {q : ℕ} (w : WData d Vi q) : w.tbar⁻¹ = w.tbar := by
  have h := pow_orderOf_eq_one w.tbar
  rw [w.orderOf_tbar, sq] at h
  exact inv_eq_of_mul_eq_one_right h

omit [Finite G] in
theorem tbar_mul_self {q : ℕ} (w : WData d Vi q) : w.tbar * w.tbar = 1 := by
  nth_rewrite 1 [← tbar_inv w]
  exact inv_mul_cancel _

omit [Finite G] in
theorem ttil_inv {q : ℕ} (w : WData d Vi q) : w.ttil⁻¹ = w.ttil := by
  rw [← map_inv, tbar_inv w]

omit [Finite G] in
theorem map_projTil_Ebar {q : ℕ} (w : WData d Vi q) (L : Subgroup G)
    (hlayer : SteinbergBV.OneOrTwoLayerConclusion (w.Ltil L) w.ttil) :
    (w.Ebar L).map w.projTil = CFSG.layer w.Ntil := by
  obtain ⟨-, -, -, hDE, -⟩ := hlayer
  rw [WData.Ebar, map_normalClosure _ _ (QuotientGroup.mk'_surjective _), ← coe_map]
  exact hDE

section Sigma

theorem exists_sigma (hf : 3 ≤ f) (w : WData d Vi (2 ^ f)) {K : Type} [Field K] [Finite K]
    (hKc : Nat.card K = 2 ^ f) (D : LeviData A Vi K) (hB : w.CaseB D.lev.range)
    (hcomm : ⁅standardComponentOddCore w.Nbar, w.Ebar D.lev.range⁆ = ⊥) :
    ∃ σ : Matrix.SpecialLinearGroup (Fin 2) K →* w.Nbar, Function.Injective σ ∧
      (∀ B, σ B ∈ w.Ebar D.lev.range) ∧
      (∀ B B', σ B * (w.tbar * σ B' * w.tbar) = w.tbar * σ B' * w.tbar * σ B) ∧
      (∀ B, σ B * (w.tbar * σ B * w.tbar) = levQ w D B) ∧
      (∀ B, σ B ∈ standardComponentOddCore w.Nbar → B = 1) ∧
      (∀ B B', σ B = w.tbar * σ B' * w.tbar → B = 1) ∧
      (∀ x ∈ w.Ebar D.lev.range, ∃ B B',
        w.projTil x = w.projTil (σ B * (w.tbar * σ B' * w.tbar))) := by
  have : CharP K 2 :=
    ComponentInitial.finite_field_prime_power_characteristic Nat.prime_two (by omega) hKc
  have : Fintype K := Fintype.ofFinite K
  have hKf : Fintype.card K = 2 ^ f := by rw [Fintype.card_eq_nat_card, hKc]
  obtain ⟨hlayer, -, -, -, -, -, -, -, -, -, -, -, -, -, -, ψ, hψ₁, hψ₂⟩ := hB
  have hmapE : (w.Ebar D.lev.range).map w.projTil = CFSG.layer w.Ntil :=
    map_projTil_Ebar w _ hlayer
  have hcen : ∀ x ∈ w.Ebar D.lev.range, w.projTil x = 1 →
      ∀ y ∈ w.Ebar D.lev.range, x * y = y * x := by
    intro x _ hx y hy
    have hxO : x ∈ standardComponentOddCore w.Nbar := (QuotientGroup.eq_one_iff _).mp hx
    have hxC := commutator_eq_bot_iff_le_centralizer.mp hcomm hxO
    exact (mem_centralizer_iff.mp hxC y hy).symm
  have hsimp : IsSimpleGroup (w.Lbar D.lev.range) :=
    isSimpleGroup_of_mulEquiv_SL2 (by omega) hKf (w.lbarEquiv D)
  have hfour := exists_four_of_mulEquiv_SL2 (by omega) hKf (w.lbarEquiv D)
  have hlaminj : Function.Injective (w.projTil.comp (levQ w D)) := by
    rw [injective_iff_map_eq_one]
    intro B hB1
    apply levQ_injective w D
    rw [map_one]
    have hmem : levQ w D B ∈ w.Lbar D.lev.range := by rw [← range_levQ w D]; exact ⟨B, rfl⟩
    exact w.Lbar_inf_oddCore D hfour hmem ((QuotientGroup.eq_one_iff _).mp hB1)
  have hlamrange : (w.projTil.comp (levQ w D)).range = w.Ltil D.lev.range := by
    rw [MonoidHom.range_comp, range_levQ w D]
  let lam : Matrix.SpecialLinearGroup (Fin 2) K ≃* w.Ltil D.lev.range :=
    (MonoidHom.ofInjective hlaminj).trans (MulEquiv.subgroupCongr hlamrange)
  have hlam : ∀ B, (lam B : w.Ntil) = w.projTil (levQ w D B) := fun B => rfl
  have hEbE : ∀ x : w.Ebar D.lev.range, w.projTil x ∈ CFSG.layer w.Ntil := fun x =>
    hmapE ▸ ⟨x, x.2, rfl⟩
  let pr : w.Ebar D.lev.range →* w.Ltil D.lev.range × w.Ltil D.lev.range :=
    ψ.toMonoidHom.comp ((w.projTil.comp (w.Ebar D.lev.range).subtype).codRestrict _ hEbE)
  have hpr : ∀ x : w.Ebar D.lev.range, ((ψ.symm (pr x) : CFSG.layer w.Ntil) : w.Ntil) =
      w.projTil x := fun x => by
    change ((ψ.symm (ψ _) : CFSG.layer w.Ntil) : w.Ntil) = _
    rw [MulEquiv.symm_apply_apply]
    rfl
  have hprsurj : Function.Surjective pr := by
    intro p
    have hmem : ((ψ.symm p : CFSG.layer w.Ntil) : w.Ntil) ∈ (w.Ebar D.lev.range).map w.projTil :=
      by rw [hmapE]; exact (ψ.symm p).2
    obtain ⟨x, hx, hxp⟩ := hmem
    refine ⟨⟨x, hx⟩, ψ.symm.injective (Subtype.ext ?_)⟩
    rw [hpr]
    exact hxp
  let E₁ : Subgroup (w.Ebar D.lev.range) :=
    ((⊤ : Subgroup (w.Ltil D.lev.range)).prod ⊥).comap pr
  let π' : E₁ →* Matrix.SpecialLinearGroup (Fin 2) K :=
    lam.symm.toMonoidHom.comp ((MonoidHom.fst _ _).comp (pr.comp E₁.subtype))
  have hπ'surj : Function.Surjective π' := by
    intro B
    obtain ⟨x, hx⟩ := hprsurj (lam B, 1)
    have hxE₁ : x ∈ E₁ := by
      change pr x ∈ (⊤ : Subgroup (w.Ltil D.lev.range)).prod ⊥
      rw [hx]
      exact mem_prod.mpr ⟨mem_top _, one_mem _⟩
    refine ⟨⟨x, hxE₁⟩, ?_⟩
    change lam.symm (pr x).1 = B
    rw [hx, MulEquiv.symm_apply_apply]
  have hker : π'.ker ≤ center E₁ := by
    intro x hx
    rw [MonoidHom.mem_ker] at hx
    have h1 : (pr x).1 = 1 := by
      have : lam.symm (pr x).1 = 1 := hx
      rw [← map_one lam.symm] at this
      exact lam.symm.injective this
    have h2 : (pr x).2 = 1 := (mem_prod.mp x.2).2
    have h3 : pr x = 1 := Prod.ext h1 h2
    have h4 : w.projTil (((x : w.Ebar D.lev.range) : w.Nbar)) = 1 := by
      rw [← hpr, h3, map_one]
      rfl
    rw [mem_center_iff]
    intro y
    apply Subtype.ext
    apply Subtype.ext
    exact (hcen _ (x : w.Ebar D.lev.range).2 h4 _ (y : w.Ebar D.lev.range).2).symm
  have h5 : 5 ≤ Nat.card K := by
    rw [hKc]
    calc 5 ≤ 2 ^ 3 := by norm_num
      _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf
  have h9 : Nat.card K ≠ 9 := by
    rw [hKc]
    intro h
    have : 2 ∣ 2 ^ f := dvd_pow_self 2 (by omega)
    omega
  obtain ⟨σ₀, hσ₀⟩ :=
    LieType.Steinberg.CentralExt.SL2Closed.sl2_exists_section_of_central h5 h9 hπ'surj hker
  let σE : Matrix.SpecialLinearGroup (Fin 2) K →* w.Ebar D.lev.range := E₁.subtype.comp σ₀
  have hprσ : ∀ B, pr (σE B) = (lam B, 1) := fun B => by
    have h2 : (pr (σE B)).2 = 1 := (mem_prod.mp (σ₀ B).2).2
    refine Prod.ext ?_ h2
    have h1 : lam.symm (pr (σE B)).1 = B := hσ₀ B
    have h1' := congrArg lam h1
    rwa [MulEquiv.apply_symm_apply] at h1'
  have hcen' : ∀ x : w.Ebar D.lev.range, pr x = 1 → x ∈ center (w.Ebar D.lev.range) := by
    intro x hx
    have h4 : w.projTil (x : w.Nbar) = 1 := by
      rw [← hpr, hx, map_one]
      rfl
    rw [mem_center_iff]
    intro y
    exact Subtype.ext (hcen _ x.2 h4 _ y.2).symm
  have hEbn : (w.Ebar D.lev.range).Normal := normalClosure_normal
  have htconj : ∀ x ∈ w.Ebar D.lev.range, w.tbar * x * w.tbar ∈ w.Ebar D.lev.range := by
    intro x hx
    have := hEbn.conj_mem x hx w.tbar
    rwa [tbar_inv w] at this
  let tc : w.Ebar D.lev.range →* w.Ebar D.lev.range :=
    { toFun := fun x => ⟨w.tbar * x * w.tbar, htconj x x.2⟩
      map_one' := Subtype.ext (by
        change w.tbar * 1 * w.tbar = 1
        rw [mul_one, tbar_mul_self w])
      map_mul' := fun x y => Subtype.ext (by
        change w.tbar * (x * y : w.Nbar) * w.tbar = (w.tbar * x * w.tbar) * (w.tbar * y * w.tbar)
        rw [show w.tbar * (x : w.Nbar) * w.tbar * (w.tbar * y * w.tbar) =
          w.tbar * x * (w.tbar * w.tbar) * y * w.tbar by group, tbar_mul_self w, mul_one]
        group) }
  have hprtc : ∀ x, pr (tc x) = (pr x).swap := by
    intro x
    have hx := hEbE x
    have : (CFSG.layer w.Ntil).Characteristic := CFSG.LocalCores.layer_characteristic
    have hxt : w.ttil⁻¹ * w.projTil (x : w.Nbar) * w.ttil ∈ CFSG.layer w.Ntil := by
      have := (inferInstance : (CFSG.layer w.Ntil).Normal).conj_mem _ hx w.ttil⁻¹
      simpa using this
    have h1 := hψ₂ _ hx hxt
    change ψ ⟨w.projTil (w.tbar * (x : w.Nbar) * w.tbar), _⟩ = (ψ ⟨w.projTil x, _⟩).swap
    rw [← h1]
    congr 2
    rw [map_mul, map_mul, ttil_inv w]
  have hperf : commutator (Matrix.SpecialLinearGroup (Fin 2) K) = ⊤ := by
    obtain ⟨μ, hμ⟩ := exists_unit_ne_one (K := K) (by omega)
    exact Matrix.SL2.commutator_eq_top μ.ne_zero (sq_ne_one_of_charTwo hμ)
  have hcommE : ∀ B B', σE B * tc (σE B') = tc (σE B') * σE B := by
    intro B B'
    set y := tc (σE B') with hy
    let φ₂ : Matrix.SpecialLinearGroup (Fin 2) K →* w.Ebar D.lev.range :=
      (MulAut.conj y).toMonoidHom.comp σE
    have heq := CaseBModule.eq_of_perfect_of_central hperf σE φ₂ fun B₀ => by
      apply hcen'
      change pr ((σE B₀)⁻¹ * (y * σE B₀ * y⁻¹)) = 1
      rw [map_mul, map_inv, map_mul, map_mul, map_inv, hy, hprtc, hprσ, hprσ]
      ext <;> simp
    have h := congrArg (fun φ => φ B) heq
    simp only [φ₂, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at h
    calc σE B * y = (y * σE B * y⁻¹) * y := by rw [← h]
      _ = y * σE B := by group
  let δE : Matrix.SpecialLinearGroup (Fin 2) K →* w.Ebar D.lev.range :=
    { toFun := fun B => σE B * tc (σE B)
      map_one' := by rw [map_one, map_one, one_mul]
      map_mul' := fun B B' => by
        rw [map_mul, map_mul]
        calc σE B * σE B' * (tc (σE B) * tc (σE B')) =
            σE B * (σE B' * tc (σE B)) * tc (σE B') := by group
          _ = σE B * (tc (σE B) * σE B') * tc (σE B') := by rw [hcommE B' B]
          _ = σE B * tc (σE B) * (σE B' * tc (σE B')) := by group }
  have hlevE : ∀ B, levQ w D B ∈ w.Ebar D.lev.range := fun B => by
    apply le_normalClosure
    rw [← range_levQ w D]
    exact ⟨B, rfl⟩
  let levE : Matrix.SpecialLinearGroup (Fin 2) K →* w.Ebar D.lev.range :=
    (levQ w D).codRestrict _ hlevE
  have hprlev : ∀ B, pr (levE B) = (lam B, lam B) := by
    intro B
    have hL : w.projTil (levQ w D B) ∈ w.Ltil D.lev.range := by
      rw [← hlamrange]
      exact ⟨B, rfl⟩
    have h1 := hψ₁ _ hL (hEbE (levE B))
    change ψ ⟨w.projTil (levQ w D B), _⟩ = _
    rw [h1]
    rfl
  have hδ := CaseBModule.eq_of_perfect_of_central hperf δE levE fun B => by
    apply hcen'
    change pr ((σE B * tc (σE B))⁻¹ * levE B) = 1
    rw [map_mul, map_inv, map_mul, hprtc, hprσ, hprlev]
    ext <;> simp
  refine ⟨(w.Ebar D.lev.range).subtype.comp σE, ?_, fun B => (σE B).2, fun B B' => ?_,
    fun B => ?_, fun B hB => ?_, fun B B' hBB' => ?_, fun x hx => ?_⟩
  · rw [injective_iff_map_eq_one]
    intro B hB1
    have h1 : σE B = 1 := Subtype.ext hB1
    have h2 := hprσ B
    rw [h1, map_one] at h2
    have h3 : lam B = 1 := (congrArg Prod.fst h2).symm
    rw [← map_one lam] at h3
    exact lam.injective h3
  · exact congrArg Subtype.val (hcommE B B')
  · exact congrArg Subtype.val (congrArg (fun φ => φ B) hδ)
  · have h1 : w.projTil (σE B : w.Nbar) = 1 := (QuotientGroup.eq_one_iff _).mpr hB
    have h2 : pr (σE B) = 1 := by
      apply ψ.symm.injective
      apply Subtype.ext
      rw [hpr, h1, map_one]
      rfl
    rw [hprσ] at h2
    have h3 : lam B = 1 := congrArg Prod.fst h2
    rw [← map_one lam] at h3
    exact lam.injective h3
  · have h1 : σE B = tc (σE B') := Subtype.ext hBB'
    have h2 := congrArg pr h1
    rw [hprtc, hprσ, hprσ] at h2
    have h3 : lam B = 1 := congrArg Prod.fst h2
    rw [← map_one lam] at h3
    exact lam.injective h3
  ·
    refine ⟨lam.symm (pr ⟨x, hx⟩).1, lam.symm (pr ⟨x, hx⟩).2, ?_⟩
    have h1 : pr (σE (lam.symm (pr ⟨x, hx⟩).1) * tc (σE (lam.symm (pr ⟨x, hx⟩).2))) =
        pr ⟨x, hx⟩ := by
      rw [map_mul, hprtc, hprσ, hprσ, MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply]
      ext <;> simp
    have h2 := congrArg (fun p => ((ψ.symm p : CFSG.layer w.Ntil) : w.Ntil)) h1
    simp only [hpr] at h2
    exact h2.symm

end Sigma

omit [Finite G] in
theorem tor_mem_N {q : ℕ} (w : WData d Vi q) {K : Type} [Field K] (D : LeviData A Vi K)
    (l : Kˣ) : D.tor l ∈ w.N :=
  w.levi_norm ⟨D.tor_mem l, D.tor_mem_normalizer l⟩

theorem exists_ltilEquiv {f : ℕ} (hf : 2 ≤ f) (w : WData d Vi (2 ^ f)) {K : Type} [Field K]
    [Finite K] (hKc : Nat.card K = 2 ^ f) (D : LeviData A Vi K) :
    ∃ lam : Matrix.SpecialLinearGroup (Fin 2) K ≃* w.Ltil D.lev.range,
      ∀ B, (lam B : w.Ntil) = w.projTil (levQ w D B) := by
  have : Fintype K := Fintype.ofFinite K
  have hKf : Fintype.card K = 2 ^ f := by rw [Fintype.card_eq_nat_card, hKc]
  have hsimp : IsSimpleGroup (w.Lbar D.lev.range) :=
    isSimpleGroup_of_mulEquiv_SL2 (by omega) hKf (w.lbarEquiv D)
  have hfour := exists_four_of_mulEquiv_SL2 (by omega) hKf (w.lbarEquiv D)
  have hlaminj : Function.Injective (w.projTil.comp (levQ w D)) := by
    rw [injective_iff_map_eq_one]
    intro B hB1
    apply levQ_injective w D
    rw [map_one]
    have hmem : levQ w D B ∈ w.Lbar D.lev.range := by rw [← range_levQ w D]; exact ⟨B, rfl⟩
    exact w.Lbar_inf_oddCore D hfour hmem ((QuotientGroup.eq_one_iff _).mp hB1)
  have hlamrange : (w.projTil.comp (levQ w D)).range = w.Ltil D.lev.range := by
    rw [MonoidHom.range_comp, range_levQ w D]
  exact ⟨(MonoidHom.ofInjective hlaminj).trans (MulEquiv.subgroupCongr hlamrange),
    fun B => rfl⟩

theorem projTil_tor {f : ℕ} (hf : 2 ≤ f) (w : WData d Vi (2 ^ f)) {K : Type} [Field K]
    [Finite K] (hKc : Nat.card K = 2 ^ f) (D : LeviData A Vi K) (hB : w.CaseB D.lev.range)
    (l : Kˣ) : w.projTil (w.projBar ⟨D.tor l, tor_mem_N w D l⟩) = 1 := by
  classical
  have : Fintype K := Fintype.ofFinite K
  have hKf : Fintype.card K = 2 ^ f := by rw [Fintype.card_eq_nat_card, hKc]
  obtain ⟨hlayer, -, -, -, -, -, -, -, -, -, -, -, -, -, -, ψ, hψ₁, hψ₂⟩ := hB
  obtain ⟨-, -, -, hDE, -, -, hfaith⟩ := hlayer
  obtain ⟨lam, hlam⟩ := exists_ltilEquiv hf w hKc D
  set h := w.projTil (w.projBar ⟨D.tor l, tor_mem_N w D l⟩) with hhdef
  have : (CFSG.layer w.Ntil).Characteristic := CFSG.LocalCores.layer_characteristic
  have hht : h * w.ttil = w.ttil * h := by
    rw [hhdef, ← map_mul, ← map_mul, ← map_mul, ← map_mul]
    congr 2
    exact Subtype.ext (d.comm_t_of_mem (D.tor_mem l))
  have hhL : ∀ j ∈ w.Ltil D.lev.range, h * j = j * h := by
    rintro _ ⟨_, ⟨z, hz, rfl⟩, rfl⟩
    obtain ⟨B, hB⟩ := mem_subgroupOf.mp hz
    rw [hhdef, ← map_mul, ← map_mul, ← map_mul, ← map_mul]
    congr 2
    apply Subtype.ext
    change D.tor l * (z : G) = (z : G) * D.tor l
    rw [← hB]
    exact D.tor_comm l B
  have hpow : h ^ (Nat.card K - 1) = 1 := by
    rw [hhdef, ← map_pow, ← map_pow]
    have hl : l ^ (Nat.card K - 1) = 1 := by
      rw [Nat.card_eq_fintype_card, ← Fintype.card_units]
      exact pow_card_eq_one
    have : (⟨D.tor l, tor_mem_N w D l⟩ : w.N) ^ (Nat.card K - 1) = 1 := by
      apply Subtype.ext
      rw [SubmonoidClass.coe_pow, ← map_pow, hl, map_one]
      rfl
    rw [this, map_one, map_one]
  have hodd : Odd (Nat.card K - 1) := by
    rw [hKc, Nat.odd_iff]
    have h3 : 2 ^ f = 2 * 2 ^ (f - 1) := by
      rw [← pow_succ']
      congr 1
      omega
    have h4 : 1 ≤ 2 ^ (f - 1) := Nat.one_le_two_pow
    omega
  let cj : MulAut (CFSG.layer w.Ntil) := MulAut.conjNormal h⁻¹
  have hcj : ∀ x : CFSG.layer w.Ntil, (cj x : w.Ntil) = h⁻¹ * x * h := fun x => by
    simp [cj]
  let Γ : w.Ltil D.lev.range × w.Ltil D.lev.range →* w.Ltil D.lev.range × w.Ltil D.lev.range :=
    ψ.toMonoidHom.comp (cj.toMonoidHom.comp ψ.symm.toMonoidHom)
  have hΓ : ∀ p, ((ψ.symm (Γ p) : CFSG.layer w.Ntil) : w.Ntil) =
      h⁻¹ * (ψ.symm p : CFSG.layer w.Ntil) * h := fun p => by
    change ((ψ.symm (ψ (cj (ψ.symm p))) : CFSG.layer w.Ntil) : w.Ntil) = _
    rw [MulEquiv.symm_apply_apply, hcj]
  have hψsymm_diag : ∀ j : w.Ltil D.lev.range,
      ((ψ.symm (j, j) : CFSG.layer w.Ntil) : w.Ntil) = j := by
    intro j
    have hjE : (j : w.Ntil) ∈ CFSG.layer w.Ntil := hDE ▸ subset_normalClosure j.2
    have h1 := hψ₁ j j.2 hjE
    rw [show ((⟨j, j.2⟩ : w.Ltil D.lev.range)) = j from rfl] at h1
    rw [← h1, MulEquiv.symm_apply_apply]
  have hdiag : ∀ j, Γ (j, j) = (j, j) := by
    intro j
    apply ψ.symm.injective
    apply Subtype.ext
    rw [hΓ, hψsymm_diag, mul_assoc, ← hhL j j.2]
    group
  have key : ∀ y : CFSG.layer w.Ntil,
      ((ψ.symm (ψ y).swap : CFSG.layer w.Ntil) : w.Ntil) = w.ttil⁻¹ * y * w.ttil := by
    intro y
    have hyt : w.ttil⁻¹ * (y : w.Ntil) * w.ttil ∈ CFSG.layer w.Ntil := by
      have := (inferInstance : (CFSG.layer w.Ntil).Normal).conj_mem _ y.2 w.ttil⁻¹
      simpa using this
    have h1 := hψ₂ y y.2 hyt
    rw [show (⟨(y : w.Ntil), y.2⟩ : CFSG.layer w.Ntil) = y from rfl] at h1
    rw [← h1, MulEquiv.symm_apply_apply]
  have hhti : h⁻¹ * w.ttil⁻¹ = w.ttil⁻¹ * h⁻¹ := by
    rw [ttil_inv w]
    exact (Commute.inv_left (show Commute h w.ttil from hht)).eq
  have hswap : ∀ p, Γ p.swap = (Γ p).swap := by
    intro p
    apply ψ.symm.injective
    apply Subtype.ext
    have e1 : p.swap = (ψ (ψ.symm p)).swap := by rw [MulEquiv.apply_symm_apply]
    have e2 : (Γ p).swap = (ψ (ψ.symm (Γ p))).swap := by rw [MulEquiv.apply_symm_apply]
    rw [hΓ, e1, key, e2, key, hΓ]
    calc h⁻¹ * (w.ttil⁻¹ * ↑(ψ.symm p) * w.ttil) * h =
        (h⁻¹ * w.ttil⁻¹) * ↑(ψ.symm p) * (w.ttil * h) := by group
      _ = (w.ttil⁻¹ * h⁻¹) * ↑(ψ.symm p) * (h * w.ttil) := by rw [hhti, hht]
      _ = w.ttil⁻¹ * (h⁻¹ * ↑(ψ.symm p) * h) * w.ttil := by group
  have hsimpL : IsSimpleGroup (w.Ltil D.lev.range) :=
    isSimpleGroup_of_mulEquiv_SL2 (by omega) hKf lam.symm
  have hZ : ∀ z : w.Ltil D.lev.range, (∀ s, z * s = s * z) → z = 1 := by
    intro z hz
    have hzc : z ∈ center (w.Ltil D.lev.range) := mem_center_iff.mpr fun s => (hz s).symm
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (center (w.Ltil D.lev.range)) with h1 | h1
    · rwa [h1, mem_bot] at hzc
    · obtain ⟨x, y, hxy⟩ := exists_mul_ne_of_mulEquiv_SL2 lam.symm
      exact absurd (mem_center_iff.mp (h1 ▸ mem_top y) x) hxy
  have hcentral : ∀ g : w.Ntil, (∀ x : CFSG.layer w.Ntil, g⁻¹ * x * g = x) → g = 1 :=
    fun g hg => hfaith g fun e he => hg ⟨e, hDE ▸ he⟩
  rcases CaseBModule.eq_id_or_eq_swap_of_diag hZ Γ hdiag hswap with hid | hsw
  · refine hcentral h fun x => ?_
    have := hΓ (ψ x)
    rw [hid, MulEquiv.symm_apply_apply] at this
    exact this.symm
  · exfalso
    have hht' : h = w.ttil := by
      have h1 : w.ttil * h⁻¹ = 1 := hcentral _ fun x => by
        have h2 := hΓ (ψ x)
        rw [hsw, key, MulEquiv.symm_apply_apply] at h2
        calc (w.ttil * h⁻¹)⁻¹ * x * (w.ttil * h⁻¹) = h * (w.ttil⁻¹ * x * w.ttil) * h⁻¹ := by
              group
          _ = h * (h⁻¹ * x * h) * h⁻¹ := by rw [h2]
          _ = x := by group
      calc h = (w.ttil * h⁻¹)⁻¹ * w.ttil := by group
        _ = w.ttil := by rw [h1, inv_one, one_mul]
    have h2 : w.ttil ^ (Nat.card K - 1) = 1 := hht' ▸ hpow
    obtain ⟨m, hm⟩ := hodd
    rw [hm, pow_succ, pow_mul, sq] at h2
    have h3 : w.ttil * w.ttil = 1 := by rw [← map_mul, tbar_mul_self w, map_one]
    rw [h3, one_pow, one_mul] at h2
    have := w.orderOf_ttil
    rw [h2, orderOf_one] at this
    omega

section Action

variable {q : ℕ}

omit [Finite G] in
scoped instance commGroupWN (w : WData d Vi q) : CommGroup w.WN :=
  { (inferInstance : Group w.WN) with
    mul_comm := fun x y => Subtype.ext (Subtype.ext (comm_of_isElemAbelian w.elem
      (mem_subgroupOf.mp x.2) (mem_subgroupOf.mp y.2))) }

omit [Finite G] in
scoped instance moduleWN (w : WData d Vi q) : Module (ZMod 2) (Additive w.WN) :=
  AddCommGroup.zmodModule fun x => by
    rw [← ofMul_toMul x, ← ofMul_pow, ofMul_eq_zero]
    exact Subtype.ext (Subtype.ext (w.elem.2 _ (mem_subgroupOf.mp (Additive.toMul x).2)))

omit [Finite G] in
abbrev cW (w : WData d Vi q) (x : Additive w.WN) : G := ((Additive.toMul x : w.WN) : w.N)

omit [Finite G] in
@[expose] noncomputable def actNB (w : WData d Vi q) :
    w.N →* Module.End (ZMod 2) (Additive w.WN) where
  toFun n := AddMonoidHom.toZModLinearMap 2
    (MonoidHom.toAdditive (MulAut.conjNormal n).toMonoidHom)
  map_one' := by
    ext x
    simp
  map_mul' m n := by
    ext x
    simp [MulAut.conjNormal_apply, mul_assoc]

omit [Finite G] in
theorem cW_actNB (w : WData d Vi q) (n : w.N) (x : Additive w.WN) :
    (((Additive.toMul (actNB w n x) : w.WN) : w.N) : G) =
      (n : G) * (((Additive.toMul x : w.WN) : w.N) : G) * (n : G)⁻¹ := rfl

omit [Finite G] in
@[expose] noncomputable def actB (w : WData d Vi q) :
    w.Nbar →* Module.End (ZMod 2) (Additive w.WN) :=
  QuotientGroup.lift w.WN (actNB w) (fun y hy => by
    rw [MonoidHom.mem_ker]
    ext x
    rw [cW_actNB]
    rw [comm_of_isElemAbelian w.elem (mem_subgroupOf.mp hy)
      (mem_subgroupOf.mp (Additive.toMul x).2), mul_inv_cancel_right]
    rfl)

omit [Finite G] in
theorem cW_actB (w : WData d Vi q) (n : w.N) (x : Additive w.WN) :
    cW w (actB w (w.projBar n) x) = (n : G) * cW w x * (n : G)⁻¹ := by
  have h : actB w (w.projBar n) = actNB w n := QuotientGroup.lift_mk' _ _ n
  rw [h]
  rfl

omit [Finite G] in
theorem cW_injective (w : WData d Vi q) : Function.Injective (cW w) := fun _ _ h =>
  Additive.toMul.injective (Subtype.ext (Subtype.ext h))

omit [Finite G] in
theorem cW_mem (w : WData d Vi q) (x : Additive w.WN) : cW w x ∈ w.W :=
  mem_subgroupOf.mp (Additive.toMul x).2

omit [Finite G] in
theorem cW_add (w : WData d Vi q) (x y : Additive w.WN) : cW w (x + y) = cW w x * cW w y := rfl

omit [Finite G] in
theorem cW_neg (w : WData d Vi q) (x : Additive w.WN) : cW w (-x) = (cW w x)⁻¹ := rfl

omit [Finite G] in
theorem exists_cW_eq (w : WData d Vi q) {y : G} (hy : y ∈ w.W) :
    ∃ x : Additive w.WN, cW w x = y :=
  ⟨Additive.ofMul ⟨⟨y, w.W_le_N hy⟩, mem_subgroupOf.mpr hy⟩, rfl⟩

theorem finrank_WN {f : ℕ} (w : WData d Vi (2 ^ f)) :
    Module.finrank (ZMod 2) (Additive w.WN) = 4 * f := by
  have : Fintype (Additive w.WN) := Fintype.ofFinite _
  have h1 := Module.card_eq_pow_finrank (K := ZMod 2) (V := Additive w.WN)
  rw [ZMod.card, ← Nat.card_eq_fintype_card] at h1
  have h2 : Nat.card (Additive w.WN) = 2 ^ (4 * f) := by
    change Nat.card w.WN = _
    rw [Nat.card_congr (subgroupOfEquivOfLe w.W_le_N).toEquiv, w.card, ← pow_mul, mul_comm]
  rw [h2] at h1
  exact (Nat.pow_right_injective le_rfl h1).symm

omit [Finite G] in
@[expose] noncomputable def ιW (w : WData d Vi q) {K : Type} [Field K] (D : LeviData A Vi K) :
    (Fin 2 → K) →+ Additive w.WN where
  toFun v := Additive.ofMul ⟨⟨D.ι (Multiplicative.ofAdd v), w.W_le_N (w.le_W (D.ι_mem_W _))⟩,
    mem_subgroupOf.mpr (w.le_W (D.ι_mem_W _))⟩
  map_zero' := by
    apply Additive.toMul.injective
    apply Subtype.ext
    apply Subtype.ext
    change D.ι (Multiplicative.ofAdd 0) = 1
    rw [ofAdd_zero, map_one]
  map_add' u v := by
    apply Additive.toMul.injective
    apply Subtype.ext
    apply Subtype.ext
    change D.ι (Multiplicative.ofAdd (u + v)) =
      D.ι (Multiplicative.ofAdd u) * D.ι (Multiplicative.ofAdd v)
    rw [ofAdd_add, map_mul]

omit [Finite G] in
theorem cW_ιW (w : WData d Vi q) {K : Type} [Field K] (D : LeviData A Vi K) (v : Fin 2 → K) :
    cW w (ιW w D v) = D.ι (Multiplicative.ofAdd v) := rfl

omit [Finite G] in
@[expose] def toG (w : WData d Vi q) (P : Submodule (ZMod 2) (Additive w.WN)) : Subgroup G where
  carrier := {g | ∃ m ∈ P, cW w m = g}
  mul_mem' := by
    rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
    exact ⟨a + b, P.add_mem ha hb, rfl⟩
  one_mem' := ⟨0, P.zero_mem, rfl⟩
  inv_mem' := by
    rintro _ ⟨a, ha, rfl⟩
    exact ⟨-a, P.neg_mem ha, rfl⟩

omit [Finite G] in
theorem cW_mem_toG (w : WData d Vi q) (P : Submodule (ZMod 2) (Additive w.WN))
    (m : Additive w.WN) : cW w m ∈ toG w P ↔ m ∈ P :=
  ⟨fun ⟨_, hm', h⟩ => cW_injective w h ▸ hm', fun h => ⟨m, h, rfl⟩⟩

omit [Finite G] in
theorem toG_le (w : WData d Vi q) (P : Submodule (ZMod 2) (Additive w.WN)) : toG w P ≤ w.W := by
  rintro _ ⟨m, -, rfl⟩
  exact cW_mem w m

omit [Finite G] in
theorem card_toG (w : WData d Vi q) (P : Submodule (ZMod 2) (Additive w.WN)) :
    Nat.card (toG w P) = Nat.card P := by
  refine Nat.card_congr (Equiv.ofBijective (fun m => ⟨cW w m, ⟨m, m.2, rfl⟩⟩) ⟨fun a b h => ?_,
    fun g => ?_⟩).symm
  · have h' := congrArg Subtype.val h
    simp only at h'
    exact Subtype.ext (cW_injective w h')
  · obtain ⟨m, hm, hmg⟩ := g.2
    exact ⟨⟨m, hm⟩, Subtype.ext hmg⟩

end Action

section Decomp

theorem exists_caseB_module (hf : 3 ≤ f) (w : WData d Vi (2 ^ f)) {K : Type} [Field K]
    [Finite K] (hKc : Nat.card K = 2 ^ f) (D : LeviData A Vi K) (hB : w.CaseB D.lev.range)
    (hcomm : ⁅standardComponentOddCore w.Nbar, w.Ebar D.lev.range⁆ = ⊥) :
    ∃ (σ : Matrix.SpecialLinearGroup (Fin 2) K →* w.Nbar) (W₁ : Subgroup G),
      Function.Injective σ ∧ (∀ B, σ B ∈ w.Ebar D.lev.range) ∧
      (∀ B B', σ B * (w.tbar * σ B' * w.tbar) = w.tbar * σ B' * w.tbar * σ B) ∧
      (∀ B, σ B * (w.tbar * σ B * w.tbar) = levQ w D B) ∧
      (∀ B, σ B ∈ standardComponentOddCore w.Nbar → B = 1) ∧
      (∀ B B', σ B = w.tbar * σ B' * w.tbar → B = 1) ∧
      (∀ x ∈ w.Ebar D.lev.range, ∃ B B',
        w.projTil x = w.projTil (σ B * (w.tbar * σ B' * w.tbar))) ∧
      W₁ ≤ w.W ∧ W₁ ⊓ W₁.map (MulAut.conj d.t).toMonoidHom = ⊥ ∧
      W₁ ⊔ W₁.map (MulAut.conj d.t).toMonoidHom = w.W ∧ Nat.card W₁ = (2 ^ f) ^ 2 ∧
      (∀ (n : w.N) (B : Matrix.SpecialLinearGroup (Fin 2) K),
        w.projBar n = w.tbar * σ B * w.tbar → ∀ x ∈ W₁, (n : G) * x * (n : G)⁻¹ = x) ∧
      (∀ (n : w.N) (B : Matrix.SpecialLinearGroup (Fin 2) K), w.projBar n = σ B →
        ∀ y ∈ W₁.map (MulAut.conj d.t).toMonoidHom, (n : G) * y * (n : G)⁻¹ = y) ∧
      (∀ (n : w.N) (B : Matrix.SpecialLinearGroup (Fin 2) K), w.projBar n = σ B → ∀ x ∈ W₁,
        (n : G) * x * (n : G)⁻¹ ∈ W₁ ∧
        d.t * ((n : G) * x * (n : G)⁻¹) * d.t * ((n : G) * x * (n : G)⁻¹)⁻¹ =
          D.lev B * (d.t * x * d.t * x⁻¹) * (D.lev B)⁻¹) ∧
      (∀ v ∈ Vi, ∃! x, x ∈ W₁ ∧ d.t * x * d.t * x⁻¹ = v) := by
  have : CharP K 2 :=
    ComponentInitial.finite_field_prime_power_characteristic Nat.prime_two (by omega) hKc
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨σ, hσinj, hσE, hσc, hσd, hσO, hσXY, hσon⟩ := exists_sigma hf w hKc D hB hcomm
  have hK8 : 8 ≤ Nat.card K := by
    rw [hKc]
    calc 8 = 2 ^ 3 := by norm_num
      _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf
  obtain ⟨l, hl⟩ := WLocal.exists_unit_cube_ne_one hK8
  have htinv : d.t⁻¹ = d.t := inv_eq_of_mul_eq_one_right d.t_mul_self
  have hhO : w.projBar ⟨D.tor l, tor_mem_N w D l⟩ ∈ standardComponentOddCore w.Nbar :=
    (QuotientGroup.eq_one_iff _).mp (projTil_tor (by omega) w hKc D hB l)
  have hhE : ∀ x ∈ w.Ebar D.lev.range,
      w.projBar ⟨D.tor l, tor_mem_N w D l⟩ * x = x * w.projBar ⟨D.tor l, tor_mem_N w D l⟩ := by
    intro x hx
    have := commutator_eq_bot_iff_le_centralizer.mp hcomm hhO
    exact (mem_centralizer_iff.mp this x hx).symm
  have hρ := cW_actB w
  have hcWt : ∀ x, cW w (actB w w.tbar x) = d.t * cW w x * d.t := fun x => by
    rw [hρ w.tN x, htinv]
  have hcWsub : ∀ x : Additive w.WN, cW w (actB w w.tbar x - x) =
      d.t * cW w x * d.t * (cW w x)⁻¹ := fun x => by
    rw [sub_eq_add_neg, cW_add, cW_neg, hcWt]
  have hρmul : ∀ a b : w.Nbar, ∀ x, actB w a (actB w b x) = actB w (a * b) x := fun a b x => by
    rw [map_mul, Module.End.mul_apply]
  let S : SwapData K (Additive w.WN) :=
    { f := f
      two_le := by omega
      card_K := hKc
      finrank_M := finrank_WN w
      α := (actB w).comp σ
      α_injective := by
        rw [injective_iff_map_eq_one]
        intro B hB1
        apply hσO B
        obtain ⟨n, hn⟩ := QuotientGroup.mk'_surjective w.WN (σ B)
        have hn' : w.projBar n = σ B := hn
        have hnC : (n : G) ∈ centralizer (w.W : Set G) := by
          rw [mem_centralizer_iff]
          intro y hy
          obtain ⟨x, rfl⟩ := exists_cW_eq w hy
          have h1 := hρ n x
          rw [hn'] at h1
          have h2 : actB w (σ B) = 1 := hB1
          rw [h2, Module.End.one_apply] at h1
          calc cW w x * n = ((n : G) * cW w x * (n : G)⁻¹) * n := by rw [← h1]
            _ = n * cW w x := by group
        have h2 := w.projTil_projBar_eq_one hnC
        rw [hn'] at h2
        exact (QuotientGroup.eq_one_iff _).mp h2
      τ := actB w w.tbar
      τ_mul_self := by rw [← map_mul, tbar_mul_self w, map_one]
      comm := fun B B' => by
        simp only [MonoidHom.comp_apply, ← map_mul]
        rw [hσc]
      ι := ιW w D
      ι_injective := fun u v h => by
        have h1 := congrArg (cW w) h
        rw [cW_ιW, cW_ιW] at h1
        exact Multiplicative.ofAdd.injective (D.ι_injective h1)
      τ_ι := fun v => by
        apply cW_injective w
        rw [hcWt, cW_ιW]
        have hc := mem_centralizer_singleton_iff.mp (w.le_centralizer_t (D.ι_mem_W
          (Multiplicative.ofAdd v)))
        rw [← hc, mul_assoc, d.t_mul_self, mul_one]
      exists_ι := fun m hm => by
        have h1 := congrArg (cW w) hm
        rw [hcWt] at h1
        have hmV : cW w m ∈ Vi := by
          have h2 : cW w m ∈ w.W ⊓ centralizer ({d.t} : Set G) := by
            refine ⟨cW_mem w m, mem_centralizer_singleton_iff.mpr ?_⟩
            calc cW w m * d.t = d.t * cW w m * d.t * d.t := by rw [h1]
              _ = d.t * cW w m := by rw [mul_assoc _ d.t d.t, d.t_mul_self, mul_one]
          rwa [w.fix] at h2
        have hmV' : cW w m ∈ D.ι.range := by rw [D.range_ι]; exact hmV
        obtain ⟨u, hu⟩ := hmV'
        exact ⟨Multiplicative.toAdd u, cW_injective w (by rw [cW_ιW, ofAdd_toAdd, hu])⟩
      nat := fun B v => by
        simp only [MonoidHom.comp_apply]
        rw [hρmul, hρmul, hρmul, show σ B * w.tbar * σ B * w.tbar =
          σ B * (w.tbar * σ B * w.tbar) by group, hσd]
        apply cW_injective w
        rw [levQ_apply, hρ, cW_ιW, cW_ιW, D.lev_conj, toAdd_ofAdd]
      h₀ := actB w (w.projBar ⟨D.tor l, tor_mem_N w D l⟩)
      c := (l : K) ^ 3
      h₀_α := fun B => by
        simp only [MonoidHom.comp_apply, ← map_mul]
        rw [hhE _ (hσE B)]
      h₀_τ := by
        have hc : (⟨D.tor l, tor_mem_N w D l⟩ : w.N) * w.tN = w.tN * ⟨D.tor l, tor_mem_N w D l⟩ :=
          Subtype.ext (d.comm_t_of_mem (D.tor_mem l))
        rw [← map_mul, ← map_mul, show w.tbar = w.projBar w.tN from rfl, ← map_mul, ← map_mul,
          hc]
      h₀_ι := fun v => by
        apply cW_injective w
        rw [hρ, cW_ιW, cW_ιW]
        exact D.tor_conj l (Multiplicative.ofAdd v)
      c_ne_zero := pow_ne_zero _ l.ne_zero
      c_ne_one := hl
      h₀_pow := by
        rw [← map_pow, ← map_pow]
        have hlp : l ^ (Nat.card K - 1) = 1 := by
          classical
          rw [Nat.card_eq_fintype_card, ← Fintype.card_units]
          exact pow_card_eq_one
        have : (⟨D.tor l, tor_mem_N w D l⟩ : w.N) ^ (Nat.card K - 1) = 1 := by
          apply Subtype.ext
          rw [SubmonoidClass.coe_pow, ← map_pow, hlp, map_one]
          rfl
        rw [this, map_one, map_one] }
  obtain ⟨hdim, hinf, hsup, hXY, θ, hθι, hθnat⟩ := S.exists_decomp
  have hτ : ∀ m, cW w (S.τ m) = d.t * cW w m * d.t := hcWt
  have hα : ∀ B m, S.α B m = actB w (σ B) m := fun B m => rfl
  have hβ : ∀ B m, S.β B m = actB w (w.tbar * σ B * w.tbar) m := fun B m => by
    change actB w w.tbar (actB w (σ B) (actB w w.tbar m)) = _
    rw [hρmul, hρmul]
  have hfixXY : ∀ m, m ∈ S.fixY ↔ S.τ m ∈ S.fixX := fun m => by
    rw [hXY, S.τ_τ]
  have hmapτ : (toG w S.fixY).map (MulAut.conj d.t).toMonoidHom = toG w S.fixX := by
    ext g
    constructor
    · rintro ⟨_, ⟨m, hm, rfl⟩, rfl⟩
      refine ⟨S.τ m, (hfixXY m).mp hm, ?_⟩
      rw [hτ]
      simp [MulAut.conj_apply, htinv]
    · rintro ⟨m, hm, rfl⟩
      refine ⟨cW w (S.τ m), ⟨S.τ m, (hXY m).mp hm, rfl⟩, ?_⟩
      rw [hτ, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, htinv]
      rw [show d.t * (d.t * cW w m * d.t) * d.t = (d.t * d.t) * cW w m * (d.t * d.t) by group,
        d.t_mul_self, one_mul, mul_one]
  refine ⟨σ, toG w S.fixY, hσinj, hσE, hσc, hσd, hσO, hσXY, hσon, toG_le w _, ?_, ?_, ?_, ?_,
    ?_, ?_, ?_⟩
  ·
    rw [hmapτ, eq_bot_iff]
    rintro _ ⟨⟨m, hm, rfl⟩, hm'⟩
    have hm'' : m ∈ S.fixX := (cW_mem_toG w _ m).mp hm'
    have h0 : m ∈ S.fixY ⊓ S.fixX := Submodule.mem_inf.mpr ⟨hm, hm''⟩
    rw [hinf, Submodule.mem_bot] at h0
    rw [mem_bot, h0]
    rfl
  ·
    rw [hmapτ]
    refine le_antisymm (sup_le (toG_le w _) (toG_le w _)) fun g hg => ?_
    obtain ⟨m, rfl⟩ := exists_cW_eq w hg
    have hm : m ∈ S.fixY ⊔ S.fixX := hsup ▸ Submodule.mem_top
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hm
    rw [cW_add]
    exact mul_mem (mem_sup_left ⟨a, ha, rfl⟩) (mem_sup_right ⟨b, hb, rfl⟩)
  ·
    rw [card_toG, SwapData.natCard_submodule, hdim]
    change 2 ^ (2 * f) = (2 ^ f) ^ 2
    rw [← pow_mul, mul_comm]
  ·
    rintro n B hn _ ⟨m, hm, rfl⟩
    rw [← cW_actB, hn, ← hβ, (S.mem_fixY.mp hm) B]
  ·
    rintro n B hn y hy
    rw [hmapτ] at hy
    obtain ⟨m, hm, rfl⟩ := hy
    rw [← cW_actB, hn, ← hα, (S.mem_fixX.mp hm) B]
  ·
    rintro n B hn _ ⟨m, hm, rfl⟩
    have h1 : (n : G) * cW w m * (n : G)⁻¹ = cW w (S.α B m) := by
      rw [← cW_actB, hn, hα]
    rw [h1]
    refine ⟨⟨S.α B m, S.α_mem_fixY B hm, rfl⟩, ?_⟩
    rw [← hcWsub, ← hcWsub]
    change cW w (S.τ (S.α B m) - S.α B m) = D.lev B * cW w (S.τ m - m) * (D.lev B)⁻¹
    rw [← hθι ⟨S.α B m, S.α_mem_fixY B hm⟩, ← hθι ⟨m, hm⟩, hθnat B ⟨m, hm⟩]
    change D.ι (Multiplicative.ofAdd _) = D.lev B * D.ι (Multiplicative.ofAdd _) * (D.lev B)⁻¹
    rw [D.lev_conj, toAdd_ofAdd]
  ·
    intro v hv
    have hv' : v ∈ D.ι.range := by rw [D.range_ι]; exact hv
    obtain ⟨u, rfl⟩ := hv'
    set p := θ.symm (Multiplicative.toAdd u) with hp
    refine ⟨cW w (p : Additive w.WN), ⟨⟨p, p.2, rfl⟩, ?_⟩, ?_⟩
    · rw [← hcWsub]
      change cW w (S.τ p - p) = _
      rw [← hθι p, hp, AddEquiv.apply_symm_apply]
      rfl
    · rintro _ ⟨⟨m, hm, rfl⟩, hmv⟩
      rw [← hcWsub] at hmv
      change cW w (S.τ m - m) = _ at hmv
      rw [← hθι ⟨m, hm⟩] at hmv
      have h1 : θ ⟨m, hm⟩ = Multiplicative.toAdd u := by
        have := D.ι_injective hmv
        rw [← this]
        rfl
      have h2 : (⟨m, hm⟩ : S.fixY) = p := by
        rw [hp, ← h1, AddEquiv.symm_apply_apply]
      rw [← h2]

end Decomp

