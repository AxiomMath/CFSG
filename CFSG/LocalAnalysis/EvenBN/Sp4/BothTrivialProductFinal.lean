omit [Finite G] in
theorem map_conj_map_conj_of_mul_self {t : G} (htt : t * t = 1) (H : Subgroup G) :
    (H.map (MulAut.conj t).toMonoidHom).map (MulAut.conj t).toMonoidHom = H := by
  rw [Subgroup.map_map]
  have hid : (MulAut.conj t).toMonoidHom.comp (MulAut.conj t).toMonoidHom = MonoidHom.id G := by
    ext x
    simp only [MonoidHom.coe_comp, Function.comp_apply, MulEquiv.coe_toMonoidHom,
      MulAut.conj_apply, MonoidHom.id_apply]
    calc t * (t * x * t⁻¹) * t⁻¹ = (t * t) * x * (t * t)⁻¹ := by group
      _ = x := by rw [htt]; group
  rw [hid, Subgroup.map_id]

omit [Finite G] in
theorem mul_conj_conj_of_commutator {P : Subgroup G} {t y : G} (htt : t * t = 1)
    (hP : ⁅P, P.map (MulAut.conj t).toMonoidHom⁆ = ⊥) (hy : y ∈ P) :
    t * y * t⁻¹ * (t * (t * y * t⁻¹) * t⁻¹) = y * (t * y * t⁻¹) := by
  have hc : (t * y * t⁻¹) * y = y * (t * y * t⁻¹) :=
    mem_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hP hy) (t * y * t⁻¹)
      ⟨y, hy, rfl⟩
  have hyy : t * (t * y * t⁻¹) * t⁻¹ = y := by
    calc t * (t * y * t⁻¹) * t⁻¹ = (t * t) * y * (t * t)⁻¹ := by group
      _ = y := by rw [htt]; group
  rw [hyy, hc]

theorem nonempty_axisData (h : FCHyp L K n φ t)
    (hbt : ∀ i : Axis, ⁅𝐀[i], 𝐅 ⊓ 𝐃[i.swap]⁆ = ⊥) (i : Axis) (α : 𝐊[i] ≃* SL(2, K))
    (hP : ProductAlternative 𝐊[i] α (barMap 𝐗[i] ⟨t, t_mem_normalizer_X h i⟩)) :
    Nonempty (AxisData h i) := by
  obtain ⟨ρ, hρ, hker, hswap, β, hβ⟩ := exists_rho h hbt i α hP
  obtain ⟨P, hPΛ, hPperf, hPX, hPt, hPmax⟩ :=
    exists_perfect_commuting_factor h hbt i ρ hρ hker hswap β hβ
  exact ⟨⟨ρ, hρ, hker, hswap, β, hβ, P, hPΛ, hPperf, hPX, hPt, hPmax⟩⟩

theorem nonempty_axisData_swap (h : FCHyp L K n φ t)
    (hbt : ∀ i : Axis, ⁅𝐀[i], 𝐅 ⊓ 𝐃[i.swap]⁆ = ⊥) {i : Axis} (d : AxisData h i)
    (α' : 𝐊[i.swap] ≃* SL(2, K))
    (hex' : ExactClosure 𝐊[i.swap] α' (barMap 𝐗[i.swap] ⟨t, t_mem_normalizer_X h i.swap⟩)
      (barSub 𝐗[i.swap] 𝐒) n) :
    Nonempty (AxisData h i.swap) :=
  nonempty_axisData h hbt i.swap α' (productAlternative_swap h hbt i d.ρ d.surj d.ker d.swap d.β
    d.rho_s d.le d.perfect d.sup_X d.comm d.max α' hex')

theorem nonempty_crossData (h : FCHyp L K n φ t)
    (hbt : ∀ i : Axis, ⁅𝐀[i], 𝐅 ⊓ 𝐃[i.swap]⁆ = ⊥) (d₁ : AxisData h Axis.one)
    (d₂ : AxisData h Axis.two) : Nonempty (CrossData h) := by
  obtain ⟨hinf₁, hinf₂, hsyl⟩ := common_sylow h hbt d₁ d₂
  obtain ⟨hd₁, hs₁, -⟩ := diagonal_eq_CU h hbt Axis.one d₁.ρ d₁.surj d₁.ker d₁.swap d₁.β
    d₁.rho_s d₁.le d₁.perfect d₁.sup_X d₁.comm d₁.max
  obtain ⟨hd₂, hs₂, -⟩ := diagonal_eq_CU h hbt Axis.two d₂.ρ d₂.surj d₂.ker d₂.swap d₂.β
    d₂.rho_s d₂.le d₂.perfect d₂.sup_X d₂.comm d₂.max
  have htt : t * t = 1 := h.setup.t_mul_t
  rcases hsyl with hsyl | hsyl
  · exact ⟨⟨d₁.P, d₂.P, d₁.perfect, d₂.perfect, d₁.comm, d₂.comm, hinf₁, hinf₂,
      d₁.sup_map_conj_eq h hbt, d₂.sup_map_conj_eq h hbt, hd₁, hs₁, hd₂, hs₂, hsyl⟩⟩
  · refine ⟨⟨d₁.P, d₂.P.map (MulAut.conj t).toMonoidHom, d₁.perfect, ?_, d₁.comm, ?_, hinf₁, ?_,
      d₁.sup_map_conj_eq h hbt, ?_, hd₁, hs₁, ?_, ?_, hsyl⟩⟩
    · rw [← Subgroup.map_commutator, d₂.perfect]
    · rw [map_conj_map_conj_of_mul_self htt]
      exact (commutator_comm _ _).trans d₂.comm
    · rw [map_conj_map_conj_of_mul_self htt]
      exact (inf_comm _ _).trans hinf₂
    · rw [map_conj_map_conj_of_mul_self htt]
      exact (sup_comm _ _).trans (d₂.sup_map_conj_eq h hbt)
    · rintro _ ⟨y, hy, rfl⟩
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      rw [mul_conj_conj_of_commutator htt d₂.comm hy]
      exact hd₂ y hy
    · intro z hz
      obtain ⟨y, hy, rfl⟩ := hs₂ z hz
      exact ⟨t * y * t⁻¹, ⟨y, hy, rfl⟩, mul_conj_conj_of_commutator htt d₂.comm hy⟩

def CrossData.F {h : FCHyp L K n φ t} (c : CrossData h) : Axis → Subgroup G
  | Axis.one => c.P₁
  | Axis.two => c.P₂

omit [Finite G] [Finite K] in
theorem CrossData.iSup_F {h : FCHyp L K n φ t} (c : CrossData h) :
    (⨆ k, c.F k) = c.P₁ ⊔ c.P₂ :=
  le_antisymm (iSup_le fun k => by cases k; exacts [le_sup_left, le_sup_right])
    (sup_le (le_iSup c.F Axis.one) (le_iSup c.F Axis.two))

theorem CrossData.diag_facts (h : FCHyp L K n φ t)
    (hbt : ∀ i : Axis, ⁅𝐀[i], 𝐅 ⊓ 𝐃[i.swap]⁆ = ⊥) (c : CrossData h) :
    CFSG.Open.IsQuasisimple (⨆ k, c.F k : Subgroup G) ∧
      (⨆ k, c.F k).map (MulAut.conj t).toMonoidHom ≤
        centralizer ((⨆ k, c.F k : Subgroup G) : Set G) ∧
      (∀ x ∈ ⨆ k, c.F k, x * (t * x * t⁻¹) ∈ L) ∧
      ∀ y ∈ L, ∃ x ∈ ⨆ k, c.F k, x * (t * x * t⁻¹) = y := by
  have htt : t * t = 1 := h.setup.t_mul_t
  obtain ⟨hsimple, -⟩ := CFSG.Quasithin.F7Two.isSimpleGroup_antiSp (K := K) h.four_le_card
  haveI := hsimple
  have hL : IsSimpleGroup L := φ.isSimpleGroup
  have hcross := commutator_cross_eq_bot h hbt c
  have hcomm : ∀ k l, (c.F l).map (MulAut.conj t).toMonoidHom ≤ centralizer (c.F k : Set G) := by
    intro k l
    cases k <;> cases l <;> simp only [CrossData.F]
    · exact commutator_eq_bot_iff_le_centralizer.mp ((commutator_comm _ _).trans c.comm₁)
    · exact commutator_eq_bot_iff_le_centralizer.mp ((commutator_comm _ _).trans hcross)
    · have h' := congrArg (Subgroup.map (MulAut.conj t).toMonoidHom) hcross
      rw [Subgroup.map_commutator, map_conj_map_conj_of_mul_self htt, Subgroup.map_bot] at h'
      exact commutator_eq_bot_iff_le_centralizer.mp h'
    · exact commutator_eq_bot_iff_le_centralizer.mp ((commutator_comm _ _).trans c.comm₂)
  have hgen : (⨆ k : Axis, (L ⊓ centralizer (𝐔[k] : Set G) : Subgroup G)) = L := by
    have h2 : (⨆ k : Axis, (L ⊓ centralizer (𝐔[k] : Set G) : Subgroup G)) =
        (L ⊓ centralizer (𝐔[Axis.one] : Set G)) ⊔ (L ⊓ centralizer (𝐔[Axis.two] : Set G)) :=
      le_antisymm (iSup_le fun k => by cases k; exacts [le_sup_left, le_sup_right])
        (sup_le (le_iSup (fun k : Axis => (L ⊓ centralizer (𝐔[k] : Set G) : Subgroup G)) Axis.one)
          (le_iSup (fun k : Axis => (L ⊓ centralizer (𝐔[k] : Set G) : Subgroup G)) Axis.two))
    rw [h2, CU_eq, CU_eq, ← pull_sup, ProductModel.rootC_sup_rootC h.four_le_card, pull,
      Subgroup.comap_top, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  exact CFSG.SeitzReduction.SeitzQ2.isQuasisimple_iSup_of_diag hL c.F
    (fun k => (L ⊓ centralizer (𝐔[k] : Set G) : Subgroup G)) hcomm
    (fun k => by cases k; exacts [c.perfect₁, c.perfect₂])
    (fun k => by cases k; exacts [c.diag₁, c.diag₂])
    (fun k => by cases k; exacts [c.diag_surj₁, c.diag_surj₂]) hgen

theorem CrossData.odd_card_center (h : FCHyp L K n φ t)
    (hbt : ∀ i : Axis, ⁅𝐀[i], 𝐅 ⊓ 𝐃[i.swap]⁆ = ⊥) (c : CrossData h) :
    Odd (Nat.card (center (⨆ k, c.F k : Subgroup G))) := by
  have htt : t * t = 1 := h.setup.t_mul_t
  have hti : t⁻¹ = t := inv_eq_of_mul_eq_one_right htt
  obtain ⟨-, h₁₂, hδ, hsurj⟩ := c.diag_facts h hbt
  set G₀ : Subgroup G := ⨆ k, c.F k with hG₀
  have hcomm : ⁅G₀, G₀.map (MulAut.conj t⁻¹).toMonoidHom⁆ = ⊥ := by
    rw [hti, commutator_comm]
    exact commutator_eq_bot_iff_le_centralizer.mpr h₁₂
  have hval : ∀ a : G₀, Common.diagonalHom G₀ t hcomm a = (a : G) * (t * a * t⁻¹) := by
    intro a
    rw [Common.diagonalHom_apply, hti]
  have hrange : (Common.diagonalHom G₀ t hcomm).range = L := by
    ext y
    constructor
    · rintro ⟨a, rfl⟩
      rw [hval]
      exact hδ a a.2
    · intro hy
      obtain ⟨x, hx, rfl⟩ := hsurj y hy
      exact ⟨⟨x, hx⟩, hval ⟨x, hx⟩⟩
  have hker : Odd (Nat.card (Common.diagonalHom G₀ t hcomm).ker) := by
    refine Common.odd_card_ker_diagonalHom_of_centralizer_le hcomm htt ?_ ?_
    · rw [hrange, h.setup.cent_inf]
    · rw [hrange]
      obtain ⟨-, x, y, hxy⟩ := CFSG.Quasithin.F7Two.isSimpleGroup_antiSp (K := K) h.four_le_card
      refine ⟨(φ.symm x : G), (φ.symm x).2, (φ.symm y : G), (φ.symm y).2, fun hc => hxy ?_⟩
      have hc' : φ.symm (x * y) = φ.symm (y * x) := by
        rw [map_mul, map_mul]
        exact Subtype.ext (by simpa only [Subgroup.coe_mul] using hc)
      exact φ.symm.injective hc'
  have hZ : center G₀ ≤ (Common.diagonalHom G₀ t hcomm).ker := by
    intro z hz
    rw [MonoidHom.mem_ker]
    have hzL : (Common.diagonalHom G₀ t hcomm z : G) ∈ L := hrange ▸ ⟨z, rfl⟩
    refine GomiFusion.eq_one_of_mem_centralizer φ hzL ?_
    rw [mem_centralizer_iff]
    intro y hy
    rw [← hrange] at hy
    obtain ⟨a, rfl⟩ := hy
    rw [← map_mul, ← map_mul, mem_center_iff.mp hz a]
  exact hker.of_dvd_nat (Subgroup.card_dvd_of_le hZ)

theorem CrossData.sup_map_conj (h : FCHyp L K n φ t) (c : CrossData h) :
    (⨆ k, c.F k) ⊔ (⨆ k, c.F k).map (MulAut.conj t).toMonoidHom =
      𝐍𝐂[Axis.one] ⊔ 𝐍𝐂[Axis.two] := by
  rw [c.iSup_F, Subgroup.map_sup, sup_sup_sup_comm, c.sup₁, c.sup₂]

theorem false_of_product [IsSimpleGroup G] (h : FCHyp L K n φ t)
    (hbt : ∀ i : Axis, ⁅𝐀[i], 𝐅 ⊓ 𝐃[i.swap]⁆ = ⊥) (i : Axis) (α : 𝐊[i] ≃* SL(2, K))
    (hP : ProductAlternative 𝐊[i] α (barMap 𝐗[i] ⟨t, t_mem_normalizer_X h i⟩))
    (α' : 𝐊[i.swap] ≃* SL(2, K))
    (hex' : ExactClosure 𝐊[i.swap] α' (barMap 𝐗[i.swap] ⟨t, t_mem_normalizer_X h i.swap⟩)
      (barSub 𝐗[i.swap] 𝐒) n) : False := by
  obtain ⟨d⟩ := nonempty_axisData h hbt i α hP
  obtain ⟨d'⟩ := nonempty_axisData_swap h hbt d α' hex'
  have key : Nonempty (AxisData h Axis.one) ∧ Nonempty (AxisData h Axis.two) := by
    cases i
    · exact ⟨⟨d⟩, ⟨d'⟩⟩
    · exact ⟨⟨d'⟩, ⟨d⟩⟩
  obtain ⟨⟨d₁⟩, ⟨d₂⟩⟩ := key
  obtain ⟨c⟩ := nonempty_crossData h hbt d₁ d₂
  obtain ⟨hq, h₁₂, hδ, hsurj⟩ := c.diag_facts h hbt
  refine BothTrivialProductEnd.false_of_swap h.setup hq (c.odd_card_center h hbt) h₁₂ hδ hsurj
    (isSylowOf_Q h) ?_
  rw [c.sup_map_conj h]
  exact normalizer_Q_le_normalizer_NC h hbt

