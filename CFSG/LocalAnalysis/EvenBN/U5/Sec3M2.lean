theorem exists_sylow_eq_zpowers_of_card_le {H : Type*} [Group H] [Finite H] {A : Subgroup H}
    {t : H} (ht : orderOf t = 2) (htA : t ∈ centralizer (A : Set H))
    (hrank : ∀ P : Subgroup H, P ≤ centralizer (A : Set H) ⊓ centralizer ({t} : Set H) →
      IsPGroup 2 P → Nat.card P ≤ 2) :
    ∃ S : Sylow 2 ↥(centralizer (A : Set H) ⊓ centralizer ({t} : Set H)),
      (S : Subgroup _).map (centralizer (A : Set H) ⊓ centralizer ({t} : Set H)).subtype =
        zpowers t := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set C := centralizer (A : Set H) ⊓ centralizer ({t} : Set H)
  have htC : zpowers t ≤ C := zpowers_le.2 ⟨htA, mem_centralizer_singleton_iff.2 rfl⟩
  have hz2 : IsPGroup 2 (zpowers t) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, ht, pow_one])
  obtain ⟨S, hS⟩ := (hz2.of_equiv (subgroupOfEquivOfLe htC).symm).exists_le_sylow
  refine ⟨S, (eq_of_le_of_card_ge ?_ ?_).symm⟩
  · intro x hx
    exact ⟨⟨x, htC hx⟩, hS hx, rfl⟩
  · rw [Nat.card_zpowers, ht]
    exact hrank _ (map_subtype_le _) (S.isPGroup'.map _)

end Generic

section SU3

variable {f : ℕ} {K : Type} [Field K]

theorem quasisimple_lieModel_of_mulEquiv (h : UnitaryFieldData 2 f K) (hf : 2 ≤ f) {X : Type}
    [Group X] (e : X ≃* unitarySU 2 f K (2 * 1 + 1)) :
    CFSG.Open.IsQuasisimple X ∧ LieModel (X ⧸ center X) .PSU 3 2 f := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have := h.finite
  have hne : ((2 * 1 + 1 : ℕ), 2 ^ f) ≠ (3, 2) := by
    intro e'
    have h2 : 2 ^ f = 2 ^ 1 := congrArg Prod.snd e'
    have := Nat.pow_right_injective (le_refl 2) h2
    omega
  obtain ⟨hq, hZ⟩ := CFSG.LieType.Universal.Unitary.isQuasisimple_statedSU_of_card (F := K)
    (p := 2) (f := f) (n := 2 * 1 + 1) h.card_eq_sq (by norm_num) hne
  have hX := CFSG.LieType.Universal.Unitary.isQuasisimple_of_mulEquiv e.symm hq
  refine ⟨⟨hX.1.commutator_eq_top, hX.2.1⟩, ?_⟩
  have e' : X ⧸ center X ≃* CFSG.Assembly.LowTwoRank.StatedProj
      (CFSG.Assembly.LowTwoRank.StatedSU (2 * 1 + 1) (2 ^ f) K) :=
    (QuotientGroup.congr _ _ e (CFSG.LieType.Universal.Unitary.map_center_mulEquiv e)).trans
      (QuotientGroup.quotientMulEquivOfEq hZ)
  exact Or.inl ⟨by decide, ⟨h.prime, h.one_le, le_rfl, hne⟩, K, inferInstance, h.finite,
    h.card_eq_sq, ⟨e'⟩⟩

end SU3

