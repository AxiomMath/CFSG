variable {G : Type} [Group G] [Finite G] {f : ℕ} {K : Type} [Field K]
  {h : UnitaryFieldData 2 f K} {d : Data G h}

@[expose] def M₂ (d : Data G h) : Subgroup G :=
  (normalClosure ((d.N₂.subgroupOf (centralizer (d.I₂ : Set G)) :
    Subgroup (centralizer (d.I₂ : Set G))) : Set (centralizer (d.I₂ : Set G)))).map
    (centralizer (d.I₂ : Set G)).subtype

omit [Finite G] in
theorem N₂_le_centralizer_I₂ (d : Data G h) : d.N₂ ≤ centralizer (d.I₂ : Set G) := by
  rintro _ ⟨n, hn, rfl⟩
  refine mem_centralizer_iff.2 ?_
  rintro _ ⟨i, hi, rfl⟩
  rw [← map_mul, ← map_mul, N₂sub_comm_I₂sub hn hi]

theorem Hyp.t_mem_centralizer_I₂ (hd : d.Hyp) : d.t ∈ centralizer (d.I₂ : Set G) :=
  mem_centralizer_iff.2 fun _ hs => hd.comm_t (d.pull_le_L _ hs)

theorem Hyp.quasisimple_lieModel_N₂ (hd : d.Hyp) {X : Type} [Group X] (hX : Nonempty (X ≃* d.N₂)) :
    CFSG.Open.IsQuasisimple X ∧ LieModel (X ⧸ center X) .PSU 3 2 f := by
  obtain ⟨R, hR⟩ := exists_isHypTransport (r := 1) (ε := 1) h
  obtain ⟨e⟩ := hX
  exact quasisimple_lieModel_of_mulEquiv h hd.two_le
    ((e.trans d.N₂equiv.symm).trans (hypTransport h hR))

omit [Finite G] in
theorem act_I₂_of_mem_centralizer (d : Data G h) {c : G} (hcL : c ∈ normalizer (d.L : Set G))
    {y : Gam h} (hy : Phi h y = d.act ⟨c, hcL⟩) (hc : c ∈ centralizer (d.I₂ : Set G)) :
    ∀ i ∈ I₂sub h, ∃ s ∈ hypScalars h 2 1, actΓ h y i = s * i := by
  intro i hi
  have e : d.η (actΓ h y i) = d.η i := by
    rw [← d.conj_η_eq hcL hy, ← mem_centralizer_iff.1 hc _ ⟨i, hi, rfl⟩, mul_inv_cancel_right]
  refine ⟨actΓ h y i * i⁻¹, ?_, by group⟩
  rw [← d.η_eq_one_iff, map_mul, map_inv, e, mul_inv_cancel]

theorem Hyp.conj_mem_N₂ (hd : d.Hyp) {c : G} (hc : c ∈ centralizer (d.I₂ : Set G))
    (hct : c ∈ centralizer ({d.t} : Set G)) {n : G} (hn : n ∈ d.N₂) : c * n * c⁻¹ ∈ d.N₂ := by
  have hcL := hd.centralizer_le_normalizer hct
  obtain ⟨y, hy⟩ := Phi_surjective h (d.act ⟨c, hcL⟩)
  obtain ⟨-, -, -, -, -, -, -, -, -, hblk⟩ :=
    exists_fixed_I₂ hd.two_le (d.act_I₂_of_mem_centralizer hcL hy hc)
  obtain ⟨n', hn', rfl⟩ := hn
  rw [d.conj_η_eq hcL hy]
  exact ⟨_, act_mem_N₂sub (fun c' hc1 hc4 => ⟨(hblk c' hc1 hc4).2.2.1, (hblk c' hc1 hc4).2.2.2⟩)
    hn', rfl⟩

theorem Hyp.card_le_two_of_centralizes (hd : d.Hyp) {X : Subgroup G}
    (hX : X ≤ centralizer (d.I₂ : Set G) ⊓ centralizer (d.N₂ : Set G) ⊓
      centralizer ({d.t} : Set G)) (h2 : IsPGroup 2 X) : Nat.card X ≤ 2 := by
  have hXt : X ≤ zpowers d.t := by
    intro x hx
    obtain ⟨⟨hxI, hxN⟩, hxt⟩ := hX hx
    have hxL := hd.centralizer_le_normalizer hxt
    obtain ⟨y, hy⟩ := Phi_surjective h (d.act ⟨x, hxL⟩)
    have hI := d.act_I₂_of_mem_centralizer hxL hy hxI
    obtain ⟨-, -, -, -, -, -, -, -, -, hblk⟩ := exists_fixed_I₂ hd.two_le hI
    have hcol : ∀ c, c ≠ ιe₁ → c ≠ ιf₁ → lmat y c ιe₁ = 0 ∧ lmat y c ιf₁ = 0 :=
      fun c hc1 hc4 => ⟨(hblk c hc1 hc4).2.2.1, (hblk c hc1 hc4).2.2.2⟩
    have hN : ∀ n ∈ N₂sub h, actΓ h y n = n := by
      intro n hn
      have e : d.η (actΓ h y n) = d.η n := by
        rw [← d.conj_η_eq hxL hy, ← mem_centralizer_iff.1 hxN _ ⟨n, hn, rfl⟩,
          mul_inv_cancel_right]
      have hm : actΓ h y n * n⁻¹ ∈ N₂sub h ⊓ hypScalars h 2 1 := by
        refine Subgroup.mem_inf.2 ⟨mul_mem (act_mem_N₂sub hcol hn) (inv_mem hn), ?_⟩
        rw [← d.η_eq_one_iff, map_mul, map_inv, e, mul_inv_cancel]
      rw [N₂sub_inf_hypScalars, mem_bot] at hm
      exact mul_inv_eq_one.1 hm
    obtain ⟨k, hk⟩ := h2 ⟨x, hx⟩
    have hxk : x ^ 2 ^ k = 1 := by simpa using congrArg Subtype.val hk
    have hk' : Phi h y ^ 2 ^ k = 1 := by
      have e : (⟨x, hxL⟩ : normalizer (d.L : Set G)) ^ 2 ^ k = 1 :=
        Subtype.ext (by simpa using hxk)
      rw [hy, ← map_pow, e, map_one]
    have hPhi := Phi_eq_one_of_centralizes_I₂N₂ hd.two_le hI hN hk'
    have hxC : x ∈ centralizer (d.L : Set G) := (d.act_eq_one_iff _).1 (by rw [← hy, hPhi])
    rw [← hd.sec3_1'.1]
    exact ⟨hxC, hxt⟩
  calc Nat.card X ≤ Nat.card (zpowers d.t) := Subgroup.card_le_of_le hXt
    _ = 2 := hd.card_zpowers_t

omit [Finite G] in
theorem mem_I₂_of_comm_N₂ (d : Data G h) {z : G} (hz : z ∈ d.N₂)
    (hc : ∀ n ∈ d.N₂, z * n = n * z) : z ∈ d.I₂ := by
  obtain ⟨g, hg, rfl⟩ := hz
  refine ⟨g, mem_I₂sub_of_comm_N₂sub hg fun n hn => ?_, rfl⟩
  have e : d.η (g * n * (n * g)⁻¹) = 1 := by
    simp only [map_mul, map_inv]
    rw [hc _ ⟨n, hn, rfl⟩, mul_inv_cancel]
  have hm : g * n * (n * g)⁻¹ ∈ N₂sub h ⊓ hypScalars h 2 1 :=
    Subgroup.mem_inf.2 ⟨mul_mem (mul_mem hg hn) (inv_mem (mul_mem hn hg)), (d.η_eq_one_iff _).1 e⟩
  rw [N₂sub_inf_hypScalars, mem_bot] at hm
  exact mul_inv_eq_one.1 hm

omit [Finite G] in
theorem I₂_le_centralizer_I₂ (d : Data G h) : d.I₂ ≤ centralizer (d.I₂ : Set G) :=
  fun _ hi => mem_centralizer_iff.2 fun _ hj =>
    d.I_comm (d.pull_mono (torusEq_le _) hj) (d.pull_mono (torusEq_le _) hi)

omit [Finite G] in
theorem I₂_le_oddCore (d : Data G h) :
    d.I₂.subgroupOf (centralizer (d.I₂ : Set G)) ≤
      standardComponentOddCore (centralizer (d.I₂ : Set G)) := by
  refine le_sSup ⟨⟨fun n hn g => ?_⟩, ?_⟩
  · rw [mem_subgroupOf] at hn ⊢
    have e := mem_centralizer_iff.1 g.2 _ hn
    simp only [coe_mul, coe_inv]
    rw [← e, mul_inv_cancel_right]
    exact hn
  · rw [Nat.card_congr (subgroupOfEquivOfLe d.I₂_le_centralizer_I₂).toEquiv]
    exact Odd.of_dvd_nat d.odd_card_I (card_dvd_of_le (d.pull_mono (torusEq_le _)))

theorem Hyp.centralizer_I₂_ne_top (hd : d.Hyp) : centralizer (d.I₂ : Set G) ≠ ⊤ := by
  intro htop
  have := finite_fixedField h
  have := charP_fixedField h
  have hK2 : 2 < Nat.card h.fixedField := by
    rw [h.card_fixedField]
    have := hd.four_le
    omega
  obtain ⟨b, hb0, hb1⟩ := exists_ne_zero_ne_one hK2
  have hb0' : (b : K) ≠ 0 := fun e0 => hb0 (Subtype.ext e0)
  obtain ⟨j, hj, e1, e2, e3, e4, e5⟩ := exists_jSU h hb0' (h.mem_fixedField.1 b.2)
  have hjI : d.η j ∈ d.I₂ := ⟨j, mem_I₂sub.2 ⟨hj, e2.trans e3.symm, e3.trans e5.symm⟩, rfl⟩
  have hz : (d.ιZp (Multiplicative.ofAdd 1) : G) ∈ centralizer (d.I₂ : Set G) :=
    htop ▸ mem_top _
  have hc := mem_centralizer_iff.1 hz _ hjI
  have e := d.conj_ιZp_torus hj e1 e4 1
  rw [hc, mul_inv_cancel_right] at e
  have e' := d.ιZp.injective (Subtype.ext e)
  have hbb : b * b * 1 = 1 := by simpa using (congrArg Multiplicative.toAdd e').symm
  have : (b - 1) * (b - 1) = 0 := by
    linear_combination hbb + (1 - b) * (CharTwo.two_eq_zero : (2 : h.fixedField) = 0)
  exact hb1 (sub_eq_zero.1 (mul_self_eq_zero.1 this))

omit [Finite G] in
theorem C₅_le_N₅ (d : Data G h) :
    d.pull (patSub h sI₅ isPattern_sI₅) ≤ d.N₅ := d.pull_mono patSub_I₅_le_N₅sub

theorem Hyp.exists_V_eq_commutator_mul (hd : d.Hyp) :
    ∃ j ∈ d.N₅ ⊓ d.I, ∀ v ∈ d.V, ∃ v₀ ∈ d.V, ∃ z ∈ d.Zp, v = j * v₀ * j⁻¹ * v₀⁻¹ * z := by
  have := finite_fixedField h
  have := charP_fixedField h
  have hK2 : 2 < Nat.card h.fixedField := by
    rw [h.card_fixedField]
    have := hd.four_le
    omega
  obtain ⟨b, hb0, hb1⟩ := exists_ne_zero_ne_one hK2
  have hb0' : (b : K) ≠ 0 := fun e0 => hb0 (Subtype.ext e0)
  obtain ⟨j, hj, e1, e2, -, e4, e5⟩ := exists_jSU h hb0' (h.mem_fixedField.1 b.2)
  have hjI : d.η j ∈ d.I := ⟨j, hj, rfl⟩
  refine ⟨d.η j, ⟨⟨j, torus_mem_N₅sub hj e2 e5, rfl⟩, hjI⟩, fun v hv => ?_⟩
  set l := b * b with hl
  have hl1 : l - 1 ≠ 0 := by
    intro e0
    have : (b - 1) * (b - 1) = 0 := by
      linear_combination e0 + (1 - b) * (CharTwo.two_eq_zero : (2 : h.fixedField) = 0)
    exact hb1 (sub_eq_zero.1 (mul_self_eq_zero.1 this))
  have hVB : d.V ≤ d.B₄ := hd.V_le_CB₄I₃.trans d.CB₄I₃_le
  obtain ⟨m, hm⟩ := d.ιZp.surjective ⟨v⁻¹ * d.t * v * d.t, hd.cr_mem (hVB hv)⟩
  set c := Multiplicative.toAdd m with hc
  have hvc : v⁻¹ * d.t * v * d.t = d.ιZp (Multiplicative.ofAdd c) := by
    rw [hc, ofAdd_toAdd, hm]
  obtain ⟨v₀, hv₀, hv₀t⟩ := hd.exists_V_cr_eq (d.ιZp (Multiplicative.ofAdd (c / (l - 1)))).2
  have hjv : d.η j * v₀ * (d.η j)⁻¹ ∈ d.V :=
    (mem_normalizer_iff.1 (hd.I_le_normalizer_V hjI) v₀).1 hv₀
  set w := d.η j * v₀ * (d.η j)⁻¹ * v₀⁻¹ with hw
  have hwV : w ∈ d.V := mul_mem hjv (inv_mem hv₀)
  have hjt : d.η j * d.t = d.t * d.η j :=
    (mem_centralizer_singleton_iff.1 (hd.I_le_H hjI).2)
  have hwt : w⁻¹ * d.t * w * d.t = v⁻¹ * d.t * v * d.t := by
    rw [hw, hd.cr_mul (hVB hjv) (inv_mem (hVB hv₀)), hd.cr_inv (hVB hv₀),
      CFSG.EvenSmallLie.UnitarySix.YamadaD.crossed_conj hjt, hv₀t, d.conj_ιZp_torus hj e1 e4,
      d.coe_ιZp_mul_inv, hvc]
    congr 3
    field_simp
    ring
  refine ⟨v₀, hv₀, w⁻¹ * v, ?_, by rw [mul_inv_cancel_left]⟩
  rw [← hd.V_inf_B₂]
  refine Subgroup.mem_inf.2 ⟨mul_mem (inv_mem hwV) hv,
    (hd.cr_eq_one_iff (mul_mem (inv_mem (hVB hwV)) (hVB hv))).1 ?_⟩
  rw [hd.cr_mul (inv_mem (hVB hwV)) (hVB hv), hd.cr_inv (hVB hwV), hwt, inv_mul_cancel]

theorem Hyp.V_le_centralizer_I₅ (hd : d.Hyp) : d.V ≤ centralizer (d.I₅ : Set G) :=
  (hd.V_le_CB₄I₃.trans inf_le_right).trans
    (Subgroup.centralizer_le (SetLike.coe_subset_coe.2 d.I₅_le_I₃))

omit [Finite G] in
theorem r_mul_r (d : Data G h) : d.r * d.r = 1 := by
  rw [← sq, ← d.orderOf_r, pow_orderOf_eq_one]

omit [Finite G] in
theorem conj_r_mem_centralizer_I₂ (d : Data G h) {x : G}
    (hx : x ∈ centralizer (d.I₅ : Set G)) : d.r * x * d.r⁻¹ ∈ centralizer (d.I₂ : Set G) := by
  have hr : d.r⁻¹ = d.r := inv_eq_of_mul_eq_one_right d.r_mul_r
  refine mem_centralizer_iff.2 fun i hi => ?_
  have hi5 : d.r * i * d.r⁻¹ ∈ d.I₅ := by
    rw [d.sec2_1_five.2.2.2.2.1]
    exact ⟨i, hi, rfl⟩
  have e := mem_centralizer_iff.1 hx _ hi5
  have e' : d.r⁻¹ * i * d.r * x = x * (d.r⁻¹ * i * d.r) := by
    have h1 : d.r⁻¹ * i * d.r = d.r * i * d.r⁻¹ := by rw [hr]
    rw [h1]
    exact e
  calc i * (d.r * x * d.r⁻¹) = d.r * (d.r⁻¹ * i * d.r * x) * d.r⁻¹ := by group
    _ = d.r * (x * (d.r⁻¹ * i * d.r)) * d.r⁻¹ := by rw [e']
    _ = d.r * x * d.r⁻¹ * i := by group

omit [Finite G] in
theorem conj_r_mem_N₂ (d : Data G h) {x : G} (hx : x ∈ d.N₅) : d.r * x * d.r⁻¹ ∈ d.N₂ := by
  rw [d.N₅_eq] at hx
  obtain ⟨n, hn, rfl⟩ := hx
  have hr : d.r⁻¹ = d.r := inv_eq_of_mul_eq_one_right d.r_mul_r
  simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, hr]
  have e : d.r * (d.r * n * d.r) * d.r = (d.r * d.r) * n * (d.r * d.r) := by group
  rw [e, d.r_mul_r, one_mul, mul_one]
  exact hn

theorem Hyp.not_normal_image_N₂ (hd : d.Hyp) :
    ¬ ((d.N₂.subgroupOf (centralizer (d.I₂ : Set G))).map
      (QuotientGroup.mk' (standardComponentOddCore (centralizer (d.I₂ : Set G))))).Normal := by
  intro hnorm
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set H := centralizer (d.I₂ : Set G) with hH
  set O := standardComponentOddCore H with hO
  set J := d.N₂.subgroupOf H with hJ
  set N' := (J.map (QuotientGroup.mk' O)).comap (QuotientGroup.mk' O) with hN'
  have hN'n : N'.Normal := Subgroup.normal_comap _
  have hN'eq : N' = J ⊔ O := by rw [hN', comap_map_eq, QuotientGroup.ker_mk']
  have hN₂H : d.N₂ ≤ H := d.N₂_le_centralizer_I₂
  have hmemJ : ∀ x (hx : x ∈ d.N₅), (⟨d.r * x * d.r⁻¹, hN₂H (d.conj_r_mem_N₂ hx)⟩ : H) ∈ N' :=
    fun x hx => hN'eq ▸ mem_sup_left (mem_subgroupOf.2 (d.conj_r_mem_N₂ hx))
  have hC₅N₅ : d.P ⊓ centralizer (d.I₅ : Set G) ≤ d.N₅ := by
    rw [hd.P_inf_centralizer_I₅]
    exact d.C₅_le_N₅
  have hC₅I₅ : d.P ⊓ centralizer (d.I₅ : Set G) ≤ centralizer (d.I₅ : Set G) := inf_le_right
  obtain ⟨j, hj, hjV⟩ := hd.exists_V_eq_commutator_mul
  have hVN' : ∀ v (hv : v ∈ d.V),
      (⟨d.r * v * d.r⁻¹, d.conj_r_mem_centralizer_I₂ (hd.V_le_centralizer_I₅ hv)⟩ : H) ∈ N' := by
    intro v hv
    obtain ⟨v₀, hv₀, z, hz, rfl⟩ := hjV v hv
    set j' : H := ⟨d.r * j * d.r⁻¹, hN₂H (d.conj_r_mem_N₂ hj.1)⟩ with hj'
    set v' : H := ⟨d.r * v₀ * d.r⁻¹, d.conj_r_mem_centralizer_I₂ (hd.V_le_centralizer_I₅ hv₀)⟩
      with hv'
    have hzN₅ : z ∈ d.N₅ := hC₅N₅ (hd.Zp_le_C₅ hz)
    set z' : H := ⟨d.r * z * d.r⁻¹, hN₂H (d.conj_r_mem_N₂ hzN₅)⟩ with hz'
    have e : (⟨d.r * (j * v₀ * j⁻¹ * v₀⁻¹ * z) * d.r⁻¹,
        d.conj_r_mem_centralizer_I₂ (hd.V_le_centralizer_I₅ hv)⟩ : H) =
        j' * (v' * j'⁻¹ * v'⁻¹) * z' := by
      apply Subtype.ext
      simp only [hj', hv', hz', coe_mul, coe_inv]
      group
    rw [e]
    have hj'N : j' ∈ N' := hmemJ j hj.1
    exact mul_mem (mul_mem hj'N (hN'n.conj_mem _ (inv_mem hj'N) v')) (hmemJ z hzN₅)
  set X : Subgroup G := (d.V ⊔ (d.P ⊓ centralizer (d.I₅ : Set G))).map
    (MulAut.conj d.r).toMonoidHom with hX
  have hXH : X ≤ H := by
    rintro _ ⟨x, hx, rfl⟩
    exact d.conj_r_mem_centralizer_I₂ ((sup_le hd.V_le_centralizer_I₅ hC₅I₅) hx)
  have hXN' : X.subgroupOf H ≤ N' := by
    have hVH : d.V.map (MulAut.conj d.r).toMonoidHom ≤ H := by
      rintro _ ⟨x, hx, rfl⟩
      exact d.conj_r_mem_centralizer_I₂ (hd.V_le_centralizer_I₅ hx)
    have hCH : (d.P ⊓ centralizer (d.I₅ : Set G)).map (MulAut.conj d.r).toMonoidHom ≤ H := by
      rintro _ ⟨x, hx, rfl⟩
      exact d.conj_r_mem_centralizer_I₂ (hC₅I₅ hx)
    rw [hX, Subgroup.map_sup, subgroupOf_sup hVH hCH]
    refine sup_le (fun x hx => ?_) (fun x hx => ?_)
    · rw [mem_subgroupOf] at hx
      obtain ⟨v, hv, hvx⟩ := hx
      have e : x = ⟨d.r * v * d.r⁻¹, d.conj_r_mem_centralizer_I₂ (hd.V_le_centralizer_I₅ hv)⟩ :=
        Subtype.ext hvx.symm
      rw [e]
      exact hVN' v hv
    · rw [mem_subgroupOf] at hx
      obtain ⟨c, hc, hcx⟩ := hx
      have e : x = ⟨d.r * c * d.r⁻¹, hN₂H (d.conj_r_mem_N₂ (hC₅N₅ hc))⟩ := Subtype.ext hcx.symm
      rw [e]
      exact hmemJ c (hC₅N₅ hc)
  have hcardX : Nat.card (X.subgroupOf H) = (2 ^ f) ^ 4 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hXH).toEquiv, hX,
      card_map_of_injective (MulAut.conj d.r).injective, hd.card_V_sup_C₅.2]
  have h1 : (2 ^ f) ^ 4 ∣ Nat.card N' := hcardX ▸ card_dvd_of_le hXN'
  have hJO : J ≤ normalizer (O : Set H) := by
    rw [normalizer_eq_top_iff.2 (GMSK.standardComponentOddCore_normal H)]
    exact le_top
  have h2 := card_sup_mul_card_inf_eq hJO
  rw [sup_comm, ← hN'eq] at h2
  have h3 : (2 ^ f) ^ 4 ∣ Nat.card J * Nat.card O := h1.trans ⟨_, (h2.trans (mul_comm _ _)).symm⟩
  have hcop : Nat.Coprime ((2 ^ f) ^ 4) (Nat.card O) :=
    Nat.Coprime.pow_left _ (Nat.Coprime.pow_left _
      (Nat.coprime_two_left.2 (GMSK.odd_card_standardComponentOddCore H)))
  have h4 : (2 ^ f) ^ 4 ∣ Nat.card (hypSU h 1 1) := by
    have h5 := hcop.dvd_of_dvd_mul_right h3
    rwa [Nat.card_congr (subgroupOfEquivOfLe hN₂H).toEquiv,
      Nat.card_congr d.N₂equiv.symm.toEquiv] at h5
  obtain ⟨hU, ⟨Q, hQ⟩, -⟩ := unitary_order_and_Sylow h (r := 1) (ε := 1) (by norm_num)
    (by norm_num)
  have h6 := Q.pow_dvd_card_of_pow_dvd_card (p := 2) (n := f * 4)
    (by rw [pow_mul]; exact h4)
  rw [hQ, hU, ← pow_mul] at h6
  have h7 := (Nat.pow_dvd_pow_iff_le_right (by norm_num)).1 h6
  have := hd.two_le
  norm_num at h7
  omega

theorem Hyp.sec3_3_two (hGMS : GMSK.GMSUnitarySharpKRankOneStatement) (hd : d.Hyp) :
    GMSK.SharpOutcome (fun D _ => LieModel D .PSL 3 2 (2 * f))
        (centralizer (d.I₂ : Set G) ⧸ standardComponentOddCore (centralizer (d.I₂ : Set G)))
        ((d.N₂.subgroupOf (centralizer (d.I₂ : Set G))).map
          (QuotientGroup.mk' (standardComponentOddCore (centralizer (d.I₂ : Set G)))))
        (QuotientGroup.mk' (standardComponentOddCore (centralizer (d.I₂ : Set G)))
          ⟨d.t, hd.t_mem_centralizer_I₂⟩) ∧
      (d.M₂.subgroupOf (centralizer (d.I₂ : Set G))).map
          (QuotientGroup.mk' (standardComponentOddCore (centralizer (d.I₂ : Set G)))) =
        CFSG.layer (centralizer (d.I₂ : Set G) ⧸
          standardComponentOddCore (centralizer (d.I₂ : Set G))) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set H := centralizer (d.I₂ : Set G) with hH
  set J := d.N₂.subgroupOf H with hJ
  set t' : H := ⟨d.t, hd.t_mem_centralizer_I₂⟩ with ht'
  have hN₂H : d.N₂ ≤ H := d.N₂_le_centralizer_I₂
  obtain ⟨hJq, hJm⟩ := hd.quasisimple_lieModel_N₂ (X := J) ⟨subgroupOfEquivOfLe hN₂H⟩
  have ht2 : orderOf t' = 2 := by
    rw [← Subgroup.orderOf_coe]
    exact hd.t_two
  have hN₂t : d.N₂ ≤ centralizer ({d.t} : Set G) := (d.pull_le_L _).trans hd.L_le_centralizer
  have hJt : J ≤ centralizer ({t'} : Set H) := fun x hx => by
    rw [mem_centralizer_singleton_iff]
    exact Subtype.ext (mem_centralizer_singleton_iff.1 (hN₂t (mem_subgroupOf.1 hx)))
  have htJ : t' ∈ centralizer (J : Set H) := mem_centralizer_iff.2 fun x hx =>
    (mem_centralizer_singleton_iff.1 (hJt hx))
  have hJn : (J.subgroupOf (centralizer ({t'} : Set H))).Normal := by
    refine ⟨fun n hn g => ?_⟩
    rw [mem_subgroupOf, mem_subgroupOf] at hn ⊢
    have hgt : ((g : H) : G) ∈ centralizer ({d.t} : Set G) := by
      rw [mem_centralizer_singleton_iff]
      exact congrArg Subtype.val (mem_centralizer_singleton_iff.1 g.2)
    simpa using hd.conj_mem_N₂ (g : H).2 hgt hn
  have hsyl := exists_sylow_eq_zpowers_of_card_le ht2 htJ fun Q hQ hQ2 => by
    rw [← card_map_of_injective H.subtype_injective]
    refine hd.card_le_two_of_centralizes ?_ (hQ2.map _)
    rintro _ ⟨x, hx, rfl⟩
    have hxJ : x ∈ centralizer (J : Set H) := (Subgroup.mem_inf.1 (hQ hx)).1
    have hxt : x ∈ centralizer ({t'} : Set H) := (Subgroup.mem_inf.1 (hQ hx)).2
    refine Subgroup.mem_inf.2 ⟨Subgroup.mem_inf.2 ⟨x.2, mem_centralizer_iff.2 fun n hn => ?_⟩, ?_⟩
    · exact congrArg Subtype.val (mem_centralizer_iff.1 hxJ ⟨n, hN₂H hn⟩ (mem_subgroupOf.2 hn))
    · rw [mem_centralizer_singleton_iff] at hxt ⊢
      exact congrArg Subtype.val hxt
  have hZR : (center J).map J.subtype ≤ standardComponentOddCore H := by
    rintro _ ⟨z, hz, rfl⟩
    apply d.I₂_le_oddCore
    rw [mem_subgroupOf]
    refine d.mem_I₂_of_comm_N₂ (mem_subgroupOf.1 (z : J).2) fun n hn => ?_
    have := mem_center_iff.1 hz ⟨⟨n, hN₂H hn⟩, mem_subgroupOf.2 hn⟩
    exact (congrArg (fun w : J => ((w : H) : G)) this).symm
  have hK : CFSG.SectionRank.IsKGroupCat H :=
    CFSG.QuasithinUnique.isKGroupCat_of_kProper hd.setting.std.kProper hd.centralizer_I₂_ne_top
  obtain ⟨hstd, hT, hθt, htC, hidx, -⟩ := GMSK.stdData_odd_quotient_of_quasisimple
    GMSK.isoInvariant_T_U3 hJq ⟨GMSK.two_le_of_lieModel_PSU3 hJm, hJm⟩ ht2 hJt hJn hsyl _
    (GMSK.odd_card_standardComponentOddCore H) hZR
  have hout := hGMS _ (hK.quotient _) (GMSK.standardComponentOddCore_quotient_eq_bot H) f _
    ⟨hT.1, hstd, hd.not_normal_image_N₂, hT.2⟩ _ hθt htC hidx
  refine ⟨hout, ?_⟩
  have hM : d.M₂.subgroupOf H = normalClosure (J : Set H) :=
    comap_map_eq_self_of_injective H.subtype_injective _
  rw [hM, map_normalClosure _ _ (QuotientGroup.mk'_surjective _), ← coe_map]
  exact hout.1.2.2.2.1

