namespace CFSG.LocalAnalysis.EvenBN.Tits

open Subgroup CFSG.Sporadic.Schreier.Tits CFSG.Open

theorem SecTwoHyp.exists_conj_t_mul_sq_comm {X : Type*} [Group X] [Finite X] {t u : X}
    (h : SecTwoHyp X t u) {c : X} (hc : c * t * c⁻¹ = t * u ^ 2) :
    ∃ k : X, k * u ^ 2 = u ^ 2 * k ∧ k * t * k⁻¹ = t * u ^ 2 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hut : u * t = t * u := h.commute.symm
  have hu3 : u * (t * u ^ 2) = t * u ^ 2 * u := by
    rw [← mul_assoc, hut, mul_assoc, ← pow_succ', pow_succ, ← mul_assoc]
  have e1 : c⁻¹ * (t * u ^ 2) * c = t := by rw [← hc]; group
  have hmt : t * (c⁻¹ * u * c) = c⁻¹ * u * c * t := by
    calc t * (c⁻¹ * u * c) = c⁻¹ * (t * u ^ 2) * c * (c⁻¹ * u * c) := by rw [e1]
      _ = c⁻¹ * (t * u ^ 2 * u) * c := by group
      _ = c⁻¹ * (u * (t * u ^ 2)) * c := by rw [hu3]
      _ = c⁻¹ * u * c * (c⁻¹ * (t * u ^ 2) * c) := by group
      _ = c⁻¹ * u * c * t := by rw [e1]
  have hcp : ∀ n : ℕ, (c⁻¹ * u * c) ^ n = c⁻¹ * u ^ n * c := fun n => by
    have e := conj_pow (a := c⁻¹) (b := u) (i := n)
    rwa [inv_inv] at e
  have hm4 : (c⁻¹ * u * c) ^ 4 = 1 := by rw [hcp, h.u_pow_four, mul_one, inv_mul_cancel]
  obtain ⟨n, -, hn⟩ := (Nat.dvd_prime_pow Nat.prime_two).1
    (show orderOf (c⁻¹ * u * c) ∣ 2 ^ 2 from orderOf_dvd_of_pow_eq_one hm4)
  have hP : IsPGroup 2 (zpowers (c⁻¹ * u * c)) :=
    IsPGroup.of_card (by rw [Nat.card_zpowers, hn])
  obtain ⟨g, hg, hgR⟩ := secTwo_exists_conj_le h.sylow
    (zpowers_le.2 (mem_centralizer_singleton_iff.2 hmt.symm)) hP
  have hgt : g * t = t * g := mem_centralizer_singleton_iff.1 hg
  have hr2 : (g * (c⁻¹ * u * c) * g⁻¹) ^ 2 = g * c⁻¹ * u ^ 2 * c * g⁻¹ := by
    rw [conj_pow, hcp]; group
  rcases h.sq_of_mem_R (hgR _ (mem_zpowers _)) with h1 | h1
  · exfalso
    apply h.z_ne_one
    rw [hr2] at h1
    calc u ^ 2 = (c * g⁻¹) * (g * c⁻¹ * u ^ 2 * c * g⁻¹) * (c * g⁻¹)⁻¹ := by group
      _ = 1 := by rw [h1]; group
  · rw [hr2] at h1
    refine ⟨c * g⁻¹, ?_, ?_⟩
    · calc c * g⁻¹ * u ^ 2 = c * g⁻¹ * (g * c⁻¹ * u ^ 2 * c * g⁻¹) := by rw [h1]
        _ = u ^ 2 * (c * g⁻¹) := by group
    · calc c * g⁻¹ * t * (c * g⁻¹)⁻¹ = c * (g⁻¹ * (t * g)) * c⁻¹ := by group
        _ = t * u ^ 2 := by rw [← hgt, inv_mul_cancel_left, hc]

namespace Data

variable {G : Type} [Group G] [Finite G] {d : Data G}

theorem Hyp.exists_conj_t_tz
    (hd : d.Hyp) (hfail : d.t * d.v ∉ d.tG) :
    ∃ k ∈ centralizer ({d.x₅} : Set G), k * d.z = d.z * k ∧ k * d.t * k⁻¹ = d.t * d.z := by
  obtain ⟨w, hwx, hww, hH⟩ := hd.secTwoHyp hfail
  obtain ⟨g, hg⟩ := hd.exists_conj_eq_t_mul_z
  have htC : d.t ∈ centralizer ({d.x₅} : Set G) :=
    mem_centralizer_singleton_iff.2 (hd.L_comm_t (d.lift_mem _)).symm
  have hzC : d.z ∈ centralizer ({d.x₅} : Set G) :=
    mem_centralizer_singleton_iff.2 (five_facts d).2.1.symm
  obtain ⟨c, hcC, hc⟩ := hd.thm412_three (g := g) (by rw [hg]; exact mul_mem htC hzC)
  rw [hg] at hc
  have hw2 : (⟨w, hwx⟩ : centralizer ({d.x₅} : Set G)) ^ 2 = ⟨d.z, hzC⟩ :=
    Subtype.ext (by rw [Subgroup.coe_pow, sq, hww])
  obtain ⟨k, hkz, hkt⟩ := hH.exists_conj_t_mul_sq_comm (c := ⟨c, hcC⟩)
    (by rw [hw2]; exact Subtype.ext hc)
  rw [hw2] at hkz hkt
  exact ⟨k, k.2, congrArg Subtype.val hkz, congrArg Subtype.val hkt⟩

end Data

