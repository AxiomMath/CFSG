open Subgroup CFSG.Open CFSG.Blueprint


theorem trialityD4ProductFieldCase_holds : TrialityD4ProductFieldCase := by
  intro G _ _ L f t h d hf hlay hnf
  obtain ⟨G₀, hcomm, hperf, hL, hN⟩ := ProductCase.exists_productConfig h d ⟨hf, hlay, hnf⟩
  haveI := hperf
  exact false_of_productConfig h d hcomm hL hN

theorem trialityD4FieldAutomorphismCase_holds : TrialityD4FieldAutomorphismCase :=
  trialityD4FieldAutomorphismCase_of_productFieldCase trialityD4ProductFieldCase_holds

theorem trialityD4LargeCenterlessExclusion_holds :
    ∀ (G : Type) [Group G] [Finite G] [IsSimpleGroup G], (∃ a b : G, a * b ≠ b * a) →
      CFSG.Assembly.KProper CFSG.Blueprint.Catalog G →
      ∀ L : Subgroup G, standardComponentIsStandard L → center L = ⊥ →
      (∀ t : G, orderOf t = 2 → standardComponentOddCore (centralizer ({t} : Set G)) = ⊥) →
      (∀ S : Sylow 2 (centralizer (L : Set G)),
        IsCyclic (S : Subgroup (centralizer (L : Set G)))) →
      ∀ f : ℕ, 2 ≤ f → LieModel L .trialityD4 0 2 f → False := by
  intro G _ _ _ hnonab hK L hL hZ hcore hcyc f hf hm
  obtain ⟨t, h⟩ := exists_setup hnonab hK hL hZ hcore hcyc (by omega) hm
  obtain ⟨d⟩ := nonempty_trialityD4Data_of_lieModel (by omega) hm
  exact h.false_of_layerHyp_of_fieldCase d hf
    (h.layerHyp_of_cat d hf (SeitzReduction.slmCatalogueClausesAt_three_of_gls3
      CFSG.ComponentClassification.GrSLit.gls3OddLieAutComponentsInput_holds))
    trialityD4FieldAutomorphismCase_holds

end CFSG.LocalAnalysis.EvenBN.TrialityD4
