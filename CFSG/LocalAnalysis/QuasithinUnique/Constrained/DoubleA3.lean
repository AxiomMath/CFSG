  have h25 : A5BlockS1 := fun G _ _ T M H S L hcs h5 => (ha5 G T M H S L hcs h5).elim
  have h27_1 : Lemma2_4_27_1A3 :=
    lemma2_4_27_1A3_of (constrainedSetupAt_of_blockProduction hBP) hlin ha3 h25
  have hI : Inputs2436 := (inputs2436Core_of_ident hJ4 hTC hident).toInputs2436
    (tabClass8_of_split tabClass8Sp4 tabClass8L5 tabClass8HS)
  have h34 : Lemma2_4_34_used := lemma2_4_34_used_of_inputs hD h27_1 hI
  have h36 : Lemma2_4_36 := lemma2_4_36_of_claim1 hD h27_1 h34
    (claim1_of_claim2 hD h27_1 h34 (lemma2_4_36_claim2_of_inputs hD h27_1 h34 hI))
  doubleA3Excluded_of_used hD h27_1
    (lemma2_4_32W hD h27_1 (constrainedSetupAt_of_blockProduction hBP) hlin ha5 ha3 h2397
      (lemma2_4_32_KW_of_lek hI.p121_3 hKT (k32LeK_of hI.p121_3 hD h27_1) k32ExclA7_proof
        (k32ExclA8_of hD h27_1)
        (k32ExclBig_of hD h27_1 tabBigSylow tabBigA4)))
    h34 (Lemma2_4_36.cent h36)
    (lemma2_4_37_used_of_36 hD h27_1 (constrainedSetupAt_of_blockProduction hBP) hlin ha5 ha3 h34
      h36)

