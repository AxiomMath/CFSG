theorem blockU_le (L : Subgroup G) : blockU L ≤ L := by
  rw [blockU, Subgroup.commutator_le]
  intro a ha b hb
  have ha' : a ∈ L := CFSG.RankThreeCoreUniqueness.Helpers.pCoreOf_le 2 L ha
  rw [commutatorElement_def]
  exact L.mul_mem (L.mul_mem (L.mul_mem ha' hb) (L.inv_mem ha')) (L.inv_mem hb)

theorem doubleA3Excluded_of_used
    (hD : AppC.C56DoubleA3)
    (h27_1 : Lemma2_4_27_1A3) (h32 : Lemma2_4_32) (h34 : Lemma2_4_34_used)
    (h36 : Lemma2_4_36_cent) (h37 : Lemma2_4_37_used) : DoubleA3Excluded := by
  intro G _ _ T M H S L hcs h3 hne
  obtain ⟨t, htS, htne, htjoin, htcomm⟩ := hcs.blocks.resolve_left hne
  have hct : conjR L t⁻¹ = L.map (MulAut.conj t).toMonoidHom := by simp [conjR]
  have hcfg : A3A3 T M H S L t⁻¹ :=
    ⟨hcs, h3, S.inv_mem htS, by rw [hct]; exact htne, by rw [hct]; exact htjoin,
      by rw [hct]; exact htcomm⟩
  generalize t⁻¹ = s at hcfg
  obtain ⟨x, z₁, z₂, hA⟩ := lemma2_4_31_exists hD G T M H S L s hcfg
  obtain ⟨-, K, hAK⟩ := h32 G T M H S L s x z₁ z₂ hA
  have hK := hAK.K_comp
  have hKN := hAK.K_norm
  have hKz := hAK.K_comm
  have hLK := hAK.L_le_K
  obtain ⟨e, u, huU2, huz, τ, hτ, hτu⟩ := lemma2_4_35_used_of_34 h34 G T M H S L s x z₁ z₂ K hAK
  have hBR := h36 G T M H S L s x z₁ z₂ K hAK
  have hsurj := lemma2_4_36_surj_of_34 hD h27_1 h34 G T M H S L s x z₁ z₂ K hAK
  have hRKdih := hAK.rK_dihedral hD h27_1 e
  have huRK := hAK.u_comm_rK hD h27_1 e u huU2
  have h37' := h37 G T M H S L s x z₁ z₂ K hAK
  have hshort : IsShort2 L := hcs.block.1.1
  obtain ⟨-, -, hUexp, hUcomm, hL12, -, -⟩ := hshort.alt3_structure h3
  have hUle : blockU L ≤ baum S := blockU_le_baum hcs h3
  have hU2le : blockU2 L s ≤ baum S :=
    (C5.conjSubgroup_mono hUle s).trans
      (le_of_eq (C5.conjSubgroup_eq_self (mem_normalizer_baum hcfg.s_mem)))
  have hz₁U : z₁ ∈ blockU L := by
    have : z₁ ∈ Subgroup.zpowers z₁ := Subgroup.mem_zpowers z₁
    rw [hA.z₁_gen] at this
    exact this.1
  have hz₁def : z₁ = s * z₂ * s⁻¹ := by rw [hA.z₂_def]; group
  have hz₂U2 : z₂ ∈ blockU2 L s := by
    refine mem_conjR.mpr ?_
    rw [← hz₁def]; exact hz₁U
  have hKG₂ : K ≤ centralizerElem z₂ := hK.1
  have hz₂one : z₂ ≠ 1 := by
    intro h
    have hz₁ : z₁ = 1 := by rw [hz₁def, h]; simp
    have hKz' : ⁅K, Subgroup.zpowers (z₁ * z₂)⁆ = K := hKz
    rw [hz₁, h, mul_one, Subgroup.zpowers_one_eq_bot, Subgroup.commutator_bot_right] at hKz'
    have hLbot : L = ⊥ := le_bot_iff.mp (hKz' ▸ hLK)
    rw [hLbot] at hL12
    simp at hL12
  have hz₁one : z₁ ≠ 1 := by
    intro h
    apply hz₂one
    have : z₂ = s⁻¹ * z₁ * s := hA.z₂_def
    rw [h] at this
    simpa using this
  have hu1 : u ≠ 1 := fun h => huz (h ▸ one_mem _)
  have hz₂sq : z₂ ^ 2 = 1 := by
    have h1 := hUexp z₁ hz₁U
    have : z₂ ^ 2 = s⁻¹ * z₁ ^ 2 * s := by
      rw [hA.z₂_def, pow_two, pow_two]; group
    rw [this, h1]; simp
  have hconj : ∀ v : G, v ∈ blockU2 L s → v ≠ 1 → v ∈ conjClass z₂ := by
    intro v hv hv1
    have hv0 : s * v * s⁻¹ ∈ blockU L := mem_conjR.mp hv
    have hv01 : s * v * s⁻¹ ≠ 1 := by
      intro h
      apply hv1
      have := congrArg (fun y => s⁻¹ * y * s) h
      simpa [mul_assoc] using this
    obtain ⟨l, -, hl⟩ := alt3_conj_transitive hshort h3 hz₁U hv0 hz₁one hv01
    refine ⟨s⁻¹ * l * s, ?_⟩
    calc v = s⁻¹ * (s * v * s⁻¹) * s := by group
      _ = s⁻¹ * (l⁻¹ * z₁ * l) * s := by rw [hl]
      _ = (s⁻¹ * l * s)⁻¹ * z₂ * (s⁻¹ * l * s) := by rw [hz₁def]; group
  have hu : u ∈ conjClass z₂ := hconj u huU2 hu1
  have huzU2 : u * z₂ ∈ blockU2 L s := (blockU2 L s).mul_mem huU2 hz₂U2
  have huz1 : u * z₂ ≠ 1 := by
    intro h
    apply huz
    have h2 : u = z₂⁻¹ := mul_eq_one_iff_eq_inv.mp h
    have h3' : z₂⁻¹ = z₂ := by
      have : z₂ * z₂ = 1 := by simpa [pow_two] using hz₂sq
      exact inv_eq_of_mul_eq_one_right this
    rw [h2, h3']
    exact Subgroup.mem_zpowers z₂
  have huz₂ : u * z₂ ∈ conjClass z₂ := hconj _ huzU2 huz1
  have huG : u ∈ centralizerElem z₂ := by
    rw [centralizerElem, Subgroup.mem_centralizer_iff]
    intro h hh
    rw [Set.mem_singleton_iff] at hh
    subst hh
    have hu0 : s * u * s⁻¹ ∈ blockU L := mem_conjR.mp huU2
    have := hUcomm _ hz₁U _ hu0
    have e1 : s * (h * u) * s⁻¹ = s * (u * h) * s⁻¹ := by
      rw [show s * (h * u) * s⁻¹ = (s * h * s⁻¹) * (s * u * s⁻¹) by group,
        show s * (u * h) * s⁻¹ = (s * u * s⁻¹) * (s * h * s⁻¹) by group, ← hz₁def]
      exact this
    exact mul_left_cancel (mul_right_cancel e1)
  have hz₂G : z₂ ∈ centralizerElem z₂ := by
    rw [centralizerElem, Subgroup.mem_centralizer_iff]
    intro h hh
    rw [Set.mem_singleton_iff] at hh
    rw [hh]
  have hz₂K : z₂ ∈ Subgroup.centralizer (K : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro k hk
    have := (Subgroup.mem_centralizer_iff.mp (hKG₂ hk)) z₂ (Set.mem_singleton z₂)
    exact this.symm
  have hRK : Nat.card ↥(baum S ⊓ K) = 8 := by
    obtain ⟨f⟩ := hRKdih
    rw [Nat.card_congr f.toEquiv, DihedralGroup.nat_card]
  have h37b : {y | y ∈ conjClass z₂ ∧ y ∈ baum S ⊓ K}.ncard = 5 := by
    obtain ⟨f⟩ := hRKdih
    have hz₁sq : z₁ * z₁ = 1 := by simpa [pow_two] using hA.sq₁
    exact ncard_conjClass_inf_eq_five e inf_le_right f (hLK (blockU_le L hz₁U)) hz₁one hz₁sq
      hA.z₂_def
  exact final_contradiction e hKG₂ hKN hz₂one hz₂K hz₂G huG (hU2le huU2) hu huz₂ hτ hτu huRK hRK
    hBR hsurj h37' h37b

