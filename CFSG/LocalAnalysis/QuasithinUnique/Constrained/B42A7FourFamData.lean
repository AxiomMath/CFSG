module

public import CFSG.LocalAnalysis.QuasithinUnique.Constrained.B42A57GenCore

public section

namespace CFSG.QuasithinUnique.B42A57

open Equiv Equiv.Perm

set_option maxRecDepth 100000

@[expose] def x5 : List (Perm (Fin 7)) :=
  [swap 0 1 * swap 2 3, swap 0 1 * swap 4 5, swap 2 3 * swap 4 5]

@[expose] def xt5 : List (List ℕ) :=
  [[1, 0, 3, 2, 4, 5, 6], [1, 0, 2, 3, 5, 4, 6], [0, 1, 3, 2, 5, 4, 6]]

@[expose] def cj5 : List (List (Fin 7 × Fin 7)) :=
  [[(1, 2), (2, 3), (3, 6), (4, 5)], [(0, 3), (3, 6), (1, 5), (5, 2)], [(0, 3), (3, 4), (4, 5), (1, 2)], [(0, 3), (3, 1), (4, 5), (5, 6)], [(0, 4), (4, 2), (2, 1), (5, 6)], [(0, 3), (3, 1), (1, 4), (4, 6), (6, 2), (2, 5)]]

@[expose] def tab5 : List (ℕ × ℕ × List (List ℕ)) :=
  [(0, 1, [[5, 2, 3, 2, 5, 0], [1, 5, 0, 3, 1, 4, 1], [2, 3, 2, 3, 1, 4, 0], [3, 2, 3, 1, 4, 1], [3, 0, 4, 2, 4, 0]]),
  (0, 2, [[0, 5, 2, 5], [1, 4, 0, 5, 1, 5, 2], [5, 1, 5, 0, 5, 0], [2, 5, 1, 5, 0, 5, 1], [0, 4, 0, 5, 1, 5]]),
  (0, 3, [[3, 2, 3, 2, 3, 0], [0, 3, 2, 3, 0, 3, 1], [2, 4, 0, 4, 1, 3, 0], [4, 2, 3, 1, 5], [1, 3, 2, 3, 0, 3, 0]]),
  (0, 4, [[5, 2, 5, 1], [1, 5, 0, 5, 1, 5], [4, 1, 5, 0, 5, 1], [2, 4, 1, 5, 0, 5, 0], [0, 5, 0, 5, 1, 5, 2]]),
  (0, 5, [[0, 5, 2, 4, 2, 5], [1, 3, 2, 3, 0, 4, 2], [5, 1, 3, 0, 4], [0, 3, 1, 4, 2, 4, 2], [0, 3, 2, 3, 0, 4]]),
  (1, 2, [[1, 3, 2, 4, 1, 4, 0], [3, 2, 4, 0, 5], [3, 2, 4, 1, 4, 2], [1, 3, 1, 3, 0, 4, 2], [5, 1, 3, 1, 5, 2]]),
  (1, 3, [[2, 4, 0, 4, 2, 5], [4, 2, 4, 0, 4, 2], [0, 4, 0, 4, 2, 5, 1], [1, 4, 2, 4, 0, 4, 0], [2, 4, 1, 4]]),
  (1, 4, [[1, 4, 0, 4, 2, 4, 2], [0, 4, 2, 4, 0, 5], [4, 0, 4, 2, 4, 0], [2, 4, 2, 4, 0, 5, 1], [0, 4, 1, 4]]),
  (1, 5, [[0, 4, 2, 3, 1, 3, 1], [0, 5, 0, 5, 1, 5, 2], [4, 2, 5, 1, 3], [2, 5, 0, 5, 1, 5, 0], [0, 5, 1, 5, 1, 5]]),
  (2, 3, [[5, 0, 4, 0], [3, 0, 4, 0, 5], [0, 4, 0, 3, 0, 4], [2, 4, 0, 3, 0, 4, 0], [5, 2, 4, 0, 3]]),
  (2, 4, [[0, 4, 2, 5, 1], [3, 2, 5, 2, 4], [5, 2, 5, 2, 3], [2, 3, 2, 5, 2, 5], [0, 3, 2, 5, 0, 5, 1]]),
  (2, 5, [[1, 4, 0, 5, 0, 3, 1], [1, 5, 0, 4, 2], [2, 5, 0, 5, 1], [0, 5, 0, 5, 2], [5, 2, 5, 0, 5, 0]]),
  (3, 4, [[0, 3, 2, 3, 1], [2, 3, 2, 3, 0], [3, 0, 3, 2, 3, 2], [1, 4, 2, 3, 2, 5, 1], [1, 3, 2, 4, 0]]),
  (3, 5, [[2, 4, 2, 5, 2, 4], [0, 4, 2, 5, 2, 4, 2], [3, 0, 4, 2, 5], [3, 2, 4, 2], [5, 2, 4, 2, 3]]),
  (4, 5, [[2, 5, 1, 3, 0], [2, 3, 1, 3], [0, 3, 1, 3, 2], [3, 1, 3, 0, 3, 1], [0, 4, 1, 3, 1, 5, 0]])]

@[expose] def ent5 : List (GenEntry 7) :=
  tab5.map fun t => ⟨x5, xt5, [cj5.getD t.1 [], cj5.getD t.2.1 []], t.2.2⟩

theorem ent5_ok : ∀ e ∈ ent5, e.Ok := by decide +kernel

theorem tab5_cover : ∀ i j : Fin 6, i < j → ∃ t ∈ tab5, t.1 = i.val ∧ t.2.1 = j.val := by
  decide +kernel

theorem cj5_even : ∀ l ∈ cj5, l.length % 2 = 0 ∧ ∀ p ∈ l, p.1 ≠ p.2 := by decide

end CFSG.QuasithinUnique.B42A57
