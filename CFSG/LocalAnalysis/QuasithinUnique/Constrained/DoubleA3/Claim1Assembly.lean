@[expose] def Lemma2_4_36_claim2 : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (T M H S L : Subgroup G) (s x z₁ z₂ : G) (K : Subgroup G),
    A3A3K T M H S L s x z₁ z₂ K →
      ∀ r ∈ baum S ⊓ Subgroup.centralizer (K : Set G), r * r = 1 → r ≠ 1 →
        centralizerElem r ≤ Subgroup.normalizer (K : Set G)

section Generic

variable {G : Type} [Group G]

theorem comm_iff_conj (s x y : G) :
    x * y = y * x ↔ (s * x * s⁻¹) * (s * y * s⁻¹) = (s * y * s⁻¹) * (s * x * s⁻¹) := by
  constructor
  · intro h
    calc (s * x * s⁻¹) * (s * y * s⁻¹) = s * (x * y) * s⁻¹ := by group
      _ = s * (y * x) * s⁻¹ := by rw [h]
      _ = (s * y * s⁻¹) * (s * x * s⁻¹) := by group
  · intro h
    calc x * y = s⁻¹ * ((s * x * s⁻¹) * (s * y * s⁻¹)) * s := by group
      _ = s⁻¹ * ((s * y * s⁻¹) * (s * x * s⁻¹)) * s := by rw [h]
      _ = y * x := by group

theorem exists_model_of_involution
    {K : Type*} [Group K] (e₀ : K ≃* alternatingGroup (Fin 6))
    {z : K} (hz1 : z ≠ 1) (hz2 : z * z = 1) :
    ∃ φ : K ≃* ↥A6Models.psl29, ((φ z : ↥A6Models.psl29) : P10) = zb := by
  obtain ⟨ψ, -⟩ := exists_psl_equiv
  let φ₀ : K ≃* ↥A6Models.psl29 := e₀.trans ψ.symm
  have hy1 : φ₀ z ≠ 1 := fun h => hz1 (φ₀.injective (h.trans (map_one φ₀).symm))
  have hy2 : φ₀ z * φ₀ z = 1 := by rw [← map_mul, hz2, map_one]
  have hzb1 : (⟨zb, zb_mem_psl29⟩ : ↥A6Models.psl29) ≠ 1 := fun h =>
    zb_ne_one (congrArg Subtype.val h)
  have hzb2 : (⟨zb, zb_mem_psl29⟩ : ↥A6Models.psl29) * ⟨zb, zb_mem_psl29⟩ = 1 :=
    Subtype.ext zb_sq
  obtain ⟨k, hk⟩ := involutions_conj_of_iso (K := ↥A6Models.psl29) (Or.inl ⟨ψ⟩) (φ₀ z)
    ⟨zb, zb_mem_psl29⟩ hy1 hy2 hzb1 hzb2
  refine ⟨φ₀.trans (MulAut.conj k⁻¹), ?_⟩
  have h1 : (φ₀.trans (MulAut.conj k⁻¹)) z = k⁻¹ * φ₀ z * k := by
    show (MulAut.conj k⁻¹) (φ₀ z) = _
    rw [MulAut.conj_apply, inv_inv]
  rw [h1, hk]

theorem exists_conjR_equiv (K : Subgroup G) (s : G) :
    ∃ ι : ↥K ≃* ↥(conjR K s), ∀ k : ↥K, ((ι k : ↥(conjR K s)) : G) = s⁻¹ * (k : G) * s :=
  ⟨Subgroup.equivMapOfInjective K (MulAut.conj s⁻¹).toMonoidHom (MulAut.conj s⁻¹).injective,
    fun k => by
      show (MulAut.conj s⁻¹) (k : G) = s⁻¹ * (k : G) * s
      rw [MulAut.conj_apply, inv_inv]⟩

end Generic

section Config

variable {G : Type} [Group G] [Finite G] {T M H S L K : Subgroup G} {s x z₁ z₂ : G}

theorem A3A3K.z₂_mem_baum (hK : A3A3K T M H S L s x z₁ z₂ K) : z₂ ∈ baum S := by
  have hz₁R : z₁ ∈ baum S := blockU_le_baum hK.cs hK.a3 hK.toA3A3x.z₁_mem.1
  have hsB : s ∈ normalizer (baum S : Set G) := mem_normalizer_baum hK.s_mem
  have hsiB : s⁻¹ ∈ normalizer (baum S : Set G) := (normalizer (baum S : Set G)).inv_mem hsB
  have := (Subgroup.mem_normalizer_iff.mp hsiB z₁).mp hz₁R
  rw [hK.z₂_def]
  simpa using this

theorem A3A3K.z₂_mem_centralizer (hK : A3A3K T M H S L s x z₁ z₂ K) :
    z₂ ∈ Subgroup.centralizer (K : Set G) :=
  Subgroup.mem_centralizer_iff.mpr fun _ hk =>
    Subgroup.mem_centralizer_singleton_iff.mp (hK.K_comp.1 hk)

theorem A3A3K.z₁_eq (hD : AppC.C56DoubleA3) (h27_1 : Lemma2_4_27_1A3)
    (hK : A3A3K T M H S L s x z₁ z₂ K) : s⁻¹ * z₂ * s = z₁ := by
  have hB := basic31 hD h27_1 hK.toA3A3
  have hss : s * s ∈ baum S := (s_mul_self_mem_baum hB hK.toA3A3).2
  have hc : (s * s) * z₁ = z₁ * (s * s) :=
    Subgroup.mem_centralizer_iff.mp hK.toA3A3x.z₁_mem.2 (s * s) hss
  rw [hK.z₂_def]
  calc s⁻¹ * (s⁻¹ * z₁ * s) * s = (s * s)⁻¹ * (z₁ * (s * s)) := by group
    _ = (s * s)⁻¹ * ((s * s) * z₁) := by rw [hc]
    _ = z₁ := by group

theorem A3A3K.z₂_mem_conjR (hK : A3A3K T M H S L s x z₁ z₂ K) : z₂ ∈ conjR K s := by
  have hD1 : s * z₂ * s⁻¹ = z₁ := by rw [hK.z₂_def]; group
  exact mem_conjR.mpr (by rw [hD1]; exact hK.z₁_mem_K)

end Config

section Main

variable {G : Type} [Group G] [Finite G] {T M H S L K : Subgroup G} {s x z₁ z₂ : G}

theorem A3A3K.false_of_good_involution
    (hD : AppC.C56DoubleA3) (h27_1 : Lemma2_4_27_1A3)
    (h34 : Lemma2_4_34_used) (h2 : Lemma2_4_36_claim2) (hK : A3A3K T M H S L s x z₁ z₂ K)
    {r : G} (hrR : r ∈ baum S) (hrC : r ∈ Subgroup.centralizer (K : Set G)) (hr2 : r * r = 1)
    (hr1 : r ≠ 1) (hgood : ∃ a ∈ conjR K s, a * (r * z₂) ≠ (r * z₂) * a) : False := by
  have hcs := hK.cs
  have hz₁s : s⁻¹ * z₂ * s = z₁ := hK.z₁_eq hD h27_1
  have hD1 : s * z₂ * s⁻¹ = z₁ := by rw [hK.z₂_def]; group
  have hD3 : s * z₁ * s⁻¹ = z₂ := by rw [← hz₁s]; group
  have hz₁K : z₁ ∈ K := hK.z₁_mem_K
  have hz₂1 : z₂ ≠ 1 := hK.toA3A3x.z₂_ne
  have hz₁1 : z₁ ≠ 1 := hK.z₁_ne
  have hz₁2 : z₁ * z₁ = 1 := by simpa [pow_two] using hK.toA3A3x.sq₁
  obtain ⟨e₀⟩ := hK.nonempty_alt6 h34
  obtain ⟨φ', hφ'⟩ := exists_model_of_involution e₀ (z := (⟨z₁, hz₁K⟩ : ↥K))
    (fun h => hz₁1 (congrArg Subtype.val h)) (Subtype.ext (by simpa using hz₁2))
  obtain ⟨ι, hι⟩ := exists_conjR_equiv K s
  have hιsymm : ∀ a : ↥(conjR K s), ((ι.symm a : ↥K) : G) = s * (a : G) * s⁻¹ := by
    intro a
    have h := hι (ι.symm a)
    rw [MulEquiv.apply_symm_apply] at h
    calc ((ι.symm a : ↥K) : G) = s * (s⁻¹ * ((ι.symm a : ↥K) : G) * s) * s⁻¹ := by group
      _ = s * (a : G) * s⁻¹ := by rw [← h]
  let φA : ↥(conjR K s) ≃* ↥A6Models.psl29 := ι.symm.trans φ'
  have hz₂A : z₂ ∈ conjR K s := hK.z₂_mem_conjR
  have hzb : ((φA ⟨z₂, hz₂A⟩ : ↥A6Models.psl29) : P10) = zb := by
    have h1 : ι.symm ⟨z₂, hz₂A⟩ = ⟨z₁, hz₁K⟩ := Subtype.ext (by rw [hιsymm]; exact hD1)
    show ((φ' (ι.symm ⟨z₂, hz₂A⟩) : ↥A6Models.psl29) : P10) = zb
    rw [h1]
    exact hφ'
  have hAG₁ : conjR K s ≤ centralizerElem z₁ := by
    intro a ha
    have hκ : s * a * s⁻¹ ∈ K := mem_conjR.mp ha
    have h1 : (s * a * s⁻¹) * z₂ = z₂ * (s * a * s⁻¹) :=
      Subgroup.mem_centralizer_singleton_iff.mp (hK.K_comp.1 hκ)
    refine Subgroup.mem_centralizer_singleton_iff.mpr ?_
    refine (comm_iff_conj s a z₁).mpr ?_
    rw [hD3]
    exact h1
  have hG₁N : centralizerElem z₁ ≤ normalizer (conjR K s : Set G) := by
    intro g hg
    have hgz : g * z₁ = z₁ * g := Subgroup.mem_centralizer_singleton_iff.mp hg
    have hg₂ : (s * g * s⁻¹) ∈ centralizerElem z₂ := by
      refine Subgroup.mem_centralizer_singleton_iff.mpr ?_
      have h1 := (comm_iff_conj s g z₁).mp hgz
      rwa [hD3] at h1
    have hg₂N : (s * g * s⁻¹) ∈ normalizer (K : Set G) := hK.K_norm hg₂
    rw [Subgroup.mem_normalizer_iff]
    intro y
    rw [mem_conjR, mem_conjR]
    have e : s * (g * y * g⁻¹) * s⁻¹ = (s * g * s⁻¹) * (s * y * s⁻¹) * (s * g * s⁻¹)⁻¹ := by
      group
    rw [e]
    exact Subgroup.mem_normalizer_iff.mp hg₂N (s * y * s⁻¹)
  have hsurjK := lemma2_4_36_surj_of_34 hD h27_1 h34 G T M H S L s x z₁ z₂ K hK
  have hsurjA : ∀ b ∈ A6Models.autA6, ∃ g ∈ centralizerElem z₁, InducesModel (conjR K s) φA g b := by
    intro b hb
    let αb : MulAut ↥K := (φ'.trans (conjAut ⟨b, hb⟩)).trans φ'.symm
    obtain ⟨g₂, hg₂, hα⟩ := hsurjK αb
    refine ⟨s⁻¹ * g₂ * s, ?_, ?_⟩
    · have h1 : g₂ * z₂ = z₂ * g₂ := Subgroup.mem_centralizer_singleton_iff.mp hg₂
      refine Subgroup.mem_centralizer_singleton_iff.mpr ?_
      have h3 := (comm_iff_conj s⁻¹ g₂ z₂).mp h1
      simp only [inv_inv] at h3
      rwa [hz₁s] at h3
    · intro k k' hk'
      show ((φ' (ι.symm k') : ↥A6Models.psl29) : P10) =
        b * ((φ' (ι.symm k) : ↥A6Models.psl29) : P10) * b⁻¹
      have hκ' : ((ι.symm k' : ↥K) : G) = g₂⁻¹ * ((ι.symm k : ↥K) : G) * g₂ := by
        rw [hιsymm, hιsymm, hk']
        group
      have h1 : ι.symm k' = αb (ι.symm k) := Subtype.ext (hκ'.trans (hα _).symm)
      have h2 : φ' (αb (ι.symm k)) = conjAut ⟨b, hb⟩ (φ' (ι.symm k)) := by
        show φ' (φ'.symm (conjAut ⟨b, hb⟩ (φ' (ι.symm k)))) = _
        exact φ'.apply_symm_apply _
      rw [h1, h2]
      exact conjAut_mk_apply b hb _
  have hrG₁ : r ∈ centralizerElem z₁ := hK.toA3A3x.baum_le_cent₁ hrR
  have hrz₂ : r * z₂ = z₂ * r := Subgroup.mem_centralizer_iff.mp hK.toA3A3x.z₂_mem.2 r hrR
  have hzW : ∀ g ∈ centralizerElem z₁, g * z₂ = z₂ * g → g ∈ normalizer (K : Set G) :=
    fun g _ hg => hK.K_norm (Subgroup.mem_centralizer_singleton_iff.mpr hg)
  have hrW : ∀ g ∈ centralizerElem z₁, g * r = r * g → g ∈ normalizer (K : Set G) := by
    intro g _ hg
    exact h2 G T M H S L s x z₁ z₂ K hK r ⟨hrR, hrC⟩ hr2 hr1
      (Subgroup.mem_centralizer_singleton_iff.mpr hg)
  have hAN : conjR K s ≤ normalizer (K : Set G) :=
    stepF_core φA hAG₁ hG₁N hsurjA hz₂A hzb hrG₁ hr2 hrz₂ hgood hzW hrW
  have heA : ↥(conjR K s) ≃* alternatingGroup (Fin 6) := ι.symm.trans e₀
  have hAsimple : IsSimpleGroup ↥(conjR K s) :=
    (MulEquiv.isSimpleGroup_congr heA).mpr (alternatingGroup.isSimpleGroup (by simp))
  have hAC : ∀ a ∈ conjR K s, ∀ κ ∈ K, κ * a = a * κ := by
    let N₀ : Subgroup ↥(conjR K s) := (Subgroup.centralizer (K : Set G)).subgroupOf (conjR K s)
    have hN₀ : N₀.Normal := by
      refine ⟨fun n hn g => ?_⟩
      have hn' : (n : G) ∈ Subgroup.centralizer (K : Set G) := hn
      show ((g * n * g⁻¹ : ↥(conjR K s)) : G) ∈ Subgroup.centralizer (K : Set G)
      rw [Subgroup.mem_centralizer_iff]
      intro κ hκ
      have hgN : (g : G) ∈ normalizer (K : Set G) := hAN g.2
      have hκ' : (g : G)⁻¹ * κ * g ∈ K := by
        have := (Subgroup.mem_normalizer_iff.mp ((normalizer (K : Set G)).inv_mem hgN) κ).mp hκ
        simpa using this
      have h1 := Subgroup.mem_centralizer_iff.mp hn' _ hκ'
      calc κ * ((g : G) * (n : G) * (g : G)⁻¹)
          = (g : G) * (((g : G)⁻¹ * κ * (g : G)) * (n : G)) * (g : G)⁻¹ := by group
        _ = (g : G) * ((n : G) * ((g : G)⁻¹ * κ * (g : G))) * (g : G)⁻¹ := by rw [h1]
        _ = ((g : G) * (n : G) * (g : G)⁻¹) * κ := by group
    have hz₂N₀ : (⟨z₂, hz₂A⟩ : ↥(conjR K s)) ∈ N₀ := hK.z₂_mem_centralizer
    have htop : N₀ = ⊤ := by
      rcases (haveI := hN₀; hAsimple.eq_bot_or_eq_top_of_normal N₀) with h | h
      · exfalso
        rw [h, Subgroup.mem_bot] at hz₂N₀
        exact hz₂1 (congrArg Subtype.val hz₂N₀)
      · exact h
    intro a ha κ hκ
    have : (⟨a, ha⟩ : ↥(conjR K s)) ∈ N₀ := by rw [htop]; exact Subgroup.mem_top _
    have h3 : a ∈ Subgroup.centralizer (K : Set G) := this
    exact Subgroup.mem_centralizer_iff.mp h3 κ hκ
  have hU₂A : blockU2 L s ≤ conjR K s :=
    hK.isA4s.le.trans (Subgroup.map_mono hK.L_le_K : conjR L s ≤ conjR K s)
  have hU₂1 : blockU2 L s ≠ ⊥ := by
    intro h
    have hz : z₂ ∈ blockU2 L s := hK.toA3A3x.z₂_mem.1
    rw [h] at hz
    exact hz₂1 (Subgroup.mem_bot.mp hz)
  have hU₂2 : IsPGroup 2 ↥(blockU2 L s) := hK.isA4s.isPGroup_U
  have hNloc : IsTwoLocal (normalizer ((blockU2 L s : Subgroup G) : Set G)) :=
    ⟨blockU2 L s, hU₂1, hU₂2, rfl⟩
  have hKN : K ≤ normalizer ((blockU2 L s : Subgroup G) : Set G) := by
    apply C5.le_normalizer_of_commute
    intro κ hκ u hu
    exact hAC u (hU₂A hu) κ hκ
  obtain ⟨c, hcL, hc, hcN, -, -⟩ := hK.isA4s.exists_c
  have hcA : c ∈ conjR K s := (Subgroup.map_mono hK.L_le_K : conjR L s ≤ conjR K s) hcL
  have hc3 : c ^ 3 = 1 := by rw [← hc]; exact pow_orderOf_eq_one c
  have hc1 : c ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hc
    omega
  have hrank : ∀ E : Subgroup G, E ≤ normalizer ((blockU2 L s : Subgroup G) : Set G) →
      IsElemAbelian 3 E → Nat.card E ≤ 9 :=
    fun E hE hEa => card_isElemAbelian_three_le hcs.setting.qtke.2.2 hNloc hE hEa
  exact false_of_centralizing_order_three e₀ hKN hrank hcN hc3 hc1
    (fun a ha => hAC c hcA a ha)

theorem claim1_of_claim2
    (hD : AppC.C56DoubleA3) (h27_1 : Lemma2_4_27_1A3) (h34 : Lemma2_4_34_used)
    (h2 : Lemma2_4_36_claim2) : Lemma2_4_36_claim1 := by
  intro G _ _ T M H S L s x z₁ z₂ K hK r hr hr2
  by_contra hcon
  have hr1 : r ≠ 1 := fun h => hcon (Or.inl h)
  have hrz : r ≠ z₂ := fun h => hcon (Or.inr h)
  obtain ⟨hrR, hrC⟩ := hr
  by_cases hgood : ∃ a ∈ conjR K s, a * (r * z₂) ≠ (r * z₂) * a
  · exact hK.false_of_good_involution hD h27_1 h34 h2 hrR hrC hr2 hr1 hgood
  · push Not at hgood
    have hz₂2 : z₂ * z₂ = 1 := by simpa [pow_two] using hK.toA3A3x.sq₂
    have hrz₂ : r * z₂ = z₂ * r := Subgroup.mem_centralizer_iff.mp hK.toA3A3x.z₂_mem.2 r hrR
    have hr'R : r * z₂ ∈ baum S := (baum S).mul_mem hrR hK.z₂_mem_baum
    have hr'C : r * z₂ ∈ Subgroup.centralizer (K : Set G) :=
      Subgroup.mul_mem _ hrC hK.z₂_mem_centralizer
    have hr'2 : (r * z₂) * (r * z₂) = 1 := by
      calc (r * z₂) * (r * z₂) = r * (z₂ * r) * z₂ := by group
        _ = r * (r * z₂) * z₂ := by rw [hrz₂]
        _ = (r * r) * (z₂ * z₂) := by group
        _ = 1 := by rw [hr2, hz₂2]; group
    have hr'1 : r * z₂ ≠ 1 := by
      intro h
      apply hrz
      calc r = r * z₂ * z₂ := by rw [mul_assoc, hz₂2, mul_one]
        _ = z₂ := by rw [h, one_mul]
    refine hK.false_of_good_involution hD h27_1 h34 h2 hr'R hr'C hr'2 hr'1 ?_
    by_contra hall
    push Not at hall
    obtain ⟨ι, -⟩ := exists_conjR_equiv K s
    obtain ⟨e₀⟩ := hK.nonempty_alt6 h34
    have heA : ↥(conjR K s) ≃* alternatingGroup (Fin 6) := ι.symm.trans e₀
    have hrr : r * z₂ * z₂ = r := by rw [mul_assoc, hz₂2, mul_one]
    have hrr2 : r * (r * z₂) = z₂ := by rw [← mul_assoc, hr2, one_mul]
    have hz1 : z₂ = 1 := eq_one_of_mem_centralizer heA hK.z₂_mem_conjR (fun a ha => by
      have h1 := hall a ha
      have h2' := hgood a ha
      rw [hrr] at h1
      calc a * z₂ = a * (r * (r * z₂)) := by rw [hrr2]
        _ = (a * r) * (r * z₂) := by group
        _ = (r * a) * (r * z₂) := by rw [h1]
        _ = r * (a * (r * z₂)) := by group
        _ = r * ((r * z₂) * a) := by rw [h2']
        _ = (r * (r * z₂)) * a := by group
        _ = z₂ * a := by rw [hrr2])
    exact hK.toA3A3x.z₂_ne hz1

end Main

