namespace CFSG.QuasithinUnique.A5

open CFSG.Sporadic.J4

set_option maxHeartbeats 0 in
theorem d4_checks_true :
    (Dec2.chkGrp b1344Words && Dec2.chkGrp a85Words &&
      chkD4 d4Reps d4Words d4Wit [b1344Words, a85Words]) = true :=
  Certificates.certificate4108

theorem d4_hD4 :
    ∀ (q : Row) (v : ↥J), q ∈ {q : Row | ∃ w ∈ d4Reps.toList, q = toRow w.toVec} →
      PentCand q v → FpfX0 (pentSub v) → ¬ HasCommonFixedPt (pentSub v) →
      ∃ V' ∈ [B1344, A85], ∃ g : ↥J, pentSub v = V'.map (cm g) := by
  have h := d4_checks_true
  simp only [Bool.and_eq_true] at h
  exact d4_sound h.1.1 h.1.2 h.2

end CFSG.QuasithinUnique.A5
