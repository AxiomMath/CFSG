structure Delta5Residual : Prop where
  rows : Delta5Rows
  l3odd : ∀ (X : Type) [Group X] [Finite X] (p : ℕ), CFSG.IsQuasisimple X → p.Prime → p ≠ 2 →
    IsPSL 3 p 1 X → NoDelta5In X
  u3odd : ∀ (X : Type) [Group X] [Finite X] (p : ℕ), CFSG.IsQuasisimple X → p.Prime → p ≠ 2 →
    IsPSU 3 p 1 X → NoDelta5In X
  sl3odd : ∀ (X : Type) [Group X] [Finite X] (s : Bool) (p : ℕ), CFSG.IsQuasisimple X →
    p.Prime → p ≠ 2 → IsSLEps3 s p X → NoDelta5In X
  hat7 : ∀ (X : Type) [Group X] [Finite X], CFSG.IsQuasisimple X →
    IsHat X (alternatingGroup (Fin 7)) → NoDelta5In X
  m24 : ∀ (X : Type) [Group X] [Finite X], CFSG.IsQuasisimple X → IsSporadic .M24 X → NoDelta5In X
  j1 : ∀ (X : Type) [Group X] [Finite X], CFSG.IsQuasisimple X → IsSporadic .J1 X → NoDelta5In X
  j2 : ∀ (X : Type) [Group X] [Finite X], CFSG.IsQuasisimple X → IsSporadic .J2 X → NoDelta5In X
  hs : ∀ (X : Type) [Group X] [Finite X], CFSG.IsQuasisimple X → IsSporadic .HS X → NoDelta5In X
  he : ∀ (X : Type) [Group X] [Finite X], CFSG.IsQuasisimple X → IsSporadic .He X → NoDelta5In X
  ru : ∀ (X : Type) [Group X] [Finite X], CFSG.IsQuasisimple X → IsSporadic .Ru X → NoDelta5In X

theorem noDelta5In_of_mathieu {X : Type} [Group X] [Finite X] (hR : MathieuNoDelta5)
    (h : IsSporadic .M22 ↥(⊤ : Subgroup X) ∨
      IsHat ↥(⊤ : Subgroup X) (CFSG.Blueprint.NativeSporadic.Carrier .M22) ∨
      IsSporadic .M23 ↥(⊤ : Subgroup X)) : NoDelta5In X :=
  fun T hT B _ _ hTB hD => hR X ⊤ T B h hT le_top hTB hD

theorem noDelta5In_of_j4 {X : Type} [Group X] [Finite X] (hR : A314J4NoDelta5)
    (h : IsSporadic .J4 ↥(⊤ : Subgroup X)) : NoDelta5In X :=
  fun T hT B _ _ hTB hD => hR X ⊤ B T h hT le_top hTB hD

theorem isSporadic_top {X : Type} [Group X] {s : TauCeti.SporadicName} (h : IsSporadic s X) :
    IsSporadic s ↥(⊤ : Subgroup X) := by
  obtain ⟨e⟩ := h
  exact ⟨Subgroup.topEquiv.trans e⟩

theorem noDelta5_of_sqtkSimpleList
    (hM : A314ModelFacts) (hR : Delta5Residual) {X : Type} [Group X]
    [Finite X] (hq : CFSG.IsQuasisimple X) (h : CFSG.Milestones.SQTKSimpleList X) :
    NoDelta5In X := by
  have ofA : A312L.A312For X → NoDelta5In X := fun hA => noDelta5In_of_a312Case hM hR.rows hA
  rcases h with ⟨n, h5, h8, ⟨e⟩⟩ | ⟨p, hp, hp2, ⟨f, hf, hm⟩ | hm | hm⟩ |
      (⟨f, ⟨h2, hm⟩ | ⟨h1, hm⟩ | ⟨h2, hm⟩ | ⟨h2, hm⟩ | ⟨h2, hm⟩ | ⟨h1, hm⟩ | ⟨ho, h3, hm⟩ |
        ⟨ho, h3, hm⟩⟩ | hT) | ⟨n, hn, hm⟩ | ⟨s, hs, ⟨e⟩⟩
  · obtain rfl | rfl | rfl | rfl : n = 5 ∨ n = 6 ∨ n = 7 ∨ n = 8 := by omega
    · exact ofA (A312L.l2even X 2 hq le_rfl
        (CFSG.QuasithinUnique.Ch1.statedClassicalModel_psl_two_four_of_alternating_five X ⟨e⟩))
    · exact ofA (A312L.alt6 X hq ⟨e⟩)
    · exact ofA (A312L.alt7 X hq ⟨e⟩)
    · exact ofA (A312L.l4 X hq
        (CFSG.QuasithinUnique.Ch1.statedClassicalModel_psl_four_two_of_alternating_eight X ⟨e⟩))
  · rcases hf with rfl | rfl
    · exact ofA (A312L.l2p X p hq hp hp2 hm)
    · exact ofA (A312L.l2psq X p hq hp hp2 hm)
  · exact hR.l3odd X p hq hp hp2 hm
  · exact hR.u3odd X p hq hp hp2 hm
  · exact ofA (A312L.l2even X f hq h2 hm)
  · exact ofA (A312L.l3even X f hq h1 hm)
  · exact ofA (A312L.u3even X f hq h2 hm)
  · exact ofA (A312L.sp4 X f hq h2 hm)
  · exact ofA (A312L.g2 X f hq h2 hm)
  · exact ofA (A312L.d4 X f hq h1 hm)
  · exact ofA (A312L.f4 X f hq ho h3 hm)
  · exact ofA (A312L.sz X f hq ho h3 hm)
  · exact ofA (A312L.tits X hq hT)
  · obtain rfl | rfl := hn
    · exact ofA (A312L.l4 X hq hm)
    · exact ofA (A312L.l5 X hq hm)
  · rcases hs with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact ofA (A312L.m11 X hq ⟨e⟩)
    · exact ofA (A312L.m12 X hq ⟨e⟩)
    · exact noDelta5In_of_mathieu hR.rows.mathieu (Or.inl (isSporadic_top ⟨e⟩))
    · exact noDelta5In_of_mathieu hR.rows.mathieu (Or.inr (Or.inr (isSporadic_top ⟨e⟩)))
    · exact hR.m24 X hq ⟨e⟩
    · exact hR.j1 X hq ⟨e⟩
    · exact hR.j2 X hq ⟨e⟩
    · exact noDelta5In_of_j4 hR.rows.j4 (isSporadic_top ⟨e⟩)
    · exact hR.hs X hq ⟨e⟩
    · exact hR.he X hq ⟨e⟩
    · exact hR.ru X hq ⟨e⟩

theorem noDelta5_of_coverList
    (hM : A314ModelFacts) (hR : Delta5Residual) {X : Type} [Group X]
    [Finite X] (hq : CFSG.IsQuasisimple X) (h : A36Case2List X) : NoDelta5In X := by
  have ofA : A312L.A312For X → NoDelta5In X := fun hA => noDelta5In_of_a312Case hM hR.rows hA
  rcases h with ⟨s, p, e, hp, he, ⟨rfl, hmod⟩ | ⟨hp2, rfl⟩, hX⟩ | h6 | h7 | h22
  · exact ofA (A312L.famSl3even_of_minus A312L.sl3evenMinus X s e hq he hmod hX)
  · rw [pow_one] at hX
    exact hR.sl3odd X s p hq hp hp2 hX
  · exact ofA (A312L.hat6 X hq h6)
  · exact hR.hat7 X hq h7
  · exact noDelta5In_of_mathieu hR.rows.mathieu
      (Or.inr (Or.inl (IsHat.of_mulEquiv (Subgroup.topEquiv (G := X)).symm h22)))

theorem noDelta5_quasisimple
    (hT : ThreeCoverFactCat) (hM : A314ModelFacts) (hR : Delta5Residual)
    (X : Type) [Group X] [Finite X] (hq : CFSG.IsQuasisimple X) (hS : IsSQTKCat X)
    (hO : CFSG.pCore 2 X = ⊥) : NoDelta5In X := by
  have hodd : Odd (Nat.card (Subgroup.center X)) := A36A.odd_card_center hO
  have hstep : CatalogStepConclusion X := catalogStepHyp X hq hS hodd
  have hnonab : ∃ a b : X ⧸ Subgroup.center X, a * b ≠ b * a := hq.2.2
  have hlist : CFSG.Milestones.SQTKSimpleList (X ⧸ Subgroup.center X) :=
    CFSG.Milestones.cl_lit_sqtk_simple_list _ hnonab (hstep.2 _ le_rfl)
      (catalog_center_quotient hq hS.2)
  rcases hstep.1 with h1 | h3
  · have hZbot : Subgroup.center X = ⊥ := Subgroup.eq_bot_of_card_eq _ h1
    exact noDelta5_of_sqtkSimpleList hM hR hq
      (CFSG.QuasithinUnique.Ch1.sqtkSimpleList_of_mulEquiv
        (CFSG.QuasithinUnique.Ch1.mulEquivQuotientOfCenterEqBot hZbot) hlist)
  · exact noDelta5_of_coverList hM hR hq (hT X hq h3 hlist)

theorem a314A5Excluded_direct
    (hT : ThreeCoverFactCat) (hcore : A36CoreForSQTKCat)
    (h37 : A37ForSQTKCat) (h39 : A39ForSQTKCat) (hM : A314ModelFacts) (hR : Delta5Residual) :
    A314A5Excluded :=
  a314A5Excluded_of_noDelta5 hcore h37 h39 fun X _ _ hq hS hO =>
    noDelta5_quasisimple hT hM hR X hq hS hO

end CFSG.QuasithinUnique.A5.G3
