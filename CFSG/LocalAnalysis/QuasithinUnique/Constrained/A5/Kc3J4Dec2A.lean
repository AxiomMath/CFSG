theorem card_closure_eta_span_b (hM : MatFacts) (m0 m1 m2 m3 : ℕ)
    (hlt : ∀ t < 16, cmb m0 m1 m2 m3 t < 2048)
    (hinj : ∀ t < 16, ∀ t' < 16, cmb m0 m1 m2 m3 t = cmb m0 m1 m2 m3 t' → t = t')
    (hcl : ∀ t < 16, ∀ k < 4, cmb m0 m1 m2 m3 t ^^^ [m0, m1, m2, m3].getD k 0 =
      cmb m0 m1 m2 m3 (t ^^^ 2 ^ k)) :
    Nat.card (Subgroup.closure {x | x ∈ [m0, m1, m2, m3].map (eta uJ 11)}) = 16 := by
  have hel := elem_uJ hM
  let G : Subgroup J := Subgroup.closure {x | x ∈ [m0, m1, m2, m3].map (eta uJ 11)}
  let f : ℕ → J := fun t => eta uJ 11 (cmb m0 m1 m2 m3 t)
  have hgen : ∀ m ∈ [m0, m1, m2, m3], eta uJ 11 m ∈ G := fun m hm =>
    Subgroup.subset_closure (List.mem_map.2 ⟨m, hm, rfl⟩)
  have hbit : ∀ (b : Bool) (m : ℕ), m ∈ [m0, m1, m2, m3] →
      eta uJ 11 (if b then m else 0) ∈ G := by
    intro b m hm
    cases b
    · simp [eta_zero]
    · simpa using hgen m hm
  have hfG : ∀ t, f t ∈ G := by
    intro t
    simp only [f, cmb]
    rw [eta_xor hel le_rfl, eta_xor hel le_rfl, eta_xor hel le_rfl]
    exact G.mul_mem (G.mul_mem (G.mul_mem (hbit _ _ (by simp)) (hbit _ _ (by simp)))
      (hbit _ _ (by simp))) (hbit _ _ (by simp))
  have hsub : ∀ g ∈ G, ∃ t < 16, g = f t := by
    have h := QT2A.closure_subset_of_closed {x | x ∈ [m0, m1, m2, m3].map (eta uJ 11)}
      {g | ∃ t < 16, g = f t} ⟨0, by norm_num, by simp [f, cmb, eta_zero]⟩ (by
        rintro _ ⟨t, ht, rfl⟩ g hg
        obtain ⟨m, hm, rfl⟩ := List.mem_map.1 hg
        have hk : ∃ k < 4, [m0, m1, m2, m3].getD k 0 = m := by
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hm
          rcases hm with rfl | rfl | rfl | rfl
          · exact ⟨0, by norm_num, rfl⟩
          · exact ⟨1, by norm_num, rfl⟩
          · exact ⟨2, by norm_num, rfl⟩
          · exact ⟨3, by norm_num, rfl⟩
        obtain ⟨k, hk4, hkm⟩ := hk
        have hk16 : 2 ^ k < 16 := by
          have : 2 ^ k < 2 ^ 4 := Nat.pow_lt_pow_right (by norm_num) hk4
          simpa using this
        refine ⟨t ^^^ 2 ^ k, by
          have := Nat.xor_lt_two_pow (n := 4) (x := t) (y := 2 ^ k) (by simpa using ht)
            (by simpa using hk16)
          simpa using this, ?_⟩
        change f t * eta uJ 11 m = f (t ^^^ 2 ^ k)
        simp only [f]
        rw [← eta_xor hel le_rfl, ← hkm, hcl t ht k hk4])
    exact fun g hg => h hg
  have hset : (G : Set J) = ↑((Finset.range 16).image f) := by
    ext x
    constructor
    · intro hx
      obtain ⟨t, ht, rfl⟩ := hsub x hx
      exact Finset.mem_coe.2 (Finset.mem_image.2 ⟨t, Finset.mem_range.2 ht, rfl⟩)
    · intro hx
      obtain ⟨t, -, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hx)
      exact hfG t
  have h1 : Nat.card G = ((Finset.range 16).image f).card := by
    rw [← Set.ncard_coe_finset, ← hset]
    exact Nat.card_coe_set_eq _
  rw [h1, Finset.card_image_of_injOn, Finset.card_range]
  intro t ht t' ht' he
  exact hinj t (Finset.mem_range.1 ht) t' (Finset.mem_range.1 ht')
    (eta_inj hM _ (hlt t (Finset.mem_range.1 ht)) _ (hlt t' (Finset.mem_range.1 ht')) he)

theorem card_A21 (hM : MatFacts) : Nat.card A21 = 16 :=
  card_closure_eta_span_b hM 1056 321 43 796 (by decide) (by decide) (by decide)

theorem card_A77 (hM : MatFacts) : Nat.card A77 = 16 :=
  card_closure_eta_span_b hM 768 299 213 1414 (by decide) (by decide) (by decide)

theorem noNonHBlockAt_of_le_E_b
    (hF : J4Basic) {V : Subgroup J} (hVE : V ≤ Eg uJ 11) (hc : Nat.card V = 16) :
    NoNonHBlockAt Hj V := by
  refine noNonHBlockAt_of_normalizer_le 1 ?_
  intro n hn
  exact ⟨n, normalizer_le_Hj_of_le_E_b hF hVE hc hn, by simp⟩

theorem j4_hdA_of_X0 (hF : J4Basic) (hK0 : Subgroup.centralizer ({fiveElt} : Set J) ≤ X0Sub) :
    ∀ V' ∈ reps2A, ClassRad V' ∨ NoNonHBlockAt Hj V' := by
  intro V' hV'
  simp only [reps2A, List.mem_cons, List.not_mem_nil, or_false] at hV'
  rcases hV' with rfl | rfl | rfl | rfl
  · exact Or.inr (noNonHBlockAt_of_le_E_b hF A21_le_E (card_A21 hF.mat))
  · exact Or.inr (noNonHBlockAt_of_le_E_b hF A77_le_E (card_A77 hF.mat))
  · exact Or.inl (classRad_A941 hF hK0)
  · exact Or.inl (classRad_A85 hF hK0)

