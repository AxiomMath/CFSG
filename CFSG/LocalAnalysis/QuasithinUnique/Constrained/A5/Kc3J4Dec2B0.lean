theorem chkAll_B1344 : chkAll b1344Words b1344Q = true :=
  Certificates.certificate4110

@[expose] noncomputable def b1344q : J := el5 b1344P * eta uJ 11 269 * el5 b1344S

theorem Mx_b1344q (hM : MatFacts) : Mx b1344q = rowsMatrix b1344Q := by
  unfold b1344q b1344Q
  rw [map_mul, map_mul, QT2A.Mx_el5 hM, Mx_eta hM 11 le_rfl 269,
    QT2A.Mx_el5 hM, ← rowsMatrix_mulRows, ← rowsMatrix_mulRows]
  rfl

theorem classRad_B1344 (hF : J4Basic) (hK0 : Subgroup.centralizer ({fiveElt} : Set J) ≤ X0Sub) :
    ClassRad B1344 :=
  classRad_of_chkAll_b (ws := b1344Words) hF hK0 (Mx_b1344q hF.mat) chkAll_B1344

theorem j4_hdB0_of_X0 (hF : J4Basic) (hK0 : Subgroup.centralizer ({fiveElt} : Set J) ≤ X0Sub) :
    ∀ V' ∈ reps2B0, ClassRad V' ∨ NoNonHBlockAt Hj V' := by
  intro V' hV'
  simp only [reps2B0, List.mem_singleton] at hV'
  subst hV'
  exact Or.inl (classRad_B1344 hF hK0)

