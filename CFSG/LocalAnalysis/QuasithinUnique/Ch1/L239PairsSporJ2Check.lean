theorem s0_facts : S0X.length = 128 ∧
    strictAsc ((S0X.map enc).mergeSort (fun a b => decide (a ≤ b))) = true ∧ (1 : XJ) ∈ S0X ∧
    (∀ x ∈ S0X, ∀ g ∈ s0gen, enc (x * g) ∈ S0X.map enc) ∧ (∀ x ∈ S0X, x ^ (2 ^ 3) = 1) :=
  Certificates.certificate4091.1

theorem a_facts : A1X.length = 2 ∧ Z2X.length = 4 ∧ A2X.length = 64 ∧
    (∀ a ∈ a2gen, enc a ∈ A2X.map enc) ∧ (∀ y ∈ A2X, enc y ∈ A2cl.map enc) :=
  Certificates.certificate4091.2.1

theorem k1_facts : K1X.length = 1920 ∧
    strictAsc ((K1X.map enc).mergeSort (fun a b => decide (a ≤ b))) = true ∧
    (∀ x ∈ K1X, ∀ a ∈ A1X, enc (x * a * x⁻¹) ∈ A1X.map enc ∧ enc (x⁻¹ * a * x) ∈ A1X.map enc) ∧
    (∀ x ∈ K1X, x • F1X = F1X) :=
  Certificates.certificate4091.2.2.1

theorem orb1_facts :
    Reach gensA F1X orb1.1 orb1.2.1 orb1.2.2 ∧ orb1.1.length = 315 ∧
    strictAsc ((orb1.1.map maskF).mergeSort (fun a b => decide (a ≤ b))) = true :=
  Certificates.certificate4091.2.2.2.1

theorem k2_facts : K2X.length = 1152 ∧
    strictAsc ((K2X.map enc).mergeSort (fun a b => decide (a ≤ b))) = true ∧
    (∀ x ∈ K2X, nrmTestGens enc (A2X.map enc) a2gen x = true) ∧ (∀ x ∈ K2X, x • F2X = F2X) :=
  Certificates.certificate4091.2.2.2.2.1

theorem orb2_facts :
    Reach gensA F2X orb2.1 orb2.2.1 orb2.2.2 ∧ orb2.1.length = 525 ∧
    strictAsc ((orb2.1.map maskF).mergeSort (fun a b => decide (a ≤ b))) = true :=
  Certificates.certificate4091.2.2.2.2.2.1

theorem q1_facts : Q1X.length = 32 ∧
    strictAsc ((Q1X.map enc).mergeSort (fun a b => decide (a ≤ b))) = true ∧
    (∀ q ∈ Q1X, enc q ∈ K1X.map enc) ∧ (1 : XJ) ∈ Q1X ∧
    (∀ p ∈ Q1X, ∀ q ∈ Q1X, enc (p * q) ∈ Q1X.map enc) ∧
    (∀ k ∈ k1gen, ∀ q ∈ Q1X,
      enc (k * q * k⁻¹) ∈ Q1X.map enc ∧ enc (k⁻¹ * q * k) ∈ Q1X.map enc) ∧
    (∀ q ∈ Q1X, q ^ (2 ^ 2) = 1) ∧
    (∀ y ∈ K1X, (∀ q ∈ Q1X, enc (y * q) = enc (q * y)) → enc y ∈ Q1X.map enc) ∧
    (∀ b ∈ K1X, b ≠ 1 → b ^ 3 = 1 → ∃ p ∈ Q1X, ∃ q ∈ Q1X,
      enc ((p * b * p⁻¹ * b⁻¹) * (q * b * q⁻¹ * b⁻¹)) ≠
        enc ((q * b * q⁻¹ * b⁻¹) * (p * b * p⁻¹ * b⁻¹)) ∨
      enc ((p * b * p⁻¹ * b⁻¹) * (p * b * p⁻¹ * b⁻¹)) ≠ enc 1) :=
  Certificates.certificate4091.2.2.2.2.2.2.1

theorem q2_facts :
    strictAsc ((A2X.map enc).mergeSort (fun a b => decide (a ≤ b))) = true ∧
    (∀ q ∈ A2X, enc q ∈ K2X.map enc) ∧ (1 : XJ) ∈ A2X ∧
    (∀ p ∈ A2X, ∀ q ∈ A2X, enc (p * q) ∈ A2X.map enc) ∧
    (∀ k ∈ k2gen, ∀ q ∈ A2X,
      enc (k * q * k⁻¹) ∈ A2X.map enc ∧ enc (k⁻¹ * q * k) ∈ A2X.map enc) ∧
    (∀ q ∈ A2X, q ^ (2 ^ 2) = 1) ∧
    (∀ y ∈ K2X, (∀ q ∈ A2X, enc (y * q) = enc (q * y)) → enc y ∈ A2X.map enc) ∧
    (∀ b ∈ K2X, b ≠ 1 → b ^ 3 = 1 →
      4 < ((A2X.map fun q => enc (q * b * q⁻¹ * b⁻¹)).dedup).length) ∧
    K2X.length / A2X.length = 18 :=
  Certificates.certificate4091.2.2.2.2.2.2.2.1

theorem gen_facts :
    (jLetters.all fun g => (K1X ++ K2X).any fun x => enc x == enc g) = true ∧
    evalW jLetters wordA = paC ∧ evalW jLetters wordB = pbC :=
  Certificates.certificate4091.2.2.2.2.2.2.2.2

