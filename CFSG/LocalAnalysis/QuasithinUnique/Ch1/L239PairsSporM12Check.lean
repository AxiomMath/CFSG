namespace CFSG.QuasithinUnique.Vol2Native.L239.M12Pairs

open CFSG.Sporadic.Schreier CFSG.Sporadic.Mathieu CFSG.Blueprint

theorem mem_enum (g : Equiv.Perm (Fin 12)) :
    g ∈ enumeration m12Certificate ↔ g ∈ NativeSporadic.M12 := by
  rw [mem_enumeration_iff m12Certificate m12Certificate_check g, m12Certificate_originalSubgroup]

@[expose] def XlX : List X12 :=
  (enumeration m12Certificate).attach.map fun g => ⟨g.1, (mem_enum g.1).1 g.2⟩

theorem mem_XlX (x : X12) : x ∈ XlX := by
  simp only [XlX, List.mem_map, List.mem_attach, true_and, Subtype.exists]
  exact ⟨x.1, (mem_enum x.1).2 x.2, Subtype.ext rfl⟩

theorem enc_injective : Function.Injective enc := by
  intro x y h
  have h1 : ∀ i : Fin 12, (x.1 i).val = (y.1 i).val := by
    intro i
    have := congrArg (fun l : List ℕ => l[i.val]?) h
    simpa [enc] using this
  exact Subtype.ext (Equiv.ext fun i => Fin.ext (h1 i))

theorem mem_encList {L : List X12} {x : X12} : enc x ∈ L.map enc ↔ x ∈ L :=
  List.mem_map_of_injective enc_injective

theorem nrmTest_iff {A pre : List X12} (hpre : ∀ a ∈ pre, a ∈ A) {g : X12} :
    nrmTest A (A.map enc) pre g = true ↔ ∀ a ∈ A, g * a * g⁻¹ ∈ A ∧ g⁻¹ * a * g ∈ A := by
  simp only [nrmTest, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq, mem_encList]
  constructor
  · rintro ⟨-, h⟩ a ha
    exact h a ha
  · intro h
    exact ⟨fun a ha => (h a (hpre a ha)).1, h⟩

theorem nrmTestP_eq (A : List X12) (EA : List (List ℕ)) (pre : List X12) (x : X12) :
    nrmTestP A EA pre x.1 = nrmTest A EA pre x := rfl

theorem mem_XlX_enum {x : X12} (hx : x ∈ XlX) : x.1 ∈ enumeration m12Certificate := by
  obtain ⟨g, -, rfl⟩ := List.mem_map.1 hx
  exact g.2

theorem s0_facts : S0X.length = 64 ∧ S0X.Nodup ∧ (1 : X12) ∈ S0X ∧
    (∀ x ∈ S0X, ∀ y ∈ S0X, x * y ∈ S0X) ∧ (∀ x ∈ S0X, x ^ (2 ^ 6) = 1) :=
  Certificates.certificate4093.1

theorem a_facts : A1X.length = 2 ∧ A2X.length = 16 :=
  Certificates.certificate4093.2.1

theorem k1_core : K1X.length = 192 ∧ K1X.Nodup ∧
    (∀ x ∈ K1X, nrmTest A1X (A1X.map enc) (A1X.take 3) x = true) :=
  Certificates.certificate4093.2.2.1

theorem k1_complete : (enumeration m12Certificate).all (fun g =>
    decide (nrmTestP A1X (A1X.map enc) (A1X.take 3) g = true → encP g ∈ K1X.map enc)) = true :=
  Certificates.certificate4093.2.2.2.1

theorem k1_facts : K1X.length = 192 ∧ K1X.Nodup ∧
    (∀ x ∈ K1X, nrmTest A1X (A1X.map enc) (A1X.take 3) x = true) ∧
    (∀ x ∈ XlX, nrmTest A1X (A1X.map enc) (A1X.take 3) x = true → x ∈ K1X) :=
  ⟨k1_core.1, k1_core.2.1, k1_core.2.2, fun x hx h =>
    mem_encList.1 (of_decide_eq_true (List.all_eq_true.1 k1_complete x.1 (mem_XlX_enum hx))
      ((nrmTestP_eq A1X (A1X.map enc) (A1X.take 3) x).trans h))⟩

theorem k2_core : K2X.length = 192 ∧ K2X.Nodup ∧
    (∀ x ∈ K2X, nrmTest A2X (A2X.map enc) (A2X.take 3) x = true) :=
  Certificates.certificate4093.2.2.2.2.1

theorem k2_complete : (enumeration m12Certificate).all (fun g =>
    decide (nrmTestP A2X (A2X.map enc) (A2X.take 3) g = true → encP g ∈ K2X.map enc)) = true :=
  Certificates.certificate4093.2.2.2.2.2.1

theorem k2_facts : K2X.length = 192 ∧ K2X.Nodup ∧
    (∀ x ∈ K2X, nrmTest A2X (A2X.map enc) (A2X.take 3) x = true) ∧
    (∀ x ∈ XlX, nrmTest A2X (A2X.map enc) (A2X.take 3) x = true → x ∈ K2X) :=
  ⟨k2_core.1, k2_core.2.1, k2_core.2.2, fun x hx h =>
    mem_encList.1 (of_decide_eq_true (List.all_eq_true.1 k2_complete x.1 (mem_XlX_enum hx))
      ((nrmTestP_eq A2X (A2X.map enc) (A2X.take 3) x).trans h))⟩

theorem q1_facts :
    Q1X.length = 32 ∧ Q1X.Nodup ∧ (∀ q ∈ Q1X, q ∈ K1X) ∧ (1 : X12) ∈ Q1X ∧
    (∀ p ∈ Q1X, ∀ q ∈ Q1X, p * q ∈ Q1X) ∧ (∀ k ∈ K1X, ∀ q ∈ Q1X, k * q * k⁻¹ ∈ Q1X) ∧
    (∀ q ∈ Q1X, q ^ (2 ^ 5) = 1) ∧
    (∀ y ∈ K1X, (∀ q ∈ Q1X, y * q = q * y) → y ∈ Q1X) ∧
    (∀ b ∈ K1X, b ≠ 1 → b ^ 3 = 1 →
      4 < (Q1X.map fun q => q * b * q⁻¹ * b⁻¹).dedup.length) ∧
    K1X.length / Q1X.length = 6 :=
  Certificates.certificate4093.2.2.2.2.2.2.1

theorem q2_facts :
    Q2X.length = 32 ∧ Q2X.Nodup ∧ (∀ q ∈ Q2X, q ∈ K2X) ∧ (1 : X12) ∈ Q2X ∧
    (∀ p ∈ Q2X, ∀ q ∈ Q2X, p * q ∈ Q2X) ∧ (∀ k ∈ K2X, ∀ q ∈ Q2X, k * q * k⁻¹ ∈ Q2X) ∧
    (∀ q ∈ Q2X, q ^ (2 ^ 5) = 1) ∧
    (∀ y ∈ K2X, (∀ q ∈ Q2X, y * q = q * y) → y ∈ Q2X) ∧
    (∀ b ∈ K2X, b ≠ 1 → b ^ 3 = 1 →
      4 < (Q2X.map fun q => q * b * q⁻¹ * b⁻¹).dedup.length) ∧
    K2X.length / Q2X.length = 6 :=
  Certificates.certificate4093.2.2.2.2.2.2.2.1

theorem gen_facts :
    (jGens.all fun g => (K1X ++ K2X).any fun x => x.1 == g) = true ∧
    (wordA.map fun i => jGens.getD i 1).prod = m12gA ∧
    (wordB.map fun i => jGens.getD i 1).prod = m12gB :=
  Certificates.certificate4093.2.2.2.2.2.2.2.2

