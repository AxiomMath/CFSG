@[expose] def normProds (e : List Nat × List (List Nat) × List (List Nat)) : List (List Nat) :=
  e.2.1.flatMap fun ψ => e.2.2.map fun π => cmul ψ π

theorem norm_data_refl : normData.map (fun e => e.1) = dLit.filter isRefl := by decide +kernel

theorem norm_data_ok : normData.all (fun e => e.2.1 == pslLit.filter (normKlein e.1) &&
    e.2.2 == p0Lit.filter (normKlein e.1)) = true := by decide +kernel

theorem klein_comm_check : normData.all (fun e => e.2.1.all fun ψ => e4Lit.all fun τ =>
    (kleinOf e.1).any fun ε => cmul ψ τ == cmul (cmul τ ε) ψ) = true := by decide +kernel

theorem norm_comm_e4_check : normData.all (fun e => e.2.2.all fun p => e4Lit.all fun τ =>
    cmul p τ == cmul τ p) = true := by decide +kernel

@[expose] def decompOk (l : List (List Nat)) : Bool :=
  normData.all fun e => l.all fun α => !normKlein e.1 α || (normProds e).contains α

theorem decomp_chunk_0 : decompOk (autL.take 360) = true := by decide +kernel

theorem decomp_chunk_1 : decompOk ((autL.drop 360).take 360) = true := by decide +kernel

theorem decomp_chunk_2 : decompOk ((autL.drop 720).take 360) = true := by decide +kernel

theorem decomp_chunk_3 : decompOk (autL.drop 1080) = true := by decide +kernel

theorem decompOk_iff (l : List (List Nat)) : decompOk l = true ↔ ∀ e ∈ normData, ∀ α ∈ l,
    (!normKlein e.1 α || (normProds e).contains α) = true := by
  unfold decompOk
  simp only [List.all_eq_true]

theorem norm_decomp_check : ∀ e ∈ normData, ∀ α ∈ autL,
    (!normKlein e.1 α || (normProds e).contains α) = true := by
  have h0 := (decompOk_iff _).1 decomp_chunk_0
  have h1 := (decompOk_iff _).1 decomp_chunk_1
  have h2 := (decompOk_iff _).1 decomp_chunk_2
  have h3 := (decompOk_iff _).1 decomp_chunk_3
  intro e he α hα
  have e1 : autL = autL.take 360 ++ autL.drop 360 := (List.take_append_drop 360 autL).symm
  have e2 : autL.drop 360 = (autL.drop 360).take 360 ++ (autL.drop 360).drop 360 :=
    (List.take_append_drop 360 (autL.drop 360)).symm
  have e3 : (autL.drop 360).drop 360 = ((autL.drop 360).drop 360).take 360 ++
      ((autL.drop 360).drop 360).drop 360 :=
    (List.take_append_drop 360 ((autL.drop 360).drop 360)).symm
  rw [e1, List.mem_append, e2, List.mem_append, e3, List.mem_append] at hα
  rcases hα with h | h | h | h
  · exact h0 e he α h
  · exact h1 e he α h
  · have := h2 e he α (by simpa [List.drop_drop] using h)
    exact this
  · exact h3 e he α (by simpa [List.drop_drop] using h)

