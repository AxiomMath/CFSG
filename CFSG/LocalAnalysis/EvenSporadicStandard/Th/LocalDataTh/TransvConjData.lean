@[expose] def TFacts : Bool :=
  allMat4.all fun cs =>
    !(decide (8 ≤ fixedCount cs) && cs != idCols 4 && invCode cs) ||
      convTab.any fun p => p.1 == cs && wf4 p.2 && invCode p.2 &&
        mulCols 4 p.2 T0cols == mulCols 4 cs p.2

