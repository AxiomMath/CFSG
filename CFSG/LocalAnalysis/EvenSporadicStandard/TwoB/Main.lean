theorem exists_d0 : ∃ d₀ : B, orderOf d₀ = 2 ∧ Matrix.rank (d₀.val.val - 1) = 1860 :=
  ⟨phiB uBar, orderOf_phiB_uBar, rank_phiB_uBar_sub_one⟩

theorem isSporadic_M_of_gmsF1Type {G : Type} [Group G] [Finite G] {d₀ : B} (hd₀ : orderOf d₀ = 2)
    (hrank : Matrix.rank (d₀.val.val - 1) = 1860) {a z : G} (h : GMSF1Type d₀ a z) :
    IsSporadic G .M := by
  obtain ⟨e⟩ := CFSG.Milestones.cl_lit_gms_monster_uniqueness d₀ hd₀ hrank G a z h
  obtain ⟨f⟩ := nonempty_mulEquiv_autO_carrierM
  exact ⟨e.trans f⟩

theorem gmsDoubleF2Centralizer_of_setting {G : Type} [Group G] [Finite G] {L : Subgroup G}
    {t : G} (h : Setting G L t) (hCt : centralizer ({t} : Set G) = L) {d₀ : B}
    (hd₀ : orderOf d₀ = 2) : GMSDoubleF2Centralizer d₀ t := by
  subst hCt
  have ht2 : orderOf t = 2 := orderOf_eq_two_of_center h.card_center h.center_eq
  exact GMSDoubleF2Centralizer.of_isTwoACentralizer ht2 CFSG.Sporadic.B.fam_b_simplicity hd₀
    ⟨Group.isPerfect_def.2 h.std.standard.1.1, h.center_eq, h.quot_B⟩

