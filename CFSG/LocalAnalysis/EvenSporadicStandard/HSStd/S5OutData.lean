@[expose] def s5oTab (k : ℕ) : Array ℕ := hexTable3 100 (100 * k) s5oHex

@[expose] def s5oSGens : Array (Array ℕ) := #[s5oTab 0, s5oTab 1, s5oTab 2, s5oTab 3]

@[expose] def s5oZ : Array ℕ := s5oTab 4

@[expose] def s5oY : Array ℕ := s5oTab 5

@[expose] def s5oS : Array ℕ := s5oTab 6

@[expose] def s5oXs : Array (Array ℕ) :=
  #[s5oTab 7, s5oTab 8, s5oTab 9, s5oTab 10, s5oTab 11, s5oTab 12, s5oTab 13]

@[expose] def s5oCGens : Array (Array ℕ) := #[s5oTab 14, s5oTab 15]

@[expose] def s5oSCert : ArrCert := enumBfs 100 s5oSGens s5Keys (2 ^ 20)

@[expose] def s5oXCert : ArrCert := enumBfs 100 s5oXs s5Keys (2 ^ 20)

@[expose] def s5oE : List (Array ℕ) := (enumBfs 100 s5oCGens s5Keys 5000).pts.toList

@[expose] def s5oCoxeterOK : Bool :=
  allLt 7 (fun i => eqA 100 (compA 100 s5oXs[i]! s5oXs[i]!) (idA 100)) &&
    allLt 6 (fun i => eqA 100 (compA 100 (compA 100 s5oXs[i]! s5oXs[i + 1]!) s5oXs[i]!)
      (compA 100 (compA 100 s5oXs[i + 1]! s5oXs[i]!) s5oXs[i + 1]!)) &&
    allLt 7 (fun i => allLt 7 (fun j => decide (j < i + 2) ||
      eqA 100 (compA 100 s5oXs[i]! s5oXs[j]!) (compA 100 s5oXs[j]! s5oXs[i]!)))

@[expose] def s5oCentOK : Bool :=
  validA 100 s5oY && s5oY[0]! == 0 && fixLevCount 100 s5Levels s5oY 0 == 30 &&
    s5oE.length == 1344 && tailOK 100 s5Levels s5oY s5oE 4 1 (idA 100)

@[expose] def s5oZWord : List ℕ := [0, 1, 0, 3, 2, 1, 0, 5, 4, 3, 6, 5]

@[expose] def s5oWordProd (w : List ℕ) : Array ℕ :=
  w.foldl (fun acc i => compA 100 acc s5oXs[i]!) (idA 100)

@[expose] def s5oPow5 (a : Array ℕ) : Array ℕ :=
  compA 100 a (compA 100 a (compA 100 a (compA 100 a a)))

@[expose] def s5oZOK : Bool :=
  s5oZWord.all (fun i => decide (i < 7)) && s5oZWord.length % 2 == 0 &&
    eqA 100 (s5oWordProd s5oZWord) s5oZ &&
    eqA 100 (compA 100 s5oXs[1]! s5oZ) (compA 100 s5oZ s5oXs[1]!) &&
    eqA 100 (compA 100 s5oZ s5oY) (compA 100 s5oY s5oZ) &&
    (s5oXCert.pts.toList.all fun a => !eqA 100 (compA 100 s5oZ a) (compA 100 a s5oZ) ||
      !eqA 100 (s5oPow5 a) (idA 100) || eqA 100 a (idA 100))

@[noinline, expose] def s5oOK : Bool :=
  enumOK 100 s5oSGens s5Keys s5oSCert && s5oSCert.pts.size == 1024 &&
    allLt s5oSGens.size (fun k => s5InP s5oSGens[k]! || s5InP (compA 100 s5U s5oSGens[k]!)) &&
    validA 100 s5oZ && s5InP s5oZ && !eqA 100 s5oZ (idA 100) &&
    eqA 100 (compA 100 s5oZ s5oZ) (idA 100) &&
    (s5oSCert.pts.toList.all fun x => !s5InP x || eqA 100 (compA 100 s5oZ x) (compA 100 x s5oZ)) &&
    validA 100 s5oY && !s5InP s5oY && eqA 100 (compA 100 s5oY s5oY) (idA 100) &&
    s5oSCert.pts.toList.any (eqA 100 s5oY) && validA 100 s5oS &&
    s5oSCert.pts.toList.any (eqA 100 s5oS) &&
    eqA 100 (compA 100 s5oS s5oY) (compA 100 (compA 100 s5oY s5oZ) s5oS) &&
    allLt 7 (fun i => validA 100 s5oXs[i]! && s5InP s5oXs[i]! &&
      eqA 100 (compA 100 s5oXs[i]! s5oY) (compA 100 s5oY s5oXs[i]!)) &&
    s5oCoxeterOK && enumOK 100 s5oXs s5Keys s5oXCert && s5oXCert.pts.size == 40320 &&
    s5oCentOK && s5oZOK

end CFSG.EvenSporadicStandard.HSStd
