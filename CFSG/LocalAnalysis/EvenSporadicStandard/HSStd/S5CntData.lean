@[expose] def s5Tab (k : ℕ) : Array ℕ := hexTable3 100 (100 * k) s5Hex

@[expose] def s5SGens : Array (Array ℕ) := #[s5Tab 0, s5Tab 1, s5Tab 2, s5Tab 3]

@[expose] def s5Z : Array ℕ := s5Tab 4

@[expose] def s5Keys : List ℕ := [0, 1, 2, 3, 4]

@[expose] def s5Levels : Array Level := rawLevels 100 hs100StrongArrs hs100BaseArr

@[expose] def s5InP (a : Array ℕ) : Bool := siftA 100 s5Levels hs100BaseArr 0 a

@[expose] def s5U : Array ℕ := hs100Arr 15

@[expose] def s5SCert : ArrCert := enumBfs 100 s5SGens s5Keys (2 ^ 20)

@[expose] def s5Out1 (a : Array ℕ) : Bool := !s5InP a && eqA 100 (compA 100 a a) (idA 100)

@[expose] def s5OutZ (a : Array ℕ) : Bool := !s5InP a && eqA 100 (compA 100 a a) s5Z

@[expose] def s5Cnt1 : ℕ :=
  (Finset.univ.filter fun i : Fin s5SCert.pts.size => s5Out1 s5SCert.pts[i.1]! = true).card

@[expose] def s5CntZ : ℕ :=
  (Finset.univ.filter fun i : Fin s5SCert.pts.size => s5OutZ s5SCert.pts[i.1]! = true).card

@[noinline, expose] def s5SylowOK : Bool :=
  enumOK 100 s5SGens s5Keys s5SCert && s5SCert.pts.size == 1024 &&
    allLt s5SGens.size (fun k => s5InP s5SGens[k]! || s5InP (compA 100 s5U s5SGens[k]!)) &&
    validA 100 s5Z && s5InP s5Z && !eqA 100 s5Z (idA 100) &&
    eqA 100 (compA 100 s5Z s5Z) (idA 100) &&
    (s5SCert.pts.toList.all fun x => !s5InP x || eqA 100 (compA 100 s5Z x) (compA 100 x s5Z)) &&
    s5Cnt1 == 104 && s5CntZ == 40

end CFSG.EvenSporadicStandard.HSStd
