@[expose] def s5fK (i : ℕ) : ℕ := CFSG.Monster.B.Max2.Native.hexAt s5fKHex.toUTF8 (2 * i) 2

@[expose] def s5fJ (i : ℕ) : ℕ := CFSG.Monster.B.Max2.Native.hexAt s5fJHex.toUTF8 (3 * i) 3

@[expose] def s5fC (k : ℕ) : Array ℕ := s5oSCert.pts[s5fRep[k]!]!

@[expose] def s5fT (i : ℕ) : Array ℕ := compA 100 s5oXs[i]! s5oXs[i + 1]!

@[expose] def s5fG (k : ℕ) : Array ℕ :=
  if k < 6 then s5fT k else conjA 100 s5oS (s5fT (k - 6))

@[expose] def s5fLetter (l : ℕ) : Array ℕ :=
  if l < 12 then s5fG l else invCand 100 (s5fG (l - 12))

@[expose] def s5fEval (w : List ℕ) : Array ℕ :=
  w.foldl (fun acc l => compA 100 acc (s5fLetter l)) (idA 100)

@[expose] def s5fWA : List ℕ := [1, 16, 17, 0, 15, 19, 14, 0, 19, 1, 2, 4]

@[expose] def s5fWB : List ℕ := [21, 19, 2, 13, 19, 4, 18, 17, 18, 22, 11, 12, 23]

@[expose] def s5fIsInv (a : Array ℕ) : Bool := eqA 100 (compA 100 a a) (idA 100)

@[noinline, expose] def s5fOK : Bool :=
  enumOK 100 s5oSGens s5Keys s5oSCert &&
    allLt s5fRep.size (fun k => decide (s5fRep[k]! < s5oSCert.pts.size)) &&
    allLt s5fRep.size (fun k => validA 100 (s5fTab k) && s5InP (s5fTab k) &&
      eqA 100 (s5oPow5 (s5fTab k)) (idA 100) && !eqA 100 (s5fTab k) (idA 100) &&
      eqA 100 (compA 100 (s5fTab k) (s5fC k)) (compA 100 (s5fC k) (s5fTab k))) &&
    allLt s5oSCert.pts.size (fun i =>
      !s5fIsInv s5oSCert.pts[i]! || eqA 100 s5oSCert.pts[i]! (idA 100) ||
        (decide (s5fK i < s5fRep.size) && decide (s5fJ i < s5oSCert.pts.size) &&
          eqA 100 (compA 100 s5oSCert.pts[s5fJ i]! (s5fC (s5fK i)))
            (compA 100 s5oSCert.pts[i]! s5oSCert.pts[s5fJ i]!))) &&
    allLt 7 (fun i => validA 100 s5oXs[i]!) && validA 100 s5oS &&
    allLt 24 (fun l => validA 100 (s5fLetter l)) &&
    s5fWA.all (fun l => decide (l < 24)) && s5fWB.all (fun l => decide (l < 24)) &&
    eqA 100 (s5fEval s5fWA) (hs100Arr 0) && eqA 100 (s5fEval s5fWB) (hs100Arr 1)

end CFSG.EvenSporadicStandard.HSStd
