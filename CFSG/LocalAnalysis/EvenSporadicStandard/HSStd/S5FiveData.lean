@[expose] def s5cTab (k : ℕ) : Array ℕ := hexTable3 100 (100 * k) s5cHex

@[expose] def s5cS : Array (Array ℕ) := #[s5cTab 0, s5cTab 1, s5cTab 2, s5cTab 3]

@[expose] def s5cGens : Array (Array ℕ) :=
  #[hs100FiveLines[2]!, s5cTab 0, s5cTab 1, s5cTab 2, s5cTab 3]

@[expose] def s5cCert : ArrCert := enumBfs 100 s5cGens hs100FiveKeys 620

@[expose] def s5cCoxeterOK : Bool :=
  allLt 4 (fun i => eqA 100 (compA 100 s5cS[i]! s5cS[i]!) (idA 100)) &&
    allLt 3 (fun i => eqA 100 (compA 100 (compA 100 s5cS[i]! s5cS[i + 1]!) s5cS[i]!)
      (compA 100 (compA 100 s5cS[i + 1]! s5cS[i]!) s5cS[i + 1]!)) &&
    allLt 4 (fun i => allLt 4 (fun j => decide (j < i + 2) ||
      eqA 100 (compA 100 s5cS[i]! s5cS[j]!) (compA 100 s5cS[j]! s5cS[i]!)))

@[noinline, expose] def s5cOK : Bool :=
  enumOK 100 s5cGens hs100FiveKeys s5cCert && s5cCert.pts.size == 600 &&
    allLt 4 (fun i => validA 100 s5cS[i]! &&
      hs100FiveC2Cert.pts.toList.any (eqA 100 s5cS[i]!)) && s5cCoxeterOK

end CFSG.EvenSporadicStandard.HSStd
