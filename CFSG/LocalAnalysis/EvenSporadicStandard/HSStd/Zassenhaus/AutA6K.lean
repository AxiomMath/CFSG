@[expose] def repsK : List ℕ := [654820258320, 632015968320, 641083073040, 624468064320]

theorem pslK_pin : (Core.pslLit.map pk == pslK) = true := by decide +kernel

theorem repsK_pin : (Core.autReps.map pk == repsK) = true := by decide +kernel

theorem autK_prod : (pslK.flatMap (fun y => repsK.map (mulK 10 y)) == autK) = true := by
  decide +kernel

theorem autK_pin : Core.autL.map pk = autK := by
  rw [← beq_iff_eq.1 autK_prod, ← beq_iff_eq.1 pslK_pin, ← beq_iff_eq.1 repsK_pin]
  unfold Core.autL
  rw [List.map_flatMap, List.flatMap_map, List.flatMap_def, List.flatMap_def]
  refine congrArg List.flatten (List.map_congr_left fun y hy => ?_)
  rw [List.map_map, List.map_map]
  refine List.map_congr_left fun r hr => ?_
  obtain ⟨Y, -, rfl⟩ := exists_psl29_of_code hy
  rw [← autRepsP_code, List.mem_map] at hr
  obtain ⟨R, -, rfl⟩ := hr
  simp only [Function.comp_apply]
  rw [← code_mul, pk_code, pk_code, pk_code, enc_mul (n := 10) (by norm_num)]

theorem autK_length : autK.length = 1440 := by decide +kernel

theorem enc_mem_autK (x : AutA6) : enc (x : P10) ∈ autK := by
  rw [← autK_pin, ← pk_cd]
  exact List.mem_map_of_mem (cd_mem_autL x)

@[expose] def idK : ℕ := 0x9876543210

theorem enc_one : enc (1 : P10) = idK := by decide +kernel

theorem beq_enc (x y : AutA6) : Nat.beq (enc (x : P10)) (enc (y : P10)) = decide (x = y) := by
  rw [Bool.eq_iff_iff, Nat.beq_eq, decide_eq_true_iff]
  exact ⟨fun h => Subtype.ext (enc_inj (by norm_num) h), fun h => by rw [h]⟩

theorem beq_cd (x y : AutA6) : (cd x == cd y) = decide (x = y) := by
  rw [Bool.eq_iff_iff, beq_iff_eq, decide_eq_true_iff]
  exact ⟨fun h => cd_injective h, fun h => by rw [h]⟩

theorem enc_mul' (x y : AutA6) :
    mulK 10 (enc (x : P10)) (enc (y : P10)) = enc ((x * y : AutA6) : P10) :=
  (enc_mul (n := 10) (by norm_num) _ _).symm

@[expose] noncomputable def cntL (f : ℕ → Bool) (L : List ℕ) : ℕ :=
  List.rec (motive := fun _ => ℕ) 0 (fun a _ r => Bool.rec r (Nat.succ r) (f a)) L

theorem cntL_eq (f : ℕ → Bool) (L : List ℕ) : cntL f L = (L.filter f).length := by
  induction L with
  | nil => rfl
  | cons a L ih =>
    change Bool.rec (motive := fun _ => ℕ) (cntL f L) (Nat.succ (cntL f L)) (f a) = _
    rw [List.filter_cons, ih]
    cases f a <;> rfl

theorem length_filter_autL (p : List ℕ → Bool) (q : ℕ → Bool)
    (h : ∀ x : AutA6, p (cd x) = q (enc (x : P10))) :
    (Core.autL.filter p).length = cntL q autK := by
  have e : Core.autL.filter p = Core.autL.filter (q ∘ pk) := by
    refine List.filter_congr fun c hc => ?_
    obtain ⟨x, rfl⟩ := exists_of_mem_autL hc
    rw [Function.comp_apply, pk_cd, h]
  rw [cntL_eq, ← autK_pin, List.filter_map, List.length_map, e]

theorem comm_eq (x y : AutA6) : (Core.cmul (cd x) (cd y) == Core.cmul (cd y) (cd x)) =
    commLaneK 10 (enc (x : P10)) (enc (y : P10)) := by
  rw [← cd_mul, ← cd_mul, beq_cd, Bool.eq_iff_iff, decide_eq_true_iff,
    commLaneK_iff (by norm_num)]
  constructor
  · intro h
    exact congrArg Subtype.val h
  · intro h
    exact Subtype.ext h

@[expose] noncomputable def invTK (d : ℕ) : Bool := Nat.beq (mulK 10 d d) idK && !Nat.beq d idK

theorem invTK_eq (x : AutA6) : invTK (enc (x : P10)) =
    (Core.cmul (cd x) (cd x) == Core.cid && cd x != Core.cid) := by
  unfold invTK
  rw [← enc_one, enc_mul', ← cd_mul, ← cd_one]
  change (Nat.beq (enc ((x * x : AutA6) : P10)) (enc ((1 : AutA6) : P10)) &&
    !Nat.beq (enc (x : P10)) (enc ((1 : AutA6) : P10))) = (cd (x * x) == cd 1 && !(cd x == cd 1))
  rw [beq_enc, beq_enc, beq_cd, beq_cd]

theorem autL_nodup : Core.autL.Nodup := by
  have h1 : 1440 ≤ Core.autL.toFinset.card := by
    have himg : code '' (A6Models.autA6 : Set P10) ⊆ ↑Core.autL.toFinset := by
      rintro _ ⟨x, hx, rfl⟩
      simpa using code_mem_autL hx
    rw [← card_autA6]
    calc Nat.card A6Models.autA6 = Nat.card (code '' (A6Models.autA6 : Set P10)) :=
          (Nat.card_image_of_injective code_injective _).symm
      _ ≤ Nat.card ↥(↑Core.autL.toFinset : Set (List ℕ)) :=
          Nat.card_mono (Set.toFinite _) himg
      _ = Core.autL.toFinset.card := by rw [Nat.card_coe_set_eq, Set.ncard_coe_finset]
  have h2 : Core.autL.length = 1440 := by
    rw [← List.length_map (f := pk), autK_pin, autK_length]
  rw [List.card_toFinset] at h1
  have h4 := (List.dedup_sublist Core.autL).length_le
  have h3 := (List.dedup_sublist Core.autL).eq_of_length (by omega)
  rw [← h3]
  exact List.nodup_dedup _

theorem cmul_mem_autL {a b : List ℕ} (ha : a ∈ Core.autL) (hb : b ∈ Core.autL) :
    Core.cmul a b ∈ Core.autL := by
  obtain ⟨u, rfl⟩ := exists_of_mem_autL ha
  obtain ⟨v, rfl⟩ := exists_of_mem_autL hb
  rw [← cd_mul]
  exact cd_mem_autL _

theorem psl_mul_iff {W Y : P10} (R : P10) (hW : W ∈ A6Models.autA6) (hY : Y ∈ A6Models.psl29) :
    W * (Y * R) ∈ A6Models.psl29 ↔ W * R ∈ A6Models.psl29 := by
  have hn := psl29_normal _ hW _ hY
  constructor
  · intro h
    have e : W * R = (W * Y * W⁻¹)⁻¹ * (W * (Y * R)) := by group
    rw [e]
    exact A6Models.psl29.mul_mem (A6Models.psl29.inv_mem hn) h
  · intro h
    have e : W * (Y * R) = (W * Y * W⁻¹) * (W * R) := by group
    rw [e]
    exact A6Models.psl29.mul_mem hn h

theorem exists_rep {c : List ℕ} (hc : c ∈ Core.autL) : ∃ r ∈ Core.autReps,
    Core.pslLit.contains c = Core.pslLit.contains r ∧
    ∀ w ∈ Core.autL, Core.pslLit.contains (Core.cmul w c) =
      Core.pslLit.contains (Core.cmul w r) := by
  unfold Core.autL at hc
  rw [List.mem_flatMap] at hc
  obtain ⟨y, hy, hc⟩ := hc
  rw [List.mem_map] at hc
  obtain ⟨r, hr, rfl⟩ := hc
  obtain ⟨Y, hY, rfl⟩ := exists_psl29_of_code hy
  have hr' := hr
  rw [← autRepsP_code, List.mem_map] at hr'
  obtain ⟨R, -, rfl⟩ := hr'
  refine ⟨code R, hr, ?_, fun w hw => ?_⟩
  · have h := psl_mul_iff R (one_mem A6Models.autA6) hY
    rw [one_mul, one_mul] at h
    rw [← code_mul, Bool.eq_iff_iff, List.contains_iff_mem, List.contains_iff_mem,
      ← mem_psl29_iff, ← mem_psl29_iff]
    exact h
  · obtain ⟨W, rfl⟩ := exists_of_mem_autL hw
    unfold cd
    simp only [← code_mul]
    rw [Bool.eq_iff_iff, List.contains_iff_mem, List.contains_iff_mem, ← mem_psl29_iff,
      ← mem_psl29_iff]
    exact psl_mul_iff R W.2 hY

theorem enc_mem_pslK {Y : P10} (hY : Y ∈ A6Models.psl29) : enc Y ∈ pslK := by
  rw [← beq_iff_eq.1 pslK_pin, ← pk_code]
  exact List.mem_map_of_mem ((mem_psl29_iff Y).1 hY)

theorem length_filter_pslL (p : List ℕ → Bool) (q : ℕ → Bool)
    (h : ∀ Y : P10, Y ∈ A6Models.psl29 → p (code Y) = q (enc Y)) :
    (Core.pslLit.filter p).length = cntL q pslK := by
  have e : Core.pslLit.filter p = Core.pslLit.filter (q ∘ pk) := by
    refine List.filter_congr fun c hc => ?_
    obtain ⟨Y, hY, rfl⟩ := exists_psl29_of_code hc
    rw [Function.comp_apply, pk_code, h Y hY]
  rw [cntL_eq, ← beq_iff_eq.1 pslK_pin, List.filter_map, List.length_map, e]

theorem contains_psl_eq (x : AutA6) :
    Core.pslLit.contains (cd x) = memK (enc (x : P10)) pslK := by
  rw [Bool.eq_iff_iff, List.contains_iff_mem, memK_iff]
  constructor
  · intro h
    rw [← beq_iff_eq.1 pslK_pin, ← pk_cd]
    exact List.mem_map_of_mem h
  · intro h
    rw [← beq_iff_eq.1 pslK_pin, List.mem_map] at h
    obtain ⟨c, hc, he⟩ := h
    obtain ⟨Y, -, rfl⟩ := exists_psl29_of_code hc
    rw [pk_code] at he
    have hY := enc_inj (by norm_num) he
    unfold cd
    rw [← hY]
    exact hc

theorem beqE (σ τ : P10) : Nat.beq (enc σ) (enc τ) = decide (σ = τ) := by
  rw [Bool.eq_iff_iff, Nat.beq_eq, decide_eq_true_iff]
  exact ⟨fun h => enc_inj (by norm_num) h, fun h => by rw [h]⟩

theorem beqC (σ τ : P10) : (code σ == code τ) = decide (σ = τ) := by
  rw [Bool.eq_iff_iff, beq_iff_eq, decide_eq_true_iff]
  exact ⟨fun h => code_injective h, fun h => by rw [h]⟩

@[expose] noncomputable def ord5T (d : ℕ) : Bool :=
  Nat.beq (mulK 10 (mulK 10 (mulK 10 d d) (mulK 10 d d)) d) idK && !Nat.beq d idK

theorem ord5T_eq (Y : P10) :
    ord5T (enc Y) = (Core.cpow (code Y) 5 == Core.cid && code Y != Core.cid) := by
  unfold ord5T
  rw [← enc_one, ← enc_mul (n := 10) (by norm_num), ← enc_mul (n := 10) (by norm_num), ← enc_mul (n := 10) (by norm_num),
    ← code_pow, ← code_one]
  change (Nat.beq _ _ && !Nat.beq _ _) = (code (Y ^ 5) == code 1 && !(code Y == code 1))
  rw [beqE, beqE, beqC, beqC]
  have e : Y * Y * (Y * Y) * Y = Y ^ 5 := by
    rw [pow_succ, pow_succ, pow_succ, pow_succ, pow_one]
    simp only [mul_assoc]
  rw [e]

@[expose] noncomputable def ord3T (d : ℕ) : Bool :=
  Nat.beq (mulK 10 d (mulK 10 d d)) idK && !Nat.beq d idK

theorem ord3T_eq (Y : P10) : ord3T (enc Y) =
    (Core.cmul (code Y) (Core.cmul (code Y) (code Y)) == Core.cid && code Y != Core.cid) := by
  unfold ord3T
  rw [← enc_one, ← enc_mul (n := 10) (by norm_num), ← enc_mul (n := 10) (by norm_num), ← code_mul, ← code_mul,
    ← code_one]
  change (Nat.beq _ _ && !Nat.beq _ _) = (code (Y * (Y * Y)) == code 1 && !(code Y == code 1))
  rw [beqE, beqE, beqC, beqC]

theorem comm_eqP (σ τ : P10) : (Core.cmul (code σ) (code τ) == Core.cmul (code τ) (code σ)) =
    commLaneK 10 (enc σ) (enc τ) := by
  rw [← code_mul, ← code_mul, beqC, Bool.eq_iff_iff, decide_eq_true_iff,
    commLaneK_iff (by norm_num)]

