theorem invK_all : allK (fun d => !invTK d || memK d invK) autK = true := by decide +kernel

theorem enc_mem_invK {w : AutA6} (h : invTK (enc (w : P10)) = true) : enc (w : P10) ∈ invK := by
  have h1 := allK_iff.1 invK_all _ (enc_mem_autK w)
  simp only [h, Bool.not_true, Bool.false_or] at h1
  exact memK_iff.1 h1

theorem cent48K : allK (fun a => Nat.ble (cntL (commLaneK 10 a) autK) 48) invK = true := by
  decide +kernel

theorem reps_cover (a b : List ℕ) (ha : a = [0, 1, 2, 6, 7, 8, 3, 4, 5, 9])
    (hb : b = [9, 7, 5, 8, 6, 2, 4, 1, 3, 0]) : Core.autReps.all (fun c =>
      Core.pslLit.contains c || Core.pslLit.contains (Core.cmul a c) ||
        Core.pslLit.contains (Core.cmul b c) ||
        Core.pslLit.contains (Core.cmul (Core.cmul a b) c)) = true := by
  subst ha hb
  decide +kernel

