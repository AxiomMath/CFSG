@[expose] def tab (k : ℕ) : Array ℕ := hexTable3 100 (100 * k) hexData

@[expose] def u0 : Array ℕ := tab 0

@[expose] def f0 : Array ℕ := tab 1

@[expose] def cuGens : Array (Array ℕ) := #[tab 2, tab 3, tab 4]

@[expose] def cfGens : Array (Array ℕ) := #[tab 5, tab 6, tab 7]

@[expose] def aGens : Array (Array ℕ) := #[tab 8, tab 9]

@[expose] def sGens : Array (Array ℕ) := #[tab 10, tab 11]

@[expose] def a3 : Array ℕ := tab 12

@[expose] def conjs : Array (Array ℕ) := Array.ofFn (n := 8) fun k => tab (13 + k.1)

@[expose] def pGens : Array (Array ℕ) := #[hs100Arr 0, hs100Arr 1]

@[expose] def keys : List ℕ := [0, 1, 2, 3, 4]

@[expose] def pw (x : Array ℕ) : ℕ → Array ℕ
  | 0 => idA 100
  | k + 1 => compA 100 x (pw x k)

@[expose] def uOrbit : ArrCert :=
  arrBfs (fun k a => conjA 100 pGens[k]! a) pGens.size (keyA 100 keys) u0 20000

@[expose] def rels : List (ℕ × ℕ × ℕ) :=
  [(0, 1, 2), (0, 2, 3), (1, 0, 3), (1, 2, 1), (2, 0, 2), (2, 1, 4), (3, 4, 2), (4, 3, 3)]

@[expose] def cuCert : ArrCert := enumBfs 100 cuGens keys 3000

@[expose] def cfCert : ArrCert := enumBfs 100 cfGens keys 400

@[expose] def aCert : ArrCert := enumBfs 100 aGens keys 100

@[expose] def sCert : ArrCert := enumBfs 100 sGens keys 20

@[noinline, expose] def centralizerOK : Bool :=
  allLt pGens.size (fun k => validA 100 pGens[k]!) && validA 100 u0 && s5InP u0 && eqA 100 (compA 100 u0 u0) (idA 100) && !eqA 100 u0 (idA 100) &&
    arrCertOK (fun k a => conjA 100 pGens[k]! a) pGens.size (validA 100) (keyA 100 keys) u0
      uOrbit && uOrbit.pts.size == 15400 &&
    enumOK 100 cuGens keys cuCert && cuCert.pts.size == 2880 &&
    allLt cuGens.size (fun k => commA 100 cuGens[k]! u0 && s5InP cuGens[k]!) &&
    validA 100 f0 && s5InP f0 && eqA 100 (pw f0 5) (idA 100) && !eqA 100 f0 (idA 100) &&
    commA 100 f0 u0 &&
    (cuCert.pts.toList.all fun x => !eqA 100 (pw x 5) (idA 100) || eqA 100 x (idA 100) ||
      cuCert.pts.toList.any fun y => eqA 100 (compA 100 y x) (compA 100 f0 y))

@[expose] def aCommCount : ℕ :=
  (Finset.univ.filter fun i : Fin aCert.pts.size => commA 100 u0 aCert.pts[i.1]! = true).card

@[noinline, expose] def fiveCentralizerOK : Bool :=
  relsOK 100 hs100BaseArr f0 rels &&
    enumOK 100 cfGens keys cfCert && cfCert.pts.size == 300 &&
    allLt cfGens.size (fun k => commA 100 cfGens[k]! f0 && s5InP cfGens[k]!) &&
    ptailOK 100 s5Levels hs100BaseArr f0 (pow5A 100 f0) rels cfCert.pts.toList
      hs100BaseArr.size 0 (idA 100) &&
    enumOK 100 aGens keys aCert && aCert.pts.size == 60 &&
    allLt aGens.size (fun k => commA 100 aGens[k]! f0 && s5InP aGens[k]!) &&
    conjSimpleOK 100 keys aCert && aCert.pts.toList.any (eqA 100 u0) &&
    (cfCert.pts.toList.all fun x => (List.range 5).any fun e =>
      aCert.pts.toList.any fun a => eqA 100 x (compA 100 (pw f0 e) a)) &&
    aCommCount == 4

@[noinline, expose] def sylowThreeOK : Bool :=
  enumOK 100 sGens keys sCert && sCert.pts.size == 9 &&
    allLt sGens.size (fun k => s5InP sGens[k]!) &&
    validA 100 a3 && eqA 100 (pw a3 3) (idA 100) && !eqA 100 a3 (idA 100) &&
    sCert.pts.toList.any (eqA 100 a3) &&
    (sCert.pts.toList.all fun s => eqA 100 s (idA 100) ||
      conjs.toList.any fun c => validA 100 c && s5InP c && eqA 100 (conjA 100 c a3) s)

@[noinline, expose] def hsFiveOK : Bool := centralizerOK && fiveCentralizerOK && sylowThreeOK

end CFSG.EvenSporadicStandard.HSStd.Zassenhaus.HSFive
