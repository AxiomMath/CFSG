@[expose] def zasTGens : Array (Array ℕ) := zasGens zasTHex 3

@[expose] def zasTKeys : List ℕ := [96, 44]

@[expose] def zasTCert : ArrCert := enumBfs 100 zasTGens zasTKeys (2 ^ 20)

@[noinline, expose] def zasSylowOK : Bool :=
  enumOK 100 zasTGens zasTKeys zasTCert && zasTCert.pts.size == 512 &&
    allLt zasTGens.size (fun k => s5InP zasTGens[k]!) &&
    validA 100 s5Z && s5InP s5Z && !eqA 100 s5Z (idA 100) &&
    eqA 100 (compA 100 s5Z s5Z) (idA 100) &&
    (zasTCert.pts.toList.all fun x => eqA 100 (compA 100 s5Z x) (compA 100 x s5Z)) &&
    zasTCert.pts.toList.any (eqA 100 s5Z)

@[expose] def zasMem (c : ArrCert) (w : Array ℕ) : Bool := c.pts.toList.any (eqA 100 w)

@[expose] def zasConj (a x : Array ℕ) : Array ℕ :=
  compA 100 (compA 100 a x) (invCand 100 a)

@[expose] def zasConjInv (a x : Array ℕ) : Array ℕ :=
  compA 100 (compA 100 (invCand 100 a) x) a

@[expose] def zasEGens (j : ℕ) : Array (Array ℕ) :=
  Array.ofFn (n := 4) fun k => hexTable3 100 (100 * (4 * j + k.1)) zasEHex

@[expose] def zasEKeys : List ℕ := List.range 100

@[expose] def zasECert (j : ℕ) : ArrCert := enumBfs 100 (zasEGens j) zasEKeys 1000

@[expose] def zasECerts : Array ArrCert := Array.ofFn (n := 8) fun j => zasECert j.1

@[expose] def zasEC (j : ℕ) : ArrCert := (zasECerts[j]?).getD ⟨#[], #[], #[], #[]⟩

@[expose] def zasE0Gens : Array (Array ℕ) := zasEGens 0

@[expose] def zasE0Cert : ArrCert := zasEC 0

@[expose] def zasNGens : Array (Array ℕ) := zasGens zasNHex 2

@[expose] def zasNKeys : List ℕ := [2, 12, 11, 3]

@[expose] def zasNCert : ArrCert := enumBfs 100 zasNGens zasNKeys (2 ^ 20)

@[expose] def zasFixVec : Array ℕ :=
  Array.ofFn (n := 100) fun i => if zasE0Cert.pts.toList.all (fun x => x[i.1]! == i.1) then 1 else 0

@[expose] def zasOmVec : Array ℕ :=
  Array.ofFn (n := 100) fun i => if i.1 ∈ [8, 51, 53, 92, 70, 97] then 1 else 0

@[expose] def zasSetKey (a : Array ℕ) : ℕ := keyA 100 (List.range 100) a

@[expose] def zasSetValid (a : Array ℕ) : Bool := a.size == 100 && allLt 100 fun i => decide (a[i]! ≤ 1)

@[expose] def zasGInv : Array (Array ℕ) := Array.ofFn (n := 2) fun k => invCand 100 (hs100Arr k.1)

@[expose] def zasSetAct (k : ℕ) (a : Array ℕ) : Array ℕ :=
  let r := zasGInv[k]!
  Array.ofFn (n := 100) fun j => a[r[j.1]!]!

@[expose] def zasFCert : ArrCert := arrBfs zasSetAct 2 zasSetKey zasFixVec (2 ^ 14)

@[expose] def zasFixesOm (x : Array ℕ) : Bool := allLt 100 fun i => zasOmVec[i]! != 1 || x[i]! == i

@[noinline, expose] def zasSpecialOK : Bool :=
  validA 100 s5Z && enumOK 100 zasE0Gens zasEKeys zasE0Cert && zasE0Cert.pts.size == 16 &&
    allLt zasE0Gens.size (fun k => s5InP zasE0Gens[k]!) &&
    (zasE0Cert.pts.toList.all fun x => eqA 100 (compA 100 x x) (idA 100)) &&
    (zasE0Cert.pts.toList.all fun x => zasE0Cert.pts.toList.all fun y =>
      eqA 100 (compA 100 x y) (compA 100 y x)) &&
    zasMem zasE0Cert s5Z &&
    enumOK 100 zasNGens zasNKeys zasNCert && zasNCert.pts.size == 11520 &&
    allLt zasNGens.size (fun k => s5InP zasNGens[k]!) &&
    allLt zasNGens.size (fun k => zasE0Cert.pts.toList.all fun x =>
      zasMem zasE0Cert (zasConj zasNGens[k]! x) &&
        zasMem zasE0Cert (zasConjInv zasNGens[k]! x)) &&
    (zasE0Cert.pts.toList.all fun e =>
      eqA 100 e (idA 100) || zasNCert.pts.toList.any fun a => eqA 100 (zasConj a s5Z) e) &&
    allLt 2 (fun k => validA 100 (hs100Arr k)) &&
    arrCertOK zasSetAct 2 zasSetValid zasSetKey zasFixVec zasFCert && zasFCert.pts.size == 3850 &&
    (Finset.univ.filter fun i : Fin 100 => zasOmVec[i.1]! = 1).card == 6 &&
    allLt zasNGens.size (fun k => allLt 100 fun i => zasOmVec[(zasNGens[k]!)[i]!]! == zasOmVec[i]!) &&
    (zasE0Cert.pts.toList.all zasFixesOm) &&
    (zasNCert.pts.toList.all fun x => !zasFixesOm x || zasMem zasE0Cert x)

@[expose] def zasFp (a : Array ℕ) : ℕ := (Finset.univ.filter fun i : Fin 100 => a[i.1]! = i.1).card

@[expose] def zasIsInv (x : Array ℕ) : Bool :=
  eqA 100 (compA 100 x x) (idA 100) && !eqA 100 x (idA 100)

@[expose] def zasInvs : List (Array ℕ) := zasTCert.pts.toList.filter zasIsInv

@[expose] def zasComm (x y : Array ℕ) : Bool := eqA 100 (compA 100 x y) (compA 100 y x)

@[expose] def zasMemL (l : List (Array ℕ)) (w : Array ℕ) : Bool := l.any (eqA 100 w)

@[expose] def zasK2 (a : Array ℕ) : List (Array ℕ) := [idA 100, s5Z, a, compA 100 s5Z a]

@[expose] def zasK3 (a b : Array ℕ) : List (Array ℕ) :=
  zasK2 a ++ (zasK2 a).map (compA 100 b)

@[expose] def zasInSome (a b c : Array ℕ) : Bool :=
  (List.range 8).any fun j => zasMem (zasEC j) a && zasMem (zasEC j) b && zasMem (zasEC j) c

@[expose] def zasSpecIdx : ℕ × ℕ := (0, 5)

@[noinline, expose] def zasUniqOK : Bool :=
  validA 100 s5Z && !eqA 100 s5Z (idA 100) && enumOK 100 zasTGens zasTKeys zasTCert && zasTCert.pts.size == 512 &&
    ((List.range 8).all fun j =>
      enumOK 100 (zasEGens j) zasEKeys (zasEC j) && (zasEC j).pts.size == 16 &&
        zasMem (zasEC j) s5Z) &&
    (zasInvs.all fun a => zasMemL [idA 100, s5Z] a || zasInvs.all fun b =>
      !zasComm a b || zasMemL (zasK2 a) b ||
        (let k3 := zasK3 a b
         zasInvs.all fun c => !zasComm a c || !zasComm b c || zasMemL k3 c || zasInSome a b c)) &&
    ((List.range 8).all fun j => j == zasSpecIdx.1 || j == zasSpecIdx.2 ||
      (zasEC j).pts.toList.any fun w => !eqA 100 w (idA 100) && zasFp w != zasFp s5Z) &&
    (zasTCert.pts.toList.any fun t => (List.range 4).all fun k =>
      zasMem (zasEC zasSpecIdx.2) (zasConj t (zasEGens zasSpecIdx.1)[k]!))

end CFSG.EvenSporadicStandard.HSStd.Zassenhaus
