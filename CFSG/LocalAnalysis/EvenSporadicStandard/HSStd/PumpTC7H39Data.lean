@[expose] def x1 : Array ℕ := tW x1Word

@[expose] def xCert : ArrCert :=
  arrBfs (fun k a => conjA 182 gsT[k]! a) 2 (keyA 182 tKeys) x1 8000

@[expose] def xOK (xc : ArrCert) : Bool :=
  lettersOK tS.size x1Word && allLt 2 (fun k => validA 182 gsT[k]!) &&
    arrCertOKL (fun k a => conjA 182 gsT[k]! a) 2 (validA 182) (keyA 182 tKeys) x1 xc &&
    uCert.pts.toList.all fun a => fixCount a != 20 || xc.pts.toList.any (eqA 182 a)

@[expose] def groupOK (ws : List (List ℤ)) (k : ℕ) : Bool :=
  ws.all (lettersOK tS.size) &&
    enumOKL 182 (ws.map tW).toArray tKeys (enumBfs 182 (ws.map tW).toArray tKeys (k + 1)) &&
    (enumBfs 182 (ws.map tW).toArray tKeys (k + 1)).pts.size == k

@[expose] def exclOK (r : Array ℕ) (ws : List (List ℤ)) (k : ℕ) : Bool :=
  groupOK ws k && (ws.map tW).all (fun g => eqA 182 (compA 182 g r) (compA 182 r g)) &&
    !decide (k ∣ 2880)

@[expose] def survOK (xc : ArrCert) (r : Array ℕ) : Bool :=
  xc.pts.toList.all fun x => !eqA 182 (compA 182 x r) (compA 182 r x)

