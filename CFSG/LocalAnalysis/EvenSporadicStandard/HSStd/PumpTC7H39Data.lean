@[expose] def s2Gens : Array (Array ℕ) := (s2Words.map tW).toArray

@[expose] def s2Cert : ArrCert := enumBfs 182 s2Gens tKeys 200

@[expose] def s2OK (sc : ArrCert) : Bool :=
  s2Words.all (lettersOK tS.size) && enumOKL 182 s2Gens tKeys sc && sc.pts.size == 128 &&
    sc.pts.toList.all fun a =>
      !eqA 182 (compA 182 a a) (idA 182) || eqA 182 a (idA 182) || fixCount a == 22

@[expose] def gsT : Array (Array ℕ) := #[qA, qB]

