namespace CFSG.EvenSporadicStandard.Induction

open Subgroup CFSG.Blueprint.NativeSporadic CFSG.EvenSporadicStandard.Solomon78

@[expose] def ONOuterFixedPerfect : Prop :=
  ∀ (Y : Type) [Group Y], IsSporadic Y .ONan → ∀ ν : MulAut Y, ν * ν = 1 →
    (∀ y : Y, ν ≠ MulAut.conj y) → ExcPerfect 11 Y ν

theorem on_simple_data {Y : Type} [Group Y] (h : IsSporadic Y .ONan) :
    Finite Y ∧ IsSimpleGroup Y ∧ ∃ a b : Y, a * b ≠ b * a := by
  obtain ⟨hfin, hnt, hsimple⟩ := CFSG.Sporadic.ON.fam_on_simplicity
  obtain ⟨e⟩ := h
  have e' : Y ≃* CFSG.Blueprint.NativeSporadic.ON := e
  have hY : Finite Y := Finite.of_equiv _ e'.symm.toEquiv
  have hs : IsSimpleGroup Y := @MulEquiv.isSimpleGroup _ _ _ _ hsimple e'
  have := hs.toNontrivial
  exact ⟨hY, hs, exists_noncommute_of_center_eq_bot (center_eq_bot_of_isSporadic_on ⟨e⟩)⟩

theorem on_outTwo {Y : Type} [Group Y] (h : IsSporadic Y .ONan) : OutTwo Y := by
  obtain ⟨e⟩ := on_equiv_Pv h
  exact OutTwo.of_mulEquiv e.symm
    (outTwo_of_card_outer_dvd_two CFSG.Sporadic.SteinbergBI.card_outer_Pv_dvd_two)

theorem on_not_dvd_card_centralizer {Y : Type} [Group Y] (h : IsSporadic Y .ONan) {a : Y}
    (ha : orderOf a = 2) : ¬ 11 ∣ Nat.card ↥(centralizer ({a} : Set Y)) := by
  obtain ⟨e⟩ := on_equiv_Pv h
  rw [card_centralizer_of_mulEquiv e a,
    pv_card_centralizer _ (by rw [MulEquiv.orderOf_eq]; exact ha)]
  norm_num

theorem on_autCenterCondExc_perfect (hF : ONOuterFixedPerfect) {Y : Type} [Group Y]
    (h : IsSporadic Y .ONan) : AutCenterCondExc Y (ExcPerfect 11 Y) := by
  intro ν σ hν hσ hνσ hfix
  by_cases hinn : ∃ a : Y, ν = MulAut.conj a
  · obtain ⟨a, rfl⟩ := hinn
    by_cases ha1 : a = 1
    · left
      subst ha1
      refine MulEquiv.ext fun y => ?_
      exact hfix y (by simp)
    · have hZ := center_eq_bot_of_isSporadic_on h
      have ha2 : a * a = 1 := by
        have hmem : a * a ∈ center Y := by
          rw [mem_center_iff]
          intro g
          have := congrArg (fun φ : MulAut Y => φ g) hν
          simp only [MulAut.mul_apply, MulAut.conj_apply, MulAut.one_apply] at this
          calc g * (a * a) = (a * (a * g * a⁻¹) * a⁻¹) * (a * a) := by rw [this]
            _ = (a * a) * g := by group
        rw [hZ, mem_bot] at hmem
        exact hmem
      have ho : orderOf a = 2 := orderOf_eq_prime (by rw [pow_two]; exact ha2) ha1
      rcases on_pointwise h σ a ho (fun y hy => hfix y (by
          rw [MulAut.conj_apply]
          calc a * y * a⁻¹ = y * a * a⁻¹ := by rw [← hy]
            _ = y := by group)) with h1 | h1
      · exact Or.inl h1
      · exact Or.inr (Or.inl h1)
  · exact Or.inr (Or.inr (hF Y h ν hν fun y hy => hinn ⟨y, hy⟩))

theorem on_autOddCoreTrivial {Y : Type} [Group Y] (h : IsSporadic Y .ONan) :
    AutOddCoreTrivial Y := by
  obtain ⟨hfin, hs, hna⟩ := on_simple_data h
  obtain ⟨e⟩ := h
  exact autOddCoreTrivial_of_sporadicOddCoreFree CFSG.Sporadic.ONOddCore.sporadicOddCoreFree_ONan
    hna e

theorem on_fusionRowData (hF : ONOuterFixedPerfect) : FusionRowData .ONan (ExcPerfect 11) where
  autCenter _ _ h := on_autCenterCondExc_perfect hF h
  uMoves _ _ h := on_umovesCond h
  oddCore _ _ h := on_autOddCoreTrivial h

end CFSG.EvenSporadicStandard.Induction
