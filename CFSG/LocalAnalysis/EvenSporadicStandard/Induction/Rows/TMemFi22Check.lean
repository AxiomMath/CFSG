    [-1, -1, -1, -2, -1, -2, -1, -1, -2, -1, -1, -2, 1, 2, 2, 2, 2, 1, 1, 2, 2, 1, 2, 1, 2, 1],
    [-1, -1, -1, -2, -1, -1, -1, -2, -1, 2, 1, 2, 1, 1, 1, 2, 2, 2, 1, 1]]

@[expose] def fcR1 : Nat := 0

@[expose] def fcR2 : Nat := 11

@[expose] def fcR3 : Nat := 1

@[expose] def fcGen2 : Array (Array Nat) := #[fi22ChainGen 0, fi22ChainGen 1]

@[expose] def fcGen2i : Array (Array Nat) :=
  #[invCand 3510 (fi22ChainGen 0), invCand 3510 (fi22ChainGen 1)]

@[expose, irreducible] def fcC1 : Array Nat := wordA 3510 fcGen2 fcGen2i fcWord1

@[expose, irreducible] def fcC2 : Array Nat := wordA 3510 fcGen2 fcGen2i fcWord2

@[expose] def fcGenC : Array (Array Nat) := #[fcC1, fcC2]

@[expose] def fcGenCi : Array (Array Nat) := #[invCand 3510 fcC1, invCand 3510 fcC2]

@[expose] def fcT2 : Array Nat := fi22ExtArr 23

@[expose] def fcPar : Array Nat := hexTable3 3510 0 fcParHex

@[expose] def fcLab : Array Nat := hexTable3 3510 0 fcLabHex

@[expose] def fcDep : Array Nat := hexTable3 3510 0 fcDepHex

@[expose, irreducible] def fcTabs (ws : List (List Int)) : List (Array Nat) :=
  ws.map (wordA 3510 fcGenC fcGenCi)

@[expose] def fcBasicCheck : Bool :=
  isInvA 3510 (fi22ChainGen 0) (invCand 3510 (fi22ChainGen 0)) &&
  isInvA 3510 (fi22ChainGen 1) (invCand 3510 (fi22ChainGen 1)) &&
  isInvA 3510 fcT2 (invCand 3510 fcT2) &&
  lettersOK 2 fcWord1 && lettersOK 2 fcWord2 &&
  fcCons1.all (lettersOK 2) && fcCons2.all (lettersOK 2) && fcCons3.all (lettersOK 2) &&
  isInvA 3510 fcC1 (invCand 3510 fcC1) && isInvA 3510 fcC2 (invCand 3510 fcC2) &&
  eqA 3510 (compA 3510 fcC1 fcT2) (compA 3510 fcT2 fcC1) &&
  eqA 3510 (compA 3510 fcC2 fcT2) (compA 3510 fcT2 fcC2) &&
  decide (fcR1 < 3510) && decide (fcR2 < 3510) && decide (fcR3 < 3510) &&
  decide (fcR1 ≠ fcR2) && decide (fcR1 ≠ fcR3) &&
  fcT2[fcR1]! == fcR1 && fcT2[fcR2]! == fcR2 && fcT2[fcR3]! == fcT2R3 &&
  decide (fcT2R3 < 3510) && decide (fcT2R3 ≠ fcR3)

@[expose] def fcTreeCheck : Bool :=
  allLt 3510 fun p =>
    (fcPar[p]! == p && fcDep[p]! == 0 && (p == fcR1 || p == fcR2 || p == fcR3)) ||
      (decide (fcPar[p]! < 3510) && fcDep[p]! == fcDep[fcPar[p]!]! + 1 &&
        ((fcLab[p]! == 1 && fcC1[fcPar[p]!]! == p) || (fcLab[p]! == 2 && fcC2[fcPar[p]!]! == p)))

@[expose] def fcFixCover (ts : List (Array Nat)) (cand : List Nat) : Bool :=
  allLt 3510 fun q => !(ts.all fun t => t[q]! == q) || cand.contains q

@[expose] def fcConsCheck : Bool :=
  (fcTabs fcCons1).all (fun t => t[fcR1]! == fcR1) && fcFixCover (fcTabs fcCons1) [fcR1] &&
  (fcTabs fcCons2).all (fun t => t[fcR2]! == fcR2) && fcFixCover (fcTabs fcCons2) [fcR1, fcR2] &&
  (fcTabs fcCons3).all (fun t => t[fcR3]! == fcR3) &&
    fcFixCover (fcTabs fcCons3) [fcR1, fcR3, fcT2R3]

@[expose] def tmFi22Check : Bool := fcBasicCheck && fcTreeCheck && fcConsCheck

