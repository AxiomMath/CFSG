@[expose] def fcReps : List Nat := [0, 11, 1]

@[expose] def fcT2R3 : Nat := 1565

@[expose] def fcCons1 : List (List Int) :=
  [
    [1],
    [2]]

@[expose] def fcCons2 : List (List Int) :=
  [
    [-1, -1, -1, -1, -1, -2, -2, 1, 1, 1, 2, 1, 2, 1, 1, 1, 2],
    [-1, -2, -1, -1, -2, -2, -2, -1, 2, 2, 1, 1, 1, 1, 2, 1, 2, 2, 2]]

@[expose] def fcCons3 : List (List Int) :=
