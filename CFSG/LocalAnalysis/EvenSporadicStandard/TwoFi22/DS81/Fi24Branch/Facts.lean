namespace CFSG.EvenSporadicStandard.TwoFi22.DS81.Fi24Branch

open Subgroup CFSG.Blueprint.NativeSporadic

structure Std (G : Type) [Group G] [Finite G] (L E : Subgroup G) (t : G) : Prop where
  std : StdHyp G L
  card_center : Nat.card (center L) = 2
  quo : IsSporadic (L ⧸ center L) .Fi22
  center_eq : (center L).map L.subtype = zpowers t
  ne : centralizer ({t} : Set G) ≠ L
  E_le : E ≤ L
  facts : Facts G t L E
  cent : centralizer (L : Set G) = zpowers t
  m24 : M24Out G E t

@[expose] def IsZ {G : Type} [Group G] (E : Subgroup G) (t z : G) : Prop :=
  z ∈ E ∧ z ≠ 1 ∧ z ∉ normClass E t ∧ t * z ∈ normClass E t

@[expose] def InvUnder {G : Type} [Group G] (M U : Subgroup G) : Prop :=
  ∀ n ∈ M, ∀ u ∈ U, n * u * n⁻¹ ∈ U

@[expose] def Phi2 {G : Type} [Group G] (R : Subgroup G) : Subgroup G :=
  ⁅R, R⁆ ⊔ closure {x | ∃ y ∈ R, x = y ^ 2}

variable {G : Type} [Group G]

@[expose] def HomVanish (E : Subgroup G) (z : G) (A : Subgroup G) : Prop :=
  ∀ U : Subgroup G, U ≤ E → InvUnder (CNz E z) U → Nat.card ↥U = 2 ^ 7 →
    ∀ φ : G → G, (∀ p ∈ Pg E z, φ p ∈ E) → (∀ e ∈ E, φ e ∈ U) →
      (∀ p ∈ Pg E z, ∀ q ∈ Pg E z, (φ (p * q))⁻¹ * (φ p * φ q) ∈ U) →
      (∀ a ∈ A, ∀ p ∈ Pg E z, (φ (a * p * a⁻¹))⁻¹ * (a * φ p * a⁻¹) ∈ U) →
      ∀ p ∈ Pg E z, φ p ∈ U

structure CocodeData (E : Subgroup G) (t z : G) : Prop where
  card_Ctz : Nat.card ↥(CNz E z ⊓ centralizer ({t} : Set G)) = 2 ^ 19 * 3 * 5
  card_NV : Nat.card ↥(Nrm E ⊓ Jg t z) = 2 ^ 20 * 3 * 5
  swap : ∃ y ∈ Nrm E ⊓ Jg t z, y * t * y⁻¹ = t * z
  card_P : Nat.card ↥(Pg E z) = 2 ^ 17
  O2_NV : TwoFi22.O2In (Nrm E ⊓ Jg t z) = Pg E z
  P_comm : ∀ a ∈ Pg E z, ∀ b ∈ Pg E z, a * b * a⁻¹ * b⁻¹ ∈ E
  P_sq : ∀ a ∈ Pg E z, a ^ 2 ∈ E
  lattice : ∀ U : Subgroup G, U ≤ E → InvUnder (CNz E z) U →
    U = ⊥ ∨ U = zpowers z ∨ Nat.card ↥U = 2 ^ 7 ∨ U = E
  P_irred : ∀ S : Subgroup G, E ≤ S → S ≤ Pg E z → InvUnder (CNz E z) S → S = E ∨ S = Pg E z
  comm_ne : ⁅E, Pg E z⁆ ≠ zpowers z
  card_O23 : Nat.card ↥(TwoFi22.O23In (CNz E z)) = 3 * 2 ^ 17
  r_fpf : ∀ r ∈ TwoFi22.O23In (CNz E z), orderOf r = 3 → ∀ p ∈ Pg E z,
    r * p * r⁻¹ * p⁻¹ ∈ E → p ∈ E
  r_E : ∀ r ∈ TwoFi22.O23In (CNz E z), orderOf r = 3 → ∀ U : Subgroup G, U ≤ E →
    InvUnder (CNz E z) U → Nat.card ↥U = 2 ^ 7 → ∀ e ∈ E, r * e * r⁻¹ * e⁻¹ ∈ U
  exists_A : ∃ A : Subgroup G, A ≤ Nrm E ⊓ Jg t z ∧ E ≤ A ∧
    (∀ a ∈ A, ∀ r ∈ TwoFi22.O23In (CNz E z), orderOf r = 3 → a * r * a⁻¹ * r⁻¹ ∈ Pg E z) ∧
    HomVanish E z A
  exists_sextet : ∀ U : Subgroup G, U ≤ E → InvUnder (CNz E z) U → Nat.card ↥U = 2 ^ 7 →
    ∃ z' ∈ U, z' ≠ z ∧ z' ∈ normClass E z
  exists_perfect : ∃ Y : Subgroup G, Y ≤ CNz E z ∧ ⁅Y, Y⁆ = Y ∧
    Nat.card ↥Y = 2 ^ 20 * 3 ^ 3 * 5
  normal_card : ∀ M : Subgroup G, M ≤ CNz E z → Pg E z ≤ M → InvUnder (CNz E z) M →
    Nat.card ↥M = Nat.card ↥(Pg E z) ∨ Nat.card ↥M = 3 * Nat.card ↥(Pg E z) ∨
    Nat.card ↥M = 1080 * Nat.card ↥(Pg E z) ∨ Nat.card ↥M = 2160 * Nat.card ↥(Pg E z)

structure CocodeFacts : Prop where
  noOffender : ∀ (G : Type) [Group G] [Finite G] (E : Subgroup G) (t : G), M24Out G E t →
    ∀ A : Subgroup G, A ≤ Nrm E → (∀ a ∈ A, a ^ 2 = 1) → (∀ a ∈ A, ∀ b ∈ A, a * b = b * a) →
      ¬ A ≤ E → (A ⊓ E).relIndex A * Nat.card ↥(E ⊓ centralizer (A : Set G)) ≤ 2 ^ 10
  exists_z : ∀ (G : Type) [Group G] [Finite G] (E : Subgroup G) (t : G), M24Out G E t →
    ∃ z, IsZ E t z
  data : ∀ (G : Type) [Group G] [Finite G] (E : Subgroup G) (t z : G), M24Out G E t →
    IsZ E t z → CocodeData E t z

@[expose] def IsU42Two (A : Type) [Group A] : Prop :=
  ∃ (U : Type) (_ : Group U), CFSG.Open.StatedClassicalModel U .PSU 4 2 1 ∧
    Nonempty (A ≃* MulAut U)

structure KData (t z : G) : Prop where
  card_K : Nat.card ↥(Kg t z) = 2 ^ 19 * 3 ^ 4 * 5
  card_OK : Nat.card ↥(OKg t z) = 2 ^ 12
  V_le : Vtz t z ≤ OKg t z
  cent_OK : Kg t z ⊓ centralizer (OKg t z : Set G) ≤ OKg t z
  center_OK : ∀ x ∈ OKg t z, (∀ y ∈ OKg t z, x * y = y * x) ↔ x ∈ Vtz t z
  phi_sq : ∀ x ∈ OKg t z, x ^ 2 ∈ Vtz t z
  phi_comm : ∀ x ∈ OKg t z, ∀ y ∈ OKg t z, x * y * x⁻¹ * y⁻¹ ∈ Vtz t z
  quot : ∃ (X : Type) (_ : Group X) (π : ↥(Kg t z) →* X), Function.Surjective π ∧
    π.ker = (OKg t z).subgroupOf (Kg t z) ∧ IsU42Two X
  rank : ∀ B : Subgroup G, B ≤ OKg t z → (∀ b ∈ B, b ^ 2 = 1) →
    (∀ a ∈ B, ∀ b ∈ B, a * b = b * a) → Nat.card ↥B ≤ 2 ^ 7
  perfect : ∃ Y : Subgroup G, Y ≤ Kg t z ∧ ⁅Y, Y⁆ = Y ∧
    (Y ⊔ OKg t z).relIndex (Kg t z) = 2 ∧
    ∀ U : Subgroup G, Vtz t z ≤ U → U ≤ OKg t z → InvUnder Y U →
      Nat.card ↥U = 2 ^ 2 ∨ Nat.card ↥U = 2 ^ 3 ∨ Nat.card ↥U = 2 ^ 11 ∨ Nat.card ↥U = 2 ^ 12

@[expose] def KFacts : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (L E : Subgroup G) (t z : G), Std G L E t → IsZ E t z →
    KData t z

structure U42Facts : Prop where
  center_bot : ∀ (A : Type) [Group A], IsU42Two A → center A = ⊥
  complete : ∀ (A : Type) [Group A], IsU42Two A → ∀ φ : MulAut A, ∃ a : A, φ = MulAut.conj a
  card : ∀ (A : Type) [Group A], IsU42Two A → Nat.card A = 2 ^ 7 * 3 ^ 4 * 5
  normal : ∀ (A : Type) [Group A], IsU42Two A → ∀ N : Subgroup A, N.Normal →
    N = ⊥ ∨ N.index = 2 ∨ N = ⊤
  perm : ∀ (A : Type) [Group A], IsU42Two A → ∀ n : ℕ, n ≤ 26 → ∀ φ : A →* Equiv.Perm (Fin n),
    ∀ a ∈ commutator A, φ a = 1

end CFSG.EvenSporadicStandard.TwoFi22.DS81.Fi24Branch
