@[expose] def SquareData : Prop :=
  evalCodes HypOne.M24.gens wordV1 * evalCodes HypOne.M24.gens wordV1 = m24Rep1 ∧
    evalCodes HypOne.M24.gens wordV2 * evalCodes HypOne.M24.gens wordV2 = m24Rep2

instance : Decidable SquareData := by unfold SquareData; infer_instance

@[expose] def nineList (x y : S24) : List S24 :=
  [1, x, x * x, y, x * y, x * x * y, y * y, x * y * y, x * x * y * y]

@[expose] def E9Data (l : List S24) (x y : S24) : Prop :=
  (nineList x y).length = 9 ∧ (nineList x y).Nodup ∧
    (∀ a ∈ nineList x y, ∀ b ∈ nineList x y, a * b ∈ nineList x y) ∧
    (∀ a ∈ nineList x y, ∀ e ∈ l, a * e * a⁻¹ ∈ l)

instance (l : List S24) (x y : S24) : Decidable (E9Data l x y) := by
  unfold E9Data; infer_instance

@[expose] def NineData : Prop :=
  E9Data m24E1l (m24Cj wordX1) (m24Cj wordY1) ∧ E9Data m24E2l (m24Cj wordX2) (m24Cj wordY2)

instance : Decidable NineData := by unfold NineData; infer_instance

