@[expose] def stabTabs : List Tab := stabWords.map (wordTab letterTabs)

@[expose] def qTab (i : Nat) : Tab := wordTab letterTabs (qWords.getD i [])

@[expose] def f2Tab : Tab := (elemTabs 1).getD 0 idTab

@[expose] def fixedCheck : Bool :=
  decide (stabTabs.length = 2 ∧ ∀ g ∈ stabTabs, normOK (elemTabs 1) g = true ∧
    comm g tTab = true) &&
  decide (∀ x ∈ elemTabs 1, (∀ g ∈ stabTabs, tmul g x = tmul x g ∨
    tmul g x = tmul (tmul x tTab) g) → x = tTab) &&
  decide (f2Tab ≠ tTab ∧ ∀ y ∈ elemTabs 1, y ≠ tTab → ∃ i ∈ List.range 14,
    normOK (elemTabs 1) (qTab i) = true ∧ comm (qTab i) tTab = true ∧
      tmul (qTab i) f2Tab = tmul y (qTab i))

end CFSG.EvenSporadicStandard.M23Std.FusionCheck
