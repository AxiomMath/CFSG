namespace CFSG.EvenSporadicStandard.TwoHS

abbrev V4 : Type := Fin 4 → ZMod 4

abbrev M4 : Type := Matrix (Fin 4) (Fin 4) (ZMod 4)

instance : DecidableEq M4 := inferInstanceAs (DecidableEq (Fin 4 → Fin 4 → ZMod 4))

instance (priority := high) decidableListForall {α : Type*} (p : α → Prop)
    [DecidablePred p] (l : List α) : Decidable (∀ x ∈ l, p x) := List.decidableBAll p l

instance (priority := high) decidableListExists {α : Type*} (p : α → Prop)
    [DecidablePred p] (l : List α) : Decidable (∃ x ∈ l, p x) := List.decidableBEx p l

@[expose] def vecOfList (l : List ℕ) : V4 := fun i => ((l.getD i.val 0 : ℕ) : ZMod 4)

@[expose] def matOfList (l : List ℕ) : M4 :=
  Matrix.of fun i j => ((l.getD (4 * i.val + j.val) 0 : ℕ) : ZMod 4)

