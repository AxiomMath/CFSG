@[expose] def fyThrTab (k : ℕ) : Array ℕ := hexTable3 100 (100 * k) fyThrHex

@[expose] def fyThrX : Array ℕ := fyThrTab 0

@[expose] def fyThrQGens : Array (Array ℕ) := #[fyThrTab 0, fyThrTab 1]

@[expose] def fyThrTrans : List (Array ℕ) := (List.range 8).map fun j => fyThrTab (j + 2)

@[expose] def fyThrCGens : Array (Array ℕ) := #[fyThrTab 10, fyThrTab 11, fyThrTab 12]

@[expose] def fyThrKeys : List ℕ := [0, 1, 2, 3, 4]

@[expose] def fyThrLevels : Array Level := rawLevels 100 hs100StrongArrs hs100BaseArr

@[expose] def fyThrQCert : ArrCert := enumBfs 100 fyThrQGens fyThrKeys 20

@[expose] def fyThrE : List (Array ℕ) := (enumBfs 100 fyThrCGens fyThrKeys 100).pts.toList

@[expose] def fyThrCentOK : Bool :=
  validA 100 fyThrX && fyThrX[0]! == 0 && fixLevCount 100 fyThrLevels fyThrX 0 == 10 &&
    fyThrE.length == 36 && tailOK 100 fyThrLevels fyThrX fyThrE 4 1 (idA 100)

@[expose] def fyThrFuseOK : Bool :=
  enumOK 100 fyThrQGens fyThrKeys fyThrQCert && fyThrQCert.pts.size == 9 &&
    allLt fyThrQGens.size (fun k => siftA 100 fyThrLevels hs100BaseArr 0 fyThrQGens[k]!) &&
    fyThrQCert.pts.toList.all fun z => eqA 100 z (idA 100) ||
      fyThrTrans.any fun g => validA 100 g && siftA 100 fyThrLevels hs100BaseArr 0 g &&
        eqA 100 (compA 100 g fyThrX) (compA 100 z g)

@[noinline, expose] def fyThrOK : Bool := fyThrCentOK && fyThrFuseOK

end CFSG.EvenSporadicStandard.TwoHS
