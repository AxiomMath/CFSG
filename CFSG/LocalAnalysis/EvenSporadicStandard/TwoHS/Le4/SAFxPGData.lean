@[expose] def pgRotC (k : ℕ) : FM := fmPow pgR0C k

@[expose] def pgReflC (k : ℕ) : FM := fmMul pgSf0C (fmPow pgR0C k)

@[expose] def pgRefl (k : ℕ) : SoMat5 := pgSf0 * pgR0 ^ k

@[expose] def pgD0Code : List FM := (List.range 4).flatMap fun k => [pgRotC k, pgReflC k]

@[expose] def pgD0List : List SoMat5 := pgD0Code.map toM

