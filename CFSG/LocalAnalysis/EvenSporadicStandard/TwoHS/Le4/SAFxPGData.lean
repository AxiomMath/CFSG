@[expose] def PGStage1F : Prop :=
  pgP0Code.length = 128 ∧ pgP0Code.Nodup ∧ (∀ a ∈ pgP0Code, fmOk a ∧ IsSO5 (toM a)) ∧
  fmOne ∈ pgP0Code ∧
  (∀ a ∈ pgP0Code, ∀ b ∈ pgP0Code, fmMul a b ∈ pgP0Code) ∧
  (∀ a ∈ pgP0Code, ∃ b ∈ pgP0Code, fmMul a b = fmOne) ∧
  (∀ i : Fin 4, fmOk (pgRepsC i) ∧ IsSO5 (toM (pgRepsC i)) ∧
    fmMul (pgRepsC i) (pgRepsC i) = fmOne) ∧
  (∀ a ∈ pgP0Code, fmMul a a = fmOne → a = fmOne ∨ ∃ e ∈ pgConjCode, e.1 = a) ∧
  (∀ e ∈ pgConjCode, e.1 ∈ pgP0Code ∧ fmOk e.2.1 ∧ IsSO5 (toM e.2.1) ∧
    fmMul e.2.1 e.1 = fmMul (pgRepsC e.2.2) e.2.1) ∧
  (∀ a ∈ pgP0Code, fmMul a pgTau3C = fmMul pgTau3C a) ∧
  (fmOk pgX15C ∧ IsSO5 (toM pgX15C) ∧ fmMul pgX15C pgTau2C = fmMul pgTau2C pgX15C ∧
    fmPow pgX15C 15 = fmOne ∧ fmPow pgX15C 3 ≠ fmOne ∧ fmPow pgX15C 5 ≠ fmOne) ∧
  (fmOk pgX13C ∧ IsSO5 (toM pgX13C) ∧ fmMul pgX13C pgTau4C = fmMul pgTau4C pgX13C ∧
    fmPow pgX13C 13 = fmOne ∧ pgX13C ≠ fmOne) ∧
  (∀ k ∈ ([1, 3] : List ℕ), ∀ j ∈ ([0, 1] : List ℕ),
    fmOk (pgF2C k j) ∧ IsSO5 (toM (pgF2C k j)) ∧ fmMul (pgF2C k j) pgTau1C =
      fmMul (fmMul (pgReflC k) (if j = 0 then pgS1C else fmMul pgTau1C pgS1C)) (pgF2C k j))

set_option synthInstance.maxSize 4096 in
instance : Decidable PGStage1F := by unfold PGStage1F; infer_instance

@[expose] def PGChiF : Prop :=
  Fintype.card OmegaPts = 600 ∧ fixCount (toM (pgReflC 0)) = 0 ∧ fixCount (toM (pgReflC 1)) = 2 ∧
    fixCount (toM (pgReflC 2)) = 0 ∧ fixCount (toM (pgReflC 3)) = 2 ∧ fixCount pgS1 = 30 ∧
    fixCount pgTau1 = 20

instance : Decidable PGChiF := by unfold PGChiF; infer_instance

