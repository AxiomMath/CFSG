@[expose] def pgS0List : List SoMat5 := pgS0Code.map toM

@[expose] def pgCCode : List FM :=
  pgD0Code.flatMap fun d => pgS0Code.map fun s => fmMul d s

@[expose] def pgCList : List SoMat5 := pgCCode.map toM

@[expose] def PGCoreF : Prop :=
  pgS0Code.length = 120 ∧ pgS0Code.Nodup ∧ pgD0Code.length = 8 ∧ pgD0Code.Nodup ∧
  pgCCode.length = 960 ∧ pgCCode.Nodup ∧
  (∀ a ∈ pgS0Code, fmOk a) ∧ (∀ a ∈ pgD0Code, fmOk a) ∧
  fmOk pgR0C ∧ fmOk pgSf0C ∧ fmOk pgTau1C ∧ fmOk pgS1C ∧
  (∀ a ∈ pgCCode, fmOk a ∧ IsSO5 (toM a) ∧ fmMul a pgTau1C = fmMul pgTau1C a) ∧
  (∀ c ∈ pgS0Code, c ∈ pgCCode) ∧
  pgS1C ∈ pgS0Code ∧ fmMul pgS1C pgS1C = fmOne ∧
  (∀ x ∈ pgCCode, (∀ c ∈ pgS0Code, fmMul c x = fmMul x c ∨
      fmMul c x = fmMul (fmMul x pgTau1C) c) → x ∈ pgD0Code) ∧
  (∀ x ∈ pgCCode, fmMul x pgR0C = fmMul pgR0C x → fmMul x pgSf0C = fmMul pgSf0C x →
    x ∈ pgS0Code ∨ fmMul pgTau1C x ∈ pgS0Code) ∧
  (∀ x ∈ pgD0Code, fmMul x x = pgTau1C → x = pgR0C ∨ x = fmPow pgR0C 3) ∧
  (∀ x ∈ pgD0Code, fmMul x x = fmOne → x ≠ fmOne → x ≠ pgTau1C →
    x = pgReflC 0 ∨ x = pgReflC 1 ∨ x = pgReflC 2 ∨ x = pgReflC 3) ∧
  (∀ x ∈ pgD0Code, fmMul x x = fmOne → x ≠ fmOne → x ≠ pgTau1C → fmTr x ≠ fmTr pgTau1C) ∧
  pgR0C ∈ pgD0Code ∧ pgSf0C ∈ pgD0Code ∧ pgTau1C ∈ pgD0Code ∧
  fmMul pgR0C pgR0C = pgTau1C ∧ fmMul pgSf0C pgSf0C = fmOne ∧ fmMul pgSf0C pgR0C = pgReflC 1 ∧
  (∀ k ∈ ([0, 1, 2, 3] : List ℕ), fmMul (pgReflC k) (pgReflC k) = fmOne) ∧
  fmMul pgTau1C pgTau1C = fmOne ∧ fmMul pgTau1C pgS1C = fmMul pgS1C pgTau1C

set_option synthInstance.maxSize 4096 in
instance : Decidable PGCoreF := by unfold PGCoreF; infer_instance

end CFSG.EvenSporadicStandard.TwoHS
