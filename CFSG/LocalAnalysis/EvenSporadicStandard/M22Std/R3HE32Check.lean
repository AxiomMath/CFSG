@[expose] def elemLevel (T : List Tab) : Nat → List (List Tab)
  | 0 => [[idTab, tTab]]
  | k + 1 => (lvIdx.getD k []).map fun L => L.map fun i => T.getD i []

@[expose] def StepOK (T : List Tab) (k : Nat) : Prop :=
  (∀ L ∈ elemLevel T k, ∀ x ∈ extCands (invTabs T) L, sortTabs (ext L x) ∈ elemLevel T (k + 1)) ∧
    ∀ L ∈ elemLevel T (k + 1), L.length = 2 ^ (k + 2)

def jTabs : List Tab := (elemLevel s0Tabs 4).headD []

theorem jTabs_eq : jTabs = (elemLevel s0Tabs 4).headD [] := by
  unfold jTabs
  rfl

@[expose] def normB (L : List Tab) : Bool :=
  s0Gens.all fun g => L.all fun l => L.any fun l' => decide (tmul g l = tmul l' g)

@[expose] def CheckRest : Prop :=
  (elemLevel s0Tabs 4).length = 1 ∧
  jTabs.length = 32 ∧ jTabs.Nodup ∧ jTabs.Pairwise (fun a b => tabLE a b = true) ∧
  idTab ∈ jTabs ∧ tTab ∈ jTabs ∧
  (∀ a ∈ jTabs, a ∈ s0Tabs ∧ tmul a a = idTab ∧
    ∀ b ∈ jTabs, tmul a b ∈ jTabs ∧ comm a b = true) ∧
  (∃ l ∈ s0Inner, l ∈ jTabs ∧ l ∉ f1Tabs) ∧
  ∀ L ∈ elemLevel s0Tabs 3, L.Nodup ∧
    (normB L = true → 4 < (L.filter fun l => decide (l ∈ jTabs)).length ∨ ∀ l ∈ L, l ∈ f1Tabs)

instance : Decidable CheckRest := by
  unfold CheckRest
  infer_instance

@[expose] def CheckProp : Prop := (∀ k < 5, StepOK s0Tabs k) ∧ CheckRest

instance (T : List Tab) (k : Nat) : Decidable (StepOK T k) := by
  unfold StepOK
  infer_instance

instance : Decidable CheckProp := by
  unfold CheckProp
  infer_instance

@[expose] def check : Bool := decide CheckProp

