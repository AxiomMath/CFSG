theorem sporNoAltDown37_of_order
    (hOrd : CFSG.HardMathSupport.Solomon.Coordinator.SporadicOrdersTable) {name : TauCeti.SporadicName}
    (h : name = .M11 ∨ name = .M12 ∨ name = .M22 ∨ name = .M23 ∨ name = .J1 ∨ name = .J3 ∨
      name = .HS) : SporNoAltDown 3 7 name := by
  refine sporNoAltDown_of_not_dvd hOrd Nat.prime_three (by norm_num) ?_
  rcases h with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [CFSG.HardMathSupport.Solomon.Coordinator.sporOrd, Nat.factorial, orderJ3] <;> decide

theorem sporNoAltDown37_of_leafShape (hBr : SporadicBridges) (hnl : Prop1116Design.InputAltNotLie)
    {name : TauCeti.SporadicName} [Finite (CFSG.Blueprint.NativeSporadic.Carrier name)]
    (h : LeafShape name 3) : SporNoAltDown 3 7 name :=
  sporNoAltDown_of_model Nat.prime_three (hBr name).some
    (centNoAlt_of_centShape Nat.prime_three h fun _ _ hg => ⟨fun e => not_leafType_alt7 hnl e hg⟩)

theorem sporNoAltDown37_of_split (hBr : SporadicBridges) (hnl : Prop1116Design.InputAltNotLie)
    {name : TauCeti.SporadicName} [Finite (CFSG.Blueprint.NativeSporadic.Carrier name)]
    (h : CentShapeSplit 3 (CFSG.Blueprint.NativeSporadic.Carrier name)) : SporNoAltDown 3 7 name :=
  sporNoAltDown_of_model Nat.prime_three (hBr name).some
    (centNoAlt_of_centShapeSplit Nat.prime_three h fun _ _ hg =>
      ⟨fun e => hg.elim (not_leafType_alt7 hnl e) (not_isA6At_alt7 e)⟩)

theorem sporNoAltDown37_of_goodSpor (hBr : SporadicBridges) (hnl : Prop1116Design.InputAltNotLie)
    (hOrd : CFSG.HardMathSupport.Solomon.Coordinator.SporadicOrdersTable)
    {name : TauCeti.SporadicName} [Finite (CFSG.Blueprint.NativeSporadic.Carrier name)]
    {names : List TauCeti.SporadicName} {Rk : ∀ (T : Type) [Group T], Prop}
    (h : CentShapeRk 3 (GoodSpor 3 names) Rk (CFSG.Blueprint.NativeSporadic.Carrier name)) :
    SporNoAltDown 3 7 name :=
  sporNoAltDown_of_model Nat.prime_three (hBr name).some
    (centNoAlt_of_centShapeRk Nat.prime_three h fun _ _ hg =>
      ⟨fun e => not_goodSpor_alt7 hnl hOrd names e hg⟩)

theorem sporNoAltDown37_of_a6 (hBr : SporadicBridges) {name : TauCeti.SporadicName}
    [Finite (CFSG.Blueprint.NativeSporadic.Carrier name)] {Rk : ∀ (T : Type) [Group T], Prop}
    (h : CentShapeRk 3 (IsA6At 3) Rk (CFSG.Blueprint.NativeSporadic.Carrier name)) :
    SporNoAltDown 3 7 name :=
  sporNoAltDown_of_model Nat.prime_three (hBr name).some
    (centNoAlt_of_centShapeRk Nat.prime_three h fun _ _ hg => ⟨fun e => not_isA6At_alt7 e hg⟩)

theorem sporNoAltDown37_of_constrained (hBr : SporadicBridges) {name : TauCeti.SporadicName}
    [Finite (CFSG.Blueprint.NativeSporadic.Carrier name)] (h : ConstrainedShape name 3) :
    SporNoAltDown 3 7 name :=
  sporNoAltDown_of_model Nat.prime_three (hBr name).some (centNoAlt_of_constrained Nat.prime_three h)

