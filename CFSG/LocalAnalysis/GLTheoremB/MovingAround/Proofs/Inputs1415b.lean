section Types

variable {T : Type} [Group T]

theorem alt7_not_spor (hOrd : CFSG.HardMathSupport.Solomon.Coordinator.SporadicOrdersTable)
    (S : TauCeti.SporadicName) : IsEmpty (alternatingGroup (Fin 7) ≃* (TauCeti.CFSGIndex.sporadic S).Group) := by
  refine ⟨fun e => ?_⟩
  have h := Nat.card_congr e.toEquiv
  rw [card_alt 7 (by norm_num), hOrd S] at h
  revert h
  cases S <;> simp [CFSG.HardMathSupport.Solomon.Coordinator.sporOrd, Nat.factorial, orderJ3, orderJ4,
    orderRu, orderON, orderCo1, orderFi23, orderFi24Prime, orderHN, orderLy, orderTh,
    orderBabyMonster, orderMonster]

theorem not_leafType_alt7 (hnl : Prop1116Design.InputAltNotLie) (e : T ≃* alternatingGroup (Fin 7)) :
    ¬ LeafType 3 T := by
  rintro (⟨hC, -, -⟩ | ⟨n, hn5, -, h3n, ⟨f⟩⟩)
  · rcases alt_chev_degree hnl (by norm_num) e hC with h | h | h <;> omega
  · have h7 : 7 = n := Prop1116Design.alt_iso_degree (by norm_num) hn5 (e.symm.trans f)
    subst h7
    omega

theorem not_isA6At_alt7 (e : T ≃* alternatingGroup (Fin 7)) {p : ℕ} : ¬ IsA6At p T := by
  rintro ⟨-, ⟨f⟩⟩
  have := Prop1116Design.alt_iso_degree (by norm_num) (by norm_num) (e.symm.trans f)
  omega

theorem not_goodSpor_alt7 (hnl : Prop1116Design.InputAltNotLie)
    (hOrd : CFSG.HardMathSupport.Solomon.Coordinator.SporadicOrdersTable)
    (names : List TauCeti.SporadicName) (e : T ≃* alternatingGroup (Fin 7)) :
    ¬ GoodSpor 3 names T := by
  rintro (h | h | ⟨S, -, ⟨f⟩⟩)
  · exact not_leafType_alt7 hnl e h
  · exact not_isA6At_alt7 e h
  · exact (alt7_not_spor hOrd S).false (e.symm.trans f)

end Types

section Shapes

variable {Q : Type} [Group Q] [Finite Q] {p m : ℕ}

theorem centNoAlt_of_centShape (hp : p.Prime) {Good : ∀ (T : Type) [Group T], Prop}
    (h : CentShape p Good Q)
    (hG : ∀ (T : Type) [Group T], Good T → IsEmpty (T ≃* alternatingGroup (Fin m))) :
    CentNoAlt p m Q := by
  intro s hs I hI
  have hs1 : s ≠ 1 := fun h1 => by rw [h1, orderOf_one] at hs; exact hp.one_lt.ne' hs.symm
  have hsp : s ^ p = 1 := by rw [← hs]; exact pow_orderOf_eq_one s
  rcases h s hs1 hsp with hc | ⟨J, -, hu, hg⟩
  · exact (no_glaPComponent_of_pConstrainedShape hp hc hI).elim
  · rw [hu I hI]
    exact hG _ hg

theorem centNoAlt_of_centShapeRk (hp : p.Prime) {Good Rk : ∀ (T : Type) [Group T], Prop}
    (h : CentShapeRk p Good Rk Q)
    (hG : ∀ (T : Type) [Group T], Good T → IsEmpty (T ≃* alternatingGroup (Fin m))) :
    CentNoAlt p m Q := by
  intro s hs I hI
  have hs1 : s ≠ 1 := fun h1 => by rw [h1, orderOf_one] at hs; exact hp.one_lt.ne' hs.symm
  have hsp : s ^ p = 1 := by rw [← hs]; exact pow_orderOf_eq_one s
  rcases h s hs1 hsp with hc | ⟨J, -, hu, hg, -⟩
  · exact (no_glaPComponent_of_pConstrainedShape hp hc hI).elim
  · rw [hu I hI]
    exact hG _ hg

theorem centNoAlt_of_centShapeRk' (hp : p.Prime) {Good Rk : ∀ (T : Type) [Group T], Prop}
    (h : CentShapeRk' p Good Rk Q)
    (hG : ∀ (T : Type) [Group T], Good T → IsEmpty (T ≃* alternatingGroup (Fin m))) :
    CentNoAlt p m Q := by
  intro s hs I hI
  have hs1 : s ≠ 1 := fun h1 => by rw [h1, orderOf_one] at hs; exact hp.one_lt.ne' hs.symm
  have hsp : s ^ p = 1 := by rw [← hs]; exact pow_orderOf_eq_one s
  rcases h s hs1 hsp with hc | ⟨J, -, hu, hg, -⟩
  · exact (hc I hI).elim
  · rw [hu I hI]
    exact hG _ hg

theorem centNoAlt_of_centShapeSplit (hp : p.Prime) (h : CentShapeSplit p Q)
    (hG : ∀ (T : Type) [Group T], (LeafType p T ∨ IsA6At p T) →
      IsEmpty (T ≃* alternatingGroup (Fin m))) :
    CentNoAlt p m Q := by
  intro s hs I hI
  have hs1 : s ≠ 1 := fun h1 => by rw [h1, orderOf_one] at hs; exact hp.one_lt.ne' hs.symm
  have hsp : s ^ p = 1 := by rw [← hs]; exact pow_orderOf_eq_one s
  rcases h s hs1 hsp with hc | ⟨J, -, hu, hg⟩
  · exact (no_glaPComponent_of_pConstrainedShape hp hc hI).elim
  · rw [hu I hI]
    rcases hg with hg | ⟨hg, -⟩
    · exact hG _ (Or.inl hg)
    · exact hG _ (Or.inr hg)

theorem centNoAlt_of_constrained (hp : p.Prime)
    (h : ∀ k : Q, k ≠ 1 → k ^ p = 1 → PConstrainedShape p (Subgroup.centralizer ({k} : Set Q))) :
    CentNoAlt p m Q := by
  intro s hs I hI
  have hs1 : s ≠ 1 := fun h1 => by rw [h1, orderOf_one] at hs; exact hp.one_lt.ne' hs.symm
  have hsp : s ^ p = 1 := by rw [← hs]; exact pow_orderOf_eq_one s
  exact (no_glaPComponent_of_pConstrainedShape hp (h s hs1 hsp) hI).elim

end Shapes

theorem sporNoAltDown_of_subgroup_model {p m : ℕ} (hp : p.Prime) {name : TauCeti.SporadicName}
    {G₀ : Type} [Group G₀] {H : Subgroup G₀}
    (e : (TauCeti.CFSGIndex.sporadic name).Group ≃* ↥H) (h : CentNoAlt p m ↥H) :
    SporNoAltDown p m name := by
  intro T _ _ ⟨f⟩ s hs I hI
  exact (h.of_equiv hp (f.trans e)) s hs I hI

