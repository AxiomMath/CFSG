theorem eq_bot_of_perfect_of_le_center {X : Type*} [Group X] {A B : Subgroup X}
    (hA : ⁅A, A⁆ = A) (h : A ≤ (Subgroup.center ↥B).map B.subtype) : A = ⊥ := by
  have hcomm : ⁅A, A⁆ = ⊥ := by
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    obtain ⟨z, hz, rfl⟩ := h ha
    obtain ⟨w, -, rfl⟩ := h hb
    exact congrArg Subtype.val (Subgroup.mem_center_iff.1 hz w)
  rw [← hA, hcomm]

theorem isSubnormal_eq_or_le_center {X : Type*} [Group X] {A B : Subgroup X}
    (h : IsSubnormal A B) (hB : CFSG.IsQuasisimple ↥B) :
    A = B ∨ A ≤ (Subgroup.center ↥B).map B.subtype := by
  induction h with
  | refl A => exact Or.inl rfl
  | step hAM hn _ ih =>
    rename_i A M
    rcases ih hB with hMB | hM
    · subst hMB
      rcases CFSG.LocalCores.quasisimple_normal_subgroups hB hn with h | h
      · exact Or.inl (le_antisymm hAM (Subgroup.subgroupOf_eq_top.mp h))
      · exact Or.inr fun x hx => ⟨⟨x, hAM hx⟩, h hx, rfl⟩
    · exact Or.inr (hAM.trans hM)

theorem card_le_of_quasisimple {X : Type} [Group X] [Finite X] {p : ℕ} (hp : p.Prime)
    {C I : Subgroup X} (hC : CFSG.IsQuasisimple ↥C) (hI : GLAPComponent p C I) :
    I = C ∧ Nat.card C ≤ Nat.card (Subgroup.center ↥C) * Nat.card (PSimple p I) := by
  have hperf : ⁅I, I⁆ = I := CFSG.LocalAnalysis.GLTheoremB.glaPComponent_perfect hI
  have hne : I ≠ ⊥ := CFSG.LocalAnalysis.GLTheoremA.glaPComponent_ne_bot' hI
  have hIC : I = C := by
    rcases isSubnormal_eq_or_le_center hI.2.1 hC with h | h
    · exact h
    · exact absurd (eq_bot_of_perfect_of_le_center hperf h) hne
  refine ⟨hIC, ?_⟩
  subst hIC
  set f : ↥I →* PSimple p I :=
