    (hz : Nat.card ↥(Subgroup.center ↥(Subgroup.centralizer ({c} : Set ↥H))) = z)
    (hc : Nat.card ↥(Subgroup.centralizer ({c} : Set ↥H)) = N) {s : S} (hs : orderOf s = 3) :
    CFSG.IsQuasisimple ↥(Subgroup.centralizer ({s} : Set S)) ∧
