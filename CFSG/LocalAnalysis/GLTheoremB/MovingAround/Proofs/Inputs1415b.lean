section Census

theorem half_factorial_le {k m : ℕ} (h : k ≤ m) : k.factorial / 2 ≤ m.factorial / 2 :=
  Nat.div_le_div_right (Nat.factorial_le h)

theorem lt_mul_half_factorial {p k m B : ℕ} (hkm : k ≤ m) (h : B < p * (k.factorial / 2)) :
    B < p * (m.factorial / 2) :=
  lt_of_lt_of_le h (Nat.mul_le_mul_left p (half_factorial_le hkm))

theorem half_factorial_dvd {k m : ℕ} (hk : 2 ≤ k) (hkm : k ≤ m) :
    k.factorial / 2 ∣ m.factorial / 2 := by
  obtain ⟨t, ht⟩ := Nat.factorial_dvd_factorial hkm
  obtain ⟨u, hu⟩ := Nat.dvd_factorial (by norm_num : 0 < 2) hk
  refine ⟨t, ?_⟩
  rw [ht, hu, mul_assoc, Nat.mul_div_cancel_left _ (by norm_num), Nat.mul_div_cancel_left _ (by norm_num)]

theorem prime_dvd_half_factorial {r m : ℕ} (hr : r.Prime) (hr2 : r ≠ 2) (hrm : r ≤ m) :
    r ∣ m.factorial / 2 := by
  have h1 : r ∣ m.factorial := Nat.dvd_factorial hr.pos hrm
  have h2 : 2 ∣ m.factorial := Nat.dvd_factorial (by norm_num) (le_trans hr.two_le hrm)
  have h3 : m.factorial = 2 * (m.factorial / 2) := (Nat.mul_div_cancel' h2).symm
  rw [h3] at h1
  exact (Nat.Coprime.dvd_of_dvd_mul_left ((Nat.coprime_primes hr Nat.prime_two).2 hr2) h1)

theorem orderOf_inv_mul_mul' {G : Type*} [Group G] (g x : G) : orderOf (g⁻¹ * x * g) = orderOf x := by
  have := (MulAut.conj g⁻¹ : G ≃* G).orderOf_eq x
  rwa [MulAut.conj_apply, inv_inv] at this

theorem card_centralizer_subgroup {G₀ : Type*} [Group G₀] (P : Subgroup G₀) (s : ↥P) :
    Nat.card (Subgroup.centralizer ({s} : Set ↥P)) =
      Nat.card ↥(Subgroup.centralizer ({(s : G₀)} : Set G₀) ⊓ P) := by
  refine Nat.card_congr
    { toFun := fun c => ⟨((c : ↥P) : G₀), Subgroup.mem_inf.2 ⟨?_, (c : ↥P).2⟩⟩
      invFun := fun c => ⟨⟨c, (Subgroup.mem_inf.1 c.2).2⟩, ?_⟩
      left_inv := fun c => rfl
      right_inv := fun c => rfl }
  · have h := Subgroup.mem_centralizer_singleton_iff.1 c.2
    exact Subgroup.mem_centralizer_singleton_iff.2 (congrArg Subtype.val h)
  · exact Subgroup.mem_centralizer_singleton_iff.2
      (Subtype.ext (Subgroup.mem_centralizer_singleton_iff.1 (Subgroup.mem_inf.1 c.2).1))

theorem card_centralizer_inf_conj_mem {G₀ : Type*} [Group G₀] (K : Subgroup G₀) {c : G₀}
    (hc : c ∈ K) (x : G₀) :
    Nat.card ↥(Subgroup.centralizer ({c * x * c⁻¹} : Set G₀) ⊓ K) =
      Nat.card ↥(Subgroup.centralizer ({x} : Set G₀) ⊓ K) := by
  refine Nat.card_congr
    { toFun := fun y => ⟨c⁻¹ * y * c, ?_⟩
      invFun := fun y => ⟨c * y * c⁻¹, ?_⟩
      left_inv := fun y => Subtype.ext (by simp only; group)
      right_inv := fun y => Subtype.ext (by simp only; group) }
  · obtain ⟨h1, h2⟩ := Subgroup.mem_inf.1 y.2
    refine Subgroup.mem_inf.2 ⟨?_, K.mul_mem (K.mul_mem (K.inv_mem hc) h2) hc⟩
    rw [Subgroup.mem_centralizer_singleton_iff] at h1 ⊢
    calc c⁻¹ * (y : G₀) * c * x = c⁻¹ * ((y : G₀) * (c * x * c⁻¹)) * c := by group
      _ = c⁻¹ * ((c * x * c⁻¹) * (y : G₀)) * c := by rw [h1]
      _ = x * (c⁻¹ * (y : G₀) * c) := by group
  · obtain ⟨h1, h2⟩ := Subgroup.mem_inf.1 y.2
    refine Subgroup.mem_inf.2 ⟨?_, K.mul_mem (K.mul_mem hc h2) (K.inv_mem hc)⟩
    rw [Subgroup.mem_centralizer_singleton_iff] at h1 ⊢
    calc c * (y : G₀) * c⁻¹ * (c * x * c⁻¹) = c * ((y : G₀) * x) * c⁻¹ := by group
      _ = c * (x * (y : G₀)) * c⁻¹ := by rw [h1]
      _ = c * x * c⁻¹ * (c * (y : G₀) * c⁻¹) := by group

theorem centralizer_eq_of_zpowers_eq' {G : Type*} [Group G] {a b : G}
    (h : Subgroup.zpowers a = Subgroup.zpowers b) :
    Subgroup.centralizer ({a} : Set G) = Subgroup.centralizer ({b} : Set G) := by
  have key : ∀ x y : G, Subgroup.zpowers x ≤ Subgroup.zpowers y →
      Subgroup.centralizer ({y} : Set G) ≤ Subgroup.centralizer ({x} : Set G) := by
    intro x y hxy c hc
    rw [Subgroup.mem_centralizer_singleton_iff] at hc ⊢
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 (hxy (Subgroup.mem_zpowers x))
    rw [← hk]
    exact ((show Commute c y from hc).zpow_right k).eq
  exact le_antisymm (key b a h.ge) (key a b h.le)

theorem card_centralizer_le_of_lines {G₀ : Type*} [Group G₀] [Finite G₀] {P R Q : Subgroup G₀}
    {p k B : ℕ} [Fact p.Prime] (hPR : P ≤ R) (hQP : Q ≤ P)
    (hsyl : ∃ S : Sylow p ↥P, (S : Subgroup ↥P) = Q.subgroupOf P) {L : Fin k → G₀}
    (hlines : {H : Subgroup G₀ | H ≤ Q ∧ Nat.card H = p} =
      Set.range (fun j => Subgroup.zpowers (L j)))
    (hB : ∀ j, Nat.card ↥(Subgroup.centralizer ({L j} : Set G₀) ⊓ R) ≤ B)
    (s : ↥P) (hs : orderOf s = p) : Nat.card (Subgroup.centralizer ({s} : Set ↥P)) ≤ B := by
  have hQfull : Nat.card Q = p ^ (Nat.card P).factorization p := by
    obtain ⟨S, hS⟩ := hsyl
    have h1 : Nat.card (S : Subgroup ↥P) = p ^ (Nat.card ↥P).factorization p :=
      Sylow.card_eq_multiplicity S
    rw [hS] at h1
    rw [← h1]
    exact (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hQP).toEquiv).symm
  have hso : orderOf (s : G₀) = p := by rw [Subgroup.orderOf_coe]; exact hs
  obtain ⟨g, hgP, hgQ⟩ :=
    CFSG.HardMathSupport.Timmesfeld.SporadicBalance.Co3T.exists_conj_mem_of_full hQP hQfull s.2 hso
  set t := g⁻¹ * (s : G₀) * g with htdef
  have hto : orderOf t = p := by rw [htdef, orderOf_inv_mul_mul', hso]
  have hmem : Subgroup.zpowers t ∈ {H : Subgroup G₀ | H ≤ Q ∧ Nat.card H = p} :=
    ⟨(Subgroup.zpowers_le).2 hgQ, by rw [Nat.card_zpowers, hto]⟩
  rw [hlines] at hmem
  obtain ⟨j, hj⟩ := hmem
  have hcent : Subgroup.centralizer ({t} : Set G₀) = Subgroup.centralizer ({L j} : Set G₀) :=
    (centralizer_eq_of_zpowers_eq' hj).symm
  rw [card_centralizer_subgroup P s]
  have hs' : (s : G₀) = g * t * g⁻¹ := by rw [htdef]; group
  rw [hs', card_centralizer_inf_conj_mem P hgP t, hcent]
  exact (Subgroup.card_le_of_le (inf_le_inf_left _ hPR)).trans (hB j)

theorem sporNoAltDown_of_lines {name : TauCeti.SporadicName} {p m k B : ℕ} (hp : p.Prime)
    (hm : 2 ≤ m) {G₀ : Type} [Group G₀] [Finite G₀] {P R Q : Subgroup G₀}
    (e : (TauCeti.CFSGIndex.sporadic name).Group ≃* ↥P) (hPR : P ≤ R) (hQP : Q ≤ P)
    (hsyl : ∃ S : Sylow p ↥P, (S : Subgroup ↥P) = Q.subgroupOf P) {L : Fin k → G₀}
    (hlines : {H : Subgroup G₀ | H ≤ Q ∧ Nat.card H = p} =
      Set.range (fun j => Subgroup.zpowers (L j)))
    (hB : ∀ j, Nat.card ↥(Subgroup.centralizer ({L j} : Set G₀) ⊓ R) ≤ B)
    (hBm : B < p * (m.factorial / 2)) : SporNoAltDown p m name := by
  haveI : Fact p.Prime := ⟨hp⟩
  refine sporNoAltDown_of_subgroup_model hp e (centNoAlt_of_card hp fun s hs hdvd => ?_)
  have h1 := card_centralizer_le_of_lines hPR hQP hsyl hlines hB s hs
  have h2 := Nat.le_of_dvd Nat.card_pos hdvd
  rw [card_alt m hm] at h2
  omega

theorem card_inf_le_of_transporter {G₀ : Type*} [Group G₀] {R : Subgroup G₀} {x y h : G₀}
    (hh : h ∈ R) (hc : h * x * h⁻¹ = y) {B : ℕ}
    (hx : Nat.card ↥(Subgroup.centralizer ({x} : Set G₀) ⊓ R) ≤ B) :
    Nat.card ↥(Subgroup.centralizer ({y} : Set G₀) ⊓ R) ≤ B := by
  rw [← hc, card_centralizer_inf_conj_mem R hh x]
  exact hx

theorem exists_conj_of_pair {G : Type*} [Group G] [Finite G] {p : ℕ} [hp : Fact p.Prime] {x y z : G}
    (hcomm : x * y = y * x) (hx : x ^ p = 1) (hy : y ^ p = 1) (hx1 : x ≠ 1)
    (hpow : ∀ k < p, y ≠ x ^ k) (hfac : (Nat.card G).factorization p = 2)
    (hconj : ∀ i j : ℕ, i < p → j < p → i + j ≠ 0 → ∃ m : G, m * (x ^ i * y ^ j) = z * m)
    (s : G) (hs : orderOf s = p) : ∃ c : G, c * s * c⁻¹ = z := by
  have hG : ¬ p ^ 3 ∣ Nat.card G := by
    intro h
    have h0 : Nat.card G ≠ 0 := Nat.card_pos.ne'
    have := (hp.out.pow_dvd_iff_le_factorization h0).1 h
    omega
  have hQ := CFSG.HardMathSupport.Timmesfeld.SporadicBalance.CommutingPair.card_closure_pair_eq_sq
    hcomm hx hy hx1 hpow hG
  have hQfull : Nat.card (Subgroup.closure ({x, y} : Set G)) =
      p ^ (Nat.card (⊤ : Subgroup G)).factorization p := by
    rw [hQ, Subgroup.card_top, hfac]
  obtain ⟨g, -, hgQ⟩ := CFSG.HardMathSupport.Timmesfeld.SporadicBalance.Co3T.exists_conj_mem_of_full
    le_top hQfull (Subgroup.mem_top s) hs
  obtain ⟨i, hi, j, hj, hw⟩ :=
    CFSG.HardMathSupport.Timmesfeld.SporadicBalance.CommutingPair.exists_pow_mul_pow_of_mem
      hp.out.pos hcomm hx hy hgQ
  have hwo : orderOf (g⁻¹ * s * g) = p := by rw [orderOf_inv_mul_mul', hs]
  have hij : i + j ≠ 0 := by
    intro h0
    have hi0 : i = 0 := by omega
    have hj0 : j = 0 := by omega
    rw [hi0, hj0, pow_zero, pow_zero, mul_one] at hw
    rw [hw, orderOf_one] at hwo
    exact hp.out.one_lt.ne hwo
  obtain ⟨m, hm⟩ := hconj i j hi hj hij
  refine ⟨m * g⁻¹, ?_⟩
  rw [← hw] at hm
  calc (m * g⁻¹) * s * (m * g⁻¹)⁻¹ = (m * (g⁻¹ * s * g)) * m⁻¹ := by group
    _ = z := by rw [hm]; group

theorem centNoAlt_of_reps {p m B : ℕ} (hp : p.Prime) (hm : 2 ≤ m) {Q : Type} [Group Q] [Finite Q]
    (h : ∀ s : Q, orderOf s = p → ∃ c z : Q, c * s * c⁻¹ = z ∧
      Nat.card (Subgroup.centralizer ({z} : Set Q)) ≤ B)
    (hBm : B < p * (m.factorial / 2)) : CentNoAlt p m Q := by
  refine centNoAlt_of_card hp fun s hs hdvd => ?_
  obtain ⟨c, z, hz, hb⟩ := h s hs
  rw [← hz, CFSG.HardMathSupport.Timmesfeld.SporadicBalance.card_centralizer_conj_eq] at hb
  have h2 := Nat.le_of_dvd Nat.card_pos hdvd
  rw [card_alt m hm] at h2
  omega

theorem exists_orderOf_mul_of_comp {T : Type} [Group T] [Finite T] {p r m : ℕ} (hp : p.Prime)
    (hr : r.Prime) (hrp : r ≠ p) (hm : 2 ≤ m) (hrm : r ∣ m.factorial / 2) {s : T}
    (hs : orderOf s = p) {I : Subgroup T}
    (hI : GLAPComponent p (Subgroup.centralizer ({s} : Set T)) I)
    (e : PSimple p I ≃* alternatingGroup (Fin m)) : ∃ g : T, orderOf g = p * r := by
  haveI : Fact r.Prime := ⟨hr⟩
  have hcard : Nat.card (PSimple p I) ∣ Nat.card I :=
    (Subgroup.card_quotient_dvd_card _).trans (Subgroup.card_quotient_dvd_card _)
  rw [Nat.card_congr e.toEquiv, card_alt m hm] at hcard
  obtain ⟨u, hu⟩ := exists_prime_orderOf_dvd_card' r (hrm.trans hcard)
  have hcomm : Commute s (u : T) :=
    (Subgroup.mem_centralizer_singleton_iff.1 (hI.1 u.2)).symm
  refine ⟨s * u, ?_⟩
  rw [hcomm.orderOf_mul_eq_mul_orderOf_of_coprime, hs, Subgroup.orderOf_coe, hu]
  rw [hs, Subgroup.orderOf_coe, hu]
  exact (Nat.coprime_primes hp hr).2 (Ne.symm hrp)

theorem sporNoAltDown_of_noOrder {p r m : ℕ} (hp : p.Prime) (hr : r.Prime) (hrp : r ≠ p) (hm : 2 ≤ m)
    (hrm : r ∣ m.factorial / 2) {name : TauCeti.SporadicName} {Q : Type} [Group Q]
    (e : Q ≃* (TauCeti.CFSGIndex.sporadic name).Group) (h : ∀ g : Q, orderOf g ≠ p * r) :
    SporNoAltDown p m name := by
  intro T _ _ ⟨f⟩ s hs I hI
  refine ⟨fun e' => ?_⟩
  obtain ⟨g, hg⟩ := exists_orderOf_mul_of_comp hp hr hrp hm hrm hs hI e'
  exact h ((f.trans e.symm) g) (by rw [MulEquiv.orderOf_eq]; exact hg)

theorem card_centralizer_le_of_census {S : Type*} [Group S] [Finite S] {p n B : ℕ} [hp : Fact p.Prime]
    {P : Subgroup S} (hP : Nat.card P = p ^ (Nat.card (⊤ : Subgroup S)).factorization p)
    (x t c : ℕ → S) (hmem : ∀ y ∈ P, y = 1 ∨ ∃ k < n, ∃ b < p - 1, y = x k ^ (b + 1))
    (hconj : ∀ k < n, c k * x k = t k * c k) (ht : ∀ k, orderOf (t k) = p)
    (hB : ∀ k, Nat.card (Subgroup.centralizer ({t k} : Set S)) ≤ B)
    (s : S) (hs : orderOf s = p) : Nat.card (Subgroup.centralizer ({s} : Set S)) ≤ B := by
  obtain ⟨g, -, hg⟩ := CFSG.HardMathSupport.Timmesfeld.SporadicBalance.Co3T.exists_conj_mem_of_full
    (le_top : P ≤ ⊤) hP (Subgroup.mem_top s) hs
  have hy : orderOf (g⁻¹ * s * g) = p := by rw [orderOf_inv_mul_mul', hs]
  rcases hmem _ hg with h1 | ⟨k, hk, b, hb, hyk⟩
  · rw [h1, orderOf_one] at hy
    exact absurd hy.symm hp.out.one_lt.ne'
  · have hc : c k * (g⁻¹ * s * g) * (c k)⁻¹ = t k ^ (b + 1) := by
      rw [hyk]
      exact CFSG.HardMathSupport.Timmesfeld.SporadicBalance.conj_pow_of_conj (hconj k hk) _
    have hC : Subgroup.centralizer ({t k ^ (b + 1)} : Set S) =
        Subgroup.centralizer ({t k} : Set S) :=
      CFSG.HardMathSupport.Timmesfeld.SporadicBalance.centralizer_pow_eq_of_not_dvd hp.out (ht k)
        (fun h => by have := Nat.le_of_dvd (by omega) h; omega)
    have hcs : (c k * g⁻¹) * s * (c k * g⁻¹)⁻¹ = t k ^ (b + 1) := by
      rw [← hc]
      group
    have hcard := CFSG.HardMathSupport.Timmesfeld.SporadicBalance.card_centralizer_conj_eq
      (c k * g⁻¹) s
    rw [hcs, hC] at hcard
    rw [← hcard]
    exact hB k

end Census

