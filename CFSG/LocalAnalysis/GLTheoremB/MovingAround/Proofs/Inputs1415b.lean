theorem centNoAlt_of_perm {n p m : ℕ} (hp : p.Prime) (P : Subgroup (Equiv.Perm (Fin n)))
    (h : ∀ x ∈ P, orderOf x = p → ¬ p * Nat.card (alternatingGroup (Fin m)) ∣
      Nat.card ↥(Subgroup.centralizer ({x} : Set (Equiv.Perm (Fin n))) ⊓ P)) :
    CentNoAlt p m ↥P := by
