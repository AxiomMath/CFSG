theorem two_lt_kLevel_alt (hnl : Prop1116Design.InputAltNotLie) (hOrd : SporadicOrdersTable)
    {p m : ℕ} (hm : 5 ≤ m) (hm5 : m ≠ 5) (hm6 : m ≠ 6) (hm8 : m ≠ 8)
    (hk2 : ¬ ((p = 3 ∧ (m = 5 ∨ m = 9)) ∨ (p = 7 ∧ m = 7)))
    (hspor : ∀ s : TauCeti.SporadicName, m.factorial / 2 ≠ sporOrd s) :
    2 < kLevel p (alternatingGroup (Fin m)) := by
  have hC : ¬ IsChevSimple p (alternatingGroup (Fin m)) := fun h => by
    rcases alt_chev_degree hnl hm (MulEquiv.refl _) h with h | h | h <;> omega
  have hK2 : ¬ catalogIs (alternatingGroup (Fin m)) (k2 p) := by
    rintro ⟨i, hi, ⟨g⟩⟩
    cases i with
    | cyclic q hq => exact hi.elim
    | alternating n hn =>
      have hmn : m = n := Prop1116Design.alt_iso_degree hm hn g
      subst hmn
      exact hk2 hi
    | lie idx => exact (hnl m idx hm).false g
    | sporadic t =>
      have h1 := Nat.card_congr g.toEquiv
      rw [card_alt m (by omega), hOrd t] at h1
      exact hspor t h1
  unfold kLevel
  rw [if_neg hC, if_neg hK2]
  split_ifs <;> omega

theorem sporNoAltDown_of_downLe {p m : ℕ} (hp : p.Prime) {name : TauCeti.SporadicName}
    [Finite (TauCeti.CFSGIndex.sporadic name).Group]
    (hD : CFSG.LocalAnalysis.GLTheoremA.DownLe p 2 (TauCeti.CFSGIndex.sporadic name).Group)
    (hlev : 2 < kLevel p (alternatingGroup (Fin m))) : SporNoAltDown p m name := by
  intro T _ _ ⟨f⟩ s hs I hI
  refine ⟨fun e => ?_⟩
  obtain ⟨hI', ⟨g⟩⟩ := comp_transport hp f hI
  have hs' : f s ^ p = 1 := by rw [← map_pow, ← hs, pow_orderOf_eq_one, map_one]
  have hα : MulAut.conj (f s) ^ p = 1 := by rw [← map_pow, hs', map_one]
  have h := hD (MulAut.conj (f s)) hα (I.map f.toMonoidHom) (by rw [fixSubgroup_conj]; exact hI')
  rw [CFSG.LocalAnalysis.GLTheoremA.KDSpor.kLevel_congr (g.symm.trans e) p] at h
  omega

theorem factorial_ne_sporOrd {m : ℕ} (hm : m = 7 ∨ m = 9) (s : TauCeti.SporadicName) :
    m.factorial / 2 ≠ sporOrd s := by
  rcases hm with rfl | rfl <;> cases s <;>
    simp [sporOrd, Nat.factorial, orderJ3, orderJ4, orderRu, orderON, orderCo1, orderFi23,
      orderFi24Prime, orderHN, orderLy, orderTh, orderBabyMonster, orderMonster]

theorem sporNoAltDown_large (hOrd : SporadicOrdersTable) {p : ℕ} (hp : p.Prime) (hp17 : 17 ≤ p)
    (name : TauCeti.SporadicName) : SporNoAltDown p (p + 2) name := by
  refine sporNoAltDown_of_not_dvd hOrd hp (by omega) ?_
  intro hd
  have hpos : 0 < sporOrd name := by
    cases name <;> simp [sporOrd, orderJ3, orderJ4, orderRu, orderON, orderCo1, orderFi23,
      orderFi24Prime, orderHN, orderLy, orderTh, orderBabyMonster, orderMonster]
  have hle : p * ((p + 2).factorial / 2) ≤ sporOrd name := Nat.le_of_dvd hpos hd
  have hM : sporOrd name ≤ 808017424794512875886459904961710757005754368000000000 := by
    cases name <;> simp [sporOrd, orderJ3, orderJ4, orderRu, orderON, orderCo1, orderFi23,
      orderFi24Prime, orderHN, orderLy, orderTh, orderBabyMonster, orderMonster]
  have hp42 : p ≤ 42 := by
    by_contra h
    have h45 : (45 : ℕ).factorial / 2 ≤ (p + 2).factorial / 2 :=
      Nat.div_le_div_right (Nat.factorial_le (by omega))
    have h45' : (45 : ℕ).factorial / 2 =
        59811110432740097280981580747828857532191866880000000000 := by
      norm_num [Nat.factorial]
    have : (p + 2).factorial / 2 ≤ p * ((p + 2).factorial / 2) := Nat.le_mul_of_pos_left _ hp.pos
    omega
  have hpf : p ∣ (p + 2).factorial / 2 := by
    have h1 : p ∣ (p + 2).factorial := Nat.dvd_factorial hp.pos (by omega)
    have h2 : 2 ∣ (p + 2).factorial := Nat.dvd_factorial (by norm_num) (by omega)
    have h3 : (p + 2).factorial = 2 * ((p + 2).factorial / 2) := (Nat.mul_div_cancel' h2).symm
    rw [h3] at h1
    exact (Nat.Coprime.dvd_of_dvd_mul_left
      ((Nat.coprime_primes hp Nat.prime_two).2 (by omega)) h1)
  have hsq : p ^ 2 ∣ sporOrd name := by
    rw [sq]
    exact (Nat.mul_dvd_mul_left p hpf).trans hd
  clear hd hle hpf
  interval_cases p <;> first
    | (revert hp; norm_num; done)
    | (revert hsq; cases name <;> decide)

