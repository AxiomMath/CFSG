variable {H : Type} [Group H] [Finite H]

noncomputable def conjOnNormal (P : Subgroup H) (hP : P.Normal) (g : H) : MulAut P where
  toFun r := ⟨g * (r : H) * g⁻¹, hP.conj_mem (r : H) r.2 g⟩
  invFun r := ⟨g⁻¹ * (r : H) * g⁻¹⁻¹, hP.conj_mem (r : H) r.2 g⁻¹⟩
  left_inv r := Subtype.ext (by simp [mul_assoc])
  right_inv r := Subtype.ext (by simp [mul_assoc])
  map_mul' r s := Subtype.ext (by simp [mul_assoc])

noncomputable def conjHom (P : Subgroup H) (hP : P.Normal) : H →* MulAut P where
  toFun := conjOnNormal P hP
  map_one' := MulEquiv.ext fun r => Subtype.ext (by simp [conjOnNormal])
  map_mul' g h := MulEquiv.ext fun r => Subtype.ext (by simp [conjOnNormal, mul_assoc])

theorem centralize_of_thompson {P : Subgroup H} (hP : P.Normal) (hP3 : IsPGroup 3 ↥P)
    {x : H} (hx : x ^ 3 = 1) {Y : Subgroup H} (hY3 : ¬ 3 ∣ Nat.card Y)
    (hYx : ∀ y ∈ Y, y * x = x * y)
    (hfix : ∀ y ∈ Y, ∀ r ∈ P, x * r * x⁻¹ = r → y * r * y⁻¹ = r) :
    ∀ y ∈ Y, ∀ r ∈ P, y * r * y⁻¹ = r := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hB3 : IsPGroup 3 ↥(Subgroup.zpowers x) := by
    rw [IsPGroup.iff_card, Nat.card_zpowers]
    obtain h1 | h3 := (Nat.dvd_prime Nat.prime_three).1 (orderOf_dvd_of_pow_eq_one hx)
    · exact ⟨0, by rw [h1]; simp⟩
    · exact ⟨1, by rw [h3]; simp⟩
  let α : ↥Y →* MulAut ↥P := (conjHom P hP).comp Y.subtype
  let β : ↥(Subgroup.zpowers x) →* MulAut ↥P := (conjHom P hP).comp (Subgroup.zpowers x).subtype
  have hcomm : ∀ a b, α a * β b = β b * α a := by
    intro a b
    have hab : (a : H) * (b : H) = (b : H) * (a : H) := by
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 b.2
      have hc : Commute (a : H) x := hYx a a.2
      have := (hc.zpow_right k)
      rw [hk] at this
      exact this.eq
    apply MulEquiv.ext
    intro r
    apply Subtype.ext
    simp only [MulAut.mul_apply, α, β, MonoidHom.comp_apply, MonoidHom.coe_comp, Function.comp_apply,
      Subgroup.coe_subtype, conjHom, MonoidHom.coe_mk, OneHom.coe_mk, conjOnNormal, MulEquiv.coe_mk,
      Equiv.coe_fn_mk, Subgroup.coe_mul, Subgroup.coe_inv]
    calc (a : H) * ((b : H) * (r : H) * (b : H)⁻¹) * (a : H)⁻¹
        = ((a : H) * (b : H)) * (r : H) * ((a : H) * (b : H))⁻¹ := by group
      _ = ((b : H) * (a : H)) * (r : H) * ((b : H) * (a : H))⁻¹ := by rw [hab]
      _ = (b : H) * ((a : H) * (r : H) * (a : H)⁻¹) * (b : H)⁻¹ := by group
  have hfix' : ∀ (a : ↥Y) (r : ↥P), (∀ b : ↥(Subgroup.zpowers x), β b r = r) → α a r = r := by
    intro a r hr
    have hxr : x * (r : H) * x⁻¹ = (r : H) := by
      have h1 := congrArg (fun s : ↥P => (s : H)) (hr ⟨x, Subgroup.mem_zpowers x⟩)
      simpa [β, conjHom, conjOnNormal, mul_assoc] using h1
    apply Subtype.ext
    simpa [α, conjHom, conjOnNormal] using hfix a a.2 r r.2 hxr
  have key := CFSG.GroupTheory.thompson_A_times_B (p := 3) hP3 hY3 hB3 α β hcomm hfix'
  intro y hy r hr
  have h1 := congrArg (fun s : MulAut ↥P => ((s ⟨r, hr⟩ : ↥P) : H)) (key ⟨y, hy⟩)
  simpa [α, conjHom, conjOnNormal] using h1


theorem centralizer_pCore_le_of_layer (hO : GLAPPrimeCore 3 H = ⊥)
    (hL : GLAPLayer 3 (⊤ : Subgroup H) = ⊥) :
    ∀ g : H, (∀ r ∈ CFSG.pCore 3 H, g * r = r * g) → g ∈ CFSG.pCore 3 H := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have h1 := CFSG.HardMathSupport.Solomon.LocalBalance.l28b_glaPLayer_top_eq_layer
    (p := 3) Nat.prime_three hO
  have hlay : CFSG.layer H = ⊥ := by
    rw [CFSG.layer_eq_componentClassification H, ← h1, hL]
  have hchar : CFSG.IsCharacteristicP 3 H :=
    CFSG.isCharacteristicP_of_pPrimeCore_eq_bot_of_layer_eq_bot H 3 hO hlay
  intro g hcomm
  apply hchar
  rw [Subgroup.mem_centralizer_iff]
  intro r hr
  exact (hcomm r hr).symm

theorem isPGroup_three_of_le {N M : Subgroup H} (hNM : N ≤ M) (hM : IsPGroup 3 ↥M) :
    IsPGroup 3 ↥N := by
  intro g
  obtain ⟨k, hk⟩ := hM ⟨(g : H), hNM g.2⟩
  refine ⟨k, Subtype.ext ?_⟩
  have := congrArg (fun s : ↥M => (s : H)) hk
  simpa using this

theorem le_pCoreOf_three {C N : Subgroup H} (hNC : N ≤ C) (hNn : (N.subgroupOf C).Normal)
    (hNp : IsPGroup 3 ↥N) : N ≤ CFSG.Open.pCoreOf 3 C := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hNp' : IsPGroup 3 ↥(N.subgroupOf C) := by
    intro g
    obtain ⟨k, hk⟩ := hNp ⟨((g : C) : H), Subgroup.mem_subgroupOf.1 g.2⟩
    refine ⟨k, Subtype.ext (Subtype.ext ?_)⟩
    have := congrArg (fun s : ↥N => (s : H)) hk
    simpa using this
  have hle : N.subgroupOf C ≤ CFSG.pCore 3 ↥C := le_sSup ⟨hNn, hNp'⟩
  calc N = (N.subgroupOf C).map C.subtype := by
          rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.2 hNC]
    _ ≤ (CFSG.pCore 3 ↥C).map C.subtype := Subgroup.map_mono hle
    _ = CFSG.Open.pCoreOf 3 C := rfl

theorem solv_core (hO : GLAPPrimeCore 3 H = ⊥) (hL : GLAPLayer 3 (⊤ : Subgroup H) = ⊥)
    (x : H) (hx : x ^ 3 = 1) :
    GLAPLayer 3 (Subgroup.centralizer ({x} : Set H)) = ⊥ ∧
      GLAPPrimeCoreOf 3 (Subgroup.centralizer ({x} : Set H)) = ⊥ := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hcon := centralizer_pCore_le_of_layer hO hL
  have hPn : (CFSG.pCore 3 H).Normal := CFSG.pCore_normal (p := 3)
  have hPp : IsPGroup 3 ↥(CFSG.pCore 3 H) := CFSG.pCore_isPGroup (p := 3)
  set P : Subgroup H := CFSG.pCore 3 H with hPdef
  set C : Subgroup H := Subgroup.centralizer ({x} : Set H) with hCdef
  have hxC : ∀ c ∈ C, c * x = x * c := fun c hc => Subgroup.mem_centralizer_singleton_iff.1 hc
  have hCx : ∀ c : H, c * x = x * c → c ∈ C :=
    fun c hc => Subgroup.mem_centralizer_singleton_iff.2 hc
  have hconjC : ∀ c ∈ C, ∀ k ∈ C, c * k * c⁻¹ ∈ C := by
    intro c hc k hk
    have hc1 : c * x = x * c := hxC c hc
    have hk1 : k * x = x * k := hxC k hk
    have hcinv : c⁻¹ * x = x * c⁻¹ := by
      calc c⁻¹ * x = c⁻¹ * (x * c) * c⁻¹ := by group
        _ = c⁻¹ * (c * x) * c⁻¹ := by rw [hc1]
        _ = x * c⁻¹ := by group
    apply hCx
    calc c * k * c⁻¹ * x = c * k * (c⁻¹ * x) := by group
      _ = c * k * (x * c⁻¹) := by rw [hcinv]
      _ = c * (k * x) * c⁻¹ := by group
      _ = c * (x * k) * c⁻¹ := by rw [hk1]
      _ = (c * x) * k * c⁻¹ := by group
      _ = (x * c) * k * c⁻¹ := by rw [hc1]
      _ = x * (c * k * c⁻¹) := by group
  have hPCconj : ∀ c ∈ C, ∀ r ∈ P ⊓ C, c * r * c⁻¹ ∈ P ⊓ C := fun c hc r hr =>
    ⟨hPn.conj_mem r hr.1 c, hconjC c hc r hr.2⟩
  set Y : Subgroup H := GLAPPrimeCoreOf 3 C with hYdef
  have hYC : Y ≤ C := GLAPPrimeCoreOf_le C
  have hYnorm : ∀ c ∈ C, ∀ y ∈ Y, c * y * c⁻¹ ∈ Y := fun c hc y hy =>
    GLAPPrimeCoreOf_conj_mem c hc y hy
  have hY3 : Nat.Coprime 3 (Nat.card Y) := coprime_card_GLAPPrimeCoreOf Nat.prime_three C
  have hYP : Y ⊓ P = ⊥ := by
    have hc : Nat.Coprime (Nat.card Y) (Nat.card P) := by
      obtain ⟨n, hn⟩ := (IsPGroup.iff_card.mp hPp)
      rw [hn]
      exact Nat.Coprime.pow_right n hY3.symm
    exact disjoint_iff.mp (Subgroup.disjoint_of_coprime_natCard hc)
  have hYcent : ∀ y ∈ Y, ∀ r ∈ P ⊓ C, y * r = r * y := by
    intro y hy r hr
    have h1 : y * (r * y⁻¹ * r⁻¹) ∈ Y := Y.mul_mem hy (by
      have := hYnorm r hr.2 y⁻¹ (Y.inv_mem hy)
      simpa [mul_assoc] using this)
    have h2 : y * r * y⁻¹ * r⁻¹ ∈ P :=
      P.mul_mem (hPn.conj_mem r hr.1 y) (P.inv_mem hr.1)
    have h3 : y * r * y⁻¹ * r⁻¹ ∈ Y ⊓ P := ⟨by simpa [mul_assoc] using h1, h2⟩
    rw [hYP, Subgroup.mem_bot] at h3
    calc y * r = (y * r * y⁻¹ * r⁻¹) * (r * y) := by group
      _ = r * y := by rw [h3, one_mul]
  have hYnot3 : ¬ 3 ∣ Nat.card Y := fun h => by
    have := Nat.Coprime.eq_one_of_dvd hY3 h
    norm_num at this
  have hYbot : Y = ⊥ := by
    have hA := centralize_of_thompson hPn hPp hx hYnot3
      (fun y hy => (hxC y (hYC hy)))
      (fun y hy r hr hxr => by
        have hrC : r ∈ C := hCx r (by
          have : x * (r : H) * x⁻¹ = r := hxr
          calc r * x = (x * r * x⁻¹) * x := by rw [this]
            _ = x * r := by group)
        have hc := hYcent y hy r ⟨hr, hrC⟩
        calc y * r * y⁻¹ = (r * y) * y⁻¹ := by rw [hc]
          _ = r := by group)
    rw [eq_bot_iff]
    intro y hy
    have hyP : y ∈ P := hcon y (fun r hr => by
      have := hA y hy r hr
      calc y * r = (y * r * y⁻¹) * y := by group
        _ = r * y := by rw [this])
    have hyY : y ∈ Y ⊓ P := ⟨hy, hyP⟩
    rw [hYP, Subgroup.mem_bot] at hyY
    exact Subgroup.mem_bot.2 hyY
  set K0 : Subgroup H := C ⊓ Subgroup.centralizer ((P ⊓ C : Subgroup H) : Set H) with hK0def
  have hK0C : K0 ≤ C := inf_le_left
  have hK0cent : ∀ k ∈ K0, ∀ r ∈ P ⊓ C, k * r = r * k := by
    intro k hk r hr
    exact ((Subgroup.mem_centralizer_iff.1 hk.2) r hr).symm
  have hK0norm : ∀ c ∈ C, ∀ k ∈ K0, c * k * c⁻¹ ∈ K0 := by
    intro c hc k hk
    refine ⟨hconjC c hc k hk.1, Subgroup.mem_centralizer_iff.2 ?_⟩
    intro r hr
    have hcr : c⁻¹ * r * c ∈ P ⊓ C := by
      have := hPCconj c⁻¹ (C.inv_mem hc) r hr
      simpa [mul_assoc] using this
    have hk' := hK0cent k hk (c⁻¹ * r * c) hcr
    calc r * (c * k * c⁻¹) = c * ((c⁻¹ * r * c) * k) * c⁻¹ := by group
      _ = c * (k * (c⁻¹ * r * c)) * c⁻¹ := by rw [hk']
      _ = (c * k * c⁻¹) * r := by group
  have hK0_3 : IsPGroup 3 ↥K0 := by
    rw [IsPGroup.iff_card]
    refine ⟨_, Nat.eq_prime_pow_of_unique_prime_dvd ?_ ?_⟩
    · exact Nat.card_pos.ne'
    · intro d hd hdvd
      by_contra hne
      haveI : Fact d.Prime := ⟨hd⟩
      obtain ⟨c, hc⟩ := exists_prime_orderOf_dvd_card' d hdvd
      have hc0K0 : (c : H) ∈ K0 := c.2
      set c0 : H := (c : H) with hc0def
      have hord : orderOf c0 = d := by rw [hc0def, Subgroup.orderOf_coe]; exact hc
      have hc0C : c0 ∈ C := hK0C hc0K0
      have hZ3 : ¬ 3 ∣ Nat.card (Subgroup.zpowers c0) := by
        rw [Nat.card_zpowers, hord]
        intro h3
        exact hne ((Nat.prime_dvd_prime_iff_eq Nat.prime_three hd).1 h3).symm
      have hZK0 : Subgroup.zpowers c0 ≤ K0 := Subgroup.zpowers_le.2 hc0K0
      have hA := centralize_of_thompson hPn hPp hx hZ3
        (fun y hy => by
          obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
          exact (show Commute c0 x from hxC c0 hc0C).zpow_left k)
        (fun y hy r hr hxr => by
          have hrC : r ∈ C := hCx r (by
            calc r * x = (x * r * x⁻¹) * x := by rw [hxr]
              _ = x * r := by group)
          have hyK0 : y ∈ K0 := hZK0 hy
          have hc := hK0cent y hyK0 r ⟨hr, hrC⟩
          calc y * r * y⁻¹ = (r * y) * y⁻¹ := by rw [hc]
            _ = r := by group)
      have hc0P : c0 ∈ P := by
        apply hcon c0
        intro r hr
        have := hA c0 (Subgroup.mem_zpowers c0) r hr
        calc c0 * r = (c0 * r * c0⁻¹) * c0 := by group
          _ = r * c0 := by rw [this]
      obtain ⟨k, hk⟩ := hPp ⟨c0, hc0P⟩
      have hk' : c0 ^ 3 ^ k = 1 := by
        have := congrArg Subtype.val hk
        simpa using this
      have hdvd3 : d ∣ 3 ^ k := hord ▸ orderOf_dvd_of_pow_eq_one hk'
      have hd3 : d ∣ 3 := hd.dvd_of_dvd_pow hdvd3
      exact hne ((Nat.prime_dvd_prime_iff_eq hd Nat.prime_three).1 hd3)
  have hPC_le : P ⊓ C ≤ CFSG.Open.pCoreOf 3 C := by
    apply le_pCoreOf_three inf_le_right
    · constructor
      intro n hn g
      rw [Subgroup.mem_subgroupOf] at hn ⊢
      have := hPCconj g.1 g.2 n hn
      simpa using this
    · exact isPGroup_three_of_le inf_le_left hPp
  have hK0_le : K0 ≤ CFSG.Open.pCoreOf 3 C := by
    apply le_pCoreOf_three hK0C
    · constructor
      intro n hn g
      rw [Subgroup.mem_subgroupOf] at hn ⊢
      have := hK0norm g.1 g.2 n hn
      simpa using this
    · exact hK0_3
  have hcentral : ∀ c ∈ C, (∀ y ∈ CFSG.Open.pCoreOf 3 C, c * y = y * c) →
      c ∈ CFSG.Open.pCoreOf 3 C := by
    intro c hc hcy
    apply hK0_le
    refine ⟨hc, Subgroup.mem_centralizer_iff.2 ?_⟩
    intro r hr
    exact (hcy r (hPC_le hr)).symm
  have hPCp : IsPGroup 3 ↥(CFSG.Open.pCoreOf 3 C) := by
    intro g
    obtain ⟨s, hs, hsg⟩ := Subgroup.mem_map.1 g.2
    obtain ⟨k, hk⟩ := (CFSG.pCore_isPGroup (p := 3) (G := ↥C)) ⟨s, hs⟩
    refine ⟨k, Subtype.ext ?_⟩
    have h1 : ((s ^ 3 ^ k : ↥C) : H) = 1 := by
      have := congrArg (fun t : ↥(CFSG.pCore 3 ↥C) => ((t : ↥C) : H)) hk
      simpa using this
    rw [Subgroup.coe_pow, Subgroup.coe_one, ← hsg]
    simpa using h1
  have hPCpn : ((CFSG.Open.pCoreOf 3 C).subgroupOf C).Normal := by
    constructor
    intro n hn g
    rw [Subgroup.mem_subgroupOf] at hn ⊢
    obtain ⟨s, hs, hsn⟩ := Subgroup.mem_map.1 hn
    have hs' : g * s * g⁻¹ ∈ CFSG.pCore 3 ↥C := (CFSG.pCore_normal (p := 3)).conj_mem s hs g
    unfold CFSG.Open.pCoreOf
    refine Subgroup.mem_map.2 ⟨g * s * g⁻¹, hs', ?_⟩
    rw [map_mul, map_mul, map_inv, hsn]
    simp
  have hnc := CFSG.HardMathSupport.Dickson.DefCharOuter.Export.noComponent_of_pConstrained
    Nat.prime_three hYbot (Subgroup.map_subtype_le _) hPCpn hPCp hcentral
  refine ⟨?_, hYbot⟩
  show sSup {L : Subgroup H | GLAPComponent 3 C L} = ⊥
  exact sSup_eq_bot.2 fun L hL => (hnc L hL).elim

end Solvable

section Bridge

variable {G : Type} [Group G] [Finite G] {m p : ℕ} {B M E A : Subgroup G} {a : G} {K : Subgroup G}

theorem tildeCore_solvable (h : Cex117 G m p B M E A a K) (hp : p = 3) (e : G) (he : e ∈ M)
    (heEA : e ∈ E ⊓ A) (he1 : e ≠ 1)
    (hL : GLAPLayer 3 (⊤ : Subgroup (↥M ⧸ GLAPPrimeCore 3 ↥M)) = ⊥) :
    GLAPLayer 3 (Subgroup.centralizer ({QuotientGroup.mk' (GLAPPrimeCore 3 ↥M) (⟨e, he⟩ : ↥M)} :
        Set (↥M ⧸ GLAPPrimeCore 3 ↥M))) = ⊥ ∧
      GLAPPrimeCoreOf 3 (Subgroup.centralizer ({QuotientGroup.mk' (GLAPPrimeCore 3 ↥M) (⟨e, he⟩ : ↥M)} :
        Set (↥M ⧸ GLAPPrimeCore 3 ↥M))) = ⊥ := by
  subst hp
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hE3 : IsElemAbelian 3 E := h.pair.1.1.1.1.2.1
  have he3 : e ^ 3 = 1 := hE3.2 e heEA.1
  have ht3 : (⟨e, he⟩ : ↥M) ^ 3 = 1 := Subtype.ext he3
  have hx : (QuotientGroup.mk' (GLAPPrimeCore 3 ↥M) (⟨e, he⟩ : ↥M)) ^ 3 = 1 := by
    rw [← map_pow, ht3, map_one]
  have hO : GLAPPrimeCore 3 (↥M ⧸ GLAPPrimeCore 3 ↥M) = ⊥ :=
    CFSG.GH74.pPrimeCore_quotient_pPrimeCore_eq_bot ↥M 3
  exact solv_core hO hL _ hx

end Bridge

section Nonsolvable

open CFSG.HardMathSupport.Solomon.Coordinator (IsChevOfChar)

@[expose] def Input13_4 : Prop :=
  ∀ (K : Type) [Group K] [Finite K] (H' : Type) [Group H'] [Finite H'] (φ : H' →* MulAut K),
    CFSG.Open.IsQuasisimple K → IsChevOfChar 3 (K ⧸ Subgroup.center K) →
    Function.Injective φ → (MulAut.conj : K →* MulAut K).range ≤ φ.range →
    ∀ (x : H') (k : K), x ^ 3 = 1 → x ≠ 1 → k ^ 3 = 1 → φ x = MulAut.conj k →
      GLAPLayer 3 (Subgroup.normalizer ((Subgroup.zpowers x : Subgroup H') : Set H')) = ⊥ ∧
        GLAPPrimeCoreOf 3 (Subgroup.normalizer ((Subgroup.zpowers x : Subgroup H') : Set H')) = ⊥

variable {H : Type} [Group H] [Finite H]

theorem commute_of_mem_zpowers {c x y : H} (hc : c * x = x * c) (hy : y ∈ Subgroup.zpowers x) :
    c * y = y * c := by
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
  exact ((show Commute c x from hc).zpow_right k).eq

theorem centralizer_le_normalizer_zpowers (x : H) :
    Subgroup.centralizer ({x} : Set H) ≤
      Subgroup.normalizer ((Subgroup.zpowers x : Subgroup H) : Set H) := by
  intro c hc
  have hcx : c * x = x * c := Subgroup.mem_centralizer_singleton_iff.1 hc
  have hcx' : c⁻¹ * x = x * c⁻¹ := by
    calc c⁻¹ * x = c⁻¹ * (x * c) * c⁻¹ := by group
      _ = c⁻¹ * (c * x) * c⁻¹ := by rw [hcx]
      _ = x * c⁻¹ := by group
  rw [Subgroup.mem_normalizer_iff]
  intro h
  constructor
  · intro hh
    have heq : c * h * c⁻¹ = h := by
      rw [commute_of_mem_zpowers hcx hh]; group
    rw [heq]; exact hh
  · intro hh
    have hy := commute_of_mem_zpowers hcx' hh
    have heq : h = c * h * c⁻¹ := by
      calc h = c⁻¹ * (c * h * c⁻¹) * c := by group
        _ = ((c * h * c⁻¹) * c⁻¹) * c := by rw [hy]
        _ = c * h * c⁻¹ := by group
    rw [heq]; exact hh

theorem centralizer_normal_in_normalizer (x : H) :
    ((Subgroup.centralizer ({x} : Set H)).subgroupOf
      (Subgroup.normalizer ((Subgroup.zpowers x : Subgroup H) : Set H))).Normal := by
  constructor
  intro n hn g
  rw [Subgroup.mem_subgroupOf, Subgroup.mem_centralizer_singleton_iff] at hn ⊢
  simp only [Subgroup.coe_mul, Subgroup.coe_inv]
  have hginv : (g : H)⁻¹ ∈ Subgroup.normalizer ((Subgroup.zpowers x : Subgroup H) : Set H) :=
    Subgroup.inv_mem _ g.2
  have hyz : (g : H)⁻¹ * x * (g : H) ∈ Subgroup.zpowers x := by
    have := (Subgroup.mem_normalizer_iff.1 hginv x).1 (Subgroup.mem_zpowers x)
    simpa [mul_assoc] using this
  have hny := commute_of_mem_zpowers hn hyz
  calc (g : H) * n * (g : H)⁻¹ * x
      = (g : H) * ((n : H) * ((g : H)⁻¹ * x * (g : H))) * (g : H)⁻¹ := by group
    _ = (g : H) * (((g : H)⁻¹ * x * (g : H)) * n) * (g : H)⁻¹ := by rw [hny]
    _ = x * ((g : H) * n * (g : H)⁻¹) := by group

theorem nonsolv_core (I13 : Input13_4) (L : Subgroup H) (hL : L.Normal)
    (hK : CFSG.Open.IsQuasisimple ↥L) (hKc : IsChevOfChar 3 (↥L ⧸ Subgroup.center ↥L))
    (hfaith : ∀ g : H, (∀ l ∈ L, g * l = l * g) → g = 1)
    (x : H) (hxL : x ∈ L) (hx : x ^ 3 = 1) (hx1 : x ≠ 1) :
    GLAPLayer 3 (Subgroup.centralizer ({x} : Set H)) = ⊥ ∧
      GLAPPrimeCoreOf 3 (Subgroup.centralizer ({x} : Set H)) = ⊥ := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hinj : Function.Injective (conjHom L hL) := by
    rw [injective_iff_map_eq_one]
    intro g hg
    apply hfaith
    intro l hl
    have h1 := congrArg (fun σ : MulAut ↥L => ((σ ⟨l, hl⟩ : ↥L) : H)) hg
    simp only [conjHom, MonoidHom.coe_mk, OneHom.coe_mk, conjOnNormal, MulEquiv.coe_mk,
      Equiv.coe_fn_mk, MulAut.one_apply, Subgroup.coe_mul, Subgroup.coe_inv] at h1
    calc g * l = (g * l * g⁻¹) * g := by group
      _ = l * g := by rw [h1]
  have hX : (MulAut.conj : ↥L →* MulAut ↥L).range ≤ (conjHom L hL).range := by
    rintro σ ⟨k, rfl⟩
    refine ⟨(k : H), MulEquiv.ext fun r => Subtype.ext ?_⟩
    simp [conjHom, conjOnNormal, MulAut.conj_apply, mul_assoc]
  let k0 : ↥L := ⟨x, hxL⟩
  have hk0 : k0 ^ 3 = 1 := Subtype.ext (by simp [k0, hx])
  have hφx : conjHom L hL x = MulAut.conj k0 :=
    MulEquiv.ext fun r => Subtype.ext (by simp [conjHom, conjOnNormal, MulAut.conj_apply, k0, mul_assoc])
  obtain ⟨hNL, hNC⟩ := I13 ↥L H (conjHom L hL) hK hKc hinj hX x k0 hx hx1 hk0 hφx
  have hCN := centralizer_le_normalizer_zpowers x
  have hCnorm := centralizer_normal_in_normalizer x
  have hsub : CFSG.Open.IsSubnormal (Subgroup.centralizer ({x} : Set H))
      (Subgroup.normalizer ((Subgroup.zpowers x : Subgroup H) : Set H)) :=
    CFSG.Open.IsSubnormal.step hCN hCnorm (CFSG.Open.IsSubnormal.refl _)
  constructor
  · have h1 := CFSG.HardMathSupport.Solomon.LocalBalance.l28b_glaPLayer_le_of_normal
      Nat.prime_three hCN hCnorm
    rw [hNL] at h1
    exact le_bot_iff.1 h1
  · have h1 := CFSG.LocalAnalysis.GLTheoremB.glaPPrimeCoreOf_le_of_isSubnormal Nat.prime_three hsub
    rw [hNC] at h1
    exact le_bot_iff.1 h1

end Nonsolvable

section Assembly

open CFSG.HardMathSupport.Solomon.Coordinator (IsChevOfChar)

variable {G : Type} [Group G] [Finite G] {m p : ℕ} {B M E A : Subgroup G} {a : G} {K : Subgroup G}

theorem tilde_facts (h : Cex117 G m p B M E A a K) (hp : p = 3) (e : G) (he : e ∈ M)
    (heEA : e ∈ E ⊓ A) (he1 : e ≠ 1) :
    (QuotientGroup.mk' (GLAPPrimeCore 3 ↥M) (⟨e, he⟩ : ↥M)) ^ 3 = 1 ∧
      QuotientGroup.mk' (GLAPPrimeCore 3 ↥M) (⟨e, he⟩ : ↥M) ≠ 1 := by
  subst hp
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hE3 : IsElemAbelian 3 E := h.pair.1.1.1.1.2.1
  have he3 : e ^ 3 = 1 := hE3.2 e heEA.1
  have ht3 : (⟨e, he⟩ : ↥M) ^ 3 = 1 := Subtype.ext he3
  have ht1 : (⟨e, he⟩ : ↥M) ≠ 1 := fun h1 => he1 (congrArg Subtype.val h1)
  refine ⟨by rw [← map_pow, ht3, map_one], fun hx1 => ?_⟩
  have hmem : (⟨e, he⟩ : ↥M) ∈ GLAPPrimeCore 3 ↥M := (QuotientGroup.eq_one_iff _).1 hx1
  have hord : orderOf (⟨e, he⟩ : ↥M) = 3 := orderOf_eq_prime ht3 ht1
  have hdvd : Nat.card (Subgroup.zpowers (⟨e, he⟩ : ↥M)) ∣ Nat.card (GLAPPrimeCore 3 ↥M) :=
    Subgroup.card_dvd_of_le (Subgroup.zpowers_le.2 hmem)
  rw [Nat.card_zpowers, hord] at hdvd
  exact absurd (Nat.Coprime.eq_one_of_dvd pPrimeCore_coprime_card hdvd) (by norm_num)

end Assembly

theorem layer_top_normal {H' : Type} [Group H'] [Finite H'] (hO : GLAPPrimeCore 3 H' = ⊥) :
    (GLAPLayer 3 (⊤ : Subgroup H')).Normal := by
  rw [CFSG.HardMathSupport.Solomon.LocalBalance.l28b_glaPLayer_top_eq_layer Nat.prime_three hO]
  exact CFSG.ComponentClassification.Layer.normal H'

open CFSG.HardMathSupport.Solomon.Coordinator (IsChevOfChar)

@[expose] def NonsolvQuasisimpleClaim : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (m p : ℕ) (B M E A : Subgroup G) (a : G) (K : Subgroup G),
    Cex117 G m p B M E A a K → p = 3 → ∀ (e : G) (he : e ∈ M), e ∈ E ⊓ A → e ≠ 1 →
    GLAPLayer 3 (⊤ : Subgroup (↥M ⧸ GLAPPrimeCore 3 ↥M)) ≠ ⊥ →
      CFSG.Open.IsQuasisimple ↥(GLAPLayer 3 (⊤ : Subgroup (↥M ⧸ GLAPPrimeCore 3 ↥M))) ∧
      QuotientGroup.mk' (GLAPPrimeCore 3 ↥M) (⟨e, he⟩ : ↥M) ∈
        GLAPLayer 3 (⊤ : Subgroup (↥M ⧸ GLAPPrimeCore 3 ↥M)) ∧
      ∀ g : ↥M ⧸ GLAPPrimeCore 3 ↥M,
        (∀ l ∈ GLAPLayer 3 (⊤ : Subgroup (↥M ⧸ GLAPPrimeCore 3 ↥M)), g * l = l * g) → g = 1

@[expose] def NonsolvChevClaim : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (m p : ℕ) (B M E A : Subgroup G) (a : G) (K : Subgroup G),
    Cex117 G m p B M E A a K → p = 3 → ∀ (e : G) (he : e ∈ M), e ∈ E ⊓ A → e ≠ 1 →
    GLAPLayer 3 (⊤ : Subgroup (↥M ⧸ GLAPPrimeCore 3 ↥M)) ≠ ⊥ →
      IsChevOfChar 3 (↥(GLAPLayer 3 (⊤ : Subgroup (↥M ⧸ GLAPPrimeCore 3 ↥M))) ⧸
        Subgroup.center ↥(GLAPLayer 3 (⊤ : Subgroup (↥M ⧸ GLAPPrimeCore 3 ↥M))))

theorem tildeCore_of_inputs (I13 : Input13_4) (hQ : NonsolvQuasisimpleClaim) (hC : NonsolvChevClaim) :
    Lemma1113.TildeCore := by
  intro G _ _ m p B M E A a K h hp e he heEA he1
  by_cases hL : GLAPLayer 3 (⊤ : Subgroup (↥M ⧸ GLAPPrimeCore 3 ↥M)) = ⊥
  · exact tildeCore_solvable h hp e he heEA he1 hL
  · have hO : GLAPPrimeCore 3 (↥M ⧸ GLAPPrimeCore 3 ↥M) = ⊥ := by
      haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
      exact CFSG.GH74.pPrimeCore_quotient_pPrimeCore_eq_bot ↥M 3
    obtain ⟨hq, hxL, hfaith⟩ := hQ G m p B M E A a K h hp e he heEA he1 hL
    have hchev := hC G m p B M E A a K h hp e he heEA he1 hL
    obtain ⟨hx3, hx1⟩ := tilde_facts h hp e he heEA he1
    exact nonsolv_core I13 _ (layer_top_normal hO) hq hchev hfaith _ hxL hx3 hx1

end CFSG.LocalAnalysis.GLTheoremB.MovingAround.Lemma1113b
