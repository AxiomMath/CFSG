theorem sl2At_outer_mem_of_three_excD4 (h3 : (3 : K) ≠ 0) {w : K} (hw3 : w ^ 3 = 1)
    (hwsum : 1 + w + w ^ 2 = 0) {H : Subgroup ↥(adjointGroup Tag.D4 K)}
    (F : K → K → K → ↥(adjointGroup Tag.D4 K))
    (hF : ∀ a b c a' b' c', F a b c * F a' b' c' = F (a + a') (b + b') (c + c'))
    (h0 : ∀ a, F a a a ∈ H) (h1 : ∀ a, F a (w ^ 2 * a) (w * a) ∈ H) (h2 : ∀ a, F a (w * a) (w ^ 2 * a) ∈ H)
    (c : K) : F c 0 0 ∈ H ∧ F 0 c 0 ∈ H ∧ F 0 0 c ∈ H := by
  set d := c / 3 with hd
  have hc : c = 3 * d := by rw [hd]; field_simp
  refine ⟨?_, ?_, ?_⟩
  · have e : F c 0 0 = F d d d * F d (w ^ 2 * d) (w * d) * F d (w * d) (w ^ 2 * d) := by
      rw [hF, hF]
      congr 1
      · rw [hc]; ring
      · linear_combination (-d) * hwsum
      · linear_combination (-d) * hwsum
    rw [e]
    exact H.mul_mem (H.mul_mem (h0 d) (h1 d)) (h2 d)
  · have e : F 0 c 0 = F d d d * F (w * d) (w ^ 2 * (w * d)) (w * (w * d)) *
        F (w ^ 2 * d) (w * (w ^ 2 * d)) (w ^ 2 * (w ^ 2 * d)) := by
      rw [hF, hF]
      congr 1
      · linear_combination (-d) * hwsum
      · rw [hc]; linear_combination (-2 * d) * hw3
      · linear_combination (-d) * hwsum + (-d * w) * hw3
    rw [e]
    exact H.mul_mem (H.mul_mem (h0 d) (h1 (w * d))) (h2 (w ^ 2 * d))
  · have e : F 0 0 c = F d d d * F (w ^ 2 * d) (w ^ 2 * (w ^ 2 * d)) (w * (w ^ 2 * d)) *
        F (w * d) (w * (w * d)) (w ^ 2 * (w * d)) := by
      rw [hF, hF]
      congr 1
      · linear_combination (-d) * hwsum
      · linear_combination (-d) * hwsum + (-d * w) * hw3
      · rw [hc]; linear_combination (-2 * d) * hw3
    rw [e]
    exact H.mul_mem (H.mul_mem (h0 d) (h1 (w ^ 2 * d))) (h2 (w * d))

theorem uniPlaneClosure_d4_graphShort_excD4 [Finite K] (h3 : (3 : K) ≠ 0) (ω : Kˣ) (hω3 : ω ^ 3 = 1)
    (hω1 : ω ≠ 1) {E : Subgroup (MulAut ↥(adjointGroup Tag.D4 K))} (hγE : d4Graph K 1 ∈ E)
    (hxE : MulAut.conj (sl2Short K (HSL ω)) ∈ E) : uniPlaneClosure (ringChar K) E = ⊤ := by
  classical
  set H := uniPlaneClosure (ringChar K) E with hH
  have hγ1 := d4Graph_one_ne_one_excD4 (K := K)
  have hγH : ∀ y, d4Graph K 1 y = y → y ^ ringChar K = 1 → y ∈ H := fun y hy hyr =>
    mem_uniPlaneClosure (n := 1) hγE hγ1 hy (by rw [pow_one]; exact hyr)
  have hconjH : ∀ ω' : Kˣ, ω' ^ 3 = 1 → MulAut.conj (sl2Short K (HSL ω')) ∈ E →
      ∀ y, d4Graph K 1 y = y → y ^ ringChar K = 1 →
        outerTripleExcD4 K (1, HSL ω', HSL (ω' ^ 2)) * y *
          (outerTripleExcD4 K (1, HSL ω', HSL (ω' ^ 2)))⁻¹ ∈ H := by
    intro ω' hω'3 hxE' y hy hyr
    set t := outerTripleExcD4 K (1, HSL ω', HSL (ω' ^ 2)) with ht
    have hβ := conj_sl2Short_mul_d4Graph_excD4 ω' hω'3
    rw [← ht] at hβ
    have hβE : MulAut.conj (sl2Short K (HSL ω')) * d4Graph K 1 ∈ E := E.mul_mem hxE' hγE
    have hβ1 : MulAut.conj (sl2Short K (HSL ω')) * d4Graph K 1 ≠ 1 := by
      rw [hβ]
      intro h
      apply hγ1
      have e : d4Graph K 1 =
          (MulAut.conj t)⁻¹ * (MulAut.conj t * d4Graph K 1 * (MulAut.conj t)⁻¹) * MulAut.conj t := by
        group
      rw [e, h]
      group
    refine mem_uniPlaneClosure (n := 1) hβE hβ1 ?_ ?_
    · rw [hβ, MulAut.mul_apply, MulAut.mul_apply]
      have h1 : (MulAut.conj t)⁻¹ (t * y * t⁻¹) = y := by
        rw [← map_inv, MulAut.conj_apply]
        group
      rw [h1, hy, MulAut.conj_apply]
    · rw [pow_one, conj_pow, hyr]
      group
  set w : K := (ω : K) with hw
  have hw3 : w ^ 3 = 1 := by rw [hw, ← Units.val_pow_eq_pow_val, hω3, Units.val_one]
  have hw1 : w ≠ 1 := fun h => hω1 (Units.ext h)
  have hwsum : 1 + w + w ^ 2 = 0 := by
    have e : (w - 1) * (1 + w + w ^ 2) = 0 := by linear_combination hw3
    rcases mul_eq_zero.1 e with h | h
    · exact absurd (sub_eq_zero.1 h) hw1
    · exact h
  have hw0 : w ≠ 0 := by
    intro h
    rw [h] at hw3
    norm_num at hw3
  have hwinv : w⁻¹ = w ^ 2 := inv_eq_of_mul_eq_one_right (by linear_combination hw3)
  have hω23 : (ω ^ 2) ^ 3 = 1 := by rw [← pow_mul, mul_comm, pow_mul, hω3, one_pow]
  have hx2E : MulAut.conj (sl2Short K (HSL (ω ^ 2))) ∈ E := by
    have e : HSL (ω ^ 2) = HSL ω * HSL ω := by rw [HSL_mul_excD4, sq]
