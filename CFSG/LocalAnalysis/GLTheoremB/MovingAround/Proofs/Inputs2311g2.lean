    rootCoord (FieldGraphFieldPointwise.single_pos
      (⟨0, by decide⟩ : Fin Tag.D4.rank)) (g : ModGL Tag.D4 K)) h1
  simp only [adjX] at h2
  rw [FieldGraphFieldPointwise.rootCoord_single_xUnit,
    FieldGraphFieldPointwise.rootCoord_single_xUnit] at h2
  simp at h2

theorem uniPlaneClosure_d4_graphLong_excD4 {K : Type} [Field K] [Finite K] (hK3 : 3 ≤ Nat.card K)
    {E : Subgroup (MulAut ↥(adjointGroup Tag.D4 K))} (hγE : d4Graph K 1 ∈ E) (A : SL2 K)
    (hAE : MulAut.conj (sl2At K ⟨2, by decide⟩ A) ∈ E) (hA1 : sl2At K ⟨2, by decide⟩ A ≠ 1) :
    uniPlaneClosure (ringChar K) E = ⊤ := by
  have hZ : Subgroup.center ↥(adjointGroup Tag.D4 K) = ⊥ := center_adjointGroup_eq_bot
  have hinj := CFSG.LieType.SeitzGeneration.conj_injective_of_center_eq_bot hZ
  have hc1 : MulAut.conj (sl2At K ⟨2, by decide⟩ A) ≠ 1 := fun h =>
    hA1 (hinj (h.trans (map_one _).symm))
  rw [eq_top_iff, ← closure_rElements_long_excD4 hK3 A, Subgroup.closure_le]
  rintro k (⟨hk, hkr⟩ | ⟨hk, hkr⟩)
  · refine mem_uniPlaneClosure (n := 1) hAE hc1 ?_ (by rw [pow_one]; exact hkr)
    rw [MulAut.conj_apply, ← (Subgroup.mem_centralizer_singleton_iff.1 hk), mul_inv_cancel_right]
  · exact mem_uniPlaneClosure (n := 1) hγE d4Graph_one_ne_one_excD4 hk (by rw [pow_one]; exact hkr)

theorem uniSeitzPlanes_dFour_graphLong :
    UniSeitzPlanes fun d _ E => d.1.characteristic ≠ 2 ∧ ∃ q : TauCeti.PrimePower, d.1 = .D 4 q ∧
      ∃ (K : Type) (_ : Field K) (_ : Finite K), Nat.card K = q.card ∧
        ∃ e : CFSG.LieType.SeitzGeneration.Cat d ≃* ↥(adjointGroup Tag.D4 K),
          ∃ A : Matrix.SpecialLinearGroup (Fin 2) K, sl2At K ⟨2, by decide⟩ A ≠ 1 ∧
            d4Graph K 1 ∈ E.map (MulAut.congr e).toMonoidHom ∧
            MulAut.conj (sl2At K ⟨2, by decide⟩ A) ∈ E.map (MulAut.congr e).toMonoidHom := by
  rintro ⟨d, hv⟩ p hp hp2 hpd hex E hE hc ⟨hchar2, q, rfl, K, _, _, hK, e, A, hA1, hγ, hAE⟩
  have hchar : (TauCeti.LieTypeIndex.D 4 q).characteristic = q.p := by
    simp [TauCeti.LieTypeIndex.characteristic_D]
  have hK' : Nat.card K = q.p ^ q.exponent := by rw [hK, TauCeti.PrimePower.card_def]
  haveI : CharP K q.p :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic q.prime_p
      q.exponent_pos hK'
  have hring : ringChar K = q.p := ringChar.eq K q.p
  have hq2 : q.p ≠ 2 := fun h => hchar2 (by rw [hchar, h])
  have hK3 : 3 ≤ Nat.card K := by
    rw [hK']
    have h3 : 3 ≤ q.p := by
      have := q.prime_p.two_le
      omega
    calc 3 ≤ q.p := h3
      _ = q.p ^ 1 := (pow_one _).symm
      _ ≤ q.p ^ q.exponent := Nat.pow_le_pow_right q.prime_p.pos q.exponent_pos
  have h := uniPlaneClosure_d4_graphLong_excD4 hK3 hγ A hAE hA1
  rw [hring] at h
  rw [hchar]
  exact (uniPlaneGen_map_congr e q.p E).1 h

