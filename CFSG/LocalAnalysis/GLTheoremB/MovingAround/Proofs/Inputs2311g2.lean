                MulAut.conj
                  (CFSG.LieType.SeitzGeneration.ExcWideThree.Parrott.D4Graph.sl2At K ⟨0, by decide⟩
                      (CFSG.LieType.Chevalley.HSL ω) *
                    CFSG.LieType.SeitzGeneration.ExcWideThree.Parrott.D4Graph.sl2At K ⟨1, by decide⟩
                      (CFSG.LieType.Chevalley.HSL ω) *
                    CFSG.LieType.SeitzGeneration.ExcWideThree.Parrott.D4Graph.sl2At K ⟨3, by decide⟩
                      (CFSG.LieType.Chevalley.HSL ω)) ∈ E.map (MulAut.congr e).toMonoidHom)) ∨
      (InnerPlane d p E ∧ IsChevalleyExcIndex d.1 ∧
        ((5 ≤ p ∧
            ((∃ q : TauCeti.PrimePower, d.1 = .E6 q ∧
                (orderOf ((q.card : ℕ) : ZMod p) = 3 ∨ orderOf ((q.card : ℕ) : ZMod p) = 6)) ∨
              (∃ q : TauCeti.PrimePower, d.1 = .E7 q ∧
                (orderOf ((q.card : ℕ) : ZMod p) = 2 ∨ orderOf ((q.card : ℕ) : ZMod p) = 6)) ∨
              (∃ q : TauCeti.PrimePower, d.1 = .E8 q ∧ 7 ≤ p ∧
                (orderOf ((q.card : ℕ) : ZMod p) = 3 ∨ orderOf ((q.card : ℕ) : ZMod p) = 6 ∨
                  orderOf ((q.card : ℕ) : ZMod p) = 8 ∨ orderOf ((q.card : ℕ) : ZMod p) = 12)) ∨
              (∃ q : TauCeti.PrimePower, d.1 = .twistedE6 q ∧ ¬ p ∣ q.card - 1 ∧
                2 ≤ degCountTw (orderOf ((q.card : ℕ) : ZMod p))) ∨
              (∃ q : TauCeti.PrimePower, d.1 = .trialityD4 q ∧
                (p ∣ q.card ^ 2 + q.card + 1 ∨ p ∣ q.card ^ 2 - q.card + 1)))) ∨
          (p = 3 ∧
            ((∃ q : TauCeti.PrimePower, d.1 = .trialityD4 q ∧
                ¬ (3 ∣ q.card + 1 ∧ ∃ (K : Type) (_ : Field K) (_ : Finite K) (σ : K ≃+* K),
                  Nat.card K = (q.p ^ q.exponent) ^ 3 ∧ (∀ c, σ c = c ^ (q.p ^ q.exponent)) ∧
                  ∃ e : CFSG.LieType.SeitzGeneration.Cat d ≃* graphFixedRootGroup TwistTag.D4 K σ.toRingHom,
                    CFSG.GH74.GLS.Stage2.Bender.Thm1.D4PlaneInTorusMinus q.p q.exponent q.prime_p K σ
                      ((E.comap (MulAut.conj : CFSG.LieType.SeitzGeneration.Cat d →* _)).map e.toMonoidHom))) ∨
              ∃ q : TauCeti.PrimePower, d.1 = .twistedE6 q ∧ q.card % 3 = 2)))) ∨
      (¬ InnerPlane d p E ∧ p = 3 ∧ IsTrialityIndex d.1 ∧
        ¬ ∃ q : TauCeti.PrimePower, d.1 = .trialityD4 q ∧ ∃ (K : Type) (_ : Field K) (_ : Finite K) (σ : K ≃+* K),
