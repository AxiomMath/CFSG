theorem uniPlaneGen_twistedA5_three_of_card_ne_two
    {Q : TauCeti.PrimePower} (hQ : Q.card ≠ 2)
    (h3 : 3 ∣ Q.card + 1) {E : Subgroup (MulAut (Cat (twistedA5Index Q)))} (hE : IsElemAbelian 3 E)
    (hc : Nat.card E = 3 ^ 2) : UniPlaneGen Q.p E := by
  have : Fact Q.p.Prime := ⟨Q.prime_p⟩
  have hq : Q.p ^ Q.exponent ≠ 2 := by
    rw [← TauCeti.PrimePower.card_def]
    exact hQ
  obtain ⟨⟨hℓ, hf, hn3, -⟩, F, _, _, hKF, ⟨eT⟩⟩ :=
    CFSG.QuasithinUnique.SQTK.statedClassicalModel_twistedA 5 Q (twistedA5Index Q).2
      (MulEquiv.refl (Cat (twistedA5Index Q)))
  have h : UnitaryFieldData Q.p Q.exponent F := ⟨hℓ, hf, by rw [hKF, ← pow_mul, mul_comm]⟩
  haveI : Finite F := h.finite
  haveI : CharP F Q.p := h.charP
  set e : Cat (twistedA5Index Q) ≃* primeFormP h (idGram F (5 + 1)) :=
    eT.trans (BalanceLp.statedProjEquivPrimeFormP h (by omega)) with he
  set E' := E.map (MulAut.congr e).toMonoidHom with hE'
  suffices hU : UniPlaneGen Q.p E' from (uniPlaneGen_map_congr e Q.p E).1 hU
  have hE'el : IsElemAbelian 3 E' := CFSG.Open.IsElemAbelian.map hE _
  have hE'c : Nat.card E' = 3 ^ 2 := by
    rw [hE', Subgroup.card_map_of_injective (MulAut.congr e).injective, hc]
  have hpq : 3 ∣ Q.p ^ Q.exponent + 1 := by rw [← TauCeti.PrimePower.card_def]; exact h3
  have h3p : 3 ≠ Q.p := by
    intro h3p
    rw [TauCeti.PrimePower.card_def, ← h3p] at h3
    have : 3 ∣ 3 ^ Q.exponent := dvd_pow_self 3 Q.exponent_pos.ne'
    omega
  rcases CFSG.LocalAnalysis.GLTheoremB.MovingAround.Inputs2311h.uniPlaneGen_psu_anyChar_of_ne_eight_or_four_le
      h hq (Or.inr (by norm_num : 4 ≤ 5 + 1)) hn3 Nat.prime_three (by norm_num) h3p hpq hE'el hE'c with
    hU | ⟨-, hnp, -⟩
  · exact hU
  · omega

theorem uniPlaneGen_twistedA5_three {Q : TauCeti.PrimePower} (hQ2 : Q.p ≠ 2)
    (h3 : 3 ∣ Q.card + 1) {E : Subgroup (MulAut (Cat (twistedA5Index Q)))} (hE : IsElemAbelian 3 E)
    (hc : Nat.card E = 3 ^ 2) : UniPlaneGen Q.p E :=
  uniPlaneGen_twistedA5_three_of_card_ne_two (fun hcard => hQ2 (primePower_card_two hcard).1) h3 hE hc

theorem closure_pow_eq_top_twistedA5 {Q : TauCeti.PrimePower} (hQ : Q.card ≠ 2) :
    Subgroup.closure {c : Cat (twistedA5Index Q) | ∃ n : ℕ, c ^ (Q.p ^ n) = 1} = ⊤ := by
  have : Fact Q.p.Prime := ⟨Q.prime_p⟩
  obtain ⟨⟨hℓ, hf, -, -⟩, F, _, _, hKF, ⟨eT⟩⟩ :=
    CFSG.QuasithinUnique.SQTK.statedClassicalModel_twistedA 5 Q (twistedA5Index Q).2
      (MulEquiv.refl (Cat (twistedA5Index Q)))
  have h : UnitaryFieldData Q.p Q.exponent F := ⟨hℓ, hf, by rw [hKF, ← pow_mul, mul_comm]⟩
  haveI : Finite F := h.finite
  haveI : CharP F Q.p := h.charP
  set e : Cat (twistedA5Index Q) ≃* primeFormP h (idGram F (5 + 1)) :=
    eT.trans (BalanceLp.statedProjEquivPrimeFormP h (by omega)) with he
  have hq : Q.p ^ Q.exponent ≠ 2 := by rw [← TauCeti.PrimePower.card_def]; exact hQ
  have hgen := Inputs2311d.closure_pow_ringChar_gramSU h hq 5
  have hring : ringChar F = Q.p := ringChar.eq F Q.p
  set π : gramSU h (idGram F (5 + 1)) →* primeFormP h (idGram F (5 + 1)) :=
    QuotientGroup.mk' _ with hπ
  set φ : gramSU h (idGram F (5 + 1)) →* Cat (twistedA5Index Q) := e.symm.toMonoidHom.comp π with hφ
  have hφs : Function.Surjective φ := e.symm.surjective.comp (QuotientGroup.mk'_surjective _)
  rw [eq_top_iff]
  intro c _
  obtain ⟨g, rfl⟩ := hφs c
  have hg : g ∈ Subgroup.closure {g : gramSU h ((1 : GL (Fin (5 + 1)) F) : Matrix (Fin (5 + 1))
      (Fin (5 + 1)) F) | g ^ ringChar F = 1} := by rw [hgen]; exact Subgroup.mem_top _
  have h1 := Subgroup.mem_map_of_mem φ hg
  rw [MonoidHom.map_closure] at h1
  refine Subgroup.closure_mono ?_ h1
  rintro _ ⟨x, hx, rfl⟩
  have hx' : x ^ Q.p = 1 := by
    have hx0 : x ^ ringChar F = 1 := hx
    rwa [hring] at hx0
  exact ⟨1, by rw [pow_one, ← map_pow, hx', map_one]⟩

end TwA5

