theorem uniClosure_eq_top_of_central_quotient_twA5_of_card_ne_two {Y : Type*} [Group Y]
    [Finite Y] (hperf : ⁅(⊤ : Subgroup Y), (⊤ : Subgroup Y)⁆ = ⊤)
    (hZ : (Nat.card (Subgroup.center Y)).Coprime 3) {Q : TauCeti.PrimePower} (hQ : Q.card ≠ 2)
    (h3 : 3 ∣ Q.card + 1) (φ : Y ⧸ Subgroup.center Y ≃* Cat (twistedA5Index Q))
    (E' : Subgroup (MulAut Y)) (hE' : IsElemAbelian 3 E') (hcard : Nat.card E' = 3 ^ 2) :
    Subgroup.closure {u : Y | ∃ ε ∈ E', ε ≠ 1 ∧ ε u = u ∧ ∃ n : ℕ, u ^ (Q.p ^ n) = 1} = ⊤ := by
  classical
  set ψ : MulAut Y →* MulAut (Cat (twistedA5Index Q)) := inducedHom φ with hψ
  have hψapply : ∀ (ε : MulAut Y) (y : Y),
      ψ ε (φ (QuotientGroup.mk y)) = φ (QuotientGroup.mk (ε y)) := fun ε y =>
    inducedAut_apply φ ε y
  have hker : ∀ ε ∈ E', ψ ε = 1 → ε = 1 := by
    intro ε _ h1
    refine eq_one_of_inv_mul_mem_center hperf ε fun y => ?_
    have h2 : φ (QuotientGroup.mk (ε y)) = φ (QuotientGroup.mk y) := by
      rw [← hψapply, h1]
      rfl
    have h3 := φ.injective h2
    exact QuotientGroup.eq.1 h3.symm
  have hE''ab : IsElemAbelian 3 (E'.map ψ) := CFSG.Open.IsElemAbelian.map hE' ψ
  have hE''card : Nat.card (E'.map ψ) = 3 ^ 2 := by
    rw [← hcard]
    symm
    refine Nat.card_congr (Equiv.ofBijective
      (fun ε : E' => (⟨ψ ε, Subgroup.mem_map_of_mem _ ε.2⟩ : E'.map ψ)) ⟨?_, ?_⟩)
    · intro a b h
      have h1 : ψ a = ψ b := congrArg Subtype.val h
      have h2 : ψ ((a⁻¹ * b : E') : MulAut Y) = 1 := by
        rw [Subgroup.coe_mul, Subgroup.coe_inv, map_mul, map_inv, h1, inv_mul_cancel]
      have h3 := hker _ (E'.mul_mem (E'.inv_mem a.2) b.2) h2
      have h4 : a⁻¹ * b = 1 := Subtype.ext h3
      exact (inv_mul_eq_one.1 h4)
    · rintro ⟨_, ε, hε, rfl⟩
      exact ⟨⟨ε, hε⟩, rfl⟩
  have hU : UniPlaneGen Q.p (E'.map ψ) := uniPlaneGen_twistedA5_three_of_card_ne_two hQ h3 hE''ab hE''card
  set M : Subgroup Y := Subgroup.closure {u : Y | ∃ ε ∈ E', ε ≠ 1 ∧ ε u = u ∧
    ∃ n : ℕ, u ^ (Q.p ^ n) = 1} with hM
  set q : Y →* Cat (twistedA5Index Q) := φ.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center Y))
    with hq
  have hq_apply : ∀ y, q y = φ (QuotientGroup.mk y) := fun y => rfl
  have hq_surj : Function.Surjective q := by
    intro c
    obtain ⟨x, rfl⟩ := φ.surjective c
    obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective x
    exact ⟨y, rfl⟩
  have hqker : q.ker ≤ Subgroup.center Y := by
    intro x hx
    rw [MonoidHom.mem_ker, hq_apply] at hx
    have : (QuotientGroup.mk x : Y ⧸ Subgroup.center Y) = 1 := φ.injective (by rw [hx, map_one])
    exact (QuotientGroup.eq_one_iff x).1 this
  have hqM : M.map q = ⊤ := by
    rw [eq_top_iff, ← hU]
    refine (Subgroup.closure_le _).2 ?_
    rintro k ⟨ē, hē, hē1, hēk, n, hn⟩
    obtain ⟨ε, hε, rfl⟩ := Subgroup.mem_map.1 hē
    obtain ⟨y, rfl⟩ := hq_surj k
    have hε1 : ε ≠ 1 := fun h => hē1 (by rw [h, map_one])
    have h1 : φ (QuotientGroup.mk (ε y)) = φ (QuotientGroup.mk y) := by
      rw [← hψapply]
      exact hēk
    have h2 : y⁻¹ * ε y ∈ Subgroup.center Y := QuotientGroup.eq.1 (φ.injective h1).symm
    obtain ⟨w, hw, hεw⟩ := exists_fixed_mul_central hZ ε (by
      have := hE'.2 ε hε
      simpa using this) h2
    have hqw : q (y * w) = q y := by
      rw [map_mul, hq_apply w, (QuotientGroup.eq_one_iff w).2 hw, map_one, mul_one]
    obtain ⟨s, hs, ⟨m, hm⟩, hqs⟩ := exists_rElement_lift_of_pow q Q.prime_p (y * w) (n := n)
      (by rw [hqw]; exact hn)
    have hεs : ε s = s := by
      obtain ⟨j, rfl⟩ := hs
      simp only [map_zpow, hεw]
    exact ⟨s, Subgroup.subset_closure ⟨ε, hε, hε1, hεs, m, hm⟩, by rw [hqs, hqw]⟩
  exact eq_top_of_map_eq_top_of_perfect hperf q hqker M hqM

theorem uniClosure_eq_top_of_central_quotient_twA5 {Y : Type*} [Group Y]
    [Finite Y] (hperf : ⁅(⊤ : Subgroup Y), (⊤ : Subgroup Y)⁆ = ⊤)
    (hZ : (Nat.card (Subgroup.center Y)).Coprime 3) {Q : TauCeti.PrimePower} (hQ2 : Q.p ≠ 2)
    (h3 : 3 ∣ Q.card + 1) (φ : Y ⧸ Subgroup.center Y ≃* Cat (twistedA5Index Q))
    (E' : Subgroup (MulAut Y)) (hE' : IsElemAbelian 3 E') (hcard : Nat.card E' = 3 ^ 2) :
    Subgroup.closure {u : Y | ∃ ε ∈ E', ε ≠ 1 ∧ ε u = u ∧ ∃ n : ℕ, u ^ (Q.p ^ n) = 1} = ⊤ :=
  uniClosure_eq_top_of_central_quotient_twA5_of_card_ne_two hperf hZ
