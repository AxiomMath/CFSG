          ∃ ω : Kˣ, ω ^ 3 = 1 ∧ ω ≠ 1 ∧ d4Graph K 1 ∈ E.map (MulAut.congr e).toMonoidHom ∧
            MulAut.conj (sl2Short K (HSL ω)) ∈ E.map (MulAut.congr e).toMonoidHom := by
  rintro ⟨d, hv⟩ p hp hp2 hpd hex E hE hc ⟨rfl, q, rfl, K, _, _, hK, e, ω, hω3, hω1, hγ, hxE⟩
  have hchar : (TauCeti.LieTypeIndex.D 4 q).characteristic = q.p := by
    simp [TauCeti.LieTypeIndex.characteristic_D]
