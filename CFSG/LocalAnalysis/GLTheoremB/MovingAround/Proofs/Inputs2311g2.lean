  have hv2 : ∀ a, outerTripleExcD4 K (vSL a, vSL (w * a), vSL (w ^ 2 * a)) ∈ H := by
    intro a
    have h := hconjH ω hω3 hxE _ (d4Graph_one_outerTripleExcD4 _ _ _)
