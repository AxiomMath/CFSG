theorem outerTripleExcD4_uSL_zero (a b c : K) :
    outerTripleExcD4 K (uSL a, uSL 0, uSL 0) = sl2At K ⟨0, by decide⟩ (uSL a) ∧
      outerTripleExcD4 K (uSL 0, uSL b, uSL 0) = sl2At K ⟨1, by decide⟩ (uSL b) ∧
      outerTripleExcD4 K (uSL 0, uSL 0, uSL c) = sl2At K ⟨3, by decide⟩ (uSL c) := by
