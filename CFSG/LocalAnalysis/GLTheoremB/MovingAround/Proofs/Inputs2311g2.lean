    rw [← hβ, hφ]
  refine ⟨e, x.2, fun h => hxa ?_, fun h => hxb ?_, hperx e c (β x) he hh hb ⟨α, hαr, hxα⟩⟩
  · obtain ⟨k, hk⟩ := h
    exact ⟨k, Subtype.ext (by simpa using hk)⟩
  · obtain ⟨k, hk⟩ := h
    exact ⟨k, Subtype.ext (by simpa using hk)⟩

