  have hu0 : ∀ a, outerTripleExcD4 K (uSL a, uSL a, uSL a) ∈ H := fun a =>
    hγH _ (d4Graph_one_outerTripleExcD4 _ _ _) (outerTripleExcD4_uSL_pow_ringChar a a a)
