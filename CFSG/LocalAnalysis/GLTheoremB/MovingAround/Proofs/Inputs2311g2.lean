theorem not_isSolvable_rClosure_of_layer {τ : Tag} {K L : Type} [Field K] [Finite K] [Field L] [Algebra K L]
    {x : adjointGroup τ K} (ψ : Subgroup.centralizer ({x} : Set (adjointGroup τ K)) →* ModGL τ L)
    (hψ : Function.Injective ψ) {Pt : Subgroup (ModGL τ L)} (hPq : CFSG.IsQuasisimple Pt)
    (hcomm : ⁅ψ.range, ψ.range⁆ = Pt) (i : Fin τ.rank) (h₀ : ModGL τ L)
    (hroot : ∀ Y : SL2 K, h₀ * simpleRootSL2 τ L i (Matrix.SpecialLinearGroup.map (algebraMap K L) Y) * h₀⁻¹ ∈ Pt) :
    ¬ Group.IsSolvable ↥(Subgroup.closure {y : adjointGroup τ K | Commute y x ∧
      ∃ m : ℕ, y ^ (ringChar K ^ m) = 1}) := by
  classical
  intro hsol
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨m, hr, -⟩ := FiniteField.card K (ringChar K)
  haveI : Fact (ringChar K).Prime := ⟨hr⟩
  have : Finite (ModGL τ K) := finite_modGL
  have hPle : Pt ≤ ψ.range := by
    rw [← hcomm]
    exact ThirdLineAux.commutator_le_self' _
  haveI : Finite Pt := by
    haveI : Finite ψ.range := Set.Finite.to_subtype (Set.finite_range ψ)
    exact Finite.of_injective _ (Subgroup.inclusion_injective hPle)
  obtain ⟨Y, hY1, hYr⟩ := exists_sl2_rElement_ne_one K
  have hzP := hroot Y
  have hzr : (h₀ * simpleRootSL2 τ L i (Matrix.SpecialLinearGroup.map (algebraMap K L) Y) * h₀⁻¹) ^
      ringChar K = 1 := by
    rw [conj_pow, ← map_pow, ← map_pow, hYr, map_one, map_one, mul_one, mul_inv_cancel]
  have hz1 : h₀ * simpleRootSL2 τ L i (Matrix.SpecialLinearGroup.map (algebraMap K L) Y) * h₀⁻¹ ≠ 1 := by
    intro h
    apply hY1
    have h1 : simpleRootSL2 τ L i (Matrix.SpecialLinearGroup.map (algebraMap K L) Y) = 1 := by
      have := congrArg (fun w => h₀⁻¹ * w * h₀) h
      simpa [mul_assoc] using this
    apply CFSG.GH74.Filter.Lie.sl2_map_injective (algebraMap K L)
    apply CFSG.RankThree.Chevalley.simpleRootSL2_injective_of_field τ i
    rw [h1, map_one, map_one]
  have hdvd : ringChar K ∣ Nat.card Pt := by
    have ho : orderOf (⟨_, hzP⟩ : Pt) = ringChar K := by
      rw [Subgroup.orderOf_mk]
      exact orderOf_eq_prime hzr hz1
    rw [← ho]
    exact orderOf_dvd_natCard _
  have hPr := le_closure_pow_of_quasisimple (r := ringChar K) hPq hdvd
  have hPS : Pt ≤ (Subgroup.closure {y : Subgroup.centralizer ({x} : Set (adjointGroup τ K)) |
      ∃ m : ℕ, y ^ (ringChar K ^ m) = 1}).map ψ := by
    refine hPr.trans ((Subgroup.closure_le _).2 ?_)
    rintro w ⟨hwP, n, hn⟩
    obtain ⟨y, rfl⟩ := hPle hwP
    refine ⟨y, Subgroup.subset_closure ⟨n, hψ ?_⟩, rfl⟩
    rw [map_pow, map_one]
    exact hn
  have hSsol : Group.IsSolvable ↥(Subgroup.closure {y : Subgroup.centralizer ({x} : Set (adjointGroup τ K)) |
      ∃ m : ℕ, y ^ (ringChar K ^ m) = 1}) := by
    have hle : (Subgroup.closure {y : Subgroup.centralizer ({x} : Set (adjointGroup τ K)) |
        ∃ m : ℕ, y ^ (ringChar K ^ m) = 1}).map (Subgroup.centralizer ({x} : Set (adjointGroup τ K))).subtype ≤
        Subgroup.closure {y : adjointGroup τ K | Commute y x ∧ ∃ m : ℕ, y ^ (ringChar K ^ m) = 1} := by
      rw [MonoidHom.map_closure]
      refine Subgroup.closure_mono ?_
      rintro _ ⟨y, ⟨n, hn⟩, rfl⟩
      have hyc : Commute (y : adjointGroup τ K) x := Subgroup.mem_centralizer_singleton_iff.1 y.2
      refine ⟨hyc, n, ?_⟩
      rw [Subgroup.coe_subtype, ← Subgroup.coe_pow, hn, Subgroup.coe_one]
    have hf : Function.Injective ((Subgroup.inclusion hle).comp
        (Subgroup.equivMapOfInjective _ _
          (Subgroup.centralizer ({x} : Set (adjointGroup τ K))).subtype_injective).toMonoidHom) :=
      (Subgroup.inclusion_injective hle).comp (MulEquiv.injective _)
    haveI := hsol
    exact solvable_of_solvable_injective hf
  have hmapsol : Group.IsSolvable ↥((Subgroup.closure {y : Subgroup.centralizer ({x} : Set (adjointGroup τ K)) |
      ∃ m : ℕ, y ^ (ringChar K ^ m) = 1}).map ψ) := by
    haveI := hSsol
    exact Group.isSolvable_of_surjective (f := (Subgroup.equivMapOfInjective _ ψ hψ).toMonoidHom)
      (MulEquiv.surjective _)
  have hPsol : Group.IsSolvable ↥Pt := by
    haveI := hmapsol
    exact solvable_of_solvable_injective (Subgroup.inclusion_injective hPS)
  exact CFSG.HardMathSupport.Foote.Coordinator.SplitFrame.not_isSolvable_of_isQuasisimple' hPq hPsol

theorem exists_offLine_rgen_F4_aux (K : Type) [Field K] [Finite K] {ℓ f : ℕ} [Fact ℓ.Prime] [CharP K ℓ]
