    outerTripleExcD4 K (vSL a, vSL 0, vSL 0) = sl2At K ⟨0, by decide⟩ (vSL a) ∧
      outerTripleExcD4 K (vSL 0, vSL b, vSL 0) = sl2At K ⟨1, by decide⟩ (vSL b) ∧
      outerTripleExcD4 K (vSL 0, vSL 0, vSL c) = sl2At K ⟨3, by decide⟩ (vSL c) := by
  simp only [outerTripleExcD4_apply, vSL_zero_excD4, map_one, mul_one, one_mul]
