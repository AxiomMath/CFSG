theorem uSL_pow_ringChar_excD4 (c : K) : uSL c ^ ringChar K = 1 := by
  have h : ∀ m : ℕ, uSL c ^ m = uSL ((m : K) * c) := by
    intro m
    induction m with
    | zero => rw [pow_zero, Nat.cast_zero, zero_mul, uSL_zero_excD4]
    | succ m ih => rw [pow_succ, ih, uSL_mul_excD4, Nat.cast_succ, add_mul, one_mul]
  rw [h, ringChar.Nat.cast_ringChar, zero_mul, uSL_zero_excD4]

theorem vSL_pow_ringChar_excD4 (c : K) : vSL c ^ ringChar K = 1 := by
  have h : ∀ m : ℕ, vSL c ^ m = vSL ((m : K) * c) := by
    intro m
    induction m with
    | zero => rw [pow_zero, Nat.cast_zero, zero_mul, vSL_zero_excD4]
    | succ m ih => rw [pow_succ, ih, vSL_mul_excD4, Nat.cast_succ, add_mul, one_mul]
  rw [h, ringChar.Nat.cast_ringChar, zero_mul, vSL_zero_excD4]

theorem sl2Short_HSL_mul_d4Graph_excD4 (ω : Kˣ) (hω3 : ω ^ 3 = 1) :
    sl2Short K (HSL ω) * d4Graph K 1 (outerTripleExcD4 K (1, HSL ω, HSL (ω ^ 2))) =
      outerTripleExcD4 K (1, HSL ω, HSL (ω ^ 2)) := by
  rw [d4Graph_one_outerTripleExcD4, sl2Short_eq_outerTripleExcD4, ← map_mul]
  congr 1
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · show HSL ω * HSL (ω ^ 2) = 1
    rw [HSL_mul_excD4, ← pow_succ', hω3, HSL_one_excD4]
  · show HSL ω * 1 = HSL ω
    rw [mul_one]
  · show HSL ω * HSL ω = HSL (ω ^ 2)
    rw [HSL_mul_excD4, sq]

theorem conj_sl2Short_mul_d4Graph_excD4 (ω : Kˣ) (hω3 : ω ^ 3 = 1) :
    MulAut.conj (sl2Short K (HSL ω)) * d4Graph K 1 =
      MulAut.conj (outerTripleExcD4 K (1, HSL ω, HSL (ω ^ 2))) * d4Graph K 1 *
        (MulAut.conj (outerTripleExcD4 K (1, HSL ω, HSL (ω ^ 2))))⁻¹ := by
  set t := outerTripleExcD4 K (1, HSL ω, HSL (ω ^ 2)) with ht
  set x := sl2Short K (HSL ω) with hx
  have h1 : x * d4Graph K 1 t = t := sl2Short_HSL_mul_d4Graph_excD4 ω hω3
  have h2 : x = t * (d4Graph K 1 t)⁻¹ := eq_mul_inv_of_mul_eq h1
  refine MulEquiv.ext fun y => ?_
  have h3 : (MulAut.conj t)⁻¹ y = t⁻¹ * y * t := by
    rw [← map_inv, MulAut.conj_apply, inv_inv]
  rw [MulAut.mul_apply, MulAut.mul_apply, MulAut.mul_apply, h3, MulAut.conj_apply, MulAut.conj_apply,
    map_mul, map_mul, map_inv, h2]
  group

theorem conj_outerTripleExcD4 (B₁ B₃ X Y Z : SL2 K) :
    outerTripleExcD4 K (1, B₁, B₃) * outerTripleExcD4 K (X, Y, Z) * (outerTripleExcD4 K (1, B₁, B₃))⁻¹ =
      outerTripleExcD4 K (X, B₁ * Y * B₁⁻¹, B₃ * Z * B₃⁻¹) := by
  rw [← map_inv, ← map_mul, ← map_mul]
  congr 1
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · show 1 * X * 1⁻¹ = X
    group
  · rfl
  · rfl

theorem outerTripleExcD4_uSL_pow_ringChar (a b c : K) :
    outerTripleExcD4 K (uSL a, uSL b, uSL c) ^ ringChar K = 1 := by
