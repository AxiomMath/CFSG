    ring
  rcases degCountE6_cases (e := e) (by omega) with h1 | h2 | h3 | h4 | h6
  · refine hn (normalizesRSubgroup_E6_of_dvd_sq_sub_one q hv hp hp5 ?_ (IsPGroup.of_card hc) hin)
