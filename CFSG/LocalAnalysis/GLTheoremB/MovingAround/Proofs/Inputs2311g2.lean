        orderOf ((q.card : ℕ) : ZMod p) = 10 ∨ degCount Tag.E8 (orderOf ((q.card : ℕ) : ZMod p)) ≤ 1)) ∧
      d.1.characteristic ≠ 2 ∧ ¬ NormalizesRSubgroup d E := by
  rintro ⟨d, hv⟩ p hp hp2 hpd _ E hE hc ⟨hin, hp5, ⟨q, hq, hcls⟩, hch, hn⟩
  obtain rfl : d = .E8 q := hq
