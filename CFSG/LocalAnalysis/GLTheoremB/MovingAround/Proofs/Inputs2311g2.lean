theorem map_le_closure_rElements_excD4 {G H : Type*} [Group G] [Group H] (φ : G →* H) {J : Subgroup G}
    {r : ℕ} (hJ : J ≤ Subgroup.closure {s | s ∈ J ∧ s ^ r = 1}) :
    J.map φ ≤ Subgroup.closure {s | s ∈ J.map φ ∧ s ^ r = 1} := by
  rintro _ ⟨x, hx, rfl⟩
  have h := Subgroup.mem_map_of_mem φ (hJ hx)
  rw [MonoidHom.map_closure] at h
  refine Subgroup.closure_mono ?_ h
  rintro _ ⟨s, ⟨hs, hsr⟩, rfl⟩
  exact ⟨⟨s, hs, rfl⟩, by rw [← map_pow, hsr, map_one]⟩

theorem mem_center_of_commute_uSL_vSL_excD4 {K : Type} [Field K] (X : SL2 K)
    (hu : X * uSL 1 = uSL 1 * X) (hv : X * vSL 1 = vSL 1 * X) : X ∈ Subgroup.center (SL2 K) := by
  have hu' := congrArg (fun Y : SL2 K => (Y : Matrix (Fin 2) (Fin 2) K)) hu
  have hv' := congrArg (fun Y : SL2 K => (Y : Matrix (Fin 2) (Fin 2) K)) hv
  simp only [Matrix.SpecialLinearGroup.coe_mul, coe_uSL, coe_vSL] at hu' hv'
  have h10 := congrFun (congrFun hu' 0) 0
  have h11 := congrFun (congrFun hu' 0) 1
  have h21 := congrFun (congrFun hv' 0) 0
  have h22 := congrFun (congrFun hv' 1) 1
  simp [Matrix.mul_apply, Fin.sum_univ_two] at h10 h11 h21 h22
  have hdet := X.2
  rw [Matrix.det_fin_two] at hdet
  rw [Matrix.SpecialLinearGroup.mem_center_iff]
  refine ⟨(X : Matrix (Fin 2) (Fin 2) K) 0 0, ?_, ?_⟩
  · simp only [Fintype.card_fin]
    have hc : (X : Matrix (Fin 2) (Fin 2) K) 1 0 = 0 := h10
    have hb : (X : Matrix (Fin 2) (Fin 2) K) 0 1 = 0 := h21
    have hd : (X : Matrix (Fin 2) (Fin 2) K) 1 1 = (X : Matrix (Fin 2) (Fin 2) K) 0 0 := by
      linear_combination -h11
    rw [hc, hb, hd] at hdet
    linear_combination hdet
  · have hc : (X : Matrix (Fin 2) (Fin 2) K) 1 0 = 0 := h10
    have hb : (X : Matrix (Fin 2) (Fin 2) K) 0 1 = 0 := h21
    have hd : (X : Matrix (Fin 2) (Fin 2) K) 1 1 = (X : Matrix (Fin 2) (Fin 2) K) 0 0 := by
      linear_combination -h11
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.scalar_apply, hb, hc, hd]

theorem exists_sl2_fixSubfield_of_map_eq_excD4 {K : Type} [Field K] (σ : K ≃+* K) (M : SL2 K)
    (hM : Matrix.SpecialLinearGroup.map σ.toRingHom M = M) :
    ∃ y : Matrix.SpecialLinearGroup (Fin 2) (fixSubfield σ),
      Matrix.SpecialLinearGroup.map (fixSubfield σ).subtype y = M := by
  have hfix : ∀ i j, σ ((M : Matrix (Fin 2) (Fin 2) K) i j) = (M : Matrix (Fin 2) (Fin 2) K) i j := by
    intro i j
    have h := congrArg (fun Y : SL2 K => (Y : Matrix (Fin 2) (Fin 2) K) i j) hM
    simpa [Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply] using h
  let N : Matrix (Fin 2) (Fin 2) (fixSubfield σ) := Matrix.of fun i j => ⟨_, hfix i j⟩
  have hNmap : N.map (fixSubfield σ).subtype = (M : Matrix (Fin 2) (Fin 2) K) := by
    ext i j
    rfl
  have hNdet : N.det = 1 := by
    apply (fixSubfield σ).subtype_injective
    have h := RingHom.map_det (fixSubfield σ).subtype N
    rw [map_one]
    rw [RingHom.mapMatrix_apply, hNmap] at h
    rw [h]
    exact M.2
  refine ⟨(⟨N, hNdet⟩ : Matrix.SpecialLinearGroup (Fin 2) (fixSubfield σ)), Subtype.ext ?_⟩
  show ((fixSubfield σ).subtype.mapMatrix N : Matrix (Fin 2) (Fin 2) K) = (M : Matrix (Fin 2) (Fin 2) K)
  rw [RingHom.mapMatrix_apply]
  exact hNmap

theorem triality_tau_facts_excD4 {ℓ f : ℕ} (hℓ : ℓ.Prime) (hℓ2 : ℓ ≠ 2) (hℓ3 : ℓ ≠ 3)
    (hf : 1 ≤ f) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (ℓ ^ f) ^ 3) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ (ℓ ^ f)) :
    fixedSubgroup (tauAut σ) ≤
        Subgroup.closure {s | s ∈ fixedSubgroup (tauAut σ) ∧ s ^ ringChar K = 1} ∧
      Asub σ ≤ Subgroup.closure {s | s ∈ Asub σ ∧ s ^ ringChar K = 1} ∧
      fixedSubgroup (tauAut σ) ⊔ Asub σ = ⊤ ∧ tauAut σ ≠ 1 := by
  classical
  have hσ3 : ∀ c, σ (σ (σ c)) = c := ringEquiv_cube_apply_eq hK hσ
  have hσ3' : ∀ c, σ.toRingHom (σ.toRingHom (σ.toRingHom c)) = c := hσ3
  have hK2 : ringChar K ≠ 2 := triOdd_ringChar_ne_two hℓ hℓ2 hf hK
  have hq2 : 2 ≤ ℓ ^ f := triOdd_two_le_pow hℓ hf
  set ε := triOddEqRoot σ hK2 hq2 hK hσ with hεdef
  have hcardX : Nat.card (fixSubfield σ) = ℓ ^ f :=
    CFSG.GH74.GLS.Stage4.Hex.card_fixedField_of_cube σ.toRingHom hq2 hK hσ
  have hq3 : 3 ≤ ℓ ^ f := by
    have h5 : 3 ≤ ℓ := by
      have := hℓ.two_le
      omega
    calc 3 ≤ ℓ := h5
      _ = ℓ ^ 1 := (pow_one ℓ).symm
      _ ≤ ℓ ^ f := Nat.pow_le_pow_right hℓ.pos hf
  have hk3 : (3 : ℕ∞) ≤ ENat.card (fixSubfield σ) := by
    rw [ENat.card_eq_coe_natCard, hcardX]
    exact_mod_cast hq3
  have hkchar : ringChar (fixSubfield σ) = ringChar K := Algebra.ringChar_eq (fixSubfield σ) K
  have hJgen : FixedSub σ ≤ Subgroup.closure {s | s ∈ FixedSub σ ∧ s ^ ringChar K = 1} := by
    have := le_closure_rElements_of_mulEquiv_adjointGroup_excD4
      ((fixedSubEquivJ σ hK2 hq2 hK hσ hσ3).trans (trialityFieldImageEquivG2 σ hk3))
    rwa [hkchar] at this
  have hτfix : fixedSubgroup (tauAut σ) = (FixedSub σ).map ε.toMonoidHom :=
    triOdd_fixedSubgroup_tau_eq_map σ hσ3 hK2 hq2 hK hσ
  refine ⟨?_, ?_, ?_, fun h => triOdd_tauAut_not_mem_innerAut σ hℓ hℓ2 hf hK hσ (h ▸ one_mem _)⟩
  · rw [hτfix]
    exact map_le_closure_rElements_excD4 ε.toMonoidHom hJgen
  · intro a ha
    obtain ⟨M, rfl⟩ := triOdd_Asub_eq_eqRoot_slShort σ hℓ hℓ2 hℓ3 hf hK hσ hσ3' a ha
    have hM : M ∈ Subgroup.closure {x : Matrix.SpecialLinearGroup (Fin 2) K | x ^ ringChar K = 1} := by
      rw [sl2_closure_pow_ringChar_eq_top]
      exact Subgroup.mem_top M
    have h1 := Subgroup.mem_map_of_mem (ε.toMonoidHom.comp (slShort σ.toRingHom hσ3')) hM
    rw [MonoidHom.map_closure] at h1
    refine Subgroup.closure_mono ?_ h1
    rintro _ ⟨x, hx, rfl⟩
    exact ⟨triOdd_eqRoot_slShort_mem_Asub σ hℓ hℓ2 hℓ3 hf hK hσ hσ3' x,
      by rw [← map_pow, show x ^ ringChar K = 1 from hx, map_one]⟩
  · have h := congrArg (Subgroup.map ε.toMonoidHom) (triOdd_fixedSub_sup_slShort σ hσ3)
    rw [Subgroup.map_sup, ← hτfix] at h
    have htop : Subgroup.map ε.toMonoidHom ⊤ = ⊤ := Subgroup.map_top_of_surjective _ ε.surjective
    rw [htop] at h
    rw [eq_top_iff, ← h]
    refine sup_le_sup_left ?_ _
    rintro _ ⟨_, ⟨M, rfl⟩, rfl⟩
    exact triOdd_eqRoot_slShort_mem_Asub σ hℓ hℓ2 hℓ3 hf hK hσ hσ3' M

theorem uniPlaneClosure_triality_tauB_excD4 {ℓ f : ℕ} (hℓ : ℓ.Prime) (hℓ2 : ℓ ≠ 2) (hℓ3 : ℓ ≠ 3)
    (hf : 1 ≤ f) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (ℓ ^ f) ^ 3) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ (ℓ ^ f)) {E : Subgroup (MulAut (C0 σ))} (hτE : tauAut σ ∈ E) {b : C0 σ}
    (hbB : b ∈ Bsub σ) (hb1 : b ≠ 1) (hbE : MulAut.conj b ∈ E) :
    uniPlaneClosure (ringChar K) E = ⊤ := by
  classical
  obtain ⟨hτgen, hAgen, hsup, hτ1⟩ := triality_tau_facts_excD4 hℓ hℓ2 hℓ3 hf hK σ hσ
  have hZ : Subgroup.center (C0 σ) = ⊥ :=
    CFSG.LieType.Chevalley.center_graphFixedRootGroup_eq_bot σ.surjective
  have hinj := CFSG.LieType.SeitzGeneration.conj_injective_of_center_eq_bot hZ
  have hcb1 : MulAut.conj b ≠ 1 := fun h => hb1 (hinj (h.trans (map_one _).symm))
  have hJH : fixedSubgroup (tauAut σ) ≤ uniPlaneClosure (ringChar K) E :=
    hτgen.trans (Subgroup.closure_le _ |>.2 fun s ⟨hs, hsr⟩ =>
      mem_uniPlaneClosure (n := 1) hτE hτ1 hs (by rw [pow_one]; exact hsr))
  have hAH : Asub σ ≤ uniPlaneClosure (ringChar K) E :=
    hAgen.trans (Subgroup.closure_le _ |>.2 fun s ⟨hs, hsr⟩ =>
      mem_uniPlaneClosure (n := 1) hbE hcb1
        (by rw [MulAut.conj_apply, ← Subgroup.mem_centralizer_iff.1 hbB _ hs, mul_inv_cancel_right])
        (by rw [pow_one]; exact hsr))
  rw [eq_top_iff, ← hsup]
  exact sup_le hJH hAH

theorem uniPlaneClosure_triality_tauA_excD4 {ℓ f : ℕ} (hℓ : ℓ.Prime) (hℓ2 : ℓ ≠ 2) (hℓ3 : ℓ ≠ 3)
    (hf : 1 ≤ f) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (ℓ ^ f) ^ 3) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ (ℓ ^ f)) {E : Subgroup (MulAut (C0 σ))} (hτE : tauAut σ ∈ E) {a : C0 σ}
    (haA : a ∈ Asub σ) (ha1 : a ≠ 1) (ha3 : a ^ 3 = 1) (hτa : tauAut σ a = a)
    (haE : MulAut.conj a ∈ E) : uniPlaneClosure (ringChar K) E = ⊤ := by
  classical
  obtain ⟨hτgen, -, hsup, hτ1⟩ := triality_tau_facts_excD4 hℓ hℓ2 hℓ3 hf hK σ hσ
  obtain ⟨ι, hιinj, hιA, hιτ⟩ := triOdd_asub_chart σ hℓ hℓ2 hℓ3 hf hK hσ
  have hσ3 : σ ^ 3 = 1 := triOdd_sigma_pow_three σ (ℓ ^ f) hK hσ
  have hq2 : 2 ≤ ℓ ^ f := triOdd_two_le_pow hℓ hf
  have hσ1 : σ ≠ 1 := triOdd_sigma_ne_one σ (ℓ ^ f) hq2 hK hσ
  have hK2 : ringChar K ≠ 2 := triOdd_ringChar_ne_two hℓ hℓ2 hf hK
  set H := uniPlaneClosure (ringChar K) E with hH
  obtain ⟨M, rfl⟩ := (hιA a).1 haA
  have hMσ : Matrix.SpecialLinearGroup.map σ.toRingHom M = M := hιinj (by rw [← hιτ]; exact hτa)
  have hM3 : M ^ 3 = 1 := hιinj (by rw [map_pow, ha3, map_one])
  obtain ⟨y, hy⟩ := exists_sl2_fixSubfield_of_map_eq_excD4 σ M hMσ
  have hmapinj : Function.Injective
      (Matrix.SpecialLinearGroup.map (n := Fin 2) (fixSubfield σ).subtype) := by
    intro A B h
    apply Subtype.ext
    ext i j
    have := congrArg (fun Y : SL2 K => (Y : Matrix (Fin 2) (Fin 2) K) i j) h
    exact this
  have hy3 : y ^ 3 = 1 := hmapinj (by rw [map_pow, hy, hM3, map_one])
  obtain ⟨g, hg⟩ := CFSG.RankThree.PartTwo.Sec19.sl2_lang σ hσ3 hσ1 y hy3
  rw [hy] at hg
  set t := ι g with ht
  have htτ : tauAut σ t = ι (Matrix.SpecialLinearGroup.map σ.toRingHom g) := hιτ g
  have hβ : MulAut.conj (ι M) * tauAut σ = MulAut.conj t * tauAut σ * (MulAut.conj t)⁻¹ := by
    have h2 : ι M = t * (tauAut σ t)⁻¹ := by rw [htτ, ← map_inv, ← map_mul, ← hg]
    refine MulEquiv.ext fun z => ?_
    have h3 : (MulAut.conj t)⁻¹ z = t⁻¹ * z * t := by
      rw [← map_inv, MulAut.conj_apply, inv_inv]
    rw [MulAut.mul_apply, MulAut.mul_apply, MulAut.mul_apply, h3, MulAut.conj_apply, MulAut.conj_apply,
      map_mul, map_mul, map_inv, h2]
    group
  have hβE : MulAut.conj (ι M) * tauAut σ ∈ E := E.mul_mem haE hτE
  have hβ1 : MulAut.conj (ι M) * tauAut σ ≠ 1 := by
    rw [hβ]
    intro h
    apply hτ1
    have e : tauAut σ =
        (MulAut.conj t)⁻¹ * (MulAut.conj t * tauAut σ * (MulAut.conj t)⁻¹) * MulAut.conj t := by group
    rw [e, h]
    group
  have hJH : fixedSubgroup (tauAut σ) ≤ H :=
    hτgen.trans (Subgroup.closure_le _ |>.2 fun s ⟨hs, hsr⟩ =>
      mem_uniPlaneClosure (n := 1) hτE hτ1 hs (by rw [pow_one]; exact hsr))
  have htJH : ∀ s ∈ fixedSubgroup (tauAut σ), t * s * t⁻¹ ∈ H := by
    intro s hs
    have hle : (fixedSubgroup (tauAut σ)).map (MulAut.conj t).toMonoidHom ≤ H := by
      have h1 := map_le_closure_rElements_excD4 (MulAut.conj t).toMonoidHom hτgen
      refine h1.trans (Subgroup.closure_le _ |>.2 ?_)
