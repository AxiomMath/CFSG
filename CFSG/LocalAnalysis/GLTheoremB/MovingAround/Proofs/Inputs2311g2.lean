theorem levi_le_uniPlaneClosure_twA5_of_card_ne_two {G : Type*} [Group G] (J : Subgroup G)
    [Finite J] (E : Subgroup (MulAut G)) (hE : IsElemAbelian 3 E) (hcard : Nat.card E = 3 ^ 2)
    (hinv : ∀ ε ∈ E, ∀ u ∈ J, ε u ∈ J) (hperf : ⁅J, J⁆ = J)
    (hZ : (Nat.card (Subgroup.center J)).Coprime 3) {Q : TauCeti.PrimePower} (hQ : Q.card ≠ 2)
    (h3 : 3 ∣ Q.card + 1) (φ : J ⧸ Subgroup.center J ≃* Cat (twistedA5Index Q)) :
    J ≤ uniPlaneClosure Q.p E := by
  classical
  have hperf' : ⁅(⊤ : Subgroup J), (⊤ : Subgroup J)⁆ = ⊤ := by
    apply Subgroup.map_injective (Subgroup.subtype_injective J)
    rw [Subgroup.map_commutator, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
    exact hperf
  set q : J →* Cat (twistedA5Index Q) := φ.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center J))
    with hq
  have hq_apply : ∀ y, q y = φ (QuotientGroup.mk y) := fun y => rfl
  have hq_surj : Function.Surjective q := by
    intro c
    obtain ⟨x, rfl⟩ := φ.surjective c
    obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective x
    exact ⟨y, rfl⟩
  have hqker : q.ker ≤ Subgroup.center J := by
    intro x hx
    rw [MonoidHom.mem_ker, hq_apply] at hx
    have : (QuotientGroup.mk x : J ⧸ Subgroup.center J) = 1 := φ.injective (by rw [hx, map_one])
    exact (QuotientGroup.eq_one_iff x).1 this
  by_cases hfix : ∃ ε ∈ E, ε ≠ 1 ∧ ∀ u ∈ J, ε u = u
  · obtain ⟨ε, hε, hε1, hεJ⟩ := hfix
    have hQc : Q.card ≠ 2 := hQ
    set M : Subgroup J := Subgroup.closure {u : J | ∃ n : ℕ, u ^ (Q.p ^ n) = 1} with hM
    have hqM : M.map q = ⊤ := by
      rw [eq_top_iff, ← closure_pow_eq_top_twistedA5 hQc]
      refine (Subgroup.closure_le _).2 ?_
      rintro k ⟨n, hn⟩
      obtain ⟨y, rfl⟩ := hq_surj k
      obtain ⟨s, -, ⟨m, hm⟩, hqs⟩ := exists_rElement_lift_of_pow q Q.prime_p y hn
      exact ⟨s, Subgroup.subset_closure ⟨m, hm⟩, hqs⟩
    have hMtop := eq_top_of_map_eq_top_of_perfect hperf' q hqker M hqM
    intro u hu
    have hmem : (⟨u, hu⟩ : J) ∈ M := by rw [hMtop]; exact Subgroup.mem_top _
    have hS : M.map J.subtype ≤ uniPlaneClosure Q.p E := by
      rw [MonoidHom.map_closure]
      refine (Subgroup.closure_le _).2 ?_
      rintro _ ⟨v, ⟨n, hn⟩, rfl⟩
      exact mem_uniPlaneClosure hε hε1 (hεJ v v.2) (n := n) (by
        have := congrArg Subtype.val hn
        simpa using this)
    exact hS (Subgroup.mem_map.2 ⟨_, hmem, rfl⟩)
  · push Not at hfix
    set ρ : E →* MulAut J := resHom J E hinv with hρ
    have hρinj : Function.Injective ρ := by
      refine (injective_iff_map_eq_one ρ).2 fun ε hε1 => ?_
      by_contra hne
      have hne' : ε.1 ≠ 1 := fun h => hne (Subtype.ext h)
      obtain ⟨u, hu, hεu⟩ := hfix ε.1 ε.2 hne'
      apply hεu
      have := congrArg (fun a : MulAut J => ((a ⟨u, hu⟩ : J) : G)) hε1
      simpa [hρ, resHom_apply] using this
    set E' : Subgroup (MulAut J) := ρ.range with hE'
    have hE'ab : IsElemAbelian 3 E' := by
      obtain ⟨hc, he⟩ := hE
      refine ⟨IsMulCommutative.of_comm fun a b => ?_, fun x hx => ?_⟩
      · obtain ⟨_, ε₁, rfl⟩ := a
        obtain ⟨_, ε₂, rfl⟩ := b
        apply Subtype.ext
        change ρ ε₁ * ρ ε₂ = ρ ε₂ * ρ ε₁
        rw [← map_mul, ← map_mul, mul_comm' ε₁ ε₂]
      · obtain ⟨ε, rfl⟩ := hx
        rw [← map_pow]
        have : ε ^ 3 = 1 := Subtype.ext (he ε.1 ε.2)
        rw [this, map_one]
    have hE'card : Nat.card E' = 3 ^ 2 := by
      rw [← hcard]
      exact (Nat.card_congr (MonoidHom.ofInjective hρinj).toEquiv).symm
    have hgen := uniClosure_eq_top_of_central_quotient_twA5_of_card_ne_two hperf' hZ hQ h3 φ E' hE'ab hE'card
    intro u hu
    have hmem : (⟨u, hu⟩ : J) ∈ (⊤ : Subgroup J) := Subgroup.mem_top _
    rw [← hgen] at hmem
    have hS : Subgroup.map J.subtype (Subgroup.closure {v : J | ∃ ε ∈ E', ε ≠ 1 ∧ ε v = v ∧
        ∃ n : ℕ, v ^ (Q.p ^ n) = 1}) ≤ uniPlaneClosure Q.p E := by
      rw [MonoidHom.map_closure]
      refine (Subgroup.closure_le _).2 ?_
      rintro _ ⟨v, ⟨ε', hε', hε'1, hε'v, n, hn⟩, rfl⟩
      obtain ⟨ε, rfl⟩ := hε'
      refine mem_uniPlaneClosure ε.2 ?_ ?_ (n := n) ?_
      · intro h1
        apply hε'1
        have : ε = 1 := Subtype.ext h1
        rw [this, map_one]
      · have := congrArg Subtype.val hε'v
        simpa [hρ, resHom_apply] using this
      · have := congrArg Subtype.val hn
        simpa using this
    exact hS (Subgroup.mem_map.2 ⟨_, hmem, rfl⟩)

theorem levi_le_uniPlaneClosure_twA5 {G : Type*} [Group G] (J : Subgroup G)
    [Finite J] (E : Subgroup (MulAut G)) (hE : IsElemAbelian 3 E) (hcard : Nat.card E = 3 ^ 2)
    (hinv : ∀ ε ∈ E, ∀ u ∈ J, ε u ∈ J) (hperf : ⁅J, J⁆ = J)
    (hZ : (Nat.card (Subgroup.center J)).Coprime 3) {Q : TauCeti.PrimePower} (hQ2 : Q.p ≠ 2)
    (h3 : 3 ∣ Q.card + 1) (φ : J ⧸ Subgroup.center J ≃* Cat (twistedA5Index Q)) :
    J ≤ uniPlaneClosure Q.p E :=
  levi_le_uniPlaneClosure_twA5_of_card_ne_two J E hE hcard hinv hperf hZ
    (fun hcard => hQ2 (primePower_card_two hcard).1) h3 φ

end Levi


