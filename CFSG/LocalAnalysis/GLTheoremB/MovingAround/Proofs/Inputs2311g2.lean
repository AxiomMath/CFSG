variable (K : Type) [Field K]

@[expose] noncomputable def outerTripleExcD4 : SL2 K × SL2 K × SL2 K →* ↥(adjointGroup Tag.D4 K) where
  toFun B := sl2At K ⟨0, by decide⟩ B.1 * sl2At K ⟨1, by decide⟩ B.2.1 * sl2At K ⟨3, by decide⟩ B.2.2
  map_one' := by simp
  map_mul' A B := by
    have h01 := sl2At_commute (K := K) (i := ⟨1, by decide⟩) (j := ⟨0, by decide⟩) (by decide)
      (by decide) (by decide) A.2.1 B.1
    have h03 := sl2At_commute (K := K) (i := ⟨3, by decide⟩) (j := ⟨0, by decide⟩) (by decide)
      (by decide) (by decide) A.2.2 B.1
    have h13 := sl2At_commute (K := K) (i := ⟨3, by decide⟩) (j := ⟨1, by decide⟩) (by decide)
      (by decide) (by decide) A.2.2 B.2.1
    simp only [Prod.fst_mul, Prod.snd_mul, map_mul]
    set a0 := sl2At K ⟨0, by decide⟩ A.1
    set a1 := sl2At K ⟨1, by decide⟩ A.2.1
    set a3 := sl2At K ⟨3, by decide⟩ A.2.2
    set b0 := sl2At K ⟨0, by decide⟩ B.1
    set b1 := sl2At K ⟨1, by decide⟩ B.2.1
    set b3 := sl2At K ⟨3, by decide⟩ B.2.2
    calc a0 * b0 * (a1 * b1) * (a3 * b3) = a0 * (b0 * a1) * b1 * a3 * b3 := by group
      _ = a0 * (a1 * b0) * b1 * a3 * b3 := by rw [h01.eq]
      _ = a0 * a1 * b0 * (b1 * a3) * b3 := by group
      _ = a0 * a1 * b0 * (a3 * b1) * b3 := by rw [h13.eq]
      _ = a0 * a1 * (b0 * a3) * b1 * b3 := by group
      _ = a0 * a1 * (a3 * b0) * b1 * b3 := by rw [h03.eq]
      _ = a0 * a1 * a3 * (b0 * b1 * b3) := by group

variable {K}

theorem outerTripleExcD4_apply (B : SL2 K × SL2 K × SL2 K) :
    outerTripleExcD4 K B =
      sl2At K ⟨0, by decide⟩ B.1 * sl2At K ⟨1, by decide⟩ B.2.1 * sl2At K ⟨3, by decide⟩ B.2.2 :=
  rfl

theorem sl2Short_eq_outerTripleExcD4 (B : SL2 K) : sl2Short K B = outerTripleExcD4 K (B, B, B) := rfl

theorem d4Graph_one_outerTripleExcD4 (X Y Z : SL2 K) :
    d4Graph K 1 (outerTripleExcD4 K (X, Y, Z)) = outerTripleExcD4 K (Z, X, Y) := by
  rw [outerTripleExcD4_apply, outerTripleExcD4_apply, map_mul, map_mul, d4Graph_sl2At, d4Graph_sl2At,
    d4Graph_sl2At]
  have e0 : (d4Rho ^ 1) (⟨0, by decide⟩ : Fin Tag.D4.rank) = ⟨1, by decide⟩ := by decide
  have e1 : (d4Rho ^ 1) (⟨1, by decide⟩ : Fin Tag.D4.rank) = ⟨3, by decide⟩ := by decide
  have e3 : (d4Rho ^ 1) (⟨3, by decide⟩ : Fin Tag.D4.rank) = ⟨0, by decide⟩ := by decide
  rw [e0, e1, e3]
  have h03 := sl2At_commute (K := K) (i := ⟨3, by decide⟩) (j := ⟨0, by decide⟩) (by decide)
    (by decide) (by decide) Y Z
  have h13 := sl2At_commute (K := K) (i := ⟨1, by decide⟩) (j := ⟨0, by decide⟩) (by decide)
    (by decide) (by decide) X Z
  simp only
  rw [mul_assoc, h03.eq, ← mul_assoc, h13.eq]

theorem HSL_conj_uSL_excD4 (s : Kˣ) (c : K) : HSL s * uSL c * (HSL s)⁻¹ = uSL ((s : K) ^ 2 * c) := by
  apply Subtype.ext
