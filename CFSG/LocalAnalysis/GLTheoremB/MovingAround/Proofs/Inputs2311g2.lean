theorem le_closure_rElements_of_mulEquiv_adjointGroup_excD4 {G : Type*} [Group G] {J : Subgroup G}
    {τ : Tag} {F : Type} [Field F] (ε : ↥J ≃* ↥(adjointGroup τ F)) :
    J ≤ Subgroup.closure {s | s ∈ J ∧ s ^ ringChar F = 1} := by
  set S : Set (ModGL τ F) := {g | ∃ (i : Fin τ.rank) (c : F),
    (g : Module.End F (RootModule τ F)) = xOp τ F i c ∨ (g : Module.End F (RootModule τ F)) = yOp τ F i c}
    with hSdef
  have hA : adjointGroup τ F = Subgroup.closure S := rfl
  have hSA : S ⊆ (adjointGroup τ F : Set (ModGL τ F)) := by
    rw [hA]
    exact Subgroup.subset_closure
  set P : Set ↥(adjointGroup τ F) := (adjointGroup τ F).subtype ⁻¹' S with hPdef
  have htop : Subgroup.closure P = ⊤ := by
    rw [hPdef, ← subgroupOf_closure_eq_closure_preimage_excD4 _ hSA, ← hA, Subgroup.subgroupOf_self]
  have hPr : ∀ p ∈ P, p ^ ringChar F = 1 := by
    intro p hp
    obtain ⟨i, c, h | h⟩ := hp
    · apply Subtype.ext
      rw [Subgroup.coe_pow, OneMemClass.coe_one]
      have e : ((p : ModGL τ F)) = xUnit τ F i c := Units.ext h
      rw [e, xUnit_pow_ringChar_excD4]
    · apply Subtype.ext
      rw [Subgroup.coe_pow, OneMemClass.coe_one]
      have e : ((p : ModGL τ F)) = yUnit τ F i c := Units.ext h
      rw [e, yUnit_pow_ringChar_excD4]
  intro x hx
  have h1 : ε ⟨x, hx⟩ ∈ Subgroup.closure P := htop ▸ Subgroup.mem_top _
  have h2 : (⟨x, hx⟩ : ↥J) ∈ (Subgroup.closure P).map ε.symm.toMonoidHom :=
    ⟨ε ⟨x, hx⟩, h1, by simp⟩
  have h3 : x ∈ ((Subgroup.closure P).map ε.symm.toMonoidHom).map J.subtype := ⟨_, h2, rfl⟩
  rw [MonoidHom.map_closure, MonoidHom.map_closure] at h3
  refine Subgroup.closure_mono ?_ h3
  rintro _ ⟨_, ⟨p, hp, rfl⟩, rfl⟩
  refine ⟨(ε.symm p).2, ?_⟩
  have e : (J.subtype (ε.symm.toMonoidHom p)) ^ ringChar F = J.subtype (ε.symm.toMonoidHom (p ^ ringChar F)) := by
    rw [map_pow, map_pow]
  rw [e, hPr p hp, map_one, map_one]

