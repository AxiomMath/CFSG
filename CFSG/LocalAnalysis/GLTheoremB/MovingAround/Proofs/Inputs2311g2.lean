              CFSG.LieType.SeitzGeneration.ExcWideThree.D4ElemType α fun ε σ => ε ≠ 0 ∧ σ = 1) ∧
        ¬ ∃ q : TauCeti.PrimePower, d.1 = .D 4 q ∧ ∃ (K : Type) (_ : Field K) (_ : Finite K), Nat.card K = q.card ∧
          ∃ e : CFSG.LieType.SeitzGeneration.Cat d ≃* ↥(adjointGroup Tag.D4 K),
            CFSG.HardMathSupport.Lang.D4Three.d4Graph K 1 ∈ E.map (MulAut.congr e).toMonoidHom ∧
            ((∃ A : Matrix.SpecialLinearGroup (Fin 2) K,
                CFSG.LieType.SeitzGeneration.ExcWideThree.Parrott.D4Graph.sl2At K ⟨2, by decide⟩ A ≠ 1 ∧
                MulAut.conj (CFSG.LieType.SeitzGeneration.ExcWideThree.Parrott.D4Graph.sl2At K ⟨2, by decide⟩ A) ∈
                  E.map (MulAut.congr e).toMonoidHom) ∨
