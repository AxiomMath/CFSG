theorem subgroupOf_closure_eq_closure_preimage_excD4 {G : Type*} [Group G] (A : Subgroup G) {S : Set G}
    (hS : S ⊆ A) : (Subgroup.closure S).subgroupOf A = Subgroup.closure (A.subtype ⁻¹' S) := by
  have h : (Subgroup.closure (A.subtype ⁻¹' S)).map A.subtype = Subgroup.closure S := by
    rw [MonoidHom.map_closure, Set.image_preimage_eq_of_subset]
    intro x hx
    exact ⟨⟨x, hS hx⟩, rfl⟩
  rw [← h]
  exact Subgroup.comap_map_eq_self_of_injective A.subtype_injective _

theorem xUnit_pow_ringChar_excD4 {τ : Tag} {K : Type} [Field K] (i : Fin τ.rank) (c : K) :
    xUnit τ K i c ^ ringChar K = 1 := by
  have h : ∀ m : ℕ, xUnit τ K i c ^ m = xUnit τ K i ((m : K) * c) := by
    intro m
    induction m with
    | zero => rw [pow_zero, Nat.cast_zero, zero_mul, xUnit_zero]
    | succ m ih => rw [pow_succ, ih, ← xUnit_add, Nat.cast_succ, add_mul, one_mul]
  rw [h, ringChar.Nat.cast_ringChar, zero_mul, xUnit_zero]

theorem yUnit_pow_ringChar_excD4 {τ : Tag} {K : Type} [Field K] (i : Fin τ.rank) (c : K) :
    yUnit τ K i c ^ ringChar K = 1 := by
  have h : ∀ m : ℕ, yUnit τ K i c ^ m = yUnit τ K i ((m : K) * c) := by
    intro m
    induction m with
    | zero => rw [pow_zero, Nat.cast_zero, zero_mul, yUnit_zero]
    | succ m ih => rw [pow_succ, ih, ← yUnit_add, Nat.cast_succ, add_mul, one_mul]
  rw [h, ringChar.Nat.cast_ringChar, zero_mul, yUnit_zero]

theorem subfieldGroup_D4_le_closure_rElements_excD4 {K : Type} [Field K] [Finite K] (T : K ≃+* K)
    (hT3 : T ^ 3 = 1) :
    subfieldGroup Tag.D4 T ≤
      Subgroup.closure {s | s ∈ subfieldGroup Tag.D4 T ∧ ∃ n : ℕ, s ^ (ringChar K ^ n) = 1} := by
  set S : Set (ModGL Tag.D4 K) := {g | ∃ (i : Fin Tag.D4.rank) (c : K), T c = c ∧
    (g = xUnit Tag.D4 K i c ∨ g = yUnit Tag.D4 K i c)} with hSdef
  have hS : S ⊆ (adjointGroup Tag.D4 K : Set (ModGL Tag.D4 K)) := by
    rintro g ⟨i, c, -, rfl | rfl⟩
    · exact xUnit_mem_adjointGroup i c
    · exact yUnit_mem_adjointGroup i c
  have hR : subfieldGroup Tag.D4 T = Subgroup.closure ((adjointGroup Tag.D4 K).subtype ⁻¹' S) := by
    show fixedSubgroup (entrywiseAdjointAut Tag.D4 T) = _
    rw [fixedSubgroup_entrywiseAdjointAut_D4 T hT3, fixedFieldImage_eq_closure,
      subgroupOf_closure_eq_closure_preimage_excD4 _ hS]
  intro s hs
  rw [hR] at hs
  refine (Subgroup.closure_le _).2 ?_ hs
  intro t ht
  refine Subgroup.subset_closure ?_
  refine ⟨?_, 1, ?_⟩
  · rw [hR]
    exact Subgroup.subset_closure ht
  · obtain ⟨i, c, -, h | h⟩ := ht
    · apply Subtype.ext
      rw [pow_one, Subgroup.coe_pow, OneMemClass.coe_one]
      change (t : ModGL Tag.D4 K) = _ at h
      rw [h, xUnit_pow_ringChar_excD4]
    · apply Subtype.ext
      rw [pow_one, Subgroup.coe_pow, OneMemClass.coe_one]
      change (t : ModGL Tag.D4 K) = _ at h
      rw [h, yUnit_pow_ringChar_excD4]

theorem isPGroup_negUnipotent_excD4 {K : Type} [Field K] [Finite K] (p : ℕ) [Fact p.Prime] [CharP K p]
    (τ : Tag) : IsPGroup p (negUnipotent τ K) := by
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨w₀, hmax, -⟩ := weyl_longest_element τ
  obtain ⟨n, -, hcard⟩ := FiniteField.card K p
  refine IsPGroup.of_card (n := (n : ℕ) * {α : Fin τ.rank → ℤ | IsRoot τ α ∧ 0 < height α}.ncard) ?_
  rw [card_negUnipotent hmax, Nat.card_eq_fintype_card, hcard, ← pow_mul]

theorem fixedSubgroup_d4Twist_le_closure_rElements_excD4 {K : Type} [Field K] [Finite K] (σ : K ≃+* K)
    (hσ3 : ∀ c, σ (σ (σ c)) = c) (hpar : ringChar K = 2 ∨ ∃ n, Odd n ∧ ∀ c, σ c = c ^ n) :
    fixedSubgroup (d4Twist 1 σ) ≤
      Subgroup.closure {s | s ∈ fixedSubgroup (d4Twist 1 σ) ∧ ∃ n : ℕ, s ^ (ringChar K ^ n) = 1} := by
  classical
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨m, hℓ, -⟩ := FiniteField.card K (ringChar K)
  haveI : Fact (ringChar K).Prime := ⟨hℓ⟩
  haveI : CharP K (ringChar K) := ringChar.charP K
  let Upos : Subgroup (ModGL Tag.D4 K) := graphFixedPosUnipotent TwistTag.D4 K σ.toRingHom
  let Uneg : Subgroup (ModGL Tag.D4 K) := graphFixedNegUnipotent TwistTag.D4 K σ.toRingHom
  have hΓA : twistedFixedGroup TwistTag.D4 K σ.toRingHom ≤ adjointGroup Tag.D4 K := inf_le_left
  have hSA : ((Upos : Set (ModGL Tag.D4 K)) ∪ Uneg) ⊆ (adjointGroup Tag.D4 K : Set (ModGL Tag.D4 K)) := by
    rintro g (hg | hg)
    · exact hΓA (Subgroup.mem_inf.1 hg).2
    · exact hΓA (Subgroup.mem_inf.1 hg).2
  have hΓ : fixedSubgroup (d4Twist 1 σ) =
      Subgroup.closure ((adjointGroup Tag.D4 K).subtype ⁻¹' ((Upos : Set (ModGL Tag.D4 K)) ∪ Uneg)) := by
    rw [← subgroupOf_closure_eq_closure_preimage_excD4 _ hSA, ← Subgroup.sup_eq_closure]
    change fixedSubgroup (d4Twist 1 σ) =
      (graphFixedRootGroup TwistTag.D4 K σ.toRingHom).subgroupOf (adjointGroup Tag.D4 K)
    rw [← twistedFixedGroup_eq_graphFixedRootGroup_triality σ hσ3 hpar]
    ext g
    rw [mem_fixedSubgroup_d4Twist_iff]
    constructor
    · intro h
      show (g : ModGL Tag.D4 K) ∈ twistedFixedGroup TwistTag.D4 K σ.toRingHom
      exact Subgroup.mem_inf.2 ⟨g.2, congrArg Subtype.val h⟩
    · intro h
      have h' : (g : ModGL Tag.D4 K) ∈ twistedFixedGroup TwistTag.D4 K σ.toRingHom := h
      exact Subtype.ext (Subgroup.mem_inf.1 h').2
  intro s hs
  rw [hΓ] at hs
  refine (Subgroup.closure_le _).2 ?_ hs
  intro t ht
  refine Subgroup.subset_closure ?_
  refine ⟨?_, ?_⟩
  · rw [hΓ]
    exact Subgroup.subset_closure ht
  · rcases ht with ht | ht
    · obtain ⟨k, hk⟩ := (isPGroup_posUnipotent (K := K) (ringChar K) Tag.D4)
        ⟨(t : ModGL Tag.D4 K), (Subgroup.mem_inf.1 ht).1⟩
      refine ⟨k, Subtype.ext ?_⟩
      have := congrArg Subtype.val hk
      rw [Subgroup.coe_pow, OneMemClass.coe_one] at this ⊢
      exact this
    · obtain ⟨k, hk⟩ := (isPGroup_negUnipotent_excD4 (K := K) (ringChar K) Tag.D4)
        ⟨(t : ModGL Tag.D4 K), (Subgroup.mem_inf.1 ht).1⟩
      refine ⟨k, Subtype.ext ?_⟩
      have := congrArg Subtype.val hk
      rw [Subgroup.coe_pow, OneMemClass.coe_one] at this ⊢
      exact this

theorem fixedSubgroup_le_uniPlaneClosure_of_conj_excD4 {P : Type*} [Group P] {r : ℕ}
    {E : Subgroup (MulAut P)} {α ψ : MulAut P} (hαE : α ∈ E) (hα1 : α ≠ 1) {R : Subgroup P}
    (hF : fixedSubgroup (ψ * α * ψ⁻¹) = R)
    (hR : R ≤ Subgroup.closure {s | s ∈ R ∧ ∃ n : ℕ, s ^ (r ^ n) = 1}) :
    fixedSubgroup α ≤ uniPlaneClosure r E := by
  rw [fixedSubgroup_conj] at hF
  have h2 : (Subgroup.closure {s | s ∈ R ∧ ∃ n : ℕ, s ^ (r ^ n) = 1}).map ψ⁻¹.toMonoidHom ≤
      uniPlaneClosure r E := by
    rw [MonoidHom.map_closure, Subgroup.closure_le]
    rintro _ ⟨s, ⟨hsR, n, hn⟩, rfl⟩
    rw [← hF] at hsR
    obtain ⟨y, hy, rfl⟩ := hsR
    refine mem_uniPlaneClosure (n := n) hαE hα1 ?_ ?_
    · have h1 : ψ⁻¹.toMonoidHom (ψ.toMonoidHom y) = y := by simp
      rw [h1]
      exact hy
    · rw [← map_pow, hn, map_one]
  intro x hx
  have hψx : ψ x ∈ R := hF ▸ ⟨x, hx, rfl⟩
  have h3 := h2 ⟨ψ x, hR hψx, rfl⟩
  simpa using h3

theorem eq_top_of_fixed_le_of_kernel_escape_excD4 {P : Type*} [Group P] [Finite P]
    {N : Subgroup (MulAut P)} {R : Subgroup P} (hmax : ∀ M : Subgroup P, R ≤ M → M = R ∨ M = ⊤)
    (hker : ∀ ι ∈ N, (∀ x ∈ R, ι x = x) → ι = 1) {α ι ψa ψb : MulAut P} (hι1 : ι ≠ 1)
    (hιN : ψa * ι * ψa⁻¹ ∈ N) (hFa : fixedSubgroup (ψa * α * ψa⁻¹) = R)
    (hFb : fixedSubgroup (ψb * (α * ι) * ψb⁻¹) = R) {H : Subgroup P} (hHa : fixedSubgroup α ≤ H)
    (hHb : fixedSubgroup (α * ι) ≤ H) : H = ⊤ := by
  have hmaxα := maximal_fixedSubgroup_of_conj hmax hFa
  rcases hmaxα H hHa with h | h
  · exfalso
    have hle : fixedSubgroup (α * ι) ≤ fixedSubgroup α := h ▸ hHb
    have hcard : Nat.card (fixedSubgroup (α * ι)) = Nat.card (fixedSubgroup α) := by
      rw [← card_fixedSubgroup_conj_ctp ψb (α * ι), hFb, ← hFa, card_fixedSubgroup_conj_ctp]
    have heq : fixedSubgroup (α * ι) = fixedSubgroup α :=
      Subgroup.eq_of_le_of_card_ge hle (le_of_eq hcard.symm)
    have hιfix : ∀ x ∈ fixedSubgroup α, ι x = x := by
      intro x hx
      have hx' : x ∈ fixedSubgroup (α * ι) := heq ▸ hx
      have h1 : (α * ι) x = x := hx'
      have h2 : α x = x := hx
      simp only [MulAut.mul_apply] at h1
      exact α.injective (h1.trans h2.symm)
    rw [fixedSubgroup_conj] at hFa
    have hι'fix : ∀ x ∈ R, (ψa * ι * ψa⁻¹) x = x := by
      intro x hx
      rw [← hFa] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      show (ψa * ι * ψa⁻¹) (ψa y) = ψa y
      simp [MulAut.mul_apply, hιfix y hy]
    have h1 := hker _ hιN hι'fix
    apply hι1
    have h2 : ψa⁻¹ * (ψa * ι * ψa⁻¹) * ψa = ι := by group
    rw [← h2, h1]
    simp
  · exact h

theorem d4GfTwist_cube_odd_excD4 {K : Type} [Field K] {ℓ e : ℕ} (hℓ : Odd ℓ) (T σ : K ≃+* K) (ε : ℕ)
    (hT : ∀ c, T c = c ^ (ℓ ^ e)) (hT3 : T ^ 3 = 1) :
    (∀ c, d4GfTwist T σ ε (d4GfTwist T σ ε (d4GfTwist T σ ε c)) = c) ∧
      ∃ n, Odd n ∧ ∀ c, d4GfTwist T σ ε c = c ^ n := by
  have hcube : ∀ U : K ≃+* K, U ^ 3 = 1 → ∀ c, U (U (U c)) = c := by
    intro U hU c
    have h := DFunLike.congr_fun hU c
    simpa only [pow_succ, pow_zero, one_mul, RingAut.mul_apply, RingAut.one_apply] using h
  have hTinv : T⁻¹ = T * T := inv_eq_of_mul_eq_one_right (by rw [← pow_three, hT3])
  rcases d4GfTwist_eq_or T σ ε with h | h <;> rw [h]
  · exact ⟨hcube T hT3, ℓ ^ e, hℓ.pow, hT⟩
  · refine ⟨hcube T⁻¹ (by rw [inv_pow, hT3, inv_one]), ℓ ^ e * ℓ ^ e, hℓ.pow.mul hℓ.pow, fun c => ?_⟩
    rw [hTinv, RingAut.mul_apply, hT, hT, ← pow_mul]

theorem uniPlaneClosure_d4_caseA_excD4 {ℓ f e : ℕ} [Fact ℓ.Prime] {K : Type} [Field K] [Finite K] [CharP K ℓ]
    (hK : Nat.card K = ℓ ^ f) (hK4 : 4 ≤ Nat.card K) (he : 1 ≤ e) (hef : e * 3 = f)
    (T σ : K ≃+* K) (hT : ∀ c, T c = c ^ (ℓ ^ e)) (hT3 : T ^ 3 = 1) (hT1 : T ≠ 1)
    (hσ : σ = T ∨ σ = T ^ 2)
    (hmax : ∀ M : Subgroup ↥(adjointGroup Tag.D4 K), subfieldGroup Tag.D4 T ≤ M →
      M = subfieldGroup Tag.D4 T ∨ M = ⊤)
    (hbig : 2 < Nat.card (fixSubfield T))
    {E : Subgroup (MulAut ↥(adjointGroup Tag.D4 K))} [hE : CFSG.IsElementaryAbelian 3 ↥E]
    {α ι : MulAut ↥(adjointGroup Tag.D4 K)} (hαE : α ∈ E) (hιE : ι ∈ E)
    (g : adjointGroup Tag.D4 K) (a : Fin Tag.D4.rank → Kˣ)
    (hα : α = MulAut.conj g * exactNormalAut Tag.D4 K a σ 0)
    (g' : adjointGroup Tag.D4 K) (b : Fin Tag.D4.rank → Kˣ)
    (hι : ι = MulAut.conj g' * rootDiagAut Tag.D4 K b) (hι1 : ι ≠ 1) :
    uniPlaneClosure (ringChar K) E = ⊤ := by
  classical
  have : Finite (ModGL Tag.D4 K) := finite_modGL
  have : Finite (adjointGroup Tag.D4 K) := Subtype.finite
  have hα3 : α ^ 3 = 1 := CFSG.elemPow_eq_one_of_isElementaryAbelian α hαE
  have hβ3 : (α * ι) ^ 3 = 1 :=
    CFSG.elemPow_eq_one_of_isElementaryAbelian (α * ι) (E.mul_mem hαE hιE)
  obtain ⟨g₃, a₃, hαι⟩ := normalForm_mul g g' a b σ 1 0
  simp only [d4Graph_zero, mul_one] at hαι
  rw [← rootDiagAut_eq_normalAut, ← hα, ← hι] at hαι
  set L := AlgebraicClosure K
  obtain ⟨ψa, hψa, hFa⟩ := exists_conj_fixedSubgroup_D4_field hK hK4 he hef T σ hT hT3 hσ L g a α
    hα hα3
  obtain ⟨ψb, -, hFb⟩ := exists_conj_fixedSubgroup_D4_field hK hK4 he hef T σ hT hT3 hσ L g₃ a₃
    (α * ι) hαι hβ3
  have hα1 : α ≠ 1 := by
    rintro rfl
    rw [fixedSubgroup_conj_one] at hFa
    exact subfieldGroup_ne_top_D4 hT1 hFa.symm
  have hβ1 : α * ι ≠ 1 := by
    intro h
    rw [h, fixedSubgroup_conj_one] at hFb
    exact subfieldGroup_ne_top_D4 hT1 hFb.symm
  have hdeg : entryDegreeBound Tag.D4 = 2 := by simp [entryDegreeBound]
  have hRgen := subfieldGroup_D4_le_closure_rElements_excD4 T hT3
  have hιN : ι ∈ matrixInner Tag.D4 K L := hι ▸ conj_mul_rootDiagAut_mem_matrixInner L g' b
  refine eq_top_of_fixed_le_of_kernel_escape_excD4 (N := matrixInner Tag.D4 K L) hmax ?_ hι1
    ((matrixInner Tag.D4 K L).mul_mem ((matrixInner Tag.D4 K L).mul_mem hψa hιN)
      ((matrixInner Tag.D4 K L).inv_mem hψa)) hFa hFb
    (fixedSubgroup_le_uniPlaneClosure_of_conj_excD4 hαE hα1 hFa hRgen)
    (fixedSubgroup_le_uniPlaneClosure_of_conj_excD4 (E.mul_mem hαE hιE) hβ1 hFb hRgen)
  intro ι' hι'N hι'fix
  refine eq_one_of_mem_matrixInner_of_fix_subfield (fixSubfield T) (by rw [hdeg]; exact hbig)
    hι'N ?_
  intro x hx
  apply hι'fix
  have h1 := fixedFieldImage_le (σ := T) hx
  rw [mem_fixedSubgroup]
  refine Subtype.ext ?_
  rw [coe_entrywiseAdjointAut]
  exact ((mem_entrywiseFixedGroup).1 h1).2

theorem uniPlaneClosure_d4_caseB_excD4 {ℓ f e : ℕ} [Fact ℓ.Prime] {K : Type} [Field K] [Finite K] [CharP K ℓ]
    (hℓ2 : ℓ ≠ 2) (hK : Nat.card K = ℓ ^ f) (hK4 : 4 ≤ Nat.card K) (he : 1 ≤ e) (hef : e * 3 = f)
    (T σ : K ≃+* K) (hT : ∀ c, T c = c ^ (ℓ ^ e)) (hT3 : T ^ 3 = 1) (hT1 : T ≠ 1)
    (hσ : σ = T ∨ σ = T ^ 2)
    (hmax : ∀ M : Subgroup ↥(adjointGroup Tag.D4 K), subfieldGroup Tag.D4 T ≤ M →
      M = subfieldGroup Tag.D4 T ∨ M = ⊤)
    {E : Subgroup (MulAut ↥(adjointGroup Tag.D4 K))} [hE : CFSG.IsElementaryAbelian 3 ↥E]
