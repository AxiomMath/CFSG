theorem outerTripleExcD4_uSL_mul (a b c a' b' c' : K) :
    outerTripleExcD4 K (uSL a, uSL b, uSL c) * outerTripleExcD4 K (uSL a', uSL b', uSL c') =
      outerTripleExcD4 K (uSL (a + a'), uSL (b + b'), uSL (c + c')) := by
