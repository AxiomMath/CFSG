theorem exists_rElement_lift_of_pow {Y C : Type*} [Group Y] [Group C] [Finite Y] (ψ : Y →* C) {r : ℕ}
    (hr : r.Prime) (g : Y) {n : ℕ} (hn : ψ g ^ (r ^ n) = 1) :
    ∃ s ∈ Subgroup.zpowers g, (∃ m : ℕ, s ^ (r ^ m) = 1) ∧ ψ s = ψ g := by
  have ho : orderOf g ≠ 0 := (orderOf_pos g).ne'
  obtain ⟨a, m, hm, hom⟩ := Nat.exists_eq_pow_mul_and_not_dvd ho r hr.one_lt.ne'
  have hcop : m.Coprime (orderOf (ψ g)) := by
    have h1 : orderOf (ψ g) ∣ r ^ n := orderOf_dvd_of_pow_eq_one hn
    have h2 : m.Coprime r := Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd hr).2 hm)
    exact Nat.Coprime.coprime_dvd_right h1 (Nat.Coprime.pow_right n h2)
  obtain ⟨k, hk⟩ := exists_pow_eq_self_of_coprime hcop
  refine ⟨(g ^ m) ^ k, Subgroup.pow_mem _ (Subgroup.pow_mem _ (Subgroup.mem_zpowers g) m) k, ⟨a, ?_⟩, ?_⟩
  · rw [← pow_mul, ← pow_mul, show m * (k * r ^ a) = (r ^ a * m) * k by ring, pow_mul, ← hom,
      pow_orderOf_eq_one, one_pow]
  · rw [map_pow, map_pow]
    exact hk

theorem eq_top_of_map_eq_top_of_perfect {Y C : Type*} [Group Y] [Group C] [Finite Y]
    (hperf : ⁅(⊤ : Subgroup Y), (⊤ : Subgroup Y)⁆ = ⊤) (ψ : Y →* C) (hker : ψ.ker ≤ Subgroup.center Y)
    (M : Subgroup Y) (hM : M.map ψ = ⊤) : M = ⊤ := by
  refine eq_top_of_sup_center (by rw [commutator_def]; exact hperf) ?_
  rw [eq_top_iff]
  intro y _
  have hy : ψ y ∈ M.map ψ := by rw [hM]; exact Subgroup.mem_top _
  obtain ⟨m, hm, hmy⟩ := hy
  have hz : m⁻¹ * y ∈ Subgroup.center Y := hker (by rw [MonoidHom.mem_ker, map_mul, map_inv, hmy,
    inv_mul_cancel])
  have : y = m * (m⁻¹ * y) := by group
  rw [this]
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hm) (Subgroup.mem_sup_right hz)

end Lift

