theorem twE6LongRootPair_pow_ringChar {K : Type} [Field K] [Finite K] {σ : K ≃+* K}
    {X Xm : Subgroup (twistedE6RootGroup K σ)} (hpair : IsTwE6LongRootPair K σ X Xm) :
    (∀ u ∈ X, u ^ ringChar K = 1) ∧ (∀ u ∈ Xm, u ^ ringChar K = 1) := by
  obtain ⟨g, rfl, rfl⟩ := hpair
  have hroot : ∀ (β : Fin TwistTag.E6.tag.rank → ℤ) (u : twistedE6RootGroup K σ),
      u ∈ twE6RootSubgroup K σ β → u ^ ringChar K = 1 := by
    intro β u hu
    have hu' : (u : ModGL TwistTag.E6.tag K) ∈ rootSubgroup TwistTag.E6.tag K β := hu
    obtain ⟨c, hc⟩ := mem_rootSubgroup.1 hu'
    apply Subtype.ext
    rw [SubgroupClass.coe_pow, ← hc, pinnedX_pow_eq, ringChar.Nat.cast_ringChar, zero_mul, pinnedX_zero]
    rfl
  refine ⟨?_, ?_⟩
  · rintro _ ⟨u, hu, rfl⟩
    rw [← map_pow, hroot _ u hu, map_one]
  · rintro _ ⟨u, hu, rfl⟩
    rw [← map_pow, hroot _ u hu, map_one]

theorem twE6LongRootRadical_exists_pow {K : Type} [Field K] [Finite K] {σ : K ≃+* K}
    {X : Subgroup (twistedE6RootGroup K σ)} {u : twistedE6RootGroup K σ} (hu : u ∈ twE6LongRootRadical X) :
    ∃ m : ℕ, u ^ (ringChar K ^ m) = 1 := by
  obtain ⟨v, hv, rfl⟩ := hu
  obtain ⟨m, hm⟩ := CFSG.pCore_isPGroup (p := ringChar K) (G := twE6LongRootParabolic X) ⟨v, hv⟩
  refine ⟨m, ?_⟩
  have h1 := congrArg (fun w : CFSG.pCore (ringChar K) (twE6LongRootParabolic X) =>
    (((w : twE6LongRootParabolic X) : twistedE6RootGroup K σ))) hm
  simpa using h1

theorem twE6DiagRegular_uniPlaneGen_of_ne_two
    (K : Type) [Field K] [Finite K] (σ : K ≃+* K) (q : ℕ)
    (hK3 : ringChar K ≠ 3) (hq2 : q ≠ 2) (hσ : ∀ c, σ c = c ^ q) (hK : Nat.card K = q ^ 2)
    (E : Subgroup (MulAut (twistedE6RootGroup K σ))) (hE : E ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ)
    (hEab : CFSG.IsElementaryAbelian 3 E) (hcard : Nat.card E = 3 ^ 2)
    (hnin : ¬ E ≤ CFSG.Fischer.innerAut (twistedE6RootGroup K σ))
    (D : TwLangData K σ q (twPlanePre K σ E)) (hreg : D.IsRegular) :
    UniPlaneGen (ringChar K) E := by
  classical
  haveI : Finite (ModGL TwistTag.E6.tag K) := finite_modGL
  haveI : Finite (twistedE6RootGroup K σ) := Subtype.finite
  obtain ⟨X, Xm, hpair, hSinv, e, heE, he1, hSfix, R, hRQ, hRfix, hRX⟩ :=
    (twE6InnerLineLongRoot_of_lie twE6LiftBridge_holds twE6InnerLineLie_holds) K σ q hK3 hσ hK E hE hEab
      hcard hnin D hreg
  have hXQ := TwE6LongRoot.q1_holds K σ q hK3 hσ hK X Xm hpair
  obtain ⟨n, hnS, hn⟩ := twE6LongRootGenerates_holds K σ q hK3 hσ hK X Xm hpair
  set H := uniPlaneClosure (ringChar K) E with hH
  have hfixH : ∀ u, e u = u → (∃ m : ℕ, u ^ (ringChar K ^ m) = 1) → u ∈ H := fun u hu ⟨m, hm⟩ =>
    mem_uniPlaneClosure heE he1 hu hm
  obtain ⟨hXr, hXmr⟩ := twE6LongRootPair_pow_ringChar hpair
  have hSH : twE6LongRootSL2 X Xm ≤ H := by
    refine (Subgroup.closure_le _).2 ?_
    rintro u (hu | hu)
    · exact hfixH u (hSfix u (Subgroup.subset_closure (Or.inl hu))) ⟨1, by rw [pow_one]; exact hXr u hu⟩
    · exact hfixH u (hSfix u (Subgroup.subset_closure (Or.inr hu))) ⟨1, by rw [pow_one]; exact hXmr u hu⟩
  have hXS : X ≤ twE6LongRootSL2 X Xm := fun u hu => Subgroup.subset_closure (Or.inl hu)
  have hTS : twE6LongRootTorus X Xm ≤ twE6LongRootSL2 X Xm := inf_le_left.trans inf_le_left
  have hRH : R ≤ H := fun u hu => hfixH u (hRfix u hu) (twE6LongRootRadical_exists_pow (hRQ hu))
  have hJH : twE6LongRootLevi X Xm ≤ H := by
    have hK1 : 1 < Nat.card K := Finite.one_lt_card
    have hq2le : 2 ≤ q := by
      by_contra h
      push Not at h
      interval_cases q <;> norm_num at hK <;> omega
    obtain ⟨hpr, f, hf1, hqf⟩ := twE6_exists_pow_ringChar_of_card_sq K q hK hq2le
    let Q : TauCeti.PrimePower := ⟨ringChar K, f, hpr, hf1⟩
    have hQcard : Q.card = q := by
      rw [TauCeti.PrimePower.card_def]
      exact hqf.symm
    have hJ : IsPSU6Cover (twE6LongRootLevi X Xm) Q := by
      obtain ⟨g, hX, hXm⟩ := hpair
      have h0 := twE6LeviCatalogue_holds K σ q hK3 hσ hK Q hQcard
      rw [hX, hXm, twE6LongRootLevi_map]
      exact ExcWideThree.IsPSU6Cover.of_mulEquiv ((MulAut.conj g).subgroupMap _) h0
    obtain ⟨hperf, hZ, ⟨φ⟩⟩ := hJ
    have h3q : 3 ∣ Q.card + 1 := by
      rw [hQcard]
      exact three_dvd_of_not_le_innerAut K σ q hσ hK E hE hnin
    haveI := hEab
    exact levi_le_uniPlaneClosure_twA5_of_card_ne_two (twE6LongRootLevi X Xm) E
      CFSG.Open.isElemAbelian_of_isElementaryAbelian hcard
      (fun ε hε u hu => commutator_centralizer_invariant _ ε (hSinv ε hε) hu) hperf hZ (Q := Q)
      (by rw [hQcard]; exact hq2) h3q φ
  have hJP : twE6LongRootLevi X Xm ≤ twE6LongRootParabolic X := by
    have h1 : twE6LongRootLevi X Xm ≤
        Subgroup.centralizer (twE6LongRootSL2 X Xm : Set (twistedE6RootGroup K σ)) := by
      refine Subgroup.commutator_le.2 fun a ha b hb => ?_
      rw [commutatorElement_def]
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ ha hb)
        (Subgroup.inv_mem _ ha)) (Subgroup.inv_mem _ hb)
    have h2 : Subgroup.centralizer (twE6LongRootSL2 X Xm : Set (twistedE6RootGroup K σ)) ≤
        Subgroup.centralizer (X : Set (twistedE6RootGroup K σ)) :=
      Subgroup.centralizer_le (fun u hu => hXS hu)
    exact h1.trans (h2.trans (Subgroup.centralizer_le_normalizer _))
  have hTP : twE6LongRootTorus X Xm ≤ twE6LongRootParabolic X := inf_le_left.trans inf_le_right
  have hJTP : twE6LongRootLevi X Xm ⊔ twE6LongRootTorus X Xm ≤ twE6LongRootParabolic X :=
    sup_le hJP hTP
  have hJTH : twE6LongRootLevi X Xm ⊔ twE6LongRootTorus X Xm ≤ H :=
    sup_le hJH (hTS.trans hSH)
  have hMnorm : ∀ g ∈ twE6LongRootLevi X Xm ⊔ twE6LongRootTorus X Xm,
      (H ⊓ twE6LongRootRadical X).map (MulAut.conj g).toMonoidHom = H ⊓ twE6LongRootRadical X := by
    intro g hg
    rw [Subgroup.map_inf _ _ _ (MulAut.conj g).injective, map_conj_eq_of_mem H (hJTH hg)]
    congr 1
    exact map_conj_pCoreOf_eq (twE6LongRootParabolic X) (ringChar K) (hJTP hg)
  have hXM : X ≤ H ⊓ twE6LongRootRadical X := le_inf (hXS.trans hSH) hXQ
  rcases twE6LongRootIrreducible_holds K σ q hK3 hσ hK X Xm hpair (H ⊓ twE6LongRootRadical X) hXM
      inf_le_right hMnorm with hMX | hMQ
  · exfalso
    apply hRX
    intro u hu
    have hu' : u ∈ H ⊓ twE6LongRootRadical X := ⟨hRH hu, hRQ hu⟩
    rw [hMX] at hu'
    exact hu'
  · have hQH : twE6LongRootRadical X ≤ H := by
      intro u hu
      have : u ∈ H ⊓ twE6LongRootRadical X := by
        rw [hMQ]
        exact hu
      exact this.1
    rw [UniPlaneGen, ← hH, ← top_le_iff, ← hn, Subgroup.closure_le]
    rintro u (hu | ⟨v, hv, rfl⟩)
    · exact hQH hu
    · exact H.mul_mem (H.mul_mem (hSH hnS) (hQH hv)) (H.inv_mem (hSH hnS))

theorem twE6DiagRegular_uniPlaneGen
    (K : Type) [Field K] [Finite K] (σ : K ≃+* K) (q : ℕ)
    (hK3 : ringChar K ≠ 3) (hK2 : ringChar K ≠ 2) (hσ : ∀ c, σ c = c ^ q) (hK : Nat.card K = q ^ 2)
    (E : Subgroup (MulAut (twistedE6RootGroup K σ))) (hE : E ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ)
    (hEab : CFSG.IsElementaryAbelian 3 E) (hcard : Nat.card E = 3 ^ 2)
    (hnin : ¬ E ≤ CFSG.Fischer.innerAut (twistedE6RootGroup K σ))
    (D : TwLangData K σ q (twPlanePre K σ E)) (hreg : D.IsRegular) :
    UniPlaneGen (ringChar K) E :=
  twE6DiagRegular_uniPlaneGen_of_ne_two K σ q hK3 (fun hq => hK2 (by
    have hq4 : Nat.card K = 2 ^ (2 * 1) := by rw [hK, hq]
    exact ringChar_eq_of_card_pow Nat.prime_two (by norm_num) K hq4)) hσ hK E hE hEab hcard hnin D hreg

theorem twE6Diag_uniPlaneGen_of_not_normalizes_of_ne_two
    (K : Type) [Field K] [Finite K] (σ : K ≃+* K) (q : ℕ) (hK3 : ringChar K ≠ 3) (hq2 : q ≠ 2)
    (hσ : ∀ c, σ c = c ^ q) (hK : Nat.card K = q ^ 2)
    (E : Subgroup (MulAut (twistedE6RootGroup K σ))) (hE : E ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ)
    (hEab : CFSG.IsElementaryAbelian 3 E) (hcard : Nat.card E = 3 ^ 2)
    (hnin : ¬ E ≤ CFSG.Fischer.innerAut (twistedE6RootGroup K σ)) (hnR : ¬ TwE6NormalizesR K σ E) :
    UniPlaneGen (ringChar K) E := by
  classical
  rcases (twE6InndiagTorality'_of_heisenberg (twE6HeisenbergParabolic_of_frame
      (twE6HeisFrameNormalizesR_of_fixedElt twE6HeisFrameFixedElt_holds))) K σ q hK3 hσ hK E hE hEab hcard
      hnin with ⟨D, -, -, -⟩ | hnorm
  · by_cases hkillex : ∃ α : Fin TwistTag.E6.tag.rank → ℤ, IsRoot TwistTag.E6.tag α ∧
        ∀ x ∈ twPlanePre K σ E, ∃ a : Fin TwistTag.E6.tag.rank → (AlgebraicClosure K)ˣ,
          rootDiagUnit TwistTag.E6.tag a = D.g0⁻¹ *
            baseChangeGL (algebraMap K (AlgebraicClosure K))
              (D.c * x * D.c⁻¹ : ModGL TwistTag.E6.tag K) * D.g0 ∧ rootChar a α = 1
    · exfalso
      obtain ⟨α, hα, hkill⟩ := hkillex
      obtain ⟨u, hu, hu1, ⟨n, hn⟩, hcomm⟩ :=
        CFSG.LieType.SeitzGeneration.ExcHighThree.twE6KillRoot_proof K σ q hK3 hσ hK (twPlanePre K σ E) D
          α hα hkill
      set U : twistedE6RootGroup K σ := ⟨u, hu⟩ with hUdef
      have hU1 : U ≠ 1 := by
        intro h
        apply hu1
        have := congrArg Subtype.val h
        simpa [hUdef] using this
      have hUn : U ^ (ringChar K ^ n) = 1 := by
        apply Subtype.ext
        simpa [hUdef] using hn
      have hRp : IsPGroup (ringChar K) (Subgroup.zpowers U) := by
        intro g
        refine ⟨n, Subtype.ext ?_⟩
        obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.1 g.2
        simp only [Subgroup.coe_pow, Subgroup.coe_one]
        rw [← hm, ← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hUn, one_zpow]
      refine hnR ⟨Subgroup.zpowers U, fun h => hU1 (Subgroup.zpowers_eq_bot.1 h), hRp, ?_⟩
      intro ε hεE
      have hεr : ε ∈ (twistedE6InndiagConj K σ).range := by
        rw [range_twistedE6InndiagConj]
        exact hE hεE
      obtain ⟨g, rfl⟩ := hεr
      have hgA : (g : ModGL TwistTag.E6.tag K) ∈ twPlanePre K σ E :=
        (mem_twPlanePre_iff K σ E _).2 ⟨g, rfl, hεE⟩
      have hfix : twistedE6InndiagConj K σ g U = U := by
        apply Subtype.ext
        rw [twistedE6InndiagConj_apply]
        show (g : ModGL TwistTag.E6.tag K) * u * (g : ModGL TwistTag.E6.tag K)⁻¹ = u
        rw [mul_inv_eq_iff_eq_mul]
        exact (hcomm _ hgA).symm
      have hfix' : (twistedE6InndiagConj K σ g).toMonoidHom U = U := hfix
      rw [MonoidHom.map_zpowers, hfix']
    · exact twE6DiagRegular_uniPlaneGen_of_ne_two K σ q hK3 hq2 hσ hK E hE hEab hcard hnin D hkillex
  · exact absurd hnorm hnR

theorem twE6Diag_uniPlaneGen_of_not_normalizes
    (K : Type) [Field K] [Finite K] (σ : K ≃+* K) (q : ℕ) (hK3 : ringChar K ≠ 3) (hK2 : ringChar K ≠ 2)
    (hσ : ∀ c, σ c = c ^ q) (hK : Nat.card K = q ^ 2)
    (E : Subgroup (MulAut (twistedE6RootGroup K σ))) (hE : E ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ)
    (hEab : CFSG.IsElementaryAbelian 3 E) (hcard : Nat.card E = 3 ^ 2)
    (hnin : ¬ E ≤ CFSG.Fischer.innerAut (twistedE6RootGroup K σ)) (hnR : ¬ TwE6NormalizesR K σ E) :
    UniPlaneGen (ringChar K) E :=
  twE6Diag_uniPlaneGen_of_not_normalizes_of_ne_two K σ q hK3 (fun hq => hK2 (by
    have hq4 : Nat.card K = 2 ^ (2 * 1) := by rw [hK, hq]
    exact ringChar_eq_of_card_pow Nat.prime_two (by norm_num) K hq4)) hσ hK E hE hEab hcard hnin hnR

theorem uniPlaneGen_twE6_three_diag_of_model
    {q : TauCeti.PrimePower}
    (hv : (TauCeti.LieTypeIndex.twistedE6 q).Valid) (hq2 : q.card ≠ 2) (hq3 : q.p ≠ 3)
    {E : Subgroup (MulAut (CFSG.LieType.SeitzGeneration.Cat ⟨.twistedE6 q, hv⟩))} (hE : IsElemAbelian 3 E)
    (hc : Nat.card E = 3 ^ 2) (hout : ¬ InnerPlane ⟨.twistedE6 q, hv⟩ 3 E)
    (K : Type) [Field K] [Finite K] (σ : K ≃+* K) (hK : Nat.card K = (q.p ^ q.exponent) ^ 2)
    (hσ : ∀ c, σ c = c ^ (q.p ^ q.exponent))
    (e : CFSG.LieType.SeitzGeneration.Cat ⟨.twistedE6 q, hv⟩ ≃* twistedE6RootGroup K σ)
    (hdiag : E.map (MulAut.congr e).toMonoidHom ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ)
    (hnpar : ¬ Inputs2311d.IsTwE6DiagParabolicPlane ⟨.twistedE6 q, hv⟩ E) :
    UniPlaneGen q.p E := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hK' : Nat.card K = q.p ^ (2 * q.exponent) := by rw [hK, ← pow_mul, mul_comm]
  have hq2' : q.p ^ q.exponent ≠ 2 := by
    rw [← TauCeti.PrimePower.card_def]
    exact hq2
  have hchar : ringChar K = q.p := ringChar_eq_of_card_pow q.prime_p q.exponent_pos K hK'
  have hK3 : ringChar K ≠ 3 := by
    rw [hchar]
    exact hq3
  set E' := E.map (MulAut.congr e).toMonoidHom with hE'
  have hEi : CFSG.IsElementaryAbelian 3 E' :=
    (CFSG.SectionRank.isElementaryAbelian_iff_isElemAbelian 3 _).mpr
      (CFSG.LieType.SeitzGeneration.isElemAbelian_map_congr e hE)
  have hc' : Nat.card E' = 3 ^ 2 := by
    rw [hE', Subgroup.card_map_of_injective (MulAut.congr e).injective, hc]
  have hnin : ¬ E' ≤ CFSG.Fischer.innerAut (twistedE6RootGroup K σ) :=
    CFSG.LieType.SeitzGeneration.not_le_range_conj_map_congr e hout
  have hnR : ¬ TwE6NormalizesR K σ E' := fun h => hnpar ⟨q, rfl, K, inferInstance, inferInstance, σ, hK,
    hσ, e, hdiag, h⟩
  have h := (uniPlaneGen_map_congr e _ E).1
    (twE6Diag_uniPlaneGen_of_not_normalizes_of_ne_two K σ (q.p ^ q.exponent) hK3 hq2' hσ hK E' hdiag hEi hc' hnin hnR)
  rw [hchar] at h
  simpa using h

theorem uniPlaneGen_twE6_three_diag_odd_of_model
    {q : TauCeti.PrimePower}
    (hv : (TauCeti.LieTypeIndex.twistedE6 q).Valid) (hq2 : q.p ≠ 2) (hq3 : q.p ≠ 3)
    {E : Subgroup (MulAut (CFSG.LieType.SeitzGeneration.Cat ⟨.twistedE6 q, hv⟩))} (hE : IsElemAbelian 3 E)
    (hc : Nat.card E = 3 ^ 2) (hout : ¬ InnerPlane ⟨.twistedE6 q, hv⟩ 3 E)
    (K : Type) [Field K] [Finite K] (σ : K ≃+* K) (hK : Nat.card K = (q.p ^ q.exponent) ^ 2)
    (hσ : ∀ c, σ c = c ^ (q.p ^ q.exponent))
    (e : CFSG.LieType.SeitzGeneration.Cat ⟨.twistedE6 q, hv⟩ ≃* twistedE6RootGroup K σ)
    (hdiag : E.map (MulAut.congr e).toMonoidHom ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ)
    (hnpar : ¬ Inputs2311d.IsTwE6DiagParabolicPlane ⟨.twistedE6 q, hv⟩ E) :
    UniPlaneGen q.p E :=
  uniPlaneGen_twE6_three_diag_of_model hv (fun hcard => hq2 (primePower_card_two hcard).1) hq3 hE hc hout
    K σ hK hσ e hdiag hnpar

theorem uniPlaneGen_twE6_three_diag
    {q : TauCeti.PrimePower}
    (hv : (TauCeti.LieTypeIndex.twistedE6 q).Valid) (hq2 : q.card ≠ 2) (hq3 : q.p ≠ 3)
    {E : Subgroup (MulAut (CFSG.LieType.SeitzGeneration.Cat ⟨.twistedE6 q, hv⟩))} (hE : IsElemAbelian 3 E)
    (hc : Nat.card E = 3 ^ 2) (hout : ¬ InnerPlane ⟨.twistedE6 q, hv⟩ 3 E)
    (hdiag : ∃ (K : Type) (_ : Field K) (_ : Finite K) (σ : K ≃+* K), Nat.card K = (q.p ^ q.exponent) ^ 2 ∧
      (∀ c, σ c = c ^ (q.p ^ q.exponent)) ∧
      ∃ e : CFSG.LieType.SeitzGeneration.Cat ⟨.twistedE6 q, hv⟩ ≃* twistedE6RootGroup K σ,
        E.map (MulAut.congr e).toMonoidHom ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ)
    (hnpar : ¬ Inputs2311d.IsTwE6DiagParabolicPlane ⟨.twistedE6 q, hv⟩ E) :
    UniPlaneGen q.p E := by
  obtain ⟨K, _, _, σ, hK, hσ, e, hdiag⟩ := hdiag
  exact uniPlaneGen_twE6_three_diag_of_model hv hq2 hq3 hE hc hout K σ hK hσ e hdiag hnpar

theorem uniPlaneGen_twE6_three_diag_odd
    {q : TauCeti.PrimePower}
    (hv : (TauCeti.LieTypeIndex.twistedE6 q).Valid) (hq2 : q.p ≠ 2) (hq3 : q.p ≠ 3)
    {E : Subgroup (MulAut (CFSG.LieType.SeitzGeneration.Cat ⟨.twistedE6 q, hv⟩))} (hE : IsElemAbelian 3 E)
    (hc : Nat.card E = 3 ^ 2) (hout : ¬ InnerPlane ⟨.twistedE6 q, hv⟩ 3 E)
    (hdiag : ∃ (K : Type) (_ : Field K) (_ : Finite K) (σ : K ≃+* K), Nat.card K = (q.p ^ q.exponent) ^ 2 ∧
      (∀ c, σ c = c ^ (q.p ^ q.exponent)) ∧
      ∃ e : CFSG.LieType.SeitzGeneration.Cat ⟨.twistedE6 q, hv⟩ ≃* twistedE6RootGroup K σ,
        E.map (MulAut.congr e).toMonoidHom ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ)
    (hnpar : ¬ Inputs2311d.IsTwE6DiagParabolicPlane ⟨.twistedE6 q, hv⟩ E) :
    UniPlaneGen q.p E :=
  uniPlaneGen_twE6_three_diag hv (fun hcard => hq2 (primePower_card_two hcard).1) hq3 hE hc hout
    hdiag hnpar

theorem uniSeitzPlanes_twE6_diag :
    UniSeitzPlanes fun d p E => ¬ InnerPlane d p E ∧ p = 3 ∧
      (∃ q : TauCeti.PrimePower, d.1 = .twistedE6 q ∧ q.card ≠ 2 ∧
        ∃ (K : Type) (_ : Field K) (_ : Finite K) (σ : K ≃+* K),
          Nat.card K = (q.p ^ q.exponent) ^ 2 ∧ (∀ c, σ c = c ^ (q.p ^ q.exponent)) ∧
          ∃ e : CFSG.LieType.SeitzGeneration.Cat d ≃* twistedE6RootGroup K σ,
            E.map (MulAut.congr e).toMonoidHom ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ) ∧
      ¬ Inputs2311d.IsTwE6DiagParabolicPlane d E := by
  rintro ⟨d, hv⟩ p hp hp2 hpd _ E hE hc ⟨hout, rfl, ⟨q, hq, hqcard, hdiag⟩, hnpar⟩
  obtain rfl : d = .twistedE6 q := hq
  have hq3 : q.p ≠ 3 := fun h => hpd (by simp [h])
  simpa using uniPlaneGen_twE6_three_diag hv hqcard hq3 hE hc hout hdiag hnpar

theorem uniSeitzPlanes_twE6_diag_regular :
    UniSeitzPlanes fun d p E => ¬ InnerPlane d p E ∧ p = 3 ∧ d.1.characteristic ≠ 2 ∧
      (∃ q : TauCeti.PrimePower, d.1 = .twistedE6 q ∧ ∃ (K : Type) (_ : Field K) (_ : Finite K)
        (σ : K ≃+* K), Nat.card K = (q.p ^ q.exponent) ^ 2 ∧ (∀ c, σ c = c ^ (q.p ^ q.exponent)) ∧
        ∃ e : CFSG.LieType.SeitzGeneration.Cat d ≃* twistedE6RootGroup K σ,
          E.map (MulAut.congr e).toMonoidHom ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ) ∧
      ¬ Inputs2311d.IsTwE6DiagParabolicPlane d E :=
  UniSeitzPlanes.mono (fun d p E h => by
    obtain ⟨hout, hp3, hch, ⟨q, hq, hdiag⟩, hnpar⟩ := h
    have hqp : q.p ≠ 2 := fun hp2 =>
      hch (by rw [hq, TauCeti.LieTypeIndex.characteristic_twistedE6, hp2])
    exact ⟨hout, hp3, ⟨q, hq, fun hcard => hqp (primePower_card_two hcard).1, hdiag⟩, hnpar⟩)
    uniSeitzPlanes_twE6_diag

theorem uniSeitzPlanes_twE6ThreeOpenDiag_odd :
    UniSeitzPlanes fun d p E => (p = 3 ∧
      (∃ q : TauCeti.PrimePower, d.1 = .twistedE6 q ∧ q.card % 3 = 2 ∧ q.card ≠ 2) ∧
      ¬ InnerPlane d p E ∧
      (∃ q : TauCeti.PrimePower, d.1 = .twistedE6 q ∧ ∃ (K : Type) (_ : Field K) (_ : Finite K)
        (σ : K ≃+* K), Nat.card K = (q.p ^ q.exponent) ^ 2 ∧ (∀ c, σ c = c ^ (q.p ^ q.exponent)) ∧
        ∃ e : CFSG.LieType.SeitzGeneration.Cat d ≃* twistedE6RootGroup K σ,
          E.map (MulAut.congr e).toMonoidHom ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ) ∧
      ¬ Inputs2311d.IsTwE6DiagParabolicPlane d E) ∧ d.1.characteristic ≠ 2 :=
  UniSeitzPlanes.mono (fun _ _ _ ⟨⟨hp3, _, hout, hdiag, hnpar⟩, hch⟩ => ⟨hout, hp3, hch, hdiag, hnpar⟩)
    uniSeitzPlanes_twE6_diag_regular

end RegularUni

