              ∃ a ∈ CFSG.RankThree.PartTwo.Sec19.Asub σ, a ≠ 1 ∧ a ^ 3 = 1 ∧
                CFSG.RankThree.PartTwo.Sec19.tauAut σ a = a ∧
                MulAut.conj a ∈ E.map (MulAut.congr e).toMonoidHom)))

