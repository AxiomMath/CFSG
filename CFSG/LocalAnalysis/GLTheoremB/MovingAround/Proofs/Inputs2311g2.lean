  set N : ℕ := (((Nat.card K : ℤ) ^ 2 + δ * (Nat.card K : ℤ) + 1).natAbs) ^ 2 with hNdef
  set Z0 : Subgroup (ModGL .F4 L) :=
    (f4ThreeZ δ Fr).map (rootDiagUnitHom .F4 L) with hZ0def
