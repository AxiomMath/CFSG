theorem uniClosure_twistedGroup_three {K : Type} [Field K] [Finite K] (σ : K ≃+* K)
    (hσ3 : ∀ c, σ (σ (σ c)) = c) (hK2 : ringChar K ≠ 2) {q : ℕ} (hq : 3 ≤ q)
    (hK : Nat.card K = q ^ 3) (hσq : ∀ c, σ c = c ^ q) (h3q : 3 ∣ q + 1)
    (F : Subgroup (twistedGroup σ.toRingHom)) (hFJ : F ≤ FixedSub σ) (hFp : ∀ x ∈ F, x ^ 3 = 1)
    (hFc : Nat.card F = 3 ^ 2) :
    Subgroup.closure {k | ∃ x ∈ F, x ≠ 1 ∧ Commute k x ∧ ∃ n : ℕ, k ^ (ringChar K ^ n) = 1} = ⊤ := by
  classical
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hq2 : 2 ≤ q := by omega
  have hσ3' : ∀ c, σ.toRingHom (σ.toRingHom (σ.toRingHom c)) = c := hσ3
  have hcardF : Nat.card (fixedField σ.toRingHom) = q :=
    CFSG.GH74.GLS.Stage4.Hex.card_fixedField_of_cube σ.toRingHom hq2 hK hσq
  have hcardX : Nat.card (fixSubfield σ) = q := hcardF
  obtain ⟨M, hM⟩ := exists_sl2_orderOf (fixedField σ.toRingHom) (p := 3)
    (by rw [hcardF]; exact h3q)
  let nh : twistedGroup σ.toRingHom := nHat σ.toRingHom (ng 0) * nHat σ.toRingHom (ng 1)
  let b : twistedGroup σ.toRingHom := slLong σ.toRingHom hσ3' M
  let b₀ : twistedGroup σ.toRingHom := nh * b * nh⁻¹
  let L : Matrix.SpecialLinearGroup (Fin 2) K :=
    Matrix.SpecialLinearGroup.map (fixedField σ.toRingHom).subtype M
  let v : twistedGroup σ.toRingHom := slShort σ.toRingHom hσ3' L
  have hLfix : Matrix.SpecialLinearGroup.map σ.toRingHom L = L := by
    refine Subtype.ext ?_
    ext i j
    simp only [L, Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply,
      Matrix.map_apply]
    exact (M.1 i j).2
  have hnhJ : nh ∈ FixedSub σ :=
    mul_mem (nHat_zero_mem_FixedSub σ hσ3) (nHat_one_mem_FixedSub σ hσ3)
  have hbJ : b ∈ FixedSub σ := slLong_mem_FixedSub σ hσ3 M
  have hb₀J : b₀ ∈ FixedSub σ := mul_mem (mul_mem hnhJ hbJ) (inv_mem hnhJ)
  have hvJ : v ∈ FixedSub σ := slShort_mem_FixedSub σ hσ3 L hLfix
  have hob : orderOf b = 3 := by
    rw [orderOf_injective (slLong σ.toRingHom hσ3') (slLong_injective hσ3') M, hM]
  have hob₀ : orderOf b₀ = 3 := by
    have := orderOf_injective (MulAut.conj nh).toMonoidHom (MulAut.conj nh).injective b
    rw [← hob]
    exact this
  have hoL : orderOf L = 3 := by
    rw [orderOf_injective (Matrix.SpecialLinearGroup.map (n := Fin 2)
      (fixedField σ.toRingHom).subtype) (sl_map_injective _) M, hM]
  have hov : orderOf v = 3 := by
    rw [orderOf_injective (slShort σ.toRingHom hσ3') (slShort_injective hσ3') L, hoL]
  have hb₀theta : ((b₀ : twistedGroup σ.toRingHom) : adjointGroup d4 K) ∈
      (thetaGroup : Subgroup (adjointGroup d4 K)) := by
    have e : ((b₀ : twistedGroup σ.toRingHom) : adjointGroup d4 K) =
        (nHatE K (ng 0) * nHatE K (ng 1)) * (b : adjointGroup d4 K) *
          (nHatE K (ng 0) * nHatE K (ng 1))⁻¹ := by
      have hn0 : (nHat σ.toRingHom (ng 0) : adjointGroup d4 K) = nHatE K (ng 0) := nHat_val _ _
      have hn1 : (nHat σ.toRingHom (ng 1) : adjointGroup d4 K) = nHatE K (ng 1) := nHat_val _ _
      simp only [b₀, nh, Subgroup.coe_mul, Subgroup.coe_inv, hn0, hn1, mul_assoc, mul_inv_rev]
    rw [e]
    exact conj_mem_thetaGroup (slLong_coe_mem_central σ.toRingHom hσ3' M)
  have hAb : ∀ a ∈ (slShort σ.toRingHom hσ3').range, a * b₀ = b₀ * a := by
    rintro _ ⟨B, rfl⟩
    refine Subtype.ext ?_
    exact (commute_thetaGroup_outerRankOne hb₀theta
      (slShort_coe_mem_outer σ.toRingHom hσ3' B)).eq.symm
  have hcomm : Commute b₀ v := (hAb v ⟨L, rfl⟩).symm
  have hnot : v ∉ Subgroup.zpowers b₀ := by
    intro hv'
    obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.1 hv'
    have hLc : L ∈ Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) K) := by
      rw [Subgroup.mem_center_iff]
      intro B
      apply slShort_injective hσ3'
      rw [map_mul, map_mul]
      have h1 : Commute b₀ (slShort σ.toRingHom hσ3' B) := (hAb _ ⟨B, rfl⟩).symm
      have h2 := (h1.zpow_left i).eq
      rw [hi] at h2
      exact h2.symm
    have h2 := CFSG.HardMathSupport.Seitz.TrialityOdd.Inner.sq_eq_one_of_mem_center hLc
    have h3 : orderOf L ∣ 2 := orderOf_dvd_of_pow_eq_one h2
    rw [hoL] at h3
    exact absurd h3 (by norm_num)
  obtain ⟨E₀, hbE, -, hE₀p, hE₀c, hE₀le⟩ := exists_plane_of_commute hob₀ hov hcomm hnot
  have hE₀J : E₀ ≤ FixedSub σ := hE₀le _ hb₀J hvJ
  have hk3 : (3 : ℕ∞) ≤ ENat.card (fixSubfield σ) := by
    have : Finite (fixSubfield σ) := inferInstance
    rw [ENat.card_eq_coe_natCard, hcardX]
    exact_mod_cast hq
  let ε : ↥(FixedSub σ) ≃* ↥(adjointGroup Tag.G2 (fixSubfield σ)) :=
    (fixedSubEquivJ σ hK2 hq2 hK hσq hσ3).trans (trialityFieldImageEquivG2 σ hk3)
  have hkq : 3 ≤ Nat.card (fixSubfield σ) := by rw [hcardX]; exact hq
  have hk1 : 3 ∣ Nat.card (fixSubfield σ) + 1 := by rw [hcardX]; exact h3q
  have hkchar : ringChar (fixSubfield σ) = ringChar K := Algebra.ringChar_eq (fixSubfield σ) K
  obtain ⟨hE₀ea, hE₀cd⟩ := isElemAbelian_map_subgroupOf ε hE₀J hE₀p hE₀c
  obtain ⟨hFea, hFcd⟩ := isElemAbelian_map_subgroupOf ε hFJ hFp hFc
  set T : Set (twistedGroup σ.toRingHom) := {k | ∃ x ∈ E₀, x ≠ 1 ∧ Commute k x ∧
    ∃ n : ℕ, k ^ (ringChar K ^ n) = 1} with hT
  have hJgen : Subgroup.closure {k : FixedSub σ | ∃ x ∈ E₀.subgroupOf (FixedSub σ), x ≠ 1 ∧
      Commute k x ∧ ∃ n : ℕ, k ^ (ringChar K ^ n) = 1} = ⊤ := by
    refine uniClosure_eq_top_of_mulEquiv ε _ ?_
    have := g2ThreeUniNative_plus (K := fixSubfield σ) hk1 hkq
      ((E₀.subgroupOf (FixedSub σ)).map ε.toMonoidHom) hE₀ea.2 hE₀cd
    rwa [hkchar] at this
  have hJle : FixedSub σ ≤ Subgroup.closure T := by
    have h1 : (Subgroup.closure {k : FixedSub σ | ∃ x ∈ E₀.subgroupOf (FixedSub σ), x ≠ 1 ∧
        Commute k x ∧ ∃ n : ℕ, k ^ (ringChar K ^ n) = 1}).map (FixedSub σ).subtype ≤
        Subgroup.closure T := by
      rw [MonoidHom.map_closure]
      refine Subgroup.closure_mono ?_
      rintro _ ⟨k, ⟨x, hx, hx1, hk, n, hn⟩, rfl⟩
      refine ⟨(x : twistedGroup σ.toRingHom), hx, fun h => hx1 (Subtype.ext h), ?_, n, ?_⟩
      · exact Subtype.ext_iff.1 hk.eq
      · have := congrArg Subtype.val hn
        rw [Subgroup.coe_subtype]
        exact this
    rw [hJgen, Subgroup.map_top, Subgroup.range_subtype] at h1
    exact h1
  have hb₀1 : b₀ ≠ 1 := by
    intro h1
    rw [h1, orderOf_one] at hob₀
    exact absurd hob₀ (by norm_num)
  have hAle : (slShort σ.toRingHom hσ3').range ≤ Subgroup.closure T := by
    rintro _ ⟨B, rfl⟩
    have hB : B ∈ Subgroup.closure {x : Matrix.SpecialLinearGroup (Fin 2) K | x ^ ringChar K = 1} := by
      rw [sl2_closure_pow_ringChar_eq_top]
      exact Subgroup.mem_top B
    have h1 := Subgroup.mem_map_of_mem (slShort σ.toRingHom hσ3') hB
    rw [MonoidHom.map_closure] at h1
    refine Subgroup.closure_mono ?_ h1
    rintro _ ⟨x, hx, rfl⟩
    exact ⟨b₀, hbE, hb₀1, hAb _ ⟨x, rfl⟩, 1, by rw [pow_one, ← map_pow, hx, map_one]⟩
  have hJA : FixedSub σ ⊔ (slShort σ.toRingHom hσ3').range = ⊤ := by
    have h := CFSG.ClassicalInvolution.G2D4Models.range_slLong_sup_range_slShort hσ3'
    rw [eq_top_iff, ← h]
    refine sup_le_sup_right ?_ _
    rintro _ ⟨A, rfl⟩
    exact slLong_mem_FixedSub σ hσ3 A
  have htop₀ : Subgroup.closure T = ⊤ := by
    rw [eq_top_iff, ← hJA]
    exact sup_le hJle hAle
  obtain ⟨x, hx⟩ := exists_conj_of_plane_G2 (fixSubfield σ) hkq hk1 _ _ hE₀ea hE₀cd hFea hFcd
  have hFE := eq_map_conj_of_map_subgroupOf ε hE₀J hFJ x hx
  rw [hFE, uniClosure_map_conj, htop₀, Subgroup.map_top_of_surjective _ (MulAut.conj _).surjective]

theorem uniClosure_d4PlaneInTorusMinus_three (ℓ f : ℕ) (hℓ : ℓ.Prime) (hℓ2 : ℓ ≠ 2) (hf : 1 ≤ f)
    (K : Type) [Field K] [Finite K] (hK : Nat.card K = (ℓ ^ f) ^ 3) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ (ℓ ^ f)) (h3ℓ : 3 ≠ ℓ) (h3q : 3 ∣ ℓ ^ f + 1)
    (E : Subgroup (graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) (hEea : CFSG.IsElementaryAbelian 3 E)
    (hEc : Nat.card E = 3 ^ 2) (hT0 : CFSG.GH74.GLS.Stage2.Bender.Thm1.D4PlaneInTorusMinus ℓ f hℓ K σ E) :
    Subgroup.closure {k | ∃ x ∈ E, x ≠ 1 ∧ Commute k x ∧ ∃ n : ℕ, k ^ (ringChar K ^ n) = 1} = ⊤ := by
  have : Fact ℓ.Prime := ⟨hℓ⟩
  obtain ⟨L, _, _, _, _, g₀, ⟨-, hg₀P, -⟩, β, hβ⟩ := hT0
  have : IsAlgClosed L := IsAlgClosure.isAlgClosed K
  set E' := E.map (β⁻¹).toMonoidHom with hE'
  have hE'3 : ∀ y ∈ E', y ^ 3 = 1 := by
    rintro _ ⟨e, he, rfl⟩
    change (β⁻¹ e) ^ 3 = 1
    rw [← map_pow, CFSG.elemPow_eq_one_of_isElementaryAbelian e he, map_one]
  have hE'c : Nat.card E' = 3 ^ 2 := by
    rw [hE', Subgroup.card_map_of_injective (β⁻¹).injective, hEc]
  have hfix : ∀ y ∈ E', fieldActor (t := TwistTag.D4) σ σ y = y := by
    rintro _ ⟨e, he, rfl⟩
    exact fieldActor_eq_of_twistedTorus σ hσ h3q hg₀P _ (hE'3 _ ⟨e, he, rfl⟩) (hβ e he)
  have hK3 : Nat.card K = ℓ ^ (f * 3) := by rw [hK, ← pow_mul]
  have : CharP K ℓ :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic hℓ (by omega) hK3
  have hK2 : ringChar K ≠ 2 := by rw [ringChar.eq K ℓ]; exact hℓ2
  have hq3 : 3 ≤ ℓ ^ f := by
    have h5 : 5 ≤ ℓ := by
      have := hℓ.two_le
      have h4 : ℓ ≠ 4 := fun h => by rw [h] at hℓ; norm_num at hℓ
      omega
    calc 3 ≤ ℓ := by omega
      _ = ℓ ^ 1 := (pow_one ℓ).symm
      _ ≤ ℓ ^ f := Nat.pow_le_pow_right hℓ.pos hf
  have hσ3 : ∀ c, σ (σ (σ c)) = c := ringEquiv_cube_apply_eq hK hσ
  have hq2 : 2 ≤ ℓ ^ f := by omega
  let φ : twistedGroup σ.toRingHom →* graphFixedRootGroup TwistTag.D4 K σ.toRingHom :=
    (twistedIncl σ.toRingHom).codRestrict _ fun z => twistedIncl_mem_root σ hK2 hq2 hK hσ z
  have hφ : Function.Bijective φ := by
    refine ⟨fun a b h => twistedIncl_injective σ.toRingHom ?_, ?_⟩
    · have h' := congrArg Subtype.val h
      exact h'
    rintro ⟨g, hg⟩
    have h := CFSG.LieType.Steinberg.CentralExt.TrialityClosed.map_twistedGroup_eq_graphFixedRootGroup
      (σ := σ.toRingHom) hK2 hq2 hK hσ
    rw [← h] at hg
    obtain ⟨a, ha, rfl⟩ := hg
    exact ⟨⟨a, ha⟩, rfl⟩
  let eR := MulEquiv.ofBijective φ hφ
  set F := E'.map eR.symm.toMonoidHom with hF
  have hFJ : F ≤ FixedSub σ := by
    rintro _ ⟨y, hy, rfl⟩
    rw [← mem_J_iff σ hK2 hq2 hK hσ hσ3]
    have h1 : twistedIncl σ.toRingHom (eR.symm.toMonoidHom y) =
        ((eR (eR.symm y) : graphFixedRootGroup TwistTag.D4 K σ.toRingHom) :
          ModGL TwistTag.D4.tag K) := rfl
    rw [h1, MulEquiv.apply_symm_apply]
    exact (CFSG.GH74.GLS.Stage2.Bender.Thm1.d4_mem_trialityFieldImage_self_iff σ hσ3 y).2
      (hfix y hy)
  have hFp : ∀ x ∈ F, x ^ 3 = 1 := by
    rintro _ ⟨y, hy, rfl⟩
    change (eR.symm y) ^ 3 = 1
    rw [← map_pow, hE'3 y hy, map_one]
  have hFc : Nat.card F = 3 ^ 2 := by
    rw [hF, Subgroup.card_map_of_injective eR.symm.injective, hE'c]
  have hgen := uniClosure_twistedGroup_three σ hσ3 hK2 hq3 hK hσ h3q F hFJ hFp hFc
  have hE'gen := uniClosure_eq_top_of_mulEquiv eR.symm E' hgen
  exact uniClosure_eq_top_of_mulEquiv (β⁻¹) E hE'gen

theorem uniPlaneGen_of_inner_uniClosure {C : Type*} [Group C]
    (hinj : Function.Injective (MulAut.conj : C →* MulAut C)) {r : ℕ} {E : Subgroup (MulAut C)}
    (hin : E ≤ (MulAut.conj : C →* MulAut C).range)
    (htop : Subgroup.closure {k : C | ∃ x ∈ E.comap (MulAut.conj : C →* MulAut C), x ≠ 1 ∧ Commute k x ∧
      ∃ n : ℕ, k ^ (r ^ n) = 1} = ⊤) : UniPlaneGen r E := by
  rw [UniPlaneGen, eq_top_iff, ← htop, Subgroup.closure_le]
  rintro k ⟨x, hx, hx1, hkx, n, hn⟩
  refine mem_uniPlaneClosure (e := MulAut.conj x) hx (fun h => hx1 ?_) ?_ hn
  · exact hinj (h.trans (map_one _).symm)
  · rw [MulAut.conj_apply, ← hkx.eq]
    group

theorem uniPlaneGen_triality_three_twistedTorus {q : TauCeti.PrimePower}
    (hv : (TauCeti.LieTypeIndex.trialityD4 q).Valid) (hq2 : q.p ≠ 2) (hq3 : q.p ≠ 3)
    (h3q : 3 ∣ q.card + 1)
    {E : Subgroup (MulAut (CFSG.LieType.SeitzGeneration.Cat ⟨.trialityD4 q, hv⟩))} (hE : IsElemAbelian 3 E)
    (hc : Nat.card E = 3 ^ 2) (hin : InnerPlane ⟨.trialityD4 q, hv⟩ 3 E)
    (K : Type) [Field K] [Finite K] (σ : K ≃+* K) (hK : Nat.card K = (q.p ^ q.exponent) ^ 3)
    (hσ : ∀ c, σ c = c ^ (q.p ^ q.exponent))
    (e : CFSG.LieType.SeitzGeneration.Cat ⟨.trialityD4 q, hv⟩ ≃* graphFixedRootGroup TwistTag.D4 K σ.toRingHom)
    (hT : CFSG.GH74.GLS.Stage2.Bender.Thm1.D4PlaneInTorusMinus q.p q.exponent q.prime_p K σ
      ((E.comap (MulAut.conj : CFSG.LieType.SeitzGeneration.Cat ⟨.trialityD4 q, hv⟩ →* _)).map e.toMonoidHom)) :
    UniPlaneGen q.p E := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hK3 : Nat.card K = q.p ^ (q.exponent * 3) := by rw [hK, pow_mul]
  haveI : CharP K q.p :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic q.prime_p (by
      have := q.exponent_pos; omega) hK3
  have hring : ringChar K = q.p := ringChar.eq K q.p
  have hZ : Subgroup.center ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom) = ⊥ :=
    center_graphFixedRootGroup_eq_bot σ.surjective
  have hinj := conj_injective_of_mulEquiv e
    (CFSG.LieType.SeitzGeneration.conj_injective_of_center_eq_bot hZ)
  set E₀C := E.comap (MulAut.conj : CFSG.LieType.SeitzGeneration.Cat ⟨.trialityD4 q, hv⟩ →* _) with hE₀C
  have hE₀C : IsElemAbelian 3 E₀C := isElemAbelian_comap_conj hinj hE
  have hmap : E₀C.map (MulAut.conj : CFSG.LieType.SeitzGeneration.Cat ⟨.trialityD4 q, hv⟩ →* _) = E :=
    Subgroup.map_comap_eq_self hin
  have hE₀Cc : Nat.card E₀C = 3 ^ 2 := by
    rw [← Subgroup.card_map_of_injective hinj, hmap, hc]
  set E₀ := E₀C.map e.toMonoidHom with hE₀
  have hE₀ea : CFSG.IsElementaryAbelian 3 E₀ :=
    (CFSG.SectionRank.isElementaryAbelian_iff_isElemAbelian 3 _).mpr
      (CFSG.PreuniquenessRankFour.Helpers.elementary_abelian_map 3 hE₀C e.toMonoidHom)
  have hE₀c : Nat.card E₀ = 3 ^ 2 := by
    rw [hE₀, Subgroup.card_map_of_injective e.injective, hE₀Cc]
  have h3ℓ : 3 ≠ q.p := fun h => hq3 h.symm
  have h3q' : 3 ∣ q.p ^ q.exponent + 1 := by rw [← TauCeti.PrimePower.card_def]; exact h3q
  have htop := uniClosure_d4PlaneInTorusMinus_three q.p q.exponent q.prime_p hq2 q.exponent_pos K hK σ hσ
    h3ℓ h3q' E₀ hE₀ea hE₀c hT
  rw [hring] at htop
  exact uniPlaneGen_of_inner_uniClosure hinj hin (uniClosure_eq_top_of_mulEquiv e E₀C htop)

theorem uniSeitzPlanes_triality_three_twistedTorus :
    UniSeitzPlanes fun d p E => InnerPlane d p E ∧ p = 3 ∧ d.1.characteristic ≠ 2 ∧
      ∃ q : TauCeti.PrimePower, d.1 = .trialityD4 q ∧ 3 ∣ q.card + 1 ∧
        ∃ (K : Type) (_ : Field K) (_ : Finite K) (σ : K ≃+* K), Nat.card K = (q.p ^ q.exponent) ^ 3 ∧
          (∀ c, σ c = c ^ (q.p ^ q.exponent)) ∧
          ∃ e : CFSG.LieType.SeitzGeneration.Cat d ≃* graphFixedRootGroup TwistTag.D4 K σ.toRingHom,
            CFSG.GH74.GLS.Stage2.Bender.Thm1.D4PlaneInTorusMinus q.p q.exponent q.prime_p K σ
              ((E.comap (MulAut.conj : CFSG.LieType.SeitzGeneration.Cat d →* _)).map e.toMonoidHom) := by
  rintro ⟨d, hv⟩ p hp hp2 hpd _ E hE hc ⟨hin, rfl, hch, q, hq, h3q, K, _, _, σ, hK, hσ, e, hT⟩
  obtain rfl : d = .trialityD4 q := hq
  have hq3 : q.p ≠ 3 := fun h => hpd (by simp [h])
  have hq2 : q.p ≠ 2 := fun h => hch (by simp [h])
  simpa using uniPlaneGen_triality_three_twistedTorus hv hq2 hq3 h3q hE hc hin K σ hK hσ e hT

