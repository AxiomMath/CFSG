  have hpq' : p ≠ q.p := fun h => hpd (by rw [LieTypeIndex.characteristic_E8]; exact h)
  rcases hcls with h5 | h10 | hcnt
  · exact uniPlaneGen_E8_of_native hv hch (fun K _ _ hKq _ E₀ h1 h2 _ =>
      e8Phi5UniNative K hp (by rw [hKq]; exact h5) E₀ h1 h2) hE hc hin hn
  · exact uniPlaneGen_E8_of_native hv hch (fun K _ _ hKq _ E₀ h1 h2 _ =>
      e8Phi10UniNative K hp hp5 (by rw [hKq]; exact h10) E₀ h1 h2) hE hc hin hn
  · exact (false_of_inner_plane_of_rankLE1 hp (conj_injective_cat_E8 q hv)
      (rankLE1_cat_E8 q hv hp hpq' hcnt) hE hc hin).elim

theorem uniSeitzPlanes_E6_inner_five_vacuous :
