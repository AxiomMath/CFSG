theorem card_efac {n : ℕ} {K : Type} [Field K] [Finite K] {x : Module.End K (Fin n → K)}
    (b : primaryFactors x) : Nat.card (Efac x b) = Nat.card K ^ (b : K[X]).natDegree := by
  classical
  have hb : (b : K[X]) ≠ 0 := (irreducible_of_mem_primaryFactors b.2).ne_zero
  have := Fintype.ofFinite K
  have : Module.Finite K (Efac x b) := (AdjoinRoot.powerBasis hb).finite
  have : Finite (Efac x b) := Module.finite_of_finite K
  have := Fintype.ofFinite (Efac x b)
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, Module.card_eq_pow_finrank (K := K),
    (AdjoinRoot.powerBasis hb).finrank, AdjoinRoot.powerBasis_dim]

theorem eq_zero_or_eq_one_of_card_two {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2)
    (a : K) : a = 0 ∨ a = 1 := by
  classical
  have := Fintype.ofFinite K
  by_contra h
  push Not at h
  have h3 : ({0, 1, a} : Finset K).card = 3 := by
    rw [Finset.card_insert_of_notMem (by simp [h.1.symm]), Finset.card_pair h.2.symm]
  have := Finset.card_le_univ ({0, 1, a} : Finset K)
  rw [h3, ← Nat.card_eq_fintype_card, hK] at this
  omega

theorem exists_goodBlock {n : ℕ} {K : Type} [Field K] [Finite K] {x : Module.End K (Fin n → K)}
    (hx : Squarefree (minpoly K x)) {c : K} (hc0 : c ≠ 0)
    (hc : Polynomial.aeval x (Polynomial.X ^ 3 - Polynomial.C c) = 0) (h3 : (3 : K) ≠ 0)
    (hn : 4 ≤ n) (hK : 4 ≤ Nat.card K ∨ 5 ≤ n) :
    ∃ b : primaryFactors x, CFSG.RankThree.PartOne.KCLinPlane.GoodBlock b := by
  classical
  by_contra h
  push Not at h
  have hbad : ∀ b : primaryFactors x, mult x b ≤ 2 ∧ (2 ≤ mult x b → Nat.card (Efac x b) ≤ 3) := by
    intro b
    have := h b
    unfold CFSG.RankThree.PartOne.KCLinPlane.GoodBlock at this
    push Not at this
    exact ⟨by omega, fun h2 => by have := this.2 h2; omega⟩
  have hK2 : 2 ≤ Nat.card K := by
    have := Fintype.ofFinite K
    rw [Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  set T : Finset (primaryFactors x) := Finset.univ.filter (fun b => mult x b = 2) with hT
  have hterm : ∀ b : primaryFactors x, (b : K[X]).natDegree * primaryMultiplicity x (b : K[X]) ≤
      (b : K[X]).natDegree + if mult x b = 2 then 1 else 0 := by
    intro b
    obtain ⟨hb2, hbE⟩ := hbad b
    have hdeg1 : 1 ≤ (b : K[X]).natDegree :=
      Polynomial.natDegree_pos_iff_degree_pos.2
        (Polynomial.degree_pos_of_irreducible (irreducible_of_mem_primaryFactors b.2))
    by_cases hm : mult x b = 2
    · have hE := hbE (by omega)
      rw [card_efac] at hE
      have hd : (b : K[X]).natDegree = 1 := by
        by_contra hd
        have h4 : Nat.card K ^ 2 ≤ Nat.card K ^ (b : K[X]).natDegree :=
          Nat.pow_le_pow_right (by omega) (by omega)
        nlinarith
      simp [hm, hd]
    · simp only [hm, if_false, add_zero]
      have : primaryMultiplicity x (b : K[X]) ≤ 1 := by
        have := hb2
        unfold mult at this hm
        omega
      calc (b : K[X]).natDegree * primaryMultiplicity x (b : K[X])
          ≤ (b : K[X]).natDegree * 1 := Nat.mul_le_mul_left _ this
        _ = (b : K[X]).natDegree := mul_one _
  have h1 := finrank_eq_sum_degree_mul_multiplicity hx
  rw [Module.finrank_fin_fun] at h1
  have hsum : n ≤ ∑ b : primaryFactors x, (b : K[X]).natDegree + T.card := by
    have h2 : ∑ b : primaryFactors x, (b : K[X]).natDegree * primaryMultiplicity x (b : K[X]) ≤
        ∑ b : primaryFactors x, (b : K[X]).natDegree + T.card := by
      rw [hT, Finset.card_filter, ← Finset.sum_add_distrib]
      exact Finset.sum_le_sum fun b _ => hterm b
    omega
  have hdeg : ∑ b : primaryFactors x, (b : K[X]).natDegree ≤ 3 := by
    have h3' : ∑ a : primaryFactors x, (a : K[X]).natDegree = (minpoly K x).natDegree := by
      rw [← prod_primaryFactors hx, Polynomial.natDegree_prod _ _
        (fun a ha => (irreducible_of_mem_primaryFactors ha).ne_zero)]
      exact Finset.sum_coe_sort (primaryFactors x) fun a => a.natDegree
    have hne : (Polynomial.X ^ 3 - Polynomial.C c : K[X]) ≠ 0 :=
      Polynomial.X_pow_sub_C_ne_zero (by norm_num) c
    rw [h3']
    calc (minpoly K x).natDegree ≤ (Polynomial.X ^ 3 - Polynomial.C c : K[X]).natDegree :=
          Polynomial.natDegree_le_of_dvd (minpoly.dvd K x hc) hne
      _ = 3 := Polynomial.natDegree_X_pow_sub_C
  rcases hK with hK4 | hn5
  ·
    have hT0 : T.card = 0 := by
      rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
      intro b _ hm
      have hE := (hbad b).2 (by omega)
      have hle : Nat.card K ≤ Nat.card (Efac x b) := by
        have : Finite (Efac x b) := by
          have : Module.Finite K (Efac x b) := (AdjoinRoot.powerBasis
            (irreducible_of_mem_primaryFactors b.2).ne_zero).finite
          exact Module.finite_of_finite K
        exact Nat.card_le_card_of_injective _ (algebraMap K (Efac x b)).injective
      omega
    omega
  ·
    have hKc : Nat.card K ≠ 3 := by
      intro hK3
      apply h3
      have := Fintype.ofFinite K
      have hch : ringChar K = 3 := by
        obtain ⟨k, hp, hk⟩ := FiniteField.card K (ringChar K)
        rw [← Nat.card_eq_fintype_card, hK3] at hk
        have hd : ringChar K ∣ 3 := by
          rw [hk]
          exact dvd_pow_self _ k.ne_zero
        exact (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).1 hd
      have := ringChar.Nat.cast_ringChar (R := K)
      rw [hch] at this
      exact_mod_cast this
    have hT1 : T.card ≤ 1 := by
      rw [Finset.card_le_one]
      intro b hb b' hb'
      rw [hT, Finset.mem_filter] at hb hb'
      have key : ∀ a : primaryFactors x, mult x a = 2 →
          (a : K[X]) = Polynomial.X - Polynomial.C 1 := by
        intro a ha
        have hE := (hbad a).2 (by omega)
        rw [card_efac] at hE
        have hdeg1 : 1 ≤ (a : K[X]).natDegree :=
          Polynomial.natDegree_pos_iff_degree_pos.2
            (Polynomial.degree_pos_of_irreducible (irreducible_of_mem_primaryFactors a.2))
        have hd : (a : K[X]).natDegree = 1 := by
          by_contra hd
          have h4 : Nat.card K ^ 2 ≤ Nat.card K ^ (a : K[X]).natDegree :=
            Nat.pow_le_pow_right (by omega) (by omega)
          nlinarith
        have hK2' : Nat.card K = 2 := by
          rw [hd, pow_one] at hE
          omega
        have hmon := (mem_primaryFactors.1 a.2).2.1
        have hform := hmon.eq_X_add_C hd
        have hdvd : (a : K[X]) ∣ Polynomial.X ^ 3 - Polynomial.C c :=
          (mem_primaryFactors.1 a.2).2.2.trans (minpoly.dvd K x hc)
        have hroot : (Polynomial.X ^ 3 - Polynomial.C c : K[X]).IsRoot (-(a : K[X]).coeff 0) := by
          refine Polynomial.IsRoot.dvd ?_ hdvd
          rw [hform]
          simp
        simp only [Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_pow,
          Polynomial.eval_X, Polynomial.eval_C] at hroot
        have hne : -(a : K[X]).coeff 0 ≠ 0 := by
          intro h0
          rw [h0] at hroot
          simp at hroot
          exact hc0 hroot
        rcases eq_zero_or_eq_one_of_card_two hK2' (-(a : K[X]).coeff 0) with h0 | h1'
        · exact absurd h0 hne
        · rw [hform, show (a : K[X]).coeff 0 = -1 by rw [← neg_neg ((a : K[X]).coeff 0), h1'],
            map_neg, sub_eq_add_neg]
      exact Subtype.ext ((key b hb.2).trans (key b' hb'.2).symm)
    omega

theorem exists_noncomm_of_isQuasisimple {Q : Type} [Group Q] (hQ : CFSG.IsQuasisimple Q) :
    ∃ a b : Q, a * b ≠ b * a := by
  obtain ⟨-, -, a, b, hab⟩ := hQ
  obtain ⟨a', rfl⟩ := QuotientGroup.mk_surjective a
  obtain ⟨b', rfl⟩ := QuotientGroup.mk_surjective b
  exact ⟨a', b', fun h => hab (by rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, h])⟩

theorem not_isPSolvable_proj_range {n : ℕ} {K : Type} [Field K] [Finite K]
    {Q : Type} [Group Q] [Finite Q] (hQ : CFSG.IsQuasisimple Q) (h3 : 3 ∣ Nat.card Q)
    (ι : Q →* Matrix.SpecialLinearGroup (Fin n) K) (hι : Function.Injective ι) :
    ¬ CFSG.HallHigman.IsPSolvable 3 ↥((proj n K).comp ι).range := by
  refine not_isPSolvable_range_of_quasisimple hQ h3 _ ?_
  by_contra hall
  push Not at hall
  obtain ⟨a, b, hab⟩ := exists_noncomm_of_isQuasisimple hQ
  have ha : ι a ∈ Subgroup.center (Matrix.SpecialLinearGroup (Fin n) K) :=
    scalars_le_center n K (proj_eq_one_iff.1 (hall a))
  apply hab
  apply hι
  rw [map_mul, map_mul]
  exact (Subgroup.mem_center_iff.1 ha (ι b)).symm

theorem not_isPSolvable_fixSubgroup_conjAut {n : ℕ} {K : Type} [Field K] [Finite K]
    (hn : 4 ≤ n) (hK : 4 ≤ Nat.card K ∨ 5 ≤ n) (h3 : (3 : K) ≠ 0) {A : GL (Fin n) K} {c : Kˣ}
    (hA : A ^ 3 = Matrix.GeneralLinearGroup.scalar (Fin n) c) :
    ¬ CFSG.HallHigman.IsPSolvable 3 ↥(fixSubgroup (conjAut n K A)) := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set X := Matrix.toLin' (A : Matrix (Fin n) (Fin n) K) with hX
  have hMp : (A : Matrix (Fin n) (Fin n) K) ^ 3 = algebraMap K (Matrix (Fin n) (Fin n) K) c := by
    have h1 : ((A ^ 3 : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) =
        (A : Matrix (Fin n) (Fin n) K) ^ 3 := Units.val_pow_eq_pow_val _ _
    rw [← h1, hA, Matrix.GeneralLinearGroup.coe_scalar]
    rfl
  have haeval : Polynomial.aeval X (Polynomial.X ^ 3 - Polynomial.C (c : K)) = 0 := by
    have hX' : X = Matrix.toLinAlgEquiv' (A : Matrix (Fin n) (Fin n) K) :=
      (toLinAlgEquiv'_eq_toLin' _).symm
    rw [hX']
    simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
    rw [← map_pow, hMp, AlgEquiv.commutes, sub_self]
  have h3' : ((3 : ℕ) : K) ≠ 0 := by exact_mod_cast h3
  have hx_sq : Squarefree (minpoly K X) :=
    squarefree_minpoly_of_aeval_eq_zero
      (Polynomial.separable_X_pow_sub_C (c : K) h3' c.ne_zero).squarefree haeval
  obtain ⟨b, hgood⟩ := exists_goodBlock hx_sq c.ne_zero haeval h3 hn hK
  have hb : 2 ≤ mult X b := by
    rcases hgood with h | ⟨h, -⟩ <;> omega
  set B : Subgroup (GL (Fin n) K) := blockImage hx_sq b with hB
  have hBq : CFSG.IsQuasisimple ↥B :=
    CFSG.RankThree.PartOne.KCLinPlane.isQuasisimple_blockImage_of_good hx_sq b hgood
  have hBdet : B ≤ (Matrix.SpecialLinearGroup.toGL :
      Matrix.SpecialLinearGroup (Fin n) K →* GL (Fin n) K).range :=
    CFSG.RankThree.PartOne.KCLinPlane.blockImage_le_range_toGL_of_good hx_sq b hgood
  have hBC : B ≤ Subgroup.centralizer ({A} : Set (GL (Fin n) K)) := by
    rw [← range_commutantUnitsToGL_eq_centralizer (x := X) A rfl]
    exact blockImage_le_range hx_sq b
  have h3B : 3 ∣ Nat.card ↥B := by
    obtain ⟨r, hr3, hr0⟩ := exists_sl_cube (F := Efac X b) (mult X b) hb
    have hr1 : r ≠ 1 := ne_one_of_entry_zero (by omega) hr0
    set g := blockTheta hx_sq (blockEmbed (Efac X) (mult X) b r) with hg
    have hgB : g ∈ B := mem_blockImage.2 ⟨r, rfl⟩
    have hgpow : g ^ 3 = 1 := by
      rw [hg, ← map_pow, ← map_pow, hr3, map_one, map_one]
    have hg3 : (⟨g, hgB⟩ : ↥B) ^ 3 = 1 :=
      Subtype.ext (by rw [SubgroupClass.coe_pow]; exact hgpow)
    have hg1 : (⟨g, hgB⟩ : ↥B) ≠ 1 := by
      intro h1
      apply hr1
      have h2 : g = 1 := congrArg Subtype.val h1
      rw [hg] at h2
      exact blockEmbed_injective (E := Efac X) (m := mult X) b
        ((blockTheta_injective hx_sq) (h2.trans (map_one _).symm) |>.trans (map_one _).symm)
    have hord : orderOf (⟨g, hgB⟩ : ↥B) = 3 := orderOf_eq_prime hg3 hg1
    rw [← hord]
    exact orderOf_dvd_natCard _
  set toGL : Matrix.SpecialLinearGroup (Fin n) K →* GL (Fin n) K :=
    Matrix.SpecialLinearGroup.toGL with htoGL
  set B' : Subgroup (Matrix.SpecialLinearGroup (Fin n) K) := B.comap toGL with hB'
  have hB'map : B'.map toGL = B := Subgroup.map_comap_eq_self hBdet
  let eB : ↥B' ≃* ↥B := (Subgroup.equivMapOfInjective B' toGL
    Matrix.SpecialLinearGroup.toGL_injective).trans (MulEquiv.subgroupCongr hB'map)
  have hB'q : CFSG.IsQuasisimple ↥B' := CFSG.LocalCores.isQuasisimple_of_mulEquiv eB.symm hBq
  have h3B' : 3 ∣ Nat.card ↥B' := by rw [Nat.card_congr eB.toEquiv]; exact h3B
  have hrange : ((proj n K).comp B'.subtype).range ≤ fixSubgroup (conjAut n K A) := by
    rintro _ ⟨h, rfl⟩
    rw [mem_fixSubgroup, MonoidHom.comp_apply, conjAut_proj]
    congr 1
    apply Subtype.ext
    rw [coe_slConjugation]
    have hc : toGL (h : Matrix.SpecialLinearGroup (Fin n) K) ∈
        Subgroup.centralizer ({A} : Set (GL (Fin n) K)) := hBC h.2
    rw [Subgroup.mem_centralizer_singleton_iff] at hc
    have hc' : (A : Matrix (Fin n) (Fin n) K) * ((h : Matrix.SpecialLinearGroup (Fin n) K) :
        Matrix (Fin n) (Fin n) K) = ((h : Matrix.SpecialLinearGroup (Fin n) K) :
          Matrix (Fin n) (Fin n) K) * (A : Matrix (Fin n) (Fin n) K) := by
      have := congrArg (fun u : GL (Fin n) K => (u : Matrix (Fin n) (Fin n) K)) hc
      simpa [htoGL] using this.symm
    change (A : Matrix (Fin n) (Fin n) K) * ((h : Matrix.SpecialLinearGroup (Fin n) K) :
        Matrix (Fin n) (Fin n) K) * ((A⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) =
        ((h : Matrix.SpecialLinearGroup (Fin n) K) : Matrix (Fin n) (Fin n) K)
    rw [hc', Matrix.mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.mul_one]
  intro hs
  exact not_isPSolvable_proj_range hB'q h3B' B'.subtype B'.subtype_injective
    (isPSolvable_of_le hs hrange)

theorem not_isPSolvable_fixSubgroup_fieldAut {n : ℕ} {K : Type} [Field K] [Finite K] (hn : 3 ≤ n)
    (σ : K ≃+* K) : ¬ CFSG.HallHigman.IsPSolvable 3 ↥(fixSubgroup (fieldAut n K σ)) := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have := Fintype.ofFinite K
  haveI : Fact (ringChar K).Prime := ⟨CharP.char_is_prime K (ringChar K)⟩
  set c : ZMod (ringChar K) →+* K := ZMod.castHom (dvd_refl (ringChar K)) K with hc
  have hcinj : Function.Injective c := c.injective
  set ι : Matrix.SpecialLinearGroup (Fin n) (ZMod (ringChar K)) →*
      Matrix.SpecialLinearGroup (Fin n) K := Matrix.SpecialLinearGroup.map c with hι
  have hιinj : Function.Injective ι := by
    intro g h hgh
    apply Subtype.ext
    ext i j
    have := congrArg (fun u : Matrix.SpecialLinearGroup (Fin n) K =>
      (u : Matrix (Fin n) (Fin n) K) i j) hgh
    simp only [hι, Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply,
      Matrix.map_apply] at this
    exact hcinj this
  have hQ : CFSG.IsQuasisimple (Matrix.SpecialLinearGroup (Fin n) (ZMod (ringChar K))) :=
    CFSG.RankThree.PartOne.KCUnitary.isQuasisimple_SL (by omega) (Or.inl hn)
  have h3 := three_dvd_card_sl (F := ZMod (ringChar K)) (m := n) (by omega)
  have hrange : ((proj n K).comp ι).range ≤ fixSubgroup (fieldAut n K σ) := by
    rintro _ ⟨g, rfl⟩
    rw [mem_fixSubgroup, MonoidHom.comp_apply, fieldAut_proj]
    congr 1
    apply Subtype.ext
    ext i j
    simp only [hι, Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply,
      Matrix.map_apply]
    exact RingHom.congr_fun (Subsingleton.elim (σ.toRingHom.comp c) c) _
  intro hs
  exact not_isPSolvable_proj_range hQ h3 ι hιinj (isPSolvable_of_le hs hrange)

theorem fixSubgroup_conj {G : Type*} [Group G] (h α : MulAut G) :
    fixSubgroup (h * α * h⁻¹) = (fixSubgroup α).map h.toMonoidHom := by
  ext x
  rw [mem_fixSubgroup, Subgroup.mem_map]
  constructor
  · intro hx
    refine ⟨h⁻¹ x, ?_, by simp⟩
    rw [mem_fixSubgroup]
    have hx' : h (α (h⁻¹ x)) = x := hx
    calc α (h⁻¹ x) = h⁻¹ (h (α (h⁻¹ x))) := by simp
      _ = h⁻¹ x := by rw [hx']
  · rintro ⟨y, hy, rfl⟩
    rw [mem_fixSubgroup] at hy
    simp [MulAut.mul_apply, hy]

theorem fixSubgroup_congr {G H : Type*} [Group G] [Group H] (e : G ≃* H) (α : MulAut G) :
    fixSubgroup (MulAut.congr e α) = (fixSubgroup α).map e.toMonoidHom := by
  ext y
  rw [mem_fixSubgroup, Subgroup.mem_map]
  constructor
  · intro hy
    refine ⟨e.symm y, ?_, by simp⟩
    rw [mem_fixSubgroup]
    have h1 := congrArg e.symm hy
    simpa [MulAut.congr_apply] using h1
  · rintro ⟨x, hx, rfl⟩
    rw [mem_fixSubgroup] at hx
    simp [MulAut.congr_apply, hx]

theorem exists_card_eq_ringChar_pow {K : Type} [Field K] [Finite K] :
    ∃ f : ℕ, 1 ≤ f ∧ (ringChar K).Prime ∧ Nat.card K = ringChar K ^ f := by
  have := Fintype.ofFinite K
  obtain ⟨f, hℓ, hK⟩ := FiniteField.card K (ringChar K)
  exact ⟨f, f.pos, hℓ, by rw [Nat.card_eq_fintype_card, hK]⟩

theorem not_isPSolvable_fixSubgroup_psl {n : ℕ} {K : Type} [Field K] [Finite K] (hn : 4 ≤ n)
    (hK : 4 ≤ Nat.card K ∨ 5 ≤ n) (h3 : (3 : K) ≠ 0) (β : MulAut (projectiveSL n K))
    (hβ : β ^ 3 = 1) :
    ¬ CFSG.HallHigman.IsPSolvable 3 ↥(fixSubgroup β) := by
  obtain ⟨f, hf, hℓ, hKc⟩ := exists_card_eq_ringChar_pow (K := K)
  have hdesc := CFSG.RankThree.LinearDescent.higher_linear_prime_semilinear_field_descent hℓ hf
    (by omega : 3 ≤ n) hKc
  by_cases hlin : β ∈ linearAutGroup n K
  · have hrange : linearAutGroup n K = (conjAut n K).range := by
      rw [linearAutGroup, ← MonoidHom.coe_range, Subgroup.closure_eq]
    rw [hrange] at hlin
    obtain ⟨A, rfl⟩ := hlin
    have hAp : A ^ 3 ∈ (conjAut n K).ker := by rw [MonoidHom.mem_ker, map_pow, hβ]
    rw [hdesc.1] at hAp
    obtain ⟨c, hc⟩ := hAp
    exact not_isPSolvable_fixSubgroup_conjAut hn hK h3 hc.symm
  · obtain ⟨A, σ, rfl⟩ := CFSG.GH74.GLS.Stage2.Bender.Thm1.Ln.exists_conj_field_of_odd
      (by omega) (by decide : Odd 3) hβ
    have hmem : conjAut n K A * fieldAut n K σ ∈ semilinearAutGroup n K :=
      mul_mem (linearAutGroup_le_semilinearAutGroup (conjAut_mem_linearAutGroup A))
        (fieldAut_mem_semilinearAutGroup σ)
    have hne : conjAut n K A * fieldAut n K σ ≠ 1 := fun h => hlin (h ▸ one_mem _)
    haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    have hord : orderOf (conjAut n K A * fieldAut n K σ) = 3 := orderOf_eq_prime hβ hne
    have hpℓ : 3 ≠ ringChar K := fun h => h3 (by
      have h' : ((ringChar K : ℕ) : K) = 0 := ringChar.Nat.cast_ringChar
      rw [← h] at h'
      exact_mod_cast h')
    obtain ⟨-, τ, -, ⟨h, -, hβτ⟩, -⟩ := hdesc.2.2.2.2.2.2.2 3 Nat.prime_three hpℓ _ hmem hlin hord
    rw [hβτ, fixSubgroup_conj]
    intro hs
    apply not_isPSolvable_fixSubgroup_fieldAut (n := n) (K := K) (by omega) τ
    exact isPSolvable_of_mulEquiv
      ((fixSubgroup (fieldAut n K τ)).equivMapOfInjective _ h.injective).symm hs

end Linear

section LinearIndex

open CFSG.HardMathSupport.Solomon.Coordinator (fixSubgroup mem_fixSubgroup)

theorem three_ne_zero_of_card {K : Type} [Field K] [Finite K] {p f : ℕ} (hp : p.Prime)
    (hp3 : p ≠ 3) (hK : Nat.card K = p ^ f) : (3 : K) ≠ 0 := by
  intro h
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨n, hpr, hcard⟩ := FiniteField.card K (ringChar K)
  have hdvd : ringChar K ∣ 3 := by
    have h' : ((3 : ℕ) : K) = 0 := by exact_mod_cast h
    exact (ringChar.spec K 3).mp h'
  have h3 : ringChar K = 3 := (Nat.prime_dvd_prime_iff_eq hpr Nat.prime_three).mp hdvd
  rw [h3] at hcard
  have hc : 3 ∣ p ^ f := by
    rw [← hK, Nat.card_eq_fintype_card, hcard]
    exact dvd_pow_self 3 n.ne_zero
  exact hp3 ((Nat.prime_dvd_prime_iff_eq Nat.prime_three hp).mp
    (Nat.prime_three.dvd_of_dvd_pow hc)).symm

theorem not_isPSolvable_fixSubgroup_typeA {r : ℕ} {q : TauCeti.PrimePower}
    (hv : (TauCeti.LieTypeIndex.A r q).Valid) (hr : 3 ≤ r) (hq : 4 ≤ q.card ∨ 4 ≤ r)
    (hp3 : q.p ≠ 3) {K : Type} [Group K] [Finite K]
    (e : K ≃* (TauCeti.CFSGIndex.lie ⟨.A r q, hv⟩).Group)
    (β : MulAut K) (hβ : β ^ 3 = 1) :
    ¬ CFSG.HallHigman.IsPSolvable 3 ↥(fixSubgroup β) := by
  obtain ⟨F, _, hF, _, ⟨e'⟩⟩ :=
    CFSG.HardMathSupport.Timmesfeld.Tables.T1b.exists_mulEquiv_projectiveSL
      (CFSG.Open.StatedAPI.statedClassicalModel_of_mulEquiv_typeA hv e)
  have h3 : (3 : F) ≠ 0 :=
    three_ne_zero_of_card q.prime_p hp3 hF
  have hF4 : 4 ≤ Nat.card F ∨ 5 ≤ r + 1 := by
    rw [hF, ← TauCeti.PrimePower.card_def]
    exact hq.imp id (fun h => by omega)
  have hβ' : (MulAut.congr e' β) ^ 3 = 1 := by rw [← map_pow, hβ, map_one]
  intro hs
  apply not_isPSolvable_fixSubgroup_psl (n := r + 1) (by omega) hF4 h3 _ hβ'
  rw [fixSubgroup_congr]
  exact isPSolvable_of_mulEquiv ((fixSubgroup β).equivMapOfInjective _ e'.injective) hs

theorem at_typeA {r : ℕ} {q : TauCeti.PrimePower} (hv : (TauCeti.LieTypeIndex.A r q).Valid)
    (hr : 3 ≤ r) (hq : 4 ≤ q.card ∨ 4 ≤ r) (hp3 : q.p ≠ 3) :
    Outer295At ⟨.A r q, hv⟩ ∧ Inner295At ⟨.A r q, hv⟩ := by
  refine ⟨fun K _ _ _ _ ⟨e⟩ _ _ _ α hα _ => Or.inr (Or.inr
    (not_isPSolvable_fixSubgroup_typeA hv hr hq hp3 e α hα)),
    fun K _ _ _ _ ⟨e⟩ _ _ _ x hx => Or.inr (Or.inr ?_)⟩
  have hx3 : x ^ 3 = 1 := by rw [← hx]; exact pow_orderOf_eq_one x
  rw [← CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup_conj]
  exact not_isPSolvable_fixSubgroup_typeA hv hr hq hp3 e (MulAut.conj x)
    (by rw [← map_pow, hx3, map_one])

theorem four_le_card_of {q : TauCeti.PrimePower} (hp3 : q.p ≠ 3) (h2 : q.card ≠ 2) :
    4 ≤ q.card := by
  have h2' : 2 ≤ q.card := q.isPrimePow_card.two_le
  have h3 : q.card ≠ 3 := by
    intro h3
    apply hp3
    have hd : q.p ∣ q.card := by
      rw [TauCeti.PrimePower.card_def]
      exact dvd_pow_self q.p q.exponent_pos.ne'
    rw [h3] at hd
    exact (Nat.prime_dvd_prime_iff_eq q.prime_p Nat.prime_three).1 hd
  omega

@[expose] def Lie295OtherOuterRest : Prop :=
  ∀ d : TauCeti.ValidLieTypeIndex, d.1.characteristic ≠ 3 →
    ¬ Inputs295.IsClassicalTwoIndex (TauCeti.CFSGIndex.lie d) → IsBig295Index d.1 →
      (∀ (r : ℕ) (q : TauCeti.PrimePower), d.1 ≠ .A r q) → Outer295At d

@[expose] def Lie295OtherInnerRest : Prop :=
  ∀ d : TauCeti.ValidLieTypeIndex, d.1.characteristic ≠ 3 →
    ¬ Inputs295.IsClassicalTwoIndex (TauCeti.CFSGIndex.lie d) → IsBig295Index d.1 →
      (∀ q : TauCeti.PrimePower, d.1 ≠ .D 4 q) →
      (∀ (r : ℕ) (q : TauCeti.PrimePower), d.1 ≠ .A r q) → Inner295At d

theorem at_typeA_of_big {r : ℕ} {q : TauCeti.PrimePower} (hv : (TauCeti.LieTypeIndex.A r q).Valid)
    (hch : (TauCeti.LieTypeIndex.A r q).characteristic ≠ 3)
    (hb : IsBig295Index (TauCeti.LieTypeIndex.A r q)) :
    Outer295At ⟨.A r q, hv⟩ ∧ Inner295At ⟨.A r q, hv⟩ := by
  have hp3 : q.p ≠ 3 := by simpa using hch
  have hr : 3 ≤ r ∧ (q.card % 3 = 2 → 5 ≤ r) := by
    rcases hb with h | h | h
    · simp only [CFSG.LocalAnalysis.RankThreeTheoremC.KFactProofs.T29.Parrott.IsRankThreeIndex] at h
      omega
    · simp only [CFSG.LocalAnalysis.RankThreeTheoremC.KFactProofs.T29.Parrott.IsRankFourIndex] at h
      omega
    · exact h.elim
  have hq : 4 ≤ q.card ∨ 4 ≤ r := by
    by_cases h2 : q.card = 2
    · right
      have := hr.2 (by omega)
      omega
    · exact Or.inl (four_le_card_of hp3 h2)
  exact at_typeA hv hr.1 hq hp3

theorem lie295OtherOuter_of_rest (h : Lie295OtherOuterRest) : Lie295OtherOuter := by
  intro d hch h2 hb
  by_cases hA : ∃ (r : ℕ) (q : TauCeti.PrimePower), d.1 = .A r q
  · obtain ⟨r, q, hrq⟩ := hA
    obtain ⟨dd, hv⟩ := d
    change dd = .A r q at hrq
    subst hrq
    exact (at_typeA_of_big hv hch hb).1
  · push Not at hA
    exact h d hch h2 hb hA

theorem lie295OtherInner_of_rest (h : Lie295OtherInnerRest) : Lie295OtherInner := by
  intro d hch h2 hb hD
  by_cases hA : ∃ (r : ℕ) (q : TauCeti.PrimePower), d.1 = .A r q
  · obtain ⟨r, q, hrq⟩ := hA
    obtain ⟨dd, hv⟩ := d
    change dd = .A r q at hrq
    subst hrq
    exact (at_typeA_of_big hv hch hb).2
  · push Not at hA
    exact h d hch h2 hb hD hA

@[expose] def Lie295TwoRestNonlinear : Prop :=
  ∀ d : TauCeti.ValidLieTypeIndex, Inputs295.IsClassicalTwoIndex (TauCeti.CFSGIndex.lie d) →
    ¬ CFSG.LocalAnalysis.GLTheoremA.S9.isD4two (TauCeti.CFSGIndex.lie d) → IsBig295Index d.1 →
    ¬ CFSG.AGLEmbedding.IsSpSixTwoIndex d → ¬ CFSG.AGLEmbedding.IsOmegaMinusTwoIndex 4 d →
      (∀ (r : ℕ) (q : TauCeti.PrimePower), d.1 ≠ .A r q) → Outer295At d ∧ Inner295At d

theorem lie295TwoRest_of_nonlinear (h : Lie295TwoRestNonlinear) : Lie295TwoRest := by
