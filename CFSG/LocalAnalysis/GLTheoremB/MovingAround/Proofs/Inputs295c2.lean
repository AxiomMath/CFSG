section Quasisimple

variable {J : Type} [Group J]

theorem commutatorElement_mul_center {a b z w : J} (hz : z ∈ Subgroup.center J)
    (hw : w ∈ Subgroup.center J) : ⁅z * a, w * b⁆ = ⁅a, b⁆ := by
  have hz' := Subgroup.mem_center_iff.1 hz
  have hw' := Subgroup.mem_center_iff.1 hw
  rw [commutatorElement_def, commutatorElement_def]
  calc z * a * (w * b) * (z * a)⁻¹ * (w * b)⁻¹
      = z * (a * (w * b) * a⁻¹) * z⁻¹ * (w * b)⁻¹ := by group
    _ = a * (w * b) * a⁻¹ * (w * b)⁻¹ := by
        rw [← hz' (a * (w * b) * a⁻¹)]
        group
    _ = a * (b * w) * a⁻¹ * (b * w)⁻¹ := by rw [hw' b]
    _ = a * b * w * a⁻¹ * w⁻¹ * b⁻¹ := by group
    _ = a * b * (w * a⁻¹ * w⁻¹) * b⁻¹ := by group
    _ = a * b * a⁻¹ * b⁻¹ := by
        rw [← hw' a⁻¹]
        group

theorem exists_mul_eq_of_isComplement'' {H K : Subgroup J} (h : H.IsComplement' K) (g : J) :
    ∃ s ∈ H, ∃ t ∈ K, s * t = g := by
  obtain ⟨-, hsurj⟩ := h
  obtain ⟨⟨⟨s, hs⟩, ⟨t, ht⟩⟩, hst⟩ := hsurj g
  exact ⟨s, hs, t, ht, hst⟩

variable [Finite J]

theorem not_three_dvd_card_of_quasisimple (hq : CFSG.IsQuasisimple J)
    (h : ¬ 3 ∣ Nat.card (J ⧸ Subgroup.center J)) : ¬ 3 ∣ Nat.card J := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  intro h3
  obtain ⟨hperf, -, -⟩ := hq
  obtain ⟨P⟩ : Nonempty (Sylow 3 J) := inferInstance
  have hPcen : ∀ g ∈ P.toSubgroup, g ∈ Subgroup.center J := by
    intro g hg
    obtain ⟨k, hk⟩ := P.isPGroup' ⟨g, hg⟩
    have hk' : g ^ 3 ^ k = 1 := by simpa using congrArg Subtype.val hk
    have h2 : orderOf (QuotientGroup.mk' (Subgroup.center J) g) ∣ 3 ^ k :=
      (orderOf_map_dvd _ g).trans (orderOf_dvd_of_pow_eq_one hk')
    obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Nat.prime_three).mp h2
    rcases j with _ | j
    · rw [pow_zero, orderOf_eq_one_iff] at hj
      exact (QuotientGroup.eq_one_iff g).mp hj
    · exfalso
      apply h
      have h4 : orderOf (QuotientGroup.mk' (Subgroup.center J) g) ∣
          Nat.card (J ⧸ Subgroup.center J) := orderOf_dvd_natCard _
      rw [hj] at h4
      exact (dvd_pow_self 3 (Nat.succ_ne_zero j)).trans h4
  haveI hPn : P.toSubgroup.Normal := ⟨fun n hn g => by
    rw [(Subgroup.mem_center_iff.mp (hPcen n hn) g), mul_inv_cancel_right]
    exact hn⟩
  obtain ⟨H, hC⟩ := Subgroup.exists_right_complement'_of_coprime (Sylow.card_coprime_index P)
  have hJH : commutator J ≤ H := by
    rw [commutator_def, Subgroup.commutator_le]
    intro a _ b _
    obtain ⟨s, hs, t, ht, rfl⟩ := exists_mul_eq_of_isComplement'' hC a
    obtain ⟨s', hs', t', ht', rfl⟩ := exists_mul_eq_of_isComplement'' hC b
    rw [commutatorElement_mul_center (hPcen s hs) (hPcen s' hs'), commutatorElement_def]
    exact H.mul_mem (H.mul_mem (H.mul_mem ht ht') (H.inv_mem ht)) (H.inv_mem ht')
  have hHtop : H = ⊤ := by
    rw [eq_top_iff, ← Group.isPerfect_def.mp hperf]
    exact hJH
  have hPbot : P.toSubgroup = ⊥ := by
    have hd := hC.disjoint
    rw [hHtop, disjoint_top] at hd
    exact hd
  have hP3 : 3 ∣ Nat.card P.toSubgroup := P.dvd_card_of_dvd_card h3
  rw [hPbot, Subgroup.card_bot] at hP3
  norm_num at hP3

theorem not_three_dvd_card_of_isPSolvable (hq : CFSG.IsQuasisimple J)
    (hs : CFSG.HallHigman.IsPSolvable 3 J) : ¬ 3 ∣ Nat.card J := by
  refine not_three_dvd_card_of_quasisimple hq ?_
  obtain ⟨-, hsimp, a0, b0, hab⟩ := hq
  have hTeq : ((Subgroup.center J).subgroupOf (⊤ : Subgroup J)).map
      (Subgroup.topEquiv : ↥(⊤ : Subgroup J) ≃* J).toMonoidHom = Subgroup.center J := by
    ext x
    rw [Subgroup.mem_map]
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact Subgroup.mem_subgroupOf.mp hy
    · intro hx
      exact ⟨⟨x, Subgroup.mem_top x⟩, Subgroup.mem_subgroupOf.mpr hx, rfl⟩
  let e := QuotientGroup.congr ((Subgroup.center J).subgroupOf (⊤ : Subgroup J))
    (Subgroup.center J) (Subgroup.topEquiv : ↥(⊤ : Subgroup J) ≃* J) hTeq
  haveI : IsSimpleGroup (J ⧸ Subgroup.center J) := hsimp
  have hsimpT : IsSimpleGroup
      (↥(⊤ : Subgroup J) ⧸ (Subgroup.center J).subgroupOf (⊤ : Subgroup J)) :=
    e.isSimpleGroup
  have hnsn : (⊤ : Subgroup J).IsSubnormal := Subgroup.Normal.isSubnormal inferInstance
  have hT := hs ⊤ hnsn ((Subgroup.center J).subgroupOf (⊤ : Subgroup J)) hsimpT
  have hidx : ((Subgroup.center J).subgroupOf (⊤ : Subgroup J)).index =
      Nat.card (J ⧸ Subgroup.center J) := by
    show Nat.card _ = Nat.card _
    exact Nat.card_congr e.toEquiv
  rw [hidx] at hT
  rcases hT with h3 | h3
  · exfalso
    haveI : IsCyclic (J ⧸ Subgroup.center J) := isCyclic_of_prime_card (p := 3) h3
    exact hab (mul_comm a0 b0)
  · exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mp h3

theorem not_isPSolvable_range_of_quasisimple {G : Type} [Group G] (hq : CFSG.IsQuasisimple J)
    (h3 : 3 ∣ Nat.card J) (π : J →* G) (hπ : ∃ b : J, π b ≠ 1) :
    ¬ CFSG.HallHigman.IsPSolvable 3 ↥π.range := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  intro hs
  obtain ⟨b, hb⟩ := hπ
  have hkerZ : π.ker ≤ Subgroup.center J :=
    (CFSG.LocalCores.quasisimple_normal_subgroups hq π.normal_ker).resolve_left fun h =>
      hb (π.mem_ker.1 (h ▸ Subgroup.mem_top b))
  have hkersolv : CFSG.HallHigman.IsPSolvable 3 ↥π.ker := by
    refine CFSG.AGLEmbeddingD2.Tits.S3AmalgamBound.OvergroupA5.isPSolvable_of_isSolvable
      Nat.prime_three ?_
    haveI : IsMulCommutative ↥π.ker := ⟨⟨fun a b => Subtype.ext
      (Subgroup.mem_center_iff.1 (hkerZ b.2) a)⟩⟩
    infer_instance
  have hquot : CFSG.HallHigman.IsPSolvable 3 (J ⧸ π.ker) :=
    isPSolvable_of_mulEquiv (QuotientGroup.quotientKerEquivRange π).symm hs
  exact not_three_dvd_card_of_isPSolvable hq (isPSolvable_of_normal π.ker hkersolv hquot) h3

end Quasisimple

section Rotation

variable {F : Type*} [Field F]

@[expose] def rotTwo : Matrix (Fin 2) (Fin 2) F := !![0, -1; 1, -1]

theorem rotTwo_cube : rotTwo (F := F) * (rotTwo * rotTwo) = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [rotTwo, Matrix.mul_apply, Fin.sum_univ_two]

theorem det_rotTwo : (rotTwo (F := F)).det = 1 := by
  simp [rotTwo, Matrix.det_fin_two]

theorem exists_sl_cube (m : ℕ) (hm : 2 ≤ m) :
    ∃ g : Matrix.SpecialLinearGroup (Fin m) F, g ^ 3 = 1 ∧
      (g : Matrix (Fin m) (Fin m) F) ⟨0, by omega⟩ ⟨0, by omega⟩ = 0 := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hm
  set B : Matrix (Fin 2 ⊕ Fin k) (Fin 2 ⊕ Fin k) F :=
    Matrix.fromBlocks rotTwo 0 0 1 with hB
  set e : Fin 2 ⊕ Fin k ≃ Fin (2 + k) := finSumFinEquiv with he
  set M : Matrix (Fin (2 + k)) (Fin (2 + k)) F := Matrix.reindexAlgEquiv F F e B with hM
  have hdet : M.det = 1 := by
    rw [hM, Matrix.reindexAlgEquiv_apply, Matrix.det_reindex_self, hB,
      Matrix.det_fromBlocks_zero₂₁, det_rotTwo, Matrix.det_one, mul_one]
  have hB3 : B * (B * B) = 1 := by
    rw [hB, Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
    simp [rotTwo_cube, Matrix.fromBlocks_one]
  have hM3 : M ^ 3 = 1 := by
    rw [hM, ← map_pow, pow_succ', pow_two, hB3, map_one]
  let g : Matrix.SpecialLinearGroup (Fin (2 + k)) F := ⟨M, hdet⟩
  have hg : (g : Matrix (Fin (2 + k)) (Fin (2 + k)) F) = M := rfl
  refine ⟨g, Subtype.ext ?_, ?_⟩
  · rw [Matrix.SpecialLinearGroup.coe_pow, hg, hM3]
    rfl
  · rw [hg]
    have h0 : (⟨0, by omega⟩ : Fin (2 + k)) = e (Sum.inl 0) := by
      rw [he, finSumFinEquiv_apply_left]
      rfl
    rw [hM, Matrix.reindexAlgEquiv_apply, Matrix.reindex_apply, Matrix.submatrix_apply, h0,
      Equiv.symm_apply_apply, hB, Matrix.fromBlocks_apply₁₁]
    simp [rotTwo]

theorem ne_one_of_entry_zero {m : ℕ} (hm : 1 ≤ m) {g : Matrix.SpecialLinearGroup (Fin m) F}
    (h : (g : Matrix (Fin m) (Fin m) F) ⟨0, by omega⟩ ⟨0, by omega⟩ = 0) : g ≠ 1 := by
  rintro rfl
  simp at h

theorem three_dvd_card_sl [Finite F] {m : ℕ} (hm : 2 ≤ m) :
    3 ∣ Nat.card (Matrix.SpecialLinearGroup (Fin m) F) := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨g, hg3, hg0⟩ := exists_sl_cube (F := F) m hm
  have hord : orderOf g = 3 := orderOf_eq_prime hg3 (ne_one_of_entry_zero (by omega) hg0)
  rw [← hord]
  exact orderOf_dvd_natCard g

end Rotation

