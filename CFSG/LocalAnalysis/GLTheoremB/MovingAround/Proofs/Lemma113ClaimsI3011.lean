@[expose] def comp₂ (a b : ZMod 3) (w : ZMod 3 × ZMod 3) : ZMod 3 × ZMod 3 :=
  (a * w.2, w.1 + b * w.2)

theorem comp₂_iterate_ne (a b : ZMod 3) : (comp₂ a b)^[13] (1, 0) ≠ (1, 0) := by
  revert a b
  decide +kernel

@[expose] def comp₃ (c w : ZMod 3 × ZMod 3 × ZMod 3) : ZMod 3 × ZMod 3 × ZMod 3 :=
  (c.1 * w.2.2, w.1 + c.2.1 * w.2.2, w.2.1 + c.2.2 * w.2.2)

@[expose] def lin₃ (a : ZMod 3) (u : ZMod 3 × ZMod 3 × ZMod 3) (b : ZMod 3)
    (w : ZMod 3 × ZMod 3 × ZMod 3) : ZMod 3 × ZMod 3 × ZMod 3 :=
  (a * u.1 + b * w.1, a * u.2.1 + b * w.2.1, a * u.2.2 + b * w.2.2)

theorem comp₃_equations (c : ZMod 3 × ZMod 3 × ZMod 3)
    (hc : (comp₃ c)^[13] (1, 0, 0) = (1, 0, 0)) (x y : ZMod 3 × ZMod 3 × ZMod 3)
    (h₁ : comp₃ c y = lin₃ (-c.1) x c.2.2 (comp₃ c x))
    (h₂ : comp₃ c (comp₃ c x) = lin₃ (-c.1) y (-c.2.1) (comp₃ c x)) :
    x = (0, 0, 0) ∧ y = (0, 0, 0) := by
  revert c x y
  set_option synthInstance.maxSize 512 in
  decide +kernel

theorem zmod3_mul_self {a : ZMod 3} (ha : a ≠ 0) : a * a = 1 := by
  revert a
  decide +kernel

theorem zmod3_eq_one_of_pow {l : ZMod 3} (h : l ^ 13 = 1) : l = 1 := by
  revert l
  decide +kernel

variable {V : Type*} [AddCommGroup V] [Module (ZMod 3) V]

theorem eq_zero_of_zmod3_smul {a : ZMod 3} (ha : a ≠ 0) {v : V} (h : a • v = 0) : v = 0 := by
  rw [← one_smul (ZMod 3) v, ← zmod3_mul_self ha, mul_smul, h, smul_zero]

theorem indep_two (g : V →ₗ[ZMod 3] V) {v : V} (h13 : g^[13] v = v) (hv : g v ≠ v)
    {a₀ a₁ : ZMod 3} (h : a₀ • v + a₁ • g v = 0) : a₀ = 0 ∧ a₁ = 0 := by
  have hv0 : v ≠ 0 := by
    rintro rfl
    exact hv (map_zero g)
  by_cases ha₁ : a₁ = 0
  · subst ha₁
    rw [zero_smul, add_zero] at h
    refine ⟨?_, rfl⟩
    by_contra ha₀
    exact hv0 (eq_zero_of_zmod3_smul ha₀ h)
  · exfalso
    obtain ⟨l, hl⟩ : ∃ l : ZMod 3, g v = l • v := by
      refine ⟨-(a₁ * a₀), ?_⟩
      have h' : a₁ • (a₀ • v + a₁ • g v) = 0 := by rw [h, smul_zero]
      simp only [smul_add, smul_smul, zmod3_mul_self ha₁, one_smul] at h'
      rw [neg_smul]
      exact eq_neg_of_add_eq_zero_right h'
    have hit : ∀ n : ℕ, g^[n] v = l ^ n • v := by
      intro n
      induction n with
      | zero => simp
      | succ n ih => rw [Function.iterate_succ_apply', ih, map_smul, hl, smul_smul, pow_succ]
    have hl13 : l ^ 13 = 1 := by
      by_contra hne
      apply hv0
      refine eq_zero_of_zmod3_smul (sub_ne_zero.mpr hne) ?_
      rw [sub_smul, ← hit, h13, one_smul, sub_self]
    exact hv (by rw [hl, zmod3_eq_one_of_pow hl13, one_smul])

theorem indep_three (g : V →ₗ[ZMod 3] V) {v : V} (h13 : g^[13] v = v) (hv : g v ≠ v)
    {a₀ a₁ a₂ : ZMod 3} (h : a₀ • v + a₁ • g v + a₂ • g (g v) = 0) :
    a₀ = 0 ∧ a₁ = 0 ∧ a₂ = 0 := by
  by_cases ha₂ : a₂ = 0
  · subst ha₂
    rw [zero_smul, add_zero] at h
    obtain ⟨h₀, h₁⟩ := indep_two g h13 hv h
    exact ⟨h₀, h₁, rfl⟩
  · exfalso
    obtain ⟨a, b, hab⟩ : ∃ a b : ZMod 3, g (g v) = a • v + b • g v := by
      refine ⟨-(a₂ * a₀), -(a₂ * a₁), ?_⟩
      have h' : a₂ • (a₀ • v + a₁ • g v + a₂ • g (g v)) = 0 := by rw [h, smul_zero]
      simp only [smul_add, smul_smul, zmod3_mul_self ha₂, one_smul] at h'
      rw [eq_neg_of_add_eq_zero_right h']
      module
    have hit : ∀ n : ℕ,
        g^[n] v = ((comp₂ a b)^[n] (1, 0)).1 • v + ((comp₂ a b)^[n] (1, 0)).2 • g v := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih]
        generalize (comp₂ a b)^[n] (1, 0) = w
        simp only [comp₂, map_add, map_smul, hab]
        module
    have h13' := hit 13
    rw [h13] at h13'
    generalize hw : (comp₂ a b)^[13] (1, 0) = w at h13'
    obtain ⟨hp, hq⟩ := indep_two g h13 hv (a₀ := w.1 - 1) (a₁ := w.2) (by
      calc (w.1 - 1) • v + w.2 • g v = (w.1 • v + w.2 • g v) - v := by module
        _ = 0 := by rw [← h13', sub_self])
    exact comp₂_iterate_ne a b (hw.trans (Prod.ext (sub_eq_zero.mp hp) hq))

theorem linearIndependent_three (g : V →ₗ[ZMod 3] V) {v : V} (h13 : g^[13] v = v)
    (hv : g v ≠ v) : LinearIndependent (ZMod 3) ![v, g v, g (g v)] := by
  rw [Fintype.linearIndependent_iff]
  intro f hf
  simp only [Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.head_cons, Matrix.tail_cons] at hf
  obtain ⟨h₀, h₁, h₂⟩ := indep_three g h13 hv hf
  intro i
  fin_cases i <;> assumption

@[expose] def lc (e₀ e₁ e₂ : V) (t : ZMod 3 × ZMod 3 × ZMod 3) : V :=
  t.1 • e₀ + t.2.1 • e₁ + t.2.2 • e₂

theorem lc_lin₃ (e₀ e₁ e₂ : V) (a : ZMod 3) (u : ZMod 3 × ZMod 3 × ZMod 3) (b : ZMod 3)
    (w : ZMod 3 × ZMod 3 × ZMod 3) :
    lc e₀ e₁ e₂ (lin₃ a u b w) = a • lc e₀ e₁ e₂ u + b • lc e₀ e₁ e₂ w := by
  simp only [lc, lin₃]
  module

theorem eq_zero_of_moved (hV : Module.finrank (ZMod 3) V = 3) (g : V →ₗ[ZMod 3] V) {v : V}
    (h13 : g^[13] v = v) (hv : g v ≠ v) (β : V →ₗ[ZMod 3] V →ₗ[ZMod 3] V)
    (hβ : ∀ u, β u u = 0) (hβg : ∀ u w, β (g u) (g w) = g (β u w)) : β = 0 := by
  have hli := linearIndependent_three g h13 hv
  obtain ⟨b, hb⟩ : ∃ b : Module.Basis (Fin 3) (ZMod 3) V, ⇑b = ![v, g v, g (g v)] :=
    ⟨_, coe_basisOfLinearIndependentOfCardEqFinrank hli (by rw [Fintype.card_fin, hV])⟩
  have hsurj : ∀ u : V, ∃ t, u = lc v (g v) (g (g v)) t := by
    intro u
    refine ⟨(b.repr u 0, b.repr u 1, b.repr u 2), ?_⟩
    conv_lhs => rw [← b.sum_repr u]
    simp [Fin.sum_univ_three, hb, lc]
  have hinj : ∀ t t', lc v (g v) (g (g v)) t = lc v (g v) (g (g v)) t' → t = t' := by
    intro t t' h
    obtain ⟨h₀, h₁, h₂⟩ := indep_three g h13 hv (a₀ := t.1 - t'.1) (a₁ := t.2.1 - t'.2.1)
      (a₂ := t.2.2 - t'.2.2) (by
        calc _ = lc v (g v) (g (g v)) t - lc v (g v) (g (g v)) t' := by
              simp only [lc]
              module
          _ = 0 := by rw [h, sub_self])
    exact Prod.ext (sub_eq_zero.mp h₀) (Prod.ext (sub_eq_zero.mp h₁) (sub_eq_zero.mp h₂))
  obtain ⟨c, hc⟩ := hsurj (g (g (g v)))
  have hg : ∀ t, g (lc v (g v) (g (g v)) t) = lc v (g v) (g (g v)) (comp₃ c t) := by
    intro t
    have hc' := hc
    simp only [lc] at hc'
    simp only [lc, comp₃, map_add, map_smul, hc']
    module
  have h13c : (comp₃ c)^[13] (1, 0, 0) = (1, 0, 0) := by
    have hit : ∀ n : ℕ, g^[n] v = lc v (g v) (g (g v)) ((comp₃ c)^[n] (1, 0, 0)) := by
      intro n
      induction n with
      | zero => simp [lc]
      | succ n ih => rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih, hg]
    apply hinj
    rw [← hit, h13]
    simp [lc]
  have hanti : ∀ u w, β u w = -β w u := by
    intro u w
    have h := hβ (u + w)
    simp only [map_add, LinearMap.add_apply, hβ, zero_add, add_zero] at h
    exact eq_neg_of_add_eq_zero_right h
  obtain ⟨x, hx⟩ := hsurj (β v (g v))
  obtain ⟨y, hy⟩ := hsurj (β v (g (g v)))
  have hz : β (g v) (g (g v)) = lc v (g v) (g (g v)) (comp₃ c x) := by rw [hβg, hx, hg]
  have e₁ : comp₃ c y = lin₃ (-c.1) x c.2.2 (comp₃ c x) := by
    apply hinj
    rw [← hg, ← hy, ← hβg, hc, lc_lin₃, ← hz, ← hx]
    simp only [lc, map_add, map_smul, hβ, hanti (g v) v, smul_zero, add_zero]
    module
  have e₂ : comp₃ c (comp₃ c x) = lin₃ (-c.1) y (-c.2.1) (comp₃ c x) := by
    apply hinj
    rw [← hg, ← hz, ← hβg, hc, lc_lin₃, ← hz, ← hy]
    simp only [lc, map_add, map_smul, hβ, hanti (g (g v)) v, hanti (g (g v)) (g v), smul_zero,
      add_zero]
    module
  obtain ⟨hx0, hy0⟩ := comp₃_equations c h13c x y e₁ e₂
  have hx' : β v (g v) = 0 := by
    rw [hx, hx0]
    simp [lc]
  have hy' : β v (g (g v)) = 0 := by
    rw [hy, hy0]
    simp [lc]
  have hz' : β (g v) (g (g v)) = 0 := by rw [hβg, hx', map_zero]
  refine b.ext fun i => b.ext fun j => ?_
  simp only [LinearMap.zero_apply, hb]
  fin_cases i <;> fin_cases j <;>
    simp [hβ, hx', hy', hz', hanti (g v) v, hanti (g (g v)) v, hanti (g (g v)) (g v)]

end Lemma113Claims.I3011

open Lemma113Claims.I3011 in
theorem input30_11_holds :
    ∀ (V : Type) [AddCommGroup V] [Module (ZMod 3) V], Module.finrank (ZMod 3) V = 3 →
      ∀ g : V →ₗ[ZMod 3] V, g ^ 13 = 1 → g ≠ 1 →
        ∀ β : V →ₗ[ZMod 3] V →ₗ[ZMod 3] V, (∀ v, β v v = 0) →
          (∀ v w, β (g v) (g w) = g (β v w)) → β = 0 := by
  intro V _ _ hV g h13 hg1 β hβ hβg
  obtain ⟨v, hv⟩ : ∃ v, g v ≠ v := by
    by_contra hcon
    push Not at hcon
    exact hg1 (LinearMap.ext fun w => by rw [hcon w, Module.End.one_apply])
  refine eq_zero_of_moved hV g ?_ hv β hβ hβg
  rw [← Module.End.pow_apply, h13, Module.End.one_apply]

end CFSG.LocalAnalysis.GLTheoremB.MovingAround
