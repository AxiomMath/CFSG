open Equiv Equiv.Perm

theorem exists_unit_sign_neg_one {p : ℕ} [hp : Fact p.Prime] (hp2 : p ≠ 2) :
    ∃ u : (ZMod p)ˣ, Equiv.Perm.sign (MulAction.toPerm u : Equiv.Perm (ZMod p)) = -1 := by
  haveI := ZMod.isCyclic_units_prime hp.out
  obtain ⟨m, hm⟩ := IsCyclic.exists_generator (α := (ZMod p)ˣ)
  refine ⟨m, ?_⟩
  set f : Equiv.Perm (ZMod p) := MulAction.toPerm m with hf
  have hfx : ∀ x, f x = (m : ZMod p) * x := fun x => rfl
  have hm1 : (m : ZMod p) ≠ 1 := by
    intro h
    have hall : ∀ u : (ZMod p)ˣ, u = 1 := by
      intro u
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 (hm u)
      rw [← hk, show m = 1 from Units.ext h, one_zpow]
    have h1 : Fintype.card (ZMod p)ˣ = 1 := Fintype.card_eq_one_iff.2 ⟨1, hall⟩
    rw [ZMod.card_units p] at h1
    have := hp.out.two_le
    omega
  have hsupp : f.support = Finset.univ.erase 0 := by
    ext x
    simp only [Equiv.Perm.mem_support, Finset.mem_erase, Finset.mem_univ, and_true, hfx]
    constructor
    · intro h hx
      exact h (by rw [hx, mul_zero])
    · intro hx h
      have h0 : ((m : ZMod p) - 1) * x = 0 := by rw [sub_mul, h, one_mul, sub_self]
      rcases mul_eq_zero.1 h0 with h' | h'
      · exact hm1 (sub_eq_zero.1 h')
      · exact hx h'
  have hcyc : f.IsCycle := by
    refine ⟨1, by rw [hfx, mul_one]; exact hm1, fun y hy => ?_⟩
    have hy0 : y ≠ 0 := by
      intro h
      apply hy
      rw [h, hfx, mul_zero]
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 (hm (Units.mk0 y hy0))
    refine ⟨k, ?_⟩
    have hpow : f ^ k = MulAction.toPerm (m ^ k) := by
      rw [hf]
      exact (map_zpow (MulAction.toPermHom (ZMod p)ˣ (ZMod p)) m k).symm
    rw [hpow, hk]
    show ((Units.mk0 y hy0 : (ZMod p)ˣ) : ZMod p) * 1 = y
    rw [mul_one, Units.val_mk0]
  rw [hcyc.sign, hsupp, Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, ZMod.card,
    (hp.out.even_sub_one hp2).neg_one_pow]

theorem card_orbit_of_regular {n : ℕ} {T : Subgroup (Perm (Fin n))} (hcomm : ∀ a ∈ T, ∀ b ∈ T, a * b = b * a)
    {i : Fin n} (hi : ∀ t ∈ T, t ≠ 1 → t i ≠ i) :
    Nat.card {j // ∃ u ∈ T, u i = j} = Nat.card T ∧ ∀ t ∈ T, t ≠ 1 → ∀ j, (∃ u ∈ T, u i = j) → t j ≠ j := by
  refine ⟨?_, ?_⟩
  · have hbij : Function.Bijective
        (fun u : ↥T => (⟨(u : Perm (Fin n)) i, ⟨u, u.2, rfl⟩⟩ : {j // ∃ u ∈ T, u i = j})) := by
      constructor
      · intro u v h
        have h1 : (u : Perm (Fin n)) i = (v : Perm (Fin n)) i := congrArg Subtype.val h
        by_contra hne
        have hne' : (v : Perm (Fin n))⁻¹ * u ≠ 1 := fun e =>
          hne (Subtype.ext (inv_mul_eq_one.1 e).symm)
        exact hi _ (T.mul_mem (T.inv_mem v.2) u.2) hne' (by
          rw [Perm.mul_apply, h1]
          exact Perm.inv_eq_iff_eq.2 rfl)
      · rintro ⟨j, ⟨u, hu, rfl⟩⟩
        exact ⟨⟨u, hu⟩, rfl⟩
    exact (Nat.card_congr (Equiv.ofBijective _ hbij)).symm
  · rintro t ht ht1 _ ⟨u, hu, rfl⟩ h
    apply hi t ht ht1
    apply u.injective
    rw [← Perm.mul_apply, hcomm u hu t ht, Perm.mul_apply]
    exact h

theorem restrict_mem_of_maximal {n p : ℕ} (hpodd : Odd p) {T : Subgroup (Perm (Fin n))} (hT : IsElemAbelian p T)
    (hmax : ∀ σ ∈ alternatingGroup (Fin n), σ ^ p = 1 → (∀ t ∈ T, σ * t = t * σ) → σ ∈ T)
    {κ : Perm (Fin n)} (hκ : κ ∈ T) (x : Fin n) :
    ∃ σ ∈ T, (∀ y, (∃ u ∈ T, u x = y) → σ y = κ y) ∧ (∀ y, (¬ ∃ u ∈ T, u x = y) → σ y = y) := by
  classical
  have hcomm : ∀ a ∈ T, ∀ b ∈ T, a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (hT.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  set r : Fin n → Prop := fun y => ∃ u ∈ T, u x = y with hr
  have hrt : ∀ y, r (κ y) ↔ r y := by
    intro y
    constructor
    · rintro ⟨u, hu, hux⟩
      refine ⟨κ⁻¹ * u, T.mul_mem (T.inv_mem hκ) hu, ?_⟩
      rw [Perm.mul_apply, hux]
      exact Perm.inv_eq_iff_eq.2 rfl
    · rintro ⟨u, hu, rfl⟩
      exact ⟨κ * u, T.mul_mem hκ hu, rfl⟩
  set σ : Perm (Fin n) := Perm.ofSubtype (κ.subtypePerm hrt : Perm (Subtype r)) with hσ
  have hσr : ∀ y, r y → σ y = κ y := fun y hy => by
    rw [hσ, Perm.ofSubtype_apply_of_mem _ hy]
    rfl
  have hσnr : ∀ y, ¬ r y → σ y = y := fun y hy => Perm.ofSubtype_apply_of_not_mem _ hy
  have hσp : σ ^ p = 1 := by
    ext y
    by_cases hy : r y
    · rw [hσ, ← map_pow, Perm.ofSubtype_apply_of_mem _ hy, Equiv.Perm.subtypePerm_pow]
      simp [hT.2 κ hκ]
    · rw [hσ, ← map_pow, Perm.ofSubtype_apply_of_not_mem _ hy]
      rfl
  have hσc : ∀ u ∈ T, σ * u = u * σ := by
    intro u hu
    ext y
    simp only [Perm.mul_apply]
    by_cases hy : r y
    · have huy : r (u y) := by
        obtain ⟨v, hv, rfl⟩ := hy
        exact ⟨u * v, T.mul_mem hu hv, rfl⟩
      rw [hσr _ huy, hσr _ hy, ← Perm.mul_apply, ← Perm.mul_apply, hcomm κ hκ u hu]
    · have huy : ¬ r (u y) := by
        rintro ⟨v, hv, hvy⟩
        refine hy ⟨u⁻¹ * v, T.mul_mem (T.inv_mem hu) hv, ?_⟩
        rw [Perm.mul_apply, hvy]
        exact Perm.inv_eq_iff_eq.2 rfl
      rw [hσnr _ huy, hσnr _ hy]
  exact ⟨σ, hmax σ (AltFacts5.mem_alt_of_pow hpodd hσp) hσp hσc, hσr, hσnr⟩

theorem altRegConj_holds :
    ∀ (p : ℕ), p.Prime → 5 ≤ p → ∀ n δ : ℕ, 1 ≤ δ → δ < p → n = p ^ 2 + δ →
      ∀ T T' : Subgroup (Perm (Fin n)), IsElemAbelian p T → IsElemAbelian p T' →
        Nat.card T = p ^ 2 → Nat.card T' = p ^ 2 →
        (∀ σ ∈ alternatingGroup (Fin n), σ ^ p = 1 → (∀ t ∈ T, σ * t = t * σ) → σ ∈ T) →
        (∀ σ ∈ alternatingGroup (Fin n), σ ^ p = 1 → (∀ t ∈ T', σ * t = t * σ) → σ ∈ T') →
        (∃ κ ∈ T ⊓ T', κ ≠ 1) → ∀ i : Fin n, (∀ t ∈ T, t ≠ 1 → t i ≠ i) →
        ∃ g ∈ alternatingGroup (Fin n), (∀ j, (∀ t ∈ T, t i ≠ j) → g j = j) ∧
          T.map (MulAut.conj g).toMonoidHom = T' := by
  intro p hp hp5 n δ hδ1 hδp hnr T T' hT hT' hTc hT'c hmax hmax' hκex i hi
  classical
  obtain ⟨κ, hκ, hκ1⟩ := hκex
  haveI : Fact p.Prime := ⟨hp⟩
  have hp2 : p ≠ 2 := by omega
  have hpodd : Odd p := hp.odd_of_ne_two hp2
  have hpn : ¬ p ∣ n := by
    intro h
    rw [hnr] at h
    have hd : p ∣ δ := (Nat.dvd_add_right (dvd_pow_self p (by norm_num))).1 h
    have := Nat.le_of_dvd (by omega) hd
    omega
  have hκT : κ ∈ T := (Subgroup.mem_inf.1 hκ).1
  have hκT' : κ ∈ T' := (Subgroup.mem_inf.1 hκ).2
  have hcommT : ∀ a ∈ T, ∀ b ∈ T, a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (hT.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  have hcommT' : ∀ a ∈ T', ∀ b ∈ T', a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (hT'.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  have hκo : orderOf κ = p := orderOf_eq_prime (hT.2 κ hκT) hκ1
  set O : Finset (Fin n) := Finset.univ.filter (fun j => ∃ u ∈ T, u i = j) with hO
  have hOmem : ∀ j, j ∈ O ↔ ∃ u ∈ T, u i = j := fun j => by simp [hO]
  obtain ⟨hOc', hfree⟩ := card_orbit_of_regular hcommT hi
  have hOc : O.card = p ^ 2 := by
    rw [← hTc, ← hOc', Nat.card_eq_fintype_card, Fintype.card_subtype]
  obtain ⟨δ', -, -, -, hsupp⟩ := AltFacts5.regular_of_maximal hp2 hpn hT hmax hi ⟨κ, hκT, hκ1⟩
  have hmovesT : ∀ t ∈ T, t ≠ 1 → ∀ j, t j ≠ j ↔ j ∈ O := by
    intro t ht ht1 j
    have hOs : O ⊆ t.support := fun j hj => Perm.mem_support.2 (hfree t ht ht1 j ((hOmem j).1 hj))
    have heq : O = t.support := Finset.eq_of_subset_of_card_le hOs (by rw [hsupp t ht ht1, hTc, hOc])
    rw [← Perm.mem_support, ← heq]
  have hiO : i ∈ O := (hOmem i).2 ⟨1, T.one_mem, rfl⟩
  have hT'O : ∀ t ∈ T', ∀ j, j ∈ O → t j ∈ O := by
    intro t ht j hj
    rw [← hmovesT κ hκT hκ1] at hj ⊢
    intro h
    apply hj
    apply t.injective
    rw [← Perm.mul_apply, hcommT' t ht κ hκT', Perm.mul_apply, h]
  have horbO : ∀ x ∈ O, ∀ y, (∃ u ∈ T', u x = y) → y ∈ O := by
    rintro x hx _ ⟨u, hu, rfl⟩
    exact hT'O u hu x hx
  have hcardOrb : ∀ x ∈ O, (∃ y ∈ O, ¬ ∃ u ∈ T', u x = y) →
      (Finset.univ.filter (fun y => ∃ u ∈ T', u x = y)).card ≤ p := by
    intro x hx ⟨y, hyO, hy⟩
    have hos := MulAction.card_orbit_mul_card_stabilizer_eq_card_group (↥T') x
    simp only [Fintype.card_eq_nat_card] at hos
    rw [hT'c] at hos
    have hc : Nat.card (MulAction.orbit (↥T') x) =
        (Finset.univ.filter (fun y => ∃ u ∈ T', u x = y)).card := by
      rw [Nat.card_eq_fintype_card, ← Set.toFinset_card]
      congr 1
      ext z
      simp only [Set.mem_toFinset, MulAction.mem_orbit_iff, Finset.mem_filter, Finset.mem_univ, true_and]
      constructor
      · rintro ⟨u, rfl⟩
        exact ⟨u, u.2, rfl⟩
      · rintro ⟨u, hu, rfl⟩
        exact ⟨⟨u, hu⟩, rfl⟩
    have hdvd : (Finset.univ.filter (fun y => ∃ u ∈ T', u x = y)).card ∣ p ^ 2 :=
      hc ▸ Dvd.intro _ hos
    have hlt : (Finset.univ.filter (fun y => ∃ u ∈ T', u x = y)).card < p ^ 2 := by
      rw [← hOc]
      refine Finset.card_lt_card ⟨fun z hz => horbO x hx z (Finset.mem_filter.1 hz).2, fun hsub => ?_⟩
      exact hy (Finset.mem_filter.1 (hsub hyO)).2
    obtain ⟨k, hk, hkeq⟩ := (Nat.dvd_prime_pow hp).1 hdvd
    rw [hkeq] at hlt ⊢
    have hk1 : k ≤ 1 := by
      by_contra h
      have : k = 2 := by omega
      rw [this] at hlt
      exact lt_irrefl _ hlt
    calc p ^ k ≤ p ^ 1 := Nat.pow_le_pow_right hp.pos hk1
      _ = p := pow_one p
  have htrans : ∀ y ∈ O, ∃ u ∈ T', u i = y := by
    by_contra hnt
    push Not at hnt
    obtain ⟨x2, hx2O, hx2⟩ := hnt
    have hx2' : ∃ y ∈ O, ¬ ∃ u ∈ T', u x2 = y := ⟨i, hiO, fun ⟨u, hu, hux⟩ =>
      hx2 u⁻¹ (T'.inv_mem hu) (by rw [← hux]; exact Perm.inv_eq_iff_eq.2 rfl)⟩
    have hc1 := hcardOrb i hiO ⟨x2, hx2O, fun ⟨u, hu, h⟩ => hx2 u hu h⟩
    have hc2 := hcardOrb x2 hx2O hx2'
    obtain ⟨x3, hx3O, hx31, hx32⟩ : ∃ x3 ∈ O, (¬ ∃ u ∈ T', u i = x3) ∧ (¬ ∃ u ∈ T', u x2 = x3) := by
      by_contra hno
      push Not at hno
      have hsub : O ⊆ Finset.univ.filter (fun y => ∃ u ∈ T', u i = y) ∪
          Finset.univ.filter (fun y => ∃ u ∈ T', u x2 = y) := by
        intro y hy
        by_cases h1 : ∃ u ∈ T', u i = y
        · exact Finset.mem_union_left _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, h1⟩)
        · exact Finset.mem_union_right _ (Finset.mem_filter.2 ⟨Finset.mem_univ _, hno y hy (by
            push Not at h1; exact h1)⟩)
      have := (Finset.card_le_card hsub).trans (Finset.card_union_le _ _)
      rw [hOc] at this
      have : p * p ≤ p + p := by nlinarith
      nlinarith
    obtain ⟨σ1, hσ1T, hσ1r, hσ1nr⟩ := restrict_mem_of_maximal hpodd hT' hmax' hκT' i
    obtain ⟨σ2, hσ2T, hσ2r, hσ2nr⟩ := restrict_mem_of_maximal hpodd hT' hmax' hκT' x2
    have hmovesO : ∀ j ∈ O, κ j ≠ j := fun j hj => (hmovesT κ hκT hκ1 j).2 hj
    have hσ11 : σ1 ≠ 1 := fun h => hmovesO i hiO (by
      rw [← hσ1r i ⟨1, T'.one_mem, rfl⟩, h]; rfl)
    have hσ21 : σ2 ≠ 1 := fun h => hmovesO x2 hx2O (by
      rw [← hσ2r x2 ⟨1, T'.one_mem, rfl⟩, h]; rfl)
    have hσ1o : orderOf σ1 = p := orderOf_eq_prime (hT'.2 σ1 hσ1T) hσ11
    have hσ2o : orderOf σ2 = p := orderOf_eq_prime (hT'.2 σ2 hσ2T) hσ21
    have hdisj : ∀ y, (∃ u ∈ T', u i = y) → ¬ ∃ u ∈ T', u x2 = y := by
      rintro y ⟨u, hu, rfl⟩ ⟨v, hv, hv'⟩
      apply hx2 (v⁻¹ * u) (T'.mul_mem (T'.inv_mem hv) hu)
      rw [Perm.mul_apply, ← hv']
      exact Perm.inv_eq_iff_eq.2 rfl
    have hfix1 : ∀ w ∈ Subgroup.zpowers σ1, ∀ y, (¬ ∃ u ∈ T', u i = y) → w y = y := by
      intro w hw y hy
      obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 hw
      exact Perm.zpow_apply_eq_self_of_apply_eq_self (hσ1nr y hy) m
    have hfix2 : ∀ w ∈ Subgroup.zpowers σ2, ∀ y, (¬ ∃ u ∈ T', u x2 = y) → w y = y := by
      intro w hw y hy
      obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 hw
      exact Perm.zpow_apply_eq_self_of_apply_eq_self (hσ2nr y hy) m
    have hinf : Subgroup.zpowers σ1 ⊓ Subgroup.zpowers σ2 = ⊥ := by
      rw [eq_bot_iff]
      intro w hw
      rw [Subgroup.mem_bot]
      refine Equiv.ext fun y => ?_
      rw [Perm.one_apply]
      by_cases hy : ∃ u ∈ T', u i = y
      · exact hfix2 w hw.2 y (hdisj y hy)
      · exact hfix1 w hw.1 y hy
    have hsupc := GL83.CompFam.card_sup_of_commute_of_inf_eq_bot (H := Subgroup.zpowers σ1)
      (K := Subgroup.zpowers σ2) (fun a ha b hb => by
        obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 ha
        obtain ⟨m', rfl⟩ := Subgroup.mem_zpowers_iff.1 hb
        exact ((Commute.zpow_zpow (hcommT' σ1 hσ1T σ2 hσ2T) m m'))) hinf
    rw [Nat.card_zpowers, Nat.card_zpowers, hσ1o, hσ2o] at hsupc
    have hle : Subgroup.zpowers σ1 ⊔ Subgroup.zpowers σ2 ≤ T' :=
      sup_le ((Subgroup.zpowers_le).2 hσ1T) ((Subgroup.zpowers_le).2 hσ2T)
    have heq : Subgroup.zpowers σ1 ⊔ Subgroup.zpowers σ2 = T' :=
      Subgroup.eq_of_le_of_card_ge hle (by rw [hsupc, hT'c, pow_two])
    have hstab : Subgroup.zpowers σ1 ⊔ Subgroup.zpowers σ2 ≤ MulAction.stabilizer (Perm (Fin n)) x3 := by
      refine sup_le ((Subgroup.zpowers_le).2 ?_) ((Subgroup.zpowers_le).2 ?_)
      · exact MulAction.mem_stabilizer_iff.2 (hσ1nr x3 hx31)
      · exact MulAction.mem_stabilizer_iff.2 (hσ2nr x3 hx32)
    have hκx3 := MulAction.mem_stabilizer_iff.1 (hstab (heq ▸ hκT'))
    exact hmovesO x3 hx3O hκx3
  have hi' : ∀ t ∈ T', t ≠ 1 → t i ≠ i := by
    intro t ht ht1 hti
    apply ht1
    have hfixO : ∀ y ∈ O, t y = y := by
      intro y hy
      obtain ⟨u, hu, rfl⟩ := htrans y hy
      rw [← Perm.mul_apply, hcommT' t ht u hu, Perm.mul_apply, hti]
    have hos := MulAction.card_orbit_mul_card_stabilizer_eq_card_group (↥T') i
    simp only [Fintype.card_eq_nat_card] at hos
    rw [hT'c] at hos
    have hc : p ^ 2 ≤ Nat.card (MulAction.orbit (↥T') i) := by
      rw [← hOc, Nat.card_eq_fintype_card, ← Set.toFinset_card]
      refine Finset.card_le_card fun y hy => ?_
      obtain ⟨u, hu, rfl⟩ := htrans y hy
      rw [Set.mem_toFinset]
      exact ⟨⟨u, hu⟩, rfl⟩
    have hst : Nat.card (MulAction.stabilizer (↥T') i) = 1 := by
      have hpos : 0 < Nat.card (MulAction.stabilizer (↥T') i) := Nat.card_pos
      have hpos2 : 0 < p ^ 2 := by positivity
      by_contra hne
      have h2 : 2 ≤ Nat.card (MulAction.stabilizer (↥T') i) := by omega
      have := Nat.mul_le_mul hc h2
      omega
    have hmem : (⟨t, ht⟩ : ↥T') ∈ MulAction.stabilizer (↥T') i := hti
    rw [Subgroup.card_eq_one.1 hst] at hmem
    exact congrArg Subtype.val ((Subgroup.mem_bot).1 hmem)
  obtain ⟨-, hfree'⟩ := card_orbit_of_regular hcommT' hi'
  obtain ⟨δ'', -, -, -, hsupp'⟩ := AltFacts5.regular_of_maximal hp2 hpn hT' hmax' hi' ⟨κ, hκT', hκ1⟩
  have hmovesT' : ∀ t ∈ T', t ≠ 1 → ∀ j, t j ≠ j ↔ j ∈ O := by
    intro t ht ht1 j
    have hOs : O ⊆ t.support := fun j hj => Perm.mem_support.2 (hfree' t ht ht1 j (htrans j hj))
    have heq : O = t.support := Finset.eq_of_subset_of_card_le hOs (by rw [hsupp' t ht ht1, hT'c, hOc])
    rw [← Perm.mem_support, ← heq]
  have hfixOf : ∀ S : Subgroup (Perm (Fin n)), (∀ t ∈ S, t ≠ 1 → ∀ j, t j ≠ j ↔ j ∈ O) →
      ∀ t ∈ S, ∀ j, j ∉ O → t j = j := by
