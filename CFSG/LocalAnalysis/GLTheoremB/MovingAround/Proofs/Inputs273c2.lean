theorem isLocallyOneBalancedAbs_L33 {T : Type}
    [Group T] (e : T ≃* Matrix.SpecialLinearGroup (Fin 3) (ZMod 3)) : IsLocallyOneBalancedAbs 13 T := by
  obtain ⟨ε⟩ := CFSG.HardMathSupport.Dickson.BMRows.M13L33.nonempty_equiv_p13 e
  obtain ⟨e3⟩ := L33.equiv_P13_P
  obtain ⟨M, -, hA⟩ := L33.autModel (ε.trans e3)
  have hcard : Nat.card (MulAut T) = 11232 :=
    CFSG.HardMathSupport.Dickson.BMRows.M13L33.card_mulAut_of_equiv_sl e
  haveI : Finite (MulAut T) := Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
  have hno : ∀ g ∈ QA.originalSubgroup, orderOf g ≠ 26 ∧ orderOf g ≠ 39 := by
    intro g hg
    have h := forall_of_all QA QA_ok (Certificates.certificate273013) g hg
    simp only [Bool.and_eq_true, Bool.not_eq_true'] at h
    refine ⟨fun h26 => ?_, fun h39 => ?_⟩
    · rw [(CFSG.Sporadic.Schreier.orderIs_iff g (by norm_num)).2 h26] at h
      exact Bool.noConfusion h.1
    · rw [(CFSG.Sporadic.Schreier.orderIs_iff g (by norm_num)).2 h39] at h
      exact Bool.noConfusion h.2
  have h13 : Nat.Prime 13 := by norm_num
  intro x hx H _ _
  rw [eq_bot_iff]
  intro r hr
  rw [Subgroup.mem_bot]
  by_contra hr1
  have hrC := CFSG.HardMathSupport.Timmesfeld.Proving.GLAPPrimeCoreOf_le _ hr
  have hcop : Nat.Coprime (orderOf r) 13 := by
    have hd : orderOf r ∣ Nat.card ↥(GLAPPrimeCoreOf 13 (H ⊓ Subgroup.centralizer ({x} : Set (MulAut T)))) := by
      have := orderOf_dvd_natCard (⟨r, hr⟩ : ↥(GLAPPrimeCoreOf 13 (H ⊓ Subgroup.centralizer ({x} : Set (MulAut T)))))
      rwa [Subgroup.orderOf_mk] at this
    exact Nat.Coprime.coprime_dvd_left hd
      (CFSG.HardMathSupport.Timmesfeld.Proving.coprime_card_GLAPPrimeCoreOf h13 _).symm
  obtain ⟨q, hq, hqd⟩ := Nat.exists_prime_and_dvd (fun h => hr1 (orderOf_eq_one_iff.1 h))
  have hro : orderOf r ≠ 0 := (orderOf_pos r).ne'
  have hr'o : orderOf (r ^ (orderOf r / q)) = q := orderOf_pow_orderOf_div hro hqd
  have hq13 : Nat.Coprime 13 q := (Nat.Coprime.coprime_dvd_left hqd hcop).symm
  have hxr : Commute x r := (Subgroup.mem_centralizer_singleton_iff.1 hrC.2).symm
  have hxr' : Commute x (r ^ (orderOf r / q)) := hxr.pow_right _
  have ho : orderOf (x * r ^ (orderOf r / q)) = 13 * q := by
    rw [hxr'.orderOf_mul_eq_mul_orderOf_of_coprime (by rw [hx, hr'o]; exact hq13), hx, hr'o]
  have hdvd : 13 * q ∣ 11232 := hcard ▸ ho ▸ orderOf_dvd_natCard (x * r ^ (orderOf r / q))
  have hq864 : q ∣ 2 ^ 5 * 3 ^ 3 := Nat.dvd_of_mul_dvd_mul_left (by norm_num : 0 < 13) (by simpa using hdvd)
  have hq23 : q = 2 ∨ q = 3 := by
    rcases (Nat.Prime.dvd_mul hq).1 hq864 with h | h
    · exact Or.inl ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_two).1 (hq.dvd_of_dvd_pow h))
    · exact Or.inr ((Nat.prime_dvd_prime_iff_eq hq Nat.prime_three).1 (hq.dvd_of_dvd_pow h))
  have hΦ : orderOf ((M.Φ (x * r ^ (orderOf r / q)) : Equiv.Perm (Fin 26))) = 13 * q := by
    rw [Subgroup.orderOf_coe, MulEquiv.orderOf_eq, ho]
  have hmem : ((M.Φ (x * r ^ (orderOf r / q)) : Equiv.Perm (Fin 26))) ∈ QA.originalSubgroup :=
    hA ▸ (M.Φ (x * r ^ (orderOf r / q))).2
  obtain ⟨h26, h39⟩ := hno _ hmem
  rcases hq23 with rfl | rfl
  · exact h26 hΦ
  · exact h39 hΦ

