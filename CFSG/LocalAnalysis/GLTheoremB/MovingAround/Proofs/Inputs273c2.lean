  have := CFSG.HardMathSupport.Timmesfeld.Proving.GLAPPrimeCoreOf_conj_mem g⁻¹ (C.inv_mem hg) _ hh
  simpa [mul_assoc] using this

theorem isLocallyOneBalancedAbs_L28 {F : Type} [Field F] [Finite F]
    (hF : Nat.card F = 8) {T : Type} [Group T] [Finite T] (hT : IsSimpleGroup T) (hnab : ∃ a b : T, a * b ≠ b * a)
    (e : T ≃* CFSG.GorensteinWalter.PSL2 F) : IsLocallyOneBalancedAbs 3 T := by
  haveI := hT
  intro x hx H hH _
  have hcen : Subgroup.center T = ⊥ := center_eq_bot_of_isSimpleGroup hnab
  have hinj : Function.Injective (MulAut.conj : T →* MulAut T) := conj_injective_of_center_eq_bot hcen
  haveI : Fintype F := Fintype.ofFinite F
  haveI : CharP F 2 := charP_of_card_eq_prime_pow (p := 2) (f := 3)
    (by rw [← Nat.card_eq_fintype_card, hF]; norm_num)
  have hF' : Fintype.card F = 8 := by rw [Fintype.card_eq_nat_card, hF]
  have hTcard : Nat.card T = 504 := by
    rw [Nat.card_congr (e.trans (CFSG.HardMathSupport.Solomon.Coordinator.L2Plane.slEquivPsl2 F).symm).toEquiv,
      Matrix.card_SL_field 2, hF', Fin.prod_univ_two]
    norm_num
  have hInn : Nat.card (innerAut T) = 504 := by
    rw [← hTcard]
    exact (Nat.card_congr (MonoidHom.ofInjective hinj).toEquiv).symm
  have hQ : IsPGroup 3 (Subgroup.zpowers x) := by
    haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    exact IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hx, pow_one])
  haveI : (innerAut T).Normal := CFSG.ComponentClassification.OuterAutomorphisms.inner_normal T
  have hQN : Subgroup.zpowers x ≤ Subgroup.normalizer ((innerAut T : Subgroup (MulAut T)) : Set (MulAut T)) := by
    rw [Subgroup.normalizer_eq_top]
    exact le_top
  obtain ⟨z, hzI, hz1, hz3, hzx⟩ :=
    CFSG.HardMathSupport.Dickson.I271.Amb.exists_pElement_centralized Nat.prime_three hQ hQN (by rw [hInn]; norm_num)
  obtain ⟨s, rfl⟩ := hzI
  have hs3 : s ^ 3 = 1 := hinj (by rw [map_pow, hz3, map_one])
  have hs1 : s ≠ 1 := fun h => hz1 (by rw [h, map_one])
  refine CFSG.HardMathSupport.Dickson.I271.Amb.l2Eight_balance_of_conj hF e hs3 hs1 ?_
    (mem_normalizer_glaPPrimeCoreOf ⟨hH ⟨s, rfl⟩, ?_⟩)
  · exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).1
      (CFSG.HardMathSupport.Timmesfeld.Proving.coprime_card_GLAPPrimeCoreOf Nat.prime_three _)
  · exact Subgroup.mem_centralizer_singleton_iff.2 (hzx x (Subgroup.mem_zpowers x)).symm

