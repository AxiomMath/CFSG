  have h := CompGood.of_mulEquiv (by norm_num) goodA7_of_equiv (MulAut.conj c⁻¹) hck
  rwa [MulAut.conj_apply, inv_inv, show c⁻¹ * (c * k * c⁻¹) * c = k by group] at h

