theorem balanced_of_chevSimple (hIn : DefCharInnerCoreFree)
    (hOutC : CFSG.HardMathSupport.Dickson.I271.DefCharOuterCoreFree) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    {T : Type} [Group T] [Finite T] (hT : IsSimpleGroup T) (hnab : ∃ a b : T, a * b ≠ b * a)
    (h27 : ¬ (p = 3 ∧ CFSG.HardMathSupport.Solomon.Coordinator.IsLTwoTwentySeven T))
    (hC : CFSG.Yardstones.Md0ec50421ce4.IsChevSimple p T) : IsLocallyOTwoBalancedWrtP p 1 T := by
    rcases hC with ⟨i, hi, ⟨e⟩⟩ | ⟨i, hi, ⟨e⟩⟩
    · cases i with
      | lie idx =>
        exact balanced_of_one hp hp2 (isLocallyOneBalancedAbs_of_defChar hIn hOutC hT hnab ⟨e⟩ hp hp2 hi h27)
      | _ => exact hi.elim
    · cases i with
      | cyclic r hr => simp [CFSG.Yardstones.Md0ec50421ce4.ambiguousChev] at hi
      | alternating n hn =>
        simp only [CFSG.Yardstones.Md0ec50421ce4.ambiguousChev] at hi
        rcases hi with ⟨rfl, h | rfl⟩ | ⟨rfl, h | rfl⟩ | ⟨rfl, h⟩
        · exact absurd h hp2
        · exact balanced_of_alt (m := 5) hp hp2 le_rfl dvd_rfl e
        · exact absurd h hp2
        · exact balanced_of_alt (m := 6) hp hp2 (by norm_num) (by norm_num) e
        · exact absurd h hp2
      | lie d =>
        obtain ⟨ld, hv⟩ := d
        cases ld
        case A r q =>
          rcases r with _ | _ | r
          · simp [CFSG.Yardstones.Md0ec50421ce4.ambiguousChev] at hi
          · simp only [CFSG.Yardstones.Md0ec50421ce4.ambiguousChev] at hi
            rcases hi with ⟨-, h2⟩ | ⟨hq8, rfl⟩
            · exact absurd h2 hp2
            · haveI : Fact q.p.Prime := ⟨q.prime_p⟩
              have hF8 : Nat.card (GaloisField q.p q.exponent) = 8 := by
                rw [GaloisField.card q.p q.exponent q.exponent_pos.ne', ← TauCeti.PrimePower.card_def]
                exact hq8
              exact balanced_of_one Nat.prime_three (by norm_num) (isLocallyOneBalancedAbs_L28 hF8 hT hnab
                (e.trans (CFSG.ClassicalModels.linearCatalogCandidateEquivPSL 1 q hv)))
          · simp [CFSG.Yardstones.Md0ec50421ce4.ambiguousChev] at hi
        case twistedA r q =>
          rcases r with _ | _ | _ | _ | r
          · simp [CFSG.Yardstones.Md0ec50421ce4.ambiguousChev] at hi
          · simp [CFSG.Yardstones.Md0ec50421ce4.ambiguousChev] at hi
          · simp only [CFSG.Yardstones.Md0ec50421ce4.ambiguousChev] at hi
            exact absurd hi.2 hp2
          · simp only [CFSG.Yardstones.Md0ec50421ce4.ambiguousChev] at hi
            obtain ⟨hq2, rfl⟩ := hi
            exact balanced_of_one Nat.prime_three (by norm_num) (isLocallyOneBalancedAbs_U42 hq2 hT hnab e)
          · simp [CFSG.Yardstones.Md0ec50421ce4.ambiguousChev] at hi
        all_goals simp [CFSG.Yardstones.Md0ec50421ce4.ambiguousChev] at hi
      | sporadic s => simp [CFSG.Yardstones.Md0ec50421ce4.ambiguousChev] at hi

