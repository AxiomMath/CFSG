section CompGood

open scoped commutatorElement
open CFSG.Yardstones.Md0ec50421ce4 (PSimple)

@[expose] def CompGood (p : ℕ) (Good : ∀ (T : Type) [Group T], Prop) {Q : Type} [Group Q] (k : Q) : Prop :=
  ∀ I : Subgroup Q, GLAPComponent p (Subgroup.centralizer ({k} : Set Q)) I → Good (PSimple p I)

theorem CompGood.of_mulEquiv {p : ℕ} (hp : p.Prime) {Good : ∀ (T : Type) [Group T], Prop}
    (hG : SporTables.TypeInv Good) {Q Q' : Type} [Group Q] [Group Q'] [Finite Q'] (σ : Q ≃* Q') {k : Q}
    (h : CompGood p Good k) : CompGood p Good (σ k) := by
  intro I hI
  have hI' := CFSG.HardMathSupport.Dickson.I271.glaPComponent_map_equiv hp σ.symm hI
  rw [CFSG.HardMathSupport.Solomon.Coordinator.map_centralizer_mulEquiv, MulEquiv.symm_apply_apply] at hI'
  exact hG _ _ (CFSG.HardMathSupport.Dickson.I271.pSimpleEquiv p
    (I.equivMapOfInjective σ.symm.toMonoidHom σ.symm.injective)).symm (h _ hI')

theorem compGood_of_shapeRkAt {p : ℕ} (hp : p.Prime) {Q : Type} [Group Q] [Finite Q]
    {Good Rk : ∀ (T : Type) [Group T], Prop} {k : Q}
    (h : CFSG.HardMathSupport.Dickson.I271.ShapeRkAt p Good Rk k) : CompGood p Good k := by
  intro I hI
  rcases h with hc | ⟨J, -, huniq, hg, -⟩
  · exact (CFSG.HardMathSupport.Dickson.I271.no_glaPComponent_of_pConstrainedShape hp hc hI).elim
  · rw [huniq I hI]
    exact hg

theorem compGood_of_lines {n p : ℕ} (hp : p.Prime) {Good : ∀ (T : Type) [Group T], Prop} (hG : SporTables.TypeInv Good)
    {P Q : Subgroup (Equiv.Perm (Fin n))} (hQP : Q ≤ P) (hQ : Nat.card Q = p ^ (Nat.card P).factorization p)
    {ι : Type*} (line : ι → Equiv.Perm (Fin n))
    (hlines : ∀ H : Subgroup (Equiv.Perm (Fin n)), H ≤ Q → Nat.card H = p → ∃ j, H = Subgroup.zpowers (line j))
    (hmem : ∀ j, line j ∈ P) (hline : ∀ j, CompGood p Good (⟨line j, hmem j⟩ : ↥P)) :
    ∀ k : ↥P, orderOf k = p → CompGood p Good k := by
  haveI : Fact p.Prime := ⟨hp⟩
  intro k hk
  have hko : orderOf (k : Equiv.Perm (Fin n)) = p := by rw [Subgroup.orderOf_coe]; exact hk
  obtain ⟨g, hgP, hgQ⟩ :=
    CFSG.HardMathSupport.Timmesfeld.SporadicBalance.Co3T.exists_conj_mem_of_full hQP hQ k.2 hko
  obtain ⟨t, htdef⟩ : ∃ t, t = g⁻¹ * (k : Equiv.Perm (Fin n)) * g := ⟨_, rfl⟩
  have hto : orderOf t = p := by
    have := (MulAut.conj g⁻¹ : Equiv.Perm (Fin n) ≃* Equiv.Perm (Fin n)).orderOf_eq k
    simpa [MulAut.conj_apply, htdef, hko] using this
  rw [← htdef] at hgQ
  obtain ⟨j, hj⟩ := hlines (Subgroup.zpowers t) ((Subgroup.zpowers_le).2 hgQ) (by rw [Nat.card_zpowers, hto])
  have htP : t ∈ P := by rw [htdef]; exact P.mul_mem (P.mul_mem (P.inv_mem hgP) k.2) hgP
  have ht : CompGood p Good (⟨t, htP⟩ : ↥P) := by
    have hc := (CFSG.HardMathSupport.Solomon.Coordinator.centralizer_singleton_eq_of_zpowers
      (CFSG.LocalAnalysis.GLTheoremA.KDSpor.zpowers_subtype_eq (a := (⟨t, htP⟩ : ↥P)) (b := ⟨line j, hmem j⟩) hj))
    intro I hI
    rw [hc] at hI
    exact hline j I hI
  have hk' : MulAut.conj (⟨g, hgP⟩ : ↥P) (⟨t, htP⟩ : ↥P) = k := by
    apply Subtype.ext
    simp only [MulAut.conj_apply, Subgroup.coe_mul, Subgroup.coe_inv, htdef]
    group
  rw [← hk']
  exact CompGood.of_mulEquiv hp hG _ ht

theorem compGood_conj {n p : ℕ} (hp : p.Prime) {Good : ∀ (T : Type) [Group T], Prop} (hG : SporTables.TypeInv Good)
    {P R : Subgroup (Equiv.Perm (Fin n))} (hR : ∀ r ∈ R, ∀ q ∈ P, r * q * r⁻¹ ∈ P)
    {r y : Equiv.Perm (Fin n)} (hr : r ∈ R) (hyP : y ∈ P) (h : CompGood p Good (⟨y, hyP⟩ : ↥P)) :
    CompGood p Good (⟨r * y * r⁻¹, hR r hr y hyP⟩ : ↥P) :=
  CompGood.of_mulEquiv hp hG (CFSG.LocalAnalysis.GLTheoremA.KDSpor.conjP hR hr) h

theorem compGood_of_pgroup_record {n p : ℕ} {P R : Subgroup (Equiv.Perm (Fin n))} (hp : p.Prime) (hPR : P ≤ R)
    {x : Equiv.Perm (Fin n)} (hxP : x ∈ P) {C A : Subgroup (Equiv.Perm (Fin n))}
    (hC : C = Subgroup.centralizer ({x} : Set (Equiv.Perm (Fin n))) ⊓ R) (hAC : A ≤ C)
    (hAn : (A.subgroupOf C).Normal) (hAP : A ≤ P) (hAp : IsPGroup p ↥A)
    (hAc : Subgroup.centralizer (A : Set (Equiv.Perm (Fin n))) ⊓ C ≤ A) {Good : ∀ (T : Type) [Group T], Prop} :
    CompGood p Good (⟨x, hxP⟩ : ↥P) := by
  intro I hI
  refine (CFSG.HardMathSupport.Dickson.I271.no_glaPComponent_of_pConstrainedShape hp ?_ hI).elim
  refine CFSG.HardMathSupport.Dickson.I271.pConstrainedShape_of_map_injective P.subtype
    P.subtype_injective ?_
  rw [CFSG.HardMathSupport.Dickson.I271.map_centralizer_subtype']
  have hCP : Subgroup.centralizer ({x} : Set (Equiv.Perm (Fin n))) ⊓ P ≤ C := by
    rw [hC]
    exact inf_le_inf_left _ hPR
  refine CFSG.HardMathSupport.Dickson.I271.pConstrainedShape_of_normal_pgroup
    (fun a ha => ⟨(hC ▸ hAC ha : a ∈ _ ⊓ R).1, hAP ha⟩) ⟨fun a ha g => ?_⟩ hAp
    ((inf_le_inf_left _ hCP).trans hAc)
  rw [Subgroup.mem_subgroupOf] at ha ⊢
  have := hAn.conj_mem ⟨a, hAC ha⟩ (Subgroup.mem_subgroupOf.2 ha) ⟨g, hCP g.2⟩
  exact Subgroup.mem_subgroupOf.1 this

theorem compGood_of_derived_record {n p : ℕ} {P R : Subgroup (Equiv.Perm (Fin n))} (hp : p.Prime) (hPR : P ≤ R)
    {x : Equiv.Perm (Fin n)} (hxP : x ∈ P) {C D : Subgroup (Equiv.Perm (Fin n))}
    (hC : C = Subgroup.centralizer ({x} : Set (Equiv.Perm (Fin n))) ⊓ R) (hD : D = ⁅C, C⁆)
    (hDs : IsSimpleGroup ↥D) (hDnab : ∃ g ∈ D, ∃ h ∈ D, g * h ≠ h * g) (hDP : D ≤ P)
    (hDcent : Subgroup.centralizer (D : Set (Equiv.Perm (Fin n))) ⊓ C = Subgroup.zpowers x)
    (hxo : orderOf x = p)
    (hcore : GLAPPrimeCoreOf p (Subgroup.centralizer ({x} : Set (Equiv.Perm (Fin n))) ⊓ P) = ⊥)
    (hpD : p ∣ Nat.card ↥D) {Good : ∀ (T : Type) [Group T], Prop} (hG : SporTables.TypeInv Good)
    (hgood : Good ↥D) : CompGood p Good (⟨x, hxP⟩ : ↥P) := by
  haveI : Fact p.Prime := ⟨hp⟩
  set k : ↥P := ⟨x, hxP⟩ with hk
  set Cq : Subgroup ↥P := Subgroup.centralizer ({k} : Set ↥P) with hCq
  set L : Subgroup ↥P := D.subgroupOf P with hL
  let eL : ↥L ≃* ↥D := Subgroup.subgroupOfEquivOfLe hDP
  haveI hLs : IsSimpleGroup ↥L := (MulEquiv.isSimpleGroup_congr eL).2 hDs
  have hLnab : ∃ a b : ↥L, a * b ≠ b * a := by
    obtain ⟨g, hg, h, hh, hgh⟩ := hDnab
    refine ⟨eL.symm ⟨g, hg⟩, eL.symm ⟨h, hh⟩, fun he => hgh ?_⟩
    have := congrArg (fun z => ((eL z : ↥D) : Equiv.Perm (Fin n))) he
    simpa using this
  have hLq : CFSG.Open.IsQuasisimple ↥L :=
    CFSG.HardMathSupport.Dickson.I271.isQuasisimpleOpen_of_simple_nonab hLnab
  have hDC : D ≤ C := by
    rw [hD, Subgroup.commutator_le]
    intro a ha c hc
    rw [commutatorElement_def]
    exact C.mul_mem (C.mul_mem (C.mul_mem ha hc) (C.inv_mem ha)) (C.inv_mem hc)
  have hxcent : x ∈ Subgroup.centralizer (D : Set (Equiv.Perm (Fin n))) := by
    have : x ∈ Subgroup.zpowers x := Subgroup.mem_zpowers x
    rw [← hDcent] at this
    exact this.1
  have hgC : ∀ g : ↥P, g ∈ Cq → (g : Equiv.Perm (Fin n)) ∈ C := by
    intro g hg
    rw [hC]
    refine Subgroup.mem_inf.2 ⟨?_, hPR g.2⟩
    rw [Subgroup.mem_centralizer_singleton_iff] at hg ⊢
    exact congrArg Subtype.val hg
  have hLC : L ≤ Cq := by
    intro l hl
    rw [hCq, Subgroup.mem_centralizer_singleton_iff]
    apply Subtype.ext
    exact (Subgroup.mem_centralizer_iff.1 hxcent _ (Subgroup.mem_subgroupOf.1 hl))
  have hLn : ∀ g ∈ Cq, ∀ l ∈ L, g * l * g⁻¹ ∈ L := by
    intro g hg l hl
    rw [hL, Subgroup.mem_subgroupOf] at hl ⊢
