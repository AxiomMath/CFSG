theorem mem_normalizer_glaPPrimeCoreOf {G : Type*} [Group G] {p : ℕ} {C : Subgroup G} {g : G} (hg : g ∈ C) :
    g ∈ Subgroup.normalizer ((GLAPPrimeCoreOf p C : Subgroup G) : Set G) := by
