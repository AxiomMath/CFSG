theorem downRow_of_centTypes {p : ℕ} (hp : p.Prime) {name : TauCeti.SporadicName} {Q : Type} [Group Q]
    (e : Q ≃* (TauCeti.CFSGIndex.sporadic name).Group) {Good : ∀ (T : Type) [Group T], Prop}
    (hG : SporTables.CentTypes p Good Q)
    (hbal : ∀ (T : Type) [Group T] [Finite T], IsSimpleGroup T → (∃ a b : T, a * b ≠ b * a) → Good T →
      IsLocallyOTwoBalancedWrtP p 1 T) : DownRow name p := by
  intro T _ _ ⟨f⟩ s hs I hI
  haveI : Finite Q := Finite.of_equiv T (f.trans e.symm).toEquiv
  obtain ⟨hI', ⟨g⟩⟩ := Inputs1415.comp_transport hp (f.trans e.symm) hI
  have hs' : orderOf ((f.trans e.symm) s) = p := by rw [MulEquiv.orderOf_eq, hs]
  obtain ⟨hS, hnab⟩ := CFSG.LocalAnalysis.GLTheoremA.chev_pSimple_simple_nonabelian hp hI'
  exact typeInv_bal p _ _ g.symm (hbal _ hS hnab (hG _ hs' _ hI'))

theorem centTypes_of_centShapeSplit {p : ℕ} (hp : p.Prime) {Q : Type} [Group Q] [Finite Q]
    (h : CFSG.HardMathSupport.Dickson.I271.CentShapeSplit p Q) :
    SporTables.CentTypes p (fun T _ => CFSG.HardMathSupport.Dickson.I271.LeafType p T ∨
      CFSG.HardMathSupport.Dickson.I271.IsA6At p T) Q := by
  intro s hs I hI
  have hs1 : s ≠ 1 := fun h1 => by rw [h1, orderOf_one] at hs; exact hp.one_lt.ne' hs.symm
  have hsp : s ^ p = 1 := by rw [← hs]; exact pow_orderOf_eq_one s
  rcases h s hs1 hsp with hc | ⟨J, -, hu, hg⟩
  · exact (CFSG.HardMathSupport.Dickson.I271.no_glaPComponent_of_pConstrainedShape hp hc hI).elim
  · rw [hu I hI]
    rcases hg with hg | ⟨hg, -⟩
    · exact Or.inl hg
    · exact Or.inr hg

theorem centTypes_of_constrained {p : ℕ} (hp : p.Prime) {Q : Type} [Group Q] [Finite Q]
