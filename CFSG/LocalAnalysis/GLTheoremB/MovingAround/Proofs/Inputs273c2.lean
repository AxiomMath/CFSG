  exact hxy ((IsSimpleGroup.comm_iff_isSolvable.2 hs) x y)

theorem false_of_card_dvd_pow_mul_pow {T : Type} [Group T] [Finite T] (hT : IsSimpleGroup T)
    (hnab : ∃ a b : T, a * b ≠ b * a) {p q a b : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q)
    (h : Nat.card T ∣ p ^ a * q ^ b) : False := by
  obtain ⟨k₁, k₂, h1, h2, hk⟩ := Nat.dvd_mul.1 h
  obtain ⟨i, -, rfl⟩ := (Nat.dvd_prime_pow hp).1 h1
  obtain ⟨j, -, rfl⟩ := (Nat.dvd_prime_pow hq).1 h2
  exact false_of_card_eq_pow_mul_pow hT hnab hp hq hpq hk.symm

