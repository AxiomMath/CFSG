theorem card_centralizer_conj_inf {M : Type*} [Group M] {R : Subgroup M} {g : M} (hg : g ∈ R) (x : M) :
    Nat.card ↥(Subgroup.centralizer ({g * x * g⁻¹} : Set M) ⊓ R) =
      Nat.card ↥(Subgroup.centralizer ({x} : Set M) ⊓ R) := by
  refine Nat.card_congr
    { toFun := fun c => ⟨g⁻¹ * c * g, ?_, R.mul_mem (R.mul_mem (R.inv_mem hg) c.2.2) hg⟩
      invFun := fun c => ⟨g * c * g⁻¹, ?_, R.mul_mem (R.mul_mem hg c.2.2) (R.inv_mem hg)⟩
      left_inv := fun c => Subtype.ext (by simp [mul_assoc])
      right_inv := fun c => Subtype.ext (by simp [mul_assoc]) }
  · have hc := Subgroup.mem_centralizer_singleton_iff.1 c.2.1
    refine Subgroup.mem_centralizer_singleton_iff.2 ?_
    calc g⁻¹ * (c : M) * g * x = g⁻¹ * ((c : M) * (g * x * g⁻¹)) * g := by group
      _ = g⁻¹ * (g * x * g⁻¹ * c) * g := by rw [hc]
      _ = x * (g⁻¹ * c * g) := by group
  · have hc := Subgroup.mem_centralizer_singleton_iff.1 c.2.1
    refine Subgroup.mem_centralizer_singleton_iff.2 ?_
    calc g * (c : M) * g⁻¹ * (g * x * g⁻¹) = g * ((c : M) * x) * g⁻¹ := by group
      _ = g * (x * c) * g⁻¹ := by rw [hc]
      _ = g * x * g⁻¹ * (g * c * g⁻¹) := by group

theorem card_dvd_of_records {M : Type*} [Group M] [Finite M] {p : ℕ} (hp : p.Prime) {P Q R : Subgroup M}
    (hPR : P ≤ R) (hQP : Q ≤ P) (hQsyl : ∃ S : Sylow p P, (S : Subgroup P) = Q.subgroupOf P)
    {ι : Type*} {line k : ι → M} {rec : ι → ι}
    (hlines : {H : Subgroup M | H ≤ Q ∧ Nat.card H = p} = Set.range fun j => Subgroup.zpowers (line j))
    (htrans : ∀ j, k j ∈ R ∧ k j * line (rec j) * (k j)⁻¹ = line j) {N : ℕ}
    (hrec : ∀ j, Nat.card ↥(Subgroup.centralizer ({line (rec j)} : Set M) ⊓ R) ∣ N) :
    ∀ y ∈ P, orderOf y = p → Nat.card ↥(Subgroup.centralizer ({y} : Set M) ⊓ R) ∣ N := by
  have : Fact p.Prime := ⟨hp⟩
  refine forall_of_lines hp hQP (card_eq_of_sylow_subgroupOf hQP hQsyl) line (lines_of_eq hlines)
    (fun x => Nat.card ↥(Subgroup.centralizer ({x} : Set M) ⊓ R) ∣ N)
    (fun g hg x hx => by rw [card_centralizer_conj_inf (hPR hg) x]; exact hx)
    (fun a b hab h => by rwa [← centralizer_singleton_eq_of_zpowers hab]) fun j => ?_
  obtain ⟨hkR, hkc⟩ := htrans j
  show Nat.card ↥(Subgroup.centralizer ({line j} : Set M) ⊓ R) ∣ N
  rw [← hkc, card_centralizer_conj_inf hkR]
  exact hrec j

theorem card_centralizer_dvd_of_ambient {M : Type*} [Group M] [Finite M] {P R : Subgroup M} (hPR : P ≤ R) {p N : ℕ}
    (h : ∀ y ∈ P, orderOf y = p → Nat.card ↥(Subgroup.centralizer ({y} : Set M) ⊓ R) ∣ N) :
    ∀ s : ↥P, orderOf s = p → Nat.card (Subgroup.centralizer ({s} : Set ↥P)) ∣ N := by
  intro s hs
  have hmap := map_centralizer_subtype (P := P) s
  have hc : Nat.card (Subgroup.centralizer ({s} : Set ↥P)) =
      Nat.card ↥(Subgroup.centralizer ({(s : M)} : Set M) ⊓ P) := by
    rw [← hmap, Subgroup.card_map_of_injective P.subtype_injective]
  rw [hc]
  exact (Subgroup.card_dvd_of_le (inf_le_inf_left _ hPR)).trans (h s s.2 (by rw [Subgroup.orderOf_coe]; exact hs))

