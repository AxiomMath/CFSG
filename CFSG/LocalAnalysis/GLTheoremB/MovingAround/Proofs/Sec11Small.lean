section PPrimeCoreFacts

variable {G : Type} [Group G] [Finite G]

theorem sec11_glaPPrimeCoreOf_conj_mem {p : ℕ} [Fact p.Prime] {H : Subgroup G} {g x : G} (hg : g ∈ H)
    (hx : x ∈ GLAPPrimeCoreOf p H) : g * x * g⁻¹ ∈ GLAPPrimeCoreOf p H := by
  unfold GLAPPrimeCoreOf at hx ⊢
  obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.1 hx
  have hN : (GLAPPrimeCore p ↥H).Normal := inferInstance
  refine Subgroup.mem_map.2 ⟨(⟨g, hg⟩ : H) * y * (⟨g, hg⟩ : H)⁻¹, hN.conj_mem y hy _, ?_⟩
  simp

theorem sec11_glaPPrimeCoreOf_le {p : ℕ} (H : Subgroup G) : GLAPPrimeCoreOf p H ≤ H := by
  unfold GLAPPrimeCoreOf
  exact Subgroup.map_subtype_le _

theorem sec11_glaPPrimeCoreOf_coprime {p : ℕ} [Fact p.Prime] (H : Subgroup G) :
    Nat.Coprime p (Nat.card (GLAPPrimeCoreOf p H)) := by
  unfold GLAPPrimeCoreOf
  rw [Subgroup.card_map_of_injective H.subtype_injective]
  exact CFSG.pPrimeCore_coprime_card

theorem sec11_le_normalizer_glaPPrimeCoreOf {p : ℕ} [Fact p.Prime] (H : Subgroup G) :
    H ≤ Subgroup.normalizer (GLAPPrimeCoreOf p H : Set G) := by
  intro g hg
  rw [Subgroup.mem_set_normalizer_iff]
  intro x
  constructor
  · exact sec11_glaPPrimeCoreOf_conj_mem hg
  · intro hx
    have h := sec11_glaPPrimeCoreOf_conj_mem (H.inv_mem hg) hx
    have e : g⁻¹ * (g * x * g⁻¹) * g⁻¹⁻¹ = x := by group
    rwa [e] at h

theorem sec11_le_glaPPrimeCoreOf {p : ℕ} [Fact p.Prime] {H N : Subgroup G} (hNH : N ≤ H)
    (hN : ∀ h ∈ H, ∀ n ∈ N, h * n * h⁻¹ ∈ N) (hcop : Nat.Coprime p (Nat.card N)) :
    N ≤ GLAPPrimeCoreOf p H := by
  have hnorm : (N.subgroupOf H).Normal := ⟨fun n hn g => by
    rw [Subgroup.mem_subgroupOf] at hn ⊢
    have h := hN (g : G) g.2 (n : G) hn
    simpa using h⟩
  have hcard : Nat.card (N.subgroupOf H) = Nat.card N :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hNH).toEquiv
  have hle : N.subgroupOf H ≤ GLAPPrimeCore p ↥H :=
    le_sSup ⟨hnorm, by rw [hcard]; exact hcop⟩
  have hNeq : N = (N.subgroupOf H).map H.subtype := by
    rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.2 hNH]
  unfold GLAPPrimeCoreOf
  calc N = (N.subgroupOf H).map H.subtype := hNeq
    _ ≤ (GLAPPrimeCore p ↥H).map H.subtype := Subgroup.map_mono hle

theorem sec11_glaPPrimeCoreOf_inf_centralizer_le {p : ℕ} [Fact p.Prime] {a e : G} :
    GLAPPrimeCoreOf p (Subgroup.centralizer ({a} : Set G)) ⊓ Subgroup.centralizer ({e} : Set G) ≤
      GLAPPrimeCoreOf p (Subgroup.centralizer ({e, a} : Set G)) := by
  have hXa : GLAPPrimeCoreOf p (Subgroup.centralizer ({a} : Set G)) ≤ Subgroup.centralizer ({a} : Set G) :=
    sec11_glaPPrimeCoreOf_le _
  have hcomm_a : ∀ x ∈ GLAPPrimeCoreOf p (Subgroup.centralizer ({a} : Set G)), a * x = x * a :=
    fun x hx => Subgroup.mem_centralizer_iff.1 (hXa hx) a (Set.mem_singleton a)
  apply sec11_le_glaPPrimeCoreOf
  · intro x hx
    obtain ⟨hxX, hxe⟩ := Subgroup.mem_inf.1 hx
    rw [Subgroup.mem_centralizer_iff] at hxe ⊢
    intro k hk
    rcases Set.mem_insert_iff.1 hk with hk' | hk'
    · rw [hk']
      exact hxe e (Set.mem_singleton e)
    · rw [Set.mem_singleton_iff.1 hk']
      exact hcomm_a x hxX
  · intro h hh n hn
    have hha : h ∈ Subgroup.centralizer ({a} : Set G) :=
      Subgroup.mem_centralizer_iff.2 fun k hk => by
        rw [Set.mem_singleton_iff.1 hk]
        exact Subgroup.mem_centralizer_iff.1 hh a (Set.mem_insert_of_mem _ rfl)
    have hce : Commute e h := Subgroup.mem_centralizer_iff.1 hh e (Set.mem_insert _ _)
    obtain ⟨hnX, hne⟩ := Subgroup.mem_inf.1 hn
    have hcn : Commute e n := Subgroup.mem_centralizer_iff.1 hne e (Set.mem_singleton e)
    refine Subgroup.mem_inf.2 ⟨sec11_glaPPrimeCoreOf_conj_mem hha hnX, ?_⟩
    refine Subgroup.mem_centralizer_iff.2 fun k hk => ?_
    rw [Set.mem_singleton_iff.1 hk]
    exact (((hce.mul_right hcn).mul_right hce.inv_right)).eq
  · exact Nat.Coprime.coprime_dvd_right (Subgroup.card_dvd_of_le inf_le_left)
      (sec11_glaPPrimeCoreOf_coprime _)

