theorem prop111_of_prop112 (h112 : Prop112Statement) : Prop111Statement := by
  intro G _ _ m p B M E A h a ha ha1
  have hp : p.Prime := h.standing.prime
  haveI : Fact p.Prime := ⟨hp⟩
  by_cases hD : ∃ A1 : Subgroup G, inD p M A1 ∧ a ∈ A1
  · obtain ⟨A1, hA1, haA1⟩ := hD
    exact le_sup_left.trans (hA1.2.clause_a a haA1 ha1)
  obtain ⟨hEinD, hAinDp, h2⟩ := h.pair.1
  have hAel : CFSG.Open.IsElemAbelian p A := hAinDp.1.1.2.1
  obtain ⟨K, hKA0, hK, hKcard⟩ := CFSG.SectionRank.exists_pRank hp.one_lt (E ⊓ A)
  obtain ⟨D, hDK, hDel, hDcard⟩ := exists_le_isElemAbelian_card hK (n := 2)
    (by rw [hKcard]; exact pow_dvd_pow p h2)
  have hDA0 : D ≤ E ⊓ A := hDK.trans hKA0
  have hDC : D ≤ Subgroup.centralizer ({a} : Set G) := by
    intro d hd
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    rw [hy]
    exact elemAbelian_comm hAel ha (hDA0 hd).2
  have hDnorm : D ≤ Subgroup.normalizer (GLAPPrimeCoreOf p (Subgroup.centralizer ({a} : Set G)) : Set G) :=
    hDC.trans (sec11_le_normalizer_glaPPrimeCoreOf _)
  have hXcop : ¬ p ∣ Nat.card (GLAPPrimeCoreOf p (Subgroup.centralizer ({a} : Set G))) :=
    (Nat.Prime.coprime_iff_not_dvd hp).1 (sec11_glaPPrimeCoreOf_coprime _)
  have hgen := CFSG.RankThreeEvenClassification.Helpers.coprime_centralizer_generation_of_plane p hp D
    (GLAPPrimeCoreOf p (Subgroup.centralizer ({a} : Set G)))
    (fun d => Subtype.ext (by simpa using hDel.2 (d : G) d.2)) hDcard hXcop hDnorm
  refine hgen.le.trans (iSup_le fun d => iSup_le fun hd => ?_)
  have hdEA : (d : G) ∈ E ⊓ A := hDA0 d.2
  have hd1 : (d : G) ≠ 1 := fun h' => hd (Subtype.ext h')
  rcases h112 h ha ha1 hdEA hd1 with h2' | ⟨A1, hA1, haA1⟩
  · exact sec11_glaPPrimeCoreOf_inf_centralizer_le.trans h2'
  · exact absurd ⟨A1, hA1, haA1⟩ hD

section Lemma113

variable {G : Type} [Group G] [Finite G]

theorem sec11_le_pRank_of_pow_le_card {p : ℕ} [Fact p.Prime] {E : Subgroup G} (hE : IsElemAbelian p E)
    {k : ℕ} (hk : p ^ k ≤ Nat.card E) : k ≤ CFSG.Open.pRank p E := by
  obtain ⟨r, hr⟩ := exists_card_eq_pow (isPGroup_of_isElemAbelian' hE)
  rw [hr] at hk
  have hkr : k ≤ r := (Nat.pow_le_pow_iff_right (Fact.out : p.Prime).one_lt).1 hk
  exact hkr.trans (CFSG.SectionRank.le_pRank (Fact.out : p.Prime).one_lt le_rfl hE hr)

theorem sec11_nine_le_card_inf_centralizer {E : Subgroup G} (hE : IsElemAbelian 3 E)
    (hEc : Nat.card E = 3 ^ 4) {x : G} (hxN : x ∈ Subgroup.normalizer (E : Set G)) (hx3 : x ^ 3 = 1) :
    9 ≤ Nat.card ↥(E ⊓ Subgroup.centralizer ({x} : Set G)) := by
  classical
  have hcomm : ∀ a b : E, a * b = b * a := fun a b => hE.1.is_comm.comm a b
  let _ : CommGroup E := { (inferInstance : Group E) with mul_comm := hcomm }
  let α : E →* E := MonoidHom.mk'
    (fun e => ⟨x * e * x⁻¹, (Subgroup.mem_normalizer_iff.1 hxN e).1 e.2⟩) (by
      intro a b
      apply Subtype.ext
      simp [mul_assoc])
  have hx111 : x * x * x = 1 := by simpa [pow_succ] using hx3
  have hα : ∀ e, α (α (α e)) = e := by
    intro e
    apply Subtype.ext
    change x * (x * (x * (e : G) * x⁻¹) * x⁻¹) * x⁻¹ = e
    have : x * (x * (x * (e : G) * x⁻¹) * x⁻¹) * x⁻¹ = (x * x * x) * e * (x * x * x)⁻¹ := by
      group
    rw [this, hx111]
    simp
  have h3 : ∀ y : E, y ^ 3 = 1 := fun y => Subtype.ext (by simpa using hE.2 y y.2)
  have h9 := CFSG.LocalAnalysis.RankFourTheoremC.nine_le_card_eqLocus (E := E) hEc h3 α hα
  refine h9.trans ?_
  calc Nat.card (MonoidHom.eqLocus α (MonoidHom.id E))
      = Nat.card ((MonoidHom.eqLocus α (MonoidHom.id E)).map E.subtype) :=
        (Subgroup.card_map_of_injective E.subtype_injective).symm
    _ ≤ Nat.card ↥(E ⊓ Subgroup.centralizer ({x} : Set G)) := by
      refine Subgroup.card_le_of_le ?_
      rintro _ ⟨f, hf, rfl⟩
      refine Subgroup.mem_inf.2 ⟨f.2, Subgroup.mem_centralizer_singleton_iff.2 ?_⟩
      have hf' : α f = f := hf
      have := congrArg Subtype.val hf'
      change x * (f : G) * x⁻¹ = f at this
      calc (f : G) * x = (x * (f : G) * x⁻¹) * x := by rw [this]
        _ = x * (f : G) := by group

theorem sec11_exists_isSCp_above {p : ℕ} {M Y : Subgroup G} (hYM : Y ≤ M) (hY : IsElemAbelian p Y) :
    ∃ H : Subgroup G, IsSCp p M H ∧ Y ≤ H := by
  obtain ⟨H, hYH, hHmax⟩ :=
    (Set.toFinite {X : Subgroup G | X ≤ M ∧ IsElemAbelian p X}).exists_le_maximal
      (show Y ∈ {X : Subgroup G | X ≤ M ∧ IsElemAbelian p X} from ⟨hYM, hY⟩)
  exact ⟨H, ⟨hHmax.1.1, hHmax.1.2, fun E' hE'M hE' hHE' =>
    le_antisymm (hHmax.2 ⟨hE'M, hE'⟩ hHE') hHE'⟩, hYH⟩

end Lemma113

theorem lemma113_i_of_104v (h104v : Lemma104_vStatement) : Lemma113_iStatement := by
  intro G _ _ m B M E A h a ha ha1 hna
  have hp : (3 : ℕ).Prime := Nat.prime_three
  haveI : Fact (3 : ℕ).Prime := ⟨hp⟩
  have hp1 : 1 < 3 := by norm_num
  obtain ⟨hEinD, hAinDp, h2EA⟩ := h.pair.1
  have hEsc : IsSCp 3 M E := hEinD.1.1
  have hAsc : IsSCp 3 M A := hAinDp.1.1
  have hAM : A ≤ M := hAsc.1
  have hAel : IsElemAbelian 3 A := hAsc.2.1
  have hEel : IsElemAbelian 3 E := hEsc.2.1
  have h3E : 3 ≤ CFSG.Open.pRank 3 E := hEinD.1.2
  have h3A : 3 ≤ CFSG.Open.pRank 3 A := hAinDp.1.2
  have ha3 : a ^ 3 = 1 := hAel.2 a ha
  by_contra hlt
  have hE3 : CFSG.Open.pRank 3 E = 3 := by omega
  obtain ⟨hBmax, -⟩ := h.bOne
  unfold GLAIsBmax at hBmax
  obtain ⟨hBel, hBcard0, -⟩ := hBmax
  have hBcard : Nat.card B = 3 ^ m := by rw [hBcard0, h.standing.rank_eq]
  have hm4 : 4 ≤ m := h.standing.four_le
  have hB4 : 4 ≤ CFSG.Open.pRank 3 B :=
    le_trans hm4 (sec11_le_pRank_of_pow_le_card hBel (k := m) hBcard.symm.le)
  have hBM : B ≤ M := by
    have hB3 : B ≤ GLBCore 3 3 B := by
      unfold GLBCore
      exact Subgroup.le_normalizer.trans (le_sSup ⟨B, le_rfl, by omega, rfl⟩)
    exact hB3.trans h.pre.2.2
  obtain ⟨x, -, S, hSp, hSM, hAS, hBxS⟩ :=
    exists_conj_le_pGroup' (p := 3) (K := M) hAM (isPGroup_of_isElemAbelian' hAel) hBM
      (isPGroup_of_isElemAbelian' hBel)
  have hBx4 : 4 ≤ CFSG.Open.pRank 3 (GLBConj x B) := by
    rw [pRank_gLBConj' hp1 x B]
    exact hB4
  have hS4 : 4 ≤ CFSG.Open.pRank 3 S := hBx4.trans (CFSG.SectionRank.pRank_mono hp1 hBxS)
  obtain ⟨R, hR, hSR⟩ := exists_sylowIn_above hSM hSp
  have hR4 : 4 ≤ CFSG.Open.pRank 3 R := hS4.trans (CFSG.SectionRank.pRank_mono hp1 hSR)
  have haR : a ∈ R := hSR (hAS ha)
  have hRM : R ≤ M := hR.1
  have hRp : IsPGroup 3 ↥R := hR.2.1
  obtain ⟨E1, hE1R, hRN, hE1el, hE1card⟩ :=
    CFSG.HardMathSupport.Timmesfeld.ComponentBalance.gl83NormalElementaryRankFour_holds G R hRp hR4
  have h104 := (h104v h.toSec10Fails h.pair (Or.inl hE3) hR).1
  obtain ⟨-, -, E1s, hE1s, hE1E1s⟩ := h104 E1 ⟨hE1R, hE1el, hE1card⟩
  have hE1rank : 4 ≤ CFSG.Open.pRank 3 E1s :=
    CFSG.SectionRank.le_pRank hp1 hE1E1s hE1el hE1card
  by_cases haE1 : a ∈ E1
  · exact hna ⟨E1s, hE1s, hE1E1s haE1⟩
  obtain ⟨C, hC⟩ : ∃ C : Subgroup G, C = E1 ⊓ Subgroup.centralizer ({a} : Set G) := ⟨_, rfl⟩
  have hmemC : ∀ c, c ∈ C ↔ c ∈ E1 ∧ c * a = a * c := by
    intro c
    rw [hC, Subgroup.mem_inf]
    constructor
    · rintro ⟨hcE, hca⟩
      exact ⟨hcE, (Subgroup.mem_centralizer_iff.1 hca a (Set.mem_singleton a)).symm⟩
    · rintro ⟨hcE, hca⟩
      exact ⟨hcE, Subgroup.mem_centralizer_iff.2 fun k hk => by
        rw [Set.mem_singleton_iff.1 hk]
        exact hca.symm⟩
  have hCE1 : C ≤ E1 := fun c hc => ((hmemC c).1 hc).1
  have hCel : IsElemAbelian 3 C := isElemAbelian_mono hE1el hCE1
  have h9C : 9 ≤ Nat.card C := by
    rw [hC]
    exact sec11_nine_le_card_inf_centralizer hE1el hE1card (hRN haR) ha3
  have hanC : a ∉ C := fun h' => haE1 ((hmemC a).1 h').1
  have hCcomm : ∀ c ∈ C, c * a = a * c := fun c hc => ((hmemC c).1 hc).2
  have hzel : IsElemAbelian 3 (Subgroup.zpowers a) := CFSG.Open.isElemAbelian_zpowers ha3
  have hle : Subgroup.zpowers a ≤ Subgroup.centralizer (C : Set G) := by
    rw [Subgroup.zpowers_le, Subgroup.mem_centralizer_iff]
    intro c hc
    exact hCcomm c hc
  have hYel : IsElemAbelian 3 (Subgroup.zpowers a ⊔ C) :=
    isElemAbelian_sup_of_commute hzel hCel hle
  have hYcard : Nat.card ↥(Subgroup.zpowers a ⊔ C) = Nat.card C * 3 := by
    rw [sup_comm]
    exact CFSG.RankThree.PartOne.Planes.card_sup_zpowers Nat.prime_three C ha3 hanC hCcomm
  have hYM : Subgroup.zpowers a ⊔ C ≤ M :=
    sup_le (Subgroup.zpowers_le.2 (hAM ha)) (hCE1.trans (hE1R.trans hRM))
  obtain ⟨A1, hA1, hYA1⟩ := sec11_exists_isSCp_above hYM hYel
  have h3A1 : 3 ≤ CFSG.Open.pRank 3 A1 := by
    have h1 := Subgroup.card_le_of_le hYA1
    rw [hYcard] at h1
    have hcardA1 : 3 ^ 3 ≤ Nat.card A1 := by
      norm_num
      omega
    exact sec11_le_pRank_of_pow_le_card hA1.2.1 hcardA1
  have hA1star : IsSCstar 3 M A1 := ⟨hA1, h3A1⟩
  have haA1 : a ∈ A1 := hYA1 (Subgroup.mem_sup_left (Subgroup.mem_zpowers a))
  have hA1D' : inDp 3 M A1 := ⟨hA1star, fun hU => hna ⟨A1, ⟨hA1star, hU⟩, haA1⟩⟩
  have hCsub : C ≤ E1s ⊓ A1 := fun c hc =>
    Subgroup.mem_inf.2 ⟨hE1E1s (hCE1 hc), hYA1 (Subgroup.mem_sup_right hc)⟩
  have hC2 : 2 ≤ CFSG.Open.pRank 3 C := sec11_le_pRank_of_pow_le_card hCel (k := 2) (by
    norm_num
    exact h9C)
  have hC2' : 2 ≤ CFSG.Open.pRank 3 (E1s ⊓ A1) := hC2.trans (CFSG.SectionRank.pRank_mono hp1 hCsub)
  have hDD : inDDp 3 M E1s A1 := ⟨hE1s, hA1D', hC2'⟩
  have key := h.pair.2 E1s A1 hDD
  have hk2 : CFSG.Open.pRank 3 (E ⊓ A) ≤ 2 := by
    by_contra hk
    have hk3 : CFSG.Open.pRank 3 (E ⊓ A) = 3 := by
      have := CFSG.SectionRank.pRank_mono hp1 (inf_le_left : E ⊓ A ≤ E)
      omega
    obtain ⟨K, hKEA, hKel, hKcard⟩ := CFSG.SectionRank.exists_pRank hp1 (E ⊓ A)
    rw [hk3] at hKcard
    obtain ⟨r, hr⟩ := exists_card_eq_pow (isPGroup_of_isElemAbelian' hEel)
    have hrE : r ≤ 3 := by
      have := CFSG.SectionRank.le_pRank hp1 (le_refl E) hEel hr
      omega
    have hEle : Nat.card E ≤ Nat.card K := by
      rw [hKcard, hr]
      exact Nat.pow_le_pow_right (by norm_num) hrE
    have hKE : K = E := Subgroup.eq_of_le_of_card_ge (hKEA.trans inf_le_left) hEle
    have hEA : E ≤ A := (hKE ▸ hKEA).trans inf_le_right
    have hAE : A = E := hEsc.2.2 A hAM hAel hEA
    exact hAinDp.2 (by rw [hAE]; exact hEinD.2)
  have hs1 : 3 ≤ min (CFSG.Open.pRank 3 E1s) (CFSG.Open.pRank 3 A1) :=
    le_min (by omega) h3A1
  have hs0 : min (CFSG.Open.pRank 3 E) (CFSG.Open.pRank 3 A) = 3 := by
    rw [hE3]
    omega
  unfold ddKey at key
  simp only [Prod.Lex.toLex_le_toLex] at key
  omega

end CFSG.LocalAnalysis.GLTheoremB.MovingAround
