theorem commute_of_normalizes_tG {y : GL V₄ (ZMod 3)} (hy3 : y ^ 3 = 1)
    (hy : y * tG * y⁻¹ ∈ Subgroup.zpowers tG) : y * tG = tG * y := by
  classical
  have hy' := (mem_zpowers_iff_mem_range_orderOf (x := tG)).mp hy
  obtain ⟨m, hm5, hm⟩ := Finset.mem_image.mp hy'
  rw [Finset.mem_range, orderOf_tG] at hm5
  have hk : ∀ k : ℕ, y ^ k * tG * (y ^ k)⁻¹ = tG ^ (m ^ k) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      calc y ^ (k + 1) * tG * (y ^ (k + 1))⁻¹ = y * (y ^ k * tG * (y ^ k)⁻¹) * y⁻¹ := by group
        _ = y * tG ^ (m ^ k) * y⁻¹ := by rw [ih]
        _ = (y * tG * y⁻¹) ^ (m ^ k) := by rw [conj_pow]
        _ = tG ^ (m ^ (k + 1)) := by rw [← hm, ← pow_mul, pow_succ, mul_comm]
  have h3 := hk 3
  rw [hy3, one_mul, inv_one, mul_one] at h3
  have hmod : 1 ≡ m ^ 3 [MOD 5] := by
    rw [← orderOf_tG, ← pow_eq_pow_iff_modEq, pow_one]
    exact h3
  have hm1 : m = 1 := by
    revert hmod
    interval_cases m <;> decide
  rw [hm1, pow_one] at hm
  exact mul_inv_eq_iff_eq_mul.mp hm.symm

theorem false_of_card_45_90 {K : Subgroup (GL V₄ (ZMod 3))} (ht : tG ∈ K)
    (hc : Nat.card K = 45 ∨ Nat.card K = 90) : False := by
  haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  haveI : Finite K := by
    rcases hc with h | h <;> exact Nat.finite_of_card_ne_zero (by rw [h]; norm_num)
  set t' : K := ⟨tG, ht⟩ with ht'
  have hot : orderOf t' = 5 := by rw [← Subgroup.orderOf_coe, ht', orderOf_tG]
  have hfac : (Nat.card K).factorization 5 = 1 := by
    rcases hc with h | h <;> rw [h]
    · rw [show (45 : ℕ) = 5 ^ 1 * 9 by norm_num, Nat.factorization_mul (by norm_num) (by norm_num),
        Finsupp.add_apply, Nat.Prime.factorization_pow (by norm_num), Finsupp.single_eq_same,
        Nat.factorization_eq_zero_of_not_dvd (by norm_num)]
    · rw [show (90 : ℕ) = 5 ^ 1 * 18 by norm_num, Nat.factorization_mul (by norm_num) (by norm_num),
        Finsupp.add_apply, Nat.Prime.factorization_pow (by norm_num), Finsupp.single_eq_same,
        Nat.factorization_eq_zero_of_not_dvd (by norm_num)]
  set P : Sylow 5 K := Sylow.ofCard (Subgroup.zpowers t') (by rw [Nat.card_zpowers, hot, hfac,
    pow_one]) with hP
  have hn1 := card_sylow_modEq_one 5 K
  have hn := Sylow.card_eq_index_normalizer P
  have hdvd : Nat.card (Sylow 5 K) ∣ Nat.card K := by
    rw [hn]
    exact Subgroup.index_dvd_card _
  have hN := Subgroup.card_mul_index (Subgroup.normalizer (P : Set K))
  rw [← hn] at hN
  have h3 : 3 ∣ Nat.card (Subgroup.normalizer (P : Set K)) := by
    rcases hc with h | h <;> rw [h] at hdvd hN
    · have : Nat.card (Sylow 5 K) = 1 := by
        have h45 : Nat.card (Sylow 5 K) ∈ Nat.divisors 45 := Nat.mem_divisors.mpr ⟨hdvd, by norm_num⟩
        have : Nat.divisors 45 = {1, 3, 5, 9, 15, 45} := by decide
        rw [this] at h45
        simp only [Finset.mem_insert, Finset.mem_singleton] at h45
        rcases h45 with h | h | h | h | h | h <;> rw [h] at hn1 ⊢ <;> simp_all [Nat.ModEq]
      rw [this, mul_one] at hN
      rw [hN]
      norm_num
    · have : Nat.card (Sylow 5 K) = 1 ∨ Nat.card (Sylow 5 K) = 6 := by
        have h90 : Nat.card (Sylow 5 K) ∈ Nat.divisors 90 := Nat.mem_divisors.mpr ⟨hdvd, by norm_num⟩
        have : Nat.divisors 90 = {1, 2, 3, 5, 6, 9, 10, 15, 18, 30, 45, 90} := by decide
        rw [this] at h90
        simp only [Finset.mem_insert, Finset.mem_singleton] at h90
        rcases h90 with h | h | h | h | h | h | h | h | h | h | h | h <;> rw [h] at hn1 ⊢ <;>
          simp_all [Nat.ModEq]
      rcases this with h1 | h1 <;> rw [h1] at hN
      · rw [mul_one] at hN
        rw [hN]
        norm_num
      · have : Nat.card (Subgroup.normalizer (P : Set K)) = 15 := by omega
        rw [this]
        norm_num
  obtain ⟨y, hy⟩ := exists_prime_orderOf_dvd_card' 3 h3
  have hyN : ∀ h : K, h ∈ (P : Set K) ↔ (y : K) * h * (y : K)⁻¹ ∈ (P : Set K) := fun h => y.2 h
  have hPz : ∀ h : K, h ∈ (P : Set K) ↔ h ∈ Subgroup.zpowers t' := fun h => by
    rw [hP]
    rfl
  have hyt : ((y : K) : GL V₄ (ZMod 3)) * tG * ((y : K) : GL V₄ (ZMod 3))⁻¹ ∈
      Subgroup.zpowers tG := by
    have := (hPz _).mp ((hyN t').mp ((hPz t').mpr (Subgroup.mem_zpowers t')))
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp this
    refine Subgroup.mem_zpowers_iff.mpr ⟨n, ?_⟩
    have := congrArg Subtype.val hn
    simpa [ht'] using this
  have hy3 : ((y : K) : GL V₄ (ZMod 3)) ^ 3 = 1 := by
    have : (y : K) ^ 3 = 1 := by
      have := congrArg Subtype.val (pow_orderOf_eq_one y)
      rw [hy] at this
      simpa using this
    have := congrArg Subtype.val this
    simpa using this
  have h1 := eq_one_of_commute_tG (commute_of_normalizes_tG hy3 hyt) hy3
  have : orderOf y = 1 := by
