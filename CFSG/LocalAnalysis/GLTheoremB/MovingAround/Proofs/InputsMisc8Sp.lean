@[expose] def gUM (i : ℕ) : M4 := dec (gUc.getD i 0)

@[expose] def tpM (i : ℕ) : M4 := dec (tpc.getD i 0)

@[expose] def ApM (i : ℕ) : M4 := dec (Apc.getD i 0)

@[expose] def A0M : M4 := fromBlocks !![1, 0; 1, 2] !![0, 2; 1, 0] !![0, 1; 2, 0] !![1, 1; 0, 2]

@[expose] def gamM : ℕ → M4
  | 0 => tM
  | _ => uM (0, 1, 0, 0)

@[expose] def gen1 (k : Fin 3) : Par := (E9par k).getD 1 0

@[expose] def gen2 (k : Fin 3) : Par := (E9par k).getD 3 0

@[expose] def letter (i : ℕ) (k : Fin 3) : ℕ → M4
  | 0 => tpM i
  | 1 => uM (gen1 k)
  | _ => uM (gen2 k)

@[expose] def evalW (i : ℕ) (k : Fin 3) (w : List ℕ) : M4 :=
  w.foldl (fun acc l => acc * letter i k l) 1

@[expose] def decV (n : ℕ) : V₄ → ZMod 3 :=
  vec4 ((n % 3 : ℕ) : ZMod 3) ((n / 3 % 3 : ℕ) : ZMod 3) ((n / 9 % 3 : ℕ) : ZMod 3)
    ((n / 27 % 3 : ℕ) : ZMod 3)

@[expose] def decC (n : ℕ) : ZMod 3 := ((n / 81 % 3 : ℕ) : ZMod 3)

theorem gUM_symp : ∀ i : Fin 40,
    (gUM i)ᵀ * fromBlocks 0 1 (-1) 0 * gUM i = fromBlocks 0 1 (-1) 0 := by
  decide +kernel

@[expose] def closChk (i γ : ℕ) : Bool :=
  decide (gUM (closc.getD (2 * i + γ) (0, 0)).1 * dec (closc.getD (2 * i + γ) (0, 0)).2 =
      gamM γ * gUM i) &&
    decide ((closc.getD (2 * i + γ) (0, 0)).1 < 40) &&
    (List.finRange 2).all fun a => (List.finRange 2).all fun b =>
      decide (dec (closc.getD (2 * i + γ) (0, 0)).2 (Sum.inr a) (Sum.inl b) = 0)

theorem closChk_all : ∀ i : Fin 40, ∀ γ : Fin 2, closChk i γ = true := by decide +kernel

@[expose] def conjChk (i : ℕ) : Bool :=
  decide (gUM i * tpM i = tM * gUM i) && decide (gUM i * ApM i = A0M * gUM i)

theorem conjChk_all : ∀ i : Fin 40, conjChk i = true := by decide +kernel

@[expose] noncomputable def certChk (i : ℕ) (k : Fin 3) : Bool :=
  if (certc.getD (3 * i + k) ([], 0)).1 = [] then
    (E9par k).all fun r => decide (uM r * ApM i = ApM i * uM r)
  else
    decide (evalW i k (certc.getD (3 * i + k) ([], 0)).1 =
        spTransMat (decV (certc.getD (3 * i + k) ([], 0)).2) (decC (certc.getD (3 * i + k) ([], 0)).2)) &&
      !decide (decV (certc.getD (3 * i + k) ([], 0)).2 = 0) &&
      !decide (decC (certc.getD (3 * i + k) ([], 0)).2 = 0)

theorem certChk_all : ∀ i : Fin 40, ∀ k : Fin 3, certChk i k = true := by decide +kernel

abbrev Jm : M4 := fromBlocks 0 1 (-1) 0

theorem Jm_sq : Jm * Jm = -1 := by decide +kernel

@[expose] def spUnit (M : M4) (h : Mᵀ * Jm * M = Jm) : GL V₄ (ZMod 3) where
  val := M
  inv := -(Jm * Mᵀ * Jm)
  val_inv := by
    rw [mul_eq_one_comm]
    calc -(Jm * Mᵀ * Jm) * M = -(Jm * (Mᵀ * Jm * M)) := by
          simp only [Matrix.mul_assoc, Matrix.neg_mul]
      _ = 1 := by rw [h, Jm_sq, neg_neg]
  inv_val := by
    calc -(Jm * Mᵀ * Jm) * M = -(Jm * (Mᵀ * Jm * M)) := by
          simp only [Matrix.mul_assoc, Matrix.neg_mul]
      _ = 1 := by rw [h, Jm_sq, neg_neg]

theorem coe_spUnit (M : M4) (h : Mᵀ * Jm * M = Jm) : ((spUnit M h : GL V₄ (ZMod 3)) : M4) = M := rfl

theorem spUnit_mem (M : M4) (h : Mᵀ * Jm * M = Jm) : spUnit M h ∈ StatedSp 2 (ZMod 3) := by
  rw [CFSG.Open.StatedAPI.mem_statedSp_iff]
  exact h

@[expose] def gUG (i : Fin 40) : GL V₄ (ZMod 3) := spUnit (gUM i) (gUM_symp i)

theorem gUG_mem (i : Fin 40) : gUG i ∈ StatedSp 2 (ZMod 3) := spUnit_mem _ _

theorem gUG_zero : gUG 0 = 1 := Units.ext (by
  show gUM 0 = 1
  decide +kernel)

theorem A0M_sq : A0M * A0M = -1 := by decide +kernel

@[expose] def A0G : GL V₄ (ZMod 3) where
  val := A0M
  inv := -A0M
  val_inv := by rw [Matrix.mul_neg, A0M_sq, neg_neg]
  inv_val := by rw [Matrix.neg_mul, A0M_sq, neg_neg]

theorem coe_A0G : ((A0G : GL V₄ (ZMod 3)) : M4) = A0M := rfl

theorem tau0_eq : tau0 = uG (0, 1, 0, 0) := Units.ext (by
  show spTransMat (vec4 1 0 0 0) 2 = uM (0, 1, 0, 0)
  decide +kernel)

theorem uM_x_zero (a b c : ZMod 3) :
    uM (0, a, b, c) = fromBlocks 1 !![a, b; b, c] 0 1 := by
  simp only [uM]
  refine Matrix.fromBlocks_inj.mpr ⟨?_, ?_, rfl, ?_⟩ <;>
    ext i j <;> fin_cases i <;> fin_cases j <;> simp

theorem conj_uG_mem_U0 {n : GL V₄ (ZMod 3)} (hn : n ∈ StatedSp 2 (ZMod 3))
    (hll : ∀ i j : Fin 2, (n : M4) (Sum.inr i) (Sum.inl j) = 0) (a b c : ZMod 3) :
    n * uG (0, a, b, c) * n⁻¹ ∈ U0 := by
  set N : M4 := (n : M4) with hNdef
  set A := N.toBlocks₁₁ with hA
  set B := N.toBlocks₁₂ with hB
  set D := N.toBlocks₂₂ with hD
  have hC : N.toBlocks₂₁ = 0 := by
    ext i j
    exact hll i j
  have hN : N = fromBlocks A B 0 D := by
    rw [← hC]
    exact (Matrix.fromBlocks_toBlocks N).symm
  have hsym : Nᵀ * Jm * N = Jm := CFSG.Open.StatedAPI.mem_statedSp_iff.mp hn
  have hAD : Aᵀ * D = 1 := by
    rw [hN] at hsym
    simp only [Jm, fromBlocks_transpose, fromBlocks_multiply, Matrix.transpose_zero,
      Matrix.zero_mul, Matrix.mul_zero, Matrix.mul_one, Matrix.mul_neg, zero_add, add_zero,
      Matrix.neg_mul, Matrix.one_mul, neg_zero] at hsym
    exact (Matrix.fromBlocks_inj.mp hsym).2.1
  set S : Matrix (Fin 2) (Fin 2) (ZMod 3) := !![a, b; b, c] with hS
  set S' := A * S * Aᵀ with hS'
  have hSt : Sᵀ = S := by
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  have hS't : S'ᵀ = S' := by
    rw [hS', Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose, hSt,
      Matrix.mul_assoc]
  have hS'e : !![S' 0 0, S' 0 1; S' 0 1, S' 1 1] = S' := by
    have h10 : S' 1 0 = S' 0 1 := by
      have := congrFun (congrFun hS't 0) 1
      simpa using this
    ext i j
    fin_cases i <;> fin_cases j <;> simp [h10]
  refine ⟨(0, S' 0 0, S' 0 1, S' 1 1), ?_⟩
  rw [eq_mul_inv_iff_mul_eq]
  apply Units.ext
  rw [Units.val_mul, Units.val_mul, coe_uG, coe_uG, uM_x_zero, uM_x_zero, hS'e, ← hNdef, hN,
    fromBlocks_multiply, fromBlocks_multiply]
  simp only [Matrix.one_mul, Matrix.mul_one, Matrix.zero_mul, Matrix.mul_zero, add_zero,
    zero_add]
  congr 1
  rw [hS', Matrix.mul_assoc, Matrix.mul_assoc, hAD, Matrix.mul_one, add_comm]

theorem E9par_x : ∀ k : Fin 3, ∀ r ∈ E9par k, r.1 = 0 := by decide

theorem E9par_comm : ∀ k : Fin 3, ∀ p ∈ E9par k, ∀ q ∈ E9par k, law p q = law q p := by
  decide +kernel

theorem E9par_pow3 : ∀ k : Fin 3, ∀ p ∈ E9par k, ppow p 3 = 0 := by decide +kernel

theorem E9par_minor : ∀ k : Fin 3, ∀ r ∈ E9par k, r ≠ 0 →
    r.2.1 * r.2.2.2 - r.2.2.1 * r.2.2.1 ≠ 0 := by
  decide

theorem gen_mem : ∀ k : Fin 3, gen1 k ∈ E9par k ∧ gen2 k ∈ E9par k := by decide

theorem isElemAbelian_Estd (k : Fin 3) : CFSG.Open.IsElemAbelian 3 (Estd k) := by
  refine ⟨⟨⟨fun x y => ?_⟩⟩, ?_⟩
  · obtain ⟨_, ⟨p, hp, rfl⟩⟩ := x
    obtain ⟨_, ⟨q, hq, rfl⟩⟩ := y
    apply Subtype.ext
    simp only [Subgroup.coe_mul, uG_mul, E9par_comm k p hp q hq]
  · rintro _ ⟨p, hp, rfl⟩
    rw [uG_pow, E9par_pow3 k p hp, uG_zero]

theorem spTrans_ne_one {a : V₄ → ZMod 3} {c : ZMod 3} (ha : a ≠ 0) (hc : c ≠ 0) :
    spTrans a c ≠ 1 := by
  intro h
  obtain ⟨x, hx⟩ : ∃ x, spForm 2 (ZMod 3) x a ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact ha (spForm_nondegenerate.2 a hcon)
  have := congrArg (fun g : GL V₄ (ZMod 3) => (g : M4) *ᵥ x) h
  simp only [spTrans_mulVec, Units.val_one, Matrix.one_mulVec, add_eq_left] at this
  rcases smul_eq_zero.mp this with h1 | h1
  · exact mul_ne_zero hc hx h1
  · exact ha h1

theorem uG_ne_spTrans {k : Fin 3} {r : Par} (hr : r ∈ E9par k) {a : V₄ → ZMod 3} {c : ZMod 3}
    (ha : a ≠ 0) (hc : c ≠ 0) : uG r ≠ spTrans a c := by
  intro h
  by_cases hr0 : r = 0
  · rw [hr0, uG_zero] at h
    exact spTrans_ne_one ha hc h.symm
  have hm := E9par_minor k r hr hr0
  have hx := E9par_x k r hr
  obtain ⟨x, a', b', c'⟩ := r
  simp only at hx hm
  subst hx
  have hM := congrArg Units.val h
  rw [coe_uG, coe_spTrans] at hM
  have e1 := congrFun (congrFun hM (Sum.inl 0)) (Sum.inr 0)
  have e2 := congrFun (congrFun hM (Sum.inl 0)) (Sum.inr 1)
  have e3 := congrFun (congrFun hM (Sum.inl 1)) (Sum.inr 1)
  simp [uM, spTransMat, Matrix.vecMulVec_apply, Matrix.mulVec, dotProduct,
    Fintype.sum_sum_type, Fin.sum_univ_two, Matrix.one_apply] at e1 e2 e3
  apply hm
  rw [e1, e2, e3]
  ring

theorem Estd_tf (k : Fin 3) {a : V₄ → ZMod 3} {c : ZMod 3} (ha : a ≠ 0) (hc : c ≠ 0) :
    spTrans a c ∉ Estd k := by
  rintro ⟨r, hr, he⟩
  exact uG_ne_spTrans hr ha hc he

theorem tf_map_conj {E : Subgroup (GL V₄ (ZMod 3))} {g : GL V₄ (ZMod 3)}
    (hg : g ∈ StatedSp 2 (ZMod 3))
    (htf : ∀ (a : V₄ → ZMod 3) (c : ZMod 3), a ≠ 0 → c ≠ 0 → spTrans a c ∉ E)
    (a : V₄ → ZMod 3) (c : ZMod 3) (ha : a ≠ 0) (hc : c ≠ 0) :
    spTrans a c ∉ E.map (MulAut.conj g).toMonoidHom := by
  rintro ⟨x, hx, hxe⟩
  have hgi : g⁻¹ ∈ StatedSp 2 (ZMod 3) := inv_mem hg
  have hx' : x = spTrans (((g⁻¹ : GL V₄ (ZMod 3)) : M4) *ᵥ a) c := by
    rw [← conj_spTrans hgi, ← hxe]
    simp [MulAut.conj_apply, mul_assoc]
  refine htf _ c ?_ hc (hx' ▸ hx)
  intro h0
  apply ha
  have := congrArg ((g : GL V₄ (ZMod 3)) : M4).mulVec h0
  rwa [Matrix.mulVec_mulVec, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.one_mulVec,
    Matrix.mulVec_zero] at this

theorem isElemAbelian_map {E : Subgroup (GL V₄ (ZMod 3))} (hE : CFSG.Open.IsElemAbelian 3 E)
    (φ : GL V₄ (ZMod 3) →* GL V₄ (ZMod 3)) : CFSG.Open.IsElemAbelian 3 (E.map φ) := by
  refine ⟨⟨⟨fun x y => ?_⟩⟩, ?_⟩
  · obtain ⟨_, ⟨x', hx', rfl⟩⟩ := x
    obtain ⟨_, ⟨y', hy', rfl⟩⟩ := y
    apply Subtype.ext
    have hc := congrArg Subtype.val (hE.1.is_comm.comm (⟨x', hx'⟩ : E) ⟨y', hy'⟩)
    simp only [Subgroup.coe_mul] at hc ⊢
    rw [← map_mul, ← map_mul, hc]
  · rintro _ ⟨x, hx, rfl⟩
    rw [← map_pow, hE.2 x hx, map_one]

theorem exists_map_conj_Estd {n : GL V₄ (ZMod 3)} (hn : n ∈ StatedSp 2 (ZMod 3))
    (hll : ∀ i j : Fin 2, (n : M4) (Sum.inr i) (Sum.inl j) = 0) (k : Fin 3) :
    ∃ k' : Fin 3, (Estd k).map (MulAut.conj n).toMonoidHom = Estd k' := by
  refine exists_eq_Estd ?_ (isElemAbelian_map (isElemAbelian_Estd k) _) ?_
    (tf_map_conj hn (fun a c ha hc => Estd_tf k ha hc))
  · rintro _ ⟨_, ⟨r, hr, rfl⟩, rfl⟩
    obtain ⟨x, a, b, c⟩ := r
    have hx := E9par_x k _ hr
    simp only at hx
    subst hx
    simpa [MulAut.conj_apply] using conj_uG_mem_U0 hn hll a b c
  · rw [Subgroup.card_map_of_injective (MulAut.conj n).injective, card_Estd]

@[expose] noncomputable def gamG : ℕ → GL V₄ (ZMod 3)
  | 0 => tG
  | _ => tau0

theorem coe_gamG (γ : ℕ) : ((gamG γ : GL V₄ (ZMod 3)) : M4) = gamM γ := by
  rcases γ with _ | γ
  · rfl
  · show ((tau0 : GL V₄ (ZMod 3)) : M4) = uM (0, 1, 0, 0)
    rw [tau0_eq, coe_uG]

theorem gamG_mem (γ : ℕ) : gamG γ ∈ StatedSp 2 (ZMod 3) := by
  rcases γ with _ | γ
  · exact tG_mem
  · exact spTrans_mem_statedSp _ _

@[expose] def InList (g : GL V₄ (ZMod 3)) : Prop :=
  ∀ k : Fin 3, ∃ (i : Fin 40) (k' : Fin 3),
    (Estd k).map (MulAut.conj g).toMonoidHom = (Estd k').map (MulAut.conj (gUG i)).toMonoidHom

theorem map_conj_mul (E : Subgroup (GL V₄ (ZMod 3))) (g h : GL V₄ (ZMod 3)) :
    E.map (MulAut.conj (g * h)).toMonoidHom =
      (E.map (MulAut.conj h).toMonoidHom).map (MulAut.conj g).toMonoidHom := by
  rw [Subgroup.map_map]
  congr 1
  ext x
  simp [MulAut.conj_apply, mul_assoc]

theorem map_conj_one (E : Subgroup (GL V₄ (ZMod 3))) :
    E.map (MulAut.conj (1 : GL V₄ (ZMod 3))).toMonoidHom = E := by
  ext x
  simp [MulAut.conj_apply]

theorem inList_one : InList 1 := fun k => ⟨0, k, by rw [gUG_zero]⟩

theorem inList_gam (γ : Fin 2) {g : GL V₄ (ZMod 3)} (hg : InList g) : InList (gamG γ * g) := by
  intro k
  obtain ⟨i, k', he⟩ := hg k
  have hc := closChk_all i γ
  simp only [closChk, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_finRange,
    forall_const] at hc
  obtain ⟨⟨hmul, hlt⟩, hll⟩ := hc
  set e := closc.getD (2 * (i : ℕ) + γ) (0, 0) with he_def
  set j : Fin 40 := ⟨e.1, hlt⟩ with hj
  set n : GL V₄ (ZMod 3) := (gUG j)⁻¹ * gamG γ * gUG i with hn
  have h1 : ((gUG j : GL V₄ (ZMod 3)) : M4) * dec e.2 =
      ((gamG γ * gUG i : GL V₄ (ZMod 3)) : M4) := by
    rw [Units.val_mul, coe_gamG]
    exact hmul
  have hnM : ((n : GL V₄ (ZMod 3)) : M4) = dec e.2 := by
    calc ((n : GL V₄ (ZMod 3)) : M4)
        = (((gUG j)⁻¹ : GL V₄ (ZMod 3)) : M4) * (((gUG j : GL V₄ (ZMod 3)) : M4) * dec e.2) := by
          rw [h1, hn, Units.val_mul, Units.val_mul, Units.val_mul, Matrix.mul_assoc]
      _ = dec e.2 := by
          rw [← Matrix.mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, Matrix.one_mul]
  have hnS : n ∈ StatedSp 2 (ZMod 3) :=
    mul_mem (mul_mem (inv_mem (gUG_mem j)) (gamG_mem γ)) (gUG_mem i)
  have hnll : ∀ a b : Fin 2, (n : M4) (Sum.inr a) (Sum.inl b) = 0 := fun a b => by
    rw [hnM]
    exact hll a b
  obtain ⟨k'', hk''⟩ := exists_map_conj_Estd hnS hnll k'
  refine ⟨j, k'', ?_⟩
  have hgn : gamG γ * gUG i = gUG j * n := by
    rw [hn]
    group
  rw [map_conj_mul, he, ← map_conj_mul, hgn, map_conj_mul, hk'']

theorem inList_pow_gam (γ : Fin 2) (m : ℕ) {g : GL V₄ (ZMod 3)} (hg : InList g) :
    InList (gamG γ ^ m * g) := by
  induction m with
  | zero => simpa using hg
  | succ m ih =>
    rw [pow_succ', mul_assoc]
    exact inList_gam γ ih

theorem tau0_pow_three : tau0 ^ 3 = 1 := by
  rw [tau0_eq, uG_pow]
  have : ppow (0, 1, 0, 0) 3 = 0 := by decide
  rw [this, uG_zero]

theorem gamG_inv (γ : Fin 2) : ∃ m : ℕ, (gamG γ)⁻¹ = gamG γ ^ m := by
  fin_cases γ
  · refine ⟨4, ?_⟩
    show tG⁻¹ = tG ^ 4
    rw [inv_eq_of_mul_eq_one_right (by rw [← pow_succ', tG_pow_five])]
  · refine ⟨2, ?_⟩
    show tau0⁻¹ = tau0 ^ 2
    rw [inv_eq_of_mul_eq_one_right (by rw [← pow_succ', tau0_pow_three])]

theorem inList_of_mem {g : GL V₄ (ZMod 3)} (hg : g ∈ StatedSp 2 (ZMod 3)) : InList g := by
  rw [← closure_tG_tau0] at hg
  have hgen : ∀ x ∈ ({tG, tau0} : Set (GL V₄ (ZMod 3))), ∃ γ : Fin 2, x = gamG γ := by
    rintro x (rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩
  refine Subgroup.closure_induction_left (p := fun g _ => InList g) inList_one ?_ ?_ hg
  · intro x hx y _ ih
    obtain ⟨γ, rfl⟩ := hgen x hx
    exact inList_gam γ ih
  · intro x hx y _ ih
    obtain ⟨γ, rfl⟩ := hgen x hx
    obtain ⟨m, hm⟩ := gamG_inv γ
    rw [hm]
    exact inList_pow_gam γ m ih

@[expose] noncomputable def letterG (i : Fin 40) (k : Fin 3) : ℕ → GL V₄ (ZMod 3)
  | 0 => (gUG i)⁻¹ * tG * gUG i
  | 1 => uG (gen1 k)
  | _ => uG (gen2 k)

theorem coe_letterG (i : Fin 40) (k : Fin 3) (l : ℕ) :
    ((letterG i k l : GL V₄ (ZMod 3)) : M4) = letter i k l := by
  rcases l with _ | _ | l
  · have hc := conjChk_all i
    simp only [conjChk, Bool.and_eq_true, decide_eq_true_eq] at hc
    have hg : ((gUG i : GL V₄ (ZMod 3)) : M4) = gUM i := rfl
    show ((((gUG i)⁻¹ * tG * gUG i : GL V₄ (ZMod 3))) : M4) = tpM i
    rw [Units.val_mul, Units.val_mul, coe_tG, Matrix.mul_assoc, hg, ← hc.1, ← Matrix.mul_assoc,
      ← hg, ← Units.val_mul, inv_mul_cancel, Units.val_one, Matrix.one_mul]
  · rfl
  · rfl

theorem coe_foldl_letterG (i : Fin 40) (k : Fin 3) (w : List ℕ) (g : GL V₄ (ZMod 3)) :
    ((w.foldl (fun acc l => acc * letterG i k l) g : GL V₄ (ZMod 3)) : M4) =
      w.foldl (fun acc l => acc * letter i k l) (g : M4) := by
  induction w generalizing g with
  | nil => rfl
  | cons l w ih =>
    rw [List.foldl_cons, List.foldl_cons, ih, Units.val_mul, coe_letterG]

theorem conj_foldl_mem (i : Fin 40) (k : Fin 3) (w : List ℕ) (g : GL V₄ (ZMod 3))
    (hg : gUG i * g * (gUG i)⁻¹ ∈ Subgroup.closure
      (insert tG ((Estd k).map (MulAut.conj (gUG i)).toMonoidHom : Set (GL V₄ (ZMod 3))))) :
    gUG i * (w.foldl (fun acc l => acc * letterG i k l) g) * (gUG i)⁻¹ ∈ Subgroup.closure
      (insert tG ((Estd k).map (MulAut.conj (gUG i)).toMonoidHom : Set (GL V₄ (ZMod 3)))) := by
  induction w generalizing g with
  | nil => exact hg
  | cons l w ih =>
    rw [List.foldl_cons]
    apply ih
    have hl : gUG i * letterG i k l * (gUG i)⁻¹ ∈ Subgroup.closure
        (insert tG ((Estd k).map (MulAut.conj (gUG i)).toMonoidHom : Set (GL V₄ (ZMod 3)))) := by
      apply Subgroup.subset_closure
      rcases l with _ | _ | l
      · left
        show gUG i * ((gUG i)⁻¹ * tG * gUG i) * (gUG i)⁻¹ = tG
        group
      · right
        exact ⟨uG (gen1 k), ⟨gen1 k, (gen_mem k).1, rfl⟩, rfl⟩
      · right
        exact ⟨uG (gen2 k), ⟨gen2 k, (gen_mem k).2, rfl⟩, rfl⟩
    have e : gUG i * (g * letterG i k l) * (gUG i)⁻¹ =
        (gUG i * g * (gUG i)⁻¹) * (gUG i * letterG i k l * (gUG i)⁻¹) := by group
    rw [e]
    exact mul_mem hg hl

theorem lemmaY (i : Fin 40) (k : Fin 3) :
    (∀ x ∈ (Estd k).map (MulAut.conj (gUG i)).toMonoidHom, x * A0G = A0G * x) ∨
      ∃ (a : V₄ → ZMod 3) (c : ZMod 3), a ≠ 0 ∧ c ≠ 0 ∧ spTrans a c ∈ Subgroup.closure
        (insert tG ((Estd k).map (MulAut.conj (gUG i)).toMonoidHom : Set (GL V₄ (ZMod 3)))) := by
  have hc := certChk_all i k
  have hcj := conjChk_all i
  simp only [conjChk, Bool.and_eq_true, decide_eq_true_eq] at hcj
  obtain ⟨-, hAp⟩ := hcj
  unfold certChk at hc
  split_ifs at hc with hw
  · left
    rw [List.all_eq_true] at hc
    rintro _ ⟨_, ⟨r, hr, rfl⟩, rfl⟩
    have hr' := hc r hr
    rw [decide_eq_true_eq] at hr'
    have hg : ((gUG i : GL V₄ (ZMod 3)) : M4) = gUM i := rfl
    have hApG : (((gUG i)⁻¹ * A0G * gUG i : GL V₄ (ZMod 3)) : M4) = ApM i := by
      rw [Units.val_mul, Units.val_mul, coe_A0G, Matrix.mul_assoc, hg, ← hAp, ← Matrix.mul_assoc,
        ← hg, ← Units.val_mul, inv_mul_cancel, Units.val_one, Matrix.one_mul]
    have hcomm : uG r * ((gUG i)⁻¹ * A0G * gUG i) = ((gUG i)⁻¹ * A0G * gUG i) * uG r := by
      apply Units.ext
      rw [Units.val_mul (uG r), Units.val_mul _ (uG r), hApG, coe_uG]
      exact hr'
    show MulAut.conj (gUG i) (uG r) * A0G = A0G * MulAut.conj (gUG i) (uG r)
    rw [MulAut.conj_apply]
    calc gUG i * uG r * (gUG i)⁻¹ * A0G
        = gUG i * (uG r * ((gUG i)⁻¹ * A0G * gUG i)) * (gUG i)⁻¹ := by group
      _ = gUG i * (((gUG i)⁻¹ * A0G * gUG i) * uG r) * (gUG i)⁻¹ := by rw [hcomm]
      _ = A0G * (gUG i * uG r * (gUG i)⁻¹) := by group
  · right
    simp only [Bool.and_eq_true, decide_eq_true_eq, Bool.not_eq_true', decide_eq_false_iff_not]
      at hc
    obtain ⟨⟨hev, hv⟩, hc0⟩ := hc
    set e := certc.getD (3 * (i : ℕ) + k) ([], 0) with he
    refine ⟨((gUG i : GL V₄ (ZMod 3)) : M4) *ᵥ decV e.2, decC e.2, ?_, hc0, ?_⟩
    · intro h0
      apply hv
      have := congrArg (((gUG i)⁻¹ : GL V₄ (ZMod 3)) : M4).mulVec h0
      rwa [Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one, Matrix.one_mulVec,
        Matrix.mulVec_zero] at this
    · have h1 : e.1.foldl (fun acc l => acc * letterG i k l) 1 = spTrans (decV e.2) (decC e.2) := by
        apply Units.ext
        rw [coe_foldl_letterG, coe_spTrans, Units.val_one]
        exact hev
      rw [← conj_spTrans (gUG_mem i), ← h1]
      exact conj_foldl_mem i k e.1 1 (by
        rw [mul_one, mul_inv_cancel]
        exact one_mem _)

theorem lemmaY_of_mem {g : GL V₄ (ZMod 3)} (hg : g ∈ StatedSp 2 (ZMod 3)) (k : Fin 3) :
    (∀ x ∈ (Estd k).map (MulAut.conj g).toMonoidHom, x * A0G = A0G * x) ∨
      ∃ (a : V₄ → ZMod 3) (c : ZMod 3), a ≠ 0 ∧ c ≠ 0 ∧ spTrans a c ∈ Subgroup.closure
        (insert tG ((Estd k).map (MulAut.conj g).toMonoidHom : Set (GL V₄ (ZMod 3)))) := by
  obtain ⟨i, k', he⟩ := inList_of_mem hg k
  rw [he]
  exact lemmaY i k'

theorem exists_eq_map_Estd {P : Subgroup (GL V₄ (ZMod 3))} (hPS : P ≤ StatedSp 2 (ZMod 3))
    (hP : CFSG.Open.IsElemAbelian 3 P) (hc : Nat.card P = 9)
    (htf : ∀ (a : V₄ → ZMod 3) (c : ZMod 3), a ≠ 0 → c ≠ 0 → spTrans a c ∉ P) :
    ∃ g ∈ StatedSp 2 (ZMod 3), ∃ k : Fin 3, P = (Estd k).map (MulAut.conj g).toMonoidHom := by
  have hPp : IsPGroup 3 P := fun y => ⟨1, Subtype.ext (by simpa using hP.2 y y.2)⟩
  obtain ⟨g, hg, hgP⟩ := exists_conj_le_U0 hPS hPp
  set P' := P.map (MulAut.conj g⁻¹).toMonoidHom with hP'
  have hP'U : P' ≤ U0 := by
    rintro _ ⟨x, hx, rfl⟩
    simpa [MulAut.conj_apply] using hgP x hx
  obtain ⟨k, hk⟩ := exists_eq_Estd hP'U (isElemAbelian_map hP _)
    (by rw [hP', Subgroup.card_map_of_injective (MulAut.conj g⁻¹).injective, hc])
    (tf_map_conj (inv_mem hg) htf)
  refine ⟨g, hg, k, ?_⟩
  rw [← hk, hP', ← map_conj_mul, mul_inv_cancel, map_conj_one]

theorem commute_A0_of_tf {H : Subgroup (GL V₄ (ZMod 3))} (hHS : H ≤ StatedSp 2 (ZMod 3))
    (ht : tG ∈ H) (htf : ∀ (a : V₄ → ZMod 3) (c : ZMod 3), a ≠ 0 → c ≠ 0 → spTrans a c ∉ H)
    {P : Subgroup (GL V₄ (ZMod 3))} (hPH : P ≤ H) (hP : CFSG.Open.IsElemAbelian 3 P)
    (hc : Nat.card P = 9) : ∀ x ∈ P, x * A0G = A0G * x := by
  obtain ⟨g, hg, k, rfl⟩ := exists_eq_map_Estd (hPH.trans hHS) hP hc
    (fun a c ha hc0 h => htf a c ha hc0 (hPH h))
  rcases lemmaY_of_mem hg k with h | ⟨a, c, ha, hc0, hT⟩
  · exact h
  · exfalso
    refine htf a c ha hc0 ((Subgroup.closure_le H).mpr ?_ hT)
    rintro _ (rfl | hx)
    · exact ht
    · exact hPH hx

section Theta

open CFSG.ClassicalInvolution.Q3 CFSG.ClassicalInvolution.Q3.TL4.SpL
  CFSG.ClassicalInvolution.Q3.TL4.Gauss CFSG.ClassicalInvolution.ModelFacts.Orth15
open scoped MatrixGroups

local notation "ωF" => CFSG.ClassicalInvolution.Q3.TL4.SpL.omega (ZMod 3) 2

local instance fact_card_zmod_three : Fact (Nat.card (ZMod 3) = 3) := ⟨Nat.card_zmod 3⟩

theorem A0_sq_lin : ∀ v, glLin A0G (glLin A0G v) = -v := fun v => by
  rw [glLin_apply, glLin_apply, Matrix.mulVec_mulVec, coe_A0G, A0M_sq, Matrix.neg_mulVec,
    Matrix.one_mulVec]

@[instance_reducible] noncomputable def moduleA0 : Module (GaussField (ZMod 3)) (V₄ → ZMod 3) :=
  gaussModule (glLin A0G) A0_sq_lin

attribute [local instance] moduleA0

theorem towerA0 : IsScalarTower (ZMod 3) (GaussField (ZMod 3)) (V₄ → ZMod 3) := ⟨fun c z v => by
  show (c • z).re • v + (c • z).im • glLin A0G v = c • (z.re • v + z.im • glLin A0G v)
  rw [QuadraticAlgebra.re_smul, QuadraticAlgebra.im_smul, smul_add, smul_eq_mul, smul_eq_mul,
    mul_smul, mul_smul]⟩

attribute [local instance] towerA0

theorem omega_smul_A0 :
    ∀ v, (QuadraticAlgebra.omega : GaussField (ZMod 3)) • v = glLin A0G v := fun v => by
  show (QuadraticAlgebra.omega : GaussField (ZMod 3)).re • v +
    (QuadraticAlgebra.omega : GaussField (ZMod 3)).im • glLin A0G v = _
  rw [QuadraticAlgebra.re_omega, QuadraticAlgebra.im_omega, zero_smul, one_smul, zero_add]

theorem A0M_mult : A0Mᵀ * CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher.formJ 2 (ZMod 3) * A0M =
    (-1 : ZMod 3) • CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher.formJ 2 (ZMod 3) := by
  decide +kernel

theorem omega_A0 : ∀ u v, ωF (glLin A0G u) (glLin A0G v) = -ωF u v :=
  fun u v => by
    rw [glLin_apply, glLin_apply, coe_A0G,
      CFSG.ClassicalInvolution.Q3.TL4.SpL.omega_mulVec A0M_mult, neg_one_mul]

theorem exists_beta_A0 :
    ∃ e f : V₄ → ZMod 3, spBilin ωF omega_smul_A0 omega_A0 e f = 1 :=
  exists_beta_eq_one omega_smul_A0 omega_A0

@[expose] noncomputable def thetaA0 : SL(2, GaussField (ZMod 3)) →* GL V₄ (ZMod 3) :=
  theta omega_smul_A0 omega_A0 (Classical.choose_spec (Classical.choose_spec exists_beta_A0))

theorem thetaA0_injective : Function.Injective thetaA0 := theta_injective _ _ _

@[expose] def CA0 : Subgroup (GL V₄ (ZMod 3)) :=
  StatedSp 2 (ZMod 3) ⊓ Subgroup.centralizer {A0G}

theorem mem_CA0 {g : GL V₄ (ZMod 3)} :
    g ∈ CA0 ↔ g ∈ StatedSp 2 (ZMod 3) ∧ g * A0G = A0G * g := by
  rw [CA0, Subgroup.mem_inf, Subgroup.mem_centralizer_singleton_iff]

theorem range_thetaA0 : thetaA0.range = CA0 := by
  ext g
  rw [mem_CA0]
  constructor
  · rintro ⟨X, rfl⟩
