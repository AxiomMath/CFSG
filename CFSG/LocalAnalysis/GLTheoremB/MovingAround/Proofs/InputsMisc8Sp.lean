theorem eq_CA0_of_le {K : Subgroup (GL V₄ (ZMod 3))} (hK : K ≤ CA0) (ht : tG ∈ K)
    (h9 : 9 ∣ Nat.card K) : K = CA0 := by
  by_contra hne
  set K' := K.subgroupOf CA0 with hK'
  have hK'c : Nat.card K' = Nat.card K := Nat.card_congr (Subgroup.subgroupOfEquivOfLe hK).toEquiv
  have hK'top : K' ≠ ⊤ := by
    intro h
    apply hne
    refine le_antisymm hK fun x hx => ?_
    have : (⟨x, hx⟩ : CA0) ∈ K' := h ▸ Subgroup.mem_top _
    exact Subgroup.mem_subgroupOf.mp this
  rcases normal_eq_top_or_le_center isQuasisimple_CA0 (Subgroup.normalCore_normal K') with
    hct | hcz
  · exact hK'top (eq_top_iff.mpr (hct ▸ Subgroup.normalCore_le K'))
  · have hidx := Subgroup.index_normalCore_dvd_factorial_index K'
    have hcc : Nat.card K'.normalCore ≤ 2 := (Subgroup.card_le_of_le hcz).trans card_center_CA0_le
    have h1 := Subgroup.card_mul_index K'.normalCore
    rw [card_CA0] at h1
    have h360 : 360 ≤ K'.normalCore.index := by nlinarith
    have h6 : 6 ≤ K'.index := by
      by_contra hlt
      push Not at hlt
      have hf : Nat.factorial K'.index ≤ Nat.factorial 5 := Nat.factorial_le (by omega)
      have := Nat.le_of_dvd (Nat.factorial_pos _) hidx
      have h5 : Nat.factorial 5 = 120 := by decide
      omega
    have h2 := Subgroup.card_mul_index K'
    rw [card_CA0] at h2
    have hle : Nat.card K' ≤ 120 := by nlinarith
    have h5 : 5 ∣ Nat.card K := by
      have := orderOf_dvd_natCard (⟨tG, ht⟩ : K)
      rwa [← Subgroup.orderOf_coe, orderOf_tG] at this
    have hd : Nat.card K ∣ 720 := card_CA0 ▸ Subgroup.card_dvd_of_le hK
    have h45 : 45 ∣ Nat.card K := Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num) h9 h5
    obtain ⟨j, hj⟩ := h45
    rw [hK'c, hj] at hle
    have hj2 : j ≤ 2 := by omega
    have hj0 : j ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hj
      exact absurd hj (Nat.pos_iff_ne_zero.mp Nat.card_pos)
    rcases (show j = 1 ∨ j = 2 by omega) with rfl | rfl
    · exact false_of_card_45_90 ht (Or.inl (by rw [hj]))
    · exact false_of_card_45_90 ht (Or.inr (by rw [hj]))

