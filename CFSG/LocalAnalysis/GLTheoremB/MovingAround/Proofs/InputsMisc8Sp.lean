theorem oRes_normal (Y : Type*) [Group Y] : (oPrimeResidual 3 Y).Normal := by
  refine ⟨fun n hn g => ?_⟩
  have hle : (oPrimeResidual 3 Y).map (MulAut.conj g).toMonoidHom ≤ oPrimeResidual 3 Y := by
    rw [oPrimeResidual, MonoidHom.map_closure]
    apply Subgroup.closure_mono
    rintro _ ⟨x, ⟨k, hk⟩, rfl⟩
    exact ⟨k, by simp [MulAut.conj_apply, conj_pow, hk]⟩
  exact hle ⟨n, hn, rfl⟩

theorem not_three_dvd_index_oRes (Y : Type*) [Group Y] [Finite Y] :
    ¬ 3 ∣ (oPrimeResidual 3 Y).index := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨P⟩ : Nonempty (Sylow 3 Y) := inferInstance
  have hP : (P : Subgroup Y) ≤ oPrimeResidual 3 Y := by
    intro x hx
    obtain ⟨k, hk⟩ := P.isPGroup' ⟨x, hx⟩
    refine Subgroup.subset_closure ⟨k, ?_⟩
    have := congrArg Subtype.val hk
    simpa using this
  exact fun h3 => P.not_dvd_index (h3.trans (Subgroup.index_dvd_of_le hP))

theorem map_oRes_eq {H : Subgroup (GL V₄ (ZMod 3))} :
    (oPrimeResidual 3 ↥H).map H.subtype =
      Subgroup.closure {x | x ∈ H ∧ ∃ k : ℕ, x ^ (3 ^ k) = 1} := by
  rw [oPrimeResidual, MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨y, ⟨k, hk⟩, rfl⟩
    exact ⟨y.2, k, by simpa using congrArg Subtype.val hk⟩
  · rintro ⟨hx, k, hk⟩
    exact ⟨⟨x, hx⟩, ⟨k, Subtype.ext (by simpa using hk)⟩, rfl⟩

