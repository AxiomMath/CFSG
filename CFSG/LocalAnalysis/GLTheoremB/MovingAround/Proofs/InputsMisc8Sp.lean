  have := congrArg Subtype.val (hE.1.is_comm.comm (⟨x, hFE x.2⟩ : E) ⟨y, hFE y.2⟩)
  simpa using this

theorem factorization_51840_five : (51840 : ℕ).factorization 5 = 1 := by
  rw [show (51840 : ℕ) = 5 ^ 1 * 10368 by norm_num, Nat.factorization_mul (by norm_num) (by norm_num),
    Finsupp.add_apply, Nat.Prime.factorization_pow (by norm_num), Finsupp.single_eq_same,
    Nat.factorization_eq_zero_of_not_dvd (by norm_num)]

theorem exists_conj_eq_tG {s : GL V₄ (ZMod 3)} (hsS : s ∈ StatedSp 2 (ZMod 3))
    (hs : orderOf s = 5) : ∃ g ∈ StatedSp 2 (ZMod 3), ∃ z : ℤ, g * s ^ z * g⁻¹ = tG := by
  haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  set s' : StatedSp 2 (ZMod 3) := ⟨s, hsS⟩
  set t' : StatedSp 2 (ZMod 3) := ⟨tG, tG_mem⟩
  have hc : ∀ x : StatedSp 2 (ZMod 3), orderOf x = 5 →
      Nat.card (Subgroup.zpowers x) = 5 ^ (Nat.card (StatedSp 2 (ZMod 3))).factorization 5 := by
    intro x hx
    rw [Nat.card_zpowers, hx, card_Sp43, factorization_51840_five, pow_one]
  have hs' : orderOf s' = 5 := by rw [← Subgroup.orderOf_coe]; exact hs
  have ht' : orderOf t' = 5 := by rw [← Subgroup.orderOf_coe]; exact orderOf_tG
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (StatedSp 2 (ZMod 3))
    (Sylow.ofCard (Subgroup.zpowers s') (hc s' hs')) (Sylow.ofCard (Subgroup.zpowers t') (hc t' ht'))
  have hmem : t' ∈ ((g • Sylow.ofCard (Subgroup.zpowers s') (hc s' hs') : Sylow 5 _) :
      Subgroup (StatedSp 2 (ZMod 3))) := by
    rw [hg, Sylow.coe_ofCard]
    exact Subgroup.mem_zpowers t'
  rw [Sylow.coe_subgroup_smul, Subgroup.mem_smul_pointwise_iff_exists, Sylow.coe_ofCard] at hmem
  obtain ⟨y, hy, hyt⟩ := hmem
  obtain ⟨z, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
  refine ⟨g, g.2, z, ?_⟩
  have := congrArg Subtype.val hyt
  simpa [MulAut.smul_def, MulAut.conj_apply, s', t'] using this

theorem sp_le_or_equiv_CA0 {H : Subgroup (GL V₄ (ZMod 3))} (hHg : H ≤ gsp 2 (ZMod 3))
    (hns : ¬ Group.IsSolvable H) {E : Subgroup (GL V₄ (ZMod 3))} (hEH : E ≤ H)
    (hE : CFSG.Open.IsElemAbelian 3 E) (hE9 : Nat.card E = 9) :
    StatedSp 2 (ZMod 3) ≤ H ∨ Nonempty (↥(oPrimeResidual 3 ↥H) ≃* CA0) := by
  classical
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  set S3 : Set (GL V₄ (ZMod 3)) := {x | x ∈ H ∧ ∃ k : ℕ, x ^ (3 ^ k) = 1} with hS3
  set K := (oPrimeResidual 3 ↥H).map H.subtype with hK
  have hKc : K = Subgroup.closure S3 := map_oRes_eq
  have hKH : K ≤ H := Subgroup.map_subtype_le _
  have hKS : K ≤ StatedSp 2 (ZMod 3) := by
    rw [hKc]
    exact (Subgroup.closure_le _).mpr fun x ⟨hx, k, hk⟩ => mem_statedSp_of_pow (hHg hx) hk
  have hEK : E ≤ K := by
    intro e he
    rw [hKc]
    exact Subgroup.subset_closure ⟨hEH he, 1, by rw [pow_one]; exact hE.2 e he⟩
  set eK : ↥(oPrimeResidual 3 ↥H) ≃* K :=
    (oPrimeResidual 3 ↥H).equivMapOfInjective H.subtype H.subtype_injective with heK
  have hKns : ¬ Group.IsSolvable K := fun h => not_isSolvable_oRes hHg hns
    (solvable_of_solvable_injective (f := eK.toMonoidHom) eK.injective)
  have hK5 : 5 ∣ Nat.card K := by
    by_contra h5
    apply hKns
    have hd : Nat.card K ∣ 51840 := card_Sp43 ▸ Subgroup.card_dvd_of_le hKS
    refine isSolvable_of_card_dvd (a := 7) (b := 4) Nat.prime_two Nat.prime_three ?_
    have hcop : Nat.Coprime (Nat.card K) 5 :=
      Nat.coprime_comm.mp ((Nat.Prime.coprime_iff_not_dvd (by norm_num)).mpr h5)
    have : Nat.card K ∣ (2 ^ 7 * 3 ^ 4) * 5 := by
      rw [show (2 : ℕ) ^ 7 * 3 ^ 4 * 5 = 51840 by norm_num]
      exact hd
    exact hcop.dvd_of_dvd_mul_right this
  obtain ⟨s, hs⟩ := exists_prime_orderOf_dvd_card' 5 hK5
  obtain ⟨g, hg, z, hgz⟩ := exists_conj_eq_tG (hKS s.2) (by rw [← hs, Subgroup.orderOf_coe])
  set K₂ := K.map (MulAut.conj g).toMonoidHom with hK₂
  have hK₂S : K₂ ≤ StatedSp 2 (ZMod 3) := by
    rintro _ ⟨x, hx, rfl⟩
    exact mul_mem (mul_mem hg (hKS hx)) (inv_mem hg)
  have ht : tG ∈ K₂ := ⟨(s : GL V₄ (ZMod 3)) ^ z, K.zpow_mem s.2 z, by
    simpa [MulAut.conj_apply] using hgz⟩
  by_cases htv : ∃ (a : V₄ → ZMod 3) (c : ZMod 3), a ≠ 0 ∧ c ≠ 0 ∧ spTrans a c ∈ K₂
  ·
    left
    obtain ⟨a, c, ha, hc, hT⟩ := htv
    have hK₂eq : K₂ = StatedSp 2 (ZMod 3) := eq_statedSp_of_tG_mem hK₂S ht ha hc hT
    intro x hx
    have hx' : g * x * g⁻¹ ∈ K₂ := hK₂eq ▸ mul_mem (mul_mem hg hx) (inv_mem hg)
    obtain ⟨y, hy, hyx⟩ := hx'
    have hyx' : y = x := by
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at hyx
      simpa using hyx
    exact hKH (hyx' ▸ hy)
  ·
    right
    push Not at htv
    set E₂ := E.map (MulAut.conj g).toMonoidHom with hE₂
    have hE₂K : E₂ ≤ K₂ := Subgroup.map_mono hEK
    have hE₂a : CFSG.Open.IsElemAbelian 3 E₂ := isElemAbelian_map hE _
    have hE₂c : Nat.card E₂ = 9 := by
      rw [hE₂, Subgroup.card_map_of_injective (MulAut.conj g).injective, hE9]
    have hsmall : ∀ P : Subgroup (GL V₄ (ZMod 3)), P ≤ K₂ → IsPGroup 3 P → Nat.card P ≤ 9 := by
      intro P hP hp
      by_contra h
      push Not at h
      obtain ⟨k, hk⟩ := hp.exists_card_eq
      have hk3 : 3 ≤ k := by
        by_contra hk3
        push Not at hk3
        have : 3 ^ k ≤ 3 ^ 2 := Nat.pow_le_pow_right (by norm_num) (by omega)
        omega
      have h27 : 27 ≤ Nat.card P := by
        rw [hk]
        calc 27 = 3 ^ 3 := by norm_num
          _ ≤ 3 ^ k := Nat.pow_le_pow_right (by norm_num) hk3
      obtain ⟨a, c, ha, hc, hT⟩ := exists_spTrans_mem_of_card (hP.trans hK₂S) hp h27
      exact htv a c ha hc (hP hT)
    have h3el : ∀ x ∈ K₂, (∃ k : ℕ, x ^ (3 ^ k) = 1) → x * A0G = A0G * x := by
      intro x hx ⟨k, hk⟩
      set x' : K₂ := ⟨x, hx⟩
      have hx'p : IsPGroup 3 (Subgroup.zpowers x') := by
        have hdvd : orderOf x' ∣ 3 ^ k := orderOf_dvd_of_pow_eq_one (Subtype.ext (by simpa using hk))
        obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Nat.prime_three).1 hdvd
        exact IsPGroup.of_card (n := j) (by rw [Nat.card_zpowers, hj])
      obtain ⟨S, hS⟩ := hx'p.exists_le_sylow
      have hE₂'p : IsPGroup 3 (E₂.subgroupOf K₂) := by
        intro y
        refine ⟨1, Subtype.ext (Subtype.ext ?_)⟩
        have := hE₂a.2 _ (Subgroup.mem_subgroupOf.mp y.2)
        simpa using this
      obtain ⟨S₀, hS₀⟩ := hE₂'p.exists_le_sylow
      have hS₀c : Nat.card S₀ = 9 := by
        apply le_antisymm
        · have h1 := hsmall ((S₀ : Subgroup K₂).map K₂.subtype) (Subgroup.map_subtype_le _)
            ((S₀.isPGroup').map _)
          rwa [Subgroup.card_map_of_injective K₂.subtype_injective] at h1
        · have h1 := Subgroup.card_le_of_le hS₀
          rwa [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hE₂K).toEquiv, hE₂c] at h1
      have hSc : Nat.card S = 9 := by
        rw [Sylow.card_eq_multiplicity, ← Sylow.card_eq_multiplicity S₀, hS₀c]
      obtain ⟨h, rfl⟩ := MulAction.exists_smul_eq K₂ S₀ S
      have hS₀E : (S₀ : Subgroup K₂) = E₂.subgroupOf K₂ :=
        (Subgroup.eq_of_le_of_card_ge hS₀ (by
          rw [hS₀c, Nat.card_congr (Subgroup.subgroupOfEquivOfLe hE₂K).toEquiv, hE₂c])).symm
      set P := ((h • S₀ : Sylow 3 K₂) : Subgroup K₂).map K₂.subtype with hPdef
      have hPle : P ≤ E₂.map (MulAut.conj (h : GL V₄ (ZMod 3))).toMonoidHom := by
        rintro _ ⟨y, hy, rfl⟩
        have hy' : y ∈ ((h • S₀ : Sylow 3 K₂) : Subgroup K₂) := hy
        rw [Sylow.coe_subgroup_smul, Subgroup.mem_smul_pointwise_iff_exists] at hy'
        obtain ⟨y₀, hy₀, rfl⟩ := hy'
        rw [hS₀E, Subgroup.mem_subgroupOf] at hy₀
        exact ⟨y₀, hy₀, by simp [MulAut.smul_def, MulAut.conj_apply]⟩
      have hPa : CFSG.Open.IsElemAbelian 3 P := isElemAbelian_mono (isElemAbelian_map hE₂a _) hPle
      have hPc : Nat.card P = 9 := by
        rw [hPdef, Subgroup.card_map_of_injective K₂.subtype_injective]
        exact hSc
      have hxP : x ∈ P := ⟨x', hS (Subgroup.mem_zpowers x'), rfl⟩
      exact commute_A0_of_tf hK₂S ht htv (Subgroup.map_subtype_le _) hPa hPc x hxP
    have hK₂CA0 : K₂ ≤ CA0 := by
      rw [hK₂, hKc, MonoidHom.map_closure, Subgroup.closure_le]
      rintro _ ⟨x, ⟨hxH, k, hk⟩, rfl⟩
      have hxK : x ∈ K := by
        rw [hKc]
        exact Subgroup.subset_closure ⟨hxH, k, hk⟩
      rw [SetLike.mem_coe, mem_CA0]
      refine ⟨mul_mem (mul_mem hg (hKS hxK)) (inv_mem hg), h3el _ ⟨x, hxK, rfl⟩ ⟨k, ?_⟩⟩
      simp [MulAut.conj_apply, conj_pow, hk]
    have h9 : 9 ∣ Nat.card K₂ := hE₂c ▸ Subgroup.card_dvd_of_le hE₂K
    have hK₂eq : K₂ = CA0 := eq_CA0_of_le hK₂CA0 ht h9
    exact ⟨eK.trans ((K.equivMapOfInjective (MulAut.conj g).toMonoidHom
      (MulAut.conj g).injective).trans (MulEquiv.subgroupCongr hK₂eq))⟩

theorem sp_le_or_isSL2Nine {H : Subgroup (GL V₄ (ZMod 3))} (hHg : H ≤ gsp 2 (ZMod 3))
    (hns : ¬ Group.IsSolvable H) {E : Subgroup (GL V₄ (ZMod 3))} (hEH : E ≤ H)
    (hE : CFSG.Open.IsElemAbelian 3 E) (hE9 : Nat.card E = 9) :
    StatedSp 2 (ZMod 3) ≤ H ∨ Lemma1211.IsSL2Nine ↥(oPrimeResidual 3 ↥H) := by
  rcases sp_le_or_equiv_CA0 hHg hns hEH hE hE9 with h | he
  · exact Or.inl h
  · obtain ⟨e⟩ := he
    obtain ⟨F, hF, hFin, hF9, ⟨e'⟩⟩ := isSL2Nine_CA0
    exact Or.inr ⟨F, hF, hFin, hF9, ⟨e.trans e'⟩⟩

