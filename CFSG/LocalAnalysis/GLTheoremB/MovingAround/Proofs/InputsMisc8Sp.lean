theorem units_zmod_three' : ∀ u : (ZMod 3)ˣ, u = 1 ∨ u = -1 := by decide

theorem mem_statedSp_of_pow {x : GL V₄ (ZMod 3)} (hx : x ∈ gsp 2 (ZMod 3)) {k : ℕ}
    (hk : x ^ (3 ^ k) = 1) : x ∈ StatedSp 2 (ZMod 3) := by
  set μ := multiplier 2 (ZMod 3) ⟨x, hx⟩ with hμ
  have hμk : μ ^ (3 ^ k) = 1 := by
    rw [hμ, ← map_pow]
    have : (⟨x, hx⟩ : gsp 2 (ZMod 3)) ^ (3 ^ k) = 1 := Subtype.ext (by simpa using hk)
    rw [this, map_one]
  have hμ1 : μ = 1 := by
    rcases units_zmod_three' μ with h | h
    · exact h
    · rw [h, Odd.neg_one_pow (Odd.pow (by decide))] at hμk
      exact absurd hμk (by decide)
  have hmem : (⟨x, hx⟩ : gsp 2 (ZMod 3)) ∈ (multiplier 2 (ZMod 3)).ker := hμ1
  rw [ker_multiplier, Subgroup.mem_subgroupOf] at hmem
  exact hmem

theorem card_gsp_dvd : Nat.card (gsp 2 (ZMod 3)) ∣ 103680 := by
  have h := Subgroup.card_ker_mul_card_range (multiplier 2 (ZMod 3))
  rw [ker_multiplier,
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe
      (CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher.statedSp_le_gsp (r := 2)
        (K := ZMod 3))).toEquiv, card_Sp43] at h
  have hr : Nat.card (multiplier 2 (ZMod 3)).range ∣ 2 := by
    have := Subgroup.card_subgroup_dvd_card (multiplier 2 (ZMod 3)).range
    rwa [Nat.card_units, Nat.card_zmod] at this
  rw [← h]
  exact Nat.mul_dvd_mul_left _ hr

theorem prime_dvd_of_dvd_pow_mul_pow {d p q a b : ℕ} (hd : d.Prime) (hp : p.Prime) (hq : q.Prime)
    (h : d ∣ p ^ a * q ^ b) : d = p ∨ d = q := by
  rcases (Nat.Prime.dvd_mul hd).mp h with h1 | h1
  · exact Or.inl ((Nat.prime_dvd_prime_iff_eq hd hp).mp (hd.dvd_of_dvd_pow h1))
  · exact Or.inr ((Nat.prime_dvd_prime_iff_eq hd hq).mp (hd.dvd_of_dvd_pow h1))

theorem isSolvable_of_card_dvd {G : Type*} [Group G] [Finite G] {p q a b : ℕ} (hp : p.Prime)
    (hq : q.Prime) (h : Nat.card G ∣ p ^ a * q ^ b) : Group.IsSolvable G :=
  CFSG.SignalizerFunctor.Helpers.two_prime_order_solvable G p q hp hq fun d hd hdG =>
    prime_dvd_of_dvd_pow_mul_pow hd hp hq (hdG.trans h)

theorem not_isSolvable_oRes {H : Subgroup (GL V₄ (ZMod 3))} (hHg : H ≤ gsp 2 (ZMod 3))
    (hns : ¬ Group.IsSolvable H) : ¬ Group.IsSolvable (oPrimeResidual 3 ↥H) := by
  intro hs
  apply hns
  haveI := oRes_normal ↥H
  have hHd : Nat.card H ∣ 103680 :=
    (Subgroup.card_dvd_of_le hHg).trans card_gsp_dvd
  have hQ : Nat.card (↥H ⧸ oPrimeResidual 3 ↥H) ∣ 2 ^ 8 * 5 ^ 1 := by
    have hidx := not_three_dvd_index_oRes ↥H
    rw [← Subgroup.index_eq_card] at *
    have h1 : (oPrimeResidual 3 ↥H).index ∣ 103680 :=
      (Subgroup.index_dvd_card _).trans hHd
    have hcop : Nat.Coprime (oPrimeResidual 3 ↥H).index (3 ^ 4) :=
      Nat.Coprime.pow_right _ ((Nat.coprime_comm.mp ((Nat.Prime.coprime_iff_not_dvd
        Nat.prime_three).mpr hidx)))
    have h2 : (oPrimeResidual 3 ↥H).index ∣ 3 ^ 4 * (2 ^ 8 * 5 ^ 1) := by
      rw [show (3 : ℕ) ^ 4 * (2 ^ 8 * 5 ^ 1) = 103680 by norm_num]
      exact h1
    exact hcop.dvd_of_dvd_mul_left h2
  haveI : Group.IsSolvable (↥H ⧸ oPrimeResidual 3 ↥H) :=
    isSolvable_of_card_dvd Nat.prime_two (by norm_num) hQ
  exact Group.isSolvable_of_subgroup_quotient (oPrimeResidual 3 ↥H)

theorem isElemAbelian_mono {E F : Subgroup (GL V₄ (ZMod 3))} (hE : CFSG.Open.IsElemAbelian 3 E)
    (hFE : F ≤ E) : CFSG.Open.IsElemAbelian 3 F := by
