theorem noA5On_orthogonal_two : Inputs256d.NoA5On fun d =>
    ((∃ r q, d.1 = TauCeti.LieTypeIndex.D r q) ∨ ∃ r q, d.1 = TauCeti.LieTypeIndex.twistedD r q) ∧
      Inputs256c.defField d.1 = 2 := by
  intro S _ _ hs hnc hPi d hd2 hP he β hβ J hJ hJ5
  haveI := hs
  have hl : PerfectInLayer β := by
    by_cases hβ1 : β = 1
    · subst hβ1
      exact CFSG.HardMathSupport.Solomon.Coordinator.perfectInLayer_one hnc
    · exact CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.lieSemisimpleCentSymplecticOrthogonal
        S hs hnc d (by obtain ⟨⟨r, q, h⟩ | ⟨r, q, h⟩, -⟩ := hP <;> rw [h] <;> rfl) he 3
        Nat.prime_three (by norm_num) (by rw [hd2]; norm_num) β hβ hβ1
  obtain ⟨hJc, hA⟩ := isComponentOf_and_a5 hl hJ hJ5
  obtain ⟨hDD, hf2⟩ := hP
  obtain ⟨⟨d, hv⟩, rfl⟩ : ∃ d' : TauCeti.ValidLieTypeIndex, d' = d := ⟨d, rfl⟩
  obtain ⟨e⟩ := he
  have hq : ∀ q : TauCeti.PrimePower, q.card = 2 →
      q = CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.Omega2401.twoPP := fun q hq => by
    have h := eq_two_and_eq_one_of_pow_eq_two q.prime_p q.exponent_pos
      (by rw [← TauCeti.PrimePower.card_def]; exact hq)
    exact TauCeti.PrimePower.ext h.1 h.2
  obtain ⟨ε, N, t, hN, hOm, hm, ht⟩ : ∃ (ε : Bool) (N : ℕ) (t : StatedLieTag), 4 ≤ N ∧
      IsOmegaTwo ε N S ∧ StatedClassicalModel S t N 2 1 ∧
      ((t = .POmegaPlus ∧ ε = true) ∨ (t = .POmegaMinus ∧ ε = false)) := by
    rcases hDD with ⟨r, q, hdq⟩ | ⟨r, q, hdq⟩
    · dsimp only at hdq
      subst hdq
      have hq2 := hq q hf2
      subst hq2
      have hr : 4 ≤ r := (TauCeti.LieTypeIndex.inStandardRange_iff _).mp
        ((TauCeti.LieTypeIndex.valid_iff _).mp hv).1
      obtain ⟨eD⟩ := CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.Omega2401.nonempty_D_of_isOmegaTwo_true
        hr (L := ↥(StatedOmega (StatedQuadPlus r (ZMod 2)))) ⟨MulEquiv.refl _⟩
      exact ⟨true, r, .POmegaPlus, hr, ⟨e.trans eD.symm⟩,
        CFSG.RankThree.PartTwo.Census.statedClassicalModel_typeD r _ hv e, Or.inl ⟨rfl, rfl⟩⟩
    · dsimp only at hdq
      subst hdq
      have hq2 := hq q hf2
      subst hq2
      have hr : 4 ≤ r := (TauCeti.LieTypeIndex.inStandardRange_iff _).mp
        ((TauCeti.LieTypeIndex.valid_iff _).mp hv).1
      obtain ⟨eD⟩ :=
        CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.Omega2401.nonempty_twistedD_of_isOmegaTwo_false
          hr (L := ↥(StatedOmega (StatedQuadMinus r (ZMod 2) 1 1))) ⟨MulEquiv.refl _⟩
      exact ⟨false, r, .POmegaMinus, hr, ⟨e.trans eD.symm⟩,
        CFSG.RankThree.PartTwo.Census.statedClassicalModel_typeTwistedD r _ hv e,
        Or.inr ⟨rfl, rfl⟩⟩
  have hPi' : ¬ HasFixedPointFreeOrder ε (N - 1) 3 := fun hf =>
    hPi ⟨N - 1, ε, by omega, by rwa [show N - 1 + 1 = N by omega], hf⟩
  by_cases hin : ∃ a : S, MulAut.conj a = β
  · obtain ⟨a, rfl⟩ := hin
    exact noA5_conj_omegaTwo hN hOm hPi' a
      (InputsL33c.pow_eq_one_of_conj_pow (InputsL33c.center_eq_bot_of_simple hnc) hβ) J hJc hA
  · have hout : ∀ a : S, MulAut.conj a ≠ β := fun a h => hin ⟨a, h⟩
    by_cases hd4 : t = .POmegaPlus ∧ N = 4
    · obtain ⟨rfl, rfl⟩ := hd4
      exact noA5_of_noA5Comps (noA5Comps_d4_outer hm β hβ hout) hJc hA
    · exact noA5_omega_outer Nat.prime_three (by norm_num)
        (by rcases ht with ⟨h, -⟩ | ⟨h, -⟩ <;> simp [h]) hm (fun h1 h2 => absurd ⟨h1, h2⟩ hd4) β hβ
        hout
        J hJc hA

theorem chev2GF2Rest_of_open (h : Inputs256d.NoA5On fun d => Inputs256c.defField d.1 = 2 ∧
      ∃ q, d.1 = TauCeti.LieTypeIndex.F4 q ∨ d.1 = TauCeti.LieTypeIndex.E6 q ∨
        d.1 = TauCeti.LieTypeIndex.twistedE6 q ∨ d.1 = TauCeti.LieTypeIndex.E7 q ∨
        d.1 = TauCeti.LieTypeIndex.E8 q) :
    Inputs256d.Chev2GF2Rest := by
  refine ((((noA5On_unitary_two.or noA5On_symplectic_two).or noA5On_triD4_two).or
    noA5On_orthogonal_two).or h).mono ?_
  rintro ⟨d, hv⟩ ⟨h2, hlin, htits⟩
  have hs := (TauCeti.LieTypeIndex.inStandardRange_iff _).mp
    ((TauCeti.LieTypeIndex.valid_iff _).mp hv).1
  cases d with
  | A r q => exact absurd ⟨r, q, rfl⟩ hlin
  | twistedA r q => exact Or.inl (Or.inl (Or.inl (Or.inl ⟨⟨r, q, rfl⟩, h2⟩)))
  | B r q => exact Or.inl (Or.inl (Or.inl (Or.inr ⟨⟨r, q, rfl⟩, h2⟩)))
  | C r q =>
    exfalso
    have hq : q.p ^ q.exponent = 2 := by rw [← TauCeti.PrimePower.card_def]; exact h2
    exact hs.2 (eq_two_and_eq_one_of_pow_eq_two q.prime_p q.exponent_pos hq).1
  | D r q => exact Or.inl (Or.inr ⟨Or.inl ⟨r, q, rfl⟩, h2⟩)
  | twistedD r q => exact Or.inl (Or.inr ⟨Or.inr ⟨r, q, rfl⟩, h2⟩)
  | E6 q => exact Or.inr ⟨h2, q, Or.inr (Or.inl rfl)⟩
  | E7 q => exact Or.inr ⟨h2, q, Or.inr (Or.inr (Or.inr (Or.inl rfl)))⟩
  | E8 q => exact Or.inr ⟨h2, q, Or.inr (Or.inr (Or.inr (Or.inr rfl)))⟩
  | F4 q => exact Or.inr ⟨h2, q, Or.inl rfl⟩
  | G2 q =>
    exfalso
    have h' : q.card = 2 := h2
    omega
  | twistedE6 q => exact Or.inr ⟨h2, q, Or.inr (Or.inr (Or.inl rfl))⟩
  | trialityD4 q => exact Or.inl (Or.inl (Or.inr ⟨q, rfl, h2⟩))
  | suzuki m =>
    exfalso
    have h' : 2 ^ (2 * m + 1) = 2 := h2
    have : 2 ^ 3 ≤ 2 ^ (2 * m + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  | reeG2 m =>
    exfalso
    have h' : 3 ^ (2 * m + 1) = 2 := h2
    have : 3 ≤ 3 ^ (2 * m + 1) := Nat.le_self_pow (by omega) 3
    omega
  | reeF4 m =>
    exfalso
    have h' : 2 ^ (2 * m + 1) = 2 := h2
    have : 2 ^ 3 ≤ 2 ^ (2 * m + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  | tits => exact absurd rfl htits

