  | twistedE6 q => exact hE S hs hnc hPi _ hd2 ⟨rfl, hd2, hf2, hf4⟩ he β hβ J hJ hJ5
  | trialityD4 q => exact hE S hs hnc hPi _ hd2 ⟨rfl, hd2, hf2, hf4⟩ he β hβ J hJ hJ5
