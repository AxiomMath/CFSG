theorem noA5_comp_one {S : Type} [Group S] [Finite S] [IsSimpleGroup S]
    (hna : ∃ a b : S, a * b ≠ b * a) (h60 : Nat.card S ≠ 60) {K : Subgroup S}
    (hK : IsComponentOf K (fixSubgroup (1 : MulAut S))) :
    ¬ Nonempty ((↥K ⧸ Subgroup.center ↥K) ≃* alternatingGroup (Fin 5)) := by
  have hfix : fixSubgroup (1 : MulAut S) = ⊤ := eq_top_iff.2 fun x _ => rfl
  rw [hfix] at hK
  rcases CFSG.Open.IsSubnormal.eq_bot_or_top hK.2.1 with h | h
  · exfalso
    subst h
    have := hK.2.2.2.toNontrivial
    obtain ⟨a, b, hab⟩ := exists_pair_ne (↥(⊥ : Subgroup S) ⧸ Subgroup.center ↥(⊥ : Subgroup S))
    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective a
    obtain ⟨b, rfl⟩ := QuotientGroup.mk_surjective b
    exact hab (congrArg _ (Subsingleton.elim a b))
  · exact not_a5_top h (not_a5_of_center_eq_bot
      (CFSG.HardMathSupport.Solomon.Coordinator.b3Lie_center_eq_bot hna) h60)

theorem eight_le_of_ne_two_four (q : TauCeti.PrimePower) (hq2 : q.p = 2) (h2 : q.card ≠ 2)
    (h4 : q.card ≠ 4) : 8 ≤ q.card := by
  have he1 := q.exponent_pos
  rw [TauCeti.PrimePower.card_def, hq2] at h2 h4 ⊢
  have h3 : 3 ≤ q.exponent := by
    by_contra h
    have : q.exponent = 1 ∨ q.exponent = 2 := by omega
    rcases this with h' | h' <;> rw [h'] at h2 h4 <;> revert h2 h4 <;> norm_num
  calc 8 = 2 ^ 3 := by norm_num
    _ ≤ 2 ^ q.exponent := Nat.pow_le_pow_right (by norm_num) h3

theorem noA5Comp_exceptional_big (hout : NoA5TriD4Outer) :
    NoA5CompOn fun d => CFSG.Yardstones.Md42047359a2a.lieFamily d.1 = .exceptional ∧
      d.1.characteristic = 2 ∧ Inputs256c.defField d.1 ≠ 2 ∧ Inputs256c.defField d.1 ≠ 4 := by
  intro S _ _ hs hna d hP he β hβ K hK
  haveI := hs
  obtain ⟨hF, hd2, hf2, hf4⟩ := hP
  by_cases hβ1 : β = 1
  · subst hβ1
    obtain ⟨e⟩ := he
    have hcard : Nat.card S = lieOrderFormula d.1 :=
      CFSG.HardMathSupport.Solomon.Coordinator.lieOrderBridge_holds d S ⟨e⟩
    exact noA5_comp_one hna (by rw [hcard]; exact lieOrderFormula_exc_ne_sixty hF hd2) hK
  obtain ⟨⟨d, hv⟩, rfl⟩ : ∃ d' : TauCeti.ValidLieTypeIndex, d' = d := ⟨d, rfl⟩
  obtain ⟨e⟩ := he
