  | E6 q => exact hE S hs hnc hPi _ hd2 ⟨rfl, hd2, hf2, hf4⟩ he β hβ J hJ hJ5
  | E7 q => exact hE S hs hnc hPi _ hd2 ⟨rfl, hd2, hf2, hf4⟩ he β hβ J hJ hJ5
  | E8 q => exact hE S hs hnc hPi _ hd2 ⟨rfl, hd2, hf2, hf4⟩ he β hβ J hJ hJ5
  | F4 q => exact hE S hs hnc hPi _ hd2 ⟨rfl, hd2, hf2, hf4⟩ he β hβ J hJ hJ5
