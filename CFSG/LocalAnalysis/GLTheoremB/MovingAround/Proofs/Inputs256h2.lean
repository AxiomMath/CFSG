theorem two_pow_three_dvd_div {M g : ℕ} (hM : 2 ^ 3 ∣ M) (hg : g ∣ M) (hcop : Nat.Coprime 2 g) :
    2 ^ 3 ∣ M / g := by
  rw [← Nat.mul_div_cancel' hg] at hM
  exact (Nat.Coprime.pow_left 3 hcop).dvd_of_dvd_mul_left hM

theorem two_pow_three_dvd_pow {q N : ℕ} (hq : 2 ∣ q) (hN : 3 ≤ N) : 2 ^ 3 ∣ q ^ N :=
  (pow_dvd_pow 2 hN).trans (pow_dvd_pow_of_dvd hq N)

