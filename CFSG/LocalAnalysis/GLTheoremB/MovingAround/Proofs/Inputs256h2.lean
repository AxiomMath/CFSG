      rw [← MonoidHom.mem_ker, hΘker, ← ha, InputsL33c.congr_conj_apply]
      exact ⟨e' a, rfl⟩
    haveI : Finite S := Finite.of_equiv _ e'.symm.toEquiv
    exact hout q hv hq2 hq8 S ⟨e⟩ α hα hout' J hJ hL

end TriD4

section NoA5Comps

open CFSG.HardMathSupport.Solomon.Coordinator (fixSubgroup mem_fixSubgroup)

@[expose] def NoA5Comps (H : Type) [Group H] : Prop :=
  ∀ K : Subgroup H, IsComponentOf K ⊤ →
    ¬ Nonempty ((↥K ⧸ Subgroup.center ↥K) ≃* alternatingGroup (Fin 5))

theorem NoA5Comps.of_mulEquiv {G H : Type} [Group G] [Group H] (e : G ≃* H) (h : NoA5Comps H) :
    NoA5Comps G := by
  intro K hK hA
  have hK' := CFSG.SignalizerFunctorTheorem.TransportA.isComponentOf_map e hK
  rw [Subgroup.map_top_of_surjective _ e.surjective] at hK'
  exact h _ hK' (Claims1110h.a5Center_map e hA)

theorem noA5_of_noA5Comps {S : Type} [Group S] {C K : Subgroup S} (h : NoA5Comps ↥C)
    (hK : IsComponentOf K C) :
    ¬ Nonempty ((↥K ⧸ Subgroup.center ↥K) ≃* alternatingGroup (Fin 5)) := by
  rintro ⟨eA⟩
  have hKC := hK.1
  let eK : ↥(K.subgroupOf C) ≃* ↥K := Subgroup.subgroupOfEquivOfLe hKC
  refine h (K.subgroupOf C) ⟨le_top, ?_, ?_⟩ ⟨(InputsL33.centerQuotCongr eK).trans eA⟩
  · have := hK.2.1.comap C.subtype
    rwa [show C.comap C.subtype = ⊤ from Subgroup.subgroupOf_self C] at this
  · exact CFSG.SignalizerFunctorTheorem.TransportA.isQuasisimple_of_mulEquiv eK.symm hK.2.2

theorem NoA5Comps.of_conj_eq {S : Type} [Group S] {α δ ψ : MulAut S} (h : ψ * α * ψ⁻¹ = δ)
    (hδ : NoA5Comps ↥(fixSubgroup δ)) : NoA5Comps ↥(fixSubgroup α) := by
  have hc : MulAut.congr ψ α = δ := by
    rw [← h]
    exact MulEquiv.ext fun _ => rfl
  rw [← hc, Inputs141c.fixSubgroup_congr] at hδ
  exact hδ.of_mulEquiv ((fixSubgroup α).equivMapOfInjective ψ.toMonoidHom ψ.injective)

theorem NoA5Comps.of_inv {S : Type} [Group S] {β : MulAut S} (h : NoA5Comps ↥(fixSubgroup β)) :
    NoA5Comps ↥(fixSubgroup β⁻¹) := by
  rw [CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.fixSubgroup_inv_eq]
  exact h

theorem noA5Comps_of_normal {H : Type} [Group H] [Finite H] (M : Subgroup H) [hMn : M.Normal]
    (hMq : CFSG.IsQuasisimple ↥M) (hsol : Group.IsSolvable (H ⧸ M))
    (hno : ¬ Nonempty ((↥M ⧸ Subgroup.center ↥M) ≃* alternatingGroup (Fin 5))) :
    NoA5Comps H := by
  intro K hK hA
  have hMn' : (M.subgroupOf ⊤).Normal := by
    rw [Subgroup.normal_subgroupOf_iff le_top]
    intro h k hh _
    exact hMn.conj_mem h hh k
  have hMc : IsComponentOf M ⊤ :=
    ⟨le_top, CFSG.Open.IsSubnormal.step le_top hMn' (CFSG.Open.IsSubnormal.refl _),
      open_isQuasisimple hMq⟩
  have hKM : K = M :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieComp.eq_of_isComponentOf_of_perfect_le hMc
      (fun P _ hP => by
        haveI := hsol
        have hP0 : ⁅P.map (QuotientGroup.mk' M), P.map (QuotientGroup.mk' M)⁆ =
            P.map (QuotientGroup.mk' M) := by rw [← Subgroup.map_commutator, hP]
        have hbot := Inputs141d.eq_bot_of_perfect_of_isSolvable hP0
        rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at hbot
        exact hbot) hK
  subst hKM
  exact hno hA

theorem noA5Comps_of_simple {H : Type} [Group H] [Finite H] [IsSimpleGroup H]
    (hnc : ∃ a b : H, a * b ≠ b * a) (h60 : Nat.card H ≠ 60) : NoA5Comps H := by
  intro K hK hA
  rcases CFSG.Open.IsSubnormal.eq_bot_or_top hK.2.1 with h | h
  · subst h
    have := hK.2.2.2.toNontrivial
    obtain ⟨a, b, hab⟩ := exists_pair_ne (↥(⊥ : Subgroup H) ⧸ Subgroup.center ↥(⊥ : Subgroup H))
    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective a
    obtain ⟨b, rfl⟩ := QuotientGroup.mk_surjective b
    exact hab (congrArg _ (Subsingleton.elim a b))
  · exact not_a5_top h (not_a5_of_center_eq_bot
      (CFSG.HardMathSupport.Solomon.Coordinator.b3Lie_center_eq_bot hnc) h60) hA

theorem noA5Comps_of_not_five_dvd {H : Type} [Group H] [Finite H] (h5 : ¬ 5 ∣ Nat.card H) :
    NoA5Comps H := fun K _ hA =>
  h5 ((five_dvd_card_of_a5 hA).trans (Subgroup.card_subgroup_dvd_card K))

theorem noA5Comps_of_isSolvable {H : Type} [Group H] [Group.IsSolvable H] : NoA5Comps H := by
  intro K hK _
  have hP : ⁅K, K⁆ = K := Subgroup.isPerfect_iff.1 ⟨hK.2.2.1⟩
  have hbot := Inputs141d.eq_bot_of_perfect_of_isSolvable hP
  subst hbot
  have := hK.2.2.2.toNontrivial
  obtain ⟨a, b, hab⟩ := exists_pair_ne (↥(⊥ : Subgroup H) ⧸ Subgroup.center ↥(⊥ : Subgroup H))
  obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective a
  obtain ⟨b, rfl⟩ := QuotientGroup.mk_surjective b
  exact hab (congrArg _ (Subsingleton.elim a b))

end NoA5Comps

