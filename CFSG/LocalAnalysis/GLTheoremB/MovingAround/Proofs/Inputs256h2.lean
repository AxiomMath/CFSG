theorem ordG2_ne_sixty {q : ℕ} (hq : 2 ≤ q) : CFSG.Open.ordG2 q ≠ 60 := by
  unfold CFSG.Open.ordG2
  have h6 : 64 ≤ q ^ 6 := by
    calc 64 = 2 ^ 6 := by norm_num
      _ ≤ q ^ 6 := Nat.pow_le_pow_left hq 6
  have h2 : 4 ≤ q ^ 2 := by nlinarith
  have h1 : 1 ≤ (q ^ 6 - 1) * (q ^ 2 - 1) := Nat.one_le_iff_ne_zero.2 (by
    apply Nat.mul_ne_zero <;> omega)
  intro h
  have : q ^ 6 ≤ q ^ 6 * (q ^ 6 - 1) * (q ^ 2 - 1) := by
    rw [mul_assoc]
    exact Nat.le_mul_of_pos_right _ h1
  omega

theorem noA5Comps_adjointGroup_G2 (k : Type) [Field k] [Finite k] (hk : 3 ≤ Nat.card k) :
    NoA5Comps ↥(adjointGroup Tag.G2 k) := by
  have hperf := CFSG.HardMathSupport.Solomon.Coordinator.LieComp.ExcCopy.isPerfect_adjointGroup
    Tag.G2 k (fun _ => hk)
  obtain ⟨hs, hnc⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieComp.ExcCopy.isSimpleGroup_adjointGroup_of_perfect
      Tag.G2 k hperf
  haveI := hs
  haveI : Finite (ModGL Tag.G2 k) := finite_modGL
  refine noA5Comps_of_simple hnc ?_
  rw [CFSG.Timmesfeld.ExceptionalOrders.card_adjointGroup_G2]
  exact ordG2_ne_sixty (by omega)

theorem noA5Comps_fieldActor_two {f : ℕ} (hf : 1 ≤ f) {K : Type} [Field K] [Finite K]
    (σ : K ≃+* K) (hK : Nat.card K = (2 ^ f) ^ 3) (hσ : ∀ c, σ c = c ^ 2 ^ f) :
    NoA5Comps ↥(fixSubgroup (fieldActor (t := TwistTag.D4) σ σ)) := by
  have hK3 : Nat.card K = 2 ^ (3 * f) := by rw [hK, ← pow_mul, mul_comm]
  have : CharP K 2 :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic Nat.prime_two
      (by omega) hK3
  have hK2 : ringChar K = 2 := ringChar.eq K 2
  obtain ⟨e⟩ := CFSG.RankThree.PartTwo.KFacts.nonempty_fixedPoints_fieldActor_mulEquiv_g2 (σ := σ) hK2
  have hfix : fixSubgroup (fieldActor (t := TwistTag.D4) σ σ) =
      (fieldActor (t := TwistTag.D4) σ σ).toMonoidHom.eqLocus (MonoidHom.id _) :=
    Subgroup.ext fun _ => Iff.rfl
  have hk : Nat.card (fixSubfield σ) = 2 ^ f :=
    CFSG.RankThree.PartTwo.KFacts.card_fixSubfield_of_cube hf hK hσ
  have h2 : 2 ≤ 2 ^ f := Nat.le_self_pow (by omega) 2
  by_cases hf1 : f = 1
  ·
    subst hf1
    haveI : Finite (ModGL Tag.G2 (fixSubfield σ)) := finite_modGL
    refine NoA5Comps.of_mulEquiv ((MulEquiv.subgroupCongr hfix).trans e)
      (noA5Comps_of_not_five_dvd ?_)
    rw [CFSG.Timmesfeld.ExceptionalOrders.card_adjointGroup_G2, hk]
    decide
  · have h4 : 4 ≤ 2 ^ f := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) (by omega)
    exact NoA5Comps.of_mulEquiv ((MulEquiv.subgroupCongr hfix).trans e)
      (noA5Comps_adjointGroup_G2 _ (by omega))

theorem noA5Comps_projImage_glPi {π : Bool} {f : ℕ} {F : Type} [Field F]
    (hF : Sec4.PiField π 2 f F) (hq2 : 2 < 2 ^ f) :
    NoA5Comps ↥(projImage (Sec4.glPi π 3 (2 ^ f) F)) := by
  have := hF.finite
  have hπ : π = false → CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData 2 f F := fun h => by
    subst h
    exact hF.unitary
  have hSP : projImage (Sec4.slPi π 3 (2 ^ f) F) ≤ projImage (Sec4.glPi π 3 (2 ^ f) F) :=
    Subgroup.map_mono (CFSG.RankThree.PartTwo.Sec4.slPi_le_glPi hπ)
  have hperfS : Group.IsPerfect (projImage (Sec4.slPi π 3 (2 ^ f) F)) :=
    CFSG.RankThree.PartTwo.Sec13.isPerfect_projImage_slPi hF hq2
  have hs := CFSG.RankThree.PartTwo.Sec8.Item8KFacts2Proof.isSimpleGroup_projImage_slPi hF hq2
  have : Nontrivial (projImage (Sec4.slPi π 3 (2 ^ f) F)) := hs.toNontrivial
  have hq := (CFSG.LocalCores.isQuasisimple_of_isSimpleGroup
    (CFSG.RankThree.PartTwo.Sec8.Item8KFacts2Proof.exists_ne_comm_of_isPerfect hperfS)).1
  have hcomm := CFSG.RankThree.PartTwo.Sec13.commutator_projImage_glPi hF hq2
  have hnoS : ¬ Nonempty ((↥(projImage (Sec4.slPi π 3 (2 ^ f) F)) ⧸
      Subgroup.center ↥(projImage (Sec4.slPi π 3 (2 ^ f) F))) ≃* alternatingGroup (Fin 5)) := by
    have hperf : Group.IsPerfect ↥(Sec4.slPi π 3 (2 ^ f) F) :=
      CFSG.RankThree.PartTwo.Sec13.isPerfect_slPi hF hq2
    refine not_a5_of_surj hperf.commutator_eq_top
      ((Matrix.ProjGenLinGroup.mk).subgroupMap (Sec4.slPi π 3 (2 ^ f) F))
      (MonoidHom.subgroupMap_surjective _ _) (fun x hx => ?_) ?_
    · have h1 : Matrix.ProjGenLinGroup.mk (x : GL (Fin 3) F) = 1 := congrArg Subtype.val hx
      rw [Matrix.ProjGenLinGroup.mk_eq_one] at h1
      rw [Subgroup.mem_center_iff]
      intro y
      exact Subtype.ext (Subgroup.mem_center_iff.1 h1 y)
    · cases π
      · intro hA
        exact Claims1110h.su_a5_false (hπ rfl) (m := 3) le_rfl (MulEquiv.refl _).toMonoidHom
          (MulEquiv.refl _).surjective (InputsL33c.ker_mulEquiv_le_center _) hA
      · intro hA
        have := (Claims1110h.sl_a5 (m := 3) (by norm_num)
          (CFSG.RankThree.PartTwo.Sec4.slPiTrueEquiv (2 ^ f) F).symm.toMonoidHom
          (CFSG.RankThree.PartTwo.Sec4.slPiTrueEquiv (2 ^ f) F).symm.surjective
          (InputsL33c.ker_mulEquiv_le_center _) hA).1
        omega
  refine noA5Comps_of_normal (commutator ↥(projImage (Sec4.glPi π 3 (2 ^ f) F))) ?_ ?_ ?_
  · rw [hcomm]
    exact CFSG.LocalCores.isQuasisimple_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hSP).symm hq
  · refine Group.isSolvable_of_comm fun a b => ?_
    induction a using QuotientGroup.induction_on with | H x => ?_
    induction b using QuotientGroup.induction_on with | H y => ?_
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
    have hxy : (x * y)⁻¹ * (y * x) = ⁅y⁻¹, x⁻¹⁆ := by
      rw [commutatorElement_def]
      group
    rw [hxy, commutator_def]
    exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
  · rw [hcomm]
    exact not_a5_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hSP).symm hnoS

theorem noA5Comps_triality_outer {f : ℕ} (hf : 1 ≤ f) {K₃ : Type} [Field K₃] [Finite K₃]
    (hK₃ : Nat.card K₃ = (2 ^ f) ^ 3) (Fr : K₃ ≃+* K₃) (hFr : ∀ c, Fr c = c ^ (2 ^ f))
    (φ : MulAut ↥(graphFixedRootGroup TwistTag.D4 K₃ Fr.toRingHom)) (hφ3 : φ ^ 3 = 1)
    (hφ : φ ∉ (MulAut.conj : ↥(graphFixedRootGroup TwistTag.D4 K₃ Fr.toRingHom) →*
      MulAut ↥(graphFixedRootGroup TwistTag.D4 K₃ Fr.toRingHom)).range) :
    NoA5Comps ↥(fixSubgroup φ) := by
  have hG2 := noA5Comps_fieldActor_two (by omega) Fr hK₃ hFr
  rcases CFSG.RankThree.PartTwo.Sec8.Item8KFacts2Proof.isStdGraphFieldConj_or_nonempty_autFix_equiv
      (by omega) hK₃ hFr hφ3 hφ with ⟨β, hβ | hβ⟩ | he₂
  · exact NoA5Comps.of_conj_eq (ψ := β⁻¹) (by rw [hβ]; group) hG2
  · exact NoA5Comps.of_conj_eq (ψ := β⁻¹) (by rw [hβ]; group) (NoA5Comps.of_inv hG2)
  · obtain ⟨e₂⟩ := he₂
    have hfixφ : fixSubgroup φ = Sec4.autFix φ := Subgroup.ext fun _ => Iff.rfl
    let ef : ↥(fixSubgroup φ) ≃* ↥(Sec4.autFix φ) := MulEquiv.subgroupCongr hfixφ
    rcases Nat.even_or_odd f with hfe | hfo
    · obtain ⟨F, _, _, hF, ⟨e₃⟩⟩ :=
        CFSG.RankThree.PartTwo.Sec8.kF82D4SecondCentY0Even_holds f hfe (by omega) K₃ Fr hK₃ hFr
      have hPi : Sec4.PiField true 2 f F := ⟨Nat.prime_two, by omega, hF⟩
      have hf2 : 2 ≤ f := by
        obtain ⟨k, hk⟩ := hfe
        omega
      have hq2 : 2 < 2 ^ f :=
        lt_of_lt_of_le (by norm_num) (Nat.pow_le_pow_right (by norm_num) hf2)
      exact NoA5Comps.of_mulEquiv (ef.trans (e₂.trans e₃)) (noA5Comps_projImage_glPi hPi hq2)
    · obtain ⟨F, _, _, hF, ⟨e₃⟩⟩ :=
        CFSG.RankThree.PartTwo.Sec8.kF82D4SecondCentY0_holds f hfo K₃ Fr hK₃ hFr
      have hPi : Sec4.PiField false 2 f F := ⟨Nat.prime_two, by omega, hF⟩
      by_cases hf1 : f = 1
      ·
        subst hf1
        haveI := CFSG.RankThree.PartTwo.Sec13.isSolvable_projImage_glPi_two hPi (by norm_num)
        exact NoA5Comps.of_mulEquiv (ef.trans (e₂.trans e₃)) noA5Comps_of_isSolvable
      · have hq2 : 2 < 2 ^ f :=
          lt_of_lt_of_le (by norm_num) (Nat.pow_le_pow_right (by norm_num) (by omega : 2 ≤ f))
        exact NoA5Comps.of_mulEquiv (ef.trans (e₂.trans e₃)) (noA5Comps_projImage_glPi hPi hq2)

theorem noA5TriD4Outer_holds : NoA5TriD4Outer := by
  intro q hv hq2 hq8 S _ _ he α hα hout J hJ
  obtain ⟨e⟩ := he
  obtain ⟨K, _, _, σ, hK, hσ, ⟨Θ, hΘker⟩, ⟨eK⟩⟩ := exists_catEquiv_trialityD4 q hv
  let e' : S ≃* ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom) := e.trans eK
  have hβ' : MulAut.congr e' α ^ 3 = 1 := by rw [← map_pow, hα, map_one]
  have hout' : MulAut.congr e' α ∉
      (MulAut.conj : ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom) →*
        MulAut ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom)).range := by
    rintro ⟨x, hx⟩
    apply hout (e'.symm x)
    apply (MulAut.congr e').injective
    rw [InputsL33c.congr_conj_apply, MulEquiv.apply_symm_apply]
    exact hx
  have hf2 : 2 ≤ q.exponent := by
    by_contra h
    have : q.p ^ q.exponent ≤ 2 ^ 1 := by
      rw [hq2]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
    rw [TauCeti.PrimePower.card_def] at hq8
    omega
  have hN := noA5Comps_triality_outer (f := q.exponent) (by omega) (K₃ := K) (by rw [hK, hq2]) σ
    (by rw [← hq2]; exact hσ) _ hβ' hout'
  have hJ' := InputsL33.isComponentOf_map_congr e' hJ
  intro hL
  exact noA5_of_noA5Comps hN hJ' (Claims1110h.a5Center_map e' hL)

end TrialityOuter

section D4Outer

open CFSG.Blueprint CFSG.Blueprint.Chevalley CFSG.LieType.Chevalley
open CFSG.HardMathSupport.Solomon.Coordinator (fixSubgroup mem_fixSubgroup)
open CFSG.HardMathSupport.Lang.D4Three CFSG.HardMathSupport.Lang.E6Descent
open CFSG.ComponentClassification.FixedCommutingProduct (fixedSubgroup)
open scoped Pointwise commutatorElement

theorem ordD_four_two_ne_sixty {n : ℕ} (hn : 1 ≤ n) : CFSG.Open.ordD 4 (2 ^ n) ≠ 60 := by
  unfold CFSG.Open.ordD
  have hev : 2 ∣ (2 ^ n) ^ 4 := dvd_pow (dvd_pow_self 2 (by omega)) (by norm_num)
  have hpos : 1 ≤ (2 ^ n) ^ 4 := Nat.one_le_iff_ne_zero.2 (by positivity)
  have hg : Nat.gcd 4 ((2 ^ n) ^ 4 - 1) = 1 := by
    have hodd : ¬ 2 ∣ (2 ^ n) ^ 4 - 1 := by omega
    have h2 : Nat.Coprime 2 ((2 ^ n) ^ 4 - 1) :=
      (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).2 hodd
    have h4 : Nat.Coprime 4 ((2 ^ n) ^ 4 - 1) := by
      simpa using Nat.Coprime.pow_left 2 h2
    exact h4
  rw [hg, Nat.div_one]
  intro h
  have h8 : 8 ∣ (2 ^ n) ^ (4 * (4 - 1)) := by
    have : 2 ^ 3 ∣ (2 ^ n) ^ (4 * (4 - 1)) := by
      rw [← pow_mul]
      exact Nat.pow_dvd_pow 2 (by omega)
    simpa using this
  have h8' := Dvd.dvd.mul_right (Dvd.dvd.mul_right h8 ((2 ^ n) ^ 4 - 1))
    (∏ i ∈ Finset.Icc 1 (4 - 1), ((2 ^ n) ^ (2 * i) - 1))
  rw [h] at h8'
  omega

private theorem exists_frobenius_data {K : Type} [Field K] [Finite K] (σ : K ≃+* K) (hσ : σ ≠ 1)
    (hσ3 : σ ^ 3 = 1) :
    ∃ (ℓ e : ℕ) (T : K ≃+* K), ℓ.Prime ∧ CharP K ℓ ∧ 1 ≤ e ∧ Nat.card K = ℓ ^ (e * 3) ∧
      (∀ c, T c = c ^ (ℓ ^ e)) ∧ (σ = T ∨ σ = T⁻¹) := by
  classical
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨n, hpr, hn⟩ := FiniteField.card K (ringChar K)
  have : Fact (ringChar K).Prime := ⟨hpr⟩
  have hK : Nat.card K = ringChar K ^ (n : ℕ) := by rw [Nat.card_eq_fintype_card, hn]
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hord : orderOf σ = 3 := orderOf_eq_prime hσ3 hσ
  obtain ⟨e, T, he, hef, hT, hσT⟩ :=
    exists_frobenius_eq_or_inv_of_orderOf_three hpr n.pos K hK σ hord
  exact ⟨ringChar K, e, T, hpr, ringChar.charP K, he, by rw [hef, hK], hT, hσT⟩

private theorem d4Graph_zero_eq {K : Type} [Field K] [Finite K] : d4Graph K 0 = 1 := by
  ext h
  simp [coe_d4Graph]

private theorem isSimpleGroup_adjointGroup_D4 (k : Type) [Field k] [Finite k] :
    IsSimpleGroup (adjointGroup Tag.D4 k) ∧ ∃ x y : adjointGroup Tag.D4 k, x * y ≠ y * x := by
  have hnc := (opposite_simple_root_noncommutativity Tag.D4 k).2.2.1
  have : Group.IsPerfect (adjointGroup Tag.D4 k) :=
    ⟨single_edge_perfect Tag.D4 k (Or.inr (Or.inl rfl))⟩
  have : Nontrivial (adjointGroup Tag.D4 k) := by
    obtain ⟨a, b, hab⟩ := hnc
    exact ⟨⟨a * b, b * a, hab⟩⟩
  have hZ : Subgroup.center (adjointGroup Tag.D4 k) = ⊥ := center_adjointGroup_eq_bot
  refine ⟨IsSimpleGroup.mk fun M hM => ?_, hnc⟩
  by_cases hbot : M = ⊥
  · exact Or.inl hbot
  · right
    have hnot : ¬ M ≤ Subgroup.center (adjointGroup Tag.D4 k) := by
      rw [hZ]
      exact fun h => hbot (le_bot_iff.1 h)
    have hsolv := (noncentral_normal_solvable_quotient Tag.D4 k M hnot).2.1
    by_contra htop
    have : Nontrivial (adjointGroup Tag.D4 k ⧸ M) := by
      rw [← not_subsingleton_iff_nontrivial, QuotientGroup.subsingleton_iff]
      exact htop
    exact Group.IsPerfect.not_isSolvable _ hsolv

theorem card_adjointGroup_D4_ne_sixty (k : Type) [Field k] [Finite k] [CharP k 2] :
    Nat.card ↥(adjointGroup Tag.D4 k) ≠ 60 := by
  classical
  have : Fintype k := Fintype.ofFinite k
  obtain ⟨n, -, hn⟩ := FiniteField.card k 2
  have hk : Nat.card k = 2 ^ (n : ℕ) := by rw [Nat.card_eq_fintype_card, hn]
  obtain ⟨eC⟩ :=
    CFSG.HardMathSupport.Lang.Coordinator.D4Bridge.nonempty_statedProj_equiv_adjointGroup k
  have hm : StatedClassicalModel ↥(adjointGroup Tag.D4 k) .POmegaPlus 4 2 n :=
    ⟨⟨Nat.prime_two, n.pos, le_rfl⟩, k, inferInstance, inferInstance, hk, ⟨eC.symm⟩⟩
  rw [(CFSG.Timmesfeld.card_statedClassicalModel_two hm).2.2.2.1 rfl]
  exact ordD_four_two_ne_sixty n.pos

theorem noA5Comps_entrywiseAdjointAut_D4 {K : Type} [Field K] [Finite K] [CharP K 2]
    (σ : K ≃+* K) : NoA5Comps ↥(fixSubgroup (entrywiseAdjointAut Tag.D4 σ)) := by
  classical
  have : Finite (ModGL Tag.D4 K) := finite_modGL
  obtain ⟨-, hinj, -, hJΓ, -, hJnormal, hcomm⟩ :=
    Chevalley_coordinate_field_fixed_normal_subgroup Tag.D4 K σ
  have : Finite (fixSubfield σ) := inferInstance
  have : CharP (fixSubfield σ) 2 :=
    RingHom.charP (algebraMap (fixSubfield σ) K) (algebraMap (fixSubfield σ) K).injective 2
  obtain ⟨hs, hnc⟩ := isSimpleGroup_adjointGroup_D4 (fixSubfield σ)
  have hJC : fixedFieldImage Tag.D4 σ ≤ adjointGroup Tag.D4 K := fun g hg => (hJΓ hg).1
  have hΓnorm : entrywiseFixedGroup Tag.D4 σ ≤
      Subgroup.normalizer (fixedFieldImage Tag.D4 σ : Set (ModGL Tag.D4 K)) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hJΓ).1 hJnormal
  have hfix : ∀ x : adjointGroup Tag.D4 K,
      x ∈ fixSubgroup (entrywiseAdjointAut Tag.D4 σ) ↔
        (x : ModGL Tag.D4 K) ∈ entrywiseFixedGroup Tag.D4 σ := fun x => by
    rw [mem_fixSubgroup, mem_entrywiseFixedGroup]
    constructor
    · intro h
      exact ⟨x.2, (coe_entrywiseAdjointAut Tag.D4 σ x).symm.trans (congrArg Subtype.val h)⟩
    · rintro ⟨-, h⟩
      exact Subtype.ext ((coe_entrywiseAdjointAut Tag.D4 σ x).trans h)
  let J : Subgroup ↥(adjointGroup Tag.D4 K) :=
    (fixedFieldImage Tag.D4 σ).subgroupOf (adjointGroup Tag.D4 K)
  have hJmem : ∀ x : adjointGroup Tag.D4 K,
      x ∈ J ↔ (x : ModGL Tag.D4 K) ∈ fixedFieldImage Tag.D4 σ := fun x => Iff.rfl
  have hJle : J ≤ fixSubgroup (entrywiseAdjointAut Tag.D4 σ) := fun x hx =>
    (hfix x).2 (hJΓ ((hJmem x).1 hx))
  have hJn : (J.subgroupOf (fixSubgroup (entrywiseAdjointAut Tag.D4 σ))).Normal := by
    refine (Subgroup.normal_subgroupOf_iff_le_normalizer hJle).2 fun g hg => ?_
    rw [Subgroup.mem_normalizer_iff]
    intro h
    rw [hJmem, hJmem]
    exact Subgroup.mem_normalizer_iff.1 (hΓnorm ((hfix g).1 hg)) (h : ModGL Tag.D4 K)
  let eJ : J ≃* adjointGroup Tag.D4 (fixSubfield σ) :=
    (Subgroup.subgroupOfEquivOfLe hJC).trans
      ((adjointGroup Tag.D4 (fixSubfield σ)).equivMapOfInjective _ hinj).symm
  haveI := hs
  let eM := (Subgroup.subgroupOfEquivOfLe hJle).trans eJ
  have hq : CFSG.IsQuasisimple ↥(J.subgroupOf (fixSubgroup (entrywiseAdjointAut Tag.D4 σ))) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv eM.symm
      (CFSG.LocalCores.isQuasisimple_of_isSimpleGroup hnc).1
  have hsol : Group.IsSolvable
      (↥(fixSubgroup (entrywiseAdjointAut Tag.D4 σ)) ⧸
        J.subgroupOf (fixSubgroup (entrywiseAdjointAut Tag.D4 σ))) := by
    refine Group.isSolvable_of_comm fun a b => ?_
    induction a using QuotientGroup.induction_on with | H x => ?_
    induction b using QuotientGroup.induction_on with | H y => ?_
    have hx : ((x : adjointGroup Tag.D4 K) : ModGL Tag.D4 K) ∈ entrywiseFixedGroup Tag.D4 σ :=
      (hfix x.1).1 x.2
    have hy : ((y : adjointGroup Tag.D4 K) : ModGL Tag.D4 K) ∈ entrywiseFixedGroup Tag.D4 σ :=
      (hfix y.1).1 y.2
    have hq := hcomm (QuotientGroup.mk ⟨_, hx⟩) (QuotientGroup.mk ⟨_, hy⟩)
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq,
      Subgroup.mem_subgroupOf] at hq
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq, Subgroup.mem_subgroupOf,
      hJmem]
    exact hq
  haveI := hJn
  exact noA5Comps_of_normal _ hq hsol (not_a5_of_mulEquiv eM.symm
    (not_a5_of_center_eq_bot center_adjointGroup_eq_bot (card_adjointGroup_D4_ne_sixty _)))

theorem noA5Comps_twistedEntrywiseAut_one {K : Type} [Field K] [Finite K] [CharP K 2] {e : ℕ}
    (he : 1 ≤ e) (hK : Nat.card K = 2 ^ (e * 3)) (σ : K ≃+* K) (r : ℕ) (hr : r = 1 ∨ r = 2)
    (hσ : ∀ c, σ c = c ^ ((2 ^ e) ^ r)) :
    NoA5Comps ↥(fixSubgroup (twistedEntrywiseAut TwistTag.D4 1 σ)) := by
  classical
  haveI : CharP (AlgebraicClosure K) 2 :=
    charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective 2
  obtain ⟨-, -, hfixeq, hsimple, hnc⟩ :=
    triality_both_field_orientations_simple_full_ambient_fixed_group 2 e Nat.prime_two he K
      (by rw [hK, pow_mul]) (AlgebraicClosure K) r hr σ.toRingHom hσ
      (iterateFrobenius (AlgebraicClosure K) 2 e) (fun c => by simp [iterateFrobenius_def])
  let eΓ : fixedSubgroup (twistedEntrywiseAut TwistTag.D4 1 σ) ≃*
      graphFixedRootGroup TwistTag.D4 K σ.toRingHom :=
    (fixedSubgroupTwistedEntrywiseAutOneEquiv TwistTag.D4 σ).trans
      (MulEquiv.subgroupCongr hfixeq)
  haveI := hsimple
  haveI : Finite (ModGL TwistTag.D4.tag K) := finite_modGL
  refine NoA5Comps.of_mulEquiv eΓ (noA5Comps_of_simple hnc ?_)
  rw [InputsL33d.card_graphFixedRootGroup_cubic Nat.prime_two he K (by rw [hK, pow_mul]) σ hr hσ]
  exact lieOrderFormula_exc_ne_sixty (by simp [CFSG.Yardstones.Md42047359a2a.lieFamily])
    (by simp)

theorem noA5Comps_twistedEntrywiseAut_D4 {K : Type} [Field K] [Finite K] [CharP K 2] {e : ℕ}
    (he : 1 ≤ e) (hK : Nat.card K = 2 ^ (e * 3)) (T : K ≃+* K) (hT : ∀ c, T c = c ^ (2 ^ e))
    (j : ℤ) (hj : j % 3 = 1 ∨ j % 3 = 2) :
    NoA5Comps ↥(fixSubgroup (twistedEntrywiseAut TwistTag.D4 j T)) := by
  have : Fintype K := Fintype.ofFinite K
  have hq3 : ∀ c : K, c ^ ((2 ^ e) ^ 3) = c := fun c => by
    rw [← pow_mul, ← hK, Nat.card_eq_fintype_card, FiniteField.pow_card]
  have hT3 : T ^ 3 = 1 := by
    refine RingEquiv.ext fun c => ?_
    change T (T (T c)) = c
    rw [hT, hT, hT, ← pow_mul, ← pow_mul, show 2 ^ e * (2 ^ e * 2 ^ e) = (2 ^ e) ^ 3 by ring, hq3]
  have hinv : ∀ c, T⁻¹ c = c ^ ((2 ^ e) ^ 2) := by
    have h1 : T⁻¹ = T ^ 2 := inv_eq_of_mul_eq_one_right (by rw [← pow_succ']; exact hT3)
    intro c
    rw [h1, pow_two]
    change T (T c) = _
    rw [hT, hT, ← pow_mul, sq]
  have hper : twistedEntrywiseAut TwistTag.D4 j T = twistedEntrywiseAut TwistTag.D4 (j % 3) T := by
    have h := twistedEntrywiseAut_add_mul_order TwistTag.D4 (j % 3) (j / 3) T
    rw [show j % 3 + j / 3 * ((TwistTag.D4.order : ℕ) : ℤ) = j by
      change j % 3 + j / 3 * 3 = j
      omega] at h
    exact h
  rw [hper]
  rcases hj with h | h
  · rw [h]
    exact noA5Comps_twistedEntrywiseAut_one he hK T 1 (Or.inl rfl) (fun c => by rw [hT, pow_one])
  · rw [h]
    exact NoA5Comps.of_mulEquiv
      (MulEquiv.subgroupCongr (fixedSubgroup_twistedEntrywiseAut_D4_two T))
      (noA5Comps_twistedEntrywiseAut_one he hK T⁻¹ 2 (Or.inr rfl) hinv)

theorem noA5Comps_of_lang {K : Type} [Field K] [Finite K] {ℓ e : ℕ} [Fact ℓ.Prime] [CharP K ℓ]
    (he : 1 ≤ e) (hK : Nat.card K = ℓ ^ (e * 3)) (T : K ≃+* K) (hT : ∀ c, T c = c ^ (ℓ ^ e))
    (g : adjointGroup Tag.D4 K) (a : Fin Tag.D4.rank → Kˣ) (σ : K ≃+* K)
    (hσT : σ = T ∨ σ = T⁻¹) (ε : ℕ)
    (hP : ∀ j : ℤ, (j = (ε : ℤ) ∨ j = -(ε : ℤ)) →
      NoA5Comps ↥(fixSubgroup (twistedEntrywiseAut TwistTag.D4 j T)))
    (hα : (MulAut.conj g * (exactNormalAut Tag.D4 K a σ 0 * d4Graph K ε)) ^ 3 = 1) :
    NoA5Comps ↥(fixSubgroup (MulAut.conj g * (exactNormalAut Tag.D4 K a σ 0 * d4Graph K ε))) := by
  have hK4 : 4 ≤ Nat.card K := by
    rw [hK]
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ ℓ ^ 2 := Nat.pow_le_pow_left (Fact.out : ℓ.Prime).two_le 2
      _ ≤ ℓ ^ (e * 3) := Nat.pow_le_pow_right (Fact.out : ℓ.Prime).pos (by omega)
  set α := MulAut.conj g * (exactNormalAut Tag.D4 K a σ 0 * d4Graph K ε) with hαdef
  rcases hσT with hσT | hσT
  · subst hσT
    obtain ⟨ψ, hψ⟩ := exists_conj_eq_twistedEntrywiseAut_of_normalForm K hK hK4 he rfl σ hT α hα
      g a ε hαdef
    exact NoA5Comps.of_conj_eq hψ (hP _ (Or.inl rfl))
  · subst hσT
    obtain ⟨ψ, hψ⟩ := exists_conj_inv_eq_twistedEntrywiseAut_of_normalForm K hK hK4 he rfl T T⁻¹
      hT (mul_inv_cancel T) α hα g a ε hαdef
    have h := NoA5Comps.of_inv (NoA5Comps.of_conj_eq hψ (hP _ (Or.inr rfl)))
    rwa [inv_inv] at h

theorem noA5Comps_d4_field {K : Type} [Field K] [Finite K] [hc2 : CharP K 2]
    (g : adjointGroup Tag.D4 K) (a : Fin Tag.D4.rank → Kˣ) (σ : K ≃+* K) (hσ : σ ≠ 1)
    (hσ3 : σ ^ 3 = 1) (hα : (MulAut.conj g * exactNormalAut Tag.D4 K a σ 0) ^ 3 = 1) :
    NoA5Comps ↥(fixSubgroup (MulAut.conj g * exactNormalAut Tag.D4 K a σ 0)) := by
  obtain ⟨ℓ, e, T, hℓ, hchar, he, hK, hT, hσT⟩ := exists_frobenius_data σ hσ hσ3
  obtain rfl : ℓ = 2 := CharP.eq K hchar hc2
  have hα' : (MulAut.conj g * (exactNormalAut Tag.D4 K a σ 0 * d4Graph K 0)) ^ 3 = 1 := by
    rwa [d4Graph_zero_eq, mul_one]
  have h := noA5Comps_of_lang he hK T hT g a σ hσT 0 (fun j hj => ?_) hα'
  · rwa [d4Graph_zero_eq, mul_one] at h
  · have hj0 : j = 0 := by rcases hj with h | h <;> simpa using h
    subst hj0
    have e0 : twistedEntrywiseAut TwistTag.D4 0 T = entrywiseAdjointAut Tag.D4 T := by
      unfold twistedEntrywiseAut
      rw [zpow_zero, one_mul]
      rfl
    rw [e0]
    exact noA5Comps_entrywiseAdjointAut_D4 T

theorem noA5Comps_d4_graphField {K : Type} [Field K] [Finite K] [hc2 : CharP K 2]
    (g : adjointGroup Tag.D4 K) (a : Fin Tag.D4.rank → Kˣ) (σ : K ≃+* K) (hσ : σ ≠ 1)
    (hσ3 : σ ^ 3 = 1) {ε : ℕ} (hε : ε = 1 ∨ ε = 2)
    (hα : (MulAut.conj g * (exactNormalAut Tag.D4 K a σ 0 * d4Graph K ε)) ^ 3 = 1) :
    NoA5Comps ↥(fixSubgroup (MulAut.conj g * (exactNormalAut Tag.D4 K a σ 0 * d4Graph K ε))) := by
  obtain ⟨ℓ, e, T, hℓ, hchar, he, hK, hT, hσT⟩ := exists_frobenius_data σ hσ hσ3
  obtain rfl : ℓ = 2 := CharP.eq K hchar hc2
  refine noA5Comps_of_lang he hK T hT g a σ hσT ε (fun j hj => ?_) hα
  refine noA5Comps_twistedEntrywiseAut_D4 he hK T hT j ?_
  rcases hε with rfl | rfl <;> rcases hj with rfl | rfl <;> omega

theorem noA5Comps_d4_graph {K : Type} [Field K] [Finite K] [CharP K 2]
    (g : adjointGroup Tag.D4 K) (a : Fin Tag.D4.rank → Kˣ) {ε : ℕ} (hε : ε = 1 ∨ ε = 2)
    (hα : (MulAut.conj g * (exactNormalAut Tag.D4 K a 1 0 * d4Graph K ε)) ^ 3 = 1) :
    NoA5Comps ↥(fixSubgroup (MulAut.conj g * (exactNormalAut Tag.D4 K a 1 0 * d4Graph K ε))) := by
  classical
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨n, -, hn⟩ := FiniteField.card K 2
  have hK : Nat.card K = 2 ^ (n : ℕ) := by rw [Nat.card_eq_fintype_card, hn]
  obtain ⟨K₃, _, _, Fr, hK₃, hFr, φ, hφ3, hφout, ⟨e⟩⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.D4Dual.exists_dual_fixEquiv n.pos K hK _
      hα g a hε rfl
  exact NoA5Comps.of_mulEquiv e (noA5Comps_triality_outer n.pos hK₃ Fr hFr φ hφ3 hφout)

theorem noA5Comps_d4_adjoint {F : Type} [Field F] [Finite F] [CharP F 2]
    (α : MulAut ↥(adjointGroup Tag.D4 F)) (hα : α ^ 3 = 1)
    (hout : ∀ h : ↥(adjointGroup Tag.D4 F), MulAut.conj h ≠ α) : NoA5Comps ↥(fixSubgroup α) := by
  have hchar : ringChar F ≠ 3 := by
    rw [ringChar.eq F 2]
    norm_num
  obtain ⟨g, a, σ, ε, hε, hσ3, rfl⟩ := exists_cube_normal_form_sigma α hα
  interval_cases ε
  · rw [d4Graph_zero_eq, mul_one] at hα hout ⊢
    by_cases hσ1 : σ = 1
    · subst hσ1
      obtain ⟨h, hh⟩ :=
        CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.d4_inner_of_diag hchar g a hα
      exact absurd hh.symm (hout h)
    · exact noA5Comps_d4_field g a σ hσ1 hσ3 hα
  · by_cases hσ1 : σ = 1
    · subst hσ1
      exact noA5Comps_d4_graph g a (Or.inl rfl) hα
    · exact noA5Comps_d4_graphField g a σ hσ1 hσ3 (Or.inl rfl) hα
  · by_cases hσ1 : σ = 1
    · subst hσ1
      exact noA5Comps_d4_graph g a (Or.inr rfl) hα
    · exact noA5Comps_d4_graphField g a σ hσ1 hσ3 (Or.inr rfl) hα

theorem noA5Comps_d4_outer {G : Type} [Group G] [Finite G] {f : ℕ}
    (hG : StatedClassicalModel G StatedLieTag.POmegaPlus 4 2 f) (β : MulAut G)
    (hβ : β ^ 3 = 1) (hout : ∀ a : G, MulAut.conj a ≠ β) : NoA5Comps ↥(fixSubgroup β) := by
  obtain ⟨⟨-, hf, -⟩, F, _, _, hF, ⟨eG⟩⟩ := hG
  obtain ⟨eC⟩ :=
    CFSG.HardMathSupport.Lang.Coordinator.D4Bridge.nonempty_statedProj_equiv_adjointGroup F
  let e₂ : G ≃* ↥(adjointGroup Tag.D4 F) := eG.trans eC
  have : CharP F 2 :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic Nat.prime_two hf hF
  have hα : MulAut.congr e₂ β ^ 3 = 1 := by rw [← map_pow, hβ, map_one]
  have hout' : ∀ h : ↥(adjointGroup Tag.D4 F), MulAut.conj h ≠ MulAut.congr e₂ β := by
    intro h hh
    apply hout (e₂.symm h)
    ext x
    have h1 := congrArg (fun φ : MulAut ↥(adjointGroup Tag.D4 F) => e₂.symm (φ (e₂ x))) hh
    simp only [MulAut.congr_apply, MulAut.conj_apply, MulEquiv.trans_apply,
      MulEquiv.symm_apply_apply, map_mul, map_inv] at h1
    rw [MulAut.conj_apply]
    exact h1
  have key := noA5Comps_d4_adjoint (MulAut.congr e₂ β) hα hout'
  rw [Inputs141c.fixSubgroup_congr] at key
  exact NoA5Comps.of_mulEquiv ((fixSubgroup β).equivMapOfInjective e₂.toMonoidHom e₂.injective) key

theorem noA5D4Outer_holds : NoA5D4Outer := by
  intro G _ _ f hG _ β hβ hout J hJ
  exact noA5_of_noA5Comps (noA5Comps_d4_outer hG β hβ hout) hJ

