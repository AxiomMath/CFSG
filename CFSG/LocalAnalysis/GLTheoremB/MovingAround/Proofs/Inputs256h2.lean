    have hZ : Subgroup.center ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom) = ⊥ :=
      center_graphFixedRootGroup_eq_bot σ.surjective
    have hxp : x ^ 3 = 1 :=
      mulAut_conj_injective_of_center_eq_bot hZ (by rw [map_pow, hx, hβ', map_one])
    have hx1 : x ≠ 1 := fun h' => hβ1' (by rw [← hx, h', map_one])
    obtain ⟨p₀, hp₀, hp₀ℓ, hq₀⟩ :=
      exists_setup_prime q.prime_p q.exponent_pos Nat.prime_three (by norm_num) hpℓ
    have hmon : MonomialToralAt Tag.D4 3 :=
      monomialToralAt_exc monomialToralAt_E6_five monomialToralAt_E7_five (by simp) Nat.prime_three
        (by norm_num)
    obtain ⟨S', a, ι, hSq, -, hT, hap, h1, hinj, hrange, hconj⟩ :=
      exists_langSetup_of_inner_triD4_of_prime q.prime_p q.exponent_pos hK σ hσ Nat.prime_three hpℓ
        hp₀ hp₀ℓ hq₀ hmon x hxp hx1
    rw [← hx] at hJ'
    have hpL := natCast_ne_zero_algebraicClosure_of_ne q.prime_p Nat.prime_three hK hpℓ
    obtain ⟨i, hqs, hKR⟩ :=
      CFSG.HardMathSupport.Solomon.Coordinator.LieComp.components_of_langSetup S' Nat.prime_three ι
        hinj hrange _ hconj hT hap h1
        (langSetup_hTame_of_prime S' Nat.prime_three hpL (fun h => absurd h (by decide)) hT hap h1)
        hJ'
    have hq8'' : 8 ≤ S'.D.q := by rw [hSq]; exact hq8'
    let eKR : ↥(J.map (e' : S →* ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom))) ≃*
        ↥(rationalComponent S'.ρ S'.Γ (rootCharHom a) i) :=
      ((J.map (e' : S →* ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom))).equivMapOfInjective ι
        hinj).trans (MulEquiv.subgroupCongr hKR)
    obtain ⟨eA⟩ := hL'
    exact noA5_rationalComponent S' hq8'' Nat.prime_three (by norm_num) hT hap h1 i hqs
      ⟨(InputsL33.centerQuotCongr eKR).symm.trans eA⟩
  ·
    have hout' : ∀ a : S, MulAut.conj a ≠ α := by
      intro a ha
