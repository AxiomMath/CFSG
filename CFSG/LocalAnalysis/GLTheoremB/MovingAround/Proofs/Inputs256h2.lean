    noA5Comp_symplectic_big
  have hO := noA5On_of_comp (fun S _ _ hs hna d hd2 hP he β hβ hβ1 =>
      CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.lieSemisimpleCentSymplecticOrthogonal S
        hs hna d (by obtain ⟨⟨r, q, h⟩ | ⟨r, q, h⟩, -⟩ := hP <;> rw [h] <;> rfl) he 3
        Nat.prime_three (by norm_num) (by rw [hd2]; norm_num) β hβ hβ1)
    (noA5Comp_orthogonal_big hD4)
  have hE := noA5On_of_comp (fun S _ _ hs hna d hd2 hP he β hβ hβ1 =>
      CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.lieSemisimpleCentExceptional S hs hna d
        hP.1 he 3 Nat.prime_three (by norm_num) (by rw [hd2]; norm_num) β hβ hβ1)
