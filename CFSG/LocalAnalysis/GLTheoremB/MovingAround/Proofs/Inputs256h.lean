  obtain ⟨X, _, _, f, hX, hf, hfk, hA⟩ := h
  refine ⟨X, inferInstance, inferInstance, φ.comp f, hX, hφ.comp hf, ?_, hA⟩
  intro x hx
  have h1 : f x ∈ Subgroup.center H := hk hx
  rw [← comap_center_of_surjective hX f hf hfk]
  exact h1

theorem OrthA5.of_quasisimple {H : Type} [Group H] [Finite H]
    (hq : CFSG.IsQuasisimple H)
    (hno : ¬ Nonempty ((H ⧸ Subgroup.center H) ≃* alternatingGroup (Fin 5))) : OrthA5 H :=
  ⟨H, inferInstance, inferInstance, (MulEquiv.refl H).toMonoidHom, hq.1.commutator_eq_top,
    (MulEquiv.refl H).surjective, InputsL33c.ker_mulEquiv_le_center _, hno⟩

theorem OrthA5.not_a5 {H : Type} [Group H] (h : OrthA5 H) :
    ¬ Nonempty ((H ⧸ Subgroup.center H) ≃* alternatingGroup (Fin 5)) := by
  obtain ⟨X, _, _, f, hX, hf, hfk, hA⟩ := h
  exact not_a5_of_surj hX f hf hfk hA

theorem OrthA5.map_projective {K V : Type} [Field K] [AddCommGroup V] [Module K V]
    {Q : QuadraticForm K V} {F : Subgroup (V ≃ₗ[K] V)} (hFΩ : F ≤ orthDerived Q)
    (h : OrthA5 ↥F) :
    OrthA5 ↥((F.subgroupOf (orthDerived Q)).map
      (QuotientGroup.mk' ((scalars K V).subgroupOf (orthDerived Q)))) := by
  have h' : OrthA5 ↥(F.subgroupOf (orthDerived Q)) := by
    let e := (Subgroup.subgroupOfEquivOfLe hFΩ).symm
    refine h.of_surj e.toMonoidHom e.surjective ?_
    intro x hx
    have : x = 1 := e.injective (by rw [map_one]; exact hx)
    rw [this]
    exact one_mem _
  exact h'.of_surj _ (MonoidHom.subgroupMap_surjective _ _) (ker_subgroupMap_le_center _)

theorem orthA5_specialBlock_paired {p : ℕ} {K : Type} [Field K] [Finite K]
    (hK8 : 8 ≤ Nat.card K) {V : Type} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] {Q : QuadraticForm K V} {x : V ≃ₗ[K] V}
    (hx : OddOrderIsometry Q p x) {h : K[X]} [Fact (Irreducible h)]
    (hh : h ∈ primaryFactors x.toLinearMap)
    (hne : h ≠ reciprocalPolynomial h) (hq : CFSG.IsQuasisimple ↥(specialBlock Q x h)) :
    OrthA5 ↥(specialBlock Q x h) := by
  haveI : Finite (AdjoinRoot h) := Module.finite_of_finite K
  have hm : 2 ≤ primaryMultiplicity x.toLinearMap h := by
    by_contra hlt
    have hpos := hx.primaryMultiplicity_pos hh
    have h1 : primaryMultiplicity x.toLinearMap h = 1 := by omega
    exact ne_bot_of_isQuasisimple hq (hx.specialBlock_eq_bot_of_finrank_eq_one hh h1)
  have h8 : 8 ≤ Nat.card (AdjoinRoot h) :=
    hK8.trans (Nat.card_le_card_of_injective _ (algebraMap K (AdjoinRoot h)).injective)
  let b : Module.Basis (Fin (primaryMultiplicity x.toLinearMap h)) (AdjoinRoot h)
      (primaryComponent x.toLinearMap h) := Module.finBasisOfFinrankEq _ _ rfl
  let e₁ : ↥(specialBlock Q x h) ≃*
      Matrix.SpecialLinearGroup (Fin (primaryMultiplicity x.toLinearMap h)) (AdjoinRoot h) :=
    ((MulEquiv.ofBijective (specialToSL Q x h)
      ⟨hx.specialToSL_injective hh, hx.specialToSL_surjective_paired hh hne⟩).trans
      (Matrix.SpecialLinearGroup.toLin_equiv b).symm)
  have hfin : Finite ↥(specialBlock Q x h) := Finite.of_equiv _ e₁.symm.toEquiv
  refine OrthA5.of_quasisimple hq fun hL => ?_
  have := (Claims1110h.sl_a5 hm e₁.symm.toMonoidHom e₁.symm.surjective
    (InputsL33c.ker_mulEquiv_le_center _) hL).2
  omega

theorem orthA5_specialBlock_selfDual {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {K : Type}
    [Field K] [Finite K] (hK8 : 8 ≤ Nat.card K) {V : Type} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] {Q : QuadraticForm K V} {x : V ≃ₗ[K] V}
    (hx : OddOrderIsometry Q p x) {h : K[X]} [Fact (Irreducible h)]
    (hh : h ∈ primaryFactors x.toLinearMap) (hne1 : h ≠ X - 1)
    (hself : h = reciprocalPolynomial h) (hq : CFSG.IsQuasisimple ↥(specialBlock Q x h)) :
    OrthA5 ↥(specialBlock Q x h) := by
  classical
  have hp2' : Odd p := hp.odd_of_ne_two hp2
  have hirr := irreducible_of_mem_primaryFactors hh
  obtain ⟨d, H, hdeg, hroot, hH, hadd1, hadd2, hleft, hright, hsymm⟩ :=
    hx.exists_selfDual_hermitian hp2' hh hne1 hself
  have hd : finrank K (AdjoinRoot h) = 2 * d := by
    rw [(AdjoinRoot.powerBasis hirr.ne_zero).finrank, AdjoinRoot.powerBasis_dim, hdeg]
  obtain ⟨ℓ, f, hU, hq0, hbar⟩ := exists_unitaryFieldData K (AdjoinRoot h) hd
  have hbar' : ∀ z, frobPow K (AdjoinRoot h) d z = hU.bar z := fun z => by
    rw [hbar, frobPow_apply]
  let B : primaryComponent x.toLinearMap h →ₛₗ[hU.bar]
      primaryComponent x.toLinearMap h →ₗ[AdjoinRoot h] AdjoinRoot h :=
    LinearMap.mk₂'ₛₗ hU.bar (RingHom.id _) H hadd1
      (fun c u w => by rw [hleft, smul_eq_mul, hbar']) hadd2
      (fun c u w => by rw [hright, smul_eq_mul, RingHom.id_apply])
  have hBH : ∀ u w, B u w = H u w := fun u w => rfl
  have hBsymm : B.IsSymm := ⟨fun u w => by rw [hBH, hBH, hsymm u w, hbar']⟩
  have hBl : B.SeparatingLeft := by
    intro u hu
    refine Subtype.ext (hx.eq_zero_of_polar_selfdual hh hself u.2 fun w hw => ?_)
    have h1 := hH u ⟨w, hw⟩ 1
    rw [mul_one, one_smul] at h1
    have h2 : H u ⟨w, hw⟩ = 0 := by rw [← hBH]; exact hu _
    rw [h2, map_zero] at h1
    exact h1.symm
  have hrange : (specialBlockGL Q x h).range = sesqSpecialUnitaryGroup B := by
    rw [range_specialBlockGL, sesqSpecialUnitaryGroup]
    congr 1
    ext γ
    rw [hx.mem_range_blockGL_selfDual_iff hh hne1 hself H hH, mem_sesqUnitaryGroup]
    exact Iff.rfl
  let e₁ : ↥(specialBlock Q x h) ≃* ↥(sesqSpecialUnitaryGroup B) :=
    (MonoidHom.ofInjective (hx.specialBlockGL_injective hh)).trans
      (MulEquiv.subgroupCongr hrange)
  haveI := hU.finite
  haveI : Fact ℓ.Prime := ⟨hU.prime⟩
  haveI := hU.charP
  have hE : Nat.card (AdjoinRoot h) = (ℓ ^ (f * d)) ^ 2 := by
    rw [hU.card, ← pow_mul, mul_comm]
  have hd1 : 1 ≤ d := by
    have := hU.one_le
    rcases Nat.eq_zero_or_pos d with h0 | h0
    · rw [h0, mul_zero] at this
      omega
    · exact h0
  have hqd : 8 ≤ ℓ ^ (f * d) := by
    calc 8 ≤ ℓ ^ f := by rw [← hq0]; exact hK8
      _ ≤ ℓ ^ (f * d) := Nat.pow_le_pow_right hU.prime.pos (Nat.le_mul_of_pos_right f hd1)
  have hm : 2 ≤ primaryMultiplicity x.toLinearMap h := by
    by_contra hlt
    have hpos := hx.primaryMultiplicity_pos hh
    have h1 : primaryMultiplicity x.toLinearMap h = 1 := by omega
    exact ne_bot_of_isQuasisimple hq (hx.specialBlock_eq_bot_of_finrank_eq_one hh h1)
  have hfinV : Finite ↥(sesqSpecialUnitaryGroup B) := by
    have : Finite V := Module.finite_of_finite K
    have : Finite (V ≃ₗ[K] V) := Finite.of_injective (fun e : V ≃ₗ[K] V => (e : V → V))
      fun e₁ e₂ h => LinearEquiv.ext (congrFun h)
    exact Finite.of_equiv _ e₁.toEquiv
  have hfinS : Finite ↥(specialBlock Q x h) := Finite.of_equiv _ e₁.symm.toEquiv
  refine OrthA5.of_quasisimple hq fun hL => ?_
  rcases Nat.lt_or_ge (primaryMultiplicity x.toLinearMap h) 3 with hm3 | hm3
  ·
    have hm2 : Module.finrank (AdjoinRoot h) (primaryComponent x.toLinearMap h) = 2 := by
      have : primaryMultiplicity x.toLinearMap h = 2 := by omega
      exact this
    obtain ⟨φ⟩ := CFSG.RankThree.Classical.nonempty_sesqSpecialUnitaryGroup_mulEquiv_SL2 hU hBsymm
      hBl hm2
    have hcardF : Nat.card ↥hU.fixedField = ℓ ^ (f * d) := hU.card_fixedField
    exact not_a5_of_equiv_sl_two (by rw [hcardF]; exact hqd) (e₁.trans φ).symm hL
  ·
    obtain ⟨e₀, he₀⟩ := hU.exists_orthonormal_basis hBsymm hBl
    obtain ⟨e₂⟩ := CFSG.RankThree.CentralLiftU.nonempty_sesqSpecialUnitaryGroup_mulEquiv_SUid hU
      e₀ he₀
    have hS : CFSG.LieType.Universal.Unitary.SUid hU.barEquiv
        (primaryMultiplicity x.toLinearMap h) =
        CFSG.Open.StatedSU (primaryMultiplicity x.toLinearMap h) (ℓ ^ (f * d))
          (AdjoinRoot h) := by
      rw [CFSG.RankThree.CentralLiftU.barEquiv_eq_unitaryInvolution hU]
      exact CFSG.LieType.Universal.Unitary.SUid_eq_statedSU hE _
    let e₃ : ↥(CFSG.Open.StatedSU (primaryMultiplicity x.toLinearMap h) (ℓ ^ (f * d))
        (AdjoinRoot h)) ≃* ↥(sesqSpecialUnitaryGroup B) :=
      (e₂.trans (MulEquiv.subgroupCongr hS)).symm
    let e₄ := e₃.trans e₁.symm
    exact Claims1110h.su_a5_false hU hm3 e₄.toMonoidHom e₄.surjective
      (InputsL33c.ker_mulEquiv_le_center _) hL

theorem orthA5_fixedFactor {p : ℕ} {K : Type} [Field K] [Finite K] [CharP K 2]
    (hK8 : 8 ≤ Nat.card K) {V : Type} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    {Q : QuadraticForm K V} {x : V ≃ₗ[K] V} (hx : OddOrderIsometry Q p x)
    {F : Subgroup (V ≃ₗ[K] V)} (hFq : CFSG.IsQuasisimple ↥F)
    (hFle : F ≤ supportedFixedDerived Q x)
    (hFn : (F.subgroupOf (supportedFixedDerived Q x)).Normal) : OrthA5 ↥F := by
  have hQW := hx.polarBilin_fixed_nondegenerate
  letI : Fintype K := Fintype.ofFinite K
  let e := supportedFixedDerivedEquiv hx
  let A : Subgroup ↥(supportedFixedDerived Q x) := F.subgroupOf (supportedFixedDerived Q x)
  let L : Subgroup ↥(orthDerived (Q.comp (fixedSpace x).subtype)) := A.map e.toMonoidHom
  have hLn : L.Normal := hFn.map e.toMonoidHom e.surjective
  let eAF : ↥A ≃* ↥F := Subgroup.subgroupOfEquivOfLe hFle
  let eAL : ↥A ≃* ↥L := A.equivMapOfInjective e.toMonoidHom e.injective
  have hLq : CFSG.IsQuasisimple ↥L :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv (eAF.symm.trans eAL) hFq
  have hno := omega_noA5 hK8 hQW L hLn hLq
  have : Finite V := Module.finite_of_finite K
  have : Finite (V ≃ₗ[K] V) := Finite.of_injective (fun e : V ≃ₗ[K] V => (e : V → V))
    fun e₁ e₂ h => LinearEquiv.ext (congrFun h)
  exact OrthA5.of_quasisimple hFq (not_a5_of_mulEquiv (eAL.symm.trans eAF) hno)

theorem orthA5_component {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {K : Type} [Field K]
    [Finite K] [CharP K 2] (hK8 : 8 ≤ Nat.card K) {V : Type} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hT : ∃ U : Submodule K V, finrank K U = 3 ∧ ∀ u ∈ U, Q u = 0) (hpℓ : p ≠ ringChar K)
    (a : ProjOrthDerived Q) (ha : a ^ p = 1) (J : Subgroup (ProjOrthDerived Q))
    (hJ : CFSG.Open.IsComponentOf J (Subgroup.centralizer ({a} : Set (ProjOrthDerived Q)))) :
    OrthA5 ↥J := by
  classical
  have : Fact p.Prime := ⟨hp⟩
  have : Finite V := Module.finite_of_finite K
  have : Finite (V ≃ₗ[K] V) := Finite.of_injective (fun e : V ≃ₗ[K] V => (e : V → V))
    fun e₁ e₂ h => LinearEquiv.ext (congrFun h)
  set ρ : ↥(orthDerived Q) →* ProjOrthDerived Q :=
    QuotientGroup.mk' ((scalars K V).subgroupOf (orthDerived Q)) with hρ
  obtain ⟨x, hxa, hx, hcent⟩ : ∃ x : ↥(orthDerived Q), ρ x = a ∧
      OddOrderIsometry Q p (x : V ≃ₗ[K] V) ∧
      Subgroup.centralizer ({a} : Set (ProjOrthDerived Q)) =
        (Subgroup.centralizer ({x} : Set ↥(orthDerived Q))).map ρ := by
    by_cases h1 : a = 1
    · refine ⟨1, by rw [h1, map_one], oddOrderIsometry_of_pow_eq_one hp hpℓ hQ 1 (one_pow p),
        ?_⟩
      have e1 : Subgroup.centralizer ({a} : Set (ProjOrthDerived Q)) = ⊤ := by
        ext g
        simp [h1, Subgroup.mem_centralizer_iff]
      have e2 : Subgroup.centralizer ({(1 : ↥(orthDerived Q))} : Set ↥(orthDerived Q)) = ⊤ := by
        ext g
        simp [Subgroup.mem_centralizer_iff]
      rw [e1, e2, Subgroup.map_top, MonoidHom.range_eq_top.2 (QuotientGroup.mk'_surjective _)]
    · obtain ⟨-, -, -, -, -, -, -, -, hlift⟩ :=
        CFSG.RankThree.Classical.orthogonal_high_Witt_derived_quotient_and_odd_lifts hQ hT
      obtain ⟨x, ⟨hxa, hxp⟩, -, hcent⟩ := hlift p hp hp2 a (orderOf_eq_prime ha h1)
      exact ⟨x, hxa, oddOrderIsometry_of_orthDerived hp hpℓ hQ x hxp, hcent⟩
  obtain ⟨Rep, hRep⟩ := hx.exists_orbitRepresentatives
  set xe : V ≃ₗ[K] V := (x : V ≃ₗ[K] V) with hxe
  set N : Subgroup (ProjOrthDerived Q) := centralizerImage Q xe with hN
  have hNeq : Subgroup.centralizer ({a} : Set (ProjOrthDerived Q)) = N := by
    rw [hcent]
    exact CFSG.RankThree.PartOne.map_centralizer_eq_centralizerImage x
  rw [hNeq] at hJ
  obtain ⟨n, F, hFq, hFsup, hFn0⟩ := exists_fixedFactors hx
  have hFΩ : ∀ i, F i ≤ orthDerived Q := fun i =>
    (hFq i).2.1.trans hx.supportedFixedDerived_le_orthDerived
  set C : Fin n → Subgroup (ProjOrthDerived Q) := fun i => ((F i).subgroupOf (orthDerived Q)).map ρ
    with hC
  have hCsup : (⨆ i, C i) = fixedLayerImage Q xe := by
    by_cases hlist : FixedLayerListed Q xe
    · rw [fixedLayerImage_of_listed hlist]
      unfold fixedComponentImage
      rw [← hFsup hlist, subgroupOf_iSup_of_le F _ hFΩ, Subgroup.map_iSup]
    · have hn := hFn0 hlist
      subst hn
      simp [fixedLayerImage, hlist]
  have hCle : ∀ i, C i ≤ fixedComponentImage Q xe := fun i =>
    Subgroup.map_mono fun g hg => Subgroup.mem_subgroupOf.mpr
      ((hFq i).2.1 (Subgroup.mem_subgroupOf.mp hg))
  have hCcomp : ∀ i, CFSG.Open.IsComponentOf (C i) N := by
    intro i
    have hconj := map_conj_mem ρ (F := (F i).subgroupOf (orthDerived Q))
      (F' := (supportedFixedDerived Q xe).subgroupOf (orthDerived Q)) (fun h k hh hk => by
        have := (Subgroup.normal_subgroupOf_iff (hFq i).2.1).mp (hFq i).2.2 (h : V ≃ₗ[K] V)
          (k : V ≃ₗ[K] V) (Subgroup.mem_subgroupOf.mp hh) (Subgroup.mem_subgroupOf.mp hk)
        exact Subgroup.mem_subgroupOf.mpr this)
    refine isComponentOf_of_normal_normal (hCle i) fixedComponentImage_le_centralizerImage ?_
      hx.normal_fixedComponentImage (isQuasisimple_map_projective (hFΩ i) (hFq i).1)
    rw [Subgroup.normal_subgroupOf_iff (hCle i)]
    intro h k hh hk
    exact hconj _ _ hh hk
  let ι₁ := {r : ↥Rep // r.1 ≠ X - 1 ∧ CFSG.IsQuasisimple ↥(specialBlock Q xe r.1)}
  have hspecΩ : ∀ r : ι₁, specialBlock Q xe r.1.1 ≤ orthDerived Q := fun r =>
    specialBlock_le_orthDerived_of_perfect r.2.2.1
      ((specialBlock_le_isometryCentralizer r.1.1).trans (fun _ hg => (Subgroup.mem_inf.mp hg).1))
  let S : ι₁ → Subgroup (ProjOrthDerived Q) := fun r => componentImage Q xe r.1.1
  have hScomp : ∀ r, CFSG.Open.IsComponentOf (S r) N := fun r =>
    isComponentOf_of_normal_normal componentImage_le_centralizerImage le_rfl normal_componentImage
      (by rw [Subgroup.subgroupOf_self]; exact Subgroup.normal_top)
      (isQuasisimple_map_projective (hspecΩ r) r.2.2)
  set EN : Subgroup (ProjOrthDerived Q) := (⨆ r, S r) ⊔ fixedLayerImage Q xe with hEN
  have hSN : ∀ r, S r ≤ N := fun r => componentImage_le_centralizerImage
  have hENN : EN ≤ N :=
    sup_le (iSup_le hSN) fixedLayerImage_le_centralizerImage
  have hENnormal : (EN.subgroupOf N).Normal :=
    normal_subgroupOf_sup (iSup_le hSN) fixedLayerImage_le_centralizerImage
      (normal_subgroupOf_iSup S hSN fun r => normal_componentImage) hx.normal_fixedLayerImage
  have hENn : ∀ c ∈ N, ∀ e ∈ EN, c * e * c⁻¹ ∈ EN := fun c hc e he =>
    (Subgroup.normal_subgroupOf_iff hENN).mp hENnormal e c he hc
  have hperf : ∀ P : Subgroup (ProjOrthDerived Q), P ≤ N → commutator ↥P = ⊤ → P ≤ EN := by
    intro P hPN hP
    obtain ⟨S₀, hS₀N, hS₀sol, hcomm⟩ := exists_solvable_comm_le hQ hp hp2 x hx hRep EN
      (fun h hh hne hq => le_sup_of_le_left
        (le_iSup S (⟨⟨h, hh⟩, hne, hq⟩ : ι₁)))
      (fun hlist => by
        rw [← fixedLayerImage_of_listed hlist]
        exact le_sup_right)
    haveI := hS₀sol
    exact perfect_le_of_le_sup_solvable hENN hS₀N hENn hcomm hPN (Subgroup.isPerfect_iff.1 ⟨hP⟩)
  let Fm : ι₁ ⊕ Fin n → Subgroup (ProjOrthDerived Q) := Sum.elim S C
  have hFm : ∀ i, CFSG.Open.IsComponentOf (Fm i) N := by
    rintro (r | i)
    · exact hScomp r
    · exact hCcomp i
  have hiSup : (⨆ i, Fm i) = EN := by
    rw [iSup_sum]
    simp only [Fm, Sum.elim_inl, Sum.elim_inr]
    rw [hCsup]
  obtain ⟨i, rfl⟩ := component_mem_named_factors Fm hFm
    (fun P hPN hP => hiSup ▸ hperf P hPN hP) hJ
  rcases i with ⟨⟨h, hh⟩, hne, hq⟩ | i
  · have hh' : h ∈ primaryFactors xe.toLinearMap := hRep.1 hh
    haveI : Fact (Irreducible h) := ⟨irreducible_of_mem_primaryFactors hh'⟩
    refine OrthA5.map_projective (hspecΩ ⟨⟨h, hh⟩, hne, hq⟩) ?_
    by_cases hself : h = reciprocalPolynomial h
    · exact orthA5_specialBlock_selfDual hp hp2 hK8 hx hh' hne hself hq
    · exact orthA5_specialBlock_paired hK8 hx hh' hself hq
  · exact OrthA5.map_projective (hFΩ i)
      (orthA5_fixedFactor hK8 hx (hFq i).1 (hFq i).2.1 (hFq i).2.2)

theorem exists_projOrth_model_card {t : StatedLieTag}
    (ht : t = .POmegaOdd ∨ t = .POmegaPlus ∨ t = .POmegaMinus) {G : Type} [Group G]
    {n ℓ f : ℕ} (hG : StatedClassicalModel G t n ℓ f) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (V : Type) (_ : AddCommGroup V) (_ : Module K V)
      (_ : FiniteDimensional K V) (Q : QuadraticForm K V),
      (QuadraticMap.polarBilin Q).Nondegenerate ∧
      (∃ U : Submodule K V, finrank K U = 3 ∧ ∀ u ∈ U, Q u = 0) ∧ ringChar K = ℓ ∧
      Nat.card K = ℓ ^ f ∧ Nonempty (G ≃* ProjOrthDerived Q) := by
  rcases ht with rfl | rfl | rfl
  · obtain ⟨hadm, K, hKf, hKfin, hcard, ⟨e⟩⟩ := hG
    have h3 : 3 ≤ n ∧ ℓ ≠ 2 := hadm.2.2
    have hring : ringChar K = ℓ :=
      CFSG.ClassicalGroups.Orthogonal.ringChar_eq_of_card_eq hadm.1 hadm.2.1 hcard
    have h2 : (2 : K) ≠ 0 := by
      rw [Ne, CFSG.ClassicalGroups.Orthogonal.two_eq_zero_iff_ringChar_eq_two
        (by rw [hring]; exact hadm.1), hring]
      exact h3.2
    obtain ⟨hQ, hT⟩ := CFSG.ClassicalGroups.Orthogonal.regular_quadOdd (K := K) (n := n) h2 h3.1
    exact ⟨K, hKf, hKfin, _, inferInstance, inferInstance, inferInstance, _, hQ, hT, hring, hcard,
      ⟨e.trans (projOrthEquiv (CFSG.LieType.Universal.Spin.coe_quadOdd n K))⟩⟩
  · obtain ⟨hadm, K, hKf, hKfin, hcard, ⟨e⟩⟩ := hG
    have h4 : 4 ≤ n := hadm.2.2
    have hring : ringChar K = ℓ :=
      CFSG.ClassicalGroups.Orthogonal.ringChar_eq_of_card_eq hadm.1 hadm.2.1 hcard
    obtain ⟨hQ, hT⟩ := CFSG.ClassicalGroups.Orthogonal.regular_quadPlus (K := K) (n := n)
      (by omega)
    exact ⟨K, hKf, hKfin, _, inferInstance, inferInstance, inferInstance, _, hQ, hT, hring, hcard,
      ⟨e.trans (projOrthEquiv (CFSG.LieType.Universal.Spin.coe_quadPlus (n := n) (K := K)))⟩⟩
  · obtain ⟨hadm, K, hKf, hKfin, hcard, b, c, hirr, ⟨e⟩⟩ := hG
    have h4 : 4 ≤ n := hadm.2.2
    have hring : ringChar K = ℓ :=
      CFSG.ClassicalGroups.Orthogonal.ringChar_eq_of_card_eq hadm.1 hadm.2.1 hcard
    obtain ⟨hQ, hT⟩ := CFSG.ClassicalGroups.Orthogonal.regular_quadMinus (K := K) (n := n) h4 hirr
    exact ⟨K, hKf, hKfin, _, inferInstance, inferInstance, inferInstance, _, hQ, hT, hring, hcard,
      ⟨e.trans (projOrthEquiv (CFSG.LieType.Universal.Spin.coe_quadMinus n K b c))⟩⟩

theorem noA5_conj_omega {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {t : StatedLieTag}
    (ht : t = .POmegaOdd ∨ t = .POmegaPlus ∨ t = .POmegaMinus) {G : Type} [Group G]
    {n f : ℕ} (hG : StatedClassicalModel G t n 2 f) (hf8 : 8 ≤ 2 ^ f) (a : G) (ha : a ^ p = 1)
    (J : Subgroup G)
    (hJ : CFSG.Open.IsComponentOf J
      (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj a))) :
    ¬ Nonempty ((↥J ⧸ Subgroup.center ↥J) ≃* alternatingGroup (Fin 5)) := by
  obtain ⟨K, _, _, V, _, _, _, Q, hQ, hT, hring, hcard, ⟨e⟩⟩ := exists_projOrth_model_card ht hG
  haveI : CharP K 2 := hring ▸ ringChar.charP K
  have hK8 : 8 ≤ Nat.card K := by rw [hcard]; exact hf8
  have hfix : CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup
      (MulAut.congr e (MulAut.conj a)) =
      (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj a)).map
        (e : G →* ProjOrthDerived Q) := by
    ext x
    rw [CFSG.HardMathSupport.Solomon.Coordinator.mem_fixSubgroup]
    refine Iff.trans ?_ (Subgroup.mem_map_equiv (f := e)).symm
    rw [CFSG.HardMathSupport.Solomon.Coordinator.mem_fixSubgroup]
    show e (MulAut.conj a (e.symm x)) = x ↔ MulAut.conj a (e.symm x) = e.symm x
    exact e.eq_symm_apply.symm
  have hJ' : CFSG.Open.IsComponentOf (J.map (e : G →* ProjOrthDerived Q))
      (Subgroup.centralizer ({e a} : Set (ProjOrthDerived Q))) := by
    have h1 := CFSG.SignalizerFunctorTheorem.TransportA.isComponentOf_map e hJ
    rw [← hfix, congr_conj, fixSubgroup_conj_eq_centralizer] at h1
    exact h1
  have hJL := orthA5_component hp hp2 hK8 hQ hT (by rw [hring]; omega) (e a)
    (by rw [← map_pow, ha, map_one]) _ hJ'
  intro hL
  exact hJL.not_a5 (Claims1110h.a5Center_map e hL)

end OrthInner

section OrthInnerTwo

open Polynomial Module CFSG.RankThree.PartOne.KCPrimary CFSG.RankThree.PartOne.KCOrthogonal
  CFSG.RankThree.Classical2 CFSG.ClassicalGroups.Orthogonal CFSG.LocalAnalysis.ComponentInitial
  CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple CFSG.Assembly.LowTwoRank
  CFSG.HardMathSupport.Solomon.Coordinator.LieComp
open CFSG.HardMathSupport.Timmesfeld.CrossChar (cyc3 monic_cyc3 irreducible_cyc3 natDegree_cyc3
  reciprocal_cyc3)

theorem eq_cyc3_of_dvd {K : Type} [Field K] (hK2 : Nat.card K = 2) {h : K[X]} (hirr : Irreducible h)
    (hm : h.Monic) (hdvd : h ∣ (X ^ 3 - 1 : K[X])) (h2 : h.natDegree = 2) : h = cyc3 K := by
  have hfac : (X ^ 3 - 1 : K[X]) = (X - C 1) * cyc3 K := by
    unfold cyc3
    rw [map_one]
    ring
  rw [hfac] at hdvd
  rcases hirr.prime.dvd_or_dvd hdvd with h1 | h1
  · have := natDegree_le_of_dvd h1 (X_sub_C_ne_zero 1)
    rw [natDegree_X_sub_C] at this
    omega
  · exact eq_of_monic_of_associated hm (monic_cyc3 K)
      (hirr.associated_of_dvd (irreducible_cyc3 hK2) h1)

theorem orthA5_specialBlock_paired_two {K : Type} [Field K] [Finite K]
    (hK2 : Nat.card K = 2) {V : Type} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] {Q : QuadraticForm K V} {x : V ≃ₗ[K] V}
    (hx : OddOrderIsometry Q 3 x) {h : K[X]} [Fact (Irreducible h)]
    (hh : h ∈ primaryFactors x.toLinearMap)
    (hne : h ≠ reciprocalPolynomial h) (hq : CFSG.IsQuasisimple ↥(specialBlock Q x h)) :
    OrthA5 ↥(specialBlock Q x h) := by
  haveI : Finite (AdjoinRoot h) := Module.finite_of_finite K
  have hm : 2 ≤ primaryMultiplicity x.toLinearMap h := by
    by_contra hlt
    have hpos := hx.primaryMultiplicity_pos hh
    have h1 : primaryMultiplicity x.toLinearMap h = 1 := by omega
    exact ne_bot_of_isQuasisimple hq (hx.specialBlock_eq_bot_of_finrank_eq_one hh h1)
  let b : Module.Basis (Fin (primaryMultiplicity x.toLinearMap h)) (AdjoinRoot h)
      (primaryComponent x.toLinearMap h) := Module.finBasisOfFinrankEq _ _ rfl
  let e₁ : ↥(specialBlock Q x h) ≃*
      Matrix.SpecialLinearGroup (Fin (primaryMultiplicity x.toLinearMap h)) (AdjoinRoot h) :=
    ((MulEquiv.ofBijective (specialToSL Q x h)
      ⟨hx.specialToSL_injective hh, hx.specialToSL_surjective_paired hh hne⟩).trans
      (Matrix.SpecialLinearGroup.toLin_equiv b).symm)
  have hfin : Finite ↥(specialBlock Q x h) := Finite.of_equiv _ e₁.symm.toEquiv
  refine OrthA5.of_quasisimple hq fun hL => ?_
  have h45 := (Claims1110h.sl_a5 hm e₁.symm.toMonoidHom e₁.symm.surjective
    (InputsL33c.ker_mulEquiv_le_center _) hL).2
  have hirr := irreducible_of_mem_primaryFactors hh
  have hcardE : Nat.card (AdjoinRoot h) = 2 ^ h.natDegree := by
    have hmod : Module.Finite K (AdjoinRoot h) := (AdjoinRoot.powerBasis hirr.ne_zero).finite
    rw [Module.natCard_eq_pow_finrank (K := K) (V := AdjoinRoot h),
      (AdjoinRoot.powerBasis hirr.ne_zero).finrank, AdjoinRoot.powerBasis_dim, hK2]
  rw [hcardE] at h45
  have hd1 : 1 ≤ h.natDegree := Irreducible.natDegree_pos hirr
  have hd2 : h.natDegree = 2 := by
    rcases (show h.natDegree = 1 ∨ h.natDegree = 2 ∨ 3 ≤ h.natDegree by omega) with h1 | h1 | h1
    · rw [h1] at h45
      omega
    · exact h1
    · have : 2 ^ 3 ≤ 2 ^ h.natDegree := Nat.pow_le_pow_right (by norm_num) h1
      omega
  have hc := eq_cyc3_of_dvd hK2 hirr (monic_of_mem_primaryFactors hh) (hx.dvd_X_pow_sub_one hh)
    hd2
  apply hne
  rw [hc, reciprocal_cyc3]

theorem orthA5_specialBlock_selfDual_two {K : Type} [Field K] [Finite K] (hK2 : Nat.card K = 2)
    {V : Type} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] {Q : QuadraticForm K V} {x : V ≃ₗ[K] V}
    (hx : OddOrderIsometry Q 3 x) {h : K[X]} [Fact (Irreducible h)]
    (hh : h ∈ primaryFactors x.toLinearMap) (hne1 : h ≠ X - 1)
    (hself : h = reciprocalPolynomial h) (hq : CFSG.IsQuasisimple ↥(specialBlock Q x h)) :
    OrthA5 ↥(specialBlock Q x h) := by
  classical
  have hp2' : Odd 3 := by decide
  have hirr := irreducible_of_mem_primaryFactors hh
  obtain ⟨d, H, hdeg, hroot, hH, hadd1, hadd2, hleft, hright, hsymm⟩ :=
    hx.exists_selfDual_hermitian hp2' hh hne1 hself
  have hd : finrank K (AdjoinRoot h) = 2 * d := by
    rw [(AdjoinRoot.powerBasis hirr.ne_zero).finrank, AdjoinRoot.powerBasis_dim, hdeg]
  obtain ⟨ℓ, f, hU, hq0, hbar⟩ := exists_unitaryFieldData K (AdjoinRoot h) hd
  have hbar' : ∀ z, frobPow K (AdjoinRoot h) d z = hU.bar z := fun z => by
    rw [hbar, frobPow_apply]
  let B : primaryComponent x.toLinearMap h →ₛₗ[hU.bar]
      primaryComponent x.toLinearMap h →ₗ[AdjoinRoot h] AdjoinRoot h :=
    LinearMap.mk₂'ₛₗ hU.bar (RingHom.id _) H hadd1
      (fun c u w => by rw [hleft, smul_eq_mul, hbar']) hadd2
      (fun c u w => by rw [hright, smul_eq_mul, RingHom.id_apply])
  have hBH : ∀ u w, B u w = H u w := fun u w => rfl
  have hBsymm : B.IsSymm := ⟨fun u w => by rw [hBH, hBH, hsymm u w, hbar']⟩
  have hBl : B.SeparatingLeft := by
    intro u hu
    refine Subtype.ext (hx.eq_zero_of_polar_selfdual hh hself u.2 fun w hw => ?_)
    have h1 := hH u ⟨w, hw⟩ 1
    rw [mul_one, one_smul] at h1
    have h2 : H u ⟨w, hw⟩ = 0 := by rw [← hBH]; exact hu _
    rw [h2, map_zero] at h1
    exact h1.symm
  have hrange : (specialBlockGL Q x h).range = sesqSpecialUnitaryGroup B := by
    rw [range_specialBlockGL, sesqSpecialUnitaryGroup]
    congr 1
    ext γ
    rw [hx.mem_range_blockGL_selfDual_iff hh hne1 hself H hH, mem_sesqUnitaryGroup]
    exact Iff.rfl
  let e₁ : ↥(specialBlock Q x h) ≃* ↥(sesqSpecialUnitaryGroup B) :=
    (MonoidHom.ofInjective (hx.specialBlockGL_injective hh)).trans
      (MulEquiv.subgroupCongr hrange)
  haveI := hU.finite
  haveI : Fact ℓ.Prime := ⟨hU.prime⟩
  haveI := hU.charP
  have hE : Nat.card (AdjoinRoot h) = (ℓ ^ (f * d)) ^ 2 := by
    rw [hU.card, ← pow_mul, mul_comm]
  have hd1 : d = 1 := by
    have h3 : h.natDegree ≤ 3 := by
      have := natDegree_le_of_dvd (hx.dvd_X_pow_sub_one hh) (X_pow_sub_C_ne_zero (by norm_num) 1)
      rwa [show (X ^ 3 - 1 : K[X]) = X ^ 3 - C 1 by rw [map_one], natDegree_X_pow_sub_C] at this
    have := hU.one_le
    rcases Nat.eq_zero_or_pos d with h0 | h0
    · rw [h0, mul_zero] at this
      omega
    · omega
  have hqd : ℓ ^ (f * d) = 2 := by rw [hd1, mul_one, ← hq0, hK2]
  have hm : 2 ≤ primaryMultiplicity x.toLinearMap h := by
    by_contra hlt
    have hpos := hx.primaryMultiplicity_pos hh
    have h1 : primaryMultiplicity x.toLinearMap h = 1 := by omega
    exact ne_bot_of_isQuasisimple hq (hx.specialBlock_eq_bot_of_finrank_eq_one hh h1)
  have hfinV : Finite ↥(sesqSpecialUnitaryGroup B) := by
    have : Finite V := Module.finite_of_finite K
    have : Finite (V ≃ₗ[K] V) := Finite.of_injective (fun e : V ≃ₗ[K] V => (e : V → V))
      fun e₁ e₂ h => LinearEquiv.ext (congrFun h)
    exact Finite.of_equiv _ e₁.toEquiv
  have hfinS : Finite ↥(specialBlock Q x h) := Finite.of_equiv _ e₁.symm.toEquiv
  refine OrthA5.of_quasisimple hq fun hL => ?_
  rcases Nat.lt_or_ge (primaryMultiplicity x.toLinearMap h) 3 with hm3 | hm3
  ·
    have hm2 : Module.finrank (AdjoinRoot h) (primaryComponent x.toLinearMap h) = 2 := by
      have : primaryMultiplicity x.toLinearMap h = 2 := by omega
      exact this
    obtain ⟨φ⟩ := CFSG.RankThree.Classical.nonempty_sesqSpecialUnitaryGroup_mulEquiv_SL2 hU hBsymm
      hBl hm2
    haveI : Finite ↥hU.fixedField := inferInstance
    have hcardF : Nat.card ↥hU.fixedField = 2 := by rw [hU.card_fixedField, hqd]
    have h45 := (Claims1110h.sl_a5 le_rfl (e₁.trans φ).symm.toMonoidHom (e₁.trans φ).symm.surjective
      (InputsL33c.ker_mulEquiv_le_center _) hL).2
    rw [hcardF] at h45
    omega
  ·
    obtain ⟨e₀, he₀⟩ := hU.exists_orthonormal_basis hBsymm hBl
    obtain ⟨e₂⟩ := CFSG.RankThree.CentralLiftU.nonempty_sesqSpecialUnitaryGroup_mulEquiv_SUid hU
      e₀ he₀
    have hS : CFSG.LieType.Universal.Unitary.SUid hU.barEquiv
        (primaryMultiplicity x.toLinearMap h) =
        CFSG.Open.StatedSU (primaryMultiplicity x.toLinearMap h) (ℓ ^ (f * d))
          (AdjoinRoot h) := by
      rw [CFSG.RankThree.CentralLiftU.barEquiv_eq_unitaryInvolution hU]
      exact CFSG.LieType.Universal.Unitary.SUid_eq_statedSU hE _
    let e₃ : ↥(CFSG.Open.StatedSU (primaryMultiplicity x.toLinearMap h) (ℓ ^ (f * d))
        (AdjoinRoot h)) ≃* ↥(sesqSpecialUnitaryGroup B) :=
      (e₂.trans (MulEquiv.subgroupCongr hS)).symm
    let e₄ := e₃.trans e₁.symm
    exact Claims1110h.su_a5_false hU hm3 e₄.toMonoidHom e₄.surjective
      (InputsL33c.ker_mulEquiv_le_center _) hL

theorem orthA5_fixedFactor_two {p : ℕ} {K : Type} [Field K] [Finite K] [CharP K 2]
    (hK2 : Nat.card K = 2) {V : Type} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    {Q : QuadraticForm K V} {x : V ≃ₗ[K] V} (hx : OddOrderIsometry Q p x)
    {F : Subgroup (V ≃ₗ[K] V)} (hFq : CFSG.IsQuasisimple ↥F)
    (hFle : F ≤ supportedFixedDerived Q x)
    (hFn : (F.subgroupOf (supportedFixedDerived Q x)).Normal) :
    OrthA5 ↥F ∨ (finrank K (fixedSpace x) = 4 ∧
      ¬ ∃ S : Submodule K (fixedSpace x), finrank K S = 2 ∧ ∀ v ∈ S, Q (v : V) = 0) := by
  have hQW := hx.polarBilin_fixed_nondegenerate
  letI : Fintype K := Fintype.ofFinite K
  let e := supportedFixedDerivedEquiv hx
  let A : Subgroup ↥(supportedFixedDerived Q x) := F.subgroupOf (supportedFixedDerived Q x)
  let L : Subgroup ↥(orthDerived (Q.comp (fixedSpace x).subtype)) := A.map e.toMonoidHom
  have hLn : L.Normal := hFn.map e.toMonoidHom e.surjective
  let eAF : ↥A ≃* ↥F := Subgroup.subgroupOfEquivOfLe hFle
  let eAL : ↥A ≃* ↥L := A.equivMapOfInjective e.toMonoidHom e.injective
  have hLq : CFSG.IsQuasisimple ↥L :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv (eAF.symm.trans eAL) hFq
  have : Finite V := Module.finite_of_finite K
  have : Finite (V ≃ₗ[K] V) := Finite.of_injective (fun e : V ≃ₗ[K] V => (e : V → V))
    fun e₁ e₂ h => LinearEquiv.ext (congrFun h)
  by_cases hA : Nonempty ((↥L ⧸ Subgroup.center ↥L) ≃* alternatingGroup (Fin 5))
  · exact Or.inr (omega_a5_two hK2 hQW L hLn hLq hA)
  · exact Or.inl (OrthA5.of_quasisimple hFq (not_a5_of_mulEquiv (eAL.symm.trans eAF) hA))

theorem orthA5_component_two {K : Type} [Field K]
    [Finite K] [CharP K 2] (hK2 : Nat.card K = 2) {V : Type} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hT : ∃ U : Submodule K V, finrank K U = 3 ∧ ∀ u ∈ U, Q u = 0)
    (a : ProjOrthDerived Q) (ha : a ^ 3 = 1) (J : Subgroup (ProjOrthDerived Q))
    (hJ : CFSG.Open.IsComponentOf J (Subgroup.centralizer ({a} : Set (ProjOrthDerived Q)))) :
    OrthA5 ↥J ∨ ∃ x : ↥(orthDerived Q),
      QuotientGroup.mk' ((scalars K V).subgroupOf (orthDerived Q)) x = a ∧
      OddOrderIsometry Q 3 (x : V ≃ₗ[K] V) ∧ finrank K (fixedSpace (x : V ≃ₗ[K] V)) = 4 ∧
      ¬ ∃ S : Submodule K (fixedSpace (x : V ≃ₗ[K] V)), finrank K S = 2 ∧
        ∀ v ∈ S, Q (v : V) = 0 := by
  classical
  have hp : (3 : ℕ).Prime := Nat.prime_three
  have hp2 : (3 : ℕ) ≠ 2 := by norm_num
  have hpℓ : (3 : ℕ) ≠ ringChar K := by rw [ringChar.eq K 2]; norm_num
  have : Fact (3 : ℕ).Prime := ⟨hp⟩
  have : Finite V := Module.finite_of_finite K
  have : Finite (V ≃ₗ[K] V) := Finite.of_injective (fun e : V ≃ₗ[K] V => (e : V → V))
    fun e₁ e₂ h => LinearEquiv.ext (congrFun h)
  set ρ : ↥(orthDerived Q) →* ProjOrthDerived Q :=
    QuotientGroup.mk' ((scalars K V).subgroupOf (orthDerived Q)) with hρ
  obtain ⟨x, hxa, hx, hcent⟩ : ∃ x : ↥(orthDerived Q), ρ x = a ∧
      OddOrderIsometry Q 3 (x : V ≃ₗ[K] V) ∧
      Subgroup.centralizer ({a} : Set (ProjOrthDerived Q)) =
        (Subgroup.centralizer ({x} : Set ↥(orthDerived Q))).map ρ := by
    by_cases h1 : a = 1
    · refine ⟨1, by rw [h1, map_one], oddOrderIsometry_of_pow_eq_one hp hpℓ hQ 1 (one_pow 3),
        ?_⟩
      have e1 : Subgroup.centralizer ({a} : Set (ProjOrthDerived Q)) = ⊤ := by
        ext g
        simp [h1, Subgroup.mem_centralizer_iff]
      have e2 : Subgroup.centralizer ({(1 : ↥(orthDerived Q))} : Set ↥(orthDerived Q)) = ⊤ := by
        ext g
        simp [Subgroup.mem_centralizer_iff]
      rw [e1, e2, Subgroup.map_top, MonoidHom.range_eq_top.2 (QuotientGroup.mk'_surjective _)]
    · obtain ⟨-, -, -, -, -, -, -, -, hlift⟩ :=
        CFSG.RankThree.Classical.orthogonal_high_Witt_derived_quotient_and_odd_lifts hQ hT
      obtain ⟨x, ⟨hxa, hxp⟩, -, hcent⟩ := hlift 3 hp hp2 a (orderOf_eq_prime ha h1)
      exact ⟨x, hxa, oddOrderIsometry_of_orthDerived hp hpℓ hQ x hxp, hcent⟩
  obtain ⟨Rep, hRep⟩ := hx.exists_orbitRepresentatives
  set xe : V ≃ₗ[K] V := (x : V ≃ₗ[K] V) with hxe
  set N : Subgroup (ProjOrthDerived Q) := centralizerImage Q xe with hN
  have hNeq : Subgroup.centralizer ({a} : Set (ProjOrthDerived Q)) = N := by
    rw [hcent]
    exact CFSG.RankThree.PartOne.map_centralizer_eq_centralizerImage x
  rw [hNeq] at hJ
  obtain ⟨n, F, hFq, hFsup, hFn0⟩ := exists_fixedFactors hx
  have hFΩ : ∀ i, F i ≤ orthDerived Q := fun i =>
    (hFq i).2.1.trans hx.supportedFixedDerived_le_orthDerived
  set C : Fin n → Subgroup (ProjOrthDerived Q) := fun i => ((F i).subgroupOf (orthDerived Q)).map ρ
    with hC
  have hCsup : (⨆ i, C i) = fixedLayerImage Q xe := by
    by_cases hlist : FixedLayerListed Q xe
    · rw [fixedLayerImage_of_listed hlist]
      unfold fixedComponentImage
      rw [← hFsup hlist, subgroupOf_iSup_of_le F _ hFΩ, Subgroup.map_iSup]
    · have hn := hFn0 hlist
      subst hn
      simp [fixedLayerImage, hlist]
  have hCle : ∀ i, C i ≤ fixedComponentImage Q xe := fun i =>
    Subgroup.map_mono fun g hg => Subgroup.mem_subgroupOf.mpr
      ((hFq i).2.1 (Subgroup.mem_subgroupOf.mp hg))
  have hCcomp : ∀ i, CFSG.Open.IsComponentOf (C i) N := by
    intro i
    have hconj := map_conj_mem ρ (F := (F i).subgroupOf (orthDerived Q))
      (F' := (supportedFixedDerived Q xe).subgroupOf (orthDerived Q)) (fun h k hh hk => by
        have := (Subgroup.normal_subgroupOf_iff (hFq i).2.1).mp (hFq i).2.2 (h : V ≃ₗ[K] V)
          (k : V ≃ₗ[K] V) (Subgroup.mem_subgroupOf.mp hh) (Subgroup.mem_subgroupOf.mp hk)
        exact Subgroup.mem_subgroupOf.mpr this)
    refine isComponentOf_of_normal_normal (hCle i) fixedComponentImage_le_centralizerImage ?_
      hx.normal_fixedComponentImage (isQuasisimple_map_projective (hFΩ i) (hFq i).1)
    rw [Subgroup.normal_subgroupOf_iff (hCle i)]
    intro h k hh hk
    exact hconj _ _ hh hk
  let ι₁ := {r : ↥Rep // r.1 ≠ X - 1 ∧ CFSG.IsQuasisimple ↥(specialBlock Q xe r.1)}
  have hspecΩ : ∀ r : ι₁, specialBlock Q xe r.1.1 ≤ orthDerived Q := fun r =>
    specialBlock_le_orthDerived_of_perfect r.2.2.1
      ((specialBlock_le_isometryCentralizer r.1.1).trans (fun _ hg => (Subgroup.mem_inf.mp hg).1))
  let S : ι₁ → Subgroup (ProjOrthDerived Q) := fun r => componentImage Q xe r.1.1
  have hScomp : ∀ r, CFSG.Open.IsComponentOf (S r) N := fun r =>
    isComponentOf_of_normal_normal componentImage_le_centralizerImage le_rfl normal_componentImage
      (by rw [Subgroup.subgroupOf_self]; exact Subgroup.normal_top)
      (isQuasisimple_map_projective (hspecΩ r) r.2.2)
  set EN : Subgroup (ProjOrthDerived Q) := (⨆ r, S r) ⊔ fixedLayerImage Q xe with hEN
  have hSN : ∀ r, S r ≤ N := fun r => componentImage_le_centralizerImage
  have hENN : EN ≤ N :=
    sup_le (iSup_le hSN) fixedLayerImage_le_centralizerImage
  have hENnormal : (EN.subgroupOf N).Normal :=
    normal_subgroupOf_sup (iSup_le hSN) fixedLayerImage_le_centralizerImage
      (normal_subgroupOf_iSup S hSN fun r => normal_componentImage) hx.normal_fixedLayerImage
  have hENn : ∀ c ∈ N, ∀ e ∈ EN, c * e * c⁻¹ ∈ EN := fun c hc e he =>
    (Subgroup.normal_subgroupOf_iff hENN).mp hENnormal e c he hc
  have hperf : ∀ P : Subgroup (ProjOrthDerived Q), P ≤ N → commutator ↥P = ⊤ → P ≤ EN := by
    intro P hPN hP
    obtain ⟨S₀, hS₀N, hS₀sol, hcomm⟩ := exists_solvable_comm_le hQ hp hp2 x hx hRep EN
      (fun h hh hne hq => le_sup_of_le_left
        (le_iSup S (⟨⟨h, hh⟩, hne, hq⟩ : ι₁)))
      (fun hlist => by
        rw [← fixedLayerImage_of_listed hlist]
        exact le_sup_right)
    haveI := hS₀sol
    exact perfect_le_of_le_sup_solvable hENN hS₀N hENn hcomm hPN (Subgroup.isPerfect_iff.1 ⟨hP⟩)
  let Fm : ι₁ ⊕ Fin n → Subgroup (ProjOrthDerived Q) := Sum.elim S C
  have hFm : ∀ i, CFSG.Open.IsComponentOf (Fm i) N := by
    rintro (r | i)
    · exact hScomp r
    · exact hCcomp i
  have hiSup : (⨆ i, Fm i) = EN := by
    rw [iSup_sum]
    simp only [Fm, Sum.elim_inl, Sum.elim_inr]
    rw [hCsup]
  obtain ⟨i, rfl⟩ := component_mem_named_factors Fm hFm
    (fun P hPN hP => hiSup ▸ hperf P hPN hP) hJ
  rcases i with ⟨⟨h, hh⟩, hne, hq⟩ | i
  · left
    have hh' : h ∈ primaryFactors xe.toLinearMap := hRep.1 hh
    haveI : Fact (Irreducible h) := ⟨irreducible_of_mem_primaryFactors hh'⟩
    refine OrthA5.map_projective (hspecΩ ⟨⟨h, hh⟩, hne, hq⟩) ?_
    by_cases hself : h = reciprocalPolynomial h
    · exact orthA5_specialBlock_selfDual_two hK2 hx hh' hne hself hq
    · exact orthA5_specialBlock_paired_two hK2 hx hh' hself hq
  · rcases orthA5_fixedFactor_two hK2 hx (hFq i).1 (hFq i).2.1 (hFq i).2.2 with hO | hO
    · exact Or.inl (OrthA5.map_projective (hFΩ i) hO)
    · exact Or.inr ⟨x, hxa, hx, hO⟩

end OrthInnerTwo

section PiThree

open QuadraticMap Module CFSG.HardMathSupport.Timmesfeld.OrthogonalGeneration

local notation "fixSubT" => CFSG.HardMathSupport.Timmesfeld.OrthogonalGeneration.fixSub

theorem hasFixedPointFreeOrder_of_fixedSpace_four {V : Type} [AddCommGroup V]
    [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V] {Q : QuadraticForm (ZMod 2) V}
    (hQ : (polarBilin Q).Nondegenerate) {ε : Bool} {N : ℕ} (hstd : IsStdSpace ε Q N)
    (hN : 2 ≤ N) {g : V ≃ₗ[ZMod 2] V} (hg : g ∈ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hgp : g ^ 3 = 1) {W : Submodule (ZMod 2) V} (hW : ∀ v, v ∈ W ↔ g v = v)
    (h4 : finrank (ZMod 2) W = 4)
    (hns : ¬ ∃ S : Submodule (ZMod 2) W, finrank (ZMod 2) S = 2 ∧ ∀ v ∈ S, Q (v : V) = 0) :
    HasFixedPointFreeOrder ε (N - 1) 3 := by
  have hWeq : W = fixSubT (Subgroup.zpowers g) :=
    Submodule.ext fun v => (hW v).trans mem_fixSub_zpowers.symm
  subst hWeq
  have hp : (3 : ℕ).Prime := Nat.prime_three
  have hodd : Odd 3 := by decide
  have hEO : Subgroup.zpowers g ≤ TauCeti.QuadraticMap.orthogonalGroup Q :=
    (Subgroup.zpowers_le).mpr hg
  have hoddc : Odd (Nat.card (Subgroup.zpowers g)) :=
    odd_natCard_subgroup_of_pow_eq_one hodd fun h hh => by
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hh
      rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hgp, one_zpow]
  have hWnd : CFSG.ClassicalGroups.Orthogonal.PolarNondegOn Q (fixSubT (Subgroup.zpowers g)) :=
    polarNondegOn_fixSub hQ hEO hoddc
  obtain ⟨ε₁, ε₂, m₁, m₂, h₁, hm₁, h₂, hm₂, h⟩ := exists_isStdSpace_perp hQ hWnd
  have h₂' : IsStdSpace ε₂ (Q.restrict (perpSub Q (fixSubT (Subgroup.zpowers g)))) m₂ := by
    rw [← polarPerp_eq_perpSub]; exact h₂
  have hc : ∀ x ∈ Subgroup.zpowers g, g * x = x * g := fun x hx => by
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
    exact (Commute.self_zpow g k).eq
  have hc' : ∀ x ∈ Subgroup.zpowers g, g⁻¹ * x = x * g⁻¹ := fun x hx => by
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
    exact ((Commute.self_zpow g k).inv_left).eq
  have hU : (perpSub Q (fixSubT (Subgroup.zpowers g))).map (g : V →ₗ[ZMod 2] V) =
      perpSub Q (fixSubT (Subgroup.zpowers g)) := by
    refine le_antisymm ?_ fun x hx => ?_
    · rintro _ ⟨x, hx, rfl⟩
      exact apply_mem_perpSub_fixSub_of_commute hg hc hx
    · exact ⟨g⁻¹ x, apply_mem_perpSub_fixSub_of_commute (inv_mem hg) hc' hx, by simp⟩
  set T := restrictPerp Q g hU with hTdef
  have hT : ∀ v, (Q.restrict (perpSub Q (fixSubT (Subgroup.zpowers g)))) (T v) =
      (Q.restrict (perpSub Q (fixSubT (Subgroup.zpowers g)))) v := fun v =>
    TauCeti.QuadraticMap.map_app_of_mem_orthogonalGroup hg (v : V)
  have hTp : T ^ 3 = 1 := LinearEquiv.ext fun x =>
    Subtype.ext (by rw [hTdef, coe_restrictPerp_pow, hgp]; rfl)
  have hfix : ∀ v, T v = v → v = 0 := fun v hv =>
    Subtype.ext (eq_zero_of_mem_perpSub_fixSub_of_apply_eq hQ hg hodd hgp v.2
      (congrArg Subtype.val hv))
  have hd2 := dvd_of_fpf h₂' hm₂ hp T hT hTp hfix
  have hm : ((ε₁ == ε₂) = false) → 1 ≤ m₁ + m₂ := fun hε => by
    by_cases h1 : ε₁ = false
    · have := hm₁ h1; omega
    · have h2 : ε₂ = false := by cases ε₁ <;> cases ε₂ <;> simp_all
      have := hm₂ h2; omega
  obtain ⟨hεe, hnm⟩ := isStdSpace_unique hstd h (fun _ => by omega) hm
  have hfr := finrank_of_isStdSpace_arf h₁ hm₁
  have hm₁2 : m₁ = 2 := by omega
  have hε₁ : ε₁ = false := by
    cases hε : ε₁
    · rfl
    · exfalso
      rw [hε, hm₁2] at h₁
      obtain ⟨φ, hφ⟩ := h₁
      let iso : (CFSG.LieType.Universal.Spin.quadPlus 2 (ZMod 2)).IsometryEquiv
          (Q.restrict (fixSubT (Subgroup.zpowers g))) :=
        { toLinearEquiv := φ.symm
          map_app' := fun u => by
            have := hφ (φ.symm u)
            rw [LinearEquiv.apply_symm_apply] at this
            exact this.symm }
      obtain ⟨S, hS, hSs⟩ := CFSG.GroupTheory.WeirSylow.IsPlusType.of_isometryEquiv iso
        (CFSG.GroupTheory.WeirSylow.isPlusType_quadPlus (ZMod 2) 2)
      exact hns ⟨S, by omega, fun v hv => hSs v hv⟩
  have hN1 : 1 ≤ N - 1 := by omega
  refine (hasFixedPointFreeOrder_iff hp (by norm_num) hN1).mpr ?_
  rw [dvd_iff_pow_eq_sgn] at hd2 ⊢
  have hn' : N - 1 = 1 + m₂ := by omega
  rw [hn', pow_add, hd2, hεe, hε₁, sgnZ_beq]
  cases ε₂ <;> decide

end PiThree

section OmegaTwoInner

open Polynomial Module CFSG.RankThree.PartOne.KCOrthogonal CFSG.RankThree.Classical2
  CFSG.HardMathSupport.Solomon.Coordinator.LieComp CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple

theorem noA5_conj_projOrth_two {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] {Q : QuadraticForm (ZMod 2) V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hT : ∃ U : Submodule (ZMod 2) V, finrank (ZMod 2) U = 3 ∧ ∀ u ∈ U, Q u = 0)
    {ε : Bool} {N : ℕ} (hstd : CFSG.HardMathSupport.Timmesfeld.OrthogonalGeneration.IsStdSpace ε Q N)
    (hN : 2 ≤ N) (hPi : ¬ HasFixedPointFreeOrder ε (N - 1) 3)
    {G : Type} [Group G] (e : G ≃* ProjOrthDerived Q) (a : G) (ha : a ^ 3 = 1) (J : Subgroup G)
    (hJ : CFSG.Open.IsComponentOf J
      (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj a))) :
    ¬ Nonempty ((↥J ⧸ Subgroup.center ↥J) ≃* alternatingGroup (Fin 5)) := by
  have hfix : CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup
      (MulAut.congr e (MulAut.conj a)) =
      (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj a)).map
        (e : G →* ProjOrthDerived Q) := by
    ext x
    rw [CFSG.HardMathSupport.Solomon.Coordinator.mem_fixSubgroup]
    refine Iff.trans ?_ (Subgroup.mem_map_equiv (f := e)).symm
    rw [CFSG.HardMathSupport.Solomon.Coordinator.mem_fixSubgroup]
    show e (MulAut.conj a (e.symm x)) = x ↔ MulAut.conj a (e.symm x) = e.symm x
    exact e.eq_symm_apply.symm
  have hJ' : CFSG.Open.IsComponentOf (J.map (e : G →* ProjOrthDerived Q))
      (Subgroup.centralizer ({e a} : Set (ProjOrthDerived Q))) := by
    have h1 := CFSG.SignalizerFunctorTheorem.TransportA.isComponentOf_map e hJ
    rw [← hfix, congr_conj, fixSubgroup_conj_eq_centralizer] at h1
    exact h1
  intro hL
  rcases orthA5_component_two (K := ZMod 2) (Nat.card_zmod 2) hQ hT (e a)
      (by rw [← map_pow, ha, map_one]) _ hJ' with hJL | ⟨x, -, hx, h4, hns⟩
  · exact hJL.not_a5 (Claims1110h.a5Center_map e hL)
  · exact hPi (hasFixedPointFreeOrder_of_fixedSpace_four hQ hstd hN hx.mem hx.pow_eq_one
      (fun v => mem_fixedSpace) h4 hns)

theorem noA5_conj_omegaTwo {S : Type} [Group S] {ε : Bool} {N : ℕ} (hN : 4 ≤ N)
    (hS : IsOmegaTwo ε N S) (hPi : ¬ HasFixedPointFreeOrder ε (N - 1) 3) (a : S) (ha : a ^ 3 = 1)
    (J : Subgroup S)
    (hJ : CFSG.Open.IsComponentOf J
      (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup (MulAut.conj a))) :
    ¬ Nonempty ((↥J ⧸ Subgroup.center ↥J) ≃* alternatingGroup (Fin 5)) := by
  cases ε
  · obtain ⟨e0⟩ := CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.Omega2401.nonempty_statedProj_of_isOmegaTwo_false hS
    obtain ⟨hQ, hT⟩ := CFSG.ClassicalGroups.Orthogonal.regular_quadMinus (K := ZMod 2) (n := N)
      (b := 1) (c := 1) hN (by decide)
    let e := e0.trans (projOrthEquiv (CFSG.LieType.Universal.Spin.coe_quadMinus N (ZMod 2) 1 1))
    have hstd : CFSG.HardMathSupport.Timmesfeld.OrthogonalGeneration.IsStdSpace false
        (CFSG.LieType.Universal.Spin.quadMinus N (ZMod 2) 1 1) N :=
      ⟨LinearEquiv.refl _ _, fun v => rfl⟩
    exact noA5_conj_projOrth_two hQ hT hstd (by omega) hPi e a ha J hJ
  · obtain ⟨e0⟩ := CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.Omega2401.nonempty_statedProj_of_isOmegaTwo_true hS
    obtain ⟨hQ, hT⟩ := CFSG.ClassicalGroups.Orthogonal.regular_quadPlus (K := ZMod 2) (n := N)
      (by omega)
    let e := e0.trans (projOrthEquiv (CFSG.LieType.Universal.Spin.coe_quadPlus (n := N)
      (K := ZMod 2)))
    have hstd : CFSG.HardMathSupport.Timmesfeld.OrthogonalGeneration.IsStdSpace true
        (CFSG.LieType.Universal.Spin.quadPlus N (ZMod 2)) N :=
      ⟨LinearEquiv.refl _ _, fun v => rfl⟩
    exact noA5_conj_projOrth_two hQ hT hstd (by omega) hPi e a ha J hJ

end OmegaTwoInner

section OrthOuter

open CFSG.HardMathSupport.Solomon.Coordinator.LieComp

theorem noA5_omega_outer {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {t : StatedLieTag}
    (ht : t = .POmegaPlus ∨ t = .POmegaMinus) {G : Type} [Group G]
    {n ℓ f : ℕ} (hG : StatedClassicalModel G t n ℓ f) (hD4 : t = .POmegaPlus → n = 4 → p ≠ 3)
    (β : MulAut G) (hβ : β ^ p = 1) (hout : ∀ a : G, MulAut.conj a ≠ β) (J : Subgroup G)
    (hJ : CFSG.Open.IsComponentOf J (CFSG.HardMathSupport.Solomon.Coordinator.fixSubgroup β)) :
    ¬ Nonempty ((↥J ⧸ Subgroup.center ↥J) ≃* alternatingGroup (Fin 5)) := by
  have hconj : OmegaFieldConj G β ℓ p := by
    rcases ht with rfl | rfl
    · exact omegaFieldConj_plus hp hp2 hG (hD4 rfl) β hβ hout
    · exact omegaFieldConj_minus hp hp2 hG β hβ hout
  obtain ⟨K, _, _, k, d, Q₀, Q, σ, S, e, hd, hch, he⟩ := hconj.out
  have hd0 : 0 < d := by omega
  obtain ⟨-, hK⟩ := fieldAutT_layer_and_eq S hd0
  obtain ⟨hqT, π, hπ, hπk⟩ := exists_central_epi_omega S hd0
  have hJ1 := InputsL33.isComponentOf_map_congr e hJ
  rw [he] at hJ1
  have hJeq := hK _ hJ1
  intro hL
  have hL1 := Claims1110h.a5Center_map e hL
  rw [hJeq] at hL1
  have : Finite k := Finite.of_injective (algebraMap k K) (algebraMap k K).injective
  letI : Fintype k := Fintype.ofFinite k
  exact not_a5_of_surj hqT.1.commutator_eq_top π hπ hπk
    (not_a5_top rfl (large_noA5 S.hnd₀ (by rw [Module.finrank_fin_fun]; exact hd))) hL1

@[expose] def NoA5D4Outer : Prop :=
  ∀ (G : Type) [Group G] [Finite G] {f : ℕ},
    StatedClassicalModel G StatedLieTag.POmegaPlus 4 2 f → 8 ≤ 2 ^ f →
    ∀ β : MulAut G, β ^ 3 = 1 → (∀ a : G, MulAut.conj a ≠ β) →
    ∀ J : Subgroup G, IsComponentOf J (fixSubgroup β) →
      ¬ Nonempty ((↥J ⧸ Subgroup.center ↥J) ≃* alternatingGroup (Fin 5))

theorem noA5_omega (hD4 : NoA5D4Outer) {S : Type} [Group S] [Finite S] [IsSimpleGroup S]
    (hna : ∃ a b : S, a * b ≠ b * a) {t : StatedLieTag} (ht : t = .POmegaPlus ∨ t = .POmegaMinus)
    {n f : ℕ} (hG : StatedClassicalModel S t n 2 f) (hf8 : 8 ≤ 2 ^ f) {α : MulAut S}
    (hα : α ^ 3 = 1) {K : Subgroup S} (hK : IsComponentOf K (fixSubgroup α)) :
    ¬ Nonempty ((↥K ⧸ Subgroup.center ↥K) ≃* alternatingGroup (Fin 5)) := by
  by_cases hin : ∃ a : S, MulAut.conj a = α
  · obtain ⟨a, rfl⟩ := hin
    exact noA5_conj_omega Nat.prime_three (by norm_num) (Or.inr ht) hG hf8 a
      (InputsL33c.pow_eq_one_of_conj_pow (InputsL33c.center_eq_bot_of_simple hna) hα) K hK
  · have hout : ∀ a : S, MulAut.conj a ≠ α := fun a h => hin ⟨a, h⟩
    by_cases hd4 : t = .POmegaPlus ∧ n = 4
    · obtain ⟨rfl, rfl⟩ := hd4
      exact hD4 S hG hf8 α hα hout K hK
    · exact noA5_omega_outer Nat.prime_three (by norm_num) ht hG
        (fun h1 h2 => absurd ⟨h1, h2⟩ hd4) α hα hout K hK

theorem noA5Comp_orthogonal_big (hD4 : NoA5D4Outer) :
    NoA5CompOn fun d => ((∃ r q, d.1 = TauCeti.LieTypeIndex.D r q) ∨
      ∃ r q, d.1 = TauCeti.LieTypeIndex.twistedD r q) ∧ d.1.characteristic = 2 ∧
      Inputs256c.defField d.1 ≠ 2 ∧ Inputs256c.defField d.1 ≠ 4 := by
  intro S _ _ hs hna d hP he β hβ K hK
  haveI := hs
  obtain ⟨hD, hd2, hf2, hf4⟩ := hP
  obtain ⟨⟨d, hv⟩, rfl⟩ : ∃ d' : TauCeti.ValidLieTypeIndex, d' = d := ⟨d, rfl⟩
  obtain ⟨e⟩ := he
  have key : ∀ (q : TauCeti.PrimePower), q.p = 2 → q.card ≠ 2 → q.card ≠ 4 →
      8 ≤ 2 ^ q.exponent := by
    intro q hq2 hq2' hq4
    have he1 := q.exponent_pos
    rw [TauCeti.PrimePower.card_def, hq2] at hq2' hq4
    have h3 : 3 ≤ q.exponent := by
      by_contra h
      have : q.exponent = 1 ∨ q.exponent = 2 := by omega
      rcases this with h' | h' <;> rw [h'] at hq2' hq4 <;> revert hq2' hq4 <;> norm_num
    calc 8 = 2 ^ 3 := by norm_num
      _ ≤ 2 ^ q.exponent := Nat.pow_le_pow_right (by norm_num) h3
  rcases hD with ⟨r, q, hdq⟩ | ⟨r, q, hdq⟩
  · dsimp only at hdq
    subst hdq
    have hq2 : q.p = 2 := by rw [← TauCeti.LieTypeIndex.characteristic_D r q]; exact hd2
    have hm := CFSG.RankThree.PartTwo.Census.statedClassicalModel_typeD r q hv e
    rw [hq2] at hm
    exact noA5_omega hD4 hna (Or.inl rfl) hm (key q hq2 hf2 hf4) hβ hK
  · dsimp only at hdq
    subst hdq
    have hq2 : q.p = 2 := by rw [← TauCeti.LieTypeIndex.characteristic_twistedD r q]; exact hd2
    have hm := CFSG.RankThree.PartTwo.Census.statedClassicalModel_typeTwistedD r q hv e
    rw [hq2] at hm
    exact noA5_omega hD4 hna (Or.inr rfl) hm (key q hq2 hf2 hf4) hβ hK

end OrthOuter

