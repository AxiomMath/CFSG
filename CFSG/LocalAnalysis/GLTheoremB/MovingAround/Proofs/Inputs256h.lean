section Reduction

@[expose] def NoA5CompOn (P : TauCeti.ValidLieTypeIndex → Prop) : Prop :=
  ∀ (S : Type) [Group S] [Finite S], IsSimpleGroup S → (∃ a b : S, a * b ≠ b * a) →
    ∀ d : TauCeti.ValidLieTypeIndex, P d → Nonempty (S ≃* (TauCeti.CFSGIndex.lie d).Group) →
      ∀ β : MulAut S, β ^ 3 = 1 → ∀ K : Subgroup S, IsComponentOf K (fixSubgroup β) →
        ¬ Nonempty ((↥K ⧸ Subgroup.center ↥K) ≃* alternatingGroup (Fin 5))

theorem isComponentOf_and_a5 {S : Type} [Group S] [Finite S] {β : MulAut S}
    (hlay : PerfectInLayer β) {J : Subgroup S} (hJ : GLAPComponent 3 (fixSubgroup β) J)
    (hJ5 : IsAltType 5 (PSimple 3 J)) :
    IsComponentOf J (fixSubgroup β) ∧
      Nonempty ((↥J ⧸ Subgroup.center ↥J) ≃* alternatingGroup (Fin 5)) := by
  obtain ⟨hJc, -⟩ := CFSG.HardMathSupport.Solomon.Coordinator.glaPComponent_isComponent_of_le_layer
    hJ (hlay J hJ.1 (glaPComponent_perfect hJ))
  obtain ⟨e₁⟩ := CFSG.LocalAnalysis.GLTheoremA.rf4_pSimple_equiv_center Nat.prime_three hJ hJc.2.2
  obtain ⟨e₂⟩ := hJ5
  exact ⟨hJc, ⟨e₁.symm.trans e₂⟩⟩

theorem noA5On_of_comp {P : TauCeti.ValidLieTypeIndex → Prop}
    (hlay : ∀ (S : Type) [Group S] [Finite S], IsSimpleGroup S → (∃ a b : S, a * b ≠ b * a) →
      ∀ d : TauCeti.ValidLieTypeIndex, d.1.characteristic = 2 → P d →
        Nonempty (S ≃* (TauCeti.CFSGIndex.lie d).Group) →
        ∀ β : MulAut S, β ^ 3 = 1 → β ≠ 1 → PerfectInLayer β)
    (h : NoA5CompOn P) : Inputs256d.NoA5On P := by
  intro S _ _ hs hnc _ d hd2 hP he β hβ J hJ hJ5
  haveI := hs
  have hl : PerfectInLayer β := by
    by_cases hβ1 : β = 1
    · subst hβ1
      exact CFSG.HardMathSupport.Solomon.Coordinator.perfectInLayer_one hnc
    · exact hlay S hs hnc d hd2 hP he β hβ hβ1
  obtain ⟨hJc, hA⟩ := isComponentOf_and_a5 hl hJ hJ5
  exact h S hs hnc d hP he β hβ J hJc hA

end Reduction

