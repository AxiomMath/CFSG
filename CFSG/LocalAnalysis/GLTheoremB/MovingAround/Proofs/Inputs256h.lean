theorem card_commutator_statedSp_two_two {k : Type} [Field k] [Finite k] (hk : Nat.card k = 2) :
    Nat.card ↥(commutator ↥(StatedSp 2 k)) = 360 := by
  rw [Nat.card_congr ((CFSG.HardMathSupport.Solomon.Coordinator.LieComp.commutatorSpFourEquiv
    hk).trans CFSG.ComponentClassification.PresentationLocal.commutatorEquivAlternating).toEquiv,
    nat_card_alternatingGroup, Nat.card_eq_fintype_card, Fintype.card_fin]
