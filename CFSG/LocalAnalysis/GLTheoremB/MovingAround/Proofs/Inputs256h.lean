theorem noA5_fieldAut_sp {r : ℕ} (hr : 2 ≤ r) {K : Type} [Field K] [Finite K]
    (σ : K ≃+* K) {p : ℕ} (hp : Odd p) (hσ : σ ^ p = 1)
    (K' : Subgroup (StatedProj (StatedSp r K)))
    (hK' : IsComponentOf K' (fixSubgroup (SymplecticHigher.fieldAut r K σ))) :
    ¬ Nonempty ((↥K' ⧸ Subgroup.center ↥K') ≃* alternatingGroup (Fin 5)) := by
  by_cases hex : r = 2 ∧ Nat.card ↥(descentField σ) = 2
  · obtain ⟨rfl, hk2⟩ := hex
    obtain ⟨hfd, hcover⟩ :=
      CFSG.HardMathSupport.Solomon.Coordinator.LieComp.sp_fieldAut_comp_two
        CFSG.HardMathSupport.Solomon.Coordinator.LieComp.spFourTwoFacts_holds hp σ hσ hk2
    obtain ⟨g, hg, hgk⟩ := hcover K' hK'
    refine not_a5_of_surj hfd.perfect g hg hgk ?_
    rintro ⟨eA⟩
    haveI : IsSimpleGroup ↥(commutator CFSG.ComponentClassification.PresentationLocal.sympFour) :=
      CFSG.ComponentClassification.PresentationLocal.isSimpleGroup_commutator_sympFour
    haveI : IsSimpleGroup ↥(commutator ↥(StatedSp 2 (descentField σ))) :=
      (CFSG.HardMathSupport.Solomon.Coordinator.LieComp.commutatorSpFourEquiv hk2).isSimpleGroup
    haveI : Group.IsPerfect ↥(commutator ↥(StatedSp 2 (descentField σ))) := ⟨hfd.perfect⟩
    have hZ : Subgroup.center ↥(commutator ↥(StatedSp 2 (descentField σ))) = ⊥ := by
      rcases (inferInstance : (Subgroup.center
          ↥(commutator ↥(StatedSp 2 (descentField σ)))).Normal).eq_bot_or_eq_top with h | h
      · exact h
      · exact absurd (Subgroup.center_eq_top_iff.1 h) (Group.IsPerfect.not_isMulCommutative _)
    have h1 := Nat.card_congr ((QuotientGroup.quotientMulEquivOfEq hZ).trans
      QuotientGroup.quotientBot).toEquiv
    rw [Nat.card_congr eA.toEquiv, Claims1110h.card_alt_five,
      card_commutator_statedSp_two_two hk2] at h1
    norm_num at h1
  · obtain ⟨hfd, hcover⟩ :=
      CFSG.HardMathSupport.Solomon.Coordinator.LieComp.sp_fieldAut_comp_generic
        CFSG.HardMathSupport.Solomon.Coordinator.LieComp.spFactorFacts_holds hp hr σ hσ hex
    obtain ⟨g, hg, hgk⟩ := hcover K' hK'
    have hq : CFSG.IsQuasisimple (StatedSp r (descentField σ)) := by
      refine CFSG.LieType.Universal.Symplectic.isQuasisimple r _ (by omega) ?_
      have h1 : 1 < Nat.card ↥(descentField σ) := Finite.one_lt_card
      rcases Nat.lt_or_ge (Nat.card ↥(descentField σ)) 4 with h4 | h4
      · rcases (show Nat.card ↥(descentField σ) = 2 ∨ Nat.card ↥(descentField σ) = 3 by omega)
          with h2 | h3
        · exact Or.inr (Or.inr ⟨h2, by
            by_contra hr3
            exact hex ⟨by omega, h2⟩⟩)
        · exact Or.inr (Or.inl ⟨h3, hr⟩)
      · exact Or.inl (Or.inr h4)
    exact fun hL => sp_a5_false hr hq g hg hgk hL

end SpField

section SpCatalogue

open CFSG.LocalAnalysis.ComponentInitial CFSG.LocalAnalysis.ComponentInitial.SymplecticHigher

theorem noA5_psp {S : Type} [Group S] [Finite S] [IsSimpleGroup S]
    (hna : ∃ a b : S, a * b ≠ b * a) {ℓ r f : ℕ} (hm : StatedClassicalModel S .PSp r ℓ f)
    (hℓ3 : ℓ ≠ 3) (h8 : 8 ≤ ℓ ^ f) {α : MulAut S} (hα : α ^ 3 = 1) {K : Subgroup S}
    (hK : IsComponentOf K (fixSubgroup α)) :
    ¬ Nonempty ((↥K ⧸ Subgroup.center ↥K) ≃* alternatingGroup (Fin 5)) := by
  obtain ⟨⟨hℓ, hf, hr, -⟩, k, _, _, hk, ⟨e'⟩⟩ := hm
  haveI : Finite (StatedProj (StatedSp r k)) := Finite.of_equiv S e'.toEquiv
  have hβ' : MulAut.congr e' α ^ 3 = 1 := by rw [← map_pow, hα, map_one]
