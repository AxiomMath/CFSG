theorem natDegree_ne_two_of_dvd_X_pow_three_sub_C {E : Type} [Field E] [Finite E]
    (hE : Nat.card E = 4) {c : E} {a : E[X]} (ha : Irreducible a) (hdvd : a ∣ X ^ 3 - C c) :
    a.natDegree ≠ 2 := by
  classical
  intro h2
  have hX0 : (X ^ 3 - C c : E[X]) ≠ 0 := X_pow_sub_C_ne_zero (by norm_num) c
  obtain ⟨b, hb⟩ := hdvd
  have hb0 : b ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hb
    exact hX0 hb
  have hdb : b.natDegree = 1 := by
    have := congrArg natDegree hb
    rw [natDegree_X_pow_sub_C, natDegree_mul ha.ne_zero hb0, h2] at this
    omega
  obtain ⟨μ, hμ⟩ := exists_root_of_degree_eq_one
    ((degree_eq_iff_natDegree_eq_of_pos one_pos).mpr hdb)
  have hμ3 : μ ^ 3 = c := by
    have h0 : (X ^ 3 - C c : E[X]).eval μ = 0 := by
      rw [hb, eval_mul, hμ.eq_zero, mul_zero]
    simpa [sub_eq_zero] using h0
  have : Fintype E := Fintype.ofFinite E
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Eˣ)
  have hord : orderOf g = 3 := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hg, Nat.card_eq_fintype_card, Fintype.card_units,
      ← Nat.card_eq_fintype_card, hE]
  have hζ : IsPrimitiveRoot (g : E) 3 := by
    have := IsPrimitiveRoot.orderOf (g : E)
    rwa [orderOf_units, hord] at this
  have hspl := X_pow_sub_C_splits_of_isPrimitiveRoot hζ hμ3
  have := (hspl.of_dvd hX0 ⟨b, hb⟩).natDegree_le_one_of_irreducible ha
  omega

theorem minpoly_dvd_X_pow_sub_C_of_pow_scalar {K : Type} [Field K] {n p : ℕ} {a : GL (Fin n) K}
    {c : Kˣ} (hap : a ^ p = Matrix.GeneralLinearGroup.scalar (Fin n) c) :
    minpoly K ((Matrix.GeneralLinearGroup.toLin a :
      LinearMap.GeneralLinearGroup K (Fin n → K)) : Module.End K (Fin n → K)) ∣
        X ^ p - C (c : K) := by
  refine minpoly.dvd K _ ?_
  have h1 : ((Matrix.GeneralLinearGroup.toLin a : LinearMap.GeneralLinearGroup K (Fin n → K)) :
      Module.End K (Fin n → K)) = Matrix.toLin' (a : Matrix (Fin n) (Fin n) K) := rfl
  rw [map_sub, map_pow, aeval_X, aeval_C, h1, ← Matrix.toLin'_pow, ← Units.val_pow_eq_pow_val,
    hap]
  ext v i
  by_cases hi : i = v <;> simp [hi]

