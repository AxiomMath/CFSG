@[expose] def OrthA5 (H : Type) [Group H] : Prop :=
  ∃ (X : Type) (_ : Group X) (_ : Finite X) (f : X →* H), commutator X = ⊤ ∧
    Function.Surjective f ∧ f.ker ≤ Subgroup.center X ∧
      ¬ Nonempty ((X ⧸ Subgroup.center X) ≃* alternatingGroup (Fin 5))

