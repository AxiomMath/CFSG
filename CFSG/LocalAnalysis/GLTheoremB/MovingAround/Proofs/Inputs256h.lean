theorem not_a5_of_range {G : Type} [Group G] {L : Subgroup G} (hL : CFSG.IsQuasisimple ↥L)
    {S : Type} [Group S] (hSq : CFSG.IsQuasisimple S)
    (hS : ¬ Nonempty ((S ⧸ Subgroup.center S) ≃* alternatingGroup (Fin 5))) (ψ : S →* G)
    (hψ : ψ.range = L) : ¬ Nonempty ((↥L ⧸ Subgroup.center ↥L) ≃* alternatingGroup (Fin 5)) := by
  have hnt : ψ.range ≠ ⊥ := by
    rw [hψ]
    intro h
    have := CFSG.LocalCores.isQuasisimple_nontrivial hL
    rw [h] at this
    exact not_nontrivial_iff_subsingleton.mpr inferInstance this
  let f : S →* ↥L := (MulEquiv.subgroupCongr hψ).toMonoidHom.comp ψ.rangeRestrict
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨z, hz⟩ := ψ.rangeRestrict_surjective ((MulEquiv.subgroupCongr hψ).symm y)
    exact ⟨z, by simp [f, hz]⟩
  have hkerf : f.ker = ψ.ker := by
    ext x
    rw [MonoidHom.mem_ker, MonoidHom.mem_ker]
    change (MulEquiv.subgroupCongr hψ) (ψ.rangeRestrict x) = 1 ↔ ψ x = 1
    rw [MulEquiv.map_eq_one_iff]
    exact ⟨fun h => congrArg Subtype.val h, fun h => Subtype.ext h⟩
  have hker : f.ker ≤ Subgroup.center S := by
    rcases CFSG.LocalAnalysis.ComponentInitial.quasisimple_subnormal_subgroups hSq
      (MonoidHom.normal_ker ψ).isSubnormal with h | h
    · exfalso
      apply hnt
      rw [eq_bot_iff]
      rintro _ ⟨x, rfl⟩
      exact Subgroup.mem_bot.mpr (MonoidHom.mem_ker.mp (h ▸ Subgroup.mem_top x))
    · rwa [hkerf]
  exact not_a5_of_surj hSq.1.commutator_eq_top f hf hker hS

theorem not_a5_top {G : Type} [Group G] {L : Subgroup G} (hL : L = ⊤)
    (h : ¬ Nonempty ((G ⧸ Subgroup.center G) ≃* alternatingGroup (Fin 5))) :
    ¬ Nonempty ((↥L ⧸ Subgroup.center ↥L) ≃* alternatingGroup (Fin 5)) := by
  subst hL
  exact not_a5_of_mulEquiv Subgroup.topEquiv.symm h

variable {K : Type} [Field K] [Fintype K] {V : Type} [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] {Q : QuadraticForm K V}

private theorem not_a5_of_phi {L : Subgroup ↥(orthDerived Q)} (hL : CFSG.IsQuasisimple ↥L)
    {S : Type} [Group S] (hSq : CFSG.IsQuasisimple S)
    (hS : ¬ Nonempty ((S ⧸ Subgroup.center S) ≃* alternatingGroup (Fin 5)))
    (φ : S →* ↥(TauCeti.QuadraticMap.orthogonalGroup Q)) (h : φ.range = L.map (OmegaAux.ιO Q)) :
    ¬ Nonempty ((↥L ⧸ Subgroup.center ↥L) ≃* alternatingGroup (Fin 5)) := by
  obtain ⟨ψ, hψ⟩ := OmegaAux.exists_lift_of_range_eq φ L h
  exact not_a5_of_range hL hSq hS ψ hψ

theorem le_fifteen_of_odd_dvd {W d k : ℕ} (hd : Odd d) (hdvd : d ∣ 2 ^ k * W) (hW : W ∣ 120) :
    d ≤ 15 := by
  have hcop : Nat.Coprime d (2 ^ k) := Nat.Coprime.pow_right _ (Nat.coprime_two_right.2 hd)
  have h1 : d ∣ W := hcop.dvd_of_dvd_mul_left hdvd
