variable {ℓ f : ℕ} {K : Type} [Field K] {hK : UnitaryFieldData ℓ f K}
  {V : Type} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  {B : V →ₛₗ[hK.bar] V →ₗ[K] K} {x : LinearMap.GeneralLinearGroup K V}

theorem good_block_a5_two (hq : ℓ ^ f = 2) (H : UnitaryPrimaryData hK.bar B x) {c : K}
    (hc : c ≠ 0) (hmin : minpoly K (x : Module.End K V) ∣ X ^ 3 - C c)
    (a : primaryFactors (x : Module.End K V)) (ha : IsGoodBlock hK x a)
    {T : Type} [Group T] (g : ↥(specialBlock B x (a : K[X])) →* T) (hg : Function.Surjective g)
    (hker : g.ker ≤ Subgroup.center _)
    (hL : Nonempty ((T ⧸ Subgroup.center T) ≃* alternatingGroup (Fin 5))) : False := by
  haveI := hK.finite
  have hd : 1 ≤ (a : K[X]).natDegree :=
    Irreducible.natDegree_pos (irreducible_of_mem_primaryFactors a.2)
  haveI : Finite (AdjoinRoot (a : K[X])) := Module.finite_of_finite K
  have hm2 : 2 ≤ primaryMultiplicity (x : Module.End K V) (a : K[X]) := ha.1
  have hadvd : (a : K[X]) ∣ X ^ 3 - C c := (mem_primaryFactors.1 a.2).2.2.trans hmin
  have hK4 : Nat.card K = 4 := by
    rw [hK.card, pow_mul', hq]
    norm_num
  have hpow : ∀ k : ℕ, ℓ ^ (f * k) = 2 ^ k := fun k => by rw [pow_mul, hq]
  by_cases hself : dualPoly hK.bar (a : K[X]) = a
  · obtain ⟨hE, Hf, hHf, hHfl, ⟨e⟩⟩ :=
      nonempty_specialBlock_mulEquiv_sesqSU hself (selfDualPrimaryBlock H a hself)
    rcases Nat.lt_or_ge (primaryMultiplicity (x : Module.End K V) (a : K[X])) 3 with hm | hm
    · have hV : Module.finrank (AdjoinRoot (a : K[X]))
          (primaryComponent (x : Module.End K V) (a : K[X])) = 2 := by
        have : primaryMultiplicity (x : Module.End K V) (a : K[X]) = 2 := by omega
        exact this
      obtain ⟨e2⟩ :=
        CFSG.RankThree.Classical.nonempty_sesqSpecialUnitaryGroup_mulEquiv_SL2 hE hHf hHfl hV
      haveI : Finite hE.fixedField := inferInstance
      have hcardF : Nat.card hE.fixedField = 2 ^ (a : K[X]).natDegree := by
        rw [hE.card_fixedField, hpow]
      have hφ := InputsL33.ker_comp_mulEquiv_le_center (e.trans e2).symm g hker
      obtain ⟨-, h45⟩ := Claims1110h.sl_a5 le_rfl (g.comp (e.trans e2).symm.toMonoidHom)
        (hg.comp (e.trans e2).symm.surjective) hφ hL
      rw [hcardF] at h45
      have hd2 : (a : K[X]).natDegree = 2 := by
        rcases (show (a : K[X]).natDegree = 1 ∨ (a : K[X]).natDegree = 2 ∨
            3 ≤ (a : K[X]).natDegree by omega) with h1 | h1 | h1
        · rw [h1] at h45
          omega
        · exact h1
        · have : 2 ^ 3 ≤ 2 ^ (a : K[X]).natDegree := Nat.pow_le_pow_right (by norm_num) h1
          omega
      exact natDegree_ne_two_of_dvd_X_pow_three_sub_C hK4
        (irreducible_of_mem_primaryFactors a.2) hadvd hd2
    · obtain ⟨b, hb⟩ := hE.exists_orthonormal_basis hHf hHfl
      obtain ⟨e3⟩ :=
        CFSG.RankThree.CentralLift.nonempty_sesqSpecialUnitaryGroup_mulEquiv_gramSU hE b
          (G := (1 : Matrix (Fin (Module.finrank (AdjoinRoot (a : K[X]))
            (primaryComponent (x : Module.End K V) (a : K[X]))))
            (Fin (Module.finrank (AdjoinRoot (a : K[X]))
            (primaryComponent (x : Module.End K V) (a : K[X])))) (AdjoinRoot (a : K[X]))))
          (fun i j => by rw [hb i j, Matrix.one_apply])
      let e4 := (e.trans e3).trans (MulEquiv.subgroupCongr (unitarySU_eq_gramSU hE _).symm)
      have hφ := InputsL33.ker_comp_mulEquiv_le_center e4.symm g hker
      exact Claims1110h.su_a5_false (m := primaryMultiplicity (x : Module.End K V) (a : K[X])) hE hm
        (g.comp e4.symm.toMonoidHom) (hg.comp e4.symm.surjective) hφ hL
  · obtain ⟨e⟩ := nonempty_specialBlock_mulEquiv_SL (pairedPrimaryBlock H a (Ne.symm hself))
    have hcard : Nat.card (AdjoinRoot (a : K[X])) = 2 ^ (2 * (a : K[X]).natDegree) := by
      rw [natCard_adjoinRoot hK, show 2 * (f * (a : K[X]).natDegree) =
        f * (2 * (a : K[X]).natDegree) by ring, hpow]
    have hφ := InputsL33.ker_comp_mulEquiv_le_center e.symm g hker
    obtain ⟨-, h45⟩ := Claims1110h.sl_a5 hm2 (g.comp e.symm.toMonoidHom)
      (hg.comp e.symm.surjective) hφ hL
    rw [hcard] at h45
    have hd1 : (a : K[X]).natDegree = 1 := by
      by_contra h1
      have : 2 ^ 4 ≤ 2 ^ (2 * (a : K[X]).natDegree) := Nat.pow_le_pow_right (by norm_num) (by omega)
      omega
    have h0 : (a : K[X]).coeff 0 ≠ 0 := by
      intro h0
      have hXa : X ∣ (a : K[X]) := X_dvd_iff.2 h0
      have hX : (X : K[X]) ∣ X ^ 3 - C c := hXa.trans hadvd
      have h1 := X_dvd_iff.1 hX
      simp only [coeff_sub, coeff_C_zero, coeff_X_pow] at h1
      norm_num at h1
      exact hc h1
    exact hself (CFSG.HardMathSupport.Dickson.Sec6.Up34Chev2.dualPoly_eq_self_of_natDegree_one hK hq
      (monic_of_mem_primaryFactors a.2) hd1 h0)

