theorem unitary_card_le_five {S : Type} [Group S] [Finite S] (r : ℕ) (q : TauCeti.PrimePower)
    (hv : (TauCeti.LieTypeIndex.twistedA r q).Valid) (hq3 : q.p ≠ 3)
    (he : Nonempty (S ≃* (TauCeti.CFSGIndex.lie ⟨.twistedA r q, hv⟩).Group))
    {α : MulAut S} (hα : α ^ 3 = 1) {K : Subgroup S} (hK : IsComponentOf K (fixSubgroup α))
    (hL : Nonempty ((↥K ⧸ Subgroup.center ↥K) ≃* alternatingGroup (Fin 5))) : q.card ≤ 5 := by
  have : Fact q.p.Prime := ⟨q.prime_p⟩
  have hp3 : (3 : ℕ).Prime := Nat.prime_three
  obtain ⟨e⟩ := he
  obtain ⟨⟨hℓ, hf, hn3, hq⟩, F, _, _, hF, ⟨eT⟩⟩ :=
    CFSG.QuasithinUnique.SQTK.statedClassicalModel_twistedA r q hv e
  have h : UnitaryFieldData q.p q.exponent F := ⟨hℓ, hf, by rw [hF, ← pow_mul, mul_comm]⟩
  obtain ⟨eP⟩ := nonempty_primeFormP_mulEquiv h (isPrimeFormGram_idGram (n := r + 1) (K := F))
  let e' : S ≃* primeFormP h (idGram F (r + 1)) :=
    (eT.trans (unitaryPSUEquiv h (by omega)).symm).trans eP.symm
  have hq' : ¬(r + 1 = 3 ∧ q.p ^ q.exponent = 2) := fun h3 => hq (Prod.ext h3.1 h3.2)
  have hC : IsPrimeFormGram (1 : GL (Fin (r + 1)) F) := isPrimeFormGram_idGram
  have hβ' : MulAut.congr e' α ^ 3 = 1 := by rw [← map_pow, hα, map_one]
  have hK1 := InputsL33.isComponentOf_map_congr e' hK
  have hL1 := Claims1110h.a5Center_map e' hL
  obtain ⟨-, -, hker1, -, -, -, -, hkerD, -, -, -⟩ :=
    unitary_prime_form_full_semilinear_realization h hC hn3 hq'
  by_cases hσ : primeFormFieldFactor h hC hn3 hq' (MulAut.congr e' α) = 1
  ·
    have hβD : MulAut.congr e' α ∈ (primeFormFieldFactor h hC hn3 hq').ker := hσ
    rw [hkerD, primeFormD, MonoidHom.mem_range] at hβD
    obtain ⟨A, hA⟩ := hβD
    have h1 : primeFormPsi h hC ⟨A ^ 3, 1⟩ = 1 := by
      rw [primeFormPsi_apply, map_pow, hA, hβ', map_one, one_mul]
    obtain ⟨-, c, -, hc⟩ := (hker1 _).1 h1
    have hAp : (A : GL (Fin (r + 1)) F) ^ 3 =
        Matrix.GeneralLinearGroup.scalar (Fin (r + 1)) c := by
      rwa [SubgroupClass.coe_pow] at hc
    rw [← hA] at hK1
    have hle := Claims1110h.unitary_inner_a5 hp3 (Ne.symm hq3) A hAp _ hK1 hL1
    rw [TauCeti.PrimePower.card_def]
    exact hle
  ·
    exfalso
    have hne : MulAut.congr e' α ≠ 1 := fun h1 => hσ (by rw [h1, map_one])
    have : Fact (3 : ℕ).Prime := ⟨hp3⟩
    have hord : orderOf (MulAut.congr e' α) = 3 := orderOf_eq_prime hβ' hne
    have hσp : orderOf (primeFormFieldFactor h hC hn3 hq' (MulAut.congr e' α)) = 3 :=
      orderOf_eq_prime (by rw [← map_pow, hβ', map_one]) hσ
    obtain ⟨-, -, -, -, -, M, hM⟩ :=
      CFSG.GH74.GLS.Stage2.Signalizer.Ivk8.unitary_prime_descent_char h hn3 hq' hp3
        (by norm_num) (MulAut.congr e' α) hord _ rfl hσp
    have hK2 := InputsL33.isComponentOf_map_congr
      ((primeFormConjHom h (idGram F (r + 1)) M)⁻¹ : MulAut _) hK1
    rw [InputsL33.congr_self_eq, inv_inv, hM] at hK2
    have hL2 := Claims1110h.a5Center_map
      ((primeFormConjHom h (idGram F (r + 1)) M)⁻¹ : MulAut _) hL1
    obtain ⟨-, g, hg, hgk⟩ :=
      unitary_fieldAut_components h hn3 hC hp3 (by norm_num) hσp _ hK2
    exact Claims1110h.su_a5_false
      (CFSG.RankThree.Classical.fixSubfield_unitaryFieldData h hp3 (by norm_num) hσp) hn3 g hg hgk
      hL2

theorem noA5Comp_unitary_big :
    NoA5CompOn fun d => (∃ r q, d.1 = TauCeti.LieTypeIndex.twistedA r q) ∧
      d.1.characteristic = 2 ∧ Inputs256c.defField d.1 ≠ 2 ∧ Inputs256c.defField d.1 ≠ 4 := by
  intro S _ _ _ _ d hP he β hβ K hK hL
  obtain ⟨⟨r, q, hdq⟩, hd2, hf2, hf4⟩ := hP
  obtain ⟨⟨d, hv⟩, rfl⟩ : ∃ d' : TauCeti.ValidLieTypeIndex, d' = d := ⟨d, rfl⟩
  dsimp only at hdq
  subst hdq
  have hq2 : q.p = 2 := by rw [← TauCeti.LieTypeIndex.characteristic_twistedA r q]; exact hd2
  have hle := unitary_card_le_five r q hv (by omega) he hβ hK hL
  have hdf : Inputs256c.defField (TauCeti.LieTypeIndex.twistedA r q) = q.card := rfl
  rw [hdf] at hf2 hf4
  rw [TauCeti.PrimePower.card_def, hq2] at hle hf2 hf4
  have he1 := q.exponent_pos
  have h3 : 3 ≤ q.exponent := by
    by_contra h
    have : q.exponent = 1 ∨ q.exponent = 2 := by omega
    rcases this with h' | h' <;> rw [h'] at hf2 hf4 <;> revert hf2 hf4 <;> norm_num
  have : 2 ^ 3 ≤ 2 ^ q.exponent := Nat.pow_le_pow_right (by norm_num) h3
  omega

end Unitary

section Orders

theorem not_a5_of_surj {X H : Type*} [Group X] [Group H] (hX : commutator X = ⊤)
    (f : X →* H) (hf : Function.Surjective f) (hk : f.ker ≤ Subgroup.center X)
    (hno : ¬ Nonempty ((X ⧸ Subgroup.center X) ≃* alternatingGroup (Fin 5))) :
    ¬ Nonempty ((H ⧸ Subgroup.center H) ≃* alternatingGroup (Fin 5)) := by
  rintro ⟨eA⟩
  obtain ⟨e⟩ := CFSG.HardMathSupport.Solomon.Coordinator.LieComp.nonempty_centralQuotient_mulEquiv
    hX f hf hk
  exact hno ⟨e.trans eA⟩

theorem not_a5_of_mulEquiv {X H : Type*} [Group X] [Group H] (e : X ≃* H)
    (hno : ¬ Nonempty ((X ⧸ Subgroup.center X) ≃* alternatingGroup (Fin 5))) :
    ¬ Nonempty ((H ⧸ Subgroup.center H) ≃* alternatingGroup (Fin 5)) := by
  rintro ⟨eA⟩
  exact hno ⟨(InputsL33.centerQuotCongr e).trans eA⟩

theorem not_a5_of_equiv_sl_two {E : Type} [Field E] [Finite E] (hE : 8 ≤ Nat.card E)
    {G : Type} [Group G] (e : Matrix.SpecialLinearGroup (Fin 2) E ≃* G) :
    ¬ Nonempty ((G ⧸ Subgroup.center G) ≃* alternatingGroup (Fin 5)) := fun hL => by
  have := (Claims1110h.sl_a5 le_rfl e.toMonoidHom e.surjective
    (InputsL33c.ker_mulEquiv_le_center e) hL).2
  omega

theorem sp_a5_false {K : Type} [Field K] [Finite K] {s : ℕ} (hs : 2 ≤ s)
    (hq : CFSG.IsQuasisimple (StatedSp s K)) {T : Type*} [Group T] (g : ↥(StatedSp s K) →* T)
    (hg : Function.Surjective g) (hker : g.ker ≤ Subgroup.center _)
    (hL : Nonempty ((T ⧸ Subgroup.center T) ≃* alternatingGroup (Fin 5))) : False := by
  obtain ⟨e⟩ := CFSG.HardMathSupport.Solomon.Coordinator.LieComp.nonempty_centralQuotient_mulEquiv
    hq.1.commutator_eq_top g hg hker
  obtain ⟨eA⟩ := hL
  have hZ : Nat.card ↥(Subgroup.center (StatedSp s K)) = Nat.gcd 2 (Nat.card K - 1) := by
    rw [CFSG.LieType.Universal.Symplectic.center_eq]
    exact CFSG.LocalAnalysis.ComponentInitial.card_spScalars_eq_gcd K (by omega)
  have hcard : Nat.card (StatedSp s K) = 60 * Nat.gcd 2 (Nat.card K - 1) := by
    rw [(Subgroup.center (StatedSp s K)).card_eq_card_quotient_mul_card_subgroup,
      Nat.card_congr (e.trans eA).toEquiv, Claims1110h.card_alt_five, hZ]
  have hdvd : Nat.card K ^ (s ^ 2) ∣ 60 * Nat.gcd 2 (Nat.card K - 1) := by
    rw [← hcard, CFSG.LocalAnalysis.ComponentInitial.SymplecticFlag.card_statedSp]
    exact Dvd.intro _ rfl
  have hg2 : 60 * Nat.gcd 2 (Nat.card K - 1) ∣ 120 :=
    (Nat.mul_dvd_mul_left 60 (Nat.gcd_dvd_left 2 _)).trans (by norm_num)
  have h120 : Nat.card K ^ (s ^ 2) ∣ 120 := hdvd.trans hg2
  have h4 : Nat.card K ^ 4 ∣ 120 :=
    (pow_dvd_pow _ (by nlinarith : 4 ≤ s ^ 2)).trans h120
  have hK2 : 2 ≤ Nat.card K := by
    haveI : Fintype K := Fintype.ofFinite K
    rw [Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  have hle : Nat.card K ^ 4 ≤ 120 := Nat.le_of_dvd (by norm_num) h4
  have hK3 : Nat.card K ≤ 3 := by
    by_contra hlt
    push Not at hlt
    have : 4 ^ 4 ≤ Nat.card K ^ 4 := Nat.pow_le_pow_left hlt 4
    omega
  interval_cases h : Nat.card K <;> norm_num at h4

theorem not_a5_of_center_eq_bot {X : Type*} [Group X] (hZ : Subgroup.center X = ⊥)
    (hX : Nat.card X ≠ 60) : ¬ Nonempty ((X ⧸ Subgroup.center X) ≃* alternatingGroup (Fin 5)) :=
  fun ⟨e⟩ => hX (by
    rw [← Nat.card_congr ((QuotientGroup.quotientMulEquivOfEq hZ).trans
      QuotientGroup.quotientBot).toEquiv, Nat.card_congr e.toEquiv, Claims1110h.card_alt_five])

theorem five_dvd_card_of_a5 {T : Type*} [Group T] [Finite T]
    (hA : Nonempty ((T ⧸ Subgroup.center T) ≃* alternatingGroup (Fin 5))) : 5 ∣ Nat.card T :=
  (by norm_num : 5 ∣ 60).trans (Claims1110h.sixty_dvd_card hA)

