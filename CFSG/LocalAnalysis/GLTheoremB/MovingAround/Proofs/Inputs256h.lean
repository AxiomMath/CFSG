theorem a5Good_spSupported_of_factor_two [Finite K] (hK : Nat.card K = 2) {x : StatedSp r K}
    (hx : x ^ 3 = 1) {a : StatedProj (StatedSp r K)} (blocks : SpPrimaryBlocks 2 1 3 x a)
    (h : primaryFactors (spEnd x)) :
    A5Good ↥(spSupported x {(h : K[X]), reciprocalPolynomial (h : K[X])}) := by
  haveI := Fintype.ofFinite K
  have hmin : minpoly K (spEnd x) ∣ X ^ 3 - C 1 := by
    refine minpoly.dvd K _ ?_
    rw [map_sub, map_pow, aeval_X, aeval_C, map_one, spEnd_pow hx, sub_self]
  have hdvd : ∀ g ∈ primaryFactors (spEnd x), g ∣ X ^ 3 - C 1 := fun g hg =>
    (mem_primaryFactors.1 hg).2.2.trans hmin
  have hX3 : (X ^ 3 - C 1 : K[X]) ≠ 0 := X_pow_sub_C_ne_zero (by norm_num) 1
  have hdeg3 : ∀ g ∈ primaryFactors (spEnd x), g.natDegree ≤ 3 := fun g hg =>
    (natDegree_le_of_dvd (hdvd g hg) hX3).trans (by rw [natDegree_X_pow_sub_C])
  have hd1 : 1 ≤ (h : K[X]).natDegree :=
    Irreducible.natDegree_pos (irreducible_of_mem_primaryFactors h.2)
  by_cases hself : reciprocalPolynomial (h : K[X]) = h
  · have hO' : ({(h : K[X]), reciprocalPolynomial (h : K[X])} : Set K[X]) = {(h : K[X])} := by
      rw [hself, Set.pair_eq_singleton]
    rw [hO']
    by_cases h1 : (h : K[X]) = X - 1
    · obtain ⟨h0, hm⟩ := h
      change h0 = X - 1 at h1
      subst h1
      obtain ⟨φ, -⟩ := blocks.fixedFactor hm
      have hsq : Squarefree (minpoly K (spEnd x)) := by
        have hpK : ((3 : ℕ) : K) ≠ 0 := by
          haveI : CharP K 2 := charP_of_card_eq_prime_pow (f := 1)
            (by rw [Fintype.card_eq_nat_card, hK]; norm_num)
          intro h3
          rw [CharP.cast_eq_zero_iff K 2] at h3
          omega
        exact (altPrimaryData_spLin hpK hx).squarefree
      have : Nontrivial (primaryComponent (spEnd x) (X - 1)) :=
        Submodule.nontrivial_iff_ne_bot.mpr (primaryComponent_ne_bot hsq hm)
      obtain ⟨s, hs, ⟨e⟩⟩ := exists_mulEquiv_sesqUnitaryGroup_statedSp
        (B := (spForm r K).restrict (primaryComponent (spEnd x) (X - 1)))
        (fun v => spForm_isAlt (v : Fin r ⊕ Fin r → K)) blocks.fixed_nondegenerate
      have hs1 : 1 ≤ s := by
        have := Module.finrank_pos (R := K) (M := primaryComponent (spEnd x) (X - 1))
        omega
      exact A5Good.of_mulEquiv (φ.trans e) (a5Good_statedSp_two hK hs1)
    · obtain ⟨d, hd, -, σ, -, -, -, -, -, hE, -, Hf, hHf, hHfl, -, -, φ, -⟩ :=
        (blocks.selfDual h h1 hself).exists_half
      have hd1' : d = 1 := by
        have := hdeg3 h h.2
        omega
      subst hd1'
      exact A5Good.of_mulEquiv φ (a5Good_sesqUnitaryGroup_two hE (by norm_num) hHf hHfl)
  · exfalso
    have hP := blocks.paired h (fun e => hself e.symm)
    have hr' : reciprocalPolynomial (h : K[X]) ∈ primaryFactors (spEnd x) := blocks.bijOn.mapsTo h.2
    have hcop := isCoprime_of_mem_primaryFactors h.2 hr' (fun e => hself e.symm)
    have hmul : (h : K[X]) * reciprocalPolynomial (h : K[X]) ∣ X ^ 3 - C 1 :=
      hcop.mul_dvd (hdvd _ h.2) (hdvd _ hr')
    have hdeg := natDegree_le_of_dvd hmul hX3
    rw [natDegree_mul (irreducible_of_mem_primaryFactors h.2).ne_zero
      (irreducible_of_mem_primaryFactors hr').ne_zero, ← hP.natDegree_eq,
      natDegree_X_pow_sub_C] at hdeg
    have h1' : (h : K[X]).natDegree = 1 := by omega
    have h3 := hP.dvd
    rw [h1'] at h3
    norm_num at h3

theorem noA5_conj_sp_two [Finite K] (hK : Nat.card K = 2) (hr : 3 ≤ r) (x : StatedSp r K)
    (hx : x ^ 3 = 1) (K' : Subgroup (StatedProj (StatedSp r K)))
    (hK' : IsComponentOf K' (fixSubgroup (MulAut.conj (SymplecticFlag.proj r K x)))) :
    ¬ Nonempty ((↥K' ⧸ Subgroup.center ↥K') ≃* alternatingGroup (Fin 5)) := by
  classical
  haveI := Fintype.ofFinite K
  have hcardK : Fintype.card K = 2 ^ 1 := by rw [Fintype.card_eq_nat_card, hK]; norm_num
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : CharP K 2 := charP_of_card_eq_prime_pow (f := 1) hcardK
  have hZc : (SymplecticFlag.proj r K).ker ≤ Subgroup.center (StatedSp r K) := by
    rw [SymplecticHigher.ker_proj]
    exact SymplecticHigher.spScalars_le_center
  obtain ⟨ι, hι, A, hc, hjoin, hgood⟩ : ∃ (ι : Type) (_ : Finite ι)
      (A : ι → Subgroup (StatedSp r K)),
      (∀ i j, i ≠ j → ∀ a ∈ A i, ∀ b ∈ A j, Commute a b) ∧
      ⨆ i, A i = Subgroup.centralizer ({x} : Set (StatedSp r K)) ∧ ∀ i, A5Good ↥(A i) := by
    by_cases hx1 : x = 1
    · subst hx1
      refine ⟨Unit, inferInstance, fun _ => ⊤, fun i j hij => absurd (Subsingleton.elim i j) hij,
        ?_, fun _ => A5Good.of_mulEquiv Subgroup.topEquiv (a5Good_statedSp_two hK (by omega))⟩
      ext g
      simp [Subgroup.mem_centralizer_iff]
    · have blocks := CFSG.HardMathSupport.Timmesfeld.CrossChar.spBlocks_three_two hK hr hx hx1
      haveI : Finite (reciprocalOrbits (spEnd x)) :=
        (Set.Finite.image _ (Finset.finite_toSet _)).to_subtype
      obtain ⟨hcomm, -, hjoin⟩ := blocks.directProduct
      refine ⟨reciprocalOrbits (spEnd x), inferInstance,
        fun O => spSupported x (O : Set K[X]),
        fun i j hij a ha b hb => hcomm i.1 i.2 j.1 j.2 (fun h => hij (Subtype.ext h)) a ha b hb,
        hjoin, ?_⟩
      rintro ⟨O, h, hh, rfl⟩
      exact a5Good_spSupported_of_factor_two hK hx blocks ⟨h, hh⟩
  haveI := hι
  obtain ⟨i, hq, rfl⟩ :=
    CFSG.HardMathSupport.Solomon.Coordinator.LieComp.components_conj_of_orbit_family
      (SymplecticFlag.proj r K) SymplecticHigher.proj_surjective hZc x A hc hjoin
      (fun i => tame_of_a5Good _ (hgood i)) K' hK'
  refine not_a5_of_surj hq.1.commutator_eq_top
    ((SymplecticFlag.proj r K).subgroupMap ⁅A i, A i⁆)
    (MonoidHom.subgroupMap_surjective _ _) (fun d hd => ?_)
    (not_a5_of_a5Good _ (hgood i) hq)
  have h1 : SymplecticFlag.proj r K (d : StatedSp r K) = 1 := congrArg Subtype.val hd
  have h2 : (d : StatedSp r K) ∈ Subgroup.center (StatedSp r K) := hZc h1
  rw [Subgroup.mem_center_iff]
  intro y
  exact Subtype.ext (Subgroup.mem_center_iff.1 h2 y)

theorem noA5_psp_two {S : Type} [Group S] [Finite S] [IsSimpleGroup S]
    (hna : ∃ a b : S, a * b ≠ b * a) {ℓ f : ℕ} (hm : StatedClassicalModel S .PSp r ℓ f)
    (h2 : ℓ ^ f = 2) (hr3 : 3 ≤ r) {α : MulAut S} (hα : α ^ 3 = 1) {K₀ : Subgroup S}
    (hK₀ : IsComponentOf K₀ (fixSubgroup α)) :
    ¬ Nonempty ((↥K₀ ⧸ Subgroup.center ↥K₀) ≃* alternatingGroup (Fin 5)) := by
  obtain ⟨-, k, _, _, hk, ⟨e'⟩⟩ := hm
  have hk2 : Nat.card k = 2 := by rw [hk, h2]
  haveI : Finite (StatedProj (StatedSp r k)) := Finite.of_equiv S e'.toEquiv
  obtain ⟨x, hx⟩ :=
    CFSG.HardMathSupport.Timmesfeld.CrossChar.exists_spInnerLift_eq hk2 hr3 (MulAut.congr e' α)
  have hZ : Subgroup.center (StatedProj (StatedSp r k)) = ⊥ := by
    rw [← Subgroup.map_center_eq e', InputsL33c.center_eq_bot_of_simple hna, Subgroup.map_bot]
  have hinj := CFSG.SeitzReduction.mulAut_conj_injective_of_center_eq_bot hZ
  have hιinj := CFSG.HardMathSupport.Timmesfeld.CrossChar.ker_spInnerLift_eq_bot hk2 hr3 hinj
  have hx3 : x ^ 3 = 1 := hιinj (by rw [map_pow, ← hx, ← map_pow, hα, map_one, map_one])
