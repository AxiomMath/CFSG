theorem gen3D44Model_holds : Gen3D44Model := by
  intro kf _ _ σ δ hkf hσ hδ
  have : CharP kf 2 := charP_two hkf
  have : Fact (Nat.Prime 7) := ⟨by norm_num⟩
  set C := graphFixedRootGroup TwistTag.D4 kf σ.toRingHom with hC
  have hσ3 : ∀ c, σ (σ (σ c)) = c := fun c => by
    rw [hσ, hσ, hσ, ← pow_mul, ← pow_mul]
    exact pow_64 hkf c
  have hδ2 : ∀ c, δ (δ c) = c := sigma_sigma hkf hδ
  have hδσ : ∀ c, δ (σ.toRingHom c) = σ.toRingHom (δ c) := fun c => ringEquiv_comm_of_finite σ δ c
  have hmem : ∀ c : kf, c ∈ orbitField TwistTag.D4 kf σ.toRingHom a₀ := fun c => by
    rw [orbitField_D4_zero_eq_top σ hσ3]
    exact Subfield.mem_top c
  set L := orbitField TwistTag.D4 kf σ.toRingHom a₀ with hL
  set δL : L ≃+* L := orbitFieldRestrict TwistTag.D4 σ δ a₀ with hδL
  have hδL2 : ∀ c, δL.toRingHom (δL.toRingHom c) = c := fun c => Subtype.ext (hδ2 c)
  obtain ⟨ω, hω⟩ := exists_cube_root hkf
  obtain ⟨l, hl7, hl1⟩ := exists_seventh_root hkf
  have hl0 : l ≠ 0 := by
    rintro rfl
    norm_num at hl7
  set ωL : L := ⟨ω, hmem ω⟩ with hωL_def
  have hωL : ωL ^ 2 + ωL + 1 = 0 := Subtype.ext (by simpa [hωL_def] using hω)
  have hδωL : δL.toRingHom ωL = ωL ^ 2 := Subtype.ext (by
    change δ ω = ω ^ 2
    exact sigma_cube_root hδ hω)
  set u : Lˣ := Units.mk0 ⟨l, hmem l⟩ (fun h => hl0 (congrArg Subtype.val h)) with hu_def
  have hu1 : u ≠ 1 := fun h => hl1 (congrArg (fun v : Lˣ => ((v : L) : kf)) h)
  have hu7 : u ^ 7 = 1 := Units.ext (Subtype.ext (by simpa [hu_def] using hl7))
  have hδu : δL.toRingHom (u : L) = u := Subtype.ext (by
    change δ l = l
    exact sigma_seventh_root hδ hl7)
  set R := orbitRankOneHom TwistTag.D4 kf σ.toRingHom a₀ with hR
  have hsurj : Function.Surjective σ.toRingHom := σ.surjective
  have hle : orbitRankOneGroup TwistTag.D4 kf σ.toRingHom a₀ ≤ C := by
    rw [hC, graphFixedRootGroup_eq_iSup_orbitRankOneGroup hsurj]
    exact le_iSup (orbitRankOneGroup TwistTag.D4 kf σ.toRingHom) a₀
  have hRC : ∀ g, R g ∈ C := fun g => by
    have h1 : R g ∈ R.range := ⟨g, rfl⟩
    rw [hR, orbitRankOneHom_range] at h1
    exact hle h1
  have hcompat : ∀ g, Units.map (entrywiseHom δ.toRingHom) (R g) =
      R (Matrix.SpecialLinearGroup.map δL.toRingHom g) := by
    have heq := MonoidHom.eq_of_eqOn_dense closure_uSL_vSL
      (f := (Units.map (entrywiseHom δ.toRingHom)).comp R)
      (g := R.comp (Matrix.SpecialLinearGroup.map δL.toRingHom)) (by
        rintro _ (⟨s, rfl⟩ | ⟨s, rfl⟩)
        · simp only [MonoidHom.comp_apply]
          rw [hR, orbitRankOneHom_uSL, map_uSL, orbitRankOneHom_uSL,
            units_map_entrywiseHom_orbitX hδσ]
          rfl
        · simp only [MonoidHom.comp_apply]
          rw [hR, orbitRankOneHom_vSL, map_vSL, orbitRankOneHom_vSL,
            units_map_entrywiseHom_orbitY hδσ]
          rfl)
    exact fun g => DFunLike.congr_fun heq g
  set xC : C := ⟨R (sl2X ωL u), hRC _⟩ with hxC
  set H : Subgroup C := Subgroup.closure ({g : C |
    Units.map (entrywiseHom δ.toRingHom) (g : ModGL TwistTag.D4.tag kf) =
      (g : ModGL TwistTag.D4.tag kf)} ∪ {xC}) with hH
  set H₀ : Subgroup (ModGL TwistTag.D4.tag kf) := H.map C.subtype with hH₀
  have hfixH₀ : ∀ g (hg : g ∈ C), Units.map (entrywiseHom δ.toRingHom) g = g → g ∈ H₀ :=
    fun g hg hfix => ⟨⟨g, hg⟩, Subgroup.subset_closure (Or.inl hfix), rfl⟩
  have hxH₀ : R (sl2X ωL u) ∈ H₀ := ⟨xC, Subgroup.subset_closure (Or.inr rfl), rfl⟩
  have hS : H₀.comap R = ⊤ := by
    refine sl2_eq_top hδL2 hωL hδωL hu1 hδu _ (fun s hs => ?_) (fun s hs => ?_) hxH₀
    · show R (U₂ s) ∈ H₀
      rw [hR, orbitRankOneHom_uSL]
      refine hfixH₀ _ (graphFixedPosUnipotent_le_graphFixedRootGroup _ _ _
        (orbitX_mem_graphFixedPosUnipotent _ _ a₀ s)) ?_
      have hs' : (⟨δ (s : kf), map_mem_orbitField hδσ s.2⟩ : L) = s :=
        Subtype.ext (congrArg Subtype.val hs)
      rw [units_map_entrywiseHom_orbitX hδσ, hs']
    · show R (vSL s) ∈ H₀
      rw [hR, orbitRankOneHom_vSL]
      refine hfixH₀ _ (graphFixedNegUnipotent_le_graphFixedRootGroup _ _ _
        (orbitY_mem_graphFixedNegUnipotent _ _ a₀ s)) ?_
      have hs' : (⟨δ (s : kf), map_mem_orbitField hδσ s.2⟩ : L) = s :=
        Subtype.ext (congrArg Subtype.val hs)
      rw [units_map_entrywiseHom_orbitY hδσ, hs']
  have hRall : ∀ g, R g ∈ H₀ := fun g => by
    have : g ∈ H₀.comap R := hS ▸ Subgroup.mem_top g
    exact this
  have hx1 : xUnit TwistTag.D4.tag kf (ν 2) 1 ∈ H₀ := by
    have h1 : (1 : kf) ∈ orbitField TwistTag.D4 kf σ.toRingHom a₁ :=
      (orbitField TwistTag.D4 kf σ.toRingHom a₁).one_mem
    rw [show (1 : kf) = ((⟨1, h1⟩ : orbitField TwistTag.D4 kf σ.toRingHom a₁) : kf) from rfl,
      ← coe_orbitX_one]
    refine hfixH₀ _ (graphFixedPosUnipotent_le_graphFixedRootGroup _ _ _
      (orbitX_mem_graphFixedPosUnipotent _ _ a₁ _)) ?_
    rw [units_map_entrywiseHom_orbitX hδσ]
    congr 2
    exact Subtype.ext (map_one δ)
  have hy1 : yUnit TwistTag.D4.tag kf (ν 2) (-1) ∈ H₀ := by
    have h1 : (-1 : kf) ∈ orbitField TwistTag.D4 kf σ.toRingHom a₁ :=
      (orbitField TwistTag.D4 kf σ.toRingHom a₁).neg_mem
        (orbitField TwistTag.D4 kf σ.toRingHom a₁).one_mem
    rw [show (-1 : kf) = ((⟨-1, h1⟩ : orbitField TwistTag.D4 kf σ.toRingHom a₁) : kf) from rfl,
      ← coe_orbitY_one]
    refine hfixH₀ _ (graphFixedNegUnipotent_le_graphFixedRootGroup _ _ _
      (orbitY_mem_graphFixedNegUnipotent _ _ a₁ _)) ?_
    rw [units_map_entrywiseHom_orbitY hδσ]
    congr 2
    exact Subtype.ext (by simp)
  have hx2 : ∀ b : kf, σ b = b → xUnit TwistTag.D4.tag kf (ν 2) b ∈ H₀ := by
    intro b hb
    by_cases hb0 : b = 0
    · rw [hb0, xUnit_zero]
      exact one_mem _
    have hb3 : b ^ 3 = 1 := by
      have h4 : b ^ 4 = b := by rw [← hσ]; exact hb
      have : b * (b ^ 3 - 1) = 0 := by linear_combination h4
      exact sub_eq_zero.1 ((mul_eq_zero.1 this).resolve_left hb0)
    obtain ⟨z, hz⟩ := IsCyclic.exists_generator (α := kfˣ)
    have hzo : orderOf z = 63 := by
      rw [orderOf_eq_card_of_forall_mem_zpowers hz, Nat.card_units, hkf]
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 (hz (Units.mk0 b hb0))
    have h21 : (21 : ℤ) ∣ k := by
      have h1 : z ^ (k * 3) = 1 := by
        rw [zpow_mul, hk]
        exact Units.ext (by simp [hb3])
      have h2 := orderOf_dvd_iff_zpow_eq_one.2 h1
      rw [hzo] at h2
      omega
    obtain ⟨j, rfl⟩ := h21
    set w : kfˣ := z ^ (-j) with hw
    have hw21 : (w : kf) ^ 21 = b⁻¹ := by
      have : w ^ 21 = (Units.mk0 b hb0)⁻¹ := by
        rw [hw, ← zpow_natCast, ← zpow_mul, show -j * ((21 : ℕ) : ℤ) = -(21 * j) by push_cast; ring,
          zpow_neg, hk]
      rw [← Units.val_pow_eq_pow_val, this, Units.val_inv_eq_inv_val, Units.val_mk0]
    set wL : Lˣ := Units.mk0 ⟨(w : kf), hmem _⟩ (fun h => w.ne_zero (congrArg Subtype.val h))
      with hwL
    have hconj := orbitH_conj_xUnit_two (σ := σ.toRingHom) wL 1
    have hN : (((wL : L) : kf) * σ.toRingHom ((wL : L) : kf) *
        σ.toRingHom (σ.toRingHom ((wL : L) : kf)))⁻¹ * 1 = b := by
      change ((w : kf) * σ (w : kf) * σ (σ (w : kf)))⁻¹ * 1 = b
      rw [hσ, hσ, ← pow_mul, show (w : kf) * (w : kf) ^ 4 * (w : kf) ^ (4 * 4) = (w : kf) ^ 21 by
        ring, hw21, inv_inv, mul_one]
    rw [hN] at hconj
    rw [← hconj]
    refine mul_mem (mul_mem ?_ hx1) (inv_mem ?_) <;>
    · rw [← orbitRankOneHom_HSL]
      exact hRall _
  have hn2 : weylElt TwistTag.D4.tag kf (ν 2) 1 ∈ H₀ := by
    rw [weylElt_eq_xUnit_mul, inv_one, Units.val_one]
    exact mul_mem (mul_mem hx1 hy1) hx1
  have hy2 : ∀ b : kf, σ b = b → yUnit TwistTag.D4.tag kf (ν 2) b ∈ H₀ := by
    intro b hb
    rw [← neg_neg b, ← weylElt_mul_xUnit_mul_inv]
    exact mul_mem (mul_mem hn2 (hx2 _ (by rw [map_neg, hb]))) (inv_mem hn2)
  have hCle : C ≤ H₀ := by
    rw [hC, graphFixedRootGroup_eq_iSup_orbitRankOneGroup hsurj]
    refine iSup_le fun a => (Subgroup.closure_le _).2 ?_
    obtain ⟨n, hn⟩ := a
    have hn2 : n < 2 := hn
    interval_cases n
    · rintro _ (⟨c, rfl⟩ | ⟨c, rfl⟩) <;> dsimp only
      · rw [← orbitRankOneHom_uSL]
        exact hRall _
      · rw [← orbitRankOneHom_vSL]
        exact hRall _
    · rintro _ (⟨c, rfl⟩ | ⟨c, rfl⟩) <;> dsimp only
      · rw [coe_orbitX_one]
        exact hx2 _ ((mem_orbitField_D4_one σ).1 c.2)
      · rw [coe_orbitY_one]
        exact hy2 _ ((mem_orbitField_D4_one σ).1 c.2)
  refine ⟨xC, ?_, ?_, ?_⟩
  · apply orderOf_eq_prime
    · apply Subtype.ext
      change R (sl2X ωL u) ^ 7 = 1
      rw [← map_pow, sl2X_pow_seven hu7, map_one]
    · intro h
      have h1 : R (sl2X ωL u) = 1 := congrArg Subtype.val h
      obtain ⟨c, hc2, hc⟩ := eq_smul_one_of_mem_ker_orbitRankOneHom (MonoidHom.mem_ker.2 h1)
      have hc1 : (c : L) = 1 := eq_of_sq_eq (by rw [hc2, one_pow])
