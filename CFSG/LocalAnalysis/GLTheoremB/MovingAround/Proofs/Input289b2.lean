    rw [hcompat, map_sl2X hωL hδωL hδu, map_inv]
  · rw [eq_top_iff]
    intro g _
    obtain ⟨h, hh, hgh⟩ := hCle g.2
    have : h = g := Subtype.ext hgh
    rw [← this]
    exact hh

