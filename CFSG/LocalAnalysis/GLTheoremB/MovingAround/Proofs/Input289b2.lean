theorem conj_of_isLThreeFour {D J : Subgroup K} (hDel : IsElemAbelian 3 D) (hD9 : Nat.card D = 9)
    (hDJ : D ≤ J) (hJ : IsLThreeFour (barOf 3 J)) :
    ∀ d₁ ∈ D, ∀ d₂ ∈ D, d₁ ≠ 1 → d₂ ≠ 1 → ∃ g : K, g * d₁ * g⁻¹ = d₂ := by
  intro d₁ hd₁ d₂ hd₂ h1 h2
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  set N : Subgroup ↥J := GLAPPrimeCore 3 ↥J with hN
  have hNcop : Nat.Coprime 3 (Nat.card N) := CFSG.pPrimeCore_coprime_card (p := 3) (G := ↥J)
  have hN3 : ¬ 3 ∣ Nat.card N := (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).1 hNcop
  set π : ↥J →* barOf 3 J := QuotientGroup.mk' N with hπ
  obtain ⟨k, _, _, hk, ⟨e⟩⟩ := hJ
  set φ : barOf 3 J ≃* projectiveSL 3 k := e.trans (CFSG.HardMathSupport.Solomon.Coordinator.psiO k)
    with hφ
  set D' : Subgroup ↥J := D.subgroupOf J with hD'
  have hD'p : IsPGroup 3 ↥D' := by
    intro g
    refine ⟨1, ?_⟩
    apply Subtype.ext
    apply Subtype.ext
    simpa using hDel.2 _ (Subgroup.mem_subgroupOf.1 g.2)
  have hD'N : D' ⊓ N = ⊥ := inf_eq_bot_of_coprime' hNcop hD'p
  have hmemN : ∀ x ∈ D', π x = 1 → x = 1 := by
    intro x hx hπx
    have hxN : x ∈ N := (QuotientGroup.eq_one_iff x).1 hπx
    have : x ∈ D' ⊓ N := ⟨hx, hxN⟩
    rw [hD'N] at this
    exact this
  set ψ : ↥D' →* projectiveSL 3 k := φ.toMonoidHom.comp (π.comp D'.subtype) with hψ
  have hψinj : Function.Injective ψ := by
    rw [injective_iff_map_eq_one]
    intro x hx
    have h1 : π x = 1 := φ.injective (by simpa [hψ] using hx)
    exact Subtype.ext (hmemN x x.2 h1)
  set E : Subgroup (projectiveSL 3 k) := ψ.range with hE
  have hE9 : Nat.card E = 9 := by
    rw [hE, ← hD9, ← Nat.card_congr (MonoidHom.ofInjective hψinj).toEquiv]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hDJ).toEquiv
  set x₁ : ↥J := ⟨d₁, hDJ hd₁⟩ with hx₁
  set x₂ : ↥J := ⟨d₂, hDJ hd₂⟩ with hx₂
  have hx₁D : x₁ ∈ D' := Subgroup.mem_subgroupOf.2 hd₁
  have hx₂D : x₂ ∈ D' := Subgroup.mem_subgroupOf.2 hd₂
  have hψ₁ : ψ ⟨x₁, hx₁D⟩ ∈ E := ⟨_, rfl⟩
  have hψ₂ : ψ ⟨x₂, hx₂D⟩ ∈ E := ⟨_, rfl⟩
  have hne₁ : ψ ⟨x₁, hx₁D⟩ ≠ 1 := by
    intro h
    have := hψinj (h.trans (map_one ψ).symm)
    apply h1
    have := congrArg (fun z : ↥D' => ((z : ↥J) : K)) this
    simpa [hx₁] using this
  have hne₂ : ψ ⟨x₂, hx₂D⟩ ≠ 1 := by
    intro h
    have := hψinj (h.trans (map_one ψ).symm)
    apply h2
    have := congrArg (fun z : ↥D' => ((z : ↥J) : K)) this
    simpa [hx₂] using this
  obtain ⟨g, hg⟩ := exists_conj_of_card_nine hk hE9 hψ₁ hψ₂ hne₁ hne₂
  obtain ⟨w, hw⟩ := QuotientGroup.mk'_surjective N (φ.symm g)
  have hgw : φ (π w) = g := by
    change φ (QuotientGroup.mk' N w) = g
    rw [hw, MulEquiv.apply_symm_apply]
  have hπ : π (w * x₁ * w⁻¹) = π x₂ := by
    apply φ.injective
    have e1 : ψ ⟨x₁, hx₁D⟩ = φ (π x₁) := rfl
    have e2 : ψ ⟨x₂, hx₂D⟩ = φ (π x₂) := rfl
    rw [map_mul, map_mul, map_inv, map_mul, map_mul, map_inv, hgw, ← e1, ← e2, hg]
  have hyw : x₂⁻¹ * (w * x₁ * w⁻¹) ∈ N := by
    rw [← QuotientGroup.eq_one_iff]
    change π (x₂⁻¹ * (w * x₁ * w⁻¹)) = 1
    rw [map_mul, map_inv, hπ, inv_mul_cancel]
  have ho₂ : orderOf x₂ = 3 := by
    rw [← Subgroup.orderOf_coe]
    exact orderOf_eq_three_of_mem hDel hd₂ h2
  have ho₁ : orderOf (w * x₁ * w⁻¹) = 3 := by
    rw [← MulAut.conj_apply, MulEquiv.orderOf_eq, ← Subgroup.orderOf_coe]
    exact orderOf_eq_three_of_mem hDel hd₁ h1
  obtain ⟨m, hm⟩ := exists_conj_of_mk_eq N hN3 ho₂ ho₁ hyw
  refine ⟨((m * w : ↥J) : K), ?_⟩
  have e : ((m * w : ↥J) : K) * d₁ * ((m * w : ↥J) : K)⁻¹ =
      ((m * (w * x₁ * w⁻¹) * m⁻¹ : ↥J) : K) := by
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, hx₁, mul_inv_rev, mul_assoc]
  rw [e, hm]

end ConjJ

section Statement

@[expose] def AutFacts (P : TauCeti.LieTypeIndex → Prop) : Prop :=
  ∀ (K : Type) [Group K] [Finite K], IsCatalogLieIso K P →
    ∀ D J : Subgroup K, IsElemAbelian 3 D → Nat.card D = 9 → D ≤ J → IsLThreeFour (barOf 3 J) →
    ∀ X : Subgroup (MulAut K), IsPGroup 2 X →
      (∀ d ∈ D, MulAut.conj d ∈ Subgroup.normalizer (X : Set (MulAut K))) →
      X = ⊥ ∨ ∃ τ : MulAut K, X = Subgroup.zpowers τ ∧ τ * τ = 1 ∧
        ∃ x : K, orderOf x = 7 ∧ τ x = x⁻¹ ∧ Subgroup.closure ({k | τ k = k} ∪ {x}) = ⊤

end Statement

section Transport

variable {G H : Type*} [Group G] [Group H]

theorem mem_normalizer_map_equiv (ψ : G ≃* H) {S : Subgroup G} {e : G}
    (he : e ∈ Subgroup.normalizer (S : Set G)) :
    ψ e ∈ Subgroup.normalizer ((S.map ψ.toMonoidHom : Subgroup H) : Set H) := by
  rw [Subgroup.mem_normalizer_iff] at he ⊢
  intro h
  rw [Subgroup.mem_map_equiv, Subgroup.mem_map_equiv]
  have := he (ψ.symm h)
  simpa [map_mul, map_inv] using this

theorem congr_conj (θ : G ≃* H) (g : G) :
    MulAut.congr θ (MulAut.conj g) = MulAut.conj (θ g) := by
  ext h
  simp [MulAut.congr_apply, MulAut.conj_apply, map_mul, map_inv]

theorem eq_one_or_of_mem_zpowers {M : Type*} [Group M] {τ : M} (h : τ * τ = 1) {m : M}
    (hm : m ∈ Subgroup.zpowers τ) : m = 1 ∨ m = τ := by
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 hm
  have h2 : τ ^ (2 : ℤ) = 1 := by rw [zpow_two]; exact h
  rcases Int.even_or_odd' n with ⟨k, rfl | rfl⟩
  · left; rw [zpow_mul, h2, one_zpow]
  · right; rw [zpow_add, zpow_mul, h2, one_zpow, one_mul, zpow_one]

theorem autFacts_concl_of_equiv (θ : G ≃* H) {X : Subgroup (MulAut G)}
    (h : X.map (MulAut.congr θ).toMonoidHom = ⊥ ∨
      ∃ τ : MulAut H, X.map (MulAut.congr θ).toMonoidHom = Subgroup.zpowers τ ∧ τ * τ = 1 ∧
        ∃ x : H, orderOf x = 7 ∧ τ x = x⁻¹ ∧ Subgroup.closure ({k | τ k = k} ∪ {x}) = ⊤) :
    X = ⊥ ∨ ∃ τ : MulAut G, X = Subgroup.zpowers τ ∧ τ * τ = 1 ∧
      ∃ x : G, orderOf x = 7 ∧ τ x = x⁻¹ ∧ Subgroup.closure ({k | τ k = k} ∪ {x}) = ⊤ := by
  set Φ := MulAut.congr θ with hΦ
  have hX : X = (X.map Φ.toMonoidHom).map Φ.symm.toMonoidHom := by
    rw [Subgroup.map_map]
    have : Φ.symm.toMonoidHom.comp Φ.toMonoidHom = MonoidHom.id _ := by ext; simp
    rw [this, Subgroup.map_id]
  rcases h with hbot | ⟨τ, hXτ, hτ2, x, hx7, hτx, hgen⟩
  · left
    rw [hX, hbot, Subgroup.map_bot]
  · right
    have hτ' : ∀ k : G, (Φ.symm τ) k = θ.symm (τ (θ k)) := fun k => by
      rw [hΦ, MulAut.congr_symm_apply]
      rfl
    refine ⟨Φ.symm τ, ?_, ?_, θ.symm x, ?_, ?_, ?_⟩
    · rw [hX, hXτ, MonoidHom.map_zpowers]
      rfl
    · rw [← map_mul, hτ2, map_one]
    · rw [MulEquiv.orderOf_eq, hx7]
    · rw [hτ', MulEquiv.apply_symm_apply, hτx, map_inv]
    · apply Subgroup.map_injective (f := θ.toMonoidHom) θ.injective
      rw [Subgroup.map_top_of_surjective _ θ.surjective, MonoidHom.map_closure, eq_top_iff, ← hgen]
      apply Subgroup.closure_mono
      intro p hp
      rcases hp with hp | hp
      · refine ⟨θ.symm p, Or.inl ?_, by simp⟩
        show (Φ.symm τ) (θ.symm p) = θ.symm p
        rw [hτ', MulEquiv.apply_symm_apply]
        exact congrArg θ.symm hp
      · refine ⟨θ.symm x, Or.inr rfl, ?_⟩
        rw [Set.mem_singleton_iff.1 hp]
        simp

end Transport

section Cover

variable {Y : Type} [Group Y] [Finite Y]

theorem conjNormal_mem_normalizer {K : Subgroup Y} [K.Normal] {T : Subgroup Y} {g : Y}
    (hg : g ∈ Subgroup.normalizer (T : Set Y)) :
    (MulAut.conjNormal (H := K) g) ∈ Subgroup.normalizer
      ((T.map (MulAut.conjNormal (H := K)) : Subgroup (MulAut ↥K)) : Set (MulAut ↥K)) := by
  rw [Subgroup.mem_normalizer_iff] at hg ⊢
  intro h
  constructor
  · rintro ⟨t, ht, rfl⟩
    refine ⟨g * t * g⁻¹, (hg t).1 ht, ?_⟩
    simp
  · rintro ⟨t, ht, hth⟩
    refine ⟨g⁻¹ * t * g, (hg (g⁻¹ * t * g)).2 (by simpa [mul_assoc] using ht), ?_⟩
    have : h = (MulAut.conjNormal (H := K) g)⁻¹ * (MulAut.conjNormal (H := K) g * h *
        (MulAut.conjNormal (H := K) g)⁻¹) * MulAut.conjNormal (H := K) g := by group
    rw [this, ← hth]
    simp [mul_assoc]

theorem isLThreeFour_barOf_subgroupOf {K J : Subgroup Y} (hJK : J ≤ K)
    (h : IsLThreeFour (barOf 3 J)) : IsLThreeFour (barOf 3 (J.subgroupOf K)) := by
  set e : ↥J ≃* ↥(J.subgroupOf K) := (Subgroup.subgroupOfEquivOfLe hJK).symm
  set f : barOf 3 J ≃* barOf 3 (J.subgroupOf K) :=
    QuotientGroup.congr _ _ e (glaPPrimeCore_map_iso 3 e)
  obtain ⟨F, hF, hfin, hc, ⟨φ⟩⟩ := h
  exact ⟨F, hF, hfin, hc, ⟨f.symm.trans φ⟩⟩

theorem coverFacts_of_autFacts {P : TauCeti.LieTypeIndex → Prop} (h : AutFacts P) :
    Input289.CoverFacts P := by
  intro Y _ _ K T D J hKn hcat hT hDT hDel hD9 hDJ hJK hJ34
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set ρ : Y →* MulAut ↥K := MulAut.conjNormal (H := K) with hρ
  have hρ1 : ∀ (g : Y) (x : ↥K), ((ρ g x : ↥K) : Y) = g * x * g⁻¹ := fun g x =>
    MulAut.conjNormal_apply g x
  set X : Subgroup (MulAut ↥K) := T.map ρ with hX
  have hDK : D ≤ K := hDJ.trans hJK
  set D' : Subgroup ↥K := D.subgroupOf K with hD'
  set J' : Subgroup ↥K := J.subgroupOf K with hJ'
  have hD'el : IsElemAbelian 3 D' := by
    refine ⟨⟨⟨fun a b => Subtype.ext (Subtype.ext ?_)⟩⟩, fun x hx => ?_⟩
    · have := hDel.1.is_comm.comm ⟨(a : ↥K), a.2⟩ ⟨(b : ↥K), b.2⟩
      simpa using congrArg Subtype.val this
    · exact Subtype.ext (by simpa using hDel.2 _ (Subgroup.mem_subgroupOf.1 hx))
  have hD'9 : Nat.card D' = 9 := by
    rw [← hD9]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hDK).toEquiv
  have hD'J' : D' ≤ J' := fun x hx => Subgroup.mem_subgroupOf.2 (hDJ (Subgroup.mem_subgroupOf.1 hx))
  have hJ'34 := isLThreeFour_barOf_subgroupOf hJK hJ34
  have hX2 : IsPGroup 2 X := hT.map ρ
  have hDX : ∀ d ∈ D', MulAut.conj d ∈ Subgroup.normalizer (X : Set (MulAut ↥K)) := by
    intro d hd
    have hdD : (d : Y) ∈ D := Subgroup.mem_subgroupOf.1 hd
    have h1 : MulAut.conj d = ρ (d : Y) := by
      ext x
      rw [hρ1]
      simp
    rw [h1]
    exact conjNormal_mem_normalizer (hDT hdD)
  rcases h ↥K hcat D' J' hD'el hD'9 hD'J' hJ'34 X hX2 hDX with
    hbot | ⟨τ, hXτ, hτ2, x, hx7, hτx, hgen⟩
  · left
    intro k hk
    rw [Subgroup.mem_centralizer_iff]
    intro t ht
    have h1 : ρ t = 1 := by
      have : ρ t ∈ X := ⟨t, ht, rfl⟩
      rw [hbot] at this
      exact this
    have h2 := congrArg (fun m : MulAut ↥K => ((m ⟨k, hk⟩ : ↥K) : Y)) h1
    simp only [hρ1, MulAut.one_apply] at h2
    rw [show t * k = (t * k * t⁻¹) * t by group, h2]
  · right
    set x' : Y := (x : Y) with hx'
    set Q : Subgroup Y := Subgroup.zpowers x' with hQ
    have hQK : Q ≤ K := (Subgroup.zpowers_le).2 x.2
    have hQcard : Nat.card Q = 7 := by
      rw [hQ, Nat.card_zpowers, hx', Subgroup.orderOf_coe, hx7]
    have hρT : ∀ t ∈ T, ρ t = 1 ∨ ρ t = τ := fun t ht =>
      eq_one_or_of_mem_zpowers hτ2 (hXτ ▸ (⟨t, ht, rfl⟩ : ρ t ∈ X))
    have hact : ∀ t ∈ T, t * x' * t⁻¹ = x' ∨ t * x' * t⁻¹ = x'⁻¹ := by
      intro t ht
      have h1 := hρ1 t x
      rcases hρT t ht with h | h
      · left; rw [h] at h1; simpa using h1.symm
      · right; rw [h, hτx] at h1; simpa using h1.symm
    have hconjQ : ∀ t ∈ T, ∀ q ∈ Q, t * q * t⁻¹ ∈ Q := by
      intro t ht q hq
      obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 hq
      have : t * x' ^ m * t⁻¹ = (t * x' * t⁻¹) ^ m := by simp
      rw [this]
      rcases hact t ht with h | h <;> rw [h]
      · exact Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) _
      · exact Subgroup.zpow_mem _ (Subgroup.inv_mem _ (Subgroup.mem_zpowers _)) _
    have hTQ : T ≤ Subgroup.normalizer (Q : Set Y) := by
      intro t ht
      rw [Subgroup.mem_normalizer_iff]
      intro q
      constructor
      · exact hconjQ t ht q
      · intro hq
        have := hconjQ t⁻¹ (inv_mem ht) _ hq
        simpa [mul_assoc] using this
    obtain ⟨t0, ht0, hρt0⟩ : ∃ t0 ∈ T, ρ t0 = τ := by
      have : τ ∈ X := hXτ ▸ Subgroup.mem_zpowers τ
      exact this
    have hinv : ∀ q ∈ Q, t0 * q * t0⁻¹ = q⁻¹ := by
      intro q hq
      obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 hq
      have h1 : t0 * x' * t0⁻¹ = x'⁻¹ := by
        have := hρ1 t0 x
        rw [hρt0, hτx] at this
        simpa using this.symm
      have : t0 * x' ^ m * t0⁻¹ = (t0 * x' * t0⁻¹) ^ m := by simp
      rw [this, h1, inv_zpow', zpow_neg]
    refine ⟨Q, hQK, hQcard, hTQ, ⟨t0, ht0, hinv⟩, ?_⟩
    apply le_antisymm (sup_le inf_le_right hQK)
    have hfixcent : ∀ k : ↥K, τ k = k → (k : Y) ∈ Subgroup.centralizer (T : Set Y) := by
      intro k hk
      rw [Subgroup.mem_centralizer_iff]
      intro t ht
      have h1 := hρ1 t k
      have h2 : t * k * t⁻¹ = k := by
        rcases hρT t ht with h | h
        · rw [h] at h1; simpa using h1.symm
        · rw [h, hk] at h1; exact h1.symm
      rw [show t * k = (t * k * t⁻¹) * t by group, h2]
    have hK : Subgroup.closure (K.subtype '' ({k | τ k = k} ∪ {x})) = K := by
      rw [← MonoidHom.map_closure, hgen, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
    refine hK.symm.le.trans ((Subgroup.closure_le _).2 ?_)
    rintro _ ⟨k, hk, rfl⟩
    rcases hk with hk | hk
    · exact Subgroup.mem_sup_left ⟨hfixcent k hk, k.2⟩
    · rw [Set.mem_singleton_iff.1 hk]
      exact Subgroup.mem_sup_right (Subgroup.mem_zpowers _)

end Cover

section L364

theorem autFactsL364 : AutFacts IsL364Index := by
  intro K _ _ hcat D J hDel hD9 hDJ hJ X hX hDX
  obtain ⟨F, _, _, hF, ⟨e⟩⟩ :=
    CFSG.HardMathSupport.Solomon.UniquenessMaximal.GenL3.exists_model_of_catalogL364 hcat
  have : CharP F 2 := charP_two hF
  set θ : K ≃* projectiveSL 3 F := e.trans (CFSG.HardMathSupport.Solomon.Coordinator.psiO F)
    with hθ
  have hconjK := conj_of_isLThreeFour hDel hD9 hDJ hJ
  set Φ : MulAut K ≃* MulAut (projectiveSL 3 F) := MulAut.congr θ with hΦ
  apply autFacts_concl_of_equiv θ
  have hDcomm : ∀ x ∈ D.map θ.toMonoidHom, ∀ y ∈ D.map θ.toMonoidHom, x * y = y * x := by
    rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
    have := hDel.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩
    have h2 : a * b = b * a := congrArg Subtype.val this
    simp only [MulEquiv.coe_toMonoidHom]
    rw [← map_mul, ← map_mul, h2]
  have hD3 : ∀ d ∈ D.map θ.toMonoidHom, d ^ 3 = 1 := by
    rintro _ ⟨a, ha, rfl⟩
    simp only [MulEquiv.coe_toMonoidHom]
    rw [← map_pow, hDel.2 a ha, map_one]
  have hD9' : Nat.card (D.map θ.toMonoidHom) = 9 := by
    rw [Subgroup.card_map_of_injective θ.injective, hD9]
  have hconj : ∀ d₁ ∈ D.map θ.toMonoidHom, ∀ d₂ ∈ D.map θ.toMonoidHom, d₁ ≠ 1 → d₂ ≠ 1 →
      ∃ g, g * d₁ * g⁻¹ = d₂ := by
    rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩ h1 h2
    simp only [MulEquiv.coe_toMonoidHom] at h1 h2 ⊢
    have ha1 : a ≠ 1 := by rintro rfl; exact h1 (map_one θ)
    have hb1 : b ≠ 1 := by rintro rfl; exact h2 (map_one θ)
    obtain ⟨g, hg⟩ := hconjK a ha b hb ha1 hb1
    exact ⟨θ g, by rw [← map_inv, ← map_mul, ← map_mul, hg]⟩
  have hXP : IsPGroup 2 (X.map Φ.toMonoidHom) := hX.map _
  have hDXP : ∀ d ∈ D.map θ.toMonoidHom, MulAut.conj d ∈ Subgroup.normalizer
      ((X.map Φ.toMonoidHom : Subgroup _) : Set (MulAut (projectiveSL 3 F))) := by
    rintro _ ⟨a, ha, rfl⟩
    have h1 := mem_normalizer_map_equiv Φ (hDX a ha)
    rw [hΦ, congr_conj] at h1
    exact h1
  exact autFacts_P hF hDcomm hD3 hD9' hconj hXP hDXP

theorem coverFactsL364_holds : Input289.CoverFactsL364 :=
  coverFacts_of_autFacts autFactsL364

end L364

section D44Narrow

structure Facts3D44 : Prop where
  inner : ∀ (K : Type) [Group K] [Finite K], IsCatalogLieIso K Is3D44Index →
    ∀ D J : Subgroup K, IsElemAbelian 3 D → Nat.card D = 9 → D ≤ J → IsLThreeFour (barOf 3 J) →
    ∀ S : Subgroup K, IsPGroup 2 S → D ≤ Subgroup.normalizer (S : Set K) → S = ⊥
  gen : ∀ (K : Type) [Group K] [Finite K], IsCatalogLieIso K Is3D44Index →
    ∀ τ : MulAut K, τ * τ = 1 → (∀ g : K, τ ≠ MulAut.conj g) →
      ∃ x : K, orderOf x = 7 ∧ τ x = x⁻¹ ∧ Subgroup.closure ({k | τ k = k} ∪ {x}) = ⊤

@[expose] def Inner3D44 : Prop :=
  ∀ (K : Type) [Group K] [Finite K], IsCatalogLieIso K Is3D44Index →
    ∀ D J : Subgroup K, IsElemAbelian 3 D → Nat.card D = 9 → D ≤ J → IsLThreeFour (barOf 3 J) →
    ∀ S : Subgroup K, IsPGroup 2 S → D ≤ Subgroup.normalizer (S : Set K) → S = ⊥

theorem is3D44_cases' {x : TauCeti.LieTypeIndex} (h : Is3D44Index x) :
    ∃ q : TauCeti.PrimePower, x = .trialityD4 q ∧ q.p = 2 ∧ q.exponent = 2 := by
  cases x <;> first | exact ⟨_, rfl, h⟩ | exact h.elim

theorem out3D44 {K : Type} [Group K] [Finite K] (hcat : IsCatalogLieIso K Is3D44Index) :
    Subgroup.center K = ⊥ ∧ ∃ (A : Type) (_ : Group A) (_ : Finite A), Nat.card A = 6 ∧
      ∃ Θ : MulAut K →* A, ∀ α, Θ α = 1 → ∃ g : K, α = MulAut.conj g := by
  obtain ⟨⟨x0, hv⟩, hd, ⟨e⟩⟩ := hcat
  obtain ⟨q, rfl, hqp, hq2⟩ := is3D44_cases' hd
  have hmod := CFSG.TauCetiBridge.Even.twistedModel_of_bridgeEven
    CFSG.TauCetiBridge.Even.twistedBridgeEven_trialityD4 q hv hqp (by decide) e
  rw [hqp, hq2] at hmod
  obtain ⟨kf, _, _, σ, hkf, hσ, ⟨eC⟩⟩ :=
    CFSG.LieType.Chevalley.exists_mulEquiv_graphFixedRootGroup_card .D4 Nat.prime_two
      (by norm_num) hmod
  have hkf' : Nat.card kf = (2 ^ 2) ^ 3 := hkf
  obtain ⟨-, -, ⟨Θ, -, -, hΘker, -⟩, -, hcard, -, hZ, -⟩ :=
    CFSG.LieType.Chevalley.even_triality_exact_automorphism_normal_form (f := 2) (by norm_num)
      kf hkf' σ hσ
  refine ⟨?_, kf ≃+* kf, inferInstance, inferInstance, by rw [hcard],
    Θ.comp (MulAut.congr eC).toMonoidHom, ?_⟩
  · rw [eq_bot_iff]
    intro z hz
    have h1 : eC z ∈ Subgroup.center
        ↥(CFSG.LieType.Chevalley.graphFixedRootGroup CFSG.Blueprint.Chevalley.TwistTag.D4 kf
          σ.toRingHom) := by
      rw [Subgroup.mem_center_iff] at hz ⊢
      intro y
      have h2 := congrArg eC (hz (eC.symm y))
      rw [map_mul, map_mul, MulEquiv.apply_symm_apply] at h2
      exact h2
    rw [hZ, Subgroup.mem_bot] at h1
    exact Subgroup.mem_bot.2 (eC.injective (h1.trans (map_one eC).symm))
  · intro α hα
    have hmem : MulAut.congr eC α ∈ Θ.ker := hα
    rw [hΘker] at hmem
    obtain ⟨c, hc⟩ := hmem
    refine ⟨eC.symm c, ?_⟩
    apply (MulAut.congr eC).injective
    change MulAut.congr eC α = MulAut.congr eC (MulAut.conj (eC.symm c))
    rw [congr_conj, MulEquiv.apply_symm_apply, ← hc]

theorem autFacts3D44_of_facts (h : Facts3D44) : AutFacts Is3D44Index := by
  intro K _ _ hcat D J hDel hD9 hDJ hJ X hX hDX
  obtain ⟨hZ, A, _, _, hA6, Θ, hΘ⟩ := out3D44 hcat
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hinj : Function.Injective (MulAut.conj : K →* MulAut K) := by
    rw [injective_iff_map_eq_one]
    intro p hp
    have hc : p ∈ Subgroup.center K := by
      rw [Subgroup.mem_center_iff]
      intro q
      have := congrArg (fun α : MulAut K => α q) hp
      simp only [MulAut.conj_apply, MulAut.one_apply] at this
      calc q * p = p * q * p⁻¹ * p := by rw [this]
        _ = p * q := by group
    rw [hZ] at hc
    exact hc
  have hinn : ∀ p : K, MulAut.conj p ∈ X → p = 1 := by
    intro p hp
    set S : Subgroup K := X.comap (MulAut.conj : K →* MulAut K) with hS
    have hS2 : IsPGroup 2 S := hX.comap_of_injective _ hinj
    have hDS : D ≤ Subgroup.normalizer (S : Set K) := by
      intro d hd
      rw [Subgroup.mem_normalizer_iff]
      intro q
      rw [hS, Subgroup.mem_comap, Subgroup.mem_comap, map_mul, map_mul, map_inv]
      exact Subgroup.mem_normalizer_iff.1 (hDX d hd) _
    have hSbot := h.inner K hcat D J hDel hD9 hDJ hJ S hS2 hDS
    have hpS : p ∈ S := hp
    rw [hSbot] at hpS
    exact hpS
  have hXΘ : Function.Injective (Θ.comp X.subtype) := by
    rw [injective_iff_map_eq_one]
    intro α hα
    obtain ⟨g, hg⟩ := hΘ α hα
    have hg1 : g = 1 := hinn g (hg ▸ α.2)
    exact Subtype.ext (by rw [hg, hg1, map_one]; rfl)
  have hcardX : Nat.card X ∣ 2 := by
    obtain ⟨n, hn⟩ := IsPGroup.iff_card.1 hX
    have h1 : Nat.card X ∣ Nat.card A := by
      rw [Nat.card_congr (MonoidHom.ofInjective hXΘ).toEquiv]
      exact Subgroup.card_subgroup_dvd_card _
    rw [hA6, hn] at h1
    rw [hn]
    rcases n with _ | _ | n
    · norm_num
    · norm_num
    · exfalso
      have : 2 ^ 2 ∣ 6 := (pow_dvd_pow 2 (by omega)).trans h1
      norm_num at this
  rcases (Nat.dvd_prime Nat.prime_two).1 hcardX with h1 | h2
  · exact Or.inl (Subgroup.eq_bot_of_card_eq X h1)
  · right
    have hne : X ≠ ⊥ := by
      intro hb
      rw [hb, Subgroup.card_bot] at h2
      norm_num at h2
    obtain ⟨⟨τ, hτX⟩, hτ1⟩ := (Subgroup.ne_bot_iff_exists_ne_one).1 hne
    have hτ1' : τ ≠ 1 := fun h => hτ1 (Subtype.ext h)
    have hτ2 : τ * τ = 1 := by
      have := pow_card_eq_one' (G := X) (x := ⟨τ, hτX⟩)
      rw [h2, sq] at this
      exact congrArg Subtype.val this
    have hord : orderOf τ = 2 := orderOf_eq_prime (by rw [sq]; exact hτ2) hτ1'
    have hXτ : X = Subgroup.zpowers τ := by
      symm
      apply Subgroup.eq_of_le_of_card_ge ((Subgroup.zpowers_le).2 hτX)
      rw [h2, Nat.card_zpowers, hord]
    have hout : ∀ g : K, τ ≠ MulAut.conj g := by
      intro g hg
      apply hτ1'
      rw [hg, hinn g (hg ▸ hτX), map_one]
    obtain ⟨x, hx7, hτx, hgen⟩ := h.gen K hcat τ hτ2 hout
    exact ⟨τ, hXτ, hτ2, x, hx7, hτx, hgen⟩

theorem coverFacts3D44_of_facts (h : Facts3D44) : Input289.CoverFacts3D44 :=
  coverFacts_of_autFacts (autFacts3D44_of_facts h)

theorem coverFactsRest_of_facts3D44 (h : Facts3D44) : Input289.CoverFactsRest :=
  ⟨coverFactsL364_holds, coverFacts3D44_of_facts h⟩

end D44Narrow

section D44Model

open CFSG.LieType.Chevalley (graphFixedRootGroup fieldActor)
open CFSG.Blueprint CFSG.Blueprint.Chevalley

@[expose] def Gen3D44Model : Prop :=
  ∀ (kf : Type) [Field kf] [Finite kf] (σ δ : kf ≃+* kf), Nat.card kf = 64 →
    (∀ c, σ c = c ^ 4) → (∀ c, δ c = c ^ 8) →
    ∃ x : graphFixedRootGroup TwistTag.D4 kf σ.toRingHom, orderOf x = 7 ∧
      Units.map (entrywiseHom δ.toRingHom) (x : ModGL TwistTag.D4.tag kf) =
        ((x⁻¹ : graphFixedRootGroup TwistTag.D4 kf σ.toRingHom) : ModGL TwistTag.D4.tag kf) ∧
      Subgroup.closure ({g : graphFixedRootGroup TwistTag.D4 kf σ.toRingHom |
        Units.map (entrywiseHom δ.toRingHom) (g : ModGL TwistTag.D4.tag kf) =
          (g : ModGL TwistTag.D4.tag kf)} ∪ {x}) = ⊤

theorem gen3D44_of_model (h : Gen3D44Model) (K : Type) [Group K] [Finite K]
    (hcat : IsCatalogLieIso K Is3D44Index) (τ : MulAut K) (hτ2 : τ * τ = 1)
    (hout : ∀ g : K, τ ≠ MulAut.conj g) :
    ∃ x : K, orderOf x = 7 ∧ τ x = x⁻¹ ∧ Subgroup.closure ({k | τ k = k} ∪ {x}) = ⊤ := by
  obtain ⟨⟨x0, hv⟩, hd, ⟨e⟩⟩ := hcat
  obtain ⟨q, rfl, hqp, hq2⟩ := is3D44_cases' hd
  have hmod := CFSG.TauCetiBridge.Even.twistedModel_of_bridgeEven
    CFSG.TauCetiBridge.Even.twistedBridgeEven_trialityD4 q hv hqp (by decide) e
  rw [hqp, hq2] at hmod
  obtain ⟨kf, _, _, σ, hkf, hσ, ⟨eC⟩⟩ :=
    CFSG.LieType.Chevalley.exists_mulEquiv_graphFixedRootGroup_card .D4 Nat.prime_two
      (by norm_num) hmod
  have hkf' : Nat.card kf = (2 ^ 2) ^ 3 := hkf
  set C := graphFixedRootGroup TwistTag.D4 kf σ.toRingHom with hC
  set β : MulAut C := MulAut.congr eC τ with hβ
  have hβ2 : β ^ 2 = 1 := by rw [sq, hβ, ← map_mul, hτ2, map_one]
  have hβo : β ∉ CFSG.ComponentClassification.OuterAutomorphisms.inner C := by
    rintro ⟨c, hc⟩
    apply hout (eC.symm c)
    apply (MulAut.congr eC).injective
    rw [congr_conj, MulEquiv.apply_symm_apply]
    exact hc.symm
  obtain ⟨-, δ, hδ, -, ψ, hψ, -⟩ :=
    CFSG.LieType.Chevalley.even_triality_outer_involutions_canonical_field (f := 2)
      (by norm_num) kf hkf' σ hσ β hβ2 hβo
  have hσ4 : ∀ c, σ c = c ^ 4 := fun c => by rw [hσ]; norm_num
  have hδ8 : ∀ c, δ c = c ^ 8 := fun c => by rw [hδ]; norm_num
  obtain ⟨x₀, hx₀7, hx₀inv, hgen⟩ := h kf σ δ (by rw [hkf']; norm_num) hσ4 hδ8
  have hact : ∀ g : C, fieldActor σ δ g = g ↔
      Units.map (entrywiseHom δ.toRingHom) (g : ModGL TwistTag.D4.tag kf) =
        (g : ModGL TwistTag.D4.tag kf) := by
    intro g
    rw [← CFSG.LieType.Chevalley.coe_fieldActor]
    exact ⟨fun h => by rw [h], fun h => Subtype.ext h⟩
  have hx₀' : fieldActor σ δ x₀ = x₀⁻¹ := by
    apply Subtype.ext
    rw [CFSG.LieType.Chevalley.coe_fieldActor]
    exact hx₀inv
  set φ : C ≃* K := (ψ.symm : C ≃* C).trans eC.symm with hφ
  have hτφ : ∀ k : K, τ k = φ (fieldActor σ δ (φ.symm k)) := by
    intro k
    have h1 : β = ψ⁻¹ * fieldActor σ δ * ψ := by rw [← hψ]; group
    have h2 : τ k = eC.symm (β (eC k)) := by
      rw [hβ, MulAut.congr_apply]
      simp
    rw [h2, h1, MulAut.mul_apply, MulAut.mul_apply, MulAut.inv_apply]
    rfl
  refine ⟨φ x₀, ?_, ?_, ?_⟩
  · rw [MulEquiv.orderOf_eq, hx₀7]
  · rw [hτφ, MulEquiv.symm_apply_apply, hx₀', map_inv]
  · apply Subgroup.map_injective (f := φ.symm.toMonoidHom) φ.symm.injective
    rw [Subgroup.map_top_of_surjective _ φ.symm.surjective, MonoidHom.map_closure, eq_top_iff,
      ← hgen]
    apply Subgroup.closure_mono
    intro p hp
    rcases hp with hp | hp
    · refine ⟨φ p, Or.inl ?_, by simp⟩
      show τ (φ p) = φ p
      rw [hτφ, MulEquiv.symm_apply_apply]
      congr 1
      exact (hact p).2 hp
    · refine ⟨φ x₀, Or.inr rfl, ?_⟩
      rw [Set.mem_singleton_iff.1 hp]
      simp

end D44Model

section SL2Gen

open Matrix
open CFSG.LieType.Chevalley (SL2 vSL HSL WSL SL2_ext coe_uSL coe_vSL coe_HSL coe_WSL det_SL2
  SL2_induction vSL_eq map_uSL map_vSL map_HSL map_WSL)

local notation "U₂" => CFSG.LieType.Chevalley.uSL

variable {F : Type} [Field F]

theorem uSL_add' (a b : F) : U₂ (a + b) = U₂ a * U₂ b := by
  refine SL2_ext ?_ ?_ ?_ ?_ <;>
    simp [coe_uSL, SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two, add_comm]

theorem WSL_eq_uSL_vSL : (WSL : SL2 F) = U₂ 1 * vSL (-1) * U₂ 1 := by
  refine SL2_ext ?_ ?_ ?_ ?_ <;>
    simp [coe_uSL, coe_vSL, coe_WSL, SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]

theorem HSL_eq_uSL_vSL (t : Fˣ) :
    HSL t = U₂ (t : F) * vSL (-((t⁻¹ : Fˣ) : F)) * U₂ (t : F) * WSL⁻¹ := by
  have ht : (t : F) * ((t⁻¹ : Fˣ) : F) = 1 := by rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  refine SL2_ext ?_ ?_ ?_ ?_ <;>
    simp [coe_uSL, coe_vSL, coe_WSL, coe_HSL, SpecialLinearGroup.coe_mul,
      SpecialLinearGroup.coe_inv, Matrix.mul_apply, Fin.sum_univ_two, Matrix.adjugate_fin_two] <;>
    linear_combination ht

theorem closure_uSL_vSL :
    Subgroup.closure (Set.range (U₂ : F → SL2 F) ∪ Set.range (vSL : F → SL2 F)) = ⊤ := by
  set M := Subgroup.closure (Set.range (U₂ : F → SL2 F) ∪ Set.range (vSL : F → SL2 F))
  have hu : ∀ s, U₂ s ∈ M := fun s => Subgroup.subset_closure (Or.inl ⟨s, rfl⟩)
  have hv : ∀ s, vSL s ∈ M := fun s => Subgroup.subset_closure (Or.inr ⟨s, rfl⟩)
  have hW : (WSL : SL2 F) ∈ M := by
    rw [WSL_eq_uSL_vSL]
    exact mul_mem (mul_mem (hu 1) (hv _)) (hu 1)
  rw [eq_top_iff]
  intro g _
  refine SL2_induction (p := fun g => g ∈ M) (fun g g' h h' => mul_mem h h') hu (fun t => ?_) hW g
  rw [HSL_eq_uSL_vSL]
  exact mul_mem (mul_mem (mul_mem (hu _) (hv _)) (hu _)) (inv_mem hW)

theorem HSL_mul' (s t : Fˣ) : HSL (s * t) = HSL s * HSL t := by
  refine SL2_ext ?_ ?_ ?_ ?_ <;>
    simp [coe_HSL, SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two, mul_comm]

@[expose] def hslHom : Fˣ →* SL2 F := MonoidHom.mk' HSL HSL_mul'

theorem hslHom_apply (t : Fˣ) : hslHom t = HSL t := rfl

theorem WSL_conj_HSL (t : Fˣ) : WSL * HSL t * WSL⁻¹ = HSL t⁻¹ := by
  refine SL2_ext ?_ ?_ ?_ ?_ <;>
    simp [coe_WSL, coe_HSL, SpecialLinearGroup.coe_mul, SpecialLinearGroup.coe_inv,
      Matrix.mul_apply, Fin.sum_univ_two, Matrix.adjugate_fin_two]

theorem conj_uSL_of_lower {h : SL2 F} (h10 : (h : Matrix (Fin 2) (Fin 2) F) 1 0 = 0) (s : F) :
    h * U₂ s * h⁻¹ = U₂ ((h : Matrix (Fin 2) (Fin 2) F) 0 0 ^ 2 * s) := by
  have hdet := det_SL2 h
  rw [h10, mul_zero, sub_zero] at hdet
  refine SL2_ext ?_ ?_ ?_ ?_ <;>
    simp [coe_uSL, SpecialLinearGroup.coe_mul, SpecialLinearGroup.coe_inv, Matrix.mul_apply,
      Fin.sum_univ_two, Matrix.adjugate_fin_two, h10] <;>
    first | ring1 | linear_combination hdet

theorem conj_col_zero {A B : SL2 F} {μ : F}
    (h : ∀ i, ((B * A : SL2 F) : Matrix (Fin 2) (Fin 2) F) i 0 =
      μ * (A : Matrix (Fin 2) (Fin 2) F) i 0) (i : Fin 2) :
    ((A⁻¹ * B * A : SL2 F) : Matrix (Fin 2) (Fin 2) F) i 0 =
      μ * (1 : Matrix (Fin 2) (Fin 2) F) i 0 := by
  have e1 : ((A⁻¹ * B * A : SL2 F) : Matrix (Fin 2) (Fin 2) F) =
      ((A⁻¹ : SL2 F) : Matrix (Fin 2) (Fin 2) F) *
        ((B * A : SL2 F) : Matrix (Fin 2) (Fin 2) F) := by
    change ((A⁻¹ : SL2 F) : Matrix (Fin 2) (Fin 2) F) * (B : Matrix (Fin 2) (Fin 2) F) *
      (A : Matrix (Fin 2) (Fin 2) F) = ((A⁻¹ : SL2 F) : Matrix (Fin 2) (Fin 2) F) *
        ((B : Matrix (Fin 2) (Fin 2) F) * (A : Matrix (Fin 2) (Fin 2) F))
    exact Matrix.mul_assoc _ _ _
  have e2 : ((A⁻¹ : SL2 F) : Matrix (Fin 2) (Fin 2) F) * (A : Matrix (Fin 2) (Fin 2) F) = 1 := by
    change ((A⁻¹ * A : SL2 F) : Matrix (Fin 2) (Fin 2) F) = 1
    rw [inv_mul_cancel]
    rfl
  rw [e1, Matrix.mul_apply, ← e2, Matrix.mul_apply, Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [h j]
  ring

@[expose] def sl2G (ω : F) : SL2 F := vSL ω * U₂ 1

@[expose] def sl2X (ω : F) (t : Fˣ) : SL2 F := sl2G ω * HSL t * (sl2G ω)⁻¹

theorem sl2X_col {ω : F} (hω : ω ^ 2 + ω + 1 = 0) [CharP F 2] (t : Fˣ) {e : F}
    (he : e * ((t : F) ^ 2 + 1) = 1) (i : Fin 2) :
    ((U₂ e * vSL 1 * U₂ (e + 1) * sl2X ω t : SL2 F) : Matrix (Fin 2) (Fin 2) F) i 0 =
      ω ^ 2 * ((sl2X ω t : SL2 F) : Matrix (Fin 2) (Fin 2) F) i 0 := by
  have hm : (t : F) * (t : F)⁻¹ = 1 := mul_inv_cancel₀ t.ne_zero
  fin_cases i <;>
    simp [sl2X, sl2G, coe_uSL, coe_vSL, coe_HSL, SpecialLinearGroup.coe_mul,
      SpecialLinearGroup.coe_inv, Matrix.mul_apply, Fin.sum_univ_two, Matrix.adjugate_fin_two]
  · linear_combination (norm := (ring_nf <;> reduce_mod_char!))
      ((t * (ω + 1) - (t : F)⁻¹ * ω) + (e ^ 2 + e + 1) * (t + (t : F)⁻¹) +
        (t + (t : F)⁻¹)) * hω + (ω + e) * (t : F)⁻¹ * he + (ω + e) * e * t * hm
  · linear_combination (norm := (ring_nf <;> reduce_mod_char!))
      (1 + e + ω ^ 2) * (t + (t : F)⁻¹) * hω + (t : F)⁻¹ * he + e * t * hm

variable [CharP F 2] {δ' : F →+* F} {ω : F}

theorem map_sl2X (hω : ω ^ 2 + ω + 1 = 0) (hδω : δ' ω = ω ^ 2) {t : Fˣ} (hδt : δ' (t : F) = t) :
    SpecialLinearGroup.map δ' (sl2X ω t) = (sl2X ω t)⁻¹ := by
  have hg : SpecialLinearGroup.map δ' (sl2G ω) = sl2G ω * WSL := by
    rw [sl2G, map_mul, map_vSL, map_uSL, map_one, hδω]
    refine SL2_ext ?_ ?_ ?_ ?_ <;>
      simp [coe_uSL, coe_vSL, coe_WSL, SpecialLinearGroup.coe_mul, Matrix.mul_apply,
        Fin.sum_univ_two]
    · linear_combination (norm := (ring_nf <;> reduce_mod_char!))
    · linear_combination hω
    · linear_combination (norm := (ring_nf <;> reduce_mod_char!)) hω
  have hH : SpecialLinearGroup.map δ' (HSL t) = HSL t := by
    rw [map_HSL]
    congr 1
    exact Units.ext hδt
  have hinv : HSL t⁻¹ = (HSL t)⁻¹ := by rw [← hslHom_apply, ← hslHom_apply, map_inv]
  rw [sl2X, map_mul, map_mul, map_inv, hg, hH]
  calc sl2G ω * WSL * HSL t * (sl2G ω * WSL)⁻¹ =
        sl2G ω * (WSL * HSL t * WSL⁻¹) * (sl2G ω)⁻¹ := by group
    _ = (sl2G ω * HSL t * (sl2G ω)⁻¹)⁻¹ := by rw [WSL_conj_HSL, hinv]; group

theorem sl2X_pow_seven {t : Fˣ} (ht : t ^ 7 = 1) : sl2X ω t ^ 7 = 1 := by
  rw [sl2X, conj_pow, ← hslHom_apply, ← map_pow, ht, map_one, mul_one, mul_inv_cancel]

theorem sl2X_ne_one {t : Fˣ} (ht : t ≠ 1) : sl2X ω t ≠ 1 := by
  intro h
  have h1 : HSL t = 1 := by
    have := congrArg (fun y => (sl2G ω)⁻¹ * y * sl2G ω) h
    simpa [sl2X, mul_assoc] using this
  apply ht
  apply Units.ext
  have := congrArg (fun y : SL2 F => (y : Matrix (Fin 2) (Fin 2) F) 0 0) h1
  simpa [coe_HSL] using this

theorem sl2_eq_top (hδ2 : ∀ c, δ' (δ' c) = c) (hω : ω ^ 2 + ω + 1 = 0) (hδω : δ' ω = ω ^ 2)
    {t : Fˣ} (ht1 : t ≠ 1) (hδt : δ' (t : F) = t) (S : Subgroup (SL2 F))
    (hU : ∀ s, δ' s = s → U₂ s ∈ S) (hV : ∀ s, δ' s = s → vSL s ∈ S) (hx : sl2X ω t ∈ S) :
    S = ⊤ := by
  have hl1 : (t : F) ≠ 1 := fun h => ht1 (Units.ext h)
  have hl2 : (t : F) ^ 2 + 1 ≠ 0 := by
    intro h
    have h' : ((t : F) - 1) ^ 2 = 0 := by
      linear_combination (norm := (ring_nf <;> reduce_mod_char!)) h
    exact hl1 (sub_eq_zero.1 (pow_eq_zero_iff (by norm_num) |>.1 h'))
  have he : (((t : F) ^ 2 + 1)⁻¹) * ((t : F) ^ 2 + 1) = 1 := inv_mul_cancel₀ hl2
  have hδe : δ' (((t : F) ^ 2 + 1)⁻¹) = ((t : F) ^ 2 + 1)⁻¹ := by
    rw [map_inv₀, map_add, map_pow, hδt, map_one]
  set e : F := ((t : F) ^ 2 + 1)⁻¹ with he_def
  have hk : U₂ e * vSL 1 * U₂ (e + 1) ∈ S :=
    mul_mem (mul_mem (hU e hδe) (hV 1 (map_one δ'))) (hU _ (by rw [map_add, hδe, map_one]))
  have hhS : (sl2X ω t)⁻¹ * (U₂ e * vSL 1 * U₂ (e + 1)) * sl2X ω t ∈ S :=
    mul_mem (mul_mem (inv_mem hx) hk) hx
  have hcol := conj_col_zero (A := sl2X ω t) (B := U₂ e * vSL 1 * U₂ (e + 1)) (μ := ω ^ 2)
    (sl2X_col hω t he)
  have h10 : (((sl2X ω t)⁻¹ * (U₂ e * vSL 1 * U₂ (e + 1)) * sl2X ω t : SL2 F) :
      Matrix (Fin 2) (Fin 2) F) 1 0 = 0 := by
    rw [hcol 1]
    simp
  have h00 : (((sl2X ω t)⁻¹ * (U₂ e * vSL 1 * U₂ (e + 1)) * sl2X ω t : SL2 F) :
      Matrix (Fin 2) (Fin 2) F) 0 0 = ω ^ 2 := by
    rw [hcol 0]
    simp
  have hω4 : (ω ^ 2) ^ 2 = ω := by linear_combination (ω ^ 2 - ω) * hω
  have hUω : ∀ s, δ' s = s → U₂ (ω * s) ∈ S := by
    intro s hs
    have := mul_mem (mul_mem hhS (hU s hs)) (inv_mem hhS)
    rwa [conj_uSL_of_lower h10, h00, hω4] at this
  have hUall : ∀ s, U₂ s ∈ S := by
    intro s
    have hb : δ' (s + δ' s) = s + δ' s := by rw [map_add, hδ2, add_comm]
    have ha : δ' (s + ω * (s + δ' s)) = s + ω * (s + δ' s) := by
      rw [map_add, map_mul, hb, hδω]
      linear_combination (norm := (ring_nf <;> reduce_mod_char!)) (δ' s + s) * hω
    have hs : s = (s + ω * (s + δ' s)) + ω * (s + δ' s) := by
      linear_combination (norm := (ring_nf <;> reduce_mod_char!))
    rw [hs, uSL_add']
    exact mul_mem (hU _ ha) (hUω _ hb)
  have hW : (WSL : SL2 F) ∈ S := by
    rw [WSL_eq_uSL_vSL]
    exact mul_mem (mul_mem (hUall 1) (hV (-1) (by rw [map_neg, map_one]))) (hUall 1)
  have hVall : ∀ s, vSL s ∈ S := fun s => by
    rw [vSL_eq]
    exact mul_mem (mul_mem hW (hUall _)) (inv_mem hW)
  rw [eq_top_iff, ← closure_uSL_vSL, Subgroup.closure_le]
  rintro _ (⟨s, rfl⟩ | ⟨s, rfl⟩)
  · exact hUall s
  · exact hVall s

end SL2Gen

