theorem not_mulEquiv_alt {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p) {ε : Bool} {n : ℕ} (hn : 1 ≤ n)
    (hF : HasFixedPointFreeOrder ε n p) {Y : Type} [Group Y] [Finite Y] (hY : IsOmegaTwo ε (n + 1) Y)
