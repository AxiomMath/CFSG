theorem two_le_of_fpf {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p) {ε : Bool} {n : ℕ} (hn : 1 ≤ n)
    (hF : HasFixedPointFreeOrder ε n p) : 2 ≤ n := by
  by_contra h
  obtain rfl : n = 1 := by omega
  have hd := CFSG.HardMathSupport.Timmesfeld.OrthogonalGeneration.dvd_typeSign_of_hasFixedPointFreeOrder
    hp (by omega) le_rfl hF
  have hle : typeSign ε 1 ≤ 3 := by cases ε <;> decide
  have hpos : 0 < typeSign ε 1 := by cases ε <;> decide
  have := Nat.le_of_dvd hpos hd
  omega

theorem eq_minus_five_of_fpf_two {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p) {ε : Bool}
    (hF : HasFixedPointFreeOrder ε 2 p) : ε = false ∧ p = 5 := by
  have hd := CFSG.HardMathSupport.Timmesfeld.OrthogonalGeneration.dvd_typeSign_of_hasFixedPointFreeOrder
    hp (by omega) (by norm_num) hF
  cases ε with
  | true =>
    exfalso
    have h3 : typeSign true 2 = 3 := by decide
    rw [h3] at hd
    have := Nat.le_of_dvd (by norm_num) hd
    omega
  | false =>
    have h5 : typeSign false 2 = 5 := by decide
    rw [h5] at hd
    exact ⟨rfl, (Nat.prime_dvd_prime_iff_eq hp Nat.prime_five).1 hd⟩

