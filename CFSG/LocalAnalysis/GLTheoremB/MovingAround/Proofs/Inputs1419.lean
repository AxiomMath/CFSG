theorem not_pumpup_alt {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p) {ε : Bool} {n : ℕ} (hn : 1 ≤ n)
    (hF : HasFixedPointFreeOrder ε n p) {J : Type} [Group J] {K : Type} [Group K] [Finite K]
    (hK : CFSG.Open.IsQuasisimple K) (hO : GLAPPrimeCore p K = ⊥) (hJ : IsOmegaTwo ε (n + 1) J)
    {N : ℕ} (hN : 5 ≤ N) (f : (K ⧸ Subgroup.center K) ≃* alternatingGroup (Fin N)) (x : MulAut K)
    (hx : Lemma1314.PumpupVia p J K x) : False := by
  obtain ⟨hxo, J1, hJ1, ⟨eJ⟩⟩ := hx
  have hn2 := two_le_of_fpf hp hp5 hn hF
  haveI : Finite J := Finite.of_equiv _ eJ.toEquiv
  have hpodd : Odd p := hp.odd_of_ne_two (by omega)
  have hA : ∀ a ∈ Subgroup.zpowers x, a ^ p = 1 := by
    rintro a ⟨k, rfl⟩
    simp only
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, ← hxo, pow_orderOf_eq_one,
      one_zpow]
  obtain ⟨τ, -, hτ⟩ := AltFacts5.exists_tau hpodd hN hK.1 f hA
  set σ : Equiv.Perm (Fin N) := τ ⟨x, Subgroup.mem_zpowers x⟩ with hσ
  have hσp : σ ^ p = 1 := by
    rw [hσ, ← map_pow]
    have h1 : (⟨x, Subgroup.mem_zpowers x⟩ : ↥(Subgroup.zpowers x)) ^ p = 1 :=
      Subtype.ext (hA x (Subgroup.mem_zpowers x))
    rw [h1, map_one]
  have hJ1' : GLAPComponent p (CFSG.LocalAnalysis.GLTheoremB.MovingAround.fixSub x) J1 := by
    rw [← lemma1314_fixSub_eq]
    exact hJ1
  obtain ⟨hm5, ⟨g⟩⟩ := AltFacts5.component_alt hp (by omega) (AltFacts5.isAltRep_of_equiv f)
    (isPGroup_center hp hO) (fun y => hτ ⟨x, Subgroup.mem_zpowers x⟩ y) hσp hJ1'
  have hZJ : Subgroup.center J = ⊥ := center_eq_bot_of_isOmegaTwo hn2 hJ
  have hZ : Subgroup.center (barOf p J1) = ⊥ :=
    CFSG.LocalAnalysis.GLTheoremB.Prop95I1920.center_bot_of_mulEquiv eJ hZJ
  exact not_mulEquiv_alt hp hp5 hn hF hJ hm5
    ⟨eJ.symm.trans ((quotCenterEquivOfBot hZ).symm.trans g)⟩

