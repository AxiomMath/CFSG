  · rintro ⟨f⟩
    obtain ⟨rfl, -⟩ := eq_minus_five_of_fpf_two hp hp5 hF
    have hc := Nat.card_congr f.toEquiv
    rw [OmegaFacts2.card_eq_omegaOrd hp (by omega) hn hF hY, OmegaFacts.omegaOrd_three_minus] at hc
    have h2 := CFSG.HardMathSupport.Curtis.Coordinator.PLType.two_mul_card_alt_fin m hm
    exact CFSG.HardMathSupport.Curtis.Coordinator.PLType.factorial_ne_51840 hm (by rw [← h2, ← hc])
  · exact OmegaFacts2.not_mulEquiv_alt_of_three_le hp (by omega) hn3 hF hY m

