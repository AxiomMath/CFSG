theorem noOuterFixesCentralizer_fi24_seven {G : Type*} [Group G] (θ : G ≃* CFSG.Sporadic.Fi24.J) : NoOuterFixesCentralizer 7 G := by
  intro σ hσ2 hσi s hs
  by_contra hno
  push Not at hno
  obtain ⟨r, hr⟩ := conjJ_surjective ((θ.symm.trans σ).trans θ)
  have hrx : ∀ x : G, θ (σ x) = conjJ r (θ x) := fun x => by
    rw [hr]
    show θ (σ x) = θ (σ (θ.symm (θ x)))
    rw [MulEquiv.symm_apply_apply]
  have hσσ : σ * σ = 1 := by rw [← sq]; exact hσ2
  have hr2 : r * r = 1 := by
    apply CFSG.Sporadic.Fi24.conjJ_injective
    rw [map_mul, map_one, hr]
    refine MulEquiv.ext fun x => ?_
    show θ (σ (θ.symm (θ (σ (θ.symm x))))) = x
    rw [MulEquiv.symm_apply_apply, ← MulAut.mul_apply, hσσ, MulAut.one_apply, MulEquiv.apply_symm_apply]
  have hrJ : r ∉ JR := by
    intro hJ
    obtain ⟨j, rfl⟩ : r ∈ jR.range := by rw [CFSG.Sporadic.Fi24.range_jR]; exact hJ
    apply hσi
    refine ⟨θ.symm j, MulEquiv.ext fun x => θ.injective ?_⟩
    rw [MulAut.conj_apply, map_mul, map_mul, map_inv, MulEquiv.apply_symm_apply, hrx,
      CFSG.Sporadic.Fi24.conjJ_jR, MulAut.conj_apply]
  have hθs : orderOf (θ s) = 7 := by rw [MulEquiv.orderOf_eq, hs]
  have h3 : (Nat.card J).factorization 7 = 3 := by
    rw [CFSG.Sporadic.Fi24.card_J, show (1255205709190661721292800 : ℕ) = 7 ^ 3 * 3659491863529626009600 by norm_num,
      CFSG.HardMathSupport.Timmesfeld.SporadicBalance.CommutingPair.factorization_pow_mul (by norm_num) 3 _
        (by norm_num)]
  obtain ⟨X, hXC, hXp, hXcard⟩ := exists_pSubgroup_sq_le_centralizer (by norm_num) h3 hθs
  refine fi24_outer_no49 hr2 hrJ hXp (by rw [hXcard]; norm_num) fun x hx => ?_
  have hxc : x * θ s = θ s * x := CFSG.Sporadic.Fi24.mem_centralizer_J.1 (hXC hx)
  have hy : s * θ.symm x = θ.symm x * s := by
    apply θ.injective
    rw [map_mul, map_mul, MulEquiv.apply_symm_apply]
    exact hxc.symm
  have h1 : conjJ r x = x := by
    rw [← θ.apply_symm_apply x, ← hrx, hno _ hy]
  rw [mem_fi24CJ]
  have h2 := CFSG.Sporadic.Fi24.jR_conjJ r x
  rw [h1] at h2
  calc jR x * r = r * jR x * r⁻¹ * r := by rw [← h2]
    _ = r * jR x := by group

