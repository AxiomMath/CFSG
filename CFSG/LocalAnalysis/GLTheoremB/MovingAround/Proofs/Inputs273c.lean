@[expose] def CubeRow (s : TauCeti.SporadicName) (p : ℕ) : Prop :=
  (s = .HS ∧ p = 5) ∨ (s = .McL ∧ p = 5) ∨ (s = .Co2 ∧ p = 5) ∨ (s = .Co3 ∧ p = 5) ∨
    (s = .Ru ∧ p = 5) ∨ (s = .Th ∧ p = 5) ∨ (s = .He ∧ p = 7) ∨ (s = .ONan ∧ p = 7) ∨
    (s = .Fi24Prime ∧ p = 7) ∨ (s = .J4 ∧ p = 11) ∨ (s = .M ∧ p = 13)

instance (s : TauCeti.SporadicName) (p : ℕ) : Decidable (CubeRow s p) := by
  unfold CubeRow
  infer_instance

theorem cubeRow_table : ∀ s : TauCeti.SporadicName, ∀ p ∈ Finset.range 80, p.Prime → 5 ≤ p →
    p ^ 3 ∣ CFSG.AGLEmbedding.sporOrd s → ¬ p ^ 4 ∣ CFSG.AGLEmbedding.sporOrd s → CubeRow s p := by
  decide +kernel

theorem cubeRow_of (s : TauCeti.SporadicName) {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p)
    (h3 : p ^ 3 ∣ CFSG.AGLEmbedding.sporOrd s) (h4 : ¬ p ^ 4 ∣ CFSG.AGLEmbedding.sporOrd s) : CubeRow s p := by
  have hN : CFSG.AGLEmbedding.sporOrd s ≠ 0 := by cases s <;> simp [CFSG.AGLEmbedding.sporOrd]
  have hmem : p ∈ (CFSG.AGLEmbedding.sporOrd s).primeFactors :=
    Nat.mem_primeFactors.2 ⟨hp, (dvd_pow_self p three_ne_zero).trans h3, hN⟩
  exact cubeRow_table s p (Finset.mem_range.2 (CFSG.AGLEmbedding.primeFactors_lt s p hmem)) hp hp5 h3 h4

