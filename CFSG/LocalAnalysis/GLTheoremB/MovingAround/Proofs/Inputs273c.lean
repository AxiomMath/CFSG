theorem fixes_of_normal_selfCentralizing {G : Type*} [Group G] (σ : MulAut G) (hσ2 : σ ^ 2 = 1)
    {K N : Subgroup G} (hNn : ∀ k ∈ K, ∀ n ∈ N, k * n * k⁻¹ ∈ N)
    (hcent : ∀ k ∈ K, (∀ n ∈ N, k * n = n * k) → k ∈ N) (hodd : ∀ t ∈ N, t * t = 1 → t = 1)
    (hσK : ∀ k ∈ K, σ k ∈ K) (hσN : ∀ n ∈ N, σ n = n) : ∀ k ∈ K, σ k = k := by
  intro k hk
  have htK : k⁻¹ * σ k ∈ K := K.mul_mem (K.inv_mem hk) (hσK k hk)
  have htN : k⁻¹ * σ k ∈ N := by
    refine hcent _ htK fun n hn => ?_
    have h1 : σ (k * n * k⁻¹) = k * n * k⁻¹ := hσN _ (hNn k hk n hn)
    rw [map_mul, map_mul, map_inv, hσN n hn] at h1
    calc k⁻¹ * σ k * n = k⁻¹ * (σ k * n * (σ k)⁻¹) * σ k := by group
      _ = k⁻¹ * (k * n * k⁻¹) * σ k := by rw [h1]
      _ = n * (k⁻¹ * σ k) := by group
  have hσσ : σ (σ k) = k := by
    have := congrArg (fun f : MulAut G => f k) hσ2
    simpa [pow_two, MulAut.mul_apply] using this
  have htt : (k⁻¹ * σ k) * (k⁻¹ * σ k) = 1 := by
    have h2 : σ (k * (k⁻¹ * σ k)) = σ k * (k⁻¹ * σ k) := by rw [map_mul, hσN _ htN]
    rw [mul_inv_cancel_left, hσσ] at h2
    calc (k⁻¹ * σ k) * (k⁻¹ * σ k) = k⁻¹ * (σ k * (k⁻¹ * σ k)) := by group
      _ = k⁻¹ * k := by rw [← h2]
      _ = 1 := inv_mul_cancel k
  have h1 := hodd _ htN htt
  calc σ k = k * (k⁻¹ * σ k) := by group
    _ = k := by rw [h1, mul_one]

theorem le_of_isPGroup_of_normal_full {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    {K T X : Subgroup G} (hTK : T ≤ K) (hTn : ∀ k ∈ K, ∀ t ∈ T, k * t * k⁻¹ ∈ T)
    (hT : Nat.card T = p ^ (Nat.card K).factorization p) (hXK : X ≤ K) (hX : IsPGroup p X) : X ≤ T := by
  let S0 : Sylow p K := Sylow.ofCard (T.subgroupOf K)
    (by rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hTK).toEquiv, hT])
  have hS0 : (S0 : Subgroup K) = T.subgroupOf K := Sylow.coe_ofCard _ _
  have hn : (S0 : Subgroup K).Normal := by
    rw [hS0]
    exact ⟨fun t ht k => Subgroup.mem_subgroupOf.2 (by
      have := hTn k k.2 t (Subgroup.mem_subgroupOf.1 ht)
      simpa using this)⟩
  haveI := Sylow.unique_of_normal S0 hn
  have hX' : IsPGroup p (X.subgroupOf K) := hX.comap_of_injective K.subtype K.subtype_injective
  obtain ⟨S, hS⟩ := hX'.exists_le_sylow
  have hSS : S = S0 := Subsingleton.elim _ _
  intro x hx
  have h1 : (⟨x, hXK hx⟩ : K) ∈ X.subgroupOf K := Subgroup.mem_subgroupOf.2 hx
  have h2 := hS h1
  rw [hSS, hS0] at h2
  exact Subgroup.mem_subgroupOf.1 h2


