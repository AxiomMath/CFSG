theorem coreBot_of_normal_pGroup {G : Type*} [Group G] [Finite G] {p : ℕ} (hp : p.Prime) {C E : Subgroup G}
    (hEC : E ≤ C) (hEn : ∀ g ∈ C, ∀ e ∈ E, g * e * g⁻¹ ∈ E) (hEp : IsPGroup p E)
    (hfree : ∀ r ∈ C, (∀ e ∈ E, r * e = e * r) → Nat.Coprime (orderOf r) p → r = 1) :
    GLAPPrimeCoreOf p C = ⊥ := by
  set R := GLAPPrimeCoreOf p C with hR
  have hRE : R ⊓ E = ⊥ := inf_eq_bot_of_coprime_isPGroup hp (coprime_card_GLAPPrimeCoreOf hp C) hEp
  rw [eq_bot_iff]
  intro r hr
  have hrC : r ∈ C := GLAPPrimeCoreOf_le C hr
  refine Subgroup.mem_bot.2 (hfree r hrC (fun e he => ?_) ?_)
  · have h1 : r * e * r⁻¹ * e⁻¹ ∈ E := E.mul_mem (hEn r hrC e he) (E.inv_mem he)
    have h2 : r * e * r⁻¹ * e⁻¹ ∈ R := by
      have := R.mul_mem hr (GLAPPrimeCoreOf_conj_mem e (hEC he) r⁻¹ (R.inv_mem hr))
      simpa [mul_assoc] using this
    have h3 : r * e * r⁻¹ * e⁻¹ ∈ R ⊓ E := ⟨h2, h1⟩
    rw [hRE] at h3
    have h4 : r * e * r⁻¹ * e⁻¹ = 1 := h3
    rw [mul_inv_eq_one, mul_inv_eq_iff_eq_mul] at h4
    exact h4
  · have hd : orderOf r ∣ Nat.card R := by
      have := orderOf_dvd_natCard (⟨r, hr⟩ : R)
      rwa [Subgroup.orderOf_mk] at this
    exact Nat.Coprime.coprime_dvd_left hd (coprime_card_GLAPPrimeCoreOf hp C).symm

theorem conj_mem_of_card_le_two_mul {G : Type*} [Group G] [Finite G] {C E : Subgroup G}
    (hdvd : Nat.card E ∣ Nat.card C) (hle : Nat.card C ≤ 2 * Nat.card E) (hEC : E ≤ C) :
    ∀ g ∈ C, ∀ e ∈ E, g * e * g⁻¹ ∈ E := by
  have h1 := (E.subgroupOf C).card_mul_index
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hEC).toEquiv] at h1
  have hEpos : 0 < Nat.card E := Nat.card_pos
  obtain ⟨m, hm⟩ := hdvd
  rw [hm] at h1 hle
  have hidx : (E.subgroupOf C).index = m := Nat.eq_of_mul_eq_mul_left hEpos h1
  have hm2 : m ≤ 2 := Nat.le_of_mul_le_mul_left (by rw [mul_comm (Nat.card E) 2]; exact hle) hEpos
  have hm0 : m ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hm
    exact (Nat.card_pos (α := C)).ne' hm
  intro g hg e he
  rcases (by omega : m = 1 ∨ m = 2) with h | h
  · have htop : E.subgroupOf C = ⊤ := Subgroup.index_eq_one.1 (hidx.trans h)
    have hmem : (⟨g * e * g⁻¹, C.mul_mem (C.mul_mem hg (hEC he)) (C.inv_mem hg)⟩ : ↥C) ∈
        E.subgroupOf C := htop ▸ Subgroup.mem_top _
    exact Subgroup.mem_subgroupOf.1 hmem
  · have hn : (E.subgroupOf C).Normal := Subgroup.normal_of_index_eq_two (hidx.trans h)
    exact Subgroup.mem_subgroupOf.1 (hn.conj_mem ⟨e, hEC he⟩ (Subgroup.mem_subgroupOf.2 he) ⟨g, hg⟩)


