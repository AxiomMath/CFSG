theorem exists_pSubgroup_sq_le_centralizer {G : Type*} [Group G] [Finite G] {p : ℕ} (hp : p.Prime)
    (h3 : (Nat.card G).factorization p = 3) {s : G} (hs : orderOf s = p) :
    ∃ X : Subgroup G, X ≤ Subgroup.centralizer ({s} : Set G) ∧ IsPGroup p X ∧ Nat.card X = p ^ 2 := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hsp : IsPGroup p (Subgroup.zpowers s) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hs, pow_one])
  obtain ⟨P, hP⟩ := hsp.exists_le_sylow
  have hPcard : Nat.card (P : Subgroup G) = p ^ 3 := by rw [P.card_eq_multiplicity, h3]
  have hsP : s ∈ (P : Subgroup G) := hP (Subgroup.mem_zpowers s)
  haveI : Nontrivial ↥(P : Subgroup G) :=
    Finite.one_lt_card_iff_nontrivial.1 (by rw [hPcard]; exact Nat.one_lt_pow (by norm_num) hp.one_lt)
  have hZ := P.isPGroup'.bot_lt_center
  have hZp : IsPGroup p (Subgroup.center ↥(P : Subgroup G)) := P.isPGroup'.to_subgroup _
  obtain ⟨k, hk⟩ := hZp.exists_card_eq
  have hk0 : k ≠ 0 := by
    rintro rfl
    rw [pow_zero] at hk
    exact hZ.ne' (Subgroup.eq_bot_of_card_eq _ hk)
  obtain ⟨z₀, hz₀⟩ := exists_prime_orderOf_dvd_card' (G := Subgroup.center ↥(P : Subgroup G)) p
    (by rw [hk]; exact dvd_pow_self p hk0)
  set z : G := ((z₀ : ↥(P : Subgroup G)) : G) with hz
  have hzo : orderOf z = p := by rw [hz, Subgroup.orderOf_coe, Subgroup.orderOf_coe, hz₀]
  have hzc : ∀ y ∈ (P : Subgroup G), y * z = z * y := fun y hy =>
    congrArg Subtype.val (Subgroup.mem_center_iff.1 z₀.2 ⟨y, hy⟩)
  have hsz : s * z = z * s := hzc s hsP
  by_cases hdisj : Subgroup.zpowers s ⊓ Subgroup.zpowers z = ⊥
  · refine ⟨Subgroup.zpowers s ⊔ Subgroup.zpowers z, sup_le ?_ ?_, ?_, ?_⟩
    · exact (Subgroup.zpowers_le).2 (Subgroup.mem_centralizer_singleton_iff.2 rfl)
    · exact (Subgroup.zpowers_le).2 (Subgroup.mem_centralizer_singleton_iff.2 hsz.symm)
    · refine IsPGroup.of_card (n := 2) ?_
      rw [GL83.CompFam.card_sup_of_commute_of_inf_eq_bot ?_ hdisj, Nat.card_zpowers, Nat.card_zpowers, hs, hzo,
        pow_two]
      intro a ha b hb
      obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.1 ha
      obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.1 hb
      exact (Commute.zpow_zpow (show Commute s z from hsz) i j).eq
    · rw [GL83.CompFam.card_sup_of_commute_of_inf_eq_bot ?_ hdisj, Nat.card_zpowers, Nat.card_zpowers, hs, hzo,
        pow_two]
      intro a ha b hb
      obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.1 ha
      obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.1 hb
      exact (Commute.zpow_zpow (show Commute s z from hsz) i j).eq
  ·
    have hsz' : s ∈ Subgroup.zpowers z := by
      have hd : Nat.card ↥(Subgroup.zpowers s ⊓ Subgroup.zpowers z) ∣ p := by
        rw [← hs, ← Nat.card_zpowers]
        exact Subgroup.card_dvd_of_le inf_le_left
      rcases (Nat.dvd_prime hp).1 hd with h1 | h7
      · exact absurd (Subgroup.eq_bot_of_card_eq _ h1) hdisj
      · have heq : Subgroup.zpowers s ⊓ Subgroup.zpowers z = Subgroup.zpowers s :=
          Subgroup.eq_of_le_of_card_ge inf_le_left (by rw [h7, Nat.card_zpowers, hs])
        have : s ∈ Subgroup.zpowers s ⊓ Subgroup.zpowers z := by
          rw [heq]
          exact Subgroup.mem_zpowers s
        exact this.2
    obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 hsz'
    have hPC : (P : Subgroup G) ≤ Subgroup.centralizer ({z ^ m} : Set G) := fun y hy =>
      Subgroup.mem_centralizer_singleton_iff.2 (Commute.zpow_right (show Commute y z from hzc y hy) m).eq
    obtain ⟨H, hH⟩ := Sylow.exists_subgroup_card_pow_prime p (G := ↥(P : Subgroup G)) (n := 2)
      (by rw [hPcard]; exact pow_dvd_pow p (by norm_num))
    refine ⟨H.map (P : Subgroup G).subtype, (Subgroup.map_subtype_le H).trans hPC, ?_, ?_⟩
    · exact IsPGroup.of_card (n := 2)
        (by rw [Subgroup.card_map_of_injective (P : Subgroup G).subtype_injective, hH])
    · rw [Subgroup.card_map_of_injective (P : Subgroup G).subtype_injective, hH]

theorem smul_eq_of_pow_prime_pow {G α : Type*} [Group G] [MulAction G α] {p n : ℕ} (hp : p.Prime) {g : G}
    (hg : g ^ (p ^ n) = 1) (K : Finset α) (hK : K.card < p) (hinv : ∀ i : ℕ, ∀ k ∈ K, g ^ i • k ∈ K)
    {k : α} (hk : k ∈ K) : g • k = k := by
  obtain ⟨i, hi, j, hj, hij, heq⟩ := Finset.exists_ne_map_eq_of_card_lt_of_maps_to
    (s := Finset.range (K.card + 1)) (t := K) (f := fun i => g ^ i • k) (by simp)
    (fun i _ => hinv i k hk)
  have key : ∀ a b : ℕ, a < b → b ≤ K.card → g ^ a • k = g ^ b • k → g • k = k := by
    intro a b hab hb hab'
    have hm : g ^ (b - a) • k = k := by
      have h1 : (g ^ a)⁻¹ • (g ^ a • k) = (g ^ a)⁻¹ • (g ^ b • k) := by rw [hab']
      rw [inv_smul_smul, smul_smul] at h1
      have h2 : (g ^ a)⁻¹ * g ^ b = g ^ (b - a) := by
        rw [← pow_sub_mul_pow g hab.le, (Commute.pow_pow_self g (b - a) a).eq, inv_mul_cancel_left]
      rw [h2] at h1
      exact h1.symm
    have hm0 : 0 < b - a := by omega
    have hmp : b - a < p := by omega
    have hcop : Nat.Coprime (b - a) (p ^ n) :=
      Nat.Coprime.pow_right n (Nat.coprime_of_lt_prime (by omega) hmp hp).symm
    have hS1 : g ^ (b - a) ∈ MulAction.stabilizer G k := hm
    have hS2 : g ^ (p ^ n) ∈ MulAction.stabilizer G k := by rw [hg]; exact Subgroup.one_mem _
    have hb' := Nat.gcd_eq_gcd_ab (b - a) (p ^ n)
    rw [hcop.gcd_eq_one, Nat.cast_one] at hb'
    have hg1 : g = (g ^ (b - a)) ^ (Nat.gcdA (b - a) (p ^ n)) * (g ^ (p ^ n)) ^ (Nat.gcdB (b - a) (p ^ n)) := by
      rw [← zpow_natCast, ← zpow_natCast g (p ^ n), ← zpow_mul, ← zpow_mul, ← zpow_add, ← hb', zpow_one]
    have hgS : g ∈ MulAction.stabilizer G k := by
      rw [hg1]
      exact Subgroup.mul_mem _ (Subgroup.zpow_mem _ hS1 _) (Subgroup.zpow_mem _ hS2 _)
    exact hgS
  simp only [Finset.mem_range] at hi hj
  rcases lt_or_gt_of_ne hij with h | h
  · exact key i j h (by omega) heq
  · exact key j i h (by omega) heq.symm

end CubeGeneric

