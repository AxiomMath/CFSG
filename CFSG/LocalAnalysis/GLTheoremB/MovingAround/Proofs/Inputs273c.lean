    (h : ∀ s p, CubeRow s p → CubePairHolds s p) : Inputs273.SporOneBalanceCube := by
  intro S _ _ hS hnab name ⟨e⟩ p hp hp5 h3 h4
  have e' : S ≃* CFSG.Blueprint.NativeSporadic.Carrier name := e.trans (hBr name).some.symm
  have hc : Nat.card S = CFSG.AGLEmbedding.sporOrd name := (Nat.card_congr e'.toEquiv).trans (hcard name)
  rw [hc] at h3 h4
  exact h name p (cubeRow_of name hp hp5 h3 h4) S hS hnab ⟨e'⟩

