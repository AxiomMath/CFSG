theorem forall_of_lines {G : Type*} [Group G] [Finite G] {p : ℕ} (hp : p.Prime) {P Q : Subgroup G}
    (hQP : Q ≤ P) (hQ : Nat.card Q = p ^ (Nat.card P).factorization p) {ι : Type*} (line : ι → G)
    (hlines : ∀ H : Subgroup G, H ≤ Q → Nat.card H = p → ∃ j, H = Subgroup.zpowers (line j))
    (Φ : G → Prop) (hΦc : ∀ g ∈ P, ∀ x, Φ x → Φ (g * x * g⁻¹))
    (hΦz : ∀ a b, Subgroup.zpowers a = Subgroup.zpowers b → Φ a → Φ b)
    (hline : ∀ j, Φ (line j)) : ∀ y ∈ P, orderOf y = p → Φ y := by
  have : Fact p.Prime := ⟨hp⟩
  intro y hyP hyo
  obtain ⟨g, hgP, hgQ⟩ := Co3T.exists_conj_mem_of_full hQP hQ hyP hyo
  set t := g⁻¹ * y * g with htdef
  have hto : orderOf t = p := by
    have := (MulAut.conj g⁻¹ : G ≃* G).orderOf_eq y
    simpa [MulAut.conj_apply, htdef, hyo] using this
  obtain ⟨j, hj⟩ := hlines (Subgroup.zpowers t) ((Subgroup.zpowers_le).2 hgQ)
    (by rw [Nat.card_zpowers, hto])
  have ht : Φ t := hΦz _ _ hj.symm (hline j)
  have hy : y = g * t * g⁻¹ := by rw [htdef]; group
  rw [hy]
  exact hΦc g hgP t ht

theorem coreBot_conj {M : Type*} [Group M] {p : ℕ} {R : Subgroup M} {k : M} (hk : k ∈ R) {x : M}
    (h : GLAPPrimeCoreOf p (Subgroup.centralizer ({x} : Set M) ⊓ R) = ⊥) :
    GLAPPrimeCoreOf p (Subgroup.centralizer ({k * x * k⁻¹} : Set M) ⊓ R) = ⊥ :=
  CFSG.HardMathSupport.Dickson.LocalTwoBalance.ltbFive_conj_bot hk h

theorem coreBot_zpowers {M : Type*} [Group M] [Finite M] {p : ℕ} {R : Subgroup M} {a b : M}
    (hab : Subgroup.zpowers a = Subgroup.zpowers b)
    (h : GLAPPrimeCoreOf p (Subgroup.centralizer ({a} : Set M) ⊓ R) = ⊥) :
    GLAPPrimeCoreOf p (Subgroup.centralizer ({b} : Set M) ⊓ R) = ⊥ := by
  rwa [← centralizer_singleton_eq_of_zpowers hab]

theorem coreBot_of_records {M : Type*} [Group M] [Finite M] {p : ℕ} (hp : p.Prime) {P Q R : Subgroup M}
    (hPR : P ≤ R) (hQP : Q ≤ P) (hQsyl : ∃ S : Sylow p P, (S : Subgroup P) = Q.subgroupOf P)
    {ι : Type*} {line k : ι → M} {rec : ι → ι}
    (hlines : {H : Subgroup M | H ≤ Q ∧ Nat.card H = p} = Set.range fun j => Subgroup.zpowers (line j))
    (htrans : ∀ j, k j ∈ R ∧ k j * line (rec j) * (k j)⁻¹ = line j)
    (hrec : ∀ j, GLAPPrimeCoreOf p (Subgroup.centralizer ({line (rec j)} : Set M) ⊓ R) = ⊥) :
    ∀ y ∈ P, orderOf y = p → GLAPPrimeCoreOf p (Subgroup.centralizer ({y} : Set M) ⊓ R) = ⊥ := by
  have : Fact p.Prime := ⟨hp⟩
  refine forall_of_lines hp hQP (card_eq_of_sylow_subgroupOf hQP hQsyl) line (lines_of_eq hlines)
    (fun x => GLAPPrimeCoreOf p (Subgroup.centralizer ({x} : Set M) ⊓ R) = ⊥)
    (fun g hg x hx => coreBot_conj (hPR hg) hx) (fun a b hab h => coreBot_zpowers hab h) fun j => ?_
  obtain ⟨hkR, hkc⟩ := htrans j
  rw [← hkc]
  exact coreBot_conj hkR (hrec j)

theorem oPrimeCoreTrivialAt_of_inf {M : Type*} [Group M] {p : ℕ} {P : Subgroup M}
    (h : ∀ y ∈ P, orderOf y = p → GLAPPrimeCoreOf p (Subgroup.centralizer ({y} : Set M) ⊓ P) = ⊥) :
    OPrimeCoreTrivialAt p ↥P := by
  intro s hs
  have hmap := map_glaPPrimeCoreOf_of_injective p P.subtype P.subtype_injective
    (Subgroup.centralizer ({s} : Set ↥P))
  rw [map_centralizer_subtype, h s s.2 (by rw [Subgroup.orderOf_coe]; exact hs)] at hmap
  exact (Subgroup.map_eq_bot_iff_of_injective _ P.subtype_injective).1 hmap

theorem isLocallyOneBalancedAbs_of_autModel {M : Type*} [Group M] [Finite M] {P R : Subgroup M}
    {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (h : AutModel P R) {S : Type*} [Group S] [Finite S]
    (θ : S ≃* P) (hcen : Subgroup.center S = ⊥) (hout : Nat.card (Outer S) ≤ 2)
    (hall : ∀ y : P, orderOf y = p →
      GLAPPrimeCoreOf p (Subgroup.centralizer ({(y : M)} : Set M) ⊓ R) = ⊥) :
    IsLocallyOneBalancedAbs p S := by
  have hinj : Function.Injective (MulAut.conj : S →* MulAut S) :=
    conj_injective_of_center_eq_bot hcen
  set κ : MulAut S →* M := h.hom.comp (MulAut.congr θ).toMonoidHom with hκ
  have hκinj : Function.Injective κ := h.hom_injective.comp (MulAut.congr θ).injective
  have hκR : ∀ α, κ α ∈ R := fun α => h.elt_mem _
  have hκsurj : ∀ x ∈ R, ∃ α, κ α = x := fun x hx =>
    ⟨(MulAut.congr θ).symm (autOfMem h x hx), by
      simp only [hκ, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.apply_symm_apply]
      exact hom_autOfMem h hx⟩
  have hκinn : ∀ s : S, κ (MulAut.conj s) = (θ s : M) := by
    intro s
    refine h.elt_eq (h.le (θ s).2) fun q => ?_
    simp [MulAut.congr_apply, MulAut.conj_apply]
  intro x hx H hH _
  have hHn : H.Normal := by
    have hidx : H.index ∣ (innerAut S).index := Subgroup.index_dvd_of_le hH
    have h2 : (innerAut S).index ≤ 2 := hout
    have h0 : (innerAut S).index ≠ 0 := Subgroup.FiniteIndex.index_ne_zero
    have : H.index ≤ 2 := (Nat.le_of_dvd (Nat.pos_of_ne_zero h0) hidx).trans h2
    interval_cases hi : H.index
    · exact absurd hi (Subgroup.FiniteIndex.index_ne_zero)
    · exact (Subgroup.index_eq_one.1 hi) ▸ inferInstance
    · exact Subgroup.normal_of_index_eq_two hi
  have hcop : Nat.Coprime p (Nat.card (Outer S)) :=
    coprime_of_le_two hp hp2 Nat.card_pos.ne' hout
  have hxp : IsPGroup p (Subgroup.zpowers x) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hx, pow_one])
  have hxi : x ∈ innerAut S := le_inner_of_isPGroup hcop hxp (Subgroup.mem_zpowers x)
  obtain ⟨d, rfl⟩ := hxi
  have hdo : orderOf d = p := by rw [← hx, orderOf_injective _ hinj d]
  have hmap := map_glaPPrimeCoreOf_of_injective p κ hκinj
    (H ⊓ Subgroup.centralizer ({MulAut.conj d} : Set (MulAut S)))
  have hX : (H ⊓ Subgroup.centralizer ({MulAut.conj d} : Set (MulAut S))).map κ =
      Subgroup.centralizer ({((θ d : P) : M)} : Set M) ⊓ H.map κ := by
    ext y
    simp only [Subgroup.mem_map, Subgroup.mem_inf, Subgroup.mem_centralizer_singleton_iff]
    constructor
    · rintro ⟨α, ⟨hαH, hαc⟩, rfl⟩
      refine ⟨?_, α, hαH, rfl⟩
      have := congrArg κ hαc
      rw [map_mul, map_mul, hκinn] at this
      exact this
    · rintro ⟨hyc, α, hαH, rfl⟩
      refine ⟨α, ⟨hαH, ?_⟩, rfl⟩
      apply hκinj
      rw [map_mul, map_mul, hκinn]
      exact hyc
  have hHR : H.map κ ≤ R := by
    rintro _ ⟨α, -, rfl⟩
    exact hκR α
  have hnorm : ∀ r ∈ R, ∀ q ∈ H.map κ, r * q * r⁻¹ ∈ H.map κ := by
    intro r hr q hq
    obtain ⟨β, rfl⟩ := hκsurj r hr
    obtain ⟨α, hα, rfl⟩ := hq
    exact ⟨β * α * β⁻¹, hHn.conj_mem α hα β, by simp⟩
  have hle := gLAPPrimeCoreOf_inf_le_of_ambient hp hHR hnorm ((θ d : P) : M)
  have hdO : GLAPPrimeCoreOf p (Subgroup.centralizer ({((θ d : P) : M)} : Set M) ⊓ R) = ⊥ :=
    hall (θ d) (by rw [MulEquiv.orderOf_eq, hdo])
  rw [hdO] at hle
  have : (GLAPPrimeCoreOf p (H ⊓ Subgroup.centralizer ({MulAut.conj d} : Set (MulAut S)))).map κ =
      ⊥ := by
    rw [hmap, hX]
    exact le_bot_iff.1 hle
  exact (Subgroup.map_eq_bot_iff_of_injective _ hκinj).1 this

theorem isLocallyOneBalancedAbs_of_inner_eq_top {S : Type*} [Group S] [Finite S] {p : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (hcen : Subgroup.center S = ⊥) (hinn : innerAut S = ⊤) (h : OPrimeCoreTrivialAt p S) :
    IsLocallyOneBalancedAbs p S := by
  have hout : Nat.card (Outer S) ≤ 2 := by
    have h1 : Nat.card (Outer S) = (inner S).index := rfl
    have h2 : inner S = ⊤ := hinn
    rw [h1, h2, Subgroup.index_top]
    norm_num
  exact isLocallyOneBalancedAbs_of_parts hp hp2 hcen hout h (noOuterFixesCentralizer_of_inner_eq_top p hinn)

