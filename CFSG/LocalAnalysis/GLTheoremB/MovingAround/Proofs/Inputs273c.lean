  ∀ (S : Type) [Group S] [Finite S], IsSimpleGroup S → (∃ a b : S, a * b ≠ b * a) →
    Nonempty (S ≃* CFSG.Blueprint.NativeSporadic.Carrier name) → IsLocallyOneBalancedAbs p S

theorem cubePairHolds_of_onePair {name : TauCeti.SporadicName} {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hOut : SporadicOuterLeTwo) (hBr : CFSG.HardMathSupport.Timmesfeld.Tables.Census.SporadicBridges)
    (h : SporadicOnePairHolds name p) : CubePairHolds name p := by
