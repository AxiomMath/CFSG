variable {G : Type} [Group G] [Finite G]

theorem commutator_top_eq_top_of_simple (hsimple : IsSimpleGroup G)
    (hnonab : ∃ a b : G, a * b ≠ b * a) :
    ⁅(⊤ : Subgroup G), (⊤ : Subgroup G)⁆ = ⊤ :=
  haveI := hsimple
  CFSG.Wreathed.commutator_eq_top_of_nonabelian_simple hnonab

theorem le_of_isSylowIn_normalizer {p : ℕ} {W Q : Subgroup G} (hW : IsPGroup p ↥W)
    (hQ : IsSylowIn p (Subgroup.normalizer (W : Set G)) Q) : W ≤ Q := by
  have hsup : IsPGroup p ↥(Q ⊔ W) := IsPGroup.to_sup_of_normal_right' hQ.2.1 hW hQ.1
  have heq := hQ.2.2 _ (sup_le hQ.1 Subgroup.le_normalizer) hsup le_sup_left
  rw [← heq]
  exact le_sup_right

theorem normalizer_le_of_weaklyClosed {W Q : Subgroup G} (hWQ : W ≤ Q)
    (hwc : ∀ g : G, GLBConj g W ≤ Q → GLBConj g W = W) :
    Subgroup.normalizer (Q : Set G) ≤ Subgroup.normalizer (W : Set G) := by
  intro x hx
  rw [mem_normalizer_iff_gLBConj_eq]
  exact hwc x ((gLBConj_mono x hWQ).trans (gLBConj_eq_of_mem_normalizer hx).le)

theorem mem_normalizer_of_alperinDecomposition {p : ℕ} {S P W : Subgroup G} {c : G}
    (hWS : W ≤ S) (hSW : S ≤ Subgroup.centralizer (W : Set G))
    (hwc : ∀ g : G, GLBConj g W ≤ S → GLBConj g W = W)
    (h : CFSG.RankTwoShapes.AlperinDecomposition p S P c) :
    c ∈ Subgroup.normalizer (W : Set G) := by
  induction h with
  | one => exact one_mem _
  | @step c n R _ hR _ hn ih =>
    refine mul_mem ih ?_
    have hWR : W ≤ R := by
      intro w hw
      apply hR.2.2.1
      refine Subgroup.mem_inf.2 ⟨?_, hWS hw⟩
      rw [Subgroup.mem_centralizer_iff]
      intro r hr
      exact (Subgroup.mem_centralizer_iff.1 (hSW (hR.1 hr)) w hw).symm
    rw [mem_normalizer_iff_gLBConj_eq]
    exact hwc n ((gLBConj_mono n hWR).trans ((gLBConj_eq_of_mem_normalizer hn).le.trans hR.1))

theorem exists_mem_normalizer_conj_eq {p : ℕ} [Fact p.Prime] {S : Sylow p G} {W : Subgroup G}
    (hWS : W ≤ (S : Subgroup G)) (hSW : (S : Subgroup G) ≤ Subgroup.centralizer (W : Set G))
    (hwc : ∀ g : G, GLBConj g W ≤ (S : Subgroup G) → GLBConj g W = W)
    {x g : G} (hx : x ∈ (S : Subgroup G)) (hgx : g * x * g⁻¹ ∈ (S : Subgroup G)) :
    ∃ c ∈ Subgroup.normalizer (W : Set G), c⁻¹ * x * c = g * x * g⁻¹ := by
  have hP : Subgroup.zpowers x ≤ (S : Subgroup G) := Subgroup.zpowers_le.2 hx
  have hPg : (Subgroup.zpowers x).map (MulAut.conj (g⁻¹)⁻¹).toMonoidHom ≤ (S : Subgroup G) := by
    rw [MonoidHom.map_zpowers]
    exact Subgroup.zpowers_le.2 (by simpa using hgx)
  obtain ⟨c, hc, hcg⟩ := CFSG.RankTwoShapes.alperin_centric_radical_fusion S hP hPg
  refine ⟨c, mem_normalizer_of_alperinDecomposition hWS hSW hwc hc, ?_⟩
  have h1 := hcg x (Subgroup.mem_zpowers x)
  rw [inv_inv] at h1
  exact h1

theorem le_commutator_normalizer_of_weaklyClosed {p : ℕ} [Fact p.Prime]
    (hperf : ⁅(⊤ : Subgroup G), (⊤ : Subgroup G)⁆ = ⊤) {W Q : Subgroup G} (hW : IsPGroup p ↥W)
    (hQ : IsSylowIn p (Subgroup.normalizer (W : Set G)) Q)
    (hQW : Q ≤ Subgroup.centralizer (W : Set G))
    (hwc : ∀ g : G, GLBConj g W ≤ Q → GLBConj g W = W) :
    Q ≤ ⁅Subgroup.normalizer (W : Set G), Subgroup.normalizer (W : Set G)⁆ := by
  have hWQ : W ≤ Q := le_of_isSylowIn_normalizer hW hQ
  have hQtop : IsSylowIn p ⊤ Q :=
    isSylowIn_top_of_normalizer_le hQ (normalizer_le_of_weaklyClosed hWQ hwc)
  let S : Sylow p G := ⟨Q, hQtop.2.1, fun hR hle => hQtop.2.2 _ le_top hR hle⟩
  have hfoc := Subgroup.commutator_inf_eq_focalSubgroup S
  rw [_root_.commutator_def, hperf, top_inf_eq] at hfoc
  have hle : (S : Subgroup G).focalSubgroup ≤
      ⁅Subgroup.normalizer (W : Set G), Subgroup.normalizer (W : Set G)⁆ := by
    rw [Subgroup.focalSubgroup_def, Subgroup.closure_le]
    rintro _ ⟨hgP, x, hxP, u, rfl⟩
    have h1 : u * x⁻¹ * u⁻¹ ∈ (S : Subgroup G) := by
      have e : u * x⁻¹ * u⁻¹ = x⁻¹ * ⁅x, u⁆ := by rw [commutatorElement_def]; group
      rw [e]
      exact mul_mem (inv_mem hxP) hgP
    obtain ⟨c, hc, hcx⟩ := exists_mem_normalizer_conj_eq (S := S) hWQ hQW hwc (inv_mem hxP) h1
    have e2 : ⁅x, u⁆ = ⁅x, c⁻¹⁆ := by
      rw [commutatorElement_def, commutatorElement_def, inv_inv]
      calc x * u * x⁻¹ * u⁻¹ = x * (u * x⁻¹ * u⁻¹) := by group
        _ = x * (c⁻¹ * x⁻¹ * c) := by rw [hcx]
        _ = x * c⁻¹ * x⁻¹ * c := by group
    rw [SetLike.mem_coe, e2]
    exact Subgroup.commutator_mem_commutator (hQ.1 hxP) (inv_mem hc)
  exact hfoc.le.trans hle

theorem le_commutator_normalizer (hperf : ⁅(⊤ : Subgroup G), (⊤ : Subgroup G)⁆ = ⊤)
    (z : G) (Q : Subgroup G) (hz : orderOf z = 3)
    (hQ : IsSylowIn 3 (Subgroup.normalizer (Subgroup.zpowers z : Set G)) Q)
    (hQz : ∀ q ∈ Q, q * z = z * q)
    (hwc : ∀ g : G, GLBConj g (Subgroup.zpowers z) ≤ Q →
      GLBConj g (Subgroup.zpowers z) = Subgroup.zpowers z) :
    Q ≤ ⁅Subgroup.normalizer (Subgroup.zpowers z : Set G),
      Subgroup.normalizer (Subgroup.zpowers z : Set G)⁆ := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hzp : IsPGroup 3 ↥(Subgroup.zpowers z) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hz, pow_one])
  have hQW : Q ≤ Subgroup.centralizer (Subgroup.zpowers z : Set G) := by
    intro q hq
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hw
    exact ((Commute.zpow_right (hQz q hq) k).eq).symm
  exact le_commutator_normalizer_of_weaklyClosed hperf hzp hQ hQW hwc

theorem grun_hom' {T : Type} [Group T] [IsMulCommutative T]
    (hperf : ⁅(⊤ : Subgroup G), (⊤ : Subgroup G)⁆ = ⊤)
    (z : G) (Q : Subgroup G) (hz : orderOf z = 3)
    (hQ : IsSylowIn 3 (Subgroup.normalizer (Subgroup.zpowers z : Set G)) Q)
    (hQz : ∀ q ∈ Q, q * z = z * q)
    (hwc : ∀ g : G, GLBConj g (Subgroup.zpowers z) ≤ Q →
      GLBConj g (Subgroup.zpowers z) = Subgroup.zpowers z)
    (Φ : ↥(Subgroup.normalizer (Subgroup.zpowers z : Set G)) →* T) :
    ∀ (q : G) (hq : q ∈ Q), Φ ⟨q, hQ.1 hq⟩ = 1 := by
  intro q hq
  have h1 := le_commutator_normalizer hperf z Q hz hQ hQz hwc hq
  rw [← Subgroup.map_subtype_commutator] at h1
  obtain ⟨n, hn, hnq⟩ := Subgroup.mem_map.1 h1
  have hn' : n = ⟨q, hQ.1 hq⟩ := Subtype.ext hnq
  rw [← hn']
  exact Abelianization.commutator_subset_ker Φ hn

theorem claim113A_clause7' {K Q X A : Subgroup G} {e : G}
    (hsimple : IsSimpleGroup G) (hnonab : ∃ a b : G, a * b ≠ b * a)
    (e0 : barOf 3 K ≃* PSL2 (GaloisField 3 3))
    (hX : X = Subgroup.centralizer ({e} : Set G))
    (hQ : IsSylowIn 3 X Q) (hQ1 : Q ≠ ⊥) (hXN : X ≤ Subgroup.normalizer (K : Set G))
    (hKX : K ≤ X) (hK : IsLTwoTwentySeven (barOf 3 K)) (hcyc : IsCyclic ↥(centBar 3 Q K))
    (he3 : e ^ 3 = 1) (he1 : e ≠ 1) (heQ : e ∈ Q)
    (hNK : Subgroup.normalizer (Subgroup.zpowers e : Set G) ≤ Subgroup.normalizer (K : Set G))
    (hAQ : A ≤ Q) (hAel : IsElemAbelian 3 A) (hAcard : Nat.card ↥A = 27)
    (hAmax : ∀ F : Subgroup G, F ≤ ⊤ → IsElemAbelian 3 F → A ≤ F → F = A) :
    ∃ g : G, GLBConj g (Subgroup.zpowers e) ≤ Q ∧
      GLBConj g (Subgroup.zpowers e) ≠ Subgroup.zpowers e := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  by_contra hcon
  have hcon' : ∀ g : G, GLBConj g (Subgroup.zpowers e) ≤ Q →
      GLBConj g (Subgroup.zpowers e) = Subgroup.zpowers e := by
    intro g hg
    by_contra hne
    exact hcon ⟨g, hg, hne⟩
  have hsylN : IsSylowIn 3 (Subgroup.normalizer (Subgroup.zpowers e : Set G)) Q :=
    isSylowIn_normalizer_zpowers hX hQ he3 he1
  have hord : orderOf e = 3 := orderOf_eq_prime he3 he1
  have hcomm : ∀ q ∈ Q, q * e = e * q := by
    intro q hq
    have hqX : q ∈ X := hQ.1 hq
    rw [hX] at hqX
    exact (Subgroup.mem_centralizer_iff.1 hqX e (Set.mem_singleton e)).symm
  obtain ⟨x, hxA, hxN⟩ :=
    exists_mem_not_mem_sup hQ hQ1 hXN hKX hK hcyc
      (fun k hk => by
        have hkX : k ∈ X := hKX hk
        rw [hX] at hkX
        exact Subgroup.mem_centralizer_iff.1 hkX e (Set.mem_singleton e))
      he3 he1 heQ hAmax hAel hAcard
  have hxQ : x ∈ Q := hAQ hxA
  have hx3 : x ^ 3 = 1 := hAel.2 x hxA
  have hQK : Q ≤ Subgroup.normalizer (K : Set G) := hQ.1.trans hXN
  have hU27 : Nat.card ↥(Ubar hQK) = 27 := Ubar_card hQ hQ1 hXN hKX hK
  let N : Subgroup G := Subgroup.normalizer (Subgroup.zpowers e : Set G)
  let Φ : ↥N →* (GaloisField 3 3 ≃+* GaloisField 3 3) :=
    (galHom e0).comp ((barAut 3 K).comp (Subgroup.inclusion hNK))
  have hΦ3 : Nat.card (GaloisField 3 3 ≃+* GaloisField 3 3) = 3 := finite_ringAut_card
  haveI : IsCyclic (GaloisField 3 3 ≃+* GaloisField 3 3) := isCyclic_of_prime_card hΦ3
  have hΦx : Φ ⟨x, hsylN.1 hxQ⟩ ≠ 1 := galHom_rho_ne_one e0 hQ.2.1 hQK hU27 hxQ hx3 hxN
  exact hΦx (grun_hom' (commutator_top_eq_top_of_simple hsimple hnonab) e Q hord hsylN hcomm
    hcon' Φ x hxQ)

