@[expose] def InnerStepAt (p : ℕ) (S : Type) [Group S] : Prop :=
  ∀ x y : MulAut S, x ∈ innerAut S → y ∈ innerAut S → orderOf x = p → y ^ p = 1 → x * y = y * x →
    ∀ t ∈ pCoreOf 2 (innerAut S ⊓ Subgroup.centralizer ({x} : Set (MulAut S))), y * t = t * y

theorem card_zpowers_sup_zpowers {G : Type*} [Group G] [Finite G] {p : ℕ} (hp : p.Prime)
    {x y : G} (hxy : x * y = y * x) (hx : orderOf x = p) (hy : orderOf y = p)
    (hyx : y ∉ Subgroup.zpowers x) :
    Nat.card ↥(Subgroup.zpowers x ⊔ Subgroup.zpowers y) = p ^ 2 := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hpow : ∀ z : G, orderOf z = p → IsPGroup p (Subgroup.zpowers z) := fun z hz =>
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hz, pow_one])
  have hxcent : x ∈ Subgroup.centralizer ((Subgroup.zpowers y : Subgroup G) : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hh
    exact (Commute.zpow_left (show Commute y x from hxy.symm) k).eq
  have hnorm : Subgroup.zpowers x ≤ Subgroup.normalizer (Subgroup.zpowers y : Set G) :=
    (Subgroup.zpowers_le.mpr hxcent).trans (Subgroup.centralizer_le_normalizer _)
  have hF : IsPGroup p ↥(Subgroup.zpowers x ⊔ Subgroup.zpowers y) :=
    (hpow x hx).to_sup_of_normal_right' (hpow y hy) hnorm
  obtain ⟨n, hn⟩ := (IsPGroup.iff_card).mp hF
  have hle : Nat.card ↥(Subgroup.zpowers x ⊔ Subgroup.zpowers y) ≤ p * p := by
    have h1 := Subgroup.coe_mul_of_left_le_normalizer_right _ _ hnorm
    calc Nat.card ↥(Subgroup.zpowers x ⊔ Subgroup.zpowers y)
        = Nat.card (((Subgroup.zpowers x ⊔ Subgroup.zpowers y : Subgroup G)) : Set G) := rfl
      _ = Nat.card ((Subgroup.zpowers x : Set G) * (Subgroup.zpowers y : Set G)) := by rw [h1]
      _ ≤ Nat.card (Subgroup.zpowers x : Set G) * Nat.card (Subgroup.zpowers y : Set G) :=
          Set.natCard_mul_le
      _ = p * p := by
          change Nat.card (Subgroup.zpowers x) * Nat.card (Subgroup.zpowers y) = p * p
          rw [Nat.card_zpowers, Nat.card_zpowers, hx, hy]
  have hlt : p < Nat.card ↥(Subgroup.zpowers x ⊔ Subgroup.zpowers y) := by
    by_contra hge
    push Not at hge
    have hxle : Subgroup.zpowers x ≤ Subgroup.zpowers x ⊔ Subgroup.zpowers y := le_sup_left
    have heq := Subgroup.eq_of_le_of_card_ge hxle (by rw [Nat.card_zpowers, hx]; exact hge)
    apply hyx
    have : y ∈ Subgroup.zpowers x ⊔ Subgroup.zpowers y :=
      (le_sup_right : Subgroup.zpowers y ≤ _) (Subgroup.mem_zpowers y)
    rwa [← heq] at this
  rw [hn] at hle hlt ⊢
  have h2 : n = 2 := by
    rcases (show n ≤ 1 ∨ n = 2 ∨ 3 ≤ n by omega) with h | h | h
    · exfalso
      have : p ^ n ≤ p ^ 1 := Nat.pow_le_pow_right hp.pos h
      rw [pow_one] at this
      omega
    · exact h
    · exfalso
      have : p ^ 3 ≤ p ^ n := Nat.pow_le_pow_right hp.pos h
      have : p ^ 3 ≤ p * p := this.trans hle
      have hp2 := hp.two_le
      nlinarith
  rw [h2]

theorem isElementaryAbelian_zpowers_sup_zpowers {G : Type*} [Group G] {p : ℕ} {x y : G}
    (hxy : x * y = y * x) (hx : x ^ p = 1) (hy : y ^ p = 1) :
    CFSG.IsElementaryAbelian p ↥(Subgroup.zpowers x ⊔ Subgroup.zpowers y) := by
  set E := Subgroup.zpowers x ⊔ Subgroup.zpowers y with hE
  have hxE : E ≤ Subgroup.centralizer ((Subgroup.zpowers x : Subgroup G) : Set G) := by
    refine sup_le ?_ ?_
    · intro u hu
      rw [Subgroup.mem_centralizer_iff]
      intro v hv
      obtain ⟨a, rfl⟩ := Subgroup.mem_zpowers_iff.mp hu
      obtain ⟨b, rfl⟩ := Subgroup.mem_zpowers_iff.mp hv
      exact (Commute.zpow_zpow_self x b a).eq
    · intro u hu
      rw [Subgroup.mem_centralizer_iff]
      intro v hv
      obtain ⟨a, rfl⟩ := Subgroup.mem_zpowers_iff.mp hu
      obtain ⟨b, rfl⟩ := Subgroup.mem_zpowers_iff.mp hv
      exact (Commute.zpow_zpow (show Commute x y from hxy) b a).eq
  have hyE : E ≤ Subgroup.centralizer ((Subgroup.zpowers y : Subgroup G) : Set G) := by
    refine sup_le ?_ ?_
    · intro u hu
      rw [Subgroup.mem_centralizer_iff]
      intro v hv
      obtain ⟨a, rfl⟩ := Subgroup.mem_zpowers_iff.mp hu
      obtain ⟨b, rfl⟩ := Subgroup.mem_zpowers_iff.mp hv
      exact (Commute.zpow_zpow (show Commute y x from hxy.symm) b a).eq
    · intro u hu
      rw [Subgroup.mem_centralizer_iff]
      intro v hv
      obtain ⟨a, rfl⟩ := Subgroup.mem_zpowers_iff.mp hu
      obtain ⟨b, rfl⟩ := Subgroup.mem_zpowers_iff.mp hv
      exact (Commute.zpow_zpow_self y b a).eq
  have hcomm : E ≤ Subgroup.centralizer (E : Set G) := by
    refine sup_le ?_ ?_
    · exact Subgroup.le_centralizer_iff.2 hxE
    · exact Subgroup.le_centralizer_iff.2 hyE
  haveI : IsMulCommutative ↥E := Subgroup.le_centralizer_iff_isMulCommutative.1 hcomm
  refine { toIsMulCommutative := inferInstance, exponent_dvd_p := ?_ }
  refine Monoid.exponent_dvd_of_forall_pow_eq_one fun u => ?_
  have hnorm : Subgroup.zpowers x ≤ Subgroup.normalizer (Subgroup.zpowers y : Set G) :=
    (Subgroup.le_centralizer_iff.2 (le_sup_right.trans hxE)).trans
      (Subgroup.centralizer_le_normalizer _)
  have hu : (u : G) ∈ ((Subgroup.zpowers x : Set G) * (Subgroup.zpowers y : Set G)) := by
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right _ _ hnorm]
    exact u.2
  obtain ⟨a, ha, b, hb, hab⟩ := hu
  obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp ha
  obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp hb
  apply Subtype.ext
  rw [SubgroupClass.coe_pow, ← hab, (Commute.zpow_zpow (show Commute x y from hxy) i j).mul_pow,
    ← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hx, one_zpow, ← zpow_natCast,
    ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hy, one_zpow, one_mul]
  rfl

theorem pCoreOf_two_le_theta {M : Type} [Group M] [Finite M] {p : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (H : Subgroup M) :
    pCoreOf 2 H ≤ CFSG.inSubgroup (aschbacherSolvableCore p) H := by
  unfold pCoreOf CFSG.inSubgroup
  exact Subgroup.map_mono
    ((CFSG.RankThree.LocalRank.solvable_prime_complement_core_characterization (H := ↥H)
      hp).2.2.2.2.2.2 2 Nat.prime_two (Ne.symm hp2))

theorem innerStepAt_of_plane {S : Type} [Group S] [Finite S] {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hplane : ∀ E : Subgroup (MulAut S), E ≤ innerAut S → CFSG.IsElementaryAbelian p E →
      Nat.card E = p ^ 2 → ∀ a ∈ E, a ≠ 1 →
        ¬ 2 ∣ Nat.card ↥(⁅CFSG.inSubgroup (aschbacherSolvableCore p)
          (innerAut S ⊓ Subgroup.centralizer ({a} : Set (MulAut S))), E⁆)) :
    InnerStepAt p S := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  intro x y hx hy hxo hyp hxy t ht
  have htC : t ∈ Subgroup.centralizer ({x} : Set (MulAut S)) :=
    (CFSG.LieType.BorelTits.pCoreOf_le 2 _ ht).2
  rw [Subgroup.mem_centralizer_singleton_iff] at htC
  by_cases hyx : y ∈ Subgroup.zpowers x
  · obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hyx
    exact (Commute.zpow_left (show Commute x t from htC.symm) k).eq
  have hy1 : y ≠ 1 := fun h => hyx (h ▸ Subgroup.one_mem _)
  have hyo : orderOf y = p := orderOf_eq_prime hyp hy1
  have hxp : x ^ p = 1 := hxo ▸ pow_orderOf_eq_one x
  have hx1 : x ≠ 1 := by
    rintro rfl
    rw [orderOf_one] at hxo
    exact hp.one_lt.ne hxo
  set E := Subgroup.zpowers x ⊔ Subgroup.zpowers y with hE
  have hEc : Nat.card E = p ^ 2 := card_zpowers_sup_zpowers hp hxy hxo hyo hyx
  have hEI : E ≤ innerAut S := sup_le (Subgroup.zpowers_le.2 hx) (Subgroup.zpowers_le.2 hy)
  have hEel : CFSG.IsElementaryAbelian p E := isElementaryAbelian_zpowers_sup_zpowers hxy hxp hyp
  have hxE : x ∈ E := (le_sup_left : Subgroup.zpowers x ≤ E) (Subgroup.mem_zpowers x)
  have hyE : y ∈ E := (le_sup_right : Subgroup.zpowers y ≤ E) (Subgroup.mem_zpowers y)
  have hodd := hplane E hEI hEel hEc x hxE hx1
  set C := innerAut S ⊓ Subgroup.centralizer ({x} : Set (MulAut S)) with hC
  set Q := pCoreOf 2 C with hQ
  have hEC : E ≤ C := by
    refine le_inf hEI (sup_le ?_ ?_)
    · rw [Subgroup.zpowers_le, Subgroup.mem_centralizer_singleton_iff]
    · rw [Subgroup.zpowers_le, Subgroup.mem_centralizer_singleton_iff]
      exact hxy.symm
  have hN1 : ⁅Q, E⁆ ≤ ⁅CFSG.inSubgroup (aschbacherSolvableCore p) C, E⁆ :=
    Subgroup.commutator_mono (pCoreOf_two_le_theta hp hp2 C) le_rfl
  have hN2 : ⁅Q, E⁆ ≤ Q := by
    rw [Subgroup.commutator_le]
    intro q hq e he
    have hn := CFSG.LieType.BorelTits.le_normalizer_pCoreOf 2 C (hEC he)
    have h1 : e * q⁻¹ * e⁻¹ ∈ Q := (Subgroup.mem_normalizer_iff.1 hn q⁻¹).1 (Q.inv_mem hq)
    rw [commutatorElement_def]
    have h2 := Q.mul_mem hq h1
    simpa [mul_assoc] using h2
  have h2Q : IsPGroup 2 ↥(⁅Q, E⁆ : Subgroup (MulAut S)) :=
    (CFSG.LieType.BorelTits.pCoreOf_isPGroup 2 C).to_le hN2
  have hbot : (⁅Q, E⁆ : Subgroup (MulAut S)) = ⊥ := by
    obtain ⟨k, hk⟩ := h2Q.exists_card_eq
    rcases Nat.eq_zero_or_pos k with h0 | hpos
    · rw [h0, pow_zero] at hk
      exact Subgroup.eq_bot_of_card_eq _ hk
    · exfalso
      apply hodd
      exact (dvd_pow_self 2 hpos.ne').trans (hk ▸ Subgroup.card_dvd_of_le hN1)
  have hc : t * y * t⁻¹ * y⁻¹ ∈ (⁅Q, E⁆ : Subgroup (MulAut S)) := by
    rw [← commutatorElement_def]
    exact Subgroup.commutator_mem_commutator ht hyE
  rw [hbot, Subgroup.mem_bot] at hc
  have : t * y = y * t := by
    calc t * y = (t * y * t⁻¹ * y⁻¹) * (y * t) := by group
      _ = y * t := by rw [hc, one_mul]
  exact this.symm

theorem InnerStepAt.of_mulEquiv {S S' : Type} [Group S] [Group S'] {p : ℕ} (e : S ≃* S')
    (h : InnerStepAt p S') : InnerStepAt p S := by
  intro x y hx hy hxo hyp hxy t ht
  set φ := MulAut.congr e with hφ
  have hinn : (innerAut S).map φ.toMonoidHom = innerAut S' :=
    CFSG.RankThree.PartOne.map_conj_range_mulAutCongr e
  have hmem : ∀ z ∈ innerAut S, φ z ∈ innerAut S' := fun z hz => by
    rw [← hinn]; exact Subgroup.mem_map_of_mem _ hz
  have hC : (innerAut S ⊓ Subgroup.centralizer ({x} : Set (MulAut S))).map φ.toMonoidHom =
      innerAut S' ⊓ Subgroup.centralizer ({φ x} : Set (MulAut S')) := by
    rw [Subgroup.map_inf _ _ _ φ.injective, hinn,
      CFSG.RankThree.PartOne.map_centralizer_singleton_mulEquiv]
  have ht' : φ t ∈ pCoreOf 2 (innerAut S' ⊓ Subgroup.centralizer ({φ x} : Set (MulAut S'))) := by
    rw [← hC, CFSG.LieType.BorelTits.pCoreOf_map_mulEquiv 2 φ]
    exact Subgroup.mem_map_of_mem _ ht
  have key := h (φ x) (φ y) (hmem x hx) (hmem y hy) (by rw [MulEquiv.orderOf_eq]; exact hxo)
    (by rw [← map_pow, hyp, map_one]) (by rw [← map_mul, ← map_mul, hxy]) (φ t) ht'
  apply φ.injective
  rw [map_mul, map_mul, key]

theorem innerStepAt_of_planeLocalCoreOdd {S : Type} [Group S] [Finite S] {p : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (h : CFSG.RankThree.PartOne.PlaneLocalCoreOdd p S) : InnerStepAt p S := by
  refine innerStepAt_of_plane hp hp2 fun E hEI hE hEc a ha ha1 hdvd => ?_
  have h1 := h (innerAut S) le_rfl E hEI hE hEc a ha ha1
  exact h1 (hdvd.trans (Subgroup.card_dvd_of_le le_sup_left))

open CFSG.LocalAnalysis.ComponentInitial.LinearFlag (projectiveSL) in
theorem innerStepAt_projectiveSL {n ℓ f p : ℕ} {K : Type} [Field K] (hp : p.Prime) (hp3 : 3 < p)
    (hℓ : ℓ.Prime) (hℓp : ℓ ≠ p) (hf : 1 ≤ f) (hn : 3 ≤ n) (hK : Nat.card K = ℓ ^ f)
    (hpq : ¬ p ∣ ℓ ^ f - 1) : InnerStepAt p (projectiveSL n K) := by
  haveI : Finite K := Nat.finite_of_card_ne_zero (by rw [hK]; exact pow_ne_zero _ hℓ.ne_zero)
  refine innerStepAt_of_plane hp (by omega) fun E hEI hE hEc a ha ha1 => ?_
  have h1 := (CFSG.RankThree.PartOne.linear_nonsplit_inner_plane_products_trivial p ℓ f n K hp hp3
    hℓ hℓp hf hn hK hpq (innerAut (projectiveSL n K)) le_rfl E hEI hE hEc).1 a ha ha1
  rw [h1, Subgroup.card_bot]
  norm_num

open CFSG.LocalAnalysis.ComponentInitial CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher
  CFSG.RankThree.PartOne.KCUnitaryModel in
theorem innerStepAt_primeFormP {ℓ f n p : ℕ} {K : Type} [Field K] (h : UnitaryFieldData ℓ f K)
    (hp : p.Prime) (hp3 : 3 < p) (hpℓ : p ≠ ℓ) (hpq : ¬ p ∣ ℓ ^ f + 1) (hn : 3 ≤ n)
    (hne : ¬ (n = 3 ∧ ℓ ^ f = 2)) : InnerStepAt p (primeFormP h (idGram K n)) := by
  haveI := CFSG.RankThree.PartOne.KCUnitaryModel.finite_primeFormP (h := h) (n := n)
  refine innerStepAt_of_plane hp (by omega) fun E hEI hE hEc a ha ha1 hdvd => ?_
  have h1 := (CFSG.RankThree.PartOne.unitary_nonsplit_inner_plane_products_trivial ℓ f n p K h hp
    hp3 hpℓ hpq hn hne (innerAut (primeFormP h (idGram K n))) le_rfl E hEI hE hEc).2 a ha ha1
  have h2 : ⁅CFSG.inSubgroup (aschbacherSolvableCore p) (innerAut (primeFormP h (idGram K n)) ⊓
      Subgroup.centralizer ({a} : Set (MulAut (primeFormP h (idGram K n))))), E⁆ = ⊥ :=
    le_bot_iff.1 (h1 ▸ le_sup_left)
  rw [h2, Subgroup.card_bot] at hdvd
  norm_num at hdvd

theorem mem_of_prime_dvd_prod {p : ℕ} (hp : p.Prime) :
    ∀ l : List ℕ, (∀ q ∈ l, q.Prime) → p ∣ l.prod → p ∈ l
  | [], _, h => absurd (Nat.dvd_one.1 h) hp.one_lt.ne'
  | q :: l, hl, h => by
    rw [List.prod_cons] at h
    rcases (Nat.Prime.dvd_mul hp).1 h with h1 | h1
    · rw [(Nat.prime_dvd_prime_iff_eq hp (hl q List.mem_cons_self)).1 h1]
      exact List.mem_cons_self
    · exact List.mem_cons_of_mem _
        (mem_of_prime_dvd_prod hp l (fun r hr => hl r (List.mem_cons_of_mem _ hr)) h1)

theorem prime_dvd_three_pow_orderOf_sub_one {p : ℕ} (hp : p.Prime) :
    p ∣ 3 ^ orderOf ((3 : ℕ) : ZMod p) - 1 := by
  haveI : Fact p.Prime := ⟨hp⟩
  have h1 : ((3 : ℕ) : ZMod p) ^ orderOf ((3 : ℕ) : ZMod p) = 1 := pow_orderOf_eq_one _
  have h2 : ((3 ^ orderOf ((3 : ℕ) : ZMod p) - 1 : ℕ) : ZMod p) = 0 := by
    rw [Nat.cast_sub (Nat.one_le_pow _ _ (by norm_num)), Nat.cast_pow, h1, Nat.cast_one, sub_self]
  exact (ZMod.natCast_eq_zero_iff _ _).1 h2

theorem prime_cases_of_dvd {p e : ℕ} (hp : p.Prime) (hdvd : p ∣ 3 ^ e - 1) :
    (e = 1 → p = 2) ∧ (e = 2 → p = 2) ∧ (e = 3 → p = 2 ∨ p = 13) ∧
      (e = 4 → p = 2 ∨ p = 5) ∧ (e = 5 → p = 2 ∨ p = 11) ∧ (e = 6 → p = 2 ∨ p = 7 ∨ p = 13) ∧
      (e = 8 → p = 2 ∨ p = 5 ∨ p = 41) ∧ (e = 10 → p = 2 ∨ p = 11 ∨ p = 61) ∧
      (e = 12 → p = 2 ∨ p = 5 ∨ p = 7 ∨ p = 13 ∨ p = 73) := by
  have key : ∀ l : List ℕ, (∀ q ∈ l, q.Prime) → 3 ^ e - 1 = l.prod → p ∈ l := fun l hl he =>
    mem_of_prime_dvd_prod hp l hl (he ▸ hdvd)
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> rintro rfl
  · simpa using key [2] (by norm_num) (by norm_num)
  · simpa using key [2, 2, 2] (by norm_num) (by norm_num)
  · simpa using key [2, 13] (by norm_num) (by norm_num)
  · simpa using key [2, 2, 2, 2, 5] (by norm_num) (by norm_num)
  · simpa using key [2, 11, 11] (by norm_num) (by norm_num)
  · simpa using key [2, 2, 2, 7, 13] (by norm_num) (by norm_num)
  · simpa using key [2, 2, 2, 2, 2, 5, 41] (by norm_num) (by norm_num)
  · simpa using key [2, 2, 2, 11, 11, 61] (by norm_num) (by norm_num)
  · simpa using key [2, 2, 2, 2, 5, 7, 13, 73] (by norm_num) (by norm_num)

theorem innerStepAt_of_rankLE1 {S : Type} [Group S] [Finite S] {p : ℕ} (hp : p.Prime)
    (hp2 : p ≠ 2) (hZ : Subgroup.center S = ⊥) (h : RankLE1 p S) : InnerStepAt p S := by
  have hinj := CFSG.HardMathSupport.Timmesfeld.SporadicBalance.conj_injective_of_center_eq_bot hZ
  refine innerStepAt_of_plane hp hp2 fun E hEI hE hEc a ha ha1 _ => ?_
  set E' : Subgroup S := E.comap (MulAut.conj : S →* MulAut S) with hE'
  have hmap : E'.map (MulAut.conj : S →* MulAut S) = E := by
    rw [hE', Subgroup.map_comap_eq]
    exact inf_eq_right.mpr hEI
  have hcard : Nat.card E' = p ^ 2 := by
    rw [← hEc, ← hmap, Subgroup.card_map_of_injective hinj]
  have hel : IsElemAbelian p E' := by
    refine ⟨⟨⟨fun u v => Subtype.ext (hinj ?_)⟩⟩, fun u hu => hinj ?_⟩
    · have := (hE.toIsMulCommutative.is_comm.comm ⟨_, u.2⟩ ⟨_, v.2⟩)
      simpa [map_mul] using congrArg Subtype.val this
    · rw [map_pow, map_one]
      exact CFSG.elemPow_eq_one_of_isElementaryAbelian (A := E) _ hu
  have := h E' hel
  rw [hcard] at this
  have hp1 := hp.one_lt
  nlinarith

theorem mem_of_two_le_degCount {τ : CFSG.Blueprint.Chevalley.Tag}
    (hτ : τ = .F4 ∨ τ = .E6 ∨ τ = .E7) {e : ℕ} (hc : 2 ≤ degCount τ e) :
    e = 1 ∨ e = 2 ∨ e = 3 ∨ e = 4 ∨ e = 6 := by
  have hτ' : τ = .F4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8 := by
    rcases hτ with h | h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr (Or.inl h))
  have h30 : e ≤ 30 :=
    CFSG.LieType.SeitzGeneration.le_thirty_of_degCount_pos (τ := τ) (e := e) hτ' (by omega)
  rcases hτ with rfl | rfl | rfl <;> interval_cases e <;> first | decide | exact absurd hc (by decide)

theorem mem_of_two_le_degCount_E8 {e : ℕ} (hc : 2 ≤ degCount .E8 e) :
    e = 1 ∨ e = 2 ∨ e = 3 ∨ e = 4 ∨ e = 5 ∨ e = 6 ∨ e = 8 ∨ e = 10 ∨ e = 12 := by
  have h30 : e ≤ 30 :=
    CFSG.LieType.SeitzGeneration.le_thirty_of_degCount_pos (τ := .E8) (e := e)
      (Or.inr (Or.inr (Or.inr rfl))) (by omega)
  interval_cases e <;> first | decide | exact absurd hc (by decide)

theorem cases_FE67 {τ : CFSG.Blueprint.Chevalley.Tag} (hτ : τ = .F4 ∨ τ = .E6 ∨ τ = .E7) {p : ℕ}
    (hp : p.Prime) (hp3 : 3 < p) :
    p = 5 ∨ p = 7 ∨ p = 13 ∨ degCount τ (orderOf ((3 : ℕ) : ZMod p)) ≤ 1 := by
  by_contra h
  push Not at h
  obtain ⟨h5, h7, h13, hc⟩ := h
  have hdvd := prime_dvd_three_pow_orderOf_sub_one hp
  generalize orderOf ((3 : ℕ) : ZMod p) = e at hc hdvd
  obtain ⟨c1, c2, c3, c4, -, c6, -, -, -⟩ := prime_cases_of_dvd hp hdvd
  rcases mem_of_two_le_degCount hτ hc with rfl | rfl | rfl | rfl | rfl
  · have := c1 rfl; omega
  · have := c2 rfl; omega
  · have := c3 rfl; omega
  · have := c4 rfl; omega
  · have := c6 rfl; omega

theorem cases_E8 {p : ℕ} (hp : p.Prime) (hp3 : 3 < p) :
    p = 5 ∨ p = 7 ∨ p = 11 ∨ p = 13 ∨ p = 41 ∨ p = 61 ∨ p = 73 ∨
      degCount .E8 (orderOf ((3 : ℕ) : ZMod p)) ≤ 1 := by
  by_contra h
  push Not at h
  obtain ⟨h5, h7, h11, h13, h41, h61, h73, hc⟩ := h
  have hdvd := prime_dvd_three_pow_orderOf_sub_one hp
  generalize orderOf ((3 : ℕ) : ZMod p) = e at hc hdvd
  obtain ⟨c1, c2, c3, c4, c5, c6, c8, c10, c12⟩ := prime_cases_of_dvd hp hdvd
  rcases mem_of_two_le_degCount_E8 hc with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · have := c1 rfl; omega
  · have := c2 rfl; omega
  · have := c3 rfl; omega
  · have := c4 rfl; omega
  · have := c5 rfl; omega
  · have := c6 rfl; omega
  · have := c8 rfl; omega
  · have := c10 rfl; omega
  · have := c12 rfl; omega

