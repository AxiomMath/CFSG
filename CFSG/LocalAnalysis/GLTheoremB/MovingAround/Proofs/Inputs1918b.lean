theorem innerStepAt_of_center_eq_top {S : Type} [Group S] {p : ℕ} (hp : p.Prime)
    (hZ : Subgroup.center S = ⊤) : InnerStepAt p S := by
  intro x y hx _ hxo _ _ t _
  exfalso
  obtain ⟨g, rfl⟩ := hx
  have hg : MulAut.conj g = 1 := by
    refine MulEquiv.ext fun s => ?_
    have hs : g ∈ Subgroup.center S := hZ ▸ Subgroup.mem_top g
    rw [MulAut.conj_apply, MulAut.one_apply, (Subgroup.mem_center_iff.1 hs s).symm, mul_inv_cancel_right]
