variable {Y : Type} [Group Y]

theorem conj_map_apply (σ : MulAut Y) (y : Y) :
    MulAut.conj (σ y) = σ * MulAut.conj y * σ⁻¹ := by
  ext z
  simp [MulAut.conj_apply]

theorem finite_of_mulEquiv (e : Y ≃* PSL2 (GaloisField 3 3)) : Finite Y :=
  Finite.of_equiv _ e.symm.toEquiv

theorem card_eq_9828 (e : Y ≃* PSL2 (GaloisField 3 3)) : Nat.card Y = 9828 := by
  rw [Nat.card_congr e.toEquiv, CFSG.RankThree.PartTwo.KFacts.card_psl2_27]

theorem conj_injective (e : Y ≃* PSL2 (GaloisField 3 3)) :
    Function.Injective (MulAut.conj : Y →* MulAut Y) := by
  haveI := finite_of_mulEquiv e
  exact Lemma113d.conj_injective_of_centre_trivial (fun z hz => Lemma113c.psl2_27_centre e z hz)

theorem card_comap_conj (e : Y ≃* PSL2 (GaloisField 3 3)) {U : Subgroup (MulAut Y)}
    (hUi : U ≤ (MulAut.conj : Y →* MulAut Y).range) :
    Nat.card (U.comap (MulAut.conj : Y →* MulAut Y)) = Nat.card U := by
  rw [← Subgroup.card_map_of_injective (conj_injective e), Subgroup.map_comap_eq_self hUi]

@[expose] noncomputable def toL2 (e : Y ≃* PSL2 (GaloisField 3 3)) : Y ≃* L2 (GaloisField 3 3) :=
  e.trans (CFSG.GH74.GLS.IVK.L2.equivPSL (GaloisField 3 3)).symm

theorem isPGroup_of_card {W : Subgroup Y} (hW : Nat.card W = 27) : IsPGroup 3 W :=
  IsPGroup.of_card (n := 3) (by rw [hW]; norm_num)

theorem not_dvd_index (e : Y ≃* PSL2 (GaloisField 3 3)) {W : Subgroup Y} (hW : Nat.card W = 27) :
    ¬ 3 ∣ W.index := by
  have h := W.card_mul_index
  rw [hW, card_eq_9828 e] at h
  have h' : W.index = 364 := by omega
  rw [h']
  decide

theorem exists_isStd_of_card (e : Y ≃* PSL2 (GaloisField 3 3)) {W : Subgroup Y}
    (hW : Nat.card W = 27) : ∃ e' : Y ≃* L2 (GaloisField 3 3), IsStd e' W := by
  haveI := finite_of_mulEquiv e
  obtain ⟨c, hc, -⟩ := L2Borel.exists_isStd Nat.prime_three card_gf27 (toL2 e)
    ((isPGroup_of_card hW).toSylow (not_dvd_index e hW))
  exact ⟨_, hc⟩

theorem wt_neg (e : Y ≃* L2 (GaloisField 3 3)) (s : GaloisField 3 3) : wt e (-s) = (wt e s)⁻¹ := by
  apply eq_inv_of_mul_eq_one_left
  rw [← wt_add, neg_add_cancel, wt_zero]

@[expose] noncomputable def dt (e : Y ≃* L2 (GaloisField 3 3)) (x : (GaloisField 3 3)ˣ) : Y :=
  (toPSL e).symm (mk (diag x))

theorem dt_conj_wt (e : Y ≃* L2 (GaloisField 3 3)) (x : (GaloisField 3 3)ˣ) (s : GaloisField 3 3) :
    dt e x * wt e s * (dt e x)⁻¹ = wt e ((x : GaloisField 3 3) ^ 2 * s) := by
  apply (toPSL e).injective
  rw [map_mul, map_mul, map_inv, dt, MulEquiv.apply_symm_apply, toPSL_wt, toPSL_wt, mk_conj,
    diag_conj_unip]

theorem dt_mem_normalizer {e : Y ≃* L2 (GaloisField 3 3)} {W : Subgroup Y} (hstd : IsStd e W)
    (x : (GaloisField 3 3)ˣ) : dt e x ∈ Subgroup.normalizer (W : Set Y) := by
  have hN : mk (diag x) ∈ Subgroup.normalizer
      ((unipotent (GaloisField 3 3) : Subgroup (PSL(2, GaloisField 3 3))) :
        Set (PSL(2, GaloisField 3 3))) := by
    rw [normalizer_unipotent_eq two_ne_zero_gf27]
    exact splitTorus_le_borel (mk_diag_mem_splitTorus x)
  rw [Subgroup.mem_normalizer_iff]
  intro h
  rw [hstd h, hstd (dt e x * h * (dt e x)⁻¹), map_mul, map_mul, map_inv, dt,
    MulEquiv.apply_symm_apply]
  exact Subgroup.mem_normalizer_iff.1 hN _

