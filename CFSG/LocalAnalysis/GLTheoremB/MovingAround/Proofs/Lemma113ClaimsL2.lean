theorem pow_three_eq_of_fixed {φ : GaloisField 3 3 ≃+* GaloisField 3 3} (hφ : φ ≠ 1)
    {x : GaloisField 3 3} (hx : φ x = x) : x ^ 3 = x := by
  have hcard : Nat.card (GaloisField 3 3 ≃+* GaloisField 3 3) = 3 :=
    CFSG.RankThree.PartTwo.KFacts.card_ringAut_galoisField_three_three
  haveI : Finite (GaloisField 3 3 ≃+* GaloisField 3 3) :=
    Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
  have h3 : φ ^ 3 = 1 := by
    have := pow_card_eq_one' (G := GaloisField 3 3 ≃+* GaloisField 3 3) (x := φ)
    rwa [hcard] at this
  have htop : Subgroup.zpowers φ = ⊤ := by
    apply Subgroup.eq_top_of_card_eq
    rw [Nat.card_zpowers, orderOf_eq_prime h3 hφ, hcard]
  have hle : Subgroup.zpowers φ ≤ MulAction.stabilizer (RingAut (GaloisField 3 3)) x := by
    rw [Subgroup.zpowers_le]
    exact hx
  have hfr : frobeniusEquiv (GaloisField 3 3) 3 ∈
      MulAction.stabilizer (RingAut (GaloisField 3 3)) x :=
    hle (by rw [htop]; exact Subgroup.mem_top _)
  have hfr' : frobeniusEquiv (GaloisField 3 3) 3 x = x := hfr
  rwa [frobeniusEquiv_def] at hfr'

theorem exists_fixed_le_three {φ : GaloisField 3 3 ≃+* GaloisField 3 3} (hφ : φ ≠ 1)
    (a : (GaloisField 3 3)ˣ) :
    ∃ s₀ : GaloisField 3 3, ∀ s, (a : GaloisField 3 3) * φ s = s → s = 0 ∨ s = s₀ ∨ s = -s₀ := by
  by_cases h : ∃ s₀ : GaloisField 3 3, s₀ ≠ 0 ∧ (a : GaloisField 3 3) * φ s₀ = s₀
  · obtain ⟨s₀, hs₀, hfix₀⟩ := h
    refine ⟨s₀, fun s hs => ?_⟩
    by_cases hs0 : s = 0
    · exact Or.inl hs0
    right
    have hx : φ (s / s₀) = s / s₀ := by
      rw [map_div₀]
      calc φ s / φ s₀ = ((a : GaloisField 3 3) * φ s) / ((a : GaloisField 3 3) * φ s₀) :=
            (mul_div_mul_left _ _ a.ne_zero).symm
        _ = s / s₀ := by rw [hs, hfix₀]
    have h3 : (s / s₀) * ((s / s₀) - 1) * ((s / s₀) + 1) = 0 := by
      linear_combination pow_three_eq_of_fixed hφ hx
    rcases mul_eq_zero.1 h3 with h | h
    · rcases mul_eq_zero.1 h with h | h
      · exact absurd h (div_ne_zero hs0 hs₀)
      · left
        exact (div_eq_one_iff_eq hs₀).1 (sub_eq_zero.1 h)
    · right
      have h' : s / s₀ = -1 := eq_neg_of_add_eq_zero_left h
      rw [div_eq_iff hs₀] at h'
      rw [h', neg_one_mul]
  · exact ⟨0, fun s hs => Or.inl (by_contra fun hs0 => h ⟨s, hs0, hs⟩)⟩

theorem exists_sq_eq_or_neg {r : GaloisField 3 3} (hr : r ≠ 0) :
    ∃ x : (GaloisField 3 3)ˣ, (x : GaloisField 3 3) ^ 2 = r ∨ (x : GaloisField 3 3) ^ 2 = -r := by
  classical
  haveI : Fintype (GaloisField 3 3) := Fintype.ofFinite _
  have hcard : Fintype.card (GaloisField 3 3) = 27 := by
    rw [← Nat.card_eq_fintype_card, card_gf27]
    norm_num
  have hneg1 : ¬ IsSquare (-1 : GaloisField 3 3) := by
    rw [FiniteField.isSquare_neg_one_iff, hcard]
    decide
  have hsq : IsSquare r ∨ IsSquare (-r) := by
    by_contra hcon
    rw [not_or] at hcon
    have h1 := quadraticChar_neg_one_iff_not_isSquare.2 hcon.1
    have h2 := quadraticChar_neg_one_iff_not_isSquare.2 hneg1
    have h3 : quadraticChar (GaloisField 3 3) (-r) = 1 := by
      rw [neg_eq_neg_one_mul, map_mul, h1, h2]
      norm_num
    exact hcon.2 ((quadraticChar_one_iff_isSquare (neg_ne_zero.2 hr)).1 h3)
  rcases hsq with ⟨y, hy⟩ | ⟨y, hy⟩
  · have hy0 : y ≠ 0 := by
      rintro rfl
      exact hr (by simpa using hy)
    exact ⟨Units.mk0 y hy0, Or.inl (by rw [Units.val_mk0, hy, sq])⟩
  · have hy0 : y ≠ 0 := by
      rintro rfl
      exact hr (by simpa using hy)
    exact ⟨Units.mk0 y hy0, Or.inr (by rw [Units.val_mk0, hy, sq])⟩

