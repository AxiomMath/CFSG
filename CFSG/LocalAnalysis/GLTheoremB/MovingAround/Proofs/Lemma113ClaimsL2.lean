theorem input113dCentralizer27_holds :
    CFSG.LocalAnalysis.GLTheoremB.MovingAround.Lemma113d.Input113dCentralizer27 := by
  intro Y _ e σ U hσN hσ3 hσI hUi _ hU27
  have hinj := conj_injective e
  set W := U.comap (MulAut.conj : Y →* MulAut Y)
  have hW27 : Nat.card W = 27 := by rw [card_comap_conj e hUi, hU27]
  obtain ⟨e', hstd⟩ := exists_isStd_of_card e hW27
  have hstab : σ ∈ MulAction.stabilizer (MulAut Y) W := by
    rw [mem_stabilizer_iff_forall]
    intro k
    show MulAut.conj (σ k) ∈ U ↔ MulAut.conj k ∈ U
    rw [conj_map_apply]
    exact (Subgroup.mem_normalizer_iff.1 hσN (MulAut.conj k)).symm
  obtain ⟨a, b, φ, hσφ⟩ := exists_bor_decomp hstd hstab
  have hφ : φ ≠ 1 := by
    rintro rfl
    apply hσI
    rw [map_one, mul_one] at hσφ
    have h3 : (bor a b) ^ 3 = 1 :=
      innDiagHom_injective e' (by rw [map_pow, ← hσφ, hσ3, map_one])
    obtain ⟨x, hx⟩ := CFSG.RankThree.PartTwo.KFacts.exists_toPGL_eq_of_pow_odd (by decide) h3
    refine ⟨(toPSL e').symm x, ?_⟩
    rw [hσφ, ← hx, ← innDiagHom_toPGL_toPSL e' ((toPSL e').symm x), MulEquiv.apply_symm_apply]
  obtain ⟨s₀, hs₀⟩ := exists_fixed_le_three hφ a
  have hsub : ((U ⊓ Subgroup.centralizer ({σ} : Set (MulAut Y)) : Subgroup (MulAut Y)) :
      Set (MulAut Y)) ⊆ {1, MulAut.conj (wt e' s₀), MulAut.conj (wt e' (-s₀))} := by
    rintro u ⟨huU, huC⟩
    obtain ⟨y, rfl⟩ := hUi huU
    have hyW : y ∈ W := huU
    obtain ⟨s, rfl⟩ := hstd.exists_wt hyW
    have hcomm : σ * MulAut.conj (wt e' s) = MulAut.conj (wt e' s) * σ :=
      Subgroup.mem_centralizer_iff.1 huC σ (Set.mem_singleton σ)
    have hfix : σ (wt e' s) = wt e' s := by
      apply hinj
      rw [conj_map_apply, hcomm, mul_inv_cancel_right]
    have hs : (a : GaloisField 3 3) * φ s = s := by
      apply wt_injective e' two_ne_zero_gf27
      rw [← action_wt (e := e') a b φ s, ← hσφ, hfix]
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    rcases hs₀ s hs with rfl | rfl | rfl
    · left
      rw [wt_zero, map_one]
    · right
      left
      rfl
    · right
      right
      rfl
  have h3 : ({1, MulAut.conj (wt e' s₀), MulAut.conj (wt e' (-s₀))} : Set (MulAut Y)).ncard ≤ 3 := by
    refine (Set.ncard_insert_le _ _).trans ?_
    have := Set.ncard_insert_le (MulAut.conj (wt e' s₀)) {MulAut.conj (wt e' (-s₀))}
    rw [Set.ncard_singleton] at this
    omega
  calc Nat.card ↥(U ⊓ Subgroup.centralizer ({σ} : Set (MulAut Y)))
      = ((U ⊓ Subgroup.centralizer ({σ} : Set (MulAut Y)) : Subgroup (MulAut Y)) :
          Set (MulAut Y)).ncard := Nat.card_coe_set_eq _
    _ ≤ _ := Set.ncard_le_ncard hsub
    _ ≤ 3 := h3

theorem centralizer_mulAut_sylow_le {Y : Type} [Group Y] (e : Y ≃* PSL2 (GaloisField 3 3))
    (U : Subgroup (MulAut Y)) (hUi : U ≤ (MulAut.conj : Y →* MulAut Y).range)
    (hU27 : Nat.card U = 27) (σ : MulAut Y) (hσ : ∀ u ∈ U, σ * u = u * σ) : σ ∈ U := by
  have hinj := conj_injective e
  set W := U.comap (MulAut.conj : Y →* MulAut Y)
  have hW27 : Nat.card W = 27 := by rw [card_comap_conj e hUi, hU27]
  obtain ⟨e', hstd⟩ := exists_isStd_of_card e hW27
  have hfix : ∀ w ∈ W, σ w = w := by
    intro w hw
    apply hinj
    rw [conj_map_apply, hσ _ hw, mul_inv_cancel_right]
  have hstab : σ ∈ MulAction.stabilizer (MulAut Y) W := by
    rw [mem_stabilizer_iff_forall]
    intro k
    constructor
    · intro hk
      have h1 : σ k = k := σ.injective (hfix _ hk)
      rwa [h1] at hk
    · intro hk
      rw [hfix k hk]
      exact hk
  obtain ⟨b, hb⟩ :=
    trivial_action hstd two_ne_zero_gf27 hstab (fun s => hfix _ (hstd.wt_mem s))
  rw [hb]
  exact hstd.wt_mem b

theorem exists_torus_element {Y : Type} [Group Y] (e : Y ≃* PSL2 (GaloisField 3 3))
    (W : Subgroup Y) (hW : Nat.card W = 27) :
    ∃ t ∈ Subgroup.normalizer (W : Set Y), (∀ w ∈ W, (t ^ 13)⁻¹ * w * t ^ 13 = w) ∧
      (∀ j : ℕ, 0 < j → j < 13 → ∀ w ∈ W, (t ^ j)⁻¹ * w * t ^ j = w → w = 1) := by
  haveI := finite_of_mulEquiv e
  have hWne : W ≠ ⊥ := by
    intro h
    rw [h, Subgroup.card_bot] at hW
    norm_num at hW
  obtain ⟨-, D, hDcyc, hDcard, hfrob⟩ := ivk_1_4g (GaloisField 3 3) l2Field_gf27 Y (toL2 e) 3 3
    Nat.prime_three card_gf27 ((isPGroup_of_card hW).toSylow (not_dvd_index e hW)) W le_rfl hWne
  rw [card_gf27] at hDcard
  norm_num at hDcard
  obtain ⟨t, htD, -, hord⟩ := exists_generator hDcyc
  rw [hDcard] at hord
  refine ⟨t, hfrob.2.1 htD, fun w _ => ?_, ?_⟩
  · rw [← hord, pow_orderOf_eq_one, inv_one, one_mul, mul_one]
  · intro j hj0 hj13 w hw hjw
    have hne : t ^ j ≠ 1 := pow_ne_one_of_lt_orderOf hj0.ne' (by rw [hord]; exact hj13)
    apply hfrob.2.2.2.2.2 (t ^ j) (D.pow_mem htD j) hne w hw
    calc t ^ j * w = t ^ j * ((t ^ j)⁻¹ * w * t ^ j) := by rw [hjw]
      _ = w * t ^ j := by group

theorem exists_normalizer_conj_subgroup {Y : Type} [Group Y] (e : Y ≃* PSL2 (GaloisField 3 3))
    (W : Subgroup Y) (hW : Nat.card W = 27) {w₁ w₂ : Y} (h₁ : w₁ ∈ W) (h₂ : w₂ ∈ W)
    (h1 : w₁ ≠ 1) (h2 : w₂ ≠ 1) :
    ∃ t ∈ Subgroup.normalizer (W : Set Y), t * w₁ * t⁻¹ = w₂ ∨ t * w₁ * t⁻¹ = w₂⁻¹ := by
  obtain ⟨e', hstd⟩ := exists_isStd_of_card e hW
  obtain ⟨s₁, rfl⟩ := hstd.exists_wt h₁
  obtain ⟨s₂, rfl⟩ := hstd.exists_wt h₂
  have hs₁ : s₁ ≠ 0 := by
    rintro rfl
    exact h1 (wt_zero e')
  have hs₂ : s₂ ≠ 0 := by
    rintro rfl
    exact h2 (wt_zero e')
  obtain ⟨x, hx | hx⟩ := exists_sq_eq_or_neg (div_ne_zero hs₂ hs₁)
  · refine ⟨dt e' x, dt_mem_normalizer hstd x, Or.inl ?_⟩
    rw [dt_conj_wt, hx, div_mul_cancel₀ _ hs₁]
  · refine ⟨dt e' x, dt_mem_normalizer hstd x, Or.inr ?_⟩
    rw [dt_conj_wt, hx, neg_mul, div_mul_cancel₀ _ hs₁, wt_neg]

end CFSG.LocalAnalysis.GLTheoremB.MovingAround.Lemma113Claims.L2
