  obtain ⟨⟨x, hxE⟩, hx1⟩ := Subgroup.ne_bot_iff_exists_ne_one.1 hE₁ne
  haveI : Nontrivial ↥R :=
    ⟨⟨⟨x, hE₁R hxE⟩, 1, fun h => hx1 (Subtype.ext (by
      simpa using congrArg (fun r : ↥R => (r : G)) h))⟩⟩
