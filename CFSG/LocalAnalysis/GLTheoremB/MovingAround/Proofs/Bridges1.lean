variable {Y : Type} [Group Y]

theorem comp_diag_hom [Finite Y] {M : Subgroup Y} {𝓛 : Set (Subgroup Y)}
    (D : Subgroup Y → Subgroup Y)
    (hDM : ∀ X ∈ 𝓛, D X ≤ M)
    (hgen : ∀ m ∈ M, ∃ d ∈ ⨆ X ∈ 𝓛, D X, ∃ w : Y, (∀ n ∈ M, w * n = n * w) ∧ m = d * w)
    (hDN : ∀ X ∈ 𝓛, ∀ m ∈ M, m ∈ Subgroup.normalizer (D X : Set Y))
    (hψ : ∀ X ∈ 𝓛, ∃ ψ : ↥X →* Y, ψ.range = D X)
    (hXq : ∀ X ∈ 𝓛, CFSG.Open.IsQuasisimple ↥X)
    {Q : Subgroup Y} (hQ : IsComponentOf Q M) :
    ∃ X ∈ 𝓛, ∃ φ : ↥X →* ↥Q, Function.Surjective φ ∧ φ.ker ≤ Subgroup.center ↥X := by
  classical
  obtain ⟨r, hr, t, ht, hrt⟩ := exists_noncomm_of_isComponentOf hQ
  have hQM : Q ≤ M := hQ.1
  have hdich : ∀ X ∈ 𝓛, Q ≤ D X ∨ ⁅Q, D X⁆ = ⊥ := fun X hX =>
    comp_le_or_comm (CFSG.Assembly.isComponentOf_iff_open.2 hQ) (hDM X hX)
      (fun m hm => hDN X hX m hm)
  have hexists : ∃ X ∈ 𝓛, Q ≤ D X := by
    by_contra hno
    push Not at hno
    have hD_le : (⨆ X ∈ 𝓛, D X) ≤ Subgroup.centralizer (Q : Set Y) := by
      refine iSup₂_le fun X hX => ?_
      have h1 : ⁅D X, Q⁆ = ⊥ := by
        rw [Subgroup.commutator_comm]
        exact (hdich X hX).resolve_left (hno X hX)
      exact Subgroup.commutator_eq_bot_iff_le_centralizer.1 h1
    apply hrt
    obtain ⟨d, hd, w, hw, htdw⟩ := hgen t (hQM ht)
    have hdc : d ∈ Subgroup.centralizer (Q : Set Y) := hD_le hd
    have hdr : d * r = r * d := (Subgroup.mem_centralizer_iff.1 hdc r hr).symm
    have hwr : w * r = r * w := hw r (hQM hr)
    rw [htdw]
    calc r * (d * w) = (r * d) * w := by group
      _ = (d * r) * w := by rw [hdr]
      _ = d * (r * w) := by group
      _ = d * (w * r) := by rw [hwr]
      _ = (d * w) * r := by group
  obtain ⟨X₀, hX₀, hQD⟩ := hexists
  obtain ⟨ψ, hψr⟩ := hψ X₀ hX₀
  haveI hTn : ψ.ker.Normal := MonoidHom.normal_ker ψ
  have hT_ne : ψ.ker ≠ ⊤ := by
    intro htop
    apply hrt
    have hbot : D X₀ = ⊥ := by
      rw [← hψr, eq_bot_iff]
      rintro _ ⟨x, rfl⟩
      have hx : x ∈ ψ.ker := by rw [htop]; exact Subgroup.mem_top x
      rw [MonoidHom.mem_ker] at hx
      rw [hx]
      exact Subgroup.one_mem _
    have h1 : r ∈ D X₀ := hQD hr
    have h2 : t ∈ D X₀ := hQD ht
    rw [hbot, Subgroup.mem_bot] at h1 h2
    rw [h1, h2]
  have hTc : ψ.ker ≤ Subgroup.center ↥X₀ := l119_normal_le_center (hXq X₀ hX₀) hT_ne
  let eK : (↥X₀ ⧸ ψ.ker) ≃* ↥(D X₀) :=
    (QuotientGroup.quotientKerEquivRange ψ).trans (MulEquiv.subgroupCongr hψr)
  have hKq : CFSG.Open.IsQuasisimple ↥(D X₀) :=
    CFSG.SignalizerFunctorTheorem.TransportA.isQuasisimple_of_mulEquiv eK
      (CFSG.ComponentClassification.Quasisimple.central_quotient (hXq X₀ hX₀) ψ.ker hTc)
  have hsn : IsSubnormal Q (D X₀) := isSubnormal_of_le_of_le hQ.2.1 hQD (hDM X₀ hX₀)
  have hQeq : Q = D X₀ := by
    rcases CFSG.HardMathSupport.Solomon.Coordinator.i183v_eq_or_le_center hsn hKq with h | h
    · exact h
    · exfalso
      apply hrt
      obtain ⟨z, hz, hzr⟩ := Subgroup.mem_map.1 (h hr)
      have htK : t ∈ D X₀ := hQD ht
      have hc := Subgroup.mem_center_iff.1 hz ⟨t, htK⟩
      have hc' := congrArg Subtype.val hc
      simp only [Subgroup.coe_mul, Subtype.coe_mk] at hc'
      have hz' : ((z : ↥(D X₀)) : Y) = r := hzr
      rw [hz'] at hc'
      exact hc'.symm
  have hψQ : ∀ x : ↥X₀, ψ x ∈ Q := fun x => by
    rw [hQeq, ← hψr]
    exact MonoidHom.mem_range.2 ⟨x, rfl⟩
  refine ⟨X₀, hX₀, ψ.codRestrict Q hψQ, ?_, fun x hx => hTc ?_⟩
  · rintro ⟨q, hq⟩
    rw [hQeq, ← hψr] at hq
    obtain ⟨x, hx⟩ := hq
    exact ⟨x, Subtype.ext hx⟩
  · have := congrArg Subtype.val (MonoidHom.mem_ker.1 hx)
    exact this

end CompDiag

theorem diag_hom_of_family :
    ∀ (Y : Type) [Group Y] [Finite Y] (p : ℕ), p.Prime → ∀ (L : Subgroup Y) (𝓛 : Set (Subgroup Y))
      (b : Y), orderOf b = p → b ∈ Subgroup.normalizer (L : Set Y) → L = sSup 𝓛 →
      (∀ X ∈ 𝓛, IsComponentOf X L) →
      (∀ X ∈ 𝓛, ∀ X' ∈ 𝓛, X ≠ X' → ∀ x ∈ X, ∀ y ∈ X', x * y = y * x) →
      (b ∈ Subgroup.centralizer (L : Set Y) ∨ ∀ X ∈ 𝓛, b ∉ Subgroup.normalizer (X : Set Y)) →
      ∀ Q : Subgroup Y, GLAPComponent p (L ⊓ Subgroup.centralizer ({b} : Set Y)) Q →
        ∃ X ∈ 𝓛, ∃ φ : ↥X →* (↥Q ⧸ GLAPPrimeCore p ↥Q),
          Function.Surjective φ ∧ φ.ker ≤ Subgroup.center ↥X := by
  intro Y _ _ p hp L 𝓛 b hb hbN hL hcomp hcomm hcase Q hQ
  obtain ⟨D, hDM, hgen, hDN, hψ⟩ := diag_data_of_family Y p hp L 𝓛 b hb hbN hL hcomp hcomm hcase
  exact quot_diag_hom hp D hDM hgen hDN hψ (fun X hX => (hcomp X hX).2.2) hQ

theorem mem_normalizer_gLBConj_iff {G : Type} [Group G] {K : Subgroup G} {β b : G}
    (h : b * β = β * b) :
    b ∈ Subgroup.normalizer ((GLBConj β K : Subgroup G) : Set G) ↔
      b ∈ Subgroup.normalizer (K : Set G) := by
  have e : ∀ y : G, β * (b * y * b⁻¹) * β⁻¹ = b * (β * y * β⁻¹) * b⁻¹ := by
    intro y
    have h1 : β * b = b * β := h.symm
    calc β * (b * y * b⁻¹) * β⁻¹ = (β * b) * y * (b⁻¹ * β⁻¹) := by group
      _ = (b * β) * y * (β⁻¹ * b⁻¹) := by
        rw [h1, ← mul_inv_rev, ← mul_inv_rev, h1]
      _ = b * (β * y * β⁻¹) * b⁻¹ := by group
  rw [Subgroup.mem_normalizer_iff, Subgroup.mem_normalizer_iff]
  constructor
  · intro hb x
    have h1 := hb (β⁻¹ * x * β)
    rw [mem_gLBConj, mem_gLBConj] at h1
    have e1 : β * (β⁻¹ * x * β) * β⁻¹ = x := by group
    have e2 : β * (b * (β⁻¹ * x * β) * b⁻¹) * β⁻¹ = b * x * b⁻¹ := by rw [e]; group
    rw [e1, e2] at h1
    exact h1
  · intro hb y
    rw [mem_gLBConj, mem_gLBConj, e]
    exact hb (β * y * β⁻¹)

