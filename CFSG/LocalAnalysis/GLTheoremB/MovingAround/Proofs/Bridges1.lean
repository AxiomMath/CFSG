theorem Bridges1.sec13e_clause1_holds : ∀ (X : Type) [Group X] [Finite X] (p : ℕ), p.Prime →
    ∀ (L B K₁ : Subgroup X) (𝒦 : Set (Subgroup X)), K₁ ∈ 𝒦 →
      (∀ K ∈ 𝒦, CFSG.Open.IsComponentOf K L) → L = ⨆ K ∈ 𝒦, K →
      (∀ K ∈ 𝒦, ∀ K' ∈ 𝒦, K ≠ K' → ⁅K, K'⁆ = ⊥) →
      (∀ K ∈ 𝒦, ∀ K' ∈ 𝒦, ∃ b ∈ B, GLBConj b K = K') →
      CFSG.Open.IsElemAbelian p B → B ≤ Subgroup.normalizer (L : Set X) → p ∣ Nat.card ↥L →
      (∀ b ∈ {b : X | b ∈ B ∧ b ≠ 1 ∧ (b ∈ Subgroup.centralizer (L : Set X) ∨
          b ∉ Subgroup.normalizer (K₁ : Set X))},
        ∀ Y : Subgroup X,
          CFSG.Open.IsComponentOf Y
            (CFSG.Open.GLAPLayer p (L ⊓ Subgroup.centralizer ({b} : Set X))) →
          ∃ K ∈ 𝒦, ∃ φ : ↥K →* ↥Y, Function.Surjective φ ∧ φ.ker ≤ Subgroup.center ↥K) := by
  intro X _ _ p hp L B K₁ 𝒦 hK₁ hcomp hL hcomm htrans hB hBN hpL b hbJ Y hY
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨hbB, hb1, hcase⟩ := hbJ
  have hbp : b ^ p = 1 := hB.2 b hbB
  have hbo : orderOf b = p := orderOf_eq_prime hbp hb1
  have hLsup : L = sSup 𝒦 := hL.trans sSup_eq_iSup.symm
  have hcommE : ∀ K ∈ 𝒦, ∀ K' ∈ 𝒦, K ≠ K' → ∀ x ∈ K, ∀ y ∈ K', x * y = y * x := by
    intro K hK K' hK' hne x hx y hy
    have hmem : ⁅x, y⁆ ∈ ⁅K, K'⁆ := Subgroup.commutator_mem_commutator hx hy
    rw [hcomm K hK K' hK' hne, Subgroup.mem_bot] at hmem
    exact commutatorElement_eq_one_iff_mul_comm.1 hmem
  have hcase' : b ∈ Subgroup.centralizer (L : Set X) ∨
      ∀ X₀ ∈ 𝒦, b ∉ Subgroup.normalizer (X₀ : Set X) := by
    rcases hcase with hc | hn
    · exact Or.inl hc
    · refine Or.inr fun X₀ hX₀ hbX₀ => hn ?_
      obtain ⟨β, hβB, hβ⟩ := htrans K₁ hK₁ X₀ hX₀
      subst hβ
      exact (Bridges1.mem_normalizer_gLBConj_iff (K := K₁)
        (CFSG.Open.IsElemAbelian.comm hB hbB hβB)).1 hbX₀
  obtain ⟨D, hDM, hgen, hDN, hψ⟩ := Bridges1.diag_data_of_family X p hp L 𝒦 b hbo (hBN hbB) hLsup
    hcomp hcommE hcase'
  set M : Subgroup X := L ⊓ Subgroup.centralizer ({b} : Set X) with hM
  have hEM : CFSG.Open.GLAPLayer p M ≤ M := sSup_le fun _ hL' => hL'.1
  have hEsn : IsSubnormal (CFSG.Open.GLAPLayer p M) M :=
    IsSubnormal.step hEM
      ((Subgroup.normal_subgroupOf_iff_le_normalizer hEM).2
        (CFSG.HardMathSupport.Solomon.UniquenessMaximal.Sec7.le_normalizer_glaPLayer p M))
      (IsSubnormal.refl M)
  have hYM : IsComponentOf Y M := ⟨hY.1.trans hEM, hY.2.1.trans hEsn, hY.2.2⟩
  exact Bridges1.comp_diag_hom D hDM hgen hDN hψ (fun X₀ hX₀ => (hcomp X₀ hX₀).2.2) hYM

