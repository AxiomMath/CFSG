        (CFSG.Open.IsElemAbelian.comm hB hbB hβB)).1 hbX₀
  obtain ⟨X₀, hX₀, φ₀, hφ₀s, hφ₀k⟩ := Bridges1.diag_hom_of_family X p hp (orbitProd1311 B K)
    (orbitSet1311 B K) b hbo (le_normalizer_orbitProd1311 hbB) hL
    (fun K' hK' => isComponentOf_orbitProd1311 hK hK') hcomm hcase' Y hY
  obtain ⟨β, hβB, rfl⟩ := hX₀
  let e : ↥K ≃* ↥(GLBConj β K) :=
    Subgroup.equivMapOfInjective K (MulAut.conj β⁻¹).toMonoidHom (MulAut.conj β⁻¹).injective
  refine ⟨φ₀.comp e.toMonoidHom, hφ₀s.comp e.surjective, fun x hx => ?_⟩
  have hx1 : φ₀ (e x) = 1 := hx
  have hxc : e x ∈ Subgroup.center ↥(GLBConj β K) := hφ₀k hx1
