  have hcomm : ∀ X₁ ∈ orbitSet1311 B K, ∀ X₂ ∈ orbitSet1311 B K, X₁ ≠ X₂ →
      ∀ x ∈ X₁, ∀ y ∈ X₂, x * y = y * x := by
    intro X₁ h₁ X₂ h₂ hne x hx y hy
    have hc := (Subgroup.commutator_eq_bot_iff_le_centralizer.1
      (orbit_commute1311 hK X₁ h₁ X₂ h₂ hne)) hx
    exact (Subgroup.mem_centralizer_iff.1 hc y hy).symm
  have hcase' : b ∈ Subgroup.centralizer ((orbitProd1311 B K : Subgroup X) : Set X) ∨
      ∀ X₀ ∈ orbitSet1311 B K, b ∉ Subgroup.normalizer (X₀ : Set X) := by
    rcases hcase with hc | hn
    · exact Or.inl hc
