        have e2 : u⁻¹ * (f⁻¹ * u * f⁻¹⁻¹) = u⁻¹ * f⁻¹ * u * f := by group
        rwa [e2] at h2
      by_cases hc : u⁻¹ * f⁻¹ * u * f = 1
