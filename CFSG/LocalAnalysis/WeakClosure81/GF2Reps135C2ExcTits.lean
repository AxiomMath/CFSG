theorem w135c2_four_le_mQuot_tits
    {W : Type} [CommGroup W] [Finite W] (hW : ∀ w : W, w ^ 2 = 1)
    {Y L : Subgroup (MulAut W)} {t : MulAut W} (hctx : Is135Context Y L) (htY : t ∈ Y)
    (ht2 : orderOf t = 2) {n f : ℕ}
    (hlie : LieModel (↥L ⧸ Subgroup.center ↥L) .Tits n 2 f) :
    4 ≤ E3.mQuot ⊤ (fixV (Subgroup.zpowers t)) := by
  have hW' : ∀ w : W, w * w = 1 := fun w => by rw [← pow_two]; exact hW w
  have : Finite (MulAut W) := MulEquiv.finite_left
  have hq : IsQuasisimple ↥L := hctx.2.2.2.2.1
  have hZodd : Odd (Nat.card (Subgroup.center ↥L)) := w135_odd_card_center hctx
  obtain ⟨-, hRee⟩ := CFSG.Blueprint.LieModel.reeTitsModel hlie (by decide)
  obtain ⟨-, -, -, -, hf1⟩ := hRee.1
  subst hf1
  have : Group.IsPerfect ↥L := hq.1
  obtain ⟨K, hKfield, hKfin, hKchar, hK2, ⟨e'⟩⟩ :=
    CFSG.SectionRank.exists_mulEquiv_titsGroup_of_model hRee
  let hField := hKfield
  let hFin := hKfin
  let hChar := hKchar
  let π : ↥L →* _ := e'.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center ↥L))
  have hker : π.ker = Subgroup.center ↥L := by
    dsimp only [π]
    rw [MonoidHom.ker_comp_of_injective (QuotientGroup.mk' (Subgroup.center ↥L))
      e'.toMonoidHom e'.injective, QuotientGroup.ker_mk']
  have hsurj : Function.Surjective π := by
    dsimp only [π]
    exact e'.surjective.comp (QuotientGroup.mk'_surjective _)
  have hbot : Subgroup.center ↥L = ⊥ := by
    have h0 := CFSG.SectionRank.Tits_perfect_odd_cover_trivial (K := K) hK2 π hsurj
      hker.le (by rw [hker]; exact hZodd)
    rwa [hker] at h0
  obtain ⟨e⟩ :=
    CFSG.Sporadic.Schreier.Tits.titsModelEquiv (↥L ⧸ Subgroup.center ↥L) 2 1 hRee
  have hinner : ∀ α : MulAut CFSG.Sporadic.Schreier.Tits.titsD, α * α = 1 →
      α ∈ (MulAut.conj : CFSG.Sporadic.Schreier.Tits.titsD →*
        MulAut CFSG.Sporadic.Schreier.Tits.titsD).range :=
    fun α hα => CFSG.Quasithin.B42Tits.mem_range_conj_of_mul_self α hα
  have htL : t ∈ L := w135c2_mem_of_involutory_inner hW hctx hbot e htY ht2 hinner
  obtain ⟨x, hxt⟩ : ∃ x : ↥L, (x : MulAut W) = t := ⟨⟨t, htL⟩, rfl⟩
  have hx2 : x * x = 1 := by
    refine Subtype.ext ?_
    change (x : MulAut W) * (x : MulAut W) = 1
    rw [hxt, ← sq, ← ht2]
    exact pow_orderOf_eq_one t
  have hx1 : x ≠ 1 := by
    intro h
    have h1 : t = 1 := by rw [← hxt, h]; rfl
    rw [h1, orderOf_one] at ht2
    exact absurd ht2 (by norm_num)
  have hπ1 : CFSG.Quasithin.B42Disp.modelProj L e x ≠ 1 := fun h =>
    hx1 (CFSG.Quasithin.B45Tor.modelProj_injective L hbot e (h.trans (map_one _).symm))
  have h2 : orderOf (CFSG.Quasithin.B42Disp.modelProj L e x) = 2 :=
    orderOf_eq_prime (by rw [sq, ← map_mul, hx2, map_one]) hπ1
  have h6 : 2 ^ 6 ≤ (fixV (Subgroup.zpowers (x : MulAut W))).index := by
    rcases CFSG.Sporadic.Schreier.Tits.titsD_involution_conj _ h2 with hz | ht'
    · exact CFSG.Quasithin.B45Tor.two_pow_le_index_titsZ hW' L hbot e hz
    · exact (Nat.pow_le_pow_right (by norm_num) (by norm_num : 6 ≤ 12)).trans
        (CFSG.Quasithin.B45Tor.two_pow_le_index_titsT hW' L hbot e ht')
  rw [hxt] at h6
  have := w135c2_le_mQuot_of_two_pow_le_index hW t h6
  omega

end CFSG.LocalAnalysis.WeakClosure81
