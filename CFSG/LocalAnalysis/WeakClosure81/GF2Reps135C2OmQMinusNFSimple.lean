open CFSG.LieType.Universal.Spin CFSG.LieType.Universal.Spin.Twisted CFSG.StandardType

theorem omqnfActs_minusWeyl_of_lt {n : ℕ} {K : Type} [Field K] [CharP K 2] {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) {k : Fin (n - 1)} (hk : k.val + 1 < n - 1) :
    omqnfActs n b c (Equiv.swap k ⟨k.val + 1, hk⟩) (1 : Fin (n - 1) → ℤ)
      (spinAction (quadMinus n K b c) (minusWeyl n hirr k)) := by
  refine ⟨fun x => ?_, fun p => ?_⟩
  · rcases x with a | a
    · rw [spMonoPerm_inl]
      simp only [Pi.one_apply, if_true]
      exact CFSG.SeitzReduction.SymplecticPilot.spinAction_minusWeyl_minusVec hirr hk a true
    · rw [spMonoPerm_inr]
      simp only [Pi.one_apply, if_true]
      exact CFSG.SeitzReduction.SymplecticPilot.spinAction_minusWeyl_minusVec hirr hk a false
  · simp only [Pi.one_apply, Finset.prod_const_one, if_true]
    exact CFSG.SeitzReduction.SymplecticPilot.spinAction_minusWeyl_planeVec hirr hk p

private theorem omqnfsm_prod_spSgn {m : ℕ} (k : Fin m) : ∏ a, spSgn k a = -1 := by
  unfold spSgn
  simp [Finset.prod_ite_eq']

theorem omqnfActs_minusWeyl_of_not_lt {n : ℕ} {K : Type} [Field K] [CharP K 2] {b c : K}
    (hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0) {k : Fin (n - 1)} (hk : ¬ k.val + 1 < n - 1) :
    omqnfActs n b c (1 : Equiv.Perm (Fin (n - 1))) (spSgn k)
      (spinAction (quadMinus n K b c) (minusWeyl n hirr k)) := by
  rw [minusWeyl_of_not_lt n hirr hk]
  have hsign : ∀ m : Fin (n - 1), (longWeylSign k m : K) = 1 := by
    intro m
    unfold longWeylSign
    split_ifs
    · exact CharTwo.neg_eq 1
    · rfl
  refine ⟨fun x => ?_, fun p => ?_⟩
  · rcases x with a | a
    · rw [spMonoPerm_inl]
      have h := spinAction_shortWeyl_minusVec n hirr k a true
      rw [hsign, one_smul] at h
      by_cases ha : a = k
      · subst ha
        have : spSgn a a ≠ 1 := by simp [spSgn]
        rw [if_neg this]
        simpa [omqnfFrame, shortWeylBool] using h
      · have : spSgn k a = 1 := by simp [spSgn, ha]
        rw [if_pos this]
        simpa [omqnfFrame, shortWeylBool, ha] using h
    · rw [spMonoPerm_inr]
      have h := spinAction_shortWeyl_minusVec n hirr k a false
      rw [hsign, one_smul] at h
      by_cases ha : a = k
      · subst ha
        have : spSgn a a ≠ 1 := by simp [spSgn]
        rw [if_neg this]
        simpa [omqnfFrame, shortWeylBool] using h
      · have : spSgn k a = 1 := by simp [spSgn, ha]
        rw [if_pos this]
        simpa [omqnfFrame, shortWeylBool, ha] using h
  · rw [omqnfsm_prod_spSgn, if_neg (by norm_num)]
    exact spinAction_shortWeyl_planeVec n hirr k p

end CFSG.LocalAnalysis.WeakClosure81
