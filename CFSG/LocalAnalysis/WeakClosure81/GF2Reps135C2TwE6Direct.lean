private theorem tw2e6_four_le_inner {f : ℕ} {K : Type} [Field K] [Finite K] [CharP K 2]
    (hf : 1 ≤ f) (hK : Nat.card K = (2 ^ f) ^ 2) {σ : K →+* K}
    (hσ : ∀ c, σ c = c ^ (2 ^ f)) {k : Type} [Field k] [Finite k] [CharP k 2] [Algebra K k]
    {m : ℕ} {ρ : Representation k ↥(TwistedE6.fixedGroup K σ) (Fin m → k)}
    (hρ : IsSimpleRep ρ) {y : Fin m → k} {χ : ↥(TwistedE6.fixedGroup K σ) → k}
    {J : Finset (Fin TwistTag.E6.foldedTag.rank)}
    (ht : IsCoverType (twistedE6CoverRankOne hf hK σ hσ) ρ y χ J)
    (hJ : J ≠ Finset.univ) (i : Fin 3) {z : ↥(TwistedE6.fixedGroup K σ)}
    (hz : ((coverHom hf hK σ hσ z : ↥(graphFixedRootGroup TwistTag.E6 K σ)) :
      ModGL TwistTag.E6.tag K) = tw2e6InnerRep K i) :
    4 ≤ Module.finrank k (LinearMap.range (ρ z - 1)) := by
  classical
  obtain ⟨b, hbJ⟩ : ∃ b : Fin TwistTag.E6.foldedTag.rank, b ∉ J := by
    by_contra hcon
    push Not at hcon
    exact hJ (Finset.eq_univ_iff_forall.2 hcon)
  obtain ⟨g, hg⟩ := tw2e6_exists_conj_mem_H_inner (f := f) (hf := hf) (K := K) (hK := hK)
    (σ := σ) (hσ := hσ) i hz
  have hv : ∀ j : Fin TwistTag.E6.foldedTag.rank,
      reflect TwistTag.E6.foldedTag j (f4Weight b) ≠ f4Weight b → j ∉ J := by
    intro j hj
    have hjb : j = b := by
      by_contra hne
      exact hj (f4Weight_fixed b j hne)
    exact hjb ▸ hbJ
  have h4 := tw2e6_le_finrank_range_sub_one (f := f) (hf := hf) (K := K) (hK := hK)
    (σ := σ) (hσ := hσ) (k := k) (m := m) (ρ := ρ) hρ (y := y) (χ := χ) (J := J) ht
    (v := f4Weight b) hv (tw2e6InnerWord i) hg (tw2e6InnerPairs i b)
    (tw2e6InnerPairs_nodup i b)
  have hlen : (tw2e6InnerPairs i b).length = 4 := tw2e6InnerPairs_length i b
  have h4' : 4 ≤ Module.finrank k (LinearMap.range (ρ (g * z * g⁻¹) - 1)) := by
    calc 4 = (tw2e6InnerPairs i b).length := hlen.symm
      _ ≤ Module.finrank k (LinearMap.range (ρ (g * z * g⁻¹) - 1)) := h4
  rwa [CFSG.HardMathSupport.Meierfrankenfeld.PSUScalar.finrank_range_rep_conj_sub_one ρ g z]
    at h4'

private theorem tw2e6_seven_le_outer {f : ℕ} {K : Type} [Field K] [Finite K] [CharP K 2]
    (hf : 1 ≤ f) (hK : Nat.card K = (2 ^ f) ^ 2) {σ : K →+* K}
    (hσ : ∀ c, σ c = c ^ (2 ^ f)) {k : Type} [Field k] [Finite k] [CharP k 2] [Algebra K k]
    {m : ℕ} {ρ : Representation k ↥(TwistedE6.fixedGroup K σ) (Fin m → k)}
    (hρ : IsSimpleRep ρ) {y : Fin m → k} {χ : ↥(TwistedE6.fixedGroup K σ) → k}
    {J : Finset (Fin TwistTag.E6.foldedTag.rank)}
    (ht : IsCoverType (twistedE6CoverRankOne hf hK σ hσ) ρ y χ J)
    (hJ : J ≠ Finset.univ) {δ : ℕ} (hδ : 1 ≤ δ)
    (hχpow : ∀ h ∈ (twistedE6CoverData hf hK σ hσ).datum.H, χ h ^ (2 ^ δ) = χ h)
    {d : orbitField TwistTag.E6 K σ twN0} (hd : d ≠ 0)
    {z : ↥(TwistedE6.fixedGroup K σ)}
    (hz : coverHom hf hK σ hσ z = xC TwistTag.E6 K σ twN0 d) :
    7 ≤ δ * Module.finrank k (LinearMap.range (ρ z - 1)) := by
  classical
  by_cases hcase : ∃ b : Fin TwistTag.E6.foldedTag.rank, b ≠ twN3 ∧ b ∉ J
  · obtain ⟨b, hb3, hbJ⟩ := hcase
    obtain ⟨g, hg⟩ := tw2e6_exists_conj_mem_H_outer (f := f) (hf := hf) (K := K) (hK := hK)
      (σ := σ) (hσ := hσ) (d := d) hd hz
    have hv : ∀ j : Fin TwistTag.E6.foldedTag.rank,
        reflect TwistTag.E6.foldedTag j (f4Weight b) ≠ f4Weight b → j ∉ J := by
      intro j hj
      have hjb : j = b := by
        by_contra hne
        exact hj (f4Weight_fixed b j hne)
      exact hjb ▸ hbJ
    have h7 := tw2e6_le_finrank_range_sub_one (f := f) (hf := hf) (K := K) (hK := hK)
      (σ := σ) (hσ := hσ) (k := k) (m := m) (ρ := ρ) hρ (y := y) (χ := χ) (J := J) ht
      (v := f4Weight b) hv [twN0] hg (tw2e6OuterPairs b) (tw2e6OuterPairs_nodup b)
    have hlen : (tw2e6OuterPairs b).length = 7 := tw2e6OuterPairs_length_of_ne b hb3
    have h7' : 7 ≤ Module.finrank k (LinearMap.range (ρ (g * z * g⁻¹) - 1)) := by
      calc 7 = (tw2e6OuterPairs b).length := hlen.symm
        _ ≤ Module.finrank k (LinearMap.range (ρ (g * z * g⁻¹) - 1)) := h7
    rw [CFSG.HardMathSupport.Meierfrankenfeld.PSUScalar.finrank_range_rep_conj_sub_one ρ g z]
      at h7'
    exact le_trans h7' (Nat.le_mul_of_pos_left _ (by omega))
  · push Not at hcase
    have h3out : twN3 ∉ J := by
      by_contra h3
      apply hJ
      rw [Finset.eq_univ_iff_forall]
      intro b
      by_cases hb : b = twN3
      · exact hb ▸ h3
      · exact hcase b hb
    have hJeq : J = Finset.univ.erase twN3 := by
      apply Finset.ext
      intro b
      simp only [Finset.mem_erase, Finset.mem_univ, and_true]
      exact ⟨fun hb hb3 => h3out (hb3 ▸ hb), fun hb3 => hcase b hb3⟩
    obtain ⟨g, hg⟩ := tw2e6_exists_conj_mem_H_outer (f := f) (hf := hf) (K := K) (hK := hK)
      (σ := σ) (hσ := hσ) (d := d) hd hz
    have hv : ∀ j : Fin TwistTag.E6.foldedTag.rank,
        reflect TwistTag.E6.foldedTag j (f4Weight twN3) ≠ f4Weight twN3 → j ∉ J := by
      intro j hj
      have hjb : j = twN3 := by
        by_contra hne
        exact hj (f4Weight_fixed twN3 j hne)
      exact hjb ▸ h3out
    have h4 := tw2e6_le_finrank_range_sub_one (f := f) (hf := hf) (K := K) (hK := hK)
      (σ := σ) (hσ := hσ) (k := k) (m := m) (ρ := ρ) hρ (y := y) (χ := χ) (J := J) ht
      (v := f4Weight twN3) hv [twN0] hg (tw2e6OuterPairs twN3) (tw2e6OuterPairs_nodup twN3)
    have hlen3 : (tw2e6OuterPairs twN3).length = 4 := tw2e6OuterPairs_length_three
    have h4' : 4 ≤ Module.finrank k (LinearMap.range (ρ (g * z * g⁻¹) - 1)) := by
      calc 4 = (tw2e6OuterPairs twN3).length := hlen3.symm
        _ ≤ Module.finrank k (LinearMap.range (ρ (g * z * g⁻¹) - 1)) := h4
    rw [CFSG.HardMathSupport.Meierfrankenfeld.PSUScalar.finrank_range_rep_conj_sub_one ρ g z]
      at h4'
    by_cases hδ1 : δ = 1
    · subst δ
      have hχ1 : ∀ h ∈ (twistedE6CoverData hf hK σ hσ).datum.H, χ h = 1 := by
        intro h hh
        have h2 : χ h ^ 2 = χ h := by simpa using hχpow h hh
        have hyρ : ρ h y ≠ 0 := by
          intro h0
          apply ht.2.1
          have hinv : ρ h⁻¹ (ρ h y) = y := by
            rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one,
              Module.End.one_apply]
          rw [h0, map_zero] at hinv
          exact hinv.symm
        have hhy : ρ h y = χ h • y := ht.2.2.1 h hh
        have hne : χ h ≠ 0 := by
          intro h0
          apply hyρ
          rw [hhy, h0, zero_smul]
        have h2' : χ h * χ h = χ h := by simpa [sq] using h2
        exact mul_left_cancel₀ hne (by rw [mul_one, h2'])
      have hcov : coverHom hf hK σ hσ z =
          coverHom hf hK σ hσ (hatX hf hK σ hσ twN0 d) := by
        rw [hz, coverHom_hatX hf hK σ hσ twN0 d]
      have hrep : ρ z = ρ (hatX hf hK σ hσ twN0 d) :=
        tw2e6_rep_eq_of_coverHom_eq (f := f) (hf := hf) (K := K) (hK := hK) (σ := σ)
          (hσ := hσ) hρ ht hχ1 hcov
      have hrank : 7 ≤ Module.finrank k (LinearMap.range (ρ z - 1)) := by
        rw [hrep]
        by_cases hf1 : f = 1
        · have hunits : Nat.card (orbitField TwistTag.E6 K σ twN3)ˣ = 1 := by
            rw [Nat.card_units, twCard_orbitField hf K hK σ hσ]
            simp [twNdig, twN3, hf1]
          have hw1 : ∀ w : (orbitField TwistTag.E6 K σ twN3)ˣ,
              ((w : orbitField TwistTag.E6 K σ twN3) : K) = 1 := by
            intro w
            have : Subsingleton (orbitField TwistTag.E6 K σ twN3)ˣ :=
              (Nat.card_eq_one_iff_unique.mp hunits).1
            have h1 : w = 1 := Subsingleton.elim w 1
            rw [h1]
            simp
          have h78 : Tw78Type hf K hK σ hσ k χ J := by
            refine ⟨hJeq, 0, by omega, fun w => ?_⟩
            have hmem := (twistedE6CoverRankOne hf hK σ hσ).hh_mem twN3 w
            rw [hχ1 (hatH hf hK σ hσ twN3 w) hmem, hw1 w]
            simp
          have h22 := twE6AdjDisplacement_holds (f := f) (hf := hf) (K := K) (hK := hK)
            (σ := σ) (hσ := hσ)
          have h22' := h22 k m ρ y χ J hρ ht h78 (hatX hf hK σ hσ twN0 d)
            ((twistedE6CoverRankOne hf hK σ hσ).x_ne_one twN0 (u := Units.mk0 d hd))
            (hatX_sq hf hK σ hσ twN0 d)
          omega
        · have hf2 : 2 ≤ f := by omega
          have hstein := tw2e6_two_pow_le_finrank_steinberg (f := f) (hf := hf) (K := K)
            (hK := hK) (σ := σ) (hσ := hσ) (k := k) (m := m) hρ ht h3out hχ1 hd
          have h3 : 3 ≤ 2 * f - 1 := by omega
          have h8 : 8 ≤ 2 ^ (2 * f - 1) := by
            calc 8 = 2 ^ 3 := by norm_num
              _ ≤ 2 ^ (2 * f - 1) := Nat.pow_le_pow_right (by norm_num) h3
          omega
      simpa using hrank
    · have hδ2 : 2 ≤ δ := by omega
      calc 7 ≤ 2 * 4 := by norm_num
        _ ≤ 2 * Module.finrank k (LinearMap.range (ρ z - 1)) := Nat.mul_le_mul_left 2 h4'
        _ ≤ δ * Module.finrank k (LinearMap.range (ρ z - 1)) :=
            Nat.mul_le_mul_right _ hδ2

theorem w135c2_four_le_mQuot_twistedE6_direct (hW : ∀ w : W, w ^ 2 = 1)
    (hctx : Is135Context Y L) (htY : t ∈ Y) (ht2 : orderOf t = 2) {n f : ℕ}
    (hlie : LieModel (↥L ⧸ Subgroup.center ↥L) .twistedE6 n 2 f) :
    4 ≤ E3.mQuot ⊤ (fixV (Subgroup.zpowers t)) := by
  classical
  obtain ⟨hadm, htw⟩ := hlie.chevalleyExceptionalModel (t := .twistedE6) (by decide)
  obtain ⟨-, hf, -⟩ := hadm
  obtain ⟨K, hKfield, hKfinite, hKcard, σ, hσ, ⟨e⟩⟩ := htw
  have hKf : Nat.card K = (2 ^ f) ^ 2 := by
    rw [show TwistTag.E6.order = 2 from rfl] at hKcard
    exact hKcard
  have hcharK : CharP K 2 :=
    CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic Nat.prime_two
      (k := 2 * f) (by omega) (by rw [hKf, ← pow_mul]; ring_nf)
  let : Field K := hKfield
  let : Finite K := hKfinite
  let : CharP K 2 := hcharK
  let d := derivedCentralQuotientEquiv (t := TwistTag.E6) Nat.prime_two hf hKf σ hσ
  let eS : ↥L ⧸ Subgroup.center ↥L ≃* ↥(graphFixedRootGroup TwistTag.E6 K σ) := e.trans d
  have hW' : ∀ w : W, w * w = 1 := fun w => by rw [← pow_two]; exact hW w
  have hirr : CFSG.QuasithinUnique.Setup.X1.IsIrrOn L := w135c2_x1IsIrrOn_of_ctx hctx
  have hperf : Group.IsPerfect ↥L := hctx.2.2.2.2.1.1
  have hodd : Odd (Nat.card (Subgroup.center ↥L)) := w135_odd_card_center hctx
  have : Nontrivial ↥L := by
    have : IsSimpleGroup (↥L ⧸ Subgroup.center ↥L) := hctx.2.2.2.2.1.2.1
    exact (QuotientGroup.mk'_surjective (Subgroup.center ↥L)).nontrivial
  obtain ⟨δ, m, k, hkfield, hkfinite, hkchar, hAlg, ρ, hδ, hρ, hρinj, hfix, hent⟩ :=
    w135c2_periodic_fix_entries (S := ↥L) (K := K) (n := 2 * f) hW' hirr
      (MulEquiv.refl ↥L) (by omega) (by rw [hKf, ← pow_mul]; ring_nf)
  let : Field k := hkfield
  let : Finite k := hkfinite
  let : CharP k 2 := hkchar
  let : Algebra K k := hAlg
  have hsplit := twistedCover_split hf hKf σ hσ k
  by_cases htL : t ∈ L
  · let t₀ : ↥L := ⟨t, htL⟩
    have ht1 : t ≠ 1 := by
      intro h
      rw [h, orderOf_one] at ht2
      omega
    have ht₀2 : t₀ ^ 2 = 1 := by
      refine Subtype.ext ?_
      simpa [Subgroup.coe_pow, ht2] using pow_orderOf_eq_one t
    have ht₀1 : t₀ ≠ 1 := by
      intro h
      exact ht1 (congrArg Subtype.val h)
    have ht₀Z : t₀ ∉ Subgroup.center ↥L := by
      intro hmem
      have h2 : orderOf (⟨t₀, hmem⟩ : Subgroup.center ↥L) = 2 := by
        refine orderOf_eq_prime ?_ ?_
        · refine Subtype.ext ?_
          simpa [Subgroup.coe_pow] using ht₀2
        · intro h
          exact ht₀1 (by simpa using congrArg Subtype.val h)
      have hdvd : 2 ∣ Nat.card (Subgroup.center ↥L) := by
        have h := orderOf_dvd_natCard (⟨t₀, hmem⟩ : Subgroup.center ↥L)
        rwa [h2] at h
      exact (Nat.not_odd_iff_even.mpr (even_iff_two_dvd.mpr hdvd)) hodd
    have hx2 : (eS ((QuotientGroup.mk' (Subgroup.center ↥L)) t₀)) ^ 2 = 1 := by
      rw [← map_pow eS, ← map_pow (QuotientGroup.mk' (Subgroup.center ↥L)), ht₀2]
      simp
    have hx1 : eS (QuotientGroup.mk t₀) ≠ 1 := by
      intro h
      apply ht₀Z
      have h1 : (QuotientGroup.mk t₀ : ↥L ⧸ Subgroup.center ↥L) = 1 := by
        apply eS.injective
        rw [map_one]
        exact h
      exact (QuotientGroup.eq_one_iff t₀).1 h1
    obtain ⟨g, hg⟩ :=
      CFSG.SeitzReduction.TwistedE6Pilot.exists_conj_repX_or_classV (f := f) (K := K) hf hKf
        (σ := σ) hσ hx2 hx1
