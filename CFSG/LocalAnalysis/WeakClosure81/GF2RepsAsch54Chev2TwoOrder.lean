theorem le_of_mem_calL0Orders_eight : ∀ c ∈ calL0Orders 8, 504 ≤ c := by
  have h : (calL0Orders 8).all (fun c => decide (504 ≤ c)) = true := by
    decide +kernel
  exact fun c hc => of_decide_eq_true (List.all_eq_true.mp h c hc)

theorem not_isCalL0_of_natCard_lt (hO : LieOrderFormulasInput) {X : Type} [Group X] [Finite X]
    (hX : Nat.card X < 504) : ¬ IsCalL0 X := by
  intro hcal
  have h9 : ¬ 2 ^ 9 ∣ Nat.card X := by
    intro hdvd
    have hle := Nat.le_of_dvd Nat.card_pos hdvd
    norm_num at hle
    omega
  exact absurd (le_of_mem_calL0Orders_eight _ (natCard_mem_calL0Orders hO hcal h9)) (by omega)

theorem not_hasCompFactor_isCalL0_of_natCard_lt (hO : LieOrderFormulasInput) {Y : Type}
    [Group Y] [Finite Y] {A : Subgroup Y} (hA : Nat.card A < 504) :
    ¬ HasCompFactor A IsCalL0 := by
  rintro ⟨L, _, hL, hcal⟩
  have : Finite L := isCompositionFactor_finite hL
  have hdvd : Nat.card L ∣ Nat.card A := isCompositionFactor_natCard_dvd hL
  have hLlt : Nat.card L < 504 := lt_of_le_of_lt (Nat.le_of_dvd Nat.card_pos hdvd) hA
  exact not_isCalL0_of_natCard_lt hO hLlt hcal

theorem not_hasCompFactor_isCalL0_range_SL2 (hO : LieOrderFormulasInput) {F : Type} [Field F]
    [Finite F] (hF : Nat.card F ≤ 4) {K : Type} [Group K] [Finite K]
    (l : Matrix.SpecialLinearGroup (Fin 2) F →* K) : ¬ HasCompFactor l.range IsCalL0 := by
  classical
  let : Fintype F := Fintype.ofFinite F
  set q := Nat.card F with hq
  have hq2 : 2 ≤ q := by
    have := Finite.one_lt_card (α := F)
    omega
  have hSL : Nat.card (Matrix.SpecialLinearGroup (Fin 2) F) = q * (q ^ 2 - 1) := by
    rw [CFSG.LocalAnalysis.ComponentInitial.LinearFlag.card_SL_eq (n := 2) (by norm_num),
      ← hq, (by decide : Finset.Icc 2 2 = {2}), Finset.prod_singleton]
    norm_num
  have hqle : q * (q ^ 2 - 1) ≤ 60 := by
    interval_cases q <;> norm_num
  have hlt : Nat.card l.range < 504 := by
    have hle := Nat.le_of_dvd Nat.card_pos (Subgroup.card_range_dvd l)
    rw [hSL] at hle
    omega
  exact not_hasCompFactor_isCalL0_of_natCard_lt hO hlt

theorem not_hasCompFactor_isCalL0_range_SL3 (hO : LieOrderFormulasInput) {F : Type} [Field F]
    [Finite F] (hF : Nat.card F = 2 ∨ Nat.card F = 4) {K : Type} [Group K] [Finite K]
    (l : Matrix.SpecialLinearGroup (Fin 3) F →* K) : ¬ HasCompFactor l.range IsCalL0 := by
  classical
  let : Fintype F := Fintype.ofFinite F
  rintro ⟨Z, _, hL, hcal⟩
  have : Finite Z := isCompositionFactor_finite hL
  have hSL3 : E1.IsCompositionFactor (Matrix.SpecialLinearGroup (Fin 3) F) Z :=
    CFSG.Quasithin.H13.L829N.isCompositionFactor_of_surjective l.rangeRestrict
      l.rangeRestrict_surjective hL
  rcases hF with hF2 | hF4
  · have hSL : Nat.card (Matrix.SpecialLinearGroup (Fin 3) F) = 168 := by
      rw [CFSG.LocalAnalysis.ComponentInitial.LinearFlag.card_SL_eq (n := 3) (by norm_num),
        hF2, (by decide : Finset.Icc 2 3 = {2, 3}), Finset.prod_pair (by norm_num)]
      norm_num
    have hlt : Nat.card l.range < 504 := by
      have hle := Nat.le_of_dvd Nat.card_pos (Subgroup.card_range_dvd l)
      rw [hSL] at hle
      omega
    have hZlt : Nat.card Z < 504 :=
      lt_of_le_of_lt (Nat.le_of_dvd Nat.card_pos (isCompositionFactor_natCard_dvd hL)) hlt
    exact not_isCalL0_of_natCard_lt hO hZlt hcal
  · have hSL : Nat.card (Matrix.SpecialLinearGroup (Fin 3) F) = 60480 := by
      rw [CFSG.LocalAnalysis.ComponentInitial.LinearFlag.card_SL_eq (n := 3) (by norm_num),
        hF4, (by decide : Finset.Icc 2 3 = {2, 3}), Finset.prod_pair (by norm_num)]
      norm_num
    have hC3 : Nat.card (Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) F)) = 3 := by
      rw [Nat.card_congr (Matrix.SpecialLinearGroup.center_equiv_rootsOfUnity'
        (0 : Fin 3)).toEquiv]
      rw [show Fintype.card (Fin 3) = 3 by norm_num]
      have hroot : rootsOfUnity 3 F = (powMonoidHom 3 : Fˣ →* Fˣ).ker := by
        ext x
        rw [mem_rootsOfUnity, MonoidHom.mem_ker, powMonoidHom_apply]
      rw [hroot, IsCyclic.card_powMonoidHom_ker, Nat.card_units, hF4]
      norm_num
    have hQcard : Nat.card (Matrix.SpecialLinearGroup (Fin 3) F ⧸
        Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) F)) = 20160 := by
      have h := Subgroup.card_eq_card_quotient_mul_card_subgroup
        (Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) F))
      rw [hSL, hC3] at h
      omega
    rcases isCompositionFactor_of_normal
      (Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) F)) hSL3 with hC | hQ
    · have hdvd : Nat.card Z ∣
          Nat.card (Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) F)) :=
        isCompositionFactor_natCard_dvd hC
      have hZlt : Nat.card Z < 504 := by
        have hle := Nat.le_of_dvd Nat.card_pos hdvd
        omega
      exact not_isCalL0_of_natCard_lt hO hZlt hcal
    · have : IsSimpleGroup (Matrix.SpecialLinearGroup (Fin 3) F ⧸
          Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) F)) :=
        (CFSG.LinearGroups.linear_projective_simple (K := F) (n := 3) (by norm_num)
          (Or.inl le_rfl)).2.1
      obtain ⟨e⟩ := isCompositionFactor_mulEquiv_of_isSimpleGroup hQ
      have hZcard : Nat.card Z = 20160 := by
        rw [← Nat.card_congr e.toEquiv]
        exact hQcard
      exact not_isCalL0_of_card hO (k := 6) (by decide +kernel) hZcard hcal

theorem not_hasCompFactor_isCalL0_range_Sp4 (hO : LieOrderFormulasInput) {F : Type} [Field F]
    [Finite F] (hF : Nat.card F = 2) {K : Type} [Group K] [Finite K] (l : StatedSp 2 F →* K) :
    ¬ HasCompFactor l.range IsCalL0 := by
  classical
  let : Fintype F := Fintype.ofFinite F
  have hF' : Fintype.card F = 2 := by rw [← Nat.card_eq_fintype_card, hF]
  have hSp : Nat.card ↥(StatedSp 2 F) = 720 := by
    rw [Nat.card_congr (CFSG.QuasithinUnique.Bridge.Alt57Model.spEquivPerm F hF').toEquiv,
      Nat.card_perm, Nat.card_fin]
    norm_num
  have hdvd : Nat.card l.range ∣ Nat.card ↥(StatedSp 2 F) := Subgroup.card_range_dvd l
  rw [hSp] at hdvd
  exact not_hasCompFactor_isCalL0_of_dvd hO (k := 4) (N := 720) (by decide +kernel) hdvd

@[expose] def overgroupCheck (k N p : ℕ) : Bool :=
  decide (2 ^ k ∣ N) && decide (¬ 2 ^ (k + 1) ∣ N) && (calL0Orders k).all fun c =>
    decide (¬ Nat.lcm c (2 ^ k) ∣ N ∨ Nat.lcm c (2 ^ k) = N ∨ N / Nat.lcm c (2 ^ k) < p)

theorem le_index_of_prime_dvd_natCard {X : Type} [Group X] [Finite X] [IsSimpleGroup X]
    {Y : Subgroup X} (hY : Y ≠ ⊤) {p : ℕ} (hp : p.Prime) (hpX : p ∣ Nat.card X) :
    p ≤ Y.index := by
  have : Y.FiniteIndex := ⟨Subgroup.index_ne_zero_of_finite⟩
  have h1 := Subgroup.index_normalCore_dvd_factorial_index (H := Y)
  have h2 : Y.normalCore = ⊥ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal Y.normalCore with h | h
    · exact h
    · exact absurd (eq_top_iff.2 (h ▸ Subgroup.normalCore_le Y)) hY
  rw [h2, Subgroup.index_bot] at h1
  exact (Nat.Prime.dvd_factorial (p := p) (n := Y.index) hp).mp (hpX.trans h1)

theorem not_hasCompFactor_isCalL0_of_overgroupCheck (hO : LieOrderFormulasInput) {X : Type}
    [Group X] [Finite X] [IsSimpleGroup X] {k p : ℕ} (hp : p.Prime) (hpX : p ∣ Nat.card X)
    (h : overgroupCheck k (Nat.card X) p = true) (S : Sylow 2 X) {Y : Subgroup X}
    (hSY : (S : Subgroup X) ≤ Y) (hY : Y < ⊤) : ¬ HasCompFactor Y IsCalL0 := by
  rintro ⟨Z, _, hL, hcal⟩
  have : Finite Z := isCompositionFactor_finite hL
  simp only [overgroupCheck, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
  obtain ⟨⟨h2k, h2k1⟩, hc⟩ := h
  have hNpos : Nat.card X ≠ 0 := Nat.card_pos.ne'
  have hfac : Nat.factorization (Nat.card X) 2 = k := by
    have hle : k ≤ Nat.factorization (Nat.card X) 2 :=
      (Nat.Prime.pow_dvd_iff_le_factorization Nat.prime_two hNpos).1 h2k
    have hge : Nat.factorization (Nat.card X) 2 ≤ k := by
      by_contra hlt
      exact h2k1 ((Nat.Prime.pow_dvd_iff_le_factorization Nat.prime_two hNpos).2 (by omega))
    omega
  have hScard : Nat.card (S : Subgroup X) = 2 ^ k := by
    rw [Sylow.card_eq_multiplicity, hfac]
  have h2kY : 2 ^ k ∣ Nat.card ↥Y := by
    have hS : 2 ^ k ∣ Nat.card ↥((S : Subgroup X).subgroupOf Y) := by
      rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hSY).toEquiv, hScard]
    exact hS.trans (Subgroup.card_subgroup_dvd_card _)
  have hZdvdY : Nat.card Z ∣ Nat.card ↥Y := isCompositionFactor_natCard_dvd hL
  have hZdvdX : Nat.card Z ∣ Nat.card X := hZdvdY.trans (Subgroup.card_subgroup_dvd_card Y)
  have hZnot : ¬ 2 ^ (k + 1) ∣ Nat.card Z := fun hd => h2k1 (hd.trans hZdvdX)
  have hZmem : Nat.card Z ∈ calL0Orders k := natCard_mem_calL0Orders hO hcal hZnot
  have hlcmY : Nat.lcm (Nat.card Z) (2 ^ k) ∣ Nat.card ↥Y := Nat.lcm_dvd hZdvdY h2kY
  have hlcmX : Nat.lcm (Nat.card Z) (2 ^ k) ∣ Nat.card X :=
    hlcmY.trans (Subgroup.card_subgroup_dvd_card Y)
  have hlcmpos : 0 < Nat.lcm (Nat.card Z) (2 ^ k) :=
    Nat.lcm_pos Nat.card_pos (by positivity)
  have hlcmle : Nat.lcm (Nat.card Z) (2 ^ k) ≤ Nat.card ↥Y :=
    Nat.le_of_dvd Nat.card_pos hlcmY
  rcases hc (Nat.card Z) hZmem with hnot | heq | hlt
  · exact hnot hlcmX
  · have hNX : Nat.card X ∣ Nat.card ↥Y := heq ▸ hlcmY
    have hYX : Nat.card ↥Y ∣ Nat.card X := Subgroup.card_subgroup_dvd_card Y
    have hcard : Nat.card ↥Y = Nat.card X := Nat.dvd_antisymm hYX hNX
    exact hY.ne ((Subgroup.card_eq_iff_eq_top Y).mp hcard)
  · have hpY : p ≤ Y.index := le_index_of_prime_dvd_natCard hY.ne hp hpX
    have hYidx : Y.index ≤ Nat.card X / Nat.lcm (Nat.card Z) (2 ^ k) := by
      rw [Nat.le_div_iff_mul_le hlcmpos]
      calc Y.index * Nat.lcm (Nat.card Z) (2 ^ k) ≤ Y.index * Nat.card ↥Y :=
            Nat.mul_le_mul_left _ hlcmle
        _ = Nat.card ↥Y * Y.index := by rw [mul_comm]
        _ = Nat.card X := Subgroup.card_mul_index Y
    exact absurd (hpY.trans hYidx) (not_le_of_gt hlt)

