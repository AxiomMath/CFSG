private def w183finWit (i₁ i₂ i₃ i₄ : Fin 8) : ℕ :=
  (((w183finWitTab.getD i₁.val []).getD i₂.val []).getD i₃.val []).getD i₄.val 0

private def w183finCodeM (X : w183finM2) : ℕ :=
  (X 0 0).toNat + 8 * (X 0 1).toNat + 64 * (X 1 0).toNat + 512 * (X 1 1).toNat

private def w183finDecM (n : ℕ) : w183finM2 :=
  Matrix.of fun i j => GF8.ofNat' (n / 8 ^ (2 * i.val + j.val))

private theorem w183fin_ofNat_add_aux (a : GF8) (m : ℕ) : GF8.ofNat' (a.toNat + 8 * m) = a := by
  obtain ⟨⟨v, hv⟩⟩ := a
  simp only [GF8.ofNat', GF8.toNat, GF8.mk.injEq, Fin.mk.injEq]
  omega

private theorem w183fin_dec_code (X : w183finM2) : w183finDecM (w183finCodeM X) = X := by
  have h0 : (X 0 0).toNat < 8 := (X 0 0).val.isLt
  have h1 : (X 0 1).toNat < 8 := (X 0 1).val.isLt
  have h2 : (X 1 0).toNat < 8 := (X 1 0).val.isLt
  have h3 : (X 1 1).toNat < 8 := (X 1 1).val.isLt
  ext i j
  fin_cases i <;> fin_cases j
  · show GF8.ofNat' (w183finCodeM X / 1) = X 0 0
    rw [show w183finCodeM X / 1 =
      (X 0 0).toNat + 8 * ((X 0 1).toNat + 8 * ((X 1 0).toNat + 8 * (X 1 1).toNat)) by
        unfold w183finCodeM; omega]
    exact w183fin_ofNat_add_aux _ _
  · show GF8.ofNat' (w183finCodeM X / 8) = X 0 1
    rw [show w183finCodeM X / 8 = (X 0 1).toNat + 8 * ((X 1 0).toNat + 8 * (X 1 1).toNat) by
        unfold w183finCodeM; omega]
    exact w183fin_ofNat_add_aux _ _
  · show GF8.ofNat' (w183finCodeM X / 64) = X 1 0
    rw [show w183finCodeM X / 64 = (X 1 0).toNat + 8 * (X 1 1).toNat by
        unfold w183finCodeM; omega]
    exact w183fin_ofNat_add_aux _ _
  · show GF8.ofNat' (w183finCodeM X / 512) = X 1 1
    rw [show w183finCodeM X / 512 = (X 1 1).toNat + 8 * 0 by
        unfold w183finCodeM; omega]
    exact w183fin_ofNat_add_aux _ _

private def w183finStrict (y : ℕ) (k : ℕ → ℕ) : ℕ :=
  match y with
  | 0 => k 0
  | n + 1 => k (n + 1)

private theorem w183finStrict_eq (y : ℕ) (k : ℕ → ℕ) : w183finStrict y k = k y := by
  cases y <;> rfl

private def w183finEvalS (g : Fin 4 → w183finM2) : List (Fin 4) → ℕ → ℕ
  | [], acc => acc
  | i :: w, acc => w183finEvalS g w
      (w183finStrict acc fun a => w183finCodeM (w183finMulM2 (w183finDecM a) (g i)))

private theorem w183finEvalS_eq (g : Fin 4 → w183finM2) : ∀ (w : List (Fin 4)) (X : w183finM2),
    w183finDecM (w183finEvalS g w (w183finCodeM X)) = w.foldl (fun Y i => w183finMulM2 Y (g i)) X
  | [], X => w183fin_dec_code X
  | i :: w, X => by
    simp only [w183finEvalS, List.foldl_cons, w183finStrict_eq, w183fin_dec_code]
    exact w183finEvalS_eq g w _

private def w183finGoodAt (a₁ a₂ b₁ b₂ : GF8) (k : ℕ) (i : Fin 8) : Bool :=
  decide (k < w183finWords.length) &&
    (decide ((⟨i⟩ : GF8) ≠ 0 ∧ (⟨i⟩ : GF8) ≠ a₁ ∧ (⟨i⟩ : GF8) ≠ a₂ ∧ (⟨i⟩ : GF8) ≠ a₁ + a₂) &&
      w183finEvalS ![w183finU a₁, w183finU a₂, w183finL b₁, w183finL b₂]
          (w183finWords.getD k []) (w183finCodeM 1) == w183finCodeM (w183finU (⟨i⟩ : GF8)))

private theorem w183finGood_of_at {a₁ a₂ b₁ b₂ : GF8} {k : ℕ} {i : Fin 8}
    (h : w183finGoodAt a₁ a₂ b₁ b₂ k i = true) : w183finGood a₁ a₂ b₁ b₂ = true := by
  unfold w183finGoodAt at h
  simp only [Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨hmem, hne, heq⟩ := h
  have hne' := of_decide_eq_true hne
  have hev := w183finEvalS_eq ![w183finU a₁, w183finU a₂, w183finL b₁, w183finL b₂]
    (w183finWords.getD k []) 1
  rw [heq, w183fin_dec_code] at hev
  have heval : w183finEvalM ![w183finU a₁, w183finU a₂, w183finL b₁, w183finL b₂]
      (w183finWords.getD k []) = w183finU (⟨i⟩ : GF8) := hev.symm
  unfold w183finGood
  have hk := of_decide_eq_true hmem
  have hw : w183finWords.getD k [] ∈ w183finWords := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hk, Option.getD_some]
    exact List.getElem_mem hk
  exact List.any_eq_true.2 ⟨_, hw, List.any_eq_true.2 ⟨i, w183finCodes_mem i,
    decide_eq_true ⟨hne'.1, hne'.2.1, hne'.2.2.1, hne'.2.2.2, heval⟩⟩⟩

private def w183finKeyRowW (i₁ : Fin 8) : Bool :=
  w183finCodes.all fun i₂ => w183finCodes.all fun i₃ =>
    w183finCodes.all fun i₄ =>
      decide ((⟨i₁⟩ : GF8) = 0) || decide ((⟨i₂⟩ : GF8) = 0) ||
      decide ((⟨i₁⟩ : GF8) = (⟨i₂⟩ : GF8)) || decide ((⟨i₃⟩ : GF8) = 0) ||
      decide ((⟨i₄⟩ : GF8) = 0) || decide ((⟨i₃⟩ : GF8) = (⟨i₄⟩ : GF8)) ||
      w183finGoodAt (⟨i₁⟩ : GF8) (⟨i₂⟩ : GF8) (⟨i₃⟩ : GF8) (⟨i₄⟩ : GF8)
        (w183finWit i₁ i₂ i₃ i₄ / 8) ⟨w183finWit i₁ i₂ i₃ i₄ % 8, Nat.mod_lt _ (by decide)⟩

private def w183finKeyCheckW : Bool := w183finCodes.all w183finKeyRowW

private theorem w183finKeyCheckW_lo : ([0, 1, 2, 3] : List (Fin 8)).all w183finKeyRowW = true := by
  decide +kernel

private theorem w183finKeyCheckW_hi : ([4, 5, 6, 7] : List (Fin 8)).all w183finKeyRowW = true := by
  decide +kernel

private theorem w183finKeyCheckW_eq_true : w183finKeyCheckW = true := by
  unfold w183finKeyCheckW
  rw [show w183finCodes = ([0, 1, 2, 3] : List (Fin 8)) ++ [4, 5, 6, 7] from rfl, List.all_append,
    w183finKeyCheckW_lo, w183finKeyCheckW_hi]
  rfl

private theorem w183finKeyCheck_eq_true : w183finKeyCheck = true := by
  have hW := w183finKeyCheckW_eq_true
  unfold w183finKeyCheckW at hW
  unfold w183finKeyCheck
  simp only [List.all_eq_true, w183finKeyRowW] at hW ⊢
  intro i₁ h₁ i₂ h₂ i₃ h₃ i₄ h₄
  have h := hW i₁ h₁ i₂ h₂ i₃ h₃ i₄ h₄
  rw [Bool.or_eq_true] at h ⊢
  rcases h with h | h
  · exact Or.inl h
  · exact Or.inr (w183finGood_of_at h)

private theorem w183finGood_spec {a₁ a₂ b₁ b₂ : GF8} (h : w183finGood a₁ a₂ b₁ b₂ = true) :
    ∃ w ∈ w183finWords, ∃ c : GF8, c ≠ 0 ∧ c ≠ a₁ ∧ c ≠ a₂ ∧ c ≠ a₁ + a₂ ∧
      w183finEvalW ![w183finU a₁, w183finU a₂, w183finL b₁, w183finL b₂] w = w183finU c := by
  simp only [w183finGood, List.any_eq_true, decide_eq_true_eq] at h
  obtain ⟨w, hw, i, -, hconj⟩ := h
  obtain ⟨hc0, hc1, hc2, hc3, hw'⟩ := hconj
  exact ⟨w, hw, ⟨i⟩, hc0, hc1, hc2, hc3, by rw [← w183finEvalM_eq]; exact hw'⟩

theorem w183finKey : ∀ a₁ a₂ b₁ b₂ : GF8, a₁ ≠ 0 → a₂ ≠ 0 → a₁ ≠ a₂ → b₁ ≠ 0 → b₂ ≠ 0 →
    b₁ ≠ b₂ → ∃ w ∈ w183finWords, ∃ c : GF8, c ≠ 0 ∧ c ≠ a₁ ∧ c ≠ a₂ ∧ c ≠ a₁ + a₂ ∧
      w183finEvalW ![w183finU a₁, w183finU a₂, w183finL b₁, w183finL b₂] w = w183finU c := by
  intro a₁ a₂ b₁ b₂ ha₁ ha₂ ha₁₂ hb₁ hb₂ hb₁₂
  have hgood : w183finGood a₁ a₂ b₁ b₂ = true := by
    have h := w183finKeyCheck_eq_true
    simp only [w183finKeyCheck, List.all_eq_true] at h
    have h' := h a₁.val (w183finCodes_mem _) a₂.val (w183finCodes_mem _) b₁.val
      (w183finCodes_mem _) b₂.val (w183finCodes_mem _)
    simpa [ha₁, ha₂, ha₁₂, hb₁, hb₂, hb₁₂] using h'
  exact w183finGood_spec hgood

