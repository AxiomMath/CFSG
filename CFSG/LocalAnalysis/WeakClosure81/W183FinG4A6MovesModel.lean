private def w183finG4A6_T0C : List (List Nat) := Core.p0Lit.filter Core.inS6

private def w183finG4A6_isInvC (c : List Nat) : Bool :=
  Core.cmul c c == Core.cid && c != Core.cid

private def w183finG4A6_isCentral (c : List Nat) : Bool :=
  w183finG4A6_T0C.all fun d => Core.cmul c d == Core.cmul d c

private def w183finG4A6_centC (b : List Nat) : List (List Nat) :=
  w183finG4A6_T0C.filter fun d => Core.cmul b d == Core.cmul d b

private def w183finG4A6_elemAb (l : List (List Nat)) : Bool :=
  l.all fun a => (Core.cmul a a == Core.cid) && (l.all fun b => Core.cmul a b == Core.cmul b a)

private def w183finG4A6_normalizes (B : List (List Nat)) (τ : List Nat) : Bool :=
  B.all fun e => B.any fun f => Core.cmul τ e == Core.cmul f τ

private def w183finG4A6_tMulC : List Nat := [0, 4, 8, 5, 6, 1, 7, 2, 3, 9]

private def w183finG4A6_tMulFrobC : List Nat := [0, 4, 8, 7, 2, 3, 5, 6, 1, 9]

private def w183finG4A6_outerL : List (List Nat) :=
  Core.pslLit.map (fun c => Core.cmul c w183finG4A6_tMulC) ++
    Core.pslLit.map (fun c => Core.cmul c w183finG4A6_tMulFrobC)

private def w183finG4A6_dynkinMoves : Bool :=
  w183finG4A6_outerL.all fun τ =>
    !(w183finG4A6_normalizes w183finG4A6_T0C τ) ||
      (w183finG4A6_T0C.filter w183finG4A6_isInvC).all fun b =>
        let CB := w183finG4A6_centC b
        !(w183finG4A6_elemAb CB) || !(w183finG4A6_normalizes CB τ)

private theorem w183finG4A6_mem_T0C (x : P10) :
    x ∈ T0sub ↔ code x ∈ w183finG4A6_T0C := by
