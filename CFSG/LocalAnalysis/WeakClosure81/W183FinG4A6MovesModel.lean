private theorem w183finG4A6_code_mem_outerL {τ : P10} (hτ : τ ∈ A6Models.autA6)
    (hτs6 : τ ∉ A6Facts.s6) : code τ ∈ w183finG4A6_outerL := by
  obtain ⟨r, hr, hτr⟩ := (A6Facts.mem_autA6_iff_exists τ).1 hτ
  simp only [A6Facts.autRepsP, List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl | rfl
  · exact absurd (A6Facts.psl29_le_s6 hτr) hτs6
  · refine List.mem_append_left _ (List.mem_map.2 ⟨code (τ * A6Models.tMul⁻¹),
      (A6Facts.mem_psl29_iff _).1 hτr, ?_⟩)
    rw [← w183finG4A6_code_tMul, ← A6Facts.code_mul,
      show (τ * A6Models.tMul⁻¹) * A6Models.tMul = τ by group]
  · refine absurd ((A6Facts.mem_s6_iff_exists τ).2
      ⟨A6Models.tFrob, by simp [A6Facts.s6RepsP], hτr⟩) hτs6
  · have h1 : (τ * (A6Models.tMul * A6Models.tFrob)⁻¹) * (A6Models.tMul * A6Models.tFrob) = τ := by
      group
    refine List.mem_append_right _ (List.mem_map.2 ⟨code (τ * (A6Models.tMul * A6Models.tFrob)⁻¹),
      (A6Facts.mem_psl29_iff _).1 hτr, ?_⟩)
    rw [← w183finG4A6_code_tMulFrob, ← A6Facts.code_mul, Out21.A6.tMulFrob_eq, h1]

