theorem w183finG4A6_model_T0 : ∃ T₀ : Subgroup P10, IsSylowIn 2 T₀ A6Facts.s6 ∧
    ¬ T₀ ≤ A6Models.psl29 ∧
    ∀ B : Subgroup P10, B ≤ T₀ → IsElemAbelian 2 B → 8 ≤ Nat.card B →
      ∀ τ ∈ A6Models.autA6, τ ∉ A6Facts.s6 → τ ∈ Subgroup.normalizer (T₀ : Set P10) →
        τ ∉ Subgroup.normalizer (B : Set P10) := by
  refine ⟨T0sub, w183finG4A6_isSylowIn_T0, ?_, ?_⟩
  · intro hle
    exact A6Facts.tFrob_not_mem_psl (hle w183finG4A6_tFrob_mem_T0)
  · intro B hB hab h8 τ hτ hτs6 hτT hτB
    have hBcard_dvd : Nat.card ↥B ∣ 16 := by
      have h := Subgroup.card_dvd_of_le hB
      rwa [w183finG4A6_card_T0] at h
    rcases w183finG4A6_eq_eight_or_sixteen hBcard_dvd h8 with hBcard | hBcard
    · obtain ⟨b, hbB, d, hdT, hbd⟩ := w183finG4A6_exists_not_central hB hBcard
      have hbT : b ∈ T0sub := hB hbB
      have hb_ne_one : b ≠ 1 := by
        intro h
        exact hbd (by rw [h, one_mul, mul_one])
      have hb_sq : b * b = 1 := by rw [← pow_two]; exact hab.2 b hbB
      have hb_inv : w183finG4A6_isInvC (code b) = true := by
        rw [w183finG4A6_isInvC, Bool.and_eq_true]
        refine ⟨?_, ?_⟩
        · rw [beq_iff_eq, ← A6Facts.code_mul, hb_sq, A6Facts.code_one]
        · rw [bne_iff_ne]
          exact fun h => hb_ne_one (A6Facts.code_injective (by rw [h, A6Facts.code_one]))
      have hb_mem : code b ∈ w183finG4A6_T0C.filter w183finG4A6_isInvC :=
        List.mem_filter.2 ⟨(w183finG4A6_mem_T0C b).1 hbT, hb_inv⟩
      let C : Subgroup P10 := Subgroup.centralizer ({b} : Set P10) ⊓ T0sub
      have hmemC : ∀ x : P10, x ∈ C ↔ code x ∈ w183finG4A6_centC (code b) :=
        fun x => w183finG4A6_mem_centC b x
      have hsurjC : ∀ c ∈ w183finG4A6_centC (code b), ∃ x ∈ C, code x = c := by
        intro c hc
        obtain ⟨x, -, rfl⟩ := w183finG4A6_exists_of_mem_T0C (List.mem_filter.1 hc).1
        exact ⟨x, (hmemC x).2 hc, rfl⟩
      have hBC : B ≤ C := by
        intro x hx
