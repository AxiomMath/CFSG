private theorem w183finG4A6_exists_of_mem_T0C {c : List Nat} (hc : c ∈ w183finG4A6_T0C) :
    ∃ x ∈ T0sub, code x = c := by
  obtain ⟨x, -, rfl⟩ := A6Facts.exists_P0_of_code (List.mem_filter.1 hc).1
  exact ⟨x, (w183finG4A6_mem_T0C x).2 hc, rfl⟩

