private theorem w183finG4A6_not_elemAb_T0 : ¬ IsElemAbelian 2 T0sub := by
  intro hE
  have hchk : w183finG4A6_T0C.any (fun c => Core.cmul c c != Core.cid) = true := by
    decide +kernel
  rw [List.any_eq_true] at hchk
  obtain ⟨c, hc, hcc⟩ := hchk
  obtain ⟨x, hx, rfl⟩ := w183finG4A6_exists_of_mem_T0C hc
  have hcc' : Core.cmul (code x) (code x) ≠ Core.cid := by simpa using hcc
  have hx2 : x * x ≠ 1 := by
    intro h
    apply hcc'
    rw [← A6Facts.code_mul, h, A6Facts.code_one]
  exact hx2 (by rw [← pow_two]; exact hE.2 x hx)

private theorem w183finG4A6_mem_centC (b x : P10) :
    x ∈ Subgroup.centralizer ({b} : Set P10) ⊓ T0sub ↔
      code x ∈ w183finG4A6_centC (code b) := by
  rw [Subgroup.mem_inf, Subgroup.mem_centralizer_singleton_iff, w183finG4A6_mem_T0C,
    w183finG4A6_centC, List.mem_filter]
  constructor
  · rintro ⟨hcomm, hc⟩
    refine ⟨hc, ?_⟩
    rw [beq_iff_eq, ← A6Facts.code_mul, ← A6Facts.code_mul]
    exact congrArg code hcomm.symm
  · rintro ⟨hc, hcomm⟩
    refine ⟨?_, hc⟩
    rw [beq_iff_eq, ← A6Facts.code_mul, ← A6Facts.code_mul] at hcomm
    exact (A6Facts.code_injective hcomm).symm

private def w183finG4A6_ZC : List (List Nat) :=
  w183finG4A6_T0C.filter w183finG4A6_isCentral

private theorem w183finG4A6_mem_ZC (x : P10) :
    x ∈ Subgroup.centralizer (T0sub : Set P10) ⊓ T0sub ↔
      code x ∈ w183finG4A6_ZC := by
  rw [Subgroup.mem_inf, Subgroup.mem_centralizer_iff, w183finG4A6_mem_T0C,
    w183finG4A6_ZC, List.mem_filter]
  constructor
  · rintro ⟨hcent, hc⟩
    refine ⟨hc, ?_⟩
    rw [w183finG4A6_isCentral, List.all_eq_true]
    intro d hd
    obtain ⟨y, hy, rfl⟩ := w183finG4A6_exists_of_mem_T0C hd
    rw [beq_iff_eq, ← A6Facts.code_mul, ← A6Facts.code_mul]
    exact congrArg code (hcent y hy).symm
  · rintro ⟨hc, hall⟩
    refine ⟨?_, hc⟩
    intro y hy
    have hyc : code y ∈ w183finG4A6_T0C := (w183finG4A6_mem_T0C y).1 hy
    have h1 := List.all_eq_true.1 hall (code y) hyc
    rw [beq_iff_eq, ← A6Facts.code_mul, ← A6Facts.code_mul] at h1
    exact (A6Facts.code_injective h1).symm

private theorem w183finG4A6_card_Z :
    Nat.card ↥(Subgroup.centralizer (T0sub : Set P10) ⊓ T0sub) = 4 := by
  refine (A6Facts.card_eq_of_code_mem
    (List.Nodup.filter w183finG4A6_isCentral w183finG4A6_T0C_nodup)
    (fun x => w183finG4A6_mem_ZC x) ?_).trans ?_
  · intro c hc
    obtain ⟨x, hx, rfl⟩ := w183finG4A6_exists_of_mem_T0C (List.mem_filter.1 hc).1
    exact ⟨x, (w183finG4A6_mem_ZC x).2 hc, rfl⟩
  · decide +kernel

private theorem w183finG4A6_exists_not_central {B : Subgroup P10} (hB : B ≤ T0sub)
    (hcard : Nat.card ↥B = 8) :
    ∃ b ∈ B, ∃ d ∈ T0sub, b * d ≠ d * b := by
  by_contra h
  have hBZ : B ≤ Subgroup.centralizer (T0sub : Set P10) ⊓ T0sub := by
    intro b hb
    refine ⟨Subgroup.mem_centralizer_iff.2 ?_, hB hb⟩
    intro d hd
    by_contra hne
    exact h ⟨b, hb, d, hd, fun hbd => hne hbd.symm⟩
  have hdiv := Subgroup.card_dvd_of_le hBZ
  rw [w183finG4A6_card_Z, hcard] at hdiv
  norm_num at hdiv

private theorem w183finG4A6_elemAb_of {B : Subgroup P10} {l : List (List Nat)}
    (hmem : ∀ x : P10, x ∈ B ↔ code x ∈ l)
    (hsurj : ∀ c ∈ l, ∃ x ∈ B, code x = c) (hB : IsElemAbelian 2 B) :
    w183finG4A6_elemAb l = true := by
  rw [w183finG4A6_elemAb, List.all_eq_true]
  intro a ha
  obtain ⟨x, hx, rfl⟩ := hsurj a ha
  rw [Bool.and_eq_true]
  refine ⟨?_, ?_⟩
  · rw [beq_iff_eq, ← A6Facts.code_mul, ← A6Facts.code_one]
    exact congrArg code (by rw [← pow_two]; exact hB.2 x hx)
  · rw [List.all_eq_true]
    intro b hb
    obtain ⟨y, hy, rfl⟩ := hsurj b hb
    rw [beq_iff_eq, ← A6Facts.code_mul, ← A6Facts.code_mul]
    exact congrArg code (hB.comm hx hy)

private theorem w183finG4A6_normalizes_of_mem_normalizer {B : Subgroup P10} {l : List (List Nat)}
    (hmem : ∀ x : P10, x ∈ B ↔ code x ∈ l)
    (hsurj : ∀ c ∈ l, ∃ x ∈ B, code x = c) {τ : P10}
    (hτ : τ ∈ Subgroup.normalizer (B : Set P10)) :
    w183finG4A6_normalizes l (code τ) = true := by
  rw [w183finG4A6_normalizes, List.all_eq_true]
  intro e he
  obtain ⟨x, hx, rfl⟩ := hsurj e he
  have hx' : τ * x * τ⁻¹ ∈ B := (Subgroup.mem_normalizer_iff.1 hτ x).1 hx
  rw [List.any_eq_true]
  refine ⟨code (τ * x * τ⁻¹), (hmem _).1 hx', ?_⟩
  rw [beq_iff_eq, ← A6Facts.code_mul, ← A6Facts.code_mul,
    show (τ * x * τ⁻¹) * τ = τ * x by group]

