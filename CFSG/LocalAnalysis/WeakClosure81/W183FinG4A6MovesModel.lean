    (fun x => w183finG4A6_mem_T0C x) (fun c hc => w183finG4A6_exists_of_mem_T0C hc)).trans ?_
  decide +kernel

private theorem w183finG4A6_isSylowIn_T0 : IsSylowIn 2 T0sub A6Facts.s6 := by
  refine ⟨inf_le_right, ?_, ?_⟩
  · exact (IsPGroup.of_card (p := 2) (n := 5) (by
      rw [A6Facts.card_P0]; norm_num)).to_le inf_le_left
  · have hrel : Subgroup.relIndex T0sub A6Facts.s6 = 45 := by
      have h := Subgroup.relIndex_mul_card T0sub A6Facts.s6
      rw [inf_assoc, inf_idem, w183finG4A6_card_T0, w183finG4A6_model_card_s6] at h
