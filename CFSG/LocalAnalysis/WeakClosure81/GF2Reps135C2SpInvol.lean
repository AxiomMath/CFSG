private noncomputable def spLowGL {n : ℕ} (N : Matrix (Fin n) (Fin n) K) :
    GL (Fin n ⊕ Fin n) K :=
  ⟨fromBlocks 1 0 N 1, fromBlocks 1 0 N 1,
    (by
      rw [fromBlocks_multiply]
      have hNN : N + N = 0 := by ext i j; exact CharTwo.add_self_eq_zero (N i j)
      simp only [mul_one, mul_zero, zero_mul, one_mul, zero_add, add_zero, hNN,
        fromBlocks_one]),
    (by
      rw [fromBlocks_multiply]
      have hNN : N + N = 0 := by ext i j; exact CharTwo.add_self_eq_zero (N i j)
      simp only [mul_one, mul_zero, zero_mul, one_mul, zero_add, add_zero, hNN,
        fromBlocks_one])⟩

omit [Finite K] in
private theorem coe_spLowGL {n : ℕ} (N : Matrix (Fin n) (Fin n) K) :
    (spLowGL N : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) K) = fromBlocks 1 0 N 1 := rfl

omit [Finite K] in
private theorem spLowGL_mem {n : ℕ} {N : Matrix (Fin n) (Fin n) K} (hN : Nᵀ = N) :
    spLowGL N ∈ StatedSp n K := by
  rw [CFSG.Open.StatedAPI.mem_statedSp_iff]
  simp only [coe_spLowGL, fromBlocks_transpose, transpose_one, transpose_zero, hN,
    fromBlocks_multiply]
  ext i j
  rcases i with i | i <;> rcases j with j | j <;> simp

omit [Finite K] in
private theorem spLow_conj {n : ℕ} (N : Matrix (Fin n) (Fin n) K) :
    fromBlocks 1 0 N 1 * fromBlocks 1 N 0 1 * fromBlocks 1 0 N 1 =
      fromBlocks (1 + N ^ 2) N (N ^ 3) (1 + N ^ 2) := by
  have h2 : N + N = 0 := by ext i j; exact CharTwo.add_self_eq_zero (N i j)
  have h1 : fromBlocks 1 0 N 1 * fromBlocks 1 N 0 1 = fromBlocks 1 N N (N ^ 2 + 1) := by
    rw [fromBlocks_multiply, fromBlocks_inj]
    refine ⟨?_, ?_, ?_, ?_⟩ <;> simp [pow_two]
  rw [h1, fromBlocks_multiply, fromBlocks_inj]
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp [pow_two]
  · simp
  · rw [mul_one, add_mul, one_mul, ← pow_succ N 2, ← add_assoc, add_comm N (N ^ 3), add_assoc,
      h2, add_zero]
  · rw [mul_zero, zero_add, mul_one, add_comm]

omit [Finite K] [CharP K 2] in
private theorem mat_inv {n : ℕ} (x : StatedSp n K) : mat n K x⁻¹ = (mat n K x)⁻¹ :=
  Matrix.GeneralLinearGroup.coe_inv (x : GL (Fin n ⊕ Fin n) K)

omit [Finite K] [CharP K 2] in
private theorem inv_mat_leviEmbedGL {n : ℕ} (P : GL (Fin n) K) :
    (mat n K (CFSG.ClassicalInvolution.Models.SymplecticPairs.leviEmbedGL K n P))⁻¹ =
      Matrix.fromBlocks ((P⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) 0 0
        ((P : Matrix (Fin n) (Fin n) K)ᵀ) := by
  rw [← mat_inv (CFSG.ClassicalInvolution.Models.SymplecticPairs.leviEmbedGL K n P),
    ← map_inv (CFSG.ClassicalInvolution.Models.SymplecticPairs.leviEmbedGL K n) P,
    CFSG.ClassicalInvolution.Models.SymplecticPairs.mat_leviEmbedGL]
  simp

omit [Finite K] [CharP K 2] in
private theorem levi_conj_siegel {n : ℕ} (P : GL (Fin n) K) (S : Matrix (Fin n) (Fin n) K) :
    Matrix.fromBlocks (P : Matrix (Fin n) (Fin n) K) 0 0
        (((P⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K)ᵀ) *
      Matrix.fromBlocks 1 S 0 1 *
      Matrix.fromBlocks ((P⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) 0 0
        ((P : Matrix (Fin n) (Fin n) K)ᵀ) =
    Matrix.fromBlocks 1 ((P : Matrix (Fin n) (Fin n) K) * S *
      (P : Matrix (Fin n) (Fin n) K)ᵀ) 0 1 := by
  have h1 : Matrix.fromBlocks (P : Matrix (Fin n) (Fin n) K) 0 0
        (((P⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K)ᵀ) *
      Matrix.fromBlocks 1 S 0 1 =
      Matrix.fromBlocks (P : Matrix (Fin n) (Fin n) K)
        ((P : Matrix (Fin n) (Fin n) K) * S) 0
        (((P⁻¹ : GL (Fin n) K) : Matrix (Fin n) (Fin n) K)ᵀ) := by
    rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_inj]
    refine ⟨?_, ?_, ?_, ?_⟩ <;> simp
  rw [h1, Matrix.fromBlocks_multiply, Matrix.fromBlocks_inj]
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [mul_zero, add_zero, ← Units.val_mul, mul_inv_cancel, Units.val_one]
  · rw [mul_zero, zero_add]
  · rw [zero_mul, mul_zero, add_zero]
  · rw [zero_mul, zero_add, ← Matrix.transpose_mul, ← Units.val_mul, mul_inv_cancel,
      Units.val_one, Matrix.transpose_one]

omit [Finite K] [CharP K 2] in
private theorem spDiagIdem_sq {n r : ℕ} :
    (spDiagIdem K n r) ^ 2 = spDiagIdem K n r := by
  rw [pow_two, spDiagIdem, Matrix.diagonal_mul_diagonal]
  ext a b
  simp only [Matrix.diagonal_apply]
  by_cases hab : a = b
  · subst hab
    by_cases h : a.val < r <;> simp [h]
  · simp [hab]

omit [Finite K] in
private theorem spDiagIdem_permMatrix {n r : ℕ} :
    fromBlocks (1 + (spDiagIdem K n r) ^ 2) (spDiagIdem K n r) (spDiagIdem K n r)
        (1 + (spDiagIdem K n r) ^ 2) =
      Equiv.Perm.permMatrix K (spMonoPerm (1 : Equiv.Perm (Fin n))
        (fun a => if a.val < r then (-1 : ℤ) else 1)).symm := by
  ext x y
  rcases x with a | a <;> rcases y with b | b <;>
    simp only [fromBlocks_apply₁₁, fromBlocks_apply₂₂, fromBlocks_apply₁₂, fromBlocks_apply₂₁,
      Equiv.Perm.permMatrix, PEquiv.toMatrix_toPEquiv_apply, Pi.single_apply,
      Equiv.eq_symm_apply, spMonoPerm_inl, spMonoPerm_inr, spDiagIdem, Matrix.diagonal_apply,
      Matrix.add_apply, Matrix.one_apply, pow_two, Matrix.diagonal_mul_diagonal]
  all_goals split_ifs <;> simp_all [CharTwo.add_self_eq_zero]

private theorem xor_one_lt_of_lt_two_mul {a j : ℕ} (h : a < 2 * j) : a ^^^ 1 < 2 * j := by
  rcases Nat.even_or_odd a with ⟨k, rfl⟩ | ⟨k, rfl⟩
  · rw [Nat.xor_one_of_even (show Even (k + k) from ⟨k, rfl⟩)]; omega
  · rw [Nat.xor_one_of_odd (show Odd (2 * k + 1) from ⟨k, rfl⟩)]; omega

private theorem div_two_eq_and_ne_iff_xor_one {a b : ℕ} :
    a / 2 = b / 2 ∧ a ≠ b ↔ b = a ^^^ 1 := by
  have hbmod : b % 2 < 2 := Nat.mod_lt b (by norm_num)
  constructor
  · rintro ⟨hdiv, hne⟩
    rcases Nat.even_or_odd a with ⟨k, rfl⟩ | ⟨k, rfl⟩
    · rw [Nat.xor_one_of_even (show Even (k + k) from ⟨k, rfl⟩)]
      have hk : (k + k) / 2 = k := by omega
      rw [hk] at hdiv
      have hb : b = k + k + b % 2 := by omega
      have hb2 : b % 2 = 0 ∨ b % 2 = 1 := by omega
      rcases hb2 with hb0 | hb1
      · rw [hb0] at hb; omega
      · rw [hb1] at hb; omega
    · rw [Nat.xor_one_of_odd (show Odd (2 * k + 1) from ⟨k, rfl⟩)]
      have hk : (2 * k + 1) / 2 = k := by omega
      rw [hk] at hdiv
      have hb : b = k + k + b % 2 := by omega
      have hb2 : b % 2 = 0 ∨ b % 2 = 1 := by omega
      rcases hb2 with hb0 | hb1
      · rw [hb0] at hb; omega
      · rw [hb1] at hb; omega
  · intro h
    rcases Nat.even_or_odd a with ⟨k, rfl⟩ | ⟨k, rfl⟩
    · rw [Nat.xor_one_of_even (show Even (k + k) from ⟨k, rfl⟩)] at h
      have h1 : (k + k) / 2 = k := by omega
      have h2 : b / 2 = k := by omega
      exact ⟨by rw [h1, h2], by omega⟩
    · rw [Nat.xor_one_of_odd (show Odd (2 * k + 1) from ⟨k, rfl⟩)] at h
      have h1 : (2 * k + 1) / 2 = k := by omega
      have h2 : b / 2 = k := by omega
      exact ⟨by rw [h1, h2], by omega⟩

private def spHypMap (n j : ℕ) (h : 2 * j ≤ n) (a : Fin n) : Fin n :=
  if ha : a.val < 2 * j then
    ⟨a.val ^^^ 1, lt_of_lt_of_le (xor_one_lt_of_lt_two_mul ha) h⟩
  else a

private theorem spHypMap_involutive (n j : ℕ) (h : 2 * j ≤ n) :
    Function.Involutive (spHypMap n j h) := by
  intro a
  by_cases ha : a.val < 2 * j
  · have h1 : a.val ^^^ 1 < 2 * j := xor_one_lt_of_lt_two_mul ha
    simp only [spHypMap, dif_pos ha, dif_pos h1]
    apply Fin.ext
    simp only [Nat.xor_assoc, Nat.xor_self, Nat.xor_zero]
  · simp only [spHypMap, dif_neg ha]

private def spHypPerm (n j : ℕ) (h : 2 * j ≤ n) : Equiv.Perm (Fin n) :=
  Function.Involutive.toPerm (spHypMap n j h) (spHypMap_involutive n j h)

private theorem spHypPerm_apply_of_lt {n j : ℕ} (h : 2 * j ≤ n) {a : Fin n}
    (ha : a.val < 2 * j) :
    spHypPerm n j h a = ⟨a.val ^^^ 1, lt_of_lt_of_le (xor_one_lt_of_lt_two_mul ha) h⟩ := by
  show spHypMap n j h a = _
  rw [spHypMap, dif_pos ha]

private theorem spHypPerm_apply_of_not_lt {n j : ℕ} (h : 2 * j ≤ n) {a : Fin n}
    (ha : ¬ a.val < 2 * j) : spHypPerm n j h a = a := by
  show spHypMap n j h a = a
  rw [spHypMap, dif_neg ha]

private theorem spHypPerm_apply_apply {n j : ℕ} (h : 2 * j ≤ n) (a : Fin n) :
    spHypPerm n j h (spHypPerm n j h a) = a :=
  spHypMap_involutive n j h a

private theorem spHypPerm_val_lt {n j : ℕ} (h : 2 * j ≤ n) (a : Fin n) :
    (spHypPerm n j h a).val < 2 * j ↔ a.val < 2 * j := by
  by_cases ha : a.val < 2 * j
  · rw [spHypPerm_apply_of_lt h ha]
    exact ⟨fun _ => ha, fun _ => xor_one_lt_of_lt_two_mul ha⟩
  · rw [spHypPerm_apply_of_not_lt h ha]

private theorem spHypPerm_eq_iff {n j : ℕ} (h : 2 * j ≤ n) (a b : Fin n) :
    spHypPerm n j h b = a ↔ b = spHypPerm n j h a := by
  constructor
  · intro hba; rw [← hba, spHypPerm_apply_apply]
  · intro hb; rw [hb, spHypPerm_apply_apply]

private theorem spHypPerm_zero {n j : ℕ} (h : 2 * j ≤ n) (hj : 1 ≤ j) :
    spHypPerm n j h ⟨0, by omega⟩ = ⟨1, by omega⟩ := by
  have h0 : (⟨0, by omega⟩ : Fin n).val < 2 * j := by
    show (0 : ℕ) < 2 * j
    omega
  rw [spHypPerm_apply_of_lt h h0]
  congr 1
  simp

private theorem spHypPerm_one {n j : ℕ} (h : 2 * j ≤ n) (hj : 1 ≤ j) :
    spHypPerm n j h ⟨1, by omega⟩ = ⟨0, by omega⟩ := by
  have h1 : (⟨1, by omega⟩ : Fin n).val < 2 * j := by
    show (1 : ℕ) < 2 * j
    omega
  rw [spHypPerm_apply_of_lt h h1]
  congr 1
  simp

private theorem spHypIdem_cond {n j : ℕ} (h : 2 * j ≤ n) (a b : Fin n) :
    (a.val < 2 * j ∧ b.val < 2 * j ∧ a.val / 2 = b.val / 2 ∧ a ≠ b) ↔
      (b = spHypPerm n j h a ∧ a.val < 2 * j) := by
  constructor
  · rintro ⟨ha, -, hdiv, hne⟩
    have hxor : b.val = a.val ^^^ 1 :=
      div_two_eq_and_ne_iff_xor_one.mp ⟨hdiv, fun hval => hne (Fin.ext hval)⟩
    exact ⟨by rw [spHypPerm_apply_of_lt h ha]; exact Fin.ext hxor, ha⟩
  · rintro ⟨hb, ha⟩
    have hxor : b.val = a.val ^^^ 1 := by rw [hb, spHypPerm_apply_of_lt h ha]
    have h2 := div_two_eq_and_ne_iff_xor_one.mpr hxor
    exact ⟨ha, (by have h1 := xor_one_lt_of_lt_two_mul ha; omega), h2.1,
      fun hab => h2.2 (congrArg Fin.val hab)⟩

omit [Finite K] [CharP K 2] in
private theorem spHypIdem_apply {n j : ℕ} (h : 2 * j ≤ n) (a b : Fin n) :
    spHypIdem K n j a b =
      if b = spHypPerm n j h a then (if a.val < 2 * j then 1 else 0) else 0 := by
  simp only [spHypIdem, Matrix.of_apply]
  by_cases hb : b = spHypPerm n j h a
  · by_cases ha : a.val < 2 * j
    · rw [if_pos hb, if_pos ha, if_pos ((spHypIdem_cond h a b).mpr ⟨hb, ha⟩)]
    · rw [if_pos hb, if_neg ha,
        if_neg (fun hc => ha ((spHypIdem_cond h a b).mp hc).2)]
  · rw [if_neg hb, if_neg (fun hc => hb ((spHypIdem_cond h a b).mp hc).1)]

omit [Finite K] [CharP K 2] in
private theorem spHypIdem_sq {n j : ℕ} (h : 2 * j ≤ n) :
    (spHypIdem K n j) ^ 2 = Matrix.diagonal (fun a => if a.val < 2 * j then 1 else 0) := by
  ext a b
  rw [pow_two, Matrix.mul_apply, Matrix.diagonal_apply]
  have hπ : spHypPerm n j h (spHypPerm n j h a) = a := spHypPerm_apply_apply h a
  rw [Finset.sum_eq_single (spHypPerm n j h a)]
  · rw [spHypIdem_apply h a (spHypPerm n j h a), if_pos rfl]
    by_cases ha : a.val < 2 * j
    · rw [if_pos ha]
      have hpa : (spHypPerm n j h a).val < 2 * j := by
        rw [spHypPerm_apply_of_lt h ha]; exact xor_one_lt_of_lt_two_mul ha
      rw [spHypIdem_apply h (spHypPerm n j h a) b, hπ, if_pos hpa]
      by_cases hb : b = a
      · rw [if_pos hb, hb, if_pos rfl, one_mul]
      · rw [if_neg hb, if_neg (fun hab : a = b => hb hab.symm), mul_zero]
    · rw [if_neg ha]
      rw [spHypIdem_apply h (spHypPerm n j h a) b, hπ]
      by_cases hb : b = a
      · rw [if_pos hb, hb, if_pos rfl, zero_mul]
      · rw [if_neg hb, if_neg (fun hab : a = b => hb hab.symm), mul_zero]
  · intro c _ hc
    rw [spHypIdem_apply h a c, if_neg hc, zero_mul]
  · intro hmem
    exact absurd (Finset.mem_univ _) hmem

omit [Finite K] in
private theorem one_add_spHypIdem_sq {n j : ℕ} (h : 2 * j ≤ n) :
    1 + (spHypIdem K n j) ^ 2 =
      Matrix.diagonal (fun a => if a.val < 2 * j then 0 else 1) := by
  rw [spHypIdem_sq h]
  ext a b
  simp only [Matrix.add_apply, Matrix.one_apply, Matrix.diagonal_apply]
  by_cases hab : a = b
  · subst hab
    by_cases ha : a.val < 2 * j <;> simp [ha, CharTwo.add_self_eq_zero]
  · simp [hab]

omit [Finite K] [CharP K 2] in
private theorem spHypIdem_permMatrix_inl_inl {n j : ℕ} (h : 2 * j ≤ n) (a b : Fin n) :
    (Matrix.fromBlocks (Matrix.diagonal fun x => if x.val < 2 * j then 0 else 1)
      (spHypIdem K n j) (spHypIdem K n j)
      (Matrix.diagonal fun x => if x.val < 2 * j then 0 else 1)) (Sum.inl a) (Sum.inl b) =
    (Equiv.Perm.permMatrix K (spMonoPerm (spHypPerm n j h)
      (fun x => if x.val < 2 * j then (-1 : ℤ) else 1)).symm) (Sum.inl a) (Sum.inl b) := by
  simp only [fromBlocks_apply₁₁, Matrix.diagonal_apply, Equiv.Perm.permMatrix,
    PEquiv.toMatrix_toPEquiv_apply, Pi.single_apply, Equiv.eq_symm_apply, spMonoPerm_inl]
  by_cases hb : b.val < 2 * j
  · have hs : ¬ (if b.val < 2 * j then (-1 : ℤ) else 1) = 1 := by simp [hb]
    rw [if_neg hs]
    by_cases hab : a = b
    · subst hab; simp [hb]
    · simp [hab]
  · have hs : (if b.val < 2 * j then (-1 : ℤ) else 1) = 1 := by simp [hb]
    rw [if_pos hs, spHypPerm_apply_of_not_lt h hb]
    by_cases hab : a = b
    · subst hab; simp [hb]
    · simp [hab, Ne.symm hab]

omit [Finite K] [CharP K 2] in
private theorem spHypIdem_permMatrix_inl_inr {n j : ℕ} (h : 2 * j ≤ n) (a b : Fin n) :
    (Matrix.fromBlocks (Matrix.diagonal fun x => if x.val < 2 * j then 0 else 1)
      (spHypIdem K n j) (spHypIdem K n j)
      (Matrix.diagonal fun x => if x.val < 2 * j then 0 else 1)) (Sum.inl a) (Sum.inr b) =
    (Equiv.Perm.permMatrix K (spMonoPerm (spHypPerm n j h)
      (fun x => if x.val < 2 * j then (-1 : ℤ) else 1)).symm) (Sum.inl a) (Sum.inr b) := by
  simp only [fromBlocks_apply₁₂, spHypIdem_apply h, Equiv.Perm.permMatrix,
    PEquiv.toMatrix_toPEquiv_apply, Pi.single_apply, Equiv.eq_symm_apply, spMonoPerm_inr]
  by_cases hb : b.val < 2 * j
  · have hs : ¬ (if b.val < 2 * j then (-1 : ℤ) else 1) = 1 := by simp [hb]
    rw [if_neg hs]
    simp only [Sum.inl.injEq]
    simp only [spHypPerm_eq_iff h a b]
    by_cases hba : b = spHypPerm n j h a
    · have ha : a.val < 2 * j := (spHypPerm_val_lt h a).mp (by rw [← hba]; exact hb)
      simp [hba, ha]
    · rw [if_neg hba, if_neg hba]
  · have hs : (if b.val < 2 * j then (-1 : ℤ) else 1) = 1 := by simp [hb]
    rw [if_pos hs, spHypPerm_apply_of_not_lt h hb]
    by_cases hba : b = spHypPerm n j h a
    · have ha : ¬ a.val < 2 * j :=
        fun ha => hb (by rw [hba]; exact (spHypPerm_val_lt h a).mpr ha)
      rw [if_pos hba, if_neg ha]
      simp
    · rw [if_neg hba]
      simp

