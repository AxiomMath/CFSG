omit [Finite K] in
private theorem spHypIdem_permMatrix {n j : ℕ} (h : 2 * j ≤ n) :
    fromBlocks (1 + (spHypIdem K n j) ^ 2) (spHypIdem K n j) (spHypIdem K n j)
        (1 + (spHypIdem K n j) ^ 2) =
      Equiv.Perm.permMatrix K (spMonoPerm (spHypPerm n j h)
        (fun a => if a.val < 2 * j then (-1 : ℤ) else 1)).symm := by
  rw [one_add_spHypIdem_sq h]
  ext x y
  rcases x with a | a <;> rcases y with b | b
  · exact spHypIdem_permMatrix_inl_inl h a b
  · exact spHypIdem_permMatrix_inl_inr h a b
  · exact spHypIdem_permMatrix_inr_inl h a b
  · exact spHypIdem_permMatrix_inr_inr h a b
omit [Finite K] [CharP K 2] in
private theorem pow_three_eq_self_of_sq {n : ℕ} {N : Matrix (Fin n) (Fin n) K} (h : N ^ 2 = N) :
    N ^ 3 = N := by
  rw [show (3 : ℕ) = 2 + 1 from rfl, pow_succ, h, ← pow_two, h]

omit [Finite K] [CharP K 2] in
private theorem spHypIdem_cube {n j : ℕ} (h : 2 * j ≤ n) :
    (spHypIdem K n j) ^ 3 = spHypIdem K n j := by
  rw [show (3 : ℕ) = 2 + 1 from rfl, pow_succ, spHypIdem_sq h]
  ext a b
  rw [Matrix.diagonal_mul, spHypIdem_apply h a b]
  by_cases ha : a.val < 2 * j <;> simp [ha]

omit [Finite K] in
private theorem spLow_conj_final {n : ℕ} {N : Matrix (Fin n) (Fin n) K} (hN3 : N ^ 3 = N) :
    Matrix.fromBlocks 1 0 N 1 * Matrix.fromBlocks 1 N 0 1 * Matrix.fromBlocks 1 0 N 1 =
      Matrix.fromBlocks (1 + N ^ 2) N N (1 + N ^ 2) := by
  rw [spLow_conj N, hN3]

omit [Finite K] in
private theorem spLow_conj_mat {n : ℕ} {N : Matrix (Fin n) (Fin n) K} {ℓ w : StatedSp n K}
    (hN3 : N ^ 3 = N) (hℓ : mat n K ℓ = Matrix.fromBlocks 1 0 N 1) (hℓinv : ℓ⁻¹ = ℓ)
    (hw : mat n K w = Matrix.fromBlocks 1 N 0 1) :
    mat n K (ℓ * w * ℓ⁻¹) = Matrix.fromBlocks (1 + N ^ 2) N N (1 + N ^ 2) := by
  rw [map_mul, map_mul, hℓinv, hℓ, hw, spLow_conj_final hN3]

omit [Finite K] in
private theorem exists_conj_of_normalForm {n : ℕ} {N : Matrix (Fin n) (Fin n) K}
    (hNsym : Nᵀ = N) (hN3 : N ^ 3 = N) {y : StatedSp n K} (g₁ m w : StatedSp n K)
    (hwdef : w = m * (g₁⁻¹ * y * g₁) * m⁻¹)
    (hw : mat n K w = Matrix.fromBlocks 1 N 0 1) :
    ∃ g : StatedSp n K, g * y * g⁻¹ = ⟨spLowGL N, spLowGL_mem hNsym⟩ * w *
        ⟨spLowGL N, spLowGL_mem hNsym⟩⁻¹ ∧
      mat n K (g * y * g⁻¹) = Matrix.fromBlocks (1 + N ^ 2) N N (1 + N ^ 2) := by
  set ℓ : StatedSp n K := ⟨spLowGL N, spLowGL_mem hNsym⟩ with hℓdef
  have hℓsq : ℓ * ℓ = 1 := by
    apply Subtype.ext
    exact Units.ext (spLowGL N).val_inv
  have hℓinv : ℓ⁻¹ = ℓ := inv_eq_of_mul_eq_one_right hℓsq
  have hℓ : mat n K ℓ = Matrix.fromBlocks 1 0 N 1 := by rw [mat_apply]; exact coe_spLowGL N
  have hg : (ℓ * m * g₁⁻¹) * y * (ℓ * m * g₁⁻¹)⁻¹ = ℓ * w * ℓ⁻¹ := by
    rw [hwdef]; group
  exact ⟨ℓ * m * g₁⁻¹, hg, by rw [hg, spLow_conj_mat hN3 hℓ hℓinv hw]⟩

private theorem exists_siegel_normalForm {n : ℕ} {y : StatedSp n K} (hy : y * y = 1)
    (hy1 : y ≠ 1) :
    ∃ (g₁ : StatedSp n K) (S : Matrix (Fin n) (Fin n) K) (P : GL (Fin n) K),
      Sᵀ = S ∧
      ((∃ r, 1 ≤ r ∧ r ≤ n ∧ (P : Matrix (Fin n) (Fin n) K) * S *
          (P : Matrix (Fin n) (Fin n) K)ᵀ = spDiagIdem K n r) ∨
        (∃ j, 1 ≤ j ∧ 2 * j ≤ n ∧ (P : Matrix (Fin n) (Fin n) K) * S *
          (P : Matrix (Fin n) (Fin n) K)ᵀ = spHypIdem K n j)) ∧
      mat n K (g₁⁻¹ * y * g₁) = Matrix.fromBlocks 1 S 0 1 := by
  obtain ⟨g₁, hg₁⟩ := CFSG.SeitzReduction.SymplecticPilot.exists_inv_mul_mul_mem_siegelRadicalSp
    (r := n) (F := K) hy
  obtain ⟨S, hSsym, hSmat⟩ := CFSG.RankThree.Classical.mem_siegelRadicalSp.mp hg₁
  have hSmat' : mat n K (g₁⁻¹ * y * g₁) = Matrix.fromBlocks 1 S 0 1 := by
    rw [mat_apply]; exact hSmat
  have hy1' : g₁⁻¹ * y * g₁ ≠ 1 := by
    intro h
    apply hy1
    calc y = g₁ * (g₁⁻¹ * y * g₁) * g₁⁻¹ := by group
      _ = 1 := by rw [h, mul_one, mul_inv_cancel]
  have hS0 : S ≠ 0 := by
    intro hS
    apply hy1'
    apply mat_injective
    rw [hSmat', hS, Matrix.fromBlocks_one, map_one]
  obtain ⟨P, hP⟩ := exists_mul_mul_transpose_eq_spDiagIdem_or_spHypIdem hSsym hS0
  exact ⟨g₁, S, P, hSsym, hP, hSmat'⟩

omit [Finite K] in
private theorem exists_conj_diag {n : ℕ} (hn : 2 ≤ n) {y g₁ : StatedSp n K}
    {S : Matrix (Fin n) (Fin n) K} {P : GL (Fin n) K} {r : ℕ} (hr1 : 1 ≤ r)
    (hSmat : mat n K (g₁⁻¹ * y * g₁) = Matrix.fromBlocks 1 S 0 1)
    (hPS : (P : Matrix (Fin n) (Fin n) K) * S * (P : Matrix (Fin n) (Fin n) K)ᵀ =
      spDiagIdem K n r) :
    ∃ (g : StatedSp n K) (π : Equiv.Perm (Fin n)) (s : Fin n → ℤ), SpIsSign s ∧
      ((π ⟨0, by omega⟩ = ⟨0, by omega⟩ ∧ s ⟨0, by omega⟩ = -1) ∨
        (π ⟨0, by omega⟩ = ⟨1, by omega⟩ ∧ π ⟨1, by omega⟩ = ⟨0, by omega⟩ ∧
          s ⟨0, by omega⟩ = -1 ∧ s ⟨1, by omega⟩ = -1)) ∧
      mat n K (g * y * g⁻¹) = Equiv.Perm.permMatrix K (spMonoPerm π s).symm := by
  set y' : StatedSp n K := g₁⁻¹ * y * g₁ with hy'def
  set m : StatedSp n K :=
    CFSG.ClassicalInvolution.Models.SymplecticPairs.leviEmbedGL K n P with hmdef
  have hlevi : mat n K (m * y' * m⁻¹) = Matrix.fromBlocks 1
      ((P : Matrix (Fin n) (Fin n) K) * S * (P : Matrix (Fin n) (Fin n) K)ᵀ) 0 1 := by
    rw [map_mul, map_mul, mat_inv, hmdef, inv_mat_leviEmbedGL,
      CFSG.ClassicalInvolution.Models.SymplecticPairs.mat_leviEmbedGL, hy'def, hSmat]
    exact levi_conj_siegel P S
  set N : Matrix (Fin n) (Fin n) K := spDiagIdem K n r with hNdef
  have hNsym : Nᵀ = N := by rw [hNdef, spDiagIdem, Matrix.diagonal_transpose]
  have hN3 : N ^ 3 = N := by rw [hNdef]; exact pow_three_eq_self_of_sq spDiagIdem_sq
  have hw : mat n K (m * y' * m⁻¹) = Matrix.fromBlocks 1 N 0 1 := by rw [hlevi, hPS]
  obtain ⟨g, -, hmat⟩ := exists_conj_of_normalForm hNsym hN3 g₁ m (m * y' * m⁻¹)
    (by rw [hy'def]) hw
  refine ⟨g, 1, fun a => if a.val < r then (-1 : ℤ) else 1, ?_, ?_, ?_⟩
  · intro a; by_cases ha : a.val < r <;> simp [ha]
  · left
    refine ⟨rfl, ?_⟩
    have h0 : (⟨0, by omega⟩ : Fin n).val < r := by show (0 : ℕ) < r; omega
    simp [h0]
  · rw [hmat, hNdef, spDiagIdem_permMatrix]

omit [Finite K] in
private theorem exists_conj_hyp {n : ℕ} (hn : 2 ≤ n) {y g₁ : StatedSp n K}
    {S : Matrix (Fin n) (Fin n) K} {P : GL (Fin n) K} {j : ℕ} (hj1 : 1 ≤ j) (hjn : 2 * j ≤ n)
    (hSmat : mat n K (g₁⁻¹ * y * g₁) = Matrix.fromBlocks 1 S 0 1)
    (hPS : (P : Matrix (Fin n) (Fin n) K) * S * (P : Matrix (Fin n) (Fin n) K)ᵀ =
      spHypIdem K n j) :
    ∃ (g : StatedSp n K) (π : Equiv.Perm (Fin n)) (s : Fin n → ℤ), SpIsSign s ∧
      ((π ⟨0, by omega⟩ = ⟨0, by omega⟩ ∧ s ⟨0, by omega⟩ = -1) ∨
        (π ⟨0, by omega⟩ = ⟨1, by omega⟩ ∧ π ⟨1, by omega⟩ = ⟨0, by omega⟩ ∧
          s ⟨0, by omega⟩ = -1 ∧ s ⟨1, by omega⟩ = -1)) ∧
      mat n K (g * y * g⁻¹) = Equiv.Perm.permMatrix K (spMonoPerm π s).symm := by
  set y' : StatedSp n K := g₁⁻¹ * y * g₁ with hy'def
  set m : StatedSp n K :=
    CFSG.ClassicalInvolution.Models.SymplecticPairs.leviEmbedGL K n P with hmdef
  have hlevi : mat n K (m * y' * m⁻¹) = Matrix.fromBlocks 1
      ((P : Matrix (Fin n) (Fin n) K) * S * (P : Matrix (Fin n) (Fin n) K)ᵀ) 0 1 := by
    rw [map_mul, map_mul, mat_inv, hmdef, inv_mat_leviEmbedGL,
      CFSG.ClassicalInvolution.Models.SymplecticPairs.mat_leviEmbedGL, hy'def, hSmat]
    exact levi_conj_siegel P S
  set N : Matrix (Fin n) (Fin n) K := spHypIdem K n j with hNdef
  have hNsym : Nᵀ = N := by
    rw [hNdef, spHypIdem]
    ext a b
    simp only [Matrix.transpose_apply, Matrix.of_apply]
    by_cases h : a.val < 2 * j ∧ b.val < 2 * j ∧ a.val / 2 = b.val / 2 ∧ a ≠ b
    · rw [if_pos h, if_pos ⟨h.2.1, h.1, h.2.2.1.symm, fun hba => h.2.2.2 hba.symm⟩]
    · rw [if_neg h, if_neg fun h' =>
        h ⟨h'.2.1, h'.1, h'.2.2.1.symm, fun hab => h'.2.2.2 hab.symm⟩]
  have hN3 : N ^ 3 = N := by rw [hNdef]; exact spHypIdem_cube hjn
  have hw : mat n K (m * y' * m⁻¹) = Matrix.fromBlocks 1 N 0 1 := by rw [hlevi, hPS]
  obtain ⟨g, -, hmat⟩ := exists_conj_of_normalForm hNsym hN3 g₁ m (m * y' * m⁻¹)
    (by rw [hy'def]) hw
  refine ⟨g, spHypPerm n j hjn, fun a => if a.val < 2 * j then (-1 : ℤ) else 1, ?_, ?_, ?_⟩
  · intro a; by_cases ha : a.val < 2 * j <;> simp [ha]
  · right
    refine ⟨spHypPerm_zero hjn hj1, spHypPerm_one hjn hj1, ?_, ?_⟩
    · have h0 : (⟨0, by omega⟩ : Fin n).val < 2 * j := by show (0 : ℕ) < 2 * j; omega
      simp [h0]
    · have h1 : (⟨1, by omega⟩ : Fin n).val < 2 * j := by show (1 : ℕ) < 2 * j; omega
      simp [h1]
  · rw [hmat, hNdef, spHypIdem_permMatrix hjn]

theorem exists_conj_mat_eq_spMonoPerm {n : ℕ} (hn : 2 ≤ n) {y : StatedSp n K} (hy : y * y = 1)
    (hy1 : y ≠ 1) :
    ∃ (g : StatedSp n K) (π : Equiv.Perm (Fin n)) (s : Fin n → ℤ), SpIsSign s ∧
      ((π ⟨0, by omega⟩ = ⟨0, by omega⟩ ∧ s ⟨0, by omega⟩ = -1) ∨
        (π ⟨0, by omega⟩ = ⟨1, by omega⟩ ∧ π ⟨1, by omega⟩ = ⟨0, by omega⟩ ∧
          s ⟨0, by omega⟩ = -1 ∧ s ⟨1, by omega⟩ = -1)) ∧
      mat n K (g * y * g⁻¹) = Equiv.Perm.permMatrix K (spMonoPerm π s).symm := by
  obtain ⟨g₁, S, P, -, hP, hSmat'⟩ := exists_siegel_normalForm hy hy1
  rcases hP with ⟨r, hr1, -, hPS⟩ | ⟨j, hj1, hjn, hPS⟩
  · exact exists_conj_diag hn hr1 hSmat' hPS
  · exact exists_conj_hyp hn hj1 hjn hSmat' hPS

theorem rho_ne_one_of_conj {W : Type} [CommGroup W] {V : Type} [AddCommGroup V]
    [Module (ZMod 2) V] {G : Type*} [Group G] {L : Subgroup (MulAut W)}
    {ρ : Representation (ZMod 2) G V}
    {θ : W ≃* Multiplicative V} (e : G ≃* ↥L)
    (hθ : ∀ (s : G) (w : W),
      θ ((e s : MulAut W) w) = Multiplicative.ofAdd (ρ s (Multiplicative.toAdd (θ w))))
    {g : MulAut W} {y : G}
    (hge : ((e y : ↥L) : MulAut W) = g) (hg2 : orderOf g = 2) : ρ y ≠ 1 := by
  intro h1
  have h1' : ∀ v, ρ y v = v := by intro v; rw [h1]; rfl
  have hfix : ∀ w, g w = w := by
    intro w
    have h2 := hθ y w
    rw [h1' (Multiplicative.toAdd (θ w)), ofAdd_toAdd, hge] at h2
    exact θ.injective h2
  have hg1 : g = 1 := by ext w; exact hfix w
  rw [hg1, orderOf_one] at hg2
  omega

