theorem exists_rElement_commute_four {τ : Tag}
    (hτ : τ = .F4 ∨ τ = .E6 ∨ τ = .E8) {K : Type} [Field K] [Finite K] (hK : ringChar K ≠ 2)
    {A : Subgroup ↥(adjointGroup τ K)} (hA : ∀ x ∈ A, x ^ 2 = 1) (hcard : Nat.card A = 2 ^ 2) :
    ∃ u : ↥(adjointGroup τ K), u ≠ 1 ∧ (∃ n : ℕ, u ^ (ringChar K ^ n) = 1) ∧
      ∀ x ∈ A, Commute u x := by
  have : Fintype K := Fintype.ofFinite K
  have hK2 : ¬ 2 ∣ Nat.card K := by
    intro h
    obtain ⟨m, hr, hcK⟩ := FiniteField.card K (ringChar K)
    rw [Nat.card_eq_fintype_card, hcK] at h
    exact hK ((Nat.prime_dvd_prime_iff_eq Nat.prime_two hr).1
      (Nat.prime_two.dvd_of_dvd_pow h)).symm
  obtain ⟨w, Fr, hFr, g0, hg0C, hg0, c, hc⟩ :=
    CFSG.HardMathSupport.Timmesfeld.CrossChar.langToralPlane_two
      (by rcases hτ with h | h | h <;> simp [h]) K hK2 A hA hcard
  let D : CFSG.LieType.SeitzGeneration.ExcHighThree.LangPlaneData τ K A :=
    ⟨w, Fr, hFr, g0, hg0C, hg0, c, hc⟩
  obtain ⟨α, hα, hk⟩ :=
    langPlaneData_kills_two (by rcases hτ with h | h | h <;> simp [h]) hA hcard D
  have hNR : CFSG.LieType.SeitzGeneration.ExcHighThree.LangPlaneKillsRoot τ := by
    rcases hτ with rfl | rfl | rfl
    · exact CFSG.LieType.SeitzGeneration.ExcHighThree.langPlaneKillsRoot_F4
    · exact CFSG.LieType.SeitzGeneration.ExcHighThree.langPlaneKillsRoot_E6
    · exact CFSG.LieType.SeitzGeneration.ExcHighThree.langPlaneKillsRoot_E8
  exact hNR K A D α hα hk

theorem exists_ringAut_hom_ker_eq_range_conj_f4_e8 {τ : Tag} (hτ : τ = .F4 ∨ τ = .E8)
    {K : Type} [Field K] [Finite K] (hK : ringChar K ≠ 2) :
    ∃ θ : MulAut ↥(adjointGroup τ K) →* (K ≃+* K),
      θ.ker = (MulAut.conj : ↥(adjointGroup τ K) →* MulAut ↥(adjointGroup τ K)).range := by
  classical
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨n, hℓ, hn⟩ := FiniteField.card K (ringChar K)
  have hKc : Nat.card K = ringChar K ^ (n : ℕ) := by rw [Nat.card_eq_fintype_card, hn]
  rcases hτ with rfl | rfl
  · obtain ⟨-, Θ, -, -, hker, -⟩ :=
      odd_F4_and_nonexceptional_G2_automorphism_normal_form hℓ hK n.pos K hKc .F4 (Or.inl rfl)
    exact ⟨Θ, hker⟩
  · obtain ⟨Θ, -, -, hker, -, -⟩ :=
      ordinary_E_field_graph_quotient_and_involutions .E8 (Or.inr (Or.inr rfl)) K
    have hsub : Subsingleton (Multiplicative (ZMod (exactE .E8))) := by
      change Subsingleton (Multiplicative (ZMod 1))
      infer_instance
    refine ⟨(MonoidHom.fst _ _).comp Θ, ?_⟩
    ext α
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, MonoidHom.coe_fst, MonoidHom.mem_range]
    constructor
    · intro h1
      have hα : α ∈ Θ.ker := MonoidHom.mem_ker.2 (Prod.ext h1 (Subsingleton.elim _ _))
      obtain ⟨g, a, hga⟩ := (hker α).1 hα
      have hda := CFSG.StandardType.RecipeExcLang.rootDiagUnit_mem_adjointGroup_of_det_one
        (Or.inr (Or.inr rfl)) a
      refine ⟨g * ⟨_, hda⟩, MulEquiv.ext fun h => Subtype.ext ?_⟩
      rw [MulAut.conj_apply, hga h]
      simp only [Subgroup.coe_mul, Subgroup.coe_inv, mul_inv_rev, mul_assoc]
    · rintro ⟨c, rfl⟩
      have hα : MulAut.conj c ∈ Θ.ker := (hker _).2 ⟨c, 1, fun h => by
        rw [rootDiagUnit_one, MulAut.conj_apply, Subgroup.coe_mul, Subgroup.coe_mul,
          Subgroup.coe_inv]
        group⟩
      exact congrArg Prod.fst (MonoidHom.mem_ker.1 hα)

theorem exists_conj_entrywise_two_f4_e8 {τ : Tag} (hτ : τ = .F4 ∨ τ = .E8) {K : Type}
    [Field K] [Finite K] (hK : ringChar K ≠ 2) {β : MulAut ↥(adjointGroup τ K)}
    (hβ2 : β ^ 2 = 1)
    (hβ : β ∉ (MulAut.conj : ↥(adjointGroup τ K) →* MulAut ↥(adjointGroup τ K)).range) :
    ∃ (σ : K ≃+* K) (δ : MulAut ↥(adjointGroup τ K)), orderOf σ = 2 ∧
      δ * β * δ⁻¹ = entrywiseAdjointAut τ σ := by
  classical
  have : Fintype K := Fintype.ofFinite K
  obtain ⟨n, hℓ, hn⟩ := FiniteField.card K (ringChar K)
  have hKc : Nat.card K = ringChar K ^ (n : ℕ) := by rw [Nat.card_eq_fintype_card, hn]
  have hβo : orderOf β = 2 := orderOf_eq_prime hβ2 fun h => hβ ⟨1, by rw [h, map_one]⟩
  rcases hτ with rfl | rfl
  · obtain ⟨-, σ, δ, hσ, -, hδ, -⟩ :=
      odd_F4_prime_field_coset_descent hℓ hK n.pos K hKc Nat.prime_two β hβo hβ
    exact ⟨σ, δ, hσ, hδ⟩
  · have : Fact (ringChar K).Prime := ⟨hℓ⟩
    have : CharP K (ringChar K) := ringChar.charP K
    obtain ⟨-, -, hex⟩ := ordinary_E_exact_automorphism_normal_form .E8 (Or.inr (Or.inr rfl)) K
    obtain ⟨Θ, -, -, -, hsq, hfrob⟩ :=
      ordinary_E_field_graph_quotient_and_involutions .E8 (Or.inr (Or.inr rfl)) K
    obtain ⟨g, a, σ, ε, hga⟩ := hex β
    have hε : (ε : ℕ) = 0 := by
      have := ε.isLt
      change (ε : ℕ) < 1 at this
      omega
    have hσ2 : σ ^ 2 = 1 := hsq β g a σ ε hga hβ2
    have hda := CFSG.StandardType.RecipeExcLang.rootDiagUnit_mem_adjointGroup_of_det_one
      (Or.inr (Or.inr rfl)) a
    have hσ1 : σ ≠ 1 := by
      rintro rfl
      refine hβ ⟨g * ⟨_, hda⟩, MulEquiv.ext fun h => Subtype.ext ?_⟩
      have h1 : Units.map (entrywiseHom (1 : K ≃+* K).toRingHom) (h : ModGL .E8 K) = h := by
        have e1 : (1 : K ≃+* K).toRingHom = RingHom.id K := RingHom.ext fun _ => rfl
        rw [e1]
        exact Units.ext (entrywise_id (R := K) _)
      rw [MulAut.conj_apply, hga h, hε, exactQ_zero, h1]
      simp only [Subgroup.coe_mul, Subgroup.coe_inv, mul_inv_rev, inv_one, mul_one, mul_assoc]
    have hσo : orderOf σ = 2 := orderOf_eq_prime hσ2 hσ1
    obtain ⟨hf2, hσc, -⟩ := hfrob (ringChar K) (n : ℕ) hℓ n.pos hKc σ hσ2 hσ1
    have hn2 : (n : ℕ) / 2 * 2 = n := Nat.div_mul_cancel (even_iff_two_dvd.1 hf2)
    have he : 1 ≤ (n : ℕ) / 2 := by
      have := n.pos
      omega
    have hK4 : 4 ≤ Nat.card K := by
      rw [hKc]
      have h3 : 3 ≤ ringChar K := by
        have := hℓ.two_le
        omega
      calc 4 ≤ 3 ^ 2 := by norm_num
        _ ≤ 3 ^ (n : ℕ) := Nat.pow_le_pow_right (by norm_num) (by omega)
        _ ≤ ringChar K ^ (n : ℕ) := Nat.pow_le_pow_left h3 _
    set L := AlgebraicClosure K
    set x : ModGL .E8 L :=
      baseChangeGL (algebraMap K L) ((g : ModGL .E8 K) * rootDiagUnit .E8 a) with hxdef
    have hx : x ∈ adjointGroup .E8 L :=
      baseChangeGL_mem_adjointGroup _ (mul_mem g.2 hda)
    have hβx : ∀ u : adjointGroup .E8 K, baseChangeGL (algebraMap K L)
        ((β u : adjointGroup .E8 K) : ModGL .E8 K) = x * baseChangeGL (algebraMap K L)
          ((entrywiseAdjointAut .E8 σ u : adjointGroup .E8 K) : ModGL .E8 K) * x⁻¹ := by
      intro u
      rw [hga u, hε, exactQ_zero, coe_entrywiseAdjointAut, hxdef]
      simp only [map_mul, map_inv, mul_one, inv_one]
      group
    obtain ⟨δ, hδ⟩ := CFSG.RankThree.Chevalley.exists_conj_eq_entrywiseAdjointAut_of_ambient .E8
      K hKc hK4 he (by norm_num) hn2 σ hσc L x hx β hβx hβ2
    exact ⟨σ, δ, hσo, hδ⟩


private theorem isSimpleGroup_adjointGroup_f4_e8 {τ : Tag} (hτ : τ = .F4 ∨ τ = .E8) (K : Type)
    [Field K] [Finite K] : IsSimpleGroup ↥(adjointGroup τ K) := by
  have hq : CFSG.IsQuasisimple ↥(adjointGroup τ K) := by
    rcases hτ with rfl | rfl
    · exact CFSG.LieType.Steinberg.Adjoint.isQuasisimple_f4 K
    · exact CFSG.LieType.Steinberg.Adjoint.isQuasisimple_e8 K
  have hZ : Subgroup.center ↥(adjointGroup τ K) = ⊥ := center_adjointGroup_eq_bot
  exact CFSG.LieType.Simplicity.isSimpleGroup_of_mulEquiv hq
    ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm


theorem exists_fixed_rElement_four_f4_e8 {τ : Tag}
    (hτ : τ = .F4 ∨ τ = .E8) {K : Type} [Field K] [Finite K] (hK : ringChar K ≠ 2)
    (E : Subgroup (MulAut ↥(adjointGroup τ K))) (hE : CFSG.Open.IsElemAbelian 2 E)
    (h4 : Nat.card E = 4) :
    ∃ y : ↥(adjointGroup τ K), y ≠ 1 ∧ (∃ n : ℕ, y ^ (ringChar K ^ n) = 1) ∧
      ∀ e ∈ E, e y = y := by
  classical
  have hτ3 : τ = .F4 ∨ τ = .E6 ∨ τ = .E8 := hτ.elim Or.inl fun h => Or.inr (Or.inr h)
  have : Finite (ModGL τ K) := finite_modGL
  have : Finite ↥(adjointGroup τ K) := Subtype.finite
  have : Finite (MulAut ↥(adjointGroup τ K)) :=
    Finite.of_injective (fun e : MulAut ↥(adjointGroup τ K) => (e : _ → _)) DFunLike.coe_injective
  have hZ : ∀ c : ↥(adjointGroup τ K), MulAut.conj c = 1 → c = 1 := by
    intro c hc
    have hcZ : c ∈ Subgroup.center ↥(adjointGroup τ K) := by
      rw [Subgroup.mem_center_iff]
      intro g
      have h1 : c * g * c⁻¹ = g := by
        have := congrArg (fun φ : MulAut ↥(adjointGroup τ K) => φ g) hc
        simpa only [MulAut.conj_apply, MulAut.one_apply] using this
      calc g * c = c * g * c⁻¹ * c := by rw [h1]
        _ = c * g := by group
    rwa [center_adjointGroup_eq_bot, Subgroup.mem_bot] at hcZ
  have hconj : Function.Injective
      (MulAut.conj : ↥(adjointGroup τ K) →* MulAut ↥(adjointGroup τ K)) :=
    (injective_iff_map_eq_one _).2 hZ
  have hE2 : ∀ e ∈ E, e ^ 2 = 1 := hE.2
  by_cases hin : ∀ e ∈ E, e ∈ (MulAut.conj : ↥(adjointGroup τ K) →* MulAut _).range
  ·
    set A := E.comap (MulAut.conj : ↥(adjointGroup τ K) →* MulAut ↥(adjointGroup τ K))
    have hA2 : ∀ a ∈ A, a ^ 2 = 1 := fun a ha =>
      hconj (by rw [map_pow, map_one]; exact hE2 _ ha)
    have hAcard : Nat.card A = 2 ^ 2 := by
      have hmap : A.map (MulAut.conj : ↥(adjointGroup τ K) →* MulAut _) = E :=
        Subgroup.map_comap_eq_self fun e he => hin e he
      rw [← Subgroup.card_map_of_injective hconj, hmap, h4]
      norm_num
    obtain ⟨u, hu1, hun, hucomm⟩ := exists_rElement_commute_four hτ3 hK hA2 hAcard
    refine ⟨u, hu1, hun, fun e he => ?_⟩
    obtain ⟨c, rfl⟩ := hin e he
    have hc : c ∈ A := he
    rw [MulAut.conj_apply, ← (hucomm c hc).eq, mul_inv_cancel_right]
  · obtain ⟨x, hxE, hx⟩ : ∃ x ∈ E, x ∉ (MulAut.conj : ↥(adjointGroup τ K) →* MulAut _).range := by
      by_contra hne
      exact hin fun e he => by_contra fun h => hne ⟨e, he, h⟩
    obtain ⟨θ, hθ⟩ := exists_ringAut_hom_ker_eq_range_conj_f4_e8 hτ hK
    obtain ⟨h, hh1, hhE⟩ : ∃ h : ↥(adjointGroup τ K), h ≠ 1 ∧ MulAut.conj h ∈ E := by
      have : Fintype K := Fintype.ofFinite K
      obtain ⟨n, hℓ, hn⟩ := FiniteField.card K (ringChar K)
      have hKc : Nat.card K = ringChar K ^ (n : ℕ) := by rw [Nat.card_eq_fintype_card, hn]
      obtain ⟨-, hcyc⟩ := CFSG.LocalAnalysis.ComponentInitial.card_ringAut_and_isCyclic hℓ K hKc
      have : Finite (K ≃+* K) := Finite.of_injective (fun σ : K ≃+* K => (σ : K → K))
        DFunLike.coe_injective
      have : Fintype (K ≃+* K) := Fintype.ofFinite _
      have : Finite {γ : K ≃+* K // γ ^ 2 = 1} := Subtype.finite
      have hH : Nat.card {γ : K ≃+* K // γ ^ 2 = 1} ≤ 2 := by
        rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
        exact IsCyclic.card_pow_eq_one_le (by norm_num)
      have : Finite E := Subtype.finite
      obtain ⟨a, b, hab, hθab⟩ := CFSG.HardMathSupport.Lang.E6Descent.exists_ne_map_eq_of_plane
        Nat.prime_two θ hH E hE2 (by rw [h4]; norm_num)
      have hmem : (a : MulAut ↥(adjointGroup τ K))⁻¹ * b ∈ θ.ker := by
        rw [MonoidHom.mem_ker, map_mul, map_inv, hθab, inv_mul_cancel]
      rw [hθ] at hmem
      obtain ⟨h, hh⟩ := hmem
      refine ⟨h, ?_, ?_⟩
      · rintro rfl
        rw [map_one] at hh
        apply hab
        refine Subtype.ext ?_
        have := congrArg (fun z => (a : MulAut ↥(adjointGroup τ K)) * z) hh
        simpa using this
      · rw [hh]
        exact E.mul_mem (E.inv_mem a.2) b.2
    have hx2 : x ^ 2 = 1 := hE2 x hxE
    have hh2 : h ^ 2 = 1 := hconj (by rw [map_pow, map_one]; exact hE2 _ hhE)
    have hcomm : x * MulAut.conj h = MulAut.conj h * x := by
      exact congrArg Subtype.val
        (hE.1.is_comm.comm (⟨x, hxE⟩ : E) (⟨MulAut.conj h, hhE⟩ : E))
    have hxh : x h = h := by
      apply hconj
      have e1 : x * MulAut.conj h * x⁻¹ = MulAut.conj (x h) :=
        MulEquiv.ext fun u => by
          simp only [MulAut.mul_apply, MulAut.conj_apply, map_mul, map_inv, MulAut.apply_inv_self]
      rw [← e1, hcomm, mul_inv_cancel_right]
    obtain ⟨σ, δ, hσ, hδ⟩ := exists_conj_entrywise_two_f4_e8 hτ hK hx2 hx
    have hxδ : x = δ⁻¹ * entrywiseAdjointAut τ σ * δ := by
      rw [← hδ]
      group
    have hΓJ : entrywiseFixedGroup τ σ = fixedFieldImage τ σ := by
      refine CFSG.RankThree.entrywiseFixedGroup_eq_fixedFieldImage_of_det_one ?_ σ
      rw [Matrix.det_transpose]
      rcases hτ with rfl | rfl
      · exact det_cartan_F4
      · exact det_cartan_E8
    set φ := CFSG.LieType.SeitzGeneration.ExcOuterLeOne.fixedEquivOfEq σ hΓJ
    have hh'fix : δ h ∈ fixedSubgroup (entrywiseAdjointAut τ σ) := by
      rw [mem_fixedSubgroup]
      have := congrArg (fun z => z (δ h)) hδ
      simp only [MulAut.mul_apply, MulAut.inv_apply_self] at this
      rw [← this, hxh]
    obtain ⟨h₀, hh₀def⟩ : ∃ h₀, φ ⟨δ h, hh'fix⟩ = h₀ := ⟨_, rfl⟩
    have hh₀1 : h₀ ≠ 1 := by
      intro h0
      have h1 : (⟨δ h, hh'fix⟩ : ↥(fixedSubgroup (entrywiseAdjointAut τ σ))) = 1 :=
        φ.injective (by rw [hh₀def, h0, map_one])
      have h2 : δ h = 1 := congrArg Subtype.val h1
      exact hh1 (δ.injective (by rw [h2, map_one]))
    have hh₀2 : h₀ ^ 2 = 1 := by
      have h1 : (⟨δ h, hh'fix⟩ : ↥(fixedSubgroup (entrywiseAdjointAut τ σ))) ^ 2 = 1 :=
        Subtype.ext (by
          rw [Subgroup.coe_pow, Subgroup.coe_one, ← map_pow, hh2, map_one])
      rw [← hh₀def, ← map_pow, h1, map_one]
    have hh₀o : orderOf h₀ = 2 := orderOf_eq_prime hh₀2 hh₀1
    have : Finite ↥(fixSubfield σ) := Subtype.finite
    have : Finite (ModGL τ ↥(fixSubfield σ)) := finite_modGL
    have : Finite ↥(adjointGroup τ ↥(fixSubfield σ)) := Subtype.finite
    have : IsSimpleGroup ↥(adjointGroup τ ↥(fixSubfield σ)) :=
      isSimpleGroup_adjointGroup_f4_e8 hτ _
    have hnonab : ∃ a b : ↥(adjointGroup τ ↥(fixSubfield σ)), a * b ≠ b * a := by
      by_contra hc
      apply hh₀1
      have hz : h₀ ∈ Subgroup.center ↥(adjointGroup τ ↥(fixSubfield σ)) :=
        Subgroup.mem_center_iff.2 fun g => by_contra fun hne => hc ⟨g, h₀, hne⟩
      rwa [center_adjointGroup_eq_bot, Subgroup.mem_bot] at hz
    obtain ⟨g, hgne, hgc⟩ :=
      CFSG.SeitzReduction.F4Pilot.exists_conj_ne_commute_of_isSimpleGroup hnonab hh₀o
    have hh₀sq : h₀ * h₀ = 1 := by rw [← sq]; exact hh₀2
    have hh₁sq : (g⁻¹ * h₀ * g) * (g⁻¹ * h₀ * g) = 1 := by
      calc (g⁻¹ * h₀ * g) * (g⁻¹ * h₀ * g) = g⁻¹ * (h₀ * h₀) * g := by group
        _ = 1 := by rw [hh₀sq]; group
    have hh₁1 : g⁻¹ * h₀ * g ≠ 1 := by
      intro h1
      apply hh₀1
      calc h₀ = g * (g⁻¹ * h₀ * g) * g⁻¹ := by group
        _ = 1 := by rw [h1]; group
    obtain ⟨-, hAsq, -, hAcard⟩ := CFSG.GH74.GLS.Stage1.Main.four_of_invols hh₀sq hh₁sq hgc.symm
      hh₀1 hh₁1 hgne.symm
    have hchar : ringChar ↥(fixSubfield σ) = ringChar K := by
      have : CharP K (ringChar K) := ringChar.charP K
      have : CharP ↥(fixSubfield σ) (ringChar K) :=
        (RingHom.charP_iff (fixSubfield σ).subtype (fixSubfield σ).subtype.injective
          (ringChar K)).mpr inferInstance
      exact ringChar.eq _ _
    obtain ⟨y₀, hy₀1, ⟨n, hy₀n⟩, hy₀c⟩ := exists_rElement_commute_four hτ3
      (by rw [hchar]; exact hK) (A := zpowers h₀ ⊔ zpowers (g⁻¹ * h₀ * g))
      (fun v hv => by rw [sq]; exact hAsq v hv) (by rw [hAcard]; norm_num)
    have hy₀h₀ : y₀ * h₀ = h₀ * y₀ := (hy₀c h₀ (mem_sup_left (mem_zpowers h₀))).eq
    obtain ⟨y', hy'def⟩ : ∃ y', φ.symm y₀ = y' := ⟨_, rfl⟩
    have hy'fix : entrywiseAdjointAut τ σ (y' : ↥(adjointGroup τ K)) = y' :=
      mem_fixedSubgroup.1 y'.2
    have hy'h' : (y' : ↥(adjointGroup τ K)) * δ h = δ h * y' := by
      have h1 : y' * ⟨δ h, hh'fix⟩ = ⟨δ h, hh'fix⟩ * y' := by
        apply φ.injective
        rw [map_mul, map_mul, ← hy'def, MulEquiv.apply_symm_apply, hh₀def]
        exact hy₀h₀
      exact congrArg Subtype.val h1
    have hfix_x : x (δ⁻¹ y') = δ⁻¹ y' := by
      rw [hxδ, MulAut.mul_apply, MulAut.mul_apply, MulAut.apply_inv_self, hy'fix]
    have hfix_h : MulAut.conj h (δ⁻¹ y') = δ⁻¹ y' := by
      apply δ.injective
      rw [MulAut.conj_apply, map_mul, map_mul, map_inv, MulAut.apply_inv_self, ← hy'h']
      group
    refine ⟨δ⁻¹ y', ?_, ⟨n, ?_⟩, ?_⟩
    · intro h0
      apply hy₀1
      have h1 : (y' : ↥(adjointGroup τ K)) = 1 := by
        have := congrArg δ h0
        rwa [MulAut.apply_inv_self, map_one] at this
      have h2 : y' = 1 := Subtype.ext h1
      rw [← φ.apply_symm_apply y₀, hy'def, h2, map_one]
    · rw [← map_pow, ← Subgroup.coe_pow, ← hy'def, ← map_pow, ← hchar, hy₀n, map_one,
        Subgroup.coe_one, map_one]
    ·
      have hch1 : MulAut.conj h ≠ 1 := fun hce => hh1 (hZ h hce)
      have hx1 : x ≠ 1 := fun hxe => hx ⟨1, by rw [map_one, hxe]⟩
      have hxne : MulAut.conj h ≠ x := fun hxe => hx ⟨h, hxe⟩
      obtain ⟨hmem, -, -, hcard⟩ := CFSG.GH74.GLS.Stage1.Main.four_of_invols
        (by rw [← sq]; exact hE2 _ hhE) (by rw [← sq]; exact hx2) hcomm.symm hch1 hx1 hxne
      have hEeq : zpowers (MulAut.conj h) ⊔ zpowers x = E :=
        Subgroup.eq_of_le_of_card_ge (sup_le (zpowers_le.2 hhE) (zpowers_le.2 hxE))
          (by rw [hcard, h4])
      intro e he
      rw [← hEeq] at he
      rcases hmem e he with rfl | rfl | rfl | rfl
      · rfl
      · exact hfix_h
      · exact hfix_x
      · rw [MulAut.mul_apply, hfix_x, hfix_h]

theorem exists_normalized_rSubgroup_four_f4_e8 {τ : Tag}
    (hτ : τ = .F4 ∨ τ = .E8) {K : Type} [Field K] [Finite K] (hK : ringChar K ≠ 2)
    (E : Subgroup (MulAut ↥(adjointGroup τ K))) (hE : CFSG.Open.IsElemAbelian 2 E)
    (h4 : Nat.card E = 4) :
    ∃ R : Subgroup ↥(adjointGroup τ K), R ≠ ⊥ ∧ IsPGroup (ringChar K) R ∧
      ∀ e ∈ E, R.map e.toMonoidHom = R := by
  obtain ⟨y, hy1, ⟨n, hyn⟩, hyE⟩ := exists_fixed_rElement_four_f4_e8 hτ hK E hE h4
  refine ⟨zpowers y, fun h => hy1 ?_, ?_, fun e he => ?_⟩
  · have hmem : y ∈ zpowers y := mem_zpowers y
    rwa [h, Subgroup.mem_bot] at hmem
  · rintro ⟨g, hg⟩
    obtain ⟨m, rfl⟩ := mem_zpowers_iff.1 hg
    refine ⟨n, Subtype.ext ?_⟩
    simp only [SubgroupClass.coe_pow, OneMemClass.coe_one]
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hyn, one_zpow]
  · rw [MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom, hyE e he]

