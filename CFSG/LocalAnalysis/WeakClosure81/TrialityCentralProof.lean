theorem center_le_commutator_of_index_two [Finite X] {s : X} (hs : s * s = 1)
    (hncl : Subgroup.normalClosure ({s} : Set X) = ⊤) (hZ : Odd (Nat.card (Subgroup.center X)))
    {M : Subgroup X} (hM : M.index = 2) (hsM : s ∉ M) : Subgroup.center X ≤ ⁅M, M⁆ := by
  have : M.FiniteIndex := ⟨by rw [hM]; norm_num⟩
  have hMn : M.Normal := Subgroup.normal_of_index_eq_two hM
  have keys : ∀ (k : ℕ) (g₀ : X), g₀⁻¹ * s ^ k * g₀ ∈ M → g₀⁻¹ * s ^ k * g₀ = s ^ k := by
    intro k g₀ hk
    rcases Nat.even_or_odd k with ⟨j, rfl⟩ | ⟨j, rfl⟩
    · rw [← two_mul, pow_mul, pow_two, hs, one_pow, mul_one, inv_mul_cancel]
    · exfalso
      rw [pow_succ, pow_mul, pow_two, hs, one_pow, one_mul] at hk
      apply hsM
      simpa [mul_assoc] using hMn.conj_mem _ hk g₀
  have hVs : (Abelianization.of : ↥M →* Abelianization ↥M).transfer s = 1 := by
    have h2 : s ^ M.index = 1 := by rw [hM, pow_two, hs]
    rw [MonoidHom.transfer_eq_pow _ s keys]
    convert map_one (Abelianization.of : ↥M →* Abelianization ↥M)
  have hV : ∀ x, (Abelianization.of : ↥M →* Abelianization ↥M).transfer x = 1 := by
    have hle : Subgroup.normalClosure ({s} : Set X) ≤
        (Abelianization.of : ↥M →* Abelianization ↥M).transfer.ker :=
      Subgroup.normalClosure_le_normal (Set.singleton_subset_iff.mpr (MonoidHom.mem_ker.mpr hVs))
    rw [hncl] at hle
    exact fun x => MonoidHom.mem_ker.mp (hle (Subgroup.mem_top x))
  intro z hz
  have keyz : ∀ (k : ℕ) (g₀ : X), g₀⁻¹ * z ^ k * g₀ ∈ M → g₀⁻¹ * z ^ k * g₀ = z ^ k := by
    intro k g₀ _
    rw [mul_assoc, ← Subgroup.mem_center_iff.mp (Subgroup.pow_mem _ hz k) g₀, ← mul_assoc,
      inv_mul_cancel, one_mul]
  have h1 := MonoidHom.transfer_eq_pow (Abelianization.of : ↥M →* Abelianization ↥M) z keyz
  have h2 : (⟨z ^ M.index, MonoidHom.transfer_eq_pow_aux z keyz⟩ : ↥M) ∈ commutator ↥M := by
    rw [← Abelianization.ker_of, MonoidHom.mem_ker, ← h1]
    exact hV z
  have h3 : z ^ M.index ∈ ⁅M, M⁆ := by
    rw [← Subgroup.map_subtype_commutator]
    exact ⟨_, h2, rfl⟩
  rw [hM] at h3
  obtain ⟨m, hm⟩ : Odd (orderOf z) := Odd.of_dvd_nat hZ (by
    rw [← Subgroup.orderOf_mk z hz]
    exact orderOf_dvd_natCard _)
  have hz' : z = (z ^ 2) ^ (m + 1) := by
    rw [← pow_mul, show 2 * (m + 1) = orderOf z + 1 by omega, pow_succ, pow_orderOf_eq_one,
      one_mul]
  rw [hz']
  exact Subgroup.pow_mem _ h3 _

theorem commutator_le_of_isCyclic {C : Type*} [Group C] [IsCyclic C] {M D : Subgroup X}
    [hDn : D.Normal] (hDM : D ≤ M) (f : ↥M →* C) (hfD : ∀ m : ↥M, (m : X) ∈ D → f m = 1)
    (hker : ∀ m : ↥M, f m = 1 → ∃ d ∈ D, d⁻¹ * (m : X) ∈ Subgroup.center X) : ⁅M, M⁆ ≤ D := by
  have hNf : D.subgroupOf M ≤ f.ker := fun m hm => hfD m hm
  have hcen : (QuotientGroup.lift (D.subgroupOf M) f hNf).ker ≤
      Subgroup.center (↥M ⧸ D.subgroupOf M) := by
    intro q hq
    obtain ⟨m, rfl⟩ := QuotientGroup.mk_surjective q
    rw [MonoidHom.mem_ker, QuotientGroup.lift_mk] at hq
    obtain ⟨d, hdD, hdz⟩ := hker m hq
    have hzM : d⁻¹ * (m : X) ∈ M := M.mul_mem (M.inv_mem (hDM hdD)) m.2
    have hmz : (QuotientGroup.mk m : ↥M ⧸ D.subgroupOf M) = QuotientGroup.mk ⟨d⁻¹ * m, hzM⟩ := by
      rw [QuotientGroup.eq, Subgroup.mem_subgroupOf]
      simpa [mul_assoc] using hDn.conj_mem _ (D.inv_mem hdD) (m : X)⁻¹
    rw [hmz, Subgroup.mem_center_iff]
    intro q'
    obtain ⟨m', rfl⟩ := QuotientGroup.mk_surjective q'
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul]
    exact congrArg _ (Subtype.ext (Subgroup.mem_center_iff.mp hdz m'))
  rw [Subgroup.commutator_le]
  intro a ha b hb
  have hc := commutative_of_cyclic_center_quotient _ hcen
    (QuotientGroup.mk ⟨a, ha⟩ : ↥M ⧸ D.subgroupOf M) (QuotientGroup.mk ⟨b, hb⟩)
  have h1 : (QuotientGroup.mk ⁅(⟨a, ha⟩ : ↥M), ⟨b, hb⟩⁆ : ↥M ⧸ D.subgroupOf M) = 1 := by
    rw [commutatorElement_def, QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_mul,
      QuotientGroup.mk_inv, QuotientGroup.mk_inv, hc, mul_inv_cancel_right, mul_inv_cancel]
  rw [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf] at h1
  exact h1

theorem center_eq_bot_of_perm_three [Finite X] {s : X} (hs : s * s = 1)
    (hncl : Subgroup.normalClosure ({s} : Set X) = ⊤) (hZ : Odd (Nat.card (Subgroup.center X)))
    {ρ : X →* Equiv.Perm (Fin 3)} (hρs : (ρ s).IsSwap) {D : Subgroup X} [D.Normal]
    (hDK : ∀ d ∈ D, ρ d = 1) (hKD : ∀ x, ρ x = 1 → ∃ d ∈ D, d⁻¹ * x ∈ Subgroup.center X)
    (hDZ : D ⊓ Subgroup.center X = ⊥) : Subgroup.center X = ⊥ := by
  have hσs : (Equiv.Perm.sign.comp ρ) s = -1 := by
    rw [MonoidHom.comp_apply, hρs.sign_eq]
  have hsM : s ∉ (Equiv.Perm.sign.comp ρ).ker := by
    rw [MonoidHom.mem_ker, hσs]
    decide
  have hMidx : (Equiv.Perm.sign.comp ρ).ker.index = 2 := by
    refine Subgroup.index_eq_two_iff_exists_notMem_and.mpr ⟨s, hsM, fun b => ?_⟩
    rcases Int.units_eq_one_or ((Equiv.Perm.sign.comp ρ) b) with h | h
    · exact Or.inr (MonoidHom.mem_ker.mpr h)
    · refine Or.inl (MonoidHom.mem_ker.mpr ?_)
      rw [map_mul, h, hσs]
      decide
  have hDM : D ≤ (Equiv.Perm.sign.comp ρ).ker := fun d hd => by
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, hDK d hd, map_one]
  have hmem : ∀ m : ↥(Equiv.Perm.sign.comp ρ).ker,
      (ρ.comp (Equiv.Perm.sign.comp ρ).ker.subtype) m ∈ alternatingGroup (Fin 3) := fun m =>
    Equiv.Perm.mem_alternatingGroup.mpr (MonoidHom.mem_ker.mp m.2)
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have : IsCyclic ↥(alternatingGroup (Fin 3)) := isCyclic_of_prime_card (p := 3) (by
    rw [nat_card_alternatingGroup, Nat.card_eq_fintype_card, Fintype.card_fin]
    decide)
  have hMD : ⁅(Equiv.Perm.sign.comp ρ).ker, (Equiv.Perm.sign.comp ρ).ker⁆ ≤ D :=
    commutator_le_of_isCyclic hDM ((ρ.comp (Equiv.Perm.sign.comp ρ).ker.subtype).codRestrict _ hmem)
      (fun m hm => Subtype.ext (hDK m hm))
      (fun m hm => hKD m (congrArg Subtype.val hm))
  rw [eq_bot_iff, ← hDZ]
  exact le_inf ((center_le_commutator_of_index_two hs hncl hZ hMidx hsM).trans hMD) le_rfl

theorem exists_perfect_of_comap {Y : Type*} [Group Y] {π : X →* Y}
    (hπs : Function.Surjective π) (hπ : π.ker = Subgroup.center X) {N : Subgroup Y} [N.Normal]
    (hN : ⁅N, N⁆ = N) : ∃ D : Subgroup X, D.Normal ∧ D.map π = N ∧
      (∀ x, π x ∈ N → ∃ d ∈ D, d⁻¹ * x ∈ Subgroup.center X) ∧ ⁅D, D⁆ = D := by
  have hmap : ⁅N.comap π, N.comap π⁆.map π = N := by
    rw [Subgroup.map_commutator, Subgroup.map_comap_eq_self_of_surjective hπs, hN]
  have hKD : ∀ x, π x ∈ N → ∃ d ∈ ⁅N.comap π, N.comap π⁆, d⁻¹ * x ∈ Subgroup.center X := by
    intro x hx
    obtain ⟨d, hd, hdx⟩ : π x ∈ ⁅N.comap π, N.comap π⁆.map π := hmap.symm ▸ hx
    refine ⟨d, hd, ?_⟩
    rw [← hπ, MonoidHom.mem_ker, map_mul, map_inv, hdx, inv_mul_cancel]
  refine ⟨⁅N.comap π, N.comap π⁆, inferInstance, hmap, hKD,
    le_antisymm (Subgroup.commutator_le_left _ _) ?_⟩
  have hKDZ : N.comap π ≤ ⁅N.comap π, N.comap π⁆ ⊔ Subgroup.center X := fun x hx => by
    obtain ⟨d, hd, hdz⟩ := hKD x hx
    rw [show x = d * (d⁻¹ * x) by group]
    exact Subgroup.mul_mem_sup hd hdz
  calc ⁅N.comap π, N.comap π⁆
      ≤ ⁅⁅N.comap π, N.comap π⁆ ⊔ Subgroup.center X,
          ⁅N.comap π, N.comap π⁆ ⊔ Subgroup.center X⁆ := Subgroup.commutator_mono hKDZ hKDZ
    _ = ⁅⁅N.comap π, N.comap π⁆, ⁅N.comap π, N.comap π⁆⁆ :=
        CFSG.RankThreeCoreUniqueness.Helpers.commutator_sup_central_eq _ _ inferInstance le_rfl

theorem inf_center_eq_bot_of_hopfMultiplier [Finite X] (hZ : Odd (Nat.card (Subgroup.center X)))
    {S : Type} [Group S] (hS : Nat.card (CFSG.RankThree.PerfectCover.hopfMultiplier S) ∣ 4)
    {D : Subgroup X} (hD : ⁅D, D⁆ = D) (q : ↥D →* S) (hq : Function.Surjective q)
    (hqker : ∀ d : ↥D, q d = 1 ↔ (d : X) ∈ Subgroup.center X) :
    D ⊓ Subgroup.center X = ⊥ := by
  have hcen : q.ker ≤ Subgroup.center ↥D := fun d hd =>
    Subgroup.mem_center_iff.mpr fun e =>
      Subtype.ext (Subgroup.mem_center_iff.mp ((hqker d).mp (MonoidHom.mem_ker.mp hd)) e)
  have hdvd := CFSG.GH74.Generic.card_ker_dvd_hopfMultiplier (Subgroup.isPerfect_iff.mpr hD) q
    hq hcen
  rw [eq_bot_iff]
  intro z hz
  obtain ⟨hzD, hzZ⟩ := Subgroup.mem_inf.mp hz
  have hk : (⟨z, hzD⟩ : ↥D) ∈ q.ker := MonoidHom.mem_ker.mpr ((hqker _).mpr hzZ)
  have h1 : orderOf z ∣ 4 := by
    have := orderOf_dvd_natCard (⟨⟨z, hzD⟩, hk⟩ : ↥q.ker)
    rw [Subgroup.orderOf_mk, Subgroup.orderOf_mk] at this
    exact this.trans (hdvd.trans hS)
  have h2 : Odd (orderOf z) := Odd.of_dvd_nat hZ (by
    rw [← Subgroup.orderOf_mk z hzZ]
    exact orderOf_dvd_natCard _)
  have h3 : Nat.Coprime (orderOf z) (2 ^ 2) :=
    Nat.Coprime.pow_right 2 (Nat.coprime_two_right.mpr h2)
  exact Subgroup.mem_bot.mpr (orderOf_eq_one_iff.mp (Nat.Coprime.eq_one_of_dvd h3 h1))

