private noncomputable def orthogonalPlusFourEquiv (F : Type) [Field F] :
    ↥(CFSG.PGLModel.orthogonalPlus 4 F) ≃*
      ↥(TauCeti.QuadraticMap.orthogonalGroup (quadPlus 4 F)) :=
  ((toLinEquiv (Fin 4 ⊕ Fin 4) F).subgroupMap (CFSG.PGLModel.orthogonalPlus 4 F)).trans
    (MulEquiv.subgroupCongr (by
      rw [show CFSG.PGLModel.orthogonalPlus 4 F =
          (TauCeti.QuadraticMap.orthogonalGroup (quadPlus 4 F)).comap
            (toLinEquiv (Fin 4 ⊕ Fin 4) F).toMonoidHom from
        closure_isometries_eq_comap (coe_quadPlus 4 F)]
      exact Subgroup.map_comap_eq_self_of_surjective (toLinEquiv _ F).surjective _))

private theorem index_commutator_orthogonalPlus_four_le_two {F : Type} [Field F] [Finite F]
    {f : ℕ} (hf : 1 ≤ f) (hF : Nat.card F = 2 ^ f) :
    (commutator ↥(CFSG.PGLModel.orthogonalPlus 4 F)).index ≤ 2 := by
  have h : StatedClassicalModel (StatedProj (StatedOmega (StatedQuadPlus 4 F))) .POmegaPlus 4 2 f :=
    ⟨⟨Nat.prime_two, hf, le_rfl⟩, F, inferInstance, inferInstance, hF, ⟨MulEquiv.refl _⟩⟩
  have hab :=
    (CFSG.LocalAnalysis.ComponentInitial.orthogonal_model_isometry_abelianization_order_bound
      _ .POmegaPlus (.inr (.inl rfl)) 4 2 f h F hF (quadPlus 4 F) (coe_quadPlus 4 F)
      (MulEquiv.refl _)).2.2 rfl
  calc (commutator ↥(CFSG.PGLModel.orthogonalPlus 4 F)).index
      = Nat.card (Abelianization ↥(CFSG.PGLModel.orthogonalPlus 4 F)) := rfl
    _ = Nat.card (Abelianization ↥(TauCeti.QuadraticMap.orthogonalGroup (quadPlus 4 F))) :=
        Nat.card_congr (orthogonalPlusFourEquiv F).abelianizationCongr.toEquiv
    _ ≤ 2 := hab

theorem exists_statedClassicalModel_ker_of_trialityData {Y : Type} [Group Y] {t : Y}
    {ε : Y →* Equiv.Perm (Fin 3)} (hT : TrialityData Y t ε) :
    ∃ f : ℕ, StatedClassicalModel ↥ε.ker .POmegaPlus 4 2 f := by
  obtain ⟨f, F, _, _, hF, e, -⟩ := hT.orth
  have hf : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with rfl | h
    · rw [pow_zero] at hF
      exact absurd hF (Finite.one_lt_card (α := F)).ne'
    · exact h
  have : CharP F 2 := by
    have := Fintype.ofFinite F
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    exact charP_of_card_eq_prime_pow (by rw [← Nat.card_eq_fintype_card, hF])
  have hZ : Subgroup.center ↥(ε.ker ⊔ Subgroup.zpowers t) = ⊥ := by
    rw [eq_bot_iff]
    intro z hz
    have hz' : (z : Y) ∈ Subgroup.centralizer (ε.ker : Set Y) := by
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      exact congrArg Subtype.val (Subgroup.mem_center_iff.mp hz ⟨y, Subgroup.mem_sup_left hy⟩)
    rw [hT.centralizer_ker, Subgroup.mem_bot] at hz'
    exact Subgroup.mem_bot.mpr (Subtype.ext hz')
  let ψ : ↥(ε.ker ⊔ Subgroup.zpowers t) ≃* ↥(CFSG.PGLModel.orthogonalPlus 4 F) :=
    ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm.trans e
  have hidx : (ε.ker.subgroupOf (ε.ker ⊔ Subgroup.zpowers t)).index = 2 := by
    rw [show ε.ker.subgroupOf (ε.ker ⊔ Subgroup.zpowers t) =
        (ε.comp (ε.ker ⊔ Subgroup.zpowers t).subtype).ker from MonoidHom.comap_ker _ _,
      Subgroup.index_ker, MonoidHom.range_comp, Subgroup.range_subtype, Subgroup.map_sup,
      Subgroup.map_ker_self, bot_sup_eq, MonoidHom.map_zpowers, Nat.card_zpowers]
    exact hT.isSwap.orderOf
  have hJidx : ((ε.ker.subgroupOf (ε.ker ⊔ Subgroup.zpowers t)).map ψ.toMonoidHom).index = 2 := by
    rw [Subgroup.index_map_of_bijective (f := ψ.toMonoidHom) ψ.bijective, hidx]
  have hcJ : commutator ↥(CFSG.PGLModel.orthogonalPlus 4 F) ≤
      (ε.ker.subgroupOf (ε.ker ⊔ Subgroup.zpowers t)).map ψ.toMonoidHom := by
    rw [commutator_def, Subgroup.commutator_le]
    intro a _ b _
    rw [commutatorElement_def, Subgroup.mul_mem_iff_of_index_two hJidx,
      Subgroup.mul_mem_iff_of_index_two hJidx, Subgroup.mul_mem_iff_of_index_two hJidx,
      inv_mem_iff, inv_mem_iff]
    tauto
  have hJ : commutator ↥(CFSG.PGLModel.orthogonalPlus 4 F) =
      (ε.ker.subgroupOf (ε.ker ⊔ Subgroup.zpowers t)).map ψ.toMonoidHom := by
    have : ((ε.ker.subgroupOf (ε.ker ⊔ Subgroup.zpowers t)).map ψ.toMonoidHom).FiniteIndex :=
