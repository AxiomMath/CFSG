theorem commutator_eq_top_and_card_hopfMultiplier_dvd_four {K : Type} [Field K] [Finite K]
    {f : ℕ} (hf : 1 ≤ f) (hK : Nat.card K = 2 ^ f) :
    commutator (StatedProj (StatedOmega (StatedQuadPlus 4 K))) = ⊤ ∧
      Nat.card (CFSG.RankThree.PerfectCover.hopfMultiplier
        (StatedProj (StatedOmega (StatedQuadPlus 4 K)))) ∣ 4 := by
  have hcard : ∀ k : ℕ, Nat.card (Multiplicative (ZMod k)) = k := fun k =>
    (Nat.card_congr Multiplicative.toAdd).trans (Nat.card_zmod k)
  have hg : CFSG.Blueprint.Multiplier.genericOrders .POmegaPlus 4 2 f = (1, 1) := by
    have h : Even (2 ^ f) := (Nat.even_pow' (by omega)).mpr even_two
    simp [CFSG.Blueprint.Multiplier.genericOrders, h]
  rw [Nat.card_congr (CFSG.RankThree.PerfectCover.hopfMultiplierEquivGriess _).symm.toEquiv]
  rcases (show f = 1 ∨ 2 ≤ f by omega) with rfl | hf2
  · have hadm : StatedLieAdmissible .POmegaPlus 4 2 1 := ⟨Nat.prime_two, le_rfl, le_rfl⟩
    obtain ⟨hperf, ⟨e⟩⟩ :=
      CFSG.LieType.Steinberg.CentralExt.GriessClassical.pomegaPlus_four_two_row
        (X := StatedProj (StatedOmega (StatedQuadPlus 4 K)))
        ⟨hadm, Or.inl ⟨hadm, K, inferInstance, inferInstance, hK, ⟨MulEquiv.refl _⟩⟩⟩
    have he : CFSG.Blueprint.Multiplier.exceptionalOrders .POmegaPlus 4 2 1 = (2, 2) := rfl
    refine ⟨hperf, ?_⟩
    rw [Nat.card_congr e.toEquiv]
    simp only [CFSG.Blueprint.Multiplier.generic, CFSG.Blueprint.Multiplier.exceptional,
      Nat.card_prod, hcard, hg, he]
    norm_num
  · have hK4 : 4 ≤ Nat.card K := by
      rw [hK]
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf2
    obtain ⟨hperf, ⟨e⟩⟩ :=
      CFSG.LieType.Steinberg.CentralExt.SpinPlusClosed.pomegaPlus_hopfMultiplier (K := K)
        (n := 4) (p := 2) (f := f) (by norm_num) hK hK4
    refine ⟨hperf, ?_⟩
    rw [Nat.card_congr e.toEquiv]
    simp only [CFSG.Blueprint.Multiplier.generic, Nat.card_prod, hcard, hg]
    norm_num

