private theorem w183finTrace_mul_self_char_two {n : Type*} [Fintype n] [DecidableEq n]
    {R : Type*} [CommRing R] [CharP R 2] (M : Matrix n n R) :
    Matrix.trace (M * M) = Matrix.trace M ^ 2 := by
  classical
  have h2 : (2 : R) = 0 := by exact_mod_cast CharP.cast_eq_zero R 2
  have hsq : Matrix.trace M ^ 2 = ∑ i, M i i * M i i := by
    have := sum_pow_char 2 (Finset.univ : Finset n) (fun i => M i i)
    simpa [Matrix.trace, Matrix.diag, sq] using this
  rw [hsq]
  simp only [Matrix.trace, Matrix.diag, Matrix.mul_apply]
  have hsplit : ∀ i, ∑ j, M i j * M j i =
      M i i * M i i + ∑ j ∈ Finset.univ.erase i, M i j * M j i := by
    intro i
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ i)]
  simp only [hsplit, Finset.sum_add_distrib]
  rw [add_eq_left]
  rw [Finset.sum_sigma' (Finset.univ : Finset n) (fun i => Finset.univ.erase i)
    (fun i j => M i j * M j i)]
  refine Finset.sum_involution (fun p _ => (⟨p.2, p.1⟩ : Σ _ : n, n)) ?_ ?_ ?_ ?_
  · intro p hp
    have : M p.1 p.2 * M p.2 p.1 + M p.2 p.1 * M p.1 p.2 =
        2 * (M p.1 p.2 * M p.2 p.1) := by ring
    rw [this, h2, zero_mul]
  · intro p hp hne
    rintro h
    have h1 : p.2 = p.1 := congrArg Sigma.fst h
    have hp' := (Finset.mem_sigma.1 hp).2
    simp [Finset.mem_erase] at hp'
    exact hp' h1
  · intro p hp
    have hp' := (Finset.mem_sigma.1 hp).2
    simp only [Finset.mem_erase, Finset.mem_univ, and_true] at hp'
    simp [Finset.mem_sigma, Finset.mem_erase, hp'.symm]
  · intro p hp
    rfl

private theorem w183finTrace_pow_two_pow {n : Type*} [Fintype n] [DecidableEq n]
    {R : Type*} [CommRing R] [CharP R 2] (M : Matrix n n R) (k : ℕ) :
    Matrix.trace (M ^ 2 ^ k) = Matrix.trace M ^ 2 ^ k := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ 2 k, pow_mul, sq, w183finTrace_mul_self_char_two, ih, ← pow_mul, ← pow_succ]

private theorem w183finTrace_pow_four_of_stable {X : Type} [Group X] [Finite X]
    (hst : ∀ s : X, Odd (orderOf s) → ∃ h : X, h * s * h⁻¹ = s ^ 4)
    {n : ℕ} (ρ : X →* Matrix.GeneralLinearGroup (Fin n) Kc) (x : X) :
    Matrix.trace (ρ x : Matrix (Fin n) (Fin n) Kc) ^ 4 =
      Matrix.trace (ρ x : Matrix (Fin n) (Fin n) Kc) := by
  obtain ⟨k, m, hm, hord⟩ := Nat.exists_eq_two_pow_mul_odd (orderOf_pos x).ne'
  have hsord : orderOf (x ^ 2 ^ k) = m := by
    rw [orderOf_pow_of_dvd (by positivity) ⟨m, hord⟩]
    rw [hord, Nat.mul_div_cancel_left _ (by positivity)]
  obtain ⟨h, hh⟩ := hst (x ^ 2 ^ k) (hsord ▸ hm)
  set s := x ^ 2 ^ k with hs
  have h4 : Matrix.trace (ρ s : Matrix (Fin n) (Fin n) Kc) ^ 4 =
      Matrix.trace (ρ s : Matrix (Fin n) (Fin n) Kc) := by
    have e1 := w183finTrace_pow_two_pow (ρ s : Matrix (Fin n) (Fin n) Kc) 2
    rw [show (2 : ℕ) ^ 2 = 4 by norm_num] at e1
    rw [← e1, ← Units.val_pow_eq_pow_val, ← map_pow, ← hh, map_mul, map_mul, Units.val_mul,
      Units.val_mul, map_inv]
    have := Matrix.trace_units_conj (ρ h) (ρ s : Matrix (Fin n) (Fin n) Kc)
    simpa using this
  have e2 := w183finTrace_pow_two_pow (ρ x : Matrix (Fin n) (Fin n) Kc) k
  have e3 : (ρ x : Matrix (Fin n) (Fin n) Kc) ^ 2 ^ k = (ρ s : Matrix (Fin n) (Fin n) Kc) := by
    rw [hs, map_pow, Units.val_pow_eq_pow_val]
  rw [e3] at e2
  have e4 : (Matrix.trace (ρ x : Matrix (Fin n) (Fin n) Kc) ^ 4) ^ 2 ^ k =
      Matrix.trace (ρ x : Matrix (Fin n) (Fin n) Kc) ^ 2 ^ k := by
    calc (Matrix.trace (ρ x : Matrix (Fin n) (Fin n) Kc) ^ 4) ^ 2 ^ k
        = (Matrix.trace (ρ x : Matrix (Fin n) (Fin n) Kc) ^ 2 ^ k) ^ 4 := by
          rw [← pow_mul, ← pow_mul, mul_comm]
      _ = Matrix.trace (ρ s : Matrix (Fin n) (Fin n) Kc) ^ 4 := by rw [← e2]
      _ = Matrix.trace (ρ s : Matrix (Fin n) (Fin n) Kc) := h4
      _ = _ := e2
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact iterateFrobenius_inj Kc 2 k (by simpa [iterateFrobenius_def] using e4)

private theorem w183finAbsIrrOverF4_of_stable {X : Type} [Group X] [Finite X]
    (hst : ∀ s : X, Odd (orderOf s) → ∃ h : X, h * s * h⁻¹ = s ^ 4) : AbsIrrOverF4 X :=
  w183finAbsIrrOverF4_of_trace (fun _ ρ _ g => w183finTrace_pow_four_of_stable hst ρ g)

private theorem w183finOdd_stable_of_central_extension {X Y : Type} [Group X] [Group Y]
    (Z : Subgroup X) (hZc : ∀ z ∈ Z, ∀ x : X, x * z = z * x) (hZ3 : ∀ z ∈ Z, z ^ 3 = 1)
    (q : X →* Y) (hq : Function.Surjective q) (hker : ∀ x, q x = 1 → x ∈ Z)
    (h3 : ∀ y : Y, y ^ 3 = 1 → ∃ k : Y, k * y * k⁻¹ = y⁻¹)
    (h5 : ∀ y : Y, y ^ 5 = 1 → ∃ k : Y, k * y * k⁻¹ = y⁻¹)
    (hodd : ∀ y : Y, Odd (orderOf y) → y ^ 3 = 1 ∨ y ^ 5 = 1) :
    ∀ s : X, Odd (orderOf s) → ∃ h : X, h * s * h⁻¹ = s ^ 4 := by
  intro s hs
  have hos : Odd (orderOf (q s)) := hs.of_dvd_nat (orderOf_map_dvd q s)
  have lift : ∀ kb : Y, kb * q s * kb⁻¹ = (q s)⁻¹ →
      ∃ k : X, ∃ z ∈ Z, k * s * k⁻¹ = s⁻¹ * z := by
    intro kb hkb
    obtain ⟨k, rfl⟩ := hq kb
    refine ⟨k, s * (k * s * k⁻¹), hker _ ?_, by group⟩
    simp only [map_mul, map_inv]
    rw [hkb, mul_inv_cancel]
  rcases hodd _ hos with h3s | h5s
  · have hs3 : s ^ 3 ∈ Z := hker _ (by rw [map_pow]; exact h3s)
    obtain ⟨kb, hkb⟩ := h3 _ h3s
    obtain ⟨k, z₀, hz₀, hk⟩ := lift kb hkb
    have e1 : (k * s * k⁻¹) ^ 3 = s ^ 3 := by
      rw [conj_pow]
      exact mul_inv_eq_iff_eq_mul.mpr (hZc _ hs3 k)
    have e2 : (s⁻¹ * z₀) ^ 3 = (s ^ 3)⁻¹ := by
      rw [Commute.mul_pow (hZc z₀ hz₀ s⁻¹), hZ3 z₀ hz₀, mul_one, inv_pow]
    rw [hk, e2] at e1
    have h33 := hZ3 _ hs3
    have h1 : s ^ 3 * s ^ 3 = 1 := by
      calc s ^ 3 * s ^ 3 = s ^ 3 * (s ^ 3)⁻¹ := by rw [e1]
        _ = 1 := mul_inv_cancel _
    have h31 : s ^ 3 = 1 := by
      generalize s ^ 3 = a at h33 h1
      calc a = a ^ 3 * (a * a)⁻¹ := by group
        _ = 1 := by rw [h33, h1]; simp
    have h4 : s ^ 4 = s := by
      rw [show (4 : ℕ) = 3 + 1 from rfl, pow_succ, h31, one_mul]
    exact ⟨1, by simp [h4]⟩
  · have hs5 : s ^ 5 ∈ Z := hker _ (by rw [map_pow]; exact h5s)
    obtain ⟨kb, hkb⟩ := h5 _ h5s
    obtain ⟨k, z₃, hz₃, hk⟩ := lift kb hkb
    have e1 : (k * s * k⁻¹) ^ 5 = s ^ 5 := by
      rw [conj_pow]
      exact mul_inv_eq_iff_eq_mul.mpr (hZc _ hs5 k)
    have e2 : (s⁻¹ * z₃) ^ 5 = (s ^ 5)⁻¹ * z₃ ^ 5 := by
      rw [Commute.mul_pow (hZc z₃ hz₃ s⁻¹), inv_pow]
    rw [hk, e2] at e1
    have hz33 := hZ3 z₃ hz₃
    have hz13 := hZ3 _ hs5
    have hz35 : z₃ ^ 5 = z₃ ^ 2 := by
      calc z₃ ^ 5 = z₃ ^ 3 * z₃ ^ 2 := by group
        _ = z₃ ^ 2 := by rw [hz33, one_mul]
    rw [hz35] at e1
    have hsq : z₃ ^ 2 = s ^ 5 * s ^ 5 := by
      calc z₃ ^ 2 = s ^ 5 * ((s ^ 5)⁻¹ * z₃ ^ 2) := by group
        _ = s ^ 5 * s ^ 5 := by rw [e1]
    have hzz : s ^ 5 = z₃ := by
      calc s ^ 5 = (s ^ 5) ^ 3 * s ^ 5 := by rw [hz13, one_mul]
        _ = (s ^ 5 * s ^ 5) * (s ^ 5 * s ^ 5) := by group
        _ = z₃ ^ 2 * z₃ ^ 2 := by rw [← hsq]
        _ = z₃ ^ 3 * z₃ := by group
        _ = z₃ := by rw [hz33, one_mul]
    refine ⟨k, ?_⟩
    rw [hk, ← hzz]
    group

private abbrev w183finA6 := alternatingGroup (Fin 6)

private theorem w183finA6_real3 : ∀ g : w183finA6, g ^ 3 = 1 →
    ∃ k : w183finA6, k * g * k⁻¹ = g⁻¹ :=
  W183Pack.conj_inv_of_check W183Pack.invK3_all

private theorem w183finA6_real5 : ∀ g : w183finA6, g ^ 5 = 1 →
    ∃ k : w183finA6, k * g * k⁻¹ = g⁻¹ :=
  W183Pack.conj_inv_of_check W183Pack.invK5_all

private theorem w183finA6_odd : ∀ g : w183finA6, g ^ 45 = 1 → g ^ 3 = 1 ∨ g ^ 5 = 1 :=
  W183Pack.odd_of_check

private theorem w183finA6_odd' : ∀ g : w183finA6, Odd (orderOf g) → g ^ 3 = 1 ∨ g ^ 5 = 1 := by
  intro g hg
  have hcard : Nat.card w183finA6 = 360 := by
    rw [Nat.card_eq_fintype_card]
    decide +kernel
  have h360 : g ^ 360 = 1 := by
    rw [← hcard]
    exact pow_card_eq_one'
  have hdvd : orderOf g ∣ 45 * 2 ^ 3 := orderOf_dvd_of_pow_eq_one h360
  have hcop : Nat.Coprime (orderOf g) (2 ^ 3) := hg.coprime_two_right.pow_right 3
  have h45 : orderOf g ∣ 45 := hcop.dvd_of_dvd_mul_right hdvd
  exact w183finA6_odd g (orderOf_dvd_iff_pow_eq_one.mp h45)

private theorem w183finA6_stable : ∀ s : w183finA6, Odd (orderOf s) →
    ∃ h : w183finA6, h * s * h⁻¹ = s ^ 4 := by
  intro s hs
  rcases w183finA6_odd' s hs with h3 | h5
  · have h4 : s ^ 4 = s := by
      rw [show (4 : ℕ) = 3 + 1 from rfl, pow_succ, h3, one_mul]
    exact ⟨1, by simp [h4]⟩
  · obtain ⟨k, hk⟩ := w183finA6_real5 s h5
    refine ⟨k, hk.trans ?_⟩
    exact inv_eq_of_mul_eq_one_right (by rw [← pow_succ']; exact h5)

theorem w183finAbsIrrOverF4_alt6 {M : Type} [Group M] (hM : IsAlt M 6) : AbsIrrOverF4 M := by
  obtain ⟨e⟩ := hM
  haveI : Finite M := Finite.of_equiv w183finA6 e.symm.toEquiv
  refine w183finAbsIrrOverF4_of_stable (fun s hs => ?_)
  have hs' : Odd (orderOf (e s)) := by rwa [MulEquiv.orderOf_eq]
  obtain ⟨h, hh⟩ := w183finA6_stable (e s) hs'
  refine ⟨e.symm h, e.injective ?_⟩
  simpa using hh

theorem w183finAbsIrrOverF4_cover_A6 {X : Type} [Group X]
    (hZ : Nat.card (Subgroup.center X) = 3) (hA : IsAlt (X ⧸ Subgroup.center X) 6) :
    AbsIrrOverF4 X := by
  obtain ⟨e⟩ := hA
  haveI : Finite (Subgroup.center X) := Nat.finite_of_card_ne_zero (by omega)
  haveI : Finite (X ⧸ Subgroup.center X) := Finite.of_equiv w183finA6 e.symm.toEquiv
  haveI : Finite X := Finite.of_equiv _
    (Subgroup.groupEquivQuotientProdSubgroup (s := Subgroup.center X)).symm
  refine w183finAbsIrrOverF4_of_stable (w183finOdd_stable_of_central_extension
    (Subgroup.center X) (fun z hz x => Subgroup.mem_center_iff.1 hz x) ?_
    (e.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center X)))
    (e.surjective.comp (QuotientGroup.mk'_surjective _)) ?_ w183finA6_real3 w183finA6_real5
    w183finA6_odd')
  · intro z hz
    have := pow_card_eq_one' (G := ↥(Subgroup.center X)) (x := ⟨z, hz⟩)
    rw [hZ] at this
    simpa using congrArg Subtype.val this
  · intro x hx
    have h1 : e (QuotientGroup.mk x) = e 1 := by simpa using hx
    exact (QuotientGroup.eq_one_iff x).1 (e.injective h1)

