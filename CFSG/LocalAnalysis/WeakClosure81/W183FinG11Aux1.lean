theorem w183finAbsIrrOverF4_of_trace {X : Type} [Group X] [Finite X]
    (h : ∀ (n : ℕ) (ρ : X →* Matrix.GeneralLinearGroup (Fin n) Kc), IsIrredRep ρ →
      ∀ g, Matrix.trace (ρ g : Matrix (Fin n) (Fin n) Kc) ^ 4 =
        Matrix.trace (ρ g : Matrix (Fin n) (Fin n) Kc)) : AbsIrrOverF4 X := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hσ : ∀ x : Kc, frobAut 2 Kc x = x ^ 2 := fun x => frobAut_apply x
  have hfin : Finite (fixF (frobAut 2 Kc) 2) := finite_fixF hσ (by norm_num)
  have hcard : Nat.card (fixF (frobAut 2 Kc) 2) = 4 := by
    rw [card_fixF hσ (by norm_num)]; norm_num
  intro n ρ hirr
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · exact ⟨fixF (frobAut 2 Kc) 2, 1, hfin, hcard.le, fun x i j => i.elim0⟩
  · obtain ⟨-, -, -, -, -, e, -, -, -, -, -, hreal, -⟩ :=
      finite_field_galois_descent (p := 2) (Fbar := Kc) hn ρ hirr
    have hle : traceField ρ ≤ fixF (frobAut 2 Kc) 2 := by
      rw [traceField, Subfield.closure_le]
      rintro _ ⟨g, rfl⟩
      rw [SetLike.mem_coe, mem_fixF_iff hσ]
      simpa using h n ρ hirr g
    obtain ⟨P, hP⟩ := (hreal _).2 hle
    exact ⟨fixF (frobAut 2 Kc) 2, P, hfin, hcard.le, hP⟩

private theorem w183finTrace_eq_of_equiv {G V W : Type*} [Group G] [AddCommGroup V]
    [AddCommGroup W] [Module Kc V] [Module Kc W] {σ : Representation Kc G V}
    {τ : Representation Kc G W} (φ : σ.Equiv τ) (g : G) :
    LinearMap.trace Kc W (τ g) = LinearMap.trace Kc V (σ g) := by
  have h : τ g = φ.toLinearEquiv.conj (σ g) := by
    ext w
    simp only [LinearEquiv.conj_apply, LinearMap.coe_comp, LinearEquiv.coe_coe,
      Function.comp_apply]
    have := Representation.IntertwiningMap.isIntertwining _ _ φ.toIntertwiningMap g
      (φ.toLinearEquiv.symm w)
    have h2 : φ.toIntertwiningMap (φ.toLinearEquiv.symm w) = w :=
      φ.toLinearEquiv.apply_symm_apply w
    rw [h2] at this
    exact this.symm
  rw [h, LinearMap.trace_conj']

private noncomputable instance w183finAlgGF4 : Algebra (GaloisField 2 2) Kc :=
  (IsAlgClosed.lift (R := ZMod 2) (S := GaloisField 2 2) (M := Kc)).toRingHom.toAlgebra

private noncomputable instance w183finGf4Fintype : Fintype (GaloisField 2 2) :=
  Fintype.ofFinite _

private theorem w183finGf4_pow_four (u : GaloisField 2 2) : u ^ 4 = u := by
  have h := FiniteField.pow_card u
  have hc : Fintype.card (GaloisField 2 2) = 4 := by
    rw [← Nat.card_eq_fintype_card, GaloisField.card 2 2 (by norm_num)]; norm_num
  rwa [hc] at h

private theorem w183finTrace_tensorRepS_mem {F : Type} [Field F] [CharP F 2] [Finite F]
    (k : Type*) [Field k] [Algebra F k] (A : Finset ℕ) (g : antiSp F) :
    Matrix.trace (tensorRepS (F := F) k A g) ∈ (algebraMap F k).range := by
  unfold Matrix.trace
  refine Subring.sum_mem _ (fun x _ => ?_)
  simp only [Matrix.diag, tensorRepS_apply]
  refine Subring.prod_mem _ (fun i _ => ?_)
  rw [natRepS_apply]
  exact ⟨_, rfl⟩

theorem w183finAbsIrrOverF4_sp44 {M : Type} [Group M] (hM : IsSp4 M 2) : AbsIrrOverF4 M := by
  obtain ⟨φ⟩ := CFSG.EvenSporadicStandard.M22Std.P21H.nonempty_mulEquiv_statedSp44 hM
  let e : antiSp (GaloisField 2 2) ≃* M := (antiSpEquiv (GaloisField 2 2)).trans φ.symm
  haveI : Finite M := Finite.of_equiv (antiSp (GaloisField 2 2)) e.toEquiv
  refine w183finAbsIrrOverF4_of_trace ?_
  intro n ρ hirr g
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [Matrix.trace]
  · let ρ' : antiSp (GaloisField 2 2) →* Matrix.GeneralLinearGroup (Fin n) Kc :=
      ρ.comp e.toMonoidHom
    have hirr' : IsIrredRep ρ' := by
      intro W hW
      refine hirr W (fun x w hw => ?_)
      have := hW (e.symm x) w hw
      simpa [ρ'] using this
    have hσ := isIrreducible_repOf hn hirr'
    have hF : Fintype.card (GaloisField 2 2) = 2 ^ 2 := by
      rw [← Nat.card_eq_fintype_card, GaloisField.card 2 2 (by norm_num)]
    obtain ⟨⟨A, ⟨-, ⟨ψ⟩⟩, -⟩, -⟩ := split_simple_module_production (k := Kc) hF (by norm_num)
      (repOf ρ') hσ
    have h1 : Matrix.trace (ρ g : Matrix (Fin n) (Fin n) Kc) =
        LinearMap.trace Kc _ (repOf ρ' (e.symm g)) := by
      rw [repOf_eq, Matrix.trace_toLin'_eq]
      simp [ρ']
    have h2 : LinearMap.trace Kc _
        (matRep (tensorRepS (F := GaloisField 2 2) Kc A) (e.symm g)) =
        Matrix.trace (tensorRepS (F := GaloisField 2 2) Kc A (e.symm g)) := by
      have : matRep (tensorRepS (F := GaloisField 2 2) Kc A) (e.symm g) =
          Matrix.toLin' (tensorRepS (F := GaloisField 2 2) Kc A (e.symm g)) := by
        ext w
        simp [matRep_apply]
      rw [this, Matrix.trace_toLin'_eq]
    rw [h1, w183finTrace_eq_of_equiv ψ (e.symm g), h2]
    obtain ⟨u, hu⟩ := w183finTrace_tensorRepS_mem (F := GaloisField 2 2) Kc A (e.symm g)
    rw [← hu, ← map_pow, w183finGf4_pow_four]

