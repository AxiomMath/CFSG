private theorem w183finExists_alg_kc (K : Type) [Field K] [Finite K] [CharP K 2] :
    Nonempty (Algebra K Kc) := by
  letI : Algebra (ZMod 2) K := ZMod.algebra K 2
  haveI : Module.Finite (ZMod 2) K := Module.Finite.of_finite
  exact ⟨(IsAlgClosed.lift (R := ZMod 2) (S := K) (M := Kc)).toRingHom.toAlgebra⟩

private theorem w183finFinite_pow_four (K : Type) [Field K] [Fintype K]
    (hK : Fintype.card K = 2 ^ 2) (u : K) : u ^ 4 = u := by
  have h := FiniteField.pow_card u
  rw [hK] at h
  simpa using h

private theorem w183finAbsIrrOverF4_of_sl3 {X : Type} [Group X] [Finite X] (K : Type) [Field K]
    [Fintype K] [CharP K 2] [Algebra K Kc] (hKcard : Fintype.card K = 2 ^ 2)
    (π : SL(3, K) →* X) (hπ : Function.Surjective π) : AbsIrrOverF4 X := by
  refine w183finAbsIrrOverF4_of_trace ?_
  intro n ρ hirr g
  obtain ⟨s, rfl⟩ := hπ g
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [Matrix.trace]
  · let ρ' : SL(3, K) →* Matrix.GeneralLinearGroup (Fin n) Kc := ρ.comp π
    have hirr' : IsIrredRep ρ' := by
      intro W hW
      refine hirr W (fun x w hw => ?_)
      obtain ⟨t, rfl⟩ := hπ x
      have := hW t w hw
      simpa [ρ'] using this
    have hσ := isIrreducible_repOf hn hirr'
    obtain ⟨a, b, ⟨ψ⟩⟩ :=
      squareFiltrationExhaustion 2 K (by norm_num) hKcard Kc (Fin n → Kc) (repOf ρ') hσ
    have h1 : Matrix.trace (ρ (π s) : Matrix (Fin n) (Fin n) Kc) =
        LinearMap.trace Kc _ (repOf ρ' s) := by
      rw [repOf_eq, Matrix.trace_toLin'_eq]
      simp [ρ']
    have h2 : LinearMap.trace Kc _ (matRep (tensorRep (F := K) Kc a b) s) =
        Matrix.trace (tensorRep (F := K) Kc a b s) := by
      have : matRep (tensorRep (F := K) Kc a b) s =
          Matrix.toLin' (tensorRep (F := K) Kc a b s) := by
        ext w
        simp [matRep_apply]
      rw [this, Matrix.trace_toLin'_eq]
    rw [h1, ← w183finTrace_eq_of_equiv ψ s, h2]
    obtain ⟨u, hu⟩ := w183finTrace_tensorRep_mem (F := K) Kc a b s
    rw [← hu, ← map_pow, w183finFinite_pow_four K hKcard u]

theorem w183finAbsIrrOverF4_L3 {X : Type} [Group X]
    (hX : CFSG.LocalAnalysis.UniquenessCase.UC22.IsL3 X 2) : AbsIrrOverF4 X := by
  have hc : StatedClassicalModel X .PSL 3 2 2 :=
    CFSG.Blueprint.LieModel.statedClassicalModel hX (by decide)
  obtain ⟨-, K, _, _, hK, ⟨e⟩⟩ := id hc
  haveI : Fintype K := Fintype.ofFinite K
  have hKcard : Fintype.card K = 2 ^ 2 := by rw [← Nat.card_eq_fintype_card]; exact hK
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : CharP K 2 := charP_of_card_eq_prime_pow (p := 2) (f := 2) hKcard
  obtain ⟨hAlg⟩ := w183finExists_alg_kc K
  letI : Algebra K Kc := hAlg
  let π : SL(3, K) →* X :=
    e.symm.toMonoidHom.comp
      ((QuotientGroup.mk' ((StatedScalars (Fin 3) K).subgroupOf (StatedSL 3 K))).comp
        (specialLinearGroupEquivStatedSL 3 K).toMonoidHom)
  have hπ : Function.Surjective π :=
    e.symm.surjective.comp ((QuotientGroup.mk'_surjective _).comp
      (specialLinearGroupEquivStatedSL 3 K).surjective)
  haveI : Finite X := Finite.of_surjective π hπ
  exact w183finAbsIrrOverF4_of_sl3 K hKcard π hπ

theorem w183finAbsIrrOverF4_cover_L3
    {X : Type} [Group X] (hq : CFSG.Open.IsQuasisimple X)
    (hZ : Nat.card (Subgroup.center X) = 3)
    (hL : CFSG.LocalAnalysis.UniquenessCase.UC22.IsL3 (X ⧸ Subgroup.center X) 2) :
    AbsIrrOverF4 X := by
  have hc : StatedClassicalModel (X ⧸ Subgroup.center X) .PSL 3 2 2 :=
    CFSG.Blueprint.LieModel.statedClassicalModel hL (by decide)
  obtain ⟨-, K, _, _, hK, ⟨e⟩⟩ := id hc
  haveI : Fintype K := Fintype.ofFinite K
  have hKcard : Fintype.card K = 2 ^ 2 := by rw [← Nat.card_eq_fintype_card]; exact hK
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : CharP K 2 := charP_of_card_eq_prime_pow (p := 2) (f := 2) hKcard
  obtain ⟨hAlg⟩ := w183finExists_alg_kc K
  letI : Algebra K Kc := hAlg
  haveI : Finite (X ⧸ Subgroup.center X) := Finite.of_equiv _ e.symm.toEquiv
  haveI : Finite (Subgroup.center X) := Nat.finite_of_card_ne_zero (by omega)
  haveI : Finite X :=
    Finite.of_equiv _ (Subgroup.groupEquivQuotientProdSubgroup (s := Subgroup.center X)).symm
  haveI : Group.IsPerfect X := ⟨hq.1⟩
  have hodd : Odd (Nat.card (Subgroup.center X)) := by rw [hZ]; decide
  have hZne : Subgroup.center X ≠ ⊥ := by
