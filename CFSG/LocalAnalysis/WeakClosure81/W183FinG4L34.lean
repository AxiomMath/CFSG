private theorem w183finL34_congr_conj {A B : Type*} [Group A] [Group B] (θ : A ≃* B) (m : A) :
    MulAut.congr θ (MulAut.conj m) = MulAut.conj (θ m) := by
  ext y
  simp [MulAut.congr_apply, MulAut.conj_apply]

private theorem w183finL34mem_normalizer_map_iff {G H : Type*} [Group G] [Group H]
    (ι : G →* H) (hι : Function.Injective ι) (B : Subgroup G) (g : G) :
    g ∈ Subgroup.normalizer (B : Set G) ↔
      ι g ∈ Subgroup.normalizer (B.map ι : Set H) := by
  constructor
  · intro hg
    exact Subgroup.le_normalizer_map (H := B) ι (Subgroup.mem_map_of_mem ι hg)
  · intro hg
    have hrange : B.map ι ≤ ι.range := Subgroup.map_le_range ι B
    have h := Subgroup.comap_normalizer_eq_of_le_range (f := ι) (H := B.map ι) hrange
    rw [Subgroup.comap_map_eq_self_of_injective hι B] at h
    rw [← h]
    exact hg

theorem exists_embedding_aut {M : Type} [Group M]
    (hM : IsL3 M 2) :
    ∃ ι : MulAut M →* Equiv.Perm (Fin 42), Function.Injective ι ∧ (∀ φ, ι φ ∈ R) ∧
      (innAutOf M).map ι = S := by
  obtain ⟨θ⟩ :=
    CFSG.ComponentClassification.CatFactsSmall.nonempty_equiv_psl34_of_lieModel hM
  have hA : CFSG.Sporadic.SmallOddCore.AutModel S R := CFSG.GH74.GLS.IVK.l34_autModel
  let ι : MulAut M →* Equiv.Perm (Fin 42) := hA.hom.comp (MulAut.congr θ).toMonoidHom
  have hι : Function.Injective ι := hA.hom_injective.comp (MulAut.congr θ).injective
  have hRι : ∀ φ, ι φ ∈ R := fun φ => hA.elt_mem (MulAut.congr θ φ)
  have hconj : ∀ m : M, ι (MulAut.conj m) = (θ m : Equiv.Perm (Fin 42)) := by
    intro m
    show hA.hom (MulAut.congr θ (MulAut.conj m)) = (θ m : Equiv.Perm (Fin 42))
    rw [w183finL34_congr_conj θ m]
    exact hA.elt_eq (S_le_R (θ m).2) (fun p => by simp [MulAut.conj_apply])
  refine ⟨ι, hι, hRι, ?_⟩
  ext x
  constructor
  · rintro ⟨φ, hφ, hφx⟩
    obtain ⟨m, rfl⟩ := hφ
    rw [← hφx, hconj m]
    exact (θ m).2
  · intro hx
    refine ⟨MulAut.conj (θ.symm ⟨x, hx⟩), ⟨θ.symm ⟨x, hx⟩, rfl⟩, ?_⟩
    rw [hconj (θ.symm ⟨x, hx⟩)]
    exact congrArg Subtype.val (θ.apply_symm_apply ⟨x, hx⟩)

theorem br2NormalConj_of_perm {M : Type} [Group M] (ι : MulAut M →* Equiv.Perm (Fin 42))
    (hι : Function.Injective ι) (hS : (innAutOf M).map ι = S) (h : NormalConjPerm) :
    Br2NormalConj M (innAutOf M) := by
  intro P₀ hP₀ A hA hAel h8
  have hP₀' : IsSylowIn 2 (P₀.map ι) S := by
    rw [← hS]
    exact isSylowIn_map ι hι hP₀
  have hA'S : A.map ι ≤ S := by
    rw [← hS]
    exact Subgroup.map_mono hA
  obtain ⟨g, hgS, hg1, hg2⟩ := h (P₀.map ι) hP₀' (A.map ι) hA'S
    (hAel.map ι) (by rw [Subgroup.card_map_of_injective hι]; exact h8)
  have hgS' : g ∈ (innAutOf M).map ι := by rwa [hS]
  obtain ⟨g₀, hg₀, hg₀eq⟩ := Subgroup.mem_map.mp hgS'
  refine ⟨g₀, hg₀, ?_, ?_⟩
  · rw [← Subgroup.map_le_map_iff_of_injective hι]
    rw [show (autConj g₀ A).map ι =
        (A.map ι).map (MulAut.conj (ι g₀)).toMonoidHom from Subgroup.map_map_conj A ι g₀,
      hg₀eq]
    exact hg1
  · intro p hp
    rw [w183finL34mem_normalizer_map_iff ι hι (autConj g₀ A) p]
    rw [show (autConj g₀ A).map ι =
        (A.map ι).map (MulAut.conj (ι g₀)).toMonoidHom from Subgroup.map_map_conj A ι g₀,
      hg₀eq]
    exact hg2 (Subgroup.mem_map_of_mem ι hp)

theorem br2DynkinMoves_of_perm {M : Type} [Group M] (ι : MulAut M →* Equiv.Perm (Fin 42))
    (hι : Function.Injective ι) (hR : ∀ φ, ι φ ∈ R) (hS : (innAutOf M).map ι = S)
    (h : DynkinMovesPerm) : Br2DynkinMoves M (innAutOf M) := by
  intro P₀ hP₀ A hAP hAel h8 hP₀norm τ hτnorm hτdyn
  have hP₀' : IsSylowIn 2 (P₀.map ι) S := by
    rw [← hS]
    exact isSylowIn_map ι hι hP₀
  have hnorm' : P₀.map ι ≤ Subgroup.normalizer (A.map ι : Set (Equiv.Perm (Fin 42))) := by
    intro x hx
    obtain ⟨p, hp, rfl⟩ := Subgroup.mem_map.mp hx
    exact (w183finL34mem_normalizer_map_iff ι hι A p).mp (hP₀norm hp)
  have hτdyn' : ActsOnDynkinMod ⊥ S (ι τ) := by
    have hmap := actsOnDynkinMod_map ι hι hτdyn
    rwa [hS] at hmap
  have hnot := h (P₀.map ι) hP₀' (A.map ι) (Subgroup.map_mono hAP)
    (hAel.map ι) (by rw [Subgroup.card_map_of_injective hι]; exact h8)
    hnorm' (ι τ) (hR τ) ((w183finL34mem_normalizer_map_iff ι hι P₀ τ).mp hτnorm) hτdyn'
  intro hτA
  exact hnot ((w183finL34mem_normalizer_map_iff ι hι A τ).mp hτA)

end W183L34

theorem finG4L34_holds :
    FinG4L34 := by
  intro M _ hM
  obtain ⟨ι, hι, hR, hS⟩ := W183L34.exists_embedding_aut hM
  exact ⟨W183L34.br2NormalConj_of_perm ι hι hS W183L34.normalConjPerm_holds,
    W183L34.br2DynkinMoves_of_perm ι hι hR hS W183L34.dynkinMovesPerm_holds⟩

