@[expose] def span2 (gens : List El) : List El :=
  gens.foldl (fun l g => l ++ l.map fun x => gmulE x g) [oneE]

@[expose] def nodupE : List El → Bool
  | [] => true
  | x :: l => !(memK l x) && nodupE l

@[expose] def commInv (gens : List El) : Bool :=
  gens.all (fun g => g != oneE && gmulE g g == oneE) &&
  gens.all fun g => gens.all fun h => gmulE g h == gmulE h g

@[expose] def checkTree (gensX : List El) (T : List El) (par : List (Nat × Nat)) : Bool :=
  (T.head? == some oneE) && (par.length == T.length) &&
  (((T.drop 1).zip ((par.drop 1).zip (List.range par.length))).all fun q =>
    q.2.1.1 ≤ q.2.2 && gmulE (T.getD q.2.1.1 oneE) (gensX.getD q.2.1.2 oneE) == q.1) &&
  nodupE T &&
  (T.all fun x => gensX.all fun g => memK T (gmulE x g))

@[expose] def checkPV (c : Nat) : Bool :=
  let gR := outerRepGens.getD c []
  let y := outerY.getD c oneE
  let R := span2 gR
  let Ry := R.map (conjE y)
  let gensX := gR ++ gR.map (conjE y)
  let X := outerX.getD c ([], [])
  let k := outerK.getD c (0, 0)
  commInv gR && nodupE R && (R.length == 2 ^ gR.length) &&
  (Ry.any fun s => R.any fun r => !(memK R (conjE s r))) &&
  (R.any fun r => Ry.any fun s => !(memK Ry (conjE r s))) &&
  (R.length == (R.filter fun r => Ry.all fun s => memK Ry (conjE r s)).length * 2 ^ k.1) &&
  (Ry.length == (Ry.filter fun s => R.all fun r => memK R (conjE s r)).length * 2 ^ k.2) &&
  checkTree gensX X.1 X.2 && (X.1.length % 5 != 0) && (X.1.length % 7 != 0)

theorem outer_pv_check_0 : checkPV 0 = true := by
  have hK : checkTree = fun gensX T par => (T.head? == some oneE) && (par.length == T.length) &&
      (((T.drop 1).zip ((par.drop 1).zip (List.range par.length))).all fun q =>
        q.2.1.1 ≤ q.2.2 && gmulE (T.getD q.2.1.1 oneE) (gensX.getD q.2.1.2 oneE) == q.1) &&
      nodupE T && closureK T gensX gmulE outerKeyK := by
    funext gensX T par
    rw [closureK_eq]
    rfl
  unfold checkPV span2 commInv conjE
  rw [hK, gmulE_eq_K, invE_eq_K]
  decide +kernel

