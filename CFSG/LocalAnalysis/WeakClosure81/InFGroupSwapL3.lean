variable {G : Type} [Group G] [Finite G]

private theorem exists_rank2Pkg {L T : Subgroup G} [hLn : L.Normal] (hT : IsSylowIn 2 T ⊤)
    {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ} (hn : 2 ≤ n) (hK : Nat.card K = 2 ^ n)
    (e : ↥L ≃* projectiveSL 3 K) :
    ∃ P : Fin 2 → Subgroup ↥L, Rk2.Rank2Pkg ↥L ((T ⊓ L).subgroupOf L) P := by
  obtain ⟨e', he'⟩ := L3T.exists_equiv_map_eq_U hT e
  set U := (T ⊓ L).subgroupOf L with hUdef
  have hUe : (projUnitriangular 3 K).map e'.symm.toMonoidHom = U := by
    rw [← he', Subgroup.map_map]
    convert Subgroup.map_id U
    ext x
    simp
  have pkg := (Rk2.rank2Pkg_proj3 hK hn).map e'.symm
  rw [show (unitriangular 3 K).map (proj 3 K) = projUnitriangular 3 K from rfl, hUe] at pkg
  exact ⟨_, pkg⟩

theorem inFFor_of_isDiagramNontrivial {L T : Subgroup G} [hLn : L.Normal] (h : AlmostSimple L)
    (hT : IsSylowIn 2 T ⊤) (hLT : L ⊔ T = ⊤) {K : Type} [Field K] [Finite K] [CharP K 2]
    {n : ℕ} (hn : 2 ≤ n) (hK : Nat.card K = 2 ^ n) (e : ↥L ≃* projectiveSL 3 K)
    (htw : E2.IsDiagramNontrivial T L (T ⊓ L)) :
    CFSG.LocalAnalysis.UniquenessCase.UC22.F12.InFFor n (⊤ : Subgroup G) T := by
  classical
  intro Ω hΩ hne hbot
  have hΩ' : IsOmegaColl Ω := isOmegaColl_of_isInvColl_top hΩ hne hbot
  obtain ⟨P, pkg⟩ := exists_rank2Pkg hT hn hK e
  obtain ⟨A, hAΩ, hAT⟩ := exists_mem_le_of_isSylowOf
    (CFSG.ABGLocalTools.isSylowOf_iff.mpr hT) hΩ hne
  have hA : IsElemAbelian 2 A := hΩ'.elemAbelian A hAΩ
  have hmem : ∀ X : Subgroup G, InCalEi n T A X → X ≤ eGenP n ⊤ T Ω := fun X hX =>
    le_iSup₂_of_le A hAΩ (le_iSup_of_le hAT (le_iSup₂_of_le X (isEP_of_inCalEi hAT hA hX) le_rfl))
  have htop : eGenP n ⊤ T Ω ⊔ T = ⊤ := by
    by_cases hc : Nat.card A ≤ 2 ^ n
    ·
      have hQ : InCalEi n T A ⊤ := inCalEi_top_of_almostSimple h hT (hΩ'.ne_bot A hAΩ)
        (mQuot_pCoreOf_top_le_of_card_le h (CFSG.Quasithin.B2F.isPGroup_of_isElemAbelian hA) hc)
      exact top_le_iff.mp ((hmem ⊤ hQ).trans le_sup_left)
    ·
      push Not at hc
      obtain ⟨e', he'⟩ := L3T.exists_equiv_map_eq_U hT e
      obtain ⟨X, hXL, hXs, hX⟩ :
          ∃ X : Subgroup G, X ≤ L ∧ ¬ Group.IsSolvable ↥X ∧ InCalEi n T A (X ⊔ tA T A) := by
        by_cases hsemi : ∀ t ∈ T, (∀ a ∈ A, t * a = a * t) →
            actHom e' t ∈ semilinearAutGroup 3 K
        · exact inCalEi_of_semilinear h hT hn hK e' he' hAT hA hc hsemi
        · push Not at hsemi
          obtain ⟨t, htT, htA, htE⟩ := hsemi
          exact inCalEi_of_twisted h hT hn hK e' he' hAT hA hc htT htA htE
      refine eq_top_of_not_isSolvable_of_isDiagramNontrivial hT hLT pkg.res pkg.norm htw
        le_sup_right fun hs => hXs ?_
      have hXle : X ≤ (eGenP n ⊤ T Ω ⊔ T) ⊓ L :=
        le_inf ((le_sup_left.trans (hmem _ hX)).trans le_sup_left) hXL
      exact Group.isSolvable_of_isSolvable_injective (Subgroup.inclusion_injective hXle)
  rw [← Subgroup.coe_mul_of_right_le_normalizer_left (eGenP n ⊤ T Ω) T
    (le_normalizer_eGenP n hΩ), htop]

private theorem exists_pair {L T : Subgroup G} [hLn : L.Normal] (hT : IsSylowIn 2 T ⊤)
    {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ} (hn : 2 ≤ n) (hK : Nat.card K = 2 ^ n)
    (e : ↥L ≃* projectiveSL 3 K) :
    ∃ P₀ P₁ : Subgroup G, ∀ P : Subgroup G,
      IsMaxParabolicOver L (T ⊓ L) P → P = P₀ ∨ P = P₁ := by
  obtain ⟨P, pkg⟩ := exists_rank2Pkg hT hn hK e
  obtain ⟨-, -, hmax, -⟩ := pkg.res
  refine ⟨(P 0).map L.subtype, (P 1).map L.subtype, fun M hM => ?_⟩
  obtain ⟨hML, hBM, hMne, hMmax⟩ := hM
  have hUM : (T ⊓ L).subgroupOf L ≤ M.subgroupOf L := fun x hx => by
    rw [Subgroup.mem_subgroupOf] at hx ⊢
    exact hBM ⟨hx.2, Subgroup.le_normalizer hx⟩
  have hcoat : IsCoatom (M.subgroupOf L) := by
    refine ⟨fun htop => hMne (le_antisymm hML (Subgroup.subgroupOf_eq_top.mp htop)),
      fun N hN => ?_⟩
    have hMN : M ≤ N.map L.subtype := fun m hm =>
      ⟨⟨m, hML hm⟩, hN.le (Subgroup.mem_subgroupOf.mpr hm), rfl⟩
    rcases hMmax _ hMN (Subgroup.map_subtype_le N) with hEq | hEq
    · exfalso
      refine hN.ne ?_
      rw [← Subgroup.comap_map_eq_self_of_injective L.subtype_injective N, hEq]
      rfl
    · rw [← Subgroup.comap_map_eq_self_of_injective L.subtype_injective N, hEq]
      exact Subgroup.subgroupOf_self L
  obtain ⟨j, hj⟩ := (hmax _ hUM).mp hcoat.covBy_top
  have hMeq : M = (P j).map L.subtype := by
    rw [← hj, Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hML]
  fin_cases j
  · exact Or.inl hMeq
  · exact Or.inr hMeq

theorem inF_top_of_swapsParabolics {L T : Subgroup G} {n : ℕ}
    (hF : CFSG.LocalAnalysis.UniquenessCase.UC22.Fstar (⊤ : Subgroup G) = L)
    (hsimple : IsSimpleGroup ↥L) (hL3 : CFSG.LocalAnalysis.UniquenessCase.UC22.IsL3 ↥L n)
    (hn : 2 ≤ n) (hT : IsSylowIn 2 T ⊤) (hLT : L ⊔ T = ⊤) (hsw : SwapsParabolics T L) :
    CFSG.LocalAnalysis.UniquenessCase.UC22.F12.InF n (⊤ : Subgroup G) := by
  have hL : L.Normal := SwapSp4.normal_of_fstar_eq hF
  obtain ⟨⟨-, hn1, -⟩, K, _, _, hK, ⟨e₀⟩⟩ :=
    CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by norm_num : (3 : ℕ) ≠ 0) hL3
  have : CharP K 2 := finite_field_prime_power_characteristic Nat.prime_two hn1 hK
  set e := e₀.trans (Setup.X7a.statedSLEquivProjectiveSL 3 K) with he
  have hnab : ∃ x y : ↥L, x * y ≠ y * x := by
    refine ⟨e.symm (xP 1), e.symm (yP 1), fun hc => ?_⟩
    have h1 : xP (1 : K) * yP 1 = yP 1 * xP 1 := by simpa using congrArg e hc
    have h3 : ⁅xP (1 : K), yP (1 : K)⁆ = 1 := by
      rw [commutatorElement_def, h1]
      group
    rw [commutatorElement_xP_yP, mul_one, wP_eq_one_iff] at h3
    exact one_ne_zero h3
  have hC := SwapSp4.centralizer_eq_bot_of_fstar_eq hF hsimple hnab
  have h : AlmostSimple L := almostSimple_of_normal_simple_sup_sylow hL hsimple hnab hC hT hLT
  have hTN : T ≤ Subgroup.normalizer (L : Set G) := by
    rw [Subgroup.normalizer_eq_top_iff.mpr hL]
    exact le_top
  have hU : IsSylowTwoOf (T ⊓ L) L :=
    B6.isSylowTwoOf_inf_normal (⟨hT.1, hT.2.1, hT.2.2⟩ : IsSylowTwoOf T ⊤) le_top
      (by rw [Subgroup.normalizer_eq_top_iff.mpr hL])
  have htw := isDiagramNontrivial_of_swapsParabolics hTN hU (exists_pair hT hn hK e) hsw
  exact CFSG.LocalAnalysis.UniquenessCase.UC22.F12.inF_top_of_inFFor hT
    (inFFor_of_isDiagramNontrivial h hT hLT hn hK e htw)

