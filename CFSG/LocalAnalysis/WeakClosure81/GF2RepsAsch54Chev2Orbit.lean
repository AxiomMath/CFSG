variable {Q : Type} [Group Q] [Finite Q] {L T M : Subgroup Q} {K : Type} [Group K] [Finite K]
  {D : UniversalRootDatum K} {n : Fin D.rank → K} {H : Fin D.rank → Subgroup K}
  {π : K →* ↥L} {e : ℕ}

@[expose] def actHomRangeOfMem {R : Subgroup Q} (hRN : R ≤ Subgroup.normalizer (L : Set Q))
    {t : Q} (ht : t ∈ R) : ↥(actHom hRN).range :=
  ⟨actHom hRN ⟨t, ht⟩, ⟨⟨t, ht⟩, rfl⟩⟩

theorem map_parJ_subtype_conj (h : BorelQuotient D n H π e) {R : Subgroup Q}
    (hRN : R ≤ Subgroup.normalizer (L : Set Q))
    (h𝒜 : ∀ α ∈ (actHom hRN).range,
      ((posUnipotent D).map π).map α.toMonoidHom = (posUnipotent D).map π)
    {t : Q} (ht : t ∈ R) (j : Fin D.rank) :
    (((parJ D H {j}).map π).map L.subtype).map (MulAut.conj t).toMonoidHom =
      (((parJ D H {nodeHom h (actHom hRN).range h𝒜 (actHomRangeOfMem hRN ht) j}).map π).map
        L.subtype) := by
  let a : ↥(actHom hRN).range := actHomRangeOfMem hRN ht
  have h1 : ((parJ D H {j}).map π).map a.1.toMonoidHom =
      (parJ D H {nodeHom h (actHom hRN).range h𝒜 a j}).map π :=
    map_parJ_singleton_nodeHom h (actHom hRN).range h𝒜 a j
  have h2 : B6.conjSub t (((parJ D H {j}).map π).map L.subtype) =
      ((parJ D H {nodeHom h (actHom hRN).range h𝒜 a j}).map π).map L.subtype := by
    rw [← map_map_subtype_eq_conjSub a.1 (fun x => coe_actHom hRN ⟨t, ht⟩ x)
      ((parJ D H {j}).map π)]
    exact congrArg (Subgroup.map L.subtype) h1
  simpa [B6.conjSub, a] using h2

theorem image_nodeOrbit_compl (h : BorelQuotient D n H π e) (𝒜 : Subgroup (MulAut ↥L))
    (h𝒜 : ∀ α ∈ 𝒜, ((posUnipotent D).map π).map α.toMonoidHom = (posUnipotent D).map π)
    (i : Fin D.rank) (a : ↥𝒜) :
    nodePerm h a.1 (h𝒜 a.1 a.2) '' (nodeOrbit h 𝒜 h𝒜 i)ᶜ = (nodeOrbit h 𝒜 h𝒜 i)ᶜ := by
  have himage : nodePerm h a.1 (h𝒜 a.1 a.2) '' nodeOrbit h 𝒜 h𝒜 i =
      nodeOrbit h 𝒜 h𝒜 i := image_orbitSet h 𝒜 h𝒜 i a
  ext j
  constructor
  · rintro ⟨k, hk, rfl⟩ hkj
    apply hk
    have hmem : nodePerm h a.1 (h𝒜 a.1 a.2) k ∈
        nodePerm h a.1 (h𝒜 a.1 a.2) '' nodeOrbit h 𝒜 h𝒜 i := by
      rw [himage]
      exact hkj
    obtain ⟨m, hm, hme⟩ := hmem
    exact (nodePerm h a.1 (h𝒜 a.1 a.2)).injective hme ▸ hm
  · intro hj
    refine ⟨(nodePerm h a.1 (h𝒜 a.1 a.2)).symm j, ?_, ?_⟩
    · intro hkO
      have : j ∈ nodePerm h a.1 (h𝒜 a.1 a.2) '' nodeOrbit h 𝒜 h𝒜 i :=
        ⟨(nodePerm h a.1 (h𝒜 a.1 a.2)).symm j, hkO, by simp⟩
      rw [himage] at this
      exact hj this
    · simp

theorem map_parJ_orbit_subtype_conj (h : BorelQuotient D n H π e) {R : Subgroup Q}
    (hRN : R ≤ Subgroup.normalizer (L : Set Q))
    (h𝒜 : ∀ α ∈ (actHom hRN).range,
      ((posUnipotent D).map π).map α.toMonoidHom = (posUnipotent D).map π)
    {t : Q} (ht : t ∈ R) (i : Fin D.rank) :
    (((parJ D H (nodeOrbit h (actHom hRN).range h𝒜 i)).map π).map L.subtype).map
        (MulAut.conj t).toMonoidHom =
      (((parJ D H (nodeOrbit h (actHom hRN).range h𝒜 i)).map π).map L.subtype) := by
  let a : ↥(actHom hRN).range := actHomRangeOfMem hRN ht
  have h1 : ((parJ D H (nodeOrbit h (actHom hRN).range h𝒜 i)).map π).map a.1.toMonoidHom =
      (parJ D H (nodePerm h a.1 (h𝒜 a.1 a.2) '' nodeOrbit h (actHom hRN).range h𝒜 i)).map π :=
    map_parJ_nodePerm h a.1 (h𝒜 a.1 a.2) (nodeOrbit h (actHom hRN).range h𝒜 i)
  have himage : nodePerm h a.1 (h𝒜 a.1 a.2) '' nodeOrbit h (actHom hRN).range h𝒜 i =
      nodeOrbit h (actHom hRN).range h𝒜 i := image_orbitSet h (actHom hRN).range h𝒜 i a
  rw [himage] at h1
  have h2 : B6.conjSub t
      (((parJ D H (nodeOrbit h (actHom hRN).range h𝒜 i)).map π).map L.subtype) =
      (((parJ D H (nodeOrbit h (actHom hRN).range h𝒜 i)).map π).map L.subtype) := by
    rw [← map_map_subtype_eq_conjSub a.1 (fun x => coe_actHom hRN ⟨t, ht⟩ x)
      ((parJ D H (nodeOrbit h (actHom hRN).range h𝒜 i)).map π)]
    exact congrArg (Subgroup.map L.subtype) h1
  simpa [B6.conjSub, a] using h2

theorem map_parJ_compl_subtype_conj (h : BorelQuotient D n H π e) {R : Subgroup Q}
    (hRN : R ≤ Subgroup.normalizer (L : Set Q))
    (h𝒜 : ∀ α ∈ (actHom hRN).range,
      ((posUnipotent D).map π).map α.toMonoidHom = (posUnipotent D).map π)
    {t : Q} (ht : t ∈ R) (i : Fin D.rank) :
    (((parJ D H (nodeOrbit h (actHom hRN).range h𝒜 i)ᶜ).map π).map L.subtype).map
        (MulAut.conj t).toMonoidHom =
      (((parJ D H (nodeOrbit h (actHom hRN).range h𝒜 i)ᶜ).map π).map L.subtype) := by
  let a : ↥(actHom hRN).range := actHomRangeOfMem hRN ht
  have h1 : ((parJ D H (nodeOrbit h (actHom hRN).range h𝒜 i)ᶜ).map π).map
        a.1.toMonoidHom =
      (parJ D H (nodePerm h a.1 (h𝒜 a.1 a.2) ''
        (nodeOrbit h (actHom hRN).range h𝒜 i)ᶜ)).map π :=
    map_parJ_nodePerm h a.1 (h𝒜 a.1 a.2) (nodeOrbit h (actHom hRN).range h𝒜 i)ᶜ
  have himage : nodePerm h a.1 (h𝒜 a.1 a.2) ''
      (nodeOrbit h (actHom hRN).range h𝒜 i)ᶜ =
      (nodeOrbit h (actHom hRN).range h𝒜 i)ᶜ :=
    image_nodeOrbit_compl h (actHom hRN).range h𝒜 i a
  rw [himage] at h1
  have h2 : B6.conjSub t
      (((parJ D H (nodeOrbit h (actHom hRN).range h𝒜 i)ᶜ).map π).map L.subtype) =
      (((parJ D H (nodeOrbit h (actHom hRN).range h𝒜 i)ᶜ).map π).map L.subtype) := by
    rw [← map_map_subtype_eq_conjSub a.1 (fun x => coe_actHom hRN ⟨t, ht⟩ x)
      ((parJ D H (nodeOrbit h (actHom hRN).range h𝒜 i)ᶜ).map π)]
    exact congrArg (Subgroup.map L.subtype) h1
  simpa [B6.conjSub, a] using h2

omit [Finite Q] [Finite K] in
theorem iSup_map_rankOne_subtype_eq (h : BorelQuotient D n H π e) :
    (⨆ k, ((rankOne D.rootGroup k).map π).map L.subtype) = L := by
  rw [← Subgroup.map_iSup, ← Subgroup.map_iSup, iSup_rankOne_eq_top h.ct h.extras,
    Subgroup.map_top_of_surjective π h.surj, Subgroup.map_top, Subgroup.range_subtype]

theorem mem_of_map_parJ_map_subtype_eq_top (h : BorelQuotient D n H π e)
    {J : Set (Fin D.rank)} (hJ : J.Nonempty) {k : Fin D.rank}
    (htop : ((parJ D H J).map π).map L.subtype = L) : k ∈ J := by
  have hPtop : (parJ D H J).map π = ⊤ := by
    apply Subgroup.map_injective (f := L.subtype) L.subtype_injective
    rw [htop, Subgroup.map_top, Subgroup.range_subtype]
  rw [map_parJ_eq_sup] at hPtop
  have hB : (borel D H).map π ≤ ⨆ j ∈ J, (parJ D H {j}).map π := by
    obtain ⟨j0, hj0⟩ := hJ
    refine (Subgroup.map_mono (borel_le_parJ (J := {j0}))).trans ?_
    exact le_iSup₂_of_le j0 hj0 le_rfl
  have hjoin : (⨆ j ∈ J, (parJ D H {j}).map π) = ⊤ := by
    rw [← hPtop, sup_eq_right.2 hB]
  have hle : pElementSubgroup 2 ((parJ D H {k}).map π) ≤
      ⨆ j ∈ J, (parJ D H {j}).map π := by
    rw [hjoin]
    exact le_top
  exact sub_of_borelQuotient h J k hle

omit [Finite Q] [Finite K] in
theorem map_parJ_map_subtype_sup_compl_eq_top (h : BorelQuotient D n H π e)
    (J : Set (Fin D.rank)) :
    ((parJ D H J).map π).map L.subtype ⊔ ((parJ D H Jᶜ).map π).map L.subtype = L := by
  have hgen : (⨆ k, ((rankOne D.rootGroup k).map π).map L.subtype) = L :=
    iSup_map_rankOne_subtype_eq h
  apply le_antisymm
  · exact sup_le (Subgroup.map_subtype_le _) (Subgroup.map_subtype_le _)
  · calc L = (⨆ k, ((rankOne D.rootGroup k).map π).map L.subtype) := hgen.symm
      _ ≤ ((parJ D H J).map π).map L.subtype ⊔ ((parJ D H Jᶜ).map π).map L.subtype := by
        refine iSup_le fun k => ?_
        by_cases hk : k ∈ J
        · exact le_sup_of_le_left
            (Subgroup.map_mono (Subgroup.map_mono (rankOne_le_parJ hk)))
        · exact le_sup_of_le_right
            (Subgroup.map_mono (Subgroup.map_mono (rankOne_le_parJ (by simpa using hk))))

theorem nodeHom_eq_of_map_parJ_subtype_conj (h : BorelQuotient D n H π e)
    {R : Subgroup Q} (hRN : R ≤ Subgroup.normalizer (L : Set Q))
    (h𝒜 : ∀ α ∈ (actHom hRN).range,
      ((posUnipotent D).map π).map α.toMonoidHom = (posUnipotent D).map π)
    {t : Q} (ht : t ∈ R) {i j : Fin D.rank}
    (hconj : (((parJ D H {i}).map π).map L.subtype).map (MulAut.conj t).toMonoidHom =
      ((parJ D H {j}).map π).map L.subtype) :
    nodeHom h (actHom hRN).range h𝒜 (actHomRangeOfMem hRN ht) i = j := by
  have hperm : nodePerm h (actHomRangeOfMem hRN ht).1
      (h𝒜 (actHomRangeOfMem hRN ht).1 (actHomRangeOfMem hRN ht).2) i = j := by
    rw [nodePerm_eq_iff]
    apply Subgroup.map_injective L.subtype_injective
    rw [map_map_subtype_eq_conjSub (actHomRangeOfMem hRN ht).1
      (fun x => coe_actHom hRN ⟨t, ht⟩ x) ((parJ D H {i}).map π)]
    simpa [B6.conjSub] using hconj
  simpa [nodeHom_apply] using hperm

theorem card_parJ_eq_card_map_mul_ker (h : BorelQuotient D n H π e)
    (J : Set (Fin D.rank)) : Nat.card ↥(parJ D H J) =
      Nat.card ↥((parJ D H J).map π) * Nat.card ↥π.ker := by
  have h1 := Subgroup.relIndex_mul_card (H := π.ker) (K := parJ D H J)
  rw [Subgroup.relIndex_ker, inf_eq_left.2 (ker_le_parJ h J)] at h1
  exact h1.symm

omit [Finite Q] in
theorem inf_normalizer_eq_map_borel (h : BorelQuotient D n H π e) {S : Subgroup Q}
    (hSL : S ≤ L) (hS : S.subgroupOf L = (posUnipotent D).map π) :
    L ⊓ Subgroup.normalizer (S : Set Q) = ((borel D H).map π).map L.subtype := by
  have hsub : (L ⊓ Subgroup.normalizer (S : Set Q)).subgroupOf L =
      (Subgroup.normalizer (S : Set Q)).subgroupOf L := by
    ext x
    simp [Subgroup.mem_subgroupOf]
  have h1 : (L ⊓ Subgroup.normalizer (S : Set Q)).subgroupOf L = (borel D H).map π := by
    rw [hsub, Subgroup.subgroupOf_normalizer_eq (H := S) (N := L) hSL, hS,
      h.normalizer_map_posUnipotent]
  calc L ⊓ Subgroup.normalizer (S : Set Q)
      = ((L ⊓ Subgroup.normalizer (S : Set Q)).subgroupOf L).map L.subtype :=
        (Subgroup.map_subgroupOf_eq_of_le
          (H := L ⊓ Subgroup.normalizer (S : Set Q)) inf_le_left).symm
    _ = ((borel D H).map π).map L.subtype := by rw [h1]

omit [Finite Q] in
theorem isSolvable_map_borel_subtype (h : BorelQuotient D n H π e) :
    Group.IsSolvable ↥(((borel D H).map π).map L.subtype) := by
  have hP2 : IsPGroup 2 ↥(posUnipotent D) := isPGroup_iSup_pos h.extras h.pGroup
  have hSolU : Group.IsSolvable ↥(posUnipotent D) :=
    @IsNilpotent.to_isSolvable ↥(posUnipotent D) _ hP2.isNilpotent
  have hBsol : Group.IsSolvable ↥(borel D H) :=
    CFSG.LieType.TitsSimplicity.isSolvable_borel h.ct h.extras hSolU
  have h1 : Group.IsSolvable ↥((borel D H).map π) := by
    let f : ↥(borel D H) →* ↥((borel D H).map π) :=
      (π.comp (borel D H).subtype).codRestrict _ (fun x => ⟨x.1, x.2, rfl⟩)
    have hf : Function.Surjective f := by
      intro y
      obtain ⟨b, hb, hby⟩ := y.2
      exact ⟨⟨b, hb⟩, Subtype.ext hby⟩
    exact Group.isSolvable_of_surjective (f := f) hf
  exact Group.isSolvable_of_surjective
    (f := (Subgroup.equivMapOfInjective ((borel D H).map π) L.subtype
      L.subtype_injective).toMonoidHom)
    (Subgroup.equivMapOfInjective ((borel D H).map π) L.subtype L.subtype_injective).surjective

theorem rank_le_two_of_nodeTransitive (hbq : BorelQuotient D n H π e) (hLn : L.Normal)
    (hLs : IsSimpleGroup ↥L) (hnab : ∃ a b : ↥L, a * b ≠ b * a) (hT2 : IsPGroup 2 ↥T)
    (hunip : (T ⊓ L).subgroupOf L = (posUnipotent D).map π)
    (htr : NodeTransitive L T D H π) : D.rank ≤ 2 := by
  classical
  by_contra hrank
  push Not at hrank
  have hRN : T ≤ Subgroup.normalizer (L : Set Q) :=
    @Subgroup.le_normalizer_of_normal Q _ L T hLn
  let 𝒜 : Subgroup (MulAut ↥L) := (actHom hRN).range
  have h𝒜 : ∀ α ∈ 𝒜, ((posUnipotent D).map π).map α.toMonoidHom = (posUnipotent D).map π :=
    range_actHom_fix hRN hunip
  have h𝒜2 : IsPGroup 2 ↥𝒜 :=
    hT2.of_surjective (actHom hRN).rangeRestrict
      (actHom hRN).rangeRestrict_surjective
  have hT : (TauCeti.diagramGraph D.cartan).IsTree :=
    @CFSG.AGLEmbeddingD2.Tits.GN516.Conn.diagram_isTree K ↥L _ _ _ D n H π e hbq
      hLs hnab
  let act : MulAction ↥𝒜 (Fin D.rank) :=
    { smul := fun a x => nodeHom hbq 𝒜 h𝒜 a x
      one_smul := fun x => by
        change nodeHom hbq 𝒜 h𝒜 1 x = x
        rw [map_one]
        rfl
      mul_smul := fun a b x => by
        change nodeHom hbq 𝒜 h𝒜 (a * b) x =
          nodeHom hbq 𝒜 h𝒜 a (nodeHom hbq 𝒜 h𝒜 b x)
        rw [map_mul]
        rfl }
  have hadj : ∀ (a : ↥𝒜) (u v : Fin D.rank),
      (TauCeti.diagramGraph D.cartan).Adj (act.smul a u) (act.smul a v) ↔
        (TauCeti.diagramGraph D.cartan).Adj u v :=
    fun a u v =>
      CFSG.AGLEmbeddingD2.Tits.GN516.Core.nodePerm_adj_iff hbq a.1 (h𝒜 a.1 a.2) u v
  have hxlt : 0 < D.rank := by omega
  have hylt : 1 < D.rank := by omega
  let x : Fin D.rank := ⟨0, hxlt⟩
  let y : Fin D.rank := ⟨1, hylt⟩
  have hxyne : y ≠ x := by
    intro h
    have := congrArg Fin.val h
    simp [x, y] at this
  obtain ⟨w⟩ := hT.connected.preconnected x y
  have hwpos : 0 < w.length := by
    by_contra h
    have h0 : w.length = 0 := Nat.eq_zero_of_not_pos h
    have hxy : x = y := by
      have h1 : w.getVert 0 = w.getVert w.length := by rw [h0]
      rwa [w.getVert_zero, w.getVert_length] at h1
    exact hxyne hxy.symm
  have hxy : (TauCeti.diagramGraph D.cartan).Adj x (w.getVert 1) := by
    have := w.adj_getVert_succ (i := 0) hwpos
    rwa [w.getVert_zero] at this
  have hyorbit : ∃ a : ↥𝒜, act.smul a x = w.getVert 1 := by
    obtain ⟨t, ht, hconj⟩ := htr x (w.getVert 1)
    refine ⟨actHomRangeOfMem hRN ht, ?_⟩
    exact nodeHom_eq_of_map_parJ_subtype_conj hbq hRN h𝒜 ht hconj
  have horb : ∀ a : ↥𝒜, act.smul a x = x ∨ act.smul a x = w.getVert 1 := fun a =>
    @CFSG.AGLEmbeddingD2.Tits.GN516.Tree.orbit_subset_of_adj (Fin D.rank) _ _
      (TauCeti.diagramGraph D.cartan) _ hT (↥𝒜) _ _ act h𝒜2 hadj x (w.getVert 1) hxy
      hyorbit a
  have hcover : ∀ t : Fin D.rank, t = x ∨ t = w.getVert 1 := by
    intro t
    obtain ⟨r, hr, hconj⟩ := htr x t
    let a : ↥𝒜 := actHomRangeOfMem hRN hr
    have haz : act.smul a x = t := by
      exact nodeHom_eq_of_map_parJ_subtype_conj hbq hRN h𝒜 hr hconj
    rcases horb a with h | h
    · exact Or.inl (haz.symm.trans h)
    · exact Or.inr (haz.symm.trans h)
  have hsub : (Set.univ : Set (Fin D.rank)) ⊆ {x, w.getVert 1} := fun t _ => hcover t
  have hcard := Set.ncard_le_ncard hsub
  rw [Set.ncard_univ, Nat.card_fin, Set.ncard_pair hxy.ne] at hcard
  omega

theorem card_rootGroup_eq_of_nodeTransitive (hbq : BorelQuotient D n H π e)
    (htr : NodeTransitive L T D H π) (i j : Fin D.rank) :
    Nat.card ↥(D.rootGroup (Pi.single i 1)) = Nat.card ↥(D.rootGroup (Pi.single j 1)) := by
  obtain ⟨t, -, hconj⟩ := htr i j
  have hcardX : Nat.card ↥(((parJ D H {i}).map π).map L.subtype) =
      Nat.card ↥(((parJ D H {j}).map π).map L.subtype) := by
    rw [← hconj]
    exact (Subgroup.card_map_of_injective (MulAut.conj t).injective).symm
  have hcardPi : Nat.card ↥((parJ D H {i}).map π) =
      Nat.card ↥(((parJ D H {i}).map π).map L.subtype) :=
    (Subgroup.card_map_of_injective L.subtype_injective).symm
  have hcardPj : Nat.card ↥((parJ D H {j}).map π) =
      Nat.card ↥(((parJ D H {j}).map π).map L.subtype) :=
    (Subgroup.card_map_of_injective L.subtype_injective).symm
  have hcardP : Nat.card ↥(parJ D H {i}) = Nat.card ↥(parJ D H {j}) := by
    rw [card_parJ_eq_card_map_mul_ker hbq {i}, card_parJ_eq_card_map_mul_ker hbq {j}]
    congr 1
    exact hcardPi.trans (hcardX.trans hcardPj.symm)
  have hi := CFSG.AGLEmbeddingD2.Tits.GN516.CardPar.card_parJ_singleton hbq.ct hbq.extras i
  have hj := CFSG.AGLEmbeddingD2.Tits.GN516.CardPar.card_parJ_singleton hbq.ct hbq.extras j
  rw [hi, hj] at hcardP
  have hB : 0 < Nat.card ↥(borel D H) := Nat.card_pos
  have hEq := Nat.eq_of_mul_eq_mul_left hB hcardP
  omega

theorem degree_nodePerm (hbq : BorelQuotient D n H π e) (α : MulAut ↥L)
    (hα : ((posUnipotent D).map π).map α.toMonoidHom = (posUnipotent D).map π) (j : Fin D.rank) :
    (TauCeti.diagramGraph D.cartan).degree (nodePerm hbq α hα j) =
      (TauCeti.diagramGraph D.cartan).degree j := by
  let f : TauCeti.diagramGraph D.cartan ≃g TauCeti.diagramGraph D.cartan :=
    { toEquiv := nodePerm hbq α hα
      map_rel_iff' := fun {a b} =>
        CFSG.AGLEmbeddingD2.Tits.GN516.Core.nodePerm_adj_iff hbq α hα a b }
  exact f.degree_eq j

theorem card_rootGroup_eq_of_nodePerm (hbq : BorelQuotient D n H π e) (α : MulAut ↥L)
    (hα : ((posUnipotent D).map π).map α.toMonoidHom = (posUnipotent D).map π) (j : Fin D.rank) :
    Nat.card ↥(D.rootGroup (Pi.single (nodePerm hbq α hα j) 1)) =
      Nat.card ↥(D.rootGroup (Pi.single j 1)) := by
  have hP : Nat.card ↥(parJ D H {nodePerm hbq α hα j}) = Nat.card ↥(parJ D H {j}) :=
    CFSG.AGLEmbeddingD2.Tits.GN516.Core.card_parJ_nodePerm hbq α hα j
  have hi :=
    CFSG.AGLEmbeddingD2.Tits.GN516.CardPar.card_parJ_singleton hbq.ct hbq.extras
      (nodePerm hbq α hα j)
  have hj := CFSG.AGLEmbeddingD2.Tits.GN516.CardPar.card_parJ_singleton hbq.ct hbq.extras j
  rw [hi, hj] at hP
  have hB : 0 < Nat.card ↥(borel D H) := Nat.card_pos
  have hEq := Nat.eq_of_mul_eq_mul_left hB hP
  omega

theorem exists_swap_of_nodeTransitive (hbq : BorelQuotient D n H π e)
    (hunip : (T ⊓ L).subgroupOf L = (posUnipotent D).map π)
    (htr : NodeTransitive L T D H π) (hr : D.rank = 2) :
    ∃ t ∈ T, ∃ P : Subgroup Q, P < L ∧ (∀ Y : Subgroup Q, P < Y → Y ≤ L → Y = L) ∧
      L ⊓ normalizer ((T ⊓ L : Subgroup Q) : Set Q) ≤ P ∧
      P.map (MulAut.conj t).toMonoidHom ≠ P := by
  classical
  have hilt : 0 < D.rank := by omega
  have hjlt : 1 < D.rank := by omega
  let i : Fin D.rank := ⟨0, hilt⟩
  let j : Fin D.rank := ⟨1, hjlt⟩
  have hij : i ≠ j := by
    intro h
    have := congrArg Fin.val h
    simp [i, j] at this
  obtain ⟨t, ht, hconj⟩ := htr i j
  have hXiLt : ((parJ D H {i}).map π).map L.subtype < L := by
    refine lt_of_le_of_ne (Subgroup.map_subtype_le _) ?_
    intro htop
    have hjmem : j ∈ ({i} : Set (Fin D.rank)) :=
      mem_of_map_parJ_map_subtype_eq_top (h := hbq) (J := {i}) (hJ := ⟨i, rfl⟩)
        (k := j) htop
    have hji : j = i := by simpa using hjmem
    exact hij hji.symm
  obtain ⟨P, hPX, hXiP, hPmax⟩ := Finite.exists_le_maximal
    (p := fun Y : Subgroup Q => ((parJ D H {i}).map π).map L.subtype ≤ Y ∧ Y < L)
    (a := ((parJ D H {i}).map π).map L.subtype) ⟨le_rfl, hXiLt⟩
  have hPL : P < L := hXiP.2
  have hmax : ∀ Y : Subgroup Q, P < Y → Y ≤ L → Y = L := by
    intro Y hPY hYL
    by_contra hY
    have hYlt : Y < L := lt_of_le_of_ne hYL hY
    exact hPY.not_ge (hPmax ⟨hPX.trans hPY.le, hYlt⟩ hPY.le)
  have hN : L ⊓ normalizer ((T ⊓ L : Subgroup Q) : Set Q) ≤ P := by
    rw [inf_normalizer_eq_map_borel hbq inf_le_right hunip]
    exact (Subgroup.map_mono (Subgroup.map_mono (borel_le_parJ (J := {i})))).trans hPX
  have hsup : ((parJ D H {i}).map π).map L.subtype ⊔
      ((parJ D H {j}).map π).map L.subtype = L := by
    have hgen := iSup_map_rankOne_subtype_eq hbq
    apply le_antisymm
    · exact sup_le (Subgroup.map_subtype_le _) (Subgroup.map_subtype_le _)
    · calc L = (⨆ k, ((rankOne D.rootGroup k).map π).map L.subtype) := hgen.symm
        _ ≤ ((parJ D H {i}).map π).map L.subtype ⊔
            ((parJ D H {j}).map π).map L.subtype := by
          refine iSup_le fun k => ?_
          have hk : k = i ∨ k = j := by
            have hkv := k.isLt
            rcases Nat.lt_or_ge k.val 1 with h0 | h1
            · left
              apply Fin.ext
              simp [i]
              omega
            · right
              apply Fin.ext
              simp [j]
              omega
          rcases hk with rfl | rfl
          · exact le_sup_of_le_left
              (Subgroup.map_mono (Subgroup.map_mono (rankOne_le_parJ (Set.mem_singleton i))))
          · exact le_sup_of_le_right
              (Subgroup.map_mono (Subgroup.map_mono (rankOne_le_parJ (Set.mem_singleton j))))
  have hne : P.map (MulAut.conj t).toMonoidHom ≠ P := by
    intro hPeq
    have hXjP : ((parJ D H {j}).map π).map L.subtype ≤ P := by
      rw [← hconj]
      exact (Subgroup.map_mono hPX).trans (le_of_eq hPeq)
    have hLleP : L ≤ P := by
      rw [← hsup]
      exact sup_le hPX hXjP
    exact hPL.2 hLleP
  exact ⟨t, ht, P, hPL, hmax, hN, hne⟩

theorem exists_umaxBQ (hLn : L.Normal) (hLs : IsSimpleGroup ↥L)
    (hnab : ∃ a b : ↥L, a * b ≠ b * a) (hT : IsSylowIn 2 T ⊤) (hMt : M < ⊤)
    (hMax : ∀ X : Subgroup Q, T ≤ X → X < ⊤ → X ≤ M) (h : BorelQuotient D n H π e) :
    ∃ π' : K →* ↥L, UMaxBQ L T M D n H π' e := by
  have hT2 : IsSylowTwoOf T ⊤ := ⟨hT.1, hT.2.1, hT.2.2⟩
  have hS : IsSylowTwoOf (T ⊓ L) L :=
    A4.isSylowTwoOf_inf_normal hT2 le_top (@Subgroup.le_normalizer_of_normal Q _ L ⊤ hLn)
  obtain ⟨π', hbq, hunip⟩ := exists_borelQuotient_conj hS h
  exact ⟨π', ⟨hLn, hLs, hnab, hT, hMt, hMax, hbq, hunip⟩⟩

namespace UMaxBQ

theorem inf_ne_bot (hU : UMaxBQ L T M D n H π e) : T ⊓ L ≠ ⊥ := by
  intro hbot
  have hT2 : IsSylowTwoOf T ⊤ := ⟨hU.sylow.1, hU.sylow.2.1, hU.sylow.2.2⟩
  have hS : IsSylowTwoOf (T ⊓ L) L :=
    A4.isSylowTwoOf_inf_normal hT2 le_top (@Subgroup.le_normalizer_of_normal Q _ L ⊤ hU.normal)
  have hsub : (T ⊓ L).subgroupOf L = ⊥ := by rw [hbot, Subgroup.bot_subgroupOf]
  have hidx : ((T ⊓ L).subgroupOf L).index = Nat.card ↥L := by
    rw [hsub]
    simp
  have hnot : ¬ 2 ∣ Nat.card ↥L := by
    rw [← hidx]
    exact hS.2.2
  have hodd : Odd (Nat.card ↥L) := Nat.not_even_iff_odd.mp (by
    rw [even_iff_two_dvd]
    exact hnot)
  have hpe : pElementSubgroup 2 (⊤ : Subgroup ↥L) = ⊥ := by
    rw [eq_bot_iff, pElementSubgroup, Subgroup.closure_le]
    rintro x ⟨-, k, hk⟩
    have h1 : orderOf x ∣ 2 ^ k := by rw [hk]
    have h2 : orderOf x ∣ Nat.card ↥L := by
      have := Subgroup.orderOf_dvd_natCard (⊤ : Subgroup ↥L) (Subgroup.mem_top x)
      rwa [Subgroup.card_top] at this
    have hcop : Nat.Coprime (2 ^ k) (Nat.card ↥L) :=
      (Nat.coprime_two_left.mpr hodd).pow_left k
    exact Subgroup.mem_bot.2 (orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_coprimes hcop h1 h2))
  have hgen : (⨆ i, (rankOne D.rootGroup i).map π) = ⊤ := by
    rw [← Subgroup.map_iSup, iSup_rankOne_eq_top hU.bq.ct hU.bq.extras,
      Subgroup.map_top_of_surjective π hU.bq.surj]
  have hEach : ∀ i, (rankOne D.rootGroup i).map π = ⊥ := by
    intro i
    rw [eq_bot_iff]
    calc (rankOne D.rootGroup i).map π
        ≤ pElementSubgroup 2 ((parJ D H {i}).map π) :=
          map_rankOne_le_pElementSubgroup hU.bq i
      _ ≤ pElementSubgroup 2 (⊤ : Subgroup ↥L) := by
          apply Subgroup.closure_mono
          rintro x ⟨-, k, hk⟩
          exact ⟨Subgroup.mem_top x, k, hk⟩
      _ = ⊥ := hpe
  have htopbot : (⊤ : Subgroup ↥L) = ⊥ := by
    rw [← hgen, iSup_congr hEach]
    simp
  obtain ⟨a, b, hab⟩ := hU.simple.toNontrivial.exists_pair_ne
  apply hab
  have ha : a ∈ (⊥ : Subgroup ↥L) := htopbot ▸ Subgroup.mem_top a
  have hb : b ∈ (⊥ : Subgroup ↥L) := htopbot ▸ Subgroup.mem_top b
  rw [Subgroup.mem_bot] at ha hb
  rw [ha, hb]

private theorem map_parJ_map_subtype_ne_bot (hU : UMaxBQ L T M D n H π e)
    (J : Set (Fin D.rank)) : ((parJ D H J).map π).map L.subtype ≠ ⊥ := by
  have hUle : (posUnipotent D).map π ≤ (parJ D H J).map π :=
    Subgroup.map_mono (posUnipotent_le_borel.trans (borel_le_parJ J))
  have hUne : (posUnipotent D).map π ≠ ⊥ := by
    intro hbot
    apply inf_ne_bot hU
    rw [eq_bot_iff]
    intro x hx
    have hSbot : (T ⊓ L).subgroupOf L = ⊥ := by rw [hU.unip, hbot]
    have hx' : (⟨x, hx.2⟩ : ↥L) ∈ (T ⊓ L).subgroupOf L := hx
    rw [hSbot, Subgroup.mem_bot] at hx'
    exact Subgroup.mem_bot.2 (congrArg Subtype.val hx')
  intro hbot
  apply hUne
  rw [eq_bot_iff]
  have hPbot : (parJ D H J).map π = ⊥ := by
    apply Subgroup.map_injective L.subtype_injective
    rw [hbot, Subgroup.map_bot]
  exact hUle.trans hPbot.le

theorem transitive (hU : UMaxBQ L T M D n H π e) (i j : Fin D.rank) :
    ∃ t ∈ T, (((parJ D H {i}).map π).map L.subtype).map (MulAut.conj t).toMonoidHom =
      ((parJ D H {j}).map π).map L.subtype := by
  classical
  have hRN : T ≤ Subgroup.normalizer (L : Set Q) :=
    @Subgroup.le_normalizer_of_normal Q _ L T hU.normal
  have h𝒜 : ∀ α ∈ (actHom hRN).range,
      ((posUnipotent D).map π).map α.toMonoidHom = (posUnipotent D).map π :=
    range_actHom_fix hRN hU.unip
  by_contra hconj
  push Not at hconj
  let O : Set (Fin D.rank) := nodeOrbit hU.bq (actHom hRN).range h𝒜 i
  have hO : i ∈ O := by
    refine ⟨1, ?_⟩
    show nodeHom hU.bq (actHom hRN).range h𝒜 1 i = i
    rw [map_one]
    rfl
  have hjO : j ∉ O := by
    rintro ⟨a, ha⟩
    obtain ⟨r, hr⟩ := a.2
    let a' : ↥(actHom hRN).range := ⟨actHom hRN r, ⟨r, rfl⟩⟩
    have haa : a = a' := Subtype.ext hr.symm
    rw [haa] at ha
    exact hconj r.1 r.2 (by
      rw [← ha]
      exact map_parJ_subtype_conj hU.bq hRN h𝒜 r.2 i)
  have hOc : j ∈ Oᶜ := by simpa using hjO
  let X₁ : Subgroup Q := ((parJ D H O).map π).map L.subtype
  let X₂ : Subgroup Q := ((parJ D H Oᶜ).map π).map L.subtype
  have h₁ : X₁ ≤ L := Subgroup.map_subtype_le _
  have h₂ : X₂ ≤ L := Subgroup.map_subtype_le _
  have hb₁ : X₁ ≠ ⊥ := map_parJ_map_subtype_ne_bot hU O
  have hb₂ : X₂ ≠ ⊥ := map_parJ_map_subtype_ne_bot hU Oᶜ
  have hl₁ : X₁ ≠ L := by
    intro htop
    exact hjO (mem_of_map_parJ_map_subtype_eq_top (h := hU.bq) (J := O) (hJ := ⟨i, hO⟩)
      (k := j) htop)
  have hl₂ : X₂ ≠ L := by
    intro htop
    have hi : i ∈ Oᶜ := mem_of_map_parJ_map_subtype_eq_top (h := hU.bq) (J := Oᶜ)
      (hJ := ⟨j, hOc⟩) (k := i) htop
    exact hi hO
  have hn₁ : T ≤ normalizer (X₁ : Set Q) := by
    intro t ht
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    exact map_parJ_orbit_subtype_conj hU.bq hRN h𝒜 ht i
  have hn₂ : T ≤ normalizer (X₂ : Set Q) := by
    intro t ht
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    exact map_parJ_compl_subtype_conj hU.bq hRN h𝒜 ht i
  have hsup : X₁ ⊔ X₂ = L := map_parJ_map_subtype_sup_compl_eq_top hU.bq O
  exact false_of_invariant_pair hU.normal hU.simple hU.nonabelian hU.sylow (inf_ne_bot hU)
    hU.lt_top hU.le_of_le h₁ h₂ hb₁ hb₂ hl₁ hl₂ hn₁ hn₂ hsup

theorem rank_le_two (hU : UMaxBQ L T M D n H π e) : D.rank ≤ 2 :=
  rank_le_two_of_nodeTransitive hU.bq hU.normal hU.simple hU.nonabelian hU.sylow.2.1 hU.unip
    (transitive hU)

theorem card_rootGroup_eq (hU : UMaxBQ L T M D n H π e) (i j : Fin D.rank) :
    Nat.card ↥(D.rootGroup (Pi.single i 1)) = Nat.card ↥(D.rootGroup (Pi.single j 1)) :=
  card_rootGroup_eq_of_nodeTransitive hU.bq (transitive hU) i j

theorem exists_swap (hU : UMaxBQ L T M D n H π e) (hr : D.rank = 2) :
    ∃ t ∈ T, ∃ P : Subgroup Q, P < L ∧ (∀ Y : Subgroup Q, P < Y → Y ≤ L → Y = L) ∧
      L ⊓ normalizer ((T ⊓ L : Subgroup Q) : Set Q) ≤ P ∧
      P.map (MulAut.conj t).toMonoidHom ≠ P :=
  exists_swap_of_nodeTransitive hU.bq hU.unip (transitive hU) hr

theorem inf_le_borel (hU : UMaxBQ L T M D n H π e) :
    M ⊓ L ≤ ((borel D H).map π).map L.subtype := by
  classical
  by_contra hnot
  have hTlt : T < ⊤ := by
    rw [lt_top_iff_ne_top]
    intro htop
    exact not_isPGroup_of_simple_nonabelian hU.simple hU.nonabelian 2
      (hU.sylow.2.1.to_le (by rw [htop]; exact le_top))
  have hTM : T ≤ M := hU.le_of_le T le_rfl hTlt
  have hTY : T ≤ Subgroup.normalizer ((M ⊓ L : Subgroup Q) : Set Q) :=
    (le_inf (hTM.trans Subgroup.le_normalizer)
      (@Subgroup.le_normalizer_of_normal Q _ L T hU.normal)).trans
      Subgroup.inf_normalizer_le_normalizer_inf
  have hUX : (posUnipotent D).map π ≤ (M ⊓ L).subgroupOf L := by
    rw [← hU.unip]
    exact Subgroup.subgroupOf_mono L (le_inf (fun x hx => hTM hx.1) inf_le_right)
  have hNX : ¬ (M ⊓ L).subgroupOf L ≤
      Subgroup.normalizer (((posUnipotent D).map π : Subgroup ↥L) : Set ↥L) := by
    intro hle
    apply hnot
    have hmap := Subgroup.map_mono (f := L.subtype) hle
    rw [hU.bq.normalizer_map_posUnipotent,
      Subgroup.map_subgroupOf_eq_of_le (H := M ⊓ L) inf_le_right] at hmap
    exact hmap
  obtain ⟨i, hi⟩ := ov_of_borelQuotient hU.bq hUX hNX
  have hAll : ∀ j, pElementSubgroup 2 ((parJ D H {j}).map π) ≤
      (M ⊓ L).subgroupOf L := by
    intro j
    obtain ⟨t, ht, hconj⟩ := transitive hU i j
    have hmapY : (M ⊓ L).map (MulAut.conj t).toMonoidHom = M ⊓ L :=
      Subgroup.mem_normalizer_iff_map_conj_eq.mp (hTY ht)
    have h1 : pElementSubgroup 2 (((parJ D H {i}).map π).map L.subtype) ≤ M ⊓ L := by
      have h := Subgroup.map_mono (f := L.subtype) hi
      rw [map_pElementSubgroup_two,
        Subgroup.map_subgroupOf_eq_of_le (H := M ⊓ L) inf_le_right] at h
      exact h
    have h2 : pElementSubgroup 2 (((parJ D H {j}).map π).map L.subtype) ≤ M ⊓ L := by
      rw [← hconj]
      rw [CFSG.AGLEmbeddingD2.Tits.MsideParabolicEscape.ChevGen.pElementSubgroup_map_equiv
        (MulAut.conj t) (((parJ D H {i}).map π).map L.subtype)]
      have h := Subgroup.map_mono (f := (MulAut.conj t).toMonoidHom) h1
      rwa [hmapY] at h
    have h3 : (pElementSubgroup 2 ((parJ D H {j}).map π)).map L.subtype ≤ M ⊓ L := by
      rw [map_pElementSubgroup_two]
      exact h2
    rw [Subgroup.map_le_iff_le_comap, Subgroup.comap_subtype] at h3
    exact h3
  have hLleY : L ≤ M ⊓ L := by
    have hgen := iSup_map_rankOne_subtype_eq hU.bq
    calc L = (⨆ j, ((rankOne D.rootGroup j).map π).map L.subtype) := hgen.symm
      _ ≤ M ⊓ L := by
        refine iSup_le fun j => ?_
        have h1 : (rankOne D.rootGroup j).map π ≤ (M ⊓ L).subgroupOf L :=
          (map_rankOne_le_pElementSubgroup hU.bq j).trans (hAll j)
        have h2 := Subgroup.map_mono (f := L.subtype) h1
        rwa [Subgroup.map_subgroupOf_eq_of_le (H := M ⊓ L) inf_le_right] at h2
  have hLleM : L ≤ M := hLleY.trans inf_le_left
  exact false_of_le hU.normal hU.simple hU.nonabelian hU.sylow (inf_ne_bot hU) hU.lt_top
    hU.le_of_le hLleM

theorem isSolvable_inf (hU : UMaxBQ L T M D n H π e) : Group.IsSolvable ↥(M ⊓ L) := by
  have hmapBsol := isSolvable_map_borel_subtype hU.bq
  exact Group.isSolvable_of_isSolvable_injective
