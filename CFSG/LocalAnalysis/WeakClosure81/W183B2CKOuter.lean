private theorem w183b2_absIrr_of_isIrreducible {k : Type} [Field k] [IsAlgClosed k]
    {G : Type} [Group G] {W : Type} [AddCommGroup W] [Module k W] [FiniteDimensional k W]
    {ρ : Representation k G W} (hρ : ρ.IsIrreducible) : AbsIrr ρ := by
  refine AbsIrr.of_isIrreducible hρ ?_
  intro f hf
  haveI : Nontrivial W := ((isIrreducible_iff ρ).1 hρ).1
  obtain ⟨c, hc⟩ := Module.End.exists_eigenvalue f
  refine ⟨c, ?_⟩
  have hU : IsInv ρ (Module.End.eigenspace f c) := by
    intro g x hx
    rw [Module.End.mem_eigenspace_iff] at hx ⊢
    rw [hf g x, hx]
    simp
  rcases ((isIrreducible_iff ρ).1 hρ).2 _ hU with hbot | htop
  · exact absurd hbot hc
  · ext x
    have hx : x ∈ Module.End.eigenspace f c := htop ▸ Submodule.mem_top
    rw [Module.End.mem_eigenspace_iff] at hx
    simpa using hx

private structure w183b2IrrRep (k : Type) (G : Type) [Field k] [Group G] where
  W : Type
  [instAddCommGroup : AddCommGroup W]
  [instModule : Module k W]
  [instFiniteDimensional : FiniteDimensional k W]
  σ : Representation k G W
  irr : σ.IsIrreducible

attribute [instance] w183b2IrrRep.instAddCommGroup w183b2IrrRep.instModule
  w183b2IrrRep.instFiniteDimensional

theorem w183b2_outer_decomp {k : Type} [Field k] [IsAlgClosed k] {G : Type} [Group G] [Finite G]
    {Q : Type} [AddCommGroup Q] [Module k Q] [FiniteDimensional k Q] {ρ : Representation k G Q}
    {A₁ A₂ Δ : Subgroup G} (h : CoreSetting ρ A₁ A₂ Δ)
    (hsimple : ∀ U : Submodule k Q, w183b2InvSub ρ (A₁ ⊔ A₂) U → U = ⊥ ∨ U = ⊤) :
    ∃ (U₁ U₂ : Type) (_ : AddCommGroup U₁) (_ : Module k U₁) (_ : FiniteDimensional k U₁)
      (_ : AddCommGroup U₂) (_ : Module k U₂) (_ : FiniteDimensional k U₂)
      (ρ₁ : Representation k ↥A₁ U₁) (ρ₂ : Representation k ↥A₂ U₂)
      (E : Q ≃ₗ[k] U₁ ⊗[k] U₂),
      ρ₁.IsIrreducible ∧ ρ₂.IsIrreducible ∧
      (∀ (a : ↥A₁) (q : Q), E (ρ a q) = TensorProduct.map (ρ₁ a) LinearMap.id (E q)) ∧
      (∀ (b : ↥A₂) (q : Q), E (ρ b q) = TensorProduct.map LinearMap.id (ρ₂ b) (E q)) := by
  classical
  let τ : Representation k (↥A₁ × ↥A₂) Q :=
    { toFun := fun p => ρ (p.1 : G) * ρ (p.2 : G)
      map_one' := by
        simp
      map_mul' := fun p q => by
        have hcomm : ∀ x : Q, ρ (q.1 : G) (ρ (p.2 : G) x)
            = ρ (p.2 : G) (ρ (q.1 : G) x) := by
          intro x
          have hh : ρ (q.1 : G) * ρ (p.2 : G) = ρ (p.2 : G) * ρ (q.1 : G) := by
            have := congrArg ρ (h.comm (q.1 : G) q.1.2 (p.2 : G) p.2.2)
            simpa only [map_mul] using this
          have := congrArg (fun F : Module.End k Q => F x) hh
          simpa only [Module.End.mul_apply] using this
        ext x
        change (ρ ((p.1 * q.1 : ↥A₁) : G) * ρ ((p.2 * q.2 : ↥A₂) : G)) x
          = ((ρ (p.1 : G) * ρ (p.2 : G)) * (ρ (q.1 : G) * ρ (q.2 : G))) x
        simp only [Subgroup.coe_mul, map_mul, Module.End.mul_apply]
        rw [hcomm] }
  have τ_fst : ∀ a : ↥A₁, τ (a, 1) = ρ (a : G) := by
    intro a
    dsimp only [τ]
    simp
  have τ_snd : ∀ b : ↥A₂, τ (1, b) = ρ (b : G) := by
    intro b
    dsimp only [τ]
    simp
  have hτ : τ.IsIrreducible := by
    rw [isIrreducible_iff]
    refine ⟨((isIrreducible_iff ρ).1 h.irr).1, ?_⟩
    intro U hU
    apply hsimple U
    let P : Subgroup G :=
      { carrier := {g : G | ∀ u ∈ U, ρ g u ∈ U ∧ ρ g⁻¹ u ∈ U}
        one_mem' := by
          intro u hu
          exact ⟨by simpa using hu, by simpa using hu⟩
        mul_mem' := by
          intro g h' hg hh u hu
          exact ⟨by
              have h1 := (hg (ρ h' u) (hh u hu).1).1
              simpa only [map_mul, Module.End.mul_apply] using h1,
            by
              have h1 := (hh (ρ g⁻¹ u) (hg u hu).2).2
              simpa only [mul_inv_rev, map_mul, Module.End.mul_apply] using h1⟩
        inv_mem' := by
          intro g hg u hu
          exact ⟨(hg u hu).2, by simpa using (hg u hu).1⟩ }
    have hle : A₁ ⊔ A₂ ≤ P := by
      apply sup_le
      · intro a ha u hu
        refine ⟨?_, ?_⟩
        · have h1 := hU (⟨a, ha⟩, (1 : ↥A₂)) u hu
          rwa [τ_fst] at h1
        · have h1 := hU (⟨a, ha⟩⁻¹, (1 : ↥A₂)) u hu
          rwa [τ_fst, Subgroup.coe_inv] at h1
      · intro b hb u hu
        refine ⟨?_, ?_⟩
        · have h1 := hU ((1 : ↥A₁), ⟨b, hb⟩) u hu
          rwa [τ_snd] at h1
        · have h1 := hU ((1 : ↥A₁), ⟨b, hb⟩⁻¹) u hu
          rwa [τ_snd, Subgroup.coe_inv] at h1
    intro n hn u hu
    exact ((hle hn) u hu).1
  let A : ∀ a : w183b2IrrRep k ↥A₁, Representation k ↥A₁ a.W := fun a => a.σ
  let B : ∀ b : w183b2IrrRep k ↥A₂, Representation k ↥A₂ b.W := fun b => b.σ
  have hA : ∀ a, AbsIrr (A a) := fun a => w183b2_absIrr_of_isIrreducible a.irr
  have hB : ∀ b, AbsIrr (B b) := fun b => w183b2_absIrr_of_isIrreducible b.irr
  have hAc : ∀ (W : Type) [AddCommGroup W] [Module k W] [FiniteDimensional k W]
      (σ : Representation k ↥A₁ W), σ.IsIrreducible → ∃ a, Nonempty (σ.Equiv (A a)) := by
    intro W _ _ _ σ hσ
    exact ⟨{ W := W, σ := σ, irr := hσ }, ⟨Representation.Equiv.refl σ⟩⟩
  have hBc : ∀ (W : Type) [AddCommGroup W] [Module k W] [FiniteDimensional k W]
      (σ : Representation k ↥A₂ W), σ.IsIrreducible → ∃ b, Nonempty (σ.Equiv (B b)) := by
    intro W _ _ _ σ hσ
    exact ⟨{ W := W, σ := σ, irr := hσ }, ⟨Representation.Equiv.refl σ⟩⟩
  obtain ⟨a, b, ⟨E⟩⟩ := exists_outer_equiv (A := A) (hA := hA) (B := B) (hB := hB)
    (hAc := hAc) (hBc := hBc) τ hτ
  refine ⟨a.W, b.W, a.instAddCommGroup, a.instModule, a.instFiniteDimensional,
    b.instAddCommGroup, b.instModule, b.instFiniteDimensional,
    a.σ, b.σ, E.toLinearEquiv, ?_⟩
  refine ⟨(hA a).isIrreducible, (hB b).isIrreducible, ?_, ?_⟩
  · intro a' q
    have h1 := CFSG.LocalAnalysis.ComponentInitial.PairedTensorOrbits.Equiv.map_apply
      E (a', 1) q
    rw [τ_fst a'] at h1
    simp only [outer_apply, map_one, Module.End.one_eq_id] at h1
    exact h1
  · intro b' q
    have h1 := CFSG.LocalAnalysis.ComponentInitial.PairedTensorOrbits.Equiv.map_apply
      E (1, b') q
    rw [τ_snd b'] at h1
    simp only [outer_apply, map_one, Module.End.one_eq_id] at h1
    exact h1

end CFSG.LocalAnalysis.WeakClosure81

