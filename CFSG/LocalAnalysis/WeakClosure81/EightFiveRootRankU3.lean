@[expose] def SU3IrreducibleRank : Prop :=
  ∀ (n : ℕ) (F₀ : Type) [Field F₀] [Finite F₀], 2 ≤ n → Nat.card F₀ = (2 ^ n) ^ 2 →
    ∀ (F : Type) [AddCommGroup F] [Module (ZMod 2) F] [Finite F]
      (σ : ↥(StatedSU 3 (2 ^ n) F₀) →* LGL 2 F), IsChiefFactor σ ⊤ ⊥ →
      ∀ g : ↥(StatedSU 3 (2 ^ n) F₀),
        Matrix.rank (((g : GL (Fin 3) F₀) : Matrix (Fin 3) (Fin 3) F₀) - 1) = 1 →
        σ g ≠ 1 → 2 * n ≤ modCommRank (σ g)

theorem two_le_of_isPSUGp_three {Y : Type} [Group Y] {n : ℕ} (hY : IsPSUGp Y 3 n) : 2 ≤ n := by
  obtain ⟨⟨-, hf, -, hne⟩, -⟩ :=
    CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by norm_num) hY
  by_contra hlt
  have hn1 : n = 1 := by omega
  subst hn1
  exact hne rfl

theorem isSimpleGroup_isPerfect_of_isPSUGp_three {Y : Type} [Group Y] {n : ℕ}
    (hY : IsPSUGp Y 3 n) : IsSimpleGroup Y ∧ Group.IsPerfect Y := by
  obtain ⟨⟨hp, -, -, hne⟩, K, _, _, hK, ⟨e⟩⟩ :=
    CFSG.Blueprint.LieModel.statedClassicalModel_of_ne_zero (by norm_num) hY
  haveI : Fact (Nat.Prime 2) := ⟨hp⟩
  haveI : IsSimpleGroup (StatedProj (StatedSU 3 (2 ^ n) K)) :=
    CFSG.ClassicalGroups.Unitary.isSimpleGroup_statedProj_statedSU K 2 n hK 3 le_rfl hne
  haveI : Group.IsPerfect (StatedSU 3 (2 ^ n) K) :=
    CFSG.ClassicalGroups.Unitary.isPerfect_statedSU hK le_rfl hne
  haveI : Group.IsPerfect (StatedProj (StatedSU 3 (2 ^ n) K)) :=
    Group.IsPerfect.ofSurjective (f := QuotientGroup.mk' _) (QuotientGroup.mk'_surjective _)
  exact ⟨e.isSimpleGroup, Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective⟩

theorem isUnitaryTransvection_not_mem_center {X : Type} [Group X] {n : ℕ} {x : X}
    (hx : IsUnitaryTransvection X 3 n x) : x ∉ Subgroup.center X := by
  classical
  obtain ⟨F, hF, hFfin, hcard, e, g, hge, hgrank⟩ := hx
  intro hxc
  have hx1 : (QuotientGroup.mk x : X ⧸ Subgroup.center X) = 1 :=
    (QuotientGroup.eq_one_iff x).2 hxc
  have hg1 : (QuotientGroup.mk g : StatedProj (StatedSU 3 (2 ^ n) F)) = 1 := by
    rw [hge, hx1, map_one]
  have hgmem : (g : GL (Fin 3) F) ∈ StatedScalars (Fin 3) F := by
    have h := (QuotientGroup.eq_one_iff g).1 hg1
    rw [Subgroup.mem_subgroupOf] at h
    exact h
  rw [StatedScalars, MonoidHom.mem_range] at hgmem
  obtain ⟨c, hc⟩ := hgmem
  have hgmat : ((g : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) =
      Matrix.scalar (Fin 3) (c : F) := by
    rw [← hc, Matrix.GeneralLinearGroup.coe_scalar]
  have hdiag : (((g : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F)) - 1 =
      ((c : F) - 1) • (1 : Matrix (Fin 3) (Fin 3) F) := by
    rw [hgmat, Matrix.scalar_apply, ← Matrix.smul_one_eq_diagonal, sub_smul, one_smul]
  have hrank01 : ((((g : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F)) - 1).rank = 0 ∨
      ((((g : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F)) - 1).rank = 3 := by
    rw [hdiag]
    by_cases h : (c : F) - 1 = 0
    · left
      rw [h, zero_smul, Matrix.rank_zero]
    · right
      rw [Matrix.rank_smul_of_mem_nonZeroDivisors (1 : Matrix (Fin 3) (Fin 3) F)
        (mem_nonZeroDivisors_of_ne_zero h), Matrix.rank_one, Fintype.card_fin]
  rcases hrank01 with h | h <;> rw [h] at hgrank <;> omega

theorem statedSU_transvection_mul_self {n : ℕ} {F₀ : Type} [Field F₀] [Finite F₀]
    (hcard : Nat.card F₀ = (2 ^ n) ^ 2) (g : ↥(StatedSU 3 (2 ^ n) F₀))
    (hg : Matrix.rank (((g : GL (Fin 3) F₀) : Matrix (Fin 3) (Fin 3) F₀) - 1) = 1) :
    g * g = 1 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : CharP F₀ 2 :=
    CFSG.ClassicalGroups.Unitary.charP_of_card_sq (p := 2) (f := n) hcard
  set M : Matrix (Fin 3) (Fin 3) F₀ := ((g : GL (Fin 3) F₀) : Matrix (Fin 3) (Fin 3) F₀) with hM
  have hdet : M.det = 1 := by
    rw [hM]
    exact CFSG.Open.StatedAPI.det_of_mem_statedSU g.2
  obtain ⟨p, r, hp, hr, hrp, hMeq⟩ :=
    CFSG.RankThree.GF2n.Smith81.exists_eq_dihTv_of_rank_eq_one (M := M) hg hdet
  have hMM : M * M = 1 := by
    rw [hMeq]
    rw [Matrix.ext_iff_mulVec]
    intro x
    have hx : r ⬝ᵥ (x + (r ⬝ᵥ x) • p) = r ⬝ᵥ x := by
      rw [dotProduct_add, dotProduct_smul, hrp, smul_zero, add_zero]
    rw [← Matrix.mulVec_mulVec, CFSG.RankThree.GF2n.Smith81.dihTv_mulVec p r x,
      CFSG.RankThree.GF2n.Smith81.dihTv_mulVec p r (x + (r ⬝ᵥ x) • p),
      Matrix.one_mulVec, hx]
    rw [add_assoc, ← add_smul, CharTwo.add_self_eq_zero, zero_smul, add_zero]
  apply Subtype.ext
  apply Units.ext
  simpa [hM] using hMM

theorem eq_of_mul_self_eq_one_of_mk_eq {X : Type} [Group X] [Finite X]
    (hodd : Odd (Nat.card (Subgroup.center X))) {a b : X} (ha : a * a = 1) (hb : b * b = 1)
    (hab : (QuotientGroup.mk a : X ⧸ Subgroup.center X) = QuotientGroup.mk b) : a = b := by
  obtain ⟨z, hz, haz⟩ := (QuotientGroup.mk'_eq_mk' (Subgroup.center X)).1 hab
  have hbz : b = a * z := haz.symm
  have hza : a * z = z * a := Subgroup.mem_center_iff.1 hz a
  have hzz : z * z = 1 := by
    have hbb : b * b = z * z := by
      rw [hbz]
      calc (a * z) * (a * z) = a * (z * a) * z := by group
        _ = a * (a * z) * z := by rw [← hza]
        _ = (a * a) * (z * z) := by group
        _ = z * z := by rw [ha, one_mul]
    rw [← hbb, hb]
  have hord2 : orderOf z ∣ 2 := by
    rw [orderOf_dvd_iff_pow_eq_one]
    rwa [pow_two]
  have hordc : orderOf z ∣ Nat.card (Subgroup.center X) :=
    Subgroup.orderOf_dvd_natCard (Subgroup.center X) hz
  have hnot2 : ¬ 2 ∣ Nat.card (Subgroup.center X) := by
    intro h2
    exact (Nat.not_even_iff_odd.2 hodd) (even_iff_two_dvd.2 h2)
  have hz1 : z = 1 := by
    have hord1 : orderOf z = 1 := by
      rcases (Nat.dvd_prime Nat.prime_two).1 hord2 with h | h
      · exact h
      · exact absurd (h ▸ hordc) hnot2
    exact orderOf_eq_one_iff.1 hord1
  rw [hbz, hz1, mul_one]

theorem commutator_quotient_center_equiv {X : Type} [Group X] [Finite X]
    (hperf : Group.IsPerfect (X ⧸ Subgroup.center X)) :
    ∃ ε : (↥(commutator X) ⧸ Subgroup.center ↥(commutator X)) ≃* (X ⧸ Subgroup.center X),
      (∀ y : ↥(commutator X), ε (QuotientGroup.mk y) = QuotientGroup.mk (y : X)) ∧
        Group.IsPerfect ↥(commutator X) ∧
        Nat.card (Subgroup.center ↥(commutator X)) ∣ Nat.card (Subgroup.center X) := by
  have hperfC : Group.IsPerfect ↥(commutator X) :=
    CFSG.RankThree.PartOne.U5K.isPerfect_commutator hperf
  have hsup : commutator X ⊔ Subgroup.center X = ⊤ :=
    CFSG.RankThree.PartOne.U5K.commutator_sup_center_eq_top hperf
  let f : ↥(commutator X) →* (X ⧸ Subgroup.center X) :=
    (QuotientGroup.mk' (Subgroup.center X)).comp (commutator X).subtype
  have hfker : f.ker = (Subgroup.center X).subgroupOf (commutator X) := by
    ext y
    have hfy : f y = (QuotientGroup.mk' (Subgroup.center X)) (y : X) := rfl
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, hfy, QuotientGroup.mk'_apply,
      QuotientGroup.eq_one_iff]
  have hcenter : (Subgroup.center X).subgroupOf (commutator X) =
      Subgroup.center ↥(commutator X) := by
    apply le_antisymm
    · intro y hy
      rw [Subgroup.mem_subgroupOf] at hy
      rw [Subgroup.mem_center_iff]
      intro z
      exact Subtype.ext (Subgroup.mem_center_iff.1 hy (z : X))
    · intro y hy
      rw [Subgroup.mem_subgroupOf, Subgroup.mem_center_iff]
      intro g
      have hg : g ∈ commutator X ⊔ Subgroup.center X := by rw [hsup]; trivial
      rw [Subgroup.mem_sup_of_normal_right] at hg
      obtain ⟨a, ha, b, hb, rfl⟩ := hg
      have hya : a * (y : X) = (y : X) * a :=
        congrArg Subtype.val (Subgroup.mem_center_iff.1 hy ⟨a, ha⟩)
      have hby : b * (y : X) = (y : X) * b :=
        (Subgroup.mem_center_iff.1 hb (y : X)).symm
      calc (a * b) * (y : X) = a * (b * (y : X)) := by rw [mul_assoc]
        _ = a * ((y : X) * b) := by rw [hby]
        _ = (a * (y : X)) * b := by rw [mul_assoc]
        _ = ((y : X) * a) * b := by rw [hya]
        _ = (y : X) * (a * b) := by rw [mul_assoc]
  have hker : f.ker = Subgroup.center ↥(commutator X) := hfker.trans hcenter
  have hsurj : Function.Surjective f := by
    intro y
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center X) y
    have hx : x ∈ commutator X ⊔ Subgroup.center X := by rw [hsup]; trivial
    rw [Subgroup.mem_sup_of_normal_right] at hx
    obtain ⟨a, ha, b, hb, rfl⟩ := hx
    refine ⟨⟨a, ha⟩, ?_⟩
    show (QuotientGroup.mk' (Subgroup.center X)) a =
      (QuotientGroup.mk' (Subgroup.center X)) (a * b)
    rw [map_mul, show (QuotientGroup.mk' (Subgroup.center X)) b = 1 from
      (QuotientGroup.eq_one_iff b).2 hb, mul_one]
  refine ⟨(QuotientGroup.quotientMulEquivOfEq hker.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective f hsurj), ?_, hperfC, ?_⟩
  · intro y
    rw [MulEquiv.trans_apply, QuotientGroup.quotientMulEquivOfEq_mk]
    have h1 : (QuotientGroup.quotientKerEquivOfSurjective f hsurj) (QuotientGroup.mk y) = f y :=
      QuotientGroup.kerLift_mk (φ := f) y
    rw [h1]
    rfl
  · rw [← hcenter]
    let g : (Subgroup.center X).subgroupOf (commutator X) →* Subgroup.center X :=
      { toFun := fun y => ⟨(y : X), y.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl }
    exact Subgroup.card_dvd_of_injective g fun a b h => by
      have h' : (a : X) = (b : X) :=
        congrArg (fun x : Subgroup.center X => (x : X)) h
      exact Subtype.ext (Subtype.ext h')

theorem exists_statedSU_cover_of_perfect
    {L : Type} [Group L] [Finite L] [Group.IsPerfect L] {n : ℕ} (hn : 2 ≤ n)
    {F₀ : Type} [Field F₀] [Finite F₀] (hcard : Nat.card F₀ = (2 ^ n) ^ 2)
    (e : (L ⧸ Subgroup.center L) ≃* StatedProj (StatedSU 3 (2 ^ n) F₀))
    (hodd : Odd (Nat.card (Subgroup.center L))) :
    ∃ π : ↥(StatedSU 3 (2 ^ n) F₀) →* L, Function.Surjective π ∧
      ∀ g : ↥(StatedSU 3 (2 ^ n) F₀), e (QuotientGroup.mk (π g)) =
        (QuotientGroup.mk g : StatedProj (StatedSU 3 (2 ^ n) F₀)) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : CharP F₀ 2 :=
    CFSG.ClassicalGroups.Unitary.charP_of_card_sq (p := 2) (f := n) hcard
  let D : Subgroup ↥(StatedSU 3 (2 ^ n) F₀) :=
    (StatedScalars (Fin 3) F₀).subgroupOf (StatedSU 3 (2 ^ n) F₀)
  obtain ⟨hsurj, hcen, hdvd⟩ :=
    CFSG.SectionRank.EvenCover.pullbackFst_centralQuotientMap
      (H := ↥(StatedSU 3 (2 ^ n) F₀)) (D := D) e
  obtain ⟨σ, hσ, -, -, -⟩ :=
    CFSG.SectionRank.EvenCover.even_unitary_three_central_odd_extension_splitting
      (K := F₀) (f := n) hcard hn hsurj hcen (Odd.of_dvd_nat hodd hdvd)
  let π : ↥(StatedSU 3 (2 ^ n) F₀) →* L :=
    (MonoidHom.snd ↥(StatedSU 3 (2 ^ n) F₀) L).comp
      ((CFSG.SectionRank.EvenCover.pullback
        (CFSG.SectionRank.EvenCover.centralQuotientMap e)
        (QuotientGroup.mk' D)).subtype.comp σ)
  have hcomp : (CFSG.SectionRank.EvenCover.centralQuotientMap e).comp π = QuotientGroup.mk' D :=
    CFSG.SectionRank.EvenCover.comp_snd_section σ hσ
  have hcomp' : ∀ h, CFSG.SectionRank.EvenCover.centralQuotientMap e (π h) =
      (h : ↥(StatedSU 3 (2 ^ n) F₀) ⧸ D) := fun h => congrArg (fun f => f h) hcomp
  have hsurjπ : Function.Surjective π := by
    rw [← MonoidHom.range_eq_top]
    refine CFSG.SectionRank.EvenCover.eq_top_of_forall_mul_center fun x => ?_
    obtain ⟨h, hh⟩ := QuotientGroup.mk'_surjective D
      (CFSG.SectionRank.EvenCover.centralQuotientMap e x)
    refine ⟨π h, ⟨h, rfl⟩, ?_⟩
    rw [← CFSG.SectionRank.EvenCover.ker_centralQuotientMap e, MonoidHom.mem_ker, map_mul,
      map_inv, hcomp', ← hh, QuotientGroup.mk'_apply, inv_mul_cancel]
  refine ⟨π, hsurjπ, fun g => ?_⟩
  have h := hcomp' g
  simpa [CFSG.SectionRank.EvenCover.centralQuotientMap] using h

theorem exists_statedSU_cover
    {X : Type} [Group X] [Finite X] {n : ℕ} (hn : 2 ≤ n)
    {F₀ : Type} [Field F₀] [Finite F₀] (hcard : Nat.card F₀ = (2 ^ n) ^ 2)
    (e : (X ⧸ Subgroup.center X) ≃* StatedProj (StatedSU 3 (2 ^ n) F₀))
    (hperf : Group.IsPerfect (X ⧸ Subgroup.center X))
    (hodd : Odd (Nat.card (Subgroup.center X))) :
    ∃ π : ↥(StatedSU 3 (2 ^ n) F₀) →* ↥(commutator X), Function.Surjective π ∧
      ∀ g : ↥(StatedSU 3 (2 ^ n) F₀), e (QuotientGroup.mk (π g : X)) =
        (QuotientGroup.mk g : StatedProj (StatedSU 3 (2 ^ n) F₀)) := by
  obtain ⟨ε, hε, hLperf, hdvd⟩ := commutator_quotient_center_equiv hperf
  haveI : Group.IsPerfect ↥(commutator X) := hLperf
  obtain ⟨π, hπs, hπ⟩ := exists_statedSU_cover_of_perfect hn hcard (ε.trans e)
    (Odd.of_dvd_nat hodd hdvd)
  refine ⟨π, hπs, fun g => ?_⟩
  have h := hπ g
  rwa [MulEquiv.trans_apply, hε] at h

theorem isChiefFactor_comp_of_surjective {M Y : Type} [Group M] [Group Y] (π : M →* Y)
    (hπ : Function.Surjective π) {F : Type} [AddCommGroup F] [Module (ZMod 2) F] [Finite F]
    (σ : Y →* LGL 2 F) (hσ : IsChiefFactor σ ⊤ ⊥) : IsChiefFactor (σ.comp π) ⊤ ⊥ := by
  obtain ⟨hlt, h1, h2, h3⟩ := hσ
  refine ⟨hlt, fun m w _ => Submodule.mem_top, fun m w hw => ?_, fun U hU hU' hinv => ?_⟩
  · rw [Submodule.mem_bot] at hw ⊢
    rw [hw, map_zero]
  · refine h3 U hU hU' fun y u hu => ?_
    obtain ⟨m, rfl⟩ := hπ y
    exact hinv m u hu

theorem unitaryRootCommutatorRankAt_three_of_irreducible
    (hSt : SU3IrreducibleRank) : UnitaryRootCommutatorRankAt 3 := by
  intro G _ _ K I n hI hK hC X _ φ hφ hX v hv hvt
  haveI : Finite X := Finite.of_surjective φ hφ.surjective
  have hn : 2 ≤ n := two_le_of_isPSUGp_three hX
  obtain ⟨hS, hperf⟩ := isSimpleGroup_isPerfect_of_isPSUGp_three hX
  have hvc : φ v ∉ Subgroup.center X := isUnitaryTransvection_not_mem_center hvt
  obtain ⟨hvX, F, _, _, _, σ, hσ, hσ1, hrank⟩ :=
    exists_irreducible_section_of_bar hI hK hC hφ hS hperf hv hvc
  obtain ⟨F₀, _, _, hcard, e, g, hge, hgrank⟩ := hvt
  obtain ⟨π, hπs, hπe⟩ := exists_statedSU_cover hn hcard e hperf (bar_odd_card_center hφ)
  have hvv : φ v * φ v = 1 := by
    rw [← map_mul]
    have hvv' : v * v = 1 := Subtype.ext hv
    rw [hvv', map_one]
  have hgg : g * g = 1 := statedSU_transvection_mul_self hcard g hgrank
  have hπg : (π g : X) = φ v := by
    refine eq_of_mul_self_eq_one_of_mk_eq (bar_odd_card_center hφ) ?_ hvv ?_
    · have h1 : π g * π g = 1 := by rw [← map_mul, hgg, map_one]
      exact congrArg Subtype.val h1
    · apply e.injective
      rw [hπe g, hge]
  have hπg' : π g = ⟨φ v, hvX⟩ := Subtype.ext hπg
  have hirr := isChiefFactor_comp_of_surjective π hπs σ hσ
  have h := hSt n F₀ hn hcard F (σ.comp π) hirr g hgrank (by
    rw [MonoidHom.comp_apply, hπg']
    exact hσ1)
  rw [MonoidHom.comp_apply, hπg'] at h
  exact h.trans hrank

