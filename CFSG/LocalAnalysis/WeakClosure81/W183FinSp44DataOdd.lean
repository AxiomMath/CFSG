@[expose] def checkOdd (e : Nat × Nat × Nat × Nat × Nat × Nat) : Bool :=
  let a : El := (e.1, e.2.1)
  let w : El := (e.2.2.1, e.2.2.2.1)
  let wi : El := (e.2.2.2.2.1, e.2.2.2.2.2)
  let c := gmulE a (gmulE wi (gmulE a w))
  (gmulE a a == oneE) && (a != oneE) && (gmulE w wi == oneE) &&
  (powE 2 c != oneE) &&
  ((powE 4 c == oneE) || ((powE 6 c == oneE) && (powE 3 c != oneE)) ||
   ((powE 10 c == oneE) && (powE 5 c != oneE)))

@[expose] def coverOdd : Bool := invs.all fun a => oddData.any fun e => (e.1, e.2.1) == a

theorem oddData_check : oddData.all checkOdd = true := by decide +kernel

theorem oddData_cover : coverOdd = true := by decide +kernel

