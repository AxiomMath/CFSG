theorem g3_blocks : ∀ k < 8, g3BlockOK k = true := by
  intro k hk
  match k, hk with
  | 0, _ => exact g3_block_0
  | 1, _ => exact g3_block_1
  | 2, _ => exact g3_block_2
  | 3, _ => exact g3_block_3
  | 4, _ => exact g3_block_4
  | 5, _ => exact g3_block_5
  | 6, _ => exact g3_block_6
  | 7, _ => exact g3_block_7
  | k + 8, h => exact absurd h (by omega)

