@[expose] def checkG3 (a b : El) (e : Nat) : Bool :=
  let p : El := (g3Pool.getD (e / 16) 0, 0)
  if e % 2 == 0 then
    let t := [a, b, gmulE a b].getD (e / 2 % 4) oneE
    let x := [a, b].getD (e / 8 % 2) oneE
    (gmulE p t == gmulE t p) && (gmulE p x != gmulE x p)
  else
    let A := klein a b
    (a.2 == 0) && (b.2 == 0) &&
    ((A.drop 1).all fun x => memK A (conjE p x) && (conjE p x != x))

@[expose] def g3BlockOK (k : Nat) : Bool :=
  let b := pairBlocks.getD k (0, 0)
  let R := g3Rows.getD k []
  ((pairsFrom b.1 b.2).length == R.length) &&
  ((pairsFrom b.1 b.2).zip R).all fun q => checkG3 invsA[q.1.1]! invsA[q.1.2]! q.2

theorem g3_block_0 : g3BlockOK 0 = true := by
  have hp : g3Pool.all (fun x => decide (x < 2 ^ 32)) = true := by decide +kernel
  have hq : ∀ p, g3Pool.getD p 0 = laneK 32 (packLK 32 g3Pool) p :=
    getD_eq_laneK 32 g3Pool (fun x hx => of_decide_eq_true (List.all_eq_true.mp hp x hx))
  unfold g3BlockOK pairsFrom checkG3 klein conjE
  simp only [invsA_getElem_eq, hq, n127, invs_length, gmulE_eq_K, invE_eq_K]
  decide +kernel

