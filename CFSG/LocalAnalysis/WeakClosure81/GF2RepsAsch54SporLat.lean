section Invariance

variable {Γ : Type} [Group Γ]

theorem map_eq_of_pair_of_invariant_le {U P P' Q : Subgroup Γ} (hUP : U ≤ P)
    (hpair : ∀ Y : Subgroup Γ, U ≤ Y → Nat.card Y = Nat.card P → Y = P ∨ Y = P')
    (hQP : Q ≤ P) (hQP' : ¬ Q ≤ P') (α : MulAut Γ) (hα : U.map α.toMonoidHom = U)
    (hQ : Q.map α.toMonoidHom = Q) : P.map α.toMonoidHom = P := by
  have hUα : U ≤ P.map α.toMonoidHom := by
    rw [← hα]
    exact Subgroup.map_mono hUP
  rcases hpair _ hUα (Subgroup.card_map_of_injective α.injective) with h | h
  · exact h
  · refine absurd ?_ hQP'
    rw [← h, ← hQ]
    exact Subgroup.map_mono hQP

theorem map_eq_of_pair_of_le_invariant {U P P' Q : Subgroup Γ} (hUP : U ≤ P)
    (hpair : ∀ Y : Subgroup Γ, U ≤ Y → Nat.card Y = Nat.card P → Y = P ∨ Y = P')
    (hPQ : P ≤ Q) (hP'Q : ¬ P' ≤ Q) (α : MulAut Γ) (hα : U.map α.toMonoidHom = U)
    (hQ : Q.map α.toMonoidHom = Q) : P.map α.toMonoidHom = P := by
  have hUα : U ≤ P.map α.toMonoidHom := by
    rw [← hα]
    exact Subgroup.map_mono hUP
  rcases hpair _ hUα (Subgroup.card_map_of_injective α.injective) with h | h
  · exact h
  · refine absurd ?_ hP'Q
    rw [← h, ← hQ]
    exact Subgroup.map_mono hPQ

end Invariance

section List

variable {Γ : Type} [Group Γ] {S : Subgroup Γ} {Y : ℕ → Subgroup Γ} {L : Array ℕ} {N k : ℕ}

theorem lat_sup_eq_top_of_not_le
    (hall : ∀ Z : Subgroup Γ, S ≤ Z → ∃ j ≤ L.size, Z = memberOrTop L.size Y j)
    {A B : Subgroup Γ} (hSA : S ≤ A) (h : ∀ j < L.size, A ≤ Y j → B ≤ Y j → False) :
    A ⊔ B = ⊤ := by
  obtain ⟨j, hj, hjZ⟩ := hall _ (le_sup_of_le_left hSA : S ≤ A ⊔ B)
  rw [hjZ]
  by_cases hjL : j < L.size
  · rw [list_member hjL] at hjZ
    exact (h j hjL (le_sup_left.trans hjZ.le) (le_sup_right.trans hjZ.le)).elim
  · unfold memberOrTop
    rw [ite_eq_right hjL]

theorem list_pair_of_card
    (hall : ∀ Z : Subgroup Γ, S ≤ Z → ∃ j ≤ L.size, Z = memberOrTop L.size Y j)
    (hcard : ∀ j < L.size, Nat.card (Y j) = L[j]! * 2 ^ k) (hΓ : Nat.card Γ = N * 2 ^ k)
    {c d : ℕ} (hc : c < L.size) (hd : d < L.size)
    (hucd : ∀ j < L.size + 1, latSz L N j = latSz L N c → j = c ∨ j = d) (Z : Subgroup Γ)
    (hZ : S ≤ Z) (hZc : Nat.card Z = Nat.card (Y c)) : Z = Y c ∨ Z = Y d := by
  rw [← list_member (Y := Y) hc, ← list_member (Y := Y) hd]
  rw [← list_member (Y := Y) hc] at hZc
  obtain ⟨j, hj, rfl⟩ := hall Z hZ
  rw [list_card hcard hΓ, list_card hcard hΓ] at hZc
  rcases hucd j (Nat.lt_succ_of_le hj) (Nat.eq_of_mul_eq_mul_right (by positivity) hZc) with
    rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr rfl

theorem list_ne_top_of_ne (hcard : ∀ j < L.size, Nat.card (Y j) = L[j]! * 2 ^ k)
    (hΓ : Nat.card Γ = N * 2 ^ k) {a : ℕ} (hN : latSz L N a ≠ N) :
    memberOrTop L.size Y a ≠ ⊤ := by
  intro h
  have h1 := congrArg (fun Z : Subgroup Γ => Nat.card Z) h
  rw [list_card hcard hΓ, Subgroup.card_top, hΓ] at h1
  exact hN (Nat.eq_of_mul_eq_mul_right (by positivity) h1)

variable {s : TauCeti.SporadicName} [Finite Γ]

theorem asch54SporGenAt_of_list (hsC : Nonempty (s.Group ≃* Γ))
    (hP0 : ∀ (X : Type) [Group X] [Finite X], IsCalL0 X → ∃ a b : X, a * b ≠ b * a)
    (hO : LieOrderFormulasInput) (hOut : Nat.card (Outer Γ) ≤ 2) (hS : IsSylowTwoOf S ⊤)
    (hall : ∀ Z : Subgroup Γ, S ≤ Z → ∃ j ≤ L.size, Z = memberOrTop L.size Y j)
    (hSY : ∀ j < L.size, S ≤ Y j) (hcard : ∀ j < L.size, Nat.card (Y j) = L[j]! * 2 ^ k)
    (hΓ : Nat.card Γ = N * 2 ^ k) {a b : ℕ} (hok : LatPairOK L N a b)
    (ha : calL0FreeCheck k (latSz L N a * 2 ^ k) = true)
    (hb : calL0FreeCheck k (latSz L N b * 2 ^ k) = true) : Asch54SporGenAt s := by
  obtain ⟨ha', hb', hua, hub, hjoin⟩ := hok
  refine asch54SporGenAt_of_isLPair_of_aut hsC hP0 hOut (T₀ := S) hS
    ⟨list_S_le hSY a, list_S_le hSY b, list_ne_top hcard hΓ ha' hua, list_ne_top hcard hΓ hb' hub,
      not_hasCompFactor_isCalL0_of_dvd hO ha (dvd_of_eq (list_card hcard hΓ a)),
      not_hasCompFactor_isCalL0_of_dvd hO hb (dvd_of_eq (list_card hcard hΓ b)),
      lat_sup_eq_top_of_not_le hall (list_S_le hSY a) fun j hj h1 h2 => hjoin j hj
        (list_dvd_of_le hcard hΓ (h1.trans (list_member hj).ge))
        (list_dvd_of_le hcard hΓ (h2.trans (list_member hj).ge))⟩
    fun ψ hψ => ⟨map_eq_of_unique_card (list_S_le hSY a) (list_unique hall hcard hΓ hua) ψ hψ,
      map_eq_of_unique_card (list_S_le hSY b) (list_unique hall hcard hΓ hub) ψ hψ⟩

theorem asch54SporGenAt_of_list_meet (hsC : Nonempty (s.Group ≃* Γ))
    (hP0 : ∀ (X : Type) [Group X] [Finite X], IsCalL0 X → ∃ a b : X, a * b ≠ b * a)
    (hO : LieOrderFormulasInput) (hOut : Nat.card (Outer Γ) ≤ 2) (hS : IsSylowTwoOf S ⊤)
    (hall : ∀ Z : Subgroup Γ, S ≤ Z → ∃ j ≤ L.size, Z = memberOrTop L.size Y j)
    (hSY : ∀ j < L.size, S ≤ Y j) (hcard : ∀ j < L.size, Nat.card (Y j) = L[j]! * 2 ^ k)
    (hΓ : Nat.card Γ = N * 2 ^ k) {a c d m : ℕ} (hok : LatMeetOK L N a c d)
    (hmc : Y m ≤ Y c) (hmd : Y m ≤ Y d) (hma : ¬ Y m ≤ Y a)
    (ha : calL0FreeCheck k (latSz L N a * 2 ^ k) = true)
    (hc : calL0FreeCheck k (latSz L N c * 2 ^ k) = true) : Asch54SporGenAt s := by
  obtain ⟨ha', hc', hd', hua, hcN, hdc, hucd, hmax⟩ := hok
  rw [← list_member (Y := Y) ha'] at hma
  rw [← list_member (Y := Y) hc'] at hmc
  rw [← list_member (Y := Y) hd'] at hmd
  have hcd : Nat.card (memberOrTop L.size Y d) = Nat.card (memberOrTop L.size Y c) := by
    rw [list_card hcard hΓ, list_card hcard hΓ, hdc]
  have hpair : ∀ Z : Subgroup Γ, S ≤ Z → Nat.card Z = Nat.card (memberOrTop L.size Y c) →
      Z = memberOrTop L.size Y c ∨ Z = memberOrTop L.size Y d := by
    intro Z hZ hZc
    obtain ⟨j, hj, rfl⟩ := hall Z hZ
    rw [list_card hcard hΓ, list_card hcard hΓ] at hZc
    rcases hucd j (Nat.lt_succ_of_le hj) (Nat.eq_of_mul_eq_mul_right (by positivity) hZc) with
      rfl | rfl
    · exact Or.inl rfl
    · exact Or.inr rfl
  have hgen : memberOrTop L.size Y a ⊔ (memberOrTop L.size Y c ⊓ memberOrTop L.size Y d) = ⊤ := by
    obtain ⟨j, hj, hjZ⟩ := hall _ (le_sup_of_le_left (list_S_le hSY a) :
      S ≤ memberOrTop L.size Y a ⊔ (memberOrTop L.size Y c ⊓ memberOrTop L.size Y d))
    rw [hjZ]
    by_cases hjL : j < L.size
    · exfalso
      have hja : j = a := hmax j hjL (list_dvd_of_le hcard hΓ (le_sup_left.trans hjZ.le))
      rw [hja] at hjZ
      exact hma ((le_inf hmc hmd).trans (le_sup_right.trans hjZ.le))
    · unfold memberOrTop
      rw [ite_eq_right hjL]
  refine asch54SporGenAt_of_isLPair_of_aut hsC hP0 hOut (T₀ := S) hS
    ⟨list_S_le hSY a, le_inf (list_S_le hSY c) (list_S_le hSY d), list_ne_top hcard hΓ ha' hua,
      fun h => list_ne_top_of_ne hcard hΓ hcN (eq_top_iff.mpr (h.symm.le.trans inf_le_left)),
      not_hasCompFactor_isCalL0_of_dvd hO ha (dvd_of_eq (list_card hcard hΓ a)),
      not_hasCompFactor_isCalL0_of_dvd hO hc
        ((Subgroup.card_dvd_of_le inf_le_left).trans (dvd_of_eq (list_card hcard hΓ c))), hgen⟩
    fun ψ hψ => ⟨map_eq_of_unique_card (list_S_le hSY a) (list_unique hall hcard hΓ hua) ψ hψ,
      map_inf_eq_of_pair (list_S_le hSY c) (list_S_le hSY d) hcd hpair ψ hψ⟩

theorem asch54SporGenAt_of_list_of_card_outer_eq_one (hsC : Nonempty (s.Group ≃* Γ))
    (hO : LieOrderFormulasInput) (hOut : Nat.card (Outer Γ) = 1) (hS : IsSylowTwoOf S ⊤)
    (hall : ∀ Z : Subgroup Γ, S ≤ Z → ∃ j ≤ L.size, Z = memberOrTop L.size Y j)
    (hSY : ∀ j < L.size, S ≤ Y j) (hcard : ∀ j < L.size, Nat.card (Y j) = L[j]! * 2 ^ k)
    (hΓ : Nat.card Γ = N * 2 ^ k) {a b : ℕ} (haN : latSz L N a ≠ N) (hbN : latSz L N b ≠ N)
    (hjoin : ∀ j < L.size, latSz L N a ∣ latSz L N j → ¬ latSz L N b ∣ latSz L N j)
    (ha : calL0FreeCheck k (latSz L N a * 2 ^ k) = true)
    (hb : calL0FreeCheck k (latSz L N b * 2 ^ k) = true) : Asch54SporGenAt s :=
  asch54SporGenAt_of_isLPair_of_card_outer_eq_one hsC hOut (T₀ := S) hS
    ⟨list_S_le hSY a, list_S_le hSY b, list_ne_top_of_ne hcard hΓ haN,
      list_ne_top_of_ne hcard hΓ hbN,
      not_hasCompFactor_isCalL0_of_dvd hO ha (dvd_of_eq (list_card hcard hΓ a)),
      not_hasCompFactor_isCalL0_of_dvd hO hb (dvd_of_eq (list_card hcard hΓ b)),
      lat_sup_eq_top_of_not_le hall (list_S_le hSY a) fun j hj h1 h2 => hjoin j hj
        (list_dvd_of_le hcard hΓ (h1.trans (list_member hj).ge))
        (list_dvd_of_le hcard hΓ (h2.trans (list_member hj).ge))⟩

end List

theorem asch54SporGenAt_of_hasInvPair_of_dvd {s : TauCeti.SporadicName} {Γ : Type} [Group Γ]
    [Finite Γ] (hsC : Nonempty (s.Group ≃* Γ))
    (hP0 : ∀ (X : Type) [Group X] [Finite X], IsCalL0 X → ∃ a b : X, a * b ≠ b * a)
    (hO : LieOrderFormulasInput) (hOut : Nat.card (Outer Γ) ≤ 2) (hP : HasInvPair Γ)
    {k N : ℕ} (hN : calL0FreeCheck k N = true) (hΓ : Nat.card Γ ∣ N) : Asch54SporGenAt s := by
  obtain ⟨U, P₀, P₁, hU, hU₀, hU₁, h₀, h₁, hgen, hinv⟩ := hP
  exact asch54SporGenAt_of_isLPair_of_aut hsC hP0 hOut (T₀ := U) hU
    ⟨hU₀, hU₁, h₀, h₁,
      not_hasCompFactor_isCalL0_of_dvd hO hN ((Subgroup.card_subgroup_dvd_card P₀).trans hΓ),
      not_hasCompFactor_isCalL0_of_dvd hO hN ((Subgroup.card_subgroup_dvd_card P₁).trans hΓ),
      hgen⟩ hinv

end CFSG.LocalAnalysis.WeakClosure81

