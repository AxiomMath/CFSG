open Subgroup CFSG.Open CFSG.Quasithin CFSG.Quasithin.C35Pf CFSG.Blueprint

variable {K : Type} [Group K] [Finite K] {L V MK : Subgroup K}

theorem KConf.conclK_of_c35
    (hK : KConf K L V MK)
    (hfam : ∃ f : ℕ, (2 ≤ f ∧ IsPSL 3 2 f (K ⧸ Subgroup.center K)) ∨
      (2 ≤ f ∧ IsPSp4 2 f (K ⧸ Subgroup.center K)) ∨ (2 ≤ f ∧ IsG2 2 f (K ⧸ Subgroup.center K)) ∨
      (1 ≤ f ∧ Is3D4 2 f (K ⧸ Subgroup.center K)) ∨
      (Odd f ∧ 3 ≤ f ∧ Is2F4 f (K ⧸ Subgroup.center K)))
    (hC : ∀ Y M₀ W : Subgroup (K ⧸ Subgroup.center K),
      C35Base (⊤ : Subgroup (K ⧸ Subgroup.center K)) Y M₀ W →
      (↥(⊤ : Subgroup (K ⧸ Subgroup.center K)) ⧸
        Subgroup.center ↥(⊤ : Subgroup (K ⧸ Subgroup.center K))) ≃* (K ⧸ Subgroup.center K) →
      C35Concl1 (⊤ : Subgroup (K ⧸ Subgroup.center K)) Y M₀ W) :
    ConclK K L V MK := by
  obtain ⟨-, hXs, hX⟩ := hK.quasisimple
  refine hK.conclK_of_bar_psl2 fun L' V' MK' h => ?_
  have hc := hC MK' L' V' (h.c35Base hXs hfam) (topQuotCenterEquiv hXs hX)
  refine ⟨h.conclKLeft_of_c35Concl1 hc, ?_⟩
  obtain ⟨n, -, -, hpsl, -⟩ := hc
  exact ⟨n, hpsl⟩

theorem forK_L3char2 :
    ForK (fun S _ => ∃ f : ℕ, 2 ≤ f ∧ StatedClassicalModel S .PSL 3 2 f) := by
  intro K _ _ L V MK hK ⟨f, hf, hm⟩
  refine hK.conclK_of_c35 ⟨f, Or.inl ⟨hf, hm⟩⟩ fun Y M₀ W hB e => ?_
  exact l3_holds_base _ ⊤ Y M₀ W hB f hf (IsPSL.of_mulEquiv e.symm hm)

theorem forK_Sp4char2 :
    ForK (fun S _ => ∃ f : ℕ, 2 ≤ f ∧ StatedClassicalModel S .PSp 2 2 f) := by
  intro K _ _ L V MK hK ⟨f, hf, hm⟩
  refine hK.conclK_of_c35 ⟨f, Or.inr (Or.inl ⟨hf, hm⟩)⟩ fun Y M₀ W hB e => ?_
  exact sp4_holds_base _ ⊤ Y M₀ W hB f hf (IsPSp4.of_mulEquiv e.symm hm)

theorem forK_G2char2 :
    ForK (fun S _ => ∃ f : ℕ, 2 ≤ f ∧ ChevalleyExceptionalModel S .G2 2 f) := by
  intro K _ _ L V MK hK ⟨f, hf, hm⟩
  refine hK.conclK_of_c35 ⟨f, Or.inr (Or.inr (Or.inl ⟨hf, hm⟩))⟩ fun Y M₀ W hB e => ?_
  exact g2_holds_base _ ⊤ Y M₀ W hB f hf (IsG2.of_mulEquiv e.symm hm)

theorem forK_D4char2 :
    ForK (fun S _ => ∃ f : ℕ, 1 ≤ f ∧ ChevalleyExceptionalModel S .trialityD4 2 f) := by
  intro K _ _ L V MK hK ⟨f, hf, hm⟩
  refine hK.conclK_of_c35 ⟨f, Or.inr (Or.inr (Or.inr (Or.inl ⟨hf, hm⟩)))⟩
    fun Y M₀ W hB e => ?_
  exact d4_holds_base _ ⊤ Y M₀ W hB f hf (Is3D4.of_mulEquiv e.symm hm)

theorem forK_F4char2 :
    ForK (fun S _ => ∃ f : ℕ, Odd f ∧ 3 ≤ f ∧ ReeTitsModel S .twistedF4 2 f) := by
  intro K _ _ L V MK hK ⟨f, hfo, hf, hm⟩
  refine hK.conclK_of_c35 ⟨f, Or.inr (Or.inr (Or.inr (Or.inr ⟨hfo, hf, hm⟩)))⟩
    fun Y M₀ W hB e => ?_
  exact f4_holds_base _ ⊤ Y M₀ W hB f hfo hf (Is2F4.of_mulEquiv e.symm hm)

theorem for_L3char2
    (h37 : A37ForSQTK) (h38 : A38ForSQTK) (h39 : A39ForSQTK) :
    For (fun S _ => ∃ f : ℕ, 1 ≤ f ∧ StatedClassicalModel S .PSL 3 2 f) := by
  intro G _ _ T M L B Tp VB K hH ⟨f, hf, hm⟩
  rcases (show f = 1 ∨ 2 ≤ f by omega) with rfl | hf2
  · exact for_L32 G T M L B Tp VB K hH hm
  · exact For.of_forK h37 h38 h39 forK_L3char2 G T M L B Tp VB K hH ⟨f, hf2, hm⟩

theorem for_Sp4char2
    (h37 : A37ForSQTK) (h38 : A38ForSQTK) (h39 : A39ForSQTK) :
    For (fun S _ => ∃ f : ℕ, 2 ≤ f ∧ StatedClassicalModel S .PSp 2 2 f) :=
  For.of_forK h37 h38 h39 forK_Sp4char2

