open Subgroup CFSG.Blueprint CFSG.Assembly.LowTwoRank

theorem layer_not_dvd_card_center_of_not_sq_dvd {Y : Type} [Group Y] [Finite Y] [Group.IsPerfect Y]
    {r : ℕ} (hr : r.Prime) (h : ¬ r ^ 2 ∣ Nat.card (Y ⧸ center Y)) :
    ¬ r ∣ Nat.card (center Y) := by
  intro hdvd
  have : Fact r.Prime := ⟨hr⟩
  have hπ : Function.Surjective (QuotientGroup.mk' (center Y)) := QuotientGroup.mk'_surjective _
  have hC : (QuotientGroup.mk' (center Y)).ker ≤ center Y := (QuotientGroup.ker_mk' _).le
  obtain ⟨Cd⟩ := (inferInstance : Nonempty (Sylow r (QuotientGroup.mk' (center Y)).ker))
  obtain ⟨Q⟩ := (inferInstance : Nonempty (Sylow r (Y ⧸ center Y)))
  have hdvd' : r ∣ Nat.card (QuotientGroup.mk' (center Y)).ker := by
    rw [QuotientGroup.ker_mk']
    exact hdvd
  exact Sylow.ne_bot_of_dvd_card Cd hdvd'
    (ShultStronglyClosedTI.central_cover_cyclic_sylow_kernel_eq_bot _ hπ hC Cd Q
      (CFSG.SectionRank.sylow_isCyclic_of_not_sq_dvd h Q))

section Real

open CoverB

theorem layer_realLocalElement_of_involution {S : Type} [Group S] {t x d : S} (ht2 : t ^ 2 = 1)
    (ht1 : t ≠ 1) (hxt : Commute x t) (hx3 : x ^ 3 = 1) (hx1 : x ≠ 1)
    (hd : d * x * d⁻¹ = x⁻¹) : RealLocalElement S 3 := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact ⟨zpowers t, fun h => ht1 (Subgroup.mem_bot.mp (h ▸ mem_zpowers t)),
    isPGroup_zpowers_of_sq ht2, x, mem_normalizer_zpowers hxt, orderOf_eq_prime hx3 hx1, d, hd⟩

theorem layer_realLocalElement_of_six {S : Type} [Group S] {g d : S} (h6 : g ^ 6 = 1)
    (h2 : g ^ 2 ≠ 1) (h3 : g ^ 3 ≠ 1) (hd : d * g * d⁻¹ = g⁻¹) : RealLocalElement S 3 := by
  refine layer_realLocalElement_of_involution (t := g ^ 3) (x := g ^ 2) (d := d) ?_ h3 ?_ ?_ h2 ?_
  · rw [← pow_mul]
    exact h6
  · exact (Commute.refl g).pow_pow 2 3
  · rw [← pow_mul]
    exact h6
  · rw [← conj_pow, hd, inv_pow]

theorem layer_realLocalElement_subgroup_of_six {G : Type} [Group G] {H : Subgroup G} {g a : G}
    (hg : g ∈ H) (ha : a ∈ H) (h6 : g ^ 6 = 1) (h2 : g ^ 2 ≠ 1) (h3 : g ^ 3 ≠ 1)
    (hd : a * g * a⁻¹ = g⁻¹) : RealLocalElement ↥H 3 := by
  refine layer_realLocalElement_of_six (g := (⟨g, hg⟩ : H)) (d := ⟨a, ha⟩) ?_ ?_ ?_ ?_
  · exact Subtype.ext (by simpa using h6)
  · intro h
    exact h2 (by simpa using congrArg Subtype.val h)
  · intro h
    exact h3 (by simpa using congrArg Subtype.val h)
  · exact Subtype.ext (by simpa using hd)

open Equiv in
theorem layer_realLocalElement_alt_eight : RealLocalElement (alternatingGroup (Fin 8)) 3 := by
  have hs : Perm.sign (swap (0 : Fin 8) 1 * swap 1 2) = 1 ∧
      Perm.sign (swap (3 : Fin 8) 4 * swap 5 6) = 1 ∧
      Perm.sign (swap (0 : Fin 8) 1 * swap 3 4) = 1 := by decide +kernel
  have hr : (swap (3 : Fin 8) 4 * swap 5 6) ^ 2 = 1 ∧ swap (3 : Fin 8) 4 * swap 5 6 ≠ 1 ∧
      (swap (0 : Fin 8) 1 * swap 1 2) * (swap 3 4 * swap 5 6) =
        (swap 3 4 * swap 5 6) * (swap 0 1 * swap 1 2) ∧
      (swap (0 : Fin 8) 1 * swap 1 2) ^ 3 = 1 ∧ swap (0 : Fin 8) 1 * swap 1 2 ≠ 1 ∧
      (swap (0 : Fin 8) 1 * swap 3 4) * (swap 0 1 * swap 1 2) * (swap (0 : Fin 8) 1 * swap 3 4)⁻¹ =
        (swap (0 : Fin 8) 1 * swap 1 2)⁻¹ := by decide +kernel
  obtain ⟨hr1, hr2, hr3, hr4, hr5, hr6⟩ := hr
  refine layer_realLocalElement_of_involution
    (t := (⟨swap 3 4 * swap 5 6, hs.2.1⟩ : alternatingGroup (Fin 8)))
    (x := (⟨swap 0 1 * swap 1 2, hs.1⟩ : alternatingGroup (Fin 8)))
    (d := (⟨swap 0 1 * swap 3 4, hs.2.2⟩ : alternatingGroup (Fin 8)))
    (Subtype.ext (by simpa using hr1))
    (fun h => hr2 (by simpa using congrArg Subtype.val h))
    (Subtype.ext hr3)
    (Subtype.ext (by simpa using hr4))
    (fun h => hr5 (by simpa using congrArg Subtype.val h))
    (Subtype.ext (by simpa using hr6))

private theorem m11_real_rels : (abWord m11a m11b [0, 1, 1]) ^ 6 = 1 ∧
    (abWord m11a m11b [0, 1, 1]) ^ 2 ≠ 1 ∧ (abWord m11a m11b [0, 1, 1]) ^ 3 ≠ 1 ∧
    m11a * abWord m11a m11b [0, 1, 1] * m11a⁻¹ = (abWord m11a m11b [0, 1, 1])⁻¹ := by
  decide +kernel

private theorem m23_real_rels : (abWord m23a m23b [0, 1, 1]) ^ 6 = 1 ∧
    (abWord m23a m23b [0, 1, 1]) ^ 2 ≠ 1 ∧ (abWord m23a m23b [0, 1, 1]) ^ 3 ≠ 1 ∧
    m23a * abWord m23a m23b [0, 1, 1] * m23a⁻¹ = (abWord m23a m23b [0, 1, 1])⁻¹ := by
  decide +kernel

theorem layer_realLocalElement_M11 : RealLocalElement (NativeSporadic.Carrier .M11) 3 := by
  have ha : m11a ∈ NativeSporadic.M11 := Subgroup.subset_closure (Set.mem_insert _ _)
  have hb : m11b ∈ NativeSporadic.M11 := Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)
  obtain ⟨h6, h2, h3, hd⟩ := m11_real_rels
  exact layer_realLocalElement_subgroup_of_six (abWord_mem ha hb [0, 1, 1]) ha h6 h2 h3 hd

theorem layer_realLocalElement_M23 : RealLocalElement (NativeSporadic.Carrier .M23) 3 := by
  have ha : m23a ∈ NativeSporadic.M23 := Subgroup.subset_closure (Set.mem_insert _ _)
  have hb : m23b ∈ NativeSporadic.M23 := Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)
  obtain ⟨h6, h2, h3, hd⟩ := m23_real_rels
  exact layer_realLocalElement_subgroup_of_six (abWord_mem ha hb [0, 1, 1]) ha h6 h2 h3 hd

end Real

section Excl

open CoverB

theorem layer_false_of_realLocalElement_three {H : Type} [Group H] [Finite H]
    (he : CFSG.Open.evenRank H ≤ 2) {L₁ L₂ : Subgroup H} (h₁ : CFSG.IsComponent L₁)
    (h₂ : CFSG.IsComponent L₂) (hne : L₁ ≠ L₂) (φ : ↥L₁ ≃* ↥L₂) {T : Type} [Group T]
    (e : ↥L₁ ⧸ center ↥L₁ ≃* T) (hT : RealLocalElement T 3)
    (hrZ : 3 ∣ Nat.card (center ↥L₁)) : False := by
  obtain ⟨R, hR, hR2, x, hxN, hx, d, hd⟩ := RealLocalElement.of_mulEquiv e hT
  exact false_of_components he (layer_commute_of_distinct_components h₁ h₂ hne) φ Nat.prime_three
    (by norm_num) hR hR2 hxN hx (Or.inl ⟨d, hd⟩) fun h => absurd hrZ h

theorem layer_false_of_u4_three {H : Type} [Group H] [Finite H] (he : CFSG.Open.evenRank H ≤ 2)
    {L₁ L₂ : Subgroup H} (h₁ : CFSG.IsComponent L₁) (h₂ : CFSG.IsComponent L₂) (hne : L₁ ≠ L₂)
    (hm : StatedClassicalModel (↥L₁ ⧸ center ↥L₁) .PSU 4 3 1)
    (hrZ : 3 ∣ Nat.card (center ↥L₁)) : False := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨eX⟩ := CFSG.LieType.Multipliers.U43.nonempty_mulEquiv_X₀
    (lieModel_of_statedClassicalModel hm)
  let φ : ↥L₁ →* CFSG.LieType.Multipliers.U43.X₀ :=
    eX.toMonoidHom.comp (QuotientGroup.mk' (center ↥L₁))
  have hφ : Function.Surjective φ := eX.surjective.comp (QuotientGroup.mk'_surjective _)
  have hker : φ.ker = center ↥L₁ := by
    ext g
    simp [φ, MonoidHom.mem_ker, QuotientGroup.eq_one_iff]
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' (G := ↥(center ↥L₁)) 3 hrZ
  have hzo : orderOf (z : ↥L₁) = 3 := by rw [Subgroup.orderOf_coe, hz]
  have hz3 : (z : ↥L₁) ^ 3 = 1 := by rw [← hzo]; exact pow_orderOf_eq_one _
  have h4 := CFSG.RankThree.PartTwo.KFacts.OutFixCentralThree.U43Rank.four_le_pRank_of_cover φ hφ
    hker.le (Z := zpowers (z : ↥L₁)) (by rw [hker]; exact zpowers_le.mpr z.2)
    (fun w hw => by
      obtain ⟨k, rfl⟩ := mem_zpowers_iff.mp hw
      rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hz3, one_zpow])
    (by rw [Nat.card_zpowers, hzo])
  have h2 := layer_pRank_component_le_two he h₁ h₂ hne Nat.prime_three (by norm_num)
  omega

theorem layer_false_of_g2_three
    {H : Type} [Group H] [Finite H] (he : CFSG.Open.evenRank H ≤ 2)
    {L₁ L₂ : Subgroup H} (h₁ : CFSG.IsComponent L₁) (h₂ : CFSG.IsComponent L₂) (hne : L₁ ≠ L₂)
    (hm : ChevalleyExceptionalModel (↥L₁ ⧸ center ↥L₁) .G2 3 1) : False := by
  have h3 := (CFSG.SectionRank.g2_odd_central_cover_rank_three (G := ↥L₁) (center ↥L₁) le_rfl
    Nat.prime_three (by norm_num) hm).1
  rw [CFSG.SectionRank.pRank_eq_open_pRank_top] at h3
  have h2 := layer_pRank_component_le_two he h₁ h₂ hne Nat.prime_three (by norm_num)
  omega

theorem layerPairJ3_of_realLocalElement (h : RealLocalElement (NativeSporadic.Carrier .J3) 3) :
    LayerPairJ3 := by
  intro H _ _ he _ L₁ L₂ h₁ h₂ hne ⟨φ⟩ ⟨e⟩ hrZ
  exact layer_false_of_realLocalElement_three he h₁ h₂ hne φ e h hrZ

