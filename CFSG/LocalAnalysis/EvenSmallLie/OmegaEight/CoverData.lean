  (w.map fun x => cond x.2 (gens x.1) (gens x.1)⁻¹).prod

@[expose] def hWord : List (Fin 4 × Bool) := parse "TbTBt"

@[expose] def extraRels : List (List (Fin 4 × Bool)) :=
  [parse "sss", parse "saSA", parse "sbSB", hWord ++ [(3, true)] ++ FreeGroup.invRev hWord ++
    [(3, true)], parse "tststs"]

@[expose] def rels : List (List (Fin 4 × Bool)) := SympSix.rels.map liftW ++ extraRels

@[expose] def pairs : Fin 4 → List (List (Fin 4 × Bool) × List (Fin 4 × Bool))
  | 0 => (SympSix.coverPairs 0).map fun p => (liftW p.1, liftW p.2)
  | 1 => (SympSix.coverPairs 1).map fun p => (liftW p.1, liftW p.2)
  | 2 => (SympSix.coverPairs 2).map fun p => (liftW p.1, liftW p.2)
  | 3 => [(hWord, [(3, true)])]

abbrev coverWs : List (List (Fin 4 × Bool)) := coverWords rels fun i => commWords (pairs i)

