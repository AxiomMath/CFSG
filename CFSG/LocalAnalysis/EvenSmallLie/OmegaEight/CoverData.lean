@[expose] def parse (str : String) : List (Fin 4 × Bool) :=
  str.toList.filterMap fun c =>
    if c = 'a' then some (0, true) else if c = 'A' then some (0, false)
    else if c = 'b' then some (1, true) else if c = 'B' then some (1, false)
    else if c = 't' then some (2, true) else if c = 'T' then some (2, false)
    else if c = 's' then some (3, true) else if c = 'S' then some (3, false) else none

@[expose] def liftW (w : List (Fin 3 × Bool)) : List (Fin 4 × Bool) :=
  w.map fun l => (Fin.castSucc l.1, l.2)

@[expose] def cycPerm (n : ℕ) [NeZero n] (cs : List (List ℕ)) : Equiv.Perm (Fin n) :=
  tab ((cs.map fun c => (c.map (Fin.ofNat n)).formPerm).prod)

