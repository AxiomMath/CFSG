@[expose] def sLeavesCheck : Bool :=
  (List.range 8).all fun k => sLeavesLit.getD k [] == sAutData.fSearch sMul sInv k

@[expose] def sLeaves (k : ℕ) : List (List ℕ) := sLeavesLit.getD k []

@[expose] def sFm (k m : ℕ) : ℕ → ℕ := sAutData.F sMul k ((sLeaves k).getD m [])

@[expose] def sWTab (k m : ℕ) : Array ℕ :=
  (List.range 128).toArray.map fun e => wprodN sMul 7 (sAutData.ys sMul k ((sLeaves k).getD m [])) e

@[expose] def sLTab (k : ℕ) : Array ℕ := (List.range 512).toArray.map fun a => a9K.lin (sAutData.Pk k a)

@[expose] def sFTab (k m : ℕ) : Array ℕ :=
  let W := sWTab k m
  let L := sLTab k
  (List.range 65536).toArray.map fun x =>
    sMul (if sAutData.nfE x < 128 then W[sAutData.nfE x]!
        else wprodN sMul 7 (sAutData.ys sMul k ((sLeaves k).getD m [])) (sAutData.nfE x))
      (if sAutData.nfA x < 512 then L[sAutData.nfA x]! else a9K.lin (sAutData.Pk k (sAutData.nfA x)))

@[expose] def sFixE (F : ℕ → ℕ) : Bool := (List.range 128).all fun c => decide (F c < 128)

@[expose] def sZList (F : ℕ → ℕ) : List ℕ :=
  let FF := sGens.map fun g => F (F g)
  (List.range 65536).filter fun z =>
    ((List.range sGens.length).all fun j => sMul z (sGens.getD j 0) == sMul (FF.getD j 0) z) &&
      F z == z

@[expose] def t1Cands : List (ℕ × ℕ × ℕ) :=
  (List.range 8).flatMap fun k => (List.range (sLeaves k).length).flatMap fun m =>
    if sFixE (sFm k m) then [] else (sZList (sFm k m)).map fun z => (k, m, z)

@[expose] def t1Mul (F : Array ℕ) (z : ℕ) : ℕ → ℕ → ℕ := extMul 65536 sMul (fun c => F[c]!) z

@[expose] def t1Inv (F : Array ℕ) (z : ℕ) : ℕ → ℕ := extInv 65536 sMul sInv (fun c => F[c]!) z

@[expose] def t1Gens : List ℕ := sGens ++ [65536]

@[expose] def sMarked : List (ℕ × (ℕ × ℕ)) := [(64, (1439, 10336)), (75, (1439, 9312))]

@[expose] def chiB (n : ℕ) : List Bool := (List.range n).map fun j => j == 1

@[expose] def chiS (N : ℕ) : Array Bool :=
  Array.ofFn (n := N) fun c => (sAutData.nfE (c.val % 65536)).testBit 1

@[expose] def sKill : Bool :=
  groupKillC sMul sInv sGens 65536 4 false (chiB 9) (chiS 65536) sMarked sClsLit

@[expose] def t1Cls (k m z : ℕ) : List (ℕ × ℕ) :=
  ((t1ClsLit.find? fun p => p.1 == (k, m, z)).map Prod.snd).getD []

@[expose] def t1Kill (k m z : ℕ) (n5 : Bool) (ts : List (ℕ × (ℕ × ℕ))) : Bool :=
  let F := sFTab k m
  groupKillC (t1Mul F z) (t1Inv F z) t1Gens 131072 8 n5 (chiB 10) (chiS 131072) ts (t1Cls k m z)

@[expose] def fpList : List ℕ := (List.range 128).map (sFm 0 16)

@[expose] def fpArr : Array Bool := Array.ofFn (n := 65536) fun c => fpList.contains c.val

@[expose] def sMapF (F : ℕ → ℕ) : Bool := (List.range 128).all fun c => fpArr[F c]!

