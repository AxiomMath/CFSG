@[expose] def t1EnumCheck : Bool :=
  sLeavesCheck &&
  ((List.range 8).all fun k => (List.range (sLeaves k).length).all fun m =>
    sFixE (sFm k m) || sMapF (sFm k m)) &&
  (t1Cands.all fun c => t1List.any fun d => d.1 == c.1 && d.2.1 == c.2.1 && d.2.2.1 == c.2.2) &&
  sKill

@[expose] def t1KillRange (a : ℕ) : Bool :=
  ((t1List.drop a).take 10).all fun d => t1Kill d.1 d.2.1 d.2.2.1 d.2.2.2 sMarked

