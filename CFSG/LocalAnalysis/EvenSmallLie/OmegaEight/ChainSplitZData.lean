@[expose] def tilGen (ε : Eps) (g : ℕ) : Array (Array ℕ) :=
  if g < 6 then prod4 ε ((uWords ε).getD g []) else xTil ε

@[expose] def treeCheck (ε : Eps) : Bool :=
  (List.range 127).all fun i =>
    let e := (tilTree ε).getD (i + 1) (0, 0)
    decide (e.1 < i + 1) && decide (e.2 < 7) &&
      tilGet ε (i + 1) == mul4 (tilGen ε e.2) (tilGet ε e.1)

@[expose] def dot4 (f v : Array ℕ) : ℕ := (∑ k : Fin 6, f.getD k 0 * v.getD k 0) % 4

@[expose] def zTest (ε : Eps) (M : Array (Array ℕ)) (n : ℕ) : Bool :=
  (zAnn ε).all fun f => dot4 f (mv4 (sub4 one4 M) (dig4 n)) == 0

@[expose] def zCount (ε : Eps) (n : ℕ) : ℕ :=
  ((List.range 128).filter fun j => zTest ε (tilGet ε j) n).length +
    ((List.range 128).filter fun j =>
      (zAnn ε).all fun f => dot4 f (mv4 (add4 one4 (tilGet ε j)) (dig4 n)) == 0).length

@[expose] def zCheck (ε : Eps) : Bool :=
  let Tz := tilGet ε (zTil ε)
  let Tr := tilGet ε (zRoot ε)
  treeCheck ε && ((List.range 128).all fun j => mul4 Tz (tilGet ε j) == mul4 (tilGet ε j) Tz) &&
    fix4c Tz == 64 && decide (zTil ε < 128) && decide (zRoot ε < 128) && mul4 Tr Tr == Tz &&
    ((zAnn ε).all fun f => (List.range 4096).all fun n =>
      dot4 f (mv4 (sub4 one4 Tz) (dig4 n)) == 0) &&
    ((zWit ε).all fun w =>
      mv4 (if w.2.2 then add4 one4 Tr else sub4 one4 Tr) (dig4 w.2.1) == dig4 w.1) &&
    (List.range 4096).all fun n => !(mv4 (add4 one4 Tz) (dig4 n) == dig4 0) ||
      (zWit ε).any (fun w => w.1 == n) || decide (zCount ε n ≤ 128)

