@[expose] def zTil : Eps → ℕ
  | .plus => 4
  | .minus => 1

@[expose] def dec4 (c : Array ℕ) : Array (Array ℕ) :=
  Array.ofFn (n := 6) fun i => dig4 (c.getD i 0)

@[expose] def xTil (ε : Eps) : Array (Array ℕ) := dec4 (xCode ε)

@[expose] def tilGet (ε : Eps) (i : ℕ) : Array (Array ℕ) := dec4 ((tilCodes ε).getD i #[])

@[expose] def tilIdx (ε : Eps) (M : Array (Array ℕ)) : ℕ :=
  ((List.range 128).find? fun i => tilGet ε i == M).getD 128

@[expose] def red2 (M : Array (Array ℕ)) : Array ℕ :=
  Array.ofFn (n := 6) fun i => bitsOf 6 fun j => m4Get M i j % 2 == 1

@[expose] def fix4c (M : Array (Array ℕ)) : ℕ :=
  ((List.range 4096).filter fun n => mv4 M (dig4 n) == dig4 n).length

@[expose] def fix2c (R : Array ℕ) : ℕ :=
  ((List.range 64).filter fun x => bmulVec 6 6 R x == x).length

@[expose] def isInvol4 (M : Array (Array ℕ)) : Bool := red2 (mul4 M M) == id6 && !(red2 M == id6)

@[expose] def centc (ε : Eps) (M : Array (Array ℕ)) : ℕ :=
  ((List.range 128).filter fun j => mul4 M (tilGet ε j) == mul4 (tilGet ε j) M).length

@[expose] def xCheck (ε : Eps) : Bool :=
  let X := xTil ε
  let r := CPrime.reflRows ε (n0 ε)
  mul4 X X == one4 && red2 X == r &&
    (List.range 6).all fun s => mul4 (mul4 X (ptil4 ε s)) X == prod4 ε ((reflWords ε).getD s []) &&
      wordRows ε ((reflWords ε).getD s []) == bmul 6 6 r (bmul 6 6 (genRows ε s) r)

@[expose] def tabCheck (ε : Eps) : Bool :=
  tilGet ε 0 == one4 && tilIdx ε (xTil ε) < 128 &&
    ((List.range 6).all fun k => wordRows ε ((uWords ε).getD k []) == uRows ε k &&
      tilIdx ε (prod4 ε ((uWords ε).getD k [])) < 128) &&
    ((List.range 128).all fun i => (List.range 128).all fun j =>
      tilIdx ε (mul4 (tilGet ε i) (tilGet ε j)) < 128) &&
    (List.range 128).all fun i => (List.range 128).all fun j =>
      i == j || !(red2 (tilGet ε i) == red2 (tilGet ε j))

@[expose] def invCheckS (ε : Eps) : Bool :=
  (List.range 128).all fun i =>
    let M := tilGet ε i
    !isInvol4 M || (decide (128 * fix2c (red2 M) < 64 * fix4c M) &&
      (i == zTil ε || decide (256 < 2 * fix4c M) || decide (2 * fix4c M * centc ε M < 16384)))

@[expose] def tilCheck (ε : Eps) : Bool := xCheck ε && tabCheck ε && invCheckS ε

end CFSG.EvenSmallLie.OmegaEight.Chain
