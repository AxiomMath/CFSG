@[expose] def s0Get (ε : Eps) (i : ℕ) : Array ℕ := (s0List ε).getD i id6

@[expose] def s0Idx (ε : Eps) (M : Array ℕ) : ℕ := ((s0List ε).findIdx? (· == M)).getD 64

@[expose] def mulTab (ε : Eps) : Array (Array ℕ) :=
  Array.ofFn (n := 64) fun i => Array.ofFn (n := 64) fun j =>
    s0Idx ε (bmul 6 6 (s0Get ε i) (s0Get ε j))

@[expose] def tabGet (T : Array (Array ℕ)) (i j : ℕ) : ℕ := (T.getD i #[]).getD j 0

@[expose] def imgMask (T : Array (Array ℕ)) (m y : ℕ) : ℕ :=
  bitsOf 64 fun b => (List.range 64).any fun a => m.testBit a && tabGet T a y == b

@[expose] def closeY (T : Array (Array ℕ)) (y : ℕ) : ℕ → ℕ → ℕ
  | 0, m => m
  | n + 1, m => closeY T y n (m ||| imgMask T m y)

@[expose] def commAll (T : Array (Array ℕ)) (m y : ℕ) : Bool :=
  (List.range 64).all fun a => !m.testBit a || tabGet T a y == tabGet T y a

@[expose] def popcount64 (m : ℕ) : ℕ := ((List.range 64).filter fun a => m.testBit a).length

@[expose] def fixMask (ε : Eps) (m : ℕ) : ℕ :=
  ((List.range 64).filter fun z => (List.range 64).all fun a =>
    !m.testBit a || bmulVec 6 6 (s0Get ε a) z == z).length

@[expose] def treeOk (ε : Eps) (i : ℕ) : Bool :=
  let e := (s0Tree ε).getD i (0, 0)
  e.2 < i && e.1 < 6 && bmul 6 6 (uRows ε e.1) (s0Get ε e.2) == s0Get ε i

@[expose] def s0Check (ε : Eps) : Bool :=
  let T := mulTab ε
  (s0List ε).size == 64 && s0Get ε 0 == id6 &&
    ((List.range 64).all fun i => (List.range 64).all fun j => i == j ||
      (List.range 64).any fun z => bmulVec 6 6 (s0Get ε i) z != bmulVec 6 6 (s0Get ε j) z) &&
    ((List.range 6).all fun k => s0Idx ε (uRows ε k) < 64 &&
      s0Get ε (s0Idx ε (uRows ε k)) == uRows ε k) &&
    ((List.range 64).all fun i => (List.range 64).all fun j => tabGet T i j < 64 &&
      s0Get ε (tabGet T i j) == bmul 6 6 (s0Get ε i) (s0Get ε j)) &&
    ((List.range 64).all fun i => (List.range 64).any fun j => tabGet T i j == 0) &&
    ((List.range 64).all fun y => tabGet T 0 y == y) &&
    (List.range 63).all fun i => treeOk ε (i + 1)

@[expose] def abelCheck (ε : Eps) : Bool :=
  let T := mulTab ε
  let L := abelMasks ε
  L.contains 1 && (L.all fun m => m < 2 ^ 64) &&
    (L.all fun m => (List.range 64).all fun y =>
      m.testBit y || !commAll T m y || L.contains (closeY T y 8 m)) &&
    L.all fun m => popcount64 m * fixMask ε m ≤ 64

