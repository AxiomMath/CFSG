@[expose] def witProd (w : List (ℕ × ℕ)) : ℕ :=
  w.foldl (fun acc ra => mulU acc (commHU ra.2 (2 ^ ra.1))) 0

@[expose] def letterOK (X : ℕ) (ra : ℕ × ℕ) : Bool :=
  ra.1 < 24 && ra.2 < 4 && hOK ra.2 (2 ^ ra.1) && hOK ra.2 X && hU ra.2 X == X &&
    mulU (2 ^ ra.1) X == mulU X (2 ^ ra.1)

@[expose] def witOK (X : ℕ) (w : List (ℕ × ℕ)) : Bool :=
  w.all (letterOK X) && mulU (witProd w) (witProd w) == X

@[expose] def genOK (X : ℕ) (ws : List (List (ℕ × ℕ))) : Bool :=
  (List.range 25).all fun k => (ws.getD k []).all (letterOK X) && witProd (ws.getD k []) == 2 ^ k

