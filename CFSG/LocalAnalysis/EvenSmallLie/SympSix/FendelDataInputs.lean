@[expose] def fendelWit : Array Nat := hexTable 8 1024 0 fendelWitText

@[expose] def fendelWitConj (w : Nat) : Array Nat :=
  fendelMArr ((w / 16 ^ 5) % 256) ((w / 16 ^ 3) % 256) ((w / 16) % 256) (w % 16)

@[expose] def fendelWitOK (a b c : Nat) : Bool :=
  let x := fendelTArr a b c
  let w := fendelWit[(a * 4 + b) * 2 + c]!
  let h := fendelWitConj w
  eqA 276 x (idA 276) || !(eqA 276 (compA 276 x x) (idA 276)) ||
    (w / 16 ^ 7 == 0 && eqA 276 x co3ZArr) ||
    (w / 16 ^ 7 == 1 && isInvA 276 h (invCand 276 h) && siftA 276 co3MLevels co3MBaseArr 0 h &&
      eqA 276 (compA 276 h x) (compA 276 fendelAArr h)) ||
    (w / 16 ^ 7 == 2 && isInvA 276 h (invCand 276 h) && siftA 276 co3MLevels co3MBaseArr 0 h &&
      eqA 276 (compA 276 h x) (compA 276 co3TtArr h))

