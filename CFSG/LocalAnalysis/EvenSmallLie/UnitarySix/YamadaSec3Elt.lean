@[expose] def sIntAt (a : Array ℕ) : Bool :=
  (a[381]! != 381 || (siftA 693 lvS chS.B 0 (conjA 693 au₂ a) == siftA 693 lvT2 chT2.B 0 a)) &&
  (a[1]! != 1 || ((siftA 693 lvS chS.B 0 (conjA 693 au₁ a) == siftA 693 lvT1 chT1.B 0 a) &&
    (eqA 693 a (idA 693) || !(siftA 693 lvS chS.B 0 (conjA 693 aw₀ a)))))

@[expose] def sIntFix : Bool :=
  au₂[381]! == 0 && au₁[1]! == 0 && aw₀[1]! == 0 && chT2.O.all (fun s => s[381]! == 381) &&
    chT1.O.all fun s => s[1]! == 1

@[expose] def t2IntAt (a : Array ℕ) : Bool :=
  (siftA 693 lvT2 chT2.B 0 (conjA 693 aab a) == siftA 693 lvX1 chX1.B 0 a) &&
  (siftA 693 lvT2 chT2.B 0 (conjA 693 aba a) == siftA 693 lvX2 chX2.B 0 a) &&
  (eqA 693 a (idA 693) || !(siftA 693 lvT2 chT2.B 0 (conjA 693 aaba a)))

@[expose] def t1IntAt (a : Array ℕ) : Bool :=
  siftA 693 lvT1 chT1.B 0 (conjA 693 abcb a) == siftA 693 lvX3 chX3.B 0 a

@[expose] def ka1At (a : Array ℕ) : Bool :=
  eqA 693 a (idA 693) || (a[1]! != 1 && !(siftA 693 lvK1 chK1.B 0 a))

@[expose] def ka2At (a : Array ℕ) : Bool :=
  eqA 693 a (idA 693) || (!(siftA 693 lvK2 chK2.B 0 a) &&
    !(siftA 693 lvK2A2 chK2A2.B 0 (conjA 693 au₂ a)))

