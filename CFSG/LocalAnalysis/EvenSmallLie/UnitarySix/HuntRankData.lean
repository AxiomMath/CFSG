@[expose] def decodeT (k : ℕ) : Table :=
  Array.ofFn (n := 22) fun i => UInt32.ofNat (k / 32 ^ (21 - i.val) % 32)

@[expose] def keyT (t : Table) : ℕ := (List.range 22).foldl (fun acc i => acc * 32 + ap t i) 0

@[expose] def ptvArr : Array ℕ :=
  #[1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 215, 851, 738, 623, 1012, 357, 378, 462, 604, 969,
    959, 249]

@[expose] def actM (t : Table) (m : ℕ) : ℕ :=
  (List.finRange 22).foldl
    (fun acc (i : Fin 22) => if m.testBit i then acc ^^^ ptvArr.getD (ap t i) 0 else acc) 0

@[expose] def newGen (span : List Table) (y : Table) : Bool :=
  !(span.contains y) && span.all fun s => keyT y ≤ keyT (compT 22 y s)

@[expose] def node (B : ℕ) : ℕ → List Table → List ℕ → List Table → Bool
  | 0, _, _, _ => false
  | fuel + 1, span, fix, rest =>
    decide (span.length * fix.length ≤ B) &&
      rest.tails.all fun
        | [] => true
        | y :: ys => !(newGen span y) ||
          node B fuel (span ++ span.map (compT 22 y)) (fix.filter fun m => actM y m == m)
            (ys.filter fun z => compT 22 y z == compT 22 z y)

@[expose] def fixMasks (t : Table) : List ℕ := (List.range 1024).filter fun m => actM t m == m

@[expose] def rootCheck (B : ℕ) (T : Table) (C : List Table) : Bool :=
  node B 8 [idT 22, T] (fixMasks T) C

@[expose] def tableF (f : Fin 22 → Fin 22) : Table := Array.ofFn fun i => UInt32.ofNat (f i).val

@[expose] def sqMulB (s f : Fin 22 → Fin 22) : Bool :=
  (List.finRange 22).all fun i => f (s (f (s i))) == i

@[expose] def sqB (f : Fin 22 → Fin 22) : Bool := (List.finRange 22).all fun i => f (f i) == i

@[expose] def commB (r f : Fin 22 → Fin 22) : Bool :=
  (List.finRange 22).all fun i => f (r i) == r (f i)

@[expose] def eqB (r f : Fin 22 → Fin 22) : Bool := (List.finRange 22).all fun i => f i == r i

@[expose] def missOut (r : Fin 22 → Fin 22) (C : List Table) (f : Fin 22 → Fin 22) : Bool :=
  sqB f && commB r f && !eqB id f &&
    (!C.contains (tableF f) || !C.contains (tableF fun i => f (r i)))

@[expose] def missIn (r : Fin 22 → Fin 22) (C : List Table) (f : Fin 22 → Fin 22) : Bool :=
  sqB f && commB r f && !eqB id f && !eqB r f && !C.contains (tableF f)

