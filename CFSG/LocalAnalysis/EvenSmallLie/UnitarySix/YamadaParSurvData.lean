@[expose] def uCheck : Bool :=
  [0, 3].all fun z =>
    ((List.range 11).all fun k =>
      lineConjBits z (wordBits (uXW z k)) (wordBits (uYW z k)) == gens16Bits z k) &&
    ((List.range 2).all fun s =>
      word16Bits z (uTW z 0 s) == lineConjBits z (genBits (Fin.ofNat 3 s)) id8 &&
      word16Bits z (uTW z 1 s) == lineConjBits z id8 (genBits (Fin.ofNat 3 s)))

@[expose] def basisBits (z i : ℕ) : Array ℕ := if i < 4 then aBits i else candBits z (i - 4)

