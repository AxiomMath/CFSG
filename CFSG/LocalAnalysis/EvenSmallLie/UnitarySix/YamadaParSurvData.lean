@[expose] def eProdBits (mask : ℕ) : Array ℕ :=
  (List.range 4).foldl (fun acc m => if mask.testBit m then bmul 8 8 acc (eBits m) else acc) id8

@[expose] def c2W0 : List (Fin 3) := [1, 0, 2, 0, 1, 1]

@[expose] def c2W1 : List (Fin 3) := [1, 0, 2, 2, 0]

@[expose] def c2Check : Bool :=
  bmul 8 8 (genBits 0) (wordBits c2W0) == bmul 8 8 (wordBits c2W0) (eProdBits 4) &&
  bmul 8 8 (genBits 1) (wordBits c2W1) ==
    bmul 8 8 (bmul 8 8 (bmul 8 8 (bmul 8 8 (bmul 8 8 (eProdBits 8) (genBits 0)) (eProdBits 11))
      (genBits 0)) (wordBits c2W1)) (eProdBits 5)

@[expose] def cCheck : Bool :=
  ((List.range 4).all fun z => (List.range 8).all fun i =>
    basisBits z i == (c1W z i).foldl (fun acc p =>
      bxor 8 acc (bxor 8 (bmul 8 8 (bmul 8 8 (n0Bits p.1) (basisBits z p.2)) (n1Bits p.1))
        (basisBits z p.2))) zero8) &&
  c2Check


@[expose] def tCheck : Bool :=
  ([1, 2].all fun z => (List.range 4).all fun a => (List.range 4).all fun b => a == b ||
    [1, 2, 3].all fun k =>
      bmul 16 16 (bmul 16 16 tBits16 (rhoTrBits z (Fin.ofNat 4 a) (Fin.ofNat 4 b) k)) tBits16 ==
        rhoTrBits z (piJ (Fin.ofNat 4 b)) (piJ (Fin.ofNat 4 a)) (frobCode k)) &&
  [0, 3].all fun z => (List.range 3).all fun s =>
    bmul 16 16 (bmul 16 16 tBits16 (lineConjBits z (genBits (Fin.ofNat 3 s)) id8)) tBits16 ==
      lineConjBits z id8 (genBits (Fin.ofNat 3 s))

