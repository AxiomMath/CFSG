@[expose] def lIdx (z a b k : ℕ) : ℕ := 48 * (z - 1) + 12 * a + 3 * b + (k - 1)

@[expose] def lGW (z a b k : ℕ) : List ℕ := lGWList.getD (lIdx z a b k) []

@[expose] def lCheck : Bool :=
  [1, 2].all fun z =>
    ((List.range 3).all fun s => trProdBits z (lKW s) == rho16 (genBits (Fin.ofNat 3 s))) &&
    ((List.range 8).all fun k => trProdBits z (lDW z k) == dGen z k) &&
    ((List.range 4).all fun a => (List.range 4).all fun b => a == b ||
      [1, 2, 3].all fun k =>
        rhoTrBits z (Fin.ofNat 4 a) (Fin.ofNat 4 b) k == word16Bits z (lGW z a b k))

