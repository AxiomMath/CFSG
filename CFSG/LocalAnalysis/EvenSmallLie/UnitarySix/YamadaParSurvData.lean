@[expose] def piJ (i : Fin 4) : Fin 4 := ⟨((i : ℕ) + 2) % 4, Nat.mod_lt _ (by norm_num)⟩

@[expose] def reBit (α β γ : ℕ) : Bool :=
  if β = 0 then (if γ = 0 then α % 2 == 1 else α / 2 % 2 == 1)
  else (if γ = 0 then α / 2 % 2 == 1 else (α % 2 + α / 2) % 2 == 1)

@[expose] def reBits (M : Fin 4 → Fin 4 → ℕ) : Array ℕ :=
  Array.ofFn (n := 8) fun r => bitsOf 8 fun col =>
    reBit (M ⟨(r : ℕ) / 2, by omega⟩ (Fin.ofNat 4 (col / 2))) ((r : ℕ) % 2) (col % 2)

@[expose] def bdiagBits (A B : Array ℕ) : Array ℕ :=
  Array.ofFn (n := 16) fun r =>
    if (r : ℕ) < 8 then A.getD r 0 % 256 else (B.getD (r - 8) 0 % 256) <<< 8

@[expose] def lineBits (z : ℕ) : Array ℕ :=
  if z < 2 then #[256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 257, 514, 1028, 2056, 4112, 8224,
    16448, 32896]
  else #[257, 514, 1028, 2056, 4112, 8224, 16448, 32896, 770, 259, 3080, 1036, 12320, 4144, 49280,
    16576]

@[expose] def lineInvBits (z : ℕ) : Array ℕ :=
  if z < 2 then #[257, 514, 1028, 2056, 4112, 8224, 16448, 32896, 1, 2, 4, 8, 16, 32, 64, 128]
  else #[259, 513, 1036, 2052, 4144, 8208, 16576, 32832, 258, 515, 1032, 2060, 4128, 8240, 16512,
    32960]

@[expose] def lineConjBits (z : ℕ) (A B : Array ℕ) : Array ℕ :=
  bmul 16 16 (bmul 16 16 (lineBits z) (bdiagBits A B)) (lineInvBits z)

@[expose] def trCode (a b : Fin 4) (k : ℕ) (i j : Fin 4) : ℕ :=
  if i = j then 1 else if i = a ∧ j = b then k else 0

@[expose] def frobCode (k : ℕ) : ℕ := if k = 2 then 3 else if k = 3 then 2 else k

@[expose] def rhoTrBits (z : ℕ) (a b : Fin 4) (k : ℕ) : Array ℕ :=
  lineConjBits z (reBits (trCode a b k)) (reBits (trCode (piJ b) (piJ a) (frobCode k)))

@[expose] def gens16Bits (z l : ℕ) : Array ℕ :=
  if l < 3 then rho16 (genBits (Fin.ofNat 3 l)) else dGen z (l - 3)

@[expose] def word16Bits (z : ℕ) (w : List ℕ) : Array ℕ :=
  w.foldl (fun acc l => bmul 16 16 acc (gens16Bits z l)) id16

@[expose] def trProdBits (z : ℕ) (w : List (ℕ × ℕ × ℕ)) : Array ℕ :=
  w.foldl (fun acc t => bmul 16 16 acc (rhoTrBits z (Fin.ofNat 4 t.1) (Fin.ofNat 4 t.2.1) t.2.2))
    id16

