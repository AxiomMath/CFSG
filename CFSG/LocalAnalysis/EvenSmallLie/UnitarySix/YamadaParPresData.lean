@[expose] def uPresX : List ℕ := [0, 2, 3, 0, 1]

@[expose] def uPresY : List ℕ := [0, 3, 1, 2, 0, 3, 1, 4, 1, 0, 3]

@[expose] def tBitsOf (a : ℕ) : Array ℕ := wordBits (uPresGenW a)

@[expose] def tProdBits (w : List ℕ) : Array ℕ :=
  w.foldl (fun acc a => bmul 8 8 acc (tBitsOf a)) id8

@[expose] def bpow8 (A : Array ℕ) (m : ℕ) : Array ℕ :=
  (List.range m).foldl (fun acc _ => bmul 8 8 acc A) id8

@[expose] def uRelWord (r : List ℕ × List ℕ × ℕ) : List (Fin 5 × Bool) :=
  ((List.replicate r.2.2 (r.1 ++ r.2.1)).flatten).map fun a => (Fin.ofNat 5 a, true)

@[expose] def uWS : List (List (Fin 5 × Bool)) := uPresSpecs.map uRelWord

@[expose] def uRelCheck : Bool :=
  uPresSpecs.all fun r => bIsId 8 (bpow8 (bmul 8 8 (tProdBits r.1) (tProdBits r.2.1)) r.2.2)

@[expose] def uGenCheck : Bool := tProdBits uPresX == genBits 0 && tProdBits uPresY == genBits 1

