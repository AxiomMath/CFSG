theorem false_of_isStronglyEmbedded_perfect
    {X : Type} [Group X] [Finite X] [IsSimpleGroup X]
    {M : Subgroup X} (hM : CFSG.IsStronglyEmbedded M) {V : Subgroup X} (hV : Nat.card V = 4)
    (hV2 : ∀ v ∈ V, v ^ 2 = 1) {a : X} (ha : orderOf a = 2) {L : Subgroup X}
    (hLa : L ≤ centralizer ({a} : Set X)) (hperf : ⁅L, L⁆ = L) (hL : L ≠ ⊥) : False := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hO : ∀ R : Subgroup X, R.Normal → Odd (Nat.card R) → R = ⊥ := by
    intro R hR hodd
    have := hR
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal R with hb | ht
    · exact hb
    · exfalso
      rw [ht, card_top] at hodd
      have h2 : 2 ∣ Nat.card X := ha ▸ orderOf_dvd_natCard a
      exact (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr h2)
  have hF : fusionStronglyEmbedded M := hM
  have hsol : Group.IsSolvable M :=
    CFSG.Holt.isSolvable_of_fusionStronglyEmbedded hF hO hV hV2
  have hSO : CFSG.BenderSuzuki.IsStronglyEmbeddedOrder M :=
    (CFSG.Goldschmidt.LemmaX.isStronglyEmbeddedOrder_iff M).mpr hF
  obtain ⟨t, ht⟩ := exists_prime_orderOf_dvd_card' (G := M) 2 (even_iff_two_dvd.mp hM.2.1)
  have ht2 : orderOf (t : X) = 2 := by rw [Subgroup.orderOf_coe, ht]
  obtain ⟨c, hc⟩ : ∃ c : X, centralizer ({a} : Set X) ≤ M.map (MulAut.conj c).toMonoidHom := by
    by_cases haM : a ∈ M
    · refine ⟨1, fun x hx => ⟨x, ?_, by simp⟩⟩
      exact CFSG.Goldschmidt.centralizer_le_of_stronglyEmbedded hSO ha haM hx
    · obtain ⟨c, hc⟩ :=
        isConj_iff.mp (CFSG.Goldschmidt.isConj_of_mem_of_not_mem hSO ht2 ha t.2 haM)
      refine ⟨c, fun x hx => ⟨c⁻¹ * x * c, ?_, ?_⟩⟩
      · show c⁻¹ * x * c ∈ M
        apply CFSG.Goldschmidt.centralizer_le_of_stronglyEmbedded hSO ht2 t.2
        rw [mem_centralizer_singleton_iff] at hx ⊢
        have ht' : (t : X) = c⁻¹ * a * c := by rw [← hc]; group
        rw [ht']
        calc c⁻¹ * x * c * (c⁻¹ * a * c) = c⁻¹ * (x * a) * c := by group
          _ = c⁻¹ * (a * x) * c := by rw [hx]
          _ = c⁻¹ * a * c * (c⁻¹ * x * c) := by group
      · simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
        group
  have hM's : Group.IsSolvable (M.map (MulAut.conj c).toMonoidHom) :=
    Group.isSolvable_of_surjective (f := ((MulAut.conj c).subgroupMap M).toMonoidHom)
      ((MulAut.conj c).subgroupMap M).surjective
  have hLs : Group.IsSolvable L :=
    Group.isSolvable_of_isSolvable_injective (f := inclusion (hLa.trans hc))
      (inclusion_injective (hLa.trans hc))
  have htop : (⊤ : Subgroup L) ≠ ⊥ := by
    intro h
    apply hL
    rw [eq_bot_iff]
    intro x hx
    have h1 : (⟨x, hx⟩ : L) ∈ (⊤ : Subgroup L) := mem_top _
    rw [h, mem_bot] at h1
    rw [mem_bot]
    exact congrArg Subtype.val h1
  have hcomm : ⁅(⊤ : Subgroup L), (⊤ : Subgroup L)⁆ = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : (x : X) ∈ ⁅L, L⁆ := by rw [hperf]; exact x.2
    have h1 : ⁅L, L⁆ = (⁅(⊤ : Subgroup L), (⊤ : Subgroup L)⁆).map L.subtype := by
      rw [map_commutator, ← MonoidHom.range_eq_map, range_subtype]
    rw [h1] at hx
    obtain ⟨y, hy, hyx⟩ := hx
    rwa [show y = x from Subtype.ext hyx] at hy
  exact (Group.IsSolvable.commutator_lt_of_ne_bot htop).ne hcomm

theorem range_eq_bot_of_l34Type {L : Type} [Group L] [Finite L]
    {Y : Type} [Fintype Y] [DecidableEq Y] (hperf : commutator L = ⊤)
    (hL : IsL34Type (L ⧸ Open.fusionZStar L)) (π : L →* Perm Y) (hn : π.range.Normal) :
    π.range = ⊥ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  by_contra hne
  obtain ⟨h5, hrange⟩ := five_le_card_and_range_eq hperf π hn hne
  have hsA := alternatingGroup.isSimpleGroup h5
  have : Nontrivial Y := by
    rw [← Finite.one_lt_card_iff_nontrivial]
    omega
  let φ : L →* alternatingGroup Y :=
    π.codRestrict (alternatingGroup Y) fun l => by rw [← hrange]; exact ⟨l, rfl⟩
  have hφ : Function.Surjective φ := fun y => by
    have hy : (y : Perm Y) ∈ π.range := by rw [hrange]; exact y.2
    obtain ⟨l, hl⟩ := hy
    exact ⟨l, Subtype.ext hl⟩
  have hcardA : 2 * Nat.card (alternatingGroup Y) = (Nat.card Y).factorial := by
    rw [two_mul_nat_card_alternatingGroup, Nat.card_perm]
  have hevA : 2 ∣ Nat.card (alternatingGroup Y) := by
    have h4 : 4 ∣ (Nat.card Y).factorial := Nat.dvd_factorial (by norm_num) (by omega)
    omega
  have hO : pPrimeCore 2 L ≤ φ.ker := by
    have hnm : ((pPrimeCore 2 L).map φ).Normal := Normal.map inferInstance φ hφ
    rcases hsA.eq_bot_or_eq_top_of_normal ((pPrimeCore 2 L).map φ) with hb | ht
    · exact (Subgroup.map_eq_bot_iff _).mp hb
    · exfalso
      have hdvd := card_map_dvd (pPrimeCore 2 L) φ
      rw [ht, card_top] at hdvd
      exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mp
        ((pPrimeCore_coprime_card (p := 2) (G := L)).coprime_dvd_right hdvd) hevA
  have hZA : center (alternatingGroup Y) = ⊥ := by
    rcases hsA.eq_bot_or_eq_top_of_normal (center (alternatingGroup Y)) with h | h
    · exact h
    · exfalso
      have hk := ker_eq_top_of_forall_comm hperf φ fun a b => by
        have ha : φ a ∈ center (alternatingGroup Y) := h ▸ mem_top _
        exact (mem_center_iff.mp ha (φ b)).symm
      obtain ⟨x, y, hxy⟩ := exists_pair_ne (alternatingGroup Y)
      obtain ⟨x', rfl⟩ := hφ x
      obtain ⟨y', rfl⟩ := hφ y
      exact hxy ((MonoidHom.mem_ker.mp (hk ▸ mem_top x')).trans
        (MonoidHom.mem_ker.mp (hk ▸ mem_top y')).symm)
  have hZ : Open.fusionZStar L ≤ φ.ker := by
    intro z hz
    have hcen : φ z ∈ center (alternatingGroup Y) := by
      rw [mem_center_iff]
      intro g
      obtain ⟨m, rfl⟩ := hφ g
      have h1 : φ ⁅z, m⁆ = 1 := hO ((GSThmB.OddQuot.mem_fusionZStar_iff.mp hz) m)
      rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm] at h1
      exact h1.symm
    rw [hZA, mem_bot] at hcen
    exact hcen
  have hsQ : IsSimpleGroup (L ⧸ Open.fusionZStar L) := HeInner.isSimpleGroup_of_l34 hL
  let ψ := QuotientGroup.lift (Open.fusionZStar L) φ hZ
  have hψ : Function.Surjective ψ := QuotientGroup.lift_surjective_of_surjective _ φ hφ hZ
  rcases hsQ.eq_bot_or_eq_top_of_normal ψ.ker with hb | ht
  · have e : (L ⧸ Open.fusionZStar L) ≃* alternatingGroup Y :=
      MulEquiv.ofBijective ψ ⟨(MonoidHom.ker_eq_bot_iff ψ).mp hb, hψ⟩
    have h5' : 5 ≤ Fintype.card Y := by rwa [← Nat.card_eq_fintype_card]
    exact CatLeaf.not_isL34Type_of_isAltType ⟨Y, inferInstance, inferInstance, h5', ⟨e⟩⟩ hL
  · obtain ⟨x, y, hxy⟩ := exists_pair_ne (alternatingGroup Y)
    obtain ⟨x', rfl⟩ := hψ x
    obtain ⟨y', rfl⟩ := hψ y
    have hx : x' ∈ ψ.ker := ht ▸ mem_top x'
    have hy : y' ∈ ψ.ker := ht ▸ mem_top y'
    rw [MonoidHom.mem_ker] at hx hy
    exact hxy (hx.trans hy.symm)

theorem false_of_mulEquiv_alternatingGroup_l34 {X : Type}
    [Group X] [Finite X] {n : ℕ} (e : X ≃* alternatingGroup (Fin n)) {a : X} (ha : orderOf a = 2)
    {L : Subgroup X} (hLa : L ≤ centralizer ({a} : Set X))
    (hCN : centralizer ({a} : Set X) ≤ normalizer (L : Set X))
    (hLc : IsPComponent 2 (L.subgroupOf (centralizer ({a} : Set X))))
    (hL : IsL34Type (L ⧸ Open.fusionZStar L)) : False := by
  let ε : X →* Perm (Fin n) := (alternatingGroup (Fin n)).subtype.comp e.toMonoidHom
  have hinj : Function.Injective ε := Subtype.val_injective.comp e.injective
  have hsurj : ∀ p ∈ alternatingGroup (Fin n), ∃ x, ε x = p := fun p hp =>
    ⟨e.symm ⟨p, hp⟩, by simp [ε]⟩
  have ha1 : ε a ≠ 1 := by
    intro h1
    have h2 : a = 1 := hinj (by rw [h1, map_one])
    rw [h2, orderOf_one] at ha
    exact absurd ha (by norm_num)
  have ha2 : ε a * ε a = 1 := by
    rw [← map_mul, ← sq, ← ha, pow_orderOf_eq_one, map_one]
  have hperf : commutator L = ⊤ := by
    have := CatalogueBAlternating.pComponent_perfect hLc
    have : Group.IsPerfect L := Group.IsPerfect.ofSurjective
      (f := (subgroupOfEquivOfLe hLa).toMonoidHom) (subgroupOfEquivOfLe hLa).surjective
    exact Group.IsPerfect.commutator_eq_top
  have hLn : (L.subgroupOf (centralizer ({a} : Set X))).Normal :=
    (normal_subgroupOf_iff_le_normalizer hLa).mpr hCN
  let π₁ := (quotP ε a).comp (inclusion hLa)
  let π₂ := (quotF ε a).comp (inclusion hLa)
  have hn₁ : π₁.range.Normal := by
    rw [MonoidHom.range_comp, inclusion_range]
    exact hLn.map _ (quotP_surjective hinj hsurj ha1 ha2)
  have hn₂ : π₂.range.Normal := by
    rw [MonoidHom.range_comp, inclusion_range]
    exact hLn.map _ (quotF_surjective hinj hsurj ha1 ha2)
  have h₁ := range_eq_bot_of_l34Type hperf hL π₁ hn₁
  have h₂ := range_eq_bot_of_l34Type hperf hL π₂ hn₂
  have e₁ : ∀ l, π₁ l = 1 := fun l => by
    have : π₁ l ∈ π₁.range := ⟨l, rfl⟩
    rwa [h₁, mem_bot] at this
  have e₂ : ∀ l, π₂ l = 1 := fun l => by
    have : π₂ l ∈ π₂.range := ⟨l, rfl⟩
    rwa [h₂, mem_bot] at this
  have hab : ∀ x y : L, x * y = y * x := fun x y => by
    apply inclusion_injective hLa
    rw [map_mul, map_mul]
    exact quot_comm hinj ha2 _ _ (e₁ x) (e₂ x) (e₁ y) (e₂ y)
  have hker := ker_eq_top_of_forall_comm hperf (MonoidHom.id L) hab
  have hL1 : ∀ l : L, l = 1 := fun l => MonoidHom.mem_ker.mp (hker ▸ mem_top l)
  have hQ1 : ∀ q : L ⧸ Open.fusionZStar L, q = 1 := fun q => by
    obtain ⟨l, rfl⟩ := QuotientGroup.mk_surjective q
    rw [hL1 l, QuotientGroup.mk_one]
  have : Subsingleton (L ⧸ Open.fusionZStar L) := ⟨fun x y => (hQ1 x).trans (hQ1 y).symm⟩
  have h1 := Nat.card_of_subsingleton (1 : L ⧸ Open.fusionZStar L)
  rw [CatLeaf.card_of_isL34Type hL] at h1
  omega

