section Frame

variable {A R : Subgroup G} {g : G} {E F : Subgroup G}

theorem mem_normalizer_of_conj_mem_R (hF : Frame G A A R g E F) {r n : G} (hr : r ∈ R)
    (hr1 : r ≠ 1) (hn : n * r * n⁻¹ ∈ R) : n ∈ normalizer (A : Set G) := by
  have hstd := hF.base.hyp.standard
  have hKte := AS76b.tightlyEmbedded_centralizer hstd
  have hNK := AS76b.normalizer_centralizer_eq hstd
  rw [← hNK]
  by_contra hnK
  have hodd' := hKte.2 n hnK
  have hrK : r ∈ centralizer (A : Set G) ⊓ rightConjugate (centralizer (A : Set G)) n :=
    ⟨hF.sylowR.le hr, (mem_rightConjugate_iff _ _ _).mpr (hF.sylowR.le hn)⟩
  have hord : orderOf r = 2 := orderOf_eq_prime (hF.elemR.2 r hr) hr1
  have h2 : 2 ∣ Nat.card (centralizer (A : Set G) ⊓
      rightConjugate (centralizer (A : Set G)) n : Subgroup G) := by
    rw [← hord]
    exact Subgroup.orderOf_dvd_natCard _ hrK
  exact (Nat.not_even_iff_odd.mpr hodd') (even_iff_two_dvd.mpr h2)

theorem mem_R_of_mem_centralizer (hF : Frame G A A R g E F) {c : G}
    (hcK : c ∈ centralizer (A : Set G)) (hcR : c ∈ normalizer (R : Set G))
    (hc2 : ∃ k : ℕ, c ^ 2 ^ k = 1) : c ∈ R := by
  obtain ⟨k, hk⟩ := hc2
  have hX : IsPGroup 2 (R ⊔ zpowers c : Subgroup G) :=
    IsPGroup.to_sup_of_normal_left' hF.sylowR.isPGroup (Sec2Quot.isPGroup_zpowers_of_pow hk)
      (zpowers_le.mpr hcR)
  have heq := hF.sylowR.eq_of_le le_sup_left
    (sup_le hF.sylowR.le (zpowers_le.mpr hcK)) hX
  rw [← heq]
  exact mem_sup_right (mem_zpowers c)

theorem exists_conj_eq_of_sq_mem (hF : Frame G A A R g E F) {x : G}
    (hxR : x ∈ normalizer (R : Set G)) (hx2 : ∀ r ∈ R, x * x * r * (x * x)⁻¹ = r) :
    ∃ r ∈ R, r ≠ 1 ∧ x * r * x⁻¹ = r := by
  have hR4 := hF.cardR
  have hne : R ≠ ⊥ := fun h => by
    rw [h, Subgroup.card_bot] at hR4
    omega
  obtain ⟨⟨r₀, hr₀⟩, hr₀1⟩ := (Subgroup.ne_bot_iff_exists_ne_one).mp hne
  have hr₀1' : r₀ ≠ 1 := fun h => hr₀1 (Subtype.ext h)
  have hcomm : ∀ a ∈ R, ∀ b ∈ R, a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (hF.elemR.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  have hsq : ∀ a ∈ R, a * a = 1 := fun a ha => by rw [← sq]; exact hF.elemR.2 a ha
  by_cases hfix : x * r₀ * x⁻¹ = r₀
  · exact ⟨r₀, hr₀, hr₀1', hfix⟩
  · have hxr₀ : x * r₀ * x⁻¹ ∈ R := (mem_normalizer_iff.mp hxR r₀).mp hr₀
    refine ⟨r₀ * (x * r₀ * x⁻¹), R.mul_mem hr₀ hxr₀, fun h => hfix ?_, ?_⟩
    · have h1 := eq_inv_of_mul_eq_one_right h
      rw [h1, inv_eq_of_mul_eq_one_right (hsq r₀ hr₀)]
    · have h2 : x * (x * r₀ * x⁻¹) * x⁻¹ = r₀ := by
        have := hx2 r₀ hr₀
        calc x * (x * r₀ * x⁻¹) * x⁻¹ = x * x * r₀ * (x * x)⁻¹ := by group
          _ = r₀ := this
      calc x * (r₀ * (x * r₀ * x⁻¹)) * x⁻¹ = (x * r₀ * x⁻¹) * (x * (x * r₀ * x⁻¹) * x⁻¹) := by
            group
        _ = (x * r₀ * x⁻¹) * r₀ := by rw [h2]
        _ = r₀ * (x * r₀ * x⁻¹) := hcomm _ hxr₀ _ hr₀

end Frame

section Wsec

variable {A R : Subgroup G} {g : G} {E F : Subgroup G}

variable (h11 : Step11)
  {d : L34E16Cert} (hE16 : RankTwoL3Four.HypII.l34CheckWE16 d = true)
  (hF : Frame G A A R g E F) (hL : TypeL34 (rankTwoQuot A)) (hodd : Odd (Nat.card (center ↥A)))
  {y : G} (hyA : y ∈ A) (hyE : y ∈ normalizer (E : Set G))
  (hyU : ∀ u ∈ E ⊓ A, y * u * y⁻¹ = u → u = 1)
  (hy3 : ∀ p ∈ sec2P E, y * y * y * p = p * (y * y * y))

include h11 hE16 hF hL hodd hyA hyE hyU hy3

theorem exists_conj_mem_R_of_mem {x : G} (hx : x ∈ E) (hxU : x ∉ E ⊓ A) :
    ∃ w ∈ sec2W A E y, w * x * w⁻¹ ∈ R := by
  obtain ⟨hD, -⟩ := exists_pointsData h11 hE16 hF hL hodd
  obtain ⟨Q, hQ, hxQ⟩ := hD.cover x hx hxU
  obtain ⟨p, hp, rfl⟩ := exists_mem_sec2P_rightConjugate_eq h11 hE16 hF hL hodd Q hQ
  obtain ⟨w, hw, r, hr, hpe⟩ :=
    exists_eq_mul_of_mem_sec2P h11 hE16 hF hL hodd hyA hyE hyU hy3 ((sec2P E).inv_mem hp)
  refine ⟨w⁻¹, (sec2W A E y).inv_mem hw, ?_⟩
  rw [mem_rightConjugate_iff] at hxQ
  have hp' : p = r⁻¹ * w⁻¹ := by rw [← mul_inv_rev, ← hpe, inv_inv]
  rw [hp'] at hxQ
  have : w⁻¹ * x * w⁻¹⁻¹ = r * (r⁻¹ * w⁻¹ * x * (r⁻¹ * w⁻¹)⁻¹) * r⁻¹ := by group
  rw [this]
  exact R.mul_mem (R.mul_mem hr hxQ) (R.inv_mem hr)

theorem exists_mul_mem_normalizer_R {x : G} (hxE : x ∈ normalizer (E : Set G)) :
    ∃ w ∈ sec2W A E y, w * x ∈ normalizer (R : Set G) := by
  obtain ⟨hD, -⟩ := exists_pointsData h11 hE16 hF hL hodd
  have hpt := rightConjugate_mem_pointsIn hD.self_mem (inv_mem hxE)
  obtain ⟨p, hp, hpQ⟩ := exists_mem_sec2P_rightConjugate_eq h11 hE16 hF hL hodd _ hpt
  obtain ⟨w, hw, r, hr, hpe⟩ :=
    exists_eq_mul_of_mem_sec2P h11 hE16 hF hL hodd hyA hyE hyU hy3 ((sec2P E).inv_mem hp)
  refine ⟨w⁻¹, (sec2W A E y).inv_mem hw, (rightConjugate_eq_self_iff R _).mp ?_⟩
  have hw' : w⁻¹ * x = r * p * x := by
    have : w = p⁻¹ * r⁻¹ := by rw [hpe, mul_inv_cancel_right]
    rw [this]
    group
  have hrR : rightConjugate R r = R := (rightConjugate_eq_self_iff R r).mpr (le_normalizer hr)
  calc rightConjugate R (w⁻¹ * x) = rightConjugate (rightConjugate (rightConjugate R r) p) x := by
        rw [hw', rightConjugate_mul, rightConjugate_mul, mul_assoc]
    _ = rightConjugate (rightConjugate R x⁻¹) x := by rw [hrR, hpQ]
    _ = R := by rw [rightConjugate_mul, inv_mul_cancel, rightConjugate_one]

variable (hW : IsElemAbelian 2 (sec2W A E y))
include hW

theorem exists_conj_mem_of_mem_sec2P {x : G} (hx : x ∈ sec2P E) (hxW : x ∉ sec2W A E y)
    (hx2 : x * x = 1) : ∃ w ∈ sec2W A E y, w * x * w⁻¹ ∈ R ∧ w * x * w⁻¹ ≠ 1 := by
  obtain ⟨-, hUW, -⟩ := sec2W_facts h11 hE16 hF hL hodd hyA hyE hyU hy3
  have hxE := mem_of_mem_sec2P_of_mul_self_eq_one h11 hE16 hF hL hodd hyA hyE hyU hy3 hW hx hxW
    hx2
  obtain ⟨w, hw, hwx⟩ := exists_conj_mem_R_of_mem h11 hE16 hF hL hodd hyA hyE hyU hy3 hxE
    fun h => hxW (hUW h)
  refine ⟨w, hw, hwx, fun h => hxW ?_⟩
  have : x = w⁻¹ * (w * x * w⁻¹) * w := by group
  rw [this, h, mul_one]
  exact (sec2W A E y).mul_mem ((sec2W A E y).inv_mem hw) hw

theorem card_inf_centralizer_le {x : G} (hxW : x ∈ normalizer (sec2W A E y : Set G))
    (hxR : x ∈ normalizer (R : Set G)) (hx2 : ∃ k : ℕ, x ^ 2 ^ k = 1) (hxW' : x ∉ sec2W A E y)
    {r : G} (hr : r ∈ R) (hr1 : r ≠ 1) (hxr : x * r * x⁻¹ = r) :
    Nat.card (sec2W A E y ⊓ centralizer ({x} : Set G) : Subgroup G) ≤ 16 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨hD, T₀, hT₀⟩ := exists_pointsData h11 hE16 hF hL hodd
  have hCE := mem_of_mem_centralizer_of_frame hF hL hodd
  obtain ⟨-, hUW, hWP, -, -, hPW, -⟩ := sec2W_facts h11 hE16 hF hL hodd hyA hyE hyU hy3
  set W := sec2W A E y with hWdef
  have hWc : ∀ a ∈ W, ∀ b ∈ W, a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (hW.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  have hxA := mem_normalizer_of_conj_mem_R hF hr hr1 (by rw [hxr]; exact hr)
  have hxU : x ∈ normalizer ((E ⊓ A : Subgroup G) : Set G) := by
    have := inf_normalizer_le_normalizer_inf ⟨hxW, hxA⟩
    rwa [sec2W_inf_eq h11 hE16 hF hL hodd hyA hyE hyU hy3] at this
  have hrW : r ∈ normalizer (W : Set G) := hPW (hF.R_le_E.trans
    (isElemQuot_sec2P h11 hE16 hF hL hodd).1 hr)
  by_cases h8 : 8 ≤ Nat.card ((E ⊓ A) ⊓ centralizer ({x} : Set G) : Subgroup G)
  · obtain ⟨u, hu, hc⟩ := exists_mem_inv_mul_mem_centralizer_of_card_le hF hL hodd hxA hxU h8
    have huR : u ∈ normalizer (R : Set G) := Subgroup.centralizer_le_normalizer _
      (mem_centralizer_iff.mpr fun r' hr' =>
        congrArg Subtype.val (hF.elemE.1.is_comm.comm ⟨r', hF.R_le_E hr'⟩ ⟨u, hu.1⟩))
    have hc2 : ∃ k : ℕ, (u⁻¹ * x) ^ 2 ^ k = 1 := by
      obtain ⟨k, hk⟩ := hx2
      have hX : IsPGroup 2 (W ⊔ zpowers x : Subgroup G) :=
        IsPGroup.to_sup_of_normal_left' (isPGroup_two_of_isElemAbelian hW)
          (Sec2Quot.isPGroup_zpowers_of_pow hk) (zpowers_le.mpr hxW)
      obtain ⟨j, hj⟩ := hX ⟨u⁻¹ * x, mul_mem (mem_sup_left (W.inv_mem (hUW hu)))
        (mem_sup_right (mem_zpowers x))⟩
      exact ⟨j, by simpa using congrArg Subtype.val hj⟩
    have hcR := mem_R_of_mem_centralizer hF hc (mul_mem (inv_mem huR) hxR) hc2
    have hc1 : u⁻¹ * x ≠ 1 := fun h => hxW' (by
      rw [show x = u * (u⁻¹ * x) by group, h, mul_one]
      exact hUW hu)
    have hle : W ⊓ centralizer ({x} : Set G) ≤ W ⊓ centralizer ({u⁻¹ * x} : Set G) := by
      intro w hw
      refine ⟨hw.1, mem_centralizer_singleton_iff.mpr ?_⟩
      have h1 : w * x = x * w := mem_centralizer_singleton_iff.mp hw.2
      have h2 : u⁻¹ * w = w * u⁻¹ := hWc _ (W.inv_mem (hUW hu)) _ hw.1
      calc w * (u⁻¹ * x) = u⁻¹ * (w * x) := by rw [← mul_assoc, ← h2, mul_assoc]
        _ = u⁻¹ * x * w := by rw [h1, mul_assoc]
    have := card_le_of_le hle
    rw [sec2W_inf_centralizer_eq h11 hE16 hF hL hodd hyA hyE hyU hy3 hW hcR hc1,
      card_inf_left hF hodd] at this
    exact this
  · push Not at h8
    set U₀ := (E ⊓ A) ⊓ centralizer ({x} : Set G) with hU₀
    have h4 : Nat.card U₀ ≤ 4 := by
      have hdvd : Nat.card U₀ ∣ 2 ^ 4 := by
        rw [show (2 : ℕ) ^ 4 = 16 by norm_num, ← card_inf_left hF hodd]
        exact Subgroup.card_dvd_of_le inf_le_left
      obtain ⟨j, hj, hj'⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd
      rw [hj'] at h8 ⊢
      have : j ≤ 2 := by
        by_contra hj2
        have : 2 ^ 3 ≤ 2 ^ j := Nat.pow_le_pow_right (by norm_num) (by omega)
        omega
      calc 2 ^ j ≤ 2 ^ 2 := Nat.pow_le_pow_right (by norm_num) this
        _ = 4 := by norm_num
    obtain ⟨δ, hδ⟩ := exists_commutatorHom hWc hrW
    set C₁ := W ⊓ centralizer ({x} : Set G) with hC₁
    have hcount := Sec2Quot.card_map_mul_card_inf_ker δ (C₁.subgroupOf W)
    have hU₀W : U₀ ≤ W := inf_le_left.trans hUW
    have hC₁W : C₁ ≤ W := inf_le_left
    rw [Nat.card_congr (subgroupOfEquivOfLe hC₁W).toEquiv] at hcount
    have hmap : (C₁.subgroupOf W).map δ ≤ U₀.subgroupOf W := by
      rintro _ ⟨w, hw, rfl⟩
      rw [mem_subgroupOf, hδ]
      have hw' : (w : G) ∈ C₁ := mem_subgroupOf.mp hw
      have hxw : x * w * x⁻¹ = w := by
        have h1 : (w : G) * x = x * w := mem_centralizer_singleton_iff.mp hw'.2
        rw [← h1, mul_inv_cancel_right]
      refine ⟨hD.commutator_mem hT₀ hCE hF.elemE (hF.R_le_E hr) (hWP w.2),
        mem_centralizer_singleton_iff.mpr ?_⟩
      have hxr' : x * r⁻¹ * x⁻¹ = r⁻¹ := by
        rw [show x * r⁻¹ * x⁻¹ = (x * r * x⁻¹)⁻¹ by group, hxr]
      have hxw' : x * (w : G)⁻¹ * x⁻¹ = (w : G)⁻¹ := by
        rw [show x * (w : G)⁻¹ * x⁻¹ = (x * w * x⁻¹)⁻¹ by group, hxw]
      have key : x * (r⁻¹ * (w : G)⁻¹ * r * w) * x⁻¹ = r⁻¹ * (w : G)⁻¹ * r * w := by
        calc x * (r⁻¹ * (w : G)⁻¹ * r * w) * x⁻¹
            = (x * r⁻¹ * x⁻¹) * (x * (w : G)⁻¹ * x⁻¹) * (x * r * x⁻¹) * (x * w * x⁻¹) := by group
          _ = r⁻¹ * (w : G)⁻¹ * r * w := by rw [hxr', hxw', hxr, hxw]
      calc r⁻¹ * (w : G)⁻¹ * r * w * x
          = x * (r⁻¹ * (w : G)⁻¹ * r * w) * x⁻¹ * x := by rw [key]
        _ = x * (r⁻¹ * (w : G)⁻¹ * r * w) := by group
    have hker : C₁.subgroupOf W ⊓ δ.ker ≤ U₀.subgroupOf W := by
      rintro w ⟨hw, hwk⟩
      have hw' : (w : G) ∈ C₁ := mem_subgroupOf.mp hw
      rw [mem_subgroupOf]
      refine ⟨?_, hw'.2⟩
      have h1 : r⁻¹ * (w : G)⁻¹ * r * w = 1 := by
        rw [← hδ, MonoidHom.mem_ker.mp hwk]
        rfl
      have hwr : (w : G) ∈ W ⊓ centralizer ({r} : Set G) := by
        refine ⟨w.2, mem_centralizer_singleton_iff.mpr ?_⟩
        have h3 : r * (w : G) = w * r := by
          calc r * (w : G) = (w * r) * (r⁻¹ * (w : G)⁻¹ * r * w) := by group
            _ = w * r := by rw [h1, mul_one]
        exact h3.symm
      rwa [sec2W_inf_centralizer_eq h11 hE16 hF hL hodd hyA hyE hyU hy3 hW hr hr1] at hwr
    have hU₀c : Nat.card (U₀.subgroupOf W) = Nat.card U₀ :=
      Nat.card_congr (subgroupOfEquivOfLe hU₀W).toEquiv
    have hc1 := card_le_of_le hmap
    have hc2 := card_le_of_le hker
    rw [hU₀c] at hc1 hc2
    calc Nat.card C₁ = Nat.card ((C₁.subgroupOf W).map δ) *
          Nat.card (C₁.subgroupOf W ⊓ δ.ker : Subgroup ↥W) := hcount.symm
      _ ≤ 4 * 4 := Nat.mul_le_mul (hc1.trans h4) (hc2.trans h4)
      _ = 16 := by norm_num

theorem exists_conj_eq_of_mul_self_eq_one {f : G} (hfA : f ∈ F ⊓ A)
    (hfW : f ∈ normalizer (sec2W A E y : Set G))
    (hC16 : Nat.card (sec2W A E y ⊓ centralizer ({f} : Set G) : Subgroup G) = 16) {w : G}
    (hw : w ∈ sec2W A E y) (hfw : f * w * (f * w) = 1) :
    ∃ v ∈ sec2W A E y, v * (f * w) * v⁻¹ = f := by
  set W := sec2W A E y with hWdef
  have hWc : ∀ a ∈ W, ∀ b ∈ W, a * b = b * a := fun a ha b hb =>
    congrArg Subtype.val (hW.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  have hWsq : ∀ a ∈ W, a * a = 1 := fun a ha => by rw [← sq]; exact hW.2 a ha
  have hff : f * f = 1 := by rw [← sq]; exact hF.elemF.2 f hfA.1
  have hfinv : f⁻¹ = f := inv_eq_of_mul_eq_one_left hff
  obtain ⟨δ, hδ⟩ := exists_commutatorHom hWc hfW
  have hW256 := card_sec2W h11 hE16 hF hL hodd hyA hyE hyU hy3
  set C₁ := W ⊓ centralizer ({f} : Set G) with hC₁
  have hC₁W : C₁ ≤ W := inf_le_left
  have hker : δ.ker = C₁.subgroupOf W := by
    ext v
    rw [MonoidHom.mem_ker, mem_subgroupOf]
    constructor
    · intro hv
      have h1 : f⁻¹ * (v : G)⁻¹ * f * v = 1 := by rw [← hδ, hv]; rfl
      refine ⟨v.2, mem_centralizer_singleton_iff.mpr ?_⟩
      have h2 : f * (v : G) = v * f := by
        calc f * (v : G) = (v * f) * (f⁻¹ * (v : G)⁻¹ * f * v) := by group
          _ = v * f := by rw [h1, mul_one]
      exact h2.symm
    · rintro ⟨-, hv⟩
      have h1 : (v : G) * f = f * v := mem_centralizer_singleton_iff.mp hv
      apply Subtype.ext
      rw [hδ]
      calc f⁻¹ * (v : G)⁻¹ * f * v = f⁻¹ * (v : G)⁻¹ * (f * v) := by group
        _ = f⁻¹ * (v : G)⁻¹ * (v * f) := by rw [h1]
        _ = 1 := by group
  have hrange : δ.range = C₁.subgroupOf W := by
    refine eq_of_le_of_card_ge ?_ ?_
    · rintro _ ⟨v, rfl⟩
      rw [mem_subgroupOf]
      refine ⟨(δ v).2, mem_centralizer_singleton_iff.mpr ?_⟩
      set d : G := ((δ v : ↥W) : G) with hddef
      have hd : d = f⁻¹ * (v : G)⁻¹ * f * v := hδ v
      have hdinv : d⁻¹ = d := inv_eq_of_mul_eq_one_left (hWsq _ (δ v).2)
      have e1 : f * d * f⁻¹ = d⁻¹ := by
        rw [hd]
        have l : f * (f⁻¹ * (v : G)⁻¹ * f * v) * f⁻¹ = (v : G)⁻¹ * f * v * f⁻¹ := by group
        have r : (f⁻¹ * (v : G)⁻¹ * f * v)⁻¹ = (v : G)⁻¹ * f⁻¹ * v * f := by group
        rw [l, r, hfinv]
      rw [hdinv] at e1
      calc d * f = f * d * f⁻¹ * f := by rw [e1]
        _ = f * d := by group
    · have h := Subgroup.card_ker_mul_card_range δ
      rw [hker, Nat.card_congr (subgroupOfEquivOfLe hC₁W).toEquiv, hC16, hW256] at h
      rw [Nat.card_congr (subgroupOfEquivOfLe hC₁W).toEquiv, hC16]
      omega
  have hwC : w ∈ C₁ := by
    refine ⟨hw, mem_centralizer_singleton_iff.mpr ?_⟩
    have h1 : f * w * f = w := by
      have := congrArg (· * w) hfw
      simp only [one_mul, mul_assoc] at this
      rw [hWsq w hw, mul_one] at this
      simpa [mul_assoc] using this
    calc w * f = (f * w * f) * f := by rw [h1]
      _ = f * w * (f * f) := by group
      _ = f * w := by rw [hff, mul_one]
  obtain ⟨v, hv⟩ : ⟨w, hw⟩ ∈ δ.range := by
    rw [hrange]
    exact mem_subgroupOf.mpr hwC
  refine ⟨v, v.2, ?_⟩
  have hv' : f⁻¹ * (v : G)⁻¹ * f * v = w := by rw [← hδ, hv]
  rw [← hv', hfinv]
  have hvv : (v : G)⁻¹ = v := inv_eq_of_mul_eq_one_left (hWsq v v.2)
  calc (v : G) * (f * (f * (v : G)⁻¹ * f * v)) * (v : G)⁻¹
      = v * (f * f) * (v : G)⁻¹ * f * (v * (v : G)⁻¹) := by group
    _ = f := by rw [hff]; group

end Wsec

