@[expose] def imgs (bt bY bu bv bw b2 : MC) : List MC :=
  [b2, bu, bw, bv, bu * bY * bu⁻¹ * bY⁻¹, bY, bt,
    bu * bY * bu⁻¹ * bY⁻¹ * (bw⁻¹ * bv⁻¹ * bw * bv)]

theorem stageA : ∀ i₁ i₂ i₃ i₄ i₅ : Fin 4,
    let c := 256 * i₁.val + 64 * i₂.val + 16 * i₃.val + 4 * i₄.val + i₅.val
    let m := ofCode (tget mATab 8 c)
    let r := tget rATab 5 c
    inR1 m = true ∧ r < 32 ∧
    m * Ct.getD i₁ 1 * m⁻¹ = rep r 0 ∧ m * Cy.getD i₂ 1 * m⁻¹ = rep r 1 ∧
    m * Cu.getD i₃ 1 * m⁻¹ = rep r 2 ∧ m * Cv.getD i₄ 1 * m⁻¹ = rep r 3 ∧
    m * Cw.getD i₅ 1 * m⁻¹ = rep r 4 := by
  decide +kernel

@[expose] def W2Rel (L : List MC) : Prop :=
  let w := L.getD 0 1; let u' := L.getD 1 1; let w₁' := L.getD 2 1; let v' := L.getD 3 1
  let z' := L.getD 4 1; let y' := L.getD 5 1; let t' := L.getD 6 1; let k' := L.getD 7 1
  w * w = 1 ∧ w * u' * w⁻¹ = u' * (w₁' * y') ∧ w * w₁' * w⁻¹ = w₁' * k' ∧
    w * v' * w⁻¹ = v' * (y' * k') ∧ w * z' * w⁻¹ = z' * k' ∧ w * y' * w⁻¹ = y' ∧
    w * t' * w⁻¹ = y' * (t' * k') ∧ w * k' * w⁻¹ = k'

instance (L : List MC) : Decidable (W2Rel L) := by unfold W2Rel; infer_instance

theorem stageB : ∀ r : Fin 32, ∀ n : Fin 71,
    W2Rel (imgs (rep r 0) (rep r 1) (rep r 2) (rep r 3) (rep r 4) (invList.getD n 1)) →
    let e := tget sBTab 12 (71 * r.val + n.val)
    let m := ofCode (e / 2 % 256)
    let j := e / 512
    inR1 m = true ∧ j < 8 ∧
    (imgs (rep r 0) (rep r 1) (rep r 2) (rep r 3) (rep r 4) (invList.getD n 1)).map
      (fun x => m * x * m⁻¹) = MC.gens.map (phiR ⟨j % 8, Nat.mod_lt _ (by norm_num)⟩) := by
  decide +kernel

