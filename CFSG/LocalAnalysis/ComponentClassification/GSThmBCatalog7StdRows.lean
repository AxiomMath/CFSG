open CFSG Subgroup

variable {H : Type} [Group H] [Finite H]

namespace StdConf

variable (c : StdConf H)

include c in
theorem exists_ne_commute_G : ∃ u v : ↥(generalizedFitting H), u * v ≠ v * u := by
  by_contra hc
  push Not at hc
  have hsimple := c.simple
  have hle : generalizedFitting H ≤ centralizer (generalizedFitting H : Set H) := by
    intro x hx
    rw [mem_centralizer_iff]
    intro y hy
    exact congrArg Subtype.val (hc ⟨y, hy⟩ ⟨x, hx⟩)
  rw [c.centralizer_eq_bot] at hle
  obtain ⟨u, v, huv⟩ := hsimple.toNontrivial
  apply huv
  exact Subtype.ext ((mem_bot.mp (hle u.2)).trans (mem_bot.mp (hle v.2)).symm)

include c in
theorem center_G_eq_bot : center ↥(generalizedFitting H) = ⊥ := by
  have := c.simple
  obtain ⟨u, v, huv⟩ := c.exists_ne_commute_G
  exact OutcomeLocal.center_eq_bot_of_isSimpleGroup ⟨u, v, huv⟩

end StdConf

@[expose] def RowL2 : Prop :=
  ∀ (H : Type) [Group H] [Finite H] (_ : StdConf H) (p f : ℕ), p.Prime → p ≠ 2 → 1 ≤ f →
    5 ≤ p ^ f → Blueprint.LieModel ↥(generalizedFitting H) .PSL 2 p f → False

@[expose] def RowL3 : Prop :=
  ∀ (H : Type) [Group H] [Finite H] (_ : StdConf H) (p f : ℕ), p.Prime → p ≠ 2 → 1 ≤ f →
    Blueprint.LieModel ↥(generalizedFitting H) .PSL 3 p f → False

@[expose] def RowU3 : Prop :=
  ∀ (H : Type) [Group H] [Finite H] (_ : StdConf H) (p f : ℕ), p.Prime → p ≠ 2 → 1 ≤ f →
    Blueprint.LieModel ↥(generalizedFitting H) .PSU 3 p f → False

@[expose] def RowL4 : Prop :=
  ∀ (H : Type) [Group H] [Finite H] (_ : StdConf H) (p f : ℕ), p.Prime → p ≠ 2 → 1 ≤ f →
    Blueprint.LieModel ↥(generalizedFitting H) .PSL 4 p f → False

@[expose] def RowU4 : Prop :=
  ∀ (H : Type) [Group H] [Finite H] (_ : StdConf H) (p f : ℕ), p.Prime → p ≠ 2 → 1 ≤ f →
    Blueprint.LieModel ↥(generalizedFitting H) .PSU 4 p f → False

@[expose] def RowPSp4 : Prop :=
  ∀ (H : Type) [Group H] [Finite H] (c : StdConf H) (p f : ℕ), p.Prime → p ≠ 2 → 1 ≤ f →
    Blueprint.LieModel ↥(generalizedFitting H) .PSp 2 p f → p = c.p ∧ f = c.f

@[expose] def RowOmegaMinus8 : Prop :=
  ∀ (H : Type) [Group H] [Finite H] (_ : StdConf H) (p f : ℕ), p.Prime → p ≠ 2 → 1 ≤ f →
    Blueprint.LieModel ↥(generalizedFitting H) .POmegaMinus 4 p f → False

@[expose] def RowRee : Prop :=
  ∀ (H : Type) [Group H] [Finite H] (_ : StdConf H) (m : ℕ), 1 ≤ m →
    Blueprint.LieModel ↥(generalizedFitting H) .twistedG2 0 3 (2 * m + 1) → False

@[expose] def RowEven : Prop :=
  ∀ (H : Type) [Group H] [Finite H] (_ : StdConf H),
    (Blueprint.LieModel ↥(generalizedFitting H) .PSL 2 2 4 ∨
      Blueprint.LieModel ↥(generalizedFitting H) .PSL 3 2 2 ∨
      Blueprint.LieModel ↥(generalizedFitting H) .PSU 3 2 2 ∨
      Blueprint.LieModel ↥(generalizedFitting H) .PSp 2 2 2 ∨
      Blueprint.LieModel ↥(generalizedFitting H) .PSL 5 2 1 ∨
      Blueprint.LieModel ↥(generalizedFitting H) .PSU 5 2 1 ∨
      Blueprint.LieModel ↥(generalizedFitting H) .PSL 3 2 4) → False

@[expose] def RowAlt : Prop :=
  ∀ (H : Type) [Group H] [Finite H] (_ : StdConf H) (n : ℕ), 7 ≤ n →
    Nonempty (↥(generalizedFitting H) ≃* alternatingGroup (Fin n)) → False

@[expose] def RowSporadic : Prop :=
  ∀ (H : Type) [Group H] [Finite H] (_ : StdConf H),
    (Blueprint.NativeSporadic.IsSporadic ↥(generalizedFitting H) .J1 ∨
      Blueprint.NativeSporadic.IsSporadic ↥(generalizedFitting H) .J2 ∨
      Blueprint.NativeSporadic.IsSporadic ↥(generalizedFitting H) .J3 ∨
      Blueprint.NativeSporadic.IsSporadic ↥(generalizedFitting H) .M12 ∨
      Blueprint.NativeSporadic.IsSporadic ↥(generalizedFitting H) .HS ∨
      Blueprint.NativeSporadic.IsSporadic ↥(generalizedFitting H) .He ∨
      Blueprint.NativeSporadic.IsSporadic ↥(generalizedFitting H) .ONan ∨
      Blueprint.NativeSporadic.IsSporadic ↥(generalizedFitting H) .Suz) → False

theorem gsRestricted_G (h : Hyp59 H)
    (hres : ∀ M : Subgroup H, IsComponent M → GSRestricted (↥M ⧸ center ↥M))
    (c : StdConf H) : GSRestricted ↥(generalizedFitting H) := by
  obtain ⟨hF, -, -, hcomp, -⟩ := h.generalizedFitting_simple
  rw [← hF] at hcomp
  have hr := hres _ hcomp
  exact OddQuot.gsRestricted_of_mulEquiv
    ((QuotientGroup.quotientMulEquivOfEq c.center_G_eq_bot).trans QuotientGroup.quotientBot) hr

theorem cfSp4RecognitionStd_of_rows (hL2 : RowL2) (hL3 : RowL3) (hU3 : RowU3) (hL4 : RowL4)
    (hU4 : RowU4) (hSp : RowPSp4) (hO : RowOmegaMinus8) (hRee : RowRee) (hEven : RowEven)
    (hAlt : RowAlt) (hSpor : RowSporadic) : CFSp4RecognitionStd := by
  intro H _ _ h hres hB hKa _ p f hp hp2 hf h5 hJL hKL
  obtain ⟨c, -, -, -, hcp, hcf⟩ := StdConf.ofHyp59 h hB hKa hp hp2 hf h5 hJL hKL
  rcases gsRestricted_G h hres c with ⟨p', f', hp', hp'2, hf', h5', hm⟩ |
      ⟨p', f', hp', hp'2, hf', hm⟩ | ⟨m, hm1, hm⟩ | h
  · exact (hL2 H c p' f' hp' hp'2 hf' h5' hm).elim
  · rcases hm with hm | hm | hm | hm | hm | hm | hm
    · refine (hL2 H c p' (2 * f') hp' hp'2 (by omega) ?_ hm).elim
      have h3 : 3 ≤ p' := by have := hp'.two_le; omega
      calc 5 ≤ 3 ^ 2 := by norm_num
        _ ≤ p' ^ 2 := Nat.pow_le_pow_left h3 2
        _ ≤ p' ^ (2 * f') := Nat.pow_le_pow_right hp'.pos (by omega)
    · exact (hL3 H c p' f' hp' hp'2 hf' hm).elim
    · exact (hU3 H c p' f' hp' hp'2 hf' hm).elim
    · exact (hL4 H c p' f' hp' hp'2 hf' hm).elim
    · exact (hU4 H c p' f' hp' hp'2 hf' hm).elim
    · obtain ⟨rfl, rfl⟩ := hSp H c p' f' hp' hp'2 hf' hm
      rw [hcp, hcf] at hm
      exact hm
    · exact (hO H c p' f' hp' hp'2 hf' hm).elim
  · exact (hRee H c m hm1 hm).elim
  · rcases h with h | h | h | h | h | h | h | ⟨n, hn, he⟩ | h | h | h | h | h | h | h | h
    · exact (hEven H c (Or.inl h)).elim
    · exact (hEven H c (Or.inr (Or.inl h))).elim
    · exact (hEven H c (Or.inr (Or.inr (Or.inl h)))).elim
    · exact (hEven H c (Or.inr (Or.inr (Or.inr (Or.inl h))))).elim
    · exact (hEven H c (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))).elim
    · exact (hEven H c (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))).elim
    · exact (hEven H c (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h))))))).elim
    · exact (hAlt H c n hn he).elim
    · exact (hSpor H c (Or.inl h)).elim
    · exact (hSpor H c (Or.inr (Or.inl h))).elim
    · exact (hSpor H c (Or.inr (Or.inr (Or.inl h)))).elim
    · exact (hSpor H c (Or.inr (Or.inr (Or.inr (Or.inl h))))).elim
    · exact (hSpor H c (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))).elim
    · exact (hSpor H c (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))).elim
    · exact (hSpor H c (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))).elim
    · exact (hSpor H c (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h)))))))).elim

