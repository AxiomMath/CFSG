section OddKer

variable {A B : Type*} [Group A] [Group B] [Finite A] [Finite B] (f : A →* B)
  (hf : ¬ 2 ∣ Nat.card f.ker)
include hf

theorem oddCoreIn_map_of_odd_ker (S : Subgroup A) :
    oddCoreIn (S.map f) = (oddCoreIn S).map f := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨-, h⟩ := prime_complement_kernel_core_preimage (p := 2) (f.subgroupMap S)
    (f.subgroupMap_surjective S) (GSThmB.OddQuot.not_two_dvd_card_ker_subgroupMap f hf S)
  simp only [oddCoreIn]
  rw [← h, Subgroup.map_map, Subgroup.map_map]
  rfl

theorem twoLayerIn_map_of_odd_ker (S : Subgroup A) :
    twoLayerIn (S.map f) = (twoLayerIn S).map f := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h := UnbalancingLocal.Correspondence.map_pLayer_of_coprime_kernel (p := 2)
    (f.subgroupMap S) (f.subgroupMap_surjective S)
    (GSThmB.OddQuot.not_two_dvd_card_ker_subgroupMap f hf S)
  simp only [twoLayerIn]
  rw [← h, Subgroup.map_map, Subgroup.map_map]
  rfl

omit [Finite A] [Finite B] hf in
theorem subgroupOf_map_eq_map_subgroupMap {J S : Subgroup A} (hJS : J ≤ S) :
    (J.map f).subgroupOf (S.map f) = (J.subgroupOf S).map (f.subgroupMap S) := by
  ext ⟨y, hy⟩
  simp only [Subgroup.mem_subgroupOf, Subgroup.mem_map]
  constructor
  · rintro ⟨j, hj, rfl⟩
    exact ⟨⟨j, hJS hj⟩, hj, rfl⟩
  · rintro ⟨⟨s, hs⟩, hsJ, hsy⟩
    exact ⟨s, hsJ, congrArg Subtype.val hsy⟩

theorem isTwoComponentIn_map_of_odd_ker {J S : Subgroup A} (h : IsTwoComponentIn J S) :
    IsTwoComponentIn (J.map f) (S.map f) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨hbij, -, -⟩ := CatalogueBPrimeJoin.prime_complement_quotient_p_component_bijection
    (p := 2) (f.subgroupMap S) (f.subgroupMap_surjective S)
    (GSThmB.OddQuot.not_two_dvd_card_ker_subgroupMap f hf S)
  refine ⟨Subgroup.map_mono h.1, ?_⟩
  rw [subgroupOf_map_eq_map_subgroupMap f h.1]
  exact hbij.mapsTo h.2

theorem isQuasisimple_quotient_map_of_odd_ker (S : Subgroup A)
    (h : IsQuasisimple (↥S ⧸ pPrimeCore 2 ↥S)) :
    IsQuasisimple (↥(S.map f) ⧸ pPrimeCore 2 ↥(S.map f)) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨e, -⟩ := CatalogueBPrimeJoin.exists_restrict_core_quotient_equiv (p := 2) f S
    (GSThmB.OddQuot.not_two_dvd_card_ker_domRestrict f hf S)
  exact isQuasisimple_of_mulEquiv e h

theorem pRank_map_of_odd_ker (S : Subgroup A) :
    CFSG.Open.pRank 2 (S.map f) = CFSG.Open.pRank 2 S := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hodd : ¬ 2 ∣ Nat.card (f.ker.subgroupOf S) := fun h2 => hf (h2.trans (by
    rw [← Subgroup.card_map_of_injective S.subtype_injective, Subgroup.subgroupOf_map_subtype]
    exact Subgroup.card_dvd_of_le inf_le_left))
  have hker : (f.subgroupMap S).ker = f.ker.subgroupOf S := by
    ext x
    simp [MonoidHom.mem_ker, mem_subgroupOf, Subtype.ext_iff]
  let e : S ⧸ f.ker.subgroupOf S ≃* S.map f :=
    (QuotientGroup.quotientMulEquivOfEq hker.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective _ (MonoidHom.subgroupMap_surjective f S))
  rw [SectionRank.pRank_eq_pRank_top_subgroup S, SectionRank.pRank_eq_pRank_top_subgroup (S.map f),
    ← SectionRank.pRank_quotient_eq _ hodd, SectionRank.pRank_top_eq_of_mulEquiv (by norm_num) e]

end OddKer

section Coprime

variable {G : Type*} [Group G] [Finite G]

theorem exists_mem_inf_centralizer_of_comm_mem {L S O' : Subgroup G} (hS : IsPGroup 2 S)
    (hSL : S ≤ normalizer (L : Set G)) (hO'L : O' ≤ L) (hLO : L ≤ normalizer (O' : Set G))
    (hSO : S ≤ normalizer (O' : Set G)) (hodd : ¬ 2 ∣ Nat.card O') {l : G} (hl : l ∈ L)
    (hlS : ∀ s ∈ S, l⁻¹ * s⁻¹ * l * s ∈ O') :
    ∃ c ∈ L ⊓ centralizer (S : Set G), c⁻¹ * l ∈ O' := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set A := normalizer (L : Set G) ⊓ normalizer (O' : Set G) with hA
  have hLA : L ≤ A := le_inf le_normalizer hLO
  have hSA : S ≤ A := le_inf hSL hSO
  set N := O'.subgroupOf A with hN
  have hNn : N.Normal := by
    refine ⟨fun n hn a => ?_⟩
    rw [mem_subgroupOf] at hn ⊢
    have h1 := (mem_normalizer_iff.mp a.2.2 n).mp hn
    simpa using h1
  have hNodd : ¬ 2 ∣ Nat.card N := by
    have h1 : Nat.card N ∣ Nat.card O' := by
      rw [← Subgroup.card_map_of_injective A.subtype_injective, Subgroup.subgroupOf_map_subtype]
      exact Subgroup.card_dvd_of_le inf_le_left
    exact fun h2 => hodd (h2.trans h1)
  set Q := S.subgroupOf A with hQ
  have hQ2 : IsPGroup 2 Q := hS.comap_subtype
  have : Fact (IsPGroup 2 Q) := ⟨hQ2⟩
  set x : ↥A := ⟨l, hLA hl⟩ with hx
  have hxc : QuotientGroup.mk' N x ∈ centralizer ((Q.map (QuotientGroup.mk' N) : Subgroup _) :
      Set (↥A ⧸ N)) := by
    rw [mem_centralizer_iff]
    rintro _ ⟨q, hq, rfl⟩
    have h1 := hlS q (mem_subgroupOf.mp hq)
    rw [← map_mul, ← map_mul, QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq]
    rw [mem_subgroupOf]
    have h2 : (((q * x)⁻¹ * (x * q) : ↥A) : G) = l⁻¹ * (q : G)⁻¹ * l * q := by
      simp only [hx, Subgroup.coe_mul, Subgroup.coe_inv]
      group
    rw [h2]
    exact h1
  have hcop : Nat.Coprime 2 (Nat.card N) := (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr hNodd
  rw [CFSG.centralizer_map_quotient_eq_map_centralizer 2 Q N hNn hcop] at hxc
  obtain ⟨c, hc, hcx⟩ := hxc
  have hco : c⁻¹ * x ∈ N := by
    rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq] at hcx
    exact hcx
  have hcS : (c : G) ∈ centralizer (S : Set G) := by
    rw [mem_centralizer_iff]
    intro s hs
    have := (mem_centralizer_iff.mp hc) ⟨s, hSA hs⟩ (mem_subgroupOf.mpr hs)
    exact congrArg Subtype.val this
  have hcoO : ((c⁻¹ * x : ↥A) : G) ∈ O' := mem_subgroupOf.mp hco
  have hcL : (c : G) ∈ L := by
    have h1 : (c : G) = l * ((c⁻¹ * x : ↥A) : G)⁻¹ := by simp [hx]
    rw [h1]
    exact mul_mem hl (inv_mem (hO'L hcoO))
  refine ⟨c, ⟨hcL, hcS⟩, ?_⟩
  simpa [hx] using hcoO

omit [Finite G] in
private theorem centralizer_zpowers_eq_univ (u : G) :
    centralizer ((zpowers u : Subgroup G) : Set G) = centralizer ({u} : Set G) := by
  rw [zpowers_eq_closure, centralizer_closure]

variable (N : Subgroup G) [N.Normal] (hN : ¬ 2 ∣ Nat.card N)
include hN

theorem map_mk_centralizer_singleton {x : G} (hx : IsPGroup 2 (zpowers x)) :
    (centralizer ({x} : Set G)).map (QuotientGroup.mk' N) =
      centralizer ({QuotientGroup.mk' N x} : Set (G ⧸ N)) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h := CFSG.Semidihedral.Local.map_centralizer_eq_of_coprime 2 N hN (zpowers x) hx
  rwa [MonoidHom.map_zpowers, centralizer_zpowers_eq_univ, centralizer_zpowers_eq_univ] at h

theorem map_mk_inf_centralizer_singleton {K : Subgroup G} {x : G} (hx : IsPGroup 2 (zpowers x))
    (hxK : x ∈ normalizer (K : Set G)) :
    (K ⊓ centralizer ({x} : Set G)).map (QuotientGroup.mk' N) =
      K.map (QuotientGroup.mk' N) ⊓ centralizer ({QuotientGroup.mk' N x} : Set (G ⧸ N)) := by
  refine le_antisymm (le_inf (map_mono inf_le_left) ?_) ?_
  · rw [← map_mk_centralizer_singleton N hN hx]
    exact map_mono inf_le_right
  rintro _ ⟨⟨k, hk, rfl⟩, hkc⟩
  have hkx : (QuotientGroup.mk' N k) * (QuotientGroup.mk' N x) =
      (QuotientGroup.mk' N x) * (QuotientGroup.mk' N k) :=
    (mem_centralizer_singleton_iff.mp hkc)
  have hzK : zpowers x ≤ normalizer (K : Set G) := zpowers_le.mpr hxK
  have hzN : zpowers x ≤ normalizer ((K ⊓ N : Subgroup G) : Set G) := by
    refine zpowers_le.mpr ?_
    rw [mem_normalizer_iff]
    intro y
    constructor
    · rintro ⟨hyK, hyN⟩
      exact ⟨(mem_normalizer_iff.mp hxK y).mp hyK, (‹N.Normal›).conj_mem y hyN x⟩
    · rintro ⟨hyK, hyN⟩
      refine ⟨(mem_normalizer_iff.mp hxK y).mpr hyK, ?_⟩
      have := (‹N.Normal›).conj_mem _ hyN x⁻¹
      simpa [mul_assoc] using this
  have hKN : K ≤ normalizer ((K ⊓ N : Subgroup G) : Set G) := by
    intro g hg
    rw [mem_normalizer_iff]
    intro y
    constructor
    · rintro ⟨hyK, hyN⟩
      exact ⟨K.mul_mem (K.mul_mem hg hyK) (K.inv_mem hg), (‹N.Normal›).conj_mem y hyN g⟩
    · rintro ⟨hyK, hyN⟩
      refine ⟨?_, ?_⟩
      · have e : y = g⁻¹ * (g * y * g⁻¹) * g := by group
        rw [e]
        exact K.mul_mem (K.mul_mem (K.inv_mem hg) hyK) hg
      · have := (‹N.Normal›).conj_mem _ hyN g⁻¹
        simpa [mul_assoc] using this
  have hodd : ¬ 2 ∣ Nat.card (K ⊓ N : Subgroup G) := fun h2 =>
    hN (h2.trans (Subgroup.card_dvd_of_le inf_le_right))
  have hcomm : ∀ s ∈ zpowers x, k⁻¹ * s⁻¹ * k * s ∈ K ⊓ N := by
    intro s hs
    obtain ⟨n, rfl⟩ := mem_zpowers_iff.mp hs
    refine ⟨?_, ?_⟩
    · have hsK : x ^ n ∈ normalizer (K : Set G) := hzK (zpow_mem_zpowers x n)
      have h1 : (x ^ n)⁻¹ * k * x ^ n ∈ K := by
        have := (mem_normalizer_iff.mp (inv_mem hsK) k).mp hk
        simpa [mul_assoc] using this
      have e : k⁻¹ * (x ^ n)⁻¹ * k * x ^ n = k⁻¹ * ((x ^ n)⁻¹ * k * x ^ n) := by group
      rw [e]
      exact K.mul_mem (K.inv_mem hk) h1
    · show k⁻¹ * (x ^ n)⁻¹ * k * x ^ n ∈ N
      rw [← QuotientGroup.eq_one_iff]
      have hkxn : (QuotientGroup.mk' N k) * (QuotientGroup.mk' N (x ^ n)) =
          (QuotientGroup.mk' N (x ^ n)) * (QuotientGroup.mk' N k) := by
        rw [map_zpow]
        exact ((Commute.zpow_right (show Commute _ _ from hkx) n)).eq
      have : (((k⁻¹ * (x ^ n)⁻¹ * k * x ^ n : G)) : G ⧸ N) =
          (QuotientGroup.mk' N k)⁻¹ * (QuotientGroup.mk' N (x ^ n))⁻¹ *
            ((QuotientGroup.mk' N k) * (QuotientGroup.mk' N (x ^ n))) := by
        simp [mul_assoc]
      rw [this, hkxn]
      group
  obtain ⟨c, hc, hck⟩ := exists_mem_inf_centralizer_of_comm_mem hx hzK inf_le_left hKN hzN hodd hk
    hcomm
  refine ⟨c, ⟨hc.1, ?_⟩, ?_⟩
  · show c ∈ centralizer ({x} : Set G)
    rw [← centralizer_zpowers_eq_univ]
    exact hc.2
  · rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq]
    exact hck.2

end Coprime

theorem isTwoComponentIn_of_map_injective {A B : Type*} [Group A] [Group B] [Finite A] [Finite B]
    (f : A →* B) (hf : Function.Injective f) {J S : Subgroup A}
    (h : IsTwoComponentIn (J.map f) (S.map f)) : IsTwoComponentIn J S := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hJS : J ≤ S := (map_le_map_iff_of_injective hf).mp h.1
  have hker : ¬ 2 ∣ Nat.card (f.subgroupMap S).ker := by
    have : (f.subgroupMap S).ker = ⊥ := by
      rw [eq_bot_iff]
      intro s hs
      have h1 : f s = f 1 := by
        rw [map_one]
        exact congrArg Subtype.val (MonoidHom.mem_ker.mp hs)
      exact (Subgroup.mem_bot).mpr (Subtype.ext (hf h1))
    rw [this, card_bot]
    norm_num
  have hinj : Function.Injective (f.subgroupMap S) := fun a b hab =>
    Subtype.ext (hf (congrArg Subtype.val hab))
  obtain ⟨hbij, -, -⟩ := CatalogueBPrimeJoin.prime_complement_quotient_p_component_bijection
    (p := 2) (f.subgroupMap S) (f.subgroupMap_surjective S) hker
  have h2 := h.2
  rw [subgroupOf_map_eq_map_subgroupMap f hJS] at h2
  obtain ⟨L, hL, hLJ⟩ := hbij.surjOn h2
  refine ⟨hJS, ?_⟩
  have hLJ' : L = J.subgroupOf S := Subgroup.map_injective hinj hLJ
  rw [← hLJ']
  exact hL

@[expose] def SingleComponentQuasisimpleFor : Prop :=
  ∀ (Q : Type) [Group Q] [Finite Q], IsQuasisimple Q → pPrimeCore 2 Q = ⊥ →
    Blueprint.Catalog (Q ⧸ center Q) →
    ∀ X Y : Subgroup Q, ⁅X, X⁆ = X → ⁅Y, Y⁆ = Y →
      IsQuasisimple (↥X ⧸ pPrimeCore 2 ↥X) → IsQuasisimple (↥Y ⧸ pPrimeCore 2 ↥Y) →
      2 ≤ CFSG.Open.pRank 2 X → 2 ≤ CFSG.Open.pRank 2 Y →
      ⁅X, Y⁆ ≤ oddCoreIn X ⊓ oddCoreIn Y →
      (∀ x ∈ X, orderOf x = 2 → ∃ P : Subgroup Q,
        IsTwoComponentIn P (centralizer ({x} : Set Q)) ∧
        P ⊔ oddCoreIn (centralizer ({x} : Set Q)) =
          twoLayerIn (Y ⊓ centralizer ({x} : Set Q)) ⊔ oddCoreIn (centralizer ({x} : Set Q))) →
      (∀ y ∈ Y, orderOf y = 2 → ∃ P : Subgroup Q,
        IsTwoComponentIn P (centralizer ({y} : Set Q)) ∧
        P ⊔ oddCoreIn (centralizer ({y} : Set Q)) =
          twoLayerIn (X ⊓ centralizer ({y} : Set Q)) ⊔ oddCoreIn (centralizer ({y} : Set Q))) →
      False

@[expose] def SingleComponentTopFor : Prop :=
  ∀ (A : Type) [Group A] [Finite A], IsQuasisimple (A ⧸ pPrimeCore 2 A) →
    Blueprint.Catalog ((A ⧸ pPrimeCore 2 A) ⧸ center (A ⧸ pPrimeCore 2 A)) →
    ∀ K₁ K₂ : Subgroup A, ⁅K₁, K₁⁆ = K₁ → ⁅K₂, K₂⁆ = K₂ →
      IsQuasisimple (↥K₁ ⧸ pPrimeCore 2 ↥K₁) → IsQuasisimple (↥K₂ ⧸ pPrimeCore 2 ↥K₂) →
      2 ≤ CFSG.Open.pRank 2 K₁ → 2 ≤ CFSG.Open.pRank 2 K₂ →
      ⁅K₁, K₂⁆ ≤ oddCoreIn K₁ ⊓ oddCoreIn K₂ →
      (∀ x ∈ K₁, orderOf x = 2 → ∃ P : Subgroup A,
        IsTwoComponentIn P (centralizer ({x} : Set A)) ∧
        P ⊔ oddCoreIn (centralizer ({x} : Set A)) =
          twoLayerIn (K₂ ⊓ centralizer ({x} : Set A)) ⊔ oddCoreIn (centralizer ({x} : Set A))) →
      (∀ y ∈ K₂, orderOf y = 2 → ∃ P : Subgroup A,
        IsTwoComponentIn P (centralizer ({y} : Set A)) ∧
        P ⊔ oddCoreIn (centralizer ({y} : Set A)) =
          twoLayerIn (K₁ ⊓ centralizer ({y} : Set A)) ⊔ oddCoreIn (centralizer ({y} : Set A))) →
      False

section Quotient

variable {A : Type*} [Group A] [Finite A]

theorem exists_involution_mem_mk_eq (N : Subgroup A) [N.Normal] (hN : ¬ 2 ∣ Nat.card N)
    {K : Subgroup A} {a : A} (ha : a ∈ K) (hy : orderOf (QuotientGroup.mk' N a) = 2) :
    ∃ t ∈ K, orderOf t = 2 ∧ QuotientGroup.mk' N t = QuotientGroup.mk' N a := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨k, m, hm, hkm⟩ := Nat.exists_eq_two_pow_mul_odd (orderOf_pos a).ne'
  have hm0 : m ≠ 0 := hm.pos.ne'
  set t := a ^ m with ht
  have hy1 : (QuotientGroup.mk' N a) ^ 2 = 1 := by rw [← hy]; exact pow_orderOf_eq_one _
  have hmk : QuotientGroup.mk' N t = QuotientGroup.mk' N a := by
    obtain ⟨j, rfl⟩ := hm
    rw [ht, map_pow, pow_succ, pow_mul, hy1, one_pow, one_mul]
  have htord : orderOf t = 2 ^ k := by
    rw [ht, orderOf_pow' a hm0, hkm, Nat.gcd_mul_left_left]
    exact Nat.mul_div_cancel _ (Nat.pos_of_ne_zero hm0)
  have ht2N : t ^ 2 ∈ N := by
    rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_pow]
    have h1 : ((t : A ⧸ N)) = QuotientGroup.mk' N t := rfl
    rw [h1, hmk, hy1]
  have hsq : t ^ 2 = 1 := by
    have h1 := orderOf_dvd_natCard (⟨t ^ 2, ht2N⟩ : N)
    rw [Subgroup.orderOf_mk] at h1
    have h2 : orderOf (t ^ 2) ∣ 2 ^ k := by
      rw [← htord]; exact orderOf_pow_dvd 2
    obtain ⟨i, -, hi⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp h2
    rcases i with _ | i
    · rw [pow_zero] at hi; exact orderOf_eq_one_iff.mp hi
    · exact absurd (hi ▸ h1) fun h => hN ((dvd_pow_self 2 (Nat.succ_ne_zero i)).trans h)
  refine ⟨t, K.pow_mem ha m, orderOf_eq_prime hsq fun h1 => ?_, hmk⟩
  rw [h1, map_one] at hmk
  rw [← hmk, orderOf_one] at hy
  norm_num at hy

omit [Finite A] in
theorem mem_normalizer_of_commutator_le {K₁ K₂ : Subgroup A} (h : ⁅K₁, K₂⁆ ≤ K₂) {x : A}
    (hx : x ∈ K₁) : x ∈ normalizer (K₂ : Set A) := by
  have key : ∀ y ∈ K₁, ∀ z ∈ K₂, y * z * y⁻¹ ∈ K₂ := fun y hy z hz => by
    have h1 : ⁅y, z⁆ ∈ K₂ := h (commutator_mem_commutator hy hz)
    have e : y * z * y⁻¹ = ⁅y, z⁆ * z := by rw [commutatorElement_def]; group
    rw [e]
    exact K₂.mul_mem h1 hz
  rw [mem_normalizer_iff]
  intro z
  refine ⟨key x hx z, fun hz => ?_⟩
  have e : z = x⁻¹ * (x * z * x⁻¹) * x⁻¹⁻¹ := by group
  rw [e]
  exact key x⁻¹ (K₁.inv_mem hx) _ hz

theorem exists_twoComponent_map_mk (N : Subgroup A) [N.Normal] (hN : ¬ 2 ∣ Nat.card N)
    {K₁ K₂ : Subgroup A} (hcomm : ⁅K₁, K₂⁆ ≤ K₂)
    (hP : ∀ x ∈ K₁, orderOf x = 2 → ∃ P : Subgroup A,
      IsTwoComponentIn P (centralizer ({x} : Set A)) ∧
      P ⊔ oddCoreIn (centralizer ({x} : Set A)) =
        twoLayerIn (K₂ ⊓ centralizer ({x} : Set A)) ⊔ oddCoreIn (centralizer ({x} : Set A)))
    {y : A ⧸ N} (hy : y ∈ K₁.map (QuotientGroup.mk' N)) (hy2 : orderOf y = 2) :
    ∃ P : Subgroup (A ⧸ N), IsTwoComponentIn P (centralizer ({y} : Set (A ⧸ N))) ∧
      P ⊔ oddCoreIn (centralizer ({y} : Set (A ⧸ N))) =
        twoLayerIn (K₂.map (QuotientGroup.mk' N) ⊓ centralizer ({y} : Set (A ⧸ N))) ⊔
          oddCoreIn (centralizer ({y} : Set (A ⧸ N))) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hker : ¬ 2 ∣ Nat.card (QuotientGroup.mk' N).ker := by rw [QuotientGroup.ker_mk']; exact hN
  obtain ⟨k, hk, rfl⟩ := hy
  obtain ⟨x, hxK, hx2, hxk⟩ := exists_involution_mem_mk_eq N hN hk hy2
  rw [← hxk]
  obtain ⟨P, hPC, heq⟩ := hP x hxK hx2
  have hx2' : IsPGroup 2 (zpowers x) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hx2, pow_one])
  have hC := map_mk_centralizer_singleton N hN hx2'
  have hY := map_mk_inf_centralizer_singleton N hN hx2' (mem_normalizer_of_commutator_le hcomm hxK)
  refine ⟨P.map (QuotientGroup.mk' N), ?_, ?_⟩
  · rw [← hC]
    exact isTwoComponentIn_map_of_odd_ker _ hker hPC
  · rw [← hY, ← hC, oddCoreIn_map_of_odd_ker _ hker, twoLayerIn_map_of_odd_ker _ hker,
      ← Subgroup.map_sup, ← Subgroup.map_sup, heq]

end Quotient

theorem singleComponentTopFor_of_quasisimple (h : SingleComponentQuasisimpleFor) :
    SingleComponentTopFor := by
  intro A _ _ hAq hAcat K₁ K₂ hK₁p hK₂p hK₁q hK₂q hK₁r hK₂r hcomm hP₁ hP₂
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set O := pPrimeCore 2 A with hO
  set π := QuotientGroup.mk' O with hπ
  have hodd : ¬ 2 ∣ Nat.card O :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mp pPrimeCore_coprime_card
  have hker : ¬ 2 ∣ Nat.card π.ker := by rw [hπ, QuotientGroup.ker_mk']; exact hodd
  have hsurj : Function.Surjective π := QuotientGroup.mk'_surjective O
  have hQO : pPrimeCore 2 (A ⧸ O) = ⊥ := by
    obtain ⟨h1, -⟩ := prime_complement_kernel_core_preimage (p := 2) π hsurj hker
    rw [eq_bot_iff]
    intro z hz
    obtain ⟨a, rfl⟩ := hsurj z
    have ha : a ∈ (pPrimeCore 2 (A ⧸ O)).comap π := hz
    rw [h1] at ha
    rw [Subgroup.mem_bot, hπ, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact ha
  have hc₂ : ⁅K₁, K₂⁆ ≤ K₂ := (hcomm.trans inf_le_right).trans (map_subtype_le _)
  have hc₁ : ⁅K₂, K₁⁆ ≤ K₁ := by
    rw [commutator_comm]
    exact (hcomm.trans inf_le_left).trans (map_subtype_le _)
  refine h (A ⧸ O) hAq hQO hAcat (K₁.map π) (K₂.map π) ?_ ?_
    (isQuasisimple_quotient_map_of_odd_ker π hker K₁ hK₁q)
    (isQuasisimple_quotient_map_of_odd_ker π hker K₂ hK₂q)
    (by rw [pRank_map_of_odd_ker π hker]; exact hK₁r)
    (by rw [pRank_map_of_odd_ker π hker]; exact hK₂r) ?_
    (fun y hy hy2 => exists_twoComponent_map_mk O hodd hc₂ hP₁ hy hy2)
    (fun y hy hy2 => exists_twoComponent_map_mk O hodd hc₁ hP₂ hy hy2)
  · rw [← map_commutator, hK₁p]
  · rw [← map_commutator, hK₂p]
  · rw [← map_commutator, oddCoreIn_map_of_odd_ker π hker, oddCoreIn_map_of_odd_ker π hker]
    exact (map_mono hcomm).trans (map_inf_le _ _ _)

theorem map_subtype_centralizer_singleton {G : Type*} [Group G] (M : Subgroup G) (x : ↥M) :
    (centralizer ({x} : Set ↥M)).map M.subtype = M ⊓ centralizer ({(x : G)} : Set G) := by
  ext y
  constructor
  · rintro ⟨m, hm, rfl⟩
    refine ⟨m.2, ?_⟩
    have hm' : m * x = x * m := mem_centralizer_singleton_iff.mp hm
    show (m : G) ∈ centralizer ({(x : G)} : Set G)
    rw [mem_centralizer_singleton_iff]
    exact congrArg Subtype.val hm'
  · rintro ⟨hyM, hy⟩
    refine ⟨⟨y, hyM⟩, ?_, rfl⟩
    have hy' : y * x = x * y := mem_centralizer_singleton_iff.mp hy
    show (⟨y, hyM⟩ : ↥M) ∈ centralizer ({x} : Set ↥M)
    rw [mem_centralizer_singleton_iff]
    exact Subtype.ext hy'

theorem singleComponentCatalogFor_of_top (h : SingleComponentTopFor) :
    SingleComponentCatalogFor := by
  intro G _ _ M hMq hMcat K₁ K₂ hK₁M hK₂M hK₁p hK₂p hK₁q hK₂q hK₁r hK₂r hcomm hP₁ hP₂
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set ι := M.subtype with hιdef
  have hι : Function.Injective ι := M.subtype_injective
  have hker : ¬ 2 ∣ Nat.card ι.ker := by
    rw [(MonoidHom.ker_eq_bot_iff ι).mpr hι, card_bot]
    norm_num
  have hK₁' : (K₁.subgroupOf M).map ι = K₁ := by
    rw [hιdef, subgroupOf_map_subtype, inf_of_le_left hK₁M]
  have hK₂' : (K₂.subgroupOf M).map ι = K₂ := by
    rw [hιdef, subgroupOf_map_subtype, inf_of_le_left hK₂M]
  have hperf : ∀ {K : Subgroup G}, (K.subgroupOf M).map ι = K → ⁅K, K⁆ = K →
      ⁅K.subgroupOf M, K.subgroupOf M⁆ = K.subgroupOf M := fun {K} hK hKp => by
    apply Subgroup.map_injective hι
    rw [map_commutator, hK, hKp]
  have hcen : ∀ {K₀ : Subgroup G} (hK₀ : K₀ ≤ M), (K₀.subgroupOf M).map ι = K₀ →
      ∀ x : ↥M, ((K₀.subgroupOf M) ⊓ centralizer ({x} : Set ↥M)).map ι =
        K₀ ⊓ centralizer ({(x : G)} : Set G) := fun {K₀} hK₀ hK₀' x => by
    rw [map_inf_eq _ _ _ hι, hK₀', map_subtype_centralizer_singleton, ← inf_assoc,
      inf_of_le_left hK₀]
  have hinv : ∀ {Ka Kb : Subgroup G} (hKa : Ka ≤ M) (hKb : Kb ≤ M),
      (∀ x ∈ Ka, orderOf x = 2 → ∃ P : Subgroup G,
        IsTwoComponentIn P (M ⊓ centralizer ({x} : Set G)) ∧
        P ⊔ oddCoreIn (M ⊓ centralizer ({x} : Set G)) =
          twoLayerIn (Kb ⊓ centralizer ({x} : Set G)) ⊔
            oddCoreIn (M ⊓ centralizer ({x} : Set G))) →
      ∀ x ∈ Ka.subgroupOf M, orderOf x = 2 → ∃ P : Subgroup ↥M,
        IsTwoComponentIn P (centralizer ({x} : Set ↥M)) ∧
        P ⊔ oddCoreIn (centralizer ({x} : Set ↥M)) =
          twoLayerIn (Kb.subgroupOf M ⊓ centralizer ({x} : Set ↥M)) ⊔
            oddCoreIn (centralizer ({x} : Set ↥M)) := by
    intro Ka Kb hKa hKb hP x hx hx2
    have hx2G : orderOf (x : G) = 2 := by rw [Subgroup.orderOf_coe]; exact hx2
    obtain ⟨P, hPC, heq⟩ := hP (x : G) (mem_subgroupOf.mp hx) hx2G
    have hPM : P ≤ M := hPC.1.trans inf_le_left
    have hP' : (P.subgroupOf M).map ι = P := by
      rw [hιdef, subgroupOf_map_subtype, inf_of_le_left hPM]
    have hC : (centralizer ({x} : Set ↥M)).map ι = M ⊓ centralizer ({(x : G)} : Set G) :=
      map_subtype_centralizer_singleton M x
    have hKb' : (Kb.subgroupOf M).map ι = Kb := by
      rw [hιdef, subgroupOf_map_subtype, inf_of_le_left hKb]
    refine ⟨P.subgroupOf M, ?_, ?_⟩
    · apply isTwoComponentIn_of_map_injective ι hι
      rw [hP', hC]
      exact hPC
    · apply Subgroup.map_injective hι
      rw [Subgroup.map_sup, Subgroup.map_sup, hP', ← oddCoreIn_map_of_odd_ker ι hker,
        ← twoLayerIn_map_of_odd_ker ι hker, hC, hcen hKb hKb' x]
      exact heq
  refine h ↥M hMq hMcat (K₁.subgroupOf M) (K₂.subgroupOf M) (hperf hK₁' hK₁p) (hperf hK₂' hK₂p)
    (CatalogueBPrimeJoin.quasisimple_primeCore_quotient_of_equiv 2
      (subgroupOfEquivOfLe hK₁M).symm hK₁q)
    (CatalogueBPrimeJoin.quasisimple_primeCore_quotient_of_equiv 2
      (subgroupOfEquivOfLe hK₂M).symm hK₂q)
    (by rw [← pRank_map_of_odd_ker ι hker, hK₁']; exact hK₁r)
    (by rw [← pRank_map_of_odd_ker ι hker, hK₂']; exact hK₂r) ?_
    (hinv hK₁M hK₂M hP₁) (hinv hK₂M hK₁M hP₂)
  rw [← map_le_map_iff_of_injective hι, map_commutator, hK₁', hK₂', map_inf_eq _ _ _ hι,
    ← oddCoreIn_map_of_odd_ker ι hker, ← oddCoreIn_map_of_odd_ker ι hker, hK₁', hK₂']
  exact hcomm

theorem singleComponentCatalogFor_of_quasisimple (h : SingleComponentQuasisimpleFor) :
    SingleComponentCatalogFor :=
  singleComponentCatalogFor_of_top (singleComponentTopFor_of_quasisimple h)

end CFSG.ComponentClassification.Sol76.Sig
