@[expose] def ComponentCases (ℓ : ℕ) (T : Set (StatedLieTag × ℕ × ℕ)) {X : Type} [Group X]
    (L : Subgroup X) : Prop :=
  (∃ z ∈ L, (∀ y ∈ L, z * y = y * z) ∧ z * z = 1 ∧ z ≠ 1) ∨ ModelIn ℓ T L

theorem ComponentCases.mono {ℓ : ℕ} {T T' : Set (StatedLieTag × ℕ × ℕ)} (hT : T ⊆ T')
    {X : Type} [Group X] {L : Subgroup X} (h : ComponentCases ℓ T L) : ComponentCases ℓ T' L :=
  h.imp id (ModelIn.mono hT)

theorem ComponentCases.of_map {ℓ : ℕ} {T : Set (StatedLieTag × ℕ × ℕ)} {X X' : Type} [Group X]
    [Group X'] (e : X ≃* X') {L : Subgroup X} (h : ComponentCases ℓ T (L.map e.toMonoidHom)) :
    ComponentCases ℓ T L := by
  rcases h with ⟨z', hz', hzc, hzz, hz1⟩ | hm
  · left
    obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.1 hz'
    refine ⟨z, hz, fun y hy => e.injective ?_, e.injective ?_, fun h1 => hz1 ?_⟩
    · simpa only [MulEquiv.coe_toMonoidHom, map_mul] using hzc _ (Subgroup.mem_map_of_mem _ hy)
    · simpa only [MulEquiv.coe_toMonoidHom, map_mul, map_one] using hzz
    · rw [h1]
      exact map_one _
  · exact Or.inr (hm.of_mulEquiv (L.equivMapOfInjective e.toMonoidHom e.injective))

theorem componentCases_of_component_equiv {ℓ : ℕ} {T : Set (StatedLieTag × ℕ × ℕ)} {G H : Type}
    [Group G] [Group H] (e : G ≃* H)
    (h : ∀ N : Subgroup H, IsComponent N → ComponentCases ℓ T N) {M : Subgroup G}
    (hM : IsComponent M) : ComponentCases ℓ T M :=
  ComponentCases.of_map e (h _ (LocalCores.isComponent_map_mulEquiv e hM))

@[expose] def linTuples (n f : ℕ) : Set (StatedLieTag × ℕ × ℕ) :=
  {x | x ∈ linInnerTuples n f ∨ x ∈ graphTuples n f ∨
    ∃ j, f = 2 * j ∧ (x = (.PSL, n, j) ∨ x = (.PSU, n, j))}

theorem psl_component_cases {J : Type} [Group J] {n p f : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hadm : StatedLieAdmissible .PSL n p f) (hm : Blueprint.LieModel J .PSL n p f)
    {α : MulAut J} (hα : orderOf α = 2) {Kc : Subgroup (fixedSubgroup α)}
    (hKc : IsComponent Kc) : ComponentCases p (linTuples n f) Kc := by
  obtain ⟨K, _, _, hK, ⟨e⟩⟩ := nonempty_mulEquiv_psl_of_lieModel hadm hm
  have hf : 1 ≤ f := hadm.2.1
  have hβ : orderOf (MulAut.congr e α) = 2 :=
    (orderOf_injective (MulAut.congr e).toMonoidHom (MulAut.congr e).injective α).trans hα
  have hβ2 : MulAut.congr e α ^ 2 = 1 := hβ ▸ pow_orderOf_eq_one _
  have key : ∀ γ : MulAut (ProjectiveSpecialLinearGroup (Fin n) K), MulAut.congr e α = γ →
      (orderOf γ = 2 → ∀ L : Subgroup (fixedSubgroup γ), IsComponent L →
        ComponentCases p (linTuples n f) L) →
      ComponentCases p (linTuples n f) Kc := by
    intro γ hγ h
    exact componentCases_of_component_equiv ((fixedSubgroupCongrEquiv e α).trans
      (MulEquiv.subgroupCongr (congrArg fixedSubgroup hγ))) (h (hγ ▸ hβ)) hKc
  have hn : 2 ≤ n := hadm.2.2.1
  have hsemi : ∀ (A : GL (Fin n) K) (σ : K ≃+* K),
      MulAut.congr e α = CatalogueBLinearSemilinear.semilinearAction n K A σ →
      ComponentCases p (linTuples n f) Kc := by
    intro A σ hAσ
    by_cases hσ : σ = 1
    · subst hσ
      rw [CatalogueBLinearSemilinear.semilinearAction_one_field] at hAσ
      exact key _ hAσ fun hord L hL => ComponentCases.mono (fun x hx => Or.inl hx)
        (inner_psl_component_cases hp hp2 hK hadm A hord hL)
    · exact key _ hAσ fun _ L hL => by
        obtain ⟨j, hj, hcm⟩ := field_psl_component_model hn hp hp2 hf hK A σ hσ (hAσ ▸ hβ2)
          (MulEquiv.refl _) hL
        exact Or.inr (ModelIn.of_centralModel (Or.inr (Or.inr ⟨j, hj, Or.inl rfl⟩)) hcm)
  rcases (by omega : n = 2 ∨ 3 ≤ n) with rfl | hn3
  · obtain ⟨A, σ, hAσ⟩ := psl_two_normal_form (MulAut.congr e α)
    exact hsemi A σ hAσ
  · obtain ⟨-, hgen⟩ := LocalAnalysis.ComponentInitial.LinearFlag.automorphism_generation
      (K := K) hn3
    obtain ⟨A, σ, ε, hε, hAσε⟩ :=
      hgen (MulAut.congr (CatalogueBLinearHigherB.nativeEquiv n K).symm (MulAut.congr e α))
    have hβ' : MulAut.congr e α = MulAut.congr (CatalogueBLinearHigherB.nativeEquiv n K)
        (LocalAnalysis.ComponentInitial.LinearFlag.conjAut n K A *
          LocalAnalysis.ComponentInitial.LinearFlag.fieldAut n K σ *
            LocalAnalysis.ComponentInitial.LinearFlag.dualAut n K ^ ε) := by
      rw [← hAσε]
      ext x
      simp
    interval_cases ε
    · rw [pow_zero, mul_one, CatalogueBLinearHigherB.congr_semilinear] at hβ'
      exact hsemi A σ hβ'
    · rw [pow_one] at hβ'
      by_cases hσ : σ = 1
      · subst hσ
        rw [map_one, mul_one, CatalogueBLinearHigherB.congr_pureGraph] at hβ'
        exact key _ hβ' fun hord L hL => Or.inr
          ((graph_psl_component_models hp hp2 hK hn3 A hord hL).mono fun x hx => Or.inr (Or.inl hx))
      · rw [CatalogueBLinearHigherB.congr_graphField] at hβ'
        exact key _ hβ' fun hord L hL => by
          obtain ⟨j, hj, hcm⟩ := graphField_psl_component_model hn3 hp hp2 hf hK A σ hσ hord
            (MulEquiv.refl _) hL
          exact Or.inr (ModelIn.of_centralModel (Or.inr (Or.inr ⟨j, hj, Or.inr rfl⟩)) hcm)

@[expose] def linUTuples (n f : ℕ) : Set (StatedLieTag × ℕ × ℕ) :=
  {x | x ∈ linUInnerTuples n f ∨ x ∈ graphTuples n f}

theorem psu_component_cases {J : Type} [Group J] {n p f : ℕ} (hp2 : p ≠ 2)
    (hadm : StatedLieAdmissible .PSU n p f) (hm : Blueprint.LieModel J .PSU n p f)
    {α : MulAut J} (hα : orderOf α = 2) {Kc : Subgroup (fixedSubgroup α)}
    (hKc : IsComponent Kc) : ComponentCases p (linUTuples n f) Kc := by
  obtain ⟨K, _, h, ⟨ψ⟩⟩ := nonempty_mulEquiv_primeFormP_of_lieModel' hadm hm
  have hn : 3 ≤ n := hadm.2.2.1
  have hq : ¬(n = 3 ∧ p ^ f = 2) := fun h3 => hadm.2.2.2 (by rw [h3.1, h3.2])
  have hC : IsPrimeFormGram (1 : GL (Fin n) K) := isPrimeFormGram_one
  have hβ : orderOf (MulAut.congr ψ α) = 2 :=
    (orderOf_injective (MulAut.congr ψ).toMonoidHom (MulAut.congr ψ).injective α).trans hα
  obtain ⟨⟨A, φ⟩, hAφ⟩ := primeFormPsi_surjective h hC hn hq (MulAut.congr ψ α)
  have hff : primeFormFieldFactor h hC hn hq (MulAut.congr ψ α) = φ := by
    rw [← hAφ, primeFormFieldFactor_psi]
  have hφ2 : φ * φ = 1 := by
    rw [← hff, ← map_mul, ← pow_two]
    have h1 := pow_orderOf_eq_one (MulAut.congr ψ α)
    rw [hβ] at h1
    rw [h1, map_one]
  refine componentCases_of_component_equiv (fixedSubgroupCongrEquiv ψ α) (fun N hN => ?_) hKc
  rcases ringEquiv_eq_refl_or_bar h hφ2 with hφ | hφ
  · have hAα : MulAut.congr ψ α = primeFormConjHom h _ A := by
      rw [← hAφ, primeFormPsi_apply, hφ]
      rw [show RingEquiv.refl K = 1 from rfl, map_one, mul_one]
    have hord : orderOf (primeFormConjHom h _ A) = 2 := hAα ▸ hβ
    exact componentCases_of_component_equiv
      (MulEquiv.subgroupCongr (congrArg fixedSubgroup hAα))
      (fun N' hN' => ComponentCases.mono (fun x hx => Or.inl hx)
        (inner_psu_component_cases h hp2 hadm A hord hN')) hN
  · have hord : orderOf (primeFormPsi h isPrimeFormGram_one ⟨A, φ⟩) = 2 := hAφ ▸ hβ
    exact componentCases_of_component_equiv
      (MulEquiv.subgroupCongr (congrArg fixedSubgroup hAφ.symm))
      (fun N' hN' => Or.inr ((graph_psu_component_models h hp2 hadm A φ hφ hord hN').mono
        fun x hx => Or.inr hx)) hN

