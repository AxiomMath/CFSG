theorem card_suzT_inf_centralizer
    {i : ℕ} (hi : i < 4) :
    Nat.card (suzT ⊓ centralizer ({suzInv i} : Set (Equiv.Perm (Fin 1782))) :
      Subgroup (Equiv.Perm (Fin 1782))) = invFullOrders.getD i 0 := by
  have h := card_invD hi
  rw [invD_eq_centT hi, centT, inf_comm] at h
  exact h

theorem card_suzM_inf_centralizer
    {i : ℕ} (hi : i < 4) :
    Nat.card (suzM ⊓ centralizer ({suzInv i} : Set (Equiv.Perm (Fin 1782))) :
      Subgroup (Equiv.Perm (Fin 1782))) = invInnerOrders.getD i 0 := by
  have h := card_invE hi
  rw [invE_eq_centM hi, centM, inf_comm] at h
  exact h

theorem suz_le_normalizer
    {Y : Subgroup (Equiv.Perm (Fin 1782))} (hMY : suzM ≤ Y) (hYT : Y ≤ suzT) :
    suzT ≤ normalizer (Y : Set (Equiv.Perm (Fin 1782))) := by
  rcases eq_or_eq_of_card_le_two_mul hMY hYT (by rw [suzT_card, suzM_card_chain]) with rfl | rfl
  · intro c hc
    rw [mem_normalizer_iff]
    exact suzM_conj_iff hc
  · exact le_normalizer

theorem suz_relIndex
    {Y : Subgroup (Equiv.Perm (Fin 1782))} (hMY : suzM ≤ Y) (hYT : Y ≤ suzT)
    {c : Equiv.Perm (Fin 1782)} (hc : c ∈ suzT) {k : ℕ} (hk : k < 4) :
    (centralizer ({c * suzInv k * c⁻¹} : Set (Equiv.Perm (Fin 1782)))).relIndex Y =
      [2779920, 135135, 2358720, 370656].getD k 0 := by
  have h := relIndex_centralizer_mul_card Y (c * suzInv k * c⁻¹)
  rw [card_inf_centralizer_conj_of_mem_normalizer (suz_le_normalizer hMY hYT hc)] at h
  rcases eq_or_eq_of_card_le_two_mul hMY hYT (by rw [suzT_card, suzM_card_chain]) with rfl | rfl
  · rw [card_suzM_inf_centralizer hk, suzM_card_chain] at h
    interval_cases k <;> simp only [invInnerOrders, List.getD_cons_zero, List.getD_cons_succ]
      at h ⊢ <;> omega
  · rw [card_suzT_inf_centralizer hk, suzT_card] at h
    interval_cases k <;> simp only [invFullOrders, List.getD_cons_zero, List.getD_cons_succ]
      at h ⊢ <;> omega

theorem suz_fusion :
    ∀ Y : Subgroup (Equiv.Perm (Fin 1782)), suzM ≤ Y → Y ≤ suzT →
      ∀ σ ∈ Y, ∀ τ ∈ Y, orderOf σ = 2 → orderOf τ = 2 →
        ¬ 2 ∣ (centralizer ({σ} : Set (Equiv.Perm (Fin 1782)))).relIndex Y →
        2 ∣ (centralizer ({τ} : Set (Equiv.Perm (Fin 1782)))).relIndex Y →
        ∃ p : ℕ, p.Prime ∧ p ≠ 3 ∧
          ¬ p ∣ Nat.card (suzT ⊓ centralizer ({σ} : Set (Equiv.Perm (Fin 1782))) :
            Subgroup (Equiv.Perm (Fin 1782))) ∧
          ∃ x ∈ suzM ⊓ centralizer ({τ} : Set (Equiv.Perm (Fin 1782))), x ≠ 1 ∧ x ^ p = 1 ∧
            ∀ N' : Subgroup (Equiv.Perm (Fin 1782)),
              N' ≤ suzM ⊓ centralizer ({τ} : Set (Equiv.Perm (Fin 1782))) →
              suzM ⊓ centralizer ({τ} : Set (Equiv.Perm (Fin 1782))) ≤
                normalizer (N' : Set (Equiv.Perm (Fin 1782))) →
              Odd (Nat.card N') → x ∉ N' := by
  intro Y hMY hYT σ hσ τ hτ hσ2 hτ2 hσc hτc
  obtain ⟨i, ⟨hi, c, hc, rfl⟩, -⟩ := suzT_involution_class (hYT hσ) hσ2
  obtain ⟨j, ⟨hj, d, hd, rfl⟩, -⟩ := suzT_involution_class (hYT hτ) hτ2
  rw [suz_relIndex hMY hYT hc hi] at hσc
  rw [suz_relIndex hMY hYT hd hj] at hτc
  have hi1 : i = 1 := by
    interval_cases i <;> simp only [List.getD_cons_zero, List.getD_cons_succ] at hσc <;> omega
  subst hi1
  have hj1 : j ≠ 1 := by
    rintro rfl
    simp only [List.getD_cons_zero, List.getD_cons_succ] at hτc
    omega
  set p := if j = 2 then 11 else 7 with hpdef
  have hp : p.Prime := by
    rw [hpdef]
    split_ifs <;> norm_num
  have : Fact p.Prime := ⟨hp⟩
  have hcardσ : Nat.card (suzT ⊓ centralizer ({c * suzInv 1 * c⁻¹} : Set _) :
      Subgroup (Equiv.Perm (Fin 1782))) = 6635520 := by
    rw [card_inf_centralizer_conj_of_mem_normalizer (le_normalizer hc),
      card_suzT_inf_centralizer (by norm_num)]
    rfl
  have hcardτ : Nat.card (suzM ⊓ centralizer ({d * suzInv j * d⁻¹} : Set _) :
      Subgroup (Equiv.Perm (Fin 1782))) = invInnerOrders.getD j 0 := by
    rw [card_inf_centralizer_conj_of_mem_normalizer
      (suz_le_normalizer le_rfl suzM_le_suzT hd), card_suzM_inf_centralizer hj]
  have hpτ : p ∣ Nat.card (suzM ⊓ centralizer ({d * suzInv j * d⁻¹} : Set _) :
      Subgroup (Equiv.Perm (Fin 1782))) := by
    rw [hcardτ, hpdef]
    interval_cases j <;> simp_all <;> norm_num [invInnerOrders]
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' p hpτ
  have hx1 : (x : Equiv.Perm (Fin 1782)) ≠ 1 := by
    intro h
    have : x = 1 := Subtype.ext h
    rw [this, orderOf_one] at hx
    exact hp.one_lt.ne hx
  refine ⟨p, hp, ?_, ?_, x, x.2, hx1, ?_, ?_⟩
  · rw [hpdef]
    split_ifs <;> norm_num
  · rw [hcardσ, hpdef]
    split_ifs <;> norm_num
  · have := pow_orderOf_eq_one x
    rw [hx] at this
    exact congrArg Subtype.val this
  · intro N' hN'le hN'n hN'o
    exact not_mem_of_oddCore_eq_bot
      (CTUC_Suz_all_involution_centralizers_odd_core_free _ (hYT hτ) hτ2).1 hx1 N' hN'le hN'n
      hN'o

end Fusion

theorem suz_fusionModel :
    FusionModel suzM suzT where
  le := suzM_le_suzT
  normal := fun c hc => by
    rw [mem_normalizer_iff]
    exact suzM_conj_iff hc
  index := by rw [suzT_card, suzM_card_chain]
  even := by
    rw [suzM_card_chain]
    decide
  center := suz_center
  fusion := suz_fusion

end CFSG.ComponentClassification.AS81
