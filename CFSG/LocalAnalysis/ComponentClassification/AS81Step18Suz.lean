section Center

theorem suzSylowCenterCheck_parts :
    SuzCenter.centreOK invSylowArrs SuzCenter.sylSZWord SuzCenter.sylSLevels 16384 = true ∧
      (∀ k < SuzCenter.sylMGens.size, permOK 1782 SuzCenter.sylMGens[k]! = true ∧
        inM SuzCenter.sylMGens[k]! = true) ∧
      SuzCenter.centreOK SuzCenter.sylMGens SuzCenter.sylRZWord SuzCenter.sylRLevels 8192 =
        true := by
  have h := SuzCenter.suz_sylowCenterCheck
  simp only [SuzCenter.suzSylowCenterCheck, Bool.and_eq_true] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  refine ⟨h1, fun k hk => ?_, h3⟩
  have := allBelow_eq_true.mp h2 k hk
  simpa only [Bool.and_eq_true] using this

theorem invSylow_eq_genSub :
    invSylow = SuzCenter.genSub invSylowArrs.size fun k => permC 1782 invSylowArrs[k]! := by
  rw [invSylow, SuzCenter.genSub, invSylowArrs_size]

theorem card_centerIn_invSylow :
    Nat.card (centerIn invSylow) = 2 := by
  have h := SuzCenter.centreOK_spec (a := fun k => permC 1782 invSylowArrs[k]!)
    (fun k hk => tabRep_of_permOK (sylowAll_facts.1 k (by rwa [invSylowArrs_size] at hk)).1)
    (by rw [← invSylow_eq_genSub, card_invSylow]) suzSylowCenterCheck_parts.1
  rw [invSylow_eq_genSub]
  exact h.2

theorem isSylowOf_invSylow :
    IsSylowOf 2 invSylow suzT := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine isSylowOf_of_card invSylow_le_suzT ?_
  rw [card_invSylow, suzT_card_factorization]
  norm_num

@[expose] def sylMSet : Set (Equiv.Perm (Fin 1782)) :=
  {g | ∃ k < SuzCenter.sylMGens.size, permC 1782 SuzCenter.sylMGens[k]! = g}

theorem sylLetters_size : SuzCenter.sylLetters.size = 12 := by
  simp [SuzCenter.sylLetters, invSylowArrs_size]

theorem size_invCand' (t : Array ℕ) : (invCand 1782 t).size = 1782 := by
  unfold invCand
  simp only [Array.set!_eq_setIfInBounds, Std.Legacy.Range.forIn_eq_forIn_range',
    Std.Legacy.Range.size, tsub_zero, add_tsub_cancel_right, Nat.div_one,
    List.forIn_pure_yield_eq_foldl, bind_pure, Id.run_pure]
  have : ∀ (l : List ℕ) (r : Array ℕ),
      (List.foldl (fun b a => b.setIfInBounds t[a]! a) r l).size = r.size := by
    intro l
    induction l with
    | nil => intro r; rfl
    | cons a l ih => intro r; simp only [List.foldl_cons, ih, Array.size_setIfInBounds]
  rw [this, Array.size_replicate]

@[expose] noncomputable def sylLetter (j : ℕ) : Equiv.Perm (Fin 1782) :=
  if j < 11 then permC 1782 invSylowArrs[j]! else (permC 1782 invSylowArrs[0]!)⁻¹

theorem tabRep_sylLetter :
    ∀ j < SuzCenter.sylLetters.size, TabRep SuzCenter.sylLetters[j]! (sylLetter j) := by
  intro j hj
  rw [sylLetters_size] at hj
  have hsz : invSylowArrs.size = 11 := invSylowArrs_size
  rcases Nat.lt_or_ge j 11 with h | h
  · have e : SuzCenter.sylLetters[j]! = invSylowArrs[j]! := by
      rw [SuzCenter.sylLetters, getElem!_pos _ j (by simp [hsz]; omega),
        getElem!_pos _ j (by omega), Array.getElem_push_lt]
    simp only [e, sylLetter, h, ↓reduceIte]
    exact tabRep_of_permOK (sylowAll_facts.1 j h).1
  · have hj11 : j = 11 := by omega
    subst hj11
    have e : SuzCenter.sylLetters[11]! = invCand 1782 invSylowArrs[0]! := by
      rw [SuzCenter.sylLetters, getElem!_pos _ 11 (by simp [hsz]), Array.getElem_push]
      simp [hsz]
    simp only [e, sylLetter, show ¬11 < 11 by omega, ↓reduceIte]
    exact tabRep_invCand (sylowAll_facts.1 0 (by omega)).1 (size_invCand' _)

theorem sylLetter_mem (j : ℕ) : sylLetter j ∈ invSylow := by
  unfold sylLetter
  split
  · next h => exact subset_closure ⟨j, h, rfl⟩
  · exact invSylow.inv_mem (subset_closure ⟨0, by omega, rfl⟩)

theorem closure_sylMSet_le_invSylow :
    closure sylMSet ≤ invSylow := by
  rw [closure_le]
  rintro _ ⟨k, hk, rfl⟩
  have hk' : k < SuzCenter.sylMWords.length := by simpa [SuzCenter.sylMGens] using hk
  have hw : ∀ j ∈ SuzCenter.sylMWords[k], j < SuzCenter.sylLetters.size := by
    rw [sylLetters_size]
    have : ∀ w ∈ SuzCenter.sylMWords, ∀ j ∈ w, j < 12 := by decide
    exact this _ (List.getElem_mem hk')
  have e : SuzCenter.sylMGens[k]! =
      SuzCenter.wordC SuzCenter.sylLetters SuzCenter.sylMWords[k] := by
    rw [getElem!_pos _ k hk]
    simp [SuzCenter.sylMGens]
  have hrep := SuzCenter.tabRep_wordC tabRep_sylLetter _ hw
  rw [← e] at hrep
  rw [SetLike.mem_coe,
    (tabRep_of_permOK (suzSylowCenterCheck_parts.2.1 k hk).1).perm_eq hrep]
  exact invSylow.list_prod_mem fun x hx => by
    obtain ⟨j, -, rfl⟩ := List.mem_map.1 hx
    exact sylLetter_mem j

theorem closure_sylMSet_le :
    closure sylMSet ≤ suzM := by
  rw [closure_le]
  rintro _ ⟨k, hk, rfl⟩
  exact (inM_iff (tabRep_of_permOK (suzSylowCenterCheck_parts.2.1 k hk).1).2).mp
    (suzSylowCenterCheck_parts.2.1 k hk).2

theorem suzM_card_factorization :
    (Nat.card suzM).factorization 2 = 13 := by
  rw [suzM_card_chain, show (448345497600 : ℕ) = 2 ^ 13 * 54729675 by norm_num,
    Nat.factorization_mul (by norm_num) (by norm_num), Finsupp.add_apply,
    Nat.Prime.factorization_pow Nat.prime_two, Finsupp.single_eq_same,
    Nat.factorization_eq_zero_of_not_dvd (by norm_num)]

theorem card_sylM_le :
    Nat.card (closure sylMSet) ≤ 8192 := by
  have h1 : Nat.card (closure sylMSet) ∣ 2 ^ 14 := by
    rw [show (2 : ℕ) ^ 14 = 16384 by norm_num, ← card_invSylow]
    exact Subgroup.card_dvd_of_le closure_sylMSet_le_invSylow
  obtain ⟨m, -, he⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 h1
  have h2 : 2 ^ m ∣ Nat.card suzM := he ▸ Subgroup.card_dvd_of_le closure_sylMSet_le
  have h3 : m ≤ 13 := by
    rw [← suzM_card_factorization]
    exact (Nat.Prime.pow_dvd_iff_le_factorization Nat.prime_two Nat.card_pos.ne').1 h2
  rw [he]
  calc 2 ^ m ≤ 2 ^ 13 := Nat.pow_le_pow_right (by norm_num) h3
    _ = 8192 := by norm_num

theorem sylM_spec :
    Nat.card (closure sylMSet) = 8192 ∧ Nat.card (centerIn (closure sylMSet)) = 2 :=
  SuzCenter.centreOK_spec (a := fun k => permC 1782 SuzCenter.sylMGens[k]!)
    (fun k hk => tabRep_of_permOK (suzSylowCenterCheck_parts.2.1 k hk).1) card_sylM_le
    suzSylowCenterCheck_parts.2.2

theorem isSylowOf_sylM :
    IsSylowOf 2 (closure sylMSet) suzM := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  refine isSylowOf_of_card closure_sylMSet_le ?_
  rw [sylM_spec.1, suzM_card_factorization]
  norm_num

theorem card_centerIn_sylM :
    Nat.card (centerIn (closure sylMSet)) = 2 :=
  sylM_spec.2

theorem suz_center :
    ∀ Y P : Subgroup (Equiv.Perm (Fin 1782)), suzM ≤ Y → Y ≤ suzT →
    IsSylowOf 2 P Y → Nat.card (centerIn P) = 2 := by
  intro Y P hMY hYT hP
  rcases eq_or_eq_of_card_le_two_mul hMY hYT (by rw [suzT_card, suzM_card_chain])
    with rfl | rfl
  · rw [card_centerIn_eq_of_isSylowOf isSylowOf_sylM hP]
    exact card_centerIn_sylM
  · rw [card_centerIn_eq_of_isSylowOf isSylowOf_invSylow hP]
    exact card_centerIn_invSylow

