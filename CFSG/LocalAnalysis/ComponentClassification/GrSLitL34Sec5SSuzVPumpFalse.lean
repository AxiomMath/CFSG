@[expose] def SuzTypeSylowBound : Prop :=
  ∀ (Q : Type) [Group Q] [Finite Q], Group.IsPerfect Q →
    Blueprint.NativeSporadic.IsSporadic (Q ⧸ Open.fusionZStar Q) .Suz →
    ∀ R : Sylow 2 Q, Nat.card (R : Subgroup Q) ≤ 2 ^ 14

theorem suzTypeSylowBound_holds :
    SuzTypeSylowBound := by
  intro Q _ _ hQperf hQty R
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let O : Subgroup Q := pPrimeCore 2 Q
  let Y := Q ⧸ O
  have hOY : pPrimeCore 2 Y = ⊥ := CFSG.pPrimeCore_quotient_pPrimeCore_eq_bot (G := Q) 2
  have hYperf : Group.IsPerfect Y := inferInstance
  obtain ⟨eS⟩ := CFSG.ComponentClassification.GrSLit.nonempty_quotient_center_equiv_fusionZStar Q
  obtain ⟨eSuz⟩ := hQty
  have hYeq : (Y ⧸ Subgroup.center Y) ≃* CFSG.Blueprint.NativeSporadic.Carrier .Suz :=
    eS.trans eSuz
  have hYiso : IsSporadic (Y ⧸ Subgroup.center Y) .Suz := ⟨hYeq⟩
  have hYsimple : IsSimpleGroup (Y ⧸ Subgroup.center Y) :=
    @MulEquiv.isSimpleGroup _ _ _ _ CFSG.Sporadic.Suz.isSimpleGroup_Suz hYeq
  have hYcomm : commutator Y = ⊤ := (Group.isPerfect_def).mp hYperf
  have hYquasi : CFSG.Assembly.IsQuasisimple Y := ⟨hYcomm, hYsimple⟩
  have hYZ2 : IsPGroup 2 (Subgroup.center Y) :=
    CFSG.ComponentClassification.Sol78.center_isPGroup_two hOY
  have hZle : Nat.card (Subgroup.center Y) ≤ 2 :=
    suzCentralTwoGroupOrderBound_holds Y hYquasi hYZ2 hYiso
  have hYcard_quot : Nat.card (Y ⧸ Subgroup.center Y) = 448345497600 := by
    rw [Nat.card_congr hYeq.toEquiv]
    change Nat.card CFSG.Blueprint.NativeSporadic.Suz = 448345497600
    exact CFSG.Sporadic.Suz.card_Suz
  have hYcard : Nat.card Y = 448345497600 * Nat.card (Subgroup.center Y) := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (Subgroup.center Y), hYcard_quot]
  have hZpos : 0 < Nat.card (Subgroup.center Y) := Nat.card_pos
  have hZcases : Nat.card (Subgroup.center Y) = 1 ∨ Nat.card (Subgroup.center Y) = 2 := by
    omega
  have h448fac : (448345497600 : ℕ).factorization 2 = 13 := by
    rw [show (448345497600 : ℕ) = 2 ^ 13 * 54729675 by norm_num,
      Nat.factorization_mul (by positivity) (by norm_num),
      Finsupp.add_apply, Nat.Prime.factorization_pow Nat.prime_two,
      Finsupp.single_eq_same,
      Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ 54729675), add_zero]
  have hYfac_le : (Nat.card Y).factorization 2 ≤ 14 := by
    rcases hZcases with hZ1 | hZ2
    · rw [hYcard, hZ1, mul_one, h448fac]
      norm_num
    · rw [hYcard, hZ2]
      rw [show (448345497600 * 2 : ℕ) = 2 ^ 14 * 54729675 by norm_num,
        Nat.factorization_mul (by positivity) (by norm_num),
        Finsupp.add_apply, Nat.Prime.factorization_pow Nat.prime_two,
        Finsupp.single_eq_same,
        Nat.factorization_eq_zero_of_not_dvd (by norm_num : ¬ 2 ∣ 54729675), add_zero]
  have hOodd : Odd (Nat.card O) :=
    Nat.coprime_two_left.mp (CFSG.pPrimeCore_coprime_card (p := 2) (G := Q))
  have hOfac : (Nat.card O).factorization 2 = 0 :=
    Nat.factorization_eq_zero_of_not_dvd hOodd.not_two_dvd_nat
  have hQcard : Nat.card Q = Nat.card Y * Nat.card O := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup O]
  have hQfac : (Nat.card Q).factorization 2 ≤ 14 := by
    have hfac : (Nat.card Q).factorization 2 =
        (Nat.card Y).factorization 2 + (Nat.card O).factorization 2 := by
      rw [hQcard, Nat.factorization_mul (Nat.card_pos.ne') (Nat.card_pos.ne'),
        Finsupp.add_apply]
    rw [hfac, hOfac, add_zero]
    exact hYfac_le
  rw [Sylow.card_eq_multiplicity R]
  exact Nat.pow_le_pow_right (by norm_num) hQfac

theorem false_of_suz_pump
    (hS : SchreierFor Blueprint.Catalog) (hSuz2 : SuzTypeSylowBound)
    {G : Type} [Group G] [Finite G] {t : G} {P W M : Subgroup G}
    (hc : L34WConfigAt (fun X _ => Blueprint.NativeSporadic.IsSporadic X .Suz) G t P W)
    (hM : M = normalizer (W : Set G)) (htM : t ∈ M)
    {L : Subgroup (↥M ⧸ pPrimeCore 2 ↥M)} (hL : IsComponent L)
    (hZ : Nat.card (Subgroup.center ↥L) ≤ 2)
    (hLty : IsSporadic (↥L ⧸ Subgroup.center ↥L) .Suz)
    (hne : L.map (MulAut.conj (QuotientGroup.mk' (pPrimeCore 2 ↥M) ⟨t, htM⟩)).toMonoidHom ≠ L)
    (hPL : (P.subgroupOf M).map (QuotientGroup.mk' (pPrimeCore 2 ↥M)) ≤
      L ⊔ L.map (MulAut.conj (QuotientGroup.mk' (pPrimeCore 2 ↥M) ⟨t, htM⟩)).toMonoidHom)
    (hPL1 : (P.subgroupOf M).map (QuotientGroup.mk' (pPrimeCore 2 ↥M)) ⊓ L ≤
      (Subgroup.center ↥L).map L.subtype)
    (hPL2 : (P.subgroupOf M).map (QuotientGroup.mk' (pPrimeCore 2 ↥M)) ⊓
      L.map (MulAut.conj (QuotientGroup.mk' (pPrimeCore 2 ↥M) ⟨t, htM⟩)).toMonoidHom ≤
        (Subgroup.center ↥(L.map
          (MulAut.conj (QuotientGroup.mk' (pPrimeCore 2 ↥M) ⟨t, htM⟩)).toMonoidHom)).map
          (L.map (MulAut.conj (QuotientGroup.mk' (pPrimeCore 2 ↥M) ⟨t, htM⟩)).toMonoidHom).subtype)
    {v : G} (hvM : v ∈ M) (hv : orderOf v = 2) (htv : t * v = v * t)
    (hvL : ∀ y ∈ L ⊔ L.map (MulAut.conj (QuotientGroup.mk' (pPrimeCore 2 ↥M) ⟨t, htM⟩)).toMonoidHom,
        QuotientGroup.mk' (pPrimeCore 2 ↥M) ⟨v, hvM⟩ * y =
          y * QuotientGroup.mk' (pPrimeCore 2 ↥M) ⟨v, hvM⟩)
    {Q : Subgroup G} (hQv : Q ≤ centralizer ({v} : Set G))
    (hQ : IsPComponent 2 (Q.subgroupOf (centralizer ({v} : Set G))))
    (hQn : (Q.subgroupOf (centralizer ({v} : Set G))).Normal)
    (hDQ : UnbalancedGS.gsFixedLayer P v ≤ Q) (hQM : Q ≤ M)
    (hQty : IsSporadic (↥Q ⧸ Open.fusionZStar ↥Q) .Suz) : False := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let X := ↥M ⧸ pPrimeCore 2 ↥M
  let π : ↥M →* X := QuotientGroup.mk' (pPrimeCore 2 ↥M)
  let tbar : X := π ⟨t, htM⟩
  let Lt : Subgroup X := L.map (MulAut.conj tbar).toMonoidHom
  have hLt_comp : IsComponent Lt :=
    CFSG.LocalCores.isComponent_map_mulEquiv (MulAut.conj tbar) hL
  have hcommLtL : ⁅Lt, L⁆ = ⊥ := by
    rcases CFSG.LocalCores.distinct_components_commute hLt_comp hL with h | h
    · exact absurd h hne
    · exact h
  have hLtCent : Lt ≤ Subgroup.centralizer (L : Set X) :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcommLtL
  have hcommLLt : ∀ a ∈ L, ∀ b ∈ Lt, a * b = b * a := by
    intro a ha b hb
    exact Subgroup.mem_centralizer_iff.mp (hLtCent hb) a ha
  have hL_cent_Lt : L ≤ Subgroup.centralizer (Lt : Set X) := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    exact (hcommLLt a ha b hb).symm
  have hLLt_norm : L ≤ Subgroup.normalizer (Lt : Set X) :=
    hL_cent_Lt.trans (Subgroup.centralizer_le_normalizer (Lt : Set X))
  have hinf_center : L ⊓ Lt ≤ (Subgroup.center ↥L).map L.subtype := by
    intro n hn
    obtain ⟨hnL, hnLt⟩ := Subgroup.mem_inf.mp hn
    have hcent : (⟨n, hnL⟩ : ↥L) ∈ Subgroup.center ↥L := by
      rw [Subgroup.mem_center_iff]
      intro l
      apply Subtype.ext
      exact hcommLLt l l.2 n hnLt
    exact ⟨⟨n, hnL⟩, hcent, rfl⟩
  have hinfcard : Nat.card ↥(L ⊓ Lt) ≤ 2 := by
    have hdvd : Nat.card ↥(L ⊓ Lt) ∣
        Nat.card ↥((Subgroup.center ↥L).map L.subtype) :=
      Subgroup.card_dvd_of_le hinf_center
    have hpos : 0 < Nat.card ↥((Subgroup.center ↥L).map L.subtype) := Nat.card_pos
    have hle := Nat.le_of_dvd hpos hdvd
    rw [Subgroup.card_map_of_injective (Subgroup.subtype_injective (s := L))] at hle
    exact hle.trans hZ
  have hsupcard : Nat.card ↥(L ⊔ Lt) * Nat.card ↥(L ⊓ Lt) =
      Nat.card ↥L * Nat.card ↥Lt :=
    CFSG.GroupTheory.CoprimeActionSupport.NormalSubgroupSylowJoin.card_sup_mul_card_inf
      hLLt_norm
  have hLtcard : Nat.card ↥Lt = Nat.card ↥L :=
    Subgroup.card_map_of_injective (MulAut.conj tbar).injective
  have hLfac_ge : 13 ≤ (Nat.card ↥L).factorization 2 := by
    have hLcard : Nat.card ↥L =
        Nat.card (↥L ⧸ Subgroup.center ↥L) * Nat.card (Subgroup.center ↥L) :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup (Subgroup.center ↥L)
    have hQuotCard : Nat.card (↥L ⧸ Subgroup.center ↥L) = 448345497600 := by
      obtain ⟨eLty⟩ := hLty
      rw [Nat.card_congr eLty.toEquiv]
      change Nat.card CFSG.Blueprint.NativeSporadic.Suz = 448345497600
      exact CFSG.Sporadic.Suz.card_Suz
    have h213 : 2 ^ 13 ∣ Nat.card ↥L := by
      rw [hLcard, hQuotCard]
      exact dvd_mul_of_dvd_left (by norm_num : 2 ^ 13 ∣ 448345497600) _
    exact (Nat.prime_two.pow_dvd_iff_le_factorization Nat.card_pos.ne').mp h213
  have hInffac_le : (Nat.card ↥(L ⊓ Lt)).factorization 2 ≤ 1 := by
    have hpos : 0 < Nat.card ↥(L ⊓ Lt) := Nat.card_pos
    have hcases : Nat.card ↥(L ⊓ Lt) = 1 ∨ Nat.card ↥(L ⊓ Lt) = 2 := by omega
    rcases hcases with h1 | h2
    · rw [h1]
      norm_num
    · rw [h2]
      norm_num
  have hsupfac_ge : 25 ≤ (Nat.card ↥(L ⊔ Lt)).factorization 2 := by
    have hfac : (Nat.card ↥(L ⊔ Lt)).factorization 2 +
        (Nat.card ↥(L ⊓ Lt)).factorization 2 =
        (Nat.card ↥L).factorization 2 + (Nat.card ↥Lt).factorization 2 := by
      have h1 : (Nat.card ↥(L ⊔ Lt) * Nat.card ↥(L ⊓ Lt)).factorization 2 =
          (Nat.card ↥L * Nat.card ↥Lt).factorization 2 := by rw [hsupcard]
      have h2 : (Nat.card ↥(L ⊔ Lt) * Nat.card ↥(L ⊓ Lt)).factorization 2 =
          (Nat.card ↥(L ⊔ Lt)).factorization 2 +
            (Nat.card ↥(L ⊓ Lt)).factorization 2 :=
        by
          rw [Nat.factorization_mul Nat.card_pos.ne' Nat.card_pos.ne', Finsupp.add_apply]
      have h3 : (Nat.card ↥L * Nat.card ↥Lt).factorization 2 =
          (Nat.card ↥L).factorization 2 + (Nat.card ↥Lt).factorization 2 :=
        by
          rw [Nat.factorization_mul Nat.card_pos.ne' Nat.card_pos.ne', Finsupp.add_apply]
      exact h2.symm.trans (h1.trans h3)
    have hLt_fac : (Nat.card ↥Lt).factorization 2 = (Nat.card ↥L).factorization 2 := by
      rw [hLtcard]
    omega
  have hvt : v ∈ Subgroup.centralizer ({t} : Set G) :=
    Subgroup.mem_centralizer_singleton_iff.mpr htv.symm
  have hvP := L34WConfigAt.commutator_mem_oddIn_of_centralizes hc hM htM hPL hvM htv hvL
  have hvN : v ∈ Subgroup.normalizer (P : Set G) := hc.centralizer_le_normalizer hvt
  have hvK : v ∈ coreActionKernel P := mem_coreActionKernel.mpr ⟨hvN, hvP⟩
  have hvZ : v ∉ center G := by
    have hnc : ¬ IsMulCommutative G := by
      intro hcomm
      obtain ⟨a, b, hab⟩ := hc.base.2.1
      exact hab (hcomm.is_comm.comm a b)
    let : IsSimpleGroup G := hc.base.1
    have hZ : center G = ⊥ :=
      TauCeti.IsSimpleGroup.center_eq_bot_of_not_isMulCommutative hnc
    intro hvcen
    have hv1 : v = 1 := by simpa [hZ] using hvcen
    rw [hv1, orderOf_one] at hv
    exact absurd hv (by norm_num)
  obtain ⟨hDv_le, hDv_pc, hDv_layer, hDset, hDv_odd, hDv_quot⟩ :=
    GrS5.gsFixedLayer_facts hS hc.base.2.2.1 hc.order_two hv htv hvZ
      hc.le_centralizer hc.isPComponent hvK
  have hDvP : UnbalancedGS.gsFixedLayer P v ≤ P := (GrS5.gsFixedLayer_sup_oddIn hDset).1
  have hPM : P ≤ M := by
    rw [hM]
    exact hc.le_normalizer'
  have hDvM : UnbalancedGS.gsFixedLayer P v ≤ M := hDvP.trans hPM
  let Dbar : Subgroup X := ((UnbalancedGS.gsFixedLayer P v).subgroupOf M).map π
  have hDv_le_C : UnbalancedGS.gsFixedLayer P v ≤ Subgroup.centralizer ({v} : Set G) :=
