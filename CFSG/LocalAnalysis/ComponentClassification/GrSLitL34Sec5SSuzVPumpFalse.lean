  have hDsubMperf : Group.IsPerfect
      ↥((UnbalancedGS.gsFixedLayer P v).subgroupOf M) := by
    have h := hDperf
    exact Group.IsPerfect.ofSurjective
      (f := (Subgroup.subgroupOfEquivOfLe hDvM).symm.toMonoidHom)
      (Subgroup.subgroupOfEquivOfLe hDvM).symm.surjective
  have hDbarperf : Group.IsPerfect ↥Dbar := by
    haveI : Group.IsPerfect ↥((UnbalancedGS.gsFixedLayer P v).subgroupOf M) := hDsubMperf
    exact Group.IsPerfect.map (H := (UnbalancedGS.gsFixedLayer P v).subgroupOf M) (f := π)
  have hPtyCard : Nat.card (↥P ⧸ Open.fusionZStar ↥P) = 448345497600 := by
    obtain ⟨ePty⟩ := hc.type
    rw [Nat.card_congr ePty.toEquiv]
    change Nat.card CFSG.Blueprint.NativeSporadic.Suz = 448345497600
    exact CFSG.Sporadic.Suz.card_Suz
  have hPquotEven : 2 ∣ Nat.card (↥P ⧸ pPrimeCore 2 ↥P) := by
    obtain ⟨ePZ⟩ :=
      CFSG.ComponentClassification.GrSLit.nonempty_quotient_center_equiv_fusionZStar ↥P
    have hcard : Nat.card (↥P ⧸ pPrimeCore 2 ↥P) =
        Nat.card ((↥P ⧸ pPrimeCore 2 ↥P) ⧸
          Subgroup.center (↥P ⧸ pPrimeCore 2 ↥P)) *
        Nat.card (Subgroup.center (↥P ⧸ pPrimeCore 2 ↥P)) :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup _
    rw [hcard]
    have hcenter : Nat.card ((↥P ⧸ pPrimeCore 2 ↥P) ⧸
        Subgroup.center (↥P ⧸ pPrimeCore 2 ↥P)) = 448345497600 := by
      rw [Nat.card_congr ePZ.toEquiv, hPtyCard]
    rw [hcenter]
    exact dvd_mul_of_dvd_left (by norm_num : 2 ∣ 448345497600) _
  have hDvQuotCard : Nat.card (↥(UnbalancedGS.gsFixedLayer P v) ⧸
      pPrimeCore 2 ↥(UnbalancedGS.gsFixedLayer P v)) =
      Nat.card (↥P ⧸ pPrimeCore 2 ↥P) := by
    obtain ⟨eDq⟩ := hDv_quot
    exact Nat.card_congr eDq.toEquiv
  have hDvEven : 2 ∣ Nat.card ↥(UnbalancedGS.gsFixedLayer P v) := by
    have hcard := Subgroup.card_eq_card_quotient_mul_card_subgroup
      (pPrimeCore 2 ↥(UnbalancedGS.gsFixedLayer P v))
    rw [hcard]
    exact dvd_mul_of_dvd_left (by rw [hDvQuotCard]; exact hPquotEven) _
  have hModd : Odd (Nat.card (pPrimeCore 2 ↥M)) :=
    Nat.coprime_two_left.mp CFSG.pPrimeCore_coprime_card
  have hpiD_ne : Dbar ≠ ⊥ := by
    intro hbot
    have hle := (Subgroup.map_eq_bot_iff
      ((UnbalancedGS.gsFixedLayer P v).subgroupOf M)).mp hbot
    have hker_eq : π.ker = pPrimeCore 2 ↥M := QuotientGroup.ker_mk' _
    rw [hker_eq] at hle
    have hdvd : Nat.card ↥((UnbalancedGS.gsFixedLayer P v).subgroupOf M) ∣
        Nat.card (pPrimeCore 2 ↥M) := Subgroup.card_dvd_of_le hle
    have h2 : 2 ∣ Nat.card ↥((UnbalancedGS.gsFixedLayer P v).subgroupOf M) := by
      rwa [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hDvM).toEquiv]
    exact (Nat.not_even_iff_odd.mpr hModd) (even_iff_two_dvd.mpr (h2.trans hdvd))
  let vM : ↥M := ⟨v, hvM⟩
  have hE : IsPGroup 2 (Subgroup.zpowers vM) := by
    apply IsPGroup.of_card (n := 1)
    rw [Nat.card_zpowers]
    have hvMord : orderOf vM = 2 := by
      show orderOf (⟨v, hvM⟩ : ↥M) = 2
      rw [Subgroup.orderOf_mk, hv]
    rw [hvMord]
    norm_num
  have hker : ¬ 2 ∣ Nat.card (π.domRestrict (⊤ : Subgroup ↥M)).ker := by
    have hcard : Nat.card (π.domRestrict (⊤ : Subgroup ↥M)).ker =
        Nat.card (pPrimeCore 2 ↥M) := by
      have hk : (π.domRestrict (⊤ : Subgroup ↥M)).ker =
          (pPrimeCore 2 ↥M).subgroupOf (⊤ : Subgroup ↥M) := by
