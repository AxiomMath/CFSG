@[expose] def nVals : Array Native.Mat := Native.slpRun nGens progY

@[expose] def nT : Native.Mat := nGen 70

@[expose] def oddOK (i m : ℕ) : Bool :=
  m % 2 == 1 && Native.eqM (Native.pow (nVals.getD i Native.one) m) Native.one &&
    Native.eqM (Native.mul (nVals.getD i Native.one) nT) (Native.mul nT (nVals.getD i Native.one))

