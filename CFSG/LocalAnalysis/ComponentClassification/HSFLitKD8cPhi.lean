@[expose] def phiR (j : Fin 8) (x : MC) : MC := ofCode (tget (phiTab j) 8 (codeMC x))

@[expose] def sR : Fin 8 → Fin 2 → MC
  | 0, 0 => ⟨5, 8⟩
  | 0, 1 => ⟨13, 8⟩
  | 1, 0 => ⟨5, 14⟩
  | 1, 1 => ⟨13, 14⟩
  | 2, 0 => ⟨1, 0⟩
  | 2, 1 => ⟨9, 0⟩
  | 5, 0 => ⟨0, 0⟩
  | 5, 1 => ⟨8, 0⟩
  | 6, 0 => ⟨5, 14⟩
  | 6, 1 => ⟨13, 14⟩
  | 7, 0 => ⟨4, 8⟩
  | 7, 1 => ⟨12, 8⟩
  | _, _ => 1

@[expose] def ValidS (φ : MC → MC) (s : MC) : Prop :=
  φ s = s ∧ ∀ g ∈ MC.gens, φ (φ g) = s * g * s⁻¹

instance (φ : MC → MC) (s : MC) : Decidable (ValidS φ s) := by unfold ValidS; infer_instance

theorem phiR_pcX : ∀ j : Fin 8, MC.PcX (phiR j MC.w₂) (phiR j MC.u) (phiR j MC.w₁) (phiR j MC.v)
    (phiR j MC.z) (phiR j MC.y) (phiR j MC.t) (phiR j MC.k) := by
  intro j; fin_cases j <;> constructor <;> decide +kernel

theorem phiR_nf : ∀ j : Fin 8, ∀ x : MC,
    phiR j x = nfProd (MC.gens.map (phiR j)) (MC.nfBits x) := by
  decide +kernel

theorem mul_of_nf {f : MC → MC} (hpc : MC.PcX (f MC.w₂) (f MC.u) (f MC.w₁) (f MC.v) (f MC.z)
    (f MC.y) (f MC.t) (f MC.k)) (hnf : ∀ x : MC, f x = nfProd (MC.gens.map f) (MC.nfBits x))
    (a b : MC) : f (a * b) = f a * f b := by
  obtain ⟨ι, h1, h2, h3, h4, h5, h6, h7, h8⟩ := MC.exists_hom hpc
  have hι : ∀ x, f x = ι x := fun x => by
    have hx : ι x = nfProd (MC.gens.map ι) (MC.nfBits x) := by
      conv_lhs => rw [MC.nf_spec x]
      exact map_nfProd ι _ _
    rw [hx, hnf x]
    simp [MC.gens, h1, h2, h3, h4, h5, h6, h7, h8]
  rw [hι, hι, hι, map_mul]

theorem phiR_mul (j : Fin 8) (a b : MC) : phiR j (a * b) = phiR j a * phiR j b :=
  mul_of_nf (phiR_pcX j) (phiR_nf j) a b

theorem validS_iff : ∀ j : Fin 8, ∀ s : MC, ValidS (phiR j) s →
    j ≠ 3 ∧ j ≠ 4 ∧ (s = sR j 0 ∨ s = sR j 1) := by
  decide +kernel

theorem sR_valid : ∀ j : Fin 8, j ≠ 3 → j ≠ 4 → ∀ i : Fin 2, phiR j (sR j i) = sR j i ∧
    ∀ b : MC, phiR j (phiR j b) = sR j i * b * (sR j i)⁻¹ := by
  decide +kernel

@[expose] def D (j : Fin 8) (hj3 : j ≠ 3) (hj4 : j ≠ 4) (i : Fin 2) : ExtData MC where
  φ := phiR j
  s := sR j i
  map_mul := phiR_mul j
  φ_s := (sR_valid j hj3 hj4 i).1
  φ_φ := (sR_valid j hj3 hj4 i).2

