theorem solomonLt_of_footeStep {a b : G} {L B : Subgroup G} (hL : IsTwoComponentAt a L)
    (hBb : IsTwoComponentAt b B) (hb : orderOf b = 2) (hab : a * b = b * a)
    (hbL : b ∈ coreActionKernel L)
    (hT : UnbalancedGS.gsFixedLayer L b ≤ B ⊔ conjugate B a) : SolomonLt L B := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨ha, hLa, hLpc⟩ := hL
  have hLq := isQuasisimple_quotient_of_isPComponent hLa hLpc
  have hb2 : IsPGroup 2 (zpowers b) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hb, pow_one])
  have hbQ : zpowers b ≤ coreActionKernel L := (zpowers_le).mpr hbL
  have hzb : centralizer ((zpowers b : Subgroup G) : Set G) = centralizer ({b} : Set G) := by
    rw [zpowers_eq_closure, centralizer_closure]
  obtain ⟨hRY, hLY, -, -⟩ :=
    cover_facts hLq inf_le_left (inf_centralizer_sup_oddCoreIn_eq hb2 hbQ)
  rw [hzb] at hRY hLY
  set J := UnbalancedGS.gsFixedLayer L b with hJdef
  have hJeq : J = oddResidualIn (L ⊓ centralizer ({b} : Set G)) := hLY
  have hJperf : ⁅J, J⁆ = J := by
    rw [hJeq]
    exact UnbalancedCorr.commutator_eq_of_isPComponent hRY.1 hRY.2
  have hJinv : ∃ y ∈ J, orderOf y = 2 := by
    rw [hJeq]
    exact exists_involution hRY
  have haCb : a ∈ centralizer ({b} : Set G) := mem_centralizer_singleton_iff.mpr hab
  obtain ⟨-, hBC, hBpc⟩ := hBb
  have hBaC : conjugate B a ≤ centralizer ({b} : Set G) := conjugate_le_of_mem hBC haCb
  have hBapc : IsPComponent 2 ((conjugate B a).subgroupOf (centralizer ({b} : Set G))) :=
    isPComponent_conjugate_subgroupOf haCb hBpc
  have hJL : J ≤ twoLayerIn (centralizer ({b} : Set G)) :=
    hT.trans (sup_le (le_twoLayerIn_of_isTwoComponentIn ⟨hBC, hBpc⟩)
      (le_twoLayerIn_of_isTwoComponentIn ⟨hBaC, hBapc⟩))
  have hJB : ¬ J ≤ coreActionKernel B := by
    intro hJB
    have hJBa : J ≤ coreActionKernel (conjugate B a) := by
      have h1 : J.map (MulAut.conj a⁻¹).toMonoidHom ≤
          (coreActionKernel B).map (MulAut.conj a⁻¹).toMonoidHom := map_mono hJB
      rw [Sol76.map_coreActionKernel] at h1
      have hJa : J.map (MulAut.conj a⁻¹).toMonoidHom = J := by
        ext y
        have hfix : ∀ w ∈ J, a⁻¹ * w * a⁻¹⁻¹ = w := fun w hw => by
          have hwa : w * a = a * w := mem_centralizer_singleton_iff.mp
            (hLa ((UnbalancedGS.gsFixedLayer_le_inf L b).trans inf_le_left hw))
          rw [inv_inv, mul_assoc, hwa, inv_mul_cancel_left]
        constructor
        · rintro ⟨w, hw, rfl⟩
          simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
          rw [hfix w hw]
          exact hw
        · intro hy
          exact ⟨y, hy, by simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]; exact hfix y hy⟩
      rw [hJa] at h1
      exact h1
    obtain ⟨M, hM, hJM⟩ := Sol76T13.exists_not_le_coreActionKernel_of_le_twoLayerIn hJperf hJL hJinv
    have hMB : M ≠ B := fun h => hJM (h ▸ hJB)
    have hMBa : M ≠ conjugate B a := fun h => hJM (h ▸ hJBa)
    exact hJM (hT.trans (sup_le
      (GSThmB.B5a.le_coreActionKernel_of_ne hM.1 hBC hM.2 hBpc hMB)
      (GSThmB.B5a.le_coreActionKernel_of_ne hM.1 hBaC hM.2 hBapc hMBa)))
  refine ⟨isSolomonMember_of_isTwoComponentIn_centralizer ha ⟨hLa, hLpc⟩,
    isSolomonMember_of_isTwoComponentIn_centralizer hb ⟨hBC, hBpc⟩, zpowers b, hb2, hbQ, ?_⟩
  rw [hzb]
  exact isTwoComponentIn_conjClosure_of_not_le ⟨hBC, hBpc⟩ hJL hJB

theorem solomonStep_cases_index {a b : G} {L : Subgroup G} (hmax : IsSolomonMaximal L)
    (hL : IsTwoComponentAt a L) (hb : orderOf b = 2) (hab : a * b = b * a) (hne : a ≠ b)
    (hbL : b ∈ coreActionKernel L) :
    ∃ B : Subgroup G, IsTwoComponentAt b B ∧ SolomonEquiv L B ∧
      Nonempty (L ⧸ Open.fusionZStar L ≃* B ⧸ Open.fusionZStar B) ∧
      ((conjugate B a = B ∧ footeFixed L b = B) ∨
        (conjugate B a ≠ B ∧ UnbalancedGS.gsFixedLayer L b =
          twoLayerIn ((B ⊔ conjugate B a) ⊓ centralizer ({a} : Set G)) ∧
          (pPrimeCore 2 (UnbalancedGS.gsFixedLayer L b)).index ≤ (pPrimeCore 2 B).index)) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨B, hBb, -, hT, hcl, hcase⟩ := exists_footeStep footeLBalanceInput_holds hL hb hab hne hbL
  have hlt := solomonLt_of_footeStep hL hBb hb hab hbL hT
  have hLB : SolomonEquiv L B := hmax.2 L B ⟨hmax.1, Relation.ReflTransGen.refl⟩ hlt
  obtain ⟨eLB⟩ := nonempty_fusionZStar_equiv_of_reflTransGen hLB.2
  refine ⟨B, hBb, hLB, ⟨eLB⟩, ?_⟩
  obtain ⟨-, hLa, hLpc⟩ := hL
  have hLq := isQuasisimple_quotient_of_isPComponent hLa hLpc
  have hTL : UnbalancedGS.gsFixedLayer L b ≤ L :=
    (UnbalancedGS.gsFixedLayer_le_inf L b).trans inf_le_left
  rcases hcase with ⟨hBa, hBres, -⟩ | ⟨-, -, hiso⟩ | ⟨hBa, hT', hidx⟩
  · left
    refine ⟨hBa, le_antisymm ?_ ?_⟩
    · have h1 := (le_conjClosure (footeFixed L b) (twoLayerOf b)).trans hcl.le
      rwa [hBa, sup_idem] at h1
    · rw [hBres, footeFixed_eq_oddResidualIn]
      exact oddResidualIn_mono (sup_le_sup_right (UnbalancedGS.gsFixedLayer_le_inf L b) _)
  · exfalso
    obtain ⟨-, eT, -⟩ := restriction_quotient_mulEquiv hTL
      (gsFixedLayer_sup_map_pPrimeCore hb hLq hbL.1 hbL.2)
    obtain ⟨eZ⟩ := nonempty_fusionZStar_equiv_of_quotient_equiv eT
    exact hiso.false (eZ.trans eLB)
  · exact Or.inr ⟨hBa, hT', hidx⟩

end RankOneClass

theorem exists_classical_of_isSolomonMaximal
    (hβ : ∀ B : Subgroup G, (∃ b : G, IsTwoComponentAt b B) → FooteFamilyType B →
      Nat.card (center (B ⧸ pPrimeCore 2 B)) ≤ 2)
    {z : G} {A : Subgroup G} (hAmax : IsSolomonMaximal A) (hzA : IsTwoComponentAt z A)
    (hAfam : FooteFamilyType A) (hrank : CFSG.pRank 2 ↥A ≤ 1) :
    ∃ (x : G) (X : Subgroup G), IsTwoComponentAt x X ∧ x ∈ X ∧ CFSG.pRank 2 ↥X ≤ 1 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  by_cases hz : z ∈ A
  · exact ⟨z, A, hzA, hz, hrank⟩
  obtain ⟨a, haA, ha⟩ := exists_involution_of_isTwoComponentAt hzA
  have haK : a ∈ coreActionKernel A := mem_coreActionKernel_of_pRank_le_one hzA hrank haA ha
  have hne : z ≠ a := fun h => hz (h ▸ haA)
  have hza : z * a = a * z := (mem_centralizer_singleton_iff.mp (hzA.2.1 haA)).symm
  obtain ⟨B, hBa, hAB, ⟨eAB⟩, hcase⟩ :=
    RankOneClass.solomonStep_cases_index hAmax hzA ha hza hne haK
  have hBmax : IsSolomonMaximal B := isSolomonMaximal_of_solomonEquiv hAmax hAB
  have hBfam : FooteFamilyType B := footeFamilyType_of_equiv eAB.symm hAfam
  rcases hcase with ⟨-, hBfix⟩ | ⟨hBz, hT, hidx⟩
  ·
    refine ⟨a, B, hBa, hBfix ▸ mem_footeFixed_self haA ha, ?_⟩
    have hBa' : IsTwoComponentAt a (footeFixed A a) := hBfix ▸ hBa
    rw [← hBfix, pRank_footeFixed_eq hzA ha haK hBa']
    exact hrank
  obtain ⟨-, hBC, hBpc⟩ := id hBa
  have hBq := isQuasisimple_quotient_of_isPComponent hBC hBpc
  have hAq := isQuasisimple_quotient_of_isPComponent hzA.2.1 hzA.2.2
  set T := UnbalancedGS.gsFixedLayer A a with hTdef
  have hTA : Nat.card (T ⧸ pPrimeCore 2 T) = Nat.card (A ⧸ pPrimeCore 2 A) := by
    have hTL : T ≤ A := (UnbalancedGS.gsFixedLayer_le_inf A a).trans inf_le_left
    obtain ⟨-, eT, -⟩ := restriction_quotient_mulEquiv hTL
      (gsFixedLayer_sup_map_pPrimeCore ha hAq haK.1 haK.2)
    exact Nat.card_congr eT.toEquiv
  have hcardAB : Nat.card (A ⧸ pPrimeCore 2 A) ≤ Nat.card (B ⧸ pPrimeCore 2 B) := by
    rw [← hTA]
    exact hidx
  have hZA : center (A ⧸ pPrimeCore 2 A) ≠ ⊥ := center_ne_bot_of_mem_coreActionKernel haA ha haK
  have hZB : center (B ⧸ pPrimeCore 2 B) ≠ ⊥ := by
    intro hbot
    have h4 : 1 < Nat.card (center (A ⧸ pPrimeCore 2 A)) :=
      (Subgroup.one_lt_card_iff_ne_bot _).mpr hZA
    have h5 : Nat.card (center (B ⧸ pPrimeCore 2 B)) = 1 := by
      rw [hbot]; exact Subgroup.card_bot
    have hpos : 0 < Nat.card (B ⧸ Open.fusionZStar B) := Nat.card_pos
    rw [card_quotient_pPrimeCore_eq ↥A, card_quotient_pPrimeCore_eq ↥B,
      Nat.card_congr eAB.toEquiv, h5, one_mul] at hcardAB
    have h6 := Nat.le_of_mul_le_mul_right (hcardAB.trans (Nat.le_of_eq (one_mul _).symm)) hpos
    omega
  have hBrank : CFSG.pRank 2 ↥B ≤ 1 :=
    pRank_le_one_of_center_ne_bot hBq hBfam (hβ B ⟨a, hBa⟩ hBfam) hZB
  by_cases haB : a ∈ B
  · exact ⟨a, B, hBa, haB, hBrank⟩
  obtain ⟨b, hbB, hb⟩ := exists_involution_of_isTwoComponentAt hBa
  have hbK : b ∈ coreActionKernel B := mem_coreActionKernel_of_pRank_le_one hBa hBrank hbB hb
  have hab : a * b = b * a := (mem_centralizer_singleton_iff.mp (hBC hbB)).symm
  have hne' : a ≠ b := fun h => haB (h ▸ hbB)
  have hzCa : z ∈ centralizer ({a} : Set G) := mem_centralizer_singleton_iff.mpr hza
  have hBzC : conjugate B z ≤ centralizer ({a} : Set G) := conjugate_le_of_mem hBC hzCa
  have hBzpc : IsPComponent 2 ((conjugate B z).subgroupOf (centralizer ({a} : Set G))) :=
    isPComponent_conjugate_subgroupOf hzCa hBpc
  have hBza : IsTwoComponentAt a (conjugate B z) := ⟨ha, hBzC, hBzpc⟩
  have hbK' : b ∈ coreActionKernel (conjugate B z) :=
    GSThmB.B5a.le_coreActionKernel_of_ne hBzC hBC hBzpc hBpc hBz hbB
  have haT : a ∈ T := mem_gsFixedLayer_self hzA haA ha haK
  have haBB : a ∈ B ⊔ conjugate B z := by
    have h1 : a ∈ twoLayerIn ((B ⊔ conjugate B z) ⊓ centralizer ({z} : Set G)) := hT ▸ haT
    exact (inf_le_left : (B ⊔ conjugate B z) ⊓ centralizer ({z} : Set G) ≤ _)
      (map_subtype_le _ h1)
  have haL : a ∈ twoLayerOf b := mem_twoLayerOf_of_mem_sup ha hb hab hBa hBza hbK hbK' haBB
  obtain ⟨D, hDb, -, -, hcase'⟩ :=
    RankOneClass.solomonStep_cases_index hBmax hBa hb hab hne' hbK
  rcases hcase' with ⟨-, hDfix⟩ | ⟨hDa, -, -⟩
  · refine ⟨b, D, hDb, hDfix ▸ mem_footeFixed_self hbB hb, ?_⟩
    have hDb' : IsTwoComponentAt b (footeFixed B b) := hDfix ▸ hDb
    rw [← hDfix, pRank_footeFixed_eq hBa hb hbK hDb']
    exact hBrank
  · exfalso
    apply hDa
    obtain ⟨-, hDC, hDpc⟩ := hDb
    exact conjugate_eq_of_mem_normalizer (twoLayerIn_le_normalizer hDC hDpc haL)

end CFSG.ComponentClassification.Sol76
