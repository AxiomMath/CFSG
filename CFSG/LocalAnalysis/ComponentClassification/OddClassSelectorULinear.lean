variable {p f : ℕ} {E : Type} [Field E] {V : Type} [AddCommGroup V] [Module E V]
  [FiniteDimensional E V]

theorem exists_antifixed_sq_add_sq [Fact p.Prime] [Finite E] (h : UnitaryFieldData p f E)
    (hp : p ≠ 2) :
    ∃ a b : E, CatalogueBUnitaryTwo.unitaryFieldConjugation p f h.card_eq_sq a = -a ∧
      CatalogueBUnitaryTwo.unitaryFieldConjugation p f h.card_eq_sq b = -b ∧
      a ^ 2 + b ^ 2 = -1 := by
  classical
  set sigma := CatalogueBUnitaryTwo.unitaryFieldConjugation p f h.card_eq_sq with hsigdef
  obtain ⟨hsigma, hne, hk0⟩ := CatalogueBUnitaryTwo.unitaryFieldConjugation_data p f h.card_eq_sq
  obtain ⟨t, ht⟩ := CatalogueBUnitaryTwo.exists_antifixed_unit sigma hsigma hne
  have hc : sigma (-((t : E)⁻¹ ^ 2)) = -((t : E)⁻¹ ^ 2) := by
    rw [map_neg, map_pow, map_inv₀, ht, inv_neg, neg_sq]
  let c0 : CatalogueBLinearTwoDescent.fixedSubfield E sigma :=
    ⟨-((t : E)⁻¹ ^ 2), (CatalogueBLinearTwoDescent.mem_fixedSubfield E sigma _).mpr hc⟩
  have hodd0 : Odd (Nat.card (CatalogueBLinearTwoDescent.fixedSubfield E sigma)) := by
    rw [hk0]
    exact (h.prime.odd_of_ne_two hp).pow
  obtain ⟨a0, b0, hab0⟩ := exists_sq_add_sq hodd0 c0
  have ha0 : sigma (a0 : E) = a0 :=
    (CatalogueBLinearTwoDescent.mem_fixedSubfield E sigma _).mp a0.2
  have hb0 : sigma (b0 : E) = b0 :=
    (CatalogueBLinearTwoDescent.mem_fixedSubfield E sigma _).mp b0.2
  have hab : (a0 : E) ^ 2 + (b0 : E) ^ 2 = -((t : E)⁻¹ ^ 2) := by
    have := congrArg Subtype.val hab0
    push_cast at this
    exact this
  refine ⟨t * a0, t * b0, ?_, ?_, ?_⟩
  · rw [map_mul, ht, ha0, neg_mul]
  · rw [map_mul, ht, hb0, neg_mul]
  · have ht0 : (t : E) ≠ 0 := Units.ne_zero t
    calc ((t : E) * a0) ^ 2 + ((t : E) * b0) ^ 2 = (t : E) ^ 2 * ((a0 : E) ^ 2 + (b0 : E) ^ 2) :=
          by ring
      _ = -1 := by rw [hab]; field_simp

theorem nonempty_unitarySpecial_equiv [Fact p.Prime] [Finite E] (h : UnitaryFieldData p f E)
    {W : Type} [AddCommGroup W] [Module E W] (C : W →ₛₗ[h.bar] W →ₗ[E] E) :
    Nonempty (unitarySpecial C ≃* specialIsometry
      (sigma := CatalogueBUnitaryTwo.unitaryFieldConjugation p f h.card_eq_sq) C) := by
  set e := CatalogueBUnitaryB.sesqUnitaryIsometryEquiv h C with he
  have hmap : (unitarySpecial C).map e.toMonoidHom = specialIsometry
      (sigma := CatalogueBUnitaryTwo.unitaryFieldConjugation p f h.card_eq_sq) C := by
    ext x
    constructor
    · rintro ⟨g, hg, rfl⟩
      exact (mem_specialIsometry_iff
        (sigma := CatalogueBUnitaryTwo.unitaryFieldConjugation p f h.card_eq_sq) C
        (e.toMonoidHom g)).mpr (mem_unitarySpecial.mp hg)
    · intro hx
      have h1 := (mem_specialIsometry_iff
        (sigma := CatalogueBUnitaryTwo.unitaryFieldConjugation p f h.card_eq_sq) C x).mp hx
      exact ⟨e.symm x, mem_unitarySpecial.mpr h1, e.apply_symm_apply x⟩
  exact ⟨((unitarySpecial C).equivMapOfInjective e.toMonoidHom e.injective).trans
    (MulEquiv.subgroupCongr hmap)⟩

theorem su_half_false (h : UnitaryFieldData p f E) (hp : p ≠ 2) {B : V →ₛₗ[h.bar] V →ₗ[E] E}
    {W F : Submodule E V} (hWs : (B.domRestrict₁₂ W W).IsSymm)
    (hWl : (B.domRestrict₁₂ W W).SeparatingLeft) (hW1 : 1 ≤ finrank E W) (hF0 : F ≠ ⊥)
    {Y : Subgroup (sesqUnitaryGroup B)} (hYF : ∀ y ∈ Y, ∀ w ∈ F, unitaryOp y w = w)
    (ρ : Y →* sesqUnitaryGroup (B.domRestrict₁₂ W W)) (hρi : Function.Injective ρ)
    (hρc : CFSG.IsComponent ρ.range)
    {X' : Type} [Group X'] {X : Subgroup X'} (σ : Y →* X) (hσs : Function.Surjective σ)
    (hσk : σ.ker ≤ center Y)
    (hker : ∀ y : Y, σ y = 1 → (y : sesqUnitaryGroup B) ∈ sesqNormOneScalars h B)
    (hs : SmallSource X) : False := by
  classical
  have : Fact p.Prime := ⟨h.prime⟩
  have := h.finite
  obtain ⟨hsigma, hne, hk0⟩ := CatalogueBUnitaryTwo.unitaryFieldConjugation_data p f h.card_eq_sq
  have hsig := CatalogueBUnitaryTwo.unitaryFieldConjugation_apply p f h.card_eq_sq
  have hnd := CatalogueBUnitaryB.nondegenerate_of_isSymm hWs hWl
  obtain ⟨hdim2, h23, hρeq⟩ := eq_unitarySpecial_of_isComponent h hp hW1 hWs hWl hρc
  let eρ := MonoidHom.ofInjective hρi
  by_cases h3 : 3 ≤ finrank E W
  · exact unitary_component_false_of_quaternion_equiv h.prime hp h.one_le h.card_eq_sq h3
      (B.domRestrict₁₂ W W) hWs hnd hsigma hne hsig (exists_antifixed_sq_add_sq h hp)
      (CatalogueBUnitaryB.sesqUnitaryIsometryEquiv h (B.domRestrict₁₂ W W)) hρc
      (σ.comp eρ.symm.toMonoidHom) (hσs.comp eρ.symm.surjective)
      (ker_comp_le_center eρ.symm.toMonoidHom eρ.symm.injective σ hσk) hs
  · have hd2 : finrank E W = 2 := by omega
    have hq3 : p ^ f ≠ 3 := fun h3' => h23 (by rw [hd2, h3'])
    have hσi : Function.Injective σ := by
      rw [injective_iff_map_eq_one]
      intro y hy
      exact Subtype.ext (eq_one_of_mem_sesqNormOneScalars (hker y hy) hF0 (hYF y y.2))
    obtain ⟨eU⟩ := nonempty_unitarySpecial_equiv h (B.domRestrict₁₂ W W)
    obtain ⟨-, -, -, eSL, -⟩ := CatalogueBUnitaryTwo.unitary_field_two_special_linear_isomorphism
      p f h.card_eq_sq (B.domRestrict₁₂ W W) hWs hnd hd2
    exact false_of_sl_two h.prime hp h.one_le hk0 hq3
      ((MulEquiv.ofBijective σ ⟨hσi, hσs⟩).symm.trans
        (eρ.trans ((MulEquiv.subgroupCongr hρeq).trans (eU.trans eSL)))) hs

theorem su_linear_false (h : UnitaryFieldData p f E) (hp : p ≠ 2) (hn : 5 ≤ finrank E V)
    {B : V →ₛₗ[h.bar] V →ₗ[E] E} (hB : B.IsSymm) (hBl : B.SeparatingLeft)
    {T : sesqUnitaryGroup B} (hT : orderOf (QuotientGroup.mk T : sesqProjUnitary h B) = 2)
    {Y : Subgroup (sesqUnitaryGroup B)}
    (hY : CFSG.Assembly.IsComponentOf Y (centralizer ({T} : Set (sesqUnitaryGroup B))))
    {X' : Type} [Group X'] {X : Subgroup X'} (σ : Y →* X) (hσs : Function.Surjective σ)
    (hσk : σ.ker ≤ center Y)
    (hker : ∀ y : Y, σ y = 1 → (y : sesqUnitaryGroup B) ∈ sesqNormOneScalars h B)
    (hs : SmallSource X) : False := by
  classical
  have : Fact p.Prime := ⟨h.prime⟩
  have := h.finite
  obtain ⟨l, hl0, hAA, hN, hP, hM, hc, hsplit, hpaired, -⟩ :=
    projective_unitary_involution_centralizer_matrix_structure h hp (by omega) hB hBl hT
  have hY₁ := (isComponentOf_iff_isComponent_subgroupOf hY.1).mp hY
  let eY : Y.subgroupOf (centralizer ({T} : Set (sesqUnitaryGroup B))) ≃* Y :=
    Subgroup.subgroupOfEquivOfLe hY.1
  have hσ₁k := ker_comp_le_center eY.toMonoidHom eY.injective σ hσk
  have hker₁ : ∀ y, (σ.comp eY.toMonoidHom) y = 1 →
      ((eY y : Y) : sesqUnitaryGroup B) ∈ sesqNormOneScalars h B := fun y hy => hker _ hy
  rcases hN with hN | hN
  ·
    obtain ⟨-, hsepP, hsepM, e, he⟩ := hsplit hN
    have hsymm : ∀ P : Submodule E V, (B.domRestrict₁₂ P P).IsSymm := fun P =>
      ⟨fun x y => hB.eq (x : V) (y : V)⟩
    rcases fst_eq_or_snd_eq_of_isComponent_prod (isComponent_map_of_isComponent e hY₁) with
      h2 | h1
    ·
      have h2' : ∀ x ∈ Y.subgroupOf (centralizer ({T} : Set (sesqUnitaryGroup B))),
          (e x).2 = 1 := fun x hx => h2 _ (mem_map_of_mem _ hx)
      obtain ⟨ρ₁, hρ₁i, hρ₁c, -⟩ := restrict_component e hY₁ h2'
      have hYF : ∀ y ∈ Y, ∀ w ∈ eigenMinus l (unitaryOp T), unitaryOp y w = w := by
        intro y hy w hw
        have h4 := LinearMap.congr_fun (he (eY.symm ⟨y, hy⟩)).2 ⟨w, hw⟩
        rw [h2' _ (eY.symm ⟨y, hy⟩).2] at h4
        exact h4.symm
      refine su_half_false h hp (hsymm _) hsepP (Submodule.one_le_finrank_iff.mpr hP) hM hYF
        (ρ₁.comp eY.symm.toMonoidHom) (hρ₁i.comp eY.symm.injective) ?_ σ hσs hσk hker hs
      rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr eY.symm.surjective,
        ← MonoidHom.range_eq_map]
      exact hρ₁c
    ·
      have h1' : ∀ x ∈ Y.subgroupOf (centralizer ({T} : Set (sesqUnitaryGroup B))),
          ((e.trans MulEquiv.prodComm) x).2 = 1 := fun x hx => h1 _ (mem_map_of_mem _ hx)
      obtain ⟨ρ₁, hρ₁i, hρ₁c, -⟩ := restrict_component (e.trans MulEquiv.prodComm) hY₁ h1'
      have hYF : ∀ y ∈ Y, ∀ w ∈ eigenPlus l (unitaryOp T), unitaryOp y w = w := by
        intro y hy w hw
        have h4 := LinearMap.congr_fun (he (eY.symm ⟨y, hy⟩)).1 ⟨w, hw⟩
        rw [show (e (eY.symm ⟨y, hy⟩)).1 = 1 from h1' _ (eY.symm ⟨y, hy⟩).2] at h4
        exact h4.symm
      refine su_half_false h hp (hsymm _) hsepM (Submodule.one_le_finrank_iff.mpr hM) hP hYF
        (ρ₁.comp eY.symm.toMonoidHom) (hρ₁i.comp eY.symm.injective) ?_ σ hσs hσk hker hs
      rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr eY.symm.surjective,
        ← MonoidHom.range_eq_map]
      exact hρ₁c
  ·
    obtain ⟨-, -, -, hdim2, -, -, e, -⟩ := hpaired hN
    obtain ⟨bP⟩ : Nonempty (Basis (Fin (finrank E (eigenPlus l (unitaryOp T)))) E
        (eigenPlus l (unitaryOp T))) := ⟨Module.finBasis E _⟩
    exact gl_component_false (by omega) h.prime hp (j := 2 * f) (by have := h.one_le; omega)
      (by rw [h.card_eq_sq, ← pow_mul, mul_comm])
      (e.trans (Units.mapEquiv (LinearMap.toMatrixAlgEquiv bP).toMulEquiv)) hY₁
      (σ.comp eY.toMonoidHom) hσ₁k hs

