private theorem quotient_injective_on_two
    {G : Type} [Group G] [Finite G] (L R : Subgroup G)
    (hR : IsPGroup 2 R) (hRL : R ≤ L) :
    Function.Injective ((QuotientGroup.mk' (CFSG.pPrimeCore 2 L)).comp
      (Subgroup.inclusion hRL)) := by
  let π : L →* (L ⧸ CFSG.pPrimeCore 2 L) := QuotientGroup.mk' _
  have hodd : Odd (Nat.card π.ker) := by
    rw [show π.ker = CFSG.pPrimeCore 2 L from QuotientGroup.ker_mk' _]
    exact Nat.coprime_two_left.mp (CFSG.pPrimeCore_coprime_card (p := 2) (G := L))
  have hi := CFSG.RankThree.OddKernel.injective_restrict_of_odd π hodd
    (hR.comap_subtype : IsPGroup 2 (R.subgroupOf L))
  let e : R.subgroupOf L ≃* R := subgroupOfEquivOfLe hRL
  exact hi.comp e.symm.injective

theorem sylow_odd_quotient_data
    {G : Type} [Group G] [Finite G] (L S : Subgroup G)
    (eL : L ⧸ CFSG.pPrimeCore 2 L ≃*
      Matrix.ProjectiveSpecialLinearGroup (Fin 2) (GaloisField 2 4))
    (hS : IsSylowOf 2 S (normalizer (L : Set G))) :
    CFSG.Open.IsElemAbelian 2 (S ⊓ L) ∧ Nat.card (S ⊓ L : Subgroup G) = 16 := by
  have hR : IsSylowOf 2 (S ⊓ L) L := hS.inf_of_le_normalizer le_normalizer le_rfl
  obtain ⟨R0, hR0⟩ := hR.exists_sylow_eq_subgroupOf
  let π : L →* (L ⧸ CFSG.pPrimeCore 2 L) := QuotientGroup.mk' _
  let R1 : Sylow 2 (L ⧸ CFSG.pPrimeCore 2 L) :=
    R0.mapSurjective (f := π) (QuotientGroup.mk'_surjective _)
  let e := eL.trans sl2EquivPSL2.symm
  let R2 : Sylow 2 SL(2, GaloisField 2 4) :=
    R1.mapSurjective (f := e.toMonoidHom) e.surjective
  obtain ⟨g, hg⟩ := exists_conjSubgroup_utri_eq_of_sylow R2
  have hR2 : CFSG.Open.IsElemAbelian 2 (R2 : Subgroup SL(2, GaloisField 2 4)) := by
    rw [← hg]
    exact CFSG.Open.IsElemAbelian.map isElemAbelian_utri (MulAut.conj g).toMonoidHom
  have hR2c : Nat.card R2 = 16 := by
    rw [← hg]
    change Nat.card ((utri (GaloisField 2 4)).map (MulAut.conj g).toMonoidHom) = 16
    rw [card_map_of_injective (MulAut.conj g).injective, card_utri,
      GaloisField.card 2 4 (by decide)]
    norm_num
  let ψ : ↥(S ⊓ L) →* SL(2, GaloisField 2 4) :=
    e.toMonoidHom.comp (π.comp (Subgroup.inclusion (inf_le_right : S ⊓ L ≤ L)))
  have hψi : Function.Injective ψ := e.injective.comp
    (quotient_injective_on_two L (S ⊓ L) hR.isPGroup inf_le_right)
  have hψr : ψ.range = (R2 : Subgroup SL(2, GaloisField 2 4)) := by
    rw [show (R2 : Subgroup SL(2, GaloisField 2 4)) =
      (R1 : Subgroup (L ⧸ CFSG.pPrimeCore 2 L)).map e.toMonoidHom from rfl]
    rw [show (R1 : Subgroup (L ⧸ CFSG.pPrimeCore 2 L)) = (R0 : Subgroup L).map π from rfl,
      hR0]
    ext x
    constructor
    · rintro ⟨r, rfl⟩
      exact ⟨π (Subgroup.inclusion inf_le_right r),
        ⟨Subgroup.inclusion inf_le_right r, r.2, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨r, hr, rfl⟩, rfl⟩
      exact ⟨⟨r, hr⟩, rfl⟩
  have hE : CFSG.IsElementaryAbelian 2 ↥(S ⊓ L) := by
    let eq := MonoidHom.ofInjective hψi
    have hEr : CFSG.IsElementaryAbelian 2 ψ.range := by
      rw [hψr]
      exact hR2.isElementaryAbelian
    exact CFSG.IsElementaryAbelian.of_mulEquiv eq.symm hEr
  refine ⟨CFSG.Open.isElemAbelian_iff_isElementaryAbelian.mpr hE, ?_⟩
  rw [Nat.card_congr (MonoidHom.ofInjective hψi).toEquiv, hψr]
  exact hR2c

