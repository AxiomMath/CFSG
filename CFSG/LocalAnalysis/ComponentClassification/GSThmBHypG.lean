variable {X : Type} [Group X] [Finite X]

theorem le_normalizer_layerIn_self (W : Subgroup X) :
    W ≤ normalizer ((layerIn W : Subgroup X) : Set X) := fun w hw => by
  have : (pLayer ↥W 2).Characteristic := CatalogueBPrimeJoin.pLayer_characteristic
  exact UnbalancedGS.normalizer_le_normalizer_map_of_characteristic W (pLayer ↥W 2)
    (le_normalizer hw)

@[expose] def layerActKer (W : Subgroup X) : Subgroup ↥W :=
  (coreActionKernel (layerIn W)).subgroupOf W

instance layerActKer_normal (W : Subgroup X) : (layerActKer W).Normal := by
  refine ⟨fun d hd w => ?_⟩
  have hw : ((w⁻¹ : W) : X) ∈ normalizer ((layerIn W : Subgroup X) : Set X) :=
    le_normalizer_layerIn_self W (w⁻¹).2
  have h1 := conj_mem_coreActionKernel hw (show (d : X) ∈ coreActionKernel (layerIn W) from hd)
  show ((w * d * w⁻¹ : W) : X) ∈ coreActionKernel (layerIn W)
  simpa using h1

theorem centralizer_layerImage_eq_bot (W : Subgroup X)
    (hperf : Group.IsPerfect (↥(layerIn W) ⧸ pPrimeCore 2 ↥(layerIn W))) :
    centralizer ((((layerIn W).subgroupOf W).map (QuotientGroup.mk' (layerActKer W)) :
      Subgroup (↥W ⧸ layerActKer W)) : Set (↥W ⧸ layerActKer W)) = ⊥ := by
  rw [eq_bot_iff]
  intro y hy
  obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective _ y
  rw [mem_bot, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  show (w : X) ∈ coreActionKernel (layerIn W)
  refine mem_coreActionKernel_of_commutator_mem (le_normalizer_layerIn_self W w.2) hperf
    fun v hv => ?_
  have hvW : v ∈ W := map_subtype_le _ hv
  have h1 := ((mem_centralizer_iff.mp hy) (QuotientGroup.mk' _ ⟨v, hvW⟩)
    (mem_map_of_mem _ (show (⟨v, hvW⟩ : W) ∈ (layerIn W).subgroupOf W from hv))).symm
  rw [← map_mul, ← map_mul, QuotientGroup.mk'_apply, QuotientGroup.mk'_apply,
    QuotientGroup.eq] at h1
  have h2 : (((w * ⟨v, hvW⟩)⁻¹ * (⟨v, hvW⟩ * w) : W) : X) = v⁻¹ * (w : X)⁻¹ * v * w := by
    simp [mul_assoc]
  rw [← h2]
  exact h1

theorem oddCoreIn_eq_inf_of_isPComponent {W V K : Subgroup X} (hKV : K ≤ V) (hVW : V ≤ W)
    (hK : IsPComponent 2 (K.subgroupOf W)) : oddCoreIn K = K ⊓ oddCoreIn V := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hKV' : IsPComponent 2 (K.subgroupOf V) :=
    UnbalancedCorr.isPComponent_subgroupOf_of_le hKV hVW hK
  have hsub : (K.subgroupOf V).IsSubnormal := by
    obtain ⟨-, -, hs, -, -⟩ := id hKV'
    exact hs
  have h1 := congrArg (Subgroup.map V.subtype)
    (UnbalancedCorr.map_pPrimeCore_eq_inf_of_isSubnormal hsub)
  rw [pPrimeCore_map_subgroupOf 2 K V hKV, map_inf_eq _ _ _ V.subtype_injective,
    subgroupOf_map_subtype, inf_eq_left.mpr hKV] at h1
  exact h1

omit [Finite X] in
theorem oddCoreIn_le_coreActionKernel (V : Subgroup X) : oddCoreIn V ≤ coreActionKernel V := by
  rintro _ ⟨o, ho, rfl⟩
  refine mem_coreActionKernel.mpr ⟨le_normalizer o.2, fun v hv => ?_⟩
  have h1 : (⟨v, hv⟩ : V)⁻¹ * o⁻¹ * ⟨v, hv⟩ * o ∈ pPrimeCore 2 ↥V :=
    mul_mem (by
      have := (pPrimeCore_normal (p := 2) (G := V)).conj_mem _ (inv_mem ho) (⟨v, hv⟩ : V)⁻¹
      simpa using this) ho
  exact ⟨_, h1, by simp⟩

theorem isComponent_map_layerActKer {W K : Subgroup X} (hKW : K ≤ W)
    (hKpc : IsPComponent 2 (K.subgroupOf W)) (hKV : K ≤ layerIn W) :
    IsComponent ((K.subgroupOf W).map (QuotientGroup.mk' (layerActKer W))) ∧
      ¬ (K.subgroupOf W).map (QuotientGroup.mk' (layerActKer W)) ≤
        pPrimeCore 2 (↥W ⧸ layerActKer W) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set π := QuotientGroup.mk' (layerActKer W) with hπ
  set K₀ := K.subgroupOf W with hK₀
  set V := layerIn W with hV
  have hVW : V ≤ W := map_subtype_le _
  have hOK := oddCoreIn_eq_inf_of_isPComponent hKV hVW hKpc
  have hker : ∀ k : K₀, π k = 1 ↔ ((k : W) : X) ∈ coreActionKernel V := fun k => by
    rw [hπ, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    rfl
  have hOker : pPrimeCore 2 ↥K₀ ≤ (π.subgroupMap K₀).ker := by
    intro o ho
    rw [MonoidHom.mem_ker]
    apply Subtype.ext
    show π o = 1
    rw [hker]
    have h1 : (((o : K₀) : W) : X) ∈ oddCoreIn K := by
      rw [oddCoreIn, ← pPrimeCore_map_subgroupOf 2 K W hKW]
      exact ⟨_, ⟨o, ho, rfl⟩, rfl⟩
    rw [hOK] at h1
    exact oddCoreIn_le_coreActionKernel V (mem_inf.mp h1).2
  set φ := QuotientGroup.lift (pPrimeCore 2 ↥K₀) (π.subgroupMap K₀) hOker with hφ
  have hφs : Function.Surjective φ := by
    intro y
    obtain ⟨k, rfl⟩ := π.subgroupMap_surjective K₀ y
    exact ⟨QuotientGroup.mk k, rfl⟩
  have hq := CatalogueBHeldSmallCore.pComponent_coreQuotient_quasisimple 2 _ hKpc
  have hnt : ∃ k, φ k ≠ 1 := by
    by_contra hall
    push Not at hall
    obtain ⟨a, b, hab⟩ := hq.2.2
    obtain ⟨⟨x, rfl⟩, ⟨y, rfl⟩⟩ := And.intro (QuotientGroup.mk_surjective a)
      (QuotientGroup.mk_surjective b)
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective x
    obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective y
    apply hab
    have hxK : ∀ k : K₀, ((k : W) : X) ∈ coreActionKernel V := fun k => by
      rw [← hker]
      exact congrArg Subtype.val (hall (QuotientGroup.mk k))
    have h1 : (((x⁻¹ * y⁻¹ * x * y : K₀) : W) : X) ∈ oddCoreIn K := by
      have h2 := (mem_coreActionKernel.mp (hxK y)).2 (((x : K₀) : W) : X)
        (hKV (show (((x : K₀) : W) : X) ∈ K from x.2))
      rw [hOK]
      refine mem_inf.mpr ⟨(x⁻¹ * y⁻¹ * x * y : K₀).2, ?_⟩
      have h5 : (((x⁻¹ * y⁻¹ * x * y : K₀) : W) : X) = (((x : K₀) : W) : X)⁻¹ *
          (((y : K₀) : W) : X)⁻¹ * (((x : K₀) : W) : X) * (((y : K₀) : W) : X) := by simp
      rw [h5]
      exact h2
    have h3 : x⁻¹ * y⁻¹ * x * y ∈ pPrimeCore 2 ↥K₀ := by
      rw [oddCoreIn, ← pPrimeCore_map_subgroupOf 2 K W hKW] at h1
      obtain ⟨_, ⟨o, ho, rfl⟩, hoe⟩ := h1
      have : o = x⁻¹ * y⁻¹ * x * y := Subtype.ext (Subtype.ext hoe)
      rw [← this]
      exact ho
    have h4 : (QuotientGroup.mk (y * x) : ↥K₀ ⧸ pPrimeCore 2 ↥K₀) = QuotientGroup.mk (x * y) := by
      rw [QuotientGroup.eq, show (y * x)⁻¹ * (x * y) = x⁻¹ * y⁻¹ * x * y by group]
      exact h3
    simp only [← QuotientGroup.mk_mul]
    rw [h4]
  have hqK : IsQuasisimple ↥(K₀.map π) :=
    LieType.CurtisTits.isQuasisimple_of_surjective hq hφs hnt
  refine ⟨⟨hqK, ?_⟩, fun hle => ?_⟩
  · obtain ⟨-, -, hs, -, -⟩ := hKpc
    exact hs.map (QuotientGroup.mk'_surjective _)
  ·
    have hres := CatalogueBPrimeJoin.primeResidual_eq_top_of_pComponent 2 _ hKpc
    let f : ↥K₀ →* ↥(pPrimeCore 2 (↥W ⧸ layerActKer W)) :=
      (π.comp K₀.subtype).codRestrict _ fun k => hle ⟨k, k.2, rfl⟩
    have hbot : CatalogueBPrimeJoin.primeResidual 2 ↥(pPrimeCore 2 (↥W ⧸ layerActKer W)) = ⊥ :=
      CatalogueBPrimeJoin.primeResidual_eq_bot_of_coprime_card 2 pPrimeCore_coprime_card
    have h1 := CatalogueBPrimeJoin.primeResidual_map_le 2 f
    rw [hres, hbot, le_bot_iff, ← MonoidHom.range_eq_map, MonoidHom.range_eq_bot_iff] at h1
    obtain ⟨a, b, hab⟩ := hqK.2.2
    apply hab
    have hK1 : ∀ k : ↥(K₀.map π), k = 1 := by
      rintro ⟨_, ⟨k, hk, rfl⟩⟩
      apply Subtype.ext
      have := congrArg Subtype.val (congrArg (fun φ : ↥K₀ →* _ => φ ⟨k, hk⟩) h1)
      exact this
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective a
    obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective b
    rw [hK1 x, hK1 y]

theorem gwIsComponentOf_top_of_isComponent {F : Type*} [Group F] {C : Subgroup F}
    (hC : IsComponent C) : GorensteinWalter.IsComponentOf C ⊤ := by
  obtain ⟨⟨hperf, hsimple, hnc⟩, hsub⟩ := hC
  refine ⟨le_top, hsub.subgroupOf, ?_, hperf.commutator_eq_top, hsimple⟩
  obtain ⟨a, b, hab⟩ := hnc
  obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective a
  obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective b
  refine ⟨⟨x * y, y * x, fun h => hab ?_⟩⟩
  rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, h]

theorem pPrimeCore_layerQuotient_eq_bot {W K : Subgroup X} {a : X} (haW : a ∈ W) (hKW : K ≤ W)
    (hKpc : IsPComponent 2 (K.subgroupOf W)) (hV : K ⊔ conjugate K a = layerIn W) :
    pPrimeCore 2 (↥W ⧸ layerActKer W) = ⊥ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hKaW : conjugate K a ≤ W := UnbalancedCorr.conjugate_le_of_mem hKW haW
  have hKapc : IsPComponent 2 ((conjugate K a).subgroupOf W) :=
    UnbalancedCorr.isPComponent_conjugate_subgroupOf haW hKpc
  have hVV : ⁅layerIn W, layerIn W⁆ = layerIn W := by
    rw [← hV]
    exact commutator_sup_eq_of_perfect (commutator_eq_self_of_isPComponent hKW hKpc)
      (commutator_eq_self_of_isPComponent hKaW hKapc)
  have hperf : Group.IsPerfect (↥(layerIn W) ⧸ pPrimeCore 2 ↥(layerIn W)) := by
    have := (Subgroup.isPerfect_iff (H := layerIn W)).mpr hVV
    exact isPerfect_oddBar this
  have hcen := centralizer_layerImage_eq_bot W hperf
  obtain ⟨hc1, hn1⟩ := isComponent_map_layerActKer hKW hKpc (hV ▸ le_sup_left)
  obtain ⟨hc2, hn2⟩ := isComponent_map_layerActKer hKaW hKapc (hV ▸ le_sup_right)
  have hcomm : ∀ {C : Subgroup (↥W ⧸ layerActKer W)}, IsComponent C →
      ¬ C ≤ pPrimeCore 2 (↥W ⧸ layerActKer W) →
      C ≤ centralizer (pPrimeCore 2 (↥W ⧸ layerActKer W) : Set (↥W ⧸ layerActKer W)) := by
    intro C hC hn
    rcases GorensteinWalter.component_le_or_commutator_eq_bot_of_normal
        (gwIsComponentOf_top_of_isComponent hC) (pPrimeCore_normal (p := 2)) with h | h
    · exact absurd h hn
    · exact (commutator_eq_bot_iff_le_centralizer).mp h
  have hle : ((layerIn W).subgroupOf W).map (QuotientGroup.mk' (layerActKer W)) ≤
      centralizer (pPrimeCore 2 (↥W ⧸ layerActKer W) : Set (↥W ⧸ layerActKer W)) := by
    rw [← hV, subgroupOf_sup hKW hKaW, Subgroup.map_sup]
    exact sup_le (hcomm hc1 hn1) (hcomm hc2 hn2)
  rw [← le_bot_iff, ← hcen]
  exact le_centralizer_iff.mp hle

omit [Finite X] in
theorem le_normalizer_oddCoreIn_self (W : Subgroup X) :
    W ≤ normalizer ((oddCoreIn W : Subgroup X) : Set X) := fun _ hw =>
  UnbalancedGS.normalizer_le_normalizer_map_of_characteristic W (pPrimeCore 2 ↥W) (le_normalizer hw)

theorem inf_oddCoreIn_le {V W : Subgroup X} (hVW : V ≤ W) :
    V ⊓ oddCoreIn W ≤ oddCoreIn V := by
  have hWO := le_normalizer_oddCoreIn_self W
  set U : Subgroup ↥V := (oddCoreIn W).subgroupOf V with hU
  have hn : U.Normal := by
    refine ⟨fun u hu v => ?_⟩
    show ((v * u * v⁻¹ : V) : X) ∈ oddCoreIn W
    have := (mem_normalizer_iff.mp (hWO (hVW v.2)) (u : X)).mp hu
    simpa using this
  have hcop : Nat.Coprime 2 (Nat.card U) := by
    have h1 : Nat.card U ∣ Nat.card (oddCoreIn W) := by
      have h3 : Nat.card U = Nat.card ↥(U.map V.subtype) :=
        (card_map_of_injective V.subtype_injective).symm
      rw [h3, hU, subgroupOf_map_subtype]
      exact Subgroup.card_dvd_of_le inf_le_left
    have h2 : Nat.Coprime 2 (Nat.card (oddCoreIn W)) := by
      rw [oddCoreIn, card_map_of_injective W.subtype_injective]
      exact pPrimeCore_coprime_card (p := 2) (G := W)
    exact Nat.Coprime.coprime_dvd_right h1 h2
  have hle : U ≤ pPrimeCore 2 ↥V := le_sSup ⟨hn, hcop⟩
  intro y hy
  obtain ⟨hyV, hyO⟩ := mem_inf.mp hy
  exact ⟨⟨y, hyV⟩, hle hyO, rfl⟩

theorem oddCoreIn_le_coreActionKernel_layerIn (W : Subgroup X) :
    oddCoreIn W ≤ coreActionKernel (layerIn W) := by
  have hWV := le_normalizer_layerIn_self W
  have hWO := le_normalizer_oddCoreIn_self W
  intro r hr
  have hrW : r ∈ W := map_subtype_le _ hr
  refine mem_coreActionKernel.mpr ⟨hWV hrW, fun v hv => ?_⟩
  apply inf_oddCoreIn_le (map_subtype_le _)
  refine mem_inf.mpr ⟨?_, ?_⟩
  · have h1 : r⁻¹ * v * r ∈ layerIn W := by
      have := (mem_normalizer_iff.mp (hWV (inv_mem hrW)) v).mp hv
      rwa [inv_inv] at this
    have := mul_mem (inv_mem hv) h1
    rwa [show v⁻¹ * (r⁻¹ * v * r) = v⁻¹ * r⁻¹ * v * r by group] at this
  · have h1 : v⁻¹ * r⁻¹ * v ∈ oddCoreIn W := by
      have := (mem_normalizer_iff.mp (hWO (inv_mem (map_subtype_le _ hv))) r⁻¹).mp (inv_mem hr)
      rwa [inv_inv] at this
    exact mul_mem h1 hr

theorem oddCoreIn_le_of_le_normalizer {V W : Subgroup X} (hVW : V ≤ W)
    (hWV : W ≤ normalizer (V : Set X)) : oddCoreIn V ≤ oddCoreIn W := by
  have hn : ((oddCoreIn V).subgroupOf W).Normal := by
    refine (normal_subgroupOf_iff (map_subtype_le _ |>.trans hVW)).mpr fun o g ho hg => ?_
    exact (mem_normalizer_iff.mp
      (UnbalancedGS.normalizer_le_normalizer_map_of_characteristic V (pPrimeCore 2 V)
        (hWV hg)) o).mp ho
  have hcop : Nat.Coprime 2 (Nat.card ((oddCoreIn V).subgroupOf W)) := by
    have hOV : oddCoreIn V ≤ W := map_subtype_le _ |>.trans hVW
    rw [Nat.card_congr (subgroupOfEquivOfLe hOV).toEquiv, oddCoreIn,
      card_map_of_injective V.subtype_injective]
    exact pPrimeCore_coprime_card (p := 2) (G := V)
  have h1 : (oddCoreIn V).subgroupOf W ≤ pPrimeCore 2 W := le_sSup ⟨hn, hcop⟩
  intro o ho
  exact ⟨⟨o, (map_subtype_le _ |>.trans hVW) ho⟩, h1 ho, rfl⟩

theorem oddTwoCore_le_layerActKer {W B : Subgroup X}
    (hN : (oddTwoCore ↥W).map W.subtype = oddCoreIn W ⊔ B)
    (hB : B ≤ coreActionKernel (layerIn W)) : oddTwoCore ↥W ≤ layerActKer W := by
  intro n hn
  have h1 : (n : X) ∈ (oddTwoCore ↥W).map W.subtype := ⟨n, hn, rfl⟩
  rw [hN] at h1
  exact (sup_le (oddCoreIn_le_coreActionKernel_layerIn W) hB) h1

@[expose] noncomputable def coreFreeMap {W B : Subgroup X}
    (hN : (oddTwoCore ↥W).map W.subtype = oddCoreIn W ⊔ B)
    (hB : B ≤ coreActionKernel (layerIn W)) : ↥W ⧸ oddTwoCore ↥W →* ↥W ⧸ layerActKer W :=
  QuotientGroup.map _ _ (MonoidHom.id _) (oddTwoCore_le_layerActKer hN hB)

section CoreFreeMap

variable {W B : Subgroup X} (hN : (oddTwoCore ↥W).map W.subtype = oddCoreIn W ⊔ B)
  (hB : B ≤ coreActionKernel (layerIn W))

theorem coreFreeMap_mk (w : W) :
    coreFreeMap hN hB (QuotientGroup.mk w) = QuotientGroup.mk w := rfl

theorem coreFreeMap_comp_mk' :
    (coreFreeMap hN hB).comp (QuotientGroup.mk' (oddTwoCore ↥W)) =
      QuotientGroup.mk' (layerActKer W) := by
  ext w
  rfl

theorem coreFreeMap_surjective : Function.Surjective (coreFreeMap hN hB) := by
  intro y
  obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective _ y
  exact ⟨QuotientGroup.mk w, rfl⟩

theorem ker_coreFreeMap :
    (coreFreeMap hN hB).ker = (layerActKer W).map (QuotientGroup.mk' (oddTwoCore ↥W)) := by
  ext y
  obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective _ y
  rw [MonoidHom.mem_ker]
  constructor
  · intro h
    have h' : (QuotientGroup.mk w : ↥W ⧸ layerActKer W) = 1 := h
    exact ⟨w, (QuotientGroup.eq_one_iff w).mp h', rfl⟩
  · rintro ⟨w', hw', hww'⟩
    rw [← hww']
    show (QuotientGroup.mk w' : ↥W ⧸ layerActKer W) = 1
    exact (QuotientGroup.eq_one_iff w').mpr hw'

theorem odd_card_ker_coreFreeMap
    (hBsyl : ∃ P : Sylow 2 ↥(W ⊓ coreActionKernel (layerIn W)),
      (P : Subgroup _) = B.subgroupOf (W ⊓ coreActionKernel (layerIn W))) :
    Odd (Nat.card (coreFreeMap hN hB).ker) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rw [ker_coreFreeMap, ← relIndex_ker, QuotientGroup.ker_mk']
  have hBN : B.subgroupOf W ≤ oddTwoCore ↥W := by
    intro b hb
    have h1 : (b : X) ∈ (oddTwoCore ↥W).map W.subtype := by
      rw [hN]
      exact mem_sup_right hb
    obtain ⟨n, hn, hnb⟩ := h1
    have : n = b := Subtype.ext hnb
    rw [← this]
    exact hn
  have h1 := relIndex_mul_relIndex (B.subgroupOf W) (oddTwoCore ↥W) (layerActKer W) hBN
    (oddTwoCore_le_layerActKer hN hB)
  have hCD : layerActKer W = (W ⊓ coreActionKernel (layerIn W)).subgroupOf W := by
    rw [layerActKer, inf_subgroupOf_left]
  have h2 : (B.subgroupOf W).relIndex (layerActKer W) =
      B.relIndex (W ⊓ coreActionKernel (layerIn W)) := by
    rw [hCD, relIndex_subgroupOf inf_le_left]
  obtain ⟨P, hP⟩ := hBsyl
  have h3 : ¬ 2 ∣ B.relIndex (W ⊓ coreActionKernel (layerIn W)) := by
    have := P.not_dvd_index
    rwa [hP] at this
  rw [h2] at h1
  rw [Nat.odd_iff, ← Nat.two_dvd_ne_zero]
  exact fun hd => h3 (h1 ▸ Dvd.dvd.mul_left hd _)

theorem ker_coreFreeMap_le_centralizer {T : Subgroup X} (hTV : T ≤ layerIn W) :
    (coreFreeMap hN hB).ker ≤ centralizer
      (((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W)) : Subgroup (↥W ⧸ oddTwoCore ↥W)) :
        Set (↥W ⧸ oddTwoCore ↥W)) := by
  rw [ker_coreFreeMap]
  rintro _ ⟨d, hd, rfl⟩
  rw [mem_centralizer_iff]
  rintro _ ⟨t, ht, rfl⟩
  refine (?_ : (QuotientGroup.mk' (oddTwoCore ↥W) d) * (QuotientGroup.mk' (oddTwoCore ↥W) t) =
    (QuotientGroup.mk' (oddTwoCore ↥W) t) * (QuotientGroup.mk' (oddTwoCore ↥W) d)).symm
  rw [← map_mul, ← map_mul, QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq]
  have h1 : (t : X)⁻¹ * (d : X)⁻¹ * t * d ∈ oddCoreIn (layerIn W) :=
    (mem_coreActionKernel.mp hd).2 t (hTV ht)
  have h2 : (t : X)⁻¹ * (d : X)⁻¹ * t * d ∈ (oddTwoCore ↥W).map W.subtype := by
    rw [hN]
    exact mem_sup_left (oddCoreIn_le_of_le_normalizer (map_subtype_le _)
      (le_normalizer_layerIn_self W) h1)
  obtain ⟨n, hn, hne⟩ := h2
  have : (d * t)⁻¹ * (t * d) = n := by
    apply Subtype.ext
    simp only [subtype_apply] at hne
    rw [hne]
    simp [mul_assoc]
  rw [this]
  exact hn

end CoreFreeMap

theorem isStandardSubgroup_layerQuotient {W B T : Subgroup X}
    (hN : (oddTwoCore ↥W).map W.subtype = oddCoreIn W ⊔ B)
    (hBD : B ≤ W ⊓ coreActionKernel (layerIn W))
    (hBsyl : ∃ P : Sylow 2 ↥(W ⊓ coreActionKernel (layerIn W)),
      (P : Subgroup _) = B.subgroupOf (W ⊓ coreActionKernel (layerIn W)))
    (hTV : T ≤ layerIn W)
    (hstd : IsStandardSubgroup ((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W)))) :
    IsStandardSubgroup ((T.subgroupOf W).map (QuotientGroup.mk' (layerActKer W))) := by
  have hB := hBD.trans inf_le_right
  have h := isStandardSubgroup_map_of_surjective (coreFreeMap hN hB) (coreFreeMap_surjective hN hB)
    hstd (odd_card_ker_coreFreeMap hN hB hBsyl) (ker_coreFreeMap_le_centralizer hN hB hTV)
  rwa [Subgroup.map_map, coreFreeMap_comp_mk'] at h

omit [Finite X] in
theorem mem_of_mem_conjugate_of_normal {F : Type*} [Group F] {H : Subgroup F} [hH : H.Normal]
    {g y : F} (hy : y ∈ conjugate H g) : y ∈ H := by
  obtain ⟨h, hh, rfl⟩ := hy
  have := hH.conj_mem h hh g⁻¹
  simpa [MulAut.conj_apply] using this

theorem not_normal_layerQuotient {W B T : Subgroup X}
    (hN : (oddTwoCore ↥W).map W.subtype = oddCoreIn W ⊔ B)
    (hBD : B ≤ W ⊓ coreActionKernel (layerIn W))
    (hBsyl : ∃ P : Sylow 2 ↥(W ⊓ coreActionKernel (layerIn W)),
      (P : Subgroup _) = B.subgroupOf (W ⊓ coreActionKernel (layerIn W)))
    {a : X} (haW : a ∈ W)
    (hLa : (T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W)) ≤
      centralizer ({QuotientGroup.mk' (oddTwoCore ↥W) ⟨a, haW⟩} : Set (↥W ⧸ oddTwoCore ↥W)))
    (hrank : 2 ≤ pRank 2 ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))))
    (hcl : (⨆ e ∈ layer (↥W ⧸ oddTwoCore ↥W),
        conjugate ((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))) e) =
      ((layerIn W).subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W)))
    (hcomm : ⁅((layerIn W).subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W)),
        zpowers (QuotientGroup.mk' (oddTwoCore ↥W) ⟨a, haW⟩)⁆ =
      ((layerIn W).subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))) :
    ¬ ((T.subgroupOf W).map (QuotientGroup.mk' (layerActKer W))).Normal := by
  intro hn
  have hB := hBD.trans inf_le_right
  set ψ := coreFreeMap hN hB with hψ
  set θ := QuotientGroup.mk' (oddTwoCore ↥W) with hθ
  set L := (T.subgroupOf W).map θ with hLdef
  set Vθ := ((layerIn W).subgroupOf W).map θ with hVdef
  set ā := θ ⟨a, haW⟩ with hādef
  have hL' : L.map ψ = (T.subgroupOf W).map (QuotientGroup.mk' (layerActKer W)) := by
    rw [hLdef, Subgroup.map_map, hθ, coreFreeMap_comp_mk']
  rw [← hL'] at hn
  have h1 : Vθ ≤ (L.map ψ).comap ψ := by
    rw [← hcl]
    refine iSup₂_le fun e _ => ?_
    intro y hy
    have : ψ y ∈ conjugate (L.map ψ) (ψ e) := by
      rw [← map_conjugate]
      exact mem_map_of_mem ψ hy
    exact mem_comap.mpr (mem_of_mem_conjugate_of_normal this)
  have h2 : Vθ.map ψ ≤ L.map ψ := map_le_iff_le_comap.mpr h1
  have hLa' : ⁅L, zpowers ā⁆ = ⊥ := by
    rw [commutator_eq_bot_iff_le_centralizer]
    intro l hl
    rw [mem_centralizer_iff]
    intro z hz
    obtain ⟨k, rfl⟩ := mem_zpowers_iff.mp hz
    have hc : Commute ā l := (mem_centralizer_singleton_iff.mp (hLa hl)).symm
    exact (hc.zpow_left k).eq
  have h4 : Vθ.map ψ = ⊥ := by
    have h5 := congrArg (Subgroup.map ψ) hcomm
    rw [map_commutator, MonoidHom.map_zpowers] at h5
    rw [← h5, eq_bot_iff]
    calc ⁅Vθ.map ψ, zpowers (ψ ā)⁆ ≤ ⁅L.map ψ, zpowers (ψ ā)⁆ := commutator_mono h2 le_rfl
      _ = (⁅L, zpowers ā⁆).map ψ := by rw [map_commutator, MonoidHom.map_zpowers]
      _ = ⊥ := by rw [hLa', Subgroup.map_bot]
  have hLV : L ≤ Vθ := by
    rw [← hcl]
    refine le_iSup₂_of_le 1 (one_mem _) fun l hl => ⟨l, hl, by simp⟩
  have h5 : L ≤ ψ.ker := by
    intro l hl
    have := mem_map_of_mem ψ (hLV hl)
    rw [h4, mem_bot] at this
    exact this
  have hodd := odd_card_ker_coreFreeMap hN hB hBsyl
  have h6 := RankThreeEvenClassification.Helpers.prime_power_pRank_dvd_card 2 Nat.prime_two L
  rw [SectionRank.pRank_eq_open_pRank_top,
    ← RankThreeCoreUniqueness.Helpers.pRank_subgroup_eq_internal_top 2 one_lt_two] at hrank
  have h7 : 2 ∣ 2 ^ Open.pRank 2 L := dvd_pow_self 2 (by omega)
  have h8 : Nat.card L ∣ Nat.card ψ.ker := Subgroup.card_dvd_of_le h5
  exact (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr (h7.trans (h6.trans h8)))

end CoreFree

section TypeK

variable {X : Type} [Group X] [Finite X]

omit [Finite X] in
theorem center_eq_bot_of_isSimpleGroup {Y : Type*} [Group Y] [IsSimpleGroup Y]
    (hnc : ∃ a b : Y, a * b ≠ b * a) : center Y = ⊥ := by
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (center Y) with h | h
  · exact h
  · obtain ⟨a, b, hab⟩ := hnc
    exact absurd ((Subgroup.mem_center_iff.mp (h ▸ mem_top b) a)) hab

omit [Finite X] in
theorem mem_pPrimeCore_of_mem_fusionZStar {Y : Type*} [Group Y]
    (h : center (Y ⧸ pPrimeCore 2 Y) = ⊥) {y : Y} (hy : y ∈ Open.fusionZStar Y) :
    y ∈ pPrimeCore 2 Y := by
  have hO : Open.fusionOddCore Y = pPrimeCore 2 Y := GSLit.oddCore_eq_pPrimeCore_two Y
  have hy' : (QuotientGroup.mk y : Y ⧸ Open.fusionOddCore Y) ∈ center _ := hy
  have hc : (QuotientGroup.mk y : Y ⧸ pPrimeCore 2 Y) ∈ center _ := by
    rw [Subgroup.mem_center_iff]
    intro q
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
    have h1 := Subgroup.mem_center_iff.mp hy' (QuotientGroup.mk g)
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq, hO] at h1
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
    exact h1
  rw [h, mem_bot, QuotientGroup.eq_one_iff] at hc
  exact hc

omit [Finite X] in
noncomputable def oddBarEquivZStar (Y : Type*) [Group Y] (h : center (Y ⧸ pPrimeCore 2 Y) = ⊥) :
    Y ⧸ pPrimeCore 2 Y ≃* Y ⧸ Open.fusionZStar Y :=
  (QuotientGroup.quotientBot.symm.trans (QuotientGroup.quotientMulEquivOfEq h.symm)).trans
    (oddBarCenterEquiv Y)

theorem smallType_of_centralQuotient {F : Type} [Group F] [Finite F] {L : Subgroup F}
    (hq : IsQuasisimple L) (heven : Even (Nat.card L)) {Y : Type} [Group Y]
    (eY : ↥L ⧸ center ↥L ≃* Y)
    (hY : (Nonempty (Y ≃* alternatingGroup (Fin 7)) ∧ Odd (Nat.card (center ↥L))) ∨
      (∃ p f : ℕ, p.Prime ∧ p ≠ 2 ∧ 1 ≤ f ∧ 5 ≤ p ^ f ∧ Blueprint.LieModel Y .PSL 2 p f ∧
        Odd (Nat.card (center ↥L))) ∨
      Blueprint.LieModel Y .PSL 3 2 2) :
    (∃ p f : ℕ, p.Prime ∧ p ≠ 2 ∧ 1 ≤ f ∧ 5 ≤ p ^ f ∧
        Blueprint.LieModel (↥L ⧸ pPrimeCore 2 ↥L) .PSL 2 p f) ∨
      Nonempty (↥L ⧸ pPrimeCore 2 ↥L ≃* alternatingGroup (Fin 7)) ∨
      Blueprint.LieModel (↥L ⧸ center ↥L) .PSL 3 2 2 := by
  have hOZ : Odd (Nat.card (center ↥L)) → pPrimeCore 2 ↥L = center ↥L := by
    intro hodd
    apply le_antisymm
    · rcases ComponentClassification.Quasisimple.normal_le_center_or_eq_top
        ((UnbalancingLocal.isQuasisimple_open_iff _).mpr hq) (pPrimeCore 2 ↥L) with h | h
      · exact h
      · exfalso
        have h1 : Nat.Coprime 2 (Nat.card (pPrimeCore 2 ↥L)) := pPrimeCore_coprime_card
        rw [h, Subgroup.card_top] at h1
        exact (Nat.not_even_iff_odd.mpr (Nat.coprime_two_left.mp h1)) heven
    · exact le_sSup ⟨inferInstance, Nat.coprime_two_left.mpr hodd⟩
  rcases hY with ⟨h7, hodd⟩ | ⟨p, f, hp, hp2, hf, h5, hm, hodd⟩ | h34
  · obtain ⟨e7⟩ := h7
    exact Or.inr (Or.inl ⟨((QuotientGroup.quotientMulEquivOfEq (hOZ hodd)).trans eY).trans e7⟩)
  · exact Or.inl ⟨p, f, hp, hp2, hf, h5, LieType.CurtisTits.lieModel_of_mulEquiv
      ((QuotientGroup.quotientMulEquivOfEq (hOZ hodd)).trans eY).symm hm⟩
  · exact Or.inr (Or.inr (LieType.CurtisTits.lieModel_of_mulEquiv eY.symm h34))

theorem nonempty_zstar_equiv_layerImage {W K : Subgroup X} (hKW : K ≤ W)
    (hKpc : IsPComponent 2 (K.subgroupOf W)) (hKV : K ≤ layerIn W) :
    Nonempty (↥K ⧸ Open.fusionZStar ↥K ≃*
      ↥((K.subgroupOf W).map (QuotientGroup.mk' (layerActKer W))) ⧸
        center ↥((K.subgroupOf W).map (QuotientGroup.mk' (layerActKer W)))) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set π := QuotientGroup.mk' (layerActKer W) with hπ
  set K₀ := K.subgroupOf W with hK₀
  set V := layerIn W with hV
  have hVW : V ≤ W := map_subtype_le _
  have hOK := oddCoreIn_eq_inf_of_isPComponent hKV hVW hKpc
  have hker : ∀ k : K₀, π k = 1 ↔ ((k : W) : X) ∈ coreActionKernel V := fun k => by
    rw [hπ, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    rfl
  have hOker : pPrimeCore 2 ↥K₀ ≤ (π.subgroupMap K₀).ker := by
    intro o ho
    rw [MonoidHom.mem_ker]
    apply Subtype.ext
    show π o = 1
    rw [hker]
    have h1 : (((o : K₀) : W) : X) ∈ oddCoreIn K := by
      rw [oddCoreIn, ← pPrimeCore_map_subgroupOf 2 K W hKW]
      exact ⟨_, ⟨o, ho, rfl⟩, rfl⟩
    rw [hOK] at h1
    exact oddCoreIn_le_coreActionKernel V (mem_inf.mp h1).2
  set φ := QuotientGroup.lift (pPrimeCore 2 ↥K₀) (π.subgroupMap K₀) hOker with hφ
  have hφs : Function.Surjective φ := by
    intro y
    obtain ⟨k, rfl⟩ := π.subgroupMap_surjective K₀ y
    exact ⟨QuotientGroup.mk k, rfl⟩
  have hq := CatalogueBHeldSmallCore.pComponent_coreQuotient_quasisimple 2 _ hKpc
  have hφker : φ.ker ≤ center (↥K₀ ⧸ pPrimeCore 2 ↥K₀) := by
    intro q hq'
    obtain ⟨k, rfl⟩ := QuotientGroup.mk_surjective q
    have hk : ((k : W) : X) ∈ coreActionKernel V := by
      rw [← hker]
      exact congrArg Subtype.val hq'
    rw [Subgroup.mem_center_iff]
    intro q'
    obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective q'
    have h2 := (mem_coreActionKernel.mp hk).2 (((y : K₀) : W) : X)
      (hKV (show (((y : K₀) : W) : X) ∈ K from y.2))
    have h1 : (((y⁻¹ * k⁻¹ * y * k : K₀) : W) : X) ∈ oddCoreIn K := by
      rw [hOK]
      refine mem_inf.mpr ⟨(y⁻¹ * k⁻¹ * y * k : K₀).2, ?_⟩
      have h5 : (((y⁻¹ * k⁻¹ * y * k : K₀) : W) : X) = (((y : K₀) : W) : X)⁻¹ *
          (((k : K₀) : W) : X)⁻¹ * (((y : K₀) : W) : X) * (((k : K₀) : W) : X) := by simp
      rw [h5]
      exact h2
    have h3 : y⁻¹ * k⁻¹ * y * k ∈ pPrimeCore 2 ↥K₀ := by
      rw [oddCoreIn, ← pPrimeCore_map_subgroupOf 2 K W hKW] at h1
      obtain ⟨_, ⟨o, ho, rfl⟩, hoe⟩ := h1
      have : o = y⁻¹ * k⁻¹ * y * k := Subtype.ext (Subtype.ext hoe)
      rw [← this]
      exact ho
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq,
      show (y * k)⁻¹ * (k * y) = (y⁻¹ * k⁻¹ * y * k)⁻¹ by group]
    exact inv_mem h3
  have e1 := LieType.CurtisTits.centralQuotientEquivOfIsQuasisimple hq hφs hφker
  obtain ⟨e2⟩ := OddQuot.nonempty_fusionZStar_equiv_of_surjective
    (subgroupOfEquivOfLe hKW).toMonoidHom (subgroupOfEquivOfLe hKW).surjective (by
      rw [(MonoidHom.ker_eq_bot_iff _).mpr (subgroupOfEquivOfLe hKW).injective, Subgroup.card_bot]
      norm_num)
  exact ⟨e2.symm.trans ((oddBarCenterEquiv ↥K₀).symm.trans e1)⟩

theorem odd_card_center_of_compat {W T J : Subgroup X} (hTJ : T ≤ J)
    (hJc : center (↥J ⧸ pPrimeCore 2 ↥J) = ⊥)
    (e : ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))) ⧸
      center ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))) ≃*
        ↥J ⧸ Open.fusionZStar ↥J)
    (he : ∀ (x : ↥(T.subgroupOf W)) (hx : ((x : ↥W) : X) ∈ J),
      e (((QuotientGroup.mk' (oddTwoCore ↥W)).subgroupMap (T.subgroupOf W) x :
          ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W)))) :
          ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))) ⧸
            center ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W)))) =
        ((⟨_, hx⟩ : J) : J ⧸ Open.fusionZStar ↥J)) :
    Odd (Nat.card (center ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))))) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set θ := QuotientGroup.mk' (oddTwoCore ↥W) with hθ
  set L := (T.subgroupOf W).map θ with hL
  by_contra hodd
  rw [Nat.not_odd_iff_even] at hodd
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' (G := center ↥L) 2 (even_iff_two_dvd.mp hodd)
  obtain ⟨x, hx⟩ := θ.subgroupMap_surjective (T.subgroupOf W) (z : ↥L)
  have hxJ : ((x : ↥W) : X) ∈ J := hTJ x.2
  have h1 := he x hxJ
  rw [hx, (QuotientGroup.eq_one_iff _).mpr z.2, map_one, eq_comm, QuotientGroup.eq_one_iff] at h1
  have h2 := mem_pPrimeCore_of_mem_fusionZStar hJc h1
  have h3 : orderOf (⟨_, h2⟩ : pPrimeCore 2 ↥J) ∣ Nat.card (pPrimeCore 2 ↥J) :=
    orderOf_dvd_natCard _
  have h4 : Odd (orderOf x) := by
    have h5 : orderOf (⟨_, h2⟩ : pPrimeCore 2 ↥J) = orderOf x := by
      rw [Subgroup.orderOf_mk, Subgroup.orderOf_mk, ← Subgroup.orderOf_coe x,
        ← Subgroup.orderOf_coe (x : ↥W)]
    rw [← h5]
    exact Odd.of_dvd_nat (Nat.coprime_two_left.mp pPrimeCore_coprime_card) h3
  have h6 : orderOf (θ.subgroupMap (T.subgroupOf W) x) ∣ orderOf x := orderOf_map_dvd _ _
  rw [hx, Subgroup.orderOf_coe, hz] at h6
  exact (Nat.not_even_iff_odd.mpr h4) (even_iff_two_dvd.mpr h6)

omit [Finite X] in
theorem exists_noncomm_of_isQuasisimple {Y : Type*} [Group Y] (hY : IsQuasisimple Y) :
    ∃ a b : Y, a * b ≠ b * a := by
  obtain ⟨a, b, hab⟩ := hY.2.2
  obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective a
  obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective b
  refine ⟨x, y, fun h => hab ?_⟩
  rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, h]

theorem gsRestricted_of_criticalLayer (hRS : RestrictedStandardInput)
    {W B T J K : Subgroup X} {a : X} (haW : a ∈ W) (hWK : SectionRank.IsKGroupCat ↥W)
    (hKW : K ≤ W) (hKpc : IsPComponent 2 (K.subgroupOf W)) (hV : K ⊔ conjugate K a = layerIn W)
    (hN : (oddTwoCore ↥W).map W.subtype = oddCoreIn W ⊔ B)
    (hBD : B ≤ W ⊓ coreActionKernel (layerIn W))
    (hBsyl : ∃ P : Sylow 2 ↥(W ⊓ coreActionKernel (layerIn W)),
      (P : Subgroup _) = B.subgroupOf (W ⊓ coreActionKernel (layerIn W)))
    (hTV : T ≤ layerIn W) (hTJ : T ≤ J) (hJq : IsQuasisimple (↥J ⧸ pPrimeCore 2 ↥J))
    (hJ : SmallType J)
    (hLa : (T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W)) ≤
      centralizer ({QuotientGroup.mk' (oddTwoCore ↥W) ⟨a, haW⟩} : Set (↥W ⧸ oddTwoCore ↥W)))
    (hrank : 2 ≤ pRank 2 ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))))
    (hstd : IsStandardSubgroup ((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))))
    (e : ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))) ⧸
      center ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))) ≃*
        ↥J ⧸ Open.fusionZStar ↥J)
    (he : ∀ (x : ↥(T.subgroupOf W)) (hx : ((x : ↥W) : X) ∈ J),
      e (((QuotientGroup.mk' (oddTwoCore ↥W)).subgroupMap (T.subgroupOf W) x :
          ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W)))) :
          ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))) ⧸
            center ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W)))) =
        ((⟨_, hx⟩ : J) : J ⧸ Open.fusionZStar ↥J))
    (hcl : (⨆ e ∈ layer (↥W ⧸ oddTwoCore ↥W),
        conjugate ((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))) e) =
      ((layerIn W).subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W)))
    (hcomm : ⁅((layerIn W).subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W)),
        zpowers (QuotientGroup.mk' (oddTwoCore ↥W) ⟨a, haW⟩)⁆ =
      ((layerIn W).subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))) :
    GSRestricted (↥K ⧸ Open.fusionZStar ↥K) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hZL : center (↥J ⧸ pPrimeCore 2 ↥J) = ⊥ →
      Odd (Nat.card (center ↥((T.subgroupOf W).map (QuotientGroup.mk' (oddTwoCore ↥W))))) :=
    fun hc => odd_card_center_of_compat hTJ hc e he
  have hB := hBD.trans inf_le_right
  set θ := QuotientGroup.mk' (oddTwoCore ↥W) with hθ
  set L := (T.subgroupOf W).map θ with hL
  set ψ := coreFreeMap hN hB with hψ
  set L' := (T.subgroupOf W).map (QuotientGroup.mk' (layerActKer W)) with hL'
  have hLL' : L.map ψ = L' := by rw [hL, Subgroup.map_map, hθ, hψ, coreFreeMap_comp_mk']
  have hKG : SectionRank.IsKGroupCat (↥W ⧸ layerActKer W) := hWK.quotient _
  have hO := pPrimeCore_layerQuotient_eq_bot haW hKW hKpc hV
  have hstd' := isStandardSubgroup_layerQuotient hN hBD hBsyl hTV hstd
  have hnn := not_normal_layerQuotient hN hBD hBsyl haW hLa hrank hcl hcomm
  set ρ : ↥L →* ↥L' := (MulEquiv.subgroupCongr hLL').toMonoidHom.comp (ψ.subgroupMap L) with hρ
  have hρs : Function.Surjective ρ :=
    (MulEquiv.subgroupCongr hLL').surjective.comp (ψ.subgroupMap_surjective L)
  have hρker : ρ.ker ≤ center ↥L := by
    intro l hl
    have h1 : ψ l ∈ (⊥ : Subgroup (↥W ⧸ layerActKer W)) := by
      have := congrArg Subtype.val hl
      simpa [hρ] using this
    have h2 : (l : ↥W ⧸ oddTwoCore ↥W) ∈ ψ.ker := mem_bot.mp h1
    rw [Subgroup.mem_center_iff]
    intro l'
    exact Subtype.ext ((mem_centralizer_iff.mp
      (ker_coreFreeMap_le_centralizer hN hB hTV h2)) l' l'.2)
  have hq := hstd.1
  have eLL := LieType.CurtisTits.centralQuotientEquivOfIsQuasisimple hq hρs hρker
  have heven : Even (Nat.card L') := by
    have h1 := relIndex_mul_card (H := ψ.ker) (K := L)
    rw [relIndex_ker, hLL'] at h1
    have h2 := RankThreeEvenClassification.Helpers.prime_power_pRank_dvd_card 2 Nat.prime_two L
    rw [SectionRank.pRank_eq_open_pRank_top,
      ← RankThreeCoreUniqueness.Helpers.pRank_subgroup_eq_internal_top 2 one_lt_two] at hrank
    have h3 : 2 ∣ Nat.card L := (dvd_pow_self 2 (by omega)).trans h2
    have h4 : Odd (Nat.card ↥(ψ.ker ⊓ L)) :=
      Odd.of_dvd_nat (odd_card_ker_coreFreeMap hN hB hBsyl) (Subgroup.card_dvd_of_le inf_le_left)
    rw [← h1] at h3
    rcases Nat.even_or_odd (Nat.card L') with h5 | h5
    · exact h5
    · exact absurd (even_iff_two_dvd.mpr h3) (Nat.not_even_iff_odd.mpr (h5.mul h4))
  have hZ' : Odd (Nat.card (center ↥L)) → Odd (Nat.card (center ↥L')) := by
    intro h
    rw [LieType.CurtisTits.center_eq_map_center_of_isQuasisimple hq hρs hρker]
    exact Odd.of_dvd_nat h (Subgroup.card_map_dvd _ _)
  have hJnc := exists_noncomm_of_isQuasisimple hJq
  have htype : (∃ p f : ℕ, p.Prime ∧ p ≠ 2 ∧ 1 ≤ f ∧ 5 ≤ p ^ f ∧
        Blueprint.LieModel (↥L' ⧸ pPrimeCore 2 ↥L') .PSL 2 p f) ∨
      Nonempty (↥L' ⧸ pPrimeCore 2 ↥L' ≃* alternatingGroup (Fin 7)) ∨
      Blueprint.LieModel (↥L' ⧸ center ↥L') .PSL 3 2 2 := by
    have eY := eLL.symm.trans e
    rcases hJ with h7 | ⟨p, f, hp, hp2, hf, h5, hm⟩ | h34
    · obtain ⟨e7⟩ := h7
      have : IsSimpleGroup (alternatingGroup (Fin 7)) :=
        alternatingGroup.isSimpleGroup (by norm_num)
      have : IsSimpleGroup (↥J ⧸ pPrimeCore 2 ↥J) := e7.isSimpleGroup
      have hc := center_eq_bot_of_isSimpleGroup hJnc
      exact smallType_of_centralQuotient hstd'.1 heven eY
        (Or.inl ⟨⟨(oddBarEquivZStar _ hc).symm.trans e7⟩, hZ' (hZL hc)⟩)
    · have : IsSimpleGroup (↥J ⧸ pPrimeCore 2 ↥J) := isSimpleGroup_of_lieModel_psl_two hm
      have hc := center_eq_bot_of_isSimpleGroup hJnc
      exact smallType_of_centralQuotient hstd'.1 heven eY
        (Or.inr (Or.inl ⟨p, f, hp, hp2, hf, h5,
          LieType.CurtisTits.lieModel_of_mulEquiv (oddBarEquivZStar _ hc) hm, hZ' (hZL hc)⟩))
    · exact smallType_of_centralQuotient hstd'.1 heven eY (Or.inr (Or.inr h34))
  have hKV : K ≤ layerIn W := hV ▸ le_sup_left
  obtain ⟨hKc, -⟩ := isComponent_map_layerActKer hKW hKpc hKV
  have hres := hRS _ hKG hO L' hstd' hnn htype _ hKc
  obtain ⟨eK⟩ := nonempty_zstar_equiv_layerImage hKW hKpc hKV
  exact OddQuot.gsRestricted_of_mulEquiv eK.symm hres

