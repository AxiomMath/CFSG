variable {X : Type*} [Group X]

theorem mem_coreActionKernel_of_commutator_mem {V : Subgroup X} {g : X}
    (hgV : g ∈ normalizer (V : Set X)) (hperf : Group.IsPerfect (↥V ⧸ pPrimeCore 2 ↥V))
    (hc : ∀ v ∈ V, v⁻¹ * g⁻¹ * v * g ∈ coreActionKernel V) : g ∈ coreActionKernel V := by
  have hVg : ∀ v ∈ V, g⁻¹ * v * g ∈ V := fun v hv => by
    have := (mem_normalizer_iff.mp (inv_mem hgV) v).mp hv
    rwa [inv_inv] at this
  have hgv : ∀ v ∈ V, g * v * g⁻¹ ∈ V := fun v hv => (mem_normalizer_iff.mp hgV v).mp hv
  let φ : ↥V ≃* ↥V :=
    { toFun := fun v => ⟨g⁻¹ * v * g, hVg v v.2⟩
      invFun := fun v => ⟨g * v * g⁻¹, hgv v v.2⟩
      left_inv := fun v => Subtype.ext (by simp [mul_assoc])
      right_inv := fun v => Subtype.ext (by simp [mul_assoc])
      map_mul' := fun u v => Subtype.ext (by simp [mul_assoc]) }
  have hφ : (pPrimeCore 2 ↥V).map φ.toMonoidHom = pPrimeCore 2 ↥V :=
    Subgroup.characteristic_iff_map_eq.mp (pPrimeCore_characteristic (p := 2)) φ
  let α := QuotientGroup.congr (pPrimeCore 2 ↥V) (pPrimeCore 2 ↥V) φ hφ
  have hα : α = MulEquiv.refl _ := by
    refine GorensteinWalter.perfect_central_automorphism_eq hperf α (MulEquiv.refl _) ?_
    intro q
    induction q using QuotientGroup.induction_on with
    | H v =>
      set c : ↥V := v⁻¹ * φ v with hcdef
      have hcK : (c : X) ∈ coreActionKernel V := by
        have : (c : X) = (v : X)⁻¹ * g⁻¹ * v * g := by
          simp [hcdef, φ, mul_assoc]
        rw [this]
        exact hc v v.2
      have hcen : (QuotientGroup.mk c : ↥V ⧸ pPrimeCore 2 ↥V) ∈ center _ := by
        rw [Subgroup.mem_center_iff]
        intro q
        induction q using QuotientGroup.induction_on with
        | H w =>
          rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
          obtain ⟨o, ho, hoe⟩ := (mem_coreActionKernel.mp hcK).2 w w.2
          have : (w * c)⁻¹ * (c * w) = o⁻¹ := by
            apply Subtype.ext
            simp only [subtype_apply] at hoe
            simp only [coe_mul, coe_inv, mul_inv_rev, hoe]
            group
          rw [this]
          exact inv_mem ho
      have h1 : α (QuotientGroup.mk v) * ((MulEquiv.refl _) (QuotientGroup.mk v))⁻¹ =
          QuotientGroup.mk v * QuotientGroup.mk c * (QuotientGroup.mk v)⁻¹ := by
        rw [MulEquiv.refl_apply, ← QuotientGroup.mk_mul, ← QuotientGroup.mk_inv,
          ← QuotientGroup.mk_mul, hcdef, mul_inv_cancel_left]
        rfl
      rw [h1, Subgroup.mem_center_iff.mp hcen (QuotientGroup.mk v), mul_inv_cancel_right]
      exact hcen
  refine mem_coreActionKernel.mpr ⟨hgV, fun v hv => ?_⟩
  have h1 : α (QuotientGroup.mk ⟨v, hv⟩) = QuotientGroup.mk ⟨v, hv⟩ := by rw [hα]; rfl
  have h2 : (QuotientGroup.mk (φ ⟨v, hv⟩) : ↥V ⧸ pPrimeCore 2 ↥V) = QuotientGroup.mk ⟨v, hv⟩ := h1
  rw [QuotientGroup.eq] at h2
  have h3 := mem_map_of_mem V.subtype (inv_mem h2)
  convert h3 using 1
  simp [φ, mul_assoc]

theorem commutator_sup_eq_of_perfect {K K' : Subgroup X} (hK : ⁅K, K⁆ = K) (hK' : ⁅K', K'⁆ = K') :
    ⁅K ⊔ K', K ⊔ K'⁆ = K ⊔ K' := by
  apply le_antisymm
  · rw [commutator_le]
    intro g hg h hh
    rw [commutatorElement_def]
    exact mul_mem (mul_mem (mul_mem hg hh) (inv_mem hg)) (inv_mem hh)
  · refine sup_le ?_ ?_
    · calc K = ⁅K, K⁆ := hK.symm
        _ ≤ ⁅K ⊔ K', K ⊔ K'⁆ := commutator_mono le_sup_left le_sup_left
    · calc K' = ⁅K', K'⁆ := hK'.symm
        _ ≤ ⁅K ⊔ K', K ⊔ K'⁆ := commutator_mono le_sup_right le_sup_right

omit [Group X] in
theorem isPerfect_oddBar {Y : Type*} [Group Y] (hY : Group.IsPerfect Y) :
    Group.IsPerfect (Y ⧸ pPrimeCore 2 Y) :=
  Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective (pPrimeCore 2 Y))

variable [Finite X]

theorem commutator_eq_self_of_isPComponent {W K : Subgroup X} (hKW : K ≤ W)
    (hK : IsPComponent 2 (K.subgroupOf W)) : ⁅K, K⁆ = K := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h1 : Group.IsPerfect ↥(K.subgroupOf W) :=
    CatalogueBHeldSmallCore.pComponent_perfect 2 _ hK
  have h2 : Group.IsPerfect ↥K :=
    Group.IsPerfect.ofSurjective (f := (subgroupOfEquivOfLe hKW).toMonoidHom)
      (subgroupOfEquivOfLe hKW).surjective
  exact (Subgroup.isPerfect_iff (H := K)).mp h2

