@[expose] def ofTable21 (t : Array ℕ) (x : Fin 21) : Fin 21 :=
  ⟨t[x.val]! % 21, Nat.mod_lt _ (by norm_num)⟩

@[expose] def allHyper : List (Finset (Fin 21)) := hyperClass0 ++ hyperClass1 ++ hyperClass2

@[expose] def nc3 (x y z : Fin 21) : Bool :=
  (List.finRange 21).all fun a =>
    !((lineMasks[a.val]!).testBit x && (lineMasks[a.val]!).testBit y &&
      (lineMasks[a.val]!).testBit z)

@[expose] def ArcLevel5 (x₀ x₁ x₂ x₃ x₄ : Fin 21) : Prop :=
  ∀ x₅ : Fin 21, x₄ < x₅ → nc3 x₀ x₁ x₅ = true → nc3 x₀ x₂ x₅ = true →
    nc3 x₀ x₃ x₅ = true → nc3 x₀ x₄ x₅ = true → nc3 x₁ x₂ x₅ = true → nc3 x₁ x₃ x₅ = true →
    nc3 x₁ x₄ x₅ = true → nc3 x₂ x₃ x₅ = true → nc3 x₂ x₄ x₅ = true → nc3 x₃ x₄ x₅ = true →
    ({x₀, x₁, x₂, x₃, x₄, x₅} : Finset (Fin 21)) ∈ allHyper

instance (x₀ x₁ x₂ x₃ x₄ : Fin 21) : Decidable (ArcLevel5 x₀ x₁ x₂ x₃ x₄) := by
  unfold ArcLevel5
  infer_instance

@[expose] def ArcLevel4 (x₀ x₁ x₂ x₃ : Fin 21) : Prop :=
  ∀ x₄ : Fin 21, x₃ < x₄ → nc3 x₀ x₁ x₄ = true → nc3 x₀ x₂ x₄ = true →
    nc3 x₀ x₃ x₄ = true → nc3 x₁ x₂ x₄ = true → nc3 x₁ x₃ x₄ = true → nc3 x₂ x₃ x₄ = true →
    ArcLevel5 x₀ x₁ x₂ x₃ x₄

instance (x₀ x₁ x₂ x₃ : Fin 21) : Decidable (ArcLevel4 x₀ x₁ x₂ x₃) := by
  unfold ArcLevel4
  infer_instance

@[expose] def ArcLevel3 (x₀ x₁ x₂ : Fin 21) : Prop :=
  ∀ x₃ : Fin 21, x₂ < x₃ → nc3 x₀ x₁ x₃ = true → nc3 x₀ x₂ x₃ = true → nc3 x₁ x₂ x₃ = true →
    ArcLevel4 x₀ x₁ x₂ x₃

instance (x₀ x₁ x₂ : Fin 21) : Decidable (ArcLevel3 x₀ x₁ x₂) := by
  unfold ArcLevel3
  infer_instance

@[expose] def ArcLevel2 (x₀ x₁ : Fin 21) : Prop :=
  ∀ x₂ : Fin 21, x₁ < x₂ → nc3 x₀ x₁ x₂ = true → ArcLevel3 x₀ x₁ x₂

instance (x₀ x₁ : Fin 21) : Decidable (ArcLevel2 x₀ x₁) := by
  unfold ArcLevel2
  infer_instance

