@[expose] def SuzONanTau (A : Subgroup G) : Prop :=
  Blueprint.NativeSporadic.IsSporadic (A ⧸ Open.fusionZStar A) .Suz ∨
    Blueprint.NativeSporadic.IsSporadic (A ⧸ Open.fusionZStar A) .ONan

theorem gsMirrorMaximal_of_suzONan (hS : SchreierFor Blueprint.Catalog)
    (hC4 : SuzONanNotProperFixedCatalog) [IsSimpleGroup G] (hnonab : ∃ a b : G, a * b ≠ b * a)
    (hK : Assembly.KProper Blueprint.Catalog G) {J : Subgroup G} (hJ : SuzONanTau J) :
    GSMirrorMaximal J := by
  refine gsMirrorMaximal_of_properFixed hS hnonab hK SuzONanTau ?_ ?_ hJ
  · rintro A B ⟨e⟩ (hA | hA)
    · obtain ⟨f⟩ : Nonempty (A ⧸ Open.fusionZStar A ≃* Blueprint.NativeSporadic.Carrier .Suz) := hA
      exact Or.inl ⟨e.symm.trans f⟩
    · obtain ⟨f⟩ : Nonempty (A ⧸ Open.fusionZStar A ≃* Blueprint.NativeSporadic.Carrier .ONan) :=
        hA
      exact Or.inr ⟨e.symm.trans f⟩
  · intro a b M T ha hb hab hMb hMp hMa hTM hTp hlt hT
    have hbZ : b ∉ center G := GSLit.not_mem_center_of_orderOf_eq_two hnonab hb
    have hbtop : centralizer ({b} : Set G) ≠ ⊤ := fun htop => hbZ (mem_center_iff.mpr
      fun x => mem_centralizer_singleton_iff.mp (by rw [htop]; exact mem_top x))
    have h := not_suzONan_of_fixed hC4 hK ha hb hab hbtop hMb hMp hMa hTM hTp hlt
    rcases hT with hT | hT
    · exact h.1 hT
    · exact h.2 hT

theorem isSolomonMaximal_of_suzONan (hS : SchreierFor Blueprint.Catalog)
    (hC4 : SuzONanNotProperFixedCatalog) [IsSimpleGroup G] (hnonab : ∃ a b : G, a * b ≠ b * a)
    (hsF : IsSimpleGroup (GeneralizedFitting.subgroup G))
    (hnF : ∃ u w : GeneralizedFitting.subgroup G, u * w ≠ w * u)
    (hK : Assembly.KProper Blueprint.Catalog G) {a : G} {J : Subgroup G} (ha : orderOf a = 2)
    (hJ : IsTwoComponentIn J (centralizer ({a} : Set G))) (hJt : SuzONanTau J) :
    IsSolomonMaximal J :=
  isSolomonMaximal_of_gsMirrorMaximal hsF hnF ha hJ
    (gsMirrorMaximal_of_suzONan hS hC4 hnonab hK hJt)

theorem step_iso_or_card_lt (hS : SchreierFor Blueprint.Catalog) [IsSimpleGroup G]
    (hnonab : ∃ a b : G, a * b ≠ b * a) (hK : Assembly.KProper Blueprint.Catalog G)
    {Y X : Subgroup G}
    (hst : (∃ a b : G, GSWeakCorr a Y b X) ∨ MirrorStep Y X ∨
      ∃ g : G, X = conjugate Y g) :
    Nonempty (Y ⧸ Open.fusionZStar Y ≃* X ⧸ Open.fusionZStar X) ∨
      Nat.card (Y ⧸ Open.fusionZStar Y) < Nat.card (X ⧸ Open.fusionZStar X) := by
  rcases hst with ⟨c, d, hW⟩ | hM | ⟨g, rfl⟩
  · have hdZ : d ∉ center G := GSLit.not_mem_center_of_orderOf_eq_two hnonab hW.2.1
    rcases gsWeakCorr_type_dichotomy hS hK hW hdZ with he | ⟨hMa, hTM, hTp, hlt, ⟨eT⟩⟩
    · exact Or.inl he
    · right
      have h := card_fusionZStar_lt_of_fixed hW.1 hW.2.1 hW.2.2.1 hW.2.2.2.2.2.1
        hW.2.2.2.2.2.2.1 hMa hTM hTp hlt
      rwa [← Nat.card_congr eT.toEquiv] at h
  · obtain ⟨z, s, D, hz, hs, hzs, hYz, hYs, hX, hD, hDY, hDX⟩ := hM
    by_cases hfree : conjugate X z ≠ X ∨ z ∈ coreActionKernel X
    · exact Or.inl (mirror_fusionZStar_equiv_of_free hz hs hzs hYz hYs hX hD hDY
        hDX hfree)
    · obtain ⟨hXz, hzX⟩ := not_or.mp hfree
      have hXz' : conjugate X z = X := not_not.mp hXz
      obtain ⟨hTM, hTpc, hlt⟩ := properFixed_of_badShape hz hzs hX hD hDX hXz' hzX
      obtain ⟨eDY⟩ := diagonal_fusionZStar_equiv hs hzs hYz hYs hD hDY
      right
      have h := card_fusionZStar_lt_of_fixed hz hs hzs hX.1 hX.2 hXz' hTM hTpc hlt
      rwa [Nat.card_congr eDY.toEquiv] at h
  · exact Or.inl (GrSLit.nonempty_fusionZStar_equiv_conjugate Y g)

private theorem gsWeakCorr_reverse_of_vertical {a b : G} {Y X D : Subgroup G}
    (h : GSWeakCorr a Y b X) (hXa : conjugate X a = X)
    (haK : a ∈ coreActionKernel X)
    (hD : IsTwoComponentIn D
      (Subgroup.centralizer ({a} : Set G) ⊓ Subgroup.centralizer ({b} : Set G)))
    (hDX : D ≤ X) (hDY : D ≤ Y ⊔ conjugate Y b) :
    GSWeakCorr b X a Y := by
  obtain ⟨ha, hb, hab, hYa, hYp, hXb, hXp, hbN, hcomm, _hTK⟩ := h
  have hX : IsTwoComponentIn X (Subgroup.centralizer ({b} : Set G)) := ⟨hXb, hXp⟩
  have hFix : gsFixedLayer X a = D :=
    gsFixedLayer_eq_of_common_component ha hX hab hXa haK hD hDX
  have haN : a ∈ Subgroup.normalizer (X : Set G) :=
    UnbalancedLayer.mem_normalizer_of_conjugate_eq hXa
  exact ⟨hb, ha, hab.symm, hXb, hXp, hYa, hYp, haN,
    (mem_coreActionKernel.mp haK).2, by rw [hFix]; exact hDY⟩

theorem gsMirrorReach_reverse_of_gsWeakCorr {a b : G} {Y X : Subgroup G}
    (h : GSWeakCorr a Y b X)
    (hIso : Nonempty (Y ⧸ Open.fusionZStar Y ≃* X ⧸ Open.fusionZStar X)) :
    GSMirrorReach X Y := by
  obtain ⟨ha, hb, hab, hYa, hYp, hXb, hXp, hbN, hcomm, hTK⟩ := h
  have hX : IsTwoComponentIn X (Subgroup.centralizer ({b} : Set G)) := ⟨hXb, hXp⟩
  by_cases hXa : conjugate X a = X
  · by_cases haK : a ∈ coreActionKernel X
    · have hT := gsFixedLayer_common_component_of_gsWeakCorr
        ⟨ha, hb, hab, hYa, hYp, hXb, hXp, hbN, hcomm, hTK⟩
      have hTleX : gsFixedLayer Y b ≤ X := by
        rw [hXa, sup_idem] at hTK
        exact hTK
      have hTleY : gsFixedLayer Y b ≤ Y :=
        (gsFixedLayer_le_inf Y b).trans inf_le_left
      have hrev := gsWeakCorr_reverse_of_vertical
        ⟨ha, hb, hab, hYa, hYp, hXb, hXp, hbN, hcomm, hTK⟩ hXa haK hT hTleX
        (hTleY.trans le_sup_left)
      exact Relation.ReflTransGen.single (Or.inl ⟨b, a, hrev⟩)
    ·
      have hT := gsFixedLayer_common_component_of_gsWeakCorr
        ⟨ha, hb, hab, hYa, hYp, hXb, hXp, hbN, hcomm, hTK⟩
      have hproper := properFixed_of_badShape ha hab hX hT hTK hXa haK
      obtain ⟨hTM, hTpc, hlt⟩ := hproper
      have hcard := card_fusionZStar_lt_of_fixed ha hb hab hXb hXp hXa hTM hTpc hlt
      have hYq : IsQuasisimple (Y ⧸ pPrimeCore 2 Y) :=
        isQuasisimple_quotient_of_isPComponent hYa hYp
      have hTsup : gsFixedLayer Y b ⊔ (pPrimeCore 2 Y).map Y.subtype = Y :=
        gsFixedLayer_sup_map_pPrimeCore hb hYq hbN hcomm
      have hTleY : gsFixedLayer Y b ≤ Y :=
        (gsFixedLayer_le_inf Y b).trans inf_le_left
      obtain ⟨-, eTY, -⟩ := restriction_quotient_mulEquiv hTleY hTsup
      obtain ⟨eTYZ⟩ := GrSLit.nonempty_fusionZStar_equiv_of_quotient_equiv eTY
      have hYT : Nat.card (Y ⧸ Open.fusionZStar Y) =
          Nat.card (gsFixedLayer Y b ⧸ Open.fusionZStar (gsFixedLayer Y b)) :=
        (Nat.card_congr eTYZ.toEquiv).symm
      have hYX : Nat.card (Y ⧸ Open.fusionZStar Y) =
          Nat.card (X ⧸ Open.fusionZStar X) := Nat.card_congr hIso.some.toEquiv
      omega
  ·
    have hT := gsFixedLayer_common_component_of_gsWeakCorr
      ⟨ha, hb, hab, hYa, hYp, hXb, hXp, hbN, hcomm, hTK⟩
    have hTsc : IsTwoComponentIn (gsFixedLayer Y b)
        (Subgroup.centralizer ({b} : Set G) ⊓ Subgroup.centralizer ({a} : Set G)) := by
      rw [inf_comm]; exact hT
    have hTleY : gsFixedLayer Y b ≤ Y :=
      (gsFixedLayer_le_inf Y b).trans inf_le_left
    have hm : MirrorStep X Y :=
      ⟨b, a, gsFixedLayer Y b, hb, ha, hab.symm, hX, hXa,
        ⟨hYa, hYp⟩, hTsc, hTK, hTleY.trans le_sup_left⟩
    exact Relation.ReflTransGen.single (Or.inr (Or.inl hm))

theorem exists_gsMirrorMaximal_reach (hS : SchreierFor Blueprint.Catalog) [IsSimpleGroup G]
    (hnonab : ∃ a b : G, a * b ≠ b * a) (hK : Assembly.KProper Blueprint.Catalog G)
    (J : Subgroup G) :
    ∃ J' : Subgroup G, GSMirrorReach J J' ∧ GSMirrorMaximal J' := by
  classical
  let R : Set (Subgroup G) := {M | GSMirrorReach J M}
  obtain ⟨J', hJR, hJmax⟩ := Set.exists_max_image R
    (fun X : Subgroup G => Nat.card (X ⧸ Open.fusionZStar X)) (Set.toFinite R)
    ⟨J, GSMirrorReach.refl J⟩
  have hJR' : GSMirrorReach J J' := hJR
  refine ⟨J', hJR', fun M hM => ?_⟩
  induction hM with
  | refl => exact ⟨MulEquiv.refl _⟩
  | @tail L M hJL hst ih =>
    obtain ⟨e₁⟩ := ih
    rcases step_iso_or_card_lt hS hnonab hK hst with he₂ | hlt
    · obtain ⟨e₂⟩ := he₂
      exact ⟨e₁.trans e₂⟩
    · exfalso
      have hle := hJmax M (Relation.ReflTransGen.tail (hJR'.trans hJL) hst)
      have heq := Nat.card_congr e₁.toEquiv
      have hle' : Nat.card (M ⧸ Open.fusionZStar M) ≤ Nat.card (J' ⧸ Open.fusionZStar J') := hle
      omega

theorem isTwoComponentAt_of_gsMirrorReach {J M : Subgroup G}
    (hJ : ∃ a : G, orderOf a = 2 ∧ IsTwoComponentIn J (centralizer ({a} : Set G)))
    (h : GSMirrorReach J M) :
    ∃ a : G, orderOf a = 2 ∧ IsTwoComponentIn M (centralizer ({a} : Set G)) := by
  induction h with
  | refl => exact hJ
  | @tail L M _ hst ih =>
    rcases hst with ⟨c, d, hW⟩ | hM | ⟨g, rfl⟩
    · exact ⟨d, hW.2.1, hW.2.2.2.2.2.1, hW.2.2.2.2.2.2.1⟩
    · obtain ⟨z, s, D, hz, hs, hzs, hYz, hYs, hX, -⟩ := hM
      exact ⟨s, hs, hX⟩
    · obtain ⟨a, ha, hLa, hLp⟩ := ih
      obtain ⟨ha', -, -, hJa', hJp', -⟩ :=
        gsWeakCorr_conjugate (gsWeakCorr_self ha hLa hLp) g
      exact ⟨_, ha', hJa', hJp'⟩

theorem exists_isSolomonMaximal_reach (hS : SchreierFor Blueprint.Catalog) [IsSimpleGroup G]
    (hnonab : ∃ a b : G, a * b ≠ b * a)
    (hsF : IsSimpleGroup (GeneralizedFitting.subgroup G))
    (hnF : ∃ u w : GeneralizedFitting.subgroup G, u * w ≠ w * u)
    (hK : Assembly.KProper Blueprint.Catalog G) {a : G} {J : Subgroup G} (ha : orderOf a = 2)
    (hJ : IsTwoComponentIn J (centralizer ({a} : Set G))) :
    ∃ J' : Subgroup G, GSMirrorReach J J' ∧ GSMirrorMaximal J' ∧
      IsSolomonMaximal J' := by
  obtain ⟨J', hR, hM⟩ := exists_gsMirrorMaximal_reach hS hnonab hK J
  obtain ⟨b, hb, hJ'⟩ := isTwoComponentAt_of_gsMirrorReach ⟨a, ha, hJ⟩ hR
  exact ⟨J', hR, hM, isSolomonMaximal_of_gsMirrorMaximal hsF hnF hb hJ' hM⟩

theorem gsMirrorMaximal_or_top (hS : SchreierFor Blueprint.Catalog) [IsSimpleGroup G]
    (hnonab : ∃ a b : G, a * b ≠ b * a) (hK : Assembly.KProper Blueprint.Catalog G)
    (J : Subgroup G) :
    GSMirrorMaximal J ∨ ∃ J' : Subgroup G, GSMirrorReach J J' ∧ GSMirrorMaximal J' ∧
      Nat.card (J ⧸ Open.fusionZStar J) < Nat.card (J' ⧸ Open.fusionZStar J') := by
  classical
  let R : Set (Subgroup G) := {M | GSMirrorReach J M}
  obtain ⟨J', hJR, hJmax⟩ := Set.exists_max_image R
    (fun X : Subgroup G => Nat.card (X ⧸ Open.fusionZStar X)) (Set.toFinite R)
    ⟨J, GSMirrorReach.refl J⟩
  have hJR' : GSMirrorReach J J' := hJR
  by_cases hlt : Nat.card (J ⧸ Open.fusionZStar J) < Nat.card (J' ⧸ Open.fusionZStar J')
  · refine Or.inr ⟨J', hJR', fun M hM => ?_, hlt⟩
    induction hM with
    | refl => exact ⟨MulEquiv.refl _⟩
    | @tail L M hJL hst ih =>
      obtain ⟨e₁⟩ := ih
      rcases step_iso_or_card_lt hS hnonab hK hst with he₂ | hlt'
      · obtain ⟨e₂⟩ := he₂
        exact ⟨e₁.trans e₂⟩
      · exfalso
        have hle : Nat.card (M ⧸ Open.fusionZStar M) ≤ Nat.card (J' ⧸ Open.fusionZStar J') :=
          hJmax M (Relation.ReflTransGen.tail (hJR'.trans hJL) hst)
        have heq := Nat.card_congr e₁.toEquiv
        omega
  · left
    push Not at hlt
    intro M hM
    induction hM with
    | refl => exact ⟨MulEquiv.refl _⟩
    | @tail L M hJL hst ih =>
      obtain ⟨e₁⟩ := ih
      rcases step_iso_or_card_lt hS hnonab hK hst with he₂ | hlt'
      · obtain ⟨e₂⟩ := he₂
        exact ⟨e₁.trans e₂⟩
      · exfalso
        have hle : Nat.card (M ⧸ Open.fusionZStar M) ≤ Nat.card (J' ⧸ Open.fusionZStar J') :=
          hJmax M (Relation.ReflTransGen.tail hJL hst)
        have heq := Nat.card_congr e₁.toEquiv
        omega

@[expose] def FooteTopExclusion : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (t : G) (L : Subgroup G), FooteMinimal G →
    FooteCounterexample G t L → IsSimpleGroup G →
    (∀ A ∈ footeFamilyOf L, CFSG.pRank 2 ↥A = 2) →
    ∀ A ∈ footeFamilyOf L, ∀ J : Subgroup G, GSMirrorReach A J → GSMirrorMaximal J →
      Nat.card (A ⧸ Open.fusionZStar A) < Nat.card (J ⧸ Open.fusionZStar J) → False

theorem footeSolomonMaximalStep_of_topExclusion (hSch : SchreierFor Blueprint.Catalog)
    (hT : FooteTopExclusion) : FooteSolomonMaximalStep := by
  intro G _ _ t L hmin hce hsimp hrank2 A hAF
  have htop : GeneralizedFitting.subgroup G = ⊤ := GSLit.generalizedFitting_eq_top_of_simple
  let eF : GeneralizedFitting.subgroup G ≃* G :=
    (MulEquiv.subgroupCongr htop).trans Subgroup.topEquiv
  have hsF : IsSimpleGroup (GeneralizedFitting.subgroup G) := eF.isSimpleGroup
  obtain ⟨u, -, v, -, huv⟩ := exists_mul_ne_mul_of_footeCounterexample hce
  have hnF : ∃ a b : GeneralizedFitting.subgroup G, a * b ≠ b * a := by
    refine ⟨eF.symm u, eF.symm v, fun h => huv ?_⟩
    have h1 := congrArg eF h
    rwa [map_mul, map_mul, MulEquiv.apply_symm_apply, MulEquiv.apply_symm_apply] at h1
  have hnonab : ∃ a b : G, a * b ≠ b * a := ⟨u, v, huv⟩
  have hK : Assembly.KProper Blueprint.Catalog G := hce.1.1
  obtain ⟨z, ⟨hz, hAz, hAp⟩, -⟩ := hAF.1
  rcases gsMirrorMaximal_or_top hSch hnonab hK A with hM | ⟨J, hR, hM, hlt⟩
  · exact isSolomonMaximal_of_gsMirrorMaximal hsF hnF hz ⟨hAz, hAp⟩ hM
  · exact (hT G t L hmin hce hsimp hrank2 A hAF J hR hM hlt).elim

theorem footeConjugatePairExclusion_of_topExclusion
    (hCI : GSLit.ClassicalInvolutionInput) (hGA : TBLit.GriessMultipliersAllModels)
    (hGC : TBLit.GriessMultipliersCentralCovers)
    (hSA : SolAltLit.SchurAlternatingMultiplierInput) (h13 : Sol76T13.SolomonThm13Simple)
    (hSch : SchreierFor Blueprint.Catalog) (hT : FooteTopExclusion) :
    FooteConjugatePairExclusion :=
  footeConjugatePairExclusion_of_maximalStep hCI hGA hGC hSA h13
    (footeSolomonMaximalStep_of_topExclusion hSch hT)

end CFSG.ComponentClassification.Foote5.SolMax
