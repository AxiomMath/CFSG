theorem markedLayer_le_base (S : Set (Subgroup G)) (T : Type*) [Group T] (N : Subgroup G) :
    markedLayer S T N ≤ base N := by
  apply sSup_le
  intro K hK
  exact (le_twoLayerIn_of_isTwoComponentIn hK.1).trans le_sup_right

theorem isTwoComponentIn_markedLayer {N K : Subgroup G}
    (hK : K ∈ markedComponents S T N) : IsTwoComponentIn K (markedLayer S T N) := by
  have hKD : K ≤ markedLayer S T N := le_sSup hK
  exact ⟨hKD, GSThmB.B5a.isPComponent_subgroupOf_of_le hKD (markedLayer_le S T N) hK.1.2⟩

theorem image_eq_of_oddCore_cover {K J H : Subgroup G} (hJ : IsTwoComponentIn J H)
    (hcover : K ⊔ oddCoreIn J = J) :
    (K.subgroupOf H).map (QuotientGroup.mk' (pPrimeCore 2 H)) =
      (J.subgroupOf H).map (QuotientGroup.mk' (pPrimeCore 2 H)) := by
  have hKJ : K ≤ J := le_sup_left.trans hcover.le
  have hOJH : oddCoreIn J ≤ H := (oddCoreIn_le_of_isTwoComponentIn hJ).trans (map_subtype_le _)
  have hO : ((oddCoreIn J).subgroupOf H).map (QuotientGroup.mk' (pPrimeCore 2 H)) = ⊥ := by
    apply (Subgroup.map_eq_bot_iff (H := (oddCoreIn J).subgroupOf H)
      (f := QuotientGroup.mk' (pPrimeCore 2 H))).mpr
    rw [QuotientGroup.ker_mk']
    intro x hx
    have hxO : (x : G) ∈ oddCoreIn H := oddCoreIn_le_of_isTwoComponentIn hJ hx
    exact (Subgroup.mem_map_iff_mem H.subtype_injective).mp hxO
  have h := congrArg (fun L : Subgroup G =>
    (L.subgroupOf H).map (QuotientGroup.mk' (pPrimeCore 2 H))) hcover
  rw [Subgroup.subgroupOf_sup (hKJ.trans hJ.1) hOJH, Subgroup.map_sup, hO, sup_bot_eq] at h
  exact h

theorem eq_of_marked_oddCore_covers {N H K L J : Subgroup G}
    (hbase : base N ≤ H) (hK : K ∈ markedComponents S T N)
    (hL : L ∈ markedComponents S T N) (hJ : J ∈ markedComponents S T H)
    (hKJ : K ⊔ oddCoreIn J = J) (hLJ : L ⊔ oddCoreIn J = J) : K = L := by
  have hDH : markedLayer S T N ≤ H := (markedLayer_le_base S T N).trans hbase
  have hKH : K ≤ H := (le_sSup hK).trans hDH
  have hLH : L ≤ H := (le_sSup hL).trans hDH
  have hKcomp := (isTwoComponentIn_markedLayer hK).2
  have hLcomp := (isTwoComponentIn_markedLayer hL).2
  have hKcompH : IsPComponent 2 ((K.subgroupOf H).subgroupOf ((markedLayer S T N).subgroupOf H)) :=
    (UnbalancedCorr.isPComponent_subgroupOf_subgroupOf_iff' hDH 2 Nat.prime_two).2 hKcomp
  have hLcompH : IsPComponent 2 ((L.subgroupOf H).subgroupOf ((markedLayer S T N).subgroupOf H)) :=
    (UnbalancedCorr.isPComponent_subgroupOf_subgroupOf_iff' hDH 2 Nat.prime_two).2 hLcomp
  have hodd : ¬ 2 ∣ Nat.card (QuotientGroup.mk' (pPrimeCore 2 H)).ker := by
    rw [QuotientGroup.ker_mk']
    exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mp (pPrimeCore_coprime_card (p := 2))
  have h := GSThmB.OddQuot.eq_of_map_eq (QuotientGroup.mk' (pPrimeCore 2 H)) hodd
    (Subgroup.comap_mono (le_sSup hK)) (Subgroup.comap_mono (le_sSup hL))
    hKcompH hLcompH ((image_eq_of_oddCore_cover hJ.1 hKJ).trans
      (image_eq_of_oddCore_cover hJ.1 hLJ).symm)
  have h' := Subgroup.subgroupOf_inj.mp h
  simpa only [inf_of_le_left hKH, inf_of_le_left hLH] using h'

theorem exists_markedComponents_embedding_of_oddCore_covers {N H : Subgroup G}
    (hbase : base N ≤ H)
    (hLift : ∀ K ∈ markedComponents S T N, ∃ J ∈ markedComponents S T H,
      K ⊔ oddCoreIn J = J) :
    ∃ f : {K : Subgroup G // K ∈ markedComponents S T N} ↪
        {J : Subgroup G // J ∈ markedComponents S T H},
      ∀ K, K.val ⊔ oddCoreIn (f K).val = (f K).val := by
  classical
  let f : {K : Subgroup G // K ∈ markedComponents S T N} →
      {J : Subgroup G // J ∈ markedComponents S T H} := fun K =>
    ⟨Classical.choose (hLift K.val K.property), (Classical.choose_spec (hLift K.val K.property)).1⟩
  have hf : ∀ K, K.val ⊔ oddCoreIn (f K).val = (f K).val := fun K =>
    (Classical.choose_spec (hLift K.val K.property)).2
  refine ⟨⟨f, ?_⟩, hf⟩
  intro K L h
  apply Subtype.ext
  have hval := congrArg Subtype.val h
  apply eq_of_marked_oddCore_covers hbase K.property L.property (f K).property (hf K)
  simpa only [hval] using hf L

theorem markedCount_le_of_oddCore_covers {N H : Subgroup G} (hbase : base N ≤ H)
    (hLift : ∀ K ∈ markedComponents S T N, ∃ J ∈ markedComponents S T H,
      K ⊔ oddCoreIn J = J) : markedCount S T N ≤ markedCount S T H := by
  classical
  have : Finite (Subgroup G) :=
    Finite.of_injective (fun K : Subgroup G => (K : Set G)) SetLike.coe_injective
  obtain ⟨f, -⟩ := exists_markedComponents_embedding_of_oddCore_covers hbase hLift
  have h := Nat.card_le_card_of_injective f f.injective
  simpa only [Nat.card_coe_set_eq, markedCount] using h

theorem markedLayer_eq_sup_oddCore_of_surjective_covers {N H : Subgroup G}
    (f : {K : Subgroup G // K ∈ markedComponents S T N} →
      {J : Subgroup G // J ∈ markedComponents S T H})
    (hsurj : Function.Surjective f)
    (hcover : ∀ K, K.val ⊔ oddCoreIn (f K).val = (f K).val) :
    markedLayer S T H = oddCoreIn (markedLayer S T H) ⊔ markedLayer S T N := by
  have hDN : markedLayer S T N ≤ markedLayer S T H := by
    apply sSup_le
    intro K hK
    exact (le_sup_left.trans (hcover ⟨K, hK⟩).le).trans (le_sSup (f ⟨K, hK⟩).property)
  apply le_antisymm ?_ (sup_le (map_subtype_le _) hDN)
  apply sSup_le
  intro J hJ
  obtain ⟨K, hK⟩ := hsurj ⟨J, hJ⟩
  have hval : (f K).val = J := congrArg Subtype.val hK
  rw [← hval, ← hcover K]
  exact sup_le (le_sup_of_le_right (le_sSup K.property))
    (le_sup_of_le_left (oddCoreIn_le_of_isTwoComponentIn
      (isTwoComponentIn_markedLayer (f K).property)))

theorem markedLayer_eq_sup_oddCore_of_oddCore_covers_of_count_eq {N H : Subgroup G}
    (hbase : base N ≤ H)
    (hLift : ∀ K ∈ markedComponents S T N, ∃ J ∈ markedComponents S T H,
      K ⊔ oddCoreIn J = J)
    (hcount : markedCount S T H = markedCount S T N) :
    markedLayer S T H = oddCoreIn (markedLayer S T H) ⊔ markedLayer S T N := by
  classical
  have : Finite (Subgroup G) :=
    Finite.of_injective (fun K : Subgroup G => (K : Set G)) SetLike.coe_injective
  obtain ⟨f, hf⟩ := exists_markedComponents_embedding_of_oddCore_covers hbase hLift
  have hcard : Nat.card {K : Subgroup G // K ∈ markedComponents S T N} =
      Nat.card {J : Subgroup G // J ∈ markedComponents S T H} := by
    simpa only [Nat.card_coe_set_eq, markedCount] using hcount.symm
  obtain ⟨e⟩ := Finite.card_eq.mp hcard
  have hsurj : Function.Surjective f :=
    (Finite.injective_iff_surjective_of_equiv e).mp f.injective
  exact markedLayer_eq_sup_oddCore_of_surjective_covers f hsurj hf

theorem nonempty_oddCore_quotient_equiv_image {K H : Subgroup G}
    (hK : IsTwoComponentIn K H) :
    Nonempty (K ⧸ pPrimeCore 2 K ≃*
      (K.subgroupOf H).map (QuotientGroup.mk' (pPrimeCore 2 H))) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let π := QuotientGroup.mk' (pPrimeCore 2 H)
  let A := (K.subgroupOf H).map π
  have hA : IsComponent A := Sol76T13.R12.isComponent_image hK
  have hOAmap : (pPrimeCore 2 A).map A.subtype ≤ pPrimeCore 2 (H ⧸ pPrimeCore 2 H) :=
    Walter.map_pPrimeCore_le_of_isSubnormal hA.2
  rw [pPrimeCore_quotient_eq_bot (p := 2) Nat.prime_two] at hOAmap
  have hOA : pPrimeCore 2 A = ⊥ :=
    (Subgroup.map_eq_bot_iff_of_injective (pPrimeCore 2 A) A.subtype_injective).mp (le_bot_iff.mp hOAmap)
  have hodd : ¬ 2 ∣ Nat.card π.ker := by
    rw [show π.ker = pPrimeCore 2 H from QuotientGroup.ker_mk' _]
    exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mp (pPrimeCore_coprime_card (p := 2))
  obtain ⟨e⟩ := GSThmB.OddQuot.nonempty_quotient_pPrimeCore_equiv π hodd (K.subgroupOf H)
  let eK := UnbalancingLocal.Correspondence.quotientPPrimeCoreCongr 2
    (Subgroup.subgroupOfEquivOfLe hK.1).symm
  let eA : (A ⧸ pPrimeCore 2 A) ≃* A :=
    (QuotientGroup.quotientMulEquivOfEq hOA).trans QuotientGroup.quotientBot
  exact ⟨eK.trans (e.trans eA)⟩

theorem markedComponent_image_simple_and_center {N K : Subgroup G} [IsSimpleGroup T]
    (hK : K ∈ markedComponents S T N) :
    IsComponent ((K.subgroupOf N).map (QuotientGroup.mk' (pPrimeCore 2 N))) ∧
      IsSimpleGroup ((K.subgroupOf N).map (QuotientGroup.mk' (pPrimeCore 2 N))) ∧
      Subgroup.center ((K.subgroupOf N).map (QuotientGroup.mk' (pPrimeCore 2 N))) = ⊥ := by
  let A := (K.subgroupOf N).map (QuotientGroup.mk' (pPrimeCore 2 N))
  have hA : IsComponent A := Sol76T13.R12.isComponent_image hK.1
  obtain ⟨eK⟩ := nonempty_oddCore_quotient_equiv_image hK.1
  obtain ⟨eT⟩ := hK.2.2.1
  let e : A ≃* T := eK.symm.trans eT
  have hsimple : IsSimpleGroup A := e.isSimpleGroup
  have : IsSimpleGroup A := hsimple
  have : Group.IsPerfect A := hA.1.1
  exact ⟨hA, hsimple, TauCeti.IsSimpleGroup.center_eq_bot_of_not_isMulCommutative
    (Group.IsPerfect.not_isMulCommutative (G := A))⟩

theorem image_oddCore_markedLayer_eq_bot_of_image_eq {N H : Subgroup G}
    (hFam : IsomorphicFamily S T) (hDNH : markedLayer S T N ≤ H)
    (himage : ((markedLayer S T N).subgroupOf H).map (QuotientGroup.mk' (pPrimeCore 2 H)) =
      ((markedLayer S T H).subgroupOf H).map (QuotientGroup.mk' (pPrimeCore 2 H))) :
    ((oddCoreIn (markedLayer S T N)).subgroupOf H).map
      (QuotientGroup.mk' (pPrimeCore 2 H)) = ⊥ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let π := QuotientGroup.mk' (pPrimeCore 2 H)
  let D := ((markedLayer S T H).subgroupOf H).map π
  have hDnormal : D.Normal :=
    (markedLayer_subgroupOf_normal hFam H).map π (QuotientGroup.mk'_surjective _)
  have hOD : oddCoreIn D = ⊥ := by
    change (pPrimeCore 2 D).map D.subtype = ⊥
    rw [ABGLocalTools.pPrimeCore_map_subtype_eq_inf hDnormal,
      pPrimeCore_quotient_eq_bot (p := 2) Nat.prime_two, inf_bot_eq]
  have hOsub : (oddCoreIn (markedLayer S T N)).subgroupOf H =
      oddCoreIn ((markedLayer S T N).subgroupOf H) := by
    apply Subgroup.map_injective H.subtype_injective
    have hODNH : oddCoreIn (markedLayer S T N) ≤ H :=
      (show oddCoreIn (markedLayer S T N) ≤ markedLayer S T N from map_subtype_le _).trans hDNH
    rw [Subgroup.map_subgroupOf_eq_of_le hODNH]
    exact (pPrimeCore_map_subgroupOf 2 (markedLayer S T N) H hDNH).symm
  have hodd : ¬ 2 ∣ Nat.card π.ker := by
    rw [show π.ker = pPrimeCore 2 H from QuotientGroup.ker_mk' _]
    exact (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mp (pPrimeCore_coprime_card (p := 2))
  rw [hOsub]
  have hmap := GSThmB.OddQuot.map_oddCoreIn π hodd ((markedLayer S T N).subgroupOf H)
  exact hmap.trans (by rw [himage]; exact hOD)

theorem balanced_of_oddCore_covers [IsSimpleGroup T] {N H : Subgroup G}
    (hFam : IsomorphicFamily S T) (hN : Balanced S T N) (hbase : base N ≤ H)
    (hLift : ∀ K ∈ markedComponents S T N, ∃ J ∈ markedComponents S T H,
      K ⊔ oddCoreIn J = J) : Balanced S T H := by
  classical
  have : Finite (Subgroup G) :=
    Finite.of_injective (fun K : Subgroup G => (K : Set G)) SetLike.coe_injective
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hcount := markedCount_le_of_oddCore_covers hbase hLift
  obtain ⟨hNlower, hNbal⟩ := hN
  refine ⟨by omega, ?_⟩
  by_cases hthree : 3 ≤ markedCount S T H
  · exact Or.inl hthree
  right
  have hNtwo : markedCount S T N = 2 := by omega
  have hHtwo : markedCount S T H = 2 := by omega
  have hEvenN : Even (Nat.card (baseKernel S T N)) := hNbal.resolve_left (by omega)
  have hDNH : markedLayer S T N ≤ H := (markedLayer_le_base S T N).trans hbase
  have hDHH : markedLayer S T H ≤ H := markedLayer_le S T H
  have hDHnormal := markedLayer_subgroupOf_normal hFam H
  have hLayer := markedLayer_eq_sup_oddCore_of_oddCore_covers_of_count_eq hbase hLift
    (by omega : markedCount S T H = markedCount S T N)
  let Hbar := H ⧸ pPrimeCore 2 H
  let π : H →* Hbar := QuotientGroup.mk' (pPrimeCore 2 H)
  let D : Subgroup Hbar := ((markedLayer S T H).subgroupOf H).map π
  have hDnormal : D.Normal := hDHnormal.map π (QuotientGroup.mk'_surjective _)
  have hODH : oddCoreIn (markedLayer S T H) ≤ oddCoreIn H :=
    GSThmB.B5a.oddCoreIn_le_of_le_normalizer hDHH (markedLayer_le_normalizer hFam H)
  have hODHH : oddCoreIn (markedLayer S T H) ≤ H := hODH.trans (map_subtype_le _)
  have hODHmap : ((oddCoreIn (markedLayer S T H)).subgroupOf H).map π = ⊥ := by
    apply (Subgroup.map_eq_bot_iff (H := (oddCoreIn (markedLayer S T H)).subgroupOf H)
      (f := π)).mpr
    rw [show π.ker = pPrimeCore 2 H from QuotientGroup.ker_mk' _]
    intro x hx
    exact (Subgroup.mem_map_iff_mem H.subtype_injective).mp (hODH hx)
  have himage : ((markedLayer S T N).subgroupOf H).map π = D := by
    have h := congrArg (fun L : Subgroup G => (L.subgroupOf H).map π) hLayer
    rw [Subgroup.subgroupOf_sup hODHH hDNH, Subgroup.map_sup, hODHmap, bot_sup_eq] at h
    exact h.symm
  have hOold : ((oddCoreIn (markedLayer S T N)).subgroupOf H).map π = ⊥ :=
    image_oddCore_markedLayer_eq_bot_of_image_eq hFam hDNH himage
  obtain ⟨b, hb⟩ := exists_prime_orderOf_dvd_card' 2 (even_iff_two_dvd.mp hEvenN)
  have hbG : orderOf (b : G) = 2 :=
    (orderOf_injective (baseKernel S T N).subtype (baseKernel S T N).subtype_injective b).trans hb
  let bH : H := ⟨(b : G), hbase (Subgroup.mem_inf.mp b.property).1⟩
  have hbH : orderOf bH = 2 :=
    (orderOf_injective H.subtype H.subtype_injective bH).symm.trans hbG
  have hnotdvd : ¬ 2 ∣ Nat.card (pPrimeCore 2 H) :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mp (pPrimeCore_coprime_card (p := 2))
  have hπb : π bH ≠ 1 := by
    intro h
    have hm : bH ∈ pPrimeCore 2 H :=
      (QuotientGroup.eq_one_iff (G := H) (N := pPrimeCore 2 H) (x := bH)).mp h
    let c : pPrimeCore 2 H := ⟨bH, hm⟩
    have hc : orderOf c = 2 :=
      (orderOf_injective (pPrimeCore 2 H).subtype (pPrimeCore 2 H).subtype_injective c).symm.trans hbH
    have hdiv := orderOf_dvd_natCard c
    rw [hc] at hdiv
    exact hnotdvd hdiv
  have hbKernel : (b : G) ∈ coreActionKernel (markedLayer S T N) :=
    (Subgroup.mem_inf.mp b.property).2
  have hbcentral : π bH ∈ Subgroup.centralizer (D : Set Hbar) := by
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    change y ∈ D at hy
    rw [← himage] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    have hcomm : (x : G)⁻¹ * (bH : G)⁻¹ * (x : G) * (bH : G) ∈
        oddCoreIn (markedLayer S T N) :=
      (mem_coreActionKernel.mp hbKernel).2 (x : G) hx
    have hzero : π (x⁻¹ * bH⁻¹ * x * bH) = 1 := by
      have hm : π (x⁻¹ * bH⁻¹ * x * bH) ∈
          ((oddCoreIn (markedLayer S T N)).subgroupOf H).map π :=
        Subgroup.mem_map_of_mem π hcomm
      rwa [hOold, Subgroup.mem_bot] at hm
    have hcommH : x⁻¹ * bH⁻¹ * x * bH ∈ pPrimeCore 2 H :=
      (QuotientGroup.eq_one_iff (G := H) (N := pPrimeCore 2 H)
        (x := x⁻¹ * bH⁻¹ * x * bH)).mp hzero
    exact (Sol76.mk_mul_comm_iff (N := H) x bH).mpr ⟨_, hcommH, rfl⟩
  let Bbar : Subgroup Hbar := zpowers (π bH)
  have hBnt : Nontrivial Bbar := (Subgroup.nontrivial_iff_ne_bot Bbar).mpr (by
    intro h
    exact hπb (zpowers_eq_bot.mp h))
  have hBQ : Bbar ≤ coreActionKernel D :=
    (zpowers_le.mpr hbcentral).trans (centralizer_le_coreActionKernel D)
  obtain ⟨M, P, hMP, hset⟩ := Set.ncard_eq_two.mp (show (markedComponents S T H).ncard = 2 from hHtwo)
  have hM : M ∈ markedComponents S T H := by rw [hset]; simp
  have hP : P ∈ markedComponents S T H := by rw [hset]; simp
  let A := (M.subgroupOf H).map π
  let A' := (P.subgroupOf H).map π
  obtain ⟨hA, -, hZA⟩ := markedComponent_image_simple_and_center hM
  obtain ⟨hA', -, hZA'⟩ := markedComponent_image_simple_and_center hP
  have hne : A ≠ A' := fun h => hMP (Sol76T13.R12.eq_of_image_eq hM.1 hP.1 h)
  have hDAB : D = A ⊔ A' := by
    change ((markedLayer S T H).subgroupOf H).map π = A ⊔ A'
    rw [markedLayer, hset, sSup_pair, Subgroup.subgroupOf_sup hM.1.1 hP.1.1, Subgroup.map_sup]
  have hObar : pPrimeCore 2 Hbar = ⊥ := pPrimeCore_quotient_eq_bot (p := 2) Nat.prime_two
  have hEvenImage := even_card_coreActionKernel_inf_generalizedFitting hObar hDnormal
    hA hA' hne hZA hZA' hDAB hBnt hBQ
  have hKernelImage : ((baseKernel S T H).subgroupOf H).map π =
      Subgroup.centralizer (D : Set Hbar) ⊓ generalizedFitting Hbar :=
    image_baseKernel_eq_centralizer_inf_generalizedFitting hDHH hDHnormal
  have hEvenMap : Even (Nat.card (((baseKernel S T H).subgroupOf H).map π)) := by
    rw [hKernelImage, ← coreActionKernel_eq_centralizer_of_pPrimeCore_eq_bot hObar hDnormal]
    exact hEvenImage
  have hdiv := Subgroup.card_map_dvd ((baseKernel S T H).subgroupOf H) π
  have htwo : 2 ∣ Nat.card ((baseKernel S T H).subgroupOf H) :=
    dvd_trans (even_iff_two_dvd.mp hEvenMap) hdiv
  have hcard : Nat.card ((baseKernel S T H).subgroupOf H) = Nat.card (baseKernel S T H) :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe (baseKernel_le S T H)).toEquiv
  exact even_iff_two_dvd.mpr (hcard ▸ htwo)

theorem count_eq_and_markedLayer_eq_of_first_maximum_of_oddCore_covers [IsSimpleGroup T]
    {N H : Subgroup G} (hFam : IsomorphicFamily S T) (hN : Balanced S T N)
    (hbase : base N ≤ H)
    (hLift : ∀ K ∈ markedComponents S T N, ∃ J ∈ markedComponents S T H,
      K ⊔ oddCoreIn J = J)
    (hmax : ∀ X : Subgroup G, Balanced S T X → markedCount S T X ≤ markedCount S T N) :
    markedCount S T H = markedCount S T N ∧
      markedLayer S T H = oddCoreIn (markedLayer S T H) ⊔ markedLayer S T N := by
  have hH := balanced_of_oddCore_covers hFam hN hbase hLift
  have heq := le_antisymm (hmax H hH) (markedCount_le_of_oddCore_covers hbase hLift)
  exact ⟨heq, markedLayer_eq_sup_oddCore_of_oddCore_covers_of_count_eq hbase hLift heq⟩

theorem exists_marked_oddCore_cover_of_count_eq {N H J : Subgroup G}
    (hbase : base N ≤ H)
    (hLift : ∀ K ∈ markedComponents S T N, ∃ L ∈ markedComponents S T H,
      K ⊔ oddCoreIn L = L)
    (hcount : markedCount S T H = markedCount S T N)
    (hJ : J ∈ markedComponents S T H) :
    ∃ K ∈ markedComponents S T N, K ⊔ oddCoreIn J = J := by
  classical
  have : Finite (Subgroup G) :=
    Finite.of_injective (fun K : Subgroup G => (K : Set G)) SetLike.coe_injective
  obtain ⟨f, hf⟩ := exists_markedComponents_embedding_of_oddCore_covers hbase hLift
  have hcard : Nat.card {K : Subgroup G // K ∈ markedComponents S T N} =
      Nat.card {J : Subgroup G // J ∈ markedComponents S T H} := by
    simpa only [Nat.card_coe_set_eq, markedCount] using hcount.symm
  obtain ⟨e⟩ := Finite.card_eq.mp hcard
  have hsurj : Function.Surjective f :=
    (Finite.injective_iff_surjective_of_equiv e).mp f.injective
  obtain ⟨K, hK⟩ := hsurj ⟨J, hJ⟩
  refine ⟨K.val, K.property, ?_⟩
  have hval : (f K).val = J := congrArg Subtype.val hK
  rw [← hval]
  exact hf K

theorem all_pure_containment_of_count_eq_and_oddCore_covers {N H : Subgroup G}
    (hbase : base N ≤ H)
    (hLift : ∀ K ∈ markedComponents S T N, ∃ J ∈ markedComponents S T H,
      K ⊔ oddCoreIn J = J)
    (hcount : markedCount S T H = markedCount S T N)
    (hN : ∀ K ∈ markedComponents S T N, ∀ t ∈ K, orderOf t = 2 →
      oddCoreOfCentralizer t ≤ H ∧ base (centralizer ({t} : Set G)) ≤ H) :
    ∀ J ∈ markedComponents S T H, ∀ t ∈ J, orderOf t = 2 →
      oddCoreOfCentralizer t ≤ H ∧ base (centralizer ({t} : Set G)) ≤ H := by
  intro J hJ
  obtain ⟨K, hK, hcover⟩ := exists_marked_oddCore_cover_of_count_eq hbase hLift hcount hJ
  exact all_pure_containment_of_oddCore_cover (le_sup_left.trans hcover.le)
    hcover (markedComponents_subset S T H hJ).1 (hN K hK)

theorem all_pure_containment_of_first_maximum_of_oddCore_covers [IsSimpleGroup T]
    {N H : Subgroup G} (hFam : IsomorphicFamily S T) (hN : Balanced S T N)
    (hbase : base N ≤ H)
    (hLift : ∀ K ∈ markedComponents S T N, ∃ J ∈ markedComponents S T H,
      K ⊔ oddCoreIn J = J)
    (hmax : ∀ X : Subgroup G, Balanced S T X → markedCount S T X ≤ markedCount S T N)
    (hOld : ∀ K ∈ markedComponents S T N, ∀ t ∈ K, orderOf t = 2 →
      oddCoreOfCentralizer t ≤ H ∧ base (centralizer ({t} : Set G)) ≤ H) :
    ∀ J ∈ markedComponents S T H, ∀ t ∈ J, orderOf t = 2 →
      oddCoreOfCentralizer t ≤ H ∧ base (centralizer ({t} : Set G)) ≤ H := by
  obtain ⟨hcount, _⟩ := count_eq_and_markedLayer_eq_of_first_maximum_of_oddCore_covers
    hFam hN hbase hLift hmax
  exact all_pure_containment_of_count_eq_and_oddCore_covers hbase hLift hcount hOld

