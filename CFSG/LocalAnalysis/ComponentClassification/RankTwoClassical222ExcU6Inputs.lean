@[expose] def badState (forbid : List ℕ) (cur : List (Equiv.Perm (Fin 693))) : Bool :=
  cur.any (fun g => !schreierPermEq (g * g) 1) ||
    cur.any (fun g => cur.any fun h => !schreierPermEq (g * h) (h * g)) ||
    (List.range (2 ^ cur.length)).any fun m =>
      let p := tab (maskProd cur m)
      !schreierPermEq p 1 && forbid.contains (fixCount p)

@[expose] def derivCheck (forbid : List ℕ) :
    List (Equiv.Perm (Fin 693)) → List (ℕ × List ℤ × ℕ) → Bool
  | cur, [] => badState forbid cur
  | cur, (m, w, i) :: rest =>
    badState forbid cur ||
      (let p := tab (maskProd cur m)
       let c := tab (evalCodes alphabet w)
       let c2 := tab (c * c)
       !schreierPermEq p 1 && schreierPermEq (c * p) (p * c) && decide (i < cur.length) &&
         derivCheck forbid (cur ++ [tab (c2 * cur.getD i 1 * c2⁻¹)]) rest)

