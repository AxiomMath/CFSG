variable {G : Type} [Group G] [Finite G]

private theorem oddCore_quotient_eq_bot (H : Subgroup G) :
    pPrimeCore 2 (↥H ⧸ pPrimeCore 2 ↥H) = ⊥ := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact CFSG.pPrimeCore_quotient_pPrimeCore_eq_bot 2

theorem isComponent_image_of_relativeIdentity {T : Type} [Group T] {𝓢 : Set (Subgroup G)}
    (hFam : FooteMarked.IsomorphicFamily 𝓢 T) {H M : Subgroup G}
    (hHbal : FooteMarked.Balanced 𝓢 T H) (hM : FooteMarked.Marked 𝓢 T M) (hMH : M ≤ H)
    {a : ↥H} (ha : orderOf a = 2) (haM : (a : G) ∈ UnbalancedLayer.coreActionKernel M)
    {A : Subgroup (↥H ⧸ pPrimeCore 2 ↥H)}
    (hAdef : A = ((FooteMarked.fixedShadowAt M a).subgroupOf H).map
      (QuotientGroup.mk' (pPrimeCore 2 ↥H)))
    (hAa : A ≤ centralizer ({QuotientGroup.mk' (pPrimeCore 2 ↥H) a} : Set (↥H ⧸ pPrimeCore 2 ↥H)))
    (hA : IsComponent (A.subgroupOf
      (centralizer ({QuotientGroup.mk' (pPrimeCore 2 ↥H) a} : Set (↥H ⧸ pPrimeCore 2 ↥H)))))
    (hRI : ∀ (b : ↥H ⧸ pPrimeCore 2 ↥H) (K : Subgroup (↥H ⧸ pPrimeCore 2 ↥H)),
      GrSLit.GSWeakCorr (QuotientGroup.mk' (pPrimeCore 2 ↥H) a) A b K → K = A) :
    IsComponent A ∧ (M.subgroupOf H).map (QuotientGroup.mk' (pPrimeCore 2 ↥H)) = A := by
  classical
  set π := QuotientGroup.mk' (pPrimeCore 2 ↥H) with hπ
  set 𝒦 : Set (Subgroup (↥H ⧸ pPrimeCore 2 ↥H)) :=
    (fun K : Subgroup G => (K.subgroupOf H).map π) '' FooteMarked.markedComponents 𝓢 T H
    with h𝒦def
  have h𝒦 : ∀ Y ∈ 𝒦, IsComponent Y := by
    rintro Y ⟨K, hK, rfl⟩
    exact FooteMarked.isComponent_map_of_isTwoComponentIn hK.1
  have h𝒦a : ∀ Y ∈ 𝒦, Y.map (MulAut.conj (π a)).toMonoidHom ∈ 𝒦 := by
    rintro Y ⟨K, hK, rfl⟩
    refine ⟨CFSG.conjugate K (a : G),
      ⟨⟨FooteMarked.conjugate_le_of_mem hK.1.1 a.2,
        FooteMarked.isPComponent_conjugate_subgroupOf a.2 hK.1.2⟩,
        FooteMarked.Marked.conjugate hFam hK.2 a⟩, ?_⟩
    exact FooteMarked.map_conjugate_subgroupOf_eq hK.1.1 ha
  have hcard : 𝒦.ncard = FooteMarked.markedCount 𝓢 T H := by
    rw [FooteMarked.markedCount]
    exact (Set.ncard_image_iff (Set.toFinite _)).mpr
      ((FooteMarked.injOn_map_of_isTwoComponentIn H).mono fun K hK => hK.1)
  have h2 : 2 ≤ 𝒦.ncard := hcard ▸ hHbal.1
  have hbal : 3 ≤ 𝒦.ncard ∨ ∃ Q : Subgroup (↥H ⧸ pPrimeCore 2 ↥H), Even (Nat.card Q) ∧
      π a ∈ normalizer (Q : Set (↥H ⧸ pPrimeCore 2 ↥H)) ∧
      ∀ Y ∈ 𝒦, Q ≤ centralizer (Y : Set (↥H ⧸ pPrimeCore 2 ↥H)) := by
    rcases hHbal.2 with h3 | hev
    · exact Or.inl (hcard ▸ h3)
    · refine Or.inr ⟨((FooteMarked.baseKernel 𝓢 T H).subgroupOf H).map π,
        FooteMarked.even_card_map_quotient (FooteMarked.baseKernel_le 𝓢 T H) hev,
        FooteMarked.mk_mem_normalizer_map (FooteMarked.baseKernel_le 𝓢 T H)
          (FooteMarked.mem_normalizer_baseKernel hFam a.2), ?_⟩
      rintro Y ⟨K, hK, rfl⟩
      exact FooteMarked.map_baseKernel_le_centralizer hFam hK
  have hAc : IsComponent A :=
    isComponent_of_relativeIdentity (oddCore_quotient_eq_bot H) (FooteMarked.orderOf_mk_eq_two ha)
      hAa hA hRI h𝒦 h𝒦a h2 hbal
  refine ⟨hAc, ?_⟩
  subst hAdef
  exact FooteMarked.map_eq_map_fixedShadowAt hFam hM hMH ha haM hAc

theorem le_ambientCanonicalLift_of_isPerfect {H M : Subgroup G}
    {A : Subgroup (↥H ⧸ pPrimeCore 2 ↥H)}
    (hM : Group.IsPerfect ↥M) (hMH : M ≤ H)
    (hMA : (M.subgroupOf H).map (QuotientGroup.mk' (pPrimeCore 2 ↥H)) ≤ A) :
    M ≤ FooteMarked.ambientCanonicalLift H A := by
  have hP : Group.IsPerfect ↥(M.subgroupOf H) :=
    Group.IsPerfect.ofSurjective (f := (Subgroup.subgroupOfEquivOfLe hMH).symm.toMonoidHom)
      (Subgroup.subgroupOfEquivOfLe hMH).symm.surjective
  have h := GSThmB.HConfig.le_canonicalPrimeLift_of_isPerfect A hP
    (Subgroup.map_le_iff_le_comap.mp hMA)
  intro x hx
  exact ⟨⟨x, hMH hx⟩, h (show (⟨x, hMH hx⟩ : ↥H) ∈ M.subgroupOf H from hx), rfl⟩

end Assembly

theorem footeMarkedAbsorption_of_relative (hRI : FooteMarkedRelativeIdentity)
    (hRL : FooteMarkedRelativeLift) : FooteMarkedAbsorption := by
  intro G _ _ t L 𝓢 hset H M hH hHbal hM hMH ⟨a, haH, ha2, haM⟩
  have ha : orderOf (⟨a, haH⟩ : ↥H) = 2 := by rw [Subgroup.orderOf_mk]; exact ha2
  obtain ⟨hAa, hA, hP, -, -⟩ := hRL G t L 𝓢 hset H M hH hM hMH ⟨a, haH⟩ ha haM
  obtain ⟨hAc, hMA⟩ := isComponent_image_of_relativeIdentity hset.2.2.2.2.1 hHbal hM hMH ha haM
    rfl hAa hA (hRI G t L 𝓢 hset H hH _ _ hAa hA hP)
  have hJ : FooteMarked.canonicalPerfectLift H (relativeShadow H M a) =
      FooteMarked.ambientCanonicalLift H (relativeShadow H M a) :=
    FooteMarked.canonicalPerfectLift_eq_ambientCanonicalLift hAc
  refine ⟨FooteMarked.canonicalPerfectLift H (relativeShadow H M a), ⟨?_, hP⟩, ?_⟩
  · rw [hJ]
    exact FooteMarked.ambientCanonicalLift_isTwoComponentIn hAc
  · rw [hJ]
    exact le_ambientCanonicalLift_of_isPerfect hM.1 hMH hMA.le

theorem footeMarkedRelativeLift_holds
    : FooteMarkedRelativeLift := by
  intro G _ _ t L 𝓢 hset H M hH hM hMH a ha haQ
  have hKProper : CFSG.Assembly.KProper CFSG.Blueprint.Catalog G :=
    hset.2.1.1.1
  have hFam : FooteMarked.IsomorphicFamily 𝓢 (L ⧸ Open.fusionZStar L) :=
    hset.2.2.2.2.1
  haveI : IsSimpleGroup (L ⧸ Open.fusionZStar L) :=
    (GrSLit.fusionZStar_quotient_of_isPComponent hset.2.1.1.2.2.1.2.1
      hset.2.1.1.2.2.1.2.2).1
  have hS : CFSG.LocalAnalysis.ComponentInitial.SchreierFor CFSG.Blueprint.Catalog :=
    CFSG.RankThree.PartOne.SPOR.schreierFor_catalog
  have hU : CFSG.ComponentClassification.CatalogueU.CatalogAlmostSimpleUnbalancedOutcome :=
    CFSG.ComponentClassification.FooteLit.catalogAlmostSimpleUnbalancedOutcome_holds
  have hheld : CFSG.ComponentClassification.KProperRelativeB.HeldInput :=
    CFSG.ComponentClassification.KProperRelativeB.heldInput
  have haG : orderOf (a : G) = 2 := (Subgroup.orderOf_coe a).trans ha
  have hRL := CFSG.ComponentClassification.FooteMarked.relative_lift_of_localB_proper_H
    (S := 𝓢) (T := L ⧸ Open.fusionZStar L) (a := (a : G))
    hS hU hheld hKProper hH hFam hM hMH haG a.property haQ
  obtain ⟨-, hAa, hA, hP, hcent, hodd⟩ := hRL
  exact ⟨hAa, hA, hP, hcent, hodd⟩

end CFSG.ComponentClassification.FooteLit
