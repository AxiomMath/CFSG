namespace CFSG.ComponentClassification.FooteLit

open CFSG Subgroup

@[expose] noncomputable def relativeShadow {G : Type} [Group G] (H M : Subgroup G) (a : G) :
    Subgroup (↥H ⧸ pPrimeCore 2 ↥H) :=
  ((FooteMarked.fixedShadowAt M a).subgroupOf H).map (QuotientGroup.mk' (pPrimeCore 2 ↥H))

@[expose] def FooteMarkedRelativeIdentity : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (t : G) (L : Subgroup G) (𝓢 : Set (Subgroup G)),
    FooteSwapSetting G t L 𝓢 →
    ∀ H : Subgroup G, H ≠ ⊤ →
    ∀ (a : ↥H ⧸ pPrimeCore 2 ↥H) (A : Subgroup (↥H ⧸ pPrimeCore 2 ↥H)),
      A ≤ centralizer ({a} : Set (↥H ⧸ pPrimeCore 2 ↥H)) →
      IsComponent (A.subgroupOf (centralizer ({a} : Set (↥H ⧸ pPrimeCore 2 ↥H)))) →
      FooteMarked.Marked 𝓢 (L ⧸ Open.fusionZStar L) (FooteMarked.canonicalPerfectLift H A) →
      ∀ (b : ↥H ⧸ pPrimeCore 2 ↥H) (K : Subgroup (↥H ⧸ pPrimeCore 2 ↥H)),
        GrSLit.GSWeakCorr a A b K → K = A

@[expose] def FooteMarkedRelativeLift : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (t : G) (L : Subgroup G) (𝓢 : Set (Subgroup G)),
    FooteSwapSetting G t L 𝓢 →
    ∀ H M : Subgroup G, H ≠ ⊤ → FooteMarked.Marked 𝓢 (L ⧸ Open.fusionZStar L) M → M ≤ H →
    ∀ a : ↥H, orderOf a = 2 → (a : G) ∈ UnbalancedLayer.coreActionKernel M →
      relativeShadow H M a ≤
          centralizer ({QuotientGroup.mk' (pPrimeCore 2 ↥H) a} : Set (↥H ⧸ pPrimeCore 2 ↥H)) ∧
        IsComponent ((relativeShadow H M a).subgroupOf
          (centralizer ({QuotientGroup.mk' (pPrimeCore 2 ↥H) a} : Set (↥H ⧸ pPrimeCore 2 ↥H)))) ∧
        FooteMarked.Marked 𝓢 (L ⧸ Open.fusionZStar L)
          (FooteMarked.canonicalPerfectLift H (relativeShadow H M a)) ∧
        Nonempty (↥(relativeShadow H M a) ⧸ center ↥(relativeShadow H M a) ≃*
          L ⧸ Open.fusionZStar L) ∧
        Odd (Nat.card (center ↥(relativeShadow H M a)))

section Core

variable {B : Type} [Group B] [Finite B]

theorem isComponent_of_relativeIdentity (hO : pPrimeCore 2 B = ⊥) {a : B} (ha : orderOf a = 2)
    {A : Subgroup B} (hAa : A ≤ centralizer ({a} : Set B))
    (hA : IsComponent (A.subgroupOf (centralizer ({a} : Set B))))
    (hRI : ∀ (b : B) (K : Subgroup B), GrSLit.GSWeakCorr a A b K → K = A)
    {𝒦 : Set (Subgroup B)} (h𝒦 : ∀ Y ∈ 𝒦, IsComponent Y)
    (h𝒦a : ∀ Y ∈ 𝒦, Y.map (MulAut.conj a).toMonoidHom ∈ 𝒦) (h2 : 2 ≤ 𝒦.ncard)
    (hbal : 3 ≤ 𝒦.ncard ∨ ∃ Q : Subgroup B, Even (Nat.card Q) ∧
      a ∈ normalizer (Q : Set B) ∧ ∀ Y ∈ 𝒦, Q ≤ centralizer (Y : Set B)) :
    IsComponent A := by
  have ha2 : a ^ 2 = 1 := by rw [← ha]; exact pow_orderOf_eq_one a
  have hAE : A ≤ layer B := SeitzReduction.isComponent_centralizer_le_layer hO ha2 hAa hA
  obtain ⟨K, hK, -, hAK, -, -, -, -⟩ :=
    SeitzReduction.exists_isComponent_orbit_of_le_layer ha2 hAa hA hAE
  set σ : B →* B := (MulAut.conj a).toMonoidHom with hσ
  have hKa : IsComponent (K.map σ) := FooteMarked.isComponent_map_conj hK a
  obtain ⟨Q, hQe, haQ, hQK, hQKa⟩ : ∃ Q : Subgroup B, Even (Nat.card Q) ∧
      a ∈ normalizer (Q : Set B) ∧ Q ≤ centralizer (K : Set B) ∧
      Q ≤ centralizer ((K.map σ : Subgroup B) : Set B) := by
    by_cases hout : ∃ Y ∈ 𝒦, Y ≠ K ∧ Y ≠ K.map σ
    ·
      obtain ⟨Y, hY, hYK, hYKa⟩ := hout
      have hYc : IsComponent Y := h𝒦 Y hY
      have hYac : IsComponent (Y.map σ) := h𝒦 _ (h𝒦a Y hY)
      have hYaK : Y.map σ ≠ K := by
        intro h
        apply hYKa
        rw [← h, hσ, FooteMarked.map_conj_map_conj_of_orderOf_eq_two ha]
      have hYaKa : Y.map σ ≠ K.map σ := by
        intro h
        apply hYK
        rw [← FooteMarked.map_conj_map_conj_of_orderOf_eq_two ha Y, ← hσ, h, hσ,
          FooteMarked.map_conj_map_conj_of_orderOf_eq_two ha]
      refine ⟨Y ⊔ Y.map σ, ?_, ?_, ?_, ?_⟩
      · obtain ⟨k, hk⟩ := (FooteMarked.even_card_of_isComponent hYc).two_dvd
        exact even_iff_two_dvd.mpr
          ((Dvd.intro k hk.symm).trans (Subgroup.card_dvd_of_le le_sup_left))
      · apply AS76b.mem_normalizer_of_map_conj_eq
        rw [Subgroup.map_sup, hσ, FooteMarked.map_conj_map_conj_of_orderOf_eq_two ha, sup_comm]
      · exact sup_le (FooteMarked.le_centralizer_of_isComponent_of_ne hYc hK hYK)
          (FooteMarked.le_centralizer_of_isComponent_of_ne hYac hK hYaK)
      · exact sup_le (FooteMarked.le_centralizer_of_isComponent_of_ne hYc hKa hYKa)
          (FooteMarked.le_centralizer_of_isComponent_of_ne hYac hKa hYaKa)
    ·
      push Not at hout
      have hsub : 𝒦 ⊆ {K, K.map σ} := by
        intro Y hY
        by_cases h : Y = K
        · exact Or.inl h
        · exact Or.inr (hout Y hY h)
      obtain ⟨hle, hmem⟩ := FooteMarked.ncard_le_two_of_subset_pair hsub
      rcases hbal with h3 | ⟨Q, hQe, haQ, hQ⟩
      · omega
      · exact ⟨Q, hQe, haQ, hQ K (hmem h2).1, hQ _ (hmem h2).2⟩
  obtain ⟨b, hbQ, hb, hab⟩ := FooteMarked.exists_involution_commute_of_even ha hQe haQ
  have hbK : K ≤ centralizer ({b} : Set B) := by
    intro x hx
    rw [mem_centralizer_singleton_iff]
    exact mem_centralizer_iff.mp (hQK hbQ) x hx
  have hbKa : K.map σ ≤ centralizer ({b} : Set B) := by
    intro x hx
    rw [mem_centralizer_singleton_iff]
    exact mem_centralizer_iff.mp (hQKa hbQ) x hx
  have hbA : A ≤ centralizer ({b} : Set B) := hAK.trans (sup_le hbK hbKa)
  have hcorr : GrSLit.GSWeakCorr a A b K := by
    refine ⟨ha, hb, hab, hAa, LocalAnalysis.ComponentInitial.isPComponent_two_of_isComponent hA,
      hbK, FooteMarked.isPComponent_subgroupOf_of_isComponent hK hbK, ?_, ?_, ?_⟩
    · refine Subgroup.centralizer_le_normalizer (A : Set B) (mem_centralizer_iff.mpr ?_)
      intro x hx
      exact mem_centralizer_singleton_iff.mp (hbA hx)
    · intro j hj
      have hjb : j * b = b * j := mem_centralizer_singleton_iff.mp (hbA hj)
      have h1 : j⁻¹ * b⁻¹ * j * b = 1 := by
        rw [mul_assoc, hjb]; group
      rw [h1]
      exact one_mem _
    · refine (UnbalancedGS.gsFixedLayer_le_inf A b).trans (inf_le_left.trans ?_)
      rw [GSGrammar.conjugate_eq_map_conj ha K]
      exact hAK
  rw [← hRI b K hcorr]
  exact hK

