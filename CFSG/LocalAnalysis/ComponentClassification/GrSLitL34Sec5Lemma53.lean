instance fusionZStar_characteristic' (A : Type*) [Group A] :
    (Open.fusionZStar A).Characteristic := by
  constructor
  intro φ
  ext z
  simp only [mem_comap, MulEquiv.coe_toMonoidHom]
  have hO : ∀ x : A, φ x ∈ pPrimeCore 2 A ↔ x ∈ pPrimeCore 2 A := by
    intro x
    have h := (Subgroup.characteristic_iff_comap_eq.mp
      (pPrimeCore_characteristic (p := 2) (G := A))) φ
    have h' := SetLike.ext_iff.mp h x
    rw [mem_comap, MulEquiv.coe_toMonoidHom] at h'
    exact h'
  rw [GSThmB.OddQuot.mem_fusionZStar_iff, GSThmB.OddQuot.mem_fusionZStar_iff]
  constructor
  · intro h m
    have := h (φ m)
    rwa [← map_commutatorElement, hO] at this
  · intro h m
    obtain ⟨m', rfl⟩ := φ.surjective m
    rw [← map_commutatorElement, hO]
    exact h m'

omit [Finite G] in
theorem zStarIn_le_coreActionKernel (L : Subgroup G) : zStarIn L ≤ coreActionKernel L := by
  rintro _ ⟨z, hz, rfl⟩
  refine mem_coreActionKernel.mpr ⟨le_normalizer z.2, fun j hj => ?_⟩
  have h := inv_mem ((GSThmB.OddQuot.mem_fusionZStar_iff.mp (inv_mem hz)) ⟨j, hj⟩⁻¹)
  refine ⟨_, h, ?_⟩
  simp only [commutatorElement_def, coe_subtype, coe_mul, coe_inv, inv_inv, mul_inv_rev]
  group

omit [Finite G] in
theorem inf_coreActionKernel_le_zStarIn (L : Subgroup G) :
    L ⊓ coreActionKernel L ≤ zStarIn L := by
  intro g hg
  obtain ⟨hgL, hgK⟩ := mem_inf.mp hg
  refine ⟨⟨g, hgL⟩, GSThmB.OddQuot.mem_fusionZStar_iff.mpr fun m => ?_, rfl⟩
  have h1 := (mem_coreActionKernel.mp hgK).2 (m⁻¹ : L) (m⁻¹).2
  obtain ⟨y, hy, hyeq⟩ := h1
  have hy' : (y : G) = (m : G) * g⁻¹ * (m : G)⁻¹ * g := by
    have : (y : G) = ((m⁻¹ : L) : G)⁻¹ * g⁻¹ * ((m⁻¹ : L) : G) * g := hyeq
    rw [this]
    simp
  have h2 := (pPrimeCore_normal (p := 2) (G := L)).conj_mem y hy ⟨g, hgL⟩
  convert h2 using 1
  apply Subtype.ext
  simp only [commutatorElement_def, coe_mul, coe_inv]
  rw [hy']
  group

omit [Finite G] in
theorem inf_centralizer_le_zStarIn' (L : Subgroup G) :
    L ⊓ centralizer (L : Set G) ≤ zStarIn L := by
  intro g hg
  obtain ⟨hgL, hgC⟩ := mem_inf.mp hg
  refine ⟨⟨g, hgL⟩, GSThmB.OddQuot.mem_fusionZStar_iff.mpr fun m => ?_, rfl⟩
  have h : ⁅(⟨g, hgL⟩ : L), m⁆ = 1 := by
    rw [commutatorElement_eq_one_iff_mul_comm]
    exact Subtype.ext ((mem_centralizer_iff.mp hgC) m m.2).symm
  rw [h]
  exact one_mem _

theorem l34Lemma53_of_inputs (hS : SchreierFor Blueprint.Catalog)
    (hU : CatalogueU.CatalogAlmostSimpleUnbalancedOutcome) (hheld : KProperRelativeB.HeldInput)
    (hSol : SolomonCommutingCoreInput) (hGW : GorensteinWalterConnectedInput) :
    L34Lemma53 := by
  intro G _ _ L t S T hset u huS hu huK huL
  obtain ⟨-, hLt, hLpt⟩ := eq_of_mem_inf_centralizer hS hU hheld hSol hGW hset
  have hZS := mem_center_of_setting hS hU hheld hSol hGW hset
  obtain ⟨-, hfam, -, hSyl, -, -, -⟩ := hset
  obtain ⟨⟨-, -, -, -, -, hto, -, -⟩, htype, -, hX, hW8'⟩ := hfam
  have huN : u ∈ normalizer (L : Set G) := hSyl.1 huS
  have hu2 : u * u = 1 := by rw [← pow_two, ← hu, pow_orderOf_eq_one]
  have ht2 : t * t = 1 := by rw [← pow_two, ← hto, pow_orderOf_eq_one]
  have htL : t ∈ centralizer (L : Set G) := mem_centralizer_iff.mpr fun l hl =>
    mem_centralizer_singleton_iff.mp (hLt hl)
  have htK : t ∈ coreActionKernel L := by
    refine mem_coreActionKernel.mpr ⟨mem_normalizer_of_commute fun l hl =>
      ((mem_centralizer_iff.mp htL) l hl).symm, fun j hj => ?_⟩
    rw [show j⁻¹ * t⁻¹ * j * t = 1 by
      have h := (mem_centralizer_iff.mp htL) j hj
      rw [mul_assoc, mul_assoc, ← mul_assoc t⁻¹, ← mul_assoc j⁻¹, show j⁻¹ * (t⁻¹ * j) * t =
        j⁻¹ * (t⁻¹ * (j * t)) by group, h]
      group]
    exact one_mem _
  have hut : u * t = t * u := hZS u huS
  have h1 : oddIn L ⊓ centralizer ({u} : Set G) ≠ ⊥ := by
    intro hbot
    have hinv := conj_eq_inv_of_inf_centralizer_eq_bot (normalizer_le_normalizer_oddIn L huN)
      hu2 hbot
    exact huK (mem_coreActionKernel_of_inverts hLt hLpt hX huN hinv)
  refine ⟨h1, ?_⟩
  by_contra hall
  push Not at hall
  have hall₁ := hall u (Set.mem_insert u _)
  have hall₂ := hall (u * t) (Set.mem_insert_of_mem u rfl)
  have htLc : ∀ y ∈ L, t * y = y * t := fun y hy => ((mem_centralizer_iff.mp htL) y hy).symm
  obtain ⟨i, l, hlL, hul⟩ := mem_zpowers_sup htLc (show u ∈ zpowers t ⊔ L by
    rw [sup_comm]; exact huL)
  have hti : t ^ i = 1 ∨ t ^ i = t :=
    (LocalB.mem_zpowers_iff_of_involution t (t ^ i) hto).mp (zpow_mem (mem_zpowers t) i)
  have hlu : l = u ∨ l = t * u := by
    rcases hti with h | h
    · left; rw [hul, h, one_mul]
    · right; rw [hul, h, ← mul_assoc, ht2, one_mul]
  have hl2 : l * l = 1 := by
    rcases hlu with rfl | rfl
    · exact hu2
    · calc t * u * (t * u) = t * (u * t) * u := by group
        _ = t * (t * u) * u := by rw [hut]
        _ = (t * t) * (u * u) := by group
        _ = 1 := by rw [ht2, hu2, one_mul]
  have hlZ : l ∉ zStarIn L := by
    intro hlZ
    have hlK := zStarIn_le_coreActionKernel L hlZ
    apply huK
    rcases hlu with rfl | rfl
    · exact hlK
    · have : u = t⁻¹ * (t * u) := by group
      rw [this]
      exact mul_mem (inv_mem htK) hlK
  have hlt : l * t = t * l := ((mem_centralizer_iff.mp htL) l hlL)
  have hZL : ∀ y ∈ L, y ∈ centralizer (L : Set G) → y ∈ zStarIn L := fun y hy hyC =>
    inf_centralizer_le_zStarIn' L (mem_inf.mpr ⟨hy, hyC⟩)
  obtain ⟨w, hwL, hw2, hwl, hwZ, hlwZ⟩ := exists_commuting_involution htype hlL hl2 hlZ
  have hlnt : l ∉ zpowers t := by
    intro hm
    rcases (LocalB.mem_zpowers_iff_of_involution t l hto).mp hm with h | h
    · exact hlZ (h ▸ one_mem _)
    · exact hlZ (hZL l hlL (h ▸ htL))
  obtain ⟨hB, hBc⟩ := elemTwo_zpowers_sup hl2 (isElemTwo_zpowers ht2)
    (fun y hy => by
      obtain ⟨j, rfl⟩ := mem_zpowers_iff.mp hy
      exact (Commute.zpow_right hlt j).eq) hlnt
  have hwB : ∀ y ∈ zpowers l ⊔ zpowers t, w * y = y * w := by
    intro y hy
    have hle : zpowers l ⊔ zpowers t ≤ centralizer ({w} : Set G) := sup_le
      (zpowers_le.mpr (mem_centralizer_singleton_iff.mpr hwl.symm))
      (zpowers_le.mpr (mem_centralizer_singleton_iff.mpr ((mem_centralizer_iff.mp htL) w hwL).symm))
    exact (mem_centralizer_singleton_iff.mp (hle hy)).symm
  have hwn : w ∉ zpowers l ⊔ zpowers t := by
    intro hm
    obtain ⟨a, h, hh, hwah⟩ := mem_zpowers_sup (fun y hy => by
      obtain ⟨j, rfl⟩ := mem_zpowers_iff.mp hy
      exact (Commute.zpow_right hlt j).eq) hm
    have hhL : h ∈ L := by
      have : h = (l ^ a)⁻¹ * w := by rw [hwah]; group
      rw [this]
      exact mul_mem (inv_mem (zpow_mem hlL a)) hwL
    have hhZ : h ∈ zStarIn L := hZL h hhL ((zpowers_le.mpr htL) hh)
    rcases (LocalB.mem_zpowers_iff_of_involution l (l ^ a) (orderOf_eq_prime
      (by rw [pow_two, hl2]) (fun h1 => hlZ (h1 ▸ one_mem _)))).mp
      (zpow_mem (mem_zpowers l) a) with h1 | h1
    · exact hwZ (by rw [hwah, h1, one_mul]; exact hhZ)
    · exact hlwZ (by rw [hwah, h1, ← mul_assoc, inv_mul_cancel, one_mul]; exact hhZ)
  obtain ⟨hA, hAc⟩ := elemTwo_zpowers_sup hw2 hB hwB hwn
  have hAL : zpowers w ⊔ (zpowers l ⊔ zpowers t) ≤ L ⊔ zpowers t :=
    sup_le (zpowers_le.mpr (mem_sup_left hwL))
      (sup_le (zpowers_le.mpr (mem_sup_left hlL)) le_sup_right)
  have hWA : wGroup (zpowers w ⊔ (zpowers l ⊔ zpowers t)) = ⊥ :=
    hW8' _ ⟨hA, by rw [hAc, hBc, Nat.card_zpowers, hto]⟩ (Or.inl hAL)
  have huB : u ∈ zpowers l ⊔ zpowers t := by
    rcases hlu with rfl | rfl
    · exact mem_sup_left (mem_zpowers _)
    · have h := mul_mem (mem_sup_right (inv_mem (mem_zpowers t)) : t⁻¹ ∈ zpowers (t * u) ⊔
        zpowers t) (mem_sup_left (mem_zpowers (t * u)))
      simpa only [inv_mul_cancel_left] using h
  have hUT : zpowers u ⊔ zpowers t ≤ zpowers w ⊔ (zpowers l ⊔ zpowers t) :=
    (sup_le (zpowers_le.mpr huB) le_sup_right).trans le_sup_right
  have hWUT : wGroup (zpowers u ⊔ zpowers t) = ⊥ :=
    le_bot_iff.mp (hWA ▸ wGroup_mono hUT)
  have hunt : u ∉ zpowers t := by
    intro hm
    rcases (LocalB.mem_zpowers_iff_of_involution t u hto).mp hm with h | h
    · exact huK (h ▸ one_mem _)
    · exact huK (h ▸ htK)
  obtain ⟨hUTe, hUTc⟩ := elemTwo_zpowers_sup hu2 (isElemTwo_zpowers ht2)
    (fun y hy => by
      obtain ⟨j, rfl⟩ := mem_zpowers_iff.mp hy
      exact (Commute.zpow_right hut j).eq) hunt
  have hXt : oddIn L ≤ oddIn (centralizer ({t} : Set G)) :=
    GSLit.map_pPrimeCore_le_of_isPComponent hLt hLpt
  have hCX : oddIn L ⊓ centralizer ({u} : Set G) ≤
      ⨅ (b : G) (_ : b ∈ zpowers u ⊔ zpowers t) (_ : b ≠ 1),
        (pPrimeCore 2 (centralizer ({b} : Set G))).map (centralizer ({b} : Set G)).subtype := by
    intro x hx
    obtain ⟨hxX, hxu⟩ := mem_inf.mp hx
    simp only [mem_iInf]
    intro b hb hb1
    obtain ⟨a, h, hh, hbah⟩ := mem_zpowers_sup (fun y hy => by
      obtain ⟨j, rfl⟩ := mem_zpowers_iff.mp hy
      exact (Commute.zpow_right hut j).eq) hb
    have hua := (LocalB.mem_zpowers_iff_of_involution u (u ^ a) hu).mp (zpow_mem (mem_zpowers u) a)
    have hth := (LocalB.mem_zpowers_iff_of_involution t h hto).mp hh
    have hxt : x ∈ centralizer ({t} : Set G) :=
      mem_centralizer_singleton_iff.mpr ((mem_centralizer_iff.mp htL) x
        (map_subtype_le _ hxX))
    rcases hua with h1 | h1 <;> rcases hth with h2 | h2 <;> rw [hbah, h1, h2] at hb1 ⊢
    · exact absurd (one_mul (1 : G)) hb1
    · rw [one_mul]
      exact hXt hxX
    · rw [mul_one]
      exact hall₁ hx
    · have hxut : x ∈ oddIn L ⊓ centralizer ({u * t} : Set G) := by
        refine mem_inf.mpr ⟨hxX, mem_centralizer_singleton_iff.mpr ?_⟩
        have hxu' := mem_centralizer_singleton_iff.mp hxu
        have hxt' := mem_centralizer_singleton_iff.mp hxt
        calc x * (u * t) = (x * u) * t := by group
          _ = u * x * t := by rw [hxu']
          _ = u * (x * t) := by group
          _ = u * (t * x) := by rw [hxt']
          _ = u * t * x := by group
      exact hall₂ hxut
  have hΔW : (⨅ (b : G) (_ : b ∈ zpowers u ⊔ zpowers t) (_ : b ≠ 1),
      (pPrimeCore 2 (centralizer ({b} : Set G))).map (centralizer ({b} : Set G)).subtype) ≤
      wGroup (zpowers u ⊔ zpowers t) := by
    refine le_trans ?_ (le_iSup _ (zpowers u ⊔ zpowers t))
    refine le_trans ?_ (le_iSup _ le_rfl)
    refine le_trans ?_ (le_iSup _ (by rw [hUTc, Nat.card_zpowers, hto]))
    exact le_iSup (fun _ : ∀ b ∈ zpowers u ⊔ zpowers t, b * b = 1 => _) hUTe.2
  exact h1 (le_bot_iff.mp (hWUT ▸ hCX.trans hΔW))

theorem exists_involution_not_mem_zStarIn {L : Subgroup G}
    (h : IsL34Type (↥L ⧸ Open.fusionZStar ↥L)) : ∃ l ∈ L, l * l = 1 ∧ l ∉ zStarIn L := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨π, hπ, hker, h3⟩ := exists_quotient_psl34 h
  obtain ⟨Y, hYK, -, y₁, hy₁, -, -, h₁, -, hne₁, -, -⟩ :=
    exists_four_of_central hπ hker.le h3
  obtain ⟨w, -, hw2, hfw⟩ := exists_involution_lift (⊤ : Subgroup ↥L)
    (by rw [map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]; exact mem_top y₁) h₁
  refine ⟨w, w.2, congrArg Subtype.val hw2, ?_⟩
  rintro ⟨w', hw', hww'⟩
  have : w' = w := Subtype.ext hww'
  subst this
  apply hne₁
  have hc : QuotientGroup.mk' (pPrimeCore 2 ↥L) w' ∈ center (↥L ⧸ pPrimeCore 2 ↥L) := by
    rw [Sol78.fusionZStar_eq_comap] at hw'
    exact hw'
  rw [hfw] at hc
  have hm : y₁ ∈ Y ⊓ π.ker := Subgroup.mem_inf.mpr ⟨hy₁, hker ▸ hc⟩
  rw [hYK] at hm
  exact mem_bot.mp hm

theorem l34UnbalancingSetNonempty_of_inputs (hS : SchreierFor Blueprint.Catalog)
    (hU : CatalogueU.CatalogAlmostSimpleUnbalancedOutcome) (hheld : KProperRelativeB.HeldInput)
    (hSol : SolomonCommutingCoreInput) (hGW : GorensteinWalterConnectedInput) :
    L34UnbalancingSetNonempty := by
  intro G _ _ L t S T hset
  have h53 := l34Lemma53_of_inputs hS hU hheld hSol hGW G L t S T hset
  have hZS := mem_center_of_setting hS hU hheld hSol hGW hset
  obtain ⟨-, hLt, -⟩ := eq_of_mem_inf_centralizer hS hU hheld hSol hGW hset
  obtain ⟨-, hfam, -, hSyl, htS, -, -⟩ := hset
  obtain ⟨⟨-, -, -, -, -, hto, -, -⟩, htype, -, -, -⟩ := hfam
  obtain ⟨l₀, hl₀L, hl₀2, hl₀Z⟩ := exists_involution_not_mem_zStarIn htype
  have hl₀N : l₀ ∈ normalizer (L : Set G) := le_normalizer hl₀L
  have hl₀1 : l₀ ≠ 1 := fun h1 => hl₀Z (h1 ▸ one_mem _)
  have hl₀o : orderOf l₀ = 2 := orderOf_eq_prime (by rw [pow_two, hl₀2]) hl₀1
  have hl₀p : IsPGroup 2 (zpowers l₀) := by
    apply IsPGroup.of_card (n := 1)
    rw [Nat.card_zpowers, hl₀o, pow_one]
  obtain ⟨n, hn, huS⟩ := exists_conj_mem_of_isSylowTwoIn hSyl hl₀N hl₀p
  set u := n⁻¹ * l₀ * n with hudef
  have huL : u ∈ L := (mem_normalizer_iff.mp (inv_mem hn) l₀).mp hl₀L |> fun h => by
    simpa [hudef] using h
  have hu : orderOf u = 2 := by rw [hudef, GSLit.orderOf_conj_inv, hl₀o]
  have huZ : u ∉ zStarIn L := by
    intro hZ
    apply hl₀Z
    have hZN := normalizer_le_normalizer_map_of_characteristic L (Open.fusionZStar L) hn
    have h1 := (mem_normalizer_iff.mp hZN u).mp hZ
    have e : n * u * n⁻¹ = l₀ := by rw [hudef]; group
    rw [e] at h1
    exact h1
  have huK : u ∉ coreActionKernel L := fun hK =>
    huZ (inf_coreActionKernel_le_zStarIn L (mem_inf.mpr ⟨huL, hK⟩))
  have htL : t ∈ centralizer (L : Set G) := mem_centralizer_iff.mpr fun l hl =>
    mem_centralizer_singleton_iff.mp (hLt hl)
  obtain ⟨-, u₁, hu₁, hu₁X⟩ := h53 u huS hu huK (mem_sup_left huL)
  refine ⟨u₁, ?_, ?_, hu₁X⟩
  · rcases hu₁ with rfl | rfl
    · exact mem_sup_left (mem_inf.mpr ⟨huS, huL⟩)
    · exact mul_mem (mem_sup_left (mem_inf.mpr ⟨huS, huL⟩)) (mem_sup_right (mem_zpowers t))
  · rcases hu₁ with rfl | rfl
    · exact hu
    · have hu2 : u * u = 1 := by rw [← pow_two, ← hu, pow_orderOf_eq_one]
      have ht2 : t * t = 1 := by rw [← pow_two, ← hto, pow_orderOf_eq_one]
      have hut : u * t = t * u := hZS u huS
      apply orderOf_eq_prime
      · rw [pow_two]
        calc u * t * (u * t) = u * (t * u) * t := by group
          _ = u * (u * t) * t := by rw [hut]
          _ = (u * u) * (t * t) := by group
          _ = 1 := by rw [hu2, ht2, one_mul]
      · intro h1
        have : u = t⁻¹ := eq_inv_of_mul_eq_one_left h1
        apply huK
        rw [this]
        refine inv_mem (mem_coreActionKernel.mpr ⟨mem_normalizer_of_commute fun l hl =>
          ((mem_centralizer_iff.mp htL) l hl).symm, fun j hj => ?_⟩)
        have h := (mem_centralizer_iff.mp htL) j hj
        rw [show j⁻¹ * t⁻¹ * j * t = 1 by
          rw [show j⁻¹ * t⁻¹ * j * t = j⁻¹ * t⁻¹ * (j * t) by group, h]
          group]
        exact one_mem _

end CFSG.ComponentClassification.GrSLit.GrS5
