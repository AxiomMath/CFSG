section Facts

theorem d4LeviFacts :
    D4LeviFacts := by
  intro m hm K _ _ hK σ hσq z t hz ht
  have : CharP K 2 := charP_two_of_card_d4 hK
  have hσ3' := sigma_cube_of_card_d4 σ hK hσq
  obtain ⟨hLz, hPz⟩ := d4_leviData_z σ m hm hK hσq
  obtain ⟨hLt, hPt, hnt⟩ := d4_leviData_t σ m hm hK hσq
  refine ⟨⟨_, _, _, _, _, d4_centreData_z σ hσ3' hz, hLz, d4_autFix_z σ m hm hK hσq,
    d4_d0Data_z σ m hm hK hσq hz, hPz, ?_⟩, ⟨_, _, _, _, _, d4_centreData_t σ hσ3' ht, hLt,
      d4_autFix_t σ m hm hK hσq, d4_d0Data_t σ m hm hK hσq ht, hPt, hnt⟩⟩
  rintro rfl
  exact d4_diag_z σ hK hσq

end Facts

