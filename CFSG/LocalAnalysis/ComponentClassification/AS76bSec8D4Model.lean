theorem step814_trialityD4
    (h32 : Lemma32) (h33 : Lemma33Three) (h4 : Asc75Theorem4) : Step814 .trialityD4 := by
  intro G _ _ A D hD hA hZA
  cases D with
  | triality m hm K hK σ' hσ' e =>
    have : CharP K 2 := charP_two_of_card_d4 hK
    have h34 : Asc08Lemma34 := asc08Lemma34
    have hAp : commutator ↥A = ⊤ := hA.standard.1.1
    set σ : K ≃+* K := RingEquiv.ofBijective σ' (Finite.injective_iff_bijective.1 σ'.injective)
      with hσdef
    have hσq : ∀ c, σ c = c ^ 2 ^ m := hσ'
    have hσ3 := toRingHom_pow_three_d4 σ (sigma_cube_of_card_d4 σ hK hσq)
    obtain ⟨-, -, -, -, -, -, hZC, ⟨E⟩⟩ :=
      even_triality_exact_automorphism_normal_form hm K hK σ hσq
    have : Finite (ModGL TwistTag.D4.tag K) := finite_modGL
    have : Finite ↥(d4C K σ) := Subtype.finite
    let e' : rankTwoQuot A ≃* ↥(d4C K σ) := e.trans E
    have hDm : ChevalleyExceptionalModel (rankTwoQuot A) .trialityD4 2 m :=
      ⟨⟨Nat.prime_two, hm, rfl⟩, K, inferInstance, inferInstance, hK, σ', hσ', ⟨e⟩⟩
    have hOut := odd_card_commutator_outer_of_quot hAp (odd_card_commutator_outer_trialityD4 hDm)
    have hz : d4z K ∈ d4C K σ := (d4x_long_mem σ (map_one σ)).2.2
    have ht : d4t K σ ∈ d4C K σ := (d4x_short_mem σ hσ3 1).2.2
    obtain ⟨hcover, hzc, htc⟩ := d4ClassFacts m hm K hK σ hσq ⟨_, hz⟩ ⟨_, ht⟩ rfl rfl
    refine exists_config814_of_classes h32 h33 h4 h34 _ hA hZA hZC e' hOut (2 ^ m) rfl
      (reps := [⟨_, hz⟩, ⟨_, ht⟩]) hcover ?_ ?_ ?_
    · intro x hx
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl
      · exact hzc
      · exact htc
    · intro hq2 x hx
      have hm2 : 2 ≤ m := by
        by_contra h
        have h1 : 2 ^ m ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) (by omega)
        omega
      obtain ⟨⟨Z, Dl, Q, H, L, hC, hL, hAF, hD0, hP, hdiag⟩,
        ⟨Z', Dl', Q', H', L', hC', hL', hAF', hD0', hP', hnot⟩⟩ :=
          d4LeviFacts m hm2 K hK σ hσq ⟨_, hz⟩ ⟨_, ht⟩ rfl rfl
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl
      · exact ⟨Z, Dl, Q, H, L, hC, ⟨hL, hAF, fun L₀ ⟨f⟩ => Or.inl (statedPSL_of_mulEquiv f hP),
          fun h4 _ => hdiag h4⟩, hD0⟩
      · exact ⟨Z', Dl', Q', H', L', hC', ⟨hL', hAF',
          fun L₀ ⟨f⟩ => Or.inr (statedPSL_of_mulEquiv f hP'),
            fun h4 hP3 => absurd hP3 (hnot h4)⟩, hD0'⟩
    · intro _
      rw [center_eq_bot_of_d4 hm hK σ hσq hAp hZA e', Subgroup.card_bot]
      exact Nat.coprime_one_right 3
  | g2 => simp [ExcModel.tag] at hD
  | f4 => simp [ExcModel.tag] at hD
  | e6 => simp [ExcModel.tag] at hD
  | e7 => simp [ExcModel.tag] at hD
  | e8 => simp [ExcModel.tag] at hD
  | twistedE6 => simp [ExcModel.tag] at hD
  | ree => simp [ExcModel.tag] at hD
  | tits => simp [ExcModel.tag] at hD

end Step

