open CFSG Subgroup CFSG.ComponentClassification.UnbalancedLayer
  CFSG.ComponentClassification.UnbalancedCorr CFSG.ComponentClassification.UnbalancedGS

@[expose] def L34NoSquareRootFact : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (J P : Subgroup G), ⁅J, J⁆ = J →
    IsL34Type (J ⧸ Open.fusionZStar J) → IsSylowTwoIn P J →
    IsCyclic ↥(P ⊓ zStarIn J) → Nat.card ↥(P ⊓ zStarIn J) = 4 →
    ∀ u ∈ P, u * u ∈ zStarIn J → u ^ 4 = 1

@[expose] def L34Lemma47ConnectStep : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (a x : G) (J S A : Subgroup G), L34Sec4Setting G a x J S →
    L34Sec4Running J A → IsCyclic ↥(S ⊓ zStarIn J) → Nat.card ↥(S ⊓ zStarIn J) = 4 →
    ∀ y ∈ S ⊓ coreActionKernel J, y * y = 1 → y ∉ zStarIn J →
      IsThreeConnected (S ⊓ withKernel J)

end CFSG.ComponentClassification.GrSLit
