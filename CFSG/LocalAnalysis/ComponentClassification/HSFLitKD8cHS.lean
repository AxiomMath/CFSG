@[expose] def codeT {i : Fin 2} (x : T22h i) : ℕ := 256 * (bif x.e then 1 else 0) + codeMC x.a

@[expose] def decBits {i : Fin 2} (x : T22h i) : List Bool :=
  (List.range 9).map fun n => (tget (decTab i) 9 (codeT x)).testBit n

theorem nf_gh : ∀ i : Fin 2, ∀ x : T22h i, x = nfProd (ghList i) (decBits x) := by
  decide +kernel

theorem closure_gh (i : Fin 2) : Subgroup.closure ({gh i 0, gh i 1, gh i 2, gh i 3, gh i 4,
    gh i 5, gh i 6, gh i 7, gh i 8} : Set (T22h i)) = ⊤ := by
  rw [eq_top_iff]
  intro x _
  rw [nf_gh i x]
  refine nfProd_mem_closure (ghList i) ?_ _
  fin_cases i <;> simp [ghList, gh]

