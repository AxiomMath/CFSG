    have h2 := map_mono (f := (centralizer ({t} : Set ↥Ce)).subtype) h1
    rw [map_subgroupOf_eq_of_le hTC] at h2
    have hza : IsPGroup 2 (zpowers t) := IsPGroup.of_card (n := 1) (by
