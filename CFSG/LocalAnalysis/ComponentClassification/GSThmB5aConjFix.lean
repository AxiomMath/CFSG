theorem conj_mem_coreActionKernel_conjugate [Finite G] {J : Subgroup G} {k : G}
    (hk : k ∈ coreActionKernel J) (g : G) : g⁻¹ * k * g ∈ coreActionKernel (conjugate J g) := by
  obtain ⟨hkN, hkJ⟩ := mem_coreActionKernel.mp hk
  have hφ : ¬ 2 ∣ Nat.card ((MulAut.conj g⁻¹).toMonoidHom).ker := by
    rw [(MonoidHom.ker_eq_bot_iff _).mpr (MulAut.conj g⁻¹).injective, card_bot]
    omega
  have hO := OddQuot.map_oddCoreIn _ hφ J
  refine mem_coreActionKernel.mpr ⟨?_, fun j hj => ?_⟩
  · rw [mem_normalizer_iff]
    intro y
    rw [mem_conjugate_iff, mem_conjugate_iff,
      show g * (g⁻¹ * k * g * y * (g⁻¹ * k * g)⁻¹) * g⁻¹ = k * (g * y * g⁻¹) * k⁻¹ by group]
    exact mem_normalizer_iff.mp hkN _
  · have hj' : g * j * g⁻¹ ∈ J := mem_conjugate_iff.mp hj
    have h1 := hkJ _ hj'
    have h2 : g⁻¹ * ((g * j * g⁻¹)⁻¹ * k⁻¹ * (g * j * g⁻¹) * k) * g ∈
        (oddCoreIn J).map (MulAut.conj g⁻¹).toMonoidHom := by
      refine ⟨_, h1, ?_⟩
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv]
    rw [hO] at h2
    rw [show j⁻¹ * (g⁻¹ * k * g)⁻¹ * j * (g⁻¹ * k * g) =
      g⁻¹ * ((g * j * g⁻¹)⁻¹ * k⁻¹ * (g * j * g⁻¹) * k) * g by group]
    exact h2

theorem inf_oddCoreIn_le_of_le [Finite G] {X Y : Subgroup G} (hXY : X ≤ Y) :
    X ⊓ oddCoreIn Y ≤ oddCoreIn X := by
  intro z ⟨hzX, hzO⟩
  have hn : ((oddCoreIn Y).subgroupOf X).Normal := by
    rw [normal_subgroupOf_iff_le_normalizer_inf]
    intro w hw
    rw [mem_normalizer_iff]
    intro v
    rw [mem_inf, mem_inf]
    constructor
    · rintro ⟨hvO, hvX⟩
      refine ⟨?_, mul_mem (mul_mem hw hvX) (inv_mem hw)⟩
      obtain ⟨u, hu, rfl⟩ := mem_map.mp hvO
      refine mem_map.mpr ⟨⟨w, hXY hw⟩ * u * ⟨w, hXY hw⟩⁻¹, ?_, rfl⟩
      have : (pPrimeCore 2 Y).Normal := inferInstance
      exact this.conj_mem u hu _
    · rintro ⟨hvO, hvX⟩
      have hvX' : v ∈ X := by
        have := mul_mem (mul_mem (inv_mem hw) hvX) hw
        rwa [show w⁻¹ * (w * v * w⁻¹) * w = v by group] at this
      refine ⟨?_, hvX'⟩
      obtain ⟨u, hu, hu'⟩ := mem_map.mp hvO
      refine mem_map.mpr ⟨⟨w, hXY hw⟩⁻¹ * u * ⟨w, hXY hw⟩⁻¹⁻¹, ?_, ?_⟩
      · have : (pPrimeCore 2 Y).Normal := inferInstance
        exact this.conj_mem u hu _
      · change w⁻¹ * (u : G) * w⁻¹⁻¹ = v
        have hu'' : (u : G) = w * v * w⁻¹ := hu'
        rw [hu'']
        group
  have hcop : Nat.Coprime 2 (Nat.card ((oddCoreIn Y).subgroupOf X)) := by
    refine Nat.Coprime.coprime_dvd_right ?_ (pPrimeCore_coprime_card (p := 2) (G := Y))
    rw [show Nat.card ((oddCoreIn Y).subgroupOf X) = Nat.card ↥(oddCoreIn Y ⊓ X) by
      rw [← inf_subgroupOf_right]
      exact Nat.card_congr (subgroupOfEquivOfLe inf_le_right).toEquiv]
    rw [show Nat.card (pPrimeCore 2 Y) = Nat.card (oddCoreIn Y) from
      (Nat.card_congr ((pPrimeCore 2 Y).equivMapOfInjective _ Y.subtype_injective).toEquiv)]
    exact Subgroup.card_dvd_of_le inf_le_left
  have hle : (oddCoreIn Y).subgroupOf X ≤ pPrimeCore 2 X := le_sSup ⟨hn, hcop⟩
  have h1 : (⟨z, hzX⟩ : X) ∈ (oddCoreIn Y).subgroupOf X := hzO
  exact mem_map.mpr ⟨_, hle h1, rfl⟩

theorem oddCoreIn_le_of_le_normalizer [Finite G] {X Y : Subgroup G} (hXY : X ≤ Y)
    (hYN : Y ≤ normalizer (X : Set G)) : oddCoreIn X ≤ oddCoreIn Y := by
  have hchar : ∀ y ∈ Y, conjugate (oddCoreIn X) y = oddCoreIn X := by
    intro y hy
    have hφ : ¬ 2 ∣ Nat.card ((MulAut.conj y⁻¹).toMonoidHom).ker := by
      rw [(MonoidHom.ker_eq_bot_iff _).mpr (MulAut.conj y⁻¹).injective, card_bot]
      omega
    have h1 := OddQuot.map_oddCoreIn _ hφ X
    change (oddCoreIn X).map (MulAut.conj y⁻¹).toMonoidHom = oddCoreIn X
    rw [h1]
    congr 1
    exact conjugate_eq_of_mem_normalizer (hYN hy)
  have hOY : oddCoreIn X ≤ Y := (map_subtype_le _).trans hXY
  have hn : ((oddCoreIn X).subgroupOf Y).Normal :=
    (normal_subgroupOf_iff_le_normalizer hOY).mpr fun y hy =>
      mem_normalizer_of_conjugate_eq (hchar y hy)
  have hcop : Nat.Coprime 2 (Nat.card ((oddCoreIn X).subgroupOf Y)) := by
    rw [show Nat.card ((oddCoreIn X).subgroupOf Y) = Nat.card (pPrimeCore 2 X) by
      rw [Nat.card_congr (subgroupOfEquivOfLe hOY).toEquiv]
      exact (Nat.card_congr
        ((pPrimeCore 2 X).equivMapOfInjective _ X.subtype_injective).toEquiv).symm]
    exact pPrimeCore_coprime_card
  have hle : (oddCoreIn X).subgroupOf Y ≤ pPrimeCore 2 Y := le_sSup ⟨hn, hcop⟩
  intro z hz
  exact mem_map.mpr ⟨⟨z, hOY hz⟩, hle hz, rfl⟩

theorem sup_oddCoreIn_eq_iff [Finite G] {X L : Subgroup G} (hXL : X ≤ L) :
    X ⊔ oddCoreIn L = L ↔ X.subgroupOf L ⊔ pPrimeCore 2 L = ⊤ := by
  have hmap : (X.subgroupOf L ⊔ pPrimeCore 2 L).map L.subtype = X ⊔ oddCoreIn L := by
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hXL]
    rfl
  constructor
  · intro h
    apply map_injective L.subtype_injective
    rw [hmap, h, ← MonoidHom.range_eq_map, range_subtype]
  · intro h
    rw [← hmap, h, ← MonoidHom.range_eq_map, range_subtype]

theorem card_quotient_le_of_sup [Finite G] {X L : Subgroup G} (hXL : X ≤ L)
    (hsup : X ⊔ oddCoreIn L = L) :
    Nat.card (L ⧸ pPrimeCore 2 L) ≤ Nat.card (X ⧸ pPrimeCore 2 X) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set X' := X.subgroupOf L
  set π := QuotientGroup.mk' (pPrimeCore 2 L)
  set f : ↥X' →* L ⧸ pPrimeCore 2 L := π.comp X'.subtype
  have hf : Function.Surjective f := by
    have h1 := (sup_oddCoreIn_eq_iff hXL).mp hsup
    intro q
    obtain ⟨l, rfl⟩ := QuotientGroup.mk'_surjective _ q
    have hl : l ∈ X' ⊔ pPrimeCore 2 L := h1 ▸ mem_top l
    have h2 : π l ∈ (X' ⊔ pPrimeCore 2 L).map π := mem_map_of_mem π hl
    rw [Subgroup.map_sup, QuotientGroup.map_mk'_self, sup_bot_eq] at h2
    obtain ⟨x, hx, hxl⟩ := mem_map.mp h2
    exact ⟨⟨x, hx⟩, hxl⟩
  have hker : pPrimeCore 2 X' ≤ f.ker := by
    have h1 := map_pPrimeCore_le (p := 2) f hf
    rw [pPrimeCore_quotient_pPrimeCore_eq_bot, le_bot_iff, Subgroup.map_eq_bot_iff] at h1
    exact h1
  let f' : ↥X' ⧸ pPrimeCore 2 X' →* L ⧸ pPrimeCore 2 L := QuotientGroup.lift _ f hker
  have hf' : Function.Surjective f' := QuotientGroup.lift_surjective_of_surjective _ _ hf _
  have h1 := Nat.card_le_card_of_surjective f' hf'
  have e : ↥X' ⧸ pPrimeCore 2 X' ≃* X ⧸ pPrimeCore 2 X :=
    UnbalancingLocal.Correspondence.quotientPPrimeCoreCongr 2 (subgroupOfEquivOfLe hXL)
  rwa [Nat.card_congr e.toEquiv] at h1

theorem sup_oddCoreIn_eq_of_card [Finite G] {X L : Subgroup G} (hXL : X ≤ L)
    (hinf : X ⊓ oddCoreIn L ≤ oddCoreIn X)
    (hcard : Nat.card (L ⧸ pPrimeCore 2 L) ≤ Nat.card (X ⧸ pPrimeCore 2 X)) :
    X ⊔ oddCoreIn L = L := by
  rw [sup_oddCoreIn_eq_iff hXL]
  set X' := X.subgroupOf L
  set π := QuotientGroup.mk' (pPrimeCore 2 L)
  set f : ↥X' →* L ⧸ pPrimeCore 2 L := π.comp X'.subtype
  have hker : f.ker ≤ pPrimeCore 2 X' := by
    intro x hx
    have hx1 : ((x : L) : G) ∈ X ⊓ oddCoreIn L := by
      refine mem_inf.mpr ⟨x.2, ?_⟩
      have h2 : π (x : L) = 1 := hx
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h2
      exact mem_map_of_mem L.subtype h2
    obtain ⟨y, hy, hyx⟩ := mem_map.mp (hinf hx1)
    let e : ↥X' ≃* ↥X := subgroupOfEquivOfLe hXL
    have h3 := pPrimeCore_map_iso 2 e.symm
    have h4 : e.symm y ∈ (pPrimeCore 2 ↥X).map e.symm.toMonoidHom := mem_map_of_mem _ hy
    rw [h3] at h4
    have h5 : e.symm y = x := by
      apply e.injective
      rw [MulEquiv.apply_symm_apply]
      apply Subtype.ext
      show (y : G) = ((e x : X) : G)
      rw [show ((e x : X) : G) = ((x : L) : G) from rfl]
      exact hyx
    rwa [h5] at h4
  have hrange : Nat.card (L ⧸ pPrimeCore 2 L) ≤ Nat.card f.range := by
    have h1 := Subgroup.card_ker_mul_card_range f
    have h2 := Subgroup.card_eq_card_quotient_mul_card_subgroup (pPrimeCore 2 X')
    have h3 : Nat.card f.ker ≤ Nat.card (pPrimeCore 2 X') := Subgroup.card_le_of_le hker
    have h4 : Nat.card (X ⧸ pPrimeCore 2 X) = Nat.card (↥X' ⧸ pPrimeCore 2 X') :=
      Nat.card_congr (UnbalancingLocal.Correspondence.quotientPPrimeCoreCongr 2
        (subgroupOfEquivOfLe hXL)).symm.toEquiv
    have h5 : 0 < Nat.card (pPrimeCore 2 X') := Nat.card_pos
    have h6 : Nat.card (↥X' ⧸ pPrimeCore 2 X') ≤ Nat.card f.range := by
      by_contra hlt
      push Not at hlt
      have := Nat.mul_lt_mul_of_le_of_lt h3 hlt Nat.card_pos
      rw [h1, h2, mul_comm] at this
      exact lt_irrefl _ this
    omega
  have htop : f.range = ⊤ := Subgroup.eq_top_of_le_card _ hrange
  rw [eq_top_iff]
  intro l _
  have hl : π l ∈ f.range := htop ▸ mem_top _
  obtain ⟨x, hx⟩ := hl
  have h1 : (x : L)⁻¹ * l ∈ pPrimeCore 2 L := by
    rw [← QuotientGroup.ker_mk' (pPrimeCore 2 L), MonoidHom.mem_ker, map_mul, map_inv]
    change (π (x : L))⁻¹ * π l = 1
    rw [show π (x : L) = f x from rfl, hx, inv_mul_cancel]
  have h2 := mul_mem (mem_sup_left (S := X') x.2) (mem_sup_right (T := pPrimeCore 2 L) h1)
  rwa [mul_inv_cancel_left] at h2

theorem card_quotient_eq_of_sup [Finite G] {X L : Subgroup G} (hXL : X ≤ L)
    (hsup : X ⊔ oddCoreIn L = L) (hcore : oddCoreIn X = X ⊓ oddCoreIn L) :
    Nat.card (X ⧸ pPrimeCore 2 X) = Nat.card (L ⧸ pPrimeCore 2 L) := by
  refine le_antisymm ?_ (card_quotient_le_of_sup hXL hsup)
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set X' := X.subgroupOf L
  set π := QuotientGroup.mk' (pPrimeCore 2 L)
  set f : ↥X' →* L ⧸ pPrimeCore 2 L := π.comp X'.subtype
  have hker : f.ker ≤ pPrimeCore 2 X' := by
    intro x hx
    have hx1 : ((x : L) : G) ∈ X ⊓ oddCoreIn L := by
      refine mem_inf.mpr ⟨x.2, ?_⟩
      have h2 : π (x : L) = 1 := hx
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h2
      exact mem_map_of_mem L.subtype h2
    rw [← hcore] at hx1
    obtain ⟨y, hy, hyx⟩ := mem_map.mp hx1
    let e : ↥X' ≃* ↥X := subgroupOfEquivOfLe hXL
    have h3 := pPrimeCore_map_iso 2 e.symm
    have h4 : e.symm y ∈ (pPrimeCore 2 ↥X).map e.symm.toMonoidHom := mem_map_of_mem _ hy
    rw [h3] at h4
    have h5 : e.symm y = x := by
      apply e.injective
      rw [MulEquiv.apply_symm_apply]
      apply Subtype.ext
      show (y : G) = ((e x : X) : G)
      rw [show ((e x : X) : G) = ((x : L) : G) from rfl]
      exact hyx
    rwa [h5] at h4
  have hker' : pPrimeCore 2 X' ≤ f.ker := by
    intro x hx
    have h1 : ((x : L) : G) ∈ oddCoreIn X := by
      let e : ↥X' ≃* ↥X := subgroupOfEquivOfLe hXL
      have h3 := pPrimeCore_map_iso 2 e
      have h4 : e x ∈ (pPrimeCore 2 ↥X').map e.toMonoidHom := mem_map_of_mem _ hx
      rw [h3] at h4
      exact mem_map.mpr ⟨_, h4, rfl⟩
    rw [hcore] at h1
    obtain ⟨y, hy, hyx⟩ := mem_map.mp (mem_inf.mp h1).2
    show π (x : L) = 1
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    have : y = (x : L) := Subtype.ext hyx
    rwa [← this]
  let f' : ↥X' ⧸ pPrimeCore 2 X' →* L ⧸ pPrimeCore 2 L := QuotientGroup.lift _ f hker'
  have hf' : Function.Injective f' := by
    rw [injective_iff_map_eq_one]
    intro q hq
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective _ q
    exact (QuotientGroup.eq_one_iff x).mpr (hker hq)
  have h1 := Nat.card_le_card_of_injective f' hf'
  have e : ↥X' ⧸ pPrimeCore 2 X' ≃* X ⧸ pPrimeCore 2 X :=
    UnbalancingLocal.Correspondence.quotientPPrimeCoreCongr 2 (subgroupOfEquivOfLe hXL)
  rwa [Nat.card_congr e.toEquiv] at h1

theorem conjugate_oddCoreIn [Finite G] (X : Subgroup G) (g : G) :
    conjugate (oddCoreIn X) g = oddCoreIn (conjugate X g) := by
  have hφ : ¬ 2 ∣ Nat.card ((MulAut.conj g⁻¹).toMonoidHom).ker := by
    rw [(MonoidHom.ker_eq_bot_iff _).mpr (MulAut.conj g⁻¹).injective, card_bot]
    omega
  exact OddQuot.map_oddCoreIn _ hφ X

theorem mem_normalizer_oddCoreIn [Finite G] {X : Subgroup G} {g : G}
    (hg : g ∈ normalizer (X : Set G)) : g ∈ normalizer (oddCoreIn X : Set G) := by
  apply mem_normalizer_of_conjugate_eq
  rw [conjugate_oddCoreIn, conjugate_eq_of_mem_normalizer hg]

theorem mem_coreActionKernel_of_sup [Finite G] {X L : Subgroup G} {e : G}
    (heN : e ∈ normalizer (L : Set G)) (hXL : X ≤ L) (hsup : X ⊔ oddCoreIn L = L)
    (hX : ∀ t ∈ X, t⁻¹ * e⁻¹ * t * e ∈ oddCoreIn L) : e ∈ coreActionKernel L := by
  have heO := mem_normalizer_oddCoreIn heN
  have hLO : ∀ l ∈ L, l ∈ normalizer (oddCoreIn L : Set G) := fun l hl =>
    mem_normalizer_oddCoreIn (le_normalizer hl)
  let Z : Subgroup G :=
    { carrier := {l | l ∈ L ∧ l⁻¹ * e⁻¹ * l * e ∈ oddCoreIn L}
      one_mem' := ⟨one_mem _, by simp⟩
      mul_mem' := by
        rintro l₁ l₂ ⟨hl₁, hc₁⟩ ⟨hl₂, hc₂⟩
        refine ⟨mul_mem hl₁ hl₂, ?_⟩
        have h1 : l₂⁻¹ * (l₁⁻¹ * e⁻¹ * l₁ * e) * l₂ ∈ oddCoreIn L := by
          have := (mem_normalizer_iff.mp (hLO _ (inv_mem hl₂)) _).mp hc₁
          rwa [inv_inv] at this
        have h2 := mul_mem h1 hc₂
        rwa [show l₂⁻¹ * (l₁⁻¹ * e⁻¹ * l₁ * e) * l₂ * (l₂⁻¹ * e⁻¹ * l₂ * e) =
          (l₁ * l₂)⁻¹ * e⁻¹ * (l₁ * l₂) * e by group] at h2
      inv_mem' := by
        rintro l ⟨hl, hc⟩
        refine ⟨inv_mem hl, ?_⟩
        have h1 := (mem_normalizer_iff.mp (hLO _ hl) _).mp (inv_mem hc)
        rwa [show l * (l⁻¹ * e⁻¹ * l * e)⁻¹ * l⁻¹ = l⁻¹⁻¹ * e⁻¹ * l⁻¹ * e by group] at h1 }
  have hXZ : X ≤ Z := fun t ht => ⟨hXL ht, hX t ht⟩
  have hOZ : oddCoreIn L ≤ Z := by
    intro o ho
    refine ⟨map_subtype_le _ ho, ?_⟩
    have h1 := (mem_normalizer_iff.mp (inv_mem heO) o).mp ho
    rw [inv_inv] at h1
    rw [show o⁻¹ * e⁻¹ * o * e = o⁻¹ * (e⁻¹ * o * e) by group]
    exact mul_mem (inv_mem ho) h1
  have hLZ : L ≤ Z := hsup ▸ sup_le hXZ hOZ
  exact mem_coreActionKernel.mpr ⟨heN, fun l hl => (hLZ hl).2⟩

theorem isPComponent_subgroupOf_of_le [Finite G] {L C N : Subgroup G} (hLC : L ≤ C)
    (hCN : C ≤ N) (hL : IsPComponent 2 (L.subgroupOf N)) : IsPComponent 2 (L.subgroupOf C) := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨hs, hg, hq⟩ :=
    (CatalogueBPrimeJoin.pComponent_iff_subnormal_generated_quasisimple 2 _).1 hL
  refine (CatalogueBPrimeJoin.pComponent_iff_subnormal_generated_quasisimple 2 _).2
    ⟨?_, ?_, ?_⟩
  · have h1 := hs.comap (inclusion hCN)
    have h2 : (L.subgroupOf N).comap (inclusion hCN) = L.subgroupOf C := by
      ext y
      rfl
    rwa [h2] at h1
  · let e : ↥(L.subgroupOf C) ≃* ↥(L.subgroupOf N) :=
      (subgroupOfEquivOfLe hLC).trans (subgroupOfEquivOfLe (hLC.trans hCN)).symm
    rw [← CatalogueBPrimeJoin.primeResidual_map_equiv 2 e.symm, hg]
    exact map_top_of_surjective _ e.symm.surjective
  · let e : ↥(L.subgroupOf C) ≃* ↥(L.subgroupOf N) :=
      (subgroupOfEquivOfLe hLC).trans (subgroupOfEquivOfLe (hLC.trans hCN)).symm
    exact (LocalAnalysis.ComponentInitial.isQuasisimple_congr
      (UnbalancingLocal.Correspondence.quotientPPrimeCoreCongr 2 e)).2 hq

theorem assembly_oddCore_eq (X : Type*) [Group X] : CFSG.Assembly.oddCore X = pPrimeCore 2 X := by
  unfold CFSG.Assembly.oddCore pPrimeCore
  congr 1
  ext K
  simp only [Set.mem_ofPred_eq, Nat.coprime_two_left]

theorem map_oddCoreIn_subgroupOf [Finite G] (J Y : Subgroup G) :
    ((pPrimeCore 2 ↥(Y.subgroupOf J)).map (Y.subgroupOf J).subtype).map J.subtype =
      oddCoreIn (J ⊓ Y) := by
  rw [Subgroup.map_map]
  let φ : ↥(Y.subgroupOf J) ≃* ↥(J ⊓ Y) :=
    (MulEquiv.subgroupCongr (inf_subgroupOf_left Y J).symm).trans (subgroupOfEquivOfLe inf_le_left)
  have hcomm : J.subtype.comp (Y.subgroupOf J).subtype = (J ⊓ Y).subtype.comp φ.toMonoidHom := by
    ext y
    rfl
  rw [hcomm, ← Subgroup.map_map, pPrimeCore_map_iso 2 φ]
  rfl

theorem eq_of_quasisimple_sup_odd {K : Type} [Group K] [Finite K] {X A O : Subgroup K}
    (hXq : IsQuasisimple X)
    [Group.IsPerfect A] (hAX : A ≤ X) (hOX : O ≤ X) (hOn : X ≤ normalizer (O : Set K))
    (hOodd : Odd (Nat.card O)) (hsup : A ⊔ O = X) : A = X := by
  have hn : (O.subgroupOf X).Normal := (normal_subgroupOf_iff_le_normalizer hOX).mpr hOn
  have hOc : ∀ o ∈ O, ∀ x ∈ X, o * x = x * o := by
    rcases quasisimple_normal_subgroups hXq hn with h1 | h1
    · exfalso
      have hXO : X ≤ O := fun x hx => by
        have : (⟨x, hx⟩ : X) ∈ O.subgroupOf X := h1 ▸ mem_top _
        exact this
      have hodd : Odd (Nat.card X) := by
        have h2 : Nat.card X ∣ Nat.card O := Subgroup.card_dvd_of_le hXO
        exact Odd.of_dvd_nat hOodd h2
      have hsolv : Group.IsSolvable X := CFSG.FeitThompson.isSolvable_of_odd_natCard _ hodd
      have : Nontrivial X := isQuasisimple_nontrivial hXq
      have : Group.IsPerfect X := hXq.1
      exact Group.IsPerfect.not_isSolvable (G := X) hsolv
    · intro o ho x hx
      have h2 := mem_center_iff.mp (h1 (show (⟨o, hOX ho⟩ : X) ∈ O.subgroupOf X from ho))
        ⟨x, hx⟩
      exact (congrArg Subtype.val h2).symm
  have : Group.IsPerfect X := hXq.1
  refine le_antisymm hAX ?_
  rw [← commutator_eq_self (H := X)]
  rw [Subgroup.commutator_le]
  intro x₁ hx₁ x₂ hx₂
  have hcomm : ∀ a ∈ A, ∀ o ∈ O, a * o = o * a := fun a ha o ho => (hOc o ho a (hAX ha)).symm
  rw [← hsup] at hx₁ hx₂
  obtain ⟨a₁, ha₁, o₁, ho₁, rfl⟩ := (B5a.mem_sup_iff_of_commute hcomm).mp hx₁
  obtain ⟨a₂, ha₂, o₂, ho₂, rfl⟩ := (B5a.mem_sup_iff_of_commute hcomm).mp hx₂
  rw [show a₁ * o₁ = o₁ * a₁ from hcomm a₁ ha₁ o₁ ho₁, show a₂ * o₂ = o₂ * a₂ from
    hcomm a₂ ha₂ o₂ ho₂]
  have hc1 : Commute o₁ a₁ := (hcomm a₁ ha₁ o₁ ho₁).symm
  have hc2 : Commute o₁ (o₂ * a₂) := by
    refine Commute.mul_right ?_ ((hcomm a₂ ha₂ o₁ ho₁).symm)
    exact hOc o₁ ho₁ o₂ (hOX ho₂)
  rw [commutatorElement_mul_left_of_commute hc1 hc2]
  have hc3 : Commute o₂ a₂ := (hcomm a₂ ha₂ o₂ ho₂).symm
  have hc4 : Commute o₂ a₁ := (hcomm a₁ ha₁ o₂ ho₂).symm
  rw [commutatorElement_mul_right_of_commute hc3 hc4]
  rw [commutatorElement_def]
  exact mul_mem (mul_mem (mul_mem ha₁ ha₂) (inv_mem ha₁)) (inv_mem ha₂)

theorem card_inf_sylow_of_isSubnormal [Finite G] (U : Sylow 2 G) {N : Subgroup G}
    (hN : N.IsSubnormal) :
    Nat.card ↥((U : Subgroup G) ⊓ N) = 2 ^ (Nat.card N).factorization 2 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  induction hN with
  | top =>
    rw [inf_top_eq, Subgroup.card_top]
    exact U.card_eq_multiplicity
  | step A K hAK hK hAn ih =>
    have hcardK : Nat.card (((U : Subgroup G) ⊓ K).subgroupOf K) =
        2 ^ (Nat.card K).factorization 2 := by
      rw [← ih]
      exact Nat.card_congr (subgroupOfEquivOfLe inf_le_right).toEquiv
    let P : Sylow 2 ↥K := Sylow.ofCard _ hcardK
    have := hAn
    obtain ⟨P', hP'⟩ := Glauberman.sylow_inf_normal P (N := A.subgroupOf K)
    have h1 := P'.card_eq_multiplicity
    rw [hP'] at h1
    have h3 : (P : Subgroup K) ⊓ A.subgroupOf K = ((U : Subgroup G) ⊓ A).subgroupOf K := by
      rw [Sylow.coe_ofCard]
      ext y
      simp only [mem_inf, mem_subgroupOf]
      constructor
      · rintro ⟨⟨h4, -⟩, h5⟩
        exact ⟨h4, h5⟩
      · rintro ⟨h4, h5⟩
        exact ⟨⟨h4, y.2⟩, h5⟩
    have h2 : Nat.card ((((P : Subgroup K) ⊓ A.subgroupOf K).subgroupOf (A.subgroupOf K))) =
        Nat.card ↥((U : Subgroup G) ⊓ A) := by
      rw [Nat.card_congr (subgroupOfEquivOfLe inf_le_right).toEquiv, h3]
      exact Nat.card_congr (subgroupOfEquivOfLe (inf_le_right.trans hAK)).toEquiv
    have h4 : Nat.card (A.subgroupOf K) = Nat.card A :=
      Nat.card_congr (subgroupOfEquivOfLe hAK).toEquiv
    rw [h2, h4] at h1
    exact h1

theorem inf_sylow_ne_bot_of_isSubnormal [Finite G] (U : Sylow 2 G) {N : Subgroup G}
    (hN : N.IsSubnormal) (heven : 2 ∣ Nat.card N) : (U : Subgroup G) ⊓ N ≠ ⊥ := by
  intro hbot
  have h1 := card_inf_sylow_of_isSubnormal U hN
  rw [hbot, card_bot] at h1
  have h2 : 1 ≤ (Nat.card N).factorization 2 :=
    (Nat.prime_two.pow_dvd_iff_le_factorization Nat.card_pos.ne').mp (by rwa [pow_one])
  have h3 : 2 ^ (Nat.card N).factorization 2 ≠ 1 := (Nat.one_lt_pow (by omega) one_lt_two).ne'
  exact h3 h1.symm

theorem le_coreActionKernel_of_ne [Finite G] {C K₁ K₂ : Subgroup G} (h1 : K₁ ≤ C) (h2 : K₂ ≤ C)
    (hc1 : IsPComponent 2 (K₁.subgroupOf C)) (hc2 : IsPComponent 2 (K₂.subgroupOf C))
    (hne : K₁ ≠ K₂) : K₂ ≤ coreActionKernel K₁ := by
  have hne' : K₁.subgroupOf C ≠ K₂.subgroupOf C := by
    intro heq
    rw [subgroupOf_inj, inf_of_le_left h1, inf_of_le_left h2] at heq
    exact hne heq
  obtain ⟨-, hd⟩ := CatalogueBPrimeJoin.distinct_p_components_core_commutation 2 Nat.prime_two
    _ _ hc1 hc2
  obtain ⟨hN, -, hc, -⟩ := hd hne'
  intro k hk
  have hk' : (⟨k, h2 hk⟩ : C) ∈ K₂.subgroupOf C := hk
  refine mem_coreActionKernel.mpr ⟨?_, fun j hj => ?_⟩
  · rw [mem_normalizer_iff]
    intro y
    have hkN := mem_normalizer_iff.mp (hN hk')
    constructor
    · intro hy
      exact (hkN ⟨y, h1 hy⟩).mp hy
    · intro hy
      have hyC : y ∈ C := by
        have := mul_mem (mul_mem (inv_mem (h2 hk)) (h1 hy)) (h2 hk)
        rwa [show k⁻¹ * (k * y * k⁻¹) * k = y by group] at this
      exact (hkN ⟨y, hyC⟩).mpr hy
  · have hj' : (⟨j, h1 hj⟩ : C) ∈ K₁.subgroupOf C := hj
    have h3 := hc (commutator_mem_commutator (inv_mem hj') (inv_mem hk'))
    have h4 := mem_map_of_mem C.subtype (mem_inf.mp h3).1
    rw [pPrimeCore_map_subgroupOf 2 K₁ C h1] at h4
    have h7 : C.subtype ⁅(⟨j, h1 hj⟩ : C)⁻¹, (⟨k, h2 hk⟩ : C)⁻¹⁆ = j⁻¹ * k⁻¹ * j * k := by
      simp only [commutatorElement_def, map_mul, map_inv, inv_inv]
      rfl
    rwa [h7] at h4

theorem commutator_le_oddCoreIn_of_ne [Finite G] {C K₁ K₂ : Subgroup G} (h1 : K₁ ≤ C)
    (h2 : K₂ ≤ C) (hc1 : IsPComponent 2 (K₁.subgroupOf C))
    (hc2 : IsPComponent 2 (K₂.subgroupOf C)) (hne : K₁ ≠ K₂) : ⁅K₁, K₂⁆ ≤ oddCoreIn C := by
  have hne' : K₁.subgroupOf C ≠ K₂.subgroupOf C := by
    intro heq
    rw [subgroupOf_inj, inf_of_le_left h1, inf_of_le_left h2] at heq
    exact hne heq
  obtain ⟨-, hd⟩ := CatalogueBPrimeJoin.distinct_p_components_core_commutation 2 Nat.prime_two
    _ _ hc1 hc2
  obtain ⟨-, -, hc, -⟩ := hd hne'
  obtain ⟨-, -, hs, -, -⟩ := id hc1
  have h3 : ⁅K₁.subgroupOf C, K₂.subgroupOf C⁆ ≤ pPrimeCore 2 ↥C := by
    refine hc.trans (inf_le_left.trans ?_)
    rw [UnbalancedCorr.map_pPrimeCore_eq_inf_of_isSubnormal hs]
    exact inf_le_right
  have h4 := map_mono (f := C.subtype) h3
  rwa [map_commutator, map_subgroupOf_eq_of_le h1, map_subgroupOf_eq_of_le h2] at h4

theorem eq_one_of_isPGroup_of_odd [Finite G] {S O : Subgroup G} (hS : IsPGroup 2 S)
    (hO : Odd (Nat.card O)) {z : G} (hzS : z ∈ S) (hzO : z ∈ O) : z = 1 := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨n, hn⟩ := hS.exists_card_eq
  have hco : Nat.Coprime (Nat.card S) (Nat.card O) := by
    rw [hn]
    exact Nat.Coprime.pow_left n (Nat.coprime_two_left.mpr hO)
  have h1 : z ∈ S ⊓ O := mem_inf.mpr ⟨hzS, hzO⟩
  rw [disjoint_iff.mp (Subgroup.disjoint_of_coprime_natCard hco), mem_bot] at h1
  exact h1

theorem odd_card_oddCoreIn [Finite G] (X : Subgroup G) : Odd (Nat.card (oddCoreIn X)) := by
  have h1 : Nat.card (oddCoreIn X) = Nat.card (pPrimeCore 2 X) :=
    (Nat.card_congr ((pPrimeCore 2 X).equivMapOfInjective _ X.subtype_injective).toEquiv).symm
  rw [h1]
  exact Nat.coprime_two_left.mp pPrimeCore_coprime_card

theorem two_dvd_card_of_isQuasisimple {L : Type*} [Group L] [Finite L]
    (hq : IsQuasisimple (L ⧸ pPrimeCore 2 L)) : 2 ∣ Nat.card L := by
  by_contra hodd
  have htop : pPrimeCore 2 L = ⊤ := by
    refine eq_top_iff.mpr (le_sSup ⟨inferInstance, ?_⟩)
    rw [card_top]
    exact Nat.prime_two.coprime_iff_not_dvd.mpr hodd
  have h1 : ∀ w : L, (w : L ⧸ pPrimeCore 2 L) = 1 := fun w =>
    (QuotientGroup.eq_one_iff w).mpr (htop ▸ mem_top w)
  obtain ⟨-, -, u, v, huv⟩ := hq
  obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective u
  obtain ⟨v, rfl⟩ := QuotientGroup.mk_surjective v
  obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective u
  obtain ⟨v, rfl⟩ := QuotientGroup.mk_surjective v
  rw [h1 u, h1 v] at huv
  exact huv rfl

theorem conjugate_mono {X Y : Subgroup G} (hXY : X ≤ Y) (g : G) :
    conjugate X g ≤ conjugate Y g :=
  map_mono hXY

theorem conjugate_layerIn_eq [Finite G] (X : Subgroup G) (g : G) :
    conjugate (layerIn X) g = layerIn (conjugate X g) := by
  have hker : ¬ 2 ∣ Nat.card (MulAut.conj g⁻¹).toMonoidHom.ker := by
    rw [(MonoidHom.ker_eq_bot_iff _).mpr (MulAut.conj g⁻¹).injective, card_bot]
    norm_num
  exact OddQuot.map_layerIn _ hker X

end General

