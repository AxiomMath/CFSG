theorem fusionZStar_eq_pPrimeCore {J : Type*} [Group J] (hc : center (J ⧸ pPrimeCore 2 J) = ⊥) :
    Open.fusionZStar J = pPrimeCore 2 J := by
  have hN : (pPrimeCore 2 J).Normal := pPrimeCore_normal
  ext x
  rw [GSThmB.OddQuot.mem_fusionZStar_iff]
  constructor
  · intro h
    have hx : (QuotientGroup.mk x : J ⧸ pPrimeCore 2 J) ∈ center (J ⧸ pPrimeCore 2 J) := by
      rw [mem_center_iff]
      intro y
      induction y using QuotientGroup.induction_on with
      | H y =>
        have h1 : (QuotientGroup.mk ⁅x, y⁆ : J ⧸ pPrimeCore 2 J) = 1 :=
          (QuotientGroup.eq_one_iff _).2 (h y)
        rw [commutatorElement_def] at h1
        simp only [QuotientGroup.mk_mul, QuotientGroup.mk_inv] at h1
        have h2 : (QuotientGroup.mk x : J ⧸ pPrimeCore 2 J) * QuotientGroup.mk y =
            QuotientGroup.mk y * QuotientGroup.mk x := by
          calc (QuotientGroup.mk x : J ⧸ pPrimeCore 2 J) * QuotientGroup.mk y
              = QuotientGroup.mk x * QuotientGroup.mk y * (QuotientGroup.mk x)⁻¹ *
                  (QuotientGroup.mk y)⁻¹ * (QuotientGroup.mk y * QuotientGroup.mk x) := by group
            _ = QuotientGroup.mk y * QuotientGroup.mk x := by rw [h1, one_mul]
        exact h2.symm
    rw [hc, mem_bot, QuotientGroup.eq_one_iff] at hx
    exact hx
  · intro hx m
    rw [commutatorElement_def, mul_assoc, mul_assoc]
    exact mul_mem hx (by
      rw [← mul_assoc]
      exact hN.conj_mem _ (inv_mem hx) m)

@[expose] def NoOddPSL2 (Y : Type) [Group Y] : Prop :=
  ∀ α : MulAut Y, orderOf α = 2 → α ∉ (MulAut.conj : Y →* MulAut Y).range →
    ∀ P : Subgroup (fixedSubgroup α), IsPComponent 2 P →
    ∀ p m : ℕ, p ≠ 2 → ¬ Blueprint.LieModel (P ⧸ Open.fusionZStar P) .PSL 2 p m

theorem false_of_noOddPSL2 {Y : Type} [Group Y] [Finite Y] (hY : NoOddPSL2 Y) {τ : MulAut Y}
    (hτ : orderOf τ = 2) (hτo : τ ∉ innAut Y) {J : Subgroup Y}
    (hJ : IsTwoComponentIn J (fixedPoints τ)) {p m : ℕ} (hp2 : p ≠ 2)
    (hL : Blueprint.LieModel (↥J ⧸ pPrimeCore 2 ↥J) .PSL 2 p m) : False := by
  have hJ' : IsTwoComponentIn J (fixedSubgroup τ) := hJ
  have hP := (isTwoComponentIn_iff hJ'.1).mp hJ'
  have hs := isSimpleGroup_of_lieModel_psl2 hL
  have hc : center (↥J ⧸ pPrimeCore 2 ↥J) = ⊥ :=
    (LocalCores.isQuasisimple_of_isSimpleGroup (nonabelian_of_lieModel_psl2 hL)).2
  obtain ⟨e⟩ := GrSLit.nonempty_fusionZStar_equiv_of_mulEquiv' (subgroupOfEquivOfLe hJ'.1)
  have e' := e.trans (QuotientGroup.quotientMulEquivOfEq (fusionZStar_eq_pPrimeCore hc))
  exact hY τ hτ hτo _ hP p m hp2 (GSThmB.OddQuot.lieModel_of_equiv e'.symm hL)

