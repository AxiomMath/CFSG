variable {Y : Type} [Group Y] [Finite Y] {L : Subgroup Y} {S : Type} [Group S] [Finite S]
  {π : L →* S}

omit [Finite Y] in
theorem fixedSubgroup_eq_of_conj {g : Y} {c : MulAut L}
    (hc : ∀ x : L, ((c x : L) : Y) = g * x * g⁻¹) :
    fixedSubgroup c = (L ⊓ centralizer ({g} : Set Y)).subgroupOf L := by
  ext x
  rw [LocalAnalysis.ComponentInitial.mem_fixedSubgroup_iff, mem_subgroupOf, mem_inf,
    mem_centralizer_singleton_iff]
  constructor
  · intro hx
    have h1 := congrArg Subtype.val hx
    rw [hc] at h1
    refine ⟨x.2, ?_⟩
    calc (x : Y) * g = g * x * g⁻¹ * g := by rw [h1]
      _ = g * x := by group
  · rintro ⟨-, hx⟩
    apply Subtype.ext
    rw [hc]
    calc g * (x : Y) * g⁻¹ = x * g * g⁻¹ := by rw [hx]
      _ = x := by group

theorem image_data (hK : π.ker ≤ center L) (hπ : Function.Surjective π) {g : Y} {c : MulAut L}
    (hc : ∀ x : L, ((c x : L) : Y) = g * x * g⁻¹) (hcc : ∀ x, c (c x) = x) {α : MulAut S}
    (hcomm : ∀ x, π (c x) = α (π x)) {M : Subgroup Y} (hMC : M ≤ L ⊓ centralizer ({g} : Set Y))
    (hM : IsPComponent 2 (M.subgroupOf (L ⊓ centralizer ({g} : Set Y))))
    (hZ : center (M ⧸ pPrimeCore 2 M) = ⊥) :
    (M.subgroupOf L).map π ≤ fixedSubgroup α ∧
      IsPComponent 2 (((M.subgroupOf L).map π).subgroupOf (fixedSubgroup α)) ∧
      Nonempty (M ⧸ pPrimeCore 2 M ≃*
        (M.subgroupOf L).map π ⧸ pPrimeCore 2 ((M.subgroupOf L).map π)) ∧
      ¬ 2 ∣ Nat.card (π.domRestrict (M.subgroupOf L)).ker := by
  have hML : M ≤ L := hMC.trans inf_le_left
  have hfix := fixedSubgroup_eq_of_conj hc
  have hM'C : M.subgroupOf L ≤ fixedSubgroup c := by
    rw [hfix]
    intro x hx
    rw [mem_subgroupOf] at hx ⊢
    exact hMC hx
  have hM'p : IsPComponent 2 ((M.subgroupOf L).subgroupOf (fixedSubgroup c)) := by
    rw [hfix]
    exact (UnbalancedCorr.isPComponent_subgroupOf_subgroupOf_iff' (L := M) inf_le_left 2
      Nat.prime_two).mpr hM
  let eM : M.subgroupOf L ⧸ pPrimeCore 2 (M.subgroupOf L) ≃* M ⧸ pPrimeCore 2 M :=
    CatalogueBAlternating.primeCoreQuotientEquiv 2 (subgroupOfEquivOfLe hML)
  have hZ' : center (M.subgroupOf L ⧸ pPrimeCore 2 (M.subgroupOf L)) = ⊥ := by
    have h := map_center_eq eM
    rw [hZ] at h
    exact (map_eq_bot_iff_of_injective _ eM.injective).mp h
  have hk := not_two_dvd_card_ker hK hZ'
  obtain ⟨h1, h2, ⟨e⟩⟩ := isPComponent_map_fixed hK hπ hcc hcomm hM'C hM'p hk
  exact ⟨h1, h2, ⟨eM.symm.trans e⟩, hk⟩

theorem map_oddCoreIn_subgroupOf {M : Subgroup Y} (hML : M ≤ L) :
    (oddCoreIn (M.subgroupOf L)).map L.subtype = oddCoreIn M := by
  rw [OddQuot.map_oddCoreIn L.subtype (by rw [ker_subtype, card_bot]; norm_num),
    map_subgroupOf_eq_of_le hML]

end Pump516

open Pump516 in
theorem cf516PumpUpInv_of_leaf (hLeaf : CF516PumpLeaf) : CF516PumpUpInv := by
  intro Y _ _ hY L hL β _ hN hL2 p f hp hp2 hf K hKC hK hKmod t htK ht2 J hJC hJ hJmod hβJ
    JB hJBJK hJBp hJBsup
  by_contra hKL
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨⟨hperf⟩, hsimple, hnab⟩ := hL.1
  let π : L →* L ⧸ center L := QuotientGroup.mk' (center L)
  have hπ : Function.Surjective π := QuotientGroup.mk'_surjective _
  have hkerπ : π.ker = center L := QuotientGroup.ker_mk' _
  have hker : π.ker ≤ center L := hkerπ.le
  let c : MulAut L := L.normalizerMonoidHom ⟨β, hN⟩
  have hc : ∀ x : L, ((c x : L) : Y) = β * x * β⁻¹ := fun x => rfl
  have hβL : ∀ x ∈ L, β * x * β⁻¹ = β⁻¹ * x * β := by
    intro x hx
    have h := mem_centralizer_singleton_iff.mp (hL2 hx)
    calc β * x * β⁻¹ = β⁻¹ * (β ^ 2 * x) * β⁻¹ := by group
      _ = β⁻¹ * (x * β ^ 2) * β⁻¹ := by rw [← h]
      _ = β⁻¹ * x * β := by group
  have hcc : ∀ x, c (c x) = x := by
    intro x
    apply Subtype.ext
    rw [hc, hc, hβL _ x.2]
    group
  let σ : MulAut (L ⧸ center L) := QuotientGroup.congr (center L) (center L) c (map_center_eq c)
  have hσ : ∀ x, π (c x) = σ (π x) := fun x => rfl
  have hσσ : ∀ y, σ (σ y) = y := by
    intro y
    obtain ⟨x, rfl⟩ := hπ y
    rw [← hσ, ← hσ, hcc]
  have hKL' : K ≤ L := hKC.trans inf_le_left
  have hKform : L4U4Form (K ⧸ pPrimeCore 2 K) p f := hKmod
  have hKs : IsSimpleGroup (K ⧸ pPrimeCore 2 K) := hKform.isSimpleGroup hp hf
  have hKq : IsQuasisimple (K ⧸ pPrimeCore 2 K) :=
    ((CatalogueBPrimeJoin.pComponent_subgroupOf_iff 2 K _ hKC).mp hK).2.2
  obtain ⟨hPσ, hP, ⟨eP⟩, hKk⟩ :=
    image_data hker hπ hc hcc hσ hKC hK (center_eq_bot_of_isQuasisimple hKq)
  have hPtop : (K.subgroupOf L).map π ≠ ⊤ := by
    intro hPt
    apply hKL
    have h1 : K.subgroupOf L ⊔ center L = ⊤ := by
      have h2 := comap_map_eq π (K.subgroupOf L)
      rw [hPt, comap_top, hkerπ] at h2
      exact h2.symm
    have h3 := map_subgroupOf_eq_of_le hKL'
    rw [GrSLit.eq_top_of_sup_center_eq_top hperf h1, ← MonoidHom.range_eq_map,
      range_subtype] at h3
    exact h3.symm
  let t₀ : L := ⟨t, hKL' htK⟩
  have htt : t * t = 1 := by rw [← pow_two, ← ht2, pow_orderOf_eq_one]
  have ht₀ : t₀ ∈ K.subgroupOf L := htK
  have hπt : orderOf (π t₀) = 2 := by
    apply orderOf_eq_prime
    · have h : t₀ ^ 2 = 1 := Subtype.ext (by rw [coe_pow, pow_two]; exact htt)
      rw [← map_pow, h, map_one]
    · intro h1
      let z : (π.domRestrict (K.subgroupOf L)).ker := ⟨⟨t₀, ht₀⟩, h1⟩
      have hz : orderOf z = 2 := by
        rw [← Subgroup.orderOf_coe, ← Subgroup.orderOf_coe, ← Subgroup.orderOf_coe]
        exact ht2
      exact hKk (hz ▸ orderOf_dvd_natCard z)
  have hJL : J ≤ L := hJC.trans inf_le_left
  have ha : ∀ x : L, ((MulAut.conj t₀ x : L) : Y) = t * x * t⁻¹ := fun x => rfl
  have haa : ∀ x, MulAut.conj t₀ (MulAut.conj t₀ x) = x := by
    intro x
    apply Subtype.ext
    rw [ha, ha]
    calc t * (t * (x : Y) * t⁻¹) * t⁻¹ = (t * t) * x * (t * t)⁻¹ := by group
      _ = x := by rw [htt]; group
  have hacomm : ∀ x, π (MulAut.conj t₀ x) = MulAut.conj (π t₀) (π x) := by
    intro x
    simp only [MulAut.conj_apply, map_mul, map_inv]
  have hJq : IsQuasisimple (J ⧸ pPrimeCore 2 J) :=
    ((CatalogueBPrimeJoin.pComponent_subgroupOf_iff 2 J _ hJC).mp hJ).2.2
  have hJs : IsSimpleGroup (J ⧸ pPrimeCore 2 J) := isSimpleGroup_of_lieModel_psl (by norm_num) hJmod
  obtain ⟨hJα, hJp, ⟨eJ⟩, -⟩ :=
    image_data hker hπ ha haa hacomm hJC hJ (center_eq_bot_of_isQuasisimple hJq)
  rw [fixedSubgroup_conj] at hJα hJp
  have hOJ := map_oddCoreIn_subgroupOf hJL
  have hβN : β ∈ normalizer (J : Set Y) := (mem_coreActionKernel.mp hβJ).1
  have hσJ : ∀ j ∈ (J.subgroupOf L).map π, σ j ∈ (J.subgroupOf L).map π := by
    intro j hj
    obtain ⟨x, hx, rfl⟩ := mem_map.mp hj
    rw [← hσ]
    refine mem_map_of_mem π ?_
    rw [mem_subgroupOf, hc]
    exact (mem_normalizer_iff.mp hβN _).mp hx
  have hσO : ∀ j ∈ (J.subgroupOf L).map π,
      j⁻¹ * σ j ∈ oddCoreIn ((J.subgroupOf L).map π) := by
    intro j hj
    obtain ⟨x, hx, rfl⟩ := mem_map.mp hj
    rw [← hσ, ← map_inv, ← map_mul]
    refine map_oddCoreIn_le π (J.subgroupOf L) (mem_map_of_mem π ?_)
    have h1 := (mem_coreActionKernel.mp hβJ).2 x hx
    have h2 : ((x⁻¹ * c x : L) : Y) = (x : Y)⁻¹ * β⁻¹ * x * β := by
      rw [coe_mul, coe_inv, hc, hβL _ x.2]
      group
    rw [← h2] at h1
    change ((x⁻¹ * c x : L) : Y) ∈ oddCoreIn J at h1
    rw [← hOJ] at h1
    exact (mem_map_iff_mem L.subtype_injective).mp h1
  have hJBL : JB ≤ L := hJBJK.trans (inf_le_left.trans hJL)
  have hJBb : (JB.subgroupOf L).map π ≤ (J.subgroupOf L).map π ⊓ (K.subgroupOf L).map π :=
    le_inf (map_mono fun x hx => (hJBJK hx).1) (map_mono fun x hx => (hJBJK hx).2)
  have hJBpb : ⁅(JB.subgroupOf L).map π, (JB.subgroupOf L).map π⁆ = (JB.subgroupOf L).map π := by
    rw [← map_commutator]
    congr 1
    apply map_injective L.subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le hJBL, hJBp]
  have hJsupb : (J.subgroupOf L).map π ≤
      (JB.subgroupOf L).map π ⊔ oddCoreIn ((J.subgroupOf L).map π) := by
    have h1 : J.subgroupOf L ≤ JB.subgroupOf L ⊔ oddCoreIn (J.subgroupOf L) := by
      rw [← map_le_map_iff_of_injective L.subtype_injective, Subgroup.map_sup,
        map_subgroupOf_eq_of_le hJL, map_subgroupOf_eq_of_le hJBL, hOJ]
      exact hJBsup
    calc (J.subgroupOf L).map π ≤ (JB.subgroupOf L ⊔ oddCoreIn (J.subgroupOf L)).map π :=
          map_mono h1
      _ = (JB.subgroupOf L).map π ⊔ (oddCoreIn (J.subgroupOf L)).map π := Subgroup.map_sup _ _ _
      _ ≤ (JB.subgroupOf L).map π ⊔ oddCoreIn ((J.subgroupOf L).map π) :=
          sup_le_sup_left (map_oddCoreIn_le π _) _
  exact hLeaf _ hsimple hnab (hY L (center L) hsimple) ((hY.subgroup L).quotient (center L)) σ _
    ⟨hσσ, hPσ, hP, hPtop⟩ p f hp hp2 hf
    ((hKform.of_mulEquiv eP.symm).lieModel hp hf) (π t₀) (mem_map_of_mem π ht₀) hπt _ hJα hJp
    (OddQuot.lieModel_of_equiv eJ hJmod) hσJ hσO _ hJBb hJBpb hJsupb

end CFSG.ComponentClassification.GSThmB
