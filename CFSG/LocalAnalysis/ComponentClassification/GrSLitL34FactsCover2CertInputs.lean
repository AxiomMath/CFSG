@[expose] def cover2Specs : List (List (Fin 2 × Bool) × ℕ × ℕ × ℕ) :=
  commData2.map (fun d => (commWord (tw d.1) (tw d.2.1), d.2.2.1, d.2.2.2.1, d.2.2.2.2)) ++
    fourthData2.map (fun d => (wpow (tw d.1) 4, d.2.1, d.2.2.1, d.2.2.2))

@[expose] def kbit (κ p q : ℕ) : Bool :=
  if κ = 0 then q == 2 else if κ = 1 then p == 2 else !(p == q)

@[expose] def commBit (κ k w : ℕ) (f : Bool) : Bool :=
  commData2.any fun d => d.1 == k && d.2.1 == w && kbit κ d.2.2.1 d.2.2.2.1 == f

@[expose] def fourthBit (κ k : ℕ) : Bool :=
  fourthData2.any fun d => d.1 == k && (d.2.1 == 0 || d.2.1 == 2) &&
    (d.2.2.1 == 0 || d.2.2.1 == 2) && !kbit κ d.2.1 d.2.2.1

@[expose] def uIdx : List (List ℕ) := [List.range 16, (List.range 16).map (4 * ·)]

@[expose] def transOK : Bool :=
  [0, 1, 2].all fun κ => uIdx.all fun I => I.all fun k₁ => I.all fun k₂ =>
    (k₁ == 0 || k₂ == 0 || k₁ == k₂) || [false, true].all fun f₁ => [false, true].all fun f₂ =>
      I.any fun w => commBit κ k₁ w f₁ && commBit κ k₂ w f₂

@[expose] def cceOK : Bool :=
  cceIdx.all fun d => commBit d.1 d.2.1 4 false && commBit d.1 d.2.1 8 false &&
    fourthBit d.1 d.2.1 && comp 42 (wordTab (tg d.2.1)) (wordTab (tg d.2.1)) == wordTab (tg d.2.2)

