theorem IsSuzTwoBFour.exists_ne_one {S : Type} [Group S] {W : Subgroup S}
    (hW : IsSuzTwoBFour W) : ∃ u ∈ W, u ≠ 1 := by
  rcases W.bot_or_exists_ne_one with h | h
  · have := hW.card
    rw [h, Subgroup.card_bot] at this
    norm_num at this
  · exact h

theorem IsSuzTwoBFour.exists_model
    {S : Type} [Group S]
    (hS : Blueprint.NativeSporadic.IsSporadic S .Suz) {W : Subgroup S} (hW : IsSuzTwoBFour W)
    {u : S} (hu : u ∈ W) (hu1 : u ≠ 1) :
    ∃ Ψ : S →* Equiv.Perm (Fin 1782), Function.Injective Ψ ∧ (∀ x, Ψ x ∈ suzM) ∧
      (∀ y ∈ suzM, ∃ x, Ψ x = y) ∧ Ψ u = suzInv 0 := by
  obtain ⟨e⟩ := hS
  have f : S ≃* suzM := e.trans suzEquivM
  have hu2 : orderOf u = 2 := orderOf_eq_prime (by rw [sq]; exact hW.mul_self u hu) hu1
  have hdvd : 20160 ∣ Nat.card (centralizer ({u} : Set S)) := by
    rw [hW.card_centralizer u hu hu1]
    norm_num
  exact suz_exists_model_aux f u hu2 hdvd

theorem IsSuzTwoBFour.map_commutator_data
    {S : Type} [Group S]
    {W : Subgroup S} (hW : IsSuzTwoBFour W) {u : S} (hu : u ∈ W)
    {Ψ : S →* Equiv.Perm (Fin 1782)} (hinj : Function.Injective Ψ) (hΨM : ∀ x, Ψ x ∈ suzM)
    (hΨu : Ψ u = suzInv 0) :
    ⁅centralizer (W : Set S), centralizer (W : Set S)⁆.map Ψ ≤ invE 0 ∧
      Group.IsPerfect ↥(⁅centralizer (W : Set S), centralizer (W : Set S)⁆.map Ψ) ∧
      Nat.card ↥(⁅centralizer (W : Set S), centralizer (W : Set S)⁆.map Ψ) = 20160 :=
  ⟨(Subgroup.map_mono (Subgroup.commutator_le_self _)).trans
      (map_centralizer_le_invE_zero hu hΨM hΨu),
    isPerfect_map_commutator hW.card_commutator hu hinj hΨM hΨu,
    by rw [Subgroup.card_map_of_injective hinj, hW.card_commutator]⟩

theorem suzTwoAFusion_holds :
    SuzTwoAFusion := by
  intro S _ _ hS W hW d hd hd2
  obtain ⟨u, hu, hu1⟩ := hW.exists_ne_one
  obtain ⟨Ψ, hinj, hΨM, hΨR, hΨu⟩ := hW.exists_model hS hu hu1
  obtain ⟨hKle, hKperf, hKcard⟩ := hW.map_commutator_data hu hinj hΨM hΨu
  rw [card_centralizer_eq_card_suzM_inf_centralizer hinj hΨM hΨR d]
  exact card_suzM_inf_centralizer_of_mem hKle hKperf hKcard ⟨d, hd, rfl⟩
    (by rw [orderOf_injective Ψ hinj, hd2])

private theorem eq_one_or_eq_suzInv_one_of_forall_mul_comm
    {z : Equiv.Perm (Fin 1782)} (hz : z ∈ invE 1)
    (hc : ∀ x ∈ invE 1, z * x = x * z) : z = 1 ∨ z = suzInv 1 := by
  have hzc : (⟨z, hz⟩ : ↥(invE 1)) ∈ center ↥(invE 1) :=
    Subgroup.mem_center_iff.2 fun x => Subtype.ext (hc x x.2).symm
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (AS81.SuzB0.mem_center_invE_one_iff.mp hzc)
  change suzInv 1 ^ k = z at hk
  rw [← hk]
  exact CFSG.GroupTheory.zpow_eq_one_or_self_of_mul_self_eq_one (suzInv_sq (by norm_num)) k

theorem suzTwoACentralizerFacts_holds :
    SuzTwoACentralizerFacts := by
  intro S _ _ hS d hd2 hdc
  obtain ⟨e₀⟩ := hS
  have f : S ≃* suzM := e₀.trans suzEquivM
  rcases suz_centralizer_equiv f d hd2 with h0 | h1
  · exfalso
    obtain ⟨e⟩ := h0
    have h1 := Nat.card_congr e.toEquiv
    rw [hdc, card_invE (by norm_num : 0 < 4)] at h1
    simp [invInnerOrders] at h1
  · obtain ⟨e⟩ := h1
    have hcen : ∀ c : centralizer ({d} : Set S),
        (∀ x ∈ centralizer ({d} : Set S), (c : S) * x = x * c) →
          ∀ x ∈ invE 1, ((e c : invE 1) : Equiv.Perm (Fin 1782)) * x = x * (e c : invE 1) := by
      intro c hc x hx
      have h1 : c * e.symm ⟨x, hx⟩ = e.symm ⟨x, hx⟩ * c :=
        Subtype.ext (hc _ (e.symm ⟨x, hx⟩).2)
      have h2 := congrArg (fun y => ((e y : invE 1) : Equiv.Perm (Fin 1782))) h1
      simpa only [map_mul, MulEquiv.apply_symm_apply, Subgroup.coe_mul] using h2
    have hdmem : d ∈ centralizer ({d} : Set S) := Subgroup.mem_centralizer_singleton_iff.2 rfl
    have hdcen : ∀ x ∈ centralizer ({d} : Set S), d * x = x * d := fun x hx =>
      (Subgroup.mem_centralizer_singleton_iff.1 hx).symm
    have hed : ((e ⟨d, hdmem⟩ : invE 1) : Equiv.Perm (Fin 1782)) = suzInv 1 := by
      rcases eq_one_or_eq_suzInv_one_of_forall_mul_comm (e ⟨d, hdmem⟩).2
        (hcen ⟨d, hdmem⟩ hdcen) with h | h
      · exfalso
        have h1 : e ⟨d, hdmem⟩ = 1 := Subtype.ext h
        rw [MulEquiv.map_eq_one_iff] at h1
        have h2 : d = 1 := congrArg Subtype.val h1
        rw [h2, orderOf_one] at hd2
        norm_num at hd2
      · exact h
    refine ⟨?_, fun z hz hzc => ?_⟩
    · have : Group.IsPerfect ↥(invE 1) := Group.isPerfect_def.2 AS81.SuzB0.invE_one_perfect
      exact Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
    · rcases eq_one_or_eq_suzInv_one_of_forall_mul_comm (e ⟨z, hz⟩).2
        (hcen ⟨z, hz⟩ hzc) with h | h
      · left
        have h1 : e ⟨z, hz⟩ = 1 := Subtype.ext h
        rw [MulEquiv.map_eq_one_iff] at h1
        exact congrArg Subtype.val h1
      · right
        have h1 : e ⟨z, hz⟩ = e ⟨d, hdmem⟩ := Subtype.ext (h.trans hed.symm)
        exact congrArg Subtype.val (e.injective h1)

theorem suzTwoACentralizerAutExtension_holds :
