theorem suzTwoBRootRigidity_holds :
    SuzTwoBRootRigidity := by
  intro S _ _ hS W hW u hu hu1 d hd hd2 β hβu _hβd hdev w hw
  obtain ⟨Ψ, hinj, hΨM, hΨR, hΨu⟩ := hW.exists_model hS hu hu1
  obtain ⟨hKle, hKperf, hKcard⟩ := hW.map_commutator_data hu hinj hΨM hΨu
  obtain ⟨τ, hτ, hτΨ⟩ := exists_mem_suzT_mul_mul_inv_eq hinj hΨM hΨR β
  have hτt : τ * suzInv 0 = suzInv 0 * τ := by
    have h1 := hτΨ u
    rw [hβu, hΨu] at h1
    calc τ * suzInv 0 = τ * suzInv 0 * τ⁻¹ * τ := by group
      _ = suzInv 0 * τ := by rw [h1]
  have hdev' : ∀ x ∈ ⁅centralizer (W : Set S), centralizer (W : Set S)⁆.map Ψ,
      x * Ψ d = Ψ d * x → x ^ 4 = 1 → τ * x * τ⁻¹ = x ∨ τ * x * τ⁻¹ = suzInv 0 * x := by
    rintro _ ⟨y, hy, rfl⟩ hyd hy4
    have hyd' : y * d = d * y := hinj (by rw [map_mul, map_mul, hyd])
    have hy4' : y ^ 4 = 1 := hinj (by rw [map_pow, hy4, map_one])
    have hp : IsPGroup 2 (zpowers y) := by
      have hdvd : orderOf y ∣ 2 ^ 2 := orderOf_dvd_of_pow_eq_one (by norm_num [hy4'])
      obtain ⟨k, -, hk⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hdvd
      exact IsPGroup.of_card (by rw [Nat.card_zpowers, hk])
    rcases hdev y hy hyd' hp with h | h
    · left
      rw [hτΨ y, h]
    · right
      rw [hτΨ y, h, map_mul, hΨu]
  obtain ⟨hwE, hwk⟩ := exists_mem_ker_rho0 hW.mul_self hW.card_commutator hu hinj hΨM hΨu hw
  have hc := comm_of_mem_ker_rho0 hKle hKperf hKcard ⟨d, hd, rfl⟩
    (by rw [orderOf_injective Ψ hinj, hd2]) hτ hτt hdev' hwE hwk
  apply hinj
  rw [← hτΨ w, hc, mul_inv_cancel_right]

