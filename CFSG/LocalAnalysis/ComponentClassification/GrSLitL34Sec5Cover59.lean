theorem inf_zStarIn_le_zStarIn_of_le {J L : Subgroup G} (hJL : J ≤ L) :
    J ⊓ zStarIn L ≤ zStarIn J := by
  intro z hz
  obtain ⟨hzJ, hzL⟩ := mem_inf.mp hz
  obtain ⟨z', hz', hzz'⟩ := hzL
  have hN : ((oddIn L).subgroupOf J).Normal := ⟨fun n hn g => by
    rw [mem_subgroupOf] at hn ⊢
    have hgN : (g : G) ∈ normalizer (oddIn L : Set G) :=
      normalizer_le_normalizer_oddIn L (le_normalizer (hJL g.2))
    simpa using (mem_normalizer_iff.mp hgN _).mp hn⟩
  have hcop : Nat.Coprime 2 (Nat.card ((oddIn L).subgroupOf J)) := by
    have h1 : Nat.card ((oddIn L).subgroupOf J) ∣ Nat.card (oddIn L) := by
      rw [← card_map_of_injective J.subtype_injective, subgroupOf_map_subtype]
      exact card_dvd_of_le inf_le_left
    have hodd : Odd (Nat.card (oddIn L)) := by
      rw [oddIn, card_map_of_injective (subtype_injective _)]
      exact Nat.coprime_two_left.mp pPrimeCore_coprime_card
    exact Nat.coprime_two_left.mpr (hodd.of_dvd_nat h1)
  have hle : (oddIn L).subgroupOf J ≤ pPrimeCore 2 J := le_sSup ⟨hN, hcop⟩
  refine ⟨⟨z, hzJ⟩, GSThmB.OddQuot.mem_fusionZStar_iff.mpr fun m => hle ?_, rfl⟩
  rw [mem_subgroupOf]
  have h1 := (GSThmB.OddQuot.mem_fusionZStar_iff.mp hz') ⟨m, hJL m.2⟩
  have h2 : ((⁅z', ⟨(m : G), hJL m.2⟩⁆ : L) : G) ∈ oddIn L := ⟨_, h1, rfl⟩
  have hz'' : (z' : G) = z := hzz'
  convert h2 using 1
  simp [commutatorElement_def, hz'']

theorem sup_oddIn_eq_of_le_of_isL34Type {J L : Subgroup G} (hJL : J ≤ L)
    (hJ : IsL34Type (J ⧸ Open.fusionZStar J)) (hL : IsL34Type (L ⧸ Open.fusionZStar L))
    (hLperf : ⁅L, L⁆ = L) : J ⊔ oddIn L = L := by
  set J' : Subgroup L := J.subgroupOf L with hJ'
  set K : Subgroup L := Open.fusionZStar L with hK
  have hJ'map : J'.map L.subtype = J := by
    rw [hJ', subgroupOf_map_subtype, inf_eq_left.mpr hJL]
  have hcardJK : Nat.card ↥(K ⊓ J') ≤ Nat.card (Open.fusionZStar J) := by
    have e1 : (K ⊓ J').map L.subtype = zStarIn L ⊓ J := by
      rw [map_inf_eq _ _ _ L.subtype_injective, hJ'map]
      rfl
    calc Nat.card ↥(K ⊓ J') = Nat.card ↥(zStarIn L ⊓ J) := by
          rw [← e1, card_map_of_injective L.subtype_injective]
      _ ≤ Nat.card ↥(zStarIn J) := by
          rw [inf_comm]
          exact card_le_of_le (inf_zStarIn_le_zStarIn_of_le hJL)
      _ = Nat.card (Open.fusionZStar J) := card_map_of_injective (subtype_injective _)
  have hJc : Nat.card J = 20160 * Nat.card (Open.fusionZStar J) := by
    have h1 := GSThmB.card_of_lieModel_L34 hJ
    have h2 := Subgroup.card_eq_card_quotient_mul_card_subgroup (Open.fusionZStar J)
    rwa [h1] at h2
  have hLc : Nat.card L = 20160 * Nat.card K := by
    have h1 := GSThmB.card_of_lieModel_L34 hL
    have h2 := Subgroup.card_eq_card_quotient_mul_card_subgroup (Open.fusionZStar L)
    rwa [h1] at h2
  have hJ'c : Nat.card J' = Nat.card J := by
    rw [← card_map_of_injective L.subtype_injective, hJ'map]
  have hsupK : J' ⊔ K = ⊤ := by
    have hr1 := relIndex_mul_card (H := K) (K := J')
    have hr2 := relIndex_mul_card (H := K) (K := J' ⊔ K)
    rw [inf_of_le_left (le_sup_right : K ≤ J' ⊔ K), relIndex_sup_right] at hr2
    have hpos : 0 < Nat.card ↥(K ⊓ J') := Nat.card_pos
    have hge : 20160 ≤ K.relIndex J' := by
      by_contra hlt
      push Not at hlt
      have : K.relIndex J' * Nat.card ↥(K ⊓ J') < 20160 * Nat.card (Open.fusionZStar J) :=
        calc K.relIndex J' * Nat.card ↥(K ⊓ J') < 20160 * Nat.card ↥(K ⊓ J') :=
              Nat.mul_lt_mul_of_pos_right hlt hpos
          _ ≤ 20160 * Nat.card (Open.fusionZStar J) := Nat.mul_le_mul_left _ hcardJK
      omega
    have hcard : Nat.card L ≤ Nat.card ↥(J' ⊔ K) := by
      rw [← hr2, hLc]
      exact Nat.mul_le_mul_right _ hge
    exact eq_top_of_card_eq _ (le_antisymm (card_le_card_group _) hcard)
  set π := QuotientGroup.mk' (pPrimeCore 2 ↥L) with hπ
  have hπs : Function.Surjective π := QuotientGroup.mk'_surjective _
  have hKπ : K.map π = center (↥L ⧸ pPrimeCore 2 ↥L) := by
    rw [hK, Sol78.fusionZStar_eq_comap, map_comap_eq_self_of_surjective hπs]
  have hsupQ : J'.map π ⊔ center (↥L ⧸ pPrimeCore 2 ↥L) = ⊤ := by
    rw [← hKπ, ← Subgroup.map_sup, hsupK, map_top_of_surjective _ hπs]
  have hperfL : commutator ↥L = ⊤ := by
    apply map_injective L.subtype_injective
    rw [map_subtype_commutator, hLperf, ← MonoidHom.range_eq_map, range_subtype]
  have hperfQ : commutator (↥L ⧸ pPrimeCore 2 ↥L) = ⊤ := by
    rw [_root_.commutator_def, ← map_top_of_surjective _ hπs, ← map_commutator,
      ← _root_.commutator_def, hperfL]
  have hJQ : J'.map π = ⊤ := eq_top_of_sup_center_eq_top hperfQ hsupQ
  have hJO : J' ⊔ pPrimeCore 2 ↥L = ⊤ := by
    have h1 := comap_map_eq π J'
    rw [hJQ, comap_top, hπ, QuotientGroup.ker_mk'] at h1
    exact h1.symm
  calc J ⊔ oddIn L = (J' ⊔ pPrimeCore 2 ↥L).map L.subtype := by
        rw [Subgroup.map_sup, hJ'map]
        rfl
    _ = L := by rw [hJO, ← MonoidHom.range_eq_map, range_subtype]

