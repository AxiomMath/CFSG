@[expose] def Fus.goodA34 (mul : SE → SE → SE) (q : Array SE) : Bool :=
  (Fus.aA34Base.hasEdge mul q 1 0 || Fus.aA34Base.hasEdge mul q 0 1) &&
    (Fus.aA34Base.hasEdge mul q 5 8 || Fus.aA34Base.hasEdge mul q 8 5) &&
    SE.clsTab (Fus.aA34Base.img mul q 4) == 8 &&
    SE.allList.any fun s => mul s (SE.invRep 3) == mul (SE.invRep 3) s &&
      mul (Fus.aA34Base.img mul q 26) s == mul s (SE.gen 0) &&
      (mul (Fus.aA34Base.img mul q 2) s == mul s (SE.invRep 1) ||
        mul (Fus.aA34Base.img mul q 2) s == mul s (SE.invRep 1 * SE.gen 0)) &&
      Fus.A1list.any fun w => mul (Fus.aA34Base.img mul q 3) s == mul s w

@[expose] def Fus.aA34 : Fus.Data := { Fus.aA34Base with good := Fus.goodA34 }

