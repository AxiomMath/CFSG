@[expose] def Fus.goodAZ (mul : SE → SE → SE) (q : Array SE) : Bool :=
  Fus.aZBase.hasEdge mul q 1 7 && Fus.aZBase.hasEdge mul q 7 3 && Fus.aZBase.hasEdge mul q 5 8 &&
    SE.allList.any fun s => mul (Fus.aZBase.img mul q 26) s == mul s (SE.invRep 1) &&
      (mul (Fus.aZBase.img mul q 4) s == mul s (SE.gen 6) ||
        mul (mul (Fus.aZBase.img mul q 4) (Fus.aZBase.img mul q 2)) s ==
          mul s (SE.gen 6 * SE.gen 0))

@[expose] def Fus.aZ : Fus.Data := { Fus.aZBase with good := Fus.goodAZ }

