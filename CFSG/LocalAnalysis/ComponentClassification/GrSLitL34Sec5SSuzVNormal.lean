theorem isElemTwo_card_zGammaThree_of_surjective {A B : Type} [Group A] [Finite A] [Group B]
    {f : A →* B} (hf : Function.Surjective f) (hker : Odd (Nat.card f.ker)) {n : ℕ}
    (hF : ∀ T : Sylow 2 B, IsElemTwo (zGammaThree (T : Subgroup B)) ∧
      Nat.card (zGammaThree (T : Subgroup B)) = n)
    (D : Sylow 2 A) :
    IsElemTwo (zGammaThree (D : Subgroup A)) ∧
      Nat.card (zGammaThree (D : Subgroup A)) = n := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hD2 : IsPGroup 2 (D : Subgroup A) := D.isPGroup'
  have hbot : (D : Subgroup A) ⊓ f.ker = ⊥ :=
    eq_bot_of_le_two_group_of_le_odd hD2 hker inf_le_left inf_le_right
  have hinj : Set.InjOn f (D : Set A) := by
    intro x hx y hy hxy
    have hmem : x⁻¹ * y ∈ (D : Subgroup A) ⊓ f.ker := by
      refine mem_inf.mpr ⟨D.mul_mem (D.inv_mem hx) hy, ?_⟩
      rw [MonoidHom.mem_ker, map_mul, map_inv, hxy, inv_mul_cancel]
    rw [hbot, Subgroup.mem_bot] at hmem
    exact inv_mul_eq_one.mp hmem
  have hzmap : (zGammaThree (D : Subgroup A)).map f =
      zGammaThree ((D : Subgroup A).map f) := map_zGammaThree_of_injOn f hinj
  have hT0 := hF (D.mapSurjective hf)
  rw [Sylow.coe_mapSurjective] at hT0
  have hsub : zGammaThree (D : Subgroup A) ≤ (D : Subgroup A) :=
    zGammaThree_le (D : Subgroup A)
  have hmemT : ∀ {x : A}, x ∈ zGammaThree (D : Subgroup A) →
      f x ∈ zGammaThree ((D : Subgroup A).map f) := by
    intro x hx
    rw [← hzmap]
    exact Subgroup.mem_map_of_mem f hx
  have h_elem : IsElemTwo (zGammaThree (D : Subgroup A)) := by
    refine ⟨fun x hx y hy => ?_, fun x hx => ?_⟩
    · refine hinj (D.mul_mem (hsub hx) (hsub hy)) (D.mul_mem (hsub hy) (hsub hx)) ?_
      show f (x * y) = f (y * x)
      rw [map_mul, map_mul]
      exact hT0.1.1 (f x) (hmemT hx) (f y) (hmemT hy)
    · refine hinj (D.mul_mem (hsub hx) (hsub hx)) D.one_mem ?_
      show f (x * x) = f 1
      rw [map_mul, map_one]
      exact hT0.1.2 (f x) (hmemT hx)
  refine ⟨h_elem, ?_⟩
  have hcard : Nat.card (zGammaThree ((D : Subgroup A).map f)) =
      Nat.card (zGammaThree (D : Subgroup A)) := by
    rw [← hzmap]
    refine (Nat.card_congr (Equiv.ofBijective
      (fun x : ↥(zGammaThree (D : Subgroup A)) =>
        (⟨f x, Subgroup.mem_map_of_mem f x.2⟩ :
          ↥((zGammaThree (D : Subgroup A)).map f))) ⟨?_, ?_⟩)).symm
    · intro x y hxy
      exact Subtype.ext (hinj (hsub x.2) (hsub y.2) (congrArg Subtype.val hxy))
    · intro y
      obtain ⟨x, hx, hxy⟩ := Subgroup.mem_map.mp y.2
      exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩
  rw [← hcard]
  exact hT0.2

theorem false_of_suz_normal_center_two (hGold : GoldschmidtStronglyClosedInput)
    (hF2 : TwoSuzSylowFacts)
    {G : Type} [Group G] [Finite G] {t : G} {P W M : Subgroup G}
    (hc : L34WConfigAt (fun X _ => Blueprint.NativeSporadic.IsSporadic X .Suz) G t P W)
    (hM : M = normalizer (W : Set G)) (htM : t ∈ M)
    {L : Subgroup (↥M ⧸ pPrimeCore 2 ↥M)} (hL : IsComponent L) (hLn : L.Normal)
    (hZ : Nat.card (Subgroup.center ↥L) ≤ 2)
    (hLty : IsSporadic (↥L ⧸ Subgroup.center ↥L) .Suz)
    (hPL : (P.subgroupOf M).map (QuotientGroup.mk' (pPrimeCore 2 ↥M)) = L)
    (hZL : Subgroup.center ↥L ≠ ⊥) : False := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let X := ↥M ⧸ pPrimeCore 2 ↥M
  let π : ↥M →* X := QuotientGroup.mk' (pPrimeCore 2 ↥M)
  let HM : Subgroup ↥M := L.comap π
  let KM : Subgroup ↥M := (Subgroup.centralizer (L : Set X)).comap π
  let H : Subgroup G := HM.map M.subtype
  let K : Subgroup G := KM.map M.subtype
  have hHMle : H ≤ M := Subgroup.map_subtype_le HM
  have hKMle : K ≤ M := Subgroup.map_subtype_le KM
  have hHMnorm : HM.Normal := hLn.comap π
  have hKMnorm : KM.Normal := by
    have : L.Normal := hLn
    exact Subgroup.Normal.comap (Subgroup.normal_centralizer (H := L)) π
  have hHsub : H.subgroupOf M = HM := by
    show (HM.map M.subtype).comap M.subtype = HM
    exact Subgroup.comap_map_eq_self_of_injective M.subtype_injective HM
  have hKsub : K.subgroupOf M = KM := by
    show (KM.map M.subtype).comap M.subtype = KM
    exact Subgroup.comap_map_eq_self_of_injective M.subtype_injective KM
  have hMH : M ≤ normalizer (H : Set G) := by
    refine (Subgroup.normal_subgroupOf_iff_le_normalizer hHMle).mp ?_
    rwa [hHsub]
  have hMK : M ≤ normalizer (K : Set G) := by
    refine (Subgroup.normal_subgroupOf_iff_le_normalizer hKMle).mp ?_
    rwa [hKsub]
  have hPM : P ≤ M := by simpa [← hM] using hc.le_normalizer'
  have hPH : P ≤ H := by
    intro p hp
    refine Subgroup.mem_map.mpr ⟨⟨p, hPM hp⟩, ?_, rfl⟩
    rw [Subgroup.mem_comap, ← hPL]
    exact Subgroup.mem_map.mpr ⟨⟨p, hPM hp⟩, Subgroup.mem_subgroupOf.mpr hp, rfl⟩
  have hOH : oddIn M ≤ H := by
    intro x hx
    rw [oddIn] at hx
    obtain ⟨m, hm, rfl⟩ := Subgroup.mem_map.mp hx
    refine Subgroup.mem_map.mpr ⟨m, ?_, rfl⟩
    rw [Subgroup.mem_comap, QuotientGroup.mk'_apply]
    rw [(QuotientGroup.eq_one_iff (N := pPrimeCore 2 ↥M) m).mpr hm]
    exact L.one_mem
  have hH_eq : H = P ⊔ oddIn M := by
    refine le_antisymm ?_ (sup_le hPH hOH)
    intro x hx
    obtain ⟨m, hm, rfl⟩ := Subgroup.mem_map.mp hx
    have hmL : π m ∈ L := hm
    rw [← hPL] at hmL
    obtain ⟨pm, hpsub, hπp⟩ := Subgroup.mem_map.mp hmL
    have hpP : (pm : ↥M).1 ∈ P := Subgroup.mem_subgroupOf.mp hpsub
    have hker : m * pm⁻¹ ∈ pPrimeCore 2 ↥M := by
      have h1 : (QuotientGroup.mk' (pPrimeCore 2 ↥M)) (m * pm⁻¹) = 1 := by
        rw [map_mul, map_inv, hπp]
        exact mul_inv_cancel _
      exact (QuotientGroup.eq_one_iff (m * pm⁻¹)).mp h1
    have hodd : M.subtype (m * pm⁻¹) ∈ oddIn M := by
      rw [oddIn]
      exact Subgroup.mem_map.mpr ⟨m * pm⁻¹, hker, rfl⟩
    have hpp : M.subtype pm ∈ P := by simpa using hpP
    have hmul := Subgroup.mul_mem_sup (S := oddIn M) (T := P) hodd hpp
    rw [sup_comm] at hmul
    have heq : M.subtype (m * pm⁻¹) * M.subtype pm = M.subtype m := by
      rw [← map_mul]
      congr 1
      group
    rwa [heq] at hmul
  obtain ⟨R₀⟩ := Sylow.nonempty (p := 2) (G := ↥P)
  let R : Subgroup G := (R₀ : Subgroup ↥P).map P.subtype
  have hR : IsSylowTwoIn R P :=
    ⟨Subgroup.map_subtype_le _, R₀,
      (Subgroup.comap_map_eq_self_of_injective P.subtype_injective R₀).symm⟩
  have hR2 : IsPGroup 2 R := hR.isPGroup
  have hRAW : R ≤ P := hR.1
  have htt : t * t = 1 := by
    have h := pow_orderOf_eq_one t
    rw [hc.order_two] at h
    simpa [pow_two] using h
  have hRt : ∀ r ∈ R, r * t = t * r := fun r hr =>
    mem_centralizer_singleton_iff.mp (hc.le_centralizer (hRAW hr))
  have htc : t ∈ centralizer (R : Set G) :=
    Subgroup.mem_centralizer_iff.mpr (fun r hr => hRt r hr)
  have htNR : t ∈ normalizer (R : Set G) :=
    Subgroup.centralizer_le_normalizer (R : Set G) htc
  have hzt2 : IsPGroup 2 ↥(zpowers t) := (isElemTwo_zpowers htt).isPGroup
  let T : Subgroup G := R ⊔ zpowers t
  have hTM : T ≤ M := sup_le (hRAW.trans hPM) (zpowers_le.mpr htM)
  have hT2 : IsPGroup 2 T := hR2.to_sup_of_normal_left' hzt2 (zpowers_le.mpr htNR)
  let TM : Subgroup ↥M := T.subgroupOf M
  have hTM2 : IsPGroup 2 TM := hT2.of_equiv (Subgroup.subgroupOfEquivOfLe hTM).symm
  obtain ⟨S₁, hTMS₁⟩ := hTM2.exists_le_sylow
  let S : Subgroup G := (S₁ : Subgroup ↥M).map M.subtype
  have hS : IsSylowTwoIn S M :=
    ⟨Subgroup.map_subtype_le _, S₁,
      (Subgroup.comap_map_eq_self_of_injective M.subtype_injective S₁).symm⟩
  have hST : T ≤ S := by
    intro x hx
    exact Subgroup.mem_map.mpr ⟨⟨x, hTM hx⟩, hTMS₁ (Subgroup.mem_subgroupOf.mpr hx), rfl⟩
  have hRS : R ≤ S := (le_sup_left : R ≤ T).trans hST
  have hztS : t ∈ S := hST (mem_sup_right (mem_zpowers t))
  have hSM : S ≤ M := hS.1
  have hS2 : IsPGroup 2 S := hS.isPGroup
  have hHcard : Nat.card H = Nat.card (pPrimeCore 2 ↥M) * Nat.card L := by
    have h1 := CFSG.GroupTheory.card_comap_eq_card_ker_mul_card (f := π)
      (QuotientGroup.mk'_surjective (pPrimeCore 2 ↥M)) L
    have hHcard' : Nat.card H = Nat.card ↥(L.comap π) := by
      show Nat.card ↥(HM.map M.subtype) = Nat.card ↥(L.comap π)
      rw [Subgroup.card_map_of_injective M.subtype_injective]
    rw [hHcard', h1]
    have hker : π.ker = pPrimeCore 2 ↥M := QuotientGroup.ker_mk' (pPrimeCore 2 ↥M)
    rw [hker]
  have hPcard : Nat.card P = Nat.card ↥(P ⊓ oddIn M) * Nat.card L := by
    let f : ↥P →* X := π.comp (Subgroup.inclusion hPM)
    have hfrange : f.range = L := by
      ext x
      constructor
      · rintro ⟨p, rfl⟩
        rw [← hPL]
        exact Subgroup.mem_map.mpr ⟨Subgroup.inclusion hPM p,
          Subgroup.mem_subgroupOf.mpr p.2, rfl⟩
      · intro hx
        rw [← hPL] at hx
        obtain ⟨pm, hpmsub, hpm⟩ := Subgroup.mem_map.mp hx
        refine ⟨⟨(pm : ↥M).1, Subgroup.mem_subgroupOf.mp hpmsub⟩, ?_⟩
        show π (Subgroup.inclusion hPM ⟨(pm : ↥M).1, Subgroup.mem_subgroupOf.mp hpmsub⟩) = x
        have hinc : Subgroup.inclusion hPM
            ⟨(pm : ↥M).1, Subgroup.mem_subgroupOf.mp hpmsub⟩ = pm := by
          apply Subtype.ext
          rfl
        rw [hinc]
        exact hpm
    have hker : f.ker = (oddIn M).subgroupOf P := by
      ext p
      rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, oddIn]
      constructor
      · intro hp
        have hmem : Subgroup.inclusion hPM p ∈ pPrimeCore 2 ↥M := by
          rw [← QuotientGroup.ker_mk' (pPrimeCore 2 ↥M), MonoidHom.mem_ker]
          exact hp
        exact Subgroup.mem_map.mpr ⟨Subgroup.inclusion hPM p, hmem, rfl⟩
      · intro hp
        obtain ⟨m, hm, hmp⟩ := Subgroup.mem_map.mp hp
        show (QuotientGroup.mk' (pPrimeCore 2 ↥M)) (Subgroup.inclusion hPM p) = 1
        have hincl : Subgroup.inclusion hPM p = m := by
          apply Subtype.ext
          exact hmp.symm
        rw [hincl]
        exact (QuotientGroup.eq_one_iff m).mpr hm
    calc Nat.card ↥P = Nat.card ↥f.ker * Nat.card ↥f.range :=
          (Subgroup.card_ker_mul_card_range f).symm
      _ = Nat.card ↥((oddIn M).subgroupOf P) * Nat.card ↥L := by rw [hker, hfrange]
      _ = Nat.card ↥(P ⊓ oddIn M) * Nat.card ↥L := by
          rw [← Subgroup.card_map_of_injective P.subtype_injective
            (K := (oddIn M).subgroupOf P), Subgroup.subgroupOf_map_subtype, inf_comm]
  have hOodd : Odd (Nat.card (pPrimeCore 2 ↥M)) :=
    Nat.coprime_two_left.mp (pPrimeCore_coprime_card (p := 2) (G := ↥M))
  have hRH : R ≤ H := hRAW.trans hPH
  have hRrelH : ¬ 2 ∣ R.relIndex H := by
    have hPrelOdd : Odd (P.relIndex H) := by
      have hmul := Subgroup.relIndex_mul_card (H := P) (K := H)
      rw [inf_of_le_left hPH] at hmul
      have hmul' : P.relIndex H * Nat.card ↥(P ⊓ oddIn M) = Nat.card (pPrimeCore 2 ↥M) := by
        apply Nat.eq_of_mul_eq_mul_right (Nat.card_pos (α := ↥L))
        calc (P.relIndex H * Nat.card ↥(P ⊓ oddIn M)) * Nat.card L
            = P.relIndex H * (Nat.card ↥(P ⊓ oddIn M) * Nat.card L) := by ring
          _ = P.relIndex H * Nat.card P := by rw [hPcard]
          _ = Nat.card H := hmul
          _ = Nat.card (pPrimeCore 2 ↥M) * Nat.card L := hHcard
      exact Odd.of_dvd_nat hOodd ⟨_, hmul'.symm⟩
    have hRrelP : ¬ 2 ∣ R.relIndex P := by
      obtain ⟨-, Q, hQ⟩ := hR
      have hnot := Q.not_dvd_index
      rw [hQ] at hnot
      exact hnot
    rw [← Subgroup.relIndex_mul_relIndex R P H hRAW hPH]
    intro h2
    rcases (Nat.prime_two.dvd_mul).mp h2 with h | h
    · exact hRrelP h
    · exact hPrelOdd.not_two_dvd_nat h
  have hRHsyl : CFSG.ABGLocalTools.IsSylowOf 2 R H :=
    CFSG.ABGLocalTools.isSylowOf_iff.mpr ⟨hRH, hR2, hRrelH⟩
  have hSMsyl : CFSG.ABGLocalTools.IsSylowOf 2 S M := by
    obtain ⟨-, Q, hQ⟩ := hS
    exact ⟨Q, by rw [hQ, Subgroup.subgroupOf_map_subtype, inf_of_le_left hSM]⟩
  have hSHsyl : CFSG.ABGLocalTools.IsSylowOf 2 (S ⊓ H) H :=
    hSMsyl.inf_of_le_normalizer hHMle hMH
  have hRSH : R ≤ S ⊓ H := le_inf hRS hRH
  have hSH2 : IsPGroup 2 ↥(S ⊓ H) := hS2.to_le (inf_le_left : S ⊓ H ≤ S)
  have hSHeq : S ⊓ H = R :=
    CFSG.ABGLocalTools.IsSylowOf.eq_of_le hRHsyl hRSH inf_le_right hSH2
  have hSNH : S ≤ normalizer (H : Set G) := hSM.trans hMH
  have hSNR : S ≤ normalizer (R : Set G) := by
    intro s hs
    rw [← hSHeq, Subgroup.mem_normalizer_iff_map_conj_eq,
      Subgroup.map_inf _ _ _ (MulAut.conj s).injective,
      Subgroup.mem_normalizer_iff_map_conj_eq.mp (S.le_normalizer hs),
      Subgroup.mem_normalizer_iff_map_conj_eq.mp (hSNH hs)]
  let A₀ : Subgroup G := zGammaThree R
  have hA₀R : A₀ ≤ R := zGammaThree_le R
  have hA₀P : A₀ ≤ P := hA₀R.trans hRAW
  have hA₀S : A₀ ≤ S := hA₀R.trans hRS
  have hA₀H : A₀ ≤ H := hA₀P.trans hPH
  have hSA₀ : S ≤ normalizer (A₀ : Set G) := fun s hs =>
    mem_normalizer_zGammaThree (hSNR hs)
  have hA₀C : A₀ ≤ centralizer ({t} : Set G) := hA₀P.trans hc.le_centralizer
  have hOddInOdd : Odd (Nat.card (oddIn M)) := by
    rw [oddIn, Subgroup.card_map_of_injective M.subtype_injective]
    exact hOodd
  have hg_range : (π.comp (Subgroup.inclusion hPM)).range = L := by
    ext x
    constructor
    · rintro ⟨p, rfl⟩
      rw [← hPL]
      exact Subgroup.mem_map.mpr ⟨Subgroup.inclusion hPM p,
        Subgroup.mem_subgroupOf.mpr p.2, rfl⟩
    · intro hx
      rw [← hPL] at hx
      obtain ⟨pm, hpmsub, hpm⟩ := Subgroup.mem_map.mp hx
      refine ⟨⟨(pm : ↥M).1, Subgroup.mem_subgroupOf.mp hpmsub⟩, ?_⟩
      show π (Subgroup.inclusion hPM ⟨(pm : ↥M).1, Subgroup.mem_subgroupOf.mp hpmsub⟩) = x
      have hinc : Subgroup.inclusion hPM
          ⟨(pm : ↥M).1, Subgroup.mem_subgroupOf.mp hpmsub⟩ = pm := by
        apply Subtype.ext
        rfl
      rw [hinc]
      exact hpm
  let f : ↥P →* ↥L := (π.comp (Subgroup.inclusion hPM)).codRestrict L (fun x => by
    have h : (π.comp (Subgroup.inclusion hPM)) x ∈ (π.comp (Subgroup.inclusion hPM)).range :=
      ⟨x, rfl⟩
    rwa [hg_range] at h)
  have hf_surj : Function.Surjective f := by
    intro y
    have hy : (y : X) ∈ (π.comp (Subgroup.inclusion hPM)).range := by
      rw [hg_range]
      exact y.2
    obtain ⟨x, hx⟩ := hy
    exact ⟨x, Subtype.ext hx⟩
  have hfcard : Nat.card ↥f.ker * Nat.card ↥L = Nat.card ↥P := by
    have h1 := Subgroup.card_ker_mul_card_range f
    rwa [MonoidHom.range_eq_top.mpr hf_surj, Subgroup.card_top] at h1
  have hf_ker_odd : Odd (Nat.card f.ker) := by
    have hkerL : Nat.card ↥f.ker = Nat.card ↥(P ⊓ oddIn M) := by
      apply Nat.eq_of_mul_eq_mul_right (Nat.card_pos (α := ↥L))
      rw [hfcard, ← hPcard]
    rw [hkerL]
    exact Odd.of_dvd_nat hOddInOdd
      (Subgroup.card_dvd_of_le (H := P ⊓ oddIn M) (K := oddIn M) inf_le_right)
  obtain ⟨-, R', hR'⟩ := hR
  have hDR : (R' : Subgroup ↥P).map P.subtype = R := by
    rw [hR', Subgroup.subgroupOf_map_subtype, inf_of_le_left hRAW]
  have key : ∀ n : ℕ, (∀ T : Sylow 2 ↥L, IsElemTwo (zGammaThree (T : Subgroup ↥L)) ∧
      Nat.card (zGammaThree (T : Subgroup ↥L)) = n) → IsElemTwo A₀ ∧ Nat.card A₀ = n := by
    intro n hF
    obtain ⟨he, hc'⟩ := isElemTwo_card_zGammaThree_of_surjective hf_surj hf_ker_odd hF R'
    have hz : A₀ = (zGammaThree (R' : Subgroup ↥P)).map P.subtype := by
      rw [show A₀ = zGammaThree ((R' : Subgroup ↥P).map P.subtype) from by rw [hDR]]
      exact (map_zGammaThree_of_injOn P.subtype P.subtype_injective.injOn).symm
    refine ⟨?_, ?_⟩
    · rw [hz]
      refine ⟨fun x hx y hy => ?_, fun x hx => ?_⟩
      · obtain ⟨a, ha, rfl⟩ := Subgroup.mem_map.mp hx
        obtain ⟨b, hb, rfl⟩ := Subgroup.mem_map.mp hy
        rw [← map_mul, ← map_mul, he.1 a ha b hb]
      · obtain ⟨a, ha, rfl⟩ := Subgroup.mem_map.mp hx
        rw [← map_mul, he.2 a ha, map_one]
    · rw [hz, Subgroup.card_map_of_injective P.subtype_injective, hc']
  have hSinfOdd : S ⊓ oddIn M = ⊥ := by
    refine Subgroup.inf_eq_bot_of_coprime ?_
    obtain ⟨k, hk⟩ := (IsPGroup.iff_card (p := 2) (G := ↥S)).mp hS2
    rw [hk]
    exact (Nat.coprime_two_left.mpr hOddInOdd).pow_left k
  have hZcard : Nat.card (Subgroup.center ↥L) = 2 := by
    refine le_antisymm hZ ?_
    have h1 : 1 < Nat.card (Subgroup.center ↥L) :=
      (Subgroup.one_lt_card_iff_ne_bot _).mpr hZL
    omega
  have hLperf : Group.IsPerfect ↥L := hL.1.1
  have hLnt : Nontrivial ↥L := by
    rw [← Finite.one_lt_card_iff_nontrivial]
    calc 1 < Nat.card (Subgroup.center ↥L) := by rw [hZcard]; norm_num
      _ ≤ Nat.card ↥L := Subgroup.card_le_card_group (H := Subgroup.center ↥L)
  obtain ⟨zC, hzCord⟩ :=
    exists_prime_orderOf_dvd_card' (G := ↥(Subgroup.center ↥L)) 2 (by rw [hZcard])
  let z : ↥L := (zC : ↥L)
  have hzcentral : z ∈ Subgroup.center ↥L := zC.2
  have hzord : orderOf z = 2 := by
    have h : orderOf (zC : ↥L) = orderOf zC := Subgroup.orderOf_coe zC
    rw [show z = (zC : ↥L) from rfl, h, hzCord]
  have hz2 : z * z = 1 := by
    rw [← pow_two]
    have h := pow_orderOf_eq_one z
    rwa [hzord] at h
  have hz2X : (z : X) * (z : X) = 1 := by
    have h := congrArg (fun w : ↥L => (w : X)) hz2
    simpa using h
  let Zx : Subgroup X := (Subgroup.center ↥L).map L.subtype
  have hZxcard : Nat.card Zx = 2 := by
    rw [show Zx = (Subgroup.center ↥L).map L.subtype from rfl,
      Subgroup.card_map_of_injective L.subtype_injective, hZcard]
  haveI : L.Normal := hLn
  have hZxnorm : Zx.Normal := by
    change ((Subgroup.center ↥L).map L.subtype).Normal
    exact ConjAct.normal_of_characteristic_of_normal
  have hZx_le_center : Zx ≤ Subgroup.center X :=
    CFSG.ABGLocalTools.le_center_of_normal_of_card_eq_two hZxnorm hZxcard
  have hzX_center : (z : X) ∈ Subgroup.center X :=
    hZx_le_center (Subgroup.mem_map_of_mem L.subtype zC.2)
  have hzXcomm : ∀ y : X, y * (z : X) = (z : X) * y := fun y =>
    Subgroup.mem_center_iff.mp hzX_center y
  have hinjπS : Set.InjOn π ((S.subgroupOf M : Subgroup ↥M) : Set ↥M) := by
    intro x hx y hy hxy
    have hmem : x * y⁻¹ ∈ (S.subgroupOf M) ⊓ pPrimeCore 2 ↥M := by
      refine Subgroup.mem_inf.mpr ⟨(S.subgroupOf M).mul_mem hx ((S.subgroupOf M).inv_mem hy), ?_⟩
      rw [← QuotientGroup.ker_mk' (pPrimeCore 2 ↥M), MonoidHom.mem_ker, map_mul, map_inv, hxy,
        mul_inv_cancel]
    have hmemG : M.subtype (x * y⁻¹) ∈ S ⊓ oddIn M := by
      refine Subgroup.mem_inf.mpr ⟨hmem.1, ?_⟩
      rw [oddIn]
      exact Subgroup.mem_map.mpr ⟨x * y⁻¹, hmem.2, rfl⟩
    rw [hSinfOdd] at hmemG
    have h1 : M.subtype (x * y⁻¹) = 1 := Subgroup.mem_bot.mp hmemG
    have h2 : x * y⁻¹ = 1 := M.subtype_injective h1
    exact mul_inv_eq_one.mp h2
  have hzL2 : IsPGroup 2 (Subgroup.zpowers z) := (isElemTwo_zpowers hz2).isPGroup
  haveI : (Subgroup.zpowers z).Normal :=
    Subgroup.normal_of_le_center (Subgroup.zpowers_le.mpr hzcentral)
  have hz_syl : z ∈ (R'.mapSurjective hf_surj : Subgroup ↥L) := by
    have hle : Subgroup.zpowers z ≤ (R'.mapSurjective hf_surj : Subgroup ↥L) :=
      IsPGroup.le_sylow_of_normal hzL2 (R'.mapSurjective hf_surj)
    exact hle (Subgroup.mem_zpowers z)
  have hz_syl' : z ∈ (R' : Subgroup ↥P).map f := by
    simpa only [Sylow.coe_mapSurjective] using hz_syl
  obtain ⟨r, hrR', hfr⟩ := Subgroup.mem_map.mp hz_syl'
  let a : ↥M := ⟨r.1, hPM r.2⟩
  have haS : a ∈ S.subgroupOf M := by
    have hrR : r.1 ∈ R := by
      rw [← hDR]
      exact Subgroup.mem_map.mpr ⟨r, hrR', rfl⟩
    rw [Subgroup.mem_subgroupOf]
    exact hRS hrR
  have haπX : π a = (z : X) := by
    have h1 : (f r : X) = π a := rfl
    exact h1.symm.trans (congrArg Subtype.val hfr)
  have ha2 : a * a = 1 := by
    have hmem : a * a ∈ S.subgroupOf M := (S.subgroupOf M).mul_mem haS haS
    have hπ1 : π (a * a) = 1 := by
      rw [map_mul, haπX, hz2X]
    exact hinjπS hmem ((S.subgroupOf M).one_mem) (by rw [hπ1, map_one])
  have ha1 : a ≠ 1 := by
    intro h
    have hz1X : (z : X) = 1 := by
      rw [← haπX, h, map_one]
    have hz1 : z = 1 := Subtype.ext hz1X
    rw [hz1, orderOf_one] at hzord
    omega
  have hFacts2 : ∀ T : Sylow 2 ↥L, IsElemTwo (zGammaThree (T : Subgroup ↥L)) ∧
      Nat.card (zGammaThree (T : Subgroup ↥L)) = 32 :=
    fun T => ⟨(hF2 ↥L hLperf hZcard hLty T).1, (hF2 ↥L hLperf hZcard hLty T).2.1⟩
  obtain ⟨hA₀e, hA₀card⟩ := key 32 hFacts2
  have h3 : IsThreeConnected S :=
    isThreeConnected_of_normal hS2 hA₀S hSA₀ hA₀e (by omega)
  have hSylA₀ : IsSylowTwoIn S (normalizer (wGroup A₀)) := by
    rw [hc.wGroup_eq A₀ hA₀C hA₀e (by omega), ← hM]
    exact hS
  obtain ⟨⟨T, hT⟩, -⟩ :=
    sylow_and_fusion_of_threeConnected hc.gwTwoBalanced hA₀e
      (by omega) hSylA₀ h3
  have hrank : ∀ b : G, b ∈ S → b * b = 1 →
      3 ≤ pRank 2 ↥(S ⊓ centralizer ({b} : Set G)) := by
    intro b hbS hb2
    have hbN : b ∈ normalizer (A₀ : Set G) := hSA₀ hbS
    have hcard := GrSLit.card_le_card_inf_centralizer_sq hA₀e hbN hb2
    have hCe : IsElemTwo (A₀ ⊓ centralizer ({b} : Set G)) := hA₀e.mono inf_le_left
    obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp hCe.isPGroup
    have h32 : 32 ≤ Nat.card ↥(A₀ ⊓ centralizer ({b} : Set G)) ^ 2 := by
      calc 32 = Nat.card A₀ := hA₀card.symm
        _ ≤ Nat.card ↥(A₀ ⊓ centralizer ({b} : Set G)) ^ 2 := hcard
    have h32' : 32 ≤ (2 ^ n) ^ 2 := hn ▸ h32
    have hn3 : 3 ≤ n := by
      by_contra h
      push Not at h
      interval_cases n <;> norm_num at h32'
    have hC8 : 8 ≤ Nat.card ↥(A₀ ⊓ centralizer ({b} : Set G)) := by
      calc 8 = 2 ^ 3 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn3
        _ = Nat.card ↥(A₀ ⊓ centralizer ({b} : Set G)) := hn.symm
    refine le_trans (hCe.three_le_pRank hC8) (Sol78.pRank_le_of_le ?_)
    exact le_inf (inf_le_left.trans hA₀S) inf_le_right
  let aG : G := M.subtype a
  have haG2 : aG * aG = 1 := by
    change M.subtype a * M.subtype a = 1
    rw [← map_mul, ha2, map_one]
  have haGS : aG ∈ S := Subgroup.mem_subgroupOf.mp haS
  let A : Subgroup G := Subgroup.zpowers aG
  have hAS : A ≤ S := Subgroup.zpowers_le.mpr haGS
  have hAne : A ≠ ⊥ := by
    intro h
    have hmem : aG ∈ (⊥ : Subgroup G) := h ▸ Subgroup.mem_zpowers aG
    have haG1 : aG = 1 := Subgroup.mem_bot.mp hmem
    apply ha1
    apply M.subtype_injective
    simpa [aG] using haG1
  have hclosed : ∀ x ∈ A, ∀ g : G, g⁻¹ * x * g ∈ (T : Subgroup G) → g⁻¹ * x * g ∈ A := by
    intro x hx g hgT
    have hgS : g⁻¹ * x * g ∈ S := by rwa [hT] at hgT
    rcases (CFSG.LargeExtraspecial.Setting.mem_zpowers_iff_of_mul_self haG2).mp hx with
      rfl | rfl
    · simp
    · have hrank_a : 3 ≤ pRank 2 ↥(S ⊓ centralizer ({aG} : Set G)) := hrank aG haGS haG2
      have hconj2 : (g⁻¹ * aG * g) * (g⁻¹ * aG * g) = 1 := by
        rw [show (g⁻¹ * aG * g) * (g⁻¹ * aG * g) = g⁻¹ * (aG * aG) * g by group, haG2]
        group
      have hrank_y : 3 ≤ pRank 2 ↥(S ⊓ centralizer ({g⁻¹ * aG * g} : Set G)) :=
        hrank (g⁻¹ * aG * g) hgS hconj2
      obtain ⟨m, hm, hmeq⟩ := conj_eq_of_threeConnected hc.gwTwoBalanced hA₀e
        (by omega) hSylA₀ h3 aG haGS g hgS hrank_a hrank_y
      have hmM : m ∈ M := by
        rw [hM, ← hc.wGroup_eq A₀ hA₀C hA₀e (by omega)]
        exact hm
      let m' : ↥M := ⟨m, hmM⟩
      have hm_eq : m = M.subtype m' := rfl
      have hy_eq_m : (⟨g⁻¹ * aG * g, hSM hgS⟩ : ↥M) = m'⁻¹ * a * m' := by
        apply Subtype.ext
        show g⁻¹ * aG * g = M.subtype (m'⁻¹ * a * m')
        rw [hmeq, hm_eq]
        change M.subtype m'⁻¹ * M.subtype a * M.subtype m' = M.subtype (m'⁻¹ * a * m')
        simp only [← map_mul, ← map_inv]
      have hπ_left : π ⟨g⁻¹ * aG * g, hSM hgS⟩ = (z : X) := by
        rw [hy_eq_m, map_mul, map_mul, map_inv, haπX]
        calc (π m')⁻¹ * (z : X) * π m' = (π m')⁻¹ * ((z : X) * π m') := by group
          _ = (π m')⁻¹ * (π m' * (z : X)) := by rw [← hzXcomm (π m')]
          _ = (z : X) := by group
      have hy_eq : (⟨g⁻¹ * aG * g, hSM hgS⟩ : ↥M) = a := by
        refine hinjπS (Subgroup.mem_subgroupOf.mpr hgS) haS ?_
        rw [hπ_left, haπX]
      have hfix : g⁻¹ * aG * g = aG := by
        have h := congrArg (fun w : ↥M => M.subtype w) hy_eq
        simpa [aG] using h
      rw [hfix]
      exact Subgroup.mem_zpowers aG
  haveI hGsimple : IsSimpleGroup G := hc.base.1
  have htopF : GeneralizedFitting.subgroup G = ⊤ :=
    GSLit.generalizedFitting_eq_top_of_simple
  let eF : GeneralizedFitting.subgroup G ≃* G := (MulEquiv.subgroupCongr htopF).trans topEquiv
  have hsF : IsSimpleGroup (GeneralizedFitting.subgroup G) := eF.isSimpleGroup
  have hnF : ∃ u v : GeneralizedFitting.subgroup G, u * v ≠ v * u := by
    obtain ⟨u, v, huv⟩ := hc.base.2.1
    exact ⟨eF.symm u, eF.symm v, fun huv' =>
      huv (eF.symm.injective (by rw [map_mul, map_mul, huv']))⟩
  have hsolvA : Group.IsSolvable ↥(Subgroup.centralizer (A : Set G)) :=
    hGold G hsF hnF T A (hT ▸ hAS) hAne hclosed
  let E : Subgroup ↥M := Subgroup.zpowers a
  let CHM : Subgroup ↥M := HM ⊓ Subgroup.centralizer (E : Set ↥M)
  have hmapCHM : CHM.map π = L := by
    have hE2 : IsPGroup 2 E := (isElemTwo_zpowers ha2).isPGroup
    haveI : HM.Normal := hHMnorm
    have hEY : E ≤ Subgroup.normalizer (HM : Set ↥M) :=
      Subgroup.le_normalizer_of_normal (H := HM) (K := E)
    have hφodd : ¬ 2 ∣ Nat.card π.ker := by
      rw [QuotientGroup.ker_mk' (pPrimeCore 2 ↥M)]
      exact hOodd.not_two_dvd_nat
    have hker : ¬ 2 ∣ Nat.card (π.domRestrict HM).ker :=
      CFSG.ComponentClassification.GSThmB.OddQuot.not_two_dvd_card_ker_domRestrict π hφodd HM
    have hmap := CFSG.ComponentClassification.GSThmB.OddQuot.map_inf_centralizer π hE2 hEY hker
    rw [show CHM = HM ⊓ Subgroup.centralizer (E : Set ↥M) from rfl, hmap]
    have hHMmap : HM.map π = L := by
      rw [show HM = L.comap π from rfl]
      exact Subgroup.map_comap_eq_self_of_surjective
        (QuotientGroup.mk'_surjective (pPrimeCore 2 ↥M)) L
    rw [hHMmap]
    have hEmapeq : E.map π = Subgroup.zpowers (z : X) := by
      rw [show E = Subgroup.zpowers a from rfl, MonoidHom.map_zpowers, haπX]
    rw [hEmapeq]
    have hcentz : Subgroup.centralizer ((Subgroup.zpowers (z : X) : Subgroup X) : Set X) = ⊤ :=
      Subgroup.centralizer_eq_top_iff_subset.mpr (Subgroup.zpowers_le.mpr hzX_center)
    rw [hcentz, inf_top_eq]
  have hsolvCHM : Group.IsSolvable ↥CHM := by
    haveI : Group.IsSolvable ↥(Subgroup.centralizer (A : Set G)) := hsolvA
    have hle : Subgroup.centralizer (A : Set G) ≤ Subgroup.centralizer ({aG} : Set G) :=
      Subgroup.centralizer_le (by
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        rw [hx]
        exact Subgroup.mem_zpowers aG)
    have hCeq : Subgroup.centralizer (A : Set G) =
        Subgroup.centralizer ({aG} : Set G) := by
      rw [show A = Subgroup.zpowers aG from rfl, Subgroup.zpowers_eq_closure,
        Subgroup.centralizer_closure]
    have hsolvCaG : Group.IsSolvable ↥(Subgroup.centralizer ({aG} : Set G)) :=
      hCeq ▸ hsolvA
    haveI : Group.IsSolvable ↥(Subgroup.centralizer ({aG} : Set G)) := hsolvCaG
    let fCH : ↥CHM →* ↥(Subgroup.centralizer ({aG} : Set G)) :=
      { toFun := fun x =>
          ⟨(x.1 : G), by
            rw [Subgroup.mem_centralizer_singleton_iff]
            have hxE : x.1 ∈ Subgroup.centralizer (E : Set ↥M) := x.2.2
            have hcomm := Subgroup.mem_centralizer_iff.mp hxE a (Subgroup.mem_zpowers a)
            exact congrArg (fun w : ↥M => (w : G)) hcomm.symm⟩
        map_one' := by ext; rfl
        map_mul' := by intro x y; ext; rfl }
    refine Group.isSolvable_of_isSolvable_injective (f := fCH) ?_
    intro x y hxy
    apply Subtype.ext
    exact M.subtype_injective
      (congrArg (fun w : ↥(Subgroup.centralizer ({aG} : Set G)) => (w : G)) hxy)
  let fL : ↥CHM →* ↥L := (π.comp CHM.subtype).codRestrict L (fun x => by
    have hx : π (x : ↥M) ∈ CHM.map π := Subgroup.mem_map_of_mem π x.2
    rwa [hmapCHM] at hx)
  have hfL_surj : Function.Surjective fL := by
    intro y
    have hy : (y : X) ∈ CHM.map π := by rw [hmapCHM]; exact y.2
    obtain ⟨x, hx, hxy⟩ := Subgroup.mem_map.mp hy
    exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩
  have hsolvL : Group.IsSolvable ↥L := by
    haveI : Group.IsSolvable ↥CHM := hsolvCHM
    exact Group.isSolvable_of_surjective hfL_surj
  haveI : Nontrivial ↥L := hLnt
  haveI : Group.IsPerfect ↥L := hLperf
  exact Group.IsPerfect.not_isSolvable ↥L hsolvL

theorem false_of_suz_normal_component (hGold : GoldschmidtStronglyClosedInput)
    (hF1 : SuzSylowFacts) (hF2 : TwoSuzSylowFacts)
    {G : Type} [Group G] [Finite G] {t : G} {P W M : Subgroup G}
    (hc : L34WConfigAt (fun X _ => Blueprint.NativeSporadic.IsSporadic X .Suz) G t P W)
    (hM : M = normalizer (W : Set G)) (htM : t ∈ M)
    {L : Subgroup (↥M ⧸ pPrimeCore 2 ↥M)} (hL : IsComponent L) (hLn : L.Normal)
    (hZ : Nat.card (Subgroup.center ↥L) ≤ 2)
    (hLty : IsSporadic (↥L ⧸ Subgroup.center ↥L) .Suz)
    (hPL : (P.subgroupOf M).map (QuotientGroup.mk' (pPrimeCore 2 ↥M)) = L)
    (hcent : ∀ x ∈ L, QuotientGroup.mk' (pPrimeCore 2 ↥M) ⟨t, htM⟩ * x =
      x * QuotientGroup.mk' (pPrimeCore 2 ↥M) ⟨t, htM⟩) : False := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let X := ↥M ⧸ pPrimeCore 2 ↥M
  let π : ↥M →* X := QuotientGroup.mk' (pPrimeCore 2 ↥M)
  let HM : Subgroup ↥M := L.comap π
  let KM : Subgroup ↥M := (Subgroup.centralizer (L : Set X)).comap π
  let H : Subgroup G := HM.map M.subtype
  let K : Subgroup G := KM.map M.subtype
  have hHMle : H ≤ M := Subgroup.map_subtype_le HM
  have hKMle : K ≤ M := Subgroup.map_subtype_le KM
  have hHMnorm : HM.Normal := hLn.comap π
  have hKMnorm : KM.Normal := by
    have : L.Normal := hLn
    exact Subgroup.Normal.comap (Subgroup.normal_centralizer (H := L)) π
  have hHsub : H.subgroupOf M = HM := by
