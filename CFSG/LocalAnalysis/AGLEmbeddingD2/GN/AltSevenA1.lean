section Assembly

variable {X : Type} [Group X] [Finite X] {T : Subgroup X}

omit [Finite X] in
theorem exists_action_of_invariant {U : Subgroup X} (hUV : U ≤ gnV T)
    {L : Subgroup (X ⧸ gnC T)}
    (hU : ∀ k ∈ L.comap (QuotientGroup.mk' (gnC T)), ∀ u ∈ U, k * u * k⁻¹ ∈ U) :
    ∃ ρ : ↥L →* MulAut ↥U, ∀ (l : X) (hl : QuotientGroup.mk' (gnC T) l ∈ L) (u : ↥U),
      ((ρ ⟨QuotientGroup.mk' (gnC T) l, hl⟩ u : ↥U) : X) = l * u * l⁻¹ := by
  classical
  let mk : X →* X ⧸ gnC T := QuotientGroup.mk' (gnC T)
  let K : Subgroup X := L.comap mk
  let f : ↥K →* ↥L := (mk.comp K.subtype).codRestrict L (fun k => k.2)
  have hf : Function.Surjective f := by
    intro l
    obtain ⟨x, hx⟩ := QuotientGroup.mk_surjective (l : X ⧸ gnC T)
    refine ⟨⟨x, ?_⟩, Subtype.ext hx⟩
    show mk x ∈ L
    rw [show mk x = (l : X ⧸ gnC T) from hx]
    exact l.2
  let ρK : ↥K →* MulAut ↥U :=
    { toFun := fun k =>
        { toFun := fun u => ⟨(k : X) * u * (k : X)⁻¹, hU k k.2 u u.2⟩
          invFun := fun u => ⟨(k : X)⁻¹ * u * ((k : X)⁻¹)⁻¹, hU (k : X)⁻¹ (K.inv_mem k.2) u u.2⟩
          left_inv := fun u => Subtype.ext (by simp [mul_assoc])
          right_inv := fun u => Subtype.ext (by simp [mul_assoc])
          map_mul' := fun a b => Subtype.ext (by simp [mul_assoc]) }
      map_one' := MulEquiv.ext fun u => Subtype.ext (by simp)
      map_mul' := fun k₁ k₂ => MulEquiv.ext fun u => Subtype.ext (by simp [mul_assoc]) }
  have hker : f.ker ≤ ρK.ker := by
    intro k hk
    rw [MonoidHom.mem_ker] at hk ⊢
    have h1 : ((k : X) : X ⧸ gnC T) = 1 := congrArg Subtype.val hk
    have h2 : (k : X) ∈ gnC T := (QuotientGroup.eq_one_iff (k : X)).1 h1
    rw [gnC, Subgroup.mem_centralizer_iff] at h2
    refine MulEquiv.ext fun u => Subtype.ext ?_
    show (k : X) * u * (k : X)⁻¹ = u
    rw [mul_inv_eq_iff_eq_mul]
    exact (h2 u (hUV u.2)).symm
  refine ⟨MonoidHom.liftOfSurjective f hf ⟨ρK, hker⟩, fun l hl u => ?_⟩
  have h1 : (⟨mk l, hl⟩ : ↥L) = f ⟨l, hl⟩ := rfl
  rw [h1, MonoidHom.liftOfRightInverse_comp_apply]
  rfl

theorem exists_three_mem_centralizer_of_fixing (hX : GNSetting X T)
    {L : Subgroup (X ⧸ gnC T)} (hL : IsComponentOf L ⊤) {U : Subgroup X} (hUV : U ≤ gnV T)
    (hU : ∀ k ∈ L.comap (QuotientGroup.mk' (gnC T)), ∀ u ∈ U, k * u * k⁻¹ ∈ U)
    (hZU : ∀ z ∈ omegaOneCenterOf T, ∀ k ∈ L.comap (QuotientGroup.mk' (gnC T)),
      k * z * k⁻¹ * z⁻¹ ∈ U)
    (hfix : ∀ ρ : ↥L →* MulAut ↥U,
      (∀ (l : X) (hl : QuotientGroup.mk' (gnC T) l ∈ L) (u : ↥U),
        ((ρ ⟨QuotientGroup.mk' (gnC T) l, hl⟩ u : ↥U) : X) = l * u * l⁻¹) →
      ∀ S : Subgroup ↥L, IsPGroup 2 S → ¬ 2 ∣ S.index →
        ∃ x : ↥L, orderOf x = 3 ∧ ∀ u : ↥U, (∀ s ∈ S, ρ s u = u) → ρ x u = u) :
    ∃ x ∈ gnImg T (Subgroup.centralizer (omegaOneCenterOf T : Set X)) ⊓ L, orderOf x = 3 := by
  classical
  let mk : X →* X ⧸ gnC T := QuotientGroup.mk' (gnC T)
  let K : Subgroup X := L.comap mk
  obtain ⟨ρ, hρ⟩ := exists_action_of_invariant hUV hU
  let f : ↥K →* ↥L := (mk.comp K.subtype).codRestrict L (fun k => k.2)
  have hf : Function.Surjective f := by
    intro l
    obtain ⟨x, hx⟩ := QuotientGroup.mk_surjective (l : X ⧸ gnC T)
    refine ⟨⟨x, ?_⟩, Subtype.ext hx⟩
    show mk x ∈ L
    rw [show mk x = (l : X ⧸ gnC T) from hx]
    exact l.2
  have hSyl : IsSylowTwoOf (gnImg T T ⊓ L) L :=
    L246C127.isSylowTwoOf_inf_of_isSubnormal' hL.2.1 (isSylowTwoOf_gnImg_top hX)
  let S' : Subgroup (X ⧸ gnC T) := gnImg T T ⊓ L
  let S : Subgroup X := S'.comap mk
  have hSK : S ≤ K := fun s hs => hs.2
  have hSsub : S.subgroupOf K = (S'.subgroupOf L).comap f := by
    ext k; exact Iff.rfl
  have hSodd : ¬ 2 ∣ (S.subgroupOf K).index := by
    rw [hSsub, Subgroup.index_comap_of_surjective _ hf]
    exact hSyl.2.2
  have hS₀ : IsPGroup 2 (S'.subgroupOf L) :=
    hSyl.2.1.of_surjective (Subgroup.subgroupOfEquivOfLe hSyl.1).symm.toMonoidHom
      (Subgroup.subgroupOfEquivOfLe hSyl.1).symm.surjective
  obtain ⟨x, hxo, hxfix⟩ := hfix ρ hρ (S'.subgroupOf L) hS₀ hSyl.2.2
  obtain ⟨k, hk⟩ := QuotientGroup.mk_surjective (x : X ⧸ gnC T)
  have hkK : k ∈ K := by
    show mk k ∈ L
    rw [show mk k = (x : X ⧸ gnC T) from hk]
    exact x.2
  have hxk : x = ⟨mk k, hkK⟩ := Subtype.ext hk.symm
  have hVab := isElemAbelian_gnV T hX
  have hVc : ∀ v ∈ gnV T, ∀ w ∈ gnV T, v * w = w * v := fun v hv w hw =>
    congrArg Subtype.val (hVab.1.is_comm.comm ⟨v, hv⟩ ⟨w, hw⟩)
  have hV2 : ∀ v ∈ gnV T, v * v = 1 := fun v hv => by
    have := hVab.2 v hv
    simpa [pow_two] using this
  have hZV : omegaOneCenterOf T ≤ gnV T := fun z hz => Subgroup.subset_normalClosure hz
  have hkc : ∀ z ∈ omegaOneCenterOf T, (k : X) * z * (k : X)⁻¹ = z := by
    intro z hz
    have hzU := hZU z hz k hkK
    obtain ⟨m, hmU, hm, hmS⟩ := exists_fixed_mem_comm_eq (gnV T) U K S hVc hV2 hUV hU hSK hSodd z
      (hZV hz) (hZU z hz)
      (fun s hs => comm_of_mem_gnImg hs.1 hz)
    let um : ↥U := ⟨m, hmU⟩
    have hum : ∀ s ∈ S'.subgroupOf L, ρ s um = um := by
      intro s₀ hs₀
      obtain ⟨s, hs⟩ := QuotientGroup.mk_surjective (s₀ : X ⧸ gnC T)
      have hsL : mk s ∈ L := by
        show mk s ∈ L
        rw [show mk s = (s₀ : X ⧸ gnC T) from hs]
        exact s₀.2
      have hsS : s ∈ S := by
        show mk s ∈ S'
        rw [show mk s = (s₀ : X ⧸ gnC T) from hs]
        exact hs₀
      have hs₀' : s₀ = ⟨mk s, hsL⟩ := Subtype.ext hs.symm
      apply Subtype.ext
      rw [hs₀', hρ s hsL um]
      exact hmS s hsS
    have h1 := hxfix um hum
    have h2 : (k : X) * m * (k : X)⁻¹ = m := by
      have := congrArg Subtype.val h1
      rw [hxk, hρ k hkK um] at this
      exact this
    have h3 := hm k hkK
    rw [h2, mul_inv_cancel] at h3
    have h4 : (k : X) * z * (k : X)⁻¹ * z⁻¹ = 1 := h3
    exact mul_inv_eq_one.1 h4
  refine ⟨(x : X ⧸ gnC T), ⟨⟨k, ?_, hk⟩, x.2⟩, by rw [Subgroup.orderOf_coe]; exact hxo⟩
  rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
  intro z hz
  have := hkc z hz
  rw [mul_inv_eq_iff_eq_mul] at this
  exact this.symm

omit [Finite X] in
theorem conj_mul_inv_mem_commutator {W K : Subgroup X} {z k : X} (hz : z ∈ W) (hk : k ∈ K) :
    k * z * k⁻¹ * z⁻¹ ∈ ⁅W, K⁆ := by
  have h1 : ⁅z, k⁆ ∈ ⁅W, K⁆ := Subgroup.commutator_mem_commutator hz hk
  have h2 : k * z * k⁻¹ * z⁻¹ = (⁅z, k⁆)⁻¹ := by
    simp only [commutatorElement_def]
    group
  rw [h2]
  exact Subgroup.inv_mem _ h1

theorem exists_three_fixing_of_naturalOn (hX : GNSetting X T) {L : Subgroup (X ⧸ gnC T)}
    (e : ↥L ≃* alternatingGroup (Fin 7)) (g : ↥L →* alternatingGroup (Fin 7))
    (hg : Function.Surjective g) {W : Subgroup X} (hWV : W ≤ gnV T)
    (hWK : ∀ k ∈ L.comap (QuotientGroup.mk' (gnC T)), ∀ w ∈ W, k * w * k⁻¹ ∈ W)
    (π : ↥⁅W, L.comap (QuotientGroup.mk' (gnC T))⁆ →* Multiplicative (altHeart 7))
    (hπk : ∀ u, π u = 1 → ∀ k ∈ L.comap (QuotientGroup.mk' (gnC T)),
      (k : X) * u * (k : X)⁻¹ = u)
    (hπi : ∀ (l : X) (hl : QuotientGroup.mk' (gnC T) l ∈ L)
      (u u' : ↥⁅W, L.comap (QuotientGroup.mk' (gnC T))⁆),
      (u' : X) = l * u * l⁻¹ → ∀ x : evenWeight 7,
        Multiplicative.toAdd (π u) = (QuotientAddGroup.mk x : altHeart 7) →
        Multiplicative.toAdd (π u') = (QuotientAddGroup.mk (evenWeightPerm
          (g ⟨QuotientGroup.mk' (gnC T) l, hl⟩ : Equiv.Perm (Fin 7)) x) : altHeart 7))
    (ρ : ↥L →* MulAut ↥⁅W, L.comap (QuotientGroup.mk' (gnC T))⁆)
    (hρ : ∀ (l : X) (hl : QuotientGroup.mk' (gnC T) l ∈ L)
      (u : ↥⁅W, L.comap (QuotientGroup.mk' (gnC T))⁆),
      ((ρ ⟨QuotientGroup.mk' (gnC T) l, hl⟩ u : ↥⁅W, L.comap (QuotientGroup.mk' (gnC T))⁆) : X) =
        l * u * l⁻¹)
    (S : Subgroup ↥L) (hS : IsPGroup 2 S) (hodd : ¬ 2 ∣ S.index) :
    ∃ x : ↥L, orderOf x = 3 ∧
      ∀ u : ↥⁅W, L.comap (QuotientGroup.mk' (gnC T))⁆, (∀ s ∈ S, ρ s u = u) → ρ x u = u := by
  classical
  let mk : X →* X ⧸ gnC T := QuotientGroup.mk' (gnC T)
  let K : Subgroup X := L.comap mk
  have hginj : Function.Injective g := (Finite.injective_iff_surjective_of_equiv e.toEquiv).2 hg
  let e' : ↥L ≃* alternatingGroup (Fin 7) := MulEquiv.ofBijective g ⟨hginj, hg⟩
  have hVab := isElemAbelian_gnV T hX
  have hV2 : ∀ v ∈ gnV T, v * v = 1 := fun v hv => by
    have := hVab.2 v hv
    simpa [pow_two] using this
  have hUW : ⁅W, K⁆ ≤ W := commutator_le_of_invariant W K hWK
  have hU2 : ∀ u : ↥⁅W, K⁆, u * u = 1 := fun u => Subtype.ext (hV2 _ (hWV (hUW u.2)))
  have hlift : ∀ g' : ↥L, ∃ (l : X) (hl : mk l ∈ L), g' = ⟨mk l, hl⟩ := by
    intro g'
    obtain ⟨l, hl⟩ := QuotientGroup.mk_surjective (g' : X ⧸ gnC T)
    refine ⟨l, ?_, Subtype.ext hl.symm⟩
    show mk l ∈ L
    rw [show mk l = (g' : X ⧸ gnC T) from hl]
    exact g'.2
  refine exists_three_fixing_of_natural hU2 e' ρ π ?_ ?_ S hS hodd
  · intro u hu g'
    obtain ⟨l, hl, rfl⟩ := hlift g'
    apply Subtype.ext
    rw [hρ l hl u]
    exact hπk u hu l hl
  · intro g' u y hy
    obtain ⟨l, hl, rfl⟩ := hlift g'
    exact hπi l hl u (ρ ⟨mk l, hl⟩ u) (hρ l hl u) y hy

theorem exists_three_mem_centralizer_of_alt_seven_of_equiv (hGF : GF2EightFive)
    (hX : GNSetting X T) {L : Subgroup (X ⧸ gnC T)}
    (hL : IsComponentOf L ⊤) (hJ : ⁅L, gnImg T (thompsonJ T)⁆ = L)
    (e : ↥L ≃* alternatingGroup (Fin 7)) :
    ∃ x ∈ gnImg T (Subgroup.centralizer (omegaOneCenterOf T : Set X)) ⊓ L, orderOf x = 3 := by
  have hVab := isElemAbelian_gnV T hX
  have hV2 : ∀ v ∈ gnV T, v * v = 1 := fun v hv => by
    have := hVab.2 v hv
    simpa [pow_two] using this
  rcases exists_naturalOn_or_four_of_gf2EightFive hGF hX hL hJ e with
    ⟨g, W, π, hg, hWV, hZW, hWK, hπk, hπi⟩ | ⟨W, U, hWV, hZW, hWK, hWU, hUV, hU, hcard⟩
  · have hUW := commutator_le_of_invariant W (L.comap (QuotientGroup.mk' (gnC T))) hWK
    refine exists_three_mem_centralizer_of_fixing hX hL (hUW.trans hWV)
      (fun k hk u hu => conj_mem_commutator W _ hWK k hk hu)
      (fun z hz k hk => conj_mul_inv_mem_commutator (hZW hz) hk) ?_
    intro ρ hρ S hS hodd
    exact exists_three_fixing_of_naturalOn hX e g hg hWV hWK π hπk hπi ρ hρ S hS hodd
  · refine exists_three_mem_centralizer_of_fixing hX hL hUV hU
      (fun z hz k hk => hWU (conj_mul_inv_mem_commutator (hZW hz) hk)) ?_
    intro ρ hρ S hS hodd
    exact exists_three_fixing_four (fun u => Subtype.ext (hV2 _ (hUV u.2))) hcard e ρ S hS hodd

theorem exists_three_mem_centralizer_of_alt_seven
    (hGF : GF2EightFive) (hX : GNSetting X T)
    {L : Subgroup (X ⧸ gnC T)} (hL : IsComponentOf L ⊤)
    (hJ : ⁅L, gnImg T (thompsonJ T)⁆ = L)
    (he : Nonempty ((↥L ⧸ Subgroup.center ↥L) ≃* alternatingGroup (Fin 7))) :
    ∃ x ∈ gnImg T (Subgroup.centralizer (omegaOneCenterOf T : Set X)) ⊓ L, orderOf x = 3 := by
  have hZ1 : Subgroup.center ↥L = ⊥ := center_eq_bot_of_alt_seven hX hL hJ he
  let e : ↥L ≃* alternatingGroup (Fin 7) :=
    ((QuotientGroup.quotientMulEquivOfEq hZ1).trans QuotientGroup.quotientBot).symm.trans he.some
  exact exists_three_mem_centralizer_of_alt_seven_of_equiv hGF hX hL hJ e

theorem not_pElementSubgroup_three_gnA_le_center_seven
    (hGF : GF2EightFive) (hX : GNSetting X T)
    {L : Subgroup (X ⧸ gnC T)} (hL : IsComponentOf L ⊤)
    (hJ : ⁅L, gnImg T (thompsonJ T)⁆ = L)
    (he : Nonempty ((↥L ⧸ Subgroup.center ↥L) ≃* alternatingGroup (Fin 7)))
    {C₁ : Subgroup X} (h1 : C₁ ≤ omegaOneCenterOf T) :
    ¬ pElementSubgroup 3 (gnA T C₁ L) ≤ (Subgroup.center ↥L).map L.subtype := by
