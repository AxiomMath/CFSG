theorem d1For_of_canonical
    (hD1c : ∀ (G : Type) [Group G] [Finite G] [IsSimpleGroup G], (∃ a b : G, a * b ≠ b * a) →
      Open.IsKProper G → IsCharTwoType G → 4 ≤ evenRank G → GLBPreuniqueness G →
      ∀ p : ℕ, p ∈ GLBBetaFour G → ∀ (P : Sylow p G) (M : Subgroup G), GLBIsMaxTwoLocal M →
        GLBWeakCore p (P : Subgroup G) ≤ M → ∀ H : Subgroup G, IsTwoLocal H →
          3 ≤ Open.pRank p (H ⊓ M) → H ≤ M)
    (G : Type) [Group G] [Finite G] (h : CFSG.AGLEmbedding.D1Global G) : D1For G := by
  have := h.simple
  exact fun p hp P M hM hWM H hH hHM =>
    hD1c G h.nonab h.kProper h.charTwo h.rank h.pre p hp P M hM hWM H hH hHM


theorem lc_gl_embedding_theorem_d2_rank_four_of_d1
    (hD1 : ∀ (G : Type) [Group G] [Finite G], CFSG.AGLEmbedding.D1Global G → D1For G)
    (hLowN : CFSG.LieType.SeitzGeneration.KFactSeitzRankTwoLowN)
    (h93 : Asc81bNineThree)
    (hA8 : CFSG.CGT.T75P.A8SylowInput)
    (hNA : CFSG.CGT.PushingUpLit.SolKAb.SolomonTimmesfeldMainNonAbelian)
    (hS3 : D2PairStrongThree)
    (hnc : Tits.MsideParabolicEscape.D2L34BetaMSideNonConstrainedInput)
    (G : Type) [Group G] [Finite G] [IsSimpleGroup G] (hnonab : ∃ a b : G, a * b ≠ b * a)
    (hK : Open.IsKProper G) (hchar : IsCharTwoType G) (he : 4 ≤ evenRank G)
    (hδ₁ : GLBDeltaOne G) (hδ₂ : GLBDeltaTwo G) (p : ℕ) (hp : p ∈ GLBBetaFour G)
    (P : Sylow p G) (M : Subgroup G) (hM : GLBIsMaxTwoLocal M)
    (hPM : GLBCore p 2 (P : Subgroup G) ≤ M) (Q : Subgroup G) (hQ : IsPGroup p Q)
    (hQrank : Open.pRank p Q = 2) (hQM : GLBCore p 1 Q ≤ M) (H : Subgroup G) (hH : IsTwoLocal H)
    (hQH : Q ≤ H) : H ≤ M := by
  have hglob : D2Global G := ⟨‹_›, hnonab, hK, hchar, he, hδ₁, hδ₂⟩
  obtain ⟨hT2, hT25⟩ := aschbacherTwoK_solomonK_of_remaining hA8 hNA
  have hTPLT : CitedBlockTransvectionPLType :=
    CFSG.HardMathSupport.Curtis.UnitaryLevi.citedBlockTransvectionPLType_holds
  have hT1 : CFSG.CGT.PushingUpLit.AschbacherTheoremOneK :=
    CFSG.CGT.PushingUpLit.ThmOne.aschbacherTheoremOneK_of_inputs
      CFSG.CGT.PushingUpLit.K1R.stdKernelTwo_holds
      CFSG.HardMathSupport.Foote.Coordinator.endFoote_holds
      CFSG.HardMathSupport.RichardWeiss.ExceptionalClosure.stellmacherSixOneThree_holds
  have hFF := CFSG.HardMathSupport.Meierfrankenfeld.Coordinator.citedFFL34BestOffender
  have hin : Tits.MsideParabolicEscape.D2L34BetaMSideInput :=
    Tits.S3AmalgamBound.d2L34BetaMSideInput_of_group_step' hFF
      CFSG.HardMathSupport.Meierfrankenfeld.AGL81.agl81I59
      (CFSG.AGLEmbedding.d1NoXBlock_of_inputsK hT1 hT2 hT25) Tits.S3AmalgamBound.ffGroupStep
  exact d2_of_slice_ff_leaves hLowN h93 hT1 hT2 hT25
    (CFSG.AGLEmbedding.kFactBlockInvertedThree_holds h93 hTPLT) hTPLT
    kFactBlockAltFiveSquareParabolic_holds hS3 Wilson.Coordinator.d2HeisLocalAt_J4 hFF hin hnc
    kFactBlockFiveHeisParabolic_holds Norton.d2IndexCaseAt_M_seven_eleven_thirteen_holds G
    hnonab hK hchar he hδ₁ hδ₂ (hD1 G hglob.toD1Global) p hp P M hM hPM Q hQ hQrank hQM H hH hQH

