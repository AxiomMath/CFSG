variable {Y : Type} [Group Y]

theorem exists_centerQuot_hom (L : Subgroup Y) [L.Normal] :
    ∃ ψ : (↥L ⧸ Subgroup.center ↥L) →* (Y ⧸ Subgroup.centralizer (L : Set Y)),
      Function.Injective ψ ∧
      (∀ x : ↥L, ψ (QuotientGroup.mk' (Subgroup.center ↥L) x) =
        QuotientGroup.mk' (Subgroup.centralizer (L : Set Y)) (x : Y)) ∧
      ψ.range = L.map (QuotientGroup.mk' (Subgroup.centralizer (L : Set Y))) := by
  haveI : (Subgroup.centralizer (L : Set Y)).Normal := Subgroup.normal_centralizer
  have hker : Subgroup.center ↥L ≤
      ((QuotientGroup.mk' (Subgroup.centralizer (L : Set Y))).comp L.subtype).ker := by
    intro z hz
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
      QuotientGroup.eq_one_iff]
    refine Subgroup.mem_centralizer_iff.2 fun h hh => ?_
    exact congrArg Subtype.val ((Subgroup.mem_center_iff.1 hz) ⟨h, hh⟩)
  have hcomp : ∀ x : ↥L, QuotientGroup.lift (Subgroup.center ↥L)
      ((QuotientGroup.mk' (Subgroup.centralizer (L : Set Y))).comp L.subtype) hker
        (QuotientGroup.mk' (Subgroup.center ↥L) x) =
      QuotientGroup.mk' (Subgroup.centralizer (L : Set Y)) (x : Y) := fun x =>
    QuotientGroup.lift_mk' _ hker x
  refine ⟨QuotientGroup.lift (Subgroup.center ↥L)
    ((QuotientGroup.mk' (Subgroup.centralizer (L : Set Y))).comp L.subtype) hker, ?_, hcomp, ?_⟩
  · rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
    intro q hq
    induction q using QuotientGroup.induction_on with
    | H x =>
      have h1 : QuotientGroup.mk' (Subgroup.centralizer (L : Set Y)) (x : Y) = 1 := by
        rw [← hcomp x]
        exact hq
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h1
      have hc := Subgroup.mem_centralizer_iff.1 h1
      rw [Subgroup.mem_bot, QuotientGroup.eq_one_iff, Subgroup.mem_center_iff]
      intro g
      exact Subtype.ext (hc g g.2)
  · ext y
    constructor
    · rintro ⟨q, rfl⟩
      induction q using QuotientGroup.induction_on with
      | H x => exact ⟨x, x.2, (hcomp x).symm⟩
    · rintro ⟨x, hx, rfl⟩
      exact ⟨QuotientGroup.mk' (Subgroup.center ↥L) ⟨x, hx⟩, hcomp ⟨x, hx⟩⟩

variable [Finite Y]

theorem isMinOverBorel_map_centralizer {L S₀ P : Subgroup Y} [L.Normal]
    (hS : IsSylowTwoOf S₀ L) (hMin : IsMinOverBorel L S₀ P) :
    IsMinOverBorel (L.map (QuotientGroup.mk' (Subgroup.centralizer (L : Set Y))))
      (S₀.map (QuotientGroup.mk' (Subgroup.centralizer (L : Set Y))))
      (P.map (QuotientGroup.mk' (Subgroup.centralizer (L : Set Y)))) := by
  obtain ⟨ψ, hψinj, hψcomp, hψrange⟩ := exists_centerQuot_hom L
  have h1 := (isMinOverBorel_map_iff hψinj).2 (isMinOverBorel_map_of_isMinOverBorel hS hMin)
  set f := QuotientGroup.mk' (Subgroup.centralizer (L : Set Y)) with hf
  set q := QuotientGroup.mk' (Subgroup.center ↥L) with hq
  have hcomp : ψ.comp q = f.comp L.subtype := MonoidHom.ext hψcomp
  have e1 : (⊤ : Subgroup (↥L ⧸ Subgroup.center ↥L)).map ψ = L.map f := by
    rw [← MonoidHom.range_eq_map, hψrange]
  have e2 : ∀ X : Subgroup Y, X ≤ L → ((X.subgroupOf L).map q).map ψ = X.map f := by
    intro X hX
    rw [Subgroup.map_map, hcomp, ← Subgroup.map_map, Subgroup.map_subgroupOf_eq_of_le hX]
  rw [e1, e2 S₀ hS.1, e2 P hMin.1] at h1
  exact h1

theorem gOrbConcl_of_normal (h : KFactChevGraphOrbitSimple) {L R P : Subgroup Y} [L.Normal]
    (hS : IsSimpleGroup (↥L ⧸ Subgroup.center ↥L)) (hC : IsChevTwo (↥L ⧸ Subgroup.center ↥L))
    (hR2 : IsPGroup 2 R) (hSyl : IsSylowTwoOf (R ⊓ L) L) (hMin : IsMinOverBorel L (R ⊓ L) P)
    (hnP : ¬ R ≤ Subgroup.normalizer (P : Set Y)) : GOrbConcl R P := by
  haveI : (Subgroup.centralizer (L : Set Y)).Normal := Subgroup.normal_centralizer
  obtain ⟨ψ, hψinj, -, hψrange⟩ := exists_centerQuot_hom L
  have hMin' := isMinOverBorel_map_centralizer hSyl hMin
  set f := QuotientGroup.mk' (Subgroup.centralizer (L : Set Y)) with hf
  have hker0 : ∀ k : Y, f k = 1 → k ∈ Subgroup.centralizer (L : Set Y) := by
    intro k hk
    rw [← QuotientGroup.ker_mk' (Subgroup.centralizer (L : Set Y))]
    exact hk
  have hnorm : Subgroup.normalizer (L : Set Y) = ⊤ := Subgroup.normalizer_eq_top_iff.2 inferInstance
  have hRN : R ≤ Subgroup.normalizer (L : Set Y) := by
    rw [hnorm]
    exact le_top
  have e : (↥L ⧸ Subgroup.center ↥L) ≃* ↥(L.map f) :=
    (MonoidHom.ofInjective hψinj).trans (MulEquiv.subgroupCongr hψrange)
  refine gOrbConcl_of_map h f hRN hMin.1 ?_ ?_ ?_ ?_ hR2 hSyl hMin' hnP
  · intro k hk l hl
    exact (Subgroup.mem_centralizer_iff.1 (hker0 k hk)) l hl
  · intro z hz hz1
    have hzC : ∀ y ∈ L, y * z = z * y := Subgroup.mem_centralizer_iff.1 (hker0 z hz1)
    apply hMin.2.1.le
    refine Subgroup.mem_inf.2 ⟨hz, Subgroup.mem_normalizer_iff.2 fun x => ?_⟩
    have hz' : ∀ y ∈ L, z * y * z⁻¹ = y := by
      intro y hy
      rw [mul_inv_eq_iff_eq_mul]
      exact (hzC y hy).symm
    constructor
    · intro hx
      rw [hz' x (Subgroup.mem_inf.1 hx).2]
      exact hx
    · intro hx
      have hxL : x ∈ L := by
        have h1 : z⁻¹ * (z * x * z⁻¹) * z ∈ L :=
          L.mul_mem (L.mul_mem (L.inv_mem hz) (Subgroup.mem_inf.1 hx).2) hz
        rwa [show z⁻¹ * (z * x * z⁻¹) * z = x by group] at h1
      rwa [hz' x hxL] at hx
  · haveI := hS
    exact e.symm.isSimpleGroup
  · exact isChevTwo_congr e hC

end GOrbReduce

