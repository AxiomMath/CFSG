variable {k : Type} [Field k] [Finite k] [CharP k 2] {θ : k →+* k} {q : ℕ}

instance finite_fixedGroup : Finite ↥(fixedGroup k θ) := by
  have : Finite ↥(e6Data_valid.minGroup k) :=
    CFSG.ClassicalInvolution.ModelFacts.ChevAut.finite_minGroup e6Data_valid k
  infer_instance

theorem involutive_of_card_twE6 (hk : Nat.card k = q ^ 2) (hθq : ∀ c, θ c = c ^ q) :
    ∀ c, θ (θ c) = c := by
  intro c
  have := Fintype.ofFinite k
  rw [hθq, hθq, ← pow_mul, ← sq, ← hk, Nat.card_eq_fintype_card]
  exact FiniteField.pow_card c

theorem exists_ne_of_card_twE6 (hq : 2 ≤ q) (hk : Nat.card k = q ^ 2)
    (hθq : ∀ c, θ c = c ^ q) : ∃ c : k, θ c ≠ c := by
  by_contra! h
  classical
  haveI := Fintype.ofFinite k
  have hdeg : (Polynomial.X ^ q - Polynomial.X : Polynomial k).natDegree = q := by
    have h1 : (Polynomial.X : Polynomial k).natDegree <
        (Polynomial.X ^ q : Polynomial k).natDegree := by
      rw [Polynomial.natDegree_X_pow, Polynomial.natDegree_X]
      omega
    rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt h1, Polynomial.natDegree_X_pow]
  have hp0 : (Polynomial.X ^ q - Polynomial.X : Polynomial k) ≠ 0 := by
    intro h0
    rw [h0, Polynomial.natDegree_zero] at hdeg
    omega
  have hsub : (Finset.univ : Finset k).val ⊆
      (Polynomial.X ^ q - Polynomial.X : Polynomial k).roots := by
    intro c _
    rw [Polynomial.mem_roots hp0, Polynomial.IsRoot.def, Polynomial.eval_sub,
      Polynomial.eval_pow, Polynomial.eval_X, sub_eq_zero, ← hθq c, h c]
  have hle := Polynomial.card_le_degree_of_subset_roots hsub
  rw [Finset.card_univ, hdeg, ← Nat.card_eq_fintype_card, hk] at hle
  nlinarith

theorem card_fixedField_lt_twE6 (hq : 2 ≤ q) (hk : Nat.card k = q ^ 2)
    (hθq : ∀ c, θ c = c ^ q) : Nat.card ↥(fixedField θ) < Nat.card k := by
  obtain ⟨c, hc⟩ := exists_ne_of_card_twE6 hq hk hθq
  exact Finite.card_subtype_lt (p := fun x => x ∈ fixedField θ) (x := c) hc

theorem card_rootGroup_one_twE6 :
    Nat.card ↥((twistedDatum k θ).rootGroup (Pi.single (nf 1) 1)) =
      Nat.card ↥(fixedField θ) := by
  have hγ : IsRoot .E6 (Pi.single (nd 3) 1) := isRoot_single _ (nd 3)
  have hfix : rho (Pi.single (nd 3) 1) = Pi.single (nd 3) 1 := by
    rw [rho_single, show rhoPerm (nd 3) = nd 3 from rfl]
  have hp : proj (Pi.single (nd 3) 1) = Pi.single (nf 1) 1 := proj_single _
  let f : ↥(fixedField θ) → ↥((twistedDatum k θ).rootGroup (Pi.single (nf 1) 1)) := fun c =>
    ⟨xFixed θ hγ hfix c.1 ((mem_fixedField θ).1 c.2),
      (mem_twistedRootGroup_iff_of_fixed θ hγ hp hfix _).2 ⟨c.1, (mem_fixedField θ).1 c.2, rfl⟩⟩
  have hinj : Function.Injective f := by
    intro c d h
    have h1 : e6Data_valid.xm k (Pi.single (nd 3) 1) c.1 =
        e6Data_valid.xm k (Pi.single (nd 3) 1) d.1 :=
      congrArg (fun x => x.1.1) h
    exact Subtype.ext (e6Data_valid.xm_injective k hγ h1)
  have hsurj : Function.Surjective f := by
    rintro ⟨g, hg⟩
    obtain ⟨c, hc, hgc⟩ := (mem_twistedRootGroup_iff_of_fixed θ hγ hp hfix g).1 hg
    exact ⟨⟨c, (mem_fixedField θ).2 hc⟩, Subtype.ext (Subtype.ext hgc.symm)⟩
  exact (Nat.card_eq_of_bijective f ⟨hinj, hsurj⟩).symm

theorem card_rootGroup_two_twE6 (hθ : ∀ c, θ (θ c) = c) :
    Nat.card ↥((twistedDatum k θ).rootGroup (Pi.single (nf 2) 1)) = Nat.card k := by
  have hγ : IsRoot .E6 (Pi.single (nd 2) 1) := isRoot_single _ (nd 2)
  have hne : rho (Pi.single (nd 2) 1) ≠ Pi.single (nd 2) 1 := by
    rw [rho_single, show rhoPerm (nd 2) = nd 4 from rfl]
    decide
  have hp : proj (Pi.single (nd 2) 1) = Pi.single (nf 2) 1 := proj_single _
  let f : k → ↥((twistedDatum k θ).rootGroup (Pi.single (nf 2) 1)) := fun c =>
    ⟨xPair θ hθ hγ hne c, (mem_twistedRootGroup_iff_of_pair θ hγ hp hne _).2 ⟨c, rfl⟩⟩
  have hinj : Function.Injective f := by
    intro c d h
    have h1 : e6Data_valid.xm k (Pi.single (nd 2) 1) c *
        e6Data_valid.xm k (rho (Pi.single (nd 2) 1))
          ((twistSign (Pi.single (nd 2) 1) : k) * θ c) =
        e6Data_valid.xm k (Pi.single (nd 2) 1) d *
        e6Data_valid.xm k (rho (Pi.single (nd 2) 1))
          ((twistSign (Pi.single (nd 2) 1) : k) * θ d) :=
      congrArg (fun x => x.1.1) h
    exact (xm_mul_xm_rho_inj hγ hne h1).1
  have hsurj : Function.Surjective f := by
    rintro ⟨g, hg⟩
    obtain ⟨c, hgc⟩ := (mem_twistedRootGroup_iff_of_pair θ hγ hp hne g).1 hg
    exact ⟨c, Subtype.ext (Subtype.ext hgc.symm)⟩
  exact (Nat.card_eq_of_bijective f ⟨hinj, hsurj⟩).symm

theorem range_eq_sup_blk_twE6 {F K : Type} [Field F] [Group K]
    (emb : Matrix.SpecialLinearGroup (Fin 3) F →* K) :
    emb.range = (emb.comp (blk F 0)).range ⊔ (emb.comp (blk F 1)).range := by
  rw [MonoidHom.range_comp, MonoidHom.range_comp, MonoidHom.range_eq_map emb,
    ← B12_sup_B23 (K := F), Subgroup.map_sup]
  rfl

theorem edgeLevi_twE6_01 : Edge.EdgeLevi (twistedDatum k θ) (nf 0) (nf 1) := by
  obtain ⟨emb, hinj, h0, h1⟩ := exists_levi01 θ
  refine EdgeLev.edgeLevi_of_sl3 emb hinj ?_
  rw [rankOne_twistedE6_zero, rankOne_twistedE6_one, ← h0, ← h1]
  exact range_eq_sup_blk_twE6 emb

theorem edgeLevi_twE6_23 (hθ : ∀ c, θ (θ c) = c) :
    Edge.EdgeLevi (twistedDatum k θ) (nf 2) (nf 3) := by
  obtain ⟨emb, hinj, h2, h3⟩ := exists_levi23 θ hθ
  refine EdgeLev.edgeLevi_of_sl3 emb hinj ?_
  rw [rankOne_twistedE6_two θ hθ, rankOne_twistedE6_three θ hθ, ← h2, ← h3]
  exact range_eq_sup_blk_twE6 emb

theorem twE6_edge_of_adj : ∀ u v : Fin 4, u ≠ v → (Tag.cartan .F4 u v : ℤ) ≠ 0 →
    (u = 0 ∧ v = 1) ∨ (u = 1 ∧ v = 0) ∨ (u = 1 ∧ v = 2) ∨ (u = 2 ∧ v = 1) ∨
      (u = 2 ∧ v = 3) ∨ (u = 3 ∧ v = 2) := by
  intro u v h1 h2
  revert h1 h2
  fin_cases u <;> fin_cases v <;> decide

theorem edgeCond_twE6 (hq : 2 ≤ q) (hk : Nat.card k = q ^ 2) (hθq : ∀ c, θ c = c ^ q)
    {n : Fin (twistedDatum k θ).rank → ↥(fixedGroup k θ)}
    (H : Fin (twistedDatum k θ).rank → Subgroup ↥(fixedGroup k θ))
    (hct : IsCTGroupDatum (coxeterMatrix (twistedDatum k θ).isFiniteType).toCoxeterSystem
      (weylAction (twistedDatum k θ).isFiniteType) (twistedDatum k θ).roots
      (twistedDatum k θ).rootGroup n H)
    (hext : SteinbergExtras (twistedDatum k θ) n H)
    (hrank : 3 ≤ (twistedDatum k θ).rank) (u v : Fin (twistedDatum k θ).rank)
    (hadj : (TauCeti.diagramGraph (twistedDatum k θ).cartan).Adj u v) :
    Core.EdgeCond (twistedDatum k θ) H u v := by
  have hθ := involutive_of_card_twE6 hk hθq
  have hX : Nat.card ↥((twistedDatum k θ).rootGroup (Pi.single (nf 1) 1)) ≠
      Nat.card ↥((twistedDatum k θ).rootGroup (Pi.single (nf 2) 1)) := by
    rw [card_rootGroup_one_twE6, card_rootGroup_two_twE6 hθ]
    exact (card_fixedField_lt_twE6 hq hk hθq).ne
  have hc := CardPar.card_parJ_ne_of_card_rootGroup_ne hct hext hX
  obtain ⟨hne, hcart⟩ := (twistedDatum k θ).isFiniteType.diagramGraph_adj_iff.1 hadj
  unfold Core.EdgeCond
  rcases twE6_edge_of_adj u v hne hcart with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
    ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact Or.inl edgeLevi_twE6_01
  · exact Or.inl (EdgeLev.edgeLevi_symm edgeLevi_twE6_01)
  · exact Or.inr (Or.inr hc)
  · exact Or.inr (Or.inr hc.symm)
  · exact Or.inl (edgeLevi_twE6_23 hθ)
  · exact Or.inl (EdgeLev.edgeLevi_symm (edgeLevi_twE6_23 hθ))

end CFSG.AGLEmbeddingD2.Tits.GN516.Fam
