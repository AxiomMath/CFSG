variable {K : Type*} [Group K] {D : UniversalRootDatum K} {n : Fin D.rank → K}
  {H : Fin D.rank → Subgroup K}
  (hct : IsCTGroupDatum (coxeterMatrix D.isFiniteType).toCoxeterSystem
    (weylAction D.isFiniteType) D.roots D.rootGroup n H) (hext : SteinbergExtras D n H)

set_option hygiene false in
local notation "cs" => (coxeterMatrix D.isFiniteType).toCoxeterSystem

theorem adj_single_mem (i : Fin D.rank) : (Pi.single i 1 : Fin D.rank → ℤ) ∈ D.roots :=
  (RootSystem.ofCartan D.isFiniteType D.divisible).single_mem i

theorem adj_neg_single_mem (i : Fin D.rank) : (-Pi.single i 1 : Fin D.rank → ℤ) ∈ D.roots :=
  (RootSystem.ofCartan D.isFiniteType D.divisible).neg_mem _ (adj_single_mem i)

theorem adj_conj_mem_of_comm {G : Type*} [Group G] {x : G} {N : Subgroup G}
    (h : ∀ z ∈ N, x * z = z * x) {y : G} (hy : y ∈ N) : x * y * x⁻¹ ∈ N := by
  rw [h y hy, mul_inv_cancel_right]
  exact hy

theorem adj_mem_normalizer_of_comm {G : Type*} [Group G] {x : G} {N : Subgroup G}
    (h : ∀ z ∈ N, x * z = z * x) : x ∈ Subgroup.normalizer (N : Set G) := by
  have hinv : ∀ z ∈ N, x⁻¹ * z = z * x⁻¹ := by
    intro z hz
    have hc : Commute x z := h z hz
    exact hc.inv_left.eq
  refine Subgroup.mem_normalizer_iff.2 fun y => ⟨fun hy => adj_conj_mem_of_comm h hy, fun hy => ?_⟩
  have h2 := adj_conj_mem_of_comm hinv hy
  have e : x⁻¹ * (x * y * x⁻¹) * x⁻¹⁻¹ = y := by group
  rwa [e] at h2

theorem adj_parJ_mono {J J' : Set (Fin D.rank)} (h : J ⊆ J') : parJ D H J ≤ parJ D H J' :=
  sup_le (borel_le_parJ J') (iSup₂_le fun i hi => rankOne_le_parJ (h hi))

theorem borel_mul_cells (i : Fin D.rank) {b g : K} (hb : b ∈ borel D H)
    (hg : g ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple i)) :
    b * g ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple i) := by
  rcases hg with hg | hg
  · exact Or.inl (mul_mem_bruhatCell hct hb hg)
  · exact Or.inr (mul_mem_bruhatCell hct hb hg)

include hct hext in
theorem n_mul_cells (i : Fin D.rank) {g : K}
    (hg : g ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple i)) :
    n i * g ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple i) := by
  rcases hg with hg | hg
  · have h := n_mul_mem_bruhatCell hct hext hg i
    rw [mul_one] at h
    exact h
  · have h := n_mul_mem_bruhatCell hct hext hg i
    rw [(cs).simple_mul_simple_self, Set.union_comm] at h
    exact h

include hct hext in
theorem mul_cells (i : Fin D.rank) {g g' : K}
    (hg : g ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple i))
    (hg' : g' ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple i)) :
    g * g' ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple i) := by
  rcases hg with hg | hg
  · rw [bruhatCell_one hct] at hg
    exact borel_mul_cells hct i hg hg'
  · obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := hg
    rw [nrep_simple hct i]
    have e : b₁ * n i * b₂ * g' = b₁ * (n i * (b₂ * g')) := by simp only [mul_assoc]
    rw [e]
    exact borel_mul_cells hct i hb₁ (n_mul_cells hct hext i (borel_mul_cells hct i hb₂ hg'))

theorem inv_cells (i : Fin D.rank) {g : K}
    (hg : g ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple i)) :
    g⁻¹ ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple i) := by
  rcases hg with hg | hg
  · have hb : g ∈ borel D H := by rwa [bruhatCell_one hct] at hg
    exact Or.inl (by rw [bruhatCell_one hct]; exact inv_mem hb)
  · obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := hg
    have hsq : (n i ^ 2)⁻¹ ∈ borel D H := inv_mem (iSup_le_borel (sq_n_mem_iSup hct i))
    refine Or.inr ⟨b₂⁻¹, inv_mem hb₂, (n i ^ 2)⁻¹ * b₁⁻¹, mul_mem hsq (inv_mem hb₁), ?_⟩
    rw [nrep_simple hct i]
    group

def cellSub (i : Fin D.rank) : Subgroup K where
  carrier := bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple i)
  mul_mem' := fun ha hb => mul_cells hct hext i ha hb
  one_mem' := Or.inl (by rw [bruhatCell_one hct]; exact one_mem _)
  inv_mem' := fun ha => inv_cells hct i ha

include hct hext in
theorem rankOne_le_cellSub (i : Fin D.rank) : rankOne D.rootGroup i ≤ cellSub hct hext i := by
  intro g hg
  show g ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple i)
  rcases hext.rankOne_bruhat i g hg with ⟨h, hh, u, hu, rfl⟩ | ⟨u, hu, h, hh, v, hv, rfl⟩
  · left
    rw [bruhatCell_one hct]
    exact mul_mem (iSup_le_borel (le_iSup H i hh))
      (rootGroup_le_borel (adj_single_mem i) (ht_single_pos i) hu)
  · right
    refine ⟨u, rootGroup_le_borel (adj_single_mem i) (ht_single_pos i) hu, h * v,
      mul_mem (iSup_le_borel (le_iSup H i hh)) (rootGroup_le_borel (adj_single_mem i)
        (ht_single_pos i) hv), ?_⟩
    rw [nrep_simple hct i]
    simp only [mul_assoc]

include hct hext in
theorem parJ_le_cellSub (i : Fin D.rank) : parJ D H {i} ≤ cellSub hct hext i := by
  unfold parJ
  refine sup_le ?_ (iSup₂_le fun l hl => ?_)
  · intro g hg
    show g ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple i)
    exact Or.inl (by rw [bruhatCell_one hct]; exact hg)
  · rw [Set.mem_singleton_iff.1 hl]
    exact rankOne_le_cellSub hct hext i

theorem borel_mul_four (j k : Fin D.rank) {b x : K} (hb : b ∈ borel D H)
    (hx : x ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple j) ∪ bruhatCell hct ((cs).simple k) ∪
      bruhatCell hct ((cs).simple j * (cs).simple k)) :
    b * x ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple j) ∪ bruhatCell hct ((cs).simple k) ∪
      bruhatCell hct ((cs).simple j * (cs).simple k) := by
  rcases hx with ((h | h) | h) | h
  · exact Or.inl (Or.inl (Or.inl (mul_mem_bruhatCell hct hb h)))
  · exact Or.inl (Or.inl (Or.inr (mul_mem_bruhatCell hct hb h)))
  · exact Or.inl (Or.inr (mul_mem_bruhatCell hct hb h))
  · exact Or.inr (mul_mem_bruhatCell hct hb h)

include hct hext in
theorem n_mul_four (j k : Fin D.rank) {x : K}
    (hx : x ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple k)) :
    n j * x ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple j) ∪ bruhatCell hct ((cs).simple k) ∪
      bruhatCell hct ((cs).simple j * (cs).simple k) := by
  rcases hx with h | h
  · have h' := n_mul_mem_bruhatCell hct hext h j
    rw [mul_one] at h'
    rcases h' with h'' | h''
    · exact Or.inl (Or.inl (Or.inl h''))
    · exact Or.inl (Or.inl (Or.inr h''))
  · have h' := n_mul_mem_bruhatCell hct hext h j
    rcases h' with h'' | h''
    · exact Or.inl (Or.inr h'')
    · exact Or.inr h''

include hct hext in
theorem parJ_mul_mem_four {j k : Fin D.rank} {p q : K} (hp : p ∈ parJ D H {j})
    (hq : q ∈ parJ D H {k}) :
    p * q ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple j) ∪ bruhatCell hct ((cs).simple k) ∪
      bruhatCell hct ((cs).simple j * (cs).simple k) := by
  have hp' : p ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple j) :=
    parJ_le_cellSub hct hext j hp
  have hq' : q ∈ bruhatCell hct 1 ∪ bruhatCell hct ((cs).simple k) :=
    parJ_le_cellSub hct hext k hq
  rcases hp' with h | h
  · rw [bruhatCell_one hct] at h
    rcases borel_mul_cells hct k h hq' with h' | h'
    · exact Or.inl (Or.inl (Or.inl h'))
    · exact Or.inl (Or.inr h')
  · obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := h
    have hbq := borel_mul_cells hct k hb₂ hq'
    have e : b₁ * nrep hct ((cs).simple j) * b₂ * q = b₁ * (n j * (b₂ * q)) := by
      rw [nrep_simple hct j]
      simp only [mul_assoc]
    rw [e]
    exact borel_mul_four hct j k hb₁ (n_mul_four hct hext j k hbq)

theorem weylAction_simple_single_eq (i j : Fin D.rank) :
    weylAction D.isFiniteType ((cs).simple i) (Pi.single j 1) =
      Pi.single j 1 - D.cartan i j • Pi.single i 1 := by
  have hsum : ∑ l, D.cartan i l * (Pi.single j 1 : Fin D.rank → ℤ) l = D.cartan i j := by
    simp [Pi.single_apply]
  rw [weylAction_simple, reflection_apply, hsum]

theorem simple_mul_simple_ne_one {j k : Fin D.rank} (hjk : j ≠ k) :
    (cs).simple k * (cs).simple j ≠ 1 := by
  intro h
  have h1 : weylAction D.isFiniteType ((cs).simple k * (cs).simple j) (Pi.single j 1) =
      Pi.single j 1 := by
    rw [h, map_one, Module.End.one_apply]
  rw [weylAction_mul_apply, weylAction_simple_single D.isFiniteType, map_neg,
    weylAction_simple_single_eq k j] at h1
  have h2 := congrFun h1 j
  simp [Pi.single_apply, hjk, Ne.symm hjk] at h2

theorem cartan_eq_zero_of_simple_comm {j k : Fin D.rank} (hjk : j ≠ k)
    (hc : (cs).simple k * (cs).simple j = (cs).simple j * (cs).simple k) : D.cartan j k = 0 := by
  have h1 : weylAction D.isFiniteType ((cs).simple k * (cs).simple j) (Pi.single j 1) =
      weylAction D.isFiniteType ((cs).simple j * (cs).simple k) (Pi.single j 1) := by
    rw [hc]
  rw [weylAction_mul_apply, weylAction_mul_apply, weylAction_simple_single D.isFiniteType,
    map_neg, weylAction_simple_single_eq k j, map_sub, map_smul,
    weylAction_simple_single D.isFiniteType, weylAction_simple_single_eq j k] at h1
  have h2 := congrFun h1 k
  have hkj : D.cartan k j = 0 := by
    simp [Pi.single_apply, hjk, Ne.symm hjk] at h2
    omega
  exact D.isFiniteType.apply_eq_zero_symm hkj

include hct hext in
theorem cartan_eq_zero_of_mul_mem {j k : Fin D.rank} (hjk : j ≠ k)
    (hmem : n k * n j ∈ (parJ D H {j} : Set K) * (parJ D H {k} : Set K)) :
    D.cartan j k = 0 := by
  obtain ⟨p, hp, q, hq, hpq⟩ := Set.mem_mul.1 hmem
  have hp' : p ∈ parJ D H {j} := hp
  have hq' : q ∈ parJ D H {k} := hq
  have hU := parJ_mul_mem_four hct hext hp' hq'
  rw [hpq] at hU
  have hnd : ¬ (cs).IsLeftDescent ((cs).simple j) k := by
    intro hd
    have hd' : (cs).length ((cs).simple k * (cs).simple j) < (cs).length ((cs).simple j) := hd
    rw [(cs).length_simple j] at hd'
    exact simple_mul_simple_ne_one hjk ((cs).length_eq_zero_iff.1 (by omega))
  have hnrep : nrep hct ((cs).simple k * (cs).simple j) = n k * n j := by
    rw [nrep_simple_mul hct hnd, nrep_simple hct j]
  have hC : n k * n j ∈ bruhatCell hct ((cs).simple k * (cs).simple j) := by
    rw [← hnrep]
    exact nrep_mem_bruhatCell hct _
  rcases hU with ((h | h) | h) | h
  · exact absurd (eq_of_mem_bruhatCell hct hext hC h) (simple_mul_simple_ne_one hjk)
  · have e := eq_of_mem_bruhatCell hct hext hC h
    exact absurd (mul_right_cancel (e.trans (one_mul _).symm)) ((cs).simple_ne_one k)
  · have e := eq_of_mem_bruhatCell hct hext hC h
    exact absurd (mul_left_cancel (e.trans (mul_one _).symm)) ((cs).simple_ne_one j)
  · exact cartan_eq_zero_of_simple_comm hjk (eq_of_mem_bruhatCell hct hext hC h)

include hct in
theorem n_mul_n_mem (j k : Fin D.rank) : n k * n j ∈ parJ D H {j, k} :=
  mul_mem (rankOne_le_parJ (Set.mem_insert_of_mem j (Set.mem_singleton k)) (hct.n_mem k))
    (rankOne_le_parJ (Set.mem_insert j {k}) (hct.n_mem j))

include hct hext in
theorem parJ_mul_eq_of_cartan_eq_zero {j k : Fin D.rank} (hjk : j ≠ k)
    (h : D.cartan j k = 0) :
    (parJ D H {j} : Set K) * (parJ D H {k} : Set K) = (parJ D H {j, k} : Set K) := by
  have hcomm : ∀ x ∈ rankOne D.rootGroup j, ∀ y ∈ rankOne D.rootGroup k, x * y = y * x :=
    fun x hx y hy => rankOne_commute hct hext hjk h hx hy
  have hLjn : rankOne D.rootGroup j ≤ Subgroup.normalizer (rankOne D.rootGroup k : Set K) :=
    fun x hx => adj_mem_normalizer_of_comm fun y hy => hcomm x hx y hy
  have hTj : (⨆ i, H i) ≤ Subgroup.normalizer (rankOne D.rootGroup j : Set K) :=
    le_normalizer_sup (iSup_le_normalizer_rootGroup hct (adj_single_mem j))
      (iSup_le_normalizer_rootGroup hct (adj_neg_single_mem j))
  have hTk : (⨆ i, H i) ≤ Subgroup.normalizer (rankOne D.rootGroup k : Set K) :=
    le_normalizer_sup (iSup_le_normalizer_rootGroup hct (adj_single_mem k))
      (iSup_le_normalizer_rootGroup hct (adj_neg_single_mem k))
  have hTLjk : (⨆ i, H i) ≤
      Subgroup.normalizer ((rankOne D.rootGroup j ⊔ rankOne D.rootGroup k : Subgroup K) : Set K) :=
    le_normalizer_sup hTj hTk
  have hsplit : parJ D H {j, k} = unipRad D {j, k} ⊔
      ((rankOne D.rootGroup j ⊔ rankOne D.rootGroup k) ⊔ ⨆ i, H i) := by
    simp only [parJ_eq_sup, unipJ_eq_sup hct hext, iSup_pair, sup_assoc]
  have hR : (rankOne D.rootGroup j ⊔ rankOne D.rootGroup k) ⊔ ⨆ i, H i ≤ parJ D H {j, k} :=
    sup_le (sup_le (rankOne_le_parJ (Set.mem_insert j {k}))
      (rankOne_le_parJ (Set.mem_insert_of_mem j (Set.mem_singleton k))))
      (iSup_le_borel.trans (borel_le_parJ _))
  have hUR : (rankOne D.rootGroup j ⊔ rankOne D.rootGroup k) ⊔ ⨆ i, H i ≤
      Subgroup.normalizer (unipRad D {j, k} : Set K) :=
    hR.trans (parJ_le_normalizer_unipRad hct hext _)
  apply Set.Subset.antisymm
  · intro x hx
    obtain ⟨a, ha, c, hc, rfl⟩ := Set.mem_mul.1 hx
    exact mul_mem (adj_parJ_mono (Set.singleton_subset_iff.2 (Set.mem_insert j {k})) ha)
      (adj_parJ_mono (Set.singleton_subset_iff.2 (Set.mem_insert_of_mem j (Set.mem_singleton k))) hc)
  · intro x hx
    rw [SetLike.mem_coe, hsplit, ← SetLike.mem_coe,
      Subgroup.coe_mul_of_right_le_normalizer_left _ _ hUR, Set.mem_mul] at hx
    obtain ⟨u, hu, r, hr, rfl⟩ := hx
    rw [Subgroup.coe_mul_of_right_le_normalizer_left _ _ hTLjk, Set.mem_mul] at hr
    obtain ⟨q, hq, t, ht, rfl⟩ := hr
    rw [Subgroup.coe_mul_of_left_le_normalizer_right _ _ hLjn, Set.mem_mul] at hq
    obtain ⟨l, hl, l', hl', rfl⟩ := hq
    refine Set.mem_mul.2 ⟨u * l, ?_, l' * t, ?_, ?_⟩
    · exact mul_mem (borel_le_parJ _ (posUnipotent_le_borel (unipRad_le_posUnipotent _ hu)))
        (rankOne_le_parJ (Set.mem_singleton j) hl)
    · exact mul_mem (rankOne_le_parJ (Set.mem_singleton k) hl')
        (borel_le_parJ _ (iSup_le_borel ht))
    · simp only [mul_assoc]

theorem ker_le_borel_of_bq {S : Type*} [Group S] {π : K →* S} {M : ℕ}
    (h : BorelQuotient D n H π M) : π.ker ≤ borel D H :=
  fun z hz => CFSG.ClassicalInvolution.WeakCT.normalizer_posUnipotent_le_borel h.ct h.extras
    (Subgroup.center_le_normalizer (posUnipotent D : Set K) (h.ker_central z hz))

theorem mem_mul_of_map_mem_mul {S : Type*} [Group S] {π : K →* S} {M : ℕ}
    (h : BorelQuotient D n H π M) {j k : Fin D.rank} {g : K}
    (hg : π g ∈ ((parJ D H {j}).map π : Set S) * ((parJ D H {k}).map π : Set S)) :
    g ∈ (parJ D H {j} : Set K) * (parJ D H {k} : Set K) := by
  obtain ⟨x, hx, y, hy, hxy⟩ := Set.mem_mul.1 hg
  obtain ⟨p, hp, rfl⟩ := Subgroup.mem_map.1 (SetLike.mem_coe.1 hx)
  obtain ⟨q, hq, rfl⟩ := Subgroup.mem_map.1 (SetLike.mem_coe.1 hy)
  have hz : (p * q)⁻¹ * g ∈ π.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, map_mul, hxy, inv_mul_cancel]
  have hzk : (p * q)⁻¹ * g ∈ parJ D H {k} := borel_le_parJ _ (ker_le_borel_of_bq h hz)
  exact Set.mem_mul.2 ⟨p, hp, q * ((p * q)⁻¹ * g), mul_mem hq hzk, by group⟩

end CFSG.AGLEmbeddingD2.Tits.GN516.AdjBruhat

