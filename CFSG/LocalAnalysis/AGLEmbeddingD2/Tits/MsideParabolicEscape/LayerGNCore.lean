theorem agl81II1320Core_of_gn (hGN : GlaubermanNilesInput)
    (hFFT : CFSG.HardMathSupport.Cooperstein.Coordinator.FFModuleTheorem)
    (h3J : ThreePrimeJCentral) (h56 : AGL81I56) (hRT : KFactParabolicCoverRankTwo)
    (hA7 : KFactAltSevenE9) (hZ : KFactOddCentreE9) : AGL81II1320Core := by
  intro G _ _ M T hK hMtop hchar hT h1 h2 hXb hnc
  obtain ⟨K, hKn, hKs, hKc, hKt⟩ := exists_rankTwo_normal_of_gn hGN hFFT h3J h56 hRT hA7 hZ
    (gnSetting_of_core hK hMtop hchar hT hXb) (gnLocal_of_core hT h1 h2) hnc
  exact exists_isRankTwoLayer_of_quotient hKn hKs hKc hKt

theorem agl81II1320Core_of_gn'
    (hGN : GlaubermanNilesInput)
    (hFFT : CFSG.HardMathSupport.Cooperstein.Coordinator.FFModuleTheorem) (h56 : AGL81I56)
    (hRT : KFactParabolicCoverRankTwo) (hZ : KFactOddCentreE9) : AGL81II1320Core :=
  agl81II1320Core_of_gn hGN hFFT S3AmalgamBound.threePrimeJCentral_proved h56 hRT
    kFactAltSevenE9 hZ

