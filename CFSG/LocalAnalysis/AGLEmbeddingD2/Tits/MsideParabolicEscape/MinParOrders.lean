section K

variable {K : Type*} [Group K] [Finite K] {D : UniversalRootDatum K} {n : Fin D.rank → K}
  {H : Fin D.rank → Subgroup K}

theorem eq_of_card_parJ_eq
    (hct : IsCTGroupDatum (coxeterMatrix D.isFiniteType).toCoxeterSystem
      (weylAction D.isFiniteType) D.roots D.rootGroup n H) (hext : SteinbergExtras D n H)
    (hrank : D.rank ≤ 2)
    (hroot : ∀ i j : Fin D.rank, i ≠ j →
      Nat.card (D.rootGroup (Pi.single i 1)) ≠ Nat.card (D.rootGroup (Pi.single j 1)))
    {J₁ J₂ : Set (Fin D.rank)} (hc : Nat.card (parJ D H J₁) = Nat.card (parJ D H J₂)) :
    J₁ = J₂ := by
  have hsub : ∀ {J J' : Set (Fin D.rank)}, J ⊆ J' →
      Nat.card (parJ D H J) = Nat.card (parJ D H J') → J' ⊆ J := by
    intro J J' hJ hcard k hk
    have hle : parJ D H J ≤ parJ D H J' :=
      sup_le (borel_le_parJ J') (iSup₂_le fun i hi => rankOne_le_parJ (hJ hi))
    have heq := Subgroup.eq_of_le_of_card_ge hle hcard.symm.le
    exact mem_of_rankOne_le_parJ hct hext ((rankOne_le_parJ hk).trans heq.symm.le)
  by_cases h12 : J₁ ⊆ J₂
  · exact h12.antisymm (hsub h12 hc)
  by_cases h21 : J₂ ⊆ J₁
  · exact (h21.antisymm (hsub h21 hc.symm)).symm
  exfalso
  obtain ⟨x, hx₁, hx₂⟩ := Set.not_subset.1 h12
  obtain ⟨y, hy₂, hy₁⟩ := Set.not_subset.1 h21
  have hxy : x ≠ y := fun e => hx₂ (e ▸ hy₂)
  have hnode : ∀ z : Fin D.rank, z = x ∨ z = y := by
    intro z
    have hv : x.val ≠ y.val := fun e => hxy (Fin.ext e)
    have := z.isLt
    have := x.isLt
    have := y.isLt
    rcases (by omega : z.val = x.val ∨ z.val = y.val) with e | e
    · exact Or.inl (Fin.ext e)
    · exact Or.inr (Fin.ext e)
  have hJ₁ : J₁ = {x} := Set.eq_singleton_iff_unique_mem.2
    ⟨hx₁, fun z hz => (hnode z).resolve_right fun e => hy₁ (e ▸ hz)⟩
  have hJ₂ : J₂ = {y} := Set.eq_singleton_iff_unique_mem.2
    ⟨hy₂, fun z hz => (hnode z).resolve_left fun e => hx₂ (e ▸ hz)⟩
  rw [hJ₁, hJ₂] at hc
  exact card_parJ_ne_of_card_rootGroup_ne hct hext (hroot x y hxy) hc

end K

section Quotient

variable {K : Type*} {S : Type} [Group K] [Finite K] [Group S] [Finite S] {D : UniversalRootDatum K}
  {n : Fin D.rank → K} {H : Fin D.rank → Subgroup K} {π : K →* S} {M : ℕ}

theorem card_parJ_eq_card_map_mul (h : BorelQuotient D n H π M) (J : Set (Fin D.rank)) :
    Nat.card (parJ D H J) = Nat.card ((parJ D H J).map π) * Nat.card π.ker := by
  have hrel := Subgroup.relIndex_mul_card (H := π.ker) (K := parJ D H J)
  rw [Subgroup.relIndex_ker, inf_eq_left.mpr (ker_le_parJ h J)] at hrel
  exact hrel.symm

theorem eq_of_map_borel_le_of_card_eq (h : BorelQuotient D n H π M) (hrank : D.rank ≤ 2)
    (hroot : ∀ i j : Fin D.rank, i ≠ j →
      Nat.card (D.rootGroup (Pi.single i 1)) ≠ Nat.card (D.rootGroup (Pi.single j 1)))
    {Z₁ Z₂ : Subgroup S} (h₁ : (borel D H).map π ≤ Z₁) (h₂ : (borel D H).map π ≤ Z₂)
    (hZ : Nat.card Z₁ = Nat.card Z₂) : Z₁ = Z₂ := by
  have hpar : ∀ {Z : Subgroup S}, (borel D H).map π ≤ Z →
      ∃ J : Set (Fin D.rank), Z = (parJ D H J).map π := fun hZB =>
    ⟨_, by rw [← eq_parJ_negIndices h.ct h.extras (Subgroup.map_le_iff_le_comap.1 hZB),
      Subgroup.map_comap_eq_self_of_surjective h.surj]⟩
  obtain ⟨J₁, rfl⟩ := hpar h₁
  obtain ⟨J₂, rfl⟩ := hpar h₂
  rw [eq_of_card_parJ_eq (J₁ := J₁) (J₂ := J₂) h.ct h.extras hrank hroot (by
    rw [card_parJ_eq_card_map_mul h, card_parJ_eq_card_map_mul h, hZ])]

theorem eq_of_normalizer_le_of_card_eq (h : BorelQuotient D n H π M) (hrank : D.rank ≤ 2)
    (hroot : ∀ i j : Fin D.rank, i ≠ j →
      Nat.card (D.rootGroup (Pi.single i 1)) ≠ Nat.card (D.rootGroup (Pi.single j 1)))
    (T : Sylow 2 S) {Z₁ Z₂ : Subgroup S}
    (h₁ : Subgroup.normalizer ((T : Subgroup S) : Set S) ≤ Z₁)
    (h₂ : Subgroup.normalizer ((T : Subgroup S) : Set S) ≤ Z₂)
    (hZ : Nat.card Z₁ = Nat.card Z₂) : Z₁ = Z₂ := by
  obtain ⟨π', hsurj, hker, hT⟩ := h.exists_conj_eq T
  have h' : BorelQuotient D n H π' M :=
    { h with
      surj := hsurj
      ker_central := fun z hz => h.ker_central z (hker ▸ hz)
      ker_pow := fun z hz => h.ker_pow z (hker ▸ hz) }
  have hN : Subgroup.normalizer ((T : Subgroup S) : Set S) = (borel D H).map π' := by
    rw [hT]
    exact h'.normalizer_map_posUnipotent
  exact eq_of_map_borel_le_of_card_eq h' hrank hroot (hN ▸ h₁) (hN ▸ h₂) hZ

end Quotient

