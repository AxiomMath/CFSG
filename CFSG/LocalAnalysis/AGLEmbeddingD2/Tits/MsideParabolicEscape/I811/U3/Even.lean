variable {F : Type} [Field F] [Finite F] {f : ℕ} [CharP F 2]

section Elements

@[expose] def g0Mat : Matrix (Fin 3) (Fin 3) F := !![1, 0, 0; 0, 1, 0; 1, 0, 1]

@[expose] def s1Mat : Matrix (Fin 3) (Fin 3) F := !![1, 0, 1; 0, 1, 0; 0, 0, 1]

omit [Finite F] in
theorem g0Mat_mul_self : (g0Mat : Matrix (Fin 3) (Fin 3) F) * g0Mat = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [g0Mat, Matrix.mul_apply, Fin.sum_univ_three, CharTwo.add_self_eq_zero]

omit [Finite F] in
theorem s1Mat_mul_self : (s1Mat : Matrix (Fin 3) (Fin 3) F) * s1Mat = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [s1Mat, Matrix.mul_apply, Fin.sum_univ_three, CharTwo.add_self_eq_zero]

@[expose] def g0GL : GL (Fin 3) F := ⟨g0Mat, g0Mat, g0Mat_mul_self, g0Mat_mul_self⟩

@[expose] def s1GL : GL (Fin 3) F := ⟨s1Mat, s1Mat, s1Mat_mul_self, s1Mat_mul_self⟩

variable (σ : F ≃+* F)

omit [Finite F] in
theorem g0GL_mem_SU : (g0GL : GL (Fin 3) F) ∈ SU σ 3 := by
  refine ⟨?_, ?_⟩
  · show (g0Mat : Matrix (Fin 3) (Fin 3) F).det = 1
    simp [g0Mat, Matrix.det_fin_three]
  · show conjTr σ (g0Mat : Matrix (Fin 3) (Fin 3) F) * antidiag 3 * g0Mat = antidiag 3
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [g0Mat, conjTr, antidiag, Matrix.mul_apply, Fin.sum_univ_three,
        CharTwo.add_self_eq_zero]

omit [Finite F] in
theorem s1GL_mem_SU : (s1GL : GL (Fin 3) F) ∈ SU σ 3 := by
  refine ⟨?_, ?_⟩
  · show (s1Mat : Matrix (Fin 3) (Fin 3) F).det = 1
    simp [s1Mat, Matrix.det_fin_three]
  · show conjTr σ (s1Mat : Matrix (Fin 3) (Fin 3) F) * antidiag 3 * s1Mat = antidiag 3
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [s1Mat, conjTr, antidiag, Matrix.mul_apply, Fin.sum_univ_three,
        CharTwo.add_self_eq_zero]

@[expose] def g0SU : SU σ 3 := ⟨g0GL, g0GL_mem_SU σ⟩

@[expose] def s1SU : SU σ 3 := ⟨s1GL, s1GL_mem_SU σ⟩

omit [Finite F] in
theorem mat_g0SU : mat σ 3 (g0SU σ) = g0Mat := rfl

omit [Finite F] in
theorem mat_s1SU : mat σ 3 (s1SU σ) = s1Mat := rfl
omit [Finite F] in
theorem swap_mul_g0 :
    (⟨swapGL, swapGL_mem_SU σ⟩ : SU σ 3) * g0SU σ = g0SU σ * s1SU σ := by
  apply mat_injective
  rw [map_mul, map_mul, mat_g0SU, mat_s1SU]
  show (sMat : Matrix (Fin 3) (Fin 3) F) * g0Mat = g0Mat * s1Mat
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [sMat, g0Mat, s1Mat, Matrix.mul_apply, Fin.sum_univ_three, CharTwo.add_self_eq_zero,
      CharTwo.neg_eq]

end Elements

theorem two_pow_dvd_of_mul {N a b n v : ℕ} (hN : N = a * b) (ha : a ≠ 0) (hb : b ≠ 0)
    (hNf : N.factorization 2 = n) (hav : a.factorization 2 ≤ v) (hvn : v ≤ n) :
    2 ^ (n - v) ∣ b := by
  have h := Nat.factorization_mul ha hb
  rw [← hN] at h
  have h2 : N.factorization 2 = a.factorization 2 + b.factorization 2 := by
    rw [h]; rfl
  have hb2 : n - v ≤ b.factorization 2 := by omega
  exact (Nat.pow_dvd_pow 2 hb2).trans (Nat.ordProj_dvd b 2)

theorem factorization_two_pow_mul_odd {m o : ℕ} (ho : ¬ 2 ∣ o) :
    (2 ^ m * o).factorization 2 = m := by
  have ho0 : o ≠ 0 := by rintro rfl; exact ho (dvd_zero 2)
  rw [Nat.factorization_mul (by positivity) ho0, Finsupp.add_apply, Nat.factorization_pow,
    Finsupp.smul_apply, Nat.Prime.factorization_self Nat.prime_two, smul_eq_mul, mul_one,
    Nat.factorization_eq_zero_of_not_dvd ho, add_zero]

variable (hF : Nat.card F = (2 ^ f) ^ 2)
include hF

omit [CharP F 2] in
theorem one_le_f : 1 ≤ f := by
  have h := two_le_q (p := 2) hF
  by_contra hf
  have : f = 0 := by omega
  subst this
  simp at h

omit [CharP F 2] in
theorem two_le_f (hq3 : 2 ^ f % 3 = 1) : 2 ≤ f := by
  have h := one_le_f hF
  by_contra hf
  have : f = 1 := by omega
  subst this
  norm_num at hq3

omit [CharP F 2] in
theorem odd_index_factor : ¬ 2 ∣ ((2 ^ f) ^ 2 - 1) * ((2 ^ f) ^ 3 + 1) := by
  have hf := one_le_f hF
  have he : 2 ∣ 2 ^ f := dvd_pow_self 2 (by omega)
  have h1 : ¬ 2 ∣ (2 ^ f) ^ 2 - 1 := by
    have : 2 ∣ (2 ^ f) ^ 2 := he.trans (dvd_pow_self _ (by norm_num))
    have hpos : 1 ≤ (2 ^ f) ^ 2 := Nat.one_le_pow _ _ (by positivity)
    omega
  have h2 : ¬ 2 ∣ (2 ^ f) ^ 3 + 1 := by
    have : 2 ∣ (2 ^ f) ^ 3 := he.trans (dvd_pow_self _ (by norm_num))
    omega
  intro h
  rcases (Nat.Prime.dvd_mul Nat.prime_two).1 h with h' | h'
  · exact h1 h'
  · exact h2 h'

theorem card_SU_even : Nat.card (SU (unitaryInvolution F 2 f) 3) =
    2 ^ (3 * f) * (((2 ^ f) ^ 2 - 1) * ((2 ^ f) ^ 3 + 1)) := by
  rw [card_SU_three hF, ← pow_mul, mul_comm f 3, mul_assoc]

theorem index_rootU : (rootU hF).index = ((2 ^ f) ^ 2 - 1) * ((2 ^ f) ^ 3 + 1) := by
  have h := (rootU hF).card_mul_index
  rw [card_SU_three hF, card_rootGroup_three hF, mul_assoc] at h
  exact Nat.eq_of_mul_eq_mul_left (pow_pos (pow_pos (by norm_num) f) 3) h

theorem isPGroup_rootU : IsPGroup 2 (rootU hF) := by
  refine IsPGroup.of_card (n := 3 * f) ?_
  rw [card_rootGroup_three hF, ← pow_mul, mul_comm f 3]

theorem fixCol_of_conj_mem {g : SU (unitaryInvolution F 2 f) 3}
    (hg : g⁻¹ * s1SU (unitaryInvolution F 2 f) * g ∈ rootU hF) :
    mat (unitaryInvolution F 2 f) 3 g 1 0 = 0 ∧ mat (unitaryInvolution F 2 f) 3 g 2 0 = 0 := by
  set u := g⁻¹ * s1SU (unitaryInvolution F 2 f) * g with hu
  have hsg : s1SU (unitaryInvolution F 2 f) * g = g * u := by rw [hu]; group
  have hmu := (mat_of_mem_rootU hF hg).2
  have hu00 : mat (unitaryInvolution F 2 f) 3 u 0 0 = 1 := by rw [hmu]; simp
  have hu10 : mat (unitaryInvolution F 2 f) 3 u 1 0 = 0 := by rw [hmu]; simp
  have hu20 : mat (unitaryInvolution F 2 f) 3 u 2 0 = 0 := by rw [hmu]; simp
  have e := congrFun (congrFun (congrArg (mat (unitaryInvolution F 2 f) 3) hsg) 0) 0
  rw [map_mul, map_mul, mat_s1SU] at e
  have hs00 : (s1Mat : Matrix (Fin 3) (Fin 3) F) 0 0 = 1 := rfl
  have hs01 : (s1Mat : Matrix (Fin 3) (Fin 3) F) 0 1 = 0 := rfl
  have hs02 : (s1Mat : Matrix (Fin 3) (Fin 3) F) 0 2 = 1 := rfl
  simp only [Matrix.mul_apply, Fin.sum_univ_three, hu00, hu10, hu20, hs00, hs01, hs02,
    mul_zero, mul_one, one_mul, zero_mul, add_zero] at e
  have h20 : mat (unitaryInvolution F 2 f) 3 g 2 0 = 0 := by linear_combination e
  refine ⟨?_, h20⟩
  have e00 := sum_mat_mul_mat g 0 0
  have r0 : Fin.rev (0 : Fin 3) = 2 := rfl
  have r1 : Fin.rev (1 : Fin 3) = 1 := rfl
  have r2 : Fin.rev (2 : Fin 3) = 0 := rfl
  simp only [Fin.sum_univ_three, r0, r1, r2, h20, map_zero, zero_mul, mul_zero, add_zero,
    zero_add] at e00
  rw [ite_eq_right (by decide)] at e00
  rcases mul_eq_zero.1 e00 with h | h
  · exact (map_eq_zero _).1 h
  · exact h

theorem le_rootU_of_mem {P : Subgroup (SU (unitaryInvolution F 2 f) 3)} (hP : IsPGroup 2 P)
    (hs : s1SU (unitaryInvolution F 2 f) ∈ P) : P ≤ rootU hF := by
  have hUi : ¬ 2 ∣ (rootU hF).index := by rw [index_rootU hF]; exact odd_index_factor hF
  let U' : Sylow 2 (SU (unitaryInvolution F 2 f) 3) := (isPGroup_rootU hF).toSylow hUi
  obtain ⟨S, hPS⟩ := hP.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (SU (unitaryInvolution F 2 f) 3) U' S
  have hmem : ∀ x, x ∈ (S : Subgroup (SU (unitaryInvolution F 2 f) 3)) →
      g⁻¹ * x * g ∈ rootU hF := by
    intro x hx
    rw [← hg, Sylow.coe_subgroup_smul, Subgroup.mem_pointwise_smul_iff_inv_smul_mem] at hx
    have : (MulAut.conj g)⁻¹ • x = g⁻¹ * x * g := by
      rw [MulAut.smul_def, ← map_inv, MulAut.conj_apply, inv_inv]
    rw [this] at hx
    exact hx
  obtain ⟨h10, h20⟩ := fixCol_of_conj_mem hF (hmem _ (hPS hs))
  intro x hx
  have := conj_mem_rootU_of_fixCol hF h10 h20 (hmem x (hPS hx))
  simpa [mul_assoc] using this

omit hF [Finite F] [CharP F 2] in
theorem inv_pow_q_of_mem {μ : Fˣ} (hμ : μ ∈ rootsOfUnity (2 ^ f + 1) F) :
    (μ ^ (2 ^ f))⁻¹ = μ := by
  have h := (mem_rootsOfUnity _ _).1 hμ
  rw [pow_succ'] at h
  exact inv_eq_of_mul_eq_one_left h

theorem g0_comm_tSU {μ : Fˣ} (hμ : μ ∈ rootsOfUnity (2 ^ f + 1) F) :
    g0SU (unitaryInvolution F 2 f) * tSU hF μ = tSU hF μ * g0SU (unitaryInvolution F 2 f) := by
  apply mat_injective
  rw [map_mul, map_mul, mat_g0SU, mat_tSU, inv_pow_q_of_mem hμ]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [g0Mat, Matrix.mul_apply, Matrix.diagonal_apply]

omit hF in
theorem s1_eq_conj : s1SU (unitaryInvolution F 2 f) =
    (g0SU (unitaryInvolution F 2 f))⁻¹ * sSU * g0SU (unitaryInvolution F 2 f) := by
  have h := swap_mul_g0 (F := F) (unitaryInvolution F 2 f)
  have hs : (sSU : SU (unitaryInvolution F 2 f) 3) = ⟨swapGL, swapGL_mem_SU _⟩ := rfl
  rw [hs, mul_assoc, h, ← mul_assoc, inv_mul_cancel, one_mul]

local notation "𝔾" => SU (unitaryInvolution F 2 f) 3
local notation "𝔤₀" => g0SU (unitaryInvolution F 2 f)
local notation "𝔰₁" => s1SU (unitaryInvolution F 2 f)

theorem odd_or_sixteen_dvd_index (hq3 : 2 ^ f % 3 = 1) {ω : Fˣ} (hω : orderOf ω = 3)
    {W : Subgroup 𝔾}
    (hNW : Subgroup.normalizer ((Subgroup.zpowers (tSU hF ω) : Subgroup 𝔾) : Set 𝔾) ≤ W) :
    ¬ 2 ∣ W.index ∨ 16 ∣ W.index := by
  classical
  have hω' : ω ^ (2 ^ f) = ω := pow_eq_self_of_orderOf_three hω hq3
  have hsW : (sSU : 𝔾) ∈ W := by
    refine hNW (mem_normalizer_zpowers_of_inv sSU_mul_self ?_)
    rw [sSU_conj_tSU, hω', map_inv]
  have hZW : ∀ μ ∈ rootsOfUnity (2 ^ f + 1) F, tSU hF μ ∈ W := by
    intro μ _
    refine hNW (mem_normalizer_zpowers_of_commute ?_)
    show tSU hF μ * tSU hF ω = tSU hF ω * tSU hF μ
    rw [← map_mul, ← map_mul, mul_comm]
  have hconj : ∀ y : 𝔾, (MulAut.conj 𝔤₀⁻¹).toMonoidHom y = 𝔤₀⁻¹ * y * 𝔤₀ := by
    intro y
    simp
  have hidx : (W.map (MulAut.conj 𝔤₀⁻¹).toMonoidHom).index = W.index :=
    Subgroup.index_map_equiv W (MulAut.conj 𝔤₀⁻¹)
  rw [← hidx]
  generalize hW' : W.map (MulAut.conj 𝔤₀⁻¹).toMonoidHom = W'
  have hs₁ : 𝔰₁ ∈ W' := by
    rw [← hW']
    exact ⟨sSU, hsW, by rw [hconj, s1_eq_conj]⟩
  have hZW' : ∀ μ ∈ rootsOfUnity (2 ^ f + 1) F, tSU hF μ ∈ W' := by
    intro μ hμ
    rw [← hW']
    refine ⟨tSU hF μ, hZW μ hμ, ?_⟩
    rw [hconj, mul_assoc, ← g0_comm_tSU hF hμ, inv_mul_cancel_left]
  have hs₁sq : 𝔰₁ * 𝔰₁ = 1 := mat_injective (by rw [map_mul, mat_s1SU, s1Mat_mul_self, map_one])
  have hs₁ne : 𝔰₁ ≠ 1 := by
    intro h
    have h' := congrArg (fun y : 𝔾 => mat (unitaryInvolution F 2 f) 3 y 0 2) h
    simp only [mat_s1SU, map_one] at h'
    simp [s1Mat] at h'
  have hs₁2 : IsPGroup 2 (Subgroup.zpowers (⟨𝔰₁, hs₁⟩ : W')) := by
    refine IsPGroup.of_card (n := 1) ?_
    rw [Nat.card_zpowers, pow_one]
    refine orderOf_eq_prime ?_ ?_
    · exact Subtype.ext (by rw [SubgroupClass.coe_pow, pow_two]; exact hs₁sq)
    · intro h
      exact hs₁ne (congrArg Subtype.val h)
  obtain ⟨P₀, hP₀⟩ := hs₁2.exists_le_sylow
  have hP2 : IsPGroup 2 ((P₀ : Subgroup W').map W'.subtype) := P₀.isPGroup'.map _
  have hPs : 𝔰₁ ∈ (P₀ : Subgroup W').map W'.subtype :=
    ⟨⟨𝔰₁, hs₁⟩, hP₀ (Subgroup.mem_zpowers _), rfl⟩
  have hPU : (P₀ : Subgroup W').map W'.subtype ≤ rootU hF := le_rootU_of_mem hF hP2 hPs
  have hPW : (P₀ : Subgroup W').map W'.subtype ≤ W' := Subgroup.map_subtype_le _
  have hS := eq_top_or_ca_eq_zero (p := 2) hF hq3 (S := W' ⊓ rootU hF) inf_le_right
    fun μ hμ x hx => ⟨W'.mul_mem (W'.mul_mem (hZW' μ hμ) hx.1) (W'.inv_mem (hZW' μ hμ)),
      tSU_conj_mem_rootU hF μ hx.2⟩
  rcases hS with hS | hS
  ·
    left
    have hUW : rootU hF ≤ W' := by rw [← hS]; exact inf_le_left
    intro h2
    exact odd_index_factor hF (index_rootU hF ▸ h2.trans (Subgroup.index_dvd_of_le hUW))
  ·
    right
    have hcardS : Nat.card (W' ⊓ rootU hF : Subgroup 𝔾) ≤ 2 ^ f := by
      rw [← card_traceZero (p := 2) hF]
      refine Nat.card_le_card_of_injective
        (fun x : (W' ⊓ rootU hF : Subgroup 𝔾) =>
          (⟨cb (x : 𝔾), cb_add_of_ca_eq_zero hF x.2.2 (hS _ x.2)⟩ :
            traceZero (unitaryInvolution F 2 f))) ?_
      intro x y hxy
      have hb : cb (x : 𝔾) = cb (y : 𝔾) := congrArg Subtype.val hxy
      exact Subtype.ext (eq_of_ca_cb hF x.2.2 y.2.2 ((hS _ x.2).trans (hS _ y.2).symm) hb)
    have hPS : Nat.card ((P₀ : Subgroup W').map W'.subtype) ≤ 2 ^ f :=
      (Subgroup.card_le_of_le (le_inf hPW hPU)).trans hcardS
    have hPcard : Nat.card ((P₀ : Subgroup W').map W'.subtype) =
        2 ^ (Nat.card W').factorization 2 := by
      rw [Subgroup.card_map_of_injective W'.subtype_injective]
      exact P₀.card_eq_multiplicity
    have hv : (Nat.card W').factorization 2 ≤ f := by
      rw [hPcard] at hPS
      exact (Nat.pow_le_pow_iff_right (by norm_num)).1 hPS
    have hf2 := two_le_f hF hq3
