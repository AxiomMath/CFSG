variable {K : Type} [Field K] [Finite K] [CharP K 2] {σ : K →+* K} {q : ℕ}

theorem borelQuotient_d4tw (hq : 2 ≤ q) (hK : Nat.card K = q ^ 3) (hσq : ∀ c, σ c = c ^ q)
    {Y : Type} [Group Y] (e : Y ≃* DerivedCentralQuotient (twistedFixedGroup .D4 K σ)) :
    BorelQuotient (twistedDatum σ) (nHat σ) (hHat σ)
      (e.symm.toMonoidHom.comp ((QuotientGroup.mk' _).comp
        (twistedGroupEquivDerived σ hq hK hσq).toMonoidHom)) (Nat.card Kˣ) := by
  have hσ : ∀ c, σ (σ (σ c)) = c := CFSG.LieType.Steinberg.TwistedD4.sigma_three_of_card hK hσq
  have hZ := CFSG.LieType.Steinberg.CentralExt.TrialityClosed.twistedGroup_center_eq_bot_of_card
    (σ := σ) hq hK hσq
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set E := twistedGroupEquivDerived σ hq hK hσq with hE
  have hker : ∀ z : twistedGroup σ, (e.symm.toMonoidHom.comp ((QuotientGroup.mk' _).comp
      E.toMonoidHom)) z = 1 → z = 1 := by
    intro z hz
    have h1 : (QuotientGroup.mk' (Subgroup.center ↥⁅twistedFixedGroup TwistTag.D4 K σ,
        twistedFixedGroup TwistTag.D4 K σ⁆)) (E z) = 1 := by
      apply e.symm.injective
      simpa using hz
    have h2 : E z ∈ Subgroup.center ↥⁅twistedFixedGroup TwistTag.D4 K σ,
        twistedFixedGroup TwistTag.D4 K σ⁆ := (QuotientGroup.eq_one_iff _).1 h1
    have h3 : z ∈ Subgroup.center (twistedGroup σ) := by
      rw [Subgroup.mem_center_iff]
      intro g
      apply E.injective
      rw [map_mul, map_mul]
      exact (Subgroup.mem_center_iff.1 h2 (E g))
    rw [hZ, Subgroup.mem_bot] at h3
    exact h3
  refine
    { ct := twistedDatum_isCTGroupDatum σ hσ
      extras := twistedDatum_steinbergExtras σ hσ
      pGroup := fun β hβ => CFSG.LieType.HighestRoot.isPGroup_twistedD4_rootGroup σ hσ
        (isRoot_of_mem_twistedDatum_roots σ hβ)
      surj := e.symm.surjective.comp ((QuotientGroup.mk'_surjective _).comp E.surjective)
      odd := by rw [Nat.card_units]; exact odd_card_sub_one K
      torus_pow := fun i g hg => CFSG.LieType.Steinberg.CentralExt.TrialityClosed.pow_eq_one_of_mem_hHat i hg
      ker_central := fun z hz => by
        rw [hker z (MonoidHom.mem_ker.1 hz)]
        exact Subgroup.one_mem _
      ker_pow := fun z hz => by
        rw [hker z (MonoidHom.mem_ker.1 hz), one_pow] }

omit [Finite K] [CharP K 2]
  in
theorem hasSL2Node_d4tw (hσ : ∀ c, σ (σ (σ c)) = c) : HasSL2Node (twistedDatum σ) (ng 1) K := by
  refine ⟨slShort σ hσ, slShort_injective hσ, fun c => ?_, fun c => ?_⟩
  · show _ ∈ (twistedRootSubgroupD4 σ _).subgroupOf (twistedGroup σ)
    rw [Subgroup.mem_subgroupOf, slShort_upper]
    have := xOuter_mem σ (s := 1) (Or.inl rfl) (hσ c)
    rw [one_smul] at this
    exact this
  · show _ ∈ (twistedRootSubgroupD4 σ _).subgroupOf (twistedGroup σ)
    rw [Subgroup.mem_subgroupOf, slShort_lower]
    have := xOuter_mem σ (s := -1) (Or.inr rfl) (hσ c)
    rw [neg_one_smul] at this
    exact this

end CFSG.AGLEmbeddingD2.Tits.MsideParabolicEscape.Exceptional
