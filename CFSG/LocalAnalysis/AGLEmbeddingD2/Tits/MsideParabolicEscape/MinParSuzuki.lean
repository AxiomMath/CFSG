theorem exists_conj_mem_of_two_element {S : Type} [Group S] [Finite S] {U : Subgroup S}
    (hU : IsSylowTwoOf U ⊤) {g : S} (hg : ∃ k : ℕ, orderOf g = 2 ^ k) :
    ∃ h : S, h⁻¹ * g * h ∈ U := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hidx : ¬ 2 ∣ U.index := by
    have := hU.2.2
    rwa [show (U.subgroupOf ⊤).index = U.index from Subgroup.relIndex_top_right U] at this
  let U' : Sylow 2 S := hU.2.1.toSylow hidx
  obtain ⟨k, hk⟩ := hg
  have hp : IsPGroup 2 (Subgroup.zpowers g) := by
    refine IsPGroup.iff_orderOf.2 fun ⟨x, hx⟩ => ?_
    obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 hx
    have hd : orderOf (g ^ m) ∣ 2 ^ k := hk ▸ orderOf_dvd_of_pow_eq_one (by
      rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, pow_orderOf_eq_one,
        one_zpow])
    obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hd
    exact ⟨j, by rw [← hj, ← Subgroup.orderOf_coe]⟩
  obtain ⟨Q, hQ⟩ := hp.exists_le_sylow
  obtain ⟨h, hh⟩ := MulAction.exists_smul_eq S U' Q
  have hgQ : g ∈ (Q : Subgroup S) := hQ (Subgroup.mem_zpowers g)
  have h1 := congrArg (fun T : Sylow 2 S => (T : Subgroup S)) hh
  simp only [Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def] at h1
  rw [← h1] at hgQ
  obtain ⟨u, hu, hug⟩ := hgQ
  refine ⟨h, ?_⟩
  have : h⁻¹ * g * h = u := by
    have h2 : h * u * h⁻¹ = g := hug
    rw [← h2]; group
  rw [this]; exact hu

section Sz

variable {a : ℕ} {K : Type} [Field K] [Finite K]
  (hK : Nat.card K = 2 ^ (2 * a + 1))

include hK in
theorem suzukiU_isPGroup : IsPGroup 2 (suzukiU a K) :=
  IsPGroup.of_card (n := (2 * a + 1) * 2) (by
    rw [(suzuki_unipotent_structure hK).2.1, pow_mul])

include hK in
theorem suzukiU_isSylowTwoOf : IsSylowTwoOf (suzukiU a K) ⊤ := by
  refine ⟨le_top, suzukiU_isPGroup hK, ?_⟩
  rw [show ((suzukiU a K).subgroupOf ⊤).index = (suzukiU a K).index from
    Subgroup.relIndex_top_right _]
  have h := Subgroup.card_mul_index (suzukiU a K)
  rw [(suzuki_unipotent_structure hK).2.1, suzuki_order hK] at h
  obtain ⟨x, hx⟩ : ∃ x : ℕ, 2 ^ (2 * a + 1) = 2 * x ∧ 1 ≤ x :=
    ⟨2 ^ (2 * a), by ring, Nat.one_le_two_pow⟩
  have hq : 0 < (2 ^ (2 * a + 1)) ^ 2 := by positivity
  have hidx : (suzukiU a K).index = (2 ^ (2 * a + 1) - 1) * ((2 ^ (2 * a + 1)) ^ 2 + 1) := by
    refine Nat.eq_of_mul_eq_mul_left hq ?_
    rw [← mul_assoc, h]
  rw [hidx]
  rintro ⟨c, hc⟩
  obtain ⟨hx1, hx2⟩ := hx
  rw [hx1] at hc
  have h1 : (2 * x - 1) * ((2 * x) ^ 2 + 1) % 2 = 1 := by
    have h2 : (2 * x - 1) % 2 = 1 := by omega
    have h3 : ((2 * x) ^ 2 + 1) % 2 = 1 := by
      have : (2 * x) ^ 2 = 2 * (2 * x ^ 2) := by ring
      omega
    rw [Nat.mul_mod, h2, h3]
  omega

include hK in
theorem suzukiU_ne_bot : suzukiU a K ≠ ⊥ := by
  intro h
  have h1 := (suzuki_unipotent_structure hK).2.1
  rw [h, Subgroup.card_bot] at h1
  have : 2 ≤ 2 ^ (2 * a + 1) := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ (2 * a + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  nlinarith

include hK in
theorem suzuki_normalizer_eq :
    Subgroup.normalizer (suzukiU a K : Set (suzukiGroup a K)) = suzukiB a K := by
  apply le_antisymm
  · intro g hg
    rw [← (suzuki_ovoid_stabilizer hK).1, MulAction.mem_stabilizer_iff]
    by_contra hne
    have hΩ : g • suzukiInfty K ∈ suzukiOmega a K :=
      (suzuki_ovoid_double_transitivity hK).1 g _ (suzukiInfty_mem_suzukiOmega a K)
    have hx : g • suzukiInfty K ∈ suzukiOmega a K \ {suzukiInfty K} := ⟨hΩ, hne⟩
    have hfix : ∀ u ∈ suzukiU a K, u • (g • suzukiInfty K) = g • suzukiInfty K := by
      intro u hu
      have hu' : g⁻¹ * u * g ∈ suzukiU a K := by
        have := (Subgroup.mem_normalizer_iff.1 (inv_mem hg) u).1 hu
        simpa using this
      have h1 : (g⁻¹ * u * g) • suzukiInfty K = suzukiInfty K :=
        MulAction.mem_stabilizer_iff.1 (suzukiB_le_stabilizer hK (Subgroup.mem_sup_left hu'))
      calc u • (g • suzukiInfty K) = (g * (g⁻¹ * u * g)) • suzukiInfty K := by
            rw [show g * (g⁻¹ * u * g) = u * g by group, mul_smul]
        _ = g • suzukiInfty K := by rw [mul_smul, h1]
    obtain ⟨g0, -, huniq⟩ := (suzuki_ovoid_unipotent_action hK).2.2.2.2.2.1 _ hx _ hx
    apply suzukiU_ne_bot hK
    rw [eq_bot_iff]
    intro u hu
    have h1 : (⟨u, hu⟩ : suzukiU a K) = g0 := huniq _ (hfix u hu)
    have h2 : (1 : suzukiU a K) = g0 := huniq _ (one_smul _ _)
    have : (⟨u, hu⟩ : suzukiU a K) = 1 := h1.trans h2.symm
    exact Subgroup.mem_bot.2 (congrArg Subtype.val this)
  · exact sup_le Subgroup.le_normalizer (suzuki_borel_structure hK).2.2.2.1

include hK in
theorem suzuki_oneNode : OneNode (suzukiGroup a K) (suzukiU a K) where
  pgroup := suzukiU_isPGroup hK
  coatom := by
    rw [suzuki_normalizer_eq hK, ← (suzuki_ovoid_stabilizer hK).2]
    haveI : MulAction.IsPreprimitive (suzukiGroup a K) (suzukiOmegaSub hK) :=
      (suzuki_ovoid_double_transitivity hK).2.2.2.2
    haveI : Nontrivial (suzukiOmegaSub hK) :=
      ⟨⟨⟨suzukiInfty K, suzukiInfty_mem_suzukiOmega a K⟩,
        ⟨suzukiLine a K 0 0, suzukiLine_mem_suzukiOmega a K 0 0⟩, fun h =>
          suzukiLine_ne_suzukiInfty 0 0 (congrArg Subtype.val h).symm⟩⟩
    exact MulAction.IsPreprimitive.isCoatom_stabilizer_of_isPreprimitive
      (G := suzukiGroup a K) (X := suzukiOmegaSub hK)
      ⟨suzukiInfty K, suzukiInfty_mem_suzukiOmega a K⟩
  ov := by
    intro X hUX hX
    rw [suzuki_normalizer_eq hK, ← (suzuki_ovoid_stabilizer hK).1] at hX
    obtain ⟨x₀, hx₀X, hx₀⟩ := Set.not_subset.1 hX
    have hx₀' : x₀ • suzukiInfty K ≠ suzukiInfty K := fun h =>
      hx₀ (MulAction.mem_stabilizer_iff.2 h)
    have hΩ : ∀ g : suzukiGroup a K, ∀ x ∈ suzukiOmega a K, g • x ∈ suzukiOmega a K :=
      (suzuki_ovoid_double_transitivity hK).1
    have htrans : ∀ ω ∈ suzukiOmega a K, ∃ x' ∈ X, x' • suzukiInfty K = ω := by
      intro ω hω
      by_cases hωinf : ω = suzukiInfty K
      · exact ⟨1, X.one_mem, by rw [one_smul, hωinf]⟩
      · have hω₀ : x₀ • suzukiInfty K ∈ suzukiOmega a K \ {suzukiInfty K} :=
          ⟨hΩ x₀ _ (suzukiInfty_mem_suzukiOmega a K), hx₀'⟩
        obtain ⟨u, hu, -⟩ := (suzuki_ovoid_unipotent_action hK).2.2.2.2.2.1 _ hω₀ ω ⟨hω, hωinf⟩
        refine ⟨(u : suzukiGroup a K) * x₀, X.mul_mem (hUX u.2) hx₀X, ?_⟩
        rw [mul_smul]; exact hu
    unfold pElementSubgroup
    rw [Subgroup.closure_le]
    rintro g ⟨-, hg2⟩
    obtain ⟨h, hh⟩ := exists_conj_mem_of_two_element (suzukiU_isSylowTwoOf hK) hg2
    obtain ⟨x', hx'X, hx'⟩ := htrans (h • suzukiInfty K)
      (hΩ h _ (suzukiInfty_mem_suzukiOmega a K))
    have ht : x'⁻¹ * h ∈ suzukiB a K := by
      rw [← (suzuki_ovoid_stabilizer hK).1, MulAction.mem_stabilizer_iff, mul_smul, ← hx',
        inv_smul_smul]
    have htN : x'⁻¹ * h ∈ Subgroup.normalizer (suzukiU a K : Set (suzukiGroup a K)) := by
      rw [suzuki_normalizer_eq hK]; exact ht
    have h1 : (x'⁻¹ * h) * (h⁻¹ * g * h) * (x'⁻¹ * h)⁻¹ ∈ suzukiU a K :=
      (Subgroup.mem_normalizer_iff.1 htN _).1 hh
    have h2 : (x'⁻¹ * h) * (h⁻¹ * g * h) * (x'⁻¹ * h)⁻¹ = x'⁻¹ * g * x' := by group
    rw [h2] at h1
    have h3 : x' * (x'⁻¹ * g * x') * x'⁻¹ ∈ X :=
      X.mul_mem (X.mul_mem hx'X (hUX h1)) (X.inv_mem hx'X)
    have h4 : x' * (x'⁻¹ * g * x') * x'⁻¹ = g := by group
    rw [h4] at h3
    exact h3

end Sz

theorem suzuki_cat {S : Type} [Group S] [Finite S] (m : ℕ)
    (hv : (TauCeti.LieTypeIndex.suzuki m).Valid)
    (e : S ≃* (TauCeti.CFSGIndex.lie ⟨TauCeti.LieTypeIndex.suzuki m, hv⟩).Group)
    {T : Subgroup S} (hT : IsSylowTwoOf T ⊤) : IsSimpleGroup S ∧ OneNode S T := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hm : 1 ≤ m := by
    have := (TauCeti.LieTypeIndex.valid_iff _).1 hv
    have h2 := (TauCeti.LieTypeIndex.inStandardRange_iff _).1 this.1
    exact h2
  have hK : Nat.card (GaloisField 2 (2 * m + 1)) = 2 ^ (2 * m + 1) :=
    GaloisField.card 2 (2 * m + 1) (by omega)
  let ψ : suzukiGroup m (GaloisField 2 (2 * m + 1)) ≃* S :=
    ((CFSG.ShultStronglyClosedTI.SuzukiModel.suzukiGroupEquivSuzukiMatrixGroup hK).trans
      (CFSG.BenderSuzuki.Catalog.groupEquivSuzukiMatrixGroup hv).symm).trans e.symm
  refine ⟨?_, ?_⟩
  · haveI := (suzuki_simple hm hK).2.2
    exact MulEquiv.isSimpleGroup ψ.symm
  · have h0 : IsSylowTwoOf ((suzukiU m (GaloisField 2 (2 * m + 1))).map ψ.toMonoidHom) ⊤ :=
      ChevGen.isSylowTwoOf_top_map_equiv ψ (suzukiU_isSylowTwoOf hK)
    exact OneNode.of_sylow h0 hT ((suzuki_oneNode hK).map ψ)

