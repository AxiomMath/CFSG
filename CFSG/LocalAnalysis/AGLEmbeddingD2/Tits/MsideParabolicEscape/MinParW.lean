section Central

variable {G Q : Type*} [Group G] [Finite G] [Group Q]

theorem mem_of_central_lift (q : G →* Q) (hker : q.ker ≤ Subgroup.center G) {X : Subgroup G}
    (hZX : ∀ z ∈ q.ker, (∃ k : ℕ, orderOf z = 2 ^ k) → z ∈ X) {a : G}
    (ha : ∃ k : ℕ, orderOf a = 2 ^ k) {x : G} (hx : x ∈ X) (hqx : q x = q a) : a ∈ X := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨ka, hka⟩ := ha
  have hqa : ∃ k : ℕ, orderOf (q x) = 2 ^ k := by
    have hd : orderOf (q x) ∣ 2 ^ ka := by
      rw [hqx, ← hka]; exact orderOf_map_dvd q a
    obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hd
    exact ⟨j, hj⟩
  obtain ⟨e, ⟨kb, hkb⟩, hfe⟩ := exists_pElement_lift q (p := 2) (x := x) hqa
  set y := x ^ e with hy
  have hyX : y ∈ X := Subgroup.pow_mem _ hx e
  have hz : a * y⁻¹ ∈ q.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hfe, hqx, mul_inv_cancel]
  have hzc : a * y⁻¹ ∈ Subgroup.center G := hker hz
  have hza := Subgroup.mem_center_iff.1 hzc
  have hcomm : Commute a y⁻¹ := by
    have h1 : y⁻¹ * (a * y⁻¹) = a * y⁻¹ * y⁻¹ := hza y⁻¹
    rw [← mul_assoc] at h1
    exact (mul_right_cancel h1).symm
  have hN : (a * y⁻¹) ^ 2 ^ (ka + kb) = 1 := by
    rw [hcomm.mul_pow]
    have h1 : a ^ 2 ^ (ka + kb) = 1 := by
      refine orderOf_dvd_iff_pow_eq_one.1 ?_
      rw [hka]; exact pow_dvd_pow 2 (Nat.le_add_right _ _)
    have h2 : y ^ 2 ^ (ka + kb) = 1 := by
      refine orderOf_dvd_iff_pow_eq_one.1 ?_
      rw [hkb]; exact pow_dvd_pow 2 (Nat.le_add_left _ _)
    rw [inv_pow, h2, h1]; simp
  obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 (orderOf_dvd_of_pow_eq_one hN)
  have hzX : a * y⁻¹ ∈ X := hZX _ hz ⟨j, hj⟩
  have : a = (a * y⁻¹) * y := by group
  rw [this]
  exact X.mul_mem hzX hyX

theorem mem_of_central_pElement {S₀ : Subgroup G} (hS : ∃ S : Sylow 2 G, (S : Subgroup G) = S₀)
    {z : G} (hz : z ∈ Subgroup.center G) (h2 : ∃ k : ℕ, orderOf z = 2 ^ k) : z ∈ S₀ := by
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨S, rfl⟩ := hS
  obtain ⟨k, hk⟩ := h2
  have hp : IsPGroup 2 (Subgroup.zpowers z) := by
    refine IsPGroup.iff_orderOf.2 fun ⟨x, hx⟩ => ?_
    obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 hx
    have hd : orderOf (z ^ m) ∣ 2 ^ k := hk ▸ orderOf_dvd_of_pow_eq_one (by
      rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, pow_orderOf_eq_one, one_zpow])
    obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hd
    exact ⟨j, by rw [← hj, ← Subgroup.orderOf_coe]⟩
  obtain ⟨S', hS'⟩ := hp.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G S S'
  have hzS' : z ∈ (S' : Subgroup G) := hS' (Subgroup.mem_zpowers z)
  rw [← hg, Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def] at hzS'
  obtain ⟨y, hy, hyz⟩ := hzS'
  have : y = z := by
    have h1 : g * y * g⁻¹ = z := hyz
    have h2 := Subgroup.mem_center_iff.1 hz g
    calc y = g⁻¹ * (g * y * g⁻¹) * g := by group
      _ = g⁻¹ * z * g := by rw [h1]
      _ = z := by rw [mul_assoc, ← h2]; group
  rw [← this]; exact hy

end Central

section Transfer

variable {W : Type} [Group W] [Finite W] {L S₀ : Subgroup W}

theorem normalizer_eq_comap (hS : IsSylowTwoOf S₀ L) :
    Subgroup.normalizer ((S₀.subgroupOf L : Subgroup ↥L) : Set ↥L) =
      (Subgroup.normalizer ((((S₀.subgroupOf L).map (QuotientGroup.mk' (Subgroup.center ↥L))) :
        Subgroup (↥L ⧸ Subgroup.center ↥L)) : Set (↥L ⧸ Subgroup.center ↥L))).comap
        (QuotientGroup.mk' (Subgroup.center ↥L)) := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set Z := Subgroup.center ↥L with hZ
  set q : ↥L →* ↥L ⧸ Z := QuotientGroup.mk' Z with hqdef
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective Z
  have hqker : q.ker = Z := by rw [hqdef, QuotientGroup.ker_mk']
  obtain ⟨S, hSS⟩ := McLaughlin.Lie.exists_sylow_of_isSylowTwoOf hS
  set S₀' : Subgroup ↥L := S₀.subgroupOf L with hS₀'
  ext x
  constructor
  · intro hx
    rw [Subgroup.mem_comap]
    exact Subgroup.le_normalizer_map q ⟨x, hx, rfl⟩
  · intro hx
    rw [Subgroup.mem_comap] at hx
    have h1 := normalizer_map_le S hq (by rw [hqker]) (by rw [hSS]; exact hx)
    obtain ⟨x', hx', hxx'⟩ := h1
    have hz : x'⁻¹ * x ∈ Z := by
      rw [← hqker, MonoidHom.mem_ker, map_mul, map_inv, hxx', inv_mul_cancel]
    have : x = x' * (x'⁻¹ * x) := by group
    rw [this]
    exact Subgroup.mul_mem _ (by rwa [hSS] at hx')
      (Subgroup.center_le_normalizer (S₀' : Set ↥L) hz)

theorem inf_normalizer_eq_map (hS : IsSylowTwoOf S₀ L) :
    L ⊓ Subgroup.normalizer (S₀ : Set W) =
      (Subgroup.normalizer ((S₀.subgroupOf L : Subgroup ↥L) : Set ↥L)).map L.subtype := by
  rw [map_normalizer_eq_inf', Subgroup.map_subgroupOf_eq_of_le hS.1, inf_comm]

theorem central_pElement_mem (hS : IsSylowTwoOf S₀ L) {z : ↥L} (hz : z ∈ Subgroup.center ↥L)
    (h2 : ∃ k : ℕ, orderOf z = 2 ^ k) : z ∈ S₀.subgroupOf L :=
  mem_of_central_pElement (McLaughlin.Lie.exists_sylow_of_isSylowTwoOf hS) hz h2

theorem center_le_comap_normalizer (hS : IsSylowTwoOf S₀ L) :
    Subgroup.center ↥L ≤ (Subgroup.normalizer ((((S₀.subgroupOf L).map
      (QuotientGroup.mk' (Subgroup.center ↥L))) : Subgroup (↥L ⧸ Subgroup.center ↥L)) :
        Set (↥L ⧸ Subgroup.center ↥L))).comap (QuotientGroup.mk' (Subgroup.center ↥L)) := by
  rw [← normalizer_eq_comap hS]
  exact Subgroup.center_le_normalizer _

theorem comap_normalizer_le {A : Subgroup W} (hS : IsSylowTwoOf S₀ L)
    (hA : IsMinOverBorel L S₀ A) :
    (Subgroup.normalizer ((((S₀.subgroupOf L).map (QuotientGroup.mk' (Subgroup.center ↥L))) :
      Subgroup (↥L ⧸ Subgroup.center ↥L)) : Set (↥L ⧸ Subgroup.center ↥L))).comap
      (QuotientGroup.mk' (Subgroup.center ↥L)) ≤ A.subgroupOf L := by
  have h1 := hA.2.1.le
  rw [inf_normalizer_eq_map hS, normalizer_eq_comap hS] at h1
  exact Subgroup.map_le_iff_le_comap.1 h1

theorem isMinOverBorel_map_of_isMinOverBorel (hS : IsSylowTwoOf S₀ L) {A : Subgroup W}
    (hA : IsMinOverBorel L S₀ A) :
    IsMinOverBorel (⊤ : Subgroup (↥L ⧸ Subgroup.center ↥L))
      ((S₀.subgroupOf L).map (QuotientGroup.mk' (Subgroup.center ↥L)))
      ((A.subgroupOf L).map (QuotientGroup.mk' (Subgroup.center ↥L))) := by
  classical
  set Z := Subgroup.center ↥L with hZ
  set q : ↥L →* ↥L ⧸ Z := QuotientGroup.mk' Z with hqdef
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective Z
  have hqker : q.ker = Z := by rw [hqdef, QuotientGroup.ker_mk']
  set T : Subgroup (↥L ⧸ Z) := (S₀.subgroupOf L).map q with hT
  set B : Subgroup (↥L ⧸ Z) := Subgroup.normalizer (T : Set (↥L ⧸ Z)) with hB
  set BL : Subgroup ↥L := B.comap q with hBL
  have hBW : L ⊓ Subgroup.normalizer (S₀ : Set W) = BL.map L.subtype := by
    rw [inf_normalizer_eq_map hS, normalizer_eq_comap hS]
  have hZBL : Z ≤ BL := center_le_comap_normalizer hS
  have hBA : BL ≤ A.subgroupOf L := comap_normalizer_le hS hA
  have hZA : Z ≤ A.subgroupOf L := hZBL.trans hBA
  obtain ⟨hAL, hlt, hmin⟩ := hA
  rw [hBW] at hlt hmin
  have hAe : (A.subgroupOf L).map L.subtype = A := Subgroup.map_subgroupOf_eq_of_le hAL
  have hcm : ((A.subgroupOf L).map q).comap q = A.subgroupOf L := by
    rw [Subgroup.comap_map_eq, hqker]; exact sup_eq_left.2 hZA
  have hBq : BL.map q = B := Subgroup.map_comap_eq_self_of_surjective hq B
  refine ⟨le_top, ?_, ?_⟩
  · rw [top_inf_eq]
    refine lt_of_le_of_ne (hBq.symm.le.trans (Subgroup.map_mono hBA)) fun heq => ?_
    have h1 : BL = A.subgroupOf L := by
      have := congrArg (Subgroup.comap q) heq
      exact this.trans hcm
    apply hlt.ne
    rw [h1, hAe]
  · intro Q hQ1 hQ2
    rw [top_inf_eq] at hQ1 ⊢
    have h1 : BL ≤ Q.comap q := Subgroup.comap_mono hQ1
    have h2 : Q.comap q ≤ A.subgroupOf L := by
      have := Subgroup.comap_mono (f := q) hQ2
      rwa [hcm] at this
    rcases hmin ((Q.comap q).map L.subtype) (Subgroup.map_mono h1)
      ((Subgroup.map_mono h2).trans hAe.le) with h3 | h3
    · left
      have : Q.comap q = BL := Subgroup.map_injective L.subtype_injective h3
      rw [← Subgroup.map_comap_eq_self_of_surjective hq Q, this, hBq]
    · right
      have : Q.comap q = A.subgroupOf L := Subgroup.map_injective L.subtype_injective
        (h3.trans hAe.symm)
      rw [← Subgroup.map_comap_eq_self_of_surjective hq Q, this]

end Transfer

