variable {W : Type} [Group W] [Finite W] {L S₀ : Subgroup W}
  (D : MinParData (⊤ : Subgroup (↥L ⧸ Subgroup.center ↥L))
    ((S₀.subgroupOf L).map (QuotientGroup.mk' (Subgroup.center ↥L))))

@[expose] def Pc (i : D.ι) : Subgroup W :=
  ((D.P i).comap (QuotientGroup.mk' (Subgroup.center ↥L))).map L.subtype

theorem iSup_Pc_eq (J : Set D.ι) :
    (⨆ j ∈ J, Pc D j) =
      (⨆ j ∈ J, (D.P j).comap (QuotientGroup.mk' (Subgroup.center ↥L))).map L.subtype := by
  simp only [Pc, Subgroup.map_iSup]

theorem Pc_inj : Function.Injective (Pc D) := fun i j e => by
  apply D.P_inj
  exact Subgroup.comap_injective (f := QuotientGroup.mk' (Subgroup.center ↥L))
    (QuotientGroup.mk'_surjective _) (Subgroup.map_injective L.subtype_injective e)

theorem pAll_center (hS : IsSylowTwoOf S₀ L) {A : Subgroup W} (hA : IsMinOverBorel L S₀ A) :
    ∃ i, A = Pc D i := by
  obtain ⟨i, hi⟩ := D.P_all _ (isMinOverBorel_map_of_isMinOverBorel hS hA)
  refine ⟨i, ?_⟩
  have hZA : Subgroup.center ↥L ≤ A.subgroupOf L :=
    (center_le_comap_normalizer hS).trans (comap_normalizer_le hS hA)
  have hcm : ((A.subgroupOf L).map (QuotientGroup.mk' (Subgroup.center ↥L))).comap
      (QuotientGroup.mk' (Subgroup.center ↥L)) = A.subgroupOf L := by
    rw [Subgroup.comap_map_eq, QuotientGroup.ker_mk']
    exact sup_eq_left.2 hZA
  rw [Pc, ← hi, hcm, Subgroup.map_subgroupOf_eq_of_le hA.1]

theorem ov_center (hS : IsSylowTwoOf S₀ L) {X : Subgroup W} (hSX : S₀ ≤ X) (hXL : X ≤ L)
    (hX : ¬ X ≤ Subgroup.normalizer (S₀ : Set W)) :
    ∃ i, pElementSubgroup 2 (Pc D i) ≤ X := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hqker : (qq).ker = Subgroup.center ↥L := QuotientGroup.ker_mk' _
  set X' : Subgroup ↥L := X.subgroupOf L with hX'
  have hSX' : S₀.subgroupOf L ≤ X' := fun x hx => hSX hx
  have hTX : (S₀.subgroupOf L).map (qq) ≤ X'.map (qq) := Subgroup.map_mono hSX'
  have hnN : ¬ X'.map (qq) ≤ Subgroup.normalizer
      ((((S₀.subgroupOf L).map (qq)) : Subgroup (↥L ⧸ (Subgroup.center ↥L))) : Set (↥L ⧸ (Subgroup.center ↥L))) := by
    intro hle
    apply hX
    have h1 : X' ≤ (Subgroup.normalizer
      ((((S₀.subgroupOf L).map (qq)) : Subgroup (↥L ⧸ (Subgroup.center ↥L))) : Set (↥L ⧸ (Subgroup.center ↥L)))).comap (qq) :=
      Subgroup.map_le_iff_le_comap.1 hle
    rw [← normalizer_eq_comap hS] at h1
    have : X = X'.map L.subtype := (Subgroup.map_subgroupOf_eq_of_le hXL).symm
    rw [this]
    exact (Subgroup.map_mono h1).trans ((inf_normalizer_eq_map hS).symm.le.trans inf_le_right)
  obtain ⟨i, hi⟩ := D.OV (X'.map (qq)) hTX le_top hnN
  refine ⟨i, ?_⟩
  unfold pElementSubgroup
  rw [Subgroup.closure_le]
  rintro a ⟨ha, k, hk⟩
  obtain ⟨a', ha', rfl⟩ := ha
  have hk' : orderOf a' = 2 ^ k := by
    rw [← Subgroup.orderOf_coe]; exact hk
  have hq2 : ∃ j : ℕ, orderOf ((qq) a') = 2 ^ j := by
    have hd : orderOf ((qq) a') ∣ 2 ^ k := hk' ▸ orderOf_map_dvd (qq) a'
    obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hd
    exact ⟨j, hj⟩
  have hqP : (qq) a' ∈ pElementSubgroup 2 (D.P i) :=
    Subgroup.subset_closure ⟨ha', hq2⟩
  obtain ⟨x, hx, hxq⟩ := hi hqP
  have hker : (qq).ker ≤ Subgroup.center ↥L := hqker.le
  have := mem_of_central_lift (qq) hker (X := X') (fun z hz h2z =>
    hSX' (central_pElement_mem hS (hker hz) h2z)) ⟨k, hk'⟩ hx hxq
  exact this

theorem sub_center (hS : IsSylowTwoOf S₀ L) (J : Set D.ι) (k : D.ι) (hJ : J.Nonempty)
    (hle : pElementSubgroup 2 (Pc D k) ≤ ⨆ j ∈ J, Pc D j) : k ∈ J := by
  refine D.sub J k hJ ?_
  have hq : Function.Surjective (QuotientGroup.mk' (Subgroup.center ↥L)) :=
    QuotientGroup.mk'_surjective _
  have h1 : (pElementSubgroup 2 ((D.P k).comap (QuotientGroup.mk' (Subgroup.center ↥L)))).map
      L.subtype ≤ ⨆ j ∈ J, Pc D j := (map_pElementSubgroup_le _).trans hle
  rw [iSup_Pc_eq] at h1
  have h3 := (Subgroup.map_le_map_iff_of_injective L.subtype_injective).1 h1
  calc pElementSubgroup 2 (D.P k)
      ≤ (pElementSubgroup 2 ((D.P k).comap (QuotientGroup.mk' (Subgroup.center ↥L)))).map
        (QuotientGroup.mk' (Subgroup.center ↥L)) :=
        pElementSubgroup_le_map_pElementSubgroup_comap (D.P k)
    _ ≤ (⨆ j ∈ J, (D.P j).comap (QuotientGroup.mk' (Subgroup.center ↥L))).map
        (QuotientGroup.mk' (Subgroup.center ↥L)) := Subgroup.map_mono h3
    _ = ⨆ j ∈ J, D.P j := by
        simp only [Subgroup.map_iSup, Subgroup.map_comap_eq_self_of_surjective hq]

theorem two_center (hS : IsSylowTwoOf S₀ L) (J : Set D.ι) (hJ : J.Nonempty) {a : W}
    (ha : a ∈ ⨆ j ∈ J, Pc D j) (h2 : ∃ m : ℕ, orderOf a = 2 ^ m) :
    a ∈ ⨆ j ∈ J, pElementSubgroup 2 (Pc D j) := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hq : Function.Surjective (qq) := QuotientGroup.mk'_surjective _
  have hqker : (qq).ker = Subgroup.center ↥L := QuotientGroup.ker_mk' _
  rw [iSup_Pc_eq] at ha
  obtain ⟨a', ha', rfl⟩ := ha
  obtain ⟨m, hm⟩ := h2
  have hm' : orderOf a' = 2 ^ m := by
    rw [← Subgroup.orderOf_coe]; exact hm
  have h4 : (qq) a' ∈ ⨆ j ∈ J, D.P j := by
    have : (qq) a' ∈ (⨆ j ∈ J, (D.P j).comap (qq)).map (qq) := ⟨a', ha', rfl⟩
    simpa only [Subgroup.map_iSup, Subgroup.map_comap_eq_self_of_surjective hq] using this
  have hq2 : ∃ j : ℕ, orderOf ((qq) a') = 2 ^ j := by
    have hd : orderOf ((qq) a') ∣ 2 ^ m := hm' ▸ orderOf_map_dvd (qq) a'
    obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hd
    exact ⟨j, hj⟩
  have h5 := D.two J ((qq) a') hJ h4 hq2
  set Y' : Subgroup ↥L := ⨆ j ∈ J, pElementSubgroup 2 ((D.P j).comap (qq)) with hY'
  have h6 : (⨆ j ∈ J, pElementSubgroup 2 (D.P j)) ≤ Y'.map (qq) :=
    iSup₂_le fun j hj => (pElementSubgroup_le_map_pElementSubgroup_comap (D.P j)).trans
      (Subgroup.map_mono (le_iSup₂ (f := fun j (_ : j ∈ J) =>
        pElementSubgroup 2 ((D.P j).comap (qq))) j hj))
  obtain ⟨y, hy, hyq⟩ := h6 h5
  have hker : (qq).ker ≤ Subgroup.center ↥L := hqker.le
  have hZY : ∀ z ∈ (qq).ker, (∃ k : ℕ, orderOf z = 2 ^ k) → z ∈ Y' := by
    intro z hz h2z
    have hzS : z ∈ S₀.subgroupOf L := central_pElement_mem hS (hker hz) h2z
    obtain ⟨j0, hj0⟩ := hJ
    have hS' : S₀.subgroupOf L ≤ (D.P j0).comap (qq) := by
      refine Subgroup.map_le_iff_le_comap.1 ?_
      exact Subgroup.le_normalizer.trans (by simpa using (D.P_min j0).2.1.le)
    have : S₀.subgroupOf L ≤ pElementSubgroup 2 ((D.P j0).comap (qq)) :=
      le_pElementSubgroup_of_isPGroup hS' hS.2.1.comap_subtype
    exact le_iSup₂_of_le (f := fun j (_ : j ∈ J) => pElementSubgroup 2 ((D.P j).comap (qq)))
      j0 hj0 le_rfl (this hzS)
  have hmem := mem_of_central_lift (qq) hker hZY ⟨m, hm'⟩ hy hyq
  have h7 : Y'.map L.subtype ≤ ⨆ j ∈ J, pElementSubgroup 2 (Pc D j) := by
    rw [hY', Subgroup.map_iSup]
    refine iSup_le fun j => ?_
    rw [Subgroup.map_iSup]
    refine iSup_le fun hj => ?_
    exact (map_pElementSubgroup_le _).trans
      (le_iSup₂_of_le (f := fun j (_ : j ∈ J) => pElementSubgroup 2 (Pc D j)) j hj le_rfl)
  exact h7 ⟨a', hmem, rfl⟩

theorem nonnorm_center (hS : IsSylowTwoOf S₀ L) (i : D.ι) :
    ¬ pElementSubgroup 2 (Pc D i) ≤ Subgroup.normalizer (S₀ : Set W) := by
  intro hle
  apply D.nonnorm i
  have hq : Function.Surjective (QuotientGroup.mk' (Subgroup.center ↥L)) :=
    QuotientGroup.mk'_surjective _
  have h1 : (pElementSubgroup 2 ((D.P i).comap (QuotientGroup.mk' (Subgroup.center ↥L)))).map
      L.subtype ≤ Subgroup.normalizer (S₀ : Set W) := (map_pElementSubgroup_le _).trans hle
  have h2 : (pElementSubgroup 2 ((D.P i).comap (QuotientGroup.mk' (Subgroup.center ↥L)))).map
      L.subtype ≤ L ⊓ Subgroup.normalizer (S₀ : Set W) :=
    le_inf ((Subgroup.map_mono (pElementSubgroup_le _)).trans (Subgroup.map_subtype_le _)) h1
  rw [inf_normalizer_eq_map hS, normalizer_eq_comap hS] at h2
  have h3 := (Subgroup.map_le_map_iff_of_injective L.subtype_injective).1 h2
  calc pElementSubgroup 2 (D.P i)
      ≤ (pElementSubgroup 2 ((D.P i).comap (QuotientGroup.mk' (Subgroup.center ↥L)))).map
        (QuotientGroup.mk' (Subgroup.center ↥L)) :=
        pElementSubgroup_le_map_pElementSubgroup_comap (D.P i)
    _ ≤ ((Subgroup.normalizer ((((S₀.subgroupOf L).map
        (QuotientGroup.mk' (Subgroup.center ↥L))) : Subgroup (↥L ⧸ Subgroup.center ↥L)) :
          Set (↥L ⧸ Subgroup.center ↥L))).comap
        (QuotientGroup.mk' (Subgroup.center ↥L))).map (QuotientGroup.mk' (Subgroup.center ↥L)) :=
        Subgroup.map_mono h3
    _ = _ := Subgroup.map_comap_eq_self_of_surjective hq _

@[expose] noncomputable def minParData_of_center (hS : IsSylowTwoOf S₀ L) : MinParData L S₀ where
  ι := D.ι
  P := Pc D
  P_min := fun i => isMinOverBorel_preimage hS (D.P_min i)
  P_all := fun A hA => pAll_center D hS hA
  P_inj := Pc_inj D
  OV := fun X hSX hXL hX => ov_center D hS hSX hXL hX
  sub := fun J k hJ hle => sub_center D hS J k hJ hle
  two := fun J a hJ ha h2 => two_center D hS J hJ ha h2
  nonnorm := fun i => nonnorm_center D hS i

end Fields

