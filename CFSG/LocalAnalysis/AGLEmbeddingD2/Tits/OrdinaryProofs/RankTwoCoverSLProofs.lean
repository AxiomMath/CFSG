variable {n : ℕ} {F : Type} [Field F]

def InBlock (s : ℕ) (a : Fin n) : Prop := s ≤ a.val ∧ a.val < s + 3

variable (s : ℕ) (hs : s + 3 ≤ n)

def blockIdx (a : {a : Fin n // InBlock s a}) : Fin 3 :=
  ⟨a.1.val - s, by have h := a.2; unfold InBlock at h; omega⟩

def blockEmb : Fin 3 ≃ {a : Fin n // InBlock s a} where
  toFun k := ⟨⟨s + k.val, by omega⟩, by unfold InBlock; have := k.isLt; simp only; omega⟩
  invFun := blockIdx s
  left_inv k := by
    apply Fin.ext
    simp [blockIdx]
  right_inv a := by
    apply Subtype.ext
    apply Fin.ext
    have h := a.2
    unfold InBlock at h
    simp [blockIdx]
    omega

def blockEquiv3 : Fin 3 ⊕ {a : Fin n // ¬ InBlock s a} ≃ Fin n :=
  (Equiv.sumCongr (blockEmb s hs) (Equiv.refl _)).trans (Equiv.sumCompl (InBlock s))

def blockMat3 (A : Matrix (Fin 3) (Fin 3) F) : Matrix (Fin n) (Fin n) F :=
  Matrix.reindexAlgEquiv F F (blockEquiv3 s hs) (Matrix.fromBlocks A 0 0 1)

theorem blockMat3_apply (A : Matrix (Fin 3) (Fin 3) F) (p q : Fin n) :
    blockMat3 s hs A p q = Matrix.fromBlocks A 0 0 1 ((blockEquiv3 s hs).symm p)
      ((blockEquiv3 s hs).symm q) := by
  simp [blockMat3, Matrix.coe_reindexAlgEquiv, Matrix.reindex_apply]

theorem blockMat3_inl_inl (A : Matrix (Fin 3) (Fin 3) F) (k l : Fin 3) :
    blockMat3 s hs A (blockEquiv3 s hs (Sum.inl k)) (blockEquiv3 s hs (Sum.inl l)) = A k l := by
  rw [blockMat3_apply]
  simp

theorem blockMat3_inl_inr (A : Matrix (Fin 3) (Fin 3) F) (k : Fin 3)
    (a : {a : Fin n // ¬ InBlock s a}) :
    blockMat3 s hs A (blockEquiv3 s hs (Sum.inl k)) (blockEquiv3 s hs (Sum.inr a)) = 0 := by
  rw [blockMat3_apply]
  simp

theorem blockMat3_inr_inl (A : Matrix (Fin 3) (Fin 3) F) (k : Fin 3)
    (a : {a : Fin n // ¬ InBlock s a}) :
    blockMat3 s hs A (blockEquiv3 s hs (Sum.inr a)) (blockEquiv3 s hs (Sum.inl k)) = 0 := by
  rw [blockMat3_apply]
  simp

theorem blockMat3_inr_inr (A : Matrix (Fin 3) (Fin 3) F) (a b : {a : Fin n // ¬ InBlock s a}) :
    blockMat3 s hs A (blockEquiv3 s hs (Sum.inr a)) (blockEquiv3 s hs (Sum.inr b)) =
      if a = b then 1 else 0 := by
  rw [blockMat3_apply]
  simp [Matrix.one_apply]

theorem blockMat3_mul (A B : Matrix (Fin 3) (Fin 3) F) :
    blockMat3 s hs (A * B) = blockMat3 s hs A * blockMat3 s hs B := by
  rw [blockMat3, blockMat3, blockMat3, ← map_mul, Matrix.fromBlocks_multiply]
  simp

theorem blockMat3_one : blockMat3 s hs (1 : Matrix (Fin 3) (Fin 3) F) = 1 := by
  rw [blockMat3, Matrix.fromBlocks_one, map_one]

theorem det_blockMat3 (A : Matrix (Fin 3) (Fin 3) F) :
    (blockMat3 s hs A).det = A.det := by
  rw [blockMat3, Matrix.det_reindexAlgEquiv, Matrix.det_fromBlocks_zero₂₁, Matrix.det_one,
    mul_one]

def blockHom3 : Matrix.SpecialLinearGroup (Fin 3) F →* Matrix.SpecialLinearGroup (Fin n) F where
  toFun A := ⟨blockMat3 s hs (A : Matrix (Fin 3) (Fin 3) F), by
    rw [det_blockMat3]; exact A.2⟩
  map_one' := Subtype.ext (by
    change blockMat3 s hs ((1 : Matrix.SpecialLinearGroup (Fin 3) F) :
      Matrix (Fin 3) (Fin 3) F) = 1
    rw [Matrix.SpecialLinearGroup.coe_one, blockMat3_one])
  map_mul' A B := Subtype.ext (by
    change blockMat3 s hs ((A * B : Matrix.SpecialLinearGroup (Fin 3) F) :
      Matrix (Fin 3) (Fin 3) F) = blockMat3 s hs (A : Matrix (Fin 3) (Fin 3) F) *
        blockMat3 s hs (B : Matrix (Fin 3) (Fin 3) F)
    rw [Matrix.SpecialLinearGroup.coe_mul, blockMat3_mul])

theorem blockHom3_injective : Function.Injective (blockHom3 s hs (F := F)) := by
  intro A B h
  apply Subtype.ext
  have h' := congrArg Subtype.val h
  change blockMat3 s hs (A : Matrix (Fin 3) (Fin 3) F) = blockMat3 s hs
    (B : Matrix (Fin 3) (Fin 3) F) at h'
  apply Matrix.ext
  intro k l
  have := congrFun (congrFun h' (blockEquiv3 s hs (Sum.inl k))) (blockEquiv3 s hs (Sum.inl l))
  rwa [blockMat3_inl_inl, blockMat3_inl_inl] at this

def bc (k : Fin 3) : Fin n := blockEquiv3 s hs (Sum.inl k)

theorem bc_injective : Function.Injective (bc s hs (n := n)) :=
  (blockEquiv3 s hs).injective.comp Sum.inl_injective

theorem bc_ne_complement (k : Fin 3) (v : {a : Fin n // ¬ InBlock s a}) :
    bc s hs k ≠ blockEquiv3 s hs (Sum.inr v) :=
  fun h => by simpa using (blockEquiv3 s hs).injective h

theorem blockMat3_transvection (a b : Fin 3) (c : F) :
    blockMat3 s hs (Matrix.transvection a b c) =
      Matrix.transvection (bc s hs a) (bc s hs b) c := by
  ext p q
  rcases hp : (blockEquiv3 s hs).symm p with k | u <;>
    rcases hq : (blockEquiv3 s hs).symm q with l | v
  · have hp' : p = bc s hs k := by rw [bc, ← hp]; simp
    have hq' : q = bc s hs l := by rw [bc, ← hq]; simp
    subst hp' hq'
    show blockMat3 s hs _ (blockEquiv3 s hs (Sum.inl k)) (blockEquiv3 s hs (Sum.inl l)) = _
    rw [blockMat3_inl_inl]
    simp [Matrix.transvection, Matrix.add_apply, Matrix.one_apply, Matrix.single_apply,
      (bc_injective s hs).eq_iff]
  · have hp' : p = bc s hs k := by rw [bc, ← hp]; simp
    have hq' : q = blockEquiv3 s hs (Sum.inr v) := by rw [← hq]; simp
    subst hp' hq'
    show blockMat3 s hs _ (blockEquiv3 s hs (Sum.inl k)) (blockEquiv3 s hs (Sum.inr v)) = _
    rw [blockMat3_inl_inr]
    simp [Matrix.transvection, Matrix.add_apply, Matrix.one_apply, Matrix.single_apply,
      bc_ne_complement]
  · have hp' : p = blockEquiv3 s hs (Sum.inr u) := by rw [← hp]; simp
    have hq' : q = bc s hs l := by rw [bc, ← hq]; simp
    subst hp' hq'
    show blockMat3 s hs _ (blockEquiv3 s hs (Sum.inr u)) (blockEquiv3 s hs (Sum.inl l)) = _
    rw [blockMat3_inr_inl]
    simp [Matrix.transvection, Matrix.add_apply, Matrix.one_apply, Matrix.single_apply,
      bc_ne_complement, Ne.symm (bc_ne_complement s hs l u)]
  · have hp' : p = blockEquiv3 s hs (Sum.inr u) := by rw [← hp]; simp
    have hq' : q = blockEquiv3 s hs (Sum.inr v) := by rw [← hq]; simp
    subst hp' hq'
    rw [blockMat3_inr_inr]
    simp [Matrix.transvection, Matrix.add_apply, Matrix.one_apply, Matrix.single_apply,
      bc_ne_complement]

theorem transvection_02_factor (c : F) :
    (Matrix.SpecialLinearGroup.transvection (show (0 : Fin 3) ≠ 2 by decide) c) =
      Matrix.SpecialLinearGroup.transvection (show (0 : Fin 3) ≠ 1 by decide) c *
        Matrix.SpecialLinearGroup.transvection (show (1 : Fin 3) ≠ 2 by decide) 1 *
        Matrix.SpecialLinearGroup.transvection (show (0 : Fin 3) ≠ 1 by decide) (-c) *
        Matrix.SpecialLinearGroup.transvection (show (1 : Fin 3) ≠ 2 by decide) (-1) := by
  refine Matrix.SpecialLinearGroup.ext _ _ fun i j => ?_
  simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.transvection_coe]
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_three, Matrix.transvection]

theorem transvection_20_factor (c : F) :
    (Matrix.SpecialLinearGroup.transvection (show (2 : Fin 3) ≠ 0 by decide) c) =
      Matrix.SpecialLinearGroup.transvection (show (2 : Fin 3) ≠ 1 by decide) c *
        Matrix.SpecialLinearGroup.transvection (show (1 : Fin 3) ≠ 0 by decide) 1 *
        Matrix.SpecialLinearGroup.transvection (show (2 : Fin 3) ≠ 1 by decide) (-c) *
        Matrix.SpecialLinearGroup.transvection (show (1 : Fin 3) ≠ 0 by decide) (-1) := by
  refine Matrix.SpecialLinearGroup.ext _ _ fun i j => ?_
  simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.transvection_coe]
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_three, Matrix.transvection] <;> ring

theorem blockHom3_transvection (s : ℕ) (hs : s + 3 ≤ n) (a b : Fin 3) (hab : a ≠ b) (c : F) :
    blockHom3 s hs (F := F) (Matrix.SpecialLinearGroup.transvection hab c) =
      Matrix.SpecialLinearGroup.transvection ((bc_injective s hs).ne hab) c := by
  apply Subtype.ext
  change blockMat3 s hs _ = _
  rw [SpecialLinearGroup.transvection_coe, SpecialLinearGroup.transvection_coe]
  exact blockMat3_transvection s hs a b c

theorem blockHom3_le_of_adjacent (s : ℕ) (hs : s + 3 ≤ n) (H : Subgroup (SpecialLinearGroup (Fin n) F))
    (hadj : ∀ (a b : Fin 3) (hab : a ≠ b), (a.val + 1 = b.val ∨ b.val + 1 = a.val) → ∀ c : F,
      Matrix.SpecialLinearGroup.transvection ((bc_injective s hs).ne hab) c ∈ H) :
    (blockHom3 s hs (F := F)).range ≤ H := by
  have hall : ∀ (a b : Fin 3) (hab : a ≠ b) (c : F),
      blockHom3 s hs (F := F) (Matrix.SpecialLinearGroup.transvection hab c) ∈ H := by
    intro a b hab c
    have hcases : ∀ a b : Fin 3, a ≠ b → (a = 0 ∧ b = 1) ∨ (a = 1 ∧ b = 0) ∨ (a = 1 ∧ b = 2) ∨
        (a = 2 ∧ b = 1) ∨ (a = 0 ∧ b = 2) ∨ (a = 2 ∧ b = 0) := by decide
    rcases hcases a b hab with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
      ⟨rfl, rfl⟩
    · rw [blockHom3_transvection]; exact hadj 0 1 (by decide) (Or.inl (by decide)) c
    · rw [blockHom3_transvection]; exact hadj 1 0 (by decide) (Or.inr (by decide)) c
    · rw [blockHom3_transvection]; exact hadj 1 2 (by decide) (Or.inl (by decide)) c
    · rw [blockHom3_transvection]; exact hadj 2 1 (by decide) (Or.inr (by decide)) c
    · rw [transvection_02_factor, map_mul, map_mul, map_mul]
      refine H.mul_mem (H.mul_mem (H.mul_mem ?_ ?_) ?_) ?_
      · rw [blockHom3_transvection]; exact hadj 0 1 (by decide) (Or.inl (by decide)) c
      · rw [blockHom3_transvection]; exact hadj 1 2 (by decide) (Or.inl (by decide)) 1
      · rw [blockHom3_transvection]; exact hadj 0 1 (by decide) (Or.inl (by decide)) (-c)
      · rw [blockHom3_transvection]; exact hadj 1 2 (by decide) (Or.inl (by decide)) (-1)
    · rw [transvection_20_factor, map_mul, map_mul, map_mul]
      refine H.mul_mem (H.mul_mem (H.mul_mem ?_ ?_) ?_) ?_
      · rw [blockHom3_transvection]; exact hadj 2 1 (by decide) (Or.inr (by decide)) c
      · rw [blockHom3_transvection]; exact hadj 1 0 (by decide) (Or.inr (by decide)) 1
      · rw [blockHom3_transvection]; exact hadj 2 1 (by decide) (Or.inr (by decide)) (-c)
      · rw [blockHom3_transvection]; exact hadj 1 0 (by decide) (Or.inr (by decide)) (-1)
  have hgen : (⊤ : Subgroup (SpecialLinearGroup (Fin 3) F)) ≤
      H.comap (blockHom3 s hs (F := F)) := by
    rw [← CFSG.LinearGroups.special_linear_elementary_generation (n := 3) (K := F)]
    refine (Subgroup.closure_le _).mpr ?_
    rintro _ ⟨a, b, hab, c, rfl⟩
    exact hall a b hab c
  rintro _ ⟨A, rfl⟩
  exact hgen (Subgroup.mem_top A)


