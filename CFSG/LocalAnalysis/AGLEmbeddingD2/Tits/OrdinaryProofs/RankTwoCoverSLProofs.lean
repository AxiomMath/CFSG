variable {m : ℕ}

theorem bc_val' (k : Fin 3) : (bc s hs k).val = s + k.val := by
  simp [bc, blockEquiv3, blockEmb]

theorem transvection_mem_of_eq {H : Subgroup (Matrix.SpecialLinearGroup (Fin n) F)}
    {p q p' q' : Fin n} (hp : p = p') (hq : q = q') (hpq : p ≠ q) (hpq' : p' ≠ q') (c : F)
    (h : Matrix.SpecialLinearGroup.transvection hpq' c ∈ H) :
    Matrix.SpecialLinearGroup.transvection hpq c ∈ H := by
  subst hp hq
  exact h

theorem mem_range_bc (a b : Fin 3) (hab : a ≠ b) (c : F) :
    Matrix.SpecialLinearGroup.transvection ((bc_injective s hs).ne hab) c ∈
      (blockHom3 s hs (F := F)).range :=
  MonoidHom.mem_range.2 ⟨_, blockHom3_transvection s hs a b hab c⟩

theorem transvection_mem_of_root {γ : Fin m → ℤ} {p q : Fin (m + 1)} (hpq : p ≠ q)
    (hγ : toStd m γ = Pi.single p 1 - Pi.single q 1) (c : F) :
    Matrix.SpecialLinearGroup.transvection hpq c ∈ rootGroup m F γ := by
  rw [rootGroup_eq m F hpq hγ, mem_rootSubgroup]
  exact ⟨c, rfl⟩

theorem rootGroup_le_of_transvection {H : Subgroup (Matrix.SpecialLinearGroup (Fin (m + 1)) F)}
    {γ : Fin m → ℤ} {p q : Fin (m + 1)} (hpq : p ≠ q)
    (hγ : toStd m γ = Pi.single p 1 - Pi.single q 1)
    (h : ∀ c : F, Matrix.SpecialLinearGroup.transvection hpq c ∈ H) :
    rootGroup m F γ ≤ H := by
  intro g hg
  rw [rootGroup_eq m F hpq hγ, mem_rootSubgroup] at hg
  obtain ⟨c, rfl⟩ := hg
  exact h c

theorem sl_adj [Finite F] [CharP F 2] (hF : Nat.card F = 2) (i j : Fin m)
    (hij : i.val + 1 = j.val) :
    ¬ IsPSolvable 3 ↥(rankOne (rootDatum m F).rootGroup i ⊔
      rankOne (rootDatum m F).rootGroup j) := by
  intro hN
  have hi : i.val + 3 ≤ m + 1 := by
    have := j.isLt
    omega
  set H := rankOne (rootDatum m F).rootGroup i ⊔ rankOne (rootDatum m F).rootGroup j with hHdef
  have hRI1 : rootGroup m F (Pi.single i 1) ≤ H := le_trans le_sup_left le_sup_left
  have hRI2 : rootGroup m F (-Pi.single i 1) ≤ H := le_trans le_sup_right le_sup_left
  have hRJ1 : rootGroup m F (Pi.single j 1) ≤ H := le_trans le_sup_left le_sup_right
  have hRJ2 : rootGroup m F (-Pi.single j 1) ≤ H := le_trans le_sup_right le_sup_right
  have tI : ∀ c : F, Matrix.SpecialLinearGroup.transvection
      (Fin.castSucc_lt_succ (i := i)).ne c ∈ H := fun c =>
    hRI1 (transvection_mem_of_root _ (toStd_single (m := m) i) c)
  have tI' : ∀ c : F, Matrix.SpecialLinearGroup.transvection
      (Fin.castSucc_lt_succ (i := i)).ne.symm c ∈ H := fun c =>
    hRI2 (transvection_mem_of_root _ (toStd_neg_single (m := m) i) c)
  have tJ : ∀ c : F, Matrix.SpecialLinearGroup.transvection
      (Fin.castSucc_lt_succ (i := j)).ne c ∈ H := fun c =>
    hRJ1 (transvection_mem_of_root _ (toStd_single (m := m) j) c)
  have tJ' : ∀ c : F, Matrix.SpecialLinearGroup.transvection
      (Fin.castSucc_lt_succ (i := j)).ne.symm c ∈ H := fun c =>
    hRJ2 (transvection_mem_of_root _ (toStd_neg_single (m := m) j) c)
  have hb0 : bc i.val hi 0 = Fin.castSucc i := Fin.ext (by simp [bc_val'])
  have hb1 : bc i.val hi 1 = Fin.succ i := Fin.ext (by simp [bc_val'])
  have hb1' : bc i.val hi 1 = Fin.castSucc j := Fin.ext (by simp [bc_val']; omega)
  have hb2 : bc i.val hi 2 = Fin.succ j := Fin.ext (by simp [bc_val']; omega)
  have hadj : ∀ (a b : Fin 3) (hab : a ≠ b), (a.val + 1 = b.val ∨ b.val + 1 = a.val) →
      ∀ c : F, Matrix.SpecialLinearGroup.transvection ((bc_injective i.val hi).ne hab) c ∈ H := by
    intro a b hab hab' c
    have hcases : ∀ a b : Fin 3, a ≠ b → (a.val + 1 = b.val ∨ b.val + 1 = a.val) →
        (a = 0 ∧ b = 1) ∨ (a = 1 ∧ b = 0) ∨ (a = 1 ∧ b = 2) ∨ (a = 2 ∧ b = 1) := by decide
    rcases hcases a b hab hab' with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact transvection_mem_of_eq hb0 hb1 _ _ c (tI c)
    · exact transvection_mem_of_eq hb1 hb0 _ _ c (tI' c)
    · exact transvection_mem_of_eq hb1' hb2 _ _ c (tJ c)
    · exact transvection_mem_of_eq hb2 hb1' _ _ c (tJ' c)
  have hrange_le : (blockHom3 i.val hi (F := F)).range ≤ H :=
    blockHom3_le_of_adjacent i.val hi H hadj
  have hH_le_range : H ≤ (blockHom3 i.val hi (F := F)).range := by
    have r1 : rootGroup m F (Pi.single i 1) ≤ (blockHom3 i.val hi (F := F)).range :=
      rootGroup_le_of_transvection (Fin.castSucc_lt_succ (i := i)).ne (toStd_single (m := m) i) fun c =>
        transvection_mem_of_eq hb0.symm hb1.symm _ _ c (mem_range_bc i.val hi 0 1 (by decide) c)
    have r2 : rootGroup m F (-Pi.single i 1) ≤ (blockHom3 i.val hi (F := F)).range :=
      rootGroup_le_of_transvection (Fin.castSucc_lt_succ (i := i)).ne.symm (toStd_neg_single (m := m) i)
        fun c => transvection_mem_of_eq hb1.symm hb0.symm _ _ c (mem_range_bc i.val hi 1 0 (by decide) c)
    have r3 : rootGroup m F (Pi.single j 1) ≤ (blockHom3 i.val hi (F := F)).range :=
      rootGroup_le_of_transvection (Fin.castSucc_lt_succ (i := j)).ne (toStd_single (m := m) j) fun c =>
        transvection_mem_of_eq hb1'.symm hb2.symm _ _ c (mem_range_bc i.val hi 1 2 (by decide) c)
    have r4 : rootGroup m F (-Pi.single j 1) ≤ (blockHom3 i.val hi (F := F)).range :=
      rootGroup_le_of_transvection (Fin.castSucc_lt_succ (i := j)).ne.symm (toStd_neg_single (m := m) j)
        fun c => transvection_mem_of_eq hb2.symm hb1'.symm _ _ c (mem_range_bc i.val hi 2 1 (by decide) c)
    exact sup_le (sup_le r1 r2) (sup_le r3 r4)
  have hRange : (blockHom3 i.val hi (F := F)).range = H :=
    le_antisymm hrange_le hH_le_range
  have hbij : Function.Bijective (ZMod.castHom (dvd_refl 2) F) :=
    Function.Injective.bijective_of_nat_card_le (RingHom.injective _)
      (le_of_eq (by rw [hF, Nat.card_eq_fintype_card, ZMod.card]))
  let e : ZMod 2 ≃+* F := RingEquiv.ofBijective _ hbij
  obtain ⟨ψc, hψc⟩ : ∃ ψc : Matrix.SpecialLinearGroup (Fin 3) F →* H,
      ∀ A, ((ψc A : H) : Matrix.SpecialLinearGroup (Fin (m + 1)) F) =
        blockHom3 i.val hi (F := F) A :=
    ⟨{ toFun := fun A => ⟨blockHom3 i.val hi (F := F) A,
          hrange_le (MonoidHom.mem_range.2 ⟨A, rfl⟩)⟩
       map_one' := Subtype.ext (map_one _)
       map_mul' := fun A B => Subtype.ext (map_mul _ A B) },
      fun A => rfl⟩
  have hψbij : Function.Bijective ψc := by
    refine ⟨fun A B hAB => blockHom3_injective i.val hi (by
      have := congrArg Subtype.val hAB
      rwa [hψc, hψc] at this), fun h => ?_⟩
    have hmem : (h : Matrix.SpecialLinearGroup (Fin (m + 1)) F) ∈
        (blockHom3 i.val hi (F := F)).range := by rw [hRange]; exact h.2
    obtain ⟨A, hA⟩ := MonoidHom.mem_range.1 hmem
    exact ⟨A, Subtype.ext (by rw [hψc, hA])⟩
  let Φ : Matrix.SpecialLinearGroup (Fin 3) F →* GL (Fin 3) (ZMod 2) :=
    (Matrix.SpecialLinearGroup.toGL).comp (Matrix.SpecialLinearGroup.map (e.symm : F →+* ZMod 2))
  have hΦsurj : Function.Surjective Φ := by
    intro g
    obtain ⟨x, hx⟩ := bijective_toGL_three_zmod_two.2 g
    refine ⟨Matrix.SpecialLinearGroup.map (e : ZMod 2 →+* F) x, ?_⟩
    simp only [Φ, MonoidHom.comp_apply]
    have hmap : Matrix.SpecialLinearGroup.map (e.symm : F →+* ZMod 2)
        (Matrix.SpecialLinearGroup.map (e : ZMod 2 →+* F) x) = x := by
      refine Matrix.SpecialLinearGroup.ext _ _ fun i j => ?_
      simp [Matrix.SpecialLinearGroup.map_apply_coe]
    rw [hmap, hx]
  let ψe : Matrix.SpecialLinearGroup (Fin 3) F ≃* H := MulEquiv.ofBijective ψc hψbij
  let φ : (⊤ : Subgroup H) →* GL (Fin 3) (ZMod 2) :=
    Φ.comp ((ψe.symm.toMonoidHom).comp (Subgroup.topEquiv : (⊤ : Subgroup H) ≃* H).toMonoidHom)
  have hφsurj : Function.Surjective φ := by
    intro g
    obtain ⟨x, hx⟩ := hΦsurj g
    exact ⟨Subgroup.topEquiv.symm (ψe x), by simp [φ, hx]⟩
  have hnc : ¬ IsMulCommutative (GL (Fin 3) (ZMod 2)) := fun hc => by
    have hp := Group.is_simple_iff_prime_card.mp isSimpleGroup_GL_three_two
    rw [card_GL_three_zmod_two] at hp
    norm_num at hp
  have h3 : 3 ∣ Nat.card (GL (Fin 3) (ZMod 2)) := by
    rw [card_GL_three_zmod_two]
    norm_num
  exact false_of_isPSolvable_surj hN ⊤ φ hφsurj isSimpleGroup_GL_three_two hnc h3

end SLAdj

