@[expose] def fix3OK (X vs : Array ℕ) : Bool :=
  let a := vs[0]!
  let b := vs[1]!
  let c := vs[2]!
  decide (a < 2 ^ 112) && decide (b < 2 ^ 112) && decide (c < 2 ^ 112) &&
    decide (vecMulRows X a 112 = a) && decide (vecMulRows X b 112 = b) &&
    decide (vecMulRows X c 112 = c) &&
    (List.range 8).all fun i => (List.range 8).all fun j =>
      i == j || comb3 a b c i != comb3 a b c j

@[noinline, expose] def q3FixOK (kp : Array Pair) : Bool :=
  (List.range 26).all fun k => fix3OK (q3PairK kp (k + 1)).1 q3FixVecs[k]!

end CFSG.Sporadic.J4Schreier
