@[expose] def decodeInstr (n : ℕ) : Instr :=
  let i := n / 4 % 1024
  let j := n / 4096 % 1024
  let k := n / 4194304 % 1024
  let e := n / 4294967296
  if n % 4 = 0 then .mu i j k else if n % 4 = 1 then .iv i k else .pwr e i k

