@[expose] def eltsOK (_ : Unit := ()) : Bool :=
  okA x7A && okA x5aA && okA x5cA && okA y2A && okA e1A && okA e2A &&
    gC5a.all okA && gC5c.all okA && gCE.all okA && gD.all okA && lineA.all okA &&
    transA.all okA && dUA.all okA && dVA.all okA &&
    eqA 315 (powArr 315 x7A 7) (idA 315) && !(eqA 315 x7A (idA 315)) &&
    eqA 315 (powArr 315 x5aA 5) (idA 315) && !(eqA 315 x5aA (idA 315)) &&
    eqA 315 (powArr 315 x5cA 5) (idA 315) && !(eqA 315 x5cA (idA 315)) &&
    eqA 315 (powArr 315 e1A 2) (idA 315) && eqA 315 (powArr 315 e2A 2) (idA 315) &&
    !(eqA 315 e1A (idA 315)) && !(eqA 315 e2A (idA 315)) && !(eqA 315 e1A e2A) &&
    commA e1A e2A && commA e1A x5aA && commA e2A x5aA

@[expose] def enumsOK (ca cc c7' cE' cD' cS : ArrCert) : Bool :=
  enumOK 315 gC5a keyPts ca && ca.pts.size == 300 &&
    enumOK 315 gC5c keyPts cc && cc.pts.size == 50 &&
    enumOK 315 gC7 keyPts c7' && c7'.pts.size == 7 &&
    enumOK 315 gCE keyPts cE' && cE'.pts.size == 240 &&
    enumOK 315 gD keyPts cD' && cD'.pts.size == 60 &&
    enumOK 315 gS5 keyPts cS && cS.pts.size == 25 &&
    gC5a.all (fun t => commA t x5aA) && gC5c.all (fun t => commA t x5cA) &&
    gCE.all (fun t => commA t e1A && commA t e2A)

@[expose] def brutePr (ca cc c7' cE' : ArrCert) (t : Array ℕ) : Bool :=
  (!(commA t x5aA) || inCert ca t) && (!(commA t x5cA) || inCert cc t) &&
    (!(commA t x7A) || inCert c7' t) && (!(commA t e1A && commA t e2A) || inCert cE' t)

@[expose] def bruteOK (ca cc c7' cE' : ArrCert) : Bool :=
  allLt 315 fun a => allLt 160 fun b => allLt 12 fun c =>
    brutePr ca cc c7' cE' (prod3 315 autLevels a b c)

@[expose] def linesOK (cS : ArrCert) : Bool :=
  allLt cS.pts.size (fun k => eqA 315 cS.pts[k]! (idA 315) ||
      (List.range 6).any fun j => (List.range 5).any fun e =>
        eqA 315 cS.pts[k]! (powArr 315 lineA[j]! e)) &&
    (lineA.size == 6) && (transA.size == 6) && (recL.length == 6) &&
    allLt 6 (fun j => eqA 315 (powArr 315 lineA[j]! 5) (idA 315) && decide (recL.getD j 0 < 2) &&
      eqA 315 (conjA 315 transA[j]! caseA[recL.getD j 0]!) lineA[j]!)

@[expose] def dOK (cE' cD' : ArrCert) : Bool :=
  gD.all (inCert cE') && (dUA.size == gD.size) && (dVA.size == gD.size) &&
    allLt gD.size (fun i => inCert cD' dUA[i]! && inCert cD' dVA[i]! &&
      eqA 315 gD[i]! (commutatorA 315 dUA[i]! dVA[i]!)) &&
    !(inCert cD' e1A) && !(inCert cD' e2A) && !(inCert cD' (compA 315 e1A e2A))

