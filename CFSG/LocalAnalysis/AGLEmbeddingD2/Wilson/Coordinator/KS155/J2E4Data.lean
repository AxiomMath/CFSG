@[expose] def c5a (_ : Unit := ()) : ArrCert := enumBfs 315 gC5a keyPts 1000

@[expose] def c5c (_ : Unit := ()) : ArrCert := enumBfs 315 gC5c keyPts 200

@[expose] def c7 (_ : Unit := ()) : ArrCert := enumBfs 315 gC7 keyPts 50

