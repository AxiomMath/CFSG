@[expose] def letterPL (gs : Array Pair) (l : ℤ) : Pair :=
  if 0 < l then gs.getD (l.toNat - 1) oneP else invP (gs.getD ((-l).toNat - 1) oneP)

@[expose] def wordPL (gs : Array Pair) : List ℤ → Pair
  | [] => oneP
  | l :: w => mulP (letterPL gs l) (wordPL gs w)

@[expose] def xJn (k : ℕ) : Pair :=
  wordPL #[An, Bn] (CFSG.Sporadic.J4.Native.localWords.getD k [])

@[expose] def xJns : Array Pair := #[xJn 0, xJn 1, xJn 2]

@[expose] def gen5n : Array Pair := #[xJn 0, xJn 1, xJn 2, An, Bn]

@[expose] def gEn (n : ℕ) : Pair := wordPL gen5n (CFSG.Quasithin.J4M2.genWord n)

@[expose] def uJn (j : ℕ) : Pair := wordPL xJns (CFSG.Sporadic.J4.QT.uWord j)

@[expose] def etaN (n c : ℕ) : Pair :=
  (List.range n).foldl (fun acc j => if c.testBit j then mulP acc (uJn j) else acc) oneP

@[expose] def z0n : Pair := etaN 11 1131

@[expose] def hWordN : List ℤ :=
  [1, 2, -2, -2, -1, 2, -2, -1, -2, -1, -2, 2, 2, 1, 2, 2, 2, 2, 1, -2]

@[expose] def hWn : Pair := wordPL #[An, Bn] hWordN

@[expose] def jn : Pair := powP H2n 20

@[expose] def gamN : Pair := mulP (powP (mulP z0n (mulP (mulP hWn jn) (invP hWn))) 6) hWn

@[expose] def xN : List Pair :=
  [gEn 0, gEn 1, mulP (gEn 0) (gEn 2), mulP (gEn 1) (gEn 2), mulP (mulP (gEn 0) (gEn 1)) (gEn 2),
    mulP (gEn 1) (gEn 3), mulP (gEn 2) (gEn 3),
    mulP (mulP (mulP (mulP (mulP (gEn 15) (gEn 29)) (gEn 1)) (gEn 7)) (gEn 9)) (gEn 11)]

@[expose] def g2N (X : Pair) : Pair := mulP H1n (mulP (mulP (invP gamN) X) gamN)

