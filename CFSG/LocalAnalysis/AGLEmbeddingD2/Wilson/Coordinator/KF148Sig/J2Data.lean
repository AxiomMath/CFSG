@[expose] def pairA : List (ℕ × ℕ) := [(9, 14), (9, 17), (12, 16)]

@[expose] def genSets : List (List ℕ) := [[2, 3], [1, 5], [0, 4], [0, 1, 2]]

@[expose] def wordA : List (List ℕ) :=
  [[10, 6, 9, 6, 9, 8, 11, 6, 10, 7, 9, 6, 11],
    [3, 16, 5, 15, 3, 15, 4, 16, 4, 15, 5, 15],
    [13, 1, 12, 0, 14, 1, 13, 2, 12, 1, 12, 1, 14],
