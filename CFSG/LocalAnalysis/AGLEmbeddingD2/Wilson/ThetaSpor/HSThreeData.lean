@[expose] def hsCentOK (_ : Unit := ()) : Bool :=
  validA 100 hsX && siftA 100 hs100PLevels hs100BaseArr 0 hsX &&
    eqA 100 (powArr 100 hsX 3) (idA 100) && !(eqA 100 hsX (idA 100)) &&
    centOK 100 hs100StrongArrs hs100BaseArr hsX hsRels hsGs hsKeys (hsCCert ()) 360

@[expose] def hsSylowOK (_ : Unit := ()) : Bool :=
  enumOK 100 #[hsX, hsC3] hsKeys (hsPCert ()) && (hsPCert ()).pts.size == 9 &&
    siftA 100 hs100PLevels hs100BaseArr 0 hsC3 &&
    allLt (hsPCert ()).pts.size fun k => eqA 100 (hsPCert ()).pts[k]! (idA 100) ||
      hsConjs.any fun g => validA 100 g && siftA 100 hs100PLevels hs100BaseArr 0 g &&
        eqA 100 (conjA 100 g (hsPCert ()).pts[k]!) hsX

@[expose] def hsEl (k : ℕ) : Array ℕ := (hsCCert ()).pts[k]!

@[expose] def hsBlockOK (_ : Unit := ()) : Bool :=
  allLt 100 (fun i => (hsX[i]! == i) == hsF.contains i) &&
    allLt 100 (fun i => if hsF.contains i then decide (hsBlk[i]! < 5) else hsBlk[i]! == 5) &&
    allLt 5 (fun b => hsF.contains hsRep[b]! && hsBlk[hsRep[b]!]! == b) &&
    allLt (hsCCert ()).pts.size (fun k =>
      allLt 100 (fun p => !(hsF.contains p) ||
        (hsF.contains (hsEl k)[p]! &&
          hsBlk[(hsEl k)[p]!]! == hsBlk[(hsEl k)[hsRep[hsBlk[p]!]!]!]!)) &&
      (!(allLt 100 (fun p => !(hsF.contains p) || hsBlk[(hsEl k)[p]!]! == hsBlk[p]!)) ||
        eqA 100 (powArr 100 (hsEl k) 3) (idA 100))) &&
    allLt 5 (fun b => hsBlk[(hsGs[0]!)[hsRep[b]!]!]! == hsR0[b]!) &&
    allLt 5 (fun b => hsBlk[(hsGs[1]!)[hsRep[b]!]!]! == hsR1[b]!) &&
    enumOK 5 #[hsR0, hsR1] [0, 1, 2, 3, 4] (hsFiveCert ()) && (hsFiveCert ()).pts.size == 120

@[expose] def hsThreeOK (_ : Unit := ()) : Bool := hsCentOK () && hsSylowOK () && hsBlockOK ()

