@[expose] def idA : Array Nat := Array.range 77

@[expose] def comp (a b : Array Nat) : Array Nat := b.map fun k => a.getD k 0

@[expose] def evalW (e : Array (Array Nat)) (w : List Nat) : Array Nat :=
  w.foldl (fun acc k => comp acc (e.getD k idA)) idA

@[expose] def parseNats (s : String) : Array Nat :=
  (((s.replace "\n" " ").splitOn " ").filter fun t => t ≠ "").toArray.map String.toNat!

@[expose] def parseWords (s : String) : Array (List Nat) :=
  (((s.splitOn "\n").filter fun l => l.startsWith ":").map fun l =>
    (((l.replace ":" "").splitOn " ").filter fun t => t ≠ "").map String.toNat!).toArray

