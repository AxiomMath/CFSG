theorem isLThreeFour_of_l34Index {d : ValidLieTypeIndex} (hd : IsL34Index d) :
    IsLThreeFour (CFSGIndex.lie d).Group := by
  obtain ⟨F, hF, hcard, ⟨ψ⟩⟩ :=
    CFSG.AGLEmbeddingD2.Tits.S3AmalgamBound.exists_equiv_projectiveSL_of_l34Index hd
      (MulEquiv.refl (CFSGIndex.lie d).Group)
  haveI : Finite F := Nat.finite_of_card_ne_zero (by rw [hcard]; norm_num)
  exact ⟨F, hF, inferInstance, hcard,
    ⟨ψ.trans (CFSG.CGT.Timmesfeld75.projectiveSLMulEquivStatedProj 3 F)⟩⟩

theorem closure_fix_eq_top_of_c25GammaCl {Y : Type} [Group Y] [Finite Y]
    {E : Subgroup (MulAut Y)} (h9 : Nat.card E = 9) (h : ⊤ ≤ c25GammaCl E) :
    Subgroup.closure {k : Y | ∃ e ∈ E, e ≠ 1 ∧ e k = k} = ⊤ := by
  refine eq_top_iff.2 (h.trans ?_)
  refine iSup₂_le fun S hS => ?_
  have hSne : ∃ a ∈ S, a ≠ 1 := by
    by_contra hcon
    push Not at hcon
    have hbot : S = ⊥ := (Subgroup.eq_bot_iff_forall S).2 hcon
    have h1 := hS.2
    rw [hbot, Subgroup.card_bot, h9] at h1
    omega
  obtain ⟨a, haS, ha1⟩ := hSne
  have hfix : c25Fix S ≤ Subgroup.closure {k : Y | ∃ e ∈ E, e ≠ 1 ∧ e k = k} := fun y hy =>
    Subgroup.subset_closure ⟨a, hS.1 haS, ha1, mem_c25Fix.1 hy a haS⟩
  refine sup_le (le_trans ?_ hfix) (le_trans ?_ hfix)
  · rintro _ ⟨y, -, rfl⟩
    exact y.2
  · exact sSup_le fun _ hL => hL.1

theorem lFourFacts_holds : LFourFacts := by
  intro d hd hfin
  have hL : IsLThreeFour (CFSGIndex.lie d).Group := isLThreeFour_of_l34Index hd
  refine ⟨?_, pRank_mulAut_le_two_of_isLThreeFour hL, fun E hE hc hinn => ?_⟩
  · rw [CFSG.HardMathSupport.Solomon.Coordinator.card_of_isLThreeFour hL]
    norm_num
  · exact closure_fix_eq_top_of_c25GammaCl hc
      (CFSG.HardMathSupport.Solomon.UniquenessMaximal.Sec6KI2320.l34_holds _ hL E hE hc hinn)

