open CFSG.RankThree.PerfectCover CFSG.Blueprint.Multiplier CFSG.Models CFSG.Assembly.LowTwoRank

theorem ksm_card_eq {Q : TauCeti.PrimePower} {m : ℕ} (h : Q.card = m) : Q.p ^ Q.exponent = m := by
  rw [← TauCeti.PrimePower.card_def]
  exact h

theorem ksm_card_center_dvd (hG : CFSG.Open.GriessAllModelsStatement) {K : Type} [Group K]
    [Finite K] (hq : CFSG.Open.IsQuasisimple K) {t : StatedLieTag} {n p f : ℕ}
    (hm : LieModel (K ⧸ Subgroup.center K) t n p f) :
    Nat.card (Subgroup.center K) ∣ (genericOrders t n p f).1 * (genericOrders t n p f).2 *
      ((exceptionalOrders t n p f).1 * (exceptionalOrders t n p f).2) := by
  have hq' : CFSG.IsQuasisimple K :=
    ((CFSG.Foundations.SteinbergCA.quasisimple_iff K).2.2.1).2 hq
  haveI : Group.IsPerfect K := hq'.1
  let e : K ⧸ Subgroup.center K ≃* K ⧸ Subgroup.center K := MulEquiv.refl _
  have hqs := centralQuotientMap_surjective e
  have hk := centralQuotientMap_ker e
  have hperf : Group.IsPerfect (K ⧸ Subgroup.center K) := isPerfect_of_quasisimple_quotient hq' e
  have h1 : Nat.card (Subgroup.center K) ∣ Nat.card (hopfMultiplier (K ⧸ Subgroup.center K)) := by
    have h1 := Subgroup.card_dvd_of_surjective
      (hopfMultiplierToKer_surjective (centralQuotientMap e) hqs hk.le)
    have h2 : Nat.card (centralQuotientMap e).ker = Nat.card (Subgroup.center K) := by rw [hk]
    rw [h2] at h1
    exact h1
  obtain ⟨-, ⟨eM⟩⟩ := hG _ t n p f hm
  have h2 : Nat.card (hopfMultiplier (K ⧸ Subgroup.center K)) =
      (genericOrders t n p f).1 * (genericOrders t n p f).2 *
        ((exceptionalOrders t n p f).1 * (exceptionalOrders t n p f).2) := by
    rw [← Nat.card_congr (hopfMultiplierEquivGriess _).toEquiv, Nat.card_congr eM.toEquiv,
      Nat.card_prod]
    unfold generic exceptional
    simp only [Nat.card_prod, Nat.card_zmod, Nat.card_congr (Multiplicative.toAdd : _ ≃ _)]
  rwa [h2] at h1

theorem ksm_odd_dvd {z m k : ℕ} (hz : Odd z) (h : z ∣ m * 2 ^ k) : z ∣ m :=
  (Nat.Coprime.pow_right k (Nat.coprime_two_right.2 hz)).dvd_of_dvd_mul_right h

theorem KSMU4_of_griess (hG : CFSG.Open.GriessAllModelsStatement) : KSMU4 := by
  intro K _ _ hq d ⟨Q, hQ, hd⟩ ⟨e⟩ hodd
  obtain ⟨d1, hv⟩ := d
  simp only at hd
  subst hd
  have hm := CFSG.QuasithinUnique.SQTK.statedClassicalModel_twistedA 3 Q hv e
  rw [hQ] at hm
  have hLM : LieModel (K ⧸ Subgroup.center K) .PSU (3 + 1) 2 Q.exponent := ⟨hm.1, Or.inl hm⟩
  have hdvd := ksm_card_center_dvd hG hq hLM
  have hgen : genericOrders .PSU (3 + 1) 2 Q.exponent = (Nat.gcd 4 (2 ^ Q.exponent + 1), 1) := rfl
  have hexc : ∃ k, (exceptionalOrders .PSU (3 + 1) 2 Q.exponent).1 *
      (exceptionalOrders .PSU (3 + 1) 2 Q.exponent).2 = 2 ^ k := by
    unfold exceptionalOrders
    split <;> first | exact ⟨1, rfl⟩ | exact ⟨0, rfl⟩ | simp_all
  obtain ⟨k, hk⟩ := hexc
  rw [hgen, hk] at hdvd
  have hcop : Nat.gcd 4 (2 ^ Q.exponent + 1) = 1 := by
    have h2 : Nat.Coprime 2 (2 ^ Q.exponent + 1) :=
      Nat.coprime_two_left.2 ((Nat.even_pow.2 ⟨even_two, Q.exponent_pos.ne'⟩).add_one)
    simpa using Nat.Coprime.pow_left 2 h2
  rw [hcop] at hdvd
  have := ksm_odd_dvd (m := 1) (k := k) hodd (by simpa using hdvd)
  exact Nat.dvd_one.1 this

theorem ksm_gcd_three_two_pow_odd {f : ℕ} (hf : Odd f) : Nat.gcd 3 (2 ^ f - 1) = 1 := by
  obtain ⟨k, rfl⟩ := hf
  have h1 : 2 ^ (2 * k + 1) % 3 = 2 := by
    rw [pow_succ, pow_mul, Nat.mul_mod, Nat.pow_mod]
    norm_num
  have h2 : 0 < 2 ^ (2 * k + 1) := by positivity
  apply (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).2
  generalize 2 ^ (2 * k + 1) = x at h1 h2 ⊢
  omega

theorem KSML3_of_griess (hG : CFSG.Open.GriessAllModelsStatement) : KSML3 := by
  intro K _ _ hq d ⟨e⟩ hodd
  refine ⟨?_, ?_⟩
  · rintro (⟨Q, hQ, hQodd, hd⟩ | ⟨q, hq7, hd⟩)
    · obtain ⟨d1, hv⟩ := d
      simp only at hd
      subst hd
      have hm := CFSG.RankThree.PartOne.N143.statedClassicalModel_of_isoLie_A hv e
      rw [hQ] at hm
      have hLM : LieModel (K ⧸ Subgroup.center K) .PSL (2 + 1) 2 Q.exponent := ⟨hm.1, Or.inl hm⟩
      have hdvd := ksm_card_center_dvd hG hq hLM
      have hgen : genericOrders .PSL (2 + 1) 2 Q.exponent =
          (Nat.gcd 3 (2 ^ Q.exponent - 1), 1) := rfl
      have hexc : ∃ k, (exceptionalOrders .PSL (2 + 1) 2 Q.exponent).1 *
          (exceptionalOrders .PSL (2 + 1) 2 Q.exponent).2 = 2 ^ k := by
        unfold exceptionalOrders
        split <;> first | exact ⟨1, rfl⟩ | exact ⟨0, rfl⟩ | exact ⟨4, rfl⟩ | simp_all
      obtain ⟨k, hk⟩ := hexc
      rw [hgen, hk, ksm_gcd_three_two_pow_odd hQodd] at hdvd
      have := ksm_odd_dvd (m := 1) (k := k) hodd (by simpa using hdvd)
      exact Nat.dvd_one.1 this
    · obtain ⟨d1, hv⟩ := d
      simp only at hd
      subst hd
      have hm := CFSG.RankThree.PartOne.N143.statedClassicalModel_of_isoLie_A hv e
      obtain ⟨hp7, he1⟩ := (Nat.Prime.pow_eq_iff (by norm_num : Nat.Prime 7)).mp (ksm_card_eq hq7)
      rw [hp7, he1] at hm
      have hLM : LieModel (K ⧸ Subgroup.center K) .PSL (1 + 1) 7 1 := ⟨hm.1, Or.inl hm⟩
      have hdvd := ksm_card_center_dvd hG hq hLM
      have hgen : genericOrders .PSL (1 + 1) 7 1 = (2, 1) := by
        show (Nat.gcd (1 + 1) (7 ^ 1 - 1), 1) = (2, 1)
        norm_num
      have hexc : exceptionalOrders .PSL (1 + 1) 7 1 = (1, 1) := by
        unfold exceptionalOrders
        split <;> first | rfl | simp_all
      rw [hgen, hexc] at hdvd
      have h2 : Nat.card (Subgroup.center K) ∣ 2 := by simpa using hdvd
      have h3 := Nat.le_of_dvd (by norm_num) h2
      obtain ⟨j, hj⟩ := hodd
      have h4 : Nat.card (Subgroup.center K) ≠ 0 := Nat.card_pos.ne'
      omega
  · rintro ⟨Q, hQ, hQeven, hd⟩
    obtain ⟨d1, hv⟩ := d
    simp only at hd
    subst hd
    have hm := CFSG.RankThree.PartOne.N143.statedClassicalModel_of_isoLie_A hv e
    rw [hQ] at hm
    have hLM : LieModel (K ⧸ Subgroup.center K) .PSL (2 + 1) 2 Q.exponent := ⟨hm.1, Or.inl hm⟩
    have hdvd := ksm_card_center_dvd hG hq hLM
    have hgen : genericOrders .PSL (2 + 1) 2 Q.exponent =
        (Nat.gcd 3 (2 ^ Q.exponent - 1), 1) := rfl
    have hexc : ∃ k, (exceptionalOrders .PSL (2 + 1) 2 Q.exponent).1 *
        (exceptionalOrders .PSL (2 + 1) 2 Q.exponent).2 = 2 ^ k := by
      unfold exceptionalOrders
      split <;> first | exact ⟨1, rfl⟩ | exact ⟨0, rfl⟩ | exact ⟨4, rfl⟩ | simp_all
    obtain ⟨k, hk⟩ := hexc
    rw [hgen, hk] at hdvd
    have := ksm_odd_dvd (m := (Nat.gcd 3 (2 ^ Q.exponent - 1), 1).1 * (Nat.gcd 3 (2 ^ Q.exponent - 1), 1).2) (k := k) hodd hdvd
    exact this.trans (by simpa using Nat.gcd_dvd_left 3 (2 ^ Q.exponent - 1))

theorem ksm_exc_two (t : StatedLieTag) (n f : ℕ) :
    ∃ k, (exceptionalOrders t n 2 f).1 * (exceptionalOrders t n 2 f).2 = 2 ^ k := by
  unfold exceptionalOrders
  split <;> first | exact ⟨0, rfl⟩ | exact ⟨1, rfl⟩ | exact ⟨2, rfl⟩ | exact ⟨4, rfl⟩ | simp_all

theorem ksm_odd_two_pow_sub_one {f : ℕ} (hf : 1 ≤ f) : Odd (2 ^ f - 1) := by
  have h1 : 2 ≤ 2 ^ f := by
    calc 2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ f := Nat.pow_le_pow_right (by norm_num) hf
  exact Nat.Even.sub_odd (by omega) (Nat.even_pow.2 ⟨even_two, by omega⟩) odd_one

theorem ksm_gcd_four_odd {m : ℕ} (hm : Odd m) : Nat.gcd 4 m = 1 := by
  have h : Nat.Coprime 2 m := Nat.coprime_two_left.2 hm
  simpa using Nat.Coprime.pow_left 2 h

theorem ksm_gcd_two_odd {m : ℕ} (hm : Odd m) : Nat.gcd 2 m = 1 :=
  Nat.coprime_two_left.2 hm

theorem ksm_dvd_of_values (hG : CFSG.Open.GriessAllModelsStatement) {K : Type} [Group K] [Finite K]
    (hq : CFSG.Open.IsQuasisimple K) {t : StatedLieTag} {n p f : ℕ}
    (hm : LieModel (K ⧸ Subgroup.center K) t n p f) {a k : ℕ}
    (hg : (genericOrders t n p f).1 * (genericOrders t n p f).2 = a)
    (he : (exceptionalOrders t n p f).1 * (exceptionalOrders t n p f).2 = 2 ^ k)
    (hodd : Odd (Nat.card (Subgroup.center K))) : Nat.card (Subgroup.center K) ∣ a := by
  have h := ksm_card_center_dvd hG hq hm
  rw [hg, he] at h
  exact ksm_odd_dvd hodd h

theorem ksm_odd_cases (hG : CFSG.Open.GriessAllModelsStatement) {K : Type} [Group K] [Finite K]
    (hq : CFSG.Open.IsQuasisimple K) (d : TauCeti.ValidLieTypeIndex) (h : In1512 d.1)
    (hA2 : ∀ Q, d.1 ≠ .A 2 Q) (hTA3 : ∀ Q, d.1 ≠ .twistedA 3 Q)
    (e : (K ⧸ Subgroup.center K) ≃* (TauCeti.CFSGIndex.lie d).Group)
    (hodd : Odd (Nat.card (Subgroup.center K))) :
    (Nat.card (Subgroup.center K) ∣ 5) ∧
      ((∀ Q, d.1 ≠ .twistedA 4 Q) → Nat.card (Subgroup.center K) = 1) := by
  obtain ⟨d1, hv⟩ := d
  simp only at h hA2 hTA3
  cases d1 with
  | A r Q =>
    rcases (by omega : r = 0 ∨ r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4 ∨ r = 5 ∨ r = 6 ∨ 7 ≤ r) with
      rfl | rfl | rfl | rfl | rfl | rfl | rfl | hr
    · exact absurd h (by simp [In1512])
    · exact absurd h (by simp [In1512])
    · exact absurd rfl (hA2 Q)
    · have hQ : Q.p = 2 := h
      have hm := CFSG.RankThree.PartOne.N143.statedClassicalModel_of_isoLie_A hv e
      rw [hQ] at hm
      have hLM : LieModel (K ⧸ Subgroup.center K) .PSL (3 + 1) 2 Q.exponent := ⟨hm.1, Or.inl hm⟩
      obtain ⟨k, hk⟩ := ksm_exc_two .PSL (3 + 1) Q.exponent
      have hz := ksm_dvd_of_values hG hq hLM (a := 1)
        (by
          show Nat.gcd (3 + 1) (2 ^ Q.exponent - 1) * 1 = 1
          rw [mul_one]
          exact ksm_gcd_four_odd (ksm_odd_two_pow_sub_one Q.exponent_pos)) hk hodd
      exact ⟨hz.trans (by norm_num), fun _ => Nat.dvd_one.1 hz⟩
    · have hQc : Q.card = 2 := h
      obtain ⟨hp2, he1⟩ := (Nat.Prime.pow_eq_iff Nat.prime_two).mp (ksm_card_eq hQc)
      have hm := CFSG.RankThree.PartOne.N143.statedClassicalModel_of_isoLie_A hv e
      rw [hp2, he1] at hm
      have hLM : LieModel (K ⧸ Subgroup.center K) .PSL (4 + 1) 2 1 := ⟨hm.1, Or.inl hm⟩
      obtain ⟨k, hk⟩ := ksm_exc_two .PSL (4 + 1) 1
      have hz := ksm_dvd_of_values hG hq hLM (a := 1)
        (by
          show Nat.gcd (4 + 1) (2 ^ 1 - 1) * 1 = 1
          norm_num) hk hodd
      exact ⟨hz.trans (by norm_num), fun _ => Nat.dvd_one.1 hz⟩
    · have hQc : Q.card = 2 := h
      obtain ⟨hp2, he1⟩ := (Nat.Prime.pow_eq_iff Nat.prime_two).mp (ksm_card_eq hQc)
      have hm := CFSG.RankThree.PartOne.N143.statedClassicalModel_of_isoLie_A hv e
      rw [hp2, he1] at hm
      have hLM : LieModel (K ⧸ Subgroup.center K) .PSL (5 + 1) 2 1 := ⟨hm.1, Or.inl hm⟩
      obtain ⟨k, hk⟩ := ksm_exc_two .PSL (5 + 1) 1
      have hz := ksm_dvd_of_values hG hq hLM (a := 1)
        (by
          show Nat.gcd (5 + 1) (2 ^ 1 - 1) * 1 = 1
          norm_num) hk hodd
      exact ⟨hz.trans (by norm_num), fun _ => Nat.dvd_one.1 hz⟩
    · have hQc : Q.card = 2 := h
      obtain ⟨hp2, he1⟩ := (Nat.Prime.pow_eq_iff Nat.prime_two).mp (ksm_card_eq hQc)
      have hm := CFSG.RankThree.PartOne.N143.statedClassicalModel_of_isoLie_A hv e
      rw [hp2, he1] at hm
      have hLM : LieModel (K ⧸ Subgroup.center K) .PSL (6 + 1) 2 1 := ⟨hm.1, Or.inl hm⟩
      obtain ⟨k, hk⟩ := ksm_exc_two .PSL (6 + 1) 1
      have hz := ksm_dvd_of_values hG hq hLM (a := 1)
        (by
          show Nat.gcd (6 + 1) (2 ^ 1 - 1) * 1 = 1
          norm_num) hk hodd
      exact ⟨hz.trans (by norm_num), fun _ => Nat.dvd_one.1 hz⟩
    · obtain ⟨r', rfl⟩ : ∃ r', r = r' + 7 := ⟨r - 7, by omega⟩
      exact absurd h (by simp [In1512])
  | twistedA r Q =>
    rcases (by omega : r = 0 ∨ r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4 ∨ 5 ≤ r) with
      rfl | rfl | rfl | rfl | rfl | hr
    · exact absurd h (by simp [In1512])
    · exact absurd h (by simp [In1512])
    · exact absurd h (by simp [In1512])
    · exact absurd rfl (hTA3 Q)
    · have hQc : Q.p ^ Q.exponent = 4 := ksm_card_eq h
      have hp : Q.p = 2 := by
        have hdvd : Q.p ∣ 2 ^ 2 := by
          have h1 : Q.p ∣ Q.p ^ Q.exponent := dvd_pow_self _ Q.exponent_pos.ne'
          rw [hQc] at h1
          simpa using h1
        exact (Nat.prime_dvd_prime_iff_eq Q.prime_p Nat.prime_two).1
          (Q.prime_p.dvd_of_dvd_pow hdvd)
      have he : Q.exponent = 2 := by
        rw [hp] at hQc
        exact Nat.pow_right_injective (le_refl 2) (by simpa using hQc : 2 ^ Q.exponent = 2 ^ 2)
      have hm := CFSG.QuasithinUnique.SQTK.statedClassicalModel_twistedA 4 Q hv e
      rw [hp, he] at hm
      have hLM : LieModel (K ⧸ Subgroup.center K) .PSU (4 + 1) 2 2 := ⟨hm.1, Or.inl hm⟩
      obtain ⟨k, hk⟩ := ksm_exc_two .PSU (4 + 1) 2
      have hz := ksm_dvd_of_values hG hq hLM (a := 5)
        (by
          show Nat.gcd (4 + 1) (2 ^ 2 + 1) * 1 = 5
          norm_num) hk hodd
      exact ⟨hz, fun h' => absurd rfl (h' Q)⟩
    · obtain ⟨r', rfl⟩ : ∃ r', r = r' + 5 := ⟨r - 5, by omega⟩
      exact absurd h (by simp [In1512])
  | B r Q =>
    rcases (by omega : r = 0 ∨ r = 1 ∨ r = 2 ∨ r = 3 ∨ 4 ≤ r) with rfl | rfl | rfl | rfl | hr
    · exact absurd h (by simp [In1512])
    · exact absurd h (by simp [In1512])
    · have hQ : Q.p = 2 := h
      have hm := CFSG.QuasithinUnique.SQTK.statedClassicalModel_typeB2 Q hv e
      rw [hQ] at hm
      have hLM : LieModel (K ⧸ Subgroup.center K) .PSp 2 2 Q.exponent := ⟨hm.1, Or.inl hm⟩
      obtain ⟨k, hk⟩ := ksm_exc_two .PSp 2 Q.exponent
      have hz := ksm_dvd_of_values hG hq hLM (a := 1)
        (by
          show Nat.gcd 2 (2 ^ Q.exponent - 1) * 1 = 1
          rw [mul_one]
          exact ksm_gcd_two_odd (ksm_odd_two_pow_sub_one Q.exponent_pos)) hk hodd
      exact ⟨hz.trans (by norm_num), fun _ => Nat.dvd_one.1 hz⟩
    · have hQ : Q.p = 2 := h
      have hm := CFSG.RankThree.PartTwo.Census.statedClassicalModel_typeB_even 3 Q hv hQ
        (by norm_num) e
      rw [hQ] at hm
      have hLM : LieModel (K ⧸ Subgroup.center K) .PSp 3 2 Q.exponent := ⟨hm.1, Or.inl hm⟩
      obtain ⟨k, hk⟩ := ksm_exc_two .PSp 3 Q.exponent
      have hz := ksm_dvd_of_values hG hq hLM (a := 1)
        (by
          show Nat.gcd 2 (2 ^ Q.exponent - 1) * 1 = 1
          rw [mul_one]
          exact ksm_gcd_two_odd (ksm_odd_two_pow_sub_one Q.exponent_pos)) hk hodd
      exact ⟨hz.trans (by norm_num), fun _ => Nat.dvd_one.1 hz⟩
    · obtain ⟨r', rfl⟩ : ∃ r', r = r' + 4 := ⟨r - 4, by omega⟩
      exact absurd h (by simp [In1512])
  | C r Q => exact absurd h (by simp [In1512])
  | D r Q => exact absurd h (by simp [In1512])
  | twistedD r Q =>
    rcases (by omega : r = 0 ∨ r = 1 ∨ r = 2 ∨ r = 3 ∨ r = 4 ∨ 5 ≤ r) with
      rfl | rfl | rfl | rfl | rfl | hr
    · exact absurd h (by simp [In1512])
    · exact absurd h (by simp [In1512])
    · exact absurd h (by simp [In1512])
    · exact absurd h (by simp [In1512])
    · have hQ : Q.p = 2 := h
      have hm := CFSG.RankThree.PartTwo.Census.statedClassicalModel_typeTwistedD_even 4 Q hv hQ e
      rw [hQ] at hm
      have hLM : LieModel (K ⧸ Subgroup.center K) .POmegaMinus 4 2 Q.exponent := ⟨hm.1, Or.inl hm⟩
      obtain ⟨k, hk⟩ := ksm_exc_two .POmegaMinus 4 Q.exponent
      have hz := ksm_dvd_of_values hG hq hLM (a := 1)
        (by
          show Nat.gcd 4 ((2 ^ Q.exponent) ^ 4 + 1) * 1 = 1
          rw [mul_one]
          exact ksm_gcd_four_odd
            ((Nat.even_pow.2 ⟨Nat.even_pow.2 ⟨even_two, Q.exponent_pos.ne'⟩, by norm_num⟩).add_one))
        hk hodd
      exact ⟨hz.trans (by norm_num), fun _ => Nat.dvd_one.1 hz⟩
    · obtain ⟨r', rfl⟩ : ∃ r', r = r' + 5 := ⟨r - 5, by omega⟩
      exact absurd h (by simp [In1512])
  | E6 Q => exact absurd h (by simp [In1512])
  | E7 Q => exact absurd h (by simp [In1512])
  | E8 Q => exact absurd h (by simp [In1512])
  | F4 Q => exact absurd h (by simp [In1512])
  | G2 Q =>
    have hQ : Q.p = 2 := h
    have hQ3 : 3 ≤ Q.card := (TauCeti.LieTypeIndex.inStandardRange_iff _).1
      ((TauCeti.LieTypeIndex.valid_iff _).1 hv).1
    have hadm : StatedLieAdmissible .G2 0 2 Q.exponent := by
      refine ⟨Nat.prime_two, Q.exponent_pos, rfl, ?_⟩
      have hQ3' : 3 ≤ Q.p ^ Q.exponent := by
        rw [← TauCeti.PrimePower.card_def]
        exact hQ3
      rw [hQ] at hQ3'
      exact hQ3'
    have hLM : LieModel (K ⧸ Subgroup.center K) .G2 0 2 Q.exponent :=
      ⟨hadm, Or.inr ⟨rfl, ⟨TauCeti.LieTypeIndex.G2 Q, hv⟩, ⟨hQ, rfl⟩, ⟨e⟩⟩⟩
    obtain ⟨k, hk⟩ := ksm_exc_two .G2 0 Q.exponent
    have hz := ksm_dvd_of_values hG hq hLM (a := 1) rfl hk hodd
    exact ⟨hz.trans (by norm_num), fun _ => Nat.dvd_one.1 hz⟩
  | twistedE6 Q => exact absurd h (by simp [In1512])
  | trialityD4 Q => exact absurd h (by simp [In1512])
  | suzuki m => exact absurd h (by simp [In1512])
  | reeG2 m => exact absurd h (by simp [In1512])
  | reeF4 m => exact absurd h (by simp [In1512])
  | tits => exact absurd h (by simp [In1512])

theorem KSMOdd_of_griess (hG : CFSG.Open.GriessAllModelsStatement) : KSMOdd := by
  refine ⟨?_, ?_⟩
  · intro K _ _ hq d h1512 hA2 hTA3 ⟨e⟩ hodd
    have := ksm_odd_cases hG hq d h1512 hA2 hTA3 e hodd
    exact ⟨fun _ => this.1, this.2⟩
  · intro K _ _ hq d ⟨q, hq3, hd⟩ ⟨e⟩ hodd
    obtain ⟨d1, hv⟩ := d
    simp only at hd
    subst hd
    have hm := CFSG.QuasithinUnique.SQTK.statedClassicalModel_twistedA 2 q hv e
    obtain ⟨hp3, he1⟩ := (Nat.Prime.pow_eq_iff Nat.prime_three).mp (ksm_card_eq hq3)
    rw [hp3, he1] at hm
    have hLM : LieModel (K ⧸ Subgroup.center K) .PSU (2 + 1) 3 1 := ⟨hm.1, Or.inl hm⟩
    have hdvd := ksm_card_center_dvd hG hq hLM
    have hgen : genericOrders .PSU (2 + 1) 3 1 = (1, 1) := by
      show (Nat.gcd (2 + 1) (3 ^ 1 + 1), 1) = (1, 1)
      norm_num
    have hexc : exceptionalOrders .PSU (2 + 1) 3 1 = (1, 1) := by
      unfold exceptionalOrders
      split <;> first | rfl | simp_all
    rw [hgen, hexc] at hdvd
    simpa using hdvd

end GriessProofs

