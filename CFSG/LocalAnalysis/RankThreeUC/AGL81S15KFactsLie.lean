@[expose] def IsThreeOnePlusFour (R : Type) [Group R] : Prop :=
  Nat.card R = 3 ^ 5 ∧ (∀ x : R, x ^ 3 = 1) ∧ Nat.card (Subgroup.center R) = 3 ∧
    commutator R ≤ Subgroup.center R

@[expose] def K4143Classical : Prop :=
  ∀ (X : Type) [Group X] [Finite X] (L : Subgroup X), L.Normal → CFSG.Open.IsQuasisimple L →
    Subgroup.center ↥L = ⊥ → IsClassicalTwoOrG2 (↥L ⧸ Subgroup.center ↥L) →
    CFSG.Open.pRank 3 L = 3 → CFSG.Open.pRank 3 (⊤ : Subgroup X) = 3 →
      pElementSubgroup 3 (⊤ : Subgroup X) ≤ L

@[expose] def K4143ShapeIdx : TauCeti.LieTypeIndex → Prop
  | .B 3 Q => Q.p = 2
  | .twistedD 4 Q => Q.p = 2
  | .A 5 Q => Q.card = 2
  | .A 6 Q => Q.card = 2
  | _ => False

@[expose] def IsK4143Shape (L : Type) [Group L] : Prop :=
  ∃ d : TauCeti.ValidLieTypeIndex, K4143ShapeIdx d.1 ∧
    Nonempty (L ≃* (TauCeti.CFSGIndex.lie d).Group)

@[expose] def K4143 : Prop :=
  ∀ (X : Type) [Group X] [Finite X] (L : Subgroup X), L.Normal → CFSG.Open.IsQuasisimple L →
    Subgroup.center ↥L = ⊥ → IsK4143Shape ↥L →
    CFSG.Open.pRank 3 L = 3 → CFSG.Open.pRank 3 (⊤ : Subgroup X) = 3 →
      pElementSubgroup 3 (⊤ : Subgroup X) ≤ L

theorem k4143ShapeIdx_cases {d : TauCeti.LieTypeIndex} (h : K4143ShapeIdx d) :
    (∃ Q : TauCeti.PrimePower, d = .B 3 Q ∧ Q.p = 2) ∨
    (∃ Q : TauCeti.PrimePower, d = .twistedD 4 Q ∧ Q.p = 2) ∨
    (∃ Q : TauCeti.PrimePower, d = .A 5 Q ∧ Q.card = 2) ∨
    (∃ Q : TauCeti.PrimePower, d = .A 6 Q ∧ Q.card = 2) := by
  unfold K4143ShapeIdx at h
  split at h
  · exact Or.inl ⟨_, rfl, h⟩
  · exact Or.inr (Or.inl ⟨_, rfl, h⟩)
  · exact Or.inr (Or.inr (Or.inl ⟨_, rfl, h⟩))
  · exact Or.inr (Or.inr (Or.inr ⟨_, rfl, h⟩))
  · exact h.elim

theorem isClassicalOrG2Index_of_k4143ShapeIdx {d : TauCeti.LieTypeIndex} (h : K4143ShapeIdx d) :
    IsClassicalOrG2Index d := by
  rcases k4143ShapeIdx_cases h with ⟨Q, rfl, hQ⟩ | ⟨Q, rfl, hQ⟩ | ⟨Q, rfl, hQc⟩ | ⟨Q, rfl, hQc⟩
  · exact hQ
  · exact hQ
  · have h2 : Q.p ^ Q.exponent = 2 := by
      rw [← TauCeti.PrimePower.card_def]
      exact hQc
    exact ((Nat.Prime.pow_eq_iff Nat.prime_two).mp h2).1
  · have h2 : Q.p ^ Q.exponent = 2 := by
      rw [← TauCeti.PrimePower.card_def]
      exact hQc
    exact ((Nat.Prime.pow_eq_iff Nat.prime_two).mp h2).1

theorem isClassicalTwoOrG2_of_isK4143Shape {S : Type} [Group S] (h : IsK4143Shape S)
    (hZ : Subgroup.center S = ⊥) : IsClassicalTwoOrG2 (S ⧸ Subgroup.center S) := by
  obtain ⟨d, hd, ⟨e⟩⟩ := h
  exact Or.inl ⟨d, isClassicalOrG2Index_of_k4143ShapeIdx hd,
    ⟨(QuotientGroup.quotientMulEquivOfEq hZ).trans (QuotientGroup.quotientBot.trans e)⟩⟩

theorem K4143_of_classical (h : K4143Classical) : K4143 := by
  intro X _ _ L hn hq hZ hshape h3L h3X
  exact h X L hn hq hZ (isClassicalTwoOrG2_of_isK4143Shape hshape hZ) h3L h3X

@[expose] def K7145 : Prop :=
  ∀ (X : Type) [Group X] [Finite X], CFSG.Open.IsKGroup X → ∀ p : ℕ, p.Prime → p ≠ 2 →
    ∀ L : Subgroup X, L.Normal → CFSG.Open.IsQuasisimple L → CFSG.Open.pRank p L ≤ 1 →
    ∀ x : X, (∃ k : ℕ, orderOf x = p ^ k) → x ∉ L ⊔ Subgroup.centralizer (L : Set X) →
      ∃ N : Subgroup X, N.Normal ∧ N.index = p

@[expose] def IsOutTwoGroupList (S : Type) [Group S] : Prop :=
  Nonempty (S ≃* alternatingGroup (Fin 6)) ∨ Nonempty (S ≃* alternatingGroup (Fin 8)) ∨
    ∃ d : TauCeti.ValidLieTypeIndex,
      ((∃ Q : TauCeti.PrimePower, Q.card = 2 ∧ d.1 = .A 4 Q) ∨
        (∃ Q : TauCeti.PrimePower, Q.card = 3 ∧ d.1 = .twistedA 2 Q) ∨
        (∃ Q : TauCeti.PrimePower, Q.card = 7 ∧ d.1 = .A 1 Q)) ∧
      Nonempty (S ≃* (TauCeti.CFSGIndex.lie d).Group)

@[expose] def KOut : Prop :=
  ∀ (S : Type) [Group S] [Finite S], IsOutTwoGroupList S → ∀ φ : MulAut S,
    ∃ k : ℕ, φ ^ (2 ^ k) ∈ (MulAut.conj : S →* MulAut S).range

@[expose] def K420 : Prop :=
  ∀ (L : Type) [Group L] [Finite L], CFSG.Open.IsQuasisimple L →
    IsClassicalTwoOrG2 (L ⧸ Subgroup.center L) →
    ∀ P : Subgroup (MulAut L), IsPGroup 2 P → ∀ a ∈ P, ∀ b ∈ P,
      ⁅a, b⁆ ∈ (MulAut.conj : L →* MulAut L).range

theorem K420_of_outTwoRank
    (h : ∀ (Y : Type) [Group Y] [Finite Y], IsClassicalTwoOrG2 Y →
      CFSG.HardMathSupport.Cooperstein.StructureLie.OutTwoRank Y) : K420 := by
  intro L _ _ hq hY P hP a ha b hb
  haveI : Group.IsPerfect L := ⟨hq.1⟩
  have hOut := h (L ⧸ Subgroup.center L) hY
  set π := CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom L with hπ
  have hP' : IsPGroup 2 (P.map π) := hP.map π
  obtain ⟨y, hy⟩ := (hOut (P.map π) hP').1 (π a) ⟨a, ha, rfl⟩ (π b) ⟨b, hb, rfl⟩
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective y
  have hconj : π (MulAut.conj g) = MulAut.conj (QuotientGroup.mk g : L ⧸ Subgroup.center L) := by
    ext z
    obtain ⟨z, rfl⟩ := QuotientGroup.mk_surjective z
    have h1 := CFSG.ComponentClassification.PerfectAutomorphisms.onCenterQuotient_apply_mk
      (MulAut.conj g) z
    simp only [QuotientGroup.mk'_apply] at h1
    simp [hπ, CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom, h1,
      MulAut.conj_apply]
  refine ⟨g, ?_⟩
  apply CFSG.ComponentClassification.PerfectAutomorphisms.centerQuotientHom_injective L
  rw [← hπ, hconj, hy, map_commutatorElement]

section CertifiedK420


theorem K420_holds : K420 :=
  K420_of_outTwoRank fun _ _ _ h =>
    CFSG.HardMathSupport.Cooperstein.StructureLie.outTwoRank_of_isClassicalTwoOrG2 h

end CertifiedK420

@[expose] def KSMU4 : Prop :=
  ∀ (K : Type) [Group K] [Finite K], CFSG.Open.IsQuasisimple K →
    ∀ d : TauCeti.ValidLieTypeIndex, (∃ Q : TauCeti.PrimePower, Q.p = 2 ∧ d.1 = .twistedA 3 Q) →
      Nonempty ((K ⧸ Subgroup.center K) ≃* (TauCeti.CFSGIndex.lie d).Group) →
      Odd (Nat.card (Subgroup.center K)) → Nat.card (Subgroup.center K) = 1

@[expose] def KSML3 : Prop :=
  ∀ (K : Type) [Group K] [Finite K], CFSG.Open.IsQuasisimple K →
    ∀ d : TauCeti.ValidLieTypeIndex,
      Nonempty ((K ⧸ Subgroup.center K) ≃* (TauCeti.CFSGIndex.lie d).Group) →
      Odd (Nat.card (Subgroup.center K)) →
      (((∃ Q : TauCeti.PrimePower, Q.p = 2 ∧ Odd Q.exponent ∧ d.1 = .A 2 Q) ∨
          (∃ q : TauCeti.PrimePower, q.card = 7 ∧ d.1 = .A 1 q)) →
        Nat.card (Subgroup.center K) = 1) ∧
      ((∃ Q : TauCeti.PrimePower, Q.p = 2 ∧ Even Q.exponent ∧ d.1 = .A 2 Q) →
        Nat.card (Subgroup.center K) ∣ 3)

@[expose] def KSMAlt : Prop :=
  ∀ (K : Type) [Group K] [Finite K], CFSG.Open.IsQuasisimple K → ∀ n : ℕ,
    Nonempty ((K ⧸ Subgroup.center K) ≃* alternatingGroup (Fin n)) →
      Odd (Nat.card (Subgroup.center K)) →
      ((n = 6 ∨ n = 7) → Nat.card (Subgroup.center K) ∣ 3) ∧
      (8 ≤ n → Nat.card (Subgroup.center K) = 1)

open CFSG.RankThree.PerfectCover in
theorem KSMAlt_holds : KSMAlt := by
  intro K _ _ hq n ⟨e⟩ hodd
  have hq' : CFSG.IsQuasisimple K :=
    ((CFSG.Foundations.SteinbergCA.quasisimple_iff K).2.2.1).2 hq
  haveI : Group.IsPerfect K := hq'.1
  have hperfX : Group.IsPerfect (alternatingGroup (Fin n)) :=
    isPerfect_of_quasisimple_quotient hq' e
  have hqs := centralQuotientMap_surjective e
  have hk := centralQuotientMap_ker e
  have hdvd : Nat.card (Subgroup.center K) ∣
      Nat.card (hopfMultiplier (alternatingGroup (Fin n))) := by
    have h1 := Subgroup.card_dvd_of_surjective
      (hopfMultiplierToKer_surjective (centralQuotientMap e) hqs hk.le)
    have h2 : Nat.card (centralQuotientMap e).ker = Nat.card (Subgroup.center K) := by rw [hk]
    rw [h2] at h1
    exact h1
  refine ⟨fun h67 => ?_, fun h8 => ?_⟩
  · have h5 : 5 ≤ n := by omega
    have := (CFSG.Alternating.Multipliers.schurAlternatingMultiplierInput n h5).2
    rw [if_pos h67] at this
    rw [this] at hdvd
    exact (Nat.Coprime.dvd_of_dvd_mul_left (Nat.coprime_two_right.2 hodd)
      (by simpa using hdvd : Nat.card (Subgroup.center K) ∣ 2 * 3))
  · have h5 : 5 ≤ n := by omega
    have := (CFSG.Alternating.Multipliers.schurAlternatingMultiplierInput n h5).2
    rw [if_neg (by omega)] at this
    rw [this] at hdvd
    have h2 := Nat.le_of_dvd (by norm_num) hdvd
    rcases hodd with ⟨k, hk'⟩
    have : Nat.card (Subgroup.center K) ≠ 0 := Nat.card_pos.ne'
    omega

@[expose] def KSMOdd : Prop :=
  (∀ (K : Type) [Group K] [Finite K], CFSG.Open.IsQuasisimple K →
    ∀ d : TauCeti.ValidLieTypeIndex, In1512 d.1 → (∀ Q, d.1 ≠ .A 2 Q) → (∀ Q, d.1 ≠ .twistedA 3 Q) →
      Nonempty ((K ⧸ Subgroup.center K) ≃* (TauCeti.CFSGIndex.lie d).Group) →
      Odd (Nat.card (Subgroup.center K)) →
      ((∃ Q, d.1 = .twistedA 4 Q) → Nat.card (Subgroup.center K) ∣ 5) ∧
      ((∀ Q, d.1 ≠ .twistedA 4 Q) → Nat.card (Subgroup.center K) = 1)) ∧
  (∀ (K : Type) [Group K] [Finite K], CFSG.Open.IsQuasisimple K →
    ∀ d : TauCeti.ValidLieTypeIndex, (∃ q : TauCeti.PrimePower, q.card = 3 ∧ d.1 = .twistedA 2 q) →
      Nonempty ((K ⧸ Subgroup.center K) ≃* (TauCeti.CFSGIndex.lie d).Group) →
      Odd (Nat.card (Subgroup.center K)) → Nat.card (Subgroup.center K) = 1)

