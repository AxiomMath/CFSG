instance fact_prime_seven : Fact (Nat.Prime 7) := ⟨by norm_num⟩

theorem coprime_subgroupOf_normal {Y : Type} [Group Y] [Finite Y] (K S : Subgroup Y) [K.Normal]
    (hS : ¬ 7 ∣ S.index) : ¬ 7 ∣ (S.subgroupOf K).index := by
  intro h7
  have hc : K.relIndex S ≠ 0 := by
    unfold Subgroup.relIndex
    exact Subgroup.index_ne_zero_of_finite
  have h1 : (S ⊓ K).index = S.relIndex K * K.index := Subgroup.index_inf
  have h2 : (S ⊓ K).relIndex S * S.index = (S ⊓ K).index :=
    Subgroup.relIndex_mul_index inf_le_left
  have h3 : (S ⊓ K).relIndex S = K.relIndex S := by
    unfold Subgroup.relIndex
    congr 1
    ext x
    simp [Subgroup.mem_subgroupOf, Subgroup.mem_inf]
  have h4 : K.relIndex (S ⊔ K) = K.relIndex S := Subgroup.relIndex_sup_right S K
  have h5 : K.relIndex (S ⊔ K) * (S ⊔ K).index = K.index :=
    Subgroup.relIndex_mul_index le_sup_right
  rw [h3] at h2
  rw [h4] at h5
  have key : K.relIndex S * S.index = S.relIndex K * K.index := by rw [h2, h1]
  rw [← h5] at key
  have key2 : S.index = S.relIndex K * (S ⊔ K).index := by
    apply Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hc)
    calc K.relIndex S * S.index = S.relIndex K * (K.relIndex S * (S ⊔ K).index) := key
      _ = K.relIndex S * (S.relIndex K * (S ⊔ K).index) := by ring
  apply hS
  rw [key2]
  exact Dvd.dvd.mul_right h7 _


theorem sylow7_count_eq {G : Type} [Group G] [Finite G] (H P : Subgroup G)
    (hP : IsPGroup 7 P) (hPi : ¬ 7 ∣ P.index) (hPH : P ≤ H)
    (hN : Subgroup.normalizer (P : Set G) ≤ H) :
    Nat.card (Sylow 7 G) = H.index * Nat.card (Sylow 7 H) := by
  have hPH' : IsPGroup 7 (P.subgroupOf H) := hP.comap_of_injective H.subtype Subtype.val_injective
  have hPHi : ¬ 7 ∣ (P.subgroupOf H).index := by
    intro h
    exact hPi (h.trans (Subgroup.relIndex_dvd_index_of_le hPH))
  have hNH : Subgroup.normalizer (((P.subgroupOf H) : Subgroup H) : Set H) =
      (Subgroup.normalizer (P : Set G)).subgroupOf H := by
    ext h
    rw [Subgroup.mem_subgroupOf, Subgroup.mem_normalizer_iff, Subgroup.mem_normalizer_iff]
    constructor
    · intro hh y
      by_cases hy : y ∈ H
      · have := hh ⟨y, hy⟩
        simpa [Subgroup.mem_subgroupOf] using this
      · refine ⟨fun h' => absurd (hPH h') hy, fun h' => ?_⟩
        exfalso
        apply hy
        have hH' : (h : G) * y * (h : G)⁻¹ ∈ H := hPH h'
        have hyc : y = (h : G)⁻¹ * ((h : G) * y * (h : G)⁻¹) * (h : G) := by group
        rw [hyc]
        exact H.mul_mem (H.mul_mem (H.inv_mem h.2) hH') h.2
    · intro hg x
      simpa [Subgroup.mem_subgroupOf] using hg x
  have hG : Nat.card (Sylow 7 G) = (Subgroup.normalizer (P : Set G)).index := by
    rw [Sylow.card_eq_index_normalizer (hP.toSylow hPi)]
    rfl
  have hH : Nat.card (Sylow 7 H) = (Subgroup.normalizer (P : Set G)).relIndex H := by
    rw [Sylow.card_eq_index_normalizer (hPH'.toSylow hPHi)]
    show (Subgroup.normalizer (((P.subgroupOf H) : Subgroup H) : Set H)).index = _
    rw [hNH]
    rfl
  rw [hG, hH, ← Subgroup.relIndex_mul_index hN, mul_comm]

theorem exists_sylow_subgroupOf {Y : Type} [Group Y] [Finite Y] (K S : Subgroup Y) [K.Normal]
    (hS : IsPGroup 7 S) (hSi : ¬ 7 ∣ S.index) :
    ∃ T : Sylow 7 K, (T : Subgroup K) = S.subgroupOf K := by
  have hP : IsPGroup 7 (S.subgroupOf K) := hS.comap_of_injective K.subtype Subtype.val_injective
  exact ⟨hP.toSylow (coprime_subgroupOf_normal K S hSi), rfl⟩

theorem frattini_conj {K : Type} [Group K] [Finite K] {Kb : Type} [Group Kb]
    (π : K →* Kb) (T : Sylow 7 K) (x : K)
    (hx : π x ∈ Subgroup.normalizer (((T : Subgroup K).map π : Subgroup Kb) : Set Kb)) :
    ∃ g : K, π g ∈ (T : Subgroup K).map π ∧
      ∀ s : K, s ∈ (T : Subgroup K) ↔ (g⁻¹ * x) * s * (g⁻¹ * x)⁻¹ ∈ (T : Subgroup K) := by
  classical
  set S0 : Subgroup K := (T : Subgroup K) with hS0
  set Sh : Subgroup K := (S0.map π).comap π with hSh
  have hS0Sh : S0 ≤ Sh := fun s hs => Subgroup.mem_comap.mpr (Subgroup.mem_map_of_mem π hs)
  have hxSh : ∀ k ∈ Sh, x * k * x⁻¹ ∈ Sh := by
    intro k hk
    have hk' : π k ∈ S0.map π := hk
    have hc := (Subgroup.mem_normalizer_iff.mp hx (π k)).mp hk'
    show π (x * k * x⁻¹) ∈ S0.map π
    rw [map_mul, map_mul, map_inv]
    exact hc
  set S1 : Subgroup K := S0.map (MulAut.conj x : MulAut K).toMonoidHom with hS1
  have memS1 : ∀ y : K, y ∈ S1 ↔ x⁻¹ * y * x ∈ S0 := by
    intro y
    constructor
    · rintro ⟨z, hz, rfl⟩
      simpa [MulAut.conj_apply, mul_assoc] using hz
    · intro hy
      exact ⟨x⁻¹ * y * x, hy, by show x * (x⁻¹ * y * x) * x⁻¹ = y; group⟩
  have hS1Sh : S1 ≤ Sh := by
    intro y hy
    obtain ⟨z, hz, hzy⟩ := Subgroup.mem_map.mp hy
    rw [← hzy]
    exact hxSh z (hS0Sh hz)
  have hS0i : ¬ 7 ∣ S0.index := T.not_dvd_index
  have hS1p : IsPGroup 7 S1 := T.isPGroup'.map _
  have hS1i : ¬ 7 ∣ S1.index := by
    have hidx : S1.index = S0.index := Subgroup.index_map_equiv S0 (MulAut.conj x)
    rw [hidx]
    exact hS0i
  have hT0p : IsPGroup 7 (S0.subgroupOf Sh) :=
    T.isPGroup'.comap_of_injective Sh.subtype Subtype.val_injective
  have hT1p : IsPGroup 7 (S1.subgroupOf Sh) :=
    hS1p.comap_of_injective Sh.subtype Subtype.val_injective
  have hT0i : ¬ 7 ∣ (S0.subgroupOf Sh).index := fun h =>
    hS0i (h.trans (Subgroup.relIndex_dvd_index_of_le hS0Sh))
  have hT1i : ¬ 7 ∣ (S1.subgroupOf Sh).index := fun h =>
    hS1i (h.trans (Subgroup.relIndex_dvd_index_of_le hS1Sh))
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq Sh (hT0p.toSylow hT0i) (hT1p.toSylow hT1i)
  have hcoe : MulAut.conj g • (S0.subgroupOf Sh) = S1.subgroupOf Sh := by
    have h1 : ((g • hT0p.toSylow hT0i : Sylow 7 Sh) : Subgroup Sh) =
        ((hT1p.toSylow hT1i : Sylow 7 Sh) : Subgroup Sh) := by rw [hg]
    rw [Sylow.coe_subgroup_smul] at h1
    exact h1
  have hQmem : ∀ t : Sh, t ∈ S1.subgroupOf Sh ↔ (g⁻¹ * t * g) ∈ S0.subgroupOf Sh := by
    intro t
    rw [← hcoe, Subgroup.mem_pointwise_smul_iff_inv_smul_mem, MulAut.smul_def,
      MulAut.conj_inv_apply]
  refine ⟨(g : K), g.2, ?_⟩
  intro s
  constructor
  · intro hs
    have ht : x * s * x⁻¹ ∈ Sh := hxSh s (hS0Sh hs)
    have htS1 : (⟨x * s * x⁻¹, ht⟩ : Sh) ∈ S1.subgroupOf Sh := by
      rw [Subgroup.mem_subgroupOf]
      exact (memS1 _).mpr (by rw [show x⁻¹ * (x * s * x⁻¹) * x = s by group]; exact hs)
    have h2 := (hQmem _).mp htS1
    rw [Subgroup.mem_subgroupOf] at h2
    have e : (g : K)⁻¹ * x * s * ((g : K)⁻¹ * x)⁻¹ = (g : K)⁻¹ * (x * s * x⁻¹) * (g : K) := by
      group
    rw [e]
    exact h2
  · intro hn
    set r : K := (g : K)⁻¹ * x * s * ((g : K)⁻¹ * x)⁻¹ with hr
    have hrSh : r ∈ Sh := hS0Sh hn
    have hu : (g : K) * r * (g : K)⁻¹ ∈ Sh := Sh.mul_mem (Sh.mul_mem g.2 hrSh) (Sh.inv_mem g.2)
    have hQ' : (⟨(g : K) * r * (g : K)⁻¹, hu⟩ : Sh) ∈ S1.subgroupOf Sh := by
      refine (hQmem _).mpr ?_
      rw [Subgroup.mem_subgroupOf]
      show (g : K)⁻¹ * ((g : K) * r * (g : K)⁻¹) * (g : K) ∈ S0
      rw [show (g : K)⁻¹ * ((g : K) * r * (g : K)⁻¹) * (g : K) = r by group]
      exact hn
    have h3 : x⁻¹ * ((g : K) * r * (g : K)⁻¹) * x ∈ S0 :=
      (memS1 _).mp (Subgroup.mem_subgroupOf.mp hQ')
    have hs' : s = x⁻¹ * ((g : K) * r * (g : K)⁻¹) * x := by
      rw [hr]
      group
    rw [hs']
    exact h3

theorem normalizer_map_le {Y : Type} [Group Y] [Finite Y] {K D : Subgroup Y} [K.Normal]
    (hD : CFSG.RankThree.PartOne.IsStronglyPEmbedded 7 D)
    {Kb : Type} [Group Kb] (π : K →* Kb) (hπ : Function.Surjective π)
    (T : Sylow 7 K) (hTD : (T : Subgroup K) ≤ D.subgroupOf K) (hTne : (T : Subgroup K) ≠ ⊥) :
    Subgroup.normalizer (((T : Subgroup K).map π : Subgroup Kb) : Set Kb) ≤
      (D.subgroupOf K).map π := by
  classical
  intro xb hxb
  obtain ⟨x, rfl⟩ := hπ xb
  obtain ⟨g, hgP, hn⟩ := frattini_conj π T x hxb
  set S0 : Subgroup K := (T : Subgroup K) with hS0
  set U : Subgroup Y := S0.map K.subtype with hU
  have hUne : U ≠ ⊥ := by
    intro hUb
    apply hTne
    rw [eq_bot_iff]
    intro s hs
    have hsU : (s : Y) ∈ U := Subgroup.mem_map_of_mem K.subtype hs
    rw [hUb, Subgroup.mem_bot] at hsU
    exact Subgroup.mem_bot.mpr (Subtype.ext hsU)
  have hUp : IsPGroup 7 U := T.isPGroup'.map K.subtype
  have hUD : U ≤ D := by
    intro y hy
    obtain ⟨s, hs, rfl⟩ := Subgroup.mem_map.mp hy
    exact Subgroup.mem_subgroupOf.mp (hTD hs)
  have hNY : Subgroup.normalizer (U : Set Y) ≤ D := hD.normalizer_le hUne hUp hUD
  have hKU : ∀ s : K, (s : Y) ∈ U ↔ s ∈ S0 := by
    intro s
    constructor
    · intro hs
      obtain ⟨s', hs', hs'eq⟩ := Subgroup.mem_map.mp hs
      have hss : s' = s := Subtype.ext hs'eq
      rw [← hss]
      exact hs'
    · intro hs
      exact Subgroup.mem_map_of_mem K.subtype hs
  have hnN : ((g⁻¹ * x : K) : Y) ∈ Subgroup.normalizer (U : Set Y) := by
    rw [Subgroup.mem_normalizer_iff]
    intro y
    by_cases hyK : y ∈ K
    · obtain ⟨s, rfl⟩ : ∃ s : K, (s : Y) = y := ⟨⟨y, hyK⟩, rfl⟩
      have e : ((g⁻¹ * x : K) : Y) * (s : Y) * ((g⁻¹ * x : K) : Y)⁻¹ =
          (((g⁻¹ * x) * s * (g⁻¹ * x)⁻¹ : K) : Y) := rfl
      rw [hKU s, e, hKU]
      exact hn s
    · have h1 : y ∉ U := fun hy => hyK (Subgroup.map_subtype_le S0 hy)
      have h2 : ((g⁻¹ * x : K) : Y) * y * ((g⁻¹ * x : K) : Y)⁻¹ ∉ U := by
        intro hy2
        apply hyK
        have hK2 : ((g⁻¹ * x : K) : Y) * y * ((g⁻¹ * x : K) : Y)⁻¹ ∈ K :=
          Subgroup.map_subtype_le S0 hy2
        have hyc : y = ((g⁻¹ * x : K) : Y)⁻¹ *
            (((g⁻¹ * x : K) : Y) * y * ((g⁻¹ * x : K) : Y)⁻¹) * ((g⁻¹ * x : K) : Y) := by
          group
        rw [hyc]
        exact K.mul_mem (K.mul_mem (K.inv_mem (g⁻¹ * x).2) hK2) (g⁻¹ * x).2
      exact ⟨fun h => absurd h h1, fun h => absurd h h2⟩
  have hnD : ((g⁻¹ * x : K) : Y) ∈ D := hNY hnN
  have hnDK : g⁻¹ * x ∈ D.subgroupOf K := Subgroup.mem_subgroupOf.mpr hnD
  have hPH : S0.map π ≤ (D.subgroupOf K).map π := Subgroup.map_mono hTD
  have hpx : π x = π g * π (g⁻¹ * x) := by
    rw [← map_mul, mul_inv_cancel_left]
  rw [hpx]
  exact ((D.subgroupOf K).map π).mul_mem (hPH hgP) (Subgroup.mem_map_of_mem π hnDK)

theorem seven_dvd_card_of_isL3FourCover (Kb : Type) [Group Kb] [Finite Kb]
    (h : KFactsSmall.IsL3FourCover Kb) : 7 ∣ Nat.card Kb := by
  obtain ⟨⟨t, hv⟩, Q, hQ, ht, ⟨e⟩⟩ := h
  have ht' : t = TauCeti.LieTypeIndex.A 2 Q := ht
  subst ht'
  haveI : Fact (Nat.Prime Q.p) := ⟨Q.prime_p⟩
  have hK : Nat.card (GaloisField Q.p Q.exponent) = 4 := by
    rw [GaloisField.card Q.p Q.exponent Q.exponent_pos.ne', ← TauCeti.PrimePower.card_def, hQ]
  have hpsl := CFSG.Quasithin.Vol2.Ch11.SecB.card_psl_eq_ordA
    (K := GaloisField Q.p Q.exponent) (n := 3) (by norm_num)
  rw [hK] at hpsl
  have hord : CFSG.Open.ordA (3 - 1) 4 = 20160 := by decide
  have hcardL : Nat.card (Kb ⧸ Subgroup.center Kb) = 20160 := by
    rw [Nat.card_congr e.toEquiv]
    exact ((Nat.card_congr (CFSG.ClassicalModels.linearCatalogCandidateEquivPSL 2 Q hv).toEquiv).trans
      hpsl).trans hord
  have hidx : (Subgroup.center Kb).index = 20160 := hcardL
  have hZ : (Subgroup.center Kb).index * Nat.card (Subgroup.center Kb) = Nat.card Kb := by
    rw [Nat.mul_comm]
    exact Subgroup.card_mul_index _
  rw [← hZ, hidx]
  exact Dvd.dvd.mul_right (by norm_num) _

