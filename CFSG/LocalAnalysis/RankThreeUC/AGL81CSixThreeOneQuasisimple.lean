private theorem exists_spGram_basis {p : ℕ} [Fact p.Prime] {W : Type} [AddCommGroup W]
    [Module (ZMod p) W] {B : LinearMap.BilinForm (ZMod p) W}
    {bs : Module.Basis (Fin 2 ⊕ Fin 2) (ZMod p) W}
    (hbs : BilinForm.toMatrix bs B = Matrix.J (Fin 2) (ZMod p)) :
    ∃ bs' : Module.Basis (Fin 2 ⊕ Fin 2) (ZMod p) W,
      BilinForm.toMatrix bs' B = CFSG.RankThree.SubgroupLists.spGram 2 (ZMod p) := by
  classical
  let d : Fin 2 ⊕ Fin 2 → (ZMod p)ˣ := Sum.elim (fun _ => 1) (fun _ => -1)
  refine ⟨bs.unitsSMul d, ?_⟩
  have hJ : ∀ i j, B (bs i) (bs j) = Matrix.J (Fin 2) (ZMod p) i j := by
    intro i j
    rw [← BilinForm.toMatrix_apply bs B, hbs]
  ext i j
  rw [BilinForm.toMatrix_apply, Module.Basis.unitsSMul_apply, Module.Basis.unitsSMul_apply,
    Units.smul_def, Units.smul_def, BilinForm.smul_left, BilinForm.smul_right, hJ]
  rcases i with i | i <;> rcases j with j | j <;>
    simp [d, Matrix.J, CFSG.RankThree.SubgroupLists.spGram, Matrix.fromBlocks, smul_eq_mul]

private theorem spForm_equivFun_eq {p : ℕ} [Fact p.Prime] {W : Type} [AddCommGroup W]
    [Module (ZMod p) W] {B : LinearMap.BilinForm (ZMod p) W}
    {bs : Module.Basis (Fin 2 ⊕ Fin 2) (ZMod p) W}
    (hbs : BilinForm.toMatrix bs B = CFSG.RankThree.SubgroupLists.spGram 2 (ZMod p)) :
    ∀ u v : W, CFSG.RankThree.SubgroupLists.spForm 2 (ZMod p) (bs.equivFun u)
      (bs.equivFun v) = B u v := by
  intro u v
  have hcb : ∀ i : Fin 2 ⊕ Fin 2,
      bs.equivFun (bs i) = Pi.basisFun (ZMod p) (Fin 2 ⊕ Fin 2) i := by
    intro i
    funext j
    rw [Pi.basisFun_apply, Module.Basis.equivFun_self]
    by_cases h : i = j <;> simp [h, Pi.single_apply]
  let B' : BilinForm (ZMod p) (Fin 2 ⊕ Fin 2 → ZMod p) := BilinForm.congr bs.equivFun B
  have hmat : BilinForm.toMatrix (Pi.basisFun (ZMod p) (Fin 2 ⊕ Fin 2)) B' =
      CFSG.RankThree.SubgroupLists.spGram 2 (ZMod p) := by
    ext i j
    rw [BilinForm.toMatrix_apply, BilinForm.congr_apply, ← hcb i, ← hcb j,
      LinearEquiv.symm_apply_apply, LinearEquiv.symm_apply_apply,
      ← BilinForm.toMatrix_apply bs B, hbs]
  have hsp : BilinForm.toMatrix (Pi.basisFun (ZMod p) (Fin 2 ⊕ Fin 2))
      (CFSG.RankThree.SubgroupLists.spForm 2 (ZMod p)) =
        CFSG.RankThree.SubgroupLists.spGram 2 (ZMod p) := by
    rw [CFSG.RankThree.SubgroupLists.spForm, BilinForm.toMatrix_basisFun,
      BilinForm.toMatrix'_toBilin']
  have hB' : B' = CFSG.RankThree.SubgroupLists.spForm 2 (ZMod p) :=
    (BilinForm.toMatrix (Pi.basisFun (ZMod p) (Fin 2 ⊕ Fin 2))).injective
      (hmat.trans hsp.symm)
  calc CFSG.RankThree.SubgroupLists.spForm 2 (ZMod p) (bs.equivFun u) (bs.equivFun v)
      = B' (bs.equivFun u) (bs.equivFun v) := by rw [hB']
    _ = B u v := by
        rw [BilinForm.congr_apply, LinearEquiv.symm_apply_apply, LinearEquiv.symm_apply_apply]

private theorem exists_coordinates_of_basis {p : ℕ} [Fact p.Prime] {W : Type} [AddCommGroup W]
    [Module (ZMod p) W] {B : LinearMap.BilinForm (ZMod p) W}
    {bs : Module.Basis (Fin 2 ⊕ Fin 2) (ZMod p) W}
    (hbs : BilinForm.toMatrix bs B = CFSG.RankThree.SubgroupLists.spGram 2 (ZMod p)) :
    ∃ (c : W ≃ₗ[ZMod p] (Fin 2 ⊕ Fin 2 → ZMod p))
      (τ : (Module.End (ZMod p) W)ˣ ≃* GL (Fin 2 ⊕ Fin 2) (ZMod p)),
      (∀ u v : W, CFSG.RankThree.SubgroupLists.spForm 2 (ZMod p) (c u) (c v) = B u v) ∧
      (∀ (x : (Module.End (ZMod p) W)ˣ) (v : W),
        (τ x : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod p)) *ᵥ c v =
          c ((x : Module.End (ZMod p) W) v)) ∧
      ∀ x : (Module.End (ZMod p) W)ˣ, τ x ∈ CFSG.Open.StatedSp 2 (ZMod p) ↔
        ∀ u v : W, B ((x : Module.End (ZMod p) W) u) ((x : Module.End (ZMod p) W) v) = B u v := by
  classical
  let c : W ≃ₗ[ZMod p] (Fin 2 ⊕ Fin 2 → ZMod p) := bs.equivFun
  let A : (Module.End (ZMod p) W) ≃ₐ[ZMod p]
      Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod p) := LinearMap.toMatrixAlgEquiv bs
  let τ : (Module.End (ZMod p) W)ˣ ≃* GL (Fin 2 ⊕ Fin 2) (ZMod p) :=
    Units.mapEquiv A.toRingEquiv.toMulEquiv
  have hcb : ∀ i : Fin 2 ⊕ Fin 2, c (bs i) = Pi.basisFun (ZMod p) (Fin 2 ⊕ Fin 2) i := by
    intro i
    funext j
    rw [Pi.basisFun_apply, Module.Basis.equivFun_self]
    by_cases h : i = j <;> simp [h, Pi.single_apply]
  have hspB : ∀ u v : W, CFSG.RankThree.SubgroupLists.spForm 2 (ZMod p) (c u) (c v) =
      B u v := spForm_equivFun_eq hbs
  have hτc : ∀ (x : (Module.End (ZMod p) W)ˣ) (v : W),
      (τ x : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod p)) *ᵥ c v =
        c ((x : Module.End (ZMod p) W) v) := by
    intro x v
    change (LinearMap.toMatrix bs bs (x : Module.End (ZMod p) W)) *ᵥ c v =
      c ((x : Module.End (ZMod p) W) v)
    rw [Module.Basis.equivFun_apply, LinearMap.toMatrix_mulVec_repr,
      Module.Basis.equivFun_apply]
  have hSp : ∀ x : (Module.End (ZMod p) W)ˣ, τ x ∈ CFSG.Open.StatedSp 2 (ZMod p) ↔
      ∀ u v : W, B ((x : Module.End (ZMod p) W) u) ((x : Module.End (ZMod p) W) v) = B u v := by
    intro x
    rw [mem_statedSp_iff_preserves]
    constructor
    · intro h u v
      have hx := h (c u) (c v)
      rwa [hτc x u, hτc x v, hspB ((x : Module.End (ZMod p) W) u)
        ((x : Module.End (ZMod p) W) v), hspB u v] at hx
    · intro h u v
      obtain ⟨u, rfl⟩ := c.surjective u
      obtain ⟨v, rfl⟩ := c.surjective v
      rw [hτc x u, hτc x v, hspB ((x : Module.End (ZMod p) W) u)
        ((x : Module.End (ZMod p) W) v), hspB u v]
      exact h u v
  exact ⟨c, τ, hspB, hτc, hSp⟩

theorem exists_symplecticCoordinates {p : ℕ} [Fact p.Prime] {W : Type} [AddCommGroup W]
    [Module (ZMod p) W] [Module.Finite (ZMod p) W] (hW : Module.finrank (ZMod p) W = 4)
    (B : LinearMap.BilinForm (ZMod p) W) (hBnd : ∀ u : W, (∀ v : W, B u v = 0) → u = 0)
    (hBalt : ∀ w : W, B w w = 0) :
    ∃ (c : W ≃ₗ[ZMod p] (Fin 2 ⊕ Fin 2 → ZMod p))
      (τ : (Module.End (ZMod p) W)ˣ ≃* GL (Fin 2 ⊕ Fin 2) (ZMod p)),
      (∀ u v : W, CFSG.RankThree.SubgroupLists.spForm 2 (ZMod p) (c u) (c v) = B u v) ∧
      (∀ (x : (Module.End (ZMod p) W)ˣ) (v : W),
        (τ x : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod p)) *ᵥ c v =
          c ((x : Module.End (ZMod p) W) v)) ∧
      ∀ x : (Module.End (ZMod p) W)ˣ, τ x ∈ CFSG.Open.StatedSp 2 (ZMod p) ↔
        ∀ u v : W, B ((x : Module.End (ZMod p) W) u) ((x : Module.End (ZMod p) W) v) = B u v := by
  classical
  have hBnd' : B.Nondegenerate :=
    BilinForm.Nondegenerate.ofSeparatingLeft (show B.SeparatingLeft from hBnd)
  obtain ⟨m, bs, hbs⟩ := BilinForm.IsAlt.exists_basis_toMatrix_eq_J (B := B) hBalt hBnd'
  have hm : m = 2 := by
    have h := Module.finrank_eq_card_basis bs
    rw [hW, Fintype.card_sum, Fintype.card_fin] at h
    omega
  subst hm
  obtain ⟨bs', hbs'⟩ := exists_spGram_basis hbs
  exact exists_coordinates_of_basis hbs'

theorem isIrreducibleOn_map_iff {p : ℕ} [Fact p.Prime] {W : Type} [AddCommGroup W]
    [Module (ZMod p) W] (c : W ≃ₗ[ZMod p] (Fin 2 ⊕ Fin 2 → ZMod p))
    (τ : (Module.End (ZMod p) W)ˣ ≃* GL (Fin 2 ⊕ Fin 2) (ZMod p))
    (hcτ : ∀ (x : (Module.End (ZMod p) W)ˣ) (v : W),
      (τ x : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod p)) *ᵥ c v =
        c ((x : Module.End (ZMod p) W) v))
    (H : Subgroup (Module.End (ZMod p) W)ˣ) :
    CFSG.RankThree.SubgroupLists.IsIrreducibleOn (H.map τ.toMonoidHom) ↔
      ∀ U : Submodule (ZMod p) W, (∀ x ∈ H, ∀ u ∈ U, (x : Module.End (ZMod p) W) u ∈ U) →
        U = ⊥ ∨ U = ⊤ := by
  constructor
  · intro hirr U hU
    have hinv : ∀ g ∈ H.map τ.toMonoidHom, ∀ w ∈ Submodule.map (c : W →ₗ[ZMod p] _) U,
        (g : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod p)) *ᵥ w ∈
          Submodule.map (c : W →ₗ[ZMod p] _) U := by
      rintro _ ⟨x, hx, rfl⟩ w hw
      obtain ⟨u, hu, rfl⟩ := Submodule.mem_map.mp hw
      change (τ x : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod p)) *ᵥ c u ∈
        Submodule.map (c : W →ₗ[ZMod p] _) U
      rw [hcτ x u]
      exact Submodule.mem_map_of_mem (hU x hx u hu)
    rcases hirr _ hinv with hbot | htop
    · left
      calc U = Submodule.comap (c : W →ₗ[ZMod p] (Fin 2 ⊕ Fin 2 → ZMod p))
              (Submodule.map (c : W →ₗ[ZMod p] (Fin 2 ⊕ Fin 2 → ZMod p)) U) :=
            (Submodule.comap_map_eq_of_injective c.injective U).symm
        _ = ⊥ := by rw [hbot, Submodule.comap_bot, LinearEquiv.ker]
    · right
      calc U = Submodule.comap (c : W →ₗ[ZMod p] (Fin 2 ⊕ Fin 2 → ZMod p))
              (Submodule.map (c : W →ₗ[ZMod p] (Fin 2 ⊕ Fin 2 → ZMod p)) U) :=
            (Submodule.comap_map_eq_of_injective c.injective U).symm
        _ = ⊤ := by rw [htop, Submodule.comap_top]
  · intro hirr V hV
    let U : Submodule (ZMod p) W := Submodule.comap (c : W →ₗ[ZMod p] _) V
    have hU : ∀ x ∈ H, ∀ u ∈ U, (x : Module.End (ZMod p) W) u ∈ U := by
      intro x hx u hu
      rw [Submodule.mem_comap] at hu ⊢
      have hv := hV (τ x) (Subgroup.mem_map_of_mem τ.toMonoidHom hx) (c u) hu
      rwa [hcτ x u] at hv
    have hmap : Submodule.map (c : W →ₗ[ZMod p] _) U = V :=
      Submodule.map_comap_eq_self (by rw [LinearEquiv.range]; exact le_top)
    rcases hirr U hU with hbot | htop
    · left
      rw [← hmap, hbot, Submodule.map_bot]
    · right
      rw [← hmap, htop, Submodule.map_top, LinearEquiv.range]

theorem isExtNotation_of_perfect_of_central {X : Type} [Group X] [Finite X]
    (hperf : Group.IsPerfect X) {N : Subgroup X} [N.Normal] (hN : N ≤ Subgroup.center X)
    (hNne : N ≠ ⊥) (hNcard : Nat.card N = 2) {A : Type} [Group A] (e : X ⧸ N ≃* A) :
    IsExtNotation (fun B _ => Nonempty (B ≃* A)) (fun B _ => Nat.card B = 2) X := by
  refine ⟨N, inferInstance, ?_, ⟨e⟩, ?_⟩
  · simpa using hNcard
  · rintro ⟨H, hH, hinf, hsup⟩
    haveI : H.Normal := hH
    have hle : commutator X ≤ H := by
      rw [commutator_def, Subgroup.commutator_le]
      intro x _ y _
      obtain ⟨n₁, hn₁, h₁, hh₁, rfl⟩ :=
        (Subgroup.mem_sup_of_normal_left (s := N) (t := H)).mp
          (by rw [hsup]; exact Subgroup.mem_top x)
      obtain ⟨n₂, hn₂, h₂, hh₂, rfl⟩ :=
        (Subgroup.mem_sup_of_normal_left (s := N) (t := H)).mp
          (by rw [hsup]; exact Subgroup.mem_top y)
      have hx : n₁ * h₁ = h₁ * n₁ :=
        (Subgroup.mem_center_iff.mp (hN hn₁) h₁).symm
      have hy : n₂ * h₂ = h₂ * n₂ :=
        (Subgroup.mem_center_iff.mp (hN hn₂) h₂).symm
      rw [hx, hy, CFSG.GroupTheory.PerfectCover.commutatorElement_mul_mul_of_mem_center
        (hN hn₁) (hN hn₂)]
      exact Subgroup.commutator_le_self H (Subgroup.commutator_mem_commutator hh₁ hh₂)
    rw [Group.IsPerfect.commutator_eq_top] at hle
    have hHtop : H = ⊤ := top_le_iff.mp hle
    apply hNne
    rw [← hinf, hHtop, inf_top_eq]

private theorem card_sl_two_zmod_five : Nat.card (SL(2, ZMod 5)) = 120 := by
  rw [Matrix.card_SL_field, Fin.prod_univ_two]
  norm_num

private theorem card_sl_two_nine : Nat.card (SL(2, GaloisField 3 2)) = 720 := by
  letI : Fintype (GaloisField 3 2) := Fintype.ofFinite _
  have hK : Fintype.card (GaloisField 3 2) = 9 := by
    rw [← Nat.card_eq_fintype_card, GaloisField.card 3 2 (by norm_num)]
    norm_num
  rw [Matrix.card_SL_field, Fin.prod_univ_two, hK]
  norm_num

theorem isExtNotation_sl_two_nine :
    IsExtNotation (fun B _ => Nonempty (B ≃* alternatingGroup (Fin 6)))
      (fun B _ => Nat.card B = 2) (SL(2, GaloisField 3 2)) := by
  letI : Fintype (GaloisField 3 2) := Fintype.ofFinite _
  have hK : Nat.card (GaloisField 3 2) = 9 := by
    rw [GaloisField.card 3 2 (by norm_num)]
    norm_num
  have hodd : Odd (Nat.card (GaloisField 3 2)) := by rw [hK]; norm_num
  have hperf : Group.IsPerfect (SL(2, GaloisField 3 2)) :=
    CFSG.ClassicalInvolution.sl2_isPerfect (by rw [hK]; norm_num)
  have hcent : Nat.card (Subgroup.center (SL(2, GaloisField 3 2))) = 2 :=
    CFSG.ClassicalInvolution.sl2_natCard_center hodd
  obtain ⟨e⟩ :=
    CFSG.Adapters.CatalogueFieldBridges.nonempty_psl2_nine_mulEquiv_alternating_six hK
  exact isExtNotation_of_perfect_of_central hperf le_rfl (by
    intro h
    rw [h, Subgroup.card_bot] at hcent
    omega) hcent e

private theorem sl2Diag_neg_one_image {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2)
    {G : Subgroup (GL (Fin 2 ⊕ Fin 2) (ZMod p))}
    (hirr : IsIrreducibleOn G) (e : G ≃* SL(2, GaloisField p 2)) :
    (G.subtype.comp e.symm.toMonoidHom) (sl2Diag (-1)) = -1 := by
  letI : Fintype (GaloisField p 2) := Fintype.ofFinite _
  have hK : ringChar (GaloisField p 2) ≠ 2 := by
    rw [ringChar.eq (GaloisField p 2) p]
    exact hp2
  let ι : SL(2, GaloisField p 2) →* GL (Fin 2 ⊕ Fin 2) (ZMod p) :=
    G.subtype.comp e.symm.toMonoidHom
  have hιi : Function.Injective ι := fun a b h =>
    e.symm.injective (Subtype.ext h)
  refine eq_neg_one_of_commute hirr (fun g hg => ?_) ?_ ?_
  · have hg' : ι (e ⟨g, hg⟩) = g := by
      change ((e.symm (e ⟨g, hg⟩) : G) : GL (Fin 2 ⊕ Fin 2) (ZMod p)) = g
      rw [MulEquiv.symm_apply_apply]
    rw [← hg', ← map_mul, ← map_mul, (sl2Diag_neg_one_commute (e ⟨g, hg⟩)).eq]
  · rw [← map_mul, ← sl2Diag_mul, neg_one_mul, neg_neg, sl2Diag_one, map_one]
  · intro h1
    rw [← map_one ι] at h1
    have h2 := hιi h1
    rw [← sl2Diag_one] at h2
    have h3 := congrArg Units.val (sl2Diag_injective h2)
    rw [Units.val_neg, Units.val_one] at h3
    exact Ring.neg_one_ne_one_of_char_ne_two hK h3

theorem neg_one_mem_of_sl2 {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2)
    {G : Subgroup (GL (Fin 2 ⊕ Fin 2) (ZMod p))}
    (hirr : IsIrreducibleOn G) (e : G ≃* SL(2, GaloisField p 2)) :
    (-1 : GL (Fin 2 ⊕ Fin 2) (ZMod p)) ∈ G := by
  rw [← sl2Diag_neg_one_image hp2 hirr e]
  exact (e.symm (sl2Diag (-1))).2

private theorem exists_nonsquare_unit {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2) :
    ∃ μ : (GaloisField p 2)ˣ, μ ^ (p ^ 2 / 2) = -1 := by
  letI : Fintype (GaloisField p 2) := Fintype.ofFinite _
  have hK : ringChar (GaloisField p 2) ≠ 2 := by
    rw [ringChar.eq (GaloisField p 2) p]
    exact hp2
  have hKcard : Fintype.card (GaloisField p 2) = p ^ 2 := by
    rw [← Nat.card_eq_fintype_card, GaloisField.card p 2 (by norm_num)]
  obtain ⟨lam, hlam⟩ := FiniteField.exists_nonsquare hK
  have hlam0 : lam ≠ 0 := by
    rintro rfl
    exact hlam ⟨0, (mul_zero 0).symm⟩
  have hlamN : lam ^ (p ^ 2 / 2) = -1 := by
    rcases FiniteField.pow_dichotomy hK hlam0 with h1 | h1
    · exact absurd ((FiniteField.isSquare_iff hK hlam0).2 h1) hlam
    · rwa [hKcard] at h1
  refine ⟨Units.mk0 lam hlam0, Units.ext ?_⟩
  rw [Units.val_pow_eq_pow_val, Units.val_mk0, hlamN, Units.val_neg, Units.val_one]

private theorem sl2_upper_elemAbelian {p : ℕ} [Fact p.Prime]
    {G : Subgroup (GL (Fin 2 ⊕ Fin 2) (ZMod p))}
    {ι : SL(2, GaloisField p 2) →* GL (Fin 2 ⊕ Fin 2) (ZMod p)}
    (hιi : Function.Injective ι) (hιP : ∀ s, ι s ∈ G) :
    ∃ F : Subgroup (GL (Fin 2 ⊕ Fin 2) (ZMod p)),
      F = (ι.comp (sl2UpperHom (GaloisField p 2))).range ∧ F ≤ G ∧ IsPGroup p F ∧
      ¬ IsCyclic F ∧ F ≠ ⊥ ∧ CFSG.Open.IsElemAbelian p F ∧ Nat.card F = p ^ 2 := by
  letI : Fintype (GaloisField p 2) := Fintype.ofFinite _
  have hA : Nat.card (Multiplicative (GaloisField p 2)) = p ^ 2 := by
    change Nat.card (GaloisField p 2) = p ^ 2
    rw [GaloisField.card p 2 (by norm_num)]
  have hAq : ∀ a : Multiplicative (GaloisField p 2), a ^ p = 1 := by
    intro a
    apply Multiplicative.toAdd.injective
    rw [toAdd_pow, toAdd_one, nsmul_eq_mul, CharP.cast_eq_zero (GaloisField p 2) p, zero_mul]
  have hUi : Function.Injective (ι.comp (sl2UpperHom (GaloisField p 2))) := by
    intro a b hab
    rw [MonoidHom.comp_apply, MonoidHom.comp_apply] at hab
    exact sl2UpperHom_injective (hιi hab)
  obtain ⟨hFq, hFc, hF1⟩ := isPGroup_not_isCyclic_range hUi hA hAq
  let F : Subgroup (GL (Fin 2 ⊕ Fin 2) (ZMod p)) :=
    (ι.comp (sl2UpperHom (GaloisField p 2))).range
  have hFG : F ≤ G := by
    rintro _ ⟨c, rfl⟩
    exact hιP _
  have hFelem : CFSG.Open.IsElemAbelian p F := by
    have htop : CFSG.Open.IsElemAbelian p
        (⊤ : Subgroup (Multiplicative (GaloisField p 2))) := by
      refine ⟨isMulCommutative_iff.mpr fun a b => mul_comm a b, fun x _ => hAq x⟩
    have hmap := htop.map (ι.comp (sl2UpperHom (GaloisField p 2)))
    rwa [Subgroup.map_top] at hmap
  have hFcard : Nat.card F = p ^ 2 := by
    rw [← hA]
    exact (Nat.card_congr (MonoidHom.ofInjective hUi).toEquiv).symm
  exact ⟨F, rfl, hFG, hFq, hFc, hF1, hFelem, hFcard⟩

private theorem sl2_normalizer_element {p : ℕ} [Fact p.Prime]
    {G : Subgroup (GL (Fin 2 ⊕ Fin 2) (ZMod p))}
    {ι : SL(2, GaloisField p 2) →* GL (Fin 2 ⊕ Fin 2) (ZMod p)}
    {μ : (GaloisField p 2)ˣ} (hμN : μ ^ (p ^ 2 / 2) = -1)
    (hz : ι (sl2Diag (-1)) = -1) :
    ι (sl2Diag μ) ∈ Subgroup.normalizer
        ((ι.comp (sl2UpperHom (GaloisField p 2))).range :
          Set (GL (Fin 2 ⊕ Fin 2) (ZMod p))) ∧
      ι (sl2Diag μ) ^ (p ^ 2 / 2) = -1 := by
  have hhN : ι (sl2Diag μ) ^ (p ^ 2 / 2) = -1 := by
    rw [← map_pow, ← sl2DiagHom_apply, ← map_pow, hμN, sl2DiagHom_apply, hz]
  have hconjF : ∀ (ν : (GaloisField p 2)ˣ) (c : GaloisField p 2),
      ι (sl2Diag ν) * ι (sl2Upper c) * (ι (sl2Diag ν))⁻¹ ∈
        (ι.comp (sl2UpperHom (GaloisField p 2))).range := by
    intro ν c
    refine ⟨Multiplicative.ofAdd ((ν : GaloisField p 2) ^ 2 * c), ?_⟩
    rw [MonoidHom.comp_apply, sl2UpperHom_apply, toAdd_ofAdd, ← sl2Diag_conj_upper, map_mul,
      map_mul, map_inv]
  have hinvd : (sl2Diag μ)⁻¹ = sl2Diag μ⁻¹ := by
    rw [← sl2DiagHom_apply, ← sl2DiagHom_apply, map_inv]
  refine ⟨?_, hhN⟩
  rw [Subgroup.mem_normalizer_iff]
  intro g
  constructor
  · rintro ⟨c, rfl⟩
    exact hconjF μ (Multiplicative.toAdd c)
  · rintro ⟨c, hc⟩
    have hc' : ι (sl2Upper (Multiplicative.toAdd c)) =
        ι (sl2Diag μ) * g * (ι (sl2Diag μ))⁻¹ := hc
    have hg : g = ι (sl2Diag μ⁻¹) * ι (sl2Upper (Multiplicative.toAdd c)) *
        (ι (sl2Diag μ⁻¹))⁻¹ := by
      rw [hc', ← hinvd, map_inv, inv_inv]
      group
    rw [hg]
    exact hconjF μ⁻¹ (Multiplicative.toAdd c)

theorem exists_pgroup_of_sl2 {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2)
    {G : Subgroup (GL (Fin 2 ⊕ Fin 2) (ZMod p))}
    (hGS : G ≤ CFSG.Open.StatedSp 2 (ZMod p)) (hirr : IsIrreducibleOn G)
    (e : G ≃* SL(2, GaloisField p 2)) :
    ∃ F : Subgroup (GL (Fin 2 ⊕ Fin 2) (ZMod p)), F ≤ G ∧ IsPGroup p F ∧ ¬ IsCyclic F ∧
      F ≠ ⊥ ∧ CFSG.Open.IsElemAbelian p F ∧ Nat.card F = p ^ 2 ∧
      ∃ h ∈ G, h ∈ Subgroup.normalizer (F : Set (GL (Fin 2 ⊕ Fin 2) (ZMod p))) ∧
        h ^ (p ^ 2 / 2) = -1 := by
  letI : Fintype (GaloisField p 2) := Fintype.ofFinite _
  let ι : SL(2, GaloisField p 2) →* GL (Fin 2 ⊕ Fin 2) (ZMod p) :=
    G.subtype.comp e.symm.toMonoidHom
  have hιi : Function.Injective ι := fun a b h =>
    e.symm.injective (Subtype.ext h)
  have hιP : ∀ s, ι s ∈ G := fun s => (e.symm s).2
  have hz : ι (sl2Diag (-1)) = -1 := sl2Diag_neg_one_image hp2 hirr e
  obtain ⟨μ, hμN⟩ := exists_nonsquare_unit hp2
  obtain ⟨F, hF, hFG, hFq, hFc, hF1, hFelem, hFcard⟩ :=
    sl2_upper_elemAbelian (p := p) (ι := ι) hιi hιP
  obtain ⟨hhF, hhN⟩ := sl2_normalizer_element (G := G) (μ := μ) hμN hz
  refine ⟨F, hFG, hFq, hFc, hF1, hFelem, hFcard, ι (sl2Diag μ), hιP _, ?_, hhN⟩
  rw [hF]
  exact hhF

theorem exists_isotropicPlane_of_sl2 {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2)
    {G : Subgroup (GL (Fin 2 ⊕ Fin 2) (ZMod p))}
    (hGS : G ≤ CFSG.Open.StatedSp 2 (ZMod p)) (hirr : IsIrreducibleOn G)
    (e : G ≃* SL(2, GaloisField p 2)) :
    (-1 : GL (Fin 2 ⊕ Fin 2) (ZMod p)) ∈ G ∧
      ∃ F : Subgroup (GL (Fin 2 ⊕ Fin 2) (ZMod p)), F ≤ G ∧ IsPGroup p F ∧ ¬ IsCyclic F ∧
        CFSG.Open.IsElemAbelian p F ∧ Nat.card F = p ^ 2 ∧
        ∃ W : Submodule (ZMod p) (Fin 2 ⊕ Fin 2 → ZMod p),
          Module.finrank (ZMod p) W = 2 ∧
          (∀ v ∈ W, ∀ w ∈ W, CFSG.RankThree.SubgroupLists.spForm 2 (ZMod p) v w = 0) ∧
          ∀ f ∈ F, ∀ w ∈ W, (f : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod p)) *ᵥ w = w := by
  obtain ⟨F, hFG, hFq, hFc, hF1, hFelem, hFcard, h, hhG, hhn, hh⟩ :=
    exists_pgroup_of_sl2 hp2 hGS hirr e
  obtain ⟨W, hWcard, hWi, hFW⟩ :=
    exists_flag hp2 (hFG.trans hGS) hFq hF1 (hGS hhG) hhn hh
  have hW2 : Module.finrank (ZMod p) W = 2 := by
    have h := Module.natCard_eq_pow_finrank (K := ZMod p) (V := W)
    rw [hWcard, Nat.card_zmod] at h
    exact Nat.pow_right_injective (Fact.out : p.Prime).two_le h.symm
  exact ⟨neg_one_mem_of_sl2 hp2 hirr e, F, hFG, hFq, hFc, hFelem, hFcard, W, hW2, hWi, hFW⟩

theorem pCore_eq_bot_of_irreducible {p : ℕ} [Fact p.Prime] {W : Type} [AddCommGroup W]
    [Module (ZMod p) W] [Finite W] {H : Subgroup (Module.End (ZMod p) W)ˣ}
    (hirr : ∀ U : Submodule (ZMod p) W,
      (∀ x ∈ H, ∀ u ∈ U, (x : Module.End (ZMod p) W) u ∈ U) → U = ⊥ ∨ U = ⊤) :
    CFSG.pCore p ↥H = ⊥ := by
  let e : (Module.End (ZMod p) W)ˣ ≃* (W ≃ₗ[ZMod p] W) :=
    LinearMap.GeneralLinearGroup.generalLinearEquiv (ZMod p) W
  let ρ : ↥H →* (W ≃ₗ[ZMod p] W) := e.toMonoidHom.comp H.subtype
  have hρ : Function.Injective ρ := e.injective.comp H.subtype_injective
  refine CFSG.GroupTheory.CoprimeActionSupport.FaithfulIrreduciblePCoreTrivial.pCore_eq_bot
    (p := p) (G := ↥H) (V := W) ρ hρ ?_
  intro U hU
  exact hirr U fun x hx u hu => hU ⟨x, hx⟩ u hu

theorem neg_one_mem_of_mem_map {p : ℕ} [Fact p.Prime] {W : Type} [AddCommGroup W]
    [Module (ZMod p) W] {c : W ≃ₗ[ZMod p] (Fin 2 ⊕ Fin 2 → ZMod p)}
    {τ : (Module.End (ZMod p) W)ˣ ≃* GL (Fin 2 ⊕ Fin 2) (ZMod p)}
    (hτc : ∀ (x : (Module.End (ZMod p) W)ˣ) (v : W),
      (τ x : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod p)) *ᵥ c v =
        c ((x : Module.End (ZMod p) W) v))
    {H : Subgroup (Module.End (ZMod p) W)ˣ}
    (hneg : (-1 : GL (Fin 2 ⊕ Fin 2) (ZMod p)) ∈ H.map τ.toMonoidHom) :
    (-1 : (Module.End (ZMod p) W)ˣ) ∈ H := by
  obtain ⟨h, hh, hτh⟩ := Subgroup.mem_map.mp hneg
  have hhneg : h = -1 := by
    apply Units.ext
    apply LinearMap.ext
    intro v
    apply c.injective
    have hτh' : (τ h : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod p)) = -1 :=
      congrArg Units.val hτh
    rw [← hτc h v, hτh', Matrix.neg_mulVec, Matrix.one_mulVec,
      show (((-1 : (Module.End (ZMod p) W)ˣ) : Module.End (ZMod p) W) v) = -v from by simp,
      map_neg]
  rwa [hhneg] at hh

theorem hasIsotropicPlaneGroup_of_data {p : ℕ} [Fact p.Prime] {W : Type} [AddCommGroup W]
    [Module (ZMod p) W] {B : LinearMap.BilinForm (ZMod p) W}
    {H : Subgroup (Module.End (ZMod p) W)ˣ}
    {c : W ≃ₗ[ZMod p] (Fin 2 ⊕ Fin 2 → ZMod p)}
    {τ : (Module.End (ZMod p) W)ˣ ≃* GL (Fin 2 ⊕ Fin 2) (ZMod p)}
    (hspB : ∀ u v : W, CFSG.RankThree.SubgroupLists.spForm 2 (ZMod p) (c u) (c v) = B u v)
    (hτc : ∀ (x : (Module.End (ZMod p) W)ˣ) (v : W),
      (τ x : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod p)) *ᵥ c v =
        c ((x : Module.End (ZMod p) W) v))
    (hneg : (-1 : GL (Fin 2 ⊕ Fin 2) (ZMod p)) ∈ H.map τ.toMonoidHom)
    {F : Subgroup (GL (Fin 2 ⊕ Fin 2) (ZMod p))} (hFG : F ≤ H.map τ.toMonoidHom)
    (hFelem : CFSG.Open.IsElemAbelian p F) (hFcard : Nat.card F = p ^ 2)
    {W' : Submodule (ZMod p) (Fin 2 ⊕ Fin 2 → ZMod p)}
    (hW'fin : Module.finrank (ZMod p) W' = 2)
    (hW'i : ∀ v ∈ W', ∀ w ∈ W', CFSG.RankThree.SubgroupLists.spForm 2 (ZMod p) v w = 0)
    (hFW' : ∀ f ∈ F, ∀ w ∈ W', (f : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod p)) *ᵥ w = w) :
    HasIsotropicPlaneGroup p B H := by
  have hnegH : (-1 : (Module.End (ZMod p) W)ˣ) ∈ H := neg_one_mem_of_mem_map hτc hneg
  let E : Subgroup (Module.End (ZMod p) W)ˣ := F.comap τ.toMonoidHom
  have hEH : E ≤ H := by
    intro x hx
    have hxG : τ x ∈ H.map τ.toMonoidHom := hFG (Subgroup.mem_comap.mp hx)
    obtain ⟨y, hy, hxy⟩ := Subgroup.mem_map.mp hxG
    rwa [← τ.injective hxy]
  have hEelem : CFSG.Open.IsElemAbelian p E := by
    refine ⟨?_, ?_⟩
    · refine isMulCommutative_iff.mpr fun a b => ?_
      have ha : τ (a : (Module.End (ZMod p) W)ˣ) ∈ F := Subgroup.mem_comap.mp a.2
      have hb : τ (b : (Module.End (ZMod p) W)ˣ) ∈ F := Subgroup.mem_comap.mp b.2
      have hcomm := (isMulCommutative_iff.mp hFelem.1)
        (⟨τ (a : (Module.End (ZMod p) W)ˣ), ha⟩ : F)
        (⟨τ (b : (Module.End (ZMod p) W)ˣ), hb⟩ : F)
      apply Subtype.ext
      exact τ.injective (by
        change τ ((a : (Module.End (ZMod p) W)ˣ) * (b : (Module.End (ZMod p) W)ˣ)) =
          τ ((b : (Module.End (ZMod p) W)ˣ) * (a : (Module.End (ZMod p) W)ˣ))
        rw [map_mul, map_mul]
        exact congrArg (fun y : F => (y : GL (Fin 2 ⊕ Fin 2) (ZMod p))) hcomm)
    · intro x hx
      have hx' : τ (x : (Module.End (ZMod p) W)ˣ) ∈ F := Subgroup.mem_comap.mp hx
      change ((x : (Module.End (ZMod p) W)ˣ) ^ p = 1)
      exact τ.injective (by
        rw [map_pow, map_one]
        exact hFelem.2 (τ (x : (Module.End (ZMod p) W)ˣ)) hx')
  have hEcard : Nat.card E = p ^ 2 := by
    have hEF : E.map τ.toMonoidHom = F :=
      Subgroup.map_comap_eq_self_of_surjective τ.surjective F
    rw [← hFcard, ← hEF, Subgroup.card_map_of_injective τ.injective]
  let π : Submodule (ZMod p) W := W'.comap (c : W →ₗ[ZMod p] (Fin 2 ⊕ Fin 2 → ZMod p))
  have hπfin : Module.finrank (ZMod p) π = 2 := by
    change Module.finrank (ZMod p)
      (Submodule.comap (c : W →ₗ[ZMod p] (Fin 2 ⊕ Fin 2 → ZMod p)) W') = 2
    rw [Submodule.comap_equiv_eq_map_symm c W', LinearEquiv.finrank_map_eq, hW'fin]
  have hπi : ∀ u ∈ π, ∀ v ∈ π, B u v = 0 := by
    intro u hu v hv
    rw [← hspB u v]
    exact hW'i (c u) (Submodule.mem_comap.mp hu) (c v) (Submodule.mem_comap.mp hv)
  have hπfix : ∀ e ∈ E, ∀ u ∈ π, (e : Module.End (ZMod p) W) u = u := by
    intro e he u hu
    apply c.injective
    rw [← hτc e u]
    exact hFW' (τ e) (Subgroup.mem_comap.mp he) (c u) (Submodule.mem_comap.mp hu)
  exact ⟨hnegH, E, hEH, hEelem, hEcard, π, hπfin, hπi, hπfix⟩

private theorem eq_five_of_dvd_120 {p : ℕ} (hp : p.Prime) (h5 : 5 ≤ p) (h : p ∣ 120) : p = 5 := by
  have h120 : (120 : ℕ) = 2 ^ 3 * (3 * 5) := by norm_num
  rw [h120] at h
  rcases (Nat.Prime.dvd_mul hp).mp h with h2 | h35
  · have hp2 : p = 2 :=
      (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp (hp.dvd_of_dvd_pow h2)
    omega
  · rcases (Nat.Prime.dvd_mul hp).mp h35 with h3 | h5'
    · have hp3 : p = 3 :=
        (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp h3
      omega
    · exact (Nat.prime_dvd_prime_iff_eq hp (by norm_num : Nat.Prime 5)).mp h5'

private theorem eq_five_of_dvd_720 {p : ℕ} (hp : p.Prime) (h5 : 5 ≤ p) (h : p ∣ 720) : p = 5 := by
  have h720 : (720 : ℕ) = 2 ^ 4 * (3 ^ 2 * 5) := by norm_num
  rw [h720] at h
  rcases (Nat.Prime.dvd_mul hp).mp h with h2 | h35
  · have hp2 : p = 2 :=
      (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp (hp.dvd_of_dvd_pow h2)
    omega
  · rcases (Nat.Prime.dvd_mul hp).mp h35 with h3 | h5'
    · have hp3 : p = 3 :=
        (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp (hp.dvd_of_dvd_pow h3)
      omega
    · exact (Nat.prime_dvd_prime_iff_eq hp (by norm_num : Nat.Prime 5)).mp h5'

private theorem sixThreeOneList_of_isSLType {p : ℕ} {Y : Type} [Group Y]
    (h : IsSLType 2 (ZMod p) Y) : SixThreeOneList p Y :=
  Or.inl (Or.inl h)

private theorem sixThreeOneList_of_sl2_five {p : ℕ} [Fact p.Prime] {Y G : Type} [Group Y]
    [Group G] (hp5 : 5 ≤ p) (eY : Y ≃* G) (hpdvdG : p ∣ Nat.card G)
    (hSL5 : Nonempty (G ≃* SL(2, ZMod 5))) : SixThreeOneList p Y := by
  have hcardG : Nat.card G = 120 := by
    rw [← card_sl_two_zmod_five]
    exact Nat.card_congr hSL5.some.toEquiv
  have hp120 : p ∣ 120 := by
    rw [← hcardG]
    exact hpdvdG
  have hp5' : p = 5 := eq_five_of_dvd_120 Fact.out hp5 hp120
  subst hp5'
  exact Or.inl (Or.inl ⟨eY.trans hSL5.some⟩)

private theorem sixThreeOneList_of_sl2_nine {p : ℕ} [Fact p.Prime] {Y G : Type} [Group Y]
    [Group G] (hp5 : 5 ≤ p) (eY : Y ≃* G) (hpdvdG : p ∣ Nat.card G)
    (hSL9 : Nonempty (G ≃* SL(2, GaloisField 3 2))) : SixThreeOneList p Y := by
  have hcardG : Nat.card G = 720 := by
    rw [← card_sl_two_nine]
    exact Nat.card_congr hSL9.some.toEquiv
  have hp720 : p ∣ 720 := by
    rw [← hcardG]
    exact hpdvdG
  have hp5' : p = 5 := eq_five_of_dvd_720 Fact.out hp5 hp720
  have eY9 : Y ≃* SL(2, GaloisField 3 2) := eY.trans hSL9.some
  refine Or.inr (Or.inr (Or.inl ⟨hp5', Or.inl ?_⟩))
  exact IsExtNotation.of_mulEquiv (fun _ _ _ _ f ⟨g⟩ => ⟨f.symm.trans g⟩)
    (fun _ _ _ _ f hf => (Nat.card_congr f.toEquiv).symm.trans hf) eY9.symm
    isExtNotation_sl_two_nine

private theorem sixThreeOneList_of_a7 {p : ℕ} [Fact p.Prime] {Y G : Type} [Group Y]
    [Group G] [Finite G] (eY : Y ≃* G) (hqG : CFSG.IsQuasisimple G) (hp7 : p = 7)
    (hZcard : Nat.card (Subgroup.center G) = 2)
    (hZA7 : Nonempty (G ⧸ Subgroup.center G ≃* alternatingGroup (Fin 7))) :
    SixThreeOneList p Y := by
  have hbase : IsExtNotation (fun B _ => Nonempty (B ≃* alternatingGroup (Fin 7)))
      (fun B _ => Nat.card B = 2) G := by
    refine isExtNotation_of_perfect_of_central hqG.1 (le_refl _) ?_ hZcard hZA7.some
    intro hbot
    rw [hbot, Subgroup.card_bot] at hZcard
    omega
  refine Or.inr (Or.inl ⟨hp7, ?_⟩)
  exact IsExtNotation.of_mulEquiv (fun _ _ _ _ f ⟨g⟩ => ⟨f.symm.trans g⟩)
    (fun _ _ _ _ f hf => (Nat.card_congr f.toEquiv).symm.trans hf) eY.symm hbase

section Certificates


theorem sixThreeOneList_or_isotropic_of_quasisimple {p : ℕ} [Fact p.Prime] (hp5 : 5 ≤ p)
    {W : Type} [AddCommGroup W] [Module (ZMod p) W] [Module.Finite (ZMod p) W]
    (hW : Module.finrank (ZMod p) W = 4) (B : LinearMap.BilinForm (ZMod p) W)
