theorem p_eq_three_or_five_of_le (hI : NineTenInputs) (h : NineSettingGen G M p Q H E 2)
    (hH2 : H ∈ H2Fam M Q) (hp : p ∉ sigmaM G M) (hrk : 5 < p → CFSG.Open.pRank p H ≤ 2)
    (hL0 : pLayerIn p H ≠ ⊥) (hL : pLayerIn p H ≤ M) : p = 3 ∨ p = 5 := by
  have hU : NineNineOne M p :=
    CFSG.LocalAnalysis.AGL81TheoremCD.Section14.nineNineOneInput_holds G M Q H E p h hp
  obtain ⟨P, -, hP, hH2P, hPH, -, hNP⟩ := h.exists_sylow_nineSetting hH2 hp hU
  by_cases hQN : starImg p H P ≤ compNormalizer (StarGroup p H)
  · by_cases hY : centralizer (CFSG.layer (StarGroup p H) : Set (StarGroup p H)) ≤
        starImg p H M
    · exact absurd hY (not_centralizer_le_of_le hI.sevenOne.three hI hP hH2P hp hPH hNP hQN hL)
    · obtain ⟨-, J, hJ, -, -, -, -⟩ :=
        single_component hI.sevenOne.twoOne (kFactCenterRankTwo_holds
            CFSG.Milestones.cl_lit_griess_schur_multipliers_all_models_statement
            CFSG.Alternating.Multipliers.schurAlternatingMultiplierInput
            CFSG.RankThree.PartTwo.Sec4.Census.Karpilovsky.Coordinator.sporadicMultipliers_holds)
          kFactCenterRankFive_holds hP hH2P hp (two_le_pRank_pCore hP hU hPH hY) hL0
      exact prime_eq_three_or_five hI.sevenOne.twoOne hP hH2P hp hrk
        (two_le_pRank_pCore hP hU hPH hY) hJ
  · exact Or.inl (three_components hI.sevenOne.twoOne hP hH2P hp hQN).1

theorem false_of_thirteen_of_pRank_le_two (hI : NineTenInputs) (h67 : SixSeven)
    (h : NineSettingGen G M 13 Q H E 2) (hH2 : H ∈ H2Fam M Q) (hp : 13 ∉ sigmaM G M)
    (hL : pLayerIn 13 H ≤ M) (hrk : CFSG.Open.pRank 13 H ≤ 2) {R : Subgroup G}
    (hR : CFSG.ABGLocalTools.IsSylowOf 3 R (CFSG.Open.relPPrimeCore 13 H)) {y : G}
    (hyK : y ∈ kSub 13 M H) (hyN : y ∈ normalizer (R : Set G))
    (hyp : ∃ n : ℕ, y ^ 13 ^ n = 1) (hyC : y ∉ centralizer (R : Set G)) : False := by
  have hL0 : pLayerIn 13 H = ⊥ := by
    by_contra hne
    rcases p_eq_three_or_five_of_le hI h hH2 hp (fun _ => hrk) hne hL with h3 | h5
    · omega
    · omega
  have hU : NineNineOne M 13 :=
    CFSG.LocalAnalysis.AGL81TheoremCD.Section14.nineNineOneInput_holds G M Q H E 13 h hp
  have hK := kStar_commutator_eq_thirteen h hH2 hp hL0 hU hrk
  obtain ⟨T, hT⟩ := id hR
  have hR3 : IsPGroup 3 ↥R := hT ▸ T.isPGroup'.map (CFSG.Open.relPPrimeCore 13 H).subtype
  have hRO : R ≤ CFSG.Open.relPPrimeCore 13 H := by
    intro x hx
    rw [← hT] at hx
    obtain ⟨s, -, rfl⟩ := Subgroup.mem_map.mp hx
    exact s.2
  have hrk3 : CFSG.Open.pRank 3 R ≤ 3 :=
    (CFSG.SectionRank.pRank_mono (p := 3) (by norm_num) hRO).trans
      (h.pRank_relPPrimeCore_le_three Nat.prime_three (by norm_num))
  rcases omegaOnePSub_of_pElement hR3 hrk3 (by norm_num : Nat.Prime 13) (by norm_num)
      (by norm_num) hyN hyp hyC with ⟨-, hDab, hD27, hDR, hyD⟩ | ⟨h5, -⟩
  · rcases h.exists_index_thirteen_or_dvd h67 hL hR hDab hD27 hDR hyK hyN hyp hyD with
      ⟨N, hN, hNi⟩ | h27
    · exact index_ne_prime_of_commutator_eq_top
        (commutator_eq_top_of_commutator_eq hK) N (by norm_num) hNi
    · exact not_dvd_card_kStar_thirteen h hH2 hp hL0 hrk h27
  · omega
theorem nineTwelveTwoKer (hI : NineTenInputs) (h67 : SixSeven)
    (hres : NineTwelveThirteenRankThree) (h : NineSettingGen G M p Q H E 2)
    (hH2 : H ∈ H2Fam M Q) (hp : p ∉ sigmaM G M) (hL : pLayerIn p H ≤ M) {R : Subgroup G}
    (hR : CFSG.ABGLocalTools.IsSylowOf 3 R (CFSG.Open.relPPrimeCore p H)) :
    kSub p M H = (kSub p M H ⊓ centralizer (R : Set G)) ⊔
        CFSG.Open.relPPrimeCore p (kSub p M H) ∨
      (p = 13 ∧
        kSub p M H = (kSub p M H ⊓ centralizer (R : Set G)) ⊔ kerIn M (kSub p M H)) ∨
      (p = 5 ∧ CFSG.IsExtraspecialPGroup 3 ↥(omegaOnePSub 3 R) ∧
        Nat.card ↥(omegaOnePSub 3 R) = 3 ^ 5 ∧ Monoid.exponent ↥(omegaOnePSub 3 R) = 3) := by
  by_cases hc : ∀ y ∈ kSub p M H, y ∈ normalizer (R : Set G) →
      (∃ n : ℕ, y ^ p ^ n = 1) → y ∈ centralizer (R : Set G)
  · exact Or.inl (h.kSub_eq_of_forall_mem_centralizer hL hR hc)
  push Not at hc
  obtain ⟨y, hyK, hyN, hyp, hyC⟩ := hc
  obtain ⟨T, hT⟩ := id hR
  have hR3 : IsPGroup 3 ↥R := hT ▸ T.isPGroup'.map (CFSG.Open.relPPrimeCore p H).subtype
  have hRO : R ≤ CFSG.Open.relPPrimeCore p H := by
    intro x hx
    rw [← hT] at hx
    obtain ⟨s, -, rfl⟩ := Subgroup.mem_map.mp hx
    exact s.2
  have hp3 : p ≠ 3 := fun hp3eq => false_of_p_eq_three hp3eq hR3 hRO hyC
  have hrk : CFSG.Open.pRank 3 R ≤ 3 :=
    (CFSG.SectionRank.pRank_mono (p := 3) (by norm_num) hRO).trans
      (h.pRank_relPPrimeCore_le_three Nat.prime_three (by norm_num))
  rcases omegaOnePSub_of_pElement hR3 hrk h.prime h.ne_two hp3 hyN hyp hyC with
    ⟨hp13, _⟩ | ⟨hp5, hE, hcard, hexp⟩
  · subst hp13
    have hrk13 : CFSG.Open.pRank 13 H ≤ 3 := (h.pRank_le_of_mem_H2Fam hH2 hp).1
    by_cases hle2 : CFSG.Open.pRank 13 H ≤ 2
    · exact (h.false_of_thirteen_of_pRank_le_two hI h67 hH2 hp hL hle2 hR hyK hyN hyp hyC).elim
    · have heq3 : CFSG.Open.pRank 13 H = 3 := by omega
      exact Or.inr (Or.inl ⟨rfl, hres G M Q H E h hH2 hp hL heq3 R hR
        ⟨y, hyK, hyN, hyp, hyC⟩⟩)
  · subst hp5
    exact Or.inr (Or.inr ⟨rfl, hE, hcard, hexp⟩)

end

