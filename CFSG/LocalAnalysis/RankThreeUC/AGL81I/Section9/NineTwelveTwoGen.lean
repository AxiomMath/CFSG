private theorem relPPrimeCore_eq_map_self {p : ℕ} (hp : p.Prime) (C : Subgroup G) :
    CFSG.Open.relPPrimeCore p C =
      (CFSG.RankThreeCoreUniqueness.Helpers.primeComplementCore (G := ↥C) p).map C.subtype := by
  haveI : Fact p.Prime := ⟨hp⟩
  apply le_antisymm
  · refine sSup_le fun N hN => ?_
    obtain ⟨hNC, hNn, hNc⟩ := hN
    have h1 : N.subgroupOf C ≤
        CFSG.RankThreeCoreUniqueness.Helpers.primeComplementCore (G := ↥C) p := by
      refine le_sSup ⟨hNn, ?_⟩
      rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hNC).toEquiv]
      exact hNc
    calc N = (N.subgroupOf C).map C.subtype := (Subgroup.map_subgroupOf_eq_of_le hNC).symm
      _ ≤ _ := Subgroup.map_mono h1
  · refine le_sSup ⟨?_, ?_, ?_⟩
    · rintro _ ⟨y, -, rfl⟩
      exact y.2
    · show (Subgroup.comap C.subtype
        ((CFSG.RankThreeCoreUniqueness.Helpers.primeComplementCore (G := ↥C) p).map
          C.subtype)).Normal
      rw [Subgroup.comap_map_eq_self_of_injective C.subtype_injective]
      infer_instance
    · rw [Subgroup.card_map_of_injective C.subtype_injective]
      exact CFSG.RankThreeCoreUniqueness.Helpers.primeComplementCore_coprime p

private theorem relPPrimeCore_le_self (p : ℕ) (C : Subgroup G) :
    CFSG.Open.relPPrimeCore p C ≤ C :=
  sSup_le fun _ hN => hN.1

private theorem relPPrimeCore_normal_self {p : ℕ} (hp : p.Prime) (C : Subgroup G) :
    ((CFSG.Open.relPPrimeCore p C).subgroupOf C).Normal := by
  rw [relPPrimeCore_eq_map_self hp C]
  show (Subgroup.comap C.subtype
    ((CFSG.RankThreeCoreUniqueness.Helpers.primeComplementCore (G := ↥C) p).map
      C.subtype)).Normal
  rw [Subgroup.comap_map_eq_self_of_injective C.subtype_injective]
  infer_instance

private theorem kSub_generator_le (h : NineSettingGen G M p Q H E k) (hL : pLayerIn p H ≤ M) :
    kSub p M H ≤ closure {x : G | x ∈ kSub p M H ∧ ∃ n : ℕ, x ^ p ^ n = 1} := by
  rw [kSub_of_le hL]
  refine sSup_le ?_
  rintro Y ⟨hYH, hYcard⟩ y hy
  have hyK : y ∈ sSup {Y' : Subgroup G | Y' ≤ H ∧ Nat.card Y' = p} :=
    (le_sSup (show Y ∈ {Y' : Subgroup G | Y' ≤ H ∧ Nat.card Y' = p} from
      ⟨hYH, hYcard⟩)) hy
  refine Subgroup.subset_closure ⟨hyK, ?_⟩
  refine ⟨1, ?_⟩
  have h1 : y ^ Nat.card Y = 1 :=
    orderOf_dvd_iff_pow_eq_one.mp (Subgroup.orderOf_dvd_natCard Y hy)
  rw [pow_one, ← hYcard]
  exact h1

theorem kSub_le_closure_pElem_sup (h : NineSettingGen G M p Q H E k) (hL : pLayerIn p H ≤ M)
    {R : Subgroup G} (hR : CFSG.ABGLocalTools.IsSylowOf 3 R (CFSG.Open.relPPrimeCore p H)) :
    kSub p M H ≤ closure {y : G | y ∈ kSub p M H ∧ y ∈ normalizer (R : Set G) ∧
        ∃ n : ℕ, y ^ p ^ n = 1} ⊔ (kSub p M H ⊓ CFSG.Open.relPPrimeCore p H) := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact le_closure_pElem_sup_inf (p := p) (q := 3) (H := H) h.prime (kSub_le p M H)
    (kSub_normal_of_le hL) (relPPrimeCore_le_self p H) (relPPrimeCore_normal_self h.prime H)
    hR (kSub_generator_le h hL)

theorem kSub_eq_of_forall_mem_centralizer (h : NineSettingGen G M p Q H E k) (hL : pLayerIn p H ≤ M)
    {R : Subgroup G} (hR : CFSG.ABGLocalTools.IsSylowOf 3 R (CFSG.Open.relPPrimeCore p H))
    (hcent : ∀ y ∈ kSub p M H, y ∈ normalizer (R : Set G) → (∃ n : ℕ, y ^ p ^ n = 1) →
      y ∈ centralizer (R : Set G)) :
    kSub p M H = (kSub p M H ⊓ centralizer (R : Set G)) ⊔
      CFSG.Open.relPPrimeCore p (kSub p M H) := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  apply le_antisymm
  · have h1 := le_inf_centralizer_sup_inf (p := p) (q := 3) (H := H) h.prime (kSub_le p M H)
      (kSub_normal_of_le hL) (relPPrimeCore_le_self p H) (relPPrimeCore_normal_self h.prime H)
      hR (kSub_generator_le h hL) hcent
    exact h1.trans (sup_le_sup_left
      (inf_relPPrimeCore_le_relPPrimeCore h.prime (kSub_le p M H) (kSub_normal_of_le hL)) _)
  · exact sup_le inf_le_left (relPPrimeCore_le_self p (kSub p M H))

private theorem card_SL_three_zmod_three [Fact (Nat.Prime 3)] :
    Nat.card (Matrix.SpecialLinearGroup (Fin 3) (ZMod 3)) = 5616 := by
  rw [Matrix.card_SL_field (n := 3) (𝔽 := ZMod 3), ZMod.card, Fin.prod_univ_three]
  norm_num

private theorem starImg_mono' {A B : Subgroup G} (hAB : A ≤ B) :
    starImg p H A ≤ starImg p H B :=
  Subgroup.map_mono (Subgroup.comap_mono hAB)

theorem kStar_eq_starImg_closure (h : NineSettingGen G M p Q H E k) (hL : pLayerIn p H ≤ M)
    {R : Subgroup G} (hR : CFSG.ABGLocalTools.IsSylowOf 3 R (CFSG.Open.relPPrimeCore p H)) :
    kStar p M H = starImg p H (closure {y : G | y ∈ kSub p M H ∧
      y ∈ normalizer (R : Set G) ∧ ∃ n : ℕ, y ^ p ^ n = 1}) := by
  set S : Set G := {y : G | y ∈ kSub p M H ∧ y ∈ normalizer (R : Set G) ∧
    ∃ n : ℕ, y ^ p ^ n = 1}
  have hK1K : closure S ≤ kSub p M H := by
    rw [Subgroup.closure_le]
    exact fun y hy => hy.1
  have hK1H : closure S ≤ H := hK1K.trans (kSub_le p M H)
  have hinf : ((kSub p M H ⊓ CFSG.Open.relPPrimeCore p H).subgroupOf H).map
      (QuotientGroup.mk' (CFSG.RankThreeCoreUniqueness.Helpers.primeComplementCore (G := ↥H) p))
      = ⊥ := by
    rw [Subgroup.map_eq_bot_iff]
    intro x hx
    rw [MonoidHom.mem_ker]
    have hxO : (x : G) ∈ CFSG.Open.relPPrimeCore p H := (Subgroup.mem_subgroupOf.mp hx).2
    rw [relPPrimeCore_eq_map_self h.prime H] at hxO
    obtain ⟨b, hb, hbx⟩ := Subgroup.mem_map.mp hxO
    exact (QuotientGroup.eq_one_iff x).mpr (Subtype.ext hbx ▸ hb)
  have hsup : starImg p H (closure S ⊔ (kSub p M H ⊓ CFSG.Open.relPPrimeCore p H))
      = starImg p H (closure S) := by
    simp only [starImg]
    rw [Subgroup.subgroupOf_sup hK1H (inf_le_left.trans (kSub_le p M H)), Subgroup.map_sup,
      hinf, sup_bot_eq]
  rw [kStar_eq_starImg]
  refine le_antisymm ?_ (starImg_mono' hK1K)
  calc starImg p H (kSub p M H)
      ≤ starImg p H (closure S ⊔ (kSub p M H ⊓ CFSG.Open.relPPrimeCore p H)) :=
        starImg_mono' (kSub_le_closure_pElem_sup h hL hR)
    _ = starImg p H (closure S) := hsup

private theorem exists_normal_index_of_card_range_eq_thirteen {R : Subgroup G} {S : Set G}
    {φ : ↥(closure S) →* MulAut ↥(omegaOnePSub 3 R)} (h13 : Nat.Prime 13)
    (hK1H : closure S ≤ H) (hK : kStar 13 M H = starImg 13 H (closure S))
    (hcard : Nat.card φ.range = 13) :
    ∃ N : Subgroup ↥(kStar 13 M H), N.Normal ∧ N.index = 13 := by
  have hφO : ∀ a : ↥(closure S), (a : G) ∈ CFSG.Open.relPPrimeCore 13 H → φ a = 1 := by
    intro a haO
    have h2 : orderOf (φ a) ∣ Nat.card (CFSG.Open.relPPrimeCore 13 H) := by
      calc orderOf (φ a) ∣ orderOf a := orderOf_map_dvd φ a
        _ = orderOf (a : G) := (Subgroup.orderOf_coe a).symm
        _ ∣ Nat.card (CFSG.Open.relPPrimeCore 13 H) :=
            Subgroup.orderOf_dvd_natCard _ haO
    have h1 : orderOf (φ a) ∣ 13 := hcard ▸
      Subgroup.orderOf_dvd_natCard φ.range (show φ a ∈ φ.range from ⟨a, rfl⟩)
    have hcop : Nat.Coprime 13 (Nat.card (CFSG.Open.relPPrimeCore 13 H)) :=
      coprime_card_relPPrimeCore h13 H
    exact orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_coprimes hcop h1 h2)
  obtain ⟨N, hN, hNi⟩ := exists_normal_index_eq_of_forall h13 hK1H hK.symm φ hφO
  exact ⟨N, hN, hNi.trans hcard⟩

private theorem dvd_card_kStar_of_isSLType {R : Subgroup G} {S : Set G}
    {φ : ↥(closure S) →* MulAut ↥(omegaOnePSub 3 R)} (h13 : Nat.Prime 13)
    (hK1H : closure S ≤ H) (hK1R : closure S ≤ normalizer (R : Set G))
    (hR : CFSG.ABGLocalTools.IsSylowOf 3 R (CFSG.Open.relPPrimeCore 13 H))
    (hDR : omegaOnePSub 3 R ≤ centralizer (R : Set G))
    (hφ : ∀ (a : ↥(closure S)) (d : ↥(omegaOnePSub 3 R)),
      ((φ a d : ↥(omegaOnePSub 3 R)) : G) = (a : G) * d * (a : G)⁻¹)
    (hK : kStar 13 M H = starImg 13 H (closure S))
    (hSL : IsSLType 3 (ZMod 3) ↥φ.range) :
    27 ∣ Nat.card (kStar 13 M H) := by
  obtain ⟨e⟩ := hSL
  have hcardSL : Nat.card φ.range = 5616 :=
    (Nat.card_congr e.toEquiv).trans card_SL_three_zmod_three
  have h27 : 27 ∣ Nat.card φ.range := by rw [hcardSL]; norm_num
  have hφR : ∀ a : ↥(closure S), (a : G) ∈ R → φ a = 1 := by
    intro a haR
    refine MulEquiv.ext fun d => Subtype.ext ?_
    show ((φ a d : ↥(omegaOnePSub 3 R)) : G) = (d : G)
    rw [hφ a d]
    have hcomm : (a : G) * (d : G) = (d : G) * (a : G) :=
      Subgroup.mem_centralizer_iff.mp (hDR d.2) (a : G) haR
    rw [hcomm, mul_inv_cancel_right]
  have h3 : ¬ 3 ∣ Nat.card
      (((CFSG.Open.relPPrimeCore 13 H).subgroupOf (closure S)).map φ) :=
    not_dvd_card_map_of_isSylowOf hR hK1R φ hφR
  have hcop : Nat.Coprime 27 (Nat.card
      (((CFSG.Open.relPPrimeCore 13 H).subgroupOf (closure S)).map φ)) := by
    have hcop3 : Nat.Coprime 3 (Nat.card
        (((CFSG.Open.relPPrimeCore 13 H).subgroupOf (closure S)).map φ)) :=
      (Nat.prime_three.coprime_iff_not_dvd).mpr h3
    simpa using Nat.Coprime.pow_left 3 hcop3
  have hdvd : Nat.card φ.range ∣
      Nat.card (((CFSG.Open.relPPrimeCore 13 H).subgroupOf (closure S)).map φ) *
        Nat.card (starImg 13 H (closure S)) :=
    card_range_dvd_card_map_mul_card_starImg h13 hK1H φ
  have hfin : 27 ∣ Nat.card (starImg 13 H (closure S)) :=
    hcop.dvd_of_dvd_mul_left (h27.trans hdvd)
  rw [hK]
  exact hfin

theorem exists_index_thirteen_or_dvd (h67 : SixSeven) (h : NineSettingGen G M 13 Q H E k)
    (hL : pLayerIn 13 H ≤ M) {R : Subgroup G}
    (hR : CFSG.ABGLocalTools.IsSylowOf 3 R (CFSG.Open.relPPrimeCore 13 H))
    (hDab : CFSG.Open.IsElemAbelian 3 (omegaOnePSub 3 R))
    (hD27 : Nat.card (omegaOnePSub 3 R) = 27)
    (hDR : omegaOnePSub 3 R ≤ centralizer (R : Set G)) {y : G} (hyK : y ∈ kSub 13 M H)
    (hyN : y ∈ normalizer (R : Set G)) (hyp : ∃ n : ℕ, y ^ 13 ^ n = 1)
    (hyD : ∃ d ∈ omegaOnePSub 3 R, y * d * y⁻¹ ≠ d) :
    (∃ N : Subgroup ↥(kStar 13 M H), N.Normal ∧ N.index = 13) ∨
      27 ∣ Nat.card (kStar 13 M H) := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have h13 : Nat.Prime 13 := by norm_num
  haveI : Fact (Nat.Prime 13) := ⟨h13⟩
  set S : Set G := {y : G | y ∈ kSub 13 M H ∧ y ∈ normalizer (R : Set G) ∧
    ∃ n : ℕ, y ^ 13 ^ n = 1}
  have hK1K : closure S ≤ kSub 13 M H := by
    rw [Subgroup.closure_le]
    exact fun y hy => hy.1
  have hK1H : closure S ≤ H := hK1K.trans (kSub_le 13 M H)
  have hK1R : closure S ≤ normalizer (R : Set G) := by
    rw [Subgroup.closure_le]
    exact fun y hy => hy.2.1
  have hK1D : closure S ≤ normalizer ((omegaOnePSub 3 R : Subgroup G) : Set G) :=
    hK1R.trans (normalizer_le_normalizer_omegaOnePSub 3 R)
  let φ : ↥(closure S) →* MulAut ↥(omegaOnePSub 3 R) :=
    (omegaOnePSub 3 R).normalizerMonoidHom.comp (Subgroup.inclusion hK1D)
  have hφ : ∀ (a : ↥(closure S)) (d : ↥(omegaOnePSub 3 R)),
      ((φ a d : ↥(omegaOnePSub 3 R)) : G) = (a : G) * d * (a : G)⁻¹ := fun a d =>
    Subgroup.normalizerMonoidHom_apply_apply_coe (omegaOnePSub 3 R)
      (Subgroup.inclusion hK1D a) d
  have hW := card_range_eq_thirteen_or_isSLType h67 hDab hD27 (S := S)
    (fun s hs => hs.2.2) ⟨hyK, hyN, hyp⟩ hyD φ hφ
  have hK : kStar 13 M H = starImg 13 H (closure S) := h.kStar_eq_starImg_closure hL hR
  rcases hW with hcard | hSL
  · exact Or.inl (exists_normal_index_of_card_range_eq_thirteen h13 hK1H hK hcard)
  · exact Or.inr (dvd_card_kStar_of_isSLType h13 hK1H hK1R hR hDR hφ hK hSL)
private theorem not_dvd_card_kStar_thirteen (h : NineSettingGen G M 13 Q H E k)
    (hH2 : H ∈ H2Fam M Q) (hp : 13 ∉ sigmaM G M) (hL0 : pLayerIn 13 H = ⊥)
    (hrkH : CFSG.Open.pRank 13 H ≤ 2) : ¬ 27 ∣ Nat.card (kStar 13 M H) := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have h13 : Nat.Prime 13 := by norm_num
  haveI : Fact (Nat.Prime 13) := ⟨h13⟩
  let X := StarGroup 13 H
  have hC : centralizer (CFSG.pCore 13 X : Set X) ≤ CFSG.pCore 13 X :=
    centralizer_pCore_le_of_layer_eq_bot h13 H ((pLayerIn_eq_bot_iff h13 H).mp hL0)
  have hrk : CFSG.Open.pRank 13 (CFSG.pCore 13 X) ≤ 2 := by
    have h1 : CFSG.Open.pRank 13 (CFSG.pCore 13 X) ≤ CFSG.Open.pRank 13 (⊤ : Subgroup X) :=
      CFSG.SectionRank.pRank_mono (p := 13) (by norm_num) le_top
    have h2 : CFSG.Open.pRank 13 (⊤ : Subgroup X) = CFSG.Open.pRank 13 H := by
      rw [← starImg_self 13 H, pRank_starImg_eq h13 le_rfl]
    rw [h2] at h1
    exact h1.trans hrkH
  intro h27
  obtain ⟨K, hKcard⟩ := Sylow.exists_subgroup_card_pow_prime (G := ↥(kStar 13 M H)) 3
    (n := 3) (by simpa [show (3 : ℕ) ^ 3 = 27 by norm_num] using h27)
  let S : Subgroup X := K.map (kStar 13 M H).subtype
  have hScard : Nat.card S = 27 := by
    rw [show S = K.map (kStar 13 M H).subtype from rfl,
      Subgroup.card_map_of_injective (K := K) (f := (kStar 13 M H).subtype)
        (kStar 13 M H).subtype_injective, hKcard]
    norm_num
  have hS : Nat.Coprime (Nat.card S) 13 := by rw [hScard]; norm_num
  have hGL : Nat.card S ∣ Nat.card (GL (Fin 2) (ZMod 13)) :=
    card_dvd_card_GL_two_of_coprime h13 (by norm_num) hC hrk (S := S) hS
  rw [hScard, CFSG.SectionRank.Ccomm.card_GL_zmod 2] at hGL
  norm_num [Fin.prod_univ_two] at hGL

private theorem kStar_commutator_eq_thirteen (h : NineSettingGen G M 13 Q H E 2)
    (hH2 : H ∈ H2Fam M Q) (hp : 13 ∉ sigmaM G M) (hL : pLayerIn 13 H = ⊥)
    (hU : NineNineOne M 13) (hrkH : CFSG.Open.pRank 13 H ≤ 2) :
    ⁅kStar 13 M H, kStar 13 M H⁆ = kStar 13 M H := by
  have hLM : pLayerIn 13 H ≤ M := by
    rw [hL]
    exact bot_le
  have hcent := centralizer_pCore_le_of_layer_eq_bot h.prime H
    ((pLayerIn_eq_bot_iff h.prime H).mp hL)
  have hrk : CFSG.Open.pRank 13 (⊤ : Subgroup (StarGroup 13 H)) ≤ 2 := by
    rw [← starImg_self 13 H, pRank_starImg_eq h.prime le_rfl]
    exact hrkH
  have hnot : ¬ IsPGroup 13 ↥(kStar 13 M H) := by
    intro hpg
    have hn : (kStar 13 M H).Normal := kStar_normal_of_le hLM
    have hle : kStar 13 M H ≤ CFSG.pCore 13 (StarGroup 13 H) := le_sSup ⟨hn, hpg⟩
    have hEk : E ≤ kSub 13 M H :=
      le_kSub_of_le h.prime hLM (h.stdE.2.1.trans h.Q_le_H) h.stdE.2.2.1.2
    have hstar : starImg 13 H E ≤ kStar 13 M H := by
      rw [kStar_eq_starImg 13 M H]
      exact Subgroup.map_mono (Subgroup.comap_mono hEk)
    exact h.not_starImg_le_pCore hp hU (hstar.trans hle)
  have hV : ¬ IsPGroup 13 ↥(closure {x : StarGroup 13 H | orderOf x = 13}) := by
    rw [← kStar_eq_closure_of_le h.prime hLM]
    exact hnot
  have hperf := (rankTwo_structure_of_sixSixOne (X := StarGroup 13 H) sixSixOneRank_holds h.prime
    (by norm_num) hcent hrk hV).2.2
  rwa [← kStar_eq_closure_of_le h.prime hLM] at hperf

private theorem prime_eq_three_or_five (h72 : KFactOmegaNotCentral)
    (h : NineSettingGen G M p Q H E k)
    (hH2 : H ∈ H2Fam M Q) (hp : p ∉ sigmaM G M)
    (hrk : 5 < p → CFSG.Open.pRank p H ≤ 2)
    (hR : 2 ≤ CFSG.Open.pRank p (CFSG.pCore p (StarGroup p H)))
    {J : Subgroup (StarGroup p H)} (hJ : CFSG.IsComponent J) : p = 3 ∨ p = 5 := by
  haveI : Fact p.Prime := ⟨h.prime⟩
  obtain ⟨A, hAle, hAab, hAcard⟩ :=
    CFSG.SectionRank.exists_pRank h.prime.one_lt (CFSG.pCore p (StarGroup p H))
  have hAcentJ : A ≤ centralizer (J : Set (StarGroup p H)) :=
    (hAle.trans (pCore_le_centralizer_layer h.prime H)).trans
      (Subgroup.centralizer_le (CFSG.LocalCores.component_le_layer hJ))
  obtain ⟨e, heJ, hord, hnce⟩ := h.exists_noncentral h72 hJ
  have hle := add_card_le_pRank_of_components h.prime hAab hAcard
    ({J} : Finset (Subgroup (StarGroup p H))) (by
      intro C hC
      rw [Finset.mem_singleton] at hC
      subst hC
      exact ⟨hJ, hAcentJ, e, heJ, hord, hnce⟩)
  rw [Finset.card_singleton] at hle
  have h3 : 3 ≤ CFSG.Open.pRank p (⊤ : Subgroup (StarGroup p H)) := by omega
  have hp_le5 : p ≤ 5 := by
    by_contra hnot
    push Not at hnot
    have hHle2 : CFSG.Open.pRank p H ≤ 2 := hrk hnot
    have htop : CFSG.Open.pRank p (⊤ : Subgroup (StarGroup p H)) ≤ 2 := by
      rw [← starImg_self p H, pRank_starImg_eq h.prime le_rfl]
      exact hHle2
    omega
  have hp2 : 2 ≤ p := h.prime.two_le
  interval_cases p
  · exact absurd rfl h.ne_two
  · exact Or.inl rfl
  · exact absurd h.prime (by norm_num)
  · exact Or.inr rfl

private theorem index_ne_prime_of_commutator_eq_top {X : Type*} [Group X]
    (hX : commutator X = ⊤) (N : Subgroup X) [N.Normal] {p : ℕ} (hp : p.Prime) :
    N.index ≠ p := by
  intro hidx
  have : Fact p.Prime := ⟨hp⟩
  have hcyc : IsCyclic (X ⧸ N) := isCyclic_of_prime_card (p := p) (by
    rw [← Subgroup.index_eq_card, hidx])
  have hle : commutator X ≤ N := by
    rw [commutator_def, Subgroup.commutator_le]
    intro a _ b _
    rw [← QuotientGroup.eq_one_iff, ← QuotientGroup.mk'_apply, map_commutatorElement,
      commutatorElement_eq_one_iff_commute]
    exact mul_comm' _ _
  rw [hX, top_le_iff] at hle
  rw [hle, Subgroup.index_top] at hidx
  exact hp.one_lt.ne hidx

private theorem commutator_eq_top_of_commutator_eq {X : Type*} [Group X] {K : Subgroup X}
    (hK : ⁅K, K⁆ = K) : commutator K = ⊤ := by
  have htop : (⊤ : Subgroup K).map K.subtype = K := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  apply Subgroup.map_injective K.subtype_injective
  rw [commutator_def, Subgroup.map_commutator, htop, hK]

private theorem false_of_p_eq_three {p : ℕ} {R : Subgroup G} (hp3 : p = 3)
    (hR3 : IsPGroup 3 ↥R) (hRO : R ≤ CFSG.Open.relPPrimeCore p H)
    {y : G} (hyC : y ∉ centralizer (R : Set G)) : False := by
  subst hp3
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨m, hm⟩ := IsPGroup.iff_card.mp hR3
  rcases Nat.eq_zero_or_pos m with hm0 | hmpos
  · have hcardR : Nat.card ↥R = 1 := by rw [hm, hm0, pow_zero]
    haveI : Subsingleton ↥R := (Nat.card_eq_one_iff_unique.mp hcardR).1
    exact hyC (Subgroup.mem_centralizer_iff.mpr fun r hr => by
      have h1 : (⟨r, hr⟩ : ↥R) = (1 : ↥R) := Subsingleton.elim _ _
      have hr1 : r = 1 := by simpa using congrArg Subtype.val h1
      subst hr1
      simp)
  · have h3dvdR : 3 ∣ Nat.card ↥R := by
      rw [hm]
      exact pow_dvd_pow 3 (show 1 ≤ m by omega)
    have h3dvd := dvd_trans h3dvdR (Subgroup.card_dvd_of_le hRO)
    have hcop : Nat.Coprime 3 (Nat.card (CFSG.Open.relPPrimeCore 3 H)) :=
      coprime_card_relPPrimeCore Nat.prime_three H
    exact (Nat.prime_three.coprime_iff_not_dvd.mp hcop) h3dvd

end

