theorem K372Setting.goal_of_spor (hSpM : SporadicMultipliers) (hK : K315Spor)
    (hOut : SporadicOuterLeTwo) (hBr : SporadicBridges) (hTab : SporadicP2Table)
    (h : K372Setting X p K E S) {s : TauCeti.SporadicName}
    (hφ : Nonempty (↥K ⧸ Subgroup.center ↥K ≃* (TauCeti.CFSGIndex.sporadic s).Group)) :
    K372Goal p K S := by
  obtain ⟨φ⟩ := hφ
  intro hSC
  have h5 := h.five_le
  have hp2 : p ≠ 2 := by omega
  have hZ : Subgroup.center ↥K = ⊥ := by
    have : Fact p.Prime := ⟨h.prime⟩
    rcases h.isPGroup_center.card_eq_or_dvd with h1 | hz
    · exact Subgroup.eq_bot_of_card_eq _ h1
    have h12 : ∀ t : TauCeti.SporadicName, sporadicMultiplierOrder t ∣ 2 ^ 2 * 3 := by
      intro t
      cases t <;> decide
    rcases (Nat.Prime.dvd_mul h.prime).mp ((hz.trans
        (GL83.I243.CoverList.card_center_dvd_sporadic hSpM h.quasi φ)).trans (h12 s)) with h2 | h3
    · have := (Nat.prime_dvd_prime_iff_eq h.prime Nat.prime_two).mp (h.prime.dvd_of_dvd_pow h2)
      omega
    · have := (Nat.prime_dvd_prime_iff_eq h.prime Nat.prime_three).mp h3
      omega
  have ψ : ↥K ≃* (TauCeti.CFSGIndex.sporadic s).Group :=
    ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm.trans φ
  by_cases hFi : s = .Fi22 ∧ p = 5
  · obtain ⟨rfl, rfl⟩ := hFi
    exact ⟨rfl, ⟨ψ⟩⟩
  exfalso
  have : Finite (TauCeti.CFSGIndex.sporadic s).Group := Finite.of_equiv _ ψ.toEquiv
  have : IsSimpleGroup (↥K ⧸ Subgroup.center ↥K) := h.quasi.2.1
  have hsim : IsSimpleGroup (TauCeti.CFSGIndex.sporadic s).Group := φ.symm.isSimpleGroup
  have hZT : Subgroup.center (TauCeti.CFSGIndex.sporadic s).Group = ⊥ := by
    rw [← Subgroup.map_center_eq ψ, hZ, Subgroup.map_bot]
  obtain ⟨Ē, R, hconf⟩ := h.exists_sporPlaneConf ψ hSC
  by_cases hs : s ∈ sporadicsThm3
  · exact not_sporPlaneConf_of_planeGenOrExc hZT h.prime hp2
      (planeGenOrExc_catalog (hK s hs p h.prime hp2 Ē R hconf) h.prime hp2) hconf
