theorem exists_inner_nearOffender_of_psu {V : Type} [CommGroup V] [Finite V]
    (hV : ∀ v : V, v * v = 1) {L E : Subgroup (MulAut V)} (hirr : X1.IsIrrOn L)
    (hperf : Group.IsPerfect ↥L) {m f : ℕ} (hm : 4 ≤ m)
    (hmodel : StatedClassicalModel (↥L ⧸ Subgroup.center ↥L) .PSU m 2 f)
    (hEN : E ≤ Subgroup.normalizer (L : Set (MulAut V))) (hE1 : E ≠ ⊥)
    (hEel : IsElemAbelian2 E) (hEq : IsQuadratic E)
    (hoff : Nat.card V ≤ Nat.card E * Nat.card (fixV E)) :
    ∃ A : Subgroup (MulAut V), A ≤ L ∧ A ≠ ⊥ ∧ IsElemAbelian2 A ∧ IsQuadratic A ∧
      Nat.card V ≤ 2 * Nat.card A * Nat.card (fixV A) := by
  classical
  have hEA : Nat.card E ≤ 2 * Nat.card ↥(E ⊓ L) :=
    card_le_two_mul_card_inf_of_psu hV hirr hperf hm hmodel hEN hEel
  by_cases hA : E ⊓ L = ⊥
  ·
    rw [hA, Subgroup.card_bot, mul_one] at hEA
    obtain ⟨⟨σ, hσE⟩, hσ1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hE1
    have hσ1' : σ ≠ 1 := fun h => hσ1 (Subtype.ext h)
    have hσsq : σ ^ 2 = 1 := hEel.2 σ hσE
    have hσ2 : σ * σ = 1 := by rw [← pow_two]; exact hσsq
    have hσord : orderOf σ = 2 := orderOf_eq_prime hσsq hσ1'
    have hEσ : Subgroup.zpowers σ = E := by
      refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hσE) ?_
      rw [Nat.card_zpowers, hσord]
      exact hEA
    have hσV : Nat.card V ≤ 2 * Nat.card (fixV (Subgroup.zpowers σ)) := by
      rw [hEσ]
      calc Nat.card V ≤ Nat.card E * Nat.card (fixV E) := hoff
        _ ≤ 2 * Nat.card (fixV E) := Nat.mul_le_mul_right _ hEA
    have hσL : σ ∉ Subgroup.centralizer (L : Set (MulAut V)) := by
      intro hσC
      have hmem : σ ∈ E ⊓ Subgroup.centralizer (L : Set (MulAut V)) := ⟨hσE, hσC⟩
      rw [inf_centralizer_eq_bot_of_isIrrOn hV hirr hEel, Subgroup.mem_bot] at hmem
      exact hσ1' hmem
    obtain ⟨t, htL, ht1, ht2, htV⟩ :=
      exists_involution_of_transvection hV hirr hperf (hEN hσE) hσ2 hσV hσL
    have htsq : t ^ 2 = 1 := by rw [pow_two]; exact ht2
    refine ⟨Subgroup.zpowers t, Subgroup.zpowers_le.mpr htL, ?_,
      StabLat.isElemAbelian2_zpowers htsq,
      isQuadratic_zpowers (fun v => by rw [pow_two]; exact hV v) htsq, ?_⟩
    · intro h
      exact ht1 (Subgroup.zpowers_eq_bot.mp h)
    · rw [Nat.card_zpowers, orderOf_eq_prime htsq ht1]
      simpa [← mul_assoc] using htV
  ·
    refine ⟨E ⊓ L, inf_le_right, hA, ⟨fun a ha b hb => hEel.1 a ha.1 b hb.1,
      fun a ha => hEel.2 a ha.1⟩, ?_, ?_⟩
    · have h1 : commV (E ⊓ L) ≤ commV E := by
        apply Subgroup.closure_mono
        rintro _ ⟨x, hx, v, rfl⟩
        exact ⟨x, hx.1, v, rfl⟩
      exact (h1.trans hEq).trans (B1.fixV_le_fixV inf_le_left)
    · have hfix : Nat.card (fixV E) ≤ Nat.card (fixV (E ⊓ L)) :=
        Subgroup.card_le_of_le (B1.fixV_le_fixV inf_le_left)
      calc Nat.card V ≤ Nat.card E * Nat.card (fixV E) := hoff
        _ ≤ (2 * Nat.card ↥(E ⊓ L)) * Nat.card (fixV (E ⊓ L)) := Nat.mul_le_mul hEA hfix

theorem psuNoOffenderAt_of_scalar_core
    {m f r : ℕ} (hm : 4 ≤ m)
    (hr : r.Prime) (hr2 : r ≠ 2) (hrmq : r ∣ Nat.gcd m (2 ^ f + 1))
    (hcore : 5 ≤ m → ∀ (V : Type) [CommGroup V] [Finite V], (∀ v : V, v * v = 1) →
      ∀ L : Subgroup (MulAut V), X1.IsIrrOn L → Group.IsPerfect ↥L →
      ∀ (K : Type) [Field K] [Finite K], Nat.card K = (2 ^ f) ^ 2 →
      ∀ φ : StatedSU m (2 ^ f) K →* ↥L, Function.Surjective φ →
        φ.ker ≤ (StatedScalars (Fin m) K).subgroupOf (StatedSU m (2 ^ f) K) →
      ∀ (c : Kˣ) (hc : Matrix.GeneralLinearGroup.scalar (Fin m) c ∈ StatedSU m (2 ^ f) K),
        orderOf c = r →
      ∀ A : Subgroup (MulAut V), A ≤ L → A ≠ ⊥ → IsElemAbelian2 A → IsQuadratic A →
        Nat.card V ≤ 2 * Nat.card A * Nat.card (fixV A) → φ ⟨_, hc⟩ ≠ 1) :
    FFO.PSUNoOffenderAt m f r := by
  intro V _ _ hV L E hirr hperf hZ hmodel hEN hE1 hEel hEq
  by_contra hnot
  push Not at hnot
  have hrm : r ∣ m := hrmq.trans (Nat.gcd_dvd_left _ _)
  have hrq : r ∣ 2 ^ f + 1 := hrmq.trans (Nat.gcd_dvd_right _ _)
  have hm5 : 5 ≤ m := by
    by_contra h5
    have h4 : m = 4 := by omega
    rw [h4, show (4 : ℕ) = 2 ^ 2 by norm_num] at hrm
    exact hr2 ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).mp (hr.dvd_of_dvd_pow hrm))
  obtain ⟨A, hAL, hA1, hAel, hAq, hAV⟩ :=
    exists_inner_nearOffender_of_psu hV hirr hperf hm hmodel hEN hE1 hEel hEq hnot
  obtain ⟨K, _, _, φ, c, hc, hK, hφs, hφk, hco, hφ1⟩ :=
    exists_su_cover_scalar_mem_ker hV hirr hperf hr hrm hrq hZ hmodel
  exact hcore hm5 V hV L hirr hperf K hK φ hφs hφk c hc hco A hAL hA1 hAel hAq hAV hφ1

