theorem K37Setting.autIm_le_range_of_l34
    (h : K37Setting X K E S) (hL34 : AGL81C.IsL34Type ↥K)
    (h3 : 3 ∣ Nat.card ↥K) : autIm E K ≤ (MulAut.conj : ↥K →* MulAut ↥K).range := by
  have hOK : GLAPPrimeCore 3 ↥K = ⊥ := h.core
  have hOf : GLAPPrimeCoreOf 3 K = ⊥ := by
    show (GLAPPrimeCore 3 ↥K).map K.subtype = ⊥
    rw [hOK, Subgroup.map_bot]
  have hq : CFSG.Open.IsQuasisimple ↥K := ⟨Group.isPerfect_def.mp h.quasi.1, h.quasi.2.1⟩
  have hGLA : GLAPComponent 3 ⊤ K :=
    CFSG.HardMathSupport.Solomon.Coordinator.i253_glaPComponent_of_subnormal le_top
      (CFSG.Open.IsSubnormal.step le_top (h.normal.subgroupOf ⊤) (CFSG.Open.IsSubnormal.refl ⊤))
      hq h3
  have hbar : CFSG.LocalAnalysis.GLTheoremB.IsLThreeFour (↥K ⧸ GLAPPrimeCore 3 ↥K) ∨
      CFSG.LocalAnalysis.GLTheoremB.IsSLThreeFour (↥K ⧸ GLAPPrimeCore 3 ↥K) := by
    let e0 : ↥K ⧸ GLAPPrimeCore 3 ↥K ≃* ↥K :=
      (QuotientGroup.quotientMulEquivOfEq hOK).trans QuotientGroup.quotientBot
    rcases isLThreeFour_or_isSLThreeFour_of_isL34Type h.quasi h.core hL34 with
      ⟨F, hF, hFf, hF4, ⟨e⟩⟩ | ⟨F, hF, hFf, hF4, ⟨e⟩⟩
    · exact Or.inl ⟨F, hF, hFf, hF4, ⟨e0.trans e⟩⟩
    · exact Or.inr ⟨F, hF, hFf, hF4, ⟨e0.trans e⟩⟩
  rcases CFSG.HardMathSupport.Solomon.UniquenessMaximal.input23_20_proved X ⊤ K E hGLA hbar
    le_top h.elem h.le_normalizer_K with ha | ⟨hinn, -⟩
  · refine absurd (ha.trans ?_) h.not_le
    rw [hOf, sup_bot_eq]
    exact gammaClBelow_le_of_rankThreeGamma_le h.elem (by rw [h.card]; norm_num) le_rfl K
  · rintro _ ⟨b, hb, rfl⟩
    obtain ⟨y, hyK, hy⟩ := hinn b (Subgroup.mem_subgroupOf.mp hb)
    refine MonoidHom.mem_range.mpr ⟨⟨y, hyK⟩, MulEquiv.ext fun z => Subtype.ext ?_⟩
    have h1 := hy z z.2
    rw [hOf, Subgroup.mem_bot, mul_inv_eq_one] at h1
    rw [Subgroup.normalizerMonoidHom_apply_apply_coe, MulAut.conj_apply]
    exact h1.symm

theorem apply_eq_of_conj_mem_normalizer {k : Type} [Field k] (hk : Nat.card k = 4)
    {τ : MulAut (projectiveSL 3 k)} (hτ1 : τ ≠ 1) (hττ : τ * τ = 1) {z : projectiveSL 3 k}
    (hN : MulAut.conj z ∈
      Subgroup.normalizer ((Subgroup.zpowers τ : Subgroup _) : Set (MulAut (projectiveSL 3 k)))) :
    τ z = z := by
  have hc : MulAut.conj z * τ * (MulAut.conj z)⁻¹ = τ := by
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp
      ((Subgroup.mem_normalizer_iff.mp hN τ).mp (Subgroup.mem_zpowers τ))
    have hord : orderOf τ = 2 := orderOf_eq_prime (by rw [sq]; exact hττ) hτ1
    have hτn : τ ^ n = τ ^ (n % 2) := by
      have h1 := zpow_mod_orderOf τ n
      rw [hord] at h1
      exact_mod_cast h1.symm
    rcases Int.emod_two_eq_zero_or_one n with h0 | h1
    · rw [hτn, h0, zpow_zero] at hn
      exact absurd (conj_eq_one_iff.mp hn.symm) hτ1
    · rw [hτn, h1, zpow_one] at hn
      exact hn.symm
  have hcomm : τ * MulAut.conj z * τ⁻¹ = MulAut.conj z := by
    have h1 : MulAut.conj z * τ = τ * MulAut.conj z := mul_inv_eq_iff_eq_mul.mp hc
    rw [← h1, mul_inv_cancel_right]
  rw [mul_mulAutConj_mul_inv] at hcomm
  exact CFSG.RankThree.PartTwo.KFacts.L34.conj_injective hk hcomm

theorem K37Setting.concl_of_l34
    (h : K37Setting X K E S) (hL34 : AGL81C.IsL34Type ↥K)
    (hSC : ¬ S ≤ Subgroup.centralizer (K : Set X)) : K37Concl K S := by
  refine Or.inl ⟨hL34, fun r hr hrd => ?_⟩
  haveI : Fact r.Prime := ⟨hr⟩
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨e⟩ := nonempty_mulEquiv_projSL_quotient_center_of_isL34Type hL34
  have hL3 : CFSG.LocalAnalysis.GLTheoremB.IsLThreeFour (↥K ⧸ Subgroup.center ↥K) :=
    ⟨GaloisField 2 2, inferInstance, inferInstance,
      by rw [GaloisField.card 2 2 (by norm_num)]; norm_num,
      ⟨e.trans (CFSG.PGLModel.projSLEquivStatedProj 3 (GaloisField 2 2))⟩⟩
  obtain ⟨k, _, hk, ⟨φ⟩⟩ := CFSG.HardMathSupport.Solomon.Coordinator.exists_equiv_projectiveSL hL3
  have h3 : 3 ∣ Nat.card ↥K := by
    refine dvd_trans ?_ (Subgroup.card_quotient_dvd_card (Subgroup.center ↥K))
    rw [Nat.card_congr φ.toEquiv, CFSG.RankThree.PartTwo.KFacts.L34.card_projectiveSL hk]
    norm_num
  have hin := h.autIm_le_range_of_l34 hL34 h3
  haveI : Group.IsPerfect ↥K := h.quasi.1
  obtain ⟨Ψ, hΨinj, hΨc⟩ : ∃ Ψ : MulAut ↥K →* MulAut (projectiveSL 3 k), Function.Injective Ψ ∧
      ∀ y : ↥K, Ψ (MulAut.conj y) =
        MulAut.conj (φ (QuotientGroup.mk' (Subgroup.center ↥K) y)) := by
    refine ⟨(MulAut.congr φ).toMonoidHom.comp (centerQuotientHom ↥K),
      (MulAut.congr φ).injective.comp (centerQuotientHom_injective ↥K), fun y => ?_⟩
    have hc : centerQuotientHom ↥K (MulAut.conj y) =
        MulAut.conj (QuotientGroup.mk' (Subgroup.center ↥K) y) := by
      ext x
      obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center ↥K) x
      change onCenterQuotient (MulAut.conj y) (QuotientGroup.mk' (Subgroup.center ↥K) w) = _
      rw [onCenterQuotient_apply_mk, MulAut.conj_apply, MulAut.conj_apply, map_mul, map_mul,
        map_inv]
    change MulAut.congr φ (centerQuotientHom ↥K (MulAut.conj y)) = _
    rw [hc, congr_mulAutConj]
  have hEle : (autIm E K).map Ψ ≤
      (MulAut.conj : projectiveSL 3 k →* MulAut (projectiveSL 3 k)).range := by
    rintro _ ⟨α, hα, rfl⟩
    obtain ⟨y, rfl⟩ := MonoidHom.mem_range.mp (hin hα)
    exact MonoidHom.mem_range.mpr ⟨_, (hΨc y).symm⟩
  obtain ⟨E', hE'⟩ : ∃ E' : Subgroup (projectiveSL 3 k),
      E' = ((autIm E K).map Ψ).comap MulAut.conj := ⟨_, rfl⟩
  obtain ⟨Y, hY⟩ : ∃ Y : Subgroup (MulAut (projectiveSL 3 k)), Y = (autIm S K).map Ψ :=
    ⟨_, rfl⟩
  have hE9 : Nat.card E' = 9 := by
    rw [hE', ← Subgroup.card_map_of_injective
      (CFSG.RankThree.PartTwo.KFacts.L34.conj_injective hk), Subgroup.map_comap_eq_self hEle,
      Subgroup.card_map_of_injective hΨinj, h.card_autIm]
    norm_num
  have hY3 : ¬ 3 ∣ Nat.card Y := by
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    obtain ⟨n, hn⟩ := (isPGroup_autIm (K := K) h.two).exists_card_eq
    rw [hY, Subgroup.card_map_of_injective hΨinj, hn]
    intro h3n
    have := (Nat.prime_dvd_prime_iff_eq Nat.prime_three Nat.prime_two).mp
      (Nat.prime_three.dvd_of_dvd_pow h3n)
    omega
  have hEY : ∀ e ∈ E',
      MulAut.conj e ∈ Subgroup.normalizer (Y : Set (MulAut (projectiveSL 3 k))) := by
    intro e he
    rw [hE', Subgroup.mem_comap] at he
    obtain ⟨_, ⟨b, hb, rfl⟩, hbe⟩ := he
    rw [← hbe, hY]
    exact Subgroup.le_normalizer_map Ψ (Subgroup.mem_map_of_mem Ψ
      (mem_normalizer_autIm b.2 (h.le_normalizer_S (Subgroup.mem_subgroupOf.mp hb))))
  rcases eq_bot_or_eq_zpowers_graphField hk hE9 hY3 hEY with hbot | ⟨τ, hτ, hτ1, hττ, hgf, -⟩
  · rw [hY] at hbot
    exact absurd (le_centralizer_of_autIm_eq_bot h.S_le_normalizer_K
      ((Subgroup.map_eq_bot_iff_of_injective _ hΨinj).mp hbot)) hSC
  have hfix : ∀ y : ↥K, (y : X) ∈ Subgroup.normalizer (S : Set X) →
      τ (φ (QuotientGroup.mk' (Subgroup.center ↥K) y)) =
        φ (QuotientGroup.mk' (Subgroup.center ↥K) y) := by
    intro y hyS
    have hyK : (y : X) ∈ Subgroup.normalizer (K : Set X) := by
      haveI := h.normal
      rw [Subgroup.normalizer_eq_top]
      trivial
    have h1 := mem_normalizer_autIm hyK hyS
    rw [normalizerMonoidHom_of_mem y.2 hyK] at h1
    have h2 := Subgroup.le_normalizer_map Ψ (Subgroup.mem_map_of_mem Ψ h1)
    rw [← hY, hτ, hΨc] at h2
    exact apply_eq_of_conj_mem_normalizer hk hτ1 hττ h2
  have hle : K ⊓ Subgroup.normalizer (S : Set X) ≤ K := inf_le_left
  obtain ⟨g, hg⟩ := exists_prime_orderOf_dvd_card' r hrd
  obtain ⟨y, hy, hyS⟩ : ∃ y : ↥K, orderOf y = r ∧ (y : X) ∈ Subgroup.normalizer (S : Set X) :=
    ⟨Subgroup.inclusion hle g, by rw [orderOf_injective _ (Subgroup.inclusion_injective hle) g, hg],
      (Subgroup.mem_inf.mp g.2).2⟩
  have hz := hfix y hyS
  have hzr : orderOf (φ (QuotientGroup.mk' (Subgroup.center ↥K) y)) ∣ r := by
    rw [← hy]
    exact orderOf_map_dvd (φ.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center ↥K))) y
  rcases (Nat.dvd_prime hr).mp hzr with h1 | hr'
  ·
    refine Or.inr ?_
    have hy1 : QuotientGroup.mk' (Subgroup.center ↥K) y = 1 :=
      φ.injective ((orderOf_eq_one_iff.mp h1).trans (map_one φ).symm)
    have hyZ : y ∈ Subgroup.center ↥K :=
      (QuotientGroup.eq_one_iff (N := Subgroup.center ↥K) y).mp hy1
    obtain ⟨n, hn⟩ := IsPGroup.iff_orderOf.mp h.isPGroup_center ⟨y, hyZ⟩
    rw [Subgroup.orderOf_mk, hy] at hn
    exact (Nat.prime_dvd_prime_iff_eq hr Nat.prime_three).mp (hr.dvd_of_dvd_pow (dvd_of_eq hn))
  ·
    have h72 : orderOf (φ (QuotientGroup.mk' (Subgroup.center ↥K) y)) ∣ 72 := by
      rw [← card_autFixed_of_isGraphField hk hgf]
      have h2 := orderOf_dvd_natCard (⟨_, mem_autFixed.mpr hz⟩ : autFixed τ)
      rwa [Subgroup.orderOf_mk] at h2
    have h72' : r ∣ 2 ^ 3 * 3 ^ 2 := by
      rw [← hr', show (2 : ℕ) ^ 3 * 3 ^ 2 = 72 by norm_num]
      exact h72
    rcases (Nat.Prime.dvd_mul hr).mp h72' with h2 | h3
    · exact Or.inl ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).mp (hr.dvd_of_dvd_pow h2))
    · exact Or.inr ((Nat.prime_dvd_prime_iff_eq hr Nat.prime_three).mp (hr.dvd_of_dvd_pow h3))

