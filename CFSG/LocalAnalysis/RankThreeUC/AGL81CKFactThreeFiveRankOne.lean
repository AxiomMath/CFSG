theorem inf_centralizer_eq_bot_of_not_le_gamma
    {X : Type} [Group X] [Finite X] {K E : Subgroup X}
    (hE : CFSG.Open.IsElemAbelian 3 E) (hK : CFSG.IsComponent K)
    (hnotGamma : ¬ K ≤ CFSG.Open.rankThreeGamma 1 3 E) :
    E ⊓ Subgroup.centralizer (K : Set X) = ⊥ := by
  rw [eq_bot_iff]
  intro e he
  rw [Subgroup.mem_bot]
  by_contra he1
  have heE : e ∈ E := he.1
  have heC : e ∈ Subgroup.centralizer (K : Set X) := he.2
  have hKle : K ≤ Subgroup.centralizer ({e} : Set X) := by
    intro k hk
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact Subgroup.mem_centralizer_iff.mp heC k hk
  exact hnotGamma (hKle.trans
    (CFSG.LocalAnalysis.AGL81TheoremCD.Section15.K35.centralizer_le_gamma hE heE he1))

theorem two_le_pRank_three_alternating_six_quotient
    {Y : Type} [Group Y] [Finite Y] (N : Subgroup Y) [N.Normal]
    (e : Y ⧸ N ≃* alternatingGroup (Fin 6)) :
    2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup Y) := by
  have h2 : 2 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (Y ⧸ N)) := by
    rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv (by norm_num : 1 < 3) e]
    have h2A : 2 ≤ CFSG.pRank 3 (alternatingGroup (Fin 6)) :=
      CFSG.QuasithinUnique.Setup.Family.two_le_pRank_three_of_alternating_six
        (MulEquiv.refl _)
    rwa [CFSG.SectionRank.pRank_eq_open_pRank_top] at h2A
  exact CFSG.GroupTheory.two_le_pRank_of_quotient N Nat.prime_three (by norm_num) h2

theorem center_eq_bot_of_kFactThreeFiveCentral
    (hC : CFSG.LocalAnalysis.AGL81TheoremCD.Section14.KFactThreeFiveCentral)
    {X : Type} [Group X] [Finite X] (hKX : CFSG.Open.IsKGroup X)
    (hO : CFSG.pPrimeCore 3 X = ⊥) (hrankX : CFSG.Open.pRank 3 (⊤ : Subgroup X) ≤ 3)
    {K E : Subgroup X} (hK : CFSG.IsComponent K) (hKrank : CFSG.Open.pRank 3 K = 1)
    (hE : CFSG.Open.IsElemAbelian 3 E) (hEcard : Nat.card E = 9)
    (hEnorm : E ≤ Subgroup.normalizer (K : Set X))
    (hnotGamma : ¬ K ≤ CFSG.Open.rankThreeGamma 1 3 E) :
    Subgroup.center ↥K = ⊥ := by
  by_contra hZne
  have hK2 : CFSG.Open.pRank 3 K ≤ 2 := by omega
  rcases hC X hKX hO hrankX K E hK hZne hK2 hE hEcard hEnorm hnotGamma with hL34 | hA6
  · have hKrank' : CFSG.pRank 3 ↥K = 1 := by
      rw [CFSG.SectionRank.pRank_eq_open_pRank_top,
        ← CFSG.SectionRank.pRank_eq_pRank_top_subgroup (p := 3) K]
      exact hKrank
    exact CFSG.Quasithin.H13.L32A.C.SkPf.pRank_three_ne_one_of_isPSL34
      (isPSL_of_isL34Type hL34) hKrank'
  · obtain ⟨e⟩ := hA6
    have h2 := two_le_pRank_three_alternating_six_quotient (Subgroup.center ↥K) e
    have hKrank' : CFSG.Open.pRank 3 (⊤ : Subgroup ↥K) = 1 := by
      rwa [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup (p := 3) K]
    omega

theorem isSimpleGroup_of_isComponent_center_eq_bot
    {X : Type} [Group X] {K : Subgroup X} (hK : CFSG.IsComponent K)
    (hZ : Subgroup.center ↥K = ⊥) : IsSimpleGroup ↥K := by
  haveI : IsSimpleGroup (↥K ⧸ Subgroup.center ↥K) := hK.1.2.1
  have e : ↥K ≃* (↥K ⧸ Subgroup.center ↥K) :=
    (QuotientGroup.quotientBot (G := ↥K)).symm.trans
      ((QuotientGroup.quotientMulEquivOfEq (G := ↥K) (M := Subgroup.center ↥K) (N := ⊥)
        hZ).symm)
  exact MulEquiv.isSimpleGroup e

theorem exists_not_comm_of_isComponent_center_eq_bot
    {X : Type} [Group X] {K : Subgroup X} (hK : CFSG.IsComponent K)
    (hZ : Subgroup.center ↥K = ⊥) : ∃ a b : ↥K, a * b ≠ b * a := by
  obtain ⟨a, b, hab⟩ := hK.1.2.2
  have e : ↥K ≃* (↥K ⧸ Subgroup.center ↥K) :=
    (QuotientGroup.quotientBot (G := ↥K)).symm.trans
      ((QuotientGroup.quotientMulEquivOfEq (G := ↥K) (M := Subgroup.center ↥K) (N := ⊥)
        hZ).symm)
  refine ⟨e.symm a, e.symm b, fun h => hab ?_⟩
  have := congrArg e h
  simpa using this

theorem isCatalogGroup_of_isComponent_center_eq_bot
    {X : Type} [Group X] (hKX : CFSG.Open.IsKGroup X) {K : Subgroup X}
    (hK : CFSG.IsComponent K) (hZ : Subgroup.center ↥K = ⊥) :
    CFSG.Open.IsCatalogGroup ↥K := by
  haveI : IsSimpleGroup ↥K := isSimpleGroup_of_isComponent_center_eq_bot hK hZ
  exact hKX.isCatalogGroup_of_surjective K
    (exists_not_comm_of_isComponent_center_eq_bot hK hZ) (MonoidHom.id ↥K)
    Function.surjective_id

end CFSG.LocalAnalysis.RankThreeUC.AGL81C

namespace CFSG.LocalAnalysis.RankThreeUC.AGL81C

open CFSG.Open CFSG.RankThreeCoreUniqueness.Helpers CFSG.LocalAnalysis.RankThreeUC.S15 Subgroup
open CFSG.LocalAnalysis.AGL81TheoremCD.Section14
