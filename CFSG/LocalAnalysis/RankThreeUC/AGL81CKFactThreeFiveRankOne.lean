def KFactThreeFiveRankOneJ1Out : Prop :=
  ∀ (K : Type) [Group K] [Finite K], IsSimpleGroup K →
    Nonempty (K ≃* (TauCeti.CFSGIndex.sporadic .J1).Group) →
      ¬ 3 ∣ Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.Outer K)

theorem kFactThreeFiveRankOne_of_inputs
    (hC : CFSG.LocalAnalysis.AGL81TheoremCD.Section14.KFactThreeFiveCentral)
    (hS : CFSG.AGLEmbeddingD2.Tits.MsideParabolicEscape.KFactThreeRankOneSimple)
    (hSeitz : KFactSeitzRankTwo) (hJ1 : KFactThreeFiveRankOneJ1Out) :
    KFactThreeFiveRankOne := by
  intro X _ _ hKX hO hrankX K E hKcomp hKrank hEel hEcard hEnorm hnotGamma
  have hZ : Subgroup.center ↥K = ⊥ :=
    center_eq_bot_of_kFactThreeFiveCentral hC hKX hO hrankX hKcomp hKrank hEel hEcard hEnorm
      hnotGamma
  haveI hKsimple : IsSimpleGroup ↥K := isSimpleGroup_of_isComponent_center_eq_bot hKcomp hZ
  have hnab : ∃ a b : ↥K, a * b ≠ b * a :=
    exists_not_comm_of_isComponent_center_eq_bot hKcomp hZ
  have hcat : CFSG.Open.IsCatalogGroup ↥K :=
    isCatalogGroup_of_isComponent_center_eq_bot hKX hKcomp hZ
  let φ : ↥E →* MulAut ↥K := componentAction hEnorm
  have hinj : Function.Injective φ :=
    componentAction_injective_of_not_le_gamma hEel hKcomp hEnorm hnotGamma
  let E' : Subgroup (MulAut ↥K) := (⊤ : Subgroup ↥E).map φ
  have hE'el : CFSG.Open.IsElemAbelian 3 E' :=
    componentAction_image_isElemAbelian hEnorm hEel
  have hE'card : Nat.card E' = 9 := componentAction_image_card hEnorm hinj hEcard
  obtain ⟨i, hi⟩ := hcat
  have hKrankTop : CFSG.Open.pRank 3 (⊤ : Subgroup ↥K) = 1 := by
    rwa [← CFSG.SectionRank.pRank_eq_pRank_top_subgroup (p := 3) K]
  rcases hS ↥K hKsimple hnab i hi hKrankTop with ⟨d, hfam, he⟩ | hJ | hA5
  · obtain ⟨e⟩ := he
    rcases rankOneLie_generation_or_PSL28 hSeitz hfam e E' hE'el hE'card with hPSL | hgen
    · exact hPSL
    · exact (hnotGamma
        (component_le_gamma_of_closure_fixed hEel hKcomp hEnorm hnotGamma hgen)).elim
  · have hout : ¬ 3 ∣ Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.Outer ↥K) :=
      hJ1 ↥K hKsimple hJ
    haveI : IsElementaryAbelian 3 ↥E' :=
      (CFSG.SectionRank.isElementaryAbelian_iff_isElemAbelian 3 E').2 hE'el
    have hKrankG : CFSG.pRank 3 ↥K ≤ 1 := by
      rw [CFSG.SectionRank.pRank_eq_open_pRank_top]
      omega
    have hle := CFSG.RankThree.ThinCatalog.card_le_three_of_not_three_dvd_outer
      hZ hout hKrankG E' inferInstance
    omega
  · have hout : ¬ 3 ∣ Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.Outer ↥K) := by
      intro h3
      obtain ⟨e⟩ := hA5
      have hdvd : Nat.card (CFSG.ComponentClassification.OuterAutomorphisms.Outer ↥K) ∣ 2 :=
        CFSG.ComponentClassification.CatalogueSchreierAlternating.outer_card_dvd_two_of_equiv_outside_six
          (Or.inl rfl) e
      have := Nat.le_of_dvd (by norm_num) (h3.trans hdvd)
      omega
    haveI : IsElementaryAbelian 3 ↥E' :=
      (CFSG.SectionRank.isElementaryAbelian_iff_isElemAbelian 3 E').2 hE'el
    have hKrankG : CFSG.pRank 3 ↥K ≤ 1 := by
      rw [CFSG.SectionRank.pRank_eq_open_pRank_top]
      omega
    have hle := CFSG.RankThree.ThinCatalog.card_le_three_of_not_three_dvd_outer
      hZ hout hKrankG E' inferInstance
    omega

end CFSG.LocalAnalysis.RankThreeUC.AGL81C


