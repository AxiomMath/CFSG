noncomputable def componentAction {X : Type} [Group X] {K E : Subgroup X}
    (h : E ≤ Subgroup.normalizer (K : Set X)) : ↥E →* MulAut ↥K :=
  K.normalizerMonoidHom.comp (Subgroup.inclusion h)

theorem componentAction_apply_coe {X : Type} [Group X] {K E : Subgroup X}
    (h : E ≤ Subgroup.normalizer (K : Set X)) (e : ↥E) (k : ↥K) :
    ((componentAction h e k : ↥K) : X) = (e : X) * (k : X) * (e : X)⁻¹ :=
  Subgroup.normalizerMonoidHom_apply_apply_coe K ⟨(e : X), h e.2⟩ k

theorem componentAction_injective_of_not_le_gamma
    {X : Type} [Group X] [Finite X] {K E : Subgroup X}
    (hE : CFSG.Open.IsElemAbelian 3 E) (hK : CFSG.IsComponent K)
    (hEnorm : E ≤ Subgroup.normalizer (K : Set X))
    (hnotGamma : ¬ K ≤ CFSG.Open.rankThreeGamma 1 3 E) :
    Function.Injective (componentAction hEnorm) := by
  rw [← MonoidHom.ker_eq_bot_iff]
  rw [eq_bot_iff]
  intro e he
  have he1 : (e : X) ∈ E ⊓ Subgroup.centralizer (K : Set X) := by
    refine ⟨e.2, ?_⟩
    change (e : X) ∈ Subgroup.centralizer (K : Set X)
    rw [Subgroup.mem_centralizer_iff]
    intro k hk
    have h2 : componentAction hEnorm e ⟨k, hk⟩ = ⟨k, hk⟩ := by
      rw [MonoidHom.mem_ker.mp he, MulAut.one_apply]
    have h3 : (e : X) * k * (e : X)⁻¹ = k := by
      have := congrArg (fun x : ↥K => (x : X)) h2
      rwa [componentAction_apply_coe] at this
    have h4 : (e : X) * k = k * (e : X) := by
      calc (e : X) * k = (e : X) * k * (e : X)⁻¹ * (e : X) := by group
        _ = k * (e : X) := by rw [h3]
    exact h4.symm
  have hbot := inf_centralizer_eq_bot_of_not_le_gamma hE hK hnotGamma
  rw [hbot, Subgroup.mem_bot] at he1
  exact Subtype.ext he1

theorem componentAction_image_card {X : Type} [Group X] {K E : Subgroup X}
    (hEnorm : E ≤ Subgroup.normalizer (K : Set X))
    (hinj : Function.Injective (componentAction hEnorm)) (hE9 : Nat.card E = 9) :
    Nat.card ((⊤ : Subgroup ↥E).map (componentAction hEnorm)) = 9 := by
  rw [Subgroup.card_map_of_injective hinj]
  simpa using hE9

theorem componentAction_image_isElemAbelian {X : Type} [Group X] {K E : Subgroup X}
    (hEnorm : E ≤ Subgroup.normalizer (K : Set X))
    (hE : CFSG.Open.IsElemAbelian 3 E) :
    CFSG.Open.IsElemAbelian 3 ((⊤ : Subgroup ↥E).map (componentAction hEnorm)) := by
  have htop : CFSG.Open.IsElemAbelian 3 (⊤ : Subgroup ↥E) := by
    refine ⟨IsMulCommutative.of_comm fun a b =>
      Subtype.ext (isMulCommutative_iff.mp hE.1 a.1 b.1), ?_⟩
    intro a _
    exact Subtype.ext (hE.2 a.1 a.2)
  exact htop.map (componentAction hEnorm)

end CFSG.LocalAnalysis.RankThreeUC.AGL81C

