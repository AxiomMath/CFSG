def RankOneLieIndex (d : TauCeti.ValidLieTypeIndex) : Prop :=
  (∃ q : TauCeti.PrimePower, q.p ≠ 3 ∧ d.1 = .A 1 q) ∨
    (∃ q : TauCeti.PrimePower, q.card % 3 = 2 ∧ d.1 = .A 2 q) ∨
      (∃ q : TauCeti.PrimePower, q.card % 3 = 1 ∧ d.1 = .twistedA 2 q)

theorem d2SeitzException_three_of_rankOneLieIndex
    {d : TauCeti.ValidLieTypeIndex} (hfam : RankOneLieIndex d)
    (hex : IsD2SeitzException 3 d.1) :
    ∃ q : TauCeti.PrimePower, q.p = 2 ∧ q.exponent = 3 ∧ d.1 = .A 1 q := by
  unfold IsD2SeitzException at hex
  rcases hex with ⟨-, hcases⟩ | ⟨h5, -⟩
  · rcases hcases with ⟨q, hq2, hq3, hd⟩ | ⟨q, hq2, hq4, hd⟩ | ⟨q, hq2, hq1, hd⟩ |
      ⟨q, hq2, hq1, hd⟩ | hd
    · exact ⟨q, hq2, hq3, hd⟩
    · rcases hfam with ⟨q', -, hd'⟩ | ⟨q', hc', hd'⟩ | ⟨q', -, hd'⟩
      · rw [hd'] at hd; cases hd
      · rw [hd'] at hd; cases hd
        have hcard : q.card = 4 := by
          rw [TauCeti.PrimePower.card_def, hq2, hq4]; norm_num
        rw [hcard] at hc'; norm_num at hc'
      · rw [hd'] at hd; cases hd
    · rcases hfam with ⟨q', -, hd'⟩ | ⟨q', -, hd'⟩ | ⟨q', -, hd'⟩
      · rw [hd'] at hd; nomatch hd
      · rw [hd'] at hd; nomatch hd
      · rw [hd'] at hd; nomatch hd
    · rcases hfam with ⟨q', -, hd'⟩ | ⟨q', -, hd'⟩ | ⟨q', -, hd'⟩
      · rw [hd'] at hd; nomatch hd
      · rw [hd'] at hd; nomatch hd
      · rw [hd'] at hd; nomatch hd
    · rcases hfam with ⟨q', -, hd'⟩ | ⟨q', -, hd'⟩ | ⟨q', -, hd'⟩
      · rw [hd'] at hd; nomatch hd
      · rw [hd'] at hd; nomatch hd
      · rw [hd'] at hd; nomatch hd
  · omega

theorem characteristic_ne_three_of_rankOneLieIndex
    {d : TauCeti.ValidLieTypeIndex} (hfam : RankOneLieIndex d) :
    d.1.characteristic ≠ 3 := by
  rcases hfam with ⟨q, hq3, hd⟩ | ⟨q, hc, hd⟩ | ⟨q, hc, hd⟩
  · rw [hd]
    simpa [TauCeti.ValidLieTypeIndex.characteristic, TauCeti.LieTypeIndex.characteristic_A]
      using hq3
  · rw [hd]
    intro h3
    have hp3 : q.p = 3 := by
      simpa [TauCeti.ValidLieTypeIndex.characteristic, TauCeti.LieTypeIndex.characteristic_A]
        using h3
    have hmod : q.card % 3 = 0 := by
      rw [TauCeti.PrimePower.card_def, hp3]
      exact Nat.mod_eq_zero_of_dvd (dvd_pow_self 3 q.exponent_pos.ne')
    omega
  · rw [hd]
    intro h3
    have hp3 : q.p = 3 := by
      simpa [TauCeti.ValidLieTypeIndex.characteristic, TauCeti.LieTypeIndex.characteristic_twistedA]
        using h3
    have hmod : q.card % 3 = 0 := by
      rw [TauCeti.PrimePower.card_def, hp3]
      exact Nat.mod_eq_zero_of_dvd (dvd_pow_self 3 q.exponent_pos.ne')
    omega

theorem isPSLType_two_galoisField_eight_of_cat_A1
    {K : Type} [Group K] [Finite K] {q : TauCeti.PrimePower}
    (hv : (TauCeti.LieTypeIndex.A 1 q).Valid) (hq2 : q.p = 2) (hq3 : q.exponent = 3)
    (e : K ≃* CFSG.LieType.SeitzGeneration.Cat
      ⟨TauCeti.LieTypeIndex.A 1 q, hv⟩) :
    IsPSLType 2 (GaloisField 2 3) K := by
  refine ⟨e.trans ?_⟩
  exact (CFSG.HardMathSupport.Curtis.Coordinator.SeitzOuter.catEquivProjectiveSL
      (m := 1) (k := GaloisField 2 3) (ℓ := q.p) (e := q.exponent)
      q.prime_p q.exponent_pos
      (by rw [GaloisField.card 2 3 (by norm_num), hq2, hq3]) hv).trans
    (CFSG.LocalAnalysis.ComponentInitial.LinearCover.projectiveSpecialLinearEquivProjectiveSL
      2 (GaloisField 2 3)).symm

end CFSG.LocalAnalysis.RankThreeUC.AGL81C

namespace CFSG.LocalAnalysis.RankThreeUC.AGL81C

open CFSG.Open CFSG.RankThreeCoreUniqueness.Helpers CFSG.LocalAnalysis.RankThreeUC.S15 Subgroup
open CFSG.LocalAnalysis.AGL81TheoremCD.Section14
open CFSG.AGLEmbeddingD2

theorem rankOneLie_generation_or_PSL28
    (hSeitz : KFactSeitzRankTwo)
    {K : Type} [Group K] [Finite K] {d : TauCeti.ValidLieTypeIndex}
    (hfam : RankOneLieIndex d) (e : K ≃* CFSG.LieType.SeitzGeneration.Cat d)
    (E : Subgroup (MulAut K)) (hEel : CFSG.Open.IsElemAbelian 3 E) (hEcard : Nat.card E = 9) :
    IsPSLType 2 (GaloisField 2 3) K ∨
      Subgroup.closure {x : K | ∃ a ∈ E, a ≠ 1 ∧ a x = x} = ⊤ := by
  by_cases hex : IsD2SeitzException 3 d.1
  · obtain ⟨q, hq2, hq3, hd⟩ := d2SeitzException_three_of_rankOneLieIndex hfam hex
    obtain ⟨d0, hv⟩ := d
    change d0 = .A 1 q at hd
    subst hd
    exact Or.inl (isPSLType_two_galoisField_eight_of_cat_A1 hv hq2 hq3 e)
  · right
    have hchar : d.1.characteristic ≠ 3 := characteristic_ne_three_of_rankOneLieIndex hfam
    let ψ : MulAut K ≃* MulAut (CFSG.LieType.SeitzGeneration.Cat d) := MulAut.congr e
    let E' : Subgroup (MulAut (CFSG.LieType.SeitzGeneration.Cat d)) :=
      E.map ψ.toMonoidHom
    have hE'el : CFSG.Open.IsElemAbelian 3 E' := hEel.map ψ.toMonoidHom
    have hE'card : Nat.card E' = 9 := by
      rw [Subgroup.card_map_of_injective ψ.injective, hEcard]
    have hgen := hSeitz d 3 Nat.prime_three (by norm_num) (Ne.symm hchar) hex E' hE'el hE'card
    exact closure_fixed_transport e E hgen

end CFSG.LocalAnalysis.RankThreeUC.AGL81C

namespace CFSG.LocalAnalysis.RankThreeUC.AGL81C

open CFSG.Open CFSG.RankThreeCoreUniqueness.Helpers CFSG.LocalAnalysis.RankThreeUC.S15 Subgroup
open CFSG.LocalAnalysis.AGL81TheoremCD.Section14
open CFSG.AGLEmbeddingD2

theorem component_le_gamma_of_closure_fixed
    {X : Type} [Group X] [Finite X] {K E : Subgroup X}
    (hE : CFSG.Open.IsElemAbelian 3 E) (hK : CFSG.IsComponent K)
    (hEnorm : E ≤ Subgroup.normalizer (K : Set X))
    (hnotGamma : ¬ K ≤ CFSG.Open.rankThreeGamma 1 3 E)
    (hgen : Subgroup.closure
      {x : ↥K | ∃ a ∈ (⊤ : Subgroup ↥E).map (componentAction hEnorm),
        a ≠ 1 ∧ a x = x} = ⊤) :
    K ≤ CFSG.Open.rankThreeGamma 1 3 E := by
  have hinj : Function.Injective (componentAction hEnorm) :=
    componentAction_injective_of_not_le_gamma hE hK hEnorm hnotGamma
  let S : Set ↥K := {x : ↥K | ∃ a ∈ (⊤ : Subgroup ↥E).map (componentAction hEnorm),
    a ≠ 1 ∧ a x = x}
  have hSle : ∀ x ∈ S, ((x : ↥K) : X) ∈ CFSG.Open.rankThreeGamma 1 3 E := by
    rintro x ⟨a, ha, ha1, hax⟩
    obtain ⟨e0, -, rfl⟩ := Subgroup.mem_map.mp ha
    have he0E : (e0 : X) ∈ E := e0.2
    have he01 : (e0 : X) ≠ 1 := by
      intro h1
      have heq : e0 = 1 := Subtype.ext h1
      subst heq
      exact ha1 (map_one (componentAction hEnorm))
    have hcomm : (e0 : X) * (x : X) = (x : X) * (e0 : X) := by
      have h3 : (e0 : X) * (x : X) * (e0 : X)⁻¹ = (x : X) := by
        have := congrArg (fun y : ↥K => (y : X)) hax
        rwa [componentAction_apply_coe] at this
      calc (e0 : X) * (x : X) = ((e0 : X) * (x : X) * (e0 : X)⁻¹) * (e0 : X) := by group
        _ = (x : X) * (e0 : X) := by rw [h3]
    have hxcent : (x : X) ∈ Subgroup.centralizer ({(e0 : X)} : Set X) := by
      rw [Subgroup.mem_centralizer_singleton_iff]
      exact hcomm.symm
    exact CFSG.LocalAnalysis.AGL81TheoremCD.Section15.K35.centralizer_le_gamma
      hE he0E he01 hxcent
  have hclosure : Subgroup.closure S ≤
      (CFSG.Open.rankThreeGamma 1 3 E).comap K.subtype := by
    refine (Subgroup.closure_le _).2 ?_
    rintro x hx
    exact hSle x hx
  intro x hx
  have hx' : (⟨x, hx⟩ : ↥K) ∈ Subgroup.closure S := by rw [hgen]; trivial
  exact hclosure hx'

end CFSG.LocalAnalysis.RankThreeUC.AGL81C

namespace CFSG.LocalAnalysis.RankThreeUC.AGL81C

open CFSG.Open CFSG.RankThreeCoreUniqueness.Helpers CFSG.LocalAnalysis.RankThreeUC.S15 Subgroup
open CFSG.LocalAnalysis.AGL81TheoremCD.Section14
