theorem closure_fixed_transport {K C : Type} [Group K] [Group C] (e : K ≃* C)
    (E : Subgroup (MulAut K))
    (h : Subgroup.closure
      {y : C | ∃ a ∈ E.map (MulAut.congr e).toMonoidHom, a ≠ 1 ∧ a y = y} = ⊤) :
    Subgroup.closure {x : K | ∃ a ∈ E, a ≠ 1 ∧ a x = x} = ⊤ := by
  let S : Set K := {x : K | ∃ a ∈ E, a ≠ 1 ∧ a x = x}
  let S' : Set C := {y : C | ∃ a ∈ E.map (MulAut.congr e).toMonoidHom, a ≠ 1 ∧ a y = y}
  have hS' : S' = e '' S := by
    ext y
    constructor
    · rintro ⟨b, hb, hb1, hby⟩
      obtain ⟨a, ha, rfl⟩ := Subgroup.mem_map.mp hb
      refine ⟨e.symm y, ⟨a, ha, ?_, ?_⟩, by simp⟩
      · intro ha1
        exact hb1 (by rw [ha1]; exact map_one (MulAut.congr e))
      · simpa [MulAut.congr] using congrArg e.symm hby
    · rintro ⟨x, ⟨a, ha, ha1, hax⟩, rfl⟩
      refine ⟨MulAut.congr e a, Subgroup.mem_map_of_mem _ ha, ?_, ?_⟩
      · intro h1
        exact ha1 ((MulAut.congr e).injective (by rw [h1, map_one]))
      · simpa [MulAut.congr] using congrArg e hax
  have hmap : (Subgroup.closure S).map e.toMonoidHom = ⊤ := by
    rw [MonoidHom.map_closure]
    change Subgroup.closure (⇑e '' S) = ⊤
    rw [← hS']
    exact h
  rw [eq_top_iff]
  intro x _
  have hx : e x ∈ (Subgroup.closure S).map e.toMonoidHom := by rw [hmap]; trivial
  obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
  have hyx' : y = x := e.injective hyx
  simpa [hyx'] using hy

end CFSG.LocalAnalysis.RankThreeUC.AGL81C

