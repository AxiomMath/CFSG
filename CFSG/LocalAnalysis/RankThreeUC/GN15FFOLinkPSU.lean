theorem linkPSU_holds :
    LinkPSU := by
  intro G _ _ L hL a y ha hy hinv r e hr hr2 hord hyr hyX hF hrZ
  obtain ⟨d, f, hmodel, -⟩ := hF
  obtain ⟨⟨hp2, hf, hd, hne⟩, K, _, _, hK, ⟨e₀⟩⟩ := hmodel
  have hq : ¬(d = 3 ∧ 2 ^ f = 2) := fun ⟨h1, h2⟩ => hne (by rw [h1, h2])
  have h : UnitaryFieldData 2 f K := ⟨Nat.prime_two, hf, by rw [hK, ← pow_mul, mul_comm]⟩
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have : CharP K 2 := h.charP
  have : Fact r.Prime := ⟨hr⟩
  have hperfL : Group.IsPerfect ↥L := ⟨hL.2.2.1⟩
  set N : Subgroup ↥L := copPart r (Subgroup.center ↥L) le_rfl with hNdef
  have hZst : ∀ (g : ↥(Subgroup.normalizer (L : Set G))) (w : ↥L), w ∈ Subgroup.center ↥L →
      conjHom L g w ∈ Subgroup.center ↥L := fun g w hw => conjHom_mem_center g hw
  have hNst : ∀ (g : ↥(Subgroup.normalizer (L : Set G))) (w : ↥L), w ∈ N →
      conjHom L g w ∈ N := fun g w hw => conjHom_mem_copPart r g hw
  have hNZ : N ≤ Subgroup.center ↥L := fun x hx => hx.1
  let ρ : ↥L ⧸ N →* ↥L ⧸ Subgroup.center ↥L := projHom N (Subgroup.center ↥L) hNZ
  let π₀ : (↥L ⧸ N) →* StatedProj (StatedSU d (2 ^ f) K) := e₀.toMonoidHom.comp ρ
  have hπ₀mk : ∀ l : ↥L, π₀ (QuotientGroup.mk l) = e₀ (QuotientGroup.mk l) := fun l => rfl
  have hπ₀s : Function.Surjective π₀ := fun x => by
    obtain ⟨l, hl⟩ := QuotientGroup.mk_surjective (e₀.symm x)
    exact ⟨QuotientGroup.mk l, by rw [hπ₀mk, hl, MulEquiv.apply_symm_apply]⟩
  have hker1 : ∀ l : ↥L, π₀ (QuotientGroup.mk l) = 1 ↔ l ∈ Subgroup.center ↥L := fun l => by
    rw [hπ₀mk, MulEquiv.map_eq_one_iff, QuotientGroup.eq_one_iff]
  have hkerform : ∀ x ∈ π₀.ker, ∃ l ∈ Subgroup.center ↥L, x = QuotientGroup.mk l := by
    intro x hx
    obtain ⟨l, rfl⟩ := QuotientGroup.mk_surjective x
    exact ⟨l, (hker1 l).1 (MonoidHom.mem_ker.1 hx), rfl⟩
  have hc : π₀.ker ≤ Subgroup.center (↥L ⧸ N) := by
    intro x hx
    obtain ⟨l, hl, rfl⟩ := hkerform x hx
    rw [Subgroup.mem_center_iff]
    intro y
    obtain ⟨m, rfl⟩ := QuotientGroup.mk_surjective y
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, Subgroup.mem_center_iff.1 hl m]
  have hk : IsPGroup r π₀.ker := by
    rintro ⟨x, hx⟩
    obtain ⟨l, hl, rfl⟩ := hkerform x hx
    obtain ⟨k, hk⟩ := exists_pow_prime_pow_mem_copPart (p := r) (le_refl _) hl
    refine ⟨k, Subtype.ext ?_⟩
    change (QuotientGroup.mk l : ↥L ⧸ N) ^ r ^ k = 1
    rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
    exact hk
  have : Group.IsPerfect (↥L ⧸ N) := Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective N)
  obtain ⟨φ, hφs, hφπ⟩ := exists_cover hK hf hd hr hr2 π₀ hπ₀s hc hk
  let TZ := quotHom (Subgroup.center ↥L) hZst
  let TN := quotHom N hNst
  let κ := CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.OuterFourSeitz.statedProjEquivPrimeFormOne
    h (by omega : 1 ≤ d)
  let TP : ↥(Subgroup.normalizer (L : Set G)) →* MulAut (StatedProj (StatedSU d (2 ^ f) K)) :=
    (MulAut.congr e₀).toMonoidHom.comp TZ
  let TQ : ↥(Subgroup.normalizer (L : Set G)) →*
      MulAut (primeFormP h ((1 : GL (Fin d) K) : Matrix (Fin d) (Fin d) K)) :=
    (MulAut.congr κ).toMonoidHom.comp TP
  have hTQ : ∀ g : ↥(Subgroup.normalizer (L : Set G)),
      TQ g ∈ inner (primeFormP h ((1 : GL (Fin d) K) : Matrix (Fin d) (Fin d) K)) ↔
        (g : G) ∈ L ⊔ Subgroup.centralizer (L : Set G) := fun g => by
    change MulAut.congr κ (MulAut.congr e₀ (TZ g)) ∈ _ ↔ _
    rw [congr_mem_inner_iff, congr_mem_inner_iff]
    exact quotHom_mem_inner_iff (Subgroup.center ↥L) le_rfl hZst g.2
  set ga : ↥(Subgroup.normalizer (L : Set G)) := ⟨a, ha⟩ with hga
  set gy : ↥(Subgroup.normalizer (L : Set G)) := ⟨y, hy⟩ with hgy
  have hrel : TQ ga * TQ gy * (TQ ga)⁻¹ = (TQ gy)⁻¹ := by
    rw [← map_inv, ← map_mul, ← map_mul, ← map_inv]
    congr 1
    exact Subtype.ext hinv
  have hyr' : TQ gy ^ r ∈
      inner (primeFormP h ((1 : GL (Fin d) K) : Matrix (Fin d) (Fin d) K)) := by
    rw [← map_pow]
    exact (hTQ (gy ^ r)).2 hyr
  have hy1' : TQ gy ∉
      inner (primeFormP h ((1 : GL (Fin d) K) : Matrix (Fin d) (Fin d) K)) :=
    fun hmem => hyX ((hTQ gy).1 hmem)
  obtain ⟨A, ψ, u, hτa, hψ, hdvd⟩ := exists_unitary_exponent h hd hq hr hr2 (TQ ga) (TQ gy) hrel hyr' hy1'
  have hσ : ∀ x : StatedSU d (2 ^ f) K,
      TP ga (QuotientGroup.mk x) = QuotientGroup.mk (alphaSU h A.1 A.2 ψ x) :=
    sigma_mk h (by omega) (TP ga) A ψ hτa
  set θ : StatedSU d (2 ^ f) K →* StatedProj (StatedSU d (2 ^ f) K) := QuotientGroup.mk' _
    with hθ
  have : Group.IsPerfect (StatedSU d (2 ^ f) K) :=
    CFSG.LieType.Steinberg.CentralExt.SUOdd.isPerfect_statedSU_odd hK hd hne
  have hβ : ∀ x : ↥L ⧸ N, π₀ ((TN ga).toMonoidHom x) = (TP ga).toMonoidHom (π₀ x) := by
    intro x
    obtain ⟨l, rfl⟩ := QuotientGroup.mk_surjective x
    have e1 : π₀ ((TN ga).toMonoidHom (QuotientGroup.mk l)) =
        e₀ (QuotientGroup.mk (conjHom L ga l)) := by
      change π₀ (TN ga (QuotientGroup.mk l)) = _
      rw [quotHom_mk]
      rfl
    have e2 : (TP ga).toMonoidHom (π₀ (QuotientGroup.mk l)) =
        e₀ (QuotientGroup.mk (conjHom L ga l)) := by
      change MulAut.congr e₀ (TZ ga) (e₀ (QuotientGroup.mk l)) = _
      rw [congr_apply_apply]
      change e₀ (quotHom (Subgroup.center ↥L) hZst ga (QuotientGroup.mk l)) = _
      rw [quotHom_mk]
    rw [e1, e2]
  have hpow := pow_of_mem_ker θ π₀ hc φ hφπ hφs (alphaSU h A.1 A.2 ψ) (TN ga).toMonoidHom
    (TP ga).toMonoidHom (fun g => (hσ g).symm) hβ u
    (fun g hg => alphaSU_pow_of_scalar h A.1 A.2 ψ u hψ g hg)
  set D := (StatedScalars (Fin d) K).subgroupOf (StatedSU d (2 ^ f) K) with hD
  have hcycD : IsCyclic D :=
    (CFSG.LieType.Steinberg.isCyclic_scalars_statedSU hK (by omega : 1 ≤ d)).1
  have hφD : ∀ g : D, π₀ (φ g) = 1 := fun g => by
    rw [hφπ]
    exact (QuotientGroup.eq_one_iff _).2 g.2
  let φD : D →* ↥π₀.ker :=
    (φ.comp D.subtype).codRestrict π₀.ker (fun g => MonoidHom.mem_ker.2 (hφD g))
  have hφDs : Function.Surjective φD := by
    rintro ⟨x, hx⟩
    obtain ⟨g, rfl⟩ := hφs x
    have hgD : g ∈ D := by
      have := MonoidHom.mem_ker.1 hx
      rw [hφπ] at this
      exact (QuotientGroup.eq_one_iff _).1 this
    exact ⟨⟨g, hgD⟩, Subtype.ext rfl⟩
  have hcycker : IsCyclic ↥π₀.ker := isCyclic_of_surjective φD hφDs
  obtain ⟨z₀, hz₀⟩ := exists_prime_orderOf_dvd_card' (G := ↥(Subgroup.center ↥L)) r hrZ
  set zL : ↥L := (z₀ : ↥L) with hzLdef
  have hzc : zL ∈ Subgroup.center ↥L := z₀.2
  have hzLo : orderOf zL = r := by
    rw [hzLdef, Subgroup.orderOf_coe, hz₀]
  have hzr : zL ^ r = 1 := by
    rw [← hzLo]
    exact pow_orderOf_eq_one zL
  have hzbar : (QuotientGroup.mk zL : ↥L ⧸ N) ∈ π₀.ker := MonoidHom.mem_ker.2 ((hker1 zL).2 hzc)
  have hzL1 : zL ≠ 1 := fun h1 => by
    rw [h1, orderOf_one] at hzLo
    exact hr.one_lt.ne hzLo
  have huniq : ∀ x : ↥L, x ∈ Subgroup.center ↥L → x ^ r = 1 → x ∈ Subgroup.zpowers zL := by
    intro x hx hxr
    set xc : ↥π₀.ker := ⟨QuotientGroup.mk x, MonoidHom.mem_ker.2 ((hker1 x).2 hx)⟩ with hxc
    set zc : ↥π₀.ker := ⟨QuotientGroup.mk zL, hzbar⟩ with hzc'
    have hzco : orderOf zc = r := by
      refine orderOf_eq_prime ?_ ?_
      · refine Subtype.ext ?_
        change (QuotientGroup.mk zL : ↥L ⧸ N) ^ r = 1
        rw [← QuotientGroup.mk_pow, hzr, QuotientGroup.mk_one]
      · intro h1
        have h2 : (QuotientGroup.mk zL : ↥L ⧸ N) = 1 := congrArg Subtype.val h1
        rw [QuotientGroup.eq_one_iff] at h2
        exact hzL1 (eq_one_of_mem_copPart_of_pow_eq_one h2 hzr)
    have hxco : xc ^ r = 1 := by
      refine Subtype.ext ?_
      change (QuotientGroup.mk x : ↥L ⧸ N) ^ r = 1
      rw [← QuotientGroup.mk_pow, hxr, QuotientGroup.mk_one]
    obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.1 (mem_zpowers_of_pow_eq_one hzco hxco)
    have hj' : (QuotientGroup.mk (zL ^ j) : ↥L ⧸ N) = QuotientGroup.mk x := by
      have := congrArg Subtype.val hj
      change (QuotientGroup.mk zL : ↥L ⧸ N) ^ j = QuotientGroup.mk x at this
      rw [← QuotientGroup.mk_zpow] at this
      exact this
    refine Subgroup.mem_zpowers_iff.2 ⟨j, ?_⟩
    refine eq_of_mk_eq_of_pow hx ?_ hxr hj'
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hzr, one_zpow]
  have hact : conjHom L ga zL = zL ^ u := by
    have h1 := hpow (QuotientGroup.mk zL) hzbar
    change (TN ga) (QuotientGroup.mk zL) = _ at h1
    rw [quotHom_mk, ← QuotientGroup.mk_pow] at h1
    refine eq_of_mk_eq_of_pow (Subgroup.pow_mem _ hzc u) ?_ ?_ h1
    · rw [← map_pow, hzr, map_one]
    · rw [← pow_mul, mul_comm, pow_mul, hzr, one_pow]
  have hconjz : ∀ g : ↥(Subgroup.normalizer (L : Set G)), ∃ k : ℤ,
      (g : G) * (zL : G) * (g : G)⁻¹ = (zL : G) ^ k := by
    intro g
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1
      (huniq (conjHom L g zL) (conjHom_mem_center g hzc) (by rw [← map_pow, hzr, map_one]))
    refine ⟨k, ?_⟩
    have h1 : ((zL ^ k : ↥L) : G) = ((conjHom L g zL : ↥L) : G) := congrArg Subtype.val hk
    rw [Subgroup.coe_zpow] at h1
    exact h1.symm
  refine ⟨(zL : G), zL.2, ?_, ?_, ?_, ?_, ?_⟩
  · intro h1
    exact hzL1 (Subtype.ext h1)
  · rw [Subgroup.orderOf_coe, hzLo]
  · intro l hl
    exact congrArg Subtype.val (Subgroup.mem_center_iff.1 hzc ⟨l, hl⟩)
  · have h1 : a * (zL : G) * a⁻¹ = (zL : G) ^ u := congrArg Subtype.val hact
    have h2 : (zL : G) ^ (u + 1) = 1 := by
      have := orderOf_dvd_iff_pow_eq_one.1 (hzLo ▸ hdvd : orderOf zL ∣ u + 1)
      exact congrArg Subtype.val this
    rw [h1]
    exact eq_inv_of_mul_eq_one_left (by rw [← pow_succ]; exact h2)
  · intro g hg
    rw [Subgroup.mem_normalizer_iff]
    intro x
    constructor
    · intro hx
      obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.1 hx
      obtain ⟨k, hk⟩ := hconjz ⟨g, hg⟩
      refine Subgroup.mem_zpowers_iff.2 ⟨k * j, ?_⟩
      rw [zpow_mul, ← hk, conj_zpow]
    · intro hx
      obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.1 hx
      obtain ⟨k, hk⟩ := hconjz ⟨g⁻¹, inv_mem hg⟩
      refine Subgroup.mem_zpowers_iff.2 ⟨k * j, ?_⟩
      rw [zpow_mul, ← hk, conj_zpow, hj]
      group

theorem invertsOddOn_psu_of_noOffender
    (hvac : PSUNoOffender) : InvertsOddOn FamPSU :=
  invertsOddOn_psu_of_link_and_noOffender linkPSU_holds hvac

theorem ffOffenderInvertsOddPSU_of_noOffender
    (hvac : PSUNoOffender) : FFOffenderInvertsOddPSU :=
  invertsOddOn_psu_of_noOffender hvac

end CFSG.LocalAnalysis.RankThreeUC.S15.GN15.FFO
