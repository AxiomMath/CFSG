theorem three_dvd_card_sq_sub_one (F : Type) [Field F] [Finite F] [CharP F 2] :
    3 ∣ Nat.card F ^ 2 - 1 := by
  obtain ⟨f, -, hcard⟩ := exists_card_eq_two_pow F
  rw [hcard, ← pow_mul, mul_comm, pow_mul]
  have := Nat.sub_one_dvd_pow_sub_one 4 f
  norm_num at this ⊢
  exact this

section Mat

theorem noCliqueCover_of_path {r : ℕ} (hr : 5 ≤ r) (A : Matrix (Fin r) (Fin r) ℤ)
    (hA : ∀ i j : Fin r, i.val + 2 ≤ j.val → A i j = 0) (hA' : ∀ i j : Fin r, i.val + 2 ≤ j.val →
      A j i = 0) : NoCliqueCover r (BadPairMat A) := by
  refine noCliqueCover_of_triple (a := ⟨0, by omega⟩) (b := ⟨2, by omega⟩) (c := ⟨4, by omega⟩)
    ⟨by simp [Fin.ext_iff], Or.inl (hA _ _ (by simp))⟩ ⟨by simp [Fin.ext_iff], Or.inl (hA _ _ (by simp))⟩
    ⟨by simp [Fin.ext_iff], Or.inl (hA _ _ (by simp))⟩

theorem cartanC_zero {r : ℕ} {i j : Fin r} (h : i.val + 2 ≤ j.val) :
    Symplectic.cartanC r i j = 0 := by
  simp only [Symplectic.cartanC, Matrix.of_apply]
  split_ifs <;> omega

theorem cartanC_zero' {r : ℕ} {i j : Fin r} (h : i.val + 2 ≤ j.val) :
    Symplectic.cartanC r j i = 0 := by
  simp only [Symplectic.cartanC, Matrix.of_apply]
  split_ifs <;> omega

theorem noCliqueCover_C4 : NoCliqueCover 4 (BadPairMat (Symplectic.cartanC 4)) := by
  unfold NoCliqueCover
  decide +kernel

end Mat

section Families

variable {W : Type} [Group W] [Finite W] {L S₀ A₁ A₂ : Subgroup W}

section SL

variable {F : Type} [Field F] [Finite F] [CharP F 2]

theorem cartanA_zero {m : ℕ} {i j : Fin m} (h : i.val + 2 ≤ j.val) : CartanMatrix.A m i j = 0 := by
  simp only [CartanMatrix.A, Matrix.of_apply]
  split_ifs <;> omega

theorem cartanA_zero' {m : ℕ} {i j : Fin m} (h : i.val + 2 ≤ j.val) :
    CartanMatrix.A m j i = 0 := by
  simp only [CartanMatrix.A, Matrix.of_apply]
  split_ifs <;> omega

theorem oddNode_sl_three (m : ℕ) (i : Fin m) :
    OddNode (rankOne (SpecialLinear.rootDatum m F).rootGroup i) 3 :=
  oddNode_of_hasSL2Node (hasSL2Node_sl i) Nat.prime_three (by norm_num)
    (three_dvd_card_sq_sub_one F)

theorem false_of_sl (hS : IsSylowTwoOf S₀ L) (hcov : CoveredByTwo L S₀ A₁ A₂) (hA₁ : A₁ ≤ L)
    (hA₂ : A₂ ≤ L) (h₁ : CFSG.Open.pRank 3 A₁ ≤ 1) (h₂ : CFSG.Open.pRank 3 A₂ ≤ 1) {m : ℕ}
    (hm : 5 ≤ m) (e : Matrix.ProjectiveSpecialLinearGroup (Fin (m + 1)) F ≃*
      (↥L ⧸ Subgroup.center ↥L)) : False :=
  false_of_cover hS hcov (borelQuotient_sl e) rfl (fun i => oddNode_sl_three m i) hA₁ hA₂ h₁ h₂
    (noCliqueCover_of_path hm (CartanMatrix.A m) (fun i j h => cartanA_zero h)
      (fun i j h => cartanA_zero' h))

end SL

section Sp

variable {F : Type} [Field F] [Finite F] [CharP F 2]

theorem oddNode_sp_three (r : ℕ) (i : Fin r) :
    OddNode (rankOne (Symplectic.rootDatum r F).rootGroup i) 3 :=
  oddNode_of_hasSL2Node (hasSL2Node_sp i) Nat.prime_three (by norm_num)
    (three_dvd_card_sq_sub_one F)

theorem noCliqueCover_sp {r : ℕ} (hr : 4 ≤ r) :
    NoCliqueCover (Symplectic.rootDatum r F).rank (BadPair (Symplectic.rootDatum r F)) := by
  rcases Nat.eq_or_lt_of_le hr with rfl | h5
  · exact noCliqueCover_C4
  · exact noCliqueCover_of_path h5 (Symplectic.cartanC r) (fun i j h => cartanC_zero h)
      (fun i j h => cartanC_zero' h)

theorem false_of_sp (hS : IsSylowTwoOf S₀ L) (hcov : CoveredByTwo L S₀ A₁ A₂) (hA₁ : A₁ ≤ L)
    (hA₂ : A₂ ≤ L) (h₁ : CFSG.Open.pRank 3 A₁ ≤ 1) (h₂ : CFSG.Open.pRank 3 A₂ ≤ 1) {r : ℕ}
    (hr : 4 ≤ r) (e : (↥L ⧸ Subgroup.center ↥L) ≃* StatedProj (StatedSp r F)) : False :=
  false_of_cover hS hcov (borelQuotient_sp e) rfl (fun i => oddNode_sp_three r i) hA₁ hA₂ h₁ h₂
    (noCliqueCover_sp hr)

end Sp

section SpinPlus

open CFSG.LieType.Universal.Spin in
theorem noCliqueCover_D {n : ℕ} (hn : 4 ≤ n) : NoCliqueCover n (BadPairMat (cartanD n)) := by
  refine noCliqueCover_of_triple (a := ⟨0, by omega⟩) (b := ⟨n - 2, by omega⟩)
    (c := ⟨n - 1, by omega⟩) ⟨?_, Or.inl ?_⟩ ⟨?_, Or.inl ?_⟩ ⟨?_, Or.inl ?_⟩
  · simp only [ne_eq, Fin.mk.injEq]; omega
  · simp only [cartanD, Matrix.of_apply, Fin.mk.injEq]
    split_ifs with h1 h2
    · omega
    · try simp only [false_and, or_false, false_or] at h2
      omega
    · rfl
  · simp only [ne_eq, Fin.mk.injEq]; omega
  · simp only [cartanD, Matrix.of_apply, Fin.mk.injEq]
    split_ifs with h1 h2
    · omega
    · try simp only [false_and, or_false, false_or] at h2
      omega
    · rfl
  · simp only [ne_eq, Fin.mk.injEq]; omega
  · simp only [cartanD, Matrix.of_apply, Fin.mk.injEq]
    split_ifs with h1 h2
    · omega
    · try simp only [false_and, or_false, false_or] at h2
      omega
    · rfl

open CFSG.LieType.Universal.Spin in
theorem oddNode_spinPlus_three {n : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2] (hn : 3 ≤ n)
    (i : Fin n) : OddNode (rankOne (plusDatum n F hn).rootGroup i) 3 :=
  oddNode_of_hasSL2Node (hasSL2Node_spinPlus hn i) Nat.prime_three (by norm_num)
    (three_dvd_card_sq_sub_one F)

open CFSG.LieType.Universal.Spin in
theorem false_of_spinPlus {n : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2]
    (hS : IsSylowTwoOf S₀ L) (hcov : CoveredByTwo L S₀ A₁ A₂)
    (hA₁ : A₁ ≤ L) (hA₂ : A₂ ≤ L) (h₁ : CFSG.Open.pRank 3 A₁ ≤ 1) (h₂ : CFSG.Open.pRank 3 A₂ ≤ 1)
    (hn : 4 ≤ n)
    (e : (↥L ⧸ Subgroup.center ↥L) ≃* StatedProj (StatedOmega (StatedQuadPlus n F))) : False := by
  have hn3 : 3 ≤ n := by omega
  have : NeZero n := ⟨by omega⟩
  have : Finite (spinGroup (quadPlus n F)) :=
    finite_spinGroup_of_ker _ (coe_ker_spinMatrix_quadPlus (n := n) (K := F))
  exact false_of_cover hS hcov (borelQuotient_spinPlus hn3 e) rfl
    (fun i => oddNode_spinPlus_three (n := n) (F := F) hn3 i) hA₁ hA₂ h₁ h₂ (noCliqueCover_D hn)

end SpinPlus

section SpinMinus

open CFSG.LieType.Universal.Spin CFSG.LieType.Universal.Spin.Twisted
  CFSG.LieType.Steinberg.CentralExt CFSG.AGLEmbeddingD2.Tits.S3AmalgamBound

theorem cartanB_zero {r : ℕ} {i j : Fin r} (h : i.val + 2 ≤ j.val) : cartanB r i j = 0 := by
  simp only [cartanB, Matrix.of_apply]
  split_ifs <;> omega

theorem cartanB_zero' {r : ℕ} {i j : Fin r} (h : i.val + 2 ≤ j.val) : cartanB r j i = 0 := by
  simp only [cartanB, Matrix.of_apply]
  split_ifs <;> omega

theorem noCliqueCover_B4 : NoCliqueCover 4 (BadPairMat (cartanB 4)) := by
  unfold NoCliqueCover
  decide +kernel

set_option linter.unusedSectionVars false


variable {n : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2] {b c : F}
  (hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0)

theorem oddNode_spinMinus_three (hn : 4 ≤ n) (i : Fin (n - 1)) :
    OddNode (rankOne (minusDatum n hirr).rootGroup i) 3 := by
  by_cases hk : i.val + 1 < n - 1
  · exact oddNode_of_hasSL2Node (hasSL2Node_spinMinus_long hirr hk) Nat.prime_three (by norm_num)
      (three_dvd_card_sq_sub_one F)
  · have := fact_shortField hirr
    have := finite_shortField (b := b) (c := c)
    have : CharP (ShortField b c) 2 :=
      charP_of_injective_algebraMap (algebraMap F (ShortField b c)).injective 2
    have hF2 : 2 ≤ Nat.card F := by have := Finite.one_lt_card (α := F); omega
    have h4 : 4 ≤ Nat.card (ShortField b c) := by
      rw [SpinMinusClosed.card_shortField]
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ Nat.card F ^ 2 := Nat.pow_le_pow_left hF2 2
    refine oddNode_of_hasSL2Node (hasSL2Node_spinMinus_short hirr h4 hk) Nat.prime_three
      (by norm_num) ?_
    rw [SpinMinusClosed.card_shortField]
    exact (three_dvd_card_sq_sub_one F).trans (Nat.sub_one_dvd_pow_sub_one (Nat.card F ^ 2) 2)

include hirr in
theorem false_of_spinMinus (hS : IsSylowTwoOf S₀ L) (hcov : CoveredByTwo L S₀ A₁ A₂)
    (hA₁ : A₁ ≤ L) (hA₂ : A₂ ≤ L) (h₁ : CFSG.Open.pRank 3 A₁ ≤ 1) (h₂ : CFSG.Open.pRank 3 A₂ ≤ 1)
    (hn : 5 ≤ n)
    (e : (↥L ⧸ Subgroup.center ↥L) ≃* StatedProj (StatedOmega (StatedQuadMinus n F b c))) :
    False := by
  have hn4 : 4 ≤ n := by omega
  have : Finite (spinGroup (quadMinus n F b c)) :=
    finite_spinGroup_of_ker _ (coe_ker_spinMatrix_quadMinus hirr)
  refine false_of_cover hS hcov (borelQuotient_spinMinus hirr hn4 e) rfl
    (fun i => oddNode_spinMinus_three (n := n) hirr hn4 i) hA₁ hA₂ h₁ h₂ ?_
  show NoCliqueCover (n - 1) (BadPairMat (cartanB (n - 1)))
  rcases Nat.eq_or_lt_of_le (show 4 ≤ n - 1 by omega) with h | h5
  · have : n - 1 = 4 := h.symm
    rw [this]
    exact noCliqueCover_B4
  · exact noCliqueCover_of_path h5 (cartanB (n - 1)) (fun i j h => cartanB_zero h)
      (fun i j h => cartanB_zero' h)

end SpinMinus

