open CFSG.AGLEmbeddingD2.McLaughlin.WeakBlockModuleData CFSG.AGLEmbedding
open KFactsPair

theorem k517_4b_of_not_rank_two
    {X : Type} [Group X] [Finite X] {T T₁ T₂ : Subgroup X}
    (hX : GNSetting X T) (hGood : GNGood T T₁ T₂)
    {Ls : Subgroup (X ⧸ gnC T)} (hLs : GNYComponent T T₁ T₂ Ls)
    (hTinv : gnImg T T ≤ Subgroup.normalizer (Ls : Set (X ⧸ gnC T)))
    {d : TauCeti.ValidLieTypeIndex} (hd : IsRankTwoPlus d.1) (hnt : ¬ IsRankTwoType d.1)
    (e : (↥Ls ⧸ Subgroup.center ↥Ls) ≃* (TauCeti.CFSGIndex.lie d).Group)
    {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) (hqQ : q ∣ indexQ d.1 - 1)
    {U : Subgroup ↥Ls} (hU2 : IsPGroup 2 U) (hUmax : CFSG.QuasithinUnique.IsSylowTwoOf U ⊤)
    (hU : U = (gnImg T T ⊓ Ls).subgroupOf Ls) :
    1 < mS T T₁ q Ls ∨ 1 < mS T T₂ q Ls := by
  rcases isRankTwoType_or_isRankGeThreeType d.1 hd with h2 | h3
  · exact absurd h2 hnt
  obtain ⟨d0, hv⟩ := d
  cases d0 with
  | A m Q =>
      simp only [IsRankGeThreeType] at h3
      have hqQ' : q ∣ Q.card - 1 := by simpa [indexQ] using hqQ
      exact k517_4b_lin_of_top_of_hall (m := m) (Q := Q) (hv := hv)
        hX hGood hLs hq hq2 h3.2 h3.1 e hTinv hU2 hUmax hqQ' hU
  | B m Q =>
      simp only [IsRankGeThreeType] at h3
      have hqQ' : q ∣ Q.card - 1 := by simpa [indexQ] using hqQ
      exact k517_4b_sp_of_top_of_hall_uncond (m := m) (Q := Q) (hv := hv)
        hX hGood hLs hq hq2 h3.2 h3.1 e hTinv hU2 hUmax hqQ' hU
  | D m Q =>
      simp only [IsRankGeThreeType] at h3
      have hqQ' : q ∣ Q.card - 1 := by simpa [indexQ] using hqQ
      exact k517_4b_orth_of_top_of_hall (m := m) (Q := Q) (hv := hv)
        hX hGood hLs hq hq2 h3.2 h3.1 e hTinv hU2 hUmax hqQ' hU
  | twistedD m Q =>
      simp only [IsRankGeThreeType] at h3
      have hqQ' : q ∣ Q.card - 1 := by simpa [indexQ] using hqQ
      exact k517_4b_2D_of_top_of_hall (m := m) (Q := Q) (hv := hv)
        hX hGood hLs hq hq2 h3.2 h3.1 e hTinv hU2 hUmax hqQ' hU
  | twistedA m Q =>
      simp only [IsRankGeThreeType] at h3
      have hqQ' : q ∣ Q.card - 1 := by simpa [indexQ] using hqQ
      exact k517_4b_2A_of_top_of_hall (m := m) (Q := Q) (hv := hv)
        hX hGood hLs hq hq2 h3.2 h3.1 e hTinv hU2 hUmax hqQ' hU
  | C l Q => simp only [IsRankGeThreeType] at h3
  | E6 Q => simp only [IsRankGeThreeType] at h3
  | E7 Q => simp only [IsRankGeThreeType] at h3
  | E8 Q => simp only [IsRankGeThreeType] at h3
  | F4 Q => simp only [IsRankGeThreeType] at h3
  | G2 Q => simp only [IsRankGeThreeType] at h3
  | twistedE6 Q => simp only [IsRankGeThreeType] at h3
  | trialityD4 Q => simp only [IsRankGeThreeType] at h3
  | suzuki m => simp only [IsRankGeThreeType] at h3
  | reeG2 m => simp only [IsRankGeThreeType] at h3
  | reeF4 m => simp only [IsRankGeThreeType] at h3
  | tits => simp only [IsRankGeThreeType] at h3

end CFSG.LocalAnalysis.RankThreeUC.S15

