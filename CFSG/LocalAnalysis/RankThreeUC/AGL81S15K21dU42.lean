@[expose] def Hyp {S : Type} [Group S] [Finite S] (U D E : Subgroup S) : Prop :=
  CFSG.ABGLocalTools.IsSylowOf 2 U ⊤ ∧ U ≤ D ∧ Group.IsSolvable ↥D ∧ E ≤ D ∧
    CFSG.Open.IsElemAbelian 3 E ∧ Nat.card E = 9 ∧
    ∃ u ∈ U ⊓ Subgroup.normalizer (E : Set S), ∀ e ∈ E, u * e * u⁻¹ = e⁻¹

section Transport

variable {S S' : Type} [Group S] [Group S']

theorem map_mem_iff (φ : S ≃* S') (E : Subgroup S) (x : S) :
    φ x ∈ E.map φ.toMonoidHom ↔ x ∈ E :=
  Subgroup.mem_map_iff_mem φ.injective

theorem map_mem_normalizer_iff (φ : S ≃* S') (E : Subgroup S) (g : S) :
    φ g ∈ Subgroup.normalizer ((E.map φ.toMonoidHom : Subgroup S') : Set S') ↔
      g ∈ Subgroup.normalizer (E : Set S) := by
  rw [Subgroup.mem_normalizer_iff, Subgroup.mem_normalizer_iff]
  constructor
  · intro h x
    have hx := h (φ x)
    rwa [← map_inv, ← map_mul, ← map_mul, map_mem_iff, map_mem_iff] at hx
  · intro h x'
    obtain ⟨x, rfl⟩ := φ.surjective x'
    rw [← map_inv, ← map_mul, ← map_mul, map_mem_iff, map_mem_iff]
    exact h x

theorem isSylowOf_map [Finite S] [Finite S'] (φ : S ≃* S') {U : Subgroup S}
    (h : CFSG.ABGLocalTools.IsSylowOf 2 U ⊤) :
    CFSG.ABGLocalTools.IsSylowOf 2 (U.map φ.toMonoidHom) ⊤ := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rw [CFSG.ABGLocalTools.isSylowOf_iff] at h ⊢
  obtain ⟨-, hp, hdvd⟩ := h
  refine ⟨le_top, hp.of_equiv (U.equivMapOfInjective φ.toMonoidHom φ.injective), ?_⟩
  rw [Subgroup.relIndex_top_right, Subgroup.index_map_of_bijective φ.bijective]
  rwa [Subgroup.relIndex_top_right] at hdvd

theorem isSolvable_map (φ : S ≃* S') {D : Subgroup S} (h : Group.IsSolvable ↥D) :
    Group.IsSolvable ↥(D.map φ.toMonoidHom) :=
  haveI := h
  solvable_of_surjective (f := (D.equivMapOfInjective φ.toMonoidHom φ.injective).toMonoidHom)
    (D.equivMapOfInjective φ.toMonoidHom φ.injective).surjective

theorem isElemAbelian_map (φ : S ≃* S') {E : Subgroup S} (h : CFSG.Open.IsElemAbelian 3 E) :
    CFSG.Open.IsElemAbelian 3 (E.map φ.toMonoidHom) := by
  obtain ⟨hc, h3⟩ := h
  refine ⟨Subgroup.map_isMulCommutative E φ.toMonoidHom, ?_⟩
  intro x' hx'
  obtain ⟨x, hx, rfl⟩ := Subgroup.mem_map.1 hx'
  rw [← map_pow, h3 x hx, map_one]

theorem Hyp.map [Finite S] [Finite S'] (φ : S ≃* S') {U D E : Subgroup S} (h : Hyp U D E) :
    Hyp (U.map φ.toMonoidHom) (D.map φ.toMonoidHom) (E.map φ.toMonoidHom) := by
  obtain ⟨h1, h2, h3, h4, h5, h6, u, hu, hinv⟩ := h
  refine ⟨isSylowOf_map φ h1, Subgroup.map_mono h2, isSolvable_map φ h3, Subgroup.map_mono h4,
    isElemAbelian_map φ h5, ?_, φ u, ?_, ?_⟩
  · rw [Subgroup.card_map_of_injective φ.injective]
    exact h6
  · rw [Subgroup.mem_inf] at hu ⊢
    exact ⟨(map_mem_iff φ U u).2 hu.1, (map_mem_normalizer_iff φ E u).2 hu.2⟩
  · intro e' he'
    obtain ⟨e, he, rfl⟩ := Subgroup.mem_map.1 he'
    rw [MulEquiv.coe_toMonoidHom, ← map_inv, ← map_mul, ← map_mul, hinv e he, map_inv]

end Transport

section Model

open CFSG.LocalAnalysis.RankThreeUC.S15.K21dU42Cert
  CFSG.QuasithinUnique.Vol2Native.A312L.PermLat CFSG.Quasithin.H13.F431.U42

abbrev Mg : Subgroup (Equiv.Perm (Fin 45)) := Subgroup.closure {g | g ∈ cert.mGens}

abbrev Tg : Subgroup (Equiv.Perm (Fin 45)) := Subgroup.closure {g | g ∈ cert.tGens}

abbrev T0 : Subgroup ↥Mg := Tg.subgroupOf Mg

theorem mGens_eq : mGens = [x45, y45] := by
  have h0 : mGens[0]! = x45 := Equiv.ext (by decide +kernel)
  have h1 : mGens[1]! = y45 := Equiv.ext (by decide +kernel)
  rw [show mGens = [mGens[0]!, mGens[1]!] from rfl, h0, h1]

theorem mg_eq_Xs : Mg = Xs := by
  have : {g | g ∈ cert.mGens} = ({x45, y45} : Set (Equiv.Perm (Fin 45))) := by
    ext g
    simp [show cert.mGens = [x45, y45] from mGens_eq]
  rw [Mg, this]
  rfl

theorem isSylowOf_three {G : Type*} [Group G] [Finite G] {D X : Subgroup G}
    (h576 : Nat.card D = 576) (hXD : X ≤ D) (hX9 : Nat.card X = 9) :
    CFSG.ABGLocalTools.IsSylowOf 3 X D := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  rw [CFSG.ABGLocalTools.isSylowOf_iff]
  refine ⟨hXD, IsPGroup.of_card (n := 2) (by simpa using hX9), ?_⟩
  have h := Subgroup.relIndex_mul_card X D
  rw [inf_eq_left.2 hXD, hX9, h576] at h
  have hr : X.relIndex D = 64 := by omega
  rw [hr]
  decide

theorem map_conj_eq {G : Type*} [Group G] {U T : Subgroup G} (k : G)
    (hk : ∀ x, x ∈ U ↔ k⁻¹ * x * k ∈ T) : U.map (MulAut.conj k⁻¹).toMonoidHom = T := by
  ext y
  simp only [Subgroup.mem_map, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv]
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact (hk x).1 hx
  · intro hy
    exact ⟨k * y * k⁻¹, (hk _).2 (by rw [show k⁻¹ * (k * y * k⁻¹) * k = y by group]; exact hy),
      by group⟩

theorem primePower_card_two {Q : TauCeti.PrimePower} (h : Q.card = 2) :
    Q.p = 2 ∧ Q.exponent = 1 :=
  (Nat.Prime.pow_eq_iff Nat.prime_two).mp (by rw [← TauCeti.PrimePower.card_def]; exact h)

theorem exists_noncomm_of_four_dvd {S : Type} [Group S] [IsSimpleGroup S]
    (h4 : 4 ∣ Nat.card S) : ∃ a b : S, a * b ≠ b * a := by
  by_contra h
  push Not at h
  haveI : IsMulCommutative S := ⟨⟨h⟩⟩
  have hp : (Nat.card S).Prime := Group.is_simple_iff_prime_card.1 inferInstance
  rcases hp.eq_one_or_self_of_dvd 4 h4 with h1 | h1
  · omega
  · rw [← h1] at hp
    exact absurd hp (by norm_num)

end Model

section Cert

open CFSG.LocalAnalysis.RankThreeUC.S15.K21dU42Cert
  CFSG.QuasithinUnique.Vol2Native.A312L.PermLat CFSG.Quasithin.H13.F431.U42

theorem tg_le : Tg ≤ Mg := Certificates.certificate409001.1.1

theorem card_Mg : Nat.card ↥Mg = 25920 := Certificates.certificate409001.1.2.2

theorem isSylowTwo_T0 : CFSG.QuasithinUnique.IsSylowTwoOf T0 ⊤ := by
  have hU : Nat.card ↥T0 = 2 ^ 6 := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe tg_le).toEquiv]
    exact Certificates.certificate409001.1.2.1
  refine ⟨le_top, IsPGroup.of_card hU, ?_⟩
  have hidx := Subgroup.card_mul_index T0
  rw [hU, card_Mg] at hidx
  have hidx' : T0.index = 405 := by omega
  have e : (T0.subgroupOf (⊤ : Subgroup ↥Mg)).index = T0.index := Subgroup.relIndex_top_right _
  rw [e, hidx']
  decide

theorem card_cases {D : Subgroup ↥Mg} (hD : T0 ≤ D) :
    Nat.card D = 25920 ∨
      (Nat.card D = 576 ∧ Subgroup.closure {g | g ∈ L3} ≤ Mg ∧
        D = (Subgroup.closure {g | g ∈ L3}).subgroupOf Mg) ∨
      ¬ 9 ∣ Nat.card D := by
  obtain ⟨-, ⟨hmem, hover⟩, -⟩ := Certificates.certificate409001
  let Y : Subgroup (Equiv.Perm (Fin 45)) := D.map Mg.subtype
  have hTY : Tg ≤ Y := fun t ht => ⟨⟨t, tg_le ht⟩, hD (Subgroup.mem_subgroupOf.mpr ht), rfl⟩
  have hYM : Y ≤ Mg := by
    rintro _ ⟨y, -, rfl⟩
    exact y.2
  obtain ⟨j, hj, hYj⟩ := hover Y hTY hYM
  obtain ⟨hLM', hcard⟩ := hmem j hj
  have hLM : Subgroup.closure {g | g ∈ (tGens :: lat).getD j []} ≤ Mg := hLM'
  have hDj : D = (Subgroup.closure {g | g ∈ (tGens :: lat).getD j []}).subgroupOf Mg := by
    rw [← hYj]
    exact (Subgroup.comap_map_eq_self_of_injective Mg.subtype_injective D).symm
  have hDc : Nat.card D = sizes.getD j 0 := by
    rw [hDj, Nat.card_congr (Subgroup.subgroupOfEquivOfLe hLM).toEquiv]
    exact hcard
  interval_cases j
  · exact Or.inr (Or.inr (by rw [hDc]; decide))
  · exact Or.inr (Or.inr (by rw [hDc]; decide))
  · exact Or.inr (Or.inr (by rw [hDc]; decide))
  · exact Or.inr (Or.inl ⟨by rw [hDc]; rfl, hLM, hDj⟩)
  · exact Or.inr (Or.inr (by rw [hDc]; decide))
  · exact Or.inl (by rw [hDc]; rfl)

theorem d0_facts :
    ea ∈ Subgroup.closure {g | g ∈ L3} ∧ eb ∈ Subgroup.closure {g | g ∈ L3} ∧
    Nat.card (Subgroup.closure {g | g ∈ [ea, eb]}) = 9 ∧ ea * ea * ea = 1 ∧ eb * eb * eb = 1 ∧
    ∀ v ∈ Subgroup.closure {g | g ∈ L3}, ¬ (v * ea * v⁻¹ = ea⁻¹ ∧ v * eb * v⁻¹ = eb⁻¹) :=
  Certificates.certificate409001.2.2

theorem core_T0 (hns : ¬ Group.IsSolvable ↥Mg) {D E : Subgroup ↥Mg} (h : Hyp T0 D E) : False := by
  obtain ⟨-, hTD, hDs, hED, -, hE9, u, hu, hinv⟩ := h
  have h9 : 9 ∣ Nat.card D := hE9 ▸ Subgroup.card_dvd_of_le hED
  rcases card_cases hTD with h25920 | ⟨h576, hPM, hD⟩ | hnd
  · have hDtop : D = ⊤ := (Subgroup.card_eq_iff_eq_top D).1 (by rw [h25920, card_Mg])
    subst hDtop
    exact hns (solvable_of_solvable_injective (f := (Subgroup.topEquiv (G := ↥Mg)).symm.toMonoidHom)
      (Subgroup.topEquiv (G := ↥Mg)).symm.injective)
  · obtain ⟨hda, hdb, hE0card, ha3, hb3, hfree⟩ := d0_facts
    have hE0P : Subgroup.closure {g | g ∈ [ea, eb]} ≤ Subgroup.closure {g | g ∈ L3} := by
      rw [Subgroup.closure_le]
      intro g hg
      simp only [Set.mem_setOf_eq, List.mem_cons, List.not_mem_nil, or_false] at hg
      rcases hg with rfl | rfl
      exacts [hda, hdb]
    have hE0M : Subgroup.closure {g | g ∈ [ea, eb]} ≤ Mg := hE0P.trans hPM
    have hE0D : (Subgroup.closure {g | g ∈ [ea, eb]}).subgroupOf Mg ≤ D := by
      rw [hD]
      intro x hx
      exact Subgroup.mem_subgroupOf.2 (hE0P (Subgroup.mem_subgroupOf.1 hx))
    have hE0card' : Nat.card ↥((Subgroup.closure {g | g ∈ [ea, eb]}).subgroupOf Mg) = 9 := by
      rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hE0M).toEquiv]
      exact hE0card
    haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    obtain ⟨k, hkD, hk⟩ := (isSylowOf_three h576 hE0D hE0card').exists_mem_conj
      (isSylowOf_three h576 hED hE9)
    have hu1 : u ∈ T0 := (Subgroup.mem_inf.1 hu).1
    have hvD0 : k⁻¹ * u * k ∈ D := D.mul_mem (D.mul_mem (D.inv_mem hkD) (hTD hu1)) hkD
    have key : ∀ x ∈ (Subgroup.closure {g | g ∈ [ea, eb]}).subgroupOf Mg,
        (k⁻¹ * u * k) * x * (k⁻¹ * u * k)⁻¹ = x⁻¹ := by
      intro x hx
      have hkx : k * x * k⁻¹ ∈ E :=
        (hk _).2 (by rw [show k⁻¹ * (k * x * k⁻¹) * k = x by group]; exact hx)
      have h := hinv _ hkx
      calc (k⁻¹ * u * k) * x * (k⁻¹ * u * k)⁻¹ = k⁻¹ * (u * (k * x * k⁻¹) * u⁻¹) * k := by group
        _ = k⁻¹ * (k * x * k⁻¹)⁻¹ * k := by rw [h]
        _ = x⁻¹ := by group
    obtain ⟨v, hvD, hvinv⟩ : ∃ v ∈ D,
        ∀ x ∈ (Subgroup.closure {g | g ∈ [ea, eb]}).subgroupOf Mg, v * x * v⁻¹ = x⁻¹ :=
      ⟨k⁻¹ * u * k, hvD0, key⟩
    have hvP : (v : Equiv.Perm (Fin 45)) ∈ Subgroup.closure {g | g ∈ L3} := by
      rw [hD] at hvD
      exact Subgroup.mem_subgroupOf.1 hvD
    have hea : ea ∈ Subgroup.closure {g | g ∈ [ea, eb]} := Subgroup.subset_closure (by simp)
    have heb : eb ∈ Subgroup.closure {g | g ∈ [ea, eb]} := Subgroup.subset_closure (by simp)
    refine hfree _ hvP ⟨?_, ?_⟩
    · have := congrArg Subtype.val
        (hvinv ⟨ea, hE0M hea⟩ (Subgroup.mem_subgroupOf.2 hea))
      simpa using this
    · have := congrArg Subtype.val
        (hvinv ⟨eb, hE0M heb⟩ (Subgroup.mem_subgroupOf.2 heb))
      simpa using this
  · exact hnd h9

theorem no_hyp (hns : ¬ Group.IsSolvable ↥Mg) {U D E : Subgroup ↥Mg} (h : Hyp U D E) : False := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hT0 : CFSG.ABGLocalTools.IsSylowOf 2 T0 ⊤ :=
    CFSG.ABGLocalTools.isSylowOf_iff.2 isSylowTwo_T0
  obtain ⟨k, -, hk⟩ := hT0.exists_mem_conj h.1
  have hmap := Hyp.map (MulAut.conj k⁻¹) h
  rw [map_conj_eq k hk] at hmap
  exact core_T0 hns hmap

end Cert

