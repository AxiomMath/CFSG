  induction n with
  | zero => simp
  | succ n ih =>
    have hstep : (c / 3 ^ n % 3) * 3 ^ n + 3 ^ (n + 1) * (c / 3 ^ (n + 1)) =
        3 ^ n * (c / 3 ^ n) := by
      have hd : c / 3 ^ n / 3 = c / 3 ^ (n + 1) := by
        rw [Nat.div_div_eq_div_mul, pow_succ]
      calc (c / 3 ^ n % 3) * 3 ^ n + 3 ^ (n + 1) * (c / 3 ^ (n + 1))
          = (c / 3 ^ n % 3) * 3 ^ n + 3 ^ n * (3 * (c / 3 ^ n / 3)) := by
            rw [← hd, pow_succ]; ring
        _ = 3 ^ n * (c / 3 ^ n % 3 + 3 * (c / 3 ^ n / 3)) := by ring
        _ = 3 ^ n * (c / 3 ^ n) := by rw [Nat.mod_add_div]
    calc Finset.sum (Finset.range (n + 1)) (fun t => (c / 3 ^ t % 3) * 3 ^ t)
            + 3 ^ (n + 1) * (c / 3 ^ (n + 1))
        = (Finset.sum (Finset.range n) (fun t => (c / 3 ^ t % 3) * 3 ^ t)
            + (c / 3 ^ n % 3) * 3 ^ n) + 3 ^ (n + 1) * (c / 3 ^ (n + 1)) := by
          rw [Finset.sum_range_succ]
      _ = (Finset.sum (Finset.range n) (fun t => (c / 3 ^ t % 3) * 3 ^ t))
            + ((c / 3 ^ n % 3) * 3 ^ n + 3 ^ (n + 1) * (c / 3 ^ (n + 1))) := by
          rw [add_assoc]
      _ = (Finset.sum (Finset.range n) (fun t => (c / 3 ^ t % 3) * 3 ^ t))
            + 3 ^ n * (c / 3 ^ n) := by rw [hstep]
      _ = c := ih

private def ggQ2xF4b_slot (t : Fin 16) : Fin 4 := ⟨t.val / 4, by omega⟩

private def ggQ2xF4b_slot2 (t : Fin 16) : Fin 4 := ⟨t.val % 4, by omega⟩

private def ggQ2xF4b_code (M : Matrix (Fin 4) (Fin 4) (ZMod 3)) : ℕ :=
  ∑ t : Fin 16, (M (ggQ2xF4b_slot t) (ggQ2xF4b_slot2 t)).val * 3 ^ t.val

private theorem ggQ2xF4b_code_toMat (c : ℕ) (hc : c < 3 ^ 16) :
    ggQ2xF4b_code (ggQ2xF4b_toMat c) = c := by
  have h1 : ∀ t : Fin 16,
      (ggQ2xF4b_toMat c (ggQ2xF4b_slot t) (ggQ2xF4b_slot2 t)).val * 3 ^ t.val =
        (c / 3 ^ t.val % 3) * 3 ^ t.val := by
    intro t
    have ht : 4 * (t.val / 4) + t.val % 4 = t.val := Nat.div_add_mod t.val 4
    have hlt : c / 3 ^ (4 * (t.val / 4) + t.val % 4) % 3 < 3 :=
      Nat.mod_lt _ (by norm_num)
    unfold ggQ2xF4b_toMat ggQ2xF4b_slot ggQ2xF4b_slot2
    rw [ZMod.val_cast_of_lt hlt, ht]
  unfold ggQ2xF4b_code
  rw [Finset.sum_congr rfl (fun t _ => h1 t)]
  rw [Fin.sum_univ_eq_sum_range (fun t => (c / 3 ^ t % 3) * 3 ^ t) 16]
  have h := ggQ2xF4b_base3 c 16
  rw [Nat.div_eq_of_lt hc, mul_zero, add_zero] at h
  exact h

private theorem ggQ2xF4b_toMat_inj (c d : ℕ) (hc : c < 3 ^ 16) (hd : d < 3 ^ 16)
    (h : ggQ2xF4b_toMat c = ggQ2xF4b_toMat d) : c = d := by
  rw [← ggQ2xF4b_code_toMat c hc, ← ggQ2xF4b_code_toMat d hd, h]

private def ggQ2xF4b_codes : List ℕ :=
  (List.range 1152).map (fun i => ggQ2xF4b_getN ggQ2xF4b_matsN 26 i)

private def ggQ2xF4b_allDistinct : List ℕ → Bool
  | [] => true
  | a :: l => l.all (fun b => decide (a ≠ b)) && ggQ2xF4b_allDistinct l

private theorem ggQ2xF4b_Lm_zero : ggQ2xF4b_Lm 0 = 1 := by decide +kernel

private def ggQ2xF4b_chk_par : Bool :=
  (List.range 1152).all (fun i => decide (
    i = 0 ∨ (ggQ2xF4b_parent i < i ∧
      ggQ2xF4b_Lm i = ggQ2xF4b_row (ggQ2xF4b_gen i) (ggQ2xF4b_Lm (ggQ2xF4b_parent i)))))

private theorem ggQ2xF4b_chk_par_eq : ggQ2xF4b_chk_par = true := by decide +kernel

private theorem ggQ2xF4b_par_ok :
    ∀ i : Fin 1152, i.val ≠ 0 →
      ggQ2xF4b_parent i.val < i.val ∧
        ggQ2xF4b_Lm i.val =
          ggQ2xF4b_row (ggQ2xF4b_gen i.val) (ggQ2xF4b_Lm (ggQ2xF4b_parent i.val)) := by
  intro i hi
  have h := (List.all_eq_true.mp ggQ2xF4b_chk_par_eq) i.val (List.mem_range.mpr i.isLt)
  rcases of_decide_eq_true h with h0 | hc
  · exact absurd h0 hi
  · exact hc

private def ggQ2xF4b_chk_closed : Bool :=
  (List.range 1152).all (fun i => (List.finRange 4).all (fun k => decide (
    ggQ2xF4b_tab (4 * i + k.val) < 1152 ∧
      ggQ2xF4b_Lm (ggQ2xF4b_tab (4 * i + k.val)) =
        ggQ2xF4b_row k (ggQ2xF4b_Lm i))))

private theorem ggQ2xF4b_chk_closed_eq : ggQ2xF4b_chk_closed = true := by decide +kernel

private theorem ggQ2xF4b_closed_chk :
    ∀ i : Fin 1152, ∀ k : Fin 4,
      ggQ2xF4b_tab (4 * i.val + k.val) < 1152 ∧
        ggQ2xF4b_Lm (ggQ2xF4b_tab (4 * i.val + k.val)) =
          ggQ2xF4b_row k (ggQ2xF4b_Lm i.val) := by
  intro i k
  have h := (List.all_eq_true.mp ggQ2xF4b_chk_closed_eq) i.val (List.mem_range.mpr i.isLt)
  exact of_decide_eq_true ((List.all_eq_true.mp h) k (List.mem_finRange k))

private def ggQ2xF4b_chk_lt : Bool :=
  (List.range 1152).all (fun i => decide (ggQ2xF4b_getN ggQ2xF4b_matsN 26 i < 3 ^ 16))

private theorem ggQ2xF4b_chk_lt_eq : ggQ2xF4b_chk_lt = true := by decide +kernel

private theorem ggQ2xF4b_codes_lt :
    ∀ i : Fin 1152, ggQ2xF4b_getN ggQ2xF4b_matsN 26 i.val < 3 ^ 16 := by
  intro i
  exact of_decide_eq_true
    ((List.all_eq_true.mp ggQ2xF4b_chk_lt_eq) i.val (List.mem_range.mpr i.isLt))

private theorem ggQ2xF4b_nodup_of_allDistinct : ∀ l : List ℕ,
    ggQ2xF4b_allDistinct l = true → l.Nodup
  | [], _ => List.nodup_nil
  | a :: l, h => by
      rw [ggQ2xF4b_allDistinct] at h
      rw [Bool.and_eq_true] at h
      obtain ⟨h1, h2⟩ := h
      rw [List.all_eq_true] at h1
      refine List.nodup_cons.mpr ⟨?_, ggQ2xF4b_nodup_of_allDistinct l h2⟩
      intro hx
      exact (of_decide_eq_true (h1 a hx)) rfl

private theorem ggQ2xF4b_allDistinct_chk :
    ggQ2xF4b_allDistinct ggQ2xF4b_codes = true := by decide +kernel

private theorem ggQ2xF4b_codes_nodup : ggQ2xF4b_codes.Nodup :=
  ggQ2xF4b_nodup_of_allDistinct _ ggQ2xF4b_allDistinct_chk

private theorem ggQ2xF4b_codes_inj :
    ∀ i j : Fin 1152,
      ggQ2xF4b_getN ggQ2xF4b_matsN 26 i.val =
        ggQ2xF4b_getN ggQ2xF4b_matsN 26 j.val → i = j := by
  intro i j hij
  have h := (List.nodup_map_iff_inj_on (l := List.range 1152)
      (f := fun i => ggQ2xF4b_getN ggQ2xF4b_matsN 26 i) List.nodup_range).mp
    ggQ2xF4b_codes_nodup
  exact Fin.ext (h i.val (List.mem_range.mpr i.isLt) j.val (List.mem_range.mpr j.isLt) hij)

private theorem ggQ2xF4b_wit_chk :
    ∀ z : Fin 4 → ZMod 3, z ⬝ᵥ ggQ2xF4_G.mulVec z ≠ 0 →
      ggQ2xF4b_wit z < 1152 ∧ ggQ2xF4_refl z = ggQ2xF4b_Lm (ggQ2xF4b_wit z) := by
  decide +kernel

private theorem ggQ2xF4b_Lm_inj :
    Function.Injective (fun i : Fin 1152 => ggQ2xF4b_Lm i.val) := by
  intro i j hij
  have hcodes : ggQ2xF4b_getN ggQ2xF4b_matsN 26 i.val =
      ggQ2xF4b_getN ggQ2xF4b_matsN 26 j.val :=
    ggQ2xF4b_toMat_inj _ _ (ggQ2xF4b_codes_lt i) (ggQ2xF4b_codes_lt j) hij
  exact ggQ2xF4b_codes_inj i j hcodes

private theorem ggQ2xF4b_reach (i : ℕ) (hi : i < 1152) :
    ggQ2xF4b_Lm i ∈ Submonoid.closure (Set.range ggQ2xF4_S) := by
  revert hi
  refine Nat.strong_induction_on i ?_
  intro n ih hi
  rcases Nat.eq_zero_or_pos n with h0 | hpos
  · subst h0
    rw [ggQ2xF4b_Lm_zero]
    exact Submonoid.one_mem _
  · obtain ⟨hlt, heq⟩ := ggQ2xF4b_par_ok ⟨n, hi⟩ (Nat.ne_of_gt hpos)
    rw [heq, ← ggQ2xF4b_S_mul]
    exact Submonoid.mul_mem _
      (Submonoid.subset_closure ⟨ggQ2xF4b_gen n, rfl⟩)
      (ih (ggQ2xF4b_parent n) hlt (Nat.lt_trans hlt hi))

private theorem ggQ2xF4b_mem_list (x : Matrix (Fin 4) (Fin 4) (ZMod 3))
    (hx : x ∈ Submonoid.closure (Set.range ggQ2xF4_S)) :
    ∃ i, i < 1152 ∧ x = ggQ2xF4b_Lm i := by
  refine Submonoid.closure_induction_left
    (motive := fun x _ => ∃ i, i < 1152 ∧ x = ggQ2xF4b_Lm i) ?_ ?_ hx
  · exact ⟨0, by norm_num, ggQ2xF4b_Lm_zero.symm⟩
  · intro s hs y hy ih
    rcases hs with ⟨k, rfl⟩
    rcases ih with ⟨i, hi, rfl⟩
    refine ⟨ggQ2xF4b_tab (4 * i + k.val), (ggQ2xF4b_closed_chk ⟨i, hi⟩ k).1, ?_⟩
    rw [ggQ2xF4b_S_mul, ← (ggQ2xF4b_closed_chk ⟨i, hi⟩ k).2]

private theorem ggQ2xF4_card :
    Nat.card (Submonoid.closure (Set.range ggQ2xF4_S)) = 1152 := by
  let M := Submonoid.closure (Set.range ggQ2xF4_S)
  let f : Fin 1152 → M := fun i => ⟨ggQ2xF4b_Lm i.val, ggQ2xF4b_reach i.val i.isLt⟩
  have hf : Function.Bijective f := by
    constructor
    · intro i j hij
      exact ggQ2xF4b_Lm_inj (Subtype.ext_iff.mp hij)
    · intro x
      obtain ⟨i, hi, hx⟩ := ggQ2xF4b_mem_list x x.property
      exact ⟨⟨i, hi⟩, by rw [Subtype.ext_iff]; exact hx.symm⟩
  have h := Nat.card_congr (Equiv.ofBijective f hf)
  rw [Nat.card_fin] at h
  exact h.symm


private theorem ggQ2xF4_refl_mem (z : Fin 4 → ZMod 3)
    (hz : z ⬝ᵥ ggQ2xF4_G.mulVec z ≠ 0) :
    ggQ2xF4_refl z ∈ Submonoid.closure (Set.range ggQ2xF4_S) := by
  obtain ⟨hlt, heq⟩ := ggQ2xF4b_wit_chk z hz
  rw [heq]
  exact ggQ2xF4b_reach _ hlt

private theorem ggQ2xF4a_label2 (D : GGQ2Lin 3) {i j : D.ι} (hij : i ≠ j)
    (h : D.coxeter i j = 2) : D.cartan i j = 0 := by
  rcases D.isCartan.2 i j hij with ⟨hm, h1, -⟩ | ⟨hm, -, -⟩ | ⟨hm, -, -, -⟩ | ⟨hm, -, -, -⟩
  · exact h1
  · rw [h] at hm; omega
  · rw [h] at hm; omega
  · rw [h] at hm; omega

private theorem ggQ2xF4a_label3 (D : GGQ2Lin 3) {i j : D.ι} (hij : i ≠ j)
    (h : D.coxeter i j = 3) : D.cartan i j = -1 := by
  rcases D.isCartan.2 i j hij with ⟨hm, -, -⟩ | ⟨hm, h1, -⟩ | ⟨hm, -, -, -⟩ | ⟨hm, -, -, -⟩
  · rw [h] at hm; omega
  · exact h1
  · rw [h] at hm; omega
  · rw [h] at hm; omega

private theorem ggQ2xF4a_label4 (D : GGQ2Lin 3) {i j : D.ι} (hij : i ≠ j)
    (h : D.coxeter i j = 4) :
    (D.cartan i j = -1 ∧ D.cartan j i = -2) ∨ (D.cartan i j = -2 ∧ D.cartan j i = -1) := by
  rcases D.isCartan.2 i j hij with ⟨hm, -, -⟩ | ⟨hm, -, -⟩ | ⟨hm, h1, h2, h3⟩ | ⟨hm, -, -, -⟩
  · rw [h] at hm; omega
  · rw [h] at hm; omega
  · set C := D.cartan i j with hCdef
    have hle : -2 ≤ C := by nlinarith [h1, h2, h3]
    interval_cases C <;> omega
  · rw [h] at hm; omega

private def ggQ2xF4a_F4a : Matrix (Fin 4) (Fin 4) ℤ :=
  !![2, -1, 0, 0; -1, 2, -2, 0; 0, -1, 2, -1; 0, 0, -1, 2]

private def ggQ2xF4a_F4b : Matrix (Fin 4) (Fin 4) ℤ :=
  !![2, -1, 0, 0; -1, 2, -1, 0; 0, -2, 2, -1; 0, 0, -1, 2]

private theorem ggQ2xF4a_cartan_F4 (D : GGQ2Lin 3) (e : Fin 4 ≃ D.ι)
    (hF : D.coxeter = CoxeterMatrix.F₄.reindex e) :
    (∀ a b, D.cartan (e a) (e b) = ggQ2xF4a_F4a a b) ∨
      (∀ a b, D.cartan (e a) (e b) = ggQ2xF4a_F4b a b) := by
  have hFlabel : ∀ a b : Fin 4, D.coxeter (e a) (e b) = CoxeterMatrix.F₄ a b := by
    intro a b; rw [hF, CoxeterMatrix.reindex_apply]; simp
  have h12 : D.coxeter (e 1) (e 2) = 4 := by rw [hFlabel]; decide
  have hlab3 : ∀ a b : Fin 4, a ≠ b → CoxeterMatrix.F₄ a b = 3 → D.cartan (e a) (e b) = -1 :=
    fun a b hab h => ggQ2xF4a_label3 D (e.injective.ne hab) (by rw [hFlabel]; exact h)
  have hlab2 : ∀ a b : Fin 4, a ≠ b → CoxeterMatrix.F₄ a b = 2 → D.cartan (e a) (e b) = 0 :=
    fun a b hab h => ggQ2xF4a_label2 D (e.injective.ne hab) (by rw [hFlabel]; exact h)
  rcases ggQ2xF4a_label4 D (e.injective.ne (by decide : (1 : Fin 4) ≠ 2)) h12 with
    ⟨h12a, h12b⟩ | ⟨h12a, h12b⟩
  · right
    have h00 : D.cartan (e 0) (e 0) = 2 := D.isCartan.1 _
    have h11 : D.cartan (e 1) (e 1) = 2 := D.isCartan.1 _
    have h22 : D.cartan (e 2) (e 2) = 2 := D.isCartan.1 _
    have h33 : D.cartan (e 3) (e 3) = 2 := D.isCartan.1 _
    have h01 : D.cartan (e 0) (e 1) = -1 := hlab3 0 1 (by decide) (by decide)
    have h10 : D.cartan (e 1) (e 0) = -1 := hlab3 1 0 (by decide) (by decide)
    have h23 : D.cartan (e 2) (e 3) = -1 := hlab3 2 3 (by decide) (by decide)
    have h32 : D.cartan (e 3) (e 2) = -1 := hlab3 3 2 (by decide) (by decide)
    have h02 : D.cartan (e 0) (e 2) = 0 := hlab2 0 2 (by decide) (by decide)
    have h20 : D.cartan (e 2) (e 0) = 0 := hlab2 2 0 (by decide) (by decide)
    have h03 : D.cartan (e 0) (e 3) = 0 := hlab2 0 3 (by decide) (by decide)
    have h30 : D.cartan (e 3) (e 0) = 0 := hlab2 3 0 (by decide) (by decide)
    have h13 : D.cartan (e 1) (e 3) = 0 := hlab2 1 3 (by decide) (by decide)
    have h31 : D.cartan (e 3) (e 1) = 0 := hlab2 3 1 (by decide) (by decide)
    intro a b
    fin_cases a <;> fin_cases b <;>
      simp_all [ggQ2xF4a_F4b, h00, h01, h02, h03, h10, h11, h12a, h12b, h13, h20, h22, h23,
        h30, h31, h32, h33]
  · left
    have h00 : D.cartan (e 0) (e 0) = 2 := D.isCartan.1 _
    have h11 : D.cartan (e 1) (e 1) = 2 := D.isCartan.1 _
    have h22 : D.cartan (e 2) (e 2) = 2 := D.isCartan.1 _
    have h33 : D.cartan (e 3) (e 3) = 2 := D.isCartan.1 _
    have h01 : D.cartan (e 0) (e 1) = -1 := hlab3 0 1 (by decide) (by decide)
    have h10 : D.cartan (e 1) (e 0) = -1 := hlab3 1 0 (by decide) (by decide)
    have h23 : D.cartan (e 2) (e 3) = -1 := hlab3 2 3 (by decide) (by decide)
    have h32 : D.cartan (e 3) (e 2) = -1 := hlab3 3 2 (by decide) (by decide)
    have h02 : D.cartan (e 0) (e 2) = 0 := hlab2 0 2 (by decide) (by decide)
    have h20 : D.cartan (e 2) (e 0) = 0 := hlab2 2 0 (by decide) (by decide)
    have h03 : D.cartan (e 0) (e 3) = 0 := hlab2 0 3 (by decide) (by decide)
    have h30 : D.cartan (e 3) (e 0) = 0 := hlab2 3 0 (by decide) (by decide)
    have h13 : D.cartan (e 1) (e 3) = 0 := hlab2 1 3 (by decide) (by decide)
    have h31 : D.cartan (e 3) (e 1) = 0 := hlab2 3 1 (by decide) (by decide)
    intro a b
    fin_cases a <;> fin_cases b <;>
      simp_all [ggQ2xF4a_F4a, h00, h01, h02, h03, h10, h11, h12a, h12b, h13, h20, h22, h23,
        h30, h31, h32, h33]

private def ggQ2xF4a_rev : Fin 4 ≃ Fin 4 where
  toFun := Fin.rev
  invFun := Fin.rev
  left_inv i := by fin_cases i <;> decide
  right_inv i := by fin_cases i <;> decide

private theorem ggQ2xF4a_F4b_rev (i j : Fin 4) :
    ggQ2xF4a_F4b (Fin.rev i) (Fin.rev j) = ggQ2xF4a_F4a i j := by
  fin_cases i <;> fin_cases j <;> decide

private theorem ggQ2xF4_cartan (D : GGQ2Lin 3) (e : Fin 4 ≃ D.ι)
    (hF : D.coxeter = CoxeterMatrix.F₄.reindex e) :
    ∃ e' : Fin 4 ≃ D.ι, ∀ i j, (D.cartan (e' i) (e' j) : ZMod 3) = ggQ2xF4_C i j := by
  rcases ggQ2xF4a_cartan_F4 D e hF with hC | hC
  · refine ⟨e, fun i j => ?_⟩
    rw [hC i j]
    fin_cases i <;> fin_cases j <;> decide
  · refine ⟨ggQ2xF4a_rev.trans e, fun i j => ?_⟩
    have h1 : D.cartan (e (Fin.rev i)) (e (Fin.rev j)) = ggQ2xF4a_F4a i j := by
      have h := hC (Fin.rev i) (Fin.rev j)
      rwa [ggQ2xF4a_F4b_rev i j] at h
    change (D.cartan (e (Fin.rev i)) (e (Fin.rev j)) : ZMod 3) = ggQ2xF4_C i j
    rw [h1]
    fin_cases i <;> fin_cases j <;> decide

private noncomputable def ggQ2xF4_basis (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι) :
    Basis (Fin 4) (ZMod 3) D.V :=
  basisOfLinearIndependentOfCardEqFinrank (hbas.1.comp e e.injective) (by
    rw [← hbas.2]
    exact Fintype.card_congr e)

private lemma ggQ2xF4_basis_apply (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (i : Fin 4) : ggQ2xF4_basis D hbas e i = D.coroot (e i) :=
  congrFun (coe_basisOfLinearIndependentOfCardEqFinrank _ _) i

private noncomputable def ggQ2xF4_tauC (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι) :
    D.V ≃ₗ[ZMod 3] (Fin 4 → ZMod 3) :=
  (ggQ2xF4_basis D hbas e).equivFun

private lemma ggQ2xF4_tau_coroot (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (i : Fin 4) : ggQ2xF4_tauC D hbas e (D.coroot (e i)) = Pi.single i 1 := by
  unfold ggQ2xF4_tauC
  rw [← ggQ2xF4_basis_apply D hbas e i]
  ext j
  rw [Basis.equivFun_self]
  by_cases h : i = j
  · subst h; simp [Pi.single_eq_same]
  · rw [if_neg h, Pi.single_eq_of_ne (Ne.symm h)]

private lemma ggQ2xF4_root (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j) (i : Fin 4) (v : D.V) :
    D.root (e i) v = (ggQ2xF4_C.mulVec (ggQ2xF4_tauC D hbas e v)) i := by
  have hv : v = ∑ j : Fin 4, (ggQ2xF4_tauC D hbas e v) j • D.coroot (e j) := by
    conv_lhs => rw [← (ggQ2xF4_basis D hbas e).equivFun.symm_apply_apply v]
    rw [Basis.equivFun_symm_apply]
    exact Finset.sum_congr rfl (fun j _ => by
      rw [ggQ2xF4_basis_apply D hbas e j]
      rfl)
  conv_lhs => rw [hv]
  rw [map_sum, Matrix.mulVec_apply, dotProduct]
  apply Finset.sum_congr rfl
  intro j _
  rw [map_smul, D.pairing, hC i j, Matrix.row_apply, smul_eq_mul, mul_comm]

private lemma ggQ2xF4_simple_coord (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j) (j : Fin 4)
    (v : Fin 4 → ZMod 3) :
    ggLinConj (ggQ2xF4_tauC D hbas e) (D.simpleRefl (e j)) v =
      v - (ggQ2xF4_C.mulVec v j) • Pi.single j 1 := by
  rw [ggLinConj_apply]
  unfold GGQ2Lin.simpleRefl
  rw [Module.reflection_apply, map_sub, map_smul]
  rw [ggQ2xF4_root D hbas e hC j ((ggQ2xF4_tauC D hbas e).symm v),
    ggQ2xF4_tau_coroot D hbas e j]
  simp

private lemma ggQ2xF4a_simplePair_mem (D : GGQ2Lin 3) (i : D.ι) :
    (D.root i, D.coroot i) ∈ D.rootPairs :=
  ⟨i, 1, D.weyl.one_mem, rfl, by
    change D.root i = (D.root i).comp (LinearMap.id : D.V →ₗ[ZMod 3] D.V)
    rw [LinearMap.comp_id]⟩

private lemma ggQ2xF4a_eq_one_or_neg_one (a : ZMod 3) (ha : a ≠ 0) : a = 1 ∨ a = -1 :=
  (by decide : ∀ a : ZMod 3, a ≠ 0 → a = 1 ∨ a = -1) a ha

private theorem ggQ2xF4a_G_rel (di : Fin 4 → ZMod 3)
    (hsymm : ∀ i j, di i * ggQ2xF4_C i j = di j * ggQ2xF4_C j i) :
    ∀ i j, di i * ggQ2xF4_C i j = di 0 * ggQ2xF4_G i j := by
  revert di
  decide +kernel

private theorem ggQ2xF4a_form_eq (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j)
    (β : LinearMap.BilinForm (ZMod 3) D.V) (hβ : β.IsSymm)
    (d : ↥D.rootPairs → ZMod 3) (hd : ∀ γ, d γ ≠ 0)
    (hβh : ∀ γ v, β γ.1.2 v = d γ * γ.1.1 v) :
    ∃ lam : ZMod 3, lam ≠ 0 ∧ ∀ u v : Fin 4 → ZMod 3,
      β ((ggQ2xF4_tauC D hbas e).symm u) ((ggQ2xF4_tauC D hbas e).symm v) =
        lam * (u ⬝ᵥ ggQ2xF4_G.mulVec v) := by
  classical
  let pair : Fin 4 → ↥D.rootPairs := fun i =>
    ⟨(D.root (e i), D.coroot (e i)), ggQ2xF4a_simplePair_mem D (e i)⟩
  let di : Fin 4 → ZMod 3 := fun i => d (pair i)
  have hdi_ne : ∀ i, di i ≠ 0 := fun i => hd (pair i)
  have hβhi : ∀ i v, β (D.coroot (e i)) v = di i * D.root (e i) v :=
    fun i v => hβh (pair i) v
  have hsymm : ∀ i j, di i * ggQ2xF4_C i j = di j * ggQ2xF4_C j i := by
    intro i j
    have h1 : β (D.coroot (e i)) (D.coroot (e j)) = di i * ggQ2xF4_C i j := by
      rw [hβhi i (D.coroot (e j)), D.pairing, hC i j]
    have h2 : β (D.coroot (e i)) (D.coroot (e j)) = β (D.coroot (e j)) (D.coroot (e i)) :=
      hβ.eq _ _
    have h3 : β (D.coroot (e j)) (D.coroot (e i)) = di j * ggQ2xF4_C j i := by
      rw [hβhi j (D.coroot (e i)), D.pairing, hC j i]
    rw [← h1, h2, h3]
  have hG := ggQ2xF4a_G_rel di hsymm
  let b : Basis (Fin 4) (ZMod 3) D.V := ggQ2xF4_basis D hbas e
  let B : LinearMap.BilinForm (ZMod 3) D.V :=
    LinearMap.BilinForm.comp (Matrix.toBilin' ggQ2xF4_G)
      ((ggQ2xF4_tauC D hbas e) : D.V →ₗ[ZMod 3] (Fin 4 → ZMod 3))
      ((ggQ2xF4_tauC D hbas e) : D.V →ₗ[ZMod 3] (Fin 4 → ZMod 3))
  have hB : ∀ u v, B u v =
      Matrix.toBilin' ggQ2xF4_G (ggQ2xF4_tauC D hbas e u) (ggQ2xF4_tauC D hbas e v) :=
    fun u v => LinearMap.BilinForm.comp_apply _ _ _ u v
  have hβeq : β = di 0 • B := by
    apply LinearMap.BilinForm.ext_basis b
    intro i j
    rw [ggQ2xF4_basis_apply D hbas e i, ggQ2xF4_basis_apply D hbas e j]
    simp only [LinearMap.smul_apply, smul_eq_mul, hB, ggQ2xF4_tau_coroot D hbas e i,
      ggQ2xF4_tau_coroot D hbas e j, Matrix.toBilin'_single]
    rw [hβhi i (D.coroot (e j)), D.pairing, hC i j]
    exact hG i j
  refine ⟨di 0, hdi_ne 0, fun u v => ?_⟩
  rw [hβeq]
  simp only [LinearMap.smul_apply, smul_eq_mul, hB, LinearEquiv.apply_symm_apply,
    Matrix.toBilin'_apply']

private theorem ggQ2xF4_S1 (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j)
    (A : Subgroup (D.V ≃ₗ[ZMod 3] D.V)) (hW : D.weyl ≤ A) (hTF : TransvectionFree A)
    {c : Fin 4 → ZMod 3} {φ : Module.Dual (ZMod 3) (Fin 4 → ZMod 3)} (h : φ c = 2)
    (ht : Module.reflection h ∈
      A.map (ggLinConj (ggQ2xF4_tauC D hbas e)).toMonoidHom) :
    ∃ ε : ZMod 3, (ε = 1 ∨ ε = -1) ∧ ∀ v, φ v = ε * (c ⬝ᵥ ggQ2xF4_G.mulVec v) := by
  classical
  have h4 : 4 ≤ Fintype.card D.ι :=
    le_of_eq ((Fintype.card_congr e).symm.trans (Fintype.card_fin 4)).symm
  obtain ⟨β, d, hβ, hd, hβh⟩ := ggQ2_exists_invariantForm (p := 3) rfl D hbas h4
  obtain ⟨lam, hlam_ne, hlam⟩ := ggQ2xF4a_form_eq D hbas e hC β hβ d hd hβh
  obtain ⟨g, hgA, hg_eq⟩ := Subgroup.mem_map.mp ht
  let τ := ggQ2xF4_tauC D hbas e
  let h' : Module.Dual (ZMod 3) D.V := φ.comp (τ : D.V →ₗ[ZMod 3] (Fin 4 → ZMod 3))
  have hh' : h' (τ.symm c) = 2 := by
    change φ (τ (τ.symm c)) = 2
    rw [LinearEquiv.apply_symm_apply]
    exact h
  have hg_refl : g = Module.reflection hh' := by
    ext w
    apply τ.injective
    have h1 : τ (g w) = (Module.reflection h) (τ w) := by
      have hh := DFunLike.congr_fun hg_eq (τ w)
      change ggLinConj τ g (τ w) = (Module.reflection h) (τ w) at hh
      rwa [ggLinConj_apply, LinearEquiv.symm_apply_apply] at hh
    rw [h1, Module.reflection_apply (τ w) h, Module.reflection_apply w hh',
      map_sub, map_smul, LinearEquiv.apply_symm_apply]
    rfl
  have hgA' : Module.reflection hh' ∈ A := by rw [← hg_refl]; exact hgA
  obtain ⟨ε'', hε'', hφ''⟩ :=
    ggQ2_refl_orthogonal (p := 3) rfl D hbas h4 β hβ d hd hβh A hW hTF
      (c := τ.symm c) (φ := h') hh' hgA'
  refine ⟨ε'' * lam, ?_, ?_⟩
  · rcases hε'' with h1 | h1 <;>
      rcases ggQ2xF4a_eq_one_or_neg_one lam hlam_ne with h2 | h2 <;>
        rw [h1, h2] <;> decide
  · intro v
    have h1 := hφ'' (τ.symm v)
    have h2 : h' (τ.symm v) = φ v := by
      change φ (τ (τ.symm v)) = φ v
      rw [LinearEquiv.apply_symm_apply]
    rw [h2, hlam c v] at h1
    rw [h1, mul_assoc]

private noncomputable def ggQ2xF4_gm (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (g : D.V ≃ₗ[ZMod 3] D.V) : Matrix (Fin 4) (Fin 4) (ZMod 3) :=
  LinearMap.toMatrix'
    ((ggLinConj (ggQ2xF4_tauC D hbas e) g : (Fin 4 → ZMod 3) ≃ₗ[ZMod 3] (Fin 4 → ZMod 3)) :
      (Fin 4 → ZMod 3) →ₗ[ZMod 3] (Fin 4 → ZMod 3))

private lemma ggQ2xF4c_gm_one (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι) :
    ggQ2xF4_gm D hbas e 1 = 1 := by
  rw [ggQ2xF4_gm, map_one]
  exact LinearMap.toMatrix'_one

private lemma ggQ2xF4c_gm_mul (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (g h : D.V ≃ₗ[ZMod 3] D.V) :
    ggQ2xF4_gm D hbas e (g * h) =
      ggQ2xF4_gm D hbas e g * ggQ2xF4_gm D hbas e h := by
  rw [ggQ2xF4_gm, ggQ2xF4_gm, ggQ2xF4_gm, map_mul, LinearEquiv.coe_toLinearMap_mul]
  exact LinearMap.toMatrix'_mul _ _

private lemma ggQ2xF4c_gm_inj (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι) :
    Function.Injective (ggQ2xF4_gm D hbas e) := by
  intro g h hgh
  have h1 : ((ggLinConj (ggQ2xF4_tauC D hbas e) g :
        (Fin 4 → ZMod 3) ≃ₗ[ZMod 3] (Fin 4 → ZMod 3)) :
      (Fin 4 → ZMod 3) →ₗ[ZMod 3] (Fin 4 → ZMod 3)) =
      ((ggLinConj (ggQ2xF4_tauC D hbas e) h :
        (Fin 4 → ZMod 3) ≃ₗ[ZMod 3] (Fin 4 → ZMod 3)) :
      (Fin 4 → ZMod 3) →ₗ[ZMod 3] (Fin 4 → ZMod 3)) := by
    have := congrArg Matrix.toLin' hgh
    simpa [ggQ2xF4_gm, Matrix.toLin'_toMatrix'] using this
  have h2 : ggLinConj (ggQ2xF4_tauC D hbas e) g =
      ggLinConj (ggQ2xF4_tauC D hbas e) h :=
    LinearEquiv.toLinearMap_injective h1
  exact (ggLinConj (ggQ2xF4_tauC D hbas e)).injective h2

private lemma ggQ2xF4c_gm_simple (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j) (j : Fin 4) :
    ggQ2xF4_gm D hbas e (D.simpleRefl (e j)) = ggQ2xF4_S j := by
  ext i k
  rw [ggQ2xF4_gm, LinearMap.toMatrix'_apply]
  change ggLinConj (ggQ2xF4_tauC D hbas e) (D.simpleRefl (e j)) (Pi.single k 1) i =
    ggQ2xF4_S j i k
  rw [ggQ2xF4_simple_coord D hbas e hC j, ggQ2xF4_S]
  simp only [Matrix.mulVec_single_one, Matrix.sub_apply, Matrix.one_apply,
    Matrix.mul_apply, Matrix.single_apply, Pi.sub_apply, Pi.smul_apply, Pi.single_apply,
    smul_eq_mul, Matrix.col_apply]
  by_cases hji : j = i
  · subst hji
    simp [Finset.sum_ite_eq', Finset.mem_univ]
  · simp [hji, Ne.symm hji]

private lemma ggQ2xF4c_inv_simpleRefl (D : GGQ2Lin 3) (k : D.ι) :
    (D.simpleRefl k)⁻¹ = D.simpleRefl k := by
  refine inv_eq_of_mul_eq_one_right ?_
  ext v
  exact Module.involutive_reflection (D.root_coroot_self k) v

private lemma ggQ2xF4c_closure_inv_mem (D : GGQ2Lin 3)
    (x : D.V ≃ₗ[ZMod 3] D.V) (hx : x ∈ Submonoid.closure (Set.range D.simpleRefl)) :
    x⁻¹ ∈ Submonoid.closure (Set.range D.simpleRefl) := by
  refine Submonoid.closure_induction (s := Set.range D.simpleRefl) ?_ ?_ ?_ hx
  · intro y hy
    obtain ⟨k, rfl⟩ := hy
    rw [ggQ2xF4c_inv_simpleRefl D k]
    exact Submonoid.subset_closure ⟨k, rfl⟩
  · simp
  · intro y z hy hz hy' hz'
    rw [mul_inv_rev]
    exact Submonoid.mul_mem _ hz' hy'

private lemma ggQ2xF4c_mem_closure_iff (D : GGQ2Lin 3)
    (x : D.V ≃ₗ[ZMod 3] D.V) :
    x ∈ Subgroup.closure (Set.range D.simpleRefl) ↔
      x ∈ Submonoid.closure (Set.range D.simpleRefl) := by
  constructor
  · intro hx
    refine Subgroup.closure_induction (k := Set.range D.simpleRefl) ?_ ?_ ?_ ?_ hx
    · intro y hy
      exact Submonoid.subset_closure hy
    · exact Submonoid.one_mem _
    · intro y z hy hz hy' hz'
      exact Submonoid.mul_mem _ hy' hz'
    · intro y hy hy'
      exact ggQ2xF4c_closure_inv_mem D y hy'
  · intro hx
    exact Submonoid.closure_le.mpr (fun y hy => Subgroup.subset_closure hy) hx

private lemma ggQ2xF4c_gm_image_weyl (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j) :
    (Submonoid.closure (Set.range ggQ2xF4_S) : Set (Matrix (Fin 4) (Fin 4) (ZMod 3))) ⊆
      ggQ2xF4_gm D hbas e '' (D.weyl : Set (D.V ≃ₗ[ZMod 3] D.V)) := by
  intro m hm
  refine Submonoid.closure_induction (s := Set.range ggQ2xF4_S) ?_ ?_ ?_ hm
  · intro x hx
    obtain ⟨j, rfl⟩ := hx
    refine ⟨D.simpleRefl (e j), ?_, ggQ2xF4c_gm_simple D hbas e hC j⟩
    rw [GGQ2Lin.weyl, GGQ2Lin.parab]
    exact Subgroup.subset_closure ⟨e j, Set.mem_univ _, rfl⟩
  · exact ⟨1, D.weyl.one_mem, ggQ2xF4c_gm_one D hbas e⟩
  · intro x y hx hy hx' hy'
    obtain ⟨g, hg, rfl⟩ := hx'
    obtain ⟨h, hh, rfl⟩ := hy'
    exact ⟨g * h, D.weyl.mul_mem hg hh, ggQ2xF4c_gm_mul D hbas e g h⟩

private theorem ggQ2xF4_weyl_iff (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j)
    (g : D.V ≃ₗ[ZMod 3] D.V) :
    g ∈ D.weyl ↔ ggQ2xF4_gm D hbas e g ∈ Submonoid.closure (Set.range ggQ2xF4_S) := by
  constructor
  · intro hg
    have hgW : g ∈ Subgroup.closure (Set.range D.simpleRefl) := by
      simpa [GGQ2Lin.weyl, GGQ2Lin.parab, Set.image_univ] using hg
    have hgM : g ∈ Submonoid.closure (Set.range D.simpleRefl) :=
      (ggQ2xF4c_mem_closure_iff D g).1 hgW
    refine Submonoid.closure_induction (s := Set.range D.simpleRefl) ?_ ?_ ?_ hgM
    · intro x hx
      obtain ⟨k, rfl⟩ := hx
      have hk : D.simpleRefl k = D.simpleRefl (e (e.symm k)) := by
        rw [Equiv.apply_symm_apply]
      rw [hk, ggQ2xF4c_gm_simple D hbas e hC (e.symm k)]
      exact Submonoid.subset_closure ⟨e.symm k, rfl⟩
    · rw [ggQ2xF4c_gm_one D hbas e]
      exact Submonoid.one_mem _
    · intro x y hx hy hx' hy'
      rw [ggQ2xF4c_gm_mul D hbas e x y]
      exact Submonoid.mul_mem _ hx' hy'
  · intro hM
    obtain ⟨g', hg'W, hgg⟩ := ggQ2xF4c_gm_image_weyl D hbas e hC hM
    have hg'g : g' = g := ggQ2xF4c_gm_inj D hbas e hgg
    rwa [hg'g] at hg'W

private theorem ggQ2xF4_weyl_card (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j) :
    Nat.card D.weyl = 1152 := by
  have hsub : (ggQ2xF4_gm D hbas e '' (D.weyl : Set (D.V ≃ₗ[ZMod 3] D.V))) =
      (Submonoid.closure (Set.range ggQ2xF4_S) :
        Set (Matrix (Fin 4) (Fin 4) (ZMod 3))) := by
    apply Set.Subset.antisymm
    · rintro _ ⟨g, hg, rfl⟩
      exact (ggQ2xF4_weyl_iff D hbas e hC g).1 hg
    · exact ggQ2xF4c_gm_image_weyl D hbas e hC
  let f : D.weyl → Submonoid.closure (Set.range ggQ2xF4_S) := fun g =>
    ⟨ggQ2xF4_gm D hbas e (g : D.V ≃ₗ[ZMod 3] D.V),
      (ggQ2xF4_weyl_iff D hbas e hC (g : D.V ≃ₗ[ZMod 3] D.V)).1 g.2⟩
  have hf_inj : Function.Injective f := by
    intro g h hgh
    apply Subtype.ext
    exact ggQ2xF4c_gm_inj D hbas e (congrArg Subtype.val hgh)
  have hf_surj : Function.Surjective f := by
    intro m
    have hm : (m : Matrix (Fin 4) (Fin 4) (ZMod 3)) ∈
        ggQ2xF4_gm D hbas e '' (D.weyl : Set (D.V ≃ₗ[ZMod 3] D.V)) := by
      rw [hsub]
      exact m.2
    obtain ⟨g, hg, hgm⟩ := hm
    exact ⟨⟨g, hg⟩, Subtype.ext hgm⟩
  have hcard : Nat.card D.weyl =
      Nat.card (Submonoid.closure (Set.range ggQ2xF4_S)) :=
    Nat.card_congr (Equiv.ofBijective f ⟨hf_inj, hf_surj⟩)
  rw [hcard, ggQ2xF4_card]

private lemma ggQ2xF4c_G_symm_apply (i j : Fin 4) :
    ggQ2xF4_G i j = ggQ2xF4_G j i := by
  fin_cases i <;> fin_cases j <;> decide

private lemma ggQ2xF4c_dot_mulVec_single (c : Fin 4 → ZMod 3) (k : Fin 4) :
    c ⬝ᵥ ggQ2xF4_G.mulVec (Pi.single k 1) = (ggQ2xF4_G.mulVec c) k := by
  rw [Matrix.mulVec_single_one]
  simp only [dotProduct, Matrix.col_apply, Matrix.mulVec]
  exact Finset.sum_congr rfl (fun i _ => by
    rw [ggQ2xF4c_G_symm_apply i k, mul_comm])

private lemma ggQ2xF4c_toMatrix_refl_of_orth {c : Fin 4 → ZMod 3} {ε : ZMod 3}
    {φ : Module.Dual (ZMod 3) (Fin 4 → ZMod 3)} (hφ : φ c = 2)
    (horth : ∀ v, φ v = ε * (c ⬝ᵥ ggQ2xF4_G.mulVec v)) :
    LinearMap.toMatrix' ((Module.reflection hφ :
        (Fin 4 → ZMod 3) ≃ₗ[ZMod 3] (Fin 4 → ZMod 3)) :
      (Fin 4 → ZMod 3) →ₗ[ZMod 3] (Fin 4 → ZMod 3)) = ggQ2xF4_refl c := by
  have hcG : ε * (c ⬝ᵥ ggQ2xF4_G.mulVec c) = 2 := by
    rw [← horth c, hφ]
  have hz : c ⬝ᵥ ggQ2xF4_G.mulVec c ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hcG
    exact absurd hcG.symm (by decide : (2 : ZMod 3) ≠ 0)
  have hε : ε = 2 / (c ⬝ᵥ ggQ2xF4_G.mulVec c) := by
    rw [eq_div_iff hz]
    exact hcG
  ext i k
  rw [LinearMap.toMatrix'_apply, ggQ2xF4_refl, ← hε]
  change Module.reflection hφ (Pi.single k 1) i =
    (1 - ε • Matrix.vecMulVec c (ggQ2xF4_G.mulVec c)) i k
  rw [Module.reflection_apply, horth, ggQ2xF4c_dot_mulVec_single]
  simp only [Pi.single_apply, Matrix.one_apply, Pi.sub_apply, Pi.smul_apply,
    Matrix.sub_apply, Matrix.smul_apply, Matrix.vecMulVec_apply, smul_eq_mul]
  split_ifs <;> ring

private theorem ggQ2xF4_reflGp_le (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j)
    (A : Subgroup (D.V ≃ₗ[ZMod 3] D.V)) (hW : D.weyl ≤ A) (hTF : TransvectionFree A) :
    reflGp A ≤ D.weyl := by
  rw [reflGp, Subgroup.closure_le]
  rintro t ⟨htA, htR⟩
  obtain ⟨c₀, φ₀, h₀, rfl⟩ := htR
  have hrefl : IsReflLin
      (ggLinConj (ggQ2xF4_tauC D hbas e) (Module.reflection h₀)) :=
    (ggLinConj_isReflLin (ggQ2xF4_tauC D hbas e) _).2 ⟨c₀, φ₀, h₀, rfl⟩
  obtain ⟨c, φ, hc, h_eq⟩ := hrefl
  have hmem : Module.reflection hc ∈
      A.map (ggLinConj (ggQ2xF4_tauC D hbas e)).toMonoidHom :=
    Subgroup.mem_map.mpr ⟨Module.reflection h₀, htA, h_eq⟩
  obtain ⟨ε, hε, horth⟩ := ggQ2xF4_S1 D hbas e hC A hW hTF hc hmem
  have hz : c ⬝ᵥ ggQ2xF4_G.mulVec c ≠ 0 := by
    intro h0
    have h2 := horth c
    rw [hc, h0, mul_zero] at h2
    exact absurd h2 (by decide : (2 : ZMod 3) ≠ 0)
  have hgm : ggQ2xF4_gm D hbas e (Module.reflection h₀) = ggQ2xF4_refl c := by
    rw [ggQ2xF4_gm, h_eq]
    exact ggQ2xF4c_toMatrix_refl_of_orth hc horth
  exact (ggQ2xF4_weyl_iff D hbas e hC (Module.reflection h₀)).2 (by
    rw [hgm]
    exact ggQ2xF4_refl_mem c hz)

private lemma ggQ2xF4_weyl_le_reflGp (D : GGQ2Lin 3) (A : Subgroup (D.V ≃ₗ[ZMod 3] D.V))
    (hW : D.weyl ≤ A) : D.weyl ≤ reflGp A := by
  unfold GGQ2Lin.weyl GGQ2Lin.parab
  rw [Subgroup.closure_le]
  rintro _ ⟨k, -, rfl⟩
  exact Subgroup.subset_closure ⟨hW (Subgroup.subset_closure ⟨k, Set.mem_univ k, rfl⟩),
    D.coroot k, D.root k, D.root_coroot_self k, rfl⟩

theorem ggQ2_thmB_F4 (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hF : D.coxeter = CoxeterMatrix.F₄.reindex e)
    (A : Subgroup (D.V ≃ₗ[ZMod 3] D.V)) (hW : D.weyl ≤ A) (hTF : TransvectionFree A) :
    D.FCell A := by
  obtain ⟨e', hC⟩ := ggQ2xF4_cartan D e hF
  refine ⟨by rw [← Fintype.card_congr e, Fintype.card_fin], ?_⟩
  have h : reflGp A = D.weyl :=
    le_antisymm (ggQ2xF4_reflGp_le D hbas e' hC A hW hTF) (ggQ2xF4_weyl_le_reflGp D A hW)
  rw [h]
  exact ggQ2xF4_weyl_card D hbas e' hC

private def ggQ2xF4_fix (i : Fin 4) : Fin 4 → ZMod 3 :=
  (![![2, 0, 2, 1], ![0, 0, 1, 2], ![1, 2, 0, 0], ![2, 1, 0, 2]] : Fin 4 → Fin 4 → ZMod 3) i

private lemma ggQ2xF4d1_simple_fixed_iff (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j) (j : Fin 4) (v : D.V) :
    D.simpleRefl (e j) v = v ↔
      (ggQ2xF4_C.mulVec (ggQ2xF4_tauC D hbas e v)) j = 0 := by
  have hkey : ggLinConj (ggQ2xF4_tauC D hbas e) (D.simpleRefl (e j))
      (ggQ2xF4_tauC D hbas e v) = ggQ2xF4_tauC D hbas e (D.simpleRefl (e j) v) := by
    rw [ggLinConj_apply, LinearEquiv.symm_apply_apply]
  have hsc := ggQ2xF4_simple_coord D hbas e hC j (ggQ2xF4_tauC D hbas e v)
  constructor
  · intro hv
    have h1 : (ggQ2xF4_C.mulVec (ggQ2xF4_tauC D hbas e v)) j •
        (Pi.single j 1 : Fin 4 → ZMod 3) = 0 := by
      have h2 : ggQ2xF4_tauC D hbas e v -
          (ggQ2xF4_C.mulVec (ggQ2xF4_tauC D hbas e v)) j •
            (Pi.single j 1 : Fin 4 → ZMod 3) = ggQ2xF4_tauC D hbas e v := by
        rw [← hsc, hkey, hv]
      exact sub_eq_self.mp h2
    rcases smul_eq_zero.mp h1 with h0 | h0
    · exact h0
    · exact absurd (congrFun h0 j) (by simp [Pi.single_eq_same])
  · intro h0
    apply (ggQ2xF4_tauC D hbas e).injective
    rw [← hkey, hsc, h0, zero_smul, sub_zero]

private lemma ggQ2xF4d1_fix_spec :
    ∀ (i₀ : Fin 4) (v : Fin 4 → ZMod 3),
      (∀ i, i ≠ i₀ → (ggQ2xF4_C.mulVec v) i = 0) ↔
        ∃ s : ZMod 3, v = s • ggQ2xF4_fix i₀ := by
  intro i₀
  fin_cases i₀ <;> decide +kernel

private lemma ggQ2xF4d1_parab_fixed_iff (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j) (i₀ : Fin 4) (v : D.V) :
    (∀ g ∈ D.parab {k | k ≠ e i₀}, g v = v) ↔
      ∀ i, i ≠ i₀ → (ggQ2xF4_C.mulVec (ggQ2xF4_tauC D hbas e v)) i = 0 := by
  constructor
  · intro hw i hi
    have hmem : D.simpleRefl (e i) ∈ D.parab {k | k ≠ e i₀} := by
      rw [GGQ2Lin.parab]
      refine Subgroup.subset_closure ⟨e i, ?_, rfl⟩
      intro h
      exact hi (e.injective h)
    exact (ggQ2xF4d1_simple_fixed_iff D hbas e hC i v).mp (hw _ hmem)
  · intro hw g hg
    have hg' : g ∈ Subgroup.closure (D.simpleRefl '' {k | k ≠ e i₀}) := by
      simpa only [GGQ2Lin.parab] using hg
    refine Subgroup.closure_induction (p := fun x _ => x v = v) ?_ ?_ ?_ ?_ hg'
    · rintro x ⟨k, hk, rfl⟩
      obtain ⟨i, rfl⟩ := e.surjective k
      have hi : i ≠ i₀ := fun h0 => hk (by rw [h0])
      exact (ggQ2xF4d1_simple_fixed_iff D hbas e hC i v).mpr (hw i hi)
    · rfl
    · intro x y _ _ hx' hy'
      rw [LinearEquiv.mul_apply, hy', hx']
    · intro x _ hx'
      apply x.injective
      rw [hx']
      exact x.apply_symm_apply v

private theorem ggQ2xF4_cell_fixed (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j) (i₀ : Fin 4) (x : D.V)
    (hx : ∀ v, (∀ g ∈ D.parab {k | k ≠ e i₀}, g v = v) ↔ v ∈ Submodule.span (ZMod 3) {x}) :
    Submodule.span (ZMod 3) {ggQ2xF4_tauC D hbas e x} =
      Submodule.span (ZMod 3) {ggQ2xF4_fix i₀} := by
  have hτx : ggQ2xF4_tauC D hbas e x ∈ Submodule.span (ZMod 3) {ggQ2xF4_fix i₀} := by
    have hfix := (ggQ2xF4d1_parab_fixed_iff D hbas e hC i₀ x).mp
      ((hx x).mpr (Submodule.mem_span_singleton_self x))
    obtain ⟨s, hs⟩ := (ggQ2xF4d1_fix_spec i₀ (ggQ2xF4_tauC D hbas e x)).mp hfix
    rw [Submodule.mem_span_singleton]
    exact ⟨s, hs.symm⟩
  have hxspan : ggQ2xF4_fix i₀ ∈ Submodule.span (ZMod 3) {ggQ2xF4_tauC D hbas e x} := by
    have h0 : ∀ i, i ≠ i₀ → (ggQ2xF4_C.mulVec (ggQ2xF4_fix i₀)) i = 0 :=
      (ggQ2xF4d1_fix_spec i₀ (ggQ2xF4_fix i₀)).mpr ⟨1, by rw [one_smul]⟩
    have hsymm : (ggQ2xF4_tauC D hbas e).symm (ggQ2xF4_fix i₀) ∈
        Submodule.span (ZMod 3) {x} := by
      apply (hx _).mp
      rw [ggQ2xF4d1_parab_fixed_iff D hbas e hC i₀]
      intro i hi
      simpa only [LinearEquiv.apply_symm_apply] using h0 i hi
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hsymm
    rw [Submodule.mem_span_singleton]
    refine ⟨a, ?_⟩
    have h := congrArg (ggQ2xF4_tauC D hbas e) ha
    rw [map_smul, LinearEquiv.apply_symm_apply] at h
    exact h
  exact le_antisymm (Submodule.span_le.mpr (Set.singleton_subset_iff.mpr hτx))
    (Submodule.span_le.mpr (Set.singleton_subset_iff.mpr hxspan))

private lemma ggQ2xF4d1_two_nbrs (D : GGQ2Lin 3) (e : Fin 4 ≃ D.ι) (i p q : Fin 4)
    (hai : D.a = e i) (hpq : p ≠ q) (hpi : p ≠ i) (hqi : q ≠ i)
    (hp : (D.cartan (e i) (e p) : ZMod 3) ≠ 0)
    (hq : (D.cartan (e i) (e q) : ZMod 3) ≠ 0) : False := by
  obtain ⟨c, _hc, huniq⟩ := D.a_leaf
  have hpne : e p ≠ D.a := fun h => hpi (e.injective (h.trans hai))
  have hqne : e q ≠ D.a := fun h => hqi (e.injective (h.trans hai))
  have hpint : D.cartan D.a (e p) ≠ 0 := by
    rw [hai]
    intro h0
    exact hp (by rw [h0]; simp)
  have hqint : D.cartan D.a (e q) ≠ 0 := by
    rw [hai]
    intro h0
    exact hq (by rw [h0]; simp)
  have hpc : e p = c := huniq (e p) ⟨hpne, hpint⟩
  have hqc : e q = c := huniq (e q) ⟨hqne, hqint⟩
  exact hpq (e.injective (hpc.trans hqc.symm))

private theorem ggQ2xF4_cell_leaf (D : GGQ2Lin 3) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j) :
    D.a = e 0 ∨ D.a = e 3 := by
  obtain ⟨i, hi⟩ := e.surjective D.a
  rw [← hi]
  fin_cases i
  · exact Or.inl rfl
  · exfalso
    exact ggQ2xF4d1_two_nbrs D e 1 0 2 hi.symm (by decide) (by decide) (by decide)
      (by rw [hC 1 0]; decide +kernel) (by rw [hC 1 2]; decide +kernel)
  · exfalso
    exact ggQ2xF4d1_two_nbrs D e 2 1 3 hi.symm (by decide) (by decide) (by decide)
      (by rw [hC 2 1]; decide +kernel) (by rw [hC 2 3]; decide +kernel)
  · exact Or.inr rfl

private theorem ggQ2xF4_cell_dat (i k : Fin 4) (hi : i = 0 ∨ i = 3) (hik : k ≠ i) :
    (∃ s t : ZMod 3, s • ggQ2xF4_fix i + t • ggQ2xF4_fix k ≠ 0 ∧
        (s • ggQ2xF4_fix i + t • ggQ2xF4_fix k) ⬝ᵥ
          ggQ2xF4_G.mulVec (s • ggQ2xF4_fix i + t • ggQ2xF4_fix k) = 0) ∨
      ((∀ s t : ZMod 3, s • ggQ2xF4_fix i + t • ggQ2xF4_fix k ≠ 0 →
        (s • ggQ2xF4_fix i + t • ggQ2xF4_fix k) ⬝ᵥ
          ggQ2xF4_G.mulVec (s • ggQ2xF4_fix i + t • ggQ2xF4_fix k) ≠ 0) ∧
      ∃ s₁ t₁ s₂ t₂ : ZMod 3,
        (s₁ • ggQ2xF4_fix i + t₁ • ggQ2xF4_fix k) ⬝ᵥ
          ggQ2xF4_G.mulVec (s₁ • ggQ2xF4_fix i + t₁ • ggQ2xF4_fix k) = 1 ∧
        (s₂ • ggQ2xF4_fix i + t₂ • ggQ2xF4_fix k) ⬝ᵥ
          ggQ2xF4_G.mulVec (s₂ • ggQ2xF4_fix i + t₂ • ggQ2xF4_fix k) = 2) := by
  rcases hi with rfl | rfl
  · fin_cases k
    · exact absurd rfl hik
    · decide +kernel
    · decide +kernel
    · decide +kernel
  · fin_cases k
    · decide +kernel
    · decide +kernel
    · decide +kernel
    · exact absurd rfl hik

private theorem ggQ2xF4_cell_hall (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hC : ∀ i j, (D.cartan (e i) (e j) : ZMod 3) = ggQ2xF4_C i j)
    (A : Subgroup (D.V ≃ₗ[ZMod 3] D.V)) (hW : D.weyl ≤ A) (z : Fin 4 → ZMod 3)
    (hz : z ⬝ᵥ ggQ2xF4_G.mulVec z ≠ 0) :
    ∃ g ∈ A.map (ggLinConj (ggQ2xF4_tauC D hbas e)).toMonoidHom, ∀ v, g v = v -
      (2 * (z ⬝ᵥ ggQ2xF4_G.mulVec v) / (z ⬝ᵥ ggQ2xF4_G.mulVec z)) • z := by
  let φ : Module.Dual (ZMod 3) (Fin 4 → ZMod 3) :=
    (2 / (z ⬝ᵥ ggQ2xF4_G.mulVec z)) •
      (dotProductEquiv (ZMod 3) (Fin 4) z).comp ggQ2xF4_G.mulVecLin
  have horth : ∀ v, φ v = (2 / (z ⬝ᵥ ggQ2xF4_G.mulVec z)) *
      (z ⬝ᵥ ggQ2xF4_G.mulVec v) := by
    intro v
    simp only [φ, LinearMap.smul_apply, LinearMap.comp_apply, dotProductEquiv_apply_apply,
      Matrix.coe_mulVecLin, smul_eq_mul]
  have hφ : φ z = 2 := by
    rw [horth z]
    exact div_mul_cancel₀ 2 hz
  have hmat : LinearMap.toMatrix' ((Module.reflection hφ :
      (Fin 4 → ZMod 3) ≃ₗ[ZMod 3] (Fin 4 → ZMod 3)) :
        (Fin 4 → ZMod 3) →ₗ[ZMod 3] (Fin 4 → ZMod 3)) = ggQ2xF4_refl z :=
    ggQ2xF4c_toMatrix_refl_of_orth hφ horth
  let g : D.V ≃ₗ[ZMod 3] D.V :=
    (ggLinConj (ggQ2xF4_tauC D hbas e)).symm (Module.reflection hφ)
  have hgmap : (ggLinConj (ggQ2xF4_tauC D hbas e)).toMonoidHom g = Module.reflection hφ :=
    MulEquiv.apply_symm_apply _ _
  have hgm : ggQ2xF4_gm D hbas e g = ggQ2xF4_refl z := by
    rw [ggQ2xF4_gm]
    rw [show ggLinConj (ggQ2xF4_tauC D hbas e) g = Module.reflection hφ from
      MulEquiv.apply_symm_apply _ _]
    exact hmat
  have hgW : g ∈ D.weyl :=
    (ggQ2xF4_weyl_iff D hbas e hC g).mpr (by rw [hgm]; exact ggQ2xF4_refl_mem z hz)
  have hgA : g ∈ A := hW hgW
  refine ⟨Module.reflection hφ, ?_, ?_⟩
  · rw [← hgmap]
    exact Subgroup.mem_map_of_mem _ hgA
  · intro v
    rw [Module.reflection_apply v hφ, horth v, div_mul_eq_mul_div]

private lemma ggQ2xF4t_span_sup_le_pair {V : Type} [AddCommGroup V] [Module (ZMod 3) V]
    (a b : V) :
    Submodule.span (ZMod 3) ({a} : Set V) ⊔ Submodule.span (ZMod 3) ({b} : Set V) ≤
      Submodule.span (ZMod 3) ({a, b} : Set V) := by
  apply sup_le
  · rw [Submodule.span_le]
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst hz
    exact Submodule.subset_span (by simp)
  · rw [Submodule.span_le]
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst hz
    exact Submodule.subset_span (by simp)

private lemma ggQ2xF4t_map_span_singleton {V W : Type} [AddCommGroup V] [Module (ZMod 3) V]
    [AddCommGroup W] [Module (ZMod 3) W] (τ : V ≃ₗ[ZMod 3] W) (a : V) :
    Submodule.map τ.toLinearMap (Submodule.span (ZMod 3) {a}) =
      Submodule.span (ZMod 3) {τ a} := by
  rw [Submodule.map_span]
  simp

private lemma ggQ2xF4t_span_eq_map_iff {V W : Type} [AddCommGroup V] [Module (ZMod 3) V]
    [AddCommGroup W] [Module (ZMod 3) W] (τ : V ≃ₗ[ZMod 3] W) (a b : V) :
    (Submodule.span (ZMod 3) {a} = Submodule.span (ZMod 3) {b}) ↔
      (Submodule.span (ZMod 3) {τ a} = Submodule.span (ZMod 3) {τ b}) := by
  constructor
  · intro h
    rw [← ggQ2xF4t_map_span_singleton τ a, ← ggQ2xF4t_map_span_singleton τ b, h]
  · intro h
    have h' := congrArg (Submodule.map (τ.symm : W ≃ₗ[ZMod 3] V).toLinearMap) h
    simpa [Submodule.map_span] using h'

private lemma ggQ2xF4t_mem_span_pair {V W : Type} [AddCommGroup V] [Module (ZMod 3) V]
    [AddCommGroup W] [Module (ZMod 3) W] (τ : V ≃ₗ[ZMod 3] W) (x y : V) (x' y' : W)
    (hx : Submodule.span (ZMod 3) {τ x} = Submodule.span (ZMod 3) {x'})
    (hy : Submodule.span (ZMod 3) {τ y} = Submodule.span (ZMod 3) {y'}) (u : V) :
    u ∈ Submodule.span (ZMod 3) ({x, y} : Set V) ↔
      τ u ∈ Submodule.span (ZMod 3) ({x', y'} : Set W) := by
  have hxmem : τ x ∈ Submodule.span (ZMod 3) ({x'} : Set W) := by
    rw [← hx]
    exact Submodule.subset_span (by simp)
  have hymem : τ y ∈ Submodule.span (ZMod 3) ({y'} : Set W) := by
    rw [← hy]
    exact Submodule.subset_span (by simp)
  have hx'mem : x' ∈ Submodule.span (ZMod 3) ({τ x} : Set W) := by
    rw [hx]
    exact Submodule.subset_span (by simp)
  have hy'mem : y' ∈ Submodule.span (ZMod 3) ({τ y} : Set W) := by
    rw [hy]
    exact Submodule.subset_span (by simp)
  constructor
  · intro hu
    rw [Submodule.mem_span_pair] at hu
    obtain ⟨a, b, hab⟩ := hu
    have hmem : τ u ∈ Submodule.span (ZMod 3) ({x', y'} : Set W) := by
      rw [← hab, map_add, map_smul, map_smul]
      exact ggQ2xF4t_span_sup_le_pair x' y'
        (Submodule.add_mem_sup (Submodule.smul_mem _ a hxmem)
          (Submodule.smul_mem _ b hymem))
    exact hmem
  · intro hu
    rw [Submodule.mem_span_pair] at hu
    obtain ⟨a, b, hab⟩ := hu
    have hmem : τ u ∈ Submodule.span (ZMod 3) ({τ x, τ y} : Set W) := by
      rw [← hab]
      exact ggQ2xF4t_span_sup_le_pair (τ x) (τ y)
        (Submodule.add_mem_sup (Submodule.smul_mem _ a hx'mem)
          (Submodule.smul_mem _ b hy'mem))
    rw [Submodule.mem_span_pair] at hmem
    obtain ⟨c, d, hcd⟩ := hmem
    rw [Submodule.mem_span_pair]
    refine ⟨c, d, ?_⟩
    have h2 := congrArg τ.symm hcd
    simp only [map_add, map_smul, LinearEquiv.symm_apply_apply] at h2
    exact h2

private theorem ggQ2xF4_cell_transport (D : GGQ2Lin 3) (τ : D.V ≃ₗ[ZMod 3] (Fin 4 → ZMod 3))
    (A : Subgroup (D.V ≃ₗ[ZMod 3] D.V)) (x y : D.V) (x' y' : Fin 4 → ZMod 3)
    (hx : Submodule.span (ZMod 3) {τ x} = Submodule.span (ZMod 3) {x'})
    (hy : Submodule.span (ZMod 3) {τ y} = Submodule.span (ZMod 3) {y'})
    (h : (∃ u ∈ Submodule.span (ZMod 3) {x', y'}, u ≠ 0 ∧
        ∀ φ ∈ A.map (ggLinConj τ).toMonoidHom, ∃ r ∈ reflGp (A.map (ggLinConj τ).toMonoidHom),
          Submodule.span (ZMod 3) {φ u} = Submodule.span (ZMod 3) {r u}) ∨
      (∀ φ ∈ A.map (ggLinConj τ).toMonoidHom, ∀ w ∈ Submodule.span (ZMod 3) {x', y'}, w ≠ 0 →
        ∃ r ∈ reflGp (A.map (ggLinConj τ).toMonoidHom),
          ∃ w' ∈ Submodule.span (ZMod 3) {x', y'}, w' ≠ 0 ∧
            Submodule.span (ZMod 3) {φ w} = Submodule.span (ZMod 3) {r w'})) :
    (∃ u ∈ Submodule.span (ZMod 3) {x, y}, u ≠ 0 ∧ ∀ φ ∈ A, ∃ r ∈ reflGp A,
      Submodule.span (ZMod 3) {φ u} = Submodule.span (ZMod 3) {r u}) ∨
    (∀ φ ∈ A, ∀ w ∈ Submodule.span (ZMod 3) {x, y}, w ≠ 0 → ∃ r ∈ reflGp A,
      ∃ w' ∈ Submodule.span (ZMod 3) {x, y}, w' ≠ 0 ∧
        Submodule.span (ZMod 3) {φ w} = Submodule.span (ZMod 3) {r w'}) := by
  rcases h with ⟨u', hu', hu'0, hcell⟩ | hcell
  · left
    refine ⟨τ.symm u', ?_, ?_, ?_⟩
    · exact (ggQ2xF4t_mem_span_pair τ x y x' y' hx hy (τ.symm u')).mpr
        (by rw [τ.apply_symm_apply]; exact hu')
    · intro h0
      exact hu'0 (by
        have h1 := congrArg τ h0
        rw [τ.apply_symm_apply, map_zero] at h1
        exact h1)
    · intro φ hφ
      obtain ⟨r', hr', hline⟩ := hcell (ggLinConj τ φ) (Subgroup.mem_map.mpr ⟨φ, hφ, rfl⟩)
      rw [ggLinConj_reflGp τ A] at hr'
      obtain ⟨r, hr, hrr'⟩ := Subgroup.mem_map.mp hr'
      have hrr'' : ggLinConj τ r = r' := hrr'
      refine ⟨r, hr, ?_⟩
      have h1 : (ggLinConj τ φ) u' = τ (φ (τ.symm u')) := ggLinConj_apply τ φ u'
      have h2 : r' u' = τ (r (τ.symm u')) := by
        rw [← hrr'']
        exact ggLinConj_apply τ r u'
      have hline' : Submodule.span (ZMod 3) {τ (φ (τ.symm u'))} =
          Submodule.span (ZMod 3) {τ (r (τ.symm u'))} := by
        rw [← h1, ← h2]
        exact hline
      exact (ggQ2xF4t_span_eq_map_iff τ (φ (τ.symm u')) (r (τ.symm u'))).mpr hline'
  · right
    intro φ hφ w hw hw0
    have hw' : τ w ∈ Submodule.span (ZMod 3) ({x', y'} : Set ((Fin 4 → ZMod 3))) :=
      (ggQ2xF4t_mem_span_pair τ x y x' y' hx hy w).mp hw
    have hw'0 : τ w ≠ 0 := by
      intro h0
      exact hw0 (by
        have h1 := congrArg τ.symm h0
        simpa using h1)
    obtain ⟨r', hr', w'', hw'', hw''0, hline⟩ :=
      hcell (ggLinConj τ φ) (Subgroup.mem_map.mpr ⟨φ, hφ, rfl⟩) (τ w) hw' hw'0
    rw [ggLinConj_reflGp τ A] at hr'
    obtain ⟨r, hr, hrr'⟩ := Subgroup.mem_map.mp hr'
    have hrr'' : ggLinConj τ r = r' := hrr'
    refine ⟨r, hr, τ.symm w'', ?_, ?_, ?_⟩
    · exact (ggQ2xF4t_mem_span_pair τ x y x' y' hx hy (τ.symm w'')).mpr
        (by rw [τ.apply_symm_apply]; exact hw'')
    · intro h0
      exact hw''0 (by
        have h1 := congrArg τ h0
        rw [τ.apply_symm_apply, map_zero] at h1
        exact h1)
    · have h1 : (ggLinConj τ φ) (τ w) = τ (φ w) := by
        rw [ggLinConj_apply, LinearEquiv.symm_apply_apply]
      have h2 : r' w'' = τ (r (τ.symm w'')) := by
        rw [← hrr'']
        exact ggLinConj_apply τ r w''
      have hline' : Submodule.span (ZMod 3) {τ (φ w)} =
          Submodule.span (ZMod 3) {τ (r (τ.symm w''))} := by
        rw [← h1, ← h2]
        exact hline
      exact (ggQ2xF4t_span_eq_map_iff τ (φ w) (r (τ.symm w''))).mpr hline'

theorem ggQ2_cell_F4 (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hF : D.coxeter = CoxeterMatrix.F₄.reindex e) (x y : D.V)
    (hx : ∀ v, (∀ g ∈ D.parab {k | k ≠ D.a}, g v = v) ↔ v ∈ Submodule.span (ZMod 3) {x})
    (hy : ∀ v, (∀ g ∈ D.parab {k | k ≠ D.b}, g v = v) ↔ v ∈ Submodule.span (ZMod 3) {y})
    (A : Subgroup (D.V ≃ₗ[ZMod 3] D.V)) (hW : D.weyl ≤ A) (hTF : TransvectionFree A) :
    (∃ u ∈ Submodule.span (ZMod 3) {x, y}, u ≠ 0 ∧ ∀ φ ∈ A, ∃ r ∈ reflGp A,
      Submodule.span (ZMod 3) {φ u} = Submodule.span (ZMod 3) {r u}) ∨
    (∀ φ ∈ A, ∀ w ∈ Submodule.span (ZMod 3) {x, y}, w ≠ 0 → ∃ r ∈ reflGp A,
      ∃ w' ∈ Submodule.span (ZMod 3) {x, y}, w' ≠ 0 ∧
        Submodule.span (ZMod 3) {φ w} = Submodule.span (ZMod 3) {r w'}) := by
  obtain ⟨e', hC⟩ := ggQ2xF4_cartan D e hF
  obtain ⟨i, hi⟩ := e'.surjective D.a
  obtain ⟨k, hk⟩ := e'.surjective D.b
  have hleaf := ggQ2xF4_cell_leaf D e' hC
  have hi03 : i = 0 ∨ i = 3 := by
    rcases hleaf with h | h
    · exact Or.inl (e'.injective (hi.trans h))
    · exact Or.inr (e'.injective (hi.trans h))
  have hik : k ≠ i := fun h => D.a_ne_b (by rw [← hi, ← hk, h])
  rw [← hi] at hx
  rw [← hk] at hy
  have hxτ := ggQ2xF4_cell_fixed D hbas e' hC i x hx
  have hyτ := ggQ2xF4_cell_fixed D hbas e' hC k y hy
  refine ggQ2xF4_cell_transport D (ggQ2xF4_tauC D hbas e') A x y _ _ hxτ hyτ ?_
  exact ggQ2_cell_coord ggQ2xF4_G (Or.inl rfl) _
    (fun c φ h ht => ggQ2xF4_S1 D hbas e' hC A hW hTF h ht)
    (fun z hz => ggQ2xF4_cell_hall D hbas e' hC A hW z hz) _ _ (ggQ2xF4_cell_dat i k hi03 hik)

end CFSG.StandardType

