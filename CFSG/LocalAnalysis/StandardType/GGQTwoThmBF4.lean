private lemma ggQ2xF4b_S_apply (k i l : Fin 4) :
    ggQ2xF4_S k i l = (if i = l then 1 else 0) - (if i = k then 1 else 0) * ggQ2xF4_C k l := by
  unfold ggQ2xF4_S
  rw [Matrix.sub_apply, Matrix.one_apply, Matrix.mul_apply]
  rw [Finset.sum_eq_single k
      (fun x _ hxk => by
        rw [Matrix.single_apply]
        have : ¬(k = i ∧ k = x) := by rintro ⟨h1, h2⟩; exact hxk h2.symm
        simp [this])
      (fun hk => absurd (Finset.mem_univ k) hk)]
  rw [Matrix.single_apply]
  by_cases h : i = k
  · subst h; simp
  · have h' : ¬ k = i := fun hki => h hki.symm
