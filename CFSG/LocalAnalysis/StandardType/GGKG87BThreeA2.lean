variable {A B : Type*} [Group A] [Group B]

private theorem ggFix_conj_eq (b : B) : ggFix (MulAut.conj b) = Subgroup.centralizer {b} := by
  ext y
  rw [mem_ggFix, MulAut.conj_apply, Subgroup.mem_centralizer_singleton_iff, mul_inv_eq_iff_eq_mul]
  exact eq_comm

private theorem map_centralizer_eq (κ : A ≃* B) (a : A) :
    (Subgroup.centralizer {a}).map κ.toMonoidHom = Subgroup.centralizer {κ a} := by
  ext y
  rw [Subgroup.mem_map_equiv, Subgroup.mem_centralizer_singleton_iff,
    Subgroup.mem_centralizer_singleton_iff]
  constructor
  · intro h
    simpa using congrArg κ h
  · intro h
    simpa using congrArg κ.symm h

private theorem fixedPoints_zpowers_conj (a : A) :
    CFSG.LieType.Seitz.fixedPoints (Subgroup.zpowers (MulAut.conj a)) =
      Subgroup.centralizer {a} := by
  ext c
  constructor
  · intro h
    have h1 : MulAut.conj a c = c := h _ (Subgroup.mem_zpowers _)
    rw [MulAut.conj_apply, mul_inv_eq_iff_eq_mul] at h1
    exact Subgroup.mem_centralizer_singleton_iff.mpr h1.symm
  · intro h φ hφ
    have h1 : MulAut.conj a c = c := by
      rw [MulAut.conj_apply, mul_inv_eq_iff_eq_mul]
      exact (Subgroup.mem_centralizer_singleton_iff.mp h).symm
    have hle : Subgroup.zpowers (MulAut.conj a) ≤ MulAction.stabilizer (MulAut A) c :=
      Subgroup.zpowers_le.2 (MulAction.mem_stabilizer_iff.2 h1)
    exact MulAction.mem_stabilizer_iff.1 (hle hφ)

private theorem pgroup_noncyclic_map {P : Subgroup A} (hP3 : IsPGroup 3 P) (hPc : ¬ IsCyclic P)
    (f : A →* B) (hf : Function.Injective f) : IsPGroup 3 (P.map f) ∧ ¬ IsCyclic (P.map f) :=
  ⟨hP3.map f, fun _ => hPc (isCyclic_of_surjective (P.equivMapOfInjective f hf).symm
    (P.equivMapOfInjective f hf).symm.surjective)⟩

private theorem range_zmod3sq (Ψ : Multiplicative (Fin 2 → ZMod 3) →* A)
    (hΨ : Function.Injective Ψ) :
    IsPGroup 3 Ψ.range ∧ ¬ IsCyclic Ψ.range ∧ Nat.card Ψ.range = 9 := by
  have hpow3 : ∀ a : Multiplicative (Fin 2 → ZMod 3), a ^ 3 = 1 := by
    intro a
    rw [← toAdd_eq_zero, toAdd_pow]
    funext i
    have h3 : (3 : ZMod 3) = 0 := ZMod.natCast_self 3
    fin_cases i <;> simp [Pi.smul_apply, nsmul_eq_mul, h3]
  have hcard9 : Nat.card (Multiplicative (Fin 2 → ZMod 3)) = 9 := by
    rw [Nat.card_congr Multiplicative.toAdd, Nat.card_fun, Nat.card_zmod,
      Nat.card_eq_fintype_card, Fintype.card_fin]
    norm_num
  have hexp : Monoid.exponent (Multiplicative (Fin 2 → ZMod 3)) ∣ 3 :=
    Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hpow3
  have hdom : IsPGroup 3 (Multiplicative (Fin 2 → ZMod 3)) :=
    IsPGroup.of_exponent_dvd_pow (n := 1) (by rw [pow_one]; exact hexp)
  let e : Multiplicative (Fin 2 → ZMod 3) ≃* Ψ.range := MonoidHom.ofInjective hΨ
  refine ⟨hdom.of_equiv e, fun hc => ?_, ?_⟩
  · have : IsCyclic (Multiplicative (Fin 2 → ZMod 3)) :=
      isCyclic_of_surjective e.symm e.symm.surjective
    have h := IsCyclic.exponent_eq_card (α := Multiplicative (Fin 2 → ZMod 3))
    rw [hcard9] at h
    rw [h] at hexp
    norm_num at hexp
  · rw [← Nat.card_congr e.toEquiv, hcard9]

open CFSG.LocalAnalysis.ComponentInitial CFSG.ClassicalGroups.UnitaryFlag in
private theorem exists_noncyclic_le_range {ℓ f : ℕ} {K : Type} [Field K]
    (hU : UnitaryFieldData ℓ f K) (hq3 : 3 ∣ ℓ ^ f + 1) {ρ : unitarySU ℓ f K 3 →* A}
    (hρ : Function.Injective ρ) :
    ∃ P : Subgroup A, P ≤ ρ.range ∧ IsPGroup 3 P ∧ ¬ IsCyclic P ∧ Nat.card P = 9 := by
  obtain ⟨ζ, hζo, hζq⟩ :=
    CFSG.RankThree.Classical2.exists_orderOf_eq_norm_one hU Nat.prime_three hq3
  have hζ3 : ζ ^ 3 = 1 := hζo ▸ pow_orderOf_eq_one ζ
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let c : Fin 2 → Fin 3 → Kˣ := ![![ζ, ζ⁻¹, 1], ![1, ζ, ζ⁻¹]]
  have hc : ∀ k i, c k i ^ 3 = 1 := by
    intro k i
    fin_cases k <;> fin_cases i <;> simp [c, hζ3, inv_pow]
  have hprod : ∀ k, ∏ i, c k i = 1 := by
    intro k
    fin_cases k <;> simp [c, Fin.prod_univ_three]
  have hnorm : ∀ k i, c k i ^ (ℓ ^ f + 1) = 1 := by
    intro k i
    fin_cases k <;> fin_cases i <;> simp [c, hζq, inv_pow]
  have hpriv : ∀ k, ∃ i, (∀ k', k' ≠ k → c k' i = 1) ∧ orderOf (c k i) = 3 := by
    intro k
    fin_cases k
    · refine ⟨0, fun k' hk' => ?_, by simpa [c] using hζo⟩
      fin_cases k' <;> simp_all [c]
    · refine ⟨2, fun k' hk' => ?_, by simpa [c, orderOf_inv] using hζo⟩
      fin_cases k' <;> simp_all [c]
  have hθ := CFSG.RankThree.Classical2.expHom_injective c hc hpriv
  have hmem := CFSG.RankThree.Classical2.diagHom_expHom_mem_unitarySU hU c hc hprod hnorm
  let Φ : Multiplicative (Fin 2 → ZMod 3) →* unitarySU ℓ f K 3 :=
    ((CFSG.SectionRank.OddCover.diagHom 3).comp
      (CFSG.RankThree.Classical2.expHom c hc)).codRestrict _ hmem
  have hΦ : Function.Injective Φ := fun a b hab =>
    hθ (CFSG.SectionRank.OddCover.diagHom_injective 3 (congrArg Subtype.val hab))
  obtain ⟨h1, h2, h3⟩ := range_zmod3sq (ρ.comp Φ) (hρ.comp hΦ)
  refine ⟨(ρ.comp Φ).range, ?_, h1, h2, h3⟩
  rintro _ ⟨a, rfl⟩
  exact ⟨Φ a, rfl⟩

private theorem isComponentOf_shift {C Tt : Subgroup A} {Λ : Fin 3 → Subgroup A}
    (hD : ShiftData C Λ Tt) (j : Fin 3) : IsComponentOf (Λ j) C := by
  have hΛM : Λ j ≤ ⨆ i, Λ i := le_iSup Λ j
  have hMC : (⨆ i, Λ i) ≤ C := iSup_le hD.le_C
  refine ⟨hD.le_C j, CFSG.Assembly.IsSubnormal.step hΛM ?_
    (CFSG.Assembly.IsSubnormal.step hMC ?_ (CFSG.Assembly.IsSubnormal.refl C)), ?_⟩
  · rw [Subgroup.normal_subgroupOf_iff hΛM]
    intro y k hy hk
    exact (Subgroup.mem_normalizer_iff.mp (hD.iSup_le_normalizer j hk) y).mp hy
  · rw [Subgroup.normal_subgroupOf_iff hMC]
    intro y k hy hk
    have hC : ∀ z ∈ C, MulAut.conj k z ∈ C := fun z hz => by
      rw [MulAut.conj_apply]
      exact C.mul_mem (C.mul_mem hk hz) (C.inv_mem hk)
    have hC' : ∀ z ∈ C, (MulAut.conj k).symm z ∈ C := fun z hz => by
      rw [MulAut.conj_symm_apply]
      exact C.mul_mem (C.mul_mem (C.inv_mem hk) hz) hk
    rw [← hD.map_iSup_eq hC hC']
    exact ⟨y, hy, by simp [MulAut.conj_apply]⟩
  · exact (CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_native _).mpr
      (hD.quasi j)

end Generic

private theorem comp_hyp_of_line
    {K : Type} [Field K] [Finite K] {σ : K ≃+* K}
    {h₀ : ModGL TwistTag.E6.tag K} {L : Fin 3 → Subgroup (ModGL TwistTag.E6.tag K)}
    {T : Subgroup (ModGL TwistTag.E6.tag K)} {n : ModGL TwistTag.E6.tag K}
    (hL : TwE6ThreeA2Line K σ h₀ L T n) {s₀ : twistedE6RootGroup K σ}
    (hs₀ : (s₀ : ModGL TwistTag.E6.tag K) = h₀)
    (hP : ∀ j, ∃ P : Subgroup (twistedE6RootGroup K σ),
      P ≤ (L j).subgroupOf (twistedE6RootGroup K σ) ∧ IsPGroup 3 P ∧ ¬ IsCyclic P ∧
        Nat.card P = 9)
    {R : Type} [Group R] (κ : twistedE6RootGroup K σ ≃* R) {g : R} (hκ : κ s₀ = g)
    (Jb : Subgroup R) (hJb : IsComponentOf Jb (ggFix (MulAut.conj g))) :
    ∃ P : Subgroup R, IsPGroup 3 P ∧ ¬ IsCyclic P ∧
      P ≤ ⨆ (B : Subgroup R) (_ : IsComponentOf B (ggFix (MulAut.conj g)) ∧ B ≠ Jb ∧
        3 ∣ Nat.card B), B := by
  have hD := twLayer_shiftData hL hs₀
  have hfix : (Subgroup.centralizer {s₀}).map κ.toMonoidHom = ggFix (MulAut.conj g) := by
    rw [map_centralizer_eq, hκ, ggFix_conj_eq]
  have hJ : CFSG.Open.IsComponentOf (Jb.map κ.symm.toMonoidHom)
      (CFSG.LieType.Seitz.fixedPoints (Subgroup.zpowers (MulAut.conj s₀))) := by
    have h := CFSG.StandardType.isComponentOf_map_of_injective κ.symm.toMonoidHom
      κ.symm.injective hJb
    rw [ggFix_conj_eq, map_centralizer_eq, ← hκ, MulEquiv.symm_apply_apply] at h
    rw [fixedPoints_zpowers_conj]
    exact isComponentOf_iff_open.mp h
  obtain ⟨i, hi⟩ := CFSG.StandardType.SCFourCover.twE6ThreeA2Line_component_eq hL
    (τ := 1) hs₀ hJ
  have hi' : Jb.map κ.symm.toMonoidHom = (L i).subgroupOf (twistedE6RootGroup K σ) := by
    rw [← hi]
    exact (Subgroup.map_id _).symm
  have hJi : Jb = ((L i).subgroupOf (twistedE6RootGroup K σ)).map κ.toMonoidHom := by
    ext y
    rw [Subgroup.mem_map_equiv, ← hi', Subgroup.mem_map_equiv, MulEquiv.symm_symm,
      MulEquiv.apply_symm_apply]
  have hne : i + 1 ≠ i := by
    have h : ∀ k : Fin 3, k + 1 ≠ k := by decide
    exact h i
  obtain ⟨P, hPle, hP3, hPc, hP9⟩ := hP (i + 1)
  have hB : IsComponentOf (((L (i + 1)).subgroupOf (twistedE6RootGroup K σ)).map κ.toMonoidHom)
      (ggFix (MulAut.conj g)) := by
    rw [← hfix]
    exact CFSG.StandardType.isComponentOf_map_of_injective κ.toMonoidHom κ.injective
      (isComponentOf_shift hD (i + 1))
  have hBne : ((L (i + 1)).subgroupOf (twistedE6RootGroup K σ)).map κ.toMonoidHom ≠ Jb := by
    rw [hJi]
    exact fun h => hD.ne hne (Subgroup.map_injective κ.injective h)
  have hB3 : 3 ∣ Nat.card (((L (i + 1)).subgroupOf (twistedE6RootGroup K σ)).map
      κ.toMonoidHom) := by
    rw [Subgroup.card_map_of_injective κ.injective]
    have h := Subgroup.card_dvd_of_le hPle
    rw [hP9] at h
    exact dvd_trans (by norm_num) h
  obtain ⟨hP3', hPc'⟩ := pgroup_noncyclic_map hP3 hPc κ.toMonoidHom κ.injective
  exact ⟨P.map κ.toMonoidHom, hP3', hPc', le_iSup₂_of_le _ ⟨hB, hBne, hB3⟩
    (Subgroup.map_mono hPle)⟩

theorem not_ggFixCompCyclic_of_threeA2
    {K : Type} [Field K] [Finite K] {σ : K ≃+* K} {q : ℕ} (hK3 : ringChar K ≠ 3)
    (hσ : ∀ c, σ c = c ^ q) (hKq : Nat.card K = q ^ 2) (h3q : 3 ∣ q + 1) (hq2 : q ≠ 2)
    {R : Type} [Group R] (ε : ↥(twistedE6RootGroup K σ) ≃* R)
    {L' : Type} [Group L'] [Finite L'] {ψ : L' →* R} (hψ : Function.Surjective ψ)
    (hker : ψ.ker ≤ Subgroup.center L') {a : MulAut L'} {g : R}
    (hc : ∀ l : L', MulAut.conj g (ψ l) = ψ (a l)) (hg3 : g ^ 3 = 1)
    (hdim : twE6FixDim K σ (ε.symm g) = 24) :
    ¬ GGFixCompCyclic 3 a := by
  obtain ⟨h₀, L, T, n, hL⟩ := exists_twE6ThreeA2Line K σ q hK3 hσ hKq h3q hq2
  have hs3 : ((ε.symm g : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) ^ 3 = 1 := by
    rw [← Subgroup.coe_pow, ← map_pow, hg3, map_one, Subgroup.coe_one]
  obtain ⟨x, hxC, hx⟩ := twE6ThreeA2Conj_holds K σ q hK3 hσ hKq h3q hq2 _ (ε.symm g).2 h₀
    hL.h₀_mem hs3 hL.h₀_pow hdim hL.finrank_fixed
  obtain ⟨κ, hκ⟩ : ∃ κ : twistedE6RootGroup K σ ≃* R, κ ⟨h₀, hL.h₀_mem⟩ = g := by
    refine ⟨(MulAut.conj (⟨x, hxC⟩ : twistedE6RootGroup K σ)).symm.trans ε, ?_⟩
    rw [MulEquiv.trans_apply, ← MulEquiv.eq_symm_apply, MulEquiv.symm_apply_eq,
      MulAut.conj_apply]
    exact Subtype.ext hx.symm
  obtain ⟨ℓ, f, hU, ρ, hq, hinj, hrange, -⟩ :=
    twLayerModel_of_torusModel twTorusModel_holds K σ q hK3 hσ hKq h3q hq2 h₀ L T n hL
  have hP : ∀ j, ∃ P : Subgroup (twistedE6RootGroup K σ),
      P ≤ (L j).subgroupOf (twistedE6RootGroup K σ) ∧ IsPGroup 3 P ∧ ¬ IsCyclic P ∧
        Nat.card P = 9 := by
    intro j
    have hr : (ρ j).range = (L j).subgroupOf (twistedE6RootGroup K σ) := by
      rw [← hrange j]
      exact (Subgroup.comap_map_eq_self_of_injective
        (twistedE6RootGroup K σ).subtype_injective _).symm
    rw [← hr]
    exact exists_noncyclic_le_range hU (by rw [hq]; exact h3q) (hinj j)
  exact UnitSixThreeKG.not_ggFixCompCyclic_of_comp hψ hker hc
    (comp_hyp_of_line hL rfl hP κ hκ)

