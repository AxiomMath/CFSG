theorem exists_elemAbelian_fixed_fieldActor {f : ℕ} (hf : 1 ≤ f) (K : Type) [Field K]
    [Finite K] [CharP K 2] (hK : Nat.card K = (2 ^ f) ^ 2) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ (2 ^ f)) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {η : K ≃+* K}
    (hηp : η ^ p = 1) (hη1 : η ≠ 1) {B : Subgroup (twistedE6RootGroup K σ)}
    (hB : IsElemAbelian p B) :
    ∃ E : Subgroup (twistedE6RootGroup K σ), IsElemAbelian p E ∧
      (∀ x ∈ E, fieldActor (t := TwistTag.E6) σ η x = x) ∧
      Nat.card B ≤ p * Nat.card E := by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  have hK2 : Nat.card K = 2 ^ (2 * f) := by rw [hK, ← pow_mul, Nat.mul_comm]
  have hcord : orderOf η = p := orderOf_eq_prime hηp hη1
  have hoddp : Odd p := hp.odd_of_ne_two hp2
  obtain ⟨hpdvd, hKfix⟩ :=
    fixSubfield_card_of_odd hf hK η (by rw [hcord]; exact hoddp)
  rw [hcord] at hpdvd hKfix
  have hfdiv : 1 ≤ f / p := Nat.div_pos (Nat.le_of_dvd (by omega) hpdvd) hp.pos
  haveI : Finite (fixSubfield η) :=
    Finite.of_injective (Subtype.val : fixSubfield η → K) Subtype.val_injective
  haveI : CharP (fixSubfield η) 2 := Subfield.charP (fixSubfield η) 2
  have hσfix : ∀ c : ↥(fixSubfield η), fixSubfieldRestrict σ η c = c ^ (2 ^ (f / p)) := by
    refine fixSubfieldRestrict_eq_pow hKfix hoddp ?_
    intro c
    rw [hσ, show (f / p) * p = f from Nat.div_mul_cancel hpdvd]
  have hefix : orderOf (((2 ^ (f / p) : ℕ)) : ZMod p) =
      orderOf (((2 ^ f : ℕ)) : ZMod p) := by
    have hcast : (((2 ^ f : ℕ)) : ZMod p) = (((2 ^ (f / p) : ℕ)) : ZMod p) := by
      conv_lhs => rw [show f = (f / p) * p from (Nat.div_mul_cancel hpdvd).symm]
      rw [pow_mul, Nat.cast_pow, ZMod.pow_card]
    rw [hcast]
  set e : ℕ := orderOf (((2 ^ f : ℕ)) : ZMod p) with hedef
  have hRank : Nat.card B ≤ p ^ degCountTw e :=
    rankLE_twistedE6 Nat.prime_two hf K hK σ hσ hp hp2 hedef.symm B hB
  obtain ⟨E₀, hE₀, hE₀card⟩ :=
    exists_twistedE6 (ℓ := 2) (f := f / p) (K := ↥(fixSubfield η)) (e := e) Nat.prime_two hfdiv
      hKfix (fixSubfieldRestrict σ η) hσfix hp hp2 (by rw [hedef]; exact hefix)
  let φ : (↥(twistedE6RootGroup (↥(fixSubfield η)) (fixSubfieldRestrict σ η))) →*
      twistedE6RootGroup K σ :=
    (twFJ σ η).subtype.comp (twFJModelEquiv σ η).toMonoidHom
  have hφinj : Function.Injective φ := fun a b hab =>
    (twFJModelEquiv σ η).injective (Subtype.ext hab)
  refine ⟨E₀.map φ, hE₀.map φ, ?_, ?_⟩
  · rintro _ ⟨y, -, rfl⟩
    exact (mem_fixedSubgroup (α := fieldActor (t := TwistTag.E6) σ η)).1
      (twFJ_le_twR σ η (twFJModelEquiv σ η y).2)
  · rw [Subgroup.card_map_of_injective hφinj]
    by_cases h0 : degCountTw e = 0
    · have hB1 : Nat.card B ≤ 1 := by simpa [h0] using hRank
      have hBpos : 0 < Nat.card B := Nat.card_pos
      have hBone : Nat.card B = 1 := by omega
      rw [hBone]
      have hEpos : 0 < Nat.card E₀ := Nat.card_pos
      calc 1 ≤ p := hp.one_lt.le
        _ ≤ p * Nat.card E₀ := Nat.le_mul_of_pos_right p hEpos
    · have hpow : p ^ degCountTw e = p * p ^ (degCountTw e - 1) := by
        conv_lhs => rw [show degCountTw e = (degCountTw e - 1) + 1 by omega]
        rw [pow_succ]
        ring
      calc Nat.card B ≤ p ^ degCountTw e := hRank
        _ = p * p ^ (degCountTw e - 1) := hpow
        _ ≤ p * Nat.card E₀ := Nat.mul_le_mul_left p hE₀card

private theorem mem_range_of_eq_conj {C G : Type} [Group C] [Group G] (χ : C →* G)
    (hχ : Function.Injective χ) {G₀ : Subgroup G} (hrange : χ.range = G₀)
    (hcent : Subgroup.centralizer (G₀ : Set G) = ⊥) {y : G} {α : MulAut C}
    (hα : ∀ u, χ (α u) = y * χ u * y⁻¹) {h : C} (hh : α = MulAut.conj h) : y ∈ χ.range := by
  have hc : (χ h)⁻¹ * y ∈ Subgroup.centralizer (G₀ : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    have hx' : x ∈ χ.range := by rw [hrange]; exact hx
    obtain ⟨u, rfl⟩ := hx'
    have e : y * χ u * y⁻¹ = χ h * χ u * (χ h)⁻¹ := by
      rw [← hα u, hh]
      simp [MulAut.conj_apply, map_mul, map_inv]
    calc χ u * ((χ h)⁻¹ * y) = (χ h)⁻¹ * (χ h * χ u * (χ h)⁻¹) * y := by group
      _ = (χ h)⁻¹ * (y * χ u * y⁻¹) * y := by rw [e]
      _ = (χ h)⁻¹ * y * χ u := by group
  rw [hcent, Subgroup.mem_bot, inv_mul_eq_one] at hc
  exact ⟨h, hc⟩

theorem exists_centralizing_elemAbelian_of_not_three {G : Type} [Group G] [Finite G]
    {p : ℕ} {Bs G₀ : Subgroup G} {n f : ℕ} {ψ : (ggU .twistedE6 n f).K →* G}
    (hS : GGSixFusionSetting p Bs G₀ (ggU .twistedE6 n f).D .twistedE6 n f ψ)
    (h3 : ¬ (p = 3 ∧ 3 ∣ 2 ^ f + 1))
    {y : G} (hyM : y ∈ Subgroup.normalizer (G₀ : Set G)) (hyp : orderOf y = p)
    (hni : ¬ GGPsiInnerDiag (ggU .twistedE6 n f).D ψ y) :
    ∃ E₀ : Subgroup G, E₀ ≤ G₀ ∧ IsElemAbelian p E₀ ∧ (∀ x ∈ E₀, y * x = x * y) ∧
      Nat.card Bs ≤ p * Nat.card E₀ := by
  classical
  have hpp : p.Prime := hS.prime
  have hp2 : p ≠ 2 := hS.ne_two
  haveI : Fact p.Prime := ⟨hpp⟩
  have hpres : GGPresentsG0 G₀ (ggU .twistedE6 n f).D .twistedE6 n f ψ := hS.presents
  have hrange : ψ.range = G₀ := hS.range_eq
  have hf : 1 ≤ f := hpres.1.1.2.1
  have hker : ψ.ker ≤ Subgroup.center (ggU .twistedE6 n f).K := hpres.2.1.2
  have hperf : commutator ↥ψ.range = ⊤ := by rw [hrange]; exact hpres.2.2.1
  have hCψ : Subgroup.centralizer (ψ.range : Set G) = ⊥ := by
    rw [hrange]; exact hS.centralizer_eq_bot
  obtain ⟨χ, hχinj, hχrange⟩ := exists_injective_factor_twistedE6 hf ψ hker hCψ
  have hK : Nat.card (GaloisField 2 (2 * f)) = (2 ^ f) ^ 2 := by
    rw [GaloisField.card 2 (2 * f) (by omega), ← pow_mul, mul_comm]
  have hK2 : Nat.card (GaloisField 2 (2 * f)) = 2 ^ (2 * f) := by
    rw [hK, ← pow_mul, Nat.mul_comm]
  set σ : GaloisField 2 (2 * f) ≃+* GaloisField 2 (2 * f) :=
    iterateFrobeniusEquiv (GaloisField 2 (2 * f)) 2 f with hσdef
  have hσ : ∀ c, σ c = c ^ (2 ^ f) := fun c => iterateFrobeniusEquiv_def _ 2 f c
  have hσθ : σ.toRingHom = frobQ 2 f := RingHom.ext fun c => by
    change σ c = frobQ 2 f c
    rw [hσ, frobQ_apply]
  let eC : (↥(graphFixedRootGroup TwistTag.E6 (GaloisField 2 (2 * f)) (frobQ 2 f))) ≃*
      (↥(graphFixedRootGroup TwistTag.E6 (GaloisField 2 (2 * f)) σ.toRingHom)) :=
    MulEquiv.subgroupCongr (congrArg (fun g => graphFixedRootGroup TwistTag.E6
      (GaloisField 2 (2 * f)) g) hσθ).symm
  let χ₂ : twistedE6RootGroup (GaloisField 2 (2 * f)) σ →* G := χ.comp eC.symm.toMonoidHom
  have hχ₂inj : Function.Injective χ₂ := hχinj.comp eC.symm.injective
  have hχ₂range : χ₂.range = ψ.range := by
    ext g
    constructor
    · rintro ⟨u, rfl⟩
      have hg : χ (eC.symm u) ∈ χ.range := ⟨eC.symm u, rfl⟩
      rwa [hχrange] at hg
    · rintro ⟨u, rfl⟩
      have hu : ψ u ∈ χ.range := by rw [hχrange]; exact ⟨u, rfl⟩
      obtain ⟨v, hv⟩ := hu
      refine ⟨eC v, ?_⟩
      show χ (eC.symm (eC v)) = ψ u
      rw [MulEquiv.symm_apply_apply, hv]
  have hyN : y ∈ Subgroup.normalizer (χ₂.range : Set G) := by
    rw [hχ₂range, hrange]; exact hyM
  obtain ⟨α, hα⟩ := ExcFieldAutCentRankF4.exists_aut_of_mem_normalizer χ₂ hχ₂inj hyN
  have hαk : ∀ (k : ℕ) u, χ₂ ((α ^ k) u) = y ^ k * χ₂ u * (y ^ k)⁻¹ := by
    intro k
    induction k with
    | zero => intro u; simp
    | succ k ih => intro u; rw [pow_succ', MulAut.mul_apply, hα, ih]; group
  have hyp1 : y ^ p = 1 := by rw [← hyp]; exact pow_orderOf_eq_one y
  have hαp : α ^ p = 1 := by
    refine MulEquiv.ext fun u => hχ₂inj ?_
    rw [hαk, hyp1]
    simp
  obtain ⟨-, -, -, -, -, -, -, -, ⟨Θ, hΘ, -, hkerΘ, -, -, -⟩, -, -, -, -, -⟩ :=
    twisted_E6_all_characteristic_exact_automorphism_normal_form Nat.prime_two hf
      (GaloisField 2 (2 * f)) hK σ hσ
  have hαo : α ∉ twistedE6Inn (GaloisField 2 (2 * f)) σ ⊔
      twistedE6Diag (GaloisField 2 (2 * f)) σ := by
    intro hmem
    have hmem' : α ∈ (MulAut.conj : (↥(graphFixedRootGroup TwistTag.E6
        (GaloisField 2 (2 * f)) σ.toRingHom)) →*
        MulAut (↥(graphFixedRootGroup TwistTag.E6 (GaloisField 2 (2 * f)) σ.toRingHom))).range ⊔
        (RootCentExc.compatParamAut σ.toRingHom).range := by
      rw [NoOffTwE6Three.range_compatParamAut_eq_twistedE6Diag]
      exact hmem
    have h33 : p ≠ 3 ∨ ¬ 3 ∣ 2 ^ f + 1 := by
      by_contra habs
      push Not at habs
      exact h3 habs
    obtain ⟨h, hh⟩ := TwE6Toral.mem_range_conj_of_mem_twInndiag
      (q := 2 ^ f) (by
        have h1 : 1 < 2 ^ f := Nat.one_lt_pow (by omega : f ≠ 0) (by norm_num)
        omega) hK hσ hpp h33 hmem' hαp
    exact hni (ggPsiInnerDiag_of_mem_range _ (by
      rw [← hχ₂range]
      exact mem_range_of_eq_conj χ₂ hχ₂inj hχ₂range hCψ hα hh.symm))
  obtain ⟨hηo, -, ψ', hψ'⟩ :=
    exists_conj_fieldActor_of_not_mem_twistedE6Inndiag Nat.prime_two hf
      (GaloisField 2 (2 * f)) hK2 σ hσ Θ hΘ hpp hp2 hαp hαo
  set η : GaloisField 2 (2 * f) ≃+* GaloisField 2 (2 * f) := Θ α with hηdef
  have hηp : η ^ p = 1 := by rw [hηdef, ← map_pow, hαp, map_one]
  have hη1 : η ≠ 1 := by
    have hp2le := hpp.two_le
    intro h1
    rw [h1, orderOf_one] at hηo
    omega
  have hBsr : Bs ≤ χ₂.range := by
    rw [hχ₂range]
    intro b hb
    exact mem_range_of_innerDiag_twistedE6 hpp hp2 hf h3 ψ hker hperf hCψ
      (by rw [hrange]; exact hS.bstar_le hb) (hS.elem.2 b hb) (hS.innerDiag b hb)
  obtain ⟨hBel, hBcard⟩ := ExcFieldAutCentRankF4.pullback_elemAbelian χ₂ hχ₂inj p Bs hBsr hS.elem
  obtain ⟨E, hE, hEfix, hEcard⟩ :=
    exists_elemAbelian_fixed_fieldActor (f := f) hf (GaloisField 2 (2 * f)) hK σ hσ hpp hp2
      hηp hη1 hBel
  let E₁ : Subgroup (twistedE6RootGroup (GaloisField 2 (2 * f)) σ) := E.map ψ'⁻¹.toMonoidHom
  have hE₁ : IsElemAbelian p E₁ := hE.map ψ'⁻¹.toMonoidHom
  have hE₁card : Nat.card E₁ = Nat.card E :=
    Subgroup.card_map_of_injective ψ'⁻¹.injective
  have hE₁fix : ∀ u ∈ E₁, α u = u := by
    intro u hu
    obtain ⟨v, hv, rfl⟩ := hu
    refine ψ'.injective ?_
    have h4 : (ψ' * α * ψ'⁻¹) v = v := by rw [hψ']; exact hEfix v hv
    simpa [MulAut.mul_apply] using h4
  let E₀ : Subgroup G := E₁.map χ₂
  have hE₀ : IsElemAbelian p E₀ := hE₁.map χ₂
  have hE₀card : Nat.card E₀ = Nat.card E₁ := Subgroup.card_map_of_injective hχ₂inj
  have hE₀le : E₀ ≤ G₀ := by
    have h1 : E₀ ≤ χ₂.range := by
      rintro _ ⟨u, -, rfl⟩
      exact ⟨u, rfl⟩
    rw [hχ₂range] at h1
    rw [← hrange]
    exact h1
  have hE₀comm : ∀ u ∈ E₀, y * u = u * y := by
    rintro _ ⟨v, hv, rfl⟩
    have h1 := hα v
    rw [hE₁fix v hv] at h1
    exact mul_inv_eq_iff_eq_mul.1 h1.symm
  refine ⟨E₀, hE₀le, hE₀, hE₀comm, ?_⟩
  calc Nat.card Bs = Nat.card (Bs.comap χ₂) := hBcard.symm
    _ ≤ p * Nat.card E := hEcard
    _ = p * Nat.card E₀ := by rw [hE₀card, hE₁card]

