theorem orbitWord_conj_rootDiagUnit (j : Fin Tag.F4.rank) (b : Fin Tag.F4.rank → Kˣ) :
    ((TwistTag.E6.orbitWord (f4FoldedIndex j)).map fun k => weylElt .E6 K k 1).prod *
        rootDiagUnit .E6 (fun i => b (e6IndexToF4 i)) *
        (((TwistTag.E6.orbitWord (f4FoldedIndex j)).map fun k => weylElt .E6 K k 1).prod)⁻¹ =
      rootDiagUnit .E6 (fun i => b (e6IndexToF4 i)) *
        (rootDiagUnit .E6 (fun i => b j ^ CartanMatrix.F₄ (e6IndexToF4 i) j))⁻¹ := by
  have hpair (i k : Fin Tag.E6.rank) (v : Fin Tag.E6.rank → Kˣ) :
      (weylElt .E6 K i 1 * weylElt .E6 K k 1) * rootDiagUnit .E6 v *
        (weylElt .E6 K i 1 * weylElt .E6 K k 1)⁻¹ =
      rootDiagUnit .E6 (fun l =>
        (v l * v k ^ (-Tag.E6.cartan k l)) *
          (v i * v k ^ (-Tag.E6.cartan k i)) ^ (-Tag.E6.cartan i l)) := by
    calc _ = weylElt .E6 K i 1 *
          (weylElt .E6 K k 1 * rootDiagUnit .E6 v * (weylElt .E6 K k 1)⁻¹) *
          (weylElt .E6 K i 1)⁻¹ := by group
      _ = _ := by rw [weylElt_conj_rootDiagUnit, weylElt_conj_rootDiagUnit]
  rcases j with ⟨j, hj⟩
  change j < 4 at hj
  interval_cases j
  · erw [orbitWord_F4_node0, List.map_singleton, List.prod_singleton,
      weylElt_conj_rootDiagUnit, rootDiagUnit_inv, ← rootDiagUnit_mul]
    apply congrArg (rootDiagUnit .E6)
    funext i
    dsimp only [e6IndexToF4, Tag.cartan, Tag.cartanE, CartanMatrix.F₄, Pi.mul_apply,
      Pi.inv_apply]
    fin_cases i <;> norm_num [Fin.ext_iff, TwistTag.tag, Tag.rank]
  · erw [orbitWord_F4_node1, List.map_singleton, List.prod_singleton,
      weylElt_conj_rootDiagUnit, rootDiagUnit_inv, ← rootDiagUnit_mul]
    apply congrArg (rootDiagUnit .E6)
    funext i
    dsimp only [e6IndexToF4, Tag.cartan, Tag.cartanE, CartanMatrix.F₄, Pi.mul_apply,
      Pi.inv_apply]
    fin_cases i <;> norm_num [Fin.ext_iff, TwistTag.tag, Tag.rank]
  · erw [orbitWord_F4_node2, List.map_cons, List.map_singleton, List.prod_cons,
      List.prod_singleton, hpair, rootDiagUnit_inv, ← rootDiagUnit_mul]
    apply congrArg (rootDiagUnit .E6)
    funext i
    dsimp only [e6IndexToF4, Tag.cartan, Tag.cartanE, CartanMatrix.F₄, Pi.mul_apply,
      Pi.inv_apply]
    fin_cases i <;> norm_num [Fin.ext_iff, TwistTag.tag, Tag.rank, ← zpow_add, zpow_two, mul_assoc, pow_two]
  · erw [orbitWord_F4_node3, List.map_cons, List.map_singleton, List.prod_cons,
      List.prod_singleton, hpair, rootDiagUnit_inv, ← rootDiagUnit_mul]
    apply congrArg (rootDiagUnit .E6)
    funext i
    dsimp only [e6IndexToF4, Tag.cartan, Tag.cartanE, CartanMatrix.F₄, Pi.mul_apply,
      Pi.inv_apply]
    fin_cases i <;> norm_num [Fin.ext_iff, TwistTag.tag, Tag.rank, ← zpow_add, zpow_two, mul_assoc, pow_two]

set_option backward.isDefEq.respectTransparency false in
theorem orbitN_conj_coordHom (hσσ : ∀ c, σ (σ c) = c)
    (j : Fin 4) (a : Fin 4 → (fixField σ)ˣ) :
    (orbitN TwistTag.E6 K σ (f4FoldedIndex j) 1 : ModGL TwistTag.E6.tag K) *
        (coordHom σ hσσ a : ModGL TwistTag.E6.tag K) *
        (orbitN TwistTag.E6 K σ (f4FoldedIndex j) 1 : ModGL TwistTag.E6.tag K)⁻¹ =
      (coordHom σ hσσ a : ModGL TwistTag.E6.tag K) *
        (coordHom σ hσσ (corTuple CartanMatrix.F₄.transpose j (a j)) :
          ModGL TwistTag.E6.tag K)⁻¹ := by
  rw [coe_orbitN_one]
  have h := orbitWord_conj_rootDiagUnit (K := K) j (fun j => fixUnit σ (a j))
  change
    ((TwistTag.E6.orbitWord (f4FoldedIndex j)).map fun k => weylElt .E6 K k 1).prod *
      rootDiagUnit .E6 (fun i => fixUnit σ (a (e6IndexToF4 i))) *
      (((TwistTag.E6.orbitWord (f4FoldedIndex j)).map fun k => weylElt .E6 K k 1).prod)⁻¹ =
      rootDiagUnit .E6 (fun i => fixUnit σ (a (e6IndexToF4 i))) *
        (rootDiagUnit .E6 (fun i => fixUnit σ
          (corTuple CartanMatrix.F₄.transpose j (a j) (e6IndexToF4 i))))⁻¹
  simpa only [corTuple, Matrix.transpose_apply, map_zpow, Tag.rank] using h

end OrbitAction

end CFSG.StandardType.E6RelativeTorus
