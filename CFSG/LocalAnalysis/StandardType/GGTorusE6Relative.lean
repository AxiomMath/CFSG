variable {K : Type} [Field K] (σ : K →+* K)

theorem natCard_fixField {n : ℕ} (hn : 1 ≤ n) [Finite K]
    (hK : Nat.card K = (2 ^ n) ^ 2) (hσ : ∀ c, σ c = c ^ (2 ^ n)) :
    Nat.card (fixField σ) = 2 ^ n := by
  obtain ⟨σ0, _, _, _, _, k, hkset, hkcard, _⟩ :=
    finite_graph_field_parameter_fields TwistTag.E6 Nat.prime_two hn K hK
  have hk : fixField σ = k := by
    apply SetLike.coe_injective
    rw [hkset]
    ext c
    change σ c = c ↔ c ^ (2 ^ n) = c
    rw [hσ]
  rw [hk]
  exact hkcard

def coordHom (hσσ : ∀ c, σ (σ c) = c) : (Fin Tag.F4.rank → (fixField σ)ˣ) →*
    ↥(graphFixedRootGroup TwistTag.E6 K σ) := by
  let f : (Fin Tag.F4.rank → (fixField σ)ˣ) →* ModGL TwistTag.E6.tag K :=
    (rootDiagUnitHom TwistTag.E6.tag K).comp
      { toFun := fun a i => fixUnit σ (a (e6IndexToF4 i))
        map_one' := by funext i; simp
        map_mul' := by intros; funext i; simp }
  have hf : ∀ a, f a ∈ graphFixedRootGroup TwistTag.E6 K σ := by
    intro a
    change rootDiagUnit TwistTag.E6.tag
      (CFSG.SeitzReduction.TwistedE6Pilot.relTuple (fun j => fixUnit σ (a j))) ∈
        graphFixedRootGroup TwistTag.E6 K σ
    apply CFSG.SeitzReduction.TwistedE6Pilot.rootDiagUnit_relTuple_mem_C0
    intro j
    change Units.map σ.toMonoidHom (fixUnit σ (a j)) = fixUnit σ (a j)
    apply Units.ext
    exact mem_fixField.mp (a j : fixField σ).property
  exact f.codRestrict _ hf

theorem coe_coordHom (hσσ : ∀ c, σ (σ c) = c)
    (a : Fin Tag.F4.rank → (fixField σ)ˣ) :
    (coordHom σ hσσ a : ModGL TwistTag.E6.tag K) =
      rootDiagUnit TwistTag.E6.tag (fun i => fixUnit σ (a (e6IndexToF4 i))) := by
  rfl

theorem coordHom_injective (hσσ : ∀ c, σ (σ c) = c) :
    Function.Injective (coordHom σ hσσ) := by
  intro a b hab
  have h := congrArg (fun x : ↥(graphFixedRootGroup TwistTag.E6 K σ) =>
    (x : ModGL TwistTag.E6.tag K)) hab
  rw [coe_coordHom, coe_coordHom] at h
  have ht := rootDiagUnit_injective h
  funext j
  have hj := congrFun ht (f4IndexRep j)
  rw [e6IndexToF4_f4IndexRep] at hj
  apply Units.ext
  apply Subtype.ext
  exact congrArg (fun z : Kˣ => (z : K)) hj

theorem coordHom_pow_eq_one_iff (hσσ : ∀ c, σ (σ c) = c)
    (a : Fin Tag.F4.rank → (fixField σ)ˣ) (s : ℕ) :
    coordHom σ hσσ a ^ s = 1 ↔ ∀ j, a j ^ s = 1 := by
  rw [← map_pow, ← map_one (coordHom σ hσσ), (coordHom_injective σ hσσ).eq_iff]
  exact ⟨fun h j => congrFun h j, fun h => funext h⟩

def fullTorus : Subgroup ↥(graphFixedRootGroup TwistTag.E6 K σ) :=
  (torusGroup TwistTag.E6.tag K).subgroupOf (graphFixedRootGroup TwistTag.E6 K σ)

theorem mem_fullTorus_iff {t : ↥(graphFixedRootGroup TwistTag.E6 K σ)} :
    t ∈ fullTorus σ ↔ (t : ModGL TwistTag.E6.tag K) ∈ torusGroup TwistTag.E6.tag K :=
  Iff.rfl

theorem mem_range_coordHom_of_mem_fullTorus (hσσ : ∀ c, σ (σ c) = c)
    {q : ℕ} (hq : 1 < q) (hσ : ∀ c, σ c = c ^ q)
    {t : ↥(graphFixedRootGroup TwistTag.E6 K σ)}
    (ht : t ∈ fullTorus σ) (htq : t ^ (q - 1) = 1) :
    t ∈ (coordHom σ hσσ).range := by
  have htT : (t : ModGL TwistTag.E6.tag K) ∈ torusGroup TwistTag.E6.tag K := ht
  obtain ⟨b, hb⟩ := exists_rootDiagUnit_eq_of_mem_torusGroup htT
  have hp : ∀ i, b i ^ (q - 1) = 1 := by
    have htp : rootDiagUnit TwistTag.E6.tag (b ^ (q - 1)) =
        rootDiagUnit TwistTag.E6.tag 1 := by
      calc rootDiagUnit TwistTag.E6.tag (b ^ (q - 1)) =
          rootDiagUnit TwistTag.E6.tag b ^ (q - 1) := (rootDiagUnit_pow b _).symm
        _ = (t : ModGL TwistTag.E6.tag K) ^ (q - 1) := by rw [hb]
        _ = 1 := congrArg (fun x : ↥(graphFixedRootGroup TwistTag.E6 K σ) =>
          (x : ModGL TwistTag.E6.tag K)) htq
        _ = rootDiagUnit TwistTag.E6.tag 1 := (rootDiagUnit_one (τ := TwistTag.E6.tag)).symm
    exact fun i => congrFun (rootDiagUnit_injective htp) i
  have hbf : ∀ i, Units.map σ.toMonoidHom (b i) = b i := by
    intro i
    apply Units.ext
    change σ (b i : K) = (b i : K)
    rw [hσ, ← Units.val_pow_eq_pow_val,
      show q = q - 1 + 1 from (Nat.sub_add_cancel (by omega)).symm,
      pow_succ, hp, one_mul]
  have hsymmetric : ∀ i, b (TwistTag.E6.perm i) = b i := by
    have hfixed := ((mem_twistedFixedGroup_iff_twistHom TwistTag.E6 K σ).mp
      (graphFixedRootGroup_le _ _ _ t.2)).2
    change twistHom TwistTag.E6 K σ (t : ModGL TwistTag.E6.tag K) = t at hfixed
    rw [hb, twistHom_rootDiagUnit_eq] at hfixed
    have he := rootDiagUnit_injective hfixed
    intro i
    have h := congrFun he (TwistTag.E6.perm i)
    have hperm : TwistTag.E6.perm.symm (TwistTag.E6.perm i) = i :=
      Equiv.symm_apply_apply _ i
    rw [hperm, hbf] at h
    exact h.symm
  let a : Fin Tag.F4.rank → (fixField σ)ˣ := fun j =>
    Units.mk0 ⟨(b (f4IndexRep j) : K), (mem_fixField).mpr
      (congrArg (fun z : Kˣ => (z : K)) (hbf (f4IndexRep j)))⟩
      (by intro h; exact (b (f4IndexRep j)).ne_zero (congrArg Subtype.val h))
  refine ⟨a, Subtype.ext ?_⟩
  rw [coe_coordHom, hb]
  apply congrArg (rootDiagUnit TwistTag.E6.tag)
  funext i
  apply Units.ext
  change (b (f4IndexRep (e6IndexToF4 i)) : K) = (b i : K)
  rcases f4IndexRep_e6IndexToF4 i with h | h
  · rw [h]
  · rw [h]
    exact congrArg (fun z : Kˣ => (z : K)) (hsymmetric i)

theorem coe_coordHom_mem_splitTorsion_iff (hσσ : ∀ c, σ (σ c) = c)
    (a : Fin Tag.F4.rank → (fixField σ)ˣ) (p : ℕ) :
    (coordHom σ hσσ a : ModGL TwistTag.E6.tag K) ∈ ExcFrames.e6SplitTorsion K p ↔
      ∀ j, a j ^ p = 1 := by
  rw [coe_coordHom]
  constructor
  · rintro ⟨c, hc, -, -, heq⟩
    have he := rootDiagUnit_injective heq
    intro j
    have hp := hc (f4IndexRep j)
    rw [← congrFun he (f4IndexRep j), e6IndexToF4_f4IndexRep] at hp
    apply Units.ext
    apply Subtype.ext
    exact congrArg (fun z : Kˣ => (z : K)) hp
  · intro hp
    refine ⟨fun i => fixUnit σ (a (e6IndexToF4 i)), ?_, ?_, ?_, rfl⟩
    · intro i
      rw [← map_pow, hp, map_one]
    · rfl
    · rfl

theorem commute_coordHom_of_mem_fullTorus (hσσ : ∀ c, σ (σ c) = c)
    (a : Fin Tag.F4.rank → (fixField σ)ˣ)
    {t : ↥(graphFixedRootGroup TwistTag.E6 K σ)} (ht : t ∈ fullTorus σ) :
    Commute (coordHom σ hσσ a) t := by
  change coordHom σ hσσ a * t = t * coordHom σ hσσ a
  apply Subtype.ext
  change (coordHom σ hσσ a : ModGL TwistTag.E6.tag K) * t =
    (t : ModGL TwistTag.E6.tag K) * coordHom σ hσσ a
  rw [coe_coordHom]
  exact rootDiagUnit_mul_comm_of_mem_torusGroup
    (fun i => fixUnit σ (a (e6IndexToF4 i))) ht

theorem coordHom_mem_standardFrame_iff (hσσ : ∀ c, σ (σ c) = c)
    {p : ℕ} [Fact p.Prime] (hp5 : 5 ≤ p) {ζ : Kˣ} (hζo : orderOf ζ = p)
    (hζ : ζ ^ p = 1) (hζσ : σ (ζ : K) = ζ)
    (a : Fin Tag.F4.rank → (fixField σ)ˣ) :
    coordHom σ hσσ a ∈ (ExcFrames.twE6SplitFrameHom σ ζ hζ hζσ).range ↔
      ∀ j, a j ^ p = 1 := by
  rw [← coe_coordHom_mem_splitTorsion_iff σ hσσ a p]
  constructor
  · rintro ⟨s, hs⟩
    obtain ⟨c, hc, h05, h24, he⟩ :=
      ExcFrames.frameDiag_twE6SplitTheta_eq_rootDiagUnit hζ (Multiplicative.toAdd s)
    exact ⟨c, hc, h05, h24, (congrArg Subtype.val hs).symm.trans he⟩
  · rintro ⟨c, hc, h05, h24, he⟩
    obtain ⟨s, hs⟩ := ExcFrames.exists_frameDiag_twE6SplitTheta_eq hp5 hζo hζ hc h05 h24
    exact ⟨Multiplicative.ofAdd s, Subtype.ext (hs.trans he.symm)⟩

theorem centralizer_standardFrame_le_fullTorus
    {p : ℕ} [Fact p.Prime] (hp5 : 5 ≤ p) {ζ : Kˣ} (hζo : orderOf ζ = p)
    (hζ : ζ ^ p = 1) (hζσ : σ (ζ : K) = ζ) :
    Subgroup.centralizer ((ExcFrames.twE6SplitFrameHom σ ζ hζ hζσ).range :
      Set ↥(graphFixedRootGroup TwistTag.E6 K σ)) ≤ fullTorus σ := by
  intro t ht
  apply ExcFrames.mem_torusGroup_of_commute_e6SplitTorsion hp5 hζo
    (twistedFixedGroup_le_adjointGroup _ _ _ (graphFixedRootGroup_le _ _ _ t.2))
  rintro x ⟨c, hc, h05, h24, he⟩
  obtain ⟨s, hs⟩ := ExcFrames.exists_frameDiag_twE6SplitTheta_eq hp5 hζo hζ hc h05 h24
  have h := Subgroup.mem_centralizer_iff.mp ht
    (ExcFrames.twE6SplitFrameHom σ ζ hζ hζσ (Multiplicative.ofAdd s)) ⟨_, rfl⟩
  have h' := congrArg Subtype.val h
  change (ExcFrames.twE6SplitFrameHom σ ζ hζ hζσ (Multiplicative.ofAdd s) :
    ModGL TwistTag.E6.tag K) * t = (t : ModGL TwistTag.E6.tag K) *
    ExcFrames.twE6SplitFrameHom σ ζ hζ hζσ (Multiplicative.ofAdd s) at h'
  change frameDiag (τ := TwistTag.E6.tag) ζ hζ (ExcFrames.twE6SplitTheta p s) * t =
    (t : ModGL TwistTag.E6.tag K) *
      frameDiag (τ := TwistTag.E6.tag) ζ hζ (ExcFrames.twE6SplitTheta p s) at h'
  rw [hs, ← he] at h'
  exact h'.symm

theorem mem_standardFrame_iff_pow_mem_range (hσσ : ∀ c, σ (σ c) = c)
    {q p : ℕ} (hq : 1 < q) (hσ : ∀ c, σ c = c ^ q) (hpm : p ∣ q - 1)
    [Fact p.Prime] (hp5 : 5 ≤ p) {ζ : Kˣ} (hζo : orderOf ζ = p)
    (hζ : ζ ^ p = 1) (hζσ : σ (ζ : K) = ζ)
    (t : ↥(graphFixedRootGroup TwistTag.E6 K σ)) :
    t ∈ (ExcFrames.twE6SplitFrameHom σ ζ hζ hζσ).range ↔
      t ^ p = 1 ∧ t ∈ (coordHom σ hσσ).range := by
  constructor
  · intro ht
    have htp : t ^ p = 1 := by
      obtain ⟨s, hs⟩ := ht
      rw [← hs, ← map_pow]
      have hsp : s ^ p = 1 := by
        apply Multiplicative.toAdd.injective
        rw [toAdd_pow, toAdd_one]
        funext i
        simp
      rw [hsp, map_one]
    have htT : t ∈ fullTorus σ := by
      obtain ⟨s, hs⟩ := ht
      obtain ⟨c, -, -, -, hc⟩ :=
        ExcFrames.frameDiag_twE6SplitTheta_eq_rootDiagUnit hζ (Multiplicative.toAdd s)
      have he : (t : ModGL TwistTag.E6.tag K) = rootDiagUnit TwistTag.E6.tag c :=
        (congrArg Subtype.val hs).symm.trans hc
      have htc : rootDiagUnit TwistTag.E6.tag c ∈ adjointGroup TwistTag.E6.tag K := by
        rw [← he]
        exact twistedFixedGroup_le_adjointGroup _ _ _ (graphFixedRootGroup_le _ _ _ t.2)
      show (t : ModGL TwistTag.E6.tag K) ∈ torusGroup TwistTag.E6.tag K
      rw [he]
      exact CFSG.SeitzReduction.E6Pilot.rootDiagUnit_mem_torusGroup_of_mem_adjointGroup c htc
    have htm : t ^ (q - 1) = 1 := by
      obtain ⟨k, hk⟩ := hpm
      rw [hk, pow_mul, htp, one_pow]
    exact ⟨htp, mem_range_coordHom_of_mem_fullTorus σ hσσ hq hσ htT htm⟩
  · rintro ⟨htp, a, rfl⟩
    exact (coordHom_mem_standardFrame_iff σ hσσ hp5 hζo hζ hζσ a).mpr
      ((coordHom_pow_eq_one_iff σ hσσ a p).mp htp)

