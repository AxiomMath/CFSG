theorem subsingleton_specialLinear_of_card_le_one {ι Q : Type} [Fintype ι] [DecidableEq ι]
    [Field Q] (h : Fintype.card ι ≤ 1) :
    Subsingleton (Matrix.SpecialLinearGroup ι Q) := by
  haveI : Subsingleton ι := Fintype.card_le_one_iff_subsingleton.mp h
  infer_instance

theorem isSolvable_specialLinear_of_card_eq_two {ι Q : Type} [Fintype ι] [DecidableEq ι]
    [Field Q] (hι : Fintype.card ι = 2) (hQ : Nat.card Q = 2) :
    Group.IsSolvable (Matrix.SpecialLinearGroup ι Q) := by
  haveI : Finite Q := Nat.finite_of_card_ne_zero (by omega)
  haveI : Group.IsSolvable (Matrix.GeneralLinearGroup (Fin 2) Q) :=
    CFSG.ComponentClassification.CatalogueBGeneralLinear.generalLinear_two_small_solvable Q
      (Or.inl hQ)
  haveI : Group.IsSolvable (Matrix.SpecialLinearGroup (Fin 2) Q) :=
    Group.isSolvable_of_isSolvable_injective Matrix.SpecialLinearGroup.toGL_injective
  let e : Matrix.SpecialLinearGroup ι Q ≃* Matrix.SpecialLinearGroup (Fin 2) Q :=
    CFSG.SeitzReduction.LinearPilot.reindexSpecialLinear (K := Q)
      (Fintype.equivFinOfCardEq hι)
  exact Group.isSolvable_of_isSolvable_injective (f := e.toMonoidHom) e.injective

theorem isQuasisimple_specialLinear {ι Q : Type} [Fintype ι] [DecidableEq ι] [Field Q]
    [Finite Q] [CharP Q 2] (h2 : 2 ≤ Fintype.card ι)
    (h22 : Fintype.card ι ≠ 2 ∨ Nat.card Q ≠ 2) :
    CFSG.Assembly.IsQuasisimple (Matrix.SpecialLinearGroup ι Q) := by
  have h23 : Fintype.card ι ≠ 2 ∨ Nat.card Q ≠ 3 :=
    Or.inr LinSemisimple.natCard_ne_three
  have h : CFSG.IsQuasisimple (Matrix.SpecialLinearGroup (Fin (Fintype.card ι)) Q) :=
    CFSG.ComponentClassification.CatalogueBGeneralLinear.specialLinear_quasisimple
      (Fintype.card ι) Q h2 h22 h23
  have h' : CFSG.IsQuasisimple (Matrix.SpecialLinearGroup ι Q) :=
    (CFSG.LocalAnalysis.ComponentInitial.isQuasisimple_congr
      (CFSG.SeitzReduction.LinearPilot.reindexSpecialLinear (K := Q)
        (Fintype.equivFin ι))).2 h
  exact CFSG.ComponentClassification.CatalogueBAlternating.quasisimple_iff_native.mp h'

theorem isQuasisimple_specialLinear_of_quasisimple_range {G : Type*} [Group G] {ι Q : Type}
    [Fintype ι] [DecidableEq ι] [Field Q] [Finite Q] [CharP Q 2]
    (ρ : Matrix.SpecialLinearGroup ι Q →* G) (hq : CFSG.Assembly.IsQuasisimple ρ.range) :
    2 ≤ Fintype.card ι ∧ (Fintype.card ι ≠ 2 ∨ Nat.card Q ≠ 2) ∧
      CFSG.Assembly.IsQuasisimple (Matrix.SpecialLinearGroup ι Q) := by
  classical
  have h2a : 2 ≤ Fintype.card ι := by
    by_contra hlt
    have hle : Fintype.card ι ≤ 1 := by omega
    haveI : Subsingleton (Matrix.SpecialLinearGroup ι Q) :=
      subsingleton_specialLinear_of_card_le_one hle
    have hsub : Subsingleton ↥ρ.range := by
      refine ⟨fun a b => ?_⟩
      obtain ⟨x, hx⟩ := a.2
      obtain ⟨y, hy⟩ := b.2
      exact Subtype.ext (by rw [← hx, ← hy, Subsingleton.elim x y])
    haveI := hsub
    haveI : Nontrivial ↥ρ.range :=
      CFSG.ComponentClassification.Quasisimple.nontrivial hq
    obtain ⟨a, b, hab⟩ := exists_pair_ne ↥ρ.range
    exact hab (Subsingleton.elim a b)
  have h22 : Fintype.card ι ≠ 2 ∨ Nat.card Q ≠ 2 := by
    rw [← not_and_or]
    rintro ⟨ha2, hQ2⟩
    haveI : Group.IsSolvable (Matrix.SpecialLinearGroup ι Q) :=
      isSolvable_specialLinear_of_card_eq_two ha2 hQ2
    have hsolJ : Group.IsSolvable ↥ρ.range :=
      Group.isSolvable_of_surjective ρ.rangeRestrict_surjective
    letI : Group.IsSolvable ↥ρ.range := hsolJ
    exact CFSG.StandardType.LinSemisimple.false_of_isQuasisimple_of_le_isSolvable hq le_rfl
  exact ⟨h2a, h22, isQuasisimple_specialLinear h2a h22⟩

theorem card_eq_four_of_ker_le_center_of_lieModel {G : Type} [Group G] {ι Q : Type}
    [Fintype ι] [DecidableEq ι] [Field Q] [Finite Q] [CharP Q 2] (hι : 2 ≤ Fintype.card ι)
    (ρ : Matrix.SpecialLinearGroup ι Q →* G)
    (hker : ρ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup ι Q))
    (hq : CFSG.Assembly.IsQuasisimple ρ.range)
    (hA : LieModel (↥ρ.range ⧸ Subgroup.center ↥ρ.range) .PSL 4 2 1) :
    Fintype.card ι = 4 ∧ Nat.card Q = 2 := by
  classical
  haveI : Fintype Q := Fintype.ofFinite Q
  obtain ⟨k, -, hkcard⟩ := FiniteField.card Q 2
  have hk1 : 1 ≤ (k : ℕ) := Nat.succ_le_iff.mpr k.pos
  have hQnat : Nat.card Q = 2 ^ (k : ℕ) := by
    rw [Nat.card_eq_fintype_card, hkcard]
  obtain ⟨h2a, h22, hS⟩ := isQuasisimple_specialLinear_of_quasisimple_range ρ hq
  let S := Matrix.SpecialLinearGroup ι Q
  haveI : Group.IsPerfect S := ⟨hS.1⟩
  have hρsurj : Function.Surjective ρ.rangeRestrict := MonoidHom.rangeRestrict_surjective ρ
  have hker' : ρ.rangeRestrict.ker ≤ Subgroup.center S := by
    rw [MonoidHom.ker_rangeRestrict]
    exact hker
  have hcenter : (Subgroup.center ↥ρ.range).comap ρ.rangeRestrict = Subgroup.center S :=
    CFSG.ComponentClassification.Quasisimple.center_comap_of_central_kernel
      ρ.rangeRestrict hρsurj hker'
  let π : S →* (↥ρ.range ⧸ Subgroup.center ↥ρ.range) :=
    (QuotientGroup.mk' (Subgroup.center ↥ρ.range)).comp ρ.rangeRestrict
  have hπsurj : Function.Surjective π :=
    (QuotientGroup.mk'_surjective _).comp hρsurj
  have hπker : π.ker = Subgroup.center S := by
    change ((QuotientGroup.mk' (Subgroup.center ↥ρ.range)).comp
      ρ.rangeRestrict).ker = Subgroup.center S
    rw [← MonoidHom.comap_ker (QuotientGroup.mk' (Subgroup.center ↥ρ.range)) ρ.rangeRestrict,
      QuotientGroup.ker_mk']
    exact hcenter
  let e0 : (↥ρ.range ⧸ Subgroup.center ↥ρ.range) ≃*
      Matrix.ProjectiveSpecialLinearGroup ι Q :=
    (QuotientGroup.quotientKerEquivOfSurjective π hπsurj).symm.trans
      (QuotientGroup.quotientMulEquivOfEq hπker)
  let eι : S ≃* Matrix.SpecialLinearGroup (Fin (Fintype.card ι)) Q :=
    CFSG.SeitzReduction.LinearPilot.reindexSpecialLinear (K := Q) (Fintype.equivFin ι)
  have e1 : Matrix.ProjectiveSpecialLinearGroup ι Q ≃*
      Matrix.ProjectiveSpecialLinearGroup (Fin (Fintype.card ι)) Q :=
    QuotientGroup.congr (Subgroup.center S)
      (Subgroup.center (Matrix.SpecialLinearGroup (Fin (Fintype.card ι)) Q)) eι
      (Subgroup.map_center_eq eι)
  have e2 : Matrix.ProjectiveSpecialLinearGroup (Fin (Fintype.card ι)) Q ≃*
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL (Fintype.card ι) Q :=
    CFSG.LocalAnalysis.ComponentInitial.LinearCover.projectiveSpecialLinearEquivProjectiveSL
      (Fintype.card ι) Q
  have hmodel : LieModel (↥ρ.range ⧸ Subgroup.center ↥ρ.range) .PSL (Fintype.card ι) 2 (k : ℕ) :=
    Or.inl ⟨by decide,
      CFSG.AGLEmbedding.ToralCensus.statedClassicalModel_of_projectiveSL_evenChar hk1 hQnat h2a
        (not_and_or.mpr h22) (e0.trans (e1.trans e2))⟩
  obtain ⟨-, hcard, hk⟩ :=
    CFSG.SeitzReduction.LinearPilot.lieModel_PSL_two_unique_classicalOrSuzuki
      (m := 4) (f := 1) (by norm_num) hA (t := .PSL) (n := Fintype.card ι) (f' := (k : ℕ))
      (Or.inl (by decide)) hmodel
  exact ⟨hcard, by rw [hQnat, hk, pow_one]⟩

theorem card_eq_four_of_isQuasisimple_range_of_lieModel {G : Type} [Group G] {ι Q : Type}
    [Fintype ι] [DecidableEq ι] [Field Q] [Finite Q] [CharP Q 2]
    (ρ : Matrix.SpecialLinearGroup ι Q →* G) (hq : CFSG.Assembly.IsQuasisimple ρ.range)
    (hA : LieModel (↥ρ.range ⧸ Subgroup.center ↥ρ.range) .PSL 4 2 1) :
    Fintype.card ι = 4 ∧ Nat.card Q = 2 := by
  obtain ⟨h2a, -, hS⟩ := isQuasisimple_specialLinear_of_quasisimple_range ρ hq
  have hker : ρ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup ι Q) := by
    rcases CFSG.ComponentClassification.Quasisimple.normal_le_center_or_eq_top hS ρ.ker with
      h | h
    · exact h
    · exfalso
      have hρ1 : ρ = 1 := MonoidHom.ker_eq_top_iff.mp h
      have hbot : ρ.range = ⊥ := MonoidHom.range_eq_bot_iff.mpr hρ1
      haveI : Subsingleton ↥ρ.range := by
        refine ⟨fun a b => Subtype.ext ?_⟩
        have ha : (a : G) = 1 := Subgroup.mem_bot.mp (hbot ▸ a.2)
        have hb : (b : G) = 1 := Subgroup.mem_bot.mp (hbot ▸ b.2)
        rw [ha, hb]
      haveI : Nontrivial ↥ρ.range :=
        CFSG.ComponentClassification.Quasisimple.nontrivial hq
      obtain ⟨a, b, hab⟩ := exists_pair_ne ↥ρ.range
      exact hab (Subsingleton.elim a b)
  exact card_eq_four_of_ker_le_center_of_lieModel h2a ρ hker hq hA

theorem card_eq_four_of_range_eq {G : Type} [Group G] {ι Q : Type} [Fintype ι] [DecidableEq ι]
    [Field Q] [Finite Q] [CharP Q 2] (ρ : Matrix.SpecialLinearGroup ι Q →* G) {J : Subgroup G}
    (hJ : ρ.range = J) (hq : CFSG.Assembly.IsQuasisimple J)
    (hA : LieModel (↥J ⧸ Subgroup.center ↥J) .PSL 4 2 1) :
    Fintype.card ι = 4 ∧ Nat.card Q = 2 := by
  subst hJ
  exact card_eq_four_of_isQuasisimple_range_of_lieModel ρ hq hA

