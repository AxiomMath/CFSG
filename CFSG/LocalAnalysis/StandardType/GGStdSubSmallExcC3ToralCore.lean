variable {τ : Tag}

theorem exists_eq_zero_of_chain
    (hτ : ∀ i, τ.symmetrizer i i = 1) {Ψ : Set (Fin τ.rank → ℤ)} (hΨ : IsRootComponent Ψ)
    (f : (Fin τ.rank → ℤ) →+ ZMod 3) {a₁ a₂ a₃ : Fin τ.rank → ℤ} (h₁ : a₁ ∈ Ψ) (h₂ : a₂ ∈ Ψ)
    (h₃ : a₃ ∈ Ψ) (h₁₂ : iform a₁ a₂ = -1) (h₂₃ : iform a₂ a₃ = -1) (h₁₃ : iform a₁ a₃ = 0) :
    ∃ β ∈ Ψ, f β = 0 := by
  have r₁ := hΨ.isRoot _ h₁
  have r₂ := hΨ.isRoot _ h₂
  have r₃ := hΨ.isRoot _ h₃
  have h12 : a₁ + a₂ ∈ Ψ := hΨ.add_mem _ h₁ _ h₂ (SimplyLacedCover.isRoot_add hτ r₁ r₂ h₁₂)
  have h23 : a₂ + a₃ ∈ Ψ := hΨ.add_mem _ h₂ _ h₃ (SimplyLacedCover.isRoot_add hτ r₂ r₃ h₂₃)
  have e : iform (a₁ + a₂) a₃ = -1 := by rw [iform_add_left, h₁₃, h₂₃, zero_add]
  have h123 : a₁ + a₂ + a₃ ∈ Ψ :=
    hΨ.add_mem _ h12 _ h₃ (SimplyLacedCover.isRoot_add hτ (hΨ.isRoot _ h12) r₃ e)
  by_contra hne
  push Not at hne
  have key : ∀ a b c : ZMod 3, a ≠ 0 → b ≠ 0 → c ≠ 0 → a + b ≠ 0 → b + c ≠ 0 →
      a + b + c = 0 := by decide
  apply hne _ h123
  rw [map_add, map_add]
  refine key _ _ _ (hne _ h₁) (hne _ h₂) (hne _ h₃) ?_ ?_
  · rw [← map_add]
    exact hne _ h12
  · rw [← map_add]
    exact hne _ h23


theorem exists_root_eq_zero_or_span (hτ : ∀ i, τ.symmetrizer i i = 1)
    {Ψ : Set (Fin τ.rank → ℤ)} (hΨ : IsRootComponent Ψ) {α : Fin τ.rank → ℤ} (hα : α ∈ Ψ)
    (f : (Fin τ.rank → ℤ) →+ ZMod 3) :
    (∃ β ∈ Ψ, f β = 0) ∨ ∃ β γ : Fin τ.rank → ℤ, ∀ δ ∈ Ψ, ∃ m n : ℤ, δ = m • β + n • γ := by
  have hG : τ ≠ .G2 := by
    rintro rfl
    exact absurd (hτ 0) (by decide)
  have rα := hΨ.isRoot α hα
  by_cases h1 : Ψ ⊆ {α, -α}
  · refine Or.inr ⟨α, α, fun δ hδ => ?_⟩
    rcases h1 hδ with rfl | rfl
    · exact ⟨1, 0, by simp⟩
    · exact ⟨-1, 0, by simp⟩
  obtain ⟨δ, hδ, hδ1, hδ2, hαδ⟩ :=
    CFSG.ClassicalInvolution.Upgrade.exists_iform_ne_zero_of_not_subset hΨ hα h1
  obtain ⟨γ, hγ, hαγ⟩ : ∃ γ ∈ Ψ, iform α γ = -1 := by
    rcases SimplyLacedCover.iform_mem hτ rα (hΨ.isRoot δ hδ) (Ne.symm hδ1)
        (fun h => hδ2 (by rw [h, neg_neg])) with h | h | h
    · exact ⟨δ, hδ, h⟩
    · exact absurd h hαδ
    · exact ⟨-δ, hΨ.neg_mem δ hδ, by rw [SimplyLacedCover.iform_neg_right, h]⟩
  rcases excTL_chain_or_subset hG hΨ hα hγ (h := 1)
      (by rw [SimplyLacedCover.iform_self_eq_two hτ rα, mul_one])
      (by rw [SimplyLacedCover.iform_self_eq_two hτ (hΨ.isRoot γ hγ), mul_one]) hαγ with
    hsub | ⟨a₁, h₁, a₂, h₂, a₃, h₃, -, -, -, h₁₂, h₂₃, h₁₃⟩
  · refine Or.inr ⟨α, γ, fun δ hδ => ?_⟩
    rcases hsub hδ with rfl | rfl | rfl | rfl | rfl | rfl
    · exact ⟨1, 0, by simp⟩
    · exact ⟨0, 1, by simp⟩
    · exact ⟨1, 1, by simp⟩
    · exact ⟨-1, 0, by simp⟩
    · exact ⟨0, -1, by simp⟩
    · exact ⟨-1, -1, by rw [neg_one_smul, neg_one_smul, neg_add]⟩
  · exact Or.inl (exists_eq_zero_of_chain hτ hΨ f h₁ h₂ h₃ h₁₂ h₂₃ h₁₃)

end Roots

theorem exists_mem_ker_ne_smul {n : ℕ} (X : AddSubgroup (Fin n → ZMod 3))
    (hX : 3 ^ 4 ≤ Nat.card X) (u v : (Fin n → ZMod 3) →+ ZMod 3) (y : Fin n → ZMod 3) :
    ∃ x ∈ X, u x = 0 ∧ v x = 0 ∧ ∀ k : ZMod 3, x ≠ k • y := by
  set φ : X →+ ZMod 3 × ZMod 3 := (u.prod v).comp X.subtype with hφ
  have hrange : Nat.card φ.range ≤ 9 := by
    calc Nat.card φ.range ≤ Nat.card (ZMod 3 × ZMod 3) :=
          Nat.card_le_card_of_injective _ Subtype.val_injective
      _ = 9 := by rw [Nat.card_prod, Nat.card_zmod]
  have hmul := AddSubgroup.card_ker_mul_card_range φ
  have hX' : 81 ≤ Nat.card X := by simpa using hX
  have hker : 9 ≤ Nat.card φ.ker := by
    by_contra hlt
    push Not at hlt
    have : Nat.card φ.ker * Nat.card φ.range ≤ 8 * 9 := Nat.mul_le_mul (by omega) hrange
    omega
  by_contra hno
  push Not at hno
  have hk : ∀ w : φ.ker, ∃ k : ZMod 3, ((w : X) : Fin n → ZMod 3) = k • y := by
    intro w
    have hw : φ w = 0 := AddMonoidHom.mem_ker.mp w.2
    refine hno _ (w : X).2 ?_ ?_
    · simpa [hφ] using congrArg Prod.fst hw
    · simpa [hφ] using congrArg Prod.snd hw
  choose kf hkf using hk
  have hinj : Function.Injective kf := fun a b h =>
    Subtype.ext (Subtype.ext (by rw [hkf a, hkf b, h]))
  have h3 := Nat.card_le_card_of_injective kf hinj
  rw [Nat.card_zmod] at h3
  omega

