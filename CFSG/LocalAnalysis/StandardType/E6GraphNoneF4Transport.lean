private theorem embE6F4_coe_eq_twistedFixedGroup {L : Type} [Field L]
    (y : adjointGroup Tag.F4 L) :
    ((embE6F4 L y : adjointGroup .E6 L) : ModGL Tag.E6 L) =
      (((e6FixedF4EquivAll L).symm y :
        twistedFixedGroup TwistTag.E6 L (RingHom.id L)) : ModGL TwistTag.E6.tag L) := by
  unfold embE6F4 isoE6F4
  simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, Subgroup.coe_subtype]
  rfl

private theorem embE6F4_mem_twistedFixedGroup {L : Type} [Field L]
    (y : adjointGroup Tag.F4 L) :
    ((embE6F4 L y : adjointGroup .E6 L) : ModGL Tag.E6 L) ∈
      twistedFixedGroup TwistTag.E6 L (RingHom.id L) := by
  rw [embE6F4_coe_eq_twistedFixedGroup]
  exact ((e6FixedF4EquivAll L).symm y).2

private theorem embE6F4_baseChangeGL {L : Type} [Field L] (Fr : L →+* L)
    (x : adjointGroup Tag.F4 L)
    (hx : baseChangeGL Fr (x : ModGL Tag.F4 L) ∈ adjointGroup Tag.F4 L) :
    ((embE6F4 L ⟨_, hx⟩ : adjointGroup .E6 L) : ModGL Tag.E6 L) =
      baseChangeGL Fr ((embE6F4 L x : adjointGroup .E6 L) : ModGL Tag.E6 L) := by
  set g := (e6FixedF4EquivAll L).symm x with hg
  have key : (e6FixedF4EquivAll L).symm ⟨_, hx⟩ =
      ⟨baseChangeGL Fr (g : ModGL TwistTag.E6.tag L),
        baseChangeGL_mem_twistedFixedGroup Fr g.2⟩ := by
    rw [MulEquiv.symm_apply_eq]
    apply Subtype.ext
    rw [coe_e6FixedF4EquivAll, e6FixedToF4_baseChangeGL, ← coe_e6FixedF4EquivAll, hg,
      MulEquiv.apply_symm_apply]
  rw [embE6F4_coe_eq_twistedFixedGroup, embE6F4_coe_eq_twistedFixedGroup, key]
  rfl

private theorem canonicalRep_F4_eq {L : Type} [Field L] (w : WeylGroup Tag.F4) :
    ∃ ω : List (Fin Tag.F4.rank),
      canonicalRep (coxeterSystem Tag.F4) L w = weylWord L ω ∧
      (⟨_, canonicalRep_mem_adjointGroup (coxeterSystem Tag.F4) L w⟩ : adjointGroup Tag.F4 L) =
        (ω.map (weylElement Tag.F4 L)).prod := by
  obtain ⟨ω, hω, rfl⟩ := (coxeterSystem Tag.F4).exists_isReduced w
  have h := canonicalRep_wordProd (R := L) hω
  refine ⟨ω, h, ?_⟩
  apply Subtype.ext
  rw [SubmonoidClass.coe_list_prod, List.map_map]
  exact h

private theorem embE6F4_langEquation {L : Type} [Field L] (D : LangDatum Tag.F4 L)
    (Fr : L →+* L) (hΦ : D.Φ = Units.map (entrywiseHom Fr))
    (hn : D.n ∈ adjointGroup Tag.F4 L) {ω : List (Fin Tag.F4.rank)}
    (hnimg : ((embE6F4 L ⟨D.n, hn⟩ : adjointGroup .E6 L) : ModGL Tag.E6 L) =
      weylWord (τ := Tag.E6) L (unfoldF4 ω)) :
    Units.map (entrywiseHom Fr)
        ((embE6F4 L ⟨D.g0, D.g0_mem⟩ : adjointGroup .E6 L) : ModGL Tag.E6 L) =
      ((embE6F4 L ⟨D.g0, D.g0_mem⟩ : adjointGroup .E6 L) : ModGL Tag.E6 L) *
        weylWord (τ := Tag.E6) L (unfoldF4 ω) := by
  have hFg : baseChangeGL Fr D.g0 = D.g0 * D.n := by
    rw [← units_map_entrywiseHom_eq_baseChangeGL_self, ← hΦ]
    exact D.lang
  have hFmem : baseChangeGL Fr D.g0 ∈ adjointGroup Tag.F4 L := by
    rw [hFg]
    exact mul_mem D.g0_mem hn
  have hsub : (⟨_, hFmem⟩ : adjointGroup Tag.F4 L) = ⟨D.g0, D.g0_mem⟩ * ⟨D.n, hn⟩ :=
    Subtype.ext hFg
  rw [units_map_entrywiseHom_eq_baseChangeGL_self,
    ← embE6F4_baseChangeGL Fr ⟨D.g0, D.g0_mem⟩ hFmem, hsub, map_mul, Subgroup.coe_mul, hnimg]

private theorem embE6F4_rootDiagUnit_conj {L : Type} [Field L] (D : LangDatum Tag.F4 L)
    (b : Fin Tag.F4.rank → Lˣ) (hb : rootDiagUnit Tag.F4 b ∈ adjointGroup Tag.F4 L) :
    ((embE6F4 L (⟨D.g0, D.g0_mem⟩ * ⟨_, hb⟩ * ⟨D.g0, D.g0_mem⟩⁻¹) :
        adjointGroup .E6 L) : ModGL Tag.E6 L) =
      ((embE6F4 L ⟨D.g0, D.g0_mem⟩ : adjointGroup .E6 L) : ModGL Tag.E6 L) *
        rootDiagUnit Tag.E6 (fun i => b (e6IndexToF4 i)) *
        ((embE6F4 L ⟨D.g0, D.g0_mem⟩ : adjointGroup .E6 L) : ModGL Tag.E6 L)⁻¹ := by
  rw [map_mul, map_mul, map_inv, Subgroup.coe_mul, Subgroup.coe_mul, Subgroup.coe_inv,
    embE6F4_coe_eq_twistedFixedGroup ⟨_, hb⟩, e6FixedF4EquivAll_symm_rootDiagUnit]
  rfl

private theorem weylWord_unfold_conj_rootDiagUnit {L : Type} [Field L]
    {n : ModGL Tag.F4 L} (hn : n ∈ adjointGroup Tag.F4 L)
    {ω : List (Fin Tag.F4.rank)} (hnω : n = weylWord L ω)
    (hnimg : ((embE6F4 L ⟨n, hn⟩ : adjointGroup .E6 L) : ModGL Tag.E6 L) =
      weylWord (τ := Tag.E6) L (unfoldF4 ω))
    (b : Fin Tag.F4.rank → Lˣ) (hb : rootDiagUnit Tag.F4 b ∈ adjointGroup Tag.F4 L) :
    weylWord (τ := Tag.E6) L (unfoldF4 ω) *
        rootDiagUnit Tag.E6 (fun i => b (e6IndexToF4 i)) *
        (weylWord (τ := Tag.E6) L (unfoldF4 ω))⁻¹ =
      rootDiagUnit Tag.E6
        (fun i => weylAct ((coxeterSystem Tag.F4).wordProd ω) b (e6IndexToF4 i)) := by
  have hconj := weylWord_conj_rootDiagUnit (τ := Tag.F4) (L := L) ω b
  have hb' : rootDiagUnit Tag.F4 (weylAct ((coxeterSystem Tag.F4).wordProd ω) b) ∈
      adjointGroup Tag.F4 L := by
    rw [← hconj, ← hnω]
    exact mul_mem (mul_mem hn hb) (inv_mem hn)
  have hgrp : (⟨n, hn⟩ * ⟨_, hb⟩ * ⟨n, hn⟩⁻¹ : adjointGroup Tag.F4 L) = ⟨_, hb'⟩ := by
    apply Subtype.ext
    rw [Subgroup.coe_mul, Subgroup.coe_mul, Subgroup.coe_inv]
    change n * rootDiagUnit Tag.F4 b * n⁻¹ = _
    rw [hnω]
    exact hconj
  have h := congrArg (fun y => ((embE6F4 L y : adjointGroup .E6 L) : ModGL Tag.E6 L)) hgrp
  simp only [map_mul, map_inv, Subgroup.coe_mul, Subgroup.coe_inv] at h
  rw [hnimg, embE6F4_coe_eq_twistedFixedGroup ⟨_, hb⟩,
    embE6F4_coe_eq_twistedFixedGroup ⟨_, hb'⟩, e6FixedF4EquivAll_symm_rootDiagUnit,
    e6FixedF4EquivAll_symm_rootDiagUnit] at h
  exact h

theorem f4LangDatum_transport {L : Type} [Field L] (D : LangDatum Tag.F4 L) (Fr : L →+* L)
    (hΦ : D.Φ = Units.map (entrywiseHom Fr)) :
    ∃ ω : List (Fin Tag.F4.rank),
      D.n = weylWord L ω ∧
      ((embE6F4 L ⟨D.g0, D.g0_mem⟩ : adjointGroup .E6 L) : ModGL Tag.E6 L) ∈
        twistedFixedGroup TwistTag.E6 L (RingHom.id L) ∧
      weylWord (τ := Tag.E6) L (unfoldF4 ω) ∈ twistedFixedGroup TwistTag.E6 L (RingHom.id L) ∧
      Units.map (entrywiseHom Fr)
          ((embE6F4 L ⟨D.g0, D.g0_mem⟩ : adjointGroup .E6 L) : ModGL Tag.E6 L) =
        ((embE6F4 L ⟨D.g0, D.g0_mem⟩ : adjointGroup .E6 L) : ModGL Tag.E6 L) *
          weylWord L (unfoldF4 ω) ∧
      (∀ (b : Fin Tag.F4.rank → Lˣ) (hb : rootDiagUnit Tag.F4 b ∈ adjointGroup Tag.F4 L),
        ((embE6F4 L (⟨D.g0, D.g0_mem⟩ * ⟨_, hb⟩ * ⟨D.g0, D.g0_mem⟩⁻¹) : adjointGroup .E6 L) :
            ModGL Tag.E6 L) =
          ((embE6F4 L ⟨D.g0, D.g0_mem⟩ : adjointGroup .E6 L) : ModGL Tag.E6 L) *
            rootDiagUnit Tag.E6 (fun i => b (e6IndexToF4 i)) *
            ((embE6F4 L ⟨D.g0, D.g0_mem⟩ : adjointGroup .E6 L) : ModGL Tag.E6 L)⁻¹) ∧
      (∀ b : Fin Tag.F4.rank → Lˣ, rootDiagUnit Tag.F4 b ∈ adjointGroup Tag.F4 L →
        weylWord (τ := Tag.E6) L (unfoldF4 ω) * rootDiagUnit Tag.E6 (fun i => b (e6IndexToF4 i)) *
            (weylWord (τ := Tag.E6) L (unfoldF4 ω))⁻¹ =
          rootDiagUnit Tag.E6
            (fun i => weylAct ((coxeterSystem Tag.F4).wordProd ω) b (e6IndexToF4 i))) := by
  obtain ⟨w, hw⟩ := D.n_weyl
  obtain ⟨ω, hωrep, hωprod⟩ := canonicalRep_F4_eq (L := L) w
  have hn : D.n ∈ adjointGroup Tag.F4 L :=
    hw ▸ canonicalRep_mem_adjointGroup (coxeterSystem Tag.F4) L w
  have hnimg : ((embE6F4 L ⟨D.n, hn⟩ : adjointGroup .E6 L) : ModGL Tag.E6 L) =
      weylWord L (unfoldF4 ω) := by
    have h : (⟨D.n, hn⟩ : adjointGroup Tag.F4 L) =
        (ω.map (weylElement Tag.F4 L)).prod := by
      rw [← hωprod]
      exact Subtype.ext hw
    rw [h, coe_embE6F4_weylProd]
  refine ⟨ω, hw.trans hωrep, embE6F4_mem_twistedFixedGroup ⟨D.g0, D.g0_mem⟩, ?_,
    embE6F4_langEquation D Fr hΦ hn hnimg,
    fun b hb => embE6F4_rootDiagUnit_conj D b hb,
    fun b hb => weylWord_unfold_conj_rootDiagUnit hn (hw.trans hωrep) hnimg b hb⟩
  exact hnimg ▸ embE6F4_mem_twistedFixedGroup ⟨D.n, hn⟩

