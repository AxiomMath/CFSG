private theorem ltrsm6_ggAutFixedSubgroup_conj {X : Type*} [Group X] (s : X) :
    ggAutFixedSubgroup (MulAut.conj s) = Subgroup.centralizer ({s} : Set X) := by
  ext g
  rw [mem_ggAutFixedSubgroup, MulAut.conj_apply, mul_inv_eq_iff_eq_mul,
    Subgroup.mem_centralizer_singleton_iff]
  exact eq_comm

private theorem ltrsm6_map_centralizer_singleton {A B : Type*} [Group A] [Group B]
    (e : A ≃* B) (s : A) :
    (Subgroup.centralizer ({s} : Set A)).map e.toMonoidHom =
      Subgroup.centralizer ({e s} : Set B) := by
  ext b
  rw [Subgroup.mem_map]
  constructor
  · rintro ⟨a, ha, rfl⟩
    rw [Subgroup.mem_centralizer_singleton_iff] at ha ⊢
    show e.toMonoidHom a * e.toMonoidHom s = e.toMonoidHom s * e.toMonoidHom a
    simpa only [map_mul] using congrArg e.toMonoidHom ha
  · intro hb
    refine ⟨e.symm b, ?_, by simp⟩
    rw [Subgroup.mem_centralizer_singleton_iff] at hb ⊢
    simpa only [map_mul, MulEquiv.symm_apply_apply] using congrArg e.symm hb

private theorem ltrsm6_ringChar_eq_two {K : Type} [Field K] [Finite K] {N : ℕ}
    (hK : Nat.card K = 2 ^ N) : ringChar K = 2 := by
  letI : Fintype K := Fintype.ofFinite K
  obtain ⟨m, hp, hm⟩ := FiniteField.card K (ringChar K)
  rw [← Nat.card_eq_fintype_card, hK] at hm
  have hd : ringChar K ∣ 2 ^ N := by
    rw [hm]
    exact dvd_pow_self _ (by have := m.pos; omega)
  exact (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).1 (hp.dvd_of_dvd_pow hd)

private theorem ltrsm6_two_pow_mod_three (N : ℕ) :
    (2 ^ N) % 3 = if Even N then 1 else 2 := by
  induction N with
  | zero => norm_num
  | succ n ih =>
    rcases Nat.even_or_odd n with hn | hn
    · have h1 : (2 ^ n) % 3 = 1 := by rw [ih, if_pos hn]
      have h2 : ¬ Even (n + 1) := by
        rw [Nat.even_iff] at hn ⊢; omega
      rw [if_neg h2, pow_succ, Nat.mul_mod, h1]
    · have hne : ¬ Even n := by
        rw [Nat.even_iff]
        rw [Nat.odd_iff] at hn
        omega
      have h1 : (2 ^ n) % 3 = 2 := by rw [ih, if_neg hne]
      have h2 : Even (n + 1) := by
        rw [Nat.even_iff]
        rw [Nat.odd_iff] at hn
        omega
      rw [if_pos h2, pow_succ, Nat.mul_mod, h1]

private theorem ltrsm6_center_statedSL (d : ℕ) (K : Type) [Field K] :
    Subgroup.center (CFSG.Open.StatedSL d K) =
      (CFSG.Open.StatedScalars (Fin d) K).subgroupOf (CFSG.Open.StatedSL d K) :=
  CFSG.Quasithin.H13.A5.center_statedSL_eq_statedScalars d K

private theorem ltrsm6_quot_center_statedSL {X : Type} [Group X] {d : ℕ} {K : Type} [Field K]
    (e : X ≃* CFSG.Open.StatedSL d K) :
    Nonempty (X ⧸ Subgroup.center X ≃* CFSG.Open.StatedProj (CFSG.Open.StatedSL d K)) :=
  ⟨(QuotientGroup.congr _ _ e (Subgroup.map_center_eq e)).trans
    (QuotientGroup.quotientMulEquivOfEq (ltrsm6_center_statedSL d K))⟩

private theorem ltrsm6_quot_center_statedSU3 {X : Type} [Group X] {K : Type} [Field K]
    [Finite K] {q : ℕ} (hK : Nat.card K = q ^ 2) (e : X ≃* CFSG.Open.StatedSU 3 q K) :
    Nonempty (X ⧸ Subgroup.center X ≃* CFSG.Open.StatedProj (CFSG.Open.StatedSU 3 q K)) :=
  ⟨(QuotientGroup.congr _ _ e (Subgroup.map_center_eq e)).trans
    (QuotientGroup.quotientMulEquivOfEq
      (CFSG.HardMathSupport.Solomon.Proving.center_statedSU_three_eq_scalars hK))⟩

private theorem ltrsm6_ggHasLabel_typeA_proj {X : Type} [Group X] {r N : ℕ} {K : Type} [Field K]
    [Finite K] (hr : 1 ≤ r) (hN : 2 ≤ N) (hK : Nat.card K = 2 ^ N)
    (h : Nonempty (X ≃* CFSG.Open.StatedProj (CFSG.Open.StatedSL (r + 1) K))) :
    GGHasLabel ⟨.A, r, N⟩ X := by
  refine ggHasLabel_typeA ?_
  refine ⟨?_, K, inferInstance, inferInstance, hK, h⟩
  refine ⟨Nat.prime_two, by omega, by omega, ?_, ?_⟩
  · intro h
    have h2 : 2 ^ N = 2 := congrArg Prod.snd h
    have h4 : 4 ≤ 2 ^ N := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ N := Nat.pow_le_pow_right (by norm_num) hN
    omega
  · intro h
    have h2 : 2 ^ N = 3 := congrArg Prod.snd h
    have h4 : 4 ≤ 2 ^ N := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ N := Nat.pow_le_pow_right (by norm_num) hN
    omega

private theorem ltrsm6_ggHasLabel_twA_proj {X : Type} [Group X] {N : ℕ} {K : Type} [Field K]
    [Finite K] {q : ℕ} (hK : Nat.card K = q ^ 2) (hq : q = 2 ^ N)
    (h : Nonempty (X ≃* CFSG.Open.StatedProj (CFSG.Open.StatedSU 3 q K))) :
    GGHasLabel ⟨.twA, 2, N⟩ X := by
  subst hq
  obtain ⟨e⟩ := h
  refine ⟨K, inferInstance, inferInstance, hK, ?_⟩
  exact ⟨e⟩

private theorem ltrsm6_eq_of_isComponentOf_of_isQuasisimple {G : Type} [Group G] [Finite G]
    {C L : Subgroup G} (hL : IsComponentOf L C) (hq : CFSG.IsQuasisimple ↥C) : L = C := by
  have hqo : CFSG.Open.IsQuasisimple ↥C :=
    (CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_native ↥C).mpr hq
  have hLo : CFSG.Open.IsComponentOf L C := CFSG.Assembly.isComponentOf_iff_open.mp hL
  have hle : L ≤ C := hLo.1
  have hL' : CFSG.Open.IsComponentOf (L.subgroupOf C) ⊤ :=
    ((CFSG.Quasithin.isComponentOf_iff_subgroupOf).mp hLo).2
  have htop : L.subgroupOf C = ⊤ :=
    CFSG.ClassicalInvolution.Q3.Q3B.eq_top_of_isComponentOf_of_isQuasisimple
      (Y := ↥C) (T := L.subgroupOf C) hL' hqo
  ext x
  constructor
  · exact fun hx => hle hx
  · intro hx
    have : (⟨x, hx⟩ : C) ∈ L.subgroupOf C := by rw [htop]; trivial
    simpa only [Subgroup.mem_subgroupOf] using this

private theorem ltrsm6_ggHasLabel_quot_map {X Y : Type} [Group X] [Group Y] (e : X ≃* Y)
    {L : Subgroup X} {lab : LargeEvenLabel}
    (h : GGHasLabel lab (↥(L.map e.toMonoidHom) ⧸ Subgroup.center ↥(L.map e.toMonoidHom))) :
    GGHasLabel lab (↥L ⧸ Subgroup.center ↥L) := by
  have hcongr : Nonempty (↥L ⧸ Subgroup.center ↥L ≃*
      ↥(L.map e.toMonoidHom) ⧸ Subgroup.center ↥(L.map e.toMonoidHom)) :=
    ⟨QuotientGroup.congr _ _
      (Subgroup.equivMapOfInjective L e.toMonoidHom e.injective)
      (Subgroup.map_center_eq _)⟩
  obtain ⟨e'⟩ := hcongr
  exact ggHasLabel_of_mulEquiv e'.symm h

private theorem ltrsm6_adjoint_short
    {K : Type} [Field K] [Finite K] {N : ℕ}
    (hK : Nat.card K = 2 ^ N) (hN : 2 ≤ N)
    {z : adjointGroup .G2 K} (hzS : z ∈ CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.g2ShortSL2 K)
    (hz3 : z ^ 3 = 1) (hz1 : z ≠ 1)
    {L : Subgroup (adjointGroup .G2 K)}
    (hL : IsComponentOf L (Subgroup.centralizer ({z} : Set (adjointGroup .G2 K)))) :
    ∃ out : LargeEvenLabel, LargeEvenInLambda2 out ∧
      (out = ⟨.A, 1, N⟩ ∨ out = S2MathAs51600Small.A2Label N) ∧
      GGHasLabel out (↥L ⧸ Subgroup.center ↥L) := by
  have hK3 : ringChar K ≠ 3 := by rw [ltrsm6_ringChar_eq_two hK]; decide
  have hK4 : 4 ≤ Nat.card K := by
    rw [hK]
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ N := Nat.pow_le_pow_right (by norm_num) hN
  have hSL :=
    (CFSG.RankThree.PartTwo.Sec12.Hering129L.g2_centralizer_threeA hK3 hK4 hzS hz3 hz1).2
  have hq : CFSG.IsQuasisimple
      ↥(Subgroup.centralizer ({z} : Set (adjointGroup .G2 K))) :=
    CFSG.RankThree.PartTwo.Sec12.Hering129KRes.isQuasisimple_of_isSLThreePiAt hSL (by omega)
  have hLC : L = Subgroup.centralizer ({z} : Set (adjointGroup .G2 K)) :=
    ltrsm6_eq_of_isComponentOf_of_isQuasisimple hL hq
  subst hLC
  obtain ⟨K', hK'f, hK'fin, hdisj⟩ := hSL
  rcases hdisj with hcase | hcase
  · have hcard' : Nat.card K' = Nat.card K := hcase.1
    have hmod : Nat.card K % 3 = 1 := hcase.2.1
    obtain ⟨eSL⟩ := hcase.2.2
    have hEven : Even N := by
      have h2 : 2 ^ N % 3 = 1 := by rw [← hK]; exact hmod
      rw [ltrsm6_two_pow_mod_three N] at h2
      by_cases hE : Even N
      · exact hE
      · rw [if_neg hE] at h2; omega
    have hcard2 : Nat.card K' = 2 ^ N := hcard'.trans hK
    refine ⟨S2MathAs51600Small.A2Label N, ?_, Or.inr rfl, ?_⟩
    · rw [S2MathAs51600Small.A2Label, if_pos hEven]
      dsimp only [LargeEvenInLambda2]
      omega
    · rw [S2MathAs51600Small.A2Label, if_pos hEven]
      exact ltrsm6_ggHasLabel_typeA_proj (r := 2) (by norm_num) hN hcard2
        (ltrsm6_quot_center_statedSL eSL)
  · have hcard' : Nat.card K' = (Nat.card K) ^ 2 := hcase.1
    have hmod : Nat.card K % 3 = 2 := hcase.2.1
    obtain ⟨eSU⟩ := hcase.2.2
    have hOdd : Odd N := by
      have h2 : 2 ^ N % 3 = 2 := by rw [← hK]; exact hmod
      rw [ltrsm6_two_pow_mod_three N] at h2
      by_cases hE : Even N
      · rw [if_pos hE] at h2; omega
      · exact Nat.not_even_iff_odd.mp hE
    refine ⟨S2MathAs51600Small.A2Label N, ?_, Or.inr rfl, ?_⟩
    · rw [S2MathAs51600Small.A2Label, if_neg (Nat.not_even_iff_odd.mpr hOdd)]
      dsimp only [LargeEvenInLambda2]
      omega
    · rw [S2MathAs51600Small.A2Label, if_neg (Nat.not_even_iff_odd.mpr hOdd)]
      exact ltrsm6_ggHasLabel_twA_proj hcard' hK
        (ltrsm6_quot_center_statedSU3 hcard' eSU)

private theorem ltrsm6_adjoint_long
    {K : Type} [Field K] [Finite K] {N : ℕ}
    (hK : Nat.card K = 2 ^ N) (hN : 2 ≤ N)
    {z : adjointGroup .G2 K} (hzM : z ∈ CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.g2LongSL2 K)
    (hz3 : z ^ 3 = 1) (hz1 : z ≠ 1)
    {L : Subgroup (adjointGroup .G2 K)}
    (hL : IsComponentOf L (Subgroup.centralizer ({z} : Set (adjointGroup .G2 K)))) :
    ∃ out : LargeEvenLabel, LargeEvenInLambda2 out ∧
      (out = ⟨.A, 1, N⟩ ∨ out = S2MathAs51600Small.A2Label N) ∧
      GGHasLabel out (↥L ⧸ Subgroup.center ↥L) := by
  have hK3 : ringChar K ≠ 3 := by rw [ltrsm6_ringChar_eq_two hK]; decide
  have hK4 : 4 ≤ Nat.card K := by
    rw [hK]
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ N := Nat.pow_le_pow_right (by norm_num) hN
  have hzord : orderOf z = 3 := orderOf_eq_prime hz3 hz1
  have hres : resCent (⊤ : Subgroup (adjointGroup .G2 K)) z =
      CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.g2ShortSL2 K :=
    CFSG.RankThree.PartTwo.Sec12.Hering129L.g2_resCent_threeB hK3 hK4 hzM hzord
  set C : Subgroup (adjointGroup .G2 K) :=
    Subgroup.centralizer ({z} : Set (adjointGroup .G2 K)) with hC
  have hMC : CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.g2ShortSL2 K ≤ C := by
    rw [hC, ← hres]
    exact (resCent_le ⊤ z).trans inf_le_right
  have hLperf : Group.IsPerfect ↥L := ⟨hL.2.2.1⟩
  have hLlePR : L ≤ CFSG.RankThreeCoreUniqueness.Helpers.perfectResidualOf C :=
    CFSG.RankThreeCoreUniqueness.Helpers.perfect_subgroup_le_perfectResidualOf
      L C hLperf hL.1
  have hres' : CFSG.RankThreeCoreUniqueness.Helpers.perfectResidualOf C =
      CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.g2ShortSL2 K := by
    rw [← hres, CFSG.RankThreeCoreUniqueness.Helpers.perfectResidualOf, resCent, inSubgroup,
      top_inf_eq, hC]
    rfl
  have hLle : L ≤ CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.g2ShortSL2 K :=
    hres' ▸ hLlePR
  have hLsub : CFSG.Assembly.IsSubnormal L
      (CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.g2ShortSL2 K) := by
    have h := hL.2.1.inf (CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.g2ShortSL2 K)
    rwa [inf_eq_left.mpr hLle, inf_eq_right.mpr hMC] at h
  have hLcompM : IsComponentOf L
      (CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.g2ShortSL2 K) :=
    ⟨hLle, hLsub, hL.2.2⟩
  obtain ⟨eS⟩ :=
    CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.nonempty_mulEquiv_g2ShortSL2 (K := K)
  have hqM : CFSG.IsQuasisimple
      ↥(CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.g2ShortSL2 K) :=
    CFSG.IsQuasisimple.of_mulEquiv eS.symm
      (CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.isQuasisimple_sl2 hK4)
  have hLM : L = CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.g2ShortSL2 K :=
    ltrsm6_eq_of_isComponentOf_of_isQuasisimple hLcompM hqM
  have e2 : CFSG.RankThree.PartTwo.Sec11.KS11Lie4Proof.g2ShortSL2 K ≃*
      CFSG.Open.StatedSL 2 K :=
    eS.symm.trans (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 2 K)
  refine ⟨⟨.A, 1, N⟩, ?_, Or.inl rfl, ?_⟩
  · dsimp only [LargeEvenInLambda2]; omega
  · rw [hLM]
    exact ltrsm6_ggHasLabel_typeA_proj (r := 1) (by norm_num) hN hK
      (ltrsm6_quot_center_statedSL e2)

private theorem ltrsm6_adjoint_component
    {K : Type} [Field K] [Finite K] {N : ℕ} (hK : Nat.card K = 2 ^ N) (hN : 2 ≤ N)
    {s : adjointGroup .G2 K} (hs3 : s ^ 3 = 1) (hs1 : s ≠ 1)
    {L : Subgroup (adjointGroup .G2 K)}
    (hL : IsComponentOf L (Subgroup.centralizer ({s} : Set (adjointGroup .G2 K)))) :
    ∃ out : LargeEvenLabel, LargeEvenInLambda2 out ∧
      (out = ⟨.A, 1, N⟩ ∨ out = S2MathAs51600Small.A2Label N) ∧
      GGHasLabel out (↥L ⧸ Subgroup.center ↥L) := by
  obtain ⟨c, hc | hc⟩ :=
    CFSG.RankThree.PartTwo.Sec8.Hering88F.g2_classes_of_card (k₀ := K) hN hK s hs3 hs1
  ·
    have hz3 : (c * s * c⁻¹) ^ 3 = 1 := by
      rw [← MulAut.conj_apply c s, ← map_pow, hs3, map_one]
    have hz1 : c * s * c⁻¹ ≠ 1 := by
      intro h
      have h' : (MulAut.conj c) s = (MulAut.conj c) 1 := by
        rw [map_one, MulAut.conj_apply]
        exact h
      exact hs1 ((MulAut.conj c).injective h')
    have hLz : IsComponentOf (L.map (MulAut.conj c).toMonoidHom)
        (Subgroup.centralizer ({c * s * c⁻¹} : Set (adjointGroup .G2 K))) := by
      rw [← MulAut.conj_apply c s, ← ltrsm6_map_centralizer_singleton (MulAut.conj c) s]
      exact CFSG.LocalAnalysis.ComponentInitial.isComponentOf_map_of_injective
        hL (MulAut.conj c).toMonoidHom (MulAut.conj c).injective
    obtain ⟨out, hout, hdisj, hhas⟩ := ltrsm6_adjoint_short hK hN hc hz3 hz1 hLz
    exact ⟨out, hout, hdisj, ltrsm6_ggHasLabel_quot_map (MulAut.conj c) hhas⟩
  ·
    have hz3 : (c * s * c⁻¹) ^ 3 = 1 := by
      rw [← MulAut.conj_apply c s, ← map_pow, hs3, map_one]
    have hz1 : c * s * c⁻¹ ≠ 1 := by
      intro h
      have h' : (MulAut.conj c) s = (MulAut.conj c) 1 := by
        rw [map_one, MulAut.conj_apply]
        exact h
      exact hs1 ((MulAut.conj c).injective h')
    have hLz : IsComponentOf (L.map (MulAut.conj c).toMonoidHom)
        (Subgroup.centralizer ({c * s * c⁻¹} : Set (adjointGroup .G2 K))) := by
      rw [← MulAut.conj_apply c s, ← ltrsm6_map_centralizer_singleton (MulAut.conj c) s]
      exact CFSG.LocalAnalysis.ComponentInitial.isComponentOf_map_of_injective
        hL (MulAut.conj c).toMonoidHom (MulAut.conj c).injective
    obtain ⟨out, hout, hdisj, hhas⟩ := ltrsm6_adjoint_long hK hN hc hz3 hz1 hLz
    exact ⟨out, hout, hdisj, ltrsm6_ggHasLabel_quot_map (MulAut.conj c) hhas⟩

private theorem ltrsm6_ggInnSubsetLabel_G2 {lab : LargeEvenLabel} (htag : lab.tag = .G2) :
    GGInnSubsetLabel lab :=
  Or.inl (Or.inr (Or.inl htag))

private theorem ltrsm6_markedModel_component
    {lab : LargeEvenLabel}
    (hlab : LargeEvenInLambda2 lab) (htag : lab.tag = .G2)
    {R : Type} [Group R] (hsimple : IsSimpleGroup R)
    (hna : ∃ a b : R, a * b ≠ b * a) (hM : MarkedModel lab R)
    (I F : Set (MulAut R)) (hI : I ⊆ LargeEvenInnSet R) :
    ∀ τ : MulAut R, τ ∈ I → τ ^ 3 = 1 → τ ≠ 1 →
      ∀ L : Subgroup R, IsComponentOf L (ggAutFixedSubgroup τ) →
        ∃ out : LargeEvenLabel, LargeEvenInLambda2 out ∧
          S2MathAs51600Small.TableComponentLabel lab out ∧
          GGHasLabel out (↥L ⧸ Subgroup.center ↥L) := by
  have hLie : LieModel R .G2 0 2 lab.n := by
    obtain ⟨t, l, n⟩ := lab
    have ht : t = .G2 := htag
    subst ht
    dsimp only [MarkedModel, markTag, markRank, markChar, markDeg] at hM ⊢
    exact hM
  obtain ⟨K, hKf, hKfin, hKcard, ⟨e⟩⟩ :=
    CFSG.LieType.Chevalley.nonempty_mulEquiv_adjointGroup .G2
      (CFSG.GH74.GLS.IVK.Proofs2.Ivk47.untwisted_of_lieModel_G2 hLie)
  have hn2 : 2 ≤ lab.n := by
    obtain ⟨t, l, n⟩ := lab
    have ht : t = .G2 := htag
    subst ht
    dsimp only [LargeEvenInLambda2] at hlab
    exact hlab.2.2
  have hcenter : Subgroup.center R = ⊥ := by
    rcases Subgroup.Normal.eq_bot_or_eq_top (Subgroup.center R) with h | h
    · exact h
    · exfalso
      obtain ⟨a, b, hab⟩ := hna
      have ha : a ∈ Subgroup.center R := by rw [h]; trivial
      have hb : b ∈ Subgroup.center R := by rw [h]; trivial
      exact hab (Subgroup.mem_center_iff.mp ha b).symm
  intro τ hτI hτ3 hτ1 L hLcomp
  obtain ⟨r, hr⟩ := hI hτI
  have hr3 : r ^ 3 = 1 := by
    have hmem : r ^ 3 ∈ Subgroup.center R := by
      rw [Subgroup.mem_center_iff]
      intro x
      have h1 : MulAut.conj (r ^ 3) = 1 := by
        rw [map_pow, hr, hτ3]
      have h2 : r ^ 3 * x * (r ^ 3)⁻¹ = x := by
        rw [← MulAut.conj_apply, h1]
        rfl
      have h3 : r ^ 3 * x = x * r ^ 3 := by
        calc r ^ 3 * x = (r ^ 3 * x * (r ^ 3)⁻¹) * r ^ 3 := by group
          _ = x * r ^ 3 := by rw [h2]
      exact h3.symm
    simpa [hcenter] using hmem
  have hr1 : r ≠ 1 := by
    intro h1
    rw [h1, map_one] at hr
    exact hτ1 hr.symm
  have hfix : ggAutFixedSubgroup τ = Subgroup.centralizer ({r} : Set R) := by
    rw [← hr, ltrsm6_ggAutFixedSubgroup_conj r]
  have hLcomp' : IsComponentOf L (Subgroup.centralizer ({r} : Set R)) := by
    rwa [← hfix]
  have hLmap : IsComponentOf (L.map e.toMonoidHom)
      (Subgroup.centralizer ({e r} : Set (adjointGroup .G2 K))) := by
    rw [← ltrsm6_map_centralizer_singleton e r]
    exact CFSG.LocalAnalysis.ComponentInitial.isComponentOf_map_of_injective
      hLcomp' e.toMonoidHom e.injective
  have hes3 : (e r) ^ 3 = 1 := by rw [← map_pow, hr3, map_one]
  have hes1 : e r ≠ 1 := fun h => hr1 (e.injective (by rw [h, map_one]))
  obtain ⟨out, hout, hdisj, hhas⟩ := ltrsm6_adjoint_component hKcard hn2 hes3 hes1 hLmap
  exact ⟨out, hout, Or.inl ⟨htag, hdisj⟩, ltrsm6_ggHasLabel_quot_map e hhas⟩

theorem smallTableG2_holds :
    ∀ lab : LargeEvenLabel, LargeEvenInLambda2 lab → lab.tag = .G2 →
      LargeEvenLabelAll lab (LargeEvenSimpleGuard fun R _ I _ =>
        ∀ τ : MulAut R, τ ∈ I → τ ^ 3 = 1 → τ ≠ 1 →
          ∀ L : Subgroup R, IsComponentOf L (ggAutFixedSubgroup τ) →
            ∃ out : LargeEvenLabel, LargeEvenInLambda2 out ∧
              S2MathAs51600Small.TableComponentLabel lab out ∧
              GGHasLabel out (↥L ⧸ Subgroup.center ↥L)) := by
  intro lab hlab htag
  have hall₁ : LargeEvenLabelAll lab
      (LargeEvenSimpleGuard fun R _ I _ => I ⊆ LargeEvenInnSet R) :=
    largeEvenLabelAll_subset_inn_ext hlab (ltrsm6_ggInnSubsetLabel_G2 htag)
  have hall₂ : LargeEvenLabelAll lab (LargeEvenSimpleGuard fun R _ I _ =>
      I ⊆ LargeEvenInnSet R → (∀ τ : MulAut R, τ ∈ I → τ ^ 3 = 1 → τ ≠ 1 →
        ∀ L : Subgroup R, IsComponentOf L (ggAutFixedSubgroup τ) →
          ∃ out : LargeEvenLabel, LargeEvenInLambda2 out ∧
            S2MathAs51600Small.TableComponentLabel lab out ∧
            GGHasLabel out (↥L ⧸ Subgroup.center ↥L))) :=
    largeEvenLabelAll_simple_of_markedModel hlab
      (fun R _ I F hsimple hna hM =>
        ltrsm6_markedModel_component hlab htag hsimple hna hM I F)
  intro Q hQ
  refine largeEvenRawDatum_mono ?_ (hall₂ _ (hall₁ Q hQ))
  rintro R _ I F ⟨⟨hQ', hg₁⟩, hg₂⟩
  exact ⟨hQ', fun hsimple hna => hg₂ hsimple hna (hg₁ hsimple hna)⟩

