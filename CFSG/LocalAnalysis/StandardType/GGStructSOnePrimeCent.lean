theorem GLALayer_le_normalizer_of_isComponentOf {S : Type} [Group S] [Finite S]
    {X K : Subgroup S} (hK : CFSG.Open.IsComponentOf K X) :
    CFSG.Open.GLALayer X ≤ Subgroup.normalizer (K : Set S) := by
  rw [CFSG.LocalAnalysis.GLTheoremA.I142N.GLALayer_eq_sSup]
  refine sSup_le fun K' hK' => ?_
  rcases CFSG.LocalAnalysis.GLTheoremA.I142N.isComponent_commute_or_eq hK' hK with rfl | h
  · exact Subgroup.le_normalizer
  · exact (Subgroup.commutator_eq_bot_iff_le_centralizer.mp h).trans
      (Subgroup.centralizer_le_normalizer _)

theorem isComponentOf_le_or_commutator_eq_bot_of_isSubnormal {S : Type} [Group S] [Finite S]
    {K U X : Subgroup S} (hK : CFSG.Open.IsComponentOf K X)
    (hU : CFSG.Open.IsSubnormal U X) : K ≤ U ∨ ⁅K, U⁆ = ⊥ := by
  have hUX : U ≤ X := CFSG.Open.IsSubnormal.le hU
  have hKc : CFSG.IsComponent (K.subgroupOf X) :=
    (CFSG.LocalAnalysis.ComponentInitial.isComponentOf_iff_isComponent_subgroupOf hK.1).1
      (CFSG.Assembly.isComponentOf_iff_open.2 hK)
  have hUs : (U.subgroupOf X).IsSubnormal :=
    (CFSG.Open.IsSubnormal.iff_subgroupOf hUX).1 hU
  rcases CFSG.LocalCores.component_subnormal_subgroup hKc hUs with h | h
  · left
    have h1 : (K.subgroupOf X).map X.subtype ≤ (U.subgroupOf X).map X.subtype :=
      Subgroup.map_mono h
    rwa [Subgroup.map_subgroupOf_eq_of_le hK.1, Subgroup.map_subgroupOf_eq_of_le hUX] at h1
  · right
    have h2 := CFSG.LocalCores.commutator_inf_eq_bot_of_subgroupOf (K := K) (H := U) (L := X)
      hK.1 h
    rwa [inf_eq_left.mpr hUX] at h2

private theorem le_normalizer_iSup {S : Type} [Group S] {ι : Type*} (A : ι → Subgroup S)
    {H : Subgroup S}
    (h : ∀ i, H ≤ Subgroup.normalizer (A i : Set S)) :
    H ≤ Subgroup.normalizer (⨆ i, A i : Subgroup S) := by
  intro x hx
  have hmap : ∀ i, (A i).map (MulAut.conj x).toMonoidHom = A i := fun i =>
    map_conj_eq_of_mem_normalizer (h i hx)
  have key : (⨆ i, A i).map (MulAut.conj x).toMonoidHom = ⨆ i, A i := by
    rw [Subgroup.map_iSup]
    exact iSup_congr hmap
  rw [Subgroup.mem_normalizer_iff]
  intro y
  have hiff : MulAut.conj x y ∈ (⨆ i, A i).map (MulAut.conj x).toMonoidHom ↔
      (MulAut.conj x).symm (MulAut.conj x y) ∈ ⨆ i, A i := Subgroup.mem_map_equiv
  rw [key, MulEquiv.symm_apply_apply] at hiff
  rw [← MulAut.conj_apply x y]
  exact hiff.symm

private theorem commutator_le_of_le_normalizer {S : Type} [Group S] {H K : Subgroup S}
    (h : K ≤ Subgroup.normalizer (H : Set S)) : ⁅H, K⁆ ≤ H := by
  rw [Subgroup.commutator_le]
  intro x hx y hy
  have hyx : y * x⁻¹ * y⁻¹ ∈ H := (Subgroup.mem_normalizer_iff.mp (h hy) x⁻¹).mp (H.inv_mem hx)
  have hxy : x * (y * x⁻¹ * y⁻¹) ∈ H := H.mul_mem hx hyx
  simpa [commutatorElement_def, mul_assoc] using hxy

theorem eq_sSup_components_of_perfect_isSubnormal {S : Type} [Group S] [Finite S]
    {W P : Subgroup S} (hP : CFSG.Open.IsSubnormal P W) (hperf : ⁅P, P⁆ = P)
    (hPL : P ≤ CFSG.Open.GLALayer W) :
    P = sSup {K : Subgroup S | CFSG.Open.IsComponentOf K W ∧ K ≤ P} := by
  classical
  set 𝒜 : Set (Subgroup S) := {K | CFSG.Open.IsComponentOf K W ∧ K ≤ P} with h𝒜def
  set ℬ : Set (Subgroup S) := {K | CFSG.Open.IsComponentOf K W ∧ ¬ K ≤ P} with hℬdef
  set P₁ : Subgroup S := sSup 𝒜 with hP₁def
  set R : Subgroup S := sSup ℬ with hRdef
  have hP₁le : P₁ ≤ P := sSup_le fun K hK => hK.2
  have hPsup : P ≤ P₁ ⊔ R := by
    refine hPL.trans ?_
    rw [CFSG.LocalAnalysis.GLTheoremA.I142N.GLALayer_eq_sSup]
    refine sSup_le fun K hK => ?_
    by_cases h : K ≤ P
    · exact (le_sSup (show K ∈ 𝒜 from ⟨hK, h⟩)).trans le_sup_left
    · exact (le_sSup (show K ∈ ℬ from ⟨hK, h⟩)).trans le_sup_right
  have hRP : ⁅R, P⁆ = ⊥ := by
    rw [eq_bot_iff]
    refine CFSG.Walter.commutator_sSup_le ℬ P ⊥ (fun K hK => ?_) (fun K _ => by
      intro x _
      rw [Subgroup.mem_normalizer_iff]
      intro y
      simp)
    rcases isComponentOf_le_or_commutator_eq_bot_of_isSubnormal hK.1 hP with h | h
    · exact absurd h hK.2
    · exact le_of_eq h
  have hRK : ∀ K' ∈ ℬ, ⁅P₁, K'⁆ = ⊥ := by
    intro K' hK'
    rw [eq_bot_iff]
    refine CFSG.Walter.commutator_sSup_le 𝒜 K' ⊥ (fun K hK => ?_) (fun K _ => by
      intro x _
      rw [Subgroup.mem_normalizer_iff]
      intro y
      simp)
    have hne : K ≠ K' := fun h => hK'.2 (h ▸ hK.2)
    rcases CFSG.LocalAnalysis.GLTheoremA.I142N.isComponent_commute_or_eq hK.1 hK'.1 with h | h
    · exact absurd h hne
    · exact le_of_eq h
  have hP₁R : ⁅P₁, R⁆ = ⊥ := by
    rw [Subgroup.commutator_comm, eq_bot_iff]
    refine CFSG.Walter.commutator_sSup_le ℬ P₁ ⊥ (fun K' hK' => ?_) (fun K _ => by
      intro x _
      rw [Subgroup.mem_normalizer_iff]
      intro y
      simp)
    rw [Subgroup.commutator_comm]
    exact le_of_eq (hRK K' hK')
  have hRnorm : R ≤ Subgroup.normalizer (P₁ : Set S) := by
    rw [Subgroup.commutator_comm] at hP₁R
    exact (Subgroup.commutator_eq_bot_iff_le_centralizer.mp hP₁R).trans
      (Subgroup.centralizer_le_normalizer _)
  have hP₁P : ⁅P₁, P⁆ ≤ P₁ := by
    refine CFSG.Walter.commutator_sSup_le 𝒜 P P₁ (fun K hK => ?_) (fun K hK => ?_)
    · have hKN : P ≤ Subgroup.normalizer (K : Set S) :=
        hPL.trans (GLALayer_le_normalizer_of_isComponentOf hK.1)
      exact (commutator_le_of_le_normalizer hKN).trans (le_sSup hK)
    · have hfac : ∀ K' : 𝒜, K ≤ Subgroup.normalizer (((K' : Subgroup S)) : Set S) := fun K' => by
        have hK'c : CFSG.Open.IsComponentOf (K' : Subgroup S) W := by
          have h := K'.2
          simp only [h𝒜def, Set.mem_setOf_eq] at h
          exact h.1
        exact (CFSG.LocalAnalysis.GLTheoremA.I142N.le_GLALayer hK.1).trans
          (GLALayer_le_normalizer_of_isComponentOf hK'c)
      have h := le_normalizer_iSup (fun K' : 𝒜 => ((K' : Subgroup S))) hfac
      rwa [← sSup_eq_iSup'] at h
  have hjoin : ⁅P₁ ⊔ R, P⁆ ≤ P₁ := by
    have h := CFSG.Walter.commutator_sSup_le ({P₁, R} : Set (Subgroup S)) P P₁
      (fun A hA => by
        rcases hA with rfl | rfl
        · exact hP₁P
        · rw [hRP]; exact bot_le)
      (fun A hA => by
        rcases hA with rfl | rfl
        · exact Subgroup.le_normalizer
        · exact hRnorm)
    rwa [sSup_pair] at h
  refine le_antisymm ?_ hP₁le
  calc P = ⁅P, P⁆ := hperf.symm
    _ ≤ ⁅P₁ ⊔ R, P⁆ := Subgroup.commutator_mono hPsup le_rfl
    _ ≤ P₁ := hjoin

theorem isChevSimple_of_ggInvolCentTyped
    (hL : CFSG.LocalAnalysis.GLTheoremA.I142T.LayerFixTyped)
    {X : Type} [Group X] [Finite X] {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {G₀ : Subgroup X}
    {r e : X} (he : e ∈ Subgroup.normalizer (G₀ : Set X)) (hep : orderOf e = p)
    (hcomm : Commute r e) (hV : GGInvolCentTyped G₀ r) (S : Subgroup X)
    (hSY : S ≤ Subgroup.centralizer ({r, e} : Set X) ⊓ G₀)
    (hsub : CFSG.Assembly.IsSubnormal S (Subgroup.centralizer ({r, e} : Set X) ⊓ G₀))
    (hperf : commutator ↥S = ⊤) (N : Subgroup ↥S) [N.Normal]
    (hsimp : IsSimpleGroup (↥S ⧸ N))
    (hnc : ∃ a b : ↥S ⧸ N, a * b ≠ b * a) :
    CFSG.Yardstones.Md0ec50421ce4.IsChevSimple 2 (↥S ⧸ N) := by
  classical
  haveI hFact : Fact p.Prime := ⟨hp⟩
  haveI hFact2 : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  set Y : Subgroup X := Subgroup.centralizer ({r, e} : Set X) ⊓ G₀ with hYdef
  set V : Subgroup X := Subgroup.centralizer ({r} : Set X) ⊓ G₀ with hVdef
  have hmemCe : ∀ x : X, x ∈ Subgroup.centralizer ({e} : Set X) ↔ e * x = x * e := by
    intro x
    exact ⟨fun h => Subgroup.mem_centralizer_iff.1 h e rfl,
      fun h => Subgroup.mem_centralizer_iff.2 (fun y hy => by
        rw [Set.mem_singleton_iff.1 hy]; exact h)⟩
  have hmemY : ∀ x : X, x ∈ Y ↔ x ∈ G₀ ∧ r * x = x * r ∧ e * x = x * e := by
    intro x
    constructor
    · intro hx
      obtain ⟨hx1, hx2⟩ := Subgroup.mem_inf.1 hx
      exact ⟨hx2, Subgroup.mem_centralizer_iff.1 hx1 r (Set.mem_insert_iff.2 (Or.inl rfl)),
        Subgroup.mem_centralizer_iff.1 hx1 e (Set.mem_insert_iff.2 (Or.inr rfl))⟩
    · rintro ⟨hx2, h1, h2⟩
      refine Subgroup.mem_inf.2 ⟨?_, hx2⟩
      rw [Subgroup.mem_centralizer_iff]
      intro y hy
      rcases Set.mem_insert_iff.1 hy with rfl | hy
      · exact h1
      · rw [Set.mem_singleton_iff.1 hy]; exact h2
  have hmemV : ∀ x : X, x ∈ V ↔ x ∈ G₀ ∧ r * x = x * r := by
    intro x
    constructor
    · intro hx
      obtain ⟨hx1, hx2⟩ := Subgroup.mem_inf.1 hx
      exact ⟨hx2, Subgroup.mem_centralizer_iff.1 hx1 r rfl⟩
    · rintro ⟨hx2, h1⟩
      exact Subgroup.mem_inf.2 ⟨Subgroup.mem_centralizer_iff.2 (fun y hy => by
        rw [Set.mem_singleton_iff.1 hy]; exact h1), hx2⟩
  have hYV : Y ≤ V := fun x hx => (hmemV x).2 ⟨((hmemY x).1 hx).1, ((hmemY x).1 hx).2.1⟩
  have hSY' : S ≤ Y := hSY
  have hSV : S ≤ V := hSY'.trans hYV
  have hconj_mem : ∀ g : X, g ∈ Subgroup.normalizer (G₀ : Set X) → Commute r g →
      ∀ x : X, x ∈ V → g * x * g⁻¹ ∈ V := by
    intro g hg hgc x hx
    obtain ⟨hxG, hxr⟩ := (hmemV x).1 hx
    refine (hmemV _).2 ⟨(Subgroup.mem_normalizer_iff.mp hg x).mp hxG, ?_⟩
    calc r * (g * x * g⁻¹) = (r * g) * x * g⁻¹ := by group
      _ = (g * r) * x * g⁻¹ := by rw [hgc.eq]
      _ = g * (r * x) * g⁻¹ := by group
      _ = g * (x * r) * g⁻¹ := by rw [hxr]
      _ = g * x * (r * g⁻¹) := by group
      _ = g * x * (g⁻¹ * r) := by rw [hgc.inv_right.eq]
      _ = (g * x * g⁻¹) * r := by group
  have heV : e ∈ Subgroup.normalizer (V : Set X) := by
    rw [Subgroup.mem_normalizer_iff]
    intro x
    constructor
    · exact hconj_mem e he hcomm x
    · intro hx
      have h2 := hconj_mem e⁻¹ (Subgroup.inv_mem _ he) hcomm.inv_right (e * x * e⁻¹) hx
      rwa [show e⁻¹ * (e * x * e⁻¹) * (e⁻¹)⁻¹ = x from by group] at h2
  set M : Subgroup X := Subgroup.zpowers e with hMdef
  have hM : M ≤ Subgroup.normalizer (V : Set X) := Subgroup.zpowers_le.mpr heV
  let α : ↥M →* MulAut ↥V := (Subgroup.normalizerMonoidHom (H := V)).comp (Subgroup.inclusion hM)
  have hcoe : ∀ (a : ↥M) (c : ↥V),
      ((α a) c : X) = (a : X) * (c : X) * (a : X)⁻¹ :=
    fun a c => Subgroup.normalizerMonoidHom_apply_apply_coe V (Subgroup.inclusion hM a) c
