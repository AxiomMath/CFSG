theorem isChevSimple_two_of_largeEvenMarking_of_isSimpleGroup {G : Type} [Group G]
    (hG : IsSimpleGroup G) {P : CFSG.Assembly.LargeEvenMarkProp G}
    (hM : LargeEvenMarking G P) :
    CFSG.Yardstones.Md0ec50421ce4.IsChevSimple 2 G := by
  haveI := hG
  have hnc : ∃ a b : G, a * b ≠ b * a := by
    by_contra h
    push Not at h
    have hbot : commutator G = ⊥ := by
      rw [eq_bot_iff, commutator_def]
      refine Subgroup.commutator_le.2 fun a _ b _ => ?_
      rw [Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm]
      exact h a b
    rw [hM.1] at hbot
    exact top_ne_bot hbot
  have hcenter : Subgroup.center G = ⊥ :=
    CFSG.SignalizerFunctorTheorem.CatalogBridge.center_eq_bot_of_isSimpleGroup_of_noncomm hG hnc
  exact CFSG.LocalAnalysis.GLTheoremB.MovingAround.Lemma1315b.isChevSimple_two_of_isChevTwo
    (isChevTwo_of_largeEvenMarking_of_center_eq_bot hM hcenter)

