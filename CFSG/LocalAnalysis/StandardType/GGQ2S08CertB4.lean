theorem b4c_certOK : certOK b4cGens (xLast 4) b4cSets b4cPats b4cReps b4cS2 = true := by
  decide +kernel

theorem b4c_cov : bCovB 4 b4cPats = true := by
  decide +kernel

theorem b4c_refl : reflCertB b4cGens b4cCerts = true := by
  decide +kernel

theorem b4c_frame : bFrameB 4 b4cCerts = true := by
  decide +kernel

theorem b4c_S (k : Fin 4) : bcFullS 4 k = letLin (letAt b4cGens k) := by
  refine LinearEquiv.toLinearMap_injective ((Pi.basisFun (ZMod 3) (Fin 5)).ext fun j => ?_)
  rw [Pi.basisFun_apply]
  revert k j
  decide +kernel

theorem b4c_test : ∀ A Mg : Subgroup (Vn 5 ≃ₗ[ZMod 3] Vn 5),
    TestHyp (Subgroup.closure (Set.range fun k : Fin 4 => bcFullS 4 k)) (xLast 4) A Mg →
    ∀ t₁ ∈ Mg, IsRefl t₁ → ¬ FixesLine (xLast 4) t₁ →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (xLast 4) t → t ∈ Mg :=
  linTest_bframe_of_certOK _ b4cGens rfl b4c_S b4c_refl b4c_frame b4c_certOK b4c_cov

