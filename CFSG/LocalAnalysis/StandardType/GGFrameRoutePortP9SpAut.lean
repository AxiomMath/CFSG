open CFSG.Open Multiplicative

variable {K : Type} [Field K] [Finite K] {n : ℕ} {L : Type} [Field L] [Algebra K L]
  {ζ : L} {E : Subgroup (StatedSp n K)}

@[expose] noncomputable def torusEquiv (hζ : IsPrimitiveRoot ζ 3) (F : SpFrame K n ζ E) :
    (Fin F.s → Multiplicative (ZMod 3)) ≃* E := by
  let ρ : (Fin F.s → Multiplicative (ZMod 3)) →* E :=
    { toFun := fun f => ⟨F.tor (fun i => toAdd (f i)), F.tor_mem _⟩
      map_one' := Subtype.ext F.tor_zero
      map_mul' := fun f f' => Subtype.ext (F.tor_add hζ.pow_eq_one _ _) }
  refine MulEquiv.ofBijective ρ ⟨?_, ?_⟩
  · intro f f' h
    have hff := F.tor_injective hζ (Subtype.ext_iff.mp h)
    exact funext fun i => toAdd.injective (congrFun hff i)
  · intro e
    obtain ⟨f, hf⟩ := F.mem_tor e e.property
    exact ⟨fun i => ofAdd (f i), Subtype.ext hf⟩

@[simp] theorem coe_torusEquiv (hζ : IsPrimitiveRoot ζ 3) (F : SpFrame K n ζ E)
    (f : Fin F.s → Multiplicative (ZMod 3)) :
    (F.torusEquiv hζ f : StatedSp n K) = F.tor (fun i => toAdd (f i)) := rfl

theorem exists_moveExp_of_mulAut (hn : 3 ≤ n) (hK : Nat.card K = 2)
    (hζ : IsPrimitiveRoot ζ 3) (F : SpFrame K n ζ E) (α : MulAut (StatedSp n K))
    (hα : ∀ f, α (F.tor f) ∈ E) :
    ∃ (π : Equiv.Perm (Fin F.s)) (η : Fin F.s → Bool),
      ∀ f, α (F.tor f) = F.tor (moveExp π η f) := by
  obtain ⟨g, rfl⟩ :=
    CFSG.LocalAnalysis.RankThreeTheoremC.ParabCensus.allInner_of_mulEquiv_statedSp
      hn hK (MulEquiv.refl (StatedSp n K)) α
  have hg : ∀ f, ∃ f', (g : GL (Fin n ⊕ Fin n) K) *
      (F.tor f : GL (Fin n ⊕ Fin n) K) * (g : GL (Fin n ⊕ Fin n) K)⁻¹ = F.tor f' := by
    intro f
    obtain ⟨f', hf'⟩ := F.mem_tor _ (hα f)
    refine ⟨f', ?_⟩
    simpa only [MulAut.conj_apply, Subgroup.coe_mul, Subgroup.coe_inv] using
      congrArg (fun x : StatedSp n K => (x : GL (Fin n ⊕ Fin n) K)) hf'.symm
  obtain ⟨π, η, hπη⟩ := F.exists_moveExp_of_conj hζ hg
  exact ⟨π, η, fun f => Subtype.ext (hπη f)⟩

theorem isSignedPerm_of_mulAut (hn : 3 ≤ n) (hK : Nat.card K = 2)
    (hζ : IsPrimitiveRoot ζ 3) (F : SpFrame K n ζ E)
    (Θ : (Fin F.s → Multiplicative (ZMod 3)) ≃* E)
    (hΘ : ∀ f, (Θ f : StatedSp n K) = F.tor (fun i => toAdd (f i)))
    (α : MulAut (StatedSp n K)) (αE : MulAut E)
    (hαE : ∀ e : E, (αE e : StatedSp n K) = α e) :
    SpCoord.IsSignedPerm ⇑((MulAut.congr Θ).symm αE) := by
  have hα : ∀ f, α (F.tor f) ∈ E := by
    intro f
    rw [← hαE ⟨F.tor f, F.tor_mem f⟩]
    exact (αE ⟨F.tor f, F.tor_mem f⟩).property
  obtain ⟨π, η, hπη⟩ := F.exists_moveExp_of_mulAut hn hK hζ α hα
  let φ : MulAut (Fin F.s → Multiplicative (ZMod 3)) := (MulAut.congr Θ).symm αE
  have hφ : ∀ f, (Θ (φ f) : StatedSp n K) = α (Θ f) := by
    intro f
    change (Θ (Θ.symm (αE (Θ f))) : StatedSp n K) = α (Θ f)
    rw [MulEquiv.apply_symm_apply, hαE]
  have hcoord : ∀ f, (fun i => toAdd (φ f i)) = moveExp π η (fun i => toAdd (f i)) := by
    intro f
    apply F.tor_injective hζ
    rw [← hΘ, hφ, hΘ, hπη]
  refine ⟨π.symm, fun i => if η (π.symm i) then -1 else 1, ?_, ?_⟩
  · intro i
    cases hη : η (π.symm i) <;> simp [hη]
  · intro f i
    have hi := congrFun (hcoord f) (π.symm i)
    cases hη : η (π.symm i) <;>
      simpa [φ, moveExp_apply, sgnZ, hη] using hi

theorem isSignedPerm_torusEquiv_of_mulAut (hn : 3 ≤ n) (hK : Nat.card K = 2)
    (hζ : IsPrimitiveRoot ζ 3) (F : SpFrame K n ζ E)
    (α : MulAut (StatedSp n K)) (αE : MulAut E)
    (hαE : ∀ e : E, (αE e : StatedSp n K) = α e) :
    SpCoord.IsSignedPerm ⇑((MulAut.congr (F.torusEquiv hζ)).symm αE) :=
  F.isSignedPerm_of_mulAut hn hK hζ (F.torusEquiv hζ) (F.coe_torusEquiv hζ) α αE hαE

theorem card_automizer_inner_torus_dvd [CharP K 2] (hn : 3 ≤ n) (hK : Nat.card K = 2)
    (hζ : IsPrimitiveRoot ζ 3) (F : SpFrame K n ζ E) :
    Nat.card (ggAutomizer (⊤ : Subgroup (MulAut (StatedSp n K)))
      (E.map (MulAut.conj : StatedSp n K →* MulAut (StatedSp n K)))) ∣
        2 ^ F.s * F.s.factorial := by
  let A := E.map (MulAut.conj : StatedSp n K →* MulAut (StatedSp n K))
  have hc : Function.Injective (MulAut.conj : StatedSp n K →* MulAut (StatedSp n K)) :=
    CFSG.LocalAnalysis.GLTheoremA.I131.conj_injective_of_center_eq_bot
      (CFSG.ClassicalGroups.Symplectic.center_statedSp_eq_bot_of_charP_two (by omega))
  let ι : E →* MulAut (StatedSp n K) := (MulAut.conj : StatedSp n K →* _).comp E.subtype
  let ρ : E ≃* A := (MonoidHom.ofInjective (f := ι) (hc.comp E.subtype_injective)).trans
    (MulEquiv.subgroupCongr (by rw [MonoidHom.range_comp, Subgroup.range_subtype]))
  have hρ : ∀ e : E, (ρ e : MulAut (StatedSp n K)) = MulAut.conj (e : StatedSp n K) :=
    fun _ => rfl
  let Θ := (F.torusEquiv hζ).trans ρ
  refine CFSG.StandardType.FrameRoute.P9_N3a_card_dvd Θ fun α hα => ?_
  let αE : MulAut E := (MulAut.congr ρ).symm (ggConjAut A hα)
  have hαE : ∀ e : E, (αE e : StatedSp n K) = α e := by
    intro e
    apply hc
    have he : ρ (αE e) = ggConjAut A hα (ρ e) := by
      change ρ (ρ.symm (ggConjAut A hα (ρ e))) = _
      exact ρ.apply_symm_apply _
    rw [← hρ, he, ggConjAut_apply, hρ]
    ext x
    simp [MulAut.mul_apply, MulAut.conj_apply]
  have heq : (MulAut.congr Θ).symm (ggConjAut A hα) =
      (MulAut.congr (F.torusEquiv hζ)).symm αE := by
    ext f
    simp [Θ, αE, MulAut.congr_apply]
  rw [heq]
  exact F.isSignedPerm_torusEquiv_of_mulAut hn hK hζ α αE hαE

end CFSG.StandardType.ChoiceTwo.SpFrame

