private theorem qTwoS34C_card_eq (hK : Nat.card K = 4) : Nat.card K = ((2 : ℕ) ^ 1) ^ 2 := by
  rw [hK]; norm_num

private noncomputable def qTwoS34C_coordEquiv (hK : Nat.card K = 4) {N : ℕ} (J : Finset (Fin N)) :
    ↥(coordBlockSU K 2 1 J) ≃* unitarySU 2 1 K J.card :=
  (MonoidHom.ofInjective (blockSUOn_injective (K := K) (p := 2) (f := 1) J)).symm.trans
    (MulEquiv.subgroupCongr (CFSG.LieType.Universal.Unitary.SUid_eq_statedSU
      (p := 2) (f := 1) (qTwoS34C_card_eq hK) J.card))

private theorem qTwoS34C_index_of_equiv {G G' : Type} [Group G] [Group G'] (e : G ≃* G')
    (h : ∃ k : ℕ, (commutator G').index = 2 ^ k) :
    ∃ k : ℕ, (commutator G).index = 2 ^ k := by
  obtain ⟨k, hk⟩ := h
  refine ⟨k, ?_⟩
  have hmap : (commutator G).map (e : G →* G') = commutator G' := by
    rw [show commutator G = ⁅(⊤ : Subgroup G), ⊤⁆ from rfl,
      show commutator G' = ⁅(⊤ : Subgroup G'), ⊤⁆ from rfl, Subgroup.map_commutator]
    simp
  have hindex : (commutator G).index = (commutator G').index := by
    rw [← Subgroup.index_map_equiv (commutator G) e, hmap]
  rw [hindex, hk]

private def qTwoS34C_gl {n : ℕ} (M : Matrix (Fin n) (Fin n) F4c) (h : M.det ≠ 0) :
    GL (Fin n) F4c :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero M h

private theorem qTwoS34C_mem_unitarySU_F4c {n : ℕ} (A : GL (Fin n) F4c)
    (h1 : (A : Matrix (Fin n) (Fin n) F4c).det = 1)
    (h2 : ((A : Matrix (Fin n) (Fin n) F4c).map (· ^ (2 : ℕ)))ᵀ *
      (A : Matrix (Fin n) (Fin n) F4c) = 1) :
    A ∈ unitarySU 2 1 F4c n := by
  change A ∈ Subgroup.closure {B : GL (Fin n) F4c |
    (B : Matrix (Fin n) (Fin n) F4c).det = 1 ∧
      ((B : Matrix (Fin n) (Fin n) F4c).map (· ^ (2 : ℕ)))ᵀ *
        (B : Matrix (Fin n) (Fin n) F4c) = 1}
  exact Subgroup.subset_closure ⟨h1, h2⟩

private def qTwoS34C_A3 : unitarySU 2 1 F4c 3 :=
  ⟨qTwoS34C_gl !![z0, z1, z0; z1, z0, z0; z0, z0, z1] (by decide +kernel),
   qTwoS34C_mem_unitarySU_F4c _ (by decide +kernel) (by decide +kernel)⟩

private def qTwoS34C_B3 : unitarySU 2 1 F4c 3 :=
  ⟨qTwoS34C_gl !![z1, z0, z0; z0, z0, z1; z0, z1, z0] (by decide +kernel),
   qTwoS34C_mem_unitarySU_F4c _ (by decide +kernel) (by decide +kernel)⟩

private def qTwoS34C_Bp3 : unitarySU 2 1 F4c 3 :=
  ⟨qTwoS34C_gl !![z1, z0, z0; z0, w, z0; z0, z0, w2] (by decide +kernel),
   qTwoS34C_mem_unitarySU_F4c _ (by decide +kernel) (by decide +kernel)⟩

private def qTwoS34C_P3 : unitarySU 2 1 F4c 3 := ⁅qTwoS34C_A3, qTwoS34C_B3⁆

private def qTwoS34C_D3 : unitarySU 2 1 F4c 3 := ⁅qTwoS34C_A3, qTwoS34C_Bp3⁆

private def qTwoS34C_z3 : unitarySU 2 1 F4c 3 := ⁅qTwoS34C_P3, qTwoS34C_D3⁆

private def qTwoS34C_f3 : Fin 3 × Fin 3 × Fin 3 → unitarySU 2 1 F4c 3 :=
  fun t => qTwoS34C_P3 ^ (t.1 : ℕ) * qTwoS34C_D3 ^ (t.2.1 : ℕ) * qTwoS34C_z3 ^ (t.2.2 : ℕ)

private def qTwoS34C_S3 : Subgroup (unitarySU 2 1 F4c 3) where
  carrier := Set.range qTwoS34C_f3
  mul_mem' := by
    rintro _ _ ⟨t, rfl⟩ ⟨u, rfl⟩
    have key : ∀ t u : Fin 3 × Fin 3 × Fin 3,
        ∃ v : Fin 3 × Fin 3 × Fin 3, qTwoS34C_f3 v = qTwoS34C_f3 t * qTwoS34C_f3 u := by
      decide +kernel
    exact key t u
  one_mem' := ⟨(0, (0, 0)), by decide +kernel⟩
  inv_mem' := by
    rintro _ ⟨t, rfl⟩
    have key : ∀ t : Fin 3 × Fin 3 × Fin 3,
        ∃ v : Fin 3 × Fin 3 × Fin 3, qTwoS34C_f3 v = (qTwoS34C_f3 t)⁻¹ := by
      decide +kernel
    exact key t

private theorem qTwoS34C_inj3 : Function.Injective qTwoS34C_f3 := by
  decide +kernel

private theorem qTwoS34C_card_S3 : Nat.card ↥qTwoS34C_S3 = 27 := by
  change Nat.card (Set.range qTwoS34C_f3) = 27
  rw [Nat.card_range_of_injective qTwoS34C_inj3, Nat.card_eq_fintype_card]
  decide

private theorem qTwoS34C_S3_le_commutator :
    qTwoS34C_S3 ≤ commutator (unitarySU 2 1 F4c 3) := by
  intro x hx
  obtain ⟨t, rfl⟩ := hx
  have hP : qTwoS34C_P3 ∈ commutator (unitarySU 2 1 F4c 3) :=
    Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
  have hD : qTwoS34C_D3 ∈ commutator (unitarySU 2 1 F4c 3) :=
    Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
  have hz : qTwoS34C_z3 ∈ commutator (unitarySU 2 1 F4c 3) :=
    Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.pow_mem _ hP _) (Subgroup.pow_mem _ hD _))
    (Subgroup.pow_mem _ hz _)

private theorem qTwoS34C_dvd_commutator_F4c_three :
    27 ∣ Nat.card ↥(commutator (unitarySU 2 1 F4c 3)) := by
  have hcard := Subgroup.card_dvd_of_le qTwoS34C_S3_le_commutator
  rwa [qTwoS34C_card_S3] at hcard

private def qTwoS34C_A2 : unitarySU 2 1 F4c 2 :=
  ⟨qTwoS34C_gl !![z0, z1; z1, z0] (by decide +kernel),
   qTwoS34C_mem_unitarySU_F4c _ (by decide +kernel) (by decide +kernel)⟩

private def qTwoS34C_B2 : unitarySU 2 1 F4c 2 :=
  ⟨qTwoS34C_gl !![z0, w; w2, z0] (by decide +kernel),
   qTwoS34C_mem_unitarySU_F4c _ (by decide +kernel) (by decide +kernel)⟩

private def qTwoS34C_P2 : unitarySU 2 1 F4c 2 := ⁅qTwoS34C_A2, qTwoS34C_B2⁆

private theorem qTwoS34C_dvd_commutator_F4c_two :
    3 ∣ Nat.card ↥(commutator (unitarySU 2 1 F4c 2)) := by
  have hle : Subgroup.zpowers qTwoS34C_P2 ≤ commutator (unitarySU 2 1 F4c 2) := by
    intro x hx
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
    exact Subgroup.zpow_mem _ (Subgroup.commutator_mem_commutator (Subgroup.mem_top _)
      (Subgroup.mem_top _)) n
  have hcard := Subgroup.card_dvd_of_le hle
  have hz : Nat.card ↥(Subgroup.zpowers qTwoS34C_P2) = 3 := by
    rw [Nat.card_zpowers]
    exact orderOf_eq_prime (by decide +kernel) (by decide +kernel)
  rwa [hz] at hcard

private theorem qTwoS34C_card_unitarySU_F4c_two : Nat.card (unitarySU 2 1 F4c 2) = 6 := by
  have hdata : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData 2 1 F4c :=
    CFSG.RankThree.PartOne.KFU.unitaryFieldData_two (K := F4c) (f := 1)
      (by rw [Nat.card_eq_fintype_card, F4c.card_eq]; norm_num) (by norm_num)
  haveI : CharP F4c 2 := hdata.charP
  have hval : (Nat.card (unitarySU 2 1 F4c 2) : ℤ) = 6 := by
    rw [show unitarySU 2 1 F4c 2 = CFSG.Open.StatedSU 2 (2 ^ 1) F4c from rfl,
      CFSG.RankThree.PartOne.KFU.card_statedSU_eq (K := F4c) (f := 1) hdata (n := 2) (by norm_num)]
    decide
  exact_mod_cast hval

private theorem qTwoS34C_card_unitarySU_F4c_three : Nat.card (unitarySU 2 1 F4c 3) = 216 := by
  have hdata : CFSG.LocalAnalysis.ComponentInitial.UnitaryFieldData 2 1 F4c :=
    CFSG.RankThree.PartOne.KFU.unitaryFieldData_two (K := F4c) (f := 1)
      (by rw [Nat.card_eq_fintype_card, F4c.card_eq]; norm_num) (by norm_num)
  haveI : CharP F4c 2 := hdata.charP
  have hval : (Nat.card (unitarySU 2 1 F4c 3) : ℤ) = 216 := by
    rw [show unitarySU 2 1 F4c 3 = CFSG.Open.StatedSU 3 (2 ^ 1) F4c from rfl,
      CFSG.RankThree.PartOne.KFU.card_statedSU_eq (K := F4c) (f := 1) hdata (n := 3) (by norm_num)]
    decide
  exact_mod_cast hval

private lemma qTwoS34C_index_isPow_two_of_dvd {G : Type} [Group G] {a n m : ℕ}
    (ha : 0 < a) (hdiv : a ^ n ∣ Nat.card ↥(commutator G))
    (hcard : Nat.card G = a ^ n * 2 ^ m) :
    ∃ k : ℕ, (commutator G).index = 2 ^ k := by
  obtain ⟨q, hq⟩ := hdiv
  have hci := Subgroup.card_mul_index (commutator G)
  have h1 : a ^ n * (q * (commutator G).index) = a ^ n * 2 ^ m := by
    rw [← hcard, ← hci, hq]; ring
  have h2 : q * (commutator G).index = 2 ^ m :=
    Nat.mul_left_cancel (pow_pos ha n) h1
  have hdvd : (commutator G).index ∣ 2 ^ m := ⟨q, by rw [mul_comm, h2]⟩
  obtain ⟨k, -, hk⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd
  exact ⟨k, hk⟩

private theorem qTwoS34C_index_commutator_F4c_two :
    ∃ k : ℕ, (commutator (unitarySU 2 1 F4c 2)).index = 2 ^ k :=
  qTwoS34C_index_isPow_two_of_dvd (a := 3) (n := 1) (m := 1) (by norm_num)
    qTwoS34C_dvd_commutator_F4c_two
    (by rw [qTwoS34C_card_unitarySU_F4c_two]; norm_num)

private theorem qTwoS34C_index_commutator_F4c_three :
    ∃ k : ℕ, (commutator (unitarySU 2 1 F4c 3)).index = 2 ^ k :=
  qTwoS34C_index_isPow_two_of_dvd (a := 3) (n := 3) (m := 3) (by norm_num)
    qTwoS34C_dvd_commutator_F4c_three
    (by rw [qTwoS34C_card_unitarySU_F4c_three]; norm_num)

theorem index_commutator_coordBlockSU_isPow_two (hK : Nat.card K = 4) {N : ℕ} {J : Finset (Fin N)}
    (hJ2 : 2 ≤ J.card) (hJ3 : J.card ≤ 3) :
    ∃ k : ℕ, (commutator ↥(coordBlockSU K 2 1 J)).index = 2 ^ k := by
  have hcardJ : J.card = 2 ∨ J.card = 3 := by omega
  obtain ⟨φ⟩ := CFSG.GH74.Generic.S3.exists_ringEquiv_of_card_eq (K := K) (F := F4c)
    (by rw [hK, Nat.card_eq_fintype_card, F4c.card_eq])
  have eC : ↥(coordBlockSU K 2 1 J) ≃* unitarySU 2 1 K J.card := qTwoS34C_coordEquiv hK J
  rcases hcardJ with h2 | h3
  · have hJ : J.card = 2 := h2
    exact qTwoS34C_index_of_equiv (eC.trans (by
      rw [hJ]
      exact CFSG.GH74.Generic.S3.statedSUFieldEquiv φ 2 (2 ^ 1)))
      qTwoS34C_index_commutator_F4c_two
  · have hJ : J.card = 3 := h3
    exact qTwoS34C_index_of_equiv (eC.trans (by
      rw [hJ]
      exact CFSG.GH74.Generic.S3.statedSUFieldEquiv φ 3 (2 ^ 1)))
      qTwoS34C_index_commutator_F4c_three

