namespace CFSG.SeitzReduction.F4Pilot

open CFSG.Blueprint.Chevalley

open CFSG.LieType.Steinberg

def b2Words : List (List ℕ) :=
  [[], [1], [2], [1, 2], [2, 1], [1, 2, 1], [2, 1, 2], [1, 2, 1, 2]]

open scoped CFSG.Decide.Bounded in
theorem b2Words_table :
    ∀ X ∈ b2List, ∀ Y ∈ b2List,
      Adjoint.iform X X = 4 → Adjoint.iform Y Y = 2 → Adjoint.iform X Y = -2 →
        ∃ ω ∈ b2Words, wordAct ω v0100 = X ∧ wordAct ω v0010 = Y := by
  decide +kernel

open scoped CFSG.Decide.Bounded in
theorem b2Words_letters : ∀ ω ∈ b2Words, ∀ i ∈ ω, i = 1 ∨ i = 2 := by
  decide +kernel

section

theorem mem_b2List_of_mem_b2LeviRoots_narrow
    {γ : Fin (Tag.rank .F4) → ℤ}
    (hγ : γ ∈ b2LeviRoots) : γ ∈ b2List := by
  obtain ⟨hr, h0, h3⟩ := mem_b2LeviRoots.1 hγ
  have hmem := mem_rootFinset.2 hr
  have key : ∀ v ∈ rootFinset .F4, v (0 : Fin 4) = 0 → v (3 : Fin 4) = 0 → v ∈ b2List := by
    decide +kernel
  exact key γ hmem h0 h3

theorem b2LeviRoots_pair_table :
    ∀ X ∈ b2LeviRoots, ∀ Y ∈ b2LeviRoots,
      Adjoint.iform X X = 4 → Adjoint.iform Y Y = 2 → Adjoint.iform X Y = -2 →
        ∃ ω ∈ b2Words, wordAct ω v0100 = X ∧ wordAct ω v0010 = Y := by
  intro X hX Y hY
  exact b2Words_table X (mem_b2List_of_mem_b2LeviRoots_narrow hX) Y
    (mem_b2List_of_mem_b2LeviRoots_narrow hY)

end

end CFSG.SeitzReduction.F4Pilot

