theorem notExcThreeOrder_card_adjointGroup {τ : Tag}
    (hτ : τ = .F4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8) {K : Type} [Field K] [Finite K]
    (hK : Nat.card K = 2) : GGNotExcThreeOrder (Nat.card ↥(adjointGroup τ K)) := by
  rcases hτ with rfl | rfl | rfl | rfl
  · rw [ExceptionalOrders.card_adjointGroup_F4, hK]
    unfold GGNotExcThreeOrder CFSG.Open.ordF4
    norm_num
  · rw [ExceptionalOrders.card_adjointGroup_E6, hK]
    unfold GGNotExcThreeOrder CFSG.Open.ordE6
    norm_num
  · rw [ExceptionalOrders.card_adjointGroup_E7, hK]
    unfold GGNotExcThreeOrder CFSG.Open.ordE7
    norm_num
  · rw [ExceptionalOrders.card_adjointGroup_E8, hK]
    unfold GGNotExcThreeOrder CFSG.Open.ordE8
    norm_num

theorem notExcThree_of_isComponentOf_top {τ : Tag}
    (hτ : τ = .F4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8) {K : Type} [Field K] [Finite K]
    (hK : Nat.card K = 2) {J : Subgroup ↥(adjointGroup τ K)} (hJ : IsComponentOf J ⊤) :
    GGNotExcThreeOrder (ggCQ J) := by
  classical
  have hperf : Group.IsPerfect ↥(adjointGroup τ K) :=
    ⟨single_edge_perfect τ K (by rcases hτ with h | h | h | h <;> simp [h])⟩
  haveI := (ExcCopy.isSimpleGroup_adjointGroup_of_perfect τ K hperf).1
  have hJnt : Nontrivial ↥J := by
    have h2 : Nontrivial (↥J ⧸ Subgroup.center ↥J) := hJ.2.2.2.toNontrivial
    have hs : Function.Surjective (QuotientGroup.mk : ↥J → ↥J ⧸ Subgroup.center ↥J) :=
      QuotientGroup.mk_surjective
    exact hs.nontrivial
  have hJtop : J = ⊤ := by
    rcases IsSubnormal.eq_bot_or_top hJ.2.1 with h | h
    · exfalso
      subst h
      exact not_nontrivial_iff_subsingleton.mpr (inferInstance : Subsingleton (⊥ : Subgroup _))
        hJnt
    · exact h
  subst hJtop
  rw [ggCQ_eq_of_mulEquiv (Subgroup.topEquiv : (⊤ : Subgroup ↥(adjointGroup τ K)) ≃* _),
    ExceptionalOrders.card_adjointQuotient τ]
  exact notExcThreeOrder_card_adjointGroup hτ hK

theorem notExcThree_of_isComponentOf_centralizer {τ : Tag}
    (hτ : τ = .F4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8) (hrat : ExcThreeTwoRatNotExc τ)
    {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2) {s : ↥(adjointGroup τ K)}
    (hs3 : s ^ 3 = 1) (hs1 : s ≠ 1) {J : Subgroup ↥(adjointGroup τ K)}
    (hJ : CFSG.Open.IsComponentOf J (Subgroup.centralizer ({s} : Set ↥(adjointGroup τ K)))) :
    GGNotExcThreeOrder (ggCQ J) := by
  classical
  have hτ' : τ = .G2 ∨ τ = .F4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8 := by
    rcases hτ with h | h | h | h <;> simp [h]
  have hτ2 : τ = .F4 ∨ τ = .D4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8 := by
    rcases hτ with h | h | h | h <;> simp [h]
  have hτ3 : τ = .G2 ∨ τ = .F4 ∨ τ = .D4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8 := by
    rcases hτ with h | h | h | h <;> simp [h]
  have hperf : commutator ↥(adjointGroup τ K) = ⊤ := single_edge_perfect τ K hτ2
  have h3K : ¬ 3 ∣ Nat.card K := by rw [hK]; norm_num
  have h5K : ¬ 5 ∣ Nat.card K := by rw [hK]; norm_num
  have hmon : MonomialToralAt τ 3 :=
    monomialToralAt_exc monomialToralAt_E6_five monomialToralAt_E7_five hτ3 Nat.prime_three
      (by norm_num)
  set β : MulAut ↥(adjointGroup τ K) := MulAut.conj s with hβdef
  have hhL : baseChangeGL (algebraMap K (AlgebraicClosure K)) (s : ModGL τ K) ∈
      adjointGroup τ (AlgebraicClosure K) :=
    CFSG.LieType.Chevalley.baseChangeGL_mem_adjointGroup _ s.2
  have hβ : ∀ c, (β c : ModGL τ K) = (s : ModGL τ K) * c * (s : ModGL τ K)⁻¹ := fun c => rfl
  have hp1 : (s : ModGL τ K) ^ 3 = 1 := by rw [← Subgroup.coe_pow, hs3, Subgroup.coe_one]
  have hh1 : (s : ModGL τ K) ≠ 1 := fun h' => hs1 (Subtype.ext h')
  obtain ⟨S, a, ι, hSq, ⟨Fr, hFr1, hFr2⟩, hT, hap, h1, hinj, hrange, hconj⟩ :=
    exists_langSetup_of_inner_untw_of_prime hτ' Nat.prime_three h3K Nat.prime_five h5K
      (Or.inl le_rfl) hmon hperf β (s : ModGL τ K) hhL hβ hp1 hh1
  have h3L : ((3 : ℕ) : AlgebraicClosure K) ≠ 0 :=
    natCast_ne_zero_algebraicClosure Nat.prime_three h3K
  have hTame := langSetup_hTame_of_prime S Nat.prime_three h3L
    (fun h' => absurd h' (by rcases hτ with h | h | h | h <;> simp [h])) hT hap h1
  have hfix : fixSubgroup β = Subgroup.centralizer ({s} : Set ↥(adjointGroup τ K)) := by
    ext x
    rw [mem_fixSubgroup, Subgroup.mem_centralizer_singleton_iff, hβdef, MulAut.conj_apply,
      mul_inv_eq_iff_eq_mul, eq_comm]
  rw [← hfix] at hJ
  obtain ⟨i, hq, hJR⟩ := components_of_langSetup S Nat.prime_three ι hinj hrange β hconj hT hap
    h1 hTame hJ
  have hR := hrat (AlgebraicClosure K) 5 S ⟨Fr, fun c => by rw [hSq]; exact hFr1 c, hFr2⟩
    (hSq.trans hK) a hT hap h1 i hq
  rwa [← ggCQ_map_of_injective ι hinj J, hJR]

theorem centCompNotExcThreeAt_three_adjointGroup {τ : Tag}
    (hτ : τ = .F4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8) (hrat : ExcThreeTwoRatNotExc τ)
    {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2) :
    CentCompNotExcThreeAt 3 ↥(adjointGroup τ K) := by
  intro s hs3 J hJ
  by_cases hs1 : s = 1
  · subst hs1
    have h1 : Subgroup.centralizer ({1} : Set ↥(adjointGroup τ K)) = ⊤ :=
      eq_top_iff.mpr fun x _ => Subgroup.mem_centralizer_singleton_iff.mpr (by simp)
    rw [h1] at hJ
    exact notExcThree_of_isComponentOf_top hτ hK hJ
  · exact notExcThree_of_isComponentOf_centralizer hτ hrat hK hs3 hs1
      (isComponentOf_iff_open.mp hJ)

