private theorem ncard_kernelRoots_kg87bTv
    {Ω : Type} [Field Ω] {ω : Ωˣ} (hω : orderOf ω = 3) :
    (kernelRoots (CFSG.LieType.AlgebraicGroups.rootCharHom
      (Pi.mulSingle 1 ω * Pi.mulSingle 3 (ω ^ 2) : Fin Tag.E6.rank → Ωˣ))).ncard = 30 := by
  classical
  have hω3 : ω ^ 3 = 1 := hω ▸ pow_orderOf_eq_one ω
  have hω1 : ω ≠ 1 := by
    rintro rfl
    rw [orderOf_one] at hω
    exact absurd hω (by decide)
  have ha : (Pi.mulSingle 1 ω * Pi.mulSingle 3 (ω ^ 2) : Fin Tag.E6.rank → Ωˣ) =
      CFSG.HardMathSupport.Timmesfeld.CrossChar.SmallQ3.torV ω ![0, 1, 0, 2, 0, 0] := by
    funext i
    rw [Pi.mul_apply]
    fin_cases i
    · show (1 : Ωˣ) * 1 = ω ^ 0
      rw [pow_zero, mul_one]
    · show ω * 1 = ω ^ 1
      rw [pow_one, mul_one]
    · show (1 : Ωˣ) * 1 = ω ^ 0
      rw [pow_zero, mul_one]
    · show 1 * ω ^ 2 = ω ^ 2
      rw [one_mul]
    · show (1 : Ωˣ) * 1 = ω ^ 0
      rw [pow_zero, mul_one]
    · show (1 : Ωˣ) * 1 = ω ^ 0
      rw [pow_zero, mul_one]
  rw [ha, CFSG.LieType.AlgebraicGroups.kernelRoots_rootCharHom]
  have hset : {α | IsRoot Tag.E6 α ∧ rootChar
      (CFSG.HardMathSupport.Timmesfeld.CrossChar.SmallQ3.torV ω ![0, 1, 0, 2, 0, 0]) α = 1} =
      ↑((rootFinset Tag.E6).filter fun α => rootChar
        (CFSG.HardMathSupport.Timmesfeld.CrossChar.SmallQ3.torV ω ![0, 1, 0, 2, 0, 0]) α = 1) := by
    ext α
    rw [Finset.coe_filter, Set.mem_setOf_eq, Set.mem_setOf_eq, mem_rootFinset]
  rw [hset, Set.ncard_coe_finset]
  refine (CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.card_filter_rootChar_torV hω3 hω1
    _).trans ?_
  decide +kernel

private theorem commutator_mem_and_not_mem_kg87bTv
    {K : Type} [Field K] {σ : K ≃+* K} {Ω : Type} [Field Ω] [CharP Ω 2]
    {E : Subgroup ↥(twistedE6RootGroup K σ)} (hE : IsElemAbelian 3 E) {ω : Ωˣ}
    (hω : orderOf ω = 3) {Y : ModGL Tag.E6 Ω} {h₀ u w : ↥(twistedE6RootGroup K σ)}
    {φ : ↥(twistedE6RootGroup K σ) →* ModGL Tag.E6 Ω} (hφ : Function.Injective φ)
    (hYh₀ : Y * φ h₀ * Y⁻¹ = rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω))
    (hYu : Y * φ u * Y⁻¹ = rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω * Pi.mulSingle 3 (ω ^ 2)))
    (hall : ∀ e ∈ E, Y * φ e * Y⁻¹ ∈ thirdTorus Ω ⊔ blockGroup Ω) {s : ModGL Tag.E6 Ω}
    (hs : s ∈ thirdTorus Ω) (hw : φ w = Y⁻¹ * (thirdWeyl Ω * s) * Y) :
    (∀ e ∈ E, w * e * w⁻¹ * e⁻¹ ∈ Subgroup.closure ({h₀, u} : Set _)) ∧
      w * h₀ * w⁻¹ ∉ Subgroup.zpowers h₀ := by
  have hxS : rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) ∈ thirdTorus Ω := by
    have h := rootDiagUnit_mem_thirdTorus_kg87bRat (Ω := Ω) ω 1
    rwa [Pi.mulSingle_one, mul_one] at h
  have hconj : ∀ g, (MulAut.conj Y⁻¹).toMonoidHom (Y * g * Y⁻¹) = g := fun g => by
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    group
  constructor
  · intro e he
    obtain ⟨x, hx⟩ : ∃ x, x = Y * φ e * Y⁻¹ := ⟨_, rfl⟩
    have hxSB : x ∈ thirdTorus Ω ⊔ blockGroup Ω := hx ▸ hall e he
    have hx3 : x ^ 3 = 1 := by
      rw [hx, conj_pow, ← map_pow, hE.2 e he, map_one, mul_one, mul_inv_cancel]
    have hφe : φ e = Y⁻¹ * x * Y := by
      rw [hx]
      group
    have hsx : s * x * s⁻¹ = x := by
      rw [commute_of_mem_thirdTorus hs hxSB, mul_inv_cancel_right]
    have key : φ (w * e * w⁻¹ * e⁻¹) =
        Y⁻¹ * (thirdWeyl Ω * x * (thirdWeyl Ω)⁻¹ * x⁻¹) * Y := by
      rw [map_mul, map_mul, map_mul, map_inv, map_inv, hw, hφe]
      calc Y⁻¹ * (thirdWeyl Ω * s) * Y * (Y⁻¹ * x * Y) * (Y⁻¹ * (thirdWeyl Ω * s) * Y)⁻¹ *
            (Y⁻¹ * x * Y)⁻¹ = Y⁻¹ * (thirdWeyl Ω * (s * x * s⁻¹) * (thirdWeyl Ω)⁻¹ * x⁻¹) * Y := by
            group
        _ = Y⁻¹ * (thirdWeyl Ω * x * (thirdWeyl Ω)⁻¹ * x⁻¹) * Y := by rw [hsx]
    have hmap : (Subgroup.closure ({rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω),
        rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω * Pi.mulSingle 3 (ω ^ 2))} :
          Set (ModGL Tag.E6 Ω))).map (MulAut.conj Y⁻¹).toMonoidHom =
        (Subgroup.closure ({h₀, u} : Set ↥(twistedE6RootGroup K σ))).map φ := by
      rw [MonoidHom.map_closure, MonoidHom.map_closure, Set.image_pair, Set.image_pair, ← hYh₀,
        ← hYu, hconj, hconj]
    have hmem : φ (w * e * w⁻¹ * e⁻¹) ∈
        (Subgroup.closure ({h₀, u} : Set ↥(twistedE6RootGroup K σ))).map φ := by
      rw [← hmap, key]
      exact ⟨_, commutator_thirdWeyl_mem_closure hω hxSB hx3,
        by rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv]⟩
    exact (Subgroup.mem_map_iff_mem hφ).1 hmem
  · intro h
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 h
    have hφh₀ : φ h₀ = Y⁻¹ * rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) * Y := by
      rw [← hYh₀]
      group
    have h1 := congrArg φ hk
    rw [map_zpow, map_mul, map_mul, map_inv, hw, hφh₀] at h1
    have e1 : (Y⁻¹ * rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) * Y) ^ k =
        Y⁻¹ * rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) ^ k * Y := by
      have h2 := conj_zpow (a := Y⁻¹) (b := rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω)) (i := k)
      rwa [inv_inv] at h2
    rw [e1] at h1
    have hsd : s * rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) * s⁻¹ =
        rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) := by
      rw [commute_of_mem_thirdTorus hs (Subgroup.mem_sup_left hxS), mul_inv_cancel_right]
    refine thirdWeyl_conj_not_mem_zpowers hω (Subgroup.mem_zpowers_iff.2 ⟨k, ?_⟩)
    calc rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) ^ k =
          Y * (Y⁻¹ * rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) ^ k * Y) * Y⁻¹ := by group
      _ = Y * (Y⁻¹ * (thirdWeyl Ω * s) * Y * (Y⁻¹ * rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) * Y) *
          (Y⁻¹ * (thirdWeyl Ω * s) * Y)⁻¹) * Y⁻¹ := by rw [h1]
      _ = thirdWeyl Ω * (s * rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) * s⁻¹) * (thirdWeyl Ω)⁻¹ := by
          group
      _ = thirdWeyl Ω * rootDiagUnit Tag.E6 (Pi.mulSingle 1 ω) * (thirdWeyl Ω)⁻¹ := by rw [hsd]

theorem exists_transvection_of_a5t1
    {n d : ℕ} (hd : 1 ≤ d) (hnd : n = 3 * d) (h3 : 3 ∣ 2 ^ d + 1)
    {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ n) ^ 2) (σ : K ≃+* K)
    (hσ : ∀ c, σ c = c ^ 2 ^ n) {δ : K ≃+* K} (hδ : orderOf δ = 3)
    {E : Subgroup ↥(twistedE6RootGroup K σ)} (hE : IsElemAbelian 3 E)
    (hcard : Nat.card E = 3 ^ 4)
    (hEδ : ∀ e ∈ E, fieldActor (t := TwistTag.E6) σ δ e = e)
