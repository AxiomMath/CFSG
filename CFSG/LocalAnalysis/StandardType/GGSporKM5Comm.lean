@[expose] noncomputable def qFiveB (i : Fin 6) : Gmat := fiveGenG ⟨i.val + 2, by omega⟩

@[expose] def mFiveB : Matrix (Fin 6) (Fin 6) (ZMod 5) :=
  !![0, 3, 0, 0, 0, 0; 2, 0, 4, 0, 2, 2; 0, 1, 0, 0, 1, 2; 0, 0, 0, 0, 0, 3; 0, 3, 4, 0, 0, 0;
    0, 3, 3, 2, 0, 0]

private theorem fiveB_prodAsc_zero {G : Type*} [Group G] (g : Fin 9 → G) :
    prodAsc g (Array.replicate 9 0) = 1 := by
  simp only [prodAsc]
  norm_num [List.range_succ]

private theorem fiveB_prodAsc_e8 {G : Type*} [Group G] (g : Fin 9 → G) :
    prodAsc g ((Array.replicate 9 0).set! 8 1) = g 8 := by
  simp only [prodAsc]
  norm_num [List.range_succ]

private theorem fiveB_prodAsc_set_e8 {G : Type*} [Group G] (g : Fin 9 → G) (k : Fin 8)
    (c : ℕ) : prodAsc g (((Array.replicate 9 0).set! k.val 1).set! 8 c) =
      g ⟨k.val, by omega⟩ * g 8 ^ c := by
  simp only [prodAsc]
  fin_cases k <;> norm_num [List.range_succ]

private theorem fiveB_pw_zero : ∀ j : Fin 9, 2 ≤ j.val → pw[j.val]! = Array.replicate 9 0 := by
  decide +kernel

private theorem fiveB_cw_e8 : ∀ i : Fin 6,
    cw[(⟨i.val + 2, by omega⟩ : Fin 9).val * 9 + (8 : Fin 9).val]! =
      (Array.replicate 9 0).set! 8 1 := by
  decide +kernel

private theorem fiveB_cw_ej8 : ∀ i j : Fin 6, i < j →
    cw[(i.val + 2) * 9 + (j.val + 2)]! =
      ((Array.replicate 9 0).set! (j.val + 2) 1).set! 8 (mFiveB i j).val := by
  decide +kernel

private theorem fiveB_det : mFiveB.det = 1 := by decide +kernel

private theorem fiveB_antisym : ∀ i j : Fin 6, mFiveB i j + mFiveB j i = 0 := by decide +kernel

private theorem fiveB_self_val : ∀ i : Fin 6, (mFiveB i i).val = 0 := by decide +kernel

private theorem fiveB_bcomm_eq_pow_of_conj {G : Type*} [Group G] (a b x : G) (c : ℕ)
    (h : a * b * a⁻¹ = b * x ^ c) (hax : a * x = x * a) : bcomm a b = x ^ c := by
  have h' : a * b = b * x ^ c * a := by rw [← h]; group
  have hc : a * x ^ c = x ^ c * a := (show Commute a x from hax).pow_right c
  simp only [bcomm]
  calc a⁻¹ * b⁻¹ * a * b = a⁻¹ * b⁻¹ * (a * b) := by group
    _ = a⁻¹ * b⁻¹ * (b * x ^ c * a) := by rw [h']
    _ = a⁻¹ * (x ^ c * a) := by group
    _ = a⁻¹ * (a * x ^ c) := by rw [hc]
    _ = x ^ c := by group

private theorem fiveB_inv_pow_eq_pow_of_val_add {G : Type*} [Group G] {x : G} (hx : x ^ 5 = 1)
    {a b : ZMod 5} (h : a + b = 0) : (x ^ b.val)⁻¹ = x ^ a.val := by
  have hsum : x ^ a.val * x ^ b.val = 1 := by
    rw [← pow_add]
    have hmod : (a.val + b.val) % 5 = 0 := by
      have hh := congrArg ZMod.val h
      rw [ZMod.val_zero, ZMod.val_add] at hh
      exact hh
    have ha : a.val < 5 := ZMod.val_lt a
    have hb : b.val < 5 := ZMod.val_lt b
    have : a.val + b.val = 0 ∨ a.val + b.val = 5 := by omega
    rcases this with h0 | h5
    · rw [h0, pow_zero]
    · rw [h5, hx]
  exact inv_eq_of_mul_eq_one_left hsum

private theorem fiveB_x_pow_five
    (hpow : ∀ i : Fin 9, fiveGenG i ^ 5 = prodAsc fiveGenG pw[i.val]!) : xFiveB ^ 5 = 1 := by
  have h := hpow 8
  rw [fiveB_pw_zero 8 (by omega), fiveB_prodAsc_zero fiveGenG] at h
  simpa [xFiveB] using h

private theorem fiveB_pow_q
    (hpow : ∀ i : Fin 9, fiveGenG i ^ 5 = prodAsc fiveGenG pw[i.val]!) (i : Fin 6) :
    qFiveB i ^ 5 = 1 := by
  have h2 : 2 ≤ (⟨i.val + 2, by omega⟩ : Fin 9).val := by
    change 2 ≤ i.val + 2
    omega
  have h := hpow ⟨i.val + 2, by omega⟩
  rw [fiveB_pw_zero ⟨i.val + 2, by omega⟩ h2, fiveB_prodAsc_zero fiveGenG] at h
  simpa [qFiveB] using h

private theorem fiveB_comm_of_conj_self {G : Type*} [Group G] {a x : G} (h : a * x * a⁻¹ = x) :
    a * x = x * a := by
  calc a * x = (a * x * a⁻¹) * a := by group
    _ = x * a := by rw [h]

private theorem fiveB_comm_z
    (hcomm : ∀ i j : Fin 9, i < j →
      fiveGenG i * fiveGenG j * (fiveGenG i)⁻¹ = prodAsc fiveGenG cw[i.val * 9 + j.val]!)
    (i : Fin 6) : qFiveB i * xFiveB = xFiveB * qFiveB i := by
  have hij : (⟨i.val + 2, by omega⟩ : Fin 9) < (8 : Fin 9) := by
    change i.val + 2 < 8
    omega
  have h := hcomm ⟨i.val + 2, by omega⟩ (8 : Fin 9) hij
  rw [fiveB_cw_e8 i, fiveB_prodAsc_e8 fiveGenG] at h
  simp only [qFiveB, xFiveB] at h ⊢
  exact fiveB_comm_of_conj_self h

private theorem fiveB_conj_lt
    (hcomm : ∀ i j : Fin 9, i < j →
      fiveGenG i * fiveGenG j * (fiveGenG i)⁻¹ = prodAsc fiveGenG cw[i.val * 9 + j.val]!)
    (i j : Fin 6) (hij : i < j) :
    qFiveB i * qFiveB j * (qFiveB i)⁻¹ = qFiveB j * xFiveB ^ (mFiveB i j).val := by
  have hij' : (⟨i.val + 2, by omega⟩ : Fin 9) < ⟨j.val + 2, by omega⟩ := by
    change i.val + 2 < j.val + 2
    omega
  have h := hcomm ⟨i.val + 2, by omega⟩ ⟨j.val + 2, by omega⟩ hij'
  rw [fiveB_cw_ej8 i j hij, fiveB_prodAsc_set_e8 fiveGenG ⟨j.val + 2, by omega⟩
    (mFiveB i j).val] at h
  simpa [qFiveB, xFiveB] using h

private theorem fiveB_bcomm_all
    (hpow : ∀ i : Fin 9, fiveGenG i ^ 5 = prodAsc fiveGenG pw[i.val]!)
    (hcomm : ∀ i j : Fin 9, i < j →
      fiveGenG i * fiveGenG j * (fiveGenG i)⁻¹ = prodAsc fiveGenG cw[i.val * 9 + j.val]!) :
    ∀ i j : Fin 6, bcomm (qFiveB i) (qFiveB j) = xFiveB ^ (mFiveB i j).val := by
  have hx5 := fiveB_x_pow_five hpow
  intro i j
  rcases lt_trichotomy i j with hij | heq | hji
  · exact fiveB_bcomm_eq_pow_of_conj _ _ _ _ (fiveB_conj_lt hcomm i j hij)
      (fiveB_comm_z hcomm i)
  · subst heq
    rw [fiveB_self_val i, pow_zero]
    exact bcomm_eq_one_iff.2 rfl
  · have hb := fiveB_bcomm_eq_pow_of_conj _ _ _ _
      (fiveB_conj_lt hcomm j i hji) (fiveB_comm_z hcomm j)
    rw [bcomm_swap (qFiveB j) (qFiveB i), hb]
    exact fiveB_inv_pow_eq_pow_of_val_add hx5 (fiveB_antisym i j)

private theorem fiveB_commData_of_rels
    (hpow : ∀ i : Fin 9, fiveGenG i ^ 5 = prodAsc fiveGenG pw[i.val]!)
    (hcomm : ∀ i j : Fin 9, i < j →
      fiveGenG i * fiveGenG j * (fiveGenG i)⁻¹ = prodAsc fiveGenG cw[i.val * 9 + j.val]!)
    (hz : fiveGenG 8 ≠ 1) : CommData 5 qFiveB xFiveB mFiveB where
  pow_q i := fiveB_pow_q hpow i
  orderOf_z := by
    have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
    exact orderOf_eq_prime (fiveB_x_pow_five hpow) (by simpa [xFiveB] using hz)
  comm_z i := fiveB_comm_z hcomm i
  bcomm_q i j := fiveB_bcomm_all hpow hcomm i j
  isUnit_det := by rw [fiveB_det]; exact isUnit_one
  mem_z := by
    have hx : bcomm (qFiveB 2) (qFiveB 1) = xFiveB := by
      have h := fiveB_bcomm_all hpow hcomm 2 1
      have h21 : (mFiveB 2 1).val = 1 := by decide +kernel
      rwa [h21, pow_one] at h
    have ha : qFiveB 2 ∈ Subgroup.closure (Set.range qFiveB) :=
      Subgroup.subset_closure ⟨2, rfl⟩
    have hb : qFiveB 1 ∈ Subgroup.closure (Set.range qFiveB) :=
      Subgroup.subset_closure ⟨1, rfl⟩
    rw [← hx]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _
      (Subgroup.inv_mem _ ha) (Subgroup.inv_mem _ hb)) ha) hb

theorem fiveCommData :
    CommData 5 qFiveB xFiveB mFiveB := by
  obtain ⟨-, -, -, hpow, hcomm, hz⟩ := gmat_five_setup
  exact fiveB_commData_of_rels hpow hcomm hz

theorem five_bcomm_z :
    bcomm (qFiveB 2) (qFiveB 1) = xFiveB := by
  obtain ⟨-, -, -, hpow, hcomm, -⟩ := gmat_five_setup
  have h := fiveB_bcomm_all hpow hcomm 2 1
  have h21 : (mFiveB 2 1).val = 1 := by decide +kernel
  rwa [h21, pow_one] at h

