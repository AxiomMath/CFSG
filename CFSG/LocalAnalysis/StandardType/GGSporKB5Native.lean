private theorem gkb5_mem_normalizer_zpowers {G : Type*} [Group G] [Finite G] {g z : G}
    (h : g * z * g⁻¹ ∈ Subgroup.zpowers z) :
    g ∈ Subgroup.normalizer (Subgroup.zpowers z : Set G) := by
  refine Subgroup.mem_normalizer_fintype fun m hm => ?_
  obtain ⟨e, rfl⟩ := Subgroup.mem_zpowers_iff.1 hm
  have : g * z ^ e * g⁻¹ = (g * z * g⁻¹) ^ e := (conj_zpow).symm
  rw [this]
  exact Subgroup.zpow_mem _ h e

private theorem gkb5_comm_normalizer {G : Type*} [Group G] [Finite G] {g z : G}
    (h : g * z = z * g) : g ∈ Subgroup.normalizer (Subgroup.zpowers z : Set G) :=
  gkb5_mem_normalizer_zpowers (by rw [mul_inv_eq_iff_eq_mul.2 h]; exact Subgroup.mem_zpowers z)

private theorem gkb5_h_zpowers
    : hFive⁻¹ * zFive * hFive ∈ Subgroup.zpowers zFive := by
  have e : hFive⁻¹ * zFive * hFive =
      bcomm (hFive⁻¹ * qFive 0 * hFive) (hFive⁻¹ * qFive 1 * hFive) := by
    unfold zFive bcomm
    group
  rw [e]
  exact commData_five.bcomm_mem (gkb5_h_conj_mem 0) (gkb5_h_conj_mem 1)

private theorem gkb5_F1F4_z
    (hno : ∀ C : Subgroup NativeSporadic.B,
      ¬ LargeEvenPComponent 5 (Subgroup.centralizer ({zFive} : Set NativeSporadic.B)) C) :
    BMPCentralF1At 5 zFive ∧ BMPCentralF4At 5 zFive := by
  haveI : Finite NativeSporadic.B := CFSG.Monster.B.Pinned.finite_B
  haveI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have hD := commData_five
  set L : Subgroup NativeSporadic.B := Subgroup.closure (Set.range qFive ∪ {xFive, hFive}) with hL
  have hxL : xFive ∈ L := Subgroup.subset_closure (Or.inr (Or.inl rfl))
  have hhL : hFive ∈ L := Subgroup.subset_closure (Or.inr (Or.inr rfl))
  have hQL : QFive ≤ L := Subgroup.closure_mono Set.subset_union_left
  have hLN : L ≤ Subgroup.normalizer (QFive : Set NativeSporadic.B) := by
    rw [hL, Subgroup.closure_le]
    rintro g (⟨i, rfl⟩ | rfl | rfl)
    · exact Subgroup.le_normalizer (qFive_mem i)
    · exact mem_normalizer_of_conj xFive_conj_mem
    · exact mem_normalizer_of_conj gkb5_hQ
  have hLz' : L ≤ Subgroup.normalizer (Subgroup.zpowers zFive : Set NativeSporadic.B) := by
    rw [hL, Subgroup.closure_le]
    rintro g (⟨i, rfl⟩ | rfl | rfl)
    · exact gkb5_comm_normalizer (comm_qFive_zFive i)
    · exact gkb5_comm_normalizer xFive_mul_zFive
    · have h1 : hFive⁻¹ ∈ Subgroup.normalizer (Subgroup.zpowers zFive : Set NativeSporadic.B) :=
        gkb5_mem_normalizer_zpowers (by simpa using gkb5_h_zpowers)
      simpa using inv_mem h1
  have hLz : ∀ l ∈ L, l * zFive * l⁻¹ ∈ Subgroup.zpowers zFive := fun l hl =>
    (Subgroup.mem_normalizer_iff.1 (hLz' hl) zFive).1 (Subgroup.mem_zpowers zFive)
  have hP6 : Nat.card PFive = 5 ^ 6 :=
    pinned_B_five_power_six_subgroup.2.2.2.2.2.2.2.2.1
  have hfac : (Nat.card NativeSporadic.B).factorization 5 = 6 :=
    CFSG.RankThree.Native.factorization_card_B_five
  have hScard : Nat.card PFive = 5 ^ (Nat.card NativeSporadic.B).factorization 5 := by
    rw [hP6, hfac]
  have hQS : QFive ≤ PFive := le_sup_left
  have hSL : PFive ≤ L := sup_le hQL (Subgroup.zpowers_le.2 hxL)
  have hxN : ∀ i, xFive⁻¹ * qFive i * xFive ∈ QFive := fun i => xFive_conj_mem _ (qFive_mem i)
  have hCS : PFive ⊓ Subgroup.centralizer (QFive : Set NativeSporadic.B) =
      Subgroup.zpowers zFive := by
    have hx : CommData.actMat 5 qFive zFive MFive xFive ≠ 1 := by
      rw [gkb5_actMat_x]; exact b5MatX_ne_one
