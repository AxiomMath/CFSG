private theorem gkb5_hconj :
    ∀ i : Fin 4, hFive⁻¹ * qFive i * hFive =
      (List.ofFn fun j => qFive j ^ (tcHR.getD i []).getD j 0).prod * zFive ^ tcHC.getD i 0 :=
  Certificates.certificate9726.1

private def b5MatX : Matrix (Fin 4) (Fin 4) (ZMod 5) :=
  !![0, 0, 1, 0; 0, 0, 0, 1; 2, 2, 4, 2; 1, 4, 4, 0]

private def b5MatH : Matrix (Fin 4) (Fin 4) (ZMod 5) :=
  !![0, 1, 0, 0; 3, 1, 1, 0; 2, 2, 2, 0; 1, 1, 1, 4]

private def b5MatA : Matrix (Fin 4) (Fin 4) (ZMod 5) :=
  !![2, 2, 4, 3; 1, 2, 4, 2; 1, 0, 0, 0; 0, 1, 0, 0]

private def b5MatB : Matrix (Fin 4) (Fin 4) (ZMod 5) :=
  !![4, 2, 2, 0; 0, 0, 1, 0; 0, 1, 0, 0; 1, 1, 2, 1]

private theorem b5MatX_pow : b5MatX ^ 4 = b5MatA := by decide +kernel

private theorem b5MatH_pow : b5MatH ^ 4 = b5MatB := by decide +kernel

private theorem b5MatX_ne_one : b5MatX ≠ 1 := by decide +kernel

private theorem gkb5_actMat_pow {G : Type} [Group G] {p n : ℕ} [NeZero p] {q : Fin n → G}
    {z : G} {M : Matrix (Fin n) (Fin n) (ZMod p)} (hD : CommData p q z M) {x : G}
    (hx : ∀ i, x⁻¹ * q i * x ∈ Subgroup.closure (Set.range q)) (k : ℕ) :
    CommData.actMat p q z M (x ^ k) = CommData.actMat p q z M x ^ k := by
  induction k with
  | zero => rw [pow_zero, hD.actMat_one, pow_zero]
  | succ k ih =>
    have hconj : ∀ i, (x ^ k)⁻¹ * q i * x ^ k ∈ Subgroup.closure (Set.range q) :=
      fun i => conj_pow_mem (fun g hg => CommData.conj_mem hx hg) k
        (Subgroup.subset_closure ⟨i, rfl⟩)
    rw [pow_succ, hD.actMat_mul hconj hx, ih, pow_succ]

private theorem b5_irred (W : Submodule (ZMod 5) (Fin 4 → ZMod 5))
    (hA : ∀ v ∈ W, v ᵥ* b5MatA ∈ W) (hB : ∀ v ∈ W, v ᵥ* b5MatB ∈ W) : W = ⊥ ∨ W = ⊤ := by
  rcases eq_or_ne W ⊥ with h | h
  · exact Or.inl h
  · right
    obtain ⟨w, hw, hw0⟩ := (Submodule.ne_bot_iff W).1 h
    have hnil : (b5MatA - 1) ^ 4 = 0 := by decide +kernel
    obtain ⟨u, huW, hu0, huA⟩ := exists_fixed_of_nilpotent b5MatA hnil W hA hw hw0
    have hfix4 : ∀ a b c d : ZMod 5, ![a, b, c, d] ᵥ* b5MatA = ![a, b, c, d] →
        ∃ t : ZMod 5, ![a, b, c, d] = t • ![1, 0, 4, 3] := by
      decide +kernel
    have hfix : ∀ u : Fin 4 → ZMod 5, u ᵥ* b5MatA = u → ∃ t : ZMod 5, u = t • ![1, 0, 4, 3] := by
      intro u hu
      have e : u = ![u 0, u 1, u 2, u 3] := by
        funext i; fin_cases i <;> rfl
      rw [e] at hu ⊢
      exact hfix4 _ _ _ _ hu
    obtain ⟨c, hc⟩ := hfix u huA
    have hc0 : c ≠ 0 := by
      rintro rfl
      exact hu0 (by simpa using hc)
    have hv0 : (![1, 0, 4, 3] : Fin 4 → ZMod 5) ∈ W := by
      have hinv : ∀ c : ZMod 5, c ≠ 0 → ∃ d : ZMod 5, d * c = 1 := by decide
      obtain ⟨d, hd⟩ := hinv c hc0
      have : (![1, 0, 4, 3] : Fin 4 → ZMod 5) = d • u := by
        rw [hc, smul_smul, hd, one_smul]
      rw [this]
      exact W.smul_mem _ huW
    have h1 := hB _ hv0
    have h2 := hA _ h1
    have h3 := hB _ h2
    refine eq_top_of_spin_rows W
      ![![1, 0, 4, 3], ![1, 0, 4, 3] ᵥ* b5MatB, (![1, 0, 4, 3] ᵥ* b5MatB) ᵥ* b5MatA,
        ((![1, 0, 4, 3] ᵥ* b5MatB) ᵥ* b5MatA) ᵥ* b5MatB]
      (fun i => by fin_cases i <;> assumption)
      !![3, 0, 2, 2; 0, 4, 2, 0; 4, 0, 0, 2; 4, 0, 1, 0] (by decide +kernel)

private theorem gkb5_h_conj_mem
    : ∀ i : Fin 4, hFive⁻¹ * qFive i * hFive ∈ QFive := by
  intro i
  rw [gkb5_hconj i]
  refine mul_mem (Subgroup.list_prod_mem _ fun g hg => ?_) (pow_mem zFive_mem _)
  obtain ⟨j, rfl⟩ := List.mem_ofFn.1 hg
  exact pow_mem (qFive_mem j) _

private theorem gkb5_hQ
    : ∀ g ∈ QFive, hFive⁻¹ * g * hFive ∈ QFive := fun g hg =>
  CommData.conj_mem gkb5_h_conj_mem hg

