theorem conjNormal_bijective {G : Type*} [Group G] [Finite G] (P : Subgroup G) [P.Normal]
    (hZ : Subgroup.center P = ⊥) (hO : Nat.card (Outer P) = 3) (hidx : P.index = 3)
    {φ : G} (hφ : (MulAut.conjNormal φ : MulAut P) ∉ inner P) :
    Function.Bijective (MulAut.conjNormal : G →* MulAut P) := by
  classical
  set κ := (MulAut.conjNormal : G →* MulAut P).ker with hκ
  have hinner : ∀ z (hz : z ∈ P), (MulAut.conjNormal z : MulAut P) = MulAut.conj (⟨z, hz⟩ : P) := by
    intro z hz
    ext x
    simp [MulAut.conjNormal_apply]
  have hκP : κ ⊓ P = ⊥ := by
    rw [eq_bot_iff]
    rintro x ⟨hxκ, hxP⟩
    have h1 : (MulAut.conjNormal x : MulAut P) = 1 := hxκ
    have hcen : (⟨x, hxP⟩ : P) ∈ Subgroup.center P := by
      rw [Subgroup.mem_center_iff]
      intro y
      have := congrArg (fun α : MulAut P => (α y : P)) h1
      simp only [MulAut.one_apply] at this
      have h2 : ((MulAut.conjNormal x y : P) : G) = (y : G) := congrArg Subtype.val this
      rw [MulAut.conjNormal_apply] at h2
      apply Subtype.ext
      simp only [Subgroup.coe_mul]
      calc (y : G) * x = x * y * x⁻¹ * x := by rw [h2]
        _ = x * y := by group
    rw [hZ, Subgroup.mem_bot] at hcen
    exact Subgroup.mem_bot.mpr (congrArg Subtype.val hcen)
  have hκbot : κ = ⊥ := by
    by_contra hne
    have hle : P ≤ κ ⊔ P := le_sup_right
    have hdvd : (κ ⊔ P).index ∣ 3 := hidx ▸ Subgroup.index_dvd_of_le hle
    have htop : κ ⊔ P = ⊤ := by
      rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
      · exact Subgroup.index_eq_one.mp h1
      · exfalso
        have heq : κ ⊔ P = P := by
          refine (Subgroup.eq_of_le_of_card_ge hle ?_).symm
          have e1 := Subgroup.card_mul_index (κ ⊔ P)
          have e2 := Subgroup.card_mul_index P
          rw [h3] at e1
          rw [hidx] at e2
          omega
        apply hne
        rw [eq_bot_iff, ← hκP]
        intro x hx
        exact ⟨hx, heq ▸ Subgroup.mem_sup_left hx⟩
    have hφmem : φ ∈ κ ⊔ P := htop ▸ Subgroup.mem_top φ
    have hφset : φ ∈ (κ : Set G) * (P : Set G) := by
      rw [← Subgroup.mul_normal κ P]
      exact hφmem
    obtain ⟨y, hy, z, hz, hyz⟩ := Set.mem_mul.mp hφset
    apply hφ
    rw [← hyz, map_mul, show (MulAut.conjNormal y : MulAut P) = 1 from hy, one_mul, hinner z hz]
    exact ⟨_, rfl⟩
  have hinj : Function.Injective (MulAut.conjNormal : G →* MulAut P) :=
    (MonoidHom.ker_eq_bot_iff _).mp hκbot
  have : Finite (MulAut P) :=
    Finite.of_injective (fun α : MulAut P => (α : P → P)) DFunLike.coe_injective
  have hconjinj : Function.Injective (MulAut.conj : P →* MulAut P) := by
    intro x y hxy
    have hz : x⁻¹ * y ∈ Subgroup.center P := by
      rw [Subgroup.mem_center_iff]
      intro g
      have h1 := congrArg (fun α : MulAut P => α g) hxy
      simp only [MulAut.conj_apply] at h1
      calc g * (x⁻¹ * y) = x⁻¹ * (x * g * x⁻¹) * y := by group
        _ = x⁻¹ * (y * g * y⁻¹) * y := by rw [h1]
        _ = x⁻¹ * y * g := by group
    rw [hZ, Subgroup.mem_bot, inv_mul_eq_one] at hz
    exact hz
  have hcardInner : Nat.card (inner P) = Nat.card P :=
    Nat.card_congr (MonoidHom.ofInjective hconjinj).toEquiv.symm
  have hcardAut : Nat.card (MulAut P) = Nat.card P * 3 := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (inner P), hcardInner, mul_comm]
    change Nat.card P * Nat.card (Outer P) = _
    rw [hO]
  have hcardG : Nat.card G = Nat.card P * 3 := by
    rw [← Subgroup.card_mul_index P, hidx]
  exact hinj.bijective_of_nat_card_le (by rw [hcardAut, hcardG])

theorem nonempty_triD4Two_equiv_d4P
    {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ 1) ^ 3) :
    Nonempty (GGTriD4R 1 K ≃* d4P) := by
  have : CharP K 2 := charP_two_of_card (m := 1 * 3) (by rw [hK, pow_mul])
  set σ := iterateFrobeniusEquiv K 2 1 with hσdef
  have hσ : ∀ c, σ c = c ^ 2 ^ 1 := fun c => by
    rw [hσdef, iterateFrobeniusEquiv_apply, iterateFrobenius_def]
  obtain ⟨e1⟩ := TableBExcSmallRest.nonempty_triD4_equiv le_rfl K hK σ hσ
  let q : TauCeti.PrimePower := ⟨2, 1, Nat.prime_two, by norm_num⟩
  have hv : (TauCeti.LieTypeIndex.trialityD4 q).Valid := by simp
  obtain ⟨K', _, _, σ', hK', hσ', -, ⟨e2⟩⟩ :=
    CFSG.HardMathSupport.Timmesfeld.CrossChar.exists_catEquiv_trialityD4 q hv
  obtain ⟨e3⟩ := CFSG.HardMathSupport.Malle.SeitzCube.graphFixedRootGroup_equiv_of_card
    (ℓ := 2) (d := 1) Nat.prime_two le_rfl (σ := σ.toRingHom) (σ' := σ'.toRingHom) hK hK' hσ hσ'
  obtain ⟨e4, hcard⟩ :=
    CFSG.HardMathSupport.Seitz.TrialityEven.exists_equiv_trialityGroup8 (q := q) rfl rfl hv
  obtain ⟨e5⟩ := CFSG.HardMathSupport.Dickson.Bal207.Fam3D42.nonempty_mulEquiv_d4P
    (e1.trans (e3.trans (e2.symm.trans e4))) hcard
  exact ⟨e5⟩

theorem card_outer_lineGroup :
    Nat.card (Outer lineGroup) = 3 := by
  let q : TauCeti.PrimePower := ⟨2, 1, Nat.prime_two, by norm_num⟩
  have hv : (TauCeti.LieTypeIndex.trialityD4 q).Valid := by simp
  obtain ⟨e4, -⟩ :=
    CFSG.HardMathSupport.Seitz.TrialityEven.exists_equiv_trialityGroup8 (q := q) rfl rfl hv
  obtain ⟨hmod, -⟩ := CFSG.AGLEmbedding.ChevOuter.exists_model_equiv ⟨_, hv⟩ q rfl rfl rfl
    ((MulEquiv.subgroupCongr lineGroup_eq).trans e4.symm)
  exact CFSG.RankThree.PartTwo.Sec4.Item434SmallTwoIII.card_outer_d42 hmod

noncomputable def lineGroupEquivD4P :
    lineGroup ≃* d4P :=
  (MonoidHom.ofInjective (d4Rho_injective card_lineGroup)).trans
    (MulEquiv.subgroupCongr d4Rho_range)

theorem d4G_conjNormal_bijective
    (hZ : Subgroup.center d4P = ⊥) :
    haveI := d4P_normal_d4G
    Function.Bijective (MulAut.conjNormal : d4G →* MulAut (d4P.subgroupOf d4G)) := by
  have := d4P_normal_d4G
  have hle : d4P ≤ d4G := le_sup_right
  let e₁ : d4P.subgroupOf d4G ≃* d4P := Subgroup.subgroupOfEquivOfLe hle
  have hZ' : Subgroup.center (d4P.subgroupOf d4G) = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    have hx' : e₁ x ∈ Subgroup.center d4P := by
      rw [Subgroup.mem_center_iff]
      intro y
      obtain ⟨y', rfl⟩ := e₁.surjective y
      rw [← map_mul, ← map_mul, (Subgroup.mem_center_iff.mp hx y')]
    rw [hZ, Subgroup.mem_bot] at hx'
    rw [Subgroup.mem_bot]
    exact e₁.injective (by rw [hx', map_one])
  have hO : Nat.card (Outer (d4P.subgroupOf d4G)) = 3 := by
    rw [← card_outer_lineGroup]
    exact Nat.card_congr (CFSG.ComponentClassification.OuterAutomorphisms.equivalence
      (e₁.trans lineGroupEquivD4P.symm)).toEquiv
  have hφG : d4Phi ∈ d4G := Subgroup.mem_sup_left (Subgroup.mem_zpowers d4Phi)
  refine conjNormal_bijective (d4P.subgroupOf d4G) hZ' hO index_d4P_d4G
    (φ := ⟨d4Phi, hφG⟩) ?_
  rintro ⟨x, hx⟩
  apply d4Phi_not_inner
  refine ⟨((x : d4G) : Equiv.Perm (Fin 2457)), Subgroup.mem_subgroupOf.mp x.2, fun y hy => ?_⟩
  have h1 := congrArg (fun α : MulAut (d4P.subgroupOf d4G) =>
    (((α ⟨⟨y, hle hy⟩, Subgroup.mem_subgroupOf.mpr hy⟩ : d4P.subgroupOf d4G) : d4G) :
      Equiv.Perm (Fin 2457))) hx
  simp only [MulAut.conj_apply, MulAut.conjNormal_apply, Subgroup.coe_mul, Subgroup.coe_inv] at h1
  exact h1.symm

