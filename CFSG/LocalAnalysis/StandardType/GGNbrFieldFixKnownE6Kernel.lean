open CFSG.Blueprint CFSG.Blueprint.Chevalley CFSG.LieType.Chevalley
  CFSG.LocalAnalysis.ComponentInitial.FourGroupChevalley CFSG.StandardType.RecipeExcLang
  CFSG.LieType.SeitzGeneration.ExcWideThree CFSG.HardMathSupport.Timmesfeld.CrossChar

variable {K : Type} [Field K] [Finite K]

theorem inndiagConj_mem_e6Inndiag
    (w : inndiagGroup Tag.E6 K) :
    inndiagConj Tag.E6 K w ∈ e6Inndiag K := by
  obtain ⟨wv, hw⟩ := w
  obtain ⟨b, j, hj, rfl⟩ := (mem_inndiagGroup (τ := Tag.E6) (K := K)).1 hw
  refine (mem_e6Inndiag_iff _).2 ⟨rootDiagAut Tag.E6 K b ⟨j, hj⟩, b, ?_⟩
  refine MulEquiv.ext fun x => Subtype.ext ?_
  rw [coe_inndiagConj, coe_conj_mul_rootDiagAut, coe_rootDiagAut]
  simp only [Subtype.coe_mk]
  group

theorem eq_one_of_inndiagConj_fixes
    {σ : K ≃+* K} (hk : 2 < Nat.card (fixSubfield σ))
    (w : inndiagGroup Tag.E6 K)
    (hfix : ∀ x : ↥(ggFixSub (entrywiseAdjointAut Tag.E6 σ)),
      inndiagConj Tag.E6 K w (x : adjointGroup Tag.E6 K) = x) :
    inndiagConj Tag.E6 K w = 1 := by
  refine eq_one_of_mem_e6Inndiag_of_fix_subfield (fixSubfield σ) hk
    (inndiagConj_mem_e6Inndiag w) fun x hx => ?_
  exact hfix ⟨x, mem_ggFixSub_of_mem_map x hx⟩

end CFSG.StandardType.E6FieldFix

