    (hc : GGSecFiveBPermQTwoCell 3 Bs L 𝒦 n eta m K i0) :
    ∃ (y : G) (hy : y ∈ Bs), GGNbr 3 B x D J y K ∧ y ∈ D ∧
      eta ⟨y, hy⟩ i0 ≠ 1 ∧ ∀ j : Fin n, j ≠ i0 → eta ⟨y, hy⟩ j = 1 :=
  ggSecFiveBPerm_original_neighbor_axis hRt hc.2.2.1 hc.2.2.2.2.2

theorem ggSecFiveBPerm_original_J_eq_block
    {G : Type} [Group G] [Finite G] {p : ℕ} {B Bs : Subgroup G} {x : G}
    {L D J K : Subgroup G} {𝒦 : Finset (Subgroup G)} {n r f : ℕ}
    (hRt : GGSecFiveRouteCfg p B Bs x L D J 𝒦) (hK𝒦 : K ∈ 𝒦)
    {eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod p))} {i0 : Fin n}
    (hKA : (ggAutomizer K Bs).map (MulAut.congr eta).toMonoidHom = bCoordinateBlock n p i0)
    (π : Fin (r + 2) ≃ Fin n) (hπ0 : π 0 = i0)
    {σ : SL(r + 2, GaloisField 2 f) →* G}
    {χ : Multiplicative (ZMod p) →* (GaloisField 2 f)ˣ}
    (hLF : GGSecFiveBPermSpLFrame Bs L eta π σ χ) :
    J = (CFSG.RankThree.CALinearPlane.coordBlockSL (GaloisField 2 f)
      (Finset.univ.erase (0 : Fin (r + 2)))).map σ := by
  classical
  obtain ⟨y, hyBs, hny, hyD, hy0, hycoords⟩ :=
    ggSecFiveBPerm_original_neighbor_axis hRt hK𝒦 hKA
  let d : Unit → Fin (r + 2) → (GaloisField 2 f)ˣ :=
    fun _ k => χ (eta ⟨y, hyBs⟩ (π k))
  have hd0 : d () 0 ≠ 1 := by
    intro h
    apply hy0
    apply hLF.2.2.1
    simpa [d, hπ0] using h
  have hd : ∀ j : Fin (r + 2), j ≠ 0 → d () j = 1 := by
    intro j hj
    have hj' : π j ≠ i0 := fun h => hj (π.injective (h.trans hπ0.symm))
    simp [d, hycoords (π j) hj']
  have hxL : L ≤ Subgroup.centralizer ({x} : Set G) :=
    hRt.1.1.1.2.2.2.2.2.2.1.2.2.2.1.1
  have hxcomm : ∀ s : SL(r + 2, GaloisField 2 f), x * σ s = σ s * x := by
    intro s
    exact (Subgroup.mem_centralizer_singleton_iff.mp
      (hxL (hLF.2.1 ▸ ⟨s, rfl⟩))).symm
  have hcent : σ.range ⊓ Subgroup.centralizer (D : Set G) =
      σ.range ⊓ Subgroup.centralizer (Set.range (fun _ : Unit => y)) := by
    rw [Set.range_const]
    apply le_antisymm
    · exact inf_le_inf_left _ (Subgroup.centralizer_le (by simpa using hyD))
    · rintro z ⟨hz, hzy⟩
      obtain ⟨s, rfl⟩ := hz
      refine ⟨⟨s, rfl⟩, ?_⟩
      rw [hny.2.1, Subgroup.centralizer_closure]
      refine Subgroup.mem_centralizer_iff.mpr ?_
      rintro t (rfl | rfl)
      · exact hxcomm s
      · exact Subgroup.mem_centralizer_iff.mp hzy _ (by simp)
  have hJc : IsComponentOf J
      (σ.range ⊓ Subgroup.centralizer (Set.range (fun _ : Unit => y))) := by
    rw [← hcent, hLF.2.1]
    exact hRt.1.1.2.2.1.2.2.2.2.2.1
  obtain ⟨i, hJi⟩ := LinSemisimple.exists_eq_map_blockSpecialLinear_of_isComponentOf
    (m := r + 1) (ψ := σ) hLF.1 (d := d) (b := fun _ : Unit => y)
    (fun _ => LinFusion.mem_ggInducedPairs.mpr (hLF.2.2.2 ⟨y, hyBs⟩)) hJc
  have hI0 : LinSemisimple.eigClass d 0 = {0} := by
    ext j
    simp only [LinSemisimple.mem_eigClass, Finset.mem_singleton]
    constructor
    · intro h
      by_contra hj
      exact hd0 ((h ()).symm.trans (hd j hj))
    · rintro rfl
      exact fun _ => rfl
  have hi : i ≠ 0 := by
    intro hi
    rw [hi, hI0, CFSG.SeitzReduction.SymplecticPilot.blockSpecialLinear_singleton_eq_bot,
      Subgroup.map_bot] at hJi
    apply LinSemisimple.false_of_isQuasisimple_of_commute hJc.2.2
    intro a ha b hb
    simp only [hJi, Subgroup.mem_bot] at ha hb
    simp [ha, hb]
  have hIi : LinSemisimple.eigClass d i = Finset.univ.erase 0 := by
    ext j
    simp only [LinSemisimple.mem_eigClass, Finset.mem_erase, Finset.mem_univ, and_true]
    constructor
    · intro h hj
      subst j
      exact hd0 ((h ()).trans (hd i hi))
    · intro hj u
      cases u
      rw [hd j hj, hd i hi]
  rw [hIi, ← blockSpecialLinear_eq_coordBlockSL] at hJi
  exact hJi

theorem ggSecFiveBPermQTwo_original_J_eq_block
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G}
    {L D J K : Subgroup G} {𝒦 : Finset (Subgroup G)} {n m r : ℕ}
    (hRt : GGSecFiveRouteCfg 3 B Bs x L D J 𝒦)
    {eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod 3))} {i0 : Fin n}
    (hc : GGSecFiveBPermQTwoCell 3 Bs L 𝒦 n eta m K i0)
    (π : Fin (r + 2) ≃ Fin n) (hπ0 : π 0 = i0)
    {σ : SL(r + 2, GaloisField 2 2) →* G}
    {χ : Multiplicative (ZMod 3) →* (GaloisField 2 2)ˣ}
    (hLF : GGSecFiveBPermSpLFrame Bs L eta π σ χ) :
    J = (CFSG.RankThree.CALinearPlane.coordBlockSL (GaloisField 2 2)
      (Finset.univ.erase (0 : Fin (r + 2)))).map σ :=
  ggSecFiveBPerm_original_J_eq_block hRt hc.2.2.1 hc.2.2.2.2.2 π hπ0 hLF

theorem ggSecFiveBPermQTwo_original_J_le_K
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G}
    {L D J K : Subgroup G} {𝒦 : Finset (Subgroup G)} {n m : ℕ}
    (hRt : GGSecFiveRouteCfg 3 B Bs x L D J 𝒦)
    {eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod 3))} {i0 : Fin n}
    (hc : GGSecFiveBPermQTwoCell 3 Bs L 𝒦 n eta m K i0)
    (hn : 4 ≤ n) :
    J ≤ K := by
  classical
  obtain ⟨y, -, hny, -, -, -⟩ :=
    ggSecFiveBPermQTwo_original_neighbor_axis hRt hc
  obtain ⟨eK⟩ := hc.2.2.2.2.1
  have hm3 : 3 ≤ m := by
    rcases hc.2.1 with hm | hm <;> omega
  have hcenterK : Subgroup.center K = ⊥ := by
    rw [← (Subgroup.map_injective (f := eK.toMonoidHom) eK.injective).eq_iff]
    rw [Subgroup.map_bot,
      CFSG.ComponentClassification.OuterAutomorphisms.center_map_equiv eK,
      CFSG.LargeExtraspecial.DW.center_specialLinearGroup_zmod_two_eq_bot m]
  have hZ : ¬ 3 ∣ Nat.card (Subgroup.center K) := by
    rw [hcenterK, Subgroup.card_bot]
    norm_num
  have hOut : Group.IsSolvable
      (CFSG.ComponentClassification.OuterAutomorphisms.Outer K) := by
    have : Group.IsSolvable
        (CFSG.ComponentClassification.OuterAutomorphisms.Outer
          (SL(m, ZMod 2))) :=
      CFSG.Quasithin.GoldS146P.outer_sl_solvable m hm3
    exact CFSG.ComponentClassification.OuterAutomorphisms.solvable_of_equiv eK.symm
  exact CFSG.StandardType.le_of_ggNbr_of_prime_not_dvd_center_of_outer_solvable
    hRt.1.1.1 hRt.1.1.2.2 hny hZ hOut

theorem ggSecFiveBPermQTwo_original_J_sup_conj_eq_L
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G}
    {L D J K : Subgroup G} {𝒦 : Finset (Subgroup G)} {n m r : ℕ}
    (hRt : GGSecFiveRouteCfg 3 B Bs x L D J 𝒦)
    {eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod 3))} {i0 : Fin n}
    (hc : GGSecFiveBPermQTwoCell 3 Bs L 𝒦 n eta m K i0)
    (hn : 4 ≤ n)
    (π : Fin (r + 2) ≃ Fin n) (hπ0 : π 0 = i0)
    {σ : SL(r + 2, GaloisField 2 2) →* G}
    {χ : Multiplicative (ZMod 3) →* (GaloisField 2 2)ˣ}
    (hLF : GGSecFiveBPermSpLFrame Bs L eta π σ χ) :
    L = J ⊔ J.map
      (MulAut.conj (σ (TypeA.permSL (Equiv.swap (0 : Fin (r + 2)) 1)))).toMonoidHom := by
  classical
  let B0 : Subgroup (SL(r + 2, GaloisField 2 2)) :=
    CFSG.RankThree.CALinearPlane.coordBlockSL (GaloisField 2 2)
      (Finset.univ.erase (0 : Fin (r + 2)))
  let P : SL(r + 2, GaloisField 2 2) :=
    TypeA.permSL (Equiv.swap (0 : Fin (r + 2)) 1)
  let g : G := σ P
  change L = J ⊔ J.map (MulAut.conj g).toMonoidHom
  have hJ : J = B0.map σ := by
    simpa only [B0] using
      ggSecFiveBPermQTwo_original_J_eq_block hRt hc π hπ0 hLF
  have hd3 : 3 ≤ r + 2 := by
    have hcard : r + 2 = n := by
      simpa using Fintype.card_congr π
    omega
  have h01 : (0 : Fin (r + 2)) ≠ 1 := by
    intro h
    have hlt : 1 < r + 2 := by omega
    have hval := congrArg (fun x : Fin (r + 2) => (x : ℕ)) h
    rw [Fin.val_zero, Fin.val_one', Nat.mod_eq_of_lt hlt] at hval
    omega
  have hBtop : B0 ⊔ B0.map (MulAut.conj P).toMonoidHom = ⊤ := by
    simpa only [B0, P] using
      (TypeA.coordBlockSL_erase_sup_conj_eq_top (K := GaloisField 2 2)
        (hd := hd3) (i := (0 : Fin (r + 2))) (j := (1 : Fin (r + 2)))
        (hij := h01))
  have hmaps : (B0.map (MulAut.conj P).toMonoidHom).map σ =
      (B0.map σ).map (MulAut.conj g).toMonoidHom := by
    rw [Subgroup.map_map, Subgroup.map_map]
    rw [show σ.comp (MulAut.conj P).toMonoidHom =
        (MulAut.conj g).toMonoidHom.comp σ from by
      ext u
      simp [g, MulAut.conj_apply, map_mul]]
  have hmap_sup :
      (B0 ⊔ B0.map (MulAut.conj P).toMonoidHom).map σ = L := by
    rw [hBtop, Subgroup.map_top, hLF.2.1]
  calc
    L = (B0 ⊔ B0.map (MulAut.conj P).toMonoidHom).map σ := hmap_sup.symm
    _ = B0.map σ ⊔
          (B0.map (MulAut.conj P).toMonoidHom).map σ := by
        rw [Subgroup.map_sup]
    _ = J ⊔ J.map (MulAut.conj g).toMonoidHom := by
        rw [hmaps, ← hJ]

theorem ggSecFiveBPermQTwo_original_K_sup_conj_eq_sup
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G}
    {L D J K : Subgroup G} {𝒦 : Finset (Subgroup G)} {n m r : ℕ}
    (hRt : GGSecFiveRouteCfg 3 B Bs x L D J 𝒦)
    {eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod 3))} {i0 : Fin n}
    (hc : GGSecFiveBPermQTwoCell 3 Bs L 𝒦 n eta m K i0)
    (hn : 4 ≤ n)
    (π : Fin (r + 2) ≃ Fin n) (hπ0 : π 0 = i0)
    {σ : SL(r + 2, GaloisField 2 2) →* G}
    {χ : Multiplicative (ZMod 3) →* (GaloisField 2 2)ˣ}
    (hLF : GGSecFiveBPermSpLFrame Bs L eta π σ χ) :
    K ⊔ K.map
      (MulAut.conj (σ (TypeA.permSL (Equiv.swap (0 : Fin (r + 2)) 1)))).toMonoidHom =
        L ⊔ K := by
  classical
  let P : SL(r + 2, GaloisField 2 2) :=
    TypeA.permSL (Equiv.swap (0 : Fin (r + 2)) 1)
  let g : G := σ P
  change K ⊔ K.map (MulAut.conj g).toMonoidHom = L ⊔ K
  have hJK : J ≤ K := ggSecFiveBPermQTwo_original_J_le_K hRt hc hn
  have hL : L = J ⊔ J.map (MulAut.conj g).toMonoidHom := by
    simpa only [P, g] using
      ggSecFiveBPermQTwo_original_J_sup_conj_eq_L hRt hc hn π hπ0 hLF
  have hgL : g ∈ L := by
    rw [← hLF.2.1]
    exact ⟨P, rfl⟩
  have hKg_le : K.map (MulAut.conj g).toMonoidHom ≤ L ⊔ K := by
    intro z hz
    obtain ⟨k, hk, rfl⟩ := Subgroup.mem_map.mp hz
    have hg : g ∈ L ⊔ K := Subgroup.mem_sup_left hgL
    have hk' : k ∈ L ⊔ K := Subgroup.mem_sup_right hk
    have hconj : g * k * g⁻¹ ∈ L ⊔ K :=
      (L ⊔ K).mul_mem ((L ⊔ K).mul_mem hg hk') ((L ⊔ K).inv_mem hg)
    simpa [MulAut.conj_apply] using hconj
  have hL_le : L ≤ K ⊔ K.map (MulAut.conj g).toMonoidHom := by
    rw [hL]
    exact sup_le (hJK.trans le_sup_left)
      ((Subgroup.map_mono hJK).trans le_sup_right)
  have hKL : L ⊔ K ≤ K ⊔ K.map (MulAut.conj g).toMonoidHom :=
    sup_le hL_le le_sup_left
  have hLK : K ⊔ K.map (MulAut.conj g).toMonoidHom ≤ L ⊔ K :=
    sup_le le_sup_right hKg_le
  exact le_antisymm hLK hKL

theorem ggSecFiveBPermQTwo_original_placement
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G}
    {L D J K : Subgroup G} {𝒦 : Finset (Subgroup G)} {n m r : ℕ}
    (hRt : GGSecFiveRouteCfg 3 B Bs x L D J 𝒦)
    {eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod 3))} {i0 : Fin n}
    (hc : GGSecFiveBPermQTwoCell 3 Bs L 𝒦 n eta m K i0)
    (hn : 4 ≤ n)
    (π : Fin (r + 2) ≃ Fin n) (hπ0 : π 0 = i0)
    {σ : SL(r + 2, GaloisField 2 2) →* G}
    {χ : Multiplicative (ZMod 3) →* (GaloisField 2 2)ˣ}
    (hLF : GGSecFiveBPermSpLFrame Bs L eta π σ χ) :
    J = (CFSG.RankThree.CALinearPlane.coordBlockSL (GaloisField 2 2)
        (Finset.univ.erase (0 : Fin (r + 2)))).map σ ∧
      J ≤ K ∧
      L = J ⊔ J.map
        (MulAut.conj (σ (TypeA.permSL (Equiv.swap (0 : Fin (r + 2)) 1)))).toMonoidHom ∧
      K ⊔ K.map
        (MulAut.conj (σ (TypeA.permSL (Equiv.swap (0 : Fin (r + 2)) 1)))).toMonoidHom =
          L ⊔ K := by
  exact ⟨ggSecFiveBPermQTwo_original_J_eq_block hRt hc π hπ0 hLF,
    ggSecFiveBPermQTwo_original_J_le_K hRt hc hn,
    ggSecFiveBPermQTwo_original_J_sup_conj_eq_L hRt hc hn π hπ0 hLF,
    ggSecFiveBPermQTwo_original_K_sup_conj_eq_sup hRt hc hn π hπ0 hLF⟩

