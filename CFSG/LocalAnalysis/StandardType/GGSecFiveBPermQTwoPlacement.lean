    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G}
    {L D J K : Subgroup G} {𝒦 : Finset (Subgroup G)} {n m : ℕ}
    (hRt : GGSecFiveRouteCfg 3 B Bs x L D J 𝒦)
