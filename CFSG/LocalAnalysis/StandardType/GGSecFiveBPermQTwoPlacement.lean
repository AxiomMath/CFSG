theorem ggSecFiveBPerm_original_neighbor_axis
    {G : Type} [Group G] [Finite G] {p : ℕ} {B Bs : Subgroup G} {x : G}
    {L D J K : Subgroup G} {𝒦 : Finset (Subgroup G)} {n : ℕ}
    (hRt : GGSecFiveRouteCfg p B Bs x L D J 𝒦) (hK𝒦 : K ∈ 𝒦)
    {eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod p))} {i0 : Fin n}
    (hKA : (ggAutomizer K Bs).map (MulAut.congr eta).toMonoidHom = bCoordinateBlock n p i0) :
    ∃ (y : G) (hy : y ∈ Bs), GGNbr p B x D J y K ∧ y ∈ D ∧
      eta ⟨y, hy⟩ i0 ≠ 1 ∧ ∀ j : Fin n, j ≠ i0 → eta ⟨y, hy⟩ j = 1 := by
  classical
  have : Fact p.Prime := ⟨hRt.1.1.1.2.2.2.2.2.1.1⟩
  obtain ⟨y, hny⟩ := hRt.2.2.2.1.2 K hK𝒦
  obtain ⟨hyBs, hyK, hyD, hyx, -⟩ := ggNbr_facts hRt.1.1 hny
  have hcoords : ∀ j : Fin n, j ≠ i0 → eta ⟨y, hyBs⟩ j = 1 := by
    intro j hj
    exact ggSecFiveBPermSpK_eta_eq_one_of_mem_centralizer
      hRt.1.1.1.2.2.2.2.2.1.2.1 hKA hyK hj
  refine ⟨y, hyBs, hny, hyD, ?_, hcoords⟩
  intro hzero
  have heq : eta ⟨y, hyBs⟩ = 1 := by
    ext j
    by_cases hj : j = i0
    · simpa [hj] using hzero
    · exact hcoords j hj
  have hyone : y = 1 := by
    have h : (⟨y, hyBs⟩ : Bs) = 1 := eta.injective (heq.trans eta.map_one.symm)
    exact congrArg (fun b : Bs => (b : G)) h
  exact hyx (hyone ▸ Subgroup.one_mem _)

