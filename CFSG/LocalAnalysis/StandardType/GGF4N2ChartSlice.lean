theorem coe_mul_comm_of_mem_centralizer {s g : SL6}
    (hg : g ∈ Subgroup.centralizer ({s} : Set SL6)) :
    (g : Matrix (Fin 6) (Fin 6) F4) * s = s * g := by
  have h := congrArg (fun x : SL6 => (x : Matrix (Fin 6) (Fin 6) F4))
    (Subgroup.mem_centralizer_singleton_iff.mp hg)
  simpa only [Matrix.SpecialLinearGroup.coe_mul] using h

theorem mulVec_mem_suppSp {s g : SL6} (hg : g ∈ Subgroup.centralizer ({s} : Set SL6)) {v : V6}
    (hv : v ∈ suppSp s) : (g : Matrix (Fin 6) (Fin 6) F4) *ᵥ v ∈ suppSp s := by
  obtain ⟨w, rfl⟩ := hv
  refine ⟨(g : Matrix (Fin 6) (Fin 6) F4) *ᵥ w, ?_⟩
  simp only [LinearMap.sub_apply, Matrix.toLin'_apply, LinearMap.id_apply, Matrix.mulVec_sub,
    Matrix.mulVec_mulVec, coe_mul_comm_of_mem_centralizer hg]

theorem mulVec_pow_eq_smul {s : SL6} {a : V6} {c : F4}
    (hc : (s : Matrix (Fin 6) (Fin 6) F4) *ᵥ a = c • a) (k : ℕ) :
    ((s ^ k : SL6) : Matrix (Fin 6) (Fin 6) F4) *ᵥ a = c ^ k • a := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ, Matrix.SpecialLinearGroup.coe_mul, ← Matrix.mulVec_mulVec, hc,
      Matrix.mulVec_smul, ih, smul_smul, ← pow_succ']

theorem eq_zero_of_mulVec_eq_smul {s : SL6} (hs : s ^ 5 = 1)
    (hdisj : Disjoint (suppSp s) (fixSp s)) {a : V6} (ha : a ∈ suppSp s) {c : F4}
    (hc : (s : Matrix (Fin 6) (Fin 6) F4) *ᵥ a = c • a) : a = 0 := by
  by_contra ha0
  have h5 : c ^ 5 = 1 := by
    have h := mulVec_pow_eq_smul hc 5
    rw [hs, Matrix.SpecialLinearGroup.coe_one, Matrix.one_mulVec] at h
    have h' : (c ^ 5 - 1) • a = 0 := by rw [sub_smul, ← h, one_smul, sub_self]
    rcases smul_eq_zero.mp h' with h'' | h''
    · exact sub_eq_zero.mp h''
    · exact absurd h'' ha0
  have hc0 : c ≠ 0 := by
    rintro rfl
    norm_num at h5
  have hc1 : c = 1 := by
    have h3 := F4_pow_three hc0
    calc c = c * c ^ 5 := by rw [h5, mul_one]
      _ = (c ^ 3) ^ 2 := by ring
      _ = 1 := by rw [h3, one_pow]
  have hfix : a ∈ fixSp s := by
    rw [fixSp, LinearMap.mem_ker, LinearMap.sub_apply, Matrix.toLin'_apply, LinearMap.id_apply, hc, hc1, one_smul, sub_self]
  exact ha0 ((Submodule.disjoint_def.mp hdisj) a ha hfix)

theorem span_pair_eq_suppSp {s : SL6} (hs : s ^ 5 = 1)
    (h2 : Module.finrank F4 (suppSp s) = 2) (hdisj : Disjoint (suppSp s) (fixSp s)) {a : V6}
    (ha : a ∈ suppSp s) (ha0 : a ≠ 0) :
    Submodule.span F4 {a, (s : Matrix (Fin 6) (Fin 6) F4) *ᵥ a} = suppSp s := by
  have hs1 : s ∈ Subgroup.centralizer ({s} : Set SL6) :=
    Subgroup.mem_centralizer_singleton_iff.mpr rfl
  have hsa : (s : Matrix (Fin 6) (Fin 6) F4) *ᵥ a ∈ suppSp s := mulVec_mem_suppSp hs1 ha
  have hli : LinearIndependent F4 ![a, (s : Matrix (Fin 6) (Fin 6) F4) *ᵥ a] := by
    rw [LinearIndependent.pair_iff]
    intro c d hcd
    by_cases hd : d = 0
    · subst hd
      rw [zero_smul, add_zero] at hcd
      exact ⟨(smul_eq_zero.mp hcd).resolve_right ha0, rfl⟩
    · exfalso
      apply ha0
      refine eq_zero_of_mulVec_eq_smul hs hdisj ha (c := -(d⁻¹ * c)) ?_
      have h' : d • ((s : Matrix (Fin 6) (Fin 6) F4) *ᵥ a) = -(c • a) :=
        eq_neg_of_add_eq_zero_right hcd
      calc (s : Matrix (Fin 6) (Fin 6) F4) *ᵥ a
          = d⁻¹ • (d • ((s : Matrix (Fin 6) (Fin 6) F4) *ᵥ a)) := by
            rw [smul_smul, inv_mul_cancel₀ hd, one_smul]
        _ = -(d⁻¹ * c) • a := by rw [h', smul_neg, smul_smul, neg_smul]
  have hrange : Set.range ![a, (s : Matrix (Fin 6) (Fin 6) F4) *ᵥ a] =
      {a, (s : Matrix (Fin 6) (Fin 6) F4) *ᵥ a} := by
    ext x
    simp only [Set.mem_range, Fin.exists_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one,
      Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro (h | h) <;> [exact Or.inl h.symm; exact Or.inr h.symm]
    · rintro (h | h) <;> [exact Or.inl h.symm; exact Or.inr h.symm]
  apply Submodule.eq_of_le_of_finrank_eq
  · rw [Submodule.span_le]
    rintro x (rfl | rfl)
    · exact ha
    · exact hsa
  · rw [h2, ← hrange, finrank_span_eq_card hli, Fintype.card_fin]

theorem exists_mulVec_eq_on_suppSp {s : SL6} (hs : s ^ 5 = 1)
    (h2 : Module.finrank F4 (suppSp s) = 2) (hdisj : Disjoint (suppSp s) (fixSp s)) {g : SL6}
    (hg : g ∈ Subgroup.centralizer ({s} : Set SL6)) :
    ∃ α β : F4, ∀ v ∈ suppSp s, (g : Matrix (Fin 6) (Fin 6) F4) *ᵥ v =
      α • v + β • ((s : Matrix (Fin 6) (Fin 6) F4) *ᵥ v) := by
  obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot (p := suppSp s) (by
    intro h
    rw [h, finrank_bot] at h2
    norm_num at h2)
  have hspan := span_pair_eq_suppSp hs h2 hdisj ha ha0
  have hga : (g : Matrix (Fin 6) (Fin 6) F4) *ᵥ a ∈
      Submodule.span F4 {a, (s : Matrix (Fin 6) (Fin 6) F4) *ᵥ a} := by
    rw [hspan]
    exact mulVec_mem_suppSp hg ha
  obtain ⟨α, β, hαβ⟩ := Submodule.mem_span_pair.mp hga
  refine ⟨α, β, fun v hv => ?_⟩
  rw [← hspan] at hv
  obtain ⟨c, d, rfl⟩ := Submodule.mem_span_pair.mp hv
  have hgs := coe_mul_comm_of_mem_centralizer hg
  have hgsa : (g : Matrix (Fin 6) (Fin 6) F4) *ᵥ ((s : Matrix (Fin 6) (Fin 6) F4) *ᵥ a) =
      (s : Matrix (Fin 6) (Fin 6) F4) *ᵥ ((g : Matrix (Fin 6) (Fin 6) F4) *ᵥ a) := by
    rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, hgs]
  simp only [Matrix.mulVec_add, Matrix.mulVec_smul, hgsa, ← hαβ]
  module

theorem commutatorElement_mulVec_suppSp {s : SL6} (hs : s ^ 5 = 1)
    (h2 : Module.finrank F4 (suppSp s) = 2) (hdisj : Disjoint (suppSp s) (fixSp s)) {g h : SL6}
    (hg : g ∈ Subgroup.centralizer ({s} : Set SL6))
    (hh : h ∈ Subgroup.centralizer ({s} : Set SL6)) {v : V6} (hv : v ∈ suppSp s) :
    ((⁅g, h⁆ : SL6) : Matrix (Fin 6) (Fin 6) F4) *ᵥ v = v := by
  have hcomm : ∀ w ∈ suppSp s, (g : Matrix (Fin 6) (Fin 6) F4) *ᵥ
      ((h : Matrix (Fin 6) (Fin 6) F4) *ᵥ w) =
      (h : Matrix (Fin 6) (Fin 6) F4) *ᵥ ((g : Matrix (Fin 6) (Fin 6) F4) *ᵥ w) := by
    intro w hw
    obtain ⟨α, β, hgαβ⟩ := exists_mulVec_eq_on_suppSp hs h2 hdisj hg
    obtain ⟨α', β', hhαβ⟩ := exists_mulVec_eq_on_suppSp hs h2 hdisj hh
    have hs1 : s ∈ Subgroup.centralizer ({s} : Set SL6) :=
      Subgroup.mem_centralizer_singleton_iff.mpr rfl
    have hsw := mulVec_mem_suppSp hs1 hw
    have e1 : (g : Matrix (Fin 6) (Fin 6) F4) *ᵥ ((h : Matrix (Fin 6) (Fin 6) F4) *ᵥ w) =
        α' • (α • w + β • ((s : Matrix (Fin 6) (Fin 6) F4) *ᵥ w)) +
          β' • (α • ((s : Matrix (Fin 6) (Fin 6) F4) *ᵥ w) + β • ((s : Matrix (Fin 6) (Fin 6) F4) *ᵥ
            ((s : Matrix (Fin 6) (Fin 6) F4) *ᵥ w))) := by
      rw [hhαβ w hw, Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul, hgαβ w hw,
        hgαβ _ hsw]
    have e2 : (h : Matrix (Fin 6) (Fin 6) F4) *ᵥ ((g : Matrix (Fin 6) (Fin 6) F4) *ᵥ w) =
        α • (α' • w + β' • ((s : Matrix (Fin 6) (Fin 6) F4) *ᵥ w)) +
          β • (α' • ((s : Matrix (Fin 6) (Fin 6) F4) *ᵥ w) + β' • ((s : Matrix (Fin 6) (Fin 6) F4) *ᵥ
            ((s : Matrix (Fin 6) (Fin 6) F4) *ᵥ w))) := by
      rw [hgαβ w hw, Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul, hhαβ w hw,
        hhαβ _ hsw]
    rw [e1, e2]
    module
  have hginv : g⁻¹ ∈ Subgroup.centralizer ({s} : Set SL6) := Subgroup.inv_mem _ hg
  have hhinv : h⁻¹ ∈ Subgroup.centralizer ({s} : Set SL6) := Subgroup.inv_mem _ hh
  set w := ((g⁻¹ : SL6) : Matrix (Fin 6) (Fin 6) F4) *ᵥ
    (((h⁻¹ : SL6) : Matrix (Fin 6) (Fin 6) F4) *ᵥ v) with hw
  have hwA : w ∈ suppSp s := mulVec_mem_suppSp hginv (mulVec_mem_suppSp hhinv hv)
  have hv' : v = (h : Matrix (Fin 6) (Fin 6) F4) *ᵥ ((g : Matrix (Fin 6) (Fin 6) F4) *ᵥ w) := by
    rw [hw, mulVec_mulVec_inv g, mulVec_mulVec_inv h]
  rw [commutatorElement_def, Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul,
    Matrix.SpecialLinearGroup.coe_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
    ← Matrix.mulVec_mulVec, ← hw, hcomm w hwA, ← hv']

theorem eq_one_of_mem_center_of_mulVec_eq {z : SL6} (hz : z ∈ Subgroup.center SL6) {a : V6}
    (ha : a ≠ 0) (hza : (z : Matrix (Fin 6) (Fin 6) F4) *ᵥ a = a) : z = 1 := by
  obtain ⟨r, -, hrz⟩ := Matrix.SpecialLinearGroup.mem_center_iff.mp hz
  have hsm : (z : Matrix (Fin 6) (Fin 6) F4) *ᵥ a = r • a := by
    rw [← hrz]
    ext i
    simp [Matrix.scalar_apply, Matrix.mulVec_diagonal]
  have hr : r = 1 := by
    rw [hsm] at hza
    have h' : (r - 1) • a = 0 := by rw [sub_smul, hza, one_smul, sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp h').resolve_right ha)
  apply Subtype.ext
  rw [← hrz, hr, map_one, Matrix.SpecialLinearGroup.coe_one]

theorem commutator_le_self {M : Type*} [Group M] (K : Subgroup M) : ⁅K, K⁆ ≤ K := by
  rw [Subgroup.commutator_le]
  intro g hg h hh
  rw [commutatorElement_def]
  exact K.mul_mem (K.mul_mem (K.mul_mem hg hh) (K.inv_mem hg)) (K.inv_mem hh)

variable {G : Type} [Group G] {ψ : SL6 →* G}

theorem slice_lift (hψ : ψ.ker ≤ Subgroup.center SL6) {X : Subgroup G} (hX : X ≤ ψ.range)
    {s : SL6} (hs : s ^ 5 = 1) (h2 : Module.finrank F4 (suppSp s) = 2)
    (hdisj : Disjoint (suppSp s) (fixSp s)) {H : Subgroup G}
    (hH : H ≤ X ⊓ Subgroup.centralizer ({ψ s} : Set G)) (hperf : ⁅H, H⁆ = H) :
    (⁅H.comap ψ, H.comap ψ⁆).map ψ = H ∧
      (∀ t ∈ ⁅H.comap ψ, H.comap ψ⁆, ψ t = 1 → t = 1) ∧
      (∀ t ∈ ⁅H.comap ψ, H.comap ψ⁆, ∀ v ∈ suppSp s,
        (t : Matrix (Fin 6) (Fin 6) F4) *ᵥ v = v) ∧
      ⁅H.comap ψ, H.comap ψ⁆ ≤ X.comap ψ ⊓ Subgroup.centralizer ({s} : Set SL6) := by
  have hΦ : H.comap ψ ≤ X.comap ψ ⊓ Subgroup.centralizer ({s} : Set SL6) := by
    rw [← comap_inf_centralizer hψ X hs]
    exact Subgroup.comap_mono hH
  have hT : ⁅H.comap ψ, H.comap ψ⁆ ≤ X.comap ψ ⊓ Subgroup.centralizer ({s} : Set SL6) :=
    (commutator_le_self (H.comap ψ)).trans hΦ
  have hfix : ∀ t ∈ ⁅H.comap ψ, H.comap ψ⁆, ∀ v ∈ suppSp s,
      (t : Matrix (Fin 6) (Fin 6) F4) *ᵥ v = v := by
    have hle : ⁅H.comap ψ, H.comap ψ⁆ ≤ stabSub (suppSp s) ⊤ := by
      rw [Subgroup.commutator_le]
      intro g hg h hh
      exact ⟨fun v hv => commutatorElement_mulVec_suppSp hs h2 hdisj (hΦ hg).2 (hΦ hh).2 hv,
        fun _ _ => Submodule.mem_top, fun _ _ => Submodule.mem_top⟩
    exact fun t ht v hv => (hle ht).1 v hv
  refine ⟨?_, fun t ht h1 => ?_, hfix, hT⟩
  · rw [Subgroup.map_commutator, Subgroup.map_comap_eq_self
      ((hH.trans inf_le_left).trans hX), hperf]
  · obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot (p := suppSp s) (by
      intro h
      rw [h, finrank_bot] at h2
      norm_num at h2)
    exact eq_one_of_mem_center_of_mulVec_eq (hψ h1) ha0 (hfix t ht a ha)

theorem slice_lift_normal (hψ : ψ.ker ≤ Subgroup.center SL6) {X : Subgroup G} {s : SL6}
    (hs : s ^ 5 = 1) {H : Subgroup G}
    (hHn : ∀ g ∈ X ⊓ Subgroup.centralizer ({ψ s} : Set G), ∀ h ∈ H, g * h * g⁻¹ ∈ H)
    {g : SL6} (hg : g ∈ X.comap ψ ⊓ Subgroup.centralizer ({s} : Set SL6))
    {t : SL6} (ht : t ∈ ⁅H.comap ψ, H.comap ψ⁆) : g * t * g⁻¹ ∈ ⁅H.comap ψ, H.comap ψ⁆ := by
  rw [← comap_inf_centralizer hψ X hs] at hg
  have hconj : (H.comap ψ).map (MulAut.conj g).toMonoidHom ≤ H.comap ψ := by
    rintro _ ⟨x, hx, rfl⟩
    change ψ (g * x * g⁻¹) ∈ H
    rw [map_mul, map_mul, map_inv]
    exact hHn _ hg _ hx
  have hmem : g * t * g⁻¹ ∈ (⁅H.comap ψ, H.comap ψ⁆).map (MulAut.conj g).toMonoidHom :=
    ⟨t, ht, rfl⟩
  rw [Subgroup.map_commutator] at hmem
  exact Subgroup.commutator_mono hconj hconj hmem

theorem slice_lift_mulEquiv {T H : Subgroup G} {T' : Subgroup SL6} (hmap : T'.map ψ = T)
    (hinj : ∀ t ∈ T', ψ t = 1 → t = 1) (hTH : T = H) : Nonempty (T' ≃* H) := by
  have hker : (ψ.comp T'.subtype).ker = ⊥ := by
    rw [eq_bot_iff]
    intro t ht
    exact Subtype.ext (hinj t t.2 ht)
  have hrange : (ψ.comp T'.subtype).range = H := by
    rw [MonoidHom.range_comp, Subgroup.range_subtype, hmap, hTH]
  exact ⟨(MonoidHom.ofInjective ((MonoidHom.ker_eq_bot_iff _).mp hker)).trans
    (MulEquiv.subgroupCongr hrange)⟩

theorem lift_mem_slice_lift (hψ : ψ.ker ≤ Subgroup.center SL6) {T' : Subgroup SL6} {H : Subgroup G}
    (hmap : T'.map ψ = H) (hinj : ∀ t ∈ T', ψ t = 1 → t = 1) {s : SL6} (hs : s ^ 5 = 1)
    (hsH : ψ s ∈ H) : s ∈ T' := by
  rw [← hmap] at hsH
  obtain ⟨t, ht, hts⟩ := hsH
  have ht5 : t ^ 5 = 1 := hinj _ (T'.pow_mem ht 5) (by rw [map_pow, hts, ← map_pow, hs, map_one])
  rwa [lift_five_unique hψ hts ht5 hs] at ht

end CFSG.StandardType.N2Chart

