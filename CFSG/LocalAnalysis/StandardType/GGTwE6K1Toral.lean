theorem e6AdToral_of_conn_line (hS : E6LeviThreeToralBar) {K : Type} [Field K] [Finite K]
    {σ : K ≃+* K} {q : ℕ} {h : twistedE6InndiagGL K σ} (D : TwE6LineLang K σ q h)
    (hdim : twE6MatFixDim K σ h = 28 ∨ twE6MatFixDim K σ h = 46)
    {X : Subgroup (ModGL Tag.E6 (AlgebraicClosure K))} (hX : IsElemAbelian 3 X)
    (hXG : X ≤ adjointGroup Tag.E6 (AlgebraicClosure K))
    (hXh : ∀ x ∈ X, x * baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K))
          (h : ModGL TwistTag.E6.tag K) =
        baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K))
          (h : ModGL TwistTag.E6.tag K) * x) :
    E6AdToral X := by
  haveI : Fact (ringChar K).Prime := ⟨D.hℓ⟩
  haveI := D.hchar
  have hg0 : D.S.D.g0 * rootDiagUnit Tag.E6 D.a * D.S.D.g0⁻¹ =
      baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K))
        (h : ModGL TwistTag.E6.tag K) := D.hg0
  generalize baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K))
    (h : ModGL TwistTag.E6.tag K) = b at hg0 hXh
  have hg := D.S.D.g0_mem
  have hk : (kernelRoots (rootCharHom D.a)).ncard = 22 ∨
      (kernelRoots (rootCharHom D.a)).ncard = 40 := by
    have := D.hker
    omega
  have hcent := toralCentralizer_eq_toralRootGroup_of_stabilizer_le Tag.E6 _ D.a
    (KSConn.e6_stab_le_kernelReflectionGroup_of_conn D.a D.hap
      (by rcases hk with hk | hk <;> simp [hk]))
  refine (e6AdToral_map_conj (inv_mem hg) X).1 (hS (AlgebraicClosure K) (ringChar K) ?_
    (isAlgebraic_zmod_algebraicClosure_of_finite K (ringChar K)) D.a D.hap
    (by rcases hk with hk | hk <;> simp [hk]) _ (hX.map _) ?_)
  · intro h3
    apply D.hL3
    rw [← h3]
    exact CharP.cast_eq_zero _ _
  · rintro _ ⟨x, hx, rfl⟩
    rw [← hcent, mem_toralCentralizer, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    refine ⟨mul_mem (mul_mem (inv_mem hg) (hXG hx)) (inv_mem (inv_mem hg)), ?_⟩
    have hd : rootDiagUnit Tag.E6 D.a = D.S.D.g0⁻¹ * b * D.S.D.g0 := by
      rw [← hg0]
      group
    rw [hd]
    calc _ = D.S.D.g0⁻¹ * (b * x) * b⁻¹ * D.S.D.g0 := by group
      _ = D.S.D.g0⁻¹ * (x * b) * b⁻¹ * D.S.D.g0 := by rw [hXh x hx]
      _ = _ := by group

