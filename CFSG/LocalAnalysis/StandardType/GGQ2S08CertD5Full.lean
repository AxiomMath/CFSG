theorem d5f_certOK : certOK d5fGens (xLast 5) d5fSets d5fPats d5fReps d5fS2 = true := by
  decide +kernel

theorem d5f_cov : dCovB 5 d5fPats = true := by
  decide +kernel

theorem d5f_refl : reflCertB d5fGens d5fCerts = true := by
  decide +kernel

theorem d5f_frame : dFrameB 5 d5fCerts = true := by
  decide +kernel

theorem d5f_S (k : Fin 5) : dFullS 5 k = letLin (letAt d5fGens k) := by
  refine LinearEquiv.toLinearMap_injective ((Pi.basisFun (ZMod 3) (Fin 6)).ext fun j => ?_)
  rw [Pi.basisFun_apply]
  revert k j
  decide +kernel

theorem d5f_test : ∀ A Mg : Subgroup (Vn 6 ≃ₗ[ZMod 3] Vn 6),
    TestHyp (Subgroup.closure (Set.range fun k : Fin 5 => dFullS 5 k)) (xLast 5) A Mg →
    ∀ t₁ ∈ Mg, IsRefl t₁ → ¬ FixesLine (xLast 5) t₁ →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (xLast 5) t → t ∈ Mg :=
  linTest_dframe_of_certOK (by norm_num) _ d5fGens rfl d5f_S d5f_refl d5f_frame d5f_certOK d5f_cov

