@[expose] def GGTwE6InnerThreeA2
    (R : Type) [Group R] (φ : MulAut R) : Prop :=
  ∃ g : R, φ = MulAut.conj g ∧ g ^ 3 = 1 ∧
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (σ : K ≃+* K) (q : ℕ)
      (ε : ↥(twistedE6RootGroup K σ) ≃* R),
      ringChar K ≠ 3 ∧ (∀ c, σ c = c ^ q) ∧ Nat.card K = q ^ 2 ∧ 3 ∣ q + 1 ∧ q ≠ 2 ∧
        twE6FixDim K σ (ε.symm g) = 24

@[expose] def GGHeisFieldCompRad
    (p r : ℕ) (R : Type) [Group R] (I F : Set (MulAut R)) : Prop :=
  ∀ (L' : Type) [Group L'] [Finite L'] (ψ : L' →* R), Function.Surjective ψ →
    ψ.ker ≤ Subgroup.center L' → commutator L' = ⊤ → p ∣ Nat.card ψ.ker →
    ∀ A : Subgroup (MulAut L'), IsElemAbelian p A →
      (∀ a ∈ A, ∃ φ ∈ Subgroup.closure (I ∪ F), ∀ l : L', φ (ψ l) = ψ (a l)) →
      (∃ a ∈ A, ¬ ∃ φ ∈ I, ∀ l : L', φ (ψ l) = ψ (a l)) →
      Nat.card A = p ^ r → GGTorusSelfCent p A →
      ∀ a₀ ∈ A, a₀ ≠ 1 →
        (∃ φ ∈ I, (∀ l : L', φ (ψ l) = ψ (a₀ l)) ∧ ¬ GGTwE6InnerThreeA2 R φ) →
        (∀ k : L', MulAut.conj k ∈ A → a₀ k = k) →
        ∃ n : L', GGTorusWeylElt p A n ∧
          MulAut.conj n * a₀ * (MulAut.conj n)⁻¹ ∉ Subgroup.zpowers a₀

@[expose] def GGNbrKGFieldTwE6ThreeAddHeisRad :
    Prop :=
  ∀ lab : LargeEvenLabel, LargeEvenInLambda2 lab → lab.tag = .twE6 → 3 ∣ 2 ^ lab.n + 1 →
    LargeEvenLabelAll lab fun R _ I F => IsSimpleGroup R → (∃ a b : R, a * b ≠ b * a) →
      GGHeisFieldCompRad 3 5 R I F

