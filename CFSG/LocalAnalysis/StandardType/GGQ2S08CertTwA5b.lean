@[expose] def a5bS (k : Fin 5) : Vn 5 ≃ₗ[ZMod 3] Vn 5 := letLin (letAt a5bGens k)

theorem a5b_certOK :
    certOK a5bGens (xLast 4) a5bSets a5bPats a5bReps a5bS2 = true := by
  decide +kernel

theorem a5b_cov : prefCovB 4 a5bPats = true := by
  decide +kernel

theorem a5b_adj : ∀ i : Fin 3, letAt a5bGens i =
    (Pi.single i.castSucc.castSucc 1 - Pi.single i.succ.castSucc 1,
      Pi.single i.castSucc.castSucc 1 - Pi.single i.succ.castSucc 1) := by
  decide +kernel

theorem a5b_test : ∀ A Mg : Subgroup (Vn 5 ≃ₗ[ZMod 3] Vn 5),
    TestHyp (Subgroup.closure (Set.range a5bS)) (xLast 4) A Mg →
    ∀ r ∈ Mg, IsRefl r → ¬ FixesLine (xLast 4) r →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (xLast 4) t → t ∈ Mg :=
  linTest_prefix_of_certOK (k := 3) a5bS a5bGens rfl (fun _ => rfl) (by norm_num)
    a5b_adj a5b_certOK a5b_cov

end CFSG.StandardType.TestLin

