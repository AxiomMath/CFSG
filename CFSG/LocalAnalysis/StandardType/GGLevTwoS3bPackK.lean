@[expose] def imgK (gs : List ℕ) (b : ℕ) : List ℕ := gs.map (fun P => lk8 P b)

theorem lk8_eq (P b : ℕ) : lk8 P b = (P >>> (8 * b)) &&& 255 := rfl

theorem bitB_eq : bitB = Nat.testBit := by
  funext v c
  have h : ∀ n : ℕ, Nat.blt 0 n = (n != 0) := by
    intro n
    cases n <;> rfl
  exact h _

theorem unpack8_getD : ∀ (n P b : ℕ), P >>> (8 * n) = 0 → (unpack8 P n).getD b 0 = lk8 P b
  | 0, P, b, h => by
    simp only [Nat.mul_zero, Nat.shiftRight_zero] at h
    subst h
    simp [unpack8, lk8_eq]
  | n + 1, P, 0, _ => by
    simp [unpack8, lk8_eq]
  | n + 1, P, b + 1, h => by
    have e : 8 + 8 * n = 8 * (n + 1) := by omega
    have h' : (P >>> 8) >>> (8 * n) = 0 := by
      rw [← Nat.shiftRight_add, e]
      exact h
    have e2 : 8 + 8 * b = 8 * (b + 1) := by omega
    simp only [unpack8, List.getD_cons_succ]
    refine (unpack8_getD n _ b h').trans ?_
    change lk8 (P >>> 8) b = lk8 P (b + 1)
    rw [lk8_eq, lk8_eq, ← Nat.shiftRight_add, e2]

@[expose] def lk32 (K j : ℕ) : ℕ := Nat.land (Nat.shiftRight K (Nat.mul 32 j)) 4294967295

@[expose] def unpack32 (K : ℕ) : ℕ → List ℕ
  | 0 => []
  | n + 1 => lk32 K 0 :: unpack32 (Nat.shiftRight K 32) n

@[expose] def incB : List ℕ → Bool
  | a :: b :: t => Nat.blt a b && incB (b :: t)
  | _ => true

@[expose] def e8KP : ℕ := 

theorem lk32_eq (K j : ℕ) : lk32 K j = (K >>> (32 * j)) &&& 4294967295 := rfl

theorem unpack32_getD : ∀ (n K j : ℕ), K >>> (32 * n) = 0 → (unpack32 K n).getD j 0 = lk32 K j
  | 0, K, j, h => by
    simp only [Nat.mul_zero, Nat.shiftRight_zero] at h
    subst h
    simp [unpack32, lk32_eq]
  | n + 1, K, 0, _ => by
    simp [unpack32, lk32_eq]
  | n + 1, K, j + 1, h => by
    have e : 32 + 32 * n = 32 * (n + 1) := by omega
    have h' : (K >>> 32) >>> (32 * n) = 0 := by
      rw [← Nat.shiftRight_add, e]
      exact h
    have e2 : 32 + 32 * j = 32 * (j + 1) := by omega
    simp only [unpack32, List.getD_cons_succ]
    refine (unpack32_getD n _ j h').trans ?_
    change lk32 (K >>> 32) j = lk32 K (j + 1)
    rw [lk32_eq, lk32_eq, ← Nat.shiftRight_add, e2]

theorem length_unpack32 : ∀ (n K : ℕ), (unpack32 K n).length = n
  | 0, _ => rfl
  | n + 1, K => by simp [unpack32, length_unpack32 n]

theorem incB_sound : ∀ (a : ℕ) (l : List ℕ), incB (a :: l) = true → (∀ x ∈ l, a < x) ∧ (a :: l).Nodup
  | a, [], _ => by simp
  | a, b :: t, h => by
    simp only [incB, Bool.and_eq_true, Nat.blt_eq] at h
    obtain ⟨h1, h2⟩ := incB_sound b t h.2
    have hall : ∀ x ∈ b :: t, a < x := by
      intro x hx
      rcases List.mem_cons.1 hx with hx | hx
      · rw [hx]
        exact h.1
      · exact Nat.lt_trans h.1 (h1 x hx)
    refine ⟨hall, List.nodup_cons.2 ⟨fun hm => Nat.lt_irrefl a (hall a hm), h2⟩⟩

theorem nodup_of_incB (l : List ℕ) (h : incB l = true) : l.Nodup := by
  revert h
  cases l with
  | nil => intro _; exact List.nodup_nil
  | cons a l => intro h; exact (incB_sound a l h).2

@[expose] def permChkG {α : Type} (K : ℕ) (f : α → ℕ) : List α → List ℕ → Bool
  | v :: vs, j :: js => Nat.beq (f v) (lk32 K j) && Nat.blt j 240 && permChkG K f vs js
  | [], [] => true
  | _, _ => false

theorem permChkG_sound {α : Type} (K : ℕ) (f : α → ℕ) (keys : List ℕ) (idx : ℕ → ℕ)
    (hidx : ∀ k, idx k = keys.idxOf k) (hK : K >>> 7680 = 0)
    (hk : keys = unpack32 K 240) (hnd : keys.Nodup) :
    ∀ (vs : List α) (js : List ℕ), permChkG K f vs js = true →
      vs.map (fun v => idx (f v)) = js
  | [], [], _ => rfl
  | [], _ :: _, h => by simp [permChkG] at h
  | _ :: _, [], h => by simp [permChkG] at h
  | v :: vs, j :: js, h => by
    simp only [permChkG, Bool.and_eq_true, Nat.beq_eq, Nat.blt_eq] at h
    obtain ⟨⟨h1, h2⟩, h3⟩ := h
    have hlen : j < keys.length := by
      rw [hk, length_unpack32]
      exact h2
    have hj : lk32 K j = keys[j] := by
      rw [← unpack32_getD 240 K j hK, ← hk, List.getD_eq_getElem _ _ hlen]
    have hidx' : idx (f v) = j := by
      rw [hidx, h1, hj]
      exact hnd.idxOf_getElem j hlen
    rw [List.map_cons, hidx', permChkG_sound K f keys idx hidx hK hk hnd vs js h3]

