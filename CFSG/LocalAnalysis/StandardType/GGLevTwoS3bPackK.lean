@[expose] def rkOf : List (ℕ × ℕ) → ℕ → ℕ
  | [], _ => 0
  | e :: L, r => if e.1 = r then e.2 else rkOf L r

theorem rkOf_mem : ∀ (L : List (ℕ × ℕ)) (r : ℕ), r ∈ L.map Prod.fst → (r, rkOf L r) ∈ L
  | [], _, h => by simp at h
  | e :: L, r, h => by
    by_cases he : e.1 = r
    · simp only [rkOf, he, if_true]
      rw [← he]
      exact List.mem_cons_self ..
    · simp only [rkOf, he, if_false]
      have h' : r ∈ L.map Prod.fst := by
        rcases List.mem_cons.1 (List.map_cons .. ▸ h) with h1 | h1
        · exact absurd h1.symm he
        · exact h1
      exact List.mem_cons_of_mem _ (rkOf_mem L r h')

theorem rep_mem (cl : List (ℕ × ℕ)) (R : List ℕ) (h0 : 0 ∈ R)
    (h : cl.all (fun p => R.contains p.1) = true) (a : ℕ) : (cl.getD a (0, 0)).1 ∈ R := by
  rw [List.getD_eq_getElem?_getD]
  cases hc : cl[a]? with
  | none => exact h0
  | some p =>
    have hp : p ∈ cl := List.mem_of_getElem? hc
    have h1 := List.all_eq_true.1 h p hp
    simpa using h1

@[expose] def sub2 (T : List ℕ) : List (List ℕ) :=
  [] :: T.map (fun a => [a]) ++
    (List.range T.length).flatMap (fun i =>
      ((List.range T.length).filter (fun j => i < j)).map
        (fun j => [T.getD i 0, T.getD j 0]))

@[expose] def covG (img : ℕ → List ℕ) (ext : ℕ → ℕ → ℕ) (cl : List (ℕ × ℕ))
    (T T' : List ℕ) : Bool :=
  let reps := T'.map (fun a => (cl.getD a (0, 0)).1)
  let vis0 := reps.foldl (fun acc b => acc ||| (1 <<< b)) 0
  let orb := bfsG (fun b => img b ++ reps.map (fun r => ext r b)) bitB 300 reps vis0
  T.all (fun a => bitB orb ((cl.getD a (0, 0)).1))

@[expose] def coverG (R : List ℕ) (img : ℕ → List ℕ) (ext : ℕ → ℕ → ℕ)
    (cl : List (ℕ × ℕ)) : Bool :=
  cl.all (fun p => R.contains p.1) &&
  (List.range (2 ^ cl.length)).all (fun mask =>
    let T := (List.range cl.length).filter (fun i => mask.testBit i)
    T.length < 3 || (sub2 T).any (fun T' => covG img ext cl T T'))

