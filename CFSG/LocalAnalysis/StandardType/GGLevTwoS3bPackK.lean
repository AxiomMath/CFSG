@[expose] def lk8 (P b : ℕ) : ℕ := Nat.land (Nat.shiftRight P (Nat.mul 8 b)) 255

@[expose] def bitB (v c : ℕ) : Bool := Nat.blt 0 (Nat.land 1 (Nat.shiftRight v c))

@[expose] def unpack8 (P : ℕ) : ℕ → List ℕ
  | 0 => []
  | n + 1 => lk8 P 0 :: unpack8 (Nat.shiftRight P 8) n

@[expose] def bfsG (img : ℕ → List ℕ) (bit : ℕ → ℕ → Bool) : ℕ → List ℕ → ℕ → ℕ
  | 0, _, vis => vis
  | _ + 1, [], vis => vis
  | f + 1, b :: rest, vis =>
      let r := (img b).foldl
        (fun (acc : ℕ × List ℕ) c =>
          if bit acc.1 c then acc else (acc.1 ||| (1 <<< c), c :: acc.2)) (vis, [])
      bfsG img bit f (rest ++ r.2) r.1

@[expose] def cdG (img : ℕ → List ℕ) (bit : ℕ → ℕ → Bool) (pm : ℕ) :
    List ℕ → ℕ → List (ℕ × ℕ) → List (ℕ × ℕ)
  | [], _, acc => acc
  | b :: rest, vis, acc =>
      if bit vis b || bit pm b then cdG img bit pm rest vis acc
      else
        let o := bfsG img bit 300 [b] (1 <<< b)
        cdG img bit pm rest (vis ||| o) (acc ++ [(b, o)])

