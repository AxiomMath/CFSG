theorem exists_exactQ_conj_rootDiagUnit
    {K : Type} [Field K] (k : ℕ) (b : Fin Tag.E6.rank → Kˣ) :
    ∃ c, exactQ .E6 K k * rootDiagUnit .E6 b * (exactQ .E6 K k)⁻¹ = rootDiagUnit .E6 c := by
  induction k generalizing b with
  | zero => exact ⟨b, by rw [exactQ_zero, one_mul, inv_one, mul_one]⟩
  | succ k ih =>
    set P : ModGL Tag.E6 K := diagramMap .E6 K
    have hPb : P * rootDiagUnit .E6 b =
        rootDiagUnit .E6 (fun i => b (TwistTag.E6.perm.symm i)) * P :=
      E6_diagramMap_mul_rootDiagUnit b
    obtain ⟨c, hc⟩ := ih (fun i => b (TwistTag.E6.perm.symm i))
    refine ⟨c, ?_⟩
    have hQ : exactQ .E6 K (k + 1) = exactQ .E6 K k * P := pow_succ P k
    rw [hQ, ← hc]
    calc exactQ .E6 K k * P * rootDiagUnit .E6 b * (exactQ .E6 K k * P)⁻¹ =
        exactQ .E6 K k * (P * rootDiagUnit .E6 b) * P⁻¹ * (exactQ .E6 K k)⁻¹ := by group
      _ = _ := by rw [hPb]; group

theorem twisted_torus_bruhat_of_diag
    {τ : Tag} {K : Type} [Field K] {w : WeylGroup τ} {h u v : ModGL τ K}
    (hh : h ∈ torusGroup τ K) (hu : u ∈ posUnipotent τ K)
    (hv : v ∈ rootSpan τ K (inversionSet w)) {a b : Fin τ.rank → Kˣ}
    (hconj : h * u * canonicalRep (coxeterSystem τ) K w * v * rootDiagUnit τ b =
      rootDiagUnit τ a * (h * u * canonicalRep (coxeterSystem τ) K w * v)) :
    rootDiagUnit τ a * u * (rootDiagUnit τ a)⁻¹ = u ∧
      rootDiagUnit τ b * v * (rootDiagUnit τ b)⁻¹ = v ∧
      rootDiagUnit τ a = canonicalRep (coxeterSystem τ) K w * rootDiagUnit τ b *
        (canonicalRep (coxeterSystem τ) K w)⁻¹ := by
  have hTB := triangular_borel_structure.{0, 0} τ K
  have hBC : borelGroup τ K ≤ adjointGroup τ K := (hTB.2.2.2.2.2.2.2.2.2.2.2 K).1
  have hUC : posUnipotent τ K ≤ adjointGroup τ K := le_sup_right.trans hBC
  have hIU : rootSpan τ K (inversionSet w) ≤ posUnipotent τ K :=
    iSup₂_le fun α hα => le_iSup₂_of_le (f := fun β (_ : β ∈ {β : Fin τ.rank → ℤ |
      IsRoot τ β ∧ 0 < height β}) => rootSubgroup τ K β) α ⟨hα.1, hα.2.1⟩ le_rfl
  have hnC := canonicalRep_mem_adjointGroup (coxeterSystem τ) K w
  have hRL : IsSupp 1 (((rootDiagUnit τ b)⁻¹ : ModGL τ K) :
      Module.End K (RootModule τ K)) := by
    rw [rootDiagUnit_inv]
    exact isRL_rootDiagUnit b⁻¹
  have hRL' := (((isRL_rootDiagUnit (K := K) a : IsSupp 1 _).mul
    (isSupp_canonicalRep (K := K) w).1).mul hRL).mul (isSupp_canonicalRep (K := K) w).2
  set n := canonicalRep (coxeterSystem τ) K w
  set da := rootDiagUnit τ a
  set db := rootDiagUnit τ b with hdb
  set t := da * (n * db * n⁻¹)⁻¹ with ht
  have hdu : da * u * da⁻¹ ∈ posUnipotent τ K := by
    have := ((chevalley_root_character_and_field_conjugation τ K).2.2.2.1 a).2.1
    rw [← this]
    exact ⟨u, hu, rfl⟩
  have hdv : db * v * db⁻¹ ∈ rootSpan τ K (inversionSet w) := by
    have : (rootSpan τ K (inversionSet w)).map (MulAut.conj db).toMonoidHom =
        rootSpan τ K (inversionSet w) :=
      map_rootSpan_of_forall fun α hα => map_conj_rootDiagUnit_rootSubgroup b hα.1
    rw [← this]
    exact ⟨v, hv, rfl⟩
  have hcomm : da * h = h * da := rootDiagUnit_mul_comm_of_mem_torusGroup a hh
  have hg' : da * (h * u * n * v) * db⁻¹ = h * u * n * v := by
    rw [← hconj, mul_inv_cancel_right]
  have hkey : da * u * n * v * db⁻¹ = u * n * v := by
    calc da * u * n * v * db⁻¹ = h⁻¹ * (h * da) * u * n * v * db⁻¹ := by group
      _ = h⁻¹ * (da * (h * u * n * v) * db⁻¹) := by rw [← hcomm]; group
      _ = u * n * v := by rw [hg']; group
  have htC : t ∈ adjointGroup τ K := by
    have e : t = (da * u * da⁻¹)⁻¹ * (u * n * v) * (db * v * db⁻¹)⁻¹ * n⁻¹ := by
      rw [← hkey, ht]
      group
    rw [e]
    exact mul_mem (mul_mem (mul_mem (inv_mem (hUC hdu))
      (mul_mem (mul_mem (hUC hu) hnC) (hUC (hIU hv)))) (inv_mem (hUC (hIU hdv)))) (inv_mem hnC)
  have htRL : IsRL ((t : ModGL τ K) : Module.End K (RootModule τ K)) := by
    have e : t = da * n * db⁻¹ * n⁻¹ := by
      rw [ht]
      group
    rw [show (1 : WeylGroup τ) * w * 1 * w⁻¹ = 1 by group] at hRL'
    rw [e]
    simpa only [IsRL, Units.val_mul] using hRL'
  have htT : t ∈ torusGroup τ K := mem_torusGroup_of_isRL htC htRL
  have hu' : t⁻¹ * (da * u * da⁻¹) * t ∈ posUnipotent τ K := by
    have hN := hTB.2.2.1 (inv_mem htT)
    have := (Subgroup.mem_normalizer_iff.1 hN (da * u * da⁻¹)).1 hdu
    simpa using this
  have heq : h * t * (t⁻¹ * (da * u * da⁻¹) * t) * n * (db * v * db⁻¹) = h * u * n * v := by
    calc h * t * (t⁻¹ * (da * u * da⁻¹) * t) * n * (db * v * db⁻¹) =
        (h * da) * u * n * v * db⁻¹ := by
          simp only [ht]
          group
      _ = da * (h * u * n * v) * db⁻¹ := by
          rw [← hcomm]
          group
      _ = h * u * n * v := hg'
  obtain ⟨-, h1, h2, h3⟩ := (Chevalley_toral_centralizer_Bruhat_factors τ K a).2.1 w w
    (h * t) h _ u _ v (mul_mem hh htT) hh hu' hu hdv hv heq
  have ht1 : t = 1 := by rwa [mul_eq_left] at h1
  refine ⟨?_, h3, ?_⟩
  · rw [ht1, inv_one, one_mul, mul_one] at h2
    exact h2
  · rw [ht, mul_inv_eq_one] at ht1
    exact ht1

