section Rational

variable
  {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}

theorem rho_iterate_mem_kernelRoots (S : LangSetup Tag.E6 L p₀) {a : Fin Tag.E6.rank → Lˣ}
    (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (k : ℕ) {γ : Fin Tag.E6.rank → ℤ}
    (hγ : γ ∈ kernelRoots (rootCharHom a)) :
    (S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[k] γ ∈ kernelRoots (rootCharHom a) := by
  induction k with
  | zero => exact hγ
  | succ k ih =>
    rw [Function.iterate_succ_apply']
    obtain ⟨hδ, h⟩ := ih
    refine ⟨(S.frob.isRoot_iff _).2 hδ, ?_⟩
    have h' : rootChar a ((S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[k] γ) = 1 := h
    change rootChar a (S.ρ _) = 1
    rw [S.frob.rootChar_eq a hT _ hδ, h', one_pow]

theorem rationalComponent_le_rootSpan (S : LangSetup Tag.E6 L p₀) {a : Fin Tag.E6.rank → Lˣ}
    (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (i : KernelComponent (rootCharHom a)) :
    rationalComponent S.ρ S.Γ (rootCharHom a) i ≤
      rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) := by
  change ⁅rationalSpan S.ρ S.Γ (rootCharHom a) i, rationalSpan S.ρ S.Γ (rootCharHom a) i⁆ ≤ _
  refine (Subgroup.commutator_le_self _).trans (inf_le_left.trans (biSup_mono ?_))
  rintro _ ⟨k, δ, hδ, rfl⟩
  exact rho_iterate_mem_kernelRoots S hT k hδ.1

theorem componentRoots_eq_kernelRoots (h3 : ((3 : ℕ) : L) ≠ 0) {a : Fin Tag.E6.rank → Lˣ}
    (hap : ∀ i, a i ^ 3 = 1) (hk : (kernelRoots (rootCharHom a)).ncard = 40)
    (i : KernelComponent (rootCharHom a)) :
    componentRoots (rootCharHom a) i = kernelRoots (rootCharHom a) := by
  obtain ⟨-, -, -, -, hn, -⟩ := d5_class_data h3 hap hk i
  exact Set.eq_of_subset_of_ncard_le (fun γ hγ => hγ.1) (by rw [hk, hn])
    ((CFSG.Blueprint.Chevalley.finite_setOf_isRoot Tag.E6).subset fun γ hγ => hγ.1)

theorem rationalRoots_eq_kernelRoots (S : LangSetup Tag.E6 L p₀) {a : Fin Tag.E6.rank → Lˣ}
    (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (i : KernelComponent (rootCharHom a))
    (hΨk : componentRoots (rootCharHom a) i = kernelRoots (rootCharHom a)) :
    rationalRoots S.ρ (rootCharHom a) i = kernelRoots (rootCharHom a) := by
  refine Set.Subset.antisymm ?_ fun γ hγ => ⟨0, γ, by rw [hΨk]; exact hγ, rfl⟩
  rintro _ ⟨k, δ, hδ, rfl⟩
  exact rho_iterate_mem_kernelRoots S hT k hδ.1

end Rational


section Datum

variable {p₀ : ℕ} [Fact p₀.Prime] {k : Type} [Field k] [CharP k p₀] [IsAlgClosed k]
  {M : Type} [CommGroup M]

theorem fixedGroup_eq_orbitGroupC_of_d5 (D : GenFixedRootDatum Tag.E6 p₀ k M)
    {Ψ : Set (Fin Tag.E6.rank → ℤ)} (w : WeylGroup Tag.E6) (Jf : Finset (Fin Tag.E6.rank))
    (hΨ : Ψ = (fun α => w • α) '' parabolicRoots Tag.E6 (↑Jf : Set (Fin Tag.E6.rank)))
    (hΔ : simpleRoots Ψ = Jf.image fun j => w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ))
    (hν : ∀ j₀ ∈ Jf, ∃ ν : Fin Tag.E6.rank → ℤ, ∀ j ∈ Jf,
      ∑ l, Tag.E6.cartan j l * ν l = if j = j₀ then 1 else 0)
    (hDs : D.simpleRootsJ = ((simpleRoots Ψ : Finset (Fin Tag.E6.rank → ℤ)) :
      Set (Fin Tag.E6.rank → ℤ)))
    (hDt : D.torusJ = rootSpan Tag.E6 k Ψ ⊓ torusGroup Tag.E6 k) :
    D.fixedGroup = D.orbitGroupC := by
  have hFT : D.fixedTorus ≤ D.orbitGroupC := by
    refine fixedTorus_le_orbitGroupC_of_coords D
      (Jf.image fun j => w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) ?_ ?_ ?_
    · rw [hDs, hΔ]
    · intro t ht
      rw [hDt, inf_comm, hΨ] at ht
      exact torus_coords_of_conj w Jf ht
    · intro c c' h β hβ
      exact coords_unique_of_conj w Jf hν h hβ
  refine le_antisymm (fun g hg => ?_) D.orbitGroupC_le_fixedGroup
  have hg' : g ∈ (D.fixedGroup : Set (adjointGroup Tag.E6 k)) := hg
  rw [D.coe_fixedGroup_eq_mul, Set.mem_mul] at hg'
  obtain ⟨t, ht, c, hc, rfl⟩ := hg'
  exact mul_mem (hFT ht) hc

end Datum

section Main

variable
  {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}

theorem d5_fixedSpin_perfect (S : LangSetup Tag.E6 L p₀) {Fr : L →+* L}
    (hFr : ∀ c, Fr c = c ^ S.D.q) (hΦ : S.D.Φ = twistHom TwistTag.E6 L Fr)
    (h3 : ((3 : ℕ) : L) ≠ 0) (h3q : 3 ∣ S.D.q + 1) {a : Fin Tag.E6.rank → Lˣ}
    (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (hap : ∀ i, a i ^ 3 = 1)
    (hk : (kernelRoots (rootCharHom a)).ncard = 40) :
    ⁅rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) ⊓ S.D.model,
        rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) ⊓ S.D.model⁆ =
      rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) ⊓ S.D.model := by
  have hfin : (kernelRoots (rootCharHom a)).Finite :=
    (CFSG.Blueprint.Chevalley.finite_setOf_isRoot Tag.E6).subset fun γ hγ => hγ.1
  obtain ⟨α, hα⟩ : (kernelRoots (rootCharHom a)).Nonempty := by
    rw [← Set.ncard_pos hfin, hk]
    norm_num
  let i : KernelComponent (rootCharHom a) := ⟦⟨α, hα⟩⟧
  obtain ⟨u, hu, hρ⟩ := exists_rho_neg_weyl_of_conn S hFr hΦ hT hap h3q (by rw [hk]; simp)
  obtain ⟨v₀, C, hC, hΨ₀, hn, hrk⟩ := d5_class_data h3 hap hk i
  have hΨk := componentRoots_eq_kernelRoots h3 hap hk i
  have hu' : u ∈ Subgroup.closure {s : WeylGroup Tag.E6 |
      ∃ γ ∈ componentRoots (rootCharHom a) i, s = rootReflection γ} :=
    kernelReflectionGroup_le_closure (by rw [hΨk]) hu
  have hstab : ∀ γ ∈ componentRoots (rootCharHom a) i,
      S.ρ γ ∈ componentRoots (rootCharHom a) i := by
    intro γ hγ
    rw [hΨk] at hγ ⊢; exact rho_iterate_mem_kernelRoots S hT 1 hγ
  have hlen : componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 1 :=
    componentOrbitLength_eq_one (hΨk ▸ hfin) hstab
  have hno := not_exists_neg_D5 hC v₀
  rw [← hΨ₀] at hno
  have hkind : twistKind S.ρ (rootCharHom a) i = .twoD := by
    classical
    unfold twistKind
    rw [hlen]
    have hni : ¬ twistInner (componentRoots (rootCharHom a) i) ((S.ρ : _ → _)^[1]) := by
      rw [Function.iterate_one]
      exact not_twistInner_of_neg hu' (fun γ hγ => hρ γ (hΨk ▸ hγ).1) hno
    rw [if_neg hni, if_neg (by rw [hrk, hn]; omega),
      if_pos ⟨by rw [hrk]; omega, by rw [hrk, hn]⟩]
  obtain ⟨r, e, m, hr, hchar, hm5, z, ε, D, hq, he, hDe, hperf, hDs, hDt, hε, hmap⟩ :=
    exists_twoD_export_fixed S (Or.inr (Or.inl rfl)) hT i hkind hrk.symm.le
  haveI := hr
  haveI := hchar
  have hmcard : m = 5 := by
    have h1 : Fintype.card (simpleRoots (componentRoots (rootCharHom a) i)) = m := by
      rw [Fintype.card_congr ε, Fintype.card_fin]
    rw [Fintype.card_coe, ← CFSG.HardMathSupport.Timmesfeld.RootAut.compRank_eq_card
      (isRootComponent_componentRoots i), hrk] at h1
    exact h1.symm
  subst hmcard
  obtain ⟨v, J, hJ, hΨv⟩ := d5_position h3 hap hk
  have hΨv' : componentRoots (rootCharHom a) i = (fun α => v • α) '' parabolicRoots Tag.E6 J := by
    rw [hΨk]
    exact hΨv
  obtain ⟨w, Jf, hw1, hw2, hν⟩ := d5_base_form (isRootComponent_componentRoots i) hJ hΨv' ε hε
  have hfix : D.fixedGroup = D.orbitGroupC :=
    fixedGroup_eq_orbitGroupC_of_d5 D w Jf hw1 hw2 hν hDs hDt
  have hfg : D.fixedGroup.map (adjointGroup Tag.E6 L).subtype = D.orbitGroup := by
    rw [hfix]
    change (D.orbitGroup.subgroupOf (adjointGroup Tag.E6 L)).map
      (adjointGroup Tag.E6 L).subtype = _
    rw [Subgroup.subgroupOf_map_subtype]
    exact inf_eq_left.2 D.orbitGroup_le_adjointGroup
  rw [← hΨk]
  apply Subgroup.map_injective (f := (MulAut.conj z⁻¹).toMonoidHom) (MulAut.conj z⁻¹).injective
  rw [Subgroup.map_commutator, hmap.trans hfg, Subgroup.isPerfect_iff.mp hperf]

theorem mem_rationalComponent_of_step_eq (S : LangSetup Tag.E6 L p₀) {Fr : L →+* L}
    (hFr : ∀ c, Fr c = c ^ S.D.q) (hΦ : S.D.Φ = twistHom TwistTag.E6 L Fr)
    (h3 : ((3 : ℕ) : L) ≠ 0) (h3q : 3 ∣ S.D.q + 1) {a : Fin Tag.E6.rank → Lˣ}
    (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (hap : ∀ i, a i ^ 3 = 1)
    (hk : (kernelRoots (rootCharHom a)).ncard = 40) (i : KernelComponent (rootCharHom a))
    {g : ModGL Tag.E6 L} (hg : g ∈ rootSpan Tag.E6 L (kernelRoots (rootCharHom a)))
    (hgF : S.D.step g = g) : g ∈ rationalComponent S.ρ S.Γ (rootCharHom a) i := by
  have hperf := d5_fixedSpin_perfect S hFr hΦ h3 h3q hT hap hk
  have hrat := rationalRoots_eq_kernelRoots S hT i (componentRoots_eq_kernelRoots h3 hap hk i)
  have hadj : rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) ≤ adjointGroup Tag.E6 L :=
    iSup₂_le fun α _ => rootSubgroup_le_adjointGroup α
  have hgP : g ∈ rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) ⊓ S.D.model :=
    Subgroup.mem_inf.2 ⟨hg, S.D.mem_model.2 ⟨hadj hg, hgF⟩⟩
  have hle : rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) ⊓ S.D.model ≤
      rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) ⊓ S.Γ := by
    refine le_inf inf_le_left ?_
    calc rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) ⊓ S.D.model
        = ⁅rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) ⊓ S.D.model,
            rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) ⊓ S.D.model⁆ := hperf.symm
      _ ≤ ⁅S.D.model, S.D.model⁆ := Subgroup.commutator_mono inf_le_right inf_le_right
      _ = S.Γ := rfl
  rw [rationalComponent, rationalSpan, hrat]
  exact Subgroup.commutator_mono hle hle (by rw [hperf]; exact hgP)

end Main

