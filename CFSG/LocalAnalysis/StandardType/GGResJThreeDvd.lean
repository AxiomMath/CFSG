theorem GGConfig.dvd_card_J_of_eq_three
    {G : Type} [Group G] [Finite G] {p : ℕ} {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    (hcfg : GGConfig p B Bs x L D J) (hp : p = 3) (hJ : GGInnerDiagOn Bs J) :
    p ∣ Nat.card J := by
  subst hp
  obtain ⟨hperf, lab, hlab, hraw⟩ := largeEvenMarking_markedModel hJ
  obtain ⟨t, l, n⟩ := lab
  by_cases htag : t = .twB2
  · subst t
    dsimp only [LargeEvenRawDatum, LargeEvenRecipeSuzuki] at hraw
    obtain ⟨K, _, _, _, hQ⟩ := hraw
    let R : Type := LargeEvenCenterQuot (LargeEvenSzGroup ((n - 1) / 2) K)
    obtain ⟨hs, hna, θ, hP, hm⟩ := hQ
    obtain ⟨hBsN, hind⟩ := hP
    dsimp only [MarkedModel, markTag, markRank, markChar, markDeg] at hm
    have hnot3 : ¬ 3 ∣ Nat.card (LargeEvenCenterQuot (LargeEvenSzGroup ((n - 1) / 2) K)) :=
      CFSG.LocalAnalysis.EvenBN.GMSK.not_three_dvd_card_twistedB2_of_lieModel hm
    have hcent : ∀ b ∈ Bs, b⁻¹ ∈ Subgroup.centralizer (J : Set G) := by
      intro b hb
      have hb3 : b ^ 3 = 1 := hcfg.2.1.2.1.2 b hb
      have hbN : b⁻¹ ∈ Subgroup.normalizer (J : Set G) := hBsN (Subgroup.inv_mem Bs hb)
      obtain ⟨φ, hφmem, hindφ⟩ := hind b hb
      rw [LargeEvenInnSet] at hφmem
      obtain ⟨r, rfl⟩ := hφmem
      have hstep : ∀ j : ↥J, (MulAut.conj r) (θ (QuotientGroup.mk j)) =
          θ (QuotientGroup.mk (CFSG.RankThree.PartOne.KFOUT3.jConj hbN j)) := by
        intro j
        exact hindφ j (CFSG.RankThree.PartOne.KFOUT3.jConj hbN j)
          (by simp [CFSG.RankThree.PartOne.KFOUT3.jConj_apply])
      have hbN3 : (b⁻¹) ^ 3 = 1 := by rw [inv_pow, hb3, inv_one]
      have hiter : ∀ j : ↥J,
          CFSG.RankThree.PartOne.KFOUT3.jConj hbN
            (CFSG.RankThree.PartOne.KFOUT3.jConj hbN
              (CFSG.RankThree.PartOne.KFOUT3.jConj hbN j)) = j := by
        intro j
        apply Subtype.ext
        simp only [CFSG.RankThree.PartOne.KFOUT3.jConj_apply, inv_inv]
        have hbN3' : b⁻¹ * b⁻¹ * b⁻¹ = 1 := by rw [← pow_three', hbN3]
        have hb3' : b * b * b = 1 := by rw [← pow_three', hb3]
        calc b⁻¹ * (b⁻¹ * (b⁻¹ * (j : G) * b) * b) * b
            = (b⁻¹ * b⁻¹ * b⁻¹) * (j : G) * (b * b * b) := by group
          _ = 1 * (j : G) * 1 := by rw [hbN3', hb3']
          _ = (j : G) := by simp
      have hφ3 : (MulAut.conj r) ^ 3 = 1 := by
        refine MulEquiv.ext fun x => ?_
        obtain ⟨y, rfl⟩ := θ.surjective x
        obtain ⟨j, rfl⟩ := QuotientGroup.mk_surjective y
        rw [pow_three, MulAut.mul_apply, MulAut.mul_apply, hstep, hstep, hstep, hiter,
          MulAut.one_apply]
      have hcenter : r ^ 3 ∈ Subgroup.center R := by
        rw [Subgroup.mem_center_iff]
        intro x
        have hx : (MulAut.conj r ^ 3) x = x := by rw [hφ3]; rfl
        rw [← map_pow, MulAut.conj_apply] at hx
        have hcomm : r ^ 3 * x = x * r ^ 3 := by
          calc r ^ 3 * x = (r ^ 3 * x * (r ^ 3)⁻¹) * r ^ 3 := by group
            _ = x * r ^ 3 := by rw [hx]
        exact hcomm.symm
      have hcenter_bot : Subgroup.center R = ⊥ := by
        rcases Subgroup.Normal.eq_bot_or_eq_top (Subgroup.center R) with h | h
        · exact h
        · exfalso
          have hcomm : ∀ a₁ a₂ : R, a₁ * a₂ = a₂ * a₁ :=
            isMulCommutative_iff.mp (Subgroup.center_eq_top_iff.mp h)
          obtain ⟨a₁, a₂, ha⟩ := hna
          exact ha (hcomm a₁ a₂)
      have hr3 : r ^ 3 = 1 := by
        have h := hcenter
        rw [hcenter_bot] at h
        simpa using h
      have hr1 : r = 1 := by
        have hdvd : orderOf r ∣ 3 := orderOf_dvd_of_pow_eq_one hr3
        rcases (Nat.dvd_prime (by norm_num : Nat.Prime 3)).mp hdvd with h1 | h3
        · exact orderOf_eq_one_iff.mp h1
        · exfalso
          exact hnot3 (h3 ▸ orderOf_dvd_natCard r)
      have hφ1 : (MulAut.conj r) = 1 := by rw [hr1, map_one]
      have htriv : ∀ j : ↥J,
          (QuotientGroup.mk (CFSG.RankThree.PartOne.KFOUT3.jConj hbN j) :
            ↥J ⧸ Subgroup.center ↥J) = QuotientGroup.mk j := by
        intro j
        have h := hindφ j (CFSG.RankThree.PartOne.KFOUT3.jConj hbN j)
          (by simp [CFSG.RankThree.PartOne.KFOUT3.jConj_apply])
        rw [hφ1, MulAut.one_apply] at h
        exact (θ.injective h).symm
      exact CFSG.RankThree.PartOne.KFOUT3.mem_centralizer_of_trivial_action
        (Group.isPerfect_def.mpr hperf) hbN htriv
    have hcent' : ∀ b ∈ Bs, b ∈ Subgroup.centralizer (J : Set G) := by
      intro b hb
      simpa using Subgroup.inv_mem (H := Subgroup.centralizer (J : Set G)) (hcent b hb)
    have hle : Bs ≤ Bs ⊓ Subgroup.centralizer (J : Set G) := fun b hb => ⟨hb, hcent' b hb⟩
    have h4 : 3 ^ 4 ≤ Nat.card Bs := ggBs_four_le_card hcfg.1 hcfg.2.1
    have h3 : Nat.card ↥(Bs ⊓ Subgroup.centralizer (J : Set G)) ≤ 3 ^ 3 :=
      hcfg.card_bstar_inf_centralizer_J_le
    have hle_card : Nat.card Bs ≤ Nat.card ↥(Bs ⊓ Subgroup.centralizer (J : Set G)) :=
      Subgroup.card_le_of_le hle
    have : 3 ^ 4 ≤ 3 ^ 3 := le_trans h4 (le_trans hle_card h3)
    norm_num at this
  · obtain ⟨R, _, I, F, hQ⟩ := largeEvenRawDatum_exists hraw
    obtain ⟨hs, hna, θ, hP, hm⟩ := hQ
    have h3R : 3 ∣ Nat.card R :=
      CFSG.LocalAnalysis.EvenBN.GMSK.three_dvd_card_of_lieModel
        (CFSG.Blueprint.LieModel.admissible hm) hm
        (F4Nonsplit.markTag_ne_twistedB2 (lab := ⟨t, l, n⟩) htag)
    have h3Q : 3 ∣ Nat.card (↥J ⧸ Subgroup.center ↥J) := by
      rw [← Nat.card_congr θ.toEquiv] at h3R
      exact h3R
    exact h3Q.trans (Subgroup.card_quotient_dvd_card (Subgroup.center ↥J))

end CFSG.StandardType

