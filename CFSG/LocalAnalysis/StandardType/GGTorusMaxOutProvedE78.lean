theorem tmOut_E7
    (d : TauCeti.ValidLieTypeIndex) (q : TauCeti.PrimePower) (hd : d.1 = .E7 q)
    (J : Type) [Group J] [Finite J] (e : Nonempty (J ≃* (TauCeti.CFSGIndex.lie d).Group)) :
    Nat.card (MulAut J) ∣ Nat.card J * tmLieOut d.1 := by
  obtain ⟨d', hv⟩ := d
  dsimp only at hd
  subst d'
  obtain ⟨e⟩ := e
  have hB : Even.UntwistedBridgeAll .E7 TauCeti.LieTypeIndex.E7 :=
    Even.untwistedBridgeAll_of untwistedBridge_E7 Even.untwistedBridgeEven_E7
  obtain ⟨K, hfield, hfinite, hK, -, ⟨eK⟩⟩ :=
    CFSG.LieType.SeitzGeneration.exists_catEquiv_adjointGroup hB q hv
  let : Field K := hfield
  let : Finite K := hfinite
  have hK' : Nat.card K = q.p ^ q.exponent := by
    rw [hK, TauCeti.PrimePower.card_def]
  have hOutJ_of {m : ℕ} (hm : Nat.card (Outer (adjointGroup .E7 K)) ∣ m) :
      Nat.card (Outer J) ∣ m := by
    rw [Nat.card_congr
      (CFSG.ComponentClassification.OuterAutomorphisms.equivalence (e.trans eK)).toEquiv]
    exact hm
  rcases q.prime_p.eq_two_or_odd' with hp2 | hpodd
  · have hf : 1 ≤ q.exponent := q.exponent_pos
    have hK2 : Nat.card K = 2 ^ q.exponent := by rw [hK', hp2]
    obtain ⟨-, Θ, -, -, hker, -⟩ :=
      CFSG.LieType.Chevalley.even_E7_E8_exact_inner_field_automorphism_normal_form
        hf K hK2 .E7 (Or.inl rfl)
    have hOutK : Nat.card (Outer (adjointGroup .E7 K)) ∣ q.exponent := by
      have h :=
        CFSG.RankThree.PartTwo.Sec13.K135GL12.gl12kE_card_outer_dvd Θ hker
      rw [(CFSG.LocalAnalysis.ComponentInitial.card_ringAut_and_isCyclic
        Nat.prime_two K hK2).1] at h
      exact h
    have hodd : Odd (q.card - 1) := by
      rw [TauCeti.PrimePower.card_def, hp2]
      exact Nat.Even.sub_odd Nat.one_le_two_pow
        (Nat.even_pow.mpr ⟨even_two, by have := q.exponent_pos; omega⟩) odd_one
    have hgcd : Nat.gcd 2 (q.card - 1) = 1 := Nat.coprime_two_left.mpr hodd
    have ht : tmLieOut (.E7 q) = q.exponent := by
      rw [tmLieOut.eq_8, hgcd, one_mul]
    rw [ht]
    exact CFSG.StandardType.SporadicShape.bmOut_card_aut_dvd (hOutJ_of hOutK)
  · have hOutK : Nat.card (Outer (adjointGroup .E7 K)) ∣ 2 * q.exponent := by
      have h := (CFSG.LieType.Chevalley.ordinary_E_outer_order_Cartan_divisor .E7
        (Or.inr (Or.inl rfl)) q.prime_p q.exponent_pos K hK' 2 1
        (Or.inr (Or.inl ⟨rfl, rfl, rfl⟩))).1
      simpa using h
    have hodd : Odd q.card := by
      rw [TauCeti.PrimePower.card_def]
      exact hpodd.pow
    have hgcd : Nat.gcd 2 (q.card - 1) = 2 :=
      Nat.gcd_eq_left (even_iff_two_dvd.mp (Nat.Odd.sub_odd hodd odd_one))
    have ht : tmLieOut (.E7 q) = 2 * q.exponent := by
      rw [tmLieOut.eq_8, hgcd]
    rw [ht]
    exact CFSG.StandardType.SporadicShape.bmOut_card_aut_dvd (hOutJ_of hOutK)

theorem tmOut_E8
    (d : TauCeti.ValidLieTypeIndex) (q : TauCeti.PrimePower) (hd : d.1 = .E8 q)
    (J : Type) [Group J] [Finite J] (e : Nonempty (J ≃* (TauCeti.CFSGIndex.lie d).Group)) :
    Nat.card (MulAut J) ∣ Nat.card J * tmLieOut d.1 := by
  obtain ⟨d', hv⟩ := d
  dsimp only at hd
  subst d'
  obtain ⟨e⟩ := e
  have hB : Even.UntwistedBridgeAll .E8 TauCeti.LieTypeIndex.E8 :=
    Even.untwistedBridgeAll_of untwistedBridge_E8 Even.untwistedBridgeEven_E8
  obtain ⟨K, hfield, hfinite, hK, -, ⟨eK⟩⟩ :=
    CFSG.LieType.SeitzGeneration.exists_catEquiv_adjointGroup hB q hv
  let : Field K := hfield
  let : Finite K := hfinite
  have hK' : Nat.card K = q.p ^ q.exponent := by
    rw [hK, TauCeti.PrimePower.card_def]
  have hOutK : Nat.card (Outer (adjointGroup .E8 K)) ∣ q.exponent := by
    have h := (CFSG.LieType.Chevalley.ordinary_E_outer_order_Cartan_divisor .E8
      (Or.inr (Or.inr rfl)) q.prime_p q.exponent_pos K hK' 1 1
      (Or.inr (Or.inr ⟨rfl, rfl, rfl⟩))).1
    simpa using h
  have hOutJ : Nat.card (Outer J) ∣ q.exponent := by
    rw [Nat.card_congr
      (CFSG.ComponentClassification.OuterAutomorphisms.equivalence (e.trans eK)).toEquiv]
    exact hOutK
  have ht : tmLieOut (.E8 q) = q.exponent := by
    rw [tmLieOut.eq_9]
  rw [ht]
  exact CFSG.StandardType.SporadicShape.bmOut_card_aut_dvd hOutJ

