@[expose] def SylowSetup
    (τ : Tag) (K : Type) [Field K] [Finite K] (p : ℕ) : Prop :=
  ∃ (L : Type) (_ : Field L) (_ : IsAlgClosed L) (S : LangSetup τ L p),
    S.D.q = Nat.card K ∧ S.IsAlgebraic ∧
    (∃ S₀ : Sylow p S.Γ, (S₀ : Subgroup S.Γ) ≤ S.D.torus.subgroupOf S.Γ) ∧
    Nonempty (adjointGroup τ K ≃* S.Γ)

private theorem not_dvd_div_small {p e : ℕ} (hp : p.Prime) (hp7 : 7 ≤ p) {D : List ℕ}
    (h : ∀ d ∈ D, e ∣ d → d / e ∣ 120 ∧ d / e ≤ 10) : ∀ d ∈ D, e ∣ d → ¬ p ∣ d / e := by
  intro d hd hed hpd
  obtain ⟨h120, h10⟩ := h d hd hed
  have hle : p ≤ 10 := (Nat.le_of_dvd (Nat.pos_of_dvd_of_pos h120 (by norm_num)) hpd).trans h10
  have h' : p ∣ 120 := hpd.trans h120
  interval_cases p <;> first | omega | (norm_num at hp)

