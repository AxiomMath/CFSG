      (by decide) (CFSG.LieType.Steinberg.Adjoint.isQuasisimple_e8 K).1
private theorem isPGroup_closure_pair {G : Type*} [Group G] {p : ℕ} {a b : G} (ha : a ^ p = 1)
    (hb : b ^ p = 1) (hab : a * b = b * a) : IsPGroup p (Subgroup.closure {a, b}) := by
  have hcomm : ({a, b} : Set G).Pairwise Commute := by
    intro x hx y hy _
    rcases hx with rfl | rfl <;> rcases hy with rfl | rfl
    · exact Commute.refl _
    · exact hab
    · exact hab.symm
    · exact Commute.refl _
  letI := Subgroup.closureCommGroupOfComm hcomm
  have key : ∀ x ∈ Subgroup.closure ({a, b} : Set G), x ^ p = 1 := by
    intro x hx
    induction hx using Subgroup.closure_induction with
    | mem x hx => rcases hx with rfl | rfl <;> assumption
    | one => exact one_pow p
    | mul x y hx hy ihx ihy =>
      have hc : Commute x y := by
        have := mul_comm (⟨x, hx⟩ : Subgroup.closure ({a, b} : Set G)) ⟨y, hy⟩
        exact congrArg Subtype.val this
      rw [hc.mul_pow, ihx, ihy, one_mul]
    | inv x hx ih => rw [inv_pow, ih, inv_one]
  intro g
  exact ⟨1, Subtype.ext (by rw [pow_one]; exact key g g.2)⟩

theorem pair_of_sylowSetup
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p : ℕ} [Fact p.Prime]
    (S : LangSetup τ L p) {C : Type} [Group C] [Finite C] (e : C ≃* S.Γ)
    (hsyl : ∃ S₀ : Sylow p S.Γ, (S₀ : Subgroup S.Γ) ≤ S.D.torus.subgroupOf S.Γ) {a b : C}
    (ha : a ^ p = 1) (hb : b ^ p = 1) (hab : a * b = b * a) :
    ∃ e' : C ≃* S.Γ, ((e' a : ModGL τ L) ∈ S.D.torus) ∧ ((e' b : ModGL τ L) ∈ S.D.torus) := by
  obtain ⟨S₀, hS₀⟩ := hsyl
  haveI : Finite S.Γ := Finite.of_equiv C e.toEquiv
  have hP := (isPGroup_closure_pair ha hb hab).map e.toMonoidHom
  obtain ⟨P, hP'⟩ := hP.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq S.Γ P S₀
  have mem : ∀ x : C, x ∈ Subgroup.closure ({a, b} : Set C) →
      ((MulAut.conj g (e x) : S.Γ) : ModGL τ L) ∈ S.D.torus := by
    intro x hx
    have h1 : e x ∈ (P : Subgroup S.Γ) := hP' ⟨x, hx, rfl⟩
    have h2 : MulAut.conj g (e x) ∈ ((g • P : Sylow p S.Γ) : Subgroup S.Γ) := by
      rw [Sylow.coe_subgroup_smul]
      exact Subgroup.smul_mem_pointwise_smul _ _ _ h1
    rw [hg] at h2
    exact Subgroup.mem_subgroupOf.1 (hS₀ h2)
  exact ⟨e.trans (MulAut.conj g), mem a (Subgroup.subset_closure (by simp)),
    mem b (Subgroup.subset_closure (by simp))⟩

@[expose] def LangPairAt
    (τ : Tag) (K : Type) [Field K] [Finite K] (p : ℕ)
    (a b : adjointGroup τ K) : Prop :=
  ∃ (L : Type) (_ : Field L) (_ : IsAlgClosed L) (S : LangSetup τ L p)
    (ι : ↥(adjointGroup τ K) →* ModGL τ L),
    S.D.q = Nat.card K ∧ S.IsAlgebraic ∧ (∃ Fr : L →+* L, (∀ c, Fr c = c ^ S.D.q) ∧
      S.D.Φ = Units.map (entrywiseHom Fr)) ∧
    Function.Injective ι ∧ ι.range = S.Γ ∧ ι a ∈ S.D.torus ∧ ι b ∈ S.D.torus

theorem langPairAt_of_sylowSetup
    {τ : Tag} (h6 : τ ≠ .E6) (hD4 : τ ≠ .D4) {K : Type} [Field K]
    [Finite K] {p : ℕ} [Fact p.Prime] (hS : SylowSetup τ K p) {a b : adjointGroup τ K}
    (ha : a ^ p = 1) (hb : b ^ p = 1) (hab : a * b = b * a) : LangPairAt τ K p a b := by
  obtain ⟨L, _, _, S, hq, hAlg, hsyl, ⟨e⟩⟩ := hS
  obtain ⟨e', hea, heb⟩ := pair_of_sylowSetup S e hsyl ha hb hab
  refine ⟨L, inferInstance, inferInstance, S, S.Γ.subtype.comp e'.toMonoidHom, hq, hAlg,
    S.exists_frobenius_of_steinberg h6 hD4,
    (Subgroup.subtype_injective _).comp e'.injective, ?_, hea, heb⟩
  rw [MonoidHom.range_comp, MonoidHom.range_eq_top_of_surjective _ e'.surjective,
    ← MonoidHom.range_eq_map, Subgroup.range_subtype]

private theorem pow_eq_one_of_mem_closure_pair {G : Type*} [Group G] {p : ℕ} {a b : G} (ha : a ^ p = 1)
    (hb : b ^ p = 1) (hab : a * b = b * a) :
    ∀ x ∈ Subgroup.closure ({a, b} : Set G), x ^ p = 1 := by
  have hcomm : ({a, b} : Set G).Pairwise Commute := by
    intro x hx y hy _
    rcases hx with rfl | rfl <;> rcases hy with rfl | rfl
    · exact Commute.refl _
    · exact hab
    · exact hab.symm
    · exact Commute.refl _
  letI := Subgroup.closureCommGroupOfComm hcomm
  intro x hx
  induction hx using Subgroup.closure_induction with
  | mem x hx => rcases hx with rfl | rfl <;> assumption
  | one => exact one_pow p
  | mul x y hx hy ihx ihy =>
    have hc : Commute x y := by
      have := mul_comm (⟨x, hx⟩ : Subgroup.closure ({a, b} : Set G)) ⟨y, hy⟩
      exact congrArg Subtype.val this
    rw [hc.mul_pow, ihx, ihy, one_mul]
  | inv x hx ih => rw [inv_pow, ih, inv_one]

theorem langPairAt_of_datum
    {τ : Tag} (d : ℕ) (hτ : (τ = .E7 ∧ d = 2) ∨ (τ = .E8 ∧ d = 1))
    {K : Type} [Field K] [Finite K] {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p)
    (hpK : ¬ p ∣ Nat.card K) (hperf : commutator ↥(adjointGroup τ K) = ⊤)
    {Fr : AlgebraicClosure K →+* AlgebraicClosure K} (hFr : ∀ c, Fr c = c ^ Nat.card K)
    (D : LangDatum τ (AlgebraicClosure K)) (hΦ : D.Φ = Units.map (entrywiseHom Fr))
    (hDq : D.q = Nat.card K) (c : adjointGroup τ K) {a b : adjointGroup τ K}
    (hx : ∀ x ∈ ({a, b} : Set (adjointGroup τ K)),
      baseChangeGL (algebraMap K (AlgebraicClosure K))
        ((c * x * c⁻¹ : adjointGroup τ K) : ModGL τ K) ∈
        D.torus.map (MulAut.conj D.g0).toMonoidHom) :
    LangPairAt τ K p a b := by
  classical
  haveI : Fintype K := Fintype.ofFinite K
  obtain ⟨f, hℓ, hf⟩ := FiniteField.card K (ringChar K)
  haveI : Fact (ringChar K).Prime := ⟨hℓ⟩
  haveI : CharP K (ringChar K) := ringChar.charP K
  haveI : CharP (AlgebraicClosure K) (ringChar K) :=
    charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective _
  have hqK : Nat.card K = ringChar K ^ (f : ℕ) := by rw [Nat.card_eq_fintype_card]; exact hf
  have hτ' : (τ = .E6 ∧ d = 3) ∨ (τ = .E7 ∧ d = 2) ∨ (τ = .E8 ∧ d = 1) := Or.inr hτ
  have hd := langDescent_untw (K := K) (L := AlgebraicClosure K) d hτ' hFr D hΦ hp (by omega)
    hperf
  set ι₁ : ↥(adjointGroup τ K) →* ModGL τ (AlgebraicClosure K) :=
    (baseChangeGL (algebraMap K (AlgebraicClosure K))).comp (adjointGroup τ K).subtype with hι₁
  set ι₀ : ↥(adjointGroup τ K) →* ModGL τ (AlgebraicClosure K) :=
    ι₁.comp (MulAut.conj c).toMonoidHom with hι₀def
  have hι₀ : Function.Injective ι₀ :=
    ((baseChangeGL_injective _).comp (Subgroup.subtype_injective _)).comp
      (MulAut.conj c).injective
  have hrange : ι₀.range = ι₁.range := by
    rw [hι₀def, MonoidHom.range_comp,
      MonoidHom.range_eq_top_of_surjective _ (MulAut.conj c).surjective,
      ← MonoidHom.range_eq_map]
  have hpℓ : p ≠ ringChar K := fun h => hpK (by rw [hqK, h]; exact dvd_pow_self _ f.ne_zero)
  obtain ⟨S, ι, hSD, hι, hinj, hιr, hu⟩ := exists_langSetup_of_toral_datum_uniform hℓ f.pos D
    (hDq.trans hqK) hp hpℓ (Or.inl hp5) hd.finite_model ι₀ hι₀ (by rw [hd.Γ_eq, hrange])
  have hmem : ∀ x ∈ ({a, b} : Set (adjointGroup τ K)), ι x ∈ S.D.torus := by
    intro x hxab
    obtain ⟨a', ha', ha'eq, -⟩ := hu _ (hx x hxab)
    have h0 : ι₀ x = baseChangeGL (algebraMap K (AlgebraicClosure K))
        ((c * x * c⁻¹ : adjointGroup τ K) : ModGL τ K) := rfl
    rw [hι, h0, ← ha'eq]
    exact ha'
  refine ⟨AlgebraicClosure K, inferInstance, inferInstance, S, ι, by rw [hSD, hDq],
    S.isAlgebraic_of_algebraic K 1 (by rw [pow_one, hSD, hDq]),
    ⟨Fr, by rw [hSD, hDq]; exact hFr, by rw [hSD, hΦ]⟩, hinj, hιr, hmem a (by simp),
    hmem b (by simp)⟩

theorem langPairAt_E8_five
    {K : Type} [Field K] [Finite K] (hpK : ¬ 5 ∣ Nat.card K)
    {a b : adjointGroup Tag.E8 K} (ha : a ^ 5 = 1) (hb : b ^ 5 = 1) (hab : a * b = b * a) :
    LangPairAt Tag.E8 K 5 a b := by
  classical
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  have hperf : commutator ↥(adjointGroup Tag.E8 K) = ⊤ :=
    (CFSG.LieType.Steinberg.Adjoint.isQuasisimple_e8 K).1.commutator_eq_top
  set A : Subgroup (adjointGroup Tag.E8 K) := Subgroup.closure {a, b} with hAdef
  have hexpA := pow_eq_one_of_mem_closure_pair ha hb hab
  have haA : a ∈ A := Subgroup.subset_closure (by simp)
  have hbA : b ∈ A := Subgroup.subset_closure (by simp)
  have hle : A ≤ Subgroup.zpowers a ⊔ Subgroup.zpowers b := by
    rw [hAdef, Subgroup.closure_le]
    rintro x (rfl | rfl)
    · exact Subgroup.mem_sup_left (Subgroup.mem_zpowers _)
    · exact Subgroup.mem_sup_right (Subgroup.mem_zpowers _)
  have hnorm : Subgroup.zpowers a ≤ Subgroup.normalizer (Subgroup.zpowers b : Set _) := by
    refine le_trans ?_ (Subgroup.centralizer_le_normalizer _)
    rw [Subgroup.zpowers_le]
    rw [Subgroup.mem_centralizer_iff]
    intro h hh
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hh
    exact ((Commute.zpow_left (show Commute b a from hab.symm) k)).eq
  have hsup : Nat.card (Subgroup.zpowers a ⊔ Subgroup.zpowers b :
      Subgroup (adjointGroup Tag.E8 K)) ≤ Nat.card (Subgroup.zpowers a) *
        Nat.card (Subgroup.zpowers b) := by
    have := Subgroup.normal_subgroupOf_of_le_normalizer hnorm
    have := Subgroup.normal_subgroupOf_sup_of_le_normalizer hnorm
    have e := QuotientGroup.quotientInfEquivProdNormalizerQuotient _ _ hnorm
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup
        ((Subgroup.zpowers b).subgroupOf (Subgroup.zpowers a ⊔ Subgroup.zpowers b)),
      ← Nat.card_congr e.toEquiv,
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe
        (le_sup_right : Subgroup.zpowers b ≤ _)).toEquiv]
    exact Nat.mul_le_mul_right _ (Nat.le_of_dvd Nat.card_pos (Subgroup.card_quotient_dvd_card _))
  have hza : Nat.card (Subgroup.zpowers a) ≤ 5 := by
    rw [Nat.card_zpowers]; exact orderOf_le_of_pow_eq_one (by norm_num) ha
  have hzb : Nat.card (Subgroup.zpowers b) ≤ 5 := by
    rw [Nat.card_zpowers]; exact orderOf_le_of_pow_eq_one (by norm_num) hb
  have hcard : Nat.card A ≤ 25 :=
    (Subgroup.card_le_of_le hle).trans (hsup.trans (by nlinarith))
  have hP : IsPGroup 5 A := isPGroup_closure_pair ha hb hab
  obtain ⟨k, hk⟩ := (IsPGroup.iff_card).1 hP
  have hk2 : k ≤ 2 := by
    by_contra h
    have : 5 ^ 3 ≤ 5 ^ k := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  by_cases h2 : k = 2
  ·
    obtain ⟨w, Fr, hFr, g0, hg0C, hg0, c, hc⟩ :=
      e8FiveToralPlane_proved K hpK A hexpA (by rw [hk, h2])
    exact langPairAt_of_datum 1 (Or.inr ⟨rfl, rfl⟩) Nat.prime_five le_rfl hpK hperf hFr
      (LangDatum.ofFrobenius Fr (Nat.card K) hFr w hg0C hg0) rfl rfl c
      (fun x hx => hc x (by rcases hx with rfl | rfl <;> assumption))
  ·
    have hcyc : IsCyclic A := by
      rcases (show k = 0 ∨ k = 1 by omega) with rfl | rfl
      · rw [pow_zero] at hk
        haveI : Subsingleton A := (Nat.card_eq_one_iff_unique.1 hk).1
        infer_instance
      · rw [pow_one] at hk
        exact isCyclic_of_prime_card hk
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := A)
    set x : adjointGroup Tag.E8 K := (g : adjointGroup Tag.E8 K) with hxdef
    have hx5 : x ^ 5 = 1 := hexpA x g.2
    have hzp : ∀ y ∈ A, y ∈ Subgroup.zpowers x := by
      intro y hy
      obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.1 (hg ⟨y, hy⟩)
      exact Subgroup.mem_zpowers_iff.2 ⟨n, by
        rw [hxdef, ← Subgroup.coe_zpow, hn]⟩
    haveI : Fintype K := Fintype.ofFinite K
    obtain ⟨f, hℓ, hf⟩ := FiniteField.card K (ringChar K)
    haveI : Fact (ringChar K).Prime := ⟨hℓ⟩
    haveI : CharP K (ringChar K) := ringChar.charP K
    set ℓ := ringChar K with hℓdef
    have hqK : Nat.card K = ℓ ^ (f : ℕ) := by rw [Nat.card_eq_fintype_card]; exact hf
    set L := AlgebraicClosure K with hLdef
    haveI : CharP L ℓ := charP_of_injective_algebraMap (algebraMap K L).injective _
    have hFrL : ∀ c : L, iterateFrobenius L ℓ (f : ℕ) c = c ^ Nat.card K := fun c => by
      rw [hqK]; exact iterateFrobenius_def ℓ (f : ℕ) c
    have hℓp : ℓ ≠ 5 := fun h => hpK (by rw [hqK, h]; exact dvd_pow_self 5 f.ne_zero)
    have hpq : Nat.Coprime 5 (ℓ ^ (f : ℕ)) :=
      (Nat.Prime.coprime_iff_not_dvd Nat.prime_five).2 (hqK ▸ hpK)
    set u : ModGL Tag.E8 L := baseChangeGL (algebraMap K L) (x : ModGL Tag.E8 K) with hu
    have huC : u ∈ adjointGroup Tag.E8 L := CFSG.LieType.Chevalley.baseChangeGL_mem_adjointGroup _ x.2
    have hu5 : u ^ 5 = 1 := by
      rw [hu, ← map_pow, ← Subgroup.coe_pow, hx5]
      exact map_one _
    have hFix : entrywiseFrobGL Tag.E8 L ℓ (f : ℕ) u = u :=
      units_map_entrywiseHom_baseChangeGL_algebraMap (iterateFrobenius L ℓ (f : ℕ)) hFrL _
    have hmon : MonomialToralAt Tag.E8 5 :=
      monomialToralAt_five_of_chainBlock (fun _ hγ => iform_self_E8 hγ) chainBlockToral_E8_four
    have hconj := exists_conj_torusGroup_of_pow_eq_one Nat.prime_five hmon hℓp
      (isAlgebraic_zmod_algebraicClosure_of_finite K ℓ) huC hu5
    obtain ⟨D, hΦ, hDq, hmem⟩ := exists_langDatum_of_toral_untw (f : ℕ) f.pos hpq hu5 hFix hconj
    refine langPairAt_of_datum 1 (Or.inr ⟨rfl, rfl⟩) Nat.prime_five le_rfl hpK hperf hFrL D hΦ
      (hDq.trans hqK.symm) 1 (fun y hy => ?_)
    have hyA : y ∈ A := by rcases hy with rfl | rfl <;> assumption
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 (hzp y hyA)
    have : baseChangeGL (algebraMap K L)
        ((1 * x ^ n * 1⁻¹ : adjointGroup Tag.E8 K) : ModGL Tag.E8 K) = u ^ n := by
      rw [one_mul, inv_one, mul_one, Subgroup.coe_zpow, map_zpow]
    rw [this]
    exact zpow_mem hmem n

private theorem exists_dvd_of_dvd_prod {p q N : ℕ} (hp : p.Prime) (hpq : ¬ p ∣ q) (ds : List ℕ)
    (h : p ∣ q ^ N * (ds.map fun d => q ^ d - 1).prod) :
    ∃ d ∈ ds, orderOf (q : ZMod p) ∣ d := by
  haveI : Fact p.Prime := ⟨hp⟩
  rcases (Nat.Prime.dvd_mul hp).1 h with h1 | h1
  · exact absurd (hp.dvd_of_dvd_pow h1) hpq
  · obtain ⟨x, hx, hpx⟩ := (Prime.dvd_prod_iff hp.prime).1 h1
    obtain ⟨d, hd, rfl⟩ := List.mem_map.1 hx
    refine ⟨d, hd, orderOf_dvd_of_pow_eq_one ?_⟩
    have hq0 : 0 < q := Nat.pos_of_ne_zero fun h0 => hpq (h0 ▸ dvd_zero p)
    have hq1 : 1 ≤ q ^ d := Nat.one_le_pow _ _ hq0
    have h0 := (ZMod.natCast_eq_zero_iff (q ^ d - 1) p).2 hpx
    rw [Nat.cast_sub hq1, Nat.cast_pow, Nat.cast_one, sub_eq_zero] at h0
    exact h0

private theorem five_le_of_not_dvd {p q : ℕ} (hp : p.Prime) (hpq : ¬ p ∣ q) (h1 : ¬ p ∣ q - 1)
    (h2 : ¬ p ∣ q + 1) : 5 ≤ p := by
  have h2le := hp.two_le
  by_contra h
  interval_cases p
  · omega
  · omega
  · norm_num at hp

private theorem orderOf_ne_one_two {p q : ℕ} (hp : p.Prime) (hq : 1 ≤ q) (h1 : ¬ p ∣ q - 1)
    (h2 : ¬ p ∣ q + 1) : orderOf (q : ZMod p) ≠ 1 ∧ orderOf (q : ZMod p) ≠ 2 := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hn1 : (q : ZMod p) ≠ 1 := fun h => h1 ((ZMod.natCast_eq_zero_iff _ p).1 (by
    rw [Nat.cast_sub hq, Nat.cast_one, h, sub_self]))
  refine ⟨fun h => hn1 (orderOf_eq_one_iff.1 h), fun h => ?_⟩
  have hsq : (q : ZMod p) * (q : ZMod p) = 1 := by
    rw [← sq, ← h, pow_orderOf_eq_one]
  rcases mul_self_eq_one_iff.1 hsq with h' | h'
  · exact hn1 h'
  · exact h2 ((ZMod.natCast_eq_zero_iff _ p).1 (by
      rw [Nat.cast_add, Nat.cast_one, h', neg_add_cancel]))

open CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.KD291OL in
theorem langPairAt_E7
    {K : Type} [Field K] [Finite K] {p : ℕ} (hp : p.Prime)
    (hpK : ¬ p ∣ Nat.card K) (hq1 : ¬ p ∣ Nat.card K - 1) (hq2 : ¬ p ∣ Nat.card K + 1)
    {a b : adjointGroup Tag.E7 K} (ha : a ^ p = 1) (hb : b ^ p = 1) (hab : a * b = b * a)
    (ha1 : a ≠ 1) : LangPairAt Tag.E7 K p a b := by
