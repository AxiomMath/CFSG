  · exact langPairAt_E8_five hpK ha hb hab
  have hpC : p ∣ Nat.card (adjointGroup Tag.E8 K) :=
    orderOf_eq_prime ha ha1 ▸ orderOf_dvd_natCard a
  obtain ⟨d, hd, hed⟩ := exists_dvd_of_dvd_prod hp hpK _ (hpC.trans (card_adjointGroup_E8_dvd K))
  obtain ⟨he1, he2⟩ := orderOf_ne_one_two hp Nat.card_pos hq1 hq2
  have hex : ∃ d ∈ [30, 24, 20, 18, 14, 12, 8, 2], orderOf ((Nat.card K : ℕ) : ZMod p) ∣ d :=
    ⟨d, hd, hed⟩
  have hle : orderOf ((Nat.card K : ℕ) : ZMod p) ≤ 30 := by
    obtain ⟨d, hd, hed⟩ := hex
    have : 0 < d ∧ d ≤ 30 := by simp at hd; omega
    exact (Nat.le_of_dvd this.1 hed).trans this.2
  have pair := fun (hS : SylowSetup .E8 K p) =>
    langPairAt_of_sylowSetup (by decide) (by decide) hS ha hb hab
  generalize he : orderOf ((Nat.card K : ℕ) : ZMod p) = e at *
  interval_cases e
  all_goals first
    | exact absurd he1 (by decide) | exact absurd he2 (by decide)
    | exact absurd hex (by decide)
    | exact pair (sylowSetup_E8 K hp hp5 hpK he (fun _ => hp7) (by decide))
    | exact absurd (orderOf_natCast_ne_zero hp hpK) (by rw [he]; decide)

end CFSG.StandardType.LangPair
