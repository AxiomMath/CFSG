    orderOf_eq_prime ha ha1 ▸ orderOf_dvd_natCard a
  obtain ⟨d, hd, hed⟩ := exists_dvd_of_dvd_prod hp hpK _ (hpC.trans (card_adjointGroup_E7_dvd K))
  obtain ⟨he1, he2⟩ := orderOf_ne_one_two hp Nat.card_pos hq1 hq2
  have hex : ∃ d ∈ [18, 14, 12, 10, 8, 6, 2], orderOf ((Nat.card K : ℕ) : ZMod p) ∣ d :=
    ⟨d, hd, hed⟩
  have hle : orderOf ((Nat.card K : ℕ) : ZMod p) ≤ 18 := by
    obtain ⟨d, hd, hed⟩ := hex
    have : 0 < d ∧ d ≤ 18 := by simp at hd; omega
    exact (Nat.le_of_dvd this.1 hed).trans this.2
  have pair := fun (hS : SylowSetup .E7 K p) =>
    langPairAt_of_sylowSetup (by decide) (by decide) hS ha hb hab
  generalize he : orderOf ((Nat.card K : ℕ) : ZMod p) = e at *
  interval_cases e
  all_goals first
    | exact absurd he1 (by decide) | exact absurd he2 (by decide)
    | exact absurd hex (by decide)
    | exact pair (sylowSetup_E7 K hp hp5 hpK he (by decide))
    | exact absurd (orderOf_natCast_ne_zero hp hpK) (by rw [he]; decide)

open CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.KD291OL in
theorem langPairAt_E8
    {K : Type} [Field K] [Finite K] {p : ℕ} (hp : p.Prime)
    (hpK : ¬ p ∣ Nat.card K) (hq1 : ¬ p ∣ Nat.card K - 1) (hq2 : ¬ p ∣ Nat.card K + 1)
    {a b : adjointGroup Tag.E8 K} (ha : a ^ p = 1) (hb : b ^ p = 1) (hab : a * b = b * a)
    (ha1 : a ≠ 1) : LangPairAt Tag.E8 K p a b := by
