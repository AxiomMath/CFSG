private theorem q_pow_mod_three_aux_neg
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ} (S : LangSetup τ L p₀)
    {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus)
    (i : KernelComponent (rootCharHom a)) {s : ℕ} {w : WeylGroup τ}
    (hw : w ∈ Subgroup.closure
      {r : WeylGroup τ | ∃ γ ∈ componentRoots (rootCharHom a) i, r = rootReflection γ})
    (hneg : ∀ γ ∈ componentRoots (rootCharHom a) i,
      (S.ρ : (Fin τ.rank → ℤ) → (Fin τ.rank → ℤ))^[s] γ = -(w • γ))
    {γ₁ γ₂ : Fin τ.rank → ℤ} (hm₁ : γ₁ ∈ componentRoots (rootCharHom a) i)
    (hm₂ : γ₂ ∈ componentRoots (rootCharHom a) i)
    {ω : Lˣ} (hord : orderOf ω = 3) {x : Fin τ.rank → ℤ}
    (hχ : ∀ v, rootChar a v = ω ^ (x ⬝ᵥ v)) {c₁ c₂ : ℤ}
    (hdot : ∀ v, x ⬝ᵥ v = c₁ * corootPair γ₁ v + c₂ * corootPair γ₂ v)
    (j : Fin τ.rank) (hj : ¬ (3 : ℤ) ∣ x j) :
    (S.D.q ^ s) % 3 = 2 := by
  classical
  have hΨ3 : ∀ γ ∈ componentRoots (rootCharHom a) i, IsRoot τ γ ∧ (3 : ℤ) ∣ x ⬝ᵥ γ := by
    intro γ hγ
    obtain ⟨hk, -⟩ := hγ
    refine ⟨hk.1, ?_⟩
    have h1 : rootChar a γ = 1 := hk.2
    rw [hχ] at h1
    have h2 := orderOf_dvd_iff_zpow_eq_one.2 h1
    rw [hord] at h2
    exact_mod_cast h2
  have hcop : ∀ γ ∈ componentRoots (rootCharHom a) i, ∀ v : Fin τ.rank → ℤ,
      corootPair γ (w⁻¹ • (S.ρ : (Fin τ.rank → ℤ) → _)^[s] v) = -corootPair γ v := by
    intro γ hγm v
    have hk : IsRoot τ γ := (hΨ3 γ hγm).1
    have h1 : w⁻¹ • (S.ρ : (Fin τ.rank → ℤ) → _)^[s] γ = -γ := by
      rw [hneg γ hγm, smul_neg, inv_smul_smul]
    have h2 : iform γ (w⁻¹ • (S.ρ : (Fin τ.rank → ℤ) → _)^[s] v) = -iform γ v := by
      have hsmul : iform (w⁻¹ • (S.ρ : (Fin τ.rank → ℤ) → _)^[s] γ)
          (w⁻¹ • (S.ρ : (Fin τ.rank → ℤ) → _)^[s] v) = iform γ v := by
        rw [iform_smul, Up34Exc.InnExcCong.iform_iterate S s γ v]
      rw [h1] at hsmul
      have hnegif : iform (-γ) (w⁻¹ • (S.ρ : (Fin τ.rank → ℤ) → _)^[s] v) =
          -iform γ (w⁻¹ • (S.ρ : (Fin τ.rank → ℤ) → _)^[s] v) := by
        rw [← neg_one_smul ℤ γ, iform_smul_left, neg_one_mul]
      rw [hnegif] at hsmul
      linarith
    have h3 : corootPair γ (w⁻¹ • (S.ρ : (Fin τ.rank → ℤ) → _)^[s] v) * iform γ γ =
        (-corootPair γ v) * iform γ γ := by
      simp only [neg_mul, corootPair_mul hk, h2]
      ring
    exact mul_right_cancel₀ (ne_of_gt (iform_self_pos_of_isRoot hk)) h3
  have hu : ∀ v : Fin τ.rank → ℤ,
      x ⬝ᵥ (w⁻¹ • (S.ρ : (Fin τ.rank → ℤ) → _)^[s] v) = -(x ⬝ᵥ v) := by
    intro v
    rw [hdot, hdot, hcop γ₁ hm₁, hcop γ₂ hm₂]
    ring
  have hδ : IsRoot τ (Pi.single j 1 : Fin τ.rank → ℤ) := isRoot_single τ j
  have hxδ : x ⬝ᵥ (Pi.single j 1 : Fin τ.rank → ℤ) = x j := dotProduct_single_one x j
  have hA := Up34Exc.InnExcCong.three_dvd_dot_smul hΨ3 hw
    (w⁻¹ • (S.ρ : (Fin τ.rank → ℤ) → _)^[s] (Pi.single j 1 : Fin τ.rank → ℤ))
  rw [smul_inv_smul, hu] at hA
  have hB := Up34Exc.InnExcCong.three_dvd_dot_iterate S hT hord hχ s hδ
  have hC : (3 : ℤ) ∣ ((S.D.q : ℤ) ^ s + 1) * x j := by
    have h := dvd_sub hA hB
    rw [hxδ] at h
    have e : x ⬝ᵥ (S.ρ : (Fin τ.rank → ℤ) → _)^[s] (Pi.single j 1 : Fin τ.rank → ℤ) -
          -(x j) -
        (x ⬝ᵥ (S.ρ : (Fin τ.rank → ℤ) → _)^[s] (Pi.single j 1 : Fin τ.rank → ℤ) -
          (S.D.q : ℤ) ^ s * x j) = ((S.D.q : ℤ) ^ s + 1) * x j := by ring
    rwa [e] at h
  have hq : (3 : ℤ) ∣ (S.D.q : ℤ) ^ s + 1 := (Int.prime_three.dvd_or_dvd hC).resolve_right hj
  have hq' : (3 : ℤ) ∣ ((S.D.q ^ s : ℕ) : ℤ) + 1 := by
    push_cast
    exact hq
  generalize S.D.q ^ s = N at hq'
  omega

theorem q_pow_mod_three_of_neg_a2
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ} (S : LangSetup τ L p₀)
    {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus)
    (i : KernelComponent (rootCharHom a)) {s : ℕ} {w : WeylGroup τ}
    (hw : w ∈ Subgroup.closure
      {r : WeylGroup τ | ∃ γ ∈ componentRoots (rootCharHom a) i, r = rootReflection γ})
    (hneg : ∀ γ ∈ componentRoots (rootCharHom a) i,
      (S.ρ : (Fin τ.rank → ℤ) → (Fin τ.rank → ℤ))^[s] γ = -(w • γ))
    {γ₁ γ₂ : Fin τ.rank → ℤ} (hP : Up34Exc.IsA2Pair τ γ₁ γ₂)
    (hΨ : componentRoots (rootCharHom a) i = {γ₁, γ₂, γ₁ + γ₂, -γ₁, -γ₂, -(γ₁ + γ₂)})
    {ω : Lˣ} (hω3 : ω ^ 3 = 1) (hω1 : ω ≠ 1) {ε : ℤ} (hε : ε = 1 ∨ ε = -1)
    (hglue : ∀ j, a j = ω ^ (ε * Up34Exc.a2Exp τ γ₁ γ₂ j)) (ha1 : ∃ j, a j ≠ 1) :
    (S.D.q ^ s) % 3 = 2 := by
  obtain ⟨hγ₁, hγ₂, -, -⟩ := hP
  have hord : orderOf ω = 3 := orderOf_eq_prime hω3 hω1
  have hχ : ∀ v, rootChar a v = ω ^ ((fun j => ε * Up34Exc.a2Exp τ γ₁ γ₂ j) ⬝ᵥ v) := fun v => by
    have ha : a = fun k => ω ^ (ε * Up34Exc.a2Exp τ γ₁ γ₂ k) := funext hglue
    rw [ha]
    exact Up34Exc.InnExcCong.rootChar_zpow_dot ω (fun j => ε * Up34Exc.a2Exp τ γ₁ γ₂ j) v
  obtain ⟨j, hj⟩ := ha1
  have hj3 : ¬ (3 : ℤ) ∣ ε * Up34Exc.a2Exp τ γ₁ γ₂ j := by
    intro h3
    apply hj
    have h1 : ω ^ (ε * Up34Exc.a2Exp τ γ₁ γ₂ j) = 1 := by
      rw [← orderOf_dvd_iff_zpow_eq_one, hord]
      exact_mod_cast h3
    rw [hglue j]
    exact h1
  have hm₁ : γ₁ ∈ componentRoots (rootCharHom a) i := by rw [hΨ]; simp
  have hm₂ : γ₂ ∈ componentRoots (rootCharHom a) i := by rw [hΨ]; simp
  refine q_pow_mod_three_aux_neg S hT i hw hneg hm₁ hm₂ hord hχ (c₁ := ε) (c₂ := 2 * ε)
    (fun v => ?_) j hj3
  rw [Up34Exc.InnExcCong.dot_a2Exp hγ₁ hγ₂ ε v]
  ring

