private theorem rootO2E6_map_castHom_injective :
    Function.Injective
      (Matrix.SpecialLinearGroup.map (n := Fin 6) (ZMod.castHom (dvd_refl 2) F2)) := by
  intro A B h
  ext i j
  have h1 : (ZMod.castHom (dvd_refl 2) F2) (A i j) = (ZMod.castHom (dvd_refl 2) F2) (B i j) := by
    have h2 := congrArg (fun M : Matrix.SpecialLinearGroup (Fin 6) F2 =>
      ((M : Matrix (Fin 6) (Fin 6) F2) i j)) h
    simpa using h2
  exact ZMod.castHom_injective (R := F2) h1

private theorem rootO2E6_map_castHom_surjective :
    Function.Surjective
      (Matrix.SpecialLinearGroup.map (n := Fin 6) (ZMod.castHom (dvd_refl 2) F2)) := by
  intro A
  have hcard : Nat.card F2 = 2 := by
    rw [GaloisField.card 2 1 (by norm_num), pow_one]
  haveI : Fintype F2 := Fintype.ofFinite F2
  let ε : F2 ≃+* ZMod 2 :=
    FiniteField.ringEquivOfCardEq (by rw [← Nat.card_eq_fintype_card, hcard, ZMod.card])
  have hφ : ZMod.castHom (dvd_refl 2) F2 = ε.symm.toRingHom := RingHom.ext_zmod _ _
  refine ⟨Matrix.SpecialLinearGroup.map ε.toRingHom A, ?_⟩
  apply Subtype.ext
  ext i j
  rw [Matrix.SpecialLinearGroup.map_apply_coe, Matrix.SpecialLinearGroup.map_apply_coe,
    RingHom.mapMatrix_apply, RingHom.mapMatrix_apply, hφ]
  exact ε.symm_apply_apply (A i j)

private def rootO2E6_word : List (Fin (Tag.rank .E6)) := [3, 1, 4, 3, 2, 5, 4, 3, 1]

private theorem rootO2E6_wordProd_smul (l : List (Fin (Tag.rank .E6)))
    (v : Fin (Tag.rank .E6) → ℤ) :
    (coxeterSystem .E6).wordProd l • v = l.foldr (reflect .E6) v := by
  induction l with
  | nil => rw [CoxeterSystem.wordProd_nil, one_smul, List.foldr_nil]
  | cons i l ih => rw [CoxeterSystem.wordProd_cons, mul_smul, ih, simple_smul, List.foldr_cons]

private theorem rootO2E6_word_smul_highRoot :
    (coxeterSystem .E6).wordProd rootO2E6_word • highRoot .E6 = a5Root 0 2 := by
  rw [rootO2E6_wordProd_smul]
  decide +kernel

private theorem rootO2E6_word_smul_a5Root :
    (coxeterSystem .E6).wordProd rootO2E6_word • a5Root 0 5 = highRoot .E6 := by
  rw [rootO2E6_wordProd_smul]
  decide +kernel

private theorem rootO2E6_neg_a5Root : -a5Root 0 2 = a5Root 2 0 := by
  decide +kernel

private theorem rootO2E6_inv_smul_highRoot :
    ((coxeterSystem .E6).wordProd rootO2E6_word)⁻¹ • highRoot .E6 = a5Root 0 5 := by
  rw [← rootO2E6_word_smul_a5Root, ← mul_smul, inv_mul_cancel, one_smul]

section Model

theorem pCoreOf_centralizer_xr_highRoot :
    pCoreOf 2 (Subgroup.centralizer ({xr (highRoot .E6)} : Set EC)) =
      EPilot.highRadical .E6 F2 := by
  have h := (KGExc.centralizer_decomp_highRoot (K := F2) (Or.inl rfl)
    (show CFSG.IsQuasisimple (EPilot.perpLevi .E6 F2) from E6Pilot.isQuasisimple_a5Levi)
    (show Subgroup.center (EPilot.perpLevi .E6 F2) = ⊥ from E6Pilot.center_a5Levi_eq_bot)).2.2.2
  simpa only [xr] using h

theorem eq_zpowers_or_eq_highRadical_of_le {V : Subgroup EC}
    (h1 : Subgroup.zpowers (xr (highRoot .E6)) ≤ V) (h2 : V ≤ EPilot.highRadical .E6 F2)
    (hN : lE ≤ Subgroup.normalizer (V : Set EC)) :
    V = Subgroup.zpowers (xr (highRoot .E6)) ∨ V = EPilot.highRadical .E6 F2 := by
  have hK : Nat.card F2 = 2 := by
    rw [GaloisField.card 2 1 (by norm_num), pow_one]
  exact EPilot.HeisIrr.eq_zpowers_or_eq_highRadical (τ := .E6) (K := F2)
    (hτ := Or.inl rfl) (hnode := rfl) (hK := hK) h1 h2 hN

@[expose] noncomputable def slSixToEC : Matrix.SpecialLinearGroup (Fin 6) (ZMod 2) →* EC :=
  (E6Pilot.slToAdjointE6 F2).comp
    (Matrix.SpecialLinearGroup.map (ZMod.castHom (dvd_refl 2) F2))

theorem injective_slSixToEC : Function.Injective slSixToEC := by
  have hK : Nat.card F2 = 2 := by
    rw [GaloisField.card 2 1 (by norm_num), pow_one]
  intro a b hab
  exact rootO2E6_map_castHom_injective
    (E6Pilot.injective_slToAdjointE6_two hK hab)

theorem range_slSixToEC : slSixToEC.range = lE := by
  rw [slSixToEC, MonoidHom.range_comp,
    MonoidHom.range_eq_top.mpr rootO2E6_map_castHom_surjective,
    ← MonoidHom.range_eq_map, E6Pilot.range_slToAdjointE6]
  rfl

theorem slSixToEC_transvection {i j : Fin 6} (hij : i ≠ j) :
    slSixToEC (Matrix.SpecialLinearGroup.transvection hij 1) = xr (a5Root i j) := by
  rw [slSixToEC, MonoidHom.comp_apply]
  have h : Matrix.SpecialLinearGroup.map (ZMod.castHom (dvd_refl 2) F2)
      (Matrix.SpecialLinearGroup.transvection hij (1 : ZMod 2)) =
      Matrix.SpecialLinearGroup.transvection hij (1 : F2) := by
    rw [Matrix.SpecialLinearGroup.map_transvection, map_one]
  rw [h]
  apply Subtype.ext
  rw [E6Pilot.coe_slToAdjointE6_transvection]
  rfl

private noncomputable def rootO2E6_g : EC :=
  ⟨E6GraphHighestRoot.wordElt F2 rootO2E6_word,
    E6GraphHighestRoot.wordElt_mem_adjointGroup rootO2E6_word⟩

private theorem rootO2E6_conj_xr {α : Fin (Tag.rank .E6) → ℤ} (hα : IsRoot .E6 α) :
    rootO2E6_g * xr α * rootO2E6_g⁻¹ =
      xr ((coxeterSystem .E6).wordProd rootO2E6_word • α) := by
  apply Subtype.ext
  have h := E6GraphHighestRoot.wordElt_conj_pinnedX (K := F2) gf2_two rootO2E6_word hα 1
  exact h

private theorem rootO2E6_conj_xr_inv {α : Fin (Tag.rank .E6) → ℤ} (hα : IsRoot .E6 α) :
    rootO2E6_g⁻¹ * xr α * rootO2E6_g =
      xr (((coxeterSystem .E6).wordProd rootO2E6_word)⁻¹ • α) := by
  have h := rootO2E6_conj_xr (IsRoot.smul hα ((coxeterSystem .E6).wordProd rootO2E6_word)⁻¹)
  rw [← mul_smul, mul_inv_cancel, one_smul] at h
  rw [← h]
  group

private noncomputable def rootO2E6_J : Subgroup EC :=
  (LinearPilot.blockSpecialLinear (K := ZMod 2) ({0, 1, 2} : Finset (Fin 6))).map slSixToEC

private theorem rootO2E6_J_le_lE : rootO2E6_J ≤ lE := by
  have h : (LinearPilot.blockSpecialLinear (K := ZMod 2) ({0, 1, 2} : Finset (Fin 6))).map
      slSixToEC ≤ slSixToEC.range :=
    Subgroup.map_le_range slSixToEC _
  rw [range_slSixToEC] at h
  exact h

private theorem rootO2E6_J_iso :
    Nonempty (↥rootO2E6_J ≃* Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)) := by
  have hI : ({0, 1, 2} : Finset (Fin 6)).card = 3 := by decide
  let e : ↥({0, 1, 2} : Finset (Fin 6)) ≃ Fin 3 :=
    (Finset.equivFin _).trans (finCongr hI)
  refine ⟨(Subgroup.equivMapOfInjective
    (LinearPilot.blockSpecialLinear (K := ZMod 2) ({0, 1, 2} : Finset (Fin 6)))
    slSixToEC injective_slSixToEC).symm.trans
    ((F4Pilot.blockSpecialLinearMulEquivSL (K := ZMod 2) _).trans
      (LinearPilot.reindexSpecialLinear (K := ZMod 2) e))⟩

private theorem rootO2E6_zE_mem_J : rootO2E6_g * zE * rootO2E6_g⁻¹ ∈ rootO2E6_J := by
  have hsplit : rootO2E6_g * zE * rootO2E6_g⁻¹ =
      (rootO2E6_g * xr (highRoot .E6) * rootO2E6_g⁻¹) *
        (rootO2E6_g * xr (-highRoot .E6) * rootO2E6_g⁻¹) := by
    rw [zE]
    group
  rw [hsplit, rootO2E6_conj_xr (isRoot_highRoot .E6),
    rootO2E6_conj_xr (IsRoot.neg (isRoot_highRoot .E6)), smul_neg,
    rootO2E6_word_smul_highRoot, rootO2E6_neg_a5Root]
  refine Subgroup.mul_mem _ ?_ ?_
  · rw [← slSixToEC_transvection (by decide : (0 : Fin 6) ≠ 2)]
    exact Subgroup.mem_map_of_mem _ (LinearPilot.transvection_mem_blockSpecialLinear
      (by decide : (0 : Fin 6) ≠ 2) (by decide) (by decide) (1 : ZMod 2))
  · rw [← slSixToEC_transvection (by decide : (2 : Fin 6) ≠ 0)]
    exact Subgroup.mem_map_of_mem _ (LinearPilot.transvection_mem_blockSpecialLinear
      (by decide : (2 : Fin 6) ≠ 0) (by decide) (by decide) (1 : ZMod 2))

theorem exists_conj_zE_mem_slThree_and_transvection :
    ∃ g : EC, ∃ J : Subgroup EC, J ≤ lE ∧
      Nonempty (↥J ≃* Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)) ∧ g * zE * g⁻¹ ∈ J ∧
      ∃ (i j : Fin 6) (hij : i ≠ j),
        g⁻¹ * xr (highRoot .E6) * g = slSixToEC (Matrix.SpecialLinearGroup.transvection hij 1) := by
  refine ⟨rootO2E6_g, rootO2E6_J, rootO2E6_J_le_lE, rootO2E6_J_iso, rootO2E6_zE_mem_J,
    0, 5, by decide, ?_⟩
  rw [rootO2E6_conj_xr_inv (isRoot_highRoot .E6), rootO2E6_inv_smul_highRoot]
  exact (slSixToEC_transvection (i := 0) (j := 5) (by decide)).symm

