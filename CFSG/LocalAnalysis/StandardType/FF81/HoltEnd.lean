private lemma commutator_eq_top_of_mulEquiv {G H : Type*} [Group G] [Group H]
    (e : G ≃* H) (h : commutator H = ⊤) : commutator G = ⊤ := by
  have : Group.IsPerfect H := Group.isPerfect_def.mpr h
  exact (Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective).commutator_eq_top

private lemma ylab_commutator_top
    {G : Type} [Group G] [Finite G] {n : ℕ} {Y : Subgroup G}
    (hY : YLab n Y) (hn : n = 5 ∨ n = 6) : commutator ↥Y = ⊤ := by
  rcases hY with hPSL | ⟨rfl, hE6⟩
  · obtain ⟨-, K, hKfield, hKfin, hKcard, ⟨e⟩⟩ := hPSL
    let : Field K := hKfield
    let : Finite K := hKfin
    have hm : 3 ≤ n + 3 := by omega
    have : IsSimpleGroup
        (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL (n + 3) K) :=
      CFSG.RankThree.PartOne.KCLinearSubfield.isSimpleGroup_projectiveSL (K := K) hm
    have hcomm :
        commutator (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL (n + 3) K) = ⊤ :=
      CFSG.Assembly.Dichotomy.commutator_eq_top_of_isSimpleGroup
        (CFSG.GH74.GLS.Stage2.Bender.Thm1.Ln.exists_noncomm_projectiveSL (K := K) hm)
    exact commutator_eq_top_of_mulEquiv
      (e.trans (CFSG.ComponentClassification.RankTwoClassical.statedProjEquiv (n + 3) K)) hcomm
  ·
    unfold GGHasLabel at hE6
    unfold LargeEvenRawDatum at hE6
    obtain ⟨K, hKfield, hKfin, hKcard, ⟨e⟩⟩ := hE6
    let : Field K := hKfield
    let : Finite K := hKfin
    have : Group.IsPerfect ↥(CFSG.Blueprint.Chevalley.adjointGroup .E6 K) :=
      (CFSG.LieType.Simplicity.isQuasisimple_adjointGroup_e6 K).1
    have hcommQ : commutator (CFSG.Blueprint.AdjointQuotient .E6 K) = ⊤ :=
      Group.IsPerfect.commutator_eq_top
    exact commutator_eq_top_of_mulEquiv
      (e.trans (Classical.choice (CFSG.StandardType.centerQuot_chevGroup_equiv K .E6))) hcommQ

private lemma ylab_card_gt_2520
    {G : Type} [Group G] [Finite G] {n : ℕ} {Y : Subgroup G}
    (hY : YLab n Y) (hn : n = 5 ∨ n = 6) : 2520 < Nat.card ↥Y := by
  rcases hY with hPSL | ⟨rfl, hE6⟩
  · obtain ⟨-, K, hKfield, hKfin, hKcard, ⟨e⟩⟩ := hPSL
    let : Field K := hKfield
    let : Finite K := hKfin
    have hK2 : Nat.card K = 2 ^ 1 := by simpa using hKcard
    have hcard : Nat.card ↥Y = Nat.card (StatedProj (StatedSL (n + 3) K)) :=
      Nat.card_congr e.toEquiv
    rcases hn with rfl | rfl
    · have hdvd : 2 ^ 28 ∣ Nat.card (StatedProj (StatedSL (5 + 3) K)) := by
        have h := CFSG.CGT.PushingUpLit.T2KR.two_pow_dvd_card_psl (K := K) (f := 1)
          (m := 5 + 3) hK2 (by norm_num)
        simpa using h
      rw [hcard]
      have hle : 2 ^ 28 ≤ Nat.card (StatedProj (StatedSL (5 + 3) K)) :=
        Nat.le_of_dvd Nat.card_pos hdvd
      norm_num at hle ⊢
      omega
    · have hdvd : 2 ^ 36 ∣ Nat.card (StatedProj (StatedSL (6 + 3) K)) := by
        have h := CFSG.CGT.PushingUpLit.T2KR.two_pow_dvd_card_psl (K := K) (f := 1)
          (m := 6 + 3) hK2 (by norm_num)
        simpa using h
      rw [hcard]
      have hle : 2 ^ 36 ≤ Nat.card (StatedProj (StatedSL (6 + 3) K)) :=
        Nat.le_of_dvd Nat.card_pos hdvd
      norm_num at hle ⊢
      omega
  ·
    unfold GGHasLabel at hE6
    unfold LargeEvenRawDatum at hE6
    obtain ⟨K, hKfield, hKfin, hKcard, ⟨e⟩⟩ := hE6
    let : Field K := hKfield
    let : Finite K := hKfin
    have hcard : Nat.card ↥Y = CFSG.Open.ordE6 2 := by
      have h2 : Nat.card (CFSG.Assembly.LargeEvenCenterQuot
          (CFSG.Assembly.LargeEvenChevH (CFSG.Assembly.LargeEvenCartanE 6) K false)) =
          Nat.card (CFSG.Blueprint.AdjointQuotient .E6 K) :=
        Nat.card_congr
          (Classical.choice (CFSG.StandardType.centerQuot_chevGroup_equiv K .E6)).toEquiv
      calc Nat.card ↥Y = Nat.card (CFSG.Assembly.LargeEvenCenterQuot
            (CFSG.Assembly.LargeEvenChevH (CFSG.Assembly.LargeEvenCartanE 6) K false)) :=
            Nat.card_congr e.toEquiv
        _ = Nat.card (CFSG.Blueprint.AdjointQuotient .E6 K) := h2
        _ = CFSG.Open.ordE6 2 := by
            rw [CFSG.Timmesfeld.ExceptionalOrders.card_adjointQuotient,
              CFSG.Timmesfeld.ExceptionalOrders.card_adjointGroup_E6, hKcard]
            norm_num
    rw [hcard]
    have h : 12096 < CFSG.Open.ordE6 2 :=
      CFSG.LargeExtraspecial.A2Mod.Ord.twelve_thousand_lt_exceptional.2.1
    omega

theorem holtEnd_holds :
    HoltEnd := by
  intro G _ _ hsimp hchar n hn Y S t hY hYtop hSyl htS ht2 hcent hconj
  obtain ⟨P, hPS⟩ := CFSG.StandardType.FrameRoute.FS81.fs81Hl_sylow2In_sylow hSyl htS hconj
  have htY : t ∈ Y := hSyl.1 htS
  have ht1 : (⟨t, htY⟩ : Y) ≠ 1 := by
    intro h
    have h1 : t = 1 := congrArg Subtype.val h
    rw [h1, orderOf_one] at ht2
    exact absurd ht2 (by norm_num)
  have : Nontrivial ↥Y := ⟨⟨⟨t, htY⟩, 1, ht1⟩⟩
  have hYnsolv : ¬ Group.IsSolvable ↥Y :=
    CFSG.StandardType.FrameRoute.FS81.fs81Hl_not_solvable_of_commutator_top
      (ylab_commutator_top hY hn)
  have hnonab : ∃ a b : G, a * b ≠ b * a := by
    have hnonabY : ∃ a b : ↥Y, a * b ≠ b * a := by
      by_contra h
      push Not at h
      exact hYnsolv (Group.isSolvable_of_comm fun a b => h a b)
    obtain ⟨a, b, hab⟩ := hnonabY
    exact ⟨(a : G), (b : G), fun hxy => hab (Subtype.ext hxy)⟩
  have : FaithfulSMul G (G ⧸ Y) :=
    CFSG.RankThree.PartTwo.Sec21.faithfulSMul_quotient_of_simple hYtop
  have hfix : ∀ q : G ⧸ Y, t • q = q ↔ q = ((1 : G) : G ⧸ Y) := by
    intro q
    induction q using QuotientGroup.induction_on with
    | H g =>
      rw [CFSG.RankThree.PartTwo.Sec21.smul_mk_eq_iff,
        CFSG.RankThree.PartTwo.Sec21.mk_eq_mk_one_iff]
      constructor
      · intro hg
        have hg' : g⁻¹ ∈ Y := hconj g⁻¹ (by simpa using hg)
        simpa using Y.inv_mem hg'
      · intro hg
        exact Y.mul_mem (Y.mul_mem (Y.inv_mem hg) htY) hg
  have hPc : (P : Subgroup G) ≤ Subgroup.centralizer ({t} : Set G) := by
    intro p hp
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact hcent p (hPS ▸ hp)
  have hT : CFSG.Holt.General.IsHoltTriple G (G ⧸ Y) t ((1 : G) : G ⧸ Y) :=
    { isPretransitive := inferInstance
      orderOf_eq_two := ht2
      smul_eq_iff := hfix
      exists_sylow := ⟨P, by rw [hPS]; exact htS, hPc⟩ }
  have hgood : CFSG.Holt.General.IsGoodZ G (G ⧸ Y) ((1 : G) : G ⧸ Y) ⊤ :=
    CFSG.Holt.H78.isGoodZ_top_of_holtTheorem1 CFSG.Holt.H78.holtTheorem1 hT
  rcases (CFSG.Holt.General.isGoodZ_top_iff hnonab ((1 : G) : G ⧸ Y)).mp hgood with
    ⟨hBender, hSE⟩ | ⟨m, _, e, _⟩
  · have hSEY : CFSG.IsStronglyEmbedded Y := by
      rwa [MulAction.stabilizer_quotient] at hSE
    exact CFSG.Holt.General.false_of_fusionIsBenderGroup_of_le hBender hSEY P
      (by rw [hPS]; exact hSyl.1) le_rfl hYnsolv
  · have hgt : 2520 < Nat.card Y := ylab_card_gt_2520 hY hn
    have hcardG : Nat.card G = Nat.card (alternatingGroup (Fin (2 * m + 1))) :=
      Nat.card_congr e.toEquiv
    have hYle : Nat.card Y ≤ Nat.card G := Subgroup.card_le_card_group Y
    by_cases hm4 : 4 ≤ m
    · exact (CFSG.RankThree.PartTwo.Census.not_isCharTwoType_alternating
          (n := 2 * m + 1) (by omega))
        (CFSG.RankThree.PartTwo.Census.isCharTwoType_of_mulEquiv e hchar)
    · have hm3 : m = 2 ∨ m = 3 := by omega
      rcases hm3 with rfl | rfl
      · have hc : Nat.card (alternatingGroup (Fin (2 * 2 + 1))) = 60 := by
          rw [nat_card_alternatingGroup, Nat.card_eq_fintype_card, Fintype.card_fin]
          decide
        have h2 : Nat.card Y ≤ 60 := hYle.trans (hcardG.trans hc).le
        omega
      · have hc : Nat.card (alternatingGroup (Fin (2 * 3 + 1))) = 2520 := by
          rw [nat_card_alternatingGroup, Nat.card_eq_fintype_card, Fintype.card_fin]
          decide
        have h2 : Nat.card Y ≤ 2520 := hYle.trans (hcardG.trans hc).le
        omega

