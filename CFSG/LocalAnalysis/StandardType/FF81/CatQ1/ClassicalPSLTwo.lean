private theorem cq1_card_projectiveSL_two {F : Type} [Field F] [Finite F] :
    Nat.card (projectiveSL 2 F) =
      Nat.card F * (Nat.card F ^ 2 - 1) / Nat.gcd 2 (Nat.card F - 1) := by
  rw [← Nat.card_congr (LinearCover.projectiveSpecialLinearEquivProjectiveSL 2 F).toEquiv]
  rw [CFSG.OrderReductions.LinearOrders.card_projectiveSpecialLinear F 2 (by norm_num)]
  norm_num [Finset.Icc_self, Finset.prod_singleton]

theorem card_projectiveSL_two_mul_two {F : Type} [Field F] [Finite F]
    (hF : Odd (Nat.card F)) :
    2 * Nat.card (projectiveSL 2 F) = Nat.card F * (Nat.card F ^ 2 - 1) := by
  have hq : 2 ∣ Nat.card F - 1 := by
    obtain ⟨k, hk⟩ := hF
    exact ⟨k, by omega⟩
  have hg : Nat.gcd 2 (Nat.card F - 1) = 2 :=
    Nat.dvd_antisymm (Nat.gcd_dvd_left 2 (Nat.card F - 1)) (Nat.dvd_gcd dvd_rfl hq)
  rw [cq1_card_projectiveSL_two, hg]
  have hdvd2 : 2 ∣ Nat.card F ^ 2 - 1 :=
    (show 2 ∣ 8 by norm_num).trans (Nat.eight_dvd_sq_sub_one_of_odd hF)
  have hdvd : 2 ∣ Nat.card F * (Nat.card F ^ 2 - 1) :=
    dvd_mul_of_dvd_right hdvd2 (Nat.card F)
  calc 2 * (Nat.card F * (Nat.card F ^ 2 - 1) / 2)
      = Nat.card F * (Nat.card F ^ 2 - 1) / 2 * 2 := by rw [mul_comm]
    _ = Nat.card F * (Nat.card F ^ 2 - 1) := Nat.div_mul_cancel hdvd

theorem pRank_projectiveSL_two_le_one_of_not_dvd {F : Type} [Field F] [Finite F]
    (hpF : ¬ 3 ∣ Nat.card F) : CFSG.Open.pRank 3 (⊤ : Subgroup (projectiveSL 2 F)) ≤ 1 := by
  have hdiv : ¬ 3 ∣ Nat.gcd 2 (Nat.card F - 1) := by
    intro h
    have h2 : 3 ∣ 2 := h.trans (Nat.gcd_dvd_left 2 (Nat.card F - 1))
    norm_num at h2
  have hform := CFSG.LieType.OutStructure.pRank_projectiveSL_formula (N := 2) (K := F)
    Nat.prime_three (by norm_num) (by norm_num) hpF hdiv
  rw [hform]
  by_cases h : 3 ∣ Nat.card F - 1
  · rw [if_pos h]
  · rw [if_neg h]
    have hFact : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    have hq0 : (Nat.card F : ZMod 3) ≠ 0 := by
      intro h0
      exact hpF ((ZMod.natCast_eq_zero_iff _ _).mp h0)
    have hdvd : orderOf (Nat.card F : ZMod 3) ∣ 2 := by
      simpa using ZMod.orderOf_dvd_card_sub_one hq0
    have hq1 : (Nat.card F : ZMod 3) ≠ 1 := by
      intro hq
      apply h
      have hm : Nat.card F ≡ 1 [MOD 3] := (ZMod.natCast_eq_natCast_iff _ _ _).mp hq
      have h1q : 1 ≤ Nat.card F := by
        have := Finite.one_lt_card (α := F); omega
      exact (Nat.modEq_iff_dvd' h1q).mp hm.symm
    have hne1 : orderOf (Nat.card F : ZMod 3) ≠ 1 := fun h1 =>
      hq1 (orderOf_eq_one_iff.mp h1)
    have hd2 : orderOf (Nat.card F : ZMod 3) = 2 := by
      rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | h2
      · exact absurd h1 hne1
      · exact h2
    rw [hd2]

theorem pRank_projectiveSL_two_le_three_of_card_eq {F : Type} [Field F] [Finite F]
    (hF : Nat.card F = 27) : CFSG.Open.pRank 3 (⊤ : Subgroup (projectiveSL 2 F)) ≤ 3 := by
  have hcard : Nat.card (projectiveSL 2 F) = 9828 := by
    rw [cq1_card_projectiveSL_two, hF]
    norm_num
  refine CFSG.GroupTheory.pRank_le_of_not_dvd_pow_succ (H := ⊤) (p := 3) (k := 3)
    Nat.prime_three ?_
  rw [Subgroup.card_top]
  change ¬ 81 ∣ Nat.card (projectiveSL 2 F)
  rw [hcard]
  norm_num

theorem card_projectiveSL_two_of_card_eq_nine {F : Type} [Field F] [Finite F]
    (hF : Nat.card F = 9) : Nat.card (projectiveSL 2 F) = 360 := by
  rw [cq1_card_projectiveSL_two, hF]
  norm_num

theorem twentySeven_dvd_card_projectiveSL_two {F : Type} [Field F] [Finite F] {e : ℕ}
    (hF : Nat.card F = 3 ^ e) (he : 3 ≤ e) : 27 ∣ Nat.card (projectiveSL 2 F) := by
  have h3odd : Odd (3 : ℕ) := ⟨1, by norm_num⟩
  have hodd : Odd (Nat.card F) := by rw [hF]; exact h3odd.pow
  have hmul := card_projectiveSL_two_mul_two (F := F) hodd
  rw [hF] at hmul
  have h27 : 27 ∣ 3 ^ e := by
    have : (27 : ℕ) = 3 ^ 3 := by norm_num
    rw [this]
    exact pow_dvd_pow 3 he
  have hdvd : 27 ∣ 2 * Nat.card (projectiveSL 2 F) := by
    rw [hmul]
    exact dvd_mul_of_dvd_left h27 _
  have hcop : Nat.Coprime 27 2 := by decide
  rw [mul_comm] at hdvd
  exact (Nat.Coprime.dvd_mul_right hcop).mp hdvd

theorem exists_equiv_fixedSubgroup_projectiveSL_two {F : Type} [Field F] [Finite F] {ℓ f : ℕ}
    (hℓ : ℓ.Prime) (hf : 1 ≤ f) (hFcard : Nat.card F = ℓ ^ f)
    {α : MulAut (projectiveSL 2 F)} (hα : α ^ 3 = 1) (hout : ∀ k, α ≠ MulAut.conj k) :
    3 ∣ f ∧ ∃ (F₀ : Type) (_ : Field F₀) (_ : Finite F₀), Nat.card F₀ = ℓ ^ (f / 3) ∧
      Nonempty (fixedSubgroup α ≃* projectiveSL 2 F₀) := by
  let ψ : projectiveSL 2 F ≃*
      CFSG.ComponentClassification.CatalogueSchreierLinearTwo.coordinateG F :=
    (LinearCover.projectiveSpecialLinearEquivProjectiveSL 2 F).symm.trans
      (CFSG.ComponentClassification.CatalogueSchreierLinearTwo.pslEquivCoordinateG F)
  have hord : orderOf α = 3 := by
    refine orderOf_eq_prime hα ?_
    have := hout 1
    simpa using this
  have hinn : α ∉ CFSG.RankThree.PartOne.Sec66T.innerAut (projectiveSL 2 F) := by
    rintro ⟨k, hk⟩
    exact hout k hk.symm
  obtain ⟨h3f, k, hkcard, ⟨eX⟩⟩ :=
    CFSG.RankThree.PartOne.FOC.psl_two_fixSub_equiv_gen (T := projectiveSL 2 F) (K := F)
      hℓ Nat.prime_three (by norm_num) hf hFcard ψ hord hinn
  let eY : CFSG.ComponentClassification.CatalogueSchreierLinearTwo.coordinateG ↥k ≃*
      projectiveSL 2 ↥k :=
    (CFSG.ComponentClassification.CatalogueSchreierLinearTwo.pslEquivCoordinateG ↥k).symm.trans
      (LinearCover.projectiveSpecialLinearEquivProjectiveSL 2 ↥k)
  exact ⟨h3f, ↥k, inferInstance, inferInstance, hkcard, ⟨eX.trans eY⟩⟩

theorem exists_card_eq_three_pow {F : Type} [Field F] [Finite F] (h3 : 3 ∣ Nat.card F) :
    ∃ f : ℕ, 1 ≤ f ∧ Nat.card F = 3 ^ f := by
  have hFintype : Fintype F := Fintype.ofFinite F
  obtain ⟨n, hpprime, hcard⟩ := FiniteField.card F (ringChar F)
  have hcard' : Nat.card F = ringChar F ^ (n : ℕ) := by
    rw [Nat.card_eq_fintype_card]; exact hcard
  have hdvd : 3 ∣ ringChar F := by
    apply Nat.Prime.dvd_of_dvd_pow Nat.prime_three
    rw [← hcard']; exact h3
  have hp3 : ringChar F = 3 :=
    ((Nat.prime_dvd_prime_iff_eq Nat.prime_three hpprime).mp hdvd).symm
  exact ⟨(n : ℕ), n.pos, by rw [hcard', hp3]⟩

open CFSG.Open CFSG.LocalAnalysis.ComponentInitial in
theorem outerThreeBig_projectiveSL_two {F : Type} [Field F] [Finite F] :
    OuterThreeBig (LinearFlag.projectiveSL 2 F) := by
  intro h4 β hβ hout
  by_cases h3 : 3 ∣ Nat.card F
  · obtain ⟨f, hf, hFcard⟩ := exists_card_eq_three_pow h3
    obtain ⟨h3f, F₀, hF₀field, hF₀finite, hF₀card, ⟨e⟩⟩ :=
      exists_equiv_fixedSubgroup_projectiveSL_two Nat.prime_three hf hFcard hβ hout
    have hcard : Nat.card (fixedSubgroup β) = Nat.card (projectiveSL 2 F₀) :=
      Nat.card_congr e.toEquiv
    obtain ⟨c, hc⟩ := h3f
    have hfc : f / 3 = c := by rw [hc]; simp
    rw [hfc] at hF₀card
    have hcpos : 1 ≤ c := by omega
    rcases c with _ | _ | _ | d
    · omega
    · have hF27 : Nat.card F = 27 := by rw [hFcard, hc]; norm_num
      have := pRank_projectiveSL_two_le_three_of_card_eq (F := F) hF27
      omega
    · have hF₀9 : Nat.card F₀ = 9 := by rw [hF₀card]; norm_num
      have h360 : Nat.card (projectiveSL 2 F₀) = 360 :=
        card_projectiveSL_two_of_card_eq_nine (F := F₀) hF₀9
      refine Or.inr (Or.inl ?_)
      rw [hcard, h360]
      norm_num
    · have hF₀ : Nat.card F₀ = 3 ^ (d + 3) := hF₀card
      have h27 : 27 ∣ Nat.card (projectiveSL 2 F₀) :=
        twentySeven_dvd_card_projectiveSL_two (F := F₀) hF₀ (by omega)
      exact Or.inl (by rw [hcard]; exact h27)
  · have hle := pRank_projectiveSL_two_le_one_of_not_dvd (F := F) h3
    omega

