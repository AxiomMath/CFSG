private theorem cq1_card_semilinearFixedSubfield_cube {K : Type} [Field K]
    {ℓ f : ℕ} (hℓ : ℓ.Prime) (hf : 1 ≤ f) (hK : Nat.card K = ℓ ^ f)
    {σ : K ≃+* K} (hσ : orderOf σ = 3) :
    Nat.card K = Nat.card (semilinearFixedSubfield σ) ^ 3 := by
  obtain ⟨h3f, hkcard⟩ :=
    card_semilinearFixedSubfield (K := K) hℓ hf hK hσ
  have h3f' : f = 3 * (f / 3) := (Nat.mul_div_cancel' h3f).symm
  have hpow : ℓ ^ f = (ℓ ^ (f / 3)) ^ 3 := by
    conv_lhs =>
      rw [h3f']
      rw [Nat.mul_comm 3]
      rw [pow_mul]
  rw [hK, hpow, ← hkcard]

theorem exists_subfield_embedding_fixed {F : Type} [Field F] [Finite F] {n : ℕ} (hn : 3 ≤ n)
    {α : MulAut (projectiveSL n F)} (hα : α ^ 3 = 1)
    (hnot : ¬ ∃ B : GL (Fin n) F, conjAut n F B = α) :
    ∃ (F₀ : Type) (_ : Field F₀) (_ : Finite F₀)
      (ψ : projectiveSL n F₀ →* projectiveSL n F),
      Nat.card F = Nat.card F₀ ^ 3 ∧ Function.Injective ψ ∧ ∀ a, α (ψ a) = ψ a := by
  classical
  obtain ⟨H, σ, hσ3, hσ1, hform⟩ :=
    CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.KD291Out.linear_outer_form hn
      Nat.prime_three (by norm_num) α hα hnot
  have hσord : orderOf σ = 3 := by
    have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    exact orderOf_eq_prime hσ3 hσ1
  have : Fintype F := Fintype.ofFinite F
  obtain ⟨ℓ, -, f, hℓ, hFcard⟩ := FiniteField.card' F
  have hK : Nat.card F = ℓ ^ (f : ℕ) := by rw [Nat.card_eq_fintype_card, hFcard]
  have hcard : Nat.card F = Nat.card (semilinearFixedSubfield σ) ^ 3 :=
    cq1_card_semilinearFixedSubfield_cube hℓ f.pos hK hσord
  have hinj : Function.Injective (linearSubfieldInclusion n (semilinearFixedSubfield σ)) :=
    linearSubfieldInclusion_injective (K := F) (by omega) _
  have hfix : ∀ x : projectiveSL n (semilinearFixedSubfield σ),
      fieldAut n F σ (linearSubfieldInclusion n (semilinearFixedSubfield σ) x) =
        linearSubfieldInclusion n (semilinearFixedSubfield σ) x :=
    fun x => fieldAut_linearSubfieldInclusion
      (fun c hc => RingHom.mem_eqLocusField.mp hc) x
  let ψ : projectiveSL n (semilinearFixedSubfield σ) →* projectiveSL n F :=
    (conjAut n F H).toMonoidHom.comp (linearSubfieldInclusion n (semilinearFixedSubfield σ))
  refine ⟨↥(semilinearFixedSubfield σ), inferInstance, Subtype.finite, ψ, hcard, ?_, ?_⟩
  · intro a b hab
    exact hinj ((conjAut n F H).injective hab)
  · intro a
    have hfa := hfix a
    show α (ψ a) = ψ a
    rw [hform]
    simp only [ψ, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.mul_apply,
      MulAut.inv_apply, MulEquiv.symm_apply_apply, hfa]

theorem pRank_projectiveSL_three_le_two {F : Type} [Field F] [Finite F] (hpF : ¬ 3 ∣ Nat.card F) :
    CFSG.Open.pRank 3 (⊤ : Subgroup (projectiveSL 3 F)) ≤ 2 := by
  have : Fintype F := Fintype.ofFinite F
  by_cases h3 : 3 ∣ Nat.card F - 1
  · have h3' : 3 ∣ Fintype.card F - 1 := by rw [← Nat.card_eq_fintype_card]; exact h3
    let e : projectiveSL 3 F ≃* StatedProj (StatedSL 3 F) :=
      (CFSG.LocalAnalysis.ComponentInitial.LinearCover.projectiveSpecialLinearEquivProjectiveSL
          3 F).symm.trans
        (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj 3 F)
    rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv (by norm_num : 1 < 3) e]
    refine le_of_eq ?_
    exact CFSG.LocalAnalysis.RankThreeUC.S15.ACore.pRank_statedSL_three (F := F) h3'
      ((StatedScalars (Fin 3) F).subgroupOf (StatedSL 3 F)) le_rfl
  · have hdiv : ¬ 3 ∣ Nat.gcd 3 (Nat.card F - 1) := fun h =>
      h3 (h.trans (Nat.gcd_dvd_right 3 (Nat.card F - 1)))
    rw [CFSG.LieType.OutStructure.pRank_projectiveSL_formula (N := 3) (K := F)
      (p := 3) Nat.prime_three (by norm_num) (by norm_num) hpF hdiv, if_neg h3]
    have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    have hz : (Nat.card F : ZMod 3) ≠ 1 := by
      intro h1
      have hcard1 : 1 ≤ Nat.card F := Nat.one_le_iff_ne_zero.mpr (Nat.card_pos.ne')
      have hzero : ((Nat.card F - 1 : ℕ) : ZMod 3) = 0 := by
        rw [Nat.cast_sub hcard1, h1, Nat.cast_one, sub_self]
      exact h3 ((ZMod.natCast_eq_zero_iff (Nat.card F - 1) 3).mp hzero)
    exact le_trans
      (CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.KD291OL.OFRC.three_div_orderOf_le_one
        (Nat.card F : ZMod 3) hz) (by norm_num)

theorem twentySeven_dvd_card_projectiveSL_charThree {F₀ : Type} [Field F₀] [Finite F₀] {n e : ℕ}
    (hn : 3 ≤ n) (he : 1 ≤ e) (hF₀ : Nat.card F₀ = 3 ^ e) :
    27 ∣ Nat.card (projectiveSL n F₀) := by
  have hmodel : StatedClassicalModel (projectiveSL n F₀) .PSL n 3 e :=
    ⟨⟨Nat.prime_three, he, by omega,
        (fun h => by have := congrArg Prod.fst h; omega),
        (fun h => by have := congrArg Prod.fst h; omega)⟩,
      F₀, inferInstance, inferInstance, hF₀,
      ⟨(CFSG.LocalAnalysis.ComponentInitial.LinearCover.projectiveSpecialLinearEquivProjectiveSL
          n F₀).symm.trans
        (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj n F₀)⟩⟩
  exact twentySeven_dvd_card_of_charThree hmodel (fun _ => hn)

private theorem cq1_three_dvd_card_sub_one_of_cube {F F₀ : Type} [Field F] [Field F₀]
    [Finite F] [Finite F₀] (hcard : Nat.card F = Nat.card F₀ ^ 3)
    (h3 : 3 ∣ Nat.card F - 1) : 3 ∣ Nat.card F₀ - 1 := by
  have hcard1 : 1 ≤ Nat.card F₀ := Nat.one_le_iff_ne_zero.mpr (Nat.card_pos.ne')
  have hF3 : ((Nat.card F - 1 : ℕ) : ZMod 3) = 0 :=
    (ZMod.natCast_eq_zero_iff (Nat.card F - 1) 3).mpr h3
  have hFeq : ((Nat.card F : ℕ) : ZMod 3) = 1 := by
    have hcast : ((Nat.card F - 1 : ℕ) : ZMod 3) = (Nat.card F : ZMod 3) - 1 :=
      Nat.cast_sub (Nat.one_le_iff_ne_zero.mpr (Nat.card_pos.ne'))
    rw [hcast] at hF3
    exact sub_eq_zero.mp hF3
  have hF₀eq : ((Nat.card F₀ : ℕ) : ZMod 3) = 1 := by
    have hcube : ((Nat.card F : ℕ) : ZMod 3) = (Nat.card F₀ : ZMod 3) ^ 3 := by
      rw [hcard, Nat.cast_pow]
    rw [hFeq] at hcube
    have hx : (Nat.card F₀ : ZMod 3) ^ 3 = (Nat.card F₀ : ZMod 3) :=
      @ZMod.pow_card 3 ⟨Nat.prime_three⟩ _
    rw [hx] at hcube
    exact hcube.symm
  have hzero : ((Nat.card F₀ - 1 : ℕ) : ZMod 3) = 0 := by
    rw [Nat.cast_sub hcard1, hF₀eq, Nat.cast_one, sub_self]
  exact (ZMod.natCast_eq_zero_iff (Nat.card F₀ - 1) 3).mp hzero

private theorem cq1_char_three_dvd_card_of_cube {F₀ : Type} [Field F₀] [Finite F₀] {n f : ℕ}
    (hn : 3 ≤ n) (hF₀ : Nat.card F₀ ∣ 3 ^ f) : 27 ∣ Nat.card (projectiveSL n F₀) := by
  obtain ⟨e, -, hF₀⟩ := (Nat.dvd_prime_pow Nat.prime_three).mp hF₀
  refine twentySeven_dvd_card_projectiveSL_charThree hn ?_ hF₀
  by_contra h
  have he0 : e = 0 := by omega
  rw [he0, pow_zero] at hF₀
  have h2 : 2 ≤ Nat.card F₀ := by
    have : Fintype F₀ := Fintype.ofFinite F₀
    have h1 := Fintype.one_lt_card (α := F₀)
    rw [← Nat.card_eq_fintype_card] at h1
    omega
  omega

private theorem cq1_five_le_of_three_dvd {n : ℕ} (h3n : 3 ∣ n) (h3lt : 3 < n) : 5 ≤ n := by
  obtain ⟨k, rfl⟩ := h3n
  omega

private theorem cq1_three_lt_of_four_le_pRank {F : Type} [Field F] [Finite F] {n : ℕ} (hn : 3 ≤ n)
    (hpF : ¬ 3 ∣ Nat.card F)
    (h4 : 4 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (projectiveSL n F))) : 3 < n := by
  by_contra h
  have hn3 : n = 3 := by omega
  subst hn3
  have hle := pRank_projectiveSL_three_le_two hpF
  omega

theorem twentySeven_dvd_card_projectiveSL_of_cube {F F₀ : Type} [Field F] [Field F₀] [Finite F]
    [Finite F₀] {n : ℕ} (hn : 3 ≤ n) (hcard : Nat.card F = Nat.card F₀ ^ 3)
    (h4 : 4 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (projectiveSL n F))) :
    27 ∣ Nat.card (projectiveSL n F₀) := by
  have : Fintype F := Fintype.ofFinite F
  obtain ⟨ℓ, -, f, hℓ, hFcard⟩ := FiniteField.card' F
  have hK : Nat.card F = ℓ ^ (f : ℕ) := by rw [Nat.card_eq_fintype_card, hFcard]
  rcases eq_or_ne ℓ 3 with rfl | hℓ3
  · have hdvd : Nat.card F₀ ∣ 3 ^ (f : ℕ) := by
      rw [← hK, hcard]
      exact dvd_pow_self (Nat.card F₀) (by norm_num : 3 ≠ 0)
    exact cq1_char_three_dvd_card_of_cube hn hdvd
  · have hpF : ¬ 3 ∣ Nat.card F := by
      rw [hK]
      intro h
      exact hℓ3 (((Nat.prime_dvd_prime_iff_eq Nat.prime_three hℓ).mp
        (Nat.prime_three.dvd_of_dvd_pow h))).symm
    by_cases hdiv : 3 ∣ Nat.gcd n (Nat.card F - 1)
    · have h3n : 3 ∣ n := hdiv.trans (Nat.gcd_dvd_left n (Nat.card F - 1))
      have h3F : 3 ∣ Nat.card F - 1 := hdiv.trans (Nat.gcd_dvd_right n (Nat.card F - 1))
      have hn5 : 5 ≤ n :=
        cq1_five_le_of_three_dvd h3n (cq1_three_lt_of_four_le_pRank hn hpF h4)
      have h3F₀ : 3 ∣ Nat.card F₀ - 1 := cq1_three_dvd_card_sub_one_of_cube hcard h3F
      obtain ⟨T, hT⟩ := exists_torus_projectiveSL (F := F₀) (n := n) hn5 h3F₀
      have h27 : Nat.card T.range = 27 := by
        rw [← card_threeTorus]
        exact (Nat.card_congr (MonoidHom.ofInjective hT).toEquiv).symm
      rw [← h27]
      exact T.range.card_subgroup_dvd_card
    · rw [CFSG.LieType.OutStructure.pRank_projectiveSL_pow_prime (K := F) (K₀ := F₀)
        (m := n) (p := 3) Nat.prime_three (by norm_num) (by omega) hcard hpF hdiv] at h4
      have h := twentySeven_dvd_of_three_le_pRank (⊤ : Subgroup (projectiveSL n F₀)) (by omega)
      rwa [Subgroup.card_top] at h

