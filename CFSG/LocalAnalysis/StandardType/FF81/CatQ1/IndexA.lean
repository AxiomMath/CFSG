theorem outerThreeBig_A : OuterThreeBigAt (fun i => ∃ r q, i = .A r q) := by
  rintro K _ _ d ⟨r, q, hd⟩ ⟨e⟩
  obtain ⟨i, hv⟩ := d
  obtain rfl : i = .A r q := hd
  have hrange := (LieTypeIndex.inStandardRange_iff _).1 ((LieTypeIndex.valid_iff _).1 hv).1
  obtain ⟨-, F, _, _, hF, ⟨θ⟩⟩ :=
    CFSG.HardMathSupport.Curtis.UnitaryLevi.statedClassicalModel_typeA' hv e
  let e' : K ≃* LinearFlag.projectiveSL (r + 1) F :=
    θ.trans (CFSG.QuasithinUnique.Id2519.projectiveSLEquivStatedProj (r + 1) F).symm
  refine OuterThreeBig.of_mulEquiv e'.symm ?_
  rcases (show r = 1 ∨ 2 ≤ r by have := hrange.1; omega) with h1 | h2
  · subst h1
    exact outerThreeBig_projectiveSL_two
  · exact outerThreeBig_projectiveSL (by omega)

end CFSG.StandardType.FF81.CatQ1
