theorem outerThreeBig_D4
    : OuterThreeBigAt (fun i => ∃ q, i = .D 4 q) := by
  have hB := CFSG.HardMathSupport.Malle.E27Lie.d4Bridge_holds
  have hF := CFSG.HardMathSupport.Malle.E27Lie.d4FixedBound_holds
  rintro K _ _ d hd ⟨e⟩ - u hu3 hout
  obtain ⟨i, hv⟩ := d
  obtain ⟨q, rfl⟩ := hd
  have hpr : Fact q.p.Prime := ⟨q.prime_p⟩
  have hcard : Nat.card (GaloisField q.p q.exponent) = q.card := by
    rw [GaloisField.card q.p q.exponent (by have := q.exponent_pos; omega),
      TauCeti.PrimePower.card_def]
  obtain ⟨br⟩ := hB q hv (GaloisField q.p q.exponent) hcard
  let φ : K ≃* adjointGroup Tag.D4 (GaloisField q.p q.exponent) :=
    (e.trans br.symm).trans
      ((QuotientGroup.quotientMulEquivOfEq center_adjointGroup_eq_bot).trans
        QuotientGroup.quotientBot)
  have hu3' : MulAut.congr φ u ^ 3 = 1 := by rw [← map_pow, hu3, map_one]
  have hu_inn : u ∉ inner K := fun ⟨k, hk⟩ => hout k hk.symm
  have hout2 : MulAut.congr φ u ∉ inner (adjointGroup Tag.D4 (GaloisField q.p q.exponent)) :=
    fun hin => hu_inn ((CFSG.HardMathSupport.Lang.Coordinator.congr_mem_inner_iff φ u).mp hin)
  have h27 := hF (GaloisField q.p q.exponent) (MulAut.congr φ u) hu3' hout2
  rw [CFSG.HardMathSupport.Lang.Coordinator.card_fixedSubgroup_congr φ u] at h27
  exact Or.inl h27

theorem outerThreeBig_trialityD4
    : OuterThreeBigAt (fun i => ∃ q, i = .trialityD4 q) := by
  rintro K _ _ d hd ⟨e⟩ - u hu3 hout
  obtain ⟨i, hv⟩ := d
  obtain ⟨q, rfl⟩ := hd
  have hm := CFSG.HardMathSupport.Malle.E27Lie.twistedModel_of_trialityD4 q hv e
  have hpr := q.prime_p
  have hf := q.exponent_pos
  refine Or.inl ?_
  by_cases hp2 : q.p = 2
  · have hm' : TwistedChevalleyModel K .D4 (2 ^ q.exponent) := hp2 ▸ hm
    exact CFSG.HardMathSupport.Lang.E27Lie.twentySeven_dvd_fixedSubgroup_trialityD4_two_model
      hf K hm' u hu3 fun ⟨k, hk⟩ => hout k hk.symm
  by_cases hp3 : q.p = 3
  · have hm' : TwistedChevalleyModel K .D4 (3 ^ q.exponent) := hp3 ▸ hm
    exact CFSG.HardMathSupport.Malle.E27Lie.trialityThreeLower_holds hf K hm' u hu3
      fun ⟨k, hk⟩ => hout k hk.symm
  have hp5 : 5 ≤ q.p := by
    have := hpr.two_le
    have : q.p ≠ 4 := fun h4 => by rw [h4] at hpr; exact absurd hpr (by norm_num)
    omega
  by_cases hq : (q.p ^ q.exponent) % 3 = 1
  · exact CFSG.HardMathSupport.Lang.E27Lie.twentySeven_dvd_fixedSubgroup_trialityD4_q1_model
      hpr hp5 hf hq K hm u hu3 fun ⟨k, hk⟩ => hout k hk.symm
  · exact CFSG.HardMathSupport.Lang.E27Lie.twentySeven_dvd_fixedSubgroup_trialityD4_q2_model
      CFSG.HardMathSupport.Lang.E27Lie.minusToralLower_holds hpr hp5 hf K hm u hu3
      fun ⟨k, hk⟩ => hout k hk.symm

end CFSG.StandardType.FF81.CatQ1
