private theorem cq1_zmod_three_cube (x : ZMod 3) : x ^ 3 = x :=
  @ZMod.pow_card 3 ⟨Nat.prime_three⟩ x

private theorem cq1_zmod_pow_cube {ℓ e : ℕ} :
    ((ℓ ^ (3 * e) : ℕ) : ZMod 3) = ((ℓ ^ e : ℕ) : ZMod 3) := by
  rw [show 3 * e = e * 3 by ring, pow_mul]
  push_cast
  exact cq1_zmod_three_cube _

private theorem cq1_three_dvd_add_one_iff {ℓ f e : ℕ} (hf : f = 3 * e) :
    (3 ∣ ℓ ^ f + 1) ↔ (3 ∣ ℓ ^ e + 1) := by
  subst hf
  rw [← ZMod.natCast_eq_zero_iff (ℓ ^ (3 * e) + 1) 3,
    ← ZMod.natCast_eq_zero_iff (ℓ ^ e + 1) 3]
  push_cast
  rw [show 3 * e = e * 3 by ring, pow_mul, cq1_zmod_three_cube]

private theorem cq1_three_dvd_add_one {ℓ f e : ℕ} (hf : f = 3 * e) (h : 3 ∣ ℓ ^ f + 1) :
    3 ∣ ℓ ^ e + 1 :=
  (cq1_three_dvd_add_one_iff hf).mp h

private theorem cq1_orderOf_eq_three_of_fieldFactor_ne_one {ℓ f n : ℕ} {F : Type} [Field F]
    [Finite F] (h : UnitaryFieldData ℓ f F) (hn : 3 ≤ n) (hne : ¬(n = 3 ∧ ℓ ^ f = 2))
    {β : MulAut (primeFormP h ((1 : GL (Fin n) F) : Matrix (Fin n) (Fin n) F))}
    (hβ : β ^ 3 = 1) (hσ : primeFormFieldFactor h isPrimeFormGram_one hn hne β ≠ 1) :
    orderOf β = 3 ∧ orderOf (primeFormFieldFactor h isPrimeFormGram_one hn hne β) = 3 := by
  have hβne : β ≠ 1 := by
    intro hb
    exact hσ (by rw [hb, map_one])
  have hordβ : orderOf β = 3 := by
    have hdvd : orderOf β ∣ 3 := orderOf_dvd_iff_pow_eq_one.mpr hβ
    rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
    · rw [orderOf_eq_one_iff] at h1
      exact absurd h1 hβne
    · exact h3
  have hσ3 : (primeFormFieldFactor h isPrimeFormGram_one hn hne β) ^ 3 = 1 := by
    rw [← map_pow, hβ, map_one]
  have hordσ : orderOf (primeFormFieldFactor h isPrimeFormGram_one hn hne β) = 3 := by
    have hdvd : orderOf (primeFormFieldFactor h isPrimeFormGram_one hn hne β) ∣ 3 :=
      orderOf_dvd_iff_pow_eq_one.mpr hσ3
    rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
    · rw [orderOf_eq_one_iff] at h1
      exact absurd h1 hσ
    · exact h3
  exact ⟨hordβ, hordσ⟩

theorem exists_subfield_embedding_fixed_primeFormP {ℓ f n : ℕ} {F : Type} [Field F] [Finite F]
    (h : UnitaryFieldData ℓ f F) (hn : 3 ≤ n) (hne : ¬(n = 3 ∧ ℓ ^ f = 2))
    {β : MulAut (primeFormP h ((1 : GL (Fin n) F) : Matrix (Fin n) (Fin n) F))} (hβ : β ^ 3 = 1)
    (hσ : primeFormFieldFactor h isPrimeFormGram_one hn hne β ≠ 1) :
    ∃ (e : ℕ) (F₀ : Type) (_ : Field F₀) (_ : Finite F₀) (h₀ : UnitaryFieldData ℓ e F₀)
      (ι : primeFormP h₀ ((1 : GL (Fin n) F₀) : Matrix (Fin n) (Fin n) F₀) →*
        primeFormP h ((1 : GL (Fin n) F) : Matrix (Fin n) (Fin n) F)),
      f = 3 * e ∧ Function.Injective ι ∧ ∀ a, β (ι a) = ι a := by
  let σ : F ≃+* F := primeFormFieldFactor h isPrimeFormGram_one hn hne β
  obtain ⟨hordβ, hordσ⟩ := cq1_orderOf_eq_three_of_fieldFactor_ne_one h hn hne hβ hσ
  obtain ⟨h3dvd, -, -, -, -, M, hM⟩ :=
    unitary_prime_semilinear_field_descent' h hn hne Nat.prime_three (by norm_num) β hordβ σ rfl
      hordσ
  let F₀ : Type := CFSG.LieType.Chevalley.fixSubfield σ
  let h₀ : UnitaryFieldData ℓ (f / 3) F₀ :=
    CFSG.RankThree.Classical.fixSubfield_unitaryFieldData h Nat.prime_three (by norm_num) hordσ
  have hbar : ∀ c : F₀, (h₀.bar c : F) = h.bar c :=
    CFSG.RankThree.Classical.fixSubfield_unitaryFieldData_bar h Nat.prime_three (by norm_num)
      hordσ
  let j : primeFormP h₀ ((1 : GL (Fin n) F₀) : Matrix (Fin n) (Fin n) F₀) →*
      primeFormP h ((1 : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) :=
    CFSG.RankThree.Classical.subfieldPSU h h₀ hbar n
  let c : MulAut (primeFormP h ((1 : GL (Fin n) F) : Matrix (Fin n) (Fin n) F)) :=
    primeFormConjHom h ((1 : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) M
  let fσ : MulAut (primeFormP h ((1 : GL (Fin n) F) : Matrix (Fin n) (Fin n) F)) :=
    primeFormFieldHom h isPrimeFormGram_one σ
  have hM' : c⁻¹ * β * c = fσ := hM
  have hβc : β * c = c * fσ := by
    calc β * c = c * (c⁻¹ * β * c) := by group
      _ = c * fσ := by rw [hM']
  refine ⟨f / 3, F₀, inferInstance, inferInstance, h₀, c.toMonoidHom.comp j, ?_, ?_, ?_⟩
  · exact (Nat.mul_div_cancel' h3dvd).symm
  · exact c.injective.comp
      (CFSG.RankThree.Classical.subfieldPSU_injective h h₀ hbar n (by omega))
  · intro a
    have hfix : fσ (j a) = j a :=
      CFSG.RankThree.Classical.range_subfieldPSU_le h n h₀ hbar ⟨a, rfl⟩
    calc β ((c.toMonoidHom.comp j) a) = β (c (j a)) := rfl
      _ = (β * c) (j a) := by rw [MulAut.mul_apply]
      _ = (c * fσ) (j a) := by rw [hβc]
      _ = c (fσ (j a)) := by rw [MulAut.mul_apply]
      _ = c (j a) := by rw [hfix]
      _ = (c.toMonoidHom.comp j) a := rfl

theorem pRank_primeFormP_eq_of_cube {ℓ f e n : ℕ} {F F₀ : Type} [Field F] [Field F₀] [Finite F]
    [Finite F₀] (h : UnitaryFieldData ℓ f F) (h₀ : UnitaryFieldData ℓ e F₀) (hn : 1 ≤ n)
    (hf : f = 3 * e) (hℓ : ℓ ≠ 3) (hdiv : ¬ 3 ∣ Nat.gcd n (ℓ ^ f + 1)) :
    CFSG.Open.pRank 3 (⊤ : Subgroup (primeFormP h
      ((1 : GL (Fin n) F) : Matrix (Fin n) (Fin n) F))) =
      CFSG.Open.pRank 3 (⊤ : Subgroup (primeFormP h₀
        ((1 : GL (Fin n) F₀) : Matrix (Fin n) (Fin n) F₀))) := by
  have hmod : ((ℓ ^ f : ℕ) : ZMod 3) = ((ℓ ^ e : ℕ) : ZMod 3) := by
    subst hf
    exact cq1_zmod_pow_cube
  have hiff : (3 ∣ ℓ ^ f + 1) ↔ (3 ∣ ℓ ^ e + 1) := cq1_three_dvd_add_one_iff hf
  have hdiv₀ : ¬ 3 ∣ Nat.gcd n (ℓ ^ e + 1) := by
    intro hd
    exact hdiv (Nat.dvd_gcd (hd.trans (Nat.gcd_dvd_left n (ℓ ^ e + 1)))
      (hiff.mpr (hd.trans (Nat.gcd_dvd_right n (ℓ ^ e + 1)))))
  rw [pRank_primeFormP_one h Nat.prime_three (by norm_num) hℓ.symm hn hdiv,
    pRank_primeFormP_one h₀ Nat.prime_three (by norm_num) hℓ.symm hn hdiv₀]
  by_cases h3 : 3 ∣ ℓ ^ f + 1
  · rw [if_pos h3, if_pos (hiff.mp h3)]
  · rw [if_neg h3, if_neg (fun hh => h3 (hiff.mpr hh)), hmod]

private theorem cq1_div_orderOf_neg_le_two {n p m : ℕ} (hn : n ≤ 3) (h : ¬ p ∣ m + 1) :
    n / orderOf (-((m : ℕ) : ZMod p)) ≤ 2 := by
  have hne : orderOf (-((m : ℕ) : ZMod p)) ≠ 1 := by
    rw [Ne, orderOf_eq_one_iff]
    intro h1
    apply h
    rw [← ZMod.natCast_eq_zero_iff (m + 1) p, Nat.cast_add, Nat.cast_one]
    linear_combination -h1
  rcases Nat.lt_or_ge (orderOf (-((m : ℕ) : ZMod p))) 2 with hlt | hge
  · have h0 : orderOf (-((m : ℕ) : ZMod p)) = 0 := by omega
    rw [h0, Nat.div_zero]
    omega
  · exact Nat.div_le_of_le_mul (by omega)

theorem pRank_primeFormP_three_le_two {ℓ f : ℕ} {F : Type} [Field F] [Finite F]
    (h : UnitaryFieldData ℓ f F) (hℓ : ℓ ≠ 3) :
    CFSG.Open.pRank 3 (⊤ : Subgroup (primeFormP h
      ((1 : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F))) ≤ 2 := by
  by_cases h3 : 3 ∣ ℓ ^ f + 1
  · have hle := pRank_three_projSU_three_le h h3
    rw [CFSG.SectionRank.pRank_top_eq_of_mulEquiv (by norm_num)
      ((ClassicalGroups.UnitaryFlag.unitaryPSUEquiv h (by norm_num)).symm.trans
        (LocalAnalysis.unitaryPSUEquivPrimeFormOne h 3))] at hle
    exact hle
  · have hdiv : ¬ 3 ∣ Nat.gcd 3 (ℓ ^ f + 1) := by
      intro hd
      exact h3 (hd.trans (Nat.gcd_dvd_right 3 (ℓ ^ f + 1)))
    rw [pRank_primeFormP_one h Nat.prime_three (by norm_num) hℓ.symm (by norm_num) hdiv,
      if_neg h3]
    exact cq1_div_orderOf_neg_le_two le_rfl h3

theorem twentySeven_dvd_card_primeFormP_charThree {e n : ℕ} {F₀ : Type} [Field F₀] [Finite F₀]
    (h₀ : UnitaryFieldData 3 e F₀) (hn : 3 ≤ n) :
    27 ∣ Nat.card (primeFormP h₀ ((1 : GL (Fin n) F₀) : Matrix (Fin n) (Fin n) F₀)) := by
  have hn1 : 1 ≤ n := by omega
  have hcard : Nat.card F₀ = (3 ^ e) ^ 2 := by
    rw [h₀.card, Nat.mul_comm 2 e, ← pow_mul]
  have hne : (n, 3 ^ e) ≠ (3, 2) := by
    intro hh
    have h3e : 3 ≤ 3 ^ e := by
      calc (3 : ℕ) = 3 ^ 1 := (pow_one 3).symm
        _ ≤ 3 ^ e := Nat.pow_le_pow_right (by norm_num) h₀.one_le
    have h2 : 3 ^ e = 2 := congrArg Prod.snd hh
    omega
  have hadm : CFSG.Open.StatedLieAdmissible .PSU n 3 e :=
    ⟨Nat.prime_three, h₀.one_le, hn, hne⟩
  have hmodel : CFSG.Open.StatedClassicalModel (primeFormP h₀ ((1 : GL (Fin n) F₀) :
      Matrix (Fin n) (Fin n) F₀)) .PSU n 3 e := by
    refine ⟨hadm, F₀, inferInstance, inferInstance, hcard, ?_⟩
    exact ⟨(LocalAnalysis.unitaryPSUEquivPrimeFormOne h₀ n).symm.trans
      (ClassicalGroups.UnitaryFlag.unitaryPSUEquiv h₀ hn1)⟩
  exact twentySeven_dvd_card_of_charThree hmodel (by intro hh; cases hh)

theorem twentySeven_dvd_card_primeFormP_of_cube {ℓ f e n : ℕ} {F F₀ : Type} [Field F] [Field F₀]
    [Finite F] [Finite F₀] (h : UnitaryFieldData ℓ f F) (h₀ : UnitaryFieldData ℓ e F₀) (hn : 3 ≤ n)
    (hf : f = 3 * e)
    (h4 : 4 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (primeFormP h
      ((1 : GL (Fin n) F) : Matrix (Fin n) (Fin n) F)))) :
    27 ∣ Nat.card (primeFormP h₀ ((1 : GL (Fin n) F₀) : Matrix (Fin n) (Fin n) F₀)) := by
  by_cases hℓ : ℓ = 3
  · subst hℓ
    exact twentySeven_dvd_card_primeFormP_charThree h₀ hn
  · by_cases hdiv : 3 ∣ Nat.gcd n (ℓ ^ f + 1)
    · have h3n : 3 ∣ n := hdiv.trans (Nat.gcd_dvd_left n (ℓ ^ f + 1))
      have h3q : 3 ∣ ℓ ^ f + 1 := hdiv.trans (Nat.gcd_dvd_right n (ℓ ^ f + 1))
      have hn3 : n ≠ 3 := by
        intro hh
        subst hh
        have hle := pRank_primeFormP_three_le_two h hℓ
        omega
      have hn6 : 6 ≤ n := by
        rcases h3n with ⟨k, hk⟩
        have hk1 : 1 ≤ k := by omega
        have hk2 : 2 ≤ k := by
          by_contra hklt
          have hk1' : k = 1 := by omega
          apply hn3
          omega
        omega
      have h3e : 3 ∣ ℓ ^ e + 1 := cq1_three_dvd_add_one hf h3q
      obtain ⟨T, hT⟩ := exists_torus_primeFormP h₀ (le_trans (by norm_num : 5 ≤ 6) hn6) h3e
      have hcardT : Nat.card (Fin 3 → Multiplicative (ZMod 3)) = Nat.card T.range :=
        Nat.card_congr (MonoidHom.ofInjective hT).toEquiv
      have h1 : Nat.card T.range ∣ Nat.card (primeFormP h₀
          ((1 : GL (Fin n) F₀) : Matrix (Fin n) (Fin n) F₀)) := by
        have hh := Subgroup.card_dvd_of_le (show T.range ≤ ⊤ from le_top)
        rwa [Nat.card_congr (Subgroup.topEquiv).toEquiv] at hh
      rw [← hcardT] at h1
      have h27 : Nat.card (Fin 3 → Multiplicative (ZMod 3)) = 27 := by
        rw [Nat.card_eq_fintype_card, Fintype.card_fun, Fintype.card_fin,
          Fintype.card_multiplicative, ZMod.card]
        norm_num
      rwa [h27] at h1
    · have hrank := pRank_primeFormP_eq_of_cube h h₀ (by omega) hf hℓ hdiv
      have h3 : 3 ≤ CFSG.Open.pRank 3 (⊤ : Subgroup (primeFormP h₀
          ((1 : GL (Fin n) F₀) : Matrix (Fin n) (Fin n) F₀))) := by
        rw [← hrank]
        omega
      have hh := twentySeven_dvd_of_three_le_pRank (⊤ : Subgroup (primeFormP h₀
        ((1 : GL (Fin n) F₀) : Matrix (Fin n) (Fin n) F₀))) h3
      rwa [Nat.card_congr (Subgroup.topEquiv).toEquiv] at hh

