private theorem kgLangS1ALinTypeDetAux_solvable_projectiveSL_two_small
    (K : Type) [Field K] [Finite K] (hcard : Nat.card K = 2 ∨ Nat.card K = 3) :
    Group.IsSolvable (LinearFlag.projectiveSL 2 K) := by
  haveI : Group.IsSolvable (Matrix.GeneralLinearGroup (Fin 2) K) :=
    CFSG.ComponentClassification.CatalogueBGeneralLinear.generalLinear_two_small_solvable K hcard
  haveI : Group.IsSolvable (Matrix.SpecialLinearGroup (Fin 2) K) :=
    Group.isSolvable_of_isSolvable_injective Matrix.SpecialLinearGroup.toGL_injective
  exact Group.isSolvable_of_surjective (LinearFlag.proj_surjective 2 K)

private theorem kgLangS1ALinTypeDetAux_lieModel_of_projectiveSL {X : Type} [Group X]
    {n p f : ℕ} {K : Type} [Field K] [Finite K]
    (hp : p.Prime) (hf : 1 ≤ f) (hK : Nat.card K = p ^ f) (hn : 2 ≤ n)
    (h22 : ¬ (n = 2 ∧ Nat.card K = 2)) (h23 : ¬ (n = 2 ∧ Nat.card K = 3))
    (e : X ≃* LinearFlag.projectiveSL n K) :
    CFSG.Blueprint.LieModel X .PSL n p f := by
  have h22' : ¬ ((n, p ^ f) = (2, 2)) := by
    rintro h
    simp only [Prod.mk.injEq] at h
    exact h22 ⟨h.1, by rw [hK, h.2]⟩
  have h23' : ¬ ((n, p ^ f) = (2, 3)) := by
    rintro h
    simp only [Prod.mk.injEq] at h
    exact h23 ⟨h.1, by rw [hK, h.2]⟩
  have hadm : CFSG.Assembly.LowTwoRank.StatedLieAdmissible .PSL n p f :=
    ⟨hp, hf, hn, h22', h23'⟩
  refine Or.inl ⟨by decide, ⟨hadm, K, inferInstance, inferInstance, hK, ⟨?_⟩⟩⟩
  exact e.trans ((LinearCover.projectiveSpecialLinearEquivProjectiveSL n K).symm.trans
    (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj n K))

theorem kgLangS1A_psl_typeDet
    {d d₁ m : ℕ} {F₀ E : Type} [Field F₀] [Finite F₀] [Field E] [Finite E]
    (hd : 3 ≤ d) (hm : 2 ≤ m) (hF₀ : Nat.card F₀ = 2 ^ m)
    (ψ : LinearFlag.projectiveSL d F₀ ≃* LargeEvenProj (LargeEvenSLGroup (Fin d₁) E)) :
    d₁ = d ∧ Nat.card E = Nat.card F₀ := by
  classical
  letI : Fintype E := Fintype.ofFinite E
  let e : LinearFlag.projectiveSL d F₀ ≃* LinearFlag.projectiveSL d₁ E :=
    ψ.trans (TypeA.recipeEquiv d₁ E)
  have hsimple : IsSimpleGroup (LinearFlag.projectiveSL d F₀) :=
    CFSG.ComponentClassification.OutcomeLocal.isSimpleGroup_projectiveSL (k := F₀) (n := d) hd
  haveI := hsimple
  have hperf : Group.IsPerfect (LinearFlag.projectiveSL d F₀) := by
    haveI : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin d) F₀) :=
      CFSG.ComponentClassification.CatalogueBGeneralLinear.specialLinear_perfect d F₀
        (by omega) (Or.inl (by omega)) (Or.inl (by omega))
    exact Group.IsPerfect.ofSurjective (LinearFlag.proj_surjective d F₀)
  haveI := hperf
  have hsolvX : ¬ Group.IsSolvable (LinearFlag.projectiveSL d F₀) :=
    Group.IsPerfect.not_isSolvable _
  have hdne2 : d ≠ 2 := by omega
  have hX : CFSG.Blueprint.LieModel (LinearFlag.projectiveSL d F₀) .PSL d 2 m :=
    kgLangS1ALinTypeDetAux_lieModel_of_projectiveSL (X := LinearFlag.projectiveSL d F₀)
      (K := F₀) (n := d) (p := 2) (f := m) Nat.prime_two (by omega) hF₀ (by omega)
      (fun h => hdne2 h.1) (fun h => hdne2 h.1) (MulEquiv.refl _)
  have hd1 : 2 ≤ d₁ := by
    by_contra h
    haveI : Subsingleton (LinearFlag.projectiveSL d₁ E) :=
      CFSG.AGLEmbedding.ToralCensus.subsingleton_projectiveSL (n := d₁) (by omega) E
    exact not_subsingleton (LinearFlag.projectiveSL d F₀) e.toEquiv.subsingleton
  have hE22 : ¬ (d₁ = 2 ∧ Nat.card E = 2) := by
    rintro ⟨rfl, hcardE⟩
    haveI : Group.IsSolvable (LinearFlag.projectiveSL 2 E) :=
      kgLangS1ALinTypeDetAux_solvable_projectiveSL_two_small E (Or.inl hcardE)
    exact hsolvX (Group.isSolvable_of_isSolvable_injective (f := e.toMonoidHom) e.injective)
  have hE23 : ¬ (d₁ = 2 ∧ Nat.card E = 3) := by
    rintro ⟨rfl, hcardE⟩
    haveI : Group.IsSolvable (LinearFlag.projectiveSL 2 E) :=
      kgLangS1ALinTypeDetAux_solvable_projectiveSL_two_small E (Or.inr hcardE)
    exact hsolvX (Group.isSolvable_of_isSolvable_injective (f := e.toMonoidHom) e.injective)
  obtain ⟨g, hℓprime, hcardE⟩ := FiniteField.card E (ringChar E)
  have hcardE' : Nat.card E = ringChar E ^ (g : ℕ) := by
    rw [Nat.card_eq_fintype_card]; exact hcardE
  have hg1 : 1 ≤ (g : ℕ) := by have := g.pos; omega
  have hE : CFSG.Blueprint.LieModel (LinearFlag.projectiveSL d F₀) .PSL d₁ (ringChar E) (g : ℕ) :=
    kgLangS1ALinTypeDetAux_lieModel_of_projectiveSL (X := LinearFlag.projectiveSL d F₀)
      (K := E) (n := d₁) (p := ringChar E) (f := (g : ℕ)) hℓprime hg1 hcardE' hd1 hE22 hE23 e
  by_cases hℓ2 : ringChar E = 2
  · have hE2 : CFSG.Blueprint.LieModel (LinearFlag.projectiveSL d F₀) .PSL d₁ 2 (g : ℕ) := by
      simpa only [hℓ2] using hE
    obtain ⟨-, hd1eq, hgm⟩ :=
      CFSG.SeitzReduction.LinearPilot.lieModel_PSL_two_unique hd hX hE2
    have hcardE2 : Nat.card E = 2 ^ (g : ℕ) := by rw [hcardE', hℓ2]
    exact ⟨hd1eq, by rw [hcardE2, hgm, hF₀]⟩
  · have hodd : CFSG.Blueprint.OddLieType (LinearFlag.projectiveSL d F₀) :=
      CFSG.ComponentClassification.Foote5.oddLieType_of_lieModel_ne_two hE hℓprime hℓ2
    rcases CFSG.SeitzReduction.CrossChar.eq_of_lieModel_two_of_oddLieType' hX hodd with
      ⟨-, hd2, -⟩ | ⟨-, hd3, hm1⟩ | ⟨hPSU, -, -⟩
    · exfalso; omega
    · exfalso; omega
    · exact absurd hPSU (by decide)

