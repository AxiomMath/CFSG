theorem card_range_ggJAction
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    {R : Type} [Group R]
    (e : ↥J ⧸ Subgroup.center ↥J ≃* R) :
    Nat.card ↥(ggJAction hR e).range = 25 := by
  have hcfg : GGConfig 5 B Bs x L D J := hR.1
  have hpre : LargeEvenStdSubPre 5 B x L D J := hcfg.2.2.1
  have hDcard : Nat.card D = 5 ^ 2 := hpre.2.2.1
  have hker_card : Nat.card ↥(ggJAction hR e).ker = 25 := by
    rw [ker_ggJAction hR e]
    calc Nat.card ↥(D.subgroupOf B) = Nat.card D :=
          Nat.card_congr (Subgroup.subgroupOfEquivOfLe hpre.1).toEquiv
      _ = 5 ^ 2 := hDcard
      _ = 25 := by norm_num
  have hBcard : Nat.card B = 5 ^ 4 := (ggF4N2Rank hR hL).2.1
  have hcard := Subgroup.card_ker_mul_card_range (ggJAction hR e)
  have h : 25 * Nat.card ↥(ggJAction hR e).range = 25 * 25 := by
    calc 25 * Nat.card ↥(ggJAction hR e).range =
          Nat.card ↥(ggJAction hR e).ker * Nat.card ↥(ggJAction hR e).range := by rw [hker_card]
      _ = Nat.card B := hcard
      _ = 5 ^ 4 := hBcard
      _ = 25 * 25 := by norm_num
  exact Nat.mul_left_cancel (by norm_num : 0 < 25) h

theorem ggF4N2J_singleton_centralizer
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hL : GGCentralImage .POmegaMinus 4 2 L) :
    ∃ d ∈ D, d ∉ Subgroup.zpowers x ∧ ∃ a : L, orderOf a = 5 ∧
      (Subgroup.centralizer ({a} : Set L)).map L.subtype = L ⊓ Subgroup.centralizer (D : Set G) ∧
      CFSG.Assembly.IsComponentOf (J.subgroupOf L) (Subgroup.centralizer ({a} : Set L)) ∧
      J = (LargeEvenLayer (Subgroup.centralizer ({a} : Set L))).map L.subtype ∧
      ∀ l : L, d * (l : G) * d⁻¹ = ((a * l * a⁻¹ : L) : G) := by
  have hcfg : GGConfig 5 B Bs x L D J := hR.1
  obtain ⟨_, _, _, _, _, _, hS, _⟩ := hcfg.1
  obtain ⟨hDB, hDe, hDcard, hxD, hJdef, hJcomp, _⟩ := hcfg.2.2.1
  have hBsN : Bs ≤ Subgroup.normalizer (L : Set G) := GGDichotomy.le_normalizer_of_innerDiagOn hR.2.2.1.1
  have hBN : B ≤ Subgroup.normalizer (L : Set G) := hcfg.2.1.1.trans hBsN
  have hLx : L ≤ Subgroup.centralizer ({x} : Set G) := hS.2.2.2.1.1
  obtain ⟨d, hdD, hdx⟩ := exists_mem_not_mem_zpowers Nat.prime_five hDcard
    (hS.1.1.2 x hS.2.1) hS.2.2.1
  have hD : D = Subgroup.zpowers x ⊔ Subgroup.zpowers d :=
    eq_sup_zpowers_of_card Nat.prime_five hDe hDcard hxD hS.2.2.1 hdD hdx
  let dB : B := ⟨d, hDB hdD⟩
  let α : MulAut L := ggGamma L hBN dB
  have hα5 : α ^ 5 = 1 := by
    have hd5 : dB ^ 5 = 1 := Subtype.ext (hDe.2 d hdD)
    change (ggGamma L hBN dB) ^ 5 = 1
    rw [← map_pow, hd5, map_one]
  have hα1 : α ≠ 1 := by
    intro h
    change ggGamma L hBN dB = 1 at h
    rw [ggGamma_eq_one_iff] at h
    apply hdx
    rw [← inf_centralizer_eq_zpowers_of_sstar Nat.prime_five hS]
    exact ⟨hDB hdD, h⟩
  have hZ : Subgroup.center L = ⊥ := ggN2Center_eq_bot_of_centralImage hL
  let eQ : (L ⧸ Subgroup.center L) ≃* L :=
    (QuotientGroup.quotientMulEquivOfEq hZ).trans (QuotientGroup.quotientBot)
  obtain ⟨a, ha⟩ := ggN2Inner_of_fifth hL eQ α hα5
  have ha5 : a ^ 5 = 1 := by
    apply CFSG.Fischer.mulAutConj_injective hZ
    rw [map_pow, ha, hα5, map_one]
  have ha1 : a ≠ 1 := by
    intro h
    apply hα1
    rw [← ha, h, map_one]
  have haord : orderOf a = 5 := orderOf_eq_prime ha5 ha1
  have hfix : (ggFix α).map L.subtype = L ⊓ Subgroup.centralizer (D : Set G) := by
    rw [hD, inf_centralizer_sup_zpowers hLx]
    exact map_ggFix_ggGamma L hBN dB
  have hCa : ggFix α = Subgroup.centralizer ({a} : Set L) := by
    rw [← ha]
    ext l
    rw [mem_ggFix, Subgroup.mem_centralizer_singleton_iff]
    change a * l * a⁻¹ = l ↔ l * a = a * l
    rw [mul_inv_eq_iff_eq_mul]
    exact eq_comm
  have hCaMap : (Subgroup.centralizer ({a} : Set L)).map L.subtype =
      L ⊓ Subgroup.centralizer (D : Set G) := by rwa [hCa] at hfix
  have hJCa : CFSG.Assembly.IsComponentOf (J.subgroupOf L) (Subgroup.centralizer ({a} : Set L)) := by
    have h := isComponentOf_comap_of_injective L.subtype L.subtype_injective
      (K' := J) (C := Subgroup.centralizer ({a} : Set L)) (by rw [hCaMap]; exact hJcomp)
    exact h.1
  have hJE : J = (LargeEvenLayer (Subgroup.centralizer ({a} : Set L))).map L.subtype := by
    rw [hJdef, ← hCaMap, largeEvenLayer_map_of_injective _ L.subtype_injective]
  refine ⟨d, hdD, hdx, a, haord, hCaMap, hJCa, hJE, ?_⟩
  intro l
  have h := congrArg (fun f : MulAut L => ((f l : L) : G)) ha
  simpa [α, dB, ggGamma_coe, MulAut.conj_apply] using h.symm


