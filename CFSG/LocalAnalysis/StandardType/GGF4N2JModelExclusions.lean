theorem ggJ_isComponentOf_centralizerD_of_restHyp
    {G : Type} [Group G] [Finite G] {p : ℕ} {B Bs : Subgroup G}
    {x : G} {L D J : Subgroup G} {Rd Ra : Prop} (hR : GGSecFiveRestGen p B Bs x L D J Rd Ra) :
    CFSG.Assembly.IsComponentOf J (Subgroup.centralizer (D : Set G)) := by
  have hI : GGThmIHyp p B x L := hR.1.1
  have hDJ : LargeEvenStdSub p B x L D J := hR.1.2.2
  have hS : LargeEvenSStar p B x L := hI.2.2.2.2.2.2.1
  have hp : p.Prime := hI.2.2.2.2.2.1.1
  obtain ⟨d, hd, hdx⟩ := exists_mem_not_mem_zpowers hp hDJ.1.2.2.1
    (hS.1.1.2 x hS.2.1) hS.2.2.1
  have hD : D = Subgroup.closure {x, d} := eq_closure_pair_of_mem hI hDJ hd hdx
  have hcent : Subgroup.centralizer (D : Set G) =
      Subgroup.centralizer ({d} : Set G) ⊓ Subgroup.centralizer ({x} : Set G) := by
    rw [hD, Subgroup.centralizer_closure]
    ext g
    simp only [Subgroup.mem_centralizer_iff, Subgroup.mem_inf, Set.mem_insert_iff,
      Set.mem_singleton_iff, forall_eq_or_imp, forall_eq]
    tauto
  rw [hcent]
  exact isComponentOf_inf_centralizer_of_stdSub hS hDJ.1 hD

theorem ggF4N2J_Bs_le_normalizer
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra) :
    Bs ≤ Subgroup.normalizer (J : Set G) := by
  have hcfg : GGConfig 5 B Bs x L D J := hR.1
  have hBsB : GGBstar 5 B Bs := hcfg.2.1
  have hpre : LargeEvenStdSubPre 5 B x L D J := hcfg.2.2.1
  have hN : Bs ≤ Subgroup.normalizer (L : Set G) :=
    GGDichotomy.le_normalizer_of_innerDiagOn hR.2.2.1.1
  exact GGDichotomy.le_normalizer_stdSub
    (fun a ha b hb => congrArg Subtype.val (hBsB.2.1.1.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩))
    hBsB.1 hpre hN

private theorem B_le_normalizer_J_of_secFive
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra) :
    B ≤ Subgroup.normalizer (J : Set G) :=
  hR.1.2.1.1.trans (ggF4N2J_Bs_le_normalizer hR)

noncomputable def ggJAction
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    {R : Type} [Group R]
    (e : ↥J ⧸ Subgroup.center ↥J ≃* R) :
    ↥B →* MulAut R :=
  (ggLAut J e).comp (Subgroup.inclusion (B_le_normalizer_J_of_secFive hR))

theorem ker_ggJAction
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    {R : Type} [Group R]
    (e : ↥J ⧸ Subgroup.center ↥J ≃* R) :
    (ggJAction hR e).ker = D.subgroupOf B := by
  have hcfg : GGConfig 5 B Bs x L D J := hR.1
  have hpre : LargeEvenStdSubPre 5 B x L D J := hcfg.2.2.1
  have hDJeq : D = B ⊓ Subgroup.centralizer (J : Set G) := hpre.2.2.2.2.2.2
  have hcomp : CFSG.Assembly.IsComponentOf J (L ⊓ Subgroup.centralizer (D : Set G)) :=
    hpre.2.2.2.2.2.1
  ext b
  rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
  constructor
  · intro hb
    change ggLAut J e ⟨b, (B_le_normalizer_J_of_secFive hR) b.2⟩ = 1 at hb
    rw [hDJeq]
    exact ⟨b.2, mem_centralizer_of_ggLAut_eq_one J e hcomp.2.2.1 hb⟩
  · intro hb
    have hbC : ((b : ↥B) : G) ∈ Subgroup.centralizer (J : Set G) := by
      rw [hDJeq] at hb
      exact hb.2
    change ggLAut J e ⟨b, (B_le_normalizer_J_of_secFive hR) b.2⟩ = 1
    exact ggLAut_eq_one_of_mem_centralizer J e hbC

theorem ggJAction_fifth_pow_eq_one
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    {R : Type} [Group R] (e : ↥J ⧸ Subgroup.center ↥J ≃* R) (b : B) :
    (ggJAction hR e b) ^ 5 = 1 := by
  have hBexp : IsElemAbelian 5 B := hR.1.1.2.2.2.2.2.2.1.1.1
  have hb5 : b ^ 5 = 1 := Subtype.ext (hBexp.2 b b.2)
  rw [← map_pow, hb5, map_one]

private theorem odd_order_ggJAction
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    {R : Type} [Group R] (e : ↥J ⧸ Subgroup.center ↥J ≃* R) (b : B) :
    Odd (orderOf (ggJAction hR e b)) := by
  have hdvd : orderOf (ggJAction hR e b) ∣ 5 :=
    orderOf_dvd_iff_pow_eq_one.mpr (ggJAction_fifth_pow_eq_one hR e b)
  rcases Nat.prime_five.eq_one_or_self_of_dvd _ hdvd with h1 | h5
  · rw [h1]; exact odd_one
  · rw [h5]; norm_num

private theorem card_range_dvd_of_le_inner {B R : Type} [Group B] [Group R]
    (α : B →* MulAut R)
    (h : α.range ≤ (MulAut.conj : R →* MulAut R).range) :
    Nat.card α.range ∣ Nat.card R :=
  (Subgroup.card_dvd_of_le h).trans (Subgroup.card_range_dvd _)

private theorem sl6_four_five_part :
    5 ^ 3 ∣ Nat.card (Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2)) ∧
    ¬ 5 ^ 4 ∣ Nat.card (Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2)) := by
  letI : Fintype (GaloisField 2 2) := Fintype.ofFinite _
  have hF : Fintype.card (GaloisField 2 2) = 4 := by
    rw [← Nat.card_eq_fintype_card]
    exact GaloisField.card 2 2 (by norm_num)
  constructor
  · rw [Matrix.card_SL_field]
    norm_num [Fin.prod_univ_six, hF]
  · rw [Matrix.card_SL_field]
    norm_num [Fin.prod_univ_six, hF]


