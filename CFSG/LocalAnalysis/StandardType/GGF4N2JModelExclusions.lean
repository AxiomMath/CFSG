theorem coordBlock01_injective : Function.Injective coordBlock01 :=
  pairEmbed_injective (K := F4) (a := (0 : Fin 6)) (b := (1 : Fin 6)) (by decide)

theorem coordBlock23_injective : Function.Injective coordBlock23 :=
  pairEmbed_injective (K := F4) (a := (2 : Fin 6)) (b := (3 : Fin 6)) (by decide)

theorem coordBlock45_injective : Function.Injective coordBlock45 :=
  pairEmbed_injective (K := F4) (a := (4 : Fin 6)) (b := (5 : Fin 6)) (by decide)

theorem coordBlock01_order : orderOf (coordBlock01 coordA2) = 5 := by
  calc
    orderOf (coordBlock01 coordA2) = orderOf coordA2 :=
      orderOf_injective coordBlock01 coordBlock01_injective coordA2
    _ = 5 := coordA2_order

theorem coordBlock23_order : orderOf (coordBlock23 coordA2) = 5 := by
  calc
    orderOf (coordBlock23 coordA2) = orderOf coordA2 :=
      orderOf_injective coordBlock23 coordBlock23_injective coordA2
    _ = 5 := coordA2_order

theorem coordBlock45_order : orderOf (coordBlock45 coordA2) = 5 := by
  calc
    orderOf (coordBlock45 coordA2) = orderOf coordA2 :=
      orderOf_injective coordBlock45 coordBlock45_injective coordA2
    _ = 5 := coordA2_order

theorem coordBlock01_mem : coordBlock01 coordA2 ∈ blockSpecialLinear coordJ01 := by
  rw [← range_pairEmbed (K := F4) (a := (0 : Fin 6)) (b := (1 : Fin 6)) (by decide)]
  exact ⟨coordA2, rfl⟩

theorem coordBlock23_mem : coordBlock23 coordA2 ∈ blockSpecialLinear coordJ23 := by
  rw [← range_pairEmbed (K := F4) (a := (2 : Fin 6)) (b := (3 : Fin 6)) (by decide)]
  exact ⟨coordA2, rfl⟩

theorem coordBlock45_mem : coordBlock45 coordA2 ∈ blockSpecialLinear coordJ45 := by
  rw [← range_pairEmbed (K := F4) (a := (4 : Fin 6)) (b := (5 : Fin 6)) (by decide)]
  exact ⟨coordA2, rfl⟩

abbrev coordT01 : Subgroup SL6F4 := Subgroup.zpowers (coordBlock01 coordA2)
abbrev coordT23 : Subgroup SL6F4 := Subgroup.zpowers (coordBlock23 coordA2)
abbrev coordT45 : Subgroup SL6F4 := Subgroup.zpowers (coordBlock45 coordA2)

@[expose] noncomputable def coordinateTorus : Subgroup SL6F4 :=
  coordT01 ⊔ (coordT23 ⊔ coordT45)

theorem coordinateTorus_eq_blocks :
    coordinateTorus =
      Subgroup.zpowers (coordBlock01 coordA2) ⊔
        (Subgroup.zpowers (coordBlock23 coordA2) ⊔
          Subgroup.zpowers (coordBlock45 coordA2)) := rfl

theorem coordT01_isElemAbelian : IsElemAbelian 5 coordT01 := by
  apply CFSG.Open.isElemAbelian_zpowers
  rw [← coordBlock01_order]
  exact pow_orderOf_eq_one _

theorem coordT23_isElemAbelian : IsElemAbelian 5 coordT23 := by
  apply CFSG.Open.isElemAbelian_zpowers
  rw [← coordBlock23_order]
  exact pow_orderOf_eq_one _

theorem coordT45_isElemAbelian : IsElemAbelian 5 coordT45 := by
  apply CFSG.Open.isElemAbelian_zpowers
  rw [← coordBlock45_order]
  exact pow_orderOf_eq_one _

theorem coordT23_45_commute {a b : SL6F4} (ha : a ∈ coordT23) (hb : b ∈ coordT45) :
    Commute a b := by
  have haB : a ∈ blockSpecialLinear coordJ23 :=
    (Subgroup.zpowers_le.mpr coordBlock23_mem) ha
  have hbB : b ∈ blockSpecialLinear coordJ45 :=
    (Subgroup.zpowers_le.mpr coordBlock45_mem) hb
  exact commute_blockSpecialLinear_of_disjoint (by decide) haB hbB

theorem coordT23_45_isElemAbelian :
    IsElemAbelian 5 (coordT23 ⊔ coordT45) :=
  CFSG.Open.IsElemAbelian.sup_of_commute coordT23_isElemAbelian coordT45_isElemAbelian
    (fun a ha b hb => coordT23_45_commute ha hb)

theorem coordT01_le_block : coordT01 ≤ blockSpecialLinear coordJ01 :=
  Subgroup.zpowers_le.mpr coordBlock01_mem

theorem coordT23_le_block : coordT23 ≤ blockSpecialLinear coordJ23 :=
  Subgroup.zpowers_le.mpr coordBlock23_mem

theorem coordT45_le_block : coordT45 ≤ blockSpecialLinear coordJ45 :=
  Subgroup.zpowers_le.mpr coordBlock45_mem

theorem coordT23_45_le_block :
    coordT23 ⊔ coordT45 ≤ blockSpecialLinear (coordJ23 ∪ coordJ45) := by
  refine sup_le ?_ ?_
  · exact coordT23_le_block.trans (blockSpecialLinear_mono (Finset.subset_union_left))
  · exact coordT45_le_block.trans (blockSpecialLinear_mono (Finset.subset_union_right))

theorem coordT01_commutes_coordT23_45 {a b : SL6F4}
    (ha : a ∈ coordT01) (hb : b ∈ coordT23 ⊔ coordT45) : Commute a b :=
  commute_blockSpecialLinear_of_disjoint (by decide)
    (coordT01_le_block ha) (coordT23_45_le_block hb)

theorem coordinateTorus_isElemAbelian : IsElemAbelian 5 coordinateTorus := by
  exact CFSG.Open.IsElemAbelian.sup_of_commute coordT01_isElemAbelian
    coordT23_45_isElemAbelian
    (fun a ha b hb => coordT01_commutes_coordT23_45 ha hb)

theorem coordT01_card : Nat.card coordT01 = 5 := by
  rw [Nat.card_zpowers, coordBlock01_order]

theorem coordT23_card : Nat.card coordT23 = 5 := by
  rw [Nat.card_zpowers, coordBlock23_order]

theorem coordT45_card : Nat.card coordT45 = 5 := by
  rw [Nat.card_zpowers, coordBlock45_order]

theorem coordT23_inf_coordT45 : coordT23 ⊓ coordT45 = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  have hxB : x ∈ blockSpecialLinear coordJ23 ⊓ blockSpecialLinear coordJ45 :=
    ⟨coordT23_le_block hx.1, coordT45_le_block hx.2⟩
  have hbot : blockSpecialLinear (K := F4) coordJ23 ⊓ blockSpecialLinear coordJ45 = ⊥ :=
    CFSG.SeitzReduction.F4Pilot.blockSpecialLinear_inf_eq_bot_of_disjoint (F := F4) (by decide)
  rw [hbot] at hxB
  exact hxB

theorem coordT45_le_normalizer_T23 :
    coordT45 ≤ Subgroup.normalizer (coordT23 : Set SL6F4) := by
  refine (show coordT45 ≤ Subgroup.centralizer (coordT23 : Set SL6F4) from ?_).trans
    (Subgroup.centralizer_le_normalizer _)
  intro b hb
  rw [Subgroup.mem_centralizer_iff]
  intro a ha
  exact (coordT23_45_commute ha hb).eq

theorem coordT23_45_card : Nat.card (coordT23 ⊔ coordT45 : Subgroup SL6F4) = 5 * 5 := by
  calc
    Nat.card (coordT23 ⊔ coordT45 : Subgroup SL6F4) = Nat.card coordT23 * Nat.card coordT45 :=
      CFSG.GorensteinWalter.card_sup_eq_mul_of_disjoint_of_le_normalizer
        coordT23 coordT45 coordT45_le_normalizer_T23
        (disjoint_iff.mpr coordT23_inf_coordT45)
    _ = 5 * 5 := by rw [coordT23_card, coordT45_card]

theorem coordT01_inf_coordT23_45 : coordT01 ⊓ (coordT23 ⊔ coordT45) = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  have hxB : x ∈ blockSpecialLinear coordJ01 ⊓
      blockSpecialLinear (coordJ23 ∪ coordJ45) :=
    ⟨coordT01_le_block hx.1, coordT23_45_le_block hx.2⟩
  have hbot : blockSpecialLinear (K := F4) coordJ01 ⊓
      blockSpecialLinear (coordJ23 ∪ coordJ45) = ⊥ :=
    CFSG.SeitzReduction.F4Pilot.blockSpecialLinear_inf_eq_bot_of_disjoint (F := F4) (by decide)
  rw [hbot] at hxB
  exact hxB

theorem coordT23_45_le_normalizer_T01 :
    coordT23 ⊔ coordT45 ≤ Subgroup.normalizer (coordT01 : Set SL6F4) := by
  refine (show coordT23 ⊔ coordT45 ≤
      Subgroup.centralizer (coordT01 : Set SL6F4) from ?_).trans
    (Subgroup.centralizer_le_normalizer _)
  intro b hb
  rw [Subgroup.mem_centralizer_iff]
  intro a ha
  exact (coordT01_commutes_coordT23_45 ha hb).eq

theorem coordinateTorus_card : Nat.card coordinateTorus = 5 ^ 3 := by
  calc
    Nat.card coordinateTorus = Nat.card coordT01 * Nat.card (coordT23 ⊔ coordT45 : Subgroup SL6F4) :=
      CFSG.GorensteinWalter.card_sup_eq_mul_of_disjoint_of_le_normalizer
        coordT01 (coordT23 ⊔ coordT45) coordT23_45_le_normalizer_T01
        (disjoint_iff.mpr coordT01_inf_coordT23_45)
    _ = 5 * (5 * 5) := by rw [coordT01_card, coordT23_45_card]
    _ = 5 ^ 3 := by norm_num

theorem coordinateTorus_card_125 : Nat.card coordinateTorus = 125 := by
  rw [coordinateTorus_card]
  norm_num

theorem coordinateTorus_isPGroup : IsPGroup 5 coordinateTorus :=
  CFSG.Open.IsElemAbelian.isPGroup coordinateTorus_isElemAbelian

theorem coordinateTorus_index_not_five : ¬ 5 ∣ coordinateTorus.index := by
  intro h5
  have hnotS : ¬ 5 ^ 4 ∣ Nat.card SL6F4 := sl6_four_five_part.2
  have h4 : 5 ^ 4 ∣ Nat.card SL6F4 := by
    rw [← Subgroup.index_mul_card (H := coordinateTorus)]
    rw [show 5 ^ 4 = 5 * 5 ^ 3 by norm_num]
    exact mul_dvd_mul h5 (by rw [coordinateTorus_card])
  exact hnotS h4

noncomputable def coordinateSylow : Sylow 5 SL6F4 := by
  letI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  exact coordinateTorus_isPGroup.toSylow coordinateTorus_index_not_five

theorem coordinateSylow_coe : (coordinateSylow : Subgroup SL6F4) = coordinateTorus := by
  rw [coordinateSylow]
  exact IsPGroup.toSylow_coe coordinateTorus_isPGroup coordinateTorus_index_not_five


theorem exists_coordinate_torus_data
    {G : Type} [Group G] [Finite G]
    {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {y : G} {K : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hNbr : GGNbr 5 B x D J y K)
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    (hK : GGCentralImage .PSL 6 2 K) :
    ∃ ψ : SL6F4 →* K,
      ∃ rho : Bs →* SL6F4,
        Function.Surjective ψ ∧
        ψ.ker ≤ Subgroup.center SL6F4 ∧
        (∀ b : Bs, MulAut.conj (ψ (rho b)) =
          (K.normalizerMonoidHom.comp
            (Subgroup.inclusion (ggF4N2_Bs_le_normalizer_K hR hNbr hL))) b) ∧
        (∀ (b : Bs) (k : K),
          ψ (rho b) * k * (ψ (rho b))⁻¹ =
            (K.normalizerMonoidHom.comp
              (Subgroup.inclusion (ggF4N2_Bs_le_normalizer_K hR hNbr hL))) b k) ∧
        (∀ b : Bs, (rho b) ^ 5 = 1) ∧
        rho.ker = (Subgroup.zpowers y).subgroupOf Bs ∧
        Nat.card rho.range = 5 ^ 3 ∧
        (K.subtype.comp (ψ.comp rho)).range = Bs ⊓ K ∧
        (∃ Q : Sylow 5 SL6F4, (Q : Subgroup SL6F4) = rho.range) ∧
        ∃ g : SL6F4,
          rho.range.map (MulAut.conj g).toMonoidHom = coordinateTorus := by
  classical
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  obtain ⟨ψ, rho, hSurj, hKer, hConj, hPoint, hPow, hRhoKer, hRhoCard,
    hRange, Q, hQ⟩ := ggF4N2_exists_actual_lift_sylow hR hNbr hL hK
  have hmem : coordinateSylow ∈ MulAction.orbit SL6F4 Q := by
    rw [Sylow.orbit_eq_top Q]
    simp
  obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp hmem
  have hset : ((coordinateSylow : Subgroup SL6F4) : Set SL6F4) =
      (MulAut.conj g : MulAut SL6F4) • ((Q : Subgroup SL6F4) : Set SL6F4) := by
    simpa [hg] using (Sylow.coe_smul (p := 5) (G := SL6F4) (g := g) (P := Q))
  have hmap : (Q : Subgroup SL6F4).map (MulAut.conj g).toMonoidHom =
      (coordinateSylow : Subgroup SL6F4) := by
    ext x
    rw [Subgroup.mem_map]
    constructor
    · rintro ⟨y, hy, hyx⟩
      have hxmem : x ∈ ((coordinateSylow : Subgroup SL6F4) : Set SL6F4) := by
        rw [hset]
        exact Set.mem_smul_set.mpr ⟨y, hy, by simpa [MulAut.smul_def] using hyx⟩
      exact hxmem
    · intro hx
      have hx' : x ∈ MulAut.conj g • ((Q : Subgroup SL6F4) : Set SL6F4) := by
        rw [← hset]
        exact hx
      rcases Set.mem_smul_set.mp hx' with ⟨y, hy, hxy⟩
      exact ⟨y, hy, by simpa [MulAut.smul_def] using hxy⟩
  have hmap' : rho.range.map (MulAut.conj g).toMonoidHom = coordinateTorus := by
    simpa [hQ, coordinateSylow_coe] using hmap
  exact ⟨ψ, rho, hSurj, hKer, hConj, hPoint, hPow, hRhoKer, hRhoCard,
    hRange, ⟨Q, hQ⟩, g, hmap'⟩

end
