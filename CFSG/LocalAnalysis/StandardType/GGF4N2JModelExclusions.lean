abbrev F4 : Type := GaloisField 2 2
abbrev SL2F4 : Type := Matrix.SpecialLinearGroup (Fin 2) F4
abbrev SL6F4 : Type := Matrix.SpecialLinearGroup (Fin 6) F4

noncomputable def coordA2 : SL2F4 :=
  Classical.choose (CFSG.Quasithin.Vol2.Ch11.SecS.O11.exists_orderOf_five_sl2
    (F := F4) (GaloisField.card 2 2 (by norm_num)))

theorem coordA2_order : orderOf coordA2 = 5 :=
  Classical.choose_spec (CFSG.Quasithin.Vol2.Ch11.SecS.O11.exists_orderOf_five_sl2
    (F := F4) (GaloisField.card 2 2 (by norm_num)))

abbrev coordJ01 : Finset (Fin 6) := {0, 1}
abbrev coordJ23 : Finset (Fin 6) := {2, 3}
abbrev coordJ45 : Finset (Fin 6) := {4, 5}

@[expose] noncomputable def coordBlock01 : SL2F4 →* SL6F4 :=
  pairEmbed (K := F4) (a := (0 : Fin 6)) (b := (1 : Fin 6)) (by decide)

@[expose] noncomputable def coordBlock23 : SL2F4 →* SL6F4 :=
  pairEmbed (K := F4) (a := (2 : Fin 6)) (b := (3 : Fin 6)) (by decide)

@[expose] noncomputable def coordBlock45 : SL2F4 →* SL6F4 :=
