theorem conj_fix_of_zpowers_eq {G : Type} [Group G] {t y u : G}
    (h : (MulAut.conj t) y = y) (hline : Subgroup.zpowers y = Subgroup.zpowers u) :
    (MulAut.conj t) u = u := by
  have hu : u ∈ Subgroup.zpowers y := by
    rw [hline]
    exact Subgroup.mem_zpowers u
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hu
  rw [map_zpow, h]

theorem exists_inverter_with_nontrivial_involutive_D_action
    {G : Type} [Group G] {K E J D : Subgroup G} {y : G}
    (psi : SL6F4 →* K)
    (hker : psi.ker ≤ Subgroup.center SL6F4)
    (hE : E = Subgroup.zpowers y ⊔ coordinateTorus.map (K.subtype.comp psi))
    (hJ : J = (blockFour (K := F4)).range.map (K.subtype.comp psi))
    (hy : y ∈ Subgroup.centralizer (K : Set G))
    (hD : D = E ⊓ Subgroup.centralizer (J : Set G)) :
    ∃ t : G, t ∈ K ∧ t ∈ Subgroup.normalizer (E : Set G) ∧
      t ∈ Subgroup.centralizer (J : Set G) ∧
      t ∈ Subgroup.normalizer (D : Set G) ∧
      (MulAut.conj t) y = y ∧
      (∀ z ∈ E, (MulAut.conj t) ((MulAut.conj t) z) = z) ∧
      ∃ a : G, a ∈ D ∧ orderOf a = 5 ∧
        (MulAut.conj t) a = a⁻¹ ∧ (MulAut.conj t) a ≠ a := by
  classical
  let f : SL6F4 →* G := K.subtype.comp psi
  obtain ⟨t, htK, htE, htJ, hty, h45, h01⟩ :=
    exists_inverter_through_actual_block_chart psi hE hJ hy
  have h45' : ∀ a ∈ coordT45, (MulAut.conj t) (f a) = (f a)⁻¹ :=
    fun a ha => h45 a ha
  have h01' : ∀ a ∈ coordT01 ⊔ coordT23, (MulAut.conj t) (f a) = f a :=
    fun a ha => h01 a ha
  let F : Subgroup G :=
    { carrier := {z | (MulAut.conj t) ((MulAut.conj t) z) = z}
      mul_mem' := by
        intro a b ha hb
        show (MulAut.conj t) ((MulAut.conj t) (a * b)) = a * b
        rw [map_mul, map_mul, ha, hb]
      one_mem' := by
        show (MulAut.conj t) ((MulAut.conj t) (1 : G)) = 1
        rw [map_one, map_one]
      inv_mem' := by
        intro a ha
        show (MulAut.conj t) ((MulAut.conj t) a⁻¹) = a⁻¹
        rw [map_inv, map_inv, ha] }
  have hEF : E ≤ F := by
    rw [hE]
    apply sup_le
    · rw [Subgroup.zpowers_le]
      show (MulAut.conj t) ((MulAut.conj t) y) = y
      rw [hty, hty]
    · change coordinateTorus.map f ≤ F
      rw [coordinateTorus, Subgroup.map_sup, Subgroup.map_sup]
      refine sup_le ?_ (sup_le ?_ ?_)
      · rw [coordT01, MonoidHom.map_zpowers, Subgroup.zpowers_le]
        show (MulAut.conj t) ((MulAut.conj t) (f (coordBlock01 coordA2))) =
          f (coordBlock01 coordA2)
        rw [h01' _ (Subgroup.mem_sup_left (Subgroup.mem_zpowers _)),
          h01' _ (Subgroup.mem_sup_left (Subgroup.mem_zpowers _))]
      · rw [coordT23, MonoidHom.map_zpowers, Subgroup.zpowers_le]
        show (MulAut.conj t) ((MulAut.conj t) (f (coordBlock23 coordA2))) =
          f (coordBlock23 coordA2)
        rw [h01' _ (Subgroup.mem_sup_right (Subgroup.mem_zpowers _)),
          h01' _ (Subgroup.mem_sup_right (Subgroup.mem_zpowers _))]
      · rw [coordT45, MonoidHom.map_zpowers, Subgroup.zpowers_le]
        show (MulAut.conj t) ((MulAut.conj t) (f (coordBlock45 coordA2))) =
          f (coordBlock45 coordA2)
        rw [h45' _ (Subgroup.mem_zpowers _), map_inv,
          h45' _ (Subgroup.mem_zpowers _), inv_inv]
  have hfixE : ∀ z ∈ E, (MulAut.conj t) ((MulAut.conj t) z) = z := by
    intro z hz
    exact hEF hz
  have hDnorm : t ∈ Subgroup.normalizer (D : Set G) := by
    rw [Subgroup.mem_normalizer_iff, hD]
    intro x
    rw [Subgroup.mem_inf, Subgroup.mem_inf]
    exact ⟨fun h => ⟨(Subgroup.mem_normalizer_iff.mp htE x).mp h.1,
        (Subgroup.mem_normalizer_iff.mp (Subgroup.le_normalizer htJ) x).mp h.2⟩,
      fun h => ⟨(Subgroup.mem_normalizer_iff.mp htE x).mpr h.1,
        (Subgroup.mem_normalizer_iff.mp (Subgroup.le_normalizer htJ) x).mpr h.2⟩⟩
  have hg45T : coordBlock45 coordA2 ∈ coordinateTorus :=
    Subgroup.mem_sup_right (Subgroup.mem_sup_right (Subgroup.mem_zpowers _))
  have haE : f (coordBlock45 coordA2) ∈ E := by
    rw [hE]
    exact Subgroup.mem_sup_right (Subgroup.mem_map_of_mem f hg45T)
  have haC : f (coordBlock45 coordA2) ∈ Subgroup.centralizer (J : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    rw [hJ] at hb
    obtain ⟨m, hm, rfl⟩ := Subgroup.mem_map.mp hb
    obtain ⟨n, rfl⟩ := MonoidHom.mem_range.mp hm
    change f (blockFour n) * f (coordBlock45 coordA2) =
      f (coordBlock45 coordA2) * f (blockFour n)
    exact ((commute_blockSpecialLinear_of_disjoint (K := F4) (by decide)
      (coordT45_le_block (Subgroup.mem_zpowers _))
      (blockFour_mem_coordBlock n)).map f).eq.symm
  have haD : f (coordBlock45 coordA2) ∈ D := by
    rw [hD]
    exact ⟨haE, haC⟩
  have hg45_not_center : coordBlock45 coordA2 ∉ Subgroup.center SL6F4 := by
    intro hc
    have hcenter : coordT45 ⊓ Subgroup.center SL6F4 = ⊥ :=
      CFSG.SeitzReduction.F4Pilot.inf_center_eq_bot_of_le_blockSpecialLinear
        (F := F4) (I := coordJ45) (j := 0) (by decide) coordT45_le_block
    have hmem : coordBlock45 coordA2 ∈ coordT45 ⊓ Subgroup.center SL6F4 :=
      ⟨Subgroup.mem_zpowers _, hc⟩
    rw [hcenter] at hmem
    have h1 : coordBlock45 coordA2 = 1 := Subgroup.mem_bot.mp hmem
    have ho : orderOf (coordBlock45 coordA2) = 1 := by rw [h1, orderOf_one]
    rw [coordBlock45_order] at ho
    exact absurd ho (by norm_num)
  have hpsi_ne : psi (coordBlock45 coordA2) ≠ 1 := by
    intro h
    exact hg45_not_center (hker (MonoidHom.mem_ker.mpr h))
  have hpsi_order : orderOf (psi (coordBlock45 coordA2)) = 5 := by
    have hdvd : orderOf (psi (coordBlock45 coordA2)) ∣ 5 := by
      rw [← coordBlock45_order]
      exact orderOf_map_dvd psi (coordBlock45 coordA2)
    rcases Nat.Prime.eq_one_or_self_of_dvd (p := 5) (by norm_num) _ hdvd with h1 | h5
    · exact absurd (orderOf_eq_one_iff.mp h1) hpsi_ne
    · exact h5
  have ha_order : orderOf (f (coordBlock45 coordA2)) = 5 := by
    change orderOf (K.subtype (psi (coordBlock45 coordA2))) = 5
    rw [orderOf_injective K.subtype K.subtype_injective]
    exact hpsi_order
  have ha_inv : (MulAut.conj t) (f (coordBlock45 coordA2)) =
      (f (coordBlock45 coordA2))⁻¹ :=
    h45' _ (Subgroup.mem_zpowers _)
  have ha_ne : (MulAut.conj t) (f (coordBlock45 coordA2)) ≠ f (coordBlock45 coordA2) := by
    intro hconj
    have haeq : f (coordBlock45 coordA2) = (f (coordBlock45 coordA2))⁻¹ :=
      hconj.symm.trans ha_inv
    have hsq : (f (coordBlock45 coordA2)) ^ 2 = 1 := by
      rw [pow_two]
      exact eq_inv_iff_mul_eq_one.mp haeq
    have hdvd : orderOf (f (coordBlock45 coordA2)) ∣ 2 :=
      orderOf_dvd_iff_pow_eq_one.mpr hsq
    rw [ha_order] at hdvd
    exact absurd hdvd (by norm_num)
  refine ⟨t, htK, htE, htJ, hDnorm, hty, hfixE, ?_⟩
  exact ⟨f (coordBlock45 coordA2), haD, ha_order, ha_inv, ha_ne⟩

theorem exists_inverter_with_nontrivial_involutive_D_action_fixing_u
    {G : Type} [Group G] {K E J D : Subgroup G} {y u : G}
    (psi : SL6F4 →* K)
    (hker : psi.ker ≤ Subgroup.center SL6F4)
    (hE : E = Subgroup.zpowers y ⊔ coordinateTorus.map (K.subtype.comp psi))
    (hJ : J = (blockFour (K := F4)).range.map (K.subtype.comp psi))
    (hy : y ∈ Subgroup.centralizer (K : Set G))
    (hD : D = E ⊓ Subgroup.centralizer (J : Set G))
    (hline : Subgroup.zpowers y = Subgroup.zpowers u) :
    ∃ t : G, t ∈ K ∧ t ∈ Subgroup.normalizer (E : Set G) ∧
      t ∈ Subgroup.centralizer (J : Set G) ∧
      t ∈ Subgroup.normalizer (D : Set G) ∧
      (MulAut.conj t) y = y ∧
      (∀ z ∈ E, (MulAut.conj t) ((MulAut.conj t) z) = z) ∧
      (∃ a : G, a ∈ D ∧ orderOf a = 5 ∧
        (MulAut.conj t) a = a⁻¹ ∧ (MulAut.conj t) a ≠ a) ∧
      (MulAut.conj t) u = u := by
  obtain ⟨t, htK, htE, htJ, htD, hty, hfixE, ha⟩ :=
    exists_inverter_with_nontrivial_involutive_D_action psi hker hE hJ hy hD
  exact ⟨t, htK, htE, htJ, htD, hty, hfixE, ha, conj_fix_of_zpowers_eq hty hline⟩

end CFSG.StandardType.N2KCoordinate


