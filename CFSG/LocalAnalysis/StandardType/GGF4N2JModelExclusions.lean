theorem ggF4N2_exists_coherent_internal_lift
    {G : Type} [Group G] [Finite G]
    {Bs K : Subgroup G}
    (hK : GGCentralImage .PSL 6 2 K)
    (hBs : IsElemAbelian 5 Bs)
    (action : Bs →* MulAut K) :
    ∃ rho : Bs →* K,
      (∀ b : Bs, MulAut.conj (rho b) = action b) ∧
      (∀ b : Bs, (rho b) ^ 5 = 1) ∧
      rho.ker = action.ker := by
  classical
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  haveI : Finite K := Subtype.finite
  let Inn : Subgroup (MulAut K) := (MulAut.conj : K →* MulAut K).range
  let π : K →* Inn :=
    (MulAut.conj : K →* MulAut K).codRestrict Inn (fun k => ⟨k, rfl⟩)
  have hπ : Function.Surjective π := by
    rintro ⟨u, hu⟩
    rcases hu with ⟨k, hk⟩
    exact ⟨k, Subtype.ext hk⟩
  have hker : π.ker = Subgroup.center K := by
    ext z
    rw [MonoidHom.mem_ker]
    constructor
    · intro hz
      have hz' : MulAut.conj z = 1 := by
        have h := congrArg (fun u : Inn => (u : MulAut K)) hz
        change (MulAut.conj z : MulAut K) = 1 at h
        exact h
      rw [Subgroup.mem_center_iff]
      intro y
      have h := congrArg (fun f : MulAut K => f y) hz'
      have h' : z * y * z⁻¹ = y := by simpa [MulAut.conj_apply] using h
      have h'' : z * y = y * z := by
        calc
          z * y = (z * y * z⁻¹) * z := by group
          _ = y * z := by rw [h']
      exact h''.symm
    · intro hz
      apply Subtype.ext
      apply MulEquiv.ext
      intro y
      have h := (Subgroup.mem_center_iff.mp hz) y
      calc
        (π z : MulAut K) y = (MulAut.conj z) y := rfl
        _ = z * y * z⁻¹ := by rw [MulAut.conj_apply]
        _ = y * z * z⁻¹ := by rw [← h]
        _ = y := by group
  have hcen : π.ker ≤ Subgroup.center K := by rw [hker]
  haveI : Finite (Subgroup.center K) := Subtype.finite
  have hnot5 : ¬ 5 ∣ Nat.card π.ker := by
    rw [hker]
    intro h5
    obtain ⟨z, hzord⟩ :=
      exists_prime_orderOf_dvd_card' (G := Subgroup.center K) 5 h5
    have hz3 : (z : K) ^ 3 = 1 := ggF4N2_central_cube hK z.2
    have hz3dvd : orderOf (z : K) ∣ 3 := orderOf_dvd_of_pow_eq_one hz3
    have hz5dvd : orderOf (z : K) ∣ 5 := by
      rw [Subgroup.orderOf_coe, hzord]
    have hdvd : orderOf (z : K) ∣ Nat.gcd 3 5 := Nat.dvd_gcd hz3dvd hz5dvd
    have hdvd1 : orderOf (z : K) ∣ 1 := by simpa using hdvd
    have h1 : orderOf (z : K) = 1 := Nat.dvd_one.mp hdvd1
    have h5eq : orderOf (z : K) = 5 := by
      rw [Subgroup.orderOf_coe]
      exact hzord
    rw [h5eq] at h1
    norm_num at h1
  have hBsP : IsPGroup 5 Bs := by
    rw [IsPGroup.iff_orderOf]
    intro b
    have hb5 : b ^ 5 = 1 := by
      apply Subtype.ext
      simpa using hBs.2 (b : G) b.2
    have hdvd : orderOf b ∣ 5 := orderOf_dvd_of_pow_eq_one hb5
    rcases (Nat.dvd_prime Nat.prime_five).mp hdvd with h1 | h5
    · exact ⟨0, by simp [h1]⟩
    · exact ⟨1, by simp [h5]⟩
  have hActionMem : ∀ b : Bs, action b ∈ Inn := by
    intro b
    have hb5 : action b ^ 5 = 1 := by
      have hb5Bs : b ^ 5 = 1 := by
        apply Subtype.ext
        simpa using hBs.2 (b : G) b.2
      rw [← map_pow, hb5Bs, map_one]
    obtain ⟨k, hk⟩ := ggF4N2_exists_conj_eq_of_pow_five hK (action b) hb5
    exact ⟨k, hk.symm⟩
  let actionInner : Bs →* Inn := action.codRestrict Inn hActionMem
  let U : Subgroup Inn := actionInner.range
  have hU : IsPGroup 5 U :=
    hBsP.of_surjective actionInner.rangeRestrict actionInner.rangeRestrict_surjective
  let s : U →* K := CFSG.LieType.CentralExt.pLiftHom hπ hcen hnot5 hU
  let rho : Bs →* K := s.comp actionInner.rangeRestrict
  have hconjAll : ∀ b : Bs, MulAut.conj (rho b) = action b := by
    intro b
    have hmap := CFSG.LieType.CentralExt.map_pLiftHom hπ hcen hnot5 hU
      (actionInner.rangeRestrict b)
    have hval := congrArg (fun u : Inn => (u : MulAut K)) hmap
    have hval' : MulAut.conj (s (actionInner.rangeRestrict b)) = action b := by
      change (π (s (actionInner.rangeRestrict b)) : MulAut K) = action b
      exact hval
    simpa [rho, s] using hval'
  have hpowAll : ∀ b : Bs, (rho b) ^ 5 = 1 := by
    intro b
    have hb5 : b ^ 5 = 1 := by
      apply Subtype.ext
      simpa using hBs.2 (b : G) b.2
    have hb5Action : action b ^ 5 = 1 := by
      rw [← map_pow, hb5, map_one]
    have hb5Inn : actionInner b ^ 5 = 1 := by
      apply Subtype.ext
      simpa [actionInner] using hb5Action
    have hb5U : (actionInner.rangeRestrict b) ^ 5 = 1 := by
      apply Subtype.ext
      simpa using hb5Inn
    have := congrArg s hb5U
    simpa [rho, s, map_pow] using this
  refine ⟨rho, hconjAll, hpowAll, ?_⟩
  ext b
  rw [MonoidHom.mem_ker, MonoidHom.mem_ker]
  constructor
  · intro hb
    have hconj := hconjAll b
    rw [hb, map_one] at hconj
    exact hconj.symm
  · intro hb
    have hInner : actionInner b = 1 := by
      apply Subtype.ext
      simpa [actionInner] using hb
    have hRange : actionInner.rangeRestrict b = 1 := by
      apply Subtype.ext
      simpa using hInner
    change rho b = 1
    dsimp [rho]
    rw [hRange, map_one]


theorem ggF4N2_x_data
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {y : G} {K : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hNbr : GGNbr 5 B x D J y K) :
    x ∈ Bs ∧ x ∉ Subgroup.zpowers y ∧ orderOf y = 5 ∧
      D = Subgroup.closure ({x, y} : Set G) ∧ Nat.card D = 5 ^ 2 ∧
      IsElemAbelian 5 D := by
  have hcfg : GGConfig 5 B Bs x L D J := hR.1
  have hS : LargeEvenSStar 5 B x L := hcfg.1.2.2.2.2.2.2.1
  have hBsElem : IsElemAbelian 5 Bs := hcfg.2.1.2.1
  have hxB : x ∈ B := hS.2.1
  have hxBs : x ∈ Bs := hcfg.2.1.1 hxB
  obtain ⟨hDB, hDe, hDcard, hxD, -, -, -⟩ := hcfg.2.2.1
  have hDclosure : D = Subgroup.closure ({x, y} : Set G) := hNbr.2.1
  have hyB : y ∈ B := hNbr.1.2.1
  have hy1 : y ≠ 1 := hNbr.1.2.2.1
  have hyBs : y ∈ Bs := hcfg.2.1.1 hyB
  have hy5 : y ^ 5 = 1 := hBsElem.2 y hyBs
  have hyord : orderOf y = 5 := orderOf_eq_prime hy5 hy1
  have hxnot : x ∉ Subgroup.zpowers y := by
    intro hxZ
    have hDle : D ≤ Subgroup.zpowers y := by
      rw [hDclosure]
      rw [Subgroup.closure_le]
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with hzx | hzy
      · simpa [hzx] using hxZ
      · simpa [hzy] using Subgroup.mem_zpowers y
    have hcardle : Nat.card D ≤ Nat.card (Subgroup.zpowers y) :=
      Subgroup.card_le_of_le hDle
    rw [hDcard, Nat.card_zpowers, hyord] at hcardle
    norm_num at hcardle
  exact ⟨hxBs, hxnot, hyord, hDclosure, hDcard, hDe⟩

theorem ggF4N2_action_x_orderFive
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {y : G} {K : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hNbr : GGNbr 5 B x D J y K)
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    (hBsN : Bs ≤ Subgroup.normalizer (K : Set G))
    (hxBs : x ∈ Bs) :
    let action : Bs →* MulAut K :=
      K.normalizerMonoidHom.comp (Subgroup.inclusion hBsN)
    orderOf (action ⟨x, hxBs⟩) = 5 ∧ action ⟨x, hxBs⟩ ≠ 1 := by
  let action : Bs →* MulAut K :=
    K.normalizerMonoidHom.comp (Subgroup.inclusion hBsN)
  obtain ⟨-, hxnot, -, -, -, -⟩ := ggF4N2_x_data hR hNbr
  obtain ⟨-, -, hpow, hnontriv⟩ := ggF4N2_Bs_action_data hR hNbr hL hBsN
  have hxpow : action ⟨x, hxBs⟩ ^ 5 = 1 := hpow ⟨x, hxBs⟩
  have hxne : action ⟨x, hxBs⟩ ≠ 1 := hnontriv ⟨x, hxBs⟩ hxnot
  exact ⟨orderOf_eq_prime hxpow hxne, hxne⟩

theorem ggF4N2_exists_orderFive_conj_of_original_x
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {y : G} {K : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hNbr : GGNbr 5 B x D J y K)
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    (hK : GGCentralImage .PSL 6 2 K) :
    ∃ a : K, orderOf a = 5 ∧
      (∀ k : K, x * (k : G) * x⁻¹ = ((a * k * a⁻¹ : K) : G)) ∧
      K ⊓ Subgroup.centralizer ({x} : Set G) =
        (Subgroup.centralizer ({a} : Set K)).map K.subtype := by
  obtain ⟨hxBs, hxnot, -, -, -, -⟩ := ggF4N2_x_data hR hNbr
  have hBsN : Bs ≤ Subgroup.normalizer (K : Set G) := ggF4N2_Bs_le_normalizer_K hR hNbr hL
  let action : Bs →* MulAut K :=
    K.normalizerMonoidHom.comp (Subgroup.inclusion hBsN)
  obtain ⟨-, -, hpow, hnontriv⟩ := ggF4N2_Bs_action_data hR hNbr hL hBsN
  have hxpow : action ⟨x, hxBs⟩ ^ 5 = 1 := hpow ⟨x, hxBs⟩
  have hxne : action ⟨x, hxBs⟩ ≠ 1 := hnontriv ⟨x, hxBs⟩ hxnot
  obtain ⟨a, haord, haconj⟩ :=
    ggF4N2_exists_orderFive_conj hK (action ⟨x, hxBs⟩) hxpow hxne
  have hact : action = CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.actK hBsN := rfl
  have hxact : ∀ k : K,
      ((action ⟨x, hxBs⟩ k : K) : G) = x * (k : G) * x⁻¹ := by
    intro k
    rw [hact]
    exact CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.coe_actK hBsN ⟨x, hxBs⟩ k
  have hpoint : ∀ k : K,
      x * (k : G) * x⁻¹ = ((a * k * a⁻¹ : K) : G) := by
    intro k
    have hk := congrArg (fun f : MulAut K => f k) haconj
    calc x * (k : G) * x⁻¹ = ((action ⟨x, hxBs⟩ k : K) : G) := (hxact k).symm
      _ = (((MulAut.conj a) k : K) : G) := by rw [hk]
      _ = ((a * k * a⁻¹ : K) : G) := by rfl
  have hcent : K ⊓ Subgroup.centralizer ({x} : Set G) =
      (Subgroup.centralizer ({a} : Set K)).map K.subtype := by
    ext k
    constructor
    · intro hk
      have hkK : k ∈ K := hk.1
      have hkx : k * x = x * k := by
        exact Subgroup.mem_centralizer_singleton_iff.mp hk.2
      refine Subgroup.mem_map.mpr ⟨⟨k, hkK⟩, ?_, rfl⟩
      have hfixx : x * k * x⁻¹ = k := by
        rw [← hkx]
        group
      have hfixa_amb : ((a * (⟨k, hkK⟩ : K) * a⁻¹ : K) : G) = k := by
        have hkconj := congrArg (fun f : MulAut K => f ⟨k, hkK⟩) haconj
        have h := congrArg (fun z : K => (z : G)) hkconj
        rw [hxact ⟨k, hkK⟩, hfixx] at h
        simpa [MulAut.conj_apply] using h
      have hfixa : a * (⟨k, hkK⟩ : K) * a⁻¹ = ⟨k, hkK⟩ := Subtype.ext hfixa_amb
      have hcommA : (⟨k, hkK⟩ : K) * a = a * ⟨k, hkK⟩ :=
        (mul_inv_eq_iff_eq_mul.mp hfixa).symm
      simpa [Subgroup.mem_centralizer_singleton_iff] using hcommA
    · intro hk
      obtain ⟨kK, hkKa, hkval⟩ := Subgroup.mem_map.mp hk
      subst hkval
      refine ⟨kK.2, ?_⟩
      have hcommA : kK * a = a * kK :=
        Subgroup.mem_centralizer_singleton_iff.mp hkKa
      have hfixa : a * kK * a⁻¹ = kK := by
        rw [← hcommA]
        group
      have hfixx_amb : x * (kK : G) * x⁻¹ = (kK : G) := by
        have hkconj := congrArg (fun f : MulAut K => f kK) haconj
        have h := congrArg (fun z : K => (z : G)) hkconj
        rw [hxact kK] at h
        have hfixa' : ((MulAut.conj a) kK : K) = kK := by
          rw [MulAut.conj_apply]
          exact hfixa
        rw [hfixa'] at h
        simpa [eq_comm] using h
      have hcommX : kK * x = x * kK := by
        have := (mul_inv_eq_iff_eq_mul.mp hfixx_amb).symm
        exact this
      simpa [Subgroup.mem_centralizer_singleton_iff] using hcommX
  exact ⟨a, haord, hpoint, hcent⟩

theorem ggF4N2_exists_universal_action_lift
    {G : Type} [Group G] [Finite G]
    {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {y : G} {K : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hNbr : GGNbr 5 B x D J y K)
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    (hK : GGCentralImage .PSL 6 2 K) :
    ∃ ψ : Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2) →* K,
      Function.Surjective ψ ∧
      ψ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2)) ∧
      ∃ rho : Bs →* Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2),
        (∀ b : Bs,
          MulAut.conj (ψ (rho b)) =
            (K.normalizerMonoidHom.comp
              (Subgroup.inclusion (ggF4N2_Bs_le_normalizer_K hR hNbr hL))) b) ∧
        (∀ (b : Bs) (k : K),
          ψ (rho b) * k * (ψ (rho b))⁻¹ =
            (K.normalizerMonoidHom.comp
              (Subgroup.inclusion (ggF4N2_Bs_le_normalizer_K hR hNbr hL))) b k) ∧
        (∀ b : Bs, (rho b) ^ 5 = 1) ∧
        rho.ker = (Subgroup.zpowers y).subgroupOf Bs ∧
        Nat.card rho.range = 5 ^ 3 := by
  classical
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  let F := GaloisField 2 2
  let S := Matrix.SpecialLinearGroup (Fin 6) F
  let action : Bs →* MulAut K :=
    K.normalizerMonoidHom.comp
      (Subgroup.inclusion (ggF4N2_Bs_le_normalizer_K hR hNbr hL))
  have hBsElem : IsElemAbelian 5 Bs := hR.1.2.1.2.1
  have hActionData := ggF4N2_Bs_action_data hR hNbr hL
    (ggF4N2_Bs_le_normalizer_K hR hNbr hL)
  have hActionData' : action.ker = (Subgroup.zpowers y).subgroupOf Bs ∧
      Nat.card action.range = 5 ^ 3 ∧
      (∀ b : Bs, action b ^ 5 = 1) ∧
      (∀ b : Bs, (b : G) ∉ Subgroup.zpowers y → action b ≠ 1) := by
    simpa [action] using hActionData
  obtain ⟨hActionKer, hActionRange, _hActionPow, _hActionNontriv⟩ := hActionData'
  obtain ⟨rhoK, hConjK, hPowK, hKerK⟩ :=
    ggF4N2_exists_coherent_internal_lift hK hBsElem action
  have hRhoKAction : rhoK.ker = (Subgroup.zpowers y).subgroupOf Bs :=
    hKerK.trans hActionKer
  obtain ⟨ψG, _hAdm, hKerG, hRangeG⟩ := hK
  let ψK : S →* K := ψG.codRestrict K (fun s => by
    rw [← hRangeG]
    exact ⟨s, rfl⟩)
  have hψSurj : Function.Surjective ψK := by
    intro k
    have hk : (k : G) ∈ ψG.range := by rw [hRangeG]; exact k.2
    obtain ⟨s, hs⟩ := hk
    exact ⟨s, Subtype.ext hs⟩
  have hψKer : ψK.ker ≤ Subgroup.center S := by
    intro s hs
    apply hKerG
    have h : ψG s = 1 := congrArg Subtype.val (MonoidHom.mem_ker.mp hs)
    exact MonoidHom.mem_ker.mpr h
  have hF : Nat.card F = 4 := by
    simpa using GaloisField.card 2 2 (by norm_num)
  have hCenterCard : Nat.card (Subgroup.center S) = 3 := by
    dsimp [S]
    rw [CFSG.OrderReductions.LinearOrders.card_specialLinear_center F 6 (by norm_num), hF]
    norm_num
  have hkerDvd : Nat.card ψK.ker ∣ Nat.card (Subgroup.center S) :=
    Subgroup.card_dvd_of_le hψKer
  have hnot5ψ : ¬ 5 ∣ Nat.card ψK.ker := by
    have h3 : Nat.card ψK.ker ∣ 3 := by simpa [hCenterCard] using hkerDvd
    intro h5
    exact (by norm_num : ¬ (5 : ℕ) ∣ 3) (h5.trans h3)
  have hBsP : IsPGroup 5 Bs := by
    rw [IsPGroup.iff_orderOf]
    intro b
    have hb5 : b ^ 5 = 1 := by
      apply Subtype.ext
      simpa using hBsElem.2 (b : G) b.2
    have hdvd : orderOf b ∣ 5 := orderOf_dvd_of_pow_eq_one hb5
    rcases (Nat.dvd_prime Nat.prime_five).mp hdvd with h1 | h5
    · exact ⟨0, by simp [h1]⟩
    · exact ⟨1, by simp [h5]⟩
  have hUK : IsPGroup 5 rhoK.range :=
    hBsP.of_surjective rhoK.rangeRestrict rhoK.rangeRestrict_surjective
  let s : rhoK.range →* S :=
    CFSG.LieType.CentralExt.pLiftHom hψSurj hψKer hnot5ψ hUK
  let rho : Bs →* S := s.comp rhoK.rangeRestrict
  have hψRho : ∀ b : Bs, ψK (rho b) = rhoK b := by
    intro b
    have h := CFSG.LieType.CentralExt.map_pLiftHom hψSurj hψKer hnot5ψ hUK
      (rhoK.rangeRestrict b)
    simpa [rho, s] using h
  have hConj : ∀ b : Bs, MulAut.conj (ψK (rho b)) = action b := by
    intro b
    rw [hψRho b]
    exact hConjK b
  have hPoint : ∀ (b : Bs) (k : K),
      ψK (rho b) * k * (ψK (rho b))⁻¹ = action b k := by
    intro b k
    have h := congrArg (fun f : MulAut K => f k) (hConj b)
    simpa [MulAut.conj_apply] using h
  have hPowRho : ∀ b : Bs, (rho b) ^ 5 = 1 := by
    intro b
    have hb5 : b ^ 5 = 1 := by
      apply Subtype.ext
      simpa using hBsElem.2 (b : G) b.2
    have hb5K : (rhoK.rangeRestrict b) ^ 5 = 1 := by
      apply Subtype.ext
      simpa using hPowK b
    have := congrArg s hb5K
    simpa [rho, s, map_pow] using this
  have hRhoKer : rho.ker = rhoK.ker := by
    ext b
    rw [MonoidHom.mem_ker, MonoidHom.mem_ker]
    constructor
    · intro hb
      have h := congrArg ψK hb
      simpa [hψRho b] using h
    · intro hb
      have hu : rhoK.rangeRestrict b = 1 := by
        apply Subtype.ext
        simpa using hb
      change s (rhoK.rangeRestrict b) = 1
      rw [hu, map_one]
  have hRhoAction : rho.ker = (Subgroup.zpowers y).subgroupOf Bs :=
    hRhoKer.trans hRhoKAction
  have hcardRhoK : Nat.card rhoK.range = Nat.card action.range := by
    calc
      Nat.card rhoK.range = Nat.card (Bs ⧸ rhoK.ker) :=
        (Nat.card_congr (QuotientGroup.quotientKerEquivRange rhoK).toEquiv).symm
      _ = Nat.card (Bs ⧸ action.ker) := by rw [hKerK]
      _ = Nat.card action.range :=
        Nat.card_congr (QuotientGroup.quotientKerEquivRange action).toEquiv
  have hcardRho : Nat.card rho.range = Nat.card rhoK.range := by
    calc
      Nat.card rho.range = Nat.card (Bs ⧸ rho.ker) :=
        (Nat.card_congr (QuotientGroup.quotientKerEquivRange rho).toEquiv).symm
      _ = Nat.card (Bs ⧸ rhoK.ker) := by rw [hRhoKer]
      _ = Nat.card rhoK.range :=
        Nat.card_congr (QuotientGroup.quotientKerEquivRange rhoK).toEquiv
  have hcardRange : Nat.card rho.range = 5 ^ 3 :=
    hcardRho.trans (hcardRhoK.trans hActionRange)
  exact ⟨ψK, hψSurj, hψKer, rho, hConj, hPoint, hPowRho, hRhoAction, hcardRange⟩

theorem ggF4N2K_plane_basis
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {y : G} {K : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hNbr : GGNbr 5 B x D J y K)
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    (hK : GGCentralImage .PSL 6 2 K) :
    ∃ a : K, orderOf a = 5 ∧ (a : G) ∈ D ∧
      D = Subgroup.zpowers y ⊔ Subgroup.zpowers (a : G) ∧
      (∀ k : K, x * (k : G) * x⁻¹ = ((a * k * a⁻¹ : K) : G)) := by
  obtain ⟨hxBs, hxNot, hyOrder, hDclosure, _, _⟩ := ggF4N2_x_data hR hNbr
  have hcfg := hR.1
  have hpre := hcfg.2.2.1
  have hBsElem : IsElemAbelian 5 Bs := hcfg.2.1.2.1
  let hBsN := ggF4N2_Bs_le_normalizer_K hR hNbr hL
  let action : Bs →* MulAut K := K.normalizerMonoidHom.comp (Subgroup.inclusion hBsN)
  obtain ⟨_, _, hActionPow, hActionNe⟩ := ggF4N2_Bs_action_data hR hNbr hL hBsN
  obtain ⟨rho, hConj, hPow, hKer⟩ := ggF4N2_exists_coherent_internal_lift hK hBsElem action
  let xB : Bs := ⟨x, hxBs⟩
  let a : K := rho xB
  have hane : a ≠ 1 := by
    intro ha
    have h := hConj xB
    change MulAut.conj a = action xB at h
    rw [ha, map_one] at h
    exact hActionNe xB hxNot h.symm
  have ha5 : a ^ 5 = 1 := hPow xB
  have haOrder : orderOf a = 5 := orderOf_eq_prime ha5 hane
  have hpoint : ∀ k : K, x * (k : G) * x⁻¹ = ((a * k * a⁻¹ : K) : G) := by
    intro k
    have h := congrArg (fun f : MulAut K => ((f k : K) : G)) (hConj xB)
    simpa [a, action, xB, CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.actK,
      CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.coe_actK,
      MulAut.conj_apply] using h.symm
  have haCBs : (a : G) ∈ Subgroup.centralizer (Bs : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    let bB : Bs := ⟨b, hb⟩
    have hcommB : bB * xB = xB * bB := Subtype.ext (hBsElem.comm hb hxBs)
    have hcomm : rho bB * a = a * rho bB := by
      change rho bB * rho xB = rho xB * rho bB
      rw [← map_mul, ← map_mul, hcommB]
    have hfix : action bB a = a := by
      rw [← hConj bB, MulAut.conj_apply, hcomm]
      group
    have hfixG : b * (a : G) * b⁻¹ = (a : G) := by
      have h := congrArg Subtype.val hfix
      simpa [action, bB, CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.actK,
        CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.coe_actK] using h
    exact (mul_inv_eq_iff_eq_mul.mp hfixG)
  have haBs : (a : G) ∈ Bs := hcfg.2.1.2.2.2 a haCBs (congrArg Subtype.val ha5)
  have hJx := (ggF4N2J_isComponentOf_K_inf_centralizer_x hR hNbr hL hK).1
  have haCJ : (a : G) ∈ Subgroup.centralizer (J : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro j hj
    have hxj := Subgroup.mem_centralizer_singleton_iff.mp (hJx hj).2
    have hfixX : x * j * x⁻¹ = j := by rw [← hxj]; group
    have hfixA := (hpoint ⟨j, (hJx hj).1⟩).symm.trans hfixX
    exact (mul_inv_eq_iff_eq_mul.mp hfixA).symm
  have haD : (a : G) ∈ D := by
    rw [hpre.2.2.2.2.2.2, ggF4N2_B_eq_Bs hR hL]
    exact ⟨haBs, haCJ⟩
  have hYC : Subgroup.zpowers y ≤ Subgroup.centralizer (K : Set G) := by
    rw [← inf_centralizer_eq_zpowers_of_sHat hNbr.1]
    exact inf_le_right
  have haNot : (a : G) ∉ Subgroup.zpowers y := by
    intro haY
    have haZ : a ∈ Subgroup.center K := by
      rw [Subgroup.mem_center_iff]
      intro k
      exact Subtype.ext (Subgroup.mem_centralizer_iff.mp (hYC haY) k k.2)
    have hAone : MulAut.conj a = 1 := by
      apply DFunLike.ext
      intro k
      change a * k * a⁻¹ = k
      rw [← Subgroup.mem_center_iff.mp haZ k]
      group
    exact hActionNe xB hxNot ((hConj xB).symm.trans hAone)
  have hyD : y ∈ D := by
    rw [hDclosure]
    exact Subgroup.subset_closure (by simp)
  have hD := eq_sup_zpowers_of_card Nat.prime_five hpre.2.1 hpre.2.2.1 hyD
    hNbr.1.2.2.1 haD haNot
  exact ⟨a, haOrder, haD, hD, hpoint⟩
theorem ggF4N2_residual_actor_mem_parameter_line
    {G : Type} [Group G] [Finite G] {K : Subgroup G} {c y : G}
    (hc : c ∈ Subgroup.centralizer (K : Set G))
    (hy : y ∈ Subgroup.centralizer (K : Set G))
    (hc5 : c ^ 5 = 1) (hy5 : orderOf y = 5) (hcy : Commute c y)
    (hcyc : ∀ P : Subgroup G, P ≤ Subgroup.centralizer (K : Set G) →
      IsPGroup 5 P → IsCyclic P) : c ∈ Subgroup.zpowers y := by
  let W : Subgroup G := Subgroup.zpowers c ⊔ Subgroup.zpowers y
  have hyPow : y ^ 5 = 1 := by rw [← hy5]; exact pow_orderOf_eq_one y
  have hW : IsElemAbelian 5 W :=
    TableB.isElemAbelian_sup (CFSG.Open.isElemAbelian_zpowers hc5)
      (CFSG.Open.isElemAbelian_zpowers hyPow) (by
        intro a ha b hb
        obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp ha
        obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hb
        exact (hcy.zpow_zpow m n).eq)
  have hWC : W ≤ Subgroup.centralizer (K : Set G) :=
    sup_le (Subgroup.zpowers_le.mpr hc) (Subgroup.zpowers_le.mpr hy)
  have hWP : IsPGroup 5 W := fun w => ⟨1, Subtype.ext (by simpa using hW.2 w w.2)⟩
  have hWcard : Nat.card W ≤ 5 :=
    TableB.card_le_of_isCyclic (by norm_num) (hcyc W hWC hWP) hW.2
  have hycard : Nat.card (Subgroup.zpowers y) = 5 := by rw [Nat.card_zpowers, hy5]
  have hEq : Subgroup.zpowers y = W :=
    Subgroup.eq_of_le_of_card_ge le_sup_right (by rw [hycard]; exact hWcard)
  rw [hEq]
  exact Subgroup.mem_sup_left (Subgroup.mem_zpowers c)

theorem ggF4N2_exists_actual_torus_data
    {G : Type} [Group G] [Finite G]
    {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {y : G} {K : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hNbr : GGNbr 5 B x D J y K)
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    (hK : GGCentralImage .PSL 6 2 K) :
    Bs = Subgroup.zpowers y ⊔ (Bs ⊓ K) ∧
    Disjoint (Subgroup.zpowers y) K ∧
    Nat.card (Bs ⊓ K : Subgroup G) = 5 ^ 3 ∧
    ∃ ψ : Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2) →* K,
      ∃ rho : Bs →* Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2),
        Function.Surjective ψ ∧
        ψ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2)) ∧
        (∀ b : Bs, MulAut.conj (ψ (rho b)) =
          (K.normalizerMonoidHom.comp
            (Subgroup.inclusion (ggF4N2_Bs_le_normalizer_K hR hNbr hL))) b) ∧
        (∀ (b : Bs) (k : K),
          ψ (rho b) * k * (ψ (rho b))⁻¹ =
            (K.normalizerMonoidHom.comp
              (Subgroup.inclusion (ggF4N2_Bs_le_normalizer_K hR hNbr hL))) b k) ∧
        (∀ b : Bs, (rho b) ^ 5 = 1) ∧
        rho.ker = (Subgroup.zpowers y).subgroupOf Bs ∧
        Nat.card rho.range = 5 ^ 3 ∧
        (K.subtype.comp (ψ.comp rho)).range = Bs ⊓ K := by
  obtain ⟨ψ, hψSurj, hψKer, rho, hConj, hPoint, hPow, hrhoKer, hrhoCard⟩ :=
    ggF4N2_exists_universal_action_lift hR hNbr hL hK
  have hBsN : Bs ≤ Subgroup.normalizer (K : Set G) :=
    ggF4N2_Bs_le_normalizer_K hR hNbr hL
  let action : Bs →* MulAut K :=
    K.normalizerMonoidHom.comp (Subgroup.inclusion hBsN)
  have hAction := ggF4N2_Bs_action_data hR hNbr hL hBsN
  have hAction' : action.ker = (Subgroup.zpowers y).subgroupOf Bs ∧
      Nat.card action.range = 5 ^ 3 ∧
      (∀ b : Bs, action b ^ 5 = 1) ∧
      (∀ b : Bs, (b : G) ∉ Subgroup.zpowers y → action b ≠ 1) := by
    simpa [action] using hAction
  obtain ⟨hActionKer, _hActionRange, _hActionPow, _hActionNontriv⟩ := hAction'
  have hBeq : B = Bs := ggF4N2_B_eq_Bs hR hL
  have hBsElem : IsElemAbelian 5 Bs := hR.1.2.1.2.1
  haveI : IsMulCommutative Bs := hBsElem.1
  have hyB : y ∈ B := hNbr.1.2.1
  have hyBs : y ∈ Bs := by
    rwa [hBeq] at hyB
  have hy1 : y ≠ 1 := hNbr.1.2.2.1
  have hy5 : orderOf y = 5 := by
    exact orderOf_eq_prime (hBsElem.2 y hyBs) hy1
  have hyKer : (⟨y, hyBs⟩ : Bs) ∈ action.ker := by
    rw [hActionKer]
    exact ⟨1, zpow_one y⟩
  have hActionY : action ⟨y, hyBs⟩ = 1 := MonoidHom.mem_ker.mp hyKer
  have hyCentral : y ∈ Subgroup.centralizer (K : Set G) := by
    have hkerN : Subgroup.inclusion hBsN ⟨y, hyBs⟩ ∈ K.normalizerMonoidHom.ker := by
      rw [MonoidHom.mem_ker]
      simpa [action] using hActionY
    rw [Subgroup.normalizerMonoidHom_ker] at hkerN
    exact Subgroup.mem_subgroupOf.mp hkerN
  have hcyc : ∀ P : Subgroup G, P ≤ Subgroup.centralizer (K : Set G) →
      IsPGroup 5 P → IsCyclic P :=
    CFSG.all_pSubgroups_isCyclic_of_pRank_le_one Nat.prime_five (by norm_num)
      (ggF4N2_pRank_five_centralizer_K_le_one hR hL hK)
  have hActor : ∀ b : Bs,
      (ψ (rho b) : G) ∈ Bs ⊓ K ∧
      ∃ c : G, c ∈ Subgroup.zpowers y ∧ (b : G) = c * ψ (rho b) := by
    intro b
    let k : G := ψ (rho b)
    have hkK : k ∈ K := (ψ (rho b)).2
    let c : G := (b : G) * k⁻¹
    have hk5 : k ^ 5 = 1 := by
      calc
        k ^ 5 = ψ ((rho b) ^ 5) := by simp [k]
        _ = 1 := by simp [hPow b]
    have hkFixed : action b ⟨k, hkK⟩ = ⟨k, hkK⟩ := by
      have h := hPoint b ⟨k, hkK⟩
      have hleft : ψ (rho b) * ⟨k, hkK⟩ * (ψ (rho b))⁻¹ = ⟨k, hkK⟩ := by
        apply Subtype.ext
        simp [k]
      rw [← h, hleft]
    have hbk : (b : G) * k * (b : G)⁻¹ = k := by
      have h := congrArg Subtype.val hkFixed
      simpa [action, Subgroup.normalizerMonoidHom_apply_apply_coe,
        Subgroup.coe_inclusion] using h
    have hcomm_bk : Commute (b : G) k := by
      show (b : G) * k = k * (b : G)
      calc
        (b : G) * k = ((b : G) * k * (b : G)⁻¹) * (b : G) := by group
        _ = k * (b : G) := by rw [hbk]
    have hc5 : c ^ 5 = 1 := by
      have h := hcomm_bk.inv_right.mul_pow 5
      rw [show c = (b : G) * k⁻¹ by rfl, h]
      simp [hBsElem.2 (b : G) b.2, hk5]
    have hkx : ∀ x : G, x ∈ K → k * x * k⁻¹ = (b : G) * x * (b : G)⁻¹ := by
      intro x hx
      have h := congrArg (fun f : MulAut K => f ⟨x, hx⟩) (hConj b)
      have hval := congrArg Subtype.val h
      simpa [action, MulAut.conj_apply,
        Subgroup.normalizerMonoidHom_apply_apply_coe, Subgroup.coe_inclusion] using hval
    have hcCentral : c ∈ Subgroup.centralizer (K : Set G) := by
      rw [Subgroup.mem_centralizer_iff]
      intro x hx
      have hcentx : c * x * c⁻¹ = x := by
        have hc_eq : c = k⁻¹ * (b : G) := by
          rw [show c = (b : G) * k⁻¹ by rfl]
          exact (hcomm_bk.symm.inv_left).eq.symm
        rw [hc_eq]
        calc
          (k⁻¹ * (b : G)) * x * (k⁻¹ * (b : G))⁻¹ = k⁻¹ * ((b : G) * x * (b : G)⁻¹) * k := by group
          _ = k⁻¹ * (k * x * k⁻¹) * k := by rw [hkx x hx]
          _ = x := by group
      have hcx : c * x = x * c := by
        calc
          c * x = (c * x * c⁻¹) * c := by group
          _ = x * c := by rw [hcentx]
      exact hcx.symm
    have hby : Commute (b : G) y :=
      Subgroup.mul_comm_of_mem_isMulCommutative Bs b.2 hyBs
    have hky : Commute k y := by
      show k * y = y * k
      exact Subgroup.mem_centralizer_iff.mp hyCentral k hkK
    have hcy : Commute c y := by
      rw [show c = (b : G) * k⁻¹ by rfl]
      exact hby.mul_left hky.inv_left
    have hcY : c ∈ Subgroup.zpowers y :=
      ggF4N2_residual_actor_mem_parameter_line hcCentral hyCentral hc5 hy5 hcy hcyc
    have hcBs : c ∈ Bs := (Subgroup.zpowers_le.mpr hyBs) hcY
    have hk_eq : k = c⁻¹ * (b : G) := by
      rw [show c = (b : G) * k⁻¹ by rfl]
      group
    have hkBs : k ∈ Bs := by
      rw [hk_eq]
      exact Bs.mul_mem (Bs.inv_mem hcBs) b.2
    have hkMem : k ∈ Bs ⊓ K := ⟨hkBs, hkK⟩
    have hb_eq : (b : G) = c * k := by
      rw [show c = (b : G) * k⁻¹ by rfl]
      group
    exact ⟨by simpa [k] using hkMem, ⟨c, hcY, by simpa [k] using hb_eq⟩⟩
  have hBsEq : Bs = Subgroup.zpowers y ⊔ (Bs ⊓ K) := by
    apply le_antisymm
    · intro b hb
      let bb : Bs := ⟨b, hb⟩
      obtain ⟨hkMem, c, hcY, hb_eq⟩ := hActor bb
      change (bb : G) ∈ Subgroup.zpowers y ⊔ (Bs ⊓ K)
      rw [hb_eq]
      exact Subgroup.mul_mem (Subgroup.zpowers y ⊔ (Bs ⊓ K)) (Subgroup.mem_sup_left hcY) (Subgroup.mem_sup_right hkMem)
    · exact sup_le (Subgroup.zpowers_le.mpr hyBs) inf_le_left
  have hDisjoint : Disjoint (Subgroup.zpowers y) K := by
    rw [disjoint_iff]
    apply le_antisymm
    · intro z hz
      have hzY : z ∈ Subgroup.zpowers y := hz.1
      have hzK : z ∈ K := hz.2
      have hzCent : z ∈ Subgroup.centralizer (K : Set G) :=
        (Subgroup.zpowers_le.mpr hyCentral) hzY
      have hzCenter : (⟨z, hzK⟩ : K) ∈ Subgroup.center K := by
        rw [Subgroup.mem_center_iff]
        intro k
        apply Subtype.ext
        exact Subgroup.mem_centralizer_iff.mp hzCent (k : G) k.2
      have hz3 : z ^ 3 = 1 := by
        have h := ggF4N2_central_cube hK hzCenter
        simpa using congrArg Subtype.val h
      have hz5 : z ^ 5 = 1 := by
        have hdvd : orderOf z ∣ 5 := by
          simpa [hy5] using orderOf_dvd_of_mem_zpowers hzY
        exact (orderOf_dvd_iff_pow_eq_one).mp hdvd
      have hdvd : orderOf z ∣ Nat.gcd 3 5 :=
        Nat.dvd_gcd (orderOf_dvd_of_pow_eq_one hz3) (orderOf_dvd_of_pow_eq_one hz5)
      have h1 : orderOf z = 1 := Nat.dvd_one.mp (by simpa using hdvd)
      exact Subgroup.mem_bot.mpr (orderOf_eq_one_iff.mp h1)
    · exact bot_le
  have hCent : Bs ⊓ K ≤ Subgroup.centralizer (Subgroup.zpowers y : Set G) := by
    intro b hb
    rw [Subgroup.mem_centralizer_iff]
    intro z hz
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hz
    have hby : Commute b y :=
      Subgroup.mul_comm_of_mem_isMulCommutative Bs hb.1 hyBs
    exact (hby.zpow_right n).eq.symm
  have hnormal : Bs ⊓ K ≤ Subgroup.normalizer (Subgroup.zpowers y : Set G) :=
    hCent.trans (Subgroup.centralizer_le_normalizer (Subgroup.zpowers y : Set G))
  have hDisjInf : Disjoint (Subgroup.zpowers y) (Bs ⊓ K) :=
    hDisjoint.mono_right inf_le_right
  have hcardSup : Nat.card (Subgroup.zpowers y ⊔ (Bs ⊓ K) : Subgroup G) =
      Nat.card (Subgroup.zpowers y : Subgroup G) * Nat.card (Bs ⊓ K : Subgroup G) :=
    CFSG.GorensteinWalter.card_sup_eq_mul_of_disjoint_of_le_normalizer
      (Subgroup.zpowers y) (Bs ⊓ K) hnormal hDisjInf
  have hyCard : Nat.card (Subgroup.zpowers y : Subgroup G) = 5 := by
    rw [Nat.card_zpowers, hy5]
  have hcardInt : Nat.card (Bs ⊓ K : Subgroup G) = 5 ^ 3 := by
    have hcardEq : 5 ^ 4 = 5 * Nat.card (Bs ⊓ K : Subgroup G) := by
      calc
        5 ^ 4 = Nat.card Bs := (ggF4N2Rank hR hL).1.symm
        _ = Nat.card (Subgroup.zpowers y ⊔ (Bs ⊓ K) : Subgroup G) := by
          simpa using congrArg (fun H : Subgroup G => Nat.card H) hBsEq
        _ = Nat.card (Subgroup.zpowers y : Subgroup G) * Nat.card (Bs ⊓ K : Subgroup G) := hcardSup
        _ = 5 * Nat.card (Bs ⊓ K : Subgroup G) := by rw [hyCard]
    exact Nat.mul_left_cancel (by norm_num : (0 : ℕ) < 5) (by
      calc
        5 * Nat.card (Bs ⊓ K : Subgroup G) = 5 ^ 4 := hcardEq.symm
        _ = 5 * 5 ^ 3 := by norm_num)
  let rhoG : Bs →* G := K.subtype.comp (ψ.comp rho)
  have hRange : rhoG.range = Bs ⊓ K := by
    apply le_antisymm
    · rintro g ⟨b, rfl⟩
      exact (hActor b).1
    · intro t ht
      let b : Bs := ⟨t, ht.1⟩
      obtain ⟨_hkMem, c, hcY, hb_eq⟩ := hActor b
      have hb_eq' : t = c * (ψ (rho b) : G) := by
        simpa [b] using hb_eq
      have hcK : c ∈ K := by
        have hc_eq : c = t * (ψ (rho b) : G)⁻¹ := by
          rw [hb_eq']
          group
        rw [hc_eq]
        exact K.mul_mem ht.2 (K.inv_mem (ψ (rho b)).2)
      have hc1 : c = 1 := by
        have hzBot : c ∈ (⊥ : Subgroup G) := hDisjoint.le_bot ⟨hcY, hcK⟩
        simpa using hzBot
      have ht_eq : t = (ψ (rho b) : G) := by
        rw [hb_eq', hc1, one_mul]
      exact ⟨b, by simpa [rhoG] using ht_eq.symm⟩
  exact ⟨hBsEq, hDisjoint, hcardInt, ψ, rho, hψSurj, hψKer, hConj, hPoint, hPow,
    hrhoKer, hrhoCard, by simpa [rhoG] using hRange⟩

end NativeKOuter

theorem ggF4N2_actual_intersection_isSylow
    {G : Type} [Group G] [Finite G]
    {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {y : G} {K : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hNbr : GGNbr 5 B x D J y K)
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    (hK : GGCentralImage .PSL 6 2 K) :
    ∃ P : Sylow 5 K, (P : Subgroup K) = (Bs ⊓ K).subgroupOf K := by
  classical
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  let S := Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2)
  let H : Subgroup K := (Bs ⊓ K).subgroupOf K
  obtain ⟨_hBsEq, _hDisj, hCardInt, _ψ, _ρ, _hSurj, _hKer, _hConj, _hPoint,
    _hPow, _hRhoKer, _hRhoCard, _hRange⟩ :=
    ggF4N2_exists_actual_torus_data hR hNbr hL hK
  have hHcard : Nat.card H = 5 ^ 3 := by
    change Nat.card ((Bs ⊓ K).subgroupOf K) = 5 ^ 3
    rw [← hCardInt]
    exact Nat.card_congr
      (Subgroup.subgroupOfEquivOfLe (H := Bs ⊓ K) (K := K) inf_le_right).toEquiv
  have hHp : IsPGroup 5 H :=
    IsPGroup.of_card (p := 5) (n := 3) (by simpa using hHcard)
  have hnotS54 : ¬ 5 ^ 4 ∣ Nat.card S := by
    simpa [S] using sl6_four_five_part.2
  have hnotK54 : ¬ 5 ^ 4 ∣ Nat.card K := by
    intro h54
    apply hnotS54
    obtain ⟨ψK, _hadm, _hkerK, hrangeK⟩ := hK
    have hdvd : Nat.card K ∣ Nat.card S := by
      rw [← hrangeK]
      exact Subgroup.card_range_dvd ψK
    exact h54.trans hdvd
  have hHindex : ¬ 5 ∣ H.index := by
    intro h5
    have h54 : 5 ^ 4 ∣ Nat.card K := by
      rw [← H.index_mul_card]
      rw [show 5 ^ 4 = 5 * 5 ^ 3 by norm_num]
      exact mul_dvd_mul h5 (by rw [hHcard])
    exact hnotK54 h54
  let P : Sylow 5 K := hHp.toSylow hHindex
  exact ⟨P, rfl⟩

theorem ggF4N2_exists_actual_lift_sylow
    {G : Type} [Group G] [Finite G]
    {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {y : G} {K : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hNbr : GGNbr 5 B x D J y K)
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    (hK : GGCentralImage .PSL 6 2 K) :
    ∃ ψ : Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2) →* K,
      ∃ rho : Bs →* Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2),
        Function.Surjective ψ ∧
        ψ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2)) ∧
        (∀ b : Bs, MulAut.conj (ψ (rho b)) =
          (K.normalizerMonoidHom.comp
            (Subgroup.inclusion (ggF4N2_Bs_le_normalizer_K hR hNbr hL))) b) ∧
        (∀ (b : Bs) (k : K),
          ψ (rho b) * k * (ψ (rho b))⁻¹ =
            (K.normalizerMonoidHom.comp
              (Subgroup.inclusion (ggF4N2_Bs_le_normalizer_K hR hNbr hL))) b k) ∧
        (∀ b : Bs, (rho b) ^ 5 = 1) ∧
        rho.ker = (Subgroup.zpowers y).subgroupOf Bs ∧
        Nat.card rho.range = 5 ^ 3 ∧
        (K.subtype.comp (ψ.comp rho)).range = Bs ⊓ K ∧
        ∃ Q : Sylow 5 (Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2)),
          (Q : Subgroup (Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2))) = rho.range := by
  classical
  haveI : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  obtain ⟨_hBsEq, _hDisj, _hCardInt, ψ, rho, hSurj, hKer, hConj, hPoint,
    hPow, hRhoKer, hRhoCard, hRange⟩ :=
    ggF4N2_exists_actual_torus_data hR hNbr hL hK
  let S := Matrix.SpecialLinearGroup (Fin 6) (GaloisField 2 2)
  have hnotS54 : ¬ 5 ^ 4 ∣ Nat.card S := by
    simpa [S] using sl6_four_five_part.2
  have hrhoP : IsPGroup 5 rho.range :=
    IsPGroup.of_card (p := 5) (n := 3) (by simpa using hRhoCard)
  have hrhoIndex : ¬ 5 ∣ rho.range.index := by
    intro h5
    have h54 : 5 ^ 4 ∣ Nat.card S := by
      rw [← Subgroup.index_mul_card (H := rho.range)]
      rw [show 5 ^ 4 = 5 * 5 ^ 3 by norm_num]
      exact mul_dvd_mul h5 (by rw [hRhoCard])
    exact hnotS54 h54
  let Q : Sylow 5 S := hrhoP.toSylow hrhoIndex
  exact ⟨ψ, rho, hSurj, hKer, hConj, hPoint, hPow, hRhoKer, hRhoCard,
    hRange, Q, rfl⟩



end

