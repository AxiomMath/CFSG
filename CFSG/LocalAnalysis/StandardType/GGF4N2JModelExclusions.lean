open CFSG.ComponentClassification.OuterAutomorphisms

theorem nonempty_quotient_center_equiv_projectiveSL_six_two
    {G : Type} [Group G] {K : Subgroup G}
    (hK : GGCentralImage .PSL 6 2 K) :
    Nonempty (↥K ⧸ Subgroup.center ↥K ≃*
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL 6 (GaloisField 2 2)) := by
  classical
  let F := GaloisField 2 2
  let S := Matrix.SpecialLinearGroup (Fin 6) F
  have hdom : (ggU .PSL 6 2).K = S := rfl
  obtain ⟨ψ, _hadm, hker, hrange⟩ := hK
  let f : S →* ↥K := MonoidHom.codRestrict ψ K (by
    intro x
    rw [← hrange]
    exact ⟨x, rfl⟩)
  have hf : Function.Surjective f := by
    intro k
    have hk : (k : G) ∈ ψ.range := by
      rw [hrange]
      exact k.2
    obtain ⟨x, hx⟩ := hk
    exact ⟨x, Subtype.ext hx⟩
  have hfker : f.ker = ψ.ker := by
    ext x
    change f x = 1 ↔ ψ x = 1
    exact Subtype.ext_iff
  have hkerS : f.ker ≤ Subgroup.center S := by
    rw [hfker]
    exact hker
  have hSq : CFSG.IsQuasisimple S :=
    CFSG.LieType.Universal.SpecialLinear.isQuasisimple (m := 5) (F := F) (by norm_num)
  obtain ⟨e0⟩ := CFSG.LocalAnalysis.ComponentInitial.center_quotient_equiv_of_surjective
    (Q := S) (R := ↥K) hSq f hf hkerS
  let eSL : (S ⧸ Subgroup.center S) ≃*
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL 6 F :=
    QuotientGroup.quotientMulEquivOfEq
      (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.scalars_eq_center 6 F).symm
  exact ⟨e0.symm.trans eSL⟩

theorem isSolvable_outer_of_centralImage_PSL_six_two
    {G : Type} [Group G] {K : Subgroup G}
    (hK : GGCentralImage .PSL 6 2 K) :
    Group.IsSolvable (Outer ↥K) := by
  classical
  let F := GaloisField 2 2
  let S := Matrix.SpecialLinearGroup (Fin 6) F
  have hdom : (ggU .PSL 6 2).K = S := rfl
  obtain ⟨ψ, _hadm, hker, hrange⟩ := hK
  let f : S →* ↥K := MonoidHom.codRestrict ψ K (by
    intro x
    rw [← hrange]
    exact ⟨x, rfl⟩)
  have hf : Function.Surjective f := by
    intro k
    have hk : (k : G) ∈ ψ.range := by
      rw [hrange]
      exact k.2
    obtain ⟨x, hx⟩ := hk
    exact ⟨x, Subtype.ext hx⟩
  have hfker : f.ker = ψ.ker := by
    ext x
    change f x = 1 ↔ ψ x = 1
    exact Subtype.ext_iff
  have hkerS : f.ker ≤ Subgroup.center S := by
    rw [hfker]
    exact hker
  have hSq : CFSG.IsQuasisimple S :=
    CFSG.LieType.Universal.SpecialLinear.isQuasisimple (m := 5) (F := F) (by norm_num)
  obtain ⟨e0⟩ := CFSG.LocalAnalysis.ComponentInitial.center_quotient_equiv_of_surjective
    (Q := S) (R := ↥K) hSq f hf hkerS
  let eSL : (S ⧸ Subgroup.center S) ≃*
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL 6 F :=
    QuotientGroup.quotientMulEquivOfEq
      (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.scalars_eq_center 6 F).symm
  let e : (↥K ⧸ Subgroup.center ↥K) ≃*
      CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL 6 F :=
    e0.symm.trans eSL
  have hOutPSL : Group.IsSolvable
      (Outer (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL 6 F)) :=
    (CFSG.LocalAnalysis.ComponentInitial.UnitaryHigher.linear_higher_schreier
      (K := F) (n := 6) (by norm_num)).2
  haveI : Group.IsSolvable
      (Outer (CFSG.LocalAnalysis.ComponentInitial.LinearFlag.projectiveSL 6 F)) := hOutPSL
  have hOutQ : Group.IsSolvable (Outer (↥K ⧸ Subgroup.center ↥K)) :=
    CFSG.ComponentClassification.OuterAutomorphisms.solvable_of_equiv e.symm
  haveI : Group.IsPerfect S := hSq.1
  haveI : Group.IsPerfect ↥K := Group.IsPerfect.ofSurjective (f := f) hf
  haveI : Group.IsSolvable (Outer (↥K ⧸ Subgroup.center ↥K)) := hOutQ
  exact CFSG.ComponentClassification.OuterAutomorphisms.solvable_of_centerQuotient ↥K


