open CFSG.LocalAnalysis.ComponentInitial
open CFSG.LocalAnalysis.ComponentInitial.LinearFlag
open CFSG.SeitzReduction.LinearPilot
open Matrix

def swap0145 : Equiv.Perm (Fin 6) := Equiv.swap 0 4 * Equiv.swap 1 5

def swap2345 : Equiv.Perm (Fin 6) := Equiv.swap 2 4 * Equiv.swap 3 5

theorem swap0145_inv : swap0145⁻¹ = swap0145 := by
  decide

theorem swap2345_inv : swap2345⁻¹ = swap2345 := by
  decide

theorem coe_signedPermutation_eq_mathlibPerm (w : Equiv.Perm (Fin 6)) :
    ((signedPermutation 6 F4 w : SL6F4) : Matrix (Fin 6) (Fin 6) F4) =
      (w⁻¹).permMatrix F4 := by
  rw [coe_signedPermutation, signedPermMatrix, permMatrix_eq]
  have hd : ∀ i : Fin 6,
      (if (i : ℕ) = 0 then ((Equiv.Perm.sign w : ℤ) : F4) else 1) = 1 := by
    intro i
    split_ifs with hi
    · rcases Int.units_eq_one_or (Equiv.Perm.sign w) with h | h <;>
        simp [h, CharTwo.neg_eq]
    · rfl
  ext i j
  rw [Matrix.diagonal_mul, hd i, one_mul]


theorem permMatrix_conj_submatrix (π : Equiv.Perm (Fin 6))
    (M : Matrix (Fin 6) (Fin 6) F4) :
    π.permMatrix F4 * M * (π⁻¹).permMatrix F4 = M.submatrix π π := by
  rw [Equiv.Perm.permMatrix, PEquiv.toMatrix_toPEquiv_mul, Equiv.Perm.permMatrix,
    PEquiv.mul_toMatrix_toPEquiv]
  simp only [Matrix.submatrix_submatrix]
  rfl


theorem signedPermutation_mul_self_of_involution (w : Equiv.Perm (Fin 6))
    (hww : w * w = 1) :
    signedPermutation 6 F4 w * signedPermutation 6 F4 w = 1 := by
  apply Subtype.ext
  change ((signedPermutation 6 F4 w : Matrix (Fin 6) (Fin 6) F4) *
      (signedPermutation 6 F4 w : Matrix (Fin 6) (Fin 6) F4)) = 1
  rw [coe_signedPermutation_eq_mathlibPerm]
  rw [← Matrix.permMatrix_mul (σ := w⁻¹) (τ := w⁻¹)]
  have h : w⁻¹ * w⁻¹ = 1 := by
    rw [← _root_.mul_inv_rev, hww, inv_one]
  rw [h, Matrix.permMatrix_one]

theorem pairEmbed_permMatrix_conj (w : Equiv.Perm (Fin 6)) (hwinv : w⁻¹ = w)
    {a b : Fin 6} (hab : a ≠ b) (A : SL2F4) :
    (w⁻¹).permMatrix F4 * (pairEmbed (K := F4) hab A : Matrix (Fin 6) (Fin 6) F4) *
        w.permMatrix F4 =
      (pairEmbed (K := F4) (w.injective.ne hab) A : Matrix (Fin 6) (Fin 6) F4) := by
  have h := permMatrix_conj_submatrix (π := w) (M := (pairEmbed (K := F4) hab A :
    Matrix (Fin 6) (Fin 6) F4))
  rw [hwinv] at h
  rw [show (w⁻¹).permMatrix F4 = w.permMatrix F4 by rw [hwinv]]
  rw [h]
  ext i j
  rw [Matrix.submatrix_apply, pairEmbed_apply, pairEmbed_apply]
  have hsymm : w.symm = w := by simpa [Equiv.Perm.inv_def] using hwinv
  have hwi : ∀ x : Fin 6, (a = w x) ↔ (x = w a) := by
    intro x
    rw [eq_comm, Equiv.apply_eq_iff_eq_symm_apply, hsymm]
  have hwj : ∀ x : Fin 6, (b = w x) ↔ (x = w b) := by
    intro x
    rw [eq_comm, Equiv.apply_eq_iff_eq_symm_apply, hsymm]
  simp [hwi, hwj, Matrix.one_apply, eq_comm]


theorem signedPermutation_conj_pairEmbed (w : Equiv.Perm (Fin 6)) (hwinv : w⁻¹ = w)
    {a b : Fin 6} (hab : a ≠ b) (A : SL2F4) :
    (MulAut.conj (signedPermutation 6 F4 w)) (pairEmbed (K := F4) hab A) =
      pairEmbed (K := F4) (w.injective.ne hab) A := by
  apply Subtype.ext
  change ((MulAut.conj (signedPermutation 6 F4 w)) (pairEmbed (K := F4) hab A) :
    Matrix (Fin 6) (Fin 6) F4) =
      (pairEmbed (K := F4) (w.injective.ne hab) A : Matrix (Fin 6) (Fin 6) F4)
  rw [MulAut.conj_apply]
  have hww : w * w = 1 := by
    simpa [hwinv] using mul_inv_cancel w
  have hgg : signedPermutation 6 F4 w * signedPermutation 6 F4 w = 1 :=
    signedPermutation_mul_self_of_involution w hww
  have hg_inv : (signedPermutation 6 F4 w)⁻¹ = signedPermutation 6 F4 w :=
    (eq_inv_of_mul_eq_one_right hgg).symm
  rw [hg_inv]
  change ((signedPermutation 6 F4 w : Matrix (Fin 6) (Fin 6) F4) *
      (pairEmbed (K := F4) hab A : Matrix (Fin 6) (Fin 6) F4) *
        (signedPermutation 6 F4 w : Matrix (Fin 6) (Fin 6) F4)) =
    (pairEmbed (K := F4) (w.injective.ne hab) A : Matrix (Fin 6) (Fin 6) F4)
  rw [coe_signedPermutation_eq_mathlibPerm]
  simpa [hwinv] using pairEmbed_permMatrix_conj w hwinv hab A


theorem zpowers_pairEmbed_map_conj (w : Equiv.Perm (Fin 6)) (hwinv : w⁻¹ = w)
    {a b : Fin 6} (hab : a ≠ b) :
    (Subgroup.zpowers (pairEmbed (K := F4) hab coordA2)).map
        (MulAut.conj (signedPermutation 6 F4 w)).toMonoidHom =
      Subgroup.zpowers (pairEmbed (K := F4) (w.injective.ne hab) coordA2) := by
  rw [MonoidHom.map_zpowers]
  congr 1
  exact signedPermutation_conj_pairEmbed w hwinv hab coordA2


theorem coordBlock01_eq_pairEmbed :
    (coordBlock01 : SL2F4 →* SL6F4) =
      pairEmbed (K := F4) (a := (0 : Fin 6)) (b := (1 : Fin 6)) (by decide) := rfl

theorem coordBlock23_eq_pairEmbed :
    (coordBlock23 : SL2F4 →* SL6F4) =
      pairEmbed (K := F4) (a := (2 : Fin 6)) (b := (3 : Fin 6)) (by decide) := rfl

theorem coordBlock45_eq_pairEmbed :
    (coordBlock45 : SL2F4 →* SL6F4) =
      pairEmbed (K := F4) (a := (4 : Fin 6)) (b := (5 : Fin 6)) (by decide) := rfl

theorem coordT01_map_conj_swap0145 :
    coordT01.map (MulAut.conj (signedPermutation 6 F4 swap0145)).toMonoidHom =
      coordT45 := by
  rw [coordT01, coordT45, coordBlock01_eq_pairEmbed, coordBlock45_eq_pairEmbed]
  have h := zpowers_pairEmbed_map_conj (w := swap0145) swap0145_inv
      (a := (0 : Fin 6)) (b := (1 : Fin 6)) (by decide)
  simp only [show swap0145 (0 : Fin 6) = 4 by decide,
      show swap0145 (1 : Fin 6) = 5 by decide] at h
  exact h

theorem coordT23_map_conj_swap0145 :
    coordT23.map (MulAut.conj (signedPermutation 6 F4 swap0145)).toMonoidHom =
      coordT23 := by
  rw [coordT23, coordBlock23_eq_pairEmbed]
  have h := zpowers_pairEmbed_map_conj (w := swap0145) swap0145_inv
      (a := (2 : Fin 6)) (b := (3 : Fin 6)) (by decide)
  simp only [show swap0145 (2 : Fin 6) = 2 by decide,
      show swap0145 (3 : Fin 6) = 3 by decide] at h
  exact h

theorem coordT45_map_conj_swap0145 :
    coordT45.map (MulAut.conj (signedPermutation 6 F4 swap0145)).toMonoidHom =
      coordT01 := by
  rw [coordT01, coordT45, coordBlock01_eq_pairEmbed, coordBlock45_eq_pairEmbed]
  have h := zpowers_pairEmbed_map_conj (w := swap0145) swap0145_inv
      (a := (4 : Fin 6)) (b := (5 : Fin 6)) (by decide)
  simp only [show swap0145 (4 : Fin 6) = 0 by decide,
      show swap0145 (5 : Fin 6) = 1 by decide] at h
  exact h

theorem coordT01_map_conj_swap2345 :
    coordT01.map (MulAut.conj (signedPermutation 6 F4 swap2345)).toMonoidHom =
      coordT01 := by
  rw [coordT01, coordBlock01_eq_pairEmbed]
  have h := zpowers_pairEmbed_map_conj (w := swap2345) swap2345_inv
      (a := (0 : Fin 6)) (b := (1 : Fin 6)) (by decide)
  simp only [show swap2345 (0 : Fin 6) = 0 by decide,
      show swap2345 (1 : Fin 6) = 1 by decide] at h
  exact h

theorem coordT23_map_conj_swap2345 :
    coordT23.map (MulAut.conj (signedPermutation 6 F4 swap2345)).toMonoidHom =
      coordT45 := by
  rw [coordT23, coordT45, coordBlock23_eq_pairEmbed, coordBlock45_eq_pairEmbed]
  have h := zpowers_pairEmbed_map_conj (w := swap2345) swap2345_inv
      (a := (2 : Fin 6)) (b := (3 : Fin 6)) (by decide)
  simp only [show swap2345 (2 : Fin 6) = 4 by decide,
      show swap2345 (3 : Fin 6) = 5 by decide] at h
  exact h

theorem coordT45_map_conj_swap2345 :
    coordT45.map (MulAut.conj (signedPermutation 6 F4 swap2345)).toMonoidHom =
      coordT23 := by
  rw [coordT23, coordT45, coordBlock23_eq_pairEmbed, coordBlock45_eq_pairEmbed]
  have h := zpowers_pairEmbed_map_conj (w := swap2345) swap2345_inv
      (a := (4 : Fin 6)) (b := (5 : Fin 6)) (by decide)
  simp only [show swap2345 (4 : Fin 6) = 2 by decide,
      show swap2345 (5 : Fin 6) = 3 by decide] at h
  exact h

theorem coordinateTorus_map_conj_swap0145 :
    coordinateTorus.map (MulAut.conj (signedPermutation 6 F4 swap0145)).toMonoidHom =
      coordinateTorus := by
  rw [coordinateTorus, Subgroup.map_sup, Subgroup.map_sup,
    coordT01_map_conj_swap0145, coordT23_map_conj_swap0145,
    coordT45_map_conj_swap0145]
  ac_rfl

theorem coordinateTorus_map_conj_swap2345 :
    coordinateTorus.map (MulAut.conj (signedPermutation 6 F4 swap2345)).toMonoidHom =
      coordinateTorus := by
  rw [coordinateTorus, Subgroup.map_sup, Subgroup.map_sup,
    coordT01_map_conj_swap2345, coordT23_map_conj_swap2345,
    coordT45_map_conj_swap2345]
  ac_rfl

theorem exists_conj_mem_coordT45 (a : SL6F4)
    (ha : a ∈ coordT01 ∨ a ∈ coordT23 ∨ a ∈ coordT45) :
    ∃ g : SL6F4,
      coordinateTorus.map (MulAut.conj g).toMonoidHom = coordinateTorus ∧
        (MulAut.conj g) a ∈ coordT45 := by
  rcases ha with ha | ha | ha
  · refine ⟨signedPermutation 6 F4 swap0145, coordinateTorus_map_conj_swap0145, ?_⟩
    rw [← coordT01_map_conj_swap0145]
    exact Subgroup.mem_map_of_mem _ ha
  · refine ⟨signedPermutation 6 F4 swap2345, coordinateTorus_map_conj_swap2345, ?_⟩
    rw [← coordT23_map_conj_swap2345]
    exact Subgroup.mem_map_of_mem _ ha
  · refine ⟨1, ?_, by simpa using ha⟩
    have hconj : MulAut.conj (1 : SL6F4) = 1 := by
      ext x
      simp [MulAut.conj_apply]
    rw [hconj]
    change coordinateTorus.map (MonoidHom.id SL6F4) = coordinateTorus
    exact Subgroup.map_id (G := SL6F4) coordinateTorus


end CFSG.StandardType.N2KCoordinate


