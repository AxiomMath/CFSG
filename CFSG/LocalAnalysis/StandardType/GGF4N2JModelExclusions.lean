open CFSG.SeitzReduction.E6Pilot

theorem exists_inverter_through_actual_block_chart
    {G : Type} [Group G] {K E J : Subgroup G} {y : G}
    (ψ : SL6F4 →* K)
    (hE : E = Subgroup.zpowers y ⊔ coordinateTorus.map (K.subtype.comp ψ))
    (hJ : J = (blockFour (K := F4)).range.map (K.subtype.comp ψ))
    (hy : y ∈ Subgroup.centralizer (K : Set G)) :
    ∃ t : G, t ∈ K ∧ t ∈ Subgroup.normalizer (E : Set G) ∧
      t ∈ Subgroup.centralizer (J : Set G) ∧
      (MulAut.conj t) y = y ∧
      (∀ a ∈ coordT45, (MulAut.conj t) ((ψ a : K) : G) = ((ψ a : K) : G)⁻¹) ∧
      (∀ a ∈ coordT01 ⊔ coordT23,
        (MulAut.conj t) ((ψ a : K) : G) = ((ψ a : K) : G)) := by
  classical
  obtain ⟨w, _hwB, hwJ, hw01, hw23, hw45, hwT⟩ :=
    n2_exists_coordT45_inverter_centralizing_blockFour
  let f : SL6F4 →* G := K.subtype.comp ψ
  let t : G := f w
  have htK : t ∈ K := (ψ w).property
  have hty : (MulAut.conj t) y = y := by
    have hcomm : t * y = y * t := (Subgroup.mem_centralizer_iff.mp hy t htK)
    change t * y * t⁻¹ = y
    rw [hcomm]
    group
  have hmapT : (coordinateTorus.map f).map (MulAut.conj t).toMonoidHom =
      coordinateTorus.map f := by
    rw [← Subgroup.map_map_conj]
    rw [hwT]
  have htE : t ∈ Subgroup.normalizer (E : Set G) := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq, hE, Subgroup.map_sup]
    rw [MonoidHom.map_zpowers]
    change Subgroup.zpowers ((MulAut.conj t) y) ⊔
      (coordinateTorus.map f).map (MulAut.conj t).toMonoidHom =
        Subgroup.zpowers y ⊔ coordinateTorus.map f
    rw [hty, hmapT]
  have htJ : t ∈ Subgroup.centralizer (J : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    rw [hJ] at hb
    obtain ⟨a, ha, rfl⟩ := hb
    have hfix : t * f a * t⁻¹ = f a := by
      have hwJa : w * a * w⁻¹ = a := hwJ a ha
      simpa only [t, map_mul, map_inv] using congrArg f hwJa
    exact (mul_inv_eq_iff_eq_mul.mp hfix).symm
  have h45 : ∀ a ∈ coordT45, (MulAut.conj t) ((ψ a : K) : G) =
      ((ψ a : K) : G)⁻¹ := by
    intro a ha
    change f w * f a * (f w)⁻¹ = (f a)⁻¹
    have hw45a : w * a * w⁻¹ = a⁻¹ := hw45 a ha
    simpa only [map_mul, map_inv] using congrArg f hw45a
  have h01 : ∀ a ∈ coordT01, (MulAut.conj w) a = a := hw01
  have h23 : ∀ a ∈ coordT23, (MulAut.conj w) a = a := hw23
  have hfix : ∀ a ∈ coordT01 ⊔ coordT23, (MulAut.conj w) a = a := by
    have hle : coordT01 ⊔ coordT23 ≤ Subgroup.centralizer ({w} : Set SL6F4) := by
      apply sup_le
      · intro a ha
        rw [Subgroup.mem_centralizer_singleton_iff]
        exact (mul_inv_eq_iff_eq_mul.mp (show w * a * w⁻¹ = a from h01 a ha)).symm
      · intro a ha
        rw [Subgroup.mem_centralizer_singleton_iff]
        exact (mul_inv_eq_iff_eq_mul.mp (show w * a * w⁻¹ = a from h23 a ha)).symm
    intro a ha
    change w * a * w⁻¹ = a
    rw [mul_inv_eq_iff_eq_mul]
    exact (Subgroup.mem_centralizer_singleton_iff.mp (hle ha)).symm
  refine ⟨t, htK, htE, htJ, hty, h45, ?_⟩
  intro a ha
  change f w * f a * (f w)⁻¹ = f a
  have hwfa : w * a * w⁻¹ = a := hfix a ha
  simpa only [map_mul, map_inv] using congrArg f hwfa

end CFSG.StandardType.N2KCoordinate


