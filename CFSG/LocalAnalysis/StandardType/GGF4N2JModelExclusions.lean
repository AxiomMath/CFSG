private theorem inverter_map_eq_of_pointwise_fixed {G : Type} [Group G]
    (M : Subgroup G) (α : MulAut G) (hf : ∀ a ∈ M, α a = a) :
    M.map α.toMonoidHom = M := by
  ext a
  constructor
  · rintro ⟨b, hb, hba⟩
    change α b = a at hba
    rw [hf b hb] at hba
    simpa [← hba] using hb
  · intro ha
    exact Subgroup.mem_map.mpr ⟨a, ha, hf a ha⟩

theorem n2_exists_coordT45_inverter : ∃ w : SL6F4,
    w ∈ blockSpecialLinear coordJ45 ∧
    (∀ a ∈ coordT01, (MulAut.conj w) a = a) ∧
    (∀ a ∈ coordT23, (MulAut.conj w) a = a) ∧
    (∀ a ∈ coordT45, (MulAut.conj w) a = a⁻¹) ∧
    coordinateTorus.map (MulAut.conj w).toMonoidHom = coordinateTorus := by
  obtain ⟨w2, hw2⟩ := CFSG.RankThree.PartOne.KF132.exists_inv_conj_sl2 coordA2
  let w : SL6F4 := coordBlock45 w2
  have hwB : w ∈ blockSpecialLinear coordJ45 := by
    rw [← range_pairEmbed (K := F4) (a := (4 : Fin 6)) (b := (5 : Fin 6)) (by decide)]
    exact ⟨w2, rfl⟩
  have hinv : (MulAut.conj w) (coordBlock45 coordA2) = (coordBlock45 coordA2)⁻¹ := by
    change coordBlock45 w2 * coordBlock45 coordA2 * (coordBlock45 w2)⁻¹ = _
    simpa only [map_mul, map_inv] using congrArg coordBlock45 hw2
  have h01 : ∀ a ∈ coordT01, (MulAut.conj w) a = a := by
    intro a ha
    change w * a * w⁻¹ = a
    rw [mul_inv_eq_iff_eq_mul]
    exact (commute_blockSpecialLinear_of_disjoint (by decide) hwB (coordT01_le_block ha)).eq
  have h23 : ∀ a ∈ coordT23, (MulAut.conj w) a = a := by
    intro a ha
    change w * a * w⁻¹ = a
    rw [mul_inv_eq_iff_eq_mul]
    exact (commute_blockSpecialLinear_of_disjoint (by decide) hwB (coordT23_le_block ha)).eq
  have h45 : ∀ a ∈ coordT45, (MulAut.conj w) a = a⁻¹ := by
    intro a ha
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp ha
    rw [map_zpow, hinv, _root_.inv_zpow]
  have hm45 : coordT45.map (MulAut.conj w).toMonoidHom = coordT45 := by
    rw [coordT45, MonoidHom.map_zpowers]
    change Subgroup.zpowers ((MulAut.conj w) (coordBlock45 coordA2)) = _
    rw [hinv, Subgroup.zpowers_inv]
  refine ⟨w, hwB, h01, h23, h45, ?_⟩
  rw [coordinateTorus, Subgroup.map_sup, Subgroup.map_sup,
    inverter_map_eq_of_pointwise_fixed coordT01 (MulAut.conj w) h01,
    inverter_map_eq_of_pointwise_fixed coordT23 (MulAut.conj w) h23, hm45]

theorem blockFour_mem_coordBlock
    (g : SpecialLinearGroup (Fin 4) F4) :
    CFSG.SeitzReduction.E6Pilot.blockFour g ∈
      blockSpecialLinear (coordJ01 ∪ coordJ23) := by
  apply mem_blockSpecialLinear.mpr
  intro i j hij
  fin_cases i <;> fin_cases j <;>
    simp_all [CFSG.SeitzReduction.E6Pilot.coe_blockFour,
      CFSG.SeitzReduction.E6Pilot.blockFourMat, CFSG.SeitzReduction.E6Pilot.e46,
      coordJ01, coordJ23, Matrix.fromBlocks, Matrix.one_apply]

theorem n2_exists_coordT45_inverter_centralizing_blockFour : ∃ w : SL6F4,
    w ∈ blockSpecialLinear coordJ45 ∧
    (∀ b ∈ (CFSG.SeitzReduction.E6Pilot.blockFour (K := F4)).range,
      (MulAut.conj w) b = b) ∧
    (∀ a ∈ coordT01, (MulAut.conj w) a = a) ∧
    (∀ a ∈ coordT23, (MulAut.conj w) a = a) ∧
    (∀ a ∈ coordT45, (MulAut.conj w) a = a⁻¹) ∧
    coordinateTorus.map (MulAut.conj w).toMonoidHom = coordinateTorus := by
  obtain ⟨w, hwB, h01, h23, h45, hT⟩ := n2_exists_coordT45_inverter
  refine ⟨w, hwB, ?_, h01, h23, h45, hT⟩
  rintro b ⟨g, rfl⟩
  change w * CFSG.SeitzReduction.E6Pilot.blockFour g * w⁻¹ = _
  rw [mul_inv_eq_iff_eq_mul]
  exact (commute_blockSpecialLinear_of_disjoint (by decide) hwB
    (blockFour_mem_coordBlock g)).eq

