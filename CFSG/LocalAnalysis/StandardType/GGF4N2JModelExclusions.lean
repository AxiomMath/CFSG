open CFSG.ComponentClassification.CatalogueBHigherLinearAction
open Matrix
open scoped MatrixGroups Pointwise

noncomputable section

abbrev GL6F4 : Type := Matrix.GeneralLinearGroup (Fin 6) F4

abbrev slConjugation6 (A : GL6F4) : MulAut SL6F4 :=
  slConjugation 6 F4 A

abbrev slGraphAut6 : MulAut SL6F4 :=
  slGraphAut 6 F4

@[expose] noncomputable def fieldFreeBeta (A : GL6F4) (ε : ℕ) : MulAut SL6F4 :=
  slConjugation6 A * slGraphAut6 ^ ε

open CFSG.SeitzReduction.LinearPilot
open CFSG.SeitzReduction.F4Pilot

private lemma trace_reindex {α β : Type*} [Fintype α] [Fintype β]
    (e : α ≃ β) (M : Matrix α α F4) :
    Matrix.trace (Matrix.reindex e e M) = Matrix.trace M := by
  rw [Matrix.trace, Matrix.trace]
  exact Equiv.sum_comp e.symm (fun i : α => M i i)

private lemma trace_fromBlocks_one {l r : Type*} [Fintype l] [Fintype r] [DecidableEq l] [DecidableEq r]
    (A : Matrix l l F4) :
    Matrix.trace (Matrix.fromBlocks A 0 0 (1 : Matrix r r F4)) =
      Matrix.trace A + (Fintype.card r : F4) := by
  rw [Matrix.trace, Matrix.trace]
  simp [Matrix.fromBlocks, Fintype.sum_sum_type]



open CFSG.RankThree.PartTwo.KFacts

private lemma trace_sl2_inv (B : SL2F4) :
    Matrix.trace (((B⁻¹ : SL2F4) : Matrix (Fin 2) (Fin 2) F4)) =
      Matrix.trace ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) := by
  rw [show (((B⁻¹ : SL2F4) : Matrix (Fin 2) (Fin 2) F4)) =
      Matrix.adjugate ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) by rfl]
  rw [Matrix.adjugate_fin_two, Matrix.trace_fin_two, Matrix.trace_fin_two]
  simp
  ring

private lemma trace_sl2_sq (B : SL2F4) :
    Matrix.trace (((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) ^ 2) =
      (Matrix.trace ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4)) ^ 2 := by
  have hdet : ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4).det = 1 := B.2
  have hsq := mat2_sq_eq_trace_smul_add_one (K := F4) hdet
  rw [hsq]
  rw [Matrix.trace_add, Matrix.trace_smul, Matrix.trace_one]
  simp [CharTwo.two_eq_zero]
  ring

private lemma trace_sl2_cube (B : SL2F4) (hB5 : orderOf B = 5) :
    Matrix.trace (((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) ^ 3) =
      (Matrix.trace ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4)) ^ 2 := by
  have hpow5 : B ^ 5 = 1 := by
    simpa [hB5] using pow_orderOf_eq_one B
  have hB3 : B ^ 3 = (B ^ 2)⁻¹ := by
    apply eq_inv_of_mul_eq_one_right
    calc
      B ^ 2 * B ^ 3 = B ^ 5 := by
        simpa using (pow_add B 2 3).symm
      _ = 1 := hpow5
  calc
    Matrix.trace (((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) ^ 3) =
        Matrix.trace (((B ^ 3 : SL2F4) : Matrix (Fin 2) (Fin 2) F4)) := by
      simp
    _ = Matrix.trace ((((B ^ 2)⁻¹ : SL2F4) : Matrix (Fin 2) (Fin 2) F4)) := by
      rw [hB3]
    _ = Matrix.trace (((B ^ 2 : SL2F4) : Matrix (Fin 2) (Fin 2) F4)) :=
      trace_sl2_inv (B ^ 2)
    _ = Matrix.trace (((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) ^ 2) := by
      simp
    _ = (Matrix.trace ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4)) ^ 2 :=
      trace_sl2_sq B

private lemma trace_sl2_four (B : SL2F4) (hB5 : orderOf B = 5) :
    Matrix.trace (((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) ^ 4) =
      Matrix.trace ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) := by
  have hpow5 : B ^ 5 = 1 := by
    simpa [hB5] using pow_orderOf_eq_one B
  have hB4 : B ^ 4 = B⁻¹ := by
    apply eq_inv_of_mul_eq_one_right
    calc
      B * B ^ 4 = B ^ 5 := by
        simpa using (pow_add B 1 4).symm
      _ = 1 := hpow5
  calc
    Matrix.trace (((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) ^ 4) =
        Matrix.trace (((B ^ 4 : SL2F4) : Matrix (Fin 2) (Fin 2) F4)) := by
      simp
    _ = Matrix.trace (((B⁻¹ : SL2F4) : Matrix (Fin 2) (Fin 2) F4)) := by
      rw [hB4]
    _ = Matrix.trace ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) :=
      trace_sl2_inv B

private lemma trace_blockMatrix_coordJ45 (A : Matrix coordJ45 coordJ45 F4) :
    Matrix.trace (blockMatrix coordJ45 A) = Matrix.trace A := by
  rw [blockMatrix, trace_reindex]
  rw [trace_fromBlocks_one]
  have hcard : Fintype.card {i : Fin 6 // i ∉ coordJ45} = 4 := by decide
  rw [hcard]
  have h4 : (4 : F4) = 0 := by
    change ((4 : ℕ) : F4) = 0
    rw [CharP.cast_eq_zero_iff F4 2]
    norm_num
  simpa [h4]

private lemma trace_reindex_sl2_inv {I : Type*} [Fintype I] [DecidableEq I]
    (e : I ≃ Fin 2) (C : SpecialLinearGroup I F4) :
    Matrix.trace (((C⁻¹ : SpecialLinearGroup I F4) : Matrix I I F4)) =
      Matrix.trace ((C : SpecialLinearGroup I F4) : Matrix I I F4) := by
  have hmap : (reindexSpecialLinear e C)⁻¹ = reindexSpecialLinear e (C⁻¹) :=
    (map_inv (reindexSpecialLinear e) C).symm
  have h := trace_sl2_inv (reindexSpecialLinear e C)
  rw [hmap] at h
  calc
    Matrix.trace (((C⁻¹ : SpecialLinearGroup I F4) : Matrix I I F4)) =
        Matrix.trace (Matrix.reindex e e
          (((C⁻¹ : SpecialLinearGroup I F4) : Matrix I I F4))) :=
      (trace_reindex e _).symm
    _ = Matrix.trace (Matrix.reindex e e
          (((C : SpecialLinearGroup I F4) : Matrix I I F4))) := h
    _ = Matrix.trace ((C : SpecialLinearGroup I F4) : Matrix I I F4) :=
      trace_reindex e _

private theorem exists_sl2_block_model
    {a : SL6F4} (haT : a ∈ coordT45) (ha5 : orderOf a = 5) :
    ∃ B : SL2F4, orderOf B = 5 ∧
      (∀ m : ℕ,
        Matrix.trace (((a ^ m : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) =
          Matrix.trace (((B ^ m : SL2F4) : Matrix (Fin 2) (Fin 2) F4))) ∧
      (∀ k : ℕ,
        Matrix.trace (((slGraphAut6 (a ^ k) : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) =
          Matrix.trace (((a ^ k : SL6F4) : Matrix (Fin 6) (Fin 6) F4))) := by
  classical
  let I : Finset (Fin 6) := coordJ45
  let aB : blockSpecialLinear (K := F4) I := ⟨a, by simpa [I] using coordT45_le_block haT⟩
  let E : blockSpecialLinear (K := F4) I ≃* SpecialLinearGroup I F4 :=
    blockSpecialLinearMulEquivSL F4 I
  let Bsub : SpecialLinearGroup I F4 := E aB
  let e2 : I ≃ Fin 2 := Finset.equivFinOfCardEq (by decide : I.card = 2)
  let B : SL2F4 := reindexSpecialLinear e2 Bsub
  refine ⟨B, ?_, ?_, ?_⟩
  · have hBsub5 : orderOf Bsub = 5 := by
      have h1 : orderOf Bsub = orderOf aB := by
        simpa [Bsub] using orderOf_injective E.toMonoidHom E.injective aB
      have h2 : orderOf aB = orderOf a := Subgroup.orderOf_mk a _
      rw [h1, h2, ha5]
    have hB5 : orderOf B = 5 := by
      have h1 : orderOf B = orderOf Bsub := by
        simpa [B] using orderOf_injective (reindexSpecialLinear e2).toMonoidHom
          (reindexSpecialLinear e2).injective Bsub
      rw [h1, hBsub5]
    exact hB5
  · intro m
    have haEq : a = blockEmbed I Bsub := by
      have h := coe_blockSpecialLinearMulEquivSL_symm (K := F4) I Bsub
      have h' : ((aB : blockSpecialLinear (K := F4) I) : SL6F4) = blockEmbed I Bsub := by
        simpa [E, Bsub] using h
      simpa [aB] using h'
    have haPow : ((a ^ m : SL6F4) : Matrix (Fin 6) (Fin 6) F4) =
        blockMatrix I (((Bsub ^ m : SpecialLinearGroup I F4) : Matrix I I F4)) := by
      calc
        ((a ^ m : SL6F4) : Matrix (Fin 6) (Fin 6) F4) =
            (((blockEmbed I Bsub) ^ m : SL6F4) : Matrix (Fin 6) (Fin 6) F4) := by
          rw [haEq]
        _ = ((blockEmbed I (Bsub ^ m) : SL6F4) : Matrix (Fin 6) (Fin 6) F4) := by
          rw [map_pow]
        _ = blockMatrix I (((Bsub ^ m : SpecialLinearGroup I F4) : Matrix I I F4)) := rfl
    have hBpow : ((B ^ m : SL2F4) : Matrix (Fin 2) (Fin 2) F4) =
        Matrix.reindex e2 e2 (((Bsub ^ m : SpecialLinearGroup I F4) : Matrix I I F4)) := by
      change (((reindexSpecialLinear e2 Bsub) ^ m : SL2F4) : Matrix (Fin 2) (Fin 2) F4) = _
      rw [← map_pow]
      rfl
    rw [haPow, trace_blockMatrix_coordJ45, hBpow, trace_reindex]
  · intro k
    have haEq : a = blockEmbed I Bsub := by
      have h := coe_blockSpecialLinearMulEquivSL_symm (K := F4) I Bsub
      have h' : ((aB : blockSpecialLinear (K := F4) I) : SL6F4) = blockEmbed I Bsub := by
        simpa [E, Bsub] using h
      simpa [aB] using h'
    have haPowEq : a ^ k = blockEmbed I (Bsub ^ k) := by
      rw [haEq, map_pow]
    rw [slGraphAut_matrix, Matrix.trace_transpose, haPowEq]
    have hmapinv : ((blockEmbed I (Bsub ^ k))⁻¹ : SL6F4) =
        blockEmbed I ((Bsub ^ k)⁻¹) :=
      (map_inv (blockEmbed I) (Bsub ^ k)).symm
    rw [hmapinv]
    rw [show ((blockEmbed I ((Bsub ^ k)⁻¹) : SL6F4) :
        Matrix (Fin 6) (Fin 6) F4) =
        blockMatrix I ((((Bsub ^ k)⁻¹ : SpecialLinearGroup I F4) : Matrix I I F4)) by rfl]
    rw [show ((blockEmbed I (Bsub ^ k) : SL6F4) : Matrix (Fin 6) (Fin 6) F4) =
        blockMatrix I (((Bsub ^ k : SpecialLinearGroup I F4) : Matrix I I F4)) by rfl]
    rw [trace_blockMatrix_coordJ45, trace_blockMatrix_coordJ45]
    exact trace_reindex_sl2_inv e2 (Bsub ^ k)

private lemma trace_slConjugation6 (A : GL6F4) (g : SL6F4) :
    Matrix.trace (((slConjugation6 A g : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) =
      Matrix.trace ((g : SL6F4) : Matrix (Fin 6) (Fin 6) F4) := by
  rw [show slConjugation6 A g = slConjugation 6 F4 A g by rfl]
  rw [slConjugation_matrix]
  exact Matrix.trace_units_conj A ((g : SL6F4) : Matrix (Fin 6) (Fin 6) F4)

private lemma trace_fieldFreeBeta_eq (A : GL6F4) {ε : ℕ} (hε : ε ≤ 1)
    {a : SL6F4}
    (hgraph : Matrix.trace (((slGraphAut6 a : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) =
      Matrix.trace ((a : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) :
    Matrix.trace (((fieldFreeBeta A ε a : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) =
      Matrix.trace ((a : SL6F4) : Matrix (Fin 6) (Fin 6) F4) := by
  interval_cases ε
  · simp only [fieldFreeBeta, pow_zero, MulAut.mul_apply, MulAut.one_apply]
    exact trace_slConjugation6 A a
  · simp only [fieldFreeBeta, pow_one, MulAut.mul_apply, slGraphAut6]
    calc
      Matrix.trace (((slConjugation6 A (slGraphAut 6 F4 a) : SL6F4) :
          Matrix (Fin 6) (Fin 6) F4)) =
          Matrix.trace (((slGraphAut 6 F4 a : SL6F4) :
            Matrix (Fin 6) (Fin 6) F4)) := trace_slConjugation6 A _
      _ = Matrix.trace ((a : SL6F4) : Matrix (Fin 6) (Fin 6) F4) := hgraph

theorem k_fieldfree_power_eq_one_or_four
    {a : SL6F4} (haT : a ∈ coordT45) (ha5 : orderOf a = 5)
    (A : GL6F4) {ε m : ℕ} (hε : ε ≤ 1) (hm1 : 1 ≤ m) (hm5 : m < 5)
    (hβ : fieldFreeBeta A ε a = a ^ m) : m = 1 ∨ m = 4 := by
  obtain ⟨B, hB5, htracePow, hgraph⟩ := exists_sl2_block_model haT ha5
  let c : F4 := Matrix.trace ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4)
  have hc_not : c ≠ 0 ∧ c ≠ 1 := by
    constructor
    · intro hc0
      have h6 : ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) ^ 6 = 1 :=
        mat2_pow_six_eq_one_of_trace (by simpa using B.2) (Or.inl hc0)
      have h6SL : B ^ 6 = 1 := Subtype.ext (by simpa using h6)
      have hdvd : orderOf B ∣ 6 := orderOf_dvd_iff_pow_eq_one.mpr h6SL
      rw [hB5] at hdvd
      norm_num at hdvd
    · intro hc1
      have h6 : ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) ^ 6 = 1 :=
        mat2_pow_six_eq_one_of_trace (by simpa using B.2) (Or.inr hc1)
      have h6SL : B ^ 6 = 1 := Subtype.ext (by simpa using h6)
      have hdvd : orderOf B ∣ 6 := orderOf_dvd_iff_pow_eq_one.mpr h6SL
      rw [hB5] at hdvd
      norm_num at hdvd
  have hc2 : c ^ 2 ≠ c := by
    intro hc
    have hzero : c * (c - 1) = 0 := by
      calc
        c * (c - 1) = c * c - c * 1 := by rw [mul_sub]
        _ = c ^ 2 - c := by rw [mul_one, pow_two]
        _ = 0 := by rw [hc, sub_self]
    rcases mul_eq_zero.mp hzero with h0 | h1
    · exact hc_not.1 h0
    · exact hc_not.2 (sub_eq_zero.mp h1)
  have htraceβ := trace_fieldFreeBeta_eq A hε (by simpa using hgraph 1)
  have htrace_m : Matrix.trace (((a ^ m : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) =
      Matrix.trace ((a : SL6F4) : Matrix (Fin 6) (Fin 6) F4) := by
    rw [← hβ]
    exact htraceβ
  have htrace_a : Matrix.trace ((a : SL6F4) : Matrix (Fin 6) (Fin 6) F4) =
      Matrix.trace ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) := by
    simpa using htracePow 1
  interval_cases m
  · exact Or.inl rfl
  · exfalso
    have h := htrace_m
    rw [htracePow 2, htrace_a] at h
    have h' : c ^ 2 = c := by
      simpa [c, trace_sl2_sq B] using h
    exact hc2 h'
  · exfalso
    have h := htrace_m
    rw [htracePow 3, htrace_a] at h
    have h' : c ^ 2 = c := by
      simpa [c, trace_sl2_cube B hB5] using h
    exact hc2 h'
  · exact Or.inr rfl

theorem k_fieldfree_central_image_power_eq_one_or_four
    {Q : Type*} [Group Q] (ψ : SL6F4 →* Q)
    (hψ : Function.Surjective ψ)
    (hker : ψ.ker ≤ Subgroup.center SL6F4)
    {a : SL6F4} (haT : a ∈ coordT45) (ha5 : orderOf a = 5)
    (A : GL6F4) {ε m : ℕ} (hε : ε ≤ 1) (hm1 : 1 ≤ m) (hm5 : m < 5)
    (hβ : ψ (fieldFreeBeta A ε a) = ψ (a ^ m)) : m = 1 ∨ m = 4 := by
  obtain ⟨B, hB5, htracePow, hgraph⟩ := exists_sl2_block_model haT ha5
  let c : F4 := Matrix.trace ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4)
  have hc_not : c ≠ 0 ∧ c ≠ 1 := by
    constructor
    · intro hc0
      have h6 : ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) ^ 6 = 1 :=
        mat2_pow_six_eq_one_of_trace (by simpa using B.2) (Or.inl hc0)
      have h6SL : B ^ 6 = 1 := Subtype.ext (by simpa using h6)
      have hdvd : orderOf B ∣ 6 := orderOf_dvd_iff_pow_eq_one.mpr h6SL
      rw [hB5] at hdvd
      norm_num at hdvd
    · intro hc1
      have h6 : ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) ^ 6 = 1 :=
        mat2_pow_six_eq_one_of_trace (by simpa using B.2) (Or.inr hc1)
      have h6SL : B ^ 6 = 1 := Subtype.ext (by simpa using h6)
      have hdvd : orderOf B ∣ 6 := orderOf_dvd_iff_pow_eq_one.mpr h6SL
      rw [hB5] at hdvd
      norm_num at hdvd
  have hc2 : c ^ 2 ≠ c := by
    intro hc
    have hzero : c * (c - 1) = 0 := by
      calc
        c * (c - 1) = c * c - c * 1 := by rw [mul_sub]
        _ = c ^ 2 - c := by rw [mul_one, pow_two]
        _ = 0 := by rw [hc, sub_self]
    rcases mul_eq_zero.mp hzero with h0 | h1
    · exact hc_not.1 h0
    · exact hc_not.2 (sub_eq_zero.mp h1)
  have htrace_a : Matrix.trace ((a : SL6F4) : Matrix (Fin 6) (Fin 6) F4) =
      Matrix.trace ((B : SL2F4) : Matrix (Fin 2) (Fin 2) F4) := by
    simpa using htracePow 1
  have htrace3 : Matrix.trace (((a ^ 3 : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) = c ^ 2 := by
    rw [htracePow 3]
    simpa [c] using trace_sl2_cube B hB5
  have htrace4 : Matrix.trace (((a ^ 4 : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) = c := by
    rw [htracePow 4]
    simpa [c] using trace_sl2_four B hB5
  let z : SL6F4 := fieldFreeBeta A ε a * (a ^ m)⁻¹
  have hzker : z ∈ ψ.ker := by
    rw [MonoidHom.mem_ker]
    dsimp [z]
    rw [map_mul, map_inv, hβ, mul_inv_cancel]
  have hzcenter : z ∈ Subgroup.center SL6F4 := hker hzker
  obtain ⟨lam, hlamPow, hlamScalar⟩ :=
    Matrix.SpecialLinearGroup.mem_center_iff.mp hzcenter
  have hlam6 : lam ^ 6 = 1 := by simpa using hlamPow
  have hlam3 : lam ^ 3 = 1 := by
    have hsq : (lam ^ 3) ^ 2 = 1 := by
      rw [← pow_mul, show 3 * 2 = 6 by norm_num, hlam6]
    rcases (sq_eq_one_iff.mp hsq) with h | h
    · exact h
    · rw [CharTwo.neg_eq] at h
      exact h
  have hz3 : z ^ 3 = 1 := by
    apply Subtype.ext
    change (((z : SL6F4) : Matrix (Fin 6) (Fin 6) F4) ^ 3) = 1
    rw [← hlamScalar]
    rw [← map_pow (Matrix.scalar (Fin 6)) lam 3, hlam3, map_one]
  have hbetaeq : fieldFreeBeta A ε a = z * a ^ m := by
    dsimp [z]
    group
  have hzcomm : Commute z (a ^ m) := by
    exact (Subgroup.mem_center_iff.mp hzcenter (a ^ m)).symm
  have hbeta3 : fieldFreeBeta A ε (a ^ 3) = a ^ (3 * m) := by
    calc
      fieldFreeBeta A ε (a ^ 3) = (fieldFreeBeta A ε a) ^ 3 := map_pow _ a 3
      _ = (z * a ^ m) ^ 3 := by rw [hbetaeq]
      _ = z ^ 3 * (a ^ m) ^ 3 := hzcomm.mul_pow 3
      _ = 1 * (a ^ m) ^ 3 := by rw [hz3]
      _ = (a ^ m) ^ 3 := one_mul _
      _ = a ^ (m * 3) := by rw [pow_mul]
      _ = a ^ (3 * m) := by rw [Nat.mul_comm]
  have htraceβ3 : Matrix.trace (((fieldFreeBeta A ε (a ^ 3) : SL6F4) :
      Matrix (Fin 6) (Fin 6) F4)) =
      Matrix.trace (((a ^ 3 : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) :=
    trace_fieldFreeBeta_eq A hε (by simpa using hgraph 3)
  have htrace_eq3 : Matrix.trace (((a ^ 3 : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) =
      Matrix.trace (((a ^ (3 * m) : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) := by
    calc
      Matrix.trace (((a ^ 3 : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) =
          Matrix.trace (((fieldFreeBeta A ε (a ^ 3) : SL6F4) :
            Matrix (Fin 6) (Fin 6) F4)) := htraceβ3.symm
      _ = Matrix.trace (((a ^ (3 * m) : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) := by
        rw [hbeta3]
  have ha5pow : a ^ 5 = 1 := by
    simpa [ha5] using pow_orderOf_eq_one a
  have ha6 : a ^ 6 = a := by
    change a ^ (5 + 1) = a
    rw [pow_add, ha5pow, one_mul, pow_one]
  have ha9 : a ^ 9 = a ^ 4 := by
    change a ^ (5 + 4) = a ^ 4
    rw [pow_add, ha5pow, one_mul]
  interval_cases m
  · exact Or.inl rfl
  · exfalso
    have h : Matrix.trace (((a ^ 3 : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) =
        Matrix.trace ((a : SL6F4) : Matrix (Fin 6) (Fin 6) F4) := by
      simpa [show 3 * 2 = 6 by norm_num, ha6] using htrace_eq3
    rw [htrace3, htrace_a] at h
    exact hc2 h
  · exfalso
    have h : Matrix.trace (((a ^ 3 : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) =
        Matrix.trace (((a ^ 4 : SL6F4) : Matrix (Fin 6) (Fin 6) F4)) := by
      simpa [show 3 * 3 = 9 by norm_num, ha9] using htrace_eq3
    rw [htrace3, htrace4] at h
    exact hc2 h
  · exact Or.inr rfl

end

