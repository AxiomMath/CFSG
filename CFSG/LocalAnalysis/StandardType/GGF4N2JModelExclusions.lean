theorem ggF4N2_outer_eq_one_of_pow_five
    {G : Type} [Group G] {K : Subgroup G}
    (hK : GGCentralImage .PSL 6 2 K)
    (q : Outer ↥K) (hq : q ^ 5 = 1) :
    q = 1 := by
  classical
  let F := GaloisField 2 2
  have hSq : CFSG.IsQuasisimple (Matrix.SpecialLinearGroup (Fin 6) F) :=
    CFSG.LieType.Universal.SpecialLinear.isQuasisimple (m := 5) (F := F) (by norm_num)
  letI : Group.IsPerfect (ggU .PSL 6 2).K := hSq.1
  have hcardKQ := ggF4N2_card_outer_centerQuotient_dvd_twelve hK
  obtain ⟨ψ, _hadm, _hker, hrange⟩ := hK
  have hperfK : Group.IsPerfect ↥K := by
    have h := Group.IsPerfect.range ψ
    rwa [hrange] at h
  letI : Group.IsPerfect ↥K := hperfK
  have hq5' : (outerCenterQuotientHom ↥K q) ^ 5 = 1 := by
    calc
      (outerCenterQuotientHom ↥K q) ^ 5 = outerCenterQuotientHom ↥K (q ^ 5) :=
        (map_pow (outerCenterQuotientHom ↥K) q 5).symm
      _ = 1 := by rw [hq, map_one]
  have hord5 : orderOf (outerCenterQuotientHom ↥K q) ∣ 5 :=
    orderOf_dvd_of_pow_eq_one hq5'
  have hord12 : orderOf (outerCenterQuotientHom ↥K q) ∣ 12 :=
    (orderOf_dvd_natCard _).trans hcardKQ
  have hord1 : orderOf (outerCenterQuotientHom ↥K q) = 1 := by
    have hdvd : orderOf (outerCenterQuotientHom ↥K q) ∣ 1 := by
      simpa using (Nat.dvd_gcd hord5 hord12)
    exact Nat.dvd_one.mp hdvd
  have hx1 : outerCenterQuotientHom ↥K q = 1 := orderOf_eq_one_iff.mp hord1
  apply outerCenterQuotientHom_injective ↥K
  simpa using hx1

theorem ggF4N2_exists_conj_eq_of_pow_five
    {G : Type} [Group G] {K : Subgroup G}
    (hK : GGCentralImage .PSL 6 2 K)
    (alpha : MulAut ↥K) (hα : alpha ^ 5 = 1) :
    ∃ k : ↥K, alpha = MulAut.conj k := by
  classical
  let q : Outer ↥K := QuotientGroup.mk' (inner ↥K) alpha
  have hq5 : q ^ 5 = 1 := by
    calc
      q ^ 5 = QuotientGroup.mk' (inner ↥K) (alpha ^ 5) := by
        dsimp [q]
      _ = 1 := by rw [hα, map_one]
  have hq1 : q = 1 := ggF4N2_outer_eq_one_of_pow_five hK q hq5
  have hmemInner : alpha ∈ CFSG.ComponentClassification.OuterAutomorphisms.inner ↥K :=
    (QuotientGroup.eq_one_iff (N := CFSG.ComponentClassification.OuterAutomorphisms.inner ↥K)
      alpha).mp hq1
  have hmem : alpha ∈ (MulAut.conj : ↥K →* MulAut ↥K).range := by
    simpa [CFSG.ComponentClassification.OuterAutomorphisms.inner] using hmemInner
  rcases MonoidHom.mem_range.mp hmem with ⟨k, hk⟩
  exact ⟨k, hk.symm⟩


theorem ggF4N2_central_cube
    {G : Type} [Group G] {K : Subgroup G}
    (hK : GGCentralImage .PSL 6 2 K) {z : K}
    (hz : z ∈ Subgroup.center K) : z ^ 3 = 1 := by
  classical
  let F := GaloisField 2 2
  let S := Matrix.SpecialLinearGroup (Fin 6) F
  obtain ⟨ψ, _hadm, hker, hrange⟩ := hK
  let f : S →* K := ψ.codRestrict K (fun s => by
    rw [← hrange]
    exact ⟨s, rfl⟩)
  have hf : Function.Surjective f := by
    intro k
    have hk : (k : G) ∈ ψ.range := by rw [hrange]; exact k.2
    obtain ⟨s, hs⟩ := hk
    exact ⟨s, Subtype.ext hs⟩
  have hfker : f.ker ≤ Subgroup.center S := by
    intro s hs
    apply hker
    have h : ψ s = 1 := congrArg Subtype.val (MonoidHom.mem_ker.mp hs)
    exact MonoidHom.mem_ker.mpr h
  have hSq : CFSG.IsQuasisimple S :=
    CFSG.LieType.Universal.SpecialLinear.isQuasisimple (m := 5) (F := F) (by norm_num)
  haveI : Group.IsPerfect S := hSq.1
  have hZ : (Subgroup.center S).map f = Subgroup.center K :=
    CFSG.ClassicalInvolution.ModelFacts.UnitaryAut.map_center_eq_center_of_perfect hf hfker
  have hF : Nat.card F = 4 := by
    simpa using GaloisField.card 2 2 (by norm_num)
  have hcard : Nat.card (Subgroup.center S) = 3 := by
    dsimp [S]
    rw [CFSG.OrderReductions.LinearOrders.card_specialLinear_center F 6 (by norm_num), hF]
    norm_num
  rw [← hZ] at hz
  obtain ⟨s, hs, rfl⟩ := Subgroup.mem_map.mp hz
  have hs3 : s ^ 3 = 1 := by
    have h : (⟨s, hs⟩ : Subgroup.center S) ^ Nat.card (Subgroup.center S) = 1 := pow_card_eq_one'
    rw [hcard] at h
    exact congrArg Subtype.val h
  rw [← map_pow, hs3, map_one]

theorem ggF4N2_exists_orderFive_conj
    {G : Type} [Group G] {K : Subgroup G}
    (hK : GGCentralImage .PSL 6 2 K) (α : MulAut K)
    (hα : α ^ 5 = 1) (hαne : α ≠ 1) :
    ∃ a : K, orderOf a = 5 ∧ MulAut.conj a = α := by
  obtain ⟨k, hk⟩ := ggF4N2_exists_conj_eq_of_pow_five hK α hα
  exact ggF4N2_exists_orderFive_conj_of_central_cube α hα hαne k hk.symm
    (fun z hz => ggF4N2_central_cube hK hz)


theorem five_not_dvd_card_center_of_centralImage_PSL_six_two
    {G : Type} [Group G] [Finite G] {K : Subgroup G}
