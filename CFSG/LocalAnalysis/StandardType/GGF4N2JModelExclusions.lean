open CFSG.SeitzReduction.LinearPilot
open CFSG.SeitzReduction.F4Pilot
open Subgroup Matrix
open scoped commutatorElement

local notation "F4" => CFSG.StandardType.N2KCoordinate.F4

local instance : Fintype F4 := Fintype.ofFinite _

@[expose] def letterI : Finset (Fin 6) := {0, 1, 2}

@[expose] def letterJ : Finset (Fin 6) := {3, 4, 5}

noncomputable abbrev blockM : Subgroup (Matrix.SpecialLinearGroup (Fin 6) F4) :=
  blockSpecialLinear (K := F4) letterI

noncomputable abbrev blockM' : Subgroup (Matrix.SpecialLinearGroup (Fin 6) F4) :=
  blockSpecialLinear (K := F4) letterJ

theorem coordT45_le_blockM' : N2KCoordinate.coordT45 ≤ blockM' := by
  change N2KCoordinate.coordT45 ≤ blockSpecialLinear (K := F4) letterJ
  exact N2KCoordinate.coordT45_le_block.trans (blockSpecialLinear_mono (by decide))

open CFSG.SeitzReduction.E6Pilot in
theorem blockM_le_blockFour_range :
    blockM ≤ (CFSG.SeitzReduction.E6Pilot.blockFour (K := F4)).range := by
  classical
  rw [blockM, blockSpecialLinear_eq_closure]
  rw [Subgroup.closure_le]
  rintro A ⟨i, j, hij, c, hi, hj, rfl⟩
  have hi4 : i.val < 4 := by
    have hi' : i = 0 ∨ i = 1 ∨ i = 2 := by
      simpa [N2KComplementary.letterI] using hi
    rcases hi' with rfl | rfl | rfl <;> decide
  have hj4 : j.val < 4 := by
    have hj' : j = 0 ∨ j = 1 ∨ j = 2 := by
      simpa [N2KComplementary.letterI] using hj
    rcases hj' with rfl | rfl | rfl <;> decide
  let a : Fin 4 := Fin.castLT i hi4
  let b : Fin 4 := Fin.castLT j hj4
  have ha : c4 a = i := by
    fin_cases i <;> simp [c4, e46, a] at hi4 ⊢
  have hb : c4 b = j := by
    fin_cases j <;> simp [c4, e46, b] at hj4 ⊢
  have hab : a ≠ b := by
    intro h
    apply hij
    rw [← ha, ← hb, h]
  refine ⟨SpecialLinearGroup.transvection hab c, ?_⟩
  simpa [ha, hb] using (blockFour_transvection (K := F4) hab c)



private theorem letterI_card : letterI.card = 3 := by decide

private theorem letterJ_card : letterJ.card = 3 := by decide

private theorem letterJ_eq_compl : letterJ = letterIᶜ := by decide

theorem blockM'_mulEquiv_SL3 :
    Nonempty (blockM' ≃* Matrix.SpecialLinearGroup (Fin 3) F4) := by
  classical
  let eJ : letterJ ≃ Fin 3 := Finset.equivFinOfCardEq letterJ_card
  exact ⟨(blockSpecialLinearMulEquivSL F4 letterJ).trans
    (reindexSpecialLinear eJ)⟩

theorem blockM'_center_card : Nat.card (Subgroup.center blockM') = 3 := by
  classical
  have hcard := CFSG.HardMathSupport.Foote.Proving.natCard_center_SL3_field F4
  have hF : Fintype.card F4 = 4 := by
    change Fintype.card (GaloisField 2 2) = 4
    simpa using (GaloisField.card 2 2 (by norm_num))
  rw [hF] at hcard
  norm_num at hcard
  let eJ : letterJ ≃ Fin 3 := Finset.equivFinOfCardEq letterJ_card
  let e : blockM' ≃* Matrix.SpecialLinearGroup (Fin 3) F4 :=
    (blockSpecialLinearMulEquivSL F4 letterJ).trans (reindexSpecialLinear eJ)
  have hmap : (Subgroup.center blockM').map e.toMonoidHom =
      Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) F4) :=
    Subgroup.map_center_eq e
  calc
    Nat.card ↥(Subgroup.center blockM') =
        Nat.card ↥((Subgroup.center blockM').map e.toMonoidHom) :=
      (Subgroup.card_map_of_injective e.injective).symm
    _ = Nat.card ↥(Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) F4)) := by rw [hmap]
    _ = 3 := by simpa [Nat.card_eq_fintype_card] using hcard

private theorem commutator_blockM'_self : ⁅blockM', blockM'⁆ = blockM' := by
  simpa [blockM', letterJ] using
    (commutator_blockSpecialLinear_eq_of_three_le (K := F4) (I := letterJ) (by
      rw [letterJ_card]))

private theorem blockM'_le_centralizer_blockM :
    blockM' ≤ Subgroup.centralizer (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4)) := by
  classical
  intro x hx
  rw [Subgroup.mem_centralizer_iff]
  intro y hy
  have hdisj : Disjoint letterI letterJ := by decide
  exact (commute_blockSpecialLinear_of_disjoint (K := F4) hdisj hy hx).eq


private noncomputable def blockScalarI (r : F4) (hr : r ^ 3 = 1) :
    Matrix.SpecialLinearGroup letterI F4 :=
  ⟨Matrix.scalar letterI r, by
    rw [Matrix.scalar_apply]
    rw [Matrix.det_diagonal]
    rw [Finset.prod_const]
    simp [letterI_card, hr]⟩

private noncomputable def blockScalar (r : F4) (hr : r ^ 3 = 1) :
    Matrix.SpecialLinearGroup (Fin 6) F4 :=
  blockEmbed letterI (blockScalarI r hr)

private theorem blockScalar_coe_eq_diagonal (r : F4) (hr : r ^ 3 = 1) :
    ((blockScalar r hr : Matrix.SpecialLinearGroup (Fin 6) F4) :
      Matrix (Fin 6) (Fin 6) F4) =
      Matrix.diagonal (fun i => if i ∈ letterI then r else 1) := by
  ext i j
  rw [blockScalar, coe_blockEmbed, blockMatrix_apply]
  by_cases hi : i ∈ letterI <;> by_cases hj : j ∈ letterI <;>
    by_cases hij : i = j <;>
    simp [blockScalarI, Matrix.scalar_apply, Matrix.one_apply,
      hi, hj, hij]

private theorem blockScalar_mem_blockM (r : F4) (hr : r ^ 3 = 1) :
    blockScalar r hr ∈ blockM := by
  rw [blockM, ← range_blockEmbed]
  exact ⟨_, rfl⟩

private theorem offDiag_eq_zero_of_commute_blockScalar {r : F4} (hr : r ^ 3 = 1) (hr1 : r ≠ 1)
    {g : Matrix.SpecialLinearGroup (Fin 6) F4}
    (hg : blockScalar r hr * g = g * blockScalar r hr) :
    (∀ i, i ∈ letterI → ∀ j, j ∉ letterI →
      ((g : Matrix (Fin 6) (Fin 6) F4) i j) = 0) ∧
    (∀ i, i ∉ letterI → ∀ j, j ∈ letterI →
      ((g : Matrix (Fin 6) (Fin 6) F4) i j) = 0) := by
  classical
  let d : Fin 6 → F4 := fun i => if i ∈ letterI then r else 1
  have hz : ((blockScalar r hr : Matrix.SpecialLinearGroup (Fin 6) F4) :
      Matrix (Fin 6) (Fin 6) F4) = Matrix.diagonal d := by
    simpa [d] using blockScalar_coe_eq_diagonal r hr
  have hmat : (g : Matrix (Fin 6) (Fin 6) F4) * Matrix.diagonal d =
      Matrix.diagonal d * (g : Matrix (Fin 6) (Fin 6) F4) := by
    simpa [hz] using congrArg (fun x : Matrix.SpecialLinearGroup (Fin 6) F4 =>
      (x : Matrix (Fin 6) (Fin 6) F4)) hg.symm
  have key : ∀ i j, ((g : Matrix (Fin 6) (Fin 6) F4) i j) * d j =
      d i * ((g : Matrix (Fin 6) (Fin 6) F4) i j) := by
    intro i j
    simpa only [Matrix.mul_diagonal, Matrix.diagonal_mul] using congrFun (congrFun hmat i) j
  refine ⟨?_, ?_⟩
  · intro i hi j hj
    have hline := key i j
    simp only [d, hi, hj, if_true, if_false, mul_one] at hline
    have hzero : (1 - r) * ((g : Matrix (Fin 6) (Fin 6) F4) i j) = 0 := by
      calc
        (1 - r) * ((g : Matrix (Fin 6) (Fin 6) F4) i j) =
            1 * ((g : Matrix (Fin 6) (Fin 6) F4) i j) -
              r * ((g : Matrix (Fin 6) (Fin 6) F4) i j) := by ring
        _ = ((g : Matrix (Fin 6) (Fin 6) F4) i j) -
              r * ((g : Matrix (Fin 6) (Fin 6) F4) i j) := by rw [one_mul]
        _ = 0 := by rw [← hline]; abel
    exact (mul_eq_zero.mp hzero).resolve_left (sub_ne_zero.mpr (Ne.symm hr1))
  · intro i hi j hj
    have hline := key i j
    simp only [d, hi, hj, if_true, if_false, one_mul] at hline
    have hzero : (r - 1) * ((g : Matrix (Fin 6) (Fin 6) F4) i j) = 0 := by
      calc
        (r - 1) * ((g : Matrix (Fin 6) (Fin 6) F4) i j) =
            r * ((g : Matrix (Fin 6) (Fin 6) F4) i j) -
              1 * ((g : Matrix (Fin 6) (Fin 6) F4) i j) := by ring
        _ = r * ((g : Matrix (Fin 6) (Fin 6) F4) i j) -
              ((g : Matrix (Fin 6) (Fin 6) F4) i j) := by rw [one_mul]
        _ = 0 := by rw [mul_comm r, hline]; abel
    exact (mul_eq_zero.mp hzero).resolve_left (sub_ne_zero.mpr hr1)


private theorem mul_one_add_single_apply {F : Type*} [Field F] {ι : Type*}
    [Fintype ι] [DecidableEq ι] (M : Matrix ι ι F) (i j k l : ι) :
    (M * (1 + Matrix.single i j (1 : F))) k l =
      M k l + if j = l then M k i else 0 := by
  rw [Matrix.mul_add, Matrix.mul_one, Matrix.add_apply, Matrix.mul_apply]
  by_cases hjl : j = l
  · subst hjl
    rw [Finset.sum_eq_single i]
    · simp
    · intro b _ hb
      simp [Ne.symm hb]
    · intro h
      simp at h
  · simp [hjl]

private theorem one_add_single_mul_apply {F : Type*} [Field F] {ι : Type*}
    [Fintype ι] [DecidableEq ι] (M : Matrix ι ι F) (i j k l : ι) :
    ((1 + Matrix.single i j (1 : F)) * M) k l =
      M k l + if i = k then M j l else 0 := by
  rw [Matrix.add_mul, Matrix.one_mul, Matrix.add_apply, Matrix.mul_apply]
  by_cases hik : i = k
  · subst hik
    rw [Finset.sum_eq_single j]
    · simp
    · intro b _ hb
      simp [Ne.symm hb]
    · intro h
      simp at h
  · simp [hik]

private theorem firstBlock_scalar_of_mem_centralizer {g : Matrix.SpecialLinearGroup (Fin 6) F4}
    (hg : g ∈ Subgroup.centralizer (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4)))
    (hblock : (∀ i, i ∈ letterI → ∀ j, j ∉ letterI →
      ((g : Matrix (Fin 6) (Fin 6) F4) i j) = 0) ∧
      (∀ i, i ∉ letterI → ∀ j, j ∈ letterI →
      ((g : Matrix (Fin 6) (Fin 6) F4) i j) = 0)) :
    ∃ c : F4, (∀ i, i ∈ letterI → ∀ j, j ∈ letterI →
      ((g : Matrix (Fin 6) (Fin 6) F4) i j) = if i = j then c else 0) ∧
      c ≠ 0 ∧ c ^ 3 = 1 := by
  classical
  let A : Matrix letterI letterI F4 := fun i j =>
    (g : Matrix (Fin 6) (Fin 6) F4) i j
  have hPair : Pairwise fun i j : letterI => Commute (Matrix.single i j (1 : F4)) A := by
    intro i j hij
    let t : Matrix.SpecialLinearGroup (Fin 6) F4 :=
      Matrix.SpecialLinearGroup.transvection (F := F4)
        (fun h : (i : Fin 6) = (j : Fin 6) => hij (Subtype.ext h)) (1 : F4)
    have ht : t ∈ blockM := by
      rw [blockM, ← range_blockEmbed]
      exact ⟨Matrix.SpecialLinearGroup.transvection hij 1,
        blockEmbed_transvection letterI hij 1⟩
    have hgt : t * g = g * t :=
      (Subgroup.mem_centralizer_iff.mp hg) t ht
    have hmat : (1 + Matrix.single (i : Fin 6) (j : Fin 6) (1 : F4)) *
        (g : Matrix (Fin 6) (Fin 6) F4) =
        (g : Matrix (Fin 6) (Fin 6) F4) *
          (1 + Matrix.single (i : Fin 6) (j : Fin 6) (1 : F4)) := by
      have h := congrArg (fun x : Matrix.SpecialLinearGroup (Fin 6) F4 =>
        (x : Matrix (Fin 6) (Fin 6) F4)) hgt
      simpa [t, Matrix.SpecialLinearGroup.transvection_coe] using h
    have hAT : A * (1 + Matrix.single i j (1 : F4)) =
        (1 + Matrix.single i j (1 : F4)) * A := by
      ext k l
      have hkl := congrFun (congrFun hmat (k : Fin 6)) (l : Fin 6)
      rw [one_add_single_mul_apply, mul_one_add_single_apply] at hkl
      rw [mul_one_add_single_apply, one_add_single_mul_apply]
      simpa [A] using hkl.symm
    have hsingle : Matrix.single i j (1 : F4) * A =
        A * Matrix.single i j (1 : F4) := by
      have h := hAT
      rw [Matrix.mul_add, Matrix.mul_one, Matrix.add_mul, Matrix.one_mul] at h
      exact (add_left_cancel h).symm
    exact hsingle
  obtain ⟨c, hc⟩ := Matrix.mem_range_scalar_of_commute_single hPair
  have hc' : A = Matrix.scalar letterI c := hc.symm
  have hscalar : ∀ i, i ∈ letterI → ∀ j, j ∈ letterI →
      ((g : Matrix (Fin 6) (Fin 6) F4) i j) = if i = j then c else 0 := by
    intro i hi j hj
    have h := congrFun (congrFun hc' ⟨i, hi⟩) ⟨j, hj⟩
    simpa [A, Matrix.scalar_apply, Matrix.diagonal_apply] using h
  have hc0 : c ≠ 0 := by
    intro hc0
    have hrow : ∀ j : Fin 6, ((g : Matrix (Fin 6) (Fin 6) F4) 0 j) = 0 := by
      intro j
      by_cases hj : j ∈ letterI
      · have h := hscalar 0 (by simp [letterI]) j hj
        rw [hc0] at h
        by_cases h0j : (0 : Fin 6) = j
        · simpa [h0j] using h
        · simpa [h0j] using h
      · exact hblock.1 0 (by simp [letterI]) j hj
    have hdet0 := Matrix.det_eq_zero_of_row_eq_zero (0 : Fin 6) hrow
    have hdet1 : (g : Matrix (Fin 6) (Fin 6) F4).det = 1 := g.2
    rw [hdet1] at hdet0
    exact zero_ne_one hdet0.symm
  have hc3 : c ^ 3 = 1 := by
    have h := FiniteField.pow_card_sub_one_eq_one c hc0
    have hF : Fintype.card F4 = 4 := by
      change Fintype.card (GaloisField 2 2) = 4
      simpa using (GaloisField.card 2 2 (by norm_num))
    rw [hF] at h
    norm_num at h
    exact h
  exact ⟨c, hscalar, hc0, hc3⟩


private theorem blockScalar_mul (c c' : F4) (hc : c ^ 3 = 1) (hc' : c' ^ 3 = 1) :
    blockScalar c hc * blockScalar c' hc' =
      blockScalar (c * c') (by rw [mul_pow, hc, hc', one_mul]) := by
  rw [blockScalar, blockScalar, blockScalar]
  rw [← map_mul]
  congr 1
  ext i j
  rw [Matrix.SpecialLinearGroup.coe_mul]
  change (Matrix.scalar letterI c * Matrix.scalar letterI c') i j =
    (Matrix.scalar letterI (c * c')) i j
  rw [← map_mul (Matrix.scalar letterI)]

private theorem blockScalar_mul_inv (c : F4) (hc : c ^ 3 = 1) (hc0 : c ≠ 0) :
    blockScalar c hc * blockScalar c⁻¹ (by
      rw [inv_pow, hc, inv_one]) = 1 := by
  have hmul := blockScalar_mul c c⁻¹ hc (by rw [inv_pow, hc, inv_one])
  rw [hmul]
  have hc1 : c * c⁻¹ = 1 := mul_inv_cancel₀ hc0
  have hone : blockScalar (1 : F4) (by norm_num) = 1 := by
    rw [blockScalar]
    have hI : blockScalarI (1 : F4) (by norm_num) = 1 := by
      ext i j
      simp [blockScalarI, Matrix.scalar_apply, Matrix.one_apply]
    rw [hI, map_one]
  have hbc : blockScalar (c * c⁻¹) (by rw [mul_pow, hc, inv_pow, hc, inv_one, one_mul]) =
      blockScalar (1 : F4) (by norm_num) := by
    congr 1
  rw [hbc, hone]


private theorem commutatorElement_mul_eq_of_commute {G : Type*} [Group G] {z d z' d' : G}
    (hzd : Commute z d) (hzz' : Commute z z') (hzd' : Commute z d')
    (hz'd : Commute z' d) (hz'd' : Commute z' d') :
    ⁅z * d, z' * d'⁆ = ⁅d, d'⁆ := by
  have hzcomm : Commute z ⁅d, d'⁆ := by
    rw [commutatorElement_def]
    exact ((hzd.mul_right hzd').mul_right hzd.inv_right).mul_right hzd'.inv_right
  have hz'comm : Commute z' ⁅d, d'⁆ := by
    rw [commutatorElement_def]
    exact ((hz'd.mul_right hz'd').mul_right hz'd.inv_right).mul_right hz'd'.inv_right
  have hzdz' : ⁅d, z'⁆ = 1 := by
    rw [commutatorElement_eq_one_iff_commute]
    exact hz'd.symm
  have hzz'd' : ⁅z, z' * d'⁆ = 1 := by
    rw [commutatorElement_eq_one_iff_commute]
    exact hzz'.mul_right hzd'
  rw [commutatorElement_mul_left_eq_conj_mul, commutatorElement_mul_right_eq_mul_conj]
  rw [hzdz', hzz'd']
  simp only [one_mul]
  rw [show z' * ⁅d, d'⁆ * z'⁻¹ = ⁅d, d'⁆ by
    rw [hz'comm.eq]
    simp]
  rw [show z * ⁅d, d'⁆ * z⁻¹ = ⁅d, d'⁆ by
    rw [hzcomm.eq]
    simp]
  simp

private theorem blockScalar_commute (c c' : F4) (hc : c ^ 3 = 1) (hc' : c' ^ 3 = 1) :
    Commute (blockScalar c hc) (blockScalar c' hc') := by
  change blockEmbed letterI (blockScalarI c hc) *
      blockEmbed letterI (blockScalarI c' hc') =
    blockEmbed letterI (blockScalarI c' hc') *
      blockEmbed letterI (blockScalarI c hc)
  rw [← map_mul, ← map_mul]
  congr 1
  ext i j
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul]
  change (Matrix.scalar letterI c * Matrix.scalar letterI c') i j =
    (Matrix.scalar letterI c' * Matrix.scalar letterI c) i j
  rw [← map_mul (Matrix.scalar letterI), ← map_mul (Matrix.scalar letterI)]
  rw [mul_comm c c']

private theorem blockScalar_commute_blockM' (c : F4) (hc : c ^ 3 = 1) {d : Matrix.SpecialLinearGroup (Fin 6) F4}
    (hd : d ∈ blockM') : Commute (blockScalar c hc) d := by
  have hzM : blockScalar c hc ∈ blockM := blockScalar_mem_blockM c hc
  have hdisj : Disjoint letterI letterJ := by decide
  exact commute_blockSpecialLinear_of_disjoint (K := F4) hdisj hzM hd

private theorem exists_blockScalar_mul_blockM'_of_mem_centralizer
    {g : Matrix.SpecialLinearGroup (Fin 6) F4}
    (hg : g ∈ Subgroup.centralizer (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4))) :
    ∃ c : F4, ∃ hc3 : c ^ 3 = 1,
      blockScalar c hc3 ∈ blockM ∧
      ∃ d ∈ blockM', g = blockScalar c hc3 * d := by
  classical
  have hF4card : Nat.card F4 = 4 := by
    rw [Nat.card_eq_fintype_card]
    change Fintype.card (GaloisField 2 2) = 4
    simpa using (GaloisField.card 2 2 (by norm_num))
  have hunits : Nat.card F4ˣ = 3 := by
    rw [Nat.card_units, hF4card]
  obtain ⟨r, hrord⟩ := exists_prime_orderOf_dvd_card' 3 (by rw [hunits])
  have hr3u : r ^ 3 = 1 := by
    rw [← hrord]
    exact pow_orderOf_eq_one r
  have hr3 : (r : F4) ^ 3 = 1 := by
    simpa using congrArg Units.val hr3u
  have hr1u : r ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hrord
    norm_num at hrord
  have hr1 : (r : F4) ≠ 1 := fun h => hr1u (Units.ext h)
  have hblock := offDiag_eq_zero_of_commute_blockScalar hr3 hr1
    ((Subgroup.mem_centralizer_iff.mp hg) (blockScalar r hr3)
      (blockScalar_mem_blockM r hr3))
  obtain ⟨c, hscalar, hc0, hc3⟩ :=
    firstBlock_scalar_of_mem_centralizer hg hblock
  let hcinv : (c⁻¹ : F4) ^ 3 = 1 := by rw [inv_pow, hc3, inv_one]
  let z := blockScalar c hc3
  let d := blockScalar c⁻¹ hcinv * g
  refine ⟨c, hc3, blockScalar_mem_blockM c hc3, d, ?_, ?_⟩
  · rw [blockM', mem_blockSpecialLinear]
    intro i j hij
    have hdmat : ((d : Matrix.SpecialLinearGroup (Fin 6) F4) : Matrix (Fin 6) (Fin 6) F4) =
        Matrix.diagonal (fun k => if k ∈ letterI then c⁻¹ else 1) *
          (g : Matrix (Fin 6) (Fin 6) F4) := by
      rw [show d = blockScalar c⁻¹ hcinv * g by rfl]
      rw [Matrix.SpecialLinearGroup.coe_mul, blockScalar_coe_eq_diagonal]
    rw [hdmat]
    rw [Matrix.diagonal_mul]
    rcases hij with hiJ | hjJ
    · have hiI : i ∈ letterI := by simpa [letterJ_eq_compl] using hiJ
      by_cases hjI : j ∈ letterI
      · have hgij := hscalar i hiI j hjI
        by_cases hij' : i = j
        · subst hij'
          simp [hiI, hgij, inv_mul_cancel₀ hc0]
        · simp [hiI, hgij, hij']
      · have hgij := hblock.1 i hiI j hjI
        have hij' : i ≠ j := by rintro rfl; exact hjI hiI
        simp [hiI, hgij, hij']
    · have hjI : j ∈ letterI := by simpa [letterJ_eq_compl] using hjJ
      by_cases hiI : i ∈ letterI
      · have hgij := hscalar i hiI j hjI
        by_cases hij' : i = j
        · subst hij'
          simp [hiI, hgij, inv_mul_cancel₀ hc0]
        · simp [hiI, hgij, hij']
      · have hgij := hblock.2 i hiI j hjI
        have hij' : i ≠ j := by rintro rfl; exact hiI hjI
        simp [hiI, hgij, hij']
  · rw [show g = blockScalar c hc3 * d by
      rw [show d = blockScalar c⁻¹ hcinv * g by rfl]
      rw [← mul_assoc, blockScalar_mul_inv c hc3 hc0, one_mul]]


theorem commutator_centralizer_blockM_eq_blockM' :
    ⁅Subgroup.centralizer (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4)),
      Subgroup.centralizer (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4))⁆ =
      blockM' := by
  classical
  apply le_antisymm
  · rw [Subgroup.commutator_le]
    intro g hg h hh
    obtain ⟨c, hc3, hzM, d, hdM', rfl⟩ :=
      exists_blockScalar_mul_blockM'_of_mem_centralizer hg
    obtain ⟨c', hc3', hz'M, d', hd'M', rfl⟩ :=
      exists_blockScalar_mul_blockM'_of_mem_centralizer hh
    rw [commutatorElement_mul_eq_of_commute
      (blockScalar_commute_blockM' c hc3 hdM')
      (blockScalar_commute c c' hc3 hc3')
      (blockScalar_commute_blockM' c hc3 hd'M')
      (blockScalar_commute_blockM' c' hc3' hdM')
      (blockScalar_commute_blockM' c' hc3' hd'M')]
    have hmem : ⁅d, d'⁆ ∈ ⁅blockM', blockM'⁆ :=
      Subgroup.commutator_mem_commutator hdM' hd'M'
    rwa [commutator_blockM'_self] at hmem
  · intro d hd
    have hd' : d ∈ ⁅blockM', blockM'⁆ := by rwa [commutator_blockM'_self]
    exact (Subgroup.commutator_mono blockM'_le_centralizer_blockM
      blockM'_le_centralizer_blockM) hd'


private theorem isPerfect_blockM : Group.IsPerfect blockM := by
  rw [Subgroup.isPerfect_iff]
  simpa [blockM] using
    (commutator_blockSpecialLinear_eq_of_three_le (K := F4) (I := letterI) (by
      rw [letterI_card]))

theorem commutator_centralizer_map_blockM_eq_map_blockM'
    {Q : Type*} [Group Q] (ψ : Matrix.SpecialLinearGroup (Fin 6) F4 →* Q)
    (hsurj : Function.Surjective ψ)
    (hker : ψ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin 6) F4)) :
    ⁅Subgroup.centralizer ((blockM.map ψ : Subgroup Q) : Set Q),
      Subgroup.centralizer ((blockM.map ψ : Subgroup Q) : Set Q)⁆ =
      blockM'.map ψ := by
  classical
  have hC : Subgroup.centralizer ((blockM.map ψ : Subgroup Q) : Set Q) =
      (Subgroup.centralizer (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4))).map ψ := by
    refine le_antisymm ?_ ?_
    · calc
        Subgroup.centralizer ((blockM.map ψ : Subgroup Q) : Set Q) =
            ((Subgroup.centralizer ((blockM.map ψ : Subgroup Q) : Set Q)).comap ψ).map ψ :=
          (Subgroup.map_comap_eq_self_of_surjective hsurj _).symm
        _ ≤ (Subgroup.centralizer (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4))).map ψ :=
          Subgroup.map_mono
            (CFSG.RankThreeCoreUniqueness.Helpers.perfect_subgroup_normalized_centralizing_images_commute
              ψ hker blockM isPerfect_blockM)
    · simpa only [Subgroup.coe_map] using
        Subgroup.map_centralizer_le_centralizer_image
          (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4)) ψ
  calc
    ⁅Subgroup.centralizer ((blockM.map ψ : Subgroup Q) : Set Q),
      Subgroup.centralizer ((blockM.map ψ : Subgroup Q) : Set Q)⁆ =
        ⁅(Subgroup.centralizer (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4))).map ψ,
          (Subgroup.centralizer (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4))).map ψ⁆ := by
      rw [hC]
    _ = (⁅Subgroup.centralizer (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4)),
          Subgroup.centralizer (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4))⁆).map ψ :=
      (Subgroup.map_commutator _ _ ψ).symm
    _ = blockM'.map ψ := by rw [commutator_centralizer_blockM_eq_blockM']


theorem pow_three_mem_blockM'_of_mem_centralizer {g : Matrix.SpecialLinearGroup (Fin 6) F4}
    (hg : g ∈ Subgroup.centralizer (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4))) :
    g ^ 3 ∈ blockM' := by
  obtain ⟨c, hc3, -, d, hd, rfl⟩ := exists_blockScalar_mul_blockM'_of_mem_centralizer hg
  have hz : blockScalar c hc3 ^ 3 = 1 := by
    apply Subtype.ext
    rw [Matrix.SpecialLinearGroup.coe_pow, blockScalar_coe_eq_diagonal, Matrix.diagonal_pow,
      Matrix.SpecialLinearGroup.coe_one, ← Matrix.diagonal_one]
    congr 1
    funext i
    by_cases hi : i ∈ letterI <;> simp [hi, hc3]
  rw [(blockScalar_commute_blockM' c hc3 hd).mul_pow, hz, one_mul]
  exact blockM'.pow_mem hd 3

theorem mem_map_blockM'_of_mem_centralizer_map_blockM {Q : Type*} [Group Q]
    (ψ : Matrix.SpecialLinearGroup (Fin 6) F4 →* Q)
    (hker : ψ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin 6) F4))
    {u : Q} (hu : u ∈ ψ.range) (hu5 : u ^ 5 = 1)
    (huC : u ∈ Subgroup.centralizer ((blockM.map ψ : Subgroup Q) : Set Q)) :
    u ∈ blockM'.map ψ := by
  obtain ⟨w, rfl⟩ := hu
  have hw : w ∈ Subgroup.centralizer (blockM : Set (Matrix.SpecialLinearGroup (Fin 6) F4)) :=
    CFSG.RankThreeCoreUniqueness.Helpers.perfect_subgroup_normalized_centralizing_images_commute
      ψ hker blockM isPerfect_blockM huC
  refine ⟨(w ^ 3) ^ 2, blockM'.pow_mem (pow_three_mem_blockM'_of_mem_centralizer hw) 2, ?_⟩
  rw [map_pow, map_pow, ← pow_mul, show 3 * 2 = 5 + 1 from rfl, pow_succ, hu5, one_mul]

theorem psi_injective_on_blockM' {Q : Type*} [Group Q]
    (ψ : Matrix.SpecialLinearGroup (Fin 6) F4 →* Q)
    (hker : ψ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin 6) F4)) :
    Function.Injective (ψ.comp blockM'.subtype) := by
  classical
  rw [injective_iff_map_eq_one]
  intro x hx
  have hxker : (x : Matrix.SpecialLinearGroup (Fin 6) F4) ∈ ψ.ker :=
    MonoidHom.mem_ker.mpr hx
  have hxcenter : (x : Matrix.SpecialLinearGroup (Fin 6) F4) ∈
      Subgroup.center (Matrix.SpecialLinearGroup (Fin 6) F4) := hker hxker
  have hcenter_bot : blockM' ⊓
      Subgroup.center (Matrix.SpecialLinearGroup (Fin 6) F4) = ⊥ :=
    inf_center_eq_bot_of_le_blockSpecialLinear (I := letterJ) (j := (0 : Fin 6))
      (by decide) (le_refl blockM')
  have hxinf : (x : Matrix.SpecialLinearGroup (Fin 6) F4) ∈ blockM' ⊓
      Subgroup.center (Matrix.SpecialLinearGroup (Fin 6) F4) := ⟨x.2, hxcenter⟩
  rw [hcenter_bot] at hxinf
  simpa using hxinf

theorem blockM'_map_mulEquiv_SL3 {Q : Type*} [Group Q]
    (ψ : Matrix.SpecialLinearGroup (Fin 6) F4 →* Q)
    (hker : ψ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin 6) F4)) :
    Nonempty (blockM'.map ψ ≃* Matrix.SpecialLinearGroup (Fin 3) F4) := by
  classical
  let φ : blockM' →* Q := ψ.comp blockM'.subtype
  have hφ : Function.Injective φ := psi_injective_on_blockM' ψ hker
  let e : blockM' ≃* φ.range := MonoidHom.ofInjective hφ
  have hrange : φ.range = blockM'.map ψ := by
    ext q
    constructor
    · rintro ⟨x, hx⟩
      exact ⟨x, x.2, hx⟩
    · rintro ⟨x, hx, rfl⟩
      exact ⟨⟨x, hx⟩, rfl⟩
  let e2 : blockM'.map ψ ≃* blockM' := (e.trans (MulEquiv.subgroupCongr hrange)).symm
  exact ⟨e2.trans (Classical.choice blockM'_mulEquiv_SL3)⟩

theorem blockM'_map_center_card {Q : Type*} [Group Q]
    (ψ : Matrix.SpecialLinearGroup (Fin 6) F4 →* Q)
    (hker : ψ.ker ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin 6) F4)) :
    Nat.card (Subgroup.center (blockM'.map ψ)) = 3 := by
  classical
  obtain ⟨e⟩ := blockM'_map_mulEquiv_SL3 ψ hker
  have hcard : Nat.card (Subgroup.center (blockM'.map ψ)) =
      Nat.card (Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) F4)) := by
    calc
      Nat.card (Subgroup.center (blockM'.map ψ)) =
          Nat.card ↥((Subgroup.center (blockM'.map ψ)).map e.toMonoidHom) :=
        (Subgroup.card_map_of_injective e.injective).symm
      _ = Nat.card (Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) F4)) := by
        have hmap : Subgroup.map e.toMonoidHom (Subgroup.center (blockM'.map ψ)) =
            Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) F4) :=
          Subgroup.map_center_eq e
        rw [hmap]
  have hF : Fintype.card F4 = 4 := by
    change Fintype.card (GaloisField 2 2) = 4
    simpa using (GaloisField.card 2 2 (by norm_num))
  have hSL3 : Nat.card (Subgroup.center (Matrix.SpecialLinearGroup (Fin 3) F4)) = 3 := by
    have h := CFSG.HardMathSupport.Foote.Proving.natCard_center_SL3_field F4
    rw [hF] at h
    norm_num at h
    simpa [Nat.card_eq_fintype_card] using h
  rw [hcard, hSL3]

end

