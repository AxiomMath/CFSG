private theorem fieldDetectionBeta_refl_eq_fieldFreeBeta (A : GL6F4) (ε : ℕ) :
    fieldDetectionBeta A (RingEquiv.refl F4) ε =
      N2KCoordinate.fieldFreeBeta A ε := by
  change slConjugation 6 F4 A * slFieldAut (Fin 6) F4 (RingEquiv.refl F4) *
      (slGraphAut 6 F4) ^ ε =
    slConjugation 6 F4 A * (slGraphAut 6 F4) ^ ε
  rw [show slFieldAut (Fin 6) F4 (RingEquiv.refl F4) = 1 from
    map_one (slFieldAut (Fin 6) F4)]
  simp

theorem power_eq_one_or_four_of_whole_block
    {Q : Type} [Group Q]
    (psi : SL6F4 →* Q)
    (hpsi_surj : Function.Surjective psi)
    (hpsi_ker : psi.ker ≤ Subgroup.center SL6F4)
    (alphaQ : MulAut Q)
    (C : GL4F4) (delta : ℕ) (hdelta : delta ≤ 1)
    (hblock : ∀ g : SL4F4,
      alphaQ (psi (blockFour g)) =
        psi (blockFour ((slConjugation 4 F4 C * (slGraphAut 4 F4) ^ delta) g)))
    {a : SL6F4} (haT : a ∈ N2KCoordinate.coordT45) (ha5 : orderOf a = 5)
    {m : ℕ} (hm1 : 1 ≤ m) (hm5 : m < 5)
    (hα : alphaQ (psi a) = psi (a ^ m)) :
    m = 1 ∨ m = 4 := by
  have hF4 : Nat.card F4 = 4 := by
    rw [show F4 = GaloisField 2 2 from rfl,
      GaloisField.card 2 2 (by norm_num)]
    norm_num
  obtain ⟨A, sigma, epsilon, hepsilon, hlift⟩ :=
    exists_std_lift_of_central_kernel (F := F4) hF4 psi hpsi_surj hpsi_ker alphaQ
  have hσ : sigma = RingEquiv.refl F4 := by
    apply sigma_eq_refl_of_block_eq psi hpsi_surj hpsi_ker A sigma epsilon hepsilon C delta hdelta
    intro g
    have h1 := hlift (blockFour g)
    have h2 := hblock g
    change psi ((slConjugation 6 F4 A * slFieldAut (Fin 6) F4 sigma *
      (slGraphAut 6 F4) ^ epsilon) (blockFour g)) =
      psi (blockFour ((slConjugation 4 F4 C * (slGraphAut 4 F4) ^ delta) g))
    exact h1.symm.trans h2
  have hβ : psi (N2KCoordinate.fieldFreeBeta A epsilon a) = psi (a ^ m) := by
    have h1 := hlift a
    have h2 : psi (fieldDetectionBeta A sigma epsilon a) = psi (a ^ m) :=
      h1.symm.trans hα
    rw [hσ, fieldDetectionBeta_refl_eq_fieldFreeBeta] at h2
    exact h2
  exact N2KCoordinate.k_fieldfree_central_image_power_eq_one_or_four
    psi hpsi_surj hpsi_ker haT ha5 A hepsilon hm1 hm5 hβ

end

