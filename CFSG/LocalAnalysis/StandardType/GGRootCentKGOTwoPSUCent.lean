variable {f m : ℕ} {K : Type} [Field K] [Finite K] [CharP K 2]

theorem mat_rootU_eq {m : ℕ} (hm : 1 ≤ m) :
    mat (unitaryInvolution K 2 f) (m + 1) (AutPSU.rootU (K := K) (f := f) m) =
      (1 : Matrix (Fin (m + 1)) (Fin (m + 1)) K) + single (Fin.last m) 0 1 := by
  rw [CFSG.LieType.Universal.Unitary.SUExtras.mat_apply, AutPSU.coe_rootU hm]

theorem zero_ne_rev_zero (hm : 1 ≤ m) : (0 : Fin (m + 1)) ≠ Fin.rev 0 := by
  intro h
  have h' := congrArg Fin.val h
  simp only [Fin.val_zero, Fin.val_rev, Fin.val_last] at h'
  omega

@[expose] noncomputable def y0 (h : UnitaryFieldData 2 f K) (m : ℕ) : AutPSU.PJ h (m + 1) :=
  if hm : 1 ≤ m then
    AutPSU.projU h (AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm))
  else 1

theorem y0_of_le (h : UnitaryFieldData 2 f K) {m : ℕ} (hm : 1 ≤ m) :
    y0 h m = AutPSU.projU h
      (AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm)) :=
  dif_pos hm

@[expose] noncomputable def leviFull (h : UnitaryFieldData 2 f K) (m : ℕ) :
    Subgroup (AutPSU.PJ h (m + 1)) :=
  Subgroup.centralizer {AutPSU.projU h (AutPSU.rootU (K := K) (f := f) m)} ⊓
    Subgroup.centralizer {y0 h m}

@[expose] noncomputable def suR (h : UnitaryFieldData 2 f K) (m : ℕ) :
    Subgroup (SU (unitaryInvolution K 2 f) (m + 1)) :=
  if hm : 1 ≤ m then
    ((LinFusion.ggTransPlacement hm).radical K).comap
      ((gramSUToSL h ((AutPSU.gramJ (m + 1) : GL (Fin (m + 1)) K) :
        Matrix (Fin (m + 1)) (Fin (m + 1)) K)).comp (AutPSU.suEquiv h).toMonoidHom)
  else ⊥

theorem suR_of_le (h : UnitaryFieldData 2 f K) {m : ℕ} (hm : 1 ≤ m) :
    suR h m = ((LinFusion.ggTransPlacement hm).radical K).comap
      ((gramSUToSL h ((AutPSU.gramJ (m + 1) : GL (Fin (m + 1)) K) :
        Matrix (Fin (m + 1)) (Fin (m + 1)) K)).comp (AutPSU.suEquiv h).toMonoidHom) :=
  dif_pos hm

@[expose] noncomputable def suL (h : UnitaryFieldData 2 f K) (m : ℕ) :
    Subgroup (SU (unitaryInvolution K 2 f) (m + 1)) :=
  if hm : 1 ≤ m then
    Subgroup.centralizer
      ({(AutPSU.rootU (K := K) (f := f) m)} :
        Set (SU (unitaryInvolution K 2 f) (m + 1))) ⊓
      Subgroup.centralizer ({(AutPSU.lroot (unitaryInvolution K 2 f)
        (zero_ne_rev_zero hm))} : Set (SU (unitaryInvolution K 2 f) (m + 1)))
  else ⊥

theorem suL_of_le (h : UnitaryFieldData 2 f K) {m : ℕ} (hm : 1 ≤ m) :
    suL h m =
      Subgroup.centralizer
      ({(AutPSU.rootU (K := K) (f := f) m)} :
        Set (SU (unitaryInvolution K 2 f) (m + 1))) ⊓
        Subgroup.centralizer ({(AutPSU.lroot (unitaryInvolution K 2 f)
          (zero_ne_rev_zero hm))} : Set (SU (unitaryInvolution K 2 f) (m + 1))) :=
  dif_pos hm

@[expose] noncomputable def radical (h : UnitaryFieldData 2 f K) (m : ℕ) :
    Subgroup (AutPSU.PJ h (m + 1)) :=
  (suR h m).map (AutPSU.projU h)

theorem radical_of_le (h : UnitaryFieldData 2 f K) (m : ℕ) :
    radical h m = (suR h m).map (AutPSU.projU h) :=
  rfl

section Aux

variable (h : UnitaryFieldData 2 f K)

private noncomputable def slHom (m : ℕ) (hm : 1 ≤ m) :
    SU (unitaryInvolution K 2 f) (m + 1) →* SpecialLinearGroup (Fin (m + 1)) K :=
  (gramSUToSL h ((AutPSU.gramJ (m + 1) : GL (Fin (m + 1)) K) :
    Matrix (Fin (m + 1)) (Fin (m + 1)) K)).comp (AutPSU.suEquiv h).toMonoidHom

private theorem slHom_injective (m : ℕ) (hm : 1 ≤ m) : Function.Injective (slHom h m hm) :=
  (gramSUToSL_injective h ((AutPSU.gramJ (m + 1) : GL (Fin (m + 1)) K) :
    Matrix (Fin (m + 1)) (Fin (m + 1)) K)).comp (AutPSU.suEquiv h).injective

private theorem slHom_rootU (m : ℕ) (hm : 1 ≤ m) :
    slHom h m hm (AutPSU.rootU (K := K) (f := f) m) = (LinFusion.ggTransPlacement hm).mat K := by
  rw [slHom, MonoidHom.comp_apply]
  change gramSUToSL h ((AutPSU.gramJ (m + 1) : GL (Fin (m + 1)) K) :
    Matrix (Fin (m + 1)) (Fin (m + 1)) K) (AutPSU.suEquiv h (AutPSU.rootU (K := K) (f := f) m)) = _
  rw [AutPSU.gramSUToSL_rootU h hm, LinFusion.ggTransPlacement_mat,
    AutPSL.ggInvSL_eq_rootInv hm]

theorem suR_le_centralizer {m : ℕ} (hm : 1 ≤ m) :
    suR h m ≤ Subgroup.centralizer {AutPSU.rootU (K := K) (f := f) m} := by
  rw [suR_of_le h hm]
  intro x hx
  rw [Subgroup.mem_centralizer_singleton_iff]
  have hcomm : slHom h m hm x * (LinFusion.ggTransPlacement hm).mat K =
      (LinFusion.ggTransPlacement hm).mat K * slHom h m hm x :=
    Subgroup.mem_centralizer_singleton_iff.mp
      ((LinFusion.ggTransPlacement hm).radical_le_centralizer hx)
  apply (slHom_injective h m hm)
  rw [map_mul, map_mul, slHom_rootU h m hm]
  exact hcomm

theorem suR_isPGroup {m : ℕ} (hm : 1 ≤ m) : IsPGroup 2 (suR h m) := by
  rw [suR_of_le h hm]
  have hrad2 : IsPGroup 2 ((LinFusion.ggTransPlacement hm).radical K) := by
    intro y
    exact ⟨2, Subtype.ext (by simpa using
      (LinFusion.ggTransPlacement hm).radical_pow_four y.2)⟩
  exact hrad2.comap_of_injective (slHom h m hm) (slHom_injective h m hm)

end Aux

section Entries

variable (h : UnitaryFieldData 2 f K)

private theorem mem_suR_entries_aux (k : ℕ) (hm : 1 ≤ k + 1)
    {x : SU (unitaryInvolution K 2 f) (k + 2)} (hx : x ∈ suR h (k + 1)) :
    (∀ j, mat (unitaryInvolution K 2 f) (k + 2) x 0 j =
      (1 : Matrix (Fin (k + 2)) (Fin (k + 2)) K) 0 j) ∧
    (∀ i, mat (unitaryInvolution K 2 f) (k + 2) x i (Fin.last (k + 1)) =
      (1 : Matrix (Fin (k + 2)) (Fin (k + 2)) K) i (Fin.last (k + 1))) ∧
    (∀ a b : Fin k, mat (unitaryInvolution K 2 f) (k + 2) x
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid a)
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid b) =
      (1 : Matrix (Fin (k + 2)) (Fin (k + 2)) K)
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid a)
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid b)) := by
  set P := LinFusion.ggTransPlacement hm with hP
  have hx' : x ∈ suR h (k + 1) := hx
  rw [suR_of_le h hm] at hx'
  have hmem : slHom h (k + 1) hm x ∈ P.radical K := hx' 
  have hrad := P.mem_radical.mp hmem
  have hcoeEq : ((slHom h (k + 1) hm x : SpecialLinearGroup (Fin (k + 2)) K) :
      Matrix (Fin (k + 2)) (Fin (k + 2)) K) =
      mat (unitaryInvolution K 2 f) (k + 2) x := by
    rw [slHom, MonoidHom.comp_apply, coe_gramSUToSL]
    change (((AutPSU.suEquiv h x : AutPSU.XJ h (k + 2)) : GL (Fin (k + 2)) K) :
      Matrix (Fin (k + 2)) (Fin (k + 2)) K) = _
    rw [AutPSU.coe_suEquiv, CFSG.LieType.Universal.Unitary.SUExtras.mat_apply]
  have hcoe : ∀ i j, ((slHom h (k + 1) hm x : SpecialLinearGroup (Fin (k + 2)) K) :
      Matrix (Fin (k + 2)) (Fin (k + 2)) K) i j =
      mat (unitaryInvolution K 2 f) (k + 2) x i j := by
    intro i j; rw [hcoeEq]
  have hw : P.w 0 = (0 : Fin (k + 2)) := by
    rw [hP]; exact LinFusion.ggTransPlacement_w hm 0
  have hu : P.u 0 = Fin.last (k + 1) := by
    rw [hP]; exact LinFusion.ggTransPlacement_u hm 0
  have h0level : P.level 0 = 2 := by
    rw [← hw]; exact P.level_w 0
  have hlastlevel : P.level (Fin.last (k + 1)) = 0 := by
    rw [← hu]; exact P.level_u 0
  have hmidlevel : ∀ a : Fin k, P.level
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid a) = 1 := by
    intro a
    rw [P.level_eq_one_iff]
    refine ⟨fun b => ?_, fun b => ?_⟩
    · rw [hP]; rw [LinFusion.ggTransPlacement_u hm b]
      exact (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_ne_last a).symm
    · rw [hP]; rw [LinFusion.ggTransPlacement_w hm b]
      exact (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_ne_zero a).symm
  refine ⟨fun j => ?_, fun i => ?_, fun a b => ?_⟩
  · have hl : P.level j ≤ P.level 0 := by rw [h0level]; exact P.level_le_two j
    rw [← hcoe]
    exact hrad 0 j hl
  · have hl : P.level (Fin.last (k + 1)) ≤ P.level i := by
      rw [hlastlevel]; exact Nat.zero_le _
    rw [← hcoe]
    exact hrad i (Fin.last (k + 1)) hl
  · have hl : P.level
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid b) ≤
        P.level (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid a) := by
      rw [hmidlevel, hmidlevel]
    rw [← hcoe]
    exact hrad _ _ hl

end Entries

section Single

variable {n : ℕ} {K : Type} [Field K]

private theorem commute_single_of_commute_add {M : Matrix (Fin n) (Fin n) K} {a b : Fin n}
    (h : M * (1 + single a b 1) = (1 + single a b 1) * M) :
    M * single a b 1 = single a b 1 * M := by
  rw [Matrix.mul_add, Matrix.mul_one, Matrix.add_mul, Matrix.one_mul] at h
  exact add_left_cancel h

private theorem col_of_commute_single {M : Matrix (Fin n) (Fin n) K} {a b : Fin n}
    (h : M * single a b 1 = single a b 1 * M) (i : Fin n) :
    M i a = if i = a then M b b else 0 := by
  by_cases hi : i = a
  · subst i
    have h' := congrFun (congrFun h a) b
    have hleft : (M * (single a b (1 : K) : Matrix (Fin n) (Fin n) K)) a b = M a a := by
      rw [Matrix.mul_single_apply_same, mul_one]
    have hright : ((single a b (1 : K) : Matrix (Fin n) (Fin n) K) * M) a b = M b b := by
      rw [Matrix.single_mul_apply_same, one_mul]
    rw [hleft, hright] at h'
    simpa using h'
  · have h' := congrFun (congrFun h i) b
    have hleft : (M * (single a b (1 : K) : Matrix (Fin n) (Fin n) K)) i b = M i a := by
      rw [Matrix.mul_single_apply_same, mul_one]
    have hright : ((single a b (1 : K) : Matrix (Fin n) (Fin n) K) * M) i b = 0 :=
      Matrix.single_mul_apply_of_ne (1 : K) a b i b hi M
    rw [hleft, hright] at h'
    rw [if_neg hi]
    exact h' 

private theorem row_of_commute_single {M : Matrix (Fin n) (Fin n) K} {a b : Fin n}
    (h : M * single a b 1 = single a b 1 * M) (j : Fin n) :
    M b j = if j = b then M a a else 0 := by
  have hT : Mᵀ * single b a 1 = single b a 1 * Mᵀ := by
    have := congrArg Matrix.transpose h
    simpa [Matrix.transpose_mul, Matrix.transpose_single] using this.symm
  have := col_of_commute_single hT j
  simpa [Matrix.transpose_apply] using this

end Single

section Intersection

variable (h : UnitaryFieldData 2 f K)

private theorem suR_inf_suL_aux (k : ℕ) (hk : 2 ≤ k) :
    suR h (k + 1) ⊓ suL h (k + 1) = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  obtain ⟨hxR, hxL⟩ := Subgroup.mem_inf.mp hx
  have hm1 : 1 ≤ k + 1 := by omega
  rw [suL_of_le h hm1] at hxL
  obtain ⟨-, hxy⟩ := Subgroup.mem_inf.mp hxL
  obtain ⟨hrow0, hcollast, hmid⟩ := mem_suR_entries_aux h k hm1 (x := x) hxR
  have hrev0 : Fin.rev (0 : Fin (k + 2)) = Fin.last (k + 1) := by
    ext; simp [Fin.rev]
  have hcomm : mat (unitaryInvolution K 2 f) (k + 2) x *
      (1 + single (0 : Fin (k + 2)) (Fin.rev 0) (1 : K)) =
      (1 + single (0 : Fin (k + 2)) (Fin.rev 0) (1 : K)) *
        mat (unitaryInvolution K 2 f) (k + 2) x := by
    have h1 := Subgroup.mem_centralizer_singleton_iff.mp hxy
    have e := congrArg (fun y => mat (unitaryInvolution K 2 f) (k + 2) y) h1
    rw [map_mul, map_mul, CFSG.LieType.Universal.Unitary.SUExtras.mat_apply,
      CFSG.LieType.Universal.Unitary.SUExtras.mat_apply, AutPSU.coe_lroot] at e
    exact e
  have hcol0 : ∀ i, mat (unitaryInvolution K 2 f) (k + 2) x i 0 =
      (1 : Matrix (Fin (k + 2)) (Fin (k + 2)) K) i 0 := by
    intro i
    have h := col_of_commute_single (commute_single_of_commute_add hcomm) i
    have hbb : mat (unitaryInvolution K 2 f) (k + 2) x (Fin.rev 0) (Fin.rev 0) = 1 := by
      rw [hrev0]
      simpa using hcollast (Fin.last (k + 1))
    rw [hbb] at h
    by_cases hi : i = 0
    · subst i
      rw [if_pos rfl] at h
      simpa using h
    · rw [if_neg hi] at h
      simpa [hi] using h
  have hrowlast : ∀ j, mat (unitaryInvolution K 2 f) (k + 2) x (Fin.last (k + 1)) j =
      (1 : Matrix (Fin (k + 2)) (Fin (k + 2)) K) (Fin.last (k + 1)) j := by
    intro j
    have h := row_of_commute_single (commute_single_of_commute_add hcomm) j
    rw [hrev0] at h
    have h00 : mat (unitaryInvolution K 2 f) (k + 2) x 0 0 = 1 := by simpa using hrow0 0
    rw [h00] at h
    by_cases hj : j = Fin.last (k + 1)
    · subst j
      rw [if_pos rfl] at h
      simpa using h
    · rw [if_neg hj] at h
      rw [h]
      exact (Matrix.one_apply_ne (Ne.symm hj)).symm
  have hmat1 : mat (unitaryInvolution K 2 f) (k + 2) x = 1 := by
    ext i j
    by_cases hi0 : i = 0
    · subst i
      exact hrow0 j
    by_cases hil : i = Fin.last (k + 1)
    · subst i
      exact hrowlast j
    · have hi_mid : i ∈ Set.range
          (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) := by
        rw [CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mem_range_mid]
        have h0 : (i : ℕ) ≠ 0 := fun h => hi0 (Fin.ext h)
        have hl : (i : ℕ) ≠ k + 1 := fun h => hil (Fin.ext (by simpa using h))
        have := i.isLt
        omega
      obtain ⟨a, rfl⟩ := hi_mid
      by_cases hj0 : j = 0
      · subst j
        exact hcol0 _
      by_cases hjl : j = Fin.last (k + 1)
      · subst j
        exact hcollast _
      · have hj_mid : j ∈ Set.range
            (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) := by
          rw [CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mem_range_mid]
          have h0 : (j : ℕ) ≠ 0 := fun h => hj0 (Fin.ext h)
          have hl : (j : ℕ) ≠ k + 1 := fun h => hjl (Fin.ext (by simpa using h))
          have := j.isLt
          omega
        obtain ⟨b, rfl⟩ := hj_mid
        exact hmid a b
  have hx1 : x = 1 := CFSG.LieType.Universal.Unitary.SUExtras.mat_injective
    (by rw [hmat1, map_one])
  rw [Subgroup.mem_bot]
  exact hx1

end Intersection

section Corner

variable (h : UnitaryFieldData 2 f K)

private theorem slHom_matrix_eq (m : ℕ) (hm : 1 ≤ m)
    (x : SU (unitaryInvolution K 2 f) (m + 1)) :
    ((slHom h m hm x : SpecialLinearGroup (Fin (m + 1)) K) :
      Matrix (Fin (m + 1)) (Fin (m + 1)) K) =
      mat (unitaryInvolution K 2 f) (m + 1) x := by
  rw [slHom, MonoidHom.comp_apply, coe_gramSUToSL]
  change (((AutPSU.suEquiv h x : AutPSU.XJ h (m + 1)) : GL (Fin (m + 1)) K) :
    Matrix (Fin (m + 1)) (Fin (m + 1)) K) = _
  rw [AutPSU.coe_suEquiv, CFSG.LieType.Universal.Unitary.SUExtras.mat_apply]

private theorem mem_suR_of_corner_aux (k : ℕ) (hm : 1 ≤ k + 1)
    {x : SU (unitaryInvolution K 2 f) (k + 2)}
    (hxC : x ∈ Subgroup.centralizer {AutPSU.rootU (K := K) (f := f) (k + 1)})
    (hcorner : mat (unitaryInvolution K 2 f) (k + 2) x
      (Fin.last (k + 1)) (Fin.last (k + 1)) = 1)
    (hmid : (mat (unitaryInvolution K 2 f) (k + 2) x).submatrix
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) = 1) :
    x ∈ suR h (k + 1) := by
  rw [suR_of_le h hm]
  set P := LinFusion.ggTransPlacement hm with hP
  have hcomm : mat (unitaryInvolution K 2 f) (k + 2) x * ggInvMatrix (k + 2) 1 K =
      ggInvMatrix (k + 2) 1 K * mat (unitaryInvolution K 2 f) (k + 2) x := by
    have h1 := Subgroup.mem_centralizer_singleton_iff.mp hxC
    have em := congrArg (fun y : SU (unitaryInvolution K 2 f) (k + 2) =>
      (((y : GL (Fin (k + 2)) K) : Matrix (Fin (k + 2)) (Fin (k + 2)) K))) h1
    change mat (unitaryInvolution K 2 f) (k + 2) x *
        mat (unitaryInvolution K 2 f) (k + 2) (AutPSU.rootU (K := K) (f := f) (k + 1)) =
      mat (unitaryInvolution K 2 f) (k + 2) (AutPSU.rootU (K := K) (f := f) (k + 1)) *
        mat (unitaryInvolution K 2 f) (k + 2) x at em
    rw [mat_rootU_eq (by omega)] at em
    rwa [← CFSG.StandardType.ggInvMatrix_one (k + 1) (by omega)] at em
  have h00 : mat (unitaryInvolution K 2 f) (k + 2) x 0 0 = 1 := by
    have h := LinFusion.corner_eq_of_commute (by omega) hcomm
    rw [h.symm, hcorner]
  have hrow : ∀ b, mat (unitaryInvolution K 2 f) (k + 2) x 0 b =
      if b = 0 then (1 : K) else 0 := by
    intro b
    simpa [hcorner] using
      (LinFusion.row_zero_of_commute (by omega) hcomm b)
  have hcol : ∀ a, mat (unitaryInvolution K 2 f) (k + 2) x a (Fin.last (k + 1)) =
      if a = Fin.last (k + 1) then (1 : K) else 0 := by
    intro a
    simpa [h00] using
      (LinFusion.col_last_of_commute (by omega) hcomm a)
  have hlast : ∀ a : Fin k, mat (unitaryInvolution K 2 f) (k + 2) x
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid a) (Fin.last (k + 1)) = 0 := by
    intro a
    rw [hcol]
    rw [if_neg (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_ne_last a)]
  have hrowlast : ∀ b : Fin k, mat (unitaryInvolution K 2 f) (k + 2) x 0
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid b) = 0 := by
    intro b
    rw [hrow]
    rw [if_neg (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_ne_zero b)]
  have hcoe := slHom_matrix_eq h (k + 1) hm x
  refine P.mem_radical.mpr fun i j hij => ?_
  change ((slHom h (k + 1) hm x : SpecialLinearGroup (Fin (k + 2)) K) :
    Matrix (Fin (k + 2)) (Fin (k + 2)) K) i j =
      (1 : Matrix (Fin (k + 2)) (Fin (k + 2)) K) i j
  rw [hcoe]
  by_cases hi0 : i = 0
  · subst i
    rw [hrow]
    by_cases hj : j = 0
    · subst j
      rw [if_pos rfl, Matrix.one_apply_eq]
    · rw [if_neg hj, Matrix.one_apply_ne (Ne.symm hj)]
  by_cases hil : i = Fin.last (k + 1)
  · subst i
    have hu0 : P.u 0 = Fin.last (k + 1) := by
      rw [hP]; exact LinFusion.ggTransPlacement_u hm 0
    have hlastlev : P.level (Fin.last (k + 1)) = 0 := by
      rw [← hu0]; exact P.level_u 0
    have hj : j = Fin.last (k + 1) := by
      by_contra hj
      have hlev : P.level j = 0 ∨ P.level j = 1 ∨ P.level j = 2 := by
        have := P.level_le_two j; omega
      rcases hlev with h0 | h1 | h2
      · obtain ⟨a, ha⟩ := P.level_eq_zero_iff.mp h0
        exact hj (by rw [← ha, hP]; exact LinFusion.ggTransPlacement_u hm a)
      · have := hij
        rw [hlastlev] at this
        omega
      · have := hij
        rw [hlastlev] at this
        omega
    subst j
    rw [hcol]
    rw [if_pos rfl]
    rw [Matrix.one_apply_eq]
  · have hi_mid : i ∈ Set.range
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) := by
      rw [CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mem_range_mid]
      have h0 : (i : ℕ) ≠ 0 := fun h => hi0 (Fin.ext h)
      have hl : (i : ℕ) ≠ k + 1 := fun h => hil (Fin.ext (by simpa using h))
      have := i.isLt
      omega
    obtain ⟨a, rfl⟩ := hi_mid
    by_cases hjlast : j = Fin.last (k + 1)
    · subst j
      rw [hlast a, Matrix.one_apply_ne
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_ne_last a)]
    by_cases hj0 : j = 0
    · subst j
      have hw0 : P.w 0 = (0 : Fin (k + 2)) := by
        rw [hP]; exact LinFusion.ggTransPlacement_w hm 0
      have hlev : P.level 0 = 2 := by
        rw [← hw0]; exact P.level_w 0
      have := hij
      rw [hlev] at this
      have hlevi : P.level
          (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid a) = 1 := by
        rw [P.level_eq_one_iff]
        refine ⟨fun b => ?_, fun b => ?_⟩
        · rw [hP]; rw [LinFusion.ggTransPlacement_u hm b]
          exact (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_ne_last a).symm
        · rw [hP]; rw [LinFusion.ggTransPlacement_w hm b]
          exact (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_ne_zero a).symm
      omega
    · have hj_mid : j ∈ Set.range
          (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) := by
        rw [CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mem_range_mid]
        have h0 : (j : ℕ) ≠ 0 := fun h => hj0 (Fin.ext h)
        have hl : (j : ℕ) ≠ k + 1 := fun h => hjlast (Fin.ext (by simpa using h))
        have := j.isLt
        omega
      obtain ⟨b, rfl⟩ := hj_mid
      have hmidab : mat (unitaryInvolution K 2 f) (k + 2) x
          (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid a)
          (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid b) =
          (1 : Matrix (Fin (k + 2)) (Fin (k + 2)) K)
            (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid a)
            (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid b) := by
        simpa [Matrix.one_apply,
          CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_injective.eq_iff] using
            congrFun (congrFun hmid a) b
      rw [hmidab]

end Corner

section OTwoAux

open CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree
  (iotaHom iotaMat iotaMat_isBlkOn mat_iotaHom mid_ne_zero mid_ne_last)

variable (h : UnitaryFieldData 2 f K) {k : ℕ}

theorem suRad_eq_suR (hk : 2 ≤ k) :
    RCSTSU.suRad (unitaryInvolution K 2 f) k = suR h (k + 1) := by
  ext x
  constructor
  · intro hx
    obtain ⟨hxC, hcorner, hmid⟩ := RCSTSU.mem_suRad.mp hx
    exact mem_suR_of_corner_aux h k (by omega) hxC hcorner hmid
  · intro hx
    obtain ⟨hrow, hcol, hmid⟩ := mem_suR_entries_aux h k (by omega) hx
    refine RCSTSU.mem_suRad.mpr ⟨suR_le_centralizer h (by omega) hx, ?_, ?_⟩
    · simpa using hcol (Fin.last (k + 1))
    · ext a b
      rw [Matrix.submatrix_apply, hmid a b]
      simp [Matrix.one_apply,
        CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_injective.eq_iff]

private theorem iotaMat_mul_single_last (B : Matrix (Fin k) (Fin k) K) :
    iotaMat (m := k) B *
      Matrix.single (0 : Fin (k + 2)) (Fin.last (k + 1)) (1 : K) =
    Matrix.single (0 : Fin (k + 2)) (Fin.last (k + 1)) (1 : K) := by
  ext i j
  rw [Matrix.mul_apply, Finset.sum_eq_single (0 : Fin (k + 2))]
  · by_cases hj : j = Fin.last (k + 1)
    · subst hj
      by_cases hi : i = 0
      · subst hi
        rw [iotaMat_isBlkOn (m := k) B 0 0
          (Or.inl (by rintro ⟨a, ha⟩; exact mid_ne_zero a ha))]
        simp [Matrix.one_apply, Matrix.single_apply]
      · rw [iotaMat_isBlkOn (m := k) B i 0
          (Or.inr (by rintro ⟨a, ha⟩; exact mid_ne_zero a ha))]
        have h0i : (0 : Fin (k + 2)) ≠ i := fun h => hi h.symm
        simp [Matrix.one_apply, Matrix.single_apply, hi, h0i]
    · simp [Matrix.single_apply, hj, Ne.symm hj]
  · intro x _ hx
    simp [Matrix.single_apply, hx, Ne.symm hx]
  · intro hmem
    exact absurd (Finset.mem_univ _) hmem

private theorem single_last_mul_iotaMat (B : Matrix (Fin k) (Fin k) K) :
    Matrix.single (0 : Fin (k + 2)) (Fin.last (k + 1)) (1 : K) *
      iotaMat (m := k) B =
    Matrix.single (0 : Fin (k + 2)) (Fin.last (k + 1)) (1 : K) := by
  ext i j
  rw [Matrix.mul_apply, Finset.sum_eq_single (Fin.last (k + 1))]
  · by_cases hi : i = 0
    · subst hi
      by_cases hj : j = Fin.last (k + 1)
      · subst hj
        rw [iotaMat_isBlkOn (m := k) B (Fin.last (k + 1)) (Fin.last (k + 1))
          (Or.inl (by rintro ⟨a, ha⟩; exact mid_ne_last a ha))]
        simp [Matrix.one_apply, Matrix.single_apply]
      · rw [iotaMat_isBlkOn (m := k) B (Fin.last (k + 1)) j
          (Or.inl (by rintro ⟨a, ha⟩; exact mid_ne_last a ha))]
        simp [Matrix.one_apply, Matrix.single_apply, hj]
    · have h0i : (0 : Fin (k + 2)) ≠ i := fun h => hi h.symm
      simp [Matrix.single_apply, h0i]
  · intro x _ hx
    simp [Matrix.single_apply, hx, Ne.symm hx]
  · intro hmem
    exact absurd (Finset.mem_univ _) hmem

theorem iotaHom_commute_lroot (hi : (0 : Fin (k + 2)) ≠ Fin.rev 0)
    (B : SU (unitaryInvolution K 2 f) k) :
    iotaHom (σ := unitaryInvolution K 2 f) (m := k) B *
      AutPSU.lroot (unitaryInvolution K 2 f) hi =
    AutPSU.lroot (unitaryInvolution K 2 f) hi *
      iotaHom (σ := unitaryInvolution K 2 f) (m := k) B := by
  apply CFSG.LieType.Universal.Unitary.SUExtras.mat_injective
  have hlroot : mat (unitaryInvolution K 2 f) (k + 2)
      (AutPSU.lroot (unitaryInvolution K 2 f) hi) =
      1 + Matrix.single (0 : Fin (k + 2)) (Fin.last (k + 1)) (1 : K) := by
    rw [CFSG.LieType.Universal.Unitary.SUExtras.mat_apply, AutPSU.coe_lroot]
    simp
  rw [map_mul, map_mul, mat_iotaHom, hlroot]
  change iotaMat (m := k) ((mat (unitaryInvolution K 2 f) k) B) *
      (1 + Matrix.single (0 : Fin (k + 2)) (Fin.last (k + 1)) (1 : K)) =
    (1 + Matrix.single (0 : Fin (k + 2)) (Fin.last (k + 1)) (1 : K)) *
      iotaMat (m := k) ((mat (unitaryInvolution K 2 f) k) B)
  rw [Matrix.mul_add, Matrix.mul_one, iotaMat_mul_single_last ((mat (unitaryInvolution K 2 f) k) B),
    Matrix.add_mul, Matrix.one_mul, single_last_mul_iotaMat ((mat (unitaryInvolution K 2 f) k) B)]

end OTwoAux

section Isometry

variable {σ : K ≃+* K}

private theorem isometry_submatrix_mid_of_row_zero (k : ℕ)
    (x : SU σ (k + 2)) (hrow : ∀ b : Fin k, mat σ (k + 2) x 0
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid b) = 0) :
    CFSG.LieType.Universal.Unitary.conjTr σ ((mat σ (k + 2) x).submatrix
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))) * antidiag k *
      (mat σ (k + 2) x).submatrix
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) = antidiag k := by
  ext i j
  rw [CFSG.LieType.Steinberg.conjTr_mul_antidiag_mul_apply,
    Fintype.sum_of_injective
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_injective) _
      (fun t => σ (mat σ (k + 2) x t
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid i)) *
        mat σ (k + 2) x (Fin.rev t)
          (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid j)) ?_ ?_,
    CFSG.LieType.Universal.Unitary.SUExtras.sum_mat_mul_mat x
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid i)
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid j)]
  · simp only [antidiag, Matrix.of_apply,
      CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.rev_mid,
      CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_injective.eq_iff]
  · intro t ht
    by_cases h0 : t = 0
    · subst h0
      rw [hrow i, map_zero, zero_mul]
    · have hL : t = Fin.last (k + 1) := by
        rw [CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mem_range_mid] at ht
        have h0' : (t : ℕ) ≠ 0 := fun h => h0 (Fin.ext h)
        ext
        simp only [Fin.val_last]
        omega
      subst hL
      rw [Fin.rev_last, hrow j, mul_zero]
  · intro s
    rw [CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.rev_mid]
    rfl

end Isometry

section OTwoTwoElt

open CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree
  (mid mid_injective mid_ne_zero mid_ne_last iotaHom mat_iotaHom iotaMat)

variable (h : UnitaryFieldData 2 f K) {k : ℕ}

private theorem twoElt_suL_mem_iota (hk : 2 ≤ k)
    {x : SU (unitaryInvolution K 2 f) (k + 2)} (hxL : x ∈ suL h (k + 1))
    (hx2 : ∃ n, x ^ 2 ^ n = 1) :
    x ∈ (iotaHom (σ := unitaryInvolution K 2 f) (m := k)).range := by
  have hm1 : 1 ≤ k + 1 := by omega
  rw [suL_of_le h hm1] at hxL
  have hxC0 : x ∈ Subgroup.centralizer
      ({AutPSU.rootU (K := K) (f := f) (k + 1)} :
        Set (SU (unitaryInvolution K 2 f) (k + 2))) := hxL.1
  have hxl : x ∈ Subgroup.centralizer
      ({AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1)} :
        Set (SU (unitaryInvolution K 2 f) (k + 2))) := hxL.2
  let y : SU (unitaryInvolution K 2 f) (k + 2) :=
    AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1)
  have hxlY : x ∈ Subgroup.centralizer ({y} : Set (SU (unitaryInvolution K 2 f) (k + 2))) := by
    change x ∈ Subgroup.centralizer
      ({AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1)} :
        Set (SU (unitaryInvolution K 2 f) (k + 2)))
    exact hxl
  have hxC : x ∈ Subgroup.centralizer
      ({ggInvSU (unitaryInvolution K 2 f) (k + 2) 1} :
        Set (SU (unitaryInvolution K 2 f) (k + 2))) := by
    simpa [AutPSU.rootU] using hxC0
  obtain ⟨n, hn⟩ := hx2
  have hcorner : mat (unitaryInvolution K 2 f) (k + 2) x
      (Fin.last (k + 1)) (Fin.last (k + 1)) = 1 := by
    have hpow := RCSTSU.corner_pow (σ := unitaryInvolution K 2 f) (k := k) hxC (2 ^ n)
    rw [hn, map_one, Matrix.one_apply_eq] at hpow
    rcases Nat.eq_zero_or_pos n with hn0 | hnpos
    · have hx1 : x = 1 := by simpa [hn0] using hn
      rw [hx1, map_one, Matrix.one_apply_eq]
    · have hzero : (mat (unitaryInvolution K 2 f) (k + 2) x
          (Fin.last (k + 1)) (Fin.last (k + 1)) - 1) ^ 2 ^ n = 0 := by
        rw [sub_pow_char_pow, ← hpow, one_pow, sub_self]
      exact sub_eq_zero.mp ((pow_eq_zero_iff (pow_ne_zero n two_ne_zero)).mp hzero)
  have hA := RCSTSU.commute_of_mem hxC
  have h00 : mat (unitaryInvolution K 2 f) (k + 2) x 0 0 = 1 := by
    rw [← CFSG.StandardType.RootCentSU.corner_eq_of_commute hA]
    exact hcorner
  have hcol : ∀ a, mat (unitaryInvolution K 2 f) (k + 2) x a (Fin.last (k + 1)) =
      (1 : Matrix (Fin (k + 2)) (Fin (k + 2)) K) a (Fin.last (k + 1)) := by
    intro a
    rw [CFSG.StandardType.RootCentSU.col_last_of_commute hA, h00]
    by_cases ha : a = Fin.last (k + 1)
    · rw [ite_eq_left ha, ha, Matrix.one_apply_eq]
    · rw [ite_eq_right ha, Matrix.one_apply_ne ha]
  have hrow : ∀ b, mat (unitaryInvolution K 2 f) (k + 2) x 0 b =
      (1 : Matrix (Fin (k + 2)) (Fin (k + 2)) K) 0 b := by
    intro b
    rw [CFSG.StandardType.RootCentSU.row_zero_of_commute hA, hcorner]
    by_cases hb : b = 0
    · rw [ite_eq_left hb, hb, Matrix.one_apply_eq]
    · rw [ite_eq_right hb, Matrix.one_apply_ne (Ne.symm hb)]
  have hdet : ((mat (unitaryInvolution K 2 f) (k + 2) x).submatrix mid mid).det = 1 := by
    rw [← CFSG.StandardType.RootCentSU.det_eq_det_submatrix_mid hrow hcol]
    exact x.2.1
  have hrow0 : ∀ b : Fin k, mat (unitaryInvolution K 2 f) (k + 2) x 0 (mid b) = 0 := by
    intro b
    rw [hrow, Matrix.one_apply_ne (Ne.symm (mid_ne_zero b))]
  have hBu : IsUnit ((mat (unitaryInvolution K 2 f) (k + 2) x).submatrix mid mid).det := by
    rw [hdet]; exact isUnit_one
  let Bsu : SU (unitaryInvolution K 2 f) k :=
    ⟨⟨(mat (unitaryInvolution K 2 f) (k + 2) x).submatrix mid mid,
      ((mat (unitaryInvolution K 2 f) (k + 2) x).submatrix mid mid)⁻¹,
      Matrix.mul_nonsing_inv _ hBu, Matrix.nonsing_inv_mul _ hBu⟩, hdet,
      isometry_submatrix_mid_of_row_zero k x hrow0⟩
  have hmatB : mat (unitaryInvolution K 2 f) k Bsu =
      (mat (unitaryInvolution K 2 f) (k + 2) x).submatrix mid mid := rfl
  have hιC : iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu ∈
      Subgroup.centralizer ({ggInvSU (unitaryInvolution K 2 f) (k + 2) 1} :
        Set (SU (unitaryInvolution K 2 f) (k + 2))) :=
    RCSTSU.range_iotaHom_le_centralizer ⟨Bsu, rfl⟩
  have hinv : (iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu)⁻¹ =
      iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu⁻¹ := (map_inv _ _).symm
  have hrC : (iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu)⁻¹ * x ∈
      Subgroup.centralizer ({ggInvSU (unitaryInvolution K 2 f) (k + 2) 1} :
        Set (SU (unitaryInvolution K 2 f) (k + 2))) :=
    mul_mem (inv_mem hιC) hxC
  have hrcorner : mat (unitaryInvolution K 2 f) (k + 2)
      ((iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu)⁻¹ * x)
      (Fin.last (k + 1)) (Fin.last (k + 1)) = 1 := by
    rw [RCSTSU.corner_mul_of_mem hxC, hcorner, mul_one, hinv, RCSTSU.corner_iotaHom]
  have hrmid : (mat (unitaryInvolution K 2 f) (k + 2)
      ((iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu)⁻¹ * x)).submatrix mid mid = 1 := by
    rw [RCSTSU.submatrix_mul_of_mem (inv_mem hιC) hxC, hinv, mat_iotaHom,
      CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.submatrix_iotaMat,
      ← hmatB, ← map_mul, inv_mul_cancel, map_one]
  have hr : (iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu)⁻¹ * x ∈
      RCSTSU.suRad (unitaryInvolution K 2 f) k :=
    RCSTSU.mem_suRad.mpr ⟨hrC, hrcorner, hrmid⟩
  have hxe : x = iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu *
      ((iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu)⁻¹ * x) := by
    rw [mul_inv_cancel_left]
  have hb_lroot : iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu ∈
      Subgroup.centralizer ({y} : Set (SU (unitaryInvolution K 2 f) (k + 2))) := by
    rw [Subgroup.mem_centralizer_singleton_iff]
    change iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu * y =
      y * iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu
    exact iotaHom_commute_lroot (zero_ne_rev_zero hm1) Bsu
  have hrl : (iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu)⁻¹ * x ∈
      Subgroup.centralizer ({y} : Set (SU (unitaryInvolution K 2 f) (k + 2))) :=
    mul_mem (inv_mem hb_lroot) hxlY
  have hrbot : (iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu)⁻¹ * x = 1 := by
    have hrR : (iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu)⁻¹ * x ∈
        suR h (k + 1) := by
      rw [← suRad_eq_suR h hk]
      exact hr
    have hrL : (iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu)⁻¹ * x ∈
        suL h (k + 1) := by
      rw [suL_of_le h hm1]
      refine ⟨?_, hrl⟩
      simpa [AutPSU.rootU] using (RCSTSU.mem_suRad.mp hr).1
    have hb : (iotaHom (σ := unitaryInvolution K 2 f) (m := k) Bsu)⁻¹ * x ∈
        (⊥ : Subgroup (SU (unitaryInvolution K 2 f) (k + 2))) := by
      rw [← suR_inf_suL_aux h k hk]
      exact ⟨hrR, hrL⟩
    exact Subgroup.mem_bot.mp hb
  rw [hxe, hrbot, mul_one]
  exact ⟨Bsu, rfl⟩

end OTwoTwoElt

section PCoreSU

open CFSG.SeitzReduction.UnitaryPilot

private theorem pCore_two_su_two_eq_bot (h : UnitaryFieldData 2 f K) :
    CFSG.pCore 2 (SU (unitaryInvolution K 2 f) 2) = ⊥ := by
  have hF : Nat.card K = (2 ^ f) ^ 2 := by
    rw [h.card]
    calc (2 : ℕ) ^ (2 * f) = 2 ^ (f + f) := by rw [show 2 * f = f + f by omega]
      _ = 2 ^ f * 2 ^ f := by rw [pow_add]
      _ = (2 ^ f) ^ 2 := by rw [pow_two]
  obtain ⟨⟨e⟩, hcard⟩ := RCSTSU.exists_equiv_sl2 (F := K) (f := f) hF
  exact CFSG.CGT.PushingUpLit.CGT6.pCore_eq_bot_of_equiv e.symm
    (CFSG.Quasithin.SimsG4.pCore_sl2_charTwo
      (F := CFSG.LieType.Steinberg.fixedSubfield K 2 f))

private theorem odd_card_center_su (h : UnitaryFieldData 2 f K) {k : ℕ}
    (hk : 3 ≤ k) (hkq : (k, 2 ^ f) ≠ (3, 2)) :
    Odd (Nat.card (Subgroup.center (SU (unitaryInvolution K 2 f) k))) := by
  rw [← Nat.not_even_iff_odd]
  intro heven
  haveI : Fintype (Subgroup.center (SU (unitaryInvolution K 2 f) k)) := Fintype.ofFinite _
  have h2dvd : 2 ∣ Nat.card (Subgroup.center (SU (unitaryInvolution K 2 f) k)) :=
    even_iff_two_dvd.mp heven
  rw [Nat.card_eq_fintype_card] at h2dvd
  obtain ⟨z, hzord⟩ := exists_prime_orderOf_dvd_card
    (G := Subgroup.center (SU (unitaryInvolution K 2 f) k)) 2 h2dvd
  have hz2 : ((z : SU (unitaryInvolution K 2 f) k) ^ 2) = 1 := by
    have hpow := pow_orderOf_eq_one z
    rw [hzord] at hpow
    simpa using congrArg (fun w : Subgroup.center (SU (unitaryInvolution K 2 f) k) =>
      (w : SU (unitaryInvolution K 2 f) k)) hpow
  have hz1 : (z : SU (unitaryInvolution K 2 f) k) = 1 :=
    CFSG.StandardType.eq_one_of_mem_center_SU_of_sq_eq_one
      (unitaryInvolution K 2 f) z.2 hz2
  have hz : z = 1 := Subtype.ext hz1
  rw [hz] at hzord
  simp at hzord

private theorem pCore_two_su_quasisimple_eq_bot (h : UnitaryFieldData 2 f K) {k : ℕ} (hk : 3 ≤ k)
    (hkq : (k, 2 ^ f) ≠ (3, 2)) :
    CFSG.pCore 2 (SU (unitaryInvolution K 2 f) k) = ⊥ := by
  have hF : Nat.card K = (2 ^ f) ^ 2 := by
    rw [h.card]
    calc (2 : ℕ) ^ (2 * f) = 2 ^ (f + f) := by rw [show 2 * f = f + f by omega]
      _ = 2 ^ f * 2 ^ f := by rw [pow_add]
      _ = (2 ^ f) ^ 2 := by rw [pow_two]
  have hq : CFSG.IsQuasisimple (SU (unitaryInvolution K 2 f) k) :=
    RCSTSU.isQuasisimple_su (f := f) hF (Or.inl ⟨hk, hkq⟩)
  exact forall_normal_isPGroup_eq_bot_of_isQuasisimple_of_odd_center
    hq (odd_card_center_su h hk hkq) (CFSG.pCore 2 (SU (unitaryInvolution K 2 f) k))
    CFSG.pCore_normal CFSG.pCore_isPGroup

end PCoreSU

section ThreeTwo

open CFSG.HardMathSupport.Solomon.Coordinator
open CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree (iotaHom)

private theorem normal_coprime_eq_bot_of_heis {Q : Type} [Group Q] [Finite Q] {X P w F : Q}
    (H : HeisData Q X P w F) {N : Subgroup Q} (hN : N.Normal)
    (hcop : Nat.Coprime 3 (Nat.card N)) : N = ⊥ := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hR : (heisR X P).Normal := H.normal_R
  have hR27 : Nat.card (heisR X P) = 27 := H.card_R
  have hcop27 : Nat.Coprime (Nat.card N) 27 := by
    rw [show (27 : ℕ) = 3 ^ 3 by norm_num]
    exact Nat.Coprime.pow_right 3 hcop.symm
  have hNR : N ⊓ heisR X P = ⊥ := by
    have hd1 : Nat.card ↥(N ⊓ heisR X P) ∣ Nat.card N := Subgroup.card_dvd_of_le inf_le_left
    have hd2 : Nat.card ↥(N ⊓ heisR X P) ∣ 27 := by
      have h := Subgroup.card_dvd_of_le (inf_le_right : N ⊓ heisR X P ≤ heisR X P)
      rwa [hR27] at h
    have hcopd : Nat.Coprime (Nat.card ↥(N ⊓ heisR X P)) 27 :=
      Nat.Coprime.coprime_dvd_left hd1 hcop27
    exact Subgroup.eq_bot_of_card_eq _ (Nat.Coprime.eq_one_of_dvd hcopd hd2)
  have hcomm : ∀ n ∈ N, ∀ x ∈ heisR X P, n * x = x * n := by
    intro n hn x hx
    have hc1 : n * x * n⁻¹ * x⁻¹ ∈ N := by
      have h1 : x * n⁻¹ * x⁻¹ ∈ N := hN.conj_mem n⁻¹ (N.inv_mem hn) x
      have h2 : n * x * n⁻¹ * x⁻¹ = n * (x * n⁻¹ * x⁻¹) := by simp only [mul_assoc]
      rw [h2]
      exact N.mul_mem hn h1
    have hc2 : n * x * n⁻¹ * x⁻¹ ∈ heisR X P := by
      have h1 : n * x * n⁻¹ ∈ heisR X P := hR.conj_mem x hx n
      exact (heisR X P).mul_mem h1 ((heisR X P).inv_mem hx)
    have hc3 : n * x * n⁻¹ * x⁻¹ ∈ N ⊓ heisR X P := ⟨hc1, hc2⟩
    rw [hNR, Subgroup.mem_bot] at hc3
    have h4 : n * x * n⁻¹ = x := mul_inv_eq_one.mp hc3
    exact mul_inv_eq_iff_eq_mul.mp h4
  have hone : ∀ n ∈ N, n = 1 := by
    intro n hn
    have hnX : n * X = X * n := hcomm n hn X (X_mem_heisR X P)
    have hnP : n * P = P * n := hcomm n hn P (P_mem_heisR X P)
    have hz : n ∈ Subgroup.center Q := H.cent n hnX hnP
    have hzw : n ∈ Subgroup.zpowers w := H.center_le n hz
    have hdvd3 : orderOf n ∣ 3 := by
      have h := orderOf_dvd_of_mem_zpowers hzw
      rwa [orderOf_eq_prime H.w_pow H.w_ne] at h
    have hdvdN : orderOf n ∣ Nat.card N := by
      rw [← Nat.card_zpowers n]
      exact Subgroup.card_dvd_of_le (Subgroup.zpowers_le.2 hn)
    have hcopn : Nat.Coprime (orderOf n) 3 := Nat.Coprime.coprime_dvd_left hdvdN hcop.symm
    exact orderOf_eq_one_iff.mp (Nat.Coprime.eq_one_of_dvd hcopn hdvd3)
  rw [eq_bot_iff]
  intro n hn
  rw [Subgroup.mem_bot]
  exact hone n hn

private theorem pCore_two_statedSU_three_two_eq_bot {K : Type} [Field K] [Finite K]
    (hK : Nat.card K = (2 ^ 1) ^ 2) :
    CFSG.pCore 2 (CFSG.Open.StatedSU 3 (2 ^ 1) K) = ⊥ := by
  obtain ⟨X, P, w, F, hHeis, hw⟩ := exists_heisData_statedSU_two (K := K) hK
  apply le_antisymm
  · unfold CFSG.pCore
    rw [sSup_le_iff]
    rintro N ⟨hNn, hN2⟩
    obtain ⟨a, ha⟩ := hN2.exists_card_eq
    have hcop : Nat.Coprime 3 (Nat.card N) := by
      rw [ha]
      exact Nat.Coprime.pow_right a (by decide : Nat.Coprime 3 2)
    exact (normal_coprime_eq_bot_of_heis hHeis hNn hcop).le
  · exact bot_le

private theorem pCore_two_su_three_two_eq_bot (h : UnitaryFieldData 2 f K) (hq : 2 ^ f = 2) :
    CFSG.pCore 2 (SU (unitaryInvolution K 2 f) 3) = ⊥ := by
  have hf1 : f = 1 := by
    apply Nat.pow_right_injective (by norm_num : 2 ≤ 2)
    simpa using hq
  subst f
  have hF : Nat.card K = (2 ^ 1) ^ 2 := by
    rw [h.card]
    norm_num
  exact CFSG.CGT.PushingUpLit.CGT6.pCore_eq_bot_of_equiv
    (CFSG.LieType.Universal.Unitary.equivStatedSU (p := 2) (f := 1) hF 3)
    (pCore_two_statedSU_three_two_eq_bot hF)

private theorem pCore_two_su_eq_bot (h : UnitaryFieldData 2 f K) {k : ℕ} (hk : 2 ≤ k) :
    CFSG.pCore 2 (SU (unitaryInvolution K 2 f) k) = ⊥ := by
  by_cases hk2 : k = 2
  · subst hk2
    exact pCore_two_su_two_eq_bot h
  by_cases h32 : k = 3 ∧ 2 ^ f = 2
  · obtain ⟨rfl, hq⟩ := h32
    exact pCore_two_su_three_two_eq_bot h hq
  · have hk3 : 3 ≤ k := by omega
    have hkq : (k, 2 ^ f) ≠ (3, 2) := by
      intro hh
      exact h32 ⟨congrArg Prod.fst hh, congrArg Prod.snd hh⟩
    exact pCore_two_su_quasisimple_eq_bot h hk3 hkq

private theorem normal_twoSubgroup_suL_eq_bot (h : UnitaryFieldData 2 f K) {k : ℕ}
    (hk : 2 ≤ k) (H : Subgroup (suL h (k + 1))) (hHn : H.Normal)
    (hH2 : IsPGroup 2 H) : H = ⊥ := by
  have hm1 : 1 ≤ k + 1 := by omega
  have hiota_suL : ∀ g : SU (unitaryInvolution K 2 f) k,
      iotaHom (σ := unitaryInvolution K 2 f) (m := k) g ∈ suL h (k + 1) := by
    intro g
    rw [suL_of_le h hm1]
    refine ⟨RCSTSU.range_iotaHom_le_centralizer ⟨g, rfl⟩, ?_⟩
    let y0 : SU (unitaryInvolution K 2 f) (k + 2) :=
      AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1)
    change iotaHom (σ := unitaryInvolution K 2 f) (m := k) g ∈
      Subgroup.centralizer ({y0} : Set (SU (unitaryInvolution K 2 f) (k + 2)))
    rw [Subgroup.mem_centralizer_singleton_iff]
    change iotaHom (σ := unitaryInvolution K 2 f) (m := k) g * y0 =
      y0 * iotaHom (σ := unitaryInvolution K 2 f) (m := k) g
    dsimp [y0]
    exact iotaHom_commute_lroot (zero_ne_rev_zero hm1) g
  let Hι : Subgroup (SU (unitaryInvolution K 2 f) (k + 2)) :=
    H.map (suL h (k + 1)).subtype
  have hHι2 : IsPGroup 2 Hι := hH2.map _
  have hHι_range : Hι ≤ (iotaHom (σ := unitaryInvolution K 2 f) (m := k)).range := by
    intro x hx
    obtain ⟨y, hy, hxy⟩ := Subgroup.mem_map.mp hx
    have hy2 : ∃ n, (y : SU (unitaryInvolution K 2 f) (k + 2)) ^ 2 ^ n = 1 := by
      obtain ⟨n, hn⟩ := hH2 ⟨y, hy⟩
      refine ⟨n, ?_⟩
      have hn' : (y : suL h (k + 1)) ^ 2 ^ n = 1 := by
        simpa using congrArg (fun w : H => (w : suL h (k + 1))) hn
      simpa using congrArg (fun w : suL h (k + 1) =>
        (w : SU (unitaryInvolution K 2 f) (k + 2))) hn' 
    rw [← hxy]
    exact twoElt_suL_mem_iota h hk y.2 hy2
  let H0 : Subgroup (SU (unitaryInvolution K 2 f) k) :=
    Hι.comap (iotaHom (σ := unitaryInvolution K 2 f) (m := k))
  have hH0_2 : IsPGroup 2 H0 :=
    IsPGroup.comap_of_injective hHι2 _
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaHom_injective)
  have hH0n : H0.Normal := by
    refine ⟨fun x hx g => ?_⟩
    change iotaHom (σ := unitaryInvolution K 2 f) (m := k) x ∈ Hι at hx
    obtain ⟨y, hy, hxy⟩ := Subgroup.mem_map.mp hx
    have hgL : iotaHom (σ := unitaryInvolution K 2 f) (m := k) g ∈ suL h (k + 1) :=
      hiota_suL g
    have hconjH : (⟨iotaHom (σ := unitaryInvolution K 2 f) (m := k) g, hgL⟩ :
          suL h (k + 1)) * y *
          (⟨iotaHom (σ := unitaryInvolution K 2 f) (m := k) g, hgL⟩ :
            suL h (k + 1))⁻¹ ∈ H :=
      hHn.conj_mem y hy ⟨iotaHom (σ := unitaryInvolution K 2 f) (m := k) g, hgL⟩
    rw [Subgroup.mem_comap]
    refine Subgroup.mem_map.mpr ⟨_, hconjH, ?_⟩
    simp only [Subgroup.coe_subtype, map_mul, map_inv, hxy]
  have hH0map : H0.map (iotaHom (σ := unitaryInvolution K 2 f) (m := k)) =
      Hι := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hy
    · intro hx
      obtain ⟨y, rfl⟩ := hHι_range hx
      exact ⟨y, hx, rfl⟩
  have hH0le : H0 ≤ CFSG.pCore 2 (SU (unitaryInvolution K 2 f) k) := by
    unfold CFSG.pCore
    exact le_sSup ⟨hH0n, hH0_2⟩
  rw [pCore_two_su_eq_bot h hk] at hH0le
  have hH0bot : H0 = ⊥ := le_bot_iff.mp hH0le
  have hHιbot : Hι = ⊥ := by
    rw [← hH0map, hH0bot, Subgroup.map_bot]
  have hHmapbot : H.map (suL h (k + 1)).subtype = ⊥ := by
    change Hι = ⊥ at hHιbot
    exact hHιbot
  rw [Subgroup.map_eq_bot_iff] at hHmapbot
  have hker : (suL h (k + 1)).subtype.ker = ⊥ :=
    MonoidHom.ker_eq_bot_iff _ |>.mpr (Subgroup.subtype_injective _)
  rw [hker] at hHmapbot
  exact le_bot_iff.mp hHmapbot

end ThreeTwo

section Det

variable {k : ℕ}

private theorem det_eq_corner_sq_mul_mid {B : Matrix (Fin (k + 2)) (Fin (k + 2)) K}
    (hrow : ∀ j, B 0 j = if j = 0 then B (Fin.last (k + 1)) (Fin.last (k + 1)) else 0)
    (hcol : ∀ i, B i (Fin.last (k + 1)) =
      if i = Fin.last (k + 1) then B (Fin.last (k + 1)) (Fin.last (k + 1)) else 0)
    (hcorner : B (Fin.last (k + 1)) (Fin.last (k + 1)) = B 0 0)
    (hlam0 : B (Fin.last (k + 1)) (Fin.last (k + 1)) ≠ 0) :
    B.det = (B (Fin.last (k + 1)) (Fin.last (k + 1))) ^ 2 *
      (B.submatrix (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))).det := by
  set lam := B (Fin.last (k + 1)) (Fin.last (k + 1)) with hlam
  set y : Matrix (Fin (k + 2)) (Fin (k + 2)) K := lam⁻¹ • B with hy
  have hyrow : ∀ b, y 0 b = (1 : Matrix (Fin (k + 2)) (Fin (k + 2)) K) 0 b := by
    intro b
    rw [hy, Matrix.smul_apply, smul_eq_mul]
    by_cases hb : b = 0
    · subst hb
      rw [hrow 0, if_pos rfl, Matrix.one_apply_eq]
      exact inv_mul_cancel₀ hlam0
    · rw [hrow b, if_neg hb, Matrix.one_apply_ne (Ne.symm hb), mul_zero]
  have hycol : ∀ a, y a (Fin.last (k + 1)) =
      (1 : Matrix (Fin (k + 2)) (Fin (k + 2)) K) a (Fin.last (k + 1)) := by
    intro a
    rw [hy, Matrix.smul_apply, smul_eq_mul, hcol a]
    by_cases ha : a = Fin.last (k + 1)
    · subst ha
      rw [if_pos rfl, Matrix.one_apply_eq]
      exact inv_mul_cancel₀ hlam0
    · rw [if_neg ha, Matrix.one_apply_ne ha, mul_zero]
  have hdet := RootCentSU.det_eq_det_submatrix_mid hyrow hycol
  have hleft : y.det = (lam⁻¹) ^ (k + 2) * B.det := by
    rw [hy, Matrix.det_smul, Fintype.card_fin]
  have hright : (y.submatrix (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))).det =
      (lam⁻¹) ^ k * (B.submatrix
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))).det := by
    have hy' : y.submatrix (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) =
        lam⁻¹ • (B.submatrix
          (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
          (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))) := by
      ext a b
      rw [hy, Matrix.submatrix_apply, Matrix.smul_apply, Matrix.smul_apply, smul_eq_mul,
        smul_eq_mul, Matrix.submatrix_apply]
    rw [hy', Matrix.det_smul, Fintype.card_fin]
  rw [hleft, hright] at hdet
  have h2 : (lam⁻¹) ^ 2 * B.det = (B.submatrix
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))).det := by
    have h := hdet
    rw [pow_add, mul_assoc] at h
    exact mul_left_cancel₀ (pow_ne_zero k (inv_ne_zero hlam0)) h
  have h3 : B.det = lam ^ 2 * (B.submatrix
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))).det := by
    have := congrArg (fun z => lam ^ 2 * z) h2
    field_simp [hlam0] at this
    simpa [pow_two, mul_assoc, mul_comm, mul_left_comm] using this
  rw [h3, hlam]

end Det

section CommuteEntries

variable {k : ℕ}

private theorem commute_single_last_zero_of_row_col {B : Matrix (Fin (k + 2)) (Fin (k + 2)) K}
    (hrow : ∀ j, B 0 j = if j = 0 then B 0 0 else 0)
    (hcol : ∀ i, B i (Fin.last (k + 1)) = if i = Fin.last (k + 1) then B 0 0 else 0) :
    B * (1 + single (Fin.last (k + 1)) 0 (1 : K)) =
      (1 + single (Fin.last (k + 1)) 0 (1 : K)) * B := by
  rw [Matrix.mul_add, Matrix.mul_one, Matrix.add_mul, Matrix.one_mul]
  congr 1
  ext i j
  by_cases hj : j = 0
  · subst hj
    rw [Matrix.mul_single_apply_same, mul_one]
    by_cases hi : i = Fin.last (k + 1)
    · subst hi
      rw [Matrix.single_mul_apply_same, one_mul, hcol (Fin.last (k + 1)), if_pos rfl,
        hrow 0, if_pos rfl]
    · rw [Matrix.single_mul_apply_of_ne (1 : K) (Fin.last (k + 1)) 0 i 0 hi, hcol i,
        if_neg hi]
  · rw [Matrix.mul_single_apply_of_ne (1 : K) (Fin.last (k + 1)) 0 i j hj]
    by_cases hi : i = Fin.last (k + 1)
    · subst hi
      rw [Matrix.single_mul_apply_same, one_mul, hrow j, if_neg hj]
    · rw [Matrix.single_mul_apply_of_ne (1 : K) (Fin.last (k + 1)) 0 i j hi]

private theorem commute_single_zero_last_of_col_row {B : Matrix (Fin (k + 2)) (Fin (k + 2)) K}
    (hcol : ∀ i, B i 0 = if i = 0 then B (Fin.last (k + 1)) (Fin.last (k + 1)) else 0)
    (hrow : ∀ j, B (Fin.last (k + 1)) j =
      if j = Fin.last (k + 1) then B (Fin.last (k + 1)) (Fin.last (k + 1)) else 0) :
    B * (1 + single 0 (Fin.last (k + 1)) (1 : K)) =
      (1 + single 0 (Fin.last (k + 1)) (1 : K)) * B := by
  rw [Matrix.mul_add, Matrix.mul_one, Matrix.add_mul, Matrix.one_mul]
  congr 1
  ext i j
  by_cases hj : j = Fin.last (k + 1)
  · subst hj
    rw [Matrix.mul_single_apply_same, mul_one]
    by_cases hi : i = 0
    · subst hi
      rw [Matrix.single_mul_apply_same, one_mul, hcol 0, if_pos rfl,
        hrow (Fin.last (k + 1)), if_pos rfl]
    · rw [Matrix.single_mul_apply_of_ne (1 : K) 0 (Fin.last (k + 1)) i
        (Fin.last (k + 1)) hi, hcol i, if_neg hi]
  · rw [Matrix.mul_single_apply_of_ne (1 : K) 0 (Fin.last (k + 1)) i j hj]
    by_cases hi : i = 0
    · subst hi
      rw [Matrix.single_mul_apply_same, one_mul, hrow j, if_neg hj]
    · rw [Matrix.single_mul_apply_of_ne (1 : K) 0 (Fin.last (k + 1)) i j hi]

end CommuteEntries

section Decomposition

variable (h : UnitaryFieldData 2 f K)

theorem centralizer_rootU_eq_suR_sup_suL (k : ℕ) (hk : 2 ≤ k) :
    Subgroup.centralizer {AutPSU.rootU (K := K) (f := f) (k + 1)} =
      suR h (k + 1) ⊔ suL h (k + 1) := by
  have hm1 : 1 ≤ k + 1 := by omega
  refine le_antisymm ?_ ?_
  · intro x hx
    have hxinv : x⁻¹ ∈ Subgroup.centralizer {AutPSU.rootU (K := K) (f := f) (k + 1)} :=
      (Subgroup.centralizer {AutPSU.rootU (K := K) (f := f) (k + 1)}).inv_mem hx
    have hxcomm : mat (unitaryInvolution K 2 f) (k + 2) x * ggInvMatrix (k + 2) 1 K =
        ggInvMatrix (k + 2) 1 K * mat (unitaryInvolution K 2 f) (k + 2) x := by
      have h1 := Subgroup.mem_centralizer_singleton_iff.mp hx
      have em := congrArg (fun y : SU (unitaryInvolution K 2 f) (k + 2) =>
        (((y : GL (Fin (k + 2)) K) : Matrix (Fin (k + 2)) (Fin (k + 2)) K))) h1
      change mat (unitaryInvolution K 2 f) (k + 2) x *
          mat (unitaryInvolution K 2 f) (k + 2) (AutPSU.rootU (K := K) (f := f) (k + 1)) =
        mat (unitaryInvolution K 2 f) (k + 2) (AutPSU.rootU (K := K) (f := f) (k + 1)) *
          mat (unitaryInvolution K 2 f) (k + 2) x at em
      rw [mat_rootU_eq (by omega)] at em
      rwa [← CFSG.StandardType.ggInvMatrix_one (k + 1) (by omega)] at em
    let M : Matrix (Fin k) (Fin k) K := (mat (unitaryInvolution K 2 f) (k + 2) x).submatrix
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
      (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
    let M' : Matrix (Fin k) (Fin k) K :=
      (mat (unitaryInvolution K 2 f) (k + 2) x⁻¹).submatrix
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
    have hMM' : M * M' = 1 := by
      have h := RCSTSU.submatrix_mul_of_mem hx hxinv
      rw [mul_inv_cancel, map_one,
        Matrix.submatrix_one _
          CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_injective] at h
      simpa [M, M'] using h.symm
    have hM'M : M' * M = 1 := by
      have h := RCSTSU.submatrix_mul_of_mem hxinv hx
      rw [inv_mul_cancel, map_one,
        Matrix.submatrix_one _
          CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_injective] at h
      simpa [M, M'] using h.symm
    let MGL : GL (Fin k) K := ⟨M, M', hMM', hM'M⟩
    have hMGLmat : ((MGL : GL (Fin k) K) : Matrix (Fin k) (Fin k) K) = M := rfl
    let lam : K := mat (unitaryInvolution K 2 f) (k + 2) x
      (Fin.last (k + 1)) (Fin.last (k + 1))
    have hlam0 : lam ≠ 0 := RCSTSU.corner_ne_zero hx
    have hcorner_x : mat (unitaryInvolution K 2 f) (k + 2) x
        (Fin.last (k + 1)) (Fin.last (k + 1)) = lam := rfl
    have hcorner_eq_x : mat (unitaryInvolution K 2 f) (k + 2) x
        (Fin.last (k + 1)) (Fin.last (k + 1)) =
        mat (unitaryInvolution K 2 f) (k + 2) x 0 0 :=
      LinFusion.corner_eq_of_commute (by omega) hxcomm
    have hrowx : ∀ j, mat (unitaryInvolution K 2 f) (k + 2) x 0 j =
        if j = 0 then lam else 0 := by
      intro j
      rw [LinFusion.row_zero_of_commute (by omega) hxcomm j]
    have hcolx : ∀ i, mat (unitaryInvolution K 2 f) (k + 2) x i
        (Fin.last (k + 1)) = if i = Fin.last (k + 1) then lam else 0 := by
      intro i
      rw [LinFusion.col_last_of_commute (by omega) hxcomm i]
      by_cases hi : i = Fin.last (k + 1)
      · subst hi; rw [← hcorner_eq_x]
      · simp [hi]
    have hdetx : (mat (unitaryInvolution K 2 f) (k + 2) x).det = lam ^ 2 * M.det := by
      have h := det_eq_corner_sq_mul_mid (k := k)
        (B := mat (unitaryInvolution K 2 f) (k + 2) x) hrowx hcolx hcorner_eq_x
        (by simpa [lam] using hlam0)
      simpa [M, lam] using h
    have hlamM : lam ^ 2 * M.det = 1 := by
      rw [← hdetx]
      exact x.2.1
    let t : Fin (k + 2) → K := fun i =>
      if i = 0 ∨ i = Fin.last (k + 1) then lam else 1
    have ht : ∀ i, t i ≠ 0 := by
      intro i
      by_cases hi : i = 0 ∨ i = Fin.last (k + 1)
      · simp [t, hi, hlam0]
      · simp [t, hi]
    have ht0 : t 0 = lam := by simp [t]
    have htlast : t (Fin.last (k + 1)) = lam := by simp [t]
    have htmid : ∀ a : Fin k, t (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid a) = 1 := by
      intro a
      simp [t, CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_ne_zero a,
        CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_ne_last a]
    have hrev0 : Fin.rev (0 : Fin (k + 2)) = Fin.last (k + 1) := by ext; simp [Fin.rev]
    have hrevlast : Fin.rev (Fin.last (k + 1)) = (0 : Fin (k + 2)) := by ext; simp [Fin.rev]
    let D : GL (Fin (k + 2)) K := RootDetectSU.diagGL t ht
    have hDunitary : D ∈ primeFormUnitary h (antidiag (k + 2)) := by
      refine RootDetectSU.diagGL_mem_primeFormUnitary h (fun a => ?_)
      by_cases ha0 : a = 0
      · subst a
        rw [ht0, hrev0, htlast]
        simpa [lam] using RCSTSU.corner_norm hx
      by_cases hal : a = Fin.last (k + 1)
      · subst a
        rw [htlast, hrevlast, ht0]
        simpa [lam] using RCSTSU.corner_norm hx
      · have ha_mid : a ∈ Set.range
            (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) := by
          rw [CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mem_range_mid]
          have h0 : (a : ℕ) ≠ 0 := fun h => ha0 (Fin.ext h)
          have hl : (a : ℕ) ≠ k + 1 := fun h => hal (Fin.ext (by simpa using h))
          have := a.isLt
          omega
        obtain ⟨i, rfl⟩ := ha_mid
        rw [htmid i, CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.rev_mid,
          htmid (Fin.rev i), mul_one]
        simp
    have hrow_zero : ∀ b : Fin k, mat (unitaryInvolution K 2 f) (k + 2) x 0
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid b) = 0 := by
      intro b
      rw [hrowx]
      rw [if_neg (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_ne_zero b)]
    have hMunit : CFSG.LieType.Universal.Unitary.conjTr (unitaryInvolution K 2 f) M *
        antidiag k * M = antidiag k := by
      simpa [M] using isometry_submatrix_mid_of_row_zero k x hrow_zero
    let iotaGL : GL (Fin (k + 2)) K :=
      ⟨CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat M,
        CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat M',
        by rw [← CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat_mul, hMM',
          CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat_one],
        by rw [← CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat_mul, hM'M,
          CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat_one]⟩
    have hiotaUnitary : iotaGL ∈ primeFormUnitary h (antidiag (k + 2)) := by
      rw [mem_primeFormUnitary]
      change CFSG.LieType.Universal.Unitary.conjTr (unitaryInvolution K 2 f)
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat M) *
        antidiag (k + 2) * CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat M =
          antidiag (k + 2)
      exact CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat_isometry
        (σ := unitaryInvolution K 2 f) hMunit
    let d : GL (Fin (k + 2)) K := D * iotaGL
    have hdU : d ∈ primeFormUnitary h (antidiag (k + 2)) :=
      (primeFormUnitary h (antidiag (k + 2))).mul_mem hDunitary hiotaUnitary
    have hdmat : ((d : GL (Fin (k + 2)) K) : Matrix (Fin (k + 2)) (Fin (k + 2)) K) =
        diagonal t * CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat M := by
      change ((D * iotaGL : GL (Fin (k + 2)) K) : Matrix (Fin (k + 2)) (Fin (k + 2)) K) = _
      rw [Units.val_mul, RootDetectSU.coe_diagGL]
    have hdiag_apply : ∀ i j, ((d : GL (Fin (k + 2)) K) :
        Matrix (Fin (k + 2)) (Fin (k + 2)) K) i j =
          t i * CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat M i j := by
      intro i j
      rw [hdmat, Matrix.mul_apply, Finset.sum_eq_single i]
      · rw [Matrix.diagonal_apply_eq]
      · intro l _ hl
        rw [Matrix.diagonal_apply_ne _ (Ne.symm hl), zero_mul]
      · simp
    have hdrow0 : ∀ j, ((d : GL (Fin (k + 2)) K) :
        Matrix (Fin (k + 2)) (Fin (k + 2)) K) 0 j = if j = 0 then lam else 0 := by
      intro j
      rw [hdiag_apply 0 j, ht0]
      rw [CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat_isBlkOn M 0 j
        (Or.inl RootCentSU.zero_not_mem_range_mid)]
      by_cases hj : j = 0
      · subst hj; rw [if_pos rfl]; simp
      · rw [if_neg hj]; simp [Matrix.one_apply_ne (Ne.symm hj)]
    have hdcollast : ∀ i, ((d : GL (Fin (k + 2)) K) :
        Matrix (Fin (k + 2)) (Fin (k + 2)) K) i (Fin.last (k + 1)) =
        if i = Fin.last (k + 1) then lam else 0 := by
      intro i
      rw [hdiag_apply i (Fin.last (k + 1))]
      rw [CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat_isBlkOn M i
        (Fin.last (k + 1)) (Or.inr RootCentSU.last_not_mem_range_mid)]
      by_cases hi : i = Fin.last (k + 1)
      · subst hi; rw [htlast]; simp
      · rw [if_neg hi]; simp [Matrix.one_apply_ne hi]
    have hdcol0 : ∀ i, ((d : GL (Fin (k + 2)) K) :
        Matrix (Fin (k + 2)) (Fin (k + 2)) K) i 0 = if i = 0 then lam else 0 := by
      intro i
      rw [hdiag_apply i 0]
      rw [CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat_isBlkOn M i 0
        (Or.inr RootCentSU.zero_not_mem_range_mid)]
      by_cases hi : i = 0
      · subst hi; rw [ht0]; simp
      · rw [if_neg hi]; simp [Matrix.one_apply_ne hi]
    have hdrowlast : ∀ j, ((d : GL (Fin (k + 2)) K) :
        Matrix (Fin (k + 2)) (Fin (k + 2)) K) (Fin.last (k + 1)) j =
        if j = Fin.last (k + 1) then lam else 0 := by
      intro j
      rw [hdiag_apply (Fin.last (k + 1)) j]
      rw [CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat_isBlkOn M
        (Fin.last (k + 1)) j (Or.inl RootCentSU.last_not_mem_range_mid)]
      rw [htlast]
      by_cases hj : j = Fin.last (k + 1)
      · subst hj; simp
      · rw [if_neg hj]; simp [Matrix.one_apply_ne (Ne.symm hj)]
    have hdmid : ((d : GL (Fin (k + 2)) K) :
        Matrix (Fin (k + 2)) (Fin (k + 2)) K).submatrix
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) = M := by
      ext a b
      rw [Matrix.submatrix_apply, hdiag_apply, htmid,
        CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.iotaMat_mid]
      simp
    have hdcorner : ((d : GL (Fin (k + 2)) K) :
        Matrix (Fin (k + 2)) (Fin (k + 2)) K) (Fin.last (k + 1)) (Fin.last (k + 1)) =
        ((d : GL (Fin (k + 2)) K) :
          Matrix (Fin (k + 2)) (Fin (k + 2)) K) 0 0 := by
      rw [hdrow0 0, hdcollast (Fin.last (k + 1))]
      simp
    have hdlam0 : ((d : GL (Fin (k + 2)) K) :
        Matrix (Fin (k + 2)) (Fin (k + 2)) K) (Fin.last (k + 1)) (Fin.last (k + 1)) ≠ 0 := by
      rw [hdcollast (Fin.last (k + 1))]
      simpa using hlam0
    have hddet : ((d : GL (Fin (k + 2)) K) :
        Matrix (Fin (k + 2)) (Fin (k + 2)) K).det = 1 := by
      have hrow0'' : ∀ j, ((d : GL (Fin (k + 2)) K) :
          Matrix (Fin (k + 2)) (Fin (k + 2)) K) 0 j =
          if j = 0 then ((d : GL (Fin (k + 2)) K) :
            Matrix (Fin (k + 2)) (Fin (k + 2)) K) (Fin.last (k + 1)) (Fin.last (k + 1)) else 0 := by
        intro j
        rw [hdrow0 j]
        split_ifs with h
        · simp [hdcollast (Fin.last (k + 1))]
        · rfl
      have hcol0'' : ∀ i, ((d : GL (Fin (k + 2)) K) :
          Matrix (Fin (k + 2)) (Fin (k + 2)) K) i (Fin.last (k + 1)) =
          if i = Fin.last (k + 1) then ((d : GL (Fin (k + 2)) K) :
            Matrix (Fin (k + 2)) (Fin (k + 2)) K) (Fin.last (k + 1)) (Fin.last (k + 1)) else 0 := by
        intro i
        rw [hdcollast i]
        split_ifs with h
        · simp [hdcollast (Fin.last (k + 1))]
        · rfl
      have h := det_eq_corner_sq_mul_mid (k := k)
        (B := ((d : GL (Fin (k + 2)) K) : Matrix (Fin (k + 2)) (Fin (k + 2)) K))
        hrow0'' hcol0'' hdcorner hdlam0
      have hdetsq : ((d : GL (Fin (k + 2)) K) :
          Matrix (Fin (k + 2)) (Fin (k + 2)) K).det = lam ^ 2 * M.det := by
        simpa [hdcollast (Fin.last (k + 1)), hdmid] using h
      rw [hdetsq, hlamM]
    have hdXJ : d ∈ AutPSU.XJ h (k + 2) :=
      (mem_gramSU_iff_unitary h).mpr ⟨hdU, hddet⟩
    let dSU : SU (unitaryInvolution K 2 f) (k + 2) :=
      (AutPSU.suEquiv h).symm ⟨d, hdXJ⟩
    have hmat_dSU : mat (unitaryInvolution K 2 f) (k + 2) dSU =
        ((d : GL (Fin (k + 2)) K) : Matrix (Fin (k + 2)) (Fin (k + 2)) K) := by
      rw [CFSG.LieType.Universal.Unitary.SUExtras.mat_apply]
      change (((AutPSU.suEquiv h dSU : AutPSU.XJ h (k + 2)) : GL (Fin (k + 2)) K) :
        Matrix (Fin (k + 2)) (Fin (k + 2)) K) = _
      rw [show AutPSU.suEquiv h dSU = ⟨d, hdXJ⟩ from MulEquiv.apply_symm_apply _ _]
    have hdC : dSU ∈ Subgroup.centralizer {AutPSU.rootU (K := K) (f := f) (k + 1)} := by
      rw [Subgroup.mem_centralizer_singleton_iff]
      apply CFSG.LieType.Universal.Unitary.SUExtras.mat_injective
      rw [map_mul, map_mul, hmat_dSU, mat_rootU_eq (by omega)]
      have hrow0' : ∀ j, ((d : GL (Fin (k + 2)) K) :
          Matrix (Fin (k + 2)) (Fin (k + 2)) K) 0 j =
          if j = 0 then ((d : GL (Fin (k + 2)) K) :
            Matrix (Fin (k + 2)) (Fin (k + 2)) K) 0 0 else 0 := by
        intro j
        rw [hdrow0 j]
        split_ifs with h
        · simp [hdrow0 0]
        · rfl
      have hcollast' : ∀ i, ((d : GL (Fin (k + 2)) K) :
          Matrix (Fin (k + 2)) (Fin (k + 2)) K) i (Fin.last (k + 1)) =
          if i = Fin.last (k + 1) then ((d : GL (Fin (k + 2)) K) :
            Matrix (Fin (k + 2)) (Fin (k + 2)) K) 0 0 else 0 := by
        intro i
        rw [hdcollast i]
        split_ifs with h
        · simp [hdrow0 0]
        · rfl
      exact commute_single_last_zero_of_row_col hrow0' hcollast'
    have hdC2 : dSU ∈ Subgroup.centralizer
        ({(AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1))} :
          Set (SU (unitaryInvolution K 2 f) (k + 2))) := by
      rw [Subgroup.mem_centralizer_singleton_iff]
      apply CFSG.LieType.Universal.Unitary.SUExtras.mat_injective
      rw [map_mul, map_mul, hmat_dSU,
        CFSG.LieType.Universal.Unitary.SUExtras.mat_apply, AutPSU.coe_lroot]
      have hcol0' : ∀ i, ((d : GL (Fin (k + 2)) K) :
          Matrix (Fin (k + 2)) (Fin (k + 2)) K) i 0 =
          if i = 0 then ((d : GL (Fin (k + 2)) K) :
            Matrix (Fin (k + 2)) (Fin (k + 2)) K) (Fin.last (k + 1)) (Fin.last (k + 1)) else 0 := by
        intro i
        rw [hdcol0 i]
        split_ifs with h
        · simp [hdrow0 0, hdcollast (Fin.last (k + 1))]
        · rfl
      have hrowlast' : ∀ j, ((d : GL (Fin (k + 2)) K) :
          Matrix (Fin (k + 2)) (Fin (k + 2)) K) (Fin.last (k + 1)) j =
          if j = Fin.last (k + 1) then ((d : GL (Fin (k + 2)) K) :
            Matrix (Fin (k + 2)) (Fin (k + 2)) K) (Fin.last (k + 1)) (Fin.last (k + 1)) else 0 := by
        intro j
        rw [hdrowlast j]
        split_ifs with h
        · simp [hdcollast (Fin.last (k + 1))]
        · rfl
      exact commute_single_zero_last_of_col_row hcol0' hrowlast'
    have hdL : dSU ∈ suL h (k + 1) := by
      rw [suL_of_le h hm1]
      exact ⟨hdC, hdC2⟩
    have hdCinv : dSU⁻¹ ∈ Subgroup.centralizer {AutPSU.rootU (K := K) (f := f) (k + 1)} :=
      (Subgroup.centralizer {AutPSU.rootU (K := K) (f := f) (k + 1)}).inv_mem hdC
    have hrC : x * dSU⁻¹ ∈ Subgroup.centralizer {AutPSU.rootU (K := K) (f := f) (k + 1)} :=
      (Subgroup.centralizer {AutPSU.rootU (K := K) (f := f) (k + 1)}).mul_mem hx hdCinv
    have hcorner_inv : mat (unitaryInvolution K 2 f) (k + 2) dSU⁻¹
        (Fin.last (k + 1)) (Fin.last (k + 1)) = lam⁻¹ := by
      have h := RCSTSU.corner_mul_of_mem (x := dSU) (y := dSU⁻¹) hdCinv
      rw [mul_inv_cancel, map_one] at h
      rw [hmat_dSU] at h
      rw [hdcollast (Fin.last (k + 1))] at h
      have h' : lam * mat (unitaryInvolution K 2 f) (k + 2) dSU⁻¹
          (Fin.last (k + 1)) (Fin.last (k + 1)) = 1 := by simpa using h.symm
      exact eq_inv_of_mul_eq_one_right h' 
    have hmid_dSU_inv : (mat (unitaryInvolution K 2 f) (k + 2) dSU⁻¹).submatrix
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) = M' := by
      have h := RCSTSU.submatrix_mul_of_mem hdC hdCinv
      rw [mul_inv_cancel, map_one] at h
      rw [hmat_dSU, hdmid] at h
      have h' : M * (mat (unitaryInvolution K 2 f) (k + 2) dSU⁻¹).submatrix
          (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
          (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) = 1 := by
        simpa [Matrix.submatrix_one _
          CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid_injective] using h.symm
      calc (mat (unitaryInvolution K 2 f) (k + 2) dSU⁻¹).submatrix
            (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
            (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
          = 1 * (mat (unitaryInvolution K 2 f) (k + 2) dSU⁻¹).submatrix
              (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
              (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) := by rw [one_mul]
        _ = (M' * M) * (mat (unitaryInvolution K 2 f) (k + 2) dSU⁻¹).submatrix
              (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
              (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) := by rw [hM'M]
        _ = M' * (M * (mat (unitaryInvolution K 2 f) (k + 2) dSU⁻¹).submatrix
              (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
              (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))) := by
            rw [mul_assoc]
        _ = M' := by rw [h', mul_one]
    have hrcorner : mat (unitaryInvolution K 2 f) (k + 2) (x * dSU⁻¹)
        (Fin.last (k + 1)) (Fin.last (k + 1)) = 1 := by
      have h := RCSTSU.corner_mul_of_mem (x := x) (y := dSU⁻¹) hdCinv
      rw [hcorner_x, hcorner_inv] at h
      rw [h]
      exact mul_inv_cancel₀ hlam0
    have hrmid : (mat (unitaryInvolution K 2 f) (k + 2) (x * dSU⁻¹)).submatrix
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k))
        (CFSG.LieType.Steinberg.CentralExt.SUOddFieldThree.mid (m := k)) = 1 := by
      have h := RCSTSU.submatrix_mul_of_mem hx hdCinv
      rw [hmid_dSU_inv] at h
      rw [h, hMM']
    have hrR : x * dSU⁻¹ ∈ suR h (k + 1) :=
      mem_suR_of_corner_aux h k hm1 hrC hrcorner hrmid
    have hx_eq : x = (x * dSU⁻¹) * dSU := by group
    rw [hx_eq]
    exact (suR h (k + 1) ⊔ suL h (k + 1)).mul_mem (Subgroup.mem_sup_left hrR)
      (Subgroup.mem_sup_right hdL)
  · refine sup_le (suR_le_centralizer h hm1) ?_
    rw [suL_of_le h hm1]
    exact inf_le_left

end Decomposition

section MapCentralizer

theorem map_centralizer_of_involution {X G : Type*} [Group X] [Finite X] [Group G]
    (π : X →* G) (hπ : Function.Surjective π)
    (hZc : π.ker ≤ Subgroup.center X) (hZ : Odd (Nat.card π.ker))
    {x : X} (hx2 : x * x = 1) :
    (Subgroup.centralizer {x}).map π = Subgroup.centralizer {π x} := by
  haveI := MonoidHom.normal_ker π
  refine le_antisymm ?_ ?_
  · rintro _ ⟨u, hu, rfl⟩
    have hu' : u * x = x * u := by
      simpa [Subgroup.mem_centralizer_singleton_iff] using hu
    rw [Subgroup.mem_centralizer_singleton_iff]
    rw [← map_mul, ← map_mul, hu']
  · intro g hg
    obtain ⟨u, rfl⟩ := hπ g
    rw [Subgroup.mem_centralizer_singleton_iff] at hg
    set z : X := u * x * u⁻¹ * x⁻¹ with hzdef
    have hz : z ∈ π.ker := by
      rw [MonoidHom.mem_ker, hzdef]
      simp only [map_mul, map_inv]
      rw [hg]
      group
    have hzc : z ∈ Subgroup.center X := hZc hz
    have hux_eq : u * x * u⁻¹ = z * x := by rw [hzdef]; group
    have hz2 : z ^ 2 = 1 := by
      have h1 : (u * x * u⁻¹) * (u * x * u⁻¹) = 1 := by
        rw [show u * x * u⁻¹ * (u * x * u⁻¹) = u * (x * x) * u⁻¹ by group, hx2,
          mul_one, mul_inv_cancel]
      rw [hux_eq] at h1
      have hcomm : x * z = z * x := Subgroup.mem_center_iff.mp hzc x
      calc z ^ 2 = z * z * (x * x) := by rw [hx2, mul_one, pow_two]
        _ = (z * x) * (z * x) := by
          calc z * z * (x * x) = z * (z * x) * x := by group
            _ = z * (x * z) * x := by rw [hcomm]
            _ = (z * x) * (z * x) := by group
        _ = 1 := h1
    have hz1 : z = 1 := AutPSU.eq_one_of_mem_of_pow hZ hz (a := 1) (by simpa using hz2)
    have hux : u * x * u⁻¹ = x := by rw [hux_eq, hz1, one_mul]
    have hu : u ∈ Subgroup.centralizer {x} := by
      rw [Subgroup.mem_centralizer_singleton_iff]
      calc u * x = (u * x * u⁻¹) * u := by group
        _ = x * u := by rw [hux]
    exact ⟨u, hu, rfl⟩

theorem map_inf_centralizers_of_involution {X G : Type*} [Group X] [Finite X] [Group G]
    (π : X →* G) (hπ : Function.Surjective π)
    (hZc : π.ker ≤ Subgroup.center X) (hZ : Odd (Nat.card π.ker))
    {x y : X} (hx2 : x * x = 1) (hy2 : y * y = 1) :
    ((Subgroup.centralizer {x} ⊓ Subgroup.centralizer {y}).map π) =
      Subgroup.centralizer {π x} ⊓ Subgroup.centralizer {π y} := by
  refine le_antisymm ?_ ?_
  · rintro _ ⟨u, hu, rfl⟩
    refine ⟨?_, ?_⟩
    · rw [← map_centralizer_of_involution π hπ hZc hZ hx2]
      exact Subgroup.mem_map_of_mem π hu.1
    · rw [← map_centralizer_of_involution π hπ hZc hZ hy2]
      exact Subgroup.mem_map_of_mem π hu.2
  · intro g hg
    obtain ⟨u, hu, rfl⟩ :=
      (map_centralizer_of_involution π hπ hZc hZ hx2).symm.le hg.1
    obtain ⟨v, hv, hveq⟩ :=
      (map_centralizer_of_involution π hπ hZc hZ hy2).symm.le hg.2
    have hz : v⁻¹ * u ∈ π.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hveq, inv_mul_cancel]
    have hzc := hZc hz
    have hu_eq : u = v * (v⁻¹ * u) := by group
    have hv' : v * y = y * v := by
      simpa [Subgroup.mem_centralizer_singleton_iff] using hv
    have huY : u ∈ Subgroup.centralizer {y} := by
      rw [Subgroup.mem_centralizer_singleton_iff]
      have hcomm : (v⁻¹ * u) * y = y * (v⁻¹ * u) := (Subgroup.mem_center_iff.mp hzc y).symm
      calc u * y = v * (v⁻¹ * u) * y := by nth_rewrite 1 [hu_eq]; rfl
        _ = v * ((v⁻¹ * u) * y) := by group
        _ = v * (y * (v⁻¹ * u)) := by rw [hcomm]
        _ = (v * y) * (v⁻¹ * u) := by group
        _ = y * v * (v⁻¹ * u) := by rw [hv']
        _ = y * u := by rw [hu_eq]; group
    exact ⟨u, ⟨hu, huY⟩, rfl⟩

variable (h : UnitaryFieldData 2 f K) (m : ℕ)

theorem projU_ker_le_center :
    (AutPSU.projU h).ker ≤ Subgroup.center (SU (unitaryInvolution K 2 f) (m + 1)) := by
  intro z hz
  rw [MonoidHom.mem_ker] at hz
  rw [Subgroup.mem_center_iff]
  intro y
  apply (AutPSU.suEquiv h).injective
  rw [map_mul, map_mul]
  have hzZ : AutPSU.suEquiv h z ∈ normOneScalars h (AutPSU.XJ h (m + 1)) (m + 1) := by
    rw [← QuotientGroup.eq_one_iff]
    simpa [AutPSU.projU_apply] using hz
  exact Subgroup.mem_center_iff.mp
    (normOneScalars_le_center h (AutPSU.XJ h (m + 1)) (m + 1) hzZ) _

theorem projU_ker_odd : Odd (Nat.card (AutPSU.projU h (n := m + 1)).ker) := by
  let Z := normOneScalars h (AutPSU.XJ h (m + 1)) (m + 1)
  have hker : (AutPSU.projU h (n := m + 1)).ker = Z.comap (AutPSU.suEquiv h).toMonoidHom := by
    ext z
    simp only [AutPSU.projU, MonoidHom.mem_ker, MonoidHom.comp_apply,
      QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, Subgroup.mem_comap]
    rfl
  have hmap : (Z.comap (AutPSU.suEquiv h).toMonoidHom).map
      (AutPSU.suEquiv h).toMonoidHom = Z := by
    ext x
    constructor
    · rintro ⟨z, hz, rfl⟩; exact hz
    · intro hx
      exact ⟨(AutPSU.suEquiv h).symm x, by simpa using hx, by simp⟩
  rw [hker]
  have hcard : Nat.card (Z.comap (AutPSU.suEquiv h).toMonoidHom) = Nat.card Z := by
    have h := Nat.card_congr (Subgroup.equivMapOfInjective
      (Z.comap (AutPSU.suEquiv h).toMonoidHom)
      (AutPSU.suEquiv h).toMonoidHom (AutPSU.suEquiv h).injective).toEquiv
    rwa [hmap] at h
  rw [hcard]
  exact AutPSU.odd_card_normOneScalars h _

end MapCentralizer

section Targets

variable {f m : ℕ} {K : Type} [Field K] [Finite K] [CharP K 2]

private theorem single_add_mul_self {n : ℕ} {a b : Fin n} (h : a ≠ b) :
    ((1 : Matrix (Fin n) (Fin n) K) + Matrix.single a b (1 : K)) *
      ((1 : Matrix (Fin n) (Fin n) K) + Matrix.single a b (1 : K)) = 1 := by
  rw [Matrix.add_mul, Matrix.mul_add, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one,
    Matrix.one_mul]
  have hEE : Matrix.single a b (1 : K) * Matrix.single a b (1 : K) = 0 :=
    Matrix.single_mul_single_of_ne (1 : K) a b a (Ne.symm h) (1 : K)
  rw [hEE, add_zero]
  have h2 : Matrix.single a b (1 : K) + Matrix.single a b (1 : K) = 0 := by
    ext i j
    simp [Matrix.add_apply, CharTwo.add_self_eq_zero]
  rw [add_assoc, h2, add_zero]

private theorem lroot_mul_self {n : ℕ} {σ : K ≃+* K} {i : Fin n} (hi : i ≠ Fin.rev i) :
    AutPSU.lroot σ hi * AutPSU.lroot σ hi = 1 := by
  apply CFSG.LieType.Universal.Unitary.SUExtras.mat_injective
  have hmat : (mat σ n) (AutPSU.lroot σ hi) = 1 + Matrix.single i (Fin.rev i) (1 : K) := by
    rw [CFSG.LieType.Universal.Unitary.SUExtras.mat_apply, AutPSU.coe_lroot]
  rw [map_mul, map_one, hmat]
  exact single_add_mul_self hi

theorem centralizer_rootU_eq_sup (h : UnitaryFieldData 2 f K) (hm : 3 ≤ m) :
    Subgroup.centralizer {AutPSU.projU h (AutPSU.rootU (K := K) (f := f) m)} =
      radical h m ⊔ leviFull h m := by
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
  have hm1 : 1 ≤ k + 1 := by omega
  have hk : 2 ≤ k := by omega
  have hsurj : Function.Surjective (AutPSU.projU h (n := k + 2)) :=
    (QuotientGroup.mk'_surjective _).comp (AutPSU.suEquiv h).surjective
  have hZc := projU_ker_le_center h (k + 1)
  have hZ := projU_ker_odd h (k + 1)
  have hroot2 : AutPSU.rootU (K := K) (f := f) (k + 1) *
      AutPSU.rootU (K := K) (f := f) (k + 1) = 1 := by
    apply CFSG.LieType.Universal.Unitary.SUExtras.mat_injective
    have hmat : (mat (unitaryInvolution K 2 f) (k + 2) (AutPSU.rootU (K := K) (f := f) (k + 1))) =
        1 + Matrix.single (Fin.last (k + 1)) 0 (1 : K) := by
      rw [CFSG.LieType.Universal.Unitary.SUExtras.mat_apply, AutPSU.coe_rootU (by omega)]
    have hlast0 : (Fin.last (k + 1) : Fin (k + 2)) ≠ 0 := by
      intro h; have := congrArg Fin.val h; simp at this
    rw [map_mul, map_one, hmat]
    exact single_add_mul_self hlast0
  have hlroot2 : AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1) *
      AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1) = 1 :=
    lroot_mul_self _
  have hsuLmap : (suL h (k + 1)).map (AutPSU.projU h) = leviFull h (k + 1) := by
    rw [leviFull, y0_of_le h hm1, suL_of_le h hm1]
    exact map_inf_centralizers_of_involution (AutPSU.projU h) hsurj hZc hZ hroot2 hlroot2
  have hsuRmap : (suR h (k + 1)).map (AutPSU.projU h) = radical h (k + 1) := by
    rw [radical_of_le]
  calc Subgroup.centralizer {AutPSU.projU h (AutPSU.rootU (K := K) (f := f) (k + 1))}
      = (Subgroup.centralizer {AutPSU.rootU (K := K) (f := f) (k + 1)}).map (AutPSU.projU h) :=
        (map_centralizer_of_involution (AutPSU.projU h) hsurj hZc hZ hroot2).symm
    _ = ((suR h (k + 1) ⊔ suL h (k + 1))).map (AutPSU.projU h) := by
        rw [centralizer_rootU_eq_suR_sup_suL h k hk]
    _ = (suR h (k + 1)).map (AutPSU.projU h) ⊔ (suL h (k + 1)).map (AutPSU.projU h) := by
        rw [Subgroup.map_sup]
    _ = radical h (k + 1) ⊔ leviFull h (k + 1) := by rw [hsuRmap, hsuLmap]

end Targets

section PushDown

variable (h : UnitaryFieldData 2 f K)

theorem rootU_mul_self (k : ℕ) :
    AutPSU.rootU (K := K) (f := f) (k + 1) * AutPSU.rootU (K := K) (f := f) (k + 1) = 1 := by
  apply CFSG.LieType.Universal.Unitary.SUExtras.mat_injective
  have hmat : (mat (unitaryInvolution K 2 f) (k + 2)
      (AutPSU.rootU (K := K) (f := f) (k + 1))) =
      1 + Matrix.single (Fin.last (k + 1)) 0 (1 : K) := by
    rw [CFSG.LieType.Universal.Unitary.SUExtras.mat_apply, AutPSU.coe_rootU (by omega)]
  have hlast0 : (Fin.last (k + 1) : Fin (k + 2)) ≠ 0 := by
    intro h; have := congrArg Fin.val h; simp at this
  rw [map_mul, map_one, hmat]
  exact single_add_mul_self hlast0

theorem leviFull_eq_map_suL (k : ℕ) (hk : 2 ≤ k) :
    leviFull h (k + 1) = (suL h (k + 1)).map (AutPSU.projU h) := by
  have hm1 : 1 ≤ k + 1 := by omega
  have hsurj : Function.Surjective (AutPSU.projU h (n := k + 2)) :=
    (QuotientGroup.mk'_surjective _).comp (AutPSU.suEquiv h).surjective
  have hZc := projU_ker_le_center h (k + 1)
  have hZ := projU_ker_odd h (k + 1)
  have hroot2 := rootU_mul_self (K := K) (f := f) k
  have hlroot2 : AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1) *
      AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1) = 1 :=
    lroot_mul_self _
  rw [leviFull, y0_of_le h hm1, suL_of_le h hm1]
  exact (map_inf_centralizers_of_involution (AutPSU.projU h) hsurj hZc hZ hroot2 hlroot2).symm

private theorem suL_le_normalizer_suR_aux (k : ℕ) (hk : 2 ≤ k) :
    suL h (k + 1) ≤ Subgroup.normalizer (suR h (k + 1) : Set
      (SU (unitaryInvolution K 2 f) (k + 2))) := by
  have hm1 : 1 ≤ k + 1 := by omega
  rw [suL_of_le h hm1]
  intro x hx
  have hxC : x ∈ Subgroup.centralizer {AutPSU.rootU (k + 1)} := hx.1
  have hxP : slHom h (k + 1) hm1 x ∈ (LinFusion.ggTransPlacement hm1).parabolic K := by
    refine (LinFusion.ggTransPlacement hm1).centralizer_le_parabolic ?_
    rw [Subgroup.mem_centralizer_singleton_iff]
    have hx_comm := Subgroup.mem_centralizer_singleton_iff.mp hxC
    have hh := congrArg (slHom h (k + 1) hm1) hx_comm
    rw [map_mul, map_mul, slHom_rootU h (k + 1) hm1] at hh
    exact hh
  rw [Subgroup.mem_normalizer_iff]
  intro y
  constructor
  · intro hy
    rw [suR_of_le h hm1] at hy
    change slHom h (k + 1) hm1 y ∈ (LinFusion.ggTransPlacement hm1).radical K at hy
    have hyP : slHom h (k + 1) hm1 y ∈ (LinFusion.ggTransPlacement hm1).radical K := hy
    have hconj := (LinFusion.ggTransPlacement hm1).conj_mem_radical hxP hyP
    rw [suR_of_le h hm1, Subgroup.mem_comap]
    simpa [slHom, map_mul, map_inv] using hconj
  · intro hy
    have hxinv : x⁻¹ ∈ suL h (k + 1) := (suL h (k + 1)).inv_mem hx
    have hxinvP : slHom h (k + 1) hm1 x⁻¹ ∈
        (LinFusion.ggTransPlacement hm1).parabolic K := by
      refine (LinFusion.ggTransPlacement hm1).centralizer_le_parabolic ?_
      rw [Subgroup.mem_centralizer_singleton_iff]
      have hx_comm := Subgroup.mem_centralizer_singleton_iff.mp
        (show x⁻¹ ∈ Subgroup.centralizer {AutPSU.rootU (k + 1)} from
          (Subgroup.centralizer {AutPSU.rootU (k + 1)}).inv_mem hxC)
      have hh := congrArg (slHom h (k + 1) hm1) hx_comm
      rw [map_mul, map_mul, slHom_rootU h (k + 1) hm1] at hh
      exact hh
    have hyP : slHom h (k + 1) hm1 (x * y * x⁻¹) ∈
        (LinFusion.ggTransPlacement hm1).radical K := by
      rw [suR_of_le h hm1] at hy
      change slHom h (k + 1) hm1 (x * y * x⁻¹) ∈
        (LinFusion.ggTransPlacement hm1).radical K at hy
      simpa [slHom, map_mul, map_inv] using hy
    have hconj := (LinFusion.ggTransPlacement hm1).conj_mem_radical hxinvP hyP
    rw [suR_of_le h hm1, Subgroup.mem_comap]
    convert hconj using 1
    simp only [slHom, MonoidHom.comp_apply, map_mul, map_inv]
    group

end PushDown

section Disjoint

variable (h : UnitaryFieldData 2 f K)

private theorem disjoint_map_suR_suL_aux (k : ℕ) (hk : 2 ≤ k) :
    Disjoint ((suR h (k + 1)).map (AutPSU.projU h))
      ((suL h (k + 1)).map (AutPSU.projU h)) := by
  have hm1 : 1 ≤ k + 1 := by omega
  rw [disjoint_iff, eq_bot_iff]
  intro p hp
  obtain ⟨r, hr, rfl⟩ := Subgroup.mem_map.mp hp.1
  obtain ⟨l, hl, hlr⟩ := Subgroup.mem_map.mp hp.2
  have hz : r⁻¹ * l ∈ (AutPSU.projU h).ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hlr, inv_mul_cancel]
  have hzc := projU_ker_le_center h (k + 1) hz
  have hrl : r ∈ suL h (k + 1) := by
    rw [suL_of_le h hm1]
    refine ⟨suR_le_centralizer h hm1 hr, ?_⟩
    change r ∈ Subgroup.centralizer
      ({(AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1))} :
        Set (SU (unitaryInvolution K 2 f) (k + 2)))
    rw [Subgroup.mem_centralizer_singleton_iff]
    have hlC : l ∈ Subgroup.centralizer
        ({(AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1))} :
          Set (SU (unitaryInvolution K 2 f) (k + 2))) := by
      have := (Subgroup.mem_inf.mp (by rwa [suL_of_le h hm1] at hl)).2
      exact this
    rw [Subgroup.mem_centralizer_singleton_iff] at hlC
    set z : SU (unitaryInvolution K 2 f) (k + 2) := r⁻¹ * l with hzdef
    have hr_eq : r = l * z⁻¹ := by rw [hzdef]; group
    have hz_inv_comm : z⁻¹ * AutPSU.lroot (unitaryInvolution K 2 f)
        (zero_ne_rev_zero hm1) = AutPSU.lroot (unitaryInvolution K 2 f)
          (zero_ne_rev_zero hm1) * z⁻¹ :=
      (Subgroup.mem_center_iff.mp ((Subgroup.center _).inv_mem (hzc)) _).symm
    calc r * AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1)
        = l * z⁻¹ * AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1) := by
          rw [hr_eq]
      _ = l * (z⁻¹ * AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1)) := by
          group
      _ = l * (AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1) * z⁻¹) := by
          rw [hz_inv_comm]
      _ = (l * AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1)) * z⁻¹ := by
          group
      _ = (AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1) * l) * z⁻¹ := by
          rw [hlC]
      _ = AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1) * (l * z⁻¹) := by
          group
      _ = AutPSU.lroot (unitaryInvolution K 2 f) (zero_ne_rev_zero hm1) * r := by
          rw [hr_eq]
  have hrbot : r ∈ (⊥ : Subgroup (SU (unitaryInvolution K 2 f) (k + 2))) := by
    rw [← suR_inf_suL_aux h k hk]
    exact ⟨hr, hrl⟩
  rw [Subgroup.mem_bot] at hrbot
  rw [hrbot, map_one]
  rfl

end Disjoint

private theorem normal_twoSubgroup_leviFull_eq_bot (h : UnitaryFieldData 2 f K) {k : ℕ}
    (hk : 2 ≤ k) (H : Subgroup (leviFull h (k + 1))) (hHn : H.Normal)
    (hH2 : IsPGroup 2 H) : H = ⊥ := by
  let π := AutPSU.projU h (n := k + 2)
  let fL : suL h (k + 1) →* leviFull h (k + 1) :=
    MonoidHom.codRestrict (π.comp (suL h (k + 1)).subtype) (leviFull h (k + 1))
      (fun x => by
        rw [leviFull_eq_map_suL h k hk]
        exact Subgroup.mem_map.mpr ⟨x, x.2, rfl⟩)
  have hfsurj : Function.Surjective fL := by
    intro y
    have hy : (y : AutPSU.PJ h (k + 2)) ∈ (suL h (k + 1)).map (AutPSU.projU h) := by
      rw [← leviFull_eq_map_suL h k hk]
      exact y.2
    obtain ⟨x, hx, hxy⟩ := Subgroup.mem_map.mp hy
    exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩
  set T : Subgroup (suL h (k + 1)) := H.comap fL with hT
  let g : T →* H := MonoidHom.codRestrict (fL.comp T.subtype) H (fun x => x.2)
  have hgsurj : Function.Surjective g := by
    intro a
    obtain ⟨B, hB⟩ := hfsurj a
    refine ⟨⟨B, ?_⟩, Subtype.ext hB⟩
    rw [hT, Subgroup.mem_comap]
    rw [hB]
    exact a.2
  have hgker : g.ker = (fL.ker).subgroupOf T := by
    ext x
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, MonoidHom.mem_ker]
    constructor
    · intro hz; exact congrArg Subtype.val hz
    · intro hz; exact Subtype.ext hz
  have hker_center : g.ker ≤ Subgroup.center T := by
    intro x hx
    rw [Subgroup.mem_center_iff]
    intro y
    apply Subtype.ext
    apply Subtype.ext
    have hxπ : π (x : suL h (k + 1)) = 1 := by
      have hz : fL (x : T) = 1 := by
        have hz' := congrArg (fun w : H => (w : leviFull h (k + 1)))
          (MonoidHom.mem_ker.mp hx)
        dsimp [g] at hz'
        exact hz'
      exact congrArg (fun z : leviFull h (k + 1) =>
        (z : AutPSU.PJ h (k + 2))) hz
    have hxcenter : ((x : suL h (k + 1)) : SU (unitaryInvolution K 2 f) (k + 2)) ∈
        Subgroup.center (SU (unitaryInvolution K 2 f) (k + 2)) :=
      projU_ker_le_center h (k + 1) (by
        rw [MonoidHom.mem_ker]
        dsimp [π] at hxπ
        simpa [AutPSU.projU, QuotientGroup.eq_one_iff] using hxπ)
    exact Subgroup.mem_center_iff.mp hxcenter
      ((y : suL h (k + 1)) : SU (unitaryInvolution K 2 f) (k + 2))
  haveI : Group.IsNilpotent H := hH2.isNilpotent
  have hTnil : Group.IsNilpotent T :=
    Subgroup.isNilpotent_of_ker_le_center g hker_center
  let S : Subgroup T := CFSG.pCore 2 T
  have hSchar : S.Characteristic := CFSG.pCore_characteristic
  have hSmapn : (S.map T.subtype).Normal := by
    refine ⟨fun x hx z => ?_⟩
    obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.1 hx
    have hcy : MulAut.conjNormal (H := T) z y ∈ S := by
      have h := hSchar.fixed (MulAut.conjNormal (H := T) z)
      have hy' : y ∈ Subgroup.comap (MulAut.conjNormal (H := T) z).toMonoidHom S := by
        rw [h]
        exact hy
      exact hy'
    exact Subgroup.mem_map.2 ⟨MulAut.conjNormal (H := T) z y, hcy, rfl⟩
  have hSbot : S.map T.subtype = ⊥ :=
    normal_twoSubgroup_suL_eq_bot h hk _ hSmapn (CFSG.pCore_isPGroup.map _)
  have hSbot' : S = ⊥ := by
    rw [Subgroup.map_eq_bot_iff] at hSbot
    have hker : T.subtype.ker = ⊥ :=
      MonoidHom.ker_eq_bot_iff _ |>.mpr (Subgroup.subtype_injective _)
    rw [hker] at hSbot
    exact le_bot_iff.mp hSbot
  have htop := CFSG.nilpotent_top_le_pCore_sup_pPrimeCore (Q := T) (p := 2) hTnil
  rw [show CFSG.pCore 2 T = S from rfl, hSbot', bot_sup_eq] at htop
  have hprime : CFSG.pPrimeCore 2 T = ⊤ := le_antisymm le_top htop
  have hoddT : Odd (Nat.card T) := by
    have hcop := CFSG.pPrimeCore_coprime_card (p := 2) (G := T)
    rw [hprime] at hcop
    have hcard : Nat.card ↥(⊤ : Subgroup T) = Nat.card T :=
      Nat.card_congr Subgroup.topEquiv.toEquiv
    rw [hcard] at hcop
    exact Nat.coprime_two_left.mp hcop
  have hdvd : Nat.card H ∣ Nat.card T := Subgroup.card_dvd_of_surjective (f := g) hgsurj
  have hoddH : Odd (Nat.card H) := Odd.of_dvd_nat hoddT hdvd
  obtain ⟨a, ha⟩ := hH2.exists_card_eq
  rw [ha] at hoddH
  have ha0 : a = 0 := by
    rcases Nat.eq_zero_or_pos a with h | h
    · exact h
    · exact absurd (Nat.even_pow.2 ⟨even_two, h.ne'⟩) (Nat.not_even_iff_odd.mpr hoddH)
  rw [ha0, pow_zero] at ha
  exact Subgroup.eq_bot_of_card_eq H ha

theorem leviFull_le_normalizer_radical (h : UnitaryFieldData 2 f K) (hm : 3 ≤ m) :
    leviFull h m ≤ Subgroup.normalizer (radical h m : Set (AutPSU.PJ h (m + 1))) := by
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
  have hk : 2 ≤ k := by omega
  rw [leviFull_eq_map_suL h k hk, radical_of_le]
  exact (Subgroup.map_mono (f := AutPSU.projU h) (suL_le_normalizer_suR_aux h k hk)).trans
    (Subgroup.le_normalizer_map (H := suR h (k + 1)) (AutPSU.projU h))

theorem disjoint_radical_leviFull (h : UnitaryFieldData 2 f K) (hm : 3 ≤ m) :
    Disjoint (radical h m) (leviFull h m) := by
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
  have hk : 2 ≤ k := by omega
  rw [radical_of_le, leviFull_eq_map_suL h k hk]
  exact disjoint_map_suR_suL_aux h k hk

private theorem isPGroup_normalizer_leviFull_eq_bot (h : UnitaryFieldData 2 f K) {k : ℕ}
    (hk : 2 ≤ k) {N : Subgroup (AutPSU.PJ h (k + 2))}
    (hN : N ≤ leviFull h (k + 1)) (hN2 : IsPGroup 2 N)
    (hNn : leviFull h (k + 1) ≤
      Subgroup.normalizer (N : Set (AutPSU.PJ h (k + 2)))) : N = ⊥ := by
  have hHn : (N.subgroupOf (leviFull h (k + 1))).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hN).mpr hNn
  have hH2 : IsPGroup 2 (N.subgroupOf (leviFull h (k + 1))) := by
    rw [← Subgroup.comap_subtype]
    exact hN2.comap_of_injective _ (Subgroup.subtype_injective _)
  have hHbot := normal_twoSubgroup_leviFull_eq_bot h hk _ hHn hH2
  rw [eq_bot_iff]
  intro x hx
  rw [Subgroup.mem_bot]
  have hxH : (⟨x, hN hx⟩ : leviFull h (k + 1)) ∈
      N.subgroupOf (leviFull h (k + 1)) := hx
  rw [hHbot] at hxH
  exact congrArg Subtype.val (Subgroup.mem_bot.mp hxH)

theorem leviO2Trivial (h : UnitaryFieldData 2 f K) (hm : 3 ≤ m) :
    ∀ N : Subgroup (AutPSU.PJ h (m + 1)), N ≤ leviFull h m → IsPGroup 2 N →
      leviFull h m ≤ Subgroup.normalizer (N : Set (AutPSU.PJ h (m + 1))) → N = ⊥ := by
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
  have hk : 2 ≤ k := by omega
  intro N hN hN2 hNn
  exact isPGroup_normalizer_leviFull_eq_bot h hk hN hN2 hNn

theorem pCoreOf_centralizer_rootU (h : UnitaryFieldData 2 f K) (hm : 3 ≤ m) :
    CFSG.Assembly.pCoreOf 2
      (Subgroup.centralizer {AutPSU.projU h (AutPSU.rootU (K := K) (f := f) m)}) =
      radical h m := by
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
  have hk : 2 ≤ k := by omega
  have hm3 : 3 ≤ k + 1 := by omega
  have hC := centralizer_rootU_eq_sup h hm3
  have hQ2 : IsPGroup 2 (radical h (k + 1)) := by
    rw [radical_of_le]
    exact (suR_isPGroup h (show 1 ≤ k + 1 by omega)).map (AutPSU.projU h)
  have hMQ := leviFull_le_normalizer_radical h hm3
  exact ggRCST_pCoreOf_eq hC hQ2 hMQ (leviO2Trivial h hm3)

