theorem l10mp2a_lang_surj {L : Type} [Field L]
    [IsAlgClosed L] (Fr : L →+* L) (hFr : ∀ c, Fr c = c ^ 2)
    (ω : List (Fin Tag.E6.rank)) (z : Fin Tag.E6.rank → Lˣ) :
    ∃ u : Fin Tag.E6.rank → Lˣ, twE6Fp Fr ω u = u * z := by
  obtain ⟨u, hu⟩ := CFSG.LieType.SeitzGeneration.ExcHighThree.twPhi_lang (q := 2)
    (by norm_num) hFr ω z
  refine ⟨u, ?_⟩
  rw [← hu]
  unfold CFSG.LieType.SeitzGeneration.ExcHighThree.twPhi twE6Fp
  rw [CFSG.HardMathSupport.Timmesfeld.CrossChar.SmallQ3.e6RhoFour_eq_twistPerm]
  rfl

noncomputable def l10mp2a_delta {L : Type} [Field L] [IsAlgClosed L] (Fr : L →+* L)
    (hFr : ∀ c, Fr c = c ^ 2) (ω : List (Fin Tag.E6.rank)) :
    l10mp2a_AFix Fr ((coxeterSystem Tag.E6).wordProd ω) →*
      (twE6Cartan (L := L)).ker where
  toFun a :=
    ⟨twE6Fp Fr ω (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ)) *
        (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ))⁻¹,
      l10mp2a_delta_mem Fr hFr ω a.2 (l10mp2a_preimage_spec _)⟩
  map_one' := by
    apply Subtype.ext
    change twE6Fp Fr ω (l10mp2a_preimage (1 : Fin Tag.E6.rank → Lˣ)) *
        (l10mp2a_preimage (1 : Fin Tag.E6.rank → Lˣ))⁻¹ = 1
    exact l10mp2a_delta_one Fr hFr ω (l10mp2a_preimage_spec 1)
  map_mul' a b := by
    apply Subtype.ext
    change twE6Fp Fr ω (l10mp2a_preimage ((a * b : l10mp2a_AFix Fr
        ((coxeterSystem Tag.E6).wordProd ω)) : Fin Tag.E6.rank → Lˣ)) *
        (l10mp2a_preimage ((a * b : l10mp2a_AFix Fr
          ((coxeterSystem Tag.E6).wordProd ω)) : Fin Tag.E6.rank → Lˣ))⁻¹ =
      (twE6Fp Fr ω (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ)) *
        (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ))⁻¹) *
      (twE6Fp Fr ω (l10mp2a_preimage (b : Fin Tag.E6.rank → Lˣ)) *
        (l10mp2a_preimage (b : Fin Tag.E6.rank → Lˣ))⁻¹)
    rw [l10mp2a_delta_wd Fr hFr ω (c := l10mp2a_preimage
        ((a * b : l10mp2a_AFix Fr ((coxeterSystem Tag.E6).wordProd ω)) :
          Fin Tag.E6.rank → Lˣ))
      (c' := l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ) *
        l10mp2a_preimage (b : Fin Tag.E6.rank → Lˣ)) ?_]
    · rw [twE6Fp_mul]
      simp [mul_inv, mul_assoc, mul_comm, mul_left_comm]
    · rw [l10mp2a_preimage_spec]
      rw [show e6RootParams (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ) *
          l10mp2a_preimage (b : Fin Tag.E6.rank → Lˣ)) =
          e6RootParams (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ)) *
            e6RootParams (l10mp2a_preimage (b : Fin Tag.E6.rank → Lˣ)) from by
        change twE6Cartan (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ) *
            l10mp2a_preimage (b : Fin Tag.E6.rank → Lˣ)) =
          twE6Cartan (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ)) *
            twE6Cartan (l10mp2a_preimage (b : Fin Tag.E6.rank → Lˣ))
        rw [map_mul]]
      rw [l10mp2a_preimage_spec, l10mp2a_preimage_spec]
      rfl

theorem l10mp2a_delta_range {L : Type} [Field L]
    [IsAlgClosed L] (Fr : L →+* L) (hFr : ∀ c, Fr c = c ^ 2)
    (ω : List (Fin Tag.E6.rank)) :
    (l10mp2a_delta Fr hFr ω).range = ⊤ := by
  rw [Subgroup.eq_top_iff']
  rintro ⟨z, hz⟩
  obtain ⟨c, hc⟩ := l10mp2a_lang_surj Fr hFr ω z
  have hcz : e6RootParams (z : Fin Tag.E6.rank → Lˣ) = 1 := hz
  have ha : e6RootParams c ∈ l10mp2a_AFix Fr ((coxeterSystem Tag.E6).wordProd ω) := by
    change weylTuple ((coxeterSystem Tag.E6).wordProd ω)
      (fun i => Units.map Fr.toMonoidHom (e6RootParams c (l10mp2a_perm i))) = e6RootParams c
    rw [← l10mp2a_cartan_fp Fr ω c]
    have hκ : e6RootParams (twE6Fp Fr ω c) = e6RootParams c := by
      rw [hc]
      change twE6Cartan (c * (z : Fin Tag.E6.rank → Lˣ)) = twE6Cartan c
      rw [map_mul, show twE6Cartan (z : Fin Tag.E6.rank → Lˣ) = 1 from hcz, mul_one]
    change e6RootParams (ω.foldr e6StarS
      (fun i => Units.map Fr.toMonoidHom (c (l10mp2a_perm i)))) = e6RootParams c
    exact hκ
  refine ⟨⟨e6RootParams c, ha⟩, ?_⟩
  apply Subtype.ext
  change twE6Fp Fr ω (l10mp2a_preimage (e6RootParams c)) *
      (l10mp2a_preimage (e6RootParams c))⁻¹ = (z : Fin Tag.E6.rank → Lˣ)
  rw [l10mp2a_delta_wd Fr hFr ω (c := l10mp2a_preimage (e6RootParams c)) (c' := c) ?_]
  · rw [hc]
    simp [mul_assoc, mul_comm, mul_left_comm]
  · rw [l10mp2a_preimage_spec]

theorem l10mp2a_delta_ker {L : Type} [Field L] [IsAlgClosed L] (Fr : L →+* L)
    (hFr : ∀ c, Fr c = c ^ 2) (ω : List (Fin Tag.E6.rank)) :
    (l10mp2a_delta Fr hFr ω).ker =
      ((twE6Pfix Fr ω).map twE6Cartan).subgroupOf
        (l10mp2a_AFix Fr ((coxeterSystem Tag.E6).wordProd ω)) := by
  ext a
  constructor
  · intro ha
    have hval : twE6Fp Fr ω (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ)) *
        (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ))⁻¹ = 1 := by
      have := congrArg Subtype.val ha
      simpa [l10mp2a_delta] using this
    have hfix : twE6Fp Fr ω (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ)) =
        l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ) := by
      calc twE6Fp Fr ω (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ)) =
          (twE6Fp Fr ω (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ)) *
            (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ))⁻¹) *
              l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ) := by group
        _ = 1 * l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ) := by rw [hval]
        _ = l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ) := one_mul _
    rw [Subgroup.mem_subgroupOf]
    exact Subgroup.mem_map.2 ⟨l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ), hfix,
      (l10mp2a_preimage_spec (a : Fin Tag.E6.rank → Lˣ))⟩
  · intro ha
    obtain ⟨c, hcP, hca⟩ := Subgroup.mem_map.1 (Subgroup.mem_subgroupOf.1 ha)
    have hc : twE6Fp Fr ω c = c := hcP
    apply Subtype.ext
    change twE6Fp Fr ω (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ)) *
        (l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ))⁻¹ = 1
    rw [l10mp2a_delta_wd Fr hFr ω (c := l10mp2a_preimage (a : Fin Tag.E6.rank → Lˣ))
      (c' := c) ?_]
    · rw [hc, mul_inv_cancel]
    · rw [l10mp2a_preimage_spec]
      exact hca.symm

theorem l10mp2a_card_image {L : Type} [Field L]
    [IsAlgClosed L] [CharP L 2] (Fr : L →+* L) (hFr : ∀ c, Fr c = c ^ 2)
    (ω : List (Fin Tag.E6.rank)) :
    Nat.card ((twE6Pfix Fr ω).map twE6Cartan) * 3 =
      Nat.card (l10mp2a_AFix Fr ((coxeterSystem Tag.E6).wordProd ω)) := by
  let A := l10mp2a_AFix Fr ((coxeterSystem Tag.E6).wordProd ω)
  let B := (twE6Pfix Fr ω).map twE6Cartan
  let Z := (twE6Cartan (L := L)).ker
  let δ := l10mp2a_delta Fr hFr ω
  have hZ : Nat.card Z = 3 := l10mp2a_card_ker
  have hker : δ.ker = B.subgroupOf A := l10mp2a_delta_ker Fr hFr ω
  have hrange : δ.range = ⊤ := l10mp2a_delta_range Fr hFr ω
  have h1 := Subgroup.card_ker_mul_card_range δ
  have hker_card : Nat.card δ.ker = Nat.card B := by
    rw [hker]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe (l10mp2a_image_le Fr ω)).toEquiv
  have hrange_card : Nat.card δ.range = Nat.card Z := by
    rw [hrange]
    exact Nat.card_congr (Subgroup.topEquiv (G := Z)).toEquiv
  rw [hker_card, hrange_card, hZ] at h1
  exact h1

end CFSG.StandardType.TwE6Tori

