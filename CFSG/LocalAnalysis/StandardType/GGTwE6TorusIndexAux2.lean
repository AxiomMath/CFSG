theorem l10mp2a_mem_ker_iff_centerChars {L : Type} [Field L] (k : Fin Tag.E6.rank → Lˣ) :
    k ∈ (twE6Cartan (L := L)).ker ↔ k ∈ centerChars Tag.E6 L := by
  rw [MonoidHom.mem_ker, mem_centerChars]
  constructor
  · intro h j
    have := congrFun h j
    simpa [twE6Cartan, e6RootParams] using this
  · intro h
    funext j
    simpa [twE6Cartan, e6RootParams] using h j

theorem l10mp2a_e6c_perm (i : Fin Tag.E6.rank) :
    (3 : ℤ) ∣ e6c i - 2 * e6c (l10mp2a_perm i) := by
  fin_cases i <;> decide +kernel

theorem l10mp2a_card_ker {L : Type} [Field L] [IsAlgClosed L] [CharP L 2] :
    Nat.card (twE6Cartan (L := L)).ker = 3 := by
  have hZ : (twE6Cartan (L := L)).ker = centerChars Tag.E6 L := by
    ext k
    exact l10mp2a_mem_ker_iff_centerChars k
  rw [hZ, Nat.card_congr (e6CenterCharsEquiv L).toEquiv]
  haveI : NeZero ((3 : L)) := ⟨by
    intro h0
    have h2 : (2 : ℕ) ∣ 3 := (CharP.cast_eq_zero_iff L 2 3).1 (by simpa using h0)
    norm_num at h2⟩
  haveI : HasEnoughRootsOfUnity L 3 := IsSepClosed.hasEnoughRootsOfUnity L 3
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot L 3
  exact hζ.card_rootsOfUnity

theorem l10mp2a_ker_le_pfix {L : Type} [Field L] (Fr : L →+* L) (hFr : ∀ c, Fr c = c ^ 2)
    (ω : List (Fin Tag.E6.rank)) :
    (twE6Cartan (L := L)).ker ≤ twE6Pfix Fr ω := by
  intro k hk
  have hkcc : k ∈ centerChars Tag.E6 L := (l10mp2a_mem_ker_iff_centerChars k).1 hk
  have hk3 : ∀ m, k m ^ 3 = 1 := pow_eq_one_of_mem_centerChars e6B_spec hkcc
  have hk0 : ∀ m, k m = k (0 : Fin Tag.E6.rank) ^ e6c m := fun m =>
    eq_zpow_of_mem_centerChars e6C_spec hkcc m
  have hFr_unit : ∀ x : Lˣ, Units.map Fr.toMonoidHom x = x ^ 2 := fun x =>
    Units.ext (by rw [Units.coe_map, Units.val_pow_eq_pow_val]; exact hFr x)
  have hσ : (fun i => Units.map Fr.toMonoidHom (k (l10mp2a_perm i))) = k := by
    funext i
    rw [hk0 (l10mp2a_perm i), hk0 i, hFr_unit, ← zpow_natCast, ← zpow_mul, mul_comm]
    rw [zpow_eq_zpow_iff_modEq]
    exact Int.ModEq.of_dvd (by exact_mod_cast orderOf_dvd_of_pow_eq_one (hk3 (0 : Fin Tag.E6.rank)))
      (Int.modEq_of_dvd (l10mp2a_e6c_perm i))
  have hstar : ∀ j, e6StarS j k = k := by
    intro j
    have hQ : (∏ l, k l ^ (-Tag.E6.cartan l j)) = 1 := by
      have hkj : (∏ l, k l ^ Tag.E6.cartan l j) = 1 := by
        have := congrFun hk j
        simpa [twE6Cartan, e6RootParams] using this
      rw [show (∏ l, k l ^ (-Tag.E6.cartan l j)) =
          (∏ l, k l ^ Tag.E6.cartan l j)⁻¹ by
        rw [← Finset.prod_inv_distrib]
        exact Finset.prod_congr rfl fun l _ => by rw [zpow_neg]]
      rw [hkj, inv_one]
    rw [e6StarS, hQ, Pi.mulSingle_one, mul_one]
  have hfold : ω.foldr e6StarS (fun i => Units.map Fr.toMonoidHom (k (l10mp2a_perm i))) = k := by
    rw [hσ]
    induction ω with
    | nil => rfl
    | cons j ω ih => rw [List.foldr_cons, ih, hstar j]
  change twE6Fp Fr ω k = k
  change ω.foldr e6StarS (fun i => Units.map Fr.toMonoidHom (k (l10mp2a_perm i))) = k
  exact hfold

noncomputable def l10mp2a_preimage {L : Type} [Field L] [IsAlgClosed L] (a : Fin Tag.E6.rank → Lˣ) :
    Fin Tag.E6.rank → Lˣ :=
  Classical.choose (exists_e6RootParams_eq a)

theorem l10mp2a_preimage_spec {L : Type} [Field L] [IsAlgClosed L] (a : Fin Tag.E6.rank → Lˣ) :
    e6RootParams (l10mp2a_preimage a) = a :=
  Classical.choose_spec (exists_e6RootParams_eq a)

theorem l10mp2a_twE6Fp_inv {L : Type} [Field L] (Fr : L →+* L) (ω : List (Fin Tag.E6.rank))
    (c : Fin Tag.E6.rank → Lˣ) : twE6Fp Fr ω c⁻¹ = (twE6Fp Fr ω c)⁻¹ := by
  change twE6FpHom Fr ω c⁻¹ = (twE6FpHom Fr ω c)⁻¹
  rw [map_inv]

theorem l10mp2a_delta_mem {L : Type} [Field L] (Fr : L →+* L) (hFr : ∀ c, Fr c = c ^ 2)
    (ω : List (Fin Tag.E6.rank)) {a c : Fin Tag.E6.rank → Lˣ}
    (ha : a ∈ l10mp2a_AFix Fr ((coxeterSystem Tag.E6).wordProd ω))
    (hc : e6RootParams c = a) :
    twE6Fp Fr ω c * c⁻¹ ∈ (twE6Cartan (L := L)).ker := by
  rw [MonoidHom.mem_ker, map_mul, map_inv]
  change e6RootParams (twE6Fp Fr ω c) * (e6RootParams c)⁻¹ = 1
  have hfp : twE6Fp Fr ω c =
      ω.foldr e6StarS (fun i => Units.map Fr.toMonoidHom (c (l10mp2a_perm i))) := by
    change twE6Fp Fr ω c = ω.foldr e6StarS
      (fun i => Units.map Fr.toMonoidHom (c (l10mp2a_perm i)))
    rfl
  rw [hfp, l10mp2a_cartan_fp Fr ω c, hc]
  have ha' : weylTuple ((coxeterSystem Tag.E6).wordProd ω)
      (fun i => Units.map Fr.toMonoidHom (a (l10mp2a_perm i))) = a := ha
  rw [ha', mul_inv_cancel]

theorem l10mp2a_delta_one {L : Type} [Field L] (Fr : L →+* L) (hFr : ∀ c, Fr c = c ^ 2)
    (ω : List (Fin Tag.E6.rank)) {c : Fin Tag.E6.rank → Lˣ}
    (hc : e6RootParams c = 1) : twE6Fp Fr ω c * c⁻¹ = 1 := by
  have hz : c ∈ (twE6Cartan (L := L)).ker := by
    rw [MonoidHom.mem_ker]
    change e6RootParams c = 1
    exact hc
  have hfix : twE6Fp Fr ω c = c := l10mp2a_ker_le_pfix Fr hFr ω hz
  rw [hfix]
  exact mul_inv_cancel c

theorem l10mp2a_delta_wd {L : Type} [Field L] (Fr : L →+* L) (hFr : ∀ c, Fr c = c ^ 2)
    (ω : List (Fin Tag.E6.rank)) {c c' : Fin Tag.E6.rank → Lˣ}
    (h : e6RootParams c = e6RootParams c') :
    twE6Fp Fr ω c * c⁻¹ = twE6Fp Fr ω c' * c'⁻¹ := by
  have hz : c' * c⁻¹ ∈ (twE6Cartan (L := L)).ker := by
    rw [MonoidHom.mem_ker]
    change twE6Cartan (c' * c⁻¹) = 1
    rw [map_mul, map_inv]
    change e6RootParams c' * (e6RootParams c)⁻¹ = 1
    rw [← h, mul_inv_cancel]
  have hfix : twE6Fp Fr ω (c' * c⁻¹) = c' * c⁻¹ :=
    l10mp2a_ker_le_pfix Fr hFr ω hz
  have hFP : twE6Fp Fr ω c' * (twE6Fp Fr ω c)⁻¹ = c' * c⁻¹ := by
    rw [← hfix, twE6Fp_mul, l10mp2a_twE6Fp_inv]
  have hBC : twE6Fp Fr ω c' * c = c' * twE6Fp Fr ω c := by
    calc twE6Fp Fr ω c' * c =
        (twE6Fp Fr ω c' * (twE6Fp Fr ω c)⁻¹) * (twE6Fp Fr ω c * c) := by group
      _ = (c' * c⁻¹) * (twE6Fp Fr ω c * c) := by rw [hFP]
      _ = c' * twE6Fp Fr ω c := by simp [mul_assoc, mul_comm, mul_left_comm]
  have h2 : twE6Fp Fr ω c * c' = twE6Fp Fr ω c' * c := by
    rw [mul_comm (twE6Fp Fr ω c) c']
    exact hBC.symm
  apply mul_right_cancel (b := c * c')
  calc twE6Fp Fr ω c * c⁻¹ * (c * c') = twE6Fp Fr ω c * c' := by group
    _ = twE6Fp Fr ω c' * c := h2
    _ = twE6Fp Fr ω c' * c'⁻¹ * (c * c') := by
      simp [mul_assoc, mul_comm, mul_left_comm]

