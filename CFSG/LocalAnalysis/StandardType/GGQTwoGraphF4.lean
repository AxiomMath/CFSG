@[expose] def ggQ2gwF4WordOf (tab : List ((Fin 4 → ZMod 3) × List (Fin 4)))
    (x : Fin 4 → ZMod 3) : List (Fin 4) :=
  ((tab.find? fun p => decide (p.1 = x)).map Prod.snd).getD []

open scoped CFSG.Decide.Bounded in
theorem ggQ2gwF4Kill_OK : ∀ E ∈ ggQ2gwF4Kill, E.OK ggQ2gwF4C := by
  decide +kernel

open scoped CFSG.Decide.Bounded in
theorem ggQ2gwF4Kill_cover :
    ∀ x : Fin 4 → ZMod 3,
      ggQ2gwQ ggQ2gwF4C ggQ2gwF4Wt x ≠ 0 → ∃ E ∈ ggQ2gwF4Kill, E.d = x := by
  decide +kernel

open scoped CFSG.Decide.Bounded in
theorem ggQ2gwF4Word0_spec :
    ∀ x : Fin 4 → ZMod 3, x ≠ 0 → ggQ2gwQ ggQ2gwF4C ggQ2gwF4Wt x = 0 →
      ggQ2gwAct ggQ2gwF4C (ggQ2gwF4WordOf ggQ2gwF4Word0 x) x = ![0, 0, 1, 2] ∨
        ggQ2gwAct ggQ2gwF4C (ggQ2gwF4WordOf ggQ2gwF4Word0 x) x = -![0, 0, 1, 2] := by
  decide +kernel

open scoped CFSG.Decide.Bounded in
theorem ggQ2gwF4C_sym :
    ∀ i j : Fin 4, ggQ2gwF4Wt i * ggQ2gwF4C i j = ggQ2gwF4Wt j * ggQ2gwF4C j i := by
  decide +kernel

open scoped CFSG.Decide.Bounded in
theorem ggQ2gwF4C_diag : ∀ j : Fin 4, ggQ2gwF4C j j = 2 := by
  decide +kernel

open scoped CFSG.Decide.Bounded in
theorem ggQ2gwF4C_lam :
    ∀ lam : Fin 4 → ZMod 3,
      (∀ i j, ggQ2gwF4C i j * lam i = ggQ2gwF4C j i * lam j) →
        ∃ μ : ZMod 3, ∀ i, 2 * lam i = μ * ggQ2gwF4Wt i := by
  decide +kernel

private theorem ggQ2gwF4_q_scale {U : Type} [AddCommGroup U] [Module (ZMod 3) U]
    (h : Fin 4 → U) (hli : LinearIndependent (ZMod 3) h)
    (hsp : Submodule.span (ZMod 3) (Set.range h) = ⊤)
    (α : Fin 4 → Module.Dual (ZMod 3) U)
    (hα : ∀ i j, α i (h j) = ggQ2gwF4C i j) (T : U ≃ₗ[ZMod 3] U)
    (hT : T ∈ Subgroup.normalizer (ggQ2WeylOf h α : Set (U ≃ₗ[ZMod 3] U))) {d : U}
    (hQ : ggQ2gwQ ggQ2gwF4C ggQ2gwF4Wt (ggQ2gwCoord h hli hsp d) = 0) :
    ggQ2gwQ ggQ2gwF4C ggQ2gwF4Wt (ggQ2gwCoord h hli hsp (T.symm d)) = 0 := by
  have hTinv : T.symm ∈ Subgroup.normalizer (ggQ2WeylOf h α : Set (U ≃ₗ[ZMod 3] U)) :=
    Subgroup.inv_mem (Subgroup.normalizer (ggQ2WeylOf h α : Set (U ≃ₗ[ZMod 3] U))) hT
  obtain ⟨μ, hμ⟩ :=
    ggQ2gwForm_normalizer ggQ2gwF4C ggQ2gwF4Wt ggQ2gwF4C_sym ggQ2gwF4C_lam h hli hsp α hα
      ggQ2gwF4C_diag T.symm hTinv
  calc
    ggQ2gwQ ggQ2gwF4C ggQ2gwF4Wt (ggQ2gwCoord h hli hsp (T.symm d)) =
        ggQ2gwForm ggQ2gwF4Wt h hli hsp α (T.symm d) (T.symm d) :=
      (ggQ2gwForm_self ggQ2gwF4C ggQ2gwF4Wt h hli hsp α hα (T.symm d)).symm
    _ = μ * ggQ2gwForm ggQ2gwF4Wt h hli hsp α d d := hμ d d
    _ = μ * ggQ2gwQ ggQ2gwF4C ggQ2gwF4Wt (ggQ2gwCoord h hli hsp d) :=
      congrArg (fun z => μ * z)
        (ggQ2gwForm_self ggQ2gwF4C ggQ2gwF4Wt h hli hsp α hα d)
    _ = 0 := by rw [hQ, mul_zero]

theorem ggQ2GraphAbsCore_F4 : GGQ2GraphAbsCore 4 CartanMatrix.F₄ := by
  intro U _ _ h hli hsp α hα d hd0
  have hα' : ∀ i j, α i (h j) = ggQ2gwF4C i j := by
    intro i j
    rw [hα i j, ggQ2gwF4C_eq i j]
  have h2 : ∀ j, α j (h j) = 2 := by
    intro j
    rw [hα' j j, ggQ2gwF4C_diag j]
  set x : Fin 4 → ZMod 3 := ggQ2gwCoord h hli hsp d with hx
  have hx0 : x ≠ 0 := by
    intro h0
    have h1 : ggQ2gwCoord h hli hsp d = 0 := by simpa [hx] using h0
    exact hd0 ((ggQ2gwCoord h hli hsp).injective (by simpa using h1))
  by_cases hQ : ggQ2gwQ ggQ2gwF4C ggQ2gwF4Wt x = 0
  · right
    refine ggQ2gw_line_of_trans ggQ2gwF4C h hli hsp α hα' h2
      (fun y => y ≠ 0 ∧ ggQ2gwQ ggQ2gwF4C ggQ2gwF4Wt y = 0) ![0, 0, 1, 2]
      (ggQ2gwF4WordOf ggQ2gwF4Word0) ?_ d ⟨?_, ?_⟩ ?_
    · intro y hy
      exact ggQ2gwF4Word0_spec y hy.1 hy.2
    · simpa [hx] using hx0
    · simpa [hx] using hQ
    · intro T hT
      refine ⟨?_, ?_⟩
      · intro h0
        apply hd0
        have h1 : T.symm d = 0 :=
          (ggQ2gwCoord h hli hsp).injective (by simpa using h0)
        simpa using congrArg T h1
      · exact ggQ2gwF4_q_scale h hli hsp α hα' T hT (d := d) (by simpa [hx] using hQ)
  · left
    obtain ⟨E, hE, hEd⟩ := ggQ2gwF4Kill_cover x hQ
    exact ggQ2gw_kill_of_entry ggQ2gwF4C h hli hsp α hα' ggQ2gwF4C_diag E
      (ggQ2gwF4Kill_OK E hE) d (by simpa [hx] using hEd.symm)

end CFSG.StandardType

