theorem exists_surjective_fixedGroup
    {n : ℕ} (hn : 3 ≤ n) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ n) ^ 2)
    (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ n)
    (ε : ↥(twistedE6RootGroup K σ) ≃* TwE6Delta.RecipeR K n) {L' : Type} [Group L'] [Finite L']
    {ψ : L' →* TwE6Delta.RecipeR K n} (hψ : Function.Surjective ψ)
    (hker : ψ.ker ≤ Subgroup.center L') (hperf : commutator L' = ⊤) :
    ∃ α : ↥(fixedGroup K σ.toRingHom) →* L', Function.Surjective α ∧
      (∀ u, ψ (α u) = ε (twistedIsogenyC (by omega) hK σ.toRingHom hσ u)) ∧
      α.ker ≤ Subgroup.center ↥(fixedGroup K σ.toRingHom) := by
  classical
  have hn1 : 1 ≤ n := by omega
  set q : ↥(fixedGroup K σ.toRingHom) →* TwE6Delta.RecipeR K n :=
    ε.toMonoidHom.comp (twistedIsogenyC hn1 hK σ.toRingHom hσ)
  have hqs : Function.Surjective q :=
    ε.surjective.comp (twistedIsogenyC_surjective hn1 hK σ.toRingHom hσ)
  have hqZ : ∀ s, q s = 1 → s ∈ Subgroup.center ↥(fixedGroup K σ.toRingHom) := fun s hs => by
    have hs' : ε (twistedIsogenyC hn1 hK σ.toRingHom hσ s) = 1 := hs
    rw [← ker_twistedIsogenyC hn1 hK σ.toRingHom hσ, MonoidHom.mem_ker]
    exact (map_eq_one_iff ε ε.injective).1 hs'
  have : Finite ↥(fixedGroup K σ.toRingHom) := by
    have : Finite (Module.End K (Fin e6Data.d →₀ K)) := Module.finite_of_finite K
    infer_instance
  have h5 : 5 ≤ 2 ^ n :=
    calc 5 ≤ 2 ^ 3 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
  obtain ⟨α, hα, hαs⟩ := E6ThreeKernel.exists_surjective_of_split hqs
    (fun E _ _ π hπ hc =>
      TwistedE6Closed.twistedE6_exists_section_of_central σ.toRingHom h5 hK hσ hπ hc)
    hψ hker hperf
  refine ⟨α, hαs, hα, ?_⟩
  intro s hs
  exact hqZ s (by rw [← hα, MonoidHom.mem_ker.mp hs, map_one])

theorem exists_mulEquiv_fixedGroup
    {n : ℕ} (hn : 3 ≤ n) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ n) ^ 2)
    (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ n)
    (ε : ↥(twistedE6RootGroup K σ) ≃* TwE6Delta.RecipeR K n) {L' : Type} [Group L'] [Finite L']
    {ψ : L' →* TwE6Delta.RecipeR K n} (hψ : Function.Surjective ψ)
    (hker : ψ.ker ≤ Subgroup.center L') (hperf : commutator L' = ⊤) (h3 : 3 ∣ Nat.card ψ.ker) :
    ∃ α : ↥(fixedGroup K σ.toRingHom) ≃* L',
      ∀ u, ψ (α u) = ε (twistedIsogenyC (by omega) hK σ.toRingHom hσ u) := by
  classical
  have hn1 : 1 ≤ n := by omega
  obtain ⟨α, hαs, hα, hαker⟩ := exists_surjective_fixedGroup hn hK σ hσ ε hψ hker hperf
  have hqZ : ∀ s, ε (twistedIsogenyC hn1 hK σ.toRingHom hσ s) = 1 →
      s ∈ Subgroup.center ↥(fixedGroup K σ.toRingHom) := fun s hs => by
    rw [← ker_twistedIsogenyC hn1 hK σ.toRingHom hσ, MonoidHom.mem_ker]
    exact (map_eq_one_iff ε ε.injective).1 hs
  have hZ3 : Nat.card (Subgroup.center ↥(fixedGroup K σ.toRingHom)) ∣ 3 := by
    rw [(TwistedE6Closed.card_center_fixedGroup hK hσ).1]
    exact Nat.gcd_dvd_left 3 _
  have hinj : Function.Injective α := by
    refine (injective_iff_map_eq_one α).2 fun s hs => ?_
    by_contra hs1
    have hsZ := hαker (MonoidHom.mem_ker.mpr hs)
    have hord : orderOf s = 3 := by
      rcases (Nat.dvd_prime Nat.prime_three).1
          ((Subgroup.orderOf_dvd_natCard _ hsZ).trans hZ3) with h | h
      · exact absurd (orderOf_eq_one_iff.1 h) hs1
      · exact h
    have hZs : Subgroup.center ↥(fixedGroup K σ.toRingHom) ≤ Subgroup.zpowers s := by
      refine (Subgroup.eq_of_le_of_card_ge ((Subgroup.zpowers_le).2 hsZ) ?_).symm.le
      rw [Nat.card_zpowers, hord]
      exact Nat.le_of_dvd (by norm_num) hZ3
    have hbot : ψ.ker = ⊥ := by
      refine (Subgroup.eq_bot_iff_forall _).2 fun z hz => ?_
      obtain ⟨t, rfl⟩ := hαs z
      obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 (hZs (hqZ t (by rw [← hα]; exact hz)))
      rw [map_zpow, hs, one_zpow]
    rw [hbot, Subgroup.card_bot] at h3
    exact absurd (Nat.le_of_dvd one_pos h3) (by norm_num)
  exact ⟨MulEquiv.ofBijective α ⟨hinj, hαs⟩, fun u => hα u⟩

theorem iota_twistedIsogenyC_mem_toralRootGroup
    {n : ℕ} (hn : 1 ≤ n) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ n) ^ 2)
    (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ n) {h : twistedE6InndiagGL K σ}
    (D : TwE6LineLangIota K σ (2 ^ n) h) {hhat xhat : ↥(fixedGroup K σ.toRingHom)}
    (hlift : ((twistedIsogenyC hn hK σ.toRingHom hσ hhat : twistedE6RootGroup K σ) :
      ModGL TwistTag.E6.tag K) = h)
    (hcomm : xhat * hhat = hhat * xhat) :
    D.ι (twistedIsogenyC hn hK σ.toRingHom hσ xhat) ∈
      toralRootGroup Tag.E6 (AlgebraicClosure K) D.a := by
  classical
  obtain ⟨π, hπ⟩ : ∃ π : ↥(fixedGroup K σ.toRingHom) →* ↥(twistedE6RootGroup K σ),
      π = twistedIsogenyC hn hK σ.toRingHom hσ := ⟨_, rfl⟩
  rw [← hπ] at hlift ⊢
  obtain ⟨ι, hιdef⟩ : ∃ ι : K →+* AlgebraicClosure K, ι = algebraMap K (AlgebraicClosure K) :=
    ⟨_, rfl⟩
  obtain ⟨g0, hg0def⟩ : ∃ g0, g0 = D.S.D.g0 := ⟨_, rfl⟩
  have hιD : ∀ c : ↥(twistedE6RootGroup K σ), D.ι c = g0⁻¹ *
      (baseChangeGL ι (c : ModGL TwistTag.E6.tag K) : ModGL Tag.E6 (AlgebraicClosure K)) * g0 :=
    fun c => by
      rw [hιdef, hg0def]
      exact D.hι c
  have hg0 : g0 * rootDiagUnit Tag.E6 D.a * g0⁻¹ =
      (baseChangeGL ι (h : ModGL TwistTag.E6.tag K) : ModGL Tag.E6 (AlgebraicClosure K)) := by
    rw [hιdef, hg0def]
    exact D.hg0
  have hg0C : g0 ∈ adjointGroup Tag.E6 (AlgebraicClosure K) := by
    rw [hg0def]
    exact D.S.D.g0_mem
  have : Fact (ringChar K).Prime := ⟨D.hℓ⟩
  have : CharP (AlgebraicClosure K) (ringChar K) := D.hchar
  have hℓ3 : ringChar K ≠ 3 := fun h3 =>
    D.hL3 (by rw [← h3]; exact CharP.cast_eq_zero (AlgebraicClosure K) (ringChar K))
  obtain ⟨u, hu⟩ := exists_e6RootParams_eq D.a
  obtain ⟨Eg, hEg⟩ := exists_finset_descent hg0C
  obtain ⟨K₃, hK₃, hEK₃, hιK₃⟩ := exists_finite_subfield_of_finset (K := K)
    (Eg ∪ Finset.univ.image fun i => ((u i : (AlgebraicClosure K)ˣ) : AlgebraicClosure K))
  have : Finite K₃ := hK₃
  have : CharP K₃ (ringChar K) := Subfield.charP K₃ (ringChar K)
  obtain ⟨g₃, hg₃C, hg₃⟩ := hEg K₃ fun x hx =>
    hEK₃ (Finset.mem_coe.2 (Finset.mem_union_left _ hx))
  obtain ⟨u₃, hu₃⟩ := exists_units_descent K₃ u fun i =>
    hEK₃ (Finset.mem_coe.2 (Finset.mem_union_right _ (Finset.mem_image_of_mem _
      (Finset.mem_univ i))))
  obtain ⟨ι₃, hιι⟩ : ∃ ι₃ : K →+* K₃, K₃.subtype.comp ι₃ = ι :=
    ⟨ι.codRestrict K₃ fun c => by rw [hιdef]; exact hιK₃ ⟨c, rfl⟩, RingHom.ext fun _ => rfl⟩
  have hbcinj : Function.Injective (baseChangeGL (τ := Tag.E6) K₃.subtype) :=
    baseChangeGL_injective K₃.subtype
  have hbcι : ∀ y : ModGL Tag.E6 K,
      baseChangeGL K₃.subtype (baseChangeGL ι₃ y) = baseChangeGL ι y := fun y => by
    rw [CFSG.LieType.Chevalley.baseChangeGL_baseChangeGL, hιι]
  have hpar : (fun i => Units.map K₃.subtype.toMonoidHom (e6RootParams u₃ i)) = D.a := by
    rw [← hu, ← hu₃]
    funext j
    simp only [e6RootParams, map_prod, map_zpow]
  have ha₃ : ∀ j, e6RootParams u₃ j ^ 3 = 1 := fun j => by
    apply units_map_subtype_injective K₃
    have hj : Units.map K₃.subtype.toMonoidHom (e6RootParams u₃ j) = D.a j := congrFun hpar j
    rw [map_pow, hj, D.hap j, map_one]
  obtain ⟨π₃, hπ₃⟩ : ∃ π : e6Data_valid.minGroup K₃ →* ModGL Tag.E6 K₃,
      π = (adjointGroup Tag.E6 K₃).subtype.comp (e6Isogeny K₃) := ⟨_, rfl⟩
  have hπ₃a : ∀ g, π₃ g = ((e6Isogeny K₃ g : adjointGroup Tag.E6 K₃) : ModGL Tag.E6 K₃) :=
    fun g => by rw [hπ₃]; rfl
  obtain ⟨G₃, hG₃⟩ := e6Isogeny_surjective K₃ ⟨g₃, hg₃C⟩
  have hπG : baseChangeGL K₃.subtype (π₃ G₃) = g0 := by rw [hπ₃a, hG₃, hg₃]
  have hbcπ : ∀ s : ↥(fixedGroup K σ.toRingHom),
      baseChangeGL K₃.subtype (π₃ (minBC e6Data_valid ι₃ s)) =
        (baseChangeGL ι ((π s : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) :
          ModGL Tag.E6 (AlgebraicClosure K)) := fun s => by
    rw [hπ₃a, e6Isogeny_minBC, hbcι, hπ]
    rfl
  obtain ⟨T, hT⟩ : ∃ T, T = minTorus e6Data_valid K₃ u₃ := ⟨_, rfl⟩
  have hπT : π₃ T = rootDiagUnit Tag.E6 (e6RootParams u₃) := by
    rw [hπ₃a, hT]
    exact e6Isogeny_minTorus u₃
  have hbcT : baseChangeGL K₃.subtype (π₃ T) = rootDiagUnit Tag.E6 D.a := by
    rw [hπT, baseChangeGL_rootDiagUnit, hpar]
  obtain ⟨hl, hhl⟩ : ∃ y, y = G₃⁻¹ * minBC e6Data_valid ι₃ hhat * G₃ := ⟨_, rfl⟩
  obtain ⟨xl, hxl⟩ : ∃ y, y = G₃⁻¹ * minBC e6Data_valid ι₃ xhat * G₃ := ⟨_, rfl⟩
  have hbchl : baseChangeGL K₃.subtype (π₃ hl) = rootDiagUnit Tag.E6 D.a := by
    simp only [hhl, map_mul, map_inv, hπG, hbcπ, hlift]
    rw [← hg0]
    group
  have hxh : xl * hl = hl * xl := by
    have h1 : ((xhat : e6Data_valid.minGroup K) * hhat) =
        (hhat : e6Data_valid.minGroup K) * xhat := by
      rw [← Subgroup.coe_mul, ← Subgroup.coe_mul, hcomm]
    have h2 : minBC e6Data_valid ι₃ xhat * minBC e6Data_valid ι₃ hhat =
        minBC e6Data_valid ι₃ hhat * minBC e6Data_valid ι₃ xhat := by
      rw [← map_mul, h1, map_mul]
    rw [hxl, hhl]
    calc G₃⁻¹ * minBC e6Data_valid ι₃ xhat * G₃ * (G₃⁻¹ * minBC e6Data_valid ι₃ hhat * G₃)
        = G₃⁻¹ * (minBC e6Data_valid ι₃ xhat * minBC e6Data_valid ι₃ hhat) * G₃ := by group
      _ = G₃⁻¹ * (minBC e6Data_valid ι₃ hhat * minBC e6Data_valid ι₃ xhat) * G₃ := by rw [h2]
      _ = G₃⁻¹ * minBC e6Data_valid ι₃ hhat * G₃ * (G₃⁻¹ * minBC e6Data_valid ι₃ xhat * G₃) := by
          group
  obtain ⟨z, hz⟩ : ∃ z, z = T⁻¹ * hl := ⟨_, rfl⟩
  have hzc : z ∈ Subgroup.center (e6Data_valid.minGroup K₃) := by
    refine SmallQ3.mem_center_of_isogeny_eq_one ?_
    have hTl : π₃ hl = π₃ T := hbcinj (hbchl.trans hbcT.symm)
    rw [← hπ₃a, hz, map_mul, map_inv, hTl, inv_mul_cancel]
  have hxT : xl * T = T * xl := by
    have hhz : hl = T * z := by rw [hz]; group
    have hzx := Subgroup.mem_center_iff.1 hzc xl
    have h1 : xl * T * z = T * xl * z :=
      calc xl * T * z = xl * hl := by rw [hhz]; group
        _ = hl * xl := hxh
        _ = T * (z * xl) := by rw [hhz]; group
        _ = T * xl * z := by rw [← hzx]; group
    exact mul_right_cancel h1
  have hcC : π₃ xl ∈ toralCentralizer Tag.E6 K₃ (e6RootParams u₃) := by
    refine mem_toralCentralizer.2 ⟨by rw [hπ₃a]; exact (e6Isogeny K₃ xl).2, ?_⟩
    rw [← hπT, ← map_mul, ← hxT, map_mul, mul_inv_cancel_right]
  have hM := mem_toralRootGroup_of_commute_lift_char hℓ3 u₃ ha₃ hcC (hπ₃a xl).symm
    (by rw [← hT]; exact hxT)
  have hM' := SmallQ3.baseChangeGL_mem_toralRootGroup K₃.subtype hM
  rw [hpar] at hM'
  have hbcx : baseChangeGL K₃.subtype (π₃ xl) = D.ι (π xhat) := by
    rw [hιD]
    simp only [hxl, map_mul, map_inv, hπG, hbcπ]
  rw [← hbcx]
  exact hM'

theorem exists_surjective_fixedGroup_oddKernel
    {n : ℕ} (hn : 1 ≤ n) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ n) ^ 2)
    (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ n)
    (ε : ↥(twistedE6RootGroup K σ) ≃* TwE6Delta.RecipeR K n) {L' : Type} [Group L'] [Finite L']
    {ψ : L' →* TwE6Delta.RecipeR K n} (hψ : Function.Surjective ψ)
    (hker : ψ.ker ≤ Subgroup.center L') (hperf : commutator L' = ⊤)
    (hodd : ∀ y ∈ ψ.ker, y ^ 2 = 1 → y = 1) :
    ∃ α : ↥(fixedGroup K σ.toRingHom) →* L', Function.Surjective α ∧
      (∀ u, ψ (α u) = ε (twistedIsogenyC hn hK σ.toRingHom hσ u)) ∧
      α.ker ≤ Subgroup.center ↥(fixedGroup K σ.toRingHom) := by
  classical
  haveI : Finite ↥(fixedGroup K σ.toRingHom) := by
    have : Finite (Module.End K (Fin e6Data.d →₀ K)) := Module.finite_of_finite K
    infer_instance
  haveI : CharP K 2 := CFSG.ClassicalGroups.Unitary.charP_of_card_sq (p := 2) (f := n) hK
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hθ : ∀ c, σ.toRingHom (σ.toRingHom c) = c := fun c =>
    CFSG.SeitzReduction.F4Pilot.involutive_of_natCard_eq (f := n) hK hσ c
  set q : ↥(fixedGroup K σ.toRingHom) →* TwE6Delta.RecipeR K n :=
    ε.toMonoidHom.comp (twistedIsogenyC hn hK σ.toRingHom hσ)
  have hqs : Function.Surjective q :=
    ε.surjective.comp (twistedIsogenyC_surjective hn hK σ.toRingHom hσ)
  have hqZ : ∀ s, q s = 1 → s ∈ Subgroup.center ↥(fixedGroup K σ.toRingHom) := fun s hs => by
    have hs' : ε (twistedIsogenyC hn hK σ.toRingHom hσ s) = 1 := hs
    rw [← ker_twistedIsogenyC hn hK σ.toRingHom hσ, MonoidHom.mem_ker]
    exact (map_eq_one_iff ε ε.injective).1 hs'
  have hsplit : ∀ (E : Type) [Group E] [Finite E] (π : E →* ↥(fixedGroup K σ.toRingHom)),
      Function.Surjective π → π.ker ≤ Subgroup.center E → Nat.Coprime 2 (Nat.card π.ker) →
        ∃ s : ↥(fixedGroup K σ.toRingHom) →* E, ∀ h, π (s h) = h := by
    intro E _ _ π hπ hcen hcop
    exact TwistedE6Closed.twistedE6_exists_section_of_coprime (p := 2) hθ hπ hcen hcop
  obtain ⟨α, hα, hαs⟩ := StdSubRestU.exists_surjective_of_oddKernel hqs hsplit hψ hker hperf hodd
  refine ⟨α, hαs, hα, ?_⟩
  intro s hs
  exact hqZ s (by rw [← hα, MonoidHom.mem_ker.mp hs, map_one])

theorem exists_lift_fixedGroup
    {n : ℕ} (hn : 1 ≤ n) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ n) ^ 2)
    (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ n)
    {q : ↥(fixedGroup K σ.toRingHom) →* TwE6Delta.RecipeR K n} (hq : Function.Surjective q)
    (hqk : q.ker ≤ Subgroup.center ↥(fixedGroup K σ.toRingHom))
    (w : MulAut (TwE6Delta.RecipeR K n)) :
    ∃ φ : MulAut ↥(fixedGroup K σ.toRingHom), ∀ u, q (φ u) = w (q u) := by
  classical
  haveI : Finite ↥(fixedGroup K σ.toRingHom) := by
    have : Finite (Module.End K (Fin e6Data.d →₀ K)) := Module.finite_of_finite K
    infer_instance
  haveI : CharP K 2 := CFSG.ClassicalGroups.Unitary.charP_of_card_sq (p := 2) (f := n) hK
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hθ : ∀ c, σ.toRingHom (σ.toRingHom c) = c := fun c =>
    CFSG.SeitzReduction.F4Pilot.involutive_of_natCard_eq (f := n) hK hσ c
  have hk4 : 4 ≤ Nat.card K := CFSG.SeitzReduction.F4Pilot.four_le_natCard_of_eq hn hK
  have hperf : commutator ↥(fixedGroup K σ.toRingHom) = ⊤ :=
    (CFSG.LieType.Steinberg.TwistedE6.fixedGroup_isPerfect_of_four_le_card σ.toRingHom hθ hk4).commutator_eq_top
  set ψ' : ↥(fixedGroup K σ.toRingHom) →* TwE6Delta.RecipeR K n :=
    w.symm.toMonoidHom.comp q with hψ'
  have hψ's : Function.Surjective ψ' := w.symm.surjective.comp hq
  have hker' : ψ'.ker = q.ker := by
    ext u
    rw [MonoidHom.mem_ker, MonoidHom.mem_ker, hψ', MonoidHom.comp_apply,
      MulEquiv.coe_toMonoidHom]
    exact map_eq_one_iff w.symm w.symm.injective
  have hψ'k : ψ'.ker ≤ Subgroup.center ↥(fixedGroup K σ.toRingHom) := by
    rw [hker']; exact hqk
  have hZ3 : Nat.card (Subgroup.center ↥(fixedGroup K σ.toRingHom)) ∣ 3 := by
    rw [(TwistedE6Closed.card_center_fixedGroup hK hσ).1]
    exact Nat.gcd_dvd_left 3 _
  have hodd : ∀ y ∈ ψ'.ker, y ^ 2 = 1 → y = 1 := by
    intro y hy hy2
    rw [hker'] at hy
    have h1 : orderOf y ∣ 3 :=
      (Subgroup.orderOf_dvd_natCard _ (hqk hy)).trans hZ3
    have hcop : Nat.Coprime (orderOf y) 2 :=
      Nat.Coprime.coprime_dvd_left h1 (by norm_num)
    exact orderOf_eq_one_iff.1 (hcop.eq_one_of_dvd (orderOf_dvd_of_pow_eq_one hy2))
  have hsplit : ∀ (E : Type) [Group E] [Finite E] (π : E →* ↥(fixedGroup K σ.toRingHom)),
      Function.Surjective π → π.ker ≤ Subgroup.center E → Nat.Coprime 2 (Nat.card π.ker) →
        ∃ s : ↥(fixedGroup K σ.toRingHom) →* E, ∀ h, π (s h) = h := by
    intro E _ _ π hπ hcen hcop
    exact TwistedE6Closed.twistedE6_exists_section_of_coprime (p := 2) hθ hπ hcen hcop
  obtain ⟨α, hα, hαs⟩ := StdSubRestU.exists_surjective_of_oddKernel hq hsplit hψ's hψ'k hperf hodd
  have hαi : Function.Injective α := Finite.injective_iff_surjective.2 hαs
  refine ⟨MulEquiv.ofBijective α ⟨hαi, hαs⟩, fun u => ?_⟩
  have h : w.symm (q (α u)) = q u := hα u
  change q (α u) = w (q u)
  rw [← h, MulEquiv.apply_symm_apply]

theorem exists_surjective_fixedGroup_mod_twoPart
    {n : ℕ} (hn : 1 ≤ n) {K : Type} [Field K] [Finite K] (hK : Nat.card K = (2 ^ n) ^ 2)
    (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ n)
    (ε : ↥(twistedE6RootGroup K σ) ≃* TwE6Delta.RecipeR K n)
    {J : Type} [Group J] [Finite J]
    {ψ : J →* TwE6Delta.RecipeR K n} (hψ : Function.Surjective ψ)
    (hker : ψ.ker ≤ Subgroup.center J) (hperf : commutator J = ⊤) :
    ∃ α : ↥(fixedGroup K σ.toRingHom) →*
        J ⧸ TableBU.twoPartOf ψ.ker hker (Nat.card J),
      Function.Surjective α ∧
      (∀ u, QuotientGroup.lift _ ψ (TableBU.twoPartOf_le _ hker _) (α u) =
        ε (twistedIsogenyC hn hK σ.toRingHom hσ u)) ∧
      α.ker ≤ Subgroup.center ↥(fixedGroup K σ.toRingHom) := by
  classical
  set N := TableBU.twoPartOf ψ.ker hker (Nat.card J) with hNdef
  have hNk : N ≤ ψ.ker := TableBU.twoPartOf_le _ hker _
  set π : J →* J ⧸ N := QuotientGroup.mk' N with hπ
  have hπs : Function.Surjective π := QuotientGroup.mk'_surjective N
  set ψb : J ⧸ N →* TwE6Delta.RecipeR K n := QuotientGroup.lift N ψ hNk with hψb
  have hψbπ : ∀ l, ψb (π l) = ψ l := fun l => QuotientGroup.lift_mk N hNk l
  have hψbs : Function.Surjective ψb := by
    intro r
    obtain ⟨l, rfl⟩ := hψ r
    exact ⟨π l, hψbπ l⟩
  have hψbc : ψb.ker ≤ Subgroup.center (J ⧸ N) := by
    intro y hy
    obtain ⟨z, rfl⟩ := hπs y
    have hz' : z ∈ ψ.ker := by
      rw [MonoidHom.mem_ker, ← hψbπ]
      exact hy
    rw [Subgroup.mem_center_iff]
    intro w
    obtain ⟨v, rfl⟩ := hπs w
    rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.mp (hker hz') v]
  have hψbodd : ∀ y ∈ ψb.ker, y ^ 2 = 1 → y = 1 := fun y hy hy2 =>
    TableBU.sq_eq_one_ker_lift hker y hy hy2
  have hperfb : commutator (J ⧸ N) = ⊤ := by
    rw [eq_top_iff]
    intro y _
    obtain ⟨l, rfl⟩ := hπs y
    have hl : l ∈ commutator J := by rw [hperf]; exact Subgroup.mem_top l
    have h1 := Subgroup.mem_map_of_mem π hl
    rwa [commutator_def, Subgroup.map_commutator, ← MonoidHom.range_eq_map,
      MonoidHom.range_eq_top.mpr hπs, ← commutator_def] at h1
  obtain ⟨α, hαs, hα, hαk⟩ :=
    exists_surjective_fixedGroup_oddKernel hn hK σ hσ ε hψbs hψbc hperfb hψbodd
  exact ⟨α, hαs, hα, hαk⟩

theorem center_minBC_eq_center
    {n : ℕ} (hn : 1 ≤ n) {K F : Type} [Field K] [Finite K] [Field F] [Finite F]
    (hK : Nat.card K = (2 ^ n) ^ 2)
    (σ : K ≃+* K) (hσ : ∀ c, σ c = c ^ 2 ^ n)
    (iota : K →+* F)
    (h3 : 3 ∣ 2 ^ n + 1) :
    (Subgroup.center ↥(fixedGroup K σ.toRingHom)).map
      ((minBC e6Data_valid iota).comp (fixedGroup K σ.toRingHom).subtype) =
    Subgroup.center (e6Data_valid.minGroup F) := by
  classical
  let i : ↥(fixedGroup K σ.toRingHom) →* e6Data_valid.minGroup F :=
    (minBC e6Data_valid iota).comp (fixedGroup K σ.toRingHom).subtype
  have hZH : Nat.card (Subgroup.center ↥(fixedGroup K σ.toRingHom)) = 3 := by
    rw [(TwistedE6Closed.card_center_fixedGroup hK hσ).1, Nat.gcd_eq_left h3]
  have hZU : Nat.card (Subgroup.center (e6Data_valid.minGroup F)) ≤ 3 := by
    rw [(card_center_e6 (k := F)).1]
    exact Nat.le_of_dvd (by norm_num) (Nat.gcd_dvd_left 3 _)
  have hle : (Subgroup.center ↥(fixedGroup K σ.toRingHom)).map i ≤
      Subgroup.center (e6Data_valid.minGroup F) := by
    rintro x ⟨z, hz, rfl⟩
    have hzker : z ∈ (twistedIsogenyC hn hK σ.toRingHom hσ).ker := by
      rw [ker_twistedIsogenyC hn hK σ.toRingHom hσ]
      exact hz
    have hz1 : twistedIsogenyC hn hK σ.toRingHom hσ z = 1 := MonoidHom.mem_ker.mp hzker
    have hcoe := CFSG.SeitzReduction.F4Pilot.coe_twistedIsogenyC hn hK σ.toRingHom hσ z
    have h1 : ((e6IsogenyT K (z : e6Data_valid.minGroup K) : adjointGroup TwistTag.E6.tag K) :
        ModGL TwistTag.E6.tag K) = 1 := by
      rw [← hcoe, hz1]
      simp
    have h2 : e6IsogenyT K (z : e6Data_valid.minGroup K) = 1 := by
      apply Subtype.ext
      simpa using h1
    have hz1' : e6Isogeny K (z : e6Data_valid.minGroup K) = 1 := by
      apply Subtype.ext
      exact congrArg Subtype.val h2
    have h1' := e6Isogeny_minBC iota (z : e6Data_valid.minGroup K)
    have h2' : ((e6Isogeny F (minBC e6Data_valid iota (z : e6Data_valid.minGroup K)) :
        adjointGroup Tag.E6 F) : ModGL Tag.E6 F) = 1 := by
      rw [h1', hz1']
      simp
    have h3' : e6Isogeny F (minBC e6Data_valid iota (z : e6Data_valid.minGroup K)) = 1 := by
      apply Subtype.ext
      simpa using h2'
    have h4' : e6IsogenyT F (minBC e6Data_valid iota (z : e6Data_valid.minGroup K)) = 1 := by
      apply Subtype.ext
      exact congrArg Subtype.val h3'
    exact ker_e6IsogenyT_le_center (k := F) (MonoidHom.mem_ker.mpr h4')
  have h_inj : Function.Injective i := by
    intro x y hxy
    apply Subtype.ext
    have h1 : minBC e6Data_valid iota (x : e6Data_valid.minGroup K) =
        minBC e6Data_valid iota (y : e6Data_valid.minGroup K) := by
      apply Subtype.ext
      exact congrArg Subtype.val hxy
    exact CFSG.HardMathSupport.Dickson.LocalTwoBalance.Cross.E6Heis.PairAux.minBC_injective e6Data_valid iota h1
  have hcard : Nat.card ((Subgroup.center ↥(fixedGroup K σ.toRingHom)).map i) = 3 := by
    rw [Subgroup.card_map_of_injective h_inj]
    exact hZH
  exact Subgroup.eq_of_le_of_card_ge hle (by rw [hcard]; exact hZU)
end CFSG.StandardType.KG87B
