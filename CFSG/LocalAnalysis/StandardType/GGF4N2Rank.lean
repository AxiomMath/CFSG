  have hdiv := CFSG.LocalAnalysis.GLTheoremB.MovingAround.Inputs2711c.dvd_of_outer_omegaMinus
    (ggN2Model_of_centralImage hL θ) (by norm_num : Nat.Prime 5) (by norm_num : 5 ≠ 2) hα hout
  norm_num at hdiv

theorem ggF4N2Rank
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hL : GGCentralImage .POmegaMinus 4 2 L) :
    Nat.card Bs = 5 ^ 4 ∧ Nat.card B = 5 ^ 4 ∧ LargeEvenTwoLocalRank 5 G = 4 := by
  obtain ⟨hC, -, hInnerDiagAll, -, -, -⟩ := hR
  have hmark : CFSG.Assembly.LargeEvenMarkingLegacy ↥L (fun _ _ _ I _ θ =>
      Bs ≤ Subgroup.normalizer (L : Set G) ∧
        ∀ b ∈ Bs, ∃ φ ∈ I,
          LargeEvenInduces θ (fun l l' => (l' : G) = b⁻¹ * l * b) φ) :=
    hInnerDiagAll.1
  obtain ⟨hcomm, lab, hlab, hraw⟩ := hmark
  obtain ⟨R, hRgrp, I, F, hsimple, hna, θ, hP⟩ := CFSG.GGQ2Prime.rawDatumLegacy_exists hraw
  let : Group R := hRgrp
  have : Finite R := Finite.of_equiv (↥L ⧸ Subgroup.center ↥L) θ.toEquiv
  have hBsN : Bs ≤ Subgroup.normalizer (L : Set G) := hP.1
  have hBN : B ≤ Subgroup.normalizer (L : Set G) := hC.2.1.1.trans hBsN
  have hβle : (ggBeta L θ hBsN).range ≤ CFSG.Fischer.innerAut R := by
    rintro _ ⟨b, rfl⟩
    have hb5G : ((b : ↥Bs) : G) ^ 5 = 1 := hC.tableB_facts.2.1.2 b b.2
    have hb5 : b ^ 5 = 1 := Subtype.ext (by simpa using hb5G)
    have hpow : (ggBeta L θ hBsN b) ^ 5 = 1 := by
      rw [← map_pow, hb5, map_one]
    exact ggN2Inner_of_fifth hL θ _ hpow
  have hβdvd : Nat.card ↥(ggBeta L θ hBsN).range ∣
      Nat.card (CFSG.Fischer.innerAut R) := by
    have h1 := Subgroup.card_subgroup_dvd_card
      ((ggBeta L θ hBsN).range.subgroupOf (CFSG.Fischer.innerAut R))
    have h2 : Nat.card ↥((ggBeta L θ hBsN).range.subgroupOf
          (CFSG.Fischer.innerAut R)) = Nat.card ↥(ggBeta L θ hBsN).range :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hβle).toEquiv
    rwa [h2] at h1
  have hRdvdL : Nat.card R ∣ Nat.card L := by
    rw [← Nat.card_congr θ.toEquiv]
    exact Subgroup.card_quotient_dvd_card (Subgroup.center L)
  have hnotR : ¬ 5 ^ 4 ∣ Nat.card R := fun h =>
    not_five_pow_four_dvd_centralImage hL (h.trans hRdvdL)
  have hInnerDvd : Nat.card (CFSG.Fischer.innerAut R) ∣ Nat.card R := by
    simpa [CFSG.Fischer.innerAut] using
      Subgroup.card_range_dvd (MulAut.conj : R →* MulAut R)
  have hnotInn : ¬ 5 ^ 4 ∣ Nat.card (CFSG.Fischer.innerAut R) :=
    fun h => hnotR (h.trans hInnerDvd)
  have hBsp : IsPGroup 5 ↥Bs := isPGroup_of_isElemAbelian hC.tableB_facts.2.1
  have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  obtain ⟨m, hm⟩ := hBsp.exists_card_eq
  have hdvd : Nat.card ↥(ggBeta L θ hBsN).range ∣ 5 ^ m := by
    rw [← hm]
    exact Subgroup.card_range_dvd (ggBeta L θ hBsN)
  obtain ⟨n, -, hn⟩ := (Nat.dvd_prime_pow (by norm_num : Nat.Prime 5)).1 hdvd
  have hnotβ : ¬ 5 ^ 4 ∣ Nat.card ↥(ggBeta L θ hBsN).range :=
    fun h => hnotInn (h.trans hβdvd)
  have hnlt : n < 4 := by
    by_contra h
    have h4 : 5 ^ 4 ∣ 5 ^ n := pow_dvd_pow 5 (by omega)
    exact hnotβ (hn ▸ h4)
  have hβ : Nat.card ↥(ggBeta L θ hBsN).range ≤ 5 ^ 3 := by
    rw [hn]
    exact Nat.pow_le_pow_right (by norm_num) (by omega)
  exact card_rank_of_beta_le hC hcomm θ hBN hBsN hβ

section NativeKNormalizer

open CFSG.ClassicalModels CFSG.LocalAnalysis.ComponentInitial.LinearFlag

theorem ggF4N2_psl6_block_torus_data
    {G : Type} [Group G] [Finite G] {K : Subgroup G}
    (hK : GGCentralImage .PSL 6 2 K) :
    ∃ T U : Subgroup G,
      T ≤ K ∧ U ≤ K ∧ T ≠ ⊥ ∧ U ≠ ⊥ ∧
      IsElemAbelian 5 T ∧ Nat.card T = 5 ^ 3 ∧ IsPGroup 2 U ∧
      T ≤ Subgroup.normalizer (U : Set G) ∧
      Disjoint T ((Subgroup.center K).map K.subtype) := by
  classical
  let F := GaloisField 2 2
  let S := Matrix.SpecialLinearGroup (Fin 6) F
  have hF : Nat.card F = 4 := by
    rw [GaloisField.card 2 2 (by norm_num)]
    norm_num
  obtain ⟨ψ, _hadm, hker, hrange⟩ := hK
  let θ : S →* G := ψ
  have hkerθ : θ.ker ≤ Subgroup.center S := by
    change ψ.ker ≤ Subgroup.center S
    exact hker
  have hθrange : θ.range = K := hrange
  have hSperfect : Group.IsPerfect S :=
    specialLinear_isPerfect_of_three_le (K := F) (n := 6) (by norm_num)
  let θK : S →* K := θ.codRestrict K (fun x => by
    rw [← hθrange]
    exact ⟨x, rfl⟩)
  have hθKsurj : Function.Surjective θK := by
    intro k
    have hk : (k : G) ∈ θ.range := by rw [hθrange]; exact k.2
    obtain ⟨x, hx⟩ := hk
    refine ⟨x, Subtype.ext ?_⟩
    exact hx
  have hθKker : θK.ker ≤ Subgroup.center S := by
    intro x hx
    apply hkerθ
    have hx' : θ x = 1 := by
      simpa [θK] using congrArg Subtype.val hx
    simpa [MonoidHom.mem_ker] using hx'
  have hcenterK : (Subgroup.center S).map θK = Subgroup.center K :=
    CFSG.ClassicalInvolution.ModelFacts.UnitaryAut.map_center_eq_center_of_perfect
      hθKsurj hθKker
  let Z : Subgroup G := (Subgroup.center K).map K.subtype
  have hcenterScard : Nat.card (Subgroup.center S) = 3 := by
    rw [← scalars_eq_center, CFSG.LocalAnalysis.ComponentInitial.card_scalars_eq_gcd F (by norm_num : 1 ≤ 6), hF]
    norm_num
  have hcenterKle : Nat.card (Subgroup.center K) ≤ 3 := by
    rw [← hcenterK]
    calc Nat.card ↥(Subgroup.map θK (Subgroup.center S)) ≤
          Nat.card ↥(Subgroup.center S) := by
          change Nat.card (θK '' (Subgroup.center S : Set S)) ≤
            Nat.card ↥(Subgroup.center S)
          exact Nat.card_image_le (s := (Subgroup.center S : Set S)) (f := θK)
            (Set.toFinite _)
      _ = 3 := hcenterScard
  have hcenterS3 : IsPGroup 3 (Subgroup.center S) :=
    IsPGroup.of_card (p := 3) (n := 1) (by rw [hcenterScard]; norm_num)
  have hprojker : (proj 6 F).ker ≤ Subgroup.center S := by
    rw [ker_proj]
    exact scalars_le_center 6 F
  have hprojsurj : Function.Surjective (proj 6 F) := proj_surjective (n := 6) (K := F)
  have hprojcomm : commutator S = ⊤ :=
    specialLinear_commutator_eq_top_of_three_le (K := F) (n := 6) (by norm_num)
  have hlift : GGTorusLift 5 3 (projectiveSL 6 F) :=
    TypeA.ggTorusLift_six_nonsplit (K := F) (p := 5) Nat.prime_five (by decide)
      (by norm_num [hF])
  obtain ⟨U₀, E₀, hU₀, hU₂, hN, hE, hEcard, hEker⟩ :=
    hlift S (proj 6 F) hprojsurj hprojker hprojcomm
  have hEcenter : E₀ ⊓ Subgroup.center S = ⊥ := by
    have h := hEker
    rw [ker_proj, scalars_eq_center] at h
    exact h
  have hUdisjCenter : Disjoint U₀ (Subgroup.center S) :=
    IsPGroup.disjoint_of_ne 2 3 (by decide) U₀ (Subgroup.center S) hU₂ hcenterS3
  have hEψ : E₀ ⊓ θ.ker = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    have hxcenter : x ∈ Subgroup.center S := hkerθ hx.2
    have : x ∈ E₀ ⊓ Subgroup.center S := ⟨hx.1, hxcenter⟩
    simpa [hEcenter] using this
  have hinjE : ∀ x ∈ E₀, ∀ y ∈ E₀, θ x = θ y → x = y := by
    intro x hx y hy hxy
    have hmem : x⁻¹ * y ∈ E₀ ⊓ θ.ker := by
      refine ⟨?_, ?_⟩
      · exact E₀.mul_mem (E₀.inv_mem hx) hy
      · change θ (x⁻¹ * y) = 1
        rw [map_mul, map_inv, hxy, inv_mul_cancel]
    have hbot : x⁻¹ * y ∈ (⊥ : Subgroup S) := by
      rw [← hEψ]
      exact hmem
    have h1 : x⁻¹ * y = 1 := by simpa using hbot
    exact inv_mul_eq_one.mp h1
  have hUmap : U₀.map θ ≠ ⊥ := by
    intro hbot
    have hle : U₀ ≤ θ.ker := (Subgroup.map_eq_bot_iff (H := U₀) (f := θ)).mp hbot
    have hleCenter : U₀ ≤ Subgroup.center S := hle.trans hkerθ
    have hbot : U₀ = ⊥ := by
      have hinf : U₀ ⊓ Subgroup.center S = ⊥ := hUdisjCenter.eq_bot
      apply le_bot_iff.mp
      rw [← hinf]
      exact le_inf le_rfl hleCenter
    exact hU₀ hbot
  let T : Subgroup G := E₀.map θ
  let U : Subgroup G := U₀.map θ
  have hTleK : T ≤ K := by
    rw [← hθrange]
    exact Subgroup.map_le_range θ E₀
  have hUleK : U ≤ K := by
    rw [← hθrange]
    exact Subgroup.map_le_range θ U₀
  have hTelem : IsElemAbelian 5 T := TableB.isElemAbelian_map hE θ
  have hTcard : Nat.card T = 5 ^ 3 := by
    let f : E₀ → T := fun x => ⟨θ x, Subgroup.mem_map_of_mem θ x.2⟩
    have hf_inj : Function.Injective f := by
      intro x y hxy
      have hxy' : θ x = θ y := congrArg Subtype.val hxy
      exact Subtype.ext (hinjE x x.2 y y.2 hxy')
    have hf_surj : Function.Surjective f := by
      rintro ⟨x, hx⟩
      obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hx
      exact ⟨⟨y, hy⟩, rfl⟩
    have e : E₀ ≃ T := Equiv.ofBijective f ⟨hf_inj, hf_surj⟩
    rw [← Nat.card_congr e, hEcard]
  have hTnorm : T ≤ Subgroup.normalizer (U : Set G) :=
    (Subgroup.map_mono hN).trans (Subgroup.le_normalizer_map θ)
  have hTdisj : Disjoint T Z := by
    rw [Subgroup.disjoint_def]
    intro x hxT hxZ
    have hdvdT : Nat.card ↥(T ⊓ Z) ∣ 5 ^ 3 := by
      rw [← hTcard]
      exact Subgroup.card_dvd_of_le inf_le_left
    have hcardZ : Nat.card Z ≤ 3 := by
      change Nat.card ((Subgroup.center K).map K.subtype) ≤ 3
      rw [Subgroup.card_map_of_injective K.subtype_injective]
      exact hcenterKle
    have hle3 : Nat.card ↥(T ⊓ Z) ≤ 3 :=
      (Subgroup.card_le_of_le inf_le_right).trans hcardZ
    obtain ⟨k, hkle, hk⟩ := (Nat.dvd_prime_pow Nat.prime_five).mp hdvdT
    have hk0 : k = 0 := by
      by_contra hk0
      have hk1 : 1 ≤ k := Nat.pos_of_ne_zero hk0
      have h5 : 5 ≤ 5 ^ k := by
        calc 5 = 5 ^ 1 := by norm_num
          _ ≤ 5 ^ k := Nat.pow_le_pow_right (by norm_num) hk1
      omega
    have hbot : T ⊓ Z = ⊥ := by
      apply Subgroup.eq_bot_of_card_eq
      rw [hk, hk0]
      norm_num
    have hxbot : x ∈ (⊥ : Subgroup G) := by
      rw [← hbot]
      exact ⟨hxT, hxZ⟩
    simpa using hxbot

  have hTne : T ≠ ⊥ := by
    intro hbot
    have hc : Nat.card T = 1 := by rw [hbot, Subgroup.card_bot]
    rw [hTcard] at hc
    norm_num at hc
  exact ⟨T, U, hTleK, hUleK, hTne, hUmap, hTelem, hTcard, hU₂.map θ, hTnorm, hTdisj⟩

theorem ggF4N2_pRank_five_centralizer_K_le_one
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {K : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    (hK : GGCentralImage .PSL 6 2 K) :
    CFSG.Open.pRank 5 (Subgroup.centralizer (K : Set G)) ≤ 1 := by
  obtain ⟨T, U, hTleK, hUleK, _, hUne, hTelem, hTcard, hU₂, hTnorm, hTdisj⟩ :=
    ggF4N2_psl6_block_torus_data hK
  exact ggF4N2_pRank_five_centralizer_le_one_of_torus (ggF4N2Rank hR hL).2.2
    hTleK hUleK hTelem hTcard hUne hU₂ hTnorm hTdisj

theorem ggF4N2_sStar_K
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {y : G} {K : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hNbr : GGNbr 5 B x D J y K)
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    (hK : GGCentralImage .PSL 6 2 K) :
    LargeEvenSStar 5 B y K := by
  have hst : LargeEvenStandardType 5 B x L := hR.1.1.2.2.2.2.2.2.2
  have hDJ : LargeEvenStdSub 5 B x L D J := hR.1.2.2
  have hneigh : LargeEvenIsNeighborOf 5 B x L y K := isNeighborOf_of_ggNbr hDJ hNbr
  have hcomp : CFSG.Assembly.IsComponentOf K (Subgroup.centralizer ({y} : Set G)) :=
    (isComponentOf_of_isNeighborOf hst hneigh).1
  have hcyc : ∀ P : Subgroup G,
      P ≤ Subgroup.centralizer (K : Set G) → IsPGroup 5 P → IsCyclic P :=
    CFSG.all_pSubgroups_isCyclic_of_pRank_le_one Nat.prime_five (by norm_num)
      (ggF4N2_pRank_five_centralizer_K_le_one hR hL hK)
  exact ⟨hNbr.1.1, hNbr.1.2.1, hNbr.1.2.2.1, hcomp, hcyc⟩

theorem ggF4N2_centralizer_le_normalizer_of_isComponentOf_of_cyclic
    {G : Type} [Group G] [Finite G] {K E : Subgroup G} {y : G}
    (hcomp : CFSG.Assembly.IsComponentOf K (Subgroup.centralizer ({y} : Set G)))
    (hcyc : ∀ P : Subgroup G,
      P ≤ Subgroup.centralizer (K : Set G) → IsPGroup 5 P → IsCyclic P)
    (hEK : E ≤ K) (hE : IsElemAbelian 5 E) (hEcard : 5 < Nat.card E) :
    Subgroup.centralizer ({y} : Set G) ≤ Subgroup.normalizer (K : Set G) := by
  intro g hg
  exact mem_normalizer_iff_map_conj.mpr
    (ggF4N2_map_conj_eq_of_isComponentOf_of_cyclic hcomp hcyc hEK hE hEcard
      (centralizer_map_conj_of_commute (Subgroup.mem_centralizer_singleton_iff.mp hg)))

theorem ggF4N2_map_conj_K_eq_of_zpowers_eq
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {y : G} {K : Subgroup G} {ν g v : G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hNbr : GGNbr 5 B x D J y K)
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    (hK : GGCentralImage .PSL 6 2 K)
    (hν : Subgroup.zpowers (ν * y * ν⁻¹) = Subgroup.zpowers v)
    (hg : Subgroup.zpowers (g * y * g⁻¹) = Subgroup.zpowers v) :
    K.map (MulAut.conj ν).toMonoidHom = K.map (MulAut.conj g).toMonoidHom := by
  obtain ⟨-, -, -, hcomp, hcyc⟩ := ggF4N2_sStar_K hR hNbr hL hK
  obtain ⟨T, _U, hTleK, _hUleK, _hTne, _hUne, hTelem, hTcard, _hU₂, _hTnorm, _hTdisj⟩ :=
    ggF4N2_psl6_block_torus_data hK
  exact ggF4N2_map_conj_eq_map_conj_of_zpowers_eq hcomp hcyc hTleK hTelem
    (by rw [hTcard]; norm_num) (hν.trans hg.symm)

