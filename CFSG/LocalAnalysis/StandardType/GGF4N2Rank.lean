theorem ggF4N2_pRank_five_centralizer_le_one_of_torus
    {G : Type} [Group G] [Finite G] {K T U : Subgroup G}
    (hrank : LargeEvenTwoLocalRank 5 G = 4)
    (hTleK : T ≤ K) (hUleK : U ≤ K)
    (hTelem : IsElemAbelian 5 T) (hTcard : Nat.card T = 5 ^ 3)
    (hUne : U ≠ ⊥) (hU₂ : IsPGroup 2 U)
    (hTnorm : T ≤ Subgroup.normalizer (U : Set G))
    (hTdisj : Disjoint T ((Subgroup.center K).map K.subtype)) :
    CFSG.Open.pRank 5 (Subgroup.centralizer (K : Set G)) ≤ 1 := by
  have : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  by_contra hle
  have h2 : 2 ≤ CFSG.Open.pRank 5 (Subgroup.centralizer (K : Set G)) := by omega
  obtain ⟨E, hEC, hEelem, hEcard⟩ :=
    CFSG.SectionRank.exists_isElemAbelian_card_of_le_pRank
      (p := 5) (H := Subgroup.centralizer (K : Set G)) (k := 2) h2
  let W : Subgroup G := T ⊔ E
  have hcomm : ∀ a ∈ T, ∀ c ∈ E, a * c = c * a := by
    intro a ha c hc
    exact Subgroup.mem_centralizer_iff.mp (hEC hc) a (hTleK ha)
  have hWelem : IsElemAbelian 5 W := TableB.isElemAbelian_sup hTelem hEelem hcomm
  have hEcentU : E ≤ Subgroup.centralizer (U : Set G) :=
    hEC.trans (Subgroup.centralizer_le (by intro u hu; exact hUleK hu))
  have hWleN : W ≤ Subgroup.normalizer (U : Set G) := by
    refine sup_le hTnorm ?_
    exact hEcentU.trans (Subgroup.centralizer_le_normalizer _)
  have hTwoLocal : IsTwoLocal (Subgroup.normalizer (U : Set G)) :=
    ⟨U, hUne, hU₂, rfl⟩
  have hTEdisj : Disjoint T E := by
    rw [Subgroup.disjoint_def]
    intro z hzT hzE
    have hzK : z ∈ K := hTleK hzT
    have hzZ : z ∈ (Subgroup.center K).map K.subtype := by
      refine Subgroup.mem_map.mpr ⟨⟨z, hzK⟩, ?_, rfl⟩
      rw [Subgroup.mem_center_iff]
      intro k
      exact Subtype.ext (Subgroup.mem_centralizer_iff.mp (hEC hzE) k k.2)
    have hzbot : z ∈ (⊥ : Subgroup G) := by
      rw [← hTdisj.eq_bot]
      exact ⟨hzT, hzZ⟩
    simpa using hzbot
  have hEcentT : E ≤ Subgroup.centralizer (T : Set G) :=
    hEC.trans (Subgroup.centralizer_le (by intro t ht; exact hTleK ht))
  have hEnormT : E ≤ Subgroup.normalizer (T : Set G) :=
    hEcentT.trans (Subgroup.centralizer_le_normalizer _)
  have hWcard : Nat.card W = 5 ^ 5 := by
    change Nat.card ↥(T ⊔ E) = 5 ^ 5
    rw [CFSG.GorensteinWalter.card_sup_eq_mul_of_disjoint_of_le_normalizer T E hEnormT hTEdisj,
      hTcard, hEcard]
    norm_num
  have hcardle := TableB.card_le_of_twoLocal (p := 5) Nat.prime_five hTwoLocal hWleN hWelem
  rw [hWcard, hrank] at hcardle
  norm_num at hcardle

