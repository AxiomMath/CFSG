theorem ggF4N2_B_eq_Bs
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hL : GGCentralImage .POmegaMinus 4 2 L) :
    B = Bs := by
  have hrank := ggF4N2Rank hR hL
  have hBle : B ≤ Bs := hR.1.2.1.1
  exact Subgroup.eq_of_le_of_card_ge hBle (by rw [hrank.2.1, hrank.1])

theorem ggF4N2_Bs_le_normalizer_K
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {y : G} {K : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hNbr : GGNbr 5 B x D J y K)
    (hL : GGCentralImage .POmegaMinus 4 2 L) :
    Bs ≤ Subgroup.normalizer (K : Set G) := by
  have hst : LargeEvenStandardType 5 B x L := hR.1.1.2.2.2.2.2.2.2
  have hDJ : LargeEvenStdSub 5 B x L D J := hR.1.2.2
  have hneigh : LargeEvenIsNeighborOf 5 B x L y K := isNeighborOf_of_ggNbr hDJ hNbr
  have hBN : B ≤ Subgroup.normalizer (K : Set G) :=
    (isComponentOf_of_isNeighborOf hst hneigh).2
  rw [ggF4N2_B_eq_Bs hR hL] at hBN
  exact hBN

theorem ggF4N2_Bs_action_data
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {y : G} {K : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hNbr : GGNbr 5 B x D J y K)
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    (hBsN : Bs ≤ Subgroup.normalizer (K : Set G)) :
    let action : Bs →* MulAut K :=
      K.normalizerMonoidHom.comp (Subgroup.inclusion hBsN)
    action.ker = (Subgroup.zpowers y).subgroupOf Bs ∧
      Nat.card action.range = 5 ^ 3 ∧
      (∀ b : Bs, action b ^ 5 = 1) ∧
      (∀ b : Bs, (b : G) ∉ Subgroup.zpowers y → action b ≠ 1) := by
  let action : Bs →* MulAut K :=
    K.normalizerMonoidHom.comp (Subgroup.inclusion hBsN)
  have hBeq : B = Bs := ggF4N2_B_eq_Bs hR hL
  have hBsElem : IsElemAbelian 5 Bs := hR.1.2.1.2.1
  have hyB : y ∈ B := hNbr.1.2.1
  have hy1 : y ≠ 1 := hNbr.1.2.2.1
  have hyBs : y ∈ Bs := by rw [← hBeq]; exact hyB
  have hyle : Subgroup.zpowers y ≤ Bs := Subgroup.zpowers_le.mpr hyBs
  have hkerCentral : (Subgroup.centralizer (K : Set G)).subgroupOf Bs =
      (Subgroup.zpowers y).subgroupOf Bs := by
    rw [← hBeq, ← inf_centralizer_eq_zpowers_of_sHat hNbr.1]
    ext b
    simp [Subgroup.mem_subgroupOf]
  have hact : action = CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.actK hBsN := rfl
  have hker : action.ker = (Subgroup.zpowers y).subgroupOf Bs := by
    rw [hact, CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.ker_actK]
    exact hkerCentral
  have hkerCard : Nat.card action.ker = 5 := by
    rw [hker]
    calc Nat.card ↥((Subgroup.zpowers y).subgroupOf Bs) =
        Nat.card ↥(Subgroup.zpowers y) :=
          Nat.card_congr (Subgroup.subgroupOfEquivOfLe hyle).toEquiv
      _ = orderOf y := Nat.card_zpowers y
      _ = 5 := orderOf_eq_prime (hBsElem.2 y hyBs) hy1
  have hBscard : Nat.card Bs = 5 ^ 4 := (ggF4N2Rank hR hL).1
  have hinterCard : Nat.card (Bs ⊓ Subgroup.centralizer (K : Set G) : Subgroup G) = 5 := by
    rw [← CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.card_ker_actK hBsN, ← hact]
    exact hkerCard
  have hmul : 5 ^ 4 = 5 * Nat.card action.range := by
    calc 5 ^ 4 = Nat.card Bs := hBscard.symm
      _ = Nat.card (Bs ⊓ Subgroup.centralizer (K : Set G) : Subgroup G) *
            Nat.card (CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.actK hBsN).range :=
          CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.card_range_actK hBsN
      _ = 5 * Nat.card action.range := by rw [hinterCard, hact]
  have hrange : Nat.card action.range = 5 ^ 3 := by
    apply Nat.mul_left_cancel (by norm_num : (0 : ℕ) < 5)
    calc 5 * Nat.card action.range = 5 ^ 4 := hmul.symm
      _ = 5 * 5 ^ 3 := by norm_num
  have hpow : ∀ b : Bs, action b ^ 5 = 1 := by
    intro b
    rw [← map_pow]
    have hb5 : b ^ 5 = 1 := Subtype.ext (hBsElem.2 b b.2)
    rw [hb5, map_one]
  have hnontriv : ∀ b : Bs, (b : G) ∉ Subgroup.zpowers y → action b ≠ 1 := by
    intro b hb h1
    have hbker : b ∈ action.ker := MonoidHom.mem_ker.mpr h1
    rw [hker] at hbker
    exact hb (Subgroup.mem_subgroupOf.mp hbker)
  exact ⟨hker, hrange, hpow, hnontriv⟩

theorem ggF4N2Bstar_split
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hL : GGCentralImage .POmegaMinus 4 2 L) :
    Bs = Subgroup.zpowers x ⊔ (Bs ⊓ L) ∧ Disjoint (Subgroup.zpowers x) (Bs ⊓ L) := by
  have hcfg := hR.1
  have hBsEl : IsElemAbelian 5 Bs := hcfg.2.1.2.1
  have hBsN : Bs ≤ Subgroup.normalizer (L : Set G) := by
    obtain ⟨-, lab, -, hraw⟩ := hR.2.2.1.1
    obtain ⟨R, hgrp, I, F, hs, hn, θ, hP⟩ := CFSG.GGQ2Prime.rawDatumLegacy_exists hraw
    exact hP.1
  have hZ := ggN2Center_eq_bot_of_centralImage hL
  have hcap : L ⊓ Subgroup.centralizer (L : Set G) = ⊥ := by
    apply le_antisymm _ bot_le
    intro g hg
    let gL : L := ⟨g, hg.1⟩
    have hgZ : gL ∈ Subgroup.center L := by
      rw [Subgroup.mem_center_iff]
      intro l
      exact Subtype.ext (Subgroup.mem_centralizer_iff.mp hg.2 l l.2)
    rw [hZ] at hgZ
    exact congrArg Subtype.val (Subgroup.mem_bot.mp hgZ)
  let eQ : (↥L ⧸ Subgroup.center ↥L) ≃* L :=
    (QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot
  have hinn : ∀ b ∈ Bs, ∃ a ∈ L, ∃ c ∈ Subgroup.centralizer (L : Set G), b = a * c := by
    intro b hb
    let bB : Bs := ⟨b, hb⟩
    let α : MulAut L := ggGamma L hBsN bB
    have hα5 : α ^ 5 = 1 := by
      have hb5 : bB ^ 5 = 1 := Subtype.ext (hBsEl.2 b hb)
      rw [← map_pow, hb5, map_one]
    obtain ⟨a, ha⟩ := ggN2Inner_of_fifth hL eQ α hα5
    have hact : ∀ l : L, b * (l : G) * b⁻¹ = (a : G) * l * (a : G)⁻¹ := by
      intro l
      have h := congrArg (fun φ : MulAut L => ((φ l : L) : G)) ha
      simpa [α, bB, ggGamma_coe, MulAut.conj_apply] using h.symm
    refine ⟨a, a.2, (a : G)⁻¹ * b, ?_, by group⟩
    rw [Subgroup.mem_centralizer_iff]
    intro l hl
    symm
    calc ((a : G)⁻¹ * b) * l = (a : G)⁻¹ * (b * l * b⁻¹) * b := by group
      _ = (a : G)⁻¹ * ((a : G) * l * (a : G)⁻¹) * b := by rw [hact ⟨l, hl⟩]
      _ = l * ((a : G)⁻¹ * b) := by group
  have hmax : ∀ F : Subgroup G, (∀ f ∈ F, ∀ g ∈ F, f * g = g * f) →
      (∀ f ∈ F, f ^ 5 = 1) → (∀ f ∈ F, ∀ b ∈ Bs, f * b = b * f) → Bs ≤ F → F ≤ Bs := by
    intro F _ hp hc _ f hf
    exact hcfg.2.1.2.2.2 f
      (Subgroup.mem_centralizer_iff.mpr (fun b hb => (hc f hf b hb).symm)) (hp f hf)
  have hZ5 : ¬ 5 ∣ Nat.card ↥(L ⊓ Subgroup.centralizer (L : Set G)) := by
    rw [hcap, Subgroup.card_bot]
    norm_num
  have hprod := CFSG.RankThree.PartOne.K159.inf_mul_inf_of_inner Nat.prime_five
    (fun a ha b hb => hBsEl.comm ha hb) hBsEl.2 hmax hinn hZ5
  have hB : B = Bs := Subgroup.eq_of_le_of_card_ge hcfg.2.1.1 (by
    have h := ggF4N2Rank hR hL
    rw [h.1, h.2.1])
  obtain ⟨-, -, -, -, -, -, hS, -⟩ := hcfg.1
  have hC : Bs ⊓ Subgroup.centralizer (L : Set G) = Subgroup.zpowers x := by
    rw [← hB]
    exact inf_centralizer_eq_zpowers_of_sstar Nat.prime_five hS
  have hCX : Subgroup.zpowers x ≤ Bs := by
    rw [← hC]
    exact inf_le_left
  have hXC : Subgroup.zpowers x ≤ Subgroup.centralizer (L : Set G) := by
    rw [← hC]
    exact inf_le_right
  refine ⟨le_antisymm ?_ (sup_le hCX inf_le_left), ?_⟩
  · intro b hb
    obtain ⟨a, ha, c, hc, rfl⟩ := hprod b hb
    have hcX : c ∈ Subgroup.zpowers x := by rwa [hC] at hc
    have h1 : Bs ⊓ L ≤ Subgroup.zpowers x ⊔ (Bs ⊓ L) := le_sup_right
    have h2 : Subgroup.zpowers x ≤ Subgroup.zpowers x ⊔ (Bs ⊓ L) := le_sup_left
    exact Subgroup.mul_mem _ (h1 ha) (h2 hcX)
  · rw [disjoint_iff]
    apply le_antisymm _ bot_le
    intro g hg
    have h : g ∈ L ⊓ Subgroup.centralizer (L : Set G) := ⟨hg.2.2, hXC hg.1⟩
    rwa [hcap] at h

theorem ggF4N2Bstar_inf_L_card
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hL : GGCentralImage .POmegaMinus 4 2 L) : Nat.card ↥(Bs ⊓ L) = 5 ^ 3 := by
  obtain ⟨hsplit, hdisj⟩ := ggF4N2Bstar_split hR hL
  obtain ⟨-, -, -, -, -, -, hS, -⟩ := hR.1.1
  have : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  have hBsEl : IsElemAbelian 5 Bs := hR.1.2.1.2.1
  have hxB : x ∈ Bs := hR.1.2.1.1 hS.2.1
  have hxOrder : orderOf x = 5 := orderOf_eq_prime (hBsEl.2 x hxB) hS.2.2.1
  have hXBs : Subgroup.zpowers x ≤ Bs := Subgroup.zpowers_le.mpr hxB
  have hc : ∀ a ∈ Subgroup.zpowers x, ∀ b ∈ Bs ⊓ L, a * b = b * a := by
    intro a ha b hb
    exact hBsEl.comm (hXBs ha) hb.1
  have hcard := CFSG.card_sup_eq_mul_of_commute (Subgroup.zpowers x) (Bs ⊓ L) hc
    (disjoint_iff.mp hdisj)
  rw [← hsplit, (ggF4N2Rank hR hL).1, Nat.card_zpowers,
    hxOrder] at hcard
  omega

theorem ggF4N2Bstar_inf_L_sylow
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    {Rd Ra : Prop} (hR : GGSecFiveRestGen 5 B Bs x L D J Rd Ra)
    (hL : GGCentralImage .POmegaMinus 4 2 L) :
    ∃ P : Sylow 5 L, (P : Subgroup L) = (Bs ⊓ L).subgroupOf L := by
  have : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  let T : Subgroup L := (Bs ⊓ L).subgroupOf L
  have hT : Nat.card T = 5 ^ 3 := by
    rw [show Nat.card T = Nat.card ↥(Bs ⊓ L) from
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe (inf_le_right : Bs ⊓ L ≤ L)).toEquiv]
    exact ggF4N2Bstar_inf_L_card hR hL
  have hind : ¬ 5 ∣ T.index := by
    rintro ⟨k, hk⟩
    apply not_five_pow_four_dvd_centralImage hL
    refine ⟨k, ?_⟩
    rw [← T.card_mul_index, hT, hk]
    ring
  exact ⟨(IsPGroup.of_card hT).toSylow hind, rfl⟩

end

