private theorem not_five_pow_four_dvd_spin :
    ¬ 5 ^ 4 ∣ Nat.card (spinGroup (Spin.quadMinus 4 (GaloisField 2 2)
      (minusCoeffs 2 2).1 (minusCoeffs 2 2).2)) := by
  let K := GaloisField 2 2
  let b := (minusCoeffs 2 2).1
  let c := (minusCoeffs 2 2).2
  have hirr : ∀ s : K, s ^ 2 + b * s + c ≠ 0 := minusCoeffs_irr 2 2
  have hZ : Subgroup.center (spinGroup (Spin.quadMinus 4 K b c)) = ⊥ :=
    PsiDiag.SpinM.center_eq_bot hirr (by norm_num)
  have hcard : Nat.card (spinGroup (Spin.quadMinus 4 K b c)) =
      Nat.card (spinGroup (Spin.quadMinus 4 K b c) ⧸
        Subgroup.center (spinGroup (Spin.quadMinus 4 K b c))) := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup
      (Subgroup.center (spinGroup (Spin.quadMinus 4 K b c))), hZ, Subgroup.card_bot, mul_one]
  have hquot : Nat.card (spinGroup (Spin.quadMinus 4 K b c) ⧸
        Subgroup.center (spinGroup (Spin.quadMinus 4 K b c))) =
      Nat.card (CFSG.Open.StatedProj (CFSG.Open.StatedOmega
        (CFSG.Open.StatedQuadMinus 4 K b c))) :=
    Nat.card_congr (spinQuotientCenterEquivQuadMinus (K := K) (n := 4) (b := b) (c := c)
      (by norm_num) hirr).toEquiv
  have hform := CFSG.Timmesfeld.ClassicalOrders.card_statedProj_statedOmega_quadMinus
    (K := K) (n := 4) (b := b) (c := c) (by norm_num) hirr
  have hK : Nat.card K = 4 := by
    simpa using GaloisField.card 2 2 (by norm_num)
  rw [hK] at hform
  have hform' : (Nat.card (CFSG.Open.StatedProj (CFSG.Open.StatedOmega
        (CFSG.Open.StatedQuadMinus 4 K b c))) : ℤ) =
      (4:ℤ)^12 * ((4:ℤ)^4+1) * ∏ i ∈ Finset.Icc 1 3, ((4:ℤ)^(2*i)-1) := by
    simpa using hform
  have hprod : (∏ i ∈ Finset.Icc 1 3, ((4:ℤ)^(2*i)-1)) =
      (4^2-1)*(4^4-1)*(4^6-1) := by
    norm_num [Finset.prod_Icc_succ_top]
  rw [hprod] at hform'
  have hP : Nat.card (CFSG.Open.StatedProj (CFSG.Open.StatedOmega
        (CFSG.Open.StatedQuadMinus 4 K b c))) =
      4 ^ 12 * (4 ^ 4 + 1) * (4 ^ 2 - 1) * (4 ^ 4 - 1) * (4 ^ 6 - 1) := by
    have h := hform'
    norm_num at h
    exact_mod_cast h
  change ¬ 5 ^ 4 ∣ Nat.card (spinGroup (Spin.quadMinus 4 K b c))
  rw [hcard, hquot, hP]
  norm_num

theorem card_rank_of_beta_le
    {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    (hC : GGConfig 5 B Bs x L D J) (hcomm : commutator L = ⊤)
    {R : Type} [Group R] (θ : ↥L ⧸ Subgroup.center ↥L ≃* R)
    (hBN : B ≤ Subgroup.normalizer (L : Set G))
    (hBsN : Bs ≤ Subgroup.normalizer (L : Set G))
    (hβ : Nat.card ↥(ggBeta L θ hBsN).range ≤ 5 ^ 3) :
    Nat.card Bs = 5 ^ 4 ∧ Nat.card B = 5 ^ 4 ∧ LargeEvenTwoLocalRank 5 G = 4 := by
  have hβm := (card_range_ggBeta_bstar (p := 5) hC hcomm (θ := θ) hBN hBsN).2.2
  have hBsge : 5 ^ 4 ≤ Nat.card Bs := hC.tableB_facts.2.2.2.2
  have hBsle : Nat.card Bs ≤ 5 ^ 4 := by
    calc Nat.card Bs = Nat.card ↥(ggBeta L θ hBsN).range * 5 := hβm.symm
      _ ≤ 5 ^ 3 * 5 := Nat.mul_le_mul_right 5 hβ
      _ = 5 ^ 4 := by norm_num
  have hBs : Nat.card Bs = 5 ^ 4 := le_antisymm hBsle hBsge
  have hBc : Nat.card B = 5 ^ LargeEvenTwoLocalRank 5 G :=
    hC.1.2.2.2.2.2.2.1.1.2.1
  have hBle : Nat.card B ≤ Nat.card Bs := Subgroup.card_le_of_le hC.2.1.1
  have hrank4 : 4 ≤ LargeEvenTwoLocalRank 5 G := (hC.1.2.2.2.2.2.1).2.2.2
  have hB : Nat.card B = 5 ^ 4 := by
    refine le_antisymm ?_ ?_
    · rw [hBs] at hBle; exact hBle
    · rw [hBc]; exact Nat.pow_le_pow_right (by norm_num) hrank4
  refine ⟨hBs, hB, ?_⟩
  rw [hBc] at hB
  exact Nat.pow_right_injective (by norm_num : 2 ≤ 5) hB

theorem ggF4N2_map_conj_eq_of_isComponentOf_of_cyclic
    {G : Type} [Group G] [Finite G] {K E : Subgroup G} {y a : G}
    (hcomp : CFSG.Assembly.IsComponentOf K (Subgroup.centralizer ({y} : Set G)))
    (hcyc : ∀ P : Subgroup G,
      P ≤ Subgroup.centralizer (K : Set G) → IsPGroup 5 P → IsCyclic P)
    (hEK : E ≤ K) (hE : IsElemAbelian 5 E) (hEcard : 5 < Nat.card E)
    (hCy : (Subgroup.centralizer ({y} : Set G)).map (MulAut.conj a).toMonoidHom =
      Subgroup.centralizer ({y} : Set G)) :
    K.map (MulAut.conj a).toMonoidHom = K := by
  have hcompK' : CFSG.Assembly.IsComponentOf (K.map (MulAut.conj a).toMonoidHom)
      (Subgroup.centralizer ({y} : Set G)) := by
    have h1 := CFSG.LocalAnalysis.ComponentInitial.isComponentOf_map_conj hcomp a
    rwa [hCy] at h1
  rcases CFSG.LocalAnalysis.ComponentInitial.isComponentOf_eq_or_commute hcompK' hcomp with
    hEq | hComm
  · exact hEq
  · exfalso
    have hf : Function.Injective (MulAut.conj a).toMonoidHom := (MulAut.conj a).injective
    have hK'cent : K.map (MulAut.conj a).toMonoidHom ≤ Subgroup.centralizer (K : Set G) :=
      Subgroup.commutator_eq_bot_iff_le_centralizer.mp hComm
    have hEp : IsPGroup 5 E := fun e => ⟨1, Subtype.ext (by simpa using hE.2 e e.2)⟩
    have hEgc : IsCyclic (E.map (MulAut.conj a).toMonoidHom) :=
      hcyc _ ((Subgroup.map_mono hEK).trans hK'cent) (hEp.map _)
    have hcycE : IsCyclic E := (Subgroup.equivMapOfInjective E _ hf).isCyclic.mpr hEgc
    have hexp : Monoid.exponent E ∣ 5 :=
      Monoid.exponent_dvd_of_forall_pow_eq_one fun e => Subtype.ext (by simpa using hE.2 e e.2)
    rw [IsCyclic.exponent_eq_card] at hexp
    have hle : Nat.card E ≤ 5 := Nat.le_of_dvd (by norm_num) hexp
    omega

theorem ggF4N2_map_conj_eq_map_conj_of_zpowers_eq
    {G : Type} [Group G] [Finite G] {K E : Subgroup G} {y ν g : G}
    (hcomp : CFSG.Assembly.IsComponentOf K (Subgroup.centralizer ({y} : Set G)))
    (hcyc : ∀ P : Subgroup G,
      P ≤ Subgroup.centralizer (K : Set G) → IsPGroup 5 P → IsCyclic P)
    (hEK : E ≤ K) (hE : IsElemAbelian 5 E) (hEcard : 5 < Nat.card E)
    (hνg : Subgroup.zpowers (ν * y * ν⁻¹) = Subgroup.zpowers (g * y * g⁻¹)) :
    K.map (MulAut.conj ν).toMonoidHom = K.map (MulAut.conj g).toMonoidHom := by
  have hay : Subgroup.zpowers (g⁻¹ * ν * y * (g⁻¹ * ν)⁻¹) = Subgroup.zpowers y := by
    have h := congrArg (Subgroup.map (MulAut.conj g⁻¹).toMonoidHom) hνg
    simp only [MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at h
    simpa [mul_assoc] using h
  have hKa : K.map (MulAut.conj (g⁻¹ * ν)).toMonoidHom = K :=
    ggF4N2_map_conj_eq_of_isComponentOf_of_cyclic hcomp hcyc hEK hE hEcard (by
      rw [CFSG.LocalAnalysis.ComponentInitial.map_conj_centralizer_singleton,
        centralizer_singleton_eq_of_zpowers_eq hay])
  calc K.map (MulAut.conj ν).toMonoidHom
      = (K.map (MulAut.conj (g⁻¹ * ν)).toMonoidHom).map (MulAut.conj g).toMonoidHom := by
        rw [Subgroup.map_map]
        congr 1
        ext c
        simp [mul_assoc]
    _ = K.map (MulAut.conj g).toMonoidHom := by rw [hKa]

theorem not_five_pow_four_dvd_centralImage
    {G : Type} [Group G] {L : Subgroup G}
    (hL : GGCentralImage .POmegaMinus 4 2 L) :
    ¬ 5 ^ 4 ∣ Nat.card L := by
  obtain ⟨ψ, -, -, hrange⟩ := hL
  have hS : ¬ 5 ^ 4 ∣ Nat.card (ggU .POmegaMinus 4 2).K := by
    change ¬ 5 ^ 4 ∣ Nat.card (spinGroup (Spin.quadMinus 4 (GaloisField 2 2)
      (minusCoeffs 2 2).1 (minusCoeffs 2 2).2))
    exact not_five_pow_four_dvd_spin
  have hdvd : Nat.card L ∣ Nat.card (ggU .POmegaMinus 4 2).K := by
    simpa [hrange] using Subgroup.card_range_dvd ψ
  exact fun h => hS (h.trans hdvd)

theorem ggN2Center_eq_bot_of_centralImage {G : Type} [Group G] {L : Subgroup G}
    (hL : GGCentralImage .POmegaMinus 4 2 L) : Subgroup.center L = ⊥ := by
  obtain ⟨ψ, _, hker, hrange⟩ := hL
  let F := GaloisField 2 2
  let b : F := (minusCoeffs 2 2).1
  let c : F := (minusCoeffs 2 2).2
  let S := spinGroup (quadMinus 4 F b c)
  have hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0 := minusCoeffs_irr 2 2
  have hZ : Subgroup.center S = ⊥ := PsiDiag.SpinM.center_eq_bot hirr (by norm_num)
  have hker' : ψ.ker = ⊥ := le_antisymm (hker.trans_eq hZ) bot_le
  have hinj : Function.Injective ψ := (MonoidHom.ker_eq_bot_iff ψ).mp hker'
  let e : S ≃* L := (MonoidHom.ofInjective hinj).trans (MulEquiv.subgroupCongr hrange)
  have h := Subgroup.map_center_eq e
  rw [hZ, Subgroup.map_bot] at h
  exact h.symm

theorem ggN2Model_of_centralImage {G : Type} [Group G] {L : Subgroup G}
    (hL : GGCentralImage .POmegaMinus 4 2 L)
    {R : Type} [Group R] (θ : (↥L ⧸ Subgroup.center ↥L) ≃* R) :
    StatedClassicalModel R .POmegaMinus 4 2 2 := by
  classical
  obtain ⟨ψ, hadm, hker, hrange⟩ := hL
  let F := GaloisField 2 2
  let b : F := (minusCoeffs 2 2).1
  let c : F := (minusCoeffs 2 2).2
  let S := spinGroup (quadMinus 4 F b c)
  have hirr : ∀ s : F, s ^ 2 + b * s + c ≠ 0 := minusCoeffs_irr 2 2
  have hZ : Subgroup.center S = ⊥ := PsiDiag.SpinM.center_eq_bot hirr (by norm_num)
  have hker' : ψ.ker = ⊥ := le_antisymm (hker.trans_eq hZ) bot_le
  have hinj : Function.Injective ψ := (MonoidHom.ker_eq_bot_iff ψ).mp hker'
  let e : S ≃* ↥L := (MonoidHom.ofInjective hinj).trans (MulEquiv.subgroupCongr hrange)
  let eC : (↥L ⧸ Subgroup.center ↥L) ≃* (S ⧸ Subgroup.center S) :=
    QuotientGroup.congr (Subgroup.center ↥L) (Subgroup.center S) e.symm
      (Subgroup.map_center_eq e.symm)
  refine ⟨hadm, F, inferInstance, inferInstance, ?_, b, c, hirr, ?_⟩
  · exact GaloisField.card 2 2 (by norm_num)
  · exact ⟨θ.symm.trans (eC.trans (spinQuotientCenterEquivQuadMinus (by norm_num) hirr))⟩

theorem ggN2Inner_of_fifth {G : Type} [Group G] {L : Subgroup G}
