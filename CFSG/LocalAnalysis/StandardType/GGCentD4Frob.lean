variable {L : Type} [Field L]

private theorem frobShapeAux_d4Q_mul_x (i : Fin Tag.D4.rank) (c : L) :
    d4Q L * xUnit Tag.D4 L i c * (d4Q L)⁻¹ = xUnit Tag.D4 L (d4Swap i) c := by
  refine Units.ext ?_
  simp only [Units.val_mul, Units.val_inv, coe_xUnit]
  have h1 := labelMap_mul_xOp L (π := d4Swap) (hπ := d4Swap_cartan) i c
  change (d4Q L : Module.End L (RootModule Tag.D4 L)) * xOp Tag.D4 L i c =
    xOp Tag.D4 L (d4Swap i) c * (d4Q L : Module.End L (RootModule Tag.D4 L)) at h1
  rw [h1, mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, mul_one]
  rfl

private theorem frobShapeAux_d4Q_mul_y (i : Fin Tag.D4.rank) (c : L) :
    d4Q L * yUnit Tag.D4 L i c * (d4Q L)⁻¹ = yUnit Tag.D4 L (d4Swap i) c := by
  refine Units.ext ?_
  simp only [Units.val_mul, Units.val_inv, coe_yUnit]
  have h1 := labelMap_mul_yOp L (π := d4Swap) (hπ := d4Swap_cartan) i c
  change (d4Q L : Module.End L (RootModule Tag.D4 L)) * yOp Tag.D4 L i c =
    yOp Tag.D4 L (d4Swap i) c * (d4Q L : Module.End L (RootModule Tag.D4 L)) at h1
  rw [h1, mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, mul_one]
  rfl

private theorem frobShapeAux_d4Q_pow_x (s : ℕ) (i : Fin Tag.D4.rank) (c : L) :
    d4Q L ^ s * xUnit Tag.D4 L i c * (d4Q L ^ s)⁻¹ =
      xUnit Tag.D4 L ((d4Swap ^ s) i) c := by
  induction s generalizing i with
  | zero =>
    have h0 : (d4Swap ^ (0 : ℕ)) i = i := rfl
    rw [h0]
    simp
  | succ s ih =>
    calc d4Q L ^ (s + 1) * xUnit Tag.D4 L i c * (d4Q L ^ (s + 1))⁻¹
        = d4Q L ^ s * (d4Q L * xUnit Tag.D4 L i c * (d4Q L)⁻¹) *
            (d4Q L ^ s)⁻¹ := by
          rw [pow_succ, mul_inv_rev]
          group
      _ = d4Q L ^ s * xUnit Tag.D4 L (d4Swap i) c * (d4Q L ^ s)⁻¹ := by
          rw [frobShapeAux_d4Q_mul_x]
      _ = xUnit Tag.D4 L ((d4Swap ^ s) (d4Swap i)) c := ih (d4Swap i)
      _ = xUnit Tag.D4 L ((d4Swap ^ (s + 1)) i) c := by
          rw [pow_succ]
          rfl

private theorem frobShapeAux_d4Q_pow_y (s : ℕ) (i : Fin Tag.D4.rank) (c : L) :
    d4Q L ^ s * yUnit Tag.D4 L i c * (d4Q L ^ s)⁻¹ =
      yUnit Tag.D4 L ((d4Swap ^ s) i) c := by
  induction s generalizing i with
  | zero =>
    have h0 : (d4Swap ^ (0 : ℕ)) i = i := rfl
    rw [h0]
    simp
  | succ s ih =>
    calc d4Q L ^ (s + 1) * yUnit Tag.D4 L i c * (d4Q L ^ (s + 1))⁻¹
        = d4Q L ^ s * (d4Q L * yUnit Tag.D4 L i c * (d4Q L)⁻¹) *
            (d4Q L ^ s)⁻¹ := by
          rw [pow_succ, mul_inv_rev]
          group
      _ = d4Q L ^ s * yUnit Tag.D4 L (d4Swap i) c * (d4Q L ^ s)⁻¹ := by
          rw [frobShapeAux_d4Q_mul_y]
      _ = yUnit Tag.D4 L ((d4Swap ^ s) (d4Swap i)) c := ih (d4Swap i)
      _ = yUnit Tag.D4 L ((d4Swap ^ (s + 1)) i) c := by
          rw [pow_succ]
          rfl

private theorem frobShapeAux_d4PQ_x (r s : ℕ) (i : Fin Tag.D4.rank) (c : L) :
    (d4P L ^ r * d4Q L ^ s) * xUnit Tag.D4 L i c * (d4P L ^ r * d4Q L ^ s)⁻¹ =
      xUnit Tag.D4 L ((TwistTag.D4.perm ^ r) ((d4Swap ^ s) i)) c := by
  have hP : d4P L ^ r * xUnit Tag.D4 L ((d4Swap ^ s) i) c * (d4P L ^ r)⁻¹ =
      xUnit Tag.D4 L ((TwistTag.D4.perm ^ r) ((d4Swap ^ s) i)) c :=
    diagramMap_pow_mul_xUnit_mul_inv (t := TwistTag.D4) L r ((d4Swap ^ s) i) c
  calc (d4P L ^ r * d4Q L ^ s) * xUnit Tag.D4 L i c * (d4P L ^ r * d4Q L ^ s)⁻¹
      = d4P L ^ r * (d4Q L ^ s * xUnit Tag.D4 L i c * (d4Q L ^ s)⁻¹) *
          (d4P L ^ r)⁻¹ := by group
    _ = d4P L ^ r * xUnit Tag.D4 L ((d4Swap ^ s) i) c * (d4P L ^ r)⁻¹ := by
        rw [frobShapeAux_d4Q_pow_x]
    _ = xUnit Tag.D4 L ((TwistTag.D4.perm ^ r) ((d4Swap ^ s) i)) c := hP

private theorem frobShapeAux_d4PQ_y (r s : ℕ) (i : Fin Tag.D4.rank) (c : L) :
    (d4P L ^ r * d4Q L ^ s) * yUnit Tag.D4 L i c * (d4P L ^ r * d4Q L ^ s)⁻¹ =
      yUnit Tag.D4 L ((TwistTag.D4.perm ^ r) ((d4Swap ^ s) i)) c := by
  have hP : d4P L ^ r * yUnit Tag.D4 L ((d4Swap ^ s) i) c * (d4P L ^ r)⁻¹ =
      yUnit Tag.D4 L ((TwistTag.D4.perm ^ r) ((d4Swap ^ s) i)) c :=
    diagramMap_pow_mul_yUnit_mul_inv (t := TwistTag.D4) L r ((d4Swap ^ s) i) c
  calc (d4P L ^ r * d4Q L ^ s) * yUnit Tag.D4 L i c * (d4P L ^ r * d4Q L ^ s)⁻¹
      = d4P L ^ r * (d4Q L ^ s * yUnit Tag.D4 L i c * (d4Q L ^ s)⁻¹) *
          (d4P L ^ r)⁻¹ := by group
    _ = d4P L ^ r * yUnit Tag.D4 L ((d4Swap ^ s) i) c * (d4P L ^ r)⁻¹ := by
        rw [frobShapeAux_d4Q_pow_y]
    _ = yUnit Tag.D4 L ((TwistTag.D4.perm ^ r) ((d4Swap ^ s) i)) c := hP

