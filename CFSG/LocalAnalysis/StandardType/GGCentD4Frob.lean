private theorem frobShapeAux_rho_inner {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup .E6 L p₀) (a : Fin Tag.E6.rank → Lˣ)
    (hT : rootDiagUnit .E6 a ∈ S.D.torus) (v : WeylGroup .E6)
    (hv : rootCharKernel a = (fun α => v • α) '' parabolicRoots .E6 (d4Nodes .E6))
    {w : WeylGroup .E6} (hρw : ∀ γ, IsRoot .E6 γ → S.ρ γ = w • γ) :
    ∃ u ∈ parabolicWeylGroup .E6 (d4Nodes .E6), ∃ π : Equiv.Perm (Fin Tag.E6.rank),
      IsD4LeafPerm π ∧ ∀ j ∈ d4Nodes .E6,
        S.ρ (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) =
          v • (u • (Pi.single (π j) 1 : Fin Tag.E6.rank → ℤ)) := by
  classical
  have hsingle : ∀ j ∈ d4Nodes .E6,
      (Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈
        parabolicRoots .E6 (d4Nodes .E6) := by
    intro j hj
    refine ⟨isRoot_single .E6 j, fun i hi => ?_⟩
    have hij : i ≠ j := fun h => hi (h ▸ hj)
    exact Pi.single_eq_of_ne hij 1
  have hmaps : MapsJ .E6 (d4Set .E6) (v⁻¹ * w * v) := by
    intro α hα
    have h1 : v • α ∈ rootCharKernel a := by
      rw [hv]
      exact ⟨α, hα, rfl⟩
    have h2 : S.ρ (v • α) ∈ rootCharKernel a :=
      CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.rho_mem_kernelRoots_of_mem_torus
        (S := S) (a := a) hT _ h1
    rw [hρw _ ((isRoot_smul_iff v).2 hα.1)] at h2
    rw [hv] at h2
    obtain ⟨β, hβ, hβe⟩ := h2
    have h3 : (v⁻¹ * w * v) • α = β := by
      rw [mul_smul, mul_smul, ← hβe, inv_smul_smul]
    rw [h3]
    exact hβ
  obtain ⟨u, hu, w₀, hw₀, π, hπ, hπact⟩ := exists_d4_action d4Base_E6 hmaps
  refine ⟨u, hu, π, hπ, fun j hj => ?_⟩
  have hmem : (Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈
      parabolicRoots .E6 (d4Nodes .E6) := hsingle j hj
  have e : S.ρ (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) =
      w • (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) := by
    rw [hρw _ ((isRoot_smul_iff v).2 (isRoot_single .E6 j))]
  calc S.ρ (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) =
      w • (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) := e
    _ = (w * v) • (Pi.single j 1 : Fin Tag.E6.rank → ℤ) :=
        (mul_smul w v (Pi.single j 1 : Fin Tag.E6.rank → ℤ)).symm
    _ = (v * (v⁻¹ * w * v)) • (Pi.single j 1 : Fin Tag.E6.rank → ℤ) := by
        rw [show w * v = v * (v⁻¹ * w * v) by group]
    _ = v • ((v⁻¹ * w * v) • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) :=
        mul_smul v (v⁻¹ * w * v) (Pi.single j 1 : Fin Tag.E6.rank → ℤ)
    _ = v • ((u * w₀) • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) := by rw [hw₀]
    _ = v • (u • (w₀ • (Pi.single j 1 : Fin Tag.E6.rank → ℤ))) := by rw [mul_smul]
    _ = v • (u • (Pi.single (π j) 1 : Fin Tag.E6.rank → ℤ)) := by rw [hπact j hj]

private theorem frobShapeAux_rho_graph {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ}
    (S : LangSetup .E6 L p₀) (a : Fin Tag.E6.rank → Lˣ)
    (hT : rootDiagUnit .E6 a ∈ S.D.torus) (v : WeylGroup .E6)
    (hv : rootCharKernel a = (fun α => v • α) '' parabolicRoots .E6 (d4Nodes .E6))
    {w : WeylGroup .E6} (hρw : ∀ γ, IsRoot .E6 γ →
      S.ρ γ = w • permLattice e6Graph γ) :
    ∃ u ∈ parabolicWeylGroup .E6 (d4Nodes .E6), ∃ π : Equiv.Perm (Fin Tag.E6.rank),
      IsD4LeafPerm π ∧ ∀ j ∈ d4Nodes .E6,
        S.ρ (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) =
          v • (u • (Pi.single (π j) 1 : Fin Tag.E6.rank → ℤ)) := by
  classical
  have hsingle : ∀ j ∈ d4Nodes .E6,
      (Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈
        parabolicRoots .E6 (d4Nodes .E6) := by
    intro j hj
    refine ⟨isRoot_single .E6 j, fun i hi => ?_⟩
    have hij : i ≠ j := fun h => hi (h ▸ hj)
    exact Pi.single_eq_of_ne hij 1
  have hσσ : ∀ x : Fin Tag.E6.rank → ℤ,
      permLattice e6Graph (permLattice e6Graph x) = x := fun x => by
    rw [← permLattice_mul, e6Graph_mul_self]
    rfl
  have hσpar : ∀ α ∈ parabolicRoots .E6 (d4Nodes .E6),
      permLattice e6Graph α ∈ parabolicRoots .E6 (d4Nodes .E6) := by
    intro α hα
    refine ⟨hα.1.permLattice e6Graph_cartan, fun k hk => ?_⟩
    exact hα.2 _ ((e6Graph_on_d4 k).2 hk).1
  set w' : WeylGroup .E6 := v⁻¹ * w * e6WeylTwist v with hw'
  have hθ : ∀ α ∈ parabolicRoots .E6 (d4Nodes .E6),
      v⁻¹ • S.ρ (v • α) = w' • permLattice e6Graph α := by
    intro α hα
    rw [hρw _ ((isRoot_smul_iff v).2 hα.1), ← e6WeylTwist_smul v α, hw']
    simp only [mul_smul]
  have hθmem : ∀ α ∈ parabolicRoots .E6 (d4Nodes .E6),
      v⁻¹ • S.ρ (v • α) ∈ parabolicRoots .E6 (d4Nodes .E6) := by
    intro α hα
    have h1 : v • α ∈ rootCharKernel a := by
      rw [hv]
      exact ⟨α, hα, rfl⟩
    have h2 : S.ρ (v • α) ∈ rootCharKernel a :=
      CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.rho_mem_kernelRoots_of_mem_torus
        (S := S) (a := a) hT _ h1
    rw [hv] at h2
    obtain ⟨β, hβ, hβe⟩ := h2
    rw [← hβe, inv_smul_smul]
    exact hβ
  have hmaps : MapsJ .E6 (d4Set .E6) w' := by
    intro α hα
    have h1 := hθ (permLattice e6Graph α) (hσpar α hα)
    rw [hσσ] at h1
    rw [← h1]
    exact hθmem _ (hσpar α hα)
  obtain ⟨u, hu, w₀, hw₀, π', hπ', hw₀π⟩ := exists_d4_action d4Base_E6 hmaps
  set π : Equiv.Perm (Fin Tag.E6.rank) :=
    π' * Equiv.swap (e6Idx (τ := Tag.E6) 2) (e6Idx 4) with hπ
  have hπleaf : IsD4LeafPerm π := isD4LeafPerm_mul_swap hπ'
  have hlin : ∀ α ∈ parabolicRoots .E6 (d4Nodes .E6),
      w₀ • permLattice e6Graph α = permLattice π α := by
    intro α hα
    have h1 := smul_eq_of_simple (w := w₀) (u := 1) (π := π') (J := d4Set .E6)
      (fun j hj => by rw [one_smul]; exact hw₀π j hj) (hσpar α hα).2
    rw [one_smul] at h1
    rw [h1, hπ, permLattice_mul]
    congr 1
    funext k
    simp only [permLattice, Function.comp]
    by_cases hk : 1 ≤ k.val ∧ k.val ≤ 4
    · rw [((e6Graph_on_d4 k).1 hk).2.1]
    · rw [hα.2 _ ((e6Graph_on_d4 k).2 hk).1, hα.2 _ ((e6Graph_on_d4 k).2 hk).2]
  refine ⟨u, hu, π, hπleaf, fun j hj => ?_⟩
  have hmem : (Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈
      parabolicRoots .E6 (d4Nodes .E6) := hsingle j hj
  have hθ' : v⁻¹ • S.ρ (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) =
      u • permLattice π (Pi.single j 1 : Fin Tag.E6.rank → ℤ) := by
    rw [hθ _ hmem, hw₀, mul_smul, hlin _ hmem]
  calc S.ρ (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ))
      = v • (v⁻¹ • S.ρ (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ))) :=
        (smul_inv_smul v _).symm
    _ = v • (u • permLattice π (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) := by rw [hθ']
    _ = v • (u • (Pi.single (π j) 1 : Fin Tag.E6.rank → ℤ)) := by rw [permLattice_single]

private theorem frobShapeAux_perm_cover {π : Equiv.Perm (Fin Tag.E6.rank)}
    (hπ : IsD4LeafPerm π) :
    ∃ r : ℕ, r < 3 ∧ ∃ s : ℕ, s < 2 ∧ ∀ k : Fin Tag.D4.rank,
      d4Idx ((TwistTag.D4.perm ^ r) ((d4Swap ^ s) k)) = π (d4Idx k) := by
  rcases hπ with h | h | h | h | h | h <;> rw [h]
  · exact ⟨0, by norm_num, 0, by norm_num, fun k => by revert k; decide +kernel⟩
  · exact ⟨1, by norm_num, 1, by norm_num, fun k => by revert k; decide +kernel⟩
  · exact ⟨2, by norm_num, 1, by norm_num, fun k => by revert k; decide +kernel⟩
  · exact ⟨0, by norm_num, 1, by norm_num, fun k => by revert k; decide +kernel⟩
  · exact ⟨1, by norm_num, 0, by norm_num, fun k => by revert k; decide +kernel⟩
  · exact ⟨2, by norm_num, 0, by norm_num, fun k => by revert k; decide +kernel⟩

