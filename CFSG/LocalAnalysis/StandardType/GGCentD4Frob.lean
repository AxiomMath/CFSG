variable {L : Type} [Field L] [IsAlgClosed L] [CharP L 2] {p₀ : ℕ}

private theorem frobShapeAux_step_x (S : LangSetup .E6 L p₀) {v u : WeylGroup .E6}
    {j : Fin Tag.E6.rank} {π : Equiv.Perm (Fin Tag.E6.rank)}
    (hact : S.ρ (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) =
      v • (u • (Pi.single (π j) 1 : Fin Tag.E6.rank → ℤ)))
    (c : L) :
    S.D.step (canonicalRep (coxeterSystem .E6) L v * xUnit .E6 L j c *
        (canonicalRep (coxeterSystem .E6) L v)⁻¹) =
      (canonicalRep (coxeterSystem .E6) L v * canonicalRep (coxeterSystem .E6) L u *
          (canonicalRep (coxeterSystem .E6) L v)⁻¹) *
        (canonicalRep (coxeterSystem .E6) L v * xUnit .E6 L (π j) (c ^ S.D.q) *
          (canonicalRep (coxeterSystem .E6) L v)⁻¹) *
        (canonicalRep (coxeterSystem .E6) L v * canonicalRep (coxeterSystem .E6) L u *
          (canonicalRep (coxeterSystem .E6) L v)⁻¹)⁻¹ := by
  set nv := canonicalRep (coxeterSystem .E6) L v with hnv
  set nu := canonicalRep (coxeterSystem .E6) L u with hnu
  have h2 : (2 : L) = 0 := CharP.cast_eq_zero L 2
  have hg : nv * xUnit .E6 L j c * nv⁻¹ =
      pinnedX .E6 L (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) c := by
    rw [hnv, ← pinnedX_single .E6 L j c]
    exact canonicalRep_mul_pinnedX_mul_inv_of_two h2 v (isRoot_single .E6 j) c
  have hPv : pinnedX .E6 L (v • (u • (Pi.single (π j) 1 : Fin Tag.E6.rank → ℤ)))
        (c ^ S.D.q) =
      nv * pinnedX .E6 L (u • (Pi.single (π j) 1 : Fin Tag.E6.rank → ℤ)) (c ^ S.D.q) *
        nv⁻¹ := by
    rw [hnv]
    exact (canonicalRep_mul_pinnedX_mul_inv_of_two h2 v
      (IsRoot.smul (isRoot_single .E6 (π j)) u) (c ^ S.D.q)).symm
  have hPu : pinnedX .E6 L (u • (Pi.single (π j) 1 : Fin Tag.E6.rank → ℤ)) (c ^ S.D.q) =
      nu * xUnit .E6 L (π j) (c ^ S.D.q) * nu⁻¹ := by
    rw [hnu, ← pinnedX_single .E6 L (π j) (c ^ S.D.q)]
    exact (canonicalRep_mul_pinnedX_mul_inv_of_two h2 u (isRoot_single .E6 (π j))
      (c ^ S.D.q)).symm
  rw [hg, CFSG.StandardType.LangRat.step_pinnedX_of_charTwo S
    (IsRoot.smul (isRoot_single .E6 j) v) c, hact, hPv, hPu]
  group

private theorem frobShapeAux_step_y (S : LangSetup .E6 L p₀) {v u : WeylGroup .E6}
    {j : Fin Tag.E6.rank} {π : Equiv.Perm (Fin Tag.E6.rank)}
    (hact : S.ρ (v • (-(Pi.single j 1) : Fin Tag.E6.rank → ℤ)) =
      v • (u • (-(Pi.single (π j) 1) : Fin Tag.E6.rank → ℤ)))
    (c : L) :
    S.D.step (canonicalRep (coxeterSystem .E6) L v * yUnit .E6 L j c *
        (canonicalRep (coxeterSystem .E6) L v)⁻¹) =
      (canonicalRep (coxeterSystem .E6) L v * canonicalRep (coxeterSystem .E6) L u *
          (canonicalRep (coxeterSystem .E6) L v)⁻¹) *
        (canonicalRep (coxeterSystem .E6) L v * yUnit .E6 L (π j) (c ^ S.D.q) *
          (canonicalRep (coxeterSystem .E6) L v)⁻¹) *
        (canonicalRep (coxeterSystem .E6) L v * canonicalRep (coxeterSystem .E6) L u *
          (canonicalRep (coxeterSystem .E6) L v)⁻¹)⁻¹ := by
  set nv := canonicalRep (coxeterSystem .E6) L v with hnv
  set nu := canonicalRep (coxeterSystem .E6) L u with hnu
  have h2 : (2 : L) = 0 := CharP.cast_eq_zero L 2
  have hg : nv * yUnit .E6 L j c * nv⁻¹ =
      pinnedX .E6 L (v • (-(Pi.single j 1) : Fin Tag.E6.rank → ℤ)) c := by
    rw [hnv, ← pinnedX_neg_single .E6 L j c]
    exact canonicalRep_mul_pinnedX_mul_inv_of_two h2 v
      (isRoot_neg_single .E6 j) c
  have hPv : pinnedX .E6 L (v • (u • (-(Pi.single (π j) 1) :
        Fin Tag.E6.rank → ℤ))) (c ^ S.D.q) =
      nv * pinnedX .E6 L (u • (-(Pi.single (π j) 1) : Fin Tag.E6.rank → ℤ)) (c ^ S.D.q) *
        nv⁻¹ := by
    rw [hnv]
    exact (canonicalRep_mul_pinnedX_mul_inv_of_two h2 v
      (IsRoot.smul (isRoot_neg_single .E6 (π j)) u) (c ^ S.D.q)).symm
  have hPu : pinnedX .E6 L (u • (-(Pi.single (π j) 1) : Fin Tag.E6.rank → ℤ))
        (c ^ S.D.q) =
      nu * yUnit .E6 L (π j) (c ^ S.D.q) * nu⁻¹ := by
    rw [hnu, ← pinnedX_neg_single .E6 L (π j) (c ^ S.D.q)]
    exact (canonicalRep_mul_pinnedX_mul_inv_of_two h2 u (isRoot_neg_single .E6 (π j))
      (c ^ S.D.q)).symm
  rw [hg, CFSG.StandardType.LangRat.step_pinnedX_of_charTwo S
    (IsRoot.smul (isRoot_neg_single .E6 j) v) c, hact, hPv, hPu]
  group

end

private theorem frobShapeAux_exists_d4Idx {j : Fin Tag.E6.rank} (hj : j ∈ d4Nodes .E6) :
    ∃ k : Fin Tag.D4.rank, d4Idx k = j := by
  have hj1 : 1 ≤ j.val := hj.1
  have hj4 : j.val ≤ 4 := hj.2
  refine ⟨⟨j.val - 1, by change j.val - 1 < 4; omega⟩, ?_⟩
  ext
  simp [d4Idx]
  omega

section

variable {L : Type} [Field L]

private theorem frobShapeAux_F_inner_x (r s : ℕ) (i : Fin Tag.D4.rank) {L : Type} [Field L]
    (c : L) :
    d4P L ^ r * d4Q L ^ s * xUnit Tag.D4 L i c * (d4Q L ^ s)⁻¹ * (d4P L ^ r)⁻¹ =
      xUnit Tag.D4 L ((TwistTag.D4.perm ^ r) ((d4Swap ^ s) i)) c := by
  have h := frobShapeAux_d4PQ_x (L := L) r s i c
  rw [mul_inv_rev] at h
  simpa only [mul_assoc] using h

private theorem frobShapeAux_F_inner_y (r s : ℕ) (i : Fin Tag.D4.rank) {L : Type} [Field L]
    (c : L) :
    d4P L ^ r * d4Q L ^ s * yUnit Tag.D4 L i c * (d4Q L ^ s)⁻¹ * (d4P L ^ r)⁻¹ =
      yUnit Tag.D4 L ((TwistTag.D4.perm ^ r) ((d4Swap ^ s) i)) c := by
  have h := frobShapeAux_d4PQ_y (L := L) r s i c
  rw [mul_inv_rev] at h
  simpa only [mul_assoc] using h

end

end

theorem ntpD4_frob_shape
    {L : Type} [Field L] [IsAlgClosed L] [CharP L 2] {p₀ : ℕ}
    (S : LangSetup .E6 L p₀) (a : Fin Tag.E6.rank → Lˣ) (ha3 : ∀ i, a i ^ 3 = 1)
    (hT : rootDiagUnit .E6 a ∈ S.D.torus) (v : WeylGroup Tag.E6)
    (hv : rootCharKernel a = (fun α => v • α) '' parabolicRoots Tag.E6 (d4Nodes Tag.E6))
    (Y : Subgroup (ModGL Tag.E6 L)) (hY : Y = rootSpan Tag.E6 L (rootCharKernel a))
    (Θ : ↥Y ≃* ↥(adjointGroup Tag.D4 L))
    (hΘ : ∀ (y : ↥Y) (k : Fin Tag.D4.rank) (c : L),
      ((y : ModGL Tag.E6 L) = canonicalRep (coxeterSystem Tag.E6) L v *
          xUnit Tag.E6 L (d4Idx k) c * (canonicalRep (coxeterSystem Tag.E6) L v)⁻¹ →
        (Θ y : ModGL Tag.D4 L) = xUnit Tag.D4 L k c) ∧
      ((y : ModGL Tag.E6 L) = canonicalRep (coxeterSystem Tag.E6) L v *
          yUnit Tag.E6 L (d4Idx k) c * (canonicalRep (coxeterSystem Tag.E6) L v)⁻¹ →
        (Θ y : ModGL Tag.D4 L) = yUnit Tag.D4 L k c))
    {f : ℕ} (hf : 1 ≤ f) (hq : S.D.q = 2 ^ f) (Fr : L →+* L)
    (hFr : ∀ c, Fr c = c ^ ((2 : ℕ) ^ f)) :
    ∃ (r s : ℕ) (c : ↥(adjointGroup Tag.D4 L)), r < 3 ∧ s < 2 ∧
      ∀ (y : ModGL Tag.E6 L) (hy : y ∈ Y) (hy' : S.D.step y ∈ Y),
        (Θ ⟨S.D.step y, hy'⟩ : ModGL Tag.D4 L) = (c : ModGL Tag.D4 L) *
          (d4P L ^ r * d4Q L ^ s * Units.map (entrywiseHom Fr) (Θ ⟨y, hy⟩ : ModGL Tag.D4 L) *
            (d4Q L ^ s)⁻¹ * (d4P L ^ r)⁻¹) * (c : ModGL Tag.D4 L)⁻¹ := by
  classical
  obtain ⟨Fr₀, hFr₀, P, hP, hΦ₀⟩ := S.D.steinberg
  obtain ⟨w, hn⟩ := S.D.n_weyl
  have hq0 : 0 < S.D.q := S.hqpow.1.pos
  have hFrq : ∀ c, Fr c = c ^ S.D.q := by
    intro c
    rw [hq, hFr]
  have hFr₀eq : Fr₀ = Fr := by
    ext c
    rw [hFr₀ c, hFrq c]
  have hΦ : ∀ g, S.D.Φ g = P * Units.map (entrywiseHom Fr) g * P⁻¹ := by
    intro g
    rw [hΦ₀ g, hFr₀eq]
  have hdata : ∃ u ∈ parabolicWeylGroup .E6 (d4Nodes .E6),
      ∃ π : Equiv.Perm (Fin Tag.E6.rank), IsD4LeafPerm π ∧
        ∀ j ∈ d4Nodes .E6,
          S.ρ (v • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) =
            v • (u • (Pi.single (π j) 1 : Fin Tag.E6.rank → ℤ)) := by
    rcases hP with hP1 | ⟨t, ht, hPt⟩
    · subst hP1
      have hΦ1 : S.D.Φ = Units.map (entrywiseHom Fr) := by
        ext g
        rw [hΦ g]
        simp
      exact frobShapeAux_rho_inner S a hT v hv
        (fun γ hγ => S.rho_eq_smul_of_frob hFrq hΦ1 hn hγ)
    · have hΦdiag : ∀ g, S.D.Φ g = diagramAt .E6 L t ht *
          Units.map (entrywiseHom Fr) g * (diagramAt .E6 L t ht)⁻¹ := by
        intro g
        rw [hΦ g, hPt]
      obtain ⟨w₂, -, hρw₂⟩ :=
        CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.E6Three.KSNotAll24.d4t2out_rho_eq
          S ⟨t, ht, Fr, hFrq, hΦdiag⟩
      exact frobShapeAux_rho_graph S a hT v hv hρw₂
  obtain ⟨u, hu, π, hπ, hact⟩ := hdata
  let nv := canonicalRep (coxeterSystem .E6) L v
  let nu := canonicalRep (coxeterSystem .E6) L u
  let m : ModGL .E6 L := nv * nu * nv⁻¹
  have huS : nu ∈ rootSpan .E6 L (parabolicRoots .E6 (d4Nodes .E6)) := by
    rw [← CFSG.LieType.Chevalley.subsystemGroup_eq_rootSpan]
    exact CFSG.LieType.Chevalley.canonicalRep_mem_subsystemGroup hu
  have hmapEq : (rootSpan .E6 L (parabolicRoots .E6 (d4Nodes .E6))).map
      (MulAut.conj nv).toMonoidHom =
      rootSpan .E6 L ((fun α => v • α) '' parabolicRoots .E6 (d4Nodes .E6)) :=
    (CFSG.LieType.Chevalley.canonical_weyl_root_transport .E6 L).1 v _
      (fun α hα => hα.1)
  have hmMap : m ∈ (rootSpan .E6 L (parabolicRoots .E6 (d4Nodes .E6))).map
      (MulAut.conj nv).toMonoidHom := by
    have h := Subgroup.mem_map_of_mem (MulAut.conj nv).toMonoidHom huS
    simpa [m, MulAut.conj_apply] using h
  have hmY : m ∈ Y := by
    rw [hY, hv, ← hmapEq]
    exact hmMap
  let c : ↥(adjointGroup Tag.D4 L) := Θ ⟨m, hmY⟩
  obtain ⟨r, hr, s, hs, hperm⟩ := frobShapeAux_perm_cover hπ
  let Gens : Set (ModGL .E6 L) :=
    {z | ∃ (k : Fin Tag.D4.rank) (c₀ : L),
      z = nv * xUnit .E6 L (d4Idx k) c₀ * nv⁻¹ ∨
        z = nv * yUnit .E6 L (d4Idx k) c₀ * nv⁻¹}
  have hd4Idx_mem : ∀ k : Fin Tag.D4.rank, d4Idx k ∈ d4Nodes .E6 := by
    intro k
    have hk : k.val < 4 := k.isLt
    rw [d4Nodes, Set.mem_setOf_eq]
    change 1 ≤ k.val + 1 ∧ k.val + 1 ≤ 4
    omega
  have hGens_eq : Gens = (fun z => nv * z * nv⁻¹) ''
      CFSG.SeitzReduction.E6Pilot.simpleGens .E6 L (d4Nodes .E6) := by
    ext z
    constructor
    · rintro ⟨k, c₀, h | h⟩
      · exact ⟨xUnit .E6 L (d4Idx k) c₀, ⟨d4Idx k, hd4Idx_mem k, c₀, Or.inl rfl⟩, h.symm⟩
      · exact ⟨yUnit .E6 L (d4Idx k) c₀, ⟨d4Idx k, hd4Idx_mem k, c₀, Or.inr rfl⟩, h.symm⟩
    · rintro ⟨g, ⟨j, hj, c₀, h | h⟩, rfl⟩
      · obtain ⟨k, rfl⟩ := frobShapeAux_exists_d4Idx hj
        exact ⟨k, c₀, Or.inl (by rw [h])⟩
      · obtain ⟨k, rfl⟩ := frobShapeAux_exists_d4Idx hj
        exact ⟨k, c₀, Or.inr (by rw [h])⟩
  have hYclosure : Y = Subgroup.closure Gens := by
    rw [hY, hv, ← hmapEq,
      CFSG.SeitzReduction.E6Pilot.rootSpan_parabolicRoots_eq_closure
        (τ := Tag.E6) (K := L) (d4Nodes .E6),
      MonoidHom.map_closure, hGens_eq]
    rfl
  have hstepY : ∀ y ∈ Y, S.D.step y ∈ Y := by
    intro y hy
    rw [hY] at hy ⊢
    exact CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.step_mem_rootSpan
      (S := S) (T := rootCharKernel a) (fun γ hγ => hγ.1)
      (CFSG.HardMathSupport.Solomon.Coordinator.LieSemisimple.rho_mem_kernelRoots_of_mem_torus
        (S := S) (a := a) hT) hy
  let stepY : ↥Y →* ↥Y :=
    { toFun := fun y => ⟨S.D.step y, hstepY y y.2⟩
      map_one' := Subtype.ext (map_one S.D.step)
      map_mul' := fun x y => Subtype.ext
        (map_mul S.D.step (x : ModGL .E6 L) (y : ModGL .E6 L)) }
  let F : ↥Y →* ModGL Tag.D4 L :=
    (MulAut.conj (c : ModGL Tag.D4 L)).toMonoidHom.comp
      ((MulAut.conj (d4P L ^ r * d4Q L ^ s)).toMonoidHom.comp
        ((Units.map (entrywiseHom Fr)).comp
          ((Subgroup.subtype (adjointGroup Tag.D4 L)).comp Θ.toMonoidHom)))
  let G : ↥Y →* ModGL Tag.D4 L :=
    (Subgroup.subtype (adjointGroup Tag.D4 L)).comp (Θ.toMonoidHom.comp stepY)
  let mkY : ∀ z : ModGL .E6 L, z ∈ Subgroup.closure Gens → ↥Y :=
    fun z hz => ⟨z, by rw [hYclosure]; exact hz⟩
  have hgenx : ∀ (k : Fin Tag.D4.rank) (c₀ : L)
      (hz : nv * xUnit .E6 L (d4Idx k) c₀ * nv⁻¹ ∈ Subgroup.closure Gens),
      F (mkY (nv * xUnit .E6 L (d4Idx k) c₀ * nv⁻¹) hz) =
        G (mkY (nv * xUnit .E6 L (d4Idx k) c₀ * nv⁻¹) hz) := by
    intro k c₀ hz
    set z : ModGL .E6 L := nv * xUnit .E6 L (d4Idx k) c₀ * nv⁻¹ with hzdef
    set t : Fin Tag.D4.rank := (TwistTag.D4.perm ^ r) ((d4Swap ^ s) k) with ht
    have hπk : π (d4Idx k) = d4Idx t := by
      rw [ht]
      exact (hperm k).symm
    have hΘz : (Θ (mkY z hz) : ModGL Tag.D4 L) = xUnit Tag.D4 L k c₀ := by
      refine (hΘ (mkY z hz) k c₀).1 ?_
      rfl
    have hFz : F (mkY z hz) = (c : ModGL Tag.D4 L) *
        xUnit Tag.D4 L t (c₀ ^ S.D.q) * (c : ModGL Tag.D4 L)⁻¹ := by
      change (c : ModGL Tag.D4 L) * ((d4P L ^ r * d4Q L ^ s) *
        Units.map (entrywiseHom Fr) (Θ (mkY z hz) : ModGL Tag.D4 L) *
        (d4Q L ^ s)⁻¹ * (d4P L ^ r)⁻¹) * (c : ModGL Tag.D4 L)⁻¹ =
        (c : ModGL Tag.D4 L) * xUnit Tag.D4 L t (c₀ ^ S.D.q) *
          (c : ModGL Tag.D4 L)⁻¹
      rw [hΘz, units_map_entrywiseHom_xUnit, hFrq, frobShapeAux_F_inner_x]
    have hgGens : nv * xUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹ ∈ Gens :=
      ⟨t, c₀ ^ S.D.q, Or.inl rfl⟩
    have hgY : nv * xUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹ ∈ Y := by
      rw [hYclosure]
      exact Subgroup.subset_closure hgGens
    have hmulY : m * (nv * xUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹) * m⁻¹ ∈ Y :=
      mul_mem (mul_mem hmY hgY) (inv_mem hmY)
    have hstepEq : S.D.step z =
        m * (nv * xUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹) * m⁻¹ := by
      have h := frobShapeAux_step_x (L := L) S (v := v) (u := u)
        (j := d4Idx k) (π := π) (hact (d4Idx k) (hd4Idx_mem k)) c₀
      simpa [z, nv, nu, m, hπk] using h
    have hstepSub : stepY (mkY z hz) =
        ⟨m * (nv * xUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹) * m⁻¹, hmulY⟩ := by
      refine Subtype.ext ?_
      change S.D.step z =
        m * (nv * xUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹) * m⁻¹
      exact hstepEq
    have hGz : G (mkY z hz) = (c : ModGL Tag.D4 L) *
        xUnit Tag.D4 L t (c₀ ^ S.D.q) * (c : ModGL Tag.D4 L)⁻¹ := by
      change (Θ (stepY (mkY z hz)) : ModGL Tag.D4 L) =
        (c : ModGL Tag.D4 L) * xUnit Tag.D4 L t (c₀ ^ S.D.q) *
          (c : ModGL Tag.D4 L)⁻¹
      rw [hstepSub]
      have hsub : (⟨m * (nv * xUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹) * m⁻¹,
            hmulY⟩ : ↥Y) = ⟨m, hmY⟩ *
          ⟨nv * xUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹, hgY⟩ * (⟨m, hmY⟩)⁻¹ :=
        Subtype.ext rfl
      rw [hsub, map_mul, map_mul, map_inv]
      simp only [Subgroup.coe_mul, Subgroup.coe_inv]
      have hΘg : (Θ ⟨nv * xUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹, hgY⟩ :
          ModGL Tag.D4 L) = xUnit Tag.D4 L t (c₀ ^ S.D.q) := by
        refine (hΘ ⟨_, hgY⟩ t (c₀ ^ S.D.q)).1 ?_
        rfl
      rw [hΘg]
    rw [hFz, hGz]
  have hact_neg : ∀ j ∈ d4Nodes .E6,
      S.ρ (v • (-(Pi.single j 1) : Fin Tag.E6.rank → ℤ)) =
        v • (u • (-(Pi.single (π j) 1) : Fin Tag.E6.rank → ℤ)) := by
    intro j hj
    calc S.ρ (v • (-(Pi.single j 1) : Fin Tag.E6.rank → ℤ))
        = S.ρ (-(v • (Pi.single j 1) : Fin Tag.E6.rank → ℤ)) := by rw [smul_neg]
      _ = - S.ρ (v • (Pi.single j 1) : Fin Tag.E6.rank → ℤ) := S.frob.neg_eq _
      _ = - (v • (u • (Pi.single (π j) 1) : Fin Tag.E6.rank → ℤ)) := by rw [hact j hj]
      _ = v • (u • (-(Pi.single (π j) 1) : Fin Tag.E6.rank → ℤ)) := by
          rw [smul_neg, smul_neg]
  have hgeny : ∀ (k : Fin Tag.D4.rank) (c₀ : L)
      (hz : nv * yUnit .E6 L (d4Idx k) c₀ * nv⁻¹ ∈ Subgroup.closure Gens),
      F (mkY (nv * yUnit .E6 L (d4Idx k) c₀ * nv⁻¹) hz) =
        G (mkY (nv * yUnit .E6 L (d4Idx k) c₀ * nv⁻¹) hz) := by
    intro k c₀ hz
    set z : ModGL .E6 L := nv * yUnit .E6 L (d4Idx k) c₀ * nv⁻¹ with hzdef
    set t : Fin Tag.D4.rank := (TwistTag.D4.perm ^ r) ((d4Swap ^ s) k) with ht
    have hπk : π (d4Idx k) = d4Idx t := by
      rw [ht]
      exact (hperm k).symm
    have hΘz : (Θ (mkY z hz) : ModGL Tag.D4 L) = yUnit Tag.D4 L k c₀ := by
      refine (hΘ (mkY z hz) k c₀).2 ?_
      rfl
    have hFz : F (mkY z hz) = (c : ModGL Tag.D4 L) *
        yUnit Tag.D4 L t (c₀ ^ S.D.q) * (c : ModGL Tag.D4 L)⁻¹ := by
      change (c : ModGL Tag.D4 L) * ((d4P L ^ r * d4Q L ^ s) *
        Units.map (entrywiseHom Fr) (Θ (mkY z hz) : ModGL Tag.D4 L) *
        (d4Q L ^ s)⁻¹ * (d4P L ^ r)⁻¹) * (c : ModGL Tag.D4 L)⁻¹ =
        (c : ModGL Tag.D4 L) * yUnit Tag.D4 L t (c₀ ^ S.D.q) *
          (c : ModGL Tag.D4 L)⁻¹
      rw [hΘz, units_map_entrywiseHom_yUnit, hFrq, frobShapeAux_F_inner_y]
    have hgGens : nv * yUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹ ∈ Gens :=
      ⟨t, c₀ ^ S.D.q, Or.inr rfl⟩
    have hgY : nv * yUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹ ∈ Y := by
      rw [hYclosure]
      exact Subgroup.subset_closure hgGens
    have hmulY : m * (nv * yUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹) * m⁻¹ ∈ Y :=
      mul_mem (mul_mem hmY hgY) (inv_mem hmY)
    have hstepEq : S.D.step z =
        m * (nv * yUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹) * m⁻¹ := by
      have h := frobShapeAux_step_y (L := L) S (v := v) (u := u)
        (j := d4Idx k) (π := π) (hact_neg (d4Idx k) (hd4Idx_mem k)) c₀
      simpa [z, nv, nu, m, hπk] using h
    have hstepSub : stepY (mkY z hz) =
        ⟨m * (nv * yUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹) * m⁻¹, hmulY⟩ := by
      refine Subtype.ext ?_
      change S.D.step z =
        m * (nv * yUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹) * m⁻¹
      exact hstepEq
    have hGz : G (mkY z hz) = (c : ModGL Tag.D4 L) *
        yUnit Tag.D4 L t (c₀ ^ S.D.q) * (c : ModGL Tag.D4 L)⁻¹ := by
      change (Θ (stepY (mkY z hz)) : ModGL Tag.D4 L) =
        (c : ModGL Tag.D4 L) * yUnit Tag.D4 L t (c₀ ^ S.D.q) *
          (c : ModGL Tag.D4 L)⁻¹
      rw [hstepSub]
      have hsub : (⟨m * (nv * yUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹) * m⁻¹,
            hmulY⟩ : ↥Y) = ⟨m, hmY⟩ *
          ⟨nv * yUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹, hgY⟩ * (⟨m, hmY⟩)⁻¹ :=
        Subtype.ext rfl
      rw [hsub, map_mul, map_mul, map_inv]
      simp only [Subgroup.coe_mul, Subgroup.coe_inv]
      have hΘg : (Θ ⟨nv * yUnit .E6 L (d4Idx t) (c₀ ^ S.D.q) * nv⁻¹, hgY⟩ :
          ModGL Tag.D4 L) = yUnit Tag.D4 L t (c₀ ^ S.D.q) := by
        refine (hΘ ⟨_, hgY⟩ t (c₀ ^ S.D.q)).2 ?_
        rfl
      rw [hΘg]
    rw [hFz, hGz]
  have hFG : F = G := by
    refine MonoidHom.ext fun y => ?_
    have hy : (y : ModGL .E6 L) ∈ Subgroup.closure Gens := by
      rw [← hYclosure]
      exact y.2
    change F (mkY (y : ModGL .E6 L) hy) = G (mkY (y : ModGL .E6 L) hy)
    refine Subgroup.closure_induction (p := fun z hz => F (mkY z hz) = G (mkY z hz))
      ?_ ?_ ?_ ?_ hy
    · intro z hz
      have hz0 := hz
      rcases hz with ⟨k, c₀, h | h⟩
      · have hz' : nv * xUnit .E6 L (d4Idx k) c₀ * nv⁻¹ ∈
            Subgroup.closure Gens := Subgroup.subset_closure (h ▸ hz0)
        have hsub : mkY z (Subgroup.subset_closure hz0) =
            mkY (nv * xUnit .E6 L (d4Idx k) c₀ * nv⁻¹) hz' := Subtype.ext h
        rw [hsub]
        exact hgenx k c₀ hz'
      · have hz' : nv * yUnit .E6 L (d4Idx k) c₀ * nv⁻¹ ∈
            Subgroup.closure Gens := Subgroup.subset_closure (h ▸ hz0)
        have hsub : mkY z (Subgroup.subset_closure hz0) =
            mkY (nv * yUnit .E6 L (d4Idx k) c₀ * nv⁻¹) hz' := Subtype.ext h
        rw [hsub]
        exact hgeny k c₀ hz'
    · have hone : (1 : ModGL .E6 L) ∈ Subgroup.closure Gens := Subgroup.one_mem _
      change F (mkY 1 hone) = G (mkY 1 hone)
      rw [show mkY (1 : ModGL .E6 L) hone = 1 from Subtype.ext rfl, map_one, map_one]
    · intro x y hx hy hx' hy'
      have hmul : x * y ∈ Subgroup.closure Gens := Subgroup.mul_mem (Subgroup.closure Gens) hx hy
      change F (mkY (x * y) hmul) = G (mkY (x * y) hmul)
      rw [show mkY (x * y) hmul = mkY x hx * mkY y hy from Subtype.ext rfl, map_mul, map_mul,
        hx', hy']
    · intro x hx hx'
      have hinv : x⁻¹ ∈ Subgroup.closure Gens := Subgroup.inv_mem (Subgroup.closure Gens) hx
      change F (mkY x⁻¹ hinv) = G (mkY x⁻¹ hinv)
      rw [show mkY x⁻¹ hinv = (mkY x hx)⁻¹ from Subtype.ext rfl, map_inv, map_inv, hx']
  refine ⟨r, s, c, hr, hs, ?_⟩
  intro y hy hy'
  have hEq : F ⟨y, hy⟩ = G ⟨y, hy⟩ := by rw [hFG]
  have hFval : (F ⟨y, hy⟩ : ModGL Tag.D4 L) = (c : ModGL Tag.D4 L) *
      (d4P L ^ r * d4Q L ^ s * Units.map (entrywiseHom Fr) (Θ ⟨y, hy⟩ : ModGL Tag.D4 L) *
        (d4Q L ^ s)⁻¹ * (d4P L ^ r)⁻¹) * (c : ModGL Tag.D4 L)⁻¹ := by
    simp only [F, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply,
      Subgroup.coe_subtype, mul_inv_rev, mul_assoc]
  calc (Θ ⟨S.D.step y, hy'⟩ : ModGL Tag.D4 L)
      = (Θ ⟨S.D.step y, hstepY y hy⟩ : ModGL Tag.D4 L) := by
        rw [show (⟨S.D.step y, hy'⟩ : ↥Y) = ⟨S.D.step y, hstepY y hy⟩ from Subtype.ext rfl]
    _ = (G ⟨y, hy⟩ : ModGL Tag.D4 L) := rfl
    _ = (F ⟨y, hy⟩ : ModGL Tag.D4 L) := hEq.symm
    _ = (c : ModGL Tag.D4 L) *
        (d4P L ^ r * d4Q L ^ s * Units.map (entrywiseHom Fr) (Θ ⟨y, hy⟩ : ModGL Tag.D4 L) *
          (d4Q L ^ s)⁻¹ * (d4P L ^ r)⁻¹) * (c : ModGL Tag.D4 L)⁻¹ := hFval

end CFSG.StandardType.NTPlane
