private theorem three_ne_zero_of_ringChar_ne {K : Type} [Field K] (hK3 : ringChar K ≠ 3) :
    (3 : K) ≠ 0 := by
  intro h
  have h' : ((3 : ℕ) : K) = 0 := by exact_mod_cast h
  rcases (Nat.dvd_prime Nat.prime_three).mp ((ringChar.spec K 3).mp h') with h1 | h1
  · exact CharP.ringChar_ne_one h1
  · exact hK3 h1

open CFSG.ClassicalGroups.UnitaryFlag CFSG.LocalAnalysis.ComponentInitial
  CFSG.RankThree.PartTwo.KFacts in
private theorem card_le_nine_of_le_suConj {ℓ f : ℕ} {K : Type} [Field K]
    {h : UnitaryFieldData ℓ f K} (h3 : (3 : K) ≠ 0) (B : Subgroup (MulAut (unitarySU ℓ f K 3)))
    (hBr : B ≤ (suConj h).range) (hBc : ∀ x ∈ B, ∀ y ∈ B, x * y = y * x)
    (hB3 : ∀ x ∈ B, x ^ 3 = 1) : Nat.card B ≤ 9 := by
  set N := (suConj h).range
  set ψ : unitaryIsom3 h →* GL (Fin 3) K ⧸ CFSG.Open.StatedScalars (Fin 3) K :=
    (QuotientGroup.mk' _).comp (unitaryIsom3 h).subtype
  have hk : (suConj h).ker = ψ.ker := by
    ext A
    rw [MonoidHom.mem_ker, MonoidHom.mem_ker]
    change _ ↔ QuotientGroup.mk' _ (A : GL (Fin 3) K) = 1
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    constructor
    · intro hA
      obtain ⟨c, -, hc⟩ := twPlane_exists_scalar_of_suConj_eq_one hA
      exact ⟨c, hc.symm⟩
    · rintro ⟨c, hc⟩
      refine MulEquiv.ext fun x => Subtype.ext ?_
      rw [MulAut.one_apply, coe_suConj, Subgroup.coe_inv, ← hc,
        ← (CFSG.ClassicalGroups.UnitaryFlag.commute_scalar c (x : GL (Fin 3) K)).eq,
        mul_inv_cancel_right]
  set χ : N →* GL (Fin 3) K ⧸ CFSG.Open.StatedScalars (Fin 3) K :=
    (QuotientGroup.kerLift ψ).comp ((QuotientGroup.quotientMulEquivOfEq hk).toMonoidHom.comp
      (QuotientGroup.quotientKerEquivRange (suConj h)).symm.toMonoidHom)
  have hχ : Function.Injective χ :=
    (QuotientGroup.kerLift_injective ψ).comp ((QuotientGroup.quotientMulEquivOfEq hk).injective.comp
      (QuotientGroup.quotientKerEquivRange (suConj h)).symm.injective)
  set E := (B.subgroupOf N).map χ
  have hcardE : Nat.card E = Nat.card B := by
    rw [Subgroup.card_map_of_injective hχ]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hBr).toEquiv
  rw [← hcardE]
  refine CFSG.RankThree.PartTwo.Sec4.card_le_nine_of_pgl3 h3 E ?_ ?_
  · rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
    rw [← map_mul, ← map_mul]
    congr 1
    apply Subtype.ext
    exact hBc _ (Subgroup.mem_subgroupOf.mp hx) _ (Subgroup.mem_subgroupOf.mp hy)
  · rintro _ ⟨x, hx, rfl⟩
    rw [← map_pow]
    have : x ^ 3 = 1 := Subtype.ext (by
      rw [Subgroup.coe_pow, Subgroup.coe_one]
      exact hB3 _ (Subgroup.mem_subgroupOf.mp hx))
    rw [this, map_one]

variable {X : Type*} [Group X]

private def resAutK1 (J : Subgroup X) (g : MulAut X) (hg : J.map g.toMonoidHom = J) :
    MulAut J :=
  (MulEquiv.subgroupMap g J).trans (MulEquiv.subgroupCongr hg)

private def resHomK1 (J : Subgroup X) (E : Subgroup (MulAut X))
    (hJE : ∀ g ∈ E, J.map g.toMonoidHom = J) : ↥E →* MulAut J where
  toFun g := resAutK1 J g.1 (hJE g.1 g.2)
  map_one' := by
    ext x
    rfl
  map_mul' g h := by
    ext x
    rfl

private theorem conj_conj_mulAut_k1 (τ : MulAut X) (s : X) :
    (MulAut.conj τ).toMonoidHom (MulAut.conj s) = MulAut.conj (τ s) := by
  ext x
  simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, MulAut.mul_apply, map_mul, map_inv,
    MulAut.apply_inv_self]

end Generic


open CFSG.ClassicalGroups.UnitaryFlag CFSG.RankThree.PartTwo.KFacts in
private theorem card_le_27_of_line {K : Type} [Field K] [Finite K] {σ : K ≃+* K} {q : ℕ}
    (hK3 : ringChar K ≠ 3) (hσ : ∀ c, σ c = c ^ q) (hKq : Nat.card K = q ^ 2) (h3q : 3 ∣ q + 1)
    (hq2 : q ≠ 2) {h₀ : ModGL TwistTag.E6.tag K} {L : Fin 3 → Subgroup (ModGL TwistTag.E6.tag K)}
    {T : Subgroup (ModGL TwistTag.E6.tag K)} {n : ModGL TwistTag.E6.tag K}
    (hL : TwE6ThreeA2Line K σ h₀ L T n) {s : twistedE6RootGroup K σ}
    (hs : (s : ModGL TwistTag.E6.tag K) = h₀) {E : Subgroup (MulAut (twistedE6RootGroup K σ))}
    (hEc : ∀ x ∈ E, ∀ y ∈ E, x * y = y * x) (hE3 : ∀ x ∈ E, x ^ 3 = 1)
    (hEI : E ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ) (hsE : MulAut.conj s ∈ E) {i₀ : Fin 3}
    (hEJ : ∀ e ∈ E, ((L i₀).subgroupOf (twistedE6RootGroup K σ)).map e.toMonoidHom =
      (L i₀).subgroupOf (twistedE6RootGroup K σ))
    (hCJ : ∀ e ∈ E, (∀ c ∈ (L i₀).subgroupOf (twistedE6RootGroup K σ), e c = c) →
      e ∈ Subgroup.zpowers (MulAut.conj s)) :
    Nat.card E ≤ 27 := by
  haveI : Finite (ModGL TwistTag.E6.tag K) := finite_modGL
  haveI : Finite (MulAut (twistedE6RootGroup K σ)) := MulEquiv.finite_left
  obtain ⟨ℓ, f, h, ρ, -, hinj, hrange, hact⟩ :=
    twLayerModel_of_torusModel twTorusModel_holds K σ q hK3 hσ hKq h3q hq2 h₀ L T n hL
  have hr : ∀ i, (ρ i).range = (L i).subgroupOf (twistedE6RootGroup K σ) := fun i => by
    rw [← hrange i]
    exact (Subgroup.comap_map_eq_self_of_injective (twistedE6RootGroup K σ).subtype_injective
      _).symm
  have hfix : ∀ e ∈ E, ∀ i, (ρ i).range.map e.toMonoidHom = (ρ i).range := fun e he i => by
    rw [hr]
    exact twE6ThreeA2Line_map_eq_of_map_eq hL hs (hE3 e he) (hEc e he _ hsE) (hEJ e he) i
  obtain ⟨e₀, he₀⟩ : ∃ e₀ : unitarySU ℓ f K 3 ≃* (ρ i₀).range,
      ∀ x, (e₀ x : twistedE6RootGroup K σ) = ρ i₀ x :=
    ⟨MonoidHom.ofInjective (hinj i₀), fun _ => rfl⟩
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : E →* MulAut (unitarySU ℓ f K 3), ∀ g x,
      (e₀ (Θ g x) : twistedE6RootGroup K σ) = (g : MulAut (twistedE6RootGroup K σ)) (e₀ x) :=
    ⟨(MulAut.congr e₀.symm).toMonoidHom.comp (resHomK1 (ρ i₀).range E fun e he => hfix e he i₀),
      fun g x => by
        rw [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.congr_apply,
          MulEquiv.trans_apply, MulEquiv.trans_apply, MulEquiv.symm_symm,
          MulEquiv.apply_symm_apply]
        rfl⟩
  have hΘr : Θ.range ≤ (suConj h).range := by
    rintro _ ⟨g, rfl⟩
    obtain ⟨γ, hγ⟩ := hact s hs g.1 (hEI g.2) (hEc g.1 g.2 _ hsE) (fun i => hfix g.1 g.2 i) i₀
    obtain ⟨γ', hγ'⟩ := exists_suConj_eq_conjSU h γ
    refine ⟨γ', MulEquiv.ext fun x => e₀.injective (Subtype.ext ?_)⟩
    rw [hΘ, he₀, he₀, ← hγ', hγ]
  have hker : Θ.ker ≤ Subgroup.zpowers (⟨MulAut.conj s, hsE⟩ : E) := by
    intro g hg
    rw [MonoidHom.mem_ker] at hg
    have hfixJ : ∀ c ∈ (L i₀).subgroupOf (twistedE6RootGroup K σ),
        (g : MulAut (twistedE6RootGroup K σ)) c = c := by
      intro c hc
      rw [← hr i₀] at hc
      obtain ⟨x, rfl⟩ := hc
      have h1 := hΘ g x
      rw [hg, MulAut.one_apply, he₀] at h1
      exact h1.symm
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hCJ g.1 g.2 hfixJ)
    exact Subgroup.mem_zpowers_iff.mpr ⟨k, Subtype.ext (by rw [Subgroup.coe_zpow]; exact hk)⟩
  have hk3 : Nat.card Θ.ker ≤ 3 :=
    calc Nat.card Θ.ker ≤ Nat.card (Subgroup.zpowers (⟨MulAut.conj s, hsE⟩ : E)) :=
          Subgroup.card_le_of_le hker
      _ = orderOf (⟨MulAut.conj s, hsE⟩ : E) := Nat.card_zpowers _
      _ ≤ 3 := orderOf_le_of_pow_eq_one (by norm_num) (Subtype.ext (hE3 _ hsE))
  have h9 : Nat.card Θ.range ≤ 9 := by
    refine card_le_nine_of_le_suConj (three_ne_zero_of_ringChar_ne hK3) Θ.range hΘr ?_ ?_
    · rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
      rw [← map_mul, ← map_mul]
      exact congrArg Θ (Subtype.ext (hEc _ x.2 _ y.2))
    · rintro _ ⟨x, rfl⟩
      rw [← map_pow, show x ^ 3 = 1 from Subtype.ext (hE3 _ x.2), map_one]
  calc Nat.card E = Nat.card Θ.ker * Nat.card Θ.range := (Subgroup.card_ker_mul_card_range Θ).symm
    _ ≤ 3 * 9 := Nat.mul_le_mul hk3 h9

theorem false_of_inner_threeA2 {K : Type} [Field K] [Finite K] {σ : K ≃+* K} {q : ℕ}
    (hK3 : ringChar K ≠ 3) (hσ : ∀ c, σ c = c ^ q) (hKq : Nat.card K = q ^ 2) (h3q : 3 ∣ q + 1)
    (hq2 : q ≠ 2) {s : twistedE6RootGroup K σ} (hs3 : s ^ 3 = 1)
    (hdim : twE6FixDim K σ s = 24) {E : Subgroup (MulAut (twistedE6RootGroup K σ))}
    (hE : CFSG.Open.IsElemAbelian 3 E) (hcard : Nat.card E = 3 ^ 4)
    (hEI : E ≤ (twistedE6InndiagConj K σ).range) (hsE : MulAut.conj s ∈ E)
    {J : Subgroup (twistedE6RootGroup K σ)}
    (hJ : CFSG.Open.IsComponentOf J
      (CFSG.LieType.Seitz.fixedPoints (Subgroup.zpowers (MulAut.conj s))))
    (hEJ : ∀ e ∈ E, J.map e.toMonoidHom = J)
    (hCJ : ∀ e ∈ E, (∀ c ∈ J, e c = c) → e ∈ Subgroup.zpowers (MulAut.conj s)) : False := by
  obtain ⟨h₀, L, T, n, hL⟩ := exists_twE6ThreeA2Line K σ q hK3 hσ hKq h3q hq2
  have hs3' : (s : ModGL TwistTag.E6.tag K) ^ 3 = 1 := by
    rw [← Subgroup.coe_pow, hs3, Subgroup.coe_one]
  obtain ⟨g, hgC, hg⟩ := twE6ThreeA2Conj_holds K σ q hK3 hσ hKq h3q hq2
    (s : ModGL TwistTag.E6.tag K) s.2 h₀ hL.h₀_mem hs3' hL.h₀_pow hdim hL.finrank_fixed
  obtain ⟨τ, hτ⟩ : ∃ τ : MulAut (twistedE6RootGroup K σ), τ = MulAut.conj ⟨g, hgC⟩ := ⟨_, rfl⟩
  have hτs : ((τ s : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) = h₀ := by
    rw [hτ, MulAut.conj_apply]
    exact hg
  obtain ⟨i₀, hi₀⟩ := twE6ThreeA2Line_component_eq hL hτs hJ
  have hτI : τ ∈ twistedE6Inn K σ ⊔ twistedE6Diag K σ := by
    rw [hτ]
    exact Subgroup.mem_sup_left ⟨⟨g, hgC⟩, rfl⟩
  have hEc : ∀ x ∈ E, ∀ y ∈ E, x * y = y * x := fun x hx y hy =>
    congrArg Subtype.val (hE.1.is_comm.comm ⟨x, hx⟩ ⟨y, hy⟩)
  have hEc' : ∀ x ∈ E.map (MulAut.conj τ).toMonoidHom, ∀ y ∈ E.map (MulAut.conj τ).toMonoidHom,
      x * y = y * x := by
    rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
    rw [← map_mul, ← map_mul, hEc x hx y hy]
  have hE3' : ∀ x ∈ E.map (MulAut.conj τ).toMonoidHom, x ^ 3 = 1 := by
    rintro _ ⟨x, hx, rfl⟩
    rw [← map_pow, hE.2 x hx, map_one]
  have hEI' : E.map (MulAut.conj τ).toMonoidHom ≤ twistedE6Inn K σ ⊔ twistedE6Diag K σ := by
    rintro _ ⟨x, hx, rfl⟩
    have hx' : x ∈ twistedE6Inn K σ ⊔ twistedE6Diag K σ := by
      rw [← range_twistedE6InndiagConj K σ]
      exact hEI hx
    rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    exact mul_mem (mul_mem hτI hx') (inv_mem hτI)
  have hsE' : MulAut.conj (τ s) ∈ E.map (MulAut.conj τ).toMonoidHom :=
    ⟨MulAut.conj s, hsE, conj_conj_mulAut_k1 τ s⟩
  have hEJ' : ∀ e ∈ E.map (MulAut.conj τ).toMonoidHom,
      (J.map τ.toMonoidHom).map e.toMonoidHom = J.map τ.toMonoidHom := by
    rintro _ ⟨e, he, rfl⟩
    have h1 : ((MulAut.conj τ).toMonoidHom e).toMonoidHom.comp τ.toMonoidHom =
        τ.toMonoidHom.comp e.toMonoidHom := by
      ext x
      simp [MulAut.conj_apply, MulAut.mul_apply]
    rw [Subgroup.map_map, h1, ← Subgroup.map_map, hEJ e he]
  have hCJ' : ∀ e ∈ E.map (MulAut.conj τ).toMonoidHom,
      (∀ c ∈ J.map τ.toMonoidHom, e c = c) → e ∈ Subgroup.zpowers (MulAut.conj (τ s)) := by
    rintro _ ⟨e, he, rfl⟩ hfix
    have hfixJ : ∀ c ∈ J, e c = c := by
      intro c hc
      have h1 := hfix (τ c) ⟨c, hc, rfl⟩
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, MulAut.mul_apply,
        MulAut.inv_apply_self] at h1
      exact τ.injective h1
    rw [← conj_conj_mulAut_k1 τ s, ← MonoidHom.map_zpowers]
    exact ⟨e, hCJ e he hfixJ, rfl⟩
  rw [hi₀] at hEJ' hCJ'
  have hle := card_le_27_of_line hK3 hσ hKq h3q hq2 hL hτs hEc' hE3' hEI' hsE' hEJ' hCJ'
  rw [Subgroup.card_map_of_injective (f := (MulAut.conj τ).toMonoidHom) (MulAut.conj τ).injective,
    hcard] at hle
  norm_num at hle

