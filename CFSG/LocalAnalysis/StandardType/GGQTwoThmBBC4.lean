    · obtain ⟨hpar, hrow⟩ := ggQ2xBC4b_par_ok ⟨i, hi'⟩ (Nat.ne_of_gt hpos)
      have hpar' : ggQ2xBC4b_parOf i < i := by simpa using hpar
      have hreach : ggQ2xBC4b_Lm i =
          ggQ2xBC4b_G (ggQ2xBC4b_genOf i) * ggQ2xBC4b_Lm (ggQ2xBC4b_parOf i) := by
        rw [hrow, ← ggQ2xBC4b_G_mul_rowOp]
      have hmem : ggQ2xBC4b_Lm (ggQ2xBC4b_parOf i) ∈ ggQ2xBC4b_M :=
