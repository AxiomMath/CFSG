      intro h
      constructor
      · exact hconjW_gen a ha h
      · intro hh
        have hmem := hconjW_gen a⁻¹ (A.inv_mem ha) (a * h * a⁻¹) hh
        simpa [mul_assoc] using hmem
    exact ggQ2_bc_normalizer 4 (by omega) a hnorm
  · right
    push Not at hcase
    obtain ⟨z₀, hz₀Z, hz₀wt⟩ := hcase
    have hz₀4 : ggBCWt z₀ = 4 := by
      rcases ggQ2xBC4_wt_cases z₀ (hZ0 z₀ hz₀Z) with h | h | h <;> omega
    have hZeq : Z = {z : GGBCV 4 | z ⬝ᵥ z ≠ 0} := by
      ext z
      constructor
      · intro hz; exact hZ0 z hz
      · intro hz
        rcases ggQ2xBC4_wt_cases z hz with h | h | h
        · exact hZroots (by change 1 ≤ ggBCWt z ∧ ggBCWt z ≤ 2; omega)
        · exact hZroots (by change 1 ≤ ggBCWt z ∧ ggBCWt z ≤ 2; omega)
        · have hznz : ∀ i, z i ≠ 0 := ggQ2xBC4c_ne_zero_of_wt4 h
          have hz0nz : ∀ i, z₀ i ≠ 0 := ggQ2xBC4c_ne_zero_of_wt4 hz₀4
          let S : Finset (Fin 4) := Finset.univ.filter (fun i => z₀ i ≠ z i)
          have hflip : ggQ2xBC4c_flipS S z₀ = z := by
            funext i
            show (if i ∈ S then -z₀ i else z₀ i) = z i
            by_cases hi : i ∈ S
            · rw [if_pos hi]
              have hne : z₀ i ≠ z i := (Finset.mem_filter.mp hi).2
              exact (ggQ2xBC4c_eq_neg_of_ne (z₀ i) (z i) (hz0nz i) (hznz i) hne).symm
            · rw [if_neg hi]
              by_contra hne
              exact hi (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hne⟩)
          rw [← hflip]
          exact ggQ2xBC4c_flipS_mem hZroots hZcl hz₀Z S
    have hreflSet :
        {t : GGBCV 4 ≃ₗ[ZMod 3] GGBCV 4 | t ∈ A ∧ IsReflLin t} =
          ggBCReflSet (Set.univ : Set (GGBCV 4)) := by
      ext t
      constructor
      · rintro ⟨htA, htR⟩
        obtain ⟨z, hzZ, hz, rfl⟩ := hKZ t htA htR
        exact ⟨z, Set.mem_univ _, hz, rfl⟩
      · rintro ⟨z, -, hz, rfl⟩
        have hzZ : z ∈ Z := by rw [hZeq]; exact hz
        exact ⟨hAZ z hzZ hz, ggQ2xBC4c_isReflLin_bc z hz⟩
    have hgp : reflGp A = ggBCReflGp (Set.univ : Set (GGBCV 4)) := by
      show Subgroup.closure {t : GGBCV 4 ≃ₗ[ZMod 3] GGBCV 4 | t ∈ A ∧ IsReflLin t} =
        Subgroup.closure (ggBCReflSet (Set.univ : Set (GGBCV 4)))
      rw [hreflSet]
    refine ⟨?_, fun z hz => hAZ z (by rw [hZeq]; exact hz) hz⟩
    rw [hgp]
    exact ggQ2xBC4_card_all

private theorem ggQ2xBC4_coords (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hB : D.coxeter = (CoxeterMatrix.B 4).reindex e)
    (A : Subgroup (D.V ≃ₗ[ZMod 3] D.V)) (hW : D.weyl ≤ A) (hTF : TransvectionFree A) :
    ∃ τ : D.V ≃ₗ[ZMod 3] GGBCV 4,
      (∀ i, ggLinConj τ (D.simpleRefl (e i)) = ggQ2xBC4_rS i) ∧
      D.weyl.map (ggLinConj τ).toMonoidHom = ggBCW 4 ∧
      (∀ (c : GGBCV 4) (φ : Module.Dual (ZMod 3) (GGBCV 4)) (h : φ c = 2),
        Module.reflection h ∈ A.map (ggLinConj τ).toMonoidHom →
          ∃ ε' : ZMod 3, (ε' = 1 ∨ ε' = -1) ∧ ∀ v, φ v = ε' * (c ⬝ᵥ v)) := by
  obtain ⟨τ, ε, hε, hcor, hroot⟩ := ggQ2_BC_coordinates D hbas (by norm_num : 3 ≤ 4) e hB
  refine ⟨τ, fun i => ggQ2xBC4_simple_conj D e τ ε hε hcor hroot i, ?_,
    fun c φ h ht => ggQ2xBC4_S1 D hbas e τ ε hε hcor hroot A hW hTF h ht⟩
  rw [ggQ2xBC4_W_eq]
  unfold GGQ2Lin.weyl GGQ2Lin.parab
  rw [MonoidHom.map_closure]
  congr 1
  ext t
  constructor
  · rintro ⟨_, ⟨k, -, rfl⟩, rfl⟩
    obtain ⟨i, rfl⟩ := e.surjective k
    exact ⟨i, (ggQ2xBC4_simple_conj D e τ ε hε hcor hroot i).symm⟩
  · rintro ⟨i, rfl⟩
    exact ⟨D.simpleRefl (e i), ⟨e i, Set.mem_univ _, rfl⟩,
      ggQ2xBC4_simple_conj D e τ ε hε hcor hroot i⟩

theorem ggQ2_thmB_BC4 (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hB : D.coxeter = (CoxeterMatrix.B 4).reindex e)
    (A : Subgroup (D.V ≃ₗ[ZMod 3] D.V)) (hW : D.weyl ≤ A) (hTF : TransvectionFree A) :
    A ≤ D.weyl ∨ D.FCell A := by
  obtain ⟨τ, -, hmapW, hS1'⟩ := ggQ2xBC4_coords D hbas e hB A hW hTF
  have hW' : ggBCW 4 ≤ A.map (ggLinConj τ).toMonoidHom := by
    rw [← hmapW]
    exact Subgroup.map_mono hW
  rcases ggQ2xBC4_core _ hW' hS1' with h1 | ⟨h2, -⟩
  · left
    rw [← hmapW] at h1
    exact (Subgroup.map_le_map_iff_of_injective (ggLinConj τ).injective).mp h1
  · right
    refine ⟨by rw [← Fintype.card_congr e, Fintype.card_fin], ?_⟩
    rw [ggLinConj_reflGp] at h2
    rw [← h2]
    exact Nat.card_congr (Subgroup.equivMapOfInjective (reflGp A) (ggLinConj τ).toMonoidHom
      (ggLinConj τ).injective).toEquiv

private def ggQ2xBC4_fix (i : Fin 4) : GGBCV 4 :=
  (![![1, 0, 0, 0], ![1, 1, 0, 0], ![1, 1, 1, 0], ![1, 1, 1, 1]] : Fin 4 → GGBCV 4) i

private lemma ggQ2xBC4_weyl_le_reflGp (D : GGQ2Lin 3) (A : Subgroup (D.V ≃ₗ[ZMod 3] D.V))
    (hW : D.weyl ≤ A) : D.weyl ≤ reflGp A := by
  unfold GGQ2Lin.weyl GGQ2Lin.parab
  rw [Subgroup.closure_le]
  rintro _ ⟨k, -, rfl⟩
  exact Subgroup.subset_closure ⟨hW (Subgroup.subset_closure ⟨k, Set.mem_univ k, rfl⟩),
    D.coroot k, D.root k, D.root_coroot_self k, rfl⟩

private lemma ggQ2xBCc1_rS_apply (i : Fin 4) (v : GGBCV 4) :
    ggQ2xBC4_rS i v = v +
      ((ggBCCoroot 4 1 i ⬝ᵥ v) * (ggBCCoroot 4 1 i ⬝ᵥ ggBCCoroot 4 1 i)) •
        ggBCCoroot 4 1 i := by
  unfold ggQ2xBC4_rS
  exact ggQ2x_ggBCRefl_apply (ggBCCoroot 4 1 i) (ggQ2xBC4_cc i) v

private lemma ggQ2xBCc1_coroot_ne (i : Fin 4) : ggBCCoroot 4 1 i ≠ 0 := by
  fin_cases i <;> decide

private lemma ggQ2xBCc1_rS_fixed_iff (i : Fin 4) (v : GGBCV 4) :
    ggQ2xBC4_rS i v = v ↔ ggBCCoroot 4 1 i ⬝ᵥ v = 0 := by
  rw [ggQ2xBCc1_rS_apply]
  constructor
  · intro h
    have h1 : ((ggBCCoroot 4 1 i ⬝ᵥ v) *
        (ggBCCoroot 4 1 i ⬝ᵥ ggBCCoroot 4 1 i)) • ggBCCoroot 4 1 i = 0 := by
      have h2 := congrArg (fun w => w - v) h
      simpa using h2
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact (mul_eq_zero.mp h2).resolve_right (ggQ2xBC4_cc i)
    · exact absurd h2 (ggQ2xBCc1_coroot_ne i)
  · intro h
    rw [h, zero_mul, zero_smul, add_zero]

private lemma ggQ2xBCc1_finite (i₀ : Fin 4) (v : GGBCV 4) :
    (∀ i, i ≠ i₀ → ggBCCoroot 4 1 i ⬝ᵥ v = 0) ↔
      ∃ s : ZMod 3, v = s • ggQ2xBC4_fix i₀ := by
  revert v
  fin_cases i₀ <;> decide

private lemma ggQ2xBCc1_parab_fixed_iff (D : GGQ2Lin 3) (e : Fin 4 ≃ D.ι)
    (τ : D.V ≃ₗ[ZMod 3] GGBCV 4) (hs : ∀ i, ggLinConj τ (D.simpleRefl (e i)) = ggQ2xBC4_rS i)
    (i₀ : Fin 4) (v : D.V) :
    (∀ g ∈ D.parab {k | k ≠ e i₀}, g v = v) ↔
      ∀ i, i ≠ i₀ → ggQ2xBC4_rS i (τ v) = τ v := by
  constructor
  · intro hv i hi
    have hmem : D.simpleRefl (e i) ∈ D.parab {k | k ≠ e i₀} := by
      rw [GGQ2Lin.parab]
      refine Subgroup.subset_closure ⟨e i, ?_, rfl⟩
      intro h
      exact hi (e.injective h)
    have hfix : D.simpleRefl (e i) v = v := hv _ hmem
    calc ggQ2xBC4_rS i (τ v)
        = ggLinConj τ (D.simpleRefl (e i)) (τ v) := by rw [hs i]
      _ = τ (D.simpleRefl (e i) (τ.symm (τ v))) := ggLinConj_apply τ _ (τ v)
      _ = τ (D.simpleRefl (e i) v) := by rw [LinearEquiv.symm_apply_apply]
      _ = τ v := by rw [hfix]
  · intro hv g hg
    have hg' : g ∈ Subgroup.closure (D.simpleRefl '' {k | k ≠ e i₀}) := by
      simpa only [GGQ2Lin.parab] using hg
    apply τ.injective
    refine Subgroup.closure_induction (p := fun x _ => τ (x v) = τ v) ?_ ?_ ?_ ?_ hg'
    · rintro x ⟨k, hk, rfl⟩
      obtain ⟨i, rfl⟩ := e.surjective k
      have hi : i ≠ i₀ := by
        intro h0
        exact hk (by rw [h0])
      calc τ (D.simpleRefl (e i) v)
          = ggLinConj τ (D.simpleRefl (e i)) (τ v) := by
            rw [ggLinConj_apply, LinearEquiv.symm_apply_apply]
        _ = ggQ2xBC4_rS i (τ v) := by rw [hs i]
        _ = τ v := hv i hi
    · rfl
    · intro x y _ _ hx' hy'
      have hy'' : y v = v := τ.injective hy'
      rw [LinearEquiv.mul_apply, hy'', hx']
    · intro x _ hx'
      have hx'' : x v = v := τ.injective hx'
      have hx3 : x⁻¹ v = v := by
        calc x⁻¹ v = x⁻¹ (x v) := by rw [hx'']
          _ = v := x.symm_apply_apply v
      rw [hx3]

private theorem ggQ2xBC4_cell_fixed (D : GGQ2Lin 3) (e : Fin 4 ≃ D.ι)
    (τ : D.V ≃ₗ[ZMod 3] GGBCV 4) (hs : ∀ i, ggLinConj τ (D.simpleRefl (e i)) = ggQ2xBC4_rS i)
    (i₀ : Fin 4) (x : D.V)
    (hx : ∀ v, (∀ g ∈ D.parab {k | k ≠ e i₀}, g v = v) ↔ v ∈ Submodule.span (ZMod 3) {x}) :
    Submodule.span (ZMod 3) {τ x} = Submodule.span (ZMod 3) {ggQ2xBC4_fix i₀} := by
  have hfix : ∀ i, i ≠ i₀ → ggBCCoroot 4 1 i ⬝ᵥ ggQ2xBC4_fix i₀ = 0 :=
    (ggQ2xBCc1_finite i₀ _).mpr ⟨1, by rw [one_smul]⟩
  apply le_antisymm
  · rw [Submodule.span_singleton_le_iff_mem, Submodule.mem_span_singleton]
    have hxmem : x ∈ Submodule.span (ZMod 3) {x} := Submodule.subset_span (by simp)
    have hxfix : ∀ g ∈ D.parab {k | k ≠ e i₀}, g x = x := (hx x).mpr hxmem
    have hτx := (ggQ2xBCc1_parab_fixed_iff D e τ hs i₀ x).mp hxfix
    have horth : ∀ i, i ≠ i₀ → ggBCCoroot 4 1 i ⬝ᵥ τ x = 0 :=
      fun i hi => (ggQ2xBCc1_rS_fixed_iff i _).mp (hτx i hi)
    obtain ⟨s, hs'⟩ := (ggQ2xBCc1_finite i₀ (τ x)).mp horth
    exact ⟨s, hs'.symm⟩
  · rw [Submodule.span_singleton_le_iff_mem, Submodule.mem_span_singleton]
    have hyfix : ∀ g ∈ D.parab {k | k ≠ e i₀},
        g (τ.symm (ggQ2xBC4_fix i₀)) = τ.symm (ggQ2xBC4_fix i₀) := by
      rw [ggQ2xBCc1_parab_fixed_iff D e τ hs i₀]
      intro i hi
      rw [LinearEquiv.apply_symm_apply]
      exact (ggQ2xBCc1_rS_fixed_iff i _).mpr (hfix i hi)
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp ((hx _).mp hyfix)
    refine ⟨a, ?_⟩
    calc a • τ x = τ (a • x) := by rw [map_smul]
      _ = τ (τ.symm (ggQ2xBC4_fix i₀)) := by rw [ha]
      _ = ggQ2xBC4_fix i₀ := τ.apply_symm_apply _

private theorem ggQ2xBC4_cell_dat (j : Fin 4) (hj : j ≠ 0) :
    (∃ s t : ZMod 3, s • ggQ2xBC4_fix 0 + t • ggQ2xBC4_fix j ≠ 0 ∧
        (s • ggQ2xBC4_fix 0 + t • ggQ2xBC4_fix j) ⬝ᵥ
          (1 : Matrix (Fin 4) (Fin 4) (ZMod 3)).mulVec
            (s • ggQ2xBC4_fix 0 + t • ggQ2xBC4_fix j) = 0) ∨
      ((∀ s t : ZMod 3, s • ggQ2xBC4_fix 0 + t • ggQ2xBC4_fix j ≠ 0 →
        (s • ggQ2xBC4_fix 0 + t • ggQ2xBC4_fix j) ⬝ᵥ
          (1 : Matrix (Fin 4) (Fin 4) (ZMod 3)).mulVec
            (s • ggQ2xBC4_fix 0 + t • ggQ2xBC4_fix j) ≠ 0) ∧
      ∃ s₁ t₁ s₂ t₂ : ZMod 3,
        (s₁ • ggQ2xBC4_fix 0 + t₁ • ggQ2xBC4_fix j) ⬝ᵥ
          (1 : Matrix (Fin 4) (Fin 4) (ZMod 3)).mulVec
            (s₁ • ggQ2xBC4_fix 0 + t₁ • ggQ2xBC4_fix j) = 1 ∧
        (s₂ • ggQ2xBC4_fix 0 + t₂ • ggQ2xBC4_fix j) ⬝ᵥ
          (1 : Matrix (Fin 4) (Fin 4) (ZMod 3)).mulVec
            (s₂ • ggQ2xBC4_fix 0 + t₂ • ggQ2xBC4_fix j) = 2) := by
  fin_cases j
  · exact absurd rfl hj
  · right
    decide +kernel
  · left
    decide +kernel
  · left
    decide +kernel

private lemma ggQ2xBCt_span_sup_le_pair {V : Type} [AddCommGroup V] [Module (ZMod 3) V]
    (a b : V) :
    Submodule.span (ZMod 3) ({a} : Set V) ⊔ Submodule.span (ZMod 3) ({b} : Set V) ≤
      Submodule.span (ZMod 3) ({a, b} : Set V) := by
  apply sup_le
  · rw [Submodule.span_le]
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst hz
    exact Submodule.subset_span (by simp)
  · rw [Submodule.span_le]
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst hz
    exact Submodule.subset_span (by simp)

private lemma ggQ2xBCt_map_span_singleton {V W : Type} [AddCommGroup V] [Module (ZMod 3) V]
    [AddCommGroup W] [Module (ZMod 3) W] (τ : V ≃ₗ[ZMod 3] W) (a : V) :
    Submodule.map τ.toLinearMap (Submodule.span (ZMod 3) {a}) =
      Submodule.span (ZMod 3) {τ a} := by
  rw [Submodule.map_span]
  simp

private lemma ggQ2xBCt_span_eq_map_iff {V W : Type} [AddCommGroup V] [Module (ZMod 3) V]
    [AddCommGroup W] [Module (ZMod 3) W] (τ : V ≃ₗ[ZMod 3] W) (a b : V) :
    (Submodule.span (ZMod 3) {a} = Submodule.span (ZMod 3) {b}) ↔
      (Submodule.span (ZMod 3) {τ a} = Submodule.span (ZMod 3) {τ b}) := by
  constructor
  · intro h
    rw [← ggQ2xBCt_map_span_singleton τ a, ← ggQ2xBCt_map_span_singleton τ b, h]
  · intro h
    have h' := congrArg (Submodule.map (τ.symm : W ≃ₗ[ZMod 3] V).toLinearMap) h
    simpa [Submodule.map_span] using h'

private lemma ggQ2xBCt_mem_span_pair {V W : Type} [AddCommGroup V] [Module (ZMod 3) V]
    [AddCommGroup W] [Module (ZMod 3) W] (τ : V ≃ₗ[ZMod 3] W) (x y : V) (x' y' : W)
    (hx : Submodule.span (ZMod 3) {τ x} = Submodule.span (ZMod 3) {x'})
    (hy : Submodule.span (ZMod 3) {τ y} = Submodule.span (ZMod 3) {y'}) (u : V) :
    u ∈ Submodule.span (ZMod 3) ({x, y} : Set V) ↔
      τ u ∈ Submodule.span (ZMod 3) ({x', y'} : Set W) := by
  have hxmem : τ x ∈ Submodule.span (ZMod 3) ({x'} : Set W) := by
    rw [← hx]
    exact Submodule.subset_span (by simp)
  have hymem : τ y ∈ Submodule.span (ZMod 3) ({y'} : Set W) := by
    rw [← hy]
    exact Submodule.subset_span (by simp)
  have hx'mem : x' ∈ Submodule.span (ZMod 3) ({τ x} : Set W) := by
    rw [hx]
    exact Submodule.subset_span (by simp)
  have hy'mem : y' ∈ Submodule.span (ZMod 3) ({τ y} : Set W) := by
    rw [hy]
    exact Submodule.subset_span (by simp)
  constructor
  · intro hu
    rw [Submodule.mem_span_pair] at hu
    obtain ⟨a, b, hab⟩ := hu
    have hmem : τ u ∈ Submodule.span (ZMod 3) ({x', y'} : Set W) := by
      rw [← hab, map_add, map_smul, map_smul]
      exact ggQ2xBCt_span_sup_le_pair x' y'
        (Submodule.add_mem_sup (Submodule.smul_mem _ a hxmem)
          (Submodule.smul_mem _ b hymem))
    exact hmem
  · intro hu
    rw [Submodule.mem_span_pair] at hu
    obtain ⟨a, b, hab⟩ := hu
    have hmem : τ u ∈ Submodule.span (ZMod 3) ({τ x, τ y} : Set W) := by
      rw [← hab]
      exact ggQ2xBCt_span_sup_le_pair (τ x) (τ y)
        (Submodule.add_mem_sup (Submodule.smul_mem _ a hx'mem)
          (Submodule.smul_mem _ b hy'mem))
    rw [Submodule.mem_span_pair] at hmem
    obtain ⟨c, d, hcd⟩ := hmem
    rw [Submodule.mem_span_pair]
    refine ⟨c, d, ?_⟩
    have h2 := congrArg τ.symm hcd
    simp only [map_add, map_smul, LinearEquiv.symm_apply_apply] at h2
    exact h2

private theorem ggQ2xBC4_cell_transport (D : GGQ2Lin 3) (τ : D.V ≃ₗ[ZMod 3] GGBCV 4)
    (A : Subgroup (D.V ≃ₗ[ZMod 3] D.V)) (x y : D.V) (x' y' : GGBCV 4)
    (hx : Submodule.span (ZMod 3) {τ x} = Submodule.span (ZMod 3) {x'})
    (hy : Submodule.span (ZMod 3) {τ y} = Submodule.span (ZMod 3) {y'})
    (h : (∃ u ∈ Submodule.span (ZMod 3) {x', y'}, u ≠ 0 ∧
        ∀ φ ∈ A.map (ggLinConj τ).toMonoidHom, ∃ r ∈ reflGp (A.map (ggLinConj τ).toMonoidHom),
          Submodule.span (ZMod 3) {φ u} = Submodule.span (ZMod 3) {r u}) ∨
      (∀ φ ∈ A.map (ggLinConj τ).toMonoidHom, ∀ w ∈ Submodule.span (ZMod 3) {x', y'}, w ≠ 0 →
        ∃ r ∈ reflGp (A.map (ggLinConj τ).toMonoidHom),
          ∃ w' ∈ Submodule.span (ZMod 3) {x', y'}, w' ≠ 0 ∧
            Submodule.span (ZMod 3) {φ w} = Submodule.span (ZMod 3) {r w'})) :
    (∃ u ∈ Submodule.span (ZMod 3) {x, y}, u ≠ 0 ∧ ∀ φ ∈ A, ∃ r ∈ reflGp A,
      Submodule.span (ZMod 3) {φ u} = Submodule.span (ZMod 3) {r u}) ∨
    (∀ φ ∈ A, ∀ w ∈ Submodule.span (ZMod 3) {x, y}, w ≠ 0 → ∃ r ∈ reflGp A,
      ∃ w' ∈ Submodule.span (ZMod 3) {x, y}, w' ≠ 0 ∧
        Submodule.span (ZMod 3) {φ w} = Submodule.span (ZMod 3) {r w'}) := by
  rcases h with ⟨u', hu', hu'0, hcell⟩ | hcell
  · left
    refine ⟨τ.symm u', ?_, ?_, ?_⟩
    · exact (ggQ2xBCt_mem_span_pair τ x y x' y' hx hy (τ.symm u')).mpr
        (by rw [τ.apply_symm_apply]; exact hu')
    · intro h0
      exact hu'0 (by
        have h1 := congrArg τ h0
        rw [τ.apply_symm_apply, map_zero] at h1
        exact h1)
    · intro φ hφ
      obtain ⟨r', hr', hline⟩ := hcell (ggLinConj τ φ) (Subgroup.mem_map.mpr ⟨φ, hφ, rfl⟩)
      rw [ggLinConj_reflGp τ A] at hr'
      obtain ⟨r, hr, hrr'⟩ := Subgroup.mem_map.mp hr'
      have hrr'' : ggLinConj τ r = r' := hrr'
      refine ⟨r, hr, ?_⟩
      have h1 : (ggLinConj τ φ) u' = τ (φ (τ.symm u')) := ggLinConj_apply τ φ u'
      have h2 : r' u' = τ (r (τ.symm u')) := by
        rw [← hrr'']
        exact ggLinConj_apply τ r u'
      have hline' : Submodule.span (ZMod 3) {τ (φ (τ.symm u'))} =
          Submodule.span (ZMod 3) {τ (r (τ.symm u'))} := by
        rw [← h1, ← h2]
        exact hline
      exact (ggQ2xBCt_span_eq_map_iff τ (φ (τ.symm u')) (r (τ.symm u'))).mpr hline'
  · right
    intro φ hφ w hw hw0
    have hw' : τ w ∈ Submodule.span (ZMod 3) ({x', y'} : Set (GGBCV 4)) :=
      (ggQ2xBCt_mem_span_pair τ x y x' y' hx hy w).mp hw
    have hw'0 : τ w ≠ 0 := by
      intro h0
      exact hw0 (by
        have h1 := congrArg τ.symm h0
        simpa using h1)
    obtain ⟨r', hr', w'', hw'', hw''0, hline⟩ :=
      hcell (ggLinConj τ φ) (Subgroup.mem_map.mpr ⟨φ, hφ, rfl⟩) (τ w) hw' hw'0
    rw [ggLinConj_reflGp τ A] at hr'
    obtain ⟨r, hr, hrr'⟩ := Subgroup.mem_map.mp hr'
    have hrr'' : ggLinConj τ r = r' := hrr'
    refine ⟨r, hr, τ.symm w'', ?_, ?_, ?_⟩
    · exact (ggQ2xBCt_mem_span_pair τ x y x' y' hx hy (τ.symm w'')).mpr
        (by rw [τ.apply_symm_apply]; exact hw'')
    · intro h0
      exact hw''0 (by
        have h1 := congrArg τ h0
        rw [τ.apply_symm_apply, map_zero] at h1
        exact h1)
    · have h1 : (ggLinConj τ φ) (τ w) = τ (φ w) := by
        rw [ggLinConj_apply, LinearEquiv.symm_apply_apply]
      have h2 : r' w'' = τ (r (τ.symm w'')) := by
        rw [← hrr'']
        exact ggLinConj_apply τ r w''
      have hline' : Submodule.span (ZMod 3) {τ (φ w)} =
          Submodule.span (ZMod 3) {τ (r (τ.symm w''))} := by
        rw [← h1, ← h2]
        exact hline
      exact (ggQ2xBCt_span_eq_map_iff τ (φ w) (r (τ.symm w''))).mpr hline'

private lemma ggQ2xBC4_refl_formula (z : GGBCV 4) (hz : z ⬝ᵥ z ≠ 0) (v : GGBCV 4) :
    ggBCRefl z hz v = v - (2 * (z ⬝ᵥ (1 : Matrix (Fin 4) (Fin 4) (ZMod 3)).mulVec v) /
      (z ⬝ᵥ (1 : Matrix (Fin 4) (Fin 4) (ZMod 3)).mulVec z)) • z := by
  rw [ggQ2x_ggBCRefl_apply, Matrix.one_mulVec, Matrix.one_mulVec, sub_eq_add_neg, ← neg_smul]
  congr 2
  generalize z ⬝ᵥ z = b at hz ⊢
  generalize z ⬝ᵥ v = a
  have hb : b * b = 1 := by
    revert b
    decide
  have h3 : (3 : ZMod 3) = 0 := by decide
  field_simp
  linear_combination a * hb + a * h3

theorem ggQ2_cell_BC4 (D : GGQ2Lin 3) (hbas : D.Basis) (e : Fin 4 ≃ D.ι)
    (hB : D.coxeter = (CoxeterMatrix.B 4).reindex e) (ha : D.a = e 0) (x y : D.V)
    (hx : ∀ v, (∀ g ∈ D.parab {k | k ≠ D.a}, g v = v) ↔ v ∈ Submodule.span (ZMod 3) {x})
    (hy : ∀ v, (∀ g ∈ D.parab {k | k ≠ D.b}, g v = v) ↔ v ∈ Submodule.span (ZMod 3) {y})
    (A : Subgroup (D.V ≃ₗ[ZMod 3] D.V)) (hW : D.weyl ≤ A) (hTF : TransvectionFree A)
    (hR : D.FCell A) :
    (∃ u ∈ Submodule.span (ZMod 3) {x, y}, u ≠ 0 ∧ ∀ φ ∈ A, ∃ r ∈ reflGp A,
      Submodule.span (ZMod 3) {φ u} = Submodule.span (ZMod 3) {r u}) ∨
    (∀ φ ∈ A, ∀ w ∈ Submodule.span (ZMod 3) {x, y}, w ≠ 0 → ∃ r ∈ reflGp A,
      ∃ w' ∈ Submodule.span (ZMod 3) {x, y}, w' ≠ 0 ∧
        Submodule.span (ZMod 3) {φ w} = Submodule.span (ZMod 3) {r w'}) := by
  clear hR
  obtain ⟨τ, hs, hmapW, hS1'⟩ := ggQ2xBC4_coords D hbas e hB A hW hTF
  have hW' : ggBCW 4 ≤ A.map (ggLinConj τ).toMonoidHom := by
    rw [← hmapW]
    exact Subgroup.map_mono hW
  obtain ⟨j, hj⟩ := e.surjective D.b
  have hj0 : j ≠ 0 := fun h => D.a_ne_b (by rw [ha, ← hj, h])
  rw [ha] at hx
  rw [← hj] at hy
  have hxτ := ggQ2xBC4_cell_fixed D e τ hs 0 x hx
  have hyτ := ggQ2xBC4_cell_fixed D e τ hs j y hy
  rcases ggQ2xBC4_core _ hW' hS1' with h1 | ⟨-, hall⟩
  · right
    have hA : A ≤ D.weyl := by
      rw [← hmapW] at h1
      exact (Subgroup.map_le_map_iff_of_injective (ggLinConj τ).injective).mp h1
    intro φ hφ w hw hw0
    exact ⟨φ, ggQ2xBC4_weyl_le_reflGp D A hW (hA hφ), w, hw, hw0, rfl⟩
  · refine ggQ2xBC4_cell_transport D τ A x y _ _ hxτ hyτ ?_
    refine ggQ2_cell_coord 1 (Or.inr rfl) _ ?_ ?_ _ _ (ggQ2xBC4_cell_dat j hj0)
    · intro c φ h ht
      obtain ⟨ε, hε, hv⟩ := hS1' c φ h ht
      exact ⟨ε, hε, fun v => by rw [hv v, Matrix.one_mulVec]⟩
    · intro z hz
      rw [Matrix.one_mulVec] at hz
      exact ⟨ggBCRefl z hz, hall z hz, ggQ2xBC4_refl_formula z hz⟩

end CFSG.StandardType

