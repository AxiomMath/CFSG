private def ggQ2xBC4b_Gvec (k : Fin 5) (i : Fin 4) : ZMod 3 :=
  if k.val = 4 then 1 else if i.val = k.val then 1 else if i.val = k.val + 1 then 2 else 0

private def ggQ2xBC4b_reflM (z : GGBCV 4) : Matrix (Fin 4) (Fin 4) (ZMod 3) :=
  fun i j => (if i = j then 1 else 0) + (z j * (z ⬝ᵥ z)) * z i

private def ggQ2xBC4b_G (k : Fin 5) : Matrix (Fin 4) (Fin 4) (ZMod 3) :=
  fun i j =>
    if k.val = 0 then
      (if (i.val = 0 ∧ j.val = 1) ∨ (i.val = 1 ∧ j.val = 0) then 1
        else if i = j ∧ i.val ≠ 0 ∧ i.val ≠ 1 then 1 else 0)
    else if k.val = 1 then
      (if (i.val = 1 ∧ j.val = 2) ∨ (i.val = 2 ∧ j.val = 1) then 1
        else if i = j ∧ i.val ≠ 1 ∧ i.val ≠ 2 then 1 else 0)
    else if k.val = 2 then
      (if (i.val = 2 ∧ j.val = 3) ∨ (i.val = 3 ∧ j.val = 2) then 1
        else if i = j ∧ i.val ≠ 2 ∧ i.val ≠ 3 then 1 else 0)
    else if k.val = 3 then (if i = j then if i.val = 3 then -1 else 1 else 0)
    else (if i = j then 2 else 1)

private def ggQ2xBC4b_rowOp (k : Fin 5) (M : Matrix (Fin 4) (Fin 4) (ZMod 3)) :
    Matrix (Fin 4) (Fin 4) (ZMod 3) :=
  fun i j =>
    if k.val = 0 then (if i.val = 0 then M 1 j else if i.val = 1 then M 0 j else M i j)
    else if k.val = 1 then (if i.val = 1 then M 2 j else if i.val = 2 then M 1 j else M i j)
    else if k.val = 2 then (if i.val = 2 then M 3 j else if i.val = 3 then M 2 j else M i j)
    else if k.val = 3 then (if i.val = 3 then -M i j else M i j)
    else M i j + (M 0 j + M 1 j + M 2 j + M 3 j)

private lemma ggQ2xBC4b_reflM_Gvec (k : Fin 5) :
    ggQ2xBC4b_reflM (ggQ2xBC4b_Gvec k) = ggQ2xBC4b_G k := by
  fin_cases k <;>
    ext i j <;>
    fin_cases i <;> fin_cases j <;>
    simp [ggQ2xBC4b_reflM, ggQ2xBC4b_G, ggQ2xBC4b_Gvec, dotProduct,
      Fin.sum_univ_four] <;>
    decide

private theorem ggQ2xBC4b_G_mul_rowOp (k : Fin 5)
    (M : Matrix (Fin 4) (Fin 4) (ZMod 3)) :
    ggQ2xBC4b_G k * M = ggQ2xBC4b_rowOp k M := by
  fin_cases k <;>
    ext i j <;>
    fin_cases i <;> fin_cases j <;>
    simp [ggQ2xBC4b_G, ggQ2xBC4b_rowOp, Matrix.mul_apply, Fin.sum_univ_four] <;>
    ring

