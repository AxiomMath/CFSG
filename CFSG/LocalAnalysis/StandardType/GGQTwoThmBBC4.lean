private def ggQ2xBC4b_pad (c : ℕ) : List ℕ :=
  Nat.digits 3 c ++ List.replicate (16 - (Nat.digits 3 c).length) 0

private lemma ggQ2xBC4b_pad_length {c : ℕ} (hc : c < 3 ^ 16) :
    (ggQ2xBC4b_pad c).length = 16 := by
  unfold ggQ2xBC4b_pad
  rw [List.length_append, List.length_replicate]
  have hle : (Nat.digits 3 c).length ≤ 16 :=
    (Nat.digits_length_le_iff (b := 3) (k := 16) (by norm_num) c).mpr hc
  omega

private lemma ggQ2xBC4b_pad_getD {c k : ℕ} (hc : c < 3 ^ 16) (hk : k < 16) :
    (ggQ2xBC4b_pad c).getD k 0 = c / 3 ^ k % 3 := by
  unfold ggQ2xBC4b_pad
  by_cases hkL : k < (Nat.digits 3 c).length
  · rw [List.getD_append _ _ _ _ hkL, Nat.getD_digits _ _ (by norm_num)]
  · have hLk : (Nat.digits 3 c).length ≤ k := Nat.le_of_not_lt hkL
    rw [List.getD_append_right _ _ _ _ hLk]
    have hidx : k - (Nat.digits 3 c).length < 16 - (Nat.digits 3 c).length := by
      omega
    have hz : (List.replicate (16 - (Nat.digits 3 c).length) 0).getD
        (k - (Nat.digits 3 c).length) 0 = 0 := List.getD_replicate 0 hidx
    rw [hz]
    have hlt : c < 3 ^ k :=
      lt_of_lt_of_le (Nat.lt_base_pow_length_digits (by norm_num))
        (Nat.pow_le_pow_right (by norm_num) hLk)
    rw [Nat.div_eq_of_lt hlt]

private lemma ggQ2xBC4b_pad_ofDigits {c : ℕ} (hc : c < 3 ^ 16) :
    Nat.ofDigits 3 (ggQ2xBC4b_pad c) = c := by
  unfold ggQ2xBC4b_pad
  rw [Nat.ofDigits_append, Nat.ofDigits_replicate_zero, Nat.mul_zero, Nat.add_zero,
    Nat.ofDigits_digits]

private lemma ggQ2xBC4b_toMat_val (c : ℕ) (i j : Fin 4) :
    (ggQ2xBC4b_toMat c i j).val = c / 3 ^ (4 * i.val + j.val) % 3 := by
  simp [ggQ2xBC4b_toMat]

private theorem ggQ2xBC4b_toMat_inj {c d : ℕ} (hc : c < 3 ^ 16) (hd : d < 3 ^ 16)
    (h : ggQ2xBC4b_toMat c = ggQ2xBC4b_toMat d) : c = d := by
  have hlen : (ggQ2xBC4b_pad c).length = (ggQ2xBC4b_pad d).length := by
    rw [ggQ2xBC4b_pad_length hc, ggQ2xBC4b_pad_length hd]
  have hlist : ggQ2xBC4b_pad c = ggQ2xBC4b_pad d := by
    refine List.ext_getElem hlen fun k hk hkd => ?_
    have hk16 : k < 16 := by rw [ggQ2xBC4b_pad_length hc] at hk; exact hk
    rw [List.getElem_eq_getD, List.getElem_eq_getD,
      ggQ2xBC4b_pad_getD hc hk16, ggQ2xBC4b_pad_getD hd hk16]
    have hentry := congrFun (congrFun h ⟨k / 4, Nat.div_lt_of_lt_mul (by omega)⟩)
      ⟨k % 4, Nat.mod_lt _ (by norm_num)⟩
    have hval := congrArg ZMod.val hentry
    rw [ggQ2xBC4b_toMat_val, ggQ2xBC4b_toMat_val] at hval
    have hk4 : 4 * (k / 4) + k % 4 = k := by
      have := Nat.div_add_mod k 4
      omega
    simpa [hk4] using hval
  rw [← ggQ2xBC4b_pad_ofDigits hc, ← ggQ2xBC4b_pad_ofDigits hd, hlist]

