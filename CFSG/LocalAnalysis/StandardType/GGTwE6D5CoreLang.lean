theorem exists_step_rootDiagUnit (S : LangSetup Tag.E6 L p₀) {Fr : L →+* L}
    (hFr : ∀ c, Fr c = c ^ S.D.q) (hΦ : S.D.Φ = twistHom TwistTag.E6 L Fr)
    {a : Fin Tag.E6.rank → Lˣ} (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus)
    {b : Fin Tag.E6.rank → Lˣ} (hb : ∀ γ ∈ kernelRoots (rootCharHom a), rootChar b γ = 1) :
    ∃ b' : Fin Tag.E6.rank → Lˣ, (∀ γ ∈ kernelRoots (rootCharHom a), rootChar b' γ = 1) ∧
      rootDiagUnit Tag.E6 b' = S.D.step (rootDiagUnit Tag.E6 b) := by
  obtain ⟨w, hn⟩ := S.D.n_weyl
  have hst : S.D.step = twFrob TwistTag.E6
      (canonicalRep (coxeterSystem TwistTag.E6.tag) L w) Fr := by
    ext1 g
    change S.D.n * S.D.Φ g * S.D.n⁻¹ = canonicalRep (coxeterSystem TwistTag.E6.tag) L w *
      twistHom TwistTag.E6 L Fr g * (canonicalRep (coxeterSystem TwistTag.E6.tag) L w)⁻¹
    rw [hΦ, hn]
    rfl
  have hstep : ∀ c, S.D.step (rootDiagUnit Tag.E6 c) = rootDiagUnit Tag.E6 (stepTuple w Fr c) :=
    step_iterate_rootDiagUnit hst 1
  have ha : stepTuple w Fr a = a :=
    CFSG.LieType.Chevalley.rootDiagUnit_injective
      ((hstep a).symm.trans (mem_twistedTorusOf.1 hT).2)
  refine ⟨stepTuple w Fr b, fun u hu => ?_, (hstep b).symm⟩
  have h1 : rootChar a u = 1 := hu.2
  rw [← ha, rootChar_stepTuple hFr] at h1
  have h2 : rootChar a (thetaLat w u) = 1 := by
    have h3 : Fr (rootChar a (thetaLat w u) : L) = Fr 1 := by
      rw [hFr (rootChar a (thetaLat w u) : L), map_one, ← Units.val_pow_eq_pow_val, h1,
        Units.val_one]
    exact Units.ext (Fr.injective h3)
  rw [rootChar_stepTuple hFr, hb _ ⟨isRoot_thetaLat w hu.1, h2⟩, one_pow]

theorem step_mem_charKerTorus (S : LangSetup Tag.E6 L p₀) {Fr : L →+* L}
    (hFr : ∀ c, Fr c = c ^ S.D.q) (hΦ : S.D.Φ = twistHom TwistTag.E6 L Fr)
    {a : Fin Tag.E6.rank → Lˣ} (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) {g : ModGL Tag.E6 L}
    (hg : g ∈ charKerTorus Tag.E6 L (kernelRoots (rootCharHom a))) :
    S.D.step g ∈ charKerTorus Tag.E6 L (kernelRoots (rootCharHom a)) := by
  obtain ⟨b, hb, rfl⟩ := mem_charKerTorus.1 hg
  exact mem_charKerTorus.2 (exists_step_rootDiagUnit S hFr hΦ hT hb)

theorem exists_centralizer_eq_sup_of_kernel (S : LangSetup Tag.E6 L p₀) {Fr : L →+* L}
    (hFr : ∀ c, Fr c = c ^ S.D.q) (hΦ : S.D.Φ = twistHom TwistTag.E6 L Fr)
    (h3 : ((3 : ℕ) : L) ≠ 0) (h3q : 3 ∣ S.D.q + 1) {a : Fin Tag.E6.rank → Lˣ}
    (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (hap : ∀ i, a i ^ 3 = 1)
    (hk : (kernelRoots (rootCharHom a)).ncard = 40) {H : Subgroup (ModGL Tag.E6 L)}
    (hmem : ∀ g, g ∈ H ↔ ∃ b : Fin Tag.E6.rank → Lˣ,
      (∀ γ ∈ kernelRoots (rootCharHom a), rootChar b γ = 1) ∧ rootDiagUnit Tag.E6 b = g)
    (hHQ : H ≤ Subgroup.centralizer
      (rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) : Set (ModGL Tag.E6 L)))
    (hbot : H ⊓ rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) = ⊥)
    (hsup : torusGroup Tag.E6 L ≤ H ⊔ rootSpan Tag.E6 L (kernelRoots (rootCharHom a)))
    (hcyc : ∀ Z : Subgroup (ModGL Tag.E6 L), Finite Z → Z ≤ H → IsCyclic Z) :
    ∃ Z R : Subgroup (ModGL Tag.E6 L),
      S.Γ ⊓ Subgroup.centralizer {rootDiagUnit Tag.E6 a} = Z ⊔ R ∧ IsCyclic Z ∧
        Z ≤ Subgroup.centralizer (R : Set (ModGL Tag.E6 L)) ∧ CFSG.IsQuasisimple R := by
  have hfin : (kernelRoots (rootCharHom a)).Finite :=
    (CFSG.Blueprint.Chevalley.finite_setOf_isRoot Tag.E6).subset fun γ hγ => hγ.1
  obtain ⟨α, hα⟩ : (kernelRoots (rootCharHom a)).Nonempty := by
    rw [← Set.ncard_pos hfin, hk]
    norm_num
  let i : KernelComponent (rootCharHom a) := ⟦⟨α, hα⟩⟧
  obtain ⟨_, _, -, -, hmodel⟩ := d5_class_strongModel S hFr hΦ h3 hT hap h3q hk i
  have hconn := toralCentralizer_eq_toralRootGroup_of_stabilizer_le Tag.E6 L a
    (e6_stab_le_kernelReflectionGroup_of_conn a hap (by rw [hk]; simp))
  have hQa : rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) ≤
      Subgroup.centralizer {rootDiagUnit Tag.E6 a} := by
    have h : rootSpan Tag.E6 L (kernelRoots (rootCharHom a)) ≤ toralRootGroup Tag.E6 L a :=
      le_sup_right
    rw [← hconn] at h
    exact h.trans inf_le_right
  have hHa : H ≤ Subgroup.centralizer {rootDiagUnit Tag.E6 a} := by
    intro x hx
    obtain ⟨b, -, rfl⟩ := (hmem x).1 hx
    refine Subgroup.mem_centralizer_iff.2 fun y hy => ?_
    rw [Set.mem_singleton_iff.1 hy, ← rootDiagUnit_mul, ← rootDiagUnit_mul, mul_comm]
  have hRQ := rationalComponent_le_rootSpan S hT i
  refine ⟨S.Γ ⊓ H, rationalComponent S.ρ S.Γ (rootCharHom a) i, le_antisymm ?_
    (sup_le (inf_le_inf_left _ hHa) (le_inf (rationalComponent_le_Γ S i) (hRQ.trans hQa))), ?_,
    inf_le_right.trans (hHQ.trans (Subgroup.centralizer_le (SetLike.coe_subset_coe.2 hRQ))),
    hmodel.2.1⟩
  · intro x hx
    obtain ⟨hxΓ, hxC⟩ := Subgroup.mem_inf.1 hx
    have hxM : x ∈ toralRootGroup Tag.E6 L a := by
      rw [← hconn]
      exact Subgroup.mem_inf.2 ⟨mem_adjointGroup_of_mem_Γ S hxΓ, hxC⟩
    obtain ⟨t, htH, -, g, hgQ, hgF, rfl⟩ := exists_fixed_split S.D.step
      (fun x hx y hy => by
        obtain ⟨b, -, rfl⟩ := (hmem x).1 hx
        obtain ⟨c, -, rfl⟩ := (hmem y).1 hy
        rw [← rootDiagUnit_mul, ← rootDiagUnit_mul, mul_comm])
      (hHQ.trans (Subgroup.centralizer_le_normalizer _))
      (fun h hh => by
        obtain ⟨b, hb, rfl⟩ := (hmem h).1 hh
        exact (hmem _).2 (exists_step_rootDiagUnit S hFr hΦ hT hb))
      (fun g hg => step_mem_rootSpan S (fun γ hγ => hγ.1)
        (fun γ hγ => rho_mem_kernelRoots_of_mem_torus S hT γ hγ) hg)
      (fun s hs => ⟨1, one_mem _, by
        rw [hbot, Subgroup.mem_bot] at hs
        rw [hs, map_one, inv_one, one_mul]⟩)
      (sup_le hsup le_sup_right hxM) (step_eq_of_mem_Γ S hxΓ)
    have hgR := mem_rationalComponent_of_step_eq S hFr hΦ h3 h3q hT hap hk i hgQ hgF
    have htΓ : t ∈ S.Γ := by
      have h := mul_mem hxΓ (inv_mem (rationalComponent_le_Γ S i hgR))
      rwa [mul_inv_cancel_right] at h
    exact Subgroup.mul_mem_sup (Subgroup.mem_inf.2 ⟨htΓ, htH⟩) hgR
  · haveI := S.finite
    have hle : S.Γ ⊓ H ≤ S.D.model :=
      inf_le_left.trans (Subgroup.commutator_le_self S.D.model)
    exact hcyc _ (Finite.of_injective _ (Subgroup.inclusion_injective hle)) inf_le_right

theorem exists_centralizer_eq_sup_d5 (S : LangSetup Tag.E6 L p₀) {Fr : L →+* L}
    (hFr : ∀ c, Fr c = c ^ S.D.q) (hΦ : S.D.Φ = twistHom TwistTag.E6 L Fr)
    (hL : ringChar L = 2) (h3q : 3 ∣ S.D.q + 1) {a : Fin Tag.E6.rank → Lˣ}
    (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (hap : ∀ i, a i ^ 3 = 1)
    (hk : (kernelRoots (rootCharHom a)).ncard = 40) :
    ∃ Z R : Subgroup (ModGL Tag.E6 L),
      S.Γ ⊓ Subgroup.centralizer {rootDiagUnit Tag.E6 a} = Z ⊔ R ∧ IsCyclic Z ∧
        Z ≤ Subgroup.centralizer (R : Set (ModGL Tag.E6 L)) ∧ CFSG.IsQuasisimple R := by
  haveI : CharP L 2 := ringChar.of_eq hL
  have h3 : ((3 : ℕ) : L) ≠ 0 := fun h =>
    absurd ((CharP.cast_eq_zero_iff L 2 3).1 h) (by omega)
  obtain ⟨v, J, hJ, hΨv⟩ := d5_position h3 hap hk
  refine exists_centralizer_eq_sup_of_kernel S hFr hΦ h3 h3q hT hap hk
    (H := charKerTorus Tag.E6 L (kernelRoots (rootCharHom a))) (fun _ => mem_charKerTorus)
    (charKerTorus_le_centralizer_rootSpan fun γ hγ => hγ.1) ?_ ?_ fun Z _ hZ => ?_
  · rw [hΨv]
    exact charKerTorus_inf_rootSpan v hJ
  · rw [hΨv]
    exact torusGroup_le_charKerTorus_sup v hJ
  · rw [hΨv] at hZ
    exact isCyclic_of_le_charKerTorus v hJ hZ

