private theorem concl_of_centerQuot {Y A : Type} [Group Y] [Group A] {f : ℕ}
    (eY : Y ≃* A ⧸ Subgroup.center A)
    (hA : (∃ (E : Type) (_ : Field E) (_ : Finite E), Nat.card E = 2 ^ f ∧
        Nonempty (A ≃* Matrix.SpecialLinearGroup (Fin 2) E)) ∨
      (∃ (b : ℕ) (E : Type) (_ : Field E) (_ : Finite E), 2 ≤ b ∧ Nat.card E = (2 ^ f) ^ 2 ∧
        Nonempty (A ≃* ↥(StatedSU b (2 ^ f) E))) ∨
      (Subgroup.center A = ⊥ ∧ ∃ s : ℕ, StatedClassicalModel A .POmegaPlus s 2 f ∨
        StatedClassicalModel A .POmegaMinus s 2 f)) :
    (∃ (b : ℕ) (E : Type) (_ : Field E) (_ : Finite E), 2 ≤ b ∧ Nat.card E = 2 ^ f ∧
        Nonempty (Y ≃* StatedProj (StatedSL b E))) ∨
      (∃ (b : ℕ) (E : Type) (_ : Field E) (_ : Finite E) (τ : E ≃+* E)
          (hτ : ∀ y, τ (τ y) = y), 2 ≤ b ∧ (∀ y, τ y = y ^ (2 ^ f)) ∧
          Nat.card E = (2 ^ f) ^ 2 ∧
          Nonempty (Y ≃* ↥(heldSU b E τ hτ) ⧸ Subgroup.center ↥(heldSU b E τ hτ))) ∨
      (∃ s : ℕ, StatedClassicalModel Y .POmegaPlus s 2 f ∨
        StatedClassicalModel Y .POmegaMinus s 2 f) := by
  rcases hA with ⟨E, _, _, hE, ⟨e⟩⟩ | ⟨b, E, _, _, hb, hE, ⟨e⟩⟩ | ⟨hZ, s, hM⟩
  · obtain ⟨eA⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_sl 2 e
    exact Or.inl ⟨2, E, inferInstance, inferInstance, le_rfl, hE, ⟨eY.trans eA⟩⟩
  · obtain ⟨τ, hτq, hτ⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GInnUni.exists_frob_equiv hE
    obtain ⟨eA⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_su rfl e τ hτ hτq
    exact Or.inr (Or.inl ⟨b, E, inferInstance, inferInstance, τ, hτ, hb, hτq, hE,
      ⟨eY.trans eA⟩⟩)
  · let eA : Y ≃* A :=
      eY.trans ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot)
    rcases hM with hM | hM
    · exact Or.inr (Or.inr ⟨s, Or.inl (StatedAPI.statedClassicalModel_of_mulEquiv eA.symm hM)⟩)
    · exact Or.inr (Or.inr ⟨s, Or.inr (StatedAPI.statedClassicalModel_of_mulEquiv eA.symm hM)⟩)

private theorem centralizer_one (X : Type*) [Group X] :
    Subgroup.centralizer ({(1 : X)} : Set X) = ⊤ :=
  eq_top_iff.mpr fun g _ => Subgroup.mem_centralizer_singleton_iff.mpr (by simp)

private theorem centerQuot_map_rho {K : Type} [Field K] [CharP K 2] {V : Type} [AddCommGroup V]
    [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    [Nontrivial V] {B : Subgroup (V ≃ₗ[K] V)} (hBΩ : B ≤ orthDerived Q)
    {J : Subgroup (ProjOrthDerived Q)}
    (hJ : J = (B.subgroupOf (orthDerived Q)).map
      (QuotientGroup.mk' ((scalars K V).subgroupOf (orthDerived Q)))) :
    Nonempty (↥J ⧸ Subgroup.center ↥J ≃* ↥B ⧸ Subgroup.center ↥B) := by
  have hρ : Function.Injective
      (QuotientGroup.mk' ((scalars K V).subgroupOf (orthDerived Q))) := by
    rw [← MonoidHom.ker_eq_bot_iff, QuotientGroup.ker_mk', eq_bot_iff]
    intro g hg
    exact Subgroup.mem_bot.mpr (Subtype.ext
      (CFSG.RankThree.PartOne.eq_one_of_mem_scalars_of_mem_orthDerived hQ g.2
        (Subgroup.mem_subgroupOf.mp hg)))
  subst hJ
  exact CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_of_mulEquiv
    (((B.subgroupOf (orthDerived Q)).equivMapOfInjective _ hρ).symm.trans
      (Subgroup.subgroupOfEquivOfLe hBΩ))

private theorem exists_lift {K : Type} [Field K] [Finite K] [CharP K 2] {V : Type}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V}
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hT : ∃ U : Submodule K V, Module.finrank K U = 3 ∧ ∀ u ∈ U, Q u = 0) {p : ℕ}
    (hp : p.Prime) (hp2 : p ≠ 2) (b : ProjOrthDerived Q) (hb : b ^ p = 1) :
    ∃ x : ↥(orthDerived Q), OddOrderIsometry Q p (x : V ≃ₗ[K] V) ∧
      Subgroup.centralizer ({b} : Set (ProjOrthDerived Q)) =
        centralizerImage Q (x : V ≃ₗ[K] V) := by
  haveI : Fact p.Prime := ⟨hp⟩
  have hpK : (p : K) ≠ 0 := by
    rw [Ne, CharP.cast_eq_zero_iff K 2]
    exact fun h2 => hp2 ((Nat.prime_dvd_prime_iff_eq Nat.prime_two hp).mp h2).symm
  by_cases h1 : b = 1
  · refine ⟨1, ⟨one_mem _, one_pow p, hpK, fun v hv => hQ.1 v fun w => by simpa using hv w⟩, ?_⟩
    rw [← CFSG.RankThree.PartOne.map_centralizer_eq_centralizerImage, h1, centralizer_one,
      centralizer_one, Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
  · obtain ⟨-, -, -, -, -, -, -, -, hlift⟩ :=
      CFSG.RankThree.Classical.orthogonal_high_Witt_derived_quotient_and_odd_lifts hQ hT
    obtain ⟨x, ⟨-, hxp⟩, -, hc⟩ := hlift p hp hp2 b (orderOf_eq_prime hb h1)
    exact ⟨x, oddOrderIsometry_of_orthDerived hp (by rw [ringChar.eq K 2]; exact hp2) hQ x hxp,
      hc.trans (CFSG.RankThree.PartOne.map_centralizer_eq_centralizerImage x)⟩

theorem tcjOrth_quotCenter_cases_ennola {G : Type} [Group G] [Finite G] {t : StatedLieTag}
    {m f p : ℕ} (ht : t = .POmegaPlus ∧ Even m ∨ t = .POmegaMinus ∧ Odd m)
    (hG : StatedClassicalModel G t m 2 f) (hp : p.Prime) (hp2 : p ≠ 2) (hpq : p ∣ 2 ^ f + 1)
    (a : G) (ha : a ^ p = 1) {J : Subgroup G}
    (hJ : CFSG.Open.IsComponentOf J (fixSubgroup (MulAut.conj a))) :
    (∃ (b : ℕ) (E : Type) (_ : Field E) (_ : Finite E), 2 ≤ b ∧ Nat.card E = 2 ^ f ∧
        Nonempty (↥J ⧸ Subgroup.center ↥J ≃* StatedProj (StatedSL b E))) ∨
      (∃ (b : ℕ) (E : Type) (_ : Field E) (_ : Finite E) (τ : E ≃+* E)
          (hτ : ∀ y, τ (τ y) = y), 2 ≤ b ∧ (∀ y, τ y = y ^ (2 ^ f)) ∧
          Nat.card E = (2 ^ f) ^ 2 ∧
          Nonempty (↥J ⧸ Subgroup.center ↥J ≃*
            ↥(heldSU b E τ hτ) ⧸ Subgroup.center ↥(heldSU b E τ hτ))) ∨
      (∃ s : ℕ, StatedClassicalModel (↥J ⧸ Subgroup.center ↥J) .POmegaPlus s 2 f ∨
        StatedClassicalModel (↥J ⧸ Subgroup.center ↥J) .POmegaMinus s 2 f) := by
  classical
  obtain ⟨K, _, _, V, _, _, _, Q, hQ, hT, hK, hdim, htype, ⟨e⟩⟩ :=
    exists_projOrth_model_type (ht.imp And.left And.left) hG
  have hplus : IsPlusType Q ↔ Even m := by
    rw [htype]
    rcases ht with ⟨rfl, hm⟩ | ⟨rfl, hm⟩
    · exact iff_of_true rfl hm
    · exact iff_of_false (fun h => by cases h) (Nat.not_even_iff_odd.mpr hm)
  have hf1 : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with h0 | h0
    · rw [h0, pow_zero] at hK
      exact absurd hK (Finite.one_lt_card (α := K)).ne'
    · exact h0
  haveI : CharP K 2 :=
    ringChar.of_eq (CFSG.ClassicalGroups.Orthogonal.ringChar_eq_of_card_eq Nat.prime_two hf1 hK)
  have hpq' : p ∣ Nat.card K + 1 := by rw [hK]; exact hpq
  haveI : Nontrivial V := by
    obtain ⟨U, hU, -⟩ := hT
    have := Submodule.finrank_le U
    exact Module.nontrivial_of_finrank_pos (R := K) (by omega)
  have hfix : fixSubgroup (MulAut.congr e (MulAut.conj a)) =
      (fixSubgroup (MulAut.conj a)).map (e : G →* ProjOrthDerived Q) := by
    ext y
    rw [mem_fixSubgroup]
    refine Iff.trans ?_ (Subgroup.mem_map_equiv (f := e)).symm
    rw [mem_fixSubgroup]
    show e (MulAut.conj a (e.symm y)) = y ↔ MulAut.conj a (e.symm y) = e.symm y
    exact e.eq_symm_apply.symm
  have hJ' : CFSG.Open.IsComponentOf (J.map (e : G →* ProjOrthDerived Q))
      (Subgroup.centralizer ({e a} : Set (ProjOrthDerived Q))) := by
    have h1 := CFSG.SignalizerFunctorTheorem.TransportA.isComponentOf_map e hJ
    rw [← hfix, CFSG.ComponentClassification.OuterAutomorphisms.congr_conj,
      CFSG.HardMathSupport.Solomon.Coordinator.b3Lie_fixSubgroup_conj] at h1
    exact h1
  obtain ⟨x, hx, hcent⟩ := exists_lift hQ hT hp hp2 (e a) (by rw [← map_pow, ha, map_one])
  rw [hcent] at hJ'
  obtain ⟨eG⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_of_mulEquiv
    (J.equivMapOfInjective (e : G →* ProjOrthDerived Q) e.injective)
  rcases CFSG.LocalAnalysis.GLTheoremA.KD264Lie.exists_component_dichotomy hp hp2 hQ hT
      (by rw [ringChar.eq K 2]; exact hp2) hx _ hJ' with
    ⟨h, hh, hne1, hq, hJeq⟩ | ⟨-, F, hFq, hFle, hFn, hJeq⟩
  ·
    have hBΩ : specialBlock Q (x : V ≃ₗ[K] V) h ≤ orthDerived Q :=
      specialBlock_le_orthDerived_of_perfect hq.1
        ((specialBlock_le_isometryCentralizer h).trans fun _ hg => (Subgroup.mem_inf.mp hg).1)
    obtain ⟨eB⟩ := centerQuot_map_rho hQ hBΩ hJeq
    refine concl_of_centerQuot (eG.trans eB) ?_
    rcases specialBlock_selfDual_ennola hx hp hp2 hpq' hh hne1 hq with
      ⟨E, _, _, hE, ⟨eS⟩⟩ | ⟨E, _, _, hm3, hE, ⟨eS⟩⟩
    · exact Or.inl ⟨E, inferInstance, inferInstance, hE.trans hK, ⟨eS⟩⟩
    · rw [hK] at hE eS
      exact Or.inr (Or.inl ⟨primaryMultiplicity (x : V ≃ₗ[K] V).toLinearMap h, E, inferInstance,
        inferInstance, by omega, hE, ⟨eS⟩⟩)
  ·
    have hFΩ : F ≤ orthDerived Q := hFle.trans hx.supportedFixedDerived_le_orthDerived
    obtain ⟨eB⟩ := centerQuot_map_rho hQ hFΩ hJeq
    let eS := supportedFixedDerivedEquiv hx
    let A := F.subgroupOf (supportedFixedDerived Q (x : V ≃ₗ[K] V))
    let eFL : ↥F ≃* ↥(A.map eS.toMonoidHom) := (Subgroup.subgroupOfEquivOfLe hFle).symm.trans
      (A.equivMapOfInjective eS.toMonoidHom eS.injective)
    obtain ⟨eZ⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_of_mulEquiv eFL
    refine concl_of_centerQuot ((eG.trans eB).trans eZ) ?_
    obtain ⟨s, -, hs, -, -, htypeW⟩ :=
      CFSG.HardMathSupport.Dickson.Bal207.OrthFix.fixed_type hx hp hp2 hpq' hdim hplus
    rcases orthDerived_quasisimple_normal_type hx.polarBilin_fixed_nondegenerate hK hs htypeW _
        (hFn.map eS.toMonoidHom eS.surjective)
        (CFSG.LocalCores.isQuasisimple_of_mulEquiv eFL hFq) with
      ⟨E, _, _, hE, ⟨eL⟩⟩ | ⟨E, _, _, hE, ⟨eL⟩⟩ | hL
    · exact Or.inl ⟨E, inferInstance, inferInstance, hE, ⟨eL⟩⟩
    · exact Or.inr (Or.inl ⟨4, E, inferInstance, inferInstance, by norm_num, hE, ⟨eL⟩⟩)
    · exact Or.inr (Or.inr hL)

