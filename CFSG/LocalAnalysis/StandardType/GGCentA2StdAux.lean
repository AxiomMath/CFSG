def ntpA2S_fixedField {L : Type} [Field L] (F : L →+* L) : Subfield L :=
  F.eqLocusField (RingHom.id L)

theorem ntpA2S_mem_fixedField {L : Type} [Field L] {F : L →+* L} {c : L} :
    c ∈ ntpA2S_fixedField F ↔ F c = c :=
  Iff.rfl

theorem ntpA2S_card_fixedField {L : Type} [Field L] [IsAlgClosed L] [CharP L 2]
    {f : ℕ} (hf : 1 ≤ f) (F : L →+* L) (hF : ∀ c, F c = c ^ 2 ^ f) :
    Nat.card (ntpA2S_fixedField F) = 2 ^ f := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rw [← natCard_setOf_pow_eq_self (Ω := L) (ℓ := 2) (e := f) (by omega)]
  exact Nat.card_congr (Equiv.subtypeEquivRight fun c => by
    simp only [Set.mem_setOf_eq, ntpA2S_mem_fixedField, hF])

theorem ntpA2S_card_fixedField_comp {L : Type} [Field L] [IsAlgClosed L] [CharP L 2]
    {f : ℕ} (hf : 1 ≤ f) (F : L →+* L) (hF : ∀ c, F c = c ^ 2 ^ f) :
    Nat.card (ntpA2S_fixedField (F.comp F)) = (2 ^ f) ^ 2 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have h2f : 2 * f ≠ 0 := by omega
  have he : (2 ^ f) ^ 2 = 2 ^ (2 * f) := by
    rw [pow_two, ← pow_add]
    congr 1
    omega
  rw [he, ← natCard_setOf_pow_eq_self (Ω := L) (ℓ := 2) (e := 2 * f) h2f]
  have hexp : 2 ^ f * 2 ^ f = 2 ^ (2 * f) := by
    rw [← pow_add]
    congr 1
    omega
  exact Nat.card_congr (Equiv.subtypeEquivRight fun c => by
    simp only [Set.mem_setOf_eq, ntpA2S_mem_fixedField, RingHom.comp_apply, hF, ← pow_mul, hexp])

def ntpA2S_splitFixedEquiv {L : Type} [Field L] (n : ℕ) (F : L →+* L) :
    Matrix.SpecialLinearGroup (Fin n) (ntpA2S_fixedField F) ≃*
      (Matrix.SpecialLinearGroup.map (n := Fin n) F).eqLocus (MonoidHom.id _) := by
  classical
  let k := ntpA2S_fixedField F
  have hFix : ∀ c : k, F (c : L) = c := fun c => (ntpA2S_mem_fixedField).mp c.2
  let toFun : Matrix.SpecialLinearGroup (Fin n) k →*
      Matrix.SpecialLinearGroup (Fin n) L :=
    (Matrix.SpecialLinearGroup.map F).comp (Matrix.SpecialLinearGroup.map k.subtype)
  have hcomp : ∀ Y : Matrix.SpecialLinearGroup (Fin n) k,
      Matrix.SpecialLinearGroup.map F (Matrix.SpecialLinearGroup.map k.subtype Y) =
        Matrix.SpecialLinearGroup.map k.subtype Y := by
    intro Y
    apply Subtype.ext
    ext i j
    simp only [Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply]
    exact hFix (Y i j)
  have hmem : ∀ Y, toFun Y ∈
      (Matrix.SpecialLinearGroup.map (n := Fin n) F).eqLocus (MonoidHom.id _) := by
    intro Y
    change Matrix.SpecialLinearGroup.map F (toFun Y) = toFun Y
    exact congrArg (Matrix.SpecialLinearGroup.map (n := Fin n) F) (hcomp Y)
  let f : Matrix.SpecialLinearGroup (Fin n) k →*
      (Matrix.SpecialLinearGroup.map (n := Fin n) F).eqLocus (MonoidHom.id _) :=
    toFun.codRestrict _ hmem
  have hinj : Function.Injective f := by
    intro Y Z h
    have h2 : toFun Y = toFun Z := congrArg Subtype.val h
    have hY : Matrix.SpecialLinearGroup.map k.subtype Y =
        Matrix.SpecialLinearGroup.map k.subtype Z :=
      (hcomp Y).symm.trans (h2.trans (hcomp Z))
    exact specialLinearGroup_map_injective k.subtype.injective hY
  have hsurj : Function.Surjective f := by
    rintro ⟨X, hX⟩
    have hentry : ∀ i j, F (X i j) = X i j := by
      intro i j
      have h := congrArg (fun Z : Matrix.SpecialLinearGroup (Fin n) L =>
        (Z : Matrix (Fin n) (Fin n) L) i j) hX
      simpa only [Matrix.SpecialLinearGroup.map_apply_coe, MonoidHom.id_apply,
        RingHom.mapMatrix_apply, Matrix.map_apply] using h
    let Y : Matrix (Fin n) (Fin n) k :=
      Matrix.of fun i j => ⟨X i j, (ntpA2S_mem_fixedField).mpr (hentry i j)⟩
    have hYX : k.subtype.mapMatrix Y = (X : Matrix (Fin n) (Fin n) L) := by
      ext i j
      rfl
    have hYdet : Y.det = 1 := by
      apply k.subtype.injective
      rw [RingHom.map_det, hYX, X.2, map_one]
    refine ⟨⟨Y, hYdet⟩, ?_⟩
    apply Subtype.ext
    show Matrix.SpecialLinearGroup.map F (Matrix.SpecialLinearGroup.map k.subtype ⟨Y, hYdet⟩) = X
    exact (hcomp ⟨Y, hYdet⟩).trans (Subtype.ext hYX)
  exact MulEquiv.ofBijective f ⟨hinj, hsurj⟩

def ntpA2S_splitFixedStatedEquiv {L : Type} [Field L] (n : ℕ) (F : L →+* L) :
    CFSG.Open.StatedSL n (ntpA2S_fixedField F) ≃*
      (Matrix.SpecialLinearGroup.map (n := Fin n) F).eqLocus (MonoidHom.id _) :=
  (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL n
    (ntpA2S_fixedField F)).symm.trans (ntpA2S_splitFixedEquiv n F)

theorem ntpA2S_entries_fixed {n q : ℕ} {L : Type} [Field L] (F : L →+* L)
    (hF : ∀ c, F c = c ^ q) (X : Matrix.SpecialLinearGroup (Fin n) L)
    (h : CFSG.ComponentClassification.CatalogueBGraphForm.slGraphAut n L
      (Matrix.SpecialLinearGroup.map F X) = X) :
    ∀ i j, (X : Matrix (Fin n) (Fin n) L) i j ^ q ^ 2 = (X : Matrix (Fin n) (Fin n) L) i j := by
  let Φ : Matrix.SpecialLinearGroup (Fin n) L →*
      Matrix.SpecialLinearGroup (Fin n) L :=
    (CFSG.ComponentClassification.CatalogueBGraphForm.slGraphAut n L).toMonoidHom.comp
      (Matrix.SpecialLinearGroup.map F)
  have hΦ : Φ X = X := h
  have hΦ2 : Φ (Φ X) = X := by rw [hΦ, hΦ]
  have hcomp : Φ (Φ X) = Matrix.SpecialLinearGroup.map (F.comp F) X := by
    change CFSG.ComponentClassification.CatalogueBGraphForm.slGraphAut n L
        (Matrix.SpecialLinearGroup.map F
          (CFSG.ComponentClassification.CatalogueBGraphForm.slGraphAut n L
            (Matrix.SpecialLinearGroup.map F X))) =
      Matrix.SpecialLinearGroup.map (F.comp F) X
    rw [CFSG.SeitzReduction.E6Pilot.map_slGraphAut, ← MulAut.mul_apply, ← pow_two,
      slGraphAut_sq, MulAut.one_apply]
    exact DFunLike.congr_fun (Matrix.SpecialLinearGroup.map_comp F F) X
  have hfix2 : Matrix.SpecialLinearGroup.map (F.comp F) X = X := by
    rw [← hcomp, hΦ2]
  intro i j
  have h2 : (F.comp F) ((X : Matrix (Fin n) (Fin n) L) i j) =
      (X : Matrix (Fin n) (Fin n) L) i j := by
    have := congrArg (fun Y : Matrix.SpecialLinearGroup (Fin n) L =>
      (Y : Matrix (Fin n) (Fin n) L) i j) hfix2
    simpa only [Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply,
      RingHom.comp_apply, Matrix.map_apply] using this
  rw [RingHom.comp_apply, hF, hF] at h2
  rwa [← pow_mul, ← pow_two] at h2

theorem ntpA2S_unitaryEquation {n q : ℕ} {L : Type} [Field L] (F : L →+* L)
    (hF : ∀ c, F c = c ^ q) (X : Matrix.SpecialLinearGroup (Fin n) L)
    (h : CFSG.ComponentClassification.CatalogueBGraphForm.slGraphAut n L
      (Matrix.SpecialLinearGroup.map F X) = X) :
    (((X : Matrix (Fin n) (Fin n) L).map (· ^ q))ᵀ) *
      (X : Matrix (Fin n) (Fin n) L) = 1 := by
  set Z : Matrix (Fin n) (Fin n) L :=
    ((Matrix.SpecialLinearGroup.map F X : Matrix.SpecialLinearGroup (Fin n) L) :
      Matrix (Fin n) (Fin n) L) with hZ
  set W : Matrix (Fin n) (Fin n) L := (X : Matrix (Fin n) (Fin n) L) with hW
  have hZeq : Z = F.mapMatrix W := by
    rw [hZ, hW, Matrix.SpecialLinearGroup.map_apply_coe]
  have hZdet : Z.det = 1 := by
    rw [hZeq, ← RingHom.map_det, X.2, map_one]
  have hZW : Z * Wᵀ = 1 := by
    have h1 : (Z⁻¹)ᵀ = W := by
      have h' := congrArg (fun Y : Matrix.SpecialLinearGroup (Fin n) L =>
        (Y : Matrix (Fin n) (Fin n) L)) h
      rw [hZ, hW]
      simpa only [CFSG.ComponentClassification.CatalogueBGraphForm.slGraphAut_matrix,
        coe_inv_eq_nonsing_inv] using h'
    have h2 : Z⁻¹ = Wᵀ := by
      have := congrArg Matrix.transpose h1
      simpa only [Matrix.transpose_transpose] using this
    rw [← h2, Matrix.mul_nonsing_inv Z (hZdet ▸ isUnit_one)]
  have hWZ : W * Zᵀ = 1 := by
    have := congrArg Matrix.transpose hZW
    simpa only [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.transpose_one] using this
  have hZTW : Zᵀ * W = 1 := mul_eq_one_comm.mp hWZ
  have hZq : Z = W.map (· ^ q) := by
    rw [hZeq, hW]
    ext i j
    simp only [Matrix.map_apply, RingHom.mapMatrix_apply, hF]
  rwa [hZq] at hZTW

theorem ntpA2S_graph_eq_self_iff {n f : ℕ} {L : Type} [Field L]
    (F : L →+* L) (hF : ∀ c, F c = c ^ 2 ^ f)
    (X : Matrix.SpecialLinearGroup (Fin n) L) :
    CFSG.ComponentClassification.CatalogueBGraphForm.slGraphAut n L
        (Matrix.SpecialLinearGroup.map F X) = X ↔
      Matrix.SpecialLinearGroup.toGL X ∈ unitarySet (2 ^ f) n := by
  constructor
  · intro h
    exact ⟨ntpA2S_entries_fixed F hF X h, X.2, ntpA2S_unitaryEquation F hF X h⟩
  · rintro ⟨hent, hdet, huni⟩
    apply Subtype.ext
    set Z : Matrix (Fin n) (Fin n) L :=
      ((Matrix.SpecialLinearGroup.map F X : Matrix.SpecialLinearGroup (Fin n) L) :
        Matrix (Fin n) (Fin n) L) with hZ
    set W : Matrix (Fin n) (Fin n) L := (X : Matrix (Fin n) (Fin n) L) with hW
    have hZq : Z = W.map (· ^ 2 ^ f) := by
      rw [hZ, hW, Matrix.SpecialLinearGroup.map_apply_coe]
      ext i j
      simp only [Matrix.map_apply, RingHom.mapMatrix_apply, hF]
    have huni' : Zᵀ * W = 1 := by
      rw [hZq]
      simpa only [hW, Matrix.SpecialLinearGroup.coe_GL_coe_matrix] using huni
    have hWinv : W = (Zᵀ)⁻¹ := (Matrix.inv_eq_right_inv huni').symm
    have hWeq : W = (Z⁻¹)ᵀ := by
      rw [hWinv, Matrix.transpose_nonsing_inv]
    rw [CFSG.ComponentClassification.CatalogueBGraphForm.slGraphAut_matrix,
      coe_inv_eq_nonsing_inv, hWeq]

def ntpA2S_unitaryFixedEquiv {L : Type} [Field L] [IsAlgClosed L] [CharP L 2]
    (n f : ℕ) (hn : 1 ≤ n) (hf : 1 ≤ f) (F : L →+* L) (hF : ∀ c, F c = c ^ 2 ^ f) :
    CFSG.Open.StatedSU n (2 ^ f) (ntpA2S_fixedField (F.comp F)) ≃*
      ((CFSG.ComponentClassification.CatalogueBGraphForm.slGraphAut n L).toMonoidHom.comp
        (Matrix.SpecialLinearGroup.map (n := Fin n) F)).eqLocus (MonoidHom.id _) := by
  classical
  let F₂ := ntpA2S_fixedField (F.comp F)
  have hmemF₂ : ∀ c : L, c ∈ F₂ ↔ c ^ (2 ^ f) ^ 2 = c := by
    intro c
    rw [ntpA2S_mem_fixedField, RingHom.comp_apply, hF, hF, ← pow_mul, pow_two]
  have hcardF₂ : Nat.card F₂ = (2 ^ f) ^ 2 := ntpA2S_card_fixedField_comp hf F hF
  let Φ : Matrix.SpecialLinearGroup (Fin n) L →*
      Matrix.SpecialLinearGroup (Fin n) L :=
    (CFSG.ComponentClassification.CatalogueBGraphForm.slGraphAut n L).toMonoidHom.comp
      (Matrix.SpecialLinearGroup.map F)
  let Ψ : CFSG.Open.StatedSU n (2 ^ f) F₂ →*
      Matrix.SpecialLinearGroup (Fin n) L := statedSUToSL F₂ n (2 ^ f)
  have hΨinj : Function.Injective Ψ := statedSUToSL_injective F₂ n (2 ^ f)
  have hmem : ∀ Y, Ψ Y ∈ Φ.eqLocus (MonoidHom.id _) := by
    intro Y
    change CFSG.ComponentClassification.CatalogueBGraphForm.slGraphAut n L
      (Matrix.SpecialLinearGroup.map F (Ψ Y)) = Ψ Y
    have huni : Matrix.SpecialLinearGroup.toGL (Ψ Y) ∈ unitarySet (2 ^ f) n :=
      (mem_range_statedSUToSL_iff (ℓ := 2) (f := f) Nat.prime_two F₂ hmemF₂ hcardF₂
        hn (Ψ Y)).mp ⟨Y, rfl⟩
    exact (ntpA2S_graph_eq_self_iff F hF (Ψ Y)).mpr huni
  let eFun := Ψ.codRestrict _ hmem
  have hinj : Function.Injective eFun := by
    intro Y Z h
    exact hΨinj (congrArg Subtype.val h)
  have hsurj : Function.Surjective eFun := by
    rintro ⟨X, hX⟩
    have huni : Matrix.SpecialLinearGroup.toGL X ∈ unitarySet (2 ^ f) n :=
      (ntpA2S_graph_eq_self_iff F hF X).mp hX
    obtain ⟨Y, hY⟩ := (mem_range_statedSUToSL_iff (ℓ := 2) (f := f) Nat.prime_two F₂
      hmemF₂ hcardF₂ hn X).mpr huni
    exact ⟨Y, Subtype.ext hY⟩
  exact MulEquiv.ofBijective eFun ⟨hinj, hsurj⟩

theorem ntpA2S_isQuasisimple_split {L : Type} [Field L] [IsAlgClosed L] [CharP L 2]
    {f : ℕ} (hf : 1 ≤ f) (F : L →+* L) (hF : ∀ c, F c = c ^ 2 ^ f) :
    CFSG.IsQuasisimple ↥((Matrix.SpecialLinearGroup.map (n := Fin 3) F).eqLocus
      (MonoidHom.id _)) := by
  have hk := ntpA2S_card_fixedField hf F hF
  haveI : Finite (ntpA2S_fixedField F) :=
    Nat.finite_of_card_ne_zero (by rw [hk]; positivity)
  exact CFSG.LocalCores.isQuasisimple_of_mulEquiv (ntpA2S_splitFixedStatedEquiv 3 F)
    (CFSG.Open.StatedAPI.isQuasisimple_statedSL_of_two_le (m := 2) (by norm_num)
      (ntpA2S_fixedField F))

theorem ntpA2S_isQuasisimple_unitary {L : Type} [Field L] [IsAlgClosed L] [CharP L 2]
    {f : ℕ} (hf : 1 ≤ f) (hq : 2 < 2 ^ f) (F : L →+* L) (hF : ∀ c, F c = c ^ 2 ^ f) :
    CFSG.IsQuasisimple ↥(((slGraphAut 3 L).toMonoidHom.comp
      (Matrix.SpecialLinearGroup.map (n := Fin 3) F)).eqLocus (MonoidHom.id _)) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hcard := ntpA2S_card_fixedField_comp hf F hF
  haveI : Finite (ntpA2S_fixedField (F.comp F)) :=
    Nat.finite_of_card_ne_zero (by rw [hcard]; positivity)
  have hqne : (3, 2 ^ f) ≠ (3, 2) := by
    intro h
    have := congrArg Prod.snd h
    omega
  exact CFSG.LocalCores.isQuasisimple_of_mulEquiv (ntpA2S_unitaryFixedEquiv 3 f (by omega) hf F hF)
    (CFSG.LieType.Universal.Unitary.isQuasisimple_statedSU_of_card (p := 2) (f := f)
      (F := ntpA2S_fixedField (F.comp F)) hcard (by norm_num) hqne).1

def ntpA2S_splitProjEquiv {n : ℕ} {K P : Type} [Field K] [Group P]
    (e : CFSG.Open.StatedSL n K ≃* P) :
    P ⧸ Subgroup.center P ≃* CFSG.Assembly.LowTwoRank.StatedProj
      (CFSG.Open.StatedSL n K) :=
  (QuotientGroup.congr _ _ e (Subgroup.map_center_eq e)).symm.trans
    (QuotientGroup.quotientMulEquivOfEq (by
      rw [← Subgroup.map_center_eq
          (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL n K),
        CFSG.Assembly.LowTwoRank.map_center_eq_statedScalars n K]))

def ntpA2S_unitaryProjEquiv {K P : Type} [Field K] [Group P] (n q : ℕ)
    (e : CFSG.Open.StatedSU n q K ≃* P)
    (hZ : Subgroup.center (CFSG.Open.StatedSU n q K) =
      (CFSG.Assembly.LowTwoRank.StatedScalars (Fin n) K).subgroupOf
        (CFSG.Open.StatedSU n q K)) :
    P ⧸ Subgroup.center P ≃* CFSG.Assembly.LowTwoRank.StatedProj
      (CFSG.Open.StatedSU n q K) :=
  (QuotientGroup.congr _ _ e (Subgroup.map_center_eq e)).symm.trans
    (QuotientGroup.quotientMulEquivOfEq hZ)

