private theorem ggInvolCentTyped_congr_aux {X : Type} [Group X] {G₀ G₁ : Subgroup X} {r r' : X}
    (hG : G₀ = G₁)
    (h : Subgroup.centralizer ({r} : Set X) ⊓ G₁ =
      Subgroup.centralizer ({r'} : Set X) ⊓ G₁) :
    GGInvolCentTyped G₀ r ↔ GGInvolCentTyped G₁ r' := by
  let A : Subgroup X := Subgroup.centralizer ({r} : Set X) ⊓ G₀
  let B : Subgroup X := Subgroup.centralizer ({r'} : Set X) ⊓ G₁
  have hAB : A = B := by
    dsimp only [A, B]
    rw [hG, h]
  let e : ↥A ≃* ↥B := MulEquiv.subgroupCongr hAB
  have hpc : (CFSG.Open.pCore 2 ↥A).map e.toMonoidHom = CFSG.Open.pCore 2 ↥B :=
    CFSG.pCore_map_iso 2 e
  have hq : IsChevTwoLayered (↥A ⧸ CFSG.Open.pCore 2 ↥A) ↔
      IsChevTwoLayered (↥B ⧸ CFSG.Open.pCore 2 ↥B) :=
    IsChevTwoLayered.mulEquiv_iff
      (QuotientGroup.congr (CFSG.Open.pCore 2 ↥A) (CFSG.Open.pCore 2 ↥B) e hpc)
  simpa [GGInvolCentTyped, GGInvolCentBar, A, B] using hq

theorem ggInvolCentTyped_congr {X : Type} [Group X] {G₀ : Subgroup X} {r r' : X}
    (h : Subgroup.centralizer ({r} : Set X) ⊓ G₀ =
      Subgroup.centralizer ({r'} : Set X) ⊓ G₀) :
    GGInvolCentTyped G₀ r ↔ GGInvolCentTyped G₀ r' :=
  ggInvolCentTyped_congr_aux rfl h

private theorem ggInvolCentTyped_subgroup_congr {X : Type} [Group X] {G₀ G₁ : Subgroup X}
    {r : X} (h : G₀ = G₁) : GGInvolCentTyped G₀ r ↔ GGInvolCentTyped G₁ r :=
  ggInvolCentTyped_congr_aux h rfl

private theorem ggInvolCentTyped_top_of_sup_eq {U : Type} [Group U] [Finite U] {y : U}
    {Q L : Subgroup U} (hQ2 : IsPGroup 2 Q)
    (hLQ : L ≤ Subgroup.normalizer (Q : Set U))
    (hC : Subgroup.centralizer ({y} : Set U) = Q ⊔ L)
    (hL : IsChevTwoLayered ↥L) : GGInvolCentTyped (⊤ : Subgroup U) y :=
  ggInvolCentTyped_of_sup_eq hQ2 hLQ (by rw [inf_top_eq, hC]) hL

private theorem ggInvolCentTyped_range_of_top {U X : Type} [Group U] [Group X]
    {ψ : U →* X} (hψ : Function.Injective ψ) {y : U}
    (h : GGInvolCentTyped (⊤ : Subgroup U) y) : GGInvolCentTyped ψ.range (ψ y) :=
  (ggInvolCentTyped_subgroup_congr (Subgroup.map_top ψ)).mp
    ((ggInvolCentTyped_map_iff_of_injective ψ hψ (⊤ : Subgroup U) y).2 h)

private theorem ggInvolCentTyped_top_siegDiag {n : ℕ} {F : Type} [Field F] [Finite F]
    [CharP F 2] (i : Fin n) :
    GGInvolCentTyped (⊤ : Subgroup (StatedSp n F)) (siegDiag F i 1) := by
  haveI : Fintype F := Fintype.ofFinite F
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by have := i.isLt; omega⟩
  have hL : IsChevTwoLayered ↥(complSp F i) :=
    (isChevTwoLayered_statedSp m F).of_mulEquiv (complSpEquiv (K := F) i).symm
  exact ggInvolCentTyped_top_of_sup_eq (isPGroup_transvRadical (K := F) (p := i))
    (complSp_le_normalizer_transvRadical (K := F) (p := i))
    (centralizer_siegDiag_eq_sup (K := F) (p := i)) hL

private theorem ggInvolCentTyped_top_short_two {F : Type} [Field F] [Finite F] [CharP F 2]
    {i j : Fin 2} (hij : i ≠ j) :
    GGInvolCentTyped (⊤ : Subgroup (StatedSp 2 F)) (twoCentralElt 2 i j (0 : F) 1) := by
  haveI : Fintype F := Fintype.ofFinite F
  have hC : Subgroup.centralizer ({twoCentralElt 2 i j (0 : F) 1} :
      Set (StatedSp 2 F)) = wRadical F i j ⊔ (shortBlock F hij).range := by
    refine le_antisymm ?_ (sup_le (wRadical_le_centralizer_twoCentralElt 0 1) ?_)
    · have h := centralizer_a2_le_of_ne (K := F) hij
      rwa [suppGroup_offPQ_two hij, sup_bot_eq] at h
    · rintro _ ⟨A, rfl⟩
      exact shortBlock_mem_centralizer hij A 1
  have hCN : Subgroup.centralizer ({twoCentralElt 2 i j (0 : F) 1} :
      Set (StatedSp 2 F)) ≤ normalizer (wRadical F i j : Set (StatedSp 2 F)) := by
    rw [centralizer_twoCentralElt_eq_sup hij (one_ne_zero (α := F))]
    exact sup_le le_normalizer (range_leviHom_le_normalizer_wRadical hij one_ne_zero)
  have hLQ : (shortBlock F hij).range ≤
      normalizer (wRadical F i j : Set (StatedSp 2 F)) := by
    rw [hC] at hCN
    exact le_sup_right.trans hCN
  have hL : IsChevTwoLayered ↥((shortBlock F hij).range) :=
    (isChevTwoLayered_specialLinear (Fin 2) F).of_mulEquiv
      (MonoidHom.ofInjective (f := shortBlock F hij) (shortBlock_injective hij)).symm
  exact ggInvolCentTyped_top_of_sup_eq (isPGroup_wRadical hij) hLQ hC hL

private theorem ggInvolCentTyped_top_short {F : Type} [Field F] [Finite F] [CharP F 2]
    (n : ℕ) :
    GGInvolCentTyped (⊤ : Subgroup (StatedSp (n + 3) F))
      (twoCentralElt (n + 3) 1 2 (0 : F) 1) := by
  haveI : Fintype F := Fintype.ofFinite F
  have h12 := one_ne_two_fin (n := n)
  set S : Subgroup (StatedSp (n + 3) F) := (shortBlock F h12).range with hS
  set T : Subgroup (StatedSp (n + 3) F) := spCompl12 F n with hT
  obtain ⟨hC, hSQ, hTQ, hST⟩ := centralizer_a2_facts (F := F) (n := n)
  have hS' : IsChevTwoLayered ↥(S.subgroupOf (S ⊔ T)) :=
    (isChevTwoLayered_specialLinear (Fin 2) F).of_mulEquiv
      ((Subgroup.subgroupOfEquivOfLe (le_sup_left : S ≤ S ⊔ T)).trans
        (MonoidHom.ofInjective (f := shortBlock F h12) (shortBlock_injective h12)).symm)
  have hT' : IsChevTwoLayered ↥(T.subgroupOf (S ⊔ T)) :=
    (isChevTwoLayered_statedSp (n + 1) F).of_mulEquiv
      ((Subgroup.subgroupOfEquivOfLe (le_sup_right : T ≤ S ⊔ T)).trans
        (spCompl12Equiv F n).symm)
  have hsup : S.subgroupOf (S ⊔ T) ⊔ T.subgroupOf (S ⊔ T) = ⊤ := by
    rw [← Subgroup.subgroupOf_sup (le_sup_left : S ≤ S ⊔ T) (le_sup_right : T ≤ S ⊔ T)]
    exact Subgroup.subgroupOf_self (S ⊔ T)
  have hcomm : ∀ a ∈ S.subgroupOf (S ⊔ T), ∀ b ∈ T.subgroupOf (S ⊔ T), Commute a b := by
    intro a ha b hb
    have ha' : ((a : ↥(S ⊔ T)) : StatedSp (n + 3) F) ∈ S := ha
    have hb' : ((b : ↥(S ⊔ T)) : StatedSp (n + 3) F) ∈ T := hb
    refine Subtype.ext ?_
    exact (Subgroup.mem_centralizer_iff.mp (hST ha') _ hb').symm
  have hL : IsChevTwoLayered ↥(S ⊔ T) :=
    IsChevTwoLayered.of_commute_sup _ _ hcomm hsup hS' hT'
  exact ggInvolCentTyped_top_of_sup_eq (isPGroup_wRadical h12) (sup_le hSQ hTQ) hC hL

section Tags

theorem ggRootInvolCentTypedTag_PSp : GGRootInvolCentTypedTag .PSp := by
  intro X _ _ n f ψ _ _ hker _ r hr
  let ψ' : StatedSp n (GaloisField 2 f) →* X := ψ
  have hker' : ψ'.ker ≤ Subgroup.center (StatedSp n (GaloisField 2 f)) := hker
  have hr' : GGRootInvolution (rootDatum n (GaloisField 2 f)) .PSp ψ' r := hr
  change GGInvolCentTyped ψ'.range r
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hψ : Function.Injective ψ' := by
    rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
    exact hker'.trans (center_statedSp_eq_bot (K := GaloisField 2 f) n).le
  obtain ⟨hr2, γ, hγ, u, hru⟩ := hr'
  obtain ⟨-, ⟨x, hx, rfl⟩, rfl⟩ := hru
  have hx1 : x ≠ 1 := by
    rintro rfl
    simp at hr2
  obtain ⟨ρ, hρ⟩ := exists_stdVec_of_mem_roots hγ.1
  obtain ⟨c, rfl⟩ := (mem_rootGroup_iff hρ).1 hx
  have hc : c ≠ 0 := by
    rintro rfl
    exact hx1 (elt_zero ρ)
  have hgoal : GGInvolCentTyped (⊤ : Subgroup (StatedSp n (GaloisField 2 f))) (elt ρ c) := by
    have hcongr : GGInvolCentTyped (⊤ : Subgroup (StatedSp n (GaloisField 2 f))) (elt ρ c) ↔
        GGInvolCentTyped (⊤ : Subgroup (StatedSp n (GaloisField 2 f))) (elt ρ 1) := by
      refine ggInvolCentTyped_congr ?_
      simpa using centralizer_elt_eq (F := GaloisField 2 f) ρ hc
    refine hcongr.mpr ?_
    rcases elt_one_eq_conj (F := GaloisField 2 f) ρ with ⟨g, i, hg⟩ | ⟨g, i, j, hij, hg⟩
    ·
      rw [hg]
      exact (ggInvolCentTyped_conj_iff
        (G₀ := (⊤ : Subgroup (StatedSp n (GaloisField 2 f))))
        (r := siegDiag (GaloisField 2 f) i 1) (g := g)
        (Subgroup.le_normalizer (Subgroup.mem_top g))).mpr
        (ggInvolCentTyped_top_siegDiag (F := GaloisField 2 f) i)
    · by_cases hn3 : 3 ≤ n
      ·
        obtain ⟨m, rfl⟩ : ∃ m, n = m + 3 := ⟨n - 3, by omega⟩
        obtain ⟨g', hg'⟩ := exists_conj_one_two (F := GaloisField 2 f) (n := m) hij
        rw [hg]
        refine (ggInvolCentTyped_conj_iff
          (G₀ := (⊤ : Subgroup (StatedSp (m + 3) (GaloisField 2 f))))
          (r := twoCentralElt (m + 3) i j (0 : GaloisField 2 f) 1) (g := g)
          (Subgroup.le_normalizer (Subgroup.mem_top g))).mpr ?_
        rw [hg']
        exact (ggInvolCentTyped_conj_iff
          (G₀ := (⊤ : Subgroup (StatedSp (m + 3) (GaloisField 2 f))))
          (r := twoCentralElt (m + 3) 1 2 (0 : GaloisField 2 f) 1) (g := g')
          (Subgroup.le_normalizer (Subgroup.mem_top g'))).mpr
          (ggInvolCentTyped_top_short (F := GaloisField 2 f) m)
      ·
        have hn2 : n = 2 := by omega
        subst hn2
        rw [hg]
        exact (ggInvolCentTyped_conj_iff
          (G₀ := (⊤ : Subgroup (StatedSp 2 (GaloisField 2 f))))
          (r := twoCentralElt 2 i j (0 : GaloisField 2 f) 1) (g := g)
          (Subgroup.le_normalizer (Subgroup.mem_top g))).mpr
          (ggInvolCentTyped_top_short_two (F := GaloisField 2 f) hij)
  have hrange : GGInvolCentTyped ψ'.range (ψ' (elt ρ c)) :=
    ggInvolCentTyped_range_of_top hψ hgoal
  have hEq : ψ' ((MulEquiv.toMonoidHom (MulAut.conj u)) (elt ρ c)) =
      ψ' u * ψ' (elt ρ c) * (ψ' u)⁻¹ := by
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, map_mul, map_inv]
  rw [hEq]
  exact (ggInvolCentTyped_conj_iff (G₀ := ψ'.range) (r := ψ' (elt ρ c)) (g := ψ' u)
    (Subgroup.le_normalizer ⟨u, rfl⟩)).mpr hrange

