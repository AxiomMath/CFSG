private lemma l10scsua_map_ne_bot_of_isPGroup_two_of_odd_ker
    {U X : Type} [Group U] [Group X] {ψ : U →* X} (hodd : Odd (Nat.card ψ.ker))
    {S : Subgroup U} (hS : IsPGroup 2 S) (hSne : S ≠ ⊥) : S.map ψ ≠ ⊥ := by
  intro hbot
  rw [Subgroup.map_eq_bot_iff] at hbot
  have hdisj : S ⊓ ψ.ker = ⊥ := by
    rw [Subgroup.eq_bot_iff_forall]
    intro x hx
    obtain ⟨hxS, hxK⟩ := hx
    obtain ⟨k, hk⟩ := (isPGroup_iff_orderOf_dvd_pow.mp hS) ⟨x, hxS⟩
    rw [Subgroup.orderOf_mk] at hk
    have hdvd : orderOf x ∣ Nat.card ψ.ker := Subgroup.orderOf_dvd_natCard ψ.ker hxK
    exact orderOf_eq_one_iff.mp
      (Nat.eq_one_of_dvd_coprimes (hodd.coprime_two_left.pow_left k) hk hdvd)
  have hle : S ≤ ⊥ := by
    rw [← hdisj]
    exact fun x hx => ⟨hx, hbot hx⟩
  exact hSne (le_bot_iff.mp hle)

private theorem l10scsua_coreFour_one_setup {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n)
    {β : Fin (Unitary.rootDatum hF n).rank → ℤ} (hl : GGLongRoot (Unitary.rootDatum hF n) β) :
    ∃ v w : Fin n → F, v ≠ 0 ∧
      uForm (unitaryInvolution F 2 f) v v = 0 ∧
      uForm (unitaryInvolution F 2 f) w w = 0 ∧
      uForm (unitaryInvolution F 2 f) v w = 1 ∧
      IsUTransGroup (unitaryInvolution F 2 f) v ((Unitary.rootDatum hF n).rootGroup β) ∧
      pCoreOf 2 (Subgroup.normalizer
        ((((Unitary.rootDatum hF n).rootGroup β) :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n))) ≤
        uRad (unitaryInvolution F 2 f) v := by
  haveI : Fintype F := Fintype.ofFinite F
  have hσ : ∀ c, unitaryInvolution F 2 f (unitaryInvolution F 2 f c) = c :=
    CFSG.LieType.BorelTits.unitaryInvolution_involutive hF
  have htr : ∀ c, unitaryInvolution F 2 f c = c →
      ∃ e, e + unitaryInvolution F 2 f e = c :=
    fun _ hx => CFSG.LieType.BorelTits.exists_add_unitaryInvolution_eq hF hx
  have hβ := l10su4_mem_roots hF hl
  obtain ⟨i, hi, hβi⟩ := l10su4_exists_weight_of_ggLongRoot hF hβ hl
  let v : Fin n → F := Pi.single i 1
  let w : Fin n → F := Pi.single (Fin.rev i) 1
  have hT : IsUTransGroup (unitaryInvolution F 2 f) v ((Unitary.rootDatum hF n).rootGroup β) := by
    change IsUTransGroup (unitaryInvolution F 2 f) (Pi.single i 1)
      (Unitary.rootGroup (unitaryInvolution F 2 f)
        (CFSG.LieType.BorelTits.unitaryInvolution_involutive hF) n β)
    exact isUTransGroup_rootGroup_long' hσ hi hβi
  have haa : uForm (unitaryInvolution F 2 f) v v = 0 :=
    uForm_single_self (σ := unitaryInvolution F 2 f) hi
  have hdd : uForm (unitaryInvolution F 2 f) w w = 0 := by
    change uForm (unitaryInvolution F 2 f) (Pi.single (Fin.rev i) 1)
      (Pi.single (Fin.rev i) 1) = 0
    exact uForm_single_self (σ := unitaryInvolution F 2 f)
      (fun h => hi (by rw [Fin.rev_rev] at h; exact h.symm))
  have had : uForm (unitaryInvolution F 2 f) v w = 1 := by
    change uForm (unitaryInvolution F 2 f) (Pi.single i 1) (Pi.single (Fin.rev i) 1) = 1
    rw [uForm_single_right, Fin.rev_rev, Pi.single_eq_same, map_one]
  have hv0 : v ≠ 0 := by
    intro h
    have := congrFun h i
    simp [v] at this
  have hQle : pCoreOf 2 (Subgroup.normalizer
        ((((Unitary.rootDatum hF n).rootGroup β) :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n))) ≤
        uRad (unitaryInvolution F 2 f) v := by
    by_cases hn3 : n = 3
    · subst hn3
      have hm : (1 : Fin 3) = Fin.rev 1 := by decide
      have hmi : (1 : Fin 3) ≠ i := by fin_cases i <;> simp_all
      have hmri : (1 : Fin 3) ≠ Fin.rev i := by fin_cases i <;> simp_all
      let Θ := suThetaFacts_holds hσ htr haa hdd had hT
      exact l10su4_pCore_le_uRad_three hσ hi hm hmi hmri hT Θ
    · have hn4 : 4 ≤ n := by omega
      have hnorm : ∀ x, unitaryInvolution F 2 f x = x →
          ∃ a, unitaryInvolution F 2 f a * a = x :=
        fun _ hx => CFSG.LieType.Universal.Unitary.exists_norm_eq hF hx
      have hG : SUGeomFacts (unitaryInvolution F 2 f) v w :=
        suGeomFacts_holds hσ htr hnorm hn4 haa hdd had
      let Θ := suThetaFacts_holds hσ htr haa hdd had hT
      exact (pCoreOf_normalizer_eq_uRad hσ hv0 hT Θ hG).le
  exact ⟨v, w, hv0, haa, hdd, had, hT, hQle⟩

private theorem l10scsua_coreFour_one {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n)
    {β : Fin (Unitary.rootDatum hF n).rank → ℤ} (hl : GGLongRoot (Unitary.rootDatum hF n) β) :
    ⁅pCoreOf 2 (Subgroup.normalizer
        ((((Unitary.rootDatum hF n).rootGroup β) :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n))),
        pCoreOf 2 (Subgroup.normalizer
        ((((Unitary.rootDatum hF n).rootGroup β) :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n)))⁆ ≤
        ((Unitary.rootDatum hF n).rootGroup β) ∧
      pCoreOf 2 (Subgroup.normalizer
        ((((Unitary.rootDatum hF n).rootGroup β) :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n))) ≤
        Subgroup.centralizer ((((Unitary.rootDatum hF n).rootGroup β) :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n)) := by
  obtain ⟨v, w, hv0, haa, hdd, had, hT, hQle⟩ := l10scsua_coreFour_one_setup hF hn hl
  have hσ : ∀ c, unitaryInvolution F 2 f (unitaryInvolution F 2 f c) = c :=
    CFSG.LieType.BorelTits.unitaryInvolution_involutive hF
  have hcomm : ⁅uRad (unitaryInvolution F 2 f) v, uRad (unitaryInvolution F 2 f) v⁆ ≤
      (Unitary.rootDatum hF n).rootGroup β :=
    Subgroup.commutator_le.mpr (fun x hx y hy =>
      commutatorElement_mem_of_mem_uRad hσ haa hdd had hT hx hy)
  exact ⟨(Subgroup.commutator_mono hQle hQle).trans hcomm,
    hQle.trans (uRad_le_centralizer hT)⟩

private theorem l10scsua_coreFour_SU {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hF : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n)
    {β : Fin (Unitary.rootDatum hF n).rank → ℤ} (hl : GGLongRoot (Unitary.rootDatum hF n) β)
    (u : ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
    ⁅pCoreOf 2 (Subgroup.normalizer
        ((((Unitary.rootDatum hF n).rootGroup β).map (MulAut.conj u).toMonoidHom :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n))),
        pCoreOf 2 (Subgroup.normalizer
        ((((Unitary.rootDatum hF n).rootGroup β).map (MulAut.conj u).toMonoidHom :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n)))⁆ ≤
        ((Unitary.rootDatum hF n).rootGroup β).map (MulAut.conj u).toMonoidHom ∧
      pCoreOf 2 (Subgroup.normalizer
        ((((Unitary.rootDatum hF n).rootGroup β).map (MulAut.conj u).toMonoidHom :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n))) ≤
        Subgroup.centralizer
          ((((Unitary.rootDatum hF n).rootGroup β).map (MulAut.conj u).toMonoidHom :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n)) := by
  have h1 := l10scsua_coreFour_one hF hn hl
  have hQmap : pCoreOf 2 (Subgroup.normalizer
        ((((Unitary.rootDatum hF n).rootGroup β).map (MulAut.conj u).toMonoidHom :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n))) =
      (pCoreOf 2 (Subgroup.normalizer
        (((Unitary.rootDatum hF n).rootGroup β :
          Subgroup ↥(Unitary.SU (unitaryInvolution F 2 f) n)) :
          Set ↥(Unitary.SU (unitaryInvolution F 2 f) n)))).map
        (MulAut.conj u).toMonoidHom := by
    rw [GGRootNorm.normalizer_map_mulEquiv, GGRootNorm.pCoreOf_map_mulEquiv]
  constructor
  · rw [hQmap, ← Subgroup.map_commutator]
    exact Subgroup.map_mono h1.1
  · rw [hQmap]
    intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro r hr
    obtain ⟨q, hq, rfl⟩ := Subgroup.mem_map.mp hx
    obtain ⟨r₀, hr₀, rfl⟩ := Subgroup.mem_map.mp hr
    have hc : r₀ * q = q * r₀ := (Subgroup.mem_centralizer_iff.mp (h1.2 hq)) r₀ hr₀
    rw [← map_mul, ← map_mul, hc]

private theorem l10scsua_coreFour_of_eq {F : Type} [Field F] [Finite F] [CharP F 2] {f : ℕ}
    (hc : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 3 ≤ n)
    (L : LieUniversal)
    (hL : L = ⟨↥(Unitary.SU (unitaryInvolution F 2 f) n), Unitary.rootDatum hc n⟩)
    {β : Fin L.D.rank → ℤ} (hl : GGLongRoot L.D β) (u : L.K) {Rr Q : Subgroup L.K}
    (hRr : Rr = ggRootSub L.D (MonoidHom.id L.K) β u)
    (hQ : Q = pCoreOf 2 (Subgroup.normalizer (Rr : Set L.K))) :
    ⁅Q, Q⁆ ≤ Rr ∧ Q ≤ Subgroup.centralizer (Rr : Set L.K) := by
  subst hL
  have hRr' : Rr = ((Unitary.rootDatum hc n).rootGroup β).map (MulAut.conj u).toMonoidHom := by
    rw [hRr]
    simp [ggRootSub, Subgroup.map_id]
  subst hRr'
  have h1 := l10scsua_coreFour_SU hc hn hl u
  rw [hQ]
  exact h1

private theorem l10scsua_false_of_longRoot_trivialUniversal (L : LieUniversal)
    (hL : L = trivialUniversal) {β : Fin L.D.rank → ℤ} (hl : GGLongRoot L.D β) : False := by
  subst hL
  obtain ⟨w, γ₀, hγ₀, -, -⟩ := hl
  rcases hγ₀ with ⟨w', i, -⟩ | ⟨w', i, -, -⟩ <;> exact i.elim0

private theorem l10scsua_rootSub_ne_bot_PSU_of_eq {F : Type} [Field F] [Finite F] [CharP F 2]
    {f : ℕ} (hc : Nat.card F = (2 ^ f) ^ 2) {n : ℕ} (hn : 2 ≤ n) (L : LieUniversal)
    (hL : L = ⟨↥(Unitary.SU (unitaryInvolution F 2 f) n), Unitary.rootDatum hc n⟩)
    {β : Fin L.D.rank → ℤ} (hβ : β ∈ L.D.roots) (u : L.K) {Rr : Subgroup L.K}
    (hRr : Rr = ggRootSub L.D (MonoidHom.id L.K) β u) : Rr ≠ ⊥ := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  subst hL
  obtain ⟨ζ, hζ⟩ := CFSG.LieType.Universal.Unitary.exists_traceZero_ne_zero
    (p := 2) (f := f) hc
  have hroot : (Unitary.rootDatum hc n).rootGroup β ≠ ⊥ :=
    (CFSG.LieType.Universal.Unitary.steinbergExtras hc n hn ζ hζ).ne_bot β hβ
  intro hbot
  rw [hRr, ggRootSub] at hbot
  simp only [Subgroup.map_id] at hbot
  exact hroot ((Subgroup.map_eq_bot_iff_of_injective _ (MulAut.conj u).injective).mp hbot)

private theorem l10scsua_odd_card_center_PSU_of_eq {F : Type} [Field F] [Finite F] [CharP F 2]
    {f : ℕ} (hc : Nat.card F = (2 ^ f) ^ 2) (hf : 1 ≤ f) {n : ℕ} (hn : 3 ≤ n)
    (hnq : (n, 2 ^ f) ≠ (3, 2)) (L : LieUniversal)
    (hL : L = ⟨↥(Unitary.SU (unitaryInvolution F 2 f) n), Unitary.rootDatum hc n⟩) :
    Odd (Nat.card (Subgroup.center L.K)) := by
  subst hL
  exact CFSG.SeitzReduction.SymplecticPilot.odd_card_center_SU hc hf hn hnq

theorem coreFour_PSU_long
    {n f : ℕ} (hn : 3 ≤ n)
    {β : Fin (ggU .PSU n f).D.rank → ℤ} (hl : GGLongRoot (ggU .PSU n f).D β)
    (u : (ggU .PSU n f).K) {Rr Q : Subgroup (ggU .PSU n f).K}
    (hRr : Rr = ggRootSub (ggU .PSU n f).D (MonoidHom.id (ggU .PSU n f).K) β u)
    (hQ : Q = pCoreOf 2 (Subgroup.normalizer (Rr : Set (ggU .PSU n f).K))) :
    ⁅Q, Q⁆ ≤ Rr ∧ Q ≤ Subgroup.centralizer (Rr : Set (ggU .PSU n f).K) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  by_cases hf1 : 1 ≤ f
  · have e : ggU .PSU n f = ⟨Unitary.SU (unitaryInvolution (GaloisField 2 (2 * f)) 2 f) n,
        Unitary.rootDatum (card_galoisField_two_mul 2 f hf1) n⟩ := by
      simp only [ggU, lieUniversal, hf1, ↓reduceDIte]
    exact l10scsua_coreFour_of_eq (card_galoisField_two_mul 2 f hf1) hn _ e hl u hRr hQ
  · exfalso
    have e : ggU .PSU n f = trivialUniversal := by
      simp only [ggU, lieUniversal, hf1, ↓reduceDIte]
    exact l10scsua_false_of_longRoot_trivialUniversal _ e hl

theorem ggSixLieKnown_of_pos_PSU
    (h : GGSixLieKnownPos .PSU) : GGSixLieKnown .PSU := by
  intro X _ _ n f ψ p G₀ B₁ D J L x hψ hker hmodel hoddG0 hp hp2 hB₁G₀ hinner hab hcardB hDB
    hcardD hB₁J hB₁centJ hJcomp hoddJ hxD hxne hLG₀ hLcomp hJL hDnotCL hLEM1 hB₁L hLEM2 hA3
    hE6c hA6 hField hN hE
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hadm : StatedLieAdmissible .PSU n 2 f := hmodel.admissible
  have hf1 : 1 ≤ f := hadm.2.1
  have hn : 3 ≤ n := hadm.2.2.1
  have hnq : (n, 2 ^ f) ≠ (3, 2) := hadm.2.2.2
  have eSU : ggU .PSU n f = ⟨Unitary.SU (unitaryInvolution (GaloisField 2 (2 * f)) 2 f) n,
      Unitary.rootDatum (card_galoisField_two_mul 2 f hf1) n⟩ := by
    simp only [ggU, lieUniversal, hf1, ↓reduceDIte]
  have hnf : ¬ (n = 3 ∧ f = 1) := by
    rintro ⟨rfl, rfl⟩
    exact hnq rfl
  have hoddker : Odd (Nat.card ψ.ker) :=
    Odd.of_dvd_nat
      (l10scsua_odd_card_center_PSU_of_eq (card_galoisField_two_mul 2 f hf1) hf1 hn hnq _ eSU)
      (Subgroup.card_dvd_of_le hker)
  obtain ⟨R, Rm, hRJ, hRmJ, hpos, h2, h3⟩ :=
    h X n f ψ p G₀ B₁ D J L x hψ hker hmodel hoddG0 hp hp2 hB₁G₀ hinner hab hcardB hDB hcardD
      hB₁J hB₁centJ hJcomp hoddJ hxD hxne hLG₀ hLcomp hJL hDnotCL hLEM1 hB₁L hLEM2 hA3 hE6c
      hA6 hField hN hE
  obtain ⟨β, hβ, hls, u, hR, hRm⟩ := hpos
  have hRleG₀ : R ≤ G₀ := hRJ.trans (hJL.trans hLG₀)
  have hRmap : R = (ggRootSub (ggU .PSU n f).D (MonoidHom.id (ggU .PSU n f).K) β u).map ψ :=
    hR.trans (CFSG.StandardType.LieKnownR2.Short.ggRootSub_eq_map _ _ _ _)
  have hRmmap : Rm =
      (ggRootSub (ggU .PSU n f).D (MonoidHom.id (ggU .PSU n f).K) (-β) u).map ψ :=
    hRm.trans (CFSG.StandardType.LieKnownR2.Short.ggRootSub_eq_map _ _ _ _)
  have hRp : IsPGroup 2 R := by
    rw [hRmap]
    exact (CFSG.StandardType.LieKnownR2.Short.rootGroup_isPGroup_PSU hβ u rfl).map ψ
  have hSne : ggRootSub (ggU .PSU n f).D (MonoidHom.id (ggU .PSU n f).K) β u ≠ ⊥ :=
    l10scsua_rootSub_ne_bot_PSU_of_eq (card_galoisField_two_mul 2 f hf1) (by omega) _ eSU hβ u rfl
  have hRne : R ≠ ⊥ := by
    rw [hRmap]
    exact l10scsua_map_ne_bot_of_isPGroup_two_of_odd_ker hoddker
      (CFSG.StandardType.LieKnownR2.Short.rootGroup_isPGroup_PSU hβ u rfl) hSne
  have hbase : pCoreOf 2 (G₀ ⊓ Subgroup.normalizer (R : Set X)) ⊔ (R ⊔ Rm) = G₀ := by
    by_cases hl : GGLongRoot (ggU .PSU n f).D β
    · have h1 := CFSG.StandardType.LieKnownR2.Short.itemOne_of_core hker hoddker
        (CFSG.StandardType.LieKnownR2.Short.rootGroup_isPGroup_PSU hβ u rfl)
        (coreOne_PSU_long hn hnf hl u rfl rfl rfl)
      rw [hψ, ← hRmap, ← hRmmap] at h1
      exact h1
    · have hs : ¬ GGLongRoot (ggU .PSU n f).D β := hl
      have hpdvd : p ∣ 2 ^ f - 1 := by
        rcases (hls.resolve_left hl).1 with h | h | h
        · exact absurd h (by decide)
        · exact absurd h (by decide)
        · exact h.2
      have hf2 : 2 ≤ f := by
        by_contra hf
        have hf_eq : f = 1 := by omega
        have hpdvd1 : p ∣ 1 := by simpa [hf_eq] using hpdvd
        exact hp.ne_one (Nat.dvd_one.mp hpdvd1)
      have h2β : 2 • β ∉ (ggU .PSU n f).D.roots := (hls.resolve_left hl).2
      have h1 := CFSG.StandardType.LieKnownR2.Short.itemOne_PSU ψ hker hoddker hβ hs hf2 h2β u
        hR hRm rfl
      rw [hψ] at h1
      exact h1
  have hRle_pcore : R ≤ pCoreOf 2 (G₀ ⊓ Subgroup.normalizer (R : Set X)) :=
    GGRootNorm.le_pCoreOf_of_normalized
      (fun r hr => ⟨hRleG₀ hr, Subgroup.le_normalizer hr⟩)
      hRp
      (Subgroup.le_normalizer_iff.mp inf_le_right)
  have hitem1 : pCoreOf 2 (G₀ ⊓ Subgroup.normalizer (R : Set X)) ⊔ Rm = G₀ := by
    rw [← sup_assoc, sup_eq_left.mpr hRle_pcore] at hbase
    exact hbase
  have hitem4 : (⁅pCoreOf 2 (G₀ ⊓ Subgroup.normalizer (R : Set X)),
        pCoreOf 2 (G₀ ⊓ Subgroup.normalizer (R : Set X))⁆ ≤ R ∧
      pCoreOf 2 (G₀ ⊓ Subgroup.normalizer (R : Set X)) ≤
        Subgroup.centralizer (R : Set X)) ∨
      ∀ V : Subgroup X,
        ggCenterOf (pCoreOf 2 (G₀ ⊓ Subgroup.normalizer (R : Set X))) ≤ V →
        V ≤ pCoreOf 2 (G₀ ⊓ Subgroup.normalizer (R : Set X)) →
        V ≠ ggCenterOf (pCoreOf 2 (G₀ ⊓ Subgroup.normalizer (R : Set X))) →
        V ≠ pCoreOf 2 (G₀ ⊓ Subgroup.normalizer (R : Set X)) →
        G₀ ⊓ Subgroup.normalizer (R : Set X) ≤ Subgroup.normalizer (V : Set X) →
        J ⊔ V = G₀ := by
    by_cases hl : GGLongRoot (ggU .PSU n f).D β
    · have hcore := coreFour_PSU_long hn hl u rfl rfl
      have h1 := CFSG.StandardType.LieKnownR2.Short.itemFour_of_core hker hoddker
        (CFSG.StandardType.LieKnownR2.Short.rootGroup_isPGroup_PSU hβ u rfl) hcore.1 hcore.2
      rw [hψ, ← hRmap] at h1
      exact Or.inl h1
    · have hs : ¬ GGLongRoot (ggU .PSU n f).D β := hl
      have hpdvd : p ∣ 2 ^ f - 1 := by
        rcases (hls.resolve_left hl).1 with h | h | h
        · exact absurd h (by decide)
        · exact absurd h (by decide)
        · exact h.2
      have hf2 : 2 ≤ f := by
        by_contra hf
        have hf_eq : f = 1 := by omega
        have hpdvd1 : p ∣ 1 := by simpa [hf_eq] using hpdvd
        exact hp.ne_one (Nat.dvd_one.mp hpdvd1)
      have h2β : 2 • β ∉ (ggU .PSU n f).D.roots := (hls.resolve_left hl).2
      have h1 := CFSG.StandardType.LieKnownR2.Short.itemFourIrred_PSU ψ hker hoddker hβ hs hf2
        h2β u hR hRm rfl
      rw [hψ] at h1
      exact Or.inr fun V hV1 hV2 hV3 hV4 hVN => absurd hVN (h1 V hV1 hV2 hV3 hV4)
  exact ⟨R, Rm, hRJ, hRne, hRp, hRmJ, hitem1, h2, h3, hitem4⟩

end CFSG.StandardType.LieKnownR2.PSU
