private theorem exists_conj_component_su6Levi_of_coroot_conj
    (hK : Nat.card K = 4) (hσ : ∀ c, σ c = c ^ 2)
    {h : twistedE6InndiagGL K σ} {J : Subgroup (twistedE6RootGroup K σ)}
    (hJ : IsComponentOf J (fixedPoints (Subgroup.zpowers (twistedE6InndiagConj K σ h))))
    {t : ModGL TwistTag.E6.tag K} (ht : t ∈ twistedE6InndiagGL K σ)
    (hJt : ∀ x ∈ J, (x : ModGL TwistTag.E6.tag K) * t = t * (x : ModGL TwistTag.E6.tag K))
    (hht : (h : ModGL TwistTag.E6.tag K) * t = t * (h : ModGL TwistTag.E6.tag K))
    (hcor : ∃ g ∈ adjointGroup Tag.E6 (AlgebraicClosure K), ∃ γ : Fin Tag.E6.rank → ℤ,
      IsRoot Tag.E6 γ ∧ ∃ ζ : (AlgebraicClosure K)ˣ, ζ ^ 3 = 1 ∧ ζ ≠ 1 ∧
        g⁻¹ * baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K)) t * g =
          rootDiagUnit Tag.E6 (TwE6RootAs.corootTuple γ ζ)) :
    ∃ c ∈ twistedE6InndiagGL K σ,
      c * (h : ModGL TwistTag.E6.tag K) * c⁻¹ ∈
        Subgroup.normalizer (su6Levi σ.toRingHom : Set (ModGL TwistTag.E6.tag K)) ∧
      CFSG.Assembly.IsComponentOf
        (J.map ((MulAut.conj c).toMonoidHom.comp (twistedE6RootGroup K σ).subtype))
        (su6Levi σ.toRingHom ⊓ Subgroup.centralizer
          ({c * (h : ModGL TwistTag.E6.tag K) * c⁻¹} : Set (ModGL TwistTag.E6.tag K))) := by
  classical
  have hK' : Nat.card K = (2 ^ 1) ^ 2 := by rw [hK]; norm_num
  have hσ' : ∀ c, σ c = c ^ (2 ^ 1) := by simpa using hσ
  have hK2 : (2 : K) = 0 := E6GraphLevi.two_eq_zero_of_card_sq (by norm_num) hK'
  have hf1 : 1 ≤ 1 := le_rfl
  let k : Type := ↥(fixSubfield σ)
  have hk : Nat.card k = 2 ^ 1 := by
    change Nat.card (fixSubfield σ) = 2 ^ 1
    exact CFSG.LieType.SeitzGeneration.card_fixSubfield_sq Nat.prime_two hf1 hK' σ hσ'
  obtain ⟨g0, hg0, γ, hγ, ζ, hζ3, hζ1, hcor'⟩ := hcor
  have hcor'' : g0⁻¹ * baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K)) t * g0 =
      rootDiagUnit TwistTag.E6.tag (TwE6RootAs.corootTuple γ ζ) := hcor'
  obtain ⟨c, hc, A, hA, m, hAm, hcx⟩ :=
    CFSG.StandardType.TwE6CorootCore.exists_conj_eq_thetaSL2_pow_of_coroot_conj
      (K := K) σ hf1 hK' hσ' (k := k) hk g0 hg0 t ht γ hγ 3 Nat.prime_three
      (by norm_num) ζ hζ3 hζ1 hcor''
  have hA3 : orderOf A = 3 := by rw [hA, hk]; norm_num
  have hm3 : 3 ≤ orderOf (A ^ m) := by
    have h1 : (A ^ m) ^ orderOf A = 1 := by
      rw [← pow_mul, mul_comm, pow_mul, pow_orderOf_eq_one, one_pow]
    have hdvd : orderOf (A ^ m) ∣ 3 := by
      rw [← hA3]
      exact orderOf_dvd_of_pow_eq_one h1
    have hne : orderOf (A ^ m) ≠ 1 := fun h => hAm (orderOf_eq_one_iff.1 h)
    rcases (Nat.dvd_prime Nat.prime_three).1 hdvd with h | h
    · exact absurd h hne
    · omega
  let ρA : ModGL TwistTag.E6.tag K :=
    (thetaSL2 K).comp (Matrix.SpecialLinearGroup.map (algebraMap k K)) A
  have hpow : (thetaSL2 K).comp (Matrix.SpecialLinearGroup.map (algebraMap k K)) (A ^ m) =
      ρA ^ m := by
    show _ = ((thetaSL2 K).comp (Matrix.SpecialLinearGroup.map (algebraMap k K)) A) ^ m
    rw [map_pow]
  have hcen := CFSG.StandardType.TwE6CorootCore.centralizer_pow_inf_eq
    (f := 1) (k := k) (K := K) hf1 hk hK' (σ := σ.toRingHom) hσ' hA hm3
  rw [hpow] at hcen
  let M : Subgroup (ModGL TwistTag.E6.tag K) :=
    Subgroup.zpowers ρA ⊔ su6Levi σ.toRingHom
  have hMeq : M = Subgroup.centralizer
      ({ρA ^ m} : Set (ModGL TwistTag.E6.tag K)) ⊓ twistedE6RootGroup K σ := hcen.symm
  have hXJ : Subgroup.zpowers ρA ≤ thetaRankOneGroup (algebraMap k K) := by
    rw [Subgroup.zpowers_le, thetaRankOneGroup_eq_range hK2]
    exact ⟨A, rfl⟩
  have hXcomm : ∀ k₁ ∈ Subgroup.zpowers ρA, ∀ k₂ ∈ Subgroup.zpowers ρA, k₁ * k₂ = k₂ * k₁ := by
    intro k₁ hk₁ k₂ hk₂
    obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp hk₁
    obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp hk₂
    exact ((Commute.refl ρA).zpow_zpow i j).eq
  have hXD : ∀ k₁ ∈ Subgroup.zpowers ρA, ∀ d ∈ su6Levi σ.toRingHom, k₁ * d = d * k₁ := by
    intro k₁ hk₁ d hd
    have hdC := (su6Levi_facts (k := k) (σ := σ.toRingHom) (f := 1) hf1 hk hK' hσ').1 hd
    exact Subgroup.mem_centralizer_iff.1 hdC k₁ (hXJ hk₁)
  have hMD : ⁅M, M⁆ = su6Levi σ.toRingHom := by
    refine le_antisymm ?_ ?_
    · exact commutator_sup_le_of_centralizes hXD hXcomm
    · calc su6Levi σ.toRingHom = ⁅su6Levi σ.toRingHom, su6Levi σ.toRingHom⁆ :=
            (commutator_su6Levi (k := k) (σ := σ.toRingHom) (f := 1) hf1 hk hK' hσ').symm
        _ ≤ ⁅M, M⁆ := Subgroup.commutator_mono le_sup_right le_sup_right
  have hJh : ∀ x ∈ J, (x : ModGL TwistTag.E6.tag K) * (h : ModGL TwistTag.E6.tag K) =
      (h : ModGL TwistTag.E6.tag K) * (x : ModGL TwistTag.E6.tag K) := by
    intro x hx
    have hfix : twistedE6InndiagConj K σ h x = x :=
      (mem_fixedPoints.1 (hJ.1 hx)) _ (Subgroup.mem_zpowers _)
    have h1 : ((twistedE6InndiagConj K σ h x : twistedE6RootGroup K σ) :
        ModGL TwistTag.E6.tag K) = (x : ModGL TwistTag.E6.tag K) := by rw [hfix]
    rw [twistedE6InndiagConj_apply] at h1
    calc (x : ModGL TwistTag.E6.tag K) * (h : ModGL TwistTag.E6.tag K)
        = ((h : ModGL TwistTag.E6.tag K) * (x : ModGL TwistTag.E6.tag K) *
            (h : ModGL TwistTag.E6.tag K)⁻¹) * (h : ModGL TwistTag.E6.tag K) := by rw [h1]
      _ = (h : ModGL TwistTag.E6.tag K) * (x : ModGL TwistTag.E6.tag K) := by group
  let f : twistedE6RootGroup K σ →* ModGL TwistTag.E6.tag K :=
    (MulAut.conj c).toMonoidHom.comp (twistedE6RootGroup K σ).subtype
  have hconjapp : ∀ (z y : ModGL TwistTag.E6.tag K),
      (MulAut.conj z).toMonoidHom y = z * y * z⁻¹ := by
    intro z y
    change MulAut.conj z y = z * y * z⁻¹
    rw [MulAut.conj_apply]
  have hcconj : ∀ x : twistedE6RootGroup K σ,
      f x = c * (x : ModGL TwistTag.E6.tag K) * c⁻¹ := by
    intro x
    change (MulAut.conj c) (x : ModGL TwistTag.E6.tag K) =
      c * (x : ModGL TwistTag.E6.tag K) * c⁻¹
    rw [MulAut.conj_apply]
  have hJcM : J.map f ≤ M := by
    rintro y ⟨x, hx, rfl⟩
    rw [hcconj x, hMeq]
    rw [Subgroup.mem_inf]
    refine ⟨?_, ?_⟩
    · rw [Subgroup.mem_centralizer_iff]
      intro w hw
      rw [Set.mem_singleton_iff] at hw
      subst hw
      have hct : Commute (ρA ^ m) (c * (x : ModGL TwistTag.E6.tag K) * c⁻¹) := by
        rw [← hpow, ← hcx]
        exact (show Commute (x : ModGL TwistTag.E6.tag K) t from hJt x hx).symm.conj c
      exact hct.eq
    · exact (Subgroup.mem_normalizer_iff.1
        (twistedE6InndiagGL_le_normalizer K σ hc) (x : ModGL TwistTag.E6.tag K)).1 x.2
  have hJperf : ⁅J, J⁆ = J := Subgroup.isPerfect_iff.1 (Group.isPerfect_def.2 hJ.2.2.1)
  have hJcD : J.map f ≤ su6Levi σ.toRingHom := by
    have hperf : ⁅J.map f, J.map f⁆ = J.map f := by
      rw [← Subgroup.map_commutator, hJperf]
    calc J.map f = ⁅J.map f, J.map f⁆ := hperf.symm
      _ ≤ ⁅M, M⁆ := Subgroup.commutator_mono hJcM hJcM
      _ = su6Levi σ.toRingHom := hMD
  let g : ModGL TwistTag.E6.tag K := c * (h : ModGL TwistTag.E6.tag K) * c⁻¹
  have hgC0 : g ∈ twistedE6InndiagGL K σ :=
    Subgroup.mul_mem _ (Subgroup.mul_mem _ hc h.2) (Subgroup.inv_mem _ hc)
  have hgcomm : Commute g (ρA ^ m) := by
    rw [← hpow, ← hcx]
    exact (show Commute (h : ModGL TwistTag.E6.tag K) t from hht).conj c
  have hconj_mem : ∀ z ∈ twistedE6InndiagGL K σ, Commute z (ρA ^ m) →
      ∀ x ∈ M, (MulAut.conj z) x ∈ M := by
    intro z hz hzc x hx
    rw [hMeq] at hx ⊢
    obtain ⟨hxc, hxC⟩ := Subgroup.mem_inf.1 hx
    have hzc' : Commute (ρA ^ m) z := hzc.symm
    rw [MulAut.conj_apply]
    rw [Subgroup.mem_inf]
    refine ⟨?_, ?_⟩
    · rw [Subgroup.mem_centralizer_iff] at hxc ⊢
      intro w hw
      rw [Set.mem_singleton_iff] at hw
      subst hw
      have h1 : Commute (ρA ^ m) (z * x * z⁻¹) :=
        (hzc'.mul_right (hxc _ rfl)).mul_right hzc'.inv_right
      exact h1.eq
    · exact (Subgroup.mem_normalizer_iff.1 (twistedE6InndiagGL_le_normalizer K σ hz) x).1 hxC
  have hMmap : M.map (MulAut.conj g).toMonoidHom = M := by
    refine le_antisymm ?_ ?_
    · rintro y ⟨x, hx, rfl⟩
      exact hconj_mem g hgC0 hgcomm x hx
    · intro y hy
      refine ⟨(MulAut.conj g⁻¹) y, hconj_mem g⁻¹ (Subgroup.inv_mem _ hgC0) hgcomm.inv_left y hy,
        ?_⟩
      show (MulAut.conj g) ((MulAut.conj g⁻¹) y) = y
      rw [MulAut.conj_apply, MulAut.conj_apply]
      group
  have hgND : g ∈ Subgroup.normalizer (su6Levi σ.toRingHom : Set (ModGL TwistTag.E6.tag K)) := by
    rw [Subgroup.mem_normalizer_iff_map_conj_eq]
    show (su6Levi σ.toRingHom).map (MulAut.conj g).toMonoidHom = su6Levi σ.toRingHom
    rw [← hMD]
    show (⁅M, M⁆).map (MulAut.conj g).toMonoidHom = ⁅M, M⁆
    rw [Subgroup.map_commutator M M (MulAut.conj g).toMonoidHom, hMmap]
  have hf_eq : f = (twistedE6RootGroup K σ).subtype.comp
      (twistedE6InndiagConj K σ ⟨c, hc⟩).toMonoidHom := by
    refine MonoidHom.ext fun x => ?_
    show (MulAut.conj c) (x : ModGL TwistTag.E6.tag K) =
      ((twistedE6InndiagConj K σ ⟨c, hc⟩ x : twistedE6RootGroup K σ) :
        ModGL TwistTag.E6.tag K)
    rw [MulAut.conj_apply, twistedE6InndiagConj_apply]
  have hphi : ∀ x : twistedE6RootGroup K σ,
      ((twistedE6RootGroup K σ).subtype.comp (twistedE6InndiagConj K σ ⟨c, hc⟩).toMonoidHom) x
        = c * (x : ModGL TwistTag.E6.tag K) * c⁻¹ :=
    fun x => twistedE6InndiagConj_apply ⟨c, hc⟩ x
  have hImg : (fixedPoints (Subgroup.zpowers (twistedE6InndiagConj K σ h))).map f =
      twistedE6RootGroup K σ ⊓ Subgroup.centralizer
        ({g} : Set (ModGL TwistTag.E6.tag K)) := by
    rw [hf_eq]
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      have hxgen : twistedE6InndiagConj K σ h x = x :=
        (mem_fixedPoints.1 hx) _ (Subgroup.mem_zpowers _)
      have hcomm : Commute (h : ModGL TwistTag.E6.tag K) (x : ModGL TwistTag.E6.tag K) := by
        have h2 : (h : ModGL TwistTag.E6.tag K) * (x : ModGL TwistTag.E6.tag K) *
            (h : ModGL TwistTag.E6.tag K)⁻¹ = (x : ModGL TwistTag.E6.tag K) := by
          rw [← twistedE6InndiagConj_apply h x, hxgen]
        calc (h : ModGL TwistTag.E6.tag K) * (x : ModGL TwistTag.E6.tag K)
            = ((h : ModGL TwistTag.E6.tag K) * (x : ModGL TwistTag.E6.tag K) *
                (h : ModGL TwistTag.E6.tag K)⁻¹) * (h : ModGL TwistTag.E6.tag K) := by group
          _ = (x : ModGL TwistTag.E6.tag K) * (h : ModGL TwistTag.E6.tag K) := by rw [h2]
      rw [hphi x, Subgroup.mem_inf]
      refine ⟨?_, ?_⟩
      · exact (Subgroup.mem_normalizer_iff.1
          (twistedE6InndiagGL_le_normalizer K σ hc) (x : ModGL TwistTag.E6.tag K)).1 x.2
      · rw [Subgroup.mem_centralizer_iff]
        intro w hw
        rw [Set.mem_singleton_iff] at hw
        subst hw
        exact (hcomm.conj c).eq
    · rintro ⟨hyC, hycent⟩
      have hycomm : Commute g y := (Subgroup.mem_centralizer_iff.1 hycent) g rfl
      have hxC : c⁻¹ * y * c ∈ twistedE6RootGroup K σ := by
        have hmem : c⁻¹ ∈ Subgroup.normalizer
            (twistedE6RootGroup K σ : Set (ModGL TwistTag.E6.tag K)) :=
          Subgroup.inv_mem _ (twistedE6InndiagGL_le_normalizer K σ hc)
        simpa using (Subgroup.mem_normalizer_iff.1 hmem y).1 hyC
      refine ⟨⟨c⁻¹ * y * c, hxC⟩, ?_, ?_⟩
      · refine mem_fixedPoints_zpowers_of_apply_eq _ ?_
        have hcy : Commute (h : ModGL TwistTag.E6.tag K) (c⁻¹ * y * c) := by
          have hconj := hycomm.conj c⁻¹
          have h1 : c⁻¹ * (c * (h : ModGL TwistTag.E6.tag K) * c⁻¹) * (c⁻¹)⁻¹ =
              (h : ModGL TwistTag.E6.tag K) := by group
          have h2 : c⁻¹ * y * (c⁻¹)⁻¹ = c⁻¹ * y * c := by group
          rwa [h1, h2] at hconj
        apply Subtype.ext
        rw [twistedE6InndiagConj_apply]
        show (h : ModGL TwistTag.E6.tag K) * (c⁻¹ * y * c) *
            (h : ModGL TwistTag.E6.tag K)⁻¹ = c⁻¹ * y * c
        rw [hcy.eq]
        group
      · show ((twistedE6InndiagConj K σ ⟨c, hc⟩) ⟨c⁻¹ * y * c, hxC⟩ :
          ModGL TwistTag.E6.tag K) = y
        rw [twistedE6InndiagConj_apply]
        show c * (c⁻¹ * y * c) * c⁻¹ = y
        group
  have hf_inj : Function.Injective f := by
    intro x y hxy
    exact Subgroup.subtype_injective (twistedE6RootGroup K σ) ((MulAut.conj c).injective hxy)
  have hcompGL : CFSG.Assembly.IsComponentOf (J.map f)
      (twistedE6RootGroup K σ ⊓ Subgroup.centralizer
        ({g} : Set (ModGL TwistTag.E6.tag K))) := by
    have h1 := (CFSG.LocalAnalysis.ComponentInitial.isComponentOf_map_iff hf_inj).2
      (CFSG.Assembly.isComponentOf_iff_open.2 hJ)
    rwa [hImg] at h1
  have hJcC : J.map f ≤ Subgroup.centralizer ({g} : Set (ModGL TwistTag.E6.tag K)) := by
    rintro y ⟨x, hx, rfl⟩
    rw [hcconj x, Subgroup.mem_centralizer_iff]
    intro w hw
    rw [Set.mem_singleton_iff] at hw
    subst hw
    exact ((show Commute (x : ModGL TwistTag.E6.tag K) (h : ModGL TwistTag.E6.tag K) from
      hJh x hx).symm.conj c).eq
  exact ⟨c, hc, hgND, CFSG.Assembly.IsComponentOf.of_le_of_le hcompGL (le_inf hJcD hJcC)
    (inf_le_inf_right _ (su6Levi_le_graphFixedRootGroup σ.toRingHom))⟩

theorem exists_conj_component_su6Levi_of_dim (hK : Nat.card K = 4) (hσ : ∀ c, σ c = c ^ 2)
    {h : twistedE6InndiagGL K σ} (hh3 : h ^ 3 = 1) (hh1 : h ≠ 1)
    {J : Subgroup (twistedE6RootGroup K σ)}
    (hJ : IsComponentOf J (fixedPoints (Subgroup.zpowers (twistedE6InndiagConj K σ h))))
    (hdim : twE6MatFixDim K σ h = 36 ∨ twE6MatFixDim K σ h = 28) :
    ∃ c ∈ twistedE6InndiagGL K σ,
      c * (h : ModGL TwistTag.E6.tag K) * c⁻¹ ∈
        Subgroup.normalizer (su6Levi σ.toRingHom : Set (ModGL TwistTag.E6.tag K)) ∧
      CFSG.Assembly.IsComponentOf
        (J.map ((MulAut.conj c).toMonoidHom.comp (twistedE6RootGroup K σ).subtype))
        (su6Levi σ.toRingHom ⊓ Subgroup.centralizer
          ({c * (h : ModGL TwistTag.E6.tag K) * c⁻¹} : Set (ModGL TwistTag.E6.tag K))) := by
  classical
  have hK' : Nat.card K = (2 ^ 1) ^ 2 := by rw [hK]; norm_num
  have hJh : ∀ x ∈ J, (x : ModGL TwistTag.E6.tag K) * (h : ModGL TwistTag.E6.tag K) =
      (h : ModGL TwistTag.E6.tag K) * (x : ModGL TwistTag.E6.tag K) := by
    intro x hx
    have hfix : twistedE6InndiagConj K σ h x = x :=
      (mem_fixedPoints.1 (hJ.1 hx)) _ (Subgroup.mem_zpowers _)
    have h1 : ((twistedE6InndiagConj K σ h x : twistedE6RootGroup K σ) :
        ModGL TwistTag.E6.tag K) = (x : ModGL TwistTag.E6.tag K) := by rw [hfix]
    rw [twistedE6InndiagConj_apply] at h1
    calc (x : ModGL TwistTag.E6.tag K) * (h : ModGL TwistTag.E6.tag K)
        = ((h : ModGL TwistTag.E6.tag K) * (x : ModGL TwistTag.E6.tag K) *
            (h : ModGL TwistTag.E6.tag K)⁻¹) * (h : ModGL TwistTag.E6.tag K) := by rw [h1]
      _ = (h : ModGL TwistTag.E6.tag K) * (x : ModGL TwistTag.E6.tag K) := by group
  rcases hdim with h36 | h28
  ·
    have hx3 : (h : ModGL TwistTag.E6.tag K) ^ 3 = 1 := by
      have hh := congrArg Subtype.val hh3
      simpa using hh
    have hK3 : ringChar K ≠ 3 := by
      have h2 : (2 : K) = 0 := E6GraphLevi.two_eq_zero_of_card_sq (by norm_num) hK'
      intro h3
      have hdvd : ringChar K ∣ 2 := ringChar.dvd (x := 2) h2
      rw [h3] at hdvd
      exact absurd hdvd (by norm_num)
    have hroot : ∀ u : Kˣ, ∃ v : (AlgebraicClosure K)ˣ,
        v ^ 3 = Units.map (algebraMap K (AlgebraicClosure K)).toMonoidHom u :=
      fun u => KSNotAll24.exists_cube_root_algebraicClosure u
    have hxL : baseChangeGL (τ := Tag.E6) (algebraMap K (AlgebraicClosure K))
        (h : ModGL TwistTag.E6.tag K) ∈ adjointGroup Tag.E6 (AlgebraicClosure K) :=
      map_twistedE6InndiagGL_le (K := K) (L := AlgebraicClosure K) σ
        (algebraMap K (AlgebraicClosure K)) hroot (Subgroup.mem_map_of_mem _ h.2)
    have hdim36 : Module.finrank K (LinearMap.ker
        ((Units.val (h : ModGL TwistTag.E6.tag K) : Module.End K (RootModule Tag.E6 K)) - 1)) =
        36 := by
      change twE6MatFixDim K σ h = 36
      exact h36
    obtain ⟨g0, hg0, γ, hγ, ζ, hζ3, hζ1, hconj⟩ :=
      KSNotAll24.exists_coroot_conj_of_cube_one_of_finrank_eq_thirtysix
        (K := K) hK3 hxL hx3 hdim36
    have htuple : (fun j => ζ ^ ((CFSG.LieType.Steinberg.Adjoint.iform γ (Pi.single j 1)) : ℤ)) =
        TwE6RootAs.corootTuple γ ζ := by
      funext i
      simp only [TwistTag.tag, TwE6RootAs.corootTuple,
        CFSG.RankThree.Lattice.iform_single_right_E6]
      rfl
    refine exists_conj_component_su6Levi_of_coroot_conj hK hσ hJ h.2 hJh rfl ?_
    exact ⟨g0, hg0, γ, hγ, ζ, hζ3, hζ1, by rw [← htuple]; exact hconj⟩
  ·
    obtain ⟨t, -, m, hmfix, -, hmJ, -, -, -, β, hβ, ζ, hζ3, hζ1, g0, hg0, hconj⟩ :=
      CFSG.LocalAnalysis.GLTheoremA.S265.TE6.exists_sym3_centralizing_of_dim28
        hK hσ hh3 hh1 h28 hJ
    have hmcoe : (m : ModGL TwistTag.E6.tag K) ∈ twistedE6InndiagGL K σ :=
      Subgroup.mem_sup_left m.2
    have hJm : ∀ x ∈ J, (x : ModGL TwistTag.E6.tag K) * (m : ModGL TwistTag.E6.tag K) =
        (m : ModGL TwistTag.E6.tag K) * (x : ModGL TwistTag.E6.tag K) := fun x hx => by
      have h := Subgroup.mem_centralizer_iff.1 hmJ x hx
      exact congrArg Subtype.val h
    have hhm : (h : ModGL TwistTag.E6.tag K) * (m : ModGL TwistTag.E6.tag K) =
        (m : ModGL TwistTag.E6.tag K) * (h : ModGL TwistTag.E6.tag K) := by
      have hfix : twistedE6InndiagConj K σ h m = m :=
        (mem_fixedPoints.1 hmfix) _ (Subgroup.mem_zpowers _)
      have h1 : ((twistedE6InndiagConj K σ h m : twistedE6RootGroup K σ) :
          ModGL TwistTag.E6.tag K) = (m : ModGL TwistTag.E6.tag K) := by rw [hfix]
      rw [twistedE6InndiagConj_apply] at h1
      calc (h : ModGL TwistTag.E6.tag K) * (m : ModGL TwistTag.E6.tag K)
          = ((h : ModGL TwistTag.E6.tag K) * (m : ModGL TwistTag.E6.tag K) *
              (h : ModGL TwistTag.E6.tag K)⁻¹) * (h : ModGL TwistTag.E6.tag K) := by group
        _ = (m : ModGL TwistTag.E6.tag K) * (h : ModGL TwistTag.E6.tag K) := by rw [h1]
    exact exists_conj_component_su6Levi_of_coroot_conj hK hσ hJ hmcoe hJm hhm
      ⟨g0, hg0, β, hβ, ζ, hζ3, hζ1, hconj⟩

end Levi

