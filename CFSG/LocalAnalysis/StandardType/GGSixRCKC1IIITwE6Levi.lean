private theorem commutator_sup_le_of_centralizes {G : Type*} [Group G] {K D : Subgroup G}
    (hKD : ∀ k ∈ K, ∀ d ∈ D, k * d = d * k)
    (hK : ∀ k₁ ∈ K, ∀ k₂ ∈ K, k₁ * k₂ = k₂ * k₁) :
    ⁅K ⊔ D, K ⊔ D⁆ ≤ D := by
  have hkn : ∀ k ∈ K, ∀ d ∈ D, k * d * k⁻¹ = d := by
    intro k hk d hd
    calc k * d * k⁻¹ = d * k * k⁻¹ := by rw [hKD k hk d hd]
      _ = d := by group
  have hKN : K ≤ Subgroup.normalizer (D : Set G) := by
    rw [Subgroup.le_normalizer_iff]
    intro k hk d hd
    rw [hkn k hk d hd]
    exact hd
  have hset : ((K ⊔ D : Subgroup G) : Set G) = (D : Set G) * (K : Set G) := by
    rw [sup_comm]
    exact Subgroup.coe_mul_of_right_le_normalizer_left D K hKN
  rw [Subgroup.commutator_le]
  intro p hp q hq
  have hp' : p ∈ ((K ⊔ D : Subgroup G) : Set G) := hp
  have hq' : q ∈ ((K ⊔ D : Subgroup G) : Set G) := hq
  rw [hset] at hp' hq'
  obtain ⟨d₁, hd₁, k₁, hk₁, rfl⟩ := Set.mem_mul.mp hp'
  obtain ⟨d₂, hd₂, k₂, hk₂, rfl⟩ := Set.mem_mul.mp hq'
  have h1 : ⁅k₁, d₂⁆ = 1 := Commute.commutator_eq (hKD k₁ hk₁ d₂ hd₂)
  have h2 : ⁅d₁, k₂⁆ = 1 := Commute.commutator_eq (hKD k₂ hk₂ d₁ hd₁).symm
  have h3 : ⁅k₁, k₂⁆ = 1 := Commute.commutator_eq (hK k₁ hk₁ k₂ hk₂)
  have hfin : ⁅d₁ * k₁, d₂ * k₂⁆ = ⁅d₁, d₂⁆ := by
    rw [commutatorElement_mul_left_eq_conj_mul, commutatorElement_mul_right_eq_mul_conj,
      commutatorElement_mul_right_eq_mul_conj, h1, h2, h3]
    group
  rw [hfin]
  exact Subgroup.commutator_le_of_le le_rfl le_rfl (Subgroup.commutator_mem_commutator hd₁ hd₂)

private theorem mem_fixedPoints_zpowers_of_apply_eq {X : Type*} [Group X] (φ : MulAut X)
    {x : X} (h : φ x = x) : x ∈ CFSG.LieType.Seitz.fixedPoints (Subgroup.zpowers φ) := by
  have hle : Subgroup.zpowers φ ≤ MulAction.stabilizer (MulAut X) x :=
    Subgroup.zpowers_le.2 (MulAction.mem_stabilizer_iff.2 h)
  intro ψ hψ
  exact hle hψ

