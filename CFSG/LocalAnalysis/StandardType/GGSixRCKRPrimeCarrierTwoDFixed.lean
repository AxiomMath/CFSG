theorem rckTwoD_exists_cover_of_datum_field
    {τ : Tag} (hτ : τ = .D4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8)
    {L : Type} [Field L] [CharP L 2] [IsAlgClosed L] {M : Type} [CommGroup M]
    (D : GenFixedRootDatum τ 2 L M) {m : ℕ} (hm : 4 ≤ m)
    (b : Fin m → Fin τ.rank → ℤ) (hroot : ∀ j, IsRoot τ (b j))
    (hbinj : Function.Injective b) (hG : ∀ j k, iform (b j) (b k) = cartanD m j k)
    (hsimple : D.simpleRootsJ = Set.range b)
    (hfix : ∀ j : Fin m, j.val + 2 < m → D.θ (toReal (b j)) = toReal (b j))
    (hswap01 : D.θ (toReal (b ⟨m - 2, by omega⟩)) = toReal (b ⟨m - 1, by omega⟩))
    (hswap10 : D.θ (toReal (b ⟨m - 1, by omega⟩)) = toReal (b ⟨m - 2, by omega⟩))
    (hframe : ∀ j k : Fin m, cartanD m j k = -1 →
      ∃ θ : SL(3, L) →* ModGL τ L,
        θ.comp (blockSL L 3 2 0 (by omega)) = rootSL2 τ L (b j) ∧
        θ.comp (blockSL L 3 2 1 (by omega)) = rootSL2 τ L (b k))
    {F : Type} [Field F] [Finite F] [CharP F 2]
    (κ : F ≃+* ↥(frobeniusFixedField L 2 D.e)) (bb cc : F)
    (hirr : ∀ s : F, s ^ 2 + bb * s + cc ≠ 0) :
    letI := fact_shortField hirr
    ∃ Ψ : spinGroup (quadMinus m F bb cc) →* ModGL τ L,
      Ψ.range = D.orbitGroup ∧ Ψ.ker ≤ Subgroup.center (spinGroup (quadMinus m F bb cc)) ∧
      ∀ (k : Fin (m - 1)) (hk : k.val + 1 < m - 1),
        Ψ.comp (rLong m bb cc hk) =
          (rootSL2 τ L (b ⟨k.val, by omega⟩)).comp (Matrix.SpecialLinearGroup.map
            ((frobeniusFixedField L 2 D.e).subtype.comp κ.toRingHom)) := by
  classical
  letI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have he : 0 < D.e := D.one_le_e
  let a0 : Fin m := ⟨m - 2, by omega⟩
  let a1 : Fin m := ⟨m - 1, by omega⟩
  let w : Equiv.Perm (Fin m) :=
    if GenFixedRootDatum.orbitRoot (thetaOrbit D.θ (b a0)) = b a0 then 1 else Equiv.swap a0 a1
  let b' : Fin m → Fin τ.rank → ℤ := fun j => b (w j)
  have hwfix : ∀ j : Fin m, j.val + 2 < m → w j = j := by
    intro j hj
    dsimp [w]
    split_ifs
    · rfl
    · apply Equiv.swap_apply_of_ne_of_ne
      · intro h
        have := congrArg Fin.val h
        dsimp [a0] at this
        omega
      · intro h
        have := congrArg Fin.val h
        dsimp [a1] at this
        omega
  have hwG : ∀ j k, cartanD m (w j) (w k) = cartanD m j k := by
    intro j k
    dsimp [w]
    split_ifs
    · rfl
    · exact CompsPTwoDDatum.cartanD_swap hm j k
  have hsimple' : D.simpleRootsJ = Set.range b' := by
    rw [hsimple]
    exact (w.surjective.range_comp b).symm
  have hfix' : ∀ j : Fin m, j.val + 2 < m → D.θ (toReal (b' j)) = toReal (b' j) := by
    intro j hj
    simpa only [b', hwfix j hj] using hfix j hj
  have hswap01' : D.θ (toReal (b' a0)) = toReal (b' a1) := by
    dsimp [b', w]
    split_ifs
    · exact hswap01
    · simpa only [Equiv.swap_apply_left, Equiv.swap_apply_right] using hswap10
  have hswap10' : D.θ (toReal (b' a1)) = toReal (b' a0) := by
    dsimp [b', w]
    split_ifs
    · exact hswap10
    · simpa only [Equiv.swap_apply_left, Equiv.swap_apply_right] using hswap01
  have horb' : GenFixedRootDatum.orbitRoot (thetaOrbit D.θ (b' a0)) = b' a0 := by
    have hOf := CompsPTwoDDatum.thetaOrbit_of_swap hswap01 hswap10
    have hOf' := CompsPTwoDDatum.thetaOrbit_of_swap hswap10 hswap01
    by_cases h : GenFixedRootDatum.orbitRoot (thetaOrbit D.θ (b a0)) = b a0
    · simpa only [b', w, if_pos h, Equiv.Perm.one_apply] using h
    · have hmem : GenFixedRootDatum.orbitRoot (thetaOrbit D.θ (b a0)) ∈
          thetaOrbit D.θ (b a0) :=
        lexLeast_mem (by rw [hOf]; exact Set.toFinite _) ⟨_, self_mem_thetaOrbit _ _⟩
      have hmem' : GenFixedRootDatum.orbitRoot (thetaOrbit D.θ (b a0)) ∈
          ({b a0, b a1} : Set (Fin τ.rank → ℤ)) := by
        rw [← hOf]
        exact hmem
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hmem'
      have hlast : GenFixedRootDatum.orbitRoot (thetaOrbit D.θ (b a0)) = b a1 := by
        rcases hmem' with hfirst | hlast
        · exact False.elim (h hfirst)
        · exact hlast
      simp only [b', w, if_neg h, Equiv.swap_apply_left]
      rw [hOf', Set.pair_comm, ← hOf]
      exact hlast
  obtain ⟨ρ, Φ, hρ, hρinj, hcomm, hfr, hΦ0, hΦ1, hΦ2, hC⟩ :=
    exists_chain_of_datum_core hτ D hm b' (fun j => hroot _) (hbinj.comp w.injective)
      (fun j k => by rw [hG, hwG]) hsimple' hfix' hswap01' hswap10' horb'
      (fun j k hjk => hframe _ _ (by rw [hwG]; exact hjk))
  haveI : Finite ↥(frobeniusFixedField L 2 D.e) := Nat.finite_of_card_ne_zero (by
    rw [card_frobeniusFixedField he]
    exact (pow_pos Nat.prime_two.pos _).ne')
  have hF : Nat.card F = 2 ^ D.e :=
    (Nat.card_congr κ.toEquiv).trans (card_frobeniusFixedField he)
  letI : Algebra F ↥(frobeniusFixedField L 2 (D.e * 2)) :=
    ((algebraMap ↥(frobeniusFixedField L 2 D.e) ↥(frobeniusFixedField L 2 (D.e * 2))).comp
      κ.toRingHom).toAlgebra
  obtain ⟨KD⟩ := rckTwoD_kleinData_fixedField he κ bb cc hirr
  haveI := fact_shortField hirr
  let κSL : SL(2, F) →* SL(2, ↥(frobeniusFixedField L 2 D.e)) :=
    Matrix.SpecialLinearGroup.map κ.toRingHom
  have hκsurj : Function.Surjective κSL := by
    intro A
    refine ⟨Matrix.SpecialLinearGroup.map κ.symm.toRingHom A, ?_⟩
    apply Subtype.ext
    ext i j : 1
    change κ (κ.symm ((A : Matrix (Fin 2) (Fin 2) ↥(frobeniusFixedField L 2 D.e)) i j)) = _
    exact κ.apply_symm_apply _
  have hnode : ∀ i : ℕ,
      ((ρ i).comp (Matrix.SpecialLinearGroup.map
        ((frobeniusFixedField L 2 (D.e * 2)).subtype.comp
          (algebraMap F ↥(frobeniusFixedField L 2 (D.e * 2)))))).range =
      ((ρ i).comp (Matrix.SpecialLinearGroup.map
        ((frobeniusFixedField L 2 (D.e * 2)).subtype.comp
          (algebraMap ↥(frobeniusFixedField L 2 D.e) ↥(frobeniusFixedField L 2 (D.e * 2)))))).range := by
    intro i
    have hcomp : (ρ i).comp (Matrix.SpecialLinearGroup.map
        ((frobeniusFixedField L 2 (D.e * 2)).subtype.comp
          (algebraMap F ↥(frobeniusFixedField L 2 (D.e * 2))))) =
      ((ρ i).comp (Matrix.SpecialLinearGroup.map
        ((frobeniusFixedField L 2 (D.e * 2)).subtype.comp
          (algebraMap ↥(frobeniusFixedField L 2 D.e) ↥(frobeniusFixedField L 2 (D.e * 2)))))).comp κSL := by
      ext A : 1
      apply congrArg (ρ i)
      apply Subtype.ext
      ext j k
      rfl
    rw [hcomp, MonoidHom.range_comp, (MonoidHom.range_eq_top).mpr hκsurj, Subgroup.map_top]
  have hC' : (⨆ i : Fin (m - 1), if i.val + 2 < m then
      ((ρ i.val).comp (Matrix.SpecialLinearGroup.map
        ((frobeniusFixedField L 2 (D.e * 2)).subtype.comp
          (algebraMap F ↥(frobeniusFixedField L 2 (D.e * 2)))))).range
    else ((Φ.comp (Matrix.SpecialLinearGroup.map (frobeniusFixedField L 2 (D.e * 2)).subtype)).comp
      (usbSL (CompsPTwoDKlein.frobInvol (k := L) (p := 2) D.e).toRingHom
        (CompsPTwoDPairE.σσ' KD))).range) = D.orbitGroup := by
    rw [← hC]
    apply iSup_congr
    intro i
    split_ifs
    · exact hnode i.val
    · rfl
  obtain ⟨Ψ, hΨ, hker, -, -, hlong, -⟩ := CompsPTwoDChainE.exists_cover_of_chain_even
    (show StatedLieAdmissible .POmegaMinus m 2 D.e from ⟨Nat.prime_two, D.one_le_e, hm⟩)
    hF KD hirr (frobeniusFixedField L 2 (D.e * 2)).subtype ρ hρinj hcomm hfr Φ hΦ0 hΦ1 hΦ2
    D.orbitGroup hC'
  refine ⟨Ψ, hΨ, hker, ?_⟩
  intro k hk
  have hkp : (⟨k.val, by omega⟩ : Fin m).val + 2 < m := by
    change k.val + 2 < m
    omega
  have h := hlong k hk
  rw [hρ ⟨k.val, by omega⟩] at h
  have hIncl : (frobeniusFixedField L 2 (D.e * 2)).subtype.comp
      (algebraMap F ↥(frobeniusFixedField L 2 (D.e * 2))) =
        (frobeniusFixedField L 2 D.e).subtype.comp κ.toRingHom := by
    ext x
    rfl
  rw [hIncl] at h
  simpa only [b', hwfix _ hkp] using h

end CFSG.StandardType.RCKRP
