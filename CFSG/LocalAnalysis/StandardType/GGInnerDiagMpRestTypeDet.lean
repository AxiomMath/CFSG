open MpTypeDet

theorem lieModel_of_markedModel {lab : LargeEvenLabel} (hc : markChar lab = 2) {X : Type}
    [Group X] (hX : MarkedModel lab X) :
    LieModel X (markTag lab) (markRank lab) 2 (markDeg lab) := by
  have h := hX
  unfold MarkedModel at h
  rwa [hc] at h

section TypeDet

@[expose] def GGMarkTypeDetAt (lab : LargeEvenLabel) (t : StatedLieTag) : Prop :=
  ∀ (X : Type) [Group X] (n f : ℕ), StatedLieAdmissible t n 2 f → 2 ≤ (ggU t n f).D.rank →
    LieModel X t n 2 f → MarkedModel lab X →
      markTag lab = t ∧ markRank lab = n ∧ markChar lab = 2 ∧ markDeg lab = f

theorem ggMarkTypeDetAt_classical {lab : LargeEvenLabel} (hc : markChar lab = 2)
    {t : StatedLieTag} (ht : t = .PSL ∨ t = .PSU ∨ t = .PSp ∨ t = .POmegaPlus ∨
      t = .POmegaMinus ∨ t = .E7) : GGMarkTypeDetAt lab t := by
  intro X _ n f hadm hrk hM hX
  have hX' := lieModel_of_markedModel hc hX
  have hadm' := CFSG.SeitzReduction.F4Pilot.statedLieAdmissible_of_lieModel hX'
  suffices h : markTag lab = t ∧ markRank lab = n ∧ markDeg lab = f from
    ⟨h.1, h.2.1, hc, h.2.2⟩
  rcases ht with rfl | rfl | rfl | rfl | rfl | rfl
  · obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by have := hadm.2.2.1; omega⟩
    have hm : 2 ≤ m := hrk
    exact CFSG.SeitzReduction.LinearPilot.slmEvenTypeDetAt (by omega) X f _ _ _ hM hadm' hX'
  · have hn : 3 ≤ n := hadm.2.2.1
    rcases (by omega : n = 3 ∨ 4 ≤ n) with rfl | hn4
    · exact CFSG.LocalAnalysis.EvenBN.GMSK.su3EvenTypeDet X f _ _ _ hM hadm' hX'
    · exact CFSG.SeitzReduction.UnitaryPilot.sumEvenTypeDetAt hn4 X f _ _ _ hM hadm' hX'
  · exact CFSG.SeitzReduction.SymplecticPilot.sp2mEvenTypeDet n X f _ _ _ hM hadm' hX'
  · exact CFSG.SeitzReduction.OmegaPilot.omegaEvenTypeDetAt n X .POmegaPlus f _ _ _
      (Or.inl rfl) hM hadm' hX'
  · exact CFSG.SeitzReduction.OmegaPilot.omegaEvenTypeDetAt n X .POmegaMinus f _ _ _
      (Or.inr rfl) hM hadm' hX'
  · obtain rfl : n = 0 := hadm.2.2
    have h := (CFSG.SeitzReduction.F4Pilot.card_eq_evenLieOrder hX').symm.trans
      (CFSG.SeitzReduction.F4Pilot.card_eq_evenLieOrder hM)
    obtain ⟨h1, h2, h3⟩ := CFSG.SeitzReduction.E8Pilot.evenLieOrder_eq_ordE7 hadm' hadm.2.1 h
    exact ⟨h1, h2, h3⟩

theorem ggMarkTypeDetAt_of_exc {lab : LargeEvenLabel} (hc : markChar lab = 2)
    (hexc : ∀ (t : StatedLieTag) (f : ℕ), 1 ≤ f →
      (t = .F4 ∨ t = .E6 ∨ t = .E8 ∨ t = .twistedE6) →
      CFSG.SeitzReduction.F4Pilot.evenLieOrder (markTag lab) (markRank lab) (markDeg lab) =
        CFSG.SeitzReduction.F4Pilot.evenLieOrder t 0 f →
        markTag lab = t ∧ markRank lab = 0 ∧ markDeg lab = f)
    (t : StatedLieTag) : GGMarkTypeDetAt lab t := by
  have hE : (t = .F4 ∨ t = .E6 ∨ t = .E8 ∨ t = .twistedE6) → GGMarkTypeDetAt lab t := by
    intro ht X _ n f hadm _ hM hX
    have hn : n = 0 := by rcases ht with rfl | rfl | rfl | rfl <;> exact hadm.2.2
    subst hn
    have h := (CFSG.SeitzReduction.F4Pilot.card_eq_evenLieOrder
      (lieModel_of_markedModel hc hX)).symm.trans
      (CFSG.SeitzReduction.F4Pilot.card_eq_evenLieOrder hM)
    obtain ⟨h1, h2, h3⟩ := hexc t f hadm.2.1 ht h
    exact ⟨h1, h2, hc, h3⟩
  cases t with
  | PSL => exact ggMarkTypeDetAt_classical hc (Or.inl rfl)
  | PSU => exact ggMarkTypeDetAt_classical hc (Or.inr (Or.inl rfl))
  | PSp => exact ggMarkTypeDetAt_classical hc (Or.inr (Or.inr (Or.inl rfl)))
  | POmegaOdd => exact fun _ _ _ _ hadm => absurd rfl hadm.2.2.2
  | POmegaPlus => exact ggMarkTypeDetAt_classical hc (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
  | POmegaMinus =>
    exact ggMarkTypeDetAt_classical hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl)))))
  | E7 => exact ggMarkTypeDetAt_classical hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl)))))
  | F4 => exact hE (Or.inl rfl)
  | E6 => exact hE (Or.inr (Or.inl rfl))
  | E8 => exact hE (Or.inr (Or.inr (Or.inl rfl)))
  | twistedE6 => exact hE (Or.inr (Or.inr (Or.inr rfl)))
  | G2 => exact fun _ _ _ _ _ hrk => absurd hrk (by change ¬ 2 ≤ 0; omega)
  | trialityD4 => exact fun _ _ _ _ _ hrk => absurd hrk (by change ¬ 2 ≤ 0; omega)
  | twistedB2 => exact fun _ _ _ _ _ hrk => absurd hrk (by change ¬ 2 ≤ 0; omega)
  | twistedG2 => exact fun _ _ _ _ _ hrk => absurd hrk (by change ¬ 2 ≤ 0; omega)
  | twistedF4 => exact fun _ _ _ _ _ hrk => absurd hrk (by change ¬ 2 ≤ 0; omega)
  | Tits => exact fun _ _ _ _ _ hrk => absurd hrk (by change ¬ 2 ≤ 0; omega)

theorem ggMarkTypeDet_E6 {n' : ℕ} (hn : 1 ≤ n') (t : StatedLieTag) :
    GGMarkTypeDetAt ⟨.E6, 0, n'⟩ t :=
  ggMarkTypeDetAt_of_exc rfl (fun t f hf ht h => by
    rcases ht with rfl | rfl | rfl | rfl
    · exact absurd h (ordE6_ne_ordF4 hn hf)
    · exact ⟨rfl, rfl, eq_of_ordE6_eq hn hf h⟩
    · exact absurd h (ordE6_ne_ordE8 hn hf)
    · exact absurd h (ordE6_ne_ordTwistedE6 hn hf)) t

theorem ggMarkTypeDet_twE6 {n' : ℕ} (hn : 1 ≤ n') (t : StatedLieTag) :
    GGMarkTypeDetAt ⟨.twE6, 0, n'⟩ t :=
  ggMarkTypeDetAt_of_exc rfl (fun t f hf ht h => by
    rcases ht with rfl | rfl | rfl | rfl
    · exact absurd h (ordTwistedE6_ne_ordF4 hn hf)
    · exact absurd h (ordTwistedE6_ne_ordE6 hn hf)
    · exact absurd h (ordTwistedE6_ne_ordE8 hn hf)
    · exact ⟨rfl, rfl, eq_of_ordTwistedE6_eq hn hf h⟩) t

theorem ggMarkTypeDet_triD4 {n' : ℕ} (hn : 1 ≤ n') (t : StatedLieTag) :
    GGMarkTypeDetAt ⟨.triD4, 0, n'⟩ t :=
  ggMarkTypeDetAt_of_exc rfl (fun t f hf ht h => by
    rcases ht with rfl | rfl | rfl | rfl
    · exact absurd h (ordTrialityD4_ne_ordF4 hn hf)
    · exact absurd h (ordTrialityD4_ne_ordE6 hn hf)
    · exact absurd h (ordTrialityD4_ne_ordE8 hn hf)
    · exact absurd h (ordTrialityD4_ne_ordTwistedE6 hn hf)) t

theorem ggMarkTypeDet_twF4 {n' : ℕ} (hn : 1 ≤ n') (t : StatedLieTag) :
    GGMarkTypeDetAt ⟨.twF4, 0, n'⟩ t :=
  ggMarkTypeDetAt_of_exc rfl (fun t f hf ht h => by
    rcases ht with rfl | rfl | rfl | rfl
    · exact absurd h (ordTwistedF4_ne_ordF4 hn hf)
    · exact absurd h (ordTwistedF4_ne_ordE6 hn hf)
    · exact absurd h (ordTwistedF4_ne_ordE8 hn hf)
    · exact absurd h (ordTwistedF4_ne_ordTwistedE6 hn hf)) t

theorem unitary_param_eq {lab : LargeEvenLabel} (hlab : LargeEvenInLambda2 lab)
    (hU : GGMpUnitaryLabel lab) {X : Type} [Group X] (hX : MarkedModel lab X) {t : StatedLieTag}
    {n f : ℕ} (hadm : StatedLieAdmissible t n 2 f) (hM : LieModel X t n 2 f) :
    t = .PSU ∧ n = markRank lab ∧ f = markDeg lab := by
  obtain ⟨tg, l, n'⟩ := lab
  rcases hU with h | ⟨h, h3⟩
  · dsimp only at h
    subst h
    have hX' : LieModel X .PSU (l + 1) 2 n' := hX
    have hl : 2 ≤ l := hlab.2.1
    rcases (by omega : l + 1 = 3 ∨ 4 ≤ l + 1) with h3 | h4
    · rw [h3] at hX'
      have := CFSG.LocalAnalysis.EvenBN.GMSK.su3EvenTypeDet X n' t n f hX' hadm hM
      exact ⟨this.1, this.2.1.trans h3.symm, this.2.2⟩
    · exact CFSG.SeitzReduction.UnitaryPilot.sumEvenTypeDetAt h4 X n' t n f hX' hadm hM
  · dsimp only at h h3
    subst h h3
    have hX' : LieModel X .PSU 4 2 n' := hX
    exact CFSG.SeitzReduction.UnitaryPilot.sumEvenTypeDetAt le_rfl X n' t n f hX' hadm hM

