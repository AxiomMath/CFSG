section Vacuous

theorem ggInnerDiagStdOn_of_typeDet {S : LargeEvenLabel → Prop}
    (hdet : ∀ lab, LargeEvenInLambda2 lab → S lab → ∀ t, GGMarkTypeDetAt lab t)
    (hrk0 : ∀ lab, LargeEvenInLambda2 lab → S lab → ∀ n f, (ggU (markTag lab) n f).D.rank < 2) :
    GGInnerDiagStdOn S := by
  intro G _ _ t n f ψ hadm hrk hker lab hlab hS Q hQ
  refine largeEvenRawDatum_mono (fun R _ I F hq => ⟨hq, fun _ _ hM ⟨e⟩ => ?_⟩) hQ
  obtain ⟨h1, -, -, -⟩ := hdet lab hlab hS t _ n f hadm hrk
    (lieModel_range_centerQuot hadm hrk ψ hker) (MarkedModel.of_mulEquiv e.symm hM)
  subst h1
  exact absurd hrk (by have := hrk0 lab hlab hS n f; omega)

theorem ggInnerDiagStdOn_b2der : GGInnerDiagStdOn fun lab => lab.tag = .B2der := by
  intro G _ _ t n f ψ hadm hrk hker lab hlab hB Q hQ
  obtain ⟨tg, l, n'⟩ := lab
  dsimp only at hB
  subst hB
  obtain ⟨K, _, _, hK, hQK⟩ := hQ
  refine ⟨K, inferInstance, inferInstance, hK, hQK, fun _ _ _ ⟨e⟩ => ?_⟩
  exfalso
  obtain ⟨e₁⟩ := nonempty_b2der_equiv_alternatingGroup hK
  have hcard : Nat.card (↥ψ.range ⧸ Subgroup.center ↥ψ.range) = 360 := by
    rw [Nat.card_congr (e.trans e₁).toEquiv, nat_card_alternatingGroup, Nat.card_eq_fintype_card,
      Fintype.card_fin]
    decide
  exact evenLieOrder_ne_three_sixty hadm hrk
    ((CFSG.SeitzReduction.F4Pilot.card_eq_evenLieOrder
      (lieModel_range_centerQuot hadm hrk ψ hker)).symm.trans hcard)


theorem ggInnerDiagMpInputOn_triD4 : GGInnerDiagMpInputOn fun lab => lab.tag = .triD4 :=
  ggInnerDiagMpInputOn_of_std (fun lab hlab _ => ggInndiagNormalInput_holds lab hlab)
    (ggInnerDiagStdOn_of_typeDet (fun lab hlab h t => by
      obtain ⟨tg, l, n'⟩ := lab
      dsimp only at h
      subst h
      obtain ⟨hn, rfl⟩ := hlab
      exact ggMarkTypeDet_triD4 hn t) (fun lab _ h n f => by
      obtain ⟨tg, l, n'⟩ := lab
      dsimp only at h
      subst h
      change 0 < 2
      omega))

theorem ggInnerDiagMpInputOn_twF4 : GGInnerDiagMpInputOn fun lab => lab.tag = .twF4 :=
  ggInnerDiagMpInputOn_of_std (fun lab hlab _ => ggInndiagNormalInput_holds lab hlab)
    (ggInnerDiagStdOn_of_typeDet (fun lab hlab h t => by
      obtain ⟨tg, l, n'⟩ := lab
      dsimp only at h
      subst h
      obtain ⟨hn, rfl, -⟩ := hlab
      exact ggMarkTypeDet_twF4 hn t) (fun lab _ h n f => by
      obtain ⟨tg, l, n'⟩ := lab
      dsimp only at h
      subst h
      change 0 < 2
      omega))

theorem ggInnerDiagMpInputOn_b2der : GGInnerDiagMpInputOn fun lab => lab.tag = .B2der :=
  ggInnerDiagMpInputOn_of_std (fun lab hlab _ => ggInndiagNormalInput_holds lab hlab)
    ggInnerDiagStdOn_b2der

