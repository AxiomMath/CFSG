open CFSG.SeitzReduction.F4Pilot in
theorem ordTwistedE6_ne_ordF4 {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b) :
    ordTwistedE6 (2 ^ a) ≠ ordF4 (2 ^ b) := by
  intro h
  have hX := profile_ordTwistedE6' ha
  rw [h] at hX
  have hY := profile_ordF4' hb
  obtain ⟨hN, hw⟩ := profile_top_eq (w := 2 * (a * 9)) (w' := b * 12) hX hY (twE6_top ha)
    (by omega) (fun _ hk => twE6_le ha hk) (Or.inl dvd_rfl) (fun _ hk => f4_le hb hk)
  obtain ⟨c, rfl, rfl⟩ : ∃ c, a = 2 * c ∧ b = 3 * c := ⟨a / 2, by omega, by omega⟩
  have hc : 0 < c := by omega
  have hk := ((hX.transfer hY).2 (2 * c * 8) (by omega) (by omega)).mp
    (Or.inr (Or.inr (Or.inl dvd_rfl)))
  have e : 2 * c * 8 = 16 * c := by ring
  rw [e, show 3 * c * 12 = 36 * c by ring, show 3 * c * 8 = 24 * c by ring,
    show 3 * c * 6 = 18 * c by ring, show 3 * c * 2 = 6 * c by ring] at hk
  rcases hk with h1 | h1 | h1 | h1
  all_goals exact absurd (Nat.dvd_of_mul_dvd_mul_right hc h1) (by decide)

