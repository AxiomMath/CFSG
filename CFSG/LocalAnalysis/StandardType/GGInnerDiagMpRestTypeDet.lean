theorem three_le_tri {m : ℕ} (hm : 2 ≤ m) :
    3 ≤ m * (m + 1) / 2 ∧ (3 ≤ m → 6 ≤ m * (m + 1) / 2) := by
  refine ⟨?_, fun h3 => ?_⟩
  · rw [Nat.le_div_iff_mul_le (by norm_num)]
    nlinarith
  · rw [Nat.le_div_iff_mul_le (by norm_num)]
    nlinarith

