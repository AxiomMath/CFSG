theorem evenLieOrder_ne_three_sixty {t : StatedLieTag} {n f : ℕ}
    (hadm : StatedLieAdmissible t n 2 f) (hrk : 2 ≤ (ggU t n f).D.rank) :
    CFSG.SeitzReduction.F4Pilot.evenLieOrder t n f ≠ 360 := by
  have hf : 1 ≤ f := hadm.2.1
  have h45 : Odd 45 := by decide
  rw [show (360 : ℕ) = 2 ^ 3 * 45 by norm_num]
  cases t with
  | PSL =>
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by have := hadm.2.2.1; omega⟩
    have hm : 2 ≤ m := hrk
    show ordA (m + 1 - 1) (2 ^ f) ≠ _
    rw [Nat.add_sub_cancel]
    by_cases h21 : m = 2 ∧ f = 1
    · obtain ⟨rfl, rfl⟩ := h21
      decide
    · refine (profile_ordA (by omega) hf).ne_of_ne h45 fun hN => h21 ?_
      obtain ⟨hT3, hT6⟩ := three_le_tri hm
      have hle := Nat.le_mul_of_pos_left (m * (m + 1) / 2) (show 0 < f by omega)
      have hT : m * (m + 1) / 2 = 3 := by omega
      have hm2 : m = 2 := by
        by_contra hne
        have := hT6 (by omega)
        omega
      refine ⟨hm2, ?_⟩
      rw [hT] at hN
      omega
  | PSU =>
    obtain ⟨-, -, hn, hn32⟩ := hadm
    show ordTwistedA (n - 1) (2 ^ f) ≠ _
    refine (profile_ordTwistedA (by omega) hf).ne_of_ne h45 fun hN => ?_
    obtain ⟨hT3, hT6⟩ := three_le_tri (m := n - 1) (by omega)
    have hle := Nat.le_mul_of_pos_left ((n - 1) * (n - 1 + 1) / 2) (show 0 < f by omega)
    have hT : (n - 1) * (n - 1 + 1) / 2 = 3 := by omega
    have hn3 : n = 3 := by
      by_contra hne
      have := hT6 (by omega)
      omega
    subst hn3
    rw [hT] at hN
    obtain rfl : f = 1 := by omega
    exact hn32 rfl
  | PSp =>
    obtain ⟨-, -, hn, -⟩ := hadm
    show ordBC n (2 ^ f) ≠ _
    refine (profile_ordBC hf).ne_of_ne h45 fun hN => ?_
    have h4 : 4 ≤ n * n := by nlinarith
    have hle := Nat.le_mul_of_pos_left (n * n) (show 0 < f by omega)
    omega
  | POmegaOdd => exact absurd rfl hadm.2.2.2
  | POmegaPlus =>
    have hn : 4 ≤ n := hadm.2.2
    show ordD n (2 ^ f) ≠ _
    refine (profile_ordD (by omega) hf).ne_of_ne h45 fun hN => ?_
    have h4 : 12 ≤ n * (n - 1) := by
      have : 3 ≤ n - 1 := by omega
      nlinarith
    have hle := Nat.le_mul_of_pos_left (n * (n - 1)) (show 0 < f by omega)
    omega
  | POmegaMinus =>
    have hn : 4 ≤ n := hadm.2.2
    show ordTwistedD n (2 ^ f) ≠ _
    refine (profile_ordTwistedD (by omega) hf).ne_of_ne h45 fun hN => ?_
    have h4 : 12 ≤ n * (n - 1) := by
      have : 3 ≤ n - 1 := by omega
      nlinarith
    have hle := Nat.le_mul_of_pos_left (n * (n - 1)) (show 0 < f by omega)
    omega
  | F4 => exact (profile_ordF4' hf).ne_of_ne h45 (by omega)
  | E6 => exact (profile_ordE6' hf).ne_of_ne h45 (by omega)
  | E7 => exact (profile_ordE7' hf).ne_of_ne h45 (by omega)
  | E8 => exact (profile_ordE8' hf).ne_of_ne h45 (by omega)
  | twistedE6 => exact (profile_ordTwistedE6' hf).ne_of_ne h45 (by omega)
  | G2 => exact absurd hrk (by change ¬ 2 ≤ 0; omega)
  | trialityD4 => exact absurd hrk (by change ¬ 2 ≤ 0; omega)
  | twistedB2 => exact absurd hrk (by change ¬ 2 ≤ 0; omega)
  | twistedG2 => exact absurd hrk (by change ¬ 2 ≤ 0; omega)
  | twistedF4 => exact absurd hrk (by change ¬ 2 ≤ 0; omega)
  | Tits => exact absurd hrk (by change ¬ 2 ≤ 0; omega)

end Small

