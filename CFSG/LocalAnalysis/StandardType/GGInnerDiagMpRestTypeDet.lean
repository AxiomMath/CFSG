theorem le_of_dvd_le {k a b : ℕ} (ha : 0 < a) (hab : a ≤ b) (h : k ∣ a) : k ≤ b :=
  (Nat.le_of_dvd ha h).trans hab

theorem e6_le {e k : ℕ} (he : 1 ≤ e) (hk : k ∣ e * 12 ∨ k ∣ e * 9 ∨ k ∣ e * 8 ∨ k ∣ e * 6 ∨
    k ∣ e * 5 ∨ k ∣ e * 2) : k ≤ e * 12 := by
  rcases hk with h | h | h | h | h | h <;> exact le_of_dvd_le (by positivity) (by omega) h

theorem f4_le {e k : ℕ} (he : 1 ≤ e) (hk : k ∣ e * 12 ∨ k ∣ e * 8 ∨ k ∣ e * 6 ∨ k ∣ e * 2) :
    k ≤ e * 12 := by
  rcases hk with h | h | h | h <;> exact le_of_dvd_le (by positivity) (by omega) h

theorem e8_le {e k : ℕ} (he : 1 ≤ e) (hk : k ∣ e * 30 ∨ k ∣ e * 24 ∨ k ∣ e * 20 ∨ k ∣ e * 18 ∨
    k ∣ e * 14 ∨ k ∣ e * 12 ∨ k ∣ e * 8 ∨ k ∣ e * 2) : k ≤ e * 30 := by
  rcases hk with h | h | h | h | h | h | h | h <;> exact le_of_dvd_le (by positivity) (by omega) h

theorem twE6_le {e k : ℕ} (he : 1 ≤ e) (hk : k ∣ e * 12 ∨ (k ∣ 2 * (e * 9) ∧ ¬ k ∣ e * 9) ∨
    k ∣ e * 8 ∨ k ∣ e * 6 ∨ (k ∣ 2 * (e * 5) ∧ ¬ k ∣ e * 5) ∨ k ∣ e * 2) :
    k ≤ 2 * (e * 9) := by
  rcases hk with h | ⟨h, -⟩ | h | h | ⟨h, -⟩ | h <;>
    exact le_of_dvd_le (by positivity) (by omega) h

theorem triD4_le {e k : ℕ} (he : 1 ≤ e) (hk : (k ∣ e * 12 ∧ ¬ k ∣ e * 4) ∨ k ∣ e * 6 ∨
    k ∣ e * 2) : k ≤ e * 12 := by
  rcases hk with ⟨h, -⟩ | h | h <;> exact le_of_dvd_le (by positivity) (by omega) h

theorem twF4_le {e k : ℕ} (he : 1 ≤ e) (hk : (k ∣ 2 * (e * 6) ∧ ¬ k ∣ e * 6) ∨ k ∣ e * 4 ∨
    (k ∣ 2 * (e * 3) ∧ ¬ k ∣ e * 3) ∨ k ∣ e) : k ≤ 2 * (e * 6) := by
  rcases hk with ⟨h, -⟩ | h | ⟨h, -⟩ | h <;> exact le_of_dvd_le (by positivity) (by omega) h

theorem not_two_mul_dvd {a : ℕ} (ha : 0 < a) : ¬ 2 * a ∣ a := fun h => by
  have := Nat.le_of_dvd ha h
  omega

theorem twE6_top {e : ℕ} (he : 1 ≤ e) : 2 * (e * 9) ∣ e * 12 ∨
    (2 * (e * 9) ∣ 2 * (e * 9) ∧ ¬ 2 * (e * 9) ∣ e * 9) ∨ 2 * (e * 9) ∣ e * 8 ∨
    2 * (e * 9) ∣ e * 6 ∨ (2 * (e * 9) ∣ 2 * (e * 5) ∧ ¬ 2 * (e * 9) ∣ e * 5) ∨
    2 * (e * 9) ∣ e * 2 :=
  Or.inr (Or.inl ⟨dvd_rfl, not_two_mul_dvd (by positivity)⟩)

theorem triD4_top {e : ℕ} (he : 1 ≤ e) :
    (e * 12 ∣ e * 12 ∧ ¬ e * 12 ∣ e * 4) ∨ e * 12 ∣ e * 6 ∨ e * 12 ∣ e * 2 :=
  Or.inl ⟨dvd_rfl, fun h => by have := Nat.le_of_dvd (by positivity) h; omega⟩

theorem twF4_top {e : ℕ} (he : 1 ≤ e) : (2 * (e * 6) ∣ 2 * (e * 6) ∧ ¬ 2 * (e * 6) ∣ e * 6) ∨
    2 * (e * 6) ∣ e * 4 ∨ (2 * (e * 6) ∣ 2 * (e * 3) ∧ ¬ 2 * (e * 6) ∣ e * 3) ∨
    2 * (e * 6) ∣ e :=
  Or.inl ⟨dvd_rfl, not_two_mul_dvd (by positivity)⟩

