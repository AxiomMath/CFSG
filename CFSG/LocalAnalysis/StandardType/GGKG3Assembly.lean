theorem k3a_lang
    (K : Type) [Field K] [Finite K] (hK : Nat.card K = 2) :
    ∃ (L : Type) (_ : Field L) (_ : IsAlgClosed L) (S : LangSetup .E6 L 7),
      S.D.q = 2 ∧ (∀ γ, IsRoot .E6 γ → S.ρ γ = (wordMat .E6 e6ThreeWord) *ᵥ γ) ∧
      (∃ S₀ : Sylow 7 S.Γ, (S₀ : Subgroup S.Γ) ≤ S.D.torus.subgroupOf S.Γ) ∧
      Nonempty (adjointGroup .E6 K ≃* S.Γ) ∧
      (∃ Fr : L →+* L, (∀ c, Fr c = c ^ S.D.q) ∧ S.D.Φ = Units.map (entrywiseHom Fr)) := by
  have h7 : ¬ 7 ∣ Nat.card K := by rw [hK]; decide
  have he : orderOf ((Nat.card K : ℕ) : ZMod 7) = 3 := by
    rw [hK]
    exact orderOf_eq_prime (p := 3) (by decide) (by decide)
  obtain ⟨L, i1, i2, S, hq, -, hρ, hsyl, hequiv, hΦ⟩ :=
    CFSG.Assembly.E6FourPhi.exists_lang_untw_of_blocks_alg_rho_phi frobeniusOnRoots_proved 3
      (Or.inl ⟨rfl, rfl⟩) K (p := 7) (by norm_num) (by norm_num) h7
      (IsWeylMatrix.of_word Tag.E6 e6ThreeWord) [3, 3, 3] e6Three_charpoly e6Three_pow he
      (by decide) (by decide) (by decide)
      (CFSG.LieType.Simplicity.isQuasisimple_adjointGroup_e6 K).1
  exact ⟨L, i1, i2, S, hq.trans hK, hρ, hsyl, hequiv, hΦ⟩

theorem k3a
    (K : Type) [Field K] [Finite K] (hK : Nat.card K = 2) :
    ∃ (L : Type) (_ : Field L) (_ : IsAlgClosed L) (S : LangSetup .E6 L 7),
      IsK3Setup S ∧ Nonempty (adjointGroup .E6 K ≃* S.Γ) := by
  obtain ⟨L, i1, i2, S, hq, hρ, hsyl, ⟨e⟩, hΦ⟩ := k3a_lang K hK
  have hord : 7 ^ (Nat.card S.Γ).factorization 7 = 7 ^ 3 := by
    rw [← Nat.card_congr e.toEquiv]
    have := CFSG.RankThree.PartOne.KE6.e6Three_ordProj K (p := 7) (by norm_num) (by norm_num)
      (by rw [hK]; norm_num)
    rw [this, hK]
    have h343 : ((2 ^ 2 + 2 + 1 : ℕ) ^ 3).factorization 7 = 3 := by
      rw [show (2 ^ 2 + 2 + 1 : ℕ) = 7 by norm_num, Nat.factorization_pow]
      simp [Nat.Prime.factorization_self (show Nat.Prime 7 by norm_num)]
    rw [h343]
  obtain ⟨hcard, hS⟩ := k3a_sylow S hq hρ hsyl hord
  exact ⟨L, i1, i2, S, ⟨hq, hρ, hΦ, hcard, hS⟩, ⟨e⟩⟩

theorem k3_noRefl_lang
    {L : Type} [Field L] [IsAlgClosed L] (S : LangSetup .E6 L 7) (hS : IsK3Setup S) :
    ∀ φ ∈ ggAutomizer (⊤ : Subgroup ↥S.Γ) (S.E.subgroupOf S.Γ), ¬ GGIsReflection 7 φ := by
  intro φ hφ hr
  obtain ⟨g, -, hgN, hg⟩ := mem_ggAutomizer_iff.mp hφ
  obtain ⟨c, hcw, hc⟩ := k3b S hS g hgN
  obtain ⟨hc2, htr⟩ := k3c S hS φ hr c hcw (fun x => by rw [hg x]; exact hc x x.2)
  exact k3d ⟨c, hcw, hc2, htr⟩

private theorem kg3_units_subsingleton_of_card_two (K : Type) [Field K] [Finite K]
    (hK : Nat.card K = 2) : Subsingleton Kˣ := by
  classical
  haveI := Fintype.ofFinite K
  rw [← Fintype.card_le_one_iff_subsingleton, Fintype.card_units]
  rw [Nat.card_eq_fintype_card] at hK
  omega

theorem k3_card_subgroupOf
    {L : Type} [Field L] [IsAlgClosed L] (S : LangSetup .E6 L 7)
    (hS : IsK3Setup S) : Nat.card ↥(S.E.subgroupOf S.Γ) = 7 ^ 3 := by
  have hle : S.E ≤ S.Γ := fun x hx => (S.E_le hx).2
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv]
  exact hS.card_E

theorem kg3_of_field
    (K : Type) [Field K] [Finite K] (hK : Nat.card K = 2) :
    ∃ r, GGTorusLift 7 r (TableBExc.RecipeGroup .E6 K) ∧
      GGTorusNoRefl 7 r (TableBExc.RecipeGroup .E6 K) (TableBExc.RecipeID .E6 K) := by
  obtain ⟨L, i1, i2, S, hS, ⟨eK⟩⟩ := k3a K hK
  haveI := S.finite_Γ
  let e : TableBExc.RecipeGroup .E6 K ≃* S.Γ := (TableBExc.recipeEquiv .E6 K).trans eK
  obtain ⟨P, hP⟩ := hS.sylow_E
  have hΓ : 7 ^ (Nat.card S.Γ).factorization 7 = 7 ^ 3 := by
    rw [← Sylow.card_eq_multiplicity P, hP]
    exact k3_card_subgroupOf S hS
  have hR : 7 ^ (Nat.card (TableBExc.RecipeGroup .E6 K)).factorization 7 = 7 ^ 3 := by
    rw [Nat.card_congr e.toEquiv]
    exact hΓ
  refine ⟨0, TypeA.ggTorusLift_zero ?_, ?_⟩
  · have : CharP K 2 :=
      CFSG.LocalAnalysis.ComponentInitial.finite_field_prime_power_characteristic (K := K)
        Nat.prime_two (k := 1) le_rfl (by simpa using hK)
    rw [Nat.card_congr (TableBExc.recipeEquiv .E6 K).toEquiv]
    exact two_dvd_card_adjoint_E6
  · haveI := kg3_units_subsingleton_of_card_two K hK
    refine ggTorusNoRefl_of_sylow _ 0 (TableBExc.center_recipeGroup_eq_bot .E6 K)
      (TableBExc.idImage_subset_inn_of_top .E6 K (Subsingleton.elim _ _)) hR
      ((S.E.subgroupOf S.Γ).map e.symm.toMonoidHom) ?_ ?_
    · rw [Subgroup.card_map_of_injective e.symm.injective]
      exact k3_card_subgroupOf S hS
    · refine ggNoRefl_of_mulEquiv e _ ?_
      have : ((S.E.subgroupOf S.Γ).map e.symm.toMonoidHom).map e.toMonoidHom =
          S.E.subgroupOf S.Γ := by
        rw [Subgroup.map_map]
        simp
      rw [this]
      exact k3_noRefl_lang S hS

theorem kg3 :
    GGForkE6TwoNoReflKGInput := by
  intro Q hQ
  obtain ⟨K, hF, hFin, hK, hQK⟩ := hQ
  exact ⟨K, hF, hFin, hK, hQK, kg3_of_field K (by simpa using hK)⟩

