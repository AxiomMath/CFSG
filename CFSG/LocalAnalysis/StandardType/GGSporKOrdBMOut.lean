theorem bmOut_card_aut_dvd {R : Type} [Group R] [Finite R] {m : ℕ}
    (h : Nat.card (Outer R) ∣ m) : Nat.card (MulAut R) ∣ Nat.card R * m := by
  have hcard : Nat.card (MulAut R) = Nat.card (Outer R) * Nat.card (inner R) :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup (inner R)
  have hinner : Nat.card (inner R) ∣ Nat.card R := by
    change Nat.card (MulAut.conj : R →* MulAut R).range ∣ Nat.card R
    exact Subgroup.card_range_dvd _
  rw [hcard, Nat.mul_comm (Nat.card R) m]
  exact mul_dvd_mul h hinner

theorem bmFact_le_of_dvd {a B : ℕ} (hB : B ≠ 0) (h : a ∣ B) (ℓ : ℕ) :
    a.factorization ℓ ≤ B.factorization ℓ := by
  have ha : a ≠ 0 := by
    rintro rfl
    obtain ⟨c, hc⟩ := h
    exact hB (by simpa using hc)
  exact (Nat.factorization_le_iff_dvd ha hB).2 h ℓ

theorem ordBMBound_PSL_two {p f : ℕ} (hp : p.Prime) (hf : 1 ≤ f) :
    OrdBMBound .PSL 2 p f (p ^ f * ((p ^ f) ^ 2 - 1) * f) := by
  haveI : Fact p.Prime := ⟨hp⟩
  intro R _ _ _ hmodel ℓ _ _
  have hT : StatedClassicalModel R .PSL 2 p f :=
    LieModel.statedClassicalModel_of_ne_zero (by norm_num : 2 ≠ 0) hmodel
  obtain ⟨e⟩ := CFSG.LocalAnalysis.GLTheoremA.small_psl_iso hf hT
  rw [CFSG.LocalAnalysis.GLTheoremA.small_card_aut_psl hf e]

theorem ordBMBound_PSL {n f : ℕ} (hn : 3 ≤ n) (hf : 1 ≤ f) :
    OrdBMBound .PSL n 2 f (lieOrd .PSL n (2 ^ f) * (2 * f * Nat.gcd n (2 ^ f - 1))) := by
  intro R _ _ _ hmodel ℓ _ _
  have hT : StatedClassicalModel R .PSL n 2 f :=
    LieModel.statedClassicalModel_of_ne_zero (by omega : n ≠ 0) hmodel
  have hout : Nat.card (Outer R) ∣ 2 * f * Nat.gcd n (2 ^ f - 1) := by
    simpa only [CFSG.RankThree.OuterOrder.determinantParameter] using
      (CFSG.RankThree.OuterOrder.higher_linear_unitary_outer_order_determinant_bound
        (Or.inl rfl) hn Nat.prime_two hf hT).1
  have hcardR : Nat.card R = lieOrd .PSL n (2 ^ f) := card_eq_lieOrd_of_classical hT
  have hlie : 0 < lieOrd .PSL n (2 ^ f) := by
    rw [← hcardR]
    exact Finite.card_pos_iff.mpr ⟨1⟩
  have hB : lieOrd .PSL n (2 ^ f) * (2 * f * Nat.gcd n (2 ^ f - 1)) ≠ 0 := by
    apply mul_ne_zero
    · exact ne_of_gt hlie
    · exact mul_ne_zero (mul_ne_zero (by norm_num) (by omega))
        (gcd_ne_zero_of_left (by omega : n ≠ 0))
  have hdvd : Nat.card (MulAut R) ∣ Nat.card R * (2 * f * Nat.gcd n (2 ^ f - 1)) :=
    bmOut_card_aut_dvd hout
  rw [hcardR] at hdvd
  exact bmFact_le_of_dvd hB hdvd ℓ

theorem ordBMBound_PSU {n p f : ℕ} (hn : 3 ≤ n) (hp : p.Prime) (hf : 1 ≤ f)
    (hq : (n, p ^ f) ≠ (3, 2)) :
    OrdBMBound .PSU n p f (lieOrd .PSU n (p ^ f) * (2 * f * Nat.gcd n (p ^ f + 1))) := by
  intro R _ _ _ hmodel ℓ hℓ hℓ2
  have hT : StatedClassicalModel R .PSU n p f :=
    CFSG.Blueprint.LieModel.statedClassicalModel hmodel (by simp [classicalTags])
  have hout : Nat.card (Outer R) ∣
      2 * f * CFSG.RankThree.OuterOrder.determinantParameter .PSU n (p ^ f) :=
    (CFSG.RankThree.OuterOrder.higher_linear_unitary_outer_order_determinant_bound
      (Or.inr rfl) hn hp hf hT).1
  have hout' : Nat.card (Outer R) ∣ 2 * f * Nat.gcd n (p ^ f + 1) := by
    simpa [CFSG.RankThree.OuterOrder.determinantParameter] using hout
  have haut : Nat.card (MulAut R) ∣ Nat.card R * (2 * f * Nat.gcd n (p ^ f + 1)) :=
    bmOut_card_aut_dvd hout'
  have hR : Nat.card R = lieOrd .PSU n (p ^ f) :=
    CFSG.EvenSmallLie.CatalogOrders.card_eq_lieOrd_of_classical hT
  have hdvd : Nat.card (MulAut R) ∣
      lieOrd .PSU n (p ^ f) * (2 * f * Nat.gcd n (p ^ f + 1)) := by
    rwa [hR] at haut
  have hg : 0 < Nat.gcd n (p ^ f + 1) :=
    Nat.pos_of_dvd_of_pos (Nat.gcd_dvd_left n (p ^ f + 1)) (by omega)
  have hfac : 2 * f * Nat.gcd n (p ^ f + 1) ≠ 0 :=
    (Nat.mul_pos (by omega) hg).ne'
  have hB : lieOrd .PSU n (p ^ f) * (2 * f * Nat.gcd n (p ^ f + 1)) ≠ 0 :=
    Nat.mul_ne_zero (by rw [← hR]; exact Nat.card_pos.ne') hfac
  exact bmFact_le_of_dvd hB hdvd ℓ

theorem ordBMBound_PSp {r f : ℕ} (hr : 3 ≤ r) (hf : 1 ≤ f) :
    OrdBMBound .PSp r 2 f (lieOrd .PSp r (2 ^ f) * f) := by
  intro R _ _ _ hmodel ℓ hℓ hℓ2
  have hT : StatedClassicalModel R .PSp r 2 f :=
    CFSG.Blueprint.LieModel.statedClassicalModel hmodel (by simp [classicalTags])
  obtain ⟨K, hfield, hfinite, hcard, ⟨e⟩⟩ := hT.2
  letI : Field K := hfield
  letI : Finite K := hfinite
  have hout := (CFSG.RankThree.Classical.higher_symplectic_outer_order_divides_field_multiplier_bound
    Nat.prime_two hf hr hcard).1
  have hodd : Odd (2 ^ f - 1) := by
    have hEven : Even (2 ^ f) := even_iff_two_dvd.mpr (dvd_pow_self 2 (by omega))
    exact Nat.Even.sub_odd (by have : 0 < 2 ^ f := pow_pos (by norm_num) f; omega) hEven odd_one
  have hgcd : Nat.gcd 2 (2 ^ f - 1) = 1 := (Nat.coprime_two_left.mpr hodd).gcd_eq_one
  rw [hgcd, Nat.mul_one] at hout
  have houtR : Nat.card (Outer R) ∣ f := by
    rw [Nat.card_congr
      (CFSG.ComponentClassification.OuterAutomorphisms.equivalence e).toEquiv]
    exact hout
  have haut : Nat.card (MulAut R) ∣ Nat.card R * f := bmOut_card_aut_dvd houtR
  have hR : Nat.card R = lieOrd .PSp r (2 ^ f) :=
    CFSG.EvenSmallLie.CatalogOrders.card_eq_lieOrd_of_classical hT
  have hdvd : Nat.card (MulAut R) ∣ lieOrd .PSp r (2 ^ f) * f := by
    rwa [hR] at haut
  have hB : lieOrd .PSp r (2 ^ f) * f ≠ 0 :=
    Nat.mul_ne_zero (by rw [← hR]; exact Nat.card_pos.ne') (by omega)
  exact bmFact_le_of_dvd hB hdvd ℓ

