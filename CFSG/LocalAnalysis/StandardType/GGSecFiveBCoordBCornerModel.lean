private theorem mem_range_conj_statedSp {m : ℕ} (hm : 3 ≤ m) :
    ∀ γ : MulAut (CFSG.Open.StatedSp m (ZMod 2)),
      γ ∈ Set.range (MulAut.conj :
        CFSG.Open.StatedSp m (ZMod 2) →* MulAut (CFSG.Open.StatedSp m (ZMod 2))) := by
  intro γ
  let eP : LargeEvenProj (LargeEvenSpGroup (ZMod 2) m) ≃* CFSG.Open.StatedSp m (ZMod 2) :=
    CFSG.SeitzReduction.OmegaPilot.spProjEquivCharTwo (ZMod 2) m
  let δ : MulAut (LargeEvenProj (LargeEvenSpGroup (ZMod 2) m)) :=
    (MulAut.congr eP).symm γ
  obtain ⟨q, hq⟩ := TwoThree.mem_range_conj_sp (K := ZMod 2) (m := m)
    (by rw [Nat.card_eq_fintype_card, ZMod.card]) hm δ
  have hnat : MulAut.congr eP (MulAut.conj q) = MulAut.conj (eP q) := by
    ext x
    simp [MulAut.congr_apply, MulAut.conj_apply]
  refine ⟨eP q, ?_⟩
  calc MulAut.conj (eP q) = MulAut.congr eP (MulAut.conj q) := hnat.symm
    _ = MulAut.congr eP δ := by rw [hq]
    _ = γ := (MulAut.congr eP).apply_symm_apply γ

private theorem conj_injective_statedSp (m : ℕ) :
    Function.Injective (MulAut.conj :
      CFSG.Open.StatedSp m (ZMod 2) →* MulAut (CFSG.Open.StatedSp m (ZMod 2))) := by
  rw [injective_iff_map_eq_one]
  intro g hg
  have hZ : Subgroup.center (CFSG.Open.StatedSp m (ZMod 2)) = ⊥ :=
    CFSG.SeitzReduction.SymplecticPilot.center_statedSp_eq_bot m
  have hgZ : g ∈ Subgroup.center (CFSG.Open.StatedSp m (ZMod 2)) := by
    rw [Subgroup.mem_center_iff]
    intro x
    have h : g * x * g⁻¹ = x := by
      simpa [MulAut.conj_apply] using congrArg (fun φ => φ x) hg
    calc x * g = (g * x * g⁻¹) * g := by rw [h]
      _ = g * x := by group
  rwa [hZ, Subgroup.mem_bot] at hgZ

private theorem nonempty_mulEquiv_statedSp
    {L : Type} [Group L] [Finite L] {m : ℕ} {K : Type} [Field K] [Finite K]
    (F : Fintype K) (hm : 4 ≤ m) (hK : Nat.card K = 2 ^ 1) (hL : commutator L = ⊤)
    (θ : L ⧸ Subgroup.center L ≃* LargeEvenProj (LargeEvenSpGroup K m)) :
    Nonempty (CFSG.Open.StatedSp m (ZMod 2) ≃* L) := by
  obtain ⟨ψ, hψ, hψθ⟩ := exists_spLift_of_mulEquiv (L := L) (n := m)
    (sp_exists_section_even (f := 1) hK le_rfl hm) hL θ
  have hψinj : Function.Injective ψ :=
    injective_of_spLift (n := m)
      (statedScalars_subgroupOf_statedSp_eq_bot_of_card (n := m) hK le_rfl (by omega)) θ hψθ
  have hcard : @Fintype.card (ZMod 2) _ = @Fintype.card K F := by
    rw [ZMod.card, ← @Nat.card_eq_fintype_card K F, hK, pow_one]
  let ε : ZMod 2 ≃+* K :=
    @FiniteField.ringEquivOfCardEq (ZMod 2) K _ _ _ F hcard
  exact ⟨(CFSG.LocalAnalysis.ComponentInitial.BinarySymplecticSix.statedSpCongr ε m).trans
    (MulEquiv.ofBijective ψ ⟨hψinj, hψ⟩)⟩

private noncomputable def modelAlpha {Bs : Subgroup G} {L : Subgroup G}
    (hBsN : Bs ≤ Subgroup.normalizer (L : Set G)) : ↥Bs →* MulAut L :=
  L.normalizerMonoidHom.comp (Subgroup.inclusion hBsN)

private noncomputable def modelBeta {Bs : Subgroup G} {L : Subgroup G} {m : ℕ}
    (hBsN : Bs ≤ Subgroup.normalizer (L : Set G)) (e : CFSG.Open.StatedSp m (ZMod 2) ≃* L) :
    ↥Bs →* MulAut (CFSG.Open.StatedSp m (ZMod 2)) :=
  ((MulAut.congr e).symm.toMonoidHom).comp (modelAlpha hBsN)

private noncomputable def conjEquivStatedSp (m : ℕ) (hm : 3 ≤ m) :
    CFSG.Open.StatedSp m (ZMod 2) ≃* MulAut (CFSG.Open.StatedSp m (ZMod 2)) :=
  MulEquiv.ofBijective MulAut.conj
    ⟨conj_injective_statedSp m, mem_range_conj_statedSp hm⟩

private noncomputable def modelRho {Bs : Subgroup G} {L : Subgroup G} {m : ℕ}
    (hm : 3 ≤ m) (hBsN : Bs ≤ Subgroup.normalizer (L : Set G))
    (e : CFSG.Open.StatedSp m (ZMod 2) ≃* L) : ↥Bs →* CFSG.Open.StatedSp m (ZMod 2) :=
  (conjEquivStatedSp m hm).symm.toMonoidHom.comp (modelBeta hBsN e)

private theorem modelRho_conj {Bs : Subgroup G} {L : Subgroup G} {m : ℕ}
    (hm : 3 ≤ m) (hBsN : Bs ≤ Subgroup.normalizer (L : Set G))
    (e : CFSG.Open.StatedSp m (ZMod 2) ≃* L) (b : ↥Bs) :
    MulAut.conj (modelRho hm hBsN e b) = modelBeta hBsN e b := by
  change (conjEquivStatedSp m hm) ((conjEquivStatedSp m hm).symm (modelBeta hBsN e b)) =
    modelBeta hBsN e b
  exact (conjEquivStatedSp m hm).apply_symm_apply (modelBeta hBsN e b)

private theorem modelRho_action {Bs : Subgroup G} {L : Subgroup G} {m : ℕ}
    (hm : 3 ≤ m) (hBsN : Bs ≤ Subgroup.normalizer (L : Set G))
    (e : CFSG.Open.StatedSp m (ZMod 2) ≃* L) (b : ↥Bs)
    (g : CFSG.Open.StatedSp m (ZMod 2)) :
    L.subtype (e (modelRho hm hBsN e b * g * (modelRho hm hBsN e b)⁻¹)) =
      (b : G) * L.subtype (e g) * (b : G)⁻¹ := by
  have h1 : modelRho hm hBsN e b * g * (modelRho hm hBsN e b)⁻¹ =
      MulAut.conj (modelRho hm hBsN e b) g := by rw [MulAut.conj_apply]
  rw [h1, modelRho_conj, modelBeta, MonoidHom.comp_apply]
  have h2 : e (((MulAut.congr e).symm.toMonoidHom (modelAlpha hBsN b)) g) =
      modelAlpha hBsN b (e g) := by
    simp
  rw [h2]
  change ((L.normalizerMonoidHom (Subgroup.inclusion hBsN b) (e g) : L) : G) = _
  rw [normalizerMonoidHom_coe]
  rfl

private theorem modelRho_ker {Bs : Subgroup G} {L : Subgroup G} {m : ℕ}
    (hm : 3 ≤ m) (hBsN : Bs ≤ Subgroup.normalizer (L : Set G))
    (e : CFSG.Open.StatedSp m (ZMod 2) ≃* L) (b : ↥Bs)
    (hb : modelRho hm hBsN e b = 1) : (b : G) ∈ Subgroup.centralizer (L : Set G) := by
  have hβ1 : modelBeta hBsN e b = 1 := by
    rw [← modelRho_conj hm hBsN e b, hb, map_one]
  have hα1 : modelAlpha hBsN b = 1 := by
    have h := congrArg (MulAut.congr e) hβ1
    rw [map_one] at h
    calc modelAlpha hBsN b = MulAut.congr e (modelBeta hBsN e b) := by
          rw [modelBeta, MonoidHom.comp_apply]
          exact ((MulAut.congr e).apply_symm_apply (modelAlpha hBsN b)).symm
      _ = 1 := h
  rw [Subgroup.mem_centralizer_iff]
  intro l hl
  have h := congrArg (fun σ : MulAut L => σ ⟨l, hl⟩) hα1
  have h2 : (b : G) * l * (b : G)⁻¹ = l := by
    have h3 : ((modelAlpha hBsN b) ⟨l, hl⟩ : L) = ⟨l, hl⟩ := by simpa using h
    have := congrArg (fun x : L => (x : G)) h3
    simpa [modelAlpha, normalizerMonoidHom_coe] using this
  calc l * (b : G) = ((b : G) * l * (b : G)⁻¹) * (b : G) := by rw [h2]
    _ = (b : G) * l := by group

private theorem eq_pow_of_axis {n : ℕ} {i0 : Fin n}
    {f g : Fin n → Multiplicative (ZMod 3)}
    (hf : ∀ k, k ≠ i0 → f k = 1) (hg : ∀ k, k ≠ i0 → g k = 1)
    (hg0 : g i0 ≠ 1) : ∃ m : ℕ, f = g ^ m := by
  have hf' : f = Pi.mulSingle i0 (f i0) := by
    funext k
    by_cases hk : k = i0
    · subst hk; rw [Pi.mulSingle_eq_same]
    · rw [Pi.mulSingle_eq_of_ne hk, hf k hk]
  have hg' : g = Pi.mulSingle i0 (g i0) := by
    funext k
    by_cases hk : k = i0
    · subst hk; rw [Pi.mulSingle_eq_same]
    · rw [Pi.mulSingle_eq_of_ne hk, hg k hk]
  have hc : toAdd (g i0) ≠ 0 := by
    intro h
    exact hg0 (by rw [← ofAdd_toAdd (g i0), h, ofAdd_zero])
  obtain ⟨m, hm⟩ := SpCoord.exists_natCast_mul_eq (p := 3) (by norm_num) hc (toAdd (f i0))
  refine ⟨m, ?_⟩
  rw [hf', hg']
  conv_lhs => rw [← ofAdd_toAdd (f i0)]
  conv_rhs => rw [← ofAdd_toAdd (g i0)]
  rw [SpCoord.mulSingle_ofAdd_pow, hm]

private theorem ggAutomizer_fix_of_mem_centralizer {Bs : Subgroup G} {L : Subgroup G}
    {b : ↥Bs} (hb : (b : G) ∈ Subgroup.centralizer (L : Set G)) :
    ∀ ψ ∈ ggAutomizer L Bs, ψ b = b := by
  intro ψ hψ
  induction hψ using Subgroup.closure_induction with
  | mem u hu =>
      obtain ⟨g, hgL, -, hgu⟩ := hu
      refine Subtype.ext ?_
      rw [hgu b]
      have hcomm := (Subgroup.mem_centralizer_iff.mp hb) g hgL
      calc g * (b : G) * g⁻¹ = ((b : G) * g) * g⁻¹ := by rw [hcomm]
        _ = (b : G) := by group
  | one => rfl
  | mul u v _ _ ihu ihv => rw [MulAut.mul_apply, ihv, ihu]
  | inv u _ ihu =>
      calc u⁻¹ b = u⁻¹ (u b) := by rw [ihu]
        _ = b := MulAut.inv_apply_self _ u b

private theorem axis_of_fixed {Bs : Subgroup G} {L : Subgroup G} {n : ℕ}
    (eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod 3))) {i0 : Fin n}
    (hb : (ggAutomizer L Bs).map (MulAut.congr eta).toMonoidHom = bCoordinateBlock n 3 i0)
    {b : ↥Bs} (hfix : ∀ ψ ∈ ggAutomizer L Bs, ψ b = b) :
    ∀ k, k ≠ i0 → eta b k = 1 := by
  have haxis : ∀ u ∈ (ggAutomizer L Bs).map (MulAut.congr eta).toMonoidHom,
      u (eta b) = eta b := by
    rintro u hu
    obtain ⟨v, hv, rfl⟩ := Subgroup.mem_map.mp hu
    have h2 : (MulAut.congr eta).toMonoidHom v (eta b) = eta (v b) := by
      simp
    rw [h2, hfix v hv]
  rw [hb] at haxis
  exact (forall_bCoordinateBlock_fix_iff (p := 3) (by norm_num) (by norm_num) i0 (eta b)).mp haxis

private theorem mem_zpowers_of_centralizes {B Bs : Subgroup G} {x : G} {L : Subgroup G}
    {n : ℕ} (eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod 3))) {i0 : Fin n}
    (hb : (ggAutomizer L Bs).map (MulAut.congr eta).toMonoidHom = bCoordinateBlock n 3 i0)
    (hBle : B ≤ Bs) (hxB : x ∈ B) (hx1 : x ≠ 1)
    (hxL : x ∈ Subgroup.centralizer (L : Set G))
    {b : ↥Bs} (hbc : (b : G) ∈ Subgroup.centralizer (L : Set G)) :
    b ∈ Subgroup.zpowers (⟨x, hBle hxB⟩ : ↥Bs) := by
  let b₁ : ↥Bs := ⟨x, hBle hxB⟩
  have hbax := axis_of_fixed eta hb (ggAutomizer_fix_of_mem_centralizer hbc)
  have hxax := axis_of_fixed eta hb (ggAutomizer_fix_of_mem_centralizer (b := b₁) hxL)
  have hxne : eta b₁ ≠ 1 := by
    intro h
    apply hx1
    exact congrArg Subtype.val (eta.injective (by simpa using h))
  have hx0 : eta b₁ i0 ≠ 1 := by
    intro h
    apply hxne
    funext k
    by_cases hk : k = i0
    · rw [hk]; exact h
    · exact hxax k hk
  obtain ⟨m, hm⟩ := eq_pow_of_axis hbax hxax hx0
  have hb_eq : b = b₁ ^ m := eta.injective (by rw [map_pow]; exact hm)
  refine Subgroup.mem_zpowers_iff.mpr ⟨(m : ℤ), ?_⟩
  rw [zpow_natCast]
  exact hb_eq.symm

private theorem rho_ker_eq_zpowers {B Bs : Subgroup G} {x : G} {L : Subgroup G} {n : ℕ}
    (eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod 3))) {i0 : Fin n}
    (hb : (ggAutomizer L Bs).map (MulAut.congr eta).toMonoidHom = bCoordinateBlock n 3 i0)
    (hBle : B ≤ Bs) (hxB : x ∈ B) (hx1 : x ≠ 1)
    (hxL : x ∈ Subgroup.centralizer (L : Set G))
    (ρ : ↥Bs →* CFSG.Open.StatedSp (n - 1) (ZMod 2))
    (hρx : ρ ⟨x, hBle hxB⟩ = 1)
    (hker : ∀ b, ρ b = 1 → (b : G) ∈ Subgroup.centralizer (L : Set G)) :
    ρ.ker = Subgroup.zpowers (⟨x, hBle hxB⟩ : ↥Bs) := by
  ext b
  rw [MonoidHom.mem_ker]
  constructor
  · intro hb1
    exact mem_zpowers_of_centralizes eta hb hBle hxB hx1 hxL (hker b hb1)
  · intro hb'
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hb'
    rw [← hk, map_zpow, hρx, one_zpow]

private theorem rho_range_data {Bs : Subgroup G} {n : ℕ} (hn : 5 ≤ n)
    (eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod 3)))
    (ρ : ↥Bs →* CFSG.Open.StatedSp (n - 1) (ZMod 2))
    (hBsElem : CFSG.Open.IsElemAbelian 3 Bs)
    (hkerCard : Nat.card ρ.ker = 3) :
    Nat.card ρ.range = 3 ^ (n - 1) ∧ CFSG.Open.IsElemAbelian 3 ρ.range := by
  have hBsCard : Nat.card ↥Bs = 3 ^ n := by
    calc Nat.card ↥Bs = Nat.card (Fin n → Multiplicative (ZMod 3)) := Nat.card_congr eta.toEquiv
      _ = 3 ^ n := by
        rw [Nat.card_eq_fintype_card, Fintype.card_fun]
        simp
  have hmul := Subgroup.card_ker_mul_card_range ρ
  rw [hkerCard, hBsCard] at hmul
  have hpow : 3 ^ n = 3 * 3 ^ (n - 1) := by
    rw [mul_comm, ← pow_succ, Nat.sub_add_cancel (by omega)]
  have hrange : Nat.card ρ.range = 3 ^ (n - 1) := by
    rw [hpow] at hmul
    exact mul_left_cancel₀ (by norm_num : (3 : ℕ) ≠ 0) hmul
  refine ⟨hrange, ?_⟩
  have htop : CFSG.Open.IsElemAbelian 3 (⊤ : Subgroup ↥Bs) := by
    refine ⟨IsMulCommutative.of_comm ?_, ?_⟩
    · intro a b
      exact Subtype.ext (hBsElem.1.is_comm.comm a.1 b.1)
    · intro a _
      exact Subtype.ext (hBsElem.2 (a : G) a.2)
  simpa [MonoidHom.range_eq_map] using TableB.isElemAbelian_map htop ρ

private theorem exists_conj_model {B Bs : Subgroup G} {L : Subgroup G} {n : ℕ}
    (e : CFSG.Open.StatedSp (n - 1) (ZMod 2) ≃* L)
    (ρ : ↥Bs →* CFSG.Open.StatedSp (n - 1) (ZMod 2))
    (hact : ∀ (b : ↥Bs) (g : CFSG.Open.StatedSp (n - 1) (ZMod 2)),
      L.subtype (e (ρ b * g * (ρ b)⁻¹)) = (b : G) * L.subtype (e g) * (b : G)⁻¹)
    (hkerB : ∀ b : ↥Bs, ρ b = 1 → (b : G) ∈ B)
    (hrangeCard : Nat.card ρ.range = 3 ^ (n - 1))
    (hA : CFSG.Open.IsElemAbelian 3 ρ.range) :
    ∃ (φ : CFSG.Open.StatedSp (n - 1) (ZMod 2) →* G)
      (ρ' : ↥Bs →* CFSG.Open.StatedSp (n - 1) (ZMod 2)),
      Function.Injective φ ∧ φ.range = L ∧
      (∀ (b : ↥Bs) (g : CFSG.Open.StatedSp (n - 1) (ZMod 2)),
        φ (ρ' b * g * (ρ' b)⁻¹) = (b : G) * φ g * (b : G)⁻¹) ∧
      ρ'.range = (TwoThree.spPlaneTorus (K := ZMod 2) (r := n - 1)).range ∧
      ∀ b : ↥Bs, ρ' b = 1 → (b : G) ∈ B := by
  obtain ⟨g, hg⟩ := TwoThree.exists_conj_eq_range_spPlaneTorus (K := ZMod 2) (r := n - 1)
    (by rw [Nat.card_eq_fintype_card, ZMod.card]) hA hrangeCard
  let c : CFSG.Open.StatedSp (n - 1) (ZMod 2) ≃* CFSG.Open.StatedSp (n - 1) (ZMod 2) :=
    MulAut.conj g
  let φ : CFSG.Open.StatedSp (n - 1) (ZMod 2) →* G :=
    L.subtype.comp (e.toMonoidHom.comp c.symm.toMonoidHom)
  let ρ' : ↥Bs →* CFSG.Open.StatedSp (n - 1) (ZMod 2) := c.toMonoidHom.comp ρ
  refine ⟨φ, ρ', ?_, ?_, ?_, ?_, ?_⟩
  · exact L.subtype_injective.comp (e.injective.comp c.symm.injective)
  · ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact (e (c.symm x)).2
    · intro hy
      refine ⟨c (e.symm ⟨y, hy⟩), ?_⟩
      change L.subtype (e (c.symm (c (e.symm ⟨y, hy⟩)))) = y
      rw [MulEquiv.symm_apply_apply, MulEquiv.apply_symm_apply]
      rfl
  · intro b y
    have harg : c.symm (c (ρ b) * y * (c (ρ b))⁻¹) = ρ b * c.symm y * (ρ b)⁻¹ := by
      rw [map_mul, map_mul, map_inv, MulEquiv.symm_apply_apply]
    change L.subtype (e (c.symm (c (ρ b) * y * (c (ρ b))⁻¹))) =
      (b : G) * L.subtype (e (c.symm y)) * (b : G)⁻¹
    rw [harg]
    exact hact b (c.symm y)
  · calc ρ'.range = ρ.range.map c.toMonoidHom := MonoidHom.range_comp c.toMonoidHom ρ
      _ = (TwoThree.spPlaneTorus (K := ZMod 2) (r := n - 1)).range := hg
  · intro b hb
    apply hkerB b
    have h : c.symm (c (ρ b)) = 1 := by
      simpa [ρ'] using congrArg c.symm hb
    rwa [MulEquiv.symm_apply_apply] at h

private theorem rho_ker_range {B Bs : Subgroup G} {x : G} {L : Subgroup G} {n : ℕ} (hn : 5 ≤ n)
    (eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod 3))) {i0 : Fin n}
    (hb : (ggAutomizer L Bs).map (MulAut.congr eta).toMonoidHom = bCoordinateBlock n 3 i0)
    (hBle : B ≤ Bs) (hxB : x ∈ B) (hx1 : x ≠ 1)
    (hxL : x ∈ Subgroup.centralizer (L : Set G))
    (hBsElem : CFSG.Open.IsElemAbelian 3 Bs)
    (e : CFSG.Open.StatedSp (n - 1) (ZMod 2) ≃* L)
    (ρ : ↥Bs →* CFSG.Open.StatedSp (n - 1) (ZMod 2))
    (hact : ∀ (b : ↥Bs) (g : CFSG.Open.StatedSp (n - 1) (ZMod 2)),
      L.subtype (e (ρ b * g * (ρ b)⁻¹)) = (b : G) * L.subtype (e g) * (b : G)⁻¹)
    (hker : ∀ b, ρ b = 1 → (b : G) ∈ Subgroup.centralizer (L : Set G)) :
    Nat.card ρ.ker = 3 ∧ Nat.card ρ.range = 3 ^ (n - 1) ∧
      CFSG.Open.IsElemAbelian 3 ρ.range ∧ ∀ b : ↥Bs, ρ b = 1 → (b : G) ∈ B := by
  have hb₁ : (⟨x, hBle hxB⟩ : ↥Bs) ≠ 1 := fun h => hx1 (congrArg Subtype.val h)
  have hcomm : ∀ y : L, (x : G) * (y : G) * (x : G)⁻¹ = (y : G) := by
    intro y
    have h := (Subgroup.mem_centralizer_iff.mp hxL) (y : G) y.2
    calc (x : G) * (y : G) * (x : G)⁻¹ = ((y : G) * x) * (x : G)⁻¹ := by rw [← h]
      _ = (y : G) := by group
  have hρx : ρ ⟨x, hBle hxB⟩ = 1 := by
    have hconj : MulAut.conj (ρ ⟨x, hBle hxB⟩) = 1 := by
      ext1 y
      apply e.injective
      have h := hact ⟨x, hBle hxB⟩ y
      simp only at h
      have h' : x * L.subtype (e y) * x⁻¹ = L.subtype (e y) := by
        simpa using hcomm (e y)
      rw [h'] at h
      exact L.subtype_injective h
    have hconj' : MulAut.conj (ρ ⟨x, hBle hxB⟩) = MulAut.conj 1 := by simpa using hconj
    exact conj_injective_statedSp (n - 1) hconj'
  have hker_eq := rho_ker_eq_zpowers eta hb hBle hxB hx1 hxL ρ hρx hker
  have hkerCard : Nat.card ρ.ker = 3 := by
    rw [hker_eq, Nat.card_zpowers]
    exact orderOf_eq_prime (Subtype.ext (hBsElem.2 (x : G) (hBle hxB))) hb₁
  have hrange := rho_range_data hn eta ρ hBsElem hkerCard
  have hkerB : ∀ b : ↥Bs, ρ b = 1 → (b : G) ∈ B := by
    intro b hbρ
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp
      (mem_zpowers_of_centralizes eta hb hBle hxB hx1 hxL (hker b hbρ))
    have hk' : (b : G) = x ^ k := by
      have := congrArg Subtype.val hk
      simpa using this.symm
    rw [hk']
    exact Subgroup.zpow_mem (K := B) hxB k
  exact ⟨hkerCard, hrange.1, hrange.2, hkerB⟩

section FiniteAmbient

variable [Finite G]

private theorem exists_model_of_symplectic
    {B Bs : Subgroup G} {x : G} {L : Subgroup G} {n : ℕ} (hn : 5 ≤ n)
    (eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod 3))) {i0 : Fin n}
    (hb : (ggAutomizer L Bs).map (MulAut.congr eta).toMonoidHom = bCoordinateBlock n 3 i0)
    (hBle : B ≤ Bs) (hxB : x ∈ B) (hx1 : x ≠ 1)
    (hxL : x ∈ Subgroup.centralizer (L : Set G))
    (hBsElem : CFSG.Open.IsElemAbelian 3 Bs)
    {K : Type} [Field K] [Finite K] (F : Fintype K) (hK : Nat.card K = 2 ^ 1)
    (hL : commutator L = ⊤)
    (θ : L ⧸ Subgroup.center L ≃* LargeEvenProj (LargeEvenSpGroup K (n - 1)))
    (hBsN : Bs ≤ Subgroup.normalizer (L : Set G)) :
    ∃ (φ : CFSG.Open.StatedSp (n - 1) (ZMod 2) →* G)
      (ρ : ↥Bs →* CFSG.Open.StatedSp (n - 1) (ZMod 2)),
      Function.Injective φ ∧ φ.range = L ∧
      (∀ (b : ↥Bs) (g : CFSG.Open.StatedSp (n - 1) (ZMod 2)),
        φ (ρ b * g * (ρ b)⁻¹) = (b : G) * φ g * (b : G)⁻¹) ∧
      ρ.range = (TwoThree.spPlaneTorus (K := ZMod 2) (r := n - 1)).range ∧
      ∀ b : ↥Bs, ρ b = 1 → (b : G) ∈ B := by
  obtain ⟨e⟩ := nonempty_mulEquiv_statedSp (L := L) (m := n - 1) (K := K) F (by omega) hK hL θ
  let ρ := modelRho (m := n - 1) (by omega) hBsN e
  have hact : ∀ (b : ↥Bs) (g : CFSG.Open.StatedSp (n - 1) (ZMod 2)),
      L.subtype (e (ρ b * g * (ρ b)⁻¹)) = (b : G) * L.subtype (e g) * (b : G)⁻¹ :=
    modelRho_action (by omega) hBsN e
  have hker : ∀ b, ρ b = 1 → (b : G) ∈ Subgroup.centralizer (L : Set G) :=
    modelRho_ker (by omega) hBsN e
  obtain ⟨-, hrangeCard, hA, hkerB⟩ :=
    rho_ker_range hn eta hb hBle hxB hx1 hxL hBsElem e ρ hact hker
  exact exists_conj_model e ρ hact hkerB hrangeCard hA

theorem exists_spPlaneTorus_model
    {B Bs : Subgroup G} {x : G} {L D J : Subgroup G}
    (hC : GGConfig 3 B Bs x L D J) {n : ℕ} (hn : 5 ≤ n)
    (eta : ↥Bs ≃* (Fin n → Multiplicative (ZMod 3))) {i0 : Fin n}
    (hb : (ggAutomizer L Bs).map (MulAut.congr eta).toMonoidHom = bCoordinateBlock n 3 i0)
    (hM : GGInnerDiagOnLabel (fun _ lab => (lab.tag = .B ∨ lab.tag = .C) ∧ lab.rank = n - 1 ∧
      lab.n = 1) 3 Bs L) :
    ∃ (φ : CFSG.Open.StatedSp (n - 1) (ZMod 2) →* G)
      (ρ : ↥Bs →* CFSG.Open.StatedSp (n - 1) (ZMod 2)),
      Function.Injective φ ∧ φ.range = L ∧
      (∀ (b : ↥Bs) (g : CFSG.Open.StatedSp (n - 1) (ZMod 2)),
        φ (ρ b * g * (ρ b)⁻¹) = (b : G) * φ g * (b : G)⁻¹) ∧
      ρ.range = (spPlaneTorus (K := ZMod 2) (r := n - 1)).range ∧
      ∀ b : ↥Bs, ρ b = 1 → (b : G) ∈ B := by
  obtain ⟨hL, lab, -, hraw⟩ := hM
  obtain ⟨-, -, -, -, -, -, -, hS, -⟩ := largeEvenRawDatum_exists (lab := lab) hraw
  obtain ⟨ht, hr, hn1⟩ := hS
  obtain ⟨t, r, m⟩ := lab
  dsimp only at ht hr hn1
  subst hr hn1
  have hBle : B ≤ Bs := hC.2.1.1
  have hBsElem : CFSG.Open.IsElemAbelian 3 Bs := hC.2.1.2.1
  obtain ⟨-, hxB, hx1, hcomp, -⟩ := hC.1.2.2.2.2.2.2.1
  have hxL : x ∈ Subgroup.centralizer (L : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro l hl
    exact ((Subgroup.mem_centralizer_iff.mp (hcomp.1 hl)) x (Set.mem_singleton x)).symm
  rcases ht with rfl | rfl
  · obtain ⟨K, _, _, hK, -, -, θ, -, hBsN, -⟩ := hraw
    exact exists_model_of_symplectic hn eta hb hBle hxB hx1 hxL hBsElem
      (Fintype.ofFinite K) hK hL θ hBsN
  · obtain ⟨K, _, _, hK, -, -, θ, -, hBsN, -⟩ := hraw
    exact exists_model_of_symplectic hn eta hb hBle hxB hx1 hxL hBsElem
      (Fintype.ofFinite K) hK hL θ hBsN

end FiniteAmbient

