private abbrev lemKP3 (A : List Nat) : Bool :=
  lemKGens.all fun g => lemKSylLit.contains (mmulL 3 6 A g)

private theorem lemK_p3_0 : ((lemKSylLit.drop (27 * 0)).take 27).all lemKP3 = true := by
  decide +kernel

private theorem lemK_p3_1 : ((lemKSylLit.drop (27 * 1)).take 27).all lemKP3 = true := by
  decide +kernel

private theorem lemK_p3_2 : ((lemKSylLit.drop (27 * 2)).take 27).all lemKP3 = true := by
