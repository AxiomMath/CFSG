@[expose] def lemKCheck (_ : Unit := ()) : Bool :=
  let S := e6SylL ()
  S.length == 81 && decide S.Nodup &&
  S.all (fun A => lemKGens.all fun g => S.contains (mmulL 3 6 A g)) &&
  S.all (fun A => A == midL 3 6 || decide (nfix6 A < 81) ||
      lemKTab.any fun s => A == mmulL 3 6 s.2.2.1 s.2.2.2 || A == mmulL 3 6 s.2.2.2 s.2.2.1) &&
  lemKTab.all fun s => [mmulL 3 6 s.2.2.1 s.2.2.2, mmulL 3 6 s.2.2.2 s.2.2.1].all fun A =>
      (lemKFix A).all fun v => lemKDot s.1 v % 3 == 0 && lemKDot s.2.1 v % 3 == 0

private theorem lemK_all_of_chunks {α : Type} (f : α → Bool) (n : Nat) :
    ∀ (K : Nat) (l : List α), l.length ≤ n * K →
      (∀ k < K, ((l.drop (n * k)).take n).all f = true) → l.all f = true
  | 0, l, hl, _ => by
      have : l = [] := List.eq_nil_of_length_eq_zero (by omega)
      subst this
      rfl
  | K + 1, l, hl, h => by
      rw [← List.take_append_drop n l, List.all_append, Bool.and_eq_true]
      refine ⟨by simpa using h 0 (Nat.succ_pos K), ?_⟩
      refine lemK_all_of_chunks f n K (l.drop n) (by
        rw [List.length_drop]
        rw [Nat.mul_add_one] at hl
        omega) ?_
      intro k hk
      have h' := h (k + 1) (by omega)
      rwa [show n * (k + 1) = n + n * k by rw [Nat.mul_add_one, Nat.add_comm],
        ← List.drop_drop] at h'

private abbrev lemKP4 (A : List Nat) : Bool :=
  A == midL 3 6 || decide (nfix6 A < 81) ||
      lemKTab.any fun s =>
        A == mmulL 3 6 s.2.2.1 s.2.2.2 || A == mmulL 3 6 s.2.2.2 s.2.2.1

