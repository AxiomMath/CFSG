private theorem ltrd3j6_component_shape
    {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ} (h0 : UnitaryFieldData 2 n K)
    {d : ℕ} (hd : 2 ≤ d) {S : GL (Fin d) K}
    (hS : S ∈ primeFormUnitary h0 (idGram K d))
    (hSnorm : S ∈ Subgroup.normalizer
      ((unitarySU 2 n K d : Subgroup (GL (Fin d) K)) : Set (GL (Fin d) K)))
    (J : Subgroup (LargeEvenProj (unitarySU 2 n K d)))
    (a : primaryFactors
      ((toLinU h0 d ⟨S, hS⟩ : LinearMap.GeneralLinearGroup K (Fin d → K)) :
        Module.End K (Fin d → K)))
    (hSDB : SelfDualPrimaryBlock h0 (idForm h0 d) (toLinU h0 d ⟨S, hS⟩) a)
    (hself : dualPoly h0.bar (a : K[X]) = a)
    (hnat : (a : K[X]).natDegree = 3)
    (huniq : ∀ b : primaryFactors
      ((toLinU h0 d ⟨S, hS⟩ : LinearMap.GeneralLinearGroup K (Fin d → K)) :
        Module.End K (Fin d → K)), b = a)
    (hJ : CFSG.Assembly.IsComponentOf J
      (ggFixSub (TableB.projConj (unitarySU 2 n K d) ⟨S, hSnorm⟩))) :
    2 ≤ primaryMultiplicity
        ((toLinU h0 d ⟨S, hS⟩ : LinearMap.GeneralLinearGroup K (Fin d → K)) :
          Module.End K (Fin d → K)) a ∧
      Nonempty (↥J ⧸ Subgroup.center ↥J ≃*
        ↥(unitarySU 2 (3 * n) (AdjoinRoot (a : K[X]))
            (primaryMultiplicity ((toLinU h0 d ⟨S, hS⟩ :
              LinearMap.GeneralLinearGroup K (Fin d → K)) : Module.End K (Fin d → K)) a)) ⧸
          Subgroup.center ↥(unitarySU 2 (3 * n) (AdjoinRoot (a : K[X]))
            (primaryMultiplicity ((toLinU h0 d ⟨S, hS⟩ :
              LinearMap.GeneralLinearGroup K (Fin d → K)) : Module.End K (Fin d → K)) a))) := by
  obtain ⟨M, hm2, hMmap, hMcomp, hMeq⟩ :=
    ltrd3j6_component_lift h0 hd hS hSnorm J a hSDB hself hnat huniq hJ
  obtain ⟨eSB⟩ := ltrd3j6_specialBlock_equiv_unitarySU (hK := h0) (B := idForm h0 d)
    (x := toLinU h0 d ⟨S, hS⟩) (a := a) hself hSDB (g := 3 * n) (by rw [hnat, Nat.mul_comm n 3])
  let eMU := (Subgroup.equivMapOfInjective M _ (ltrd3j6_F_injective h0 d)).trans
    ((MulEquiv.subgroupCongr hMeq).trans eSB)
  exact ⟨hm2, ltrd3j6_component_tail (LargeEvenProjMk (unitarySU 2 n K d))
    (CFSG.LocalAnalysis.GLTheoremA.Y10GInnUni.ker_projMk_uni_le_center (unitarySU 2 n K d))
    hMmap hMcomp.2.2.1 eMU⟩

theorem unitaryComponent_of_block (h : UnitaryPrimaryBlockContract) :
    UnitaryComponentContract := by
  intro K instField instFinite instCharP n h0 d hd S κ hκ hS hS3 hSnorm J
  unfold UnitaryComponentShapeAt
  intro hJ
  obtain ⟨a, hapoly, _hatop, hdm, hSDB, huniq⟩ :=
    h K n h0 d hd ⟨S, hS⟩ κ hκ hS3
  haveI := h0.finite
  have hscalar : Matrix.GeneralLinearGroup.scalar (Fin d) κ ∈ primeFormUnitary h0 (idGram K d) := by
    rw [← hS3]
    exact pow_mem hS 3
  have hκnorm : h0.norm (κ : K) = 1 :=
    norm_eq_one_of_scalar_mem_primeFormUnitary h0 (n := d) (by omega) (1 : GL (Fin d) K)
      (by simpa [idGram] using hscalar)
  have hκpow : κ ^ (2 ^ n + 1) = 1 := (pow_succ_eq_one_iff_norm h0 κ).2 hκnorm
  have hσκ : h0.bar (κ : K) = (κ : K)⁻¹ := by
    have h := hκnorm
    rw [UnitaryFieldData.norm] at h
    exact eq_inv_of_mul_eq_one_right h
  have hself : dualPoly h0.bar (a : K[X]) = a := by
    rw [hapoly]
    exact ltrd3j6_dualPoly_cubic h0.bar κ.ne_zero hσκ
  haveI : Fact (Irreducible (a : K[X])) := ⟨irreducible_of_mem_primaryFactors a.2⟩
  have hnat : (a : K[X]).natDegree = 3 := by
    rw [hapoly]
    exact natDegree_X_pow_sub_C
  have hE' : UnitaryFieldData 2 (3 * n) (AdjoinRoot (a : K[X])) := by
    have hE := hSDB.unitaryForm.choose
    rw [Nat.mul_comm 3 n, ← hnat]
    exact hE
  have hcubic : IsCubicExtension K (AdjoinRoot (a : K[X])) := by
    refine ⟨?_, ?_, ?_⟩
    · exact (AdjoinRoot.powerBasis (Fact.out : Irreducible (a : K[X])).ne_zero).finite
    · rw [finrank_adjoinRoot, hnat]
    · exact card_cubic_of_unitary h0 hE'
  refine ⟨ltrd3j6_three_dvd_of_noncube hκ hκpow, ?_⟩
  obtain ⟨hm2, hiso⟩ := ltrd3j6_component_shape h0 hd hS hSnorm J a hSDB hself hnat huniq hJ
  exact ⟨primaryMultiplicity
      ((toLinU h0 d ⟨S, hS⟩ : LinearMap.GeneralLinearGroup K (Fin d → K)) :
        Module.End K (Fin d → K)) a,
    AdjoinRoot (a : K[X]), inferInstance, inferInstance, hE'.finite, hE', hm2, hdm, hcubic, hiso⟩

end

