private theorem ltrd3j6_three_dvd_of_noncube {K : Type} [Field K] {n : ℕ} {κ : Kˣ}
    (hκ : ∀ c : Kˣ, c ^ 3 ≠ κ) (hpow : κ ^ (2 ^ n + 1) = 1) :
    3 ∣ 2 ^ n + 1 := by
  by_contra h3
  set r : ℕ := orderOf κ with hrdef
  have hdvd : r ∣ 2 ^ n + 1 := by
    rw [hrdef]
    exact orderOf_dvd_of_pow_eq_one hpow
  have h3r : ¬ 3 ∣ r := fun h => h3 (h.trans hdvd)
  have hgcd : Nat.gcd 3 r = 1 := by
    have hd : Nat.gcd 3 r ∣ 3 := Nat.gcd_dvd_left 3 r
    rcases (Nat.dvd_prime Nat.prime_three).1 hd with h | h
    · exact h
    · exact absurd (h ▸ Nat.gcd_dvd_right 3 r) h3r
  have hbez := Nat.gcd_eq_gcd_ab 3 r
  rw [hgcd] at hbez
  have key : (Nat.gcdA 3 r : ℤ) * ((3 : ℕ) : ℤ) + (r : ℤ) * Nat.gcdB 3 r = 1 := by
    rw [mul_comm (Nat.gcdA 3 r) ((3 : ℕ) : ℤ)]
    exact hbez.symm
  refine hκ (κ ^ (Nat.gcdA 3 r)) ?_
  have hr1 : κ ^ (r : ℤ) = 1 := by
    rw [hrdef, zpow_natCast, pow_orderOf_eq_one]
  have hA : Nat.gcdA 3 r * ((3 : ℕ) : ℤ) = 1 - (r : ℤ) * Nat.gcdB 3 r := by
    linarith [key]
  rw [← zpow_natCast, ← zpow_mul, hA, zpow_sub, zpow_mul, hr1, one_zpow, inv_one, mul_one,
    zpow_one]

private theorem ltrd3j6_dualPoly_cubic {K : Type} [Field K] (σ : K →+* K) {c : K}
    (hc : c ≠ 0) (hσ : σ c = c⁻¹) :
    dualPoly σ (X ^ 3 - C c) = X ^ 3 - C c := by
  have hrev : (X ^ 3 - C (σ c)).reverse = 1 - C (σ c) * X ^ 3 := by
    ext n
    rw [Polynomial.coeff_reverse, Polynomial.natDegree_X_pow_sub_C]
    rcases (show n = 0 ∨ n = 1 ∨ n = 2 ∨ n = 3 ∨ 4 ≤ n by omega) with
      rfl | rfl | rfl | rfl | h4
    · simp [Polynomial.revAt_le, Polynomial.coeff_X_pow, Polynomial.coeff_sub,
        Polynomial.coeff_one, Polynomial.coeff_C]
    · simp [Polynomial.revAt_le, Polynomial.coeff_X_pow, Polynomial.coeff_sub,
        Polynomial.coeff_one, Polynomial.coeff_C]
    · simp [Polynomial.revAt_le, Polynomial.coeff_X_pow, Polynomial.coeff_sub,
        Polynomial.coeff_one, Polynomial.coeff_C]
    · simp [Polynomial.revAt_le, Polynomial.coeff_X_pow, Polynomial.coeff_sub,
        Polynomial.coeff_one, Polynomial.coeff_C]
    · rw [Polynomial.revAt_eq_self_of_lt (by omega)]
      simp [Polynomial.coeff_X_pow, Polynomial.coeff_sub, Polynomial.coeff_one,
        Polynomial.coeff_C, show n ≠ 0 by omega, show n ≠ 1 by omega,
        show n ≠ 2 by omega, show n ≠ 3 by omega]
  rw [dualPoly]
  have hmap : (X ^ 3 - C c).map σ = X ^ 3 - C (σ c) := by simp
  rw [hmap]
  rw [hrev]
  have hcoeff : (X ^ 3 - C c).coeff 0 = -c := by
    simp [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C]
  rw [hcoeff, map_neg, hσ]
  have h1 : (C ((-(c⁻¹))⁻¹) : K[X]) = -C c := by
    rw [inv_neg, inv_inv, map_neg]
  rw [h1]
  have hcc : (C c : K[X]) * C (c⁻¹) = 1 := by rw [← map_mul, mul_inv_cancel₀ hc, map_one]
  rw [show (-C c) * (1 - C (c⁻¹) * X ^ 3) = -C c + (C c * C (c⁻¹)) * X ^ 3 by ring]
  rw [hcc, one_mul]
  ring

private theorem ltrd3j6_le {K : Type} [Field K] {n : ℕ} (h0 : UnitaryFieldData 2 n K) (d : ℕ) :
    unitarySU 2 n K d ≤ primeFormUnitary h0 (idGram K d) := fun g hg => by
  have hg' : g ∈ gramSU h0 1 := by
    rw [← unitarySU_eq_gramSU]
    exact hg
  simpa [idGram] using ((mem_gramSU_iff_unitary h0).mp hg').1

private noncomputable def ltrd3j6_F {K : Type} [Field K] {n : ℕ} (h0 : UnitaryFieldData 2 n K)
    (d : ℕ) : ↥(unitarySU 2 n K d) →* LinearMap.GeneralLinearGroup K (Fin d → K) :=
  (toLinU h0 d).comp (Subgroup.inclusion (ltrd3j6_le h0 d))

private theorem ltrd3j6_F_fix_le_unitaryCentralizer {K : Type} [Field K] {n : ℕ}
    (h0 : UnitaryFieldData 2 n K) {d : ℕ} {S : GL (Fin d) K}
    (hS : S ∈ primeFormUnitary h0 (idGram K d))
    (hSnorm : S ∈ Subgroup.normalizer
      ((unitarySU 2 n K d : Subgroup (GL (Fin d) K)) : Set (GL (Fin d) K))) :
    (fixSubgroup ((unitarySU 2 n K d).normalizerMonoidHom ⟨S, hSnorm⟩)).map
        (ltrd3j6_F h0 d) ≤
      unitaryCentralizer (idForm h0 d) (toLinU h0 d ⟨S, hS⟩) := by
  rintro y ⟨g, hg, rfl⟩
  have hcoe : (S : GL (Fin d) K) * (g : GL (Fin d) K) * (S : GL (Fin d) K)⁻¹ =
      (g : GL (Fin d) K) := by
    have h1 : ((unitarySU 2 n K d).normalizerMonoidHom ⟨S, hSnorm⟩) g = g :=
      mem_fixSubgroup.mp hg
    have h2 := Subgroup.normalizerMonoidHom_apply_apply_coe (unitarySU 2 n K d)
      ⟨S, hSnorm⟩ g
    rw [h1] at h2
    exact h2.symm
  have hcomm : (g : GL (Fin d) K) * S = S * (g : GL (Fin d) K) := by
    calc (g : GL (Fin d) K) * S =
        ((S * (g : GL (Fin d) K) * S⁻¹) * S) := by rw [hcoe]
      _ = S * (g : GL (Fin d) K) := by group
  refine Subgroup.mem_inf.mpr ⟨toLinU_mem (h := h0) (n := d) _,
    Subgroup.mem_centralizer_singleton_iff.mpr ?_⟩
  have hPU : (Subgroup.inclusion (ltrd3j6_le h0 d) g : ↥(primeFormUnitary h0 (idGram K d))) *
        ⟨S, hS⟩ =
      ⟨S, hS⟩ * (Subgroup.inclusion (ltrd3j6_le h0 d) g :
        ↥(primeFormUnitary h0 (idGram K d))) := by
    apply Subtype.ext
    simpa using hcomm
  change (toLinU h0 d _) * (toLinU h0 d ⟨S, hS⟩) =
    (toLinU h0 d ⟨S, hS⟩) * (toLinU h0 d _)
  rw [← map_mul, ← map_mul, hPU]

private theorem ltrd3j6_mem_fix_iff {K : Type} [Field K] {n : ℕ} (h0 : UnitaryFieldData 2 n K)
    {d : ℕ} {S : GL (Fin d) K}
    (hSnorm : S ∈ Subgroup.normalizer
      ((unitarySU 2 n K d : Subgroup (GL (Fin d) K)) : Set (GL (Fin d) K)))
    (g : ↥(unitarySU 2 n K d)) :
    g ∈ fixSubgroup ((unitarySU 2 n K d).normalizerMonoidHom ⟨S, hSnorm⟩) ↔
      (g : GL (Fin d) K) * S = S * (g : GL (Fin d) K) := by
  constructor
  · intro hg
    have h1 : ((unitarySU 2 n K d).normalizerMonoidHom ⟨S, hSnorm⟩) g = g :=
      mem_fixSubgroup.mp hg
    have h2 := Subgroup.normalizerMonoidHom_apply_apply_coe (unitarySU 2 n K d) ⟨S, hSnorm⟩ g
    rw [h1] at h2
    have h2' : (g : GL (Fin d) K) = S * (g : GL (Fin d) K) * S⁻¹ := h2
    calc (g : GL (Fin d) K) * S = (S * (g : GL (Fin d) K) * S⁻¹) * S := by
          conv_lhs => rw [h2']
      _ = S * (g : GL (Fin d) K) := by group
  · intro hcomm
    rw [mem_fixSubgroup]
    apply Subtype.ext
    rw [Subgroup.normalizerMonoidHom_apply_apply_coe]
    rw [← hcomm]
    group

private theorem ltrd3j6_specialBlock_le_map_fix {K : Type} [Field K] {n : ℕ}
    (h0 : UnitaryFieldData 2 n K) {d : ℕ} {S : GL (Fin d) K}
    (hS : S ∈ primeFormUnitary h0 (idGram K d))
    (hSnorm : S ∈ Subgroup.normalizer
      ((unitarySU 2 n K d : Subgroup (GL (Fin d) K)) : Set (GL (Fin d) K)))
    (a : primaryFactors
      ((toLinU h0 d ⟨S, hS⟩ : LinearMap.GeneralLinearGroup K (Fin d → K)) :
        Module.End K (Fin d → K)))
    (hdetK : ∀ g ∈ specialBlock (idForm h0 d) (toLinU h0 d ⟨S, hS⟩) (a : K[X]),
      LinearMap.det (g : Module.End K (Fin d → K)) = 1) :
    specialBlock (idForm h0 d) (toLinU h0 d ⟨S, hS⟩) (a : K[X]) ≤
      (fixSubgroup ((unitarySU 2 n K d).normalizerMonoidHom ⟨S, hSnorm⟩)).map
        (ltrd3j6_F h0 d) := by
  intro g hg
  have hgU : g ∈ unitaryCentralizer (idForm h0 d) (toLinU h0 d ⟨S, hS⟩) :=
    specialBlock_le_unitaryCentralizer hg
  have hgS : g ∈ sesqSpecialUnitaryGroup (idForm h0 d) := by
    rw [mem_sesqSpecialUnitaryGroup]
    exact ⟨hgU.1, hdetK g hg⟩
  let h : GL (Fin d) K := Matrix.GeneralLinearGroup.toLin.symm g
  have htoLin : Matrix.GeneralLinearGroup.toLin h = g := MulEquiv.apply_symm_apply _ _
  have hgram : h ∈ gramSU h0 (idGram K d) := by
    rw [← toLin_mem_sesqSpecialUnitaryGroup_iff h0 (idGram K d) h, htoLin]
    exact hgS
  have hSU : h ∈ unitarySU 2 n K d := by
    rw [unitarySU_eq_gramSU]
    simpa [idGram] using hgram
  have hc : Commute g (toLinU h0 d ⟨S, hS⟩) :=
    Subgroup.mem_centralizer_singleton_iff.mp hgU.2
  have hcomm_gl : h * S = S * h := by
    apply Matrix.GeneralLinearGroup.toLin.injective
    rw [map_mul, map_mul, htoLin]
    change g * (toLinU h0 d ⟨S, hS⟩) = (toLinU h0 d ⟨S, hS⟩) * g
    exact hc.eq
  refine ⟨⟨h, hSU⟩, ?_, ?_⟩
  · exact (ltrd3j6_mem_fix_iff h0 hSnorm ⟨h, hSU⟩).mpr hcomm_gl
  · show ltrd3j6_F h0 d ⟨h, hSU⟩ = g
    change Matrix.GeneralLinearGroup.toLin h = g
    exact htoLin

private theorem ltrd3j6_quot_of_mulEquiv {A B : Type*} [Group A] [Group B] (e : A ≃* B) :
    Nonempty (A ⧸ Subgroup.center A ≃* B ⧸ Subgroup.center B) :=
  ⟨QuotientGroup.congr (Subgroup.center A) (Subgroup.center B) e (Subgroup.map_center_eq e)⟩

private theorem ltrd3j6_specialBlock_equiv_unitarySU {ℓ f : ℕ} {K : Type} [Field K] [Finite K]
    {hK : UnitaryFieldData ℓ f K} {V : Type} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] {B : V →ₛₗ[hK.bar] V →ₗ[K] K}
    {x : LinearMap.GeneralLinearGroup K V} {a : primaryFactors (x : Module.End K V)}
    (hself : dualPoly hK.bar (a : K[X]) = a) (hS : SelfDualPrimaryBlock hK B x a)
    {g : ℕ} (hg : f * (a : K[X]).natDegree = g) :
    Nonempty (↥(specialBlock B x (a : K[X])) ≃*
      ↥(unitarySU ℓ g (AdjoinRoot (a : K[X]))
        (primaryMultiplicity (x : Module.End K V) (a : K[X])))) := by
  subst hg
  obtain ⟨hE, Hf, hHf, hHfl, ⟨e1⟩⟩ :=
    CFSG.HardMathSupport.Dickson.Sec6.Up34Chev2.nonempty_specialBlock_mulEquiv_sesqSU_c2
      hself hS
  obtain ⟨b, hb⟩ := hE.exists_orthonormal_basis hHf hHfl
  obtain ⟨e2⟩ := CFSG.RankThree.CentralLift.nonempty_sesqSpecialUnitaryGroup_mulEquiv_gramSU
    hE b (G := 1) (fun i j => by rw [hb i j, Matrix.one_apply])
  exact ⟨e1.trans (e2.trans
    (MulEquiv.subgroupCongr (unitarySU_eq_gramSU hE _).symm))⟩

private theorem ltrd3j6_F_injective {K : Type} [Field K] {n : ℕ} (h0 : UnitaryFieldData 2 n K)
    (d : ℕ) : Function.Injective (ltrd3j6_F h0 d) := by
  intro a b hab
  have hab' : toLinU h0 d (Subgroup.inclusion (ltrd3j6_le h0 d) a) =
      toLinU h0 d (Subgroup.inclusion (ltrd3j6_le h0 d) b) := hab
  have h2 := toLinU_injective hab'
  exact Subtype.ext (congrArg (fun t : ↥(primeFormUnitary h0 (idGram K d)) =>
    (t : GL (Fin d) K)) h2)

private theorem ltrd3j6_component_tail {L Q U : Type*} [Group L] [Group Q] [Group U]
    (π : L →* Q) (hker : π.ker ≤ Subgroup.center L)
    {M : Subgroup L} {J : Subgroup Q}
    (hMmap : M.map π = J) (hperf : commutator ↥M = ⊤) (eMU : ↥M ≃* U) :
    Nonempty (↥J ⧸ Subgroup.center ↥J ≃* U ⧸ Subgroup.center U) := by
  have hmemJ : ∀ x : ↥M, π (x : L) ∈ J := fun x => by
    rw [← hMmap]
    exact Subgroup.mem_map_of_mem _ x.2
  let fJ : ↥M →* ↥J := MonoidHom.codRestrict (π.comp M.subtype) J hmemJ
  have hfJ : Function.Surjective fJ := by
    rintro ⟨y, hy⟩
    rw [← hMmap] at hy
    obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.mp hy
    exact ⟨⟨z, hz⟩, rfl⟩
  have hkerJ : fJ.ker ≤ Subgroup.center ↥M := by
    intro x hx
    rw [MonoidHom.mem_ker] at hx
    have hx1 : π (x : L) = 1 := congrArg Subtype.val hx
    have hxc := hker (MonoidHom.mem_ker.mpr hx1)
    rw [Subgroup.mem_center_iff]
    intro y
    apply Subtype.ext
    exact Subgroup.mem_center_iff.mp hxc (y : L)
  obtain ⟨eJM⟩ := CFSG.LocalAnalysis.GLTheoremA.Y10GInnLin.center_quot_equiv_of_surjective
    hperf fJ hfJ hkerJ
  obtain ⟨eZZ⟩ := ltrd3j6_quot_of_mulEquiv eMU
  exact ⟨eJM.trans eZZ⟩

private theorem ltrd3j6_component_lift
    {K : Type} [Field K] [Finite K] [CharP K 2] {n : ℕ} (h0 : UnitaryFieldData 2 n K)
    {d : ℕ} (hd : 2 ≤ d) {S : GL (Fin d) K}
    (hS : S ∈ primeFormUnitary h0 (idGram K d))
    (hSnorm : S ∈ Subgroup.normalizer
      ((unitarySU 2 n K d : Subgroup (GL (Fin d) K)) : Set (GL (Fin d) K)))
    (J : Subgroup (LargeEvenProj (unitarySU 2 n K d)))
    (a : primaryFactors
      ((toLinU h0 d ⟨S, hS⟩ : LinearMap.GeneralLinearGroup K (Fin d → K)) :
        Module.End K (Fin d → K)))
    (hSDB : SelfDualPrimaryBlock h0 (idForm h0 d) (toLinU h0 d ⟨S, hS⟩) a)
    (hself : dualPoly h0.bar (a : K[X]) = a)
    (hnat : (a : K[X]).natDegree = 3)
    (huniq : ∀ b : primaryFactors
      ((toLinU h0 d ⟨S, hS⟩ : LinearMap.GeneralLinearGroup K (Fin d → K)) :
        Module.End K (Fin d → K)), b = a)
    (hJ : CFSG.Assembly.IsComponentOf J
      (ggFixSub (TableB.projConj (unitarySU 2 n K d) ⟨S, hSnorm⟩))) :
    ∃ (M : Subgroup ↥(unitarySU 2 n K d)),
      2 ≤ primaryMultiplicity
        ((toLinU h0 d ⟨S, hS⟩ : LinearMap.GeneralLinearGroup K (Fin d → K)) :
          Module.End K (Fin d → K)) a ∧
      M.map (LargeEvenProjMk (unitarySU 2 n K d)) = J ∧
      CFSG.Assembly.IsComponentOf M
        (fixSubgroup ((unitarySU 2 n K d).normalizerMonoidHom ⟨S, hSnorm⟩)) ∧
      M.map (ltrd3j6_F h0 d) =
        specialBlock (idForm h0 d) (toLinU h0 d ⟨S, hS⟩) (a : K[X]) := by
  haveI := h0.finite
  have hn1 : 1 ≤ n := h0.one_le
  have hq : 2 ≤ 2 ^ n := by
