private theorem lieModel_trialityD4_of_twistedBridge
    (hB : CFSG.TauCetiBridge.Even.TwistedBridgeAll .D4 TauCeti.LieTypeIndex.trialityD4)
    {X : Type} [Group X] (q : TauCeti.PrimePower)
    (e : X ≃* (TauCeti.CFSGIndex.lie
      ⟨.trialityD4 q, TauCeti.LieTypeIndex.valid_trialityD4 q⟩).Group) :
    LieModel X .trialityD4 0 q.p q.exponent := by
  haveI : Fact q.p.Prime := ⟨q.prime_p⟩
  have hK : Nat.card (GaloisField q.p (q.exponent * TwistTag.D4.order)) =
      (q.p ^ q.exponent) ^ TwistTag.D4.order := by
    rw [GaloisField.card _ _ (Nat.mul_pos q.exponent_pos TwistTag.D4.order_pos).ne', pow_mul]
  let σ : GaloisField q.p (q.exponent * TwistTag.D4.order) →+*
      GaloisField q.p (q.exponent * TwistTag.D4.order) := iterateFrobenius _ q.p q.exponent
  have hσ : ∀ x, σ x = x ^ (q.p ^ q.exponent) := fun x => iterateFrobenius_def _ _ x
  obtain ⟨b⟩ := hB q (TauCeti.LieTypeIndex.valid_trialityD4 q) _
    (by rw [TauCeti.PrimePower.card_def]; exact hK) σ
    (by intro x; rw [TauCeti.PrimePower.card_def]; exact hσ x)
  exact Or.inr (Or.inl ⟨rfl, by decide, ⟨q.prime_p, q.exponent_pos, rfl⟩, _, inferInstance,
    inferInstance, hK, σ, hσ, ⟨e.trans b.symm⟩⟩)


private theorem statedClassicalModel_rationalComponent_d4_inner
    {L : Type} [Field L] [IsAlgClosed L] {p₀ : ℕ} (S : LangSetup .E6 L p₀)
    {l f : ℕ} (hl : l.Prime) (hf : 0 < f) (hq : S.D.q = l ^ f) (h3 : ((3 : ℕ) : L) ≠ 0)
    {a : Fin Tag.E6.rank → Lˣ} (hT : rootDiagUnit .E6 a ∈ S.D.torus) (hap : ∀ i, a i ^ 3 = 1)
    (i : KernelComponent (rootCharHom a))
    (hc : (componentRoots (rootCharHom a) i).ncard = 24)
    (hρ : ∀ γ ∈ componentRoots (rootCharHom a) i, S.ρ γ ∈ componentRoots (rootCharHom a) i)
    (hin : twistInner (componentRoots (rootCharHom a) i)
      (S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ))) :
    StatedClassicalModel
      (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) .POmegaPlus 4 l f := by
  classical
  obtain ⟨_, w, m0, m1, m2, m3, m4, m5, -, hsum, -, hcl⟩ := TwE6UniqAbs.kac_class_data h3 hap
  obtain ⟨x, hx, hroots, hncard, -, -⟩ := hcl i
  have hD4 := d4t2in_cmpF_eq_sD4 hsum hx (hncard.symm.trans hc)
  have hfam : componentRoots (rootCharHom a) i =
      rootsOfFam (fun y => w⁻¹ • kacE6.extRoot y) (Set.range TwE6InnerAbs.lD4) := by
    rw [hroots, hD4, ← TwE6InnerAbs.range_lD4]
    exact TwE6InnerAbs.image_rootsOf_eq_rootsOfFam kacE6 w⁻¹ _
  have hfin : (componentRoots (rootCharHom a) i).Finite :=
    (finite_kernelRoots_E6 _).subset (componentRoots_subset_kernelRoots _ i)
  have hs1 : componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 1 :=
    componentOrbitLength_eq_one hfin hρ
  have hinner : twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin Tag.E6.rank → ℤ) → _)^[componentOrbitLength S.ρ
        (componentRoots (rootCharHom a) i)]) := by
    rw [hs1, Function.iterate_one]
    exact hin
  obtain ⟨hmodel, -⟩ := d4t2in_dModel_center S (Or.inr (Or.inl rfl)) hT i hinner
    (n := 4) le_rfl (fun y => w⁻¹ • kacE6.extRoot y)
    (fun y => IsRoot.smul (kacE6.isRoot_extRoot y) w⁻¹) TwE6InnerAbs.lD4 hfam
    (fun c d hcd h1 h2 => by
      show iform (w⁻¹ • kacE6.extRoot (TwE6InnerAbs.lD4 c))
        (w⁻¹ • kacE6.extRoot (TwE6InnerAbs.lD4 d)) = 0
      rw [iform_smul, kacE6_extRoot]
      exact TwE6InnerAbs.d4_hgram c d hcd h1 h2)
    (fun {F} _ c d h => TwE6InnerAbs.d4_frames w⁻¹ c d h) hl hf hq
  rwa [hs1, Nat.mul_one] at hmodel

theorem lieModel_rationalComponent_d4t2 {K : Type} [Field K] [Finite K] {σ : K ≃+* K} {q : ℕ}
    {h : twistedE6InndiagGL K σ} (D : TwE6LineLang K σ q h) (h3q : 3 ∣ q + 1)
    (hdim : twE6MatFixDim K σ h = 30) (i : KernelComponent (rootCharHom D.a)) :
    LieModel (↥(rationalComponent D.S.ρ D.S.Γ (rootCharHom D.a) i) ⧸
        Subgroup.center ↥(rationalComponent D.S.ρ D.S.Γ (rootCharHom D.a) i))
        .POmegaPlus 4 (ringChar K) D.e ∨
      LieModel (↥(rationalComponent D.S.ρ D.S.Γ (rootCharHom D.a) i) ⧸
        Subgroup.center ↥(rationalComponent D.S.ρ D.S.Γ (rootCharHom D.a) i))
        .trialityD4 0 (ringChar K) D.e := by
  classical
  have hall : (kernelRoots (rootCharHom D.a)).ncard = 24 := by
    have := D.hker
    omega
  obtain ⟨hr, hc⟩ := d4t2_class_of_card D.hL3 D.hap hall i
  have hker : componentRoots (rootCharHom D.a) i = kernelRoots (rootCharHom D.a) :=
    Set.eq_of_subset_of_ncard_le (componentRoots_subset_kernelRoots _ i) (by rw [hc, hall])
      (finite_kernelRoots_E6 _)
  have hρ : ∀ γ ∈ componentRoots (rootCharHom D.a) i,
      D.S.ρ γ ∈ componentRoots (rootCharHom D.a) i := by
    intro γ hγ
    rw [hker] at hγ ⊢
    exact outer_rho_mem_kernelRoots D.S D.hT hγ
  by_cases hin : twistInner (componentRoots (rootCharHom D.a) i)
      (D.S.ρ : (Fin Tag.E6.rank → ℤ) → (Fin Tag.E6.rank → ℤ))
  · exact Or.inl (Or.inl ⟨by decide, statedClassicalModel_rationalComponent_d4_inner D.S D.hℓ
      D.he D.hSq D.hL3 D.hT D.hap i hc hρ hin⟩)
  haveI : Fact (ringChar K).Prime := ⟨D.hℓ⟩
  haveI := D.hchar
  have hf : 1 ≤ D.e := D.he
  have h3 : 3 ∣ ringChar K ^ D.e + 1 := D.hqe ▸ h3q
  have hTp : rootDiagUnit Tag.E6 D.a ^ 3 = 1 := by
    have h1 : rootDiagUnit Tag.E6 (D.a ^ 3) = rootDiagUnit Tag.E6 D.a ^ 3 :=
      (rootDiagUnitHom Tag.E6 (AlgebraicClosure K)).map_pow D.a 3
    have h2 : D.a ^ 3 = 1 := funext fun j => by rw [Pi.pow_apply, D.hap j, Pi.one_apply]
    rw [← h1, h2, CFSG.LieType.Chevalley.rootDiagUnit_one]
  obtain ⟨v, hv, -⟩ := D.S.d4_pinnedT_of_prime Nat.prime_three D.hL3 facts_E6 kacCount_E6_four
    (by decide) (by decide)
    (fun y hy => far_d4_E6 y fun z hz => by
      have hyz := hy z hz
      rwa [KacData.Adj, extRoot_eq_extRootOf] at hyz)
    ⟨none, by decide⟩ (lt_of_eq_of_lt kacCount_far_E6 (by decide)) D.hT hTp i hr hc
  obtain ⟨⟨e⟩, hZ⟩ := d4t2out_rationalComponent_equiv D.S D.hS hf D.hSq h3 D.hT D.hap i v hv
    hker.ge hρ hin
  exact Or.inr (lieModel_trialityD4_of_twistedBridge
    CFSG.TauCetiBridge.Even.chevalleyBridgesAll.trialityD4 _
    ((QuotientGroup.quotientMulEquivOfEq hZ).trans (QuotientGroup.quotientBot.trans e)))

