theorem exists_spConj_of_mem_torus {τ : Tag} {L : Type} [Field L]
    [IsAlgClosed L] [CharP L 2]
    {p₀ : ℕ} (S : LangSetup τ L p₀) {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus)
    (i : KernelComponent (rootCharHom a)) {n : ℕ} (σQ : L ≃+* L)
    {ψ : ↥(StatedSp n L) →* ModGL τ L} (hψinj : Function.Injective ψ)
    (hψrange : ψ.range = rootSpan τ L (componentRoots (rootCharHom a) i))
    (hψact : ∀ y ∈ torusGroup τ L ⊔ rootSpan τ L (kernelRoots (rootCharHom a)),
      ∃ W : ↥(StatedSp n L), ∀ X, y * ψ X * y⁻¹ = ψ (W * X * W⁻¹))
    {z : ModGL τ L}
    (hz : z ∈ torusGroup τ L ⊔ rootSpan τ L (kernelRoots (rootCharHom a)))
    (f : ↥(StatedSp n ↥(fixSubfield σQ)) →* ModGL τ L)
    (hfrange : f.range = rationalComponent S.ρ S.Γ (rootCharHom a) i)
    (hfact : ∀ (X : ↥(StatedSp n ↥(fixSubfield σQ))),
      ∀ g ∈ rootSpan τ L (componentRoots (rootCharHom a) i),
        f X * g * (f X)⁻¹ =
          (z * ψ (statedSpMap (fixSubfield σQ).subtype n X) * z⁻¹) * g *
            (z * ψ (statedSpMap (fixSubfield σQ).subtype n X) * z⁻¹)⁻¹)
    {b : ModGL τ L} (hb : b ∈ S.D.torus) :
    ∃ C : ↥(StatedSp n ↥(fixSubfield σQ)), ∀ X, b⁻¹ * f X * b = f (C * X * C⁻¹) := by
  classical
  let K : Subfield L := fixSubfield σQ
  let ι : ↥(StatedSp n ↥K) →* ↥(StatedSp n L) := statedSpMap K.subtype n
  let Si : Subgroup (ModGL τ L) := rootSpan τ L (componentRoots (rootCharHom a) i)
  have hιinj : Function.Injective ι := statedSpMap_injective K.subtype n
  have hSi : Si = ψ.range := by simp [Si, hψrange]
  have hbinv : b⁻¹ ∈ S.D.torus := inv_mem hb
  have hb_tg : b⁻¹ ∈ torusGroup τ L := (CFSG.RankThree.PartOne.KE.mem_twistedTorusOf.1 hbinv).1
  have hb_tg_b : b ∈ torusGroup τ L := (CFSG.RankThree.PartOne.KE.mem_twistedTorusOf.1 hb).1
  have hstep : S.D.step b⁻¹ = b⁻¹ := by
    simpa [LangDatum.step, MulAut.conj_apply] using
      (CFSG.RankThree.PartOne.KE.mem_twistedTorusOf.1 hbinv).2
  have hbSi : ∀ g ∈ Si, b * g * b⁻¹ ∈ Si := by
    have hbN : b ∈ Subgroup.normalizer (Si : Set (ModGL τ L)) := by
      have h := CFSG.LieType.Chevalley.torusGroup_le_normalizer_rootSpan (K := L)
        (S := componentRoots (rootCharHom a) i) (fun γ hγ => hγ.1.1) hb_tg_b
      simpa [Si] using h
    intro g hg
    exact ((Subgroup.mem_normalizer_iff.1 hbN) g).1 hg
  have hA_mem_f : ∀ X : ↥(StatedSp n ↥K), b⁻¹ * f X * b ∈ f.range := by
    intro X
    have h1 := CFSG.HardMathSupport.S2MathAs1.I1486.conj_mem_rationalComponent_of_mem_sup_rootSpan
      S hT i (Subgroup.mem_sup_left hb_tg) hstep (f X) (by
        rw [← hfrange]
        exact MonoidHom.mem_range.mpr ⟨X, rfl⟩)
    simpa [hfrange] using h1
  have hex : ∀ X : ↥(StatedSp n ↥K), ∃ X' : ↥(StatedSp n ↥K), f X' = b⁻¹ * f X * b :=
    fun X => MonoidHom.mem_range.mp (hA_mem_f X)
  choose X' hX' using hex
  obtain ⟨Wz, hWz⟩ := hψact z hz
  have hzS : ∀ g ∈ Si, z * g * z⁻¹ ∈ Si := by
    intro g hg
    rw [hSi] at hg ⊢
    obtain ⟨Y, rfl⟩ := MonoidHom.mem_range.mp hg
    rw [hWz Y]
    exact MonoidHom.mem_range.mpr ⟨_, rfl⟩
  let Z : Subgroup (ModGL τ L) :=
    torusGroup τ L ⊔ rootSpan τ L (kernelRoots (rootCharHom a))
  let y : ModGL τ L := z⁻¹ * b⁻¹ * z
  have hyZ : y ∈ Z :=
    Z.mul_mem (Z.mul_mem (Z.inv_mem hz) (Subgroup.mem_sup_left hb_tg)) hz
  obtain ⟨W, hW⟩ := hψact y hyZ
  have hAy : ∀ X : ↥(StatedSp n ↥K),
      b⁻¹ * (z * ψ (ι X) * z⁻¹) * b = z * (y * ψ (ι X) * y⁻¹) * z⁻¹ := by
    intro X
    simp only [y]
    group
  have hconj : ∀ (X : ↥(StatedSp n ↥K)), ∀ g ∈ Si,
      (b⁻¹ * (z * ψ (ι X) * z⁻¹) * b) * g * (b⁻¹ * (z * ψ (ι X) * z⁻¹) * b)⁻¹ =
      (z * ψ (ι (X' X)) * z⁻¹) * g * (z * ψ (ι (X' X)) * z⁻¹)⁻¹ := by
    intro X g hg
    have hbg : b * g * b⁻¹ ∈ Si := hbSi g hg
    have h1 := hfact X (b * g * b⁻¹) hbg
    have h2 := hfact (X' X) g hg
    calc (b⁻¹ * (z * ψ (ι X) * z⁻¹) * b) * g * (b⁻¹ * (z * ψ (ι X) * z⁻¹) * b)⁻¹
        = b⁻¹ * ((z * ψ (ι X) * z⁻¹) * (b * g * b⁻¹) *
            (z * ψ (ι X) * z⁻¹)⁻¹) * b := by group
      _ = b⁻¹ * (f X * (b * g * b⁻¹) * (f X)⁻¹) * b := by rw [← h1]
      _ = (b⁻¹ * f X * b) * g * (b⁻¹ * f X * b)⁻¹ := by group
      _ = f (X' X) * g * (f (X' X))⁻¹ := by rw [← hX' X]
      _ = (z * ψ (ι (X' X)) * z⁻¹) * g * (z * ψ (ι (X' X)) * z⁻¹)⁻¹ := h2
  have hconj2 : ∀ (X : ↥(StatedSp n ↥K)) (Y : ↥(StatedSp n L)),
      ψ (W * ι X * W⁻¹) * ψ Y * (ψ (W * ι X * W⁻¹))⁻¹ =
      ψ (ι (X' X)) * ψ Y * (ψ (ι (X' X)))⁻¹ := by
    intro X Y
    have hY : z * ψ Y * z⁻¹ ∈ Si :=
      hzS (ψ Y) (by rw [hSi]; exact MonoidHom.mem_range.mpr ⟨Y, rfl⟩)
    calc ψ (W * ι X * W⁻¹) * ψ Y * (ψ (W * ι X * W⁻¹))⁻¹
        = z⁻¹ * ((b⁻¹ * (z * ψ (ι X) * z⁻¹) * b) * (z * ψ Y * z⁻¹) *
            (b⁻¹ * (z * ψ (ι X) * z⁻¹) * b)⁻¹) * z := by
          rw [← hW (ι X), hAy X]; group
      _ = z⁻¹ * ((z * ψ (ι (X' X)) * z⁻¹) * (z * ψ Y * z⁻¹) *
            (z * ψ (ι (X' X)) * z⁻¹)⁻¹) * z := by rw [hconj X _ hY]
      _ = ψ (ι (X' X)) * ψ Y * (ψ (ι (X' X)))⁻¹ := by group
  have hAB : ∀ X : ↥(StatedSp n ↥K), W * ι X * W⁻¹ = ι (X' X) := by
    intro X
    have hcomm : ∀ Y : ↥(StatedSp n L),
        ((ι (X' X))⁻¹ * (W * ι X * W⁻¹)) * Y =
          Y * ((ι (X' X))⁻¹ * (W * ι X * W⁻¹)) := by
      intro Y
      apply hψinj
      have h := hconj2 X Y
      have key : (ψ (ι (X' X)))⁻¹ * ψ (W * ι X * W⁻¹) * ψ Y =
          ψ Y * ((ψ (ι (X' X)))⁻¹ * ψ (W * ι X * W⁻¹)) := by
        calc (ψ (ι (X' X)))⁻¹ * ψ (W * ι X * W⁻¹) * ψ Y
            = (ψ (ι (X' X)))⁻¹ * (ψ (W * ι X * W⁻¹) * ψ Y *
                (ψ (W * ι X * W⁻¹))⁻¹) * ψ (W * ι X * W⁻¹) := by group
          _ = (ψ (ι (X' X)))⁻¹ * (ψ (ι (X' X)) * ψ Y *
                (ψ (ι (X' X)))⁻¹) * ψ (W * ι X * W⁻¹) := by rw [h]
          _ = ψ Y * ((ψ (ι (X' X)))⁻¹ * ψ (W * ι X * W⁻¹)) := by group
      have hmap : ψ ((ι (X' X))⁻¹ * (W * ι X * W⁻¹)) =
          (ψ (ι (X' X)))⁻¹ * ψ (W * ι X * W⁻¹) := by
        rw [map_mul, map_inv]
      calc ψ (((ι (X' X))⁻¹ * (W * ι X * W⁻¹)) * Y)
          = ψ ((ι (X' X))⁻¹ * (W * ι X * W⁻¹)) * ψ Y := map_mul ψ _ Y
        _ = ((ψ (ι (X' X)))⁻¹ * ψ (W * ι X * W⁻¹)) * ψ Y :=
              congrArg (fun x => x * ψ Y) hmap
        _ = ψ Y * ((ψ (ι (X' X)))⁻¹ * ψ (W * ι X * W⁻¹)) := key
        _ = ψ Y * ψ ((ι (X' X))⁻¹ * (W * ι X * W⁻¹)) :=
              congrArg (fun x => ψ Y * x) hmap.symm
        _ = ψ (Y * ((ι (X' X))⁻¹ * (W * ι X * W⁻¹))) := (map_mul ψ Y _).symm
    have hs : (ι (X' X))⁻¹ * (W * ι X * W⁻¹) = 1 :=
      CFSG.SeitzReduction.SymplecticPilot.eq_one_of_forall_commute_elt_one
        fun ρ => hcomm _
    calc W * ι X * W⁻¹
        = ι (X' X) * ((ι (X' X))⁻¹ * (W * ι X * W⁻¹)) := by group
      _ = ι (X' X) := by rw [hs, mul_one]
  have hσ'ι : ∀ Y : ↥(StatedSp n ↥K),
      statedSpMap (σQ : L →+* L) n (ι Y) = ι Y := by
    intro Y
    change statedSpMap (σQ : L →+* L) n (statedSpMap K.subtype n Y) =
      statedSpMap K.subtype n Y
    rw [CFSG.SeitzReduction.F4Pilot.statedSpMap_comp K.subtype (σQ : L →+* L) n Y]
    have hcomp : ((σQ : L →+* L).comp K.subtype) = K.subtype :=
      RingHom.ext fun c => (mem_fixSubfield σQ).1 c.2
    rw [hcomp]
  have hσW : statedSpMap (σQ : L →+* L) n W = W := by
    have hσ : ∀ X : ↥(StatedSp n ↥K),
        statedSpMap (σQ : L →+* L) n W * ι X *
          (statedSpMap (σQ : L →+* L) n W)⁻¹ = W * ι X * W⁻¹ := by
      intro X
      have h := congrArg (statedSpMap (σQ : L →+* L) n) (hAB X)
      have h1 : statedSpMap (σQ : L →+* L) n (W * ι X * W⁻¹) =
          statedSpMap (σQ : L →+* L) n W * ι X *
            (statedSpMap (σQ : L →+* L) n W)⁻¹ := by
        rw [map_mul, map_mul, map_inv, hσ'ι X]
      rw [h1, hσ'ι (X' X), ← hAB X] at h
      exact h
    have hcomm : ∀ X : ↥(StatedSp n ↥K),
        (W⁻¹ * statedSpMap (σQ : L →+* L) n W) * ι X =
          ι X * (W⁻¹ * statedSpMap (σQ : L →+* L) n W) := by
      intro X
      calc (W⁻¹ * statedSpMap (σQ : L →+* L) n W) * ι X
          = W⁻¹ * (statedSpMap (σQ : L →+* L) n W * ι X *
              (statedSpMap (σQ : L →+* L) n W)⁻¹) *
              statedSpMap (σQ : L →+* L) n W := by group
        _ = W⁻¹ * (W * ι X * W⁻¹) * statedSpMap (σQ : L →+* L) n W := by rw [hσ X]
        _ = ι X * (W⁻¹ * statedSpMap (σQ : L →+* L) n W) := by group
    have hs : W⁻¹ * statedSpMap (σQ : L →+* L) n W = 1 := by
      refine CFSG.SeitzReduction.SymplecticPilot.eq_one_of_forall_commute_elt_one
        fun ρ => ?_
      have h := hcomm (elt ρ 1)
      have hιe : ι (elt ρ 1) = elt ρ 1 := by
        rw [show ι (elt ρ 1) = statedSpMap K.subtype n (elt ρ (1 : ↥K)) from rfl,
          CFSG.SeitzReduction.F4Pilot.statedSpMap_elt K.subtype ρ (1 : ↥K)]
        simp
      rwa [hιe] at h
    have := congrArg (fun x => W * x) hs
    simpa using this
  have hWrange : W ∈ (statedSpMap K.subtype n).range := by
    rw [CFSG.SeitzReduction.F4Pilot.range_statedSpMap_eq_eqLocus K.subtype (σQ : L →+* L)
      (fun x => ⟨fun h => ⟨⟨x, h⟩, rfl⟩, by rintro ⟨y, rfl⟩; exact y.2⟩) n]
    exact hσW
  obtain ⟨C, hC⟩ := hWrange
  refine ⟨C, fun X => ?_⟩
  have hCX : X' X = C * X * C⁻¹ := by
    apply hιinj
    rw [← hAB X]
    rw [show W = ι C from hC.symm]
    simp only [map_mul, map_inv]
  rw [← hX' X, hCX]

end CFSG.StandardType.RCKRP

