abbrev ω3 : Multiplicative (ZMod 3) := Multiplicative.ofAdd 1

structure O1pTriple {G : Type} [Group G] [Finite G]
    (B Bs : Subgroup G) (z : Fin 3 → G) (Lc T : Fin 3 → Subgroup G)
    (χ : Fin 3 → (B →* Multiplicative (ZMod 3))) (X Xk : Subgroup G) : Prop where
  hyp : GGThmIHyp 3 B (z 0) (Lc 0)
  bstar : GGBstar 3 B Bs
  Bs_card : Nat.card Bs = 3 ^ 6
  Bs_norm : Bs ≤ normalizer (T 0 : Set G)
  z_mem : ∀ i, z i ∈ B
  χ_z : ∀ i j, χ j ⟨z i, z_mem i⟩ = if i = j then 1 else ω3
  Lc_norm : ∀ i, centralizer ({z i} : Set G) ≤ normalizer (Lc i : Set G)
  T_card : ∀ i, Nat.card (T i) = 4
  T_cent : ∀ i, Lc i ≤ centralizer (T i : Set G)
  T_char : ∀ i, normalizer (Lc i : Set G) ≤ normalizer (T i : Set G)
  lemma81 : ∀ i b (hb : b ∈ B), b ∈ centralizer (T i : Set G) ↔ χ i ⟨b, hb⟩ = 1
  X_model : LieModel X .PSU 5 2 1
  X_le : X ≤ Lc 0 ⊓ centralizer ({z 1} : Set G)
  X_split : ∀ h ∈ Lc 0 ⊓ centralizer ({z 1} : Set G),
    ∃ c ∈ Lc 0 ⊓ centralizer (Lc 0 : Set G), ∃ y ∈ X, h = c * y
  X_le_L1 : X ≤ Lc 1
  B_cent_X : B ⊓ centralizer (X : Set G) = closure {z 0, z 0 * (z 1)⁻¹}
  Xk_model : LieModel Xk .PSU 4 2 1
  Xk_le : Xk ≤ X ⊓ centralizer ({z 2} : Set G)
  Xk_le_L2 : Xk ≤ Lc 2
  F14 : ∀ α : MulAut X, (∀ y : X, (y : G) ∈ Xk → α y = y) → α ^ 3 = 1

namespace O1pTriple

theorem ω3_ne_one {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : ω3 ≠ 1 := by decide

theorem chi_mul {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) {a b : G} (ha : a ∈ B) (hb : b ∈ B) (j : Fin 3) :
    χ j ⟨a * b, mul_mem ha hb⟩ = χ j ⟨a, ha⟩ * χ j ⟨b, hb⟩ := by
  rw [← map_mul]; rfl

theorem chi_inv {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) {a : G} (ha : a ∈ B) (j : Fin 3) :
    χ j ⟨a⁻¹, inv_mem ha⟩ = (χ j ⟨a, ha⟩)⁻¹ := by
  rw [← map_inv]; rfl

theorem elemAb {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : IsElemAbelian 3 B := (ggThmIHyp_unpack h.hyp).1

theorem comm_B {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) {a b : G} (ha : a ∈ B) (hb : b ∈ B) : a * b = b * a :=
  elemAbelian_comm h.elemAb ha hb

theorem B_le_cent {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk)
    (i : Fin 3) : B ≤ centralizer ({z i} : Set G) := fun b hb => by
  rw [mem_centralizer_singleton_iff]
  exact h.comm_B hb (h.z_mem i)

theorem T_two {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) (i : Fin 3) : IsPGroup 2 (T i) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact IsPGroup.of_card (n := 2) (by rw [h.T_card i]; norm_num)

theorem T_ne_bot {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) (i : Fin 3) : T i ≠ ⊥ := fun hb => by
  have := h.T_card i
  rw [hb, card_bot] at this
  omega

theorem B_norm_T {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) (i : Fin 3) : B ≤ normalizer (T i : Set G) :=
  (h.B_le_cent i).trans ((h.Lc_norm i).trans (h.T_char i))

theorem mem_cent_comm {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) {S : Subgroup G} {g : G} (hg : g ∈ centralizer (S : Set G)) :
    S ≤ centralizer ({g} : Set G) := fun s hs => by
  rw [mem_centralizer_singleton_iff]
  exact ((mem_centralizer_iff.1 hg) s hs)

theorem le_cent_symm {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) {S U : Subgroup G} (hSU : S ≤ centralizer (U : Set G)) :
    U ≤ centralizer (S : Set G) := fun u hu => by
  rw [mem_centralizer_iff]
  intro s hs
  exact ((mem_centralizer_iff.1 (hSU hs)) u hu).symm

theorem L0_le {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk)
    : Lc 0 ≤ centralizer ({z 0} : Set G) := (ggThmIHyp_unpack h.hyp).2.2.2.1.1

theorem chi_self {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) (i : Fin 3) : χ i ⟨z i, h.z_mem i⟩ = 1 := by
  rw [h.χ_z]; simp

theorem chi_ne {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) {i j : Fin 3} (hij : i ≠ j) : χ j ⟨z i, h.z_mem i⟩ = ω3 := by
  rw [h.χ_z]; simp [hij]

theorem d_mem {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk)
    : z 0 * (z 1)⁻¹ ∈ B := mul_mem (h.z_mem 0) (inv_mem (h.z_mem 1))

theorem chi_d {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) (j : Fin 3) :
    χ j ⟨z 0 * (z 1)⁻¹, h.d_mem⟩ = χ j ⟨z 0, h.z_mem 0⟩ * (χ j ⟨z 1, h.z_mem 1⟩)⁻¹ := by
  rw [h.chi_mul (h.z_mem 0) (inv_mem (h.z_mem 1)), h.chi_inv (h.z_mem 1)]

theorem cent_mul_inv {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) {g a b : G} (ha : g ∈ centralizer ({a} : Set G))
    (hb : g ∈ centralizer ({b} : Set G)) : g ∈ centralizer ({a * b⁻¹} : Set G) := by
  rw [mem_centralizer_singleton_iff] at ha hb ⊢
  have hb' : g * b⁻¹ = b⁻¹ * g := by
    calc g * b⁻¹ = b⁻¹ * (b * g) * b⁻¹ := by group
      _ = b⁻¹ * (g * b) * b⁻¹ := by rw [hb]
      _ = b⁻¹ * g := by group
  calc g * (a * b⁻¹) = (g * a) * b⁻¹ := by group
    _ = a * (g * b⁻¹) := by rw [ha]; group
    _ = a * b⁻¹ * g := by rw [hb']; group

theorem Tk_le {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : T 2 ≤ centralizer ({z 0 * (z 1)⁻¹} : Set G) := by
  apply mem_cent_comm h
  rw [h.lemma81 2 _ h.d_mem, h.chi_d, h.chi_ne (by decide), h.chi_ne (by decide), mul_inv_cancel]

theorem zk_Tk {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : z 2 ∈ centralizer (T 2 : Set G) := by
  rw [h.lemma81 2 _ (h.z_mem 2), h.chi_self]

theorem x_moves {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : ∃ t ∈ T 2, z 0 * t * (z 0)⁻¹ ≠ t := by
  by_contra hc
  push Not at hc
  have : z 0 ∈ centralizer (T 2 : Set G) := by
    rw [mem_centralizer_iff]
    intro t ht
    have := hc t ht
    calc t * z 0 = z 0 * t * (z 0)⁻¹ * z 0 := by rw [this]
      _ = z 0 * t := by group
  rw [h.lemma81 2 _ (h.z_mem 0), h.chi_ne (by decide)] at this
  exact ω3_ne_one h this

theorem zn_not_mem {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : z 1 ∉ zpowers (z 0) := by
  rintro ⟨k, hk⟩
  have e : (⟨z 1, h.z_mem 1⟩ : B) = (⟨z 0, h.z_mem 0⟩ : B) ^ k :=
    Subtype.ext (by simp only [SubgroupClass.coe_zpow]; exact hk.symm)
  have h1 := h.chi_ne (i := 1) (j := 0) (by decide)
  rw [e, map_zpow, h.chi_self, one_zpow] at h1
  exact ω3_ne_one h h1.symm

theorem zk_norm {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : centralizer ({z 2} : Set G) ≤ normalizer (T 2 : Set G) :=
