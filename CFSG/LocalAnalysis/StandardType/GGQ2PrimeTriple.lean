theorem X_card {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : Nat.card X = 13685760 := by
