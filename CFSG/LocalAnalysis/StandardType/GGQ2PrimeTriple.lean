  exact CFSG.GH74.GLS.PU3.Thm5.isQuasisimple_of_simple h.X_noncomm

theorem X_perfect {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : ⁅X, X⁆ = X := by
  apply le_antisymm
  · rw [commutator_le]
    intro a ha b hb
    exact mul_mem (mul_mem (mul_mem ha hb) (inv_mem ha)) (inv_mem hb)
  · have h1 : (commutator X).map X.subtype = X := by
      rw [h.X_quasi.1, ← MonoidHom.range_eq_map, range_subtype]
    conv_lhs => rw [← h1]
    rw [commutator_def, map_commutator, ← MonoidHom.range_eq_map, range_subtype]

theorem X_norm_H {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk)
    {g : G} (hg : g ∈ Lc 0 ⊓ centralizer ({z 1} : Set G)) {y : G} (hy : y ∈ X) :
    g * y * g⁻¹ ∈ X := by
  obtain ⟨c, hc, y', hy', rfl⟩ := h.X_split g hg
  have hcy : ∀ w ∈ X, c * w = w * c := fun w hw =>
    ((mem_centralizer_iff.1 hc.2) w (h.X_le hw).1).symm
  have e := hcy (y' * y * y'⁻¹) (mul_mem (mul_mem hy' hy) (inv_mem hy'))
  have key : c * y' * y * (c * y')⁻¹ = y' * y * y'⁻¹ := by
    calc c * y' * y * (c * y')⁻¹ = c * (y' * y * y'⁻¹) * c⁻¹ := by group
      _ = y' * y * y'⁻¹ := by rw [e]; group
  rw [key]
  exact mul_mem (mul_mem hy' hy) (inv_mem hy')

theorem comm_H_le {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk)
    : ⁅Lc 0 ⊓ centralizer ({z 1} : Set G), Lc 0 ⊓ centralizer ({z 1} : Set G)⁆ ≤ X := by
  rw [commutator_le]
  intro a ha b hb
  obtain ⟨c, hc, y, hy, rfl⟩ := h.X_split a ha
  obtain ⟨c', hc', y', hy', rfl⟩ := h.X_split b hb
  have hcX : ∀ {c : G}, c ∈ Lc 0 ⊓ centralizer (Lc 0 : Set G) → ∀ w ∈ Lc 0, c * w = w * c :=
    fun hc w hw => ((mem_centralizer_iff.1 hc.2) w hw).symm
  have h1 := hcX hc c' hc'.1
  have h2 := hcX hc y' (h.X_le hy').1
  have h3 := hcX hc' y (h.X_le hy).1
  have e : c * y * (c' * y') * (c * y)⁻¹ * (c' * y')⁻¹ = y * y' * y⁻¹ * y'⁻¹ := by
    calc c * y * (c' * y') * (c * y)⁻¹ * (c' * y')⁻¹
        = c * (y * c') * y' * y⁻¹ * c⁻¹ * y'⁻¹ * c'⁻¹ := by group
      _ = c * (c' * y) * y' * y⁻¹ * c⁻¹ * y'⁻¹ * c'⁻¹ := by rw [h3]
      _ = (c * c') * (y * y' * y⁻¹) * c⁻¹ * y'⁻¹ * c'⁻¹ := by group
      _ = (c' * c) * (y * y' * y⁻¹) * c⁻¹ * y'⁻¹ * c'⁻¹ := by rw [h1]
      _ = c' * (c * (y * y' * y⁻¹) * c⁻¹) * y'⁻¹ * c'⁻¹ := by group
      _ = c' * (y * y' * y⁻¹) * y'⁻¹ * c'⁻¹ := by
          rw [hcX hc _ (h.X_le (mul_mem (mul_mem hy hy') (inv_mem hy))).1]; group
      _ = c' * (y * y' * y⁻¹ * y'⁻¹) * c'⁻¹ := by group
      _ = y * y' * y⁻¹ * y'⁻¹ := by
          rw [hcX hc' _ (h.X_le (mul_mem (mul_mem (mul_mem hy hy') (inv_mem hy))
            (inv_mem hy'))).1]; group
  rw [commutatorElement_def, e]
  exact mul_mem (mul_mem (mul_mem hy hy') (inv_mem hy)) (inv_mem hy')

theorem X_eq_comm_H {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk)
    : ⁅Lc 0 ⊓ centralizer ({z 1} : Set G), Lc 0 ⊓ centralizer ({z 1} : Set G)⁆ = X :=
  le_antisymm h.comm_H_le (by
    conv_lhs => rw [← h.X_perfect]
    exact commutator_mono h.X_le h.X_le)

theorem layer_H {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk)
    : CFSG.Open.IsComponentOf X (Lc 0 ⊓ centralizer ({z 1} : Set G)) ∧
    CFSG.Open.GLALayer (Lc 0 ⊓ centralizer ({z 1} : Set G)) = X :=
  CFSG.LocalAnalysis.GLTheoremA.S172A.layer_eq_of_normal_quasisimple h.X_le
    ⟨fun n hn g => by
      rw [mem_subgroupOf] at hn ⊢
      exact h.X_norm_H g.2 hn⟩ h.X_quasi h.comm_H_le

theorem cent_symm1 {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk)
    {g a : G} : g ∈ centralizer ({a} : Set G) ↔ a ∈ centralizer ({g} : Set G) := by
  rw [mem_centralizer_singleton_iff, mem_centralizer_singleton_iff]
  exact eq_comm

theorem X_normal {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk)
    : centralizer ({z 0} : Set G) ⊓ centralizer ({z 0 * (z 1)⁻¹} : Set G) ≤
    normalizer (X : Set G) := by
  intro g hg
  have hg1 : g ∈ centralizer ({z 1} : Set G) := by
    have hz : z 1 = (z 0 * (z 1)⁻¹)⁻¹ * z 0 := by group
    rw [cent_symm1 h, hz]
    exact mul_mem (inv_mem ((cent_symm1 h).1 (mem_inf.1 hg).2)) ((cent_symm1 h).1 (mem_inf.1 hg).1)
  apply mem_normalizer_of_conj_mem
  intro y hy
  set H := Lc 0 ⊓ centralizer ({z 1} : Set G)
  have hH : H.map (MulAut.conj g).toMonoidHom ≤ H := by
    rintro _ ⟨k, hk, rfl⟩
    refine mem_inf.2
      ⟨(mem_normalizer_iff.1 (h.Lc_norm 0 (mem_inf.1 hg).1) k).1 (mem_inf.1 hk).1, ?_⟩
    exact mul_mem (mul_mem hg1 (mem_inf.1 hk).2) (inv_mem hg1)
  have : X.map (MulAut.conj g).toMonoidHom ≤ X := by
    rw [← h.X_eq_comm_H, map_commutator]
    exact commutator_mono hH hH
  exact this ⟨y, hy, rfl⟩

theorem bstar_B {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : Bs = B ∧ twoLocalPrimeRank 3 G = 6 := by
  obtain ⟨-, -, -, -, -, -, hSS, -⟩ := h.hyp
  obtain ⟨hBmax, -⟩ := hSS
  obtain ⟨hEq, h6⟩ := bstar_eq_of_normalizes hBmax h.bstar (h.T_ne_bot 0) (h.T_two 0) h.Bs_norm
  exact ⟨hEq, h6 h.Bs_card⟩

theorem B_card {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : Nat.card B = 3 ^ 6 := h.bstar_B.1 ▸ h.Bs_card

theorem B_le_C_d {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : B ≤ centralizer ({z 0 * (z 1)⁻¹} : Set G) := fun b hb => by
  rw [mem_centralizer_singleton_iff]
  exact h.comm_B hb h.d_mem

theorem B_le_NX {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : B ≤ normalizer (X : Set G) := fun b hb =>
  h.X_normal (mem_inf.2 ⟨h.B_le_cent 0 hb, h.B_le_C_d hb⟩)

theorem le_normalizer_of_le_cent {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) {S U : Subgroup G} (hSU : S ≤ centralizer (U : Set G)) :
    S ≤ normalizer (U : Set G) := fun s hs => by
  have hc : ∀ u ∈ U, u * s = s * u := mem_centralizer_iff.1 (hSU hs)
  rw [mem_normalizer_iff]
  intro n
  constructor
  · intro hn
    have : s * n * s⁻¹ = n := by rw [← hc n hn]; group
    rw [this]; exact hn
  · intro hn
    have e := hc _ hn
    have : n = s * n * s⁻¹ := by
      calc n = s⁻¹ * (s * n * s⁻¹ * s) := by group
        _ = s⁻¹ * (s * (s * n * s⁻¹)) := by rw [e]
        _ = s * n * s⁻¹ := by group
    rw [this]; exact hn

theorem X_le_NT0 {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : X ≤ normalizer (T 0 : Set G) :=
  le_normalizer_of_le_cent h (fun y hy => h.T_cent 0 (h.X_le hy).1)

theorem hZX {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk)
    : ∀ k ∈ X, (∀ y ∈ X, k * y = y * k) → k = 1 := center_trivial_of_U52 h.X_model

theorem hinn {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk)
    : ∀ b ∈ B, ∃ k ∈ X, ∀ y ∈ X, b * y * b⁻¹ = k * y * k⁻¹ := fun b hb =>
  inner_of_U52 h.X_model (h.B_le_NX hb) (h.elemAb.2 b hb)

theorem B_eq {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : B = (B ⊓ X) ⊔ closure {z 0, z 0 * (z 1)⁻¹} := by
  rw [← h.B_cent_X]
  exact o1pp_B_eq_of_model h.X_model h.elemAb h.B_le_NX (h.T_ne_bot 0) (h.T_two 0)
    (h.B_norm_T 0) h.X_le_NT0 h.bstar_B.2.le h.B_card

theorem E_moves {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : ∃ b ∈ B ⊓ X, ∃ t ∈ T 2, b * t * b⁻¹ ≠ t := by
  obtain ⟨hk, hc⟩ := decomp (B := B) (X := X) (T := T 0) h.hZX h.hinn h.elemAb (h.T_ne_bot 0)
    (h.T_two 0) (h.B_norm_T 0) h.X_le_NT0 h.bstar_B.2.le h.B_card (h.z_mem 2)
  set k := innerPart (B := B) (X := X) (z 2) with hkdef
  set c := centPart (B := B) (X := X) (z 2) with hcdef
  have hkB := (mem_inf.1 hk).1
  have hkX := (mem_inf.1 hk).2
  have hcB := (mem_inf.1 hc).1
  have hzkc : z 2 = k * c := by rw [hcdef, centPart, ← hkdef]; group
  set ψ : B →* Multiplicative (ZMod 3) := χ 0 * χ 0 * χ 1 * χ 1 * χ 2 with hψ
  have hψ_ap : ∀ b : B, ψ b = χ 0 b * χ 0 b * χ 1 b * χ 1 b * χ 2 b := fun b => rfl
  have c01 := h.chi_ne (i := 0) (j := 1) (by decide)
  have c02 := h.chi_ne (i := 0) (j := 2) (by decide)
  have c10 := h.chi_ne (i := 1) (j := 0) (by decide)
  have c12 := h.chi_ne (i := 1) (j := 2) (by decide)
  have c20 := h.chi_ne (i := 2) (j := 0) (by decide)
  have c21 := h.chi_ne (i := 2) (j := 1) (by decide)
  have hψ0 : ψ ⟨z 0, h.z_mem 0⟩ = 1 := by
    rw [hψ_ap, h.chi_self 0, c01, c02]; decide
  have hψd : ψ ⟨z 0 * (z 1)⁻¹, h.d_mem⟩ = 1 := by
    rw [hψ_ap, h.chi_d, h.chi_d, h.chi_d, h.chi_self 0, h.chi_self 1, c01, c02, c10, c12]; decide
  have hψ2 : ψ ⟨z 2, h.z_mem 2⟩ = ω3 := by
    rw [hψ_ap, h.chi_self 2, c20, c21]; decide
  have hcl : closure {z 0, z 0 * (z 1)⁻¹} ≤ ψ.ker.map B.subtype := by
    rw [closure_le]
    rintro _ (rfl | rfl)
    · exact ⟨⟨z 0, h.z_mem 0⟩, hψ0, rfl⟩
    · exact ⟨⟨z 0 * (z 1)⁻¹, h.d_mem⟩, hψd, rfl⟩
  have hψc : ψ ⟨c, hcB⟩ = 1 := by
    have hc' : c ∈ closure {z 0, z 0 * (z 1)⁻¹} := by rw [← h.B_cent_X]; exact hc
    obtain ⟨c', hc'k, hc'e⟩ := hcl hc'
    have : c' = ⟨c, hcB⟩ := Subtype.ext hc'e
    rw [← this]; exact hc'k
  have hk0 : χ 0 ⟨k, hkB⟩ = 1 := (h.lemma81 0 k hkB).1 (h.T_cent 0 (h.X_le hkX).1)
  have hk1 : χ 1 ⟨k, hkB⟩ = 1 := (h.lemma81 1 k hkB).1 (h.T_cent 1 (h.X_le_L1 hkX))
  have hsplit : ψ ⟨z 2, h.z_mem 2⟩ = ψ ⟨k, hkB⟩ * ψ ⟨c, hcB⟩ := by
    rw [← map_mul]; congr 1; exact Subtype.ext hzkc
  have hk2 : χ 2 ⟨k, hkB⟩ = ω3 := by
    rw [hψ2, hψc, mul_one, hψ_ap, hk0, hk1] at hsplit
    simpa using hsplit.symm
  refine ⟨k, hk, ?_⟩
  by_contra hcon
  push Not at hcon
  have hkC : k ∈ centralizer (T 2 : Set G) := by
    rw [mem_centralizer_iff]
    intro t ht
    calc t * k = k * t * k⁻¹ * k := by rw [hcon t ht]
      _ = k * t := by group
  rw [h.lemma81 2 k hkB, hk2] at hkC
  exact ω3_ne_one h hkC

theorem x_fpf {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : ∀ t ∈ T 2, z 0 * t * (z 0)⁻¹ = t → t = 1 :=
  fpf_of_moves (h.T_card 2) (h.B_norm_T 2 (h.z_mem 0)) (h.elemAb.2 _ (h.z_mem 0)) h.x_moves

theorem z_ne_one {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) (i : Fin 3) : z i ≠ 1 := by
  intro h1
  have hj : ∃ j : Fin 3, j ≠ i := ⟨i + 1, by fin_cases i <;> decide⟩
  obtain ⟨j, hj⟩ := hj
  have e := h.chi_ne (i := i) (j := j) (Ne.symm hj)
  have : (⟨z i, h.z_mem i⟩ : B) = 1 := Subtype.ext h1
  rw [this, map_one] at e
  exact ω3_ne_one h e.symm

theorem cl_eq {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : closure {z 0, z 1} = closure {z 0, z 0 * (z 1)⁻¹} := by
  apply le_antisymm
  · rw [closure_le]
    rintro _ (rfl | rfl)
    · exact Subgroup.subset_closure (by simp)
    · have e : z 1 = (z 0 * (z 1)⁻¹)⁻¹ * z 0 := by group
      rw [e]
      exact mul_mem (inv_mem (Subgroup.subset_closure (by simp)))
        (Subgroup.subset_closure (by simp))
  · rw [closure_le]
    rintro _ (rfl | rfl)
    · exact Subgroup.subset_closure (by simp)
    · exact mul_mem (Subgroup.subset_closure (by simp))
        (inv_mem (Subgroup.subset_closure (by simp)))

theorem LD_eq {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : Lc 0 ⊓ centralizer (closure {z 0, z 1} : Set G) =
    Lc 0 ⊓ centralizer ({z 1} : Set G) := by
  ext g
  constructor
  · rintro ⟨hL, hC⟩
    exact ⟨hL, centralizer_le (Set.singleton_subset_iff.2 (Subgroup.subset_closure (by simp))) hC⟩
  · rintro ⟨hL, hC⟩
    refine ⟨hL, ?_⟩
    have hle : closure {z 0, z 1} ≤ centralizer ({g} : Set G) := by
      rw [closure_le]
      rintro _ (rfl | rfl)
      · exact (cent_symm1 h).1 (h.L0_le hL)
      · exact (cent_symm1 h).1 hC
    exact mem_centralizer_iff.2 fun s hs => mem_centralizer_singleton_iff.1 (hle hs)

theorem D_card {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : Nat.card (closure {z 0, z 1} : Subgroup G) = 3 ^ 2 := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have ho : ∀ i, orderOf (z i) = 3 := fun i => orderOf_eq_prime (h.elemAb.2 _ (h.z_mem i))
    (h.z_ne_one i)
  have hc : ∀ i, Nat.card (zpowers (z i)) = 3 := fun i => by rw [Nat.card_zpowers, ho]
  have hdisj : zpowers (z 0) ⊓ zpowers (z 1) = ⊥ := by
    have hle : zpowers (z 0) ⊓ zpowers (z 1) ≤ zpowers (z 0) := inf_le_left
    have hdvd : Nat.card (zpowers (z 0) ⊓ zpowers (z 1) : Subgroup G) ∣ 3 := by
      have := Subgroup.card_dvd_of_le hle
      rwa [hc 0] at this
    rcases (Nat.dvd_prime Nat.prime_three).mp hdvd with h1 | h3
    · exact Subgroup.card_eq_one.mp h1
    · exfalso
      have heq : zpowers (z 0) ⊓ zpowers (z 1) = zpowers (z 0) :=
        Subgroup.eq_of_le_of_card_ge hle (by rw [h3, hc 0])
      have hle' : zpowers (z 0) ≤ zpowers (z 1) := heq ▸ inf_le_right
      have heq2 : zpowers (z 0) = zpowers (z 1) :=
        Subgroup.eq_of_le_of_card_ge hle' (by rw [hc 0, hc 1])
      exact h.zn_not_mem (heq2.symm ▸ mem_zpowers (z 1))
  have hcomm : ∀ a ∈ zpowers (z 0), ∀ c ∈ zpowers (z 1), a * c = c * a := fun a ha c hc =>
    h.comm_B (zpowers_le.mpr (h.z_mem 0) ha) (zpowers_le.mpr (h.z_mem 1) hc)
  have h1 := (CFSG.GroupTheory.card_sup_mul_card_inf_of_commute (zpowers (z 0)) (zpowers (z 1))
    hcomm).1
  rw [hdisj, card_bot, mul_one, hc 0, hc 1] at h1
  rw [Set.insert_eq, Subgroup.closure_union, ← zpowers_eq_closure, ← zpowers_eq_closure, h1]
  norm_num

theorem not_small_X {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : ¬ LargeEvenSmall X := by
  have h11 : 11 ∣ Nat.card X := by rw [h.X_card]; norm_num
  rintro (hU | hA)
  · rw [IOneOrthEnd.card_of_isU42 hU] at h11
    omega
  · obtain ⟨e⟩ := hA
    rw [Nat.card_congr e.toEquiv, IOneOrthEnd.card_alternatingGroup_six] at h11
    omega

theorem stdSub {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk)
    : LargeEvenStdSub 3 B (z 0) (Lc 0) (closure {z 0, z 1}) X := by
  have hDB : closure {z 0, z 1} ≤ B := by
    rw [closure_le]
    rintro _ (rfl | rfl)
    · exact h.z_mem 0
    · exact h.z_mem 1
  unfold LargeEvenStdSub
  refine ⟨?_, fun _ => h.not_small_X⟩
  unfold LargeEvenStdSubPre
  refine ⟨hDB, ?_, h.D_card, Subgroup.subset_closure (by simp), ?_, ?_, ?_⟩
  · refine ⟨⟨⟨fun a b => Subtype.ext (h.comm_B (hDB a.2) (hDB b.2))⟩⟩, ?_⟩
    intro y hy
    exact h.elemAb.2 y (hDB hy)
  · rw [h.LD_eq, CFSG.Assembly.LargeEven.largeEvenLayer_eq_glaLayer, h.layer_H.2]
  · rw [h.LD_eq]
    exact CFSG.Assembly.isComponentOf_iff_open.2 h.layer_H.1
  · rw [h.cl_eq, h.B_cent_X]

theorem bstar_BB {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : GGBstar 3 B B := by
  have := h.bstar
  rwa [h.bstar_B.1] at this

theorem o1ppDataK_of_triple {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : O1ppDataK B (z 0) (z 1) (z 2) (Lc 0) X Xk (T 2) where
  hyp := h.hyp
  bstar := h.bstar_BB
  rank_six := h.bstar_B.2
  zn_mem := h.z_mem 1
  zn_not_mem := h.zn_not_mem
  stdSub := h.stdSub
  X_model := h.X_model
  X_le := h.X_le_H
  X_normal := h.X_normal
  Xk_le := fun _ hy => (h.Xk_le hy).1
  Xk_model := h.Xk_model
  Tk_two := h.T_two 2
  Tk_card := h.T_card 2
  Tk_le := h.Tk_le
  B_norm_Tk := h.B_norm_T 2
  Tk_cent_Xk := h.Tk_cent_Xk
  E_moves := h.E_moves
  x_moves := h.x_moves
  F14 := h.F14
  zk_mem := h.z_mem 2
  zk_Tk := h.zk_Tk
  zk_norm := h.zk_norm
  zk_Xk := h.zk_Xk
  B_cent_X := h.B_cent_X
  B_eq := h.B_eq
  x_fpf := h.x_fpf

end O1pTriple

theorem o1p_triple_false {G : Type} [Group G] [Finite G]
    (hL : GGLBalanceInput) (hI : PumpUpLieInputs)
    {B Bs : Subgroup G} {z : Fin 3 → G} {Lc T : Fin 3 → Subgroup G}
    {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : False :=
  o1pp_false hL hI h.o1ppDataK_of_triple

end CFSG.GGQ2Prime
