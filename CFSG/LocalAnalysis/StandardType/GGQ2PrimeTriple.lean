theorem zk_Xk {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
    (h : O1pTriple B Bs z Lc T χ X Xk) : z 2 ∈ centralizer (Xk : Set G) := by
  rw [mem_centralizer_iff]
  intro y hy
  have := mem_centralizer_singleton_iff.1 (h.Xk_le hy).2
  exact this

theorem Tk_cent_Xk {G : Type} [Group G] [Finite G] {B Bs : Subgroup G} {z : Fin 3 → G}
    {Lc T : Fin 3 → Subgroup G} {χ : Fin 3 → (B →* Multiplicative (ZMod 3))} {X Xk : Subgroup G}
