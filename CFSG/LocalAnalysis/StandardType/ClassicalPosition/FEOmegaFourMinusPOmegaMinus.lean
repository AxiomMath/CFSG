      x ∈ LinearMap.range (Matrix.mulVecLin ε) →
        Matrix.toLin' (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
          (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) x = x := by
    intro x hx
    obtain ⟨y, rfl⟩ := hx
    rw [Matrix.toLin'_apply, Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, htriv s hs]
  have hker : ∀ x : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F, Matrix.mulVec ε x = 0 →
      Matrix.mulVec ε (Matrix.toLin' (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
        (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) x) = 0 := by
    intro x hx
    rw [Matrix.toLin'_apply, Matrix.mulVec_mulVec, ← hcommε.eq, ← Matrix.mulVec_mulVec, hx,
      Matrix.mulVec_zero]
  have hrP : r ∈ LinearMap.BilinForm.orthogonal (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq))
      (LinearMap.range (Matrix.mulVecLin ε)) := by
    rw [feomegm_aux_block_perp_eq_ker_two n hirr S hε]
    exact hrker
  have hψrP : Matrix.toLin' (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) r ∈
      LinearMap.BilinForm.orthogonal (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq))
        (LinearMap.range (Matrix.mulVecLin ε)) := by
    rw [feomegm_aux_block_perp_eq_ker_two n hirr S hε]
    exact hker r hrker
  have hL : Φ (Matrix.toLin' (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
        (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) v) =
      ((aL w : ↥(LinearMap.range (Matrix.mulVecLin ε))) :
        Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) +
        Matrix.toLin' (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
          (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) r := by
    conv_lhs => rw [show v = w.1 + r from hvr.symm]
    rw [map_add, hfixW w.1 w.2]
    exact feomegm_aux_orthogonalGroup_extend_apply_two n hirr hn S hSU hS hodd hε htriv hrank
      hminus a w ⟨Matrix.toLin' (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
        (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) r, hψrP⟩
  have hR : Matrix.toLin' (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
        (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) (Φ v) =
      ((aL w : ↥(LinearMap.range (Matrix.mulVecLin ε))) :
        Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) +
        Matrix.toLin' (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
          (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) r := by
    conv_lhs => rw [show v = w.1 + r from hvr.symm]
    rw [feomegm_aux_orthogonalGroup_extend_apply_two n hirr hn S hSU hS hodd hε htriv hrank
      hminus a w ⟨r, hrP⟩]
    rw [map_add, hfixW (aL w).1 (aL w).2]
  exact hR.trans hL.symm

