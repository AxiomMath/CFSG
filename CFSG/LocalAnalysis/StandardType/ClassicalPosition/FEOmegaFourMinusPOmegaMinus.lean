        simpa only [Q', QuadraticMap.restrict_apply] using h u huU
      have hu' : (u : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) = x := hu
      rwa [hu'] at hh
    have hy0 : (Spin.quadMinus n F bq cq) y = 0 := by
