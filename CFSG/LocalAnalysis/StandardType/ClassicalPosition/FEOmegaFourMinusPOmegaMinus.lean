    (hodd : ∀ s ∈ S, Odd (orderOf s))
    {ε : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F}
    (hε : IsPrimAdjIdemIn (RingHom.id F)
      (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq)))
      (Algebra.adjoin F (Units.val '' S)) ε)
    (htriv : ∀ s ∈ S, (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) * ε = ε)
    (hrank : ε.rank = 4)
    (hminus : ∀ x y : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F, Matrix.mulVec ε x = x → Matrix.mulVec ε
      y = y →
      (Spin.quadMinus n F bq cq) x = 0 → (Spin.quadMinus n F bq cq) y = 0 → QuadraticMap.polar
      (Spin.quadMinus n F bq cq) x y = 0 → ¬ LinearIndependent F ![x, y]) :
    ∀ (a : ↥(TauCeti.QuadraticMap.orthogonalGroup
          ((Spin.quadMinus n F bq cq).restrict (LinearMap.range (Matrix.mulVecLin ε)))))
      (u : spinGroup (Spin.quadMinus n F bq cq)),
      Spin.spinAction (Spin.quadMinus n F bq cq) u =
        (feomegm_aux_orthogonalGroup_extend_two (feomegm_aux_block_isCompl_two n hirr S hε) a :
          (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) ≃ₗ[F] (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F)) →
      Spin.spinMatrix (Spin.quadMinus n F bq cq) u ∈ Subgroup.centralizer S := by
  intro a u hu
  let Φ : (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) ≃ₗ[F]
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) :=
    feomegm_aux_orthogonalGroup_extend_two (feomegm_aux_block_isCompl_two n hirr S hε) a
  have hu' : Spin.spinAction (Spin.quadMinus n F bq cq) u = Φ := hu
  let aL : ↥(LinearMap.range (Matrix.mulVecLin ε)) ≃ₗ[F]
      ↥(LinearMap.range (Matrix.mulVecLin ε)) := a
  rw [Subgroup.mem_centralizer_iff]
  intro s hs
  have hcommε : Commute (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) ε :=
    feomegm_aux_spin_commute_eps_two n hirr hn S hS hε s hs
  apply Units.ext
  rw [Units.val_mul, Units.val_mul]
  apply Matrix.toLin'.injective
  rw [Matrix.toLin'_mul, Matrix.toLin'_mul]
  apply LinearMap.ext
  intro v
  rw [LinearMap.comp_apply, LinearMap.comp_apply, Spin.coe_spinMatrix, Matrix.toLin'_toMatrix',
    hu']
  let w : ↥(LinearMap.range (Matrix.mulVecLin ε)) :=
    ⟨Matrix.mulVec ε v, ⟨v, by rw [Matrix.mulVecLin_apply]⟩⟩
  let r : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F := Matrix.mulVec (1 - ε) v
  have hvr : w.1 + r = v := by
    change Matrix.mulVec ε v + Matrix.mulVec (1 - ε) v = v
    rw [← Matrix.add_mulVec, add_sub_cancel, Matrix.one_mulVec]
  have hrker : Matrix.mulVec ε r = 0 := by
    change Matrix.mulVec ε (Matrix.mulVec (1 - ε) v) = 0
    rw [Matrix.mulVec_mulVec, Matrix.mul_sub, Matrix.mul_one, hε.2.1.eq, sub_self,
      Matrix.zero_mulVec]
