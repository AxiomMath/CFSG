      (Spin.quadMinus n F bq cq) x y = 0 → ¬ LinearIndependent F ![x, y]) :
    ∀ U : Submodule F ↥(LinearMap.range (Matrix.mulVecLin ε)),
      Module.finrank F U = Module.finrank F ↥(LinearMap.range (Matrix.mulVecLin ε)) / 2 →
      ∃ u ∈ U, ((Spin.quadMinus n F bq cq).restrict
        (LinearMap.range (Matrix.mulVecLin ε))) u ≠ 0 := by
  let W := LinearMap.range (Matrix.mulVecLin ε)
  let Q' := (Spin.quadMinus n F bq cq).restrict W
  have hεidem : IsIdempotentElem ε := hε.2.1
  have hd4 : Module.finrank F ↥W = 4 := by
    show ε.rank = 4
    exact hrank
  have hmain : ∀ U : Submodule F ↥W, Module.finrank F U = Module.finrank F ↥W / 2 →
      ∃ u ∈ U, Q' u ≠ 0 := by
    intro U hU
    by_contra h
    push_neg at h
    have hU2 : Module.finrank F U = 2 := by
      rw [hU, hd4]
    let U' : Submodule F (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) :=
      U.map (Submodule.subtype W)
    have hU'2 : Module.finrank F U' = 2 := by
      have e := Submodule.equivMapOfInjective (Submodule.subtype W)
        (Submodule.subtype_injective W) U
      rw [← LinearEquiv.finrank_eq e]
      exact hU2
