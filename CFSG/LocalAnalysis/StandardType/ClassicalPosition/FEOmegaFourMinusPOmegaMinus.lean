      simpa using hW.disjoint.le_bot hxbot
    · intro x hx
      apply Subtype.ext
      have hxW : (x : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) ∈
          LinearMap.BilinForm.orthogonal (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq))
            W := by
        rw [LinearMap.BilinForm.mem_orthogonal_iff]
        intro y hy
        have h := hx ⟨y, hy⟩
        rw [QuadraticMap.polarBilin_apply_apply] at h
        rw [QuadraticMap.polarBilin_apply_apply]
        exact h
      have hxbot : (x : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) ∈ W ⊓
          LinearMap.BilinForm.orthogonal (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq))
            W := ⟨x.2, hxW⟩
      simpa using hW.disjoint.le_bot hxbot
  exact hmain

