private lemma feomegm_aux_blockAction_surjective_two (n : ℕ) {F : Type} [Field F] [Finite F]
    [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) (hn : 4 ≤ n)
    (S : Set (GL (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F))
    (hSU : ∀ s ∈ S, s ∈ (Spin.spinMatrix (Spin.quadMinus n F bq cq)).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    (hodd : ∀ s ∈ S, Odd (orderOf s))
    {ε : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F}
    (hε : IsPrimAdjIdemIn (RingHom.id F)
      (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq)))
      (Algebra.adjoin F (Units.val '' S)) ε)
    (htriv : ∀ s ∈ S, (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) * ε = ε)
    (hrank : ε.rank = 4)
    (hminus : ∀ x y : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F, Matrix.mulVec ε x = x → Matrix.mulVec ε
      y = y →
      (Spin.quadMinus n F bq cq) x = 0 → (Spin.quadMinus n F bq cq) y = 0 → QuadraticMap.polar
      (Spin.quadMinus n F bq cq) x y = 0 → ¬ LinearIndependent F ![x, y]) :
    Function.Surjective
      (feomegm_aux_blockAction_two n hirr hn S hSU hS hodd hε htriv hrank hminus) := by
  intro y
  let OW := TauCeti.QuadraticMap.orthogonalGroup
    ((Spin.quadMinus n F bq cq).restrict (LinearMap.range (Matrix.mulVecLin ε)))
  let Gε := glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε
  let φ := feomegm_aux_blockActionHom_two n hirr hn S hSU hS hodd hε htriv hrank hminus
  let Φ := OW.subtype.comp φ
  let hle := feomegm_aux_blockAction_le_self_two n hirr hn S hSU hS hodd hε htriv hrank hminus
  have hperf : _root_.commutator ↥⁅OW, OW⁆ = ⊤ :=
    feomegm_aux_blockOmega_perfect_two n hirr hn S hSU hS hodd hε htriv hrank hminus
  have hsurj : ⁅OW, OW⁆ ≤ Φ.range := by
    rintro a ha
    obtain ⟨u, hu⟩ := feomegm_aux_blockActionHom_surjective_two n hirr hn S hSU hS hodd hε htriv
      hrank hminus ⟨a, Subgroup.commutator_le_self OW ha⟩ ha
    exact (MonoidHom.mem_range (f := Φ)).mpr ⟨u, by
      simpa [Φ, φ] using congrArg OW.subtype hu⟩
  have hy : (y : ↥(LinearMap.range (Matrix.mulVecLin ε)) ≃ₗ[F]
      ↥(LinearMap.range (Matrix.mulVecLin ε))) ∈ ⁅⁅OW, OW⁆, ⁅OW, OW⁆⁆ :=
    feomegm_aux_coe_mem_commutator_of_mem ⁅OW, OW⁆ (by rw [hperf]; exact Subgroup.mem_top y)
  have hmem : (y : ↥(LinearMap.range (Matrix.mulVecLin ε)) ≃ₗ[F]
      ↥(LinearMap.range (Matrix.mulVecLin ε))) ∈ (_root_.commutator ↥Gε).map Φ := by
    rw [_root_.commutator_def, Subgroup.map_commutator, Subgroup.map_top]
    exact (Subgroup.commutator_mono hsurj hsurj) hy
  obtain ⟨u, hu, huy⟩ := Subgroup.mem_map.mp hmem
  have hx : (u : spinGroup (Spin.quadMinus n F bq cq)) ∈ ⁅Gε, Gε⁆ := by
    rw [← Subgroup.map_subtype_commutator Gε]
    exact Subgroup.mem_map_of_mem Gε.subtype hu
  refine ⟨⟨u.1, hx⟩, ?_⟩
  apply Subtype.ext
  change Φ (Subgroup.inclusion hle ⟨u.1, hx⟩) = (y : ↥(LinearMap.range (Matrix.mulVecLin ε)) ≃ₗ[F]
    ↥(LinearMap.range (Matrix.mulVecLin ε)))
  rw [show Subgroup.inclusion hle ⟨u.1, hx⟩ = u from Subtype.ext rfl]
  exact huy

