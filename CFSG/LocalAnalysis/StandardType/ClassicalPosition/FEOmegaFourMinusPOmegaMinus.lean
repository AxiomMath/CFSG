private lemma feomegm_aux_spinAction_extend_centralizes_two (n : ℕ) {F : Type} [Field F] [Finite F]
    [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) (hn : 4 ≤ n)
    (S : Set (GL (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F))
