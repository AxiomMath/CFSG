    let b := Module.finBasisOfFinrankEq F U' hU'2
    let x : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F := b 0
    let y : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F := b 1
    have hxU' : x ∈ U' := (b 0).2
    have hyU' : y ∈ U' := (b 1).2
    have hliV : LinearIndependent F ![x, y] := by
      have hbase : LinearIndependent F
          (fun i : Fin 2 => (b i : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F)) :=
        b.linearIndependent.map' (Submodule.subtype U') (Submodule.ker_subtype U')
      have hb : (fun i : Fin 2 => (b i : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F)) = ![x, y] := by
        funext i
        fin_cases i <;> rfl
      rwa [hb] at hbase
    have hxW : x ∈ W := by
      obtain ⟨u, -, hu⟩ := Submodule.mem_map.mp hxU'
      rw [← hu]
      exact u.2
    have hyW : y ∈ W := by
      obtain ⟨u, -, hu⟩ := Submodule.mem_map.mp hyU'
      rw [← hu]
      exact u.2
    have hxV : Matrix.mulVec ε x = x := by
      obtain ⟨v, hv⟩ := LinearMap.mem_range.mp hxW
      have hv' : Matrix.mulVec ε v = x := by
        simpa only [Matrix.mulVecLin_apply] using hv
      rw [← hv', Matrix.mulVec_mulVec, hεidem.eq]
    have hyV : Matrix.mulVec ε y = y := by
      obtain ⟨v, hv⟩ := LinearMap.mem_range.mp hyW
      have hv' : Matrix.mulVec ε v = y := by
        simpa only [Matrix.mulVecLin_apply] using hv
      rw [← hv', Matrix.mulVec_mulVec, hεidem.eq]
    have hx0 : (Spin.quadMinus n F bq cq) x = 0 := by
      obtain ⟨u, huU, hu⟩ := Submodule.mem_map.mp hxU'
      have hh : (Spin.quadMinus n F bq cq)
          (u : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) = 0 := by
        simpa only [Q', QuadraticMap.restrict_apply] using h u huU
      have hu' : (u : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) = x := hu
      rwa [hu'] at hh
    have hy0 : (Spin.quadMinus n F bq cq) y = 0 := by
      obtain ⟨u, huU, hu⟩ := Submodule.mem_map.mp hyU'
      have hh : (Spin.quadMinus n F bq cq)
          (u : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) = 0 := by
        simpa only [Q', QuadraticMap.restrict_apply] using h u huU
      have hu' : (u : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) = y := hu
      rwa [hu'] at hh
    have hxy0 : QuadraticMap.polar (Spin.quadMinus n F bq cq) x y = 0 := by
      obtain ⟨u, huU, hu⟩ := Submodule.mem_map.mp hxU'
      obtain ⟨w, hwU, hw⟩ := Submodule.mem_map.mp hyU'
      have hh := h (u + w) (Submodule.add_mem U huU hwU)
      have hh' : (Spin.quadMinus n F bq cq)
          ((u : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) +
            (w : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F)) = 0 := by
        simpa only [Q', QuadraticMap.restrict_apply, Submodule.coe_add] using hh
      have hu' : (u : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) = x := hu
      have hw' : (w : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) = y := hw
      have hxy : (u : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) +
          (w : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F) = x + y := by
        rw [hu', hw']
      rw [hxy] at hh'
      have hm := QuadraticMap.map_add (Spin.quadMinus n F bq cq) x y
      rw [hx0, hy0, hh'] at hm
      simpa using hm.symm
    exact hminus x y hxV hyV hx0 hy0 hxy0 hliV
  exact hmain

private lemma feomegm_aux_blockOmega_perfect_two (n : ℕ) {F : Type} [Field F] [Finite F]
    [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) (hn : 4 ≤ n)
