private lemma feomegm_isUnit_det_gram {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (Q : QuadraticForm F (ι → F))
    (hnd : (QuadraticMap.polarBilin Q).Nondegenerate) :
    IsUnit (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)).det := by
  have h1 : (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)) =
      LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin Q) := rfl
  rw [h1]
  exact isUnit_iff_ne_zero.mpr (Matrix.nondegenerate_iff_det_ne_zero.mp
    ((LinearMap.BilinForm.nondegenerate_toMatrix'_iff).mpr hnd))

private lemma feomegm_gram_transpose {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (Q : QuadraticForm F (ι → F)) :
    Matrix.transpose ((LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)).map (RingHom.id F))
      = LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q) := by
  rw [show (⇑(RingHom.id F) : F → F) = id from rfl, Matrix.map_id]
  ext i j
  rw [Matrix.transpose_apply, LinearMap.toMatrix₂'_apply, LinearMap.toMatrix₂'_apply]
  exact QuadraticMap.polar_comm Q (Pi.single j 1) (Pi.single i 1)

private lemma feomegm_gram_isometry {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (Q : QuadraticForm F (ι → F)) {s : GL ι F}
    (hs : s ∈ (Spin.spinMatrix Q).range) :
    Matrix.transpose ((s : Matrix ι ι F).map (RingHom.id F)) *
      LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q) * (s : Matrix ι ι F)
      = LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q) := by
  obtain ⟨x, rfl⟩ := hs
  set G := LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q) with hGdef
  have hEqB : Matrix.toBilin' G = QuadraticMap.polarBilin Q := by
    rw [hGdef, show LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)
      = LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin Q) from rfl]
    exact Matrix.toBilin'_toMatrix' _
  have hcomp := Matrix.toBilin'_comp G (Spin.spinMatrix Q x : Matrix ι ι F)
    (Spin.spinMatrix Q x : Matrix ι ι F)
  have hEq : Matrix.toBilin' (Matrix.transpose (Spin.spinMatrix Q x : Matrix ι ι F) * G *
      (Spin.spinMatrix Q x : Matrix ι ι F)) = Matrix.toBilin' G := by
    rw [← hcomp]
    refine LinearMap.ext fun v => LinearMap.ext fun w => ?_
    rw [LinearMap.BilinForm.comp_apply, Matrix.toLin'_apply, Matrix.toLin'_apply, hEqB,
      QuadraticMap.polarBilin_apply_apply, QuadraticMap.polarBilin_apply_apply]
    simp only [Spin.spinMatrix_mulVec]
    exact Spin.polar_spinAction Q x v w
  have hmap : ((Spin.spinMatrix Q x : Matrix ι ι F)).map (⇑(RingHom.id F))
      = (Spin.spinMatrix Q x : Matrix ι ι F) := by
    rw [show (⇑(RingHom.id F) : F → F) = id from rfl, Matrix.map_id]
  rw [hmap]
  exact (Matrix.toBilin' (R₁ := F)).injective hEq

private lemma feomegm_adjoin_comm {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    {S : Set (GL ι F)} (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') :
    ∀ {a b : Matrix ι ι F}, a ∈ Algebra.adjoin F (Units.val '' S) →
      b ∈ Algebra.adjoin F (Units.val '' S) → a * b = b * a := by
  have hcommS : (Units.val '' S : Set (Matrix ι ι F)).Pairwise Commute := by
    rintro a ⟨s, hs, rfl⟩ b ⟨s', hs', rfl⟩ _
    show (s : Matrix ι ι F) * (s' : Matrix ι ι F) = (s' : Matrix ι ι F) * (s : Matrix ι ι F)
    rw [← Units.val_mul, ← Units.val_mul]
    exact congrArg Units.val (hS s hs s' hs').eq
  letI : CommSemiring (Algebra.adjoin F (Units.val '' S)) :=
    Algebra.adjoinCommSemiringOfComm F hcommS
  intro a b ha hb
  have h := mul_comm (⟨a, ha⟩ : Algebra.adjoin F (Units.val '' S))
    (⟨b, hb⟩ : Algebra.adjoin F (Units.val '' S))
  simpa only [Subalgebra.coe_mul] using congrArg Subtype.val h

private lemma feomegm_mem_block {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (A : Subalgebra F (Matrix ι ι F)) (x e : Matrix ι ι F) :
    x ∈ (Subalgebra.toSubmodule A).map (LinearMap.mulRight F e) ↔ ∃ a ∈ A, a * e = x := by
  rw [Submodule.mem_map]
  constructor
  · rintro ⟨a, ha, hfa⟩
    exact ⟨a, (Subalgebra.mem_toSubmodule A).mp ha, by rwa [LinearMap.mulRight_apply] at hfa⟩
  · rintro ⟨a, ha, rfl⟩
    exact ⟨a, (Subalgebra.mem_toSubmodule A).mpr ha, by rw [LinearMap.mulRight_apply]⟩

private lemma feomegm_blockDegree_lt {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (A : Subalgebra F (Matrix ι ι F))
    (hAcomm : ∀ {a b : Matrix ι ι F}, a ∈ A → b ∈ A → a * b = b * a)
    {e x : Matrix ι ι F} (hxA : x ∈ A)
    (hxidem : IsIdempotentElem x) (hxe : x * e = x) (hxne : x ≠ e) :
    blockDegree A x < blockDegree A e := by
  have hle : (Subalgebra.toSubmodule A).map (LinearMap.mulRight F x) ≤
      (Subalgebra.toSubmodule A).map (LinearMap.mulRight F e) := by
    intro y hy
    rw [feomegm_mem_block] at hy ⊢
    obtain ⟨a, ha, rfl⟩ := hy
    exact ⟨a * x, Subalgebra.mul_mem A ha hxA, by rw [Matrix.mul_assoc, hxe]⟩
  have hne : (Subalgebra.toSubmodule A).map (LinearMap.mulRight F x) ≠
      (Subalgebra.toSubmodule A).map (LinearMap.mulRight F e) := by
    intro hEq
    have he_in : e ∈ (Subalgebra.toSubmodule A).map (LinearMap.mulRight F e) := by
      rw [feomegm_mem_block]
      exact ⟨1, Subalgebra.one_mem A, by rw [Matrix.one_mul]⟩
    rw [← hEq, feomegm_mem_block] at he_in
    obtain ⟨a, ha, hae⟩ := he_in
    have hxe' : e - x = (a - 1) * x := by
      rw [Matrix.sub_mul, Matrix.one_mul, hae]
    have hzero : x * (e - x) = 0 := by
      rw [Matrix.mul_sub, hxe, hxidem.eq, sub_self]
    have hcommx : x * (a - 1) = (a - 1) * x :=
      hAcomm hxA (Subalgebra.sub_mem A ha (Subalgebra.one_mem A))
    have hcalc : x * (e - x) = e - x := by
      rw [hxe', ← Matrix.mul_assoc, hcommx, Matrix.mul_assoc, hxidem.eq]
    have hzero' : e - x = 0 := by rw [← hcalc, hzero]
    exact hxne (sub_eq_zero.mp hzero').symm
  change Module.finrank F ((Subalgebra.toSubmodule A).map (LinearMap.mulRight F x)) <
    Module.finrank F ((Subalgebra.toSubmodule A).map (LinearMap.mulRight F e))
  exact Submodule.finrank_lt_finrank_of_lt (lt_of_le_of_ne hle hne)

private lemma feomegm_blockDegree_pos {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (A : Subalgebra F (Matrix ι ι F)) {e : Matrix ι ι F} (hne : e ≠ 0) :
    0 < blockDegree A e := by
  have he_mem : e ∈ (Subalgebra.toSubmodule A).map (LinearMap.mulRight F e) := by
    rw [feomegm_mem_block]
    exact ⟨1, Subalgebra.one_mem A, Matrix.one_mul e⟩
  have hntriv : Nontrivial ((Subalgebra.toSubmodule A).map (LinearMap.mulRight F e)) := by
    rw [Submodule.nontrivial_iff_ne_bot]
    intro hbot
    rw [hbot] at he_mem
    exact hne ((Submodule.mem_bot F).mp he_mem)
  exact Module.finrank_pos

private lemma feomegm_isPrimIdemIn (n : ℕ) {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) (hn : 4 ≤ n)
    (S : Set (GL (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F))
    (hSU : ∀ s ∈ S, s ∈ (Spin.spinMatrix (Spin.quadMinus n F bq cq)).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    (hodd : ∀ s ∈ S, Odd (orderOf s))
    {ε : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F}
    (hε : IsPrimAdjIdemIn (RingHom.id F)
      (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq)))
      (Algebra.adjoin F (Units.val '' S)) ε)
    (hdeg : blockDegree (Algebra.adjoin F (Units.val '' S)) ε < 2) :
    IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) ε := by
  classical
  let Q := Spin.quadMinus n F bq cq
  let G := LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)
  let A := Algebra.adjoin F (Units.val '' S)
  have hnd : (QuadraticMap.polarBilin Q).Nondegenerate :=
    Spin.nondegenerate_polarBilin_quadMinus_of_finite n F hirr
  have hG : IsUnit G.det := feomegm_isUnit_det_gram Q hnd
  have hGh : Matrix.transpose (G.map (RingHom.id F)) = G := feomegm_gram_transpose Q
  have hSU' : ∀ s ∈ S, Matrix.transpose ((s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F).map (RingHom.id F)) * G *
      (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) =
      G := fun s hs => feomegm_gram_isometry Q (hSU s hs)
  obtain ⟨e, heprim, hee, hcase⟩ :=
    exists_isPrimIdemIn_of_isPrimAdjIdemIn (RingHom.id F) (fun x => rfl) hG hGh hS hSU' hε
  rcases hcase with heq | ⟨hene, -, -⟩
  · rw [← heq]; exact heprim
  · exfalso
    have hAcomm : ∀ {a b : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
        (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F}, a ∈ A → b ∈ A → a * b = b * a :=
      feomegm_adjoin_comm hS
    have hlt : blockDegree A e < blockDegree A ε :=
      feomegm_blockDegree_lt A hAcomm heprim.1 heprim.2.1 hee hene
    have hdeg' : blockDegree A ε < 2 := hdeg
    have hpos : 0 < blockDegree A e := by
      have he_mem : e ∈ (Subalgebra.toSubmodule A).map (LinearMap.mulRight F e) := by
        rw [feomegm_mem_block]
        exact ⟨1, Subalgebra.one_mem A, Matrix.one_mul e⟩
      have hntriv : Nontrivial ((Subalgebra.toSubmodule A).map (LinearMap.mulRight F e)) := by
        rw [Submodule.nontrivial_iff_ne_bot]
        intro hbot
        rw [hbot] at he_mem
        exact heprim.2.2.1 ((Submodule.mem_bot F).mp he_mem)
      exact Module.finrank_pos
    omega

private lemma feomegm_blockDegree_eq_one (n : ℕ) {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) (hn : 4 ≤ n)
    (S : Set (GL (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F))
    (hSU : ∀ s ∈ S, s ∈ (Spin.spinMatrix (Spin.quadMinus n F bq cq)).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    (hodd : ∀ s ∈ S, Odd (orderOf s))
    {ε : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F}
    (hε : IsPrimAdjIdemIn (RingHom.id F)
      (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq)))
      (Algebra.adjoin F (Units.val '' S)) ε)
    (hdeg : blockDegree (Algebra.adjoin F (Units.val '' S)) ε < 2)
    (hprim : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) ε) :
    blockDegree (Algebra.adjoin F (Units.val '' S)) ε = 1 := by
  classical
  let Q := Spin.quadMinus n F bq cq
  let G := LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)
  let A := Algebra.adjoin F (Units.val '' S)
  have hnd : (QuadraticMap.polarBilin Q).Nondegenerate :=
    Spin.nondegenerate_polarBilin_quadMinus_of_finite n F hirr
  have hG : IsUnit G.det := feomegm_isUnit_det_gram Q hnd
  have hSG : ∀ s ∈ S, Matrix.transpose (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) * G *
      (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) =
      G := fun s hs => by
    simpa only [show (⇑(RingHom.id F) : F → F) = id from rfl, Matrix.map_id] using
      feomegm_gram_isometry Q (hSU s hs)
  have hadj : formAdj (RingHom.id F) G ε = ε := hε.2.2.2.1
  have hdich := blockDegree_eq_one_or_even_of_formAdj_eq hG hS hodd hSG hprim hadj
  rcases hdich with h1 | heven
  · exact h1
  · exfalso
    have heven' : Even (blockDegree A ε) := heven
    obtain ⟨k, hk⟩ := heven'
    have hpos : 0 < blockDegree A ε := feomegm_blockDegree_pos A hprim.2.2.1
    have hlt : blockDegree A ε < 2 := hdeg
    omega

private lemma feomegm_formAdj_inv_mem {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F] [Finite F]
    {G : Matrix ι ι F} (hG : IsUnit G.det) {S : Set (GL ι F)}
    (hSG : ∀ s ∈ S, Matrix.transpose (s : Matrix ι ι F) * G * (s : Matrix ι ι F) = G)
    {a : Matrix ι ι F} (ha : a ∈ Algebra.adjoin F (Units.val '' S)) :
    formAdj (RingHom.id F) G a ∈ Algebra.adjoin F (Units.val '' S) :=
  Geo.formAdj_mem_adjoin (RingHom.id F) hG (by intro s hs; simpa using hSG s hs) ha

private lemma feomegm_block_trivial (n : ℕ) {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) (hn : 4 ≤ n)
    (S : Set (GL (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F))
    (hSU : ∀ s ∈ S, s ∈ (Spin.spinMatrix (Spin.quadMinus n F bq cq)).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    (hodd : ∀ s ∈ S, Odd (orderOf s))
    {ε : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F}
    (hε : IsPrimAdjIdemIn (RingHom.id F)
      (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq)))
      (Algebra.adjoin F (Units.val '' S)) ε)
    (hdeg : blockDegree (Algebra.adjoin F (Units.val '' S)) ε < 2)
    (hprim : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) ε)
    (hdeg1 : blockDegree (Algebra.adjoin F (Units.val '' S)) ε = 1) :
    ∀ s ∈ S, (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) * ε = ε := by
  classical
  let Q := Spin.quadMinus n F bq cq
  let G := LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)
  let A := Algebra.adjoin F (Units.val '' S)
  have hnd : (QuadraticMap.polarBilin Q).Nondegenerate :=
    Spin.nondegenerate_polarBilin_quadMinus_of_finite n F hirr
  have hG : IsUnit G.det := feomegm_isUnit_det_gram Q hnd
  have hSG : ∀ s ∈ S, Matrix.transpose (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) * G *
      (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) =
      G := fun s hs => by
    simpa only [show (⇑(RingHom.id F) : F → F) = id from rfl, Matrix.map_id] using
      feomegm_gram_isometry Q (hSU s hs)
  have hcommP : (Units.val '' S : Set (Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F)).Pairwise Commute := by
    rintro a ⟨s, hs, rfl⟩ b ⟨s', hs', rfl⟩ _
    show (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
        (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) *
        (s' : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
          (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) =
      (s' : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
          (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) *
        (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
          (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F)
    rw [← Units.val_mul, ← Units.val_mul]
    exact congrArg Units.val (hS s hs s' hs').eq
  letI : CommRing A := by
    change CommRing (Algebra.adjoin F (Units.val '' S))
    exact Algebra.adjoinCommRingOfComm F hcommP
  letI : IsMulCommutative A := Algebra.isMulCommutative_adjoin F hcommP
  obtain ⟨K, fieldK, algK, finiteK, π, hπsurj, hπker, hπdeg⟩ := exists_blockField hS hodd hprim
  letI : Field K := fieldK
  letI : Algebra F K := algK
  letI : Finite K := finiteK
  have hfin : Module.finrank F K = 1 := by rw [hπdeg, hdeg1]
  have hspan : Submodule.span F ({1} : Set K) = ⊤ :=
    (finrank_eq_one_iff_of_nonzero (1 : K) one_ne_zero).mp hfin
  let eA : A := ⟨ε, hprim.1⟩
  let gfun : A → A := fun a =>
    ⟨formAdj (RingHom.id F) G (a : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
        (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F),
      feomegm_formAdj_inv_mem hG hSG a.2⟩
  let f : A →ₐ[F] A :=
    { toFun := gfun
      map_one' := Subtype.ext (Geo.formAdj_one (RingHom.id F) hG)
      map_mul' := by
        intro a b
        apply Subtype.ext
        change formAdj (RingHom.id F) G ((a : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) *
            (b : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
              (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F)) =
          formAdj (RingHom.id F) G (a : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
              (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) *
            formAdj (RingHom.id F) G (b : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
              (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F)
        rw [Geo.formAdj_mul (RingHom.id F) hG]
        exact (congrArg Subtype.val (mul_comm' (gfun a) (gfun b))).symm
      map_zero' := Subtype.ext (by
        change formAdj (RingHom.id F) G (0 : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) = 0
        unfold formAdj
        rw [Matrix.map_zero, Matrix.transpose_zero, Matrix.mul_zero, Matrix.zero_mul]
        rfl)
      map_add' := by
        intro a b
        apply Subtype.ext
        change formAdj (RingHom.id F) G ((a : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) +
            (b : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
              (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F)) =
          formAdj (RingHom.id F) G (a : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
              (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) +
            formAdj (RingHom.id F) G (b : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
              (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F)
        rw [Geo.formAdj_add]
      commutes' := by
        intro r
        apply Subtype.ext
        have h1 : ((algebraMap F A) r : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) =
            r • (1 : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
              (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) := by
          change (algebraMap F (Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
              (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F)) r =
            r • (1 : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
              (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F)
          rw [Algebra.algebraMap_eq_smul_one]
        show formAdj (RingHom.id F) G (((algebraMap F A) r) :
            Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
              (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) =
          ((algebraMap F A) r : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
              (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F)
        rw [h1, Geo.formAdj_smul, Geo.formAdj_one (RingHom.id F) hG]
        rfl }
  have htau_e : f eA = eA := by
    change gfun eA = eA
    apply Subtype.ext
    exact hε.2.2.2.1
  have hH : RingHom.ker π ≤ RingHom.ker (π.comp f) := by
    intro a ha
    rw [RingHom.mem_ker] at ha ⊢
    rw [AlgHom.comp_apply]
    rw [hπker (f a), hπker a] at *
    have hxe : (f a) * eA = f (a * eA) := by rw [map_mul, htau_e]
    have h2 : ((f a : A) : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
        (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) * ε =
        ((f (a * eA) : A) : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
          (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) := by
      simpa using congrArg Subtype.val hxe
    rw [h2]
    have hae : a * eA = 0 := by
      rw [← Subtype.coe_inj]
      simpa using ha
    rw [hae, map_zero]
    rfl
  let fK : K →ₐ[F] K := AlgHom.liftOfSurjective π hπsurj (π.comp f) hH
  have hfK : fK = AlgHom.id F K := by
    apply AlgHom.ext
    intro x
    have hx : x ∈ Submodule.span F ({1} : Set K) := by rw [hspan]; trivial
    rw [Submodule.mem_span_singleton] at hx
    obtain ⟨c, hc⟩ := hx
    rw [← hc, map_smul, map_one, AlgHom.id_apply]
  intro s hs
  let sA : A := ⟨(s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F), Algebra.subset_adjoin ⟨s, hs, rfl⟩⟩
  let sAinv : A := ⟨formAdj (RingHom.id F) G (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F),
    feomegm_formAdj_inv_mem hG hSG (Algebra.subset_adjoin ⟨s, hs, rfl⟩)⟩
  have hsA_mul : sA * sAinv = 1 := by
    apply Subtype.ext
    change (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
        (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) *
        formAdj (RingHom.id F) G (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
          (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) = 1
    rw [Geo.formAdj_eq_inv_of_isometry (RingHom.id F) hG s (feomegm_gram_isometry Q (hSU s hs))]
    rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  have hfs : f sA = sAinv := by
    apply Subtype.ext
    rfl
  have h1 : π (f sA) = π sA := by
    have h := AlgHom.congr_fun hfK (π sA)
    rw [show fK (π sA) = π (f sA) from
      AlgHom.liftOfSurjective_apply π hπsurj (π.comp f) hH sA] at h
    simpa using h
  have h2 : π sA = π sAinv := by rw [← h1, hfs]
  have hπinv : π sA * π sAinv = 1 := by rw [← map_mul, hsA_mul, map_one]
  have h3 : π sA * π sA = 1 := by
    have h := hπinv
    rw [← h2] at h
    exact h
  have hsA_pow : sA ^ orderOf s = 1 := by
    apply Subtype.ext
    change (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
        (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) ^ orderOf s = 1
    rw [← Units.val_pow_eq_pow_val, pow_orderOf_eq_one, Units.val_one]
  have h5 : π sA = 1 := by
    obtain ⟨k, hk⟩ := hodd s hs
    have h3' : (π sA) ^ 2 = 1 := by rw [pow_two]; exact h3
    have hpow : (π sA) ^ orderOf s = 1 := by
      rw [← map_pow, hsA_pow, map_one]
    rw [hk, pow_succ, pow_mul, h3', one_pow, one_mul] at hpow
    exact hpow
  have hπzero : π (sA - 1) = 0 := by
    rw [map_sub, map_one, h5, sub_self]
  have hmat : ((sA - 1 : A) : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) * ε = 0 :=
    (hπker (sA - 1)).mp hπzero
  have hse : (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) * ε = ε := by
    rw [Subalgebra.coe_sub, Subalgebra.coe_one, Matrix.sub_mul, Matrix.one_mul] at hmat
    exact sub_eq_zero.mp hmat
  exact hse

private lemma feomegm_polar_single_inl {F : Type} [Field F] {bq cq : F}
    (x : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F) :
    QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq))
      (Pi.single (Sum.inl (0 : Fin 1)) 1) x = x (Sum.inr (Sum.inl 0)) := by
  rw [Spin.polar_quadMinus]
  simp [Fin.sum_univ_one, Pi.single_eq_same, Pi.single_eq_of_ne]

private lemma feomegm_polar_single_inr {F : Type} [Field F] {bq cq : F}
    (x : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F) :
    QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq))
      (Pi.single (Sum.inr (Sum.inl (0 : Fin 1))) 1) x = x (Sum.inl 0) := by
  rw [Spin.polar_quadMinus]
  simp [Fin.sum_univ_one, Pi.single_eq_same, Pi.single_eq_of_ne]

private lemma feomegm_quadMinus_two_apply {F : Type} [Field F] {bq cq : F}
    (x : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F) :
    (Spin.quadMinus 2 F bq cq) x =
      x (Sum.inl 0) * x (Sum.inr (Sum.inl 0)) + x (Sum.inr (Sum.inr 0)) ^ 2 +
        bq * x (Sum.inr (Sum.inr 0)) * x (Sum.inr (Sum.inr 1)) +
          cq * x (Sum.inr (Sum.inr 1)) ^ 2 := by
  rw [Spin.quadMinus_apply]
  simp [Fin.sum_univ_one]

private lemma feomegm_perp_anisotropic {F : Type} [Field F] {bq cq : F}
    (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    {x : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F}
    (hx : x ∈ (CFSG.ClassicalGroups.Orthogonal.minusPair (n := 2) F bq cq
      (0 : Fin 1)).perp) (hx0 : x ≠ 0) :
    (Spin.quadMinus 2 F bq cq) x ≠ 0 := by
  have he : x (Sum.inr (Sum.inl 0)) = 0 := by
    have h : (QuadraticMap.polarBilin (Spin.quadMinus 2 F bq cq))
        (CFSG.ClassicalGroups.Orthogonal.minusPair (n := 2) F bq cq (0 : Fin 1)).e x = 0 :=
      (LinearMap.mem_ker).mpr hx.1
    rw [QuadraticMap.polarBilin_apply_apply,
      show (CFSG.ClassicalGroups.Orthogonal.minusPair (n := 2) F bq cq
        (0 : Fin 1)).e = Pi.single (Sum.inl (0 : Fin 1)) 1
        from rfl, feomegm_polar_single_inl x] at h
    exact h
  have hf : x (Sum.inl 0) = 0 := by
    have h : (QuadraticMap.polarBilin (Spin.quadMinus 2 F bq cq))
        (CFSG.ClassicalGroups.Orthogonal.minusPair (n := 2) F bq cq (0 : Fin 1)).f x = 0 :=
      (LinearMap.mem_ker).mpr hx.2
    rw [QuadraticMap.polarBilin_apply_apply,
      show (CFSG.ClassicalGroups.Orthogonal.minusPair (n := 2) F bq cq (0 : Fin 1)).f =
        Pi.single (Sum.inr (Sum.inl (0 : Fin 1))) 1 from rfl, feomegm_polar_single_inr x] at h
    exact h
  intro hQ0
  have hQ : (Spin.quadMinus 2 F bq cq) x =
      x (Sum.inr (Sum.inr 0)) ^ 2 + bq * x (Sum.inr (Sum.inr 0)) * x (Sum.inr (Sum.inr 1)) +
        cq * x (Sum.inr (Sum.inr 1)) ^ 2 := by
    rw [feomegm_quadMinus_two_apply x, hf, he]
    ring
  rw [hQ] at hQ0
  have ht : x (Sum.inr (Sum.inr 1)) = 0 := by
    by_contra ht
    have h := hirr (x (Sum.inr (Sum.inr 0)) / x (Sum.inr (Sum.inr 1)))
    apply h
    field_simp
    linear_combination hQ0
  have hs : x (Sum.inr (Sum.inr 0)) = 0 := by
    rw [ht] at hQ0
    simpa using hQ0
  exact hx0 (by
    funext y
    rcases y with i | y
    · fin_cases i; exact hf
    · rcases y with j | k
      · fin_cases j; exact he
      · fin_cases k
        · exact hs
        · exact ht)

private lemma feomegm_elementaryGroup_le_commutator_quadMinus_two {F : Type} [Field F] [Finite F]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) :
    CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq) ≤
      ⁅TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq),
        TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq)⁆ := by
  classical
  have hnd := Spin.nondegenerate_polarBilin_quadMinus_of_finite 2 F hirr
  refine CFSG.ClassicalGroups.Orthogonal.elementaryGroup_le_commutator_of_perp_le_span hnd
    (CFSG.ClassicalGroups.Orthogonal.minusPair (n := 2) F bq cq (0 : Fin 1)) ?_
  intro x hx
  by_cases hx0 : x = 0
  · subst hx0; exact Submodule.zero_mem _
  · exact Submodule.subset_span ⟨hx, feomegm_perp_anisotropic hirr hx hx0⟩

private lemma feomegm_commutator_le_elementaryGroup_quadMinus_two {F : Type} [Field F] [Finite F]
    [CharP F 2] {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) :
    ⁅TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq),
      TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq)⁆ ≤
      CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq) :=
  le_of_eq (CFSG.ClassicalGroups.Orthogonal.commutator_orthogonalGroup_quadMinus_of_two_le
    (n := 2) (by norm_num) hirr)

private lemma feomegm_commutator_orthogonalGroup_quadMinus_two {F : Type} [Field F] [Finite F]
    [CharP F 2] {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) :
    ⁅TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq),
      TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq)⁆ =
      CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq) :=
  le_antisymm (feomegm_commutator_le_elementaryGroup_quadMinus_two hirr)
    (feomegm_elementaryGroup_le_commutator_quadMinus_two hirr)

private lemma feomegm_reflect_smul_sq_two {F : Type} [Field F] {bq cq : F}
    {b : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F} {t : F} (ht : t ≠ 0) :
    CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) (t • b) =
      CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) b :=
  CFSG.LieType.Universal.Spin.reflect_smul_of_ne_zero ht b

private lemma feomegm_quadMinus_two_smul_sq_two {F : Type} [Field F] {bq cq : F}
    {b : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F} {t : F} :
    (Spin.quadMinus 2 F bq cq) (t • b) =
      t ^ 2 * (Spin.quadMinus 2 F bq cq) b := by
  rw [QuadraticMap.map_smul, smul_eq_mul, pow_two]

private lemma feomegm_reflect_mul_reflect_mem_of_eq_norm_polar_zero_two {F : Type} [Field F]
    [Finite F] [CharP F 2]
    {bq cq : F} {a b : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F}
    (ha : (Spin.quadMinus 2 F bq cq) a = (Spin.quadMinus 2 F bq cq) b)
    (hb : (Spin.quadMinus 2 F bq cq) b ≠ 0)
    (hpol : QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) a b = 0) :
    CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) a *
        CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) b ∈
      CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq) := by
  obtain ⟨s, hs⟩ := FiniteField.isSquare_of_char_two (ringChar.eq F 2)
    ((Spin.quadMinus 2 F bq cq) a)
  have hs0 : s ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hs
    exact hb (by rw [← ha]; exact hs)
  have hsa : (Spin.quadMinus 2 F bq cq) (s⁻¹ • a) = 1 := by
    rw [QuadraticMap.map_smul, smul_eq_mul, hs]
    field_simp
  have hsb : (Spin.quadMinus 2 F bq cq) (s⁻¹ • b) = 1 := by
    rw [QuadraticMap.map_smul, smul_eq_mul, ← ha, hs]
    field_simp
  have hpol' : QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) (s⁻¹ • a) (s⁻¹ • b) = 0 := by
    simp [hpol]
  have hsum : (s⁻¹ • a) + ((s⁻¹ • a) + (s⁻¹ • b)) = s⁻¹ • b := by
    rw [← add_assoc, CharTwo.add_self_eq_zero, zero_add]
  have hu : (Spin.quadMinus 2 F bq cq) ((s⁻¹ • a) + (s⁻¹ • b)) = 0 := by
    simp [QuadraticMap.map_add, hsa, hsb, hpol', CharTwo.add_self_eq_zero]
  have hua : QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq))
      ((s⁻¹ • a) + (s⁻¹ • b)) (s⁻¹ • a) = 0 := by
    have h1 : QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) (s⁻¹ • a) (s⁻¹ • a) = 0 := by
      rw [QuadraticMap.polar_self, two_nsmul, CharTwo.add_self_eq_zero]
    rw [QuadraticMap.polar_add_left,
      QuadraticMap.polar_comm (⇑(Spin.quadMinus 2 F bq cq)) (s⁻¹ • b) (s⁻¹ • a),
      hpol', h1, zero_add]
  rw [← feomegm_reflect_smul_sq_two (b := a) (inv_ne_zero hs0),
      ← feomegm_reflect_smul_sq_two (b := b) (inv_ne_zero hs0)]
  have hkey := CFSG.ClassicalGroups.Orthogonal.eichler_eq_reflect_mul_reflect
    (Q := Spin.quadMinus 2 F bq cq) (u := (s⁻¹ • a) + (s⁻¹ • b)) (a := s⁻¹ • a)
    (CharP.cast_eq_zero F 2) hu hua hsa
  rw [hsum] at hkey
  rw [← hkey]
  exact CFSG.ClassicalGroups.Orthogonal.eichler_mem_elementaryGroup
    (Spin.quadMinus 2 F bq cq) ((s⁻¹ • a) + (s⁻¹ • b)) (s⁻¹ • a)

private lemma feomegm_reflect_mul_reflect_mem_of_eq_norm_polar_ne_zero_two {F : Type} [Field F]
    [Finite F] [CharP F 2] {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    {a b : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F}
    (ha : (Spin.quadMinus 2 F bq cq) a = (Spin.quadMinus 2 F bq cq) b)
    (hb : (Spin.quadMinus 2 F bq cq) b ≠ 0)
    (hpol : QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) a b ≠ 0) :
    CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) a *
        CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) b ∈
      CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq) := by
  have hnd := Spin.nondegenerate_polarBilin_quadMinus_of_finite 2 F hirr
  have hqa : (Spin.quadMinus 2 F bq cq) a ≠ 0 := by rw [ha]; exact hb
  have ha0 : a ≠ 0 := by rintro rfl; exact hqa (QuadraticMap.map_zero (Spin.quadMinus 2 F bq cq))
  have hb0 : b ≠ 0 := by rintro rfl; exact hb (QuadraticMap.map_zero (Spin.quadMinus 2 F bq cq))
  obtain ⟨g, hgO, hga⟩ := CFSG.StandardType.TableBOrth.exists_orth_apply_eq hnd
    (u := fun _ : Unit => a) (u' := fun _ : Unit => b)
    (by rw [linearIndependent_unique_iff]; exact ha0)
    (by rw [linearIndependent_unique_iff]; exact hb0)
    (fun _ => ha.symm)
    (fun _ _ => by simp [QuadraticMap.polar_self, ha])
  have hga' : g a = b := by simpa using hga ()
  have hconj : g * CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) a * g⁻¹ =
      CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) b := by
    rw [CFSG.ClassicalGroups.Orthogonal.reflect_conj hgO a, hga']
  have hprod : CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) a *
      CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) b =
      CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) a * g *
        (CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) a)⁻¹ * g⁻¹ := by
    rw [← hconj, CFSG.ClassicalGroups.Orthogonal.reflect_inv]
    group
  rw [hprod]
  exact feomegm_commutator_le_elementaryGroup_quadMinus_two hirr
    (Subgroup.commutator_mem_commutator
      (CFSG.ClassicalGroups.Orthogonal.reflect_mem_orthogonalGroup
        (Spin.quadMinus 2 F bq cq) a) hgO)

private lemma feomegm_reflect_mul_reflect_mem_of_eq_norm_two {F : Type} [Field F]
    [Finite F] [CharP F 2] {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    {a b : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F}
    (ha : (Spin.quadMinus 2 F bq cq) a = (Spin.quadMinus 2 F bq cq) b)
    (hb : (Spin.quadMinus 2 F bq cq) b ≠ 0) :
    CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) a *
        CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) b ∈
      CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq) := by
  by_cases hpol : QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) a b = 0
  · exact feomegm_reflect_mul_reflect_mem_of_eq_norm_polar_zero_two ha hb hpol
  · exact feomegm_reflect_mul_reflect_mem_of_eq_norm_polar_ne_zero_two hirr ha hb hpol

private lemma feomegm_reflect_mul_reflect_mem_of_sq_two {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    {a b : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F} (hb : (Spin.quadMinus 2 F bq cq) b ≠ 0)
    {t : F} (ht : t ≠ 0) (h : (Spin.quadMinus 2 F bq cq) a = t ^ 2 * (Spin.quadMinus 2 F bq cq) b) :
    CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) a *
        CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) b ∈
      CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq) := by
  have hb' : (Spin.quadMinus 2 F bq cq) (t • b) ≠ 0 := by
    rw [feomegm_quadMinus_two_smul_sq_two (b := b)]
    exact mul_ne_zero (pow_ne_zero 2 ht) hb
  have heq : (Spin.quadMinus 2 F bq cq) a = (Spin.quadMinus 2 F bq cq) (t • b) := by
    rw [feomegm_quadMinus_two_smul_sq_two (b := b)]
    exact h
  rw [← feomegm_reflect_smul_sq_two (b := b) ht]
  exact feomegm_reflect_mul_reflect_mem_of_eq_norm_two hirr heq hb'

private def feomegm_paired_two {F : Type} [Field F]
    (l : List (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F)) : Prop :=
  ∃ p : List ((Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F) × (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F)),
    l = p.flatMap (fun q => [q.1, q.2])

private lemma feomegm_prod_map_reflect_flatMap_pair_two {F : Type} [Field F] {bq cq : F}
    (p : List ((Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F) × (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F))) :
    (List.map (CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq))
        (List.flatMap (fun q => [q.1, q.2]) p)).prod =
      (List.map (fun q =>
        CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) q.1 *
          CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) q.2) p).prod := by
  induction p with
  | nil => rfl
  | cons q p ih =>
    rw [List.flatMap_cons, List.map_append, List.prod_append, ih]
    simp [mul_assoc]

private lemma feomegm_prod_map_reflect_pair_mem_prod_two {F : Type} [Field F] {bq cq : F}
    (p : List ((Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F) × (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F)))
    (h : ∀ q ∈ p, CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) q.1 *
      CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) q.2 ∈
      CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq)) :
    (List.map (fun q =>
      CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) q.1 *
        CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) q.2) p).prod ∈
      CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq) := by
  induction p with
  | nil => exact Subgroup.one_mem _
  | cons q p ih =>
    rw [List.map_cons, List.prod_cons]
    exact mul_mem (h q (by simp))
      (ih (fun r hr => h r (by simp [hr])))

private lemma feomegm_flatMap_pair_length_two {F : Type} [Field F]
    (p : List ((Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F) × (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F))) :
    (p.flatMap (fun q => [q.1, q.2])).length = 2 * p.length := by
  induction p with
  | nil => rfl
  | cons q p ih =>
    simp only [List.flatMap_cons, List.length_append, List.length_cons, List.length_nil, ih]
    ring

private lemma feomegm_paired_two_even_two {F : Type} [Field F]
    {l : List (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F)} (hp : feomegm_paired_two l) :
    Even l.length := by
  obtain ⟨p, rfl⟩ := hp
  rw [feomegm_flatMap_pair_length_two p]
  exact ⟨p.length, by ring⟩

private lemma feomegm_reflect_exists_norm_one_quadMinus_two {F : Type} [Field F] [Finite F]
    [CharP F 2] {bq cq : F} {v : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F}
    (hv : (Spin.quadMinus 2 F bq cq) v ≠ 0) :
    ∃ v' : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F,
      (Spin.quadMinus 2 F bq cq) v' = 1 ∧
        CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) v' =
          CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) v := by
  obtain ⟨s, hs⟩ := FiniteField.isSquare_of_char_two (ringChar.eq F 2)
    ((Spin.quadMinus 2 F bq cq) v)
  have hs0 : s ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hs
    exact hv hs
  refine ⟨s⁻¹ • v, ?_, ?_⟩
  · rw [QuadraticMap.map_smul, smul_eq_mul, hs]
    field_simp
  · exact feomegm_reflect_smul_sq_two (b := v) (inv_ne_zero hs0)

private lemma feomegm_reflect_mul_reflect_mem_commutator_of_norm_one_quadMinus_two {F : Type}
    [Field F] [Finite F] [CharP F 2] {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    {v w : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F}
    (hv : (Spin.quadMinus 2 F bq cq) v = 1) (hw : (Spin.quadMinus 2 F bq cq) w = 1) :
    CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) v *
        CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) w ∈
      ⁅TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq),
        TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq)⁆ := by
  rw [feomegm_commutator_orthogonalGroup_quadMinus_two hirr]
  exact feomegm_reflect_mul_reflect_mem_of_sq_two hirr (by rw [hw]; exact one_ne_zero)
    one_ne_zero (by rw [hv, hw]; ring)

private lemma feomegm_reflect_mul_reflect_mem_commutator_quadMinus_two {F : Type} [Field F]
    [Finite F] [CharP F 2] {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    {v w : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F}
    (hv : (Spin.quadMinus 2 F bq cq) v ≠ 0) (hw : (Spin.quadMinus 2 F bq cq) w ≠ 0) :
    CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) v *
        CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) w ∈
      ⁅TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq),
        TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq)⁆ := by
  obtain ⟨v', hv', hrv⟩ := feomegm_reflect_exists_norm_one_quadMinus_two hv
  obtain ⟨w', hw', hrw⟩ := feomegm_reflect_exists_norm_one_quadMinus_two hw
  rw [← hrv, ← hrw]
  exact feomegm_reflect_mul_reflect_mem_commutator_of_norm_one_quadMinus_two hirr hv' hw'

private lemma feomegm_prod_map_reflect_mem_commutator_pair_two {F : Type} [Field F] [Finite F]
    [CharP F 2] {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    {a b : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F}
    (ha : (Spin.quadMinus 2 F bq cq) a ≠ 0) (hb : (Spin.quadMinus 2 F bq cq) b ≠ 0) :
    CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) a *
        CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq) b ∈
      ⁅TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq),
        TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq)⁆ :=
  feomegm_reflect_mul_reflect_mem_commutator_quadMinus_two hirr ha hb

private def feomegm_chunk_two {F : Type} [Field F] :
    List (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F) →
      List ((Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F) × (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F))
  | [] => []
  | [_] => []
  | a :: b :: rest => (a, b) :: feomegm_chunk_two rest

private lemma feomegm_chunk_two_flatMap_two {F : Type} [Field F] :
    ∀ (l : List (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F)), Even l.length →
      (feomegm_chunk_two l).flatMap (fun q => [q.1, q.2]) = l
  | [], _ => rfl
  | [_], h => absurd h (by simp)
  | a :: b :: rest, h => by
      show ((a, b) :: feomegm_chunk_two rest).flatMap (fun q => [q.1, q.2]) = a :: b :: rest
      rw [List.flatMap_cons]
      simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
      rw [feomegm_chunk_two_flatMap_two rest (by
        obtain ⟨k, hk⟩ := h
        exact ⟨k - 1, by simp only [List.length_cons] at hk; omega⟩)]
      rfl

private lemma feomegm_paired_two_of_even_two {F : Type} [Field F]
    {l : List (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F)} (heven : Even l.length) :
    feomegm_paired_two l :=
  ⟨feomegm_chunk_two l, (feomegm_chunk_two_flatMap_two l heven).symm⟩

private lemma feomegm_prod_map_reflect_mem_commutator_paired_two {F : Type} [Field F] [Finite F]
    [CharP F 2] {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    {l : List (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F)} (hl : ∀ a ∈ l, (Spin.quadMinus 2 F bq cq) a ≠ 0)
    (hp : feomegm_paired_two l) :
    (List.map (CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq)) l).prod ∈
      ⁅TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq),
        TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq)⁆ := by
  obtain ⟨p, rfl⟩ := hp
  rw [feomegm_prod_map_reflect_flatMap_pair_two p]
  refine (feomegm_commutator_orthogonalGroup_quadMinus_two hirr).symm ▸ ?_
  exact feomegm_prod_map_reflect_pair_mem_prod_two p (fun q hq =>
    (feomegm_commutator_orthogonalGroup_quadMinus_two hirr).symm ▸
      feomegm_prod_map_reflect_mem_commutator_pair_two hirr
        (hl q.1 (by rw [List.mem_flatMap]; exact ⟨q, hq, by simp⟩))
        (hl q.2 (by rw [List.mem_flatMap]; exact ⟨q, hq, by simp⟩)))

private lemma feomegm_prod_map_reflect_mem_commutator_quadMinus_two {F : Type} [Field F] [Finite F]
    [CharP F 2] {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    {l : List (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F)} (hl : ∀ a ∈ l, (Spin.quadMinus 2 F bq cq) a ≠ 0)
    (heven : Even l.length) :
    (List.map (CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq)) l).prod ∈
      ⁅TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq),
        TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq)⁆ :=
  feomegm_prod_map_reflect_mem_commutator_paired_two hirr hl (feomegm_paired_two_of_even_two heven)

private lemma feomegm_prod_map_reflect_paired_two {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    {l : List (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F)} (hl : ∀ a ∈ l, (Spin.quadMinus 2 F bq cq) a ≠ 0)
    (hsq : IsSquare (List.map (⇑(Spin.quadMinus 2 F bq cq)) l).prod)
    (hp : feomegm_paired_two l) :
    (List.map (CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq)) l).prod ∈
      CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq) :=
  feomegm_commutator_le_elementaryGroup_quadMinus_two hirr
    (feomegm_prod_map_reflect_mem_commutator_quadMinus_two hirr hl
      (feomegm_paired_two_even_two hp))

private lemma feomegm_exists_paired_of_even_sq_two {F : Type} [Field F] {bq cq : F}
    {l : List (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F)}
    (hl : ∀ a ∈ l, (Spin.quadMinus 2 F bq cq) a ≠ 0)
    (heven : Even l.length)
    (hsq : IsSquare (List.map (⇑(Spin.quadMinus 2 F bq cq)) l).prod) :
    feomegm_paired_two l :=
  feomegm_paired_two_of_even_two heven

private lemma feomegm_prod_map_reflect_mem_elementary_two {F : Type} [Field F] [Finite F] [CharP F
    2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    {l : List (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F)}
    (hl : ∀ a ∈ l, (Spin.quadMinus 2 F bq cq) a ≠ 0)
    (heven : Even l.length)
    (hsq : IsSquare (List.map (⇑(Spin.quadMinus 2 F bq cq)) l).prod) :
    (List.map (CFSG.ClassicalGroups.Orthogonal.reflect (Spin.quadMinus 2 F bq cq)) l).prod ∈
      CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq) :=
  feomegm_prod_map_reflect_paired_two hirr hl hsq
    (feomegm_exists_paired_of_even_sq_two hl heven hsq)

private lemma feomegm_range_spinAction_le_elementary_two {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) :
    (Spin.spinAction (Spin.quadMinus 2 F bq cq)).range ≤
      CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq) := by
  rintro _ ⟨x, rfl⟩
  obtain ⟨l, hl, heven, hprod, hx⟩ := Spin.exists_list_of_spinGroup x
  rw [hx]
  exact feomegm_prod_map_reflect_mem_elementary_two hirr hl heven
    (by rw [hprod]; exact IsSquare.one)

private def feomegm_hypFrame_vec_two {F : Type} [Field F] (bq cq : F) :
    Fin 1 → Bool → (Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F) :=
  fun _ s => cond s (Pi.single (Sum.inr (Sum.inl (0 : Fin 1))) 1)
    (Pi.single (Sum.inl (0 : Fin 1)) 1)

private lemma feomegm_hypFrame_map_vec_two {F : Type} [Field F] {bq cq : F} :
    ∀ (i : Fin 1) (s : Bool), (Spin.quadMinus 2 F bq cq)
      (feomegm_hypFrame_vec_two (F := F) bq cq i s) = 0 := by
  rintro ⟨⟩ s
  cases s
  · show (Spin.quadMinus 2 F bq cq) (Pi.single (Sum.inl (0 : Fin 1)) (1 : F)) = 0
    rw [feomegm_quadMinus_two_apply]; simp
  · show (Spin.quadMinus 2 F bq cq)
      (Pi.single (Sum.inr (Sum.inl (0 : Fin 1))) (1 : F)) = 0
    rw [feomegm_quadMinus_two_apply]; simp

private lemma feomegm_hypFrame_polar_vec_of_ne_two {F : Type} [Field F] {bq cq : F} :
    ∀ ⦃i j : Fin 1⦄, i ≠ j → ∀ (s t : Bool),
      QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq))
        (feomegm_hypFrame_vec_two (F := F) bq cq i s)
        (feomegm_hypFrame_vec_two (F := F) bq cq j t) = 0 := by
  intro i j h
  exact absurd (Subsingleton.elim i j) h

private lemma feomegm_hypFrame_polar_vec_not_two {F : Type} [Field F] {bq cq : F} :
    ∀ (i : Fin 1) (s : Bool), QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq))
      (feomegm_hypFrame_vec_two (F := F) bq cq i s)
      (feomegm_hypFrame_vec_two (F := F) bq cq i (!s)) = 1 := by
  rintro ⟨⟩ s
  cases s
  · show QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq))
      (Pi.single (Sum.inl (0 : Fin 1)) (1 : F))
      (Pi.single (Sum.inr (Sum.inl (0 : Fin 1))) (1 : F)) = 1
    rw [feomegm_polar_single_inl]; simp
  · show QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq))
      (Pi.single (Sum.inr (Sum.inl (0 : Fin 1))) (1 : F))
      (Pi.single (Sum.inl (0 : Fin 1)) (1 : F)) = 1
    rw [feomegm_polar_single_inr]; simp

private lemma feomegm_hypFrame_exists_aux_two {F : Type} [Field F] {bq cq : F}
    (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) :
    ∀ (i j : Fin 1), ∃ a, IsUnit ((Spin.quadMinus 2 F bq cq) a) ∧
      ∀ (s : Bool), QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq))
        (feomegm_hypFrame_vec_two (F := F) bq cq i s) a = 0 ∧
        QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq))
          (feomegm_hypFrame_vec_two (F := F) bq cq j s) a = 0 := by
  rintro ⟨⟩ ⟨⟩
  refine ⟨Pi.single (Sum.inr (Sum.inr (0 : Fin 2))) (1 : F), ?_, ?_⟩
  · show IsUnit ((Spin.quadMinus 2 F bq cq)
      (Pi.single (Sum.inr (Sum.inr (0 : Fin 2))) (1 : F)))
    rw [feomegm_quadMinus_two_apply]; simp
  · intro s
    have hzero : ∀ (b : Bool), QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq))
        (feomegm_hypFrame_vec_two (F := F) bq cq (0 : Fin 1) b)
        (Pi.single (Sum.inr (Sum.inr (0 : Fin 2))) (1 : F)) = 0 := by
      intro b
      cases b
      · show QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq))
          (Pi.single (Sum.inl (0 : Fin 1)) (1 : F))
          (Pi.single (Sum.inr (Sum.inr (0 : Fin 2))) (1 : F)) = 0
        rw [feomegm_polar_single_inl]; simp
      · show QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq))
          (Pi.single (Sum.inr (Sum.inl (0 : Fin 1))) (1 : F))
          (Pi.single (Sum.inr (Sum.inr (0 : Fin 2))) (1 : F)) = 0
        rw [feomegm_polar_single_inr]; simp
    exact ⟨hzero s, hzero s⟩

private noncomputable def feomegm_hypFrame_quadMinus_two {F : Type} [Field F] [Finite F] {bq cq : F}
    (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) :
    Spin.HypFrame (Spin.quadMinus 2 F bq cq) 1 :=
  Spin.HypFrame.mk (feomegm_hypFrame_vec_two (F := F) bq cq)
    (feomegm_hypFrame_map_vec_two (F := F) (bq := bq) (cq := cq))
    (fun i j h => feomegm_hypFrame_polar_vec_of_ne_two (F := F) (bq := bq) (cq := cq) h)
    (feomegm_hypFrame_polar_vec_not_two (F := F) (bq := bq) (cq := cq))
    (feomegm_hypFrame_exists_aux_two (F := F) (bq := bq) (cq := cq) hirr)

private lemma feomegm_hypFrame_vec_norm_two {F : Type} [Field F] {bq cq : F}
    (Ff : Spin.HypFrame (Spin.quadMinus 2 F bq cq) 1) (i : Fin 1) (s : Bool) :
    (Spin.quadMinus 2 F bq cq) (Ff.vec i s) = 0 :=
  Ff.map_vec i s

private lemma feomegm_root_mem_spinGroup_of_sq_swap_two {F : Type} [Field F] {bq cq : F}
    {u w : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F}
    (hu : (Spin.quadMinus 2 F bq cq) u = 0)
    (hpol : QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) w u = 0)
    (ha : ∃ a, QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) u a = 0 ∧
      QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) w a = 0 ∧
      IsUnit ((Spin.quadMinus 2 F bq cq) a)) :
    ∀ c : F, 1 + c • ((CliffordAlgebra.ι (Spin.quadMinus 2 F bq cq)) w *
      (CliffordAlgebra.ι (Spin.quadMinus 2 F bq cq)) u) ∈
        spinGroup (Spin.quadMinus 2 F bq cq) := by
  obtain ⟨a, hua, hwa, hqa⟩ := ha
  intro c
  exact Spin.one_add_smul_ι_mul_ι_mem_spinGroup (Spin.quadMinus 2 F bq cq)
    hu (by rw [QuadraticMap.polar_comm]; exact hpol) hua hwa hqa c

private lemma feomegm_rootHom_mem_spinGroup_two {F : Type} [Field F] {bq cq : F}
    {u w : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F}
    (hu : (Spin.quadMinus 2 F bq cq) u = 0)
    (hpol : QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) w u = 0)
    (ha : ∃ a, QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) u a = 0 ∧
      QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) w a = 0 ∧
      IsUnit ((Spin.quadMinus 2 F bq cq) a)) :
    ∀ c : F, 1 + c • ((CliffordAlgebra.ι (Spin.quadMinus 2 F bq cq)) w *
      (CliffordAlgebra.ι (Spin.quadMinus 2 F bq cq)) u) ∈
        spinGroup (Spin.quadMinus 2 F bq cq) :=
  feomegm_root_mem_spinGroup_of_sq_swap_two hu hpol ha

private lemma feomegm_eichler_mem_range_two {F : Type} [Field F] [Finite F]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    {u w : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F}
    (hu : (Spin.quadMinus 2 F bq cq) u = 0)
    (hpol : QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) w u = 0)
    (ha : ∃ a, QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) u a = 0 ∧
      QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) w a = 0 ∧
      IsUnit ((Spin.quadMinus 2 F bq cq) a)) :
    CFSG.ClassicalGroups.Orthogonal.eichler (Spin.quadMinus 2 F bq cq) u w ∈
      (Spin.spinAction (Spin.quadMinus 2 F bq cq)).range := by
  have huw : QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) u w = 0 := by
    rw [QuadraticMap.polar_comm]; exact hpol
  refine ⟨Spin.rootHom (Spin.quadMinus 2 F bq cq) hu huw
    (feomegm_rootHom_mem_spinGroup_two hu hpol ha) (Multiplicative.ofAdd (1 : F)), ?_⟩
  rw [Spin.spinAction_rootHom_eq_eichler]
  simp

private lemma feomegm_hypFrame_complement_anisotropic_two {F : Type} [Field F] [Finite F] {bq cq :
    F}
    (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) :
    ∀ (v : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F),
      (∀ (k : Fin 1) (r : Bool),
        QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) v
          ((feomegm_hypFrame_quadMinus_two hirr).vec k r) = 0) →
        (Spin.quadMinus 2 F bq cq) v = 0 → v = 0 := by
  intro v hv hQv
  by_contra hne
  refine absurd hQv (feomegm_perp_anisotropic (bq := bq) (cq := cq) hirr ?_ hne)
  refine Submodule.mem_inf.mpr ⟨LinearMap.mem_ker.mpr ?_, LinearMap.mem_ker.mpr ?_⟩
  · rw [QuadraticMap.polarBilin_apply_apply, QuadraticMap.polar_comm]
    exact hv (0 : Fin 1) false
  · rw [QuadraticMap.polarBilin_apply_apply, QuadraticMap.polar_comm]
    exact hv (0 : Fin 1) true

private lemma feomegm_hypFrame_aux_exists_two {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    (i : Fin 1) (s : Bool) (v : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F)
    (hv : ∀ (k : Fin 1) (r : Bool),
      QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) v
        ((feomegm_hypFrame_quadMinus_two hirr).vec k r) = 0) :
    ∃ a, QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq))
        ((feomegm_hypFrame_quadMinus_two hirr).vec i s) a = 0 ∧
      QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) v a = 0 ∧
      IsUnit ((Spin.quadMinus 2 F bq cq) a) := by
  obtain ⟨a₀, ha₀, ha₀pol⟩ := (feomegm_hypFrame_quadMinus_two hirr).exists_aux i i
  by_cases hv0 : (Spin.quadMinus 2 F bq cq) v = 0
  · refine ⟨a₀, (ha₀pol s).1, ?_, ha₀⟩
    have hvz : v = 0 := feomegm_hypFrame_complement_anisotropic_two hirr v hv hv0
    rw [hvz]; simp
  · exact ⟨v, (by rw [QuadraticMap.polar_comm]; exact hv i s),
      (by rw [QuadraticMap.polar_self, two_smul]; exact CharTwo.add_self_eq_zero _),
      isUnit_iff_ne_zero.mpr hv0⟩

private lemma feomegm_hypFrame_eichler_mem_range_two {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) :
    ∀ (i : Fin 1) (s : Bool) (v : Fin 1 ⊕ Fin 1 ⊕ Fin 2 → F),
      (∀ (k : Fin 1) (r : Bool),
        QuadraticMap.polar (⇑(Spin.quadMinus 2 F bq cq)) v
          ((feomegm_hypFrame_quadMinus_two hirr).vec k r) = 0) →
        CFSG.ClassicalGroups.Orthogonal.eichler (Spin.quadMinus 2 F bq cq)
          ((feomegm_hypFrame_quadMinus_two hirr).vec i s) v ∈
          Subgroup.map (Spin.spinAction (Spin.quadMinus 2 F bq cq)) ⊤ := by
  intro i s v hv
  rw [Subgroup.map_top]
  exact feomegm_eichler_mem_range_two hirr
    (feomegm_hypFrame_vec_norm_two (feomegm_hypFrame_quadMinus_two hirr) i s) (hv i s)
    (feomegm_hypFrame_aux_exists_two hirr i s v hv)

private lemma feomegm_elementaryGroup_le_range_spinAction_two {F : Type} [Field F] [Finite F]
    [CharP F 2] {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) :
    CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq) ≤
      (Spin.spinAction (Spin.quadMinus 2 F bq cq)).range :=
  (Spin.HypFrame.elementaryGroup_le_map_spinAction (feomegm_hypFrame_quadMinus_two hirr)
    (fun hij => absurd (Subsingleton.elim _ _) hij)
    (feomegm_hypFrame_eichler_mem_range_two hirr)
    (feomegm_hypFrame_complement_anisotropic_two hirr)).trans
    (le_of_eq (Subgroup.map_top _))

private lemma feomegm_range_spinAction_quadMinus_two {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) :
    (Spin.spinAction (Spin.quadMinus 2 F bq cq)).range =
      CFSG.ClassicalGroups.Orthogonal.elementaryGroup (Spin.quadMinus 2 F bq cq) :=
  le_antisymm (feomegm_range_spinAction_le_elementary_two hirr)
    (feomegm_elementaryGroup_le_range_spinAction_two hirr)

private lemma feomegm_spin_omega_iso {F : Type} [Field F] [Finite F] [CharP F 2] {bq cq : F}
    (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) :
    Nonempty (↥(spinGroup (Spin.quadMinus 2 F bq cq)) ≃*
      ↥(CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus 2 F bq cq))) := by
  have hker : (Spin.spinMatrix (Spin.quadMinus 2 F bq cq)).ker = ⊥ :=
    Spin.ker_spinMatrix_quadMinus_eq_bot hirr (CharP.cast_eq_zero F 2)
  have hinj : Function.Injective (Spin.spinMatrix (Spin.quadMinus 2 F bq cq)) :=
    (MonoidHom.ker_eq_bot_iff _).mp hker
  have hrange : (Spin.spinMatrix (Spin.quadMinus 2 F bq cq)).range =
      CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus 2 F bq cq) :=
    Spin.range_spinMatrix_eq_statedOmega (Spin.coe_quadMinus 2 F bq cq)
      (feomegm_commutator_orthogonalGroup_quadMinus_two hirr)
      (feomegm_range_spinAction_quadMinus_two hirr)
  exact ⟨(MonoidHom.ofInjective hinj).trans (MulEquiv.subgroupCongr hrange)⟩

private lemma feomegm_aux_commutator_spin_iso_two {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) :
    Nonempty (↥⁅TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq),
        TauCeti.QuadraticMap.orthogonalGroup (Spin.quadMinus 2 F bq cq)⁆ ≃*
      ↥(spinGroup (Spin.quadMinus 2 F bq cq))) := by
  obtain ⟨e⟩ := feomegm_spin_omega_iso (F := F) (bq := bq) (cq := cq) hirr
  exact ⟨(e.trans (CFSG.LocalAnalysis.WeakClosure81.statedOmegaEquivDerived
    (Spin.coe_quadMinus 2 F bq cq))).symm⟩

private noncomputable def feomegm_aux_orthogonalGroup_extend_two
    {R V : Type} [CommRing R] [AddCommGroup V] [Module R V] {Q : QuadraticForm R V}
    {W : Submodule R V} (hW : IsCompl W (LinearMap.BilinForm.orthogonal Q.polarBilin W)) :
    ↥(TauCeti.QuadraticMap.orthogonalGroup (Q.restrict W)) →*
      ↥(TauCeti.QuadraticMap.orthogonalGroup Q) :=
  let P := LinearMap.BilinForm.orthogonal Q.polarBilin W
  let dI : ((Q.restrict W).prod (Q.restrict P)).IsometryEquiv Q :=
    QuadraticMap.IsometryEquiv.prodRestrictOrthogonal Q W hW
  let dL : (W × P) ≃ₗ[R] V := dI.toLinearEquiv
  let xof : ↥(TauCeti.QuadraticMap.orthogonalGroup (Q.restrict W)) →*
      ↥(TauCeti.QuadraticMap.orthogonalGroup ((Q.restrict W).prod (Q.restrict P))) :=
    (QuadraticMap.orthogonalGroupProd (Q.restrict W) (Q.restrict P)).comp (MonoidHom.inl _ _)
  let Φlin : ↥(TauCeti.QuadraticMap.orthogonalGroup (Q.restrict W)) →* (V ≃ₗ[R] V) :=
    { toFun := fun a => dL.symm.trans (((xof a : (W × P) ≃ₗ[R] (W × P))).trans dL)
      map_one' := by
        apply LinearEquiv.ext
        intro v
        show dL ((xof 1 : (W × P) ≃ₗ[R] (W × P)) (dL.symm v)) = v
        rw [show xof 1 = 1 from map_one xof]
        simp
      map_mul' := by
        intro a b
        apply LinearEquiv.ext
        intro v
        rw [show xof (a * b) = xof a * xof b from map_mul xof a b]
        simp [LinearEquiv.trans_apply, LinearEquiv.mul_apply] }
  Φlin.codRestrict (TauCeti.QuadraticMap.orthogonalGroup Q) (by
    intro a
    rw [TauCeti.QuadraticMap.mem_orthogonalGroup_iff]
    intro v
    have hx := TauCeti.QuadraticMap.mem_orthogonalGroup_iff.mp (xof a).2
    change Q (dI ((xof a : (W × P) ≃ₗ[R] (W × P)) (dI.toLinearEquiv.symm v))) = Q v
    rw [dI.map_app, hx (dI.toLinearEquiv.symm v)]
    exact dI.symm.map_app v)

private lemma feomegm_aux_orthogonalGroup_extend_apply
    {R V : Type} [CommRing R] [AddCommGroup V] [Module R V] {Q : QuadraticForm R V}
    {W : Submodule R V} (hW : IsCompl W (LinearMap.BilinForm.orthogonal Q.polarBilin W))
    (a : ↥(TauCeti.QuadraticMap.orthogonalGroup (Q.restrict W))) (v : V) :
    ((feomegm_aux_orthogonalGroup_extend_two hW a : V ≃ₗ[R] V) v) =
      (QuadraticMap.IsometryEquiv.prodRestrictOrthogonal Q W hW)
        (((QuadraticMap.orthogonalGroupProd (Q.restrict W)
            (Q.restrict (LinearMap.BilinForm.orthogonal Q.polarBilin W))).comp
            (MonoidHom.inl _ _) a : (W × LinearMap.BilinForm.orthogonal Q.polarBilin W) ≃ₗ[R]
              (W × LinearMap.BilinForm.orthogonal Q.polarBilin W))
          ((QuadraticMap.IsometryEquiv.prodRestrictOrthogonal Q W hW).symm v)) := by
  rfl

private lemma feomegm_polar_eq_dot {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (Q : QuadraticForm F (ι → F)) (x y : ι → F) :
    QuadraticMap.polar Q x y =
      dotProduct x ((LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)).mulVec y) := by
  have h1 : (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)) =
      LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin Q) := rfl
  rw [h1]
  rw [← Matrix.toBilin'_apply' (LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin Q)) x y,
    Matrix.toBilin'_toMatrix', QuadraticMap.polarBilin_apply_apply]

private lemma feomegm_dotProduct_mulVec_transpose {ι F : Type} [Fintype ι] [CommSemiring F]
    (M : Matrix ι ι F) (x y : ι → F) :
    dotProduct (M.mulVec x) y = dotProduct x (M.transpose.mulVec y) := by
  exact ((Matrix.dotProduct_mulVec x M.transpose y).trans
    (by rw [Matrix.vecMul_transpose])).symm

private lemma feomegm_formAdj_id {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (G a : Matrix ι ι F) : formAdj (RingHom.id F) G a = G⁻¹ * a.transpose * G := by
  unfold formAdj
  rw [show a.map (⇑(RingHom.id F)) = a from by ext i j; rfl]

private lemma feomegm_formAdj_mulVec {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    {G a : Matrix ι ι F} (hG : IsUnit G.det) (y : ι → F) :
    G.mulVec ((formAdj (RingHom.id F) G a).mulVec y) = a.transpose.mulVec (G.mulVec y) := by
  have hmat : G * (G⁻¹ * a.transpose * G) = a.transpose * G := by
    rw [← Matrix.mul_assoc G (G⁻¹ * a.transpose) G,
      ← Matrix.mul_assoc G G⁻¹ a.transpose, Matrix.mul_nonsing_inv G hG, Matrix.one_mul]
  rw [feomegm_formAdj_id, Matrix.mulVec_mulVec, hmat, Matrix.mulVec_mulVec]

private lemma feomegm_formAdj_apply {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (Q : QuadraticForm F (ι → F))
    (hG : IsUnit (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)).det)
    (a : Matrix ι ι F) (x y : ι → F) :
    QuadraticMap.polar Q (a.mulVec x) y =
      QuadraticMap.polar Q x ((formAdj (RingHom.id F)
        (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)) a).mulVec y) := by
  rw [feomegm_polar_eq_dot Q, feomegm_polar_eq_dot Q,
    feomegm_dotProduct_mulVec_transpose a x
      ((LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)).mulVec y),
    feomegm_formAdj_mulVec hG y]

private lemma feomegm_aux_block_perp_eq_ker_two (n : ℕ) {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    (S : Set (GL (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F))
    {ε : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F}
    (hε : IsPrimAdjIdemIn (RingHom.id F)
      (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq)))
      (Algebra.adjoin F (Units.val '' S)) ε) :
    LinearMap.BilinForm.orthogonal (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq))
        (LinearMap.range (Matrix.mulVecLin ε)) =
      LinearMap.ker (Matrix.mulVecLin ε) := by
  set G := LinearMap.toMatrix₂' F (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq)) with hGdef
  have hnd := Spin.nondegenerate_polarBilin_quadMinus_of_finite n F hirr
  have hG : IsUnit G.det := feomegm_isUnit_det_gram (Spin.quadMinus n F bq cq) hnd
  have hself : formAdj (RingHom.id F) G ε = ε := hε.2.2.2.1
  ext x
  rw [LinearMap.BilinForm.mem_orthogonal_iff, LinearMap.mem_ker, Matrix.mulVecLin_apply]
  constructor
  · intro hx
    refine CFSG.ClassicalGroups.Orthogonal.eq_zero_of_polar_eq_zero hnd fun y => ?_
    rw [QuadraticMap.polar_comm]
    have h1 : QuadraticMap.polar (Spin.quadMinus n F bq cq) (ε.mulVec y) x = 0 := by
      have h2 := hx (ε.mulVec y) ⟨y, by rw [Matrix.mulVecLin_apply]⟩
      rwa [QuadraticMap.polarBilin_apply_apply] at h2
    rw [← h1, feomegm_formAdj_apply (Spin.quadMinus n F bq cq) hG ε y x, hself]
  · intro hx n' hn'
    obtain ⟨y, hy⟩ := hn'
    rw [← hy, Matrix.mulVecLin_apply, QuadraticMap.polarBilin_apply_apply,
      feomegm_formAdj_apply (Spin.quadMinus n F bq cq) hG ε y x, hself, hx]
    simp

private lemma feomegm_aux_block_isCompl_two (n : ℕ) {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    (S : Set (GL (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F))
    {ε : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F}
    (hε : IsPrimAdjIdemIn (RingHom.id F)
      (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq)))
      (Algebra.adjoin F (Units.val '' S)) ε) :
    IsCompl (LinearMap.range (Matrix.mulVecLin ε))
      (LinearMap.BilinForm.orthogonal (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq))
        (LinearMap.range (Matrix.mulVecLin ε))) := by
  rw [feomegm_aux_block_perp_eq_ker_two n hirr S hε]
  refine ⟨?_, ?_⟩
  · rw [Submodule.disjoint_def]
    intro x hx hx'
    obtain ⟨y, rfl⟩ := hx
    simp only [LinearMap.mem_ker, Matrix.mulVecLin_apply] at hx'
    rw [show ε.mulVec (ε.mulVec y) = (ε * ε).mulVec y from
      Matrix.mulVec_mulVec y ε ε, hε.2.1.eq] at hx'
    simpa only [Matrix.mulVecLin_apply] using hx'
  · rw [codisjoint_iff, Submodule.eq_top_iff']
    intro x
    rw [Submodule.mem_sup]
    refine ⟨Matrix.mulVecLin ε x, ⟨x, rfl⟩, x - Matrix.mulVecLin ε x, ?_, ?_⟩
    · rw [LinearMap.mem_ker]
      simp only [Matrix.mulVecLin_apply, Matrix.mulVec_sub]
      rw [show ε.mulVec (ε.mulVec x) = (ε * ε).mulVec x from
        Matrix.mulVec_mulVec x ε ε, hε.2.1.eq, sub_self]
    · abel

private lemma feomegm_aux_blockAction_comm_two (n : ℕ) {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) (hn : 4 ≤ n)
    (S : Set (GL (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F))
    (hSU : ∀ s ∈ S, s ∈ (Spin.spinMatrix (Spin.quadMinus n F bq cq)).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    (hodd : ∀ s ∈ S, Odd (orderOf s))
    {ε : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F}
    (hε : IsPrimAdjIdemIn (RingHom.id F)
      (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq)))
      (Algebra.adjoin F (Units.val '' S)) ε)
    (htriv : ∀ s ∈ S, (s : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) * ε = ε)
    (hrank : ε.rank = 4)
    (hminus : ∀ x y : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F, Matrix.mulVec ε x = x → Matrix.mulVec ε
      y = y →
      (Spin.quadMinus n F bq cq) x = 0 → (Spin.quadMinus n F bq cq) y = 0 → QuadraticMap.polar
      (Spin.quadMinus n F bq cq) x y = 0 → ¬ LinearIndependent F ![x, y])
    (u : ↥(glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε)) :
    (Spin.spinMatrix (Spin.quadMinus n F bq cq) u.1 :
          Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
        (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) * ε =
      ε * (Spin.spinMatrix (Spin.quadMinus n F bq cq) u.1 :
        Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F) := by
  have hu := u.2
  simp only [glBlockCentralizer, Subgroup.mem_comap, Subgroup.mem_inf] at hu
  obtain ⟨hcent, -⟩ := hu
  have hsub : (Units.val '' S : Set (Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F)) ⊆
      Subalgebra.centralizer F ({(Spin.spinMatrix (Spin.quadMinus n F bq cq) u.1 :
        Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F)} :
