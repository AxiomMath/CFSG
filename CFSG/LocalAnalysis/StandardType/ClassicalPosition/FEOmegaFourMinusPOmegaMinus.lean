private lemma feomegm_component_eq (n : ℕ) {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0)
    (S : Set (GL (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F))
    {ε : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F}
    {J' : Subgroup ↥(spinGroup (Spin.quadMinus n F bq cq))}
    (hJε : IsComponentOf J'
      ⁅glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε, glBlockCentralizer
      (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε⁆)
    (hcomm : Nonempty (↥⁅glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε,
      glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε⁆ ≃*
      ↥(CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus 2 F bq cq)))) :
    J' = ⁅glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε, glBlockCentralizer
      (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε⁆ := by
  let H := ⁅glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε,
    glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε⁆
  obtain ⟨φ⟩ := hcomm
  have hsmall :=
      CFSG.ComponentClassification.RankTwoClassical.isSimpleGroup_statedOmega_quadMinus_small
    (K := F) (n := 2) (Or.inl rfl) (b := bq) (c := cq) hirr
  haveI : IsSimpleGroup ↥(CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus 2 F bq cq)) := hsmall.1
  have hSq : CFSG.Open.IsQuasisimple ↥(CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus 2 F bq cq))
      := by
    refine ⟨hsmall.2.1, ?_⟩
    have hcenter : Subgroup.center
        ↥(CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus 2 F bq cq)) = ⊥ :=
      TauCeti.IsSimpleGroup.center_eq_bot_of_not_isMulCommutative
        (by simpa only [isMulCommutative_iff] using hsmall.2.2)
    exact MulEquiv.isSimpleGroup
      ((QuotientGroup.quotientMulEquivOfEq hcenter).trans QuotientGroup.quotientBot)
  have hHq : CFSG.Open.IsQuasisimple H := CFSG.Open.IsQuasisimple.of_mulEquiv φ hSq
  have hsub : CFSG.Open.IsSubnormal (J'.subgroupOf H) ⊤ :=
    CFSG.Open.IsSubnormal.of_mathlib (CFSG.Assembly.IsSubnormal.subgroupOf hJε.2.1)
  haveI : Group.IsPerfect J' := ⟨hJε.2.2.1⟩
  haveI : Group.IsPerfect (J'.subgroupOf H) :=
    Group.IsPerfect.ofSurjective (f := (Subgroup.subgroupOfEquivOfLe hJε.1).symm.toMonoidHom)
      (Subgroup.subgroupOfEquivOfLe hJε.1).symm.surjective
  rcases CFSG.ComponentClassification.Quasisimple.perfect_subnormal_eq_bot_or_eq_top
    hHq (J'.subgroupOf H) hsub with hbot | htop
  · exfalso
    have hJ'bot : J' = ⊥ := by
      have hdisj : Disjoint J' H := Subgroup.subgroupOf_eq_bot.mp hbot
      rwa [disjoint_iff, inf_eq_left.mpr hJε.1] at hdisj
    have hnt : Nontrivial J' := CFSG.ComponentClassification.Quasisimple.nontrivial hJε.2.2
    rw [hJ'bot] at hnt
    exact not_nontrivial_iff_subsingleton.mpr inferInstance hnt
  · exact le_antisymm hJε.1 (Subgroup.subgroupOf_eq_top.mp htop)

private lemma feomegm_isOmegaMinus (n : ℕ) {F : Type} [Field F] [Finite F] [CharP F 2]
    {bq cq : F} (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) (hn : 4 ≤ n) (f : ℕ)
    (hc : Nat.card F = 2 ^ f)
    (S : Set (GL (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F))
    {ε : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
            (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F}
    {J' : Subgroup ↥(spinGroup (Spin.quadMinus n F bq cq))}
    (hJε : IsComponentOf J'
      ⁅glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε, glBlockCentralizer
      (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε⁆)
    (hcomm : Nonempty (↥⁅glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε,
      glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε⁆ ≃*
      ↥(CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus 2 F bq cq))))
    (hJeq : J' = ⁅glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε,
      glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε⁆) :
    CFSG.LocalAnalysis.UniquenessCase.PartTwo.IsOmegaMinus
      (↥J' ⧸ Subgroup.center ↥J') 4 f := by
  refine ⟨by norm_num, F, inferInstance, inferInstance, bq, cq, hc, hirr, ?_⟩
  let G : Subgroup ↥(spinGroup (Spin.quadMinus n F bq cq)) :=
    ⁅glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε,
      glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε⁆
  have hJeq' : J' = G := hJeq
  rw [hJeq']
  obtain ⟨φ⟩ := hcomm
  have hsmall :=
      CFSG.ComponentClassification.RankTwoClassical.isSimpleGroup_statedOmega_quadMinus_small
    (K := F) (n := 2) (Or.inl rfl) (b := bq) (c := cq) hirr
  haveI : IsSimpleGroup ↥(CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus 2 F bq cq)) := hsmall.1
  have hcenter : Subgroup.center
      ↥(CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus 2 F bq cq)) = ⊥ :=
    TauCeti.IsSimpleGroup.center_eq_bot_of_not_isMulCommutative
      (by simpa only [isMulCommutative_iff] using hsmall.2.2)
  have hne : ∃ v, CFSG.Open.StatedQuadMinus 2 F bq cq v ≠ 0 := by
    refine ⟨Pi.single (Sum.inr (Sum.inr (0 : Fin 2))) 1, ?_⟩
    rw [← CFSG.LieType.Universal.Spin.coe_quadMinus]
    rw [feomegm_quadMinus_two_apply]
    simp
  have hproj : CFSG.Open.StatedProj (CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus 2 F bq cq)) ≃*
      ↥(CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus 2 F bq cq)) :=
    CFSG.SeitzReduction.SymplecticPilot.statedProjOmegaEquiv
      (Q := Spin.quadMinus 2 F bq cq) (Q₀ := CFSG.Open.StatedQuadMinus 2 F bq cq)
      (CFSG.LieType.Universal.Spin.coe_quadMinus 2 F bq cq) hne
  exact ⟨(QuotientGroup.congr (Subgroup.center G)
      (Subgroup.center ↥(CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus 2 F bq cq))) φ
      (Subgroup.map_center_eq φ)).trans
    ((QuotientGroup.quotientMulEquivOfEq hcenter).trans
      (QuotientGroup.quotientBot.trans hproj.symm))⟩

private lemma feomegm_quotientCenter {U X : Type} [Group U] [Group X] (ψ : U →* X)
    (hψ : ψ.ker ≤ Subgroup.center U) {J' : Subgroup U}
    (hperf : _root_.commutator ↥J' = ⊤) :
    Nonempty (↥J' ⧸ Subgroup.center ↥J' ≃*
      ↥(J'.map ψ) ⧸ Subgroup.center ↥(J'.map ψ)) := by
  let fmap : ↥J' →* ↥(J'.map ψ) :=
    (ψ.comp J'.subtype).codRestrict (J'.map ψ) (fun x => Subgroup.mem_map_of_mem ψ x.2)
  have hf : Function.Surjective fmap := by
    intro y
    obtain ⟨x, hx, hxy⟩ := Subgroup.mem_map.mp y.2
    exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩
  have hkerf : fmap.ker ≤ Subgroup.center ↥J' := by
    intro x hx
    rw [MonoidHom.mem_ker] at hx
    rw [Subgroup.mem_center_iff]
    intro y
    have hx1 : (x : U) ∈ ψ.ker := by
      rw [MonoidHom.mem_ker]
      have h := congrArg (fun z : ↥(J'.map ψ) => (z : X)) hx
      simpa [fmap] using h
    have hxc := hψ hx1
    apply Subtype.ext
    simpa using (Subgroup.mem_center_iff.mp hxc (y : U))
  haveI : Group.IsPerfect ↥J' := ⟨hperf⟩
  have hcen : Subgroup.center (↥J' ⧸ fmap.ker) =
      (Subgroup.center ↥J').map (QuotientGroup.mk' fmap.ker) :=
    (CFSG.ComponentClassification.Quasisimple.center_map_of_central_kernel
      (QuotientGroup.mk' fmap.ker) (QuotientGroup.mk'_surjective fmap.ker)
      (by rwa [QuotientGroup.ker_mk'])).symm
  let e1 : ↥J' ⧸ fmap.ker ≃* ↥(J'.map ψ) := QuotientGroup.quotientKerEquivOfSurjective fmap hf
  let e2 : ↥(J'.map ψ) ⧸ Subgroup.center ↥(J'.map ψ) ≃*
      (↥J' ⧸ fmap.ker) ⧸ Subgroup.center (↥J' ⧸ fmap.ker) :=
    QuotientGroup.congr (Subgroup.center ↥(J'.map ψ)) (Subgroup.center (↥J' ⧸ fmap.ker))
      e1.symm (Subgroup.map_center_eq e1.symm)
  exact ⟨(e2.trans ((QuotientGroup.quotientMulEquivOfEq hcen).trans
    (QuotientGroup.quotientQuotientEquivQuotient _ _ hkerf))).symm⟩

theorem ggSixLSevenFieldExtCase_omegaFourMinus_POmegaMinus (n : ℕ) {F : Type} [Field F]
    {bq cq : F}
    (hirr : ∀ s : F, s ^ 2 + bq * s + cq ≠ 0) (hn : 4 ≤ n) (f : ℕ) (hc : Nat.card F = 2 ^ f)
    {X : Type} [Group X] [Finite X] (ψ : ↥(spinGroup (Spin.quadMinus n F bq cq)) →* X)
    (hψ : ψ.ker ≤ Subgroup.center _)
    (S : Set (GL (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F))
    (hSU : ∀ s ∈ S, s ∈ (Spin.spinMatrix (Spin.quadMinus n F bq cq)).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    (hodd : ∀ s ∈ S, Odd (orderOf s)) {J' : Subgroup ↥(spinGroup (Spin.quadMinus n F bq cq))}
    {ε : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) F}
    (hε : IsPrimAdjIdemIn (RingHom.id F)
      (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin (Spin.quadMinus n F bq cq)))
      (Algebra.adjoin F (Units.val '' S)) ε)
    (hJε : IsComponentOf J'
      ⁅glBlockCentralizer (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε, glBlockCentralizer
      (Spin.spinMatrix (Spin.quadMinus n F bq cq)) S ε⁆)
    (hdeg : blockDegree (Algebra.adjoin F (Units.val '' S)) ε < 2) (hrank : ε.rank = 4)
    (hminus : ∀ x y : Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2 → F, Matrix.mulVec ε x = x → Matrix.mulVec ε
      y = y →
      (Spin.quadMinus n F bq cq) x = 0 → (Spin.quadMinus n F bq cq) y = 0 → QuadraticMap.polar
      (Spin.quadMinus n F bq cq) x y = 0 → ¬ LinearIndependent F ![x, y]) :
    GGSixLSevenFieldExtCase (J'.map ψ) .POmegaMinus f := by
  classical
  have hcard_ne : Nat.card F ≠ 0 := by
    rw [hc]; exact pow_ne_zero f (by norm_num)
  haveI : Finite F := Nat.finite_of_card_ne_zero hcard_ne
  haveI : CharP F 2 := by
    letI : Fintype F := Fintype.ofFinite F
    exact charP_of_card_eq_prime_pow (p := 2) (f := f)
      (by rw [← Nat.card_eq_fintype_card]; exact hc)
  have hf : 1 ≤ f := by
    by_contra h
    have hf0 : f = 0 := by omega
    rw [hf0, pow_zero] at hc
    have h2 : 2 ≤ Nat.card F := by
      letI : Fintype F := Fintype.ofFinite F
      rw [Nat.card_eq_fintype_card]
      exact Nat.succ_le_of_lt Fintype.one_lt_card
    omega
  have hprim := feomegm_isPrimIdemIn n hirr hn S hSU hS hodd hε hdeg
  have hdeg1 := feomegm_blockDegree_eq_one n hirr hn S hSU hS hodd hε hdeg hprim
  have htriv := feomegm_block_trivial n hirr hn S hSU hS hodd hε hdeg hprim hdeg1
  have hcomm := feomegm_blockGroup_commutator n hirr hn S hSU hS hodd hε htriv hrank hminus
  have hJeq := feomegm_component_eq n hirr S hJε hcomm
  have hO : CFSG.LocalAnalysis.UniquenessCase.PartTwo.IsOmegaMinus
      (↥J' ⧸ Subgroup.center ↥J') 4 f :=
    feomegm_isOmegaMinus n hirr hn f hc S hJε hcomm hJeq
  have hL2 : CFSG.LocalAnalysis.UniquenessCase.UC22.IsL2
      (↥J' ⧸ Subgroup.center ↥J') (2 * f) :=
    CFSG.LocalAnalysis.UniquenessCase.PartTwo.S18.isL2_of_isOmegaMinus_four hf hO
  obtain ⟨ξ⟩ := feomegm_quotientCenter ψ hψ hJε.2.2.1
  have hL2' : LieModel (↥(J'.map ψ) ⧸ Subgroup.center ↥(J'.map ψ)) .PSL 2 2 (2 * f) :=
    CFSG.Blueprint.LieModel.of_mulEquiv ξ
      (show LieModel (↥J' ⧸ Subgroup.center ↥J') .PSL 2 2 (2 * f) from hL2)
  exact ⟨.PSL, 2, 2 * f, by omega, hL2', by rintro ⟨-, -, h | h⟩ <;> exact absurd h (by decide)⟩

