        (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm
        (bmDPS_J n f) (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inr c')) =
        bmDPS_glueBcJ s f (Fin.cast hr' c) (Fin.cast hr' c') := by
  set eidx := bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr' with heidx
  have h_inr_inr_inl : ∀ (c : Fin r') (u : Fin s),
      finSumFinEquiv.symm (finCongr (hr'.trans (two_mul s)) c) = Sum.inl u →
      eidx (Sum.inr (Sum.inr c)) = Sum.inl (finCongr hrs (Fin.natAdd r u)) := by
    intro c u hc
    simp only [heidx, bmDPS_glueEidx, bmDPS_gluePerm, Equiv.trans_apply, Equiv.sumCongr_apply,
      Equiv.coe_fn_mk, Sum.map_inl, Sum.map_inr, hc, finSumFinEquiv_apply_right]
  have h_inr_inr_inr : ∀ (c : Fin r') (v : Fin s),
      finSumFinEquiv.symm (finCongr (hr'.trans (two_mul s)) c) = Sum.inr v →
      eidx (Sum.inr (Sum.inr c)) = Sum.inr (finCongr hrs (Fin.natAdd r v)) := by
    intro c v hc
    simp only [heidx, bmDPS_glueEidx, bmDPS_gluePerm, Equiv.trans_apply, Equiv.sumCongr_apply,
      Equiv.coe_fn_mk, Sum.map_inl, Sum.map_inr, hc, finSumFinEquiv_apply_right]
  intro c c'
  simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm]
  rw [bmDPS_glueBcJ_apply_cast s f hr' c c']
  rcases hc : finSumFinEquiv.symm (Fin.cast (hr'.trans (two_mul s)) c) with u | v
  · rcases hc' : finSumFinEquiv.symm (Fin.cast (hr'.trans (two_mul s)) c') with u' | v'
    · simp only [h_inr_inr_inl c u hc, h_inr_inr_inl c' u' hc', hc, hc']
      simp [bmDPS_J, Matrix.fromBlocks]
    · simp only [h_inr_inr_inl c u hc, h_inr_inr_inr c' v' hc', hc, hc']
      have hXY : (finCongr hrs (Fin.natAdd r u) : Fin n) = finCongr hrs (Fin.natAdd r v') ↔
          u = v' := by
        constructor
        · intro h; exact (bmDPS_natAdd_inj_iff u v').mp ((finCongr hrs).injective h)
        · intro h; rw [h]
      simp only [bmDPS_J, Matrix.fromBlocks_apply₁₂, Matrix.one_apply, hXY]
  · rcases hc' : finSumFinEquiv.symm (Fin.cast (hr'.trans (two_mul s)) c') with u' | v'
    · simp only [h_inr_inr_inr c v hc, h_inr_inr_inl c' u' hc', hc, hc']
      have hXY : (finCongr hrs (Fin.natAdd r v) : Fin n) = finCongr hrs (Fin.natAdd r u') ↔
          v = u' := by
        constructor
        · intro h; exact (bmDPS_natAdd_inj_iff v u').mp ((finCongr hrs).injective h)
        · intro h; rw [h]
      simp only [bmDPS_J, Matrix.fromBlocks_apply₂₁, Matrix.neg_apply, Matrix.one_apply, hXY]
    · simp only [h_inr_inr_inr c v hc, h_inr_inr_inr c' v' hc', hc, hc']
      simp [bmDPS_J, Matrix.fromBlocks]

private theorem bmDPS_glue_index
    (n f r s : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))

    (hrs : r + s = n)   (hr1 : 1 ≤ r) :
    ∃ (R r' : ℕ) (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
      (hR : R + 1 = r) (hr' : r' = 2 * s),
      bmDPS_IsFormStandard n f (R + 1) r' eidx ∧
      (∀ c c' : Fin r',
        Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr (Sum.inr c))
          (Sum.inr (Sum.inr c')) = bmDPS_glueBcJ s f (Fin.cast hr' c) (Fin.cast hr' c')) := by
  have hR0 : r - 1 + 1 = r := by omega
  refine ⟨r - 1, 2 * s,
    bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR0 rfl,
    hR0, rfl, ?_, ?_⟩
  · exact bmDPS_glueEidx_form n f r s Pe Bc hrs hR0 rfl
  · exact bmDPS_glueEidx_bc n f r s Pe Bc hrs hR0 rfl

private noncomputable def bmDPS_glueP (n f : ℕ) {r s R r' : ℕ}
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hR : R + 1 = r) (hr' : r' = 2 * s) :
    Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f) :=
  Matrix.of fun i k =>
    match eidx.symm k with
    | Sum.inl a => Pe i (Sum.inl (Fin.cast hR a))
    | Sum.inr (Sum.inl b) => Pe i (Sum.inr (Fin.cast hR b))
    | Sum.inr (Sum.inr c) =>
        Bc i (finSumFinEquiv.symm (Fin.cast (hr'.trans (two_mul s)) c))

private theorem bmDPS_submatrix_id_symm_conj {m n : Type*}
    [Fintype n] {F : Type} [CommSemiring F]
    (e : m ≃ n) (Q : Matrix n m F) (J : Matrix n n F) :
    Matrix.transpose (Q.submatrix id e.symm) * J * Q.submatrix id e.symm =
      Matrix.reindex e e (Matrix.transpose Q * J * Q) := by
  ext i j
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.submatrix_apply,
    Matrix.reindex_apply, id_eq]

private theorem bmDPS_glueP_symplectic (n f r s : ℕ)
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeJ : Matrix.transpose Pe * bmDPS_J n f * Pe = bmDPS_J r f)
    (hBcJ : Matrix.transpose Bc * bmDPS_J n f * Bc = bmDPS_J s f)
    (horth : Matrix.transpose Pe * bmDPS_J n f * Bc = 0)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hR : R + 1 = r) (hr' : r' = 2 * s)
    (hBcBlock : ∀ c c' : Fin r',
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr (Sum.inr c))
        (Sum.inr (Sum.inr c')) = bmDPS_glueBcJ s f (Fin.cast hr' c) (Fin.cast hr' c')) :
    Matrix.transpose (bmDPS_glueP n f eidx Pe Bc hR hr') * bmDPS_J n f *
      bmDPS_glueP n f eidx Pe Bc hR hr' = bmDPS_J n f := by
  set Q : Matrix (Fin n ⊕ Fin n) (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
    Matrix.of (fun i k => match k with
      | Sum.inl a => Pe i (Sum.inl (Fin.cast hR a))
      | Sum.inr (Sum.inl b) => Pe i (Sum.inr (Fin.cast hR b))
      | Sum.inr (Sum.inr c) =>
          Bc i (finSumFinEquiv.symm (Fin.cast (hr'.trans (two_mul s)) c))) with hQ
  have hglueP : bmDPS_glueP n f eidx Pe Bc hR hr' = Q.submatrix id eidx.symm := by
    ext i k
    simp [bmDPS_glueP, hQ]
  have horth' : Matrix.transpose Bc * bmDPS_J n f * Pe = 0 := by
    have h := congrArg Matrix.transpose horth
    simp only [Matrix.transpose_mul, Matrix.transpose_transpose, bmDPS_J_transpose,
      Matrix.transpose_zero] at h
    simpa only [Matrix.mul_assoc] using h
  have hQQ : Matrix.transpose Q * bmDPS_J n f * Q =
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) := by
    ext i j
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c')
    · rw [hJ.2.1 a a']
      have hL : (Matrix.transpose Q * bmDPS_J n f * Q) (Sum.inl a) (Sum.inl a') =
          (Matrix.transpose Pe * bmDPS_J n f * Pe) (Sum.inl (Fin.cast hR a))
            (Sum.inl (Fin.cast hR a')) := by simp [hQ, Matrix.mul_apply]
      rw [hL, hPeJ]
      simp [bmDPS_J, Matrix.fromBlocks]
    · rw [hJ.2.2.2.2.2.2.2 a b']
      have hL : (Matrix.transpose Q * bmDPS_J n f * Q) (Sum.inl a) (Sum.inr (Sum.inl b')) =
          (Matrix.transpose Pe * bmDPS_J n f * Pe) (Sum.inl (Fin.cast hR a))
            (Sum.inr (Fin.cast hR b')) := by simp [hQ, Matrix.mul_apply]
      rw [hL, hPeJ]
      have hcast : ((Fin.cast hR a : Fin r) = Fin.cast hR b') ↔ a = b' :=
        (Fin.cast_injective hR).eq_iff
      simp only [bmDPS_J, Matrix.fromBlocks_apply₁₂, Matrix.one_apply, hcast]
    · rw [hJ.2.2.2.1 a c']
      have hL : (Matrix.transpose Q * bmDPS_J n f * Q) (Sum.inl a) (Sum.inr (Sum.inr c')) =
          (Matrix.transpose Pe * bmDPS_J n f * Bc) (Sum.inl (Fin.cast hR a))
            (finSumFinEquiv.symm (Fin.cast (hr'.trans (two_mul s)) c')) := by
        simp [hQ, Matrix.mul_apply]
      rw [hL, horth]
      simp
    · rw [bmDPS_J'_symm n f (R + 1) r' eidx (Sum.inr (Sum.inl b)) (Sum.inl a'),
        hJ.2.2.2.2.2.2.2 a' b]
      have hL : (Matrix.transpose Q * bmDPS_J n f * Q) (Sum.inr (Sum.inl b)) (Sum.inl a') =
          (Matrix.transpose Pe * bmDPS_J n f * Pe) (Sum.inr (Fin.cast hR b))
            (Sum.inl (Fin.cast hR a')) := by simp [hQ, Matrix.mul_apply]
      rw [hL, hPeJ]
      have hcast : ((Fin.cast hR b : Fin r) = Fin.cast hR a') ↔ b = a' :=
        (Fin.cast_injective hR).eq_iff
      simp only [bmDPS_J, Matrix.fromBlocks_apply₂₁, Matrix.neg_apply, Matrix.one_apply,
        CharTwo.neg_eq, hcast, eq_comm]
    · rw [hJ.2.2.1 b b']
      have hL : (Matrix.transpose Q * bmDPS_J n f * Q) (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inl b'))
          =
          (Matrix.transpose Pe * bmDPS_J n f * Pe) (Sum.inr (Fin.cast hR b))
            (Sum.inr (Fin.cast hR b')) := by simp [hQ, Matrix.mul_apply]
      rw [hL, hPeJ]
      simp [bmDPS_J, Matrix.fromBlocks]
    · rw [hJ.2.2.2.2.2.1 b c']
      have hL : (Matrix.transpose Q * bmDPS_J n f * Q) (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inr c'))
          =
          (Matrix.transpose Pe * bmDPS_J n f * Bc) (Sum.inr (Fin.cast hR b))
            (finSumFinEquiv.symm (Fin.cast (hr'.trans (two_mul s)) c')) := by
        simp [hQ, Matrix.mul_apply]
      rw [hL, horth]
      simp
    · rw [hJ.2.2.2.2.1 c a']
      have hL : (Matrix.transpose Q * bmDPS_J n f * Q) (Sum.inr (Sum.inr c)) (Sum.inl a') =
          (Matrix.transpose Bc * bmDPS_J n f * Pe)
            (finSumFinEquiv.symm (Fin.cast (hr'.trans (two_mul s)) c))
            (Sum.inl (Fin.cast hR a')) := by simp [hQ, Matrix.mul_apply]
      rw [hL, horth']
      simp
    · rw [hJ.2.2.2.2.2.2.1 c b']
      have hL : (Matrix.transpose Q * bmDPS_J n f * Q) (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inl b'))
          =
          (Matrix.transpose Bc * bmDPS_J n f * Pe)
            (finSumFinEquiv.symm (Fin.cast (hr'.trans (two_mul s)) c))
            (Sum.inr (Fin.cast hR b')) := by simp [hQ, Matrix.mul_apply]
      rw [hL, horth']
      simp
    · rw [hBcBlock c c']
      have hL : (Matrix.transpose Q * bmDPS_J n f * Q) (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inr c'))
          =
          (Matrix.transpose Bc * bmDPS_J n f * Bc)
            (finSumFinEquiv.symm (Fin.cast (hr'.trans (two_mul s)) c))
            (finSumFinEquiv.symm (Fin.cast (hr'.trans (two_mul s)) c')) := by
        simp [hQ, Matrix.mul_apply]
      rw [hL, hBcJ, bmDPS_glueBcJ_apply_cast]
  calc Matrix.transpose (bmDPS_glueP n f eidx Pe Bc hR hr') * bmDPS_J n f *
        bmDPS_glueP n f eidx Pe Bc hR hr'
      = Matrix.transpose (Q.submatrix id eidx.symm) * bmDPS_J n f * Q.submatrix id eidx.symm := by
        rw [hglueP]
    _ = Matrix.reindex eidx eidx (Matrix.transpose Q * bmDPS_J n f * Q) :=
        bmDPS_submatrix_id_symm_conj eidx Q (bmDPS_J n f)
    _ = Matrix.reindex eidx eidx (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) := by rw [hQQ]
    _ = bmDPS_J n f := bmDPS_reindex_comp_symm f eidx.symm (bmDPS_J n f)

private theorem bmDPS_glueP_estar_mul_Bc (n f s : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hBcε : (1 - bmDPS_eps n f e) * Bc = Bc)
    (hee : e * e = e) (horth_e : e * bmDPS_estar n f e = 0) :
    e * Bc = 0 := by
  have hepsBc : bmDPS_eps n f e * Bc = 0 := by
    have h := hBcε
    rw [Matrix.sub_mul, Matrix.one_mul] at h
    have h2 : Bc = Bc + bmDPS_eps n f e * Bc := by
      calc Bc = (Bc - bmDPS_eps n f e * Bc) + bmDPS_eps n f e * Bc := by abel
        _ = Bc + bmDPS_eps n f e * Bc := by rw [h]
    exact add_left_cancel (h2.symm.trans (add_zero Bc).symm)
  have h1 : e * Bc = bmDPS_estar n f e * Bc := by
    rw [bmDPS_eps, Matrix.add_mul] at hepsBc
    have h := eq_neg_of_add_eq_zero_left hepsBc
    rw [h]
    ext i j
    simp only [Matrix.neg_apply, CharTwo.neg_eq]
  calc e * Bc = e * (e * Bc) := by rw [← Matrix.mul_assoc, hee]
    _ = e * (bmDPS_estar n f e * Bc) := by rw [h1]
    _ = (e * bmDPS_estar n f e) * Bc := by rw [Matrix.mul_assoc]
    _ = 0 := by rw [horth_e, Matrix.zero_mul]

private noncomputable def bmDPS_glueQ (n f : ℕ) {r s R r' : ℕ}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hR : R + 1 = r) (hr' : r' = 2 * s) :
    Matrix (Fin n ⊕ Fin n) (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
  Matrix.of fun i k =>
    match k with
    | Sum.inl a => Pe i (Sum.inl (Fin.cast hR a))
    | Sum.inr (Sum.inl b) => Pe i (Sum.inr (Fin.cast hR b))
    | Sum.inr (Sum.inr c) =>
        Bc i (finSumFinEquiv.symm (Fin.cast (hr'.trans (two_mul s)) c))

private theorem bmDPS_glueP_eq_glueQ (n f r s : ℕ)
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hR : R + 1 = r) (hr' : r' = 2 * s) :
    bmDPS_glueP n f eidx Pe Bc hR hr' =
      (bmDPS_glueQ n f Pe Bc hR hr').submatrix id eidx.symm := by
  ext i k
  simp [bmDPS_glueP, bmDPS_glueQ, Matrix.submatrix_apply, Matrix.of_apply]

private theorem bmDPS_glueP_e_mul_glueQ (n f r s : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (heBc : e * Bc = 0)
    {R r' : ℕ} (hR : R + 1 = r) (hr' : r' = 2 * s) :
    e * bmDPS_glueQ n f Pe Bc hR hr' =
      bmDPS_glueQ n f Pe Bc hR hr' * bmDPS_D0 (R + 1) r' (GaloisField 2 f) := by
  ext i l
  rcases l with a | (b | c)
  · have hL : (e * bmDPS_glueQ n f Pe Bc hR hr') i (Sum.inl a) =
        (e * Pe) i (Sum.inl (Fin.cast hR a)) := by
      simp [bmDPS_glueQ, Matrix.mul_apply]
    have hD : (bmDPS_glueQ n f Pe Bc hR hr' * bmDPS_D0 (R + 1) r' (GaloisField 2 f))
        i (Sum.inl a) = bmDPS_glueQ n f Pe Bc hR hr' i (Sum.inl a) := by
      rw [Matrix.mul_apply, Fintype.sum_sum_type]
      simp [bmDPS_glueQ, bmDPS_D0, Matrix.fromBlocks, Matrix.mul_apply, Matrix.one_apply,
        Fintype.sum_sum_type, Finset.sum_ite_eq]
    rw [hL, hD, hPee]
    simp [bmDPS_glueQ, Matrix.fromBlocks, Matrix.mul_apply, Matrix.one_apply,
      Fintype.sum_sum_type, Finset.sum_ite_eq]
  · have hL : (e * bmDPS_glueQ n f Pe Bc hR hr') i (Sum.inr (Sum.inl b)) =
        (e * Pe) i (Sum.inr (Fin.cast hR b)) := by
      simp [bmDPS_glueQ, Matrix.mul_apply]
    have hD : (bmDPS_glueQ n f Pe Bc hR hr' * bmDPS_D0 (R + 1) r' (GaloisField 2 f))
        i (Sum.inr (Sum.inl b)) = 0 := by
      rw [Matrix.mul_apply, Fintype.sum_sum_type]
      simp [bmDPS_glueQ, bmDPS_D0, Matrix.fromBlocks, Matrix.mul_apply]
    rw [hL, hD, hPee]
    simp [Matrix.fromBlocks, Matrix.mul_apply, Matrix.one_apply, Matrix.zero_apply,
      Fintype.sum_sum_type]
  · have hL : (e * bmDPS_glueQ n f Pe Bc hR hr') i (Sum.inr (Sum.inr c)) =
        (e * Bc) i (finSumFinEquiv.symm (Fin.cast (hr'.trans (two_mul s)) c)) := by
      simp [bmDPS_glueQ, Matrix.mul_apply]
    have hD : (bmDPS_glueQ n f Pe Bc hR hr' * bmDPS_D0 (R + 1) r' (GaloisField 2 f))
        i (Sum.inr (Sum.inr c)) = 0 := by
      rw [Matrix.mul_apply, Fintype.sum_sum_type]
      simp [bmDPS_glueQ, bmDPS_D0, Matrix.fromBlocks, Matrix.mul_apply]
    rw [hL, hD, heBc]
    simp

private theorem bmDPS_glueP_e_mul_glueP (n f r s : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (heBc : e * Bc = 0)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hR : R + 1 = r) (hr' : r' = 2 * s) :
    e * bmDPS_glueP n f eidx Pe Bc hR hr' =
      bmDPS_glueP n f eidx Pe Bc hR hr' *
        Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) := by
  rw [bmDPS_glueP_eq_glueQ n f r s Pe Bc eidx hR hr']
  rw [show e * (bmDPS_glueQ n f Pe Bc hR hr').submatrix id eidx.symm =
      (e * bmDPS_glueQ n f Pe Bc hR hr').submatrix id eidx.symm from by
    ext i k
    simp only [Matrix.mul_apply, Matrix.submatrix_apply, id_eq]]
  rw [bmDPS_glueP_e_mul_glueQ n f r s Pe Bc hPee heBc hR hr']
  rw [Matrix.reindex_apply]
  exact (Matrix.submatrix_mul_equiv (bmDPS_glueQ n f Pe Bc hR hr')
    (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) id eidx.symm eidx.symm).symm

private theorem bmDPS_glueP_conj (n f r s : ℕ) {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n)
    (GaloisField 2 f)}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f)) (hBcε : (1 - bmDPS_eps n f e) *
        Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) (hee : e * e = e) (horth_e : e * bmDPS_estar n
          f e = 0)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hR : R + 1 = r) (hr' : r' = 2 * s)
    (hP : Matrix.transpose (bmDPS_glueP n f eidx Pe Bc hR hr') * bmDPS_J n f *
      bmDPS_glueP n f eidx Pe Bc hR hr' = bmDPS_J n f) :
    bmDPS_glueP n f eidx Pe Bc hR hr' *
      Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) *
      ((bmDPS_J n f)⁻¹ * Matrix.transpose (bmDPS_glueP n f eidx Pe Bc hR hr') * bmDPS_J n f) = e :=
          by
  have heBc : e * Bc = 0 := bmDPS_glueP_estar_mul_Bc n f s Bc hBcε hee horth_e
  have heG : e * (bmDPS_glueP n f eidx Pe Bc hR hr') =
      (bmDPS_glueP n f eidx Pe Bc hR hr') *
        Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) :=
    bmDPS_glueP_e_mul_glueP n f r s Pe Bc hPee heBc eidx hR hr'
  have hGG : (bmDPS_glueP n f eidx Pe Bc hR hr') *
      ((bmDPS_J n f)⁻¹ * Matrix.transpose (bmDPS_glueP n f eidx Pe Bc hR hr') * bmDPS_J n f) = 1 :=
    (bmDPS_symplectic_inv n f (bmDPS_glueP n f eidx Pe Bc hR hr') hP).1
  calc (bmDPS_glueP n f eidx Pe Bc hR hr') *
        Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) *
        ((bmDPS_J n f)⁻¹ * Matrix.transpose (bmDPS_glueP n f eidx Pe Bc hR hr') * bmDPS_J n f)
      = (e * (bmDPS_glueP n f eidx Pe Bc hR hr')) *
          ((bmDPS_J n f)⁻¹ * Matrix.transpose (bmDPS_glueP n f eidx Pe Bc hR hr') * bmDPS_J n f) :=
              by
        rw [heG]
    _ = e * ((bmDPS_glueP n f eidx Pe Bc hR hr') *
          ((bmDPS_J n f)⁻¹ * Matrix.transpose (bmDPS_glueP n f eidx Pe Bc hR hr') * bmDPS_J n f)) :=
              by
        rw [Matrix.mul_assoc]
    _ = e * 1 := by rw [hGG]
    _ = e := by rw [Matrix.mul_one]

private theorem bmDPS_glue_symplectic_data
    (n f r s : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeJ : Matrix.transpose Pe * bmDPS_J n f * Pe = bmDPS_J r f)
    (hBcJ : Matrix.transpose Bc * bmDPS_J n f * Bc = bmDPS_J s f)
    (horth : Matrix.transpose Pe * bmDPS_J n f * Bc = 0)
    (hBcε : (1 - bmDPS_eps n f e) * Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hR : R + 1 = r) (hr' : r' = 2 * s)
    (hBcBlock : ∀ c c' : Fin r',
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr (Sum.inr c))
        (Sum.inr (Sum.inr c')) = bmDPS_glueBcJ s f (Fin.cast hr' c) (Fin.cast hr' c'))
    (hee : e * e = e) (horth_e : e * bmDPS_estar n f e = 0) :
    ∃ (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)),
      P * Pinv = 1 ∧ Pinv * P = 1 ∧
        Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f ∧
        Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e := by
  let G := bmDPS_glueP n f eidx Pe Bc hR hr'
  have hG : Matrix.transpose G * bmDPS_J n f * G = bmDPS_J n f :=
    bmDPS_glueP_symplectic n f r s Pe Bc hPeJ hBcJ horth eidx hJ hR hr' hBcBlock
  refine ⟨(bmDPS_J n f)⁻¹ * Matrix.transpose G * bmDPS_J n f, G, ?_, ?_, ?_, ?_⟩
  · exact (bmDPS_symplectic_inv n f G hG).2.1
  · exact (bmDPS_symplectic_inv n f G hG).1
  · exact (bmDPS_symplectic_inv n f G hG).2.2
  · exact bmDPS_glueP_conj n f r s Pe Bc hBcε hPee hee horth_e eidx hR hr' hG

private theorem bmDPS_glue_standard_basis
    (n f r s : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeJ : Matrix.transpose Pe * bmDPS_J n f * Pe = bmDPS_J r f)
    (hBcJ : Matrix.transpose Bc * bmDPS_J n f * Bc = bmDPS_J s f)
    (horth : Matrix.transpose Pe * bmDPS_J n f * Bc = 0)

    (hBcε : (1 - bmDPS_eps n f e) * Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))

    (hspanPe : ∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmDPS_eps n f e) x)

    (hrs : r + s = n)   (hε : bmDPS_eps n f e ≠ 0)
    (hee : e * e = e) (horth_e : e * bmDPS_estar n f e = 0) :
    ∃ (R r' : ℕ) (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
      (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
      (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
      (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
      (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx),
      0 ≤ R ∧ Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e := by
  obtain hr1 := bmDPS_glue_pos n f r s Pe (e := e) hspanPe hrs hε
  obtain ⟨R, r', eidx, hR, hr', hJ, hBcBlock⟩ :=
    bmDPS_glue_index n f r s Pe Bc (e := e) hrs hr1
  obtain ⟨P, Pinv, hPP, hPinvP, hP, hconv⟩ :=
    bmDPS_glue_symplectic_data n f r s Pe Bc hPeJ hBcJ horth hBcε hPee eidx hJ hR hr' hBcBlock hee
        horth_e
  exact ⟨R, r', eidx, P, Pinv, hPP, hPinvP, hP, hJ, Nat.zero_le R, hconv⟩

private theorem bmDPS_explicit_data
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (horth : e * bmDPS_estar n f e = 0) (horth' : bmDPS_estar n f e * e = 0)
    (heps : IsIdempotentElem (bmDPS_eps n f e))
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e)) :
    ∃ (R r' : ℕ) (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
      (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
      (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
      (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
      (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx),
      0 ≤ R ∧ Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e := by
  obtain ⟨r, s, Pe, Bc, hPeJ, hBcJ, horthPB, hPeε, hBcε, hPee, hPees, hspanPe, hspanBc, hrs,
    he0⟩ :=
    bmDPS_adapted_decomposition n f S he horth horth'
      heps hestar
  have hε : bmDPS_eps n f e ≠ 0 := by
    intro hzero
    apply he0
    have h := congrArg (fun M => M * e) hzero
    rw [Matrix.zero_mul] at h
    rw [bmDPS_eps, Matrix.add_mul, he.2.1.eq, horth', add_zero] at h
    exact h
  exact bmDPS_glue_standard_basis n f r s Pe Bc hPeJ hBcJ horthPB hBcε hPee hspanPe hrs hε he.2.1.eq
      horth

private theorem bmDPS_component_le_embed

    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hJe : IsComponentOf J' (bmDPS_range n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e) :
    J' ≤ (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).range := by
  exact le_trans hJe.1
    (bmDPS_range_le_embedHom n f S he eidx hPP hPinvP hP hJ hconv)

private theorem bmDPS_component_sl2_card_quot

    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hJe : IsComponentOf J' (bmDPS_range n f S e)) :
    60 ≤ Nat.card (J' ⧸ Subgroup.center J') := by
  have hq : CFSG.IsQuasisimple J' :=
    (CFSG.Foundations.SteinbergCA.quasisimple_iff J').2.1.mpr hJe.2.2
  exact CFSG.Quasithin.S146zW.sw_sixty_le_card_quot hq

private theorem bmDPS_component_sl2_card_le

    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hJe : IsComponentOf J' (bmDPS_range n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hR : R + 1 = 2) :
    Nat.card (J' ⧸ Subgroup.center J') ≤ Nat.card (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2
        f)) := by
  have hcomp := bmDPS_component_le_embed n f S he hJe eidx hPP hPinvP hP hJ hconv
  let φ : J' → Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) :=
    fun x => (MonoidHom.mem_range.mp (hcomp x.2)).choose
  have hφ : Function.Injective φ := by
    intro x y hxy
    apply Subtype.ext
    have hx := (MonoidHom.mem_range.mp (hcomp x.2)).choose_spec
    have hy := (MonoidHom.mem_range.mp (hcomp y.2)).choose_spec
    rw [← hx, ← hy]
    exact congrArg _ hxy
  have h1 : Nat.card (J' ⧸ Subgroup.center J') ≤ Nat.card J' :=
    Nat.card_le_card_of_surjective (QuotientGroup.mk' (Subgroup.center J'))
      (QuotientGroup.mk'_surjective (Subgroup.center J'))
  have h2 : Nat.card J' ≤
      Nat.card (Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :=
    Nat.card_le_card_of_injective φ hφ
  rw [hR] at h2
  exact le_trans h1 h2

private theorem bmDPS_component_sl2_card_field

    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hJe : IsComponentOf J' (bmDPS_range n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hR : R + 1 = 2) :
    4 ≤ Nat.card (GaloisField 2 f) := by
  have h60 := bmDPS_component_sl2_card_quot n f S hJe
  have hle := bmDPS_component_sl2_card_le n f S he hJe eidx hPP hPinvP hP hJ hconv hR
  have hcard : Nat.card (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 f)) =
      Nat.card (GaloisField 2 f) * (Nat.card (GaloisField 2 f) ^ 2 - 1) :=
    CFSG.RankThree.PartOne.KFOUT3.card_sl2 (GaloisField 2 f)
  set n := Nat.card (GaloisField 2 f) with hn
  have h60' : 60 ≤ n * (n ^ 2 - 1) := by
    calc 60 ≤ Nat.card (J' ⧸ Subgroup.center J') := h60
      _ ≤ Nat.card (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 f)) := hle
      _ = n * (n ^ 2 - 1) := hcard
  have hpos : 0 < n := by rw [hn]; exact Nat.card_pos
  by_contra hlt
  push_neg at hlt
  interval_cases n <;> omega

private theorem bmDPS_component_sl2_card

    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hJe : IsComponentOf J' (bmDPS_range n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hR : R + 1 = 2) :
        (∃ s : Finset (GaloisField 2 f), s.card = 4) := by
  have h4 : 4 ≤ Nat.card (GaloisField 2 f) :=
    bmDPS_component_sl2_card_field n f S he hJe eidx hPP hPinvP hP hJ hconv hR
  classical
  haveI : Fintype (GaloisField 2 f) := Fintype.ofFinite _
  obtain ⟨s, -, hs⟩ := Finset.exists_subset_card_eq (s := (Finset.univ : Finset (GaloisField 2 f)))
    (n := 4) (by simpa [Finset.card_univ, Nat.card_eq_fintype_card] using h4)
  exact ⟨s, hs⟩

private theorem bmDPS_component_perfect_SL

    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hJe : IsComponentOf J' (bmDPS_range n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e) :
        Group.IsPerfect (Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) := by
  rcases lt_or_ge (R + 1) 3 with hlt | hge
  · have hcases : R + 1 = 1 ∨ R + 1 = 2 := by omega
    rcases hcases with hR1 | hR2
    · haveI : Subsingleton (Fin (R + 1)) := Fin.subsingleton_iff_le_one.mpr (by omega)
      exact Group.IsPerfect.mk (Subsingleton.elim _ _)
    · obtain ⟨s, hs⟩ := bmDPS_component_sl2_card n f S he hJe eidx hPP hPinvP hP hJ hconv hR2
      exact CFSG.LinearGroups.special_linear_isPerfect (K := GaloisField 2 f) (n := R + 1)
        (by omega) (Or.inr ⟨s, hs⟩)
  · exact CFSG.LinearGroups.special_linear_dimension_at_least_three_perfect
      (K := GaloisField 2 f) (n := R + 1) hge

private theorem bmDPS_component_embed_le_range

    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e))
    (hgen : bmDPS_scalarAction n f S e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hJe : IsComponentOf J' (bmDPS_range n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e) :
    (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).range ≤ bmDPS_range n f S e := by
  exact bmDPS_embedHom_range_le n f S hS he
    hestar hgen eidx hPP hPinvP hP hJ hconv
    (bmDPS_component_perfect_SL n f S he hJe eidx hPP hPinvP hP hJ hconv)

private theorem bmDPS_assembly_isSubnormal_open {G : Type*} [Group G] {H K : Subgroup G}
    (h : CFSG.Assembly.IsSubnormal H K) : CFSG.Open.IsSubnormal H K :=
  CFSG.Assembly.IsSubnormal.rec
    (motive := fun H K _ => CFSG.Open.IsSubnormal H K)
    (fun H => CFSG.Open.IsSubnormal.refl H)
    (fun hHM hnorm _ ih => CFSG.Open.IsSubnormal.step hHM hnorm ih) h

private theorem bmDPS_component_range_quasisimple

    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e))
    (hgen : bmDPS_scalarAction n f S e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hJe : IsComponentOf J' (bmDPS_range n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e) :
    CFSG.Open.IsQuasisimple ↥(bmDPS_range n f S e) := by
  have hRg : bmDPS_range n f S e =
      (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).range :=
    le_antisymm
      (bmDPS_range_le_embedHom n f S he eidx hPP hPinvP hP hJ hconv)
      (bmDPS_component_embed_le_range n f S hS he hestar hgen hJe eidx hPP hPinvP hP hJ hconv)
  have hRpos : 1 ≤ R := by
    by_contra hR0
    have hR1 : R + 1 = 1 := by omega
    haveI : Subsingleton (Fin (R + 1)) := Fin.subsingleton_iff_le_one.mpr (by omega)
    have hbot : bmDPS_range n f S e = ⊥ := by
      rw [hRg, MonoidHom.range_eq_bot_iff]
      ext x
      rw [Subsingleton.elim x 1]
      simp
    have hJ'bot : J' = ⊥ := le_bot_iff.mp (hbot ▸ hJe.1)
    have hntJ' : Nontrivial ↥J' := by
      haveI : Nontrivial (↥J' ⧸ Subgroup.center ↥J') := hJe.2.2.2.toNontrivial
      exact Function.Surjective.nontrivial (QuotientGroup.mk'_surjective (Subgroup.center ↥J'))
    haveI : Nontrivial ↥J' := hntJ'
    exact not_subsingleton ↥J' (by rw [hJ'bot]; infer_instance)
  rw [hRg]
  refine CFSG.LocalAnalysis.GLTheoremA.S11.y10xF_qs_of_mulEquiv
    (MonoidHom.ofInjective
      (bmDPS_embedHom_injective n f (R + 1) r' eidx hPP hPinvP hP hJ)) ?_
  have hn : 2 ≤ R + 1 := by omega
  have hside : 3 ≤ R + 1 ∨ ∃ s : Finset (GaloisField 2 f), s.card = 4 := by
    by_cases h3 : 3 ≤ R + 1
    · exact Or.inl h3
    · obtain ⟨s, hs⟩ := bmDPS_component_sl2_card n f S he hJe eidx hPP hPinvP hP hJ hconv (by omega)
      exact Or.inr ⟨s, hs⟩
  refine ⟨(CFSG.LinearGroups.special_linear_isPerfect (K := GaloisField 2 f) (n := R + 1)
    hn hside).commutator_eq_top, ?_⟩
  exact (CFSG.LinearGroups.linear_projective_simple (K := GaloisField 2 f) (n := R + 1)
    hn hside).2.1

private theorem bmDPS_component_range_le

    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e))
    (hgen : bmDPS_scalarAction n f S e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hJe : IsComponentOf J' (bmDPS_range n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e) :
        bmDPS_range n f S e ≤ J' := by
  have hMq : CFSG.Open.IsQuasisimple ↥J' := hJe.2.2
  have hsub : CFSG.Open.IsSubnormal J' (bmDPS_range n f S e) :=
    bmDPS_assembly_isSubnormal_open hJe.2.1
  exact le_of_eq (CFSG.LocalAnalysis.GLTheoremA.S11.y10xF_eq_of_subnormal
    (bmDPS_component_range_quasisimple n f S hS he hestar hgen hJe eidx hPP hPinvP hP hJ hconv)
        hJe.1 hsub hMq).symm

private theorem bmDPS_component_rank_pos

    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e))
    (hgen : bmDPS_scalarAction n f S e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hJe : IsComponentOf J' (bmDPS_range n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e) :
    1 ≤ R := by
  have hRg : bmDPS_range n f S e =
      (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).range :=
    le_antisymm
      (bmDPS_range_le_embedHom n f S he eidx hPP hPinvP hP hJ hconv)
      (bmDPS_component_embed_le_range n f S hS he hestar hgen hJe eidx hPP hPinvP hP hJ hconv)
  by_contra hR0
  have hR1 : R + 1 = 1 := by omega
  haveI : Subsingleton (Fin (R + 1)) := Fin.subsingleton_iff_le_one.mpr (by omega)
  have hbot : bmDPS_range n f S e = ⊥ := by
    rw [hRg, MonoidHom.range_eq_bot_iff]
    ext x
    rw [Subsingleton.elim x 1]
    simp
  have hJ'bot : J' = ⊥ := le_bot_iff.mp (hbot ▸ hJe.1)
  have hntJ' : Nontrivial ↥J' := by
    haveI : Nontrivial (↥J' ⧸ Subgroup.center ↥J') := hJe.2.2.2.toNontrivial
    exact Function.Surjective.nontrivial (QuotientGroup.mk'_surjective (Subgroup.center ↥J'))
  haveI : Nontrivial ↥J' := hntJ'
  exact not_subsingleton ↥J' (by rw [hJ'bot]; infer_instance)

private theorem bmDPS_component_eq_range

    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e))
    (hgen : bmDPS_scalarAction n f S e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hJe : IsComponentOf J' (bmDPS_range n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e) :
        J' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).range ∧ 1 ≤ R := by
  refine ⟨le_antisymm ?_ ?_, ?_⟩
  · exact bmDPS_component_le_embed n f S he hJe eidx hPP hPinvP hP hJ hconv
  · exact le_trans
      (bmDPS_component_embed_le_range n f S hS he hestar hgen hJe eidx hPP hPinvP hP hJ hconv)
      (bmDPS_component_range_le n f S hS he hestar hgen hJe eidx hPP hPinvP hP hJ hconv)
  · exact bmDPS_component_rank_pos n f S hS he hestar hgen hJe eidx hPP hPinvP hP hJ hconv

private noncomputable def bmDPS_modelHom
    (f R g' : ℕ)
    (ρ : GaloisField 2 g' ≃+* GaloisField 2 f) :
    (ggU .PSL (R + 1) g').K →* Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) :=
  Matrix.SpecialLinearGroup.map ρ.toRingHom

private theorem bmDPS_modelHom_injective
    (f R g' : ℕ)
    (ρ : GaloisField 2 g' ≃+* GaloisField 2 f) :
    Function.Injective (bmDPS_modelHom f R g' ρ) := by
  change Function.Injective (Matrix.SpecialLinearGroup.map ρ.toRingHom)
  intro A B hAB
  apply Subtype.ext
  ext i j
  have h := congrArg (fun g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) => g i j)
      hAB
  simp only [Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply, Matrix.map_apply]
      at h
  exact ρ.injective h

private theorem bmDPS_modelHom_surjective
    (f R g' : ℕ)
    (ρ : GaloisField 2 g' ≃+* GaloisField 2 f) :
    Function.Surjective (bmDPS_modelHom f R g' ρ) := by
  change Function.Surjective (Matrix.SpecialLinearGroup.map ρ.toRingHom)
  intro B
  refine ⟨Matrix.SpecialLinearGroup.map ρ.symm.toRingHom B, ?_⟩
  apply Subtype.ext
  ext i j
  simp only [Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply, Matrix.map_apply]
  exact ρ.apply_symm_apply _

private def bmDPS_rootCoeff (R : ℕ) (i j : Fin (R + 1)) : Fin R → ℤ := fun k =>
  (if i.val ≤ k.val then 1 else 0) - (if j.val ≤ k.val then 1 else 0)

private theorem bmDPS_toStd_rootCoeff (R : ℕ) (i j : Fin (R + 1)) :
    SpecialLinear.toStd R (bmDPS_rootCoeff R i j) = Pi.single i 1 - Pi.single j 1 := by
  funext a
  have ha := a.isLt
  have hi := i.isLt
  have hj := j.isLt
  simp only [SpecialLinear.toStd, bmDPS_rootCoeff, Pi.sub_apply, Pi.single_apply, Fin.ext_iff]
  split_ifs <;> omega

private theorem bmDPS_rootCoeff_mem_roots (R : ℕ) (F : Type) [Field F]
    {i j : Fin (R + 1)} (hij : i ≠ j) :
    bmDPS_rootCoeff R i j ∈ (SpecialLinear.rootDatum R F).roots := by
  show bmDPS_rootCoeff R i j ∈ roots (SpecialLinear.isFiniteType_A R) ∅
  rw [SpecialLinear.roots_eq]
  exact ⟨i, j, hij, bmDPS_toStd_rootCoeff R i j⟩

private theorem bmDPS_model_long_root (R : ℕ) (F : Type) [Field F] (hR : 1 ≤ R) :
    ∃ β : Fin R → ℤ, β ∈ (SpecialLinear.rootDatum R F).roots ∧
      GGLongRoot (SpecialLinear.rootDatum R F) β ∧
      SpecialLinear.toStd R β = Pi.single 0 1 - Pi.single (Fin.last R) 1 := by
  have h0last : (0 : Fin (R + 1)) ≠ Fin.last R := by
    intro h
    have := congrArg Fin.val h
    simp only [Fin.val_zero, Fin.val_last] at this
    omega
  let β : Fin R → ℤ := bmDPS_rootCoeff R 0 (Fin.last R)
  have hβ : β ∈ (SpecialLinear.rootDatum R F).roots := bmDPS_rootCoeff_mem_roots R F h0last
  have hstd : SpecialLinear.toStd R β =
      Pi.single 0 1 - Pi.single (Fin.last R) 1 := bmDPS_toStd_rootCoeff R 0 (Fin.last R)
  have hmax : ∀ δ ∈ (SpecialLinear.rootDatum R F).roots, ∑ i, δ i ≤ ∑ i, β i := by
    intro δ hδ
    have hδ' : δ ∈ roots (SpecialLinear.isFiniteType_A R) ∅ := hδ
    rw [SpecialLinear.roots_eq] at hδ'
    obtain ⟨i, j, hij, hδij⟩ := hδ'
    have h1 : ∑ k, δ k = (j : ℤ) - i := SpecialLinear.ht_eq R hδij
    have h2 : ∑ k, β k = (Fin.last R : ℤ) - 0 := SpecialLinear.ht_eq R hstd
    rw [h1, h2]
    have hj : (j : ℤ) ≤ (R : ℤ) := by
      have h : j.val ≤ R := Nat.lt_succ_iff.mp j.isLt
      exact_mod_cast h
    have hi : (0 : ℤ) ≤ (i : ℤ) := Int.natCast_nonneg _
    have hlm : (Fin.last R : ℤ) = (R : ℤ) := by simp
    rw [hlm]
    omega
  refine ⟨β, hβ, ?_, hstd⟩
  refine ⟨1, β, hβ, hmax, ?_⟩
  rw [map_one]
  exact (Module.End.one_apply β).symm

private theorem bmDPS_modelHom_rootGroup
    (f R g' : ℕ) (ρ : GaloisField 2 g' ≃+* GaloisField 2 f)
    (i j : Fin (R + 1)) (hij : i ≠ j) (β₀ : Fin R → ℤ)
    (hβ₀ : SpecialLinear.toStd R β₀ = Pi.single i 1 - Pi.single j 1) :
    ((ggU .PSL (R + 1) g').D.rootGroup β₀).map (bmDPS_modelHom f R g' ρ) =
      (ggU .PSL (R + 1) f).D.rootGroup β₀ := by
  change ((SpecialLinear.rootGroup R (GaloisField 2 g')) β₀).map (bmDPS_modelHom f R g' ρ) =
      (SpecialLinear.rootGroup R (GaloisField 2 f)) β₀
  rw [SpecialLinear.rootGroup_eq R (GaloisField 2 g') hij hβ₀,
    SpecialLinear.rootGroup_eq R (GaloisField 2 f) hij hβ₀]
  change ((Matrix.SpecialLinearGroup.transvectionHom hij).range).map
      (Matrix.SpecialLinearGroup.map ρ.toRingHom) =
    (Matrix.SpecialLinearGroup.transvectionHom hij).range
  rw [MonoidHom.map_range]
  refine le_antisymm ?_ ?_
  · rintro y ⟨c, rfl⟩
    refine ⟨Multiplicative.ofAdd (ρ (Multiplicative.toAdd c)), ?_⟩
    simp only [MonoidHom.comp_apply, Matrix.SpecialLinearGroup.transvectionHom_apply,
      Matrix.SpecialLinearGroup.map_transvection, toAdd_ofAdd]
    rfl
  · rintro y ⟨d, rfl⟩
    refine ⟨Multiplicative.ofAdd (ρ.symm (Multiplicative.toAdd d)), ?_⟩
    simp only [MonoidHom.comp_apply, Matrix.SpecialLinearGroup.transvectionHom_apply,
      Matrix.SpecialLinearGroup.map_transvection, toAdd_ofAdd]
    show Matrix.SpecialLinearGroup.transvection hij (ρ (ρ.symm (Multiplicative.toAdd d))) =
      Matrix.SpecialLinearGroup.transvection hij (Multiplicative.toAdd d)
    rw [ρ.apply_symm_apply]

private theorem bmDPS_blockMat_transvection
    (n f R r' : ℕ)

    (i j : Fin (R + 1)) (hij : i ≠ j) (c : GaloisField 2 f) :
    bmDPS_blockMat n f (R + 1) r' (Matrix.SpecialLinearGroup.transvection hij c) =
      1 + c • (Matrix.fromBlocks (Matrix.single i j 1)
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (Matrix.fromBlocks (Matrix.single j i 1)
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) := by
  unfold bmDPS_blockMat
  rw [Matrix.SpecialLinearGroup.transvection_coe, Matrix.SpecialLinearGroup.transvection_inv,
    Matrix.SpecialLinearGroup.transvection_coe]
  simp only [Matrix.transpose_add, Matrix.transpose_one, Matrix.transpose_single, CharTwo.neg_eq]
  ext p q
  rcases p with a | (b | d) <;> rcases q with a' | (b' | d') <;>
    simp [Matrix.fromBlocks, Matrix.fromBlocks_add, Matrix.fromBlocks_smul, Matrix.fromBlocks_one,
      Matrix.fromBlocks_zero, Matrix.single_apply, Matrix.smul_apply, Matrix.one_apply,
      Matrix.add_apply, Matrix.zero_apply]

private theorem bmDPS_conj_add (n f : ℕ)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (v w : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    Pinv * (v + w) * P = Pinv * v * P + Pinv * w * P := by
  noncomm_ring

private theorem bmDPS_conj_smul (n f : ℕ)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (c : GaloisField 2 f) (v : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    Pinv * (c • v) * P = c • (Pinv * v * P) := by
  rw [Matrix.mul_smul, Matrix.smul_mul]

private theorem bmDPS_conj_add_smul (n f : ℕ)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1) (c : GaloisField 2 f)
    (R : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    Pinv * (1 + c • R) * P = 1 + c • (Pinv * R * P) := by
  rw [bmDPS_conj_add n f P Pinv 1 (c • R), bmDPS_conj_smul, Matrix.mul_one, hPinvP]

private theorem bmDPS_reindex_add_smul (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (c : GaloisField 2 f)
    (M : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f)) :
    Matrix.reindex eidx eidx (1 + c • M) = 1 + c • (Matrix.reindex eidx eidx M) := by
  change Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx (1 + c • M) =
    1 + c • Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx M
  rw [map_add, map_one, map_smul]

private theorem bmDPS_conj_reindex_add_smul (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1) (c : GaloisField 2 f)
    (M : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f)) :
    Pinv * Matrix.reindex eidx eidx (1 + c • M) * P =
      1 + c • (Pinv * Matrix.reindex eidx eidx M * P) := by
  rw [bmDPS_reindex_add_smul, bmDPS_conj_add_smul n f P Pinv hPinvP]

private theorem bmDPS_embedGL_transvection
    (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (i j : Fin (R + 1)) (hij : i ≠ j) (c : GaloisField 2 f) :
    ((bmDPS_embedGL n f (R + 1) r' eidx P Pinv hPP hPinvP
        (Matrix.SpecialLinearGroup.transvection hij c) :
        GL (Fin n ⊕ Fin n) (GaloisField 2 f)) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
      1 + c • (Pinv * Matrix.reindex eidx eidx
        (Matrix.fromBlocks (Matrix.single i j 1)
          (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (Matrix.fromBlocks (Matrix.single j i 1)
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) * P) := by
  rw [bmDPS_embedGL_coe, bmDPS_blockMat_transvection,
    bmDPS_conj_reindex_add_smul n f R r' eidx P Pinv hPinvP c]

private theorem bmDPS_Jb_symmetric (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n) :
    Matrix.transpose (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) =
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) := by
  rw [Matrix.transpose_reindex, bmDPS_J_transpose]

private theorem bmDPS_J_eq_reindex_Jb (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n) :
    bmDPS_J n f = Matrix.reindex eidx eidx
      (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) := by
  rw [Matrix.reindex_apply, Matrix.reindex_apply, Matrix.submatrix_submatrix]
  simp

private theorem bmDPS_J_apply_eidx (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (k : Fin n ⊕ Fin n) (s : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) :
    (bmDPS_J n f) k (eidx s) =
      (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) (eidx.symm k) s := by
  rw [bmDPS_J_eq_reindex_Jb n f R r' eidx, Matrix.reindex_apply, Matrix.submatrix_apply]
  simp

private theorem bmDPS_Jb_entries (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx) :
    (∀ a a', (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) (Sum.inl a) (Sum.inl a') = 0) ∧
    (∀ b b', (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))
      (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inl b')) = 0) ∧
    (∀ a b, (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))
      (Sum.inl a) (Sum.inr (Sum.inl b)) = if a = b then 1 else 0) ∧
    (∀ b a, (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))
      (Sum.inr (Sum.inl b)) (Sum.inl a) = if a = b then 1 else 0) ∧
    (∀ c a, (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))
      (Sum.inr (Sum.inr c)) (Sum.inl a) = 0) ∧
    (∀ b c, (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))
      (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inr c)) = 0) ∧
    (∀ a c, (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))
      (Sum.inl a) (Sum.inr (Sum.inr c)) = 0) := by
  refine ⟨hJ.2.1, hJ.2.2.1, hJ.2.2.2.2.2.2.2, ?_, hJ.2.2.2.2.1, hJ.2.2.2.2.2.1,
    hJ.2.2.2.1⟩
  intro b a
  rw [← bmDPS_Jb_symmetric n f R r' eidx, Matrix.transpose_apply, hJ.2.2.2.2.2.2.2]

private theorem bmDPS_J_mulVec_single_inl (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx) :
    ∀ a : Fin (R + 1),
      Matrix.mulVec (bmDPS_J n f) (Pi.single (eidx (Sum.inl a)) 1) =
        Pi.single (eidx (Sum.inr (Sum.inl a))) 1 := by
  intro a
  rw [Matrix.mulVec_single_one]
  funext k
  rw [Matrix.col_apply, bmDPS_J_apply_eidx]
  obtain ⟨e1, e2, e3, e4, e5, e6, e7⟩ := bmDPS_Jb_entries n f R r' eidx hJ
  rcases hk : eidx.symm k with a' | (b | c)
  · rw [e1, Pi.single_apply, if_neg]
    rintro h
    rw [h, Equiv.symm_apply_apply] at hk
    exact Sum.inr_ne_inl hk
  · rw [e4, Pi.single_apply]
    have hk' : k = eidx (Sum.inr (Sum.inl b)) := by
      rw [(Equiv.apply_symm_apply eidx k).symm, hk]
    rw [hk']
    by_cases hab : a = b
    · rw [if_pos hab, if_pos]
      exact congrArg (fun x => eidx (Sum.inr (Sum.inl x))) hab.symm
    · rw [if_neg hab, if_neg]
      intro h
      exact hab ((Sum.inl_injective (Sum.inr_injective (eidx.injective h))).symm)
  · rw [e5, Pi.single_apply, if_neg]
    rintro h
    rw [h, Equiv.symm_apply_apply] at hk
    exact Sum.inl_ne_inr (Sum.inr_injective hk)

private theorem bmDPS_J_mulVec_single_inr (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx) :
    ∀ b : Fin (R + 1),
      Matrix.mulVec (bmDPS_J n f) (Pi.single (eidx (Sum.inr (Sum.inl b))) 1) =
        Pi.single (eidx (Sum.inl b)) 1 := by
  intro b
  rw [Matrix.mulVec_single_one]
  funext k
  rw [Matrix.col_apply, bmDPS_J_apply_eidx]
  obtain ⟨e1, e2, e3, e4, e5, e6, e7⟩ := bmDPS_Jb_entries n f R r' eidx hJ
  rcases hk : eidx.symm k with a' | (b' | c)
  · rw [e3, Pi.single_apply]
    have hk' : k = eidx (Sum.inl a') := by
      rw [(Equiv.apply_symm_apply eidx k).symm, hk]
    rw [hk']
    by_cases hab : a' = b
    · rw [if_pos hab, if_pos (congrArg (fun x => eidx (Sum.inl x)) hab)]
    · rw [if_neg hab, if_neg]
      intro h
      exact hab (Sum.inl_injective (eidx.injective h))
  · rw [e2, Pi.single_apply, if_neg (by
      intro h
      have h2 : eidx.symm k = Sum.inl b := by rw [h, Equiv.symm_apply_apply]
      rw [hk] at h2
      exact Sum.inl_ne_inr h2.symm)]
  · rw [Pi.single_apply, if_neg (by
      intro h
      have h2 : eidx.symm k = Sum.inl b := by rw [h, Equiv.symm_apply_apply]
      rw [hk] at h2
      exact Sum.inl_ne_inr h2.symm)]
    rw [← bmDPS_Jb_symmetric n f R r' eidx, Matrix.transpose_apply, e6]

private theorem bmDPS_conj_vecMulVec (n f : ℕ)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (a b : (Fin n ⊕ Fin n) → (GaloisField 2 f)) :
    Pinv * Matrix.vecMulVec a b * P =
      Matrix.vecMulVec (Matrix.mulVec Pinv a) (Matrix.mulVec (Matrix.transpose P) b) := by
  ext i k
  simp only [Matrix.mul_apply, Matrix.vecMulVec_apply, Matrix.mulVec, dotProduct]
  rw [Finset.sum_mul_sum, Finset.sum_comm]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl (fun l _ => ?_)
  rw [Matrix.transpose_apply]
  ring

private theorem bmDPS_reindex_single (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (p q : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) :
    Matrix.reindex eidx eidx (Matrix.single p q (1 : GaloisField 2 f)) =
      Matrix.vecMulVec (Pi.single (eidx p) 1) (Pi.single (eidx q) 1) := by
  ext r s
  simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Matrix.single_apply,
    Matrix.vecMulVec_apply, Pi.single_apply, Equiv.symm_apply_eq]
  split_ifs <;> simp_all

private theorem bmDPS_reindex_fromBlocks_single (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (i j : Fin (R + 1)) :
    Matrix.reindex eidx eidx
        (Matrix.fromBlocks (Matrix.single i j 1)
          (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (Matrix.fromBlocks (Matrix.single j i 1)
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) =
      Matrix.vecMulVec (Pi.single (eidx (Sum.inl i)) 1) (Pi.single (eidx (Sum.inl j)) 1) +
        Matrix.vecMulVec (Pi.single (eidx (Sum.inr (Sum.inl j))) 1)
          (Pi.single (eidx (Sum.inr (Sum.inl i))) 1) := by
  have hM : Matrix.fromBlocks (Matrix.single i j 1)
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (Matrix.fromBlocks (Matrix.single j i 1)
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) =
      Matrix.single (Sum.inl i) (Sum.inl j) (1 : GaloisField 2 f) +
        Matrix.single (Sum.inr (Sum.inl j)) (Sum.inr (Sum.inl i)) (1 : GaloisField 2 f) := by
    ext p q
    rcases p with a | (b | c) <;> rcases q with a' | (b' | c') <;>
      simp [Matrix.fromBlocks, Matrix.single_apply]
  rw [hM]
  change Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx
      (Matrix.single (Sum.inl i) (Sum.inl j) (1 : GaloisField 2 f) +
        Matrix.single (Sum.inr (Sum.inl j)) (Sum.inr (Sum.inl i)) (1 : GaloisField 2 f)) =
      Matrix.vecMulVec (Pi.single (eidx (Sum.inl i)) 1) (Pi.single (eidx (Sum.inl j)) 1) +
        Matrix.vecMulVec (Pi.single (eidx (Sum.inr (Sum.inl j))) 1)
          (Pi.single (eidx (Sum.inr (Sum.inl i))) 1)
  rw [map_add]
  congr 1
  · exact bmDPS_reindex_single n f R r' eidx (Sum.inl i) (Sum.inl j)
  · exact bmDPS_reindex_single n f R r' eidx (Sum.inr (Sum.inl j)) (Sum.inr (Sum.inl i))

private theorem bmDPS_transpose_eq (n f : ℕ)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f) :
    Matrix.transpose P = bmDPS_J n f * Pinv * bmDPS_J n f := by
  have hPtJ : Matrix.transpose P * bmDPS_J n f = bmDPS_J n f * Pinv := by
    calc Matrix.transpose P * bmDPS_J n f
        = Matrix.transpose P * bmDPS_J n f * (P * Pinv) := by rw [hPP, Matrix.mul_one]
      _ = (Matrix.transpose P * bmDPS_J n f * P) * Pinv := by noncomm_ring
      _ = bmDPS_J n f * Pinv := by rw [hP]
  calc Matrix.transpose P = Matrix.transpose P * (bmDPS_J n f * bmDPS_J n f) := by
        rw [bmDPS_J_mul_self, Matrix.mul_one]
    _ = (Matrix.transpose P * bmDPS_J n f) * bmDPS_J n f := by rw [Matrix.mul_assoc]
    _ = (bmDPS_J n f * Pinv) * bmDPS_J n f := by rw [hPtJ]
    _ = bmDPS_J n f * Pinv * bmDPS_J n f := by rw [Matrix.mul_assoc]

private theorem bmDPS_siegel_vectors_inl (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (i j : Fin (R + 1)) :
    Pinv * Matrix.reindex eidx eidx
        (Matrix.fromBlocks (Matrix.single i j 1)
          (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (Matrix.fromBlocks (Matrix.single j i 1)
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) * P =
      Matrix.vecMulVec (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl i)) 1))
          (Matrix.mulVec (bmDPS_J n f)
            (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl j))) 1))) +
        Matrix.vecMulVec (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl j))) 1))
          (Matrix.mulVec (bmDPS_J n f)
            (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl i)) 1))) := by
  rw [bmDPS_reindex_fromBlocks_single]
  rw [Matrix.mul_add, Matrix.add_mul]
  rw [bmDPS_conj_vecMulVec, bmDPS_conj_vecMulVec]
  rw [bmDPS_transpose_eq n f P Pinv hPP hP]
  simp only [← Matrix.mulVec_mulVec]
  rw [bmDPS_J_mulVec_single_inl n f R r' eidx hJ j,
    bmDPS_J_mulVec_single_inr n f R r' eidx hJ i]

private theorem bmDPS_siegel_vectors_inr (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (i j : Fin (R + 1)) :
    Pinv * Matrix.reindex eidx eidx
        (Matrix.fromBlocks (Matrix.single j i 1)
          (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (Matrix.fromBlocks (Matrix.single i j 1)
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) * P =
      Matrix.vecMulVec (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl i))) 1))
          (Matrix.mulVec (bmDPS_J n f)
            (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl j)) 1))) +
        Matrix.vecMulVec (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl j)) 1))
          (Matrix.mulVec (bmDPS_J n f)
            (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl i))) 1))) := by
  rw [bmDPS_reindex_fromBlocks_single n f R r' eidx j i]
  rw [Matrix.mul_add, Matrix.add_mul]
  rw [bmDPS_conj_vecMulVec, bmDPS_conj_vecMulVec]
  rw [bmDPS_transpose_eq n f P Pinv hPP hP]
  simp only [← Matrix.mulVec_mulVec]
  rw [bmDPS_J_mulVec_single_inl n f R r' eidx hJ i,
    bmDPS_J_mulVec_single_inr n f R r' eidx hJ j]
  rw [add_comm]

private theorem bmDPS_pinv_symplectic (n f : ℕ)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f) :
    Matrix.transpose Pinv * bmDPS_J n f * Pinv = bmDPS_J n f := by
  have hsinv := bmDPS_symplectic_inv n f P hP
  have hPinv_eq : Pinv = (bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f := by
    calc Pinv = Pinv * (P * ((bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f)) := by
          rw [hsinv.1, Matrix.mul_one]
      _ = (Pinv * P) * ((bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f) := by
          noncomm_ring
      _ = (bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f := by rw [hPinvP, Matrix.one_mul]
  rw [hPinv_eq]
  exact hsinv.2.2

private theorem bmDPS_pairing_isometry (n f : ℕ)
    (Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hPinv_symp : Matrix.transpose Pinv * bmDPS_J n f * Pinv = bmDPS_J n f)
    (u v : (Fin n ⊕ Fin n) → (GaloisField 2 f)) :
    (Matrix.mulVec Pinv u) ⬝ᵥ Matrix.mulVec (bmDPS_J n f) (Matrix.mulVec Pinv v) =
      u ⬝ᵥ Matrix.mulVec (bmDPS_J n f) v := by
  rw [Matrix.dotProduct_mulVec, Matrix.vecMul_mulVec, ← Matrix.dotProduct_mulVec,
    Matrix.mulVec_mulVec, hPinv_symp]

private theorem bmDPS_single_dotProduct {ι : Type*} [Fintype ι] [DecidableEq ι] (f : ℕ)
    (p q : ι) :
    (Pi.single p (1 : GaloisField 2 f) : ι → GaloisField 2 f) ⬝ᵥ Pi.single q 1 =
      if p = q then 1 else 0 := by
  rw [single_one_dotProduct, Pi.single_apply]

private theorem bmDPS_siegel_pairings (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)} (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (i j : Fin (R + 1)) (hij : i ≠ j) :
    let a₁ : (Fin n ⊕ Fin n) → (GaloisField 2 f) :=
      Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl i)) 1)
    let a₂ : (Fin n ⊕ Fin n) → (GaloisField 2 f) :=
      Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl j))) 1)
    let b₁ : (Fin n ⊕ Fin n) → (GaloisField 2 f) :=
      Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl i))) 1)
    let b₂ : (Fin n ⊕ Fin n) → (GaloisField 2 f) :=
      Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl j)) 1)
    a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₁ = 1 ∧
    a₂ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 1 ∧
    (a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0 ∧
      b₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 0 ∧
      a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 0 ∧
      a₂ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₁ = 0) := by
  have hPinv_symp := bmDPS_pinv_symplectic n f P Pinv hPinvP hP
  dsimp only
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [bmDPS_pairing_isometry n f Pinv hPinv_symp,
      bmDPS_J_mulVec_single_inr n f R r' eidx hJ i,
      bmDPS_single_dotProduct f (eidx (Sum.inl i)) (eidx (Sum.inl i))]
    simp
  · rw [bmDPS_pairing_isometry n f Pinv hPinv_symp,
      bmDPS_J_mulVec_single_inl n f R r' eidx hJ j,
      bmDPS_single_dotProduct f (eidx (Sum.inr (Sum.inl j))) (eidx (Sum.inr (Sum.inl j)))]
    simp
  · rw [bmDPS_pairing_isometry n f Pinv hPinv_symp,
      bmDPS_J_mulVec_single_inr n f R r' eidx hJ j,
      bmDPS_single_dotProduct f (eidx (Sum.inl i)) (eidx (Sum.inl j)),
      if_neg (by intro h; exact hij (Sum.inl_injective (eidx.injective h)))]
  · rw [bmDPS_pairing_isometry n f Pinv hPinv_symp,
      bmDPS_J_mulVec_single_inl n f R r' eidx hJ j,
      bmDPS_single_dotProduct f (eidx (Sum.inr (Sum.inl i))) (eidx (Sum.inr (Sum.inl j))),
      if_neg (by intro h; exact hij (Sum.inl_injective (Sum.inr_injective (eidx.injective h))))]
  · rw [bmDPS_pairing_isometry n f Pinv hPinv_symp,
      bmDPS_J_mulVec_single_inl n f R r' eidx hJ j,
      bmDPS_single_dotProduct f (eidx (Sum.inl i)) (eidx (Sum.inr (Sum.inl j))),
      if_neg (by intro h; exact Sum.inl_ne_inr (eidx.injective h))]
  · rw [bmDPS_pairing_isometry n f Pinv hPinv_symp,
      bmDPS_J_mulVec_single_inr n f R r' eidx hJ i,
      bmDPS_single_dotProduct f (eidx (Sum.inr (Sum.inl j))) (eidx (Sum.inl i)),
      if_neg (by intro h; exact Sum.inr_ne_inl (eidx.injective h))]

private theorem bmDPS_mrange_eq_altSiegel (n f : ℕ)
    (Φ : Multiplicative (GaloisField 2 f) →* GL (Fin n ⊕ Fin n) (GaloisField 2 f))
    (a₁ a₂ : (Fin n ⊕ Fin n) → (GaloisField 2 f))
    (hgen : ∀ c : GaloisField 2 f,
      ((Φ (Multiplicative.ofAdd c) : GL (Fin n ⊕ Fin n) (GaloisField 2 f)) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
        1 + c • (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
          Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁))) :
    Φ.range = altSiegelGroup (bmDPS_J n f) a₁ a₂ := by
  rw [altSiegelGroup]
  apply le_antisymm
  · rintro x hx
    obtain ⟨d, rfl⟩ := MonoidHom.mem_range.mp hx
    exact Subgroup.subset_closure ⟨Multiplicative.toAdd d, hgen (Multiplicative.toAdd d)⟩
  · rw [Subgroup.closure_le]
    rintro g ⟨d, hd⟩
    exact MonoidHom.mem_range.mpr ⟨Multiplicative.ofAdd d, Units.ext (by rw [hgen, hd])⟩

private theorem bmDPS_embedHom_rootSubgroup_eq_altSiegel (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (i j : Fin (R + 1)) (hij : i ≠ j)
    {a₁ a₂ : (Fin n ⊕ Fin n) → (GaloisField 2 f)}
    (hN : Pinv * Matrix.reindex eidx eidx
        (Matrix.fromBlocks (Matrix.single i j 1)
          (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (Matrix.fromBlocks (Matrix.single j i 1)
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) * P =
      Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
        Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁)) :
    Subgroup.map ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
        (Subgroup.map (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)
          (SpecialLinear.rootSubgroup R (GaloisField 2 f) hij)) =
      altSiegelGroup (bmDPS_J n f) a₁ a₂ := by
  let Φ : Multiplicative (GaloisField 2 f) →* GL (Fin n ⊕ Fin n) (GaloisField 2 f) :=
    ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp
      ((bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).comp
        (Matrix.SpecialLinearGroup.transvectionHom hij))
  have hΦ : Subgroup.map ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
      (Subgroup.map (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)
        (SpecialLinear.rootSubgroup R (GaloisField 2 f) hij)) = Φ.range := by
    rw [show SpecialLinear.rootSubgroup R (GaloisField 2 f) hij =
        (Matrix.SpecialLinearGroup.transvectionHom hij).range from rfl]
    rw [MonoidHom.map_range, MonoidHom.map_range]
  rw [hΦ]
  exact bmDPS_mrange_eq_altSiegel n f Φ a₁ a₂ (by
    intro c
    have h1 : Φ (Multiplicative.ofAdd c) =
        bmDPS_embedGL n f (R + 1) r' eidx P Pinv hPP hPinvP
          (Matrix.SpecialLinearGroup.transvection hij c) := by
      simp only [Φ, MonoidHom.comp_apply, Matrix.SpecialLinearGroup.transvectionHom_apply,
        toAdd_ofAdd]
      rfl
    rw [h1, bmDPS_embedGL_transvection, hN])

private theorem bmDPS_embedHom_rootSubgroup_altSiegel
    (n f : ℕ) {R r' : ℕ}
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (i j : Fin (R + 1)) (hij : i ≠ j) :
    ∃ (a₁ a₂ b₁ b₂ : (Fin n ⊕ Fin n) → (GaloisField 2 f)),
      a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₁ = 1 ∧
      a₂ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 1 ∧
      (a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0 ∧
        b₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 0 ∧
        a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 0 ∧
        a₂ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₁ = 0) ∧
      Subgroup.map ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
          (Subgroup.map (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)
            (SpecialLinear.rootSubgroup R (GaloisField 2 f) hij)) =
        altSiegelGroup (bmDPS_J n f) a₁ a₂ ∧
      Subgroup.map ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
          (Subgroup.map (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)
            (SpecialLinear.rootSubgroup R (GaloisField 2 f) hij.symm)) =
        altSiegelGroup (bmDPS_J n f) b₁ b₂ := by
  have hpair := bmDPS_siegel_pairings n f R r' eidx hPinvP hP hJ i j hij
  dsimp only at hpair
  refine ⟨Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl i)) 1),
    Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl j))) 1),
    Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl i))) 1),
    Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl j)) 1),
    hpair.1, hpair.2.1, hpair.2.2, ?_, ?_⟩
  · exact bmDPS_embedHom_rootSubgroup_eq_altSiegel
      (a₁ := Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl i)) 1))
      (a₂ := Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl j))) 1))
      n f R r' eidx hPP hPinvP hP hJ i j hij
      (bmDPS_siegel_vectors_inl n f R r' eidx hPP hP hJ i j)
  · exact bmDPS_embedHom_rootSubgroup_eq_altSiegel
      (a₁ := Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl i))) 1))
      (a₂ := Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl j)) 1))
      n f R r' eidx hPP hPinvP hP hJ j i hij.symm
      (bmDPS_siegel_vectors_inr n f R r' eidx hPP hP hJ i j)

private theorem bmDPS_embedHom_rootGroup_altSiegel
    (n f : ℕ)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hRpos : 1 ≤ R)
    (β₀ : Fin R → ℤ)
    (hβ₀ : SpecialLinear.toStd R β₀ = Pi.single 0 1 - Pi.single (Fin.last R) 1) :
    ∃ (a₁ a₂ b₁ b₂ : (Fin n ⊕ Fin n) → (GaloisField 2 f)),
      a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₁ = 1 ∧
      a₂ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 1 ∧
      (a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0 ∧
        b₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 0 ∧
        a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 0 ∧
        a₂ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₁ = 0) ∧
      (((SpecialLinear.rootDatum R (GaloisField 2 f)).rootGroup β₀).map
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)).map
          ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) =
        altSiegelGroup (bmDPS_J n f) a₁ a₂ ∧
      (((SpecialLinear.rootDatum R (GaloisField 2 f)).rootGroup (-β₀)).map
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)).map
          ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) =
        altSiegelGroup (bmDPS_J n f) b₁ b₂ := by
  have h0L : (0 : Fin (R + 1)) ≠ Fin.last R := by
    intro h
    have := congrArg Fin.val h
    simp only [Fin.val_zero, Fin.val_last] at this
    omega
  have hβ₀neg : SpecialLinear.toStd R (-β₀) = Pi.single (Fin.last R) 1 - Pi.single 0 1 := by
    rw [SpecialLinear.toStd_neg, hβ₀]
    abel
  obtain ⟨a₁, a₂, b₁, b₂, hp₁, hp₂, horth4, hg₁, hg₂⟩ :=
    bmDPS_embedHom_rootSubgroup_altSiegel n f eidx hPP hPinvP hP hJ 0 (Fin.last R) h0L
  refine ⟨a₁, a₂, b₁, b₂, hp₁, hp₂, horth4, ?_, ?_⟩
  · rw [show (SpecialLinear.rootDatum R (GaloisField 2 f)).rootGroup β₀ =
        (SpecialLinear.rootGroup R (GaloisField 2 f)) β₀ from rfl]
    rw [SpecialLinear.rootGroup_eq R (GaloisField 2 f) h0L hβ₀]
    exact hg₁
  · rw [show (SpecialLinear.rootDatum R (GaloisField 2 f)).rootGroup (-β₀) =
        (SpecialLinear.rootGroup R (GaloisField 2 f)) (-β₀) from rfl]
    rw [SpecialLinear.rootGroup_eq R (GaloisField 2 f) h0L.symm hβ₀neg]
    exact hg₂

private theorem bmDPS_rootGroup_image_siegel
    (n f : ℕ)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hRpos : 1 ≤ R)
    (g' : ℕ) (ρ : GaloisField 2 g' ≃+* GaloisField 2 f)
    {ι' : (ggU .PSL (R + 1) g').K →* ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hι' : ι' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).comp
      (bmDPS_modelHom f R g' ρ))
    (β₀ : Fin R → ℤ)
    (hβ₀ : SpecialLinear.toStd R β₀ = Pi.single 0 1 - Pi.single (Fin.last R) 1) :
    ∃ (a₁ a₂ b₁ b₂ : (Fin n ⊕ Fin n) → (GaloisField 2 f)),
      a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₁ = 1 ∧
      a₂ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 1 ∧
      (a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0 ∧
        b₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 0 ∧
        a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 0 ∧
        a₂ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₁ = 0) ∧
      (((ggU .PSL (R + 1) g').D.rootGroup β₀).map ι').map
          ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) =
        altSiegelGroup (bmDPS_J n f) a₁ a₂ ∧
      (((ggU .PSL (R + 1) g').D.rootGroup (-β₀)).map ι').map
          ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) =
        altSiegelGroup (bmDPS_J n f) b₁ b₂ := by
  obtain ⟨a₁, a₂, b₁, b₂, hp₁, hp₂, horth4, hg₁, hg₂⟩ :=
    bmDPS_embedHom_rootGroup_altSiegel n f eidx hPP hPinvP hP hJ hRpos β₀ hβ₀
  have h0L : (0 : Fin (R + 1)) ≠ Fin.last R := by
    intro h
    have := congrArg Fin.val h
    simp only [Fin.val_zero, Fin.val_last] at this
    omega
  have hβ₀neg : SpecialLinear.toStd R (-β₀) = Pi.single (Fin.last R) 1 - Pi.single 0 1 := by
    rw [SpecialLinear.toStd_neg, hβ₀]
    abel
  refine ⟨a₁, a₂, b₁, b₂, hp₁, hp₂, horth4, ?_, ?_⟩
  · rw [hι', ← Subgroup.map_map,
      bmDPS_modelHom_rootGroup f R g' ρ 0 (Fin.last R) h0L β₀ hβ₀]
    exact hg₁
  · rw [hι', ← Subgroup.map_map,
      bmDPS_modelHom_rootGroup f R g' ρ (Fin.last R) 0 h0L.symm (-β₀) hβ₀neg]
    exact hg₂

private theorem bmDPS_root_configuration_explicit
    (n f : ℕ)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hRpos : 1 ≤ R)
    (g' : ℕ) (ρ : GaloisField 2 g' ≃+* GaloisField 2 f)
    {ι' : (ggU .PSL (R + 1) g').K →* ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hι' : ι' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).comp
      (bmDPS_modelHom f R g' ρ)) :
    ∃ (β₀ : Fin (ggU .PSL (R + 1) g').D.rank → ℤ)
      (a₁ a₂ b₁ b₂ : (Fin n ⊕ Fin n) → (GaloisField 2 f)),
      GGLongRoot (ggU .PSL (R + 1) g').D β₀ ∧
      a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₁ = 1 ∧
      a₂ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 1 ∧
      (a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0 ∧
        b₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 0 ∧
        a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₂ = 0 ∧
        a₂ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) b₁ = 0) ∧
      (((ggU .PSL (R + 1) g').D.rootGroup β₀).map ι').map
          ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) =
        altSiegelGroup (bmDPS_J n f) a₁ a₂ ∧
      (((ggU .PSL (R + 1) g').D.rootGroup (-β₀)).map ι').map
          ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) =
        altSiegelGroup (bmDPS_J n f) b₁ b₂ := by
  obtain ⟨β₀, _hβ₀mem, hlong, _hβ₀std⟩ := bmDPS_model_long_root R (GaloisField 2 g') hRpos
  obtain ⟨a₁, a₂, b₁, b₂, hp₁, hp₂, horth4, hg₁, hg₂⟩ :=
    bmDPS_rootGroup_image_siegel n f eidx hPP hPinvP hP hJ hRpos g' ρ hι' β₀ _hβ₀std
  exact ⟨β₀, a₁, a₂, b₁, b₂, hlong, hp₁, hp₂, horth4, hg₁, hg₂⟩

private theorem bmDPS_J_self_pairing (n f : ℕ) (x : (Fin n ⊕ Fin n) → GaloisField 2 f) :
    x ⬝ᵥ Matrix.mulVec (bmDPS_J n f) x = 0 := by
  rw [bmDPS_J, Matrix.fromBlocks_mulVec]
  simp only [Matrix.zero_mulVec, Matrix.one_mulVec, add_zero, zero_add]
  rw [dotProduct, Fintype.sum_sum_type]
  simp only [Function.comp_apply, dotProduct, Sum.elim_inl, Sum.elim_inr,
    Matrix.neg_mulVec, Pi.neg_apply, one_mul]
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_eq_zero
  intro k _
  simp only [Function.comp_apply, Matrix.one_mulVec]
  ring

private theorem bmDPS_J_pairing_comm (n f : ℕ) (x y : (Fin n ⊕ Fin n) → GaloisField 2 f) :
    x ⬝ᵥ Matrix.mulVec (bmDPS_J n f) y = y ⬝ᵥ Matrix.mulVec (bmDPS_J n f) x := by
  have h := Matrix.dotProduct_transpose_mulVec (bmDPS_J n f) x y
  rwa [bmDPS_J_transpose] at h

private theorem bmDPS_tau_sq (n f : ℕ) (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f)
    (haorth : a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0) :
    (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
        Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁)) *
      (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
        Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁)) = 0 := by
  have h12 : (Matrix.mulVec (bmDPS_J n f) a₂) ⬝ᵥ a₁ = 0 := by
    rw [dotProduct_comm]; exact haorth
  have h11 : (Matrix.mulVec (bmDPS_J n f) a₁) ⬝ᵥ a₁ = 0 := by
    rw [dotProduct_comm]; exact bmDPS_J_self_pairing n f a₁
  have h21 : (Matrix.mulVec (bmDPS_J n f) a₁) ⬝ᵥ a₂ = 0 := by
    rw [dotProduct_comm, ← bmDPS_J_pairing_comm n f a₁ a₂]; exact haorth
  have h22 : (Matrix.mulVec (bmDPS_J n f) a₂) ⬝ᵥ a₂ = 0 := by
    rw [dotProduct_comm]; exact bmDPS_J_self_pairing n f a₂
  rw [Matrix.add_mul, Matrix.mul_add, Matrix.mul_add]
  simp only [Matrix.vecMulVec_mul_vecMulVec, h12, h22, h11, h21, zero_smul,
    Matrix.vecMulVec_zero, add_zero]

private theorem bmDPS_rank_one_eq_vecMulVec {m n : Type*} [Fintype m]
    [Fintype n] (F : Type) [Field F]
    (A : Matrix m n F) (hA : A.rank ≤ 1) :
    ∃ v : m → F, ∃ φ : n → F, A = Matrix.vecMulVec v φ := by
  classical
  by_cases hA0 : A = 0
  · subst hA0
    exact ⟨0, 0, by ext i j; simp [Matrix.vecMulVec]⟩
  · obtain ⟨i, hi⟩ : ∃ i, A.row i ≠ 0 := by
      by_contra h
      push_neg at h
      exact hA0 (by ext k l; simpa using congrFun (h k) l)
    have hrank : A.rank = Module.finrank F (Submodule.span F (Set.range A.row)) :=
      Matrix.rank_eq_finrank_span_row A
    have hle1 : Module.finrank F (Submodule.span F (Set.range A.row)) ≤ 1 := by
      rw [← hrank]; exact hA
    have hspan_le : Submodule.span F ({A.row i} : Set (n → F)) ≤
        Submodule.span F (Set.range A.row) := by
      apply Submodule.span_le.mpr
      rintro x rfl
      exact Submodule.subset_span ⟨i, rfl⟩
    have hfr : Module.finrank F (Submodule.span F ({A.row i} : Set (n → F))) = 1 := by
      have hsp : Submodule.span F ({A.row i} : Set (n → F)) = F ∙ A.row i := rfl
      rw [hsp]
      exact finrank_span_singleton hi
    have hspan_eq : Submodule.span F ({A.row i} : Set (n → F)) =
        Submodule.span F (Set.range A.row) :=
      Submodule.eq_of_le_of_finrank_le hspan_le (by rw [hfr]; exact hle1)
    have hrow : ∀ k, ∃ c : F, c • A.row i = A.row k := by
      intro k
      have hmem : A.row k ∈ Submodule.span F (Set.range A.row) := Submodule.subset_span ⟨k, rfl⟩
      rw [← hspan_eq] at hmem
      change A.row k ∈ F ∙ A.row i at hmem
      rwa [Submodule.mem_span_singleton] at hmem
    choose v hv using hrow
    exact ⟨v, fun l => A i l, by
      ext k l
      have h := congrFun (hv k) l
      simpa [Matrix.vecMulVec_apply, Pi.smul_apply, smul_eq_mul] using h.symm⟩

private theorem bmDPS_altSiegel_preimage_closure
    (n f : ℕ)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hJ'range : J' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).range)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f)
    (hle : altSiegelGroup (bmDPS_J n f) a₁ a₂ ≤
      J'.map (CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) :
    Subgroup.comap
        (((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ))
        (altSiegelGroup (bmDPS_J n f) a₁ a₂)
      = Subgroup.closure
          ((((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp
            (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)) ⁻¹'
            {g : GL (Fin n ⊕ Fin n) (GaloisField 2 f) | ∃ c : GaloisField 2 f,
              g = 1 + c • (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
                Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁))}) := by
  set C : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) →*
      GL (Fin n ⊕ Fin n) (GaloisField 2 f) :=
    (((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp
      (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)) with hCdef
  set genSet : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)) :=
    {g : GL (Fin n ⊕ Fin n) (GaloisField 2 f) | ∃ c : GaloisField 2 f,
      g = 1 + c • (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
        Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁))} with hgenset
  have hC : Function.Injective C := by
    rw [hCdef]
    intro a b h
    exact bmDPS_embedHom_injective n f (R + 1) r' eidx hPP hPinvP hP hJ (Subtype.ext h)
  have hA : altSiegelGroup (bmDPS_J n f) a₁ a₂ ≤ C.range := by
    rw [show C.range = J'.map (CFSG.Open.StatedSp n (GaloisField 2 f)).subtype from by
      rw [hCdef, MonoidHom.range_comp, ← hJ'range]]
    exact hle
  have himg : C '' (C ⁻¹' genSet) = genSet := by
    ext g
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact hx
    · intro hg
      obtain ⟨x, hx⟩ := hA (Subgroup.subset_closure hg)
      exact ⟨x, by rw [Set.mem_preimage]; rwa [hx], hx⟩
  apply Subgroup.map_injective hC
  rw [Subgroup.map_comap_eq_self hA, MonoidHom.map_closure, himg]
  rfl

private theorem bmDPS_finrank_prod {m n : Type*} [Fintype m] [Fintype n]
    (F : Type) [Field F] (S : Submodule F (m → F)) (T : Submodule F (n → F)) :
    Module.finrank F (S.prod T) = Module.finrank F S + Module.finrank F T := by
  have iso : S.prod T ≃ₗ[F] (S × T) :=
    { toFun := fun x => (⟨x.1.1, x.2.1⟩, ⟨x.1.2, x.2.2⟩)
      invFun := fun y => ⟨(y.1.1, y.2.1), ⟨y.1.2, y.2.2⟩⟩
      left_inv := by intro x; ext <;> rfl
      right_inv := by intro y; ext <;> rfl
      map_add' := by intro x y; ext <;> rfl
      map_smul' := by intro c x; ext <;> rfl }
  rw [LinearEquiv.finrank_eq iso, Module.finrank_prod]

private theorem bmDPS_rank_fromBlocks_zero {m n : Type*} [Fintype m] [Fintype n]
    (F : Type) [Field F] (A : Matrix m m F) (D : Matrix n n F) :
    (Matrix.fromBlocks A (0 : Matrix m n F) (0 : Matrix n m F) D).rank = A.rank + D.rank := by
  set B := Matrix.fromBlocks A (0 : Matrix m n F) (0 : Matrix n m F) D with hB
  have hmap : (LinearMap.range B.mulVecLin).map
        (LinearEquiv.sumArrowLequivProdArrow m n F F).toLinearMap =
      (LinearMap.range A.mulVecLin).prod (LinearMap.range D.mulVecLin) := by
    ext z
    constructor
    · rintro ⟨_, ⟨v, rfl⟩, rfl⟩
      constructor
      · refine ⟨v ∘ Sum.inl, ?_⟩
        rw [Matrix.mulVecLin_apply, Matrix.mulVecLin_apply]
        congr 1
        funext i
        simp [hB, Matrix.fromBlocks, Matrix.mulVec, dotProduct, Fintype.sum_sum_type]
      · refine ⟨v ∘ Sum.inr, ?_⟩
        rw [Matrix.mulVecLin_apply, Matrix.mulVecLin_apply]
        congr 1
        funext j
        simp [hB, Matrix.fromBlocks, Matrix.mulVec, dotProduct, Fintype.sum_sum_type]
    · rintro ⟨hu, hw⟩
      obtain ⟨u', hu'⟩ := hu
      obtain ⟨w', hw'⟩ := hw
      refine ⟨Matrix.mulVec B (Sum.elim u' w'), ⟨⟨Sum.elim u' w', rfl⟩, ?_⟩⟩
      apply Prod.ext
      · funext i
        simpa [LinearEquiv.sumArrowLequivProdArrow_apply_fst, hB, Matrix.fromBlocks,
          Matrix.mulVec, dotProduct, Fintype.sum_sum_type] using congrFun hu' i
      · funext j
        simpa [LinearEquiv.sumArrowLequivProdArrow_apply_snd, hB, Matrix.fromBlocks,
          Matrix.mulVec, dotProduct, Fintype.sum_sum_type] using congrFun hw' j
  rw [Matrix.rank_eq_finrank_span_cols, Matrix.rank_eq_finrank_span_cols,
    Matrix.rank_eq_finrank_span_cols, ← Matrix.range_mulVecLin, ← Matrix.range_mulVecLin,
    ← Matrix.range_mulVecLin]
  rw [← LinearEquiv.finrank_map_eq (LinearEquiv.sumArrowLequivProdArrow m n F F)
    (LinearMap.range B.mulVecLin), hmap]
  exact bmDPS_finrank_prod F _ _

private theorem bmDPS_blockMat_sub_one (n f R r' : ℕ)

    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    bmDPS_blockMat n f (R + 1) r' x - 1 =
      Matrix.fromBlocks ((x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1)
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (Matrix.fromBlocks
          (Matrix.transpose (((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) - 1)
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) := by
  unfold bmDPS_blockMat
  ext p q
  rcases p with a | (b | d) <;> rcases q with a' | (b' | d') <;>
    simp [Matrix.fromBlocks, Matrix.sub_apply, Matrix.one_apply, Matrix.zero_apply]

private theorem bmDPS_blockMat_of_eq_one_add (n f R r' : ℕ)

    (w : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (c : GaloisField 2 f) (m : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
    (hm : m * m = 0)
    (hw : (w : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 + c • m) :
    bmDPS_blockMat n f (R + 1) r' w =
      1 + c • (Matrix.fromBlocks m
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (Matrix.fromBlocks (Matrix.transpose m)
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) := by
  have hmc : (c • m) * (c • m) = 0 := by
    rw [Matrix.smul_mul, Matrix.mul_smul, hm, smul_zero, smul_zero]
  have hww : w * w = 1 := by
    apply Subtype.ext
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_one, hw]
    rw [Matrix.add_mul, Matrix.one_mul, Matrix.mul_add, Matrix.mul_one, hmc, add_zero]
    rw [add_assoc, CharTwo.add_self_eq_zero, add_zero]
  have hwinv : w⁻¹ = w := inv_eq_of_mul_eq_one_right hww
  unfold bmDPS_blockMat
  rw [hwinv, hw]
  ext p q
  rcases p with a | (b | d) <;> rcases q with a' | (b' | d') <;>
    simp [Matrix.fromBlocks, Matrix.transpose_apply, Matrix.add_apply, Matrix.smul_apply,
      Matrix.one_apply, Matrix.zero_apply]

private theorem bmDPS_altSiegel_preimage_root_exists
    (n f : ℕ)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hJ'range : J' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).range)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f)
    (haorth : a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0)
    (hle : altSiegelGroup (bmDPS_J n f) a₁ a₂ ≤
      J'.map (CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) :
    ∃ x₁ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      ((((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ x₁)) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
        1 + (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
          Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁)) := by
  set τ : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f) :=
    Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
      Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁) with hτ
  have hτ2 : τ * τ = 0 := by
    rw [hτ]; exact bmDPS_tau_sq n f a₁ a₂ haorth
  have hsq : (1 + τ) * (1 + τ) = 1 := by
    rw [Matrix.add_mul, Matrix.one_mul, Matrix.mul_add, Matrix.mul_one, hτ2, add_zero,
      add_assoc]
    ext i j
    simp only [Matrix.add_apply, Matrix.one_apply]
    split_ifs <;> simp [CharTwo.add_self_eq_zero]
  let g : GL (Fin n ⊕ Fin n) (GaloisField 2 f) := Units.mk (1 + τ) (1 + τ) hsq hsq
  have hgA : g ∈ altSiegelGroup (bmDPS_J n f) a₁ a₂ :=
    Subgroup.subset_closure ⟨1, by rw [one_smul]⟩
  have hle' : altSiegelGroup (bmDPS_J n f) a₁ a₂ ≤
      ((((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp
        (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)).range) := by
    rw [MonoidHom.range_comp, ← hJ'range]
    exact hle
  obtain ⟨x₁, hx₁⟩ := hle' hgA
  refine ⟨x₁, ?_⟩
  have hx₁' : (((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
      ((bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ) x₁)) = g := hx₁
  rw [hx₁']

private theorem bmDPS_altSiegel_preimage_root_sq_zero
    (n f : ℕ)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f)
    (haorth : a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0)
    (x₁ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (hx₁ : ((((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ x₁)) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
        1 + (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
          Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁))) :
    ((x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1) *
      ((x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1) = 0 := by
  have hC : Function.Injective ((((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp
      (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ))) := by
    intro a b h
    exact bmDPS_embedHom_injective n f (R + 1) r' eidx hPP hPinvP hP hJ (Subtype.ext h)
  set τ : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f) :=
    Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
      Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁) with hτ
  have hτ2 : τ * τ = 0 := by rw [hτ]; exact bmDPS_tau_sq n f a₁ a₂ haorth
  have hsq : (1 + τ) * (1 + τ) = 1 := by
    rw [Matrix.add_mul, Matrix.one_mul, Matrix.mul_add, Matrix.mul_one, hτ2, add_zero, add_assoc]
    ext i j
    simp only [Matrix.add_apply, Matrix.one_apply]
    rw [CharTwo.add_self_eq_zero, add_zero]
  have hx1sq : x₁ * x₁ = 1 := by
    apply hC
    rw [map_mul, map_one]
    refine Units.ext ?_
    rw [Units.val_mul, MonoidHom.comp_apply]
    rw [hx₁, Units.val_one]
    exact hsq
  have hcoe : (x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
      (x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 := by
    rw [← Matrix.SpecialLinearGroup.coe_mul, hx1sq, Matrix.SpecialLinearGroup.coe_one]
  have hpoly : ((x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1) *
      ((x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1) =
      (x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
        (x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) -
        (x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) -
        (x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) + 1 := by
    noncomm_ring
  rw [hpoly, hcoe]
  ext i j
  simp only [Matrix.sub_apply, Matrix.add_apply, Matrix.one_apply, Matrix.zero_apply]
  by_cases hij : i = j <;> simp only [hij, ↓reduceIte] <;>
    ring_nf <;> simp [CharTwo.two_eq_zero]

private theorem bmDPS_blockMat_transvection_iff (n f R r' : ℕ)

    (x₁ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (c : GaloisField 2 f)
    (hm : ((x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1) *
      ((x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1) = 0) :
    (bmDPS_blockMat n f (R + 1) r' x =
        1 + c • (bmDPS_blockMat n f (R + 1) r' x₁ - 1)) ↔
      ((x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) =
        1 + c • ((x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1)) := by
  constructor
  · intro h
    ext i j
    have := congrFun (congrFun h (Sum.inl i)) (Sum.inl j)
    simpa [bmDPS_blockMat, Matrix.fromBlocks, Matrix.add_apply, Matrix.sub_apply,
      Matrix.smul_apply, Matrix.one_apply] using this
  · intro hx
    set m : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f) :=
      (x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1 with hm'
    have hm2 : m * m = 0 := hm
    have hx1 : (x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 + m := by
      rw [hm']; abel
    have hx1sq : x₁ * x₁ = 1 := by
      apply Subtype.ext
      rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_one, hx1]
      rw [Matrix.add_mul, Matrix.one_mul, Matrix.mul_add, Matrix.mul_one, hm2, add_zero,
        add_assoc]
      ext i j
      simp only [Matrix.add_apply, Matrix.one_apply]
      rw [CharTwo.add_self_eq_zero, add_zero]
    have hx1inv : ((x₁⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
        Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) =
        (x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) := by
      rw [show x₁⁻¹ = x₁ from inv_eq_of_mul_eq_one_right hx1sq]
    have hsub : bmDPS_blockMat n f (R + 1) r' x₁ - 1 =
        Matrix.fromBlocks m 0 0 (Matrix.fromBlocks (Matrix.transpose m) 0 0 0) := by
      rw [bmDPS_blockMat_sub_one, ← hm']
      congr 1
      rw [hx1inv, hx1, Matrix.transpose_add, Matrix.transpose_one]
      abel
    rw [hsub]
    exact bmDPS_blockMat_of_eq_one_add n f R r' x c m hm2 hx

private theorem bmDPS_conj_tau_reindex (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1)
    (x₁ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (τ : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hx₁ : Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁) * P = 1 + τ) :
    P * τ * Pinv = Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁) - 1 := by
  have h' : Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁) =
      1 + P * τ * Pinv := by
    calc Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁)
        = (P * Pinv) * Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁) *
            (P * Pinv) := by rw [hPP, Matrix.one_mul, Matrix.mul_one]
      _ = P * (Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁) * P) *
            Pinv := by noncomm_ring
      _ = P * (1 + τ) * Pinv := by rw [hx₁]
      _ = 1 + P * τ * Pinv := by
            rw [Matrix.mul_add, Matrix.mul_one, Matrix.add_mul, hPP]
  rw [h']; abel

private theorem bmDPS_embedHom_coe_blockMat (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (y : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    ((((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
        (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ y)) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
      Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' y) * P := by
  exact bmDPS_embedGL_coe n f (R + 1) r' eidx hPP hPinvP y

private theorem bmDPS_C_eq_iff_reindex (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (x₁ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (τ : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (c : GaloisField 2 f)
    (hx₁ : Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁) * P = 1 + τ) :
    ((((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
        (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ x)) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) = 1 + c • τ ↔
    (Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x) =
      1 + c • (Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁) - 1)) := by
  rw [bmDPS_embedHom_coe_blockMat n f R r' eidx hPP hPinvP hP hJ x]
  have hτ : P * τ * Pinv =
      Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁) - 1 :=
    bmDPS_conj_tau_reindex n f R r' eidx hPP x₁ τ hx₁
  have hdist : ∀ d : GaloisField 2 f, P * (1 + d • τ) * Pinv = 1 + d • (P * τ * Pinv) := by
    intro d
    rw [Matrix.mul_add, Matrix.mul_one, Matrix.mul_smul, Matrix.add_mul, hPP, Matrix.smul_mul]
  constructor
  · intro h
    have h2 : Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x) =
        P * (1 + c • τ) * Pinv := by
      calc Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x)
          = (P * Pinv) * Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x) *
              (P * Pinv) := by rw [hPP, Matrix.one_mul, Matrix.mul_one]
        _ = P * (Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x) * P) *
              Pinv := by noncomm_ring
        _ = P * (1 + c • τ) * Pinv := by rw [h]
    rw [h2, hdist c, hτ]
  · intro h
    rw [h, ← hτ]
    rw [Matrix.mul_add, Matrix.mul_one, Matrix.mul_smul, Matrix.add_mul, hPinvP,
      Matrix.smul_mul]
    congr 1
    congr 1
    calc Pinv * (P * τ * Pinv) * P = (Pinv * P) * τ * (Pinv * P) := by noncomm_ring
      _ = τ := by rw [hPinvP, Matrix.one_mul, Matrix.mul_one]

private theorem bmDPS_reindex_blockMat_iff (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (x₁ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (c : GaloisField 2 f) :
    (Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x) =
      1 + c • (Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁) - 1)) ↔
    (bmDPS_blockMat n f (R + 1) r' x =
      1 + c • (bmDPS_blockMat n f (R + 1) r' x₁ - 1)) := by
  set φ := Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx with hφ
  change (φ (bmDPS_blockMat n f (R + 1) r' x) =
      1 + c • (φ (bmDPS_blockMat n f (R + 1) r' x₁) - 1)) ↔
    (bmDPS_blockMat n f (R + 1) r' x =
      1 + c • (bmDPS_blockMat n f (R + 1) r' x₁ - 1))
  constructor
  · intro h
    apply φ.injective
    rw [h, map_add, map_one, map_smul, map_sub, map_one]
  · intro h
    have hh := congrArg φ h
    rw [map_add, map_one, map_smul, map_sub, map_one] at hh
    exact hh

private theorem bmDPS_altSiegel_preimage_root_block_iff
    (n f : ℕ)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f)
    (x₁ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (hx₁ : ((((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ x₁)) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
        1 + (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
          Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁)))
    (hm : ((x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1) *
      ((x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1) = 0)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (c : GaloisField 2 f) :
    (((((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ x)) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
        1 + c • (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
          Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁))) ↔
      ((x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) =
        1 + c • ((x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1)) := by
  set τ : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f) :=
    Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
      Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁) with hτ
  have hx₁' : Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁) * P =
      1 + τ := by
    rw [← bmDPS_embedHom_coe_blockMat n f R r' eidx hPP hPinvP hP hJ x₁]
    exact hx₁
  rw [bmDPS_C_eq_iff_reindex n f R r' eidx hPP hPinvP hP hJ x₁ x τ c hx₁',
    bmDPS_reindex_blockMat_iff n f R r' eidx x₁ x c,
    bmDPS_blockMat_transvection_iff n f R r' x₁ x c hm]

private theorem bmDPS_col_add {m n : Type*} (F : Type) [Semiring F] (A B : Matrix m n F) (k : n) :
    (A + B).col k = A.col k + B.col k := by
  rw [Matrix.col, Matrix.col, Matrix.col, Matrix.transpose_add]
  rfl

private theorem bmDPS_vecMulVec_col {n : Type*} (F : Type) [CommSemiring F] (u v : n → F) (k : n) :
    (Matrix.vecMulVec u v).col k = v k • u := by
  funext i
  simp [Matrix.col, Matrix.transpose_apply, Matrix.vecMulVec_apply, Pi.smul_apply, mul_comm]

private theorem bmDPS_tau_col_mem_span_pair (n f : ℕ)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f) (k : Fin n ⊕ Fin n) :
    (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
      Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁)).col k ∈
      Submodule.span (GaloisField 2 f)
        ({a₁, a₂} : Set ((Fin n ⊕ Fin n) → GaloisField 2 f)) := by
  rw [bmDPS_col_add, bmDPS_vecMulVec_col, bmDPS_vecMulVec_col]
  exact Submodule.add_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))
    (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))

private theorem bmDPS_span_pair_eq_sup (n f : ℕ)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f) :
    Submodule.span (GaloisField 2 f)
        ({a₁, a₂} : Set ((Fin n ⊕ Fin n) → GaloisField 2 f)) =
      Submodule.span (GaloisField 2 f)
          ({a₁} : Set ((Fin n ⊕ Fin n) → GaloisField 2 f)) ⊔
        Submodule.span (GaloisField 2 f)
          ({a₂} : Set ((Fin n ⊕ Fin n) → GaloisField 2 f)) := by
  rw [show ({a₁, a₂} : Set ((Fin n ⊕ Fin n) → GaloisField 2 f)) = insert a₁ {a₂} from rfl,
    Submodule.span_insert]

private theorem bmDPS_finrank_span_singleton_le_one (n f : ℕ)
    (a : (Fin n ⊕ Fin n) → GaloisField 2 f) :
    Module.finrank (GaloisField 2 f) (Submodule.span (GaloisField 2 f)
      ({a} : Set ((Fin n ⊕ Fin n) → GaloisField 2 f))) ≤ 1 := by
  refine finrank_le_one (R := GaloisField 2 f)
    ⟨a, Submodule.subset_span (by simp)⟩ ?_
  rintro ⟨w, hw⟩
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hw
  exact ⟨c, Subtype.ext hc⟩

private theorem bmDPS_finrank_sup_le (n f : ℕ)
    (S T : Submodule (GaloisField 2 f) ((Fin n ⊕ Fin n) → GaloisField 2 f)) :
    Module.finrank (GaloisField 2 f) ↥(S ⊔ T) ≤
      Module.finrank (GaloisField 2 f) S + Module.finrank (GaloisField 2 f) T := by
  have h := Submodule.finrank_sup_add_finrank_inf_eq S T
  omega

private theorem bmDPS_span_pair_finrank_le_two (n f : ℕ)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f) :
    Module.finrank (GaloisField 2 f) (Submodule.span (GaloisField 2 f)
      ({a₁, a₂} : Set ((Fin n ⊕ Fin n) → GaloisField 2 f))) ≤ 2 := by
  rw [bmDPS_span_pair_eq_sup n f a₁ a₂]
  calc Module.finrank (GaloisField 2 f) ↥(Submodule.span (GaloisField 2 f)
          ({a₁} : Set ((Fin n ⊕ Fin n) → GaloisField 2 f)) ⊔
        Submodule.span (GaloisField 2 f)
          ({a₂} : Set ((Fin n ⊕ Fin n) → GaloisField 2 f)))
      ≤ Module.finrank (GaloisField 2 f) ↥(Submodule.span (GaloisField 2 f)
            ({a₁} : Set ((Fin n ⊕ Fin n) → GaloisField 2 f))) +
          Module.finrank (GaloisField 2 f) ↥(Submodule.span (GaloisField 2 f)
            ({a₂} : Set ((Fin n ⊕ Fin n) → GaloisField 2 f))) :=
        bmDPS_finrank_sup_le n f _ _
    _ ≤ 1 + 1 := add_le_add (bmDPS_finrank_span_singleton_le_one n f a₁)
        (bmDPS_finrank_span_singleton_le_one n f a₂)
    _ = 2 := by norm_num

private theorem bmDPS_tau_rank_le_two (n f : ℕ)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f) :
    (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
      Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁)).rank ≤ 2 := by
  rw [Matrix.rank_eq_finrank_span_cols]
  refine le_trans (Submodule.finrank_mono ?_) (bmDPS_span_pair_finrank_le_two n f a₁ a₂)
  rw [Submodule.span_le]
  rintro _ ⟨k, rfl⟩
  exact bmDPS_tau_col_mem_span_pair n f a₁ a₂ k

private theorem bmDPS_blockMat_sub_one_of_sq_zero (n f R r' : ℕ)

    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (m : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
    (hx : (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 + m)
    (hm : m * m = 0) :
    bmDPS_blockMat n f (R + 1) r' x - 1 =
      Matrix.fromBlocks m
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (Matrix.fromBlocks (Matrix.transpose m)
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) := by
  have hx1sq : x * x = 1 := by
    apply Subtype.ext
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_one, hx]
    rw [Matrix.add_mul, Matrix.one_mul, Matrix.mul_add, Matrix.mul_one, hm, add_zero, add_assoc]
    ext i j
    simp only [Matrix.add_apply, Matrix.one_apply]
    rw [CharTwo.add_self_eq_zero, add_zero]
  have hxinv : ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
      Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) =
      (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) := by
    rw [show x⁻¹ = x from inv_eq_of_mul_eq_one_right hx1sq]
  rw [bmDPS_blockMat_sub_one]
  congr 1
  · rw [hx]; abel
  · rw [hxinv, hx, Matrix.transpose_add, Matrix.transpose_one]; abel

private theorem bmDPS_rank_blockMat_sub_one_of_sq_zero (n f R r' : ℕ)

    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (m : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
    (hx : (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 + m)
    (hm : m * m = 0) :
    (bmDPS_blockMat n f (R + 1) r' x - 1).rank = 2 * m.rank := by
  rw [bmDPS_blockMat_sub_one_of_sq_zero n f R r' x m hx hm,
    bmDPS_rank_fromBlocks_zero (GaloisField 2 f),
    bmDPS_rank_fromBlocks_zero (GaloisField 2 f), Matrix.rank_transpose,
    Matrix.rank_zero]
  ring

private theorem bmDPS_rank_blockMat_sub_one_le_two (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f)
    (x₁ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (hx₁ : ((((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ x₁)) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
        1 + (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
          Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁))) :
    (bmDPS_blockMat n f (R + 1) r' x₁ - 1).rank ≤ 2 := by
  set τex : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f) :=
    Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
      Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁) with hτex
  have hτ' : Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁) * P =
      1 + τex := by
    rw [← bmDPS_embedHom_coe_blockMat n f R r' eidx hPP hPinvP hP hJ x₁, hτex]
    exact hx₁
  have hconj : Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁ - 1) =
      P * τex * Pinv := by
    change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmDPS_blockMat n f (R + 1) r' x₁ - 1) = P * τex * Pinv
    rw [map_sub, map_one]
    exact (bmDPS_conj_tau_reindex n f R r' eidx hPP x₁ τex hτ').symm
  calc (bmDPS_blockMat n f (R + 1) r' x₁ - 1).rank
      = (Matrix.reindex eidx eidx (bmDPS_blockMat n f (R + 1) r' x₁ - 1)).rank :=
        (Matrix.rank_reindex eidx eidx _).symm
    _ = (P * τex * Pinv).rank := by rw [hconj]
    _ ≤ τex.rank := le_trans (Matrix.rank_mul_le_left (P * τex) Pinv)
        (Matrix.rank_mul_le_right P τex)
    _ ≤ 2 := bmDPS_tau_rank_le_two n f a₁ a₂

private theorem bmDPS_altSiegel_preimage_block_rank
    (n f : ℕ)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f)
    (haorth : a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0)
    (x₁ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (hx₁ : ((((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ x₁)) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
        1 + (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
          Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁))) :
    ((x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1).rank ≤ 1 := by
  set m : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f) :=
    (x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1 with hm'
  have hm : m * m = 0 := by
    rw [hm']
    exact bmDPS_altSiegel_preimage_root_sq_zero n f eidx hPP hPinvP hP hJ a₁ a₂
      haorth x₁ hx₁
  have hx : (x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 + m := by
    rw [hm']; abel
  have h1 : (bmDPS_blockMat n f (R + 1) r' x₁ - 1).rank = 2 * m.rank :=
    bmDPS_rank_blockMat_sub_one_of_sq_zero n f R r' x₁ m hx hm
  have h2 : (bmDPS_blockMat n f (R + 1) r' x₁ - 1).rank ≤ 2 :=
    bmDPS_rank_blockMat_sub_one_le_two n f R r' eidx hPP hPinvP hP hJ a₁ a₂ x₁ hx₁
  omega

private theorem bmDPS_toGL_injective (R f : ℕ) :
    Function.Injective (Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
      (R := GaloisField 2 f)) := by
  intro a b h
  exact Subtype.ext (congrArg (fun z : GL (Fin (R + 1)) (GaloisField 2 f) =>
    (z : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) h)

private theorem bmDPS_map_comap_closure_toGL (R f : ℕ)
    (s : Set (GL (Fin (R + 1)) (GaloisField 2 f)))
    (hs : s ⊆ (Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
      (R := GaloisField 2 f)).range) :
    Subgroup.map (Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
        (R := GaloisField 2 f))
      (Subgroup.comap (Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
        (R := GaloisField 2 f)) (Subgroup.closure s)) =
      Subgroup.closure s := by
  rw [Subgroup.map_comap_eq]
  exact inf_of_le_right ((Subgroup.closure_le (K :=
    (Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1)) (R := GaloisField 2 f)).range)).mpr hs)

private theorem bmDPS_map_closure_preimage_toGL (R f : ℕ)
    (s : Set (GL (Fin (R + 1)) (GaloisField 2 f)))
    (hs : s ⊆ (Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
      (R := GaloisField 2 f)).range) :
    Subgroup.map (Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
        (R := GaloisField 2 f))
      (Subgroup.closure ((Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
        (R := GaloisField 2 f)) ⁻¹' s)) =
      Subgroup.closure s := by
  rw [MonoidHom.map_closure, Set.image_preimage_eq_inter_range]
  congr 1
  exact Set.inter_eq_left.mpr (by simpa using hs)

private theorem bmDPS_comap_toGL_closure (R f : ℕ)
    (s : Set (GL (Fin (R + 1)) (GaloisField 2 f)))
    (hs : s ⊆ (Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
      (R := GaloisField 2 f)).range) :
    Subgroup.comap (Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
        (R := GaloisField 2 f)) (Subgroup.closure s) =
      Subgroup.closure ((Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
        (R := GaloisField 2 f)) ⁻¹' s) := by
  apply Subgroup.map_injective (bmDPS_toGL_injective R f)
  rw [bmDPS_map_comap_closure_toGL R f s hs, bmDPS_map_closure_preimage_toGL R f s hs]

private theorem bmDPS_vecMulVec_eq_replicate (R f : ℕ)
    (v φ : Fin R → GaloisField 2 f) :
    Matrix.vecMulVec v φ = Matrix.replicateCol (Fin 1) v * Matrix.replicateRow (Fin 1) φ := by
  ext i j
  simp [Matrix.vecMulVec_apply, Matrix.mul_apply, Matrix.replicateCol, Matrix.replicateRow]

private theorem bmDPS_det_one_add_vecMulVec (R f : ℕ)
    (v φ : Fin R → GaloisField 2 f) :
    (1 + Matrix.vecMulVec v φ).det = 1 + φ ⬝ᵥ v := by
  rw [bmDPS_vecMulVec_eq_replicate]
  rw [Matrix.det_one_add_mul_comm (Matrix.replicateCol (Fin 1) v)
      (Matrix.replicateRow (Fin 1) φ), Matrix.det_unique]
  simp [Matrix.add_apply, Matrix.one_apply, Matrix.mul_apply, Matrix.replicateCol,
    Matrix.replicateRow, dotProduct]

private theorem bmDPS_smul_vecMulVec (R f : ℕ)
    (v φ : Fin R → GaloisField 2 f) (c : GaloisField 2 f) :
    c • Matrix.vecMulVec v φ = Matrix.vecMulVec (c • v) φ := by
  ext i j
  simp only [Matrix.vecMulVec_apply, Matrix.smul_apply, Pi.smul_apply, smul_eq_mul]
  ring

private theorem bmDPS_det_one_add_smul_vecMulVec (R f : ℕ)
    (v φ : Fin R → GaloisField 2 f) (h : φ ⬝ᵥ v = 0) (c : GaloisField 2 f) :
    (1 + c • Matrix.vecMulVec v φ).det = 1 := by
  rw [bmDPS_smul_vecMulVec, bmDPS_det_one_add_vecMulVec, dotProduct_smul, h, smul_zero, add_zero]

private theorem bmDPS_vecMulVec_mul_self (R f : ℕ)
    (v φ : Fin R → GaloisField 2 f) :
    Matrix.vecMulVec v φ * Matrix.vecMulVec v φ =
      (φ ⬝ᵥ v) • Matrix.vecMulVec v φ := by
  rw [Matrix.vecMulVec_mul_vecMulVec, Matrix.vecMulVec_smul]

private theorem bmDPS_dotProduct_eq_zero_of_vecMulVec_sq_zero (R f : ℕ)
    (v φ : Fin R → GaloisField 2 f)
    (h : Matrix.vecMulVec v φ * Matrix.vecMulVec v φ = 0) :
    φ ⬝ᵥ v = 0 := by
  have hsq : (φ ⬝ᵥ v) • Matrix.vecMulVec v φ = 0 := by
    rw [← bmDPS_vecMulVec_mul_self]; exact h
  rcases eq_or_ne (Matrix.vecMulVec v φ) 0 with hm0 | hm0
  · rcases (Matrix.vecMulVec_eq_zero.mp hm0) with hv | hφ
    · rw [hv]; simp
    · rw [hφ]; simp
  · exact (smul_eq_zero.mp hsq).resolve_right hm0

private theorem bmDPS_generators_subset_range_toGL (R f : ℕ)
    (v φ : Fin R → GaloisField 2 f) (h : φ ⬝ᵥ v = 0) :
    {g : GL (Fin R) (GaloisField 2 f) | ∃ c : GaloisField 2 f,
      (g : Matrix (Fin R) (Fin R) (GaloisField 2 f)) = 1 + c • Matrix.vecMulVec v φ} ⊆
      (Matrix.SpecialLinearGroup.toGL (n := Fin R) (R := GaloisField 2 f)).range := by
  rintro g ⟨c, hg⟩
  rw [Matrix.SpecialLinearGroup.range_toGL_eq_ker_det]
  change Matrix.GeneralLinearGroup.det g = 1
  apply Units.ext
  rw [Matrix.GeneralLinearGroup.val_det_apply, hg]
  simpa using bmDPS_det_one_add_smul_vecMulVec R f v φ h c

private theorem bmDPS_conj_vecMulVec' {m : Type*} [Fintype m]
    (F : Type) [Field F] (A B : Matrix m m F) (u v : m → F) :
    A * Matrix.vecMulVec u v * B =
      Matrix.vecMulVec (Matrix.mulVec A u) (Matrix.mulVec (Matrix.transpose B) v) := by
  ext i k
  simp only [Matrix.mul_apply, Matrix.vecMulVec_apply, Matrix.mulVec, dotProduct]
  rw [Finset.sum_mul_sum, Finset.sum_comm]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl (fun l _ => ?_)
  rw [Matrix.transpose_apply]
  ring

private theorem bmDPS_coe_conj_toGL (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (h : GL (Fin R') (GaloisField 2 f)) :
    ((MulAut.conj (Matrix.SpecialLinearGroup.toGL g)) h :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)) =
    (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) *
      (h : Matrix (Fin R') (Fin R') (GaloisField 2 f)) *
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)) := by
  rw [MulAut.conj_apply, Units.val_mul, Units.val_mul,
    show (Matrix.SpecialLinearGroup.toGL g)⁻¹ = Matrix.SpecialLinearGroup.toGL g⁻¹ from
      (map_inv _ _).symm,
    Matrix.SpecialLinearGroup.coe_GL_coe_matrix g,
    Matrix.SpecialLinearGroup.coe_GL_coe_matrix g⁻¹]

private theorem bmDPS_coe_conj_toGL_inv (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (h : GL (Fin R') (GaloisField 2 f)) :
    (((MulAut.conj (Matrix.SpecialLinearGroup.toGL g))⁻¹) h :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)) =
    ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)) *
      (h : Matrix (Fin R') (Fin R') (GaloisField 2 f)) *
      (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) := by
  rw [MulAut.conj_inv_apply, Units.val_mul, Units.val_mul,
    show (Matrix.SpecialLinearGroup.toGL g)⁻¹ = Matrix.SpecialLinearGroup.toGL g⁻¹ from
      (map_inv _ _).symm,
    Matrix.SpecialLinearGroup.coe_GL_coe_matrix g,
    Matrix.SpecialLinearGroup.coe_GL_coe_matrix g⁻¹]

private theorem bmDPS_map_conj_matTransvGroup_le (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (v φ : Fin R' → GaloisField 2 f) :
    Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g)).toMonoidHom
      (matTransvGroup v φ) ≤
      matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) := by
  rw [matTransvGroup, MonoidHom.map_closure, matTransvGroup, Subgroup.closure_le]
  rintro h ⟨h₀, ⟨c, hc⟩, rfl⟩
  refine Subgroup.subset_closure ⟨c, ?_⟩
  have hgg : (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) *
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)) = 1 := by
    rw [← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel, Matrix.SpecialLinearGroup.coe_one]
  rw [show (MulEquiv.toMonoidHom (MulAut.conj (Matrix.SpecialLinearGroup.toGL g))) h₀ =
      (MulAut.conj (Matrix.SpecialLinearGroup.toGL g)) h₀ from rfl]
  rw [bmDPS_coe_conj_toGL R' f g h₀, hc, Matrix.mul_add, Matrix.mul_one, Matrix.mul_smul,
    Matrix.add_mul, Matrix.smul_mul,
    bmDPS_conj_vecMulVec' (GaloisField 2 f) (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)) v φ, hgg]

private theorem bmDPS_map_conj_matTransvGroup_ge (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (v φ : Fin R' → GaloisField 2 f) :
    matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) ≤
      Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g)).toMonoidHom
        (matTransvGroup v φ) := by
  have hgg' : ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)) *
      (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) = 1 := by
    rw [← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel, Matrix.SpecialLinearGroup.coe_one]
  simp only [matTransvGroup]
  rw [MonoidHom.map_closure, Subgroup.closure_le]
  rintro h ⟨c, hc⟩
  refine Subgroup.subset_closure ⟨(MulAut.conj (Matrix.SpecialLinearGroup.toGL g))⁻¹ h,
    ⟨c, ?_⟩, by
      simp only [MulEquiv.coe_toMonoidHom, zpow_neg_one, MulEquiv.inv_apply]
      exact MulEquiv.apply_symm_apply _ _⟩
  rw [bmDPS_coe_conj_toGL_inv R' f g h, hc, Matrix.mul_add, Matrix.mul_one, Matrix.mul_smul,
    Matrix.add_mul, Matrix.smul_mul,
    bmDPS_conj_vecMulVec' (GaloisField 2 f)
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))
      (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
      (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
      (Matrix.mulVec (Matrix.transpose ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
          :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ),
    hgg', Matrix.mulVec_mulVec, hgg', Matrix.one_mulVec,
    Matrix.mulVec_mulVec, ← Matrix.transpose_mul, hgg', Matrix.transpose_one,
    Matrix.one_mulVec]

private theorem bmDPS_conj_matTransvGroup (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (v φ : Fin R' → GaloisField 2 f) :
    Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g)).toMonoidHom
      (matTransvGroup v φ) =
      matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) := by
  exact le_antisymm (bmDPS_map_conj_matTransvGroup_le R' f g v φ)
    (bmDPS_map_conj_matTransvGroup_ge R' f g v φ)

private theorem bmDPS_exists_sl_map_vec (R' f : ℕ)
    (v₁ v₂ : Fin R' → GaloisField 2 f) (hv₁ : v₁ ≠ 0) (hv₂ : v₂ ≠ 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f), ∃ c : GaloisField 2 f,
      c ≠ 0 ∧
      Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v₁ = c • v₂ := by
  haveI : NeZero R' := ⟨fun h => hv₁ (by subst h; exact Subsingleton.elim _ _)⟩
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq
    (M := Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (Projectivization.mk (GaloisField 2 f) v₁ hv₁)
    (Projectivization.mk (GaloisField 2 f) v₂ hv₂)
  rw [Projectivization.smul_mk] at hg
  obtain ⟨a, ha⟩ := (Projectivization.mk_eq_mk_iff (GaloisField 2 f) (g • v₁) v₂ _ hv₂).mp hg
  exact ⟨g, (a : GaloisField 2 f), a.ne_zero, ha.symm⟩

private noncomputable def bmDPS_wStd (R' f : ℕ) (j : Fin R')
    (u φ : Fin R' → GaloisField 2 f) : Fin R' → GaloisField 2 f :=
  (u j)⁻¹ • ((u j * (u ⬝ᵥ φ)⁻¹) • φ - Pi.single j (1 : GaloisField 2 f))

private theorem bmDPS_exists_coord_ne_zero (R' f : ℕ) (φ : Fin R' → GaloisField 2 f)
    (hφ : φ ≠ 0) : ∃ i, φ i ≠ 0 := by
  by_contra h
  simp only [not_exists, not_not] at h
  exact hφ (funext h)

private theorem bmDPS_single_apply_self (R' f : ℕ) (j : Fin R') :
    (Pi.single j (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) j ≠ 0 := by
  rw [Pi.single_eq_same]
  exact one_ne_zero

private theorem bmDPS_single_dotProduct_vec (R' f : ℕ) (j : Fin R')
    (φ : Fin R' → GaloisField 2 f) :
    (Pi.single j (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) ⬝ᵥ φ = φ j := by
  rw [dotProduct, Finset.sum_eq_single j]
  · rw [Pi.single_eq_same, one_mul]
  · intro b _ hb
    rw [Pi.single_eq_of_ne hb, zero_mul]
  · intro h; exact absurd (Finset.mem_univ j) h

private theorem bmDPS_single_add_apply_self (R' f : ℕ) (i j : Fin R') (hij : i ≠ j) :
    (Pi.single j (1 : GaloisField 2 f) + Pi.single i 1 : Fin R' → GaloisField 2 f) j ≠ 0 := by
  have hji : j ≠ i := Ne.symm hij
  simp [Pi.single_eq_same, Pi.single_eq_of_ne, hji, one_ne_zero]

private theorem bmDPS_single_add_dotProduct (R' f : ℕ) (i j : Fin R')
    (φ : Fin R' → GaloisField 2 f) :
    (Pi.single j (1 : GaloisField 2 f) + Pi.single i 1 : Fin R' → GaloisField 2 f) ⬝ᵥ φ
      = φ j + φ i := by
  rw [add_dotProduct, bmDPS_single_dotProduct_vec, bmDPS_single_dotProduct_vec]

private theorem bmDPS_exists_u_dot_ne_zero (R' f : ℕ) (j : Fin R') (φ : Fin R' → GaloisField 2 f)
    (hφ : φ ≠ 0) : ∃ u : Fin R' → GaloisField 2 f, u j ≠ 0 ∧ u ⬝ᵥ φ ≠ 0 := by
  by_cases hj : φ j = 0
  · obtain ⟨i, hi⟩ := bmDPS_exists_coord_ne_zero R' f φ hφ
    have hij : i ≠ j := fun h => hi (by rw [h]; exact hj)
    refine ⟨Pi.single j (1 : GaloisField 2 f) + Pi.single i 1, ?_, ?_⟩
    · exact bmDPS_single_add_apply_self R' f i j hij
    · rw [bmDPS_single_add_dotProduct R' f i j φ, hj, zero_add]
      exact hi
  · refine ⟨Pi.single j (1 : GaloisField 2 f), bmDPS_single_apply_self R' f j, ?_⟩
    rw [bmDPS_single_dotProduct_vec R' f j φ]
    exact hj

private theorem bmDPS_wStd_dot_u (R' f : ℕ) (j : Fin R') (u φ : Fin R' → GaloisField 2 f) (huφ : u
    ⬝ᵥ φ ≠ 0) : bmDPS_wStd R' f j u φ ⬝ᵥ u = 0 := by
  rw [bmDPS_wStd, smul_dotProduct, sub_dotProduct, smul_dotProduct, bmDPS_single_dotProduct_vec]
  rw [dotProduct_comm φ u]
  rw [show (u j * (u ⬝ᵥ φ)⁻¹) • (u ⬝ᵥ φ) = u j from by
    rw [smul_eq_mul, mul_assoc, inv_mul_cancel₀ huφ, mul_one]]
  rw [sub_self, smul_zero]

private theorem bmDPS_wStd_apply_zero (R' f : ℕ) (hR : 1 ≤ R') (j : Fin R')
    (hj : j ≠ ⟨0, by omega⟩) (u φ : Fin R' → GaloisField 2 f)
    (h0 : φ (⟨0, by omega⟩ : Fin R') = 0) :
    bmDPS_wStd R' f j u φ (⟨0, by omega⟩ : Fin R') = 0 := by
  rw [bmDPS_wStd, Pi.smul_apply, Pi.sub_apply, Pi.smul_apply, h0, smul_zero,
    Pi.single_eq_of_ne (Ne.symm hj), sub_zero, smul_zero]

private theorem bmDPS_det_one_add_vecMulVec_phi (R' f : ℕ)
    (φ w : Fin R' → GaloisField 2 f) (h : w ⬝ᵥ φ = 0) :
    (1 + Matrix.vecMulVec φ w : Matrix (Fin R') (Fin R') (GaloisField 2 f)).det = 1 := by
  rw [bmDPS_det_one_add_vecMulVec, h, add_zero]

private theorem bmDPS_transpose_vecMulVec_phi (R' f : ℕ) (j : Fin R')
    (φ w : Fin R' → GaloisField 2 f) :
    Matrix.mulVec (Matrix.transpose (1 + Matrix.vecMulVec φ w :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)))
        (Pi.single j (1 : GaloisField 2 f)) =
      Pi.single j (1 : GaloisField 2 f) + (φ j) • w := by
  rw [Matrix.transpose_add, Matrix.transpose_one, Matrix.transpose_vecMulVec, Matrix.add_mulVec,
    Matrix.one_mulVec, Matrix.vecMulVec_mulVec,
    show φ ⬝ᵥ (Pi.single j (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) = φ j from by
      rw [dotProduct_comm]; exact bmDPS_single_dotProduct_vec R' f j φ]
  simp only [add_right_inj, op_smul_eq_smul]

private theorem bmDPS_mulVec_vecMulVec_phi (R' f : ℕ) (hR : 1 ≤ R')
    (φ w : Fin R' → GaloisField 2 f) (h : w (⟨0, by omega⟩ : Fin R') = 0) :
    Matrix.mulVec (1 + Matrix.vecMulVec φ w :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))
        (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
      Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  rw [Matrix.add_mulVec, Matrix.one_mulVec, Matrix.vecMulVec_mulVec, op_smul_eq_smul,
    show w ⬝ᵥ (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f)
        = 0 from by
      rw [dotProduct_comm, bmDPS_single_dotProduct_vec]; exact h,
    zero_smul, add_zero]

private theorem bmDPS_exists_sl_map_phi_j (R' f : ℕ) (hR : 1 ≤ R') (j : Fin R')
    (hj : j ≠ ⟨0, by omega⟩) (φ : Fin R' → GaloisField 2 f) (hφj : φ j ≠ 0)
    (h0 : φ (⟨0, by omega⟩ : Fin R') = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f), ∃ c : GaloisField 2 f,
      c ≠ 0 ∧
      Matrix.mulVec (Matrix.transpose (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)))
        (Pi.single j (1 : GaloisField 2 f)) = c • φ ∧
      Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
        (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  obtain ⟨u, huj, huφ⟩ := bmDPS_exists_u_dot_ne_zero R' f j φ (fun h => hφj (congrFun h j))
  have hdot : bmDPS_wStd R' f j u φ ⬝ᵥ u = 0 := bmDPS_wStd_dot_u R' f j u φ huφ
  have hdet : (1 + Matrix.vecMulVec u (bmDPS_wStd R' f j u φ) :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)).det = 1 :=
    bmDPS_det_one_add_vecMulVec_phi R' f u (bmDPS_wStd R' f j u φ) hdot
  refine ⟨⟨1 + Matrix.vecMulVec u (bmDPS_wStd R' f j u φ), hdet⟩, u j * (u ⬝ᵥ φ)⁻¹, ?_, ?_, ?_⟩
  · exact mul_ne_zero huj (inv_ne_zero huφ)
  · rw [Matrix.SpecialLinearGroup.coe_mk, bmDPS_transpose_vecMulVec_phi, bmDPS_wStd, smul_smul,
      mul_inv_cancel₀ huj, one_smul, add_sub_cancel]
  · rw [Matrix.SpecialLinearGroup.coe_mk]
    exact bmDPS_mulVec_vecMulVec_phi R' f hR u (bmDPS_wStd R' f j u φ)
      (bmDPS_wStd_apply_zero R' f hR j hj u φ h0)

private noncomputable def bmDPS_swapVec (R' f : ℕ) (hR : 2 ≤ R') (j : Fin R') :
    Fin R' → GaloisField 2 f :=
  Pi.single (⟨1, by omega⟩ : Fin R') 1 + Pi.single j 1

private theorem bmDPS_swapVec_apply_zero (R' f : ℕ) (hR : 2 ≤ R') (j : Fin R')
    (hj : j ≠ ⟨0, by omega⟩) :
    bmDPS_swapVec R' f hR j (⟨0, by omega⟩ : Fin R') = 0 := by
  have h1O : (⟨1, by omega⟩ : Fin R') ≠ ⟨0, by omega⟩ := by
    intro hh; exact Nat.zero_ne_one (Fin.ext_iff.mp hh).symm
  rw [bmDPS_swapVec, Pi.add_apply, Pi.single_eq_of_ne (Ne.symm h1O),
    Pi.single_eq_of_ne (Ne.symm hj), add_zero]

private theorem bmDPS_swapVec_dot_self (R' f : ℕ) (hR : 2 ≤ R') (j : Fin R')
    (hj1 : j ≠ ⟨1, by omega⟩) :
    bmDPS_swapVec R' f hR j ⬝ᵥ bmDPS_swapVec R' f hR j = 0 := by
  rw [bmDPS_swapVec, add_dotProduct, dotProduct_add, dotProduct_add,
    bmDPS_single_dotProduct_vec, bmDPS_single_dotProduct_vec, bmDPS_single_dotProduct_vec,
    bmDPS_single_dotProduct_vec, Pi.single_eq_same, Pi.single_eq_of_ne (Ne.symm hj1),
    Pi.single_eq_of_ne hj1, Pi.single_eq_same, add_zero, zero_add]
  exact CharTwo.add_self_eq_zero 1

private theorem bmDPS_swapVec_dot_one (R' f : ℕ) (hR : 2 ≤ R') (j : Fin R')
    (hj1 : j ≠ ⟨1, by omega⟩) :
    bmDPS_swapVec R' f hR j ⬝ᵥ (Pi.single (⟨1, by omega⟩ : Fin R')
      (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) = 1 := by
  rw [bmDPS_swapVec, add_dotProduct, bmDPS_single_dotProduct_vec, bmDPS_single_dotProduct_vec,
    Pi.single_eq_same, Pi.single_eq_of_ne hj1, add_zero]

private theorem bmDPS_exists_sl_swap_single (R' f : ℕ) (hR : 2 ≤ R') (j : Fin R')
    (hj : j ≠ ⟨0, by omega⟩) :
    ∃ σ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      Matrix.mulVec (σ : Matrix (Fin R') (Fin R') (GaloisField 2 f))
          (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) ∧
      Matrix.mulVec (Matrix.transpose (σ : Matrix (Fin R') (Fin R') (GaloisField 2 f)))
          (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        Pi.single j (1 : GaloisField 2 f) := by
  by_cases hj1 : j = (⟨1, by omega⟩ : Fin R')
  · subst hj1
    refine ⟨1, ?_, ?_⟩
    · rw [Matrix.SpecialLinearGroup.coe_one, Matrix.one_mulVec]
    · rw [Matrix.SpecialLinearGroup.coe_one, Matrix.transpose_one, Matrix.one_mulVec]
  · have hdet : (1 + Matrix.vecMulVec (bmDPS_swapVec R' f hR j) (bmDPS_swapVec R' f hR j) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)).det = 1 :=
      bmDPS_det_one_add_vecMulVec_phi R' f _ _ (bmDPS_swapVec_dot_self R' f hR j hj1)
    refine ⟨⟨1 + Matrix.vecMulVec (bmDPS_swapVec R' f hR j) (bmDPS_swapVec R' f hR j), hdet⟩,
      ?_, ?_⟩
    · rw [Matrix.SpecialLinearGroup.coe_mk, Matrix.add_mulVec, Matrix.one_mulVec,
        Matrix.vecMulVec_mulVec, op_smul_eq_smul,
        show bmDPS_swapVec R' f hR j ⬝ᵥ (Pi.single (⟨0, by omega⟩ : Fin R')
            (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) = 0 from by
          rw [dotProduct_comm, bmDPS_single_dotProduct_vec]
          exact bmDPS_swapVec_apply_zero R' f hR j hj,
        zero_smul, add_zero]
    · rw [Matrix.SpecialLinearGroup.coe_mk, Matrix.transpose_add, Matrix.transpose_one,
        Matrix.transpose_vecMulVec, Matrix.add_mulVec, Matrix.one_mulVec, Matrix.vecMulVec_mulVec,
        op_smul_eq_smul,
        show bmDPS_swapVec R' f hR j ⬝ᵥ (Pi.single (⟨1, by omega⟩ : Fin R')
            (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) = 1 from
          bmDPS_swapVec_dot_one R' f hR j hj1,
        one_smul]
      rw [bmDPS_swapVec, ← add_assoc]
      rw [show (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) :
              Fin R' → GaloisField 2 f) + (Pi.single (⟨1, by omega⟩ : Fin R')
              (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) = 0 from by
          funext i; exact CharTwo.add_self_eq_zero _
        , zero_add]

private noncomputable def bmDPS_diagVec (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f) :
    Fin R' → GaloisField 2 f :=
  fun i => if i = (⟨0, by omega⟩ : Fin R') then 1
    else if i = (⟨1, by omega⟩ : Fin R') then c⁻¹
    else if i = (⟨2, by omega⟩ : Fin R') then c else 1

private theorem bmDPS_diagVec_apply_zero (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f) :
    bmDPS_diagVec R' f hR3 c (⟨0, by omega⟩ : Fin R') = 1 := by
  simp [bmDPS_diagVec]

private theorem bmDPS_diagVec_apply_one (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f) :
    bmDPS_diagVec R' f hR3 c (⟨1, by omega⟩ : Fin R') = c⁻¹ := by
  have h : (⟨1, by omega⟩ : Fin R') ≠ ⟨0, by omega⟩ := by
    intro hh; exact Nat.zero_ne_one (Fin.ext_iff.mp hh).symm
  simp [bmDPS_diagVec, h]

private theorem bmDPS_diagVec_apply_two (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f) :
    bmDPS_diagVec R' f hR3 c (⟨2, by omega⟩ : Fin R') = c := by
  have h20 : (⟨2, by omega⟩ : Fin R') ≠ ⟨0, by omega⟩ := by
    intro hh
    have hh' := Fin.ext_iff.mp hh
    simp only [Fin.val_mk] at hh'
    omega
  have h21 : (⟨2, by omega⟩ : Fin R') ≠ ⟨1, by omega⟩ := by
    intro hh
    have hh' := Fin.ext_iff.mp hh
    simp only [Fin.val_mk] at hh'
    omega
  simp [bmDPS_diagVec, h20, h21]

private theorem bmDPS_diagVec_det (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f)
    (hc : c ≠ 0) : (Matrix.diagonal (bmDPS_diagVec R' f hR3 c)).det = 1 := by
  rw [Matrix.det_diagonal]
  rw [Finset.prod_eq_mul (⟨1, by omega⟩ : Fin R') (⟨2, by omega⟩ : Fin R')
    (by simp [Fin.ext_iff]) (fun i _ hi => by
      by_cases hi0 : i = (⟨0, by omega⟩ : Fin R')
      · subst hi0; simp [bmDPS_diagVec]
      · simp [bmDPS_diagVec, hi0, hi.1, hi.2])
    (fun h => absurd (Finset.mem_univ _) h) (fun h => absurd (Finset.mem_univ _) h)]
  rw [bmDPS_diagVec_apply_one, bmDPS_diagVec_apply_two, inv_mul_cancel₀ hc]

private noncomputable def bmDPS_diagSL (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f)
    (hc : c ≠ 0) : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f) :=
  ⟨Matrix.diagonal (bmDPS_diagVec R' f hR3 c), bmDPS_diagVec_det R' f hR3 c hc⟩

private theorem bmDPS_diagSL_coe (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f)
    (hc : c ≠ 0) :
    (bmDPS_diagSL R' f hR3 c hc : Matrix (Fin R') (Fin R') (GaloisField 2 f)) =
      Matrix.diagonal (bmDPS_diagVec R' f hR3 c) := by
  rw [bmDPS_diagSL, Matrix.SpecialLinearGroup.coe_mk]

private theorem bmDPS_diagSL_inv_transpose_coe (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f)
    (hc : c ≠ 0) :
    Matrix.transpose (((bmDPS_diagSL R' f hR3 c hc)⁻¹ :
        Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)) =
      Matrix.diagonal (fun i => ∏ j ∈ Finset.univ.erase i, bmDPS_diagVec R' f hR3 c j) := by
  change Matrix.transpose (Matrix.adjugate (Matrix.diagonal (bmDPS_diagVec R' f hR3 c))) =
    Matrix.diagonal (fun i => ∏ j ∈ Finset.univ.erase i, bmDPS_diagVec R' f hR3 c j)
  rw [Matrix.adjugate_diagonal, Matrix.diagonal_transpose]

private theorem bmDPS_diagVec_prod_erase_one (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f) :
    (∏ j ∈ Finset.univ.erase (⟨1, by omega⟩ : Fin R'), bmDPS_diagVec R' f hR3 c j) = c := by
  rw [Finset.prod_eq_single (⟨2, by omega⟩ : Fin R')]
  · rw [bmDPS_diagVec_apply_two]
  · intro b hb hb2
    have hb1 : b ≠ (⟨1, by omega⟩ : Fin R') := (Finset.mem_erase.mp hb).1
    by_cases hb0 : b = (⟨0, by omega⟩ : Fin R')
    · subst hb0; simp [bmDPS_diagVec]
    · simp [bmDPS_diagVec, hb0, hb1, hb2]
  · intro h
    exact absurd (Finset.mem_erase.mpr ⟨by simp [Fin.ext_iff], Finset.mem_univ _⟩) h

private theorem bmDPS_diagSL_mulVec_zero (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f)
    (hc : c ≠ 0) :
    Matrix.mulVec (bmDPS_diagSL R' f hR3 c hc : Matrix (Fin R') (Fin R') (GaloisField 2 f))
        (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
      Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  rw [bmDPS_diagSL_coe, Matrix.diagonal_mulVec_single, bmDPS_diagVec_apply_zero, one_mul]

private theorem bmDPS_diagSL_inv_transpose_mulVec_one (R' f : ℕ) (hR3 : 3 ≤ R')
    (c : GaloisField 2 f) (hc : c ≠ 0) :
    Matrix.mulVec (Matrix.transpose (((bmDPS_diagSL R' f hR3 c hc)⁻¹ :
        Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)))
        (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
      c • Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  rw [bmDPS_diagSL_inv_transpose_coe, Matrix.diagonal_mulVec_single,
    bmDPS_diagVec_prod_erase_one, mul_one, ← Pi.single_smul, smul_eq_mul, mul_one]

private theorem bmDPS_exists_sl_diag_single (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f)
    (hc : c ≠ 0) :
    ∃ δ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      Matrix.mulVec (δ : Matrix (Fin R') (Fin R') (GaloisField 2 f))
          (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) ∧
      Matrix.mulVec (Matrix.transpose
          ((δ⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f)))
          (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        c • Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  exact ⟨bmDPS_diagSL R' f hR3 c hc, bmDPS_diagSL_mulVec_zero R' f hR3 c hc,
    bmDPS_diagSL_inv_transpose_mulVec_one R' f hR3 c hc⟩

private theorem bmDPS_dotProduct_single_zero (R' f : ℕ) (hR : 1 ≤ R')
    (φ : Fin R' → GaloisField 2 f)
    (h : φ ⬝ᵥ (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) :
      Fin R' → GaloisField 2 f) = 0) :
    φ (⟨0, by omega⟩ : Fin R') = 0 := by
  rw [dotProduct_comm, bmDPS_single_dotProduct_vec] at h
  exact h

private theorem bmDPS_exists_coord_ne_zero_ne (R' f : ℕ) (hR : 1 ≤ R')
    (φ : Fin R' → GaloisField 2 f)
    (hφ : φ ≠ 0) (h0 : φ (⟨0, by omega⟩ : Fin R') = 0) :
    ∃ j : Fin R', j ≠ ⟨0, by omega⟩ ∧ φ j ≠ 0 := by
  obtain ⟨i, hi⟩ := bmDPS_exists_coord_ne_zero R' f φ hφ
  refine ⟨i, ?_, hi⟩
  rintro rfl
  exact hi h0

private theorem bmDPS_exists_sl_map_phi_std_scal (R' f : ℕ) (hR : 2 ≤ R')
    (φ : Fin R' → GaloisField 2 f) (hφ : φ ≠ 0)
    (h0 : φ (⟨0, by omega⟩ : Fin R') = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f), ∃ c : GaloisField 2 f,
      c ≠ 0 ∧
      Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
          (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) ∧
      Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ =
        c • Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  obtain ⟨j, hj, hφj⟩ := bmDPS_exists_coord_ne_zero_ne R' f (by omega) φ hφ h0
  obtain ⟨g₁, c₁, hc₁, hg₁, hg₁O⟩ := bmDPS_exists_sl_map_phi_j R' f (by omega) j hj φ hφj h0
  obtain ⟨σ, hσO, hσ1⟩ := bmDPS_exists_sl_swap_single R' f hR j hj
  have hinvT : ∀ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      Matrix.transpose ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))
        * Matrix.transpose (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) = 1 := by
    intro g
    have hmul : (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
        * ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
          Matrix (Fin R') (Fin R') (GaloisField 2 f)) = 1 := by
      rw [← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel,
        Matrix.SpecialLinearGroup.coe_one]
    rw [← Matrix.transpose_mul,
      show (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
        * ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
          Matrix (Fin R') (Fin R') (GaloisField 2 f)) = 1 from by
        rw [← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel,
          Matrix.SpecialLinearGroup.coe_one],
      Matrix.transpose_one]
  refine ⟨σ * g₁, c₁⁻¹, inv_ne_zero hc₁, ?_, ?_⟩
  · rw [Matrix.SpecialLinearGroup.coe_mul, ← Matrix.mulVec_mulVec, hg₁O, hσO]
  · have hg₁inv : Matrix.mulVec (Matrix.transpose
        ((g₁⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
          Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ = c₁⁻¹ • Pi.single j 1 := by
      rw [show φ = c₁⁻¹ • Matrix.mulVec
          (Matrix.transpose (g₁ : Matrix (Fin R') (Fin R') (GaloisField 2 f)))
          (Pi.single j (1 : GaloisField 2 f)) from by
        rw [hg₁, smul_smul, inv_mul_cancel₀ hc₁, one_smul]]
      rw [Matrix.mulVec_smul, Matrix.mulVec_mulVec, hinvT g₁, Matrix.one_mulVec]
    have hσinv : Matrix.mulVec (Matrix.transpose
        ((σ⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
          Matrix (Fin R') (Fin R') (GaloisField 2 f))) (Pi.single j (1 : GaloisField 2 f))
        = Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
      rw [show Pi.single j (1 : GaloisField 2 f) = Matrix.mulVec
          (Matrix.transpose (σ : Matrix (Fin R') (Fin R') (GaloisField 2 f)))
          (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) from hσ1.symm]
      rw [Matrix.mulVec_mulVec, hinvT σ, Matrix.one_mulVec]
    rw [mul_inv_rev, Matrix.SpecialLinearGroup.coe_mul, Matrix.transpose_mul,
      ← Matrix.mulVec_mulVec, hg₁inv, Matrix.mulVec_smul, hσinv]

private theorem bmDPS_exists_sl_map_phi_std (R' f : ℕ) (hR3 : 3 ≤ R')
    (φ : Fin R' → GaloisField 2 f) (hφ : φ ≠ 0)
    (h : φ ⬝ᵥ (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
          (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) ∧
      Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ =
        Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  have h0 : φ (⟨0, by omega⟩ : Fin R') = 0 :=
    bmDPS_dotProduct_single_zero R' f (by omega) φ h
  obtain ⟨g₀, c, hc, hg₀O, hg₀⟩ := bmDPS_exists_sl_map_phi_std_scal R' f (by omega) φ hφ h0
  obtain ⟨δ, hδO, hδ⟩ := bmDPS_exists_sl_diag_single R' f hR3 c⁻¹ (inv_ne_zero hc)
  refine ⟨δ * g₀, ?_, ?_⟩
  · rw [Matrix.SpecialLinearGroup.coe_mul, ← Matrix.mulVec_mulVec, hg₀O, hδO]
  · rw [mul_inv_rev, Matrix.SpecialLinearGroup.coe_mul, Matrix.transpose_mul,
      ← Matrix.mulVec_mulVec, hg₀, Matrix.mulVec_smul, hδ]
    rw [smul_smul, mul_inv_cancel₀ hc, one_smul]

private theorem bmDPS_matTransvGroup_smul (R' f : ℕ) (c : GaloisField 2 f) (hc : c ≠ 0)
    (v φ : Fin R' → GaloisField 2 f) :
    matTransvGroup (c • v) φ = matTransvGroup v φ := by
  rw [matTransvGroup, matTransvGroup]
  congr 1
  ext g
  constructor
  · rintro ⟨d, hd⟩
    exact ⟨d * c, by rw [hd, Matrix.smul_vecMulVec, ← smul_smul]⟩
  · rintro ⟨d, hd⟩
    exact ⟨d * c⁻¹, by
      rw [hd, Matrix.smul_vecMulVec, smul_smul, mul_assoc, inv_mul_cancel₀ hc, mul_one]⟩

private theorem bmDPS_transpose_mulVec_inv_transpose (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (φ : Fin R' → GaloisField 2 f) :
    Matrix.mulVec (Matrix.transpose (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)))
      (Matrix.mulVec (Matrix.transpose
        ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
          Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) = φ := by
  rw [Matrix.mulVec_mulVec,
    show Matrix.transpose (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
      * Matrix.transpose ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)) = 1 from by
      rw [← Matrix.transpose_mul, ← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel,
        Matrix.SpecialLinearGroup.coe_one, Matrix.transpose_one],
    Matrix.one_mulVec]

private theorem bmDPS_dotProduct_mulVec_transpose (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (ψ w : Fin R' → GaloisField 2 f) :
    Matrix.mulVec (Matrix.transpose (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))) ψ ⬝ᵥ w
      = ψ ⬝ᵥ Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) w := by
  rw [Matrix.dotProduct_mulVec, Matrix.mulVec_transpose]

private theorem bmDPS_transpose_inv_ne_zero (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (φ : Fin R' → GaloisField 2 f) (hφ : φ ≠ 0) :
    Matrix.mulVec (Matrix.transpose
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ ≠ 0 := by
  intro hzero
  refine hφ ?_
  have hcomp := bmDPS_transpose_mulVec_inv_transpose R' f g φ
  rw [hzero, Matrix.mulVec_zero] at hcomp
  exact hcomp.symm

private theorem bmDPS_transpose_inv_dot_mulVec (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (φ v : Fin R' → GaloisField 2 f) :
    Matrix.mulVec (Matrix.transpose
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ ⬝ᵥ
      Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v = φ ⬝ᵥ v := by
  rw [← bmDPS_dotProduct_mulVec_transpose,
    bmDPS_transpose_mulVec_inv_transpose]

private theorem bmDPS_transpose_inv_dot_zero_of_smul_single (R' f : ℕ) (hR : 1 ≤ R')
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (φ v : Fin R' → GaloisField 2 f) (c : GaloisField 2 f) (hc : c ≠ 0)
    (hgv : Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v =
      c • Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
    (h : φ ⬝ᵥ v = 0) :
    Matrix.mulVec (Matrix.transpose
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ ⬝ᵥ
      (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) = 0 := by
  have hzero := bmDPS_transpose_inv_dot_mulVec R' f g φ v
  rw [hgv, h, dotProduct_smul] at hzero
  rcases (mul_eq_zero.mp hzero) with hc0 | h0
  · exact absurd hc0 hc
  · exact h0

private theorem bmDPS_exists_sl_map_pair_std_high (R' f : ℕ) (hR3 : 3 ≤ R')
    (v φ : Fin R' → GaloisField 2 f) (hv : v ≠ 0) (hφ : φ ≠ 0) (h : φ ⬝ᵥ v = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) =
      matTransvGroup (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
        (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) := by
  have heO : (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) :
      Fin R' → GaloisField 2 f) ≠ 0 :=
    fun hzero => bmDPS_single_apply_self R' f (⟨0, by omega⟩ : Fin R') (by rw [hzero]; rfl)
  obtain ⟨g₁, c₁, hc₁, hg₁⟩ := bmDPS_exists_sl_map_vec R' f v
    (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) hv heO
  have hψne : Matrix.mulVec (Matrix.transpose
      ((g₁⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ ≠ 0 :=
    bmDPS_transpose_inv_ne_zero R' f g₁ φ hφ
  have hψ0 : Matrix.mulVec (Matrix.transpose
      ((g₁⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ ⬝ᵥ
      (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) = 0 :=
    bmDPS_transpose_inv_dot_zero_of_smul_single R' f (by omega) g₁ φ v c₁ hc₁ hg₁ h
  obtain ⟨g₂, hg₂O, hg₂⟩ := bmDPS_exists_sl_map_phi_std R' f hR3 _ hψne hψ0
  refine ⟨g₂ * g₁, ?_⟩
  have hgv : Matrix.mulVec ((g₂ * g₁ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)) v =
      c₁ • Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
    rw [Matrix.SpecialLinearGroup.coe_mul, ← Matrix.mulVec_mulVec, hg₁, Matrix.mulVec_smul,
      hg₂O]
  have hgφ : Matrix.mulVec (Matrix.transpose
      (((g₂ * g₁ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))⁻¹ :
        Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ =
      Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
    rw [mul_inv_rev, Matrix.SpecialLinearGroup.coe_mul, Matrix.transpose_mul,
      ← Matrix.mulVec_mulVec, hg₂]
  rw [hgv, hgφ]
  exact bmDPS_matTransvGroup_smul R' f c₁ hc₁ _ _

private theorem bmDPS_matTransvGroup_smul_form (R' f : ℕ) (c : GaloisField 2 f) (hc : c ≠ 0)
    (v φ : Fin R' → GaloisField 2 f) :
    matTransvGroup v (c • φ) = matTransvGroup v φ := by
  rw [matTransvGroup, matTransvGroup]
  congr 1
  ext g
  constructor
  · rintro ⟨d, hd⟩
    exact ⟨d * c, by rw [hd, Matrix.vecMulVec_smul, ← smul_smul]⟩
  · rintro ⟨d, hd⟩
    exact ⟨d * c⁻¹, by
      rw [hd, Matrix.vecMulVec_smul, smul_smul, mul_assoc, inv_mul_cancel₀ hc, mul_one]⟩

private theorem bmDPS_eq_smul_single_of_dot_zero_two (R' f : ℕ) (hR2 : R' = 2)
    (ψ : Fin R' → GaloisField 2 f)
    (h : ψ ⬝ᵥ (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) = 0) :
    ψ = (ψ (⟨1, by omega⟩ : Fin R')) •
      Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  subst hR2
  have hψ0 : ψ 0 = 0 := by
    have h' := bmDPS_dotProduct_single_zero 2 f (by omega) ψ h
    simpa using h'
  ext i
  fin_cases i <;> simp [hψ0]

private theorem bmDPS_exists_sl_map_pair_std_two (R' f : ℕ) (hR2 : R' = 2)
    (v φ : Fin R' → GaloisField 2 f) (hv : v ≠ 0) (hφ : φ ≠ 0) (h : φ ⬝ᵥ v = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) =
      matTransvGroup (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
        (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) := by
  have heO : (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) :
      Fin R' → GaloisField 2 f) ≠ 0 :=
    fun hzero => bmDPS_single_apply_self R' f (⟨0, by omega⟩ : Fin R') (by rw [hzero]; rfl)
  obtain ⟨g₁, c₁, hc₁, hg₁⟩ := bmDPS_exists_sl_map_vec R' f v
    (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) hv heO
  let ψ : Fin R' → GaloisField 2 f := Matrix.mulVec (Matrix.transpose
    ((g₁⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
      Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ
  have hψne : ψ ≠ 0 := bmDPS_transpose_inv_ne_zero R' f g₁ φ hφ
  have hψ0 : ψ ⬝ᵥ (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) = 0 :=
    bmDPS_transpose_inv_dot_zero_of_smul_single R' f (by omega) g₁ φ v c₁ hc₁ hg₁ h
  have hψeq : ψ = (ψ (⟨1, by omega⟩ : Fin R')) •
      Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) :=
    bmDPS_eq_smul_single_of_dot_zero_two R' f hR2 ψ hψ0
  have hlam : ψ (⟨1, by omega⟩ : Fin R') ≠ 0 := by
    intro hlam0
    exact hψne (by rw [hψeq, hlam0, zero_smul])
  refine ⟨g₁, ?_⟩
  show matTransvGroup (Matrix.mulVec (g₁ : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v) ψ =
    matTransvGroup (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
      (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f))
  rw [hg₁, hψeq,
    bmDPS_matTransvGroup_smul R' f c₁ hc₁ (Pi.single (⟨0, by omega⟩ : Fin R') 1)
      (ψ (⟨1, by omega⟩ : Fin R') • Pi.single (⟨1, by omega⟩ : Fin R') 1),
    bmDPS_matTransvGroup_smul_form R' f (ψ (⟨1, by omega⟩ : Fin R')) hlam
      (Pi.single (⟨0, by omega⟩ : Fin R') 1) (Pi.single (⟨1, by omega⟩ : Fin R') 1)]

private theorem bmDPS_exists_sl_map_pair_std (R' f : ℕ) (hR : 2 ≤ R')
    (v φ : Fin R' → GaloisField 2 f)
    (hv : v ≠ 0) (hφ : φ ≠ 0) (h : φ ⬝ᵥ v = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) =
      matTransvGroup (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
        (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) := by
  by_cases hR3 : 3 ≤ R'
  · exact bmDPS_exists_sl_map_pair_std_high R' f hR3 v φ hv hφ h
  · exact bmDPS_exists_sl_map_pair_std_two R' f (by omega) v φ hv hφ h

private theorem bmDPS_map_conj_mul (R' f : ℕ)
    (g₁ g₂ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (X : Subgroup (GL (Fin R') (GaloisField 2 f))) :
    Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL (g₂ * g₁))).toMonoidHom X
      = Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₂)).toMonoidHom
          (Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₁)).toMonoidHom X) := by
  rw [Subgroup.map_map]
  congr 1
  apply MonoidHom.ext
  intro y
  change MulAut.conj (Matrix.SpecialLinearGroup.toGL (g₂ * g₁)) y
      = MulAut.conj (Matrix.SpecialLinearGroup.toGL g₂)
          (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₁) y)
  rw [MulAut.conj_apply, MulAut.conj_apply, MulAut.conj_apply, map_mul, mul_inv_rev]
  group

private theorem bmDPS_exists_sl_map_pair (R' f : ℕ)
    (v₁ φ₁ v₂ φ₂ : Fin R' → GaloisField 2 f)
    (hv₁ : v₁ ≠ 0) (hφ₁ : φ₁ ≠ 0) (hv₂ : v₂ ≠ 0) (hφ₂ : φ₂ ≠ 0)
    (h₁ : φ₁ ⬝ᵥ v₁ = 0) (h₂ : φ₂ ⬝ᵥ v₂ = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v₁)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ₁) =
      matTransvGroup v₂ φ₂ := by
  by_cases hR : 2 ≤ R'
  · obtain ⟨g₁, hg₁⟩ := bmDPS_exists_sl_map_pair_std R' f hR v₁ φ₁ hv₁ hφ₁ h₁
    obtain ⟨g₂, hg₂⟩ := bmDPS_exists_sl_map_pair_std R' f hR v₂ φ₂ hv₂ hφ₂ h₂
    have hm₁ : Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₁)).toMonoidHom
        (matTransvGroup v₁ φ₁) =
        matTransvGroup (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
          (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) := by
      rw [bmDPS_conj_matTransvGroup R' f g₁ v₁ φ₁, hg₁]
    have hm₂ : Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₂)).toMonoidHom
        (matTransvGroup v₂ φ₂) =
        matTransvGroup (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
          (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) := by
      rw [bmDPS_conj_matTransvGroup R' f g₂ v₂ φ₂, hg₂]
    have h3 : Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₂⁻¹)).toMonoidHom
        (Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₂)).toMonoidHom
          (matTransvGroup v₂ φ₂)) = matTransvGroup v₂ φ₂ := by
      rw [← bmDPS_map_conj_mul R' f g₂ g₂⁻¹ (matTransvGroup v₂ φ₂)]
      have hconj1 : MulAut.conj (Matrix.SpecialLinearGroup.toGL (g₂⁻¹ * g₂)) = 1 := by
        rw [inv_mul_cancel g₂, map_one, map_one]
      rw [hconj1]
      exact Subgroup.map_id (matTransvGroup v₂ φ₂)
    refine ⟨g₂⁻¹ * g₁, ?_⟩
    rw [← bmDPS_conj_matTransvGroup R' f (g₂⁻¹ * g₁) v₁ φ₁,
      bmDPS_map_conj_mul R' f g₁ g₂⁻¹ (matTransvGroup v₁ φ₁), hm₁, ← hm₂]
    exact h3
  · exfalso
    have hle : R' ≤ 1 := by omega
    haveI : Subsingleton (Fin R') :=
      ⟨fun a b => Fin.ext (by have ha := a.isLt; have hb := b.isLt; omega)⟩
    obtain ⟨i, hi⟩ := bmDPS_exists_coord_ne_zero R' f v₁ hv₁
    obtain ⟨j, hj⟩ := bmDPS_exists_coord_ne_zero R' f φ₁ hφ₁
    have hji : j = i := Subsingleton.elim j i
    rw [hji] at hj
    have hdot : φ₁ ⬝ᵥ v₁ = φ₁ i * v₁ i := by
      rw [dotProduct]
      exact Finset.sum_eq_single i (fun b _ hb => absurd (Subsingleton.elim b i) hb)
        (fun h => absurd (Finset.mem_univ i) h)
    rw [hdot] at h₁
    exact mul_ne_zero hj hi h₁
private theorem bmDPS_exists_conj_matTransvGroup (R f : ℕ)
    (v₁ φ₁ v₂ φ₂ : Fin (R + 1) → GaloisField 2 f)
    (hv₁ : v₁ ≠ 0) (hφ₁ : φ₁ ≠ 0) (hv₂ : v₂ ≠ 0) (hφ₂ : φ₂ ≠ 0)
    (h₁ : φ₁ ⬝ᵥ v₁ = 0) (h₂ : φ₂ ⬝ᵥ v₂ = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g)).toMonoidHom
        (matTransvGroup v₁ φ₁) = matTransvGroup v₂ φ₂ := by
  obtain ⟨g, hg⟩ :=
    bmDPS_exists_sl_map_pair (R + 1) f v₁ φ₁ v₂ φ₂ hv₁ hφ₁ hv₂ hφ₂ h₁ h₂
  refine ⟨g, ?_⟩
  rw [bmDPS_conj_matTransvGroup (R + 1) f g v₁ φ₁]
  exact hg

private theorem bmDPS_matTransvGroup_of_generated_ne
    (R f : ℕ)
    (B : Subgroup (Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)))
    (m : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
    (hB : B = Subgroup.closure
      {x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) |
        ∃ c : GaloisField 2 f,
          (Matrix.SpecialLinearGroup.toGL x :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 + c • m})
    (hrank : m.rank ≤ 1) (hm2 : m * m = 0) (hm0 : m ≠ 0) :
    ∃ v φ : Fin (R + 1) → GaloisField 2 f,
      v ≠ 0 ∧ φ ≠ 0 ∧ φ ⬝ᵥ v = 0 ∧
      B = Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v φ) := by
  obtain ⟨v, φ, hmv⟩ := bmDPS_rank_one_eq_vecMulVec (GaloisField 2 f) m hrank
  have hφv : φ ⬝ᵥ v = 0 := by
    apply bmDPS_dotProduct_eq_zero_of_vecMulVec_sq_zero (R := R + 1) (f := f) (v := v) (φ := φ)
    rw [← hmv]; exact hm2
  have hne : Matrix.vecMulVec v φ ≠ 0 := by rw [← hmv]; exact hm0
  refine ⟨v, φ, ?_, ?_, hφv, ?_⟩
  · intro hv0
    exact hne (by rw [hv0]; ext i j; simp [Matrix.vecMulVec])
  · intro hφ0
    exact hne (by rw [hφ0]; ext i j; simp [Matrix.vecMulVec])
  · rw [hB, hmv]
    rw [show matTransvGroup v φ = Subgroup.closure
        {g : GL (Fin (R + 1)) (GaloisField 2 f) | ∃ c : GaloisField 2 f,
          (g : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) =
            1 + c • Matrix.vecMulVec v φ} from rfl]
    rw [bmDPS_comap_toGL_closure R f _
      (bmDPS_generators_subset_range_toGL (R + 1) f v φ hφv)]
    rfl

private theorem bmDPS_J_mulVec_ne_zero (n f : ℕ) {v : Fin n ⊕ Fin n → GaloisField 2 f}
    (hv : v ≠ 0) : Matrix.mulVec (bmDPS_J n f) v ≠ 0 := by
  intro h0
  refine hv (funext fun x => ?_)
  cases x with
  | inl i =>
    have h := congrFun h0 (Sum.inr i)
    simpa [bmDPS_J, Matrix.fromBlocks, Matrix.mulVec, dotProduct, Matrix.one_apply,
      Finset.sum_ite_eq] using h
  | inr i =>
    have h := congrFun h0 (Sum.inl i)
    simpa [bmDPS_J, Matrix.fromBlocks, Matrix.mulVec, dotProduct, Matrix.one_apply,
      Finset.sum_ite_eq] using h

private theorem bmDPS_dotProduct_single' (n f : ℕ) (i : Fin n ⊕ Fin n)
    (a : GaloisField 2 f) (u : Fin n ⊕ Fin n → GaloisField 2 f) :
    u ⬝ᵥ (Pi.single i a : Fin n ⊕ Fin n → GaloisField 2 f) = u i * a := by
  rw [dotProduct, Finset.sum_eq_single i]
  · rw [Pi.single_eq_same]
  · intro b _ hb
    rw [Pi.single_eq_of_ne hb, mul_zero]
  · intro h
    exact absurd (Finset.mem_univ i) h

private theorem bmDPS_tau_ne_zero (n f : ℕ) (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f) (ha₂ : a₂ ≠
    0)
    (hli : LinearIndependent (GaloisField 2 f) ![a₁, a₂]) :
    Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
      Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁) ≠ 0 := by
  intro hτ
  obtain ⟨i, hi⟩ : ∃ i, Matrix.mulVec (bmDPS_J n f) a₂ i ≠ 0 := by
    by_contra h
    push_neg at h
    exact bmDPS_J_mulVec_ne_zero n f ha₂ (funext h)
  have hpair : ((Matrix.mulVec (bmDPS_J n f) a₂) i) • a₁ +
      ((Matrix.mulVec (bmDPS_J n f) a₁) i) • a₂ = 0 := by
    have h := congrFun (congrArg Matrix.mulVec hτ) (Pi.single i (1 : GaloisField 2 f))
    rw [Matrix.add_mulVec, Matrix.zero_mulVec, Matrix.vecMulVec_mulVec,
      Matrix.vecMulVec_mulVec, op_smul_eq_smul, op_smul_eq_smul] at h
    rw [bmDPS_dotProduct_single', bmDPS_dotProduct_single'] at h
    simpa using h
  have hdep := (Fintype.linearIndependent_iff.mp hli)
    (fun k : Fin 2 => if k = 0 then Matrix.mulVec (bmDPS_J n f) a₂ i
      else Matrix.mulVec (bmDPS_J n f) a₁ i) ?_
  · exact hi (by simpa using hdep 0)
  · rw [Fin.sum_univ_two]
    simpa using hpair

private theorem bmDPS_altSiegel_preimage_block_ne
    (n f : ℕ)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hJ'range : J' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).range)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f) (ha₂ : a₂ ≠ 0)
    (hli : LinearIndependent (GaloisField 2 f) ![a₁, a₂])
    (haorth : a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0)
    (hle : altSiegelGroup (bmDPS_J n f) a₁ a₂ ≤
      J'.map (CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) :
    ∃ m : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f),
      m.rank ≤ 1 ∧ m * m = 0 ∧ m ≠ 0 ∧
      ((((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)) ⁻¹'
          {g : GL (Fin n ⊕ Fin n) (GaloisField 2 f) | ∃ c : GaloisField 2 f,
            g = 1 + c • (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
              Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁))})
        = {x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) |
            ∃ c : GaloisField 2 f,
              (Matrix.SpecialLinearGroup.toGL x :
                Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 + c • m} := by
  obtain ⟨x₁, hx₁⟩ := bmDPS_altSiegel_preimage_root_exists n f eidx hPP hPinvP hP hJ
    hJ'range a₁ a₂ haorth hle
  have hm : ((x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1) *
      ((x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1) = 0 :=
    bmDPS_altSiegel_preimage_root_sq_zero n f eidx hPP hPinvP hP hJ a₁ a₂ haorth
      x₁ hx₁
  have hm0 : (x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1 ≠ 0 := by
    intro hzero
    refine bmDPS_tau_ne_zero n f a₁ a₂ ha₂ hli ?_
    have hx1 : x₁ = 1 := Subtype.ext (by rw [sub_eq_zero.mp hzero]; rfl)
    have h := hx₁
    rw [hx1] at h
    have h1 : (1 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
        1 + (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
          Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁)) := by
      simpa using h
    exact (add_left_cancel (show (1 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n)
        (GaloisField 2 f)) + 0 =
          1 + (Matrix.vecMulVec a₁ (Matrix.mulVec (bmDPS_J n f) a₂) +
            Matrix.vecMulVec a₂ (Matrix.mulVec (bmDPS_J n f) a₁)) from by simpa using h1)).symm
  refine ⟨(x₁ : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1,
    bmDPS_altSiegel_preimage_block_rank n f eidx hPP hPinvP hP hJ a₁ a₂ haorth x₁ hx₁, hm, hm0, ?_⟩
  ext x
  constructor
  · rintro ⟨c, hc⟩
    exact ⟨c, (bmDPS_altSiegel_preimage_root_block_iff n f eidx hPP hPinvP hP hJ
      a₁ a₂ x₁ hx₁ hm x c).mp hc⟩
  · rintro ⟨c, hc⟩
    exact ⟨c, (bmDPS_altSiegel_preimage_root_block_iff n f eidx hPP hPinvP hP hJ
      a₁ a₂ x₁ hx₁ hm x c).mpr hc⟩

private theorem bmDPS_altSiegel_preimage_matTransv_ne
    (n f : ℕ)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hJ'range : J' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).range)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f) (ha₂ : a₂ ≠ 0)
    (hli : LinearIndependent (GaloisField 2 f) ![a₁, a₂])
    (haorth : a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0)
    (hle : altSiegelGroup (bmDPS_J n f) a₁ a₂ ≤
      J'.map (CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) :
    ∃ v φ : Fin (R + 1) → GaloisField 2 f,
      v ≠ 0 ∧ φ ≠ 0 ∧ φ ⬝ᵥ v = 0 ∧
      Subgroup.comap
        (((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ))
        (altSiegelGroup (bmDPS_J n f) a₁ a₂)
      = Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v φ) := by
  obtain ⟨m, hmrank, hm2, hm0, hm_eq⟩ :=
    bmDPS_altSiegel_preimage_block_ne n f eidx hPP hPinvP hP hJ hJ'range
      a₁ a₂ ha₂ hli haorth hle
  obtain ⟨v, φ, hv0, hφ0, hφv, hvφ⟩ :=
    bmDPS_matTransvGroup_of_generated_ne R f _ m rfl hmrank hm2 hm0
  exact ⟨v, φ, hv0, hφ0, hφv, by
    rw [bmDPS_altSiegel_preimage_closure n f eidx hPP hPinvP hP hJ hJ'range a₁ a₂ hle, hm_eq]
    exact hvφ⟩

private theorem bmDPS_altSiegel_model_conj (R f : ℕ)
    (v₁ φ₁ v₂ φ₂ : Fin (R + 1) → GaloisField 2 f)
    (hv₁ : v₁ ≠ 0) (hφ₁ : φ₁ ≠ 0) (hv₂ : v₂ ≠ 0) (hφ₂ : φ₂ ≠ 0)
    (h₁ : φ₁ ⬝ᵥ v₁ = 0) (h₂ : φ₂ ⬝ᵥ v₂ = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g)).toMonoidHom
        (matTransvGroup v₁ φ₁) = matTransvGroup v₂ φ₂ :=
  bmDPS_exists_conj_matTransvGroup R f v₁ φ₁ v₂ φ₂ hv₁ hφ₁ hv₂ hφ₂ h₁ h₂

private theorem bmDPS_map_conj_comap {G H : Type*} [Group G] [Group H]
    (f : G →* H) (g : G) (L : Subgroup H) :
    Subgroup.map (MulAut.conj g).toMonoidHom (Subgroup.comap f L)
      = Subgroup.comap f (Subgroup.map (MulAut.conj (f g)).toMonoidHom L) := by
  have hconj : ∀ y : G, f (MulAut.conj g y) = MulAut.conj (f g) (f y) := by
    intro y
    simp [MulAut.conj_apply, map_mul, map_inv, mul_inv_rev, inv_inv, mul_assoc]
  have hconj_inv : ∀ y : G, f (MulAut.conj g⁻¹ y) = (MulAut.conj (f g))⁻¹ (f y) := by
    intro y
    rw [MulAut.conj_apply, MulAut.conj_inv_apply]
    simp [map_mul, map_inv, mul_inv_rev, inv_inv, mul_assoc]
  have hconj_inv' : ∀ y : G, (MulAut.conj (f g))⁻¹ (f y) = f (MulAut.conj g⁻¹ y) :=
    fun y => (hconj_inv y).symm
  ext x
  simp only [Subgroup.mem_map, Subgroup.mem_comap]
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨f y, hy, (hconj y).symm⟩
  · rintro ⟨z, hz, hzx⟩
    refine ⟨MulAut.conj g⁻¹ x, ?_, ?_⟩
    · have hz_eq : f (MulAut.conj g⁻¹ x) = z := by
        rw [hconj_inv x, ← hzx, MulAut.conj_inv_apply]
        simp [MulAut.conj_apply, mul_assoc]
      rwa [hz_eq]
    · simp [MulAut.conj_apply, mul_assoc]

private theorem bmDPS_map_conj_comp {G H : Type*} [Group G] [Group H]
    (f : G →* H) (g : G) (K : Subgroup G) :
    Subgroup.map f (Subgroup.map (MulAut.conj g).toMonoidHom K)
      = Subgroup.map (MulAut.conj (f g)).toMonoidHom (Subgroup.map f K) := by
  ext x
  constructor
  · rintro ⟨k, hk, rfl⟩
    obtain ⟨a, ha, rfl⟩ := Subgroup.mem_map.mp hk
    exact Subgroup.mem_map.mpr ⟨f a, Subgroup.mem_map.mpr ⟨a, ha, rfl⟩, by
      simp [MulAut.conj_apply, map_mul, map_inv, mul_inv_rev, mul_assoc]⟩
  · rintro ⟨y, hy, rfl⟩
    obtain ⟨k, hk, rfl⟩ := Subgroup.mem_map.mp hy
    exact Subgroup.mem_map.mpr ⟨MulAut.conj g k, Subgroup.mem_map.mpr ⟨k, hk, rfl⟩, by
      simp [MulAut.conj_apply, map_mul, map_inv, mul_inv_rev, mul_assoc]⟩

private theorem bmDPS_map_comap_self {G H : Type*} [Group G] [Group H]
    (f : G →* H) (X : Subgroup H) (hX : X ≤ f.range) :
    Subgroup.map f (Subgroup.comap f X) = X := by
  rw [Subgroup.map_comap_eq, inf_eq_right.mpr hX]

private theorem bmDPS_eq_map_of_comap_eq {G H I : Type*} [Group G] [Group H] [Group I]
    (E : G →* H) (φ : G →* I) (X : Subgroup H) (L : Subgroup I)
    (hX : X ≤ E.range) (h : Subgroup.comap E X = Subgroup.comap φ L) :
    X = Subgroup.map E (Subgroup.comap φ L) := by
  rw [← bmDPS_map_comap_self E X hX, h]

private theorem bmDPS_map_conj_map_comap {G H : Type*} [Group G] [Group H]
    (f : G →* H) (g : G) (K : Subgroup G) :
    Subgroup.map (MulAut.conj (f g)).toMonoidHom (Subgroup.map f K)
      = Subgroup.map f (Subgroup.map (MulAut.conj g).toMonoidHom K) :=
  (bmDPS_map_conj_comp f g K).symm

private theorem bmDPS_comap_conj_eq_of_model
    (n f : ℕ)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hJ'range : J' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).range)
    {A₁ A₂ : (Fin n ⊕ Fin n) → GaloisField 2 f}
    (hstd_le : altSiegelGroup (bmDPS_J n f) A₁ A₂ ≤
      J'.map (CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f)
    (hle : altSiegelGroup (bmDPS_J n f) a₁ a₂ ≤
      J'.map (CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
    {v₁ φ₁ v₂ φ₂ : Fin (R + 1) → GaloisField 2 f}
    {g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)}
    (hc₁ : Subgroup.comap
      (((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp
        (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ))
      (altSiegelGroup (bmDPS_J n f) A₁ A₂)
      = Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v₁ φ₁))
    (hc₂ : Subgroup.comap
      (((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp
        (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ))
      (altSiegelGroup (bmDPS_J n f) a₁ a₂)
      = Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v₂ φ₂))
    (hg : Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g)).toMonoidHom
      (matTransvGroup v₁ φ₁) = matTransvGroup v₂ φ₂) :
    ∃ v : ↥(CFSG.Open.StatedSp n (GaloisField 2 f)), v ∈ J' ∧
      Subgroup.map ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
        (Subgroup.map (MulAut.conj v).toMonoidHom
          (Subgroup.comap ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
            (altSiegelGroup (bmDPS_J n f) A₁ A₂)))
      = altSiegelGroup (bmDPS_J n f) a₁ a₂ := by
  refine ⟨(bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ) g, ?_, ?_⟩
  · rw [hJ'range]
    exact ⟨g, rfl⟩
  · have hErange : (((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp (bmDPS_embedHom n f (R +
      1) r' eidx P Pinv hPP hPinvP hP hJ)).range
        = J'.map ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) := by
      rw [MonoidHom.range_comp, ← hJ'range]
    have hXAeq : (altSiegelGroup (bmDPS_J n f) A₁ A₂) = Subgroup.map (((CFSG.Open.StatedSp n
        (GaloisField 2 f)).subtype).comp (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP
            hJ)) (Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v₁ φ₁)) :=
      bmDPS_eq_map_of_comap_eq (((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ))
              (Matrix.SpecialLinearGroup.toGL) (altSiegelGroup (bmDPS_J n f) A₁ A₂) (matTransvGroup
                  v₁ φ₁) (by rw [hErange]; exact hstd_le) hc₁
    have hXaeq : (altSiegelGroup (bmDPS_J n f) a₁ a₂) = Subgroup.map (((CFSG.Open.StatedSp n
        (GaloisField 2 f)).subtype).comp (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP
            hJ)) (Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v₂ φ₂)) :=
      bmDPS_eq_map_of_comap_eq (((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ))
              (Matrix.SpecialLinearGroup.toGL) (altSiegelGroup (bmDPS_J n f) a₁ a₂) (matTransvGroup
                  v₂ φ₂) (by rw [hErange]; exact hle) hc₂
    have hbridge : Subgroup.map (MulAut.conj (((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
        ((bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ) g))).toMonoidHom
          (Subgroup.map (((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp (bmDPS_embedHom n f
              (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)) (Subgroup.comap
                  (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v₁ φ₁)))
        = Subgroup.map (((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp (bmDPS_embedHom n f
            (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)) (Subgroup.map (MulAut.conj g).toMonoidHom
            (Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v₁ φ₁))) :=
      bmDPS_map_conj_map_comap (((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype).comp
          (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)) g (Subgroup.comap
              (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v₁ φ₁))
    rw [bmDPS_map_conj_comp ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) ((bmDPS_embedHom n f
        (R + 1) r' eidx P Pinv hPP hPinvP hP hJ) g) (Subgroup.comap ((CFSG.Open.StatedSp n
            (GaloisField 2 f)).subtype) (altSiegelGroup (bmDPS_J n f) A₁ A₂)),
      bmDPS_map_comap_self ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) (altSiegelGroup
          (bmDPS_J n f) A₁ A₂) (hstd_le.trans (Subgroup.map_le_range _ J')),
      hXAeq, hbridge,
      bmDPS_map_conj_comap (Matrix.SpecialLinearGroup.toGL) g (matTransvGroup v₁ φ₁), hg, ← hXaeq]

private theorem bmDPS_altSiegel_conj_of_le
    (n f : ℕ)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hJ'range : J' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).range)
    (a₁ a₂ A₁ A₂ : (Fin n ⊕ Fin n) → GaloisField 2 f) (ha₂ : a₂ ≠ 0)
    (hli : LinearIndependent (GaloisField 2 f) ![a₁, a₂])
    (haorth : a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0)
    (hle : altSiegelGroup (bmDPS_J n f) a₁ a₂ ≤
      J'.map (CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
    (hstd_le : altSiegelGroup (bmDPS_J n f) A₁ A₂ ≤
      J'.map (CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) (hA₂ : A₂ ≠ 0)
    (hliA : LinearIndependent (GaloisField 2 f) ![A₁, A₂])
    (hAorth : A₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) A₂ = 0) :
    ∃ v : ↥(CFSG.Open.StatedSp n (GaloisField 2 f)), v ∈ J' ∧
      Subgroup.map ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
        (Subgroup.map (MulAut.conj v).toMonoidHom
          (Subgroup.comap ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
            (altSiegelGroup (bmDPS_J n f) A₁ A₂)))
      = altSiegelGroup (bmDPS_J n f) a₁ a₂ := by
  obtain ⟨v₁, φ₁, hv₁, hφ₁, hφ₁v₁, hc₁⟩ :=
    bmDPS_altSiegel_preimage_matTransv_ne n f eidx hPP hPinvP hP hJ hJ'range
      A₁ A₂ hA₂ hliA hAorth hstd_le
  obtain ⟨v₂, φ₂, hv₂, hφ₂, hφ₂v₂, hc₂⟩ :=
    bmDPS_altSiegel_preimage_matTransv_ne n f eidx hPP hPinvP hP hJ hJ'range
      a₁ a₂ ha₂ hli haorth hle
  obtain ⟨g, hg⟩ := bmDPS_altSiegel_model_conj R f v₁ φ₁ v₂ φ₂ hv₁ hφ₁ hv₂ hφ₂ hφ₁v₁ hφ₂v₂
  exact bmDPS_comap_conj_eq_of_model n f eidx hPP hPinvP hP hJ hJ'range hstd_le a₁ a₂ hle hc₁ hc₂ hg

private theorem bmDPS_std_pair_nondeg (n f : ℕ)
    {A₁ A₂ B₁ B₂ : (Fin n ⊕ Fin n) → GaloisField 2 f}
    (h11 : A₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) B₁ = 1)
    (h22 : A₂ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) B₂ = 1)
    (h12 : A₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) B₂ = 0)
    (h21 : A₂ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) B₁ = 0) :
    A₁ ≠ 0 ∧ A₂ ≠ 0 ∧ LinearIndependent (GaloisField 2 f) ![A₁, A₂] := by
  refine ⟨?_, ?_, ?_⟩
  · intro h
    rw [h] at h11
    simpa using h11
  · intro h
    rw [h] at h22
    simpa using h22
  · rw [LinearIndependent.pair_iff]
    intro s t hst
    have h1 : (s • A₁ + t • A₂) ⬝ᵥ Matrix.mulVec (bmDPS_J n f) B₁ = 0 := by
      rw [hst]; simp
    have h2 : (s • A₁ + t • A₂) ⬝ᵥ Matrix.mulVec (bmDPS_J n f) B₂ = 0 := by
      rw [hst]; simp
    simp [h11, h21] at h1
    simp [h12, h22] at h2
    exact ⟨h1, h2⟩

private theorem bmDPS_closure_transport {K G H : Type*} [Group K] [Group G] [Group H]
    (ι : K →* G) (s : G →* H) (hs : Function.Injective s) (X : Subgroup K) (Y : Subgroup H)
    (hY : (X.map ι).map s = Y) (u : K) :
    ((X.map (MulAut.conj u).toMonoidHom).map ι).map s =
      Subgroup.map s (Subgroup.map (MulAut.conj (ι u)).toMonoidHom (Subgroup.comap s Y)) := by
  have hcomap : Subgroup.comap s Y = X.map ι := by
    apply le_antisymm
    · intro x hx
      rw [Subgroup.mem_comap] at hx
      rw [← hY] at hx
      obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
      rwa [hs hyx] at hy
    · intro x hx
      rw [Subgroup.mem_comap, ← hY]
      exact Subgroup.mem_map.mpr ⟨x, hx, rfl⟩
  rw [hcomap]
  simp only [Subgroup.map_map]
  congr 1
  ext x
  simp [MonoidHom.comp_apply, MulAut.conj_apply, map_mul, map_inv]

private theorem bmDPS_closure_conj_standard
    (n f : ℕ)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (g' : ℕ) (ρ : GaloisField 2 g' ≃+* GaloisField 2 f)
    {ι' : (ggU .PSL (R + 1) g').K →* ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hι' : ι' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).comp
      (bmDPS_modelHom f R g' ρ))
    (hJ'range : J' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).range)
    {β : Fin (ggU .PSL (R + 1) g').D.rank → ℤ}
    {A₁ A₂ : (Fin n ⊕ Fin n) → GaloisField 2 f}
    (hstd : (((ggU .PSL (R + 1) g').D.rootGroup β).map ι').map
        ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) = altSiegelGroup (bmDPS_J n f) A₁ A₂)
    (a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f) (ha₂ : a₂ ≠ 0)
    (hli : LinearIndependent (GaloisField 2 f) ![a₁, a₂])
    (haorth : a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0)
    (hle : altSiegelGroup (bmDPS_J n f) a₁ a₂ ≤
      J'.map (CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) (hA₂ : A₂ ≠ 0) (hliA :
          LinearIndependent (GaloisField 2 f) ![A₁, A₂])
    (hAorth : A₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) A₂ = 0) :
    ∃ u : (ggU .PSL (R + 1) g').K,
      ((((ggU .PSL (R + 1) g').D.rootGroup β).map (MulAut.conj u).toMonoidHom).map ι').map
          ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) =
        altSiegelGroup (bmDPS_J n f) a₁ a₂ := by
  have hstd_le : altSiegelGroup (bmDPS_J n f) A₁ A₂ ≤
      J'.map (CFSG.Open.StatedSp n (GaloisField 2 f)).subtype := by
    rw [← hstd, hJ'range, hι']
    exact Subgroup.map_mono (le_trans (Subgroup.map_le_range _ _)
      (by rw [MonoidHom.range_comp]; exact Subgroup.map_le_range _ _))
  obtain ⟨v, hvJ', hv⟩ :=
    bmDPS_altSiegel_conj_of_le n f eidx hPP hPinvP hP hJ hJ'range a₁ a₂ A₁ A₂ ha₂ hli haorth
      hle hstd_le hA₂ hliA hAorth
  obtain ⟨g, hg⟩ := (MonoidHom.mem_range).mp (hJ'range ▸ hvJ')
  obtain ⟨u, hu⟩ := bmDPS_modelHom_surjective f R g' ρ g
  have hιu : ι' u = v := by
    rw [hι', MonoidHom.comp_apply, hu, hg]
  refine ⟨u, ?_⟩
  rw [bmDPS_closure_transport ι' ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype)
    (Subgroup.subtype_injective _) _ _ hstd u, hιu]
  exact hv

private theorem bmDPS_closure_explicit
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e))
    (hgen : bmDPS_scalarAction n f S e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hJe : IsComponentOf J' (bmDPS_range n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f (R + 1) r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (g' : ℕ) (ρ : GaloisField 2 g' ≃+* GaloisField 2 f)
    {ι' : (ggU .PSL (R + 1) g').K →* ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hι' : ι' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).comp
      (bmDPS_modelHom f R g' ρ))
    (hJ'range : J' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).range) :
    (∀ a₁ a₂ : (Fin n ⊕ Fin n) → GaloisField 2 f, a₁ ≠ 0 → a₂ ≠ 0 → LinearIndependent
        (GaloisField 2 f) ![a₁, a₂] → a₁ ⬝ᵥ Matrix.mulVec (bmDPS_J n f) a₂ = 0 → altSiegelGroup
        (bmDPS_J n f) a₁ a₂ ≤ J'.map (CFSG.Open.StatedSp n (GaloisField 2 f)).subtype →
      ∃ (β : Fin (ggU .PSL (R + 1) g').D.rank → ℤ) (u : (ggU .PSL (R + 1) g').K),
        β ∈ (ggU .PSL (R + 1) g').D.roots ∧ GGLongRoot (ggU .PSL (R + 1) g').D β ∧
        ((((ggU .PSL (R + 1) g').D.rootGroup β).map (MulAut.conj u).toMonoidHom).map ι').map
            (CFSG.Open.StatedSp n (GaloisField 2 f)).subtype =
          altSiegelGroup (bmDPS_J n f) a₁ a₂) := by
  intro a₁ a₂ ha₁ ha₂ hli haorth hle
  have hRpos : 1 ≤ R :=
    bmDPS_component_rank_pos n f S hS he hestar hgen hJe eidx hPP hPinvP hP hJ hconv
  obtain ⟨β₀, hβ₀roots, hβ₀long, _hβ₀std⟩ := bmDPS_model_long_root R (GaloisField 2 g') hRpos
  obtain ⟨A₁, A₂, B₁, B₂, hA11, hA22, ⟨hA12, -, hA1B2, hA2B1⟩, hstdA, -⟩ :=
    bmDPS_rootGroup_image_siegel n f eidx hPP hPinvP hP hJ hRpos g' ρ hι' β₀ _hβ₀std
  obtain ⟨hA₁, hA₂, hliA⟩ := bmDPS_std_pair_nondeg n f hA11 hA22 hA1B2 hA2B1
  obtain ⟨u, hu⟩ :=
    bmDPS_closure_conj_standard (β := β₀) (A₁ := A₁) (A₂ := A₂)
      n f eidx hPP hPinvP hP hJ g' ρ hι' hJ'range
      hstdA a₁ a₂ ha₂ hli haorth hle hA₂ hliA hA12
  exact ⟨β₀, u, hβ₀roots, hβ₀long, hu⟩

private theorem bmDPS_rank_reindex_D0 (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n) :
    (Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f))).rank = R + 1 := by
  rw [Matrix.rank_reindex, bmDPS_D0, bmDPS_rank_fromBlocks_zero, bmDPS_rank_fromBlocks_zero,
    Matrix.rank_one, Matrix.rank_zero, Matrix.rank_zero, add_zero, Fintype.card_fin]

private theorem bmDPS_isUnit_det_of_mul_eq_one (f : ℕ) {ι : Type*} [Fintype ι] [DecidableEq ι]
    {A B : Matrix ι ι (GaloisField 2 f)} (h : A * B = 1) : IsUnit A.det := by
  refine ⟨Units.mk A.det B.det ?_ ?_, rfl⟩
  · rw [← Matrix.det_mul, h, Matrix.det_one]
  · rw [mul_comm, ← Matrix.det_mul, h, Matrix.det_one]

private theorem bmDPS_rank_conj_eq (f : ℕ) {ι : Type*} [Fintype ι] [DecidableEq ι]
    {A P Pinv : Matrix ι ι (GaloisField 2 f)} (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1) :
    (Pinv * A * P).rank = A.rank := by
  have hPunit : IsUnit P.det := bmDPS_isUnit_det_of_mul_eq_one f hPP
  have hPinvunit : IsUnit Pinv.det := bmDPS_isUnit_det_of_mul_eq_one f hPinvP
  rw [Matrix.rank_mul_eq_left_of_isUnit_det P (Pinv * A) hPunit,
    Matrix.rank_mul_eq_right_of_isUnit_det Pinv A hPinvunit]

private theorem bmDPS_finrank_range_toLin_eq_rank (f : ℕ) {ι : Type*} [Fintype ι]
    [DecidableEq ι] (e : Matrix ι ι (GaloisField 2 f)) :
    Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.toLin' e)) = e.rank := by
  have h : Matrix.toLin' e = Matrix.mulVecLin e := by
    apply LinearMap.ext
    intro v
    rw [Matrix.toLin'_apply, Matrix.mulVecLin_apply]
  rw [h, bmDPS_finrank_range_mulVecLin_eq_rank f e]

private theorem bmDPS_block_rank_eq (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 (R + 1) r' (GaloisField 2 f)) * P = e) :
    R + 1 = Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.toLin' e)) := by
  rw [bmDPS_finrank_range_toLin_eq_rank f e, ← hconv,
    bmDPS_rank_conj_eq f hPP hPinvP, bmDPS_rank_reindex_D0 n f R r' eidx]

private theorem bmDPS_mem_center_of_map_mem_center {K G : Type*} [Group K] [Group G]
    (ι : K →* G) (hι : Function.Injective ι) {y : K}
    (hy : ι y ∈ Subgroup.center G) : y ∈ Subgroup.center K := by
  rw [Subgroup.mem_center_iff] at hy ⊢
  intro z
  apply hι
  rw [map_mul, map_mul]
  exact hy (ι z)

private theorem bmDPS_range_comp_eq_of_surjective {A B C : Type*} [Group A] [Group B] [Group C]
    (f : B →* C) (g : A →* B) (hg : Function.Surjective g) :
    (f.comp g).range = f.range := by
  rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr hg, Subgroup.map_top]

private theorem bmDPS_dualPair_PSp_explicit_aux
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n (GaloisField 2 f))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (Algebra.adjoin (GaloisField 2 f) (Units.val '' S)) e)
    (hpair : formAdj (RingHom.id (GaloisField 2 f))
      (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) e ≠
      e) (hdeg : blockDegree (Algebra.adjoin (GaloisField 2 f) (Units.val '' S)) e < 2)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f))}
    (hJe : IsComponentOf J'
      ⁅glBlockCentralizer ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) S
      (e + formAdj (RingHom.id (GaloisField 2 f))
      (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) e),
      glBlockCentralizer ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) S
        (e + formAdj (RingHom.id (GaloisField 2 f))
        (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
        e)⁆) :
    ∃ (k : ℕ)
      (ι : (ggU .PSL (k + 1) f).K →* ↥(CFSG.Open.StatedSp n (GaloisField 2 f)))
      (β₀ : Fin (ggU .PSL (k + 1) f).D.rank → ℤ), k + 1 = Module.finrank (GaloisField 2 f)
          (LinearMap.range (Matrix.toLin' e)) ∧
      GGLongRoot (ggU .PSL (k + 1) f).D β₀ ∧
      (∀ y, ι y ∈ Subgroup.center ↥(CFSG.Open.StatedSp n (GaloisField 2 f)) → y ∈ Subgroup.center
        (ggU .PSL (k + 1) f).K) ∧ ι.range = J' ∧
      ∃ a₁ a₂ b₁ b₂ : (Fin n ⊕ Fin n) → (GaloisField 2 f),
        a₁ ⬝ᵥ Matrix.mulVec
          (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
          b₁ = 1 ∧ a₂ ⬝ᵥ Matrix.mulVec
          (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
          b₂ = 1 ∧
        (a₁ ⬝ᵥ Matrix.mulVec
          (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
          a₂ = 0 ∧ b₁ ⬝ᵥ Matrix.mulVec
          (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
          b₂ = 0 ∧
          a₁ ⬝ᵥ Matrix.mulVec
            (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n)
            (GaloisField 2 f)) b₂ = 0 ∧ a₂ ⬝ᵥ Matrix.mulVec
            (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n)
            (GaloisField 2 f)) b₁ = 0) ∧
        (((ggU .PSL (k + 1) f).D.rootGroup β₀).map ι).map
        ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) = altSiegelGroup
        (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) a₁
        a₂ ∧
        (((ggU .PSL (k + 1) f).D.rootGroup (-β₀)).map ι).map
        ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) = altSiegelGroup
        (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) b₁
        b₂ := by
  obtain ⟨hdeg1, hscalar⟩ := bmDPS_block_scalar n f S he hdeg
  obtain ⟨horth, horth', heps, hestar⟩ := bmDPS_dualPair_data n f S hSU hS he hpair
  have hgen := bmDPS_generator_scalar n f S hSU hS he hdeg
  obtain ⟨R, r', eidx, P, Pinv, hPP, hPinvP, hP, hJ, _hR1, hconv⟩ :=
    bmDPS_explicit_data n f S he horth horth' heps hestar
  obtain ⟨hJ'range, _hR1'⟩ :=
    bmDPS_component_eq_range n f S hS he
      hestar hgen hJe eidx hPP hPinvP hP hJ hconv
  let ι' : (ggU .PSL (R + 1) f).K →* ↥(CFSG.Open.StatedSp n (GaloisField 2 f)) :=
    (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).comp
      (bmDPS_modelHom f R f (RingEquiv.refl (GaloisField 2 f)))
  obtain ⟨β₀, a₁, a₂, b₁, b₂, hlong, h1, h2, h3, h4, h5⟩ :=
    bmDPS_root_configuration_explicit n f eidx hPP hPinvP hP hJ _hR1' f
      (RingEquiv.refl (GaloisField 2 f))
      (hι' := rfl)
  refine ⟨R, ι', β₀, ?_, hlong, ?_, ?_, a₁, a₂, b₁, b₂, h1, h2, h3, h4, h5⟩
  · exact bmDPS_block_rank_eq n f R r' eidx hPP hPinvP hconv
  · have hι'inj : Function.Injective ι' := by
      intro x z hxz
      exact bmDPS_modelHom_injective f R f (RingEquiv.refl (GaloisField 2 f))
        (bmDPS_embedHom_injective n f (R + 1) r' eidx hPP hPinvP hP hJ hxz)
    exact fun y hy => bmDPS_mem_center_of_map_mem_center ι' hι'inj hy
  · rw [hJ'range, show ι' = (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ).comp
        (bmDPS_modelHom f R f (RingEquiv.refl (GaloisField 2 f))) from rfl,
      bmDPS_range_comp_eq_of_surjective
        (bmDPS_embedHom n f (R + 1) r' eidx P Pinv hPP hPinvP hP hJ)
        (bmDPS_modelHom f R f (RingEquiv.refl (GaloisField 2 f)))
        (bmDPS_modelHom_surjective f R f (RingEquiv.refl (GaloisField 2 f)))]

theorem exists_blockModel_dualPair_PSp_explicit
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n (GaloisField 2 f))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
