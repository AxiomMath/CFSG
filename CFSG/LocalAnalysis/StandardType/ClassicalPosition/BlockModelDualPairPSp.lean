private noncomputable abbrev bmDPS_J (n f : ℕ) :
    Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f) :=
  Matrix.fromBlocks 0 1 (-1) 0

private noncomputable abbrev bmDPS_A (n f : ℕ)
    (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f))) :
    Subalgebra (GaloisField 2 f) (Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :=
  Algebra.adjoin (GaloisField 2 f) (Units.val '' S)

private noncomputable abbrev bmDPS_estar (n f : ℕ)
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f) :=
  formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) e

private noncomputable abbrev bmDPS_eps (n f : ℕ)
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f) :=
  e + bmDPS_estar n f e

private noncomputable abbrev bmDPS_range (n f : ℕ)
    (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    Subgroup ↥(CFSG.Open.StatedSp n (GaloisField 2 f)) :=
  ⁅glBlockCentralizer ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) S (bmDPS_eps n f e),
    glBlockCentralizer ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) S
      (bmDPS_eps n f e)⁆

private noncomputable abbrev bmDPS_scalarAction (n f : ℕ)
    (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) : Prop :=
  ∀ s ∈ S, ∃ c : GaloisField 2 f, c ≠ 0 ∧
    (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * e = c • e ∧
    (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * bmDPS_estar n f e =
      c⁻¹ • bmDPS_estar n f e

private theorem bmDPS_blockDegree_eq_one
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hdeg : blockDegree (bmDPS_A n f S) e < 2) :
    blockDegree (bmDPS_A n f S) e = 1 := by
  let M : Submodule (GaloisField 2 f)
      (Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :=
    (Subalgebra.toSubmodule (bmDPS_A n f S)).map (LinearMap.mulRight (GaloisField 2 f) e)
  have heM : e ∈ M := ⟨e, he.1, by rw [LinearMap.mulRight_apply, he.2.1.eq]⟩
  have hbot : (⊥ : Submodule (GaloisField 2 f)
      (Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))) < M := by
    refine lt_of_le_of_ne bot_le ?_
    intro h
    have he0 : e ∈ (⊥ : Submodule (GaloisField 2 f) _) := by rw [h]; exact heM
    exact he.2.2.1 (by simpa using he0)
  have hpos : 0 < blockDegree (bmDPS_A n f S) e := by
    have hlt := Submodule.finrank_lt_finrank_of_lt hbot
    rw [finrank_bot] at hlt
    exact hlt
  omega

private theorem bmDPS_action_is_scalar
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hdeg : blockDegree (bmDPS_A n f S) e = 1)
    {a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)} (ha : a ∈ bmDPS_A n f S) :
    ∃ c : GaloisField 2 f, a * e = c • e := by
  let M : Submodule (GaloisField 2 f)
      (Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :=
    (Subalgebra.toSubmodule (bmDPS_A n f S)).map (LinearMap.mulRight (GaloisField 2 f) e)
  have hMdeg : Module.finrank (GaloisField 2 f) M = 1 := hdeg
  have heM : e ∈ M := ⟨e, he.1, by rw [LinearMap.mulRight_apply, he.2.1.eq]⟩
  have hene : (⟨e, heM⟩ : M) ≠ 0 := by
    intro h
    exact he.2.2.1 (by simpa using congrArg Subtype.val h)
  have haM : a * e ∈ M := ⟨a, ha, by rw [LinearMap.mulRight_apply]⟩
  obtain ⟨c, hc⟩ := (finrank_eq_one_iff_of_nonzero' (⟨e, heM⟩ : M) hene).mp hMdeg
    (⟨a * e, haM⟩ : M)
  exact ⟨c, by simpa using congrArg Subtype.val hc.symm⟩

private theorem bmDPS_block_scalar
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hdeg : blockDegree (bmDPS_A n f S) e < 2) :
    blockDegree (bmDPS_A n f S) e = 1 ∧
      ∀ a ∈ bmDPS_A n f S, ∃ c : GaloisField 2 f, a * e = c • e := by
  have h1 := bmDPS_blockDegree_eq_one n f S he hdeg
  exact ⟨h1, fun a ha => bmDPS_action_is_scalar n f S he h1 ha⟩

private theorem bmDPS_J_transpose (n f : ℕ) :
    Matrix.transpose (bmDPS_J n f) = bmDPS_J n f := by
  change Matrix.transpose (Matrix.fromBlocks 0 1 (-1) 0 :
    Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) = Matrix.fromBlocks 0 1 (-1) 0
  ext i j
  rcases i with i | i <;> rcases j with j | j <;>
    simp [Matrix.fromBlocks, Matrix.one_apply, CharTwo.neg_eq, eq_comm]

private theorem bmDPS_J_mul_self (n f : ℕ) : bmDPS_J n f * bmDPS_J n f = 1 := by
  change Matrix.fromBlocks 0 1 (-1) 0 * Matrix.fromBlocks 0 1 (-1) 0 =
    (1 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
  rw [Matrix.fromBlocks_multiply]
  ext i j
  rcases i with i | i <;> rcases j with j | j <;>
    simp [Matrix.one_apply, CharTwo.neg_eq]

private theorem bmDPS_J_isUnit_det (n f : ℕ) : IsUnit (bmDPS_J n f).det := by
  refine (Matrix.isUnit_iff_isUnit_det (bmDPS_J n f)).mp ?_
  exact isUnit_iff_exists.mpr ⟨bmDPS_J n f, bmDPS_J_mul_self n f, bmDPS_J_mul_self n f⟩

private theorem bmDPS_formAdj_zero {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (σ : F →+* F) (G : Matrix ι ι F) : formAdj σ G 0 = 0 := by
  unfold formAdj
  rw [Matrix.map_zero σ (map_zero σ), Matrix.transpose_zero, Matrix.mul_zero, Matrix.zero_mul]

private lemma bmDPS_adjoin_comm {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    {S : Set (GL ι F)} (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') :
    ∀ a ∈ Algebra.adjoin F (Units.val '' S), ∀ b ∈ Algebra.adjoin F (Units.val '' S),
      Commute a b := by
  intro a ha b hb
  have hgen : (Units.val '' S : Set (Matrix ι ι F)) ⊆
      (Subalgebra.centralizer F (Units.val '' S) : Set (Matrix ι ι F)) := by
    rintro x ⟨s, hs, rfl⟩
    refine (Subalgebra.mem_centralizer_iff F).mpr ?_
    intro y hy
    rcases hy with ⟨s', hs', rfl⟩
    have h := congrArg (fun u : GL ι F => (u : Matrix ι ι F)) (hS s' hs' s hs).eq
    simpa [Units.val_mul] using h
  have hA : Algebra.adjoin F (Units.val '' S) ≤ Subalgebra.centralizer F (Units.val '' S) :=
    Algebra.adjoin_le hgen
  have ha' : a ∈ Subalgebra.centralizer F (Units.val '' S) := hA ha
  have hgen2 : (Units.val '' S : Set (Matrix ι ι F)) ⊆
      (Subalgebra.centralizer F ({a} : Set (Matrix ι ι F)) : Set (Matrix ι ι F)) := by
    rintro x ⟨s, hs, rfl⟩
    refine (Subalgebra.mem_centralizer_iff F).mpr ?_
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    have h := (Subalgebra.mem_centralizer_iff F).mp ha' (s : Matrix ι ι F) ⟨s, hs, rfl⟩
    exact h.symm
  have hA2 : Algebra.adjoin F (Units.val '' S) ≤
      Subalgebra.centralizer F ({a} : Set (Matrix ι ι F)) := Algebra.adjoin_le hgen2
  have hb' : b ∈ Subalgebra.centralizer F ({a} : Set (Matrix ι ι F)) := hA2 hb
  exact (Subalgebra.mem_centralizer_iff F).mp hb' a (Set.mem_singleton a)

private theorem bmDPS_dualPair_data
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n (GaloisField 2 f))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hpair : bmDPS_estar n f e ≠ e) :
    e * bmDPS_estar n f e = 0 ∧ bmDPS_estar n f e * e = 0 ∧
      IsIdempotentElem (bmDPS_eps n f e) ∧
      IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e) := by
  have hG : IsUnit (bmDPS_J n f).det := bmDPS_J_isUnit_det n f
  have hGh : Matrix.transpose ((bmDPS_J n f).map (RingHom.id (GaloisField 2 f))) = bmDPS_J n f := by
    rw [show (⇑(RingHom.id (GaloisField 2 f)) : GaloisField 2 f → GaloisField 2 f) = id
      from rfl, Matrix.map_id]
    exact bmDPS_J_transpose n f
  have hSU' : ∀ s ∈ S, Matrix.transpose
      ((s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)).map
        (RingHom.id (GaloisField 2 f))) * bmDPS_J n f *
      (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) = bmDPS_J n f := by
    intro s hs
    have h := CFSG.Open.StatedAPI.mem_statedSp_iff.mp (hSU s hs)
    rwa [show (⇑(RingHom.id (GaloisField 2 f)) : GaloisField 2 f → GaloisField 2 f) = id
      from rfl, Matrix.map_id]
  obtain ⟨horth1, horth2⟩ := Geo.mul_formAdj_eq_zero_of_dualPair (RingHom.id (GaloisField 2 f))
    (fun x => rfl) hG hGh hSU' hS he hpair
  have hstar_idem : IsIdempotentElem (bmDPS_estar n f e) := by
    show bmDPS_estar n f e * bmDPS_estar n f e = bmDPS_estar n f e
    rw [← Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) hG e e, he.2.1.eq]
  have hstarA : bmDPS_estar n f e ∈ bmDPS_A n f S :=
    Geo.formAdj_mem_adjoin (RingHom.id (GaloisField 2 f)) hG hSU' he.1
  have hstar_ne : bmDPS_estar n f e ≠ 0 := by
    intro h0
    have he0 : e = 0 := by
      calc e = formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) (bmDPS_estar n f e) :=
            (Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl) hG hGh e).symm
        _ = formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) 0 := by rw [h0]
        _ = 0 := bmDPS_formAdj_zero (RingHom.id (GaloisField 2 f)) (bmDPS_J n f)
    exact he.2.2.1 he0
  have hprim : ∀ e' ∈ bmDPS_A n f S, IsIdempotentElem e' → e' * bmDPS_estar n f e = e' →
      e' = 0 ∨ e' = bmDPS_estar n f e := by
    intro e' he'A he'idem he'e
    have he'e' : bmDPS_estar n f e * e' = e' := by
      rw [← (bmDPS_adjoin_comm hS e' he'A (bmDPS_estar n f e) hstarA).eq, he'e]
    have hformA : formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) e' ∈ bmDPS_A n f S :=
      Geo.formAdj_mem_adjoin (RingHom.id (GaloisField 2 f)) hG hSU' he'A
    have hformidem : IsIdempotentElem
        (formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) e') := by
      show formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) e' *
        formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) e' =
        formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) e'
      rw [← Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) hG e' e', he'idem.eq]
    have hform_eq : formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) e' * e =
        formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) e' := by
      have h := congrArg (formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f)) he'e'
      rw [Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) hG (bmDPS_estar n f e) e'] at h
      rwa [Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl) hG hGh e] at h
    rcases he.2.2.2 (formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) e')
      hformA hformidem hform_eq with h0 | heq
    · left
      have h := congrArg (formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f)) h0
      rw [Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl) hG hGh e'] at h
      rw [h, bmDPS_formAdj_zero (RingHom.id (GaloisField 2 f)) (bmDPS_J n f)]
    · right
      have h := congrArg (formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f)) heq
      rwa [Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl) hG hGh e'] at h
  have heps_idem : IsIdempotentElem (bmDPS_eps n f e) := by
    show IsIdempotentElem (e + bmDPS_estar n f e)
    refine IsIdempotentElem.add he.2.1 hstar_idem ?_
    rw [horth1, horth2, add_zero]
  exact ⟨horth1, horth2, heps_idem, hstarA, hstar_idem, hstar_ne, hprim⟩

private theorem bmDPS_J_symmetric (n f : ℕ) :
    Matrix.transpose ((bmDPS_J n f).map (RingHom.id (GaloisField 2 f))) = bmDPS_J n f := by
  rw [show (⇑(RingHom.id (GaloisField 2 f)) : GaloisField 2 f → GaloisField 2 f) = id
      from rfl, Matrix.map_id]
  exact bmDPS_J_transpose n f

private theorem bmDPS_statedSp_isometry (n f : ℕ)
    (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n (GaloisField 2 f)) :
    ∀ s ∈ S, Matrix.transpose ((s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)).map
        (RingHom.id (GaloisField 2 f))) * bmDPS_J n f *
      (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) = bmDPS_J n f := by
  intro s hs
  have h := CFSG.Open.StatedAPI.mem_statedSp_iff.mp (hSU s hs)
  rwa [show (⇑(RingHom.id (GaloisField 2 f)) : GaloisField 2 f → GaloisField 2 f) = id
      from rfl, Matrix.map_id]

private theorem bmDPS_generator_scalar
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n (GaloisField 2 f))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hdeg : blockDegree (bmDPS_A n f S) e < 2) :
    bmDPS_scalarAction n f S e := by
  have hdeg1 : blockDegree (bmDPS_A n f S) e = 1 := (bmDPS_block_scalar n f S he hdeg).1
  intro s hs
  exact Geo.exists_eigen_of_dualPair (RingHom.id (GaloisField 2 f)) (fun x => rfl)
    (bmDPS_J_isUnit_det n f) (bmDPS_J_symmetric n f) (bmDPS_statedSp_isometry n f S hSU) hS he
    hdeg1 hs

private noncomputable abbrev bmDPS_D0 (r r' : ℕ) (F : Type) [Zero F] [One F] :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F :=
  Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) F)
    (0 : Matrix (Fin r) (Fin r ⊕ Fin r') F)
    (0 : Matrix (Fin r ⊕ Fin r') (Fin r) F)
    (Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
      (0 : Matrix (Fin r) (Fin r') F) (0 : Matrix (Fin r') (Fin r) F)
      (0 : Matrix (Fin r') (Fin r') F))

private theorem bmDPS_eps_adjoint (n f : ℕ)
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    Matrix.transpose (bmDPS_eps n f e) * bmDPS_J n f =
      bmDPS_J n f * bmDPS_eps n f e := by
  have hfix0 : formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) (bmDPS_eps n f e) =
      bmDPS_eps n f e := by
    rw [bmDPS_eps, bmDPS_estar,
      Geo.formAdj_add (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) e
        (formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) e),
      Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl)
        (bmDPS_J_isUnit_det n f) (bmDPS_J_symmetric n f) e]
    abel
  have hfix : (bmDPS_J n f)⁻¹ * Matrix.transpose (bmDPS_eps n f e) * bmDPS_J n f =
      bmDPS_eps n f e := by
    simpa [formAdj] using hfix0
  have h2 : bmDPS_J n f *
      ((bmDPS_J n f)⁻¹ * Matrix.transpose (bmDPS_eps n f e) * bmDPS_J n f) =
        bmDPS_J n f * bmDPS_eps n f e := by rw [hfix]
  rw [← Matrix.mul_assoc, ← Matrix.mul_assoc,
    Matrix.mul_nonsing_inv _ (bmDPS_J_isUnit_det n f), Matrix.one_mul] at h2
  exact h2

private theorem bmDPS_exists_symplectic_basis_of_selfAdjointIdem (n f : ℕ)
    {N : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hNN : N * N = N) (hadj : Matrix.transpose N * bmDPS_J n f = bmDPS_J n f * N) :
    ∃ (r : ℕ) (B : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f)),
      Matrix.transpose B * bmDPS_J n f * B = bmDPS_J r f ∧
        N * B = B ∧
        (∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
          ∃ c : Fin r ⊕ Fin r → GaloisField 2 f, Matrix.mulVec N x = Matrix.mulVec B c) := by
  classical
  set U : Submodule (GaloisField 2 f) (Fin n ⊕ Fin n → GaloisField 2 f) :=
    LinearMap.range (Matrix.mulVecLin N) with hU
  have hUmem : ∀ u : Fin n ⊕ Fin n → GaloisField 2 f,
      u ∈ U ↔ ∃ v, Matrix.mulVec N v = u := by
    intro u
    simp [hU, LinearMap.mem_range, Matrix.mulVecLin_apply]
  have hJalt : ∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
      x ⬝ᵥ Matrix.mulVec (bmDPS_J n f) x = 0 := by
    intro x
    rw [bmDPS_J, Matrix.fromBlocks_mulVec]
    simp only [Matrix.zero_mulVec, Matrix.one_mulVec, add_zero, zero_add]
    rw [dotProduct, Fintype.sum_sum_type]
    simp only [Function.comp_apply, dotProduct, Sum.elim_inl, Sum.elim_inr,
      Matrix.neg_mulVec, Pi.neg_apply, one_mul]
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_eq_zero
    intro k _
    simp only [Function.comp_apply, Matrix.one_mulVec]
    ring
  have hβalt : (Matrix.toBilin' (bmDPS_J n f)).IsAlt := by
    intro x
    rw [Matrix.toBilin'_apply']
    exact hJalt x
  have hβnd : (Matrix.toBilin' (bmDPS_J n f)).Nondegenerate :=
    Matrix.nondegenerate_toBilin'_iff.mpr
      (Matrix.nondegenerate_iff_det_ne_zero.mpr (bmDPS_J_isUnit_det n f).ne_zero)
  have hUalt : ((Matrix.toBilin' (bmDPS_J n f)).restrict U).IsAlt :=
    fun x => hβalt (x : Fin n ⊕ Fin n → GaloisField 2 f)
  have hmulVecN : ∀ {u : Fin n ⊕ Fin n → GaloisField 2 f}, u ∈ U → Matrix.mulVec N u = u := by
    intro u hu
    obtain ⟨v, hv⟩ := (hUmem u).mp hu
    rw [← hv, Matrix.mulVec_mulVec, hNN]
  have hβadj : ∀ x y : Fin n ⊕ Fin n → GaloisField 2 f,
      (Matrix.toBilin' (bmDPS_J n f)) (Matrix.mulVec N x) y =
        (Matrix.toBilin' (bmDPS_J n f)) x (Matrix.mulVec N y) := by
    intro x y
    rw [Matrix.toBilin'_apply', Matrix.toBilin'_apply']
    calc (Matrix.mulVec N x) ⬝ᵥ Matrix.mulVec (bmDPS_J n f) y
        = Matrix.vecMul (Matrix.mulVec N x) (bmDPS_J n f) ⬝ᵥ y := by
          rw [Matrix.dotProduct_mulVec]
      _ = Matrix.vecMul x (Matrix.transpose N * bmDPS_J n f) ⬝ᵥ y := by
          rw [Matrix.vecMul_mulVec]
      _ = Matrix.vecMul x (bmDPS_J n f * N) ⬝ᵥ y := by rw [hadj]
      _ = x ⬝ᵥ Matrix.mulVec (bmDPS_J n f * N) y := by rw [Matrix.dotProduct_mulVec]
      _ = x ⬝ᵥ Matrix.mulVec (bmDPS_J n f) (Matrix.mulVec N y) := by
          rw [← Matrix.mulVec_mulVec]
  have hUnd : ((Matrix.toBilin' (bmDPS_J n f)).restrict U).Nondegenerate := by
    have hrefl : ((Matrix.toBilin' (bmDPS_J n f)).restrict U).IsRefl := hUalt.isRefl
    refine (LinearMap.IsRefl.nondegenerate_iff_separatingLeft hrefl).mpr ?_
    intro x hx
    apply Subtype.ext
    refine hβnd.1 (x : Fin n ⊕ Fin n → GaloisField 2 f) fun y => ?_
    calc (Matrix.toBilin' (bmDPS_J n f)) (x : Fin n ⊕ Fin n → GaloisField 2 f) y
        = (Matrix.toBilin' (bmDPS_J n f)) (Matrix.mulVec N
            (x : Fin n ⊕ Fin n → GaloisField 2 f)) y := by
          rw [hmulVecN x.2]
      _ = (Matrix.toBilin' (bmDPS_J n f)) (x : Fin n ⊕ Fin n → GaloisField 2 f)
            (Matrix.mulVec N y) := hβadj (x : Fin n ⊕ Fin n → GaloisField 2 f) y
      _ = 0 := by
          have hy : Matrix.mulVec N y ∈ U := (hUmem _).mpr ⟨y, rfl⟩
          simpa using hx ⟨Matrix.mulVec N y, hy⟩
  obtain ⟨r, b, hbJ⟩ :=
    LinearMap.BilinForm.IsAlt.exists_basis_toMatrix_eq_J
      (B := (Matrix.toBilin' (bmDPS_J n f)).restrict U) hUalt hUnd
  let B : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f) :=
    Matrix.of fun i j => (b j : Fin n ⊕ Fin n → GaloisField 2 f) i
  have hJconvert : Matrix.J (Fin r) (GaloisField 2 f) = bmDPS_J r f := by
    ext i j
    rcases i with i | i <;> rcases j with j | j <;>
      simp [Matrix.J, bmDPS_J, CharTwo.neg_eq, eq_comm]
  refine ⟨r, B, ?_, ?_, ?_⟩
  · have hBcol : ∀ j : Fin r ⊕ Fin r,
        Matrix.mulVec B (Pi.single j 1) = (b j : Fin n ⊕ Fin n → GaloisField 2 f) := by
      intro j
      rw [Matrix.mulVec_single_one]
      rfl
    have hkey : ∀ j j' : Fin r ⊕ Fin r,
        (Matrix.toBilin' (bmDPS_J n f)) (b j : Fin n ⊕ Fin n → GaloisField 2 f)
          (b j' : Fin n ⊕ Fin n → GaloisField 2 f) =
          (Matrix.transpose B * bmDPS_J n f * B) j j' := by
      intro j j'
      have h := DFunLike.congr_fun (DFunLike.congr_fun
        (Matrix.toBilin'_comp (bmDPS_J n f) B B) (Pi.single j 1)) (Pi.single j' 1)
      simpa [Matrix.toLin'_apply, hBcol j, hBcol j'] using h
    have hbJentry : ∀ j j' : Fin r ⊕ Fin r,
        (Matrix.toBilin' (bmDPS_J n f)) (b j : Fin n ⊕ Fin n → GaloisField 2 f)
          (b j' : Fin n ⊕ Fin n → GaloisField 2 f) = bmDPS_J r f j j' := by
      intro j j'
      have h := congrFun (congrFun hbJ j) j'
      rw [hJconvert] at h
      simpa [Matrix.toBilin'_apply] using h
    ext j j'
    rw [← hkey j j']
    exact hbJentry j j'
  · ext i j
    have hfix : Matrix.mulVec N (b j : Fin n ⊕ Fin n → GaloisField 2 f) =
        (b j : Fin n ⊕ Fin n → GaloisField 2 f) := hmulVecN (b j).2
    rw [Matrix.mul_apply]
    trans (Matrix.mulVec N (b j : Fin n ⊕ Fin n → GaloisField 2 f)) i
    · simp [Matrix.mulVec, dotProduct, B]
    · rw [hfix]
      simp [B]
  · intro x
    have hxU : Matrix.mulVec N x ∈ U := (hUmem _).mpr ⟨x, rfl⟩
    refine ⟨b.equivFun ⟨Matrix.mulVec N x, hxU⟩, ?_⟩
    have hBc : ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec B c = ((b.equivFun.symm c : U) : Fin n ⊕ Fin n → GaloisField 2 f) := by
      intro c
      simp only [Module.Basis.equivFun_symm_apply]
      ext i
      simp only [Matrix.mulVec, dotProduct, B, Matrix.of_apply, Submodule.coe_sum,
        Submodule.coe_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
      exact Finset.sum_congr rfl fun j _ => mul_comm _ _
    rw [hBc, b.equivFun.symm_apply_apply]

private theorem bmDPS_one_sub_eps_mul_self (n f : ℕ)
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (heps : IsIdempotentElem (bmDPS_eps n f e)) :
    (1 - bmDPS_eps n f e) * (1 - bmDPS_eps n f e) = 1 - bmDPS_eps n f e := by
  rw [Matrix.sub_mul, Matrix.one_mul, Matrix.mul_sub, Matrix.mul_one, heps.eq]
  abel

private theorem bmDPS_one_sub_eps_adjoint (n f : ℕ)
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    Matrix.transpose (1 - bmDPS_eps n f e) * bmDPS_J n f =
      bmDPS_J n f * (1 - bmDPS_eps n f e) := by
  rw [Matrix.transpose_sub, Matrix.transpose_one, Matrix.sub_mul, Matrix.one_mul,
    bmDPS_eps_adjoint n f e, Matrix.mul_sub, Matrix.mul_one]

private theorem bmDPS_exists_symplectic_basis_compl
    (n f : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (heps : IsIdempotentElem (bmDPS_eps n f e)) :
    ∃ (r' : ℕ) (Bc : Matrix (Fin n ⊕ Fin n) (Fin r' ⊕ Fin r') (GaloisField 2 f)),
      Matrix.transpose Bc * bmDPS_J n f * Bc = bmDPS_J r' f ∧
        (1 - bmDPS_eps n f e) * Bc = Bc ∧
        (∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
          ∃ c : Fin r' ⊕ Fin r' → GaloisField 2 f,
            Matrix.mulVec (1 - bmDPS_eps n f e) x = Matrix.mulVec Bc c) :=
  bmDPS_exists_symplectic_basis_of_selfAdjointIdem n f
    (bmDPS_one_sub_eps_mul_self n f e heps) (bmDPS_one_sub_eps_adjoint n f e)

private theorem bmDPS_range_eps_eq_sup
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (horth : e * bmDPS_estar n f e = 0) (horth' : bmDPS_estar n f e * e = 0)
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e)) :
    LinearMap.range (Matrix.mulVecLin (bmDPS_eps n f e)) =
      LinearMap.range (Matrix.mulVecLin e) ⊔
        LinearMap.range (Matrix.mulVecLin (bmDPS_estar n f e)) := by
  have hee : e * e = e := he.2.1.eq
  have hes : bmDPS_estar n f e * bmDPS_estar n f e = bmDPS_estar n f e := hestar.2.1.eq
  have hee' : bmDPS_eps n f e * e = e := by
    rw [bmDPS_eps, Matrix.add_mul, hee, horth', add_zero]
  have hes' : bmDPS_eps n f e * bmDPS_estar n f e = bmDPS_estar n f e := by
    rw [bmDPS_eps, Matrix.add_mul, horth, zero_add, hes]
  apply le_antisymm
  · rintro x ⟨v, rfl⟩
    rw [Matrix.mulVecLin_apply, bmDPS_eps, Matrix.add_mulVec]
    exact Submodule.add_mem_sup ⟨v, rfl⟩ ⟨v, rfl⟩
  · apply sup_le
    · rintro x ⟨v, rfl⟩
      rw [Matrix.mulVecLin_apply]
      exact ⟨Matrix.mulVec e v, by rw [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hee']⟩
    · rintro x ⟨v, rfl⟩
      rw [Matrix.mulVecLin_apply]
      exact ⟨Matrix.mulVec (bmDPS_estar n f e) v,
        by rw [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hes']⟩

private theorem bmDPS_dualMap_apply_zero (n f r : ℕ)
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (c : Module.Dual (GaloisField 2 f) (Fin r → GaloisField 2 f))
    (hc : (Matrix.mulVecLin (Matrix.transpose We * bmDPS_J n f)).dualMap c = 0) :
    ∀ v : Fin n ⊕ Fin n → GaloisField 2 f,
      c (Matrix.mulVec (Matrix.transpose We * bmDPS_J n f) v) = 0 := by
  intro v
  have h := DFunLike.congr_fun hc v
  simpa only [LinearMap.dualMap_apply, Matrix.mulVecLin_apply, LinearMap.zero_apply] using h

private theorem bmDPS_dualMap_ker_vec (n f r : ℕ)
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (c : Module.Dual (GaloisField 2 f) (Fin r → GaloisField 2 f))
    (hc : ∀ v : Fin n ⊕ Fin n → GaloisField 2 f,
      c (Matrix.mulVec (Matrix.transpose We * bmDPS_J n f) v) = 0) :
    Matrix.mulVec We (fun j => c (Pi.single j 1)) = 0 := by
  ext i
  have h := hc (Matrix.mulVec (bmDPS_J n f)⁻¹ (Pi.single i 1))
  have h1 : Matrix.mulVec (Matrix.transpose We * bmDPS_J n f)
        (Matrix.mulVec (bmDPS_J n f)⁻¹ (Pi.single i 1)) =
      Matrix.mulVec (Matrix.transpose We) (Pi.single i 1) := by
    rw [Matrix.mulVec_mulVec, Matrix.mul_assoc,
      Matrix.mul_nonsing_inv _ (bmDPS_J_isUnit_det n f), Matrix.mul_one]
  rw [h1] at h
  have h2 : (Matrix.mulVec We (fun j => c (Pi.single j 1))) i =
      c (Matrix.mulVec (Matrix.transpose We) (Pi.single i 1)) := by
    rw [show Matrix.mulVec (Matrix.transpose We) (Pi.single i 1) =
        ∑ j, We i j • Pi.single j 1 from by
      ext k
      simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply, Finset.sum_apply,
        Pi.smul_apply, smul_eq_mul]
      rw [Fintype.sum_eq_single i (fun m hm => by simp [Pi.single_eq_of_ne hm])]
      rw [Fintype.sum_eq_single k (fun m hm => by simp [Pi.single_eq_of_ne (Ne.symm hm)])]
      simp]
    rw [map_sum]
    simp only [map_smul, Matrix.mulVec, dotProduct]
    apply Finset.sum_congr rfl
    intro j _
    ring
  rw [h2]
  exact h

private theorem bmDPS_dualMap_injective (n f r : ℕ)
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hinj : Function.Injective (fun c : Fin r → GaloisField 2 f => Matrix.mulVec We c)) :
    Function.Injective (Matrix.mulVecLin (Matrix.transpose We * bmDPS_J n f)).dualMap := by
  intro c c' hcc
  have hzero : Matrix.mulVec We (fun j => (c - c') (Pi.single j 1)) = 0 := by
    apply bmDPS_dualMap_ker_vec n f r We (c - c')
    intro v
    have h : (Matrix.mulVecLin (Matrix.transpose We * bmDPS_J n f)).dualMap (c - c') = 0 := by
      rw [map_sub, hcc, sub_self]
    exact bmDPS_dualMap_apply_zero n f r We (c - c') h v
  have hcvec : (fun j => (c - c') (Pi.single j 1)) = 0 := by
    apply hinj
    simpa using hzero
  have hsub : c - c' = 0 := by
    apply LinearMap.ext
    intro w
    have hw : w = ∑ j, w j • Pi.single j 1 := by
      ext k
      rw [Finset.sum_apply]
      simp only [Pi.smul_apply, smul_eq_mul]
      rw [Fintype.sum_eq_single k (fun m hm => by simp [Pi.single_eq_of_ne (Ne.symm hm)])]
      simp
    rw [hw, map_sum]
    apply Finset.sum_eq_zero
    intro j _
    rw [map_smul, congrFun hcvec j]
    simp
  exact sub_eq_zero.mp hsub

private theorem bmDPS_mulVec_transpose_surjective (n f r : ℕ)
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hinj : Function.Injective (fun c : Fin r → GaloisField 2 f => Matrix.mulVec We c)) :
    Function.Surjective (fun v : Fin n ⊕ Fin n → GaloisField 2 f =>
      Matrix.mulVec (Matrix.transpose We * bmDPS_J n f) v) := by
  change Function.Surjective (Matrix.mulVecLin (Matrix.transpose We * bmDPS_J n f))
  rw [← LinearMap.dualMap_injective_iff]
  exact bmDPS_dualMap_injective n f r We hinj

private theorem bmDPS_exists_rightInverse_of_columns (n f r : ℕ)
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hinj : Function.Injective (fun c : Fin r → GaloisField 2 f => Matrix.mulVec We c)) :
    ∃ V : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f),
      Matrix.transpose We * bmDPS_J n f * V = 1 :=
  Matrix.mulVec_surjective_iff_exists_right_inverse.mp
    (bmDPS_mulVec_transpose_surjective n f r We hinj)

private theorem bmDPS_estar_mul_dual (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (We V : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWe : e * We = We) (hV : Matrix.transpose We * bmDPS_J n f * V = 1)
    (hstar : bmDPS_estar n f e * bmDPS_estar n f e = bmDPS_estar n f e) :
    bmDPS_estar n f e * (bmDPS_estar n f e * V) = bmDPS_estar n f e * V ∧
      Matrix.transpose We * bmDPS_J n f * (bmDPS_estar n f e * V) = 1 := by
  have hestar : bmDPS_estar n f e = (bmDPS_J n f)⁻¹ * Matrix.transpose e * bmDPS_J n f := by
    simp only [bmDPS_estar, formAdj]
    rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
      congrArg Matrix.transpose (Matrix.map_id e)]
  have hJ : bmDPS_J n f * bmDPS_estar n f e = Matrix.transpose e * bmDPS_J n f := by
    rw [hestar]
    calc bmDPS_J n f * ((bmDPS_J n f)⁻¹ * Matrix.transpose e * bmDPS_J n f)
        = (bmDPS_J n f * (bmDPS_J n f)⁻¹) * (Matrix.transpose e * bmDPS_J n f) := by
          noncomm_ring
      _ = Matrix.transpose e * bmDPS_J n f := by
          rw [Matrix.mul_nonsing_inv _ (bmDPS_J_isUnit_det n f), Matrix.one_mul]
  have hWs : Matrix.transpose We * bmDPS_J n f * bmDPS_estar n f e =
      Matrix.transpose We * bmDPS_J n f := by
    calc Matrix.transpose We * bmDPS_J n f * bmDPS_estar n f e
        = Matrix.transpose We * (bmDPS_J n f * bmDPS_estar n f e) := by rw [Matrix.mul_assoc]
      _ = Matrix.transpose We * (Matrix.transpose e * bmDPS_J n f) := by rw [hJ]
      _ = (Matrix.transpose We * Matrix.transpose e) * bmDPS_J n f := by rw [Matrix.mul_assoc]
      _ = Matrix.transpose (e * We) * bmDPS_J n f := by rw [← Matrix.transpose_mul]
      _ = Matrix.transpose We * bmDPS_J n f := by rw [hWe]
  constructor
  · rw [← Matrix.mul_assoc, hstar]
  · rw [← Matrix.mul_assoc, hWs, hV]

private noncomputable def bmDPS_blockCols {n f r : ℕ}
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f)) :
    Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f) :=
  Matrix.of fun i j => Sum.elim (fun a => We i a) (fun b => Ws i b) j

private theorem bmDPS_adapted_Pe_form_11 (n f r : ℕ)
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWeIso : Matrix.transpose We * bmDPS_J n f * We = 0) (a a' : Fin r) :
    (Matrix.transpose (bmDPS_blockCols We Ws) * bmDPS_J n f * bmDPS_blockCols We Ws)
        (Sum.inl a) (Sum.inl a') = bmDPS_J r f (Sum.inl a) (Sum.inl a') := by
  have h := congrFun (congrFun hWeIso a) a'
  simp only [Matrix.zero_apply] at h
  rw [show bmDPS_J r f (Sum.inl a) (Sum.inl a') = 0 from by
    simp [bmDPS_J, Matrix.fromBlocks]]
  rw [← h]
  simp only [bmDPS_blockCols, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Finset.sum_apply, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr]

private theorem bmDPS_adapted_Pe_form_12 (n f r : ℕ)
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hdual : Matrix.transpose We * bmDPS_J n f * Ws = 1) (a b : Fin r) :
    (Matrix.transpose (bmDPS_blockCols We Ws) * bmDPS_J n f * bmDPS_blockCols We Ws)
        (Sum.inl a) (Sum.inr b) = bmDPS_J r f (Sum.inl a) (Sum.inr b) := by
  have h := congrFun (congrFun hdual a) b
  rw [show bmDPS_J r f (Sum.inl a) (Sum.inr b) =
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) a b from by
    simp [bmDPS_J, Matrix.fromBlocks]]
  rw [← h]
  simp only [bmDPS_blockCols, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Finset.sum_apply, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr]

private theorem bmDPS_adapted_Pe_form_21 (n f r : ℕ)
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hdual : Matrix.transpose We * bmDPS_J n f * Ws = 1) (b a : Fin r) :
    (Matrix.transpose (bmDPS_blockCols We Ws) * bmDPS_J n f * bmDPS_blockCols We Ws)
        (Sum.inr b) (Sum.inl a) = bmDPS_J r f (Sum.inr b) (Sum.inl a) := by
  have htrans : Matrix.transpose Ws * bmDPS_J n f * We = 1 := by
    have h := congrArg Matrix.transpose hdual
    simpa [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.transpose_one,
      bmDPS_J_transpose, Matrix.mul_assoc] using h
  have h' := congrFun (congrFun htrans b) a
  have hR : bmDPS_J r f (Sum.inr b) (Sum.inl a) =
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) b a := by
    simp [bmDPS_J, Matrix.fromBlocks, Matrix.neg_apply, Matrix.one_apply, CharTwo.neg_eq]
  rw [hR, ← h']
  simp only [bmDPS_blockCols, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Finset.sum_apply, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr]

private theorem bmDPS_adapted_Pe_form_22 (n f r : ℕ)
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWsIso : Matrix.transpose Ws * bmDPS_J n f * Ws = 0) (b b' : Fin r) :
    (Matrix.transpose (bmDPS_blockCols We Ws) * bmDPS_J n f * bmDPS_blockCols We Ws)
        (Sum.inr b) (Sum.inr b') = bmDPS_J r f (Sum.inr b) (Sum.inr b') := by
  have h := congrFun (congrFun hWsIso b) b'
  simp only [Matrix.zero_apply] at h
  rw [show bmDPS_J r f (Sum.inr b) (Sum.inr b') = 0 from by
    simp [bmDPS_J, Matrix.fromBlocks]]
  rw [← h]
  simp only [bmDPS_blockCols, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Finset.sum_apply, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr]

private theorem bmDPS_adapted_Pe_form (n f r : ℕ)
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hdual : Matrix.transpose We * bmDPS_J n f * Ws = 1)
    (hWeIso : Matrix.transpose We * bmDPS_J n f * We = 0)
    (hWsIso : Matrix.transpose Ws * bmDPS_J n f * Ws = 0) :
    Matrix.transpose (bmDPS_blockCols We Ws) * bmDPS_J n f * bmDPS_blockCols We Ws =
      bmDPS_J r f := by
  ext j j'
  rcases j with a | b <;> rcases j' with a' | b'
  · exact bmDPS_adapted_Pe_form_11 n f r We Ws hWeIso a a'
  · exact bmDPS_adapted_Pe_form_12 n f r We Ws hdual a b'
  · exact bmDPS_adapted_Pe_form_21 n f r We Ws hdual b a'
  · exact bmDPS_adapted_Pe_form_22 n f r We Ws hWsIso b b'

private theorem bmDPS_adapted_Pe_diag (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWe : e * We = We) (hWs : bmDPS_estar n f e * Ws = Ws)
    (heWs : e * Ws = 0) (hesWe : bmDPS_estar n f e * We = 0) :
    e * bmDPS_blockCols We Ws =
        bmDPS_blockCols We Ws * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) ∧
      bmDPS_estar n f e * bmDPS_blockCols We Ws =
        bmDPS_blockCols We Ws * Matrix.fromBlocks
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) := by
  constructor
  · ext i j
    rcases j with a | b
    · rw [Matrix.mul_apply]
      have hR : (bmDPS_blockCols We Ws * Matrix.fromBlocks
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) i (Sum.inl a) = We i a := by
        rw [Matrix.mul_apply]
        rw [Fintype.sum_eq_single (Sum.inl a) (fun k hk => by
          rcases k with c | d
          · have hca : c ≠ a := fun h => hk (by rw [h])
            simp [bmDPS_blockCols, Matrix.of_apply, Sum.elim_inl, Matrix.fromBlocks,
              Matrix.one_apply, hca]
          · simp [bmDPS_blockCols, Matrix.of_apply, Sum.elim_inr, Matrix.fromBlocks])]
        simp [bmDPS_blockCols, Matrix.fromBlocks]
      rw [hR]
      simp only [bmDPS_blockCols, Matrix.of_apply, Sum.elim_inl]
      rw [← Matrix.mul_apply, hWe]
    · rw [Matrix.mul_apply]
      have hR : (bmDPS_blockCols We Ws * Matrix.fromBlocks
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) i (Sum.inr b) =
            (0 : GaloisField 2 f) := by
        rw [Matrix.mul_apply]
        apply Finset.sum_eq_zero
        intro k _
        rcases k with c | d <;> simp [bmDPS_blockCols, Matrix.of_apply, Sum.elim_inl,
          Sum.elim_inr, Matrix.fromBlocks]
      rw [hR]
      simp only [bmDPS_blockCols, Matrix.of_apply, Sum.elim_inr]
      rw [← Matrix.mul_apply, heWs]
      simp
  · ext i j
    rcases j with a | b
    · rw [Matrix.mul_apply]
      have hR : (bmDPS_blockCols We Ws * Matrix.fromBlocks
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) i (Sum.inl a) =
            (0 : GaloisField 2 f) := by
        rw [Matrix.mul_apply]
        apply Finset.sum_eq_zero
        intro k _
        rcases k with c | d <;> simp [bmDPS_blockCols, Matrix.of_apply, Sum.elim_inl,
          Sum.elim_inr, Matrix.fromBlocks]
      rw [hR]
      simp only [bmDPS_blockCols, Matrix.of_apply, Sum.elim_inl]
      rw [← Matrix.mul_apply, hesWe]
      simp
    · rw [Matrix.mul_apply]
      have hR : (bmDPS_blockCols We Ws * Matrix.fromBlocks
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) i (Sum.inr b) = Ws i b := by
        rw [Matrix.mul_apply]
        rw [Fintype.sum_eq_single (Sum.inr b) (fun k hk => by
          rcases k with c | d
          · simp [bmDPS_blockCols, Matrix.of_apply, Sum.elim_inl, Matrix.fromBlocks]
          · have hdb : d ≠ b := fun h => hk (by rw [h])
            simp [bmDPS_blockCols, Matrix.of_apply, Sum.elim_inr, Matrix.fromBlocks,
              Matrix.one_apply, hdb])]
        simp [bmDPS_blockCols, Matrix.fromBlocks]
      rw [hR]
      simp only [bmDPS_blockCols, Matrix.of_apply, Sum.elim_inr]
      rw [← Matrix.mul_apply, hWs]

private theorem bmDPS_adapted_Pe_eps (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hdE : e * bmDPS_blockCols We Ws =
        bmDPS_blockCols We Ws * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hdS : bmDPS_estar n f e * bmDPS_blockCols We Ws =
        bmDPS_blockCols We Ws * Matrix.fromBlocks
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) :
    bmDPS_eps n f e * bmDPS_blockCols We Ws = bmDPS_blockCols We Ws := by
  rw [bmDPS_eps, Matrix.add_mul, hdE, hdS, ← Matrix.mul_add]
  rw [show Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) +
      Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) = 1 from by
    rw [Matrix.fromBlocks_add]
    ext i j
    rcases i with i | i <;> rcases j with j | j <;>
      simp [Matrix.fromBlocks, Matrix.one_apply, Matrix.add_apply]]
  rw [Matrix.mul_one]

private theorem bmDPS_e_mul_Ws_zero (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWs : bmDPS_estar n f e * Ws = Ws) (horth : e * bmDPS_estar n f e = 0) :
    e * Ws = 0 := by
  rw [← hWs, ← Matrix.mul_assoc, horth, Matrix.zero_mul]

private theorem bmDPS_estar_mul_We_zero (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWe : e * We = We) (horth' : bmDPS_estar n f e * e = 0) :
    bmDPS_estar n f e * We = 0 := by
  rw [← hWe, ← Matrix.mul_assoc, horth', Matrix.zero_mul]

private theorem bmDPS_We_iso (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWe : e * We = We) (horth' : bmDPS_estar n f e * e = 0) :
    Matrix.transpose We * bmDPS_J n f * We = 0 := by
  have hJ : bmDPS_J n f * bmDPS_estar n f e = Matrix.transpose e * bmDPS_J n f := by
    simp only [bmDPS_estar, formAdj]
    rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
      congrArg Matrix.transpose (Matrix.map_id e)]
    calc bmDPS_J n f * ((bmDPS_J n f)⁻¹ * Matrix.transpose e * bmDPS_J n f)
        = (bmDPS_J n f * (bmDPS_J n f)⁻¹) * (Matrix.transpose e * bmDPS_J n f) := by
          noncomm_ring
      _ = Matrix.transpose e * bmDPS_J n f := by
          rw [Matrix.mul_nonsing_inv _ (bmDPS_J_isUnit_det n f), Matrix.one_mul]
  have heJe : Matrix.transpose e * bmDPS_J n f * e = 0 := by
    rw [← hJ, Matrix.mul_assoc, horth', Matrix.mul_zero]
  calc Matrix.transpose We * bmDPS_J n f * We
      = Matrix.transpose (e * We) * bmDPS_J n f * (e * We) := by rw [hWe]
    _ = Matrix.transpose We * (Matrix.transpose e * bmDPS_J n f * e) * We := by
        rw [Matrix.transpose_mul]
        simp only [Matrix.mul_assoc]
    _ = 0 := by rw [heJe, Matrix.mul_zero, Matrix.zero_mul]

private theorem bmDPS_Ws_iso (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWs : bmDPS_estar n f e * Ws = Ws) (horth : e * bmDPS_estar n f e = 0) :
    Matrix.transpose Ws * bmDPS_J n f * Ws = 0 := by
  have hJ : bmDPS_J n f * bmDPS_estar n f e = Matrix.transpose e * bmDPS_J n f := by
    simp only [bmDPS_estar, formAdj]
    rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
      congrArg Matrix.transpose (Matrix.map_id e)]
    calc bmDPS_J n f * ((bmDPS_J n f)⁻¹ * Matrix.transpose e * bmDPS_J n f)
        = (bmDPS_J n f * (bmDPS_J n f)⁻¹) * (Matrix.transpose e * bmDPS_J n f) := by
          noncomm_ring
      _ = Matrix.transpose e * bmDPS_J n f := by
          rw [Matrix.mul_nonsing_inv _ (bmDPS_J_isUnit_det n f), Matrix.one_mul]
  have hJstar : Matrix.transpose (bmDPS_estar n f e) * bmDPS_J n f = bmDPS_J n f * e := by
    have h := congrArg Matrix.transpose hJ
    simpa [Matrix.transpose_mul, Matrix.transpose_transpose, bmDPS_J_transpose] using h
  have hesJes : Matrix.transpose (bmDPS_estar n f e) * bmDPS_J n f * bmDPS_estar n f e = 0 := by
    rw [hJstar, Matrix.mul_assoc, horth, Matrix.mul_zero]
  calc Matrix.transpose Ws * bmDPS_J n f * Ws
      = Matrix.transpose (bmDPS_estar n f e * Ws) * bmDPS_J n f *
          (bmDPS_estar n f e * Ws) := by rw [hWs]
    _ = Matrix.transpose Ws * (Matrix.transpose (bmDPS_estar n f e) * bmDPS_J n f *
          bmDPS_estar n f e) * Ws := by
        rw [Matrix.transpose_mul]
        simp only [Matrix.mul_assoc]
    _ = 0 := by rw [hesJes, Matrix.mul_zero, Matrix.zero_mul]

private theorem bmDPS_adapted_basis_orth (n f r s : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPe : bmDPS_eps n f e * Pe = Pe) (hBc : (1 - bmDPS_eps n f e) * Bc = Bc)
    (heps : IsIdempotentElem (bmDPS_eps n f e))
    (hadj : Matrix.transpose (bmDPS_eps n f e) * bmDPS_J n f =
      bmDPS_J n f * bmDPS_eps n f e) :
    Matrix.transpose Pe * bmDPS_J n f * Bc = 0 := by
  have hzero : bmDPS_eps n f e * (1 - bmDPS_eps n f e) = 0 := by
    rw [Matrix.mul_sub, Matrix.mul_one, heps, sub_self]
  have hkey : Matrix.transpose (bmDPS_eps n f e) * bmDPS_J n f *
      (1 - bmDPS_eps n f e) = 0 := by
    rw [hadj, Matrix.mul_assoc, hzero, Matrix.mul_zero]
  rw [← hPe, ← hBc, Matrix.transpose_mul]
  rw [Matrix.mul_assoc (Matrix.transpose Pe * Matrix.transpose (bmDPS_eps n f e))
    (bmDPS_J n f) ((1 - bmDPS_eps n f e) * Bc)]
  rw [Matrix.mul_assoc (Matrix.transpose Pe) (Matrix.transpose (bmDPS_eps n f e))
    (bmDPS_J n f * ((1 - bmDPS_eps n f e) * Bc))]
  rw [← Matrix.mul_assoc (Matrix.transpose (bmDPS_eps n f e)) (bmDPS_J n f)
    ((1 - bmDPS_eps n f e) * Bc)]
  rw [← Matrix.mul_assoc (Matrix.transpose (bmDPS_eps n f e) * bmDPS_J n f)
    (1 - bmDPS_eps n f e) Bc]
  rw [hkey, Matrix.zero_mul, Matrix.mul_zero]

private theorem bmDPS_symplectic_inv (n f : ℕ)
    (Q : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hQ : Matrix.transpose Q * bmDPS_J n f * Q = bmDPS_J n f) :
    Q * ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f) = 1 ∧
      ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f) * Q = 1 ∧
      Matrix.transpose ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f) * bmDPS_J n f *
        ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f) = bmDPS_J n f := by
  have hleft : ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f) * Q = 1 := by
    calc ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f) * Q
        = (bmDPS_J n f)⁻¹ * (Matrix.transpose Q * bmDPS_J n f * Q) := by noncomm_ring
      _ = (bmDPS_J n f)⁻¹ * bmDPS_J n f := by rw [hQ]
      _ = 1 := Matrix.nonsing_inv_mul _ (bmDPS_J_isUnit_det n f)
  have hunit : IsUnit Q.det := by
    have h : Q.det * ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f).det = 1 := by
      have h1 := congrArg Matrix.det hleft
      rwa [Matrix.det_mul, Matrix.det_one, mul_comm] at h1
    exact IsUnit.of_mul_eq_one _ h
  have hright : Q * ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f) = 1 := by
    rw [← Matrix.inv_eq_left_inv hleft]
    exact Matrix.mul_nonsing_inv Q hunit
  have hQJinv : Q * (bmDPS_J n f)⁻¹ * Matrix.transpose Q = (bmDPS_J n f)⁻¹ := by
    calc Q * (bmDPS_J n f)⁻¹ * Matrix.transpose Q
        = Q * (bmDPS_J n f)⁻¹ * Matrix.transpose Q *
            (bmDPS_J n f * (bmDPS_J n f)⁻¹) := by
          rw [Matrix.mul_nonsing_inv _ (bmDPS_J_isUnit_det n f), Matrix.mul_one]
      _ = (Q * ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f)) * (bmDPS_J n f)⁻¹ := by
          noncomm_ring
      _ = 1 * (bmDPS_J n f)⁻¹ := by rw [hright]
      _ = (bmDPS_J n f)⁻¹ := by rw [Matrix.one_mul]
  have htP : Matrix.transpose ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f) =
      bmDPS_J n f * Q * (bmDPS_J n f)⁻¹ := by
    rw [show (bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f =
        ((bmDPS_J n f)⁻¹ * Matrix.transpose Q) * bmDPS_J n f from rfl,
      Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_nonsing_inv,
      Matrix.transpose_transpose, bmDPS_J_transpose]
    noncomm_ring
  refine ⟨hright, hleft, ?_⟩
  calc Matrix.transpose ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f) * bmDPS_J n f *
        ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f)
      = bmDPS_J n f * Q * (bmDPS_J n f)⁻¹ * bmDPS_J n f *
          ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f) := by rw [htP]
    _ = bmDPS_J n f * Q * ((bmDPS_J n f)⁻¹ * bmDPS_J n f) *
          ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f) := by noncomm_ring
    _ = bmDPS_J n f * Q * 1 * ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f) := by
          rw [Matrix.nonsing_inv_mul _ (bmDPS_J_isUnit_det n f)]
    _ = bmDPS_J n f * Q * ((bmDPS_J n f)⁻¹ * Matrix.transpose Q * bmDPS_J n f) := by
          rw [Matrix.mul_one]
    _ = bmDPS_J n f * (Q * (bmDPS_J n f)⁻¹ * Matrix.transpose Q) * bmDPS_J n f := by
          noncomm_ring
    _ = bmDPS_J n f * (bmDPS_J n f)⁻¹ * bmDPS_J n f := by rw [hQJinv]
    _ = bmDPS_J n f := by
          rw [Matrix.mul_nonsing_inv _ (bmDPS_J_isUnit_det n f), Matrix.one_mul]

private noncomputable def bmDPS_blockMat (n f r r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f) :=
  Matrix.fromBlocks (x : Matrix (Fin r) (Fin r) (GaloisField 2 f))
    (0 : Matrix (Fin r) (Fin r ⊕ Fin r') (GaloisField 2 f))
    (0 : Matrix (Fin r ⊕ Fin r') (Fin r) (GaloisField 2 f))
    (Matrix.fromBlocks
      (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
        Matrix (Fin r) (Fin r) (GaloisField 2 f)))
      (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))

private theorem bmDPS_conj_mul (n f : ℕ)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hPP : P * Pinv = 1)
    (v w : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    (Pinv * v * P) * (Pinv * w * P) = Pinv * (v * w) * P := by
  calc (Pinv * v * P) * (Pinv * w * P)
      = Pinv * v * (P * Pinv) * w * P := by noncomm_ring
    _ = Pinv * v * 1 * w * P := by rw [hPP]
    _ = Pinv * (v * w) * P := by noncomm_ring

private theorem bmDPS_conj_one (n f : ℕ)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1) :
    Pinv * 1 * P = 1 := by rw [Matrix.mul_one, hPinvP]

private theorem bmDPS_blockMat_one (n f r r' : ℕ)
      :
    bmDPS_blockMat n f r r' (1 : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) =
      1 := by
  unfold bmDPS_blockMat
  rw [inv_one, Matrix.SpecialLinearGroup.coe_one, Matrix.transpose_one,
    Matrix.fromBlocks_one, Matrix.fromBlocks_one]

private theorem bmDPS_blockMat_mul (n f r r' : ℕ)

    (x y : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmDPS_blockMat n f r r' (x * y) =
      bmDPS_blockMat n f r r' x * bmDPS_blockMat n f r r' y := by
  have hinner : (Matrix.fromBlocks
        (Matrix.transpose (((x⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f))))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) *
      (Matrix.fromBlocks
        (Matrix.transpose (((y⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f))))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) =
      Matrix.fromBlocks
        (Matrix.transpose ((((x * y)⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f))))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) := by
    rw [Matrix.fromBlocks_multiply]
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one]
    rw [show Matrix.transpose (((x * y)⁻¹ :
            Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)) =
        Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)) *
        Matrix.transpose ((y⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)) from by
      rw [show ((x * y)⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) =
            y⁻¹ * x⁻¹ from mul_inv_rev x y,
        Matrix.SpecialLinearGroup.coe_mul, Matrix.transpose_mul]]
  unfold bmDPS_blockMat
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [hinner, Matrix.SpecialLinearGroup.coe_mul]

private noncomputable def bmDPS_embedGL (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1) :
    Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f) →* GL (Fin n ⊕ Fin n) (GaloisField 2 f)
    where
  toFun x :=
    Units.mk (Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x) * P)
      (Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x⁻¹) * P)
      (by
        change (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
              (bmDPS_blockMat n f r r' x) * P) *
            (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
              (bmDPS_blockMat n f r r' x⁻¹) * P) = 1
        rw [bmDPS_conj_mul n f P Pinv hPP, ← map_mul, ← bmDPS_blockMat_mul,
          mul_inv_cancel x, bmDPS_blockMat_one, map_one,
          bmDPS_conj_one n f P Pinv hPinvP])
      (by
        change (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
              (bmDPS_blockMat n f r r' x⁻¹) * P) *
            (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
              (bmDPS_blockMat n f r r' x) * P) = 1
        rw [bmDPS_conj_mul n f P Pinv hPP, ← map_mul, ← bmDPS_blockMat_mul,
          inv_mul_cancel x, bmDPS_blockMat_one, map_one,
          bmDPS_conj_one n f P Pinv hPinvP])
  map_one' := by
    apply Units.ext
    change Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmDPS_blockMat n f r r' 1) * P = 1
    rw [bmDPS_blockMat_one, map_one, bmDPS_conj_one n f P Pinv hPinvP]
  map_mul' x y := by
    apply Units.ext
    change Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmDPS_blockMat n f r r' (x * y)) * P =
      (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmDPS_blockMat n f r r' x) * P) *
      (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmDPS_blockMat n f r r' y) * P)
    rw [bmDPS_blockMat_mul, map_mul, ← bmDPS_conj_mul n f P Pinv hPP]

private lemma bmDPS_embedGL_coe (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    ((bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP x : GL (Fin n ⊕ Fin n) (GaloisField 2 f)) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
      Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x) * P := by
  rfl

private def bmDPS_IsFormStandard (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n) : Prop :=
  (∀ y : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f),
    Matrix.transpose (Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' y)) *
      bmDPS_J n f * Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' y) =
        bmDPS_J n f) ∧
    (∀ a a' : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a) (Sum.inl a') = 0)
        ∧
    (∀ b b' : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr (Sum.inl b)) (Sum.inr
        (Sum.inl b')) = 0) ∧
    (∀ (a : Fin r) (c : Fin r'), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a)
        (Sum.inr (Sum.inr c)) = 0) ∧
    (∀ (c : Fin r') (a : Fin r), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr (Sum.inr
        c)) (Sum.inl a) = 0) ∧
    (∀ (b : Fin r) (c : Fin r'), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr (Sum.inl
        b)) (Sum.inr (Sum.inr c)) = 0) ∧
    (∀ (c : Fin r') (b : Fin r), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr (Sum.inr
        c)) (Sum.inr (Sum.inl b)) = 0) ∧
    (∀ a b : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a) (Sum.inr (Sum.inl
        b)) = if a = b then 1 else 0)

private theorem bmDPS_embedGL_mem_statedSp (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f r r' eidx)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP x ∈
      CFSG.Open.StatedSp n (GaloisField 2 f) := by
  rw [CFSG.Open.StatedAPI.mem_statedSp_iff]
  change Matrix.transpose (Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x) * P) *
      bmDPS_J n f * (Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x) * P) =
      bmDPS_J n f
  let R : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f) :=
    Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x)
  have hJR : Matrix.transpose R * bmDPS_J n f * R = bmDPS_J n f := hJ.1 x
  change Matrix.transpose (Pinv * R * P) * bmDPS_J n f * (Pinv * R * P) = bmDPS_J n f
  have hsinv := bmDPS_symplectic_inv n f P hP
  have hPinv_eq : Pinv = (bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f := by
    calc Pinv = Pinv * (P * ((bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f)) := by
          rw [hsinv.1, Matrix.mul_one]
      _ = (Pinv * P) * ((bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f) := by noncomm_ring
      _ = (bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f := by rw [hPinvP, Matrix.one_mul]
  have hPinv_symp : Matrix.transpose Pinv * bmDPS_J n f * Pinv = bmDPS_J n f := by
    rw [hPinv_eq]
    exact hsinv.2.2
  rw [Matrix.transpose_mul, Matrix.transpose_mul]
  calc Matrix.transpose P * (Matrix.transpose R * Matrix.transpose Pinv) * bmDPS_J n f *
        (Pinv * R * P)
      = Matrix.transpose P *
          (Matrix.transpose R * (Matrix.transpose Pinv * bmDPS_J n f * Pinv) * R) * P := by
          noncomm_ring
    _ = Matrix.transpose P * (Matrix.transpose R * bmDPS_J n f * R) * P := by rw [hPinv_symp]
    _ = Matrix.transpose P * bmDPS_J n f * P := by rw [hJR]
    _ = bmDPS_J n f := hP

private noncomputable def bmDPS_embedHom (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f r r' eidx) :
    Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f) →*
      ↥(CFSG.Open.StatedSp n (GaloisField 2 f)) where
  toFun x := ⟨bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP x,
    bmDPS_embedGL_mem_statedSp n f r r' eidx hPP hPinvP hP hJ x⟩
  map_one' := by
    apply Subtype.ext
    exact map_one (bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP)
  map_mul' x y := by
    apply Subtype.ext
    exact map_mul (bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP) x y

private theorem bmDPS_blockMat_injective (n f r r' : ℕ)
      :
    Function.Injective (bmDPS_blockMat n f r r') := by
  intro x y h
  apply Subtype.ext
  ext a b
  have h' := congrFun (congrFun h (Sum.inl a)) (Sum.inl b)
  simpa [bmDPS_blockMat, Matrix.fromBlocks] using h'

private theorem bmDPS_embedHom_injective (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f r r' eidx) :
    Function.Injective (bmDPS_embedHom n f r r' eidx P Pinv hPP hPinvP hP hJ) := by
  intro x y hxy
  have hgl : bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP x =
      bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP y := by
    have := congrArg (fun z : ↥(CFSG.Open.StatedSp n (GaloisField 2 f)) =>
      (z : GL (Fin n ⊕ Fin n) (GaloisField 2 f))) hxy
    exact this
  have hcoe : Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x) * P =
      Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' y) * P := by
    have := congrArg (fun z : GL (Fin n ⊕ Fin n) (GaloisField 2 f) =>
      (z : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))) hgl
    simpa only [bmDPS_embedGL_coe] using this
  have hcancel : ∀ A B : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f),
      Pinv * A * P = Pinv * B * P → A = B := by
    intro A B h
    have h1 : (P * Pinv) * A * (P * Pinv) = (P * Pinv) * B * (P * Pinv) := by
      calc (P * Pinv) * A * (P * Pinv) = P * (Pinv * A * P) * Pinv := by noncomm_ring
        _ = P * (Pinv * B * P) * Pinv := by rw [h]
        _ = (P * Pinv) * B * (P * Pinv) := by noncomm_ring
    simpa only [hPP, Matrix.one_mul, Matrix.mul_one] using h1
  have hblock : bmDPS_blockMat n f r r' x = bmDPS_blockMat n f r r' y :=
    (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx).injective (hcancel _ _ hcoe)
  exact bmDPS_blockMat_injective n f r r' hblock

private noncomputable abbrev bmDPS_D1 (r r' : ℕ) (F : Type) [Zero F] [One F] :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F :=
  Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
    (0 : Matrix (Fin r) (Fin r ⊕ Fin r') F)
    (0 : Matrix (Fin r ⊕ Fin r') (Fin r) F)
    (Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
      (0 : Matrix (Fin r) (Fin r') F) (0 : Matrix (Fin r') (Fin r) F)
      (1 : Matrix (Fin r') (Fin r') F))

private noncomputable abbrev bmDPS_D0s (r r' : ℕ) (F : Type) [Zero F] [One F] :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F :=
  Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
    (0 : Matrix (Fin r) (Fin r ⊕ Fin r') F)
    (0 : Matrix (Fin r ⊕ Fin r') (Fin r) F)
    (Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) F)
      (0 : Matrix (Fin r) (Fin r') F) (0 : Matrix (Fin r') (Fin r) F)
      (0 : Matrix (Fin r') (Fin r') F))

private theorem bmDPS_formAdj_conj (n f : ℕ)
    (P Pinv A : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f) (hPinvP : Pinv * P = 1) :
    formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) (Pinv * A * P) =
      Pinv * formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) A * P := by
  have hsinv := bmDPS_symplectic_inv n f P hP
  have hPinv_eq : Pinv = (bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f := by
    calc Pinv = Pinv * (P * ((bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f)) := by
          rw [hsinv.1, Matrix.mul_one]
      _ = (Pinv * P) * ((bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f) := by noncomm_ring
      _ = (bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f := by rw [hPinvP, Matrix.one_mul]
  have hPinv : Pinv = formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) P := by
    rw [hPinv_eq]
    rfl
  have hP' : P = formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) Pinv := by
    rw [hPinv]
    exact (Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl)
      (bmDPS_J_isUnit_det n f) (bmDPS_J_symmetric n f) P).symm
  have hfac : formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) (Pinv * A * P) =
      formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) P *
        formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) A *
        formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) Pinv := by
    rw [Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) (bmDPS_J_isUnit_det n f),
      Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) (bmDPS_J_isUnit_det n f)]
    noncomm_ring
  rw [hfac, ← hPinv, ← hP']

private theorem bmDPS_reindex_mul (f : ℕ) {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ] (e : ι ≃ κ) (A B : Matrix ι ι (GaloisField 2 f)) :
    Matrix.reindex e e (A * B) = Matrix.reindex e e A * Matrix.reindex e e B := by
  change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) (A * B) =
    (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) A *
      (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) B
  rw [map_mul]

private theorem bmDPS_reindex_one (f : ℕ) {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ] (e : ι ≃ κ) :
    Matrix.reindex e e (1 : Matrix ι ι (GaloisField 2 f)) = 1 := by
  change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e)
    (1 : Matrix ι ι (GaloisField 2 f)) = 1
  rw [map_one]

private theorem bmDPS_reindex_transpose (f : ℕ) {ι κ : Type*} (e : ι ≃ κ) (A : Matrix ι ι
    (GaloisField 2 f)) :
    Matrix.transpose (Matrix.reindex e e A) = Matrix.reindex e e (Matrix.transpose A) := by
  ext i j
  simp [Matrix.reindex_apply, Matrix.transpose_apply]

private theorem bmDPS_reindex_comp_symm (f : ℕ) {ι κ : Type*} (e : ι ≃ κ) (A : Matrix ι ι
    (GaloisField 2 f)) :
    Matrix.reindex e.symm e.symm (Matrix.reindex e e A) = A := by
  ext i j
  simp [Matrix.reindex_apply]

private theorem bmDPS_reindex_smul (f : ℕ) {ι κ : Type*} (e : ι ≃ κ) (c : GaloisField 2 f)
    (A : Matrix ι ι (GaloisField 2 f)) :
    Matrix.reindex e e (c • A) = c • Matrix.reindex e e A := by
  ext i j
  simp [Matrix.reindex_apply]

private theorem bmDPS_formAdj_reindex (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n) :
    formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f)
        (Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f))) =
      Matrix.reindex eidx eidx
        (formAdj (RingHom.id (GaloisField 2 f))
          (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))
          (bmDPS_D0 r r' (GaloisField 2 f))) := by
  set J' : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r'))
      (GaloisField 2 f) := Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) with hJ'def
  have hJ' : Matrix.reindex eidx eidx J' = bmDPS_J n f :=
    bmDPS_reindex_comp_symm f eidx.symm (bmDPS_J n f)
  have hJ'2 : J' * J' = 1 := by
    change Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) *
        Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) = 1
    rw [← bmDPS_reindex_mul f eidx.symm (bmDPS_J n f) (bmDPS_J n f), bmDPS_J_mul_self,
      bmDPS_reindex_one f eidx.symm]
  have hJ'ein : J'⁻¹ = J' := Matrix.inv_eq_right_inv hJ'2
  have hreJ'2 : Matrix.reindex eidx eidx J' * Matrix.reindex eidx eidx J' = 1 := by
    rw [← bmDPS_reindex_mul f eidx J' J', hJ'2, bmDPS_reindex_one f eidx]
  have hreJ'ein : (Matrix.reindex eidx eidx J')⁻¹ = Matrix.reindex eidx eidx J' :=
    Matrix.inv_eq_right_inv hreJ'2
  have hJe : (bmDPS_J n f)⁻¹ = Matrix.reindex eidx eidx (J'⁻¹) := by
    rw [← hJ', hreJ'ein, hJ'ein]
  simp only [formAdj,
    show (⇑(RingHom.id (GaloisField 2 f)) : GaloisField 2 f → GaloisField 2 f) = id from rfl,
    Matrix.map_id]
  rw [bmDPS_reindex_transpose f eidx (bmDPS_D0 r r' (GaloisField 2 f)), hJe,
    show (bmDPS_J n f) = Matrix.reindex eidx eidx J' from hJ'.symm]
  rw [← bmDPS_reindex_mul f eidx (J'⁻¹) (Matrix.transpose (bmDPS_D0 r r' (GaloisField 2 f))),
    ← bmDPS_reindex_mul f eidx (J'⁻¹ * Matrix.transpose (bmDPS_D0 r r' (GaloisField 2 f))) J']

private theorem bmDPS_D0_transpose (r r' : ℕ) (F : Type) [Zero F] [One F] :
    Matrix.transpose (bmDPS_D0 r r' F) = bmDPS_D0 r r' F := by
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
    simp [bmDPS_D0, Matrix.fromBlocks, Matrix.one_apply, eq_comm]

private theorem bmDPS_J'_sq (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n) :
    Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) *
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) = 1 := by
  rw [← bmDPS_reindex_mul f eidx.symm (bmDPS_J n f) (bmDPS_J n f), bmDPS_J_mul_self,
    bmDPS_reindex_one f eidx.symm]

private theorem bmDPS_J'_first_row_zero (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f r r' eidx) :
    (∀ a a' : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a) (Sum.inl a') = 0)
        ∧
      (∀ (a : Fin r) (c : Fin r'), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a)
          (Sum.inr (Sum.inr c)) = 0) := by
  exact ⟨hJ.2.1, hJ.2.2.2.1⟩

private theorem bmDPS_J'_second_col_zero (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f r r' eidx) :
    (∀ b b' : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr (Sum.inl b)) (Sum.inr
        (Sum.inl b')) = 0) ∧
      (∀ (c : Fin r') (b' : Fin r), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr
          (Sum.inr c)) (Sum.inr (Sum.inl b')) = 0) := by
  exact ⟨hJ.2.2.1, hJ.2.2.2.2.2.2.1⟩

private theorem bmDPS_D0_mul_inl (r r' : ℕ) {F : Type} [Semiring F]
    (M : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F) (a : Fin r) (j : Fin r ⊕
        (Fin r ⊕ Fin r')) :
    (bmDPS_D0 r r' F * M) (Sum.inl a) j = M (Sum.inl a) j := by
  rw [Matrix.mul_apply, Finset.sum_eq_single (Sum.inl a)]
  · simp [bmDPS_D0, Matrix.fromBlocks]
  · intro k _ hk
    rcases k with a' | (b' | c')
    · have hne : a ≠ a' := fun h => hk (by rw [← h])
      simp [bmDPS_D0, Matrix.fromBlocks, Matrix.one_apply, hne]
    · simp_all [bmDPS_D0, Matrix.fromBlocks]
    · simp_all [bmDPS_D0, Matrix.fromBlocks]
  · intro h; exact absurd (Finset.mem_univ _) h

private theorem bmDPS_D0_mul_inr (r r' : ℕ) {F : Type} [Semiring F]
    (M : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F) (i : Fin r ⊕ (Fin r ⊕ Fin
        r'))
    (hi : ¬ ∃ a : Fin r, i = Sum.inl a) (j : Fin r ⊕ (Fin r ⊕ Fin r')) :
    (bmDPS_D0 r r' F * M) i j = 0 := by
  rw [Matrix.mul_apply, Finset.sum_eq_zero]
  intro k _
  rcases i with a | (b | c)
  · exact absurd ⟨a, rfl⟩ hi
  · rcases k with a' | (b' | c') <;> simp [bmDPS_D0, Matrix.fromBlocks]
  · rcases k with a' | (b' | c') <;> simp [bmDPS_D0, Matrix.fromBlocks]

private theorem bmDPS_mul_D0s_inr (r r' : ℕ) {F : Type} [Semiring F]
    (M : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F) (i : Fin r ⊕ (Fin r ⊕ Fin
        r')) (b : Fin r) :
    (M * bmDPS_D0s r r' F) i (Sum.inr (Sum.inl b)) = M i (Sum.inr (Sum.inl b)) := by
  rw [Matrix.mul_apply, Finset.sum_eq_single (Sum.inr (Sum.inl b))]
  · simp [bmDPS_D0s, Matrix.fromBlocks]
  · intro k _ hk
    rcases k with a' | (b' | c') <;> simp_all [bmDPS_D0s, Matrix.fromBlocks]
  · intro h; exact absurd (Finset.mem_univ _) h

private theorem bmDPS_mul_D0s_other (r r' : ℕ) {F : Type} [Semiring F]
    (M : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F) (i : Fin r ⊕ (Fin r ⊕ Fin
        r')) (j : Fin r ⊕ (Fin r ⊕ Fin r'))
    (hj : ¬ ∃ b : Fin r, j = Sum.inr (Sum.inl b)) :
    (M * bmDPS_D0s r r' F) i j = 0 := by
  rw [Matrix.mul_apply, Finset.sum_eq_zero]
  intro k _
  rcases j with a' | (b' | c')
  · rcases k with a'' | (b'' | c'') <;> simp [bmDPS_D0s, Matrix.fromBlocks]
  · exact absurd ⟨b', rfl⟩ hj
  · rcases k with a'' | (b'' | c'') <;> simp [bmDPS_D0s, Matrix.fromBlocks]

private theorem bmDPS_J'_D0_mul (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f r r' eidx) :
    bmDPS_D0 r r' (GaloisField 2 f) * Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) =
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) * bmDPS_D0s r r' (GaloisField 2 f) := by
  obtain ⟨h11, h13⟩ := bmDPS_J'_first_row_zero n f r r' eidx hJ
  obtain ⟨h22, h32⟩ := bmDPS_J'_second_col_zero n f r r' eidx hJ
  ext i j
  by_cases hi : ∃ a : Fin r, i = Sum.inl a
  · obtain ⟨a, rfl⟩ := hi
    rw [bmDPS_D0_mul_inl]
    by_cases hj : ∃ b : Fin r, j = Sum.inr (Sum.inl b)
    · obtain ⟨b, rfl⟩ := hj
      rw [bmDPS_mul_D0s_inr]
    · rw [bmDPS_mul_D0s_other _ _ _ _ _ hj]
      rcases j with a' | (b' | c')
      · exact h11 a a'
      · exact absurd ⟨b', rfl⟩ hj
      · exact h13 a c'
  · rw [bmDPS_D0_mul_inr _ _ _ _ hi]
    by_cases hj : ∃ b : Fin r, j = Sum.inr (Sum.inl b)
    · obtain ⟨b, rfl⟩ := hj
      rw [bmDPS_mul_D0s_inr]
      rcases i with a | (b' | c')
      · exact absurd ⟨a, rfl⟩ hi
      · exact (h22 b' b).symm
      · exact (h32 c' b).symm
    · rw [bmDPS_mul_D0s_other _ _ _ _ _ hj]

private theorem bmDPS_J'_adj_D0 (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f r r' eidx) :
    (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))⁻¹ *
        bmDPS_D0 r r' (GaloisField 2 f) *
        Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) =
      bmDPS_D0s r r' (GaloisField 2 f) := by
  have h2 := bmDPS_J'_sq n f r r' eidx
  have hinv : (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))⁻¹ =
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) := Matrix.inv_eq_right_inv h2
  calc (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))⁻¹ *
        bmDPS_D0 r r' (GaloisField 2 f) * Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)
      = (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))⁻¹ *
          (bmDPS_D0 r r' (GaloisField 2 f) *
            Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) := by noncomm_ring
    _ = (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))⁻¹ *
          (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) *
            bmDPS_D0s r r' (GaloisField 2 f)) := by
          rw [bmDPS_J'_D0_mul n f r r' eidx hJ]
    _ = bmDPS_D0s r r' (GaloisField 2 f) := by
          rw [← Matrix.mul_assoc, hinv, h2, Matrix.one_mul]

private theorem bmDPS_formAdj_D0 (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f r r' eidx) :
    formAdj (RingHom.id (GaloisField 2 f))
        (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))
        (bmDPS_D0 r r' (GaloisField 2 f)) =
      bmDPS_D0s r r' (GaloisField 2 f) := by
  simp only [formAdj,
    show (⇑(RingHom.id (GaloisField 2 f)) : GaloisField 2 f → GaloisField 2 f) = id from rfl,
    Matrix.map_id, bmDPS_D0_transpose r r' (GaloisField 2 f)]
  exact bmDPS_J'_adj_D0 n f r r' eidx hJ

private theorem bmDPS_estar_conj
    (n f : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    {r r' : ℕ} (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)} (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f r r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) * P = e) :
    bmDPS_estar n f e =
      Pinv * Matrix.reindex eidx eidx (bmDPS_D0s r r' (GaloisField 2 f)) * P := by
  have htrans := bmDPS_formAdj_conj n f P Pinv
    (Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f))) hP hPinvP
  have hre := bmDPS_formAdj_reindex n f r r' eidx
  have hD0 := bmDPS_formAdj_D0 n f r r' eidx hJ
  rw [show bmDPS_estar n f e =
      formAdj (RingHom.id (GaloisField 2 f)) (bmDPS_J n f) e from rfl, ← hconv, htrans, hre, hD0]

private theorem bmDPS_eps_conj
    (n f : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    {r r' : ℕ} (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)} (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f r r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) * P = e) :
    1 - bmDPS_eps n f e =
      Pinv * Matrix.reindex eidx eidx (bmDPS_D1 r r' (GaloisField 2 f)) * P := by
  have hest := bmDPS_estar_conj n f eidx hPinvP hP hJ hconv
  have hD : (1 : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f)) -
      bmDPS_D0 r r' (GaloisField 2 f) -
        bmDPS_D0s r r' (GaloisField 2 f) = bmDPS_D1 r r' (GaloisField 2 f) := by
    ext i j
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
      simp [bmDPS_D0, bmDPS_D0s, bmDPS_D1, Matrix.fromBlocks, Matrix.one_apply]
  have h1 : (1 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) = Pinv * Matrix.reindex
      eidx eidx (1 : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f))
          * P := by
    change (1 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) = Pinv *
        (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx) (1 : Matrix (Fin r ⊕ (Fin
            r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f)) * P
    rw [map_one, Matrix.mul_one, hPinvP]
  calc 1 - bmDPS_eps n f e
      = 1 - (e + bmDPS_estar n f e) := rfl
    _ = 1 - e - bmDPS_estar n f e := by abel
    _ = Pinv * Matrix.reindex eidx eidx (1 : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin
        r')) (GaloisField 2 f)) * P -
        Pinv * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) * P -
        Pinv * Matrix.reindex eidx eidx (bmDPS_D0s r r' (GaloisField 2 f)) * P := by
          rw [h1, ← hest, ← hconv]
    _ = Pinv * (Matrix.reindex eidx eidx (1 : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕
        Fin r')) (GaloisField 2 f)) -
        Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) -
        Matrix.reindex eidx eidx (bmDPS_D0s r r' (GaloisField 2 f))) * P := by
          noncomm_ring
    _ = Pinv * Matrix.reindex eidx eidx ((1 : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕
        Fin r')) (GaloisField 2 f)) -
        bmDPS_D0 r r' (GaloisField 2 f) - bmDPS_D0s r r' (GaloisField 2 f)) * P := by
          change Pinv * ((Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx) (1 :
              Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f)) -
                  (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx) (bmDPS_D0 r r'
                      (GaloisField 2 f)) -
              (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx) (bmDPS_D0s r r'
                  (GaloisField 2 f))) * P =
            Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx) ((1 : Matrix
                (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f)) - bmDPS_D0
                    r r' (GaloisField 2 f) -
              bmDPS_D0s r r' (GaloisField 2 f)) * P
          rw [← map_sub, ← map_sub]
    _ = Pinv * Matrix.reindex eidx eidx (bmDPS_D1 r r' (GaloisField 2 f)) * P := by rw [hD]

private theorem bmDPS_blockMat_mul_D1 (n f r r' : ℕ)

    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmDPS_blockMat n f r r' x * bmDPS_D1 r r' (GaloisField 2 f) = bmDPS_D1 r r' (GaloisField 2
        f) := by
  unfold bmDPS_blockMat bmDPS_D1
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one]

private theorem bmDPS_embedGL_fixes_compl
    (n f : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    {r r' : ℕ} (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f r r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) * P = e)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    ((bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP x : GL (Fin n ⊕ Fin n) (GaloisField 2 f)) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * (1 - bmDPS_eps n f e) = 1 -
            bmDPS_eps n f e := by
  rw [bmDPS_eps_conj n f
      eidx hPinvP hP hJ hconv]
  change (Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x) * P) *
      (Pinv * Matrix.reindex eidx eidx (bmDPS_D1 r r' (GaloisField 2 f)) * P) =
      Pinv * Matrix.reindex eidx eidx (bmDPS_D1 r r' (GaloisField 2 f)) * P
  rw [bmDPS_conj_mul n f P Pinv hPP]
  rw [show Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x) *
        Matrix.reindex eidx eidx (bmDPS_D1 r r' (GaloisField 2 f)) =
      Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x * bmDPS_D1 r r' (GaloisField 2 f))
          from by
    change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
          (bmDPS_blockMat n f r r' x) *
        (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
          (bmDPS_D1 r r' (GaloisField 2 f)) =
        (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
          (bmDPS_blockMat n f r r' x * bmDPS_D1 r r' (GaloisField 2 f))
    rw [map_mul]]
  rw [bmDPS_blockMat_mul_D1 n f r r' x]

private theorem bmDPS_conj_mul' (n f : ℕ)
    (P Pinv v w : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1) :
    (P * v * Pinv) * (P * w * Pinv) = P * (v * w) * Pinv := by
  calc (P * v * Pinv) * (P * w * Pinv)
      = P * v * (Pinv * P) * w * Pinv := by noncomm_ring
    _ = P * (v * w) * Pinv := by rw [hPinvP, Matrix.mul_one]; noncomm_ring

private theorem bmDPS_D0_add_D0s_add_D1 (r r' : ℕ) (F : Type) [Semiring F] :
    bmDPS_D0 r r' F + bmDPS_D0s r r' F + bmDPS_D1 r r' F = 1 := by
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
    simp [bmDPS_D0, bmDPS_D0s, bmDPS_D1, Matrix.fromBlocks, Matrix.add_apply,
      Matrix.one_apply]

private theorem bmDPS_D0_comm_blockMat (n f r r' : ℕ)

    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmDPS_D0 r r' (GaloisField 2 f) * bmDPS_blockMat n f r r' x =
      bmDPS_blockMat n f r r' x * bmDPS_D0 r r' (GaloisField 2 f) := by
  unfold bmDPS_D0 bmDPS_blockMat
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp

private theorem bmDPS_D0s_comm_blockMat (n f r r' : ℕ)

    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmDPS_D0s r r' (GaloisField 2 f) * bmDPS_blockMat n f r r' x =
      bmDPS_blockMat n f r r' x * bmDPS_D0s r r' (GaloisField 2 f) := by
  unfold bmDPS_D0s bmDPS_blockMat
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp

private theorem bmDPS_D1_mul_blockMat (n f r r' : ℕ)

    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmDPS_D1 r r' (GaloisField 2 f) * bmDPS_blockMat n f r r' x =
      bmDPS_D1 r r' (GaloisField 2 f) := by
  unfold bmDPS_D1 bmDPS_blockMat
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one,
    Matrix.one_mul]

private theorem bmDPS_embedGL_centralizes
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e))
    (hgen : bmDPS_scalarAction n f S e)
    {r r' : ℕ} (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f r r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) * P = e)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f))
    (s : GL (Fin n ⊕ Fin n) (GaloisField 2 f)) (hs : s ∈ S) :
    (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * ((bmDPS_embedGL n f r r' eidx P
        Pinv hPP hPinvP x : GL (Fin n ⊕ Fin n) (GaloisField 2 f)) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕
            Fin n) (GaloisField 2 f)) = ((bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP x : GL (Fin
                n ⊕ Fin n) (GaloisField 2 f)) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField
                    2 f)) * (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) := by
  obtain ⟨c, hcne, hce, hce'⟩ := hgen s hs
  let sM : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f) :=
    (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
  change sM * ((bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP x :
      GL (Fin n ⊕ Fin n) (GaloisField 2 f)) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
    ((bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP x :
      GL (Fin n ⊕ Fin n) (GaloisField 2 f)) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * sM
  have hceM : sM * e = c • e := hce
  have hceM' : sM * bmDPS_estar n f e = c⁻¹ • bmDPS_estar n f e := hce'
  have hsA : sM ∈ bmDPS_A n f S :=
    Algebra.subset_adjoin (Set.mem_image_of_mem Units.val hs)
  have hse : sM * e = e * sM := (bmDPS_adjoin_comm hS sM hsA e he.1).eq
  have hse' : sM * bmDPS_estar n f e = bmDPS_estar n f e * sM :=
    (bmDPS_adjoin_comm hS sM hsA (bmDPS_estar n f e) hestar.1).eq
  let T : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f) :=
    Matrix.reindex eidx.symm eidx.symm (P * sM * Pinv)
  have hT_eq : Matrix.reindex eidx eidx T = P * sM * Pinv :=
    bmDPS_reindex_comp_symm f eidx.symm (P * sM * Pinv)
  have hs_eq : sM = Pinv * Matrix.reindex eidx eidx T * P := by
    rw [hT_eq]
    calc sM = (Pinv * P) * sM * (Pinv * P) := by rw [hPinvP]; simp
      _ = Pinv * (P * sM * Pinv) * P := by noncomm_ring
  have hD0' : Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) = P * e * Pinv := by
    calc Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f))
        = (P * Pinv) * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) *
            (P * Pinv) := by rw [hPP]; simp
      _ = P * (Pinv * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) * P) * Pinv := by
          noncomm_ring
      _ = P * e * Pinv := by rw [hconv]
  have hD0s' : Matrix.reindex eidx eidx (bmDPS_D0s r r' (GaloisField 2 f)) =
      P * bmDPS_estar n f e * Pinv := by
    have hest := bmDPS_estar_conj n f eidx hPinvP hP hJ hconv
    calc Matrix.reindex eidx eidx (bmDPS_D0s r r' (GaloisField 2 f))
        = (P * Pinv) * Matrix.reindex eidx eidx (bmDPS_D0s r r' (GaloisField 2 f)) *
            (P * Pinv) := by rw [hPP]; simp
      _ = P * (Pinv * Matrix.reindex eidx eidx (bmDPS_D0s r r' (GaloisField 2 f)) * P) * Pinv := by
          noncomm_ring
      _ = P * bmDPS_estar n f e * Pinv := by rw [← hest]
  have hT_D0 : T * bmDPS_D0 r r' (GaloisField 2 f) = c • bmDPS_D0 r r' (GaloisField 2 f) := by
    have hkey : Matrix.reindex eidx eidx (T * bmDPS_D0 r r' (GaloisField 2 f)) =
        c • Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) := by
      rw [bmDPS_reindex_mul f eidx T (bmDPS_D0 r r' (GaloisField 2 f)), hT_eq, hD0']
      calc (P * sM * Pinv) * (P * e * Pinv) = P * (sM * e) * Pinv :=
            bmDPS_conj_mul' n f P Pinv sM e hPinvP
        _ = P * (c • e) * Pinv := by rw [hceM]
        _ = c • (P * e * Pinv) := by rw [Matrix.mul_smul, Matrix.smul_mul]
    have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hkey
    rw [bmDPS_reindex_smul f eidx.symm c (Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2
        f))),
      bmDPS_reindex_comp_symm f eidx (T * bmDPS_D0 r r' (GaloisField 2 f)),
      bmDPS_reindex_comp_symm f eidx (bmDPS_D0 r r' (GaloisField 2 f))] at h
    exact h
  have hD0_T : bmDPS_D0 r r' (GaloisField 2 f) * T = c • bmDPS_D0 r r' (GaloisField 2 f) := by
    have hkey : Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f) * T) =
        c • Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) := by
      rw [bmDPS_reindex_mul f eidx (bmDPS_D0 r r' (GaloisField 2 f)) T, hT_eq, hD0']
      calc (P * e * Pinv) * (P * sM * Pinv) = P * (e * sM) * Pinv :=
            bmDPS_conj_mul' n f P Pinv e sM hPinvP
        _ = P * (sM * e) * Pinv := by rw [← hse]
        _ = P * (c • e) * Pinv := by rw [hceM]
        _ = c • (P * e * Pinv) := by rw [Matrix.mul_smul, Matrix.smul_mul]
    have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hkey
    rw [bmDPS_reindex_smul f eidx.symm c (Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2
        f))),
      bmDPS_reindex_comp_symm f eidx (bmDPS_D0 r r' (GaloisField 2 f) * T),
      bmDPS_reindex_comp_symm f eidx (bmDPS_D0 r r' (GaloisField 2 f))] at h
    exact h
  have hT_D0s : T * bmDPS_D0s r r' (GaloisField 2 f) = c⁻¹ • bmDPS_D0s r r' (GaloisField 2 f) := by
    have hkey : Matrix.reindex eidx eidx (T * bmDPS_D0s r r' (GaloisField 2 f)) =
        c⁻¹ • Matrix.reindex eidx eidx (bmDPS_D0s r r' (GaloisField 2 f)) := by
      rw [bmDPS_reindex_mul f eidx T (bmDPS_D0s r r' (GaloisField 2 f)), hT_eq, hD0s']
      calc (P * sM * Pinv) * (P * bmDPS_estar n f e * Pinv) =
            P * (sM * bmDPS_estar n f e) * Pinv :=
            bmDPS_conj_mul' n f P Pinv sM (bmDPS_estar n f e) hPinvP
        _ = P * (c⁻¹ • bmDPS_estar n f e) * Pinv := by rw [hceM']
        _ = c⁻¹ • (P * bmDPS_estar n f e * Pinv) := by rw [Matrix.mul_smul, Matrix.smul_mul]
    have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hkey
    rw [bmDPS_reindex_smul f eidx.symm (c⁻¹) (Matrix.reindex eidx eidx (bmDPS_D0s r r' (GaloisField
        2 f))),
      bmDPS_reindex_comp_symm f eidx (T * bmDPS_D0s r r' (GaloisField 2 f)),
      bmDPS_reindex_comp_symm f eidx (bmDPS_D0s r r' (GaloisField 2 f))] at h
    exact h
  have hD0s_T : bmDPS_D0s r r' (GaloisField 2 f) * T = c⁻¹ • bmDPS_D0s r r' (GaloisField 2 f) := by
    have hkey : Matrix.reindex eidx eidx (bmDPS_D0s r r' (GaloisField 2 f) * T) =
        c⁻¹ • Matrix.reindex eidx eidx (bmDPS_D0s r r' (GaloisField 2 f)) := by
      rw [bmDPS_reindex_mul f eidx (bmDPS_D0s r r' (GaloisField 2 f)) T, hT_eq, hD0s']
      calc (P * bmDPS_estar n f e * Pinv) * (P * sM * Pinv) =
            P * (bmDPS_estar n f e * sM) * Pinv :=
            bmDPS_conj_mul' n f P Pinv (bmDPS_estar n f e) sM hPinvP
        _ = P * (sM * bmDPS_estar n f e) * Pinv := by rw [← hse']
        _ = P * (c⁻¹ • bmDPS_estar n f e) * Pinv := by rw [hceM']
        _ = c⁻¹ • (P * bmDPS_estar n f e * Pinv) := by rw [Matrix.mul_smul, Matrix.smul_mul]
    have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hkey
    rw [bmDPS_reindex_smul f eidx.symm (c⁻¹) (Matrix.reindex eidx eidx (bmDPS_D0s r r' (GaloisField
        2 f))),
      bmDPS_reindex_comp_symm f eidx (bmDPS_D0s r r' (GaloisField 2 f) * T),
      bmDPS_reindex_comp_symm f eidx (bmDPS_D0s r r' (GaloisField 2 f))] at h
    exact h
  have hsum := bmDPS_D0_add_D0s_add_D1 r r' (GaloisField 2 f)
  have hD0_comm : bmDPS_D0 r r' (GaloisField 2 f) * bmDPS_blockMat n f r r' x =
      bmDPS_blockMat n f r r' x * bmDPS_D0 r r' (GaloisField 2 f) :=
    bmDPS_D0_comm_blockMat n f r r' x
  have hD0s_comm : bmDPS_D0s r r' (GaloisField 2 f) * bmDPS_blockMat n f r r' x =
      bmDPS_blockMat n f r r' x * bmDPS_D0s r r' (GaloisField 2 f) :=
    bmDPS_D0s_comm_blockMat n f r r' x
  have hD1_mul_B : bmDPS_D1 r r' (GaloisField 2 f) * bmDPS_blockMat n f r r' x =
      bmDPS_D1 r r' (GaloisField 2 f) := bmDPS_D1_mul_blockMat n f r r' x
  have hB_mul_D1 : bmDPS_blockMat n f r r' x * bmDPS_D1 r r' (GaloisField 2 f) =
      bmDPS_D1 r r' (GaloisField 2 f) := bmDPS_blockMat_mul_D1 n f r r' x
  have hT_decomp : T = c • bmDPS_D0 r r' (GaloisField 2 f) +
      c⁻¹ • bmDPS_D0s r r' (GaloisField 2 f) + T * bmDPS_D1 r r' (GaloisField 2 f) := by
    calc T = T * 1 := (Matrix.mul_one T).symm
      _ = T * (bmDPS_D0 r r' (GaloisField 2 f) + bmDPS_D0s r r' (GaloisField 2 f) +
            bmDPS_D1 r r' (GaloisField 2 f)) := by rw [hsum]
      _ = T * bmDPS_D0 r r' (GaloisField 2 f) + T * bmDPS_D0s r r' (GaloisField 2 f) +
            T * bmDPS_D1 r r' (GaloisField 2 f) := by rw [Matrix.mul_add, Matrix.mul_add]
      _ = c • bmDPS_D0 r r' (GaloisField 2 f) + c⁻¹ • bmDPS_D0s r r' (GaloisField 2 f) +
            T * bmDPS_D1 r r' (GaloisField 2 f) := by rw [hT_D0, hT_D0s]
  have hD1_eq : bmDPS_D1 r r' (GaloisField 2 f) =
      1 - bmDPS_D0 r r' (GaloisField 2 f) - bmDPS_D0s r r' (GaloisField 2 f) := by
    rw [← hsum]; abel
  have hT_D1_comm : T * bmDPS_D1 r r' (GaloisField 2 f) =
      bmDPS_D1 r r' (GaloisField 2 f) * T := by
    have h1 : T * bmDPS_D1 r r' (GaloisField 2 f) =
        T - c • bmDPS_D0 r r' (GaloisField 2 f) - c⁻¹ • bmDPS_D0s r r' (GaloisField 2 f) := by
      rw [hD1_eq, Matrix.mul_sub, Matrix.mul_sub, Matrix.mul_one, hT_D0, hT_D0s]
    have h2 : bmDPS_D1 r r' (GaloisField 2 f) * T =
        T - c • bmDPS_D0 r r' (GaloisField 2 f) - c⁻¹ • bmDPS_D0s r r' (GaloisField 2 f) := by
      rw [hD1_eq, Matrix.sub_mul, Matrix.sub_mul, Matrix.one_mul, hD0_T, hD0s_T]
    rw [h1, h2]
  have hThird : (T * bmDPS_D1 r r' (GaloisField 2 f)) * bmDPS_blockMat n f r r' x =
      bmDPS_blockMat n f r r' x * (T * bmDPS_D1 r r' (GaloisField 2 f)) := by
    rw [Matrix.mul_assoc, hD1_mul_B, hT_D1_comm, ← Matrix.mul_assoc, hB_mul_D1]
  have hTB : T * bmDPS_blockMat n f r r' x =
      bmDPS_blockMat n f r r' x * T := by
    rw [hT_decomp]
    rw [Matrix.add_mul, Matrix.add_mul, Matrix.smul_mul, Matrix.smul_mul,
      Matrix.mul_add, Matrix.mul_add, Matrix.mul_smul, Matrix.mul_smul,
      hD0_comm, hD0s_comm, hThird]
  have hfin : sM * ((bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP x :
      GL (Fin n ⊕ Fin n) (GaloisField 2 f)) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
      Pinv * Matrix.reindex eidx eidx (T * bmDPS_blockMat n f r r' x) * P := by
    rw [hs_eq, bmDPS_embedGL_coe]
    rw [bmDPS_conj_mul n f P Pinv hPP,
      ← bmDPS_reindex_mul f eidx T (bmDPS_blockMat n f r r' x)]
  have hfin' : ((bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP x :
      GL (Fin n ⊕ Fin n) (GaloisField 2 f)) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * sM =
      Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x * T) * P := by
    rw [hs_eq, bmDPS_embedGL_coe]
    rw [bmDPS_conj_mul n f P Pinv hPP,
      ← bmDPS_reindex_mul f eidx (bmDPS_blockMat n f r r' x) T]
  rw [hfin, hfin', hTB]

private theorem bmDPS_embedHom_range_le_centralizer
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e))
    (hgen : bmDPS_scalarAction n f S e)
    {r r' : ℕ} (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f r r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) * P = e) :
    (bmDPS_embedHom n f r r' eidx P Pinv hPP hPinvP hP hJ).range ≤
      glBlockCentralizer ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) S
        (bmDPS_eps n f e) := by
  rintro y ⟨x, rfl⟩
  rw [glBlockCentralizer, Subgroup.mem_comap, Subgroup.mem_inf]
  constructor
  · rw [Subgroup.mem_centralizer_iff]
    intro s hs
    apply Units.ext
    exact bmDPS_embedGL_centralizes n f S hS he
        hestar hgen eidx hPP hPinvP hP hJ hconv x s hs
  · exact bmDPS_embedGL_fixes_compl n f eidx hPP hPinvP hP hJ hconv x

private theorem bmDPS_embedHom_range_commutator_self
    (n f : ℕ)
    {r r' : ℕ} (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f r r' eidx)
    (hperfSL : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f))) :
    ⁅(bmDPS_embedHom n f r r' eidx P Pinv hPP hPinvP hP hJ).range, (bmDPS_embedHom n f r r' eidx P
        Pinv hPP hPinvP hP hJ).range⁆ = (bmDPS_embedHom n f r r' eidx P Pinv hPP hPinvP hP hJ).range
            := by
  haveI : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) := hperfSL
  have hperfRange : Group.IsPerfect (bmDPS_embedHom n f r r' eidx P Pinv hPP hPinvP hP hJ).range :=
    Group.IsPerfect.ofSurjective
      (f := (bmDPS_embedHom n f r r' eidx P Pinv hPP hPinvP hP hJ).rangeRestrict)
      (bmDPS_embedHom n f r r' eidx P Pinv hPP hPinvP hP hJ).rangeRestrict_surjective
  haveI : Group.IsPerfect (bmDPS_embedHom n f r r' eidx P Pinv hPP hPinvP hP hJ).range := hperfRange
  exact Subgroup.commutator_eq_self

private theorem bmDPS_embedHom_range_le
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e))
    (hgen : bmDPS_scalarAction n f S e)
    {r r' : ℕ} (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f r r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) * P = e)
    (hperfSL : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f))) :
    (bmDPS_embedHom n f r r' eidx P Pinv hPP hPinvP hP hJ).range ≤ bmDPS_range n f S e := by
  have hle := bmDPS_embedHom_range_le_centralizer n f S hS he hestar hgen eidx hPP hPinvP hP hJ
      hconv
  have hperf := bmDPS_embedHom_range_commutator_self n f eidx hPP hPinvP hP hJ hperfSL
  calc (bmDPS_embedHom n f r r' eidx P Pinv hPP hPinvP hP hJ).range
      = ⁅(bmDPS_embedHom n f r r' eidx P Pinv hPP hPinvP hP hJ).range, (bmDPS_embedHom n f r r' eidx
          P Pinv hPP hPinvP hP hJ).range⁆ := hperf.symm
    _ ≤ ⁅glBlockCentralizer ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) S (bmDPS_eps n f e),
          glBlockCentralizer ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) S
            (bmDPS_eps n f e)⁆ := Subgroup.commutator_mono hle hle
    _ = bmDPS_range n f S e := rfl

private theorem bmDPS_D0_eq (r r' : ℕ) (F : Type) [Zero F] [One F] :
    bmDPS_D0 r r' F = Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) F)
      (0 : Matrix (Fin r) (Fin r ⊕ Fin r') F)
      (0 : Matrix (Fin r ⊕ Fin r') (Fin r) F)
      (0 : Matrix (Fin r ⊕ Fin r') (Fin r ⊕ Fin r') F) := by
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
    simp [bmDPS_D0, Matrix.fromBlocks, Matrix.one_apply]

private theorem bmDPS_D1_eq (r r' : ℕ) (F : Type) [Zero F] [One F] :
    bmDPS_D1 r r' F = Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
      (0 : Matrix (Fin r) (Fin r ⊕ Fin r') F)
      (0 : Matrix (Fin r ⊕ Fin r') (Fin r) F)
      (Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
        (0 : Matrix (Fin r) (Fin r') F) (0 : Matrix (Fin r') (Fin r) F)
        (1 : Matrix (Fin r') (Fin r') F)) := by
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
    simp [bmDPS_D1, Matrix.fromBlocks, Matrix.one_apply]

private theorem bmDPS_block_diag_outer (r r' : ℕ) {F : Type} [Field F]
    {A : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F}
    (h : A * bmDPS_D0 r r' F = bmDPS_D0 r r' F * A) :
    ∃ x : Matrix (Fin r) (Fin r) F, ∃ y : Matrix (Fin r ⊕ Fin r') (Fin r ⊕ Fin r') F,
      A = Matrix.fromBlocks x 0 0 y := by
  let x : Matrix (Fin r) (Fin r) F := Matrix.toBlocks₁₁ A
  let y : Matrix (Fin r ⊕ Fin r') (Fin r ⊕ Fin r') F := Matrix.toBlocks₂₂ A
  refine ⟨x, y, ?_⟩
  have h' := h
  rw [bmDPS_D0_eq r r' F, ← Matrix.fromBlocks_toBlocks A] at h'
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at h'
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one,
    Matrix.one_mul] at h'
  rw [Matrix.fromBlocks_inj] at h'
  obtain ⟨-, h12, h21, -⟩ := h'
  have h12' : Matrix.toBlocks₁₂ A = 0 := h12.symm
  have h21' : Matrix.toBlocks₂₁ A = 0 := h21
  nth_rewrite 1 [← Matrix.fromBlocks_toBlocks A]
  rw [h12', h21']

private theorem bmDPS_block_diag_inner (r r' : ℕ) {F : Type} [Field F]
    {D : Matrix (Fin r ⊕ Fin r') (Fin r ⊕ Fin r') F}
    (h : D * Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
          (0 : Matrix (Fin r) (Fin r') F) (0 : Matrix (Fin r') (Fin r) F)
          (1 : Matrix (Fin r') (Fin r') F) =
        Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
          (0 : Matrix (Fin r) (Fin r') F) (0 : Matrix (Fin r') (Fin r) F)
          (1 : Matrix (Fin r') (Fin r') F)) :
    ∃ E : Matrix (Fin r) (Fin r) F, ∃ G : Matrix (Fin r') (Fin r) F,
      D = Matrix.fromBlocks E 0 G 1 := by
  let E : Matrix (Fin r) (Fin r) F := Matrix.toBlocks₁₁ D
  let G : Matrix (Fin r') (Fin r) F := Matrix.toBlocks₂₁ D
  refine ⟨E, G, ?_⟩
  have h' := h
  rw [← Matrix.fromBlocks_toBlocks D] at h'
  rw [Matrix.fromBlocks_multiply] at h'
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one,
    Matrix.one_mul] at h'
  rw [Matrix.fromBlocks_inj] at h'
  obtain ⟨-, h12, -, h22⟩ := h'
  have h12' : Matrix.toBlocks₁₂ D = 0 := h12
  have h22' : Matrix.toBlocks₂₂ D = 1 := h22
  nth_rewrite 1 [← Matrix.fromBlocks_toBlocks D]
  rw [h12', h22']

private theorem bmDPS_J'_symm (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n) :
    ∀ i j, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) i j =
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) j i := by
  intro i j
  have h : Matrix.transpose (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) =
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) := by
    rw [bmDPS_reindex_transpose, bmDPS_J_transpose]
  exact (congrFun (congrFun h i) j).symm

private noncomputable def bmDPS_glBlock (f r r' : ℕ)
    (a : GL (Fin r) (GaloisField 2 f)) :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f) :=
  Matrix.fromBlocks (a : Matrix (Fin r) (Fin r) (GaloisField 2 f))
    (0 : Matrix (Fin r) (Fin r ⊕ Fin r') (GaloisField 2 f))
    (0 : Matrix (Fin r ⊕ Fin r') (Fin r) (GaloisField 2 f))
    (Matrix.fromBlocks (Matrix.transpose (((a⁻¹ : GL (Fin r) (GaloisField 2 f))) :
      Matrix (Fin r) (Fin r) (GaloisField 2 f)))
      (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))

private theorem bmDPS_glBlock_one (f r r' : ℕ) :
    bmDPS_glBlock f r r' (1 : GL (Fin r) (GaloisField 2 f)) = 1 := by
  unfold bmDPS_glBlock
  simp only [inv_one, Units.val_one, Matrix.transpose_one, Matrix.fromBlocks_one]

private theorem bmDPS_glBlock_mul (f r r' : ℕ)
    (a b : GL (Fin r) (GaloisField 2 f)) :
    bmDPS_glBlock f r r' (a * b) = bmDPS_glBlock f r r' a * bmDPS_glBlock f r r' b := by
  have hinner : (Matrix.fromBlocks
        (Matrix.transpose (((a⁻¹ : GL (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f))))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) *
      (Matrix.fromBlocks
        (Matrix.transpose (((b⁻¹ : GL (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f))))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) =
      Matrix.fromBlocks
        (Matrix.transpose ((((a * b)⁻¹ : GL (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f))))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) := by
    rw [Matrix.fromBlocks_multiply]
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one]
    rw [show Matrix.transpose (((a * b)⁻¹ : GL (Fin r) (GaloisField 2 f)) :
            Matrix (Fin r) (Fin r) (GaloisField 2 f)) =
        Matrix.transpose (((a⁻¹ : GL (Fin r) (GaloisField 2 f)) :
            Matrix (Fin r) (Fin r) (GaloisField 2 f))) *
        Matrix.transpose (((b⁻¹ : GL (Fin r) (GaloisField 2 f)) :
            Matrix (Fin r) (Fin r) (GaloisField 2 f))) from by
      rw [show ((a * b)⁻¹ : GL (Fin r) (GaloisField 2 f)) = b⁻¹ * a⁻¹ from mul_inv_rev a b,
        Units.val_mul, Matrix.transpose_mul]]
  unfold bmDPS_glBlock
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [hinner, Units.val_mul]

private theorem bmDPS_blockMat_eq_glBlock (n f r r' : ℕ)

    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmDPS_blockMat n f r r' x = bmDPS_glBlock f r r' (x : GL (Fin r) (GaloisField 2 f)) :=
  rfl

private noncomputable def bmDPS_J12 (f r r' : ℕ) :
    Matrix (Fin r) (Fin r ⊕ Fin r') (GaloisField 2 f) :=
  Matrix.of (fun a j => match j with
    | Sum.inl b => if a = b then (1 : GaloisField 2 f) else 0
    | Sum.inr _ => 0)

private noncomputable def bmDPS_J21 (f r r' : ℕ) :
    Matrix (Fin r ⊕ Fin r') (Fin r) (GaloisField 2 f) :=
  Matrix.of (fun b a => match b with
    | Sum.inl b' => if b' = a then (1 : GaloisField 2 f) else 0
    | Sum.inr _ => 0)

private theorem bmDPS_J'_blocks (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f r r' eidx) :
    Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) =
      Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (bmDPS_J12 f r r') (bmDPS_J21 f r r')
        (Matrix.of (fun b b' => Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)
          (Sum.inr b) (Sum.inr b'))) := by
  set Jb : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r'))
      (GaloisField 2 f) := Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) with hJbdef
  have hC2 : ∀ a a' : Fin r, Jb (Sum.inl a) (Sum.inl a') = 0 := hJ.2.1
  have hC3 : ∀ b b' : Fin r, Jb (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inl b')) = 0 := hJ.2.2.1
  have hC4 : ∀ (a : Fin r) (c : Fin r'), Jb (Sum.inl a) (Sum.inr (Sum.inr c)) = 0 := hJ.2.2.2.1
  have hC5 : ∀ (c : Fin r') (a : Fin r), Jb (Sum.inr (Sum.inr c)) (Sum.inl a) = 0 := hJ.2.2.2.2.1
  have hC6 : ∀ (b : Fin r) (c : Fin r'), Jb (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inr c)) = 0 :=
      hJ.2.2.2.2.2.1
  have hC7 : ∀ (c : Fin r') (b : Fin r), Jb (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inl b)) = 0 :=
      hJ.2.2.2.2.2.2.1
  have hC8 : ∀ (a b : Fin r), Jb (Sum.inl a) (Sum.inr (Sum.inl b)) = if a = b then 1 else 0 :=
      hJ.2.2.2.2.2.2.2
  have hCsymm : ∀ i j, Jb i j = Jb j i := bmDPS_J'_symm n f r r' eidx
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c')
  · rw [hC2]; simp [Matrix.fromBlocks]
  · rw [hC8]; rfl
  · rw [hC4]; simp [Matrix.fromBlocks, bmDPS_J12]
  · rw [show Jb (Sum.inr (Sum.inl b)) (Sum.inl a') = Jb (Sum.inl a') (Sum.inr (Sum.inl b))
        from hCsymm _ _]
    rw [hC8]
    simp [bmDPS_J21, eq_comm]
  · rw [hC3]; simp [Matrix.fromBlocks, hC3]
  · rw [hC6]; simp [Matrix.fromBlocks, hC6]
  · rw [hC5]; simp [Matrix.fromBlocks, bmDPS_J21, hC5]
  · rw [hC7]; simp [Matrix.fromBlocks, hC7]
  · rfl

private theorem bmDPS_J'_blocks_hB (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hB : (∀ a a' : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a) (Sum.inl a')
        = 0) ∧
      (∀ b b' : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr (Sum.inl b))
          (Sum.inr (Sum.inl b')) = 0) ∧
      (∀ (a : Fin r) (c : Fin r'), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a)
          (Sum.inr (Sum.inr c)) = 0) ∧
      (∀ (c : Fin r') (a : Fin r), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr
          (Sum.inr c)) (Sum.inl a) = 0) ∧
      (∀ (b : Fin r) (c : Fin r'), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr
          (Sum.inl b)) (Sum.inr (Sum.inr c)) = 0) ∧
      (∀ (c : Fin r') (b : Fin r), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr
          (Sum.inr c)) (Sum.inr (Sum.inl b)) = 0) ∧
      (∀ a b : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a) (Sum.inr (Sum.inl
          b)) = if a = b then 1 else 0)) :
    Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) =
      Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (bmDPS_J12 f r r') (bmDPS_J21 f r r')
        (Matrix.of (fun b b' => Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)
          (Sum.inr b) (Sum.inr b'))) := by
  set Jb : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r'))
      (GaloisField 2 f) := Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) with hJbdef
  have hC2 : ∀ a a' : Fin r, Jb (Sum.inl a) (Sum.inl a') = 0 := hB.1
  have hC3 : ∀ b b' : Fin r, Jb (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inl b')) = 0 := hB.2.1
  have hC4 : ∀ (a : Fin r) (c : Fin r'), Jb (Sum.inl a) (Sum.inr (Sum.inr c)) = 0 := hB.2.2.1
  have hC5 : ∀ (c : Fin r') (a : Fin r), Jb (Sum.inr (Sum.inr c)) (Sum.inl a) = 0 := hB.2.2.2.1
  have hC6 : ∀ (b : Fin r) (c : Fin r'), Jb (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inr c)) = 0 :=
      hB.2.2.2.2.1
  have hC7 : ∀ (c : Fin r') (b : Fin r), Jb (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inl b)) = 0 :=
      hB.2.2.2.2.2.1
  have hC8 : ∀ (a b : Fin r), Jb (Sum.inl a) (Sum.inr (Sum.inl b)) = if a = b then 1 else 0 :=
      hB.2.2.2.2.2.2
  have hCsymm : ∀ i j, Jb i j = Jb j i := bmDPS_J'_symm n f r r' eidx
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c')
  · rw [hC2]; simp [Matrix.fromBlocks]
  · rw [hC8]; rfl
  · rw [hC4]; simp [Matrix.fromBlocks, bmDPS_J12]
  · rw [show Jb (Sum.inr (Sum.inl b)) (Sum.inl a') = Jb (Sum.inl a') (Sum.inr (Sum.inl b))
        from hCsymm _ _]
    rw [hC8]
    simp [bmDPS_J21, eq_comm]
  · rw [hC3]; simp [Matrix.fromBlocks, hC3]
  · rw [hC6]; simp [Matrix.fromBlocks, hC6]
  · rw [hC5]; simp [Matrix.fromBlocks, bmDPS_J21, hC5]
  · rw [hC7]; simp [Matrix.fromBlocks, hC7]
  · rfl

private theorem bmDPS_J22_eq_hB (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hB : (∀ a a' : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a) (Sum.inl a')
        = 0) ∧
      (∀ b b' : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr (Sum.inl b))
          (Sum.inr (Sum.inl b')) = 0) ∧
      (∀ (a : Fin r) (c : Fin r'), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a)
          (Sum.inr (Sum.inr c)) = 0) ∧
      (∀ (c : Fin r') (a : Fin r), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr
          (Sum.inr c)) (Sum.inl a) = 0) ∧
      (∀ (b : Fin r) (c : Fin r'), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr
          (Sum.inl b)) (Sum.inr (Sum.inr c)) = 0) ∧
      (∀ (c : Fin r') (b : Fin r), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr
          (Sum.inr c)) (Sum.inr (Sum.inl b)) = 0) ∧
      (∀ a b : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a) (Sum.inr (Sum.inl
          b)) = if a = b then 1 else 0)) :
    Matrix.of (fun b b' => Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)
        (Sum.inr b) (Sum.inr b')) =
      Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (Matrix.of (fun c c' => Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)
          (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inr c')))) := by
  ext b b'
  simp only [Matrix.of_apply]
  rcases b with b | c <;> rcases b' with b' | c'
  · rw [hB.2.1]; rfl
  · rw [hB.2.2.2.2.1]; rfl
  · rw [hB.2.2.2.2.2.1]; rfl
  · rfl

private theorem bmDPS_J22_eq (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f r r' eidx) :
    Matrix.of (fun b b' => Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)
        (Sum.inr b) (Sum.inr b')) =
      Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (Matrix.of (fun c c' => Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)
          (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inr c')))) := by
  ext b b'
  simp only [Matrix.of_apply]
  rcases b with b | c <;> rcases b' with b' | c'
  · rw [hJ.2.2.1]; rfl
  · rw [hJ.2.2.2.2.2.1]; rfl
  · rw [hJ.2.2.2.2.2.2.1]; rfl
  · rfl

private theorem bmDPS_J12_mul (f r r' : ℕ)
    (E : Matrix (Fin r) (Fin r) (GaloisField 2 f))
    (G : Matrix (Fin r') (Fin r) (GaloisField 2 f)) :
    bmDPS_J12 f r r' * Matrix.fromBlocks E 0 G 1 =
      Matrix.of (fun a j => Sum.elim (fun b => E a b)
        (fun _ : Fin r' => (0 : GaloisField 2 f)) j) := by
  ext a j
  rcases j with b | c
  · rw [Matrix.mul_apply, Finset.sum_eq_single (Sum.inl a)]
    · simp [bmDPS_J12, Matrix.fromBlocks]
    · intro k _ hk
      rcases k with a' | (b' | c')
      · have hne : a ≠ a' := fun h => hk (by rw [h])
        simp [bmDPS_J12, Matrix.fromBlocks, hne]
      · simp [bmDPS_J12, Matrix.fromBlocks]
      · simp [bmDPS_J12, Matrix.fromBlocks]
    · intro h; exact absurd (Finset.mem_univ _) h
  · simp only [Matrix.of_apply, Sum.elim]
    rw [Matrix.mul_apply]
    exact Finset.sum_eq_zero (fun k _ => by
      rcases k with a' | (b' | c') <;> simp [bmDPS_J12, Matrix.fromBlocks])

private theorem bmDPS_transpose_fromBlocks {m n m' n' : Type*} {F : Type}
    (A : Matrix m m' F) (B : Matrix m n' F) (C : Matrix n m' F) (D : Matrix n n' F) :
    Matrix.transpose (Matrix.fromBlocks A B C D) =
      Matrix.fromBlocks (Matrix.transpose A) (Matrix.transpose C)
        (Matrix.transpose B) (Matrix.transpose D) := by
  ext i j
  rcases i with i | i <;> rcases j with j | j <;>
    simp [Matrix.fromBlocks, Matrix.transpose_apply]

private theorem bmDPS_block_symplectic (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f r r' eidx)
    {A E : Matrix (Fin r) (Fin r) (GaloisField 2 f)}
    {G : Matrix (Fin r') (Fin r) (GaloisField 2 f)}
    (hs : Matrix.transpose (Matrix.fromBlocks A 0 0 (Matrix.fromBlocks E 0 G 1)) *
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) *
      Matrix.fromBlocks A 0 0 (Matrix.fromBlocks E 0 G 1) =
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) :
    Matrix.transpose A * E = 1 ∧ G = 0 := by
  have hs1 := hs
  rw [bmDPS_J'_blocks n f r r' eidx hJ] at hs1
  rw [bmDPS_J22_eq n f r r' eidx hJ] at hs1
  simp only [bmDPS_transpose_fromBlocks, Matrix.transpose_zero, Matrix.fromBlocks_multiply,
    Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add] at hs1
  rw [Matrix.fromBlocks_inj] at hs1
  obtain ⟨-, hAE, -, hGG⟩ := hs1
  let Q : Matrix (Fin r') (Fin r') (GaloisField 2 f) :=
    Matrix.of (fun c c' => Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)
      (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inr c')))
  have hQ : Q * Q = 1 := by
    ext c c'
    have h := congrFun (congrFun (bmDPS_J'_sq n f r r' eidx) (Sum.inr (Sum.inr c)))
      (Sum.inr (Sum.inr c'))
    simp only [Matrix.mul_apply, Matrix.of_apply, Matrix.one_apply, Fintype.sum_sum_type,
      hJ.2.2.1, hJ.2.2.2.2.1, hJ.2.2.2.2.2.1, hJ.2.2.2.2.2.2.1] at h
    simpa [Matrix.mul_apply, Q, Matrix.of_apply, Matrix.one_apply] using h
  constructor
  · rw [Matrix.mul_assoc, bmDPS_J12_mul f r r' E G] at hAE
    ext a b
    have hh := congrFun (congrFun hAE a) (Sum.inl b)
    simpa [Matrix.mul_apply, Matrix.one_apply, bmDPS_J12, Sum.elim] using hh
  · rw [Matrix.fromBlocks_inj] at hGG
    obtain ⟨-, hGQ, -, -⟩ := hGG
    have hGQ' : Matrix.transpose G * Q = 0 := by simpa [Q, Matrix.mul_one] using hGQ
    have hGt : Matrix.transpose G = 0 := by
      rw [← Matrix.mul_one (Matrix.transpose G), ← hQ, ← Matrix.mul_assoc, hGQ',
        Matrix.zero_mul]
    rw [← Matrix.transpose_transpose G, hGt, Matrix.transpose_zero]

private theorem bmDPS_block_of_mem (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (hJ : bmDPS_IsFormStandard n f r r' eidx)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) * P = e)
    (hconv1 : 1 - bmDPS_eps n f e =
      Pinv * Matrix.reindex eidx eidx (bmDPS_D1 r r' (GaloisField 2 f)) * P)
    (g : GL (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hge : (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * e =
      e * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)))
    (hgf : (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) *
      (1 - bmDPS_eps n f e) = 1 - bmDPS_eps n f e)
    (hgsp : Matrix.transpose
        (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) *
      bmDPS_J n f * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
        bmDPS_J n f) :
    ∃ a : GL (Fin r) (GaloisField 2 f),
      Matrix.reindex eidx.symm eidx.symm
        (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) =
        bmDPS_glBlock f r r' a := by
  let M : Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f) :=
    Matrix.reindex eidx.symm eidx.symm
      (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv)
  have hM : Matrix.reindex eidx eidx M =
      P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv :=
    bmDPS_reindex_comp_symm f eidx.symm
      (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv)
  have hconje : P * e * Pinv = Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) := by
    calc P * e * Pinv
        = P * (Pinv * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) * P) * Pinv := by
            rw [← hconv]
      _ = Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) := by
            rw [show P * (Pinv * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) * P) *
                Pinv = (P * Pinv) * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) *
                  (P * Pinv) from by noncomm_ring, hPP]
            simp
  have hconj1 : P * (1 - bmDPS_eps n f e) * Pinv =
      Matrix.reindex eidx eidx (bmDPS_D1 r r' (GaloisField 2 f)) := by
    calc P * (1 - bmDPS_eps n f e) * Pinv
        = P * (Pinv * Matrix.reindex eidx eidx (bmDPS_D1 r r' (GaloisField 2 f)) * P) * Pinv := by
            rw [← hconv1]
      _ = Matrix.reindex eidx eidx (bmDPS_D1 r r' (GaloisField 2 f)) := by
            rw [show P * (Pinv * Matrix.reindex eidx eidx (bmDPS_D1 r r' (GaloisField 2 f)) * P) *
                Pinv = (P * Pinv) * Matrix.reindex eidx eidx (bmDPS_D1 r r' (GaloisField 2 f)) *
                  (P * Pinv) from by noncomm_ring, hPP]
            simp
  have hM0 : M * bmDPS_D0 r r' (GaloisField 2 f) = bmDPS_D0 r r' (GaloisField 2 f) * M := by
    have h1 : (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) *
        (P * e * Pinv) =
        (P * e * Pinv) * (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv)
            := by
      calc (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) *
            (P * e * Pinv)
          = P * ((g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * e) * Pinv :=
              bmDPS_conj_mul' n f P Pinv _ e hPinvP
        _ = P * (e * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))) * Pinv := by
              rw [hge]
        _ = (P * e * Pinv) *
            (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) :=
              (bmDPS_conj_mul' n f P Pinv e _ hPinvP).symm
    rw [← hM, hconje] at h1
    rw [← bmDPS_reindex_mul f eidx M (bmDPS_D0 r r' (GaloisField 2 f)),
      ← bmDPS_reindex_mul f eidx (bmDPS_D0 r r' (GaloisField 2 f)) M] at h1
    have h2 := congrArg (Matrix.reindex eidx.symm eidx.symm) h1
    rw [bmDPS_reindex_comp_symm f eidx (M * bmDPS_D0 r r' (GaloisField 2 f)),
      bmDPS_reindex_comp_symm f eidx (bmDPS_D0 r r' (GaloisField 2 f) * M)] at h2
    exact h2
  have hM1 : M * bmDPS_D1 r r' (GaloisField 2 f) = bmDPS_D1 r r' (GaloisField 2 f) := by
    have h1 : (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) *
        (P * (1 - bmDPS_eps n f e) * Pinv) = P * (1 - bmDPS_eps n f e) * Pinv := by
      calc (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) *
            (P * (1 - bmDPS_eps n f e) * Pinv)
          = P * ((g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) *
              (1 - bmDPS_eps n f e)) * Pinv := bmDPS_conj_mul' n f P Pinv _ _ hPinvP
        _ = P * (1 - bmDPS_eps n f e) * Pinv := by rw [hgf]
    rw [← hM, hconj1] at h1
    rw [← bmDPS_reindex_mul f eidx M (bmDPS_D1 r r' (GaloisField 2 f))] at h1
    have h2 := congrArg (Matrix.reindex eidx.symm eidx.symm) h1
    rw [bmDPS_reindex_comp_symm f eidx (M * bmDPS_D1 r r' (GaloisField 2 f)),
      bmDPS_reindex_comp_symm f eidx (bmDPS_D1 r r' (GaloisField 2 f))] at h2
    exact h2
  have hMsp : Matrix.transpose M * Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) * M =
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) := by
    have hsinv := bmDPS_symplectic_inv n f P hP
    have hPinv_eq : Pinv = (bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f := by
      calc Pinv = Pinv * (P * ((bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f)) := by
            rw [hsinv.1, Matrix.mul_one]
        _ = (Pinv * P) * ((bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f) := by noncomm_ring
        _ = (bmDPS_J n f)⁻¹ * Matrix.transpose P * bmDPS_J n f := by rw [hPinvP, Matrix.one_mul]
    have hPinv_symp : Matrix.transpose Pinv * bmDPS_J n f * Pinv = bmDPS_J n f := by
      rw [hPinv_eq]
      exact hsinv.2.2
    have hcancel : ∀ X : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f),
        Matrix.transpose Pinv * (Matrix.transpose P * X * P) * Pinv = X := by
      intro X
      calc Matrix.transpose Pinv * (Matrix.transpose P * X * P) * Pinv
          = (Matrix.transpose Pinv * Matrix.transpose P) * X * (P * Pinv) := by noncomm_ring
        _ = X := by
            rw [← Matrix.transpose_mul, hPP, Matrix.transpose_one, Matrix.one_mul,
              Matrix.mul_one]
    have hR : Matrix.transpose
        (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) *
        bmDPS_J n f *
        (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) =
        bmDPS_J n f := by
      have hg : (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
          Pinv * (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) * P :=
              by
        calc (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
              (Pinv * P) * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) *
                (Pinv * P) := by rw [hPinvP]; simp
          _ = Pinv * (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) *
                Pinv) * P := by noncomm_ring
      have h := hgsp
      rw [hg, Matrix.transpose_mul, Matrix.transpose_mul] at h
      rw [show Matrix.transpose P *
            (Matrix.transpose (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) *
                Pinv) *
              Matrix.transpose Pinv) *
            bmDPS_J n f *
            (Pinv * (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) * P)
                =
          Matrix.transpose P *
            Matrix.transpose (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) *
                Pinv) *
            (Matrix.transpose Pinv * bmDPS_J n f * Pinv) *
            (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) * P from by
        noncomm_ring] at h
      rw [hPinv_symp] at h
      have hcancel' := hcancel (Matrix.transpose
          (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) *
          bmDPS_J n f *
          (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv))
      rw [show Matrix.transpose P * (Matrix.transpose
            (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) *
            bmDPS_J n f *
            (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv)) * P =
          Matrix.transpose P * Matrix.transpose
            (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) *
            bmDPS_J n f *
            (P * (g : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) * Pinv) * P from by
        noncomm_ring] at hcancel'
      rw [h] at hcancel'
      rw [← hcancel', hPinv_symp]
    have hJb : Matrix.reindex eidx eidx (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) =
        bmDPS_J n f := bmDPS_reindex_comp_symm f eidx.symm (bmDPS_J n f)
    have hR' : Matrix.reindex eidx eidx
        (Matrix.transpose M * Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) * M) =
        Matrix.reindex eidx eidx (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) := by
      rw [bmDPS_reindex_mul f eidx
          (Matrix.transpose M * Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) M,
        bmDPS_reindex_mul f eidx (Matrix.transpose M)
          (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)),
        ← bmDPS_reindex_transpose f eidx M, hM, hJb]
      exact hR
    have h2 := congrArg (Matrix.reindex eidx.symm eidx.symm) hR'
    rw [bmDPS_reindex_comp_symm f eidx
        (Matrix.transpose M * Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) * M),
      bmDPS_reindex_comp_symm f eidx (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f))] at h2
    exact h2
  obtain ⟨A, D, hAD⟩ := bmDPS_block_diag_outer r r' (F := GaloisField 2 f) hM0
  have hD1 : D * Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) =
      Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) := by
    have h := hM1
    rw [hAD, bmDPS_D1_eq r r' (GaloisField 2 f)] at h
    rw [Matrix.fromBlocks_multiply] at h
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add] at h
    rw [Matrix.fromBlocks_inj] at h
    exact h.2.2.2
  obtain ⟨E, G, hDE⟩ := bmDPS_block_diag_inner r r' (F := GaloisField 2 f) hD1
  have hs : Matrix.transpose (Matrix.fromBlocks A 0 0 (Matrix.fromBlocks E 0 G 1)) *
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) *
      Matrix.fromBlocks A 0 0 (Matrix.fromBlocks E 0 G 1) =
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) := by
    rw [← hDE, ← hAD]
    exact hMsp
  obtain ⟨hAE, hG0⟩ := bmDPS_block_symplectic n f r r' eidx hJ hs
  have hAEt : Matrix.transpose E * A = 1 := by
    have h := congrArg Matrix.transpose hAE
    simpa [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.transpose_one] using h
  let a : GL (Fin r) (GaloisField 2 f) :=
    (Units.mkOfMulEqOne (Matrix.transpose E) A hAEt)⁻¹
  refine ⟨a, ?_⟩
  change M = bmDPS_glBlock f r r' a
  rw [hAD, hDE, hG0]
  unfold bmDPS_glBlock
  rw [show ((a : GL (Fin r) (GaloisField 2 f)) :
        Matrix (Fin r) (Fin r) (GaloisField 2 f)) = A from rfl,
    show (((a⁻¹ : GL (Fin r) (GaloisField 2 f))) :
        Matrix (Fin r) (Fin r) (GaloisField 2 f)) = Matrix.transpose E from rfl]
  rw [Matrix.transpose_transpose]

private abbrev bmDPS_gm (n f : ℕ) (g : ↥(CFSG.Open.StatedSp n (GaloisField 2 f))) :
    Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f) :=
  ((g : GL (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))

private theorem bmDPS_gm_mul (n f : ℕ)
    (g h : ↥(CFSG.Open.StatedSp n (GaloisField 2 f))) :
    bmDPS_gm n f (g * h) = bmDPS_gm n f g * bmDPS_gm n f h := by
  unfold bmDPS_gm
  rw [Subgroup.coe_mul, Units.val_mul]

private noncomputable abbrev bmDPS_matOf (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (g : ↥(CFSG.Open.StatedSp n (GaloisField 2 f))) :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f) :=
  Matrix.reindex eidx.symm eidx.symm (P * bmDPS_gm n f g * Pinv)

private theorem bmDPS_matOf_mul (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1)
    (g h : ↥(CFSG.Open.StatedSp n (GaloisField 2 f))) :
    bmDPS_matOf n f r r' eidx P Pinv (g * h) =
      bmDPS_matOf n f r r' eidx P Pinv g * bmDPS_matOf n f r r' eidx P Pinv h := by
  unfold bmDPS_matOf
  rw [← bmDPS_reindex_mul]
  rw [bmDPS_gm_mul]
  congr 1
  calc P * (bmDPS_gm n f g * bmDPS_gm n f h) * Pinv
      = (P * bmDPS_gm n f g * Pinv) * (P * bmDPS_gm n f h * Pinv) := by
        rw [show (P * bmDPS_gm n f g * Pinv) * (P * bmDPS_gm n f h * Pinv) =
            P * bmDPS_gm n f g * (Pinv * P) * bmDPS_gm n f h * Pinv from by noncomm_ring,
          hPinvP, Matrix.mul_one]
        noncomm_ring

private theorem bmDPS_matOf_one (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) :
    bmDPS_matOf n f r r' eidx P Pinv (1 : ↥(CFSG.Open.StatedSp n (GaloisField 2 f))) = 1 := by
  unfold bmDPS_matOf
  rw [show bmDPS_gm n f (1 : ↥(CFSG.Open.StatedSp n (GaloisField 2 f))) = 1 from by
    unfold bmDPS_gm
    rw [Subgroup.coe_one, Units.val_one]]
  rw [Matrix.mul_one, hPP, bmDPS_reindex_one]

private theorem bmDPS_matOf_inv (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (g : ↥(CFSG.Open.StatedSp n (GaloisField 2 f))) :
    bmDPS_matOf n f r r' eidx P Pinv g⁻¹ = (bmDPS_matOf n f r r' eidx P Pinv g)⁻¹ := by
  have h : bmDPS_matOf n f r r' eidx P Pinv g * bmDPS_matOf n f r r' eidx P Pinv g⁻¹ = 1 := by
    rw [← bmDPS_matOf_mul n f r r' eidx P Pinv hPinvP, mul_inv_cancel,
      bmDPS_matOf_one n f r r' eidx P Pinv hPP]
  exact (Matrix.inv_eq_right_inv h).symm

private theorem bmDPS_glBlock_injective (f r r' : ℕ) :
    Function.Injective (bmDPS_glBlock f r r') := by
  intro a b h
  apply Units.ext
  ext i j
  have hh := congrFun (congrFun h (Sum.inl i)) (Sum.inl j)
  simpa [bmDPS_glBlock, Matrix.fromBlocks] using hh

private theorem bmDPS_glBlock_inv (f r r' : ℕ) (a : GL (Fin r) (GaloisField 2 f)) :
    bmDPS_glBlock f r r' a⁻¹ = (bmDPS_glBlock f r r' a)⁻¹ := by
  have h : bmDPS_glBlock f r r' a * bmDPS_glBlock f r r' a⁻¹ = 1 := by
    rw [← bmDPS_glBlock_mul, mul_inv_cancel, bmDPS_glBlock_one]
  exact (Matrix.inv_eq_right_inv h).symm

private theorem bmDPS_range_le_embedHom
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    {r r' : ℕ} (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    {P Pinv : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : Matrix.transpose P * bmDPS_J n f * P = bmDPS_J n f)
    (hJ : bmDPS_IsFormStandard n f r r' eidx)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmDPS_D0 r r' (GaloisField 2 f)) * P = e) :
    bmDPS_range n f S e ≤ (bmDPS_embedHom n f r r' eidx P Pinv hPP hPinvP hP hJ).range := by
  have hconv1 := bmDPS_eps_conj n f eidx hPinvP hP hJ hconv
  have getBlock : ∀ g ∈ glBlockCentralizer
        ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) S (bmDPS_eps n f e),
      ∃ a : GL (Fin r) (GaloisField 2 f),
        bmDPS_matOf n f r r' eidx P Pinv g = bmDPS_glBlock f r r' a := by
    intro g hg
    rw [glBlockCentralizer, Subgroup.mem_comap, Subgroup.mem_inf] at hg
    obtain ⟨hgC, hgF⟩ := hg
    have hge : bmDPS_gm n f g * e =
        e * bmDPS_gm n f g := by
      refine (Algebra.commute_of_mem_adjoin_of_forall_mem_commute he.1 ?_).eq
      rintro b ⟨s, hs, rfl⟩
      exact (congrArg (fun u : GL (Fin n ⊕ Fin n) (GaloisField 2 f) =>
        (u : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)))
        ((Subgroup.mem_centralizer_iff.mp hgC) s hs)).symm
    have hgf : bmDPS_gm n f g *
        (1 - bmDPS_eps n f e) = 1 - bmDPS_eps n f e := hgF
    have hgsp : Matrix.transpose (bmDPS_gm n f g) * bmDPS_J n f *
        bmDPS_gm n f g = bmDPS_J n f := by
      have h := CFSG.Open.StatedAPI.mem_statedSp_iff.mp
        (g : ↥(CFSG.Open.StatedSp n (GaloisField 2 f))).2
      simpa [show (⇑(RingHom.id (GaloisField 2 f)) : GaloisField 2 f → GaloisField 2 f) = id
        from rfl, Matrix.map_id] using h
    exact bmDPS_block_of_mem n f r r' eidx hJ hPP hPinvP hP hconv hconv1
      (g : GL (Fin n ⊕ Fin n) (GaloisField 2 f)) hge hgf hgsp
  rw [show bmDPS_range n f S e = ⁅glBlockCentralizer
      ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) S (bmDPS_eps n f e),
      glBlockCentralizer ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) S
        (bmDPS_eps n f e)⁆ from rfl, Subgroup.commutator_le]
  intro u hu v hv
  rw [commutatorElement_def]
  obtain ⟨au, hau⟩ := getBlock u hu
  obtain ⟨av, hav⟩ := getBlock v hv
  obtain ⟨aui, haui⟩ := getBlock u⁻¹
    ((glBlockCentralizer ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) S
      (bmDPS_eps n f e)).inv_mem hu)
  obtain ⟨avi, havi⟩ := getBlock v⁻¹
    ((glBlockCentralizer ((CFSG.Open.StatedSp n (GaloisField 2 f)).subtype) S
      (bmDPS_eps n f e)).inv_mem hv)
  have haui_eq : aui = au⁻¹ := by
    apply bmDPS_glBlock_injective f r r'
    rw [← haui, bmDPS_matOf_inv n f r r' eidx P Pinv hPP hPinvP u, hau, bmDPS_glBlock_inv]
  have havi_eq : avi = av⁻¹ := by
    apply bmDPS_glBlock_injective f r r'
    rw [← havi, bmDPS_matOf_inv n f r r' eidx P Pinv hPP hPinvP v, hav, bmDPS_glBlock_inv]
  have hM : bmDPS_matOf n f r r' eidx P Pinv (u * v * u⁻¹ * v⁻¹) =
      bmDPS_glBlock f r r' (au * av * au⁻¹ * av⁻¹) := by
    rw [bmDPS_matOf_mul n f r r' eidx P Pinv hPinvP,
      bmDPS_matOf_mul n f r r' eidx P Pinv hPinvP,
      bmDPS_matOf_mul n f r r' eidx P Pinv hPinvP,
      bmDPS_matOf_inv n f r r' eidx P Pinv hPP hPinvP,
      bmDPS_matOf_inv n f r r' eidx P Pinv hPP hPinvP,
      hau, hav]
    rw [← bmDPS_glBlock_inv, ← bmDPS_glBlock_inv,
      ← bmDPS_glBlock_mul, ← bmDPS_glBlock_mul, ← bmDPS_glBlock_mul]
  have hdet_au : ((au : GL (Fin r) (GaloisField 2 f)) :
      Matrix (Fin r) (Fin r) (GaloisField 2 f)).det *
      (((au⁻¹ : GL (Fin r) (GaloisField 2 f))) :
        Matrix (Fin r) (Fin r) (GaloisField 2 f)).det = 1 := by
    rw [← Matrix.det_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.det_one]
  have hdet_av : ((av : GL (Fin r) (GaloisField 2 f)) :
      Matrix (Fin r) (Fin r) (GaloisField 2 f)).det *
      (((av⁻¹ : GL (Fin r) (GaloisField 2 f))) :
        Matrix (Fin r) (Fin r) (GaloisField 2 f)).det = 1 := by
    rw [← Matrix.det_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.det_one]
  have hdet : (((au * av * au⁻¹ * av⁻¹ : GL (Fin r) (GaloisField 2 f))) :
      Matrix (Fin r) (Fin r) (GaloisField 2 f)).det = 1 := by
    rw [Units.val_mul, Units.val_mul, Units.val_mul, Matrix.det_mul, Matrix.det_mul,
      Matrix.det_mul]
    calc ((au : GL (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)).det *
          ((av : GL (Fin r) (GaloisField 2 f)) :
            Matrix (Fin r) (Fin r) (GaloisField 2 f)).det *
          (((au⁻¹ : GL (Fin r) (GaloisField 2 f))) :
            Matrix (Fin r) (Fin r) (GaloisField 2 f)).det *
          (((av⁻¹ : GL (Fin r) (GaloisField 2 f))) :
            Matrix (Fin r) (Fin r) (GaloisField 2 f)).det
        = (((au : GL (Fin r) (GaloisField 2 f)) :
              Matrix (Fin r) (Fin r) (GaloisField 2 f)).det *
            (((au⁻¹ : GL (Fin r) (GaloisField 2 f))) :
              Matrix (Fin r) (Fin r) (GaloisField 2 f)).det) *
          (((av : GL (Fin r) (GaloisField 2 f)) :
              Matrix (Fin r) (Fin r) (GaloisField 2 f)).det *
            (((av⁻¹ : GL (Fin r) (GaloisField 2 f))) :
              Matrix (Fin r) (Fin r) (GaloisField 2 f)).det) := by ring
      _ = 1 := by rw [hdet_au, hdet_av, mul_one]
  let x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f) :=
    ⟨(((au * av * au⁻¹ * av⁻¹ : GL (Fin r) (GaloisField 2 f))) :
      Matrix (Fin r) (Fin r) (GaloisField 2 f)), hdet⟩
  refine ⟨x, ?_⟩
  apply Subtype.ext
  apply Units.ext
  have hxgl : (x : GL (Fin r) (GaloisField 2 f)) =
      (au * av * au⁻¹ * av⁻¹ : GL (Fin r) (GaloisField 2 f)) := Units.ext rfl
  have hMw : bmDPS_matOf n f r r' eidx P Pinv (u * v * u⁻¹ * v⁻¹) =
      bmDPS_blockMat n f r r' x := by
    rw [hM, ← hxgl, ← bmDPS_blockMat_eq_glBlock]
  have hMw2 : P * bmDPS_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv =
      Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x) := by
    have h := congrArg (Matrix.reindex eidx eidx) hMw
    unfold bmDPS_matOf at h
    change Matrix.reindex eidx.symm.symm eidx.symm.symm
      (Matrix.reindex eidx.symm eidx.symm
        (P * bmDPS_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv)) =
      Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x) at h
    rw [bmDPS_reindex_comp_symm f eidx.symm
      (P * bmDPS_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv)] at h
    exact h
  change ((bmDPS_embedGL n f r r' eidx P Pinv hPP hPinvP x : GL (Fin n ⊕ Fin n)
      (GaloisField 2 f)) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) =
    bmDPS_gm n f (u * v * u⁻¹ * v⁻¹)
  rw [bmDPS_embedGL_coe]
  calc Pinv * Matrix.reindex eidx eidx (bmDPS_blockMat n f r r' x) * P
      = Pinv * (P * bmDPS_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv) * P := by
          rw [← hMw2]
    _ = bmDPS_gm n f (u * v * u⁻¹ * v⁻¹) := by
        rw [show Pinv * (P * bmDPS_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv) * P =
            (Pinv * P) * bmDPS_gm n f (u * v * u⁻¹ * v⁻¹) * (Pinv * P) from by
          noncomm_ring, hPinvP]
        simp

private theorem bmDPS_exists_basis_range_e_span
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e) :
    ∃ (r : ℕ) (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f)),
      e * We = We ∧
      Function.Injective (fun c : Fin r → GaloisField 2 f => Matrix.mulVec We c) ∧
      (∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
        Matrix.mulVec e x ∈ LinearMap.range (Matrix.mulVecLin We)) ∧
      Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin e)) = r := by
  classical
  let W : Submodule (GaloisField 2 f) (Fin n ⊕ Fin n → GaloisField 2 f) :=
    LinearMap.range (Matrix.mulVecLin e)
  let r : ℕ := Module.finrank (GaloisField 2 f) W
  let b : Module.Basis (Fin r) (GaloisField 2 f) W := Module.finBasis (GaloisField 2 f) W
  let We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f) :=
    Matrix.of fun i j => (b j : Fin n ⊕ Fin n → GaloisField 2 f) i
  have hmulVec_e : ∀ v ∈ W, Matrix.mulVec e v = v := by
    intro v hv
    obtain ⟨u, hu⟩ := hv
    rw [Matrix.mulVecLin_apply] at hu
    rw [← hu, Matrix.mulVec_mulVec, he.2.1.eq]
  refine ⟨r, We, ?_, ?_, ?_, ?_⟩
  · ext i j
    have hfix : Matrix.mulVec e (b j : Fin n ⊕ Fin n → GaloisField 2 f) =
        (b j : Fin n ⊕ Fin n → GaloisField 2 f) := hmulVec_e (b j) (b j).2
    rw [Matrix.mul_apply]
    trans (Matrix.mulVec e (b j : Fin n ⊕ Fin n → GaloisField 2 f)) i
    · simp [Matrix.mulVec, dotProduct, We]
    · rw [hfix]
      simp [We]
  · intro c c' hcc
    funext j
    have hW : (∑ k, c k • (b k : W)) = (∑ k, c' k • (b k : W)) := by
      apply Subtype.ext
      ext i
      have h := congrFun hcc i
      simp only [Matrix.mulVec, dotProduct, We, Submodule.coe_sum, Submodule.coe_smul,
        Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at h ⊢
      have h1 : (∑ k, c k * (b k : Fin n ⊕ Fin n → GaloisField 2 f) i) =
          ∑ k, (b k : Fin n ⊕ Fin n → GaloisField 2 f) i * c k :=
        Finset.sum_congr rfl fun k _ => mul_comm _ _
      have h2 : (∑ k, c' k * (b k : Fin n ⊕ Fin n → GaloisField 2 f) i) =
          ∑ k, (b k : Fin n ⊕ Fin n → GaloisField 2 f) i * c' k :=
        Finset.sum_congr rfl fun k _ => mul_comm _ _
      rw [h1, h2]
      exact h
    exact (Fintype.linearIndependent_iffₛ.mp b.linearIndependent) c c' hW j
  · intro x
    refine ⟨fun k => b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k, ?_⟩
    rw [Matrix.mulVecLin_apply]
    have h' := congrArg Subtype.val (b.sum_repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩)
    have hrepr : (∑ k, b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k •
        (b k : Fin n ⊕ Fin n → GaloisField 2 f)) = Matrix.mulVec e x := by
      have h'' : (∑ k, b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k •
            (b k : Fin n ⊕ Fin n → GaloisField 2 f)) =
          ((∑ k, b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k • b k : W) :
            Fin n ⊕ Fin n → GaloisField 2 f) := by
        simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply]
      rw [h'']
      exact h'
    trans (∑ k, b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k •
        (b k : Fin n ⊕ Fin n → GaloisField 2 f))
    · ext i
      simp [Matrix.mulVec, dotProduct, We, Finset.sum_apply, mul_comm]
    · exact hrepr
  · rfl

private theorem bmDPS_finrank_range_mulVecLin_eq_rank (f : ℕ) {ι : Type*} [Fintype ι]
    (M : Matrix ι ι (GaloisField 2 f)) :
    M.rank = Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin M)) := by
  rw [← Matrix.rank_transpose M, Matrix.rank_eq_finrank_span_row (Matrix.transpose M),
    Matrix.row_transpose, ← Matrix.range_mulVecLin M]

private theorem bmDPS_estar_eq_conj_transpose (n f : ℕ)
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    bmDPS_estar n f e = (bmDPS_J n f)⁻¹ * Matrix.transpose e * bmDPS_J n f := by
  simp only [bmDPS_estar, formAdj]
  rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
    congrArg Matrix.transpose (Matrix.map_id e)]

private theorem bmDPS_rank_estar_eq_rank (n f : ℕ)
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    (bmDPS_estar n f e).rank = e.rank := by
  rw [bmDPS_estar_eq_conj_transpose n f e]
  rw [Matrix.rank_mul_eq_left_of_isUnit_det (bmDPS_J n f)
      ((bmDPS_J n f)⁻¹ * Matrix.transpose e) (bmDPS_J_isUnit_det n f)]
  rw [Matrix.rank_mul_eq_right_of_isUnit_det (bmDPS_J n f)⁻¹ (Matrix.transpose e)
      (Matrix.isUnit_nonsing_inv_det (A := bmDPS_J n f) (bmDPS_J_isUnit_det n f))]
  rw [Matrix.rank_transpose]

private theorem bmDPS_estar_range_finrank (n f : ℕ)
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    Module.finrank (GaloisField 2 f)
        (LinearMap.range (Matrix.mulVecLin (bmDPS_estar n f e))) =
      Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin e)) := by
  rw [← bmDPS_finrank_range_mulVecLin_eq_rank f (bmDPS_estar n f e),
      ← bmDPS_finrank_range_mulVecLin_eq_rank f e, bmDPS_rank_estar_eq_rank]

private theorem bmDPS_dual_bases_ws_span (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (We V : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hr : Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin e)) = r)
    (hdual : Matrix.transpose We * bmDPS_J n f * (bmDPS_estar n f e * V) = 1) :
    ∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
      Matrix.mulVec (bmDPS_estar n f e) x ∈
        LinearMap.range (Matrix.mulVecLin (bmDPS_estar n f e * V)) := by
  have hinj : Function.Injective (Matrix.mulVecLin (bmDPS_estar n f e * V)) := by
    intro c c' hcc
    have h3 : Matrix.mulVecLin (Matrix.transpose We * bmDPS_J n f)
        (Matrix.mulVecLin (bmDPS_estar n f e * V) c) =
        Matrix.mulVecLin (Matrix.transpose We * bmDPS_J n f)
        (Matrix.mulVecLin (bmDPS_estar n f e * V) c') := by
      rw [hcc]
    have h4 : Matrix.mulVecLin (Matrix.transpose We * bmDPS_J n f * (bmDPS_estar n f e * V)) c =
        Matrix.mulVecLin (Matrix.transpose We * bmDPS_J n f * (bmDPS_estar n f e * V)) c' := by
      simpa only [Matrix.mulVecLin_mul, LinearMap.comp_apply] using h3
    rw [hdual, Matrix.mulVecLin_one] at h4
    simpa using h4
  have hfinV : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (bmDPS_estar n f e * V))) = r := by
    have hker : (Matrix.mulVecLin (bmDPS_estar n f e * V)).ker = ⊥ :=
      LinearMap.ker_eq_bot.mpr hinj
    have h := LinearMap.finrank_range_add_finrank_ker (Matrix.mulVecLin (bmDPS_estar n f e * V))
    rw [hker, finrank_bot, add_zero, Module.finrank_fintype_fun_eq_card, Fintype.card_fin] at h
    exact h
  have hle : LinearMap.range (Matrix.mulVecLin (bmDPS_estar n f e * V)) ≤
      LinearMap.range (Matrix.mulVecLin (bmDPS_estar n f e)) := by
    rintro y ⟨c, rfl⟩
    exact ⟨Matrix.mulVec V c, by simp only [Matrix.mulVecLin_mul, LinearMap.comp_apply,
      Matrix.mulVecLin_apply]⟩
  have hfinE : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (bmDPS_estar n f e))) = r := by
    rw [bmDPS_estar_range_finrank n f e, hr]
  have heq := Submodule.eq_of_le_of_finrank_eq hle (by rw [hfinV, hfinE])
  intro x
  rw [heq]
  exact ⟨x, rfl⟩

private theorem bmDPS_exists_dual_bases_e_span
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e)) :
    ∃ (r : ℕ) (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f)),
      e * We = We ∧ bmDPS_estar n f e * Ws = Ws ∧
      Matrix.transpose We * bmDPS_J n f * Ws = 1 ∧
      (∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
        Matrix.mulVec e x ∈ LinearMap.range (Matrix.mulVecLin We)) ∧
      (∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
        Matrix.mulVec (bmDPS_estar n f e) x ∈ LinearMap.range (Matrix.mulVecLin Ws)) := by
  obtain ⟨r, We, hWe, hinj, hWeSpan, hr⟩ :=
    bmDPS_exists_basis_range_e_span n f S he
  obtain ⟨V, hV⟩ := bmDPS_exists_rightInverse_of_columns n f r We hinj
  obtain ⟨hWs, hdual⟩ :=
    bmDPS_estar_mul_dual n f r We V hWe hV hestar.2.1.eq
  refine ⟨r, We, bmDPS_estar n f e * V, hWe, hWs, hdual, hWeSpan, ?_⟩
  intro x
  exact bmDPS_dual_bases_ws_span n f r We V hr hdual x

private theorem bmDPS_blockCols_range {n f r : ℕ}
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f)) :
    LinearMap.range (Matrix.mulVecLin (bmDPS_blockCols We Ws)) =
      LinearMap.range (Matrix.mulVecLin We) ⊔ LinearMap.range (Matrix.mulVecLin Ws) := by
  rw [Matrix.range_mulVecLin, Matrix.range_mulVecLin, Matrix.range_mulVecLin]
  have hcol : Set.range (bmDPS_blockCols We Ws).col = Set.range We.col ∪ Set.range Ws.col := by
    ext v
    constructor
    · rintro ⟨j, rfl⟩
      rcases j with a | b
      · exact Or.inl ⟨a, rfl⟩
      · exact Or.inr ⟨b, rfl⟩
    · rintro (⟨a, rfl⟩ | ⟨b, rfl⟩)
      · exact ⟨Sum.inl a, rfl⟩
      · exact ⟨Sum.inr b, rfl⟩
  rw [hcol, Submodule.span_union]

private theorem bmDPS_adapted_basis_e_span
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (horth : e * bmDPS_estar n f e = 0) (horth' : bmDPS_estar n f e * e = 0)
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e)) :
    ∃ (r : ℕ) (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f)),
      Matrix.transpose Pe * bmDPS_J n f * Pe = bmDPS_J r f ∧
      bmDPS_eps n f e * Pe = Pe ∧
      e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) ∧
      bmDPS_estar n f e * Pe = Pe * Matrix.fromBlocks
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) ∧
      (∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
        Matrix.mulVec (bmDPS_eps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Pe)) := by
  obtain ⟨r, We, Ws, hWe, hWs, hdual, hWeSpan, hWsSpan⟩ :=
    bmDPS_exists_dual_bases_e_span n f S he hestar
  obtain ⟨hdE, hdS⟩ := bmDPS_adapted_Pe_diag n f r We Ws hWe hWs
    (bmDPS_e_mul_Ws_zero n f r Ws hWs horth) (bmDPS_estar_mul_We_zero n f r We hWe horth')
  have hrangeWe : LinearMap.range (Matrix.mulVecLin e) =
      LinearMap.range (Matrix.mulVecLin We) := by
    apply le_antisymm
    · rintro y ⟨z, rfl⟩
      simpa only [Matrix.mulVecLin_apply] using hWeSpan z
    · rintro y ⟨c, rfl⟩
      exact ⟨Matrix.mulVec We c,
        by simp only [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hWe]⟩
  have hrangeWs : LinearMap.range (Matrix.mulVecLin (bmDPS_estar n f e)) =
      LinearMap.range (Matrix.mulVecLin Ws) := by
    apply le_antisymm
    · rintro y ⟨z, rfl⟩
      simpa only [Matrix.mulVecLin_apply] using hWsSpan z
    · rintro y ⟨c, rfl⟩
      exact ⟨Matrix.mulVec Ws c,
        by simp only [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hWs]⟩
  refine ⟨r, bmDPS_blockCols We Ws,
    bmDPS_adapted_Pe_form n f r We Ws hdual (bmDPS_We_iso n f r We hWe horth')
      (bmDPS_Ws_iso n f r Ws hWs horth),
    bmDPS_adapted_Pe_eps n f r We Ws hdE hdS, hdE, hdS, ?_⟩
  intro x
  rw [bmDPS_blockCols_range We Ws, ← hrangeWe, ← hrangeWs,
    ← bmDPS_range_eps_eq_sup n f S he horth horth'
      hestar]
  exact ⟨x, rfl⟩

private theorem bmDPS_mulVecLin_injective_of_form (n f r : ℕ)
    (M : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (hM : Matrix.transpose M * bmDPS_J n f * M = bmDPS_J r f) :
    Function.Injective (Matrix.mulVecLin M) := by
  have hJ_inj : Function.Injective (Matrix.mulVecLin (bmDPS_J r f)) := by
    intro u v huv
    have h := congrArg (Matrix.mulVec (bmDPS_J r f)⁻¹) huv
    simpa only [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec,
      Matrix.nonsing_inv_mul _ (bmDPS_J_isUnit_det r f), Matrix.one_mulVec] using h
  intro c c' hcc
  have hsub : Matrix.mulVecLin M (c - c') = 0 := by rw [map_sub, hcc, sub_self]
  have h := congrArg (fun M' => Matrix.mulVecLin M' (c - c')) hM
  simp only [Matrix.mulVecLin_mul, LinearMap.comp_apply, hsub, map_zero] at h
  have h' : Matrix.mulVecLin (bmDPS_J r f) (c - c') = Matrix.mulVecLin (bmDPS_J r f) 0 := by
    rw [map_zero]
    exact h.symm
  exact sub_eq_zero.mp (hJ_inj h')

private theorem bmDPS_range_le_range_of_mul_eq (n f : ℕ) {ι : Type*} [Fintype ι]
    (ε : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (M : Matrix (Fin n ⊕ Fin n) ι (GaloisField 2 f)) (h : ε * M = M) :
    LinearMap.range (Matrix.mulVecLin M) ≤ LinearMap.range (Matrix.mulVecLin ε) := by
  rintro y ⟨c, rfl⟩
  exact ⟨Matrix.mulVec M c, by
    simp only [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, h]⟩

private theorem bmDPS_finrank_range_eq_card_of_injective (f : ℕ) {κ ι : Type*}
    [Fintype ι] (M : Matrix κ ι (GaloisField 2 f))
    (hinj : Function.Injective (Matrix.mulVecLin M)) :
    Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin M)) =
      Fintype.card ι := by
  have hker : (Matrix.mulVecLin M).ker = ⊥ := LinearMap.ker_eq_bot.mpr hinj
  have h := LinearMap.finrank_range_add_finrank_ker (Matrix.mulVecLin M)
  rw [hker, finrank_bot, add_zero, Module.finrank_fintype_fun_eq_card] at h
  exact h

private theorem bmDPS_ker_eq_range_one_sub (n f : ℕ)
    (ε : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hε : IsIdempotentElem ε) :
    (Matrix.mulVecLin ε).ker = LinearMap.range (Matrix.mulVecLin (1 - ε)) := by
  have hεε : ε * ε = ε := hε.eq
  have hε0 : ε * (1 - ε) = 0 := by
    rw [Matrix.mul_sub, Matrix.mul_one, hεε, sub_self]
  apply le_antisymm
  · intro x hx
    rw [LinearMap.mem_ker, Matrix.mulVecLin_apply] at hx
    refine ⟨x, ?_⟩
    rw [Matrix.mulVecLin_apply]
    calc Matrix.mulVec (1 - ε) x
        = 0 + Matrix.mulVec (1 - ε) x := (zero_add _).symm
      _ = Matrix.mulVec ε x + Matrix.mulVec (1 - ε) x := by rw [hx]
      _ = Matrix.mulVec (ε + (1 - ε)) x := by rw [Matrix.add_mulVec]
      _ = Matrix.mulVec 1 x := by rw [add_sub_cancel]
      _ = x := by rw [Matrix.one_mulVec]
  · rintro x ⟨y, rfl⟩
    simp only [LinearMap.mem_ker, Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hε0,
      Matrix.zero_mulVec]

private theorem bmDPS_finrank_range_add_range_one_sub (n f : ℕ)
    (ε : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f))
    (hε : IsIdempotentElem ε) :
    Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin ε)) +
      Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin (1 - ε))) =
        2 * n := by
  have hker := bmDPS_ker_eq_range_one_sub n f ε hε
  have h := LinearMap.finrank_range_add_finrank_ker (Matrix.mulVecLin ε)
  rw [hker, Module.finrank_fintype_fun_eq_card, Fintype.card_sum, Fintype.card_fin] at h
  omega

private theorem bmDPS_adapted_index_sum
    (n f : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (heps : IsIdempotentElem (bmDPS_eps n f e))
    {r s : ℕ} {Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f)}
    {Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f)}
    (hPeε : bmDPS_eps n f e * Pe = Pe)
    (hBcε : (1 - bmDPS_eps n f e) * Bc = Bc)
    (hPeJ : Matrix.transpose Pe * bmDPS_J n f * Pe = bmDPS_J r f)
    (hBcJ : Matrix.transpose Bc * bmDPS_J n f * Bc = bmDPS_J s f)
    (hPeSpan : ∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
      Matrix.mulVec (bmDPS_eps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Pe))
    (hBcSpan : ∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
      Matrix.mulVec (1 - bmDPS_eps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Bc)) :
    r + s = n := by
  have hPe_inj := bmDPS_mulVecLin_injective_of_form n f r Pe hPeJ
  have hBc_inj := bmDPS_mulVecLin_injective_of_form n f s Bc hBcJ
  have hPe_le := bmDPS_range_le_range_of_mul_eq n f (bmDPS_eps n f e) Pe hPeε
  have hBc_le := bmDPS_range_le_range_of_mul_eq n f (1 - bmDPS_eps n f e) Bc hBcε
  have hPe_ge : LinearMap.range (Matrix.mulVecLin (bmDPS_eps n f e)) ≤
      LinearMap.range (Matrix.mulVecLin Pe) := by
    rintro y ⟨z, rfl⟩
    simpa only [Matrix.mulVecLin_apply] using hPeSpan z
  have hBc_ge : LinearMap.range (Matrix.mulVecLin (1 - bmDPS_eps n f e)) ≤
      LinearMap.range (Matrix.mulVecLin Bc) := by
    rintro y ⟨z, rfl⟩
    simpa only [Matrix.mulVecLin_apply] using hBcSpan z
  have hPe_eq : LinearMap.range (Matrix.mulVecLin Pe) =
      LinearMap.range (Matrix.mulVecLin (bmDPS_eps n f e)) := le_antisymm hPe_le hPe_ge
  have hBc_eq : LinearMap.range (Matrix.mulVecLin Bc) =
      LinearMap.range (Matrix.mulVecLin (1 - bmDPS_eps n f e)) := le_antisymm hBc_le hBc_ge
  have hfinPe : Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin Pe)) = 2 * r :=
      by
    rw [bmDPS_finrank_range_eq_card_of_injective f Pe hPe_inj, Fintype.card_sum, Fintype.card_fin]
    omega
  have hfinBc : Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin Bc)) = 2 * s :=
      by
    rw [bmDPS_finrank_range_eq_card_of_injective f Bc hBc_inj, Fintype.card_sum, Fintype.card_fin]
    omega
  have hV := bmDPS_finrank_range_add_range_one_sub n f (bmDPS_eps n f e) heps
  have hPe' : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (bmDPS_eps n f e))) = 2 * r := by
    rw [← hPe_eq, hfinPe]
  have hBc' : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (1 - bmDPS_eps n f e))) = 2 * s := by
    rw [← hBc_eq, hfinBc]
  rw [hPe', hBc'] at hV
  omega

private theorem bmDPS_adapted_decomposition
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmDPS_A n f S) e)
    (horth : e * bmDPS_estar n f e = 0) (horth' : bmDPS_estar n f e * e = 0)
    (heps : IsIdempotentElem (bmDPS_eps n f e))
    (hestar : IsPrimIdemIn (bmDPS_A n f S) (bmDPS_estar n f e)) :
    ∃ (r s : ℕ) (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
      (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f)),
      (Matrix.transpose Pe * bmDPS_J n f * Pe = bmDPS_J r f) ∧
      (Matrix.transpose Bc * bmDPS_J n f * Bc = bmDPS_J s f) ∧
      (Matrix.transpose Pe * bmDPS_J n f * Bc = 0) ∧
      (bmDPS_eps n f e * Pe = Pe) ∧ ((1 - bmDPS_eps n f e) * Bc = Bc) ∧
      (e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) ∧
      (bmDPS_estar n f e * Pe = Pe * Matrix.fromBlocks
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) ∧
      (∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
        ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
          Matrix.mulVec Pe c = Matrix.mulVec (bmDPS_eps n f e) x) ∧
      (∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
        ∃ c : Fin s ⊕ Fin s → GaloisField 2 f,
          Matrix.mulVec Bc c = Matrix.mulVec (1 - bmDPS_eps n f e) x) ∧
      r + s = n ∧ e ≠ 0 := by
  obtain ⟨r, Pe, hPeJ, hPeε, hPee, hPees, hPeSpan⟩ :=
    bmDPS_adapted_basis_e_span n f S he horth horth' hestar
  obtain ⟨s, Bc, hBcJ, hBcε, hBcSpan0⟩ :=
    bmDPS_exists_symplectic_basis_compl n f heps
  have hBcSpan' : ∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
      Matrix.mulVec (1 - bmDPS_eps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Bc) := by
    intro x
    obtain ⟨c, hc⟩ := hBcSpan0 x
    exact ⟨c, hc.symm⟩
  have horthPB := bmDPS_adapted_basis_orth n f r s Pe Bc hPeε hBcε heps
    (bmDPS_eps_adjoint n f e)
  have hrs := bmDPS_adapted_index_sum n f
    heps hPeε hBcε hPeJ hBcJ hPeSpan hBcSpan'
  exact ⟨r, s, Pe, Bc, hPeJ, hBcJ, horthPB, hPeε, hBcε, hPee, hPees, hPeSpan, hBcSpan', hrs,
    he.2.2.1⟩

private theorem bmDPS_glue_pos
    (n f r s : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))

    (hspanPe : ∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmDPS_eps n f e) x)
    (hrs : r + s = n) (hε : bmDPS_eps n f e ≠ 0) :
    1 ≤ r := by
  by_contra hlt
  have hr0 : r = 0 := Nat.eq_zero_of_not_pos hlt
  subst hr0
  have hPe_bot : LinearMap.range (Matrix.mulVecLin Pe) = ⊥ := by
    rw [LinearMap.range_eq_bot]
    apply LinearMap.ext
    intro c
    rw [Matrix.mulVecLin_apply, LinearMap.zero_apply]
    have hc : c = 0 := Subsingleton.elim c 0
    rw [hc, Matrix.mulVec_zero]
  have hE_bot : LinearMap.range (Matrix.mulVecLin (bmDPS_eps n f e)) = ⊥ := by
    apply le_bot_iff.mp
    rw [← hPe_bot]
    rintro y ⟨z, rfl⟩
    exact hspanPe z
  have hE0 : Matrix.mulVecLin (bmDPS_eps n f e) = 0 := LinearMap.range_eq_bot.mp hE_bot
  apply hε
  ext i j
  have h := congrFun (congrArg (fun g => g (Pi.single j (1 : GaloisField 2 f))) hE0) i
  simpa [Matrix.mulVecLin_apply, Matrix.mulVec_single_one, Matrix.col_apply] using h

private noncomputable def bmDPS_glueBcJ (s f : ℕ) :
    Matrix (Fin (2 * s)) (Fin (2 * s)) (GaloisField 2 f) :=
  Matrix.reindex (((finCongr (two_mul s)).trans finSumFinEquiv.symm).symm)
    (((finCongr (two_mul s)).trans finSumFinEquiv.symm).symm) (bmDPS_J s f)

private noncomputable def bmDPS_gluePerm (r s : ℕ) :
    Fin r ⊕ (Fin r ⊕ (Fin s ⊕ Fin s)) ≃ (Fin r ⊕ Fin s) ⊕ (Fin r ⊕ Fin s) where
  toFun p := match p with
    | Sum.inl a => Sum.inl (Sum.inl a)
    | Sum.inr (Sum.inl b) => Sum.inr (Sum.inl b)
    | Sum.inr (Sum.inr (Sum.inl c)) => Sum.inl (Sum.inr c)
    | Sum.inr (Sum.inr (Sum.inr d)) => Sum.inr (Sum.inr d)
  invFun q := match q with
    | Sum.inl (Sum.inl a) => Sum.inl a
    | Sum.inl (Sum.inr c) => Sum.inr (Sum.inr (Sum.inl c))
    | Sum.inr (Sum.inl b) => Sum.inr (Sum.inl b)
    | Sum.inr (Sum.inr d) => Sum.inr (Sum.inr (Sum.inr d))
  left_inv := by
    intro p
    rcases p with a | (b | (c | d)) <;> rfl
  right_inv := by
    intro q
    rcases q with (a | c) | (b | d) <;> rfl

private noncomputable def bmDPS_glueEidx
    (n f r s : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hrs : r + s = n)
    {R r' : ℕ} (hR : R + 1 = r) (hr' : r' = 2 * s) :
    Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ Fin n ⊕ Fin n :=
  (Equiv.sumCongr (finCongr hR)
      (Equiv.sumCongr (finCongr hR)
        ((finCongr (hr'.trans (two_mul s))).trans finSumFinEquiv.symm))).trans
    ((bmDPS_gluePerm r s).trans
      (Equiv.sumCongr (finSumFinEquiv.trans (finCongr hrs))
        (finSumFinEquiv.trans (finCongr hrs))))

private noncomputable def bmDPS_rowBlock (f r r' : ℕ)
    (X : Matrix (Fin r) (Fin r) (GaloisField 2 f)) :
    Matrix (Fin r) (Fin r ⊕ Fin r') (GaloisField 2 f) :=
  Matrix.of (fun a j => match j with
    | Sum.inl b => X a b
    | Sum.inr _ => 0)

private theorem bmDPS_rowBlock_one (f r r' : ℕ) :
    bmDPS_rowBlock f r r' (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) =
      bmDPS_J12 f r r' := by
  ext a j
  rcases j with b | c <;> simp [bmDPS_rowBlock, bmDPS_J12, Matrix.one_apply]

private theorem bmDPS_mat_mul_rowBlock (f r r' : ℕ)
    (M X : Matrix (Fin r) (Fin r) (GaloisField 2 f)) :
    M * bmDPS_rowBlock f r r' X = bmDPS_rowBlock f r r' (M * X) := by
  ext a j
  rcases j with b | c <;> simp [bmDPS_rowBlock, Matrix.mul_apply]

private theorem bmDPS_rowBlock_mul_fromBlocks_zero (f r r' : ℕ)
    (X Y : Matrix (Fin r) (Fin r) (GaloisField 2 f))
    (V : Matrix (Fin r') (Fin r') (GaloisField 2 f)) :
    bmDPS_rowBlock f r r' X *
        Matrix.fromBlocks Y (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f)) V =
      bmDPS_rowBlock f r r' (X * Y) := by
  ext a j
  rcases j with b | c
  · rw [Matrix.mul_apply, Fintype.sum_sum_type]
    simp [bmDPS_rowBlock, Matrix.mul_apply]
  · rw [Matrix.mul_apply, Fintype.sum_sum_type]
    simp [bmDPS_rowBlock]

private theorem bmDPS_yJ12D_aux (f r r' : ℕ)
    (A : Matrix (Fin r) (Fin r) (GaloisField 2 f)) (hdet : A.det = 1) :
    Matrix.transpose A * bmDPS_J12 f r r' *
        Matrix.fromBlocks (Matrix.transpose (Matrix.adjugate A))
          (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) =
      bmDPS_J12 f r r' := by
  have hy : Matrix.transpose A * Matrix.transpose (Matrix.adjugate A) = 1 := by
    rw [← Matrix.transpose_mul]
    simp [Matrix.adjugate_mul, hdet]
  calc
    Matrix.transpose A * bmDPS_J12 f r r' *
        Matrix.fromBlocks (Matrix.transpose (Matrix.adjugate A))
          (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))
        = Matrix.transpose A * (bmDPS_rowBlock f r r' (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
            *
            Matrix.fromBlocks (Matrix.transpose (Matrix.adjugate A))
              (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
              (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
              (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) := by
          rw [← bmDPS_rowBlock_one, Matrix.mul_assoc]
    _ = Matrix.transpose A * bmDPS_rowBlock f r r' (1 * Matrix.transpose (Matrix.adjugate A)) := by
          rw [bmDPS_rowBlock_mul_fromBlocks_zero]
    _ = bmDPS_rowBlock f r r' (Matrix.transpose A * (1 * Matrix.transpose (Matrix.adjugate A))) :=
        by
          rw [bmDPS_mat_mul_rowBlock]
    _ = bmDPS_rowBlock f r r' 1 := by rw [Matrix.one_mul, hy]
    _ = bmDPS_J12 f r r' := bmDPS_rowBlock_one f r r'

private theorem bmDPS_yJ12D (f r r' : ℕ)
    (y : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    Matrix.transpose ((y : Matrix (Fin r) (Fin r) (GaloisField 2 f))) * bmDPS_J12 f r r' *
      Matrix.fromBlocks (Matrix.transpose ((y⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2
          f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) =
      bmDPS_J12 f r r' := by
  have hX : Matrix.transpose ((y⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
        Matrix (Fin r) (Fin r) (GaloisField 2 f)) =
      Matrix.transpose (Matrix.adjugate (y : Matrix (Fin r) (Fin r) (GaloisField 2 f))) := by
    simp [Matrix.SpecialLinearGroup.coe_inv]
  rw [hX]
  exact bmDPS_yJ12D_aux f r r' (y : Matrix (Fin r) (Fin r) (GaloisField 2 f))
    (Matrix.SpecialLinearGroup.det_coe y)

private noncomputable def bmDPS_colBlock (f r r' : ℕ)
    (X : Matrix (Fin r) (Fin r) (GaloisField 2 f)) :
    Matrix (Fin r ⊕ Fin r') (Fin r) (GaloisField 2 f) :=
  Matrix.of (fun i a => match i with
    | Sum.inl b => X b a
    | Sum.inr _ => 0)

private theorem bmDPS_colBlock_one (f r r' : ℕ) :
    bmDPS_colBlock f r r' (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) =
      bmDPS_J21 f r r' := by
  ext i a
  rcases i with b | c <;> simp [bmDPS_colBlock, bmDPS_J21, Matrix.one_apply]

private theorem bmDPS_fromBlocks_mul_colBlock (f r r' : ℕ)
    (M X : Matrix (Fin r) (Fin r) (GaloisField 2 f))
    (N : Matrix (Fin r') (Fin r') (GaloisField 2 f)) :
    Matrix.fromBlocks M (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f)) N *
      bmDPS_colBlock f r r' X = bmDPS_colBlock f r r' (M * X) := by
  ext i a
  rcases i with b | c
  · rw [Matrix.mul_apply, Fintype.sum_sum_type]
    simp [bmDPS_colBlock, Matrix.mul_apply]
  · rw [Matrix.mul_apply, Fintype.sum_sum_type]
    simp [bmDPS_colBlock]

private theorem bmDPS_colBlock_mul (f r r' : ℕ)
    (X Y : Matrix (Fin r) (Fin r) (GaloisField 2 f)) :
    bmDPS_colBlock f r r' X * Y = bmDPS_colBlock f r r' (X * Y) := by
  ext i a
  rcases i with b | c <;> simp [bmDPS_colBlock, Matrix.mul_apply]

private theorem bmDPS_DJ21y_aux (f r r' : ℕ)
    (A : Matrix (Fin r) (Fin r) (GaloisField 2 f)) (hdet : A.det = 1) :
    Matrix.fromBlocks (Matrix.adjugate A) (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) *
      bmDPS_J21 f r r' * A = bmDPS_J21 f r r' := by
  have hy : Matrix.adjugate A * A = 1 := by
    rw [Matrix.adjugate_mul, hdet, one_smul]
  calc
    Matrix.fromBlocks (Matrix.adjugate A) (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) *
        bmDPS_J21 f r r' * A
        = bmDPS_colBlock f r r' (Matrix.adjugate A) * A := by
          rw [← bmDPS_colBlock_one, bmDPS_fromBlocks_mul_colBlock, Matrix.mul_one]
    _ = bmDPS_colBlock f r r' (Matrix.adjugate A * A) := by
          rw [bmDPS_colBlock_mul]
    _ = bmDPS_colBlock f r r' 1 := by rw [hy]
    _ = bmDPS_J21 f r r' := bmDPS_colBlock_one f r r'

private theorem bmDPS_DJ21y (f r r' : ℕ)
    (y : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    Matrix.transpose (Matrix.fromBlocks (Matrix.transpose ((y⁻¹ : Matrix.SpecialLinearGroup (Fin r)
        (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) * bmDPS_J21 f r r' *
      (y : Matrix (Fin r) (Fin r) (GaloisField 2 f)) =
      bmDPS_J21 f r r' := by
  have hX : ((y⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
        Matrix (Fin r) (Fin r) (GaloisField 2 f)) =
      Matrix.adjugate (y : Matrix (Fin r) (Fin r) (GaloisField 2 f)) := by
    simp [Matrix.SpecialLinearGroup.coe_inv]
  rw [hX, bmDPS_transpose_fromBlocks]
  simp only [Matrix.transpose_transpose, Matrix.transpose_zero, Matrix.transpose_one]
  exact bmDPS_DJ21y_aux f r r' (y : Matrix (Fin r) (Fin r) (GaloisField 2 f))
    (Matrix.SpecialLinearGroup.det_coe y)

private theorem bmDPS_DQD (f r r' : ℕ)
    (y : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f))
    (Q : Matrix (Fin r') (Fin r') (GaloisField 2 f)) :
    Matrix.transpose (Matrix.fromBlocks (Matrix.transpose ((y⁻¹ : Matrix.SpecialLinearGroup (Fin r)
        (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) *
      Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f)) Q *
      Matrix.fromBlocks (Matrix.transpose ((y⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2
          f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) =
      Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f)) Q := by
  have hX : ((y⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
        Matrix (Fin r) (Fin r) (GaloisField 2 f)) =
      Matrix.adjugate (y : Matrix (Fin r) (Fin r) (GaloisField 2 f)) := by
    simp [Matrix.SpecialLinearGroup.coe_inv]
  rw [hX, bmDPS_transpose_fromBlocks]
  simp only [Matrix.transpose_transpose, Matrix.transpose_zero, Matrix.transpose_one,
    Matrix.fromBlocks_multiply, Matrix.mul_zero, Matrix.zero_mul, Matrix.mul_one,
    Matrix.one_mul, add_zero, zero_add]

private theorem bmDPS_blockMat_Jb (n f r r' : ℕ)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin r') ≃ Fin n ⊕ Fin n)
    (y : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f))
    (hB : (∀ a a' : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a) (Sum.inl a')
        = 0) ∧
      (∀ b b' : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr (Sum.inl b))
          (Sum.inr (Sum.inl b')) = 0) ∧
      (∀ (a : Fin r) (c : Fin r'), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a)
          (Sum.inr (Sum.inr c)) = 0) ∧
      (∀ (c : Fin r') (a : Fin r), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr
          (Sum.inr c)) (Sum.inl a) = 0) ∧
      (∀ (b : Fin r) (c : Fin r'), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr
          (Sum.inl b)) (Sum.inr (Sum.inr c)) = 0) ∧
      (∀ (c : Fin r') (b : Fin r), Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inr
          (Sum.inr c)) (Sum.inr (Sum.inl b)) = 0) ∧
      (∀ a b : Fin r, Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) (Sum.inl a) (Sum.inr (Sum.inl
          b)) = if a = b then 1 else 0)) :
    Matrix.transpose (bmDPS_blockMat n f r r' y) *
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) *
      bmDPS_blockMat n f r r' y =
      Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) := by
  rw [bmDPS_J'_blocks_hB n f r r' eidx hB, bmDPS_J22_eq_hB n f r r' eidx hB]
  unfold bmDPS_blockMat
  rw [bmDPS_transpose_fromBlocks]
  simp only [Matrix.transpose_zero, Matrix.transpose_one, Matrix.fromBlocks_multiply,
    Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [Matrix.fromBlocks_inj]
  refine ⟨by simp, bmDPS_yJ12D f r r' y, bmDPS_DJ21y f r r' y, ?_⟩
  exact bmDPS_DQD f r r' y (Matrix.of (fun c c' => Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)
    (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inr c'))))

private theorem bmDPS_glueEidx_form_C1
    (n f r s : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))

    (hrs : r + s = n)
    {R r' : ℕ} (hR : R + 1 = r) (hr' : r' = 2 * s)
    (hB : ((∀ a a' : Fin (R+1), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR
        hr').symm (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n f) (Sum.inl
                a) (Sum.inl a') = 0) ∧
      (∀ b b' : Fin (R+1), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm
          (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n f) (Sum.inr
                  (Sum.inl b)) (Sum.inr (Sum.inl b')) = 0) ∧
      (∀ (a : Fin (R+1)) (c : Fin r'), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR
          hr').symm (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n
                  f) (Sum.inl a) (Sum.inr (Sum.inr c)) = 0) ∧
      (∀ (c : Fin r') (a : Fin (R+1)), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR
          hr').symm (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n
                  f) (Sum.inr (Sum.inr c)) (Sum.inl a) = 0) ∧
      (∀ (b : Fin (R+1)) (c : Fin r'), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR
          hr').symm (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n
                  f) (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inr c)) = 0) ∧
      (∀ (c : Fin r') (b : Fin (R+1)), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR
          hr').symm (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n
                  f) (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inl b)) = 0) ∧
      (∀ a b : Fin (R+1), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm
          (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n f) (Sum.inl
                  a) (Sum.inr (Sum.inl b)) = if a = b then 1 else 0)))
    : (∀ y : Matrix.SpecialLinearGroup (Fin (R+1)) (GaloisField 2 f),
        Matrix.transpose (Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr')
            (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr') (bmDPS_blockMat n f (R+1) r' y)) *
          bmDPS_J n f *
          Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr') (bmDPS_glueEidx n f r s
              Pe Bc (e := e) hrs hR hr') (bmDPS_blockMat n f (R+1) r' y) =
            bmDPS_J n f) := by
  intro y
  set eidx := bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr' with heidx
  have hJb := bmDPS_blockMat_Jb n f (R+1) r' eidx y hB
  have hre : Matrix.reindex eidx eidx (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) = bmDPS_J n
      f :=
    bmDPS_reindex_comp_symm f eidx.symm (bmDPS_J n f)
  calc Matrix.transpose (Matrix.reindex eidx eidx (bmDPS_blockMat n f (R+1) r' y)) *
        bmDPS_J n f * Matrix.reindex eidx eidx (bmDPS_blockMat n f (R+1) r' y)
      = Matrix.reindex eidx eidx (Matrix.transpose (bmDPS_blockMat n f (R+1) r' y)) *
        Matrix.reindex eidx eidx (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) *
        Matrix.reindex eidx eidx (bmDPS_blockMat n f (R+1) r' y) := by
          rw [Matrix.transpose_reindex, hre]
    _ = Matrix.reindex eidx eidx (Matrix.transpose (bmDPS_blockMat n f (R+1) r' y) *
        Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f) *
        bmDPS_blockMat n f (R+1) r' y) := by
          rw [← bmDPS_reindex_mul, ← bmDPS_reindex_mul]
    _ = Matrix.reindex eidx eidx (Matrix.reindex eidx.symm eidx.symm (bmDPS_J n f)) := by rw [hJb]
    _ = bmDPS_J n f := hre

private theorem bmDPS_castAdd_ne_natAdd {r s : ℕ} (a : Fin r) (d : Fin s) :
    (Fin.castAdd s a : Fin (r + s)) ≠ Fin.natAdd r d := by
  intro h
  have hv := congrArg Fin.val h
  simp only [Fin.val_castAdd, Fin.val_natAdd] at hv
  omega

private theorem bmDPS_glueEidx_form_C28
    (n f r s : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))

    (hrs : r + s = n)
    {R r' : ℕ} (hR : R + 1 = r) (hr' : r' = 2 * s)
    : ((∀ a a' : Fin (R+1), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm
        (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n f) (Sum.inl
                a) (Sum.inl a') = 0) ∧
      (∀ b b' : Fin (R+1), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm
          (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n f) (Sum.inr
                  (Sum.inl b)) (Sum.inr (Sum.inl b')) = 0) ∧
      (∀ (a : Fin (R+1)) (c : Fin r'), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR
          hr').symm (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n
                  f) (Sum.inl a) (Sum.inr (Sum.inr c)) = 0) ∧
      (∀ (c : Fin r') (a : Fin (R+1)), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR
          hr').symm (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n
                  f) (Sum.inr (Sum.inr c)) (Sum.inl a) = 0) ∧
      (∀ (b : Fin (R+1)) (c : Fin r'), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR
          hr').symm (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n
                  f) (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inr c)) = 0) ∧
      (∀ (c : Fin r') (b : Fin (R+1)), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR
          hr').symm (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n
                  f) (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inl b)) = 0) ∧
      (∀ a b : Fin (R+1), Matrix.reindex (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm
          (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr').symm (bmDPS_J n f) (Sum.inl
                  a) (Sum.inr (Sum.inl b)) = if a = b then 1 else 0)) := by
  set eidx := bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr' with heidx
  have h_inl : ∀ a : Fin (R+1),
      eidx (Sum.inl a) = Sum.inl (finCongr hrs (Fin.castAdd s (finCongr hR a))) := by
    intro a
    simp only [heidx, bmDPS_glueEidx, bmDPS_gluePerm, Equiv.trans_apply, Equiv.sumCongr_apply,
      Equiv.coe_fn_mk, Sum.map_inl, Sum.map_inr, finSumFinEquiv_apply_left]
  have h_inr_inl : ∀ b : Fin (R+1),
      eidx (Sum.inr (Sum.inl b)) = Sum.inr (finCongr hrs (Fin.castAdd s (finCongr hR b))) := by
    intro b
    simp only [heidx, bmDPS_glueEidx, bmDPS_gluePerm, Equiv.trans_apply, Equiv.sumCongr_apply,
      Equiv.coe_fn_mk, Sum.map_inl, Sum.map_inr, finSumFinEquiv_apply_left]
  have h_inr_inr_inl : ∀ (c : Fin r') (u : Fin s),
      finSumFinEquiv.symm (finCongr (hr'.trans (two_mul s)) c) = Sum.inl u →
      eidx (Sum.inr (Sum.inr c)) = Sum.inl (finCongr hrs (Fin.natAdd r u)) := by
    intro c u hc
    simp only [heidx, bmDPS_glueEidx, bmDPS_gluePerm, Equiv.trans_apply, Equiv.sumCongr_apply,
      Equiv.coe_fn_mk, Sum.map_inl, Sum.map_inr, hc, finSumFinEquiv_apply_right]
  have h_inr_inr_inr : ∀ (c : Fin r') (v : Fin s),
      finSumFinEquiv.symm (finCongr (hr'.trans (two_mul s)) c) = Sum.inr v →
      eidx (Sum.inr (Sum.inr c)) = Sum.inr (finCongr hrs (Fin.natAdd r v)) := by
    intro c v hc
    simp only [heidx, bmDPS_glueEidx, bmDPS_gluePerm, Equiv.trans_apply, Equiv.sumCongr_apply,
      Equiv.coe_fn_mk, Sum.map_inl, Sum.map_inr, hc, finSumFinEquiv_apply_right]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro a a'
    simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm, h_inl a, h_inl a']
    simp [bmDPS_J, Matrix.fromBlocks]
  · intro b b'
    simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm, h_inr_inl b,
      h_inr_inl b']
    simp [bmDPS_J, Matrix.fromBlocks]
  · intro a c
    simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm, h_inl a]
    rcases hc : finSumFinEquiv.symm (finCongr (hr'.trans (two_mul s)) c) with u | v
    · rw [h_inr_inr_inl c u hc]
      simp [bmDPS_J, Matrix.fromBlocks]
    · rw [h_inr_inr_inr c v hc]
      have hne : (Fin.cast hrs (Fin.castAdd s (Fin.cast hR a)) : Fin n) ≠
          Fin.cast hrs (Fin.natAdd r v) := by
        intro h
        exact bmDPS_castAdd_ne_natAdd (Fin.cast hR a) v (Fin.cast_injective hrs h)
      simp [bmDPS_J, hne]
  · intro c a
    simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm, h_inl a]
    rcases hc : finSumFinEquiv.symm (finCongr (hr'.trans (two_mul s)) c) with u | v
    · rw [h_inr_inr_inl c u hc]
      simp [bmDPS_J, Matrix.fromBlocks]
    · rw [h_inr_inr_inr c v hc]
      have hne : (Fin.cast hrs (Fin.natAdd r v) : Fin n) ≠
          Fin.cast hrs (Fin.castAdd s (Fin.cast hR a)) := by
        intro h
        exact (bmDPS_castAdd_ne_natAdd (Fin.cast hR a) v).symm (Fin.cast_injective hrs h)
      simp [bmDPS_J, hne]
  · intro b c
    simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm, h_inr_inl b]
    rcases hc : finSumFinEquiv.symm (finCongr (hr'.trans (two_mul s)) c) with u | v
    · rw [h_inr_inr_inl c u hc]
      have hne : (Fin.cast hrs (Fin.castAdd s (Fin.cast hR b)) : Fin n) ≠
          Fin.cast hrs (Fin.natAdd r u) := by
        intro h
        exact bmDPS_castAdd_ne_natAdd (Fin.cast hR b) u (Fin.cast_injective hrs h)
      simp [bmDPS_J, hne]
    · rw [h_inr_inr_inr c v hc]
      simp [bmDPS_J, Matrix.fromBlocks]
  · intro c b
    simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm, h_inr_inl b]
    rcases hc : finSumFinEquiv.symm (finCongr (hr'.trans (two_mul s)) c) with u | v
    · rw [h_inr_inr_inl c u hc]
      have hne : (Fin.cast hrs (Fin.natAdd r u) : Fin n) ≠
          Fin.cast hrs (Fin.castAdd s (Fin.cast hR b)) := by
        intro h
        exact (bmDPS_castAdd_ne_natAdd (Fin.cast hR b) u).symm (Fin.cast_injective hrs h)
      simp [bmDPS_J, hne]
    · rw [h_inr_inr_inr c v hc]
      simp [bmDPS_J, Matrix.fromBlocks]
  · intro a b
    simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm, h_inl a, h_inr_inl b]
    have hXY : (finCongr hrs (Fin.castAdd s (finCongr hR a)) : Fin n) =
        finCongr hrs (Fin.castAdd s (finCongr hR b)) ↔ a = b := by
      constructor
      · intro h
        have h1 : (Fin.castAdd s (finCongr hR a) : Fin (r + s)) =
            Fin.castAdd s (finCongr hR b) := (finCongr hrs).injective h
        have h2 : (finCongr hR a : Fin r) = finCongr hR b :=
          Fin.ext (by simpa only [Fin.val_castAdd] using congrArg Fin.val h1)
        exact (finCongr hR).injective h2
      · intro h; rw [h]
    simp only [bmDPS_J, Matrix.fromBlocks_apply₁₂, Matrix.one_apply, hXY]

private theorem bmDPS_glueEidx_form
    (n f r s : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))

    (hrs : r + s = n)
    {R r' : ℕ} (hR : R + 1 = r) (hr' : r' = 2 * s) :
    bmDPS_IsFormStandard n f (R + 1) r' (bmDPS_glueEidx n f r s Pe Bc (e := e) hrs hR hr') := by
  have hB := bmDPS_glueEidx_form_C28 n f r s Pe Bc (e := e) hrs hR hr'
  refine ⟨bmDPS_glueEidx_form_C1 n f r s Pe Bc (e := e) hrs hR hr' hB,
    hB.1, hB.2.1, hB.2.2.1, hB.2.2.2.1, hB.2.2.2.2.1, hB.2.2.2.2.2.1, hB.2.2.2.2.2.2⟩

private theorem bmDPS_natAdd_inj_iff {r s : ℕ} (u v : Fin s) :
    (Fin.natAdd r u : Fin (r + s)) = Fin.natAdd r v ↔ u = v := by
  constructor
  · intro h
    have hv := congrArg Fin.val h
    simp only [Fin.val_natAdd] at hv
    exact Fin.ext (by omega)
  · intro h; rw [h]

private theorem bmDPS_glueBcJ_apply_cast (s f : ℕ) {n' : ℕ} (h : n' = 2 * s) (i j : Fin n') :
    bmDPS_glueBcJ s f (Fin.cast h i) (Fin.cast h j) =
      bmDPS_J s f (finSumFinEquiv.symm (Fin.cast (h.trans (two_mul s)) i))
        (finSumFinEquiv.symm (Fin.cast (h.trans (two_mul s)) j)) := by
  simp only [bmDPS_glueBcJ, Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm,
    Equiv.trans_apply, Equiv.coe_fn_mk, finCongr_apply, Fin.cast_cast]

private theorem bmDPS_glueEidx_bc
    (n f r s : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (Fin n ⊕ Fin n) (Fin s ⊕ Fin s) (GaloisField 2 f))

    (hrs : r + s = n)
