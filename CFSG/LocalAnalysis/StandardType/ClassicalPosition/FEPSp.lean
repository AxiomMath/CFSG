private lemma fePSp_dualPair_case (n f : ℕ) (F : Type) [Field F]
    (hc : Nat.card F = 2 ^ f) [Finite F] [CharP F 2] (hf : 1 ≤ f) {X : Type} [Group X]
    (ψ : ↥(CFSG.Open.StatedSp n F) →* X) (hψ : ψ.ker ≤ Subgroup.center _)
    (S : Set (GL (Fin n ⊕ Fin n) F))
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F) (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    (hodd : ∀ s ∈ S, Odd (orderOf s)) {J' : Subgroup ↥(CFSG.Open.StatedSp n F)}
    {ε e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (hε : IsPrimAdjIdemIn (RingHom.id F) (fePSp_G n F)
      (Algebra.adjoin F (Units.val '' S)) ε)
    (hJε : IsComponentOf J' ⁅glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S ε,
      glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S ε⁆)
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e) (heε : e * ε = e)
    (hne : e ≠ ε) (hd : 2 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e) :
    GGSixLSevenFieldExtCase (J'.map ψ) .PSp f := by
  obtain ⟨heq, hpair⟩ := fePSp_dualPair_eps_eq hSU hS hε he heε hne
  have hJε' : IsComponentOf J' ⁅fePSp_Geps S e, fePSp_Geps S e⁆ := by
    simpa [fePSp_Geps, heq] using hJε
  have hnab : ¬ IsMulCommutative ↥(fePSp_Geps S e) := by
    intro hcomm
    have hbot : ⁅fePSp_Geps S e, fePSp_Geps S e⁆ = ⊥ := by
      rw [Subgroup.commutator_self_eq_bot_iff]
      exact hcomm
    have hJbot : J' = ⊥ := le_bot_iff.mp (by rw [hbot] at hJε'; exact hJε'.1)
    have hsimple : IsSimpleGroup (J' ⧸ Subgroup.center J') := hJε'.2.2.2
    haveI : Subsingleton (J' ⧸ Subgroup.center J') := by rw [hJbot]; infer_instance
    exact (not_subsingleton_iff_nontrivial.mpr hsimple.toNontrivial) inferInstance
  have hgl := fePSp_dualPair_glModel hc hSU hS hodd hε he heε hne hnab
  have hcomm := fePSp_dualPair_commutatorModel hc hSU hS hε he heε hne hd hgl
  have hJ := fePSp_dualPair_componentModel ψ hψ hJε' hcomm (by simpa using Nat.mul_le_mul hd hf)
  obtain ⟨m', hlt, hLM⟩ :=
    fePSp_dualPair_lieModelData hc ψ hd hJ
  refine ⟨.PSL, m', blockDegree (Algebra.adjoin F (Units.val '' S)) e * f, hlt, hLM, ?_⟩
  rintro ⟨-, -, h | h⟩ <;> exact absurd h (by decide)

private lemma fePSp_selfDual_blockDegree_even {n : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') (hodd : ∀ s ∈ S, Odd (orderOf s))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    (hd : 4 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e) :
    ∃ l : ℕ, blockDegree (Algebra.adjoin F (Units.val '' S)) e = 2 * l := by
  have hG : IsUnit (fePSp_G n F).det := fePSp_G_isUnit_det
  have hSG : ∀ s ∈ S, Matrix.transpose
      ((s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F).map (RingHom.id F)) * fePSp_G n F *
        (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) = fePSp_G n F := by
    intro s hs
    have h := CFSG.Open.StatedAPI.mem_statedSp_iff.mp (hSU s hs)
    rw [show (⇑(RingHom.id F) : F → F) = id from rfl, Matrix.map_id]
    simpa [fePSp_G] using h
  rcases blockDegree_eq_one_or_even_of_formAdj_eq
      hG hS hodd hSG he hadj with h1 | heven
  · omega
  · obtain ⟨l, hl⟩ := heven
    exact ⟨l, by omega⟩

private lemma fePSp_selfDual_blockFieldAndInvolution {n f : ℕ} {F : Type} [Field F] [Finite F]
    [CharP F 2] (hc : Nat.card F = 2 ^ f) {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') (hodd : ∀ s ∈ S, Odd (orderOf s))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    (hd : 4 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e) :
    ∃ (K : Type) (_ : Field K) (_ : Algebra F K) (_ : Finite K) (l : ℕ),
      blockDegree (Algebra.adjoin F (Units.val '' S)) e = 2 * l ∧
      Nat.card K = (2 ^ (l * f)) ^ 2 ∧
      Module.finrank F K = blockDegree (Algebra.adjoin F (Units.val '' S)) e ∧
      ∃ π : Algebra.adjoin F (Units.val '' S) →ₐ[F] K,
        Function.Surjective π ∧
        (∀ a, π a = 0 ↔ (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e = 0) := by
  obtain ⟨l, hl⟩ := fePSp_selfDual_blockDegree_even hSU hS hodd he hadj hd
  obtain ⟨K, hKf, hKa, hKfin, hcard, π, hπ, hker, hfin⟩ :=
    fePSp_dualPair_blockField hc hS hodd he
  exact ⟨K, hKf, hKa, hKfin, l, hl, by
    rw [hcard, hl, show (2 * l) * f = (l * f) * 2 by ring, pow_mul], hfin, π, hπ, hker⟩

private lemma fePSp_selfDual_formAdj_mem {n : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
