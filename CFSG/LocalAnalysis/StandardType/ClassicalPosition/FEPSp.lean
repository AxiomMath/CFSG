private lemma fePSp_dualPair_blockRestrict_wittMatrix_mul_inv {n : ℕ} {F : Type} [Field F]
    [Finite F] [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') (hSU : ∀ s ∈ S, s ∈
        CFSG.Open.StatedSp n F)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hpair : formAdj (RingHom.id F) (fePSp_G n F) e ≠ e)
    (K : Type) [Field K] [Algebra F K]
    (W : Type) [AddCommGroup W] [Module F W] [Module K W] [IsScalarTower F K W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (σ : W ≃ₗ[K] W) :
    fePSp_dualPair_blockRestrict_wittMatrix K W eW
        σ *
      fePSp_dualPair_blockRestrict_wittMatrixInv K W eW σ = 1 := by
  obtain ⟨h_eQ, h_Qe, h_er, h_Qr, h_re, h_rQ, h_rr, h_sum⟩ :=
    fePSp_dualPair_blockRestrict_wittMatrix_orthogonal hS hSU he hpair
  have hG : IsUnit (fePSp_G n F).det := fePSp_G_isUnit_det
  set A := LinearMap.toMatrix'
    (fePSp_dualPair_blockRestrict_wittA K W eW σ)
        with hA
  set Ainv := LinearMap.toMatrix'
    (fePSp_dualPair_blockRestrict_wittAinv K W eW
        σ) with hAinv
  set Q := formAdj (RingHom.id F) (fePSp_G n F) e with hQ
  set C := formAdj (RingHom.id F) (fePSp_G n F) A with hC
  set B := formAdj (RingHom.id F) (fePSp_G n F) Ainv with hB
  set r := 1 - (e + Q) with hr
  have hAAinv : A * Ainv = e := by
    rw [hA, hAinv, ← LinearMap.toMatrix'_comp,
      fePSp_dualPair_blockRestrict_wittA_comp_wittAinv he K W eW σ,
      LinearMap.toMatrix'_toLin']
  have hAblock : A = e * A * e := by
    rw [hA]
    exact fePSp_dualPair_blockRestrict_wittA_eq_block he K W eW σ
  have hAinvblock : Ainv = e * Ainv * e := by
    rw [hAinv]
    exact fePSp_dualPair_blockRestrict_wittAinv_eq_block he K W eW σ
  have hCblock : C = Q * C * Q := by
    calc C = formAdj (RingHom.id F) (fePSp_G n F) A := hC
      _ = formAdj (RingHom.id F) (fePSp_G n F) (e * A * e) := congrArg (formAdj (RingHom.id F)
          (fePSp_G n F)) hAblock
      _ = formAdj (RingHom.id F) (fePSp_G n F) e * formAdj (RingHom.id F) (fePSp_G n F) A *
            formAdj (RingHom.id F) (fePSp_G n F) e := by
          rw [Geo.formAdj_mul (RingHom.id F) hG, Geo.formAdj_mul (RingHom.id F) hG]
          noncomm_ring
      _ = Q * C * Q := by rw [hQ, hC]
  have hBblock : B = Q * B * Q := by
    calc B = formAdj (RingHom.id F) (fePSp_G n F) Ainv := hB
      _ = formAdj (RingHom.id F) (fePSp_G n F) (e * Ainv * e) := congrArg (formAdj (RingHom.id F)
          (fePSp_G n F)) hAinvblock
      _ = formAdj (RingHom.id F) (fePSp_G n F) e * formAdj (RingHom.id F) (fePSp_G n F) Ainv *
            formAdj (RingHom.id F) (fePSp_G n F) e := by
          rw [Geo.formAdj_mul (RingHom.id F) hG, Geo.formAdj_mul (RingHom.id F) hG]
          noncomm_ring
      _ = Q * B * Q := by rw [hQ, hB]
  have hBC : B * C = Q := by
    rw [hB, hC, ← Geo.formAdj_mul (RingHom.id F) hG, hAAinv, hQ]
  have hAC : A * C = 0 := by
    rw [hAblock, hCblock]
    calc (e * A * e) * (Q * C * Q) = e * A * (e * Q) * C * Q := by noncomm_ring
      _ = 0 := by rw [h_eQ]; simp
  have hAr : A * r = 0 := by
    rw [hAblock]
    calc (e * A * e) * r = e * A * (e * r) := by noncomm_ring
      _ = 0 := by rw [h_er]; simp
  have hBAinv : B * Ainv = 0 := by
    rw [hBblock, hAinvblock]
    calc (Q * B * Q) * (e * Ainv * e) = Q * B * (Q * e) * Ainv * e := by noncomm_ring
      _ = 0 := by rw [h_Qe]; simp
  have hBr : B * r = 0 := by
    rw [hBblock]
    calc (Q * B * Q) * r = Q * B * (Q * r) := by noncomm_ring
      _ = 0 := by rw [h_Qr]; simp
  have hrAinv : r * Ainv = 0 := by
    rw [hAinvblock]
    calc r * (e * Ainv * e) = (r * e) * Ainv * e := by noncomm_ring
      _ = 0 := by rw [h_re]; simp
  have hrC : r * C = 0 := by
    rw [hCblock]
    calc r * (Q * C * Q) = (r * Q) * C * Q := by noncomm_ring
      _ = 0 := by rw [h_rQ]; simp
  have hrr : r * r = r := by rw [hr]; exact h_rr
  have hsum : e + Q + r = 1 := by rw [hr]; exact h_sum
  rw [fePSp_dualPair_blockRestrict_wittMatrix, fePSp_dualPair_blockRestrict_wittMatrixInv,
    ← hA, ← hAinv, ← hB, ← hC, ← hQ, ← hr]
  calc (A + B + r) * (Ainv + C + r)
      = A * Ainv + A * C + A * r + B * Ainv + B * C + B * r + r * Ainv + r * C + r * r := by
        noncomm_ring
    _ = e + Q + r := by rw [hAAinv, hAC, hAr, hBAinv, hBC, hBr, hrAinv, hrC, hrr]; simp
    _ = 1 := hsum

