      Nonempty (↥(fePSp_Geps S e) ≃* Matrix.GeneralLinearGroup (Fin m') K) := by
  obtain ⟨-, hpair⟩ := fePSp_dualPair_eps_eq hSU hS hε he heε hne
  obtain ⟨K, hKf, hKa, hKfin, hcard, π, hπ, hker, hfin⟩ :=
    fePSp_dualPair_blockField hc hS hodd he
  obtain ⟨m', hm', hiso⟩ :=
    fePSp_dualPair_glOfBlockK hS hSU he hpair K π hπ hker hfin hnab
