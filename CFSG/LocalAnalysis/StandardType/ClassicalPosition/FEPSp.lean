private lemma fePSp_dualPair_blockRestrict_wittMatrix_complement_commute {n : ℕ} {F : Type} [Field
    F]
    [Finite F] [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') (hSU : ∀ s ∈ S, s ∈
        CFSG.Open.StatedSp n F)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e) :
    ∀ a : Algebra.adjoin F (Units.val '' S),
      Commute (1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e))
        (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) := by
  intro a
  have hG : IsUnit (fePSp_G n F).det := fePSp_G_isUnit_det
  have hSU' : ∀ s ∈ S, Matrix.transpose
      ((s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F).map (RingHom.id F)) * fePSp_G n F *
        (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) = fePSp_G n F := by
    intro s hs
    have h := CFSG.Open.StatedAPI.mem_statedSp_iff.mp (hSU s hs)
    rw [show (⇑(RingHom.id F) : F → F) = id from rfl, Matrix.map_id]
    simpa [fePSp_G] using h
  have hQ : formAdj (RingHom.id F) (fePSp_G n F) e ∈ Algebra.adjoin F (Units.val '' S) :=
    Geo.formAdj_mem_adjoin (RingHom.id F) hG hSU' he.1
  have hr : 1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e) ∈
      Algebra.adjoin F (Units.val '' S) :=
    Subalgebra.sub_mem _ (Subalgebra.one_mem _) (Subalgebra.add_mem _ he.1 hQ)
  exact fePSp_adjoin_comm hS hr a.2

