section
open CFSG.LieType.SemisimpleCentralizers.Held (heldGU heldSU)

private lemma fePSp_selfDual_unitaryBlockHeldGUCommutator {f : ℕ} {K : Type} [Field K] [Finite K] {l
    : ℕ}
    (hK : Nat.card K = (2 ^ (l * f)) ^ 2)
    (σ : K ≃+* K) (hσ2 : σ ^ 2 = 1) (hσne : σ ≠ 1)
    (m' : ℕ) (H : Subgroup (GL (Fin m') K)) (hm' : 1 ≤ m') (hq : 4 ≤ 2 ^ (l * f))
    (hGU : Nonempty (↥H ≃* ↥(CFSG.LieType.SemisimpleCentralizers.Held.heldGU m' K σ
      (fun x => by
        have h := congrArg (fun e : K ≃+* K => e x) hσ2
        simpa [pow_two] using h)))) :
    Nonempty (CFSG.Open.StatedSU m' (2 ^ (l * f)) K ≃* ↥(⁅H, H⁆)) := by
  classical
  haveI : Fintype K := Fintype.ofFinite K
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : CharP K 2 := CFSG.ClassicalGroups.Unitary.charP_of_card_sq (p := 2) (f := l * f) hK
  have hτ : ∀ x : K, σ (σ x) = x := fun x => by
    have h := congrArg (fun e : K ≃+* K => e x) hσ2
    simpa [pow_two] using h
  have hτQ : ∀ x : K, σ x = x ^ (2 ^ (l * f)) := by
    obtain ⟨r, hr, hσr⟩ :=
      CFSG.ProperTwoGeneratedCore.Lemma37.exists_mul_self_eq_card_of_ringEquiv (K := K) σ hσne
        (by simpa [pow_two] using hσ2)
    have hrq : r = 2 ^ (l * f) := by
      refine Nat.mul_self_inj.mp ?_
      rw [hr, ← Nat.card_eq_fintype_card, hK, pow_two]
    intro x
    rw [hσr x, hrq]
  have hperf : Group.IsPerfect ↥(heldSU m' K σ hτ) := by
    rcases Nat.lt_or_ge m' 3 with hm | hm
    · have h12 : m' = 1 ∨ m' = 2 := by omega
      rcases h12 with rfl | rfl
      · rw [CFSG.LieType.SemisimpleCentralizers.Held.hct_heldSU_eq_statedSU (a := 1)
          (Q := 2 ^ (l * f)) (M := K) (τ := σ) (hτ := hτ) hτQ]
        haveI : Subsingleton ↥(CFSG.Open.StatedSL 1 K) :=
          CFSG.LieType.SemisimpleCentralizers.Held.hct_subsingleton_statedSL_of_le_one
            (K := K) (d := 1) (by norm_num)
        refine Group.isPerfect_def.mpr (le_antisymm le_top ?_)
        intro x _
        have hx : x = 1 := by
          refine Subtype.ext ?_
          have h1 : (⟨x.1, CFSG.Open.StatedAPI.statedSU_le_statedSL 1 (2 ^ (l * f)) K x.2⟩ :
              ↥(CFSG.Open.StatedSL 1 K)) = ⟨1, Subgroup.one_mem _⟩ := Subsingleton.elim _ _
          exact congrArg (fun y : ↥(CFSG.Open.StatedSL 1 K) => (y : GL (Fin 1) K)) h1
        rw [hx]
        exact Subgroup.one_mem _
      · rw [CFSG.LieType.SemisimpleCentralizers.Held.hct_heldSU_eq_statedSU (a := 2)
          (Q := 2 ^ (l * f)) (M := K) (τ := σ) (hτ := hτ) hτQ]
        exact CFSG.RankThree.SubgroupLists.isPerfect_statedSU_two (K := K) (r := 2) (f := l * f)
          hK hq
    · rw [CFSG.LieType.SemisimpleCentralizers.Held.hct_heldSU_eq_statedSU (a := m')
        (Q := 2 ^ (l * f)) (M := K) (τ := σ) (hτ := hτ) hτQ]
      exact CFSG.ClassicalGroups.Unitary.isPerfect_statedSU (K := K) (p := 2) (f := l * f) hK hm
        (by
          intro hcon
          have h2 : 2 ^ (l * f) = 2 := (Prod.mk.inj hcon).2
          omega)
  have hcomm : ⁅(heldGU m' K σ hτ : Subgroup (GL (Fin m') K)), heldGU m' K σ hτ⁆ =
      heldSU m' K σ hτ :=
    CFSG.StandardType.GGNbrLSideKit.commutator_heldGU_eq_heldSU_of_isPerfect (r := m') (E := K)
      (τ := σ) (hτ := hτ) hperf
  have hSUeq : heldSU m' K σ hτ = CFSG.Open.StatedSU m' (2 ^ (l * f)) K :=
    CFSG.LieType.SemisimpleCentralizers.Held.hct_heldSU_eq_statedSU (a := m') (Q := 2 ^ (l * f))
      (M := K) (τ := σ) (hτ := hτ) hτQ
  obtain ⟨eGU⟩ := hGU
  have hmap : (commutator ↥H).map (eGU : ↥H →* ↥(heldGU m' K σ hτ)) =
      commutator ↥(heldGU m' K σ hτ) := by
    have h := Subgroup.map_commutator (⊤ : Subgroup ↥H) (⊤ : Subgroup ↥H)
      (eGU : ↥H →* ↥(heldGU m' K σ hτ))
    have htop : (⊤ : Subgroup ↥H).map (eGU : ↥H →* ↥(heldGU m' K σ hτ)) = ⊤ := by
      rw [Subgroup.map_top, MonoidHom.range_eq_top]
      exact eGU.surjective
    rw [htop] at h
    simpa [_root_.commutator_def] using h
  let e1 : ↥(commutator ↥H) ≃* ↥(commutator ↥(heldGU m' K σ hτ)) :=
    (Subgroup.equivMapOfInjective (commutator ↥H) (eGU : ↥H →* ↥(heldGU m' K σ hτ))
      eGU.injective).trans (MulEquiv.subgroupCongr hmap)
  let cA : ↥(commutator ↥H) ≃* ↥(⁅H, H⁆) :=
    (Subgroup.equivMapOfInjective (commutator ↥H) H.subtype H.subtype_injective).trans
      (MulEquiv.subgroupCongr (Subgroup.map_subtype_commutator H))
  let cG : ↥(commutator ↥(heldGU m' K σ hτ)) ≃*
      ↥⁅(heldGU m' K σ hτ : Subgroup (GL (Fin m') K)), heldGU m' K σ hτ⁆ :=
    (Subgroup.equivMapOfInjective (commutator ↥(heldGU m' K σ hτ)) (heldGU m' K σ hτ).subtype
      (heldGU m' K σ hτ).subtype_injective).trans
      (MulEquiv.subgroupCongr (Subgroup.map_subtype_commutator (heldGU m' K σ hτ)))
  let tG : ↥(commutator ↥(heldGU m' K σ hτ)) ≃* ↥(heldSU m' K σ hτ) :=
    cG.trans (MulEquiv.subgroupCongr hcomm)
  exact ⟨(MulEquiv.subgroupCongr hSUeq).symm.trans (tG.symm.trans (e1.symm.trans cA))⟩

end

private lemma fePSp_selfDual_unitaryBlockCommutator {f : ℕ}
    {K : Type} [Field K] [Finite K] {l : ℕ}
