private lemma fePSp_selfDual_unitaryBlockExtension_mul_inv {n : ℕ} {F : Type} [Field F]
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F} (he : IsIdempotentElem e)
    {K : Type} [Field K] [Algebra F K]
    {W : Type} [AddCommGroup W] [Module F W] [Module K W] [IsScalarTower F K W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e))) (g : W ≃ₗ[K] W) :
    fePSp_selfDual_unitaryBlockExtensionMatrix eW g *
      fePSp_selfDual_unitaryBlockExtensionMatrixInv eW g = 1 := by
  have htoP : Matrix.toLin' (fePSp_selfDual_unitaryBlockExtensionMatrix eW g) =
      fePSp_selfDual_unitaryBlockExtensionBlockMap eW g +
