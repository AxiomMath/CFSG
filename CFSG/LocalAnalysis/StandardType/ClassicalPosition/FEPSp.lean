private lemma fePSp_selfDual_unitaryBlockIsometryHeldGU_beta_sum_left_apply {K : Type} [Field K]
    {W : Type} [AddCommGroup W] [Module K W] {m' : ℕ}
    (σ : K ≃+* K) (β : W → W → K)
    (hadd : ∀ (w1 w2 w3 : W), β (w1 + w2) w3 = β w1 w3 + β w2 w3)
    (hsmul : ∀ (w1 w2 : W) (k : K), β (k • w1) w2 = σ k * β w1 w2)
    (a : Fin m' → K) (v : Fin m' → W) (w : W) :
    β (∑ k : Fin m', a k • v k) w = ∑ k : Fin m', σ (a k) * β (v k) w := by
  classical
  have h0 : β 0 w = 0 := by
    have h := hadd 0 0 w
    rw [add_zero] at h
    have h' : β 0 w + β 0 w = β 0 w := h.symm
    exact add_right_cancel (by rw [zero_add]; exact h')
  have h : ∀ s : Finset (Fin m'),
      β (∑ k ∈ s, a k • v k) w = ∑ k ∈ s, σ (a k) * β (v k) w := by
    intro s
    induction s using Finset.induction_on with
    | empty => rw [Finset.sum_empty, Finset.sum_empty]; exact h0
    | insert k s hk ih =>
        rw [Finset.sum_insert hk, Finset.sum_insert hk, hadd, hsmul, ih]
  simpa using h Finset.univ

private lemma fePSp_selfDual_unitaryBlockIsometryHeldGU_beta_sum_right_apply {K : Type} [Field K]
    {W : Type} [AddCommGroup W] [Module K W] {m' : ℕ}
    (β : W → W → K)
    (hadd : ∀ (w1 w2 w3 : W), β w1 (w2 + w3) = β w1 w2 + β w1 w3)
    (hsmul : ∀ (w1 w2 : W) (k : K), β w1 (k • w2) = k * β w1 w2)
    (c : Fin m' → K) (v : Fin m' → W) (w : W) :
    β w (∑ l : Fin m', c l • v l) = ∑ l : Fin m', c l * β w (v l) := by
  classical
  have h0 : β w 0 = 0 := by
    have h := hadd w 0 0
    rw [add_zero] at h
    have h' : β w 0 + β w 0 = β w 0 := h.symm
    exact add_right_cancel (by rw [zero_add]; exact h')
  have h : ∀ s : Finset (Fin m'),
      β w (∑ l ∈ s, c l • v l) = ∑ l ∈ s, c l * β w (v l) := by
    intro s
    induction s using Finset.induction_on with
    | empty => rw [Finset.sum_empty, Finset.sum_empty]; exact h0
    | insert l s hl ih =>
        rw [Finset.sum_insert hl, Finset.sum_insert hl, hadd, hsmul, ih]
  simpa using h Finset.univ

private lemma fePSp_selfDual_unitaryBlockIsometryHeldGU_le_range_isometry {n : ℕ} {F : Type}
    [Field F] {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    {K : Type} [Field K]
    (σ : K ≃+* K) (hσ2 : σ ^ 2 = 1)
    (m' : ℕ) (W : Type) [AddCommGroup W] [Module K W]
    (f : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e) →* (W ≃ₗ[K] W))
    (β : W → W → K)
    (hβ : (∀ (x : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) (w1 w2 : W),
        β ((f x) w1) ((f x) w2) = β w1 w2) ∧
      (∀ (w1 w2 w3 : W), β (w1 + w2) w3 = β w1 w3 + β w2 w3) ∧
      (∀ (w1 w2 w3 : W), β w1 (w2 + w3) = β w1 w2 + β w1 w3) ∧
      (∀ (w1 w2 : W) (k : K), β (k • w1) w2 = σ k * β w1 w2) ∧
      (∀ (w1 w2 : W) (k : K), β w1 (k • w2) = k * β w1 w2) ∧
      (∀ w1 : W, (∀ w2 : W, β w1 w2 = 0) → w1 = 0))
    (b : Module.Basis (Fin m') K W)
    (hb : ∀ i j : Fin m', β (b i) (b j) = if i = j then (1 : K) else 0) :
    ∀ A ∈ CFSG.LieType.SemisimpleCentralizers.Held.heldGU m' K σ
        (fePSp_selfDual_unitaryBlockIsometryHeldGU_tau σ hσ2),
      ∀ w1 w2 : W, β (((fePSp_selfDual_unitaryBlockMatrixEquiv b).symm A) w1)
          (((fePSp_selfDual_unitaryBlockMatrixEquiv b).symm A) w2) = β w1 w2 := by
  intro A hA w1 w2
  rw [CFSG.LieType.SemisimpleCentralizers.Held.mem_heldGU] at hA
  set φ : W ≃ₗ[K] W := (fePSp_selfDual_unitaryBlockMatrixEquiv b).symm A with hφ
  have hAφ : (fePSp_selfDual_unitaryBlockMatrixEquiv b φ : GL (Fin m') K) = A := by
    rw [hφ]; exact MulEquiv.apply_symm_apply _ _
  have hbase : ∀ i j : Fin m', β (φ (b i)) (φ (b j)) = β (b i) (b j) := by
    intro i j
    rw [fePSp_selfDual_unitaryBlockIsometryHeldGU_matrixEquiv_apply_basis m' W b φ i,
      fePSp_selfDual_unitaryBlockIsometryHeldGU_matrixEquiv_apply_basis m' W b φ j]
    rw [fePSp_selfDual_unitaryBlockIsometryHeldGU_beta_basis_expand σ m' W f β hβ b hb
      (fun k => ((fePSp_selfDual_unitaryBlockMatrixEquiv b φ : GL (Fin m') K) :
        Matrix (Fin m') (Fin m') K) k i)
      (fun l => ((fePSp_selfDual_unitaryBlockMatrixEquiv b φ : GL (Fin m') K) :
        Matrix (Fin m') (Fin m') K) l j)]
    rw [hAφ]
    rw [← fePSp_selfDual_unitaryBlockIsometryHeldGU_matrix_mul_apply
      (A : Matrix (Fin m') (Fin m') K) (⇑σ) i j]
    rw [hA, Matrix.one_apply, hb i j]
  have hphi1 : φ w1 = ∑ i, b.repr w1 i • φ (b i) := by
    conv_lhs => rw [← b.sum_repr w1]
    rw [map_sum]
    simp only [map_smul]
  have hphi2 : φ w2 = ∑ j, b.repr w2 j • φ (b j) := by
    conv_lhs => rw [← b.sum_repr w2]
    rw [map_sum]
    simp only [map_smul]
  calc β (φ w1) (φ w2)
      = β (∑ i, b.repr w1 i • φ (b i)) (∑ j, b.repr w2 j • φ (b j)) := by
          rw [hphi1, hphi2]
    _ = ∑ i, σ (b.repr w1 i) * β (φ (b i)) (∑ j, b.repr w2 j • φ (b j)) :=
          fePSp_selfDual_unitaryBlockIsometryHeldGU_beta_sum_left_apply σ β hβ.2.1 hβ.2.2.2.1
            (fun i => b.repr w1 i) (fun i => φ (b i)) (∑ j, b.repr w2 j • φ (b j))
    _ = ∑ i, σ (b.repr w1 i) * (∑ j, b.repr w2 j * β (φ (b i)) (φ (b j))) := by
          apply Finset.sum_congr rfl
          intro i _
          rw [fePSp_selfDual_unitaryBlockIsometryHeldGU_beta_sum_right_apply β hβ.2.2.1
            hβ.2.2.2.2.1 (fun j => b.repr w2 j) (fun j => φ (b j)) (φ (b i))]
    _ = ∑ i, σ (b.repr w1 i) * (∑ j, b.repr w2 j * β (b i) (b j)) := by
          apply Finset.sum_congr rfl
          intro i _
          congr 1
          apply Finset.sum_congr rfl
          intro j _
          rw [hbase i j]
    _ = ∑ i, σ (b.repr w1 i) * β (b i) w2 := by
          apply Finset.sum_congr rfl
          intro i _
          congr 1
          rw [← fePSp_selfDual_unitaryBlockIsometryHeldGU_beta_sum_right_apply β hβ.2.2.1
            hβ.2.2.2.2.1 (fun j => b.repr w2 j) b (b i), b.sum_repr w2]
    _ = β w1 w2 := by
          rw [← fePSp_selfDual_unitaryBlockIsometryHeldGU_beta_sum_left_apply σ β hβ.2.1
            hβ.2.2.2.1 (fun i => b.repr w1 i) b w2, b.sum_repr w1]

