private lemma fePSp_dualPair_blockRestrict_fix_block {n : ℕ} {F : Type} [Field F] {S : Set (GL (Fin
    n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (K : Type) [Field K]
    (W : Type) [AddCommGroup W] [Module F W] [Module K W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (f : ↥(fePSp_Geps S e) →* (W ≃ₗ[K] W))
    (hf : fePSp_dualPair_blockActionProp K W eW f)
    (u : ↥(fePSp_Geps S e)) (hu : f u = 1) :
    (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e = e := by
  apply Matrix.toLin'.injective
  apply LinearMap.ext
  intro x
  rw [Matrix.toLin'_apply, Matrix.toLin'_apply]
  have hv : e *ᵥ x ∈ LinearMap.range (Matrix.toLin' e) := ⟨x, by rw [Matrix.toLin'_apply]⟩
  have h := hf u (eW.symm ⟨e *ᵥ x, hv⟩)
  rw [hu] at h
  have h' : (e *ᵥ x : (Fin n ⊕ Fin n) → F) =
      (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ (e *ᵥ x) := by
    simpa using h
  rw [Matrix.mulVec_mulVec x _ e] at h'
  exact h'.symm

private lemma fePSp_dualPair_blockRestrict_fix_dual {n : ℕ} {F : Type} [Field F] [Finite F]
    [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    (u : ↥(fePSp_Geps S e))
    (hu : (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e = e) :
    (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * formAdj (RingHom.id F) (fePSp_G n F) e =
      formAdj (RingHom.id F) (fePSp_G n F) e := by
  let G : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F := fePSp_G n F
  let u_GL : GL (Fin n ⊕ Fin n) F :=
    ((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F)
  let estar : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F := formAdj (RingHom.id F) G e
  have hG : IsUnit G.det := fePSp_G_isUnit_det
  have hSU' : ∀ s ∈ S, Matrix.transpose ((s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F).map
      (RingHom.id F)) * G * (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) = G := by
    intro s hs
    have h := CFSG.Open.StatedAPI.mem_statedSp_iff.mp (hSU s hs)
    simpa [G, fePSp_G] using h
  have hestarA : estar ∈ Algebra.adjoin F (Units.val '' S) :=
    Geo.formAdj_mem_adjoin (RingHom.id F) hG hSU' he.1
  have hiso_u : Matrix.transpose ((u_GL : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)) * G *
      (u_GL : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) = G := by
    have h := CFSG.Open.StatedAPI.mem_statedSp_iff.mp u.1.2
    simpa [G, u_GL, fePSp_G] using h
  have hu_inv : formAdj (RingHom.id F) G (u_GL : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) =
      ((u_GL⁻¹ : GL (Fin n ⊕ Fin n) F) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) :=
    Geo.formAdj_eq_inv_of_isometry (RingHom.id F) hG u_GL hiso_u
  have hcomm : (u_GL : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * estar =
      estar * (u_GL : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) :=
    fePSp_dualPair_blockActionCompat u estar hestarA
  have h1 : estar * ((u_GL⁻¹ : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) = estar := by
    have h := congrArg (formAdj (RingHom.id F) G) hu
    rw [Geo.formAdj_mul (RingHom.id F) hG, hu_inv] at h
    exact h
  have huu : ((u_GL⁻¹ : GL (Fin n ⊕ Fin n) F) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
      (u_GL : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) = 1 := by
    rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
  have h2 : estar = estar * (u_GL : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) := by
    have h := congrArg (fun y : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F => y *
      (u_GL : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)) h1
    rw [Matrix.mul_assoc, huu, Matrix.mul_one] at h
    exact h
  rw [← hcomm] at h2
  exact h2.symm

private lemma fePSp_dualPair_blockRestrict_eq_one {n : ℕ} {F : Type} [Field F] [Finite F]
    [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    (u : ↥(fePSp_Geps S e))
    (hu : (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e = e) :
    u = 1 := by
  let estar : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
    formAdj (RingHom.id F) (fePSp_G n F) e
  have hfix_estar : (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * estar = estar :=
    fePSp_dualPair_blockRestrict_fix_dual he hSU u hu
  have hfix_one : (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * (1 - (e + estar)) = 1 - (e + estar) := by
    have h := u.2
    change (u : ↥(CFSG.Open.StatedSp n F)) ∈
      (Subgroup.centralizer S ⊓ glFixing (1 - (e + estar))).comap
        (CFSG.Open.StatedSp n F).subtype at h
    exact (Subgroup.mem_inf.mp (Subgroup.mem_comap.mp h)).2
  apply Subtype.ext
  apply Subtype.ext
  apply Units.ext
  change (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
    Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) = 1
  calc (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
      = (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
          Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * 1 := (Matrix.mul_one _).symm
    _ = (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
          Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
          (e + estar + (1 - (e + estar))) := by rw [add_sub_cancel]
    _ = 1 := by
        rw [Matrix.mul_add, Matrix.mul_add, hu, hfix_estar, hfix_one, add_sub_cancel]

private lemma fePSp_dualPair_blockRestrict_injective {n : ℕ} {F : Type} [Field F] [Finite F]
    [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (K : Type) [Field K]
