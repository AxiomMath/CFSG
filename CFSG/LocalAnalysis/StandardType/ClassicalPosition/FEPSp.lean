  intro w
  apply eW.injective
  apply Subtype.ext
  rw [hf ⟨⟨fePSp_dualPair_blockRestrict_extensionGL hS hSU he hpair K π W eW hact σ,
      fePSp_dualPair_blockRestrict_extension_isometry hS hSU he hpair K π W eW hact σ⟩,
      fePSp_dualPair_blockRestrict_extension_mem hS hSU he hpair K π W
          eW hact σ⟩ w]
  rw [← Matrix.toLin'_apply]
  have h1 : Matrix.toLin' (((fePSp_dualPair_blockRestrict_extensionGL hS hSU he hpair K π W eW hact
      σ : GL (Fin n ⊕ Fin n) F) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕
