          (fePSp_selfDual_unitaryBlockExtensionCompl e y)) = 0 := by
  intro x y
  have hcompl : fePSp_selfDual_unitaryBlockExtensionCompl e y = (1 - e) *ᵥ y := by
    rw [fePSp_selfDual_unitaryBlockExtensionCompl, LinearMap.sub_apply, LinearMap.id_apply,
      Matrix.toLin'_apply e y, Matrix.sub_mulVec, Matrix.one_mulVec]
  have hblock : fePSp_selfDual_unitaryBlockExtensionBlockMap eW g x =
      e *ᵥ fePSp_selfDual_unitaryBlockExtensionBlockMap eW g x := by
    simp only [fePSp_selfDual_unitaryBlockExtensionBlockMap, LinearMap.comp_apply,
      LinearMap.coe_restrictScalars]
    rw [← Matrix.toLin'_apply, ← fePSp_dualPair_blockRestrict_mulE_coe,
      fePSp_selfDual_unitaryBlockExtension_mulE_subtype he.2.1 eW
        ((eW : W →ₗ[F] LinearMap.range (Matrix.toLin' e))
          ((g : W →ₗ[K] W) ((eW.symm : LinearMap.range (Matrix.toLin' e) →ₗ[F] W)
            (fePSp_dualPair_blockRestrict_mulE (n := n) (F := F) (e := e) x))))]
    rfl
  rw [hblock, hcompl]
  exact fePSp_selfDual_unitaryBlockExtensionUnit_e_orthogonal he hadj
    (fePSp_selfDual_unitaryBlockExtensionBlockMap eW g x) y

private lemma fePSp_selfDual_unitaryBlockExtensionUnit_compl_block {n : ℕ} {F : Type}
    [Field F] [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    {K : Type} [Field K] [Algebra F K] (W : Type) [AddCommGroup W] [Module F W] [Module K W]
        [IsScalarTower F K W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (g : W ≃ₗ[K] W) :
∀ x y : (Fin n ⊕ Fin n) → F,
      (fePSp_selfDual_unitaryBlockExtensionCompl e x) ⬝ᵥ (fePSp_G n F *ᵥ
          (fePSp_selfDual_unitaryBlockExtensionBlockMap eW g y)) = 0 := by
  intro x y
  have hcompl : fePSp_selfDual_unitaryBlockExtensionCompl e x = (1 - e) *ᵥ x := by
    rw [fePSp_selfDual_unitaryBlockExtensionCompl, LinearMap.sub_apply, LinearMap.id_apply,
      Matrix.toLin'_apply e x, Matrix.sub_mulVec, Matrix.one_mulVec]
  have hblock : fePSp_selfDual_unitaryBlockExtensionBlockMap eW g y =
      e *ᵥ fePSp_selfDual_unitaryBlockExtensionBlockMap eW g y := by
    simp only [fePSp_selfDual_unitaryBlockExtensionBlockMap, LinearMap.comp_apply,
      LinearMap.coe_restrictScalars]
    rw [← Matrix.toLin'_apply, ← fePSp_dualPair_blockRestrict_mulE_coe,
      fePSp_selfDual_unitaryBlockExtension_mulE_subtype he.2.1 eW
        ((eW : W →ₗ[F] LinearMap.range (Matrix.toLin' e))
          ((g : W →ₗ[K] W) ((eW.symm : LinearMap.range (Matrix.toLin' e) →ₗ[F] W)
            (fePSp_dualPair_blockRestrict_mulE (n := n) (F := F) (e := e) y))))]
    rfl
  have hsymm : ∀ a b : (Fin n ⊕ Fin n) → F,
      a ⬝ᵥ (fePSp_G n F *ᵥ b) = b ⬝ᵥ (fePSp_G n F *ᵥ a) := by
    intro a b
    rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, dotProduct_comm,
      show (fePSp_G n F)ᵀ = fePSp_G n F from fePSp_G_transpose]
  rw [hcompl, hblock, hsymm ((1 - e) *ᵥ x)
    (e *ᵥ fePSp_selfDual_unitaryBlockExtensionBlockMap eW g y)]
  exact fePSp_selfDual_unitaryBlockExtensionUnit_e_orthogonal he hadj
    (fePSp_selfDual_unitaryBlockExtensionBlockMap eW g y) x

private lemma fePSp_selfDual_unitaryBlockExtensionUnit_e_adjoint {n : ℕ} {F : Type}
    [Field F] [CharP F 2] {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e) :
    ∀ u v : (Fin n ⊕ Fin n) → F,
      (e *ᵥ u) ⬝ᵥ (fePSp_G n F *ᵥ v) = u ⬝ᵥ (fePSp_G n F *ᵥ (e *ᵥ v)) := by
  have hG : IsUnit (fePSp_G n F).det := fePSp_G_isUnit_det
  have hGG : fePSp_G n F * (fePSp_G n F)⁻¹ = 1 := Matrix.mul_nonsing_inv (A := fePSp_G n F) hG
  have heTG : Matrix.transpose e * fePSp_G n F = fePSp_G n F * e := by
    have h := hadj
    simp only [formAdj] at h
    have hmap : e.map (RingHom.id F) = e := by ext i j; simp
    rw [hmap] at h
    have hmul := congrArg (fun m => fePSp_G n F * m) h
    rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, hGG, Matrix.one_mul] at hmul
    exact hmul
  have hdot : ∀ (A : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) (x y : (Fin n ⊕ Fin n) → F),
      (A *ᵥ x) ⬝ᵥ y = x ⬝ᵥ (Matrix.transpose A *ᵥ y) := by
    intro A x y
    rw [dotProduct_comm, Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, dotProduct_comm]
  intro u v
  rw [hdot e u (fePSp_G n F *ᵥ v), Matrix.mulVec_mulVec, heTG, ← Matrix.mulVec_mulVec]

private lemma fePSp_selfDual_unitaryBlockExtensionUnit_compl_adjoint {n : ℕ} {F : Type}
    [Field F] [CharP F 2] {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e) :
    ∀ u v : (Fin n ⊕ Fin n) → F,
      ((1 - e) *ᵥ u) ⬝ᵥ (fePSp_G n F *ᵥ v) =
        u ⬝ᵥ (fePSp_G n F *ᵥ ((1 - e) *ᵥ v)) := by
  intro u v
  simp only [Matrix.sub_mulVec, Matrix.one_mulVec, sub_dotProduct, Matrix.mulVec_sub,
    dotProduct_sub, fePSp_selfDual_unitaryBlockExtensionUnit_e_adjoint hadj u v]

private lemma fePSp_selfDual_unitaryBlockExtensionUnit_compl_compl {n : ℕ} {F : Type}
    [Field F] [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e) :
∀ x y : (Fin n ⊕ Fin n) → F,
      (fePSp_selfDual_unitaryBlockExtensionCompl e x) ⬝ᵥ (fePSp_G n F *ᵥ
          (fePSp_selfDual_unitaryBlockExtensionCompl e y)) = x ⬝ᵥ (fePSp_G n F *ᵥ y) -
        ((LinearMap.range (Matrix.toLin' e)).subtype (fePSp_dualPair_blockRestrict_mulE (n := n) (F
            := F) (e := e) x)) ⬝ᵥ (fePSp_G n F *ᵥ ((LinearMap.range (Matrix.toLin' e)).subtype
                (fePSp_dualPair_blockRestrict_mulE (n := n) (F := F) (e := e) y))) := by
  intro x y
  have hcompl : ∀ z : (Fin n ⊕ Fin n) → F,
      fePSp_selfDual_unitaryBlockExtensionCompl e z = (1 - e) *ᵥ z := by
    intro z
    rw [fePSp_selfDual_unitaryBlockExtensionCompl, LinearMap.sub_apply, LinearMap.id_apply,
      Matrix.toLin'_apply e z, Matrix.sub_mulVec, Matrix.one_mulVec]
  have hS : ∀ z : (Fin n ⊕ Fin n) → F,
      (LinearMap.range (Matrix.toLin' e)).subtype
        (fePSp_dualPair_blockRestrict_mulE (n := n) (F := F) (e := e) z) = e *ᵥ z := by
    intro z
    change (fePSp_dualPair_blockRestrict_mulE (n := n) (F := F) (e := e) z :
      (Fin n ⊕ Fin n) → F) = e *ᵥ z
    rw [fePSp_dualPair_blockRestrict_mulE_coe, Matrix.toLin'_apply e z]
  have h1 : (e *ᵥ x) ⬝ᵥ (fePSp_G n F *ᵥ y) =
      x ⬝ᵥ (fePSp_G n F *ᵥ (e *ᵥ y)) :=
    fePSp_selfDual_unitaryBlockExtensionUnit_e_adjoint hadj x y
  have hzero : (1 - e) *ᵥ (e *ᵥ y) = 0 := by
    have hm : (1 - e) * e = 0 := by
      rw [Matrix.sub_mul, Matrix.one_mul, show e * e = e from he.2.1, sub_self]
    rw [Matrix.mulVec_mulVec, hm]
    simp
  have h2 : x ⬝ᵥ (fePSp_G n F *ᵥ (e *ᵥ y)) =
      (e *ᵥ x) ⬝ᵥ (fePSp_G n F *ᵥ (e *ᵥ y)) := by
    have h := fePSp_selfDual_unitaryBlockExtensionUnit_compl_adjoint hadj x (e *ᵥ y)
    rw [hzero, Matrix.mulVec_zero, dotProduct_zero] at h
    rw [Matrix.sub_mulVec, Matrix.one_mulVec, sub_dotProduct] at h
    exact sub_eq_zero.mp h
  rw [hcompl x, hcompl y, hS x, hS y]
  simp only [Matrix.sub_mulVec, Matrix.one_mulVec, Matrix.mulVec_sub, sub_dotProduct,
    dotProduct_sub]
  rw [h1, h2]
  ring

private lemma fePSp_selfDual_unitaryBlockExtensionUnit_preservesB {n : ℕ} {F : Type}
    [Field F] [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    {K : Type} [Field K] [Algebra F K] (W : Type) [AddCommGroup W] [Module F W] [Module K W]
        [IsScalarTower F K W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (β : W → W → K)
    (hSpec : ∀ x y : W, (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
        (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F)) = Algebra.trace F K (β x y))
    (g : W ≃ₗ[K] W) (hg : ∀ w1 w2 : W, β (g w1) (g w2) = β w1 w2) :
    ∀ x y : (Fin n ⊕ Fin n) → F,
      (Matrix.toLin'
          ((fePSp_selfDual_unitaryBlockExtensionUnit he.2.1 eW g :
            GL (Fin n ⊕ Fin n) F) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) x) ⬝ᵥ
        (fePSp_G n F *ᵥ (Matrix.toLin'
          ((fePSp_selfDual_unitaryBlockExtensionUnit he.2.1 eW g :
            GL (Fin n ⊕ Fin n) F) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) y)) =
      x ⬝ᵥ (fePSp_G n F *ᵥ y) := by
  have hto : Matrix.toLin' ((fePSp_selfDual_unitaryBlockExtensionUnit he.2.1 eW g : GL (Fin n ⊕ Fin
      n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) = fePSp_selfDual_unitaryBlockExtensionBlockMap eW g
          + fePSp_selfDual_unitaryBlockExtensionCompl e := by
    change Matrix.toLin' (fePSp_selfDual_unitaryBlockExtensionMatrix eW g) =
      fePSp_selfDual_unitaryBlockExtensionBlockMap eW g +
        fePSp_selfDual_unitaryBlockExtensionCompl e
    rw [fePSp_selfDual_unitaryBlockExtensionMatrix, map_add, Matrix.toLin'_toMatrix', map_sub,
      Matrix.toLin'_one]
    rfl
  intro x y
  rw [hto]
  change (fePSp_selfDual_unitaryBlockExtensionBlockMap eW g x +
      fePSp_selfDual_unitaryBlockExtensionCompl e x) ⬝ᵥ (fePSp_G n F *ᵥ
          (fePSp_selfDual_unitaryBlockExtensionBlockMap eW g y +
              fePSp_selfDual_unitaryBlockExtensionCompl e y)) = x ⬝ᵥ (fePSp_G n F *ᵥ y)
  simp only [Matrix.mulVec_add, dotProduct_add, add_dotProduct]
  rw [fePSp_selfDual_unitaryBlockExtensionUnit_block_block W eW β hSpec g hg x y,
    fePSp_selfDual_unitaryBlockExtensionUnit_block_compl he hadj W eW g x y,
    fePSp_selfDual_unitaryBlockExtensionUnit_compl_block he hadj W eW g x y,
    fePSp_selfDual_unitaryBlockExtensionUnit_compl_compl he hadj x y]
  abel

private lemma fePSp_selfDual_unitaryBlockExtensionUnit_apply_eq_dot {n : ℕ} {F : Type} [Field F]
    (A : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) (i j : Fin n ⊕ Fin n) :
