private lemma fePSp_selfDual_unitaryBlockExtensionUnit_e_orthogonal {n : ℕ} {F : Type}
    [Field F] [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e) :
    ∀ u z : (Fin n ⊕ Fin n) → F,
      (e *ᵥ u) ⬝ᵥ (fePSp_G n F *ᵥ ((1 - e) *ᵥ z)) = 0 := by
  intro u z
  have hG : IsUnit (fePSp_G n F).det := fePSp_G_isUnit_det
  have hGG : fePSp_G n F * (fePSp_G n F)⁻¹ = 1 := Matrix.mul_nonsing_inv (A := fePSp_G n F) hG
  have heTG : Matrix.transpose e * fePSp_G n F = fePSp_G n F * e := by
    have h := hadj
    simp only [formAdj] at h
    have hmap : e.map (RingHom.id F) = e := by ext i j; simp
    rw [hmap] at h
    have hmul := congrArg (fun m => fePSp_G n F * m) h
    rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, hGG, Matrix.one_mul] at hmul
    exact hmul
  have heid : e * e = e := he.2.1
  have hzero : e *ᵥ ((1 - e) *ᵥ z) = 0 := by
    rw [Matrix.mulVec_mulVec, Matrix.mul_sub, Matrix.mul_one, heid, sub_self]
    simp
  have hdot : ∀ (A : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) (x y : (Fin n ⊕ Fin n) → F),
      (A *ᵥ x) ⬝ᵥ y = x ⬝ᵥ (Matrix.transpose A *ᵥ y) := by
    intro A x y
    rw [dotProduct_comm, Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose,
      dotProduct_comm]
  calc (e *ᵥ u) ⬝ᵥ (fePSp_G n F *ᵥ ((1 - e) *ᵥ z))
      = u ⬝ᵥ (Matrix.transpose e *ᵥ (fePSp_G n F *ᵥ ((1 - e) *ᵥ z))) := hdot e u _
    _ = u ⬝ᵥ ((Matrix.transpose e * fePSp_G n F) *ᵥ ((1 - e) *ᵥ z)) := by
          rw [Matrix.mulVec_mulVec]
    _ = u ⬝ᵥ ((fePSp_G n F * e) *ᵥ ((1 - e) *ᵥ z)) := by rw [heTG]
    _ = u ⬝ᵥ (fePSp_G n F *ᵥ (e *ᵥ ((1 - e) *ᵥ z))) := by rw [← Matrix.mulVec_mulVec]
    _ = u ⬝ᵥ (fePSp_G n F *ᵥ 0) := by rw [hzero]
    _ = 0 := by simp

