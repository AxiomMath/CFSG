    (hpair : formAdj (RingHom.id F) (fePSp_G n F) e ≠ e)
    (K : Type) [Field K] [Algebra F K] [Finite K]
    (π : Algebra.adjoin F (Units.val '' S) →ₐ[F] K) (hπ : Function.Surjective π)
    (hker : ∀ a, π a = 0 ↔ (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e = 0)
    (hfin : Module.finrank F K = blockDegree (Algebra.adjoin F (Units.val '' S)) e)
    (hnab : ¬ IsMulCommutative ↥(fePSp_Geps S e)) :
    ∃ m' : ℕ, 2 ≤ m' ∧
      Nonempty (↥(fePSp_Geps S e) ≃* Matrix.GeneralLinearGroup (Fin m') K) := by
  obtain ⟨W, hWac, hWF, hWK, hTower, hWfd, m', -, -, hWdimK, -, ⟨eW⟩⟩ :=
    fePSp_dualPair_blockAction hS hSU he hpair K π hπ hker hfin
  obtain ⟨m'', hm'', ⟨eGL⟩⟩ := fePSp_dualPair_linearGroupEquiv K W
  have hEq : m'' = m' := by rw [hm'', hWdimK]
  rw [hEq] at eGL
  have hiso : Nonempty (↥(fePSp_Geps S e) ≃* Matrix.GeneralLinearGroup (Fin m') K) :=
    ⟨eW.trans eGL⟩
  exact ⟨m', fePSp_dualPair_blockNontrivial K m' hiso hnab, hiso⟩

