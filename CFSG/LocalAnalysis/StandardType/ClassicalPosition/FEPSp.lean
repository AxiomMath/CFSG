    (hact : ∀ (a : Algebra.adjoin F (Units.val '' S)) (w : W),
      eW ((π a) • w) = (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
        (eW w : (Fin n ⊕ Fin n) → F))
    (f : ↥(fePSp_Geps S e) →* (W ≃ₗ[K] W))
    (hf : fePSp_dualPair_blockActionProp K W eW f) (σ : W ≃ₗ[K] W) :
