private lemma fePSp_dualPair_blockRestrict_wittMatrix_orthogonal {n : ℕ} {F : Type} [Field F]
    [Finite F] [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') (hSU : ∀ s ∈ S, s ∈
        CFSG.Open.StatedSp n F)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hpair : formAdj (RingHom.id F) (fePSp_G n F) e ≠ e) :
    e * formAdj (RingHom.id F) (fePSp_G n F) e = 0 ∧
    formAdj (RingHom.id F) (fePSp_G n F) e * e = 0 ∧
    e * (1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e)) = 0 ∧
    formAdj (RingHom.id F) (fePSp_G n F) e *
      (1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e)) = 0 ∧
    (1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e)) * e = 0 ∧
    (1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e)) *
      formAdj (RingHom.id F) (fePSp_G n F) e = 0 ∧
    (1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e)) *
      (1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e)) =
        (1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e)) ∧
    e + formAdj (RingHom.id F) (fePSp_G n F) e +
      (1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e)) = 1 := by
  have hG : IsUnit (fePSp_G n F).det := fePSp_G_isUnit_det
  have hGh : Matrix.transpose ((fePSp_G n F).map (RingHom.id F)) = fePSp_G n F :=
    fePSp_G_transpose
  have hSU' : ∀ s ∈ S, Matrix.transpose
      ((s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F).map (RingHom.id F)) * fePSp_G n F *
        (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) = fePSp_G n F := by
    intro s hs
    have h := CFSG.Open.StatedAPI.mem_statedSp_iff.mp (hSU s hs)
    rw [show (⇑(RingHom.id F) : F → F) = id from rfl, Matrix.map_id]
    simpa [fePSp_G] using h
  obtain ⟨heQ, hQe⟩ :=
    Geo.mul_formAdj_eq_zero_of_dualPair (RingHom.id F) (fun _ => rfl) hG hGh hSU' hS he hpair
  have hee : e * e = e := he.2.1.eq
  have hQQ : formAdj (RingHom.id F) (fePSp_G n F) e *
      formAdj (RingHom.id F) (fePSp_G n F) e = formAdj (RingHom.id F) (fePSp_G n F) e := by
    rw [← Geo.formAdj_mul (RingHom.id F) hG e e, hee]
  have hε : (e + formAdj (RingHom.id F) (fePSp_G n F) e) *
      (e + formAdj (RingHom.id F) (fePSp_G n F) e) =
        e + formAdj (RingHom.id F) (fePSp_G n F) e := by
    rw [Matrix.add_mul, Matrix.mul_add, Matrix.mul_add, hee, heQ, hQe, hQQ, add_zero, zero_add]
  refine ⟨heQ, hQe, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [Matrix.mul_sub, Matrix.mul_one, Matrix.mul_add, hee, heQ, add_zero, sub_self]
  · rw [Matrix.mul_sub, Matrix.mul_one, Matrix.mul_add, hQe, hQQ, zero_add, sub_self]
  · rw [Matrix.sub_mul, Matrix.one_mul, Matrix.add_mul, hee, hQe, add_zero, sub_self]
  · rw [Matrix.sub_mul, Matrix.one_mul, Matrix.add_mul, heQ, hQQ, zero_add, sub_self]
  · have hsq : (1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e)) *
        (1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e)) =
        1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e) -
          (e + formAdj (RingHom.id F) (fePSp_G n F) e) +
          (e + formAdj (RingHom.id F) (fePSp_G n F) e) *
            (e + formAdj (RingHom.id F) (fePSp_G n F) e) := by noncomm_ring
    rw [hsq, hε]
