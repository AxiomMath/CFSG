    _ = (um * (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)) *ᵥ
          (eW w : (Fin n ⊕ Fin n) → F) :=
        Matrix.mulVec_mulVec (eW w : (Fin n ⊕ Fin n) → F) um _
    _ = ((a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * um) *ᵥ
          (eW w : (Fin n ⊕ Fin n) → F) := by
        rw [fePSp_selfDual_blockActionCompat g (a : Matrix _ _ F) a.2]
    _ = (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
          (um *ᵥ (eW w : (Fin n ⊕ Fin n) → F)) :=
        (Matrix.mulVec_mulVec (eW w : (Fin n ⊕ Fin n) → F) _ um).symm
    _ = (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
          (eW ((fePSp_selfDual_blockActionMap_rangeEquiv he W eW g) w) :
            (Fin n ⊕ Fin n) → F) := by
        rw [fePSp_selfDual_blockActionMap_rangeEquiv_prop he W eW g w]
    _ = eW ((π a) • (fePSp_selfDual_blockActionMap_rangeEquiv he W eW g) w) :=
        (hact a ((fePSp_selfDual_blockActionMap_rangeEquiv he W eW g) w)).symm

