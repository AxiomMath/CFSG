  refine ⟨b, ?_⟩
  have hEq : f.range.map (fePSp_selfDual_unitaryBlockMatrixEquiv b).toMonoidHom =
      CFSG.LieType.SemisimpleCentralizers.Held.heldGU m' K σ
        (fePSp_selfDual_unitaryBlockIsometryHeldGU_tau σ hσ2) := by
    apply le_antisymm
    · intro A hA
      exact fePSp_selfDual_unitaryBlockIsometryHeldGU_range_le σ hσ2 m' W f β hβ b hb A hA
    · intro A hA
      exact fePSp_selfDual_unitaryBlockIsometryHeldGU_le_range σ hσ2 m' W f β hβ b hb hext A hA
  rw [hEq]
  exact ⟨MulEquiv.refl _⟩

private lemma fePSp_selfDual_unitaryBlockIsometryRankBound {n : ℕ} {F : Type} [Field F] {S : Set (GL
    (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    {K : Type} [Field K]
    (m' : ℕ) (W : Type) [AddCommGroup W] [Module F W] [Module K W]
    [FiniteDimensional K W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (hW : Module.finrank K W = m') :
    1 ≤ m' := by
  have hne : (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) ≠ 0 := he.2.2.1
  have hto : Matrix.toLin' e ≠ 0 :=
    fun h => hne (Matrix.toLin'.injective (by rw [h, map_zero]))
  obtain ⟨v, hv⟩ : ∃ v : (Fin n ⊕ Fin n) → F, Matrix.toLin' e v ≠ 0 := by
    by_contra h
    push Not at h
    exact hto (LinearMap.ext h)
  let w : W := eW.symm ⟨Matrix.toLin' e v, ⟨v, rfl⟩⟩
  have hw : w ≠ 0 := by
    intro h
    apply hv
    have hv' := congrArg (fun w => (eW w : (Fin n ⊕ Fin n) → F)) h
    simpa [w] using hv'
  have hpos : 0 < Module.finrank K W := Module.finrank_pos_iff_exists_ne_zero.mpr ⟨w, hw⟩
  omega

private lemma fePSp_selfDual_unitaryBlockIsometryImage {n : ℕ} {F : Type} [Field F] {S : Set (GL
    (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    {K : Type} [Field K] [Finite K]
    (σ : K ≃+* K) (hσ2 : σ ^ 2 = 1) (hσne : σ ≠ 1)
    (m' : ℕ) (W : Type) [AddCommGroup W] [Module F W] [Module K W]
    [FiniteDimensional K W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (f : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e) →* (W ≃ₗ[K] W))
    (hf : Function.Injective f)
    (hW : Module.finrank K W = m')
    (β : W → W → K)
    (hβ : (∀ (x : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) (w1 w2 : W),
        β ((f x) w1) ((f x) w2) = β w1 w2) ∧
      (∀ (w1 w2 w3 : W), β (w1 + w2) w3 = β w1 w3 + β w2 w3) ∧
      (∀ (w1 w2 w3 : W), β w1 (w2 + w3) = β w1 w2 + β w1 w3) ∧
      (∀ (w1 w2 : W) (k : K), β (k • w1) w2 = σ k * β w1 w2) ∧
      (∀ (w1 w2 : W) (k : K), β w1 (k • w2) = k * β w1 w2) ∧
      (∀ w1 : W, (∀ w2 : W, β w1 w2 = 0) → w1 = 0))
    (hsym : ∀ w1 w2 : W, β w1 w2 = σ (β w2 w1))
    (hext : ∀ g : W ≃ₗ[K] W, (∀ w1 w2 : W, β (g w1) (g w2) = β w1 w2) → g ∈ f.range) :
    ∃ (H : Subgroup (GL (Fin m') K)),
      1 ≤ m' ∧
      Nonempty (↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e) ≃* ↥H) ∧
      Nonempty (↥H ≃* ↥(CFSG.LieType.SemisimpleCentralizers.Held.heldGU m' K σ
        (fun x => by
          have h := congrArg (fun e : K ≃+* K => e x) hσ2
          simpa [pow_two] using h))) := by
  obtain ⟨b, hb⟩ :=
    fePSp_selfDual_unitaryBlockIsometryHeldGU (K := K) σ hσ2
      hσne m' W f hW β hβ hsym hext
  exact ⟨f.range.map (fePSp_selfDual_unitaryBlockMatrixEquiv b).toMonoidHom,
    fePSp_selfDual_unitaryBlockIsometryRankBound (K := K) he m' W eW hW,
    fePSp_selfDual_unitaryBlockIsometryReindex (K := K) m' W f hf b,
    hb⟩

