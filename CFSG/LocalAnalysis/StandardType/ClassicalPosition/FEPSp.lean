    (fePSp_selfDual_formAdj_mem hSU b.2)
    (fePSp_selfDual_formAdj_mem hSU a.2)

private lemma fePSp_selfDual_formAdj_commutes {n : ℕ} {F : Type} [Field F] [Finite F]
    [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F) (c : F) :
    (⟨formAdj (RingHom.id F) (fePSp_G n F)
        ((algebraMap F (Algebra.adjoin F (Units.val '' S)) c : Algebra.adjoin F (Units.val '' S)) :
            Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F),
        fePSp_selfDual_formAdj_mem hSU (Subalgebra.algebraMap_mem _ c)⟩ : Algebra.adjoin
            F (Units.val '' S)) =
      algebraMap F (Algebra.adjoin F (Units.val '' S)) c := by
  apply Subtype.ext
  change formAdj (RingHom.id F) (fePSp_G n F)
      (((algebraMap F (Algebra.adjoin F (Units.val '' S)) c :
        Algebra.adjoin F (Units.val '' S)) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)) =
    ((algebraMap F (Algebra.adjoin F (Units.val '' S)) c :
      Algebra.adjoin F (Units.val '' S)) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
  rw [Algebra.algebraMap_eq_smul_one, Subalgebra.coe_smul, Subalgebra.coe_one,
    Geo.formAdj_smul, Geo.formAdj_one (RingHom.id F) fePSp_G_isUnit_det, RingHom.id_apply]

private lemma fePSp_selfDual_formAdj_involutive {n : ℕ} {F : Type} [Field F] [Finite F]
    [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F) (a : Algebra.adjoin F (Units.val '' S)) :
    (⟨formAdj (RingHom.id F) (fePSp_G n F)
        ((⟨formAdj (RingHom.id F) (fePSp_G n F) (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F),
          fePSp_selfDual_formAdj_mem hSU a.2⟩ : Algebra.adjoin F (Units.val '' S)) :
              Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F),
        fePSp_selfDual_formAdj_mem hSU
          (fePSp_selfDual_formAdj_mem hSU a.2)⟩ : Algebra.adjoin F (Units.val '' S)) = a
              := by
  apply Subtype.ext
  change formAdj (RingHom.id F) (fePSp_G n F)
      (formAdj (RingHom.id F) (fePSp_G n F) (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)) =
    (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
  exact Geo.formAdj_formAdj (RingHom.id F) (fun _ => rfl) fePSp_G_isUnit_det fePSp_G_transpose
    (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)

private lemma fePSp_selfDual_formAdj_algEquiv {n : ℕ} {F : Type} [Field F] [Finite F]
    [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') :
    ∃ φ : Algebra.adjoin F (Units.val '' S) ≃ₐ[F] Algebra.adjoin F (Units.val '' S),
      (∀ a, (φ a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) = formAdj (RingHom.id F) (fePSp_G n F)
          a) ∧
      (∀ a, φ (φ a) = a) := by
  have hmem : ∀ a ∈ Algebra.adjoin F (Units.val '' S),
      formAdj (RingHom.id F) (fePSp_G n F) a ∈ Algebra.adjoin F (Units.val '' S) :=
    fun a ha => fePSp_selfDual_formAdj_mem hSU ha
  let φ : Algebra.adjoin F (Units.val '' S) →ₐ[F] Algebra.adjoin F (Units.val '' S) :=
    { toFun := fun a => ⟨formAdj (RingHom.id F) (fePSp_G n F) a, hmem a a.2⟩
      map_one' := fePSp_selfDual_formAdj_map_one hSU
      map_mul' := fun a b => fePSp_selfDual_formAdj_map_mul hSU hS a b
      map_zero' := fePSp_selfDual_formAdj_map_zero hSU
      map_add' := fun a b => fePSp_selfDual_formAdj_map_add hSU a b
      commutes' := fun c => fePSp_selfDual_formAdj_commutes hSU c }
  have hφ2 : ∀ a, φ (φ a) = a := fun a => fePSp_selfDual_formAdj_involutive hSU a
  let Φ : Algebra.adjoin F (Units.val '' S) ≃ₐ[F] Algebra.adjoin F (Units.val '' S) :=
    AlgEquiv.ofAlgHom φ φ (AlgHom.ext hφ2) (AlgHom.ext hφ2)
  exact ⟨Φ, fun a => rfl, hφ2⟩
private lemma fePSp_selfDual_formAdj_ker {n : ℕ} {F : Type} [Field F] [CharP F 2]
    {S : Set (GL (Fin n ⊕ Fin n) F)} {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    {K : Type} [Field K] [Algebra F K]
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    (π : Algebra.adjoin F (Units.val '' S) →ₐ[F] K)
    (hker : ∀ a, π a = 0 ↔ (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e = 0)
    (φ : Algebra.adjoin F (Units.val '' S) ≃ₐ[F] Algebra.adjoin F (Units.val '' S))
    (hφ : ∀ a, (φ a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) = formAdj (RingHom.id F) (fePSp_G n
        F) a) :
    ∀ a, π a = 0 → π (φ a) = 0 := by
  intro a ha
  rw [hker, hφ a]
  have hae : (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e = 0 := (hker a).mp ha
  have hcomm : (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
        (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) =
        (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
        (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) :=
    fePSp_adjoin_comm hS he.1 a.2
  rw [show formAdj (RingHom.id F) (fePSp_G n F) (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e =
      formAdj (RingHom.id F) (fePSp_G n F) (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
        formAdj (RingHom.id F) (fePSp_G n F) e from by rw [hadj],
    ← Geo.formAdj_mul (RingHom.id F) fePSp_G_isUnit_det, hcomm, hae]
  unfold formAdj; simp

private lemma fePSp_selfDual_formAdj_descends {n : ℕ} {F : Type} [Field F] {S : Set (GL (Fin n ⊕ Fin
    n) F)}
    {K : Type} [Field K] [Algebra F K]
    (π : Algebra.adjoin F (Units.val '' S) →ₐ[F] K) (hπ : Function.Surjective π)
    (φ : Algebra.adjoin F (Units.val '' S) ≃ₐ[F] Algebra.adjoin F (Units.val '' S))
    (hφker : ∀ a, π a = 0 → π (φ a) = 0)
    (hφ2 : ∀ a, φ (φ a) = a) :
    ∃ σ : K ≃+* K, σ ^ 2 = 1 ∧
      (∀ c : F, σ (algebraMap F K c) = algebraMap F K c) ∧
      (∀ a, σ (π a) = π (φ a)) := by
  have hπ' : Function.Surjective (π : Algebra.adjoin F (Units.val '' S) →+* K) := hπ
  have hg : RingHom.ker (π : Algebra.adjoin F (Units.val '' S) →+* K) ≤
      RingHom.ker ((π : Algebra.adjoin F (Units.val '' S) →+* K).comp
        (φ : Algebra.adjoin F (Units.val '' S) →+* Algebra.adjoin F (Units.val '' S))) := by
    intro a ha
    rw [RingHom.mem_ker] at ha ⊢
    exact hφker a ha
  let τ : K →+* K := (RingHom.liftOfSurjective (f := (π : Algebra.adjoin F (Units.val '' S) →+* K))
      hπ')
    ⟨(π : Algebra.adjoin F (Units.val '' S) →+* K).comp
        (φ : Algebra.adjoin F (Units.val '' S) →+* Algebra.adjoin F (Units.val '' S)), hg⟩
  have hτ : ∀ a, τ (π a) = π (φ a) := by
    intro a
    dsimp only [τ]
    change ((RingHom.liftOfSurjective (f := (π : Algebra.adjoin F (Units.val '' S) →+* K)) hπ')
        ⟨(π : Algebra.adjoin F (Units.val '' S) →+* K).comp
          (φ : Algebra.adjoin F (Units.val '' S) →+* Algebra.adjoin F (Units.val '' S)), hg⟩)
      ((π : Algebra.adjoin F (Units.val '' S) →+* K) a) = π (φ a)
    rw [RingHom.liftOfSurjective_comp_apply, RingHom.comp_apply]
    rfl
  have hinv : ∀ x, τ (τ x) = x := by
    intro x
    obtain ⟨a, rfl⟩ := hπ x
    rw [hτ, hτ, hφ2]
  have hbij : Function.Bijective τ := by
    refine ⟨?_, ?_⟩
    · intro x y hxy
      have := congrArg τ hxy
      rwa [hinv, hinv] at this
    · intro y
      exact ⟨τ y, hinv y⟩
  let σ : K ≃+* K := RingEquiv.ofBijective τ hbij
  have hσπ : ∀ a, σ (π a) = π (φ a) := by
    intro a
    change τ (π a) = π (φ a)
    exact hτ a
  have hsq : ∀ x, σ (σ x) = x := by
    intro x
    change τ (τ x) = x
    exact hinv x
  refine ⟨σ, ?_, ?_, hσπ⟩
  · ext x
    change σ (σ x) = x
    exact hsq x
  · intro c
    rw [← AlgHom.commutes π c, hσπ,
      AlgEquiv.commutes φ c, AlgHom.commutes π c]

private lemma fePSp_selfDual_adjointInvolution {n : ℕ} {F : Type} [Field F] [Finite F]
    [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    {K : Type} [Field K] [Algebra F K] [Finite K] {l : ℕ}
    (hdeg : blockDegree (Algebra.adjoin F (Units.val '' S)) e = 2 * l)
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    (hfin : Module.finrank F K = blockDegree (Algebra.adjoin F (Units.val '' S)) e)
    (π : Algebra.adjoin F (Units.val '' S) →ₐ[F] K)
    (hπ : Function.Surjective π)
    (hker : ∀ a, π a = 0 ↔ (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e = 0) :
    ∃ σ : K ≃+* K, σ ^ 2 = 1 ∧ σ ≠ 1 ∧
      (∀ c : F, σ (algebraMap F K c) = algebraMap F K c) ∧
      (∀ a : Algebra.adjoin F (Units.val '' S), σ (π a) = π ⟨formAdj (RingHom.id F) (fePSp_G n F) a,
          fePSp_selfDual_formAdj_mem hSU a.2⟩) := by
  obtain ⟨φ, hφ, hφ2⟩ := fePSp_selfDual_formAdj_algEquiv hSU hS
  have hφker : ∀ a, π a = 0 → π (φ a) = 0 :=
    fePSp_selfDual_formAdj_ker hS he hadj π hker φ hφ
  obtain ⟨σ, hσ2, hσalg, hσπ⟩ :=
    fePSp_selfDual_formAdj_descends π hπ φ hφker hφ2
  refine ⟨σ, hσ2, ?_, hσalg, ?_⟩
  swap
  · intro a
    rw [hσπ a]
    exact congrArg π (Subtype.ext (hφ a))
  intro hσ1
  have hSU' : ∀ s ∈ S, Matrix.transpose
      ((s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F).map (RingHom.id F)) * fePSp_G n F *
        (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) = fePSp_G n F := by
    intro s hs
    have h := CFSG.Open.StatedAPI.mem_statedSp_iff.mp (hSU s hs)
    rw [show (⇑(RingHom.id F) : F → F) = id from rfl, Matrix.map_id]
    simpa [fePSp_G] using h
  have hgen : ∀ (s : GL (Fin n ⊕ Fin n) F) (hs : s ∈ S),
      π (⟨(s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F),
        Algebra.subset_adjoin (show (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) ∈
          Units.val '' S from ⟨s, hs, rfl⟩)⟩ : Algebra.adjoin F (Units.val '' S)) = 1 := by
    intro s hs
    let a : Algebra.adjoin F (Units.val '' S) :=
      ⟨(s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F),
        Algebra.subset_adjoin (show (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) ∈
          Units.val '' S from ⟨s, hs, rfl⟩)⟩
    have hφa : (φ a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) =
        ((s⁻¹ : GL (Fin n ⊕ Fin n) F) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) := by
      rw [hφ a, show (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) =
          (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) from rfl]
      exact Geo.formAdj_eq_inv_of_isometry (RingHom.id F) fePSp_G_isUnit_det s (hSU' s hs)
    have hprod : a * φ a = 1 := by
      apply Subtype.ext
      change (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
          (φ a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) =
        (1 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
      rw [show (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) =
          (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) from rfl, hφa,
        ← Units.val_mul, mul_inv_cancel, Units.val_one]
    have heq : π (φ a) = π a := by
      have h := hσπ a
      rw [hσ1] at h
      exact h.symm
    have hsq : π a * π a = 1 := by
      have hsq' : π a * π (φ a) = 1 := by rw [← map_mul, hprod, map_one]
      rwa [heq] at hsq'
    haveI : CharP K 2 := charP_of_injective_algebraMap' F 2
    have hx2 : (π a) ^ 2 = 1 := by rw [pow_two]; exact hsq
    rcases (sq_eq_one_iff.mp hx2) with h | h
    · exact h
    · rw [h]
      exact CharTwo.neg_eq 1
  let N : Submodule F K := Submodule.span F ({1} : Set K)
  have hP : ∀ a : Algebra.adjoin F (Units.val '' S), π a ∈ N := by
    intro a
    change π (⟨(a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F), a.2⟩ :
      Algebra.adjoin F (Units.val '' S)) ∈ N
    refine Algebra.adjoin_induction
      (p := fun x hx => π (⟨x, hx⟩ : Algebra.adjoin F (Units.val '' S)) ∈ N)
      ?_ ?_ ?_ ?_ a.2
    · rintro x ⟨s, hs, rfl⟩
      rw [hgen s hs]
      exact Submodule.subset_span (by simp)
    · intro r
      change π (algebraMap F (Algebra.adjoin F (Units.val '' S)) r) ∈ N
      rw [AlgHom.commutes, Algebra.algebraMap_eq_smul_one]
      exact Submodule.smul_mem _ r (Submodule.subset_span (by simp))
    · intro x y hx hy hpx hpy
      change π ((⟨x, hx⟩ : Algebra.adjoin F (Units.val '' S)) + ⟨y, hy⟩) ∈ N
      rw [map_add]
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hpx
      obtain ⟨d, hd⟩ := Submodule.mem_span_singleton.mp hpy
      rw [← hc, ← hd, ← add_smul]
      exact Submodule.mem_span_singleton.mpr ⟨c + d, rfl⟩
    · intro x y hx hy hpx hpy
      change π ((⟨x, hx⟩ : Algebra.adjoin F (Units.val '' S)) * ⟨y, hy⟩) ∈ N
      rw [map_mul]
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hpx
      obtain ⟨d, hd⟩ := Submodule.mem_span_singleton.mp hpy
      rw [← hc, ← hd, smul_mul_smul_comm c (1 : K) d (1 : K), mul_one]
      exact Submodule.mem_span_singleton.mpr ⟨c * d, rfl⟩
  have hNtop : N = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro y
    obtain ⟨a, rfl⟩ := hπ y
    exact hP a
  have hNfr : Module.finrank F (N : Submodule F K) = 1 := by
    change Module.finrank F (Submodule.span F ({1} : Set K)) = 1
    exact finrank_span_singleton (show (1 : K) ≠ 0 from one_ne_zero)
  have hfr : Module.finrank F K = 1 := by
    rw [hNtop, finrank_top] at hNfr
    exact hNfr
  have h2l : 2 * l = 1 := by
    rw [← hdeg, ← hfin]
    exact hfr
  omega

private def fePSp_selfDual_blockActionProp {n : ℕ} {F : Type} [Field F]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (K : Type) [Field K] (W : Type) [AddCommGroup W] [Module F W] [Module K W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (f : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e) →* (W ≃ₗ[K] W)) : Prop :=
  ∀ (g : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) (w : W),
    (eW ((f g) w) : (Fin n ⊕ Fin n) → F) =
      (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ (eW w : (Fin n ⊕ Fin n) → F)

private lemma fePSp_selfDual_blockActionCompat {n : ℕ} {F : Type} [Field F]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (u : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) (a : Matrix (Fin n ⊕ Fin n)
        (Fin n ⊕ Fin n) F)
    (ha : a ∈ Algebra.adjoin F (Units.val '' S)) :
    (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * a =
      a * (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) := by
  have hu : ((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) ∈
      Subgroup.centralizer S := by
    have h := u.2
    change (u : ↥(CFSG.Open.StatedSp n F)) ∈
      (Subgroup.centralizer S ⊓ glFixing
        (1 - e)).comap
          (CFSG.Open.StatedSp n F).subtype at h
    exact (Subgroup.mem_inf.mp (Subgroup.mem_comap.mp h)).1
  have hcommS : ∀ s ∈ S,
      (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
        (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
          Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) =
      (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
          Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
        (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) := by
    intro s hs
    exact congrArg (fun x : GL (Fin n ⊕ Fin n) F => (x : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F))
      (Subgroup.mem_centralizer_iff.mp hu s hs)
  refine Algebra.adjoin_induction (p := fun x _ =>
    (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * x =
      x * (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)) ?_ ?_ ?_ ?_ ha
  · rintro x ⟨s, hs, rfl⟩
    exact (hcommS s hs).symm
  · intro r
    rw [Algebra.algebraMap_eq_smul_one]
    simp [Matrix.mul_smul, Matrix.smul_mul]
  · intro x y hx hy hpx hpy
    rw [Matrix.mul_add, Matrix.add_mul, hpx, hpy]
  · intro x y hx hy hpx hpy
    set um : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
      (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) with hum
    have hpx' : um * x = x * um := hpx
    have hpy' : um * y = y * um := hpy
    calc um * (x * y) = (um * x) * y := (Matrix.mul_assoc um x y).symm
      _ = (x * um) * y := by rw [hpx']
      _ = x * (um * y) := Matrix.mul_assoc x um y
      _ = x * (y * um) := by rw [hpy']
      _ = (x * y) * um := (Matrix.mul_assoc x y um).symm

private lemma fePSp_selfDual_blockActionMap_mem {n : ℕ} {F : Type} [Field F]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (g : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) (v : LinearMap.range
        (Matrix.toLin' e)) :
    (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ (v : (Fin n ⊕ Fin n) → F) ∈
        LinearMap.range (Matrix.toLin' e) := by
  let um : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
    (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
  obtain ⟨x, hx⟩ := v.2
  have hv : (v : (Fin n ⊕ Fin n) → F) = e *ᵥ x := by rw [← hx, Matrix.toLin'_apply]
  refine ⟨um *ᵥ x, ?_⟩
  calc (Matrix.toLin' e) (um *ᵥ x) = e *ᵥ (um *ᵥ x) := Matrix.toLin'_apply e _
    _ = (e * um) *ᵥ x := Matrix.mulVec_mulVec x e um
    _ = (um * e) *ᵥ x := by rw [fePSp_selfDual_blockActionCompat g e he.1]
    _ = um *ᵥ (e *ᵥ x) := (Matrix.mulVec_mulVec x um e).symm
    _ = um *ᵥ (v : (Fin n ⊕ Fin n) → F) := by rw [← hv]

private noncomputable def fePSp_selfDual_blockActionMap_rangeEquiv {n : ℕ} {F : Type} [Field F] {S :
    Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (W : Type) [AddCommGroup W] [Module F W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (g : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) : W ≃ₗ[F] W := by
  let um : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
    (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
  let um' : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
    ((((g⁻¹ : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) : ↥(CFSG.Open.StatedSp n
        F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
  have humul : um * um' = 1 := by
    change ((((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
      ((((g⁻¹ : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) : ↥(CFSG.Open.StatedSp n
          F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)) = 1
    rw [← Units.val_mul]
    congr 1
    rw [← Subgroup.coe_mul, ← Subgroup.coe_mul, mul_inv_cancel]
    rfl
  have humul' : um' * um = 1 := by
    change (((((g⁻¹ : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) :
        ↥(CFSG.Open.StatedSp n F)) :
        GL (Fin n ⊕ Fin n) F) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
      (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)) = 1
    rw [← Units.val_mul]
    congr 1
    rw [← Subgroup.coe_mul, ← Subgroup.coe_mul, inv_mul_cancel]
    rfl
  let T : LinearMap.range (Matrix.toLin' e) →ₗ[F] LinearMap.range (Matrix.toLin' e) :=
    (Matrix.mulVecLin um).restrict (fun x hx => by
      simpa [Matrix.mulVecLin] using fePSp_selfDual_blockActionMap_mem he g ⟨x, hx⟩)
  let T' : LinearMap.range (Matrix.toLin' e) →ₗ[F] LinearMap.range (Matrix.toLin' e) :=
    (Matrix.mulVecLin um').restrict (fun x hx => by
      simpa [Matrix.mulVecLin, um'] using
        fePSp_selfDual_blockActionMap_mem he (g⁻¹) ⟨x, hx⟩)
  have hleft : Function.LeftInverse T' T := by
    intro v
    apply Subtype.ext
    change um' *ᵥ (um *ᵥ (v : (Fin n ⊕ Fin n) → F)) = (v : (Fin n ⊕ Fin n) → F)
    rw [Matrix.mulVec_mulVec (v : (Fin n ⊕ Fin n) → F) um' um, humul', Matrix.one_mulVec]
  have hright : Function.RightInverse T' T := by
    intro v
    apply Subtype.ext
    change um *ᵥ (um' *ᵥ (v : (Fin n ⊕ Fin n) → F)) = (v : (Fin n ⊕ Fin n) → F)
    rw [Matrix.mulVec_mulVec (v : (Fin n ⊕ Fin n) → F) um um', humul, Matrix.one_mulVec]
  exact eW.trans
    ((LinearEquiv.ofBijective T ⟨hleft.injective, hright.surjective⟩).trans eW.symm)

