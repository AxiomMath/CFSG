      (∀ (w1 w2 : W) (k : K), β w1 (k • w2) = k * β w1 w2) ∧
      (∀ w1 : W, (∀ w2 : W, β w1 w2 = 0) → w1 = 0)) :
    ∃ h : W →ₛₗ[σ.toRingHom] W →ₗ[K] K, ∀ w1 w2 : W, h w1 w2 = β w1 w2 := by
  let h : W →ₛₗ[σ.toRingHom] W →ₗ[K] K :=
    { toFun := fePSp_selfDual_unitaryBlockIsometrySesqFormInner β hβ.2.1 hβ.2.2.2.1,
      map_add' := fun w1 w2 => LinearMap.ext (fun w3 => hβ.1 w1 w2 w3),
      map_smul' := fun c w1 => LinearMap.ext (fun w2 => hβ.2.2.1 w1 w2 c) }
  exact ⟨h, fun w1 w2 => rfl⟩

private lemma fePSp_selfDual_unitaryBlockIsometryOrthonormalBasis {K : Type} [Field K] [Finite K]
    {W : Type} [AddCommGroup W] [Module K W] [FiniteDimensional K W]
    {m' : ℕ} (hW : Module.finrank K W = m')
    (σ : K ≃+* K) (hσ2 : σ ^ 2 = 1) (hσne : σ ≠ 1)
    (β : W → W → K)
    (hsym : ∀ w1 w2 : W, β w1 w2 = σ (β w2 w1))
    (hβ : (∀ (w1 w2 w3 : W), β (w1 + w2) w3 = β w1 w3 + β w2 w3) ∧
      (∀ (w1 w2 w3 : W), β w1 (w2 + w3) = β w1 w2 + β w1 w3) ∧
      (∀ (w1 w2 : W) (k : K), β (k • w1) w2 = σ k * β w1 w2) ∧
      (∀ (w1 w2 : W) (k : K), β w1 (k • w2) = k * β w1 w2) ∧
      (∀ w1 : W, (∀ w2 : W, β w1 w2 = 0) → w1 = 0)) :
    ∃ b : Module.Basis (Fin m') K W,
      ∀ i j : Fin m', β (b i) (b j) = if i = j then (1 : K) else 0 := by
  obtain ⟨h, hh⟩ := fePSp_selfDual_unitaryBlockIsometrySesqForm σ β hβ
  have hσ2' : ∀ x : K, σ (σ x) = x := fun x => by
    have h := congrArg (fun f : K ≃+* K => f x) hσ2
    simpa [pow_two] using h
  have hsym' : h.IsSymm := ⟨fun w1 w2 => (congrArg σ (hh w1 w2)).trans
      ((congrArg σ (hsym w1 w2)).trans ((hσ2' (β w2 w1)).trans (hh w2 w1).symm))⟩
  have hnd' : h.Nondegenerate :=
    ⟨fun w1 h0 => hβ.2.2.2.2 w1 (fun w2 => (hh w1 w2).symm.trans (h0 w2)),
     fun w2 h0 => hβ.2.2.2.2 w2 (fun w1 => (hh w2 w1).symm.trans
       ((hsym'.eq w1 w2).symm.trans (by rw [h0 w1, map_zero])))⟩
  obtain ⟨b, hb⟩ := CFSG.ComponentClassification.CatalogueBHermitian.exists_orthonormal_basis h
    hsym' hnd' hσ2 hσne
  refine ⟨b.reindex (Fin.castOrderIso hW).toEquiv, fun i j => ?_⟩
  rw [Module.Basis.reindex_apply, Module.Basis.reindex_apply, ← hh]
  simpa using hb ((Fin.castOrderIso hW).toEquiv.symm i) ((Fin.castOrderIso hW).toEquiv.symm j)

