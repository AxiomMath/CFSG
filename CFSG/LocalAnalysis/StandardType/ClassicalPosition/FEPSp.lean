private lemma fePSp_selfDual_unitaryBlockExtensionUnit_memStatedSp {n : ℕ} {F : Type} [Field F]
    [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    {K : Type} [Field K] [Algebra F K] (W : Type) [AddCommGroup W] [Module F W] [Module K W]
        [IsScalarTower F K W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (β : W → W → K)
    (hSpec : ∀ x y : W, (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
        (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F)) = Algebra.trace F K (β x y))
    (g : W ≃ₗ[K] W) (hg : ∀ w1 w2 : W, β (g w1) (g w2) = β w1 w2) :
    (fePSp_selfDual_unitaryBlockExtensionUnit he.2.1 eW g ∈ CFSG.Open.StatedSp n F) := by
  rw [CFSG.Open.StatedAPI.mem_statedSp_iff]
  let M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
    ((fePSp_selfDual_unitaryBlockExtensionUnit he.2.1 eW g : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
  change Matrix.transpose M * fePSp_G n F * M = fePSp_G n F
  apply Matrix.ext
  intro i j
  have hpres := fePSp_selfDual_unitaryBlockExtensionUnit_preservesB he hadj W eW β hSpec g hg
    (Pi.single i 1) (Pi.single j 1)
  rw [Matrix.toLin'_apply, Matrix.toLin'_apply] at hpres
  change (Matrix.transpose M * fePSp_G n F * M) i j = fePSp_G n F i j
  rw [fePSp_selfDual_unitaryBlockExtensionUnit_apply_eq_dot (Matrix.transpose M * fePSp_G n F * M) i
      j]
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
  rw [← fePSp_selfDual_unitaryBlockExtensionUnit_dot_transpose]
  rw [fePSp_selfDual_unitaryBlockExtensionUnit_apply_eq_dot (fePSp_G n F) i j]
  exact hpres

