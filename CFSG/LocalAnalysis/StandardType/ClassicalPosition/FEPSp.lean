      2 ≤ m' ∧
      Nat.card K = 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) ∧
      Nonempty (CFSG.Open.StatedSL m' K ≃* ↥(⁅fePSp_Geps S e, fePSp_Geps S e⁆)))
    (hf2 : 2 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (m' : ℕ),
      2 ≤ m' ∧
      Nat.card K = 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) ∧
      Nonempty (↥(J'.map ψ) ≃* Matrix.SpecialLinearGroup (Fin m') K) := by
  obtain ⟨K, hKf, hKa, hKfin, m', hm', hcard, hiso⟩ :=
    fePSp_dualPair_componentModel_rank hcomm
  letI : Field K := hKf
  letI : Finite K := hKfin
  exact ⟨K, hKf, hKfin, m', hm', hcard,
    fePSp_dualPair_componentModel_iso ψ hψ hJε hm' hcard hf2 hiso⟩

private lemma fePSp_dualPair_lieModelData {n f : ℕ} {F : Type} [Field F] [Finite F]
    (hc : Nat.card F = 2 ^ f) {X : Type} [Group X]
    (ψ : ↥(CFSG.Open.StatedSp n F) →* X)
    {S : Set (GL (Fin n ⊕ Fin n) F)}
