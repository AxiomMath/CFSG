private lemma fePSp_dualPair_blockActionMap_rangeEquiv_smul {n : ℕ} {F : Type} [Field F] {S : Set
    (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (K : Type) [Field K] [Algebra F K] (π : Algebra.adjoin F (Units.val '' S) →ₐ[F] K)
    (hπ : Function.Surjective π)
    (W : Type) [AddCommGroup W] [Module F W] [Module K W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (hact : ∀ (a : Algebra.adjoin F (Units.val '' S)) (w : W),
      eW ((π a) • w) = (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
        (eW w : (Fin n ⊕ Fin n) → F))
    (g : ↥(fePSp_Geps S e)) (k : K) (w : W) :
    (fePSp_dualPair_blockActionMap_rangeEquiv he W eW g) (k • w) =
      k • (fePSp_dualPair_blockActionMap_rangeEquiv he W eW g) w := by
  obtain ⟨a, rfl⟩ := hπ k
  let um : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
    (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
  apply eW.injective
  apply Subtype.ext
  calc eW ((fePSp_dualPair_blockActionMap_rangeEquiv he W eW g) ((π a) • w))
      = um *ᵥ (eW ((π a) • w) : (Fin n ⊕ Fin n) → F) :=
        fePSp_dualPair_blockActionMap_rangeEquiv_prop he W eW g ((π a) • w)
    _ = um *ᵥ ((a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
          (eW w : (Fin n ⊕ Fin n) → F)) := by rw [hact a w]
    _ = (um * (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)) *ᵥ
          (eW w : (Fin n ⊕ Fin n) → F) :=
        Matrix.mulVec_mulVec (eW w : (Fin n ⊕ Fin n) → F) um _
    _ = ((a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * um) *ᵥ
          (eW w : (Fin n ⊕ Fin n) → F) := by
        rw [fePSp_dualPair_blockActionCompat g (a : Matrix _ _ F) a.2]
    _ = (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
          (um *ᵥ (eW w : (Fin n ⊕ Fin n) → F)) :=
        (Matrix.mulVec_mulVec (eW w : (Fin n ⊕ Fin n) → F) _ um).symm
    _ = (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
          (eW ((fePSp_dualPair_blockActionMap_rangeEquiv he W eW g) w) :
            (Fin n ⊕ Fin n) → F) := by
        rw [fePSp_dualPair_blockActionMap_rangeEquiv_prop he W eW g w]
    _ = eW ((π a) • (fePSp_dualPair_blockActionMap_rangeEquiv he W eW g) w) :=
        (hact a ((fePSp_dualPair_blockActionMap_rangeEquiv he W eW g) w)).symm

