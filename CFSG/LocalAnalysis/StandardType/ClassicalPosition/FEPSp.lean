    rw [Matrix.GeneralLinearGroup.coe_toLin, Matrix.toLin'_apply']
  rw [h1]
  rw [fePSp_dualPair_blockRestrict_extensionGL]
  rw [MulEquiv.apply_symm_apply]
  rw [← LinearMap.GeneralLinearGroup.generalLinearEquiv_to_linearMap
        ((LinearMap.GeneralLinearGroup.generalLinearEquiv F ((Fin n ⊕ Fin n) → F)).symm
            (fePSp_dualPair_blockRestrict_extensionEquiv hS hSU he hpair K π W eW hact σ)),
      MulEquiv.apply_symm_apply]
  exact fePSp_dualPair_blockRestrict_extensionEquiv_apply hS hSU he hpair K π W eW hact σ w

