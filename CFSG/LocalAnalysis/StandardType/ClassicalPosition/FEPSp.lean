    (σ : K ≃+* K) (hσ2 : σ ^ 2 = 1) (hσne : σ ≠ 1)
    (m' : ℕ) (H : Subgroup (GL (Fin m') K)) (hm' : 1 ≤ m') (hq : 4 ≤ 2 ^ (l * f))
    (hGU : Nonempty (↥H ≃* ↥(CFSG.LieType.SemisimpleCentralizers.Held.heldGU m' K σ
      (fun x => by
        have h := congrArg (fun e : K ≃+* K => e x) hσ2
        simpa [pow_two] using h)))) :
    Nonempty (CFSG.Open.StatedSU m' (2 ^ (l * f)) K ≃* ↥(⁅H, H⁆)) := by
  exact fePSp_selfDual_unitaryBlockHeldGUCommutator (K := K) hK σ hσ2 hσne m' H hm' hq hGU

private lemma fePSp_selfDual_unitaryBlockGroupSU {n f : ℕ} {F : Type} [Field F] [Finite F]
    [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    {K : Type} [Field K] [Finite K] [Algebra F K] {l : ℕ}
    (hdeg : blockDegree (Algebra.adjoin F (Units.val '' S)) e = 2 * l)
    (hK : Nat.card K = (2 ^ (l * f)) ^ 2)
    (σ : K ≃+* K) (hσ2 : σ ^ 2 = 1) (hσne : σ ≠ 1)
    (hσalg : ∀ c : F, σ (algebraMap F K c) = algebraMap F K c)
    (π : Algebra.adjoin F (Units.val '' S) →ₐ[F] K) (hπ : Function.Surjective π)
    (hσπ : ∀ a : Algebra.adjoin F (Units.val '' S), σ (π a) = π ⟨formAdj (RingHom.id F) (fePSp_G n
        F) a, fePSp_selfDual_formAdj_mem hSU a.2⟩)
    (hker : ∀ a, π a = 0 ↔ (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e = 0)
    (hfin : Module.finrank F K = blockDegree (Algebra.adjoin F (Units.val '' S)) e)
    (hd : 4 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e) :
    ∃ (m' : ℕ) (H : Subgroup (GL (Fin m') K)),
      1 ≤ m' ∧
      Nonempty (↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e) ≃* ↥H) ∧
      Nonempty (CFSG.Open.StatedSU m' (2 ^ (l * f)) K ≃* ↥(⁅H, H⁆)) := by
  obtain ⟨m', H, hm', hG, hGU⟩ :=
    fePSp_selfDual_unitaryBlockHeldGUModel (K := K) hSU hS he hadj σ hσ2 hσne
      hσalg π hπ hσπ hker hfin
  have hl : 2 ≤ l := by omega
  have hf : 1 ≤ f := by
    rcases Nat.eq_zero_or_pos f with h | h
    · exfalso
      subst h
      simp only [mul_zero, pow_zero, one_pow] at hK
      have h1 : 1 < Nat.card K := Finite.one_lt_card
      omega
    · exact h
  have hlf : 2 ≤ l * f := by
    calc 2 = 2 * 1 := by norm_num
      _ ≤ l * f := Nat.mul_le_mul hl hf
  have hq : 4 ≤ 2 ^ (l * f) := by
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ (l * f) := Nat.pow_le_pow_right (by norm_num) hlf
  exact ⟨m', H, hm', hG,
    fePSp_selfDual_unitaryBlockCommutator (K := K) hK σ hσ2 hσne m' H hm' hq hGU⟩

private lemma fePSp_selfDual_commutatorIso_hU {n f : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2]
    (hc : Nat.card F = 2 ^ f) {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') (hodd : ∀ s ∈ S, Odd (orderOf s))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    (hd : 4 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (m' l : ℕ) (H : Subgroup (GL (Fin m') K)),
      1 ≤ m' ∧
      blockDegree (Algebra.adjoin F (Units.val '' S)) e = 2 * l ∧
      Nat.card K = (2 ^ (l * f)) ^ 2 ∧
      Nonempty (↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e) ≃* ↥H) ∧
      Nonempty (CFSG.Open.StatedSU m' (2 ^ (l * f)) K ≃* ↥(⁅H, H⁆)) := by
  obtain ⟨K, hKf, hKa, hKfin, l, hdeg, hK, hfin, π, hπ, hker⟩ :=
    fePSp_selfDual_blockFieldAndInvolution hc hSU hS hodd he hadj hd
  letI : Field K := hKf
  letI : Finite K := hKfin
  letI : Algebra F K := hKa
  obtain ⟨σ, hσ2, hσne, hσalg, hσπ⟩ :=
    fePSp_selfDual_adjointInvolution hdeg hSU hS he hadj hfin π hπ hker
  obtain ⟨m', H, hm', hφ, hSUi⟩ :=
    fePSp_selfDual_unitaryBlockGroupSU hSU hS he hadj hdeg hK σ hσ2 hσne hσalg
      π hπ hσπ hker hfin hd
  exact ⟨K, hKf, hKfin, m', l, H, hm', hdeg, hK, hφ, hSUi⟩

private lemma fePSp_selfDual_blockCentralizerSU {n f : ℕ} {F : Type} [Field F] [Finite F]
    [CharP F 2] (hc : Nat.card F = 2 ^ f) {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') (hodd : ∀ s ∈ S, Odd (orderOf s))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    (hd : 4 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e) :
    ∃ (K : Type) (_ : Field K) (_ : Finite K) (l m' : ℕ),
      1 ≤ m' ∧
      blockDegree (Algebra.adjoin F (Units.val '' S)) e = 2 * l ∧
      Nat.card K = (2 ^ (l * f)) ^ 2 ∧
      Nonempty (CFSG.Open.StatedSU m' (2 ^ (l * f)) K ≃*
        ↥(⁅glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e,
          glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e⁆)) := by
  obtain ⟨K, hKfield, hKfinite, m', l, H, hm', hd2l, hcard, ⟨φ⟩, ⟨ψU⟩⟩ :=
    fePSp_selfDual_commutatorIso_hU hc hSU hS hodd he hadj hd
  letI : Field K := hKfield
  letI : Finite K := hKfinite
  let G : Subgroup ↥(CFSG.Open.StatedSp n F) :=
    glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e
  have hmap : (commutator ↥G).map (φ : ↥G →* ↥H) = commutator ↥H := by
    have h := Subgroup.map_commutator (⊤ : Subgroup ↥G) (⊤ : Subgroup ↥G)
      (φ : ↥G →* ↥H)
    have htop : (⊤ : Subgroup ↥G).map (φ : ↥G →* ↥H) = ⊤ := by
      rw [Subgroup.map_top, MonoidHom.range_eq_top]
      exact φ.surjective
    rw [htop] at h
    simpa [_root_.commutator_def] using h
  let e1 : ↥(commutator ↥G) ≃* ↥(commutator ↥H) :=
    (Subgroup.equivMapOfInjective (commutator ↥G) (φ : ↥G →* ↥H) φ.injective).trans
      (MulEquiv.subgroupCongr hmap)
  let e2 : ↥(commutator ↥G) ≃* ↥(⁅G, G⁆) :=
    (Subgroup.equivMapOfInjective (commutator ↥G) G.subtype G.subtype_injective).trans
      (MulEquiv.subgroupCongr (Subgroup.map_subtype_commutator G))
  let cH : ↥(commutator ↥H) ≃* ↥(⁅H, H⁆) :=
    (Subgroup.equivMapOfInjective (commutator ↥H) H.subtype H.subtype_injective).trans
      (MulEquiv.subgroupCongr (Subgroup.map_subtype_commutator H))
  exact ⟨K, hKfield, hKfinite, l, m', hm', hd2l, hcard,
    ⟨ψU.trans (cH.symm.trans (e1.symm.trans e2))⟩⟩

private lemma fePSp_statedSU_isQuasisimple {q m : ℕ} {K : Type} [Field K] [Finite K]
    (hm : 2 ≤ m) (hq : 4 ≤ q) (hK : Nat.card K = q ^ 2) :
    CFSG.Open.IsQuasisimple ↥(CFSG.Open.StatedSU m q K) := by
  obtain ⟨p, hchar, k, hp, hqk⟩ :=
    CFSG.LieType.SemisimpleCentralizers.Held.hct_exists_char_pow (M := K) (Q := q) hK
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : CharP K p := hchar
  have hK' : Nat.card K = (p ^ k) ^ 2 := by rw [hK, hqk]
  rcases Nat.lt_or_ge m 3 with hm2 | hm3
  · have hm_eq : m = 2 := by omega
    subst hm_eq
    have hq' : 4 ≤ p ^ k := by rw [← hqk]; exact hq
    have hFcard : Nat.card (CFSG.LieType.Steinberg.fixedSubfield K p k) = p ^ k :=
      CFSG.LieType.Steinberg.card_fixedSubfield hK'
    obtain ⟨e⟩ := CFSG.RankThree.SubgroupLists.nonempty_sl2_mulEquiv_statedSU_two
      (K := K) (r := p) (f := k) hK'
    rw [hqk]
    refine CFSG.ComponentClassification.Components.quasisimple_of_equiv e.symm ?_
    refine CFSG.ComponentClassification.Components.quasisimple_of_equiv
      (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL 2
        (CFSG.LieType.Steinberg.fixedSubfield K p k)) ?_
    exact CFSG.LieType.SemisimpleCentralizers.Held.hct_isQuasisimple_statedSL
      (CFSG.LieType.Steinberg.fixedSubfield K p k) (by norm_num)
      (Or.inr (by rw [hFcard]; omega))
      (Or.inr (by rw [hFcard]; omega))
  · have hnq : (m, p ^ k) ≠ (3, 2) := by
      intro hcon
      have h2 : p ^ k = 2 := (Prod.mk.inj hcon).2
      rw [← hqk] at h2
      omega
    rw [hqk]
    refine (CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_open
      ↥(CFSG.Open.StatedSU m (p ^ k) K)).mp ?_
    exact (CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_native
      ↥(CFSG.Open.StatedSU m (p ^ k) K)).mpr
      (CFSG.LieType.Universal.Unitary.isQuasisimple_statedSU_of_card
        (F := K) (p := p) (f := k) hK' hm3 hnq).1

private lemma fePSp_statedSU_center_eq_scalars {f m : ℕ} {K : Type} [Field K] [Finite K]
    (hm : 2 ≤ m) (hq : 4 ≤ 2 ^ f) (hK : Nat.card K = (2 ^ f) ^ 2) :
    Subgroup.center ↥(CFSG.Open.StatedSU m (2 ^ f) K) =
      (CFSG.Open.StatedScalars (Fin m) K).subgroupOf (CFSG.Open.StatedSU m (2 ^ f) K) := by
  rcases Nat.lt_or_ge m 3 with hm2 | hm3
  · have hm_eq : m = 2 := by omega
    subst hm_eq
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    haveI : CharP K 2 := CFSG.ClassicalGroups.Unitary.charP_of_card_sq (p := 2) (f := f) hK
    have hZ : Subgroup.center ↥(CFSG.Open.StatedSU 2 (2 ^ f) K) = ⊥ :=
      CFSG.ComponentClassification.RankTwoClassical.center_statedSU_two_eq_bot (f := f) hK
    rw [hZ]
    symm
    exact le_antisymm
      ((CFSG.Open.StatedAPI.statedScalars_subgroupOf_le_center _).trans (le_of_eq hZ)) bot_le
  · have hnq : (m, 2 ^ f) ≠ (3, 2) := by
      intro hcon
      have h2 : 2 ^ f = 2 := (Prod.mk.inj hcon).2
      omega
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    exact (CFSG.LieType.Universal.Unitary.isQuasisimple_statedSU_of_card
      (F := K) (p := 2) (f := f) hK hm3 hnq).2

private lemma fePSp_eq_of_isComponentOf {G : Type} [Group G] {J M : Subgroup G}
    (hJ : CFSG.Assembly.IsComponentOf J M) (hM : CFSG.Open.IsQuasisimple ↥M) : J = M := by
  have hsub : CFSG.Open.IsSubnormal J M :=
    (CFSG.ComponentClassification.AssemblyBPredicates.isSubnormal_iff_open J M).mp hJ.2.1
  rcases CFSG.HardMathSupport.Solomon.UniquenessMaximal.subnormal_eq_or_le_center hsub hM
    with h | h
  · exact h
  · exfalso
    have hq : CFSG.Open.IsQuasisimple ↥J :=
      (CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_open ↥J).mp hJ.2.2
    have habel : ∀ a b : ↥J, a * b = b * a := by
      intro a b
      apply Subtype.ext
      obtain ⟨z, hz, hza⟩ := Subgroup.mem_map.mp (h a.2)
      have hb : (b : G) ∈ M := hJ.1 b.2
      have hcomm : z * ⟨(b : G), hb⟩ = ⟨(b : G), hb⟩ * z :=
        (Subgroup.mem_center_iff.mp hz ⟨(b : G), hb⟩).symm
      have hcomm' : (z : G) * (b : G) = (b : G) * (z : G) := congrArg Subtype.val hcomm
      have hza' : (z : G) = (a : G) := hza
      rw [hza'] at hcomm'
      show (a : G) * (b : G) = (b : G) * (a : G)
      exact hcomm'
    have htop : commutator ↥J = ⊤ := hq.1
    have hbot : commutator ↥J = ⊥ := by
      rw [_root_.commutator_def]
      rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
      intro x _
      rw [Subgroup.mem_centralizer_iff]
      intro y _
      exact (habel x y).symm
    haveI : Subsingleton ↥J := by
      rw [htop] at hbot
      refine ⟨fun a b => Subtype.ext ?_⟩
      have h1 : a ∈ (⊥ : Subgroup ↥J) := hbot ▸ Subgroup.mem_top a
      have h2 : b ∈ (⊥ : Subgroup ↥J) := hbot ▸ Subgroup.mem_top b
      rw [Subgroup.mem_bot] at h1 h2
      rw [h1, h2]
    haveI : IsSimpleGroup (↥J ⧸ Subgroup.center ↥J) := hq.2
    have hn : Nontrivial (↥J ⧸ Subgroup.center ↥J) := inferInstance
    have hs : Subsingleton (↥J ⧸ Subgroup.center ↥J) := inferInstance
    obtain ⟨a, b, hab⟩ := hn
    exact hab (Subsingleton.elim a b)

private lemma fePSp_selfDual_unitaryComponentModel {n f : ℕ} {F : Type} [Field F] {X : Type} [Group
    X]
    (ψ : ↥(CFSG.Open.StatedSp n F) →* X) (hψ : ψ.ker ≤ Subgroup.center _)
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    {J' : Subgroup ↥(CFSG.Open.StatedSp n F)}
    (hJε : IsComponentOf J' ⁅glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e,
      glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e⁆)
    {K : Type} [Field K] [Finite K] {l m' : ℕ}
    (hK : Nat.card K = (2 ^ (l * f)) ^ 2)
    (hm' : 2 ≤ m') (hq : 4 ≤ 2 ^ (l * f))
    (hU : Nonempty (CFSG.Open.StatedSU m' (2 ^ (l * f)) K ≃*
      ↥(⁅glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e,
        glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e⁆))) :
    Nonempty ((↥(J'.map ψ) ⧸ Subgroup.center ↥(J'.map ψ)) ≃*
      CFSG.Open.StatedProj (CFSG.Open.StatedSU m' (2 ^ (l * f)) K)) := by
  classical
  let G : Subgroup ↥(CFSG.Open.StatedSp n F) :=
    glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e
  let M : Subgroup ↥(CFSG.Open.StatedSp n F) := ⁅G, G⁆
  have hMq : CFSG.Open.IsQuasisimple ↥M := by
    obtain ⟨eU⟩ := hU
    exact CFSG.ComponentClassification.Components.quasisimple_of_equiv eU.symm
      (fePSp_statedSU_isQuasisimple (K := K) (q := 2 ^ (l * f)) (m := m') hm' hq hK)
  have hJeq : J' = M :=
    fePSp_eq_of_isComponentOf (show CFSG.Assembly.IsComponentOf J' M from hJε) hMq
  haveI : Group.IsPerfect ↥M := Group.isPerfect_def.mpr hMq.1
  rw [hJeq]
  obtain ⟨eU⟩ := hU
  let φ : ↥M →* ↥(M.map ψ) :=
    { toFun := fun m => ⟨ψ m.1, Subgroup.mem_map_of_mem ψ m.2⟩
      map_one' := Subtype.ext (map_one ψ)
      map_mul' := fun a b => Subtype.ext (map_mul ψ a.1 b.1) }
  have hsurj : Function.Surjective φ := by
    intro y
    obtain ⟨m, hm, hmy⟩ := Subgroup.mem_map.mp y.2
    exact ⟨⟨m, hm⟩, Subtype.ext hmy⟩
  have hker : φ.ker ≤ Subgroup.center ↥M := by
    intro m hm
    rw [MonoidHom.mem_ker] at hm
    have hψm : ψ m.1 = 1 := congrArg Subtype.val hm
    rw [Subgroup.mem_center_iff]
    intro y
    exact Subtype.ext (Subgroup.mem_center_iff.mp (hψ (MonoidHom.mem_ker.mpr hψm)) y.1)
  let e1 : ↥M ⧸ Subgroup.center ↥M ≃* ↥(M.map ψ) ⧸ Subgroup.center ↥(M.map ψ) :=
    CFSG.ComponentClassification.PerfectCentralQuotient.equivalence φ hsurj hker
  let e3 : ↥(CFSG.Open.StatedSU m' (2 ^ (l * f)) K) ⧸
      Subgroup.center ↥(CFSG.Open.StatedSU m' (2 ^ (l * f)) K) ≃*
      CFSG.Open.StatedProj (CFSG.Open.StatedSU m' (2 ^ (l * f)) K) :=
    QuotientGroup.quotientMulEquivOfEq
      (fePSp_statedSU_center_eq_scalars (K := K) (f := l * f) (m := m') hm' hq hK)
  obtain ⟨e2⟩ :=
    CFSG.LocalAnalysis.GLTheoremA.Y10GCenterQuot.nonempty_centerQuot_of_mulEquiv eU.symm
  exact ⟨e1.symm.trans (e2.trans e3)⟩

private lemma fePSp_statedSU_subsingleton_of_le_one {q : ℕ} {K : Type} [Field K] {m' : ℕ}
    (hm : m' ≤ 1) : Subsingleton (CFSG.Open.StatedSU m' q K) := by
  haveI : Subsingleton ↥(CFSG.Open.StatedSL m' K) :=
    CFSG.LieType.SemisimpleCentralizers.Held.hct_subsingleton_statedSL_of_le_one (K := K) hm
  refine ⟨fun a b => Subtype.ext ?_⟩
  have h1 : (⟨a.1, CFSG.Open.StatedAPI.statedSU_le_statedSL m' q K a.2⟩ :
      ↥(CFSG.Open.StatedSL m' K)) =
      ⟨b.1, CFSG.Open.StatedAPI.statedSU_le_statedSL m' q K b.2⟩ := Subsingleton.elim _ _
  exact congrArg (fun y : ↥(CFSG.Open.StatedSL m' K) => (y : GL (Fin m') K)) h1

private lemma fePSp_selfDual_SU2_to_SL2 {l f : ℕ} {K : Type} [Field K] [Finite K]
    (hK : Nat.card K = (2 ^ (l * f)) ^ 2) :
    ∃ (K' : Type) (_ : Field K') (_ : Finite K'), Nat.card K' = 2 ^ (l * f) ∧
      Nonempty (CFSG.Open.StatedProj (CFSG.Open.StatedSU 2 (2 ^ (l * f)) K) ≃*
        CFSG.Open.StatedProj (CFSG.Open.StatedSL 2 K')) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : CharP K 2 := CFSG.ClassicalGroups.Unitary.charP_of_card_sq (p := 2) (f := l * f) hK
  have hf : l * f ≠ 0 := by
    intro h0
    rw [h0, pow_zero, one_pow] at hK
    have h1 : 1 < Nat.card K := Finite.one_lt_card
    omega
  obtain ⟨σ, hσQ, hσinv, -⟩ :=
    CFSG.RankTwoShapes.exists_quadraticFrobenius K (l * f) hf hK
  have hτ : ∀ x : K, σ (σ x) = x := hσinv
  obtain ⟨k, hkfield, hkfin, hkcard, ⟨eSU⟩⟩ :=
    CFSG.LocalAnalysis.GLTheoremA.Y10GInnUni.exists_quot_heldSU_two_equiv_psl (E := K)
      (m := l * f) σ hτ hσQ hK
  letI : Field k := hkfield
  letI : Finite k := hkfin
  have hSUeq : CFSG.LieType.SemisimpleCentralizers.Held.heldSU 2 K σ hτ =
      CFSG.Open.StatedSU 2 (2 ^ (l * f)) K :=
    CFSG.LieType.SemisimpleCentralizers.Held.hct_heldSU_eq_statedSU (a := 2) (Q := 2 ^ (l * f))
      (M := K) (τ := σ) (hτ := hτ) hσQ
  have hZ : Subgroup.center ↥(CFSG.Open.StatedSU 2 (2 ^ (l * f)) K) = ⊥ :=
    CFSG.ComponentClassification.RankTwoClassical.center_statedSU_two_eq_bot (f := l * f) hK
  have hscal : (CFSG.Open.StatedScalars (Fin 2) K).subgroupOf
      (CFSG.Open.StatedSU 2 (2 ^ (l * f)) K) = ⊥ :=
    le_antisymm ((CFSG.Open.StatedAPI.statedScalars_subgroupOf_le_center _).trans (le_of_eq hZ))
      bot_le
  let e0 : ↥(CFSG.LieType.SemisimpleCentralizers.Held.heldSU 2 K σ hτ) ≃*
      ↥(CFSG.Open.StatedSU 2 (2 ^ (l * f)) K) := MulEquiv.subgroupCongr hSUeq
  let e1 : ↥(CFSG.LieType.SemisimpleCentralizers.Held.heldSU 2 K σ hτ) ⧸
        Subgroup.center ↥(CFSG.LieType.SemisimpleCentralizers.Held.heldSU 2 K σ hτ) ≃*
      ↥(CFSG.Open.StatedSU 2 (2 ^ (l * f)) K) ⧸
        Subgroup.center ↥(CFSG.Open.StatedSU 2 (2 ^ (l * f)) K) :=
    QuotientGroup.congr _ _ e0 (Subgroup.map_center_eq e0)
  let e2 : ↥(CFSG.Open.StatedSU 2 (2 ^ (l * f)) K) ⧸
        Subgroup.center ↥(CFSG.Open.StatedSU 2 (2 ^ (l * f)) K) ≃*
      CFSG.Open.StatedProj (CFSG.Open.StatedSU 2 (2 ^ (l * f)) K) :=
    QuotientGroup.quotientMulEquivOfEq (hZ.trans hscal.symm)
  exact ⟨k, hkfield, hkfin, hkcard, ⟨e2.symm.trans (e1.symm.trans eSU)⟩⟩

private lemma fePSp_selfDual_unitaryModel {n f : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2]
    (hc : Nat.card F = 2 ^ f) {X : Type} [Group X]
    (ψ : ↥(CFSG.Open.StatedSp n F) →* X) (hψ : ψ.ker ≤ Subgroup.center _)
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') (hodd : ∀ s ∈ S, Odd (orderOf s))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    (hd : 4 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n F)}
    (hJε : IsComponentOf J' ⁅glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e,
      glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e⁆) :
    (∃ (K : Type) (_ : Field K) (_ : Finite K) (l m' : ℕ),
      3 ≤ m' ∧
      blockDegree (Algebra.adjoin F (Units.val '' S)) e = 2 * l ∧
      Nat.card K = (2 ^ (l * f)) ^ 2 ∧
      Nonempty ((↥(J'.map ψ) ⧸ Subgroup.center ↥(J'.map ψ)) ≃*
        CFSG.Open.StatedProj (CFSG.Open.StatedSU m' (2 ^ (l * f)) K))) ∨
    (∃ (K : Type) (_ : Field K) (_ : Finite K) (l : ℕ),
      blockDegree (Algebra.adjoin F (Units.val '' S)) e = 2 * l ∧
      Nat.card K = 2 ^ (l * f) ∧
      Nonempty ((↥(J'.map ψ) ⧸ Subgroup.center ↥(J'.map ψ)) ≃*
        CFSG.Open.StatedProj (CFSG.Open.StatedSL 2 K))) := by
  obtain ⟨K, hKf, hKfin, l, m', hm', hd2l, hcard, hU⟩ :=
    fePSp_selfDual_blockCentralizerSU hc hSU hS hodd he hadj hd
  letI : Field K := hKf
  letI : Finite K := hKfin
  have hq4 : 4 ≤ 2 ^ (l * f) := by
    have hl : 2 ≤ l := by omega
    have hf1 : 1 ≤ f := by
      rcases Nat.eq_zero_or_pos f with h | h
      · exfalso
        rw [h, mul_zero, pow_zero, one_pow] at hcard
        have h1 : 1 < Nat.card K := Finite.one_lt_card
        omega
      · exact h
    have hlf : 2 ≤ l * f := by
      calc 2 = 2 * 1 := by norm_num
        _ ≤ l * f := Nat.mul_le_mul hl hf1
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ (l * f) := Nat.pow_le_pow_right (by norm_num) hlf
  have hm2 : 2 ≤ m' := by
    by_contra hlt
    have hm1 : m' ≤ 1 := by omega
    haveI : Subsingleton ↥(CFSG.Open.StatedSU m' (2 ^ (l * f)) K) :=
      fePSp_statedSU_subsingleton_of_le_one (q := 2 ^ (l * f)) hm1
    obtain ⟨eU⟩ := hU
    have hnontriv : Nontrivial ↥J' :=
      CFSG.LocalCores.isQuasisimple_nontrivial
        ((CFSG.ComponentClassification.AssemblyBPredicates.isQuasisimple_iff_native ↥J').mp
          hJε.2.2)
    have hsubJ : Subsingleton ↥J' := by
      have hinj : Function.Injective (fun x : ↥J' =>
          eU.symm (⟨x, hJε.1 x.2⟩ : ↥(⁅glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e,
            glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e⁆))) := by
        intro x y hxy
        have h1 := eU.symm.injective hxy
        exact Subtype.ext (congrArg
          (fun z : ↥(⁅glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e,
            glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e⁆) =>
            (z : ↥(CFSG.Open.StatedSp n F))) h1)
      exact ⟨fun x y => hinj (Subsingleton.elim _ _)⟩
    obtain ⟨a, b, hab⟩ := hnontriv
    exact hab (Subsingleton.elim a b)
  rcases (show m' = 2 ∨ 3 ≤ m' by omega) with hm2' | hm3
  · subst hm2'
    obtain ⟨K', hK'f, hK'fin, hK'card, ⟨eSL⟩⟩ :=
      fePSp_selfDual_SU2_to_SL2 (l := l) (f := f) (K := K) hcard
    refine Or.inr ⟨K', hK'f, hK'fin, l, hd2l, hK'card, ?_⟩
    exact ⟨(fePSp_selfDual_unitaryComponentModel ψ hψ hJε hcard hm2 hq4 hU).some.trans eSL⟩
  · refine Or.inl ⟨K, hKf, hKfin, l, m', hm3, hd2l, hcard, ?_⟩
    exact fePSp_selfDual_unitaryComponentModel ψ hψ hJε hcard hm2 hq4 hU

private lemma fePSp_selfDual_case (n f : ℕ) (F : Type) [Field F]
    (hc : Nat.card F = 2 ^ f) [Finite F] [CharP F 2] {X : Type} [Group X]
    (ψ : ↥(CFSG.Open.StatedSp n F) →* X) (hψ : ψ.ker ≤ Subgroup.center _)
    (S : Set (GL (Fin n ⊕ Fin n) F))
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F) (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    (hodd : ∀ s ∈ S, Odd (orderOf s)) {J' : Subgroup ↥(CFSG.Open.StatedSp n F)}
    {ε e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (hε : IsPrimAdjIdemIn (RingHom.id F) (fePSp_G n F)
      (Algebra.adjoin F (Units.val '' S)) ε)
    (hJε : IsComponentOf J' ⁅glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S ε,
      glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S ε⁆)
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (heq : e = ε) (hd : 4 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e) :
    GGSixLSevenFieldExtCase (J'.map ψ) .PSp f := by
  have hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e := by
    rw [heq]; exact hε.2.2.2.1
  have hJε' : IsComponentOf J' ⁅glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e,
      glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e⁆ := by
    rw [heq]; exact hJε
  obtain ⟨l, m', -, hlt, hLM⟩ :=
    fePSp_selfDual_lieModel hc ψ hd
      (fePSp_selfDual_unitaryModel hc ψ hψ hSU hS hodd he hadj hd hJε')
  rcases hLM with hPSU | hPSL
  · refine ⟨.PSU, m', l * f, hlt, hPSU, ?_⟩
    intro h
    exact absurd h.2.2 (by decide)
  · refine ⟨.PSL, 2, l * f, hlt, hPSL, ?_⟩
    intro h
    exact absurd h.2.2 (by decide)

theorem ggSixLSevenFieldExtCase_PSp (n f : ℕ) (F : Type) [Field F]
    (hc : Nat.card F = 2 ^ f) {X : Type} [Group X]
    (ψ : ↥(CFSG.Open.StatedSp n F) →* X) (hψ : ψ.ker ≤ Subgroup.center _)
    (S : Set (GL (Fin n ⊕ Fin n) F))
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F) (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    (hodd : ∀ s ∈ S, Odd (orderOf s)) {J' : Subgroup ↥(CFSG.Open.StatedSp n F)}
    {ε e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (hε : IsPrimAdjIdemIn (RingHom.id F)
      (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
      (Algebra.adjoin F (Units.val '' S)) ε)
    (hJε : IsComponentOf J'
      ⁅glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S ε, glBlockCentralizer
      (CFSG.Open.StatedSp n F).subtype S ε⁆)
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e) (heε : e * ε = e)
    (hdeg : (e = ε ∧ 4 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e) ∨
      (e ≠ ε ∧ 2 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e)) :
    GGSixLSevenFieldExtCase (J'.map ψ) .PSp f := by
  haveI hfin : Finite F :=
    Nat.finite_of_card_ne_zero (by rw [hc]; exact pow_ne_zero _ (by norm_num))
  letI : Fintype F := Fintype.ofFinite F
  have hcard : Fintype.card F = 2 ^ f := by
    rw [← Nat.card_eq_fintype_card]
    exact hc
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI hchar : CharP F 2 := charP_of_card_eq_prime_pow (p := 2) (f := f) hcard
  have hf : 1 ≤ f := fePSp_one_le_f hc
  rcases hdeg with ⟨heq, hd⟩ | ⟨hne, hd⟩
  · exact fePSp_selfDual_case n f F hc ψ hψ S hSU hS hodd hε hJε he heq hd
  · exact fePSp_dualPair_case n f F hc hf ψ hψ S hSU hS hodd hε hJε he heε hne hd

end CFSG.StandardType.ClassicalPosition
