private abbrev fePSp_G (n : ℕ) (F : Type) [Field F] :
    Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
  Matrix.fromBlocks 0 1 (-1) 0

private noncomputable abbrev fePSp_Geps {n : ℕ} {F : Type} [Field F]
    (S : Set (GL (Fin n ⊕ Fin n) F)) (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) :
    Subgroup ↥(CFSG.Open.StatedSp n F) :=
  glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S
    (e + formAdj (RingHom.id F) (fePSp_G n F) e)

private lemma fePSp_G_eq_J {n : ℕ} {F : Type} [Field F] [CharP F 2] :
    fePSp_G n F = Matrix.J (Fin n) F := by
  unfold fePSp_G
  have hneg : (-1 : Matrix (Fin n) (Fin n) F) = 1 := by
    ext i j
    rw [Matrix.neg_apply, CharTwo.neg_eq]
  rw [Matrix.J, Matrix.fromBlocks_inj]
  exact ⟨rfl, hneg.symm, hneg, rfl⟩

private lemma fePSp_G_isUnit_det {n : ℕ} {F : Type} [Field F] [CharP F 2] :
    IsUnit (fePSp_G n F).det := by
  rw [fePSp_G_eq_J]
  exact Matrix.isUnit_det_J (Fin n) F

private lemma fePSp_G_transpose {n : ℕ} {F : Type} [Field F] [CharP F 2] :
    Matrix.transpose ((fePSp_G n F).map (RingHom.id F)) = fePSp_G n F := by
  have hneg : (-1 : Matrix (Fin n) (Fin n) F) = 1 := by
    ext i j
    rw [Matrix.neg_apply, CharTwo.neg_eq]
  rw [show (⇑(RingHom.id F) : F → F) = id from rfl, Matrix.map_id]
  unfold fePSp_G
  rw [Matrix.fromBlocks_transpose, Matrix.fromBlocks_inj]
  refine ⟨rfl, ?_, ?_, rfl⟩
  · rw [Matrix.transpose_neg, Matrix.transpose_one]
    exact hneg
  · rw [Matrix.transpose_one]
    exact hneg.symm

private lemma fePSp_adjoin_comm {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    {S : Set (GL ι F)} (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') :
    ∀ {a b : Matrix ι ι F}, a ∈ Algebra.adjoin F (Units.val '' S) →
      b ∈ Algebra.adjoin F (Units.val '' S) → a * b = b * a := by
  have hcommS : (Units.val '' S : Set (Matrix ι ι F)).Pairwise Commute := by
    rintro a ⟨s, hs, rfl⟩ b ⟨s', hs', rfl⟩ _
    show (s : Matrix ι ι F) * (s' : Matrix ι ι F) = (s' : Matrix ι ι F) * (s : Matrix ι ι F)
    rw [← Units.val_mul, ← Units.val_mul]
    exact congrArg Units.val (hS s hs s' hs').eq
  letI : CommSemiring (Algebra.adjoin F (Units.val '' S)) :=
    Algebra.adjoinCommSemiringOfComm F hcommS
  intro a b ha hb
  have h := mul_comm (⟨a, ha⟩ : Algebra.adjoin F (Units.val '' S))
    (⟨b, hb⟩ : Algebra.adjoin F (Units.val '' S))
  simpa only [Subalgebra.coe_mul] using congrArg Subtype.val h

private lemma fePSp_one_le_f {F : Type} [Field F] [Finite F] {f : ℕ} (hc : Nat.card F = 2 ^ f) :
    1 ≤ f := by
  by_contra hf
  have hf0 : f = 0 := by omega
  rw [hf0, pow_zero] at hc
  letI : Fintype F := Fintype.ofFinite F
  have h2 : 2 ≤ Nat.card F := by
    rw [Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  omega

private lemma fePSp_dualPair_eps_eq {n : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2] {S : Set (GL
    (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {ε e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (hε : IsPrimAdjIdemIn (RingHom.id F) (fePSp_G n F)
      (Algebra.adjoin F (Units.val '' S)) ε)
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e) (heε : e * ε = e)
    (hne : e ≠ ε) :
    ε = e + formAdj (RingHom.id F) (fePSp_G n F) e ∧
      formAdj (RingHom.id F) (fePSp_G n F) e ≠ e := by
  let A : Subalgebra F (Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) :=
    Algebra.adjoin F (Units.val '' S)
  let G : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F := fePSp_G n F
  have hG : IsUnit G.det := fePSp_G_isUnit_det
  have hGh : Matrix.transpose (G.map (RingHom.id F)) = G := fePSp_G_transpose
  have hSU' : ∀ s ∈ S, Matrix.transpose
      ((s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F).map (RingHom.id F)) * G *
        (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) = G := by
    intro s hs
    have h := CFSG.Open.StatedAPI.mem_statedSp_iff.mp (hSU s hs)
    rw [show (⇑(RingHom.id F) : F → F) = id from rfl, Matrix.map_id]
    simpa [G, fePSp_G] using h
  have hAcomm : ∀ {a b : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F},
      a ∈ A → b ∈ A → a * b = b * a := fePSp_adjoin_comm hS
  have hstarA : ∀ {a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}, a ∈ A →
      formAdj (RingHom.id F) G a ∈ A :=
    fun {a} ha => Geo.formAdj_mem_adjoin (RingHom.id F) hG hSU' ha
  have heA : e ∈ A := he.1
  have hεA : ε ∈ A := hε.1
  have heidem : IsIdempotentElem e := he.2.1
  have hεidem : IsIdempotentElem ε := hε.2.1
  have hstar_ε : formAdj (RingHom.id F) G ε = ε := hε.2.2.2.1
  have hpair : formAdj (RingHom.id F) G e ≠ e := by
    intro hfix
    rcases hε.2.2.2.2 e heA heidem hfix heε with h | h
    · exact he.2.2.1 h
    · exact hne h
  have hstar_e_idem : IsIdempotentElem (formAdj (RingHom.id F) G e) := by
    show formAdj (RingHom.id F) G e * formAdj (RingHom.id F) G e = formAdj (RingHom.id F) G e
    rw [← Geo.formAdj_mul (RingHom.id F) hG e e, heidem.eq]
  obtain ⟨hxzero, hxe⟩ :=
    Geo.mul_formAdj_eq_zero_of_dualPair (RingHom.id F) (fun _ => rfl) hG hGh hSU' hS he hpair
  have hεe : ε * e = e := by rw [hAcomm hεA heA, heε]
  have hstar_e_ε : formAdj (RingHom.id F) G e * ε = formAdj (RingHom.id F) G e := by
    have h1 : formAdj (RingHom.id F) G (ε * e) = formAdj (RingHom.id F) G e := by rw [hεe]
    rw [Geo.formAdj_mul (RingHom.id F) hG ε e, hstar_ε] at h1
    exact h1
  have hsumid : IsIdempotentElem (e + formAdj (RingHom.id F) G e) := by
    refine IsIdempotentElem.add heidem hstar_e_idem ?_
    rw [hxzero, hxe, add_zero]
  have hsumstar : formAdj (RingHom.id F) G (e + formAdj (RingHom.id F) G e) =
      e + formAdj (RingHom.id F) G e := by
    rw [Geo.formAdj_add, Geo.formAdj_formAdj (RingHom.id F) (fun _ => rfl) hG hGh e, add_comm]
  have hsumε : (e + formAdj (RingHom.id F) G e) * ε = e + formAdj (RingHom.id F) G e := by
    rw [Matrix.add_mul, heε, hstar_e_ε]
  have hsumA : e + formAdj (RingHom.id F) G e ∈ A := Subalgebra.add_mem A heA (hstarA heA)
  have hsumne : e + formAdj (RingHom.id F) G e ≠ 0 := by
    intro h0
    have h1 : (e + formAdj (RingHom.id F) G e) * e = e := by
      rw [Matrix.add_mul, heidem.eq, hxe, add_zero]
    rw [h0, Matrix.zero_mul] at h1
    exact he.2.2.1 h1.symm
  have hsum_eq : e + formAdj (RingHom.id F) G e = ε := by
    rcases hε.2.2.2.2 (e + formAdj (RingHom.id F) G e) hsumA hsumid hsumstar hsumε with h | h
    · exact absurd h hsumne
    · exact h
  exact ⟨hsum_eq.symm, hpair⟩

private lemma fePSp_dualPair_blockField {n f : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2]
    (hc : Nat.card F = 2 ^ f) {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') (hodd : ∀ s ∈ S, Odd (orderOf s))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e) :
    ∃ (K : Type) (_ : Field K) (_ : Algebra F K) (_ : Finite K),
      Nat.card K = 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) ∧
      ∃ π : Algebra.adjoin F (Units.val '' S) →ₐ[F] K,
        Function.Surjective π ∧
        (∀ a, π a = 0 ↔ (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e = 0) ∧
        Module.finrank F K = blockDegree (Algebra.adjoin F (Units.val '' S)) e := by
  obtain ⟨K, hKfield, hKalgebra, hKfinite, π, hπsurj, hπker, hπfin⟩ :=
    exists_blockField (F := F) (ι := Fin n ⊕ Fin n) hS hodd he
  letI : Field K := hKfield
  letI : Algebra F K := hKalgebra
  letI : Finite K := hKfinite
  letI : Fintype F := Fintype.ofFinite F
  letI : Fintype K := Fintype.ofFinite K
  have hcard : Nat.card K = 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) := by
    calc Nat.card K = Nat.card F ^ Module.finrank F K := by
          rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
          exact Module.card_eq_pow_finrank
      _ = (2 ^ f) ^ blockDegree (Algebra.adjoin F (Units.val '' S)) e := by rw [hc, hπfin]
      _ = 2 ^ (f * blockDegree (Algebra.adjoin F (Units.val '' S)) e) := by rw [pow_mul]
      _ = 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) := by rw [Nat.mul_comm]
  exact ⟨K, hKfield, hKalgebra, hKfinite, hcard, π, hπsurj, hπker, hπfin⟩

private lemma fePSp_dualPair_commutatorIso {n f : ℕ} {F : Type} [Field F] [Finite F]
    (hc : Nat.card F = 2 ^ f) {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (hd : 2 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e)
    (hgl : ∃ (K : Type) (_ : Field K) (_ : Algebra F K) (_ : Finite K) (m' : ℕ),
      2 ≤ m' ∧
      Nat.card K = 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) ∧
      Nonempty (↥(fePSp_Geps S e) ≃* Matrix.GeneralLinearGroup (Fin m') K)) :
    ∃ (K : Type) (_ : Field K) (_ : Algebra F K) (_ : Finite K) (m' : ℕ),
      2 ≤ m' ∧
      Nat.card K = 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) ∧
      Nonempty (CFSG.Open.StatedSL m' K ≃* ↥(⁅fePSp_Geps S e, fePSp_Geps S e⁆)) := by
  obtain ⟨K, hKfield, hKalgebra, hKfinite, m', hm', hcard, ⟨φ⟩⟩ := hgl
  letI : Field K := hKfield
  letI : Algebra F K := hKalgebra
  letI : Finite K := hKfinite
  have hf : 1 ≤ f := fePSp_one_le_f hc
  have hK4 : 4 ≤ Nat.card K := by
    rw [hcard]
    have h2 : 2 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e * f := by nlinarith [hd, hf]
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) := by gcongr
  have hcond : 3 ≤ m' ∨ ∃ s : Finset K, s.card = 4 := by
    right
    letI : Fintype K := Fintype.ofFinite K
    have h4 : 4 ≤ (Finset.univ : Finset K).card := by
      rw [Finset.card_univ, ← Nat.card_eq_fintype_card]
      exact hK4
    obtain ⟨s, -, hs⟩ := Finset.exists_subset_card_eq h4
    exact ⟨s, hs⟩
  have hcomm : commutator (Matrix.GeneralLinearGroup (Fin m') K) = CFSG.Open.StatedSL m' K :=
    GGNbrLSideKit.commutator_generalLinear_eq_statedSL hm' hcond
  have hmap : (commutator ↥(fePSp_Geps S e)).map
      (φ : ↥(fePSp_Geps S e) →* Matrix.GeneralLinearGroup (Fin m') K) =
      commutator (Matrix.GeneralLinearGroup (Fin m') K) := by
    have h := Subgroup.map_commutator (⊤ : Subgroup ↥(fePSp_Geps S e))
      (⊤ : Subgroup ↥(fePSp_Geps S e))
      (φ : ↥(fePSp_Geps S e) →* Matrix.GeneralLinearGroup (Fin m') K)
    have htop : (⊤ : Subgroup ↥(fePSp_Geps S e)).map
        (φ : ↥(fePSp_Geps S e) →* Matrix.GeneralLinearGroup (Fin m') K) = ⊤ := by
      rw [Subgroup.map_top, MonoidHom.range_eq_top]
      exact φ.surjective
    rw [htop] at h
    simpa [_root_.commutator_def] using h
  refine ⟨K, hKfield, hKalgebra, hKfinite, m', hm', hcard, ?_⟩
  let a : ↥(CFSG.Open.StatedSL m' K) ≃*
      ↥(commutator (Matrix.GeneralLinearGroup (Fin m') K)) :=
    (MulEquiv.subgroupCongr hcomm).symm
  let b : ↥(commutator ↥(fePSp_Geps S e)) ≃*
      ↥(commutator (Matrix.GeneralLinearGroup (Fin m') K)) :=
    (Subgroup.equivMapOfInjective (commutator ↥(fePSp_Geps S e))
        (φ : ↥(fePSp_Geps S e) →* Matrix.GeneralLinearGroup (Fin m') K) φ.injective).trans
      (MulEquiv.subgroupCongr hmap)
  let c : ↥(commutator ↥(fePSp_Geps S e)) ≃* ↥(⁅fePSp_Geps S e, fePSp_Geps S e⁆) :=
    (Subgroup.equivMapOfInjective (commutator ↥(fePSp_Geps S e))
        (fePSp_Geps S e).subtype (fePSp_Geps S e).subtype_injective).trans
      (MulEquiv.subgroupCongr (Subgroup.map_subtype_commutator (fePSp_Geps S e)))
  exact ⟨a.trans (b.symm.trans c)⟩

private lemma fePSp_dualPair_lieModel_sl2 {n f : ℕ} {F : Type} [Field F]
    {X : Type} [Group X]
    (ψ : ↥(CFSG.Open.StatedSp n F) →* X)
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    {J' : Subgroup ↥(CFSG.Open.StatedSp n F)}
    {K : Type} [Field K] [Finite K]
    (hK : Nat.card K = 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f))
    (hf2 : 2 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e * f)
    (φ : ↥(J'.map ψ) ≃* Matrix.SpecialLinearGroup (Fin 2) K) :
    LieModel (↥(J'.map ψ) ⧸ Subgroup.center ↥(J'.map ψ)) .PSL 2 2
      (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) := by
  refine Or.inl ⟨by decide, ⟨?_, K, inferInstance, inferInstance, hK, ?_⟩⟩
  · refine ⟨Nat.prime_two, le_trans (by norm_num : 1 ≤ 2) hf2, le_refl 2, ?_, ?_⟩
    · intro h
      rw [Prod.mk.injEq] at h
      have h4 : 4 ≤ 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) := by
        calc 4 = 2 ^ 2 := by norm_num
          _ ≤ 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) :=
              Nat.pow_le_pow_right (by norm_num) hf2
      omega
    · intro h
      rw [Prod.mk.injEq] at h
      have h4 : 4 ≤ 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) := by
        calc 4 = 2 ^ 2 := by norm_num
          _ ≤ 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) :=
              Nat.pow_le_pow_right (by norm_num) hf2
      omega
  · exact ⟨(CFSG.SeitzReduction.LinearPilot.quotientCenterEquivProjectiveSL φ).trans
      ((CFSG.LocalAnalysis.ComponentInitial.LinearCover.projectiveSpecialLinearEquivProjectiveSL
          2 K).symm.trans
        (CFSG.Assembly.LowTwoRank.projectiveSpecialLinearGroupEquivStatedProj 2 K))⟩

private lemma fePSp_dualPair_lieModel {n f : ℕ} {F : Type} [Field F] [Finite F]
    (hc : Nat.card F = 2 ^ f) {X : Type} [Group X]
    (ψ : ↥(CFSG.Open.StatedSp n F) →* X)
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (hd : 2 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n F)}
    (hJ : ∃ (K : Type) (_ : Field K) (_ : Finite K) (m' : ℕ),
      2 ≤ m' ∧
      Nat.card K = 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) ∧
      Nonempty (↥(J'.map ψ) ≃* Matrix.SpecialLinearGroup (Fin m') K)) :
    ∃ m' : ℕ,
      f < blockDegree (Algebra.adjoin F (Units.val '' S)) e * f ∧
      LieModel (↥(J'.map ψ) ⧸ Subgroup.center ↥(J'.map ψ)) .PSL m' 2
        (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) := by
  obtain ⟨K, hKfield, hKfinite, m', hm', hcard, ⟨φ⟩⟩ := hJ
  letI : Field K := hKfield
  letI : Finite K := hKfinite
  have hf : 1 ≤ f := fePSp_one_le_f hc
  have hf' : f < blockDegree (Algebra.adjoin F (Units.val '' S)) e * f := by
    calc f = f * 1 := (Nat.mul_one f).symm
      _ < f * blockDegree (Algebra.adjoin F (Units.val '' S)) e :=
          Nat.mul_lt_mul_of_pos_left (by omega) (by omega)
      _ = blockDegree (Algebra.adjoin F (Units.val '' S)) e * f := Nat.mul_comm _ _
  rcases eq_or_lt_of_le hm' with rfl | hm3
  · exact ⟨2, hf', fePSp_dualPair_lieModel_sl2 ψ hcard (by simpa using Nat.mul_le_mul hd hf) φ⟩
  · exact ⟨m', hf',
      CFSG.SeitzReduction.LinearPilot.lieModel_quotient_center_of_mulEquiv_specialLinear
        hcard (by omega : 3 ≤ m') φ⟩

private lemma fePSp_selfDual_lieModel {n f : ℕ} {F : Type} [Field F] [Finite F]
    (hc : Nat.card F = 2 ^ f) {X : Type} [Group X]
    (ψ : ↥(CFSG.Open.StatedSp n F) →* X)
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (hd : 4 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e)
    {J' : Subgroup ↥(CFSG.Open.StatedSp n F)}
    (hJ : (∃ (K : Type) (_ : Field K) (_ : Finite K) (l m' : ℕ),
      3 ≤ m' ∧
      blockDegree (Algebra.adjoin F (Units.val '' S)) e = 2 * l ∧
      Nat.card K = (2 ^ (l * f)) ^ 2 ∧
      Nonempty ((↥(J'.map ψ) ⧸ Subgroup.center ↥(J'.map ψ)) ≃*
        CFSG.Open.StatedProj (CFSG.Open.StatedSU m' (2 ^ (l * f)) K))) ∨
      (∃ (K : Type) (_ : Field K) (_ : Finite K) (l : ℕ),
      blockDegree (Algebra.adjoin F (Units.val '' S)) e = 2 * l ∧
      Nat.card K = 2 ^ (l * f) ∧
      Nonempty ((↥(J'.map ψ) ⧸ Subgroup.center ↥(J'.map ψ)) ≃*
        CFSG.Open.StatedProj (CFSG.Open.StatedSL 2 K)))) :
    ∃ (l m' : ℕ),
      blockDegree (Algebra.adjoin F (Units.val '' S)) e = 2 * l ∧ f < l * f ∧
      (LieModel (↥(J'.map ψ) ⧸ Subgroup.center ↥(J'.map ψ)) .PSU m' 2 (l * f) ∨
        LieModel (↥(J'.map ψ) ⧸ Subgroup.center ↥(J'.map ψ)) .PSL 2 2 (l * f)) := by
  rcases hJ with hJ | hJ
  swap
  · obtain ⟨K, hKfield, hKfinite, l, hd2l, hcard, ⟨eγ⟩⟩ := hJ
    letI : Field K := hKfield
    letI : Finite K := hKfinite
    have hf : 1 ≤ f := fePSp_one_le_f hc
    have hl : 2 ≤ l := by omega
    have hlf : f < l * f := by
      calc f = f * 1 := (Nat.mul_one f).symm
        _ < f * l := Nat.mul_lt_mul_of_pos_left (by omega) (by omega)
        _ = l * f := Nat.mul_comm _ _
    refine ⟨l, 2, hd2l, hlf, Or.inr ?_⟩
    refine Or.inl ⟨by decide, ?_⟩
    refine ⟨?_, ?_⟩
    · refine ⟨Nat.prime_two, ?_, ?_, ?_, ?_⟩
      · exact Nat.succ_le_of_lt (Nat.mul_pos (by omega : 0 < l) (by omega : 0 < f))
      · omega
      · intro h
        have hp : 2 ^ (l * f) = 2 := (Prod.mk.inj h).2
        have hle : 4 ≤ 2 ^ (l * f) := by
          calc (4 : ℕ) = 2 ^ 2 := by norm_num
            _ ≤ 2 ^ (l * f) := Nat.pow_le_pow_right (by norm_num) (by omega)
        omega
      · intro h
        have hp : 2 ^ (l * f) = 3 := (Prod.mk.inj h).2
        have hle : 4 ≤ 2 ^ (l * f) := by
          calc (4 : ℕ) = 2 ^ 2 := by norm_num
            _ ≤ 2 ^ (l * f) := Nat.pow_le_pow_right (by norm_num) (by omega)
        omega
    · refine ⟨K, hKfield, hKfinite, ?_, ⟨eγ⟩⟩
      rw [hcard]
  obtain ⟨K, hKfield, hKfinite, l, m', hm', hd2l, hcard, ⟨eγ⟩⟩ := hJ
  letI : Field K := hKfield
  letI : Finite K := hKfinite
  have hf : 1 ≤ f := fePSp_one_le_f hc
  have hl : 2 ≤ l := by omega
  have hlf : f < l * f := by
    calc f = f * 1 := (Nat.mul_one f).symm
      _ < f * l := Nat.mul_lt_mul_of_pos_left (by omega) (by omega)
      _ = l * f := Nat.mul_comm _ _
  have h1lf : 1 ≤ l * f := by omega
  have hmq : (m', 2 ^ (l * f)) ≠ (3, 2) := by
    intro h
    have h2 : 2 ^ (l * f) = 2 := (Prod.mk.injEq _ _ _ _).mp h |>.2
    have hge : 4 ≤ 2 ^ (l * f) := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ (l * f) := by gcongr; omega
    rw [h2] at hge
    omega
  refine ⟨l, m', hd2l, hlf, Or.inl ?_⟩
  exact Or.inl ⟨by decide, ⟨Nat.prime_two, h1lf, hm', hmq⟩,
    K, hKfield, hKfinite, hcard, ⟨eγ⟩⟩

private lemma fePSp_dualPair_blockSpace {n : ℕ} {F : Type} [Field F] [Finite F]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (K : Type) [Field K] [Algebra F K]
    (π : Algebra.adjoin F (Units.val '' S) →ₐ[F] K) (hπ : Function.Surjective π)
    (hker : ∀ a, π a = 0 ↔ (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e = 0) :
    ∃ (W : Type) (_ : AddCommGroup W) (_ : Module F W) (_ : Module K W)
      (_ : IsScalarTower F K W) (_ : FiniteDimensional K W)
      (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e))),
      ∀ (a : Algebra.adjoin F (Units.val '' S)) (w : W),
        (eW ((π a) • w) : (Fin n ⊕ Fin n) → F) =
          (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
            (eW w : (Fin n ⊕ Fin n) → F) := by
  let W : Submodule F ((Fin n ⊕ Fin n) → F) := LinearMap.range (Matrix.toLin' e)
  have hmem : ∀ a ∈ Algebra.adjoin F (Units.val '' S), ∀ w ∈ W, a *ᵥ w ∈ W := by
    intro a ha w hw
    obtain ⟨v, hv⟩ := hw
    have hwv : w = e *ᵥ v := by rw [← hv, Matrix.toLin'_apply]
    refine ⟨(a * e) *ᵥ v, ?_⟩
    rw [Matrix.toLin'_apply, hwv, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec]
    congr 1
    rw [← Matrix.mul_assoc, fePSp_adjoin_comm hS he.1 ha, Matrix.mul_assoc, he.2.1.eq]
  let Φ : Algebra.adjoin F (Units.val '' S) →ₐ[F] Module.End F W :=
    { toFun := fun a =>
        { toFun := fun w => ⟨a *ᵥ (w : (Fin n ⊕ Fin n) → F), hmem a a.2 w w.2⟩
          map_add' := by intro x y; apply Subtype.ext; simp [Matrix.mulVec_add]
          map_smul' := by intro c x; apply Subtype.ext; simp [Matrix.mulVec_smul] }
      map_one' := by apply LinearMap.ext; intro w; apply Subtype.ext; simp
      map_mul' := by
        intro a b; apply LinearMap.ext; intro w; apply Subtype.ext
        simp [Matrix.mulVec_mulVec]
      map_zero' := by apply LinearMap.ext; intro w; apply Subtype.ext; simp
      map_add' := by
        intro a b; apply LinearMap.ext; intro w; apply Subtype.ext
        simp [Matrix.add_mulVec]
      commutes' := by
        intro c; apply LinearMap.ext; intro w; apply Subtype.ext
        simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_mulVec] }
  let I : Ideal (Algebra.adjoin F (Units.val '' S)) := RingHom.ker π
  have hI : I ≤ RingHom.ker Φ := by
    intro a ha
    rw [RingHom.mem_ker] at ha ⊢
    apply LinearMap.ext; intro w; apply Subtype.ext
    have hae : (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e = 0 := (hker a).mp ha
    obtain ⟨v, hv⟩ := w.2
    have hwv : (w : (Fin n ⊕ Fin n) → F) = e *ᵥ v := by rw [← hv, Matrix.toLin'_apply]
    change (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ (w : (Fin n ⊕ Fin n) → F) = 0
    rw [hwv, Matrix.mulVec_mulVec, hae, Matrix.zero_mulVec]
  let Φbar := Ideal.Quotient.liftₐ I Φ hI
  let eπ := Ideal.quotientKerAlgEquivOfSurjective hπ
  let φ : K →ₐ[F] Module.End F W := Φbar.comp eπ.symm.toAlgHom
  letI : Module K W := Module.compHom W φ.toRingHom
  refine ⟨W, inferInstance, inferInstance, inferInstance, ?_, ?_, LinearEquiv.refl F W, ?_⟩
  · refine ⟨fun c k w => ?_⟩
    change φ (c • k) w = c • (φ k w)
    rw [map_smul, LinearMap.smul_apply]
  · exact Module.Finite.of_finite
  · intro a w
    change (φ (π a) w : (Fin n ⊕ Fin n) → F) = a *ᵥ (w : (Fin n ⊕ Fin n) → F)
    have hφ : φ (π a) = Φ a := by
      change Φbar (eπ.symm (π a)) = Φ a
      rw [Ideal.quotientKerAlgEquivOfSurjective_symm_apply hπ a]
      exact AlgHom.congr_fun (Ideal.Quotient.liftₐ_comp I Φ hI) a
    rw [hφ]
    rfl

private lemma fePSp_dualPair_blockDims {n : ℕ} {F : Type} [Field F]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (K : Type) [Field K] [Algebra F K] [Finite K]
    (W : Type) [AddCommGroup W] [Module F W] [Module K W] [IsScalarTower F K W]
    [FiniteDimensional K W]
    (hfin : Module.finrank F K = blockDegree (Algebra.adjoin F (Units.val '' S)) e) :
    ∃ m' : ℕ, Module.finrank K W = m' ∧
      Module.finrank F W = blockDegree (Algebra.adjoin F (Units.val '' S)) e * m' := by
  refine ⟨Module.finrank K W, rfl, ?_⟩
  rw [← hfin, ← Module.finrank_mul_finrank F K W]

private lemma fePSp_dualPair_blockNontrivial {n : ℕ} {F : Type} [Field F]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (K : Type) [Field K] (m' : ℕ)
    (hgl : Nonempty (↥(fePSp_Geps S e) ≃* Matrix.GeneralLinearGroup (Fin m') K))
    (hnab : ¬ IsMulCommutative ↥(fePSp_Geps S e)) :
    2 ≤ m' := by
  by_contra h
  have hm1 : m' ≤ 1 := by omega
  obtain ⟨φ⟩ := hgl
  exact hnab (IsMulCommutative.of_comm fun x y => φ.injective (by
    rw [map_mul, map_mul]
    interval_cases m'
    · exact Subsingleton.elim _ _
    · ext i j
      fin_cases i
      fin_cases j
      simp [Matrix.mul_apply, mul_comm]))

private lemma fePSp_dualPair_blockExists {n : ℕ} {F : Type} [Field F] [Finite F]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (K : Type) [Field K] [Algebra F K] [Finite K]
    (π : Algebra.adjoin F (Units.val '' S) →ₐ[F] K) (hπ : Function.Surjective π)
    (hker : ∀ a, π a = 0 ↔ (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * e = 0)
    (hfin : Module.finrank F K = blockDegree (Algebra.adjoin F (Units.val '' S)) e) :
    ∃ (W : Type) (_ : AddCommGroup W) (_ : Module F W) (_ : Module K W)
      (_ : IsScalarTower F K W) (_ : FiniteDimensional K W) (m' : ℕ)
      (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e))),
      (∀ (a : Algebra.adjoin F (Units.val '' S)) (w : W),
        eW ((π a) • w) = (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
          (eW w : (Fin n ⊕ Fin n) → F)) ∧
      Module.finrank K W = m' ∧
      Module.finrank F W = blockDegree (Algebra.adjoin F (Units.val '' S)) e * m' := by
  obtain ⟨W, hWac, hWF, hWK, hTower, hWfd, eW, hcompat⟩ :=
    fePSp_dualPair_blockSpace hS he K π hπ hker
  obtain ⟨m', hm'K, hm'F⟩ := fePSp_dualPair_blockDims K W hfin
  exact ⟨W, hWac, hWF, hWK, hTower, hWfd, m', eW, hcompat, hm'K, hm'F⟩

private def fePSp_dualPair_blockActionProp {n : ℕ} {F : Type} [Field F]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (K : Type) [Field K] (W : Type) [AddCommGroup W] [Module F W] [Module K W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (f : ↥(fePSp_Geps S e) →* (W ≃ₗ[K] W)) : Prop :=
  ∀ (g : ↥(fePSp_Geps S e)) (w : W),
    (eW ((f g) w) : (Fin n ⊕ Fin n) → F) =
      (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ (eW w : (Fin n ⊕ Fin n) → F)

private lemma fePSp_dualPair_blockActionCompat {n : ℕ} {F : Type} [Field F]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (u : ↥(fePSp_Geps S e)) (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
    (ha : a ∈ Algebra.adjoin F (Units.val '' S)) :
    (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * a =
      a * (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) := by
  have hu : ((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) ∈
      Subgroup.centralizer S := by
    have h := u.2
    change (u : ↥(CFSG.Open.StatedSp n F)) ∈
      (Subgroup.centralizer S ⊓ glFixing
        (1 - (e + formAdj (RingHom.id F) (fePSp_G n F) e))).comap
          (CFSG.Open.StatedSp n F).subtype at h
    exact (Subgroup.mem_inf.mp (Subgroup.mem_comap.mp h)).1
  have hcommS : ∀ s ∈ S,
      (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
        (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
          Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) =
      (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
          Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
        (s : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) := by
    intro s hs
    exact congrArg (fun x : GL (Fin n ⊕ Fin n) F => (x : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F))
      (Subgroup.mem_centralizer_iff.mp hu s hs)
  refine Algebra.adjoin_induction (p := fun x _ =>
    (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) * x =
      x * (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)) ?_ ?_ ?_ ?_ ha
  · rintro x ⟨s, hs, rfl⟩
    exact (hcommS s hs).symm
  · intro r
    rw [Algebra.algebraMap_eq_smul_one]
    simp [Matrix.mul_smul, Matrix.smul_mul]
  · intro x y hx hy hpx hpy
    rw [Matrix.mul_add, Matrix.add_mul, hpx, hpy]
  · intro x y hx hy hpx hpy
    set um : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
      (((u : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) with hum
    have hpx' : um * x = x * um := hpx
    have hpy' : um * y = y * um := hpy
    calc um * (x * y) = (um * x) * y := (Matrix.mul_assoc um x y).symm
      _ = (x * um) * y := by rw [hpx']
      _ = x * (um * y) := Matrix.mul_assoc x um y
      _ = x * (y * um) := by rw [hpy']
      _ = (x * y) * um := (Matrix.mul_assoc x y um).symm

private lemma fePSp_dualPair_blockActionMap_mem {n : ℕ} {F : Type} [Field F]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (g : ↥(fePSp_Geps S e)) (v : LinearMap.range (Matrix.toLin' e)) :
    (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ (v : (Fin n ⊕ Fin n) → F) ∈
        LinearMap.range (Matrix.toLin' e) := by
  let um : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
    (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
  obtain ⟨x, hx⟩ := v.2
  have hv : (v : (Fin n ⊕ Fin n) → F) = e *ᵥ x := by rw [← hx, Matrix.toLin'_apply]
  refine ⟨um *ᵥ x, ?_⟩
  calc (Matrix.toLin' e) (um *ᵥ x) = e *ᵥ (um *ᵥ x) := Matrix.toLin'_apply e _
    _ = (e * um) *ᵥ x := Matrix.mulVec_mulVec x e um
    _ = (um * e) *ᵥ x := by rw [fePSp_dualPair_blockActionCompat g e he.1]
    _ = um *ᵥ (e *ᵥ x) := (Matrix.mulVec_mulVec x um e).symm
    _ = um *ᵥ (v : (Fin n ⊕ Fin n) → F) := by rw [← hv]

private def fePSp_dualPair_blockLinearEquivOfSmul {F K : Type} [Field F] [Field K]
    {W : Type} [AddCommGroup W] [Module F W] [Module K W]
    (φ : W ≃ₗ[F] W) (h : ∀ (k : K) (w : W), φ (k • w) = k • φ w) : W ≃ₗ[K] W :=
  { toFun := φ
    invFun := φ.symm
    left_inv := φ.left_inv
    right_inv := φ.right_inv
    map_add' := φ.map_add
    map_smul' := h }

private noncomputable def fePSp_dualPair_blockActionMap_rangeEquiv {n : ℕ} {F : Type} [Field F] {S :
    Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (W : Type) [AddCommGroup W] [Module F W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (g : ↥(fePSp_Geps S e)) : W ≃ₗ[F] W := by
  let um : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
    (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
  let um' : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
    ((((g⁻¹ : ↥(fePSp_Geps S e)) : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
  have humul : um * um' = 1 := by
    change ((((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
      ((((g⁻¹ : ↥(fePSp_Geps S e)) : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)) = 1
    rw [← Units.val_mul]
    congr 1
    rw [← Subgroup.coe_mul, ← Subgroup.coe_mul, mul_inv_cancel]
    rfl
  have humul' : um' * um = 1 := by
    change (((((g⁻¹ : ↥(fePSp_Geps S e)) : ↥(CFSG.Open.StatedSp n F)) :
        GL (Fin n ⊕ Fin n) F) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *
      (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
        Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)) = 1
    rw [← Units.val_mul]
    congr 1
    rw [← Subgroup.coe_mul, ← Subgroup.coe_mul, inv_mul_cancel]
    rfl
  let T : LinearMap.range (Matrix.toLin' e) →ₗ[F] LinearMap.range (Matrix.toLin' e) :=
    (Matrix.mulVecLin um).restrict (fun x hx => by
      simpa [Matrix.mulVecLin] using fePSp_dualPair_blockActionMap_mem he g ⟨x, hx⟩)
  let T' : LinearMap.range (Matrix.toLin' e) →ₗ[F] LinearMap.range (Matrix.toLin' e) :=
    (Matrix.mulVecLin um').restrict (fun x hx => by
      simpa [Matrix.mulVecLin, um'] using
        fePSp_dualPair_blockActionMap_mem he (g⁻¹) ⟨x, hx⟩)
  have hleft : Function.LeftInverse T' T := by
    intro v
    apply Subtype.ext
    change um' *ᵥ (um *ᵥ (v : (Fin n ⊕ Fin n) → F)) = (v : (Fin n ⊕ Fin n) → F)
    rw [Matrix.mulVec_mulVec (v : (Fin n ⊕ Fin n) → F) um' um, humul', Matrix.one_mulVec]
  have hright : Function.RightInverse T' T := by
    intro v
    apply Subtype.ext
    change um *ᵥ (um' *ᵥ (v : (Fin n ⊕ Fin n) → F)) = (v : (Fin n ⊕ Fin n) → F)
    rw [Matrix.mulVec_mulVec (v : (Fin n ⊕ Fin n) → F) um um', humul, Matrix.one_mulVec]
  exact eW.trans
    ((LinearEquiv.ofBijective T ⟨hleft.injective, hright.surjective⟩).trans eW.symm)

