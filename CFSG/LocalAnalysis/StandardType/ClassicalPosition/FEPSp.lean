        eW ((π a) • w) = (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
          (eW w : (Fin n ⊕ Fin n) → F)) := by
  obtain ⟨W, hWac, hWF, hWK, hTower, hWfd, eW, hcompat⟩ :=
    fePSp_dualPair_blockSpace (F := F) hS he K π hπ hker
  obtain ⟨m', hWdimK, hWdimF⟩ := fePSp_dualPair_blockDims K W hfin
  obtain ⟨f, hf⟩ :=
    fePSp_selfDual_blockRestrict_exists (F := F) he K π hπ W
      eW hcompat
  exact ⟨W, hWac, hWF, hWK, hTower, hWfd, m', eW, f, hf, hWdimK,
    fePSp_selfDual_blockRestrict_injective K W eW f hf, hcompat⟩

private lemma fePSp_selfDual_unitaryBlockB_isometry {n : ℕ} {F : Type} [Field F]
    (x : ↥(CFSG.Open.StatedSp n F)) (u v : Fin n ⊕ Fin n → F) :
    ((((x : GL (Fin n ⊕ Fin n) F)) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ u) ⬝ᵥ
        (fePSp_G n F *ᵥ ((((x : GL (Fin n ⊕ Fin n) F)) :
          Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ v)) =
      u ⬝ᵥ (fePSp_G n F *ᵥ v) := by
  have hdot : ∀ (A : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) (u w : Fin n ⊕ Fin n → F),
      (A *ᵥ u) ⬝ᵥ w = u ⬝ᵥ (Aᵀ *ᵥ w) := by
    intro A u w
    rw [← Matrix.vecMul_transpose A u, ← Matrix.dotProduct_mulVec u Aᵀ w]
  let xM : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
    (((x : GL (Fin n ⊕ Fin n) F)) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
  have hx : xMᵀ * fePSp_G n F * xM = fePSp_G n F := by
    have h := CFSG.Open.StatedAPI.mem_statedSp_iff.mp x.2
    simpa [xM, fePSp_G] using h
  calc (xM *ᵥ u) ⬝ᵥ (fePSp_G n F *ᵥ (xM *ᵥ v))
      = u ⬝ᵥ (xMᵀ *ᵥ (fePSp_G n F *ᵥ (xM *ᵥ v))) := hdot xM u _
    _ = u ⬝ᵥ ((xMᵀ * fePSp_G n F * xM) *ᵥ v) := by
        rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
    _ = u ⬝ᵥ (fePSp_G n F *ᵥ v) := by rw [hx]

private lemma fePSp_selfDual_B_nondegenerate {n : ℕ} {F : Type} [Field F] [CharP F 2]
    (u : Fin n ⊕ Fin n → F)
    (h : ∀ z : Fin n ⊕ Fin n → F, u ⬝ᵥ (fePSp_G n F *ᵥ z) = 0) :
    u = 0 := by
  have hG : IsUnit (fePSp_G n F).det := fePSp_G_isUnit_det
  funext i
  have hz := h ((fePSp_G n F)⁻¹ *ᵥ (Pi.single i 1))
  rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv (fePSp_G n F) hG, Matrix.one_mulVec] at hz
  simpa only [dotProduct_single, mul_one, Pi.zero_apply] using hz

private lemma fePSp_selfDual_unitaryBlockFormNondegenerate {n : ℕ} {F : Type} [Field F] [CharP F 2]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    {K : Type} [Field K] [Finite K] [Algebra F K] (W : Type) [AddCommGroup W] [Module F W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e))) :
    ∀ w1 : W, (∀ w2 : W,
      algebraMap F K ((eW w1 : (Fin n ⊕ Fin n) → F) ⬝ᵥ
        (fePSp_G n F *ᵥ (eW w2 : (Fin n ⊕ Fin n) → F))) = 0) → w1 = 0 := by
  intro w1 hw1
  have hG : IsUnit (fePSp_G n F).det := fePSp_G_isUnit_det
  have halg : Function.Injective (algebraMap F K) := FaithfulSMul.algebraMap_injective F K
  have hdot : ∀ (A : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) (a b : Fin n ⊕ Fin n → F),
      (A *ᵥ a) ⬝ᵥ b = a ⬝ᵥ (Aᵀ *ᵥ b) := by
    intro A a b
    rw [← Matrix.vecMul_transpose A a, ← Matrix.dotProduct_mulVec a Aᵀ b]
  have heT : (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)ᵀ * fePSp_G n F =
      fePSp_G n F * e := by
    have h := hadj
    simp only [formAdj] at h
    have h2 : fePSp_G n F * ((fePSp_G n F)⁻¹ *
        (e.map (RingHom.id F))ᵀ * fePSp_G n F) = fePSp_G n F * e :=
      congrArg (fun X : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F => fePSp_G n F * X) h
    rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, Matrix.mul_nonsing_inv (fePSp_G n F) hG,
      Matrix.one_mul] at h2
    simpa using h2
  set u : Fin n ⊕ Fin n → F := (eW w1 : (Fin n ⊕ Fin n) → F) with hu
  have hB : ∀ w2 : W, u ⬝ᵥ (fePSp_G n F *ᵥ (eW w2 : (Fin n ⊕ Fin n) → F)) = 0 := by
    intro w2
    have h := hw1 w2
    exact halg (by simpa using h)
  have humem : u ∈ LinearMap.range (Matrix.toLin' e) := by
    rw [hu]; exact (eW w1).2
  obtain ⟨z0, hz0⟩ := humem
  have heu : e *ᵥ u = u := by
    rw [← hz0, Matrix.toLin'_apply, Matrix.mulVec_mulVec, he.2.1]
  have hBe : ∀ z : Fin n ⊕ Fin n → F, u ⬝ᵥ (fePSp_G n F *ᵥ (e *ᵥ z)) = 0 := by
    intro z
    have hy : (e *ᵥ z) ∈ LinearMap.range (Matrix.toLin' e) := ⟨z, by rw [Matrix.toLin'_apply]⟩
    have h := hB (eW.symm ⟨e *ᵥ z, hy⟩)
    simpa using h
  have hBe' : ∀ z : Fin n ⊕ Fin n → F, (e *ᵥ u) ⬝ᵥ (fePSp_G n F *ᵥ z) = 0 := by
    intro z
    calc (e *ᵥ u) ⬝ᵥ (fePSp_G n F *ᵥ z)
        = u ⬝ᵥ ((e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)ᵀ *ᵥ
            (fePSp_G n F *ᵥ z)) := hdot e u (fePSp_G n F *ᵥ z)
      _ = u ⬝ᵥ (((e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)ᵀ * fePSp_G n F) *ᵥ z) := by
          rw [Matrix.mulVec_mulVec]
      _ = u ⬝ᵥ ((fePSp_G n F * e) *ᵥ z) := by rw [heT]
      _ = u ⬝ᵥ (fePSp_G n F *ᵥ (e *ᵥ z)) := by rw [Matrix.mulVec_mulVec]
      _ = 0 := hBe z
  have heu0 : e *ᵥ u = 0 := fePSp_selfDual_B_nondegenerate (e *ᵥ u) hBe'
  have hu0 : u = 0 := by rw [← heu, heu0]
  have hsub : (eW w1 : LinearMap.range (Matrix.toLin' e)) = 0 := by
    apply Subtype.ext
    show (eW w1 : (Fin n ⊕ Fin n) → F) = 0
    rw [← hu]
    exact hu0
  exact eW.injective (by rw [hsub, map_zero])

private lemma fePSp_selfDual_unitaryBlockBilinearForm {n : ℕ} {F : Type} [Field F] [Finite F]
    [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    {K : Type} [Field K] [Finite K] [Algebra F K]
    (σ : K ≃+* K)
    (π : Algebra.adjoin F (Units.val '' S) →ₐ[F] K)
    (hσπ : ∀ a : Algebra.adjoin F (Units.val '' S), σ (π a) = π ⟨formAdj (RingHom.id F) (fePSp_G n
        F) a, fePSp_selfDual_formAdj_mem hSU a.2⟩) (W : Type) [AddCommGroup W] [Module F W] [Module
            K W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (f : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e) →* (W ≃ₗ[K] W))
    (hcompat : ∀ (g : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) (w : W),
      (eW ((f g) w) : (Fin n ⊕ Fin n) → F) =
        (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
          Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ (eW w : (Fin n ⊕ Fin n) → F))
    (hact : ∀ (a : Algebra.adjoin F (Units.val '' S)) (w : W),
      eW ((π a) • w) = (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
        (eW w : (Fin n ⊕ Fin n) → F)) :
    ∃ B : W →ₗ[F] W →ₗ[F] F,
      (∀ x y : W, B x y = B y x) ∧
      (∀ (a : Algebra.adjoin F (Units.val '' S)) (x y : W), B ((π a) • x) y = B x ((σ (π a)) • y)) ∧
      (∀ (g : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) (x y : W), B ((f g) x) ((f
          g) y) = B x y) ∧
      (∀ x : W, (∀ y : W, B x y = 0) → x = 0) ∧
      (∀ x y : W, B x y = (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
        (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F))) := by
  let B : W →ₗ[F] W →ₗ[F] F :=
    { toFun := fun x =>
        { toFun := fun y => (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
            (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F))
          map_add' := by intro y y'; simp only [map_add, Submodule.coe_add, Matrix.mulVec_add,
              dotProduct_add]
          map_smul' := by
            intro c y
            simp only [map_smul, Submodule.coe_smul, Matrix.mulVec_smul, dotProduct_smul,
              smul_eq_mul, RingHom.id_apply] }
      map_add' := by
        intro x x'
        apply LinearMap.ext
        intro y
        change (eW (x + x') : (Fin n ⊕ Fin n) → F) ⬝ᵥ
            (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F)) =
          (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
              (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F)) +
            (eW x' : (Fin n ⊕ Fin n) → F) ⬝ᵥ
              (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F))
        rw [map_add, Submodule.coe_add, add_dotProduct]
      map_smul' := by
        intro c x
        apply LinearMap.ext
        intro y
        change (eW (c • x) : (Fin n ⊕ Fin n) → F) ⬝ᵥ
            (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F)) =
          c • ((eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
            (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F)))
        rw [map_smul, Submodule.coe_smul, smul_dotProduct, smul_eq_mul] }
  have hdot : ∀ (A : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) (p q : Fin n ⊕ Fin n → F),
      (A *ᵥ p) ⬝ᵥ q = p ⬝ᵥ (Aᵀ *ᵥ q) := by
    intro A p q
    rw [← Matrix.vecMul_transpose A p, ← Matrix.dotProduct_mulVec p Aᵀ q]
  have hBnondeg : ∀ x : W, (∀ y : W, B x y = 0) → x = 0 := by
    intro x hx
    apply fePSp_selfDual_unitaryBlockFormNondegenerate (K := K) he hadj W eW x
    intro y
    have h0 : B x y = 0 := hx y
    change algebraMap F K (B x y) = 0
    rw [h0, map_zero]
  refine ⟨B, ?_, ?_, ?_, hBnondeg, ?_⟩
  · intro x y
    change (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
        (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F)) =
      (eW y : (Fin n ⊕ Fin n) → F) ⬝ᵥ
        (fePSp_G n F *ᵥ (eW x : (Fin n ⊕ Fin n) → F))
    calc (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F))
        = (eW x : (Fin n ⊕ Fin n) → F) ᵥ* fePSp_G n F ⬝ᵥ (eW y : (Fin n ⊕ Fin n) → F) := by
            rw [Matrix.dotProduct_mulVec]
      _ = ((fePSp_G n F)ᵀ *ᵥ (eW x : (Fin n ⊕ Fin n) → F)) ⬝ᵥ
            (eW y : (Fin n ⊕ Fin n) → F) := by rw [Matrix.mulVec_transpose]
      _ = (fePSp_G n F *ᵥ (eW x : (Fin n ⊕ Fin n) → F)) ⬝ᵥ
            (eW y : (Fin n ⊕ Fin n) → F) := by
            rw [show (fePSp_G n F)ᵀ = fePSp_G n F from by simpa using fePSp_G_transpose]
      _ = (eW y : (Fin n ⊕ Fin n) → F) ⬝ᵥ
            (fePSp_G n F *ᵥ (eW x : (Fin n ⊕ Fin n) → F)) := by rw [dotProduct_comm]
  · intro a x y
    change (eW ((π a) • x) : (Fin n ⊕ Fin n) → F) ⬝ᵥ
        (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F)) =
      (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
        (fePSp_G n F *ᵥ (eW ((σ (π a)) • y) : (Fin n ⊕ Fin n) → F))
    rw [hact a x]
    simp only [hσπ a, hact]
    have haG : (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)ᵀ * fePSp_G n F =
        fePSp_G n F * formAdj (RingHom.id F) (fePSp_G n F) a := by
      unfold formAdj
      rw [← Matrix.mul_assoc, ← Matrix.mul_assoc,
        Matrix.mul_nonsing_inv (fePSp_G n F) fePSp_G_isUnit_det, Matrix.one_mul]
      rfl
    calc ((a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
          (eW x : (Fin n ⊕ Fin n) → F)) ⬝ᵥ
          (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F))
        = (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
            ((a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)ᵀ *ᵥ
              (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F))) :=
            hdot a (eW x) (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F))
      _ = (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
            (((a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)ᵀ * fePSp_G n F) *ᵥ
              (eW y : (Fin n ⊕ Fin n) → F)) := by rw [Matrix.mulVec_mulVec]
      _ = (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
            ((fePSp_G n F * formAdj (RingHom.id F) (fePSp_G n F) a) *ᵥ
              (eW y : (Fin n ⊕ Fin n) → F)) := by rw [haG]
      _ = (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
            (fePSp_G n F *ᵥ (formAdj (RingHom.id F) (fePSp_G n F) a *ᵥ
              (eW y : (Fin n ⊕ Fin n) → F))) := by rw [Matrix.mulVec_mulVec]
  · intro g x y
    change (eW ((f g) x) : (Fin n ⊕ Fin n) → F) ⬝ᵥ
        (fePSp_G n F *ᵥ (eW ((f g) y) : (Fin n ⊕ Fin n) → F)) =
      (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
        (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F))
    rw [hcompat g x, hcompat g y]
    exact fePSp_selfDual_unitaryBlockB_isometry (g : ↥(CFSG.Open.StatedSp n F)) (eW x) (eW y)
  · intro x y
    rfl

private lemma fePSp_selfDual_unitaryBlockTraceTransfer {n : ℕ} {F : Type} [Field F] [Finite F] {S :
    Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    {K : Type} [Field K] [Finite K] [Algebra F K] (W : Type) [AddCommGroup W] [Module F W] [Module K
        W] [IsScalarTower F K W]
    (f : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e) →* (W ≃ₗ[K] W))
    (B : W →ₗ[F] W →ₗ[F] F)
    (hBpres : ∀ (g : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) (x y : W), B ((f g)
        x) ((f g) y) = B x y) :
    ∃ h : W → W →ₗ[K] K,
      (∀ (x y : W) (c : K), B x (c • y) = Algebra.trace F K (c * h x y)) ∧
      (∀ x x' : W, h (x + x') = h x + h x') ∧
      (∀ (g : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) (x y : W), h ((f g) x) ((f
          g) y) = h x y) := by
  haveI : FiniteDimensional F K := Module.Finite.of_finite
  haveI : Algebra.IsAlgebraic F K := Algebra.IsAlgebraic.of_finite F K
  haveI : PerfectField F := PerfectField.ofFinite
  haveI : Algebra.IsSeparable F K := Algebra.IsAlgebraic.isSeparable_of_perfectField
  have hEx : ∀ x : W, ∃! hx : W →ₗ[K] K, ∀ (y : W) (c : K),
      B x (c • y) = Algebra.trace F K (c * hx y) := fun x =>
    existsUnique_traceTransfer (K := F) (A := K) (W := W) B x
  let h : W → W →ₗ[K] K := fun x => (hEx x).choose
  have hSpec : ∀ (x y : W) (c : K), B x (c • y) = Algebra.trace F K (c * h x y) :=
    fun x => (hEx x).choose_spec.1
  have hAdd : ∀ x x' : W, h (x + x') = h x + h x' := by
    intro x x'
    exact ((hEx (x + x')).choose_spec.2 (h x + h x')
      (show ∀ (y : W) (c : K),
        B (x + x') (c • y) = Algebra.trace F K (c * (h x + h x') y) from by
        intro y c
        rw [map_add, LinearMap.add_apply, hSpec x y c, hSpec x' y c, ← map_add, LinearMap.add_apply,
            mul_add])).symm
  have hPres : ∀ (g : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) (x y : W),
      h ((f g) x) ((f g) y) = h x y := by
    intro g x y
    have key : (h x).comp ((f g).symm : W →ₗ[K] W) = h ((f g) x) :=
      (hEx ((f g) x)).choose_spec.2 ((h x).comp ((f g).symm : W →ₗ[K] W))
        (show ∀ (y : W) (c : K), B ((f g) x) (c • y) =
          Algebra.trace F K (c * ((h x).comp ((f g).symm : W →ₗ[K] W)) y) from by
          intro y' c
          have h1 : (f g) ((f g).symm (c • y')) = c • y' :=
            LinearEquiv.apply_symm_apply (f g) (c • y')
          rw [← h1, hBpres g x ((f g).symm (c • y')), map_smul, hSpec x ((f g).symm y') c]
          rfl)
    rw [← key]
    simp
  exact ⟨h, hSpec, hAdd, hPres⟩

private lemma fePSp_selfDual_unitaryBlockTraceTransferHerm {n : ℕ} {F : Type} [Field F] [Finite F]
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {K : Type} [Field K] [Finite K] [Algebra F K]
    (σ : K ≃+* K) (hσ2 : σ ^ 2 = 1)
    (hσalg : ∀ c : F, σ (algebraMap F K c) = algebraMap F K c)
    (π : Algebra.adjoin F (Units.val '' S) →ₐ[F] K) (hπ : Function.Surjective π) (W : Type)
        [AddCommGroup W] [Module F W] [Module K W]
    (B : W →ₗ[F] W →ₗ[F] F)
    (hBsym : ∀ x y : W, B x y = B y x)
    (hBadj : ∀ (a : Algebra.adjoin F (Units.val '' S)) (x y : W), B ((π a) • x) y = B x ((σ (π a)) •
        y))
    (h : W → W →ₗ[K] K)
    (hSpec : ∀ (x y : W) (c : K), B x (c • y) = Algebra.trace F K (c * h x y)) :
    ∀ (a : K) (x y : W), h (a • x) y = σ a * h x y := by
  haveI : FiniteDimensional F K := Module.Finite.of_finite
  haveI : Algebra.IsAlgebraic F K := Algebra.IsAlgebraic.of_finite F K
  haveI : PerfectField F := PerfectField.ofFinite
  haveI : Algebra.IsSeparable F K := Algebra.IsAlgebraic.isSeparable_of_perfectField
  have hτ : ∀ (a : K) (x y : W), B (a • x) y = B x ((σ a) • y) := by
    intro a x y
    obtain ⟨a', rfl⟩ := hπ a
    exact hBadj a' x y
  have hτ2 : ∀ a : K, σ (σ a) = a := by
    intro a
    have hc := congrFun (congrArg (fun e : K ≃+* K => (e : K → K)) hσ2) a
    simpa [pow_two] using hc
  exact (traceTransfer_herm (K := F) (A := K) (W := W) (RingEquiv.refl F) B h hSpec
    (fun x y => by simpa using hBsym y x) σ (fun c => hσalg c) hτ2 hτ).1

private lemma fePSp_selfDual_unitaryBlockTraceTransferNondeg {F : Type} [Field F]
    {K : Type} [Field K] [Algebra F K] (W : Type) [AddCommGroup W] [Module F W] [Module K W]
    (B : W →ₗ[F] W →ₗ[F] F)
    (hBnondeg : ∀ x : W, (∀ y : W, B x y = 0) → x = 0)
    (h : W → W →ₗ[K] K)
    (hSpec : ∀ (x y : W) (c : K), B x (c • y) = Algebra.trace F K (c * h x y)) :
    ∀ x : W, (∀ y : W, h x y = 0) → x = 0 := by
  intro x hx
  apply hBnondeg x
  intro y
  simpa [hx y] using hSpec x y 1

private lemma fePSp_selfDual_unitaryBlockForm {n : ℕ} {F : Type} [Field F] [Finite F]
    [CharP F 2] {S : Set (GL (Fin n ⊕ Fin n) F)}
    (hSU : ∀ s ∈ S, s ∈ CFSG.Open.StatedSp n F)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    (he : IsPrimIdemIn (Algebra.adjoin F (Units.val '' S)) e)
    (hadj : formAdj (RingHom.id F) (fePSp_G n F) e = e)
    {K : Type} [Field K] [Finite K] [Algebra F K]
    (σ : K ≃+* K) (hσ2 : σ ^ 2 = 1)
    (hσalg : ∀ c : F, σ (algebraMap F K c) = algebraMap F K c)
    (π : Algebra.adjoin F (Units.val '' S) →ₐ[F] K) (hπ : Function.Surjective π)
    (hσπ : ∀ a : Algebra.adjoin F (Units.val '' S), σ (π a) = π ⟨formAdj (RingHom.id F) (fePSp_G n
        F) a, fePSp_selfDual_formAdj_mem hSU a.2⟩) (W : Type) [AddCommGroup W] [Module F W] [Module
            K W] [IsScalarTower F K W]
    (eW : W ≃ₗ[F] (LinearMap.range (Matrix.toLin' e)))
    (f : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e) →* (W ≃ₗ[K] W))
    (hcompat : ∀ (g : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) (w : W),
      (eW ((f g) w) : (Fin n ⊕ Fin n) → F) =
        (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
          Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ (eW w : (Fin n ⊕ Fin n) → F))
    (hact : ∀ (a : Algebra.adjoin F (Units.val '' S)) (w : W),
      eW ((π a) • w) = (a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
        (eW w : (Fin n ⊕ Fin n) → F)) :
    ∃ (β : W → W → K),
      ((∀ (x : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) (w1 w2 : W),
        β ((f x) w1) ((f x) w2) = β w1 w2) ∧
      (∀ (w1 w2 w3 : W), β (w1 + w2) w3 = β w1 w3 + β w2 w3) ∧
      (∀ (w1 w2 w3 : W), β w1 (w2 + w3) = β w1 w2 + β w1 w3) ∧
      (∀ (w1 w2 : W) (k : K), β (k • w1) w2 = σ k * β w1 w2) ∧
      (∀ (w1 w2 : W) (k : K), β w1 (k • w2) = k * β w1 w2) ∧
      (∀ w1 : W, (∀ w2 : W, β w1 w2 = 0) → w1 = 0)) ∧
      (∀ w1 w2 : W, β w1 w2 = σ (β w2 w1)) ∧
      (∀ x y : W, (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
        (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F)) = Algebra.trace F K (β x y)) := by
  obtain ⟨B, hBsym, hBadj, hBpres, hBnondeg, hBdot⟩ :=
    fePSp_selfDual_unitaryBlockBilinearForm hSU he hadj σ
      π hσπ W eW f hcompat hact
  obtain ⟨h, hSpec, hAdd, hPres⟩ :=
    fePSp_selfDual_unitaryBlockTraceTransfer W f B hBpres
  have hHerm :=
    fePSp_selfDual_unitaryBlockTraceTransferHerm σ hσ2 hσalg
      π hπ W B hBsym hBadj h hSpec
  have hNondeg :=
    fePSp_selfDual_unitaryBlockTraceTransferNondeg W B hBnondeg h hSpec
  have hτ : ∀ (a : K) (x y : W), B (a • x) y = B x ((σ a) • y) := by
    intro a x y
    obtain ⟨a', rfl⟩ := hπ a
    exact hBadj a' x y
  have hτ2 : ∀ a : K, σ (σ a) = a := by
    intro a
    have hc := congrFun (congrArg (fun e : K ≃+* K => (e : K → K)) hσ2) a
    simpa [pow_two] using hc
  have hSymm : ∀ x y : W, h y x = σ (h x y) :=
    (traceTransfer_herm (K := F) (A := K) (W := W) (RingEquiv.refl F) B h hSpec
      (fun x y => by simpa using hBsym y x) σ (fun c => hσalg c) hτ2 hτ).2
  have hSpec' : ∀ x y : W, (eW x : (Fin n ⊕ Fin n) → F) ⬝ᵥ
      (fePSp_G n F *ᵥ (eW y : (Fin n ⊕ Fin n) → F)) = Algebra.trace F K (h x y) := by
    intro x y
    have h1 := hSpec x y 1
    rw [one_smul, one_mul] at h1
    rw [← hBdot x y]
    exact h1
  refine ⟨fun x y => h x y, ⟨hPres, ?_, ?_, (fun w1 w2 k => hHerm k w1 w2), ?_, hNondeg⟩,
    (fun w1 w2 => hSymm w2 w1), hSpec'⟩
  · intro w1 w2 w3
    change h (w1 + w2) w3 = h w1 w3 + h w2 w3
    rw [hAdd, LinearMap.add_apply]
  · intro w1 w2 w3
    change h w1 (w2 + w3) = h w1 w2 + h w1 w3
    exact map_add (h w1) w2 w3
  · intro w1 w2 k
    change h w1 (k • w2) = k * h w1 w2
    exact map_smul (h w1) k w2

