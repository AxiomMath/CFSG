private lemma fePSp_dualPair_component_eq_of_quasisimple {G : Type} [Group G]
    {L K : Subgroup G} (hL : IsComponentOf L K)
    (hK : IsQuasisimple ↥K) : L = K := by
  rcases CFSG.LocalAnalysis.ComponentInitial.quasisimple_subnormal_subgroups hK hL.2.1.subgroupOf
      with h | h
  · refine le_antisymm hL.1 ?_
    intro x hx
    have hx' : (⟨x, hx⟩ : ↥K) ∈ L.subgroupOf K := by rw [h]; trivial
    exact Subgroup.mem_subgroupOf.mp hx'
  · exfalso
    haveI : IsMulCommutative ↥L := ⟨⟨fun a b => by
      apply Subtype.ext
      have ha' : (⟨a.val, hL.1 a.2⟩ : ↥K) ∈ L.subgroupOf K := a.2
      exact congrArg (fun x : ↥K => (x : G)) (Subgroup.mem_center_iff.mp (h ha') ⟨b.val, hL.1
          b.2⟩).symm⟩⟩
    have hcenter : Subgroup.center ↥L = ⊤ := Subgroup.center_eq_top
    haveI : Subsingleton (↥L ⧸ Subgroup.center ↥L) := by
      rw [hcenter]
      exact QuotientGroup.subsingleton_quotient_top
    exact (not_subsingleton_iff_nontrivial.mpr hL.2.2.2.toNontrivial) inferInstance

private lemma fePSp_dualPair_componentModel_iso {n f : ℕ} {F : Type} [Field F]
    [CharP F 2] {X : Type} [Group X]
    (ψ : ↥(CFSG.Open.StatedSp n F) →* X) (hψ : ψ.ker ≤ Subgroup.center _)
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    {J' : Subgroup ↥(CFSG.Open.StatedSp n F)}
    (hJε : IsComponentOf J' ⁅fePSp_Geps S e, fePSp_Geps S e⁆)
    {K : Type} [Field K] [Finite K] {m' : ℕ} (hm' : 2 ≤ m')
    (hK : Nat.card K = 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f))
    (hf2 : 2 ≤ blockDegree (Algebra.adjoin F (Units.val '' S)) e * f)
    (hiso : Nonempty (CFSG.Open.StatedSL m' K ≃* ↥(⁅fePSp_Geps S e, fePSp_Geps S e⁆))) :
    Nonempty (↥(J'.map ψ) ≃* Matrix.SpecialLinearGroup (Fin m') K) := by
  have hinj : Function.Injective ψ := by
    rw [← MonoidHom.ker_eq_bot_iff]
    exact le_bot_iff.mp (hψ.trans (le_of_eq fePSp_dualPair_statedSp_center_eq_bot))
  obtain ⟨φ⟩ := hiso
  have hK4 : 4 ≤ Nat.card K := by
    rw [hK]
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ (blockDegree (Algebra.adjoin F (Units.val '' S)) e * f) :=
          Nat.pow_le_pow_right (by norm_num) hf2
  have hqSL : CFSG.IsQuasisimple ↥(CFSG.Open.StatedSL m' K) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv
      (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL m' K)
      (CFSG.SeitzReduction.LinearPilot.isQuasisimple_specialLinearGroup_of_le
        hm' (Or.inr hK4))
  have hqC : CFSG.IsQuasisimple ↥(⁅fePSp_Geps S e, fePSp_Geps S e⁆) :=
    CFSG.LocalCores.isQuasisimple_of_mulEquiv φ hqSL
  have hJeq : J' = ⁅fePSp_Geps S e, fePSp_Geps S e⁆ :=
    fePSp_dualPair_component_eq_of_quasisimple hJε hqC
  exact ⟨(Subgroup.equivMapOfInjective J' ψ hinj).symm.trans
    ((MulEquiv.subgroupCongr hJeq).trans (φ.symm.trans
      (CFSG.Assembly.LowTwoRank.specialLinearGroupEquivStatedSL m' K).symm))⟩

private lemma fePSp_dualPair_componentModel {n f : ℕ} {F : Type} [Field F] [CharP F 2]
    {X : Type} [Group X]
    (ψ : ↥(CFSG.Open.StatedSp n F) →* X) (hψ : ψ.ker ≤ Subgroup.center _)
    {S : Set (GL (Fin n ⊕ Fin n) F)}
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F}
    {J' : Subgroup ↥(CFSG.Open.StatedSp n F)}
    (hJε : IsComponentOf J' ⁅fePSp_Geps S e, fePSp_Geps S e⁆)
