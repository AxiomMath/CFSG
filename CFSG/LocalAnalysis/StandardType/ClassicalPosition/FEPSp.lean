  simp only [LinearMap.comp_apply]
  rw [fePSp_dualPair_blockRestrict_wittPr_comp_wittInc he.2.1]
  simp only [LinearMap.restrictScalars_apply, LinearEquiv.coe_coe,
    LinearEquiv.symm_apply_apply]
