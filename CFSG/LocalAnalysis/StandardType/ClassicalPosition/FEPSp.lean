    (g : ↥(glBlockCentralizer (CFSG.Open.StatedSp n F).subtype S e)) (k : K) (w : W) :
    (fePSp_selfDual_blockActionMap_rangeEquiv he W eW g) (k • w) =
      k • (fePSp_selfDual_blockActionMap_rangeEquiv he W eW g) w := by
  obtain ⟨a, rfl⟩ := hπ k
  let um : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F :=
    (((g : ↥(CFSG.Open.StatedSp n F)) : GL (Fin n ⊕ Fin n) F) :
      Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F)
  apply eW.injective
  apply Subtype.ext
  calc eW ((fePSp_selfDual_blockActionMap_rangeEquiv he W eW g) ((π a) • w))
      = um *ᵥ (eW ((π a) • w) : (Fin n ⊕ Fin n) → F) :=
        fePSp_selfDual_blockActionMap_rangeEquiv_prop he W eW g ((π a) • w)
    _ = um *ᵥ ((a : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) F) *ᵥ
