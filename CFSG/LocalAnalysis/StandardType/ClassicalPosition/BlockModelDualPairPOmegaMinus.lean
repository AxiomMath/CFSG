    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hform : bmdualm_IsFormStandard n f R r' eidx) :
    bmdualmrange n f S e ≤ J' := by
  haveI : Finite ↥(spinGroup (bmdualmQ n f)) :=
    Finite.of_injective (bmdualmJ n f)
      (bmdualm_spinMatrix_injective n f)
  have hMq : CFSG.Open.IsQuasisimple ↥J' := hJe.2.2
  have hsub : CFSG.Open.IsSubnormal J' (bmdualmrange n f S e) :=
    bmdualm_assembly_isSubnormal_open hJe.2.1
  exact le_of_eq (CFSG.LocalAnalysis.GLTheoremA.S11.y10xF_eq_of_subnormal
    (bmdualm_component_range_quasisimple n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock
      hconv hquad hquad' heps horth horth' hform)
    hJe.1 hsub hMq).symm

private theorem bmdualm_component_rank_pos
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
        {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e))
    (hgen : bmdualm_scalarAction n f S e)
        {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJe : IsComponentOf J' (bmdualmrange n f S e))
        {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hform : bmdualm_IsFormStandard n f R r' eidx) :
    1 ≤ R := by
  have hEq := bmdualm_embedHom_range_eq n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock
    hconv hquad hquad' heps horth horth' hform
  by_contra hR0
  have hR1 : R + 1 = 1 := by omega
  haveI : Subsingleton (Fin (R + 1)) := Fin.subsingleton_iff_le_one.mpr (by omega)
  have hbot : bmdualmrange n f S e = ⊥ := by
    rw [hEq, MonoidHom.range_eq_bot_iff]
    ext x
    rw [Subsingleton.elim x 1]
    simp
  have hJ'bot : J' = ⊥ := le_bot_iff.mp (hbot ▸ hJe.1)
  have hntJ' : Nontrivial ↥J' := by
    haveI : Nontrivial (↥J' ⧸ Subgroup.center ↥J') := hJe.2.2.2.toNontrivial
    exact Function.Surjective.nontrivial (QuotientGroup.mk'_surjective (Subgroup.center ↥J'))
  haveI : Nontrivial ↥J' := hntJ'
  exact not_subsingleton ↥J' (by rw [hJ'bot]; infer_instance)

private theorem bmdualm_component_eq_range
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ (bmdualmJ n f).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e))
    (hgen : bmdualm_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJe : IsComponentOf J' (bmdualmrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hform : bmdualm_IsFormStandard n f R r' eidx) :
    J' = (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range ∧
      1 ≤ R := by
  have hEq := bmdualm_embedHom_range_eq n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock
    hconv hquad hquad' heps horth horth' hform
  have hle : (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range ≤ J' := by
    rw [← hEq]
    exact bmdualm_component_range_le n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock
      hconv hquad hquad' heps horth horth' hform
  have hJle : J' ≤ (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range := by
    rw [← hEq]
    exact hJe.1
  exact ⟨le_antisymm hJle hle,
    bmdualm_component_rank_pos n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock hconv
      hquad hquad' heps horth horth' hform⟩

private noncomputable def bmdualm_modelHom
    (f R g' : ℕ) (ρ : GaloisField 2 g' ≃+* GaloisField 2 f) :
    (ggU .PSL (R + 1) g').K →* Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) :=
  Matrix.SpecialLinearGroup.map ρ.toRingHom

private theorem bmdualm_modelHom_injective
    (f R g' : ℕ) (ρ : GaloisField 2 g' ≃+* GaloisField 2 f) :
    Function.Injective (bmdualm_modelHom f R g' ρ) := by
  change Function.Injective (Matrix.SpecialLinearGroup.map ρ.toRingHom)
  intro A B hAB
  apply Subtype.ext
  ext i j
  have h := congrArg (fun g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) => g i j)
      hAB
  simp only [Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply, Matrix.map_apply]
      at h
  exact ρ.injective h

private theorem bmdualm_modelHom_surjective
    (f R g' : ℕ) (ρ : GaloisField 2 g' ≃+* GaloisField 2 f) :
    Function.Surjective (bmdualm_modelHom f R g' ρ) := by
  change Function.Surjective (Matrix.SpecialLinearGroup.map ρ.toRingHom)
  intro B
  refine ⟨Matrix.SpecialLinearGroup.map ρ.symm.toRingHom B, ?_⟩
  apply Subtype.ext
  ext i j
  simp only [Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply, Matrix.map_apply]
  exact ρ.apply_symm_apply _

private def bmdualm_rootCoeff (R : ℕ) (i j : Fin (R + 1)) : Fin R → ℤ := fun k =>
  (if i.val ≤ k.val then 1 else 0) - (if j.val ≤ k.val then 1 else 0)

private theorem bmdualm_toStd_rootCoeff (R : ℕ) (i j : Fin (R + 1)) :
    SpecialLinear.toStd R (bmdualm_rootCoeff R i j) = Pi.single i 1 - Pi.single j 1 := by
  funext a
  have ha := a.isLt
  have hi := i.isLt
  have hj := j.isLt
  simp only [SpecialLinear.toStd, bmdualm_rootCoeff, Pi.sub_apply, Pi.single_apply, Fin.ext_iff]
  split_ifs <;> omega

private theorem bmdualm_rootCoeff_mem_roots (R : ℕ) (F : Type) [Field F]
    {i j : Fin (R + 1)} (hij : i ≠ j) :
    bmdualm_rootCoeff R i j ∈ (SpecialLinear.rootDatum R F).roots := by
  show bmdualm_rootCoeff R i j ∈ roots (SpecialLinear.isFiniteType_A R) ∅
  rw [SpecialLinear.roots_eq]
  exact ⟨i, j, hij, bmdualm_toStd_rootCoeff R i j⟩

private theorem bmdualm_model_long_root (R : ℕ) (F : Type) [Field F] (hR : 1 ≤ R) :
    ∃ β : Fin R → ℤ, β ∈ (SpecialLinear.rootDatum R F).roots ∧
      GGLongRoot (SpecialLinear.rootDatum R F) β ∧
      SpecialLinear.toStd R β = Pi.single 0 1 - Pi.single (Fin.last R) 1 := by
  have h0last : (0 : Fin (R + 1)) ≠ Fin.last R := by
    intro h
    have := congrArg Fin.val h
    simp only [Fin.val_zero, Fin.val_last] at this
    omega
  let β : Fin R → ℤ := bmdualm_rootCoeff R 0 (Fin.last R)
  have hβ : β ∈ (SpecialLinear.rootDatum R F).roots := bmdualm_rootCoeff_mem_roots R F h0last
  have hstd : SpecialLinear.toStd R β =
      Pi.single 0 1 - Pi.single (Fin.last R) 1 := bmdualm_toStd_rootCoeff R 0 (Fin.last R)
  have hmax : ∀ δ ∈ (SpecialLinear.rootDatum R F).roots, ∑ i, δ i ≤ ∑ i, β i := by
    intro δ hδ
    have hδ' : δ ∈ roots (SpecialLinear.isFiniteType_A R) ∅ := hδ
    rw [SpecialLinear.roots_eq] at hδ'
    obtain ⟨i, j, _hij, hδij⟩ := hδ'
    have h1 : ∑ k, δ k = (j : ℤ) - i := SpecialLinear.ht_eq R hδij
    have h2 : ∑ k, β k = (Fin.last R : ℤ) - 0 := SpecialLinear.ht_eq R hstd
    rw [h1, h2]
    have hj : (j : ℤ) ≤ (R : ℤ) := by
      have h : j.val ≤ R := Nat.lt_succ_iff.mp j.isLt
      exact_mod_cast h
    have hi : (0 : ℤ) ≤ (i : ℤ) := Int.natCast_nonneg _
    have hlm : (Fin.last R : ℤ) = (R : ℤ) := by simp
    rw [hlm]
    omega
  refine ⟨β, hβ, ?_, hstd⟩
  refine ⟨1, β, hβ, hmax, ?_⟩
  rw [map_one]
  exact (Module.End.one_apply β).symm

private theorem bmdualm_modelHom_rootGroup
    (f R g' : ℕ) (ρ : GaloisField 2 g' ≃+* GaloisField 2 f)
    (i j : Fin (R + 1)) (hij : i ≠ j) (β₀ : Fin R → ℤ)
    (hβ₀ : SpecialLinear.toStd R β₀ = Pi.single i 1 - Pi.single j 1) :
    ((ggU .PSL (R + 1) g').D.rootGroup β₀).map (bmdualm_modelHom f R g' ρ) =
      (ggU .PSL (R + 1) f).D.rootGroup β₀ := by
  change ((SpecialLinear.rootGroup R (GaloisField 2 g')) β₀).map (bmdualm_modelHom f R g' ρ) =
      (SpecialLinear.rootGroup R (GaloisField 2 f)) β₀
  rw [SpecialLinear.rootGroup_eq R (GaloisField 2 g') hij hβ₀,
    SpecialLinear.rootGroup_eq R (GaloisField 2 f) hij hβ₀]
  change ((Matrix.SpecialLinearGroup.transvectionHom hij).range).map
      (Matrix.SpecialLinearGroup.map ρ.toRingHom) =
    (Matrix.SpecialLinearGroup.transvectionHom hij).range
  rw [MonoidHom.map_range]
  refine le_antisymm ?_ ?_
  · rintro y ⟨c, rfl⟩
    refine ⟨Multiplicative.ofAdd (ρ (Multiplicative.toAdd c)), ?_⟩
    simp only [MonoidHom.comp_apply, Matrix.SpecialLinearGroup.transvectionHom_apply,
      Matrix.SpecialLinearGroup.map_transvection, toAdd_ofAdd]
    rfl
  · rintro y ⟨d, rfl⟩
    refine ⟨Multiplicative.ofAdd (ρ.symm (Multiplicative.toAdd d)), ?_⟩
    simp only [MonoidHom.comp_apply, Matrix.SpecialLinearGroup.transvectionHom_apply,
      Matrix.SpecialLinearGroup.map_transvection, toAdd_ofAdd]
    show Matrix.SpecialLinearGroup.transvection hij (ρ (ρ.symm (Multiplicative.toAdd d))) =
      Matrix.SpecialLinearGroup.transvection hij (Multiplicative.toAdd d)
    rw [ρ.apply_symm_apply]

private theorem bmdualm_blockMat_transvection
    (n f R r' : ℕ)
    (i j : Fin (R + 1)) (hij : i ≠ j) (c : GaloisField 2 f) :
    bmdualm_blockMat n f (R + 1) r' (Matrix.SpecialLinearGroup.transvection hij c) =
      1 + c • (Matrix.fromBlocks (Matrix.single i j 1)
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (Matrix.fromBlocks (Matrix.single j i 1)
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) := by
  unfold bmdualm_blockMat
  rw [Matrix.SpecialLinearGroup.transvection_coe, Matrix.SpecialLinearGroup.transvection_inv,
    Matrix.SpecialLinearGroup.transvection_coe]
  simp only [Matrix.transpose_add, Matrix.transpose_one, Matrix.transpose_single, CharTwo.neg_eq]
  ext p q
  rcases p with a | (b | d) <;> rcases q with a' | (b' | d') <;>
    simp [Matrix.fromBlocks, Matrix.fromBlocks_add, Matrix.fromBlocks_smul, Matrix.fromBlocks_one,
      Matrix.fromBlocks_zero, Matrix.single_apply, Matrix.smul_apply, Matrix.one_apply,
      Matrix.add_apply, Matrix.zero_apply]

private theorem bmdualm_conj_add (n f : ℕ)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (v w : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :
    Pinv * (v + w) * P = Pinv * v * P + Pinv * w * P := by
  noncomm_ring

private theorem bmdualm_conj_smul (n f : ℕ)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (c : GaloisField 2 f) (v : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :
    Pinv * (c • v) * P = c • (Pinv * v * P) := by
  rw [Matrix.mul_smul, Matrix.smul_mul]

private theorem bmdualm_conj_add_smul (n f : ℕ)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1) (c : GaloisField 2 f)
    (R : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :
    Pinv * (1 + c • R) * P = 1 + c • (Pinv * R * P) := by
  rw [bmdualm_conj_add n f P Pinv 1 (c • R), bmdualm_conj_smul, Matrix.mul_one, hPinvP]

private theorem bmdualm_reindex_add_smul (f : ℕ) {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ] (e : ι ≃ κ) (c : GaloisField 2 f)
    (M : Matrix ι ι (GaloisField 2 f)) :
    Matrix.reindex e e (1 + c • M) = 1 + c • (Matrix.reindex e e M) := by
  change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) (1 + c • M) =
    1 + c • Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e M
  rw [map_add, map_one, map_smul]

private theorem bmdualm_conj_reindex_add_smul (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1) (c : GaloisField 2 f)
    (M : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f)) :
    Pinv * Matrix.reindex eidx eidx (1 + c • M) * P =
      1 + c • (Pinv * Matrix.reindex eidx eidx M * P) := by
  rw [bmdualm_reindex_add_smul, bmdualm_conj_add_smul n f P Pinv hPinvP]

private theorem bmdualm_embedGL_transvection
    (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (i j : Fin (R + 1)) (hij : i ≠ j) (c : GaloisField 2 f) :
    ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP
        (Matrix.SpecialLinearGroup.transvection hij c) :
        GL (bmdualmι n) (GaloisField 2 f)) :
      Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
      1 + c • (Pinv * Matrix.reindex eidx eidx
        (Matrix.fromBlocks (Matrix.single i j 1)
          (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (Matrix.fromBlocks (Matrix.single j i 1)
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) * P) := by
  rw [bmdualm_embedGL_coe, bmdualm_blockMat_transvection,
    bmdualm_conj_reindex_add_smul n f R r' eidx P Pinv hPinvP c]

private noncomputable abbrev bmdualm_stdBlock (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n) (lam : GaloisField 2 f) :
    Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
  Matrix.fromBlocks
    (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
    (bmdualm_J12 f R r' lam) (bmdualm_J21 f R r' lam)
    (Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (bmdualm_formBlock n f R r' eidx))

private theorem bmdualm_G_eidx_apply (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n) (lam : GaloisField 2 f)
    (hblocks : Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) =
      bmdualm_stdBlock n f R r' eidx lam)
    (s t : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) :
    bmdualmG n f (eidx s) (eidx t) = bmdualm_stdBlock n f R r' eidx lam s t := by
  have h := congrFun (congrFun hblocks s) t
  rw [Matrix.reindex_apply, Matrix.submatrix_apply] at h
  exact h

private theorem bmdualm_G_eidx_col_inl (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n) (lam : GaloisField 2 f)
    (hblocks : Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) =
      bmdualm_stdBlock n f R r' eidx lam)
    (a : Fin (R + 1)) (s : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) :
    bmdualmG n f (eidx s) (eidx (Sum.inl a)) =
      if s = Sum.inr (Sum.inl a) then lam else 0 := by
  rw [bmdualm_G_eidx_apply n f R r' eidx lam hblocks s (Sum.inl a)]
  rcases s with b | (b | c) <;> simp [bmdualm_stdBlock, Matrix.fromBlocks, bmdualm_J21]

private theorem bmdualm_G_eidx_col_inr (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n) (lam : GaloisField 2 f)
    (hblocks : Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) =
      bmdualm_stdBlock n f R r' eidx lam)
    (a : Fin (R + 1)) (s : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) :
    bmdualmG n f (eidx s) (eidx (Sum.inr (Sum.inl a))) =
      if s = Sum.inl a then lam else 0 := by
  rw [bmdualm_G_eidx_apply n f R r' eidx lam hblocks s (Sum.inr (Sum.inl a))]
  rcases s with b | (b | c) <;> simp [bmdualm_stdBlock, Matrix.fromBlocks, bmdualm_J12]

private theorem bmdualm_G_mulVec_single_inl (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n) (lam : GaloisField 2 f)
    (hblocks : Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) =
      bmdualm_stdBlock n f R r' eidx lam)
    (a : Fin (R + 1)) :
    Matrix.mulVec (bmdualmG n f) (Pi.single (eidx (Sum.inl a)) 1) =
      lam • Pi.single (eidx (Sum.inr (Sum.inl a))) 1 := by
  funext k
  rw [Matrix.mulVec_single_one, Matrix.col_apply]
  conv_lhs => rw [← Equiv.apply_symm_apply eidx k]
  rw [bmdualm_G_eidx_col_inl n f R r' eidx lam hblocks a (eidx.symm k), Pi.smul_apply]
  by_cases h : eidx.symm k = Sum.inr (Sum.inl a)
  · have hk : k = eidx (Sum.inr (Sum.inl a)) := by
      rw [← h, Equiv.apply_symm_apply]
    rw [if_pos h, hk]
    simp
  · have hk : k ≠ eidx (Sum.inr (Sum.inl a)) := by
      intro h'
      exact h (by rw [h', Equiv.symm_apply_apply])
    rw [if_neg h, Pi.single_eq_of_ne hk]
    simp

private theorem bmdualm_G_mulVec_single_inr (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n) (lam : GaloisField 2 f)
    (hblocks : Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) =
      bmdualm_stdBlock n f R r' eidx lam)
    (a : Fin (R + 1)) :
    Matrix.mulVec (bmdualmG n f) (Pi.single (eidx (Sum.inr (Sum.inl a))) 1) =
      lam • Pi.single (eidx (Sum.inl a)) 1 := by
  funext k
  rw [Matrix.mulVec_single_one, Matrix.col_apply, Pi.smul_apply]
  conv_lhs => rw [← Equiv.apply_symm_apply eidx k]
  rw [bmdualm_G_eidx_col_inr n f R r' eidx lam hblocks a (eidx.symm k)]
  by_cases h : eidx.symm k = Sum.inl a
  · have hk : k = eidx (Sum.inl a) := by
      rw [← h, Equiv.apply_symm_apply]
    rw [if_pos h, hk]
    simp
  · have hk : k ≠ eidx (Sum.inl a) := by
      intro h'
      exact h (by rw [h', Equiv.symm_apply_apply])
    rw [if_neg h, Pi.single_eq_of_ne hk]
    simp

private theorem bmdualm_mulVec_vecMulVec (n f : ℕ)
    (u v w : bmdualmι n → GaloisField 2 f) :
    Matrix.mulVec (Matrix.vecMulVec u v) w = (v ⬝ᵥ w) • u := by
  funext i
  rw [Matrix.vecMulVec_mulVec]
  simp [op_smul_eq_mul, mul_comm]

private theorem bmdualm_conj_vecMulVec (n f : ℕ)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (a b : bmdualmι n → GaloisField 2 f) :
    Pinv * Matrix.vecMulVec a b * P =
      Matrix.vecMulVec (Matrix.mulVec Pinv a) (Matrix.mulVec (Matrix.transpose P) b) := by
  ext i k
  simp only [Matrix.mul_apply, Matrix.vecMulVec_apply, Matrix.mulVec, dotProduct]
  rw [Finset.sum_mul_sum, Finset.sum_comm]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl (fun l _ => ?_)
  rw [Matrix.transpose_apply]
  ring

private theorem bmdualm_reindex_single (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (p q : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) :
    Matrix.reindex eidx eidx (Matrix.single p q (1 : GaloisField 2 f)) =
      Matrix.vecMulVec (Pi.single (eidx p) 1) (Pi.single (eidx q) 1) := by
  ext r s
  simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Matrix.single_apply,
    Matrix.vecMulVec_apply, Pi.single_apply, Equiv.symm_apply_eq]
  split_ifs <;> simp_all

private theorem bmdualm_reindex_fromBlocks_single (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (i j : Fin (R + 1)) :
    Matrix.reindex eidx eidx
        (Matrix.fromBlocks (Matrix.single i j 1)
          (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (Matrix.fromBlocks (Matrix.single j i 1)
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) =
      Matrix.vecMulVec (Pi.single (eidx (Sum.inl i)) 1) (Pi.single (eidx (Sum.inl j)) 1) +
        Matrix.vecMulVec (Pi.single (eidx (Sum.inr (Sum.inl j))) 1)
          (Pi.single (eidx (Sum.inr (Sum.inl i))) 1) := by
  have hM : Matrix.fromBlocks (Matrix.single i j 1)
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (Matrix.fromBlocks (Matrix.single j i 1)
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) =
      Matrix.single (Sum.inl i) (Sum.inl j) (1 : GaloisField 2 f) +
        Matrix.single (Sum.inr (Sum.inl j)) (Sum.inr (Sum.inl i)) (1 : GaloisField 2 f) := by
    ext p q
    rcases p with a | (b | c) <;> rcases q with a' | (b' | c') <;>
      simp [Matrix.fromBlocks, Matrix.single_apply]
  rw [hM]
  change Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx
      (Matrix.single (Sum.inl i) (Sum.inl j) (1 : GaloisField 2 f) +
        Matrix.single (Sum.inr (Sum.inl j)) (Sum.inr (Sum.inl i)) (1 : GaloisField 2 f)) =
      Matrix.vecMulVec (Pi.single (eidx (Sum.inl i)) 1) (Pi.single (eidx (Sum.inl j)) 1) +
        Matrix.vecMulVec (Pi.single (eidx (Sum.inr (Sum.inl j))) 1)
          (Pi.single (eidx (Sum.inr (Sum.inl i))) 1)
  rw [map_add]
  congr 1
  · exact bmdualm_reindex_single n f R r' eidx (Sum.inl i) (Sum.inl j)
  · exact bmdualm_reindex_single n f R r' eidx (Sum.inr (Sum.inl j)) (Sum.inr (Sum.inl i))

private theorem bmdualm_transpose_mul_G (n f : ℕ)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v) :
    Matrix.transpose P * bmdualmG n f = bmdualmG n f * Pinv := by
  have hPG := bmdualm_isometry_of_quad (bmdualmQ n f) P hP
  calc Matrix.transpose P * bmdualmG n f
      = Matrix.transpose P * bmdualmG n f * (P * Pinv) := by
        rw [hPP, Matrix.mul_one]
    _ = (Matrix.transpose P * bmdualmG n f * P) * Pinv := by noncomm_ring
    _ = bmdualmG n f * Pinv := by rw [hPG]

private theorem bmdualm_pinv_isometry (n f : ℕ)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v) :
    ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec Pinv v) = bmdualmQ n f v := by
  intro v
  have h := hP (Matrix.mulVec Pinv v)
  rw [Matrix.mulVec_mulVec, hPP, Matrix.one_mulVec] at h
  exact h.symm

private theorem bmdualm_polar_pinv (n f : ℕ)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (x y : bmdualmι n → GaloisField 2 f) :
    QuadraticMap.polar (bmdualmQ n f) (Matrix.mulVec Pinv x)
        (Matrix.mulVec Pinv y) =
      QuadraticMap.polar (bmdualmQ n f) x y := by
  have hPinvG : Matrix.transpose Pinv * bmdualmG n f * Pinv =
      bmdualmG n f :=
    bmdualm_isometry_of_quad (bmdualmQ n f) Pinv (bmdualm_pinv_isometry n f hPP hP)
  rw [bmdualm_polar_eq_dot, bmdualm_polar_eq_dot, Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
    Matrix.vecMul_mulVec, ← Matrix.dotProduct_mulVec, ← Matrix.mul_assoc, hPinvG]

private theorem bmdualm_rootSubgroup_eq (R : ℕ) (F : Type) [Field F]
    {i j : Fin (R + 1)} (hij : i ≠ j) :
    SpecialLinear.rootSubgroup R F hij =
      (Matrix.SpecialLinearGroup.transvectionHom hij).range := rfl

private theorem bmdualm_transpose_mulVec_single_inl (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n) (lam : GaloisField 2 f)
    (hlam : lam ≠ 0)
    (hblocks : Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) =
      bmdualm_stdBlock n f R r' eidx lam)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (a : Fin (R + 1)) :
    Matrix.mulVec (Matrix.transpose P) (Pi.single (eidx (Sum.inl a)) 1) =
      lam⁻¹ • Matrix.mulVec (bmdualmG n f)
        (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl a))) 1)) := by
  rw [show Pi.single (eidx (Sum.inl a)) 1 = lam⁻¹ • Matrix.mulVec (bmdualmG n f)
        (Pi.single (eidx (Sum.inr (Sum.inl a))) 1) by
      rw [bmdualm_G_mulVec_single_inr n f R r' eidx lam hblocks a, smul_smul,
        inv_mul_cancel₀ hlam, one_smul]]
  rw [Matrix.mulVec_smul, Matrix.mulVec_mulVec, bmdualm_transpose_mul_G n f hPP hP,
    Matrix.mulVec_mulVec]

private theorem bmdualm_transpose_mulVec_single_inr (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n) (lam : GaloisField 2 f)
    (hlam : lam ≠ 0)
    (hblocks : Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) =
      bmdualm_stdBlock n f R r' eidx lam)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (a : Fin (R + 1)) :
    Matrix.mulVec (Matrix.transpose P) (Pi.single (eidx (Sum.inr (Sum.inl a))) 1) =
      lam⁻¹ • Matrix.mulVec (bmdualmG n f)
        (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl a)) 1)) := by
  rw [show Pi.single (eidx (Sum.inr (Sum.inl a))) 1 =
        lam⁻¹ • Matrix.mulVec (bmdualmG n f)
          (Pi.single (eidx (Sum.inl a)) 1) by
      rw [bmdualm_G_mulVec_single_inl n f R r' eidx lam hblocks a, smul_smul,
        inv_mul_cancel₀ hlam, one_smul]]
  rw [Matrix.mulVec_smul, Matrix.mulVec_mulVec, bmdualm_transpose_mul_G n f hPP hP,
    Matrix.mulVec_mulVec]

private theorem bmdualm_polar_pinv_single (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n) (lam : GaloisField 2 f)
    (hblocks : Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) =
      bmdualm_stdBlock n f R r' eidx lam)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (p q : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) :
    QuadraticMap.polar (bmdualmQ n f)
        (Matrix.mulVec Pinv (Pi.single (eidx p) 1))
        (Matrix.mulVec Pinv (Pi.single (eidx q) 1)) =
      bmdualm_stdBlock n f R r' eidx lam p q := by
  rw [bmdualm_polar_pinv n f hPP hP]
  have h1 : QuadraticMap.polar (bmdualmQ n f) (Pi.single (eidx p) 1)
      (Pi.single (eidx q) 1) = bmdualmG n f (eidx p) (eidx q) := by
    rw [show bmdualmG n f = LinearMap.toMatrix₂' (GaloisField 2 f)
        (QuadraticMap.polarBilin (bmdualmQ n f)) from rfl,
      LinearMap.toMatrix₂'_apply]
    rfl
  rw [h1, bmdualm_G_eidx_apply n f R r' eidx lam hblocks p q]

private theorem bmdualm_embedHom_transvection_eq_eichler
    (n f : ℕ) (hn : 4 ≤ n)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (i j : Fin (R + 1)) (hij : i ≠ j) (c : GaloisField 2 f)
    (A B : bmdualmι n → GaloisField 2 f)
    (hQA : bmdualmQ n f A = 0) (hQB : bmdualmQ n f B = 0)
    (hpol : QuadraticMap.polar (bmdualmQ n f) A B = 0)
    (hmat : Pinv * Matrix.reindex eidx eidx
        (Matrix.fromBlocks (Matrix.single i j 1)
          (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (Matrix.fromBlocks (Matrix.single j i 1)
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) * P =
      Matrix.vecMulVec A (Matrix.mulVec (bmdualmG n f) B) +
        Matrix.vecMulVec B (Matrix.mulVec (bmdualmG n f) A)) :
    Spin.spinAction (bmdualmQ n f)
        (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock
          (Matrix.SpecialLinearGroup.transvection hij c)) =
      CFSG.ClassicalGroups.Orthogonal.eichler (bmdualmQ n f) A (c • B) := by
  apply LinearEquiv.ext
  intro w
  rw [← Spin.spinMatrix_mulVec]
  have hJ : ((Spin.spinMatrix (bmdualmQ n f)
        (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock
          (Matrix.SpecialLinearGroup.transvection hij c)) : GL (bmdualmι n) (GaloisField 2 f)) :
      Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
      1 + c • (Matrix.vecMulVec A (Matrix.mulVec (bmdualmG n f) B) +
        Matrix.vecMulVec B (Matrix.mulVec (bmdualmG n f) A)) := by
    rw [show bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock =
        bmdualm_embedSpin n f R r' hn eidx P Pinv hPP hPinvP hP hblock from rfl,
      bmdualm_embedSpin_spinMatrix n f R r' hn eidx hPP hPinvP hP hblock
        (Matrix.SpecialLinearGroup.transvection hij c)]
    rw [bmdualm_embedGL_transvection n f R r' eidx hPP hPinvP i j hij c, hmat]
  rw [hJ, Matrix.add_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec, Matrix.add_mulVec,
    bmdualm_mulVec_vecMulVec, bmdualm_mulVec_vecMulVec]
  rw [CFSG.ClassicalGroups.Orthogonal.eichler_apply hQA
    (by rw [QuadraticMap.polar_smul_right, hpol, smul_zero])]
  rw [QuadraticMap.polar_smul_right, QuadraticMap.map_smul, hQB, smul_zero, zero_mul, add_zero,
    sub_eq_add_neg]
  have hneg : ∀ z : bmdualmι n → GaloisField 2 f, -z = z := by
    intro z
    rw [← neg_one_smul (GaloisField 2 f) z, CharTwo.neg_eq (1 : GaloisField 2 f), one_smul]
  rw [hneg]
  have h1 : Matrix.mulVec (bmdualmG n f) B ⬝ᵥ w =
      QuadraticMap.polar (bmdualmQ n f) w B := by
    rw [dotProduct_comm, bmdualm_polar_eq_dot]
  have h2 : Matrix.mulVec (bmdualmG n f) A ⬝ᵥ w =
      QuadraticMap.polar (bmdualmQ n f) w A := by
    rw [dotProduct_comm, bmdualm_polar_eq_dot]
  rw [h1, h2]
  module

private theorem bmdualm_embedHom_rootGroup_siegel
    (n f : ℕ) (hn : 4 ≤ n)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hform : bmdualm_IsFormStandardOne n f R r' eidx)
    (hRpos : 1 ≤ R)
    (hQA : ∀ a : Fin (R + 1),
      bmdualmQ n f (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl a)) 1)) = 0)
    (hQB : ∀ a : Fin (R + 1),
      bmdualmQ n f (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl a))) 1)) = 0)
    (β₀ : Fin R → ℤ)
    (hβ₀ : SpecialLinear.toStd R β₀ = Pi.single 0 1 - Pi.single (Fin.last R) 1) :
    ∃ a₁ a₂ b₁ b₂ : bmdualmι n → GaloisField 2 f,
      ((bmdualmQ n f) a₁ = 0 ∧ (bmdualmQ n f) a₂ = 0 ∧
        (bmdualmQ n f) b₁ = 0 ∧ (bmdualmQ n f) b₂ = 0) ∧
      QuadraticMap.polar (bmdualmQ n f) a₁ b₁ = 1 ∧
      QuadraticMap.polar (bmdualmQ n f) a₂ b₂ = 1 ∧
      (QuadraticMap.polar (bmdualmQ n f) a₁ a₂ = 0 ∧
        QuadraticMap.polar (bmdualmQ n f) b₁ b₂ = 0 ∧
        QuadraticMap.polar (bmdualmQ n f) a₁ b₂ = 0 ∧
        QuadraticMap.polar (bmdualmQ n f) a₂ b₁ = 0) ∧
      (((SpecialLinear.rootDatum R (GaloisField 2 f)).rootGroup β₀).map
          (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock)).map
          (Spin.spinAction (bmdualmQ n f)) =
        siegelGroup (bmdualmQ n f) a₁ a₂ ∧
      (((SpecialLinear.rootDatum R (GaloisField 2 f)).rootGroup (-β₀)).map
          (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock)).map
          (Spin.spinAction (bmdualmQ n f)) =
        siegelGroup (bmdualmQ n f) b₁ b₂ := by
  obtain ⟨hblocksOne, _⟩ := hform
  have hblocks : Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) =
      bmdualm_stdBlock n f R r' eidx 1 := by
    simpa [bmdualm_IsFormStandardOne, bmdualm_stdBlock] using hblocksOne
  have hlam : (1 : GaloisField 2 f) ≠ 0 := one_ne_zero
  have hij : (0 : Fin (R + 1)) ≠ Fin.last R := by
    intro h
    have := congrArg Fin.val h
    simp only [Fin.val_zero, Fin.val_last] at this
    omega
  have hβ₀neg : SpecialLinear.toStd R (-β₀) = Pi.single (Fin.last R) 1 - Pi.single 0 1 := by
    rw [SpecialLinear.toStd_neg, hβ₀]
    abel
  have hQA₁ : bmdualmQ n f
      (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl 0)) 1)) = 0 := hQA 0
  have hQA₂ : bmdualmQ n f
      (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl (Fin.last R)))) 1)) = 0 :=
    hQB (Fin.last R)
  have hQB₁ : bmdualmQ n f
      (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl 0))) 1)) = 0 := hQB 0
  have hQB₂ : bmdualmQ n f
      (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl (Fin.last R))) 1)) = 0 :=
    hQA (Fin.last R)
  have hpol12 : QuadraticMap.polar (bmdualmQ n f)
      (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl 0)) 1))
      (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl (Fin.last R)))) 1)) = 0 := by
    rw [bmdualm_polar_pinv_single n f R r' eidx 1 hblocks hPP hP (Sum.inl 0)
      (Sum.inr (Sum.inl (Fin.last R)))]
    simp [bmdualm_stdBlock, Matrix.fromBlocks, bmdualm_J12, hij]
  have hpol34 : QuadraticMap.polar (bmdualmQ n f)
      (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl 0))) 1))
      (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl (Fin.last R))) 1)) = 0 := by
    rw [bmdualm_polar_pinv_single n f R r' eidx 1 hblocks hPP hP (Sum.inr (Sum.inl 0))
      (Sum.inl (Fin.last R))]
    simp [bmdualm_stdBlock, Matrix.fromBlocks, bmdualm_J21, hij]
  have hmat1 : Pinv * Matrix.reindex eidx eidx
        (Matrix.fromBlocks (Matrix.single 0 (Fin.last R) 1)
          (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (Matrix.fromBlocks (Matrix.single (Fin.last R) 0 1)
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) * P =
      Matrix.vecMulVec (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl 0)) 1))
        (Matrix.mulVec (bmdualmG n f)
          (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl (Fin.last R)))) 1))) +
      Matrix.vecMulVec (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl (Fin.last R)))) 1))
        (Matrix.mulVec (bmdualmG n f)
          (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl 0)) 1))) := by
    rw [bmdualm_reindex_fromBlocks_single n f R r' eidx 0 (Fin.last R)]
    rw [Matrix.mul_add, Matrix.add_mul]
    rw [bmdualm_conj_vecMulVec n f P Pinv (Pi.single (eidx (Sum.inl 0)) 1)
          (Pi.single (eidx (Sum.inl (Fin.last R))) 1),
      bmdualm_conj_vecMulVec n f P Pinv (Pi.single (eidx (Sum.inr (Sum.inl (Fin.last R)))) 1)
          (Pi.single (eidx (Sum.inr (Sum.inl 0))) 1)]
    rw [bmdualm_transpose_mulVec_single_inl n f R r' eidx 1 hlam hblocks hPP hP (Fin.last R),
      bmdualm_transpose_mulVec_single_inr n f R r' eidx 1 hlam hblocks hPP hP 0]
    simp [inv_one, one_smul]
  have hmat2 : Pinv * Matrix.reindex eidx eidx
        (Matrix.fromBlocks (Matrix.single (Fin.last R) 0 1)
          (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (Matrix.fromBlocks (Matrix.single 0 (Fin.last R) 1)
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) * P =
      Matrix.vecMulVec (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl 0))) 1))
        (Matrix.mulVec (bmdualmG n f)
          (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl (Fin.last R))) 1))) +
      Matrix.vecMulVec (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl (Fin.last R))) 1))
        (Matrix.mulVec (bmdualmG n f)
          (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl 0))) 1))) := by
    rw [bmdualm_reindex_fromBlocks_single n f R r' eidx (Fin.last R) 0]
    rw [Matrix.mul_add, Matrix.add_mul]
    rw [bmdualm_conj_vecMulVec n f P Pinv (Pi.single (eidx (Sum.inl (Fin.last R))) 1)
          (Pi.single (eidx (Sum.inl 0)) 1),
      bmdualm_conj_vecMulVec n f P Pinv (Pi.single (eidx (Sum.inr (Sum.inl 0))) 1)
          (Pi.single (eidx (Sum.inr (Sum.inl (Fin.last R)))) 1)]
    rw [bmdualm_transpose_mulVec_single_inl n f R r' eidx 1 hlam hblocks hPP hP 0,
      bmdualm_transpose_mulVec_single_inr n f R r' eidx 1 hlam hblocks hPP hP (Fin.last R)]
    simp only [inv_one, one_smul]
    rw [add_comm]
  refine ⟨Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl 0)) 1),
    Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl (Fin.last R)))) 1),
    Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl 0))) 1),
    Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl (Fin.last R))) 1), ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact ⟨hQA₁, hQA₂, hQB₁, hQB₂⟩
  · rw [bmdualm_polar_pinv_single n f R r' eidx 1 hblocks hPP hP (Sum.inl 0)
      (Sum.inr (Sum.inl 0))]
    simp [bmdualm_stdBlock, Matrix.fromBlocks, bmdualm_J12]
  · rw [bmdualm_polar_pinv_single n f R r' eidx 1 hblocks hPP hP
      (Sum.inr (Sum.inl (Fin.last R))) (Sum.inl (Fin.last R))]
    simp [bmdualm_stdBlock, Matrix.fromBlocks, bmdualm_J21]
  · refine ⟨?_, ?_, ?_, ?_⟩
    · rw [bmdualm_polar_pinv_single n f R r' eidx 1 hblocks hPP hP (Sum.inl 0)
        (Sum.inr (Sum.inl (Fin.last R)))]
      simp [bmdualm_stdBlock, Matrix.fromBlocks, bmdualm_J12, hij]
    · rw [bmdualm_polar_pinv_single n f R r' eidx 1 hblocks hPP hP (Sum.inr (Sum.inl 0))
        (Sum.inl (Fin.last R))]
      simp [bmdualm_stdBlock, Matrix.fromBlocks, bmdualm_J21, hij]
    · rw [bmdualm_polar_pinv_single n f R r' eidx 1 hblocks hPP hP (Sum.inl 0)
        (Sum.inl (Fin.last R))]
      simp [bmdualm_stdBlock, Matrix.fromBlocks]
    · rw [bmdualm_polar_pinv_single n f R r' eidx 1 hblocks hPP hP
        (Sum.inr (Sum.inl (Fin.last R))) (Sum.inr (Sum.inl 0))]
      simp [bmdualm_stdBlock, Matrix.fromBlocks]
  · rw [show (SpecialLinear.rootDatum R (GaloisField 2 f)).rootGroup β₀ =
        (SpecialLinear.rootGroup R (GaloisField 2 f)) β₀ from rfl,
      SpecialLinear.rootGroup_eq R (GaloisField 2 f) hij hβ₀,
      bmdualm_rootSubgroup_eq R (GaloisField 2 f) hij, MonoidHom.map_range, MonoidHom.map_range]
    apply le_antisymm
    · rw [siegelGroup]
      rintro x ⟨d, rfl⟩
      rw [MonoidHom.comp_apply, MonoidHom.comp_apply,
        Matrix.SpecialLinearGroup.transvectionHom_apply]
      exact Subgroup.subset_closure ⟨Multiplicative.toAdd d,
        bmdualm_embedHom_transvection_eq_eichler n f hn eidx hPP hPinvP hP hblock 0 (Fin.last R)
          hij (Multiplicative.toAdd d) _ _ hQA₁ hQA₂ hpol12 hmat1⟩
    · rw [siegelGroup]
      rw [Subgroup.closure_le]
      rintro g ⟨c, rfl⟩
      exact ⟨Multiplicative.ofAdd c, by
        rw [MonoidHom.comp_apply, MonoidHom.comp_apply,
          Matrix.SpecialLinearGroup.transvectionHom_apply, toAdd_ofAdd]
        exact bmdualm_embedHom_transvection_eq_eichler n f hn eidx hPP hPinvP hP hblock 0
          (Fin.last R) hij c _ _ hQA₁ hQA₂ hpol12 hmat1⟩
  · rw [show (SpecialLinear.rootDatum R (GaloisField 2 f)).rootGroup (-β₀) =
        (SpecialLinear.rootGroup R (GaloisField 2 f)) (-β₀) from rfl,
      SpecialLinear.rootGroup_eq R (GaloisField 2 f) hij.symm hβ₀neg,
      bmdualm_rootSubgroup_eq R (GaloisField 2 f) hij.symm, MonoidHom.map_range,
      MonoidHom.map_range]
    apply le_antisymm
    · rw [siegelGroup]
      rintro x ⟨d, rfl⟩
      rw [MonoidHom.comp_apply, MonoidHom.comp_apply,
        Matrix.SpecialLinearGroup.transvectionHom_apply]
      exact Subgroup.subset_closure ⟨Multiplicative.toAdd d,
        bmdualm_embedHom_transvection_eq_eichler n f hn eidx hPP hPinvP hP hblock (Fin.last R) 0
          hij.symm (Multiplicative.toAdd d) _ _ hQB₁ hQB₂ hpol34 hmat2⟩
    · rw [siegelGroup]
      rw [Subgroup.closure_le]
      rintro g ⟨c, rfl⟩
      exact ⟨Multiplicative.ofAdd c, by
        rw [MonoidHom.comp_apply, MonoidHom.comp_apply,
          Matrix.SpecialLinearGroup.transvectionHom_apply, toAdd_ofAdd]
        exact bmdualm_embedHom_transvection_eq_eichler n f hn eidx hPP hPinvP hP hblock (Fin.last R)
          0 hij.symm c _ _ hQB₁ hQB₂ hpol34 hmat2⟩

private theorem bmdualm_rootGroup_image_siegel
    (n f : ℕ) (hn : 4 ≤ n)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hform : bmdualm_IsFormStandardOne n f R r' eidx)
    (hRpos : 1 ≤ R)
    (hQA : ∀ a : Fin (R + 1),
      bmdualmQ n f (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl a)) 1)) = 0)
    (hQB : ∀ a : Fin (R + 1),
      bmdualmQ n f (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl a))) 1)) = 0)
    (g' : ℕ) (ρ : GaloisField 2 g' ≃+* GaloisField 2 f)
    {ι' : (ggU .PSL (R + 1) g').K →* ↥(spinGroup (bmdualmQ n f))}
    (hι' : ι' = (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).comp
      (bmdualm_modelHom f R g' ρ))
    (β₀ : Fin R → ℤ)
    (hβ₀ : SpecialLinear.toStd R β₀ = Pi.single 0 1 - Pi.single (Fin.last R) 1) :
    ∃ a₁ a₂ b₁ b₂ : bmdualmι n → GaloisField 2 f,
      ((bmdualmQ n f) a₁ = 0 ∧ (bmdualmQ n f) a₂ = 0 ∧
        (bmdualmQ n f) b₁ = 0 ∧ (bmdualmQ n f) b₂ = 0) ∧
      QuadraticMap.polar (bmdualmQ n f) a₁ b₁ = 1 ∧
      QuadraticMap.polar (bmdualmQ n f) a₂ b₂ = 1 ∧
      (QuadraticMap.polar (bmdualmQ n f) a₁ a₂ = 0 ∧
        QuadraticMap.polar (bmdualmQ n f) b₁ b₂ = 0 ∧
        QuadraticMap.polar (bmdualmQ n f) a₁ b₂ = 0 ∧
        QuadraticMap.polar (bmdualmQ n f) a₂ b₁ = 0) ∧
      (((ggU .PSL (R + 1) g').D.rootGroup β₀).map ι').map
          (Spin.spinAction (bmdualmQ n f)) =
        siegelGroup (bmdualmQ n f) a₁ a₂ ∧
      (((ggU .PSL (R + 1) g').D.rootGroup (-β₀)).map ι').map
          (Spin.spinAction (bmdualmQ n f)) =
        siegelGroup (bmdualmQ n f) b₁ b₂ := by
  have hij : (0 : Fin (R + 1)) ≠ Fin.last R := by
    intro h
    have := congrArg Fin.val h
    simp only [Fin.val_zero, Fin.val_last] at this
    omega
  have hβ₀neg : SpecialLinear.toStd R (-β₀) = Pi.single (Fin.last R) 1 - Pi.single 0 1 := by
    rw [SpecialLinear.toStd_neg, hβ₀]
    abel
  obtain ⟨a₁, a₂, b₁, b₂, hQ, h1, h2, h3, hg1, hg2⟩ :=
    bmdualm_embedHom_rootGroup_siegel n f hn eidx hPP hPinvP hP hblock hform hRpos hQA hQB β₀ hβ₀
  refine ⟨a₁, a₂, b₁, b₂, hQ, h1, h2, h3, ?_, ?_⟩
  · rw [hι', ← Subgroup.map_map ((ggU .PSL (R + 1) g').D.rootGroup β₀)
      (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock)
      (bmdualm_modelHom f R g' ρ)]
    rw [bmdualm_modelHom_rootGroup f R g' ρ 0 (Fin.last R) hij β₀ hβ₀]
    exact hg1
  · rw [hι', ← Subgroup.map_map ((ggU .PSL (R + 1) g').D.rootGroup (-β₀))
      (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock)
      (bmdualm_modelHom f R g' ρ)]
    rw [bmdualm_modelHom_rootGroup f R g' ρ (Fin.last R) 0 hij.symm (-β₀) hβ₀neg]
    exact hg2

private theorem bmdualm_root_configuration_explicit
    (n f : ℕ) (hn : 4 ≤ n)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hform : bmdualm_IsFormStandardOne n f R r' eidx)
    (hRpos : 1 ≤ R)
    (hQA : ∀ a : Fin (R + 1),
      bmdualmQ n f (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl a)) 1)) = 0)
    (hQB : ∀ a : Fin (R + 1),
      bmdualmQ n f (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl a))) 1)) = 0)
    (g' : ℕ) (ρ : GaloisField 2 g' ≃+* GaloisField 2 f)
    {ι' : (ggU .PSL (R + 1) g').K →* ↥(spinGroup (bmdualmQ n f))}
    (hι' : ι' = (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).comp
      (bmdualm_modelHom f R g' ρ)) :
    ∃ (β₀ : Fin (ggU .PSL (R + 1) g').D.rank → ℤ)
      (a₁ a₂ b₁ b₂ : bmdualmι n → GaloisField 2 f),
      GGLongRoot (ggU .PSL (R + 1) g').D β₀ ∧
      ((bmdualmQ n f) a₁ = 0 ∧ (bmdualmQ n f) a₂ = 0 ∧
        (bmdualmQ n f) b₁ = 0 ∧ (bmdualmQ n f) b₂ = 0) ∧
      QuadraticMap.polar (bmdualmQ n f) a₁ b₁ = 1 ∧
      QuadraticMap.polar (bmdualmQ n f) a₂ b₂ = 1 ∧
      (QuadraticMap.polar (bmdualmQ n f) a₁ a₂ = 0 ∧
        QuadraticMap.polar (bmdualmQ n f) b₁ b₂ = 0 ∧
        QuadraticMap.polar (bmdualmQ n f) a₁ b₂ = 0 ∧
        QuadraticMap.polar (bmdualmQ n f) a₂ b₁ = 0) ∧
      (((ggU .PSL (R + 1) g').D.rootGroup β₀).map ι').map
          (Spin.spinAction (bmdualmQ n f)) =
        siegelGroup (bmdualmQ n f) a₁ a₂ ∧
      (((ggU .PSL (R + 1) g').D.rootGroup (-β₀)).map ι').map
          (Spin.spinAction (bmdualmQ n f)) =
        siegelGroup (bmdualmQ n f) b₁ b₂ := by
  obtain ⟨β₀, _hβ₀mem, hlong, _hβ₀std⟩ := bmdualm_model_long_root R (GaloisField 2 g') hRpos
  obtain ⟨a₁, a₂, b₁, b₂, hrest⟩ :=
    bmdualm_rootGroup_image_siegel n f hn eidx hPP hPinvP hP hblock hform hRpos hQA hQB g' ρ
      (hι' := hι') β₀ _hβ₀std
  exact ⟨β₀, a₁, a₂, b₁, b₂, hlong, hrest⟩

private theorem bmdualm_closure_transport {K G H : Type*} [Group K] [Group G] [Group H]
    (ι : K →* G) (s : G →* H) (hs : Function.Injective s) (X : Subgroup K) (Y : Subgroup H)
    (hY : (X.map ι).map s = Y) (u : K) :
    ((X.map (MulAut.conj u).toMonoidHom).map ι).map s =
      Subgroup.map s (Subgroup.map (MulAut.conj (ι u)).toMonoidHom (Subgroup.comap s Y)) := by
  have hcomap : Subgroup.comap s Y = X.map ι := by
    apply le_antisymm
    · intro x hx
      rw [Subgroup.mem_comap] at hx
      rw [← hY] at hx
      obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
      rwa [hs hyx] at hy
    · intro x hx
      rw [Subgroup.mem_comap, ← hY]
      exact Subgroup.mem_map.mpr ⟨x, hx, rfl⟩
  rw [hcomap]
  simp only [Subgroup.map_map]
  congr 1
  ext x
  simp [MonoidHom.comp_apply, MulAut.conj_apply, map_mul, map_inv]

private theorem bmdualm_polar_single_left (n f : ℕ) (j : bmdualmι n)
    (v : bmdualmι n → GaloisField 2 f) :
    QuadraticMap.polar (bmdualmQ n f) (Pi.single j 1) v =
      Matrix.mulVec (bmdualmG n f) v j := by
  rw [bmdualm_polar_eq_dot]
  change dotProduct (Pi.single j 1) (Matrix.mulVec (bmdualmG n f) v) =
    Matrix.mulVec (bmdualmG n f) v j
  rw [dotProduct]
  rw [Finset.sum_eq_single j]
  · rw [Pi.single_eq_same, one_mul]
  · intro b _ hb
    rw [Pi.single_eq_of_ne hb, zero_mul]
  · intro h
    exact absurd (Finset.mem_univ j) h

private theorem bmdualm_toMatrix_eichler (n f : ℕ) {a₁ a₂ : bmdualmι n → GaloisField 2 f}
    (hQa₁ : bmdualmQ n f a₁ = 0)
    (hQa₂ : bmdualmQ n f a₂ = 0)
    (horth : QuadraticMap.polar (bmdualmQ n f) a₁ a₂ = 0) :
    LinearMap.toMatrix' (CFSG.ClassicalGroups.Orthogonal.eichler (bmdualmQ n f)
        a₁ a₂).toLinearMap =
      1 + (Matrix.vecMulVec a₂ (Matrix.mulVec (bmdualmG n f) a₁) +
        Matrix.vecMulVec a₁ (Matrix.mulVec (bmdualmG n f) a₂)) := by
  ext i j
  rw [LinearMap.toMatrix'_apply, Matrix.add_apply, Matrix.one_apply, Matrix.add_apply,
    Matrix.vecMulVec_apply, Matrix.vecMulVec_apply]
  have h1 := CFSG.ClassicalGroups.Orthogonal.eichler_apply (Q := bmdualmQ n f)
    hQa₁ horth (Pi.single j 1)
  change (CFSG.ClassicalGroups.Orthogonal.eichler (bmdualmQ n f) a₁ a₂
      (Pi.single j 1)) i = (if i = j then 1 else 0) +
    (a₂ i * (Matrix.mulVec (bmdualmG n f) a₁) j +
      a₁ i * (Matrix.mulVec (bmdualmG n f) a₂) j)
  rw [h1]
  rw [Pi.sub_apply, Pi.add_apply, Pi.smul_apply, Pi.smul_apply]
  rw [hQa₂, zero_mul, add_zero, CharTwo.sub_eq_add]
  rw [bmdualm_polar_single_left, bmdualm_polar_single_left, Pi.single_apply]
  ring

private theorem bmdualm_eichler_mem_embedGL_range
    (n f : ℕ) (hn : 4 ≤ n)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    {a₁ a₂ : bmdualmι n → GaloisField 2 f}
    (hQa₁ : bmdualmQ n f a₁ = 0)
    (hQa₂ : bmdualmQ n f a₂ = 0)
    (horth : QuadraticMap.polar (bmdualmQ n f) a₁ a₂ = 0)
    (hEmem : CFSG.ClassicalGroups.Orthogonal.eichler (bmdualmQ n f) a₁ a₂ ∈
      (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range.map
        (Spin.spinAction (bmdualmQ n f))) :
    ∃ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
      1 + (Matrix.vecMulVec a₂ (Matrix.mulVec (bmdualmG n f) a₁) +
        Matrix.vecMulVec a₁ (Matrix.mulVec (bmdualmG n f) a₂)) := by
  obtain ⟨y, hy, hyE⟩ := Subgroup.mem_map.mp hEmem
  obtain ⟨x, hx⟩ := MonoidHom.mem_range.mp hy
  rw [← hx] at hyE
  refine ⟨x, ?_⟩
  rw [← bmdualm_embedSpin_spinMatrix n f R r' hn eidx hPP hPinvP hP hblock x]
  rw [Spin.coe_spinMatrix]
  rw [show Spin.spinAction (bmdualmQ n f)
        (bmdualm_embedSpin n f R r' hn eidx P Pinv hPP hPinvP hP hblock x) =
      Spin.spinAction (bmdualmQ n f)
        (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock x) from rfl]
  rw [hyE]
  rw [bmdualm_toMatrix_eichler n f hQa₁ hQa₂ horth]

private theorem bmdualm_rank_reindex_blockMat (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) - 1).rank =
      2 * ((x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1).rank := by
  have hreindex : Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) - 1 =
      Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x - 1) := by
    change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdualm_blockMat n f (R + 1) r' x) - 1 =
      (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdualm_blockMat n f (R + 1) r' x - 1)
    rw [map_sub, map_one]
  rw [hreindex, Matrix.rank_reindex, bmdualm_blockMat_sub_one,
    bmdualm_rank_fromBlocks_zero (GaloisField 2 f),
    bmdualm_rank_fromBlocks_zero (GaloisField 2 f), Matrix.rank_zero,
    bmdualm_rank_inv_transpose_sub_one]
  ring

private theorem bmdualm_rank_one_eq_vecMulVec {m n : Type*} [Fintype m] [Fintype n]
    (F : Type) [Field F] (A : Matrix m n F) (hA : A.rank ≤ 1) :
    ∃ v : m → F, ∃ φ : n → F, A = Matrix.vecMulVec v φ := by
  classical
  by_cases hA0 : A = 0
  · subst hA0
    exact ⟨0, 0, by ext i j; simp [Matrix.vecMulVec]⟩
  · obtain ⟨i, hi⟩ : ∃ i, A.row i ≠ 0 := by
      by_contra h
      push Not at h
      exact hA0 (by ext k l; simpa using congrFun (h k) l)
    have hrank : A.rank = Module.finrank F (Submodule.span F (Set.range A.row)) :=
      Matrix.rank_eq_finrank_span_row A
    have hle1 : Module.finrank F (Submodule.span F (Set.range A.row)) ≤ 1 := by
      rw [← hrank]; exact hA
    have hspan_le : Submodule.span F ({A.row i} : Set (n → F)) ≤
        Submodule.span F (Set.range A.row) := by
      apply Submodule.span_le.mpr
      rintro x rfl
      exact Submodule.subset_span ⟨i, rfl⟩
    have hfr : Module.finrank F (Submodule.span F ({A.row i} : Set (n → F))) = 1 := by
      have hsp : Submodule.span F ({A.row i} : Set (n → F)) = F ∙ A.row i := rfl
      rw [hsp]
      exact finrank_span_singleton hi
    have hspan_eq : Submodule.span F ({A.row i} : Set (n → F)) =
        Submodule.span F (Set.range A.row) :=
      Submodule.eq_of_le_of_finrank_le hspan_le (by rw [hfr]; exact hle1)
    have hrow : ∀ k, ∃ c : F, c • A.row i = A.row k := by
      intro k
      have hmem : A.row k ∈ Submodule.span F (Set.range A.row) :=
        Submodule.subset_span ⟨k, rfl⟩
      rw [← hspan_eq] at hmem
      change A.row k ∈ F ∙ A.row i at hmem
      rwa [Submodule.mem_span_singleton] at hmem
    choose v hv using hrow
    exact ⟨v, fun l => A i l, by
      ext k l
      have h := congrFun (hv k) l
      simpa [Matrix.vecMulVec_apply, Pi.smul_apply, smul_eq_mul] using h.symm⟩

private theorem bmdualm_vecMulVec_eq_replicate (R f : ℕ)
    (v φ : Fin R → GaloisField 2 f) :
    Matrix.vecMulVec v φ = Matrix.replicateCol (Fin 1) v * Matrix.replicateRow (Fin 1) φ := by
  ext i j
  simp [Matrix.vecMulVec_apply, Matrix.mul_apply, Matrix.replicateCol, Matrix.replicateRow]

private theorem bmdualm_det_one_add_vecMulVec (R f : ℕ)
    (v φ : Fin R → GaloisField 2 f) :
    (1 + Matrix.vecMulVec v φ).det = 1 + φ ⬝ᵥ v := by
  rw [bmdualm_vecMulVec_eq_replicate]
  rw [Matrix.det_one_add_mul_comm (Matrix.replicateCol (Fin 1) v)
      (Matrix.replicateRow (Fin 1) φ), Matrix.det_unique]
  simp [Matrix.add_apply, Matrix.one_apply, Matrix.mul_apply, Matrix.replicateCol,
    Matrix.replicateRow, dotProduct]

private theorem bmdualm_siegel_gen_rank_one
    (n f : ℕ) (hn : 4 ≤ n)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hform : bmdualm_IsFormStandard n f R r' eidx)
    {a₁ a₂ : bmdualmι n → GaloisField 2 f}
    (hQa₁ : bmdualmQ n f a₁ = 0)
    (hQa₂ : bmdualmQ n f a₂ = 0)
    (horth : QuadraticMap.polar (bmdualmQ n f) a₁ a₂ = 0)
    (ha₂ : a₂ ≠ 0)
    (hli : LinearIndependent (GaloisField 2 f) ![a₁, a₂])
    {x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)}
    (hx : ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
      1 + (Matrix.vecMulVec a₂ (Matrix.mulVec (bmdualmG n f) a₁) +
        Matrix.vecMulVec a₁ (Matrix.mulVec (bmdualmG n f) a₂))) :
    ∃ v φ : Fin (R + 1) → GaloisField 2 f, v ≠ 0 ∧ φ ≠ 0 ∧ φ ⬝ᵥ v = 0 ∧
      (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1 =
        Matrix.vecMulVec v φ := by
  set τ : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f) :=
    Matrix.vecMulVec a₂ (Matrix.mulVec (bmdualmG n f) a₁) +
      Matrix.vecMulVec a₁ (Matrix.mulVec (bmdualmG n f) a₂) with hτdef
  have hGdet : (bmdualmG n f).det ≠ 0 :=
    isUnit_iff_ne_zero.mp (bmdualm_G_isUnit_det n f)
  have hτne : τ ≠ 0 := by
    intro hτ0
    rw [hτdef] at hτ0
    obtain ⟨i, hi⟩ : ∃ i, a₂ i ≠ 0 := by
      by_contra h
      push Not at h
      exact ha₂ (funext h)
    have hrel : a₂ i • Matrix.mulVec (bmdualmG n f) a₁ +
        a₁ i • Matrix.mulVec (bmdualmG n f) a₂ = 0 := by
      funext j
      have h := congrFun (congrFun hτ0 i) j
      simpa [Matrix.add_apply, Matrix.vecMulVec_apply, Matrix.zero_apply, Pi.add_apply,
        Pi.smul_apply, smul_eq_mul] using h
    have hneg : ∀ z : bmdualmι n → GaloisField 2 f, -z = z := by
      intro z
      rw [← neg_one_smul (GaloisField 2 f) z, CharTwo.neg_eq (1 : GaloisField 2 f), one_smul]
    have h2 : a₂ i • Matrix.mulVec (bmdualmG n f) a₁ =
        a₁ i • Matrix.mulVec (bmdualmG n f) a₂ := by
      have h := eq_neg_of_add_eq_zero_left hrel
      rw [hneg] at h
      exact h
    have hc : Matrix.mulVec (bmdualmG n f) a₁ =
        ((a₂ i)⁻¹ * a₁ i) • Matrix.mulVec (bmdualmG n f) a₂ := by
      calc Matrix.mulVec (bmdualmG n f) a₁
          = (a₂ i)⁻¹ • (a₂ i • Matrix.mulVec (bmdualmG n f) a₁) := by
            rw [smul_smul, inv_mul_cancel₀ hi, one_smul]
        _ = (a₂ i)⁻¹ • (a₁ i • Matrix.mulVec (bmdualmG n f) a₂) := by
            rw [h2]
        _ = ((a₂ i)⁻¹ * a₁ i) • Matrix.mulVec (bmdualmG n f) a₂ := by
            rw [smul_smul]
    have ha₁ : a₁ = ((a₂ i)⁻¹ * a₁ i) • a₂ := by
      have hzero : Matrix.mulVec (bmdualmG n f)
          (a₁ - ((a₂ i)⁻¹ * a₁ i) • a₂) = 0 := by
        rw [Matrix.mulVec_sub, Matrix.mulVec_smul, hc, sub_self]
      exact sub_eq_zero.mp (Matrix.eq_zero_of_mulVec_eq_zero hGdet hzero)
    exact one_ne_zero
      (((LinearIndependent.pair_iff.mp hli) 1 (-((a₂ i)⁻¹ * a₁ i)) (by
        rw [one_smul, neg_smul, ← sub_eq_add_neg]
        nth_rewrite 1 [ha₁]
        rw [sub_self])).1)
  have hτrank : τ.rank ≤ 2 := by
    have hspan1 : ∀ x : bmdualmι n → GaloisField 2 f,
        Module.finrank (GaloisField 2 f) ↥(Submodule.span (GaloisField 2 f) {x}) ≤ 1 := by
      intro x
      rw [finrank_le_one_iff]
      refine ⟨⟨x, Submodule.subset_span rfl⟩, ?_⟩
      intro w
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp w.2
      exact ⟨c, Subtype.ext hc⟩
    rw [Matrix.rank_eq_finrank_span_cols]
    have hsub : Submodule.span (GaloisField 2 f) (Set.range τ.col) ≤
        Submodule.span (GaloisField 2 f) {a₁} ⊔
          Submodule.span (GaloisField 2 f) {a₂} := by
      rw [Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      have hcol : τ.col j = ((Matrix.mulVec (bmdualmG n f) a₁) j) • a₂ +
          ((Matrix.mulVec (bmdualmG n f) a₂) j) • a₁ := by
        funext i
        simp only [hτdef, Matrix.col_apply, Matrix.add_apply, Matrix.vecMulVec_apply,
          Pi.add_apply, Pi.smul_apply, smul_eq_mul]
        ring
      rw [hcol]
      exact add_mem
        (Submodule.smul_mem _ _ (Submodule.mem_sup_right (Submodule.subset_span rfl)))
        (Submodule.smul_mem _ _ (Submodule.mem_sup_left (Submodule.subset_span rfl)))
    calc Module.finrank (GaloisField 2 f)
          ↥(Submodule.span (GaloisField 2 f) (Set.range τ.col))
        ≤ Module.finrank (GaloisField 2 f) ↥(Submodule.span (GaloisField 2 f) {a₁} ⊔
            Submodule.span (GaloisField 2 f) {a₂}) :=
          Submodule.finrank_mono hsub
      _ ≤ Module.finrank (GaloisField 2 f) ↥(Submodule.span (GaloisField 2 f) {a₁}) +
            Module.finrank (GaloisField 2 f) ↥(Submodule.span (GaloisField 2 f) {a₂}) :=
          Submodule.finrank_add_le_finrank_add_finrank _ _
      _ ≤ 1 + 1 := add_le_add (hspan1 a₁) (hspan1 a₂)
      _ = 2 := by norm_num
  have hτeq : τ = Pinv * Matrix.reindex eidx eidx
      (bmdualm_blockMat n f (R + 1) r' x) * P - 1 := by
    have h := hx
    rw [bmdualm_embedGL_coe n f R r' eidx hPP hPinvP x] at h
    rw [h]
    abel
  have hrank_eq : τ.rank = 2 * ((x : Matrix (Fin (R + 1)) (Fin (R + 1))
      (GaloisField 2 f)) - 1).rank := by
    rw [hτeq, bmdualm_rank_sub_one_conj n f P Pinv
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) hPP hPinvP,
      bmdualm_rank_reindex_blockMat n f R r' eidx x]
  have hmrank : ((x : Matrix (Fin (R + 1)) (Fin (R + 1))
      (GaloisField 2 f)) - 1).rank ≤ 1 := by
    have h2 : 2 * ((x : Matrix (Fin (R + 1)) (Fin (R + 1))
        (GaloisField 2 f)) - 1).rank ≤ 2 := by
      rw [← hrank_eq]
      exact hτrank
    omega
  obtain ⟨v, φ, hvφ⟩ := bmdualm_rank_one_eq_vecMulVec (m := Fin (R + 1))
    (n := Fin (R + 1)) (GaloisField 2 f)
    ((x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1) hmrank
  have hm0 : (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1 ≠ 0 := by
    intro hm
    apply hτne
    have hx1 : x = 1 := Subtype.ext (by simpa using sub_eq_zero.mp hm)
    have hemb : bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x = 1 := by
      rw [hx1, map_one]
    have h1 : (1 : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) = 1 + τ := by
      have h := hx
      rw [hemb] at h
      simpa using h
    exact add_left_cancel (h1.symm.trans (add_zero 1).symm)
  have hφv : φ ⬝ᵥ v = 0 := by
    have hx1 : (1 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) +
        Matrix.vecMulVec v φ =
        (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) := by
      rw [← hvφ]; abel
    have hdet : (1 + Matrix.vecMulVec v φ).det = 1 := by
      rw [hx1, Matrix.SpecialLinearGroup.det_coe]
    have hdet2 := bmdualm_det_one_add_vecMulVec (R + 1) f v φ
    rw [hdet] at hdet2
    exact add_left_cancel (hdet2.symm.trans (add_zero 1).symm)
  refine ⟨v, φ, ?_, ?_, hφv, hvφ⟩
  · intro hv0
    have hne : Matrix.vecMulVec v φ ≠ 0 := by rw [← hvφ]; exact hm0
    exact hne (by rw [hv0]; exact Matrix.zero_vecMulVec φ)
  · intro hφ0
    have hne : Matrix.vecMulVec v φ ≠ 0 := by rw [← hvφ]; exact hm0
    exact hne (by rw [hφ0]; exact Matrix.vecMulVec_zero v)

private theorem bmdualm_smul_vecMulVec (R f : ℕ)
    (v φ : Fin R → GaloisField 2 f) (c : GaloisField 2 f) :
    c • Matrix.vecMulVec v φ = Matrix.vecMulVec (c • v) φ := by
  ext i j
  simp only [Matrix.vecMulVec_apply, Matrix.smul_apply, Pi.smul_apply, smul_eq_mul]
  ring

private theorem bmdualm_det_one_add_smul_vecMulVec (R f : ℕ)
    (v φ : Fin R → GaloisField 2 f) (h : φ ⬝ᵥ v = 0) (c : GaloisField 2 f) :
    (1 + c • Matrix.vecMulVec v φ).det = 1 := by
  rw [bmdualm_smul_vecMulVec, bmdualm_det_one_add_vecMulVec, dotProduct_smul, h, smul_zero,
    add_zero]

private theorem bmdualm_vecMulVec_mul_self (R f : ℕ)
    (v φ : Fin R → GaloisField 2 f) :
    Matrix.vecMulVec v φ * Matrix.vecMulVec v φ =
      (φ ⬝ᵥ v) • Matrix.vecMulVec v φ := by
  rw [Matrix.vecMulVec_mul_vecMulVec, Matrix.vecMulVec_smul]

private theorem bmdualm_generators_subset_range_toGL (R f : ℕ)
    (v φ : Fin R → GaloisField 2 f) (h : φ ⬝ᵥ v = 0) :
    {g : GL (Fin R) (GaloisField 2 f) | ∃ c : GaloisField 2 f,
      (g : Matrix (Fin R) (Fin R) (GaloisField 2 f)) = 1 + c • Matrix.vecMulVec v φ} ⊆
      (Matrix.SpecialLinearGroup.toGL (n := Fin R) (R := GaloisField 2 f)).range := by
  rintro g ⟨c, hg⟩
  rw [Matrix.SpecialLinearGroup.range_toGL_eq_ker_det]
  change Matrix.GeneralLinearGroup.det g = 1
  apply Units.ext
  rw [Matrix.GeneralLinearGroup.val_det_apply, hg]
  simpa using bmdualm_det_one_add_smul_vecMulVec R f v φ h c

private theorem bmdualm_comap_closure_of_injective {G H : Type*} [Group G] [Group H]
    (f : G →* H) (hf : Function.Injective f) (s : Set H) (hs : s ⊆ Set.range f) :
    Subgroup.comap f (Subgroup.closure s) = Subgroup.closure (f ⁻¹' s) := by
  apply Subgroup.map_injective hf
  rw [Subgroup.map_comap_eq, MonoidHom.map_closure, Set.image_preimage_eq_inter_range,
    Set.inter_eq_left.mpr hs]
  exact inf_eq_right.mpr ((Subgroup.closure_le f.range).mpr hs)

private theorem bmdualm_comap_map_eq_of_injective {G H : Type*} [Group G] [Group H]
    (f : G →* H) (hf : Function.Injective f) (K : Subgroup G) :
    Subgroup.comap f (Subgroup.map f K) = K := by
  apply le_antisymm
  · intro x hx
    obtain ⟨k, hk, hkx⟩ := Subgroup.mem_map.mp hx
    rw [← hf hkx]
    exact hk
  · intro x hx
    exact Subgroup.mem_map.mpr ⟨x, hx, rfl⟩

private theorem bmdualm_blockMat_of_eq_one_add (n f R r' : ℕ)
    (w : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (c : GaloisField 2 f) (m : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
    (hm : m * m = 0)
    (hw : (w : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 + c • m) :
    bmdualm_blockMat n f (R + 1) r' w =
      1 + c • (Matrix.fromBlocks m
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (Matrix.fromBlocks (Matrix.transpose m)
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))) := by
  have hmc : (c • m) * (c • m) = 0 := by
    rw [Matrix.smul_mul, Matrix.mul_smul, hm, smul_zero, smul_zero]
  have hww : w * w = 1 := by
    apply Subtype.ext
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_one, hw]
    rw [Matrix.add_mul, Matrix.one_mul, Matrix.mul_add, Matrix.mul_one, hmc, add_zero]
    rw [add_assoc, CharTwo.add_self_eq_zero, add_zero]
  have hwinv : w⁻¹ = w := inv_eq_of_mul_eq_one_right hww
  unfold bmdualm_blockMat
  rw [hwinv, hw]
  ext p q
  rcases p with a | (b | d) <;> rcases q with a' | (b' | d') <;>
    simp [Matrix.fromBlocks, Matrix.transpose_apply, Matrix.add_apply, Matrix.smul_apply,
      Matrix.one_apply, Matrix.zero_apply]

private theorem bmdualm_blockMat_sub_one_of_sq_zero (n f R r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (m : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
    (hx : (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 + m)
    (hm : m * m = 0) :
    bmdualm_blockMat n f (R + 1) r' x - 1 =
      Matrix.fromBlocks m
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (Matrix.fromBlocks (Matrix.transpose m)
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) := by
  have hx1sq : x * x = 1 := by
    apply Subtype.ext
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_one, hx]
    rw [Matrix.add_mul, Matrix.one_mul, Matrix.mul_add, Matrix.mul_one, hm, add_zero, add_assoc]
    ext i j
    simp only [Matrix.add_apply, Matrix.one_apply]
    rw [CharTwo.add_self_eq_zero, add_zero]
  have hxinv : ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
      Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) =
      (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) := by
    rw [show x⁻¹ = x from inv_eq_of_mul_eq_one_right hx1sq]
  rw [bmdualm_blockMat_sub_one]
  congr 1
  · rw [hx]; abel
  · rw [hxinv, hx, Matrix.transpose_add, Matrix.transpose_one]; abel

private theorem bmdualm_toMatrix_spinAction_embedHom (n f R r' : ℕ) (hn : 4 ≤ n)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (y : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    LinearMap.toMatrix' ((Spin.spinAction (bmdualmQ n f)
        (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock y)).toLinearMap) =
      ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP y : GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) := by
  have h := Spin.coe_spinMatrix (bmdualmQ n f)
    (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock y)
  rw [← h]
  exact bmdualm_embedSpin_spinMatrix n f R r' hn eidx hPP hPinvP hP hblock y

private theorem bmdualm_toGL_injective (R f : ℕ) :
    Function.Injective (Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
      (R := GaloisField 2 f)) := by
  intro a b h
  exact Subtype.ext (congrArg (fun z : GL (Fin (R + 1)) (GaloisField 2 f) =>
    (z : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) h)

private theorem bmdualm_matTransv_of_embedGL_rank_one
    (n f : ℕ) (hn : 4 ≤ n)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    {a₁ a₂ : bmdualmι n → GaloisField 2 f}
    (hQa₁ : bmdualmQ n f a₁ = 0)
    (hQa₂ : bmdualmQ n f a₂ = 0)
    (horth : QuadraticMap.polar (bmdualmQ n f) a₁ a₂ = 0)
    {x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)}
    (hx : ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
      1 + (Matrix.vecMulVec a₂ (Matrix.mulVec (bmdualmG n f) a₁) +
        Matrix.vecMulVec a₁ (Matrix.mulVec (bmdualmG n f) a₂)))
    {v φ : Fin (R + 1) → GaloisField 2 f} (hφv : φ ⬝ᵥ v = 0)
    (hM : (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1 =
      Matrix.vecMulVec v φ) :
    Subgroup.comap (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock)
      (Subgroup.comap (Spin.spinAction (bmdualmQ n f))
        (siegelGroup (bmdualmQ n f) a₁ a₂)) =
      Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v φ) := by
  have hm2 : Matrix.vecMulVec v φ * Matrix.vecMulVec v φ = 0 := by
    rw [bmdualm_vecMulVec_mul_self, hφv, zero_smul]
  have hx1 : (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) =
      1 + Matrix.vecMulVec v φ := by
    rw [← hM]; abel
  set τ : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f) :=
    Matrix.vecMulVec a₂ (Matrix.mulVec (bmdualmG n f) a₁) +
      Matrix.vecMulVec a₁ (Matrix.mulVec (bmdualmG n f) a₂) with hτdef
  have hτeq : τ = Pinv * Matrix.reindex eidx eidx
      (bmdualm_blockMat n f (R + 1) r' x - 1) * P := by
    have h : ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x :
        GL (bmdualmι n) (GaloisField 2 f)) : Matrix (bmdualmι n) (bmdualmι n)
          (GaloisField 2 f)) = 1 + τ := hx
    rw [bmdualm_embedGL_coe n f R r' eidx hPP hPinvP x] at h
    have h2 : Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) =
        1 + (1 : GaloisField 2 f) • Matrix.reindex eidx eidx
          (bmdualm_blockMat n f (R + 1) r' x - 1) := by
      conv_lhs => rw [show bmdualm_blockMat n f (R + 1) r' x =
          1 + (1 : GaloisField 2 f) • (bmdualm_blockMat n f (R + 1) r' x - 1)
          from by rw [one_smul]; abel]
      exact bmdualm_reindex_add_smul f eidx (1 : GaloisField 2 f)
        (bmdualm_blockMat n f (R + 1) r' x - 1)
    have h3 : Pinv * (1 + (1 : GaloisField 2 f) • Matrix.reindex eidx eidx
        (bmdualm_blockMat n f (R + 1) r' x - 1)) * P =
        1 + Pinv * Matrix.reindex eidx eidx
          (bmdualm_blockMat n f (R + 1) r' x - 1) * P := by
      simpa using bmdualm_conj_add_smul n f P Pinv hPinvP (1 : GaloisField 2 f)
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x - 1))
    rw [h2, h3] at h
    exact (add_left_cancel h).symm
  have hFwd : ∀ (y : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (c : GaloisField 2 f),
      (y : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) =
        1 + c • Matrix.vecMulVec v φ →
      Spin.spinAction (bmdualmQ n f)
        (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock y) =
        CFSG.ClassicalGroups.Orthogonal.eichler (bmdualmQ n f) a₁
          (c • a₂) := by
    intro y c hy
    have hblock_y : bmdualm_blockMat n f (R + 1) r' y =
        1 + c • (bmdualm_blockMat n f (R + 1) r' x - 1) := by
      rw [bmdualm_blockMat_of_eq_one_add n f R r' y c (Matrix.vecMulVec v φ) hm2 hy,
        bmdualm_blockMat_sub_one_of_sq_zero n f R r' x (Matrix.vecMulVec v φ) hx1 hm2]
    have hemb : ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP y :
        GL (bmdualmι n) (GaloisField 2 f)) : Matrix (bmdualmι n) (bmdualmι n)
          (GaloisField 2 f)) = 1 + c • τ := by
      rw [bmdualm_embedGL_coe n f R r' eidx hPP hPinvP y, hblock_y,
        bmdualm_reindex_add_smul, bmdualm_conj_add_smul n f P Pinv hPinvP, ← hτeq]
    have hemb' : ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP y :
        GL (bmdualmι n) (GaloisField 2 f)) : Matrix (bmdualmι n) (bmdualmι n)
          (GaloisField 2 f)) =
        1 + c • (Matrix.vecMulVec a₂ (Matrix.mulVec (bmdualmG n f) a₁) +
          Matrix.vecMulVec a₁ (Matrix.mulVec (bmdualmG n f) a₂)) := by
      rw [hemb, hτdef]
    have hσ : LinearMap.toMatrix' ((Spin.spinAction (bmdualmQ n f)
        (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock y)).toLinearMap) =
        1 + c • (Matrix.vecMulVec a₂ (Matrix.mulVec (bmdualmG n f) a₁) +
          Matrix.vecMulVec a₁ (Matrix.mulVec (bmdualmG n f) a₂)) := by
      rw [bmdualm_toMatrix_spinAction_embedHom n f R r' hn eidx hPP hPinvP hP hblock y, hemb']
    have hQc : bmdualmQ n f (c • a₂) = 0 := by
      rw [QuadraticMap.map_smul, hQa₂, smul_zero]
    have horthc : QuadraticMap.polar (bmdualmQ n f) a₁ (c • a₂) = 0 := by
      rw [QuadraticMap.polar_smul_right, horth, smul_zero]
    have hσe : LinearMap.toMatrix' ((CFSG.ClassicalGroups.Orthogonal.eichler
        (bmdualmQ n f) a₁ (c • a₂)).toLinearMap) =
        1 + c • (Matrix.vecMulVec a₂ (Matrix.mulVec (bmdualmG n f) a₁) +
          Matrix.vecMulVec a₁ (Matrix.mulVec (bmdualmG n f) a₂)) := by
      rw [bmdualm_toMatrix_eichler n f hQa₁ hQc horthc, Matrix.smul_vecMulVec,
        Matrix.mulVec_smul, Matrix.vecMulVec_smul, ← smul_add]
    exact LinearEquiv.toLinearMap_injective
      (LinearMap.toMatrix'.injective (by rw [hσ, hσe]))
  have htoGLinj : Function.Injective (Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
      (R := GaloisField 2 f)) := bmdualm_toGL_injective R f
  have hcompinj : Function.Injective ((Spin.spinAction (bmdualmQ n f)).comp
      (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock)) :=
    (CFSG.StandardType.RootCentOmega.spinAction_quadMinus_injective (n := n)
      (K := GaloisField 2 f) (minusCoeffs_irr 2 f)).comp
      (bmdualm_embedHom_injective n f R r' hn eidx hPP hPinvP hP hblock)
  let Tgen : Set (GL (Fin (R + 1)) (GaloisField 2 f)) :=
    {g | ∃ c : GaloisField 2 f, (g : Matrix (Fin (R + 1)) (Fin (R + 1))
      (GaloisField 2 f)) = 1 + c • Matrix.vecMulVec v φ}
  let Sgen : Set ((bmdualmι n → GaloisField 2 f) ≃ₗ[GaloisField 2 f]
      (bmdualmι n → GaloisField 2 f)) :=
    {g | ∃ c : GaloisField 2 f, g = CFSG.ClassicalGroups.Orthogonal.eichler
      (bmdualmQ n f) a₁ (c • a₂)}
  have hT : Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v φ) =
      Subgroup.closure ((Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
        (R := GaloisField 2 f)) ⁻¹' Tgen) := by
    rw [matTransvGroup]
    exact bmdualm_comap_closure_of_injective (Matrix.SpecialLinearGroup.toGL) htoGLinj Tgen
      (bmdualm_generators_subset_range_toGL (R + 1) f v φ hφv)
  have hset : ((Spin.spinAction (bmdualmQ n f)).comp
        (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock)) ''
      ((Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
        (R := GaloisField 2 f)) ⁻¹' Tgen) = Sgen := by
    ext g
    constructor
    · rintro ⟨y, hy, rfl⟩
      obtain ⟨c, hc⟩ := hy
      exact ⟨c, hFwd y c hc⟩
    · rintro ⟨c, rfl⟩
      have hcm2 : (c • Matrix.vecMulVec v φ) * (c • Matrix.vecMulVec v φ) = 0 := by
        rw [Matrix.smul_mul, Matrix.mul_smul, hm2, smul_zero, smul_zero]
      have hsq : (1 + c • Matrix.vecMulVec v φ) * (1 + c • Matrix.vecMulVec v φ) = 1 := by
        rw [Matrix.add_mul, Matrix.one_mul, Matrix.mul_add, Matrix.mul_one, hcm2, add_zero,
          add_assoc, CharTwo.add_self_eq_zero, add_zero]
      let g₀ : GL (Fin (R + 1)) (GaloisField 2 f) :=
        Units.mk (1 + c • Matrix.vecMulVec v φ) (1 + c • Matrix.vecMulVec v φ) hsq hsq
      have hg₀ : g₀ ∈ (Matrix.SpecialLinearGroup.toGL (n := Fin (R + 1))
          (R := GaloisField 2 f)).range :=
        bmdualm_generators_subset_range_toGL (R + 1) f v φ hφv ⟨c, rfl⟩
      obtain ⟨y, hy⟩ := hg₀
      have hy' : (y : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) =
          1 + c • Matrix.vecMulVec v φ := by
        have := congrArg (fun z : GL (Fin (R + 1)) (GaloisField 2 f) =>
          (z : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) hy
        simpa using this
      exact ⟨y, ⟨c, hy'⟩, hFwd y c hy'⟩
  have hmap : Subgroup.map ((Spin.spinAction (bmdualmQ n f)).comp
      (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock))
      (Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v φ)) =
      siegelGroup (bmdualmQ n f) a₁ a₂ := by
    rw [hT, MonoidHom.map_closure, hset, siegelGroup]
  rw [Subgroup.comap_comap]
  rw [← hmap]
  exact bmdualm_comap_map_eq_of_injective _ hcompinj _

private theorem bmdualm_conj_vecMulVec' {m : Type*} [Fintype m]
    (F : Type) [Field F] (A B : Matrix m m F) (u v : m → F) :
    A * Matrix.vecMulVec u v * B =
      Matrix.vecMulVec (Matrix.mulVec A u) (Matrix.mulVec (Matrix.transpose B) v) := by
  ext i k
  simp only [Matrix.mul_apply, Matrix.vecMulVec_apply, Matrix.mulVec, dotProduct]
  rw [Finset.sum_mul_sum, Finset.sum_comm]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl (fun l _ => ?_)
  rw [Matrix.transpose_apply]
  ring

private theorem bmdualm_coe_conj_toGL (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (h : GL (Fin R') (GaloisField 2 f)) :
    ((MulAut.conj (Matrix.SpecialLinearGroup.toGL g)) h :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)) =
    (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) *
      (h : Matrix (Fin R') (Fin R') (GaloisField 2 f)) *
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)) := by
  rw [MulAut.conj_apply, Units.val_mul, Units.val_mul,
    show (Matrix.SpecialLinearGroup.toGL g)⁻¹ = Matrix.SpecialLinearGroup.toGL g⁻¹ from
      (map_inv _ _).symm,
    Matrix.SpecialLinearGroup.coe_GL_coe_matrix g,
    Matrix.SpecialLinearGroup.coe_GL_coe_matrix g⁻¹]

private theorem bmdualm_coe_conj_toGL_inv (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (h : GL (Fin R') (GaloisField 2 f)) :
    (((MulAut.conj (Matrix.SpecialLinearGroup.toGL g))⁻¹) h :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)) =
    ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)) *
      (h : Matrix (Fin R') (Fin R') (GaloisField 2 f)) *
      (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) := by
  rw [MulAut.conj_inv_apply, Units.val_mul, Units.val_mul,
    show (Matrix.SpecialLinearGroup.toGL g)⁻¹ = Matrix.SpecialLinearGroup.toGL g⁻¹ from
      (map_inv _ _).symm,
    Matrix.SpecialLinearGroup.coe_GL_coe_matrix g,
    Matrix.SpecialLinearGroup.coe_GL_coe_matrix g⁻¹]

private theorem bmdualm_map_conj_matTransvGroup_le (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (v φ : Fin R' → GaloisField 2 f) :
    Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g)).toMonoidHom
      (matTransvGroup v φ) ≤
      matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) := by
  rw [matTransvGroup, MonoidHom.map_closure, matTransvGroup, Subgroup.closure_le]
  rintro h ⟨h₀, ⟨c, hc⟩, rfl⟩
  refine Subgroup.subset_closure ⟨c, ?_⟩
  have hgg : (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) *
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)) = 1 := by
    rw [← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel, Matrix.SpecialLinearGroup.coe_one]
  rw [show (MulEquiv.toMonoidHom (MulAut.conj (Matrix.SpecialLinearGroup.toGL g))) h₀ =
      (MulAut.conj (Matrix.SpecialLinearGroup.toGL g)) h₀ from rfl]
  rw [bmdualm_coe_conj_toGL R' f g h₀, hc, Matrix.mul_add, Matrix.mul_one, Matrix.mul_smul,
    Matrix.add_mul, Matrix.smul_mul,
    bmdualm_conj_vecMulVec' (GaloisField 2 f) (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)) v φ, hgg]

private theorem bmdualm_map_conj_matTransvGroup_ge (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (v φ : Fin R' → GaloisField 2 f) :
    matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) ≤
      Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g)).toMonoidHom
        (matTransvGroup v φ) := by
  have hgg' : ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)) *
      (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) = 1 := by
    rw [← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel, Matrix.SpecialLinearGroup.coe_one]
  simp only [matTransvGroup]
  rw [MonoidHom.map_closure, Subgroup.closure_le]
  rintro h ⟨c, hc⟩
  refine Subgroup.subset_closure ⟨(MulAut.conj (Matrix.SpecialLinearGroup.toGL g))⁻¹ h,
    ⟨c, ?_⟩, by
      simp only [MulEquiv.coe_toMonoidHom, zpow_neg_one, MulEquiv.inv_apply]
      exact MulEquiv.apply_symm_apply _ _⟩
  rw [bmdualm_coe_conj_toGL_inv R' f g h, hc, Matrix.mul_add, Matrix.mul_one, Matrix.mul_smul,
    Matrix.add_mul, Matrix.smul_mul,
    bmdualm_conj_vecMulVec' (GaloisField 2 f)
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))
      (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
      (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
      (Matrix.mulVec (Matrix.transpose ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
          :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ),
    hgg', Matrix.mulVec_mulVec, hgg', Matrix.one_mulVec,
    Matrix.mulVec_mulVec, ← Matrix.transpose_mul, hgg', Matrix.transpose_one,
    Matrix.one_mulVec]

private theorem bmdualm_conj_matTransvGroup (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (v φ : Fin R' → GaloisField 2 f) :
    Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g)).toMonoidHom
      (matTransvGroup v φ) =
      matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) := by
  exact le_antisymm (bmdualm_map_conj_matTransvGroup_le R' f g v φ)
    (bmdualm_map_conj_matTransvGroup_ge R' f g v φ)

private theorem bmdualm_exists_sl_map_vec (R' f : ℕ)
    (v₁ v₂ : Fin R' → GaloisField 2 f) (hv₁ : v₁ ≠ 0) (hv₂ : v₂ ≠ 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f), ∃ c : GaloisField 2 f,
      c ≠ 0 ∧
      Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v₁ = c • v₂ := by
  haveI : NeZero R' := ⟨fun h => hv₁ (by subst h; exact Subsingleton.elim _ _)⟩
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq
    (M := Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (Projectivization.mk (GaloisField 2 f) v₁ hv₁)
    (Projectivization.mk (GaloisField 2 f) v₂ hv₂)
  rw [Projectivization.smul_mk] at hg
  obtain ⟨a, ha⟩ := (Projectivization.mk_eq_mk_iff (GaloisField 2 f) (g • v₁) v₂ _ hv₂).mp hg
  exact ⟨g, (a : GaloisField 2 f), a.ne_zero, ha.symm⟩

private noncomputable def bmdualm_wStd (R' f : ℕ) (j : Fin R')
    (u φ : Fin R' → GaloisField 2 f) : Fin R' → GaloisField 2 f :=
  (u j)⁻¹ • ((u j * (u ⬝ᵥ φ)⁻¹) • φ - Pi.single j (1 : GaloisField 2 f))

private theorem bmdualm_exists_coord_ne_zero (R' f : ℕ) (φ : Fin R' → GaloisField 2 f)
    (hφ : φ ≠ 0) : ∃ i, φ i ≠ 0 := by
  by_contra h
  simp only [not_exists, not_not] at h
  exact hφ (funext h)

private theorem bmdualm_single_apply_self (R' f : ℕ) (j : Fin R') :
    (Pi.single j (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) j ≠ 0 := by
  rw [Pi.single_eq_same]
  exact one_ne_zero

private theorem bmdualm_single_dotProduct_vec (R' f : ℕ) (j : Fin R')
    (φ : Fin R' → GaloisField 2 f) :
    (Pi.single j (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) ⬝ᵥ φ = φ j := by
  rw [dotProduct, Finset.sum_eq_single j]
  · rw [Pi.single_eq_same, one_mul]
  · intro b _ hb
    rw [Pi.single_eq_of_ne hb, zero_mul]
  · intro h; exact absurd (Finset.mem_univ j) h

private theorem bmdualm_single_add_apply_self (R' f : ℕ) (i j : Fin R') (hij : i ≠ j) :
    (Pi.single j (1 : GaloisField 2 f) + Pi.single i 1 : Fin R' → GaloisField 2 f) j ≠ 0 := by
  have hji : j ≠ i := Ne.symm hij
  simp [Pi.single_eq_same, Pi.single_eq_of_ne, hji, one_ne_zero]

private theorem bmdualm_single_add_dotProduct (R' f : ℕ) (i j : Fin R')
    (φ : Fin R' → GaloisField 2 f) :
    (Pi.single j (1 : GaloisField 2 f) + Pi.single i 1 : Fin R' → GaloisField 2 f) ⬝ᵥ φ
      = φ j + φ i := by
  rw [add_dotProduct, bmdualm_single_dotProduct_vec, bmdualm_single_dotProduct_vec]

private theorem bmdualm_exists_u_dot_ne_zero (R' f : ℕ) (j : Fin R') (φ : Fin R' → GaloisField 2 f)
    (hφ : φ ≠ 0) : ∃ u : Fin R' → GaloisField 2 f, u j ≠ 0 ∧ u ⬝ᵥ φ ≠ 0 := by
  by_cases hj : φ j = 0
  · obtain ⟨i, hi⟩ := bmdualm_exists_coord_ne_zero R' f φ hφ
    have hij : i ≠ j := fun h => hi (by rw [h]; exact hj)
    refine ⟨Pi.single j (1 : GaloisField 2 f) + Pi.single i 1, ?_, ?_⟩
    · exact bmdualm_single_add_apply_self R' f i j hij
    · rw [bmdualm_single_add_dotProduct R' f i j φ, hj, zero_add]
      exact hi
  · refine ⟨Pi.single j (1 : GaloisField 2 f), bmdualm_single_apply_self R' f j, ?_⟩
    rw [bmdualm_single_dotProduct_vec R' f j φ]
    exact hj

private theorem bmdualm_wStd_dot_u (R' f : ℕ) (j : Fin R') (u φ : Fin R' → GaloisField 2 f) (huφ : u
    ⬝ᵥ φ ≠ 0) : bmdualm_wStd R' f j u φ ⬝ᵥ u = 0 := by
  rw [bmdualm_wStd, smul_dotProduct, sub_dotProduct, smul_dotProduct, bmdualm_single_dotProduct_vec]
  rw [dotProduct_comm φ u]
  rw [show (u j * (u ⬝ᵥ φ)⁻¹) • (u ⬝ᵥ φ) = u j from by
    rw [smul_eq_mul, mul_assoc, inv_mul_cancel₀ huφ, mul_one]]
  rw [sub_self, smul_zero]

private theorem bmdualm_wStd_apply_zero (R' f : ℕ) (hR : 1 ≤ R') (j : Fin R')
    (hj : j ≠ ⟨0, by omega⟩) (u φ : Fin R' → GaloisField 2 f)
    (h0 : φ (⟨0, by omega⟩ : Fin R') = 0) :
    bmdualm_wStd R' f j u φ (⟨0, by omega⟩ : Fin R') = 0 := by
  rw [bmdualm_wStd, Pi.smul_apply, Pi.sub_apply, Pi.smul_apply, h0, smul_zero,
    Pi.single_eq_of_ne (Ne.symm hj), sub_zero, smul_zero]

private theorem bmdualm_det_one_add_vecMulVec_phi (R' f : ℕ)
    (φ w : Fin R' → GaloisField 2 f) (h : w ⬝ᵥ φ = 0) :
    (1 + Matrix.vecMulVec φ w : Matrix (Fin R') (Fin R') (GaloisField 2 f)).det = 1 := by
  rw [bmdualm_det_one_add_vecMulVec, h, add_zero]

private theorem bmdualm_transpose_vecMulVec_phi (R' f : ℕ) (j : Fin R')
    (φ w : Fin R' → GaloisField 2 f) :
    Matrix.mulVec (Matrix.transpose (1 + Matrix.vecMulVec φ w :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)))
        (Pi.single j (1 : GaloisField 2 f)) =
      Pi.single j (1 : GaloisField 2 f) + (φ j) • w := by
  rw [Matrix.transpose_add, Matrix.transpose_one, Matrix.transpose_vecMulVec, Matrix.add_mulVec,
    Matrix.one_mulVec, Matrix.vecMulVec_mulVec,
    show φ ⬝ᵥ (Pi.single j (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) = φ j from by
      rw [dotProduct_comm]; exact bmdualm_single_dotProduct_vec R' f j φ]
  simp only [add_right_inj, op_smul_eq_smul]

private theorem bmdualm_mulVec_vecMulVec_phi (R' f : ℕ) (hR : 1 ≤ R')
    (φ w : Fin R' → GaloisField 2 f) (h : w (⟨0, by omega⟩ : Fin R') = 0) :
    Matrix.mulVec (1 + Matrix.vecMulVec φ w :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))
        (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
      Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  rw [Matrix.add_mulVec, Matrix.one_mulVec, Matrix.vecMulVec_mulVec, op_smul_eq_smul,
    show w ⬝ᵥ (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f)
        = 0 from by
      rw [dotProduct_comm, bmdualm_single_dotProduct_vec]; exact h,
    zero_smul, add_zero]

private theorem bmdualm_exists_sl_map_phi_j (R' f : ℕ) (hR : 1 ≤ R') (j : Fin R')
    (hj : j ≠ ⟨0, by omega⟩) (φ : Fin R' → GaloisField 2 f) (hφj : φ j ≠ 0)
    (h0 : φ (⟨0, by omega⟩ : Fin R') = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f), ∃ c : GaloisField 2 f,
      c ≠ 0 ∧
      Matrix.mulVec (Matrix.transpose (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)))
        (Pi.single j (1 : GaloisField 2 f)) = c • φ ∧
      Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
        (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  obtain ⟨u, huj, huφ⟩ := bmdualm_exists_u_dot_ne_zero R' f j φ (fun h => hφj (congrFun h j))
  have hdot : bmdualm_wStd R' f j u φ ⬝ᵥ u = 0 := bmdualm_wStd_dot_u R' f j u φ huφ
  have hdet : (1 + Matrix.vecMulVec u (bmdualm_wStd R' f j u φ) :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)).det = 1 :=
    bmdualm_det_one_add_vecMulVec_phi R' f u (bmdualm_wStd R' f j u φ) hdot
  refine ⟨⟨1 + Matrix.vecMulVec u (bmdualm_wStd R' f j u φ), hdet⟩, u j * (u ⬝ᵥ φ)⁻¹, ?_, ?_, ?_⟩
  · exact mul_ne_zero huj (inv_ne_zero huφ)
  · rw [Matrix.SpecialLinearGroup.coe_mk, bmdualm_transpose_vecMulVec_phi, bmdualm_wStd, smul_smul,
      mul_inv_cancel₀ huj, one_smul, add_sub_cancel]
  · rw [Matrix.SpecialLinearGroup.coe_mk]
    exact bmdualm_mulVec_vecMulVec_phi R' f hR u (bmdualm_wStd R' f j u φ)
      (bmdualm_wStd_apply_zero R' f hR j hj u φ h0)

private noncomputable def bmdualm_swapVec (R' f : ℕ) (hR : 2 ≤ R') (j : Fin R') :
    Fin R' → GaloisField 2 f :=
  Pi.single (⟨1, by omega⟩ : Fin R') 1 + Pi.single j 1

private theorem bmdualm_swapVec_apply_zero (R' f : ℕ) (hR : 2 ≤ R') (j : Fin R')
    (hj : j ≠ ⟨0, by omega⟩) :
    bmdualm_swapVec R' f hR j (⟨0, by omega⟩ : Fin R') = 0 := by
  have h1O : (⟨1, by omega⟩ : Fin R') ≠ ⟨0, by omega⟩ := by
    intro hh; exact Nat.zero_ne_one (Fin.ext_iff.mp hh).symm
  rw [bmdualm_swapVec, Pi.add_apply, Pi.single_eq_of_ne (Ne.symm h1O),
    Pi.single_eq_of_ne (Ne.symm hj), add_zero]

private theorem bmdualm_swapVec_dot_self (R' f : ℕ) (hR : 2 ≤ R') (j : Fin R')
    (hj1 : j ≠ ⟨1, by omega⟩) :
    bmdualm_swapVec R' f hR j ⬝ᵥ bmdualm_swapVec R' f hR j = 0 := by
  rw [bmdualm_swapVec, add_dotProduct, dotProduct_add, dotProduct_add,
    bmdualm_single_dotProduct_vec, bmdualm_single_dotProduct_vec, bmdualm_single_dotProduct_vec,
    bmdualm_single_dotProduct_vec, Pi.single_eq_same, Pi.single_eq_of_ne (Ne.symm hj1),
    Pi.single_eq_of_ne hj1, Pi.single_eq_same, add_zero, zero_add]
  exact CharTwo.add_self_eq_zero 1

private theorem bmdualm_swapVec_dot_one (R' f : ℕ) (hR : 2 ≤ R') (j : Fin R')
    (hj1 : j ≠ ⟨1, by omega⟩) :
    bmdualm_swapVec R' f hR j ⬝ᵥ (Pi.single (⟨1, by omega⟩ : Fin R')
      (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) = 1 := by
  rw [bmdualm_swapVec, add_dotProduct, bmdualm_single_dotProduct_vec, bmdualm_single_dotProduct_vec,
    Pi.single_eq_same, Pi.single_eq_of_ne hj1, add_zero]

private theorem bmdualm_exists_sl_swap_single (R' f : ℕ) (hR : 2 ≤ R') (j : Fin R')
    (hj : j ≠ ⟨0, by omega⟩) :
    ∃ σ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      Matrix.mulVec (σ : Matrix (Fin R') (Fin R') (GaloisField 2 f))
          (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) ∧
      Matrix.mulVec (Matrix.transpose (σ : Matrix (Fin R') (Fin R') (GaloisField 2 f)))
          (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        Pi.single j (1 : GaloisField 2 f) := by
  by_cases hj1 : j = (⟨1, by omega⟩ : Fin R')
  · subst hj1
    refine ⟨1, ?_, ?_⟩
    · rw [Matrix.SpecialLinearGroup.coe_one, Matrix.one_mulVec]
    · rw [Matrix.SpecialLinearGroup.coe_one, Matrix.transpose_one, Matrix.one_mulVec]
  · have hdet : (1 + Matrix.vecMulVec (bmdualm_swapVec R' f hR j) (bmdualm_swapVec R' f hR j) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)).det = 1 :=
      bmdualm_det_one_add_vecMulVec_phi R' f _ _ (bmdualm_swapVec_dot_self R' f hR j hj1)
    refine ⟨⟨1 + Matrix.vecMulVec (bmdualm_swapVec R' f hR j) (bmdualm_swapVec R' f hR j), hdet⟩,
      ?_, ?_⟩
    · rw [Matrix.SpecialLinearGroup.coe_mk, Matrix.add_mulVec, Matrix.one_mulVec,
        Matrix.vecMulVec_mulVec, op_smul_eq_smul,
        show bmdualm_swapVec R' f hR j ⬝ᵥ (Pi.single (⟨0, by omega⟩ : Fin R')
            (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) = 0 from by
          rw [dotProduct_comm, bmdualm_single_dotProduct_vec]
          exact bmdualm_swapVec_apply_zero R' f hR j hj,
        zero_smul, add_zero]
    · rw [Matrix.SpecialLinearGroup.coe_mk, Matrix.transpose_add, Matrix.transpose_one,
        Matrix.transpose_vecMulVec, Matrix.add_mulVec, Matrix.one_mulVec, Matrix.vecMulVec_mulVec,
        op_smul_eq_smul,
        show bmdualm_swapVec R' f hR j ⬝ᵥ (Pi.single (⟨1, by omega⟩ : Fin R')
            (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) = 1 from
          bmdualm_swapVec_dot_one R' f hR j hj1,
        one_smul]
      rw [bmdualm_swapVec, ← add_assoc]
      rw [show (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) :
              Fin R' → GaloisField 2 f) + (Pi.single (⟨1, by omega⟩ : Fin R')
              (1 : GaloisField 2 f) : Fin R' → GaloisField 2 f) = 0 from by
          funext i; exact CharTwo.add_self_eq_zero _
        , zero_add]

private noncomputable def bmdualm_diagVec (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f) :
    Fin R' → GaloisField 2 f :=
  fun i => if i = (⟨0, by omega⟩ : Fin R') then 1
    else if i = (⟨1, by omega⟩ : Fin R') then c⁻¹
    else if i = (⟨2, by omega⟩ : Fin R') then c else 1

private theorem bmdualm_diagVec_apply_zero (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f) :
    bmdualm_diagVec R' f hR3 c (⟨0, by omega⟩ : Fin R') = 1 := by
  simp [bmdualm_diagVec]

private theorem bmdualm_diagVec_apply_one (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f) :
    bmdualm_diagVec R' f hR3 c (⟨1, by omega⟩ : Fin R') = c⁻¹ := by
  have h : (⟨1, by omega⟩ : Fin R') ≠ ⟨0, by omega⟩ := by
    intro hh; exact Nat.zero_ne_one (Fin.ext_iff.mp hh).symm
  simp [bmdualm_diagVec, h]

private theorem bmdualm_diagVec_apply_two (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f) :
    bmdualm_diagVec R' f hR3 c (⟨2, by omega⟩ : Fin R') = c := by
  have h20 : (⟨2, by omega⟩ : Fin R') ≠ ⟨0, by omega⟩ := by
    intro hh
    have hh' := Fin.ext_iff.mp hh
    simp only [Fin.val_mk] at hh'
    omega
  have h21 : (⟨2, by omega⟩ : Fin R') ≠ ⟨1, by omega⟩ := by
    intro hh
    have hh' := Fin.ext_iff.mp hh
    simp only [Fin.val_mk] at hh'
    omega
  simp [bmdualm_diagVec, h20, h21]

private theorem bmdualm_diagVec_det (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f)
    (hc : c ≠ 0) : (Matrix.diagonal (bmdualm_diagVec R' f hR3 c)).det = 1 := by
  rw [Matrix.det_diagonal]
  rw [Finset.prod_eq_mul (⟨1, by omega⟩ : Fin R') (⟨2, by omega⟩ : Fin R')
    (by simp [Fin.ext_iff]) (fun i _ hi => by
      by_cases hi0 : i = (⟨0, by omega⟩ : Fin R')
      · subst hi0; simp [bmdualm_diagVec]
      · simp [bmdualm_diagVec, hi0, hi.1, hi.2])
    (fun h => absurd (Finset.mem_univ _) h) (fun h => absurd (Finset.mem_univ _) h)]
  rw [bmdualm_diagVec_apply_one, bmdualm_diagVec_apply_two, inv_mul_cancel₀ hc]

private noncomputable def bmdualm_diagSL (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f)
    (hc : c ≠ 0) : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f) :=
  ⟨Matrix.diagonal (bmdualm_diagVec R' f hR3 c), bmdualm_diagVec_det R' f hR3 c hc⟩

private theorem bmdualm_diagSL_coe (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f)
    (hc : c ≠ 0) :
    (bmdualm_diagSL R' f hR3 c hc : Matrix (Fin R') (Fin R') (GaloisField 2 f)) =
      Matrix.diagonal (bmdualm_diagVec R' f hR3 c) := by
  rw [bmdualm_diagSL, Matrix.SpecialLinearGroup.coe_mk]

private theorem bmdualm_diagSL_inv_transpose_coe (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f)
    (hc : c ≠ 0) :
    Matrix.transpose (((bmdualm_diagSL R' f hR3 c hc)⁻¹ :
        Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)) =
      Matrix.diagonal (fun i => ∏ j ∈ Finset.univ.erase i, bmdualm_diagVec R' f hR3 c j) := by
  change Matrix.transpose (Matrix.adjugate (Matrix.diagonal (bmdualm_diagVec R' f hR3 c))) =
    Matrix.diagonal (fun i => ∏ j ∈ Finset.univ.erase i, bmdualm_diagVec R' f hR3 c j)
  rw [Matrix.adjugate_diagonal, Matrix.diagonal_transpose]

private theorem bmdualm_diagVec_prod_erase_one (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f) :
    (∏ j ∈ Finset.univ.erase (⟨1, by omega⟩ : Fin R'), bmdualm_diagVec R' f hR3 c j) = c := by
  rw [Finset.prod_eq_single (⟨2, by omega⟩ : Fin R')]
  · rw [bmdualm_diagVec_apply_two]
  · intro b hb hb2
    have hb1 : b ≠ (⟨1, by omega⟩ : Fin R') := (Finset.mem_erase.mp hb).1
    by_cases hb0 : b = (⟨0, by omega⟩ : Fin R')
    · subst hb0; simp [bmdualm_diagVec]
    · simp [bmdualm_diagVec, hb0, hb1, hb2]
  · intro h
    exact absurd (Finset.mem_erase.mpr ⟨by simp [Fin.ext_iff], Finset.mem_univ _⟩) h

private theorem bmdualm_diagSL_mulVec_zero (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f)
    (hc : c ≠ 0) :
    Matrix.mulVec (bmdualm_diagSL R' f hR3 c hc : Matrix (Fin R') (Fin R') (GaloisField 2 f))
        (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
      Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  rw [bmdualm_diagSL_coe, Matrix.diagonal_mulVec_single, bmdualm_diagVec_apply_zero, one_mul]

private theorem bmdualm_diagSL_inv_transpose_mulVec_one (R' f : ℕ) (hR3 : 3 ≤ R')
    (c : GaloisField 2 f) (hc : c ≠ 0) :
    Matrix.mulVec (Matrix.transpose (((bmdualm_diagSL R' f hR3 c hc)⁻¹ :
        Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)))
        (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
      c • Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  rw [bmdualm_diagSL_inv_transpose_coe, Matrix.diagonal_mulVec_single,
    bmdualm_diagVec_prod_erase_one, mul_one, ← Pi.single_smul, smul_eq_mul, mul_one]

private theorem bmdualm_exists_sl_diag_single (R' f : ℕ) (hR3 : 3 ≤ R') (c : GaloisField 2 f)
    (hc : c ≠ 0) :
    ∃ δ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      Matrix.mulVec (δ : Matrix (Fin R') (Fin R') (GaloisField 2 f))
          (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) ∧
      Matrix.mulVec (Matrix.transpose
          ((δ⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f)))
          (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        c • Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  exact ⟨bmdualm_diagSL R' f hR3 c hc, bmdualm_diagSL_mulVec_zero R' f hR3 c hc,
    bmdualm_diagSL_inv_transpose_mulVec_one R' f hR3 c hc⟩

private theorem bmdualm_dotProduct_single_zero (R' f : ℕ) (hR : 1 ≤ R')
    (φ : Fin R' → GaloisField 2 f)
    (h : φ ⬝ᵥ (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) :
      Fin R' → GaloisField 2 f) = 0) :
    φ (⟨0, by omega⟩ : Fin R') = 0 := by
  rw [dotProduct_comm, bmdualm_single_dotProduct_vec] at h
  exact h

private theorem bmdualm_exists_coord_ne_zero_ne (R' f : ℕ) (hR : 1 ≤ R')
    (φ : Fin R' → GaloisField 2 f)
    (hφ : φ ≠ 0) (h0 : φ (⟨0, by omega⟩ : Fin R') = 0) :
    ∃ j : Fin R', j ≠ ⟨0, by omega⟩ ∧ φ j ≠ 0 := by
  obtain ⟨i, hi⟩ := bmdualm_exists_coord_ne_zero R' f φ hφ
  refine ⟨i, ?_, hi⟩
  rintro rfl
  exact hi h0

private theorem bmdualm_exists_sl_map_phi_std_scal (R' f : ℕ) (hR : 2 ≤ R')
    (φ : Fin R' → GaloisField 2 f) (hφ : φ ≠ 0)
    (h0 : φ (⟨0, by omega⟩ : Fin R') = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f), ∃ c : GaloisField 2 f,
      c ≠ 0 ∧
      Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
          (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) ∧
      Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ =
        c • Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  obtain ⟨j, hj, hφj⟩ := bmdualm_exists_coord_ne_zero_ne R' f (by omega) φ hφ h0
  obtain ⟨g₁, c₁, hc₁, hg₁, hg₁O⟩ := bmdualm_exists_sl_map_phi_j R' f (by omega) j hj φ hφj h0
  obtain ⟨σ, hσO, hσ1⟩ := bmdualm_exists_sl_swap_single R' f hR j hj
  have hinvT : ∀ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      Matrix.transpose ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))
        * Matrix.transpose (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) = 1 := by
    intro g
    have hmul : (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
        * ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
          Matrix (Fin R') (Fin R') (GaloisField 2 f)) = 1 := by
      rw [← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel,
        Matrix.SpecialLinearGroup.coe_one]
    rw [← Matrix.transpose_mul,
      show (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
        * ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
          Matrix (Fin R') (Fin R') (GaloisField 2 f)) = 1 from by
        rw [← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel,
          Matrix.SpecialLinearGroup.coe_one],
      Matrix.transpose_one]
  refine ⟨σ * g₁, c₁⁻¹, inv_ne_zero hc₁, ?_, ?_⟩
  · rw [Matrix.SpecialLinearGroup.coe_mul, ← Matrix.mulVec_mulVec, hg₁O, hσO]
  · have hg₁inv : Matrix.mulVec (Matrix.transpose
        ((g₁⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
          Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ = c₁⁻¹ • Pi.single j 1 := by
      rw [show φ = c₁⁻¹ • Matrix.mulVec
          (Matrix.transpose (g₁ : Matrix (Fin R') (Fin R') (GaloisField 2 f)))
          (Pi.single j (1 : GaloisField 2 f)) from by
        rw [hg₁, smul_smul, inv_mul_cancel₀ hc₁, one_smul]]
      rw [Matrix.mulVec_smul, Matrix.mulVec_mulVec, hinvT g₁, Matrix.one_mulVec]
    have hσinv : Matrix.mulVec (Matrix.transpose
        ((σ⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
          Matrix (Fin R') (Fin R') (GaloisField 2 f))) (Pi.single j (1 : GaloisField 2 f))
        = Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
      rw [show Pi.single j (1 : GaloisField 2 f) = Matrix.mulVec
          (Matrix.transpose (σ : Matrix (Fin R') (Fin R') (GaloisField 2 f)))
          (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) from hσ1.symm]
      rw [Matrix.mulVec_mulVec, hinvT σ, Matrix.one_mulVec]
    rw [mul_inv_rev, Matrix.SpecialLinearGroup.coe_mul, Matrix.transpose_mul,
      ← Matrix.mulVec_mulVec, hg₁inv, Matrix.mulVec_smul, hσinv]

private theorem bmdualm_exists_sl_map_phi_std (R' f : ℕ) (hR3 : 3 ≤ R')
    (φ : Fin R' → GaloisField 2 f) (hφ : φ ≠ 0)
    (h : φ ⬝ᵥ (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
          (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) =
        Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) ∧
      Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ =
        Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  have h0 : φ (⟨0, by omega⟩ : Fin R') = 0 :=
    bmdualm_dotProduct_single_zero R' f (by omega) φ h
  obtain ⟨g₀, c, hc, hg₀O, hg₀⟩ := bmdualm_exists_sl_map_phi_std_scal R' f (by omega) φ hφ h0
  obtain ⟨δ, hδO, hδ⟩ := bmdualm_exists_sl_diag_single R' f hR3 c⁻¹ (inv_ne_zero hc)
  refine ⟨δ * g₀, ?_, ?_⟩
  · rw [Matrix.SpecialLinearGroup.coe_mul, ← Matrix.mulVec_mulVec, hg₀O, hδO]
  · rw [mul_inv_rev, Matrix.SpecialLinearGroup.coe_mul, Matrix.transpose_mul,
      ← Matrix.mulVec_mulVec, hg₀, Matrix.mulVec_smul, hδ]
    rw [smul_smul, mul_inv_cancel₀ hc, one_smul]

private theorem bmdualm_matTransvGroup_smul (R' f : ℕ) (c : GaloisField 2 f) (hc : c ≠ 0)
    (v φ : Fin R' → GaloisField 2 f) :
    matTransvGroup (c • v) φ = matTransvGroup v φ := by
  rw [matTransvGroup, matTransvGroup]
  congr 1
  ext g
  constructor
  · rintro ⟨d, hd⟩
    exact ⟨d * c, by rw [hd, Matrix.smul_vecMulVec, ← smul_smul]⟩
  · rintro ⟨d, hd⟩
    exact ⟨d * c⁻¹, by
      rw [hd, Matrix.smul_vecMulVec, smul_smul, mul_assoc, inv_mul_cancel₀ hc, mul_one]⟩

private theorem bmdualm_transpose_mulVec_inv_transpose (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (φ : Fin R' → GaloisField 2 f) :
    Matrix.mulVec (Matrix.transpose (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)))
      (Matrix.mulVec (Matrix.transpose
        ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
          Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) = φ := by
  rw [Matrix.mulVec_mulVec,
    show Matrix.transpose (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))
      * Matrix.transpose ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f)) = 1 from by
      rw [← Matrix.transpose_mul, ← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel,
        Matrix.SpecialLinearGroup.coe_one, Matrix.transpose_one],
    Matrix.one_mulVec]

private theorem bmdualm_dotProduct_mulVec_transpose (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (ψ w : Fin R' → GaloisField 2 f) :
    Matrix.mulVec (Matrix.transpose (g : Matrix (Fin R') (Fin R') (GaloisField 2 f))) ψ ⬝ᵥ w
      = ψ ⬝ᵥ Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) w := by
  rw [Matrix.dotProduct_mulVec, Matrix.mulVec_transpose]

private theorem bmdualm_transpose_inv_ne_zero (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (φ : Fin R' → GaloisField 2 f) (hφ : φ ≠ 0) :
    Matrix.mulVec (Matrix.transpose
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ ≠ 0 := by
  intro hzero
  refine hφ ?_
  have hcomp := bmdualm_transpose_mulVec_inv_transpose R' f g φ
  rw [hzero, Matrix.mulVec_zero] at hcomp
  exact hcomp.symm

private theorem bmdualm_transpose_inv_dot_mulVec (R' f : ℕ)
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (φ v : Fin R' → GaloisField 2 f) :
    Matrix.mulVec (Matrix.transpose
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ ⬝ᵥ
      Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v = φ ⬝ᵥ v := by
  rw [← bmdualm_dotProduct_mulVec_transpose,
    bmdualm_transpose_mulVec_inv_transpose]

private theorem bmdualm_transpose_inv_dot_zero_of_smul_single (R' f : ℕ) (hR : 1 ≤ R')
    (g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (φ v : Fin R' → GaloisField 2 f) (c : GaloisField 2 f) (hc : c ≠ 0)
    (hgv : Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v =
      c • Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
    (h : φ ⬝ᵥ v = 0) :
    Matrix.mulVec (Matrix.transpose
      ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ ⬝ᵥ
      (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) = 0 := by
  have hzero := bmdualm_transpose_inv_dot_mulVec R' f g φ v
  rw [hgv, h, dotProduct_smul] at hzero
  rcases (mul_eq_zero.mp hzero) with hc0 | h0
  · exact absurd hc0 hc
  · exact h0

private theorem bmdualm_exists_sl_map_pair_std_high (R' f : ℕ) (hR3 : 3 ≤ R')
    (v φ : Fin R' → GaloisField 2 f) (hv : v ≠ 0) (hφ : φ ≠ 0) (h : φ ⬝ᵥ v = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) =
      matTransvGroup (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
        (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) := by
  have heO : (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) :
      Fin R' → GaloisField 2 f) ≠ 0 :=
    fun hzero => bmdualm_single_apply_self R' f (⟨0, by omega⟩ : Fin R') (by rw [hzero]; rfl)
  obtain ⟨g₁, c₁, hc₁, hg₁⟩ := bmdualm_exists_sl_map_vec R' f v
    (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) hv heO
  have hψne : Matrix.mulVec (Matrix.transpose
      ((g₁⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ ≠ 0 :=
    bmdualm_transpose_inv_ne_zero R' f g₁ φ hφ
  have hψ0 : Matrix.mulVec (Matrix.transpose
      ((g₁⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ ⬝ᵥ
      (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) = 0 :=
    bmdualm_transpose_inv_dot_zero_of_smul_single R' f (by omega) g₁ φ v c₁ hc₁ hg₁ h
  obtain ⟨g₂, hg₂O, hg₂⟩ := bmdualm_exists_sl_map_phi_std R' f hR3 _ hψne hψ0
  refine ⟨g₂ * g₁, ?_⟩
  have hgv : Matrix.mulVec ((g₂ * g₁ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
      Matrix (Fin R') (Fin R') (GaloisField 2 f)) v =
      c₁ • Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
    rw [Matrix.SpecialLinearGroup.coe_mul, ← Matrix.mulVec_mulVec, hg₁, Matrix.mulVec_smul,
      hg₂O]
  have hgφ : Matrix.mulVec (Matrix.transpose
      (((g₂ * g₁ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))⁻¹ :
        Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
        Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ =
      Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
    rw [mul_inv_rev, Matrix.SpecialLinearGroup.coe_mul, Matrix.transpose_mul,
      ← Matrix.mulVec_mulVec, hg₂]
  rw [hgv, hgφ]
  exact bmdualm_matTransvGroup_smul R' f c₁ hc₁ _ _

private theorem bmdualm_matTransvGroup_smul_form (R' f : ℕ) (c : GaloisField 2 f) (hc : c ≠ 0)
    (v φ : Fin R' → GaloisField 2 f) :
    matTransvGroup v (c • φ) = matTransvGroup v φ := by
  rw [matTransvGroup, matTransvGroup]
  congr 1
  ext g
  constructor
  · rintro ⟨d, hd⟩
    exact ⟨d * c, by rw [hd, Matrix.vecMulVec_smul, ← smul_smul]⟩
  · rintro ⟨d, hd⟩
    exact ⟨d * c⁻¹, by
      rw [hd, Matrix.vecMulVec_smul, smul_smul, mul_assoc, inv_mul_cancel₀ hc, mul_one]⟩

private theorem bmdualm_eq_smul_single_of_dot_zero_two (R' f : ℕ) (hR2 : R' = 2)
    (ψ : Fin R' → GaloisField 2 f)
    (h : ψ ⬝ᵥ (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) = 0) :
    ψ = (ψ (⟨1, by omega⟩ : Fin R')) •
      Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) := by
  subst hR2
  have hψ0 : ψ 0 = 0 := by
    have h' := bmdualm_dotProduct_single_zero 2 f (by omega) ψ h
    simpa using h'
  ext i
  fin_cases i <;> simp [hψ0]

private theorem bmdualm_exists_sl_map_pair_std_two (R' f : ℕ) (hR2 : R' = 2)
    (v φ : Fin R' → GaloisField 2 f) (hv : v ≠ 0) (hφ : φ ≠ 0) (h : φ ⬝ᵥ v = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) =
      matTransvGroup (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
        (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) := by
  have heO : (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f) :
      Fin R' → GaloisField 2 f) ≠ 0 :=
    fun hzero => bmdualm_single_apply_self R' f (⟨0, by omega⟩ : Fin R') (by rw [hzero]; rfl)
  obtain ⟨g₁, c₁, hc₁, hg₁⟩ := bmdualm_exists_sl_map_vec R' f v
    (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) hv heO
  let ψ : Fin R' → GaloisField 2 f := Matrix.mulVec (Matrix.transpose
    ((g₁⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
      Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ
  have hψne : ψ ≠ 0 := bmdualm_transpose_inv_ne_zero R' f g₁ φ hφ
  have hψ0 : ψ ⬝ᵥ (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f)) = 0 :=
    bmdualm_transpose_inv_dot_zero_of_smul_single R' f (by omega) g₁ φ v c₁ hc₁ hg₁ h
  have hψeq : ψ = (ψ (⟨1, by omega⟩ : Fin R')) •
      Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f) :=
    bmdualm_eq_smul_single_of_dot_zero_two R' f hR2 ψ hψ0
  have hlam : ψ (⟨1, by omega⟩ : Fin R') ≠ 0 := by
    intro hlam0
    exact hψne (by rw [hψeq, hlam0, zero_smul])
  refine ⟨g₁, ?_⟩
  show matTransvGroup (Matrix.mulVec (g₁ : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v) ψ =
    matTransvGroup (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
      (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f))
  rw [hg₁, hψeq,
    bmdualm_matTransvGroup_smul R' f c₁ hc₁ (Pi.single (⟨0, by omega⟩ : Fin R') 1)
      (ψ (⟨1, by omega⟩ : Fin R') • Pi.single (⟨1, by omega⟩ : Fin R') 1),
    bmdualm_matTransvGroup_smul_form R' f (ψ (⟨1, by omega⟩ : Fin R')) hlam
      (Pi.single (⟨0, by omega⟩ : Fin R') 1) (Pi.single (⟨1, by omega⟩ : Fin R') 1)]

private theorem bmdualm_exists_sl_map_pair_std (R' f : ℕ) (hR : 2 ≤ R')
    (v φ : Fin R' → GaloisField 2 f)
    (hv : v ≠ 0) (hφ : φ ≠ 0) (h : φ ⬝ᵥ v = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ) =
      matTransvGroup (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
        (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) := by
  by_cases hR3 : 3 ≤ R'
  · exact bmdualm_exists_sl_map_pair_std_high R' f hR3 v φ hv hφ h
  · exact bmdualm_exists_sl_map_pair_std_two R' f (by omega) v φ hv hφ h

private theorem bmdualm_map_conj_mul (R' f : ℕ)
    (g₁ g₂ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f))
    (X : Subgroup (GL (Fin R') (GaloisField 2 f))) :
    Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL (g₂ * g₁))).toMonoidHom X
      = Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₂)).toMonoidHom
          (Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₁)).toMonoidHom X) := by
  rw [Subgroup.map_map]
  congr 1
  apply MonoidHom.ext
  intro y
  change MulAut.conj (Matrix.SpecialLinearGroup.toGL (g₂ * g₁)) y
      = MulAut.conj (Matrix.SpecialLinearGroup.toGL g₂)
          (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₁) y)
  rw [MulAut.conj_apply, MulAut.conj_apply, MulAut.conj_apply, map_mul, mul_inv_rev]
  group

private theorem bmdualm_exists_sl_map_pair (R' f : ℕ)
    (v₁ φ₁ v₂ φ₂ : Fin R' → GaloisField 2 f)
    (hv₁ : v₁ ≠ 0) (hφ₁ : φ₁ ≠ 0) (hv₂ : v₂ ≠ 0) (hφ₂ : φ₂ ≠ 0)
    (h₁ : φ₁ ⬝ᵥ v₁ = 0) (h₂ : φ₂ ⬝ᵥ v₂ = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f),
      matTransvGroup (Matrix.mulVec (g : Matrix (Fin R') (Fin R') (GaloisField 2 f)) v₁)
        (Matrix.mulVec (Matrix.transpose
          ((g⁻¹ : Matrix.SpecialLinearGroup (Fin R') (GaloisField 2 f)) :
            Matrix (Fin R') (Fin R') (GaloisField 2 f))) φ₁) =
      matTransvGroup v₂ φ₂ := by
  by_cases hR : 2 ≤ R'
  · obtain ⟨g₁, hg₁⟩ := bmdualm_exists_sl_map_pair_std R' f hR v₁ φ₁ hv₁ hφ₁ h₁
    obtain ⟨g₂, hg₂⟩ := bmdualm_exists_sl_map_pair_std R' f hR v₂ φ₂ hv₂ hφ₂ h₂
    have hm₁ : Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₁)).toMonoidHom
        (matTransvGroup v₁ φ₁) =
        matTransvGroup (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
          (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) := by
      rw [bmdualm_conj_matTransvGroup R' f g₁ v₁ φ₁, hg₁]
    have hm₂ : Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₂)).toMonoidHom
        (matTransvGroup v₂ φ₂) =
        matTransvGroup (Pi.single (⟨0, by omega⟩ : Fin R') (1 : GaloisField 2 f))
          (Pi.single (⟨1, by omega⟩ : Fin R') (1 : GaloisField 2 f)) := by
      rw [bmdualm_conj_matTransvGroup R' f g₂ v₂ φ₂, hg₂]
    have h3 : Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₂⁻¹)).toMonoidHom
        (Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g₂)).toMonoidHom
          (matTransvGroup v₂ φ₂)) = matTransvGroup v₂ φ₂ := by
      rw [← bmdualm_map_conj_mul R' f g₂ g₂⁻¹ (matTransvGroup v₂ φ₂)]
      have hconj1 : MulAut.conj (Matrix.SpecialLinearGroup.toGL (g₂⁻¹ * g₂)) = 1 := by
        rw [inv_mul_cancel g₂, map_one, map_one]
      rw [hconj1]
      exact Subgroup.map_id (matTransvGroup v₂ φ₂)
    refine ⟨g₂⁻¹ * g₁, ?_⟩
    rw [← bmdualm_conj_matTransvGroup R' f (g₂⁻¹ * g₁) v₁ φ₁,
      bmdualm_map_conj_mul R' f g₁ g₂⁻¹ (matTransvGroup v₁ φ₁), hm₁, ← hm₂]
    exact h3
  · exfalso
    have hle : R' ≤ 1 := by omega
    haveI : Subsingleton (Fin R') :=
      ⟨fun a b => Fin.ext (by have ha := a.isLt; have hb := b.isLt; omega)⟩
    obtain ⟨i, hi⟩ := bmdualm_exists_coord_ne_zero R' f v₁ hv₁
    obtain ⟨j, hj⟩ := bmdualm_exists_coord_ne_zero R' f φ₁ hφ₁
    have hji : j = i := Subsingleton.elim j i
    rw [hji] at hj
    have hdot : φ₁ ⬝ᵥ v₁ = φ₁ i * v₁ i := by
      rw [dotProduct]
      exact Finset.sum_eq_single i (fun b _ hb => absurd (Subsingleton.elim b i) hb)
        (fun h => absurd (Finset.mem_univ i) h)
    rw [hdot] at h₁
    exact mul_ne_zero hj hi h₁

private theorem bmdualm_exists_conj_matTransvGroup (R f : ℕ)
    (v φ v' φ' : Fin (R + 1) → GaloisField 2 f)
    (hv : v ≠ 0) (hφ : φ ≠ 0) (hv' : v' ≠ 0) (hφ' : φ' ≠ 0)
    (h : φ ⬝ᵥ v = 0) (h' : φ' ⬝ᵥ v' = 0) :
    ∃ g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      Subgroup.map (MulAut.conj (Matrix.SpecialLinearGroup.toGL g)).toMonoidHom
        (matTransvGroup v' φ') = matTransvGroup v φ := by
  obtain ⟨g, hg⟩ :=
    bmdualm_exists_sl_map_pair (R + 1) f v' φ' v φ hv' hφ' hv hφ h' h
  refine ⟨g, ?_⟩
  rw [bmdualm_conj_matTransvGroup (R + 1) f g v' φ']
  exact hg

private theorem bmdualm_map_conj_comap {G H : Type*} [Group G] [Group H]
    (f : G →* H) (g : G) (L : Subgroup H) :
    Subgroup.map (MulAut.conj g).toMonoidHom (Subgroup.comap f L)
      = Subgroup.comap f (Subgroup.map (MulAut.conj (f g)).toMonoidHom L) := by
  have hconj : ∀ y : G, f (MulAut.conj g y) = MulAut.conj (f g) (f y) := by
    intro y
    simp [MulAut.conj_apply, map_mul, map_inv, mul_inv_rev, inv_inv, mul_assoc]
  have hconj_inv : ∀ y : G, f (MulAut.conj g⁻¹ y) = (MulAut.conj (f g))⁻¹ (f y) := by
    intro y
    rw [MulAut.conj_apply, MulAut.conj_inv_apply]
    simp [map_mul, map_inv, mul_inv_rev, inv_inv, mul_assoc]
  have hconj_inv' : ∀ y : G, (MulAut.conj (f g))⁻¹ (f y) = f (MulAut.conj g⁻¹ y) :=
    fun y => (hconj_inv y).symm
  ext x
  simp only [Subgroup.mem_map, Subgroup.mem_comap]
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨f y, hy, (hconj y).symm⟩
  · rintro ⟨z, hz, hzx⟩
    refine ⟨MulAut.conj g⁻¹ x, ?_, ?_⟩
    · have hz_eq : f (MulAut.conj g⁻¹ x) = z := by
        rw [hconj_inv x, ← hzx, MulAut.conj_inv_apply]
        simp [MulAut.conj_apply, mul_assoc]
      rwa [hz_eq]
    · simp [MulAut.conj_apply, mul_assoc]

private theorem bmdualm_map_conj_comp {G H : Type*} [Group G] [Group H]
    (f : G →* H) (g : G) (K : Subgroup G) :
    Subgroup.map f (Subgroup.map (MulAut.conj g).toMonoidHom K)
      = Subgroup.map (MulAut.conj (f g)).toMonoidHom (Subgroup.map f K) := by
  ext x
  constructor
  · rintro ⟨k, hk, rfl⟩
    obtain ⟨a, ha, rfl⟩ := Subgroup.mem_map.mp hk
    exact Subgroup.mem_map.mpr ⟨f a, Subgroup.mem_map.mpr ⟨a, ha, rfl⟩, by
      simp [MulAut.conj_apply, map_mul, map_inv, mul_inv_rev, mul_assoc]⟩
  · rintro ⟨y, hy, rfl⟩
    obtain ⟨k, hk, rfl⟩ := Subgroup.mem_map.mp hy
    exact Subgroup.mem_map.mpr ⟨MulAut.conj g k, Subgroup.mem_map.mpr ⟨k, hk, rfl⟩, by
      simp [MulAut.conj_apply, map_mul, map_inv, mul_inv_rev, mul_assoc]⟩

private theorem bmdualm_map_conj_map_comap {G H : Type*} [Group G] [Group H]
    (f : G →* H) (g : G) (K : Subgroup G) :
    Subgroup.map (MulAut.conj (f g)).toMonoidHom (Subgroup.map f K)
      = Subgroup.map f (Subgroup.map (MulAut.conj g).toMonoidHom K) :=
  (bmdualm_map_conj_comp f g K).symm

private theorem bmdualm_map_comap_self {G H : Type*} [Group G] [Group H]
    (f : G →* H) (X : Subgroup H) (hX : X ≤ f.range) :
    Subgroup.map f (Subgroup.comap f X) = X := by
  rw [Subgroup.map_comap_eq, inf_eq_right.mpr hX]

private theorem bmdualm_eq_map_of_comap_eq {G H I : Type*} [Group G] [Group H] [Group I]
    (E : G →* H) (φ : G →* I) (X : Subgroup H) (L : Subgroup I)
    (hX : X ≤ E.range) (h : Subgroup.comap E X = Subgroup.comap φ L) :
    X = Subgroup.map E (Subgroup.comap φ L) := by
  rw [← bmdualm_map_comap_self E X hX, h]

private theorem bmdualm_siegel_preimage_matTransv_ne
    (n f : ℕ) (hn : 4 ≤ n)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hform : bmdualm_IsFormStandard n f R r' eidx)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJ'range : J' = (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range)
    (a₁ a₂ : bmdualmι n → GaloisField 2 f) (ha₂ : a₂ ≠ 0)
    (hli : LinearIndependent (GaloisField 2 f) ![a₁, a₂])
    (hQ : (bmdualmQ n f) a₁ = 0 ∧ (bmdualmQ n f) a₂ = 0)
    (horth : QuadraticMap.polar (bmdualmQ n f) a₁ a₂ = 0)
    (hle : siegelGroup (bmdualmQ n f) a₁ a₂ ≤
      J'.map (Spin.spinAction (bmdualmQ n f))) :
    ∃ v φ : Fin (R + 1) → GaloisField 2 f, v ≠ 0 ∧ φ ≠ 0 ∧ φ ⬝ᵥ v = 0 ∧
      Subgroup.comap (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock)
        (Subgroup.comap (Spin.spinAction (bmdualmQ n f))
          (siegelGroup (bmdualmQ n f) a₁ a₂)) =
      Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v φ) := by
  have hEmem : CFSG.ClassicalGroups.Orthogonal.eichler (bmdualmQ n f) a₁ a₂ ∈
      (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range.map
        (Spin.spinAction (bmdualmQ n f)) := by
    rw [← hJ'range]
    exact hle (Subgroup.subset_closure ⟨1, by rw [one_smul]⟩)
  obtain ⟨x, hx⟩ := bmdualm_eichler_mem_embedGL_range n f hn eidx hPP hPinvP hP hblock
    hQ.1 hQ.2 horth hEmem
  obtain ⟨v, φ, hv, hφ, hφv, hM⟩ := bmdualm_siegel_gen_rank_one n f hn eidx hPP hPinvP hP hblock
    hform hQ.1 hQ.2 horth ha₂ hli hx
  exact ⟨v, φ, hv, hφ, hφv,
    bmdualm_matTransv_of_embedGL_rank_one n f hn eidx hPP hPinvP hP hblock
      hQ.1 hQ.2 horth hx hφv hM⟩

private theorem bmdualm_siegel_conj_in_range
    (n f : ℕ) (hn : 4 ≤ n)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hform : bmdualm_IsFormStandard n f R r' eidx)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJ'range : J' = (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range)
    (a₁ a₂ A₁ A₂ : bmdualmι n → GaloisField 2 f) (ha₂ : a₂ ≠ 0)
    (hli : LinearIndependent (GaloisField 2 f) ![a₁, a₂])
    (hQ : (bmdualmQ n f) a₁ = 0 ∧ (bmdualmQ n f) a₂ = 0)
    (horth : QuadraticMap.polar (bmdualmQ n f) a₁ a₂ = 0)
    (hle : siegelGroup (bmdualmQ n f) a₁ a₂ ≤
      J'.map (Spin.spinAction (bmdualmQ n f)))
    (hstd_le : siegelGroup (bmdualmQ n f) A₁ A₂ ≤
      J'.map (Spin.spinAction (bmdualmQ n f)))
    (hA₂ : A₂ ≠ 0)
    (hliA : LinearIndependent (GaloisField 2 f) ![A₁, A₂])
    (hQA : (bmdualmQ n f) A₁ = 0 ∧ (bmdualmQ n f) A₂ = 0)
    (hAorth : QuadraticMap.polar (bmdualmQ n f) A₁ A₂ = 0) :
    ∃ v : ↥(spinGroup (bmdualmQ n f)), v ∈ J' ∧
      Subgroup.map (Spin.spinAction (bmdualmQ n f))
        (Subgroup.map (MulAut.conj v).toMonoidHom
          (Subgroup.comap (Spin.spinAction (bmdualmQ n f))
            (siegelGroup (bmdualmQ n f) A₁ A₂))) =
      siegelGroup (bmdualmQ n f) a₁ a₂ := by
  obtain ⟨v₁, φ₁, hv₁, hφ₁, hφ₁v₁, hc₁⟩ :=
    bmdualm_siegel_preimage_matTransv_ne n f hn eidx hPP hPinvP hP hblock hform hJ'range
      A₁ A₂ hA₂ hliA hQA hAorth hstd_le
  obtain ⟨v₂, φ₂, hv₂, hφ₂, hφ₂v₂, hc₂⟩ :=
    bmdualm_siegel_preimage_matTransv_ne n f hn eidx hPP hPinvP hP hblock hform hJ'range
      a₁ a₂ ha₂ hli hQ horth hle
  obtain ⟨g, hg⟩ :=
    bmdualm_exists_conj_matTransvGroup R f v₂ φ₂ v₁ φ₁ hv₂ hφ₂ hv₁ hφ₁ hφ₂v₂ hφ₁v₁
  refine ⟨bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock g, ?_, ?_⟩
  · rw [hJ'range]
    exact ⟨g, rfl⟩
  · have hS₁range : siegelGroup (bmdualmQ n f) A₁ A₂ ≤
        ((Spin.spinAction (bmdualmQ n f)).comp
          (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock)).range := by
      rw [MonoidHom.range_comp, ← hJ'range]
      exact hstd_le
    have hS₂range : siegelGroup (bmdualmQ n f) a₁ a₂ ≤
        ((Spin.spinAction (bmdualmQ n f)).comp
          (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock)).range := by
      rw [MonoidHom.range_comp, ← hJ'range]
      exact hle
    have hS₁eq : siegelGroup (bmdualmQ n f) A₁ A₂ =
        Subgroup.map ((Spin.spinAction (bmdualmQ n f)).comp
          (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock))
          (Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v₁ φ₁)) :=
      bmdualm_eq_map_of_comap_eq _ _ _ _ hS₁range hc₁
    have hS₂eq : siegelGroup (bmdualmQ n f) a₁ a₂ =
        Subgroup.map ((Spin.spinAction (bmdualmQ n f)).comp
          (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock))
          (Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v₂ φ₂)) :=
      bmdualm_eq_map_of_comap_eq _ _ _ _ hS₂range hc₂
    have hσS₁ : Subgroup.map (Spin.spinAction (bmdualmQ n f))
        (Subgroup.comap (Spin.spinAction (bmdualmQ n f))
          (siegelGroup (bmdualmQ n f) A₁ A₂)) =
        siegelGroup (bmdualmQ n f) A₁ A₂ :=
      bmdualm_map_comap_self _ _ (hstd_le.trans (Subgroup.map_le_range _ _))
    rw [bmdualm_map_conj_comp, hσS₁, hS₁eq,
      show (Spin.spinAction (bmdualmQ n f))
          ((bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock) g) =
        ((Spin.spinAction (bmdualmQ n f)).comp
          (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock)) g from rfl,
      bmdualm_map_conj_map_comap
        ((Spin.spinAction (bmdualmQ n f)).comp
          (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock)) g
        (Subgroup.comap (Matrix.SpecialLinearGroup.toGL) (matTransvGroup v₁ φ₁)),
      bmdualm_map_conj_comap (Matrix.SpecialLinearGroup.toGL) g (matTransvGroup v₁ φ₁),
      hg, ← hS₂eq]

private theorem bmdualm_siegel_conj_of_le
    (n f : ℕ) (hn : 4 ≤ n)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hform : bmdualm_IsFormStandard n f R r' eidx)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJ'range : J' = (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range)
    (g' : ℕ) (ρ : GaloisField 2 g' ≃+* GaloisField 2 f)
    {ι' : (ggU .PSL (R + 1) g').K →* ↥(spinGroup (bmdualmQ n f))}
    (hι' : ι' = (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).comp
      (bmdualm_modelHom f R g' ρ))
    {β₀ : Fin (ggU .PSL (R + 1) g').D.rank → ℤ}
    {A₁ A₂ : bmdualmι n → GaloisField 2 f}
    (hstd : (((ggU .PSL (R + 1) g').D.rootGroup β₀).map ι').map
        (Spin.spinAction (bmdualmQ n f)) =
      siegelGroup (bmdualmQ n f) A₁ A₂)
    (a₁ a₂ : bmdualmι n → GaloisField 2 f) (ha₂ : a₂ ≠ 0)
    (hli : LinearIndependent (GaloisField 2 f) ![a₁, a₂])
    (hQ : (bmdualmQ n f) a₁ = 0 ∧ (bmdualmQ n f) a₂ = 0)
    (horth : QuadraticMap.polar (bmdualmQ n f) a₁ a₂ = 0)
    (hle : siegelGroup (bmdualmQ n f) a₁ a₂ ≤
      J'.map (Spin.spinAction (bmdualmQ n f)))
    (hA₂ : A₂ ≠ 0)
    (hliA : LinearIndependent (GaloisField 2 f) ![A₁, A₂])
    (hQA : (bmdualmQ n f) A₁ = 0 ∧ (bmdualmQ n f) A₂ = 0)
    (hAorth : QuadraticMap.polar (bmdualmQ n f) A₁ A₂ = 0) :
    ∃ u : (ggU .PSL (R + 1) g').K,
      ((((ggU .PSL (R + 1) g').D.rootGroup β₀).map (MulAut.conj u).toMonoidHom).map ι').map
          (Spin.spinAction (bmdualmQ n f)) =
        siegelGroup (bmdualmQ n f) a₁ a₂ := by
  have hstd_le : siegelGroup (bmdualmQ n f) A₁ A₂ ≤
      J'.map (Spin.spinAction (bmdualmQ n f)) := by
    rw [← hstd, hJ'range, hι']
    exact Subgroup.map_mono (le_trans (Subgroup.map_le_range _ _)
      (by rw [MonoidHom.range_comp]; exact Subgroup.map_le_range _ _))
  obtain ⟨v, hvJ', hv⟩ :=
    bmdualm_siegel_conj_in_range n f hn eidx hPP hPinvP hP hblock hform hJ'range
      a₁ a₂ A₁ A₂ ha₂ hli hQ horth hle hstd_le hA₂ hliA hQA hAorth
  obtain ⟨g, hg⟩ := (MonoidHom.mem_range).mp (hJ'range ▸ hvJ')
  obtain ⟨u, hu⟩ := bmdualm_modelHom_surjective f R g' ρ g
  have hιu : ι' u = v := by rw [hι', MonoidHom.comp_apply, hu, hg]
  refine ⟨u, ?_⟩
  rw [bmdualm_closure_transport ι' (Spin.spinAction (bmdualmQ n f))
    (CFSG.StandardType.RootCentOmega.spinAction_quadMinus_injective (n := n)
      (K := GaloisField 2 f) (minusCoeffs_irr 2 f))
    ((ggU .PSL (R + 1) g').D.rootGroup β₀) (siegelGroup (bmdualmQ n f) A₁ A₂)
    hstd u, hιu]
  exact hv

private theorem bmdualm_std_pair_nondeg (n f : ℕ)
    {A₁ A₂ B₁ B₂ : bmdualmι n → GaloisField 2 f}
    (h11 : QuadraticMap.polar (bmdualmQ n f) A₁ B₁ = 1)
    (h22 : QuadraticMap.polar (bmdualmQ n f) A₂ B₂ = 1)
    (h12 : QuadraticMap.polar (bmdualmQ n f) A₁ B₂ = 0)
    (h21 : QuadraticMap.polar (bmdualmQ n f) A₂ B₁ = 0) :
    A₁ ≠ 0 ∧ A₂ ≠ 0 ∧ LinearIndependent (GaloisField 2 f) ![A₁, A₂] := by
  refine ⟨?_, ?_, ?_⟩
  · intro h
    rw [h, QuadraticMap.polar_zero_left] at h11
    exact zero_ne_one h11
  · intro h
    rw [h, QuadraticMap.polar_zero_left] at h22
    exact zero_ne_one h22
  · rw [LinearIndependent.pair_iff]
    intro s t hst
    have h1 : s = 0 := by
      have h := congrArg (fun x => QuadraticMap.polar (bmdualmQ n f) x B₁) hst
      simp only [QuadraticMap.polar_zero_left, QuadraticMap.polar_add_left,
        QuadraticMap.polar_smul_left, h11, h21, smul_eq_mul, mul_one, mul_zero,
        add_zero] at h
      exact h
    have h2 : t = 0 := by
      have h := congrArg (fun x => QuadraticMap.polar (bmdualmQ n f) x B₂) hst
      simp only [QuadraticMap.polar_zero_left, QuadraticMap.polar_add_left,
        QuadraticMap.polar_smul_left, h12, h22, smul_eq_mul, mul_one, mul_zero,
        zero_add] at h
      exact h
    exact ⟨h1, h2⟩

private theorem bmdualm_closure_explicit
    (n f : ℕ) (hn : 4 ≤ n)
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
        (hform : bmdualm_IsFormStandardOne n f R r' eidx)
    (hRpos : 1 ≤ R)
    (hQA : ∀ a : Fin (R + 1),
      bmdualmQ n f (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl a)) 1)) = 0)
    (hQB : ∀ a : Fin (R + 1),
      bmdualmQ n f (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl a))) 1)) = 0)
{J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJ'range : J' = (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range)
    (g' : ℕ) (ρ : GaloisField 2 g' ≃+* GaloisField 2 f)
    {ι' : (ggU .PSL (R + 1) g').K →* ↥(spinGroup (bmdualmQ n f))}
    (hι' : ι' = (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).comp
      (bmdualm_modelHom f R g' ρ)) :
    (∀ a₁ a₂ : bmdualmι n → GaloisField 2 f, a₁ ≠ 0 → a₂ ≠ 0 → LinearIndependent
        (GaloisField 2 f) ![a₁, a₂] → (bmdualmQ n f) a₁ = 0 →
        (bmdualmQ n f) a₂ = 0 →
        QuadraticMap.polar (bmdualmQ n f) a₁ a₂ = 0 → siegelGroup
            (bmdualmQ n f) a₁ a₂ ≤
            J'.map (Spin.spinAction (bmdualmQ n f)) →
        ∃ (β : Fin (ggU .PSL (R + 1) g').D.rank → ℤ) (u : (ggU .PSL (R + 1) g').K),
          β ∈ (ggU .PSL (R + 1) g').D.roots ∧
          GGLongRoot (ggU .PSL (R + 1) g').D β ∧
          ((((ggU .PSL (R + 1) g').D.rootGroup β).map (MulAut.conj u).toMonoidHom).map ι').map
              (Spin.spinAction (bmdualmQ n f)) =
            siegelGroup (bmdualmQ n f) a₁ a₂) := by
  intro a₁ a₂ ha₁ ha₂ hli hQa₁ hQa₂ horth hle
  obtain ⟨β₀, hβ₀roots, hβ₀long, hβ₀std⟩ :=
    bmdualm_model_long_root R (GaloisField 2 g') hRpos
  obtain ⟨A₁, A₂, B₁, B₂, hQA, h1, h2, h3, hstdA, _hstdB⟩ :=
    bmdualm_rootGroup_image_siegel n f hn eidx hPP hPinvP hP hblock hform hRpos hQA hQB g' ρ
      hι' β₀ hβ₀std
  obtain ⟨_hA₁, hA₂, hliA⟩ := bmdualm_std_pair_nondeg n f h1 h2 h3.2.2.1 h3.2.2.2
  obtain ⟨u, hu⟩ :=
    bmdualm_siegel_conj_of_le n f hn eidx hPP hPinvP hP hblock
      (bmdualm_IsFormStandardOne.toStandard hform) hJ'range g' ρ hι' hstdA
      a₁ a₂ ha₂ hli ⟨hQa₁, hQa₂⟩ horth hle hA₂ hliA ⟨hQA.1, hQA.2.1⟩ h3.1
  exact ⟨β₀, u, hβ₀roots, hβ₀long, hu⟩

private theorem bmdualm_mem_center_of_map_mem_center {K G : Type*} [Group K] [Group G]
    (ι : K →* G) (hι : Function.Injective ι) {y : K}
    (hy : ι y ∈ Subgroup.center G) : y ∈ Subgroup.center K := by
  rw [Subgroup.mem_center_iff] at hy ⊢
  intro z
  apply hι
  rw [map_mul, map_mul]
  exact hy (ι z)

private theorem bmdualm_range_comp_eq_of_surjective {A B C : Type*} [Group A] [Group B] [Group C]
    (f : B →* C) (g : A →* B) (hg : Function.Surjective g) :
    (f.comp g).range = f.range := by
  rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr hg, Subgroup.map_top]

private theorem bmdualmx_isUnit_det_of_mul_eq_one (f : ℕ) {ι : Type*} [Fintype ι]
    [DecidableEq ι] {A B : Matrix ι ι (GaloisField 2 f)} (h : A * B = 1) : IsUnit A.det := by
  refine ⟨Units.mk A.det B.det ?_ ?_, rfl⟩
  · rw [← Matrix.det_mul, h, Matrix.det_one]
  · rw [mul_comm, ← Matrix.det_mul, h, Matrix.det_one]

private theorem bmdualmx_rank_conj_eq (f : ℕ) {ι : Type*} [Fintype ι] [DecidableEq ι]
    {A P Pinv : Matrix ι ι (GaloisField 2 f)} (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1) :
    (Pinv * A * P).rank = A.rank := by
  have hPunit : IsUnit P.det := bmdualmx_isUnit_det_of_mul_eq_one f hPP
  have hPinvunit : IsUnit Pinv.det := bmdualmx_isUnit_det_of_mul_eq_one f hPinvP
  rw [Matrix.rank_mul_eq_left_of_isUnit_det P (Pinv * A) hPunit,
    Matrix.rank_mul_eq_right_of_isUnit_det Pinv A hPinvunit]

private theorem bmdualmx_rank_reindex_D0 (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n) :
    (Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f))).rank = R + 1 := by
  rw [Matrix.rank_reindex, bmdualm_D0, bmdualm_rank_fromBlocks_zero,
    bmdualm_rank_fromBlocks_zero, Matrix.rank_one, Matrix.rank_zero, Matrix.rank_zero, add_zero,
    Fintype.card_fin]

private theorem bmdualmx_finrank_range_toLin_eq_rank (f : ℕ) {ι : Type*} [Fintype ι]
    [DecidableEq ι] (e : Matrix ι ι (GaloisField 2 f)) :
    Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.toLin' e)) = e.rank := by
  have h : Matrix.toLin' e = Matrix.mulVecLin e := by
    apply LinearMap.ext
    intro v
    rw [Matrix.toLin'_apply, Matrix.mulVecLin_apply]
  rw [h, ← bmdualm_finrank_range_mulVecLin_eq_rank f e]

private theorem bmdualmx_block_rank_eq (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e) :
    R + 1 = Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.toLin' e)) := by
  rw [bmdualmx_finrank_range_toLin_eq_rank f e, ← hconv,
    bmdualmx_rank_conj_eq f hPP hPinvP, bmdualmx_rank_reindex_D0 n f R r' eidx]

theorem exists_blockModel_dualPair_POmegaMinus_explicit
    (n f : ℕ) (hf : 1 ≤ f) (S : Set (GL (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈
    (Spin.spinMatrix
    (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2)).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') (hodd : ∀ s ∈ S, Odd (orderOf s))
    {e : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (GaloisField 2 f)} (he : IsPrimIdemIn (Algebra.adjoin (GaloisField 2 f) (Units.val '' S)) e)
    (hn : 4 ≤ n)
    (hpair : formAdj (RingHom.id (GaloisField 2 f))
      (LinearMap.toMatrix₂' (GaloisField 2 f)
      (QuadraticMap.polarBilin
      (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2))) e ≠ e)
      (hdeg : blockDegree (Algebra.adjoin (GaloisField 2 f) (Units.val '' S)) e < 2)
    {J' : Subgroup
      ↥(spinGroup (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2))}
    (hJe : IsComponentOf J'
      ⁅glBlockCentralizer
      (Spin.spinMatrix (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2))
      S (e + formAdj (RingHom.id (GaloisField 2 f))
      (LinearMap.toMatrix₂' (GaloisField 2 f)
      (QuadraticMap.polarBilin
      (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2))) e),
      glBlockCentralizer
        (Spin.spinMatrix
        (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2)) S
        (e + formAdj (RingHom.id (GaloisField 2 f))
        (LinearMap.toMatrix₂' (GaloisField 2 f)
        (QuadraticMap.polarBilin
        (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2))) e)⁆) :
    ∃ (r : ℕ)
      (ι : (ggU .PSL (r + 1) f).K →*
      ↥(spinGroup (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2)))
      (β₀ : Fin (ggU .PSL (r + 1) f).D.rank → ℤ), r + 1 =
        Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.toLin' e)) ∧
      GGLongRoot (ggU .PSL (r + 1) f).D β₀ ∧
      (∀ y, ι y ∈ Subgroup.center
        ↥(spinGroup (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2)) →
        y ∈ Subgroup.center (ggU .PSL (r + 1) f).K) ∧ ι.range = J' ∧
      ∃ a₁ a₂ b₁ b₂ : (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) → (GaloisField 2 f),
        ((Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) a₁ = 0 ∧
          (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) a₂ = 0 ∧
          (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) b₁ = 0 ∧
          (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) b₂ = 0) ∧
        QuadraticMap.polar
          (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) a₁ b₁ = 1 ∧
          QuadraticMap.polar
          (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) a₂ b₂ = 1 ∧
        (QuadraticMap.polar
          (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) a₁ a₂ = 0 ∧
          QuadraticMap.polar
          (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) b₁ b₂ = 0 ∧
          QuadraticMap.polar
            (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) a₁ b₂ = 0 ∧
            QuadraticMap.polar
            (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) a₂ b₁ = 0)
            ∧
        (((ggU .PSL (r + 1) f).D.rootGroup β₀).map ι).map
        (Spin.spinAction
        (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2)) = siegelGroup
        (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) a₁ a₂ ∧
        (((ggU .PSL (r + 1) f).D.rootGroup (-β₀)).map ι).map
        (Spin.spinAction
        (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2)) = siegelGroup
        (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) b₁ b₂ := by
  obtain ⟨_hdeg1, _hscalar⟩ := bmdualm_block_scalar n f S he hdeg
  obtain ⟨horth, horth', heps, hestar⟩ := bmdualm_dualPair_data n f S hSU hS he hpair
  have hgen := bmdualm_generator_scalar n f S hSU hS he hdeg
  have hquad := bmdualm_block_quad_zero n f S hSU hS he hpair hdeg
  have hquad' := bmdualm_star_block_quad_zero n f S hSU hS he hpair hdeg
