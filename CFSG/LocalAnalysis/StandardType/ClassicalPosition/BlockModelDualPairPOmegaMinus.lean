theorem exists_blockModelClosure_dualPair_POmegaMinus_explicit
    (n f : ℕ) (hf : 1 ≤ f) (S : Set (GL (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈
    (Spin.spinMatrix
    (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2)).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') (hodd : ∀ s ∈ S, Odd (orderOf s))
    {e : Matrix (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
      (GaloisField 2 f)} (he : IsPrimIdemIn (Algebra.adjoin (GaloisField 2 f) (Units.val '' S)) e)
    (hn : 4 ≤ n)
    (hpair : formAdj (RingHom.id (GaloisField 2 f))
      (LinearMap.toMatrix₂' (GaloisField 2 f)
      (QuadraticMap.polarBilin
      (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2))) e ≠ e)
      (hdeg : blockDegree (Algebra.adjoin (GaloisField 2 f) (Units.val '' S)) e < 2)
    {J' : Subgroup
      ↥(spinGroup (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2))}
    (hJe : IsComponentOf J'
      ⁅glBlockCentralizer
      (Spin.spinMatrix (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2))
      S (e + formAdj (RingHom.id (GaloisField 2 f))
      (LinearMap.toMatrix₂' (GaloisField 2 f)
      (QuadraticMap.polarBilin
      (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2))) e),
      glBlockCentralizer
        (Spin.spinMatrix
        (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2)) S
        (e + formAdj (RingHom.id (GaloisField 2 f))
        (LinearMap.toMatrix₂' (GaloisField 2 f)
        (QuadraticMap.polarBilin
        (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2))) e)⁆) :
    ∃ (r : ℕ) (ι : (ggU .PSL (r + 1) f).K →* ↥(spinGroup (Spin.quadMinus n
        (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2))),
      r + 1 =
        Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.toLin' e)) ∧
      (∀ y, ι y ∈ Subgroup.center ↥(spinGroup (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2
          f).1 (minusCoeffs 2 f).2)) → y ∈ Subgroup.center (ggU .PSL (r + 1) f).K) ∧
      ι.range = J' ∧
      (∀ a₁ a₂ : ((Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) → GaloisField 2 f), a₁ ≠ 0 → a₂ ≠ 0 →
          LinearIndependent (GaloisField 2 f) ![a₁, a₂] → (Spin.quadMinus n (GaloisField 2 f)
          (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) a₁ = 0 → (Spin.quadMinus n (GaloisField 2 f)
          (minusCoeffs 2 f).1 (minusCoeffs 2 f).2) a₂ = 0 →
        QuadraticMap.polar (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2
            f).2) a₁ a₂ = 0 → siegelGroup (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
            (minusCoeffs 2 f).2) a₁ a₂ ≤ J'.map (Spin.spinAction (Spin.quadMinus n (GaloisField 2
            f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2)) →
        ∃ (β : Fin (ggU .PSL (r + 1) f).D.rank → ℤ) (u : (ggU .PSL (r + 1) f).K),
          β ∈ (ggU .PSL (r + 1) f).D.roots ∧
            GGLongRoot (ggU .PSL (r + 1) f).D β ∧
          ((((ggU .PSL (r + 1) f).D.rootGroup β).map (MulAut.conj u).toMonoidHom).map ι).map
              (Spin.spinAction (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs
              2 f).2)) = siegelGroup (Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
              (minusCoeffs 2 f).2) a₁ a₂) := by
  obtain ⟨_hdeg1, _hscalar⟩ := bmdualm_block_scalar n f S he hdeg
  obtain ⟨horth, horth', heps, hestar⟩ := bmdualm_dualPair_data n f S hSU hS he hpair
  have hgen := bmdualm_generator_scalar n f S hSU hS he hdeg
  have hquad := bmdualm_block_quad_zero n f S hSU hS he hpair hdeg
  have hquad' := bmdualm_star_block_quad_zero n f S hSU hS he hpair hdeg
  obtain ⟨R, r', eidx, P, Pinv, hPP, hPinvP, hP, hblock, hformOne, _hR1, hconv, hQA, hQB⟩ :=
    bmdualm_explicit_data n f hn S he hquad hquad' horth horth' heps hestar
  have hform : bmdualm_IsFormStandard n f R r' eidx :=
    bmdualm_IsFormStandardOne.toStandard hformOne
  obtain ⟨hJ'range, hRpos⟩ :=
    bmdualm_component_eq_range n f hn S hSU hS he hestar hgen hJe eidx hPP hPinvP hP hblock
      hconv hquad hquad' heps horth horth' hform
  let ι' : (ggU .PSL (R + 1) f).K →* ↥(spinGroup (bmdualmQ n f)) :=
    (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).comp
      (bmdualm_modelHom f R f (RingEquiv.refl (GaloisField 2 f)))
  refine ⟨R, ι', ?_, ?_, ?_, ?_⟩
  · exact bmdualmx_block_rank_eq n f R r' eidx hPP hPinvP hconv
  · have hι'inj : Function.Injective ι' := by
      intro x z hxz
      exact bmdualm_modelHom_injective f R f (RingEquiv.refl (GaloisField 2 f))
        (bmdualm_embedSpin_injective n f R r' hn eidx hPP hPinvP hP hblock hxz)
    exact fun y hy => bmdualm_mem_center_of_map_mem_center ι' hι'inj hy
  · rw [hJ'range]
    change ((bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).comp
      (bmdualm_modelHom f R f (RingEquiv.refl (GaloisField 2 f)))).range =
      (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range
    exact bmdualm_range_comp_eq_of_surjective _ _
      (bmdualm_modelHom_surjective f R f (RingEquiv.refl (GaloisField 2 f)))
  · exact bmdualm_closure_explicit n f hn eidx hPP hPinvP hP hblock hformOne hRpos hQA hQB
      hJ'range f (RingEquiv.refl (GaloisField 2 f)) (hι' := rfl)

