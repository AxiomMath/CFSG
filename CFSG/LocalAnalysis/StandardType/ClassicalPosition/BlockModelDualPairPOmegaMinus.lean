    funext x
    rw [Finset.sum_apply]
    rcases hx : (bmdualm_eidxR r s n hrs hs hr1).symm x with a | (b | k)
    · have hx' : x = (bmdualm_eidxR r s n hrs hs hr1) (Sum.inl a) := by
