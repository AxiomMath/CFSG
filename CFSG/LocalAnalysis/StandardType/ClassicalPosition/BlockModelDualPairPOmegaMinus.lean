        (Matrix.mulVec (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n)
          (GaloisField 2 f)) v) =
      Matrix.mulVec (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n)
        (GaloisField 2 f)) (Matrix.mulVec e v) := by
  intro v
  have hv : v = Matrix.mulVec e v + Matrix.mulVec (bmdualmestar n f e) v +
      Matrix.mulVec (1 - bmdualmeps n f e) v := by
    conv_lhs => rw [show v = Matrix.mulVec (bmdualmeps n f e) v +
        Matrix.mulVec (1 - bmdualmeps n f e) v from by
      rw [← Matrix.add_mulVec, add_sub_cancel, Matrix.one_mulVec]]
    rw [show bmdualmeps n f e = e + bmdualmestar n f e from rfl, Matrix.add_mulVec]
  have hPe : Matrix.mulVec (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n)
        (GaloisField 2 f)) v =
      Matrix.mulVec (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n)
        (GaloisField 2 f)) (Matrix.mulVec e v) +
      Matrix.mulVec (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n)
        (GaloisField 2 f)) (Matrix.mulVec (bmdualmestar n f e) v) +
      Matrix.mulVec (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n)
        (GaloisField 2 f)) (Matrix.mulVec (1 - bmdualmeps n f e) v) := by
    conv_lhs => rw [hv]
    rw [Matrix.mulVec_add, Matrix.mulVec_add]
  rw [hPe, Matrix.mulVec_add, Matrix.mulVec_add,
    bmdualm_explicit_D0_e n f r s hrs hs hr1 hPee hPeSpan hee horth g hg v,
    bmdualm_explicit_D0_estar n f r s hrs hs hr1 hPees hPeSpan hee horth' g hg v,
    bmdualm_explicit_D0_oneMinus n f r s hrs hs hr1 hPeε hPee hPees hPeSpan hee horth horth'
      g hg v,
    add_zero, add_zero]

private theorem bmdualm_explicit_hconv_mat (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (hr1 : 1 ≤ r) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {Pe : Matrix (bmdualmι n) (Fin r ⊕ Fin r) (GaloisField 2 f)}
    (hPeε : bmdualmeps n f e * Pe = Pe)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualmestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualmι n → GaloisField 2 f,
      Matrix.mulVec (bmdualmeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Pe))
    (hee : e * e = e) (horth : e * bmdualmestar n f e = 0)
    (horth' : bmdualmestar n f e * e = 0)
    (g : ↥(spinGroup (bmdualmQ n f)))
    (hg : ∀ c : Fin r ⊕ Fin r,
      Spin.spinAction (bmdualmQ n f) g (Matrix.mulVec Pe (Pi.single c 1)) =
        Pi.single (bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s c)) 1) :
    Matrix.reindex (bmdualm_eidxR r s n hrs hs hr1) (bmdualm_eidxR r s n hrs hs hr1)
        (bmdualm_D0 (r - 1 + 1) (2 * s) (GaloisField 2 f)) *
      (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
      (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) * e := by
  have hD0 := bmdualm_explicit_D0_conj n f r s hrs hs hr1 hPeε hPee hPees hPeSpan hee horth
    horth' g hg
  have hv : ∀ v : bmdualmι n → GaloisField 2 f,
      Matrix.mulVec (Matrix.reindex (bmdualm_eidxR r s n hrs hs hr1)
        (bmdualm_eidxR r s n hrs hs hr1)
        (bmdualm_D0 (r - 1 + 1) (2 * s) (GaloisField 2 f)) *
        (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))) v =
      Matrix.mulVec ((↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n)
        (GaloisField 2 f)) * e) v := by
    intro v
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
    exact hD0 v
  ext i j
  have h := congrFun (hv (Pi.single j 1)) i
  simpa [Matrix.mulVec, dotProduct, Pi.single_apply] using h

private theorem bmdualm_explicit_hconv (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s) (hr1 : 1 ≤ r)
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {Pe : Matrix (bmdualmι n) (Fin r ⊕ Fin r) (GaloisField 2 f)}
    (hPeε : bmdualmeps n f e * Pe = Pe)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualmestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualmι n → GaloisField 2 f,
      Matrix.mulVec (bmdualmeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Pe))
    (hee : e * e = e) (horth : e * bmdualmestar n f e = 0)
    (horth' : bmdualmestar n f e * e = 0)
    (g : ↥(spinGroup (bmdualmQ n f)))
    (hg : ∀ c : Fin r ⊕ Fin r,
      Spin.spinAction (bmdualmQ n f) g (Matrix.mulVec Pe (Pi.single c 1)) =
        Pi.single (bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s c)) 1) :
    (↑(bmdualmJ n f g⁻¹) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) *
      Matrix.reindex (bmdualm_eidxR r s n hrs hs hr1) (bmdualm_eidxR r s n hrs hs hr1)
        (bmdualm_D0 (r - 1 + 1) (2 * s) (GaloisField 2 f)) *
      (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) = e := by
  obtain ⟨-, hPinvP⟩ := bmdualm_explicit_hconv_inv n f g
  have hmat := bmdualm_explicit_hconv_mat n f r s hrs hs hr1 hPeε hPee hPees hPeSpan hee horth
    horth' g hg
  rw [Matrix.mul_assoc, hmat, ← Matrix.mul_assoc, hPinvP, Matrix.one_mul]

private theorem bmdualm_explicit_hQA (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s) (hr1 : 1 ≤ r)
    (g : ↥(spinGroup (bmdualmQ n f))) :
    ∀ a : Fin (r - 1 + 1),
      bmdualmQ n f (Matrix.mulVec
        (↑(bmdualmJ n f g⁻¹) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
        (Pi.single (bmdualm_eidxR r s n hrs hs hr1 (Sum.inl a)) 1)) = 0 := by
  intro a
  have h1 : bmdualm_eidxR r s n hrs hs hr1 (Sum.inl a) =
      Sum.inl (Fin.castLE (by omega) a) := by
    simp only [bmdualm_eidxR, Equiv.trans_apply, Equiv.sumCongr_apply, bmdualm_eidx_inl]
    rfl
  rw [h1]
  have hmem := (Spin.spinMatrix_mem (bmdualmQ n f) g⁻¹)
    (Pi.single (Sum.inl (Fin.castLE (by omega) a)) 1)
  simp only [bmdualmJ] at hmem ⊢
  rw [hmem]
  rw [show bmdualmQ n f = Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
    (minusCoeffs 2 f).2 from rfl, Spin.quadMinus_apply]
  simp [Pi.single_apply, CharP.cast_eq_zero]

private theorem bmdualm_explicit_hQB (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s) (hr1 : 1 ≤ r)
    (g : ↥(spinGroup (bmdualmQ n f))) :
    ∀ a : Fin (r - 1 + 1),
      bmdualmQ n f (Matrix.mulVec
        (↑(bmdualmJ n f g⁻¹) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
        (Pi.single (bmdualm_eidxR r s n hrs hs hr1 (Sum.inr (Sum.inl a))) 1)) = 0 := by
  intro a
  have h1 : bmdualm_eidxR r s n hrs hs hr1 (Sum.inr (Sum.inl a)) =
      Sum.inr (Sum.inl (Fin.castLE (by omega) a)) := by
    simp only [bmdualm_eidxR, Equiv.trans_apply, Equiv.sumCongr_apply, bmdualm_eidx_inr_inl]
    rfl
  rw [h1]
  have hmem := (Spin.spinMatrix_mem (bmdualmQ n f) g⁻¹)
    (Pi.single (Sum.inr (Sum.inl (Fin.castLE (by omega) a))) 1)
  simp only [bmdualmJ] at hmem ⊢
  rw [hmem]
  rw [show bmdualmQ n f = Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
    (minusCoeffs 2 f).2 from rfl, Spin.quadMinus_apply]
  simp [Pi.single_apply, CharP.cast_eq_zero]

private theorem bmdualm_explicit_data
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e)) :
    ∃ (R r' : ℕ) (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
      (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
      (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
      (hP : ∀ v : bmdualmι n → GaloisField 2 f,
        bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
      (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
        (w : bmdualmι n → GaloisField 2 f),
        bmdualmQ n f (Matrix.mulVec
          (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
          bmdualmQ n f w),
      bmdualm_IsFormStandardOne n f R r' eidx ∧
      0 ≤ R ∧ Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e ∧
      (∀ a : Fin (R + 1),
        bmdualmQ n f (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inl a)) 1)) = 0) ∧
      (∀ a : Fin (R + 1),
        bmdualmQ n f (Matrix.mulVec Pinv (Pi.single (eidx (Sum.inr (Sum.inl a))) 1)) = 0) := by
  obtain ⟨r, Pe, hPeG, hPeε, hPee, hPees, hPeSpan, hr⟩ :=
    bmdualm_adapted_basis_e_span n f S he horth horth' hestar
  have hrle : r ≤ n - 1 := by
    let W : Submodule (GaloisField 2 f) (Spin.Twisted.Vm n (GaloisField 2 f)) :=
      LinearMap.range (Matrix.mulVecLin e)
    have hW : ∀ w ∈ W, Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
        (minusCoeffs 2 f).2 w = 0 := by
      intro w hw
      obtain ⟨x, rfl⟩ := hw
      exact hquad x
    have hfin := CFSG.StandardType.GGOppRadOmega.finrank_le_of_quadMinus (minusCoeffs_irr 2 f) hW
    rw [← hr]
    exact hfin
  have hrs : r + (n - r) = n := Nat.add_sub_of_le (le_trans hrle (Nat.sub_le n 1))
  have hs : 1 ≤ n - r := by omega
  have hPequad : ∀ c : Fin r ⊕ Fin r,
      bmdualmQ n f (Matrix.mulVec Pe (Pi.single c 1)) = 0 :=
    bmdualm_Pe_col_quad n f r hquad hquad' hPee hPees
  obtain ⟨g, hg⟩ := bmdualm_witt n f r (n - r) hn hrs hs hPeG hPequad
  have hε : bmdualmeps n f e ≠ 0 := by
    intro h0
    apply he.2.2.1
    calc e = e * bmdualmeps n f e := by
          rw [bmdualmeps, mul_add, he.2.1.eq, horth, add_zero]
      _ = e * 0 := by rw [h0]
      _ = 0 := mul_zero e
  have hr1 : 1 ≤ r := bmdualm_glue_r_pos n f r (n - r) Pe hPeSpan hε
  refine ⟨r - 1, 2 * (n - r), bmdualm_eidxR r (n - r) n hrs hs hr1,
    (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)),
    (↑(bmdualmJ n f g⁻¹) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)),
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [← Units.val_mul, ← map_mul, mul_inv_cancel, map_one, Units.val_one]
  · rw [← Units.val_mul, ← map_mul, inv_mul_cancel, map_one, Units.val_one]
  · intro v
    exact (Spin.spinMatrix_mem (bmdualmQ n f) g) v
  · exact bmdualm_explicit_hblock n f r (n - r) hrs hs hr1
  · exact bmdualm_explicit_hform n f r (n - r) hrs hs hr1
  · exact Nat.zero_le _
  · exact bmdualm_explicit_hconv n f r (n - r) hrs hs hr1 hPeε hPee hPees hPeSpan he.2.1.eq
      horth horth' g hg
  · exact bmdualm_explicit_hQA n f r (n - r) hrs hs hr1 g
  · exact bmdualm_explicit_hQB n f r (n - r) hrs hs hr1 g

private theorem bmdualm_conj_mul (n f : ℕ)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1)
    (v w : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :
    (Pinv * v * P) * (Pinv * w * P) = Pinv * (v * w) * P := by
  calc (Pinv * v * P) * (Pinv * w * P)
      = Pinv * v * (P * Pinv) * w * P := by noncomm_ring
    _ = Pinv * v * 1 * w * P := by rw [hPP]
    _ = Pinv * (v * w) * P := by noncomm_ring

private theorem bmdualm_conj_one (n f : ℕ)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1) :
    Pinv * 1 * P = 1 := by rw [Matrix.mul_one, hPinvP]

private theorem bmdualm_blockMat_one (n f r r' : ℕ) :
    bmdualm_blockMat n f r r' (1 : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) =
      1 := by
  unfold bmdualm_blockMat
  rw [inv_one, Matrix.SpecialLinearGroup.coe_one, Matrix.transpose_one,
    Matrix.fromBlocks_one, Matrix.fromBlocks_one]

private theorem bmdualm_blockMat_mul (n f r r' : ℕ)
    (x y : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmdualm_blockMat n f r r' (x * y) =
      bmdualm_blockMat n f r r' x * bmdualm_blockMat n f r r' y := by
  have hinner : (Matrix.fromBlocks
        (Matrix.transpose (((x⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f))))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) *
      (Matrix.fromBlocks
        (Matrix.transpose (((y⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f))))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) =
      Matrix.fromBlocks
        (Matrix.transpose ((((x * y)⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f))))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) := by
    rw [Matrix.fromBlocks_multiply]
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one]
    rw [show Matrix.transpose (((x * y)⁻¹ :
            Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)) =
        Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)) *
        Matrix.transpose ((y⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)) from by
      rw [show ((x * y)⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) =
            y⁻¹ * x⁻¹ from mul_inv_rev x y,
        Matrix.SpecialLinearGroup.coe_mul, Matrix.transpose_mul]]
  unfold bmdualm_blockMat
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [hinner, Matrix.SpecialLinearGroup.coe_mul]

private theorem bmdualm_blockMat_injective (n f r r' : ℕ) :
    Function.Injective (bmdualm_blockMat n f r r') := by
  intro x y hxy
  apply Subtype.ext
  ext i j
  have h := congrArg (fun M : Matrix (Fin r ⊕ (Fin r ⊕ Fin r'))
      (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f) => M (Sum.inl i) (Sum.inl j)) hxy
  simpa [bmdualm_blockMat, Matrix.fromBlocks] using h

private noncomputable def bmdualm_embedGL (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1) :
    Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) →*
      GL (bmdualmι n) (GaloisField 2 f) where
  toFun x := Units.mk (Pinv * Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) * P)
    (Pinv * Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x⁻¹) * P)
    (by
      change (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
            (bmdualm_blockMat n f (R + 1) r' x) * P) *
          (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
            (bmdualm_blockMat n f (R + 1) r' x⁻¹) * P) = 1
      rw [bmdualm_conj_mul n f P Pinv hPP, ← map_mul, ← bmdualm_blockMat_mul,
        mul_inv_cancel x, bmdualm_blockMat_one, map_one,
        bmdualm_conj_one n f P Pinv hPinvP])
    (by
      change (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
            (bmdualm_blockMat n f (R + 1) r' x⁻¹) * P) *
          (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
            (bmdualm_blockMat n f (R + 1) r' x) * P) = 1
      rw [bmdualm_conj_mul n f P Pinv hPP, ← map_mul, ← bmdualm_blockMat_mul,
        inv_mul_cancel x, bmdualm_blockMat_one, map_one,
        bmdualm_conj_one n f P Pinv hPinvP])
  map_one' := by
    apply Units.ext
    change Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdualm_blockMat n f (R + 1) r' 1) * P = 1
    rw [bmdualm_blockMat_one, map_one, bmdualm_conj_one n f P Pinv hPinvP]
  map_mul' x y := by
    apply Units.ext
    change Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdualm_blockMat n f (R + 1) r' (x * y)) * P =
      (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdualm_blockMat n f (R + 1) r' x) * P) *
      (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdualm_blockMat n f (R + 1) r' y) * P)
    rw [bmdualm_blockMat_mul, map_mul, ← bmdualm_conj_mul n f P Pinv hPP]

private theorem bmdualm_embedGL_injective (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1) :
    Function.Injective (bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP) := by
  intro x y hxy
  have h := congrArg (fun g : GL (bmdualmι n) (GaloisField 2 f) =>
    (g : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))) hxy
  have h2 : Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) =
      Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' y) := by
    have h3 : P * (Pinv * Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) * P) *
        Pinv = P * (Pinv * Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' y) * P) *
        Pinv := congrArg (fun M => P * M * Pinv) h
    have hAx : P * (Pinv * Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) * P) *
        Pinv = Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) := by
      rw [Matrix.mul_assoc, Matrix.mul_assoc, hPP, Matrix.mul_one, ← Matrix.mul_assoc, hPP,
        Matrix.one_mul]
    have hAy : P * (Pinv * Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' y) * P) *
        Pinv = Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' y) := by
      rw [Matrix.mul_assoc, Matrix.mul_assoc, hPP, Matrix.mul_one, ← Matrix.mul_assoc, hPP,
        Matrix.one_mul]
    rwa [hAx, hAy] at h3
  exact bmdualm_blockMat_injective n f (R + 1) r'
    ((Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx).injective h2)

private theorem bmdualm_embedGL_isometry (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec
        ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualmι n) (GaloisField 2 f)) :
          Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) v) =
        bmdualmQ n f v := by
  intro v
  have hPinv : ∀ w : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec Pinv w) = bmdualmQ n f w := by
    intro w
    have h := hP (Matrix.mulVec Pinv w)
    rw [Matrix.mulVec_mulVec, hPP, Matrix.one_mulVec] at h
    exact h.symm
  change bmdualmQ n f (Matrix.mulVec
      (Pinv * Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) * P) v) =
    bmdualmQ n f v
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
  rw [hPinv, hblock x (Matrix.mulVec P v), hP v]

private theorem bmdualm_finrank_prod {m n : Type*} [Fintype m] [Fintype n]
    (F : Type) [Field F] (S : Submodule F (m → F)) (T : Submodule F (n → F)) :
    Module.finrank F (S.prod T) = Module.finrank F S + Module.finrank F T := by
  have iso : S.prod T ≃ₗ[F] (S × T) :=
    { toFun := fun x => (⟨x.1.1, x.2.1⟩, ⟨x.1.2, x.2.2⟩)
      invFun := fun y => ⟨(y.1.1, y.2.1), ⟨y.1.2, y.2.2⟩⟩
      left_inv := by intro x; ext <;> rfl
      right_inv := by intro y; ext <;> rfl
      map_add' := by intro x y; ext <;> rfl
      map_smul' := by intro c x; ext <;> rfl }
  rw [LinearEquiv.finrank_eq iso, Module.finrank_prod]

private theorem bmdualm_rank_fromBlocks_zero {m n : Type*} [Fintype m] [Fintype n]
    (F : Type) [Field F] (A : Matrix m m F) (D : Matrix n n F) :
    (Matrix.fromBlocks A (0 : Matrix m n F) (0 : Matrix n m F) D).rank = A.rank + D.rank := by
  set B := Matrix.fromBlocks A (0 : Matrix m n F) (0 : Matrix n m F) D with hB
  have hmap : (LinearMap.range B.mulVecLin).map
        (LinearEquiv.sumArrowLequivProdArrow m n F F).toLinearMap =
      (LinearMap.range A.mulVecLin).prod (LinearMap.range D.mulVecLin) := by
    ext z
    constructor
    · rintro ⟨_, ⟨v, rfl⟩, rfl⟩
      constructor
      · refine ⟨v ∘ Sum.inl, ?_⟩
        rw [Matrix.mulVecLin_apply, Matrix.mulVecLin_apply]
        congr 1
        funext i
        simp [hB, Matrix.fromBlocks, Matrix.mulVec, dotProduct, Fintype.sum_sum_type]
      · refine ⟨v ∘ Sum.inr, ?_⟩
        rw [Matrix.mulVecLin_apply, Matrix.mulVecLin_apply]
        congr 1
        funext j
        simp [hB, Matrix.fromBlocks, Matrix.mulVec, dotProduct, Fintype.sum_sum_type]
    · rintro ⟨hu, hw⟩
      obtain ⟨u', hu'⟩ := hu
      obtain ⟨w', hw'⟩ := hw
      refine ⟨Matrix.mulVec B (Sum.elim u' w'), ⟨⟨Sum.elim u' w', rfl⟩, ?_⟩⟩
      apply Prod.ext
      · funext i
        simpa [LinearEquiv.sumArrowLequivProdArrow_apply_fst, hB, Matrix.fromBlocks,
          Matrix.mulVec, dotProduct, Fintype.sum_sum_type] using congrFun hu' i
      · funext j
        simpa [LinearEquiv.sumArrowLequivProdArrow_apply_snd, hB, Matrix.fromBlocks,
          Matrix.mulVec, dotProduct, Fintype.sum_sum_type] using congrFun hw' j
  rw [Matrix.rank_eq_finrank_span_cols, Matrix.rank_eq_finrank_span_cols,
    Matrix.rank_eq_finrank_span_cols, ← Matrix.range_mulVecLin, ← Matrix.range_mulVecLin,
    ← Matrix.range_mulVecLin]
  rw [← LinearEquiv.finrank_map_eq (LinearEquiv.sumArrowLequivProdArrow m n F F)
    (LinearMap.range B.mulVecLin), hmap]
  exact bmdualm_finrank_prod F _ _

private theorem bmdualm_finrank_commSpace_toLinEquiv {ι : Type} [Fintype ι] [DecidableEq ι]
    (F : Type) [Field F] (A : GL ι F) :
    Module.finrank F (CFSG.RankThree.OrthogonalInvolutions.commSpace
        (CFSG.ClassicalGroups.Orthogonal.toLinEquiv ι F A)) =
      (((A : Matrix ι ι F) - 1)).rank := by
  unfold CFSG.RankThree.OrthogonalInvolutions.commSpace
  have h1 : ((CFSG.ClassicalGroups.Orthogonal.toLinEquiv ι F A : (ι → F) ≃ₗ[F] (ι → F)) :
      (ι → F) →ₗ[F] (ι → F)) = (A : Matrix ι ι F).mulVecLin := by
    apply LinearMap.ext
    intro v
    exact CFSG.ClassicalGroups.Orthogonal.toLinEquiv_apply A v
  have h2 : (A : Matrix ι ι F).mulVecLin - 1 =
      ((A : Matrix ι ι F) - 1).mulVecLin := by
    apply LinearMap.ext
    intro v
    simp [Matrix.sub_mulVec]
  rw [h1, h2, Matrix.range_mulVecLin, Matrix.rank_eq_finrank_span_cols]

private theorem bmdualm_rank_sub_one_conj (n f : ℕ)
    (P Pinv B : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1) :
    (Pinv * B * P - 1).rank = (B - 1).rank := by
  have hPU : IsUnit P.det := by
    rw [← Matrix.isUnit_iff_isUnit_det P]
    exact ⟨Units.mk P Pinv hPP hPinvP, rfl⟩
  have hPinvU : IsUnit Pinv.det := by
    rw [← Matrix.isUnit_iff_isUnit_det Pinv]
    exact ⟨Units.mk Pinv P hPinvP hPP, rfl⟩
  have heq : Pinv * B * P - 1 = Pinv * (B - 1) * P := by
    rw [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_one, hPinvP]
  rw [heq, Matrix.mul_assoc]
  rw [Matrix.rank_mul_eq_right_of_isUnit_det Pinv ((B - 1) * P) hPinvU,
    Matrix.rank_mul_eq_left_of_isUnit_det P (B - 1) hPU]

private theorem bmdualm_rank_inv_transpose_sub_one (m f : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
    (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) - 1).rank =
      ((x : Matrix (Fin m) (Fin m) (GaloisField 2 f)) - 1).rank := by
  have htrans : Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) - 1 =
      Matrix.transpose (((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) - 1) := by
    rw [Matrix.transpose_sub, Matrix.transpose_one]
  rw [htrans, Matrix.rank_transpose]
  have hxunit : IsUnit (((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
      Matrix (Fin m) (Fin m) (GaloisField 2 f))).det := by
    rw [Matrix.SpecialLinearGroup.det_coe]
    exact isUnit_one
  have hrel : ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) - 1 =
      ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) *
      ((x : Matrix (Fin m) (Fin m) (GaloisField 2 f)) - 1) := by
    rw [Matrix.mul_sub, Matrix.mul_one]
    have hmul : ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) *
        (x : Matrix (Fin m) (Fin m) (GaloisField 2 f)) = 1 := by
      rw [← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel,
        Matrix.SpecialLinearGroup.coe_one]
    rw [hmul]
    ext i j
    simp only [Matrix.sub_apply]
    rw [CharTwo.sub_eq_add, CharTwo.sub_eq_add, add_comm]
  rw [hrel, Matrix.rank_mul_eq_right_of_isUnit_det _ _ hxunit]

private theorem bmdualm_blockMat_sub_one (n f R r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    bmdualm_blockMat n f (R + 1) r' x - 1 =
      Matrix.fromBlocks ((x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1)
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (Matrix.fromBlocks
          (Matrix.transpose (((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) - 1)
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) := by
  unfold bmdualm_blockMat
  ext p q
  rcases p with a | (b | d) <;> rcases q with a' | (b' | d') <;>
    simp [Matrix.fromBlocks, Matrix.sub_apply, Matrix.one_apply, Matrix.zero_apply]

private theorem bmdualm_even_rank_reindex_blockMat (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    Even ((Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) - 1).rank) := by
  have hreindex : Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) - 1 =
      Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x - 1) := by
    change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdualm_blockMat n f (R + 1) r' x) - 1 =
      (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdualm_blockMat n f (R + 1) r' x - 1)
    rw [map_sub, map_one]
  rw [hreindex, Matrix.rank_reindex, bmdualm_blockMat_sub_one,
    bmdualm_rank_fromBlocks_zero (GaloisField 2 f),
    bmdualm_rank_fromBlocks_zero (GaloisField 2 f), Matrix.rank_zero,
    bmdualm_rank_inv_transpose_sub_one]
  exact ⟨((x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1).rank,
    by ring⟩

private theorem bmdualm_even_finrank_commSpace_embedGL (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    Even (Module.finrank (GaloisField 2 f)
      (CFSG.RankThree.OrthogonalInvolutions.commSpace
        (CFSG.ClassicalGroups.Orthogonal.toLinEquiv (bmdualmι n) (GaloisField 2 f)
          (bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x)))) := by
  rw [bmdualm_finrank_commSpace_toLinEquiv]
  have hcoe : ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x :
        GL (bmdualmι n) (GaloisField 2 f)) : Matrix (bmdualmι n) (bmdualmι n)
          (GaloisField 2 f)) =
      Pinv * Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) * P := rfl
  rw [hcoe, bmdualm_rank_sub_one_conj n f P Pinv
    (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) hPP hPinvP]
  exact bmdualm_even_rank_reindex_blockMat n f R r' eidx x

private theorem bmdualm_embedGL_mem_spin (n f R r' : ℕ) (hn : 4 ≤ n)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    ∃ u : ↥(spinGroup (bmdualmQ n f)),
      ((bmdualmJ n f u : GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
      ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) := by
  have hM := bmdualm_embedGL_isometry n f R r' eidx hPP hPinvP hP hblock x
  have horth : (CFSG.ClassicalGroups.Orthogonal.toLinEquiv (bmdualmι n) (GaloisField 2 f)
        (bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x)) ∈
      TauCeti.QuadraticMap.orthogonalGroup (bmdualmQ n f) :=
    TauCeti.QuadraticMap.mem_orthogonalGroup_iff.mpr (fun v => by
      rw [CFSG.ClassicalGroups.Orthogonal.toLinEquiv_apply]
      exact hM v)
  have heven := bmdualm_even_finrank_commSpace_embedGL n f R r' eidx hPP hPinvP x
  have hΩ : (CFSG.ClassicalGroups.Orthogonal.toLinEquiv (bmdualmι n) (GaloisField 2 f)
        (bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x)) ∈
      CFSG.RankThree.OrthogonalInvolutions.omegaGroup (bmdualmQ n f)
        (Spin.nondegenerate_polarBilin_quadMinus_of_finite n (GaloisField 2 f)
          (minusCoeffs_irr 2 f)) :=
    (CFSG.RankThree.OrthogonalInvolutions.mem_omegaGroup).mpr ⟨horth, heven⟩
  obtain ⟨u, hu⟩ :=
    CFSG.StandardType.GGOppRadOmega.exists_spinAction_eq_of_mem_omegaGroup_minus
      (minusCoeffs_irr 2 f) hn hΩ
  refine ⟨u, ?_⟩
  apply Matrix.mulVec_injective
  funext v
  rw [Spin.spinMatrix_mulVec, ← CFSG.ClassicalGroups.Orthogonal.toLinEquiv_apply]
  exact congrArg (fun (f : (bmdualmι n → GaloisField 2 f) ≃ₗ[GaloisField 2 f]
    (bmdualmι n → GaloisField 2 f)) => f v) hu

private theorem bmdualm_spinMatrix_injective (n f : ℕ) :
    Function.Injective (bmdualmJ n f) := by
  rw [← MonoidHom.ker_eq_bot_iff]
  exact Spin.ker_spinMatrix_quadMinus_eq_bot (minusCoeffs_irr 2 f)
    (CharP.cast_eq_zero (GaloisField 2 f) 2)

private theorem bmdualm_embedGL_choose_eq (n f R r' : ℕ) (hn : 4 ≤ n)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    bmdualmJ n f
        (Classical.choose (bmdualm_embedGL_mem_spin n f R r' hn eidx hPP hPinvP hP hblock x)) =
      bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x :=
  Units.ext (Classical.choose_spec
    (bmdualm_embedGL_mem_spin n f R r' hn eidx hPP hPinvP hP hblock x))

private noncomputable def bmdualm_embedSpin (n f R r' : ℕ) (hn : 4 ≤ n)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w) :
    Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) →*
      ↥(spinGroup (bmdualmQ n f)) where
  toFun x := Classical.choose (bmdualm_embedGL_mem_spin n f R r' hn eidx hPP hPinvP hP hblock x)
  map_one' := by
    apply bmdualm_spinMatrix_injective n f
    rw [bmdualm_embedGL_choose_eq n f R r' hn eidx hPP hPinvP hP hblock,
      map_one (bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP),
      map_one (bmdualmJ n f)]
  map_mul' x y := by
    apply bmdualm_spinMatrix_injective n f
    rw [bmdualm_embedGL_choose_eq n f R r' hn eidx hPP hPinvP hP hblock,
      map_mul (bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP),
      map_mul (bmdualmJ n f),
      bmdualm_embedGL_choose_eq n f R r' hn eidx hPP hPinvP hP hblock,
      bmdualm_embedGL_choose_eq n f R r' hn eidx hPP hPinvP hP hblock]

private theorem bmdualm_embedSpin_spinMatrix (n f R r' : ℕ) (hn : 4 ≤ n)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    ((bmdualmJ n f
        (bmdualm_embedSpin n f R r' hn eidx P Pinv hPP hPinvP hP hblock x) :
        GL (bmdualmι n) (GaloisField 2 f)) :
      Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
    ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualmι n) (GaloisField 2 f)) :
      Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) := by
  simpa [bmdualm_embedSpin] using
    Classical.choose_spec (bmdualm_embedGL_mem_spin n f R r' hn eidx hPP hPinvP hP hblock x)

private theorem bmdualm_embedSpin_injective (n f R r' : ℕ) (hn : 4 ≤ n)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w) :
    Function.Injective (bmdualm_embedSpin n f R r' hn eidx P Pinv hPP hPinvP hP hblock) := by
  intro x y hxy
  have hJ : bmdualmJ n f
        (bmdualm_embedSpin n f R r' hn eidx P Pinv hPP hPinvP hP hblock x) =
      bmdualmJ n f
        (bmdualm_embedSpin n f R r' hn eidx P Pinv hPP hPinvP hP hblock y) :=
    congrArg (bmdualmJ n f) hxy
  have hmat : ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x :
        GL (bmdualmι n) (GaloisField 2 f)) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
      ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP y :
        GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) := by
    rw [← bmdualm_embedSpin_spinMatrix n f R r' hn eidx hPP hPinvP hP hblock x,
      ← bmdualm_embedSpin_spinMatrix n f R r' hn eidx hPP hPinvP hP hblock y]
    exact congrArg (fun g : GL (bmdualmι n) (GaloisField 2 f) =>
      (g : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))) hJ
  exact bmdualm_embedGL_injective n f R r' eidx hPP hPinvP (Units.ext hmat)

private noncomputable def bmdualm_embedHom (n f R r' : ℕ) (hn : 4 ≤ n)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w) :
    Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) →*
      ↥(spinGroup (bmdualmQ n f)) :=
  bmdualm_embedSpin n f R r' hn eidx P Pinv hPP hPinvP hP hblock

private theorem bmdualm_reindex_mul (f : ℕ) {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ] (e : ι ≃ κ) (A B : Matrix ι ι (GaloisField 2 f)) :
    Matrix.reindex e e (A * B) = Matrix.reindex e e A * Matrix.reindex e e B := by
  change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) (A * B) =
    (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) A *
      (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) B
  rw [map_mul]

private theorem bmdualm_reindex_one (f : ℕ) {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ] (e : ι ≃ κ) :
    Matrix.reindex e e (1 : Matrix ι ι (GaloisField 2 f)) = 1 := by
  change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e)
    (1 : Matrix ι ι (GaloisField 2 f)) = 1
  rw [map_one]

private theorem bmdualm_reindex_comp_symm (f : ℕ) {ι κ : Type*} (e : ι ≃ κ)
    (A : Matrix ι ι (GaloisField 2 f)) :
    Matrix.reindex e.symm e.symm (Matrix.reindex e e A) = A := by
  ext i j
  simp [Matrix.reindex_apply]

private noncomputable def bmdualm_glBlock (f R r' : ℕ)
    (a : GL (Fin (R + 1)) (GaloisField 2 f)) :
    Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (GaloisField 2 f) :=
  Matrix.fromBlocks (a : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
    (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
    (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
    (Matrix.fromBlocks (Matrix.transpose ((a⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
      Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))

private theorem bmdualm_blockMat_eq_glBlock (n f R r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    bmdualm_blockMat n f (R + 1) r' x =
      bmdualm_glBlock f R r' (x : GL (Fin (R + 1)) (GaloisField 2 f)) := rfl

private theorem bmdualm_glBlock_one (f R r' : ℕ) :
    bmdualm_glBlock f R r' (1 : GL (Fin (R + 1)) (GaloisField 2 f)) = 1 := by
  unfold bmdualm_glBlock
  simp only [inv_one, Units.val_one, Matrix.transpose_one, Matrix.fromBlocks_one]

private theorem bmdualm_glBlock_mul (f R r' : ℕ)
    (a b : GL (Fin (R + 1)) (GaloisField 2 f)) :
    bmdualm_glBlock f R r' (a * b) = bmdualm_glBlock f R r' a * bmdualm_glBlock f R r' b := by
  have hinner : (Matrix.fromBlocks
        (Matrix.transpose (((a⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) *
      (Matrix.fromBlocks
        (Matrix.transpose (((b⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) =
      Matrix.fromBlocks
        (Matrix.transpose ((((a * b)⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) := by
    rw [Matrix.fromBlocks_multiply]
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one]
    rw [show Matrix.transpose (((a * b)⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) =
        Matrix.transpose (((a⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) *
        Matrix.transpose (((b⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) from by
      rw [show ((a * b)⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) = b⁻¹ * a⁻¹ from
        mul_inv_rev a b, Units.val_mul, Matrix.transpose_mul]]
  unfold bmdualm_glBlock
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [hinner, Units.val_mul]

private theorem bmdualm_glBlock_inv (f R r' : ℕ) (a : GL (Fin (R + 1)) (GaloisField 2 f)) :
    bmdualm_glBlock f R r' a⁻¹ = (bmdualm_glBlock f R r' a)⁻¹ := by
  have h : bmdualm_glBlock f R r' a * bmdualm_glBlock f R r' a⁻¹ = 1 := by
    rw [← bmdualm_glBlock_mul, mul_inv_cancel, bmdualm_glBlock_one]
  exact (Matrix.inv_eq_right_inv h).symm

private noncomputable def bmdualm_gm (n f : ℕ) (g : ↥(spinGroup (bmdualmQ n f))) :
    Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f) :=
  ((bmdualmJ n f g : GL (bmdualmι n) (GaloisField 2 f)) :
    Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))

private theorem bmdualm_gm_mul (n f : ℕ)
    (g h : ↥(spinGroup (bmdualmQ n f))) :
    bmdualm_gm n f (g * h) = bmdualm_gm n f g * bmdualm_gm n f h := by
  unfold bmdualm_gm
  rw [map_mul (bmdualmJ n f), Units.val_mul]

private noncomputable def bmdualm_matOf (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (g : ↥(spinGroup (bmdualmQ n f))) :
    Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (GaloisField 2 f) :=
  Matrix.reindex eidx.symm eidx.symm (P * bmdualm_gm n f g * Pinv)

private theorem bmdualm_matOf_mul (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1)
    (g h : ↥(spinGroup (bmdualmQ n f))) :
    bmdualm_matOf n f R r' eidx P Pinv (g * h) =
      bmdualm_matOf n f R r' eidx P Pinv g * bmdualm_matOf n f R r' eidx P Pinv h := by
  unfold bmdualm_matOf
  rw [← bmdualm_reindex_mul, bmdualm_gm_mul]
  congr 1
  calc P * (bmdualm_gm n f g * bmdualm_gm n f h) * Pinv
      = (P * bmdualm_gm n f g * Pinv) * (P * bmdualm_gm n f h * Pinv) := by
        rw [show (P * bmdualm_gm n f g * Pinv) * (P * bmdualm_gm n f h * Pinv) =
            P * bmdualm_gm n f g * (Pinv * P) * bmdualm_gm n f h * Pinv from by noncomm_ring,
          hPinvP, Matrix.mul_one]
        noncomm_ring

private theorem bmdualm_matOf_one (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) :
    bmdualm_matOf n f R r' eidx P Pinv (1 : ↥(spinGroup (bmdualmQ n f))) = 1 := by
  unfold bmdualm_matOf
  rw [show bmdualm_gm n f (1 : ↥(spinGroup (bmdualmQ n f))) = 1 from by
    unfold bmdualm_gm
    rw [map_one (bmdualmJ n f), Units.val_one]]
  rw [Matrix.mul_one, hPP, bmdualm_reindex_one]

private theorem bmdualm_matOf_inv (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (g : ↥(spinGroup (bmdualmQ n f))) :
    bmdualm_matOf n f R r' eidx P Pinv g⁻¹ =
      (bmdualm_matOf n f R r' eidx P Pinv g)⁻¹ := by
  have h : bmdualm_matOf n f R r' eidx P Pinv g *
      bmdualm_matOf n f R r' eidx P Pinv g⁻¹ = 1 := by
    rw [← bmdualm_matOf_mul n f R r' eidx P Pinv hPinvP, mul_inv_cancel,
      bmdualm_matOf_one n f R r' eidx P Pinv hPP]
  exact (Matrix.inv_eq_right_inv h).symm

private noncomputable abbrev bmdualm_D0s (r r' : ℕ) (F : Type) [Zero F] [One F] :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F :=
  Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
    (0 : Matrix (Fin r) (Fin r ⊕ Fin r') F)
    (0 : Matrix (Fin r ⊕ Fin r') (Fin r) F)
    (Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) F)
      (0 : Matrix (Fin r) (Fin r') F) (0 : Matrix (Fin r') (Fin r) F)
      (0 : Matrix (Fin r') (Fin r') F))

private noncomputable abbrev bmdualm_D1 (r r' : ℕ) (F : Type) [Zero F] [One F] :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F :=
  Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
    (0 : Matrix (Fin r) (Fin r ⊕ Fin r') F)
    (0 : Matrix (Fin r ⊕ Fin r') (Fin r) F)
    (Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
      (0 : Matrix (Fin r) (Fin r') F) (0 : Matrix (Fin r') (Fin r) F)
      (1 : Matrix (Fin r') (Fin r') F))

private theorem bmdualm_eq_scalar_of_commute_sl (r f : ℕ)
    {M : Matrix (Fin r) (Fin r) (GaloisField 2 f)}
    (h : ∀ g : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f),
      (g : Matrix (Fin r) (Fin r) (GaloisField 2 f)) * M =
        M * (g : Matrix (Fin r) (Fin r) (GaloisField 2 f))) :
    ∃ l : GaloisField 2 f, M = l • (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) := by
  have hs : M ∈ Set.range (Matrix.scalar (Fin r) :
      GaloisField 2 f → Matrix (Fin r) (Fin r) (GaloisField 2 f)) := by
    refine Matrix.mem_range_scalar_of_commute_single (fun i j hij => ?_)
    have h1 := h (Matrix.SpecialLinearGroup.transvection hij 1)
    rw [CFSG.LinearGroups.coe_transvection hij 1, add_mul, mul_add, one_mul, mul_one] at h1
    exact (add_right_injective _ h1 : _)
  obtain ⟨l, hl⟩ := hs
  refine ⟨l, ?_⟩
  rw [← hl]
  ext i j
  by_cases hij : i = j <;> simp [Matrix.scalar_apply, Matrix.diagonal_apply, hij]

private theorem bmdualm_transpose_fromBlocks' {m n m' n' : Type*} {F : Type}
    (A : Matrix m m' F) (B : Matrix m n' F) (C : Matrix n m' F) (D : Matrix n n' F) :
    Matrix.transpose (Matrix.fromBlocks A B C D) =
      Matrix.fromBlocks (Matrix.transpose A) (Matrix.transpose C)
        (Matrix.transpose B) (Matrix.transpose D) := by
  ext i j
  rcases i with i | i <;> rcases j with j | j <;>
    simp [Matrix.fromBlocks, Matrix.transpose_apply]

private theorem bmdualm_reindex_transpose' (f : ℕ) {ι κ : Type*} (e : ι ≃ κ)
    (A : Matrix ι ι (GaloisField 2 f)) :
    Matrix.transpose (Matrix.reindex e e A) = Matrix.reindex e e (Matrix.transpose A) := by
  ext i j
  simp [Matrix.reindex_apply, Matrix.transpose_apply]

private theorem bmdualm_eq_zero_of_transpose_mul_eq_rect
    {r r' : ℕ} (f : ℕ) (hr : 2 ≤ r)
    {B : Matrix (Fin r) (Fin r') (GaloisField 2 f)}
    (h : ∀ g : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f),
      Matrix.transpose (g : Matrix (Fin r) (Fin r) (GaloisField 2 f)) * B = B) :
    B = 0 := by
  ext i l
  haveI : 1 < Fintype.card (Fin r) := by rw [Fintype.card_fin]; omega
  obtain ⟨j, hji⟩ : ∃ j : Fin r, j ≠ i := Fintype.exists_ne_of_one_lt_card this i
  have hij : i ≠ j := hji.symm
  let E : Matrix (Fin r) (Fin r) (GaloisField 2 f) := Matrix.single j i 1
  have h1 := congrFun (congrFun (h (Matrix.SpecialLinearGroup.transvection hij 1)) j) l
  rw [CFSG.LinearGroups.coe_transvection hij 1, Matrix.transpose_add, Matrix.transpose_one,
    Matrix.transpose_single] at h1
  have h1' : B j l + (E * B) j l = B j l := by
    rw [Matrix.add_mul, Matrix.one_mul, Matrix.add_apply] at h1
    simpa only [E] using h1
  have hsingle : (E * B) j l = B i l := by
    simp [E, Matrix.mul_apply, Matrix.single_apply]
  rw [hsingle] at h1'
  exact add_left_cancel (show B j l + B i l = B j l + 0 by simpa using h1')

private theorem bmdualm_blockMat_gram_conj
    (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    Matrix.transpose (bmdualm_blockMat n f (R + 1) r' x) *
      Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) *
      bmdualm_blockMat n f (R + 1) r' x =
      Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) := by
  have hM := bmdualm_isometry_of_quad (bmdualmQ n f)
    (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) (hblock x)
  have hM1 : Matrix.reindex eidx eidx (Matrix.transpose (bmdualm_blockMat n f (R + 1) r' x)) *
      bmdualmG n f *
      Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) =
      bmdualmG n f := by
    simpa only [bmdualm_reindex_transpose'] using hM
  have hM2 := congrArg (Matrix.reindex eidx.symm eidx.symm) hM1
  simp only [bmdualm_reindex_mul, bmdualm_reindex_comp_symm] at hM2
  exact hM2

private theorem bmdualm_block12_mul_eq
    (f R r' : ℕ) (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (B : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
    (h : Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) * B *
      Matrix.fromBlocks
        (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) = B) :
    Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
        Matrix.of (fun a b => B a (Sum.inl b)) *
        Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) =
      Matrix.of (fun a b => B a (Sum.inl b)) ∧
    Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
        Matrix.of (fun a c => B a (Sum.inr c)) =
      Matrix.of (fun a c => B a (Sum.inr c)) := by
  constructor
  · ext a b
    have hh := congrFun (congrFun h a) (Sum.inl b)
    have hkey : (Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
        B * Matrix.fromBlocks
          (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
            (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) a (Sum.inl b) =
        (Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
          Matrix.of (fun a b => B a (Sum.inl b)) *
          Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
            (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) a b := by
      simp only [Matrix.mul_apply, Fintype.sum_sum_type, Matrix.fromBlocks_apply₁₁,
        Matrix.fromBlocks_apply₂₁, Matrix.of_apply, Matrix.zero_apply, mul_zero,
        Finset.sum_const_zero, zero_add, add_zero]
    rw [← hkey]
    simpa only [Matrix.of_apply] using hh
  · ext a c
    have hh := congrFun (congrFun h a) (Sum.inr c)
    have hkey : (Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
        B * Matrix.fromBlocks
          (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
            (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) a (Sum.inr c) =
        (Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
          Matrix.of (fun a c => B a (Sum.inr c))) a c := by
      rw [Matrix.mul_apply]
      rw [Fintype.sum_eq_single (Sum.inr c) (fun k hk => by
        rcases k with i | c'
        · simp only [Matrix.fromBlocks_apply₁₂, Matrix.of_apply, Matrix.zero_apply, mul_zero]
        · have hne : c' ≠ c := fun hh' => hk (by rw [hh'])
          simp only [Matrix.fromBlocks_apply₂₂, Matrix.one_apply, hne, if_false, mul_zero])]
      simp only [Matrix.fromBlocks_apply₂₂, Matrix.one_apply, if_true, mul_one,
        Matrix.of_apply, Matrix.mul_apply]
    rw [← hkey]
    simpa only [Matrix.of_apply] using hh

private theorem bmdualm_formStandard_pair
    (n f : ℕ) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0) (hR : 1 ≤ R) :
    ∃ lam : GaloisField 2 f, lam ≠ 0 ∧
      Matrix.toBlocks₁₂ (Matrix.reindex eidx.symm eidx.symm (bmdualmG n f)) =
        bmdualm_J12 f R r' lam := by
  have hR2 : 2 ≤ R + 1 := by omega
  let G' : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
    Matrix.reindex eidx.symm eidx.symm (bmdualmG n f)
  have hconj : ∀ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      Matrix.transpose (bmdualm_blockMat n f (R + 1) r' x) * G' *
          bmdualm_blockMat n f (R + 1) r' x = G' := by
    intro x
    simpa only [G'] using bmdualm_blockMat_gram_conj n f R r' eidx hblock x
  have h12 : ∀ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
          Matrix.toBlocks₁₂ G' *
          Matrix.fromBlocks
            (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
              (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) =
        Matrix.toBlocks₁₂ G' := by
    intro x
    have h := hconj x
    rw [← Matrix.fromBlocks_toBlocks G'] at h
    unfold bmdualm_blockMat at h
    rw [bmdualm_transpose_fromBlocks'] at h
    rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at h
    simp only [Matrix.transpose_zero, Matrix.mul_zero, Matrix.zero_mul, add_zero,
      zero_add] at h
    rw [Matrix.fromBlocks_inj] at h
    exact h.2.1
  have hentries := fun x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) =>
    bmdualm_block12_mul_eq f R r' x (Matrix.toBlocks₁₂ G') (h12 x)
  have hcomm1 : ∀ g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      Matrix.transpose (g : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
          Matrix.of (fun a b => Matrix.toBlocks₁₂ G' a (Sum.inl b)) =
        Matrix.of (fun a b => Matrix.toBlocks₁₂ G' a (Sum.inl b)) *
          Matrix.transpose (g : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) := by
    intro g
    have hx := (hentries g).1
    have hxinv : Matrix.transpose (((g⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
          (GaloisField 2 f))) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
        Matrix.transpose ((g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 := by
      rw [← Matrix.transpose_mul]
      have h1 : ((g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
          (((g⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 := by
        rw [Matrix.SpecialLinearGroup.coe_inv, Matrix.mul_adjugate, g.2]
        simp
      rw [h1, Matrix.transpose_one]
    have h := congrArg (fun N : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f) =>
      N * Matrix.transpose ((g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
        Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) hx
    rw [Matrix.mul_assoc, hxinv, Matrix.mul_one] at h
    exact h
  obtain ⟨lam, hB1eq⟩ := bmdualm_eq_scalar_of_commute_sl (R + 1) f (M :=
    Matrix.of (fun a b => Matrix.toBlocks₁₂ G' a (Sum.inl b))) (fun g => by
      have hx := hcomm1 ⟨Matrix.transpose ((g : Matrix.SpecialLinearGroup (Fin (R + 1))
        (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)),
        by rw [Matrix.det_transpose]; exact g.2⟩
      simpa only [Matrix.transpose_transpose] using hx)
  have hB2eq : Matrix.of (fun a c => Matrix.toBlocks₁₂ G' a (Sum.inr c)) = 0 :=
    bmdualm_eq_zero_of_transpose_mul_eq_rect f hR2
      (B := Matrix.of (fun a (c : Fin r') => Matrix.toBlocks₁₂ G' a (Sum.inr c)))
      (fun g => (hentries g).2)
  have hshape : Matrix.toBlocks₁₂ G' = bmdualm_J12 f R r' lam := by
    ext a j
    rcases j with b | c
    · have hh := congrFun (congrFun hB1eq a) b
      simp only [Matrix.of_apply, Matrix.smul_apply, Matrix.one_apply] at hh
      rw [hh]
      simp only [bmdualm_J12, Matrix.of_apply]
      by_cases hab : a = b <;> simp [hab]
    · have hh := congrFun (congrFun hB2eq a) c
      simp only [Matrix.of_apply] at hh
      rw [hh]
      simp [bmdualm_J12]
  refine ⟨lam, ?_, hshape⟩
  intro hlam0
  have hGsymm : Matrix.transpose G' = G' := by
    simp only [G']
    rw [bmdualm_reindex_transpose', bmdualm_G_symmetric n f]
  have hGinv : IsUnit G'.det := by
    simp only [G']
    rw [Matrix.det_reindex_self]
    exact bmdualm_G_isUnit_det n f
  have hsymm : ∀ i j, G' i j = G' j i := by
    intro i j
    have h := congrFun (congrFun hGsymm i) j
    rw [Matrix.transpose_apply] at h
    exact h.symm
  have hePinv : e * Pinv =
      Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) := by
    rw [← hconv, Matrix.mul_assoc, hPP, Matrix.mul_one]
  have hR0 : ∀ a : Fin (R + 1),
      Matrix.mulVec (Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)))
        (Pi.single (eidx (Sum.inl a)) (1 : GaloisField 2 f)) =
      Pi.single (eidx (Sum.inl a)) 1 := by
    intro a
    ext i
    simp only [Matrix.mulVec, dotProduct]
    rw [Fintype.sum_eq_single (eidx (Sum.inl a))]
    · rw [Pi.single_eq_same, mul_one, Pi.single_apply, Matrix.reindex_apply]
      rcases h : eidx.symm i with a' | (b' | c')
      · have hi : i = eidx (Sum.inl a') := by rw [← h, Equiv.apply_symm_apply]
        subst i
        simp only [Matrix.submatrix_apply, bmdualm_D0, Matrix.fromBlocks_apply₁₁,
          Matrix.one_apply, Equiv.apply_symm_apply, Equiv.symm_apply_apply]
        by_cases ha : a' = a <;> simp [ha]
      · have hi : i = eidx (Sum.inr (Sum.inl b')) := by rw [← h, Equiv.apply_symm_apply]
        subst i
        have hne : eidx (Sum.inr (Sum.inl b')) ≠ eidx (Sum.inl a) := by
          intro he
          exact absurd (eidx.injective he) (by simp)
        simp [Matrix.submatrix_apply, bmdualm_D0, Matrix.fromBlocks_apply₂₁, Matrix.zero_apply,
          Pi.single_eq_of_ne hne]
      · have hi : i = eidx (Sum.inr (Sum.inr c')) := by rw [← h, Equiv.apply_symm_apply]
        subst i
        have hne : eidx (Sum.inr (Sum.inr c')) ≠ eidx (Sum.inl a) := by
          intro he
          exact absurd (eidx.injective he) (by simp)
        simp [Matrix.submatrix_apply, bmdualm_D0, Matrix.fromBlocks_apply₂₁, Matrix.zero_apply,
          Pi.single_eq_of_ne hne]
    · intro j hj
      rw [Pi.single_eq_of_ne hj, mul_zero]
  have hQofR0 : ∀ w : bmdualmι n → GaloisField 2 f,
      Matrix.mulVec (Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f))) w = w →
      bmdualmQ n f w = 0 := by
    intro w hw
    have hev : Matrix.mulVec e (Matrix.mulVec Pinv w) = Matrix.mulVec Pinv w := by
      rw [Matrix.mulVec_mulVec, hePinv, ← Matrix.mulVec_mulVec, hw]
    have h0 := hquad (Matrix.mulVec Pinv w)
    rw [hev] at h0
    have hPv := hP (Matrix.mulVec Pinv w)
    rw [Matrix.mulVec_mulVec, hPP, Matrix.one_mulVec] at hPv
    rw [hPv, h0]
  have hA : ∀ a b : Fin (R + 1), G' (Sum.inl a) (Sum.inl b) = 0 := by
    intro a b
    have hva : G' (Sum.inl a) (Sum.inl b) =
        bmdualmG n f (eidx (Sum.inl a)) (eidx (Sum.inl b)) := by
      simp only [G', Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm]
    rw [hva]
    rw [show bmdualmG n f (eidx (Sum.inl a)) (eidx (Sum.inl b)) =
        QuadraticMap.polar (bmdualmQ n f)
          (Pi.single (eidx (Sum.inl a)) 1) (Pi.single (eidx (Sum.inl b)) 1) from by
      rw [show bmdualmG n f =
          LinearMap.toMatrix₂' (GaloisField 2 f)
            (QuadraticMap.polarBilin (bmdualmQ n f)) from rfl,
        LinearMap.toMatrix₂'_apply, QuadraticMap.polarBilin_apply_apply]]
    have hQa := hQofR0 (Pi.single (eidx (Sum.inl a)) 1) (hR0 a)
    have hQb := hQofR0 (Pi.single (eidx (Sum.inl b)) 1) (hR0 b)
    have hQab := hQofR0 (Pi.single (eidx (Sum.inl a)) 1 + Pi.single (eidx (Sum.inl b)) 1)
      (by rw [Matrix.mulVec_add, hR0 a, hR0 b])
    have hpad := QuadraticMap.map_add (bmdualmQ n f)
      (Pi.single (eidx (Sum.inl a)) 1) (Pi.single (eidx (Sum.inl b)) 1)
    rw [hQab, hQa, hQb, zero_add, zero_add] at hpad
    exact hpad.symm
  have hv0 : (Pi.single (Sum.inl (0 : Fin (R + 1))) (1 : GaloisField 2 f) :
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) → GaloisField 2 f) ≠ 0 := by
    intro h
    have := congrFun h (Sum.inl (0 : Fin (R + 1)))
    simp at this
  have hcol : Matrix.mulVec G'
      (Pi.single (Sum.inl (0 : Fin (R + 1))) (1 : GaloisField 2 f) :
        (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) → GaloisField 2 f) = 0 := by
    funext i
    simp only [Matrix.mulVec, dotProduct]
    rw [Fintype.sum_eq_single (Sum.inl (0 : Fin (R + 1)))]
    · rw [Pi.single_eq_same, mul_one]
      rcases i with a | (b | c)
      · exact hA a 0
      · rw [hsymm]
        rw [show G' (Sum.inl (0 : Fin (R + 1))) (Sum.inr (Sum.inl b)) =
            Matrix.toBlocks₁₂ G' 0 (Sum.inl b) from rfl, hshape]
        simp [bmdualm_J12, hlam0]
      · rw [hsymm]
        rw [show G' (Sum.inl (0 : Fin (R + 1))) (Sum.inr (Sum.inr c)) =
            Matrix.toBlocks₁₂ G' 0 (Sum.inr c) from rfl, hshape]
        simp [bmdualm_J12]
    · intro j hj
      rw [Pi.single_eq_of_ne hj, mul_zero]
  exact hv0 (Matrix.eq_zero_of_mulVec_eq_zero hGinv.ne_zero hcol)

private theorem bmdualm_block11_eq_zero
    (n f : ℕ) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0) :
    Matrix.toBlocks₁₁ (Matrix.reindex eidx.symm eidx.symm (bmdualmG n f)) = 0 := by
  have hePinv : e * Pinv =
      Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) := by
    rw [← hconv, Matrix.mul_assoc, hPP, Matrix.mul_one]
  have hR0 : ∀ a : Fin (R + 1),
      Matrix.mulVec (Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)))
        (Pi.single (eidx (Sum.inl a)) (1 : GaloisField 2 f)) =
      Pi.single (eidx (Sum.inl a)) 1 := by
    intro a
    ext i
    simp only [Matrix.mulVec, dotProduct]
    rw [Fintype.sum_eq_single (eidx (Sum.inl a))]
    · rw [Pi.single_eq_same, mul_one, Pi.single_apply, Matrix.reindex_apply]
      rcases h : eidx.symm i with a' | (b' | c')
      · have hi : i = eidx (Sum.inl a') := by rw [← h, Equiv.apply_symm_apply]
        subst i
        simp only [Matrix.submatrix_apply, bmdualm_D0, Matrix.fromBlocks_apply₁₁,
          Matrix.one_apply, Equiv.apply_symm_apply, Equiv.symm_apply_apply]
        by_cases ha : a' = a <;> simp [ha]
      · have hi : i = eidx (Sum.inr (Sum.inl b')) := by rw [← h, Equiv.apply_symm_apply]
        subst i
        have hne : eidx (Sum.inr (Sum.inl b')) ≠ eidx (Sum.inl a) := by
          intro he
          exact absurd (eidx.injective he) (by simp)
        simp [Matrix.submatrix_apply, bmdualm_D0, Matrix.fromBlocks_apply₂₁, Matrix.zero_apply,
          Pi.single_eq_of_ne hne]
      · have hi : i = eidx (Sum.inr (Sum.inr c')) := by rw [← h, Equiv.apply_symm_apply]
        subst i
        have hne : eidx (Sum.inr (Sum.inr c')) ≠ eidx (Sum.inl a) := by
          intro he
          exact absurd (eidx.injective he) (by simp)
        simp [Matrix.submatrix_apply, bmdualm_D0, Matrix.fromBlocks_apply₂₁, Matrix.zero_apply,
          Pi.single_eq_of_ne hne]
    · intro j hj
      rw [Pi.single_eq_of_ne hj, mul_zero]
  have hQofR0 : ∀ w : bmdualmι n → GaloisField 2 f,
      Matrix.mulVec (Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f))) w = w →
      bmdualmQ n f w = 0 := by
    intro w hw
    have hev : Matrix.mulVec e (Matrix.mulVec Pinv w) = Matrix.mulVec Pinv w := by
      rw [Matrix.mulVec_mulVec, hePinv, ← Matrix.mulVec_mulVec, hw]
    have h0 := hquad (Matrix.mulVec Pinv w)
    rw [hev] at h0
    have hPv := hP (Matrix.mulVec Pinv w)
    rw [Matrix.mulVec_mulVec, hPP, Matrix.one_mulVec] at hPv
    rw [hPv, h0]
  ext a b
  change Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) (Sum.inl a)
      (Sum.inl b) = 0
  have hva : Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) (Sum.inl a)
      (Sum.inl b) = bmdualmG n f (eidx (Sum.inl a)) (eidx (Sum.inl b)) := by
    simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm]
  rw [hva]
  rw [show bmdualmG n f (eidx (Sum.inl a)) (eidx (Sum.inl b)) =
      QuadraticMap.polar (bmdualmQ n f)
        (Pi.single (eidx (Sum.inl a)) 1) (Pi.single (eidx (Sum.inl b)) 1) from by
    rw [show bmdualmG n f =
        LinearMap.toMatrix₂' (GaloisField 2 f)
          (QuadraticMap.polarBilin (bmdualmQ n f)) from rfl,
      LinearMap.toMatrix₂'_apply, QuadraticMap.polarBilin_apply_apply]]
  have hQa := hQofR0 (Pi.single (eidx (Sum.inl a)) 1) (hR0 a)
  have hQb := hQofR0 (Pi.single (eidx (Sum.inl b)) 1) (hR0 b)
  have hQab := hQofR0 (Pi.single (eidx (Sum.inl a)) 1 + Pi.single (eidx (Sum.inl b)) 1)
    (by rw [Matrix.mulVec_add, hR0 a, hR0 b])
  have hpad := QuadraticMap.map_add (bmdualmQ n f)
    (Pi.single (eidx (Sum.inl a)) 1) (Pi.single (eidx (Sum.inl b)) 1)
  rw [hQab, hQa, hQb, zero_add, zero_add] at hpad
  exact hpad.symm

private theorem bmdualm_D0_inv_D0_eq_zero
    (n f : ℕ) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (horth : e * bmdualmestar n f e = 0) :
    bmdualm_D0 (R + 1) r' (GaloisField 2 f) *
      (Matrix.reindex eidx.symm eidx.symm (bmdualmG n f))⁻¹ *
      bmdualm_D0 (R + 1) r' (GaloisField 2 f) = 0 := by
  let G := bmdualmG n f
  let R0 := Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f))
  have hG : IsUnit G.det := bmdualm_G_isUnit_det n f
  have hD0symm : Matrix.transpose (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) =
      bmdualm_D0 (R + 1) r' (GaloisField 2 f) := by
    ext i j
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
      simp [bmdualm_D0, Matrix.fromBlocks, Matrix.transpose_apply, Matrix.one_apply, eq_comm]
  have hR0symm : Matrix.transpose R0 = R0 := by
    simp only [R0]
    rw [bmdualm_reindex_transpose', hD0symm]
  have hiso : Matrix.transpose P * G * P = G :=
    bmdualm_isometry_of_quad (bmdualmQ n f) P hP
  have hPtG : Matrix.transpose P * G = G * Pinv := by
    calc Matrix.transpose P * G
        = Matrix.transpose P * G * 1 := (Matrix.mul_one _).symm
      _ = Matrix.transpose P * G * (P * Pinv) := by rw [hPP]
      _ = (Matrix.transpose P * G * P) * Pinv := by noncomm_ring
      _ = G * Pinv := by rw [hiso]
  have hPGinvPt : P * G⁻¹ * Matrix.transpose P = G⁻¹ := by
    have h : (P * G⁻¹ * Matrix.transpose P) * G = 1 := by
      calc (P * G⁻¹ * Matrix.transpose P) * G
          = P * G⁻¹ * (Matrix.transpose P * G) := by rw [Matrix.mul_assoc]
        _ = P * G⁻¹ * (G * Pinv) := by rw [hPtG]
        _ = P * (G⁻¹ * G) * Pinv := by noncomm_ring
        _ = P * 1 * Pinv := by rw [Matrix.nonsing_inv_mul G hG]
        _ = 1 := by rw [Matrix.mul_one, hPP]
    exact (Matrix.inv_eq_left_inv h).symm
  have hPinvConj : Matrix.transpose Pinv * G * Pinv = G := by
    have h := congrArg (fun M => Matrix.transpose Pinv * M * Pinv) hiso
    have h1 : Matrix.transpose Pinv * (Matrix.transpose P * G * P) * Pinv = G := by
      rw [show Matrix.transpose Pinv * (Matrix.transpose P * G * P) * Pinv =
          (Matrix.transpose Pinv * Matrix.transpose P) * G * (P * Pinv) from by noncomm_ring]
      rw [show Matrix.transpose Pinv * Matrix.transpose P = 1 from by
        rw [← Matrix.transpose_mul, hPP, Matrix.transpose_one], hPP]
      rw [Matrix.one_mul, Matrix.mul_one]
    rw [h1] at h
    exact h.symm
  have hPinvTG : Matrix.transpose Pinv * G = G * P := by
    conv_rhs => rw [← hPinvConj]
    rw [Matrix.mul_assoc, hPinvP, Matrix.mul_one]
  have hestar : bmdualmestar n f e = G⁻¹ * Matrix.transpose e * G := by
    simp only [bmdualmestar, formAdj]
    rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
      congrArg Matrix.transpose (Matrix.map_id e)]
  have hGeG : e * G⁻¹ * Matrix.transpose e = 0 := by
    have h := congrArg (fun M => M * G⁻¹) horth
    rw [Matrix.zero_mul] at h
    rw [hestar] at h
    simpa [Matrix.mul_assoc, Matrix.mul_nonsing_inv G hG, Matrix.mul_one] using h
  have hR0 : R0 * G⁻¹ * R0 = 0 := by
    have h := congrArg (fun M => P * M * Matrix.transpose P) hGeG
    simp only [Matrix.mul_zero, Matrix.zero_mul] at h
    rw [← hconv] at h
    have hkey : P * ((Pinv * R0 * P) * G⁻¹ * Matrix.transpose (Pinv * R0 * P)) *
        Matrix.transpose P = R0 * G⁻¹ * R0 := by
      have hPt : Matrix.transpose (Pinv * R0 * P) =
          Matrix.transpose P * R0 * Matrix.transpose Pinv := by
        rw [Matrix.transpose_mul, Matrix.transpose_mul, hR0symm, Matrix.mul_assoc]
      have hPPt : Matrix.transpose Pinv * Matrix.transpose P = 1 := by
        rw [← Matrix.transpose_mul, hPP, Matrix.transpose_one]
      rw [hPt]
      calc P * (Pinv * R0 * P * G⁻¹ * (Matrix.transpose P * R0 * Matrix.transpose Pinv)) *
            Matrix.transpose P
          = P * Pinv * R0 * (P * G⁻¹ * Matrix.transpose P) * R0 *
              (Matrix.transpose Pinv * Matrix.transpose P) := by noncomm_ring
        _ = 1 * R0 * (P * G⁻¹ * Matrix.transpose P) * R0 * 1 := by rw [hPP, hPPt]
        _ = R0 * G⁻¹ * R0 := by rw [one_mul, mul_one, hPGinvPt]
    rwa [hkey] at h
  have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hR0
  simp only [R0, bmdualm_reindex_mul, bmdualm_reindex_comp_symm, ← Matrix.inv_reindex] at h
  simpa using h

private theorem bmdualm_formStandard_diag
    (n f : ℕ) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (lam : GaloisField 2 f)
    (hpair : Matrix.toBlocks₁₂ (Matrix.reindex eidx.symm eidx.symm (bmdualmG n f)) =
      bmdualm_J12 f R r' lam)
    (hR : 1 ≤ R) (hlam : lam ≠ 0) :
    Matrix.toBlocks₁₁ (Matrix.reindex eidx.symm eidx.symm (bmdualmG n f)) = 0 ∧
    Matrix.toBlocks₂₁ (Matrix.reindex eidx.symm eidx.symm (bmdualmG n f)) =
      bmdualm_J21 f R r' lam ∧
    Matrix.toBlocks₂₂ (Matrix.reindex eidx.symm eidx.symm (bmdualmG n f)) =
      Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (bmdualm_formBlock n f R r' eidx) := by
  have hR2 : 2 ≤ R + 1 := by omega
  let G' : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
    Matrix.reindex eidx.symm eidx.symm (bmdualmG n f)
  have h11 : Matrix.toBlocks₁₁ G' = 0 := by
    simpa only [G'] using bmdualm_block11_eq_zero n f (e := e) eidx hPP hPinvP hP hconv hquad
  have h11e : ∀ a b : Fin (R + 1), G' (Sum.inl a) (Sum.inl b) = 0 := by
    intro a b
    rw [show G' (Sum.inl a) (Sum.inl b) = Matrix.toBlocks₁₁ G' a b from rfl, h11]
    simp
  have hGsymm : Matrix.transpose G' = G' := by
    simp only [G']
    rw [bmdualm_reindex_transpose', bmdualm_G_symmetric n f]
  have hsymm : ∀ i j, G' i j = G' j i := by
    intro i j
    have h := congrFun (congrFun hGsymm i) j
    rw [Matrix.transpose_apply] at h
    exact h.symm
  have h21 : Matrix.toBlocks₂₁ G' = bmdualm_J21 f R r' lam := by
    ext j a
    change G' (Sum.inr j) (Sum.inl a) = bmdualm_J21 f R r' lam j a
    rw [hsymm]
    change G' (Sum.inl a) (Sum.inr j) = bmdualm_J21 f R r' lam j a
    rw [show G' (Sum.inl a) (Sum.inr j) = Matrix.toBlocks₁₂ G' a j from rfl, hpair]
    rcases j with b | c <;> simp [bmdualm_J12, bmdualm_J21, eq_comm]
  have hconj : ∀ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      Matrix.transpose (bmdualm_blockMat n f (R + 1) r' x) * G' *
          bmdualm_blockMat n f (R + 1) r' x = G' := fun x =>
    bmdualm_blockMat_gram_conj n f R r' eidx hblock x
  have h22eq : ∀ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      Matrix.transpose (Matrix.fromBlocks
        (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
          (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) *
      Matrix.toBlocks₂₂ G' *
      Matrix.fromBlocks
        (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
          (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) = Matrix.toBlocks₂₂ G' := by
    intro x
    have h := hconj x
    rw [← Matrix.fromBlocks_toBlocks G'] at h
    unfold bmdualm_blockMat at h
    rw [bmdualm_transpose_fromBlocks'] at h
    rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at h
    simp only [Matrix.transpose_zero, Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add] at h
    rw [Matrix.fromBlocks_inj] at h
    exact h.2.2.2
  have hD12eq : ∀ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
        Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
        Matrix.toBlocks₁₂ (Matrix.toBlocks₂₂ G') =
      Matrix.toBlocks₁₂ (Matrix.toBlocks₂₂ G') := by
    intro x
    have h := h22eq x
    rw [← Matrix.fromBlocks_toBlocks (Matrix.toBlocks₂₂ G')] at h
    rw [bmdualm_transpose_fromBlocks'] at h
    rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at h
    simp only [Matrix.transpose_zero, Matrix.transpose_transpose, Matrix.mul_zero,
      Matrix.mul_one, Matrix.zero_mul, add_zero, zero_add] at h
    rw [Matrix.fromBlocks_inj] at h
    exact h.2.1
  have hD12 : Matrix.toBlocks₁₂ (Matrix.toBlocks₂₂ G') = 0 := by
    apply bmdualm_eq_zero_of_transpose_mul_eq_rect f hR2
    intro g
    have hleft : ∀ y : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
        (y : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
          Matrix.toBlocks₁₂ (Matrix.toBlocks₂₂ G') =
        Matrix.toBlocks₁₂ (Matrix.toBlocks₂₂ G') :=
      fun y => by simpa using hD12eq (y⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
        (GaloisField 2 f))
    have := hleft ⟨Matrix.transpose (g : Matrix (Fin (R + 1)) (Fin (R + 1))
      (GaloisField 2 f)), by rw [Matrix.det_transpose]; exact g.2⟩
    simpa using this
  have hD12e : ∀ b : Fin (R + 1), ∀ c : Fin r',
      G' (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inr c)) = 0 := by
    intro b c
    have := congrFun (congrFun hD12 b) c
    simpa [Matrix.toBlocks₁₂, Matrix.toBlocks₂₂] using this
  have hGinv : IsUnit G'.det := by
    simp only [G']
    rw [Matrix.det_reindex_self]
    exact bmdualm_G_isUnit_det n f
  have hG'Z : G' * G'⁻¹ = 1 := Matrix.mul_nonsing_inv G' hGinv
  have hD0Z : bmdualm_D0 (R + 1) r' (GaloisField 2 f) * G'⁻¹ *
      bmdualm_D0 (R + 1) r' (GaloisField 2 f) = 0 := by
    simpa only [G'] using bmdualm_D0_inv_D0_eq_zero n f (e := e) eidx hPP hPinvP hP hconv horth
  have hD0eq : bmdualm_D0 (R + 1) r' (GaloisField 2 f) =
      Matrix.fromBlocks (1 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f)) := by
    ext i j
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
      simp [bmdualm_D0, Matrix.fromBlocks, Matrix.one_apply]
  have hZ11 : ∀ a a' : Fin (R + 1), G'⁻¹ (Sum.inl a) (Sum.inl a') = 0 := by
    intro a a'
    have h := hD0Z
    rw [hD0eq, ← Matrix.fromBlocks_toBlocks (G'⁻¹)] at h
    rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at h
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one,
      Matrix.one_mul] at h
    have h0 : (0 : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
        (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f)) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f)) := by
      ext i j
      rcases i with a'' | (b'' | c'') <;> rcases j with a3 | (b3 | c3) <;>
        simp [Matrix.fromBlocks]
    rw [h0, Matrix.fromBlocks_inj] at h
    have hh := congrFun (congrFun h.1 a) a'
    simpa only [Matrix.toBlocks₁₁, Matrix.of_apply, Matrix.zero_apply] using hh
  have hZ21 : ∀ b a' : Fin (R + 1),
      G'⁻¹ (Sum.inr (Sum.inl b)) (Sum.inl a') = if b = a' then lam⁻¹ else 0 := by
    intro b a'
    have h := congrFun (congrFun hG'Z (Sum.inl b)) (Sum.inl a')
    rw [Matrix.mul_apply, Fintype.sum_eq_single (Sum.inr (Sum.inl b))] at h
    · rw [show G' (Sum.inl b) (Sum.inr (Sum.inl b)) = lam from by
          rw [show G' (Sum.inl b) (Sum.inr (Sum.inl b)) =
            Matrix.toBlocks₁₂ G' b (Sum.inl b) from rfl, hpair]
          simp [bmdualm_J12]] at h
      rw [show (1 : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
          (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f))
          (Sum.inl b) (Sum.inl a') = if b = a' then 1 else 0 from by
        simp [Matrix.one_apply]] at h
      by_cases hba : b = a'
      · rw [if_pos hba] at h
        have hz : G'⁻¹ (Sum.inr (Sum.inl b)) (Sum.inl a') = lam⁻¹ := by
          have hh := congrArg (fun t => lam⁻¹ * t) h
          rwa [← mul_assoc, inv_mul_cancel₀ hlam, one_mul, mul_one] at hh
        simpa [hba] using hz
      · rw [if_neg hba] at h
        have hz : G'⁻¹ (Sum.inr (Sum.inl b)) (Sum.inl a') = 0 :=
          (mul_eq_zero.mp h).resolve_left hlam
        simpa [hba] using hz
    · intro k hk
      rcases k with a'' | (b'' | c)
      · rw [h11e b a'']
        simp
      · have hb'' : b'' ≠ b := fun hh => hk (by rw [hh])
        rw [show G' (Sum.inl b) (Sum.inr (Sum.inl b'')) =
            Matrix.toBlocks₁₂ G' b (Sum.inl b'') from rfl, hpair]
        simp only [bmdualm_J12, Matrix.of_apply]
        rw [if_neg (Ne.symm hb'')]
        simp
      · rw [show G' (Sum.inl b) (Sum.inr (Sum.inr c)) =
            Matrix.toBlocks₁₂ G' b (Sum.inr c) from rfl, hpair]
        simp [bmdualm_J12]
  have hD11 : ∀ b a' : Fin (R + 1),
      G' (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inl a')) = 0 := by
    intro b a'
    have h := congrFun (congrFun hG'Z (Sum.inr (Sum.inl b))) (Sum.inl a')
    rw [Matrix.mul_apply, Fintype.sum_eq_single (Sum.inr (Sum.inl a'))] at h
    · rw [hZ21 a' a', if_pos rfl,
        show (1 : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
          (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f))
          (Sum.inr (Sum.inl b)) (Sum.inl a') = 0 from by simp [Matrix.one_apply]] at h
      exact (mul_eq_zero.mp h).resolve_right (inv_ne_zero hlam)
    · intro k hk
      rcases k with a'' | (b'' | c)
      · rw [hZ11 a'' a']
        simp
      · have hba : b'' ≠ a' := fun hh => hk (by rw [hh])
        rw [hZ21 b'' a', if_neg hba]
        simp
      · rw [hD12e b c]
        simp
  have h22 : Matrix.toBlocks₂₂ G' = Matrix.fromBlocks
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (bmdualm_formBlock n f R r' eidx) := by
    ext i j
    rcases i with b | c <;> rcases j with b' | c'
    · change G' (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inl b')) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (bmdualm_formBlock n f R r' eidx) (Sum.inl b) (Sum.inl b')
      rw [Matrix.fromBlocks_apply₁₁, Matrix.zero_apply]
      exact hD11 b b'
    · change G' (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inr c')) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (bmdualm_formBlock n f R r' eidx) (Sum.inl b) (Sum.inr c')
      rw [Matrix.fromBlocks_apply₁₂, Matrix.zero_apply]
      exact hD12e b c'
    · change G' (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inl b')) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (bmdualm_formBlock n f R r' eidx) (Sum.inr c) (Sum.inl b')
      rw [Matrix.fromBlocks_apply₂₁, Matrix.zero_apply]
      rw [hsymm]
      exact hD12e b' c
    · change G' (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inr c')) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (bmdualm_formBlock n f R r' eidx) (Sum.inr c) (Sum.inr c')
      rw [Matrix.fromBlocks_apply₂₂]
      rfl
  exact ⟨h11, h21, h22⟩

private theorem bmdualm_formStandard_blocks
    (n f : ℕ) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0) (hR : 1 ≤ R) :
    ∃ lam : GaloisField 2 f, lam ≠ 0 ∧
      Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (bmdualm_J12 f R r' lam) (bmdualm_J21 f R r' lam)
          (Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (bmdualm_formBlock n f R r' eidx)) := by
  obtain ⟨lam, hlam, hpair⟩ := bmdualm_formStandard_pair n f (e := e) eidx hPP hPinvP hP hblock
    hconv hquad hquad' heps horth horth' hR
  obtain ⟨h11, h21, h22⟩ := bmdualm_formStandard_diag n f (e := e) eidx hPP hPinvP hP hblock
    hconv hquad hquad' heps horth horth' lam hpair hR hlam
  exact ⟨lam, hlam, by
    rw [← Matrix.fromBlocks_toBlocks
      (Matrix.reindex eidx.symm eidx.symm (bmdualmG n f)), h11, hpair, h21, h22]⟩

private theorem bmdualm_formBlock_invertible
    (n f : ℕ) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0) (hR : 1 ≤ R) :
    ∃ Qinv : Matrix (Fin r') (Fin r') (GaloisField 2 f),
      bmdualm_formBlock n f R r' eidx * Qinv = 1 := by
  obtain ⟨lam, hlam, hpair⟩ := bmdualm_formStandard_pair n f (e := e) eidx hPP hPinvP hP hblock
    hconv hquad hquad' heps horth horth' hR
  obtain ⟨_h11, _h21, h22⟩ := bmdualm_formStandard_diag n f (e := e) eidx hPP hPinvP hP hblock
    hconv hquad hquad' heps horth horth' lam hpair hR hlam
  let G' : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
    Matrix.reindex eidx.symm eidx.symm (bmdualmG n f)
  have hGinv : IsUnit G'.det := by
    simp only [G']
    rw [Matrix.det_reindex_self]
    exact bmdualm_G_isUnit_det n f
  have hD12' : Matrix.toBlocks₁₂ (Matrix.toBlocks₂₂ G') = 0 := by
    rw [show Matrix.toBlocks₂₂ G' = Matrix.fromBlocks
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (bmdualm_formBlock n f R r' eidx) from by simpa only [G'] using h22,
      Matrix.toBlocks_fromBlocks₁₂]
  have hD12e : ∀ b : Fin (R + 1), ∀ c : Fin r',
      G' (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inr c)) = 0 := by
    intro b c
    have := congrFun (congrFun hD12' b) c
    simpa only [Matrix.toBlocks₁₂, Matrix.toBlocks₂₂, Matrix.of_apply, Matrix.zero_apply] using this
  have hmapzero : ∀ v : Fin r' → GaloisField 2 f,
      Matrix.mulVec (bmdualm_formBlock n f R r' eidx) v = 0 → v = 0 := by
    intro v hv
    let x : (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) → GaloisField 2 f :=
      Sum.elim (fun _ => 0) (Sum.elim (fun _ => 0) v)
    have hx : Matrix.mulVec G' x = 0 := by
      funext i
      rcases i with a | (b | c)
      · simp only [Matrix.mulVec, dotProduct, Pi.zero_apply]
        rw [Fintype.sum_sum_type, Finset.sum_eq_zero (fun a' _ => by simp [x]), zero_add,
          Fintype.sum_sum_type, Finset.sum_eq_zero (fun b' _ => by simp [x]), zero_add]
        rw [Finset.sum_eq_zero (fun c' _ => by
          rw [show G' (Sum.inl a) (Sum.inr (Sum.inr c')) =
              Matrix.toBlocks₁₂ G' a (Sum.inr c') from rfl, hpair]
          simp [bmdualm_J12, x])]
      · simp only [Matrix.mulVec, dotProduct, Pi.zero_apply]
        rw [Fintype.sum_sum_type, Finset.sum_eq_zero (fun a' _ => by simp [x]), zero_add,
          Fintype.sum_sum_type, Finset.sum_eq_zero (fun b' _ => by simp [x]), zero_add]
        rw [Finset.sum_eq_zero (fun c' _ => by
          rw [hD12e b c']
          simp [x])]
      · simp only [Matrix.mulVec, dotProduct, Pi.zero_apply]
        rw [Fintype.sum_sum_type, Finset.sum_eq_zero (fun a' _ => by simp [x]), zero_add,
          Fintype.sum_sum_type, Finset.sum_eq_zero (fun b' _ => by simp [x]), zero_add]
        have hsum : (∑ c' : Fin r', G' (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inr c')) *
            x (Sum.inr (Sum.inr c'))) =
            Matrix.mulVec (bmdualm_formBlock n f R r' eidx) v c := by
          simp only [x, Sum.elim_inr, Matrix.mulVec, dotProduct, bmdualm_formBlock,
            Matrix.of_apply]
          rfl
        rw [hsum, show Matrix.mulVec (bmdualm_formBlock n f R r' eidx) v c = 0 from by
          rw [hv]; rfl]
    have hx0 := Matrix.eq_zero_of_mulVec_eq_zero hGinv.ne_zero hx
    funext c
    have := congrFun hx0 (Sum.inr (Sum.inr c))
    simpa [x] using this
  have hinj : Function.Injective (Matrix.mulVec (bmdualm_formBlock n f R r' eidx)) := by
    intro v w hvw
    have hzw : Matrix.mulVec (bmdualm_formBlock n f R r' eidx) (v - w) = 0 := by
      rw [Matrix.mulVec_sub, hvw, sub_self]
    exact sub_eq_zero.mp (hmapzero (v - w) hzw)
  exact (Matrix.mulVec_injective_iff_isUnit.mp hinj).exists_right_inv

private theorem bmdualm_formStandard
    (n f : ℕ) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0) (hR : 1 ≤ R) :
    bmdualm_IsFormStandard n f R r' eidx := by
  obtain ⟨lam, hlam, hblocks⟩ := bmdualm_formStandard_blocks n f (e := e) eidx hPP hPinvP hP hblock
    hconv hquad hquad' heps horth horth' hR
  exact ⟨lam, hlam, hblocks,
    bmdualm_formBlock_invertible n f (e := e) eidx hPP hPinvP hP hblock hconv hquad hquad'
      heps horth horth' hR⟩

private theorem bmdualm_formAdj_P
    (n f : ℕ)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v) :
    formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f) P = Pinv := by
  have hG : IsUnit (bmdualmG n f).det := bmdualm_G_isUnit_det n f
  have hiso : Matrix.transpose P * bmdualmG n f * P =
      bmdualmG n f :=
    bmdualm_isometry_of_quad (bmdualmQ n f) P hP
  have hPtG : Matrix.transpose P * bmdualmG n f =
      bmdualmG n f * Pinv := by
    calc Matrix.transpose P * bmdualmG n f
        = Matrix.transpose P * bmdualmG n f * 1 := (Matrix.mul_one _).symm
      _ = Matrix.transpose P * bmdualmG n f * (P * Pinv) := by rw [hPP]
      _ = (Matrix.transpose P * bmdualmG n f * P) * Pinv := by
          noncomm_ring
      _ = bmdualmG n f * Pinv := by rw [hiso]
  unfold formAdj
  rw [show (P.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose P from
    congrArg Matrix.transpose (Matrix.map_id P)]
  rw [Matrix.mul_assoc, hPtG, ← Matrix.mul_assoc, Matrix.nonsing_inv_mul _ hG, Matrix.one_mul]

private theorem bmdualm_formAdj_Pinv
    (n f : ℕ)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v) :
    formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f) Pinv = P := by
  have h := Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl)
    (bmdualm_G_isUnit_det n f) (bmdualm_G_symmetric_map n f) P
  rw [bmdualm_formAdj_P n f hPP hP] at h
  exact h

private theorem bmdualm_D0_eq (R r' : ℕ) (F : Type) [Zero F] [One F] :
    bmdualm_D0 (R + 1) r' F = Matrix.fromBlocks (1 : Matrix (Fin (R + 1)) (Fin (R + 1)) F)
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') F)
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) F)
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') F) := by
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
    simp [bmdualm_D0, Matrix.fromBlocks, Matrix.one_apply]

private theorem bmdualm_D1_eq (R r' : ℕ) (F : Type) [Zero F] [One F] :
    bmdualm_D1 (R + 1) r' F = Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) F)
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') F)
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) F)
      (Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) F)
        (0 : Matrix (Fin (R + 1)) (Fin r') F) (0 : Matrix (Fin r') (Fin (R + 1)) F)
        (1 : Matrix (Fin r') (Fin r') F)) := by
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
    simp [bmdualm_D1, Matrix.fromBlocks, Matrix.one_apply]

private theorem bmdualm_transpose_fromBlocks {m n m' n' : Type*} {F : Type}
    (A : Matrix m m' F) (B : Matrix m n' F) (C : Matrix n m' F) (D : Matrix n n' F) :
    Matrix.transpose (Matrix.fromBlocks A B C D) =
      Matrix.fromBlocks (Matrix.transpose A) (Matrix.transpose C)
        (Matrix.transpose B) (Matrix.transpose D) := by
  ext i j
  rcases i with i | i <;> rcases j with j | j <;>
    simp [Matrix.fromBlocks, Matrix.transpose_apply]

private theorem bmdualm_J12_mul (f R r' : ℕ) (lam : GaloisField 2 f)
    (E : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
    (G : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f)) :
    bmdualm_J12 f R r' lam *
      Matrix.fromBlocks E (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f)) G
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) =
      Matrix.of (fun a j => Sum.elim (fun b => lam * E a b) (fun _ : Fin r' => 0) j) := by
  ext a j
  rcases j with b | c
  · rw [Matrix.mul_apply, Finset.sum_eq_single (Sum.inl a)]
    · simp [bmdualm_J12, Matrix.fromBlocks]
    · intro k _ hk
      rcases k with a' | (b' | c')
      · have hne : a ≠ a' := fun h => hk (by rw [h])
        simp [bmdualm_J12, Matrix.fromBlocks, hne]
      · simp [bmdualm_J12, Matrix.fromBlocks]
      · simp [bmdualm_J12, Matrix.fromBlocks]
    · intro h; exact absurd (Finset.mem_univ _) h
  · simp only [Matrix.of_apply, Sum.elim]
    rw [Matrix.mul_apply]
    exact Finset.sum_eq_zero (fun k _ => by
      rcases k with a' | (b' | c') <;> simp [bmdualm_J12, Matrix.fromBlocks])

private theorem bmdualm_block_diag_outer (R r' : ℕ) {F : Type} [Field F]
    {A : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) F}
    (h : A * bmdualm_D0 (R + 1) r' F = bmdualm_D0 (R + 1) r' F * A) :
    ∃ x : Matrix (Fin (R + 1)) (Fin (R + 1)) F,
      ∃ y : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') F,
        A = Matrix.fromBlocks x 0 0 y := by
  let x : Matrix (Fin (R + 1)) (Fin (R + 1)) F := Matrix.toBlocks₁₁ A
  let y : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') F := Matrix.toBlocks₂₂ A
  refine ⟨x, y, ?_⟩
  have h' := h
  rw [bmdualm_D0_eq R r' F, ← Matrix.fromBlocks_toBlocks A] at h'
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at h'
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one,
    Matrix.one_mul] at h'
  rw [Matrix.fromBlocks_inj] at h'
  obtain ⟨-, h12, h21, -⟩ := h'
  have h12' : Matrix.toBlocks₁₂ A = 0 := h12.symm
  have h21' : Matrix.toBlocks₂₁ A = 0 := h21
  nth_rewrite 1 [← Matrix.fromBlocks_toBlocks A]
  rw [h12', h21']

private theorem bmdualm_block_diag_inner (R r' : ℕ) {F : Type} [Field F]
    {D : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') F}
    (h : D * Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) F)
          (0 : Matrix (Fin (R + 1)) (Fin r') F) (0 : Matrix (Fin r') (Fin (R + 1)) F)
          (1 : Matrix (Fin r') (Fin r') F) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) F)
          (0 : Matrix (Fin (R + 1)) (Fin r') F) (0 : Matrix (Fin r') (Fin (R + 1)) F)
          (1 : Matrix (Fin r') (Fin r') F)) :
    ∃ E : Matrix (Fin (R + 1)) (Fin (R + 1)) F, ∃ G : Matrix (Fin r') (Fin (R + 1)) F,
      D = Matrix.fromBlocks E 0 G 1 := by
  let E : Matrix (Fin (R + 1)) (Fin (R + 1)) F := Matrix.toBlocks₁₁ D
  let G : Matrix (Fin r') (Fin (R + 1)) F := Matrix.toBlocks₂₁ D
  refine ⟨E, G, ?_⟩
  have h' := h
  rw [← Matrix.fromBlocks_toBlocks D] at h'
  rw [Matrix.fromBlocks_multiply] at h'
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one,
    Matrix.one_mul] at h'
  rw [Matrix.fromBlocks_inj] at h'
  obtain ⟨-, h12, -, h22⟩ := h'
  have h12' : Matrix.toBlocks₁₂ D = 0 := h12
  have h22' : Matrix.toBlocks₂₂ D = 1 := h22
  nth_rewrite 1 [← Matrix.fromBlocks_toBlocks D]
  rw [h12', h22']

private theorem bmdualm_block_symplectic (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    (hform : bmdualm_IsFormStandard n f R r' eidx)
    {A E : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)}
    {G : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f)}
    (hs : Matrix.transpose (Matrix.fromBlocks A 0 0 (Matrix.fromBlocks E 0 G 1)) *
      Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) *
      Matrix.fromBlocks A 0 0 (Matrix.fromBlocks E 0 G 1) =
      Matrix.reindex eidx.symm eidx.symm (bmdualmG n f)) :
    Matrix.transpose A * E = 1 ∧ G = 0 := by
  obtain ⟨lam, hlam, hGblocks, hQunit⟩ := hform
  have hs1 := hs
  rw [hGblocks] at hs1
  simp only [bmdualm_transpose_fromBlocks, Matrix.transpose_zero, Matrix.fromBlocks_multiply,
    Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add] at hs1
  rw [Matrix.fromBlocks_inj] at hs1
  obtain ⟨-, hAE, -, hGG⟩ := hs1
  constructor
  · rw [Matrix.mul_assoc, bmdualm_J12_mul f R r' lam E G] at hAE
    ext a b
    have hh := congrFun (congrFun hAE a) (Sum.inl b)
    have hh' : lam * (Matrix.transpose A * E) a b = lam * (1 : Matrix (Fin (R + 1)) (Fin (R + 1))
        (GaloisField 2 f)) a b := by
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Sum.elim_inl] at hh
      have hfac : (∑ j, A j a * (lam * E j b)) = lam * ∑ j, A j a * E j b := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun j _ => by ring)
      rw [hfac, show (∑ j, A j a * E j b) = (Matrix.transpose A * E) a b from by
        rw [Matrix.mul_apply]; simp [Matrix.transpose_apply]] at hh
      rw [hh]
      simp only [bmdualm_J12, Matrix.of_apply, Matrix.one_apply]
      split <;> ring
    exact mul_left_cancel₀ hlam hh'
  · rw [Matrix.fromBlocks_inj] at hGG
    obtain ⟨-, hGQ, -, -⟩ := hGG
    have hGQ' : Matrix.transpose G * bmdualm_formBlock n f R r' eidx = 0 := by
      simpa only [Matrix.mul_one, bmdualm_formBlock] using hGQ
    obtain ⟨Qinv, hQinv⟩ := hQunit
    have hGt : Matrix.transpose G = 0 := by
      rw [← Matrix.mul_one (Matrix.transpose G), ← hQinv, ← Matrix.mul_assoc, hGQ',
        Matrix.zero_mul]
    rw [← Matrix.transpose_transpose G, hGt, Matrix.transpose_zero]

private theorem bmdualm_reindex_transpose (f : ℕ) {ι κ : Type*} (e : ι ≃ κ)
    (A : Matrix ι ι (GaloisField 2 f)) :
    Matrix.transpose (Matrix.reindex e e A) = Matrix.reindex e e (Matrix.transpose A) := by
  ext i j
  simp [Matrix.reindex_apply, Matrix.transpose_apply]

private theorem bmdualm_formStandard_noH
    (n f : ℕ) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0) (hR : 1 ≤ R) :
    bmdualm_IsFormStandard n f R r' eidx :=
  bmdualm_formStandard n f (e := e) eidx hPP hPinvP hP hblock hconv hquad hquad' heps horth
    horth' hR

private theorem bmdualm_estar_conj_noH
    (n f : ℕ) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hform : bmdualm_IsFormStandard n f R r' eidx) :
    Pinv * Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f)) * P =
      bmdualmestar n f e := by
  let G := bmdualmG n f
  let R0 := Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f))
  let R0s := Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f))
  let G' : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
    Matrix.reindex eidx.symm eidx.symm G
  obtain ⟨lam, _hlam, hGblocks, _hQunit⟩ := hform
  have hGblk : G' = Matrix.fromBlocks
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (bmdualm_J12 f R r' lam) (bmdualm_J21 f R r' lam)
      (Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (bmdualm_formBlock n f R r' eidx)) := hGblocks
  have hGinv : IsUnit G'.det := by
    simp only [G']
    rw [Matrix.det_reindex_self]
    exact bmdualm_G_isUnit_det n f
  have hA : Matrix.toBlocks₁₁ G' = 0 := by
    rw [hGblk, Matrix.toBlocks_fromBlocks₁₁]
  have hB : Matrix.toBlocks₁₂ G' = bmdualm_J12 f R r' lam := by
    rw [hGblk, Matrix.toBlocks_fromBlocks₁₂]
  have hD : Matrix.toBlocks₂₂ G' = Matrix.fromBlocks
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (bmdualm_formBlock n f R r' eidx) := by
    rw [hGblk, Matrix.toBlocks_fromBlocks₂₂]
  have hJ12W0 : Matrix.toBlocks₁₂ G' * Matrix.fromBlocks
      (1 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) = Matrix.toBlocks₁₂ G' := by
    rw [hB]
    ext a j
    rcases j with b | c
    · rw [Matrix.mul_apply, Fintype.sum_eq_single (Sum.inl b)]
      · simp [bmdualm_J12, Matrix.fromBlocks, Matrix.one_apply]
      · intro k hk
        rcases k with b' | c'
        · have hb' : b' ≠ b := fun h => hk (by rw [h])
          simp [bmdualm_J12, Matrix.fromBlocks, Matrix.one_apply, hb']
        · simp [bmdualm_J12, Matrix.fromBlocks]
    · rw [Matrix.mul_apply]
      apply Finset.sum_eq_zero
      intro k _
      rcases k with b' | c' <;> simp [bmdualm_J12, Matrix.fromBlocks]
  have hD22W0 : Matrix.toBlocks₂₂ G' * Matrix.fromBlocks
      (1 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) = 0 := by
    rw [hD, Matrix.fromBlocks_multiply]
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero]
    ext i j
    rcases i with b | c <;> rcases j with b' | c' <;> simp [Matrix.fromBlocks]
  have hD0eq : bmdualm_D0 (R + 1) r' (GaloisField 2 f) = Matrix.fromBlocks
      (1 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f)) := by
    ext i j
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
      simp [bmdualm_D0, Matrix.fromBlocks, Matrix.one_apply]
  have hD0seq : bmdualm_D0s (R + 1) r' (GaloisField 2 f) = Matrix.fromBlocks
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (Matrix.fromBlocks (1 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) := by
    ext i j
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
      simp [bmdualm_D0s, Matrix.fromBlocks, Matrix.one_apply]
  have hD0G : bmdualm_D0 (R + 1) r' (GaloisField 2 f) * G' =
      G' * bmdualm_D0s (R + 1) r' (GaloisField 2 f) := by
    rw [hD0eq, hD0seq,
      show G' = Matrix.fromBlocks (Matrix.toBlocks₁₁ G') (Matrix.toBlocks₁₂ G')
        (Matrix.toBlocks₂₁ G') (Matrix.toBlocks₂₂ G') from
        (Matrix.fromBlocks_toBlocks G').symm]
    rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.one_mul]
    rw [hA, hJ12W0, hD22W0]
  have hX : G'⁻¹ * bmdualm_D0 (R + 1) r' (GaloisField 2 f) * G' =
      bmdualm_D0s (R + 1) r' (GaloisField 2 f) := by
    calc G'⁻¹ * bmdualm_D0 (R + 1) r' (GaloisField 2 f) * G'
        = G'⁻¹ * (bmdualm_D0 (R + 1) r' (GaloisField 2 f) * G') := by
            rw [Matrix.mul_assoc]
      _ = G'⁻¹ * (G' * bmdualm_D0s (R + 1) r' (GaloisField 2 f)) := by rw [hD0G]
      _ = (G'⁻¹ * G') * bmdualm_D0s (R + 1) r' (GaloisField 2 f) := by
            rw [Matrix.mul_assoc]
      _ = bmdualm_D0s (R + 1) r' (GaloisField 2 f) := by
            rw [Matrix.nonsing_inv_mul G' hGinv, Matrix.one_mul]
  have hR0symm : Matrix.transpose R0 = R0 := by
    have hD0symm : Matrix.transpose (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) =
        bmdualm_D0 (R + 1) r' (GaloisField 2 f) := by
      ext i j
      rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
        simp [bmdualm_D0, Matrix.fromBlocks, Matrix.transpose_apply, Matrix.one_apply, eq_comm]
    simp only [R0]
    rw [bmdualm_reindex_transpose', hD0symm]
  have hformR0 : formAdj (RingHom.id (GaloisField 2 f)) G R0 = R0s := by
    unfold formAdj
    rw [show (R0.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose R0 from
      congrArg Matrix.transpose (Matrix.map_id R0)]
    rw [hR0symm]
    have hGinvEq : G⁻¹ = Matrix.reindex eidx eidx G'⁻¹ := by
      rw [show G' = Matrix.reindex eidx.symm eidx.symm G from rfl, Matrix.inv_reindex]
      ext i j
      simp [Matrix.reindex_apply, Matrix.submatrix_apply]
    have hGeq : G = Matrix.reindex eidx eidx G' := by
      rw [show G' = Matrix.reindex eidx.symm eidx.symm G from rfl]
      ext i j
      simp [Matrix.reindex_apply, Matrix.submatrix_apply]
    rw [hGinvEq, hGeq,
      show R0 = Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) from rfl]
    rw [← bmdualm_reindex_mul, ← bmdualm_reindex_mul, hX]
  have hGdet : IsUnit G.det := bmdualm_G_isUnit_det n f
  have hformP : formAdj (RingHom.id (GaloisField 2 f)) G P = Pinv :=
    bmdualm_formAdj_P n f hPP hP
  have hformPinv : formAdj (RingHom.id (GaloisField 2 f)) G Pinv = P :=
    bmdualm_formAdj_Pinv n f hPP hP
  have hestar : bmdualmestar n f e = Pinv * R0s * P := by
    calc bmdualmestar n f e
        = formAdj (RingHom.id (GaloisField 2 f)) G (Pinv * R0 * P) := by
            rw [bmdualmestar, ← hconv]
      _ = formAdj (RingHom.id (GaloisField 2 f)) G P *
            formAdj (RingHom.id (GaloisField 2 f)) G (Pinv * R0) := by
            rw [show Pinv * R0 * P = (Pinv * R0) * P from rfl,
              Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) hGdet]
      _ = formAdj (RingHom.id (GaloisField 2 f)) G P *
            (formAdj (RingHom.id (GaloisField 2 f)) G R0 *
              formAdj (RingHom.id (GaloisField 2 f)) G Pinv) := by
            rw [Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) hGdet]
      _ = Pinv * (R0s * P) := by rw [hformP, hformR0, hformPinv]
      _ = Pinv * R0s * P := by rw [Matrix.mul_assoc]
  simpa only [R0s] using hestar.symm

private theorem bmdualm_eps_conj_noH
    (n f : ℕ) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hform : bmdualm_IsFormStandard n f R r' eidx) :
    Pinv * Matrix.reindex eidx eidx (bmdualm_D1 (R + 1) r' (GaloisField 2 f)) * P =
      1 - bmdualmeps n f e := by
  have hestar := bmdualm_estar_conj_noH n f (e := e) eidx hPP hPinvP hP hblock hconv hquad hquad'
    heps horth horth' hform
  have hD1 : bmdualm_D1 (R + 1) r' (GaloisField 2 f) =
      1 - bmdualm_D0 (R + 1) r' (GaloisField 2 f) -
        bmdualm_D0s (R + 1) r' (GaloisField 2 f) := by
    ext i j
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
      simp [bmdualm_D1, bmdualm_D0, bmdualm_D0s, Matrix.fromBlocks, Matrix.one_apply,
        sub_eq_add_neg, add_comm, add_left_comm, add_assoc]
  have hre : Matrix.reindex eidx eidx (bmdualm_D1 (R + 1) r' (GaloisField 2 f)) =
      (1 : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) -
        Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) -
        Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f)) := by
    rw [hD1]
    change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        ((1 : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
          (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f)) -
          bmdualm_D0 (R + 1) r' (GaloisField 2 f) -
          bmdualm_D0s (R + 1) r' (GaloisField 2 f)) =
        (1 : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) -
          (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
            (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) -
          (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
            (bmdualm_D0s (R + 1) r' (GaloisField 2 f))
    rw [map_sub, map_sub, map_one]
  rw [hre]
  have hexp : Pinv * ((1 : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) -
        Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) -
        Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f))) * P =
      Pinv * P - Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P -
        Pinv * Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f)) * P := by
    rw [Matrix.mul_sub, Matrix.mul_sub, Matrix.sub_mul, Matrix.sub_mul]
    noncomm_ring
  rw [hexp, hPinvP, hconv, hestar, bmdualmeps]
  abel

private theorem bmdualm_conj_mul'' (n f : ℕ)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1) (u v : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :
    (P * u * Pinv) * (P * v * Pinv) = P * (u * v) * Pinv := by
  rw [show (P * u * Pinv) * (P * v * Pinv) = P * u * (Pinv * P) * v * Pinv from by
    noncomm_ring, hPinvP, Matrix.mul_one]
  noncomm_ring

private theorem bmdualm_conj_sandwich (n f : ℕ)
    (P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (u : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :
    P * (Pinv * u * P) * Pinv = u := by
  rw [show P * (Pinv * u * P) * Pinv = (P * Pinv) * u * (P * Pinv) from by noncomm_ring,
    hPP, Matrix.one_mul, Matrix.mul_one]

private theorem bmdualm_block_of_mem
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e))
    (hgen : bmdualm_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJe : IsComponentOf J' (bmdualmrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hform : bmdualm_IsFormStandard n f R r' eidx)
    (g : ↥(spinGroup (bmdualmQ n f)))
    (hg : g ∈ glBlockCentralizer (bmdualmJ n f) S (bmdualmeps n f e)) :
    ∃ a : GL (Fin (R + 1)) (GaloisField 2 f),
      bmdualm_matOf n f R r' eidx P Pinv g = bmdualm_glBlock f R r' a := by
  rw [glBlockCentralizer, Subgroup.mem_comap, Subgroup.mem_inf] at hg
  obtain ⟨hgC, hgF⟩ := hg
  have hge : bmdualm_gm n f g * e = e * bmdualm_gm n f g := by
    refine (Algebra.commute_of_mem_adjoin_of_forall_mem_commute he.1 ?_).eq
    rintro b ⟨s, hs, rfl⟩
    exact (congrArg (fun u : GL (bmdualmι n) (GaloisField 2 f) =>
      (u : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)))
      ((Subgroup.mem_centralizer_iff.mp hgC) s hs)).symm
  have hgf : bmdualm_gm n f g * (1 - bmdualmeps n f e) = 1 - bmdualmeps n f e := hgF
  have hgsp : Matrix.transpose (bmdualm_gm n f g) * bmdualmG n f *
      bmdualm_gm n f g = bmdualmG n f := by
    simpa [bmdualm_gm] using bmdualm_isometry_of_quad (bmdualmQ n f)
      ((bmdualmJ n f g : GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
      (bmdualm_spinMatrix_isometry n f g)
  let M : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
    bmdualm_matOf n f R r' eidx P Pinv g
  set M' : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f) := P * bmdualm_gm n f g * Pinv
      with hM'def
  have hconje : P * e * Pinv =
      Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) := by
    rw [← hconv, bmdualm_conj_sandwich n f P Pinv hPP
        (Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)))]
  have hM0' : M' * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) =
      Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * M' := by
    change (P * bmdualm_gm n f g * Pinv) *
        Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) =
      Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) *
        (P * bmdualm_gm n f g * Pinv)
    rw [← hconje, bmdualm_conj_mul'' n f P Pinv hPinvP (bmdualm_gm n f g) e,
      bmdualm_conj_mul'' n f P Pinv hPinvP e (bmdualm_gm n f g), hge]
  have hM0 : M * bmdualm_D0 (R + 1) r' (GaloisField 2 f) =
      bmdualm_D0 (R + 1) r' (GaloisField 2 f) * M := by
    have h1 := congrArg (Matrix.reindex eidx.symm eidx.symm) hM0'
    conv at h1 => lhs; rw [bmdualm_reindex_mul]
    conv at h1 => rhs; rw [bmdualm_reindex_mul]
    rw [bmdualm_reindex_comp_symm] at h1
    simpa only [M, bmdualm_matOf, M'] using h1
  have hM1 : M * bmdualm_D1 (R + 1) r' (GaloisField 2 f) =
      bmdualm_D1 (R + 1) r' (GaloisField 2 f) := by
    have hconv1 := bmdualm_eps_conj_noH n f (e := e) eidx hPP hPinvP hP hblock hconv hquad hquad'
      heps horth horth' hform
    have h1 : P * (1 - bmdualmeps n f e) * Pinv =
        Matrix.reindex eidx eidx (bmdualm_D1 (R + 1) r' (GaloisField 2 f)) := by
      rw [← hconv1, bmdualm_conj_sandwich n f P Pinv hPP
          (Matrix.reindex eidx eidx (bmdualm_D1 (R + 1) r' (GaloisField 2 f)))]
    have h0 : M' * Matrix.reindex eidx eidx (bmdualm_D1 (R + 1) r' (GaloisField 2 f)) =
        Matrix.reindex eidx eidx (bmdualm_D1 (R + 1) r' (GaloisField 2 f)) := by
      change (P * bmdualm_gm n f g * Pinv) *
          Matrix.reindex eidx eidx (bmdualm_D1 (R + 1) r' (GaloisField 2 f)) =
        Matrix.reindex eidx eidx (bmdualm_D1 (R + 1) r' (GaloisField 2 f))
      rw [← h1, bmdualm_conj_mul'' n f P Pinv hPinvP (bmdualm_gm n f g) (1 - bmdualmeps n f e), hgf]
    have h2 := congrArg (Matrix.reindex eidx.symm eidx.symm) h0
    nth_rewrite 1 [bmdualm_reindex_mul] at h2
    rw [bmdualm_reindex_comp_symm] at h2
    simpa only [M, bmdualm_matOf, M'] using h2
  have hMsp : Matrix.transpose M *
      Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) * M =
      Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) := by
    have hiso : Matrix.transpose P * bmdualmG n f * P =
        bmdualmG n f :=
      bmdualm_isometry_of_quad (bmdualmQ n f) P hP
    have hsinv : Matrix.transpose Pinv * bmdualmG n f * Pinv =
        bmdualmG n f := by
      have h := congrArg (fun N => Matrix.transpose Pinv * N * Pinv) hiso
      have h1 : Matrix.transpose Pinv * (Matrix.transpose P * bmdualmG n f * P) *
          Pinv = bmdualmG n f := by
        rw [show Matrix.transpose Pinv * (Matrix.transpose P * bmdualmG n f * P) *
              Pinv = (Matrix.transpose Pinv * Matrix.transpose P) * bmdualmG n f *
                (P * Pinv) from by noncomm_ring,
          show Matrix.transpose Pinv * Matrix.transpose P = 1 from by
            rw [← Matrix.transpose_mul, hPP, Matrix.transpose_one], hPP]
        rw [Matrix.one_mul, Matrix.mul_one]
      rw [h1] at h
      exact h.symm
    have h1 : Matrix.transpose M' * bmdualmG n f * M' =
        bmdualmG n f := by
      change Matrix.transpose (P * bmdualm_gm n f g * Pinv) * bmdualmG n f *
          (P * bmdualm_gm n f g * Pinv) = bmdualmG n f
      rw [Matrix.transpose_mul, Matrix.transpose_mul]
      calc Matrix.transpose Pinv * (Matrix.transpose (bmdualm_gm n f g) * Matrix.transpose P) *
            bmdualmG n f * (P * bmdualm_gm n f g * Pinv)
          = Matrix.transpose Pinv * (Matrix.transpose (bmdualm_gm n f g) *
              (Matrix.transpose P * bmdualmG n f * P) * bmdualm_gm n f g) *
              Pinv := by noncomm_ring
        _ = Matrix.transpose Pinv * (Matrix.transpose (bmdualm_gm n f g) *
              bmdualmG n f * bmdualm_gm n f g) * Pinv := by rw [hiso]
        _ = Matrix.transpose Pinv * bmdualmG n f * Pinv := by rw [hgsp]
        _ = bmdualmG n f := hsinv
    have h2 := congrArg (Matrix.reindex eidx.symm eidx.symm) h1
    nth_rewrite 1 [bmdualm_reindex_mul] at h2
    nth_rewrite 1 [bmdualm_reindex_mul] at h2
    rw [← bmdualm_reindex_transpose] at h2
    simpa only [M, bmdualm_matOf, M'] using h2
  obtain ⟨A, D, hAD⟩ := bmdualm_block_diag_outer R r' (F := GaloisField 2 f) hM0
  have hD1 : D * Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) =
      Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) := by
    have h := hM1
    rw [hAD, bmdualm_D1_eq R r' (GaloisField 2 f)] at h
    rw [Matrix.fromBlocks_multiply] at h
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add] at h
    rw [Matrix.fromBlocks_inj] at h
    exact h.2.2.2
  obtain ⟨E, G, hDE⟩ := bmdualm_block_diag_inner R r' (F := GaloisField 2 f) hD1
  have hs : Matrix.transpose (Matrix.fromBlocks A 0 0 (Matrix.fromBlocks E 0 G 1)) *
      Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) *
      Matrix.fromBlocks A 0 0 (Matrix.fromBlocks E 0 G 1) =
      Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) := by
    rw [← hDE, ← hAD]
    exact hMsp
  obtain ⟨hAE, hG0⟩ := bmdualm_block_symplectic n f R r' eidx hform hs
  have hAEt : Matrix.transpose E * A = 1 := by
    have h := congrArg Matrix.transpose hAE
    simpa [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.transpose_one] using h
  let a : GL (Fin (R + 1)) (GaloisField 2 f) :=
    (Units.mkOfMulEqOne (Matrix.transpose E) A hAEt)⁻¹
  refine ⟨a, ?_⟩
  change M = bmdualm_glBlock f R r' a
  rw [hAD, hDE, hG0]
  unfold bmdualm_glBlock
  rw [show ((a : GL (Fin (R + 1)) (GaloisField 2 f)) :
        Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = A from rfl,
    show (((a⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
        Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = Matrix.transpose E from rfl]
  rw [Matrix.transpose_transpose]

private theorem bmdualm_block_of_mem_rank_zero
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e))
    (hgen : bmdualm_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJe : IsComponentOf J' (bmdualmrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hform : bmdualm_IsFormStandard n f R r' eidx)
    (g : ↥(spinGroup (bmdualmQ n f)))
    (hg : g ∈ glBlockCentralizer (bmdualmJ n f) S (bmdualmeps n f e)) :
    ∃ a : GL (Fin (R + 1)) (GaloisField 2 f),
      bmdualm_matOf n f R r' eidx P Pinv g = bmdualm_glBlock f R r' a :=
  bmdualm_block_of_mem n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock hconv hquad hquad'
    heps horth horth' hform g hg

private theorem bmdualm_range_le_embedHom
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e))
    (hgen : bmdualm_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJe : IsComponentOf J' (bmdualmrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hform : bmdualm_IsFormStandard n f R r' eidx) :
    bmdualmrange n f S e ≤
      (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range := by
  have getBlock : ∀ g ∈ glBlockCentralizer (bmdualmJ n f) S (bmdualmeps n f e),
      ∃ a : GL (Fin (R + 1)) (GaloisField 2 f),
        bmdualm_matOf n f R r' eidx P Pinv g = bmdualm_glBlock f R r' a :=
    fun g hg => by
      by_cases hR0 : R = 0
      · exact bmdualm_block_of_mem_rank_zero n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP
          hblock hconv hquad hquad' heps horth horth' hform g hg
      · exact bmdualm_block_of_mem n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock
          hconv hquad hquad' heps horth horth' hform g hg
  rw [show bmdualmrange n f S e = ⁅glBlockCentralizer (bmdualmJ n f) S
      (bmdualmeps n f e), glBlockCentralizer (bmdualmJ n f) S
      (bmdualmeps n f e)⁆ from rfl, Subgroup.commutator_le]
  intro u hu v hv
  rw [commutatorElement_def]
  obtain ⟨au, hau⟩ := getBlock u hu
  obtain ⟨av, hav⟩ := getBlock v hv
  have hM : bmdualm_matOf n f R r' eidx P Pinv (u * v * u⁻¹ * v⁻¹) =
      bmdualm_glBlock f R r' (au * av * au⁻¹ * av⁻¹) := by
    rw [bmdualm_matOf_mul n f R r' eidx P Pinv hPinvP,
      bmdualm_matOf_mul n f R r' eidx P Pinv hPinvP,
      bmdualm_matOf_mul n f R r' eidx P Pinv hPinvP,
      bmdualm_matOf_inv n f R r' eidx P Pinv hPP hPinvP,
      bmdualm_matOf_inv n f R r' eidx P Pinv hPP hPinvP,
      hau, hav]
    rw [← bmdualm_glBlock_inv, ← bmdualm_glBlock_inv, ← bmdualm_glBlock_mul,
      ← bmdualm_glBlock_mul, ← bmdualm_glBlock_mul]
  have hdet_au : ((au : GL (Fin (R + 1)) (GaloisField 2 f)) :
      Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
      (((au⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
        Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det = 1 := by
    rw [← Matrix.det_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.det_one]
  have hdet_av : ((av : GL (Fin (R + 1)) (GaloisField 2 f)) :
      Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
      (((av⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
        Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det = 1 := by
    rw [← Matrix.det_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.det_one]
  have hdet : (((au * av * au⁻¹ * av⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
      Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det = 1 := by
    rw [Units.val_mul, Units.val_mul, Units.val_mul, Matrix.det_mul, Matrix.det_mul,
      Matrix.det_mul]
    calc ((au : GL (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
          ((av : GL (Fin (R + 1)) (GaloisField 2 f)) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
          (((au⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
          (((av⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det
        = (((au : GL (Fin (R + 1)) (GaloisField 2 f)) :
              Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
            (((au⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
              Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det) *
          (((av : GL (Fin (R + 1)) (GaloisField 2 f)) :
              Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
            (((av⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
              Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det) := by ring
      _ = 1 := by rw [hdet_au, hdet_av, mul_one]
  let x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) :=
    ⟨(((au * av * au⁻¹ * av⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
      Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)), hdet⟩
  refine ⟨x, ?_⟩
  apply bmdualm_spinMatrix_injective n f
  change bmdualmJ n f
      (Classical.choose (bmdualm_embedGL_mem_spin n f R r' hn eidx hPP hPinvP hP hblock x)) =
    bmdualmJ n f (u * v * u⁻¹ * v⁻¹)
  rw [bmdualm_embedGL_choose_eq n f R r' hn eidx hPP hPinvP hP hblock x]
  apply Units.ext
  have hxgl : (x : GL (Fin (R + 1)) (GaloisField 2 f)) =
      (au * av * au⁻¹ * av⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) := Units.ext rfl
  have hMw : bmdualm_matOf n f R r' eidx P Pinv (u * v * u⁻¹ * v⁻¹) =
      bmdualm_blockMat n f (R + 1) r' x := by
    rw [hM, ← hxgl, ← bmdualm_blockMat_eq_glBlock]
  have hMw2 : P * bmdualm_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv =
      Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) := by
    have h := congrArg (Matrix.reindex eidx eidx) hMw
    unfold bmdualm_matOf at h
    change Matrix.reindex eidx.symm.symm eidx.symm.symm
      (Matrix.reindex eidx.symm eidx.symm
        (P * bmdualm_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv)) =
      Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) at h
    rw [bmdualm_reindex_comp_symm f eidx.symm
      (P * bmdualm_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv)] at h
    exact h
  change ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualmι n)
      (GaloisField 2 f)) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
    bmdualm_gm n f (u * v * u⁻¹ * v⁻¹)
  rw [show ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualmι n)
      (GaloisField 2 f)) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
      Pinv * Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) * P from rfl]
  calc Pinv * Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) * P
      = Pinv * (P * bmdualm_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv) * P := by rw [← hMw2]
    _ = bmdualm_gm n f (u * v * u⁻¹ * v⁻¹) := by
        rw [show Pinv * (P * bmdualm_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv) * P =
            (Pinv * P) * bmdualm_gm n f (u * v * u⁻¹ * v⁻¹) * (Pinv * P) from by
          noncomm_ring, hPinvP]
        simp

private theorem bmdualm_component_sl2_card_quot
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e))
    (hgen : bmdualm_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJe : IsComponentOf J' (bmdualmrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0) :
    60 ≤ Nat.card (J' ⧸ Subgroup.center J') := by
  haveI : Finite ↥(spinGroup (bmdualmQ n f)) :=
    Finite.of_injective (bmdualmJ n f)
      (bmdualm_spinMatrix_injective n f)
  haveI : Finite ↥J' := Subtype.finite
  have hq : CFSG.IsQuasisimple J' :=
    (CFSG.Foundations.SteinbergCA.quasisimple_iff J').2.1.mpr hJe.2.2
  exact CFSG.Quasithin.S146zW.sw_sixty_le_card_quot hq

private theorem bmdualm_component_sl2_card_le
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e))
    (hgen : bmdualm_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJe : IsComponentOf J' (bmdualmrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hR : R + 1 = 2) :
    Nat.card (J' ⧸ Subgroup.center J') ≤ Nat.card (Matrix.SpecialLinearGroup (Fin 2)
      (GaloisField 2 f)) := by
  haveI : Finite ↥(spinGroup (bmdualmQ n f)) :=
    Finite.of_injective (bmdualmJ n f)
      (bmdualm_spinMatrix_injective n f)
  haveI : Finite ↥J' := Subtype.finite
  have hcomp : J' ≤ (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range :=
    le_trans hJe.1 (bmdualm_range_le_embedHom n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP
      hblock hconv hquad hquad' heps horth horth'
      (bmdualm_formStandard_noH n f (e := e) eidx hPP hPinvP hP hblock hconv hquad hquad' heps
        horth horth' (by omega)))
  let φ : J' → Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) :=
    fun x => (MonoidHom.mem_range.mp (hcomp x.2)).choose
  have hφ : Function.Injective φ := by
    intro x y hxy
    apply Subtype.ext
    have hx := (MonoidHom.mem_range.mp (hcomp x.2)).choose_spec
    have hy := (MonoidHom.mem_range.mp (hcomp y.2)).choose_spec
    rw [← hx, ← hy]
    exact congrArg _ hxy
  have h1 : Nat.card (J' ⧸ Subgroup.center J') ≤ Nat.card J' :=
    Nat.card_le_card_of_surjective (QuotientGroup.mk' (Subgroup.center J'))
      (QuotientGroup.mk'_surjective (Subgroup.center J'))
  have h2 : Nat.card J' ≤
      Nat.card (Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :=
    Nat.card_le_card_of_injective φ hφ
  rw [hR] at h2
  exact le_trans h1 h2

private theorem bmdualm_component_sl2_card_field
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e))
    (hgen : bmdualm_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJe : IsComponentOf J' (bmdualmrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hR : R + 1 = 2) :
    4 ≤ Nat.card (GaloisField 2 f) := by
  have h60 := bmdualm_component_sl2_card_quot n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP
    hblock hconv hquad hquad' heps horth horth'
  have hle := bmdualm_component_sl2_card_le n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP
    hblock hconv hquad hquad' heps horth horth' hR
  have hcard : Nat.card (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 f)) =
      Nat.card (GaloisField 2 f) * (Nat.card (GaloisField 2 f) ^ 2 - 1) :=
    CFSG.RankThree.PartOne.KFOUT3.card_sl2 (GaloisField 2 f)
  set m := Nat.card (GaloisField 2 f) with hm
  have h60' : 60 ≤ m * (m ^ 2 - 1) := by
    calc 60 ≤ Nat.card (J' ⧸ Subgroup.center J') := h60
      _ ≤ Nat.card (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 f)) := hle
      _ = m * (m ^ 2 - 1) := hcard
  have hpos : 0 < m := by rw [hm]; exact Nat.card_pos
  by_contra hlt
  push Not at hlt
  interval_cases m <;> omega

private theorem bmdualm_component_sl2_card
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e))
    (hgen : bmdualm_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJe : IsComponentOf J' (bmdualmrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hR : R + 1 = 2) :
    (∃ s : Finset (GaloisField 2 f), s.card = 4) := by
  have h4 : 4 ≤ Nat.card (GaloisField 2 f) :=
    bmdualm_component_sl2_card_field n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock
      hconv hquad hquad' heps horth horth' hR
  classical
  haveI : Fintype (GaloisField 2 f) := Fintype.ofFinite _
  obtain ⟨s, -, hs⟩ := Finset.exists_subset_card_eq (s := (Finset.univ : Finset (GaloisField 2 f)))
    (n := 4) (by simpa [Finset.card_univ, Nat.card_eq_fintype_card] using h4)
  exact ⟨s, hs⟩

private theorem bmdualm_component_perfectSL
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e))
    (hgen : bmdualm_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJe : IsComponentOf J' (bmdualmrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0) :
    Group.IsPerfect (Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) := by
  rcases lt_or_ge (R + 1) 3 with hlt | hge
  · have hcases : R + 1 = 1 ∨ R + 1 = 2 := by omega
    rcases hcases with hR1 | hR2
    · haveI : Subsingleton (Fin (R + 1)) := Fin.subsingleton_iff_le_one.mpr (by omega)
      exact Group.IsPerfect.mk (Subsingleton.elim _ _)
    · obtain ⟨s, hs⟩ := bmdualm_component_sl2_card n f hn S hS he hestar hgen hJe eidx hPP hPinvP
        hP hblock hconv hquad hquad' heps horth horth' hR2
      exact CFSG.LinearGroups.special_linear_isPerfect (K := GaloisField 2 f) (n := R + 1)
        (by omega) (Or.inr ⟨s, hs⟩)
  · exact CFSG.LinearGroups.special_linear_dimension_at_least_three_perfect
      (K := GaloisField 2 f) (n := R + 1) hge

private theorem bmdualm_D1_eq_sub (r r' : ℕ) (F : Type) [Field F] :
    bmdualm_D1 r r' F = 1 - bmdualm_D0 r r' F - bmdualm_D0s r r' F := by
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
    simp [bmdualm_D1, bmdualm_D0, bmdualm_D0s, Matrix.fromBlocks, Matrix.one_apply, sub_eq_add_neg,
      add_comm, add_left_comm, add_assoc]

private theorem bmdualm_embedGL_coe (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
      Pinv * Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) * P := rfl

private theorem bmdualm_reindex_smul (f : ℕ) {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ] (e : ι ≃ κ) (c : GaloisField 2 f)
    (A : Matrix ι ι (GaloisField 2 f)) :
    Matrix.reindex e e (c • A) = c • Matrix.reindex e e A := by
  change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) (c • A) =
    c • (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) A
  rw [map_smul]

private theorem bmdualm_D0_add_D0s_add_D1 (r r' : ℕ) (F : Type) [Semiring F] :
    bmdualm_D0 r r' F + bmdualm_D0s r r' F + bmdualm_D1 r r' F = 1 := by
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
    simp [bmdualm_D0, bmdualm_D0s, bmdualm_D1, Matrix.fromBlocks, Matrix.add_apply,
      Matrix.one_apply]

private theorem bmdualm_D0_comm_blockMat (n f r r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmdualm_D0 r r' (GaloisField 2 f) * bmdualm_blockMat n f r r' x =
      bmdualm_blockMat n f r r' x * bmdualm_D0 r r' (GaloisField 2 f) := by
  unfold bmdualm_D0 bmdualm_blockMat
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp

private theorem bmdualm_D0s_comm_blockMat (n f r r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmdualm_D0s r r' (GaloisField 2 f) * bmdualm_blockMat n f r r' x =
      bmdualm_blockMat n f r r' x * bmdualm_D0s r r' (GaloisField 2 f) := by
  unfold bmdualm_D0s bmdualm_blockMat
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp

private theorem bmdualm_D1_mul_blockMat (n f r r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmdualm_D1 r r' (GaloisField 2 f) * bmdualm_blockMat n f r r' x =
      bmdualm_D1 r r' (GaloisField 2 f) := by
  unfold bmdualm_D1 bmdualm_blockMat
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one,
    Matrix.one_mul]

private theorem bmdualm_blockMat_mul_D1 (n f r r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmdualm_blockMat n f r r' x * bmdualm_D1 r r' (GaloisField 2 f) =
      bmdualm_D1 r r' (GaloisField 2 f) := by
  unfold bmdualm_blockMat bmdualm_D1
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one,
    Matrix.one_mul]

private theorem bmdualm_embedGL_fixes_compl (n f R r' : ℕ)
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hform : bmdualm_IsFormStandard n f R r' eidx)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) * (1 - bmdualmeps n f e) =
      1 - bmdualmeps n f e := by
  rw [← bmdualm_eps_conj_noH n f eidx hPP hPinvP hP hblock hconv hquad hquad' heps horth horth'
    hform]
  rw [bmdualm_embedGL_coe n f R r' eidx hPP hPinvP x]
  change (Pinv * Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x) * P) *
      (Pinv * Matrix.reindex eidx eidx (bmdualm_D1 (R + 1) r' (GaloisField 2 f)) * P) =
      Pinv * Matrix.reindex eidx eidx (bmdualm_D1 (R + 1) r' (GaloisField 2 f)) * P
  rw [bmdualm_conj_mul n f P Pinv hPP, ← bmdualm_reindex_mul,
    bmdualm_blockMat_mul_D1 n f (R + 1) r' x]

private theorem bmdualm_embedGL_centralizes (n f R r' : ℕ)
    (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e))
    (hgen : bmdualm_scalarAction n f S e)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hform : bmdualm_IsFormStandard n f R r' eidx)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (s : GL (bmdualmι n) (GaloisField 2 f)) (hs : s ∈ S) :
    (s : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) *
        ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualmι n) (GaloisField 2 f)) :
          Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
      ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualmι n) (GaloisField 2 f)) :
          Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) *
        (s : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) := by
  obtain ⟨c, hcne, hce, hce'⟩ := hgen s hs
  let sM : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f) :=
    (s : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
  change sM * ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x :
      GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
    ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x :
      GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) * sM
  have hceM : sM * e = c • e := hce
  have hceM' : sM * bmdualmestar n f e = c⁻¹ • bmdualmestar n f e := hce'
  have hsA : sM ∈ bmdualmA n f S :=
    Algebra.subset_adjoin (Set.mem_image_of_mem Units.val hs)
  have hse : sM * e = e * sM := (bmdualm_adjoin_comm hS sM hsA e he.1).eq
  have hse' : sM * bmdualmestar n f e = bmdualmestar n f e * sM :=
    (bmdualm_adjoin_comm hS sM hsA (bmdualmestar n f e) hestar.1).eq
  let T : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
    Matrix.reindex eidx.symm eidx.symm (P * sM * Pinv)
  have hT_eq : Matrix.reindex eidx eidx T = P * sM * Pinv :=
    bmdualm_reindex_comp_symm f eidx.symm (P * sM * Pinv)
  have hs_eq : sM = Pinv * Matrix.reindex eidx eidx T * P := by
    rw [hT_eq]
    calc sM = (Pinv * P) * sM * (Pinv * P) := by rw [hPinvP]; simp
      _ = Pinv * (P * sM * Pinv) * P := by noncomm_ring
  have hD0' : Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) =
      P * e * Pinv := by
    calc Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f))
        = (P * Pinv) * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) *
            (P * Pinv) := by rw [hPP]; simp
      _ = P * (Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P) *
            Pinv := by noncomm_ring
      _ = P * e * Pinv := by rw [hconv]
  have hD0s' : Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f)) =
      P * bmdualmestar n f e * Pinv := by
    have hest := bmdualm_estar_conj_noH n f eidx hPP hPinvP hP hblock hconv hquad hquad' heps
      horth horth' hform
    calc Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f))
        = (P * Pinv) * Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f)) *
            (P * Pinv) := by rw [hPP]; simp
      _ = P * (Pinv * Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f)) * P) *
            Pinv := by noncomm_ring
      _ = P * bmdualmestar n f e * Pinv := by rw [← hest]
  have hT_D0 : T * bmdualm_D0 (R + 1) r' (GaloisField 2 f) =
      c • bmdualm_D0 (R + 1) r' (GaloisField 2 f) := by
    have hkey : Matrix.reindex eidx eidx (T * bmdualm_D0 (R + 1) r' (GaloisField 2 f)) =
        c • Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) := by
      rw [bmdualm_reindex_mul f eidx T (bmdualm_D0 (R + 1) r' (GaloisField 2 f)), hT_eq, hD0']
      calc (P * sM * Pinv) * (P * e * Pinv) = P * (sM * e) * Pinv :=
            bmdualm_conj_mul'' n f P Pinv hPinvP sM e
        _ = P * (c • e) * Pinv := by rw [hceM]
        _ = c • (P * e * Pinv) := by rw [Matrix.mul_smul, Matrix.smul_mul]
    have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hkey
    rw [bmdualm_reindex_smul f eidx.symm c
        (Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f))),
      bmdualm_reindex_comp_symm f eidx (T * bmdualm_D0 (R + 1) r' (GaloisField 2 f)),
      bmdualm_reindex_comp_symm f eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f))] at h
    exact h
  have hD0_T : bmdualm_D0 (R + 1) r' (GaloisField 2 f) * T =
      c • bmdualm_D0 (R + 1) r' (GaloisField 2 f) := by
    have hkey : Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f) * T) =
        c • Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) := by
      rw [bmdualm_reindex_mul f eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) T, hT_eq, hD0']
      calc (P * e * Pinv) * (P * sM * Pinv) = P * (e * sM) * Pinv :=
            bmdualm_conj_mul'' n f P Pinv hPinvP e sM
        _ = P * (sM * e) * Pinv := by rw [← hse]
        _ = P * (c • e) * Pinv := by rw [hceM]
        _ = c • (P * e * Pinv) := by rw [Matrix.mul_smul, Matrix.smul_mul]
    have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hkey
    rw [bmdualm_reindex_smul f eidx.symm c
        (Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f))),
      bmdualm_reindex_comp_symm f eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f) * T),
      bmdualm_reindex_comp_symm f eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f))] at h
    exact h
  have hT_D0s : T * bmdualm_D0s (R + 1) r' (GaloisField 2 f) =
      c⁻¹ • bmdualm_D0s (R + 1) r' (GaloisField 2 f) := by
    have hkey : Matrix.reindex eidx eidx (T * bmdualm_D0s (R + 1) r' (GaloisField 2 f)) =
        c⁻¹ • Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f)) := by
      rw [bmdualm_reindex_mul f eidx T (bmdualm_D0s (R + 1) r' (GaloisField 2 f)), hT_eq, hD0s']
      calc (P * sM * Pinv) * (P * bmdualmestar n f e * Pinv) =
            P * (sM * bmdualmestar n f e) * Pinv :=
            bmdualm_conj_mul'' n f P Pinv hPinvP sM (bmdualmestar n f e)
        _ = P * (c⁻¹ • bmdualmestar n f e) * Pinv := by rw [hceM']
        _ = c⁻¹ • (P * bmdualmestar n f e * Pinv) := by rw [Matrix.mul_smul, Matrix.smul_mul]
    have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hkey
    rw [bmdualm_reindex_smul f eidx.symm (c⁻¹)
        (Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f))),
      bmdualm_reindex_comp_symm f eidx (T * bmdualm_D0s (R + 1) r' (GaloisField 2 f)),
      bmdualm_reindex_comp_symm f eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f))] at h
    exact h
  have hD0s_T : bmdualm_D0s (R + 1) r' (GaloisField 2 f) * T =
      c⁻¹ • bmdualm_D0s (R + 1) r' (GaloisField 2 f) := by
    have hkey : Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f) * T) =
        c⁻¹ • Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f)) := by
      rw [bmdualm_reindex_mul f eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f)) T, hT_eq, hD0s']
      calc (P * bmdualmestar n f e * Pinv) * (P * sM * Pinv) =
            P * (bmdualmestar n f e * sM) * Pinv :=
            bmdualm_conj_mul'' n f P Pinv hPinvP (bmdualmestar n f e) sM
        _ = P * (sM * bmdualmestar n f e) * Pinv := by rw [← hse']
        _ = P * (c⁻¹ • bmdualmestar n f e) * Pinv := by rw [hceM']
        _ = c⁻¹ • (P * bmdualmestar n f e * Pinv) := by rw [Matrix.mul_smul, Matrix.smul_mul]
    have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hkey
    rw [bmdualm_reindex_smul f eidx.symm (c⁻¹)
        (Matrix.reindex eidx eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f))),
      bmdualm_reindex_comp_symm f eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f) * T),
      bmdualm_reindex_comp_symm f eidx (bmdualm_D0s (R + 1) r' (GaloisField 2 f))] at h
    exact h
  have hT_decomp : T = c • bmdualm_D0 (R + 1) r' (GaloisField 2 f) +
      c⁻¹ • bmdualm_D0s (R + 1) r' (GaloisField 2 f) +
      T * bmdualm_D1 (R + 1) r' (GaloisField 2 f) := by
    calc T = T * 1 := (Matrix.mul_one T).symm
      _ = T * (bmdualm_D0 (R + 1) r' (GaloisField 2 f) +
            bmdualm_D0s (R + 1) r' (GaloisField 2 f) +
            bmdualm_D1 (R + 1) r' (GaloisField 2 f)) := by
            rw [bmdualm_D0_add_D0s_add_D1 (R + 1) r' (GaloisField 2 f)]
      _ = T * bmdualm_D0 (R + 1) r' (GaloisField 2 f) +
            T * bmdualm_D0s (R + 1) r' (GaloisField 2 f) +
            T * bmdualm_D1 (R + 1) r' (GaloisField 2 f) := by
            rw [Matrix.mul_add, Matrix.mul_add]
      _ = c • bmdualm_D0 (R + 1) r' (GaloisField 2 f) +
            c⁻¹ • bmdualm_D0s (R + 1) r' (GaloisField 2 f) +
            T * bmdualm_D1 (R + 1) r' (GaloisField 2 f) := by rw [hT_D0, hT_D0s]
  have hT_D1_comm : T * bmdualm_D1 (R + 1) r' (GaloisField 2 f) =
      bmdualm_D1 (R + 1) r' (GaloisField 2 f) * T := by
    have h1 : T * bmdualm_D1 (R + 1) r' (GaloisField 2 f) =
        T - c • bmdualm_D0 (R + 1) r' (GaloisField 2 f) -
          c⁻¹ • bmdualm_D0s (R + 1) r' (GaloisField 2 f) := by
      rw [bmdualm_D1_eq_sub (R + 1) r' (GaloisField 2 f), Matrix.mul_sub, Matrix.mul_sub,
        Matrix.mul_one, hT_D0, hT_D0s]
    have h2 : bmdualm_D1 (R + 1) r' (GaloisField 2 f) * T =
        T - c • bmdualm_D0 (R + 1) r' (GaloisField 2 f) -
          c⁻¹ • bmdualm_D0s (R + 1) r' (GaloisField 2 f) := by
      rw [bmdualm_D1_eq_sub (R + 1) r' (GaloisField 2 f), Matrix.sub_mul, Matrix.sub_mul,
        Matrix.one_mul, hD0_T, hD0s_T]
    rw [h1, h2]
  have hThird : (T * bmdualm_D1 (R + 1) r' (GaloisField 2 f)) *
        bmdualm_blockMat n f (R + 1) r' x =
      bmdualm_blockMat n f (R + 1) r' x *
        (T * bmdualm_D1 (R + 1) r' (GaloisField 2 f)) := by
    rw [Matrix.mul_assoc, bmdualm_D1_mul_blockMat, hT_D1_comm, ← Matrix.mul_assoc,
      bmdualm_blockMat_mul_D1]
  have hTB : T * bmdualm_blockMat n f (R + 1) r' x =
      bmdualm_blockMat n f (R + 1) r' x * T := by
    rw [hT_decomp, Matrix.add_mul, Matrix.add_mul, Matrix.smul_mul, Matrix.smul_mul,
      Matrix.mul_add, Matrix.mul_add, Matrix.mul_smul, Matrix.mul_smul,
      bmdualm_D0_comm_blockMat, bmdualm_D0s_comm_blockMat, hThird]
  have hfin : sM * ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x :
      GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
      Pinv * Matrix.reindex eidx eidx (T * bmdualm_blockMat n f (R + 1) r' x) * P := by
    rw [hs_eq, bmdualm_embedGL_coe n f R r' eidx hPP hPinvP x]
    rw [bmdualm_conj_mul n f P Pinv hPP,
      ← bmdualm_reindex_mul f eidx T (bmdualm_blockMat n f (R + 1) r' x)]
  have hfin' : ((bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x :
      GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) * sM =
      Pinv * Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x * T) * P := by
    rw [hs_eq, bmdualm_embedGL_coe n f R r' eidx hPP hPinvP x]
    rw [bmdualm_conj_mul n f P Pinv hPP,
      ← bmdualm_reindex_mul f eidx (bmdualm_blockMat n f (R + 1) r' x) T]
  rw [hfin, hfin', hTB]

private theorem bmdualm_embedHom_range_le_centralizer
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e))
    (hgen : bmdualm_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJe : IsComponentOf J' (bmdualmrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hform : bmdualm_IsFormStandard n f R r' eidx) :
    (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range ≤
      glBlockCentralizer (bmdualmJ n f) S (bmdualmeps n f e) := by
  rintro y ⟨x, rfl⟩
  have hjy : bmdualmJ n f
        (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock x) =
      bmdualm_embedGL n f R r' eidx P Pinv hPP hPinvP x :=
    Units.ext (bmdualm_embedSpin_spinMatrix n f R r' hn eidx hPP hPinvP hP hblock x)
  rw [glBlockCentralizer, Subgroup.mem_comap, Subgroup.mem_inf]
  constructor
  · rw [Subgroup.mem_centralizer_iff]
    intro s hs
    apply Units.ext
    rw [hjy]
    exact bmdualm_embedGL_centralizes n f R r' S hS he hestar hgen eidx hPP hPinvP hP hblock hconv
      hquad hquad' heps horth horth' hform x s hs
  · rw [hjy]
    exact bmdualm_embedGL_fixes_compl n f R r' eidx hPP hPinvP hP hblock hconv hquad hquad' heps
      horth horth' hform x

private theorem bmdualm_embedHom_range_le
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e))
    (hgen : bmdualm_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualmQ n f))}
    (hJe : IsComponentOf J' (bmdualmrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n)
    {P Pinv : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec P v) = bmdualmQ n f v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdualm_blockMat n f (R + 1) r' x)) w) =
        bmdualmQ n f w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdualm_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualmeps n f e))
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hform : bmdualm_IsFormStandard n f R r' eidx) :
    (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range ≤
      bmdualmrange n f S e := by
  haveI : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :=
    bmdualm_component_perfectSL n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock hconv
      hquad hquad' heps horth horth'
  haveI : Group.IsPerfect (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range :=
    Group.IsPerfect.ofSurjective
      (f := (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).rangeRestrict)
      (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).rangeRestrict_surjective
  have hcent := bmdualm_embedHom_range_le_centralizer n f hn S hS he hestar hgen hJe eidx hPP
    hPinvP hP hblock hconv hquad hquad' heps horth horth' hform
  calc (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range
      = ⁅(bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range,
          (bmdualm_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range⁆ :=
        (Subgroup.commutator_eq_self).symm
    _ ≤ ⁅glBlockCentralizer (bmdualmJ n f) S (bmdualmeps n f e),
          glBlockCentralizer (bmdualmJ n f) S (bmdualmeps n f e)⁆ :=
        Subgroup.commutator_mono hcent hcent
    _ = bmdualmrange n f S e := rfl

private theorem bmdualm_embedHom_range_eq
    (n f : ℕ) (hn : 4 ≤ n) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
