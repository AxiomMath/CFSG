private abbrev bmdualmι (n : ℕ) : Type := Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2

private noncomputable abbrev bmdualmQ (n f : ℕ) :
    QuadraticForm (GaloisField 2 f) (bmdualmι n → GaloisField 2 f) :=
  Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1 (minusCoeffs 2 f).2

private noncomputable abbrev bmdualmG (n f : ℕ) :
    Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f) :=
  LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (bmdualmQ n f))

private noncomputable abbrev bmdualmQp (r f : ℕ) :
    QuadraticForm (GaloisField 2 f) (Fin r ⊕ Fin r → GaloisField 2 f) :=
  Spin.quadPlus r (GaloisField 2 f)

private noncomputable abbrev bmdualmGp (r f : ℕ) :
    Matrix (Fin r ⊕ Fin r) (Fin r ⊕ Fin r) (GaloisField 2 f) :=
  LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (bmdualmQp r f))

private noncomputable abbrev bmdualmA (n f : ℕ) (S : Set (GL (bmdualmι n) (GaloisField 2 f))) :
    Subalgebra (GaloisField 2 f) (Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :=
  Algebra.adjoin (GaloisField 2 f) (Units.val '' S)

private noncomputable abbrev bmdualmJ (n f : ℕ) :
    ↥(spinGroup (bmdualmQ n f)) →* GL (bmdualmι n) (GaloisField 2 f) :=
  Spin.spinMatrix (bmdualmQ n f)

private noncomputable abbrev bmdualmestar (n f : ℕ)
    (e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :
    Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f) :=
  formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f) e

private noncomputable abbrev bmdualmeps (n f : ℕ)
    (e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :
    Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f) :=
  e + bmdualmestar n f e

private noncomputable abbrev bmdualmrange (n f : ℕ)
    (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :
    Subgroup ↥(spinGroup (bmdualmQ n f)) :=
  ⁅glBlockCentralizer (bmdualmJ n f) S (bmdualmeps n f e),
    glBlockCentralizer (bmdualmJ n f) S (bmdualmeps n f e)⁆

private def bmdualm_scalarAction (n f : ℕ)
    (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) : Prop :=
  ∀ s ∈ S, ∃ c : GaloisField 2 f, c ≠ 0 ∧
    (s : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) * e = c • e ∧
    (s : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) * bmdualmestar n f e =
      c⁻¹ • bmdualmestar n f e

private theorem bmdualm_formAdj_zero {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (σ : F →+* F) (G : Matrix ι ι F) : formAdj σ G 0 = 0 := by
  unfold formAdj
  rw [Matrix.map_zero σ (map_zero σ), Matrix.transpose_zero, Matrix.mul_zero, Matrix.zero_mul]

private lemma bmdualm_adjoin_comm {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    {S : Set (GL ι F)} (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') :
    ∀ a ∈ Algebra.adjoin F (Units.val '' S), ∀ b ∈ Algebra.adjoin F (Units.val '' S),
      Commute a b := by
  intro a ha b hb
  have hgen : (Units.val '' S : Set (Matrix ι ι F)) ⊆
      (Subalgebra.centralizer F (Units.val '' S) : Set (Matrix ι ι F)) := by
    rintro x ⟨s, hs, rfl⟩
    refine (Subalgebra.mem_centralizer_iff F).mpr ?_
    intro y hy
    rcases hy with ⟨s', hs', rfl⟩
    have h := congrArg (fun u : GL ι F => (u : Matrix ι ι F)) (hS s' hs' s hs).eq
    simpa [Units.val_mul] using h
  have hA : Algebra.adjoin F (Units.val '' S) ≤ Subalgebra.centralizer F (Units.val '' S) :=
    Algebra.adjoin_le hgen
  have ha' : a ∈ Subalgebra.centralizer F (Units.val '' S) := hA ha
  have hgen2 : (Units.val '' S : Set (Matrix ι ι F)) ⊆
      (Subalgebra.centralizer F ({a} : Set (Matrix ι ι F)) : Set (Matrix ι ι F)) := by
    rintro x ⟨s, hs, rfl⟩
    refine (Subalgebra.mem_centralizer_iff F).mpr ?_
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    have h := (Subalgebra.mem_centralizer_iff F).mp ha' (s : Matrix ι ι F) ⟨s, hs, rfl⟩
    exact h.symm
  have hA2 : Algebra.adjoin F (Units.val '' S) ≤
      Subalgebra.centralizer F ({a} : Set (Matrix ι ι F)) := Algebra.adjoin_le hgen2
  have hb' : b ∈ Subalgebra.centralizer F ({a} : Set (Matrix ι ι F)) := hA2 hb
  exact (Subalgebra.mem_centralizer_iff F).mp hb' a (Set.mem_singleton a)

private theorem bmdualm_blockDegree_eq_one
    (n f : ℕ) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hdeg : blockDegree (bmdualmA n f S) e < 2) :
    blockDegree (bmdualmA n f S) e = 1 := by
  let M : Submodule (GaloisField 2 f)
      (Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :=
    (Subalgebra.toSubmodule (bmdualmA n f S)).map
      (LinearMap.mulRight (GaloisField 2 f) e)
  have heM : e ∈ M := ⟨e, he.1, by rw [LinearMap.mulRight_apply, he.2.1.eq]⟩
  have hbot : (⊥ : Submodule (GaloisField 2 f)
      (Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))) < M := by
    refine lt_of_le_of_ne bot_le ?_
    intro h
    have he0 : e ∈ (⊥ : Submodule (GaloisField 2 f) _) := by rw [h]; exact heM
    exact he.2.2.1 (by simpa using he0)
  have hpos : 0 < blockDegree (bmdualmA n f S) e := by
    have hlt := Submodule.finrank_lt_finrank_of_lt hbot
    rw [finrank_bot] at hlt
    exact hlt
  omega

private theorem bmdualm_action_is_scalar
    (n f : ℕ) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hdeg : blockDegree (bmdualmA n f S) e = 1)
    {a : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (ha : a ∈ bmdualmA n f S) :
    ∃ c : GaloisField 2 f, a * e = c • e := by
  let M : Submodule (GaloisField 2 f)
      (Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :=
    (Subalgebra.toSubmodule (bmdualmA n f S)).map
      (LinearMap.mulRight (GaloisField 2 f) e)
  have hMdeg : Module.finrank (GaloisField 2 f) M = 1 := hdeg
  have heM : e ∈ M := ⟨e, he.1, by rw [LinearMap.mulRight_apply, he.2.1.eq]⟩
  have hene : (⟨e, heM⟩ : M) ≠ 0 := by
    intro h
    exact he.2.2.1 (by simpa using congrArg Subtype.val h)
  have haM : a * e ∈ M := ⟨a, ha, by rw [LinearMap.mulRight_apply]⟩
  obtain ⟨c, hc⟩ := (finrank_eq_one_iff_of_nonzero' (⟨e, heM⟩ : M) hene).mp hMdeg
    (⟨a * e, haM⟩ : M)
  exact ⟨c, by simpa using congrArg Subtype.val hc.symm⟩

private theorem bmdualm_block_scalar
    (n f : ℕ) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hdeg : blockDegree (bmdualmA n f S) e < 2) :
    blockDegree (bmdualmA n f S) e = 1 ∧
      ∀ a ∈ bmdualmA n f S, ∃ c : GaloisField 2 f, a * e = c • e := by
  have h1 := bmdualm_blockDegree_eq_one n f S he hdeg
  exact ⟨h1, fun a ha => bmdualm_action_is_scalar n f S he h1 ha⟩

private theorem bmdualm_G_symmetric (n f : ℕ) :
    Matrix.transpose (bmdualmG n f) = bmdualmG n f := by
  rw [show bmdualmG n f =
      LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin (bmdualmQ n f)) from rfl]
  exact (LinearMap.BilinForm.isSymm_toMatrix'_iff_isSymm).mpr
    (LinearMap.BilinForm.IsSymm.mk (fun x y => QuadraticMap.polar_comm _ x y))

private theorem bmdualm_G_symmetric_map (n f : ℕ) :
    Matrix.transpose ((bmdualmG n f).map (RingHom.id (GaloisField 2 f))) = bmdualmG n f := by
  rw [show (⇑(RingHom.id (GaloisField 2 f)) : GaloisField 2 f → GaloisField 2 f) = id
    from rfl, Matrix.map_id]
  exact bmdualm_G_symmetric n f

private theorem bmdualm_G_isUnit_det (n f : ℕ) :
    IsUnit (bmdualmG n f).det := by
  have hnd := Spin.nondegenerate_polarBilin_quadMinus_of_finite n (GaloisField 2 f)
    (minusCoeffs_irr 2 f)
  have h1 : bmdualmG n f =
      LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin (bmdualmQ n f)) := rfl
  rw [h1]
  exact isUnit_iff_ne_zero.mpr (Matrix.nondegenerate_iff_det_ne_zero.mp
    ((LinearMap.BilinForm.nondegenerate_toMatrix'_iff).mpr hnd))

private theorem bmdualm_spinMatrix_isometry (n f : ℕ)
    (x : ↥(spinGroup (bmdualmQ n f))) (v : bmdualmι n → GaloisField 2 f) :
    bmdualmQ n f (Matrix.mulVec ((bmdualmJ n f x : GL (bmdualmι n) (GaloisField 2 f)) :
      Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) v) = bmdualmQ n f v := by
  exact Spin.spinMatrix_mem (bmdualmQ n f) x v

private lemma bmdualm_polar_eq_dot {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (Q : QuadraticForm F (ι → F)) (x y : ι → F) :
    QuadraticMap.polar Q x y =
      dotProduct x ((LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)).mulVec y) := by
  have h1 : (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)) =
      LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin Q) := rfl
  rw [h1]
  rw [← Matrix.toBilin'_apply' (LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin Q)) x y,
    Matrix.toBilin'_toMatrix', QuadraticMap.polarBilin_apply_apply]

private lemma bmdualm_isometry_of_quad {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (Q : QuadraticForm F (ι → F)) (M : Matrix ι ι F)
    (hM : ∀ x : ι → F, Q (M.mulVec x) = Q x) :
    M.transpose * LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q) * M =
      LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q) := by
  have hpol : ∀ x y, QuadraticMap.polar Q (M.mulVec x) (M.mulVec y) =
      QuadraticMap.polar Q x y := by
    intro x y
    rw [QuadraticMap.polar, QuadraticMap.polar, ← Matrix.mulVec_add, hM (x + y), hM x, hM y]
  apply (LinearEquiv.injective Matrix.toBilin')
  apply LinearMap.ext
  intro x
  apply LinearMap.ext
  intro y
  rw [Matrix.toBilin'_apply', Matrix.toBilin'_apply']
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
    Matrix.vecMul_transpose, ← bmdualm_polar_eq_dot Q (M.mulVec x) (M.mulVec y),
    ← bmdualm_polar_eq_dot Q x y]
  exact hpol x y

private theorem bmdualm_statedSpin_isometry (n f : ℕ)
    (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ (bmdualmJ n f).range) :
    ∀ s ∈ S, Matrix.transpose ((s : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)).map
        (RingHom.id (GaloisField 2 f))) * bmdualmG n f *
      (s : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) = bmdualmG n f := by
  intro s hs
  obtain ⟨x, rfl⟩ := hSU s hs
  have hQ : ∀ v : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec
        ((bmdualmJ n f x : GL (bmdualmι n) (GaloisField 2 f)) :
          Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) v) =
        bmdualmQ n f v := bmdualm_spinMatrix_isometry n f x
  simpa [Matrix.map_id] using bmdualm_isometry_of_quad (bmdualmQ n f)
    ((bmdualmJ n f x : GL (bmdualmι n) (GaloisField 2 f)) :
      Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) hQ

private theorem bmdualm_dualPair_data
    (n f : ℕ) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ (bmdualmJ n f).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hpair : bmdualmestar n f e ≠ e) :
    e * bmdualmestar n f e = 0 ∧ bmdualmestar n f e * e = 0 ∧
      IsIdempotentElem (bmdualmeps n f e) ∧
      IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e) := by
  have hG : IsUnit (bmdualmG n f).det := bmdualm_G_isUnit_det n f
  have hGh : Matrix.transpose ((bmdualmG n f).map (RingHom.id (GaloisField 2 f))) =
      bmdualmG n f := by
    rw [show (⇑(RingHom.id (GaloisField 2 f)) : GaloisField 2 f → GaloisField 2 f) = id
      from rfl, Matrix.map_id]
    exact bmdualm_G_symmetric n f
  have hSU' := bmdualm_statedSpin_isometry n f S hSU
  obtain ⟨horth1, horth2⟩ := Geo.mul_formAdj_eq_zero_of_dualPair (RingHom.id (GaloisField 2 f))
    (fun x => rfl) hG hGh hSU' hS he hpair
  have hstar_idem : IsIdempotentElem (bmdualmestar n f e) := by
    show bmdualmestar n f e * bmdualmestar n f e = bmdualmestar n f e
    rw [← Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) hG e e, he.2.1.eq]
  have hstarA : bmdualmestar n f e ∈ bmdualmA n f S :=
    Geo.formAdj_mem_adjoin (RingHom.id (GaloisField 2 f)) hG hSU' he.1
  have hstar_ne : bmdualmestar n f e ≠ 0 := by
    intro h0
    have he0 : e = 0 := by
      calc e = formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f)
            (bmdualmestar n f e) :=
            (Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl) hG hGh e).symm
        _ = formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f) 0 := by rw [h0]
        _ = 0 := bmdualm_formAdj_zero (RingHom.id (GaloisField 2 f)) (bmdualmG n f)
    exact he.2.2.1 he0
  have hprim : ∀ e' ∈ bmdualmA n f S, IsIdempotentElem e' →
      e' * bmdualmestar n f e = e' → e' = 0 ∨ e' = bmdualmestar n f e := by
    intro e' he'A he'idem he'e
    have he'e' : bmdualmestar n f e * e' = e' := by
      rw [← (bmdualm_adjoin_comm hS e' he'A (bmdualmestar n f e) hstarA).eq, he'e]
    have hformA : formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f) e' ∈
        bmdualmA n f S :=
      Geo.formAdj_mem_adjoin (RingHom.id (GaloisField 2 f)) hG hSU' he'A
    have hformidem : IsIdempotentElem
        (formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f) e') := by
      show formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f) e' *
        formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f) e' =
        formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f) e'
      rw [← Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) hG e' e', he'idem.eq]
    have hform_eq : formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f) e' * e =
        formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f) e' := by
      have h := congrArg (formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f))
        he'e'
      rw [Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) hG (bmdualmestar n f e) e'] at h
      rwa [Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl) hG hGh e] at h
    rcases he.2.2.2 (formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f) e')
      hformA hformidem hform_eq with h0 | heq
    · left
      have h := congrArg (formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f)) h0
      rw [Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl) hG hGh e'] at h
      rw [h, bmdualm_formAdj_zero (RingHom.id (GaloisField 2 f)) (bmdualmG n f)]
    · right
      have h := congrArg (formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f)) heq
      rwa [Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl) hG hGh e'] at h
  have heps_idem : IsIdempotentElem (bmdualmeps n f e) := by
    show IsIdempotentElem (e + bmdualmestar n f e)
    refine IsIdempotentElem.add he.2.1 hstar_idem ?_
    rw [horth1, horth2, add_zero]
  exact ⟨horth1, horth2, heps_idem, hstarA, hstar_idem, hstar_ne, hprim⟩

private theorem bmdualm_generator_scalar
    (n f : ℕ) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ (bmdualmJ n f).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hdeg : blockDegree (bmdualmA n f S) e < 2) :
    bmdualm_scalarAction n f S e := by
  have hdeg1 : blockDegree (bmdualmA n f S) e = 1 :=
    (bmdualm_block_scalar n f S he hdeg).1
  intro s hs
  exact Geo.exists_eigen_of_dualPair (RingHom.id (GaloisField 2 f)) (fun x => rfl)
    (bmdualm_G_isUnit_det n f) (bmdualm_G_symmetric n f)
    (bmdualm_statedSpin_isometry n f S hSU) hS he hdeg1 hs

private theorem bmdualm_block_quad_zero
    (n f : ℕ) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ (bmdualmJ n f).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hpair : bmdualmestar n f e ≠ e)
    (hdeg : blockDegree (bmdualmA n f S) e < 2) :
    ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0 := by
  have hdeg1 : blockDegree (bmdualmA n f S) e = 1 :=
    (bmdualm_block_scalar n f S he hdeg).1
  obtain ⟨s, hs, c, hse, hc⟩ := Geo.exists_eigen_mul_ne_one_of_dualPair
    (RingHom.id (GaloisField 2 f)) (fun x => rfl) (bmdualm_G_isUnit_det n f)
    (bmdualm_G_symmetric n f) (bmdualm_statedSpin_isometry n f S hSU) hS he hdeg1
        hpair
  intro x
  obtain ⟨u, rfl⟩ := hSU s hs
  have hiso : bmdualmQ n f (Matrix.mulVec
      ((bmdualmJ n f u : GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) (Matrix.mulVec e x)) =
      bmdualmQ n f (Matrix.mulVec e x) :=
    bmdualm_spinMatrix_isometry n f u (Matrix.mulVec e x)
  have hsm : Matrix.mulVec ((bmdualmJ n f u :
      GL (bmdualmι n) (GaloisField 2 f)) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
      (Matrix.mulVec e x) = c • Matrix.mulVec e x := by
    rw [Matrix.mulVec_mulVec, hse, Matrix.smul_mulVec]
  rw [hsm] at hiso
  have hiso' : c ^ 2 * bmdualmQ n f (Matrix.mulVec e x) =
      bmdualmQ n f (Matrix.mulVec e x) := by
    simpa [QuadraticMap.map_smul, smul_eq_mul, pow_two] using hiso
  have hcne : c ^ 2 - 1 ≠ 0 := sub_ne_zero.mpr (by rwa [pow_two])
  have hsub : (c ^ 2 - 1) * bmdualmQ n f (Matrix.mulVec e x) = 0 := by
    rw [sub_mul, one_mul, hiso', sub_self]
  exact (mul_eq_zero.mp hsub).resolve_left hcne

private theorem bmdualm_star_block_quad_zero
    (n f : ℕ) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ (bmdualmJ n f).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hpair : bmdualmestar n f e ≠ e)
    (hdeg : blockDegree (bmdualmA n f S) e < 2) :
    ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0 := by
  have hdeg1 : blockDegree (bmdualmA n f S) e = 1 :=
    (bmdualm_block_scalar n f S he hdeg).1
  obtain ⟨s, hs, c, hse, hc⟩ := Geo.exists_eigen_mul_ne_one_of_dualPair
    (RingHom.id (GaloisField 2 f)) (fun x => rfl) (bmdualm_G_isUnit_det n f)
    (bmdualm_G_symmetric n f) (bmdualm_statedSpin_isometry n f S hSU) hS he hdeg1
        hpair
  obtain ⟨c', hc'0, hse', hse'star⟩ := Geo.exists_eigen_of_dualPair
    (RingHom.id (GaloisField 2 f)) (fun x => rfl) (bmdualm_G_isUnit_det n f)
    (bmdualm_G_symmetric n f) (bmdualm_statedSpin_isometry n f S hSU) hS he hdeg1 hs
  have hcc : c = c' := by
    have h : (c - c') • e = 0 := by rw [sub_smul, ← hse, hse', sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp h).resolve_right he.2.2.1)
  have hstar : s * bmdualmestar n f e = c⁻¹ • bmdualmestar n f e := by
    rw [← hcc] at hse'star; exact hse'star
  intro x
  obtain ⟨u, rfl⟩ := hSU s hs
  have hiso : bmdualmQ n f (Matrix.mulVec
      ((bmdualmJ n f u : GL (bmdualmι n) (GaloisField 2 f)) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
      (Matrix.mulVec (bmdualmestar n f e) x)) =
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) :=
    bmdualm_spinMatrix_isometry n f u (Matrix.mulVec (bmdualmestar n f e) x)
  have hsm : Matrix.mulVec ((bmdualmJ n f u :
      GL (bmdualmι n) (GaloisField 2 f)) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
      (Matrix.mulVec (bmdualmestar n f e) x) = c⁻¹ • Matrix.mulVec (bmdualmestar n f e) x := by
    rw [Matrix.mulVec_mulVec, hstar, Matrix.smul_mulVec]
  rw [hsm] at hiso
  have hiso' : (c⁻¹) ^ 2 * bmdualmQ n f
      (Matrix.mulVec (bmdualmestar n f e) x) =
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) := by
    simpa [QuadraticMap.map_smul, smul_eq_mul, pow_two, mul_inv_rev] using hiso
  have hc1 : c ≠ 1 := fun h => hc (by simp [h])
  have hcne : (c⁻¹) ^ 2 - 1 ≠ 0 := by
    have hne : c⁻¹ - 1 ≠ 0 := sub_ne_zero.mpr (fun h => hc1 (inv_eq_one.mp h))
    have hsq : (c⁻¹) ^ 2 - 1 = (c⁻¹ - 1) ^ 2 := by
      rw [CharTwo.sub_eq_add, CharTwo.sub_eq_add, add_sq,
        show (2 : GaloisField 2 f) = 0 from CharP.cast_eq_zero _ 2]
      ring
    rw [hsq]
    exact pow_ne_zero 2 hne
  have hsub : ((c⁻¹) ^ 2 - 1) * bmdualmQ n f
      (Matrix.mulVec (bmdualmestar n f e) x) = 0 := by
    rw [sub_mul, one_mul, hiso', sub_self]
  exact (mul_eq_zero.mp hsub).resolve_left hcne

private noncomputable abbrev bmdualm_D0 (r r' : ℕ) (F : Type) [Zero F] [One F] :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F :=
  Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) F)
    (0 : Matrix (Fin r) (Fin r ⊕ Fin r') F)
    (0 : Matrix (Fin r ⊕ Fin r') (Fin r) F)
    (Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
      (0 : Matrix (Fin r) (Fin r') F) (0 : Matrix (Fin r') (Fin r) F)
      (0 : Matrix (Fin r') (Fin r') F))

private noncomputable def bmdualm_blockMat (n f r r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f) :=
  Matrix.fromBlocks (x : Matrix (Fin r) (Fin r) (GaloisField 2 f))
    (0 : Matrix (Fin r) (Fin r ⊕ Fin r') (GaloisField 2 f))
    (0 : Matrix (Fin r ⊕ Fin r') (Fin r) (GaloisField 2 f))
    (Matrix.fromBlocks
      (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
        Matrix (Fin r) (Fin r) (GaloisField 2 f)))
      (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))

private theorem bmdualm_dualMap_apply_zero (n f r : ℕ)
    (We : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (c : Module.Dual (GaloisField 2 f) (Fin r → GaloisField 2 f))
    (hc : (Matrix.mulVecLin (Matrix.transpose We * bmdualmG n f)).dualMap c = 0) :
    ∀ v : bmdualmι n → GaloisField 2 f,
      c (Matrix.mulVec (Matrix.transpose We * bmdualmG n f) v) = 0 := by
  intro v
  have h := DFunLike.congr_fun hc v
  simpa only [LinearMap.dualMap_apply, Matrix.mulVecLin_apply, LinearMap.zero_apply] using h

private theorem bmdualm_dualMap_ker_vec (n f r : ℕ)
    (We : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (c : Module.Dual (GaloisField 2 f) (Fin r → GaloisField 2 f))
    (hc : ∀ v : bmdualmι n → GaloisField 2 f,
      c (Matrix.mulVec (Matrix.transpose We * bmdualmG n f) v) = 0) :
    Matrix.mulVec We (fun j => c (Pi.single j 1)) = 0 := by
  ext i
  have h := hc (Matrix.mulVec (bmdualmG n f)⁻¹ (Pi.single i 1))
  have h1 : Matrix.mulVec (Matrix.transpose We * bmdualmG n f)
        (Matrix.mulVec (bmdualmG n f)⁻¹ (Pi.single i 1)) =
      Matrix.mulVec (Matrix.transpose We) (Pi.single i 1) := by
    rw [Matrix.mulVec_mulVec, Matrix.mul_assoc,
      Matrix.mul_nonsing_inv _ (bmdualm_G_isUnit_det n f), Matrix.mul_one]
  rw [h1] at h
  have h2 : (Matrix.mulVec We (fun j => c (Pi.single j 1))) i =
      c (Matrix.mulVec (Matrix.transpose We) (Pi.single i 1)) := by
    rw [show Matrix.mulVec (Matrix.transpose We) (Pi.single i 1) =
        ∑ j, We i j • Pi.single j 1 from by
      ext k
      simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply, Finset.sum_apply,
        Pi.smul_apply, smul_eq_mul]
      rw [Fintype.sum_eq_single i (fun m hm => by simp [Pi.single_eq_of_ne hm])]
      rw [Fintype.sum_eq_single k (fun m hm => by simp [Pi.single_eq_of_ne (Ne.symm hm)])]
      simp]
    rw [map_sum]
    simp only [map_smul, Matrix.mulVec, dotProduct]
    apply Finset.sum_congr rfl
    intro j _
    ring
  rw [h2]
  exact h

private theorem bmdualm_dualMap_injective (n f r : ℕ)
    (We : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hinj : Function.Injective (fun c : Fin r → GaloisField 2 f => Matrix.mulVec We c)) :
    Function.Injective (Matrix.mulVecLin (Matrix.transpose We * bmdualmG n f)).dualMap := by
  intro c c' hcc
  have hzero : Matrix.mulVec We (fun j => (c - c') (Pi.single j 1)) = 0 := by
    apply bmdualm_dualMap_ker_vec n f r We (c - c')
    intro v
    have h : (Matrix.mulVecLin (Matrix.transpose We * bmdualmG n f)).dualMap (c - c')
        = 0 := by
      rw [map_sub, hcc, sub_self]
    exact bmdualm_dualMap_apply_zero n f r We (c - c') h v
  have hcvec : (fun j => (c - c') (Pi.single j 1)) = 0 := by
    apply hinj
    simpa using hzero
  have hsub : c - c' = 0 := by
    apply LinearMap.ext
    intro w
    have hw : w = ∑ j, w j • Pi.single j 1 := by
      ext k
      rw [Finset.sum_apply]
      simp only [Pi.smul_apply, smul_eq_mul]
      rw [Fintype.sum_eq_single k (fun m hm => by simp [Pi.single_eq_of_ne (Ne.symm hm)])]
      simp
    rw [hw, map_sum]
    apply Finset.sum_eq_zero
    intro j _
    rw [map_smul, congrFun hcvec j]
    simp
  exact sub_eq_zero.mp hsub

private theorem bmdualm_mulVec_transpose_surjective (n f r : ℕ)
    (We : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hinj : Function.Injective (fun c : Fin r → GaloisField 2 f => Matrix.mulVec We c)) :
    Function.Surjective (fun v : bmdualmι n → GaloisField 2 f =>
      Matrix.mulVec (Matrix.transpose We * bmdualmG n f) v) := by
  change Function.Surjective (Matrix.mulVecLin (Matrix.transpose We * bmdualmG n f))
  rw [← LinearMap.dualMap_injective_iff]
  exact bmdualm_dualMap_injective n f r We hinj

private theorem bmdualm_exists_rightInverse_of_columns (n f r : ℕ)
    (We : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hinj : Function.Injective (fun c : Fin r → GaloisField 2 f => Matrix.mulVec We c)) :
    ∃ V : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f),
      Matrix.transpose We * bmdualmG n f * V = 1 :=
  Matrix.mulVec_surjective_iff_exists_right_inverse.mp
    (bmdualm_mulVec_transpose_surjective n f r We hinj)

private theorem bmdualm_estar_mul_dual (n f r : ℕ)
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (We V : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hWe : e * We = We) (hV : Matrix.transpose We * bmdualmG n f * V = 1)
    (hstar : bmdualmestar n f e * bmdualmestar n f e = bmdualmestar n f e) :
    bmdualmestar n f e * (bmdualmestar n f e * V) = bmdualmestar n f e * V ∧
      Matrix.transpose We * bmdualmG n f * (bmdualmestar n f e * V) = 1 := by
  have hestar : bmdualmestar n f e = (bmdualmG n f)⁻¹ * Matrix.transpose e * bmdualmG n f := by
    simp only [bmdualmestar, formAdj]
    rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
      congrArg Matrix.transpose (Matrix.map_id e)]
  have hJ : bmdualmG n f * bmdualmestar n f e = Matrix.transpose e * bmdualmG n f := by
    rw [hestar]
    calc bmdualmG n f * ((bmdualmG n f)⁻¹ * Matrix.transpose e *
        bmdualmG n f)
        = (bmdualmG n f * (bmdualmG n f)⁻¹) * (Matrix.transpose e *
            bmdualmG n f) := by
          noncomm_ring
      _ = Matrix.transpose e * bmdualmG n f := by
          rw [Matrix.mul_nonsing_inv _ (bmdualm_G_isUnit_det n f), Matrix.one_mul]
  have hWs : Matrix.transpose We * bmdualmG n f * bmdualmestar n f e =
      Matrix.transpose We * bmdualmG n f := by
    calc Matrix.transpose We * bmdualmG n f * bmdualmestar n f e
        = Matrix.transpose We * (bmdualmG n f * bmdualmestar n f e) := by rw
            [Matrix.mul_assoc]
      _ = Matrix.transpose We * (Matrix.transpose e * bmdualmG n f) := by rw [hJ]
      _ = (Matrix.transpose We * Matrix.transpose e) * bmdualmG n f := by rw
          [Matrix.mul_assoc]
      _ = Matrix.transpose (e * We) * bmdualmG n f := by rw [← Matrix.transpose_mul]
      _ = Matrix.transpose We * bmdualmG n f := by rw [hWe]
  constructor
  · rw [← Matrix.mul_assoc, hstar]
  · rw [← Matrix.mul_assoc, hWs, hV]

private noncomputable def bmdualm_blockCols {n f r : ℕ}
    (We Ws : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f)) :
    Matrix (bmdualmι n) (Fin r ⊕ Fin r) (GaloisField 2 f) :=
  Matrix.of fun i j => Sum.elim (fun a => We i a) (fun b => Ws i b) j

private theorem bmdualm_adapted_Pe_form_11 (n f r : ℕ)
    (We Ws : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hWeIso : Matrix.transpose We * bmdualmG n f * We = 0) (a a' : Fin r) :
    (Matrix.transpose (bmdualm_blockCols We Ws) * bmdualmG n f * bmdualm_blockCols We
        Ws)
        (Sum.inl a) (Sum.inl a') = bmdualmGp r f (Sum.inl a) (Sum.inl a') := by
  have h := congrFun (congrFun hWeIso a) a'
  simp only [Matrix.zero_apply] at h
  rw [show bmdualmGp r f (Sum.inl a) (Sum.inl a') = 0 from by
    simp [bmdualmG, Matrix.fromBlocks, Spin.polar_quadPlus, Pi.single_apply, Finset.sum_ite_eq',
        Matrix.one_apply,
      Sum.inl_injective.eq_iff, Sum.inr_injective.eq_iff, eq_comm]]
  rw [← h]
  simp only [bmdualm_blockCols, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Finset.sum_apply, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr]

private theorem bmdualm_adapted_Pe_form_12 (n f r : ℕ)
    (We Ws : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hdual : Matrix.transpose We * bmdualmG n f * Ws = 1) (a b : Fin r) :
    (Matrix.transpose (bmdualm_blockCols We Ws) * bmdualmG n f * bmdualm_blockCols We
        Ws)
        (Sum.inl a) (Sum.inr b) = bmdualmGp r f (Sum.inl a) (Sum.inr b) := by
  have h := congrFun (congrFun hdual a) b
  rw [show bmdualmGp r f (Sum.inl a) (Sum.inr b) =
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) a b from by
    simp [bmdualmG, Matrix.fromBlocks, Spin.polar_quadPlus, Pi.single_apply, Finset.sum_ite_eq',
        Matrix.one_apply,
      Sum.inl_injective.eq_iff, Sum.inr_injective.eq_iff, eq_comm]]
  rw [← h]
  simp only [bmdualm_blockCols, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Finset.sum_apply, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr]

private theorem bmdualm_adapted_Pe_form_21 (n f r : ℕ)
    (We Ws : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hdual : Matrix.transpose We * bmdualmG n f * Ws = 1) (b a : Fin r) :
    (Matrix.transpose (bmdualm_blockCols We Ws) * bmdualmG n f * bmdualm_blockCols We
        Ws)
        (Sum.inr b) (Sum.inl a) = bmdualmGp r f (Sum.inr b) (Sum.inl a) := by
  have htrans : Matrix.transpose Ws * bmdualmG n f * We = 1 := by
    have h := congrArg Matrix.transpose hdual
    simpa [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.transpose_one,
      bmdualm_G_symmetric, Matrix.mul_assoc] using h
  have h' := congrFun (congrFun htrans b) a
  have hR : bmdualmGp r f (Sum.inr b) (Sum.inl a) =
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) b a := by
    simp [bmdualmG, Matrix.fromBlocks, Matrix.neg_apply, Matrix.one_apply, CharTwo.neg_eq,
      Spin.polar_quadPlus, Pi.single_apply, Finset.sum_ite_eq, ite_mul, zero_mul,
      Sum.inl_injective.eq_iff, Sum.inr_injective.eq_iff, eq_comm]
  rw [hR, ← h']
  simp only [bmdualm_blockCols, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Finset.sum_apply, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr, Pi.single_apply,
    Finset.sum_ite_eq, ite_mul, zero_mul, Matrix.one_apply, Sum.inl_injective.eq_iff,
    Sum.inr_injective.eq_iff, eq_comm]

private theorem bmdualm_adapted_Pe_form_22 (n f r : ℕ)
    (We Ws : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hWsIso : Matrix.transpose Ws * bmdualmG n f * Ws = 0) (b b' : Fin r) :
    (Matrix.transpose (bmdualm_blockCols We Ws) * bmdualmG n f * bmdualm_blockCols We
        Ws)
        (Sum.inr b) (Sum.inr b') = bmdualmGp r f (Sum.inr b) (Sum.inr b') := by
  have h := congrFun (congrFun hWsIso b) b'
  simp only [Matrix.zero_apply] at h
  rw [show bmdualmGp r f (Sum.inr b) (Sum.inr b') = 0 from by
    simp [bmdualmG, Matrix.fromBlocks, Spin.polar_quadPlus, Pi.single_apply, Finset.sum_ite_eq',
        Matrix.one_apply,
      Sum.inl_injective.eq_iff, Sum.inr_injective.eq_iff, eq_comm]]
  rw [← h]
  simp only [bmdualm_blockCols, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Finset.sum_apply, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr]

private theorem bmdualm_adapted_Pe_form (n f r : ℕ)
    (We Ws : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hdual : Matrix.transpose We * bmdualmG n f * Ws = 1)
    (hWeIso : Matrix.transpose We * bmdualmG n f * We = 0)
    (hWsIso : Matrix.transpose Ws * bmdualmG n f * Ws = 0) :
    Matrix.transpose (bmdualm_blockCols We Ws) * bmdualmG n f * bmdualm_blockCols We Ws
        =
      bmdualmGp r f := by
  ext j j'
  rcases j with a | b <;> rcases j' with a' | b'
  · exact bmdualm_adapted_Pe_form_11 n f r We Ws hWeIso a a'
  · exact bmdualm_adapted_Pe_form_12 n f r We Ws hdual a b'
  · exact bmdualm_adapted_Pe_form_21 n f r We Ws hdual b a'
  · exact bmdualm_adapted_Pe_form_22 n f r We Ws hWsIso b b'

private theorem bmdualm_adapted_Pe_diag (n f r : ℕ)
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (We Ws : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hWe : e * We = We) (hWs : bmdualmestar n f e * Ws = Ws)
    (heWs : e * Ws = 0) (hesWe : bmdualmestar n f e * We = 0) :
    e * bmdualm_blockCols We Ws =
        bmdualm_blockCols We Ws * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) ∧
      bmdualmestar n f e * bmdualm_blockCols We Ws =
        bmdualm_blockCols We Ws * Matrix.fromBlocks
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) := by
  constructor
  · ext i j
    rcases j with a | b
    · rw [Matrix.mul_apply]
      have hR : (bmdualm_blockCols We Ws * Matrix.fromBlocks
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) i (Sum.inl a) = We i a := by
        rw [Matrix.mul_apply]
        rw [Fintype.sum_eq_single (Sum.inl a) (fun k hk => by
          rcases k with c | d
          · have hca : c ≠ a := fun h => hk (by rw [h])
            simp [bmdualm_blockCols, Matrix.of_apply, Sum.elim_inl, Matrix.fromBlocks,
              Matrix.one_apply, hca]
          · simp [bmdualm_blockCols, Matrix.of_apply, Sum.elim_inr, Matrix.fromBlocks])]
        simp [bmdualm_blockCols, Matrix.fromBlocks]
      rw [hR]
      simp only [bmdualm_blockCols, Matrix.of_apply, Sum.elim_inl]
      rw [← Matrix.mul_apply, hWe]
    · rw [Matrix.mul_apply]
      have hR : (bmdualm_blockCols We Ws * Matrix.fromBlocks
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) i (Sum.inr b) =
            (0 : GaloisField 2 f) := by
        rw [Matrix.mul_apply]
        apply Finset.sum_eq_zero
        intro k _
        rcases k with c | d <;> simp [bmdualm_blockCols, Matrix.of_apply, Sum.elim_inl,
          Sum.elim_inr, Matrix.fromBlocks]
      rw [hR]
      simp only [bmdualm_blockCols, Matrix.of_apply, Sum.elim_inr]
      rw [← Matrix.mul_apply, heWs]
      simp
  · ext i j
    rcases j with a | b
    · rw [Matrix.mul_apply]
      have hR : (bmdualm_blockCols We Ws * Matrix.fromBlocks
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) i (Sum.inl a) =
            (0 : GaloisField 2 f) := by
        rw [Matrix.mul_apply]
        apply Finset.sum_eq_zero
        intro k _
        rcases k with c | d <;> simp [bmdualm_blockCols, Matrix.of_apply, Sum.elim_inl,
          Sum.elim_inr, Matrix.fromBlocks]
      rw [hR]
      simp only [bmdualm_blockCols, Matrix.of_apply, Sum.elim_inl]
      rw [← Matrix.mul_apply, hesWe]
      simp
    · rw [Matrix.mul_apply]
      have hR : (bmdualm_blockCols We Ws * Matrix.fromBlocks
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) i (Sum.inr b) = Ws i b := by
        rw [Matrix.mul_apply]
        rw [Fintype.sum_eq_single (Sum.inr b) (fun k hk => by
          rcases k with c | d
          · simp [bmdualm_blockCols, Matrix.of_apply, Sum.elim_inl, Matrix.fromBlocks]
          · have hdb : d ≠ b := fun h => hk (by rw [h])
            simp [bmdualm_blockCols, Matrix.of_apply, Sum.elim_inr, Matrix.fromBlocks,
              Matrix.one_apply, hdb])]
        simp [bmdualm_blockCols, Matrix.fromBlocks]
      rw [hR]
      simp only [bmdualm_blockCols, Matrix.of_apply, Sum.elim_inr]
      rw [← Matrix.mul_apply, hWs]

private theorem bmdualm_adapted_Pe_eps (n f r : ℕ)
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (We Ws : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hdE : e * bmdualm_blockCols We Ws =
        bmdualm_blockCols We Ws * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hdS : bmdualmestar n f e * bmdualm_blockCols We Ws =
        bmdualm_blockCols We Ws * Matrix.fromBlocks
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) :
    bmdualmeps n f e * bmdualm_blockCols We Ws = bmdualm_blockCols We Ws := by
  rw [bmdualmeps, Matrix.add_mul, hdE, hdS, ← Matrix.mul_add]
  rw [show Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) +
      Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) = 1 from by
    rw [Matrix.fromBlocks_add]
    ext i j
    rcases i with i | i <;> rcases j with j | j <;>
      simp [Matrix.fromBlocks, Matrix.one_apply, Matrix.add_apply]]
  rw [Matrix.mul_one]

private theorem bmdualm_e_mul_Ws_zero (n f r : ℕ)
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (Ws : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hWs : bmdualmestar n f e * Ws = Ws) (horth : e * bmdualmestar n f e = 0) :
    e * Ws = 0 := by
  rw [← hWs, ← Matrix.mul_assoc, horth, Matrix.zero_mul]

private theorem bmdualm_estar_mul_We_zero (n f r : ℕ)
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (We : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hWe : e * We = We) (horth' : bmdualmestar n f e * e = 0) :
    bmdualmestar n f e * We = 0 := by
  rw [← hWe, ← Matrix.mul_assoc, horth', Matrix.zero_mul]

private theorem bmdualm_exists_basis_range_e_span
    (n f : ℕ) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e) :
    ∃ (r : ℕ) (We : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f)),
      e * We = We ∧
      Function.Injective (fun c : Fin r → GaloisField 2 f => Matrix.mulVec We c) ∧
      (∀ x : bmdualmι n → GaloisField 2 f,
        Matrix.mulVec e x ∈ LinearMap.range (Matrix.mulVecLin We)) ∧
      Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin e)) = r := by
  classical
  let W : Submodule (GaloisField 2 f) (bmdualmι n → GaloisField 2 f) :=
    LinearMap.range (Matrix.mulVecLin e)
  let r : ℕ := Module.finrank (GaloisField 2 f) W
  let b : Module.Basis (Fin r) (GaloisField 2 f) W := Module.finBasis (GaloisField 2 f) W
  let We : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f) :=
    Matrix.of fun i j => (b j : bmdualmι n → GaloisField 2 f) i
  have hmulVec_e : ∀ v ∈ W, Matrix.mulVec e v = v := by
    intro v hv
    obtain ⟨u, hu⟩ := hv
    rw [Matrix.mulVecLin_apply] at hu
    rw [← hu, Matrix.mulVec_mulVec, he.2.1.eq]
  refine ⟨r, We, ?_, ?_, ?_, ?_⟩
  · ext i j
    have hfix : Matrix.mulVec e (b j : bmdualmι n → GaloisField 2 f) =
        (b j : bmdualmι n → GaloisField 2 f) := hmulVec_e (b j) (b j).2
    rw [Matrix.mul_apply]
    trans (Matrix.mulVec e (b j : bmdualmι n → GaloisField 2 f)) i
    · simp [Matrix.mulVec, dotProduct, We]
    · rw [hfix]
      simp [We]
  · intro c c' hcc
    funext j
    have hW : (∑ k, c k • (b k : W)) = (∑ k, c' k • (b k : W)) := by
      apply Subtype.ext
      ext i
      have h := congrFun hcc i
      simp only [Matrix.mulVec, dotProduct, We, Submodule.coe_sum, Submodule.coe_smul,
        Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at h ⊢
      have h1 : (∑ k, c k * (b k : bmdualmι n → GaloisField 2 f) i) =
          ∑ k, (b k : bmdualmι n → GaloisField 2 f) i * c k :=
        Finset.sum_congr rfl fun k _ => mul_comm _ _
      have h2 : (∑ k, c' k * (b k : bmdualmι n → GaloisField 2 f) i) =
          ∑ k, (b k : bmdualmι n → GaloisField 2 f) i * c' k :=
        Finset.sum_congr rfl fun k _ => mul_comm _ _
      rw [h1, h2]
      exact h
    exact (Fintype.linearIndependent_iffₛ.mp b.linearIndependent) c c' hW j
  · intro x
    refine ⟨fun k => b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k, ?_⟩
    rw [Matrix.mulVecLin_apply]
    have h' := congrArg Subtype.val (b.sum_repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩)
    have hrepr : (∑ k, b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k •
        (b k : bmdualmι n → GaloisField 2 f)) = Matrix.mulVec e x := by
      have h'' : (∑ k, b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k •
            (b k : bmdualmι n → GaloisField 2 f)) =
          ((∑ k, b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k • b k : W) :
            bmdualmι n → GaloisField 2 f) := by
        simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply]
      rw [h'']
      exact h'
    trans (∑ k, b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k •
        (b k : bmdualmι n → GaloisField 2 f))
    · ext i
      simp [Matrix.mulVec, dotProduct, We, Finset.sum_apply, mul_comm]
    · exact hrepr
  · rfl

private theorem bmdualm_finrank_range_mulVecLin_eq_rank (f : ℕ) {ι : Type*} [Fintype ι]
    (M : Matrix ι ι (GaloisField 2 f)) :
    M.rank = Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin M)) := by
  rw [← Matrix.rank_transpose M, Matrix.rank_eq_finrank_span_row (Matrix.transpose M),
    Matrix.row_transpose, ← Matrix.range_mulVecLin M]

private theorem bmdualm_estar_eq_conj_transpose (n f : ℕ)
    (e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :
    bmdualmestar n f e = (bmdualmG n f)⁻¹ * Matrix.transpose e * bmdualmG n f := by
  simp only [bmdualmestar, formAdj]
  rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
    congrArg Matrix.transpose (Matrix.map_id e)]

private theorem bmdualm_rank_estar_eq_rank (n f : ℕ)
    (e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :
    (bmdualmestar n f e).rank = e.rank := by
  rw [bmdualm_estar_eq_conj_transpose n f e]
  rw [Matrix.rank_mul_eq_left_of_isUnit_det (bmdualmG n f)
      ((bmdualmG n f)⁻¹ * Matrix.transpose e) (bmdualm_G_isUnit_det n f)]
  rw [Matrix.rank_mul_eq_right_of_isUnit_det (bmdualmG n f)⁻¹ (Matrix.transpose e)
      (Matrix.isUnit_nonsing_inv_det (A := bmdualmG n f) (bmdualm_G_isUnit_det n f))]
  rw [Matrix.rank_transpose]

private theorem bmdualm_estar_range_finrank (n f : ℕ)
    (e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) :
    Module.finrank (GaloisField 2 f)
        (LinearMap.range (Matrix.mulVecLin (bmdualmestar n f e))) =
      Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin e)) := by
  rw [← bmdualm_finrank_range_mulVecLin_eq_rank f (bmdualmestar n f e),
      ← bmdualm_finrank_range_mulVecLin_eq_rank f e, bmdualm_rank_estar_eq_rank]

private theorem bmdualm_dual_bases_ws_span (n f r : ℕ)
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (We V : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hr : Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin e)) = r)
    (hdual : Matrix.transpose We * bmdualmG n f * (bmdualmestar n f e * V) = 1) :
    ∀ x : bmdualmι n → GaloisField 2 f,
      Matrix.mulVec (bmdualmestar n f e) x ∈
        LinearMap.range (Matrix.mulVecLin (bmdualmestar n f e * V)) := by
  have hinj : Function.Injective (Matrix.mulVecLin (bmdualmestar n f e * V)) := by
    intro c c' hcc
    have h3 : Matrix.mulVecLin (Matrix.transpose We * bmdualmG n f)
        (Matrix.mulVecLin (bmdualmestar n f e * V) c) =
        Matrix.mulVecLin (Matrix.transpose We * bmdualmG n f)
        (Matrix.mulVecLin (bmdualmestar n f e * V) c') := by
      rw [hcc]
    have h4 : Matrix.mulVecLin (Matrix.transpose We * bmdualmG n f * (bmdualmestar n f
        e * V)) c =
        Matrix.mulVecLin (Matrix.transpose We * bmdualmG n f * (bmdualmestar n f e *
            V)) c' := by
      simpa only [Matrix.mulVecLin_mul, LinearMap.comp_apply] using h3
    rw [hdual, Matrix.mulVecLin_one] at h4
    simpa using h4
  have hfinV : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (bmdualmestar n f e * V))) = r := by
    have hker : (Matrix.mulVecLin (bmdualmestar n f e * V)).ker = ⊥ :=
      LinearMap.ker_eq_bot.mpr hinj
    have h := LinearMap.finrank_range_add_finrank_ker (Matrix.mulVecLin (bmdualmestar n f e * V))
    rw [hker, finrank_bot, add_zero, Module.finrank_fintype_fun_eq_card, Fintype.card_fin] at h
    exact h
  have hle : LinearMap.range (Matrix.mulVecLin (bmdualmestar n f e * V)) ≤
      LinearMap.range (Matrix.mulVecLin (bmdualmestar n f e)) := by
    rintro y ⟨c, rfl⟩
    exact ⟨Matrix.mulVec V c, by simp only [Matrix.mulVecLin_mul, LinearMap.comp_apply,
      Matrix.mulVecLin_apply]⟩
  have hfinE : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (bmdualmestar n f e))) = r := by
    rw [bmdualm_estar_range_finrank n f e, hr]
  have heq := Submodule.eq_of_le_of_finrank_eq hle (by rw [hfinV, hfinE])
  intro x
  rw [heq]
  exact ⟨x, rfl⟩

private theorem bmdualm_exists_dual_bases_e_span
    (n f : ℕ) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e)) :
    ∃ (r : ℕ) (We Ws : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f)),
      e * We = We ∧ bmdualmestar n f e * Ws = Ws ∧
      Matrix.transpose We * bmdualmG n f * Ws = 1 ∧
      (∀ x : bmdualmι n → GaloisField 2 f,
        Matrix.mulVec e x ∈ LinearMap.range (Matrix.mulVecLin We)) ∧
      (∀ x : bmdualmι n → GaloisField 2 f,
        Matrix.mulVec (bmdualmestar n f e) x ∈ LinearMap.range (Matrix.mulVecLin Ws)) ∧
      Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin e)) = r := by
  obtain ⟨r, We, hWe, hinj, hWeSpan, hr⟩ :=
    bmdualm_exists_basis_range_e_span n f S he
  obtain ⟨V, hV⟩ := bmdualm_exists_rightInverse_of_columns n f r We hinj
  obtain ⟨hWs, hdual⟩ :=
    bmdualm_estar_mul_dual n f r We V hWe hV hestar.2.1.eq
  refine ⟨r, We, bmdualmestar n f e * V, hWe, hWs, hdual, hWeSpan, ?_, hr⟩
  intro x
  exact bmdualm_dual_bases_ws_span n f r We V hr hdual x

private theorem bmdualm_blockCols_range {n f r : ℕ}
    (We Ws : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f)) :
    LinearMap.range (Matrix.mulVecLin (bmdualm_blockCols We Ws)) =
      LinearMap.range (Matrix.mulVecLin We) ⊔ LinearMap.range (Matrix.mulVecLin Ws) := by
  rw [Matrix.range_mulVecLin, Matrix.range_mulVecLin, Matrix.range_mulVecLin]
  have hcol : Set.range (bmdualm_blockCols We Ws).col = Set.range We.col ∪ Set.range Ws.col := by
    ext v
    constructor
    · rintro ⟨j, rfl⟩
      rcases j with a | b
      · exact Or.inl ⟨a, rfl⟩
      · exact Or.inr ⟨b, rfl⟩
    · rintro (⟨a, rfl⟩ | ⟨b, rfl⟩)
      · exact ⟨Sum.inl a, rfl⟩
      · exact ⟨Sum.inr b, rfl⟩
  rw [hcol, Submodule.span_union]

private theorem bmdualm_We_iso (n f r : ℕ)
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (We : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hWe : e * We = We) (horth' : bmdualmestar n f e * e = 0) :
    Matrix.transpose We * bmdualmG n f * We = 0 := by
  have hJ : bmdualmG n f * bmdualmestar n f e = Matrix.transpose e * bmdualmG n f := by
    simp only [bmdualmestar, formAdj]
    rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
      congrArg Matrix.transpose (Matrix.map_id e)]
    calc bmdualmG n f * ((bmdualmG n f)⁻¹ * Matrix.transpose e *
        bmdualmG n f)
        = (bmdualmG n f * (bmdualmG n f)⁻¹) * (Matrix.transpose e *
            bmdualmG n f) := by
          noncomm_ring
      _ = Matrix.transpose e * bmdualmG n f := by
          rw [Matrix.mul_nonsing_inv _ (bmdualm_G_isUnit_det n f), Matrix.one_mul]
  have heJe : Matrix.transpose e * bmdualmG n f * e = 0 := by
    rw [← hJ, Matrix.mul_assoc, horth', Matrix.mul_zero]
  calc Matrix.transpose We * bmdualmG n f * We
      = Matrix.transpose (e * We) * bmdualmG n f * (e * We) := by rw [hWe]
    _ = Matrix.transpose We * (Matrix.transpose e * bmdualmG n f * e) * We := by
        rw [Matrix.transpose_mul]
        simp only [Matrix.mul_assoc]
    _ = 0 := by rw [heJe, Matrix.mul_zero, Matrix.zero_mul]

private theorem bmdualm_Ws_iso (n f r : ℕ)
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (Ws : Matrix (bmdualmι n) (Fin r) (GaloisField 2 f))
    (hWs : bmdualmestar n f e * Ws = Ws) (horth : e * bmdualmestar n f e = 0) :
    Matrix.transpose Ws * bmdualmG n f * Ws = 0 := by
  have hJ : bmdualmG n f * bmdualmestar n f e = Matrix.transpose e * bmdualmG n f := by
    simp only [bmdualmestar, formAdj]
    rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
      congrArg Matrix.transpose (Matrix.map_id e)]
    calc bmdualmG n f * ((bmdualmG n f)⁻¹ * Matrix.transpose e *
        bmdualmG n f)
        = (bmdualmG n f * (bmdualmG n f)⁻¹) * (Matrix.transpose e *
            bmdualmG n f) := by
          noncomm_ring
      _ = Matrix.transpose e * bmdualmG n f := by
          rw [Matrix.mul_nonsing_inv _ (bmdualm_G_isUnit_det n f), Matrix.one_mul]
  have hJstar : Matrix.transpose (bmdualmestar n f e) * bmdualmG n f = bmdualmG n f * e := by
    have h := congrArg Matrix.transpose hJ
    simpa [Matrix.transpose_mul, Matrix.transpose_transpose, bmdualm_G_symmetric] using h
  have hesJes : Matrix.transpose (bmdualmestar n f e) * bmdualmG n f * bmdualmestar n f
      e = 0 := by
    rw [hJstar, Matrix.mul_assoc, horth, Matrix.mul_zero]
  calc Matrix.transpose Ws * bmdualmG n f * Ws
      = Matrix.transpose (bmdualmestar n f e * Ws) * bmdualmG n f *
          (bmdualmestar n f e * Ws) := by rw [hWs]
    _ = Matrix.transpose Ws * (Matrix.transpose (bmdualmestar n f e) * bmdualmG n f *
          bmdualmestar n f e) * Ws := by
        rw [Matrix.transpose_mul]
        simp only [Matrix.mul_assoc]
    _ = 0 := by rw [hesJes, Matrix.mul_zero, Matrix.zero_mul]

private theorem bmdualm_range_eps_eq_sup
    (n f : ℕ) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e)) :
    LinearMap.range (Matrix.mulVecLin (bmdualmeps n f e)) =
      LinearMap.range (Matrix.mulVecLin e) ⊔
        LinearMap.range (Matrix.mulVecLin (bmdualmestar n f e)) := by
  have hee : e * e = e := he.2.1.eq
  have hes : bmdualmestar n f e * bmdualmestar n f e = bmdualmestar n f e := hestar.2.1.eq
  have hee' : bmdualmeps n f e * e = e := by
    rw [bmdualmeps, Matrix.add_mul, hee, horth', add_zero]
  have hes' : bmdualmeps n f e * bmdualmestar n f e = bmdualmestar n f e := by
    rw [bmdualmeps, Matrix.add_mul, horth, zero_add, hes]
  apply le_antisymm
  · rintro x ⟨v, rfl⟩
    rw [Matrix.mulVecLin_apply, bmdualmeps, Matrix.add_mulVec]
    exact Submodule.add_mem_sup ⟨v, rfl⟩ ⟨v, rfl⟩
  · apply sup_le
    · rintro x ⟨v, rfl⟩
      rw [Matrix.mulVecLin_apply]
      exact ⟨Matrix.mulVec e v, by rw [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hee']⟩
    · rintro x ⟨v, rfl⟩
      rw [Matrix.mulVecLin_apply]
      exact ⟨Matrix.mulVec (bmdualmestar n f e) v,
        by rw [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hes']⟩

private theorem bmdualm_adapted_basis_e_span
    (n f : ℕ) (S : Set (GL (bmdualmι n) (GaloisField 2 f)))
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualmA n f S) e)
    (horth : e * bmdualmestar n f e = 0) (horth' : bmdualmestar n f e * e = 0)
    (hestar : IsPrimIdemIn (bmdualmA n f S) (bmdualmestar n f e)) :
    ∃ (r : ℕ) (Pe : Matrix (bmdualmι n) (Fin r ⊕ Fin r) (GaloisField 2 f)),
      Matrix.transpose Pe * bmdualmG n f * Pe = bmdualmGp r f ∧
      bmdualmeps n f e * Pe = Pe ∧
      e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) ∧
      bmdualmestar n f e * Pe = Pe * Matrix.fromBlocks
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) ∧
      (∀ x : bmdualmι n → GaloisField 2 f,
        Matrix.mulVec (bmdualmeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Pe)) ∧
      Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin e)) = r := by
  obtain ⟨r, We, Ws, hWe, hWs, hdual, hWeSpan, hWsSpan, hr⟩ :=
    bmdualm_exists_dual_bases_e_span n f S he hestar
  obtain ⟨hdE, hdS⟩ := bmdualm_adapted_Pe_diag n f r We Ws hWe hWs
    (bmdualm_e_mul_Ws_zero n f r Ws hWs horth) (bmdualm_estar_mul_We_zero n f r We hWe horth')
  have hrangeWe : LinearMap.range (Matrix.mulVecLin e) =
      LinearMap.range (Matrix.mulVecLin We) := by
    apply le_antisymm
    · rintro y ⟨z, rfl⟩
      simpa only [Matrix.mulVecLin_apply] using hWeSpan z
    · rintro y ⟨c, rfl⟩
      exact ⟨Matrix.mulVec We c,
        by simp only [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hWe]⟩
  have hrangeWs : LinearMap.range (Matrix.mulVecLin (bmdualmestar n f e)) =
      LinearMap.range (Matrix.mulVecLin Ws) := by
    apply le_antisymm
    · rintro y ⟨z, rfl⟩
      simpa only [Matrix.mulVecLin_apply] using hWsSpan z
    · rintro y ⟨c, rfl⟩
      exact ⟨Matrix.mulVec Ws c,
        by simp only [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hWs]⟩
  refine ⟨r, bmdualm_blockCols We Ws,
    bmdualm_adapted_Pe_form n f r We Ws hdual (bmdualm_We_iso n f r We hWe horth')
      (bmdualm_Ws_iso n f r Ws hWs horth),
    bmdualm_adapted_Pe_eps n f r We Ws hdE hdS, hdE, hdS, ?_, hr⟩
  intro x
  rw [bmdualm_blockCols_range We Ws, ← hrangeWe, ← hrangeWs,
    ← bmdualm_range_eps_eq_sup n f S he horth horth'
      hestar]
  exact ⟨x, rfl⟩

private theorem bmdualm_dot_mulVec_conj {m n : Type*} [Fintype m] [Fintype n] {F : Type}
    [CommSemiring F] (M : Matrix m n F) (B : Matrix m m F) (a b : n → F) :
    dotProduct (Matrix.mulVec M a) (Matrix.mulVec B (Matrix.mulVec M b)) =
      dotProduct a (Matrix.mulVec (Matrix.transpose M * B * M) b) := by
  rw [Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, Matrix.vecMul_mulVec,
    ← Matrix.mul_assoc, ← Matrix.dotProduct_mulVec]

private noncomputable def bmdualm_J12 (f R r' : ℕ) (lam : GaloisField 2 f) :
    Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f) :=
  Matrix.of (fun a j => match j with
    | Sum.inl b => if a = b then lam else 0
    | Sum.inr _ => 0)

private noncomputable def bmdualm_J21 (f R r' : ℕ) (lam : GaloisField 2 f) :
    Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f) :=
  Matrix.of (fun b a => match b with
    | Sum.inl b' => if b' = a then lam else 0
    | Sum.inr _ => 0)

private noncomputable def bmdualm_formBlock (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n) :
    Matrix (Fin r') (Fin r') (GaloisField 2 f) :=
  Matrix.of (fun c c' => Matrix.reindex eidx.symm eidx.symm (bmdualmG n f)
    (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inr c')))

private def bmdualm_IsFormStandard (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n) : Prop :=
  ∃ lam : GaloisField 2 f, lam ≠ 0 ∧
    Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) =
      Matrix.fromBlocks
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
        (bmdualm_J12 f R r' lam)
        (bmdualm_J21 f R r' lam)
        (Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (bmdualm_formBlock n f R r' eidx))
      ∧ (∃ Qinv : Matrix (Fin r') (Fin r') (GaloisField 2 f),
          bmdualm_formBlock n f R r' eidx * Qinv = 1)

private def bmdualm_IsFormStandardOne (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n) : Prop :=
  Matrix.reindex eidx.symm eidx.symm (bmdualmG n f) =
    Matrix.fromBlocks
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (bmdualm_J12 f R r' 1)
      (bmdualm_J21 f R r' 1)
      (Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (bmdualm_formBlock n f R r' eidx)) ∧
    (∃ Qinv : Matrix (Fin r') (Fin r') (GaloisField 2 f),
      bmdualm_formBlock n f R r' eidx * Qinv = 1)

private theorem bmdualm_IsFormStandardOne.toStandard {n f R r' : ℕ}
    {eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualmι n}
    (h : bmdualm_IsFormStandardOne n f R r' eidx) :
    bmdualm_IsFormStandard n f R r' eidx :=
  ⟨1, one_ne_zero, h.1, h.2⟩

private noncomputable def bmdualm_eidxEm (s : ℕ) (hs : 1 ≤ s) :
    Fin (2 * s) ≃ bmdualmι s :=
  (finCongr (by omega)).trans
    (finSumFinEquiv.symm.trans
      (Equiv.sumCongr (Equiv.refl (Fin (s - 1))) finSumFinEquiv.symm))

private noncomputable def bmdualm_eidxTail (r s n : ℕ) (hrs : r + s = n) (hs : 1 ≤ s) :
    (Fin r ⊕ Fin r) ⊕ bmdualmι s ≃ bmdualmι n :=
  let step1 : (Fin r ⊕ Fin r) ⊕ bmdualmι s ≃
      (Fin r ⊕ Fin r) ⊕ ((Fin (s - 1) ⊕ Fin (s - 1)) ⊕ Fin 2) :=
    Equiv.sumCongr (Equiv.refl (Fin r ⊕ Fin r))
      (Equiv.sumAssoc (Fin (s - 1)) (Fin (s - 1)) (Fin 2)).symm
  let step2 : (Fin r ⊕ Fin r) ⊕ ((Fin (s - 1) ⊕ Fin (s - 1)) ⊕ Fin 2) ≃
      ((Fin r ⊕ Fin r) ⊕ (Fin (s - 1) ⊕ Fin (s - 1))) ⊕ Fin 2 :=
    (Equiv.sumAssoc (Fin r ⊕ Fin r) (Fin (s - 1) ⊕ Fin (s - 1)) (Fin 2)).symm
  let step3 : ((Fin r ⊕ Fin r) ⊕ (Fin (s - 1) ⊕ Fin (s - 1))) ⊕ Fin 2 ≃
      ((Fin r ⊕ Fin (s - 1)) ⊕ (Fin r ⊕ Fin (s - 1))) ⊕ Fin 2 :=
    Equiv.sumCongr
      (Equiv.sumSumSumComm (Fin r) (Fin r) (Fin (s - 1)) (Fin (s - 1)))
      (Equiv.refl (Fin 2))
  let step4 : ((Fin r ⊕ Fin (s - 1)) ⊕ (Fin r ⊕ Fin (s - 1))) ⊕ Fin 2 ≃
      (Fin (n - 1) ⊕ Fin (n - 1)) ⊕ Fin 2 :=
    Equiv.sumCongr
      (Equiv.sumCongr
        ((finSumFinEquiv : Fin r ⊕ Fin (s - 1) ≃ Fin (r + (s - 1))).trans
          (finCongr (by omega)))
        ((finSumFinEquiv : Fin r ⊕ Fin (s - 1) ≃ Fin (r + (s - 1))).trans
          (finCongr (by omega))))
      (Equiv.refl (Fin 2))
  let step5 : (Fin (n - 1) ⊕ Fin (n - 1)) ⊕ Fin 2 ≃ bmdualmι n :=
    Equiv.sumAssoc (Fin (n - 1)) (Fin (n - 1)) (Fin 2)
  step1.trans (step2.trans (step3.trans (step4.trans step5)))

private noncomputable def bmdualm_eidx (r s n : ℕ) (hrs : r + s = n) (hs : 1 ≤ s) :
    Fin r ⊕ (Fin r ⊕ Fin (2 * s)) ≃ bmdualmι n :=
  let step1 : Fin r ⊕ (Fin r ⊕ Fin (2 * s)) ≃ (Fin r ⊕ Fin r) ⊕ Fin (2 * s) :=
    (Equiv.sumAssoc (Fin r) (Fin r) (Fin (2 * s))).symm
  let step2 : (Fin r ⊕ Fin r) ⊕ Fin (2 * s) ≃ (Fin r ⊕ Fin r) ⊕ bmdualmι s :=
    Equiv.sumCongr (Equiv.refl (Fin r ⊕ Fin r)) (bmdualm_eidxEm s hs)
  step1.trans (step2.trans (bmdualm_eidxTail r s n hrs hs))

private theorem bmdualm_Gp_inl_inl (r f : ℕ) (a b : Fin r) :
    bmdualmGp r f (Sum.inl a) (Sum.inl b) = 0 := by
  rw [show bmdualmGp r f =
      LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (bmdualmQp r f))
    from rfl, LinearMap.toMatrix₂'_apply]
  change QuadraticMap.polar (Spin.quadPlus r (GaloisField 2 f))
    (Pi.single (Sum.inl a) 1) (Pi.single (Sum.inl b) 1) = 0
  rw [Spin.polar_quadPlus_single_inl]
  simp [Pi.single_apply]

private theorem bmdualm_Gp_inl_inr (r f : ℕ) (a b : Fin r) :
    bmdualmGp r f (Sum.inl a) (Sum.inr b) = if a = b then 1 else 0 := by
  rw [show bmdualmGp r f =
      LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (bmdualmQp r f))
    from rfl, LinearMap.toMatrix₂'_apply]
  change QuadraticMap.polar (Spin.quadPlus r (GaloisField 2 f))
    (Pi.single (Sum.inl a) 1) (Pi.single (Sum.inr b) 1) = if a = b then 1 else 0
  rw [Spin.polar_quadPlus_single_inr]
  by_cases h : a = b <;> simp [Pi.single_apply, h, eq_comm]

private theorem bmdualm_Gp_inr_inl (r f : ℕ) (a b : Fin r) :
    bmdualmGp r f (Sum.inr a) (Sum.inl b) = if a = b then 1 else 0 := by
  rw [show bmdualmGp r f =
      LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (bmdualmQp r f))
    from rfl, LinearMap.toMatrix₂'_apply]
  change QuadraticMap.polar (Spin.quadPlus r (GaloisField 2 f))
    (Pi.single (Sum.inr a) 1) (Pi.single (Sum.inl b) 1) = if a = b then 1 else 0
  rw [Spin.polar_quadPlus_single_inl]
  by_cases h : a = b <;> simp [Pi.single_apply, h, eq_comm]

private theorem bmdualm_Gp_inr_inr (r f : ℕ) (a b : Fin r) :
    bmdualmGp r f (Sum.inr a) (Sum.inr b) = 0 := by
  rw [show bmdualmGp r f =
      LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (bmdualmQp r f))
    from rfl, LinearMap.toMatrix₂'_apply]
  change QuadraticMap.polar (Spin.quadPlus r (GaloisField 2 f))
    (Pi.single (Sum.inr a) 1) (Pi.single (Sum.inr b) 1) = 0
  rw [Spin.polar_quadPlus_single_inr]
  simp [Pi.single_apply]

private theorem bmdualm_polar_single_inl_inl (n f : ℕ) (a b : Fin (n - 1)) :
    QuadraticMap.polar (bmdualmQ n f) (Pi.single (Sum.inl a) 1)
      (Pi.single (Sum.inl b) 1) = 0 := by
  rw [show bmdualmQ n f = Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
    (minusCoeffs 2 f).2 from rfl, Spin.polar_quadMinus]
  simp [Pi.single_apply, CharP.cast_eq_zero]

private theorem bmdualm_polar_single_inl_inr (n f : ℕ) (a b : Fin (n - 1)) :
    QuadraticMap.polar (bmdualmQ n f) (Pi.single (Sum.inl a) 1)
      (Pi.single (Sum.inr (Sum.inl b)) 1) = if a = b then 1 else 0 := by
  rw [show bmdualmQ n f = Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
    (minusCoeffs 2 f).2 from rfl, Spin.polar_quadMinus]
  simp only [Finset.sum_apply, Pi.single_apply, Finset.sum_ite_eq', Finset.mem_univ, if_true]
  by_cases h : a = b <;> simp [h, eq_comm, CharP.cast_eq_zero]

private theorem bmdualm_polar_single_inr_inl (n f : ℕ) (a b : Fin (n - 1)) :
    QuadraticMap.polar (bmdualmQ n f) (Pi.single (Sum.inr (Sum.inl a)) 1)
      (Pi.single (Sum.inl b) 1) = if a = b then 1 else 0 := by
  rw [show bmdualmQ n f = Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
    (minusCoeffs 2 f).2 from rfl, Spin.polar_quadMinus]
  simp only [Finset.sum_apply, Pi.single_apply, Finset.sum_ite_eq', Finset.mem_univ, if_true]
  by_cases h : a = b <;> simp [h, eq_comm, CharP.cast_eq_zero]

private theorem bmdualm_polar_single_inr_inr (n f : ℕ) (a b : Fin (n - 1)) :
    QuadraticMap.polar (bmdualmQ n f) (Pi.single (Sum.inr (Sum.inl a)) 1)
      (Pi.single (Sum.inr (Sum.inl b)) 1) = 0 := by
  rw [show bmdualmQ n f = Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
    (minusCoeffs 2 f).2 from rfl, Spin.polar_quadMinus]
  simp [Pi.single_apply, CharP.cast_eq_zero]

private theorem bmdualm_Gp_isUnit_det (r f : ℕ) : IsUnit (bmdualmGp r f).det := by
  have hnd := Spin.nondegenerate_polarBilin_quadPlus r (GaloisField 2 f)
  have h1 : bmdualmGp r f =
      LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin (bmdualmQp r f)) := rfl
  rw [h1]
  exact isUnit_iff_ne_zero.mpr (Matrix.nondegenerate_iff_det_ne_zero.mp
    ((LinearMap.BilinForm.nondegenerate_toMatrix'_iff).mpr hnd))

private theorem bmdualm_Pe_injective (n f r : ℕ)
    {Pe : Matrix (bmdualmι n) (Fin r ⊕ Fin r) (GaloisField 2 f)}
    (hPeG : Matrix.transpose Pe * bmdualmG n f * Pe = bmdualmGp r f) :
    Function.Injective (Matrix.mulVec Pe) := by
  intro c d hcd
  have h0 : Matrix.mulVec Pe (c - d) = 0 := by rw [Matrix.mulVec_sub, hcd, sub_self]
  have h1 : Matrix.mulVec (bmdualmGp r f) (c - d) = 0 := by
    rw [← hPeG]
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, h0, Matrix.mulVec_zero, Matrix.mulVec_zero]
  have hunit : IsUnit (bmdualmGp r f).det := bmdualm_Gp_isUnit_det r f
  exact sub_eq_zero.mp (Matrix.eq_zero_of_mulVec_eq_zero (isUnit_iff_ne_zero.mp hunit) h1)

private theorem bmdualm_Pe_col_quad (n f r : ℕ)
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (hquad : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (bmdualmestar n f e) x) = 0)
    {Pe : Matrix (bmdualmι n) (Fin r ⊕ Fin r) (GaloisField 2 f)}
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualmestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (c : Fin r ⊕ Fin r) :
    bmdualmQ n f (Matrix.mulVec Pe (Pi.single c 1)) = 0 := by
  rcases c with a | b
  · have hfix : Matrix.mulVec e (Matrix.mulVec Pe (Pi.single (Sum.inl a) 1)) =
        Matrix.mulVec Pe (Pi.single (Sum.inl a) 1) := by
      rw [Matrix.mulVec_mulVec, hPee, ← Matrix.mulVec_mulVec]
      congr 1
      rw [Matrix.mulVec_single_one]
      funext i
      rcases i with a' | b' <;>
        simp [Matrix.col_apply, Matrix.fromBlocks, Matrix.one_apply, Pi.single_apply, eq_comm]
    rw [← hfix]; exact hquad _
  · have hfix : Matrix.mulVec (bmdualmestar n f e) (Matrix.mulVec Pe (Pi.single (Sum.inr b) 1)) =
        Matrix.mulVec Pe (Pi.single (Sum.inr b) 1) := by
      rw [Matrix.mulVec_mulVec, hPees, ← Matrix.mulVec_mulVec]
      congr 1
      rw [Matrix.mulVec_single_one]
      funext i
      rcases i with a' | b' <;>
        simp [Matrix.col_apply, Matrix.fromBlocks, Matrix.one_apply, Pi.single_apply, eq_comm]
    rw [← hfix]; exact hquad' _

private noncomputable def bmdualm_eidxR (r s n : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (hr1 : 1 ≤ r) :
    Fin (r - 1 + 1) ⊕ (Fin (r - 1 + 1) ⊕ Fin (2 * s)) ≃ bmdualmι n :=
  (Equiv.sumCongr (finCongr (Nat.sub_add_cancel hr1))
    (Equiv.sumCongr (finCongr (Nat.sub_add_cancel hr1)) (Equiv.refl _))).trans
    (bmdualm_eidx r s n hrs hs)

private theorem bmdualm_eidx_inl (r s n : ℕ) (hrs : r + s = n) (hs : 1 ≤ s) (a : Fin r) :
    bmdualm_eidx r s n hrs hs (Sum.inl a) = Sum.inl (Fin.castLE (by omega) a) := by
  rfl

private theorem bmdualm_eidx_inr_inl (r s n : ℕ) (hrs : r + s = n) (hs : 1 ≤ s) (b : Fin r) :
    bmdualm_eidx r s n hrs hs (Sum.inr (Sum.inl b)) =
      Sum.inr (Sum.inl (Fin.castLE (by omega) b)) := by
  rfl

private def bmdualm_blockIndex (r s : ℕ) (c : Fin r ⊕ Fin r) :
    Fin r ⊕ (Fin r ⊕ Fin (2 * s)) :=
  Sum.map id Sum.inl c

private theorem bmdualm_polar_eidx (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (c d : Fin r ⊕ Fin r) :
    QuadraticMap.polar (bmdualmQ n f)
      (Pi.single (bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s c)) 1)
      (Pi.single (bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s d)) 1) =
      bmdualmGp r f c d := by
  rcases c with a | a <;> rcases d with b | b <;>
    simp only [bmdualm_blockIndex, Sum.map_inl, Sum.map_inr]
  · rw [bmdualm_eidx_inl, bmdualm_eidx_inl, bmdualm_polar_single_inl_inl, bmdualm_Gp_inl_inl]
  · rw [bmdualm_eidx_inl, bmdualm_eidx_inr_inl, bmdualm_polar_single_inl_inr, bmdualm_Gp_inl_inr]
    by_cases h : a = b <;> simp [h, Fin.castLE_injective]
  · rw [bmdualm_eidx_inr_inl, bmdualm_eidx_inl, bmdualm_polar_single_inr_inl, bmdualm_Gp_inr_inl]
    by_cases h : a = b <;> simp [h, Fin.castLE_injective]
  · rw [bmdualm_eidx_inr_inl, bmdualm_eidx_inr_inl, bmdualm_polar_single_inr_inr,
      bmdualm_Gp_inr_inr]

private theorem bmdualm_quad_eidx (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (c : Fin r ⊕ Fin r) :
    bmdualmQ n f (Pi.single (bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s c)) 1) = 0 := by
  rcases c with a | b <;> simp only [bmdualm_blockIndex, Sum.map_inl, Sum.map_inr]
  · rw [bmdualm_eidx_inl]
    rw [show bmdualmQ n f = Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
      (minusCoeffs 2 f).2 from rfl, Spin.quadMinus_apply]
    simp [Pi.single_apply, CharP.cast_eq_zero]
  · rw [bmdualm_eidx_inr_inl]
    rw [show bmdualmQ n f = Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
      (minusCoeffs 2 f).2 from rfl, Spin.quadMinus_apply]
    simp [Pi.single_apply, CharP.cast_eq_zero]

private theorem bmdualm_blockIndex_injective (r s : ℕ) :
    Function.Injective (bmdualm_blockIndex r s) := by
  intro c d h
  rcases c with a | a <;> rcases d with b | b <;>
    simp only [bmdualm_blockIndex, Sum.map_inl, Sum.map_inr] at h
  · simpa using h
  · exact absurd h (by simp)
  · exact absurd h (by simp)
  · simpa using h

private theorem bmdualm_witt (n f r s : ℕ) (hn : 4 ≤ n) (hrs : r + s = n) (hs : 1 ≤ s)
    {Pe : Matrix (bmdualmι n) (Fin r ⊕ Fin r) (GaloisField 2 f)}
    (hPeG : Matrix.transpose Pe * bmdualmG n f * Pe = bmdualmGp r f)
    (hPequad : ∀ c, bmdualmQ n f (Matrix.mulVec Pe (Pi.single c 1)) = 0) :
    ∃ g : ↥(spinGroup (bmdualmQ n f)),
      ∀ c, Spin.spinAction (bmdualmQ n f) g (Matrix.mulVec Pe (Pi.single c 1)) =
        Pi.single (bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s c)) 1 := by
  let w : Fin r ⊕ Fin r → bmdualmι n → GaloisField 2 f :=
    fun c => Matrix.mulVec Pe (Pi.single c 1)
  let w' : Fin r ⊕ Fin r → bmdualmι n → GaloisField 2 f :=
    fun c => Pi.single (bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s c))
      (1 : GaloisField 2 f)
  have hf_inj : Function.Injective
      (fun c : Fin r ⊕ Fin r => bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s c)) :=
    fun c d h => bmdualm_blockIndex_injective r s ((bmdualm_eidx r s n hrs hs).injective h)
  have hw : LinearIndependent (GaloisField 2 f) w := by
    change LinearIndependent (GaloisField 2 f)
      (fun c : Fin r ⊕ Fin r => Matrix.mulVec Pe (Pi.single c 1))
    rw [show (fun c : Fin r ⊕ Fin r => Matrix.mulVec Pe (Pi.single c 1)) = Pe.col from by
      funext c; rw [Matrix.mulVec_single_one]]
    rw [← Matrix.mulVec_injective_iff]
    exact bmdualm_Pe_injective n f r hPeG
  have hw' : LinearIndependent (GaloisField 2 f) w' := by
    rw [Fintype.linearIndependent_iff]
    intro g hg c
    have h := congrFun hg (bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s c))
    simp only [Finset.sum_apply, Pi.smul_apply, w', Pi.single_apply, smul_eq_mul] at h
    rw [Finset.sum_eq_single c] at h
    · simpa using h
    · intro d _ hdc
      have hne : (bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s c)) ≠
          (bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s d)) :=
        fun he => hdc (hf_inj he).symm
      simp [hne]
    · intro hc; exact absurd (Finset.mem_univ c) hc
  have hQ : ∀ c, bmdualmQ n f (w' c) = bmdualmQ n f (w c) := by
    intro c
    simp only [w', w]
    rw [bmdualm_quad_eidx, hPequad]
  have hpol : ∀ c d, QuadraticMap.polar (bmdualmQ n f) (w' c) (w' d) =
      QuadraticMap.polar (bmdualmQ n f) (w c) (w d) := by
    intro c d
    simp only [w', w]
    have hPeG' : (Matrix.transpose Pe * bmdualmG n f * Pe) c d =
        QuadraticMap.polar (bmdualmQ n f) (Matrix.mulVec Pe (Pi.single c 1))
          (Matrix.mulVec Pe (Pi.single d 1)) := by
      rw [bmdualm_polar_eq_dot, bmdualm_dot_mulVec_conj]
      simp [Matrix.mulVec_single_one, Matrix.col_apply, dotProduct, Pi.single_apply]
    rw [bmdualm_polar_eidx, ← hPeG', hPeG]
  have ha : bmdualmQ n f (Pi.single (Sum.inr (Sum.inr 0)) 1) ≠ 0 := by
    rw [show bmdualmQ n f = Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
      (minusCoeffs 2 f).2 from rfl, Spin.quadMinus_apply]
    simp [Pi.single_apply, CharP.cast_eq_zero]
  have haw : ∀ c, QuadraticMap.polar (bmdualmQ n f) (Pi.single (Sum.inr (Sum.inr 0)) 1)
      (w' c) = 0 := by
    intro c
    simp only [w']
    rcases c with a | b <;> simp only [bmdualm_blockIndex, Sum.map_inl, Sum.map_inr]
    · rw [bmdualm_eidx_inl]
      rw [show bmdualmQ n f = Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
        (minusCoeffs 2 f).2 from rfl, Spin.polar_quadMinus]
      simp [Pi.single_apply, CharP.cast_eq_zero]
    · rw [bmdualm_eidx_inr_inl]
      rw [show bmdualmQ n f = Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
        (minusCoeffs 2 f).2 from rfl, Spin.polar_quadMinus]
      simp [Pi.single_apply, CharP.cast_eq_zero]
  obtain ⟨g, hg⟩ := CFSG.StandardType.ClassicalPosition.exists_spinAction_apply_eq_POmegaMinus
    n (minusCoeffs_irr 2 f) hn w w' hw hw' hQ hpol (Pi.single (Sum.inr (Sum.inr 0)) 1) ha haw
  exact ⟨g, hg⟩

private theorem bmdualm_glue_r_pos
    (n f r s : ℕ)
    {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualmι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (hPeSpan : ∀ x : bmdualmι n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmdualmeps n f e) x)
    (hε : bmdualmeps n f e ≠ 0) :
    1 ≤ r := by
  rcases Nat.eq_zero_or_pos r with h | h
  · exfalso
    apply hε
    subst h
    ext i j
    obtain ⟨c, hc⟩ := hPeSpan (Pi.single j 1)
    have hc0 : c = 0 := Subsingleton.elim c 0
    rw [hc0, Matrix.mulVec_zero] at hc
    have := congrFun hc.symm i
    simpa [Matrix.mulVec, dotProduct, Pi.single_apply] using this
  · exact h

private theorem bmdualm_eidxR_inl (r s n : ℕ) (hrs : r + s = n) (hs : 1 ≤ s) (hr1 : 1 ≤ r)
    (a : Fin (r - 1 + 1)) :
    bmdualm_eidxR r s n hrs hs hr1 (Sum.inl a) = Sum.inl (Fin.castLE (by omega) a) := by
  simp only [bmdualm_eidxR, Equiv.trans_apply, Equiv.sumCongr_apply, bmdualm_eidx_inl]
  rfl

private theorem bmdualm_eidxR_inr_inl (r s n : ℕ) (hrs : r + s = n) (hs : 1 ≤ s) (hr1 : 1 ≤ r)
    (a : Fin (r - 1 + 1)) :
    bmdualm_eidxR r s n hrs hs hr1 (Sum.inr (Sum.inl a)) =
      Sum.inr (Sum.inl (Fin.castLE (by omega) a)) := by
  simp only [bmdualm_eidxR, Equiv.trans_apply, Equiv.sumCongr_apply, bmdualm_eidx_inr_inl]
  rfl

private theorem bmdualm_polar_single_inl_inr2 (n f : ℕ) (i : Fin (n - 1)) (k : Fin 2) :
    QuadraticMap.polar (bmdualmQ n f) (Pi.single (Sum.inl i) 1)
      (Pi.single (Sum.inr (Sum.inr k)) 1) = 0 := by
  rw [show bmdualmQ n f = Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
    (minusCoeffs 2 f).2 from rfl, Spin.polar_quadMinus]
  simp [Pi.single_apply, CharP.cast_eq_zero]

private theorem bmdualm_polar_single_inr_inr2 (n f : ℕ) (i : Fin (n - 1)) (k : Fin 2) :
    QuadraticMap.polar (bmdualmQ n f) (Pi.single (Sum.inr (Sum.inl i)) 1)
      (Pi.single (Sum.inr (Sum.inr k)) 1) = 0 := by
  rw [show bmdualmQ n f = Spin.quadMinus n (GaloisField 2 f) (minusCoeffs 2 f).1
    (minusCoeffs 2 f).2 from rfl, Spin.polar_quadMinus]
  simp [Pi.single_apply, CharP.cast_eq_zero]

private theorem bmdualm_G_inl_inl (n f : ℕ) (i j : Fin (n - 1)) :
    bmdualmG n f (Sum.inl i) (Sum.inl j) = 0 := by
  rw [show bmdualmG n f = LinearMap.toMatrix₂' (GaloisField 2 f)
    (QuadraticMap.polarBilin (bmdualmQ n f)) from rfl, LinearMap.toMatrix₂'_apply]
  exact bmdualm_polar_single_inl_inl n f i j

private theorem bmdualm_G_inl_inr (n f : ℕ) (i j : Fin (n - 1)) :
    bmdualmG n f (Sum.inl i) (Sum.inr (Sum.inl j)) = if i = j then 1 else 0 := by
  rw [show bmdualmG n f = LinearMap.toMatrix₂' (GaloisField 2 f)
    (QuadraticMap.polarBilin (bmdualmQ n f)) from rfl, LinearMap.toMatrix₂'_apply]
  exact bmdualm_polar_single_inl_inr n f i j

private theorem bmdualm_G_inr_inl (n f : ℕ) (i j : Fin (n - 1)) :
    bmdualmG n f (Sum.inr (Sum.inl i)) (Sum.inl j) = if i = j then 1 else 0 := by
  rw [show bmdualmG n f = LinearMap.toMatrix₂' (GaloisField 2 f)
    (QuadraticMap.polarBilin (bmdualmQ n f)) from rfl, LinearMap.toMatrix₂'_apply]
  exact bmdualm_polar_single_inr_inl n f i j

private theorem bmdualm_G_inr_inr (n f : ℕ) (i j : Fin (n - 1)) :
    bmdualmG n f (Sum.inr (Sum.inl i)) (Sum.inr (Sum.inl j)) = 0 := by
  rw [show bmdualmG n f = LinearMap.toMatrix₂' (GaloisField 2 f)
    (QuadraticMap.polarBilin (bmdualmQ n f)) from rfl, LinearMap.toMatrix₂'_apply]
  exact bmdualm_polar_single_inr_inr n f i j

private theorem bmdualm_G_inl_inr2 (n f : ℕ) (i : Fin (n - 1)) (k : Fin 2) :
    bmdualmG n f (Sum.inl i) (Sum.inr (Sum.inr k)) = 0 := by
  rw [show bmdualmG n f = LinearMap.toMatrix₂' (GaloisField 2 f)
    (QuadraticMap.polarBilin (bmdualmQ n f)) from rfl, LinearMap.toMatrix₂'_apply]
  exact bmdualm_polar_single_inl_inr2 n f i k

private theorem bmdualm_G_inr_inr2 (n f : ℕ) (i : Fin (n - 1)) (k : Fin 2) :
    bmdualmG n f (Sum.inr (Sum.inl i)) (Sum.inr (Sum.inr k)) = 0 := by
  rw [show bmdualmG n f = LinearMap.toMatrix₂' (GaloisField 2 f)
    (QuadraticMap.polarBilin (bmdualmQ n f)) from rfl, LinearMap.toMatrix₂'_apply]
  exact bmdualm_polar_single_inr_inr2 n f i k

private theorem bmdualm_G_symm (n f : ℕ) (p q : bmdualmι n) :
    bmdualmG n f p q = bmdualmG n f q p := by
  have h := congrFun (congrFun (bmdualm_G_symmetric n f) p) q
  rw [Matrix.transpose_apply] at h
  exact h.symm

private theorem bmdualm_G_inl_any (n f : ℕ) (i : Fin (n - 1)) (q : bmdualmι n) :
    bmdualmG n f (Sum.inl i) q = if q = Sum.inr (Sum.inl i) then 1 else 0 := by
  rcases q with a | (b | k)
  · rw [bmdualm_G_inl_inl]; simp
  · rw [bmdualm_G_inl_inr]; simp [eq_comm]
  · rw [bmdualm_G_inl_inr2]; simp

private theorem bmdualm_G_inr_inl_any (n f : ℕ) (i : Fin (n - 1)) (q : bmdualmι n) :
    bmdualmG n f (Sum.inr (Sum.inl i)) q = if q = Sum.inl i then 1 else 0 := by
  rcases q with a | (b | k)
  · rw [bmdualm_G_inr_inl]; simp [eq_comm]
  · rw [bmdualm_G_inr_inr]; simp
  · rw [bmdualm_G_inr_inr2]; simp

private theorem bmdualm_G_any_inl (n f : ℕ) (q : bmdualmι n) (i : Fin (n - 1)) :
    bmdualmG n f q (Sum.inl i) = if q = Sum.inr (Sum.inl i) then 1 else 0 := by
  rw [bmdualm_G_symm, bmdualm_G_inl_any]

private theorem bmdualm_G_any_inr_inl (n f : ℕ) (q : bmdualmι n) (i : Fin (n - 1)) :
    bmdualmG n f q (Sum.inr (Sum.inl i)) = if q = Sum.inl i then 1 else 0 := by
  rw [bmdualm_G_symm, bmdualm_G_inr_inl_any]

private theorem bmdualm_eidxR_inr_inr_ne_inl (r s n : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (hr1 : 1 ≤ r) (c : Fin (2 * s)) (a : Fin (r - 1 + 1)) :
    bmdualm_eidxR r s n hrs hs hr1 (Sum.inr (Sum.inr c)) ≠
      Sum.inl (Fin.castLE (by omega) a) := by
  intro h
  have h1 : bmdualm_eidxR r s n hrs hs hr1 (Sum.inr (Sum.inr c)) =
      bmdualm_eidxR r s n hrs hs hr1 (Sum.inl a) := by
    rw [h, bmdualm_eidxR_inl]
  exact absurd ((bmdualm_eidxR r s n hrs hs hr1).injective h1) (by simp)

private theorem bmdualm_eidxR_inr_inr_ne_inr_inl (r s n : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (hr1 : 1 ≤ r) (c : Fin (2 * s)) (a : Fin (r - 1 + 1)) :
    bmdualm_eidxR r s n hrs hs hr1 (Sum.inr (Sum.inr c)) ≠
      Sum.inr (Sum.inl (Fin.castLE (by omega) a)) := by
  intro h
  have h1 : bmdualm_eidxR r s n hrs hs hr1 (Sum.inr (Sum.inr c)) =
      bmdualm_eidxR r s n hrs hs hr1 (Sum.inr (Sum.inl a)) := by
    rw [h, bmdualm_eidxR_inr_inl]
  exact absurd ((bmdualm_eidxR r s n hrs hs hr1).injective h1) (by simp)

private theorem bmdualm_explicit_hform_blocks (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (hr1 : 1 ≤ r) :
    Matrix.reindex (bmdualm_eidxR r s n hrs hs hr1).symm (bmdualm_eidxR r s n hrs hs hr1).symm
        (bmdualmG n f) =
      Matrix.fromBlocks (0 : Matrix (Fin (r - 1 + 1)) (Fin (r - 1 + 1)) (GaloisField 2 f))
        (bmdualm_J12 f (r - 1) (2 * s) 1) (bmdualm_J21 f (r - 1) (2 * s) 1)
        (Matrix.fromBlocks (0 : Matrix (Fin (r - 1 + 1)) (Fin (r - 1 + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (r - 1 + 1)) (Fin (2 * s)) (GaloisField 2 f))
          (0 : Matrix (Fin (2 * s)) (Fin (r - 1 + 1)) (GaloisField 2 f))
          (bmdualm_formBlock n f (r - 1) (2 * s) (bmdualm_eidxR r s n hrs hs hr1))) := by
    ext i j
    rw [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm]
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c')
    · rw [bmdualm_eidxR_inl, bmdualm_eidxR_inl, bmdualm_G_inl_inl]
      simp [Matrix.fromBlocks]
    · rw [bmdualm_eidxR_inl, bmdualm_eidxR_inr_inl, bmdualm_G_inl_inr]
      simp only [Matrix.fromBlocks_apply₁₂, bmdualm_J12, Matrix.of_apply]
      by_cases h : a = b' <;> simp [h, eq_comm, Fin.castLE_injective]
    · rw [bmdualm_eidxR_inl, bmdualm_G_inl_any]
      rw [if_neg (bmdualm_eidxR_inr_inr_ne_inr_inl r s n hrs hs hr1 c' a)]
      simp [Matrix.fromBlocks, bmdualm_J12]
    · rw [bmdualm_eidxR_inr_inl, bmdualm_eidxR_inl, bmdualm_G_inr_inl]
      simp only [Matrix.fromBlocks_apply₂₁, bmdualm_J21, Matrix.of_apply]
      by_cases h : b = a' <;> simp [h, eq_comm, Fin.castLE_injective]
    · rw [bmdualm_eidxR_inr_inl, bmdualm_eidxR_inr_inl, bmdualm_G_inr_inr]
      simp [Matrix.fromBlocks]
    · rw [bmdualm_eidxR_inr_inl, bmdualm_G_inr_inl_any]
      rw [if_neg (bmdualm_eidxR_inr_inr_ne_inl r s n hrs hs hr1 c' b)]
      simp [Matrix.fromBlocks]
    · rw [bmdualm_eidxR_inl, bmdualm_G_any_inl]
      rw [if_neg (bmdualm_eidxR_inr_inr_ne_inr_inl r s n hrs hs hr1 c a')]
      simp [Matrix.fromBlocks, bmdualm_J21]
    · rw [bmdualm_eidxR_inr_inl, bmdualm_G_any_inr_inl]
      rw [if_neg (bmdualm_eidxR_inr_inr_ne_inl r s n hrs hs hr1 c b')]
      simp [Matrix.fromBlocks]
    · simp [bmdualm_formBlock, Matrix.fromBlocks, Matrix.reindex_apply, Matrix.submatrix_apply,
        Equiv.symm_symm]

private theorem bmdualm_explicit_formBlock_invertible (n f r s : ℕ) (hrs : r + s = n)
    (hs : 1 ≤ s) (hr1 : 1 ≤ r) :
    ∃ Qinv : Matrix (Fin (2 * s)) (Fin (2 * s)) (GaloisField 2 f),
      bmdualm_formBlock n f (r - 1) (2 * s) (bmdualm_eidxR r s n hrs hs hr1) * Qinv = 1 := by
  let eidx := bmdualm_eidxR r s n hrs hs hr1
  let G' : Matrix (Fin (r - 1 + 1) ⊕ (Fin (r - 1 + 1) ⊕ Fin (2 * s)))
      (Fin (r - 1 + 1) ⊕ (Fin (r - 1 + 1) ⊕ Fin (2 * s))) (GaloisField 2 f) :=
    Matrix.reindex eidx.symm eidx.symm (bmdualmG n f)
  have hblocks : G' = Matrix.fromBlocks
      (0 : Matrix (Fin (r - 1 + 1)) (Fin (r - 1 + 1)) (GaloisField 2 f))
      (bmdualm_J12 f (r - 1) (2 * s) 1) (bmdualm_J21 f (r - 1) (2 * s) 1)
      (Matrix.fromBlocks (0 : Matrix (Fin (r - 1 + 1)) (Fin (r - 1 + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (r - 1 + 1)) (Fin (2 * s)) (GaloisField 2 f))
        (0 : Matrix (Fin (2 * s)) (Fin (r - 1 + 1)) (GaloisField 2 f))
        (bmdualm_formBlock n f (r - 1) (2 * s) eidx)) := by
    simpa only [G', eidx] using bmdualm_explicit_hform_blocks n f r s hrs hs hr1
  have hGinv : IsUnit G'.det := by
    simp only [G']
    rw [Matrix.det_reindex_self]
    exact bmdualm_G_isUnit_det n f
  have hpair : Matrix.toBlocks₁₂ G' = bmdualm_J12 f (r - 1) (2 * s) 1 := by
    rw [hblocks, Matrix.toBlocks_fromBlocks₁₂]
  have hD12e : ∀ b : Fin (r - 1 + 1), ∀ c : Fin (2 * s),
      G' (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inr c)) = 0 := by
    intro b c
    rw [hblocks]
    simp [Matrix.fromBlocks_apply₂₂, Matrix.fromBlocks_apply₁₂]
  have hmapzero : ∀ v : Fin (2 * s) → GaloisField 2 f,
      Matrix.mulVec (bmdualm_formBlock n f (r - 1) (2 * s) eidx) v = 0 → v = 0 := by
    intro v hv
    let x : (Fin (r - 1 + 1) ⊕ (Fin (r - 1 + 1) ⊕ Fin (2 * s))) → GaloisField 2 f :=
      Sum.elim (fun _ => 0) (Sum.elim (fun _ => 0) v)
    have hx : Matrix.mulVec G' x = 0 := by
      funext i
      rcases i with a | (b | c)
      · simp only [Matrix.mulVec, dotProduct, Pi.zero_apply]
        rw [Fintype.sum_sum_type, Finset.sum_eq_zero (fun a' _ => by simp [x]), zero_add,
          Fintype.sum_sum_type, Finset.sum_eq_zero (fun b' _ => by simp [x]), zero_add]
        rw [Finset.sum_eq_zero (fun c' _ => by
          rw [show G' (Sum.inl a) (Sum.inr (Sum.inr c')) =
              Matrix.toBlocks₁₂ G' a (Sum.inr c') from rfl, hpair]
          simp [bmdualm_J12, x])]
      · simp only [Matrix.mulVec, dotProduct, Pi.zero_apply]
        rw [Fintype.sum_sum_type, Finset.sum_eq_zero (fun a' _ => by simp [x]), zero_add,
          Fintype.sum_sum_type, Finset.sum_eq_zero (fun b' _ => by simp [x]), zero_add]
        rw [Finset.sum_eq_zero (fun c' _ => by rw [hD12e b c']; simp [x])]
      · simp only [Matrix.mulVec, dotProduct, Pi.zero_apply]
        rw [Fintype.sum_sum_type, Finset.sum_eq_zero (fun a' _ => by simp [x]), zero_add,
          Fintype.sum_sum_type, Finset.sum_eq_zero (fun b' _ => by simp [x]), zero_add]
        have hsum : (∑ c' : Fin (2 * s), G' (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inr c')) *
            x (Sum.inr (Sum.inr c'))) =
            Matrix.mulVec (bmdualm_formBlock n f (r - 1) (2 * s) eidx) v c := by
          simp only [x, Sum.elim_inr, Matrix.mulVec, dotProduct, bmdualm_formBlock, Matrix.of_apply]
          rfl
        rw [hsum, show Matrix.mulVec (bmdualm_formBlock n f (r - 1) (2 * s) eidx) v c = 0 from by
          rw [hv]; rfl]
    have hx0 := Matrix.eq_zero_of_mulVec_eq_zero hGinv.ne_zero hx
    funext c
    have := congrFun hx0 (Sum.inr (Sum.inr c))
    simpa [x] using this
  have hinj : Function.Injective (Matrix.mulVec (bmdualm_formBlock n f (r - 1) (2 * s) eidx)) := by
    intro v w hvw
    have hzw : Matrix.mulVec (bmdualm_formBlock n f (r - 1) (2 * s) eidx) (v - w) = 0 := by
      rw [Matrix.mulVec_sub, hvw, sub_self]
    exact sub_eq_zero.mp (hmapzero (v - w) hzw)
  exact (Matrix.mulVec_injective_iff_isUnit.mp hinj).exists_right_inv

private theorem bmdualm_blockMat_mulVec
    (n f R r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (c d : Fin (R + 1) → GaloisField 2 f) (e : Fin r' → GaloisField 2 f) :
    Matrix.mulVec (bmdualm_blockMat n f (R + 1) r' x) (Sum.elim c (Sum.elim d e)) =
      Sum.elim (Matrix.mulVec (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) c)
        (Sum.elim (Matrix.mulVec
          (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) d) e) := by
  ext i
  rcases i with k | (k | k) <;>
    simp [bmdualm_blockMat, Matrix.fromBlocks, Matrix.mulVec, dotProduct, Fintype.sum_sum_type,
      Sum.elim_inl, Sum.elim_inr, Pi.add_apply, Matrix.one_apply, Finset.sum_ite_eq]

private theorem bmdualm_reindex_mulVec {m n : Type*} [Fintype m] [Fintype n] {F : Type}
    [Semiring F] (e : m ≃ n) (A : Matrix m m F) (v : n → F) :
    Matrix.mulVec (Matrix.reindex e e A) v = (Matrix.mulVec A (v ∘ e)) ∘ e.symm := by
  funext i
  show (∑ j : n, A (e.symm i) (e.symm j) * v j) =
    ∑ k : m, A (e.symm i) k * v (e k)
  have h := (Equiv.sum_comp e (fun j : n => A (e.symm i) (e.symm j) * v j)).symm
  simpa using h

private theorem bmdualm_quadPlus_sl_isometry (m f : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f))
    (c d : Fin m → GaloisField 2 f) :
    Spin.quadPlus m (GaloisField 2 f)
      (Sum.elim (Matrix.mulVec (x : Matrix (Fin m) (Fin m) (GaloisField 2 f)) c)
        (Matrix.mulVec (Matrix.transpose
          ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
            Matrix (Fin m) (Fin m) (GaloisField 2 f))) d)) =
      Spin.quadPlus m (GaloisField 2 f) (Sum.elim c d) := by
  have hmul : Matrix.transpose ((x : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) *
      Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) = 1 := by
    rw [← Matrix.transpose_mul, ← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel,
      Matrix.SpecialLinearGroup.coe_one, Matrix.transpose_one]
  have hdot : Matrix.mulVec (x : Matrix (Fin m) (Fin m) (GaloisField 2 f)) c ⬝ᵥ
      Matrix.mulVec (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f))) d = c ⬝ᵥ d := by
    rw [Matrix.dotProduct_mulVec, Matrix.vecMul_mulVec, hmul, Matrix.vecMul_one]
  simpa only [Spin.quadPlus_apply, Sum.elim_inl, Sum.elim_inr, dotProduct] using hdot

