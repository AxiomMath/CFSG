private theorem bmdualm_explicit_hQ_firstBlock (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (hr1 : 1 ≤ r) (c : Fin (r - 1 + 1) → GaloisField 2 f) :
    bmdualmQ n f (Sum.elim c (Sum.elim 0 0) ∘ (bmdualm_eidxR r s n hrs hs hr1).symm) = 0 := by
