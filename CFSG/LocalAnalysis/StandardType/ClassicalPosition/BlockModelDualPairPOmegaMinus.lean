  · have hsing : ∀ (a : Fin (r - 1 + 1)) (k : Fin (2 * s)),
        QuadraticMap.polar (bmdualmQ n f)
          (Pi.single ((bmdualm_eidxR r s n hrs hs hr1) (Sum.inl a)) 1)
          (Pi.single ((bmdualm_eidxR r s n hrs hs hr1) (Sum.inr (Sum.inr k))) 1) = 0 := by
      intro a k
      rw [bmdualm_polar_single_eidx, bmdualm_eidxR_inl, bmdualm_G_inl_any,
        if_neg (bmdualm_eidxR_inr_inr_ne_inr_inl r s n hrs hs hr1 k a)]
    rw [hu1, hu3, ← QuadraticMap.polarBilin_apply_apply]
    simp only [map_sum, map_smul, Finset.sum_apply, LinearMap.sum_apply, LinearMap.smul_apply,
      Pi.smul_apply, smul_eq_mul]
    simp [hsing]
  · have hsing : ∀ (b : Fin (r - 1 + 1)) (k : Fin (2 * s)),
        QuadraticMap.polar (bmdualmQ n f)
          (Pi.single ((bmdualm_eidxR r s n hrs hs hr1) (Sum.inr (Sum.inl b))) 1)
          (Pi.single ((bmdualm_eidxR r s n hrs hs hr1) (Sum.inr (Sum.inr k))) 1) = 0 := by
      intro b k
      rw [bmdualm_polar_single_eidx, bmdualm_eidxR_inr_inl, bmdualm_G_inr_inl_any,
        if_neg (bmdualm_eidxR_inr_inr_ne_inl r s n hrs hs hr1 k b)]
    rw [hu2, hu3, ← QuadraticMap.polarBilin_apply_apply]
    simp only [map_sum, map_smul, Finset.sum_apply, LinearMap.sum_apply, LinearMap.smul_apply,
      Pi.smul_apply, smul_eq_mul]
    simp [hsing]

private theorem bmdualm_explicit_hQ_decomp (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (hr1 : 1 ≤ r) :
    ∀ (c d : Fin (r - 1 + 1) → GaloisField 2 f) (e : Fin (2 * s) → GaloisField 2 f),
      bmdualmQ n f (Sum.elim c (Sum.elim d e) ∘ (bmdualm_eidxR r s n hrs hs hr1).symm) =
        Spin.quadPlus (r - 1 + 1) (GaloisField 2 f) (Sum.elim c d) +
        bmdualmQ n f (Sum.elim 0 (Sum.elim 0 e) ∘ (bmdualm_eidxR r s n hrs hs hr1).symm) := by
  intro c d e
  have hu : Sum.elim c (Sum.elim d e) ∘ (bmdualm_eidxR r s n hrs hs hr1).symm =
      (Sum.elim c (Sum.elim (0 : Fin (r - 1 + 1) → GaloisField 2 f)
          (0 : Fin (2 * s) → GaloisField 2 f)) ∘ (bmdualm_eidxR r s n hrs hs hr1).symm) +
        (Sum.elim (0 : Fin (r - 1 + 1) → GaloisField 2 f)
          (Sum.elim d (0 : Fin (2 * s) → GaloisField 2 f)) ∘
          (bmdualm_eidxR r s n hrs hs hr1).symm) +
        (Sum.elim (0 : Fin (r - 1 + 1) → GaloisField 2 f)
          (Sum.elim (0 : Fin (r - 1 + 1) → GaloisField 2 f) e) ∘
          (bmdualm_eidxR r s n hrs hs hr1).symm) := by
    funext x
    rcases hx : (bmdualm_eidxR r s n hrs hs hr1).symm x with a | (b | k) <;>
      simp [hx]
  rw [hu, QuadraticMap.map_add (bmdualmQ n f), QuadraticMap.map_add (bmdualmQ n f),
    QuadraticMap.polar_add_left (bmdualmQ n f),
    bmdualm_explicit_hQ_firstBlock n f r s hrs hs hr1 c,
    bmdualm_explicit_hQ_secondBlock n f r s hrs hs hr1 d,
    bmdualm_explicit_hQ_polar12 n f r s hrs hs hr1 c d,
    (bmdualm_explicit_hQ_orth n f r s hrs hs hr1 c d e).1,
    (bmdualm_explicit_hQ_orth n f r s hrs hs hr1 c d e).2]
  abel

private theorem bmdualm_explicit_hblock (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s) (hr1 : 1 ≤ r) :
    ∀ (x : Matrix.SpecialLinearGroup (Fin (r - 1 + 1)) (GaloisField 2 f))
      (w : bmdualmι n → GaloisField 2 f),
      bmdualmQ n f (Matrix.mulVec
        (Matrix.reindex (bmdualm_eidxR r s n hrs hs hr1) (bmdualm_eidxR r s n hrs hs hr1)
          (bmdualm_blockMat n f (r - 1 + 1) (2 * s) x)) w) = bmdualmQ n f w := by
  intro x w
  let c : Fin (r - 1 + 1) → GaloisField 2 f :=
    fun a => w ((bmdualm_eidxR r s n hrs hs hr1) (Sum.inl a))
  let d : Fin (r - 1 + 1) → GaloisField 2 f :=
    fun a => w ((bmdualm_eidxR r s n hrs hs hr1) (Sum.inr (Sum.inl a)))
  let e : Fin (2 * s) → GaloisField 2 f :=
    fun k => w ((bmdualm_eidxR r s n hrs hs hr1) (Sum.inr (Sum.inr k)))
  have hw : w = Sum.elim c (Sum.elim d e) ∘ (bmdualm_eidxR r s n hrs hs hr1).symm := by
    funext i
    show w i = Sum.elim c (Sum.elim d e) ((bmdualm_eidxR r s n hrs hs hr1).symm i)
    cases h : (bmdualm_eidxR r s n hrs hs hr1).symm i with
    | inl a =>
      have hi : i = (bmdualm_eidxR r s n hrs hs hr1) (Sum.inl a) := by
        rw [← h, Equiv.apply_symm_apply]
      rw [hi]; rfl
    | inr a =>
      cases a with
      | inl a =>
        have hi : i = (bmdualm_eidxR r s n hrs hs hr1) (Sum.inr (Sum.inl a)) := by
          rw [← h, Equiv.apply_symm_apply]
        rw [hi]; rfl
      | inr a =>
        have hi : i = (bmdualm_eidxR r s n hrs hs hr1) (Sum.inr (Sum.inr a)) := by
          rw [← h, Equiv.apply_symm_apply]
        rw [hi]; rfl
  have hcomp : (Sum.elim c (Sum.elim d e) ∘ (bmdualm_eidxR r s n hrs hs hr1).symm) ∘
      (bmdualm_eidxR r s n hrs hs hr1) = Sum.elim c (Sum.elim d e) := by
    funext k; simp
  rw [hw, bmdualm_reindex_mulVec, hcomp, bmdualm_blockMat_mulVec,
    bmdualm_explicit_hQ_decomp n f r s hrs hs hr1, bmdualm_quadPlus_sl_isometry]
  exact (bmdualm_explicit_hQ_decomp n f r s hrs hs hr1 c d e).symm

private def bmdualm_blockIndexR (r s : ℕ) (hr1 : 1 ≤ r) (c : Fin r ⊕ Fin r) :
    Fin (r - 1 + 1) ⊕ (Fin (r - 1 + 1) ⊕ Fin (2 * s)) :=
  Sum.map (finCongr (Nat.sub_add_cancel hr1).symm)
    (Sum.map (finCongr (Nat.sub_add_cancel hr1).symm) id) (bmdualm_blockIndex r s c)

private theorem bmdualm_eidxR_blockIndexR (r s n : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (hr1 : 1 ≤ r) (c : Fin r ⊕ Fin r) :
    bmdualm_eidxR r s n hrs hs hr1 (bmdualm_blockIndexR r s hr1 c) =
      bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s c) := by
  simp only [bmdualm_eidxR, bmdualm_blockIndexR, bmdualm_blockIndex, Equiv.trans_apply,
    Equiv.sumCongr_apply, Equiv.refl_apply, Sum.map_map, Function.comp_apply,
    Equiv.symm_apply_apply, Equiv.apply_symm_apply]
  rfl

private theorem bmdualm_explicit_hconv_inv (n f : ℕ) (g : ↥(spinGroup (bmdualmQ n f))) :
    (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) *
        (↑(bmdualmJ n f g⁻¹) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) = 1 ∧
      (↑(bmdualmJ n f g⁻¹) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) *
        (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) = 1 := by
  constructor
  · rw [← Units.val_mul, ← map_mul, mul_inv_cancel, map_one, Units.val_one]
  · rw [← Units.val_mul, ← map_mul, inv_mul_cancel, map_one, Units.val_one]

private theorem bmdualm_explicit_hconv_cols (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (hr1 : 1 ≤ r) {Pe : Matrix (bmdualmι n) (Fin r ⊕ Fin r) (GaloisField 2 f)}
    (g : ↥(spinGroup (bmdualmQ n f)))
    (hg : ∀ c : Fin r ⊕ Fin r,
      Spin.spinAction (bmdualmQ n f) g (Matrix.mulVec Pe (Pi.single c 1)) =
        Pi.single (bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s c)) 1) :
    (∀ c : Fin r ⊕ Fin r,
      Matrix.mulVec (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
          (Matrix.mulVec Pe (Pi.single c 1)) =
        Pi.single (bmdualm_eidxR r s n hrs hs hr1 (bmdualm_blockIndexR r s hr1 c)) 1) ∧
      (∀ c : Fin r ⊕ Fin r,
      Matrix.mulVec (↑(bmdualmJ n f g⁻¹) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
          (Pi.single (bmdualm_eidxR r s n hrs hs hr1 (bmdualm_blockIndexR r s hr1 c)) 1) =
        Matrix.mulVec Pe (Pi.single c 1)) := by
  constructor
  · intro c
    rw [show (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
        ↑(Spin.spinMatrix (bmdualmQ n f) g) from rfl]
    rw [Spin.spinMatrix_mulVec, hg c, ← bmdualm_eidxR_blockIndexR]
  · intro c
    rw [bmdualm_eidxR_blockIndexR]
    rw [show (↑(bmdualmJ n f g⁻¹) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
        ↑(Spin.spinMatrix (bmdualmQ n f) g⁻¹) from rfl]
    rw [Spin.spinMatrix_mulVec, ← hg c]
    simp only [← Spin.spinMatrix_mulVec]
    rw [Matrix.mulVec_mulVec,
      show (↑(Spin.spinMatrix (bmdualmQ n f) g⁻¹) :
            Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) *
          ↑(Spin.spinMatrix (bmdualmQ n f) g) = 1 from
        (bmdualm_explicit_hconv_inv n f g).2,
      Matrix.one_mulVec]

private theorem bmdualm_polar_P (n f : ℕ) (g : ↥(spinGroup (bmdualmQ n f)))
    (u v : bmdualmι n → GaloisField 2 f) :
    QuadraticMap.polar (bmdualmQ n f)
      (Matrix.mulVec (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) u)
      (Matrix.mulVec (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) v) =
      QuadraticMap.polar (bmdualmQ n f) u v := by
  have hm : ∀ w : bmdualmι n → GaloisField 2 f,
      bmdualmQ n f (Matrix.mulVec (↑(bmdualmJ n f g) :
        Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) w) = bmdualmQ n f w := by
    intro w
    rw [show (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)) =
        ↑(Spin.spinMatrix (bmdualmQ n f) g) from rfl]
    exact (Spin.spinMatrix_mem (bmdualmQ n f) g) w
  rw [QuadraticMap.polar, QuadraticMap.polar, ← Matrix.mulVec_add, hm, hm, hm]

private theorem bmdualm_explicit_D0_apply (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (hr1 : 1 ≤ r) :
    ∀ v : bmdualmι n → GaloisField 2 f,
      Matrix.mulVec (Matrix.reindex (bmdualm_eidxR r s n hrs hs hr1)
        (bmdualm_eidxR r s n hrs hs hr1)
        (bmdualm_D0 (r - 1 + 1) (2 * s) (GaloisField 2 f))) v =
      ∑ a, v ((bmdualm_eidxR r s n hrs hs hr1) (Sum.inl a)) •
        Pi.single ((bmdualm_eidxR r s n hrs hs hr1) (Sum.inl a)) 1 := by
  intro v
  rw [bmdualm_reindex_mulVec]
  have hbase : ∀ w : Fin (r - 1 + 1) ⊕ (Fin (r - 1 + 1) ⊕ Fin (2 * s)) → GaloisField 2 f,
      Matrix.mulVec (bmdualm_D0 (r - 1 + 1) (2 * s) (GaloisField 2 f)) w =
        ∑ a, w (Sum.inl a) • Pi.single (Sum.inl a) 1 := by
    intro w
    funext i
    rcases i with a | (b | k) <;>
      simp [bmdualm_D0, Matrix.fromBlocks, Matrix.mulVec, dotProduct, Fintype.sum_sum_type,
        Pi.single_apply, Finset.mul_sum, Finset.sum_mul, mul_comm, Matrix.one_apply]
  rw [hbase]
  funext i
  rw [Function.comp_apply, Finset.sum_apply]
  rcases hx : (bmdualm_eidxR r s n hrs hs hr1).symm i with a | (b | k)
  · have hi : i = (bmdualm_eidxR r s n hrs hs hr1) (Sum.inl a) := by
      rw [← hx, Equiv.apply_symm_apply]
    rw [hi, Finset.sum_eq_single a]
    · simp [Pi.single_apply]
    · intro a' _ ha'; simp [Pi.single_apply, ha']
    · intro h; exact absurd (Finset.mem_univ a) h
  · have hi : i = (bmdualm_eidxR r s n hrs hs hr1) (Sum.inr (Sum.inl b)) := by
      rw [← hx, Equiv.apply_symm_apply]
    rw [hi]
    rw [Finset.sum_eq_zero]
    · simp
    · intro a' _; simp [Pi.single_apply, bmdualm_eidxR_inl, bmdualm_eidxR_inr_inl]
  · have hi : i = (bmdualm_eidxR r s n hrs hs hr1) (Sum.inr (Sum.inr k)) := by
      rw [← hx, Equiv.apply_symm_apply]
    rw [hi]
    rw [Finset.sum_eq_zero]
    · simp
    · intro a' _; simp [Pi.single_apply, bmdualm_eidxR_inl]

private theorem bmdualm_explicit_e_decomp (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (hr1 : 1 ≤ r) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {Pe : Matrix (bmdualmι n) (Fin r ⊕ Fin r) (GaloisField 2 f)}
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualmι n → GaloisField 2 f,
      Matrix.mulVec (bmdualmeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Pe))
    (hee : e * e = e) (horth : e * bmdualmestar n f e = 0) :
    ∀ v : bmdualmι n → GaloisField 2 f, Matrix.mulVec e v =
      Matrix.mulVec Pe (Matrix.mulVec (Matrix.fromBlocks
        (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
        (Classical.choose (hPeSpan v))) := by
  intro v
  have hc := Classical.choose_spec (hPeSpan v)
  have hv : v = Matrix.mulVec (bmdualmeps n f e) v +
      Matrix.mulVec (1 - bmdualmeps n f e) v := by
    rw [← Matrix.add_mulVec, add_sub_cancel, Matrix.one_mulVec]
  have he1 : Matrix.mulVec e v = Matrix.mulVec e (Matrix.mulVec (bmdualmeps n f e) v) := by
    conv_lhs => rw [hv]
    rw [Matrix.mulVec_add, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
      show e * (1 - bmdualmeps n f e) = 0 from by
        rw [Matrix.mul_sub, Matrix.mul_one, show e * bmdualmeps n f e = e from by
          rw [show bmdualmeps n f e = e + bmdualmestar n f e from rfl, Matrix.mul_add, hee,
            horth, add_zero], sub_self],
      Matrix.zero_mulVec, add_zero]
  rw [he1]
  conv_lhs => rw [← hc]
  simp only [Matrix.mulVecLin_apply]
  rw [Matrix.mulVec_mulVec, hPee, Matrix.mulVec_mulVec]

private theorem bmdualm_explicit_estar_decomp (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (hr1 : 1 ≤ r) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {Pe : Matrix (bmdualmι n) (Fin r ⊕ Fin r) (GaloisField 2 f)}
    (hPees : bmdualmestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualmι n → GaloisField 2 f,
      Matrix.mulVec (bmdualmeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Pe))
    (hee : e * e = e) (horth' : bmdualmestar n f e * e = 0) :
    ∀ v : bmdualmι n → GaloisField 2 f, Matrix.mulVec (bmdualmestar n f e) v =
      Matrix.mulVec Pe (Matrix.mulVec (Matrix.fromBlocks
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
        (Classical.choose (hPeSpan v))) := by
  intro v
  have hc := Classical.choose_spec (hPeSpan v)
  have hv : v = Matrix.mulVec (bmdualmeps n f e) v +
      Matrix.mulVec (1 - bmdualmeps n f e) v := by
    rw [← Matrix.add_mulVec, add_sub_cancel, Matrix.one_mulVec]
  have he1 : Matrix.mulVec (bmdualmestar n f e) v =
      Matrix.mulVec (bmdualmestar n f e) (Matrix.mulVec (bmdualmeps n f e) v) := by
    conv_lhs => rw [hv]
    rw [Matrix.mulVec_add, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
      show bmdualmestar n f e * (1 - bmdualmeps n f e) = 0 from by
        rw [Matrix.mul_sub, Matrix.mul_one, show bmdualmestar n f e * bmdualmeps n f e =
            bmdualmestar n f e from by
          rw [show bmdualmeps n f e = e + bmdualmestar n f e from rfl, Matrix.mul_add,
            horth', zero_add, show bmdualmestar n f e * bmdualmestar n f e =
              bmdualmestar n f e from by
                rw [show bmdualmestar n f e * bmdualmestar n f e =
                    formAdj (RingHom.id (GaloisField 2 f)) (bmdualmG n f) (e * e) from
                    (Geo.formAdj_mul (RingHom.id (GaloisField 2 f))
                      (bmdualm_G_isUnit_det n f) e e).symm, hee]], sub_self],
      Matrix.zero_mulVec, add_zero]
  rw [he1]
  conv_lhs => rw [← hc]
  simp only [Matrix.mulVecLin_apply]
  rw [Matrix.mulVec_mulVec, hPees, Matrix.mulVec_mulVec]

private theorem bmdualm_explicit_ker_D0 (n f r s : ℕ) (hrs : r + s = n) (hs : 1 ≤ s)
    (hr1 : 1 ≤ r) {e : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f)}
    {Pe : Matrix (bmdualmι n) (Fin r ⊕ Fin r) (GaloisField 2 f)}
    (hPeε : bmdualmeps n f e * Pe = Pe)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualmestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualmι n → GaloisField 2 f,
      Matrix.mulVec (bmdualmeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Pe))
    (hee : e * e = e) (horth : e * bmdualmestar n f e = 0)
    (horth' : bmdualmestar n f e * e = 0)
    (g : ↥(spinGroup (bmdualmQ n f)))
    (hg : ∀ c : Fin r ⊕ Fin r,
      Spin.spinAction (bmdualmQ n f) g (Matrix.mulVec Pe (Pi.single c 1)) =
        Pi.single (bmdualm_eidx r s n hrs hs (bmdualm_blockIndex r s c)) 1) :
    ∀ u : bmdualmι n → GaloisField 2 f, Matrix.mulVec (bmdualmeps n f e) u = 0 →
      Matrix.mulVec (Matrix.reindex (bmdualm_eidxR r s n hrs hs hr1)
        (bmdualm_eidxR r s n hrs hs hr1)
        (bmdualm_D0 (r - 1 + 1) (2 * s) (GaloisField 2 f)))
        (Matrix.mulVec (↑(bmdualmJ n f g) : Matrix (bmdualmι n) (bmdualmι n)
          (GaloisField 2 f)) u) = 0 := by
  intro u hu
  have hpol_inr : ∀ (w : bmdualmι n → GaloisField 2 f) (a : Fin (r - 1 + 1)),
      QuadraticMap.polar (bmdualmQ n f) w
        (Pi.single ((bmdualm_eidxR r s n hrs hs hr1) (Sum.inr (Sum.inl a))) 1) =
      w ((bmdualm_eidxR r s n hrs hs hr1) (Sum.inl a)) := by
    intro w a
    rw [bmdualm_polar_eq_dot,
      show (LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (bmdualmQ n f))) =
        bmdualmG n f from rfl, Matrix.mulVec_single_one, dotProduct]
    simp only [Matrix.col_apply]
    rw [Finset.sum_eq_single ((bmdualm_eidxR r s n hrs hs hr1) (Sum.inl a))]
    · rw [bmdualm_eidxR_inr_inl, bmdualm_G_any_inr_inl, if_pos (by rw [bmdualm_eidxR_inl])]
      simp
    · intro k _ hk
      rw [bmdualm_eidxR_inr_inl, bmdualm_G_any_inr_inl,
        if_neg (fun h => hk (by rw [h, bmdualm_eidxR_inl]))]
      simp
    · exact fun h => absurd (Finset.mem_univ _) h
  have hadj : ∀ (a : Matrix (bmdualmι n) (bmdualmι n) (GaloisField 2 f))
      (x w : bmdualmι n → GaloisField 2 f),
      dotProduct (Matrix.mulVec a x) (Matrix.mulVec (bmdualmG n f) w) =
        dotProduct x (Matrix.mulVec (bmdualmG n f)
          (Matrix.mulVec (bmdualmestar n f a) w)) := by
    intro a x w
    have h2 : (bmdualmG n f) * ((bmdualmG n f)⁻¹ * Matrix.transpose a * (bmdualmG n f)) =
        Matrix.transpose a * (bmdualmG n f) := by
      simp only [← Matrix.mul_assoc, Matrix.mul_nonsing_inv (bmdualmG n f)
        (bmdualm_G_isUnit_det n f), Matrix.one_mul]
    rw [show bmdualmestar n f a =
        (bmdualmG n f)⁻¹ * Matrix.transpose a * (bmdualmG n f) from rfl]
