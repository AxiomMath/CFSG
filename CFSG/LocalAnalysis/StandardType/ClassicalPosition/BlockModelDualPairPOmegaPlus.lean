private abbrev bmdualι (n : ℕ) : Type := Fin n ⊕ Fin n

private noncomputable abbrev bmdualQ (n : ℕ) (F : Type) [Field F] :
    QuadraticForm F (bmdualι n → F) :=
  Spin.quadPlus n F

private noncomputable abbrev bmdualG (n : ℕ) (F : Type) [Field F] :
    Matrix (bmdualι n) (bmdualι n) F :=
  LinearMap.toMatrix₂' F (QuadraticMap.polarBilin (bmdualQ n F))

private noncomputable abbrev bmdualA (n : ℕ) (F : Type) [Field F] (S : Set (GL (bmdualι n) F)) :
    Subalgebra F (Matrix (bmdualι n) (bmdualι n) F) :=
  Algebra.adjoin F (Units.val '' S)

private noncomputable abbrev bmdualJ (n : ℕ) (F : Type) [Field F] :
    ↥(spinGroup (bmdualQ n F)) →* GL (bmdualι n) F :=
  Spin.spinMatrix (bmdualQ n F)

private noncomputable abbrev bmdualestar (n f : ℕ)
    (e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) :
    Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f) :=
  formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) e

private noncomputable abbrev bmdualeps (n f : ℕ)
    (e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) :
    Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f) :=
  e + bmdualestar n f e

private noncomputable abbrev bmdualrange (n f : ℕ)
    (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) :
    Subgroup ↥(spinGroup (bmdualQ n (GaloisField 2 f))) :=
  ⁅glBlockCentralizer (bmdualJ n (GaloisField 2 f)) S (bmdualeps n f e),
    glBlockCentralizer (bmdualJ n (GaloisField 2 f)) S (bmdualeps n f e)⁆

private def bmdual_scalarAction (n f : ℕ)
    (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) : Prop :=
  ∀ s ∈ S, ∃ c : GaloisField 2 f, c ≠ 0 ∧
    (s : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) * e = c • e ∧
    (s : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) * bmdualestar n f e =
      c⁻¹ • bmdualestar n f e

private theorem bmdual_formAdj_zero {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (σ : F →+* F) (G : Matrix ι ι F) : formAdj σ G 0 = 0 := by
  unfold formAdj
  rw [Matrix.map_zero σ (map_zero σ), Matrix.transpose_zero, Matrix.mul_zero, Matrix.zero_mul]

private lemma bmdual_adjoin_comm {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    {S : Set (GL ι F)} (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s') :
    ∀ a ∈ Algebra.adjoin F (Units.val '' S), ∀ b ∈ Algebra.adjoin F (Units.val '' S),
      Commute a b := by
  intro a ha b hb
  have hgen : (Units.val '' S : Set (Matrix ι ι F)) ⊆
      (Subalgebra.centralizer F (Units.val '' S) : Set (Matrix ι ι F)) := by
    rintro x ⟨s, hs, rfl⟩
    refine (Subalgebra.mem_centralizer_iff F).mpr ?_
    intro y hy
    rcases hy with ⟨s', hs', rfl⟩
    have h := congrArg (fun u : GL ι F => (u : Matrix ι ι F)) (hS s' hs' s hs).eq
    simpa [Units.val_mul] using h
  have hA : Algebra.adjoin F (Units.val '' S) ≤ Subalgebra.centralizer F (Units.val '' S) :=
    Algebra.adjoin_le hgen
  have ha' : a ∈ Subalgebra.centralizer F (Units.val '' S) := hA ha
  have hgen2 : (Units.val '' S : Set (Matrix ι ι F)) ⊆
      (Subalgebra.centralizer F ({a} : Set (Matrix ι ι F)) : Set (Matrix ι ι F)) := by
    rintro x ⟨s, hs, rfl⟩
    refine (Subalgebra.mem_centralizer_iff F).mpr ?_
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    have h := (Subalgebra.mem_centralizer_iff F).mp ha' (s : Matrix ι ι F) ⟨s, hs, rfl⟩
    exact h.symm
  have hA2 : Algebra.adjoin F (Units.val '' S) ≤
      Subalgebra.centralizer F ({a} : Set (Matrix ι ι F)) := Algebra.adjoin_le hgen2
  have hb' : b ∈ Subalgebra.centralizer F ({a} : Set (Matrix ι ι F)) := hA2 hb
  exact (Subalgebra.mem_centralizer_iff F).mp hb' a (Set.mem_singleton a)

private theorem bmdual_blockDegree_eq_one
    (n f : ℕ) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hdeg : blockDegree (bmdualA n (GaloisField 2 f) S) e < 2) :
    blockDegree (bmdualA n (GaloisField 2 f) S) e = 1 := by
  let M : Submodule (GaloisField 2 f)
      (Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) :=
    (Subalgebra.toSubmodule (bmdualA n (GaloisField 2 f) S)).map
      (LinearMap.mulRight (GaloisField 2 f) e)
  have heM : e ∈ M := ⟨e, he.1, by rw [LinearMap.mulRight_apply, he.2.1.eq]⟩
  have hbot : (⊥ : Submodule (GaloisField 2 f)
      (Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))) < M := by
    refine lt_of_le_of_ne bot_le ?_
    intro h
    have he0 : e ∈ (⊥ : Submodule (GaloisField 2 f) _) := by rw [h]; exact heM
    exact he.2.2.1 (by simpa using he0)
  have hpos : 0 < blockDegree (bmdualA n (GaloisField 2 f) S) e := by
    have hlt := Submodule.finrank_lt_finrank_of_lt hbot
    rw [finrank_bot] at hlt
    exact hlt
  omega

private theorem bmdual_action_is_scalar
    (n f : ℕ) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hdeg : blockDegree (bmdualA n (GaloisField 2 f) S) e = 1)
    {a : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (ha : a ∈ bmdualA n (GaloisField 2 f) S) :
    ∃ c : GaloisField 2 f, a * e = c • e := by
  let M : Submodule (GaloisField 2 f)
      (Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) :=
    (Subalgebra.toSubmodule (bmdualA n (GaloisField 2 f) S)).map
      (LinearMap.mulRight (GaloisField 2 f) e)
  have hMdeg : Module.finrank (GaloisField 2 f) M = 1 := hdeg
  have heM : e ∈ M := ⟨e, he.1, by rw [LinearMap.mulRight_apply, he.2.1.eq]⟩
  have hene : (⟨e, heM⟩ : M) ≠ 0 := by
    intro h
    exact he.2.2.1 (by simpa using congrArg Subtype.val h)
  have haM : a * e ∈ M := ⟨a, ha, by rw [LinearMap.mulRight_apply]⟩
  obtain ⟨c, hc⟩ := (finrank_eq_one_iff_of_nonzero' (⟨e, heM⟩ : M) hene).mp hMdeg
    (⟨a * e, haM⟩ : M)
  exact ⟨c, by simpa using congrArg Subtype.val hc.symm⟩

private theorem bmdual_block_scalar
    (n f : ℕ) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hdeg : blockDegree (bmdualA n (GaloisField 2 f) S) e < 2) :
    blockDegree (bmdualA n (GaloisField 2 f) S) e = 1 ∧
      ∀ a ∈ bmdualA n (GaloisField 2 f) S, ∃ c : GaloisField 2 f, a * e = c • e := by
  have h1 := bmdual_blockDegree_eq_one n f S he hdeg
  exact ⟨h1, fun a ha => bmdual_action_is_scalar n f S he h1 ha⟩

private theorem bmdual_G_symmetric (n : ℕ) (F : Type) [Field F] :
    Matrix.transpose (bmdualG n F) = bmdualG n F := by
  rw [show bmdualG n F =
      LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin (bmdualQ n F)) from rfl]
  exact (LinearMap.BilinForm.isSymm_toMatrix'_iff_isSymm).mpr
    (LinearMap.BilinForm.IsSymm.mk (fun x y => QuadraticMap.polar_comm _ x y))

private theorem bmdual_G_symmetric_map (n : ℕ) (F : Type) [Field F] :
    Matrix.transpose ((bmdualG n F).map (RingHom.id F)) = bmdualG n F := by
  rw [show (⇑(RingHom.id F) : F → F) = id from rfl, Matrix.map_id]
  exact bmdual_G_symmetric n F

private theorem bmdual_G_isUnit_det (n : ℕ) {F : Type} [Field F] [Finite F] :
    IsUnit (bmdualG n F).det := by
  have hnd := Spin.nondegenerate_polarBilin_quadPlus n F
  have h1 : bmdualG n F =
      LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin (bmdualQ n F)) := rfl
  rw [h1]
  exact isUnit_iff_ne_zero.mpr (Matrix.nondegenerate_iff_det_ne_zero.mp
    ((LinearMap.BilinForm.nondegenerate_toMatrix'_iff).mpr hnd))

private theorem bmdual_spinMatrix_isometry (n : ℕ) (F : Type) [Field F]
    (x : ↥(spinGroup (bmdualQ n F))) (v : bmdualι n → F) :
    bmdualQ n F (Matrix.mulVec ((bmdualJ n F x : GL (bmdualι n) F) :
      Matrix (bmdualι n) (bmdualι n) F) v) = bmdualQ n F v := by
  exact Spin.spinMatrix_mem (bmdualQ n F) x v

private lemma bmdual_polar_eq_dot {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (Q : QuadraticForm F (ι → F)) (x y : ι → F) :
    QuadraticMap.polar Q x y =
      dotProduct x ((LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)).mulVec y) := by
  have h1 : (LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q)) =
      LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin Q) := rfl
  rw [h1]
  rw [← Matrix.toBilin'_apply' (LinearMap.BilinForm.toMatrix' (QuadraticMap.polarBilin Q)) x y,
    Matrix.toBilin'_toMatrix', QuadraticMap.polarBilin_apply_apply]

private lemma bmdual_isometry_of_quad {ι F : Type} [Fintype ι] [DecidableEq ι] [Field F]
    (Q : QuadraticForm F (ι → F)) (M : Matrix ι ι F)
    (hM : ∀ x : ι → F, Q (M.mulVec x) = Q x) :
    M.transpose * LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q) * M =
      LinearMap.toMatrix₂' F (QuadraticMap.polarBilin Q) := by
  have hpol : ∀ x y, QuadraticMap.polar Q (M.mulVec x) (M.mulVec y) =
      QuadraticMap.polar Q x y := by
    intro x y
    rw [QuadraticMap.polar, QuadraticMap.polar, ← Matrix.mulVec_add, hM (x + y), hM x, hM y]
  apply (LinearEquiv.injective Matrix.toBilin')
  apply LinearMap.ext
  intro x
  apply LinearMap.ext
  intro y
  rw [Matrix.toBilin'_apply', Matrix.toBilin'_apply']
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
    Matrix.vecMul_transpose, ← bmdual_polar_eq_dot Q (M.mulVec x) (M.mulVec y),
    ← bmdual_polar_eq_dot Q x y]
  exact hpol x y

private theorem bmdual_statedSpin_isometry (n f : ℕ)
    (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ (bmdualJ n (GaloisField 2 f)).range) :
    ∀ s ∈ S, Matrix.transpose ((s : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)).map
        (RingHom.id (GaloisField 2 f))) * bmdualG n (GaloisField 2 f) *
      (s : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) = bmdualG n (GaloisField 2 f) := by
  intro s hs
  obtain ⟨x, rfl⟩ := hSU s hs
  have hQ : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        ((bmdualJ n (GaloisField 2 f) x : GL (bmdualι n) (GaloisField 2 f)) :
          Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) v) =
        bmdualQ n (GaloisField 2 f) v := bmdual_spinMatrix_isometry n _ x
  simpa [Matrix.map_id] using bmdual_isometry_of_quad (bmdualQ n (GaloisField 2 f))
    ((bmdualJ n (GaloisField 2 f) x : GL (bmdualι n) (GaloisField 2 f)) :
      Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) hQ

private theorem bmdual_dualPair_data
    (n f : ℕ) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ (bmdualJ n (GaloisField 2 f)).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hpair : bmdualestar n f e ≠ e) :
    e * bmdualestar n f e = 0 ∧ bmdualestar n f e * e = 0 ∧
      IsIdempotentElem (bmdualeps n f e) ∧
      IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e) := by
  have hG : IsUnit (bmdualG n (GaloisField 2 f)).det := bmdual_G_isUnit_det n
  have hGh : Matrix.transpose ((bmdualG n (GaloisField 2 f)).map (RingHom.id (GaloisField 2 f))) =
      bmdualG n (GaloisField 2 f) := by
    rw [show (⇑(RingHom.id (GaloisField 2 f)) : GaloisField 2 f → GaloisField 2 f) = id
      from rfl, Matrix.map_id]
    exact bmdual_G_symmetric n (GaloisField 2 f)
  have hSU' := bmdual_statedSpin_isometry n f S hSU
  obtain ⟨horth1, horth2⟩ := Geo.mul_formAdj_eq_zero_of_dualPair (RingHom.id (GaloisField 2 f))
    (fun x => rfl) hG hGh hSU' hS he hpair
  have hstar_idem : IsIdempotentElem (bmdualestar n f e) := by
    show bmdualestar n f e * bmdualestar n f e = bmdualestar n f e
    rw [← Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) hG e e, he.2.1.eq]
  have hstarA : bmdualestar n f e ∈ bmdualA n (GaloisField 2 f) S :=
    Geo.formAdj_mem_adjoin (RingHom.id (GaloisField 2 f)) hG hSU' he.1
  have hstar_ne : bmdualestar n f e ≠ 0 := by
    intro h0
    have he0 : e = 0 := by
      calc e = formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f))
            (bmdualestar n f e) :=
            (Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl) hG hGh e).symm
        _ = formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) 0 := by rw [h0]
        _ = 0 := bmdual_formAdj_zero (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f))
    exact he.2.2.1 he0
  have hprim : ∀ e' ∈ bmdualA n (GaloisField 2 f) S, IsIdempotentElem e' →
      e' * bmdualestar n f e = e' → e' = 0 ∨ e' = bmdualestar n f e := by
    intro e' he'A he'idem he'e
    have he'e' : bmdualestar n f e * e' = e' := by
      rw [← (bmdual_adjoin_comm hS e' he'A (bmdualestar n f e) hstarA).eq, he'e]
    have hformA : formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) e' ∈
        bmdualA n (GaloisField 2 f) S :=
      Geo.formAdj_mem_adjoin (RingHom.id (GaloisField 2 f)) hG hSU' he'A
    have hformidem : IsIdempotentElem
        (formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) e') := by
      show formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) e' *
        formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) e' =
        formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) e'
      rw [← Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) hG e' e', he'idem.eq]
    have hform_eq : formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) e' * e =
        formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) e' := by
      have h := congrArg (formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)))
        he'e'
      rw [Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) hG (bmdualestar n f e) e'] at h
      rwa [Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl) hG hGh e] at h
    rcases he.2.2.2 (formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) e')
      hformA hformidem hform_eq with h0 | heq
    · left
      have h := congrArg (formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f))) h0
      rw [Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl) hG hGh e'] at h
      rw [h, bmdual_formAdj_zero (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f))]
    · right
      have h := congrArg (formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f))) heq
      rwa [Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl) hG hGh e'] at h
  have heps_idem : IsIdempotentElem (bmdualeps n f e) := by
    show IsIdempotentElem (e + bmdualestar n f e)
    refine IsIdempotentElem.add he.2.1 hstar_idem ?_
    rw [horth1, horth2, add_zero]
  exact ⟨horth1, horth2, heps_idem, hstarA, hstar_idem, hstar_ne, hprim⟩

private theorem bmdual_generator_scalar
    (n f : ℕ) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ (bmdualJ n (GaloisField 2 f)).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hdeg : blockDegree (bmdualA n (GaloisField 2 f) S) e < 2) :
    bmdual_scalarAction n f S e := by
  have hdeg1 : blockDegree (bmdualA n (GaloisField 2 f) S) e = 1 :=
    (bmdual_block_scalar n f S he hdeg).1
  intro s hs
  exact Geo.exists_eigen_of_dualPair (RingHom.id (GaloisField 2 f)) (fun x => rfl)
    (bmdual_G_isUnit_det n) (bmdual_G_symmetric n (GaloisField 2 f))
    (bmdual_statedSpin_isometry n f S hSU) hS he hdeg1 hs

private theorem bmdual_block_quad_zero
    (n f : ℕ) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ (bmdualJ n (GaloisField 2 f)).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hpair : bmdualestar n f e ≠ e)
    (hdeg : blockDegree (bmdualA n (GaloisField 2 f) S) e < 2) :
    ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0 := by
  have hdeg1 : blockDegree (bmdualA n (GaloisField 2 f) S) e = 1 :=
    (bmdual_block_scalar n f S he hdeg).1
  obtain ⟨s, hs, c, hse, hc⟩ := Geo.exists_eigen_mul_ne_one_of_dualPair
    (RingHom.id (GaloisField 2 f)) (fun x => rfl) (bmdual_G_isUnit_det n)
    (bmdual_G_symmetric n (GaloisField 2 f)) (bmdual_statedSpin_isometry n f S hSU) hS he hdeg1
        hpair
  intro x
  obtain ⟨u, rfl⟩ := hSU s hs
  have hiso : bmdualQ n (GaloisField 2 f) (Matrix.mulVec
      ((bmdualJ n (GaloisField 2 f) u : GL (bmdualι n) (GaloisField 2 f)) :
        Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) (Matrix.mulVec e x)) =
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) :=
    bmdual_spinMatrix_isometry n _ u (Matrix.mulVec e x)
  have hsm : Matrix.mulVec ((bmdualJ n (GaloisField 2 f) u :
      GL (bmdualι n) (GaloisField 2 f)) : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
      (Matrix.mulVec e x) = c • Matrix.mulVec e x := by
    rw [Matrix.mulVec_mulVec, hse, Matrix.smul_mulVec]
  rw [hsm] at hiso
  have hiso' : c ^ 2 * bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) =
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) := by
    simpa [QuadraticMap.map_smul, smul_eq_mul, pow_two] using hiso
  have hcne : c ^ 2 - 1 ≠ 0 := sub_ne_zero.mpr (by rwa [pow_two])
  have hsub : (c ^ 2 - 1) * bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0 := by
    rw [sub_mul, one_mul, hiso', sub_self]
  exact (mul_eq_zero.mp hsub).resolve_left hcne

private theorem bmdual_star_block_quad_zero
    (n f : ℕ) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hSU : ∀ s ∈ S, s ∈ (bmdualJ n (GaloisField 2 f)).range)
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hpair : bmdualestar n f e ≠ e)
    (hdeg : blockDegree (bmdualA n (GaloisField 2 f) S) e < 2) :
    ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0 := by
  have hdeg1 : blockDegree (bmdualA n (GaloisField 2 f) S) e = 1 :=
    (bmdual_block_scalar n f S he hdeg).1
  obtain ⟨s, hs, c, hse, hc⟩ := Geo.exists_eigen_mul_ne_one_of_dualPair
    (RingHom.id (GaloisField 2 f)) (fun x => rfl) (bmdual_G_isUnit_det n)
    (bmdual_G_symmetric n (GaloisField 2 f)) (bmdual_statedSpin_isometry n f S hSU) hS he hdeg1
        hpair
  obtain ⟨c', hc'0, hse', hse'star⟩ := Geo.exists_eigen_of_dualPair
    (RingHom.id (GaloisField 2 f)) (fun x => rfl) (bmdual_G_isUnit_det n)
    (bmdual_G_symmetric n (GaloisField 2 f)) (bmdual_statedSpin_isometry n f S hSU) hS he hdeg1 hs
  have hcc : c = c' := by
    have h : (c - c') • e = 0 := by rw [sub_smul, ← hse, hse', sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp h).resolve_right he.2.2.1)
  have hstar : s * bmdualestar n f e = c⁻¹ • bmdualestar n f e := by
    rw [← hcc] at hse'star; exact hse'star
  intro x
  obtain ⟨u, rfl⟩ := hSU s hs
  have hiso : bmdualQ n (GaloisField 2 f) (Matrix.mulVec
      ((bmdualJ n (GaloisField 2 f) u : GL (bmdualι n) (GaloisField 2 f)) :
        Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
      (Matrix.mulVec (bmdualestar n f e) x)) =
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) :=
    bmdual_spinMatrix_isometry n _ u (Matrix.mulVec (bmdualestar n f e) x)
  have hsm : Matrix.mulVec ((bmdualJ n (GaloisField 2 f) u :
      GL (bmdualι n) (GaloisField 2 f)) : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
      (Matrix.mulVec (bmdualestar n f e) x) = c⁻¹ • Matrix.mulVec (bmdualestar n f e) x := by
    rw [Matrix.mulVec_mulVec, hstar, Matrix.smul_mulVec]
  rw [hsm] at hiso
  have hiso' : (c⁻¹) ^ 2 * bmdualQ n (GaloisField 2 f)
      (Matrix.mulVec (bmdualestar n f e) x) =
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) := by
    simpa [QuadraticMap.map_smul, smul_eq_mul, pow_two, mul_inv_rev] using hiso
  have hc1 : c ≠ 1 := fun h => hc (by simp [h])
  have hcne : (c⁻¹) ^ 2 - 1 ≠ 0 := by
    have hne : c⁻¹ - 1 ≠ 0 := sub_ne_zero.mpr (fun h => hc1 (inv_eq_one.mp h))
    have hsq : (c⁻¹) ^ 2 - 1 = (c⁻¹ - 1) ^ 2 := by
      rw [CharTwo.sub_eq_add, CharTwo.sub_eq_add, add_sq,
        show (2 : GaloisField 2 f) = 0 from CharP.cast_eq_zero _ 2]
      ring
    rw [hsq]
    exact pow_ne_zero 2 hne
  have hsub : ((c⁻¹) ^ 2 - 1) * bmdualQ n (GaloisField 2 f)
      (Matrix.mulVec (bmdualestar n f e) x) = 0 := by
    rw [sub_mul, one_mul, hiso', sub_self]
  exact (mul_eq_zero.mp hsub).resolve_left hcne

private noncomputable abbrev bmdual_D0 (r r' : ℕ) (F : Type) [Zero F] [One F] :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F :=
  Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) F)
    (0 : Matrix (Fin r) (Fin r ⊕ Fin r') F)
    (0 : Matrix (Fin r ⊕ Fin r') (Fin r) F)
    (Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
      (0 : Matrix (Fin r) (Fin r') F) (0 : Matrix (Fin r') (Fin r) F)
      (0 : Matrix (Fin r') (Fin r') F))

private noncomputable def bmdual_blockMat (n f r r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f) :=
  Matrix.fromBlocks (x : Matrix (Fin r) (Fin r) (GaloisField 2 f))
    (0 : Matrix (Fin r) (Fin r ⊕ Fin r') (GaloisField 2 f))
    (0 : Matrix (Fin r ⊕ Fin r') (Fin r) (GaloisField 2 f))
    (Matrix.fromBlocks
      (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
        Matrix (Fin r) (Fin r) (GaloisField 2 f)))
      (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))

private theorem bmdual_eps_adjoint (n f : ℕ)
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    Matrix.transpose (bmdualeps n f e) * bmdualG n (GaloisField 2 f) =
      bmdualG n (GaloisField 2 f) * bmdualeps n f e := by
  have hfix0 : formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) (bmdualeps n f
      e) =
      bmdualeps n f e := by
    rw [bmdualeps, bmdualestar,
      Geo.formAdj_add (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) e
        (formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) e),
      Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl)
        (bmdual_G_isUnit_det n) (bmdual_G_symmetric_map n (GaloisField 2 f)) e]
    abel
  have hfix : (bmdualG n (GaloisField 2 f))⁻¹ * Matrix.transpose (bmdualeps n f e) * bmdualG n
      (GaloisField 2 f) =
      bmdualeps n f e := by
    simpa [formAdj] using hfix0
  have h2 : bmdualG n (GaloisField 2 f) *
      ((bmdualG n (GaloisField 2 f))⁻¹ * Matrix.transpose (bmdualeps n f e) * bmdualG n (GaloisField
          2 f)) =
        bmdualG n (GaloisField 2 f) * bmdualeps n f e := by rw [hfix]
  rw [← Matrix.mul_assoc, ← Matrix.mul_assoc,
    Matrix.mul_nonsing_inv _ (bmdual_G_isUnit_det n), Matrix.one_mul] at h2
  exact h2

private theorem bmdual_dualMap_apply_zero (n f r : ℕ)
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (c : Module.Dual (GaloisField 2 f) (Fin r → GaloisField 2 f))
    (hc : (Matrix.mulVecLin (Matrix.transpose We * bmdualG n (GaloisField 2 f))).dualMap c = 0) :
    ∀ v : Fin n ⊕ Fin n → GaloisField 2 f,
      c (Matrix.mulVec (Matrix.transpose We * bmdualG n (GaloisField 2 f)) v) = 0 := by
  intro v
  have h := DFunLike.congr_fun hc v
  simpa only [LinearMap.dualMap_apply, Matrix.mulVecLin_apply, LinearMap.zero_apply] using h

private theorem bmdual_dualMap_ker_vec (n f r : ℕ)
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (c : Module.Dual (GaloisField 2 f) (Fin r → GaloisField 2 f))
    (hc : ∀ v : Fin n ⊕ Fin n → GaloisField 2 f,
      c (Matrix.mulVec (Matrix.transpose We * bmdualG n (GaloisField 2 f)) v) = 0) :
    Matrix.mulVec We (fun j => c (Pi.single j 1)) = 0 := by
  ext i
  have h := hc (Matrix.mulVec (bmdualG n (GaloisField 2 f))⁻¹ (Pi.single i 1))
  have h1 : Matrix.mulVec (Matrix.transpose We * bmdualG n (GaloisField 2 f))
        (Matrix.mulVec (bmdualG n (GaloisField 2 f))⁻¹ (Pi.single i 1)) =
      Matrix.mulVec (Matrix.transpose We) (Pi.single i 1) := by
    rw [Matrix.mulVec_mulVec, Matrix.mul_assoc,
      Matrix.mul_nonsing_inv _ (bmdual_G_isUnit_det n), Matrix.mul_one]
  rw [h1] at h
  have h2 : (Matrix.mulVec We (fun j => c (Pi.single j 1))) i =
      c (Matrix.mulVec (Matrix.transpose We) (Pi.single i 1)) := by
    rw [show Matrix.mulVec (Matrix.transpose We) (Pi.single i 1) =
        ∑ j, We i j • Pi.single j 1 from by
      ext k
      simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply, Finset.sum_apply,
        Pi.smul_apply, smul_eq_mul]
      rw [Fintype.sum_eq_single i (fun m hm => by simp [Pi.single_eq_of_ne hm])]
      rw [Fintype.sum_eq_single k (fun m hm => by simp [Pi.single_eq_of_ne (Ne.symm hm)])]
      simp]
    rw [map_sum]
    simp only [map_smul, Matrix.mulVec, dotProduct]
    apply Finset.sum_congr rfl
    intro j _
    ring
  rw [h2]
  exact h

private theorem bmdual_dualMap_injective (n f r : ℕ)
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hinj : Function.Injective (fun c : Fin r → GaloisField 2 f => Matrix.mulVec We c)) :
    Function.Injective (Matrix.mulVecLin (Matrix.transpose We * bmdualG n (GaloisField 2
        f))).dualMap := by
  intro c c' hcc
  have hzero : Matrix.mulVec We (fun j => (c - c') (Pi.single j 1)) = 0 := by
    apply bmdual_dualMap_ker_vec n f r We (c - c')
    intro v
    have h : (Matrix.mulVecLin (Matrix.transpose We * bmdualG n (GaloisField 2 f))).dualMap (c - c')
        = 0 := by
      rw [map_sub, hcc, sub_self]
    exact bmdual_dualMap_apply_zero n f r We (c - c') h v
  have hcvec : (fun j => (c - c') (Pi.single j 1)) = 0 := by
    apply hinj
    simpa using hzero
  have hsub : c - c' = 0 := by
    apply LinearMap.ext
    intro w
    have hw : w = ∑ j, w j • Pi.single j 1 := by
      ext k
      rw [Finset.sum_apply]
      simp only [Pi.smul_apply, smul_eq_mul]
      rw [Fintype.sum_eq_single k (fun m hm => by simp [Pi.single_eq_of_ne (Ne.symm hm)])]
      simp
    rw [hw, map_sum]
    apply Finset.sum_eq_zero
    intro j _
    rw [map_smul, congrFun hcvec j]
    simp
  exact sub_eq_zero.mp hsub

private theorem bmdual_mulVec_transpose_surjective (n f r : ℕ)
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hinj : Function.Injective (fun c : Fin r → GaloisField 2 f => Matrix.mulVec We c)) :
    Function.Surjective (fun v : Fin n ⊕ Fin n → GaloisField 2 f =>
      Matrix.mulVec (Matrix.transpose We * bmdualG n (GaloisField 2 f)) v) := by
  change Function.Surjective (Matrix.mulVecLin (Matrix.transpose We * bmdualG n (GaloisField 2 f)))
  rw [← LinearMap.dualMap_injective_iff]
  exact bmdual_dualMap_injective n f r We hinj

private theorem bmdual_exists_rightInverse_of_columns (n f r : ℕ)
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hinj : Function.Injective (fun c : Fin r → GaloisField 2 f => Matrix.mulVec We c)) :
    ∃ V : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f),
      Matrix.transpose We * bmdualG n (GaloisField 2 f) * V = 1 :=
  Matrix.mulVec_surjective_iff_exists_right_inverse.mp
    (bmdual_mulVec_transpose_surjective n f r We hinj)

private theorem bmdual_estar_mul_dual (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (We V : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWe : e * We = We) (hV : Matrix.transpose We * bmdualG n (GaloisField 2 f) * V = 1)
    (hstar : bmdualestar n f e * bmdualestar n f e = bmdualestar n f e) :
    bmdualestar n f e * (bmdualestar n f e * V) = bmdualestar n f e * V ∧
      Matrix.transpose We * bmdualG n (GaloisField 2 f) * (bmdualestar n f e * V) = 1 := by
  have hestar : bmdualestar n f e = (bmdualG n (GaloisField 2 f))⁻¹ * Matrix.transpose e * bmdualG n
      (GaloisField 2 f) := by
    simp only [bmdualestar, formAdj]
    rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
      congrArg Matrix.transpose (Matrix.map_id e)]
  have hJ : bmdualG n (GaloisField 2 f) * bmdualestar n f e = Matrix.transpose e * bmdualG n
      (GaloisField 2 f) := by
    rw [hestar]
    calc bmdualG n (GaloisField 2 f) * ((bmdualG n (GaloisField 2 f))⁻¹ * Matrix.transpose e *
        bmdualG n (GaloisField 2 f))
        = (bmdualG n (GaloisField 2 f) * (bmdualG n (GaloisField 2 f))⁻¹) * (Matrix.transpose e *
            bmdualG n (GaloisField 2 f)) := by
          noncomm_ring
      _ = Matrix.transpose e * bmdualG n (GaloisField 2 f) := by
          rw [Matrix.mul_nonsing_inv _ (bmdual_G_isUnit_det n), Matrix.one_mul]
  have hWs : Matrix.transpose We * bmdualG n (GaloisField 2 f) * bmdualestar n f e =
      Matrix.transpose We * bmdualG n (GaloisField 2 f) := by
    calc Matrix.transpose We * bmdualG n (GaloisField 2 f) * bmdualestar n f e
        = Matrix.transpose We * (bmdualG n (GaloisField 2 f) * bmdualestar n f e) := by rw
            [Matrix.mul_assoc]
      _ = Matrix.transpose We * (Matrix.transpose e * bmdualG n (GaloisField 2 f)) := by rw [hJ]
      _ = (Matrix.transpose We * Matrix.transpose e) * bmdualG n (GaloisField 2 f) := by rw
          [Matrix.mul_assoc]
      _ = Matrix.transpose (e * We) * bmdualG n (GaloisField 2 f) := by rw [← Matrix.transpose_mul]
      _ = Matrix.transpose We * bmdualG n (GaloisField 2 f) := by rw [hWe]
  constructor
  · rw [← Matrix.mul_assoc, hstar]
  · rw [← Matrix.mul_assoc, hWs, hV]

private noncomputable def bmdual_blockCols {n f r : ℕ}
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f)) :
    Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f) :=
  Matrix.of fun i j => Sum.elim (fun a => We i a) (fun b => Ws i b) j

private theorem bmdual_adapted_Pe_form_11 (n f r : ℕ)
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWeIso : Matrix.transpose We * bmdualG n (GaloisField 2 f) * We = 0) (a a' : Fin r) :
    (Matrix.transpose (bmdual_blockCols We Ws) * bmdualG n (GaloisField 2 f) * bmdual_blockCols We
        Ws)
        (Sum.inl a) (Sum.inl a') = bmdualG r (GaloisField 2 f) (Sum.inl a) (Sum.inl a') := by
  have h := congrFun (congrFun hWeIso a) a'
  simp only [Matrix.zero_apply] at h
  rw [show bmdualG r (GaloisField 2 f) (Sum.inl a) (Sum.inl a') = 0 from by
    simp [bmdualG, Matrix.fromBlocks, Spin.polar_quadPlus, Pi.single_apply, Finset.sum_ite_eq',
        Matrix.one_apply,
      Sum.inl_injective.eq_iff, Sum.inr_injective.eq_iff, eq_comm]]
  rw [← h]
  simp only [bmdual_blockCols, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Finset.sum_apply, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr]

private theorem bmdual_adapted_Pe_form_12 (n f r : ℕ)
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hdual : Matrix.transpose We * bmdualG n (GaloisField 2 f) * Ws = 1) (a b : Fin r) :
    (Matrix.transpose (bmdual_blockCols We Ws) * bmdualG n (GaloisField 2 f) * bmdual_blockCols We
        Ws)
        (Sum.inl a) (Sum.inr b) = bmdualG r (GaloisField 2 f) (Sum.inl a) (Sum.inr b) := by
  have h := congrFun (congrFun hdual a) b
  rw [show bmdualG r (GaloisField 2 f) (Sum.inl a) (Sum.inr b) =
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) a b from by
    simp [bmdualG, Matrix.fromBlocks, Spin.polar_quadPlus, Pi.single_apply, Finset.sum_ite_eq',
        Matrix.one_apply,
      Sum.inl_injective.eq_iff, Sum.inr_injective.eq_iff, eq_comm]]
  rw [← h]
  simp only [bmdual_blockCols, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Finset.sum_apply, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr]

private theorem bmdual_adapted_Pe_form_21 (n f r : ℕ)
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hdual : Matrix.transpose We * bmdualG n (GaloisField 2 f) * Ws = 1) (b a : Fin r) :
    (Matrix.transpose (bmdual_blockCols We Ws) * bmdualG n (GaloisField 2 f) * bmdual_blockCols We
        Ws)
        (Sum.inr b) (Sum.inl a) = bmdualG r (GaloisField 2 f) (Sum.inr b) (Sum.inl a) := by
  have htrans : Matrix.transpose Ws * bmdualG n (GaloisField 2 f) * We = 1 := by
    have h := congrArg Matrix.transpose hdual
    simpa [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.transpose_one,
      bmdual_G_symmetric, Matrix.mul_assoc] using h
  have h' := congrFun (congrFun htrans b) a
  have hR : bmdualG r (GaloisField 2 f) (Sum.inr b) (Sum.inl a) =
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) b a := by
    simp [bmdualG, Matrix.fromBlocks, Matrix.neg_apply, Matrix.one_apply, CharTwo.neg_eq,
      Spin.polar_quadPlus, Pi.single_apply, Finset.sum_ite_eq, ite_mul, zero_mul,
      Sum.inl_injective.eq_iff, Sum.inr_injective.eq_iff, eq_comm]
  rw [hR, ← h']
  simp only [bmdual_blockCols, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Finset.sum_apply, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr, Pi.single_apply,
    Finset.sum_ite_eq, ite_mul, zero_mul, Matrix.one_apply, Sum.inl_injective.eq_iff,
    Sum.inr_injective.eq_iff, eq_comm]

private theorem bmdual_adapted_Pe_form_22 (n f r : ℕ)
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWsIso : Matrix.transpose Ws * bmdualG n (GaloisField 2 f) * Ws = 0) (b b' : Fin r) :
    (Matrix.transpose (bmdual_blockCols We Ws) * bmdualG n (GaloisField 2 f) * bmdual_blockCols We
        Ws)
        (Sum.inr b) (Sum.inr b') = bmdualG r (GaloisField 2 f) (Sum.inr b) (Sum.inr b') := by
  have h := congrFun (congrFun hWsIso b) b'
  simp only [Matrix.zero_apply] at h
  rw [show bmdualG r (GaloisField 2 f) (Sum.inr b) (Sum.inr b') = 0 from by
    simp [bmdualG, Matrix.fromBlocks, Spin.polar_quadPlus, Pi.single_apply, Finset.sum_ite_eq',
        Matrix.one_apply,
      Sum.inl_injective.eq_iff, Sum.inr_injective.eq_iff, eq_comm]]
  rw [← h]
  simp only [bmdual_blockCols, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Finset.sum_apply, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr]

private theorem bmdual_adapted_Pe_form (n f r : ℕ)
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hdual : Matrix.transpose We * bmdualG n (GaloisField 2 f) * Ws = 1)
    (hWeIso : Matrix.transpose We * bmdualG n (GaloisField 2 f) * We = 0)
    (hWsIso : Matrix.transpose Ws * bmdualG n (GaloisField 2 f) * Ws = 0) :
    Matrix.transpose (bmdual_blockCols We Ws) * bmdualG n (GaloisField 2 f) * bmdual_blockCols We Ws
        =
      bmdualG r (GaloisField 2 f) := by
  ext j j'
  rcases j with a | b <;> rcases j' with a' | b'
  · exact bmdual_adapted_Pe_form_11 n f r We Ws hWeIso a a'
  · exact bmdual_adapted_Pe_form_12 n f r We Ws hdual a b'
  · exact bmdual_adapted_Pe_form_21 n f r We Ws hdual b a'
  · exact bmdual_adapted_Pe_form_22 n f r We Ws hWsIso b b'

private theorem bmdual_adapted_Pe_diag (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWe : e * We = We) (hWs : bmdualestar n f e * Ws = Ws)
    (heWs : e * Ws = 0) (hesWe : bmdualestar n f e * We = 0) :
    e * bmdual_blockCols We Ws =
        bmdual_blockCols We Ws * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) ∧
      bmdualestar n f e * bmdual_blockCols We Ws =
        bmdual_blockCols We Ws * Matrix.fromBlocks
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) := by
  constructor
  · ext i j
    rcases j with a | b
    · rw [Matrix.mul_apply]
      have hR : (bmdual_blockCols We Ws * Matrix.fromBlocks
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) i (Sum.inl a) = We i a := by
        rw [Matrix.mul_apply]
        rw [Fintype.sum_eq_single (Sum.inl a) (fun k hk => by
          rcases k with c | d
          · have hca : c ≠ a := fun h => hk (by rw [h])
            simp [bmdual_blockCols, Matrix.of_apply, Sum.elim_inl, Matrix.fromBlocks,
              Matrix.one_apply, hca]
          · simp [bmdual_blockCols, Matrix.of_apply, Sum.elim_inr, Matrix.fromBlocks])]
        simp [bmdual_blockCols, Matrix.fromBlocks]
      rw [hR]
      simp only [bmdual_blockCols, Matrix.of_apply, Sum.elim_inl]
      rw [← Matrix.mul_apply, hWe]
    · rw [Matrix.mul_apply]
      have hR : (bmdual_blockCols We Ws * Matrix.fromBlocks
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) i (Sum.inr b) =
            (0 : GaloisField 2 f) := by
        rw [Matrix.mul_apply]
        apply Finset.sum_eq_zero
        intro k _
        rcases k with c | d <;> simp [bmdual_blockCols, Matrix.of_apply, Sum.elim_inl,
          Sum.elim_inr, Matrix.fromBlocks]
      rw [hR]
      simp only [bmdual_blockCols, Matrix.of_apply, Sum.elim_inr]
      rw [← Matrix.mul_apply, heWs]
      simp
  · ext i j
    rcases j with a | b
    · rw [Matrix.mul_apply]
      have hR : (bmdual_blockCols We Ws * Matrix.fromBlocks
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) i (Sum.inl a) =
            (0 : GaloisField 2 f) := by
        rw [Matrix.mul_apply]
        apply Finset.sum_eq_zero
        intro k _
        rcases k with c | d <;> simp [bmdual_blockCols, Matrix.of_apply, Sum.elim_inl,
          Sum.elim_inr, Matrix.fromBlocks]
      rw [hR]
      simp only [bmdual_blockCols, Matrix.of_apply, Sum.elim_inl]
      rw [← Matrix.mul_apply, hesWe]
      simp
    · rw [Matrix.mul_apply]
      have hR : (bmdual_blockCols We Ws * Matrix.fromBlocks
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) i (Sum.inr b) = Ws i b := by
        rw [Matrix.mul_apply]
        rw [Fintype.sum_eq_single (Sum.inr b) (fun k hk => by
          rcases k with c | d
          · simp [bmdual_blockCols, Matrix.of_apply, Sum.elim_inl, Matrix.fromBlocks]
          · have hdb : d ≠ b := fun h => hk (by rw [h])
            simp [bmdual_blockCols, Matrix.of_apply, Sum.elim_inr, Matrix.fromBlocks,
              Matrix.one_apply, hdb])]
        simp [bmdual_blockCols, Matrix.fromBlocks]
      rw [hR]
      simp only [bmdual_blockCols, Matrix.of_apply, Sum.elim_inr]
      rw [← Matrix.mul_apply, hWs]

private theorem bmdual_adapted_Pe_eps (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hdE : e * bmdual_blockCols We Ws =
        bmdual_blockCols We Ws * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hdS : bmdualestar n f e * bmdual_blockCols We Ws =
        bmdual_blockCols We Ws * Matrix.fromBlocks
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) :
    bmdualeps n f e * bmdual_blockCols We Ws = bmdual_blockCols We Ws := by
  rw [bmdualeps, Matrix.add_mul, hdE, hdS, ← Matrix.mul_add]
  rw [show Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) +
      Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) = 1 from by
    rw [Matrix.fromBlocks_add]
    ext i j
    rcases i with i | i <;> rcases j with j | j <;>
      simp [Matrix.fromBlocks, Matrix.one_apply, Matrix.add_apply]]
  rw [Matrix.mul_one]

private theorem bmdual_e_mul_Ws_zero (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWs : bmdualestar n f e * Ws = Ws) (horth : e * bmdualestar n f e = 0) :
    e * Ws = 0 := by
  rw [← hWs, ← Matrix.mul_assoc, horth, Matrix.zero_mul]

private theorem bmdual_estar_mul_We_zero (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWe : e * We = We) (horth' : bmdualestar n f e * e = 0) :
    bmdualestar n f e * We = 0 := by
  rw [← hWe, ← Matrix.mul_assoc, horth', Matrix.zero_mul]

private theorem bmdual_exists_basis_range_e_span
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e) :
    ∃ (r : ℕ) (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f)),
      e * We = We ∧
      Function.Injective (fun c : Fin r → GaloisField 2 f => Matrix.mulVec We c) ∧
      (∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
        Matrix.mulVec e x ∈ LinearMap.range (Matrix.mulVecLin We)) ∧
      Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin e)) = r := by
  classical
  let W : Submodule (GaloisField 2 f) (Fin n ⊕ Fin n → GaloisField 2 f) :=
    LinearMap.range (Matrix.mulVecLin e)
  let r : ℕ := Module.finrank (GaloisField 2 f) W
  let b : Module.Basis (Fin r) (GaloisField 2 f) W := Module.finBasis (GaloisField 2 f) W
  let We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f) :=
    Matrix.of fun i j => (b j : Fin n ⊕ Fin n → GaloisField 2 f) i
  have hmulVec_e : ∀ v ∈ W, Matrix.mulVec e v = v := by
    intro v hv
    obtain ⟨u, hu⟩ := hv
    rw [Matrix.mulVecLin_apply] at hu
    rw [← hu, Matrix.mulVec_mulVec, he.2.1.eq]
  refine ⟨r, We, ?_, ?_, ?_, ?_⟩
  · ext i j
    have hfix : Matrix.mulVec e (b j : Fin n ⊕ Fin n → GaloisField 2 f) =
        (b j : Fin n ⊕ Fin n → GaloisField 2 f) := hmulVec_e (b j) (b j).2
    rw [Matrix.mul_apply]
    trans (Matrix.mulVec e (b j : Fin n ⊕ Fin n → GaloisField 2 f)) i
    · simp [Matrix.mulVec, dotProduct, We]
    · rw [hfix]
      simp [We]
  · intro c c' hcc
    funext j
    have hW : (∑ k, c k • (b k : W)) = (∑ k, c' k • (b k : W)) := by
      apply Subtype.ext
      ext i
      have h := congrFun hcc i
      simp only [Matrix.mulVec, dotProduct, We, Submodule.coe_sum, Submodule.coe_smul,
        Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at h ⊢
      have h1 : (∑ k, c k * (b k : Fin n ⊕ Fin n → GaloisField 2 f) i) =
          ∑ k, (b k : Fin n ⊕ Fin n → GaloisField 2 f) i * c k :=
        Finset.sum_congr rfl fun k _ => mul_comm _ _
      have h2 : (∑ k, c' k * (b k : Fin n ⊕ Fin n → GaloisField 2 f) i) =
          ∑ k, (b k : Fin n ⊕ Fin n → GaloisField 2 f) i * c' k :=
        Finset.sum_congr rfl fun k _ => mul_comm _ _
      rw [h1, h2]
      exact h
    exact (Fintype.linearIndependent_iffₛ.mp b.linearIndependent) c c' hW j
  · intro x
    refine ⟨fun k => b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k, ?_⟩
    rw [Matrix.mulVecLin_apply]
    have h' := congrArg Subtype.val (b.sum_repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩)
    have hrepr : (∑ k, b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k •
        (b k : Fin n ⊕ Fin n → GaloisField 2 f)) = Matrix.mulVec e x := by
      have h'' : (∑ k, b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k •
            (b k : Fin n ⊕ Fin n → GaloisField 2 f)) =
          ((∑ k, b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k • b k : W) :
            Fin n ⊕ Fin n → GaloisField 2 f) := by
        simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply]
      rw [h'']
      exact h'
    trans (∑ k, b.repr ⟨Matrix.mulVec e x, ⟨x, rfl⟩⟩ k •
        (b k : Fin n ⊕ Fin n → GaloisField 2 f))
    · ext i
      simp [Matrix.mulVec, dotProduct, We, Finset.sum_apply, mul_comm]
    · exact hrepr
  · rfl

private theorem bmdual_finrank_range_mulVecLin_eq_rank (f : ℕ) {ι : Type*} [Fintype ι]
    (M : Matrix ι ι (GaloisField 2 f)) :
    M.rank = Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin M)) := by
  rw [← Matrix.rank_transpose M, Matrix.rank_eq_finrank_span_row (Matrix.transpose M),
    Matrix.row_transpose, ← Matrix.range_mulVecLin M]

private theorem bmdual_estar_eq_conj_transpose (n f : ℕ)
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    bmdualestar n f e = (bmdualG n (GaloisField 2 f))⁻¹ * Matrix.transpose e * bmdualG n
        (GaloisField 2 f) := by
  simp only [bmdualestar, formAdj]
  rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
    congrArg Matrix.transpose (Matrix.map_id e)]

private theorem bmdual_rank_estar_eq_rank (n f : ℕ)
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    (bmdualestar n f e).rank = e.rank := by
  rw [bmdual_estar_eq_conj_transpose n f e]
  rw [Matrix.rank_mul_eq_left_of_isUnit_det (bmdualG n (GaloisField 2 f))
      ((bmdualG n (GaloisField 2 f))⁻¹ * Matrix.transpose e) (bmdual_G_isUnit_det n)]
  rw [Matrix.rank_mul_eq_right_of_isUnit_det (bmdualG n (GaloisField 2 f))⁻¹ (Matrix.transpose e)
      (Matrix.isUnit_nonsing_inv_det (A := bmdualG n (GaloisField 2 f)) (bmdual_G_isUnit_det n))]
  rw [Matrix.rank_transpose]

private theorem bmdual_estar_range_finrank (n f : ℕ)
    (e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)) :
    Module.finrank (GaloisField 2 f)
        (LinearMap.range (Matrix.mulVecLin (bmdualestar n f e))) =
      Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin e)) := by
  rw [← bmdual_finrank_range_mulVecLin_eq_rank f (bmdualestar n f e),
      ← bmdual_finrank_range_mulVecLin_eq_rank f e, bmdual_rank_estar_eq_rank]

private theorem bmdual_dual_bases_ws_span (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (We V : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hr : Module.finrank (GaloisField 2 f) (LinearMap.range (Matrix.mulVecLin e)) = r)
    (hdual : Matrix.transpose We * bmdualG n (GaloisField 2 f) * (bmdualestar n f e * V) = 1) :
    ∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
      Matrix.mulVec (bmdualestar n f e) x ∈
        LinearMap.range (Matrix.mulVecLin (bmdualestar n f e * V)) := by
  have hinj : Function.Injective (Matrix.mulVecLin (bmdualestar n f e * V)) := by
    intro c c' hcc
    have h3 : Matrix.mulVecLin (Matrix.transpose We * bmdualG n (GaloisField 2 f))
        (Matrix.mulVecLin (bmdualestar n f e * V) c) =
        Matrix.mulVecLin (Matrix.transpose We * bmdualG n (GaloisField 2 f))
        (Matrix.mulVecLin (bmdualestar n f e * V) c') := by
      rw [hcc]
    have h4 : Matrix.mulVecLin (Matrix.transpose We * bmdualG n (GaloisField 2 f) * (bmdualestar n f
        e * V)) c =
        Matrix.mulVecLin (Matrix.transpose We * bmdualG n (GaloisField 2 f) * (bmdualestar n f e *
            V)) c' := by
      simpa only [Matrix.mulVecLin_mul, LinearMap.comp_apply] using h3
    rw [hdual, Matrix.mulVecLin_one] at h4
    simpa using h4
  have hfinV : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (bmdualestar n f e * V))) = r := by
    have hker : (Matrix.mulVecLin (bmdualestar n f e * V)).ker = ⊥ :=
      LinearMap.ker_eq_bot.mpr hinj
    have h := LinearMap.finrank_range_add_finrank_ker (Matrix.mulVecLin (bmdualestar n f e * V))
    rw [hker, finrank_bot, add_zero, Module.finrank_fintype_fun_eq_card, Fintype.card_fin] at h
    exact h
  have hle : LinearMap.range (Matrix.mulVecLin (bmdualestar n f e * V)) ≤
      LinearMap.range (Matrix.mulVecLin (bmdualestar n f e)) := by
    rintro y ⟨c, rfl⟩
    exact ⟨Matrix.mulVec V c, by simp only [Matrix.mulVecLin_mul, LinearMap.comp_apply,
      Matrix.mulVecLin_apply]⟩
  have hfinE : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (bmdualestar n f e))) = r := by
    rw [bmdual_estar_range_finrank n f e, hr]
  have heq := Submodule.eq_of_le_of_finrank_eq hle (by rw [hfinV, hfinE])
  intro x
  rw [heq]
  exact ⟨x, rfl⟩

private theorem bmdual_exists_dual_bases_e_span
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e)) :
    ∃ (r : ℕ) (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f)),
      e * We = We ∧ bmdualestar n f e * Ws = Ws ∧
      Matrix.transpose We * bmdualG n (GaloisField 2 f) * Ws = 1 ∧
      (∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
        Matrix.mulVec e x ∈ LinearMap.range (Matrix.mulVecLin We)) ∧
      (∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
        Matrix.mulVec (bmdualestar n f e) x ∈ LinearMap.range (Matrix.mulVecLin Ws)) := by
  obtain ⟨r, We, hWe, hinj, hWeSpan, hr⟩ :=
    bmdual_exists_basis_range_e_span n f S he
  obtain ⟨V, hV⟩ := bmdual_exists_rightInverse_of_columns n f r We hinj
  obtain ⟨hWs, hdual⟩ :=
    bmdual_estar_mul_dual n f r We V hWe hV hestar.2.1.eq
  refine ⟨r, We, bmdualestar n f e * V, hWe, hWs, hdual, hWeSpan, ?_⟩
  intro x
  exact bmdual_dual_bases_ws_span n f r We V hr hdual x

private theorem bmdual_blockCols_range {n f r : ℕ}
    (We Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f)) :
    LinearMap.range (Matrix.mulVecLin (bmdual_blockCols We Ws)) =
      LinearMap.range (Matrix.mulVecLin We) ⊔ LinearMap.range (Matrix.mulVecLin Ws) := by
  rw [Matrix.range_mulVecLin, Matrix.range_mulVecLin, Matrix.range_mulVecLin]
  have hcol : Set.range (bmdual_blockCols We Ws).col = Set.range We.col ∪ Set.range Ws.col := by
    ext v
    constructor
    · rintro ⟨j, rfl⟩
      rcases j with a | b
      · exact Or.inl ⟨a, rfl⟩
      · exact Or.inr ⟨b, rfl⟩
    · rintro (⟨a, rfl⟩ | ⟨b, rfl⟩)
      · exact ⟨Sum.inl a, rfl⟩
      · exact ⟨Sum.inr b, rfl⟩
  rw [hcol, Submodule.span_union]

private theorem bmdual_We_iso (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (We : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWe : e * We = We) (horth' : bmdualestar n f e * e = 0) :
    Matrix.transpose We * bmdualG n (GaloisField 2 f) * We = 0 := by
  have hJ : bmdualG n (GaloisField 2 f) * bmdualestar n f e = Matrix.transpose e * bmdualG n
      (GaloisField 2 f) := by
    simp only [bmdualestar, formAdj]
    rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
      congrArg Matrix.transpose (Matrix.map_id e)]
    calc bmdualG n (GaloisField 2 f) * ((bmdualG n (GaloisField 2 f))⁻¹ * Matrix.transpose e *
        bmdualG n (GaloisField 2 f))
        = (bmdualG n (GaloisField 2 f) * (bmdualG n (GaloisField 2 f))⁻¹) * (Matrix.transpose e *
            bmdualG n (GaloisField 2 f)) := by
          noncomm_ring
      _ = Matrix.transpose e * bmdualG n (GaloisField 2 f) := by
          rw [Matrix.mul_nonsing_inv _ (bmdual_G_isUnit_det n), Matrix.one_mul]
  have heJe : Matrix.transpose e * bmdualG n (GaloisField 2 f) * e = 0 := by
    rw [← hJ, Matrix.mul_assoc, horth', Matrix.mul_zero]
  calc Matrix.transpose We * bmdualG n (GaloisField 2 f) * We
      = Matrix.transpose (e * We) * bmdualG n (GaloisField 2 f) * (e * We) := by rw [hWe]
    _ = Matrix.transpose We * (Matrix.transpose e * bmdualG n (GaloisField 2 f) * e) * We := by
        rw [Matrix.transpose_mul]
        simp only [Matrix.mul_assoc]
    _ = 0 := by rw [heJe, Matrix.mul_zero, Matrix.zero_mul]

private theorem bmdual_Ws_iso (n f r : ℕ)
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (Ws : Matrix (Fin n ⊕ Fin n) (Fin r) (GaloisField 2 f))
    (hWs : bmdualestar n f e * Ws = Ws) (horth : e * bmdualestar n f e = 0) :
    Matrix.transpose Ws * bmdualG n (GaloisField 2 f) * Ws = 0 := by
  have hJ : bmdualG n (GaloisField 2 f) * bmdualestar n f e = Matrix.transpose e * bmdualG n
      (GaloisField 2 f) := by
    simp only [bmdualestar, formAdj]
    rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
      congrArg Matrix.transpose (Matrix.map_id e)]
    calc bmdualG n (GaloisField 2 f) * ((bmdualG n (GaloisField 2 f))⁻¹ * Matrix.transpose e *
        bmdualG n (GaloisField 2 f))
        = (bmdualG n (GaloisField 2 f) * (bmdualG n (GaloisField 2 f))⁻¹) * (Matrix.transpose e *
            bmdualG n (GaloisField 2 f)) := by
          noncomm_ring
      _ = Matrix.transpose e * bmdualG n (GaloisField 2 f) := by
          rw [Matrix.mul_nonsing_inv _ (bmdual_G_isUnit_det n), Matrix.one_mul]
  have hJstar : Matrix.transpose (bmdualestar n f e) * bmdualG n (GaloisField 2 f) = bmdualG n
      (GaloisField 2 f) * e := by
    have h := congrArg Matrix.transpose hJ
    simpa [Matrix.transpose_mul, Matrix.transpose_transpose, bmdual_G_symmetric] using h
  have hesJes : Matrix.transpose (bmdualestar n f e) * bmdualG n (GaloisField 2 f) * bmdualestar n f
      e = 0 := by
    rw [hJstar, Matrix.mul_assoc, horth, Matrix.mul_zero]
  calc Matrix.transpose Ws * bmdualG n (GaloisField 2 f) * Ws
      = Matrix.transpose (bmdualestar n f e * Ws) * bmdualG n (GaloisField 2 f) *
          (bmdualestar n f e * Ws) := by rw [hWs]
    _ = Matrix.transpose Ws * (Matrix.transpose (bmdualestar n f e) * bmdualG n (GaloisField 2 f) *
          bmdualestar n f e) * Ws := by
        rw [Matrix.transpose_mul]
        simp only [Matrix.mul_assoc]
    _ = 0 := by rw [hesJes, Matrix.mul_zero, Matrix.zero_mul]

private theorem bmdual_range_eps_eq_sup
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e)) :
    LinearMap.range (Matrix.mulVecLin (bmdualeps n f e)) =
      LinearMap.range (Matrix.mulVecLin e) ⊔
        LinearMap.range (Matrix.mulVecLin (bmdualestar n f e)) := by
  have hee : e * e = e := he.2.1.eq
  have hes : bmdualestar n f e * bmdualestar n f e = bmdualestar n f e := hestar.2.1.eq
  have hee' : bmdualeps n f e * e = e := by
    rw [bmdualeps, Matrix.add_mul, hee, horth', add_zero]
  have hes' : bmdualeps n f e * bmdualestar n f e = bmdualestar n f e := by
    rw [bmdualeps, Matrix.add_mul, horth, zero_add, hes]
  apply le_antisymm
  · rintro x ⟨v, rfl⟩
    rw [Matrix.mulVecLin_apply, bmdualeps, Matrix.add_mulVec]
    exact Submodule.add_mem_sup ⟨v, rfl⟩ ⟨v, rfl⟩
  · apply sup_le
    · rintro x ⟨v, rfl⟩
      rw [Matrix.mulVecLin_apply]
      exact ⟨Matrix.mulVec e v, by rw [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hee']⟩
    · rintro x ⟨v, rfl⟩
      rw [Matrix.mulVecLin_apply]
      exact ⟨Matrix.mulVec (bmdualestar n f e) v,
        by rw [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hes']⟩

private theorem bmdual_adapted_basis_e_span
    (n f : ℕ) (S : Set (GL (Fin n ⊕ Fin n) (GaloisField 2 f)))
    {e : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e)) :
    ∃ (r : ℕ) (Pe : Matrix (Fin n ⊕ Fin n) (Fin r ⊕ Fin r) (GaloisField 2 f)),
      Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f) ∧
      bmdualeps n f e * Pe = Pe ∧
      e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) ∧
      bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) ∧
      (∀ x : Fin n ⊕ Fin n → GaloisField 2 f,
        Matrix.mulVec (bmdualeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Pe)) := by
  obtain ⟨r, We, Ws, hWe, hWs, hdual, hWeSpan, hWsSpan⟩ :=
    bmdual_exists_dual_bases_e_span n f S he hestar
  obtain ⟨hdE, hdS⟩ := bmdual_adapted_Pe_diag n f r We Ws hWe hWs
    (bmdual_e_mul_Ws_zero n f r Ws hWs horth) (bmdual_estar_mul_We_zero n f r We hWe horth')
  have hrangeWe : LinearMap.range (Matrix.mulVecLin e) =
      LinearMap.range (Matrix.mulVecLin We) := by
    apply le_antisymm
    · rintro y ⟨z, rfl⟩
      simpa only [Matrix.mulVecLin_apply] using hWeSpan z
    · rintro y ⟨c, rfl⟩
      exact ⟨Matrix.mulVec We c,
        by simp only [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hWe]⟩
  have hrangeWs : LinearMap.range (Matrix.mulVecLin (bmdualestar n f e)) =
      LinearMap.range (Matrix.mulVecLin Ws) := by
    apply le_antisymm
    · rintro y ⟨z, rfl⟩
      simpa only [Matrix.mulVecLin_apply] using hWsSpan z
    · rintro y ⟨c, rfl⟩
      exact ⟨Matrix.mulVec Ws c,
        by simp only [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, hWs]⟩
  refine ⟨r, bmdual_blockCols We Ws,
    bmdual_adapted_Pe_form n f r We Ws hdual (bmdual_We_iso n f r We hWe horth')
      (bmdual_Ws_iso n f r Ws hWs horth),
    bmdual_adapted_Pe_eps n f r We Ws hdE hdS, hdE, hdS, ?_⟩
  intro x
  rw [bmdual_blockCols_range We Ws, ← hrangeWe, ← hrangeWs,
    ← bmdual_range_eps_eq_sup n f S he horth horth'
      hestar]
  exact ⟨x, rfl⟩

private theorem bmdual_dot_mulVec_conj {m n : Type*} [Fintype m] [Fintype n] {F : Type}
    [CommSemiring F] (M : Matrix m n F) (B : Matrix m m F) (a b : n → F) :
    dotProduct (Matrix.mulVec M a) (Matrix.mulVec B (Matrix.mulVec M b)) =
      dotProduct a (Matrix.mulVec (Matrix.transpose M * B * M) b) := by
  rw [Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, Matrix.vecMul_mulVec,
    ← Matrix.mul_assoc, ← Matrix.dotProduct_mulVec]

private theorem bmdual_Pe_quad
    (n f r : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) :
    ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) = Spin.quadPlus r (GaloisField 2 f) c := by
  intro c
  let c1 : Fin r → GaloisField 2 f := fun a => c (Sum.inl a)
  let c2 : Fin r → GaloisField 2 f := fun b => c (Sum.inr b)
  let d1 : Fin r ⊕ Fin r → GaloisField 2 f := Sum.elim c1 0
  let d2 : Fin r ⊕ Fin r → GaloisField 2 f := Sum.elim 0 c2
  have hc : c = d1 + d2 := by
    funext j; rcases j with a | b <;> simp [d1, d2, c1, c2]
  have hD1 : Matrix.mulVec (Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) d1 = d1 := by
    funext j; rcases j with a | b <;>
      simp [Matrix.mulVec, dotProduct, Matrix.fromBlocks, d1, c1, Matrix.one_apply,
        Finset.sum_ite_eq', Finset.sum_ite_eq]
  have hD2 : Matrix.mulVec (Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) d2 = d2 := by
    funext j; rcases j with a | b <;>
      simp [Matrix.mulVec, dotProduct, Matrix.fromBlocks, d2, c2, Matrix.one_apply,
        Finset.sum_ite_eq', Finset.sum_ite_eq]
  have hQ1 : bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe d1) = 0 := by
    have hfix : Matrix.mulVec e (Matrix.mulVec Pe d1) = Matrix.mulVec Pe d1 := by
      rw [Matrix.mulVec_mulVec, hPee, ← Matrix.mulVec_mulVec, hD1]
    rw [← hfix]; exact hquad _
  have hQ2 : bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe d2) = 0 := by
    have hfix : Matrix.mulVec (bmdualestar n f e) (Matrix.mulVec Pe d2) = Matrix.mulVec Pe d2 := by
      rw [Matrix.mulVec_mulVec, hPees, ← Matrix.mulVec_mulVec, hD2]
    rw [← hfix]; exact hquad' _
  have hB : QuadraticMap.polar (bmdualQ n (GaloisField 2 f)) (Matrix.mulVec Pe d1)
      (Matrix.mulVec Pe d2) = ∑ a, c1 a * c2 a := by
    have hiso : QuadraticMap.polar (bmdualQ n (GaloisField 2 f)) (Matrix.mulVec Pe d1)
        (Matrix.mulVec Pe d2) = QuadraticMap.polar (bmdualQ r (GaloisField 2 f)) d1 d2 := by
      rw [bmdual_polar_eq_dot, bmdual_polar_eq_dot]
      rw [bmdual_dot_mulVec_conj Pe (bmdualG n (GaloisField 2 f)) d1 d2, hPeG]
    rw [hiso, Spin.polar_quadPlus]
    simp [d1, d2, c1, c2, mul_comm]
  have hPec : Matrix.mulVec Pe c = Matrix.mulVec Pe d1 + Matrix.mulVec Pe d2 := by
    rw [hc, Matrix.mulVec_add]
  rw [hPec, QuadraticMap.map_add (bmdualQ n (GaloisField 2 f)), hQ1, hQ2, hB]
  simp only [zero_add]
  rw [Spin.quadPlus_apply]

private theorem bmdual_Pe_finrank
    (n f r : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeε : bmdualeps n f e * Pe = Pe)
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      Matrix.mulVec (bmdualeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Pe)) :
    Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (bmdualeps n f e))) = 2 * r := by
  have hinj : Function.Injective (Matrix.mulVecLin Pe) := by
    intro x y hxy
    have hxy' : Matrix.mulVec Pe x = Matrix.mulVec Pe y := hxy
    have hsub : Matrix.mulVec Pe (x - y) = 0 := by
      rw [Matrix.mulVec_sub, hxy', sub_self]
    have hzero : x - y = 0 := by
      funext j
      have hG : IsUnit (bmdualG r (GaloisField 2 f)).det := bmdual_G_isUnit_det r
      have h := bmdual_dot_mulVec_conj Pe (bmdualG n (GaloisField 2 f)) (x - y)
        (Matrix.mulVec (bmdualG r (GaloisField 2 f))⁻¹ (Pi.single j 1))
      rw [hPeG] at h
      rw [hsub] at h
      simp only [Matrix.mulVec_zero, zero_dotProduct] at h
      have h1 : Matrix.mulVec (bmdualG r (GaloisField 2 f))
          (Matrix.mulVec (bmdualG r (GaloisField 2 f))⁻¹ (Pi.single j 1)) =
          Pi.single j 1 := by
        rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ hG, Matrix.one_mulVec]
      rw [h1] at h
      have h2 : dotProduct (x - y) (Pi.single j 1) = (x - y) j := by
        simp [dotProduct, Pi.single_apply]
      rw [h2] at h
      exact h.symm
    exact sub_eq_zero.mp hzero
  have hrange : LinearMap.range (Matrix.mulVecLin (bmdualeps n f e)) =
      LinearMap.range (Matrix.mulVecLin Pe) := by
    apply le_antisymm
    · intro y hy
      obtain ⟨x, hx⟩ := LinearMap.mem_range.mp hy
      rw [← hx]
      simpa [Matrix.mulVecLin_apply, bmdualeps, Matrix.add_mulVec] using hPeSpan x
    · rintro y ⟨x, rfl⟩
      refine ⟨Matrix.mulVec Pe x, ?_⟩
      show Matrix.mulVec (bmdualeps n f e) (Matrix.mulVec Pe x) = Matrix.mulVec Pe x
      rw [Matrix.mulVec_mulVec, hPeε]
  rw [hrange]
  have hker : (Matrix.mulVecLin Pe).ker = ⊥ := LinearMap.ker_eq_bot.mpr hinj
  have hdom : Module.finrank (GaloisField 2 f) (Fin r ⊕ Fin r → GaloisField 2 f) = 2 * r := by
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_sum, Fintype.card_fin]
    ring
  have h := LinearMap.finrank_range_add_finrank_ker (Matrix.mulVecLin Pe)
  rw [hker, finrank_bot, add_zero, hdom] at h
  exact h

private theorem bmdual_complement_plusType
    (n f r : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (heps : IsIdempotentElem (bmdualeps n f e))
    (hεadj : Matrix.transpose (bmdualeps n f e) * bmdualG n (GaloisField 2 f) =
      bmdualG n (GaloisField 2 f) * bmdualeps n f e)
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeQ : ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) = Spin.quadPlus r (GaloisField 2 f) c)
    (hPeε : bmdualeps n f e * Pe = Pe)
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      Matrix.mulVec (bmdualeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Pe)) :
    CFSG.GroupTheory.WeirSylow.IsPlusType
      ((bmdualQ n (GaloisField 2 f)).comp
        (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))).subtype) := by
  have hplusQ : CFSG.GroupTheory.WeirSylow.IsPlusType (bmdualQ n (GaloisField 2 f)) := by
    simpa [bmdualQ] using
      CFSG.GroupTheory.WeirSylow.isPlusType_quadPlus (GaloisField 2 f) n
  have hrange : LinearMap.range (Matrix.mulVecLin (bmdualeps n f e)) =
      LinearMap.range (Matrix.mulVecLin Pe) := by
    apply le_antisymm
    · intro y hy
      obtain ⟨x, hx⟩ := LinearMap.mem_range.mp hy
      rw [← hx]
      simpa [Matrix.mulVecLin_apply, bmdualeps, Matrix.add_mulVec] using hPeSpan x
    · rintro y ⟨x, rfl⟩
      refine ⟨Matrix.mulVec Pe x, ?_⟩
      show Matrix.mulVec (bmdualeps n f e) (Matrix.mulVec Pe x) = Matrix.mulVec Pe x
      rw [Matrix.mulVec_mulVec, hPeε]
  have hinjPe : Function.Injective (Matrix.mulVecLin Pe) := by
    intro x y hxy
    have hxy' : Matrix.mulVec Pe x = Matrix.mulVec Pe y := hxy
    have hsub : Matrix.mulVec Pe (x - y) = 0 := by rw [Matrix.mulVec_sub, hxy', sub_self]
    have hzero : x - y = 0 := by
      funext j
      have hG : IsUnit (bmdualG r (GaloisField 2 f)).det := bmdual_G_isUnit_det r
      have h := bmdual_dot_mulVec_conj Pe (bmdualG n (GaloisField 2 f)) (x - y)
        (Matrix.mulVec (bmdualG r (GaloisField 2 f))⁻¹ (Pi.single j 1))
      rw [hPeG] at h
      rw [hsub] at h
      simp only [Matrix.mulVec_zero, zero_dotProduct] at h
      have h1 : Matrix.mulVec (bmdualG r (GaloisField 2 f))
          (Matrix.mulVec (bmdualG r (GaloisField 2 f))⁻¹ (Pi.single j 1)) = Pi.single j 1 := by
        rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ hG, Matrix.one_mulVec]
      rw [h1] at h
      have h2 : dotProduct (x - y) (Pi.single j 1) = (x - y) j := by
        simp [dotProduct, Pi.single_apply]
      rw [h2] at h
      exact h.symm
    exact sub_eq_zero.mp hzero
  have hplusε : CFSG.GroupTheory.WeirSylow.IsPlusType
      ((bmdualQ n (GaloisField 2 f)).comp
        (LinearMap.range (Matrix.mulVecLin (bmdualeps n f e))).subtype) := by
    rw [hrange]
    have hφ : QuadraticMap.IsometryEquiv (Spin.quadPlus r (GaloisField 2 f))
        ((bmdualQ n (GaloisField 2 f)).comp
          (LinearMap.range (Matrix.mulVecLin Pe)).subtype) :=
      { toLinearEquiv := LinearEquiv.ofInjective (Matrix.mulVecLin Pe) hinjPe
        map_app' := fun c => hPeQ c }
    exact (CFSG.GroupTheory.WeirSylow.isPlusType_congr hφ).mp
      (CFSG.GroupTheory.WeirSylow.isPlusType_quadPlus (GaloisField 2 f) r)
  have hsum : bmdualeps n f e + (1 - bmdualeps n f e) = 1 := by abel
  have hsup : LinearMap.range (Matrix.mulVecLin (bmdualeps n f e)) ⊔
      LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e)) = ⊤ := by
    rw [eq_top_iff]
    intro y hy
    have hyy : y = Matrix.mulVec (bmdualeps n f e) y +
        Matrix.mulVec (1 - bmdualeps n f e) y := by
      rw [← Matrix.add_mulVec, hsum, Matrix.one_mulVec]
    rw [hyy]
    exact Submodule.add_mem_sup ⟨y, rfl⟩ ⟨y, rfl⟩
  have hdisj : LinearMap.range (Matrix.mulVecLin (bmdualeps n f e)) ⊓
      LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e)) = ⊥ := by
    rw [Submodule.eq_bot_iff]
    rintro y ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
    have hz : bmdualeps n f e * (1 - bmdualeps n f e) = 0 := by
      rw [mul_sub, mul_one, heps, sub_self]
    have h1 : Matrix.mulVec (bmdualeps n f e) (Matrix.mulVec (bmdualeps n f e) a) =
        Matrix.mulVec (bmdualeps n f e) a := by
      rw [Matrix.mulVec_mulVec, heps]
    have h2 : Matrix.mulVec (bmdualeps n f e)
        (Matrix.mulVec (1 - bmdualeps n f e) b) = 0 := by
      rw [Matrix.mulVec_mulVec, hz, Matrix.zero_mulVec]
    have ha' : Matrix.mulVec (bmdualeps n f e) a = y := ha
    have hb' : Matrix.mulVec (1 - bmdualeps n f e) b = y := hb
    rw [ha'] at h1
    rw [hb'] at h2
    rw [h2] at h1
    exact h1.symm
  have hεfin : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (bmdualeps n f e))) = 2 * r :=
    bmdual_Pe_finrank n f r Pe hPeG hPeε hPeSpan
  have hVfin : Module.finrank (GaloisField 2 f) (bmdualι n → GaloisField 2 f) = 2 * n := by
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_sum, Fintype.card_fin]
    ring
  have hwdim : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))) = 2 * (n - r) := by
    have h := Submodule.finrank_sup_add_finrank_inf_eq
      (LinearMap.range (Matrix.mulVecLin (bmdualeps n f e)))
      (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e)))
    rw [hsup, hdisj, finrank_top, finrank_bot, hVfin, hεfin] at h
    omega
  have hrn : r ≤ n := by
    have h := Submodule.finrank_le (LinearMap.range (Matrix.mulVecLin (bmdualeps n f e)))
    rw [hεfin, hVfin] at h
    omega
  let u : Module.End (GaloisField 2 f) (bmdualι n → GaloisField 2 f) :=
    Matrix.mulVecLin (bmdualeps n f e)
  let w : Module.End (GaloisField 2 f) (bmdualι n → GaloisField 2 f) :=
    Matrix.mulVecLin (1 - bmdualeps n f e)
  have hu_idem : u * u = u := by
    change (Matrix.mulVecLin (bmdualeps n f e)).comp (Matrix.mulVecLin (bmdualeps n f e)) =
      Matrix.mulVecLin (bmdualeps n f e)
    rw [← Matrix.mulVecLin_mul, heps]
  have hw_idem : w * w = w := by
    change (Matrix.mulVecLin (1 - bmdualeps n f e)).comp
        (Matrix.mulVecLin (1 - bmdualeps n f e)) = Matrix.mulVecLin (1 - bmdualeps n f e)
    rw [← Matrix.mulVecLin_mul, heps.one_sub.eq]
  have hu_adj : ∀ x y, QuadraticMap.polar (bmdualQ n (GaloisField 2 f)) (u x) y =
      QuadraticMap.polar (bmdualQ n (GaloisField 2 f)) x (u y) := by
    intro x y
    change QuadraticMap.polar (bmdualQ n (GaloisField 2 f))
        (Matrix.mulVec (bmdualeps n f e) x) y =
      QuadraticMap.polar (bmdualQ n (GaloisField 2 f)) x
        (Matrix.mulVec (bmdualeps n f e) y)
    rw [bmdual_polar_eq_dot, bmdual_polar_eq_dot, Matrix.dotProduct_mulVec, Matrix.vecMul_mulVec,
      hεadj, ← Matrix.dotProduct_mulVec, ← Matrix.mulVec_mulVec]
  have hw_adj : ∀ x y, QuadraticMap.polar (bmdualQ n (GaloisField 2 f)) (w x) y =
      QuadraticMap.polar (bmdualQ n (GaloisField 2 f)) x (w y) := by
    intro x y
    change QuadraticMap.polar (bmdualQ n (GaloisField 2 f))
        (Matrix.mulVec (1 - bmdualeps n f e) x) y =
      QuadraticMap.polar (bmdualQ n (GaloisField 2 f)) x
        (Matrix.mulVec (1 - bmdualeps n f e) y)
    have hadj1 : Matrix.transpose (1 - bmdualeps n f e) * bmdualG n (GaloisField 2 f) =
        bmdualG n (GaloisField 2 f) * (1 - bmdualeps n f e) := by
      rw [Matrix.transpose_sub, Matrix.transpose_one, Matrix.sub_mul, Matrix.mul_sub, hεadj,
        Matrix.one_mul, Matrix.mul_one]
    rw [bmdual_polar_eq_dot, bmdual_polar_eq_dot, Matrix.dotProduct_mulVec, Matrix.vecMul_mulVec,
      hadj1, ← Matrix.dotProduct_mulVec, ← Matrix.mulVec_mulVec]
  have hu : CFSG.LocalAnalysis.GLTheoremA.KD264Lie.KD4.OIdem (bmdualQ n (GaloisField 2 f)) u :=
    ⟨hu_idem, hu_adj⟩
  have hw : CFSG.LocalAnalysis.GLTheoremA.KD264Lie.KD4.OIdem (bmdualQ n (GaloisField 2 f)) w :=
    ⟨hw_idem, hw_adj⟩
  have huw : u * w = 0 := by
    change (Matrix.mulVecLin (bmdualeps n f e)).comp
        (Matrix.mulVecLin (1 - bmdualeps n f e)) = 0
    rw [← Matrix.mulVecLin_mul, show bmdualeps n f e * (1 - bmdualeps n f e) = 0 from by
      rw [mul_sub, mul_one, heps, sub_self], Matrix.mulVecLin_zero]
  have hwu : w * u = 0 := by
    change (Matrix.mulVecLin (1 - bmdualeps n f e)).comp
        (Matrix.mulVecLin (bmdualeps n f e)) = 0
    rw [← Matrix.mulVecLin_mul, show (1 - bmdualeps n f e) * bmdualeps n f e = 0 from by
      rw [sub_mul, one_mul, heps, sub_self], Matrix.mulVecLin_zero]
  have huv : u + w = 1 := by
    change Matrix.mulVecLin (bmdualeps n f e) + Matrix.mulVecLin (1 - bmdualeps n f e) = 1
    rw [← Matrix.mulVecLin_add, hsum, Matrix.mulVecLin_one]
    rfl
  have hufin : Module.finrank (GaloisField 2 f) (LinearMap.range u) = 2 * r := hεfin
  have hwfin : Module.finrank (GaloisField 2 f) (LinearMap.range w) = 2 * (n - r) := hwdim
  by_cases hr0 : r = 0
  · have hPe_bot : LinearMap.range (Matrix.mulVecLin Pe) = ⊥ := by
      rw [← Submodule.finrank_eq_zero, ← hrange, hεfin, hr0, mul_zero]
    have hbot : LinearMap.range (Matrix.mulVecLin (bmdualeps n f e)) = ⊥ := by
      rw [hrange, hPe_bot]
    have hε0 : bmdualeps n f e = 0 := by
      ext i j
      have hlin : Matrix.mulVecLin (bmdualeps n f e) = 0 := LinearMap.range_eq_bot.mp hbot
      have h1 : Matrix.mulVecLin (bmdualeps n f e) (Pi.single j 1) = 0 := by
        rw [hlin, LinearMap.zero_apply]
      have h := congrFun h1 i
      simpa [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, Pi.single_apply] using h
    have htop : LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e)) = ⊤ := by
      rw [show 1 - bmdualeps n f e = 1 from by rw [hε0, sub_zero], Matrix.mulVecLin_one,
        LinearMap.range_eq_top]
      exact fun x => ⟨x, rfl⟩
    rw [htop]
    have htopiso : QuadraticMap.IsometryEquiv
        ((bmdualQ n (GaloisField 2 f)).comp
          (⊤ : Submodule (GaloisField 2 f) (bmdualι n → GaloisField 2 f)).subtype)
        (bmdualQ n (GaloisField 2 f)) :=
      QuadraticMap.IsometryEquiv.mk Submodule.topEquiv (fun x => rfl)
    exact (CFSG.GroupTheory.WeirSylow.isPlusType_congr htopiso).mpr hplusQ
  · have hr : 1 ≤ r := Nat.pos_of_ne_zero hr0
    by_cases hrn' : r = n
    · have hbot2 : LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e)) = ⊥ := by
        rw [← Submodule.finrank_eq_zero, hwdim, hrn', Nat.sub_self, mul_zero]
      rw [hbot2]
      refine ⟨⊤, ?_, ?_⟩
      · simp
      · intro x _
        rw [QuadraticMap.comp_apply]
        have hx : (x : bmdualι n → GaloisField 2 f) = 0 := by
          have h := x.2
          rwa [Submodule.mem_bot] at h
        show (bmdualQ n (GaloisField 2 f)) (x : bmdualι n → GaloisField 2 f) = 0
        rw [hx, QuadraticMap.map_zero]
    · have hlt : r < n := lt_of_le_of_ne hrn hrn'
      have hsplit := CFSG.LocalAnalysis.GLTheoremA.KD264Lie.KD4.plus_split
        (Q := bmdualQ n (GaloisField 2 f))
        (Spin.nondegenerate_polarBilin_quadPlus n (GaloisField 2 f)) hu hw huw hwu huv
        (d₁ := r) (d₂ := n - r) hr (by omega) hufin hwfin
      exact (hsplit.mp hplusQ).mp hplusε

private theorem bmdual_compl_nondegenerate
    (n f : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (heps : IsIdempotentElem (bmdualeps n f e))
    (hεadj : Matrix.transpose (bmdualeps n f e) * bmdualG n (GaloisField 2 f) =
      bmdualG n (GaloisField 2 f) * bmdualeps n f e) :
    (QuadraticMap.polarBilin
      ((bmdualQ n (GaloisField 2 f)).comp
        (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))).subtype)).Nondegenerate := by
  have hUidem : Matrix.mulVecLin (1 - bmdualeps n f e) *
      Matrix.mulVecLin (1 - bmdualeps n f e) = Matrix.mulVecLin (1 - bmdualeps n f e) := by
    change (Matrix.mulVecLin (1 - bmdualeps n f e)).comp
        (Matrix.mulVecLin (1 - bmdualeps n f e)) = Matrix.mulVecLin (1 - bmdualeps n f e)
    rw [← Matrix.mulVecLin_mul, heps.one_sub.eq]
  have hUadj : ∀ x y, QuadraticMap.polar (bmdualQ n (GaloisField 2 f))
      (Matrix.mulVecLin (1 - bmdualeps n f e) x) y =
      QuadraticMap.polar (bmdualQ n (GaloisField 2 f)) x
        (Matrix.mulVecLin (1 - bmdualeps n f e) y) := by
    intro x y
    change QuadraticMap.polar (bmdualQ n (GaloisField 2 f))
        (Matrix.mulVec (1 - bmdualeps n f e) x) y =
      QuadraticMap.polar (bmdualQ n (GaloisField 2 f)) x
        (Matrix.mulVec (1 - bmdualeps n f e) y)
    have hadj1 : Matrix.transpose (1 - bmdualeps n f e) * bmdualG n (GaloisField 2 f) =
        bmdualG n (GaloisField 2 f) * (1 - bmdualeps n f e) := by
      rw [Matrix.transpose_sub, Matrix.transpose_one, Matrix.sub_mul, Matrix.mul_sub, hεadj,
        Matrix.one_mul, Matrix.mul_one]
    rw [bmdual_polar_eq_dot, bmdual_polar_eq_dot, Matrix.dotProduct_mulVec, Matrix.vecMul_mulVec,
      hadj1, ← Matrix.dotProduct_mulVec, ← Matrix.mulVec_mulVec]
  have hOIdem : CFSG.LocalAnalysis.GLTheoremA.KD264Lie.KD4.OIdem (bmdualQ n (GaloisField 2 f))
      (Matrix.mulVecLin (1 - bmdualeps n f e)) := ⟨hUidem, hUadj⟩
  exact hOIdem.nondeg_comp (Spin.nondegenerate_polarBilin_quadPlus n (GaloisField 2 f))

private theorem bmdual_compl_isometry_data
    (n f : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (heps : IsIdempotentElem (bmdualeps n f e))
    (hεadj : Matrix.transpose (bmdualeps n f e) * bmdualG n (GaloisField 2 f) =
      bmdualG n (GaloisField 2 f) * bmdualeps n f e)
    (hplus : CFSG.GroupTheory.WeirSylow.IsPlusType
      ((bmdualQ n (GaloisField 2 f)).comp
        (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))).subtype)) :
    ∃ (s : ℕ) (iso : QuadraticMap.IsometryEquiv
        ((bmdualQ n (GaloisField 2 f)).comp
          (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))).subtype)
        (Spin.quadPlus s (GaloisField 2 f))),
      Module.finrank (GaloisField 2 f)
        (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))) = 2 * s := by
  have hplus' : CFSG.GroupTheory.WeirSylow.IsPlusType
      ((bmdualQ n (GaloisField 2 f)).comp
        (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))).subtype) := hplus
  obtain ⟨W', hW'dim, -⟩ := hplus
  have hUnd := bmdual_compl_nondegenerate n f heps hεadj
  have hUfin : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))) =
      2 * Module.finrank (GaloisField 2 f) W' := hW'dim.symm
  obtain ⟨iso⟩ := CFSG.GroupTheory.WeirSylow.nonempty_isometry_quadPlus
    (n := Module.finrank (GaloisField 2 f) W') hUnd hUfin hplus'
  exact ⟨Module.finrank (GaloisField 2 f) W', iso, hUfin⟩

private noncomputable def bmdual_compl_Bc
    (n f : ℕ) {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (s : ℕ)
    (iso : QuadraticMap.IsometryEquiv
      ((bmdualQ n (GaloisField 2 f)).comp
        (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))).subtype)
      (Spin.quadPlus s (GaloisField 2 f))) :
    Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f) :=
  fun i j => (iso.symm (Pi.single j 1) : bmdualι n → GaloisField 2 f) i

private theorem bmdual_matrix_gram_polar
    (n f : ℕ) {s : ℕ}
    (M : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f)) (i j : Fin s ⊕ Fin s) :
    (Matrix.transpose M * bmdualG n (GaloisField 2 f) * M) i j =
      QuadraticMap.polar (bmdualQ n (GaloisField 2 f))
        (Matrix.mulVec M (Pi.single i 1)) (Matrix.mulVec M (Pi.single j 1)) := by
  rw [bmdual_polar_eq_dot, Matrix.mulVec_single_one, Matrix.mulVec_single_one]
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.col_apply, Matrix.mulVec,
    dotProduct, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro l _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro k _
  ring

private theorem bmdual_compl_Bc_gram
    (n f : ℕ) {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (s : ℕ)
    (iso : QuadraticMap.IsometryEquiv
      ((bmdualQ n (GaloisField 2 f)).comp
        (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))).subtype)
      (Spin.quadPlus s (GaloisField 2 f))) :
    (Matrix.transpose (bmdual_compl_Bc n f s iso) * bmdualG n (GaloisField 2 f) *
        bmdual_compl_Bc n f s iso = bmdualG s (GaloisField 2 f)) ∧
      (∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
        bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdual_compl_Bc n f s iso) c) =
          Spin.quadPlus s (GaloisField 2 f) c) := by
  let Bc := bmdual_compl_Bc n f s iso
  let fmap : (Fin s ⊕ Fin s → GaloisField 2 f) →ₗ[GaloisField 2 f]
      (bmdualι n → GaloisField 2 f) :=
    (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))).subtype.comp
      iso.symm.toLinearEquiv.toLinearMap
  have hBc : ∀ c, Matrix.mulVec Bc c = fmap c := by
    intro c
    have hc : (∑ j, c j • Pi.single j 1 : Fin s ⊕ Fin s → GaloisField 2 f) = c := by
      funext i; simp [Pi.single_apply, Finset.sum_ite_eq']
    have hfc : fmap c = ∑ j, c j • fmap (Pi.single j 1) := by
      conv_lhs => rw [← hc]
      rw [map_sum]
      exact Finset.sum_congr rfl fun j _ => by rw [map_smul]
    rw [hfc]
    funext i
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Matrix.mulVec, dotProduct, Bc,
      bmdual_compl_Bc, fmap]
    exact Finset.sum_congr rfl fun j _ => mul_comm _ _
  have hQ : ∀ c, bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
      Spin.quadPlus s (GaloisField 2 f) c := by
    intro c
    rw [hBc]
    exact iso.symm.map_app c
  have hpolar : ∀ x y : Fin s ⊕ Fin s → GaloisField 2 f,
      QuadraticMap.polar (bmdualQ n (GaloisField 2 f)) (fmap x) (fmap y) =
        QuadraticMap.polar (Spin.quadPlus s (GaloisField 2 f)) x y := by
    intro x y
    have hx : (bmdualQ n (GaloisField 2 f)) (fmap x) = Spin.quadPlus s (GaloisField 2 f) x :=
      iso.symm.map_app x
    have hy : (bmdualQ n (GaloisField 2 f)) (fmap y) = Spin.quadPlus s (GaloisField 2 f) y :=
      iso.symm.map_app y
    have hxy : (bmdualQ n (GaloisField 2 f)) (fmap (x + y)) =
        Spin.quadPlus s (GaloisField 2 f) (x + y) := iso.symm.map_app (x + y)
    rw [map_add] at hxy
    simp only [QuadraticMap.polar, hxy, hx, hy]
  refine ⟨?_, hQ⟩
  ext i j
  rw [bmdual_matrix_gram_polar]
  rw [hBc (Pi.single i 1), hBc (Pi.single j 1), hpolar (Pi.single i 1) (Pi.single j 1)]
  rw [show bmdualG s (GaloisField 2 f) = LinearMap.toMatrix₂' (GaloisField 2 f)
    (QuadraticMap.polarBilin (Spin.quadPlus s (GaloisField 2 f))) from rfl,
    LinearMap.toMatrix₂'_apply, QuadraticMap.polarBilin_apply_apply]

private theorem bmdual_compl_Bc_fix
    (n f : ℕ) {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (heps : IsIdempotentElem (bmdualeps n f e))
    (s : ℕ)
    (iso : QuadraticMap.IsometryEquiv
      ((bmdualQ n (GaloisField 2 f)).comp
        (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))).subtype)
      (Spin.quadPlus s (GaloisField 2 f))) :
    ((1 - bmdualeps n f e) * bmdual_compl_Bc n f s iso = bmdual_compl_Bc n f s iso) ∧
      (∀ x : bmdualι n → GaloisField 2 f,
        Matrix.mulVec (1 - bmdualeps n f e) x ∈
          LinearMap.range (Matrix.mulVecLin (bmdual_compl_Bc n f s iso))) := by
  let Bc := bmdual_compl_Bc n f s iso
  let fmap : (Fin s ⊕ Fin s → GaloisField 2 f) →ₗ[GaloisField 2 f]
      (bmdualι n → GaloisField 2 f) :=
    (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))).subtype.comp
      iso.symm.toLinearEquiv.toLinearMap
  have hBc : ∀ c, Matrix.mulVec Bc c = fmap c := by
    intro c
    have hc : (∑ j, c j • Pi.single j 1 : Fin s ⊕ Fin s → GaloisField 2 f) = c := by
      funext i; simp [Pi.single_apply, Finset.sum_ite_eq']
    have hfc : fmap c = ∑ j, c j • fmap (Pi.single j 1) := by
      conv_lhs => rw [← hc]
      rw [map_sum]
      exact Finset.sum_congr rfl fun j _ => by rw [map_smul]
    rw [hfc]
    funext i
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Matrix.mulVec, dotProduct, Bc,
      bmdual_compl_Bc, fmap]
    exact Finset.sum_congr rfl fun j _ => mul_comm _ _
  have hcol : ∀ j : Fin s ⊕ Fin s,
      Matrix.mulVec (1 - bmdualeps n f e) (fmap (Pi.single j 1)) = fmap (Pi.single j 1) := by
    intro j
    have hmem : fmap (Pi.single j 1) ∈
        LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e)) :=
      (iso.symm (Pi.single j 1)).2
    obtain ⟨v, hv⟩ := LinearMap.mem_range.mp hmem
    rw [Matrix.mulVecLin_apply] at hv
    rw [← hv, Matrix.mulVec_mulVec, heps.one_sub.eq, hv]
  refine ⟨?_, ?_⟩
  · ext i j
    rw [Matrix.mul_apply]
    trans (Matrix.mulVec (1 - bmdualeps n f e) (fmap (Pi.single j 1))) i
    · rfl
    · rw [hcol j]
      rfl
  · intro x
    refine ⟨(iso.toLinearEquiv ⟨Matrix.mulVec (1 - bmdualeps n f e) x,
      ⟨x, rfl⟩⟩ : Fin s ⊕ Fin s → GaloisField 2 f), ?_⟩
    rw [Matrix.mulVecLin_apply, hBc]
    exact congrArg Subtype.val (iso.toLinearEquiv.symm_apply_apply _)

private theorem bmdual_compl_dim
    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (heps : IsIdempotentElem (bmdualeps n f e))
    (hεdim : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (bmdualeps n f e))) = 2 * r)
    (hUdim : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))) = 2 * s) :
    r + s = n := by
  have hVfin : Module.finrank (GaloisField 2 f) (bmdualι n → GaloisField 2 f) = 2 * n := by
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_sum, Fintype.card_fin]; ring
  have hsum1 : bmdualeps n f e + (1 - bmdualeps n f e) = 1 := by abel
  have hsup : LinearMap.range (Matrix.mulVecLin (bmdualeps n f e)) ⊔
      LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e)) = ⊤ := by
    rw [eq_top_iff]
    intro y hy
    have hyy : y = Matrix.mulVec (bmdualeps n f e) y +
        Matrix.mulVec (1 - bmdualeps n f e) y := by
      rw [← Matrix.add_mulVec, hsum1, Matrix.one_mulVec]
    rw [hyy]
    exact Submodule.add_mem_sup ⟨y, rfl⟩ ⟨y, rfl⟩
  have hdisj : LinearMap.range (Matrix.mulVecLin (bmdualeps n f e)) ⊓
      LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e)) = ⊥ := by
    rw [Submodule.eq_bot_iff]
    rintro y ⟨⟨a, ha⟩, hb⟩
    obtain ⟨b, hb⟩ := LinearMap.mem_range.mp hb
    rw [Matrix.mulVecLin_apply] at ha hb
    have hz : bmdualeps n f e * (1 - bmdualeps n f e) = 0 := by
      rw [mul_sub, mul_one, heps, sub_self]
    have h1 : Matrix.mulVec (bmdualeps n f e) (Matrix.mulVec (bmdualeps n f e) a) =
        Matrix.mulVec (bmdualeps n f e) a := by rw [Matrix.mulVec_mulVec, heps]
    have h2 : Matrix.mulVec (bmdualeps n f e)
        (Matrix.mulVec (1 - bmdualeps n f e) b) = 0 := by
      rw [Matrix.mulVec_mulVec, hz, Matrix.zero_mulVec]
    rw [ha] at h1
    rw [hb] at h2
    rw [h2] at h1
    exact h1.symm
  have hfin := Submodule.finrank_sup_add_finrank_inf_eq
    (LinearMap.range (Matrix.mulVecLin (bmdualeps n f e)))
    (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e)))
  rw [hsup, hdisj, finrank_top, finrank_bot, hVfin, hεdim, hUdim] at hfin
  omega

private theorem bmdual_complement_basis
    (n f r : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (heps : IsIdempotentElem (bmdualeps n f e))
    (hεadj : Matrix.transpose (bmdualeps n f e) * bmdualG n (GaloisField 2 f) =
      bmdualG n (GaloisField 2 f) * bmdualeps n f e)
    (hplus : CFSG.GroupTheory.WeirSylow.IsPlusType
      ((bmdualQ n (GaloisField 2 f)).comp
        (LinearMap.range (Matrix.mulVecLin (1 - bmdualeps n f e))).subtype))
    (hεdim : Module.finrank (GaloisField 2 f)
      (LinearMap.range (Matrix.mulVecLin (bmdualeps n f e))) = 2 * r) :
    ∃ (s : ℕ) (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f)),
      (Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f)) ∧
      (∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
        bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
          Spin.quadPlus s (GaloisField 2 f) c) ∧
      ((1 - bmdualeps n f e) * Bc = Bc) ∧
      (∀ x : bmdualι n → GaloisField 2 f,
        Matrix.mulVec (1 - bmdualeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Bc)) ∧
      r + s = n := by
  obtain ⟨s, iso, hUdim⟩ := bmdual_compl_isometry_data n f heps hεadj hplus
  refine ⟨s, bmdual_compl_Bc n f s iso, ?_, ?_, ?_, ?_, bmdual_compl_dim n f r s heps hεdim hUdim⟩
  · exact (bmdual_compl_Bc_gram n f s iso).1
  · exact (bmdual_compl_Bc_gram n f s iso).2
  · exact (bmdual_compl_Bc_fix n f heps s iso).1
  · exact (bmdual_compl_Bc_fix n f heps s iso).2

private theorem bmdual_matrix_gram_polar2
    (n f : ℕ) {r s : ℕ}
    (M : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (N : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (i : Fin r ⊕ Fin r) (j : Fin s ⊕ Fin s) :
    (Matrix.transpose M * bmdualG n (GaloisField 2 f) * N) i j =
      QuadraticMap.polar (bmdualQ n (GaloisField 2 f))
        (Matrix.mulVec M (Pi.single i 1)) (Matrix.mulVec N (Pi.single j 1)) := by
  rw [bmdual_polar_eq_dot, Matrix.mulVec_single_one, Matrix.mulVec_single_one]
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.col_apply, Matrix.mulVec,
    dotProduct, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro l _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro k _
  ring

private theorem bmdual_blocks_orthogonal
    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (heps : IsIdempotentElem (bmdualeps n f e))
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeε : bmdualeps n f e * Pe = Pe)
    (hBcε : (1 - bmdualeps n f e) * Bc = Bc)
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      Matrix.mulVec (bmdualeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Pe))
    (hBcSpan : ∀ x : bmdualι n → GaloisField 2 f,
      Matrix.mulVec (1 - bmdualeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Bc))
    (hεadj : Matrix.transpose (bmdualeps n f e) * bmdualG n (GaloisField 2 f) =
      bmdualG n (GaloisField 2 f) * bmdualeps n f e) :
    Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0 := by
  have hPe_col : ∀ i : Fin r ⊕ Fin r, Matrix.mulVec Pe (Pi.single i 1) =
      Matrix.mulVec (bmdualeps n f e) (Matrix.mulVec Pe (Pi.single i 1)) := by
    intro i; rw [Matrix.mulVec_mulVec, hPeε]
  have hBc_col : ∀ j : Fin s ⊕ Fin s, Matrix.mulVec Bc (Pi.single j 1) =
      Matrix.mulVec (1 - bmdualeps n f e) (Matrix.mulVec Bc (Pi.single j 1)) := by
    intro j; rw [Matrix.mulVec_mulVec, hBcε]
  have hz : bmdualeps n f e * (1 - bmdualeps n f e) = 0 := by
    rw [mul_sub, mul_one, heps, sub_self]
  have horth : ∀ x y : bmdualι n → GaloisField 2 f, QuadraticMap.polar (bmdualQ n (GaloisField 2 f))
      (Matrix.mulVec (bmdualeps n f e) x) (Matrix.mulVec (1 - bmdualeps n f e) y) = 0 := by
    intro x y
    have hadj1 : QuadraticMap.polar (bmdualQ n (GaloisField 2 f))
        (Matrix.mulVec (bmdualeps n f e) x) (Matrix.mulVec (1 - bmdualeps n f e) y) =
        QuadraticMap.polar (bmdualQ n (GaloisField 2 f)) x
          (Matrix.mulVec (bmdualeps n f e) (Matrix.mulVec (1 - bmdualeps n f e) y)) := by
      rw [bmdual_polar_eq_dot, bmdual_polar_eq_dot, Matrix.dotProduct_mulVec, Matrix.vecMul_mulVec,
        hεadj, ← Matrix.dotProduct_mulVec, ← Matrix.mulVec_mulVec]
    rw [hadj1, Matrix.mulVec_mulVec, hz, Matrix.zero_mulVec]
    simp
  ext i j
  rw [bmdual_matrix_gram_polar2, hPe_col i, hBc_col j]
  exact horth _ _

private theorem bmdual_adapted_complement
    (n f r : ℕ) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e))
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeε : bmdualeps n f e * Pe = Pe)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      Matrix.mulVec (bmdualeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Pe)) :
    ∃ (s : ℕ) (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f)),
      (∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
        bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) =
          Spin.quadPlus r (GaloisField 2 f) c) ∧
      (Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f)) ∧
      (∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
        bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
          Spin.quadPlus s (GaloisField 2 f) c) ∧
      (Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0) ∧
      ((1 - bmdualeps n f e) * Bc = Bc) ∧
      (∀ x : bmdualι n → GaloisField 2 f,
        Matrix.mulVec (1 - bmdualeps n f e) x ∈ LinearMap.range (Matrix.mulVecLin Bc)) ∧
      r + s = n := by
  have hPeQ := bmdual_Pe_quad n f r hquad hquad' Pe hPeG hPee hPees
  have hεadj := bmdual_eps_adjoint n f e
  have hεdim := bmdual_Pe_finrank n f r Pe hPeG hPeε hPeSpan
  have hplus := bmdual_complement_plusType n f r heps hεadj Pe hPeG hPeQ hPeε hPeSpan
  obtain ⟨s, Bc, hBcG, hBcQ, hBcε, hBcSpan, hrs⟩ :=
    bmdual_complement_basis n f r heps hεadj hplus hεdim
  have horthPB := bmdual_blocks_orthogonal n f r s heps Pe Bc hPeε hBcε hPeSpan hBcSpan hεadj
  exact ⟨s, Bc, hPeQ, hBcG, hBcQ, horthPB, hBcε, hBcSpan, hrs⟩

private theorem bmdual_adapted_decomposition
    (n f : ℕ) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e)) :
    ∃ (r s : ℕ) (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
      (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f)),
      (Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f)) ∧
      (∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
        bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) =
          Spin.quadPlus r (GaloisField 2 f) c) ∧
      (Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f)) ∧
      (∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
        bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
          Spin.quadPlus s (GaloisField 2 f) c) ∧
      (Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0) ∧
      (bmdualeps n f e * Pe = Pe) ∧ ((1 - bmdualeps n f e) * Bc = Bc) ∧
      (e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) ∧
      (bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))) ∧
      (∀ x : bmdualι n → GaloisField 2 f,
        ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
          Matrix.mulVec Pe c = Matrix.mulVec (bmdualeps n f e) x) ∧
      (∀ x : bmdualι n → GaloisField 2 f,
        ∃ c : Fin s ⊕ Fin s → GaloisField 2 f,
          Matrix.mulVec Bc c = Matrix.mulVec (1 - bmdualeps n f e) x) ∧
      r + s = n ∧ e ≠ 0 := by
  obtain ⟨r, Pe, hPeG, hPeε, hPee, hPees, hPeSpan⟩ :=
    bmdual_adapted_basis_e_span n f S he horth horth' hestar
  obtain ⟨s, Bc, hPeQ, hBcG, hBcQ, horthPB, hBcε, hBcSpan, hrs⟩ :=
    bmdual_adapted_complement n f r S he hquad hquad' horth horth' heps hestar Pe hPeG hPeε hPee
      hPees hPeSpan
  exact ⟨r, s, Pe, Bc, hPeG, hPeQ, hBcG, hBcQ, horthPB, hPeε, hBcε, hPee, hPees, hPeSpan, hBcSpan,
    hrs, he.2.2.1⟩

private noncomputable def bmdual_glueCols (n f r s : ℕ)
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f)) :
    Matrix (bmdualι n) ((Fin r ⊕ Fin r) ⊕ (Fin s ⊕ Fin s)) (GaloisField 2 f) :=
  fun i j => Sum.elim (Pe i) (Bc i) j

private theorem bmdual_glueCols_quad
    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeQ : ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) =
        Spin.quadPlus r (GaloisField 2 f) c)
    (hBcG : Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f))
    (hBcQ : ∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
        Spin.quadPlus s (GaloisField 2 f) c)
    (horthPB : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0)
    (hPeε : bmdualeps n f e * Pe = Pe) (hBcε : (1 - bmdualeps n f e) * Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmdualeps n f e) x)
    (hBcSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin s ⊕ Fin s → GaloisField 2 f,
        Matrix.mulVec Bc c = Matrix.mulVec (1 - bmdualeps n f e) x)
    (hrs : r + s = n) (hε : bmdualeps n f e ≠ 0)
    (hee : e * e = e) (horth_e : e * bmdualestar n f e = 0) :
    ∀ (c : Fin r ⊕ Fin r → GaloisField 2 f) (d : Fin s ⊕ Fin s → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c + Matrix.mulVec Bc d) =
        Spin.quadPlus r (GaloisField 2 f) c + Spin.quadPlus s (GaloisField 2 f) d := by
  intro c d
  rw [QuadraticMap.map_add (bmdualQ n (GaloisField 2 f)), hPeQ c, hBcQ d]
  have horth : QuadraticMap.polar (bmdualQ n (GaloisField 2 f))
      (Matrix.mulVec Pe c) (Matrix.mulVec Bc d) = 0 := by
    rw [bmdual_polar_eq_dot, Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, Matrix.vecMul_mulVec,
      ← Matrix.dotProduct_mulVec, ← Matrix.mul_assoc, horthPB, Matrix.zero_mulVec]
    simp
  rw [horth, add_zero]

private theorem bmdual_glueCols_span
    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeQ : ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) =
        Spin.quadPlus r (GaloisField 2 f) c)
    (hBcG : Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f))
    (hBcQ : ∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
        Spin.quadPlus s (GaloisField 2 f) c)
    (horthPB : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0)
    (hPeε : bmdualeps n f e * Pe = Pe) (hBcε : (1 - bmdualeps n f e) * Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmdualeps n f e) x)
    (hBcSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin s ⊕ Fin s → GaloisField 2 f,
        Matrix.mulVec Bc c = Matrix.mulVec (1 - bmdualeps n f e) x)
    (hrs : r + s = n) (hε : bmdualeps n f e ≠ 0)
    (hee : e * e = e) (horth_e : e * bmdualestar n f e = 0) :
    ∀ x : bmdualι n → GaloisField 2 f,
      ∃ (c : Fin r ⊕ Fin r → GaloisField 2 f) (d : Fin s ⊕ Fin s → GaloisField 2 f),
        Matrix.mulVec Pe c + Matrix.mulVec Bc d = x := by
  intro x
  obtain ⟨c, hc⟩ := hPeSpan x
  obtain ⟨d, hd⟩ := hBcSpan x
  refine ⟨c, d, ?_⟩
  rw [hc, hd, ← Matrix.add_mulVec,
    show bmdualeps n f e + (1 - bmdualeps n f e) = 1 from by abel, Matrix.one_mulVec]

private noncomputable def bmdual_glueP (n f r s : ℕ)
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (gidx : ((Fin r ⊕ Fin r) ⊕ (Fin s ⊕ Fin s)) ≃ bmdualι n) :
    Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f) :=
  Matrix.reindex (Equiv.refl (bmdualι n)) gidx (bmdual_glueCols n f r s Pe Bc)

private theorem bmdual_glueP_surjective

    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeQ : ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) =
        Spin.quadPlus r (GaloisField 2 f) c)
    (hBcG : Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f))
    (hBcQ : ∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
        Spin.quadPlus s (GaloisField 2 f) c)
    (horthPB : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0)
    (hPeε : bmdualeps n f e * Pe = Pe) (hBcε : (1 - bmdualeps n f e) * Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmdualeps n f e) x)
    (hBcSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin s ⊕ Fin s → GaloisField 2 f,
        Matrix.mulVec Bc c = Matrix.mulVec (1 - bmdualeps n f e) x)
    (hrs : r + s = n) (hε : bmdualeps n f e ≠ 0)
    (hee : e * e = e) (horth_e : e * bmdualestar n f e = 0)
    (gidx : ((Fin r ⊕ Fin r) ⊕ (Fin s ⊕ Fin s)) ≃ bmdualι n) :
    Function.Surjective (Matrix.mulVecLin (bmdual_glueP n f r s Pe Bc gidx)) := by
  intro x
  obtain ⟨c, d, hcd⟩ := bmdual_glueCols_span n f r s Pe Bc hPeG hPeQ hBcG hBcQ horthPB hPeε hBcε
    hPee hPees hPeSpan hBcSpan hrs hε hee horth_e x
  refine ⟨fun i => Sum.elim c d (gidx.symm i), ?_⟩
  rw [Matrix.mulVecLin_apply]
  have h1 : Matrix.mulVec (bmdual_glueP n f r s Pe Bc gidx)
      (fun i => Sum.elim c d (gidx.symm i)) =
      Matrix.mulVec (bmdual_glueCols n f r s Pe Bc) (Sum.elim c d) := by
    funext i
    simp only [Matrix.mulVec, dotProduct, bmdual_glueP, Matrix.reindex_apply,
      Matrix.submatrix_apply, Equiv.refl_symm, Equiv.refl_apply]
    rw [Equiv.sum_comp gidx.symm (fun k => bmdual_glueCols n f r s Pe Bc i k * Sum.elim c d k)]
  rw [h1]
  have h2 : Matrix.mulVec (bmdual_glueCols n f r s Pe Bc) (Sum.elim c d) =
      Matrix.mulVec Pe c + Matrix.mulVec Bc d := by
    funext i
    simp only [Matrix.mulVec, dotProduct, bmdual_glueCols, Fintype.sum_sum_type, Sum.elim_inl,
      Sum.elim_inr, Pi.add_apply]
  rw [h2, hcd]

private theorem bmdual_e_mul_Bc

    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeQ : ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) =
        Spin.quadPlus r (GaloisField 2 f) c)
    (hBcG : Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f))
    (hBcQ : ∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
        Spin.quadPlus s (GaloisField 2 f) c)
    (horthPB : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0)
    (hPeε : bmdualeps n f e * Pe = Pe) (hBcε : (1 - bmdualeps n f e) * Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmdualeps n f e) x)
    (hBcSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin s ⊕ Fin s → GaloisField 2 f,
        Matrix.mulVec Bc c = Matrix.mulVec (1 - bmdualeps n f e) x)
    (hrs : r + s = n) (hε : bmdualeps n f e ≠ 0)
    (hee : e * e = e) (horth_e : e * bmdualestar n f e = 0) :
    e * Bc = 0 := by
  have hepsBc : bmdualeps n f e * Bc = 0 := by
    have h := hBcε
    rw [Matrix.sub_mul, Matrix.one_mul] at h
    have h2 : Bc = Bc + bmdualeps n f e * Bc := by
      calc Bc = (Bc - bmdualeps n f e * Bc) + bmdualeps n f e * Bc := by abel
        _ = Bc + bmdualeps n f e * Bc := by rw [h]
    exact add_left_cancel (h2.symm.trans (add_zero Bc).symm)
  have h1 : e * Bc = bmdualestar n f e * Bc := by
    rw [bmdualeps, Matrix.add_mul] at hepsBc
    have h := eq_neg_of_add_eq_zero_left hepsBc
    rw [h]
    ext i j
    simp only [Matrix.neg_apply, CharTwo.neg_eq]
  calc e * Bc = e * (e * Bc) := by rw [← Matrix.mul_assoc, hee]
    _ = e * (bmdualestar n f e * Bc) := by rw [h1]
    _ = (e * bmdualestar n f e) * Bc := by rw [Matrix.mul_assoc]
    _ = 0 := by rw [horth_e, Matrix.zero_mul]

private theorem bmdual_glueCols_e_mul

    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeQ : ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) =
        Spin.quadPlus r (GaloisField 2 f) c)
    (hBcG : Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f))
    (hBcQ : ∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
        Spin.quadPlus s (GaloisField 2 f) c)
    (horthPB : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0)
    (hPeε : bmdualeps n f e * Pe = Pe) (hBcε : (1 - bmdualeps n f e) * Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmdualeps n f e) x)
    (hBcSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin s ⊕ Fin s → GaloisField 2 f,
        Matrix.mulVec Bc c = Matrix.mulVec (1 - bmdualeps n f e) x)
    (hrs : r + s = n) (hε : bmdualeps n f e ≠ 0)
    (hee : e * e = e) (horth_e : e * bmdualestar n f e = 0) :
    e * bmdual_glueCols n f r s Pe Bc =
      bmdual_glueCols n f r s Pe Bc *
        Matrix.fromBlocks
          (Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
            (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
            (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
            (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
          (0 : Matrix (Fin r ⊕ Fin r) (Fin s ⊕ Fin s) (GaloisField 2 f))
          (0 : Matrix (Fin s ⊕ Fin s) (Fin r ⊕ Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin s ⊕ Fin s) (Fin s ⊕ Fin s) (GaloisField 2 f)) := by
  have heBc : e * Bc = 0 := bmdual_e_mul_Bc n f r s Pe Bc hPeG hPeQ hBcG hBcQ horthPB hPeε
    hBcε hPee hPees hPeSpan hBcSpan hrs hε hee horth_e
  ext i j
  rcases j with (a | a) | a
  · have hL : (e * bmdual_glueCols n f r s Pe Bc) i (Sum.inl (Sum.inl a)) =
        (e * Pe) i (Sum.inl a) := by
      simp [bmdual_glueCols, Matrix.mul_apply]
    have hD : (bmdual_glueCols n f r s Pe Bc * Matrix.fromBlocks
        (Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
        (0 : Matrix (Fin r ⊕ Fin r) (Fin s ⊕ Fin s) (GaloisField 2 f))
        (0 : Matrix (Fin s ⊕ Fin s) (Fin r ⊕ Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin s ⊕ Fin s) (Fin s ⊕ Fin s) (GaloisField 2 f)))
        i (Sum.inl (Sum.inl a)) =
        bmdual_glueCols n f r s Pe Bc i (Sum.inl (Sum.inl a)) := by
      rw [Matrix.mul_apply, Fintype.sum_sum_type]
      simp [bmdual_glueCols, Matrix.fromBlocks, Matrix.mul_apply, Matrix.one_apply,
        Fintype.sum_sum_type, Finset.sum_ite_eq]
    rw [hL, hD, hPee]
    simp [bmdual_glueCols, Matrix.fromBlocks, Matrix.mul_apply, Matrix.one_apply,
      Fintype.sum_sum_type, Finset.sum_ite_eq]
  · have hL : (e * bmdual_glueCols n f r s Pe Bc) i (Sum.inl (Sum.inr a)) =
        (e * Pe) i (Sum.inr a) := by
      simp [bmdual_glueCols, Matrix.mul_apply]
    have hD : (bmdual_glueCols n f r s Pe Bc * Matrix.fromBlocks
        (Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
        (0 : Matrix (Fin r ⊕ Fin r) (Fin s ⊕ Fin s) (GaloisField 2 f))
        (0 : Matrix (Fin s ⊕ Fin s) (Fin r ⊕ Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin s ⊕ Fin s) (Fin s ⊕ Fin s) (GaloisField 2 f)))
        i (Sum.inl (Sum.inr a)) = 0 := by
      rw [Matrix.mul_apply, Fintype.sum_sum_type]
      simp [bmdual_glueCols, Matrix.fromBlocks, Matrix.mul_apply]
    rw [hL, hD, hPee]
    simp [Matrix.fromBlocks, Matrix.mul_apply, Matrix.one_apply, Matrix.zero_apply,
      Fintype.sum_sum_type]
  · have hL : (e * bmdual_glueCols n f r s Pe Bc) i (Sum.inr a) = (e * Bc) i a := by
      simp [bmdual_glueCols, Matrix.mul_apply]
    have hD : (bmdual_glueCols n f r s Pe Bc * Matrix.fromBlocks
        (Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
        (0 : Matrix (Fin r ⊕ Fin r) (Fin s ⊕ Fin s) (GaloisField 2 f))
        (0 : Matrix (Fin s ⊕ Fin s) (Fin r ⊕ Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin s ⊕ Fin s) (Fin s ⊕ Fin s) (GaloisField 2 f)))
        i (Sum.inr a) = 0 := by
      rw [Matrix.mul_apply, Fintype.sum_sum_type]
