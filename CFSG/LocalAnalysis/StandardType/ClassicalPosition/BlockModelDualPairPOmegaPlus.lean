private noncomputable def bmdual_glueSplit (r s : ℕ) :
    Fin r ⊕ (Fin r ⊕ Fin (2 * s)) ≃ ((Fin r ⊕ Fin r) ⊕ (Fin s ⊕ Fin s)) :=
  (Equiv.sumAssoc (Fin r) (Fin r) (Fin (2 * s))).symm.trans
    (Equiv.sumCongr (Equiv.refl (Fin r ⊕ Fin r))
      ((finCongr (two_mul s)).trans finSumFinEquiv.symm))

private theorem bmdual_glueP_eq_glueCols
    (n f r s : ℕ)
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (gidx : ((Fin r ⊕ Fin r) ⊕ (Fin s ⊕ Fin s)) ≃ bmdualι n) :
    bmdual_glueP n f r s Pe Bc gidx =
      (bmdual_glueCols n f r s Pe Bc).submatrix id gidx.symm := by
  rw [bmdual_glueP, Matrix.reindex_apply]
  rfl

private theorem bmdual_glueP_submatrix_e
    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (gidx : ((Fin r ⊕ Fin r) ⊕ (Fin s ⊕ Fin s)) ≃ bmdualι n) :
    e * (bmdual_glueCols n f r s Pe Bc).submatrix id gidx.symm =
      (e * bmdual_glueCols n f r s Pe Bc).submatrix id gidx.symm := by
  ext i k
  simp only [Matrix.mul_apply, Matrix.submatrix_apply, id_eq]

private theorem bmdual_glueP_split_D0
    (n f r s : ℕ)
    (gidx : ((Fin r ⊕ Fin r) ⊕ (Fin s ⊕ Fin s)) ≃ bmdualι n) :
    Matrix.reindex ((bmdual_glueSplit r s).trans gidx) ((bmdual_glueSplit r s).trans gidx)
      (bmdual_D0 r (2 * s) (GaloisField 2 f)) =
      (Matrix.fromBlocks
        (Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
          (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
        (0 : Matrix (Fin r ⊕ Fin r) (Fin s ⊕ Fin s) (GaloisField 2 f))
        (0 : Matrix (Fin s ⊕ Fin s) (Fin r ⊕ Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin s ⊕ Fin s) (Fin s ⊕ Fin s) (GaloisField 2 f))).submatrix
        gidx.symm gidx.symm := by
  rw [Matrix.reindex_apply]
  rw [show ((bmdual_glueSplit r s).trans gidx).symm =
      gidx.symm.trans (bmdual_glueSplit r s).symm from rfl]
  rw [show gidx.symm.trans (bmdual_glueSplit r s).symm =
      (bmdual_glueSplit r s).symm ∘ gidx.symm from rfl]
  rw [← Matrix.submatrix_submatrix]
  congr 1
  ext i j
  rcases i with (a | a) | a <;> rcases j with (b | b) | b <;>
    simp [bmdual_glueSplit, bmdual_D0, Matrix.submatrix_apply, Matrix.fromBlocks,
      Matrix.one_apply, Equiv.sumAssoc, Equiv.sumCongr, finSumFinEquiv]

private noncomputable def bmdual_glueGidx (r s n : ℕ) (hrs : r + s = n) :
    ((Fin r ⊕ Fin r) ⊕ (Fin s ⊕ Fin s)) ≃ bmdualι n :=
  (Equiv.sumSumSumComm (Fin r) (Fin r) (Fin s) (Fin s)).trans
    ((Equiv.sumCongr finSumFinEquiv finSumFinEquiv).trans
      (Equiv.sumCongr (finCongr hrs) (finCongr hrs)))

private theorem bmdual_glue_basis_P_glue

    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeQ : ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) =
        Spin.quadPlus r (GaloisField 2 f) c)
    (hBcG : Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f))
    (hBcQ : ∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
        Spin.quadPlus s (GaloisField 2 f) c)
    (horthPB : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0)
    (hPeε : bmdualeps n f e * Pe = Pe) (hBcε : (1 - bmdualeps n f e) * Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmdualeps n f e) x)
    (hBcSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin s ⊕ Fin s → GaloisField 2 f,
        Matrix.mulVec Bc c = Matrix.mulVec (1 - bmdualeps n f e) x)
    (hrs : r + s = n) (hε : bmdualeps n f e ≠ 0)
    (hee : e * e = e) (horth_e : e * bmdualestar n f e = 0)
    (gidx : ((Fin r ⊕ Fin r) ⊕ (Fin s ⊕ Fin s)) ≃ bmdualι n) :
    ∃ (eidx : Fin r ⊕ (Fin r ⊕ Fin (2 * s)) ≃ bmdualι n),
      eidx = (bmdual_glueSplit r s).trans gidx ∧
      e * bmdual_glueP n f r s Pe Bc gidx =
        bmdual_glueP n f r s Pe Bc gidx *
          Matrix.reindex eidx eidx (bmdual_D0 r (2 * s) (GaloisField 2 f)) := by
  refine ⟨(bmdual_glueSplit r s).trans gidx, rfl, ?_⟩
  have hW := bmdual_glueCols_e_mul n f r s Pe Bc hPeG hPeQ hBcG hBcQ horthPB hPeε hBcε hPee hPees
    hPeSpan hBcSpan hrs hε hee horth_e
  rw [bmdual_glueP_eq_glueCols, bmdual_glueP_submatrix_e, hW, bmdual_glueP_split_D0]
  exact (Matrix.submatrix_mul_equiv (bmdual_glueCols n f r s Pe Bc)
    (Matrix.fromBlocks
      (Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
        (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
      (0 : Matrix (Fin r ⊕ Fin r) (Fin s ⊕ Fin s) (GaloisField 2 f))
      (0 : Matrix (Fin s ⊕ Fin s) (Fin r ⊕ Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin s ⊕ Fin s) (Fin s ⊕ Fin s) (GaloisField 2 f)))
    id gidx.symm gidx.symm).symm

private theorem bmdual_glue_basis_P_inv

    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeQ : ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) =
        Spin.quadPlus r (GaloisField 2 f) c)
    (hBcG : Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f))
    (hBcQ : ∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
        Spin.quadPlus s (GaloisField 2 f) c)
    (horthPB : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0)
    (hPeε : bmdualeps n f e * Pe = Pe) (hBcε : (1 - bmdualeps n f e) * Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmdualeps n f e) x)
    (hBcSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin s ⊕ Fin s → GaloisField 2 f,
        Matrix.mulVec Bc c = Matrix.mulVec (1 - bmdualeps n f e) x)
    (hrs : r + s = n) (hε : bmdualeps n f e ≠ 0)
    (hee : e * e = e) (horth_e : e * bmdualestar n f e = 0)
    (gidx : ((Fin r ⊕ Fin r) ⊕ (Fin s ⊕ Fin s)) ≃ bmdualι n) :
    bmdual_glueP n f r s Pe Bc gidx * (bmdual_glueP n f r s Pe Bc gidx)⁻¹ = 1 ∧
      (bmdual_glueP n f r s Pe Bc gidx)⁻¹ * bmdual_glueP n f r s Pe Bc gidx = 1 := by
  have hsurj := bmdual_glueP_surjective n f r s Pe Bc hPeG hPeQ hBcG hBcQ horthPB hPeε hBcε hPee
    hPees hPeSpan hBcSpan hrs hε hee horth_e gidx
  have hinj : Function.Injective (Matrix.mulVecLin (bmdual_glueP n f r s Pe Bc gidx)) :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank rfl).mpr hsurj
  have hunit : IsUnit (bmdual_glueP n f r s Pe Bc gidx) :=
    (Matrix.linearIndependent_cols_iff_isUnit).mp (Matrix.mulVec_injective_iff.mp hinj)
  have hunitdet : IsUnit (bmdual_glueP n f r s Pe Bc gidx).det := by
    rw [← Matrix.isUnit_iff_isUnit_det]; exact hunit
  exact ⟨Matrix.mul_nonsing_inv _ hunitdet, Matrix.nonsing_inv_mul _ hunitdet⟩

private theorem bmdual_glue_r_pos
    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmdualeps n f e) x)
    (hε : bmdualeps n f e ≠ 0) :
    1 ≤ r := by
  rcases Nat.eq_zero_or_pos r with h | h
  · exfalso
    apply hε
    subst h
    ext i j
    obtain ⟨c, hc⟩ := hPeSpan (Pi.single j 1)
    have hc0 : c = 0 := Subsingleton.elim c 0
    rw [hc0, Matrix.mulVec_zero] at hc
    have := congrFun hc.symm i
    simpa [Matrix.mulVec, dotProduct, Pi.single_apply] using this
  · exact h

private noncomputable def bmdual_glueCast (r s : ℕ) (hr' : r - 1 + 1 = r) :
    Fin (r - 1 + 1) ⊕ (Fin (r - 1 + 1) ⊕ Fin (2 * s)) ≃
      Fin r ⊕ (Fin r ⊕ Fin (2 * s)) :=
  Equiv.sumCongr (finCongr hr') (Equiv.sumCongr (finCongr hr') (Equiv.refl (Fin (2 * s))))

private theorem bmdual_glueCast_symm_apply
    (r s : ℕ) (hr' : r - 1 + 1 = r) :
    (∀ a : Fin r, (bmdual_glueCast r s hr').symm (Sum.inl a) =
      Sum.inl ((finCongr hr').symm a)) ∧
    (∀ a : Fin r, (bmdual_glueCast r s hr').symm (Sum.inr (Sum.inl a)) =
      Sum.inr (Sum.inl ((finCongr hr').symm a))) ∧
    (∀ a : Fin (2 * s), (bmdual_glueCast r s hr').symm (Sum.inr (Sum.inr a)) =
      Sum.inr (Sum.inr a)) := by
  refine ⟨?_, ?_, ?_⟩ <;> intro a <;>
    simp [bmdual_glueCast, Equiv.sumCongr_symm, Equiv.refl_symm]

private theorem bmdual_glueCast_D0_apply
    (f r s : ℕ) (hr' : r - 1 + 1 = r)
    (i j : Fin r ⊕ (Fin r ⊕ Fin (2 * s))) :
    (bmdual_D0 (r - 1 + 1) (2 * s) (GaloisField 2 f)) ((bmdual_glueCast r s hr').symm i)
      ((bmdual_glueCast r s hr').symm j) =
      (bmdual_D0 r (2 * s) (GaloisField 2 f)) i j := by
  obtain ⟨h1, h2, h3⟩ := bmdual_glueCast_symm_apply r s hr'
  have key : ∀ x : Fin r ⊕ (Fin r ⊕ Fin (2 * s)),
      (bmdual_glueCast r s hr').symm x = match x with
        | Sum.inl a => Sum.inl ((finCongr hr').symm a)
        | Sum.inr (Sum.inl a) => Sum.inr (Sum.inl ((finCongr hr').symm a))
        | Sum.inr (Sum.inr c) => Sum.inr (Sum.inr c) := by
    intro x; rcases x with a | (a | c)
    · exact h1 a
    · exact h2 a
    · exact h3 c
  rw [key i, key j]
  rcases i with a | (a | c) <;> rcases j with b | (b | d) <;>
    simp [bmdual_D0, Matrix.fromBlocks, Matrix.fromBlocks_zero, Matrix.one_apply, finCongr]

private theorem bmdual_glueCast_D0_base
    (f r s : ℕ) (hr' : r - 1 + 1 = r) :
    Matrix.reindex (bmdual_glueCast r s hr') (bmdual_glueCast r s hr')
      (bmdual_D0 (r - 1 + 1) (2 * s) (GaloisField 2 f)) =
      bmdual_D0 r (2 * s) (GaloisField 2 f) := by
  rw [Matrix.reindex_apply]
  ext i j
  exact bmdual_glueCast_D0_apply f r s hr' i j

private theorem bmdual_glueCast_reindex_trans
    (n f r s : ℕ) (hr' : r - 1 + 1 = r)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin (2 * s)) ≃ bmdualι n)
    (M : Matrix (Fin (r - 1 + 1) ⊕ (Fin (r - 1 + 1) ⊕ Fin (2 * s)))
      (Fin (r - 1 + 1) ⊕ (Fin (r - 1 + 1) ⊕ Fin (2 * s))) (GaloisField 2 f)) :
    Matrix.reindex ((bmdual_glueCast r s hr').trans eidx) ((bmdual_glueCast r s hr').trans eidx) M =
      (Matrix.reindex (bmdual_glueCast r s hr') (bmdual_glueCast r s hr') M).submatrix
        eidx.symm eidx.symm := by
  rw [Matrix.reindex_apply, Matrix.reindex_apply]
  rw [show ((bmdual_glueCast r s hr').trans eidx).symm =
      eidx.symm.trans (bmdual_glueCast r s hr').symm from rfl]
  rw [show eidx.symm.trans (bmdual_glueCast r s hr').symm =
      (bmdual_glueCast r s hr').symm ∘ eidx.symm from by funext x; rfl]
  rw [Matrix.submatrix_submatrix]

private theorem bmdual_glueCast_D0
    (n f r s : ℕ) (hr' : r - 1 + 1 = r)
    (eidx : Fin r ⊕ (Fin r ⊕ Fin (2 * s)) ≃ bmdualι n) :
    Matrix.reindex ((bmdual_glueCast r s hr').trans eidx) ((bmdual_glueCast r s hr').trans eidx)
      (bmdual_D0 (r - 1 + 1) (2 * s) (GaloisField 2 f)) =
      Matrix.reindex eidx eidx (bmdual_D0 r (2 * s) (GaloisField 2 f)) := by
  rw [bmdual_glueCast_reindex_trans n f r s hr' eidx
      (bmdual_D0 (r - 1 + 1) (2 * s) (GaloisField 2 f)),
    bmdual_glueCast_D0_base f r s hr']
  rw [Matrix.reindex_apply]

private theorem bmdual_glueGidx_inl_inl
    (n r s : ℕ) (hrs : r + s = n) (i : Fin r) :
    (bmdual_glueGidx r s n hrs) (Sum.inl (Sum.inl i)) =
      Sum.inl (finSumFinEquiv.trans (finCongr hrs) (Sum.inl i)) := by
  simp [bmdual_glueGidx, Equiv.sumCongr, Equiv.sumSumSumComm]

private theorem bmdual_glueGidx_inl_inr
    (n r s : ℕ) (hrs : r + s = n) (i : Fin r) :
    (bmdual_glueGidx r s n hrs) (Sum.inl (Sum.inr i)) =
      Sum.inr (finSumFinEquiv.trans (finCongr hrs) (Sum.inl i)) := by
  simp [bmdual_glueGidx, Equiv.sumCongr, Equiv.sumSumSumComm]

private theorem bmdual_glueGidx_inr_inl
    (n r s : ℕ) (hrs : r + s = n) (j : Fin s) :
    (bmdual_glueGidx r s n hrs) (Sum.inr (Sum.inl j)) =
      Sum.inl (finSumFinEquiv.trans (finCongr hrs) (Sum.inr j)) := by
  simp [bmdual_glueGidx, Equiv.sumCongr, Equiv.sumSumSumComm]

private theorem bmdual_glueGidx_inr_inr
    (n r s : ℕ) (hrs : r + s = n) (j : Fin s) :
    (bmdual_glueGidx r s n hrs) (Sum.inr (Sum.inr j)) =
      Sum.inr (finSumFinEquiv.trans (finCongr hrs) (Sum.inr j)) := by
  simp [bmdual_glueGidx, Equiv.sumCongr, Equiv.sumSumSumComm]

private theorem bmdual_glueGidx_isometry
    (n f r s : ℕ) (hrs : r + s = n) :
    ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) v =
        Spin.quadPlus r (GaloisField 2 f)
          (fun a : Fin r ⊕ Fin r => v ((bmdual_glueGidx r s n hrs) (Sum.inl a))) +
        Spin.quadPlus s (GaloisField 2 f)
          (fun b : Fin s ⊕ Fin s => v ((bmdual_glueGidx r s n hrs) (Sum.inr b))) := by
  intro v
  subst hrs
  simp only [bmdualQ, Spin.quadPlus_apply, Fintype.sum_sum_type, bmdual_glueGidx_inl_inl,
    bmdual_glueGidx_inl_inr, bmdual_glueGidx_inr_inl, bmdual_glueGidx_inr_inr, finCongr_refl,
    Equiv.refl_apply, Equiv.trans_apply, finSumFinEquiv_apply_left, finSumFinEquiv_apply_right]
  rw [Fin.sum_univ_add]

private theorem bmdual_glueP_mulVec_eq
    (n f r s : ℕ)
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (gidx : ((Fin r ⊕ Fin r) ⊕ (Fin s ⊕ Fin s)) ≃ bmdualι n)
    (v : bmdualι n → GaloisField 2 f) :
    Matrix.mulVec (bmdual_glueP n f r s Pe Bc gidx) v =
      Matrix.mulVec Pe (fun a : Fin r ⊕ Fin r => v (gidx (Sum.inl a))) +
        Matrix.mulVec Bc (fun b : Fin s ⊕ Fin s => v (gidx (Sum.inr b))) := by
  funext i
  simp only [bmdual_glueP, Matrix.reindex_apply, Matrix.mulVec, dotProduct, Pi.add_apply,
    Matrix.submatrix_apply, Equiv.refl_symm, Equiv.refl_apply]
  rw [← Equiv.sum_comp gidx]
  simp [bmdual_glueCols, Fintype.sum_sum_type]

private theorem bmdual_glueP_isometry
    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeQ : ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) =
        Spin.quadPlus r (GaloisField 2 f) c)
    (hBcG : Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f))
    (hBcQ : ∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
        Spin.quadPlus s (GaloisField 2 f) c)
    (horthPB : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0)
    (hPeε : bmdualeps n f e * Pe = Pe) (hBcε : (1 - bmdualeps n f e) * Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmdualeps n f e) x)
    (hBcSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin s ⊕ Fin s → GaloisField 2 f,
        Matrix.mulVec Bc c = Matrix.mulVec (1 - bmdualeps n f e) x)
    (hrs : r + s = n) (hε : bmdualeps n f e ≠ 0)
    (hee : e * e = e) (horth_e : e * bmdualestar n f e = 0)
 :
    ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f)
        (Matrix.mulVec (bmdual_glueP n f r s Pe Bc (bmdual_glueGidx r s n hrs)) v) =
        bmdualQ n (GaloisField 2 f) v := by
  intro v
  rw [bmdual_glueP_mulVec_eq n f r s Pe Bc (bmdual_glueGidx r s n hrs) v]
  rw [bmdual_glueCols_quad n f r s Pe Bc hPeG hPeQ hBcG hBcQ horthPB hPeε hBcε hPee hPees hPeSpan
    hBcSpan hrs hε hee horth_e (fun a => v (bmdual_glueGidx r s n hrs (Sum.inl a)))
    (fun b => v (bmdual_glueGidx r s n hrs (Sum.inr b)))]
  exact (bmdual_glueGidx_isometry n f r s hrs v).symm

private theorem bmdual_glue_basis_P
    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeQ : ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) =
        Spin.quadPlus r (GaloisField 2 f) c)
    (hBcG : Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f))
    (hBcQ : ∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
        Spin.quadPlus s (GaloisField 2 f) c)
    (horthPB : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0)
    (hPeε : bmdualeps n f e * Pe = Pe) (hBcε : (1 - bmdualeps n f e) * Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmdualeps n f e) x)
    (hBcSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin s ⊕ Fin s → GaloisField 2 f,
        Matrix.mulVec Bc c = Matrix.mulVec (1 - bmdualeps n f e) x)
    (hrs : r + s = n) (hε : bmdualeps n f e ≠ 0)
    (hee : e * e = e) (horth_e : e * bmdualestar n f e = 0) :
    ∃ (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)),
      P * Pinv = 1 ∧ Pinv * P = 1 ∧
      (∀ v : bmdualι n → GaloisField 2 f,
        bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v) ∧
      Pinv * Matrix.reindex
          ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs))
          ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs))
          (bmdual_D0 r (2 * s) (GaloisField 2 f)) * P = e := by
  let gidx := bmdual_glueGidx r s n hrs
  obtain ⟨eidx, heidx, hmul⟩ := bmdual_glue_basis_P_glue n f r s Pe Bc hPeG hPeQ hBcG hBcQ horthPB
    hPeε hBcε hPee hPees hPeSpan hBcSpan hrs hε hee horth_e gidx
  obtain ⟨hinv1, hinv2⟩ := bmdual_glue_basis_P_inv n f r s Pe Bc hPeG hPeQ hBcG hBcQ horthPB hPeε
    hBcε hPee hPees hPeSpan hBcSpan hrs hε hee horth_e gidx
  have hiso := bmdual_glueP_isometry n f r s Pe Bc hPeG hPeQ hBcG hBcQ horthPB hPeε hBcε hPee hPees
    hPeSpan hBcSpan hrs hε hee horth_e
  refine ⟨(bmdual_glueP n f r s Pe Bc gidx)⁻¹, bmdual_glueP n f r s Pe Bc gidx,
    hinv2, hinv1, ?_, ?_⟩
  · intro v
    have h := hiso (Matrix.mulVec (bmdual_glueP n f r s Pe Bc gidx)⁻¹ v)
    rw [Matrix.mulVec_mulVec, hinv1, Matrix.one_mulVec] at h
    exact h.symm
  · rw [← heidx]
    calc bmdual_glueP n f r s Pe Bc gidx *
          Matrix.reindex eidx eidx (bmdual_D0 r (2 * s) (GaloisField 2 f)) *
            (bmdual_glueP n f r s Pe Bc gidx)⁻¹
        = (e * bmdual_glueP n f r s Pe Bc gidx) *
            (bmdual_glueP n f r s Pe Bc gidx)⁻¹ := by rw [← hmul]
      _ = e * (bmdual_glueP n f r s Pe Bc gidx *
            (bmdual_glueP n f r s Pe Bc gidx)⁻¹) := by rw [Matrix.mul_assoc]
      _ = e * 1 := by rw [hinv1]
      _ = e := by rw [Matrix.mul_one]

private theorem bmdual_blockMat_mulVec
    (n f R r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (c d : Fin (R + 1) → GaloisField 2 f) (e : Fin r' → GaloisField 2 f) :
    Matrix.mulVec (bmdual_blockMat n f (R + 1) r' x) (Sum.elim c (Sum.elim d e)) =
      Sum.elim (Matrix.mulVec (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) c)
        (Sum.elim (Matrix.mulVec
          (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) d) e) := by
  ext i
  rcases i with k | (k | k) <;>
    simp [bmdual_blockMat, Matrix.fromBlocks, Matrix.mulVec, dotProduct, Fintype.sum_sum_type,
      Sum.elim_inl, Sum.elim_inr, Pi.add_apply, Matrix.one_apply, Finset.sum_ite_eq]

private theorem bmdual_reindex_mulVec {m n : Type*} [Fintype m] [Fintype n] {F : Type}
    [Semiring F] (e : m ≃ n) (A : Matrix m m F) (v : n → F) :
    Matrix.mulVec (Matrix.reindex e e A) v = (Matrix.mulVec A (v ∘ e)) ∘ e.symm := by
  funext i
  show (∑ j : n, A (e.symm i) (e.symm j) * v j) =
    ∑ k : m, A (e.symm i) k * v (e k)
  have h := (Equiv.sum_comp e (fun j : n => A (e.symm i) (e.symm j) * v j)).symm
  simpa using h

private theorem bmdual_quadPlus_sl_isometry (m f : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f))
    (c d : Fin m → GaloisField 2 f) :
    Spin.quadPlus m (GaloisField 2 f)
      (Sum.elim (Matrix.mulVec (x : Matrix (Fin m) (Fin m) (GaloisField 2 f)) c)
        (Matrix.mulVec (Matrix.transpose
          ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
            Matrix (Fin m) (Fin m) (GaloisField 2 f))) d)) =
      Spin.quadPlus m (GaloisField 2 f) (Sum.elim c d) := by
  have hmul : Matrix.transpose ((x : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) *
      Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) = 1 := by
    rw [← Matrix.transpose_mul, ← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel,
      Matrix.SpecialLinearGroup.coe_one, Matrix.transpose_one]
  have hdot : Matrix.mulVec (x : Matrix (Fin m) (Fin m) (GaloisField 2 f)) c ⬝ᵥ
      Matrix.mulVec (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f))) d = c ⬝ᵥ d := by
    rw [Matrix.dotProduct_mulVec, Matrix.vecMul_mulVec, hmul, Matrix.vecMul_one]
  simpa only [Spin.quadPlus_apply, Sum.elim_inl, Sum.elim_inr, dotProduct] using hdot

private theorem bmdual_glueSplit_symm_inl_inl (r s : ℕ) (a : Fin r) :
    (bmdual_glueSplit r s).symm (Sum.inl (Sum.inl a)) = Sum.inl a := by
  simp [bmdual_glueSplit, Equiv.sumAssoc, Equiv.sumCongr]

private theorem bmdual_glueSplit_symm_inl_inr (r s : ℕ) (a : Fin r) :
    (bmdual_glueSplit r s).symm (Sum.inl (Sum.inr a)) = Sum.inr (Sum.inl a) := by
  simp [bmdual_glueSplit, Equiv.sumAssoc, Equiv.sumCongr]

private theorem bmdual_glueSplit_symm_inr (r s : ℕ) (b : Fin s ⊕ Fin s) :
    (bmdual_glueSplit r s).symm (Sum.inr b) =
      Sum.inr (Sum.inr (((finCongr (two_mul s)).trans finSumFinEquiv.symm).symm b)) := by
  obtain ⟨b | b⟩ := b <;>
    simp [bmdual_glueSplit, Equiv.sumAssoc, Equiv.sumCongr, Equiv.trans_apply]

private theorem bmdual_quadPlus_finCongr (m m' : ℕ) (h : m = m') (f : ℕ)
    (c d : Fin m → GaloisField 2 f) :
    Spin.quadPlus m (GaloisField 2 f) (Sum.elim c d) =
      Spin.quadPlus m' (GaloisField 2 f)
        (Sum.elim (c ∘ (finCongr h).symm) (d ∘ (finCongr h).symm)) := by
  subst h
  rw [Spin.quadPlus_apply, Spin.quadPlus_apply]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  simp [finCongr_refl]

private theorem bmdual_glue_eidx0_quad
    (n f r s : ℕ) (hrs : r + s = n)
    (y : Fin r ⊕ (Fin r ⊕ Fin (2 * s)) → GaloisField 2 f) :
    bmdualQ n (GaloisField 2 f)
        (y ∘ ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs)).symm) =
      Spin.quadPlus r (GaloisField 2 f)
        (Sum.elim (fun a : Fin r => y (Sum.inl a))
          (fun a : Fin r => y (Sum.inr (Sum.inl a)))) +
      Spin.quadPlus s (GaloisField 2 f)
        (fun b : Fin s ⊕ Fin s =>
          y (Sum.inr (Sum.inr (((finCongr (two_mul s)).trans finSumFinEquiv.symm).symm b)))) := by
  have h := bmdual_glueGidx_isometry n f r s hrs
    (y ∘ ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs)).symm)
  have hfun1 : (fun a : Fin r ⊕ Fin r =>
        (y ∘ ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs)).symm)
          (bmdual_glueGidx r s n hrs (Sum.inl a))) =
      Sum.elim (fun a : Fin r => y (Sum.inl a))
        (fun a : Fin r => y (Sum.inr (Sum.inl a))) := by
    funext a
    rcases a with a | a <;>
      simp [Function.comp_apply, Equiv.trans_apply, Equiv.symm_apply_apply,
        bmdual_glueSplit_symm_inl_inl, bmdual_glueSplit_symm_inl_inr]
  have hfun2 : (fun b : Fin s ⊕ Fin s =>
        (y ∘ ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs)).symm)
          (bmdual_glueGidx r s n hrs (Sum.inr b))) =
      (fun b : Fin s ⊕ Fin s =>
        y (Sum.inr (Sum.inr (((finCongr (two_mul s)).trans finSumFinEquiv.symm).symm b)))) := by
    funext b
    rcases b with b | b <;>
      simp [Function.comp_apply, Equiv.trans_apply, Equiv.symm_apply_apply,
        bmdual_glueSplit_symm_inr]
  rw [h, hfun1, hfun2]

private theorem bmdual_glue_block_hQ
    (n f r s : ℕ) (hrs : r + s = n) (hr' : r - 1 + 1 = r)
    (c d : Fin (r - 1 + 1) → GaloisField 2 f) (e' : Fin (2 * s) → GaloisField 2 f) :
    bmdualQ n (GaloisField 2 f)
        (Sum.elim c (Sum.elim d e') ∘ (((bmdual_glueCast r s hr').trans
          ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs))).symm)) =
      Spin.quadPlus (r - 1 + 1) (GaloisField 2 f) (Sum.elim c d) +
      bmdualQ n (GaloisField 2 f)
        (Sum.elim (0 : Fin (r - 1 + 1) → GaloisField 2 f) (Sum.elim 0 e') ∘
          (((bmdual_glueCast r s hr').trans
            ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs))).symm)) := by
  let cast := bmdual_glueCast r s hr'
  let eidx0 := (bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs)
  have hcast : ∀ y : Fin (r - 1 + 1) ⊕ (Fin (r - 1 + 1) ⊕ Fin (2 * s)) →
        GaloisField 2 f,
      y ∘ (cast.trans eidx0).symm = (y ∘ cast.symm) ∘ eidx0.symm := by
    intro y
    funext i
    simp [Function.comp_apply, Equiv.symm_trans, Equiv.trans_apply]
  have hcomp : (Sum.elim c (Sum.elim d e') ∘ cast.symm) =
      Sum.elim (c ∘ (finCongr hr').symm) (Sum.elim (d ∘ (finCongr hr').symm) e') := by
    funext i
    rcases i with a | (a | z)
    · simp [cast, bmdual_glueCast, Equiv.sumCongr, Function.comp_apply]
    · simp [cast, bmdual_glueCast, Equiv.sumCongr, Function.comp_apply]
    · simp [cast, bmdual_glueCast, Equiv.sumCongr, Function.comp_apply]
  have hcomp0 : (Sum.elim (0 : Fin (r - 1 + 1) → GaloisField 2 f) (Sum.elim 0 e') ∘
        cast.symm) = Sum.elim (0 : Fin r → GaloisField 2 f) (Sum.elim 0 e') := by
    funext i
    rcases i with a | (a | z)
    · simp [cast, bmdual_glueCast, Equiv.sumCongr, Function.comp_apply]
    · simp [cast, bmdual_glueCast, Equiv.sumCongr, Function.comp_apply]
    · simp [cast, bmdual_glueCast, Equiv.sumCongr, Function.comp_apply]
  rw [hcast, hcomp, bmdual_glue_eidx0_quad n f r s hrs, hcast, hcomp0,
    bmdual_glue_eidx0_quad n f r s hrs]
  rw [bmdual_quadPlus_finCongr (r - 1 + 1) r hr' f c d]
  simp [Spin.quadPlus_apply]

private theorem bmdual_glue_block_isometry
    (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (hQ : ∀ (c d : Fin (R + 1) → GaloisField 2 f) (e : Fin r' → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Sum.elim c (Sum.elim d e) ∘ eidx.symm) =
        Spin.quadPlus (R + 1) (GaloisField 2 f) (Sum.elim c d) +
        bmdualQ n (GaloisField 2 f)
          (Sum.elim (0 : Fin (R + 1) → GaloisField 2 f) (Sum.elim 0 e) ∘ eidx.symm))
    (w : bmdualι n → GaloisField 2 f) :
    bmdualQ n (GaloisField 2 f) (Matrix.mulVec
      (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
      bmdualQ n (GaloisField 2 f) w := by
  let c : Fin (R + 1) → GaloisField 2 f := fun a => w (eidx (Sum.inl a))
  let d : Fin (R + 1) → GaloisField 2 f := fun a => w (eidx (Sum.inr (Sum.inl a)))
  let e : Fin r' → GaloisField 2 f := fun a => w (eidx (Sum.inr (Sum.inr a)))
  have hw : w = Sum.elim c (Sum.elim d e) ∘ eidx.symm := by
    funext i
    show w i = Sum.elim c (Sum.elim d e) (eidx.symm i)
    cases h : eidx.symm i with
    | inl a =>
      have hi : i = eidx (Sum.inl a) := by rw [← h, Equiv.apply_symm_apply]
      rw [hi]
      rfl
    | inr a =>
      cases a with
      | inl a =>
        have hi : i = eidx (Sum.inr (Sum.inl a)) := by rw [← h, Equiv.apply_symm_apply]
        rw [hi]
        rfl
      | inr a =>
        have hi : i = eidx (Sum.inr (Sum.inr a)) := by rw [← h, Equiv.apply_symm_apply]
        rw [hi]
        rfl
  have hcomp : (Sum.elim c (Sum.elim d e) ∘ eidx.symm) ∘ eidx =
      Sum.elim c (Sum.elim d e) := by
    funext k
    simp
  rw [hw, bmdual_reindex_mulVec, hcomp, bmdual_blockMat_mulVec, hQ,
    bmdual_quadPlus_sl_isometry]
  exact (hQ c d e).symm

private noncomputable def bmdual_J12 (f R r' : ℕ) (lam : GaloisField 2 f) :
    Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f) :=
  Matrix.of (fun a j => match j with
    | Sum.inl b => if a = b then lam else 0
    | Sum.inr _ => 0)

private noncomputable def bmdual_J21 (f R r' : ℕ) (lam : GaloisField 2 f) :
    Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f) :=
  Matrix.of (fun b a => match b with
    | Sum.inl b' => if b' = a then lam else 0
    | Sum.inr _ => 0)

private noncomputable def bmdual_formBlock (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n) :
    Matrix (Fin r') (Fin r') (GaloisField 2 f) :=
  Matrix.of (fun c c' => Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f))
    (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inr c')))

private def bmdual_IsFormStandard (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n) : Prop :=
  ∃ lam : GaloisField 2 f, lam ≠ 0 ∧
    Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f)) =
      Matrix.fromBlocks
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
        (bmdual_J12 f R r' lam)
        (bmdual_J21 f R r' lam)
        (Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (bmdual_formBlock n f R r' eidx))
      ∧ (∃ Qinv : Matrix (Fin r') (Fin r') (GaloisField 2 f),
          bmdual_formBlock n f R r' eidx * Qinv = 1)

private theorem bmdual_glueCast_apply (r s : ℕ) (hr' : r - 1 + 1 = r) :
    (∀ a : Fin (r - 1 + 1), (bmdual_glueCast r s hr') (Sum.inl a) =
      Sum.inl (finCongr hr' a)) ∧
    (∀ a : Fin (r - 1 + 1), (bmdual_glueCast r s hr') (Sum.inr (Sum.inl a)) =
      Sum.inr (Sum.inl (finCongr hr' a))) ∧
    (∀ a : Fin (2 * s), (bmdual_glueCast r s hr') (Sum.inr (Sum.inr a)) =
      Sum.inr (Sum.inr a)) := by
  refine ⟨?_, ?_, ?_⟩ <;> intro a <;> simp [bmdual_glueCast, Equiv.sumCongr]

private theorem bmdual_glueSplit_apply (r s : ℕ) :
    (∀ a : Fin r, bmdual_glueSplit r s (Sum.inl a) = Sum.inl (Sum.inl a)) ∧
    (∀ a : Fin r, bmdual_glueSplit r s (Sum.inr (Sum.inl a)) = Sum.inl (Sum.inr a)) ∧
    (∀ a : Fin (2 * s), bmdual_glueSplit r s (Sum.inr (Sum.inr a)) =
      Sum.inr ((finCongr (two_mul s)).trans finSumFinEquiv.symm a)) := by
  refine ⟨?_, ?_, ?_⟩ <;> intro a <;> simp [bmdual_glueSplit, Equiv.sumAssoc, Equiv.sumCongr]

private theorem bmdual_glue_eidx_inl (n f r s : ℕ) (hrs : r + s = n)
    (hr' : r - 1 + 1 = r) (a : Fin (r - 1 + 1)) :
    ((bmdual_glueCast r s hr').trans
        ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs))) (Sum.inl a) =
      Sum.inl ((finSumFinEquiv.trans (finCongr hrs)) (Sum.inl (finCongr hr' a))) := by
  obtain ⟨h1, -, -⟩ := bmdual_glueCast_apply r s hr'
  obtain ⟨g1, -, -⟩ := bmdual_glueSplit_apply r s
  rw [Equiv.trans_apply, Equiv.trans_apply, h1, g1, bmdual_glueGidx_inl_inl]

private theorem bmdual_glue_eidx_inr_inl (n f r s : ℕ) (hrs : r + s = n)
    (hr' : r - 1 + 1 = r) (a : Fin (r - 1 + 1)) :
    ((bmdual_glueCast r s hr').trans
        ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs))) (Sum.inr (Sum.inl a)) =
      Sum.inr ((finSumFinEquiv.trans (finCongr hrs)) (Sum.inl (finCongr hr' a))) := by
  obtain ⟨-, h2, -⟩ := bmdual_glueCast_apply r s hr'
  obtain ⟨-, g2, -⟩ := bmdual_glueSplit_apply r s
  rw [Equiv.trans_apply, Equiv.trans_apply, h2, g2, bmdual_glueGidx_inl_inr]

private theorem bmdual_glue_eidx_inr_inr (n f r s : ℕ) (hrs : r + s = n)
    (hr' : r - 1 + 1 = r) (a : Fin (2 * s)) :
    ((bmdual_glueCast r s hr').trans
        ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs))) (Sum.inr (Sum.inr a)) =
      Sum.elim (fun j : Fin s => Sum.inl ((finSumFinEquiv.trans (finCongr hrs)) (Sum.inr j)))
        (fun j : Fin s => Sum.inr ((finSumFinEquiv.trans (finCongr hrs)) (Sum.inr j)))
        ((finCongr (two_mul s)).trans finSumFinEquiv.symm a) := by
  obtain ⟨-, -, h3⟩ := bmdual_glueCast_apply r s hr'
  obtain ⟨-, -, g3⟩ := bmdual_glueSplit_apply r s
  rw [Equiv.trans_apply, Equiv.trans_apply, h3, g3]
  generalize hd : (finCongr (two_mul s)).trans finSumFinEquiv.symm a = d
  rcases d with j | j
  · rw [bmdual_glueGidx_inr_inl]; rfl
  · rw [bmdual_glueGidx_inr_inr]; rfl

private theorem bmdual_G_apply_inl_inl (n f : ℕ) (a b : Fin n) :
    bmdualG n (GaloisField 2 f) (Sum.inl a) (Sum.inl b) = 0 := by
  rw [show bmdualG n (GaloisField 2 f) =
      LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (bmdualQ n (GaloisField 2 f)))
    from rfl, LinearMap.toMatrix₂'_apply]
  change QuadraticMap.polar (Spin.quadPlus n (GaloisField 2 f))
    (Pi.single (Sum.inl a) 1) (Pi.single (Sum.inl b) 1) = 0
  rw [Spin.polar_quadPlus_single_inl]
  simp [Pi.single_apply]

private theorem bmdual_G_apply_inl_inr (n f : ℕ) (a b : Fin n) :
    bmdualG n (GaloisField 2 f) (Sum.inl a) (Sum.inr b) =
      if a = b then 1 else 0 := by
  rw [show bmdualG n (GaloisField 2 f) =
      LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (bmdualQ n (GaloisField 2 f)))
    from rfl, LinearMap.toMatrix₂'_apply]
  change QuadraticMap.polar (Spin.quadPlus n (GaloisField 2 f))
    (Pi.single (Sum.inl a) 1) (Pi.single (Sum.inr b) 1) = if a = b then 1 else 0
  rw [Spin.polar_quadPlus_single_inr]
  by_cases h : a = b <;> simp [Pi.single_apply, h, eq_comm]

private theorem bmdual_G_apply_inr_inl (n f : ℕ) (a b : Fin n) :
    bmdualG n (GaloisField 2 f) (Sum.inr a) (Sum.inl b) =
      if a = b then 1 else 0 := by
  rw [show bmdualG n (GaloisField 2 f) =
      LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (bmdualQ n (GaloisField 2 f)))
    from rfl, LinearMap.toMatrix₂'_apply]
  change QuadraticMap.polar (Spin.quadPlus n (GaloisField 2 f))
    (Pi.single (Sum.inr a) 1) (Pi.single (Sum.inl b) 1) = if a = b then 1 else 0
  rw [Spin.polar_quadPlus_single_inl]
  by_cases h : a = b <;> simp [Pi.single_apply, h, eq_comm]

private theorem bmdual_G_apply_inr_inr (n f : ℕ) (a b : Fin n) :
    bmdualG n (GaloisField 2 f) (Sum.inr a) (Sum.inr b) = 0 := by
  rw [show bmdualG n (GaloisField 2 f) =
      LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (bmdualQ n (GaloisField 2 f)))
    from rfl, LinearMap.toMatrix₂'_apply]
  change QuadraticMap.polar (Spin.quadPlus n (GaloisField 2 f))
    (Pi.single (Sum.inr a) 1) (Pi.single (Sum.inr b) 1) = 0
  rw [Spin.polar_quadPlus_single_inr]
  simp [Pi.single_apply]

private theorem bmdual_glue_formBlock_eq (n f r s : ℕ) (hrs : r + s = n)
    (hr' : r - 1 + 1 = r) :
    bmdual_formBlock n f (r - 1) (2 * s)
      ((bmdual_glueCast r s hr').trans
        ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs))) =
      (bmdualG s (GaloisField 2 f)).submatrix
        ((finCongr (two_mul s)).trans finSumFinEquiv.symm)
        ((finCongr (two_mul s)).trans finSumFinEquiv.symm) := by
  ext c c'
  simp only [bmdual_formBlock, Matrix.of_apply, Matrix.reindex_apply, Matrix.submatrix_apply,
    Equiv.symm_symm]
  rw [bmdual_glue_eidx_inr_inr n f r s hrs hr' c, bmdual_glue_eidx_inr_inr n f r s hrs hr' c']
  generalize hd : (finCongr (two_mul s)).trans finSumFinEquiv.symm c = dd
  generalize hd' : (finCongr (two_mul s)).trans finSumFinEquiv.symm c' = dd'
  rcases dd with j | j <;> rcases dd' with j' | j'
  all_goals simp only [Sum.elim_inl, Sum.elim_inr, bmdual_G_apply_inl_inl, bmdual_G_apply_inl_inr,
    bmdual_G_apply_inr_inl, bmdual_G_apply_inr_inr]
  all_goals by_cases h : j = j' <;>
    simp [h, (finSumFinEquiv.trans (finCongr hrs)).injective.eq_iff]

private theorem bmdual_glue_formStandard
    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeQ : ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) =
        Spin.quadPlus r (GaloisField 2 f) c)
    (hBcG : Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f))
    (hBcQ : ∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
        Spin.quadPlus s (GaloisField 2 f) c)
    (horthPB : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0)
    (hPeε : bmdualeps n f e * Pe = Pe) (hBcε : (1 - bmdualeps n f e) * Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmdualeps n f e) x)
    (hBcSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin s ⊕ Fin s → GaloisField 2 f,
        Matrix.mulVec Bc c = Matrix.mulVec (1 - bmdualeps n f e) x)
    (hrs : r + s = n) (hε : bmdualeps n f e ≠ 0)
    (hee : e * e = e) (horth_e : e * bmdualestar n f e = 0)
    (hr' : r - 1 + 1 = r) :
    bmdual_IsFormStandard n f (r - 1) (2 * s)
      ((bmdual_glueCast r s hr').trans
        ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs))) := by
  refine ⟨1, one_ne_zero, ?_, ?_⟩
  · ext i j
    rw [Matrix.reindex_apply, Matrix.submatrix_apply]
    simp only [Equiv.symm_symm]
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c')
    · rw [bmdual_glue_eidx_inl n f r s hrs hr' a, bmdual_glue_eidx_inl n f r s hrs hr' a',
        bmdual_G_apply_inl_inl]
      simp [Matrix.fromBlocks_apply₁₁]
    · rw [bmdual_glue_eidx_inl n f r s hrs hr' a, bmdual_glue_eidx_inr_inl n f r s hrs hr' b',
        bmdual_G_apply_inl_inr]
      simp only [Matrix.fromBlocks_apply₁₂, bmdual_J12, Matrix.of_apply]
      by_cases h : a = b'
      · subst h; simp
      · have hP : ¬ ((finSumFinEquiv.trans (finCongr hrs)) (Sum.inl (finCongr hr' a)) =
            (finSumFinEquiv.trans (finCongr hrs)) (Sum.inl (finCongr hr' b'))) := by
          intro hc
          exact h ((finCongr hr').injective (Sum.inl.inj
            ((finSumFinEquiv.trans (finCongr hrs)).injective hc)))
        simp [h, hP]
    · rw [bmdual_glue_eidx_inl n f r s hrs hr' a,
        bmdual_glue_eidx_inr_inr n f r s hrs hr' c']
      generalize hd : (finCongr (two_mul s)).trans finSumFinEquiv.symm c' = dd
      rcases dd with j | j
      · rw [Sum.elim_inl, bmdual_G_apply_inl_inl]
        simp [Matrix.fromBlocks_apply₁₂, bmdual_J12]
      · rw [Sum.elim_inr, bmdual_G_apply_inl_inr]
        have hP : ¬ ((finSumFinEquiv.trans (finCongr hrs)) (Sum.inl (finCongr hr' a)) =
            (finSumFinEquiv.trans (finCongr hrs)) (Sum.inr j)) := by
          intro hc
          have h1 := (finSumFinEquiv.trans (finCongr hrs)).injective hc
          simp at h1
        rw [if_neg hP]
        simp [Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₁₂, Matrix.fromBlocks_apply₂₁,
            Matrix.fromBlocks_apply₂₂, bmdual_J12, bmdual_J21]
    · rw [bmdual_glue_eidx_inr_inl n f r s hrs hr' b, bmdual_glue_eidx_inl n f r s hrs hr' a',
        bmdual_G_apply_inr_inl]
      simp only [Matrix.fromBlocks_apply₂₁, bmdual_J21, Matrix.of_apply]
      by_cases h : b = a'
      · subst h; simp
      · have hP : ¬ ((finSumFinEquiv.trans (finCongr hrs)) (Sum.inl (finCongr hr' b)) =
            (finSumFinEquiv.trans (finCongr hrs)) (Sum.inl (finCongr hr' a'))) := by
          intro hc
          exact h ((finCongr hr').injective (Sum.inl.inj
            ((finSumFinEquiv.trans (finCongr hrs)).injective hc)))
        simp [h, hP]
    · rw [bmdual_glue_eidx_inr_inl n f r s hrs hr' b, bmdual_glue_eidx_inr_inl n f r s hrs hr' b',
        bmdual_G_apply_inr_inr]
      simp [Matrix.fromBlocks_apply₂₂]
    · rw [bmdual_glue_eidx_inr_inl n f r s hrs hr' b,
        bmdual_glue_eidx_inr_inr n f r s hrs hr' c']
      generalize hd : (finCongr (two_mul s)).trans finSumFinEquiv.symm c' = dd
      rcases dd with j | j
      · rw [Sum.elim_inl, bmdual_G_apply_inr_inl]
        have hP : ¬ ((finSumFinEquiv.trans (finCongr hrs)) (Sum.inl (finCongr hr' b)) =
            (finSumFinEquiv.trans (finCongr hrs)) (Sum.inr j)) := by
          intro hc
          have h1 := (finSumFinEquiv.trans (finCongr hrs)).injective hc
          simp at h1
        rw [if_neg hP]
        simp [Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₁₂, Matrix.fromBlocks_apply₂₁,
            Matrix.fromBlocks_apply₂₂, bmdual_J12, bmdual_J21]
      · rw [Sum.elim_inr, bmdual_G_apply_inr_inr]
        simp [Matrix.fromBlocks_apply₂₂]
    · rw [bmdual_glue_eidx_inr_inr n f r s hrs hr' c, bmdual_glue_eidx_inl n f r s hrs hr' a']
      generalize hd : (finCongr (two_mul s)).trans finSumFinEquiv.symm c = dd
      rcases dd with j | j
      · rw [Sum.elim_inl, bmdual_G_apply_inl_inl]
        simp [Matrix.fromBlocks_apply₂₁, bmdual_J21]
      · rw [Sum.elim_inr, bmdual_G_apply_inr_inl]
        have hP : ¬ ((finSumFinEquiv.trans (finCongr hrs)) (Sum.inr j) =
            (finSumFinEquiv.trans (finCongr hrs)) (Sum.inl (finCongr hr' a'))) := by
          intro hc
          have h1 := (finSumFinEquiv.trans (finCongr hrs)).injective hc
          simp at h1
        rw [if_neg hP]
        simp [Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₁₂, Matrix.fromBlocks_apply₂₁,
            Matrix.fromBlocks_apply₂₂, bmdual_J12, bmdual_J21]
    · rw [bmdual_glue_eidx_inr_inr n f r s hrs hr' c, bmdual_glue_eidx_inr_inl n f r s hrs hr' b']
      generalize hd : (finCongr (two_mul s)).trans finSumFinEquiv.symm c = dd
      rcases dd with j | j
      · rw [Sum.elim_inl, bmdual_G_apply_inl_inr]
        have hP : ¬ ((finSumFinEquiv.trans (finCongr hrs)) (Sum.inr j) =
            (finSumFinEquiv.trans (finCongr hrs)) (Sum.inl (finCongr hr' b'))) := by
          intro hc
          have h1 := (finSumFinEquiv.trans (finCongr hrs)).injective hc
          simp at h1
        rw [if_neg hP]
        simp [Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₁₂, Matrix.fromBlocks_apply₂₁,
            Matrix.fromBlocks_apply₂₂, bmdual_J12, bmdual_J21]
      · rw [Sum.elim_inr, bmdual_G_apply_inr_inr]
        simp [Matrix.fromBlocks_apply₂₂]
    · simp only [bmdual_formBlock, Matrix.of_apply, Matrix.reindex_apply,
        Matrix.submatrix_apply, Equiv.symm_symm, Matrix.fromBlocks_apply₂₂]
  · refine ⟨((bmdualG s (GaloisField 2 f))⁻¹).submatrix
        ((finCongr (two_mul s)).trans finSumFinEquiv.symm)
        ((finCongr (two_mul s)).trans finSumFinEquiv.symm), ?_⟩
    rw [bmdual_glue_formBlock_eq n f r s hrs hr', Matrix.submatrix_mul_equiv,
      Matrix.mul_nonsing_inv _ (bmdual_G_isUnit_det s)]
    exact Matrix.submatrix_one_equiv _

private theorem bmdual_glue_standard_basis
    (n f r s : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (Pe : Matrix (bmdualι n) (Fin r ⊕ Fin r) (GaloisField 2 f))
    (Bc : Matrix (bmdualι n) (Fin s ⊕ Fin s) (GaloisField 2 f))
    (hPeG : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Pe = bmdualG r (GaloisField 2 f))
    (hPeQ : ∀ c : Fin r ⊕ Fin r → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pe c) =
        Spin.quadPlus r (GaloisField 2 f) c)
    (hBcG : Matrix.transpose Bc * bmdualG n (GaloisField 2 f) * Bc = bmdualG s (GaloisField 2 f))
    (hBcQ : ∀ c : Fin s ⊕ Fin s → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Bc c) =
        Spin.quadPlus s (GaloisField 2 f) c)
    (horthPB : Matrix.transpose Pe * bmdualG n (GaloisField 2 f) * Bc = 0)
    (hPeε : bmdualeps n f e * Pe = Pe) (hBcε : (1 - bmdualeps n f e) * Bc = Bc)
    (hPee : e * Pe = Pe * Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPees : bmdualestar n f e * Pe = Pe * Matrix.fromBlocks
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (0 : Matrix (Fin r) (Fin r) (GaloisField 2 f))
      (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)))
    (hPeSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin r ⊕ Fin r → GaloisField 2 f,
        Matrix.mulVec Pe c = Matrix.mulVec (bmdualeps n f e) x)
    (hBcSpan : ∀ x : bmdualι n → GaloisField 2 f,
      ∃ c : Fin s ⊕ Fin s → GaloisField 2 f,
        Matrix.mulVec Bc c = Matrix.mulVec (1 - bmdualeps n f e) x)
    (hrs : r + s = n) (hε : bmdualeps n f e ≠ 0)
    (hee : e * e = e) (horth_e : e * bmdualestar n f e = 0) :
    ∃ (R r' : ℕ) (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
      (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
      (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
      (hP : ∀ v : bmdualι n → GaloisField 2 f,
        bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
      (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
        (w : bmdualι n → GaloisField 2 f),
        bmdualQ n (GaloisField 2 f) (Matrix.mulVec
          (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
          bmdualQ n (GaloisField 2 f) w),
      bmdual_IsFormStandard n f R r' eidx ∧
      0 ≤ R ∧ Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e := by
  have hr : 1 ≤ r := bmdual_glue_r_pos n f r s Pe hPeSpan hε
  have hr' : r - 1 + 1 = r := Nat.sub_add_cancel hr
  obtain ⟨P, Pinv, hPP, hPinvP, hP, hconv⟩ :=
    bmdual_glue_basis_P n f r s Pe Bc hPeG hPeQ hBcG hBcQ horthPB hPeε hBcε hPee hPees hPeSpan
      hBcSpan hrs hε hee horth_e
  refine ⟨r - 1, 2 * s,
    (bmdual_glueCast r s hr').trans
      ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs)),
    P, Pinv, hPP, hPinvP, hP, ?_, ?_, Nat.zero_le (r - 1), ?_⟩
  · intro x w
    exact bmdual_glue_block_isometry n f (r - 1) (2 * s)
      ((bmdual_glueCast r s hr').trans
        ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs)))
      x (fun c d e' => bmdual_glue_block_hQ n f r s hrs hr' c d e') w
  · exact bmdual_glue_formStandard n f r s Pe Bc hPeG hPeQ hBcG hBcQ horthPB hPeε hBcε hPee
      hPees hPeSpan hBcSpan hrs hε hee horth_e hr'
  · rw [bmdual_glueCast_D0 n f r s hr'
      ((bmdual_glueSplit r s).trans (bmdual_glueGidx r s n hrs))]
    exact hconv

private theorem bmdual_explicit_data
    (n f : ℕ) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e)) :
    ∃ (R r' : ℕ) (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
      (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
      (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
      (hP : ∀ v : bmdualι n → GaloisField 2 f,
        bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
      (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
        (w : bmdualι n → GaloisField 2 f),
        bmdualQ n (GaloisField 2 f) (Matrix.mulVec
          (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
          bmdualQ n (GaloisField 2 f) w),
      bmdual_IsFormStandard n f R r' eidx ∧
      0 ≤ R ∧ Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e := by
  obtain ⟨r, s, Pe, Bc, hPeG, hPeQ, hBcG, hBcQ, horthPB, hPeε, hBcε, hPee, hPees, hPeSpan,
    hBcSpan, hrs, he0⟩ :=
    bmdual_adapted_decomposition n f S he hquad hquad' horth horth' heps hestar
  exact bmdual_glue_standard_basis n f r s Pe Bc hPeG hPeQ hBcG hBcQ horthPB hPeε hBcε hPee hPees
    hPeSpan hBcSpan hrs (by
      intro h
      apply he0
      have h' := congrArg (fun M => M * e) h
      rw [Matrix.zero_mul] at h'
      rw [bmdualeps, Matrix.add_mul, he.2.1.eq, horth', add_zero] at h'
      exact h') he.2.1.eq horth

private theorem bmdual_conj_mul (n f : ℕ)
    (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1)
    (v w : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) :
    (Pinv * v * P) * (Pinv * w * P) = Pinv * (v * w) * P := by
  calc (Pinv * v * P) * (Pinv * w * P)
      = Pinv * v * (P * Pinv) * w * P := by noncomm_ring
    _ = Pinv * v * 1 * w * P := by rw [hPP]
    _ = Pinv * (v * w) * P := by noncomm_ring

private theorem bmdual_conj_one (n f : ℕ)
    (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1) :
    Pinv * 1 * P = 1 := by rw [Matrix.mul_one, hPinvP]

private theorem bmdual_blockMat_one (n f r r' : ℕ) :
    bmdual_blockMat n f r r' (1 : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) =
      1 := by
  unfold bmdual_blockMat
  rw [inv_one, Matrix.SpecialLinearGroup.coe_one, Matrix.transpose_one,
    Matrix.fromBlocks_one, Matrix.fromBlocks_one]

private theorem bmdual_blockMat_mul (n f r r' : ℕ)
    (x y : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmdual_blockMat n f r r' (x * y) =
      bmdual_blockMat n f r r' x * bmdual_blockMat n f r r' y := by
  have hinner : (Matrix.fromBlocks
        (Matrix.transpose (((x⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f))))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) *
      (Matrix.fromBlocks
        (Matrix.transpose (((y⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f))))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) =
      Matrix.fromBlocks
        (Matrix.transpose ((((x * y)⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f))))
        (0 : Matrix (Fin r) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) := by
    rw [Matrix.fromBlocks_multiply]
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one]
    rw [show Matrix.transpose (((x * y)⁻¹ :
            Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)) =
        Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)) *
        Matrix.transpose ((y⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
          Matrix (Fin r) (Fin r) (GaloisField 2 f)) from by
      rw [show ((x * y)⁻¹ : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) =
            y⁻¹ * x⁻¹ from mul_inv_rev x y,
        Matrix.SpecialLinearGroup.coe_mul, Matrix.transpose_mul]]
  unfold bmdual_blockMat
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [hinner, Matrix.SpecialLinearGroup.coe_mul]

private theorem bmdual_blockMat_injective (n f r r' : ℕ) :
    Function.Injective (bmdual_blockMat n f r r') := by
  intro x y hxy
  apply Subtype.ext
  ext i j
  have h := congrArg (fun M : Matrix (Fin r ⊕ (Fin r ⊕ Fin r'))
      (Fin r ⊕ (Fin r ⊕ Fin r')) (GaloisField 2 f) => M (Sum.inl i) (Sum.inl j)) hxy
  simpa [bmdual_blockMat, Matrix.fromBlocks] using h

private noncomputable def bmdual_embedGL (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1) :
    Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) →*
      GL (bmdualι n) (GaloisField 2 f) where
  toFun x := Units.mk (Pinv * Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) * P)
    (Pinv * Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x⁻¹) * P)
    (by
      change (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
            (bmdual_blockMat n f (R + 1) r' x) * P) *
          (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
            (bmdual_blockMat n f (R + 1) r' x⁻¹) * P) = 1
      rw [bmdual_conj_mul n f P Pinv hPP, ← map_mul, ← bmdual_blockMat_mul,
        mul_inv_cancel x, bmdual_blockMat_one, map_one,
        bmdual_conj_one n f P Pinv hPinvP])
    (by
      change (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
            (bmdual_blockMat n f (R + 1) r' x⁻¹) * P) *
          (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
            (bmdual_blockMat n f (R + 1) r' x) * P) = 1
      rw [bmdual_conj_mul n f P Pinv hPP, ← map_mul, ← bmdual_blockMat_mul,
        inv_mul_cancel x, bmdual_blockMat_one, map_one,
        bmdual_conj_one n f P Pinv hPinvP])
  map_one' := by
    apply Units.ext
    change Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdual_blockMat n f (R + 1) r' 1) * P = 1
    rw [bmdual_blockMat_one, map_one, bmdual_conj_one n f P Pinv hPinvP]
  map_mul' x y := by
    apply Units.ext
    change Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdual_blockMat n f (R + 1) r' (x * y)) * P =
      (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdual_blockMat n f (R + 1) r' x) * P) *
      (Pinv * (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdual_blockMat n f (R + 1) r' y) * P)
    rw [bmdual_blockMat_mul, map_mul, ← bmdual_conj_mul n f P Pinv hPP]

private theorem bmdual_embedGL_injective (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1) :
    Function.Injective (bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP) := by
  intro x y hxy
  have h := congrArg (fun g : GL (bmdualι n) (GaloisField 2 f) =>
    (g : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))) hxy
  have h2 : Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) =
      Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' y) := by
    have h3 : P * (Pinv * Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) * P) *
        Pinv = P * (Pinv * Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' y) * P) *
        Pinv := congrArg (fun M => P * M * Pinv) h
    have hAx : P * (Pinv * Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) * P) *
        Pinv = Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) := by
      rw [Matrix.mul_assoc, Matrix.mul_assoc, hPP, Matrix.mul_one, ← Matrix.mul_assoc, hPP,
        Matrix.one_mul]
    have hAy : P * (Pinv * Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' y) * P) *
        Pinv = Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' y) := by
      rw [Matrix.mul_assoc, Matrix.mul_assoc, hPP, Matrix.mul_one, ← Matrix.mul_assoc, hPP,
        Matrix.one_mul]
    rwa [hAx, hAy] at h3
  exact bmdual_blockMat_injective n f (R + 1) r'
    ((Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx).injective h2)

private theorem bmdual_embedGL_isometry (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualι n) (GaloisField 2 f)) :
          Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) v) =
        bmdualQ n (GaloisField 2 f) v := by
  intro v
  have hPinv : ∀ w : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec Pinv w) = bmdualQ n (GaloisField 2 f) w := by
    intro w
    have h := hP (Matrix.mulVec Pinv w)
    rw [Matrix.mulVec_mulVec, hPP, Matrix.one_mulVec] at h
    exact h.symm
  change bmdualQ n (GaloisField 2 f) (Matrix.mulVec
      (Pinv * Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) * P) v) =
    bmdualQ n (GaloisField 2 f) v
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
  rw [hPinv, hblock x (Matrix.mulVec P v), hP v]

private theorem bmdual_finrank_prod {m n : Type*} [Fintype m] [Fintype n]
    (F : Type) [Field F] (S : Submodule F (m → F)) (T : Submodule F (n → F)) :
    Module.finrank F (S.prod T) = Module.finrank F S + Module.finrank F T := by
  have iso : S.prod T ≃ₗ[F] (S × T) :=
    { toFun := fun x => (⟨x.1.1, x.2.1⟩, ⟨x.1.2, x.2.2⟩)
      invFun := fun y => ⟨(y.1.1, y.2.1), ⟨y.1.2, y.2.2⟩⟩
      left_inv := by intro x; ext <;> rfl
      right_inv := by intro y; ext <;> rfl
      map_add' := by intro x y; ext <;> rfl
      map_smul' := by intro c x; ext <;> rfl }
  rw [LinearEquiv.finrank_eq iso, Module.finrank_prod]

private theorem bmdual_rank_fromBlocks_zero {m n : Type*} [Fintype m] [Fintype n]
    (F : Type) [Field F] (A : Matrix m m F) (D : Matrix n n F) :
    (Matrix.fromBlocks A (0 : Matrix m n F) (0 : Matrix n m F) D).rank = A.rank + D.rank := by
  set B := Matrix.fromBlocks A (0 : Matrix m n F) (0 : Matrix n m F) D with hB
  have hmap : (LinearMap.range B.mulVecLin).map
        (LinearEquiv.sumArrowLequivProdArrow m n F F).toLinearMap =
      (LinearMap.range A.mulVecLin).prod (LinearMap.range D.mulVecLin) := by
    ext z
    constructor
    · rintro ⟨_, ⟨v, rfl⟩, rfl⟩
      constructor
      · refine ⟨v ∘ Sum.inl, ?_⟩
        rw [Matrix.mulVecLin_apply, Matrix.mulVecLin_apply]
        congr 1
        funext i
        simp [hB, Matrix.fromBlocks, Matrix.mulVec, dotProduct, Fintype.sum_sum_type]
      · refine ⟨v ∘ Sum.inr, ?_⟩
        rw [Matrix.mulVecLin_apply, Matrix.mulVecLin_apply]
        congr 1
        funext j
        simp [hB, Matrix.fromBlocks, Matrix.mulVec, dotProduct, Fintype.sum_sum_type]
    · rintro ⟨hu, hw⟩
      obtain ⟨u', hu'⟩ := hu
      obtain ⟨w', hw'⟩ := hw
      refine ⟨Matrix.mulVec B (Sum.elim u' w'), ⟨⟨Sum.elim u' w', rfl⟩, ?_⟩⟩
      apply Prod.ext
      · funext i
        simpa [LinearEquiv.sumArrowLequivProdArrow_apply_fst, hB, Matrix.fromBlocks,
          Matrix.mulVec, dotProduct, Fintype.sum_sum_type] using congrFun hu' i
      · funext j
        simpa [LinearEquiv.sumArrowLequivProdArrow_apply_snd, hB, Matrix.fromBlocks,
          Matrix.mulVec, dotProduct, Fintype.sum_sum_type] using congrFun hw' j
  rw [Matrix.rank_eq_finrank_span_cols, Matrix.rank_eq_finrank_span_cols,
    Matrix.rank_eq_finrank_span_cols, ← Matrix.range_mulVecLin, ← Matrix.range_mulVecLin,
    ← Matrix.range_mulVecLin]
  rw [← LinearEquiv.finrank_map_eq (LinearEquiv.sumArrowLequivProdArrow m n F F)
    (LinearMap.range B.mulVecLin), hmap]
  exact bmdual_finrank_prod F _ _

private theorem bmdual_finrank_commSpace_toLinEquiv {ι : Type} [Fintype ι] [DecidableEq ι]
    (F : Type) [Field F] (A : GL ι F) :
    Module.finrank F (CFSG.RankThree.OrthogonalInvolutions.commSpace
        (CFSG.ClassicalGroups.Orthogonal.toLinEquiv ι F A)) =
      (((A : Matrix ι ι F) - 1)).rank := by
  unfold CFSG.RankThree.OrthogonalInvolutions.commSpace
  have h1 : ((CFSG.ClassicalGroups.Orthogonal.toLinEquiv ι F A : (ι → F) ≃ₗ[F] (ι → F)) :
      (ι → F) →ₗ[F] (ι → F)) = (A : Matrix ι ι F).mulVecLin := by
    apply LinearMap.ext
    intro v
    exact CFSG.ClassicalGroups.Orthogonal.toLinEquiv_apply A v
  have h2 : (A : Matrix ι ι F).mulVecLin - 1 =
      ((A : Matrix ι ι F) - 1).mulVecLin := by
    apply LinearMap.ext
    intro v
    simp [Matrix.sub_mulVec]
  rw [h1, h2, Matrix.range_mulVecLin, Matrix.rank_eq_finrank_span_cols]

private theorem bmdual_rank_sub_one_conj (n f : ℕ)
    (P Pinv B : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1) :
    (Pinv * B * P - 1).rank = (B - 1).rank := by
  have hPU : IsUnit P.det := by
    rw [← Matrix.isUnit_iff_isUnit_det P]
    exact ⟨Units.mk P Pinv hPP hPinvP, rfl⟩
  have hPinvU : IsUnit Pinv.det := by
    rw [← Matrix.isUnit_iff_isUnit_det Pinv]
    exact ⟨Units.mk Pinv P hPinvP hPP, rfl⟩
  have heq : Pinv * B * P - 1 = Pinv * (B - 1) * P := by
    rw [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_one, hPinvP]
  rw [heq, Matrix.mul_assoc]
  rw [Matrix.rank_mul_eq_right_of_isUnit_det Pinv ((B - 1) * P) hPinvU,
    Matrix.rank_mul_eq_left_of_isUnit_det P (B - 1) hPU]

private theorem bmdual_rank_inv_transpose_sub_one (m f : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
    (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) - 1).rank =
      ((x : Matrix (Fin m) (Fin m) (GaloisField 2 f)) - 1).rank := by
  have htrans : Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) - 1 =
      Matrix.transpose (((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) - 1) := by
    rw [Matrix.transpose_sub, Matrix.transpose_one]
  rw [htrans, Matrix.rank_transpose]
  have hxunit : IsUnit (((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
      Matrix (Fin m) (Fin m) (GaloisField 2 f))).det := by
    rw [Matrix.SpecialLinearGroup.det_coe]
    exact isUnit_one
  have hrel : ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) - 1 =
      ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) *
      ((x : Matrix (Fin m) (Fin m) (GaloisField 2 f)) - 1) := by
    rw [Matrix.mul_sub, Matrix.mul_one]
    have hmul : ((x⁻¹ : Matrix.SpecialLinearGroup (Fin m) (GaloisField 2 f)) :
        Matrix (Fin m) (Fin m) (GaloisField 2 f)) *
        (x : Matrix (Fin m) (Fin m) (GaloisField 2 f)) = 1 := by
      rw [← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel,
        Matrix.SpecialLinearGroup.coe_one]
    rw [hmul]
    ext i j
    simp only [Matrix.sub_apply]
    rw [CharTwo.sub_eq_add, CharTwo.sub_eq_add, add_comm]
  rw [hrel, Matrix.rank_mul_eq_right_of_isUnit_det _ _ hxunit]

private theorem bmdual_blockMat_sub_one (n f R r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    bmdual_blockMat n f (R + 1) r' x - 1 =
      Matrix.fromBlocks ((x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1)
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (Matrix.fromBlocks
          (Matrix.transpose (((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) - 1)
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) := by
  unfold bmdual_blockMat
  ext p q
  rcases p with a | (b | d) <;> rcases q with a' | (b' | d') <;>
    simp [Matrix.fromBlocks, Matrix.sub_apply, Matrix.one_apply, Matrix.zero_apply]

private theorem bmdual_even_rank_reindex_blockMat (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    Even ((Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) - 1).rank) := by
  have hreindex : Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) - 1 =
      Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x - 1) := by
    change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdual_blockMat n f (R + 1) r' x) - 1 =
      (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        (bmdual_blockMat n f (R + 1) r' x - 1)
    rw [map_sub, map_one]
  rw [hreindex, Matrix.rank_reindex, bmdual_blockMat_sub_one,
    bmdual_rank_fromBlocks_zero (GaloisField 2 f),
    bmdual_rank_fromBlocks_zero (GaloisField 2 f), Matrix.rank_zero,
    bmdual_rank_inv_transpose_sub_one]
  exact ⟨((x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) - 1).rank,
    by ring⟩

private theorem bmdual_even_finrank_commSpace_embedGL (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    Even (Module.finrank (GaloisField 2 f)
      (CFSG.RankThree.OrthogonalInvolutions.commSpace
        (CFSG.ClassicalGroups.Orthogonal.toLinEquiv (bmdualι n) (GaloisField 2 f)
          (bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x)))) := by
  rw [bmdual_finrank_commSpace_toLinEquiv]
  have hcoe : ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x :
        GL (bmdualι n) (GaloisField 2 f)) : Matrix (bmdualι n) (bmdualι n)
          (GaloisField 2 f)) =
      Pinv * Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) * P := rfl
  rw [hcoe, bmdual_rank_sub_one_conj n f P Pinv
    (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) hPP hPinvP]
  exact bmdual_even_rank_reindex_blockMat n f R r' eidx x

private theorem bmdual_embedGL_mem_spin (n f R r' : ℕ) (hn : 3 ≤ n)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    ∃ u : ↥(spinGroup (bmdualQ n (GaloisField 2 f))),
      ((bmdualJ n (GaloisField 2 f) u : GL (bmdualι n) (GaloisField 2 f)) :
        Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) =
      ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualι n) (GaloisField 2 f)) :
        Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) := by
  have hM := bmdual_embedGL_isometry n f R r' eidx hPP hPinvP hP hblock x
  have horth : (CFSG.ClassicalGroups.Orthogonal.toLinEquiv (bmdualι n) (GaloisField 2 f)
        (bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x)) ∈
      TauCeti.QuadraticMap.orthogonalGroup (bmdualQ n (GaloisField 2 f)) :=
    TauCeti.QuadraticMap.mem_orthogonalGroup_iff.mpr (fun v => by
      rw [CFSG.ClassicalGroups.Orthogonal.toLinEquiv_apply]
      exact hM v)
  have heven := bmdual_even_finrank_commSpace_embedGL n f R r' eidx hPP hPinvP x
  have hΩ : (CFSG.ClassicalGroups.Orthogonal.toLinEquiv (bmdualι n) (GaloisField 2 f)
        (bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x)) ∈
      CFSG.RankThree.OrthogonalInvolutions.omegaGroup (bmdualQ n (GaloisField 2 f))
        (Spin.nondegenerate_polarBilin_quadPlus n (GaloisField 2 f)) :=
    (CFSG.RankThree.OrthogonalInvolutions.mem_omegaGroup).mpr ⟨horth, heven⟩
  obtain ⟨u, hu⟩ :=
    CFSG.StandardType.GGOppRadOmega.exists_spinAction_eq_of_mem_omegaGroup_plus hn hΩ
  refine ⟨u, ?_⟩
  apply Matrix.mulVec_injective
  funext v
  rw [Spin.spinMatrix_mulVec, ← CFSG.ClassicalGroups.Orthogonal.toLinEquiv_apply]
  exact congrArg (fun (f : (bmdualι n → GaloisField 2 f) ≃ₗ[GaloisField 2 f]
    (bmdualι n → GaloisField 2 f)) => f v) hu

private theorem bmdual_spinMatrix_injective (n : ℕ) (F : Type) [Field F] [CharP F 2] :
    Function.Injective (bmdualJ n F) := by
  rw [← MonoidHom.ker_eq_bot_iff]
  exact Spin.ker_spinMatrix_quadPlus_eq_bot (CharP.cast_eq_zero F 2)

private theorem bmdual_embedGL_choose_eq (n f R r' : ℕ) (hn : 3 ≤ n)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    bmdualJ n (GaloisField 2 f)
        (Classical.choose (bmdual_embedGL_mem_spin n f R r' hn eidx hPP hPinvP hP hblock x)) =
      bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x :=
  Units.ext (Classical.choose_spec
    (bmdual_embedGL_mem_spin n f R r' hn eidx hPP hPinvP hP hblock x))

private noncomputable def bmdual_embedSpin (n f R r' : ℕ) (hn : 3 ≤ n)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w) :
    Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) →*
      ↥(spinGroup (bmdualQ n (GaloisField 2 f))) where
  toFun x := Classical.choose (bmdual_embedGL_mem_spin n f R r' hn eidx hPP hPinvP hP hblock x)
  map_one' := by
    apply bmdual_spinMatrix_injective n (GaloisField 2 f)
    rw [bmdual_embedGL_choose_eq n f R r' hn eidx hPP hPinvP hP hblock,
      map_one (bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP),
      map_one (bmdualJ n (GaloisField 2 f))]
  map_mul' x y := by
    apply bmdual_spinMatrix_injective n (GaloisField 2 f)
    rw [bmdual_embedGL_choose_eq n f R r' hn eidx hPP hPinvP hP hblock,
      map_mul (bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP),
      map_mul (bmdualJ n (GaloisField 2 f)),
      bmdual_embedGL_choose_eq n f R r' hn eidx hPP hPinvP hP hblock,
      bmdual_embedGL_choose_eq n f R r' hn eidx hPP hPinvP hP hblock]

private theorem bmdual_embedSpin_spinMatrix (n f R r' : ℕ) (hn : 3 ≤ n)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    ((bmdualJ n (GaloisField 2 f)
        (bmdual_embedSpin n f R r' hn eidx P Pinv hPP hPinvP hP hblock x) :
        GL (bmdualι n) (GaloisField 2 f)) :
      Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) =
    ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualι n) (GaloisField 2 f)) :
      Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) := by
  simpa [bmdual_embedSpin] using
    Classical.choose_spec (bmdual_embedGL_mem_spin n f R r' hn eidx hPP hPinvP hP hblock x)

private theorem bmdual_embedSpin_injective (n f R r' : ℕ) (hn : 3 ≤ n)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w) :
    Function.Injective (bmdual_embedSpin n f R r' hn eidx P Pinv hPP hPinvP hP hblock) := by
  intro x y hxy
  have hJ : bmdualJ n (GaloisField 2 f)
        (bmdual_embedSpin n f R r' hn eidx P Pinv hPP hPinvP hP hblock x) =
      bmdualJ n (GaloisField 2 f)
        (bmdual_embedSpin n f R r' hn eidx P Pinv hPP hPinvP hP hblock y) :=
    congrArg (bmdualJ n (GaloisField 2 f)) hxy
  have hmat : ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x :
        GL (bmdualι n) (GaloisField 2 f)) : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) =
      ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP y :
        GL (bmdualι n) (GaloisField 2 f)) : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) := by
    rw [← bmdual_embedSpin_spinMatrix n f R r' hn eidx hPP hPinvP hP hblock x,
      ← bmdual_embedSpin_spinMatrix n f R r' hn eidx hPP hPinvP hP hblock y]
    exact congrArg (fun g : GL (bmdualι n) (GaloisField 2 f) =>
      (g : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))) hJ
  exact bmdual_embedGL_injective n f R r' eidx hPP hPinvP (Units.ext hmat)

private noncomputable def bmdual_embedHom (n f R r' : ℕ) (hn : 3 ≤ n)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w) :
    Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) →*
      ↥(spinGroup (bmdualQ n (GaloisField 2 f))) :=
  bmdual_embedSpin n f R r' hn eidx P Pinv hPP hPinvP hP hblock

private theorem bmdual_reindex_mul (f : ℕ) {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ] (e : ι ≃ κ) (A B : Matrix ι ι (GaloisField 2 f)) :
    Matrix.reindex e e (A * B) = Matrix.reindex e e A * Matrix.reindex e e B := by
  change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) (A * B) =
    (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) A *
      (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) B
  rw [map_mul]

private theorem bmdual_reindex_one (f : ℕ) {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ] (e : ι ≃ κ) :
    Matrix.reindex e e (1 : Matrix ι ι (GaloisField 2 f)) = 1 := by
  change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e)
    (1 : Matrix ι ι (GaloisField 2 f)) = 1
  rw [map_one]

private theorem bmdual_reindex_comp_symm (f : ℕ) {ι κ : Type*} (e : ι ≃ κ)
    (A : Matrix ι ι (GaloisField 2 f)) :
    Matrix.reindex e.symm e.symm (Matrix.reindex e e A) = A := by
  ext i j
  simp [Matrix.reindex_apply]

private noncomputable def bmdual_glBlock (f R r' : ℕ)
    (a : GL (Fin (R + 1)) (GaloisField 2 f)) :
    Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (GaloisField 2 f) :=
  Matrix.fromBlocks (a : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
    (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
    (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
    (Matrix.fromBlocks (Matrix.transpose ((a⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
      Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)))

private theorem bmdual_blockMat_eq_glBlock (n f R r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    bmdual_blockMat n f (R + 1) r' x =
      bmdual_glBlock f R r' (x : GL (Fin (R + 1)) (GaloisField 2 f)) := rfl

private theorem bmdual_glBlock_one (f R r' : ℕ) :
    bmdual_glBlock f R r' (1 : GL (Fin (R + 1)) (GaloisField 2 f)) = 1 := by
  unfold bmdual_glBlock
  simp only [inv_one, Units.val_one, Matrix.transpose_one, Matrix.fromBlocks_one]

private theorem bmdual_glBlock_mul (f R r' : ℕ)
    (a b : GL (Fin (R + 1)) (GaloisField 2 f)) :
    bmdual_glBlock f R r' (a * b) = bmdual_glBlock f R r' a * bmdual_glBlock f R r' b := by
  have hinner : (Matrix.fromBlocks
        (Matrix.transpose (((a⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) *
      (Matrix.fromBlocks
        (Matrix.transpose (((b⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) =
      Matrix.fromBlocks
        (Matrix.transpose ((((a * b)⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) := by
    rw [Matrix.fromBlocks_multiply]
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one]
    rw [show Matrix.transpose (((a * b)⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) =
        Matrix.transpose (((a⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) *
        Matrix.transpose (((b⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) from by
      rw [show ((a * b)⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) = b⁻¹ * a⁻¹ from
        mul_inv_rev a b, Units.val_mul, Matrix.transpose_mul]]
  unfold bmdual_glBlock
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [hinner, Units.val_mul]

private theorem bmdual_glBlock_inv (f R r' : ℕ) (a : GL (Fin (R + 1)) (GaloisField 2 f)) :
    bmdual_glBlock f R r' a⁻¹ = (bmdual_glBlock f R r' a)⁻¹ := by
  have h : bmdual_glBlock f R r' a * bmdual_glBlock f R r' a⁻¹ = 1 := by
    rw [← bmdual_glBlock_mul, mul_inv_cancel, bmdual_glBlock_one]
  exact (Matrix.inv_eq_right_inv h).symm

private noncomputable def bmdual_gm (n f : ℕ) (g : ↥(spinGroup (bmdualQ n (GaloisField 2 f)))) :
    Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f) :=
  ((bmdualJ n (GaloisField 2 f) g : GL (bmdualι n) (GaloisField 2 f)) :
    Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))

private theorem bmdual_gm_mul (n f : ℕ)
    (g h : ↥(spinGroup (bmdualQ n (GaloisField 2 f)))) :
    bmdual_gm n f (g * h) = bmdual_gm n f g * bmdual_gm n f h := by
  unfold bmdual_gm
  rw [map_mul (bmdualJ n (GaloisField 2 f)), Units.val_mul]

private noncomputable def bmdual_matOf (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
    (g : ↥(spinGroup (bmdualQ n (GaloisField 2 f)))) :
    Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (GaloisField 2 f) :=
  Matrix.reindex eidx.symm eidx.symm (P * bmdual_gm n f g * Pinv)

private theorem bmdual_matOf_mul (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1)
    (g h : ↥(spinGroup (bmdualQ n (GaloisField 2 f)))) :
    bmdual_matOf n f R r' eidx P Pinv (g * h) =
      bmdual_matOf n f R r' eidx P Pinv g * bmdual_matOf n f R r' eidx P Pinv h := by
  unfold bmdual_matOf
  rw [← bmdual_reindex_mul, bmdual_gm_mul]
  congr 1
  calc P * (bmdual_gm n f g * bmdual_gm n f h) * Pinv
      = (P * bmdual_gm n f g * Pinv) * (P * bmdual_gm n f h * Pinv) := by
        rw [show (P * bmdual_gm n f g * Pinv) * (P * bmdual_gm n f h * Pinv) =
            P * bmdual_gm n f g * (Pinv * P) * bmdual_gm n f h * Pinv from by noncomm_ring,
          hPinvP, Matrix.mul_one]
        noncomm_ring

private theorem bmdual_matOf_one (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) :
    bmdual_matOf n f R r' eidx P Pinv (1 : ↥(spinGroup (bmdualQ n (GaloisField 2 f)))) = 1 := by
  unfold bmdual_matOf
  rw [show bmdual_gm n f (1 : ↥(spinGroup (bmdualQ n (GaloisField 2 f)))) = 1 from by
    unfold bmdual_gm
    rw [map_one (bmdualJ n (GaloisField 2 f)), Units.val_one]]
  rw [Matrix.mul_one, hPP, bmdual_reindex_one]

private theorem bmdual_matOf_inv (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (g : ↥(spinGroup (bmdualQ n (GaloisField 2 f)))) :
    bmdual_matOf n f R r' eidx P Pinv g⁻¹ =
      (bmdual_matOf n f R r' eidx P Pinv g)⁻¹ := by
  have h : bmdual_matOf n f R r' eidx P Pinv g *
      bmdual_matOf n f R r' eidx P Pinv g⁻¹ = 1 := by
    rw [← bmdual_matOf_mul n f R r' eidx P Pinv hPinvP, mul_inv_cancel,
      bmdual_matOf_one n f R r' eidx P Pinv hPP]
  exact (Matrix.inv_eq_right_inv h).symm

private noncomputable abbrev bmdual_D0s (r r' : ℕ) (F : Type) [Zero F] [One F] :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F :=
  Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
    (0 : Matrix (Fin r) (Fin r ⊕ Fin r') F)
    (0 : Matrix (Fin r ⊕ Fin r') (Fin r) F)
    (Matrix.fromBlocks (1 : Matrix (Fin r) (Fin r) F)
      (0 : Matrix (Fin r) (Fin r') F) (0 : Matrix (Fin r') (Fin r) F)
      (0 : Matrix (Fin r') (Fin r') F))

private noncomputable abbrev bmdual_D1 (r r' : ℕ) (F : Type) [Zero F] [One F] :
    Matrix (Fin r ⊕ (Fin r ⊕ Fin r')) (Fin r ⊕ (Fin r ⊕ Fin r')) F :=
  Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
    (0 : Matrix (Fin r) (Fin r ⊕ Fin r') F)
    (0 : Matrix (Fin r ⊕ Fin r') (Fin r) F)
    (Matrix.fromBlocks (0 : Matrix (Fin r) (Fin r) F)
      (0 : Matrix (Fin r) (Fin r') F) (0 : Matrix (Fin r') (Fin r) F)
      (1 : Matrix (Fin r') (Fin r') F))

private theorem bmdual_eq_scalar_of_commute_sl (r f : ℕ)
    {M : Matrix (Fin r) (Fin r) (GaloisField 2 f)}
    (h : ∀ g : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f),
      (g : Matrix (Fin r) (Fin r) (GaloisField 2 f)) * M =
        M * (g : Matrix (Fin r) (Fin r) (GaloisField 2 f))) :
    ∃ l : GaloisField 2 f, M = l • (1 : Matrix (Fin r) (Fin r) (GaloisField 2 f)) := by
  have hs : M ∈ Set.range (Matrix.scalar (Fin r) :
      GaloisField 2 f → Matrix (Fin r) (Fin r) (GaloisField 2 f)) := by
    refine Matrix.mem_range_scalar_of_commute_single (fun i j hij => ?_)
    have h1 := h (Matrix.SpecialLinearGroup.transvection hij 1)
    rw [CFSG.LinearGroups.coe_transvection hij 1, add_mul, mul_add, one_mul, mul_one] at h1
    exact (add_right_injective _ h1 : _)
  obtain ⟨l, hl⟩ := hs
  refine ⟨l, ?_⟩
  rw [← hl]
  ext i j
  by_cases hij : i = j <;> simp [Matrix.scalar_apply, Matrix.diagonal_apply, hij]

private theorem bmdual_transpose_fromBlocks' {m n m' n' : Type*} {F : Type}
    (A : Matrix m m' F) (B : Matrix m n' F) (C : Matrix n m' F) (D : Matrix n n' F) :
    Matrix.transpose (Matrix.fromBlocks A B C D) =
      Matrix.fromBlocks (Matrix.transpose A) (Matrix.transpose C)
        (Matrix.transpose B) (Matrix.transpose D) := by
  ext i j
  rcases i with i | i <;> rcases j with j | j <;>
    simp [Matrix.fromBlocks, Matrix.transpose_apply]

private theorem bmdual_reindex_transpose' (f : ℕ) {ι κ : Type*} (e : ι ≃ κ)
    (A : Matrix ι ι (GaloisField 2 f)) :
    Matrix.transpose (Matrix.reindex e e A) = Matrix.reindex e e (Matrix.transpose A) := by
  ext i j
  simp [Matrix.reindex_apply, Matrix.transpose_apply]

private theorem bmdual_eq_zero_of_transpose_mul_eq_rect
    {r r' : ℕ} (f : ℕ) (hr : 2 ≤ r)
    {B : Matrix (Fin r) (Fin r') (GaloisField 2 f)}
    (h : ∀ g : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f),
      Matrix.transpose (g : Matrix (Fin r) (Fin r) (GaloisField 2 f)) * B = B) :
    B = 0 := by
  ext i l
  haveI : 1 < Fintype.card (Fin r) := by rw [Fintype.card_fin]; omega
  obtain ⟨j, hji⟩ : ∃ j : Fin r, j ≠ i := Fintype.exists_ne_of_one_lt_card this i
  have hij : i ≠ j := hji.symm
  let E : Matrix (Fin r) (Fin r) (GaloisField 2 f) := Matrix.single j i 1
  have h1 := congrFun (congrFun (h (Matrix.SpecialLinearGroup.transvection hij 1)) j) l
  rw [CFSG.LinearGroups.coe_transvection hij 1, Matrix.transpose_add, Matrix.transpose_one,
    Matrix.transpose_single] at h1
  have h1' : B j l + (E * B) j l = B j l := by
    rw [Matrix.add_mul, Matrix.one_mul, Matrix.add_apply] at h1
    simpa only [E] using h1
  have hsingle : (E * B) j l = B i l := by
    simp [E, Matrix.mul_apply, Matrix.single_apply]
  rw [hsingle] at h1'
  exact add_left_cancel (show B j l + B i l = B j l + 0 by simpa using h1')

private theorem bmdual_blockMat_gram_conj
    (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    Matrix.transpose (bmdual_blockMat n f (R + 1) r' x) *
      Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f)) *
      bmdual_blockMat n f (R + 1) r' x =
      Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f)) := by
  have hM := bmdual_isometry_of_quad (bmdualQ n (GaloisField 2 f))
    (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) (hblock x)
  have hM1 : Matrix.reindex eidx eidx (Matrix.transpose (bmdual_blockMat n f (R + 1) r' x)) *
      bmdualG n (GaloisField 2 f) *
      Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) =
      bmdualG n (GaloisField 2 f) := by
    simpa only [bmdual_reindex_transpose'] using hM
  have hM2 := congrArg (Matrix.reindex eidx.symm eidx.symm) hM1
  simp only [bmdual_reindex_mul, bmdual_reindex_comp_symm] at hM2
  exact hM2

private theorem bmdual_block12_mul_eq
    (f R r' : ℕ) (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (B : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
    (h : Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) * B *
      Matrix.fromBlocks
        (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) = B) :
    Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
        Matrix.of (fun a b => B a (Sum.inl b)) *
        Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) =
      Matrix.of (fun a b => B a (Sum.inl b)) ∧
    Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
        Matrix.of (fun a c => B a (Sum.inr c)) =
      Matrix.of (fun a c => B a (Sum.inr c)) := by
  constructor
  · ext a b
    have hh := congrFun (congrFun h a) (Sum.inl b)
    have hkey : (Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
        B * Matrix.fromBlocks
          (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
            (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) a (Sum.inl b) =
        (Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
          Matrix.of (fun a b => B a (Sum.inl b)) *
          Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
            (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) a b := by
      simp only [Matrix.mul_apply, Fintype.sum_sum_type, Matrix.fromBlocks_apply₁₁,
        Matrix.fromBlocks_apply₂₁, Matrix.of_apply, Matrix.zero_apply, mul_zero,
        Finset.sum_const_zero, zero_add, add_zero]
    rw [← hkey]
    simpa only [Matrix.of_apply] using hh
  · ext a c
    have hh := congrFun (congrFun h a) (Sum.inr c)
    have hkey : (Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
        B * Matrix.fromBlocks
          (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
            (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) a (Sum.inr c) =
        (Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
          Matrix.of (fun a c => B a (Sum.inr c))) a c := by
      rw [Matrix.mul_apply]
      rw [Fintype.sum_eq_single (Sum.inr c) (fun k hk => by
        rcases k with i | c'
        · simp only [Matrix.fromBlocks_apply₁₂, Matrix.of_apply, Matrix.zero_apply, mul_zero]
        · have hne : c' ≠ c := fun hh' => hk (by rw [hh'])
          simp only [Matrix.fromBlocks_apply₂₂, Matrix.one_apply, hne, if_false, mul_zero])]
      simp only [Matrix.fromBlocks_apply₂₂, Matrix.one_apply, if_true, mul_one,
        Matrix.of_apply, Matrix.mul_apply]
    rw [← hkey]
    simpa only [Matrix.of_apply] using hh

private theorem bmdual_formStandard_pair
    (n f : ℕ) {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0) (hR : 1 ≤ R) :
    ∃ lam : GaloisField 2 f, lam ≠ 0 ∧
      Matrix.toBlocks₁₂ (Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f))) =
        bmdual_J12 f R r' lam := by
  have hR2 : 2 ≤ R + 1 := by omega
  let G' : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
    Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f))
  have hconj : ∀ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      Matrix.transpose (bmdual_blockMat n f (R + 1) r' x) * G' *
          bmdual_blockMat n f (R + 1) r' x = G' := by
    intro x
    simpa only [G'] using bmdual_blockMat_gram_conj n f R r' eidx hblock x
  have h12 : ∀ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      Matrix.transpose (x : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
          Matrix.toBlocks₁₂ G' *
          Matrix.fromBlocks
            (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
              (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) =
        Matrix.toBlocks₁₂ G' := by
    intro x
    have h := hconj x
    rw [← Matrix.fromBlocks_toBlocks G'] at h
    unfold bmdual_blockMat at h
    rw [bmdual_transpose_fromBlocks'] at h
    rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at h
    simp only [Matrix.transpose_zero, Matrix.mul_zero, Matrix.zero_mul, add_zero,
      zero_add] at h
    rw [Matrix.fromBlocks_inj] at h
    exact h.2.1
  have hentries := fun x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) =>
    bmdual_block12_mul_eq f R r' x (Matrix.toBlocks₁₂ G') (h12 x)
  have hcomm1 : ∀ g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      Matrix.transpose (g : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
          Matrix.of (fun a b => Matrix.toBlocks₁₂ G' a (Sum.inl b)) =
        Matrix.of (fun a b => Matrix.toBlocks₁₂ G' a (Sum.inl b)) *
          Matrix.transpose (g : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) := by
    intro g
    have hx := (hentries g).1
    have hxinv : Matrix.transpose (((g⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
          (GaloisField 2 f))) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
        Matrix.transpose ((g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 := by
      rw [← Matrix.transpose_mul]
      have h1 : ((g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
          (((g⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = 1 := by
        rw [Matrix.SpecialLinearGroup.coe_inv, Matrix.mul_adjugate, g.2]
        simp
      rw [h1, Matrix.transpose_one]
    have h := congrArg (fun N : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f) =>
      N * Matrix.transpose ((g : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
        Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))) hx
    rw [Matrix.mul_assoc, hxinv, Matrix.mul_one] at h
    exact h
  obtain ⟨lam, hB1eq⟩ := bmdual_eq_scalar_of_commute_sl (R + 1) f (M :=
    Matrix.of (fun a b => Matrix.toBlocks₁₂ G' a (Sum.inl b))) (fun g => by
      have hx := hcomm1 ⟨Matrix.transpose ((g : Matrix.SpecialLinearGroup (Fin (R + 1))
        (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)),
        by rw [Matrix.det_transpose]; exact g.2⟩
      simpa only [Matrix.transpose_transpose] using hx)
  have hB2eq : Matrix.of (fun a c => Matrix.toBlocks₁₂ G' a (Sum.inr c)) = 0 :=
    bmdual_eq_zero_of_transpose_mul_eq_rect f hR2
      (B := Matrix.of (fun a (c : Fin r') => Matrix.toBlocks₁₂ G' a (Sum.inr c)))
      (fun g => (hentries g).2)
  have hshape : Matrix.toBlocks₁₂ G' = bmdual_J12 f R r' lam := by
    ext a j
    rcases j with b | c
    · have hh := congrFun (congrFun hB1eq a) b
      simp only [Matrix.of_apply, Matrix.smul_apply, Matrix.one_apply] at hh
      rw [hh]
      simp only [bmdual_J12, Matrix.of_apply]
      by_cases hab : a = b <;> simp [hab]
    · have hh := congrFun (congrFun hB2eq a) c
      simp only [Matrix.of_apply] at hh
      rw [hh]
      simp [bmdual_J12]
  refine ⟨lam, ?_, hshape⟩
  intro hlam0
  have hGsymm : Matrix.transpose G' = G' := by
    simp only [G']
    rw [bmdual_reindex_transpose', bmdual_G_symmetric n (GaloisField 2 f)]
  have hGinv : IsUnit G'.det := by
    simp only [G']
    rw [Matrix.det_reindex_self]
    exact bmdual_G_isUnit_det n
  have hsymm : ∀ i j, G' i j = G' j i := by
    intro i j
    have h := congrFun (congrFun hGsymm i) j
    rw [Matrix.transpose_apply] at h
    exact h.symm
  have hePinv : e * Pinv =
      Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) := by
    rw [← hconv, Matrix.mul_assoc, hPP, Matrix.mul_one]
  have hR0 : ∀ a : Fin (R + 1),
      Matrix.mulVec (Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)))
        (Pi.single (eidx (Sum.inl a)) (1 : GaloisField 2 f)) =
      Pi.single (eidx (Sum.inl a)) 1 := by
    intro a
    ext i
    simp only [Matrix.mulVec, dotProduct]
    rw [Fintype.sum_eq_single (eidx (Sum.inl a))]
    · rw [Pi.single_eq_same, mul_one, Pi.single_apply, Matrix.reindex_apply]
      rcases h : eidx.symm i with a' | (b' | c')
      · have hi : i = eidx (Sum.inl a') := by rw [← h, Equiv.apply_symm_apply]
        subst i
        simp only [Matrix.submatrix_apply, bmdual_D0, Matrix.fromBlocks_apply₁₁,
          Matrix.one_apply, Equiv.apply_symm_apply, Equiv.symm_apply_apply]
        by_cases ha : a' = a <;> simp [ha]
      · have hi : i = eidx (Sum.inr (Sum.inl b')) := by rw [← h, Equiv.apply_symm_apply]
        subst i
        have hne : eidx (Sum.inr (Sum.inl b')) ≠ eidx (Sum.inl a) := by
          intro he
          exact absurd (eidx.injective he) (by simp)
        simp [Matrix.submatrix_apply, bmdual_D0, Matrix.fromBlocks_apply₂₁, Matrix.zero_apply,
          Pi.single_eq_of_ne hne]
      · have hi : i = eidx (Sum.inr (Sum.inr c')) := by rw [← h, Equiv.apply_symm_apply]
        subst i
        have hne : eidx (Sum.inr (Sum.inr c')) ≠ eidx (Sum.inl a) := by
          intro he
          exact absurd (eidx.injective he) (by simp)
        simp [Matrix.submatrix_apply, bmdual_D0, Matrix.fromBlocks_apply₂₁, Matrix.zero_apply,
          Pi.single_eq_of_ne hne]
    · intro j hj
      rw [Pi.single_eq_of_ne hj, mul_zero]
  have hQofR0 : ∀ w : bmdualι n → GaloisField 2 f,
      Matrix.mulVec (Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f))) w = w →
      bmdualQ n (GaloisField 2 f) w = 0 := by
    intro w hw
    have hev : Matrix.mulVec e (Matrix.mulVec Pinv w) = Matrix.mulVec Pinv w := by
      rw [Matrix.mulVec_mulVec, hePinv, ← Matrix.mulVec_mulVec, hw]
    have h0 := hquad (Matrix.mulVec Pinv w)
    rw [hev] at h0
    have hPv := hP (Matrix.mulVec Pinv w)
    rw [Matrix.mulVec_mulVec, hPP, Matrix.one_mulVec] at hPv
    rw [hPv, h0]
  have hA : ∀ a b : Fin (R + 1), G' (Sum.inl a) (Sum.inl b) = 0 := by
    intro a b
    have hva : G' (Sum.inl a) (Sum.inl b) =
        bmdualG n (GaloisField 2 f) (eidx (Sum.inl a)) (eidx (Sum.inl b)) := by
      simp only [G', Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm]
    rw [hva]
    rw [show bmdualG n (GaloisField 2 f) (eidx (Sum.inl a)) (eidx (Sum.inl b)) =
        QuadraticMap.polar (bmdualQ n (GaloisField 2 f))
          (Pi.single (eidx (Sum.inl a)) 1) (Pi.single (eidx (Sum.inl b)) 1) from by
      rw [show bmdualG n (GaloisField 2 f) =
          LinearMap.toMatrix₂' (GaloisField 2 f)
            (QuadraticMap.polarBilin (bmdualQ n (GaloisField 2 f))) from rfl,
        LinearMap.toMatrix₂'_apply, QuadraticMap.polarBilin_apply_apply]]
    have hQa := hQofR0 (Pi.single (eidx (Sum.inl a)) 1) (hR0 a)
    have hQb := hQofR0 (Pi.single (eidx (Sum.inl b)) 1) (hR0 b)
    have hQab := hQofR0 (Pi.single (eidx (Sum.inl a)) 1 + Pi.single (eidx (Sum.inl b)) 1)
      (by rw [Matrix.mulVec_add, hR0 a, hR0 b])
    have hpad := QuadraticMap.map_add (bmdualQ n (GaloisField 2 f))
      (Pi.single (eidx (Sum.inl a)) 1) (Pi.single (eidx (Sum.inl b)) 1)
    rw [hQab, hQa, hQb, zero_add, zero_add] at hpad
    exact hpad.symm
  have hv0 : (Pi.single (Sum.inl (0 : Fin (R + 1))) (1 : GaloisField 2 f) :
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) → GaloisField 2 f) ≠ 0 := by
    intro h
    have := congrFun h (Sum.inl (0 : Fin (R + 1)))
    simp at this
  have hcol : Matrix.mulVec G'
      (Pi.single (Sum.inl (0 : Fin (R + 1))) (1 : GaloisField 2 f) :
        (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) → GaloisField 2 f) = 0 := by
    funext i
    simp only [Matrix.mulVec, dotProduct]
    rw [Fintype.sum_eq_single (Sum.inl (0 : Fin (R + 1)))]
    · rw [Pi.single_eq_same, mul_one]
      rcases i with a | (b | c)
      · exact hA a 0
      · rw [hsymm]
        rw [show G' (Sum.inl (0 : Fin (R + 1))) (Sum.inr (Sum.inl b)) =
            Matrix.toBlocks₁₂ G' 0 (Sum.inl b) from rfl, hshape]
        simp [bmdual_J12, hlam0]
      · rw [hsymm]
        rw [show G' (Sum.inl (0 : Fin (R + 1))) (Sum.inr (Sum.inr c)) =
            Matrix.toBlocks₁₂ G' 0 (Sum.inr c) from rfl, hshape]
        simp [bmdual_J12]
    · intro j hj
      rw [Pi.single_eq_of_ne hj, mul_zero]
  exact hv0 (Matrix.eq_zero_of_mulVec_eq_zero hGinv.ne_zero hcol)

private theorem bmdual_block11_eq_zero
    (n f : ℕ) {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0) :
    Matrix.toBlocks₁₁ (Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f))) = 0 := by
  have hePinv : e * Pinv =
      Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) := by
    rw [← hconv, Matrix.mul_assoc, hPP, Matrix.mul_one]
  have hR0 : ∀ a : Fin (R + 1),
      Matrix.mulVec (Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)))
        (Pi.single (eidx (Sum.inl a)) (1 : GaloisField 2 f)) =
      Pi.single (eidx (Sum.inl a)) 1 := by
    intro a
    ext i
    simp only [Matrix.mulVec, dotProduct]
    rw [Fintype.sum_eq_single (eidx (Sum.inl a))]
    · rw [Pi.single_eq_same, mul_one, Pi.single_apply, Matrix.reindex_apply]
      rcases h : eidx.symm i with a' | (b' | c')
      · have hi : i = eidx (Sum.inl a') := by rw [← h, Equiv.apply_symm_apply]
        subst i
        simp only [Matrix.submatrix_apply, bmdual_D0, Matrix.fromBlocks_apply₁₁,
          Matrix.one_apply, Equiv.apply_symm_apply, Equiv.symm_apply_apply]
        by_cases ha : a' = a <;> simp [ha]
      · have hi : i = eidx (Sum.inr (Sum.inl b')) := by rw [← h, Equiv.apply_symm_apply]
        subst i
        have hne : eidx (Sum.inr (Sum.inl b')) ≠ eidx (Sum.inl a) := by
          intro he
          exact absurd (eidx.injective he) (by simp)
        simp [Matrix.submatrix_apply, bmdual_D0, Matrix.fromBlocks_apply₂₁, Matrix.zero_apply,
          Pi.single_eq_of_ne hne]
      · have hi : i = eidx (Sum.inr (Sum.inr c')) := by rw [← h, Equiv.apply_symm_apply]
        subst i
        have hne : eidx (Sum.inr (Sum.inr c')) ≠ eidx (Sum.inl a) := by
          intro he
          exact absurd (eidx.injective he) (by simp)
        simp [Matrix.submatrix_apply, bmdual_D0, Matrix.fromBlocks_apply₂₁, Matrix.zero_apply,
          Pi.single_eq_of_ne hne]
    · intro j hj
      rw [Pi.single_eq_of_ne hj, mul_zero]
  have hQofR0 : ∀ w : bmdualι n → GaloisField 2 f,
      Matrix.mulVec (Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f))) w = w →
      bmdualQ n (GaloisField 2 f) w = 0 := by
    intro w hw
    have hev : Matrix.mulVec e (Matrix.mulVec Pinv w) = Matrix.mulVec Pinv w := by
      rw [Matrix.mulVec_mulVec, hePinv, ← Matrix.mulVec_mulVec, hw]
    have h0 := hquad (Matrix.mulVec Pinv w)
    rw [hev] at h0
    have hPv := hP (Matrix.mulVec Pinv w)
    rw [Matrix.mulVec_mulVec, hPP, Matrix.one_mulVec] at hPv
    rw [hPv, h0]
  ext a b
  change Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f)) (Sum.inl a)
      (Sum.inl b) = 0
  have hva : Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f)) (Sum.inl a)
      (Sum.inl b) = bmdualG n (GaloisField 2 f) (eidx (Sum.inl a)) (eidx (Sum.inl b)) := by
    simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm]
  rw [hva]
  rw [show bmdualG n (GaloisField 2 f) (eidx (Sum.inl a)) (eidx (Sum.inl b)) =
      QuadraticMap.polar (bmdualQ n (GaloisField 2 f))
        (Pi.single (eidx (Sum.inl a)) 1) (Pi.single (eidx (Sum.inl b)) 1) from by
    rw [show bmdualG n (GaloisField 2 f) =
        LinearMap.toMatrix₂' (GaloisField 2 f)
          (QuadraticMap.polarBilin (bmdualQ n (GaloisField 2 f))) from rfl,
      LinearMap.toMatrix₂'_apply, QuadraticMap.polarBilin_apply_apply]]
  have hQa := hQofR0 (Pi.single (eidx (Sum.inl a)) 1) (hR0 a)
  have hQb := hQofR0 (Pi.single (eidx (Sum.inl b)) 1) (hR0 b)
  have hQab := hQofR0 (Pi.single (eidx (Sum.inl a)) 1 + Pi.single (eidx (Sum.inl b)) 1)
    (by rw [Matrix.mulVec_add, hR0 a, hR0 b])
  have hpad := QuadraticMap.map_add (bmdualQ n (GaloisField 2 f))
    (Pi.single (eidx (Sum.inl a)) 1) (Pi.single (eidx (Sum.inl b)) 1)
  rw [hQab, hQa, hQb, zero_add, zero_add] at hpad
  exact hpad.symm

private theorem bmdual_D0_inv_D0_eq_zero
    (n f : ℕ) {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (horth : e * bmdualestar n f e = 0) :
    bmdual_D0 (R + 1) r' (GaloisField 2 f) *
      (Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f)))⁻¹ *
      bmdual_D0 (R + 1) r' (GaloisField 2 f) = 0 := by
  let G := bmdualG n (GaloisField 2 f)
  let R0 := Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f))
  have hG : IsUnit G.det := bmdual_G_isUnit_det n
  have hD0symm : Matrix.transpose (bmdual_D0 (R + 1) r' (GaloisField 2 f)) =
      bmdual_D0 (R + 1) r' (GaloisField 2 f) := by
    ext i j
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
      simp [bmdual_D0, Matrix.fromBlocks, Matrix.transpose_apply, Matrix.one_apply, eq_comm]
  have hR0symm : Matrix.transpose R0 = R0 := by
    simp only [R0]
    rw [bmdual_reindex_transpose', hD0symm]
  have hiso : Matrix.transpose P * G * P = G :=
    bmdual_isometry_of_quad (bmdualQ n (GaloisField 2 f)) P hP
  have hPtG : Matrix.transpose P * G = G * Pinv := by
    calc Matrix.transpose P * G
        = Matrix.transpose P * G * 1 := (Matrix.mul_one _).symm
      _ = Matrix.transpose P * G * (P * Pinv) := by rw [hPP]
      _ = (Matrix.transpose P * G * P) * Pinv := by noncomm_ring
      _ = G * Pinv := by rw [hiso]
  have hPGinvPt : P * G⁻¹ * Matrix.transpose P = G⁻¹ := by
    have h : (P * G⁻¹ * Matrix.transpose P) * G = 1 := by
      calc (P * G⁻¹ * Matrix.transpose P) * G
          = P * G⁻¹ * (Matrix.transpose P * G) := by rw [Matrix.mul_assoc]
        _ = P * G⁻¹ * (G * Pinv) := by rw [hPtG]
        _ = P * (G⁻¹ * G) * Pinv := by noncomm_ring
        _ = P * 1 * Pinv := by rw [Matrix.nonsing_inv_mul G hG]
        _ = 1 := by rw [Matrix.mul_one, hPP]
    exact (Matrix.inv_eq_left_inv h).symm
  have hPinvConj : Matrix.transpose Pinv * G * Pinv = G := by
    have h := congrArg (fun M => Matrix.transpose Pinv * M * Pinv) hiso
    have h1 : Matrix.transpose Pinv * (Matrix.transpose P * G * P) * Pinv = G := by
      rw [show Matrix.transpose Pinv * (Matrix.transpose P * G * P) * Pinv =
          (Matrix.transpose Pinv * Matrix.transpose P) * G * (P * Pinv) from by noncomm_ring]
      rw [show Matrix.transpose Pinv * Matrix.transpose P = 1 from by
        rw [← Matrix.transpose_mul, hPP, Matrix.transpose_one], hPP]
      rw [Matrix.one_mul, Matrix.mul_one]
    rw [h1] at h
    exact h.symm
  have hPinvTG : Matrix.transpose Pinv * G = G * P := by
    conv_rhs => rw [← hPinvConj]
    rw [Matrix.mul_assoc, hPinvP, Matrix.mul_one]
  have hestar : bmdualestar n f e = G⁻¹ * Matrix.transpose e * G := by
    simp only [bmdualestar, formAdj]
    rw [show (e.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose e from
      congrArg Matrix.transpose (Matrix.map_id e)]
  have hGeG : e * G⁻¹ * Matrix.transpose e = 0 := by
    have h := congrArg (fun M => M * G⁻¹) horth
    rw [Matrix.zero_mul] at h
    rw [hestar] at h
    simpa [Matrix.mul_assoc, Matrix.mul_nonsing_inv G hG, Matrix.mul_one] using h
  have hR0 : R0 * G⁻¹ * R0 = 0 := by
    have h := congrArg (fun M => P * M * Matrix.transpose P) hGeG
    simp only [Matrix.mul_zero, Matrix.zero_mul] at h
    rw [← hconv] at h
    have hkey : P * ((Pinv * R0 * P) * G⁻¹ * Matrix.transpose (Pinv * R0 * P)) *
        Matrix.transpose P = R0 * G⁻¹ * R0 := by
      have hPt : Matrix.transpose (Pinv * R0 * P) =
          Matrix.transpose P * R0 * Matrix.transpose Pinv := by
        rw [Matrix.transpose_mul, Matrix.transpose_mul, hR0symm, Matrix.mul_assoc]
      have hPPt : Matrix.transpose Pinv * Matrix.transpose P = 1 := by
        rw [← Matrix.transpose_mul, hPP, Matrix.transpose_one]
      rw [hPt]
      calc P * (Pinv * R0 * P * G⁻¹ * (Matrix.transpose P * R0 * Matrix.transpose Pinv)) *
            Matrix.transpose P
          = P * Pinv * R0 * (P * G⁻¹ * Matrix.transpose P) * R0 *
              (Matrix.transpose Pinv * Matrix.transpose P) := by noncomm_ring
        _ = 1 * R0 * (P * G⁻¹ * Matrix.transpose P) * R0 * 1 := by rw [hPP, hPPt]
        _ = R0 * G⁻¹ * R0 := by rw [one_mul, mul_one, hPGinvPt]
    rwa [hkey] at h
  have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hR0
  simp only [R0, bmdual_reindex_mul, bmdual_reindex_comp_symm, ← Matrix.inv_reindex] at h
  simpa using h

private theorem bmdual_formStandard_diag
    (n f : ℕ) {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (lam : GaloisField 2 f)
    (hpair : Matrix.toBlocks₁₂ (Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f))) =
      bmdual_J12 f R r' lam)
    (hR : 1 ≤ R) (hlam : lam ≠ 0) :
    Matrix.toBlocks₁₁ (Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f))) = 0 ∧
    Matrix.toBlocks₂₁ (Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f))) =
      bmdual_J21 f R r' lam ∧
    Matrix.toBlocks₂₂ (Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f))) =
      Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (bmdual_formBlock n f R r' eidx) := by
  have hR2 : 2 ≤ R + 1 := by omega
  let G' : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
    Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f))
  have h11 : Matrix.toBlocks₁₁ G' = 0 := by
    simpa only [G'] using bmdual_block11_eq_zero n f (e := e) eidx hPP hPinvP hP hconv hquad
  have h11e : ∀ a b : Fin (R + 1), G' (Sum.inl a) (Sum.inl b) = 0 := by
    intro a b
    rw [show G' (Sum.inl a) (Sum.inl b) = Matrix.toBlocks₁₁ G' a b from rfl, h11]
    simp
  have hGsymm : Matrix.transpose G' = G' := by
    simp only [G']
    rw [bmdual_reindex_transpose', bmdual_G_symmetric n (GaloisField 2 f)]
  have hsymm : ∀ i j, G' i j = G' j i := by
    intro i j
    have h := congrFun (congrFun hGsymm i) j
    rw [Matrix.transpose_apply] at h
    exact h.symm
  have h21 : Matrix.toBlocks₂₁ G' = bmdual_J21 f R r' lam := by
    ext j a
    change G' (Sum.inr j) (Sum.inl a) = bmdual_J21 f R r' lam j a
    rw [hsymm]
    change G' (Sum.inl a) (Sum.inr j) = bmdual_J21 f R r' lam j a
    rw [show G' (Sum.inl a) (Sum.inr j) = Matrix.toBlocks₁₂ G' a j from rfl, hpair]
    rcases j with b | c <;> simp [bmdual_J12, bmdual_J21, eq_comm]
  have hconj : ∀ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      Matrix.transpose (bmdual_blockMat n f (R + 1) r' x) * G' *
          bmdual_blockMat n f (R + 1) r' x = G' := fun x =>
    bmdual_blockMat_gram_conj n f R r' eidx hblock x
  have h22eq : ∀ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      Matrix.transpose (Matrix.fromBlocks
        (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
          (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) *
      Matrix.toBlocks₂₂ G' *
      Matrix.fromBlocks
        (Matrix.transpose ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
          (GaloisField 2 f)) : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) = Matrix.toBlocks₂₂ G' := by
    intro x
    have h := hconj x
    rw [← Matrix.fromBlocks_toBlocks G'] at h
    unfold bmdual_blockMat at h
    rw [bmdual_transpose_fromBlocks'] at h
    rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at h
    simp only [Matrix.transpose_zero, Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add] at h
    rw [Matrix.fromBlocks_inj] at h
    exact h.2.2.2
  have hD12eq : ∀ x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
      ((x⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
        Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
        Matrix.toBlocks₁₂ (Matrix.toBlocks₂₂ G') =
      Matrix.toBlocks₁₂ (Matrix.toBlocks₂₂ G') := by
    intro x
    have h := h22eq x
    rw [← Matrix.fromBlocks_toBlocks (Matrix.toBlocks₂₂ G')] at h
    rw [bmdual_transpose_fromBlocks'] at h
    rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at h
    simp only [Matrix.transpose_zero, Matrix.transpose_transpose, Matrix.mul_zero,
      Matrix.mul_one, Matrix.zero_mul, add_zero, zero_add] at h
    rw [Matrix.fromBlocks_inj] at h
    exact h.2.1
  have hD12 : Matrix.toBlocks₁₂ (Matrix.toBlocks₂₂ G') = 0 := by
    apply bmdual_eq_zero_of_transpose_mul_eq_rect f hR2
    intro g
    have hleft : ∀ y : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f),
        (y : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) *
          Matrix.toBlocks₁₂ (Matrix.toBlocks₂₂ G') =
        Matrix.toBlocks₁₂ (Matrix.toBlocks₂₂ G') :=
      fun y => by simpa using hD12eq (y⁻¹ : Matrix.SpecialLinearGroup (Fin (R + 1))
        (GaloisField 2 f))
    have := hleft ⟨Matrix.transpose (g : Matrix (Fin (R + 1)) (Fin (R + 1))
      (GaloisField 2 f)), by rw [Matrix.det_transpose]; exact g.2⟩
    simpa using this
  have hD12e : ∀ b : Fin (R + 1), ∀ c : Fin r',
      G' (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inr c)) = 0 := by
    intro b c
    have := congrFun (congrFun hD12 b) c
    simpa [Matrix.toBlocks₁₂, Matrix.toBlocks₂₂] using this
  have hGinv : IsUnit G'.det := by
    simp only [G']
    rw [Matrix.det_reindex_self]
    exact bmdual_G_isUnit_det n
  have hG'Z : G' * G'⁻¹ = 1 := Matrix.mul_nonsing_inv G' hGinv
  have hD0Z : bmdual_D0 (R + 1) r' (GaloisField 2 f) * G'⁻¹ *
      bmdual_D0 (R + 1) r' (GaloisField 2 f) = 0 := by
    simpa only [G'] using bmdual_D0_inv_D0_eq_zero n f (e := e) eidx hPP hPinvP hP hconv horth
  have hD0eq : bmdual_D0 (R + 1) r' (GaloisField 2 f) =
      Matrix.fromBlocks (1 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f)) := by
    ext i j
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
      simp [bmdual_D0, Matrix.fromBlocks, Matrix.one_apply]
  have hZ11 : ∀ a a' : Fin (R + 1), G'⁻¹ (Sum.inl a) (Sum.inl a') = 0 := by
    intro a a'
    have h := hD0Z
    rw [hD0eq, ← Matrix.fromBlocks_toBlocks (G'⁻¹)] at h
    rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at h
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one,
      Matrix.one_mul] at h
    have h0 : (0 : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
        (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f)) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f)) := by
      ext i j
      rcases i with a'' | (b'' | c'') <;> rcases j with a3 | (b3 | c3) <;>
        simp [Matrix.fromBlocks]
    rw [h0, Matrix.fromBlocks_inj] at h
    have hh := congrFun (congrFun h.1 a) a'
    simpa only [Matrix.toBlocks₁₁, Matrix.of_apply, Matrix.zero_apply] using hh
  have hZ21 : ∀ b a' : Fin (R + 1),
      G'⁻¹ (Sum.inr (Sum.inl b)) (Sum.inl a') = if b = a' then lam⁻¹ else 0 := by
    intro b a'
    have h := congrFun (congrFun hG'Z (Sum.inl b)) (Sum.inl a')
    rw [Matrix.mul_apply, Fintype.sum_eq_single (Sum.inr (Sum.inl b))] at h
    · rw [show G' (Sum.inl b) (Sum.inr (Sum.inl b)) = lam from by
          rw [show G' (Sum.inl b) (Sum.inr (Sum.inl b)) =
            Matrix.toBlocks₁₂ G' b (Sum.inl b) from rfl, hpair]
          simp [bmdual_J12]] at h
      rw [show (1 : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
          (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f))
          (Sum.inl b) (Sum.inl a') = if b = a' then 1 else 0 from by
        simp [Matrix.one_apply]] at h
      by_cases hba : b = a'
      · rw [if_pos hba] at h
        have hz : G'⁻¹ (Sum.inr (Sum.inl b)) (Sum.inl a') = lam⁻¹ := by
          have hh := congrArg (fun t => lam⁻¹ * t) h
          rwa [← mul_assoc, inv_mul_cancel₀ hlam, one_mul, mul_one] at hh
        simpa [hba] using hz
      · rw [if_neg hba] at h
        have hz : G'⁻¹ (Sum.inr (Sum.inl b)) (Sum.inl a') = 0 :=
          (mul_eq_zero.mp h).resolve_left hlam
        simpa [hba] using hz
    · intro k hk
      rcases k with a'' | (b'' | c)
      · rw [h11e b a'']
        simp
      · have hb'' : b'' ≠ b := fun hh => hk (by rw [hh])
        rw [show G' (Sum.inl b) (Sum.inr (Sum.inl b'')) =
            Matrix.toBlocks₁₂ G' b (Sum.inl b'') from rfl, hpair]
        simp only [bmdual_J12, Matrix.of_apply]
        rw [if_neg (Ne.symm hb'')]
        simp
      · rw [show G' (Sum.inl b) (Sum.inr (Sum.inr c)) =
            Matrix.toBlocks₁₂ G' b (Sum.inr c) from rfl, hpair]
        simp [bmdual_J12]
  have hD11 : ∀ b a' : Fin (R + 1),
      G' (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inl a')) = 0 := by
    intro b a'
    have h := congrFun (congrFun hG'Z (Sum.inr (Sum.inl b))) (Sum.inl a')
    rw [Matrix.mul_apply, Fintype.sum_eq_single (Sum.inr (Sum.inl a'))] at h
    · rw [hZ21 a' a', if_pos rfl,
        show (1 : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
          (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f))
          (Sum.inr (Sum.inl b)) (Sum.inl a') = 0 from by simp [Matrix.one_apply]] at h
      exact (mul_eq_zero.mp h).resolve_right (inv_ne_zero hlam)
    · intro k hk
      rcases k with a'' | (b'' | c)
      · rw [hZ11 a'' a']
        simp
      · have hba : b'' ≠ a' := fun hh => hk (by rw [hh])
        rw [hZ21 b'' a', if_neg hba]
        simp
      · rw [hD12e b c]
        simp
  have h22 : Matrix.toBlocks₂₂ G' = Matrix.fromBlocks
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (bmdual_formBlock n f R r' eidx) := by
    ext i j
    rcases i with b | c <;> rcases j with b' | c'
    · change G' (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inl b')) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (bmdual_formBlock n f R r' eidx) (Sum.inl b) (Sum.inl b')
      rw [Matrix.fromBlocks_apply₁₁, Matrix.zero_apply]
      exact hD11 b b'
    · change G' (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inr c')) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (bmdual_formBlock n f R r' eidx) (Sum.inl b) (Sum.inr c')
      rw [Matrix.fromBlocks_apply₁₂, Matrix.zero_apply]
      exact hD12e b c'
    · change G' (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inl b')) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (bmdual_formBlock n f R r' eidx) (Sum.inr c) (Sum.inl b')
      rw [Matrix.fromBlocks_apply₂₁, Matrix.zero_apply]
      rw [hsymm]
      exact hD12e b' c
    · change G' (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inr c')) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
          (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
          (bmdual_formBlock n f R r' eidx) (Sum.inr c) (Sum.inr c')
      rw [Matrix.fromBlocks_apply₂₂]
      rfl
  exact ⟨h11, h21, h22⟩

private theorem bmdual_formStandard_blocks
    (n f : ℕ) {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0) (hR : 1 ≤ R) :
    ∃ lam : GaloisField 2 f, lam ≠ 0 ∧
      Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f)) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
          (bmdual_J12 f R r' lam) (bmdual_J21 f R r' lam)
          (Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
            (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
            (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
            (bmdual_formBlock n f R r' eidx)) := by
  obtain ⟨lam, hlam, hpair⟩ := bmdual_formStandard_pair n f (e := e) eidx hPP hPinvP hP hblock
    hconv hquad hquad' heps horth horth' hR
  obtain ⟨h11, h21, h22⟩ := bmdual_formStandard_diag n f (e := e) eidx hPP hPinvP hP hblock
    hconv hquad hquad' heps horth horth' lam hpair hR hlam
  exact ⟨lam, hlam, by
    rw [← Matrix.fromBlocks_toBlocks
      (Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f))), h11, hpair, h21, h22]⟩

private theorem bmdual_formBlock_invertible
    (n f : ℕ) {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0) (hR : 1 ≤ R) :
    ∃ Qinv : Matrix (Fin r') (Fin r') (GaloisField 2 f),
      bmdual_formBlock n f R r' eidx * Qinv = 1 := by
  obtain ⟨lam, hlam, hpair⟩ := bmdual_formStandard_pair n f (e := e) eidx hPP hPinvP hP hblock
    hconv hquad hquad' heps horth horth' hR
  obtain ⟨_h11, _h21, h22⟩ := bmdual_formStandard_diag n f (e := e) eidx hPP hPinvP hP hblock
    hconv hquad hquad' heps horth horth' lam hpair hR hlam
  let G' : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
    Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f))
  have hGinv : IsUnit G'.det := by
    simp only [G']
    rw [Matrix.det_reindex_self]
    exact bmdual_G_isUnit_det n
  have hD12' : Matrix.toBlocks₁₂ (Matrix.toBlocks₂₂ G') = 0 := by
    rw [show Matrix.toBlocks₂₂ G' = Matrix.fromBlocks
        (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (bmdual_formBlock n f R r' eidx) from by simpa only [G'] using h22,
      Matrix.toBlocks_fromBlocks₁₂]
  have hD12e : ∀ b : Fin (R + 1), ∀ c : Fin r',
      G' (Sum.inr (Sum.inl b)) (Sum.inr (Sum.inr c)) = 0 := by
    intro b c
    have := congrFun (congrFun hD12' b) c
    simpa only [Matrix.toBlocks₁₂, Matrix.toBlocks₂₂, Matrix.of_apply, Matrix.zero_apply] using this
  have hmapzero : ∀ v : Fin r' → GaloisField 2 f,
      Matrix.mulVec (bmdual_formBlock n f R r' eidx) v = 0 → v = 0 := by
    intro v hv
    let x : (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) → GaloisField 2 f :=
      Sum.elim (fun _ => 0) (Sum.elim (fun _ => 0) v)
    have hx : Matrix.mulVec G' x = 0 := by
      funext i
      rcases i with a | (b | c)
      · simp only [Matrix.mulVec, dotProduct, Pi.zero_apply]
        rw [Fintype.sum_sum_type, Finset.sum_eq_zero (fun a' _ => by simp [x]), zero_add,
          Fintype.sum_sum_type, Finset.sum_eq_zero (fun b' _ => by simp [x]), zero_add]
        rw [Finset.sum_eq_zero (fun c' _ => by
          rw [show G' (Sum.inl a) (Sum.inr (Sum.inr c')) =
              Matrix.toBlocks₁₂ G' a (Sum.inr c') from rfl, hpair]
          simp [bmdual_J12, x])]
      · simp only [Matrix.mulVec, dotProduct, Pi.zero_apply]
        rw [Fintype.sum_sum_type, Finset.sum_eq_zero (fun a' _ => by simp [x]), zero_add,
          Fintype.sum_sum_type, Finset.sum_eq_zero (fun b' _ => by simp [x]), zero_add]
        rw [Finset.sum_eq_zero (fun c' _ => by
          rw [hD12e b c']
          simp [x])]
      · simp only [Matrix.mulVec, dotProduct, Pi.zero_apply]
        rw [Fintype.sum_sum_type, Finset.sum_eq_zero (fun a' _ => by simp [x]), zero_add,
          Fintype.sum_sum_type, Finset.sum_eq_zero (fun b' _ => by simp [x]), zero_add]
        have hsum : (∑ c' : Fin r', G' (Sum.inr (Sum.inr c)) (Sum.inr (Sum.inr c')) *
            x (Sum.inr (Sum.inr c'))) =
            Matrix.mulVec (bmdual_formBlock n f R r' eidx) v c := by
          simp only [x, Sum.elim_inr, Matrix.mulVec, dotProduct, bmdual_formBlock,
            Matrix.of_apply]
          rfl
        rw [hsum, show Matrix.mulVec (bmdual_formBlock n f R r' eidx) v c = 0 from by
          rw [hv]; rfl]
    have hx0 := Matrix.eq_zero_of_mulVec_eq_zero hGinv.ne_zero hx
    funext c
    have := congrFun hx0 (Sum.inr (Sum.inr c))
    simpa [x] using this
  have hinj : Function.Injective (Matrix.mulVec (bmdual_formBlock n f R r' eidx)) := by
    intro v w hvw
    have hzw : Matrix.mulVec (bmdual_formBlock n f R r' eidx) (v - w) = 0 := by
      rw [Matrix.mulVec_sub, hvw, sub_self]
    exact sub_eq_zero.mp (hmapzero (v - w) hzw)
  exact (Matrix.mulVec_injective_iff_isUnit.mp hinj).exists_right_inv

private theorem bmdual_formStandard
    (n f : ℕ) {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0) (hR : 1 ≤ R) :
    bmdual_IsFormStandard n f R r' eidx := by
  obtain ⟨lam, hlam, hblocks⟩ := bmdual_formStandard_blocks n f (e := e) eidx hPP hPinvP hP hblock
    hconv hquad hquad' heps horth horth' hR
  exact ⟨lam, hlam, hblocks,
    bmdual_formBlock_invertible n f (e := e) eidx hPP hPinvP hP hblock hconv hquad hquad' heps horth
      horth' hR⟩

private theorem bmdual_formAdj_P
    (n f : ℕ)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v) :
    formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) P = Pinv := by
  have hG : IsUnit (bmdualG n (GaloisField 2 f)).det := bmdual_G_isUnit_det n
  have hiso : Matrix.transpose P * bmdualG n (GaloisField 2 f) * P =
      bmdualG n (GaloisField 2 f) :=
    bmdual_isometry_of_quad (bmdualQ n (GaloisField 2 f)) P hP
  have hPtG : Matrix.transpose P * bmdualG n (GaloisField 2 f) =
      bmdualG n (GaloisField 2 f) * Pinv := by
    calc Matrix.transpose P * bmdualG n (GaloisField 2 f)
        = Matrix.transpose P * bmdualG n (GaloisField 2 f) * 1 := (Matrix.mul_one _).symm
      _ = Matrix.transpose P * bmdualG n (GaloisField 2 f) * (P * Pinv) := by rw [hPP]
      _ = (Matrix.transpose P * bmdualG n (GaloisField 2 f) * P) * Pinv := by
          noncomm_ring
      _ = bmdualG n (GaloisField 2 f) * Pinv := by rw [hiso]
  unfold formAdj
  rw [show (P.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose P from
    congrArg Matrix.transpose (Matrix.map_id P)]
  rw [Matrix.mul_assoc, hPtG, ← Matrix.mul_assoc, Matrix.nonsing_inv_mul _ hG, Matrix.one_mul]

private theorem bmdual_formAdj_Pinv
    (n f : ℕ)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v) :
    formAdj (RingHom.id (GaloisField 2 f)) (bmdualG n (GaloisField 2 f)) Pinv = P := by
  have h := Geo.formAdj_formAdj (RingHom.id (GaloisField 2 f)) (fun x => rfl)
    (bmdual_G_isUnit_det n) (bmdual_G_symmetric_map n (GaloisField 2 f)) P
  rw [bmdual_formAdj_P n f hPP hP] at h
  exact h

private theorem bmdual_D0_eq (R r' : ℕ) (F : Type) [Zero F] [One F] :
    bmdual_D0 (R + 1) r' F = Matrix.fromBlocks (1 : Matrix (Fin (R + 1)) (Fin (R + 1)) F)
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') F)
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) F)
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') F) := by
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
    simp [bmdual_D0, Matrix.fromBlocks, Matrix.one_apply]

private theorem bmdual_D1_eq (R r' : ℕ) (F : Type) [Zero F] [One F] :
    bmdual_D1 (R + 1) r' F = Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) F)
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') F)
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) F)
      (Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) F)
        (0 : Matrix (Fin (R + 1)) (Fin r') F) (0 : Matrix (Fin r') (Fin (R + 1)) F)
        (1 : Matrix (Fin r') (Fin r') F)) := by
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
    simp [bmdual_D1, Matrix.fromBlocks, Matrix.one_apply]

private theorem bmdual_transpose_fromBlocks {m n m' n' : Type*} {F : Type}
    (A : Matrix m m' F) (B : Matrix m n' F) (C : Matrix n m' F) (D : Matrix n n' F) :
    Matrix.transpose (Matrix.fromBlocks A B C D) =
      Matrix.fromBlocks (Matrix.transpose A) (Matrix.transpose C)
        (Matrix.transpose B) (Matrix.transpose D) := by
  ext i j
  rcases i with i | i <;> rcases j with j | j <;>
    simp [Matrix.fromBlocks, Matrix.transpose_apply]

private theorem bmdual_J12_mul (f R r' : ℕ) (lam : GaloisField 2 f)
    (E : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
    (G : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f)) :
    bmdual_J12 f R r' lam *
      Matrix.fromBlocks E (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f)) G
        (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) =
      Matrix.of (fun a j => Sum.elim (fun b => lam * E a b) (fun _ : Fin r' => 0) j) := by
  ext a j
  rcases j with b | c
  · rw [Matrix.mul_apply, Finset.sum_eq_single (Sum.inl a)]
    · simp [bmdual_J12, Matrix.fromBlocks]
    · intro k _ hk
      rcases k with a' | (b' | c')
      · have hne : a ≠ a' := fun h => hk (by rw [h])
        simp [bmdual_J12, Matrix.fromBlocks, hne]
      · simp [bmdual_J12, Matrix.fromBlocks]
      · simp [bmdual_J12, Matrix.fromBlocks]
    · intro h; exact absurd (Finset.mem_univ _) h
  · simp only [Matrix.of_apply, Sum.elim]
    rw [Matrix.mul_apply]
    exact Finset.sum_eq_zero (fun k _ => by
      rcases k with a' | (b' | c') <;> simp [bmdual_J12, Matrix.fromBlocks])

private theorem bmdual_block_diag_outer (R r' : ℕ) {F : Type} [Field F]
    {A : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) F}
    (h : A * bmdual_D0 (R + 1) r' F = bmdual_D0 (R + 1) r' F * A) :
    ∃ x : Matrix (Fin (R + 1)) (Fin (R + 1)) F,
      ∃ y : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') F,
        A = Matrix.fromBlocks x 0 0 y := by
  let x : Matrix (Fin (R + 1)) (Fin (R + 1)) F := Matrix.toBlocks₁₁ A
  let y : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') F := Matrix.toBlocks₂₂ A
  refine ⟨x, y, ?_⟩
  have h' := h
  rw [bmdual_D0_eq R r' F, ← Matrix.fromBlocks_toBlocks A] at h'
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply] at h'
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one,
    Matrix.one_mul] at h'
  rw [Matrix.fromBlocks_inj] at h'
  obtain ⟨-, h12, h21, -⟩ := h'
  have h12' : Matrix.toBlocks₁₂ A = 0 := h12.symm
  have h21' : Matrix.toBlocks₂₁ A = 0 := h21
  nth_rewrite 1 [← Matrix.fromBlocks_toBlocks A]
  rw [h12', h21']

private theorem bmdual_block_diag_inner (R r' : ℕ) {F : Type} [Field F]
    {D : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') F}
    (h : D * Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) F)
          (0 : Matrix (Fin (R + 1)) (Fin r') F) (0 : Matrix (Fin r') (Fin (R + 1)) F)
          (1 : Matrix (Fin r') (Fin r') F) =
        Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) F)
          (0 : Matrix (Fin (R + 1)) (Fin r') F) (0 : Matrix (Fin r') (Fin (R + 1)) F)
          (1 : Matrix (Fin r') (Fin r') F)) :
    ∃ E : Matrix (Fin (R + 1)) (Fin (R + 1)) F, ∃ G : Matrix (Fin r') (Fin (R + 1)) F,
      D = Matrix.fromBlocks E 0 G 1 := by
  let E : Matrix (Fin (R + 1)) (Fin (R + 1)) F := Matrix.toBlocks₁₁ D
  let G : Matrix (Fin r') (Fin (R + 1)) F := Matrix.toBlocks₂₁ D
  refine ⟨E, G, ?_⟩
  have h' := h
  rw [← Matrix.fromBlocks_toBlocks D] at h'
  rw [Matrix.fromBlocks_multiply] at h'
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one,
    Matrix.one_mul] at h'
  rw [Matrix.fromBlocks_inj] at h'
  obtain ⟨-, h12, -, h22⟩ := h'
  have h12' : Matrix.toBlocks₁₂ D = 0 := h12
  have h22' : Matrix.toBlocks₂₂ D = 1 := h22
  nth_rewrite 1 [← Matrix.fromBlocks_toBlocks D]
  rw [h12', h22']

private theorem bmdual_block_symplectic (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    (hform : bmdual_IsFormStandard n f R r' eidx)
    {A E : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)}
    {G : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f)}
    (hs : Matrix.transpose (Matrix.fromBlocks A 0 0 (Matrix.fromBlocks E 0 G 1)) *
      Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f)) *
      Matrix.fromBlocks A 0 0 (Matrix.fromBlocks E 0 G 1) =
      Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f))) :
    Matrix.transpose A * E = 1 ∧ G = 0 := by
  obtain ⟨lam, hlam, hGblocks, hQunit⟩ := hform
  have hs1 := hs
  rw [hGblocks] at hs1
  simp only [bmdual_transpose_fromBlocks, Matrix.transpose_zero, Matrix.fromBlocks_multiply,
    Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add] at hs1
  rw [Matrix.fromBlocks_inj] at hs1
  obtain ⟨-, hAE, -, hGG⟩ := hs1
  constructor
  · rw [Matrix.mul_assoc, bmdual_J12_mul f R r' lam E G] at hAE
    ext a b
    have hh := congrFun (congrFun hAE a) (Sum.inl b)
    have hh' : lam * (Matrix.transpose A * E) a b = lam * (1 : Matrix (Fin (R + 1)) (Fin (R + 1))
        (GaloisField 2 f)) a b := by
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Sum.elim_inl] at hh
      have hfac : (∑ j, A j a * (lam * E j b)) = lam * ∑ j, A j a * E j b := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun j _ => by ring)
      rw [hfac, show (∑ j, A j a * E j b) = (Matrix.transpose A * E) a b from by
        rw [Matrix.mul_apply]; simp [Matrix.transpose_apply]] at hh
      rw [hh]
      simp only [bmdual_J12, Matrix.of_apply, Matrix.one_apply]
      split <;> ring
    exact mul_left_cancel₀ hlam hh'
  · rw [Matrix.fromBlocks_inj] at hGG
    obtain ⟨-, hGQ, -, -⟩ := hGG
    have hGQ' : Matrix.transpose G * bmdual_formBlock n f R r' eidx = 0 := by
      simpa only [Matrix.mul_one, bmdual_formBlock] using hGQ
    obtain ⟨Qinv, hQinv⟩ := hQunit
    have hGt : Matrix.transpose G = 0 := by
      rw [← Matrix.mul_one (Matrix.transpose G), ← hQinv, ← Matrix.mul_assoc, hGQ',
        Matrix.zero_mul]
    rw [← Matrix.transpose_transpose G, hGt, Matrix.transpose_zero]

private theorem bmdual_reindex_transpose (f : ℕ) {ι κ : Type*} (e : ι ≃ κ)
    (A : Matrix ι ι (GaloisField 2 f)) :
    Matrix.transpose (Matrix.reindex e e A) = Matrix.reindex e e (Matrix.transpose A) := by
  ext i j
  simp [Matrix.reindex_apply, Matrix.transpose_apply]

private theorem bmdual_formStandard_noH
    (n f : ℕ) {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0) (hR : 1 ≤ R) :
    bmdual_IsFormStandard n f R r' eidx :=
  bmdual_formStandard n f (e := e) eidx hPP hPinvP hP hblock hconv hquad hquad' heps horth
    horth' hR

private theorem bmdual_estar_conj_noH
    (n f : ℕ) {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hform : bmdual_IsFormStandard n f R r' eidx) :
    Pinv * Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f)) * P =
      bmdualestar n f e := by
  let G := bmdualG n (GaloisField 2 f)
  let R0 := Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f))
  let R0s := Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f))
  let G' : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
    Matrix.reindex eidx.symm eidx.symm G
  obtain ⟨lam, _hlam, hGblocks, _hQunit⟩ := hform
  have hGblk : G' = Matrix.fromBlocks
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (bmdual_J12 f R r' lam) (bmdual_J21 f R r' lam)
      (Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (bmdual_formBlock n f R r' eidx)) := hGblocks
  have hGinv : IsUnit G'.det := by
    simp only [G']
    rw [Matrix.det_reindex_self]
    exact bmdual_G_isUnit_det n
  have hA : Matrix.toBlocks₁₁ G' = 0 := by
    rw [hGblk, Matrix.toBlocks_fromBlocks₁₁]
  have hB : Matrix.toBlocks₁₂ G' = bmdual_J12 f R r' lam := by
    rw [hGblk, Matrix.toBlocks_fromBlocks₁₂]
  have hD : Matrix.toBlocks₂₂ G' = Matrix.fromBlocks
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (bmdual_formBlock n f R r' eidx) := by
    rw [hGblk, Matrix.toBlocks_fromBlocks₂₂]
  have hJ12W0 : Matrix.toBlocks₁₂ G' * Matrix.fromBlocks
      (1 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) = Matrix.toBlocks₁₂ G' := by
    rw [hB]
    ext a j
    rcases j with b | c
    · rw [Matrix.mul_apply, Fintype.sum_eq_single (Sum.inl b)]
      · simp [bmdual_J12, Matrix.fromBlocks, Matrix.one_apply]
      · intro k hk
        rcases k with b' | c'
        · have hb' : b' ≠ b := fun h => hk (by rw [h])
          simp [bmdual_J12, Matrix.fromBlocks, Matrix.one_apply, hb']
        · simp [bmdual_J12, Matrix.fromBlocks]
    · rw [Matrix.mul_apply]
      apply Finset.sum_eq_zero
      intro k _
      rcases k with b' | c' <;> simp [bmdual_J12, Matrix.fromBlocks]
  have hD22W0 : Matrix.toBlocks₂₂ G' * Matrix.fromBlocks
      (1 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) = 0 := by
    rw [hD, Matrix.fromBlocks_multiply]
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero]
    ext i j
    rcases i with b | c <;> rcases j with b' | c' <;> simp [Matrix.fromBlocks]
  have hD0eq : bmdual_D0 (R + 1) r' (GaloisField 2 f) = Matrix.fromBlocks
      (1 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f)) := by
    ext i j
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
      simp [bmdual_D0, Matrix.fromBlocks, Matrix.one_apply]
  have hD0seq : bmdual_D0s (R + 1) r' (GaloisField 2 f) = Matrix.fromBlocks
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin (R + 1) ⊕ Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1) ⊕ Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (Matrix.fromBlocks (1 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
        (0 : Matrix (Fin r') (Fin r') (GaloisField 2 f))) := by
    ext i j
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
      simp [bmdual_D0s, Matrix.fromBlocks, Matrix.one_apply]
  have hD0G : bmdual_D0 (R + 1) r' (GaloisField 2 f) * G' =
      G' * bmdual_D0s (R + 1) r' (GaloisField 2 f) := by
    rw [hD0eq, hD0seq,
      show G' = Matrix.fromBlocks (Matrix.toBlocks₁₁ G') (Matrix.toBlocks₁₂ G')
        (Matrix.toBlocks₂₁ G') (Matrix.toBlocks₂₂ G') from
        (Matrix.fromBlocks_toBlocks G').symm]
    rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.one_mul]
    rw [hA, hJ12W0, hD22W0]
  have hX : G'⁻¹ * bmdual_D0 (R + 1) r' (GaloisField 2 f) * G' =
      bmdual_D0s (R + 1) r' (GaloisField 2 f) := by
    calc G'⁻¹ * bmdual_D0 (R + 1) r' (GaloisField 2 f) * G'
        = G'⁻¹ * (bmdual_D0 (R + 1) r' (GaloisField 2 f) * G') := by
            rw [Matrix.mul_assoc]
      _ = G'⁻¹ * (G' * bmdual_D0s (R + 1) r' (GaloisField 2 f)) := by rw [hD0G]
      _ = (G'⁻¹ * G') * bmdual_D0s (R + 1) r' (GaloisField 2 f) := by
            rw [Matrix.mul_assoc]
      _ = bmdual_D0s (R + 1) r' (GaloisField 2 f) := by
            rw [Matrix.nonsing_inv_mul G' hGinv, Matrix.one_mul]
  have hR0symm : Matrix.transpose R0 = R0 := by
    have hD0symm : Matrix.transpose (bmdual_D0 (R + 1) r' (GaloisField 2 f)) =
        bmdual_D0 (R + 1) r' (GaloisField 2 f) := by
      ext i j
      rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
        simp [bmdual_D0, Matrix.fromBlocks, Matrix.transpose_apply, Matrix.one_apply, eq_comm]
    simp only [R0]
    rw [bmdual_reindex_transpose', hD0symm]
  have hformR0 : formAdj (RingHom.id (GaloisField 2 f)) G R0 = R0s := by
    unfold formAdj
    rw [show (R0.map ⇑(RingHom.id (GaloisField 2 f))).transpose = Matrix.transpose R0 from
      congrArg Matrix.transpose (Matrix.map_id R0)]
    rw [hR0symm]
    have hGinvEq : G⁻¹ = Matrix.reindex eidx eidx G'⁻¹ := by
      rw [show G' = Matrix.reindex eidx.symm eidx.symm G from rfl, Matrix.inv_reindex]
      ext i j
      simp [Matrix.reindex_apply, Matrix.submatrix_apply]
    have hGeq : G = Matrix.reindex eidx eidx G' := by
      rw [show G' = Matrix.reindex eidx.symm eidx.symm G from rfl]
      ext i j
      simp [Matrix.reindex_apply, Matrix.submatrix_apply]
    rw [hGinvEq, hGeq,
      show R0 = Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) from rfl]
    rw [← bmdual_reindex_mul, ← bmdual_reindex_mul, hX]
  have hGdet : IsUnit G.det := bmdual_G_isUnit_det n
  have hformP : formAdj (RingHom.id (GaloisField 2 f)) G P = Pinv :=
    bmdual_formAdj_P n f hPP hP
  have hformPinv : formAdj (RingHom.id (GaloisField 2 f)) G Pinv = P :=
    bmdual_formAdj_Pinv n f hPP hP
  have hestar : bmdualestar n f e = Pinv * R0s * P := by
    calc bmdualestar n f e
        = formAdj (RingHom.id (GaloisField 2 f)) G (Pinv * R0 * P) := by
            rw [bmdualestar, ← hconv]
      _ = formAdj (RingHom.id (GaloisField 2 f)) G P *
            formAdj (RingHom.id (GaloisField 2 f)) G (Pinv * R0) := by
            rw [show Pinv * R0 * P = (Pinv * R0) * P from rfl,
              Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) hGdet]
      _ = formAdj (RingHom.id (GaloisField 2 f)) G P *
            (formAdj (RingHom.id (GaloisField 2 f)) G R0 *
              formAdj (RingHom.id (GaloisField 2 f)) G Pinv) := by
            rw [Geo.formAdj_mul (RingHom.id (GaloisField 2 f)) hGdet]
      _ = Pinv * (R0s * P) := by rw [hformP, hformR0, hformPinv]
      _ = Pinv * R0s * P := by rw [Matrix.mul_assoc]
  simpa only [R0s] using hestar.symm

private theorem bmdual_eps_conj_noH
    (n f : ℕ) {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hform : bmdual_IsFormStandard n f R r' eidx) :
    Pinv * Matrix.reindex eidx eidx (bmdual_D1 (R + 1) r' (GaloisField 2 f)) * P =
      1 - bmdualeps n f e := by
  have hestar := bmdual_estar_conj_noH n f (e := e) eidx hPP hPinvP hP hblock hconv hquad hquad'
    heps horth horth' hform
  have hD1 : bmdual_D1 (R + 1) r' (GaloisField 2 f) =
      1 - bmdual_D0 (R + 1) r' (GaloisField 2 f) -
        bmdual_D0s (R + 1) r' (GaloisField 2 f) := by
    ext i j
    rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
      simp [bmdual_D1, bmdual_D0, bmdual_D0s, Matrix.fromBlocks, Matrix.one_apply,
        sub_eq_add_neg, add_comm, add_left_comm, add_assoc]
  have hre : Matrix.reindex eidx eidx (bmdual_D1 (R + 1) r' (GaloisField 2 f)) =
      (1 : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) -
        Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) -
        Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f)) := by
    rw [hD1]
    change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
        ((1 : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
          (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f)) -
          bmdual_D0 (R + 1) r' (GaloisField 2 f) -
          bmdual_D0s (R + 1) r' (GaloisField 2 f)) =
        (1 : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) -
          (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
            (bmdual_D0 (R + 1) r' (GaloisField 2 f)) -
          (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) eidx)
            (bmdual_D0s (R + 1) r' (GaloisField 2 f))
    rw [map_sub, map_sub, map_one]
  rw [hre]
  have hexp : Pinv * ((1 : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) -
        Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) -
        Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f))) * P =
      Pinv * P - Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P -
        Pinv * Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f)) * P := by
    rw [Matrix.mul_sub, Matrix.mul_sub, Matrix.sub_mul, Matrix.sub_mul]
    noncomm_ring
  rw [hexp, hPinvP, hconv, hestar, bmdualeps]
  abel

private theorem bmdual_conj_mul'' (n f : ℕ)
    (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
    (hPinvP : Pinv * P = 1) (u v : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) :
    (P * u * Pinv) * (P * v * Pinv) = P * (u * v) * Pinv := by
  rw [show (P * u * Pinv) * (P * v * Pinv) = P * u * (Pinv * P) * v * Pinv from by
    noncomm_ring, hPinvP, Matrix.mul_one]
  noncomm_ring

private theorem bmdual_conj_sandwich (n f : ℕ)
    (P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
    (hPP : P * Pinv = 1) (u : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) :
    P * (Pinv * u * P) * Pinv = u := by
  rw [show P * (Pinv * u * P) * Pinv = (P * Pinv) * u * (P * Pinv) from by noncomm_ring,
    hPP, Matrix.one_mul, Matrix.mul_one]

private theorem bmdual_block_of_mem
    (n f : ℕ) (hn : 3 ≤ n) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e))
    (hgen : bmdual_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualQ n (GaloisField 2 f)))}
    (hJe : IsComponentOf J' (bmdualrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hform : bmdual_IsFormStandard n f R r' eidx)
    (g : ↥(spinGroup (bmdualQ n (GaloisField 2 f))))
    (hg : g ∈ glBlockCentralizer (bmdualJ n (GaloisField 2 f)) S (bmdualeps n f e)) :
    ∃ a : GL (Fin (R + 1)) (GaloisField 2 f),
      bmdual_matOf n f R r' eidx P Pinv g = bmdual_glBlock f R r' a := by
  rw [glBlockCentralizer, Subgroup.mem_comap, Subgroup.mem_inf] at hg
  obtain ⟨hgC, hgF⟩ := hg
  have hge : bmdual_gm n f g * e = e * bmdual_gm n f g := by
    refine (Algebra.commute_of_mem_adjoin_of_forall_mem_commute he.1 ?_).eq
    rintro b ⟨s, hs, rfl⟩
    exact (congrArg (fun u : GL (bmdualι n) (GaloisField 2 f) =>
      (u : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)))
      ((Subgroup.mem_centralizer_iff.mp hgC) s hs)).symm
  have hgf : bmdual_gm n f g * (1 - bmdualeps n f e) = 1 - bmdualeps n f e := hgF
  have hgsp : Matrix.transpose (bmdual_gm n f g) * bmdualG n (GaloisField 2 f) *
      bmdual_gm n f g = bmdualG n (GaloisField 2 f) := by
    simpa [bmdual_gm] using bmdual_isometry_of_quad (bmdualQ n (GaloisField 2 f))
      ((bmdualJ n (GaloisField 2 f) g : GL (bmdualι n) (GaloisField 2 f)) :
        Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
      (bmdual_spinMatrix_isometry n (GaloisField 2 f) g)
  let M : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
    bmdual_matOf n f R r' eidx P Pinv g
  set M' : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f) := P * bmdual_gm n f g * Pinv
      with hM'def
  have hconje : P * e * Pinv =
      Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) := by
    rw [← hconv, bmdual_conj_sandwich n f P Pinv hPP (Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r'
        (GaloisField 2 f)))]
  have hM0' : M' * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) =
      Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * M' := by
    change (P * bmdual_gm n f g * Pinv) *
        Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) =
      Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) *
        (P * bmdual_gm n f g * Pinv)
    rw [← hconje, bmdual_conj_mul'' n f P Pinv hPinvP (bmdual_gm n f g) e,
      bmdual_conj_mul'' n f P Pinv hPinvP e (bmdual_gm n f g), hge]
  have hM0 : M * bmdual_D0 (R + 1) r' (GaloisField 2 f) =
      bmdual_D0 (R + 1) r' (GaloisField 2 f) * M := by
    have h1 := congrArg (Matrix.reindex eidx.symm eidx.symm) hM0'
    conv at h1 => lhs; rw [bmdual_reindex_mul]
    conv at h1 => rhs; rw [bmdual_reindex_mul]
    rw [bmdual_reindex_comp_symm] at h1
    simpa only [M, bmdual_matOf, M'] using h1
  have hM1 : M * bmdual_D1 (R + 1) r' (GaloisField 2 f) =
      bmdual_D1 (R + 1) r' (GaloisField 2 f) := by
    have hconv1 := bmdual_eps_conj_noH n f (e := e) eidx hPP hPinvP hP hblock hconv hquad hquad'
      heps horth horth' hform
    have h1 : P * (1 - bmdualeps n f e) * Pinv =
        Matrix.reindex eidx eidx (bmdual_D1 (R + 1) r' (GaloisField 2 f)) := by
      rw [← hconv1, bmdual_conj_sandwich n f P Pinv hPP (Matrix.reindex eidx eidx (bmdual_D1 (R + 1)
          r' (GaloisField 2 f)))]
    have h0 : M' * Matrix.reindex eidx eidx (bmdual_D1 (R + 1) r' (GaloisField 2 f)) =
        Matrix.reindex eidx eidx (bmdual_D1 (R + 1) r' (GaloisField 2 f)) := by
      change (P * bmdual_gm n f g * Pinv) *
          Matrix.reindex eidx eidx (bmdual_D1 (R + 1) r' (GaloisField 2 f)) =
        Matrix.reindex eidx eidx (bmdual_D1 (R + 1) r' (GaloisField 2 f))
      rw [← h1, bmdual_conj_mul'' n f P Pinv hPinvP (bmdual_gm n f g) (1 - bmdualeps n f e), hgf]
    have h2 := congrArg (Matrix.reindex eidx.symm eidx.symm) h0
    nth_rewrite 1 [bmdual_reindex_mul] at h2
    rw [bmdual_reindex_comp_symm] at h2
    simpa only [M, bmdual_matOf, M'] using h2
  have hMsp : Matrix.transpose M *
      Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f)) * M =
      Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f)) := by
    have hiso : Matrix.transpose P * bmdualG n (GaloisField 2 f) * P =
        bmdualG n (GaloisField 2 f) :=
      bmdual_isometry_of_quad (bmdualQ n (GaloisField 2 f)) P hP
    have hsinv : Matrix.transpose Pinv * bmdualG n (GaloisField 2 f) * Pinv =
        bmdualG n (GaloisField 2 f) := by
      have h := congrArg (fun N => Matrix.transpose Pinv * N * Pinv) hiso
      have h1 : Matrix.transpose Pinv * (Matrix.transpose P * bmdualG n (GaloisField 2 f) * P) *
          Pinv = bmdualG n (GaloisField 2 f) := by
        rw [show Matrix.transpose Pinv * (Matrix.transpose P * bmdualG n (GaloisField 2 f) * P) *
              Pinv = (Matrix.transpose Pinv * Matrix.transpose P) * bmdualG n (GaloisField 2 f) *
                (P * Pinv) from by noncomm_ring,
          show Matrix.transpose Pinv * Matrix.transpose P = 1 from by
            rw [← Matrix.transpose_mul, hPP, Matrix.transpose_one], hPP]
        rw [Matrix.one_mul, Matrix.mul_one]
      rw [h1] at h
      exact h.symm
    have h1 : Matrix.transpose M' * bmdualG n (GaloisField 2 f) * M' =
        bmdualG n (GaloisField 2 f) := by
      change Matrix.transpose (P * bmdual_gm n f g * Pinv) * bmdualG n (GaloisField 2 f) *
          (P * bmdual_gm n f g * Pinv) = bmdualG n (GaloisField 2 f)
      rw [Matrix.transpose_mul, Matrix.transpose_mul]
      calc Matrix.transpose Pinv * (Matrix.transpose (bmdual_gm n f g) * Matrix.transpose P) *
            bmdualG n (GaloisField 2 f) * (P * bmdual_gm n f g * Pinv)
          = Matrix.transpose Pinv * (Matrix.transpose (bmdual_gm n f g) *
              (Matrix.transpose P * bmdualG n (GaloisField 2 f) * P) * bmdual_gm n f g) *
              Pinv := by noncomm_ring
        _ = Matrix.transpose Pinv * (Matrix.transpose (bmdual_gm n f g) *
              bmdualG n (GaloisField 2 f) * bmdual_gm n f g) * Pinv := by rw [hiso]
        _ = Matrix.transpose Pinv * bmdualG n (GaloisField 2 f) * Pinv := by rw [hgsp]
        _ = bmdualG n (GaloisField 2 f) := hsinv
    have h2 := congrArg (Matrix.reindex eidx.symm eidx.symm) h1
    nth_rewrite 1 [bmdual_reindex_mul] at h2
    nth_rewrite 1 [bmdual_reindex_mul] at h2
    rw [← bmdual_reindex_transpose] at h2
    simpa only [M, bmdual_matOf, M'] using h2
  obtain ⟨A, D, hAD⟩ := bmdual_block_diag_outer R r' (F := GaloisField 2 f) hM0
  have hD1 : D * Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) =
      Matrix.fromBlocks (0 : Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f))
      (0 : Matrix (Fin (R + 1)) (Fin r') (GaloisField 2 f))
      (0 : Matrix (Fin r') (Fin (R + 1)) (GaloisField 2 f))
      (1 : Matrix (Fin r') (Fin r') (GaloisField 2 f)) := by
    have h := hM1
    rw [hAD, bmdual_D1_eq R r' (GaloisField 2 f)] at h
    rw [Matrix.fromBlocks_multiply] at h
    simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add] at h
    rw [Matrix.fromBlocks_inj] at h
    exact h.2.2.2
  obtain ⟨E, G, hDE⟩ := bmdual_block_diag_inner R r' (F := GaloisField 2 f) hD1
  have hs : Matrix.transpose (Matrix.fromBlocks A 0 0 (Matrix.fromBlocks E 0 G 1)) *
      Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f)) *
      Matrix.fromBlocks A 0 0 (Matrix.fromBlocks E 0 G 1) =
      Matrix.reindex eidx.symm eidx.symm (bmdualG n (GaloisField 2 f)) := by
    rw [← hDE, ← hAD]
    exact hMsp
  obtain ⟨hAE, hG0⟩ := bmdual_block_symplectic n f R r' eidx hform hs
  have hAEt : Matrix.transpose E * A = 1 := by
    have h := congrArg Matrix.transpose hAE
    simpa [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.transpose_one] using h
  let a : GL (Fin (R + 1)) (GaloisField 2 f) :=
    (Units.mkOfMulEqOne (Matrix.transpose E) A hAEt)⁻¹
  refine ⟨a, ?_⟩
  change M = bmdual_glBlock f R r' a
  rw [hAD, hDE, hG0]
  unfold bmdual_glBlock
  rw [show ((a : GL (Fin (R + 1)) (GaloisField 2 f)) :
        Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = A from rfl,
    show (((a⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
        Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)) = Matrix.transpose E from rfl]
  rw [Matrix.transpose_transpose]

private theorem bmdual_block_of_mem_rank_zero
    (n f : ℕ) (hn : 3 ≤ n) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e))
    (hgen : bmdual_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualQ n (GaloisField 2 f)))}
    (hJe : IsComponentOf J' (bmdualrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hform : bmdual_IsFormStandard n f R r' eidx)
    (g : ↥(spinGroup (bmdualQ n (GaloisField 2 f))))
    (hg : g ∈ glBlockCentralizer (bmdualJ n (GaloisField 2 f)) S (bmdualeps n f e)) :
    ∃ a : GL (Fin (R + 1)) (GaloisField 2 f),
      bmdual_matOf n f R r' eidx P Pinv g = bmdual_glBlock f R r' a :=
  bmdual_block_of_mem n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock hconv hquad hquad'
    heps horth horth' hform g hg

private theorem bmdual_range_le_embedHom
    (n f : ℕ) (hn : 3 ≤ n) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e))
    (hgen : bmdual_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualQ n (GaloisField 2 f)))}
    (hJe : IsComponentOf J' (bmdualrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hform : bmdual_IsFormStandard n f R r' eidx) :
    bmdualrange n f S e ≤
      (bmdual_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range := by
  have getBlock : ∀ g ∈ glBlockCentralizer (bmdualJ n (GaloisField 2 f)) S (bmdualeps n f e),
      ∃ a : GL (Fin (R + 1)) (GaloisField 2 f),
        bmdual_matOf n f R r' eidx P Pinv g = bmdual_glBlock f R r' a :=
    fun g hg => by
      by_cases hR0 : R = 0
      · exact bmdual_block_of_mem_rank_zero n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP
          hblock hconv hquad hquad' heps horth horth' hform g hg
      · exact bmdual_block_of_mem n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock
          hconv hquad hquad' heps horth horth' hform g hg
  rw [show bmdualrange n f S e = ⁅glBlockCentralizer (bmdualJ n (GaloisField 2 f)) S
      (bmdualeps n f e), glBlockCentralizer (bmdualJ n (GaloisField 2 f)) S
      (bmdualeps n f e)⁆ from rfl, Subgroup.commutator_le]
  intro u hu v hv
  rw [commutatorElement_def]
  obtain ⟨au, hau⟩ := getBlock u hu
  obtain ⟨av, hav⟩ := getBlock v hv
  have hM : bmdual_matOf n f R r' eidx P Pinv (u * v * u⁻¹ * v⁻¹) =
      bmdual_glBlock f R r' (au * av * au⁻¹ * av⁻¹) := by
    rw [bmdual_matOf_mul n f R r' eidx P Pinv hPinvP,
      bmdual_matOf_mul n f R r' eidx P Pinv hPinvP,
      bmdual_matOf_mul n f R r' eidx P Pinv hPinvP,
      bmdual_matOf_inv n f R r' eidx P Pinv hPP hPinvP,
      bmdual_matOf_inv n f R r' eidx P Pinv hPP hPinvP,
      hau, hav]
    rw [← bmdual_glBlock_inv, ← bmdual_glBlock_inv, ← bmdual_glBlock_mul,
      ← bmdual_glBlock_mul, ← bmdual_glBlock_mul]
  have hdet_au : ((au : GL (Fin (R + 1)) (GaloisField 2 f)) :
      Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
      (((au⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
        Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det = 1 := by
    rw [← Matrix.det_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.det_one]
  have hdet_av : ((av : GL (Fin (R + 1)) (GaloisField 2 f)) :
      Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
      (((av⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
        Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det = 1 := by
    rw [← Matrix.det_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.det_one]
  have hdet : (((au * av * au⁻¹ * av⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
      Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det = 1 := by
    rw [Units.val_mul, Units.val_mul, Units.val_mul, Matrix.det_mul, Matrix.det_mul,
      Matrix.det_mul]
    calc ((au : GL (Fin (R + 1)) (GaloisField 2 f)) :
          Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
          ((av : GL (Fin (R + 1)) (GaloisField 2 f)) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
          (((au⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
          (((av⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
            Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det
        = (((au : GL (Fin (R + 1)) (GaloisField 2 f)) :
              Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
            (((au⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
              Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det) *
          (((av : GL (Fin (R + 1)) (GaloisField 2 f)) :
              Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det *
            (((av⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
              Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)).det) := by ring
      _ = 1 := by rw [hdet_au, hdet_av, mul_one]
  let x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) :=
    ⟨(((au * av * au⁻¹ * av⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f))) :
      Matrix (Fin (R + 1)) (Fin (R + 1)) (GaloisField 2 f)), hdet⟩
  refine ⟨x, ?_⟩
  apply bmdual_spinMatrix_injective n (GaloisField 2 f)
  change bmdualJ n (GaloisField 2 f)
      (Classical.choose (bmdual_embedGL_mem_spin n f R r' hn eidx hPP hPinvP hP hblock x)) =
    bmdualJ n (GaloisField 2 f) (u * v * u⁻¹ * v⁻¹)
  rw [bmdual_embedGL_choose_eq n f R r' hn eidx hPP hPinvP hP hblock x]
  apply Units.ext
  have hxgl : (x : GL (Fin (R + 1)) (GaloisField 2 f)) =
      (au * av * au⁻¹ * av⁻¹ : GL (Fin (R + 1)) (GaloisField 2 f)) := Units.ext rfl
  have hMw : bmdual_matOf n f R r' eidx P Pinv (u * v * u⁻¹ * v⁻¹) =
      bmdual_blockMat n f (R + 1) r' x := by
    rw [hM, ← hxgl, ← bmdual_blockMat_eq_glBlock]
  have hMw2 : P * bmdual_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv =
      Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) := by
    have h := congrArg (Matrix.reindex eidx eidx) hMw
    unfold bmdual_matOf at h
    change Matrix.reindex eidx.symm.symm eidx.symm.symm
      (Matrix.reindex eidx.symm eidx.symm
        (P * bmdual_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv)) =
      Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) at h
    rw [bmdual_reindex_comp_symm f eidx.symm
      (P * bmdual_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv)] at h
    exact h
  change ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualι n)
      (GaloisField 2 f)) : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) =
    bmdual_gm n f (u * v * u⁻¹ * v⁻¹)
  rw [show ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualι n)
      (GaloisField 2 f)) : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) =
      Pinv * Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) * P from rfl]
  calc Pinv * Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) * P
      = Pinv * (P * bmdual_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv) * P := by rw [← hMw2]
    _ = bmdual_gm n f (u * v * u⁻¹ * v⁻¹) := by
        rw [show Pinv * (P * bmdual_gm n f (u * v * u⁻¹ * v⁻¹) * Pinv) * P =
            (Pinv * P) * bmdual_gm n f (u * v * u⁻¹ * v⁻¹) * (Pinv * P) from by
          noncomm_ring, hPinvP]
        simp

private theorem bmdual_component_sl2_card_quot
    (n f : ℕ) (hn : 3 ≤ n) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e))
    (hgen : bmdual_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualQ n (GaloisField 2 f)))}
    (hJe : IsComponentOf J' (bmdualrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0) :
    60 ≤ Nat.card (J' ⧸ Subgroup.center J') := by
  haveI : Finite ↥(spinGroup (bmdualQ n (GaloisField 2 f))) :=
    Finite.of_injective (bmdualJ n (GaloisField 2 f))
      (bmdual_spinMatrix_injective n (GaloisField 2 f))
  haveI : Finite ↥J' := Subtype.finite
  have hq : CFSG.IsQuasisimple J' :=
    (CFSG.Foundations.SteinbergCA.quasisimple_iff J').2.1.mpr hJe.2.2
  exact CFSG.Quasithin.S146zW.sw_sixty_le_card_quot hq

private theorem bmdual_component_sl2_card_le
    (n f : ℕ) (hn : 3 ≤ n) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e))
    (hgen : bmdual_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualQ n (GaloisField 2 f)))}
    (hJe : IsComponentOf J' (bmdualrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hR : R + 1 = 2) :
    Nat.card (J' ⧸ Subgroup.center J') ≤ Nat.card (Matrix.SpecialLinearGroup (Fin 2)
      (GaloisField 2 f)) := by
  haveI : Finite ↥(spinGroup (bmdualQ n (GaloisField 2 f))) :=
    Finite.of_injective (bmdualJ n (GaloisField 2 f))
      (bmdual_spinMatrix_injective n (GaloisField 2 f))
  haveI : Finite ↥J' := Subtype.finite
  have hcomp : J' ≤ (bmdual_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range :=
    le_trans hJe.1 (bmdual_range_le_embedHom n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP
      hblock hconv hquad hquad' heps horth horth'
      (bmdual_formStandard_noH n f (e := e) eidx hPP hPinvP hP hblock hconv hquad hquad' heps
        horth horth' (by omega)))
  let φ : J' → Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f) :=
    fun x => (MonoidHom.mem_range.mp (hcomp x.2)).choose
  have hφ : Function.Injective φ := by
    intro x y hxy
    apply Subtype.ext
    have hx := (MonoidHom.mem_range.mp (hcomp x.2)).choose_spec
    have hy := (MonoidHom.mem_range.mp (hcomp y.2)).choose_spec
    rw [← hx, ← hy]
    exact congrArg _ hxy
  have h1 : Nat.card (J' ⧸ Subgroup.center J') ≤ Nat.card J' :=
    Nat.card_le_card_of_surjective (QuotientGroup.mk' (Subgroup.center J'))
      (QuotientGroup.mk'_surjective (Subgroup.center J'))
  have h2 : Nat.card J' ≤
      Nat.card (Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :=
    Nat.card_le_card_of_injective φ hφ
  rw [hR] at h2
  exact le_trans h1 h2

private theorem bmdual_component_sl2_card_field
    (n f : ℕ) (hn : 3 ≤ n) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e))
    (hgen : bmdual_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualQ n (GaloisField 2 f)))}
    (hJe : IsComponentOf J' (bmdualrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hR : R + 1 = 2) :
    4 ≤ Nat.card (GaloisField 2 f) := by
  have h60 := bmdual_component_sl2_card_quot n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP
    hblock hconv hquad hquad' heps horth horth'
  have hle := bmdual_component_sl2_card_le n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP
    hblock hconv hquad hquad' heps horth horth' hR
  have hcard : Nat.card (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 f)) =
      Nat.card (GaloisField 2 f) * (Nat.card (GaloisField 2 f) ^ 2 - 1) :=
    CFSG.RankThree.PartOne.KFOUT3.card_sl2 (GaloisField 2 f)
  set m := Nat.card (GaloisField 2 f) with hm
  have h60' : 60 ≤ m * (m ^ 2 - 1) := by
    calc 60 ≤ Nat.card (J' ⧸ Subgroup.center J') := h60
      _ ≤ Nat.card (Matrix.SpecialLinearGroup (Fin 2) (GaloisField 2 f)) := hle
      _ = m * (m ^ 2 - 1) := hcard
  have hpos : 0 < m := by rw [hm]; exact Nat.card_pos
  by_contra hlt
  push Not at hlt
  interval_cases m <;> omega

private theorem bmdual_component_sl2_card
    (n f : ℕ) (hn : 3 ≤ n) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e))
    (hgen : bmdual_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualQ n (GaloisField 2 f)))}
    (hJe : IsComponentOf J' (bmdualrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hR : R + 1 = 2) :
    (∃ s : Finset (GaloisField 2 f), s.card = 4) := by
  have h4 : 4 ≤ Nat.card (GaloisField 2 f) :=
    bmdual_component_sl2_card_field n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock
      hconv hquad hquad' heps horth horth' hR
  classical
  haveI : Fintype (GaloisField 2 f) := Fintype.ofFinite _
  obtain ⟨s, -, hs⟩ := Finset.exists_subset_card_eq (s := (Finset.univ : Finset (GaloisField 2 f)))
    (n := 4) (by simpa [Finset.card_univ, Nat.card_eq_fintype_card] using h4)
  exact ⟨s, hs⟩

private theorem bmdual_component_perfectSL
    (n f : ℕ) (hn : 3 ≤ n) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e))
    (hgen : bmdual_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualQ n (GaloisField 2 f)))}
    (hJe : IsComponentOf J' (bmdualrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0) :
    Group.IsPerfect (Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) := by
  rcases lt_or_ge (R + 1) 3 with hlt | hge
  · have hcases : R + 1 = 1 ∨ R + 1 = 2 := by omega
    rcases hcases with hR1 | hR2
    · haveI : Subsingleton (Fin (R + 1)) := Fin.subsingleton_iff_le_one.mpr (by omega)
      exact Group.IsPerfect.mk (Subsingleton.elim _ _)
    · obtain ⟨s, hs⟩ := bmdual_component_sl2_card n f hn S hS he hestar hgen hJe eidx hPP hPinvP
        hP hblock hconv hquad hquad' heps horth horth' hR2
      exact CFSG.LinearGroups.special_linear_isPerfect (K := GaloisField 2 f) (n := R + 1)
        (by omega) (Or.inr ⟨s, hs⟩)
  · exact CFSG.LinearGroups.special_linear_dimension_at_least_three_perfect
      (K := GaloisField 2 f) (n := R + 1) hge

private theorem bmdual_D1_eq_sub (r r' : ℕ) (F : Type) [Field F] :
    bmdual_D1 r r' F = 1 - bmdual_D0 r r' F - bmdual_D0s r r' F := by
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
    simp [bmdual_D1, bmdual_D0, bmdual_D0s, Matrix.fromBlocks, Matrix.one_apply, sub_eq_add_neg,
      add_comm, add_left_comm, add_assoc]

private theorem bmdual_embedGL_coe (n f R r' : ℕ)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualι n) (GaloisField 2 f)) :
        Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) =
      Pinv * Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) * P := rfl

private theorem bmdual_reindex_smul (f : ℕ) {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ] (e : ι ≃ κ) (c : GaloisField 2 f)
    (A : Matrix ι ι (GaloisField 2 f)) :
    Matrix.reindex e e (c • A) = c • Matrix.reindex e e A := by
  change (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) (c • A) =
    c • (Matrix.reindexAlgEquiv (GaloisField 2 f) (GaloisField 2 f) e) A
  rw [map_smul]

private theorem bmdual_D0_add_D0s_add_D1 (r r' : ℕ) (F : Type) [Semiring F] :
    bmdual_D0 r r' F + bmdual_D0s r r' F + bmdual_D1 r r' F = 1 := by
  ext i j
  rcases i with a | (b | c) <;> rcases j with a' | (b' | c') <;>
    simp [bmdual_D0, bmdual_D0s, bmdual_D1, Matrix.fromBlocks, Matrix.add_apply,
      Matrix.one_apply]

private theorem bmdual_D0_comm_blockMat (n f r r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmdual_D0 r r' (GaloisField 2 f) * bmdual_blockMat n f r r' x =
      bmdual_blockMat n f r r' x * bmdual_D0 r r' (GaloisField 2 f) := by
  unfold bmdual_D0 bmdual_blockMat
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp

private theorem bmdual_D0s_comm_blockMat (n f r r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmdual_D0s r r' (GaloisField 2 f) * bmdual_blockMat n f r r' x =
      bmdual_blockMat n f r r' x * bmdual_D0s r r' (GaloisField 2 f) := by
  unfold bmdual_D0s bmdual_blockMat
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [Matrix.fromBlocks_multiply, Matrix.fromBlocks_multiply]
