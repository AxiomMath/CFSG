      exact bmdual_modelHom_injective f R f (RingEquiv.refl (GaloisField 2 f))
        (bmdual_embedSpin_injective (k + 3) f R r' hn eidx hPP hPinvP hP hblock hxz)
    exact fun y hy => bmdual_mem_center_of_map_mem_center ι' hι'inj hy
  · rw [hJ'range, show ι' = (bmdual_embedHom (k + 3) f R r' hn eidx P Pinv hPP hPinvP hP
        hblock).comp (bmdual_modelHom f R f (RingEquiv.refl (GaloisField 2 f))) from rfl,
      bmdual_range_comp_eq_of_surjective
        (bmdual_embedHom (k + 3) f R r' hn eidx P Pinv hPP hPinvP hP hblock)
        (bmdual_modelHom f R f (RingEquiv.refl (GaloisField 2 f)))
        (bmdual_modelHom_surjective f R f (RingEquiv.refl (GaloisField 2 f)))]
