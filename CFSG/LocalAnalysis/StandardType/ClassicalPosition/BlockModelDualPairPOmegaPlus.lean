    (hform : bmdual_IsFormStandard n f R r' eidx) :
    bmdualrange n f S e =
      (bmdual_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range :=
  le_antisymm
    (bmdual_range_le_embedHom n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock hconv
      hquad hquad' heps horth horth' hform)
    (bmdual_embedHom_range_le n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock hconv
      hquad hquad' heps horth horth' hform)
private theorem bmdual_embedHom_injective (n f R r' : ℕ) (hn : 3 ≤ n)
