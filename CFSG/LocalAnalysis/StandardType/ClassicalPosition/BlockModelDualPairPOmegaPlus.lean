private theorem bmdual_blockMat_mul_D1 (n f r r' : ℕ)
    (x : Matrix.SpecialLinearGroup (Fin r) (GaloisField 2 f)) :
    bmdual_blockMat n f r r' x * bmdual_D1 r r' (GaloisField 2 f) =
      bmdual_D1 r r' (GaloisField 2 f) := by
  unfold bmdual_blockMat bmdual_D1
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add]
  rw [Matrix.fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, Matrix.mul_one,
    Matrix.one_mul]

private theorem bmdual_embedGL_fixes_compl (n f R r' : ℕ)
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hform : bmdual_IsFormStandard n f R r' eidx)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :
    ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualι n) (GaloisField 2 f)) :
        Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) * (1 - bmdualeps n f e) =
      1 - bmdualeps n f e := by
  rw [← bmdual_eps_conj_noH n f eidx hPP hPinvP hP hblock hconv hquad hquad' heps horth horth'
    hform]
  rw [bmdual_embedGL_coe n f R r' eidx hPP hPinvP x]
  change (Pinv * Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x) * P) *
      (Pinv * Matrix.reindex eidx eidx (bmdual_D1 (R + 1) r' (GaloisField 2 f)) * P) =
      Pinv * Matrix.reindex eidx eidx (bmdual_D1 (R + 1) r' (GaloisField 2 f)) * P
  rw [bmdual_conj_mul n f P Pinv hPP, ← bmdual_reindex_mul,
    bmdual_blockMat_mul_D1 n f (R + 1) r' x]

private theorem bmdual_embedGL_centralizes (n f R r' : ℕ)
    (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e))
    (hgen : bmdual_scalarAction n f S e)
    (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hform : bmdual_IsFormStandard n f R r' eidx)
    (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
    (s : GL (bmdualι n) (GaloisField 2 f)) (hs : s ∈ S) :
    (s : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) *
        ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualι n) (GaloisField 2 f)) :
          Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) =
      ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x : GL (bmdualι n) (GaloisField 2 f)) :
          Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) *
        (s : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) := by
  obtain ⟨c, hcne, hce, hce'⟩ := hgen s hs
  let sM : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f) :=
    (s : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f))
  change sM * ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x :
      GL (bmdualι n) (GaloisField 2 f)) :
        Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) =
    ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x :
      GL (bmdualι n) (GaloisField 2 f)) :
        Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) * sM
  have hceM : sM * e = c • e := hce
  have hceM' : sM * bmdualestar n f e = c⁻¹ • bmdualestar n f e := hce'
  have hsA : sM ∈ bmdualA n (GaloisField 2 f) S :=
    Algebra.subset_adjoin (Set.mem_image_of_mem Units.val hs)
  have hse : sM * e = e * sM := (bmdual_adjoin_comm hS sM hsA e he.1).eq
  have hse' : sM * bmdualestar n f e = bmdualestar n f e * sM :=
    (bmdual_adjoin_comm hS sM hsA (bmdualestar n f e) hestar.1).eq
  let T : Matrix (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r'))
      (Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r')) (GaloisField 2 f) :=
    Matrix.reindex eidx.symm eidx.symm (P * sM * Pinv)
  have hT_eq : Matrix.reindex eidx eidx T = P * sM * Pinv :=
    bmdual_reindex_comp_symm f eidx.symm (P * sM * Pinv)
  have hs_eq : sM = Pinv * Matrix.reindex eidx eidx T * P := by
    rw [hT_eq]
    calc sM = (Pinv * P) * sM * (Pinv * P) := by rw [hPinvP]; simp
      _ = Pinv * (P * sM * Pinv) * P := by noncomm_ring
  have hD0' : Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) = P * e * Pinv := by
    calc Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f))
        = (P * Pinv) * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) *
            (P * Pinv) := by rw [hPP]; simp
      _ = P * (Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P) *
            Pinv := by noncomm_ring
      _ = P * e * Pinv := by rw [hconv]
  have hD0s' : Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f)) =
      P * bmdualestar n f e * Pinv := by
    have hest := bmdual_estar_conj_noH n f eidx hPP hPinvP hP hblock hconv hquad hquad' heps
      horth horth' hform
    calc Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f))
        = (P * Pinv) * Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f)) *
            (P * Pinv) := by rw [hPP]; simp
      _ = P * (Pinv * Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f)) * P) *
            Pinv := by noncomm_ring
      _ = P * bmdualestar n f e * Pinv := by rw [← hest]
  have hT_D0 : T * bmdual_D0 (R + 1) r' (GaloisField 2 f) =
      c • bmdual_D0 (R + 1) r' (GaloisField 2 f) := by
    have hkey : Matrix.reindex eidx eidx (T * bmdual_D0 (R + 1) r' (GaloisField 2 f)) =
        c • Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) := by
      rw [bmdual_reindex_mul f eidx T (bmdual_D0 (R + 1) r' (GaloisField 2 f)), hT_eq, hD0']
      calc (P * sM * Pinv) * (P * e * Pinv) = P * (sM * e) * Pinv :=
            bmdual_conj_mul'' n f P Pinv hPinvP sM e
        _ = P * (c • e) * Pinv := by rw [hceM]
        _ = c • (P * e * Pinv) := by rw [Matrix.mul_smul, Matrix.smul_mul]
    have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hkey
    rw [bmdual_reindex_smul f eidx.symm c
        (Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f))),
      bmdual_reindex_comp_symm f eidx (T * bmdual_D0 (R + 1) r' (GaloisField 2 f)),
      bmdual_reindex_comp_symm f eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f))] at h
    exact h
  have hD0_T : bmdual_D0 (R + 1) r' (GaloisField 2 f) * T =
      c • bmdual_D0 (R + 1) r' (GaloisField 2 f) := by
    have hkey : Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f) * T) =
        c • Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) := by
      rw [bmdual_reindex_mul f eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) T, hT_eq, hD0']
      calc (P * e * Pinv) * (P * sM * Pinv) = P * (e * sM) * Pinv :=
            bmdual_conj_mul'' n f P Pinv hPinvP e sM
        _ = P * (sM * e) * Pinv := by rw [← hse]
        _ = P * (c • e) * Pinv := by rw [hceM]
        _ = c • (P * e * Pinv) := by rw [Matrix.mul_smul, Matrix.smul_mul]
    have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hkey
    rw [bmdual_reindex_smul f eidx.symm c
        (Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f))),
      bmdual_reindex_comp_symm f eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f) * T),
      bmdual_reindex_comp_symm f eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f))] at h
    exact h
  have hT_D0s : T * bmdual_D0s (R + 1) r' (GaloisField 2 f) =
      c⁻¹ • bmdual_D0s (R + 1) r' (GaloisField 2 f) := by
    have hkey : Matrix.reindex eidx eidx (T * bmdual_D0s (R + 1) r' (GaloisField 2 f)) =
        c⁻¹ • Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f)) := by
      rw [bmdual_reindex_mul f eidx T (bmdual_D0s (R + 1) r' (GaloisField 2 f)), hT_eq, hD0s']
      calc (P * sM * Pinv) * (P * bmdualestar n f e * Pinv) =
            P * (sM * bmdualestar n f e) * Pinv :=
            bmdual_conj_mul'' n f P Pinv hPinvP sM (bmdualestar n f e)
        _ = P * (c⁻¹ • bmdualestar n f e) * Pinv := by rw [hceM']
        _ = c⁻¹ • (P * bmdualestar n f e * Pinv) := by rw [Matrix.mul_smul, Matrix.smul_mul]
    have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hkey
    rw [bmdual_reindex_smul f eidx.symm (c⁻¹)
        (Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f))),
      bmdual_reindex_comp_symm f eidx (T * bmdual_D0s (R + 1) r' (GaloisField 2 f)),
      bmdual_reindex_comp_symm f eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f))] at h
    exact h
  have hD0s_T : bmdual_D0s (R + 1) r' (GaloisField 2 f) * T =
      c⁻¹ • bmdual_D0s (R + 1) r' (GaloisField 2 f) := by
    have hkey : Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f) * T) =
        c⁻¹ • Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f)) := by
      rw [bmdual_reindex_mul f eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f)) T, hT_eq, hD0s']
      calc (P * bmdualestar n f e * Pinv) * (P * sM * Pinv) =
            P * (bmdualestar n f e * sM) * Pinv :=
            bmdual_conj_mul'' n f P Pinv hPinvP (bmdualestar n f e) sM
        _ = P * (sM * bmdualestar n f e) * Pinv := by rw [← hse']
        _ = P * (c⁻¹ • bmdualestar n f e) * Pinv := by rw [hceM']
        _ = c⁻¹ • (P * bmdualestar n f e * Pinv) := by rw [Matrix.mul_smul, Matrix.smul_mul]
    have h := congrArg (Matrix.reindex eidx.symm eidx.symm) hkey
    rw [bmdual_reindex_smul f eidx.symm (c⁻¹)
        (Matrix.reindex eidx eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f))),
      bmdual_reindex_comp_symm f eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f) * T),
      bmdual_reindex_comp_symm f eidx (bmdual_D0s (R + 1) r' (GaloisField 2 f))] at h
    exact h
  have hT_decomp : T = c • bmdual_D0 (R + 1) r' (GaloisField 2 f) +
      c⁻¹ • bmdual_D0s (R + 1) r' (GaloisField 2 f) +
      T * bmdual_D1 (R + 1) r' (GaloisField 2 f) := by
    calc T = T * 1 := (Matrix.mul_one T).symm
      _ = T * (bmdual_D0 (R + 1) r' (GaloisField 2 f) +
            bmdual_D0s (R + 1) r' (GaloisField 2 f) +
            bmdual_D1 (R + 1) r' (GaloisField 2 f)) := by
            rw [bmdual_D0_add_D0s_add_D1 (R + 1) r' (GaloisField 2 f)]
      _ = T * bmdual_D0 (R + 1) r' (GaloisField 2 f) +
            T * bmdual_D0s (R + 1) r' (GaloisField 2 f) +
            T * bmdual_D1 (R + 1) r' (GaloisField 2 f) := by
            rw [Matrix.mul_add, Matrix.mul_add]
      _ = c • bmdual_D0 (R + 1) r' (GaloisField 2 f) +
            c⁻¹ • bmdual_D0s (R + 1) r' (GaloisField 2 f) +
            T * bmdual_D1 (R + 1) r' (GaloisField 2 f) := by rw [hT_D0, hT_D0s]
  have hT_D1_comm : T * bmdual_D1 (R + 1) r' (GaloisField 2 f) =
      bmdual_D1 (R + 1) r' (GaloisField 2 f) * T := by
    have h1 : T * bmdual_D1 (R + 1) r' (GaloisField 2 f) =
        T - c • bmdual_D0 (R + 1) r' (GaloisField 2 f) -
          c⁻¹ • bmdual_D0s (R + 1) r' (GaloisField 2 f) := by
      rw [bmdual_D1_eq_sub (R + 1) r' (GaloisField 2 f), Matrix.mul_sub, Matrix.mul_sub,
        Matrix.mul_one, hT_D0, hT_D0s]
    have h2 : bmdual_D1 (R + 1) r' (GaloisField 2 f) * T =
        T - c • bmdual_D0 (R + 1) r' (GaloisField 2 f) -
          c⁻¹ • bmdual_D0s (R + 1) r' (GaloisField 2 f) := by
      rw [bmdual_D1_eq_sub (R + 1) r' (GaloisField 2 f), Matrix.sub_mul, Matrix.sub_mul,
        Matrix.one_mul, hD0_T, hD0s_T]
    rw [h1, h2]
  have hThird : (T * bmdual_D1 (R + 1) r' (GaloisField 2 f)) *
        bmdual_blockMat n f (R + 1) r' x =
      bmdual_blockMat n f (R + 1) r' x *
        (T * bmdual_D1 (R + 1) r' (GaloisField 2 f)) := by
    rw [Matrix.mul_assoc, bmdual_D1_mul_blockMat, hT_D1_comm, ← Matrix.mul_assoc,
      bmdual_blockMat_mul_D1]
  have hTB : T * bmdual_blockMat n f (R + 1) r' x =
      bmdual_blockMat n f (R + 1) r' x * T := by
    rw [hT_decomp, Matrix.add_mul, Matrix.add_mul, Matrix.smul_mul, Matrix.smul_mul,
      Matrix.mul_add, Matrix.mul_add, Matrix.mul_smul, Matrix.mul_smul,
      bmdual_D0_comm_blockMat, bmdual_D0s_comm_blockMat, hThird]
  have hfin : sM * ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x :
      GL (bmdualι n) (GaloisField 2 f)) :
        Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) =
      Pinv * Matrix.reindex eidx eidx (T * bmdual_blockMat n f (R + 1) r' x) * P := by
    rw [hs_eq, bmdual_embedGL_coe n f R r' eidx hPP hPinvP x]
    rw [bmdual_conj_mul n f P Pinv hPP,
      ← bmdual_reindex_mul f eidx T (bmdual_blockMat n f (R + 1) r' x)]
  have hfin' : ((bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x :
      GL (bmdualι n) (GaloisField 2 f)) :
        Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)) * sM =
      Pinv * Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x * T) * P := by
    rw [hs_eq, bmdual_embedGL_coe n f R r' eidx hPP hPinvP x]
    rw [bmdual_conj_mul n f P Pinv hPP,
      ← bmdual_reindex_mul f eidx (bmdual_blockMat n f (R + 1) r' x) T]
  rw [hfin, hfin', hTB]

private theorem bmdual_embedHom_range_le_centralizer
    (n f : ℕ) (hn : 3 ≤ n) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e))
    (hgen : bmdual_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualQ n (GaloisField 2 f)))}
    (hJe : IsComponentOf J' (bmdualrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hform : bmdual_IsFormStandard n f R r' eidx) :
    (bmdual_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range ≤
      glBlockCentralizer (bmdualJ n (GaloisField 2 f)) S (bmdualeps n f e) := by
  rintro y ⟨x, rfl⟩
  have hjy : bmdualJ n (GaloisField 2 f)
        (bmdual_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock x) =
      bmdual_embedGL n f R r' eidx P Pinv hPP hPinvP x :=
    Units.ext (bmdual_embedSpin_spinMatrix n f R r' hn eidx hPP hPinvP hP hblock x)
  rw [glBlockCentralizer, Subgroup.mem_comap, Subgroup.mem_inf]
  constructor
  · rw [Subgroup.mem_centralizer_iff]
    intro s hs
    apply Units.ext
    rw [hjy]
    exact bmdual_embedGL_centralizes n f R r' S hS he hestar hgen eidx hPP hPinvP hP hblock hconv
      hquad hquad' heps horth horth' hform x s hs
  · rw [hjy]
    exact bmdual_embedGL_fixes_compl n f R r' eidx hPP hPinvP hP hblock hconv hquad hquad' heps
      horth horth' hform x

private theorem bmdual_embedHom_range_le
    (n f : ℕ) (hn : 3 ≤ n) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (he : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) e)
    (hestar : IsPrimIdemIn (bmdualA n (GaloisField 2 f) S) (bmdualestar n f e))
    (hgen : bmdual_scalarAction n f S e)
    {J' : Subgroup ↥(spinGroup (bmdualQ n (GaloisField 2 f)))}
    (hJe : IsComponentOf J' (bmdualrange n f S e))
    {R r' : ℕ} (eidx : Fin (R + 1) ⊕ (Fin (R + 1) ⊕ Fin r') ≃ bmdualι n)
    {P Pinv : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
    (hPP : P * Pinv = 1) (hPinvP : Pinv * P = 1)
    (hP : ∀ v : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec P v) = bmdualQ n (GaloisField 2 f) v)
    (hblock : ∀ (x : Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f))
      (w : bmdualι n → GaloisField 2 f),
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec
        (Matrix.reindex eidx eidx (bmdual_blockMat n f (R + 1) r' x)) w) =
        bmdualQ n (GaloisField 2 f) w)
    (hconv : Pinv * Matrix.reindex eidx eidx (bmdual_D0 (R + 1) r' (GaloisField 2 f)) * P = e)
    (hquad : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec e x) = 0)
    (hquad' : ∀ x : bmdualι n → GaloisField 2 f,
      bmdualQ n (GaloisField 2 f) (Matrix.mulVec (bmdualestar n f e) x) = 0)
    (heps : IsIdempotentElem (bmdualeps n f e))
    (horth : e * bmdualestar n f e = 0) (horth' : bmdualestar n f e * e = 0)
    (hform : bmdual_IsFormStandard n f R r' eidx) :
    (bmdual_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range ≤ bmdualrange n f S e := by
  haveI : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin (R + 1)) (GaloisField 2 f)) :=
    bmdual_component_perfectSL n f hn S hS he hestar hgen hJe eidx hPP hPinvP hP hblock hconv
      hquad hquad' heps horth horth'
  haveI : Group.IsPerfect (bmdual_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range :=
    Group.IsPerfect.ofSurjective
      (f := (bmdual_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).rangeRestrict)
      (bmdual_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).rangeRestrict_surjective
  have hcent := bmdual_embedHom_range_le_centralizer n f hn S hS he hestar hgen hJe eidx hPP
    hPinvP hP hblock hconv hquad hquad' heps horth horth' hform
  calc (bmdual_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range
      = ⁅(bmdual_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range,
          (bmdual_embedHom n f R r' hn eidx P Pinv hPP hPinvP hP hblock).range⁆ :=
        (Subgroup.commutator_eq_self).symm
    _ ≤ ⁅glBlockCentralizer (bmdualJ n (GaloisField 2 f)) S (bmdualeps n f e),
          glBlockCentralizer (bmdualJ n (GaloisField 2 f)) S (bmdualeps n f e)⁆ :=
        Subgroup.commutator_mono hcent hcent
    _ = bmdualrange n f S e := rfl

private theorem bmdual_embedHom_range_eq
    (n f : ℕ) (hn : 3 ≤ n) (S : Set (GL (bmdualι n) (GaloisField 2 f)))
    (hS : ∀ s ∈ S, ∀ s' ∈ S, Commute s s')
    {e : Matrix (bmdualι n) (bmdualι n) (GaloisField 2 f)}
