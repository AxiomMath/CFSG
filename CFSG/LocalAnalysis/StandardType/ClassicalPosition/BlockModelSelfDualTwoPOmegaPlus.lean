private lemma bmstp_hnd (k f : ℕ) :
    (QuadraticMap.polarBilin (Spin.quadPlus (k + 3) (GaloisField 2 f))).Nondegenerate :=
  Spin.nondegenerate_polarBilin_quadPlus (k + 3) (GaloisField 2 f)

private lemma bmstp_hinj (k f : ℕ) : Function.Injective (Spin.spinMatrix (Spin.quadPlus (k + 3)
    (GaloisField 2 f))) := by
  have hker : (Spin.spinMatrix (Spin.quadPlus (k + 3) (GaloisField 2 f))).ker = ⊥ :=
    Spin.ker_spinMatrix_quadPlus_eq_bot (K := GaloisField 2 f) (n := k + 3)
      (CharP.cast_eq_zero (GaloisField 2 f) 2)
  exact (MonoidHom.ker_eq_bot_iff _).mp hker

theorem range_spinAction_quadPlus_eq_omegaGroup (k f : ℕ) :
    (Spin.spinAction (Spin.quadPlus (k + 3) (GaloisField 2 f))).range =
      CFSG.RankThree.OrthogonalInvolutions.omegaGroup (Spin.quadPlus (k + 3) (GaloisField 2 f))
          (Spin.nondegenerate_polarBilin_quadPlus (k + 3) (GaloisField 2 f)) := by
  apply le_antisymm
  · rw [Spin.range_spinAction_quadPlus (n := k + 3) (K := GaloisField 2 f) (by omega)]
    exact CFSG.ClassicalGroups.Orthogonal.elementaryGroup_le_omegaGroup
      (Q := Spin.quadPlus (k + 3) (GaloisField 2 f)) (bmstp_hnd k f)
  · intro g hg
    exact MonoidHom.mem_range.mpr
      (CFSG.StandardType.GGOppRadOmega.exists_spinAction_eq_of_mem_omegaGroup_plus
        (K := GaloisField 2 f) (by omega) hg)

private lemma bmstp_hcent (k f : ℕ) :
    Subgroup.center ↥(spinGroup (Spin.quadPlus (k + 3) (GaloisField 2 f))) = ⊥ := by
  exact CFSG.SeitzReduction.SymplecticPilot.q2Omega_center_spinGroup_quadPlus_eq_bot (by omega)

private lemma bmstp_gram (k f : ℕ) :
    (LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (Spin.quadPlus (k + 3)
        (GaloisField 2 f)))) = (Matrix.fromBlocks 0 1 (-1) 0 : Matrix (Fin (k + 3) ⊕ Fin (k + 3))
            (Fin (k + 3) ⊕ Fin (k + 3)) (GaloisField 2 f)) := by
  ext i j
  rw [LinearMap.toMatrix₂'_apply, QuadraticMap.polarBilin_apply_apply,
    CFSG.StandardType.GGOppRadOmega.polar_quadPlus_eq_spForm, CFSG.LieType.BorelTits.spForm_β,
    single_dotProduct, one_mul, Matrix.mulVec_single]
  simp

private lemma bmstp_hH (k f : ℕ) (A : GL (Fin (k + 3) ⊕ Fin (k + 3)) (GaloisField 2 f)) :
    A ∈ CFSG.Open.StatedSp (k + 3) (GaloisField 2 f) ↔
      Matrix.transpose (A : Matrix (Fin (k + 3) ⊕ Fin (k + 3)) (Fin (k + 3) ⊕ Fin (k + 3))
          (GaloisField 2 f)) *
        (LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (Spin.quadPlus (k + 3)
            (GaloisField 2 f)))) * (A : Matrix (Fin (k + 3) ⊕ Fin (k + 3)) (Fin (k + 3) ⊕ Fin (k +
                3)) (GaloisField 2 f)) =
        (LinearMap.toMatrix₂' (GaloisField 2 f) (QuadraticMap.polarBilin (Spin.quadPlus (k + 3)
            (GaloisField 2 f)))) := by
  rw [CFSG.Open.StatedAPI.mem_statedSp_iff, bmstp_gram k f]

