private lemma ltrb1r1_kacRow_type_of_tag {lab : LargeEvenLabel} {p : ℕ} (row : KacRow lab p)
    (htag : lab.tag = .E6) : row.T = .E6 ∧ row.tw = false := by
  have h := row.type_eq
  unfold ggKacTypeOfLabel at h
  rw [htag] at h
  simp only [Option.some.injEq, Prod.mk.injEq] at h
  exact ⟨h.1.symm, h.2.symm⟩

private lemma ltrb1r1_kacRow_type_of_tag_tw {lab : LargeEvenLabel} {p : ℕ} (row : KacRow lab p)
    (htag : lab.tag = .twE6) : row.T = .E6 ∧ row.tw = true := by
  have h := row.type_eq
  unfold ggKacTypeOfLabel at h
  rw [htag] at h
  simp only [Option.some.injEq, Prod.mk.injEq] at h
  exact ⟨h.1.symm, h.2.symm⟩

private lemma ltrb1r1_not_dvd_sub_one_of_dvd_add_one {n : ℕ} (h : 3 ∣ 2 ^ n + 1) :
    ¬ 3 ∣ 2 ^ n - 1 := by
  intro h'
  have hpos : 1 ≤ 2 ^ n := Nat.one_le_two_pow
  have h2 : 3 ∣ (2 ^ n + 1) - (2 ^ n - 1) := Nat.dvd_sub h h'
  have heq : (2 ^ n + 1) - (2 ^ n - 1) = 2 := by omega
  rw [heq] at h2
  obtain ⟨c, hc⟩ := h2
  omega

private lemma ltrb1r1_not_dvd_add_one_of_dvd_sub_one {n : ℕ} (h : 3 ∣ 2 ^ n - 1) :
    ¬ 3 ∣ 2 ^ n + 1 := by
  intro h'
  have hpos : 1 ≤ 2 ^ n := Nat.one_le_two_pow
  have h2 : 3 ∣ (2 ^ n + 1) - (2 ^ n - 1) := Nat.dvd_sub h' h
  have heq : (2 ^ n + 1) - (2 ^ n - 1) = 2 := by omega
  rw [heq] at h2
  obtain ⟨c, hc⟩ := h2
  omega

private lemma ltrb1r1_closure_rootDiagUnit_e6 (Omega : Type) [Field Omega] [IsAlgClosed Omega]
    [CharP Omega 2] :
    Subgroup.closure (Set.range (fun b : Fin Tag.E6.rank → Omegaˣ =>
      rootDiagUnit Tag.E6 b)) = torusGroup Tag.E6 Omega := by
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    rintro _ ⟨b, rfl⟩
    exact rootDiagUnit_mem_torusGroup (τ := Tag.E6) b
  · intro g hg
    obtain ⟨l, rfl⟩ := exists_rootDiagUnit_eq_of_mem_torusGroup (τ := Tag.E6) hg
    exact Subgroup.subset_closure ⟨l, rfl⟩

private lemma ltrb1r1_mem_connectedCentralizer
    {Omega : Type} [Field Omega] [IsAlgClosed Omega] [CharP Omega 2]
    {lab : LargeEvenLabel} {R : Type} [Group R] {I : Set (MulAut R)} {phi : MulAut R}
    (ρ : MarkedRationalKacRealization Omega lab 3 R I phi)
    {j : Fin ρ.row.D.orbits.length}
    (hrow : GGE6ThreeR16OppLabels1585 lab ρ.row.D.orbits[j].lab)
    {y : ModGL ρ.tau Omega}
    (hyG : y ∈ geomCentralizer ρ) (hyM : y ∈ ρ.setup.D.model) :
    y ∈ connectedCentralizer ρ := by
  rcases ρ with ⟨row, tau, tau_eq, setup, q_eq, fr, fr_eq, phi_split, phi_twisted,
    _iota, _iota_inj, _iota_range, _modelAction, _modelAction_inj, _modelAction_range,
    _modelAction_compat, a, a_pow, a_torus, _a_model, _a_ne, _action_eq, _zeta, _zeta_order,
    _nodeMap, _nodeMap_surj, _nodeMap_ker, _node_isRoot, _node_eval, _kernel_span_eq,
    _epsilon, _epsilon_eq, _frobLinear, _frob_roots, _frob_nodes, _repr, _orbitNodes,
    _orbitNodes_perm, _orbit_descriptor, _repr_roots, _orbit_cover, _orbit_distinct,
    _orbit_length, _field_exp, _qs, _label, _solvable, _a12_model, _model_equivariance,
    _a12_invariant, _saturated, _saturated_mem, _saturated_frob, _centralTorus,
    _centralTorus_mem, _torusStep, _torusStep_diag, _torusStep_char, _centred⟩
  rcases hrow with ⟨hdisj, _⟩
  have hrowT : row.T = .E6 := by
    rcases hdisj with ⟨ht, _⟩ | ⟨ht, _⟩
    · exact (ltrb1r1_kacRow_type_of_tag row ht).1
    · exact (ltrb1r1_kacRow_type_of_tag_tw row ht).1
  have htau : tau = Tag.E6 := by
    rw [← tau_eq, hrowT]
    rfl
  subst htau
  have hyT : y ∈ toralCentralizer Tag.E6 Omega a := by
    simpa only [toralCentralizer, geomCentralizer] using hyG
  have hyF : setup.D.step y = y := by
    have hy := (LangDatum.mem_model (D := setup.D)).1 hyM
    simpa [LangDatum.step, MulAut.conj_apply] using hy.2
  have hclosure := ltrb1r1_closure_rootDiagUnit_e6 Omega
  rcases hdisj with ⟨htagE6, h3sum⟩ | ⟨htagTw, h3sub⟩
  · have htw : row.tw = false := (ltrb1r1_kacRow_type_of_tag row htagE6).2
    have hq3 : ¬ 3 ∣ setup.D.q - 1 := by
      rw [q_eq]
      exact ltrb1r1_not_dvd_sub_one_of_dvd_add_one h3sum
    have huntw : ∃ Fr : Omega →+* Omega, (∀ c, Fr c = c ^ setup.D.q) ∧
        setup.D.Φ = Units.map (entrywiseHom Fr) := by
      refine ⟨fr, ?_, ?_⟩
      · intro c; rw [fr_eq, q_eq]
      · exact MonoidHom.ext (phi_split htw)
    have hyH : y ∈ torusGroup Tag.E6 Omega ⊔ rootSpan Tag.E6 Omega
        (kernelRoots (rootCharHom a)) :=
      CFSG.LocalAnalysis.GLTheoremA.T171Sh.e6CentralizerConnOdd_untw_holds
        (L := Omega) (p₀ := 5) (S := setup) huntw hq3 a a_torus a_pow y hyT hyF
    change y ∈ Subgroup.closure (Set.range (fun b : Fin Tag.E6.rank → Omegaˣ =>
      rootDiagUnit Tag.E6 b)) ⊔ rootSpan Tag.E6 Omega (kernelRoots (rootCharHom a))
    rw [hclosure]
    exact hyH
  · have htw : row.tw = true := (ltrb1r1_kacRow_type_of_tag_tw row htagTw).2
    have hq3 : ¬ 3 ∣ setup.D.q + 1 := by
      rw [q_eq]
      exact ltrb1r1_not_dvd_add_one_of_dvd_sub_one h3sub
    have htwisted : ∃ Fr : Omega →+* Omega, (∀ c, Fr c = c ^ setup.D.q) ∧
        setup.D.Φ = twistHom TwistTag.E6 Omega Fr := by
      refine ⟨fr, ?_, ?_⟩
      · intro c; rw [fr_eq, q_eq]
      · obtain ⟨ht, hhtt⟩ := phi_twisted htw
        have hdiag : diagramAt Tag.E6 Omega TwistTag.E6 ht =
            (diagramMap TwistTag.E6 Omega : ModGL Tag.E6 Omega) := by
          cases ht
          rfl
        apply MonoidHom.ext
        intro g
        rw [hhtt g, hdiag]
        rfl
    have hyH : y ∈ torusGroup Tag.E6 Omega ⊔ rootSpan Tag.E6 Omega
        (kernelRoots (rootCharHom a)) :=
      CFSG.LocalAnalysis.GLTheoremA.T171Sh.twE6CentralizerConnOdd_holds
        (L := Omega) (p₀ := 5) (S := setup) htwisted hq3 a a_torus a_pow y hyT hyF
    change y ∈ Subgroup.closure (Set.range (fun b : Fin Tag.E6.rank → Omegaˣ =>
      rootDiagUnit Tag.E6 b)) ⊔ rootSpan Tag.E6 Omega (kernelRoots (rootCharHom a))
    rw [hclosure]
    exact hyH

theorem b1RatOn_r16Opp_holds
    (Omega : Type) [Field Omega] [IsAlgClosed Omega] [CharP Omega 2] :
    B1RatOn Omega GGE6ThreeR16OppLabels1585 1 := by
  unfold B1RatOn
  intro lab R _ I phi ρ j hΛ hj hqs hrow
  have hC : centralizerGroup ρ =
      ((geomCentralizer ρ ⊓ ρ.setup.D.model).subgroupOf ρ.setup.D.model).map ρ.modelAction :=
    ((b1aOn_holds Omega) lab R I phi ρ j hΛ hj hqs).1
  have hle : centralizerGroup ρ ≤ conn ρ := by
    rw [hC, conn]
    apply Subgroup.map_mono
    intro x hx
    rw [Subgroup.mem_subgroupOf] at hx ⊢
    exact ⟨ltrb1r1_mem_connectedCentralizer ρ hrow hx.1 hx.2, hx.2⟩
  exact Subgroup.relIndex_eq_one.mpr hle

