private theorem label_zero {τ : Tag} (K : KacData τ) : K.label 0 = 1 := by
  have hidx0 : idxNode (r := τ.rank) 0 = none := by
    rw [idxNode, dif_neg (by omega)]
  unfold KacData.label
  rw [hidx0]

private theorem label_succ {τ : Tag} (K : KacData τ) (j : Fin τ.rank) :
    K.label ((j : ℕ) + 1) = K.θ j := by
  have hidx : idxNode (r := τ.rank) ((j : ℕ) + 1) = some j := by
    rw [idxNode, dif_pos ⟨by omega, by simpa using j.2⟩]
    apply congrArg some
    apply Fin.ext
    simp only [Fin.val_mk]
    omega
  unfold KacData.label
  rw [hidx]

private theorem label_sum_le_int {τ : Tag} (K : KacData τ) (hK : K.Facts) (lab : ℕ → ℕ)
    (hlab : ∀ i < τ.rank + 1, (lab i : ℤ) = K.label i)
    {p : ℕ} {μ : Fin τ.rank → ℤ} (hμ : K.IsNormal p μ) :
    ((((List.range (τ.rank + 1)).filter fun i => !(K.zeroIdx p μ).elem i).map lab).sum : ℤ) ≤
      p := by
  classical
  have hmem0 : (0 ∈ K.zeroIdx p μ) ↔ K.θ ⬝ᵥ μ = p := by
    rw [K.mem_zeroIdx]
    exact ⟨fun h => h.2, fun h => ⟨by omega, h⟩⟩
  have hidx : ∀ j : Fin τ.rank, idxNode (r := τ.rank) ((j : ℕ) + 1) = some j := by
    intro j
    rw [idxNode, dif_pos ⟨by omega, by simpa using j.2⟩]
    apply congrArg some
    apply Fin.ext
    simp only [Fin.val_mk]
    omega
  have hmemj : ∀ j : Fin τ.rank, ((j : ℕ) + 1 ∈ K.zeroIdx p μ) ↔ μ j = 0 := by
    intro j
    rw [K.mem_zeroIdx, hidx j]
    exact ⟨fun h => h.2, fun h => ⟨by have := j.2; omega, h⟩⟩
  have hnodup : ((List.range (τ.rank + 1)).filter
      (fun i => !(K.zeroIdx p μ).elem i)).Nodup :=
    (List.nodup_range).filter (fun i => !(K.zeroIdx p μ).elem i)
  have hsum1 : ((((List.range (τ.rank + 1)).filter fun i => !(K.zeroIdx p μ).elem i).map lab).sum :
        ℤ) = ∑ i ∈ Finset.range (τ.rank + 1),
          if i ∈ K.zeroIdx p μ then 0 else K.label i := by
    rw [← List.sum_toFinset lab hnodup]
    rw [List.toFinset_filter, List.toFinset_range]
    push_cast
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl fun i hi => ?_
    have hilt : i < τ.rank + 1 := Finset.mem_range.1 hi
    by_cases h : i ∈ K.zeroIdx p μ
    · have he : (K.zeroIdx p μ).elem i = true := by simp [List.elem_eq_mem, h]
      simp [he, h]
    · have he : (K.zeroIdx p μ).elem i = false := by simp [List.elem_eq_mem, h]
      simp [he, h, hlab i hilt]
  have hf0 : (if (0 : ℕ) ∈ K.zeroIdx p μ then (0 : ℤ) else K.label 0) ≤
      (p : ℤ) - K.θ ⬝ᵥ μ := by
    by_cases h : 0 ∈ K.zeroIdx p μ
    · rw [if_pos h, hmem0.1 h]
      omega
    · rw [if_neg h]
      have hne : K.θ ⬝ᵥ μ ≠ p := fun hp => h (hmem0.2 hp)
      have hlt : K.θ ⬝ᵥ μ < (p : ℤ) := lt_of_le_of_ne hμ.2 hne
      rw [label_zero K]
      omega
  have hfk : ∀ k : Fin τ.rank,
      (if ((k : ℕ) + 1) ∈ K.zeroIdx p μ then (0 : ℤ) else K.label ((k : ℕ) + 1)) ≤
        K.θ k * μ k := by
    intro k
    by_cases h : ((k : ℕ) + 1) ∈ K.zeroIdx p μ
    · rw [if_pos h, (hmemj k).1 h, mul_zero]
    · rw [if_neg h]
      have hne : μ k ≠ 0 := fun h0 => h ((hmemj k).2 h0)
      have hμk : (1 : ℤ) ≤ μ k := by have := hμ.1 k; omega
      have hθk : 0 < K.θ k := hK.θ_pos k
      rw [label_succ K k]
      calc K.θ k = K.θ k * 1 := by ring
        _ ≤ K.θ k * μ k := mul_le_mul_of_nonneg_left hμk (le_of_lt hθk)
  have hmain : (∑ i ∈ Finset.range (τ.rank + 1),
        if i ∈ K.zeroIdx p μ then (0 : ℤ) else K.label i) ≤ p := by
    rw [Finset.sum_range_succ']
    rw [← Fin.sum_univ_eq_sum_range
      (fun k : ℕ => if k + 1 ∈ K.zeroIdx p μ then (0 : ℤ) else K.label (k + 1)) τ.rank]
    have hdot : K.θ ⬝ᵥ μ = ∑ k : Fin τ.rank, K.θ k * μ k := rfl
    calc _ ≤ (∑ k : Fin τ.rank, K.θ k * μ k) + ((p : ℤ) - K.θ ⬝ᵥ μ) :=
          add_le_add (Finset.sum_le_sum fun k _ => hfk k) hf0
      _ = p := by rw [hdot]; ring
  rw [hsum1]
  exact hmain

private theorem label_sum_le {τ : Tag} (K : KacData τ) (hK : K.Facts) (lab : ℕ → ℕ)
    (hlab : ∀ i < τ.rank + 1, (lab i : ℤ) = K.label i)
    {p : ℕ} {μ : Fin τ.rank → ℤ} (hμ : K.IsNormal p μ) :
    (((List.range (τ.rank + 1)).filter fun i => !(K.zeroIdx p μ).elem i).map lab).sum ≤ p := by
  exact_mod_cast label_sum_le_int K hK lab hlab hμ

private theorem comp_eq_compIdx_toFinset {τ : Tag}
    (K : KacData τ) {E : List (ℕ × ℕ)} {tp : ℕ → ℕ → List ℕ}
    (hT : IsTreePaths (τ.rank + 1) E tp)
    (hE : ∀ x y : Option (Fin τ.rank), K.Adj x y ↔ (nodeIdx x, nodeIdx y) ∈ E)
    {p : ℕ} {μ : Fin τ.rank → ℤ} {x : Option (Fin τ.rank)} (hx : K.IsZ p μ x) :
    K.comp p μ x = ((compIdx (τ.rank + 1) tp (K.zeroIdx p μ) (nodeIdx x)).map
      (idxNode (r := τ.rank))).toFinset := by
  rw [K.comp_eq_compIdx hT hE hx]
  ext y
  rw [Set.mem_setOf_eq, Finset.mem_coe, List.mem_toFinset, List.mem_map]
  constructor
  · intro hy
    exact ⟨nodeIdx y, hy, idxNode_nodeIdx y⟩
  · rintro ⟨i, hi, rfl⟩
    have hlt : i < τ.rank + 1 := by
      have hmem : i ∈ List.range (τ.rank + 1) := List.mem_of_mem_filter hi
      exact List.mem_range.1 hmem
    rwa [nodeIdx_idxNode hlt]

private theorem comp_eq_compIdx_idxNode {τ : Tag}
    (K : KacData τ) {E : List (ℕ × ℕ)} {tp : ℕ → ℕ → List ℕ}
    (hT : IsTreePaths (τ.rank + 1) E tp)
    (hE : ∀ x y : Option (Fin τ.rank), K.Adj x y ↔ (nodeIdx x, nodeIdx y) ∈ E)
    {p : ℕ} {μ : Fin τ.rank → ℤ} {i : ℕ} (hi : i < τ.rank + 1)
    (hz : K.IsZ p μ (idxNode (r := τ.rank) i)) :
    K.comp p μ (idxNode (r := τ.rank) i) =
      ((compIdx (τ.rank + 1) tp (K.zeroIdx p μ) i).map (idxNode (r := τ.rank))).toFinset := by
  have h := comp_eq_compIdx_toFinset K hT hE (x := idxNode (r := τ.rank) i) hz
  simpa only [nodeIdx_idxNode hi] using h

private theorem componentRoots_extRoot_eq {τ : Tag}
    (K : KacData τ) (hK : K.Facts) {M : Type*} [CommGroup M]
    {p : ℕ} (hp : 0 < p) {μ : Fin τ.rank → ℤ} (hμ : K.IsNormal p μ)
    {χ : Multiplicative (Fin τ.rank → ℤ) →* M}
    (hχ : ∀ γ, IsRoot τ γ → (χ (Multiplicative.ofAdd γ) = 1 ↔ (p : ℤ) ∣ γ ⬝ᵥ μ))
    {z : Option (Fin τ.rank)} (hz : K.IsZ p μ z) :
    componentRoots χ ⟦⟨K.extRoot z, K.extRoot_mem_kernelRoots hχ hz⟩⟧ =
      K.rootsOf (K.comp p μ z) := by
  let i : KernelComponent χ := ⟦⟨K.extRoot z, K.extRoot_mem_kernelRoots hχ hz⟩⟧
  obtain ⟨x, hx, hxi⟩ := K.componentRoots_eq_rootsOf hK hp hμ hχ i
  have hmem : K.extRoot z ∈ K.rootsOf (K.comp p μ x) := by
    rw [← hxi]
    exact ⟨K.extRoot_mem_kernelRoots hχ hz, rfl⟩
  obtain ⟨-, n, hn, hzn⟩ := hmem
  obtain ⟨x', hnx', hif⟩ := K.exists_iform_ne_zero (K.isRoot_extRoot z) hzn
  have hx'x : x' ∈ K.comp p μ x := hn x' hnx'
  have hx'Z : K.IsZ p μ x' := hx'x.1
  have hzx : z ∈ K.comp p μ x := by
    by_cases hzx' : z = x'
    · rw [hzx']; exact hx'x
    · have hadj : K.Adj z x' := ⟨hzx', hif⟩
      exact ⟨hz, hx'x.2.trans _ _ _ (Relation.EqvGen.rel _ _ ⟨hx'Z, hz, K.adj_symm hadj⟩)⟩
  have hcomp : K.comp p μ z = K.comp p μ x := K.comp_eq_of_mem hzx
  rw [hcomp]
  exact hxi

private theorem exists_class_for_extRoot {τ : Tag}
    (K : KacData τ) (hK : K.Facts) {L : Type} [Field L]
    [IsAlgClosed L] (h3 : ((3 : ℕ) : L) ≠ 0) {a : Fin τ.rank → Lˣ}
    (hap : ∀ j, a j ^ 3 = 1) :
    ∃ (v : WeylGroup τ) (μ : Fin τ.rank → ℤ), K.IsNormal 3 μ ∧
      ∀ z : Option (Fin τ.rank), K.IsZ 3 μ z →
        ∃ i : KernelComponent (rootCharHom a),
          componentRoots (rootCharHom a) i = (fun α => v • α) '' K.rootsOf (K.comp 3 μ z) := by
  have hNe : NeZero ((3 : ℕ) : L) := ⟨h3⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot L 3
  have hζ0 : IsUnit ζ := hζ.isUnit (by norm_num : (3 : ℕ) ≠ 0)
  let ζu : Lˣ := hζ0.unit
  have hζu : IsPrimitiveRoot (ζu : L) 3 := by
    simp only [ζu, IsUnit.unit_spec]
    exact hζ
  have hζuU : IsPrimitiveRoot ζu 3 := IsPrimitiveRoot.coe_units_iff.1 hζu
  obtain ⟨w, μ, hμ, hw⟩ := K.exists_weyl_normal (p := 3) (by norm_num) hζu a hap
  let a' : Fin τ.rank → Lˣ := fun i => ζu ^ μ i
  have ha' : a' = fun i => ζu ^ μ i := rfl
  have hconj : IsCharConj (rootCharHom a) (rootCharHom a') w := by
    intro v
    change rootChar a' v = rootChar a (w⁻¹ • v)
    rw [ha', KacData.rootChar_eq_zpow, hw (w⁻¹ • v), smul_inv_smul]
  have hconj' : IsCharConj (rootCharHom a') (rootCharHom a) w⁻¹ := by
    have hconj_rc : ∀ u : Fin τ.rank → ℤ, rootChar a' u = rootChar a (w⁻¹ • u) :=
      fun u => hconj u
    intro v
    change rootChar a v = rootChar a' ((w⁻¹)⁻¹ • v)
    rw [inv_inv, hconj_rc (w • v), inv_smul_smul]
  have hχ : ∀ γ, IsRoot τ γ →
      ((rootCharHom a') (Multiplicative.ofAdd γ) = 1 ↔ (3 : ℤ) ∣ γ ⬝ᵥ μ) := by
    intro γ _
    change rootChar a' γ = 1 ↔ _
    rw [ha', KacData.rootChar_eq_zpow]
    exact hζuU.zpow_eq_one_iff_dvd _
  refine ⟨w⁻¹, μ, hμ, fun z hz => ?_⟩
  let i' : KernelComponent (rootCharHom a') :=
    ⟦⟨K.extRoot z, K.extRoot_mem_kernelRoots hχ hz⟩⟧
  have hclass : componentRoots (rootCharHom a') i' = K.rootsOf (K.comp 3 μ z) :=
    componentRoots_extRoot_eq K hK (by norm_num) hμ hχ hz
  obtain ⟨i, hi⟩ := KacData.componentRoots_smul_of_isCharConj hconj' i'
  refine ⟨i, ?_⟩
  have himg : (fun α => w⁻¹ • α) '' componentRoots (rootCharHom a') i' =
      componentRoots (rootCharHom a) i := by
    rw [hi, Set.image_image]
    simp only [inv_inv, inv_smul_smul]
    rw [show (fun a => a) = id from rfl, Set.image_id]
  rw [hclass] at himg
  exact himg.symm

theorem e78_three_classes
    {τ : Tag} (hτ : τ = .E7 ∨ τ = .E8) {L : Type} [Field L] [IsAlgClosed L]
    (h3 : ((3 : ℕ) : L) ≠ 0) {a : Fin τ.rank → Lˣ} (hap : ∀ j, a j ^ 3 = 1) :
    (∀ i : KernelComponent (rootCharHom a), compRank (componentRoots (rootCharHom a) i) ≠ 4) ∧
      ∃ j : KernelComponent (rootCharHom a), 30 ≤ (componentRoots (rootCharHom a) j).ncard := by
  rcases hτ with rfl | rfl
  ·
    have hTp : rootDiagUnit Tag.E7 a ^ 3 = 1 := by
      have h := map_pow (rootDiagUnitHom Tag.E7 L) a 3
      have ha3 : a ^ 3 = 1 := funext hap
      rw [ha3, map_one] at h
      exact h.symm
    have hK : kacE7.Facts := facts_E7
    have hlab : ∀ i < 8, (e7LabIdx i : ℤ) = kacE7.label i := by
      intro i hi
      interval_cases i
      · rw [label_zero kacE7]; rfl
      · convert label_succ kacE7 (0 : Fin 7) using 2 <;> rfl
      · convert label_succ kacE7 (1 : Fin 7) using 2 <;> rfl
      · convert label_succ kacE7 (2 : Fin 7) using 2 <;> rfl
      · convert label_succ kacE7 (3 : Fin 7) using 2 <;> rfl
      · convert label_succ kacE7 (4 : Fin 7) using 2 <;> rfl
      · convert label_succ kacE7 (5 : Fin 7) using 2 <;> rfl
      · convert label_succ kacE7 (6 : Fin 7) using 2 <;> rfl
    have hne4 : ∀ i : KernelComponent (rootCharHom a),
        compRank (componentRoots (rootCharHom a) i) ≠ 4 := by
      intro i
      obtain ⟨v, μ, hμ, hall⟩ := exists_kacT_of_pos (N := 3) (by norm_num) h3 hK hTp
      obtain ⟨x, hx, hi⟩ := hall i
      let C : Finset (Option (Fin Tag.E7.rank)) :=
        (Set.toFinite (kacE7.comp 3 μ x)).toFinset
      have hCcoe : kacE7.comp 3 μ x = (C : Set (Option (Fin Tag.E7.rank))) :=
        (Set.toFinite (kacE7.comp 3 μ x)).coe_toFinset.symm
      have hCp : ∃ y, y ∉ C := by
        obtain ⟨y, hy⟩ := exists_not_mem_comp kacE7 (N := 3) (by norm_num) μ x
