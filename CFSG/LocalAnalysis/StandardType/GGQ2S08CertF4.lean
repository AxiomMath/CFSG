theorem f4c_certOK : certOK f4cGens (xLast 4) f4cSets f4cPats f4cReps f4cS2 = true := by
  decide +kernel

theorem f4c_cov : bCovB 4 f4cPats = true := by
  decide +kernel

theorem f4c_refl : reflCertB f4cGens f4cCerts = true := by
  decide +kernel

theorem f4c_frame : bFrameB 4 f4cCerts = true := by
  decide +kernel

theorem f4c_S (k : Fin 4) : f4FullS k = letLin (letAt f4cGens k) := by
  refine LinearEquiv.toLinearMap_injective ((Pi.basisFun (ZMod 3) (Fin 5)).ext fun j => ?_)
  rw [Pi.basisFun_apply]
  revert k j
  decide +kernel

theorem f4c_test : ∀ A Mg : Subgroup (Vn 5 ≃ₗ[ZMod 3] Vn 5),
    TestHyp (Subgroup.closure (Set.range fun k : Fin 4 => f4FullS k)) (xLast 4) A Mg →
    ∀ t₁ ∈ Mg, IsRefl t₁ → ¬ FixesLine (xLast 4) t₁ →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (xLast 4) t → t ∈ Mg :=
  linTest_bframe_of_certOK _ f4cGens rfl f4c_S f4c_refl f4c_frame f4c_certOK f4c_cov

