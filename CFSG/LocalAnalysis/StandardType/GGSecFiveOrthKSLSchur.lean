theorem ggKSL_sl_of_hasLabel
    {X : Type} [Group X] [Finite X] (hX : commutator X = ⊤)
    (hs : IsSimpleGroup (X ⧸ Subgroup.center X)) {r : ℕ} (hr : 4 ≤ r)
    (h : GGHasLabel ⟨.A, r, 1⟩ (X ⧸ Subgroup.center X)) :
    Subgroup.center X = ⊥ ∧ Nonempty (X ≃* ↥(StatedSL (r + 1) (ZMod 2))) := by
  have hΛ : LargeEvenInLambda2 ⟨.A, r, 1⟩ := ⟨le_rfl, show 1 ≤ r ∧ (r = 1 → 2 ≤ 1) by omega⟩
  have hmod := statedClassicalModel_of_hasLabel_typeA hΛ h
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨e⟩ :=
    CFSG.Adapters.RankTwoModelTransports.nonempty_mulEquiv_psl_galoisField _ (r + 1) 2 1 hmod
  have hZ : Subgroup.center X = ⊥ :=
    CFSG.LocalAnalysis.GLTheoremA.S172A.center_eq_bot_of_psl_two ⟨hX, hs⟩ (by omega) one_pos
      (by norm_num) e
  obtain ⟨e2⟩ := CFSG.Open.StatedAPI.nonempty_mulEquiv_specialLinear_zmod_two_of_psl hmod
  refine ⟨hZ, ⟨?_⟩⟩
  exact (((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm.trans
    e2).trans (CFSG.HardMathSupport.Solomon.Coordinator.mcltf_SLEquiv (r + 1))

end CFSG.StandardType

