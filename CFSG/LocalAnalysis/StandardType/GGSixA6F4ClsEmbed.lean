theorem ggA6F4_embed
    {K : Type} [Field K] [Finite K] (hK : Nat.card K = 2) :
    ∃ (Φ : ModGL Tag.F4 (AlgebraicClosure K) →* ModGL Tag.F4 (AlgebraicClosure K))
      (_ : IsSteinbergEnd Tag.F4 (AlgebraicClosure K) (2 ^ 1) Φ)
      (ι : ↥(adjointGroup Tag.F4 K) →* ModGL Tag.F4 (AlgebraicClosure K)),
      Function.Injective ι ∧ ι.range ≤ ratPoints Φ := by
  classical
  haveI : Fintype K := Fintype.ofFinite K
  have hcard : Fintype.card K = 2 ^ 1 := by
    rw [← Nat.card_eq_fintype_card, hK]
    norm_num
  haveI : CharP K 2 := charP_of_card_eq_prime_pow hcard
  haveI : CharP (AlgebraicClosure K) 2 :=
    charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective 2
  have hcomp : (iterateFrobenius (AlgebraicClosure K) 2 1).comp
        (algebraMap K (AlgebraicClosure K)) = algebraMap K (AlgebraicClosure K) := by
    refine RingHom.ext fun c => ?_
    change iterateFrobenius (AlgebraicClosure K) 2 1 (algebraMap K (AlgebraicClosure K) c) =
      algebraMap K (AlgebraicClosure K) c
    rw [iterateFrobenius_def, ← map_pow]
    congr 1
    rw [← hcard]
    exact FiniteField.pow_card c
  have hFix : ∀ y : ModGL Tag.F4 K,
      entrywiseFrobGL Tag.F4 (AlgebraicClosure K) 2 1
        (baseChangeGL (algebraMap K (AlgebraicClosure K)) y) =
      baseChangeGL (algebraMap K (AlgebraicClosure K)) y := by
    intro y
    rw [entrywiseFrobGL, units_map_entrywiseHom_eq_baseChangeGL,
      baseChangeGL_baseChangeGL, hcomp]
  have hmem : ∀ y : ModGL Tag.F4 K, y ∈ adjointGroup Tag.F4 K →
      baseChangeGL (algebraMap K (AlgebraicClosure K)) y ∈
        adjointGroup Tag.F4 (AlgebraicClosure K) := by
    intro y hy
    induction hy using Subgroup.closure_induction with
    | mem z hz =>
        obtain ⟨i, c, h | h⟩ := hz
        · rw [show z = xUnit Tag.F4 K i c from Units.ext h,
            baseChangeGL_xUnit (algebraMap K (AlgebraicClosure K))]
          exact xUnit_mem_adjointGroup i ((algebraMap K (AlgebraicClosure K)) c)
        · rw [show z = yUnit Tag.F4 K i c from Units.ext h,
            baseChangeGL_yUnit (algebraMap K (AlgebraicClosure K))]
          exact yUnit_mem_adjointGroup i ((algebraMap K (AlgebraicClosure K)) c)
    | one => simpa using one_mem _
    | mul x y _ _ hx hy => simpa using mul_mem hx hy
    | inv x _ hx => simpa using inv_mem hx
  let ι : ↥(adjointGroup Tag.F4 K) →* ModGL Tag.F4 (AlgebraicClosure K) :=
    (baseChangeGL (algebraMap K (AlgebraicClosure K))).comp (adjointGroup Tag.F4 K).subtype
  refine ⟨entrywiseFrobGL Tag.F4 (AlgebraicClosure K) 2 1, ?_, ι, ?_, ?_⟩
  · refine ⟨iterateFrobenius (AlgebraicClosure K) 2 1, fun c => iterateFrobenius_def 2 1 c,
      1, Or.inl rfl, ?_⟩
    intro g
    simp [entrywiseFrobGL]
  · exact (baseChangeGL_injective (algebraMap K (AlgebraicClosure K))).comp
      (Subgroup.subtype_injective _)
  · intro g hg
    obtain ⟨y, rfl⟩ := hg
    refine ⟨hmem (y : ModGL Tag.F4 K) y.2, ?_⟩
    change entrywiseFrobGL Tag.F4 (AlgebraicClosure K) 2 1
          (baseChangeGL (algebraMap K (AlgebraicClosure K)) (y : ModGL Tag.F4 K)) =
        baseChangeGL (algebraMap K (AlgebraicClosure K)) (y : ModGL Tag.F4 K)
    exact hFix (y : ModGL Tag.F4 K)

