theorem d4f_certOK : certOK d4fGens (xLast 4) d4fSets d4fPats d4fReps d4fS2 = true := by
  decide +kernel

theorem d4f_cov : dCovB 4 d4fPats = true := by
  decide +kernel

theorem d4f_refl : reflCertB d4fGens d4fCerts = true := by
  decide +kernel

theorem d4f_frame : dFrameB 4 d4fCerts = true := by
  decide +kernel

theorem d4f_S (k : Fin 4) : dFullS 4 k = letLin (letAt d4fGens k) := by
  refine LinearEquiv.toLinearMap_injective ((Pi.basisFun (ZMod 3) (Fin 5)).ext fun j => ?_)
  rw [Pi.basisFun_apply]
  revert k j
  decide +kernel

theorem d4f_test : ∀ A Mg : Subgroup (Vn 5 ≃ₗ[ZMod 3] Vn 5),
    TestHyp (Subgroup.closure (Set.range fun k : Fin 4 => dFullS 4 k)) (xLast 4) A Mg →
    ∀ t₁ ∈ Mg, IsRefl t₁ → ¬ FixesLine (xLast 4) t₁ →
    ∀ t ∈ A, IsRefl t → ¬ FixesLine (xLast 4) t → t ∈ Mg :=
  linTest_dframe_of_certOK (by norm_num) _ d4fGens rfl d4f_S d4f_refl d4f_frame d4f_certOK d4f_cov

