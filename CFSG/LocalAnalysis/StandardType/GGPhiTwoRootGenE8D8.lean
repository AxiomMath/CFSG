theorem e8D8Roots_eq_kernelRoots :
    {γ : Fin Tag.E8.rank → ℤ | IsRoot .E8 γ ∧ Even (γ (e8Node 0))} =
      kernelRoots (maskChar (τ := .E8) e8BitsD8) := by
  ext γ
  rw [mem_kernelRoots_maskChar, maskPairing_e8BitsD8]
  rfl

theorem torusGroup_le_rootSpan_e8D8
    {K : Type} [Field K] [Finite K] [CharP K 2] :
    torusGroup .E8 K ≤
      rootSpan .E8 K {γ : Fin Tag.E8.rank → ℤ | IsRoot .E8 γ ∧ Even (γ (e8Node 0))} := by
  have hframe : ∀ i : Fin 8,
      Even (CFSG.StandardType.TableBExcTwo.frameE8Root i (e8Node 0)) := by decide
  refine (CFSG.LieType.SeitzGeneration.ExcHigh.torusGroup_le_frameSpan8 (L := K) ?_).trans ?_
  · intro x
    obtain ⟨z, hz⟩ := isSquare_of_charTwo' x
    exact ⟨z, by rw [pow_two, ← hz]⟩
  · rw [CFSG.LieType.SeitzGeneration.ExcHigh.frameSpan8]
    refine iSup_le fun i => ?_
    have hi : IsRoot .E8 (CFSG.StandardType.TableBExcTwo.frameE8Root i) :=
      mem_rootFinset.1 (CFSG.StandardType.TableBExcTwo.frameE8Root_mem i)
    rw [CFSG.RankThree.Chevalley.range_rootSL2_of_isRoot hi]
    refine sup_le ?_ ?_
    · exact rootSubgroup_le_rootSpan ⟨hi, hframe i⟩
    · refine rootSubgroup_le_rootSpan ⟨IsRoot.neg hi, ?_⟩
      rw [Pi.neg_apply]
      exact (hframe i).neg

theorem exists_e8D8Omega_injective
    (K : Type) [Field K] [Finite K] [CharP K 2] :
    ∃ Ψ : ↥(orthDerived (quadPlus 8 K)) →* adjointGroup .E8 K, Function.Injective Ψ ∧
      Ψ.range.map (adjointGroup .E8 K).subtype =
        rootSpan .E8 K {γ : Fin Tag.E8.rank → ℤ | IsRoot .E8 γ ∧ Even (γ (e8Node 0))} := by
  let Ψ : ↥(orthDerived (quadPlus 8 K)) →* adjointGroup .E8 K :=
    (⨆ k, e8D8Chain K k).subtype.comp
      (CFSG.LocalAnalysis.GLTheoremA.Y10F.ExcE8Spin.e8D8Theta K).symm.toMonoidHom
  refine ⟨Ψ, ?_, ?_⟩
  · intro x y h
    exact (CFSG.LocalAnalysis.GLTheoremA.Y10F.ExcE8Spin.e8D8Theta K).symm.injective
      ((⨆ k, e8D8Chain K k).subtype_injective h)
  · have hrange : Ψ.range = ⨆ k, e8D8Chain K k := by
      rw [show Ψ = (⨆ k, e8D8Chain K k).subtype.comp
          (CFSG.LocalAnalysis.GLTheoremA.Y10F.ExcE8Spin.e8D8Theta K).symm.toMonoidHom from rfl,
        MonoidHom.range_comp,
        MonoidHom.range_eq_top.mpr
          (CFSG.LocalAnalysis.GLTheoremA.Y10F.ExcE8Spin.e8D8Theta K).symm.surjective,
        Subgroup.map_top, Subgroup.range_subtype]
    rw [hrange, map_subtype_iSup_e8D8Chain_eq_rootSpan]

