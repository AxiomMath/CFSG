open CFSG.Assembly CFSG.Blueprint CFSG.Assembly.LowTwoRank CFSG.LieType.BorelTits

theorem ggA6_omega_model (t : StatedLieTag) (ht : t = .POmegaPlus ∨ t = .POmegaMinus) (n f : ℕ)
    (G : Type) [Group G] (hZ : Subgroup.center G = ⊥) (hLie : LieModel (G ⧸ Subgroup.center G) t n 2 f) :
    ∃ (F : Type) (_ : Field F) (_ : Finite F) (_ : CharP F 2) (ι : Type) (_ : Fintype ι)
      (_ : DecidableEq ι) (Φ : QuadForm F (ι → F)), Nonempty (G ≃* ↥(CFSG.Open.StatedOmega Φ.Q)) := by
  rcases ht with rfl | rfl
  ·
    have hSC : CFSG.Open.StatedClassicalModel (G ⧸ Subgroup.center G) .POmegaPlus n 2 f :=
      CFSG.Blueprint.LieModel.statedClassicalModel hLie (by decide)
    obtain ⟨⟨h2prime, hf1, h4n⟩, K, hKf, hKfin, hKcard, ⟨e⟩⟩ := hSC
    letI : Field K := hKf
    letI : Finite K := hKfin
    haveI : Fact (Nat.Prime 2) := ⟨h2prime⟩
    haveI : CharP K 2 := CFSG.SectionRank.charP_of_natCard_eq_pow (K := K) (p := 2) (f := f) hKcard
    have hn : 1 ≤ n := by omega
    have hbot : (CFSG.Open.StatedScalars (Fin n ⊕ Fin n) K).subgroupOf
        (CFSG.Open.StatedOmega (CFSG.Open.StatedQuadPlus n K)) = ⊥ :=
      CFSG.RankThree.PartOne.KFU.statedScalars_subgroupOf_statedOmega_quadPlus_eq_bot hn
    obtain ⟨eproj⟩ :=
      CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.Omega2401.nonempty_statedProj_equiv_of_bot
        (CFSG.Open.StatedOmega (CFSG.Open.StatedQuadPlus n K)) hbot
    have hQ : (CFSG.StandardType.GGOppRadOmega.plusForm n K).Q = CFSG.Open.StatedQuadPlus n K := by
      funext v
      rw [CFSG.StandardType.GGOppRadOmega.plusForm_Q]
      exact congrFun (CFSG.LieType.Universal.Spin.coe_quadPlus n K) v
    have eG : G ≃* CFSG.Open.StatedProj
        (CFSG.Open.StatedOmega (CFSG.Open.StatedQuadPlus n K)) :=
      (QuotientGroup.quotientBot.symm.trans
        (QuotientGroup.quotientMulEquivOfEq hZ.symm)).trans e
    refine ⟨K, hKf, hKfin, inferInstance, Fin n ⊕ Fin n, inferInstance, inferInstance,
      CFSG.StandardType.GGOppRadOmega.plusForm n K, ?_⟩
    rw [hQ]
    exact ⟨eG.trans eproj⟩
  ·
    have hSC : CFSG.Open.StatedClassicalModel (G ⧸ Subgroup.center G) .POmegaMinus n 2 f :=
      CFSG.Blueprint.LieModel.statedClassicalModel hLie (by decide)
    obtain ⟨⟨h2prime, hf1, h4n⟩, K, hKf, hKfin, hKcard, b, c, hirr, ⟨e⟩⟩ := hSC
    letI : Field K := hKf
    letI : Finite K := hKfin
    haveI : Fact (Nat.Prime 2) := ⟨h2prime⟩
    haveI : CharP K 2 := CFSG.SectionRank.charP_of_natCard_eq_pow (K := K) (p := 2) (f := f) hKcard
    obtain ⟨v₀, hv₀⟩ := CFSG.RankThree.CentralLift.exists_quadMinus_ne_zero (K := K) n b c
    have hbot : (CFSG.Open.StatedScalars (Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2) K).subgroupOf
        (CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus n K b c)) = ⊥ :=
      CFSG.SectionRank.QTK.statedScalars_subgroupOf_statedOmega_eq_bot
        (K := K) (ι := Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2)
        (Q := CFSG.LieType.Universal.Spin.quadMinus n K b c)
        (Q₀ := CFSG.Open.StatedQuadMinus n K b c)
        (CFSG.LieType.Universal.Spin.coe_quadMinus n K b c) hv₀
    obtain ⟨eproj⟩ :=
      CFSG.LocalAnalysis.RankFourTheoremC.PEmpty.Omega2401.nonempty_statedProj_equiv_of_bot
        (CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus n K b c)) hbot
    have hQ : (CFSG.StandardType.GGOppRadOmega.minusForm (n := n) (K := K) (b := b) (c := c) hirr).Q =
        CFSG.Open.StatedQuadMinus n K b c := by
      funext v
      rw [CFSG.StandardType.GGOppRadOmega.minusForm_Q hirr]
      exact congrFun (CFSG.LieType.Universal.Spin.coe_quadMinus n K b c) v
    have eG : G ≃* CFSG.Open.StatedProj
        (CFSG.Open.StatedOmega (CFSG.Open.StatedQuadMinus n K b c)) :=
      (QuotientGroup.quotientBot.symm.trans
        (QuotientGroup.quotientMulEquivOfEq hZ.symm)).trans e
    refine ⟨K, hKf, hKfin, inferInstance, Fin (n - 1) ⊕ Fin (n - 1) ⊕ Fin 2, inferInstance,
      inferInstance, CFSG.StandardType.GGOppRadOmega.minusForm (n := n) (K := K) (b := b) (c := c) hirr, ?_⟩
    rw [hQ]
    exact ⟨eG.trans eproj⟩

end CFSG.StandardType.A6Red

