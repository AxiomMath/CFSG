module

public import Mathlib.LinearAlgebra.Matrix.Cartan.Basic
public import Mathlib.Algebra.Field.ZMod

public section

namespace CFSG.StandardType

@[expose] def ggECartan (n : ℕ) : Matrix (Fin n) (Fin n) (ZMod 3) :=
  (CartanMatrix.E n).map (Int.castRingHom (ZMod 3))

@[expose] def ggEBil (n : ℕ) (u v : Fin n → ZMod 3) : ZMod 3 :=
  u ⬝ᵥ (ggECartan n).mulVec v

@[expose] def ggERefl (n : ℕ) (z w : Fin n → ZMod 3) : Fin n → ZMod 3 :=
  w - (2 * ggEBil n z w / ggEBil n z z) • z

@[expose] def ggESimple (n : ℕ) (j : Fin n) (v : Fin n → ZMod 3) : Fin n → ZMod 3 :=
  v - ((ggECartan n).mulVec v j) • Pi.single j 1

@[expose] def ggEClosure (n : ℕ) (S : Set (Fin n)) : Set (Fin n → ZMod 3) :=
  {v | ∀ T : Set (Fin n → ZMod 3), (∀ k ∈ S, Pi.single k 1 ∈ T) →
    (∀ j ∈ S, ∀ w ∈ T, ggESimple n j w ∈ T) → v ∈ T}

private def ggQ2xE7c_dig (n i : ℕ) : ℕ := n / 3 ^ i % 3

private def ggQ2xE7c_enc (v : Fin 7 → ZMod 3) : ℕ :=
  Nat.ofDigits 3 (List.ofFn (fun i : Fin 7 => (v i).val))

private lemma ggQ2xE7c_getD_eq_getElem' {α : Type} (l : List α) (d : α) (i : ℕ)
    (h : i < l.length) : l.getD i d = l[i] := by
  induction l generalizing i with
  | nil => simp at h
  | cons a t ih =>
      cases i with
      | zero => simp
      | succ j =>
          rw [List.getD_cons_succ, List.getElem_cons_succ]
          exact ih j (by simpa using h)

private lemma ggQ2xE7c_getD_ofFn {n : ℕ} (f : Fin n → ℕ) (i : Fin n) :
    (List.ofFn f).getD (i : ℕ) 0 = f i := by
  rw [ggQ2xE7c_getD_eq_getElem' _ _ _ (by simpa [List.length_ofFn] using i.isLt)]
  rw [List.getElem_ofFn]

private lemma ggQ2xE7c_ofDigits_digid (b : ℕ) (hb : 1 < b) :
    ∀ (L : List ℕ), (∀ x ∈ L, x < b) → ∀ i, i < L.length →
      Nat.ofDigits b L / b ^ i % b = L.getD i 0 := by
  intro L
  induction L with
  | nil => intro _ i hi; exact absurd hi (by simp)
  | cons a t ih =>
      intro hL i hi
      cases i with
      | zero =>
          rw [Nat.ofDigits_cons, pow_zero, Nat.div_one, List.getD_cons_zero]
          rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (hL a (by simp))]
      | succ j =>
          rw [Nat.ofDigits_cons, List.getD_cons_succ]
          have hdiv : (a + b * Nat.ofDigits b t) / b = Nat.ofDigits b t := by
            rw [Nat.add_mul_div_left a _ (by omega)]
            rw [Nat.div_eq_of_lt (hL a (by simp))]
            exact Nat.zero_add _
          rw [Nat.pow_succ, Nat.mul_comm (b ^ j) b, ← Nat.div_div_eq_div_mul, hdiv]
          exact ih (by intro x hx; exact hL x (by simp [hx])) j (by simpa using hi)

private lemma ggQ2xE7c_dig_enc (v : Fin 7 → ZMod 3) (i : Fin 7) :
    ggQ2xE7c_dig (ggQ2xE7c_enc v) i = (v i).val := by
  unfold ggQ2xE7c_dig ggQ2xE7c_enc
  rw [ggQ2xE7c_ofDigits_digid 3 (by norm_num)
      (List.ofFn (fun i : Fin 7 => (v i).val)) ?_ (i:ℕ) (by simpa [List.length_ofFn] using i.isLt)]
  · exact ggQ2xE7c_getD_ofFn (fun i : Fin 7 => (v i).val) i
  · intro x hx
    rw [List.mem_ofFn] at hx
    obtain ⟨j, rfl⟩ := hx
    exact ZMod.val_lt _

private lemma ggQ2xE7c_enc_lt (v : Fin 7 → ZMod 3) : ggQ2xE7c_enc v < 3 ^ 7 := by
  unfold ggQ2xE7c_enc
  have h := Nat.ofDigits_lt_base_pow_length (b := 3)
    (l := List.ofFn (fun i : Fin 7 => (v i).val)) (by norm_num)
    (by intro x hx; rw [List.mem_ofFn] at hx; obtain ⟨j, rfl⟩ := hx; exact ZMod.val_lt _)
  simpa [List.length_ofFn] using h

private lemma ggQ2xE7c_enc_injective : Function.Injective ggQ2xE7c_enc := by
  intro u v huv
  funext i
  exact ZMod.val_injective 3 (by
    rw [← ggQ2xE7c_dig_enc u i, ← ggQ2xE7c_dig_enc v i, huv])

private theorem ggQ2xE7c_enc_surj (m : ℕ) (hm : m < 3 ^ 7) :
    ∃ v : Fin 7 → ZMod 3, ggQ2xE7c_enc v = m := by
  have hf : Function.Injective
      (fun v : Fin 7 → ZMod 3 => (⟨ggQ2xE7c_enc v, ggQ2xE7c_enc_lt v⟩ : Fin (3 ^ 7))) := by
    intro u v huv
    exact ggQ2xE7c_enc_injective (by simpa using congrArg Fin.val huv)
  have hcard : Fintype.card (Fin 7 → ZMod 3) = Fintype.card (Fin (3 ^ 7)) := by
    rw [Fintype.card_fun, Fintype.card_fin, Fintype.card_fin]
    norm_num [Fintype.card_fin]
  have hbij := (Fintype.bijective_iff_injective_and_card _).2 ⟨hf, hcard⟩
  obtain ⟨v, hv⟩ := hbij.2 ⟨m, hm⟩
  exact ⟨v, congrArg Fin.val hv⟩

private noncomputable def ggQ2xE7c_dec (m : ℕ) : Fin 7 → ZMod 3 :=
  if hm : m < 3 ^ 7 then Classical.choose (ggQ2xE7c_enc_surj m hm) else 0

private lemma ggQ2xE7c_enc_dec (m : ℕ) (hm : m < 3 ^ 7) :
    ggQ2xE7c_enc (ggQ2xE7c_dec m) = m := by
  unfold ggQ2xE7c_dec
  rw [dif_pos hm]
  exact Classical.choose_spec (ggQ2xE7c_enc_surj m hm)

