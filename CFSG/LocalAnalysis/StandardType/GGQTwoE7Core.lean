private def ggQ2xE7c_cm (i j : ℕ) : ℕ := (ggQ2xE7c_cartan.getD i []).getD j 0

private def ggQ2xE7c_dotC (i v : ℕ) : ℕ :=
  (List.range 7).foldl (fun s k => s + ggQ2xE7c_cm i k * ggQ2xE7c_dig v k) 0 % 3

private def ggQ2xE7c_beta (u v : ℕ) : ℕ :=
  (List.range 7).foldl (fun s i => s + ggQ2xE7c_dig u i * ggQ2xE7c_dotC i v) 0 % 3

private def ggQ2xE7c_sref (i v : ℕ) : ℕ :=
  Nat.ofDigits 3 (List.ofFn (fun k : Fin 7 =>
    if (k : ℕ) = i then (ggQ2xE7c_dig v (k : ℕ) + 3 - ggQ2xE7c_dotC i v) % 3
    else ggQ2xE7c_dig v (k : ℕ)))

private def ggQ2xE7c_zc (z w : ℕ) : ℕ :=
  let nz := ggQ2xE7c_beta z z
  let inv := if nz == 1 then 1 else 2
  (2 * inv * ggQ2xE7c_beta z w) % 3

private def ggQ2xE7c_zref (z w : ℕ) : ℕ :=
  Nat.ofDigits 3 (List.ofFn (fun k : Fin 7 =>
    (ggQ2xE7c_dig w (k : ℕ) + 9 - ggQ2xE7c_zc z w * ggQ2xE7c_dig z (k : ℕ)) % 3))


private def ggQ2xE7c_lamMask (a : ℕ) : ℕ :=
  match a with
  | 0 => ggQ2xE7c_lamMask_0
  | 1 => ggQ2xE7c_lamMask_1
  | 6 => ggQ2xE7c_lamMask_6
  | _ => 0

private def ggQ2xE7c_lamDist (a : ℕ) : ℕ :=
  match a with
  | 0 => ggQ2xE7c_lamDist_0
  | 1 => ggQ2xE7c_lamDist_1
  | 6 => ggQ2xE7c_lamDist_6
  | _ => 0

private def ggQ2xE7c_lamList (a : ℕ) : List ℕ :=
  match a with
  | 0 => ggQ2xE7c_lamList_0
  | 1 => ggQ2xE7c_lamList_1
  | 6 => ggQ2xE7c_lamList_6
  | _ => []

private def ggQ2xE7c_distTab (a : ℕ) : ℕ :=
  match a with
  | 0 => ggQ2xE7c_distTab_0
  | 1 => ggQ2xE7c_distTab_1
  | 6 => ggQ2xE7c_distTab_6
  | _ => 0

private def ggQ2xE7c_witTab (a : ℕ) : ℕ :=
  match a with
  | 0 => ggQ2xE7c_witTab_0
  | 1 => ggQ2xE7c_witTab_1
  | 6 => ggQ2xE7c_witTab_6
  | _ => 0

private def ggQ2xE7c_rootBit (v : ℕ) : Bool := ggQ2xE7c_rootMask.testBit v

private def ggQ2xE7c_lamBit (a v : ℕ) : Bool := (ggQ2xE7c_lamMask a).testBit v

private def ggQ2xE7c_rootDistOf (v : ℕ) : ℕ := ggQ2xE7c_rootDist >>> (5 * v) % 32

private def ggQ2xE7c_lamDistOf (a v : ℕ) : ℕ := (ggQ2xE7c_lamDist a) >>> (5 * v) % 32

private def ggQ2xE7c_distOf (a v : ℕ) : ℕ := (ggQ2xE7c_distTab a) >>> (5 * v) % 32

private def ggQ2xE7c_witOf (a v : ℕ) : ℕ := (ggQ2xE7c_witTab a) >>> (14 * v) % 16384

private def ggQ2xE7c_isSimple (v : ℕ) : Bool :=
  (List.range 7).any (fun k => v == 3 ^ k)

private def ggQ2xE7c_isSimpleA (a v : ℕ) : Bool :=
  (List.range 7).any (fun k => decide (k ≠ a) && (v == 3 ^ k))

private def ggQ2xE7c_isBadW (a z : ℕ) : Bool :=
  let w := ggQ2xE7c_witOf a z
  let i := w % 128
  let i2 := w / 128
  let l := ggQ2xE7c_lamList a
  let ρ := l.getD i 0
  let ρ' := l.getD i2 0
  let c := ggQ2xE7c_zref z ρ
  decide (i < l.length) && decide (i2 < l.length) && (ggQ2xE7c_dig z a == 0) &&
    (ggQ2xE7c_beta c c != 0) && !(ggQ2xE7c_lamBit a (ggQ2xE7c_zref c ρ'))

private def ggQ2xE7c_okVec (a v : ℕ) : Bool :=
  if ggQ2xE7c_beta v v == 0 || ggQ2xE7c_rootBit v then true
  else if ggQ2xE7c_distOf a v == 0 then ggQ2xE7c_isBadW a v
  else (List.range 7).any (fun j => !(ggQ2xE7c_rootBit (ggQ2xE7c_sref j v)) &&
    ggQ2xE7c_distOf a (ggQ2xE7c_sref j v) + 1 == ggQ2xE7c_distOf a v)

private def ggQ2xE7c_okLam (a v : ℕ) : Bool :=
  if !(ggQ2xE7c_lamBit a v) then true
  else if ggQ2xE7c_lamDistOf a v == 0 then ggQ2xE7c_isSimpleA a v
  else (List.range 7).any (fun j => decide (j ≠ a) && ggQ2xE7c_lamBit a (ggQ2xE7c_sref j v) &&
    ggQ2xE7c_lamDistOf a (ggQ2xE7c_sref j v) + 1 == ggQ2xE7c_lamDistOf a v)

private def ggQ2xE7c_okRoot (v : ℕ) : Bool :=
  if !(ggQ2xE7c_rootBit v) then true
  else if ggQ2xE7c_rootDistOf v == 0 then ggQ2xE7c_isSimple v
  else (List.range 7).any (fun j => ggQ2xE7c_rootBit (ggQ2xE7c_sref j v) &&
    ggQ2xE7c_rootDistOf (ggQ2xE7c_sref j v) + 1 == ggQ2xE7c_rootDistOf v)

private def ggQ2xE7c_okLamClosed (a : ℕ) : Bool :=
  (List.range 7).all (fun k => !decide (k ≠ a) || ggQ2xE7c_lamBit a (3 ^ k)) &&
  (List.range 7).all (fun j => !decide (j ≠ a) ||
    (List.range (3 ^ 7)).all (fun v => !(ggQ2xE7c_lamBit a v) ||
      ggQ2xE7c_lamBit a (ggQ2xE7c_sref j v)))

private def ggQ2xE7c_chk (a : ℕ) : Bool :=
  (List.range (3 ^ 7)).all (ggQ2xE7c_okVec a) &&
  (List.range (3 ^ 7)).all (ggQ2xE7c_okLam a) &&
  (List.range (3 ^ 7)).all ggQ2xE7c_okRoot &&
  ggQ2xE7c_okLamClosed a

private theorem ggQ2xE7c_chk_true_0 : ggQ2xE7c_chk 0 = true := by decide +kernel

private theorem ggQ2xE7c_chk_true_1 : ggQ2xE7c_chk 1 = true := by decide +kernel

private theorem ggQ2xE7c_chk_true_6 : ggQ2xE7c_chk 6 = true := by decide +kernel

private theorem ggQ2xE7c_chk_true (a : ℕ) (ha : a = 0 ∨ a = 1 ∨ a = 6) :
    ggQ2xE7c_chk a = true := by
  rcases ha with h | h | h <;> rw [h]
  · exact ggQ2xE7c_chk_true_0
  · exact ggQ2xE7c_chk_true_1
  · exact ggQ2xE7c_chk_true_6

private lemma ggQ2xE7c_eq_of_dig_eq : ∀ (n a b : ℕ), a < 3 ^ n → b < 3 ^ n →
    (∀ i, i < n → ggQ2xE7c_dig a i = ggQ2xE7c_dig b i) → a = b := by
  intro n
  induction n with
  | zero =>
      intro a b ha hb _
      interval_cases a <;> interval_cases b <;> rfl
  | succ n ih =>
      intro a b ha hb h
      have h0 : a % 3 = b % 3 := by
        have hh := h 0 (by omega)
        simpa [ggQ2xE7c_dig] using hh
      have ha' : a / 3 < 3 ^ n := by
        rw [Nat.div_lt_iff_lt_mul (by norm_num)]; simpa [pow_succ] using ha
      have hb' : b / 3 < 3 ^ n := by
        rw [Nat.div_lt_iff_lt_mul (by norm_num)]; simpa [pow_succ] using hb
      have hdig : ∀ i, i < n → ggQ2xE7c_dig (a/3) i = ggQ2xE7c_dig (b/3) i := by
        intro i hi
        have := h (i+1) (by omega)
        simpa [ggQ2xE7c_dig, pow_succ, Nat.mul_comm, Nat.div_div_eq_div_mul] using this
      have hdiv : a / 3 = b / 3 := ih (a/3) (b/3) ha' hb' hdig
      calc a = a % 3 + 3 * (a / 3) := (Nat.mod_add_div a 3).symm
        _ = b % 3 + 3 * (b / 3) := by rw [h0, hdiv]
        _ = b := Nat.mod_add_div b 3

private lemma ggQ2xE7c_dig_pow3 (j k : Fin 7) :
    ggQ2xE7c_dig (3 ^ (j : ℕ)) (k : ℕ) = if k = j then 1 else 0 := by
  fin_cases j <;> fin_cases k <;> decide

private lemma ggQ2xE7c_enc_single (j : Fin 7) :
    ggQ2xE7c_enc (Pi.single j 1) = 3 ^ (j : ℕ) := by
  apply ggQ2xE7c_eq_of_dig_eq 7
  · exact ggQ2xE7c_enc_lt _
  · exact pow_lt_pow_right₀ (by norm_num) j.isLt
  · intro i hi
    rw [ggQ2xE7c_dig_enc _ ⟨i, hi⟩]
    rw [show ggQ2xE7c_dig (3 ^ (j : ℕ)) i = ggQ2xE7c_dig (3 ^ (j : ℕ)) (⟨i, hi⟩ : Fin 7) from rfl,
      ggQ2xE7c_dig_pow3]
    by_cases hij : (⟨i, hi⟩ : Fin 7) = j
    · rw [hij, Pi.single_eq_same, if_pos rfl]; decide
    · rw [Pi.single_eq_of_ne hij, if_neg hij]; decide

private lemma ggQ2xE7c_zmod3_val_sub (x y : ZMod 3) :
    (x - y).val = (x.val + 3 - y.val) % 3 := by
  fin_cases x <;> fin_cases y <;> decide
private lemma ggQ2xE7c_zmod3_val_mul (x y : ZMod 3) :
    (x * y).val = x.val * y.val % 3 := by
  fin_cases x <;> fin_cases y <;> decide
private lemma ggQ2xE7c_two_ne_zero : (2 : ZMod 3) ≠ 0 := by decide
private lemma ggQ2xE7c_zmod3_val_div (b x : ZMod 3) (hb : b ≠ 0) :
    (2 * x / b).val = (2 * (if b.val == 1 then 1 else 2) * x.val) % 3 := by
  have hb1 : b = 1 ∨ b = 2 := by
    fin_cases b
    · exact absurd rfl hb
    · exact Or.inl rfl
    · exact Or.inr rfl
  rcases hb1 with rfl | rfl
  · rw [div_one, ggQ2xE7c_zmod3_val_mul, show (2 : ZMod 3).val = 2 from by decide,
      show (if (1 : ZMod 3).val == 1 then 1 else 2) = 1 from by decide]
  · rw [mul_div_cancel_left₀ x ggQ2xE7c_two_ne_zero,
      show (if (2 : ZMod 3).val == 1 then 1 else 2) = 2 from by decide]
    rw [show 4 * x.val = x.val + 3 * x.val by ring, Nat.add_mul_mod_self_left,
      Nat.mod_eq_of_lt (ZMod.val_lt x)]
private lemma ggQ2xE7c_foldl_range_sum (g : ℕ → ℕ) (n : ℕ) :
    (List.range n).foldl (fun s i => s + g i) 0 = ∑ i ∈ Finset.range n, g i := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [List.range_succ, List.foldl_append, Finset.sum_range_succ, ih]
      simp [List.foldl]
private lemma ggQ2xE7c_foldl_range_cast (g : ℕ → ℕ) (n : ℕ) :
    (((List.range n).foldl (fun s i => s + g i) 0 : ℕ) : ZMod 3)
      = ∑ i ∈ Finset.range n, (g i : ZMod 3) := by
  rw [ggQ2xE7c_foldl_range_sum]; push_cast; rfl
private lemma ggQ2xE7c_cm_eq (i j : Fin 7) :
    ggQ2xE7c_cm (i : ℕ) (j : ℕ) = (ggECartan 7 i j).val := by
  fin_cases i <;> fin_cases j <;> decide
private lemma ggQ2xE7c_mulVec_sum (M : Matrix (Fin 7) (Fin 7) (ZMod 3))
    (v : Fin 7 → ZMod 3) (i : Fin 7) :
    M.mulVec v i = ∑ j : Fin 7, M i j * v j := by
  rw [Matrix.mulVec_apply, dotProduct]
  simp [Matrix.row]
private lemma ggQ2xE7c_dotC_eq (i : Fin 7) (v : Fin 7 → ZMod 3) :
    ((ggQ2xE7c_dotC (i : ℕ) (ggQ2xE7c_enc v) : ℕ) : ZMod 3)
      = ∑ k : Fin 7, ggECartan 7 i k * v k := by
  rw [ggQ2xE7c_dotC, ZMod.natCast_mod, ggQ2xE7c_foldl_range_cast,
    ← Fin.sum_univ_eq_sum_range
      (fun k => ((ggQ2xE7c_cm (i:ℕ) k * ggQ2xE7c_dig (ggQ2xE7c_enc v) k : ℕ) : ZMod 3))]
  apply Finset.sum_congr rfl
  intro k _
  rw [Nat.cast_mul, ggQ2xE7c_cm_eq i k, ggQ2xE7c_dig_enc v k,
    ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
private lemma ggQ2xE7c_bil_eq_sum (u v : Fin 7 → ZMod 3) :
    ggEBil 7 u v = ∑ i : Fin 7, u i * ∑ j : Fin 7, ggECartan 7 i j * v j := by
  rw [ggEBil, dotProduct]
  apply Finset.sum_congr rfl
  intro i _
  rw [ggQ2xE7c_mulVec_sum]
private lemma ggQ2xE7c_beta_eq (u v : Fin 7 → ZMod 3) :
    ggEBil 7 u v =
      ((ggQ2xE7c_beta (ggQ2xE7c_enc u) (ggQ2xE7c_enc v) : ℕ) : ZMod 3) := by
  rw [ggQ2xE7c_bil_eq_sum, ggQ2xE7c_beta, ZMod.natCast_mod, ggQ2xE7c_foldl_range_cast,
    ← Fin.sum_univ_eq_sum_range
      (fun k => ((ggQ2xE7c_dig (ggQ2xE7c_enc u) k * ggQ2xE7c_dotC k (ggQ2xE7c_enc v) : ℕ) :
        ZMod 3))]
  apply Finset.sum_congr rfl
  intro k _
