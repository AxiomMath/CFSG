    exact ggQ2xE7c_single_mem _ k hkne
  · have hlt : ggQ2xE7c_lamDistOf a (ggQ2xE7c_sref (j : ℕ) m) < d := by omega
    have hmem := ih _ hlt (ggQ2xE7c_sref (j : ℕ) m) rfl (ggQ2xE7c_sref_lt _ _) hbj
    have hcl : ggESimple 7 j (ggQ2xE7c_dec (ggQ2xE7c_sref (j : ℕ) m)) ∈
        ggEClosure 7 {k | (k : ℕ) ≠ a} := by
      intro T hgen hclo
      exact hclo j hjne _ (hmem T hgen hclo)
    have he : ggESimple 7 j (ggQ2xE7c_dec (ggQ2xE7c_sref (j : ℕ) m)) = ggQ2xE7c_dec m := by
      apply ggQ2xE7c_enc_injective
      rw [ggQ2xE7c_enc_simple j (ggQ2xE7c_dec (ggQ2xE7c_sref (j : ℕ) m)),
        ggQ2xE7c_enc_dec _ (ggQ2xE7c_sref_lt _ _), ggQ2xE7c_enc_dec m hm,
        ggQ2xE7c_sref_invol j m hm]
    rwa [he] at hcl

private lemma ggQ2xE7c_lam_mem (a : ℕ) (ha : a = 0 ∨ a = 1 ∨ a = 6)
    (v : Fin 7 → ZMod 3) (h : ggQ2xE7c_lamBit a (ggQ2xE7c_enc v) = true) :
    v ∈ ggEClosure 7 {k | (k : ℕ) ≠ a} := by
  have hmem := ggQ2xE7c_lam_mem_aux a ha (ggQ2xE7c_lamDistOf a (ggQ2xE7c_enc v))
    (ggQ2xE7c_enc v) rfl (ggQ2xE7c_enc_lt v) h
  have he : ggQ2xE7c_dec (ggQ2xE7c_enc v) = v := by
    apply ggQ2xE7c_enc_injective
    rw [ggQ2xE7c_enc_dec _ (ggQ2xE7c_enc_lt v)]
  rwa [he] at hmem

private lemma ggQ2xE7c_lam_closed_mem (a : ℕ) (ha : a = 0 ∨ a = 1 ∨ a = 6)
    (v : Fin 7 → ZMod 3) (h : v ∈ ggEClosure 7 {k | (k : ℕ) ≠ a}) :
    ggQ2xE7c_lamBit a (ggQ2xE7c_enc v) = true := by
  have hspec := ggQ2xE7c_okLamClosed_spec a (ggQ2xE7c_okLamClosed_true a ha)
  exact h {v | ggQ2xE7c_lamBit a (ggQ2xE7c_enc v) = true}
    (fun k hk => by
      show ggQ2xE7c_lamBit a (ggQ2xE7c_enc (Pi.single k 1)) = true
      rw [ggQ2xE7c_enc_single k]
      exact hspec.1 k hk)
    (fun j hj w hw => by
      show ggQ2xE7c_lamBit a (ggQ2xE7c_enc (ggESimple 7 j w)) = true
      rw [ggQ2xE7c_enc_simple j w]
      exact hspec.2 j hj (ggQ2xE7c_enc w) (ggQ2xE7c_enc_lt w) hw)

theorem ggQ2_E7_Z (a : Fin 7) (ha : a = 0 ∨ a = 1 ∨ a = 6) (Z : Set (Fin 7 → ZMod 3))
    (hZ0 : ∀ z ∈ Z, ggEBil 7 z z ≠ 0) (hZroots : ggEClosure 7 Set.univ ⊆ Z)
    (hZcl : ∀ z ∈ Z, ∀ w ∈ Z, ggERefl 7 z w ∈ Z)
    (hHL : ∀ z ∈ Z, z a = 0 → ∀ ρ ∈ ggEClosure 7 {k | k ≠ a}, ∀ ρ' ∈ ggEClosure 7 {k | k ≠ a},
      ggERefl 7 (ggERefl 7 z ρ) ρ' ∈ ggEClosure 7 {k | k ≠ a}) :
    Z ⊆ ggEClosure 7 Set.univ := by
  have hset : {k : Fin 7 | k ≠ a} = {k : Fin 7 | (k : ℕ) ≠ (a : ℕ)} := ggQ2xE7c_set_eq a
  have hav : (a : ℕ) = 0 ∨ (a : ℕ) = 1 ∨ (a : ℕ) = 6 := by
    rcases ha with h | h | h
    · left; rw [h]; rfl
    · right; left; rw [h]; rfl
    · right; right; rw [h]; rfl
  have hHL' : ∀ z ∈ Z, z a = 0 → ∀ ρ ∈ ggEClosure 7 {k | (k : ℕ) ≠ (a : ℕ)},
      ∀ ρ' ∈ ggEClosure 7 {k | (k : ℕ) ≠ (a : ℕ)},
      ggERefl 7 (ggERefl 7 z ρ) ρ' ∈ ggEClosure 7 {k | (k : ℕ) ≠ (a : ℕ)} := by
    intro z hz hza ρ hρ ρ' hρ'
    have h1 := hHL z hz hza ρ (by rwa [← hset] at hρ) ρ' (by rwa [← hset] at hρ')
    rwa [hset] at h1
  have hβ_enc : ∀ z ∈ Z, ggQ2xE7c_beta (ggQ2xE7c_enc z) (ggQ2xE7c_enc z) ≠ 0 := by
    intro z hz h0
    have hbe := ggQ2xE7c_beta_eq z z
    rw [h0, Nat.cast_zero] at hbe
    exact hZ0 z hz hbe
  have aux : ∀ d, ∀ (z' : Fin 7 → ZMod 3), z' ∈ Z →
      ggQ2xE7c_rootBit (ggQ2xE7c_enc z') = false →
      ggQ2xE7c_distOf (a : ℕ) (ggQ2xE7c_enc z') = d → False := by
    intro d
    refine Nat.strong_induction_on d ?_
    intro d ih z' hz' hb' hd'
    rcases ggQ2xE7c_okVec_spec (a : ℕ) (ggQ2xE7c_enc z')
        (ggQ2xE7c_okVec_true (a : ℕ) hav (ggQ2xE7c_enc z') (ggQ2xE7c_enc_lt z'))
        (hβ_enc z' hz') hb' with ⟨h0, hbad⟩ | ⟨hne, j, hbj, hdec⟩
    · obtain ⟨i, i2, hi, hi2, hdig, hcc, hlam⟩ :=
        ggQ2xE7c_isBadW_spec (a : ℕ) (ggQ2xE7c_enc z') hbad
      let ρ := (ggQ2xE7c_lamList (a : ℕ)).getD i 0
      let ρ' := (ggQ2xE7c_lamList (a : ℕ)).getD i2 0
      have hρmem : ρ ∈ ggQ2xE7c_lamList (a : ℕ) := ggQ2xE7c_getD_mem 0 hi
      have hρ'mem : ρ' ∈ ggQ2xE7c_lamList (a : ℕ) := ggQ2xE7c_getD_mem 0 hi2
      have hρlt : ρ < 3 ^ 7 := ggQ2xE7c_lamList_lt (a : ℕ) hav ρ hρmem
      have hρ'lt : ρ' < 3 ^ 7 := ggQ2xE7c_lamList_lt (a : ℕ) hav ρ' hρ'mem
      have hρbit : ggQ2xE7c_lamBit (a : ℕ) ρ = true :=
        ggQ2xE7c_lamList_bit (a : ℕ) hav ρ hρmem
      have hρ'bit : ggQ2xE7c_lamBit (a : ℕ) ρ' = true :=
        ggQ2xE7c_lamList_bit (a : ℕ) hav ρ' hρ'mem
      have hρcl : ggQ2xE7c_dec ρ ∈ ggEClosure 7 {k | (k : ℕ) ≠ (a : ℕ)} := by
        refine ggQ2xE7c_lam_mem (a : ℕ) hav (ggQ2xE7c_dec ρ) ?_
        rwa [ggQ2xE7c_enc_dec ρ hρlt]
      have hρ'cl : ggQ2xE7c_dec ρ' ∈ ggEClosure 7 {k | (k : ℕ) ≠ (a : ℕ)} := by
        refine ggQ2xE7c_lam_mem (a : ℕ) hav (ggQ2xE7c_dec ρ') ?_
        rwa [ggQ2xE7c_enc_dec ρ' hρ'lt]
      have hz'a : z' a = 0 := ZMod.val_injective 3 (by
        rw [← ggQ2xE7c_dig_enc z' a, hdig, ZMod.val_zero])
      have hfin : ggERefl 7 (ggERefl 7 z' (ggQ2xE7c_dec ρ)) (ggQ2xE7c_dec ρ') ∈
          ggEClosure 7 {k | (k : ℕ) ≠ (a : ℕ)} :=
        hHL' z' hz' hz'a (ggQ2xE7c_dec ρ) hρcl (ggQ2xE7c_dec ρ') hρ'cl
      have henc1 : ggQ2xE7c_enc (ggERefl 7 z' (ggQ2xE7c_dec ρ)) =
          ggQ2xE7c_zref (ggQ2xE7c_enc z') ρ := by
        rw [ggQ2xE7c_enc_refl z' (ggQ2xE7c_dec ρ) (hZ0 z' hz'), ggQ2xE7c_enc_dec ρ hρlt]
      have hβ2 : ggEBil 7 (ggERefl 7 z' (ggQ2xE7c_dec ρ))
          (ggERefl 7 z' (ggQ2xE7c_dec ρ)) ≠ 0 := by
        intro h0'
        have hv := ggQ2xE7c_beta_val (ggERefl 7 z' (ggQ2xE7c_dec ρ))
          (ggERefl 7 z' (ggQ2xE7c_dec ρ))
        rw [h0', ZMod.val_zero, henc1] at hv
        exact hcc hv.symm
      have henc2 : ggQ2xE7c_enc
          (ggERefl 7 (ggERefl 7 z' (ggQ2xE7c_dec ρ)) (ggQ2xE7c_dec ρ')) =
          ggQ2xE7c_zref (ggQ2xE7c_zref (ggQ2xE7c_enc z') ρ) ρ' := by
        rw [ggQ2xE7c_enc_refl _ (ggQ2xE7c_dec ρ') hβ2, henc1, ggQ2xE7c_enc_dec ρ' hρ'lt]
      have hcontra := ggQ2xE7c_lam_closed_mem (a : ℕ) hav _ hfin
      rw [henc2] at hcontra
      rw [hlam] at hcontra
      exact Bool.false_ne_true hcontra
    · have hwZ : ggERefl 7 (Pi.single j 1) z' ∈ Z :=
        hZcl (Pi.single j 1) (hZroots (ggQ2xE7c_single_mem Set.univ j (Set.mem_univ j))) z' hz'
      rw [ggQ2xE7c_refl_single j z'] at hwZ
      have hencw : ggQ2xE7c_enc (ggESimple 7 j z') = ggQ2xE7c_sref (j : ℕ) (ggQ2xE7c_enc z') :=
        ggQ2xE7c_enc_simple j z'
      have hbr : ggQ2xE7c_rootBit (ggQ2xE7c_enc (ggESimple 7 j z')) = false := by
        rw [hencw]; exact hbj
      have hlt : ggQ2xE7c_distOf (a : ℕ) (ggQ2xE7c_enc (ggESimple 7 j z')) < d := by
        rw [hencw]; omega
      exact ih _ hlt (ggESimple 7 j z') hwZ hbr rfl
  intro z hz
  by_cases hb : ggQ2xE7c_rootBit (ggQ2xE7c_enc z) = true
  · exact ggQ2xE7c_root_mem z hb
  · have hbf : ggQ2xE7c_rootBit (ggQ2xE7c_enc z) = false := by
      cases hh : ggQ2xE7c_rootBit (ggQ2xE7c_enc z)
      · rfl
      · exact absurd hh hb
    exact False.elim (aux (ggQ2xE7c_distOf (a : ℕ) (ggQ2xE7c_enc z)) z hz hbf rfl)

