private theorem exists_mulAut_conj_of_mem_normalizer {U G : Type*} [Group U] [Group G]
    {ψ : U →* G} (hψ : Function.Injective ψ) {a : G}
    (ha : a ∈ Subgroup.normalizer (ψ.range : Set G)) :
    ∃ α : MulAut U, (∀ k : U, a * ψ k * a⁻¹ = ψ (α k)) ∧ orderOf α ∣ orderOf a := by
  let Θ : U ≃* ψ.range := MonoidHom.ofInjective hψ
  let α : MulAut U := MulAut.congr Θ.symm (ψ.range.normalizerMonoidHom ⟨a, ha⟩)
  have hΘ : ∀ x : U, ((Θ x : ψ.range) : G) = ψ x := fun x => by
    show ((MonoidHom.ofInjective hψ x : ψ.range) : G) = ψ x
    rw [MonoidHom.ofInjective_apply]
  have horder : orderOf α ∣ orderOf a := by
    have h := orderOf_map_dvd ((MulAut.congr Θ.symm).toMonoidHom.comp
      (ψ.range.normalizerMonoidHom)) ⟨a, ha⟩
    have h2 : orderOf (⟨a, ha⟩ : ↥(Subgroup.normalizer (ψ.range : Set G))) = orderOf a :=
      (Subgroup.orderOf_coe ⟨a, ha⟩).symm
    rwa [h2] at h
  refine ⟨α, fun k => ?_, horder⟩
  have e : Θ (α k) = ψ.range.normalizerMonoidHom ⟨a, ha⟩ (Θ k) := by
    simp only [α, MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.symm_apply_apply,
      MulEquiv.symm_symm, MulEquiv.apply_symm_apply]
  have h1 : ((Θ (α k) : ψ.range) : G) = a * ψ k * a⁻¹ := by
    rw [e, GGRootNorm.coe_normalizerMonoidHom, hΘ k]
  exact h1.symm.trans (hΘ (α k))

