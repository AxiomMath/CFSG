theorem delta_eq_one_of_fix_su6Levi_one {f : ℕ} (hf : f = 1) (hk : Nat.card k = 2 ^ f)
    (hK : Nat.card K = (2 ^ f) ^ 2) {σ : K ≃+* K} (hσ : ∀ c, σ c = c ^ 2 ^ f)
    (u : (a : Fin TwistTag.E6.foldedTag.rank) →
      (orbitField TwistTag.E6 K σ.toRingHom a)ˣ) (δ : K ≃+* K)
    (h s : twistedE6RootGroup K σ)
    (hh : (h : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom)
    (hs : (s : ModGL TwistTag.E6.tag K) ∈ thetaTorus (algebraMap k K))
    (hfix : ∀ x : twistedE6RootGroup K σ, (x : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom →
      (MulAut.conj h * (MulAut.conj s * compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
        fieldActor (t := TwistTag.E6) σ δ)) x = x) :
    ∀ c, δ c = c := by
  have hf1 : 1 ≤ f := by omega
  have hk2 : Nat.card k = 2 := by rw [hk, hf]; norm_num
  have hK4 : Nat.card K = 2 ^ 2 := by rw [hK, hf]; norm_num
  have hk1 : Nat.card k = 2 ^ 1 := by rw [hk, hf]
  have hK1 : Nat.card K = (2 ^ 1) ^ 2 := by rw [hK, hf]
  have hσ1 : ∀ c, σ c = c ^ 2 ^ 1 := fun c => by rw [hσ c, hf]
  obtain ⟨-, -, -, -, -, hΔcoe, hfield, -, ⟨Θ, hΘ, -, -, -, -, -⟩, -, -, -, -, -⟩ :=
    twisted_E6_all_characteristic_exact_automorphism_normal_form Nat.prime_two hf1 K hK σ hσ
  set β : MulAut (twistedE6RootGroup K σ) :=
    MulAut.conj h * (MulAut.conj s * compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
      fieldActor (t := TwistTag.E6) σ δ) with hβ
  have hβform : β = MulAut.conj (h * s) * compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
      fieldActor (t := TwistTag.E6) σ δ := by
    rw [hβ, map_mul MulAut.conj h s]
    group
  have hΘβ : Θ β = δ := hΘ β (h * s) u δ hβform
  have hδ2 : δ ^ 2 = 1 := by
    haveI : Fintype (RingAut K) := Fintype.ofFinite _
    have hdvd : orderOf δ ∣ Fintype.card (RingAut K) := orderOf_dvd_card
    rw [← Nat.card_eq_fintype_card,
      (CFSG.LocalAnalysis.ComponentInitial.card_ringAut_and_isCyclic Nat.prime_two K hK4).1]
      at hdvd
    exact orderOf_dvd_iff_pow_eq_one.1 hdvd
  have hsub : Subsingleton kˣ := by
    have hc : Nat.card kˣ = 1 := by rw [Nat.card_units, hk2]
    exact (Nat.card_eq_one_iff_unique.1 hc).1
  have hs1 : s = 1 := by
    have hbot : thetaTorus (algebraMap k K) = ⊥ := by
      refine le_antisymm ?_ bot_le
      intro y hy
      rw [thetaTorus] at hy
      obtain ⟨a, rfl⟩ := hy
      have ha : a = 1 := Subsingleton.elim a 1
      rw [ha, map_one]
      exact Subgroup.one_mem _
    have hmem : (s : ModGL TwistTag.E6.tag K) ∈ (⊥ : Subgroup (ModGL TwistTag.E6.tag K)) := by
      rw [← hbot]
      exact hs
    simpa using hmem
  obtain ⟨X, hXJ, hXcyc, hXcard⟩ := exists_nonsplit_le_thetaRankOneGroup (f := f) hf1 hk hK
  have hXcard3 : Nat.card ↥X = 2 ^ 1 + 1 := by rw [hXcard, hf]
  have hfixk : ∀ c : k, δ.toRingHom ((algebraMap k K) c) = (algebraMap k K) c := by
    intro c
    have hc : c = 0 ∨ c = 1 := by
      rcases eq_or_ne c 0 with h | h
      · exact Or.inl h
      · exact Or.inr (congrArg Units.val (Subsingleton.elim (Units.mk0 c h) 1))
    rcases hc with rfl | rfl
    · simp
    · simp
  have hfixTheta : ∀ x ∈ thetaRankOneGroup (algebraMap k K),
      Units.map (entrywiseHom δ.toRingHom) x = x := by
    intro x hx
    rw [thetaRankOneGroup, thetaRootGroup, thetaNegRootGroup, ← Subgroup.closure_union] at hx
    induction hx using Subgroup.closure_induction with
    | mem z hz =>
        rcases hz with ⟨c, rfl⟩ | ⟨c, rfl⟩
        · rw [CFSG.HardMathSupport.Timmesfeld.LangTorus.entrywise_pinnedX_units, hfixk]
        · rw [CFSG.HardMathSupport.Timmesfeld.LangTorus.entrywise_pinnedX_units, hfixk]
    | one => simp
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv, ha]
  have hθ : rootChar (compatDiag TwistTag.E6 σ.toRingHom u) e6HighestRoot = 1 :=
    rootChar_theta_eq_one_two (σ := σ.toRingHom) hK1 hσ1 (compatDiag_perm u)
  have hdCent : thetaRankOneGroup (algebraMap k K) ≤
      Subgroup.centralizer
        {rootDiagUnit TwistTag.E6.tag (compatDiag TwistTag.E6 σ.toRingHom u)} :=
    thetaRankOneGroup_le_centralizer_rootDiagUnit (algebraMap k K) hθ
  have hcommH : ∀ x : ModGL TwistTag.E6.tag K, x ∈ thetaRankOneGroup (algebraMap k K) →
      (h : ModGL TwistTag.E6.tag K) * x = x * (h : ModGL TwistTag.E6.tag K) := by
    intro x hx
    have hL := (su6Levi_facts (k := k) (σ := σ.toRingHom) hf1 hk hK hσ).1 hh
    exact ((Subgroup.mem_centralizer_iff.1 hL) x hx).symm
  have hβX : ∀ x ∈ X.subgroupOf (twistedE6RootGroup K σ), β x = x := by
    intro x hx
    have hxJ : (x : ModGL TwistTag.E6.tag K) ∈ thetaRankOneGroup (algebraMap k K) :=
      hXJ (Subgroup.mem_subgroupOf.1 hx)
    have hΔx : compatDiagAutHom TwistTag.E6 K σ.toRingHom u x = x := by
      refine Subtype.ext ?_
      rw [hΔcoe u x]
      have hc := (Subgroup.mem_centralizer_singleton_iff.1 (hdCent hxJ))
      rw [← hc, mul_assoc, mul_inv_cancel, mul_one]
    have hδx : fieldActor (t := TwistTag.E6) σ δ x = x := by
      refine Subtype.ext ?_
      rw [hfield δ x]
      exact hfixTheta _ hxJ
    have h1 : β x = MulAut.conj h
        (MulAut.conj s (compatDiagAutHom TwistTag.E6 K σ.toRingHom u
          (fieldActor (t := TwistTag.E6) σ δ x))) := by
      rw [hβ]
      simp only [MulAut.mul_apply]
    calc β x = MulAut.conj h (MulAut.conj s (compatDiagAutHom TwistTag.E6 K σ.toRingHom u
          (fieldActor (t := TwistTag.E6) σ δ x))) := h1
      _ = MulAut.conj h (MulAut.conj s (compatDiagAutHom TwistTag.E6 K σ.toRingHom u x)) := by
            rw [hδx]
      _ = MulAut.conj h (MulAut.conj s x) := by rw [hΔx]
      _ = MulAut.conj h x := by rw [hs1]; simp
      _ = x := by
            rw [MulAut.conj_apply]
            refine Subtype.ext ?_
            simp only [Subgroup.coe_mul, Subgroup.coe_inv]
            rw [hcommH x hxJ, mul_assoc, mul_inv_cancel, mul_one]
  have hβD : ∀ x ∈ (su6Levi σ.toRingHom).subgroupOf (twistedE6RootGroup K σ), β x = x :=
    fun x hx => hfix x (Subgroup.mem_subgroupOf.1 hx)
  obtain ⟨n, m, hm, hord⟩ := Nat.exists_eq_two_pow_mul_odd (orderOf_pos β).ne'
  have hβn : (β ^ m) ^ 2 ^ n = 1 := by
    rw [← pow_mul, mul_comm, ← hord]
    exact pow_orderOf_eq_one β
  have hβmX : ∀ x ∈ X.subgroupOf (twistedE6RootGroup K σ), (β ^ m) x = x := by
    intro x hx
    have key : ∀ j : ℕ, (β ^ j) x = x := by
      intro j
      induction j with
      | zero => simp
      | succ i ih => rw [pow_succ, MulAut.mul_apply, hβX x hx, ih]
    exact key m
  have hβmD : ∀ x ∈ (su6Levi σ.toRingHom).subgroupOf (twistedE6RootGroup K σ),
      (β ^ m) x = x := by
    intro x hx
    have key : ∀ j : ℕ, (β ^ j) x = x := by
      intro j
      induction j with
      | zero => simp
      | succ i ih => rw [pow_succ, MulAut.mul_apply, hβD x hx, ih]
    exact key m
  have hβm1 : β ^ m = 1 :=
    eq_one_of_fix_nonsplit_two (k := k) (K := K) hk1 hK1 hσ1 hXJ hXcard3 hXcyc (β ^ m)
      hβmX hβmD n hβn
  have hδm : δ ^ m = 1 := by
    rw [← hΘβ, ← map_pow, hβm1, map_one]
  obtain ⟨j, hj⟩ := hm
  have hδeq : δ ^ m = δ := by
    rw [hj, pow_succ, pow_mul, hδ2, one_pow, one_mul]
  have hδ1 : δ = 1 := by
    rw [← hδeq, hδm]
  intro c
  rw [hδ1]
  rfl

end OneCase


section Aux

variable {f : ℕ} {k K : Type} [Field k] [Field K] [Algebra k K] [Finite k] [Finite K]
  [CharP K 2]


private theorem isPGroup_tRadical_subgroupOf (hf : 1 ≤ f) (hk : Nat.card k = 2 ^ f)
    (hK : Nat.card K = (2 ^ f) ^ 2) {σ : K ≃+* K} (hσ : ∀ c, σ c = c ^ 2 ^ f) :
    IsPGroup 2 ((tRadical σ.toRingHom).subgroupOf
      (graphFixedRootGroup TwistTag.E6 K σ.toRingHom)) := by
  obtain ⟨-, hT⟩ := even_E6_graph_highest_root_normalizer f hf k K hk hK σ.toRingHom hσ
  obtain ⟨S, hS⟩ := hT.2.2.2.2.2.2.2.2.2.1
  refine S.isPGroup'.to_le ?_
  rw [hS]
  intro x hx
  rw [Subgroup.mem_subgroupOf] at hx ⊢
  exact Subgroup.mem_inf.2 ⟨parabolicRadical_le_posUnipotent _ (Subgroup.mem_inf.1 hx).1,
    graphFixedRootGroup_le _ _ _ x.2⟩

private theorem pCoreOf_centralizer_stdRepC (hf : 1 ≤ f) (hk : Nat.card k = 2 ^ f)
    (hK : Nat.card K = (2 ^ f) ^ 2) {σ : K ≃+* K} (hσ : ∀ c, σ c = c ^ 2 ^ f) :
    pCoreOf 2 (Subgroup.centralizer ({stdRepC (apply_apply_eq hK hσ) 0} :
      Set (graphFixedRootGroup TwistTag.E6 K σ.toRingHom))) =
      (tRadical σ.toRingHom).subgroupOf (graphFixedRootGroup TwistTag.E6 K σ.toRingHom) := by
  set C₀ := graphFixedRootGroup TwistTag.E6 K σ.toRingHom with hC₀
  haveI : Finite (ModGL TwistTag.E6.tag K) := finite_modGL
  have hCx : Subgroup.centralizer ({stdRepC (apply_apply_eq hK hσ) 0} : Set C₀) =
      (tRadical σ.toRingHom).subgroupOf C₀ ⊔ (su6Levi σ.toRingHom).subgroupOf C₀ :=
    centralizer_stdRepC_zero_eq (k := k) (σ := σ.toRingHom) hf hk hK hσ
  obtain ⟨-, hLN, hQL⟩ := centralizer_stdRep_zero_inf_eq (k := k) (σ := σ.toRingHom) hf hk hK hσ
  have hLQ : (su6Levi σ.toRingHom).subgroupOf C₀ ≤
      Subgroup.normalizer ((tRadical σ.toRingHom).subgroupOf C₀ : Set C₀) := by
    intro x hx
    rw [Subgroup.mem_subgroupOf] at hx
    rw [Subgroup.mem_normalizer_iff]
    intro y
    simp only [Subgroup.mem_subgroupOf, Subgroup.coe_mul, Subgroup.coe_inv]
    exact Subgroup.mem_normalizer_iff.1 (hLN hx) y
  have hQ2 : IsPGroup 2 ((tRadical σ.toRingHom).subgroupOf C₀) :=
    isPGroup_tRadical_subgroupOf hf hk hK hσ
  have hZ : Subgroup.center ↥((su6Levi σ.toRingHom).subgroupOf C₀) = ⊥ := by
    haveI : IsSimpleGroup (su6Levi σ.toRingHom) :=
      isSimpleGroup_su6Levi (σ := σ.toRingHom) hf hk hK hσ
    have hnc : ∃ a b : su6Levi σ.toRingHom, a * b ≠ b * a := by
      by_contra hc
      push Not at hc
      have hperf := isPerfect_su6Levi (σ := σ.toRingHom) hf hk hK hσ
      exact Group.IsPerfect.not_isMulCommutative _ ⟨⟨fun a b => hc a b⟩⟩
    have hZsu : Subgroup.center (su6Levi σ.toRingHom) = ⊥ :=
      (CFSG.LocalCores.isQuasisimple_of_isSimpleGroup hnc).2
    exact CFSG.SeitzReduction.F4Pilot.center_eq_bot_congr
      (Subgroup.subgroupOfEquivOfLe (su6Levi_le_graphFixedRootGroup σ.toRingHom)).symm hZsu
  refine ggRCST_pCoreOf_eq hCx hQ2 hLQ ?_
  intro N hNL hN2 hNN
  have hNn : (N.subgroupOf ((su6Levi σ.toRingHom).subgroupOf C₀)).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hNL).2 hNN
  have hN2' : IsPGroup 2 (N.subgroupOf ((su6Levi σ.toRingHom).subgroupOf C₀)) :=
    hN2.comap_of_injective _ ((su6Levi σ.toRingHom).subgroupOf C₀).subtype_injective
  have hbot := CFSG.SeitzReduction.OmegaPilot.normal_isPGroup_eq_bot_of_isQuasisimple
    (isQuasisimple_su6Levi_subgroupOf hf hk hK hσ) hZ
    (N.subgroupOf ((su6Levi σ.toRingHom).subgroupOf C₀)) hNn hN2'
  rw [eq_bot_iff]
  intro x hx
  rw [Subgroup.mem_bot]
  have hxm : (⟨x, hNL hx⟩ : ↥((su6Levi σ.toRingHom).subgroupOf C₀)) ∈
      N.subgroupOf ((su6Levi σ.toRingHom).subgroupOf C₀) := hx
  rw [hbot, Subgroup.mem_bot] at hxm
  exact congrArg Subtype.val hxm

end Aux

section Main

variable {f : ℕ} {K : Type} [Field K] [Finite K] [CharP K 2]


theorem pCoreOf_le_range_of_highRoot_twE6 (hf : 1 ≤ f)
    (hK : Nat.card K = (2 ^ f) ^ 2) {σ : K ≃+* K} (hσ : ∀ c, σ c = c ^ 2 ^ f)
    {G : Type} [Group G] {ψ : graphFixedRootGroup TwistTag.E6 K σ.toRingHom →* G}
    (hψ : Function.Injective ψ) (hC : Subgroup.centralizer (ψ.range : Set G) = ⊥)
    {t : graphFixedRootGroup TwistTag.E6 K σ.toRingHom}
    (ht : (t : ModGL TwistTag.E6.tag K) = pinnedX TwistTag.E6.tag K e6HighestRoot 1) :
    pCoreOf 2 (Subgroup.normalizer (ψ.range : Set G) ⊓ Subgroup.centralizer {ψ t}) ≤
      ψ.range := by
  have hk : Nat.card (GaloisField 2 f) = 2 ^ f := GaloisField.card 2 f (by omega)
  obtain ⟨ι⟩ := CFSG.LieType.Chevalley.E6GraphFullCoset.nonempty_ringHom_of_card hf hk hK
  letI : Algebra (GaloisField 2 f) K := ι.toAlgebra
  intro a ha
  let C₀ := graphFixedRootGroup TwistTag.E6 K σ.toRingHom
  haveI : Finite (ModGL TwistTag.E6.tag K) := finite_modGL
  have haM : a ∈ Subgroup.normalizer (ψ.range : Set G) ⊓ Subgroup.centralizer {ψ t} :=
    GGRootNorm.pCoreOf_le _ ha
  have ha_norm : a ∈ Subgroup.normalizer (ψ.range : Set G) := haM.1
  obtain ⟨α, hα, hαord⟩ := exists_mulAut_conj_of_mem_normalizer hψ ha_norm
  obtain ⟨-, -, -, -, -, hΔcoe, hfield, hnf, ⟨Θ, hΘ, -, hker, -, hexp, -⟩, -, -, -, -, -⟩ :=
    twisted_E6_all_characteristic_exact_automorphism_normal_form Nat.prime_two hf K hK σ hσ
  obtain ⟨g, u, δ, hαform⟩ := hnf α
  have hΘα : Θ α = δ := hΘ α g u δ hαform
  obtain ⟨s, hsT, hst⟩ :=
    exists_conj_normalActor_pinnedX_fixed (k := GaloisField 2 f) hf hk hK hσ u δ
  set c : MulAut C₀ := MulAut.conj s * compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
    fieldActor (t := TwistTag.E6) σ δ with hc
  have ht0 : t = stdRepC (apply_apply_eq hK hσ) 0 := Subtype.ext (by rw [ht]; rfl)
  have hc0 : c.toMonoidHom t = t := by
    have h := hst
    rw [← ht0] at h
    exact h
  have hαc : α = MulAut.conj (g * s⁻¹) * c := by
    rw [hαform, hc, map_mul, map_inv]
    group
  have hconj : ∀ x : graphFixedRootGroup TwistTag.E6 K σ.toRingHom,
      a * ψ x * a⁻¹ = ψ (g * s⁻¹ * c.toMonoidHom x * (g * s⁻¹)⁻¹) := by
    intro x
    rw [hα x, hαc]
    simp only [MulAut.mul_apply, MulAut.conj_apply]
    rfl
  have hCx : Subgroup.centralizer ({t} : Set C₀) =
      (tRadical σ.toRingHom).subgroupOf C₀ ⊔ (su6Levi σ.toRingHom).subgroupOf C₀ := by
    rw [ht0]
    exact centralizer_stdRepC_zero_eq (k := GaloisField 2 f) (σ := σ.toRingHom) hf hk hK hσ
  obtain ⟨-, hLN, hQL⟩ :=
    centralizer_stdRep_zero_inf_eq (k := GaloisField 2 f) (σ := σ.toRingHom) hf hk hK hσ
  have hLQ : (su6Levi σ.toRingHom).subgroupOf C₀ ≤
      Subgroup.normalizer ((tRadical σ.toRingHom).subgroupOf C₀ : Set C₀) := by
    intro x hx
    rw [Subgroup.mem_subgroupOf] at hx
    rw [Subgroup.mem_normalizer_iff]
    intro y
    simp only [Subgroup.mem_subgroupOf, Subgroup.coe_mul, Subgroup.coe_inv]
    exact Subgroup.mem_normalizer_iff.1 (hLN hx) y
  have hdisj : Disjoint ((tRadical σ.toRingHom).subgroupOf C₀)
      ((su6Levi σ.toRingHom).subgroupOf C₀) := by
    rw [disjoint_iff]
    refine le_antisymm ?_ bot_le
    intro x hx
    rw [Subgroup.mem_bot]
    have hxbot : (x : ModGL TwistTag.E6.tag K) ∈
        (⊥ : Subgroup (ModGL TwistTag.E6.tag K)) := by
      rw [← hQL]
      exact Subgroup.mem_inf.2 ⟨(Subgroup.mem_inf.1 hx).1, (Subgroup.mem_inf.1 hx).2⟩
    simpa using hxbot
  have hQ2 : IsPGroup 2 ((tRadical σ.toRingHom).subgroupOf C₀) :=
    isPGroup_tRadical_subgroupOf hf hk hK hσ
  have hQ : pCoreOf 2 (Subgroup.centralizer ({t} : Set C₀)) =
      (tRadical σ.toRingHom).subgroupOf C₀ := by
    rw [ht0]
    exact pCoreOf_centralizer_stdRepC hf hk hK hσ
  have hcL : ∀ x : C₀, (x : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom →
      ((c x : C₀) : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom := by
    intro x hx
    set y : C₀ := (compatDiagAutHom TwistTag.E6 K σ.toRingHom u)
      ((fieldActor (t := TwistTag.E6) σ δ) x) with hydef
    have hy : (y : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom :=
      normalActor_mapsTo_su6Levi hf hk hK hσ u δ hx
    have h2 : (2 : K) = 0 := CharTwo.two_eq_zero
    have hsJ : (s : ModGL TwistTag.E6.tag K) ∈
        thetaRankOneGroup (algebraMap (GaloisField 2 f) K) :=
      thetaTorus_le_thetaRankOneGroup h2 (algebraMap (GaloisField 2 f) K) hsT
    have hLcent := (su6Levi_facts (k := GaloisField 2 f) (σ := σ.toRingHom) hf hk hK hσ).1
    have hcomm : (s : ModGL TwistTag.E6.tag K) * (y : ModGL TwistTag.E6.tag K) =
        (y : ModGL TwistTag.E6.tag K) * (s : ModGL TwistTag.E6.tag K) :=
      (Subgroup.mem_centralizer_iff.1 (hLcent hy)) _ hsJ
    have hcx : c x = y := by
      refine Subtype.ext ?_
      rw [hc]
      simp only [MulAut.mul_apply, MulAut.conj_apply, Subgroup.coe_mul, Subgroup.coe_inv]
      rw [hcomm, mul_assoc, mul_inv_cancel, mul_one]
    rw [hcx]
    exact hy
  obtain ⟨h, hh, hkey⟩ := KGRig.exists_levi_conj_eq_of_mem_pCoreOf hψ hCx hLQ hdisj hQ ha
    hc0 hconj
  have hfix : ∀ x : C₀, (x : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom →
      (MulAut.conj h * c) x = x := by
    intro x hx
    have hxL : x ∈ (su6Levi σ.toRingHom).subgroupOf C₀ := Subgroup.mem_subgroupOf.2 hx
    have hcxL : c x ∈ (su6Levi σ.toRingHom).subgroupOf C₀ :=
      Subgroup.mem_subgroupOf.2 (hcL x hx)
    have h := hkey x hxL hcxL
    rw [MulAut.mul_apply, MulAut.conj_apply]
    exact h
  have hδ1 : ∀ c, δ c = c := by
    rcases (show f = 1 ∨ 2 ≤ f by omega) with h1 | h2
    · exact delta_eq_one_of_fix_su6Levi_one h1 hk hK hσ u δ h s hh hsT hfix
    · exact delta_eq_one_of_fix_su6Levi_two_le h2 hk hK hσ u δ h s hfix
  have hδeq : δ = 1 := RingEquiv.ext hδ1
  have hαI : α ∈ twistedE6Inn K σ := by
    have hmem : α ∈ twistedE6Inn K σ ⊔ twistedE6Diag K σ := by
      rw [← hker]
      exact MonoidHom.mem_ker.2 (by rw [hΘα, hδeq])
    obtain ⟨na, hna⟩ : ∃ na, orderOf a ∣ 2 ^ na := by
      have hP : IsPGroup 2 ↥(pCoreOf 2 (Subgroup.normalizer (ψ.range : Set G) ⊓
          Subgroup.centralizer {ψ t})) := GGRootNorm.isPGroup_pCoreOf _
      obtain ⟨k, hk⟩ := hP ⟨a, ha⟩
      refine ⟨k, ?_⟩
      have h2 : orderOf (⟨a, ha⟩ : ↥(pCoreOf 2 (Subgroup.normalizer (ψ.range : Set G) ⊓
          Subgroup.centralizer {ψ t}))) ∣ 2 ^ k := orderOf_dvd_of_pow_eq_one hk
      have h3 : orderOf (⟨a, ha⟩ : ↥(pCoreOf 2 (Subgroup.normalizer (ψ.range : Set G) ⊓
          Subgroup.centralizer {ψ t}))) = orderOf a :=
        (Subgroup.orderOf_coe ⟨a, ha⟩).symm
      rwa [h3] at h2
    let N : Subgroup ↥(twistedE6Inn K σ ⊔ twistedE6Diag K σ) :=
      (twistedE6Inn K σ).subgroupOf (twistedE6Inn K σ ⊔ twistedE6Diag K σ)
    let q : ↥(twistedE6Inn K σ ⊔ twistedE6Diag K σ) ⧸ N :=
      QuotientGroup.mk' N ⟨α, hmem⟩
    have hq3 : q ^ 3 = 1 := hexp q
    have hq_dvd3 : orderOf q ∣ 3 := orderOf_dvd_of_pow_eq_one hq3
    have hq_dvd2 : orderOf q ∣ 2 ^ na := by
      have hdvd : orderOf q ∣ orderOf α := by
        have h := orderOf_map_dvd (QuotientGroup.mk' N) ⟨α, hmem⟩
        have h2 : orderOf (⟨α, hmem⟩ : ↥(twistedE6Inn K σ ⊔ twistedE6Diag K σ)) =
            orderOf α := (Subgroup.orderOf_coe ⟨α, hmem⟩).symm
        rwa [h2] at h
      exact (hdvd.trans hαord).trans hna
    have hq1 : q = 1 := by
      have hcop : Nat.Coprime 3 (2 ^ na) := (by decide : Nat.Coprime 3 2).pow_right na
      have hdvd : orderOf q ∣ 1 := by
        rw [← hcop.gcd_eq_one]
        exact Nat.dvd_gcd hq_dvd3 hq_dvd2
      exact orderOf_eq_one_iff.1 (Nat.dvd_one.1 hdvd)
    have hmem' : (⟨α, hmem⟩ : ↥(twistedE6Inn K σ ⊔ twistedE6Diag K σ)) ∈ N := by
      rw [← QuotientGroup.eq_one_iff]
      exact hq1
    exact Subgroup.mem_subgroupOf.1 hmem'
  obtain ⟨g', hg'⟩ := hαI
  refine KGRig.mem_range_of_conj_eq hC ha_norm (g := g') fun x => ?_
  rw [hα x, ← hg']
  rfl

end Main

