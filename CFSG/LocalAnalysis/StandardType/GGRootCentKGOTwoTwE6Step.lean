theorem exists_conj_normalActor_pinnedX_fixed (hf : 1 ≤ f) (hk : Nat.card k = 2 ^ f)
    (hK : Nat.card K = (2 ^ f) ^ 2) {σ : K ≃+* K} (hσ : ∀ c, σ c = c ^ 2 ^ f)
    (u : (a : Fin TwistTag.E6.foldedTag.rank) →
      (orbitField TwistTag.E6 K σ.toRingHom a)ˣ) (δ : K ≃+* K) :
    ∃ s : twistedE6RootGroup K σ, (s : ModGL TwistTag.E6.tag K) ∈ thetaTorus (algebraMap k K) ∧
      ((MulAut.conj (G := twistedE6RootGroup K σ) s *
        compatDiagAutHom TwistTag.E6 K σ.toRingHom u * fieldActor (t := TwistTag.E6) σ δ :
          MulAut (twistedE6RootGroup K σ)))
        (stdRepC (apply_apply_eq hK hσ) 0) = stdRepC (apply_apply_eq hK hσ) 0 := by
  classical
  haveI : Fintype k := Fintype.ofFinite k
  have h2 : (2 : K) = 0 := CharTwo.two_eq_zero
  set C₀ := twistedE6RootGroup K σ with hC₀
  set t : C₀ := stdRepC (apply_apply_eq hK hσ) 0 with ht
  have htcoe : (t : ModGL TwistTag.E6.tag K) = pinnedX TwistTag.E6.tag K e6HighestRoot 1 :=
    rfl
  obtain ⟨-, -, -, -, -, hΔcoe, hfield, -, -, -, -, -, -, -⟩ :=
    twisted_E6_all_characteristic_exact_automorphism_normal_form Nat.prime_two hf K hK σ hσ
  set d : Fin TwistTag.E6.tag.rank → Kˣ := compatDiag TwistTag.E6 σ.toRingHom u with hd
  have hΔt : ((compatDiagAutHom TwistTag.E6 K σ.toRingHom u t : C₀) : ModGL TwistTag.E6.tag K) =
      pinnedX TwistTag.E6.tag K e6HighestRoot ((rootChar d e6HighestRoot : Kˣ) : K) := by
    rw [hΔcoe u t, htcoe, rootDiagUnit_conj_pinnedX d isRoot_e6HighestRoot 1, mul_one]
  have hδt : fieldActor (t := TwistTag.E6) σ δ t = t := by
    refine Subtype.ext ?_
    rw [hfield δ t, htcoe, CFSG.HardMathSupport.Timmesfeld.LangTorus.entrywise_pinnedX_units,
      map_one]
  have hμfix : σ ((rootChar d e6HighestRoot : Kˣ) : K) =
      ((rootChar d e6HighestRoot : Kˣ) : K) := by
    have hmem : ((compatDiagAutHom TwistTag.E6 K σ.toRingHom u t : C₀) : ModGL TwistTag.E6.tag K) ∈
        twistedFixedGroup TwistTag.E6 K σ.toRingHom :=
      graphFixedRootGroup_le _ _ _ (compatDiagAutHom TwistTag.E6 K σ.toRingHom u t).2
    have htw := (mem_twistedFixedGroup_iff_twistHom TwistTag.E6 K σ.toRingHom).1 hmem |>.2
    rw [hΔt, twistHom_pinnedX_eq_of_charTwo (t := TwistTag.E6) h2 σ.toRingHom
      isRoot_e6HighestRoot, permLattice_e6HighestRoot] at htw
    exact pinnedX_injective TwistTag.E6.tag K e6HighestRoot htw
  obtain ⟨μ₀, hμ₀⟩ : ∃ μ₀ : k, algebraMap k K μ₀ = ((rootChar d e6HighestRoot : Kˣ) : K) :=
    (sigma_eq_self_iff (f := f) (k := k) (K := K) (σ := σ.toRingHom) hk hσ _).1 hμfix
  have hμ₀ne : μ₀ ≠ 0 := by
    intro h
    rw [h, map_zero] at hμ₀
    exact (rootChar d e6HighestRoot).ne_zero hμ₀.symm
  have hxK : ∀ x : kˣ, x ^ 2 ^ f = x := by
    intro x
    refine Units.ext ?_
    have hc : Fintype.card k = 2 ^ f := by
      rw [← Nat.card_eq_fintype_card]
      exact hk
    rw [← hc]
    exact FiniteField.pow_card (x : k)
  obtain ⟨l₀, hl₀⟩ : ∃ l : kˣ, l ^ 2 = (Units.mk0 μ₀ hμ₀ne)⁻¹ := by
    refine ⟨(Units.mk0 μ₀ hμ₀ne)⁻¹ ^ 2 ^ (f - 1), ?_⟩
    rw [← pow_mul, show 2 ^ (f - 1) * 2 = 2 ^ f by rw [← pow_succ, Nat.sub_add_cancel hf],
      hxK]
  have hμu : Units.map (algebraMap k K).toMonoidHom (Units.mk0 μ₀ hμ₀ne) =
      rootChar d e6HighestRoot := Units.ext hμ₀
  have hlu : Units.map (algebraMap k K).toMonoidHom l₀ ^ 2 =
      (Units.map (algebraMap k K).toMonoidHom (Units.mk0 μ₀ hμ₀ne))⁻¹ := by
    rw [← map_pow, hl₀, map_inv]
  have hparam : (((Units.map (algebraMap k K).toMonoidHom l₀ : Kˣ) ^ 2 : Kˣ) : K) *
      ((rootChar d e6HighestRoot : Kˣ) : K) = 1 := by
    have h1 : (Units.map (algebraMap k K).toMonoidHom l₀ : Kˣ) ^ 2 *
        rootChar d e6HighestRoot = 1 := by rw [hlu, hμu, inv_mul_cancel]
    simpa using congrArg (fun x : Kˣ => (x : K)) h1
  set s : C₀ := ⟨rootDiagUnit TwistTag.E6.tag
      (EPilot.highDiag TwistTag.E6.tag (Units.map (algebraMap k K).toMonoidHom l₀)),
    thetaTorus_le_C0 hf hk hK hσ (rootDiagUnit_highDiag_mem_thetaTorus (algebraMap k K) l₀)⟩
    with hs
  refine ⟨s, rootDiagUnit_highDiag_mem_thetaTorus (algebraMap k K) l₀, ?_⟩
  refine Subtype.ext ?_
  rw [MulAut.mul_apply, MulAut.mul_apply, MulAut.conj_apply, hδt]
  simp only [Subgroup.coe_mul, Subgroup.coe_inv]
  rw [hΔt, htcoe,
    show (s : ModGL TwistTag.E6.tag K) = rootDiagUnit TwistTag.E6.tag
      (EPilot.highDiag TwistTag.E6.tag (Units.map (algebraMap k K).toMonoidHom l₀)) from rfl,
    rootDiagUnit_conj_pinnedX _ isRoot_e6HighestRoot, EPilot.rootChar_highDiag,
    show e6HighestRoot (highNode TwistTag.E6.tag) = 2 from by decide]
  exact congrArg (pinnedX TwistTag.E6.tag K e6HighestRoot) hparam

theorem normalActor_mapsTo_su6Levi (hf : 1 ≤ f) (hk : Nat.card k = 2 ^ f)
    (hK : Nat.card K = (2 ^ f) ^ 2) {σ : K ≃+* K} (hσ : ∀ c, σ c = c ^ 2 ^ f)
    (u : (a : Fin TwistTag.E6.foldedTag.rank) →
      (orbitField TwistTag.E6 K σ.toRingHom a)ˣ) (δ : K ≃+* K)
    {x : twistedE6RootGroup K σ} (hx : (x : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom) :
    (((compatDiagAutHom TwistTag.E6 K σ.toRingHom u * fieldActor (t := TwistTag.E6) σ δ) x :
        twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom := by
  obtain ⟨-, -, -, -, hD, -⟩ := su6Levi_facts (k := k) (σ := σ.toRingHom) hf hk hK hσ
  obtain ⟨-, -, -, -, -, hΔcoe, hfield, -, -, -, -, -, -, -⟩ :=
    twisted_E6_all_characteristic_exact_automorphism_normal_form Nat.prime_two hf K hK σ hσ
  rw [hD] at hx ⊢
  refine ⟨?_, ?_⟩
  · have hcoe : (((compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
        fieldActor (t := TwistTag.E6) σ δ) x : twistedE6RootGroup K σ) :
        ModGL TwistTag.E6.tag K) =
        rootDiagUnit TwistTag.E6.tag (compatDiag TwistTag.E6 σ.toRingHom u) *
          Units.map (entrywiseHom δ.toRingHom) (x : ModGL TwistTag.E6.tag K) *
          (rootDiagUnit TwistTag.E6.tag (compatDiag TwistTag.E6 σ.toRingHom u))⁻¹ := by
      rw [MulAut.mul_apply, hΔcoe u (fieldActor (t := TwistTag.E6) σ δ x), hfield δ x]
    rw [hcoe]
    exact CFSG.LieType.Chevalley.RootTorus.conj_rootDiagUnit_mem_subsystemGroup _
      (compatDiag TwistTag.E6 σ.toRingHom u)
      (CFSG.RankThree.Chevalley.EvenF4QPlus.units_map_entrywiseHom_mem_subsystemGroup
        δ.toRingHom hx.1)
  · exact graphFixedRootGroup_le _ _ _ ((compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
      fieldActor (t := TwistTag.E6) σ δ) x).2

theorem delta_eq_one_of_fix_su6Levi_two_le {f : ℕ} (hf2 : 2 ≤ f) (hk : Nat.card k = 2 ^ f)
    (hK : Nat.card K = (2 ^ f) ^ 2) {σ : K ≃+* K} (hσ : ∀ c, σ c = c ^ 2 ^ f)
    (u : (a : Fin TwistTag.E6.foldedTag.rank) →
      (orbitField TwistTag.E6 K σ.toRingHom a)ˣ) (δ : K ≃+* K)
    (h s : twistedE6RootGroup K σ)
    (hfix : ∀ x : twistedE6RootGroup K σ, (x : ModGL TwistTag.E6.tag K) ∈ su6Levi σ.toRingHom →
      (MulAut.conj h * (MulAut.conj s * compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
        fieldActor (t := TwistTag.E6) σ δ)) x = x) :
    ∀ c, δ c = c := by
  have hf : 1 ≤ f := by omega
  obtain ⟨-, -, -, -, hD, -⟩ := su6Levi_facts (k := k) (σ := σ.toRingHom) hf hk hK hσ
  obtain ⟨-, -, -, -, -, hΔcoe, hfield, -, -, -, -, -, -, -⟩ :=
    twisted_E6_all_characteristic_exact_automorphism_normal_form Nat.prime_two hf K hK σ hσ
  have hgA : ((h * s : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) ∈
      adjointGroup Tag.E6 K :=
    ((mem_twistedFixedGroup_iff_twistHom TwistTag.E6 K σ.toRingHom).1
      (graphFixedRootGroup_le _ _ _ (h * s).2)).1
  have hkey : ∀ x : ModGL TwistTag.E6.tag K, x ∈ su6Levi σ.toRingHom →
      ((h * s : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) *
        (rootDiagUnit TwistTag.E6.tag (compatDiag TwistTag.E6 σ.toRingHom u) *
          Units.map (entrywiseHom δ.toRingHom) x *
          (rootDiagUnit TwistTag.E6.tag (compatDiag TwistTag.E6 σ.toRingHom u))⁻¹) *
        (((h * s : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K))⁻¹ = x := by
    intro x hx
    have hxC : x ∈ graphFixedRootGroup TwistTag.E6 K σ.toRingHom :=
      su6Levi_le_graphFixedRootGroup σ.toRingHom hx
    set x' : twistedE6RootGroup K σ := ⟨x, hxC⟩ with hx'
    have h1 := hfix x' hx
    have h2 : (((MulAut.conj h * (MulAut.conj s * compatDiagAutHom TwistTag.E6 K σ.toRingHom u *
        fieldActor (t := TwistTag.E6) σ δ)) x' : twistedE6RootGroup K σ) :
        ModGL TwistTag.E6.tag K) =
        ((h * s : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K) *
          (rootDiagUnit TwistTag.E6.tag (compatDiag TwistTag.E6 σ.toRingHom u) *
            Units.map (entrywiseHom δ.toRingHom) x *
            (rootDiagUnit TwistTag.E6.tag (compatDiag TwistTag.E6 σ.toRingHom u))⁻¹) *
          (((h * s : twistedE6RootGroup K σ) : ModGL TwistTag.E6.tag K))⁻¹ := by
      simp only [MulAut.mul_apply, MulAut.conj_apply, Subgroup.coe_mul, Subgroup.coe_inv]
      rw [hΔcoe u (fieldActor (t := TwistTag.E6) σ δ x'), hfield δ x',
        show (x' : ModGL TwistTag.E6.tag K) = x from rfl]
      group
    rw [← h2]
    exact congrArg Subtype.val h1
  exact (core_X hf2 hk hK hσ hgA (compatDiag TwistTag.E6 σ.toRingHom u) δ hkey).1

