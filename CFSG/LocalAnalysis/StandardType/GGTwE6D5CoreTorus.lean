theorem torusGroup_le_charKerTorus_sup {L : Type} [Field L] [IsAlgClosed L]
    (v : WeylGroup Tag.E6) {J : Set (Fin Tag.E6.rank)} (hJ : J = d5NodesA ∨ J = d5NodesB) :
    torusGroup Tag.E6 L ≤
      charKerTorus Tag.E6 L ((fun α => v • α) '' parabolicRoots Tag.E6 J) ⊔
        rootSpan Tag.E6 L ((fun α => v • α) '' parabolicRoots Tag.E6 J) := by
  classical
  intro t ht
  obtain ⟨b, rfl⟩ := exists_rootDiagUnit_eq_of_mem_torusGroup ht
  obtain ⟨a, ha⟩ := exists_d5_solution hJ (T1b.weylAct v⁻¹ b)
  have hs := supportedTorusHom_mem (K := L) J a
  rw [supportedTorusHom_eq_rootDiagUnit, ← torusGroup_inf_rootSpan_parabolicRoots] at hs
  obtain ⟨e, hs, hei⟩ : ∃ e : Fin Tag.E6.rank → Lˣ,
      rootDiagUnit Tag.E6 e ∈ rootSpan Tag.E6 L (parabolicRoots Tag.E6 J) ∧
        ∀ i ∈ J, e i = T1b.weylAct v⁻¹ b i := ⟨_, (Subgroup.mem_inf.1 hs).2, ha⟩
  have hb : rootDiagUnit Tag.E6 b =
      rootDiagUnit Tag.E6 (T1b.weylAct v (T1b.weylAct v⁻¹ b * e⁻¹)) *
        (canonicalRep (coxeterSystem Tag.E6) L v * rootDiagUnit Tag.E6 e *
          (canonicalRep (coxeterSystem Tag.E6) L v)⁻¹) := by
    conv_rhs => rw [← T1b.canonicalRep_conj_rootDiagUnit,
      CFSG.LieType.Chevalley.rootDiagUnit_mul, ← CFSG.LieType.Chevalley.rootDiagUnit_inv]
    conv_lhs => rw [← T1b.weylAct_one b, ← mul_inv_cancel v, T1b.weylAct_mul,
      ← T1b.canonicalRep_conj_rootDiagUnit]
    group
  rw [hb]
  refine Subgroup.mul_mem_sup (mem_charKerTorus.2 ⟨_, fun γ hγ => ?_, rfl⟩)
    (CFSG.HardMathSupport.Lang.TwE6Step3.canonicalRep_conj_mem_rootSpan
      (S := parabolicRoots Tag.E6 J) (S' := (fun α => v • α) '' parabolicRoots Tag.E6 J) v
      (fun γ hγ => ⟨hγ.1, γ, hγ, rfl⟩) hs)
  obtain ⟨α, hα, rfl⟩ := hγ
  rw [T1b.rootChar_weylAct, inv_smul_smul, rootChar]
  refine Finset.prod_eq_one fun i _ => ?_
  by_cases hi : i ∈ J
  · rw [Pi.mul_apply, Pi.inv_apply, hei i hi, mul_inv_cancel, one_zpow]
  · rw [hα.2 i hi, zpow_zero]

theorem charKerTorus_inf_rootSpan {L : Type} [Field L] [IsAlgClosed L] [CharP L 2]
    (v : WeylGroup Tag.E6) {J : Set (Fin Tag.E6.rank)} (hJ : J = d5NodesA ∨ J = d5NodesB) :
    charKerTorus Tag.E6 L ((fun α => v • α) '' parabolicRoots Tag.E6 J) ⊓
      rootSpan Tag.E6 L ((fun α => v • α) '' parabolicRoots Tag.E6 J) = ⊥ := by
  classical
  refine (Subgroup.eq_bot_iff_forall _).2 fun g hg => ?_
  obtain ⟨hgK, hgU⟩ := Subgroup.mem_inf.1 hg
  obtain ⟨b, hb, rfl⟩ := mem_charKerTorus.1 hgK
  have hconj : (canonicalRep (coxeterSystem Tag.E6) L v)⁻¹ * rootDiagUnit Tag.E6 b *
      canonicalRep (coxeterSystem Tag.E6) L v = rootDiagUnit Tag.E6 (T1b.weylAct v⁻¹ b) := by
    conv_lhs => rw [← T1b.weylAct_one b, ← mul_inv_cancel v, T1b.weylAct_mul,
      ← T1b.canonicalRep_conj_rootDiagUnit]
    group
  have hmem : rootDiagUnit Tag.E6 (T1b.weylAct v⁻¹ b) ∈ supportedTorus Tag.E6 L J := by
    rw [← hconj, ← torusGroup_inf_rootSpan_parabolicRoots]
    refine Subgroup.mem_inf.2 ⟨canonicalRep_inv_conj_mem_torusGroup v
      (rootDiagUnit_mem_torusGroup b),
      CFSG.HardMathSupport.Lang.TwE6Step3.canonicalRep_inv_conj_mem_rootSpan v
        (fun γ hγ => ?_) hgU⟩
    obtain ⟨α, hα, rfl⟩ := hγ
    exact ⟨IsRoot.smul hα.1 v, by rwa [inv_smul_smul]⟩
  obtain ⟨a, ha⟩ := mem_supportedTorus.1 hmem
  have htuple := CFSG.LieType.Chevalley.rootDiagUnit_injective
    ((supportedTorusHom_eq_rootDiagUnit J a).symm.trans ha)
  have ha1 : a = 1 := eq_one_of_d5_solution hJ fun i hi => by
    rw [show (∏ j : J, a j ^ Tag.E6.cartan j i) = T1b.weylAct v⁻¹ b i from congrFun htuple i]
    show rootChar b ((v⁻¹)⁻¹ • Pi.single i 1) = 1
    rw [inv_inv]
    exact hb _ ⟨Pi.single i 1, ⟨isRoot_single Tag.E6 i, fun k hk =>
      Pi.single_eq_of_ne (fun (h : k = i) => hk (h ▸ hi)) 1⟩, rfl⟩
  rw [ha1, map_one] at ha
  calc rootDiagUnit Tag.E6 b = canonicalRep (coxeterSystem Tag.E6) L v *
        ((canonicalRep (coxeterSystem Tag.E6) L v)⁻¹ * rootDiagUnit Tag.E6 b *
          canonicalRep (coxeterSystem Tag.E6) L v) *
        (canonicalRep (coxeterSystem Tag.E6) L v)⁻¹ := by group
    _ = 1 := by rw [hconj, ← ha, mul_one, mul_inv_cancel]

end Torus

theorem isCyclic_of_le_charKerTorus
    {L : Type} [Field L] (v : WeylGroup Tag.E6)
    {J : Set (Fin Tag.E6.rank)} (hJ : J = d5NodesA ∨ J = d5NodesB)
    {Z : Subgroup (ModGL Tag.E6 L)} [Finite Z]
    (hZ : Z ≤ charKerTorus Tag.E6 L ((fun α => v • α) '' parabolicRoots Tag.E6 J)) :
    IsCyclic Z := by
  obtain ⟨j₀, hj₀⟩ : ∃ j₀ : Fin Tag.E6.rank, ∀ i, i ≠ j₀ → i ∈ J := by
    rcases hJ with rfl | rfl
    · refine ⟨⟨0, by decide +kernel⟩, ?_⟩
      show ∀ i : Fin Tag.E6.rank, i ≠ ⟨0, by decide +kernel⟩ → 1 ≤ i.val
      decide +kernel
    · refine ⟨⟨5, by decide +kernel⟩, ?_⟩
      show ∀ i : Fin Tag.E6.rank, i ≠ ⟨5, by decide +kernel⟩ → i.val ≤ 4
      decide +kernel
  choose β hβS hβ using fun g : Z => mem_charKerTorus.1 (hZ g.2)
  have hβmul : ∀ g h : Z, β (g * h) = β g * β h := fun g h =>
    CFSG.LieType.Chevalley.rootDiagUnit_injective (by
      rw [hβ, CFSG.LieType.Chevalley.rootDiagUnit_mul, hβ, hβ, Subgroup.coe_mul])
  have hβone : β 1 = 1 := CFSG.LieType.Chevalley.rootDiagUnit_injective (by
    rw [hβ, CFSG.LieType.Chevalley.rootDiagUnit_one, Subgroup.coe_one])
  have hχ : ∀ (a c : Fin Tag.E6.rank → Lˣ) (γ : Fin Tag.E6.rank → ℤ),
      rootChar (a * c) γ = rootChar a γ * rootChar c γ := fun a c γ => by
    simp only [rootChar, Pi.mul_apply, mul_zpow, Finset.prod_mul_distrib]
  let f : Z →* L :=
    { toFun := fun g => (rootChar (β g) (v • Pi.single j₀ 1) : L)
      map_one' := by simp [hβone, rootChar]
      map_mul' := fun g h => by simp only [hβmul, hχ, Units.val_mul] }
  refine isCyclic_of_injective_ringHom f fun g h hgh => ?_
  have hw : T1b.weylAct v⁻¹ (β g) = T1b.weylAct v⁻¹ (β h) := by
    funext i
    show rootChar (β g) ((v⁻¹)⁻¹ • Pi.single i 1) = rootChar (β h) ((v⁻¹)⁻¹ • Pi.single i 1)
    rw [inv_inv]
    by_cases hi : i = j₀
    · rw [hi]
      exact Units.ext hgh
    · have hmem : v • (Pi.single i 1 : Fin Tag.E6.rank → ℤ) ∈
          (fun α => v • α) '' parabolicRoots Tag.E6 J :=
        ⟨Pi.single i 1, ⟨isRoot_single Tag.E6 i, fun k hk =>
          Pi.single_eq_of_ne (fun (h : k = i) => hk (h ▸ hj₀ i hi)) 1⟩, rfl⟩
      rw [hβS g _ hmem, hβS h _ hmem]
  have hgh' : β g = β h := by
    have h1 := congrArg (T1b.weylAct v) hw
    rwa [← T1b.weylAct_mul, ← T1b.weylAct_mul, mul_inv_cancel, T1b.weylAct_one,
      T1b.weylAct_one] at h1
  exact Subtype.ext (by rw [← hβ g, ← hβ h, hgh'])

theorem charKerTorus_le_centralizer_rootSpan
    {τ : Tag} {L : Type} [Field L]
    {Ψ : Set (Fin τ.rank → ℤ)} (hΨ : ∀ γ ∈ Ψ, IsRoot τ γ) :
    charKerTorus τ L Ψ ≤ Subgroup.centralizer (rootSpan τ L Ψ : Set (ModGL τ L)) := by
  intro g hg
  obtain ⟨b, hb, rfl⟩ := mem_charKerTorus.1 hg
  have hle : rootSpan τ L Ψ ≤ Subgroup.centralizer ({rootDiagUnit τ b} : Set (ModGL τ L)) := by
    refine iSup₂_le fun α hα => ?_
    rw [rootSubgroup, Subgroup.closure_le]
    rintro _ ⟨c, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_singleton_iff]
    have h1 := rootDiagUnit_conj_pinnedX b (hΨ α hα) c
    rw [hb α hα, Units.val_one, one_mul, mul_inv_eq_iff_eq_mul] at h1
    exact h1.symm
  rw [Subgroup.mem_centralizer_iff]
  exact fun h hh => Subgroup.mem_centralizer_singleton_iff.1 (hle hh)

