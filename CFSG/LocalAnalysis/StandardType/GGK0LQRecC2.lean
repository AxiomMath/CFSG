private theorem lqRecC2_prime_odd {L : Type} [Field L] [CharP L 2] {p : ℕ}
    (hp : p.Prime) (hpL : (p : L) ≠ 0) : p % 2 = 1 := by
  have hp2 : p ≠ 2 := by
    rintro rfl
    exact hpL (CharP.cast_eq_zero L 2)
  exact (hp.eq_two_or_odd).resolve_left hp2

private theorem lqRecC2_cover_B2
    {K : Type} [Field K] [Finite K] [CharP K 2] (hK4 : 4 ≤ Nat.card K) :
    ∃ Ψ : StatedSp 2 K →* ModGL Tag.F4 K, Ψ.ker ≤ Subgroup.center (StatedSp 2 K) ∧
      Ψ.range = subsystemGroup .F4 K f4LeviB2 := by
  obtain ⟨W, hW⟩ : ∃ W : Subgroup (adjointGroup .F4 K),
      SymplecticBlockStandardPair K W (rankOne (f4Datum K).rootGroup (f4Node 1))
        (rankOne (f4Datum K).rootGroup (f4Node 2)) := f4_spPair_even (K := K) hK4
  have hle := symplecticBlockStandardPair_le_sup hW
  obtain ⟨θ, c, hrange, hker, -, -, hU, hV⟩ := hW
  have hUW : rankOne (f4Datum K).rootGroup (f4Node 1) ≤ W := by
    rw [← hU, ← hrange]
    exact Subgroup.map_le_range _ _
  have hVW : rankOne (f4Datum K).rootGroup (f4Node 2) ≤ W := by
    rw [← hV, ← hrange]
    exact Subgroup.map_le_range _ _
  have hWeq : W = rankOne (f4Datum K).rootGroup (f4Node 1) ⊔
      rankOne (f4Datum K).rootGroup (f4Node 2) := le_antisymm hle (sup_le hUW hVW)
  refine ⟨(adjointGroup .F4 K).subtype.comp θ, ?_, ?_⟩
  · intro x hx
    exact hker (Subtype.ext (MonoidHom.mem_ker.mp hx))
  · rw [MonoidHom.range_comp, hrange, hWeq, map_subtype_sup_b2]

private theorem lqRecC2_center_eq_bot_of_simple_perfect {X : Type*} [Group X] [IsSimpleGroup X]
    (hperf : commutator X = ⊤) : Subgroup.center X = ⊥ := by
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center X) with h | h
  · exact h
  · exfalso
    haveI : Group.IsPerfect X := Group.isPerfect_def.2 hperf
    exact Group.IsPerfect.not_isMulCommutative X ⟨⟨fun a b => by
      have ha : a ∈ Subgroup.center X := h ▸ Subgroup.mem_top a
      exact (Subgroup.mem_center_iff.mp ha b).symm⟩⟩

private theorem lqRecC2_hasLabel_of_model {X : Type} [Group X] {n f : ℕ}
    (h : CFSG.Open.StatedClassicalModel X .PSp n 2 f) : GGHasLabel ⟨.C, n, f⟩ X := by
  obtain ⟨-, K, hF, hfin, hcard, ⟨e⟩⟩ := h
  exact ⟨K, hF, hfin, hcard, ⟨e⟩⟩

private theorem lqRecC2_sl2_commutator_nontrivial {K : Type} [Field K] [Fintype K]
    (hK : Fintype.card K = 2 ^ 1) :
    ∃ g ∈ commutator (Matrix.SpecialLinearGroup (Fin 2) K), g ≠ 1 := by
  classical
  haveI : CharP K 2 := charP_of_card_eq_prime_pow hK
  let u := LieType.Steinberg.sl2Upper (1 : K)
  let w := LieType.Steinberg.sl2Lower (1 : K)
  have hu2 : u * u = 1 := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [u, LieType.Steinberg.coe_sl2Upper, Matrix.SpecialLinearGroup.coe_mul,
        Matrix.mul_apply, Fin.sum_univ_two, CharTwo.add_self_eq_zero]
  have hw2 : w * w = 1 := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [w, LieType.Steinberg.coe_sl2Lower, Matrix.SpecialLinearGroup.coe_mul,
        Matrix.mul_apply, Fin.sum_univ_two, CharTwo.add_self_eq_zero]
  refine ⟨⁅u, w⁆, Subgroup.commutator_mem_commutator (Subgroup.mem_top _)
    (Subgroup.mem_top _), ?_⟩
  intro h1
  rw [commutatorElement_def, inv_eq_of_mul_eq_one_right hu2,
    inv_eq_of_mul_eq_one_right hw2] at h1
  have hentry := congrArg
    (fun x : Matrix.SpecialLinearGroup (Fin 2) K => ((x : Matrix (Fin 2) (Fin 2) K) 0 1)) h1
  simp [u, w, LieType.Steinberg.coe_sl2Upper, LieType.Steinberg.coe_sl2Lower,
    Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_one, Matrix.mul_apply,
    Fin.sum_univ_two, CharTwo.add_self_eq_zero] at hentry

theorem lq_rec_C2
    {τ : Tag} (hτ : τ = .F4)
    {L : Type} [Field L] [IsAlgClosed L] [CharP L 2]
    {p₀ p : ℕ} (S : LangSetup τ L p₀) (hp : p.Prime) (hpL : (p : L) ≠ 0)
    {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus)
    (hTp : rootDiagUnit τ a ^ p = 1) (h1 : rootDiagUnit τ a ≠ 1)
    (i : KernelComponent (rootCharHom a))
    (h2 : compRank (componentRoots (rootCharHom a) i) = 2)
    (hn : (componentRoots (rootCharHom a) i).ncard = 8)
    (hinner : twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ
        (componentRoots (rootCharHom a) i)]))
    {N : ℕ} (hN : S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 2 ^ N)
    (hN2 : 2 ≤ N) :
    GGHasLabel ⟨.C, compRank (componentRoots (rootCharHom a) i), N⟩
      (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) := by
  classical
  subst hτ
  have hp2 : p % 2 = 1 := lqRecC2_prime_odd hp hpL
  have hnonA : ¬ (1 ≤ compRank (componentRoots (rootCharHom a) i) ∧
      (componentRoots (rootCharHom a) i).ncard =
        compRank (componentRoots (rootCharHom a) i) *
          (compRank (componentRoots (rootCharHom a) i) + 1)) := by
    rintro ⟨-, h⟩
    rw [h2, hn] at h
    omega
  rcases f4_nonA_casesP2 hp hp2 S hpL hTp h1 i hnonA with
    ⟨v, hroots, -, -⟩ | ⟨v, J, hJ, -, h3, -⟩
  · obtain ⟨σ, hfin, hcard, f, hf1, hker, hf2⟩ := exists_inner_cover S hT i hinner
    haveI : Fintype ↥(fixSubfield σ) := Fintype.ofFinite ↥(fixSubfield σ)
    haveI : CharP ↥(fixSubfield σ) 2 :=
      ((fixSubfield σ).subtype.charP_iff (fixSubfield σ).subtype_injective 2).2 inferInstance
    have hKcard : Nat.card ↥(fixSubfield σ) = 2 ^ N := by rw [hcard, hN]
    have hK4 : 4 ≤ Nat.card ↥(fixSubfield σ) := by
      rw [hKcard]
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ N := Nat.pow_le_pow_right (by norm_num) hN2
    obtain ⟨Ψ, hΨk, hΨr⟩ : ∃ Ψ : StatedSp 2 ↥(fixSubfield σ) →*
        ModGL Tag.F4 ↥(fixSubfield σ),
        Ψ.ker ≤ Subgroup.center (StatedSp 2 ↥(fixSubfield σ)) ∧
          Ψ.range = rootSpan Tag.F4 ↥(fixSubfield σ)
            ((fun α => v • α) '' parabolicRoots Tag.F4 f4LeviB2) := by
      obtain ⟨Ψ0, hk0, hr0⟩ := lqRecC2_cover_B2 (K := ↥(fixSubfield σ)) hK4
      have hsub : subsystemGroup Tag.F4 ↥(fixSubfield σ) f4LeviB2 =
          rootSpan Tag.F4 ↥(fixSubfield σ) (parabolicRoots Tag.F4 f4LeviB2) :=
        CFSG.RankThree.Chevalley.subsystemGroup_eq_iSup_rootSubgroup (τ := Tag.F4)
          (J := f4LeviB2) ↥(fixSubfield σ)
      rw [hsub] at hr0
      have hmap := (canonical_weyl_root_transport Tag.F4 ↥(fixSubfield σ)).1 v
        (parabolicRoots Tag.F4 f4LeviB2) (fun α hα => hα.1)
      refine ⟨(MulAut.conj (canonicalRep (coxeterSystem Tag.F4) ↥(fixSubfield σ) v)
        ).toMonoidHom.comp Ψ0, fun x hx => hk0 ?_, ?_⟩
      · rw [MonoidHom.mem_ker] at hx ⊢
        exact (MulAut.conj (canonicalRep (coxeterSystem Tag.F4) ↥(fixSubfield σ) v)).injective
          (by simpa using hx)
      · rw [MonoidHom.range_comp, hr0]
        exact hmap
    have hcomp : componentRootSpan (fixSubfield σ) (rootCharHom a) i =
        rootSpan Tag.F4 ↥(fixSubfield σ)
          ((fun α => v • α) '' parabolicRoots Tag.F4 f4LeviB2) := by
      show rootSpan Tag.F4 ↥(fixSubfield σ) (componentRoots (rootCharHom a) i) = _
      rw [hroots]
    rw [← hcomp] at hΨr
    have hne : (2, Fintype.card ↥(fixSubfield σ)) ≠ (2, 2) := by
      intro h
      rw [← Nat.card_eq_fintype_card, hKcard] at h
      have hpow : 2 ^ N = 2 := (Prod.mk.inj h).2
      have h4 : 4 ≤ 2 ^ N := by
        calc 4 = 2 ^ 2 := by norm_num
          _ ≤ 2 ^ N := Nat.pow_le_pow_right (by norm_num) hN2
      omega
    have hperfSp : commutator (StatedSp 2 ↥(fixSubfield σ)) = ⊤ :=
      (spFactorFacts_holds ↥(fixSubfield σ) 2 (by norm_num) hne).perfect
    have hCperf : ⁅componentRootSpan (fixSubfield σ) (rootCharHom a) i,
        componentRootSpan (fixSubfield σ) (rootCharHom a) i⁆ =
        componentRootSpan (fixSubfield σ) (rootCharHom a) i := by
      rw [← hΨr, MonoidHom.range_eq_map, ← Subgroup.map_commutator, ← commutator_def, hperfSp]
    have hRf : f.range = rationalComponent S.ρ S.Γ (rootCharHom a) i :=
      le_antisymm (hf2 hCperf) hf1
    let g0 : StatedSp 2 ↥(fixSubfield σ) →*
        ↥(componentRootSpan (fixSubfield σ) (rootCharHom a) i) :=
      Ψ.codRestrict _ (fun x => by rw [← hΨr]; exact ⟨x, rfl⟩)
    have hg0surj : Function.Surjective g0 := by
      rintro ⟨y, hy⟩
      obtain ⟨x, hx⟩ : y ∈ Ψ.range := hΨr ▸ hy
      exact ⟨x, Subtype.ext hx⟩
    have hg0ker : g0.ker ≤ Subgroup.center (StatedSp 2 ↥(fixSubfield σ)) := by
      intro x hx
      rw [MonoidHom.mem_ker] at hx
      apply hΨk
      rw [MonoidHom.mem_ker]
      exact congrArg Subtype.val hx
    let g : StatedSp 2 ↥(fixSubfield σ) →*
        ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) :=
      (f.comp g0).codRestrict _ (fun x => by rw [← hRf]; exact ⟨g0 x, rfl⟩)
    have hgsurj : Function.Surjective g := by
      rintro ⟨y, hy⟩
      obtain ⟨c, hc⟩ : y ∈ f.range := hRf ▸ hy
      obtain ⟨x, rfl⟩ := hg0surj c
      exact ⟨x, Subtype.ext hc⟩
    have hgker : g.ker ≤ Subgroup.center (StatedSp 2 ↥(fixSubfield σ)) := by
      intro x hx
      rw [MonoidHom.mem_ker] at hx
      have h1 : f (g0 x) = 1 := congrArg Subtype.val hx
      have h2 : g0 x ∈ Subgroup.center
          ↥(componentRootSpan (fixSubfield σ) (rootCharHom a) i) := hker h1
      rw [← comap_center_of_surjective hperfSp g0 hg0surj hg0ker]
      exact h2
    obtain ⟨e1⟩ := nonempty_centralQuotient_mulEquiv hperfSp g hgsurj hgker
    let e2 := QuotientGroup.quotientMulEquivOfEq
      (CFSG.LieType.Universal.Symplectic.center_eq 2 ↥(fixSubfield σ))
    have hmodel : StatedClassicalModel
        (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
          Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) .PSp 2 2 N := by
      refine ⟨⟨Nat.prime_two, by omega, le_rfl, ?_⟩, ↥(fixSubfield σ), inferInstance,
        inferInstance, hKcard, ⟨e1.symm.trans e2⟩⟩
      intro h
      have hpow : 2 ^ N = 2 := (Prod.mk.inj h).2
      have h4 : 4 ≤ 2 ^ N := by
        calc 4 = 2 ^ 2 := by norm_num
          _ ≤ 2 ^ N := Nat.pow_le_pow_right (by norm_num) hN2
      rw [hpow] at h4
      norm_num at h4
    rw [h2]
    exact lqRecC2_hasLabel_of_model hmodel
  · omega

theorem lq_rec_B2der
    {τ : Tag} (hτ : τ = .F4)
    {L : Type} [Field L] [IsAlgClosed L] [CharP L 2]
    {p₀ p : ℕ} (S : LangSetup τ L p₀) (hp : p.Prime) (hpL : (p : L) ≠ 0)
    {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus)
    (hTp : rootDiagUnit τ a ^ p = 1) (h1 : rootDiagUnit τ a ≠ 1)
    (i : KernelComponent (rootCharHom a))
    (h2 : compRank (componentRoots (rootCharHom a) i) = 2)
    (hn : (componentRoots (rootCharHom a) i).ncard = 8)
    (hinner : twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ
        (componentRoots (rootCharHom a) i)]))
    {N : ℕ} (hN : S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 2 ^ N)
    (hN1 : N = 1) :
    GGHasLabel ⟨.B2der, 0, 1⟩
      (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) := by
  classical
  subst hτ
  subst hN1
  have hp2 : p % 2 = 1 := lqRecC2_prime_odd hp hpL
  have hnonA : ¬ (1 ≤ compRank (componentRoots (rootCharHom a) i) ∧
      (componentRoots (rootCharHom a) i).ncard =
        compRank (componentRoots (rootCharHom a) i) *
          (compRank (componentRoots (rootCharHom a) i) + 1)) := by
    rintro ⟨-, h⟩
    rw [h2, hn] at h
    omega
  rcases f4_nonA_casesP2 hp hp2 S hpL hTp h1 i hnonA with
    ⟨v, hroots, -, -⟩ | ⟨v, J, hJ, -, h3, -⟩
  ·
    have hQ : S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) < 3 := by
      rw [hN]
      norm_num
    obtain ⟨K', hfin, C, D, hC, hD, hcard, f, hf1, hker, hf2⟩ :=
      exists_inner_cover_derived_two S hT i hinner hQ
    haveI : Fintype ↥K' := Fintype.ofFinite _
    have hcard' : Fintype.card ↥K' = 2 := by rw [← Nat.card_eq_fintype_card]; exact hcard
    have hch : ringChar L = 2 := by
      have htwo := ringChar_eq_of_natCard_eq_pow Nat.prime_two (K := ↥K') (f := 1)
        (by rw [hcard]; norm_num) Nat.one_pos
      rw [← ringChar_subfield' K', htwo]
    obtain ⟨O⟩ := nonempty_commOrder_ofCartan (f4Datum ↥K').isFiniteType
      (Dv := (f4Datum ↥K').divisible) rfl
    obtain ⟨Cc, -, hCc⟩ := f4_commutatorFormula ↥K' O
    have hE := f4_chevalleyExtras ↥K' O Cc hCc
    choose ρF hρFi hρFr hρFv using exists_rankOne_param hE
    obtain ⟨φ, hφl, hφs⟩ : ∃ φ : StatedSp 2 ↥K' →* adjointGroup .F4 ↥K',
        φ.comp (spBlock ↥K' 1) = ρF (f4Node 1) ∧
          φ.comp (spBlock ↥K' 0) = ρF (f4Node 2) := by
      obtain ⟨φ, e, -, he1, he2, he3, he4, hφ⟩ :=
        exists_b2Hom hE (s := f4Node 2) (l := f4Node 1) rfl f4_cartan_21 f4_cartan_12
      obtain ⟨hb0, hb1⟩ := hom_block_eq he1 he2 he3 he4 hφ (hρFv (f4Node 2)) (hρFv (f4Node 1))
      exact ⟨φ, hb1, hb0⟩
    have hφrange : φ.range = rankOne (f4Datum ↥K').rootGroup (f4Node 1) ⊔
        rankOne (f4Datum ↥K').rootGroup (f4Node 2) := by
      rw [ClassicalInvolution.Q3.Q3V.range_eq_sup_of_spBlocks hφs hφl, hρFr, hρFr, sup_comm]
    set n := canonicalRep (coxeterSystem Tag.F4) ↥K' v with hn
    set ψ : StatedSp 2 ↥K' →* ModGL Tag.F4 ↥K' :=
      (MulAut.conj n).toMonoidHom.comp ((adjointGroup .F4 ↥K').subtype.comp φ) with hψ
    have hψrange : ψ.range = C := by
      have hmap := (canonical_weyl_root_transport Tag.F4 ↥K').1 v
        (parabolicRoots Tag.F4 f4LeviB2) (fun α hα => hα.1)
      have hsub : subsystemGroup Tag.F4 ↥K' f4LeviB2 =
          rootSpan Tag.F4 ↥K' (parabolicRoots Tag.F4 f4LeviB2) :=
        CFSG.RankThree.Chevalley.subsystemGroup_eq_iSup_rootSubgroup (τ := Tag.F4)
          (J := f4LeviB2) ↥K'
      have hCeq : C = rootSpan Tag.F4 ↥K'
          ((fun α => v • α) '' parabolicRoots Tag.F4 f4LeviB2) := by
        rw [hC]
        show rootSpan Tag.F4 ↥K' (componentRoots (rootCharHom a) i) = _
        rw [hroots]
      rw [hCeq, ← hmap, ← hsub, ← map_subtype_sup_b2, ← hφrange, hψ, MonoidHom.range_comp,
        MonoidHom.range_comp]
    set X' : Subgroup (StatedSp 2 ↥K') := commutator (StatedSp 2 ↥K') with hX'
    have hDmap : D = X'.map ψ := by
      rw [hD, ← hψrange, MonoidHom.range_eq_map, ← Subgroup.map_commutator, hX', commutator_def]
    have hX : LieFactorData 2 ↥X' := spFourTwoFacts_holds ↥K' hcard'
    haveI hs : IsSimpleGroup ↥X' := isSimpleGroup_commutator_statedSp_two hcard
    have hXp : ⁅X', X'⁆ = X' :=
      Subgroup.isPerfect_iff.1 (Group.isPerfect_def.2 hX.perfect)
    have hperfD : ⁅D, D⁆ = D := by
      rw [hDmap, ← Subgroup.map_commutator, hXp]
    have hRf : f.range = rationalComponent S.ρ S.Γ (rootCharHom a) i :=
      le_antisymm (hf2 hperfD) hf1
    let ψX : ↥X' →* ↥D := (ψ.comp X'.subtype).codRestrict D (fun x => by
      rw [hDmap]
      exact ⟨x, x.2, rfl⟩)
    have hψXsurj : Function.Surjective ψX := by
      rintro ⟨y, hy⟩
      rw [hDmap] at hy
      obtain ⟨x, hx, rfl⟩ := hy
      exact ⟨⟨x, hx⟩, rfl⟩
    have hDne : D ≠ ⊥ := by
      obtain ⟨g, hgcomm, hg1⟩ := lqRecC2_sl2_commutator_nontrivial (K := ↥K')
        (by rw [hcard']; norm_num)
      have hgs : spBlock ↥K' 1 g ∈ X' := by
        have hmem : spBlock ↥K' 1 g ∈ (commutator (Matrix.SpecialLinearGroup (Fin 2) ↥K')).map
            (spBlock ↥K' 1) := ⟨g, hgcomm, rfl⟩
        rw [commutator_def, Subgroup.map_commutator] at hmem
        exact Subgroup.commutator_mono le_top le_top hmem
      have hφg : φ (spBlock ↥K' 1 g) ≠ 1 := by
        intro hφ1
        have h1 : ρF (f4Node 1) g = 1 := by
          rw [← hφl, MonoidHom.comp_apply, hφ1]
        exact hg1 (hρFi (f4Node 1) (h1.trans (map_one (ρF (f4Node 1))).symm))
      have hψg : ψ (spBlock ↥K' 1 g) ≠ 1 := by
        intro hψ1
        have h1 : (adjointGroup .F4 ↥K').subtype (φ (spBlock ↥K' 1 g)) = 1 := by
          have h2 : (MulAut.conj n) ((adjointGroup .F4 ↥K').subtype
              (φ (spBlock ↥K' 1 g))) = 1 := hψ1
          exact (MulAut.conj n).injective (by simpa using h2)
        have h1' : (adjointGroup .F4 ↥K').subtype (φ (spBlock ↥K' 1 g)) =
            (adjointGroup .F4 ↥K').subtype 1 := by simpa using h1
        exact hφg (Subtype.ext_iff.mpr h1')
      intro hbot
      have hmemD : ψ (spBlock ↥K' 1 g) ∈ D := by
        rw [hDmap]
        exact ⟨spBlock ↥K' 1 g, hgs, rfl⟩
      rw [hbot] at hmemD
      exact hψg (Subgroup.mem_bot.mp hmemD)
    have hψXinj : Function.Injective ψX := by
      rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
      intro x hx
      have hx' : x ∈ ψX.ker := hx
      rw [MonoidHom.mem_ker] at hx'
      rcases hs.eq_bot_or_eq_top_of_normal ψX.ker with h | h
      · have hxbot : x ∈ ψX.ker := hx'
        rw [h] at hxbot
        exact Subgroup.mem_bot.mp hxbot
      · exfalso
        apply hDne
        rw [Subgroup.eq_bot_iff_forall]
        intro d hd
        obtain ⟨y, hy⟩ := hψXsurj ⟨d, hd⟩
        have h1 : ψX y = 1 := MonoidHom.mem_ker.mp (h ▸ Subgroup.mem_top y)
        have h2 : (↑(ψX y) : ModGL Tag.F4 ↥K') = 1 := congrArg Subtype.val h1
        have h3 : (↑(ψX y) : ModGL Tag.F4 ↥K') = d := congrArg Subtype.val hy
        exact h3 ▸ h2
    let eD : ↥X' ≃* ↥D := MulEquiv.ofBijective ψX ⟨hψXinj, hψXsurj⟩
    haveI hDsimple : IsSimpleGroup ↥D := eD.symm.isSimpleGroup
    haveI hDperf : Group.IsPerfect ↥D := Subgroup.isPerfect_iff.2 hperfD
    have hZD : Subgroup.center ↥D = ⊥ :=
      lqRecC2_center_eq_bot_of_simple_perfect (Group.isPerfect_def.1 hDperf)
    have hfker : f.ker = ⊥ := le_bot_iff.mp (hZD ▸ hker)
    have hfinj : Function.Injective f := (MonoidHom.ker_eq_bot_iff f).1 hfker
    let eR : ↥D ≃* ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) :=
      (MonoidHom.ofInjective hfinj).trans (MulEquiv.subgroupCongr hRf)
    haveI hRsimple : IsSimpleGroup ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) :=
      eR.symm.isSimpleGroup
    haveI hRperf : Group.IsPerfect ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) :=
      Group.IsPerfect.ofSurjective (f := eR.toMonoidHom) eR.surjective
    have hZR : Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) = ⊥ :=
      lqRecC2_center_eq_bot_of_simple_perfect (Group.isPerfect_def.1 hRperf)
    let H : Subgroup (GL (Fin 2 ⊕ Fin 2) ↥K') := ⁅StatedSp 2 ↥K', StatedSp 2 ↥K'⁆
    obtain ⟨eL⟩ := nonempty_largeEvenProj_equiv_of_card_two (K := ↥K') hcard H
    obtain ⟨eC⟩ := nonempty_commutator_subgroup_equiv (StatedSp 2 ↥K')
    let eZ : ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ≃*
        ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) :=
      (QuotientGroup.quotientMulEquivOfEq hZR).trans QuotientGroup.quotientBot
    refine ⟨↥K', inferInstance, inferInstance, hcard, ?_⟩
    exact ⟨eZ.trans (eR.symm.trans (eD.symm.trans (eL.trans eC).symm))⟩


  · omega

end CFSG.StandardType.GGK0LQ

