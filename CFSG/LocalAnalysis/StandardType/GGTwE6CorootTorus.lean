noncomputable abbrev coroot {L : Type} [Field L] (δ : Fin Tag.E6.rank → ℤ) (s : Lˣ) : ModGL Tag.E6 L :=
  rootDiagUnit Tag.E6 (corootTuple δ s)

private theorem twE6_twFrob_rootDiagUnit {L : Type} [Field L]
    {Fr : L →+* L} {q : ℕ} (hFr : ∀ c, Fr c = c ^ q)
    (a : Fin TwistTag.E6.tag.rank → Lˣ) :
    twFrob TwistTag.E6 (canonicalRep (coxeterSystem TwistTag.E6.tag) L twE6W0) Fr
        (rootDiagUnit TwistTag.E6.tag a) = (rootDiagUnit TwistTag.E6.tag a)⁻¹ ^ q := by
  rw [CFSG.HardMathSupport.Timmesfeld.CrossChar.twFrob_rootDiagUnit, rootDiagUnit_inv,
    rootDiagUnit_pow]
  congr 1
  funext i
  have hi : (Pi.single i 1 : Fin TwistTag.E6.tag.rank → ℤ) =
      permLattice TwistTag.E6.perm (Pi.single (TwistTag.E6.perm.symm i) 1) := by
    rw [permLattice_single, Equiv.apply_symm_apply]
  rw [weylTuple, twE6W0_inv_smul, hi, twE6W0_smul_permLattice, rootChar_neg_vec_E6Four,
    rootChar, Finset.prod_eq_single (TwistTag.E6.perm.symm i) (fun j _ hj => by
      rw [Pi.single_eq_of_ne hj, zpow_zero]) (fun h => absurd (Finset.mem_univ _) h)]
  simp only [Pi.single_eq_same, zpow_one]
  ext1
  simp [hFr, Pi.pow_apply, twistPerm_symm_symm_apply_E6]

private theorem frobRootMap_twE6_neg {L : Type} [Field L] [IsAlgClosed L]
    {Fr : L →+* L} {q : ℕ} (hq0 : 0 < q)
    (hFr : ∀ c, Fr c = c ^ q)
    (D : LangDatum TwistTag.E6.tag L) (hΦ : D.Φ = twistHom TwistTag.E6 L Fr) (hq : D.q = q)
    (hn : D.n = canonicalRep (coxeterSystem TwistTag.E6.tag) L twE6W0) :
    FrobRootMap D (Equiv.neg (Fin TwistTag.E6.tag.rank → ℤ)) where
  isRoot_iff γ := ⟨fun h => by simpa using IsRoot.neg h, fun h => IsRoot.neg h⟩
  neg_eq γ := rfl
  iform_eq γ δ := TwE6InnerAbs.iform_neg_neg' γ δ
  map_rootSubgroup γ hγ := by
    have hsurj : Function.Surjective Fr := fun y => by
      obtain ⟨x, hx⟩ := IsAlgClosed.exists_pow_nat_eq y hq0
      exact ⟨x, by rw [hFr, hx]⟩
    have h := map_twFrob_rootSubgroup TwistTag.E6 hsurj twE6W0 hγ
    rw [twE6W0_smul_permLattice] at h
    have hstep : D.step = twFrob TwistTag.E6
        (canonicalRep (coxeterSystem TwistTag.E6.tag) L twE6W0) Fr := by
      unfold LangDatum.step
      rw [hΦ, hn]
      rfl
    rw [hstep]
    exact h
  rootChar_eq a ha γ hγ := by
    have hx := (mem_twistedTorusOf.1 ha).2
    have hF := twE6_twFrob_rootDiagUnit hFr a
    have h2 : (rootDiagUnit TwistTag.E6.tag a)⁻¹ ^ q = rootDiagUnit TwistTag.E6.tag a := by
      rw [← hF]
      change D.n * D.Φ (rootDiagUnit TwistTag.E6.tag a) * D.n⁻¹ = _ at hx
      rw [hΦ, hn] at hx
      exact hx
    have h9 : (rootDiagUnit TwistTag.E6.tag a) ^ (q + 1) = 1 := by
      set x := rootDiagUnit TwistTag.E6.tag a with hxdef
      rw [inv_pow] at h2
      calc x ^ (q + 1) = x ^ q * x := pow_succ x q
        _ = x ^ q * (x ^ q)⁻¹ := by rw [h2]
        _ = 1 := mul_inv_cancel _
    have ha9 : a ^ (q + 1) = 1 := by
      apply CFSG.LieType.Chevalley.rootDiagUnit_injective (τ := TwistTag.E6.tag) (K := L)
      rw [← rootDiagUnit_pow, rootDiagUnit_one]
      exact h9
    have hap : ∀ i, a i ^ (q + 1) = 1 := fun i => by simpa using congrFun ha9 i
    have h4 := TwE6InnerAbs.rootChar_pow_eq_one' hap γ
    change rootChar a (-γ) = rootChar a γ ^ D.q
    rw [hq, TwE6InnerAbs.rootChar_neg']
    apply inv_eq_of_mul_eq_one_left
    rw [← pow_succ]
    exact h4

private noncomputable def twE6LangSetup {L : Type} [Field L] [IsAlgClosed L]
    (Fr : L →+* L) (q : ℕ) (hq0 : 0 < q)
    (hFr : ∀ c, Fr c = c ^ q) {g0 : ModGL TwistTag.E6.tag L}
    (hg0C : g0 ∈ adjointGroup TwistTag.E6.tag L)
    (hg0 : twistHom TwistTag.E6 L Fr g0 = g0 * canonicalRep (coxeterSystem TwistTag.E6.tag) L twE6W0)
    (p₀ : ℕ) (hp₀ : p₀.Prime) (hq : 5 ≤ p₀ ∨ 4 ≤ q) (hqpow : IsPrimePow q ∧ ((q : ℕ) : L) = 0)
    (hpq : ¬ p₀ ∣ q)
    (hfin : Finite (LangDatum.ofTwist TwistTag.E6 Fr q hFr twE6W0 hg0C hg0).model) :
    LangSetup TwistTag.E6.tag L p₀ :=
  (LangDatum.ofTwist TwistTag.E6 Fr q hFr twE6W0 hg0C hg0).toSetup p₀
    (Equiv.neg _) (frobRootMap_twE6_neg hq0 hFr _ rfl rfl rfl) hp₀ hq hqpow hpq hfin

private noncomputable abbrev nRootW {L : Type} [Field L]
    (w : WeylGroup Tag.E6) (j : Fin Tag.E6.rank) :
    ModGL Tag.E6 L :=
  canonicalRep (coxeterSystem Tag.E6) L w * weylElt Tag.E6 L j 1 *
    (canonicalRep (coxeterSystem Tag.E6) L w)⁻¹

private theorem coroot_eq_conj {L : Type} [Field L]
    (w : WeylGroup Tag.E6) (j : Fin Tag.E6.rank) (s : Lˣ) :
    coroot (w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) s =
      canonicalRep (coxeterSystem Tag.E6) L w * torusElt Tag.E6 L j s *
        (canonicalRep (coxeterSystem Tag.E6) L w)⁻¹ := by
  obtain ⟨ω, hω, rfl⟩ := (coxeterSystem Tag.E6).exists_isReduced w
  have ht : torusElt Tag.E6 L j s = coroot (Pi.single j 1 : Fin Tag.E6.rank → ℤ) s := by
    rw [torusElt_eq_rootDiagUnit]
    unfold coroot
    congr 1
    funext k
    rw [corootTuple, iform_single_single_E6]
  rw [canonicalRep_wordProd hω, ht]
  exact (list_prod_weylElt_conj_corootTuple ω _ s).symm

private theorem weylElt_mem_rootSpan_E6 {L : Type} [Field L]
    {S : Set (Fin Tag.E6.rank → ℤ)} {j : Fin Tag.E6.rank}
    (h1 : (Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈ S)
    (h2 : (-Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈ S) (u : Lˣ) :
    weylElt Tag.E6 L j u ∈ rootSpan Tag.E6 L S := by
  have hx : ∀ c : L, xUnit Tag.E6 L j c ∈ rootSpan Tag.E6 L S := fun c =>
    le_iSup₂_of_le (f := fun δ (_ : δ ∈ S) => rootSubgroup Tag.E6 L δ) _ h1 le_rfl
      (xUnit_mem_rootSubgroup j c)
  have hy : ∀ c : L, yUnit Tag.E6 L j c ∈ rootSpan Tag.E6 L S := fun c =>
    le_iSup₂_of_le (f := fun δ (_ : δ ∈ S) => rootSubgroup Tag.E6 L δ) _ h2 le_rfl
      (yUnit_mem_rootSubgroup j c)
  rw [CFSG.LieType.Chevalley.weylElt_eq_xUnit_mul]
  exact mul_mem (mul_mem (hx _) (hy _)) (hx _)

private theorem isRoot_pair_E6 (δ : Fin Tag.E6.rank → ℤ) (hδ : IsRoot Tag.E6 δ) :
    ∀ α ∈ ({δ, -δ} : Set (Fin Tag.E6.rank → ℤ)), IsRoot Tag.E6 α := by
  intro α hα
  rcases hα with rfl | rfl
  · exact hδ
  · exact IsRoot.neg hδ

private theorem image_pair_E6 (w : WeylGroup Tag.E6) (j : Fin Tag.E6.rank) :
    ((fun α => w • α) '' ({(Pi.single j 1 : Fin Tag.E6.rank → ℤ), -Pi.single j 1} :
        Set (Fin Tag.E6.rank → ℤ))) =
      {w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ), -(w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ))} := by
  rw [Set.image_pair, smul_neg]

private theorem coroot_mem_rootSpan {L : Type} [Field L]
    (w : WeylGroup Tag.E6) (j : Fin Tag.E6.rank) (s : Lˣ) :
    coroot (w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) s ∈
      rootSpan Tag.E6 L {w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ),
        -(w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ))} := by
  have h1 : (Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈
      ({Pi.single j 1, -Pi.single j 1} : Set (Fin Tag.E6.rank → ℤ)) := Set.mem_insert _ _
  have h2 : (-Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈
      ({Pi.single j 1, -Pi.single j 1} : Set (Fin Tag.E6.rank → ℤ)) := by simp
  have ht : torusElt Tag.E6 L j s ∈ rootSpan Tag.E6 L
      ({Pi.single j 1, -Pi.single j 1} : Set (Fin Tag.E6.rank → ℤ)) := by
    have e : torusElt Tag.E6 L j s = weylElt Tag.E6 L j s * (weylElt Tag.E6 L j 1)⁻¹ :=
      eq_mul_inv_of_mul_eq (weylElt_eq_torusElt_mul_weylElt_one j s).symm
    rw [e]
    exact mul_mem (weylElt_mem_rootSpan_E6 h1 h2 s) (inv_mem (weylElt_mem_rootSpan_E6 h1 h2 1))
  rw [coroot_eq_conj, ← image_pair_E6]
  exact canonicalRep_conj_mem_rootSpan (isRoot_pair_E6 _ (IsRoot.basis j)) ht

private theorem nRootW_mem_rootSpan {L : Type} [Field L]
    (w : WeylGroup Tag.E6) (j : Fin Tag.E6.rank) :
    nRootW (L := L) w j ∈
      rootSpan Tag.E6 L {w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ),
        -(w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ))} := by
  have h1 : (Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈
      ({Pi.single j 1, -Pi.single j 1} : Set (Fin Tag.E6.rank → ℤ)) := Set.mem_insert _ _
  have h2 : (-Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈
      ({Pi.single j 1, -Pi.single j 1} : Set (Fin Tag.E6.rank → ℤ)) := by simp
  rw [← image_pair_E6]
  exact canonicalRep_conj_mem_rootSpan (isRoot_pair_E6 _ (IsRoot.basis j))
    (weylElt_mem_rootSpan_E6 h1 h2 1)

private theorem weylElt_conj_torusElt_E6 {L : Type} [Field L]
    (j : Fin Tag.E6.rank) (s : Lˣ) :
    weylElt Tag.E6 L j 1 * torusElt Tag.E6 L j s * (weylElt Tag.E6 L j 1)⁻¹ =
      (torusElt Tag.E6 L j s)⁻¹ := by
  rw [torusElt_eq_rootDiagUnit, weylElt_conj_rootDiagUnit, rootDiagUnit_inv]
  congr 1
  funext k
  rw [Tag.cartan_self, Pi.inv_apply, ← zpow_mul, ← zpow_add, ← zpow_neg]
  congr 1
  ring

private theorem commutator_coroot_nRootW {L : Type} [Field L]
    (w : WeylGroup Tag.E6) (j : Fin Tag.E6.rank) (s : Lˣ) :
    coroot (w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) s * nRootW w j *
        (coroot (w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) s)⁻¹ * (nRootW w j)⁻¹ =
      coroot (w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) (s ^ 2) := by
  have h1 := coroot_eq_conj (L := L) w j s
  have h2 := coroot_eq_conj (L := L) w j (s ^ 2)
  have h3 := weylElt_conj_torusElt_E6 (L := L) j s
  rw [h1, h2, pow_two, torusElt_mul]
  unfold nRootW
  set C := canonicalRep (coxeterSystem Tag.E6) L w
  set n := weylElt Tag.E6 L j 1
  set D := torusElt Tag.E6 L j s
  have h4 : n * D⁻¹ * n⁻¹ = D := by
    have : n * D⁻¹ * n⁻¹ = (n * D * n⁻¹)⁻¹ := by group
    rw [this, h3, inv_inv]
  calc C * D * C⁻¹ * (C * n * C⁻¹) * (C * D * C⁻¹)⁻¹ * (C * n * C⁻¹)⁻¹
      = C * (D * (n * D⁻¹ * n⁻¹)) * C⁻¹ := by group
    _ = _ := by rw [h4]

private theorem canonicalRep_mem_E6 {L : Type} [Field L]
    (H : Subgroup (ModGL Tag.E6 L))
    (hH : ∀ k, weylElt Tag.E6 L k 1 ∈ H) (w : WeylGroup Tag.E6) :
    canonicalRep (coxeterSystem Tag.E6) L w ∈ H := by
  obtain ⟨ω, hω, rfl⟩ := (coxeterSystem Tag.E6).exists_isReduced w
  rw [canonicalRep_wordProd hω]
  refine Subgroup.list_prod_mem _ fun x hx => ?_
  obtain ⟨k, -, rfl⟩ := List.mem_map.1 hx
  exact hH k

private theorem exists_sqrt_E6 {L : Type} [Field L] {q : ℕ} (hq2 : Even q) {u : Lˣ}
    (hu : u ^ (q + 1) = 1) :
    ∃ t : Lˣ, t ^ 2 = u ∧ t ^ (q + 1) = 1 := by
  obtain ⟨m, hm⟩ := hq2
  refine ⟨u ^ (m + 1), ?_, ?_⟩
  · rw [← pow_mul]
    calc u ^ ((m + 1) * 2) = u ^ (q + 1) * u := by rw [← pow_succ]; congr 1; omega
      _ = u := by rw [hu, one_mul]
  · rw [← pow_mul, mul_comm, pow_mul, hu, one_pow]

private theorem coroot_mem_rationalComponent {L : Type} [Field L] [IsAlgClosed L]
    {p : ℕ} (S : LangSetup Tag.E6 L p)
    (hq2 : Even S.D.q)
    (hTM : ∀ (δ : Fin Tag.E6.rank → ℤ) (s : Lˣ), s ^ (S.D.q + 1) = 1 → coroot δ s ∈ S.D.model)
    (hnΓ : ∀ k, weylElt Tag.E6 L k 1 ∈ S.Γ)
    {χ : Multiplicative (Fin Tag.E6.rank → ℤ) →* Lˣ} (i : KernelComponent χ)
    (w : WeylGroup Tag.E6) (j : Fin Tag.E6.rank)
    (hδ : w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ) ∈ componentRoots χ i)
    {s : Lˣ} (hs : s ^ (S.D.q + 1) = 1) :
    coroot (w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ)) s ∈ rationalComponent S.ρ S.Γ χ i := by
  set δ : Fin Tag.E6.rank → ℤ := w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ) with hδdef
  have hΓM : S.Γ ≤ S.D.model := by
    refine Subgroup.commutator_le.2 fun g hg h hh => ?_
    rw [commutatorElement_def]
    exact mul_mem (mul_mem (mul_mem hg hh) (inv_mem hg)) (inv_mem hh)
  have hCΓ := canonicalRep_mem_E6 (L := L) S.Γ hnΓ w
  have hnδΓ : nRootW (L := L) w j ∈ S.Γ :=
    mul_mem (mul_mem hCΓ (hnΓ j)) (inv_mem hCΓ)
  have hcorΓ : ∀ u : Lˣ, u ^ (S.D.q + 1) = 1 → coroot δ u ∈ S.Γ := fun u hu => by
    obtain ⟨t, rfl, ht⟩ := exists_sqrt_E6 hq2 hu
    rw [← commutator_coroot_nRootW]
    exact Subgroup.commutator_mem_commutator (hTM δ t ht) (hΓM hnδΓ)
  have hsub : ({δ, -δ} : Set (Fin Tag.E6.rank → ℤ)) ⊆ rationalRoots S.ρ χ i := by
    intro γ hγ
    rcases hγ with rfl | rfl
    · exact ⟨0, _, hδ, rfl⟩
    · exact ⟨0, _, CFSG.ComponentClassification.ExcSelector.neg_mem_componentRoots hδ, rfl⟩
  have hmono : rootSpan Tag.E6 L ({δ, -δ} : Set (Fin Tag.E6.rank → ℤ)) ≤
      rootSpan Tag.E6 L (rationalRoots S.ρ χ i) :=
    iSup₂_le fun α hα => le_iSup₂_of_le α (hsub hα) le_rfl
  obtain ⟨t, rfl, ht⟩ := exists_sqrt_E6 hq2 hs
  rw [← commutator_coroot_nRootW]
  exact Subgroup.commutator_mem_commutator
    (Subgroup.mem_inf.2 ⟨hmono (coroot_mem_rootSpan w j t), hcorΓ t ht⟩)
    (Subgroup.mem_inf.2 ⟨hmono (nRootW_mem_rootSpan w j), hnδΓ⟩)

private theorem exists_weyl_smul_single_E6 {δ : Fin Tag.E6.rank → ℤ} (hδ : IsRoot Tag.E6 δ) :
    ∃ (w : WeylGroup Tag.E6) (j : Fin Tag.E6.rank), w • (Pi.single j 1 : Fin Tag.E6.rank → ℤ) = δ :=
  isRoot_iff_exists_smul_single.1 hδ

private theorem exists_corootTorus_le_of_isComponentOf {L : Type} [Field L] [IsAlgClosed L]
    {p₀ p : ℕ} (hp : p.Prime)
    (hpL : (p : L) ≠ 0) (S : LangSetup Tag.E6 L p₀) (hq2 : Even S.D.q)
    (hTM : ∀ (δ : Fin Tag.E6.rank → ℤ) (s : Lˣ), s ^ (S.D.q + 1) = 1 → coroot δ s ∈ S.D.model)
    (hnΓ : ∀ k, weylElt Tag.E6 L k 1 ∈ S.Γ) (hfin : Finite S.Γ)
    {a : Fin Tag.E6.rank → Lˣ} (hT : rootDiagUnit Tag.E6 a ∈ S.D.torus) (hap : ∀ k, a k ^ p = 1)
    (h1 : rootDiagUnit Tag.E6 a ≠ 1) {K : Subgroup (ModGL Tag.E6 L)}
    (hK : IsComponentOf K (S.Γ ⊓ Subgroup.centralizer {rootDiagUnit Tag.E6 a})) :
    ∃ α : Fin Tag.E6.rank → ℤ, IsRoot Tag.E6 α ∧ rootChar a α = 1 ∧
      ∀ s : Lˣ, s ^ (S.D.q + 1) = 1 → coroot α s ∈ K := by
  obtain ⟨i, -, rfl⟩ := exists_rationalComponent_eq_of_isComponentOf S hp hT hap
    (langSetup_hTame_of_prime S hp hpL (fun h => absurd h (by decide)) hT hap h1) hfin hK
  induction i using Quotient.inductionOn with
  | h x =>
    obtain ⟨α, hα⟩ := x
    obtain ⟨w, j, hwj⟩ := exists_weyl_smul_single_E6 hα.1
    have hmem : α ∈ componentRoots (rootCharHom a) ⟦⟨α, hα⟩⟧ := ⟨hα, rfl⟩
    refine ⟨α, hα.1, hα.2, fun s hs => ?_⟩
    subst hwj
    exact coroot_mem_rationalComponent S hq2 hTM hnΓ _ w j hmem hs

private theorem twE6_conj_rootDiagUnit {L : Type} [Field L]
    {Fr : L →+* L} {q : ℕ} (hFr : ∀ c, Fr c = c ^ q)
    (a : Fin TwistTag.E6.tag.rank → Lˣ) (ha : ∀ k, a k ^ (q + 1) = 1) :
    canonicalRep (coxeterSystem TwistTag.E6.tag) L twE6W0 *
        twistHom TwistTag.E6 L Fr (rootDiagUnit TwistTag.E6.tag a) *
        (canonicalRep (coxeterSystem TwistTag.E6.tag) L twE6W0)⁻¹ = rootDiagUnit TwistTag.E6.tag a := by
  have h := twE6_twFrob_rootDiagUnit hFr a
  have h' : canonicalRep (coxeterSystem TwistTag.E6.tag) L twE6W0 *
        twistHom TwistTag.E6 L Fr (rootDiagUnit TwistTag.E6.tag a) *
        (canonicalRep (coxeterSystem TwistTag.E6.tag) L twE6W0)⁻¹ =
      (rootDiagUnit TwistTag.E6.tag a)⁻¹ ^ q := h
  rw [h', rootDiagUnit_inv, rootDiagUnit_pow]
  congr 1
  funext k
  simp only [Pi.pow_apply, Pi.inv_apply]
  rw [inv_pow]
  exact inv_eq_of_mul_eq_one_right (by rw [← pow_succ]; exact ha k)

private theorem coroot_mem_model {L : Type} [Field L] [IsAlgClosed L]
    {Fr : L →+* L} {q : ℕ} (hFr : ∀ c, Fr c = c ^ q)
    {g0 : ModGL Tag.E6 L} (hg0C : g0 ∈ adjointGroup Tag.E6 L)
    (hg0 : twistHom TwistTag.E6 L Fr g0 = g0 * canonicalRep (coxeterSystem Tag.E6) L twE6W0)
    (δ : Fin Tag.E6.rank → ℤ) {s : Lˣ} (hs : s ^ (q + 1) = 1) :
    coroot δ s ∈ (LangDatum.ofTwist TwistTag.E6 Fr q hFr twE6W0 hg0C hg0).model := by
  have hk : ∀ k, corootTuple δ s k ^ (q + 1) = 1 := fun k => by
    rw [corootTuple, ← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hs, one_zpow]
  have hT : coroot δ s ∈ twistedTorusOf
      (LangDatum.ofTwist TwistTag.E6 Fr q hFr twE6W0 hg0C hg0).n
      (LangDatum.ofTwist TwistTag.E6 Fr q hFr twE6W0 hg0C hg0).Φ :=
    mem_twistedTorusOf.2 ⟨CFSG.LieType.Chevalley.rootDiagUnit_mem_torusGroup _,
      twE6_conj_rootDiagUnit hFr _ hk⟩
  exact twistedTorusOf_le_fixModel _ _ hT

private theorem weylElt_mem_Γ_of_conj {L : Type} [Field L] [IsAlgClosed L]
    {Fr : L →+* L} {q : ℕ} (hFr : ∀ c, Fr c = c ^ q)
    {g0 : ModGL Tag.E6 L} (hg0C : g0 ∈ adjointGroup Tag.E6 L)
    (hg0 : twistHom TwistTag.E6 L Fr g0 = g0 * canonicalRep (coxeterSystem Tag.E6) L twE6W0)
    (hn : ∀ k, g0 * weylElt Tag.E6 L k 1 * g0⁻¹ ∈
      ⁅fixModel (τ := Tag.E6) (twistHom TwistTag.E6 L Fr), fixModel (τ := Tag.E6) (twistHom TwistTag.E6 L Fr)⁆) (k : Fin 6) :
    weylElt Tag.E6 L k 1 ∈ (LangDatum.ofTwist TwistTag.E6 Fr q hFr twE6W0 hg0C hg0).Γ := by
  set D := LangDatum.ofTwist TwistTag.E6 Fr q hFr twE6W0 hg0C hg0 with hD
  have hΓ : D.Γ = ⁅fixModel (τ := Tag.E6) (twistHom TwistTag.E6 L Fr),
      fixModel (τ := Tag.E6) (twistHom TwistTag.E6 L Fr)⁆.map (MulAut.conj g0⁻¹).toMonoidHom := by
    rw [Subgroup.map_commutator]
    unfold LangDatum.Γ
    rw [D.model_eq_map_fixModel]
    rfl
  rw [hΓ]
  refine ⟨_, hn k, ?_⟩
  simp [MulAut.conj_apply, mul_assoc]

private theorem isComponentOf_map_conj' {G : Type*} [Group G] {K H : Subgroup G} (hK : IsComponentOf K H)
    (g : G) :
    IsComponentOf (K.map (MulAut.conj g).toMonoidHom) (H.map (MulAut.conj g).toMonoidHom) := by
  obtain ⟨hKH, hs, hq⟩ := hK
  exact ⟨Subgroup.map_mono hKH, CFSG.Open.IsSubnormal.map _ hs,
    CFSG.Open.IsQuasisimple.of_mulEquiv (K.equivMapOfInjective (MulAut.conj g).toMonoidHom
      (MulAut.conj g).injective).symm hq⟩

private theorem map_conj_centralizer_singleton {G : Type*} [Group G] (c x : G) :
    (Subgroup.centralizer {x}).map (MulAut.conj c).toMonoidHom =
      Subgroup.centralizer {c * x * c⁻¹} := by
  ext y
  rw [Subgroup.mem_map, Subgroup.mem_centralizer_singleton_iff]
  constructor
  · rintro ⟨z, hz, rfl⟩
    rw [Subgroup.mem_centralizer_singleton_iff] at hz
    change c * z * c⁻¹ * (c * x * c⁻¹) = c * x * c⁻¹ * (c * z * c⁻¹)
    calc c * z * c⁻¹ * (c * x * c⁻¹) = c * (z * x) * c⁻¹ := by group
      _ = c * (x * z) * c⁻¹ := by rw [hz]
      _ = _ := by group
  · intro h
    refine ⟨c⁻¹ * y * c, ?_, ?_⟩
    · rw [Subgroup.mem_centralizer_singleton_iff]
      calc c⁻¹ * y * c * x = c⁻¹ * (y * (c * x * c⁻¹)) * c := by group
        _ = c⁻¹ * ((c * x * c⁻¹) * y) * c := by rw [h]
        _ = _ := by group
    · change c * (c⁻¹ * y * c) * c⁻¹ = y
      group

private theorem not_five_dvd_of_even_primePow {q : ℕ} (hq2 : Even q) (hqpow : IsPrimePow q) :
    ¬ 5 ∣ q := by
  obtain ⟨r, k, hr, hk, rfl⟩ := (isPrimePow_nat_iff q).1 hqpow
  intro h5
  have h2 : 2 ∣ r ^ k := even_iff_two_dvd.1 hq2
  have hr2 : r = 2 := ((Nat.prime_dvd_prime_iff_eq Nat.prime_two hr).1
    (Nat.prime_two.dvd_of_dvd_pow h2)).symm
  subst hr2
  have := (Nat.prime_five.dvd_of_dvd_pow h5)
  omega

theorem exists_corootTorus_le_frame
    {L : Type} [Field L] [IsAlgClosed L] [CharP L 2] {Fr : L →+* L} {q : ℕ}
    (hq0 : 0 < q) (hq2 : Even q) (hFr : ∀ c, Fr c = c ^ q)
    (hqpow : IsPrimePow q) (hfinF : Finite (fixModel (τ := Tag.E6) (twistHom TwistTag.E6 L Fr)))
    {g : ModGL Tag.E6 L} (hgC : g ∈ adjointGroup Tag.E6 L)
    (hg : twistHom TwistTag.E6 L Fr g = g * canonicalRep (coxeterSystem Tag.E6) L twE6W0)
    (hn : ∀ k, g * weylElt Tag.E6 L k 1 * g⁻¹ ∈
      ⁅fixModel (τ := Tag.E6) (twistHom TwistTag.E6 L Fr), fixModel (τ := Tag.E6) (twistHom TwistTag.E6 L Fr)⁆)
    {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {a : Fin Tag.E6.rank → Lˣ} (hap : ∀ k, a k ^ p = 1)
    (haq : ∀ k, a k ^ (q + 1) = 1) (h1 : rootDiagUnit Tag.E6 a ≠ 1)
    {K' : Subgroup (ModGL Tag.E6 L)}
    (hK : IsComponentOf K' (⁅fixModel (τ := Tag.E6) (twistHom TwistTag.E6 L Fr),
        fixModel (τ := Tag.E6) (twistHom TwistTag.E6 L Fr)⁆ ⊓
      Subgroup.centralizer {g * rootDiagUnit Tag.E6 a * g⁻¹})) :
    ∃ α : Fin Tag.E6.rank → ℤ, IsRoot Tag.E6 α ∧ rootChar a α = 1 ∧
      ∀ s : Lˣ, s ^ (q + 1) = 1 → g * coroot α s * g⁻¹ ∈ K' := by
  classical
  have hqL : ((q : ℕ) : L) = 0 := by
    obtain ⟨m, hm⟩ := hq2
    rw [hm, Nat.cast_add, ← two_mul]
    simp [CharTwo.two_eq_zero]
  have hpL : (p : L) ≠ 0 := fun h => hp2 ((Nat.prime_dvd_prime_iff_eq Nat.prime_two hp).1
    ((CharP.cast_eq_zero_iff L 2 p).1 h)).symm
  set D := LangDatum.ofTwist TwistTag.E6 Fr q hFr twE6W0 hgC hg with hD
  have hmodel : D.model = (fixModel (τ := Tag.E6) (twistHom TwistTag.E6 L Fr)).map
      (MulAut.conj g⁻¹).toMonoidHom := D.model_eq_map_fixModel
  have hfin : Finite D.model := by
    rw [hmodel]
    haveI := hfinF
    exact Finite.of_equiv _ ((fixModel (τ := Tag.E6) (twistHom TwistTag.E6 L Fr)).equivMapOfInjective
      (MulAut.conj g⁻¹).toMonoidHom (MulAut.conj g⁻¹).injective).toEquiv
  let S := twE6LangSetup Fr q hq0 hFr hgC hg 5 Nat.prime_five (Or.inl le_rfl) ⟨hqpow, hqL⟩
    (not_five_dvd_of_even_primePow hq2 hqpow) hfin
  have hΓ : S.Γ = ⁅fixModel (τ := Tag.E6) (twistHom TwistTag.E6 L Fr),
      fixModel (τ := Tag.E6) (twistHom TwistTag.E6 L Fr)⁆.map (MulAut.conj g⁻¹).toMonoidHom := by
    rw [Subgroup.map_commutator]
    change ⁅D.model, D.model⁆ = _
    rw [hmodel]
    rfl
  haveI : Finite S.D.model := hfin
  have hΓM : S.Γ ≤ S.D.model := by
    refine Subgroup.commutator_le.2 fun g hg h hh => ?_
    rw [commutatorElement_def]
    exact mul_mem (mul_mem (mul_mem hg hh) (inv_mem hg)) (inv_mem hh)
  have hfinΓ : Finite S.Γ :=
    Finite.of_injective (Subgroup.inclusion hΓM) (Subgroup.inclusion_injective _)
  have hk : ∀ k, a k ^ (q + 1) = 1 := haq
  have hT : rootDiagUnit Tag.E6 a ∈ S.D.torus :=
    mem_twistedTorusOf.2 ⟨CFSG.LieType.Chevalley.rootDiagUnit_mem_torusGroup _,
      twE6_conj_rootDiagUnit hFr _ hk⟩
  have hK0 : IsComponentOf (K'.map (MulAut.conj g⁻¹).toMonoidHom)
      (S.Γ ⊓ Subgroup.centralizer {rootDiagUnit Tag.E6 a}) := by
    have h := isComponentOf_map_conj' hK g⁻¹
    rw [Subgroup.map_inf _ _ _ (MulAut.conj g⁻¹).injective, map_conj_centralizer_singleton] at h
    have e : g⁻¹ * (g * rootDiagUnit Tag.E6 a * g⁻¹) * g⁻¹⁻¹ = rootDiagUnit Tag.E6 a := by
      group
    rw [e, ← hΓ] at h
    exact h
  obtain ⟨α, hα, hχ, hc⟩ := exists_corootTorus_le_of_isComponentOf hp hpL S hq2
    (fun δ s hs => coroot_mem_model hFr hgC hg δ hs)
    (fun k => weylElt_mem_Γ_of_conj hFr hgC hg hn k) hfinΓ hT hap h1 hK0
  refine ⟨α, hα, hχ, fun s hs => ?_⟩
  obtain ⟨y, hy, hyE⟩ := hc s hs
  have : y = g * coroot α s * g⁻¹ := by
    rw [← hyE]
    simp [MulAut.conj_apply]
    group
  rw [← this]
  exact hy

end CFSG.StandardType.TwE6Coroot
