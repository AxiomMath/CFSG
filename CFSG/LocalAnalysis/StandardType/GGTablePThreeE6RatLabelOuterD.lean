private theorem lieModel_twoD_highG_compRank
    {τ : Tag}
    (hτ : τ = .D4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8)
    (K : KacData τ) (hK : K.Facts) {E : List (ℕ × ℕ)} {tp : ℕ → ℕ → List ℕ}
    (hT : IsTreePaths (τ.rank + 1) E tp)
    (hadj : ∀ x y : Option (Fin τ.rank), K.Adj x y ↔ (nodeIdx x, nodeIdx y) ∈ E)
    {cands : List (List ℕ)}
    (hcheck : ((List.range (τ.rank + 1)).sublists.all fun zl =>
      !(fun _ : List ℕ => true) zl ||
        zl.all fun x => cands.any (sameSet (compIdx (τ.rank + 1) tp zl x))) = true)
    (hlt : ∀ c ∈ cands, ∀ w ∈ c, w < τ.rank + 1)
    (hcard : ∀ c ∈ cands, (c.map (idxNode (r := τ.rank))).toFinset.card = c.length)
    {trees : List (List (Option (Fin τ.rank)))}
    (hcount : ∀ c ∈ cands, 4 ≤ c.length →
      kacCount τ K.θ (c.map (idxNode (r := τ.rank))).toFinset = 2 * c.length * (c.length - 1) →
        ∃ P ∈ trees, sameSet c (P.map nodeIdx) = true)
    (htrees : ∀ P ∈ trees, P.Nodup ∧ 4 ≤ P.length ∧
      (∀ c d : Fin P.length, c ≠ d → ¬ edgeD P.length c d → ¬ edgeD P.length d c →
        iform (K.extRoot (P.get c)) (K.extRoot (P.get d)) = 0) ∧
      ∀ c d : Fin P.length, edgeD P.length c d →
        (nodeIdx (P.get c), nodeIdx (P.get d)) ∈ E)
    (hframes : ∀ {F : Type} [Field F] (x y : Option (Fin τ.rank)),
      (nodeIdx x, nodeIdx y) ∈ E →
        ∃ (ρ : SL(3, F) →* ModGL τ F) (σ : Fin 3 → Fin 3 → Fin τ.rank → ℤ),
          CFSG.RankThree.PartOne.KF4.IsA2Frame ρ σ ∧ σ 0 1 = K.extRoot x ∧
            σ 1 2 = K.extRoot y)
    {L : Type} [Field L] [IsAlgClosed L] {p₀ p : ℕ} (S : LangSetup τ L p₀) (hcp : CharP L 2)
    (hp : p.Prime) (hpL : (p : L) ≠ 0) {a : Fin τ.rank → Lˣ}
    (hTor : rootDiagUnit τ a ∈ S.D.torus) (hTp : rootDiagUnit τ a ^ p = 1)
    (i : KernelComponent (rootCharHom a))
    (h5 : 5 ≤ compRank (componentRoots (rootCharHom a) i))
    (hn : (componentRoots (rootCharHom a) i).ncard =
      2 * compRank (componentRoots (rootCharHom a) i) *
        (compRank (componentRoots (rootCharHom a) i) - 1))
    (hkind : twistKind S.ρ (rootCharHom a) i = .twoD)
    (Q : ℕ → ℕ → Prop) (hrec : TwoDChainRecogAll L Q) (hQ : Q (ringChar L) S.D.q) :
    ∃ e : ℕ, 2 ^ e = S.D.q ∧
      LieModel (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) .POmegaMinus
        (compRank (componentRoots (rootCharHom a) i)) 2 e := by
  classical
  haveI := hcp
  obtain ⟨r, e, m, hr, hchar, hm5, z, ε, D, hq, he, hDe, hRC, hDs, hCart, hfix, hswap⟩ :=
    CompsPTwoDExport.exists_twoD_export S hτ hTor i hkind h5
  have hrc : ringChar L = r := @ringChar.eq L _ r hchar
  have h2 : r = 2 := by rw [← hrc]; exact @ringChar.eq L _ 2 hcp
  haveI := hr
  haveI := hchar
  have hmcomp : m = compRank (componentRoots (rootCharHom a) i) := by
    have h1 : m = (simpleRoots (componentRoots (rootCharHom a) i)).card := by
      rw [← Fintype.card_fin m,
        ← Fintype.card_coe (simpleRoots (componentRoots (rootCharHom a) i))]
      exact (Fintype.card_congr ε).symm
    rw [h1, ← compRank_eq_card (isRootComponent_componentRoots i)]
  have hQ' : Q r (r ^ e) := by
    have h := hQ
    rw [hrc, hq] at h
    exact h
  have hR : CompsPTwoDDatumG.TwoDChainRecog r L D.e m := by
    rw [hDe]
    exact hrec r e m he hm5 hQ'
  have hΨ : IsRootComponent (componentRoots (rootCharHom a) i) := isRootComponent_componentRoots i
  have hsl : ∀ β ∈ componentRoots (rootCharHom a) i, iform β β = 2 := fun β hβ => by
    rw [← dotProduct_mulVec_eq_iform]
    exact rootForm_self hτ (hΨ.isRoot β hβ)
  have hbroot : ∀ j : Fin m, IsRoot τ (ε.symm j : Fin τ.rank → ℤ) := fun j =>
    simpleRoots_isRoot (ε.symm j).2
  have hbinj : Function.Injective (fun j : Fin m => (ε.symm j : Fin τ.rank → ℤ)) :=
    fun j k h => ε.symm.injective (Subtype.ext h)
  have hG : ∀ j k : Fin m, iform (ε.symm j : Fin τ.rank → ℤ) (ε.symm k) =
      CFSG.LieType.Universal.Spin.cartanD m j k := by
    intro j k
    have h := hCart (ε.symm j) (ε.symm k)
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply] at h
    rw [← h]
    exact (CompsPTwoDBase.corootPair_eq_iform (hbroot j)
      (hsl _ (simpleRoots_subset (ε.symm j).2)) _).symm
  have hrange : Set.range (fun j : Fin m => (ε.symm j : Fin τ.rank → ℤ)) =
      ((simpleRoots (componentRoots (rootCharHom a) i) : Finset (Fin τ.rank → ℤ)) :
        Set (Fin τ.rank → ℤ)) := by
    ext β
    constructor
    · rintro ⟨j, rfl⟩
      exact (ε.symm j).2
    · intro hβ
      exact ⟨ε ⟨β, hβ⟩, by simp⟩
  have hsw := hswap ⟨m - 2, by omega⟩ ⟨m - 1, by omega⟩ (by simp only [Fin.val_mk]; omega)
    (by simp only [Fin.val_mk]; omega)
  have hlie := lieModel_orbitGroup_of_datum_four hτ D (by omega) hR
    (fun j : Fin m => (ε.symm j : Fin τ.rank → ℤ)) hbroot hbinj hG (hDs.trans hrange.symm) hfix
    hsw.1 hsw.2
    (fun j k hjk => exists_dFrames hτ K hK hT hadj hcheck hlt hcard hcount htrees hframes S hp hpL
      hTp i (by omega) hn ε hCart L j k hjk)
  let eR : ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ≃* ↥D.orbitGroup :=
    ((rationalComponent S.ρ S.Γ (rootCharHom a) i).equivMapOfInjective
      (MulAut.conj z⁻¹).toMonoidHom (MulAut.conj z⁻¹).injective).trans
      (MulEquiv.subgroupCongr hRC)
  have hqiso : ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
      Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ≃*
      ↥D.orbitGroup ⧸ Subgroup.center ↥D.orbitGroup :=
    QuotientGroup.congr _ _ eR (Subgroup.map_center_eq eR)
  have hmodel : LieModel (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
      Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i))
      .POmegaMinus m r D.e :=
    LieModel.of_mulEquiv hqiso.symm hlie
  refine ⟨e, ?_, ?_⟩
  · rw [hq, h2]
  · simpa only [hmcomp, h2, hDe] using hmodel

private theorem lieModel_twoD_highG_compRank_all
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L]
    [CharP L 2] {p₀ p : ℕ} (S : LangSetup τ L p₀) (hp : p.Prime) {a : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ a ∈ S.D.torus) (hap : ∀ j, a j ^ p = 1) (h1 : rootDiagUnit τ a ≠ 1)
    (i : KernelComponent (rootCharHom a)) (h5 : 5 ≤ compRank (componentRoots (rootCharHom a) i))
    (hn : (componentRoots (rootCharHom a) i).ncard =
      2 * compRank (componentRoots (rootCharHom a) i) *
        (compRank (componentRoots (rootCharHom a) i) - 1))
    (hout : ¬ twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ (componentRoots (rootCharHom a) i)])) :
    ∃ e : ℕ, 2 ^ e = S.D.q ∧
      LieModel (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) .POmegaMinus
        (compRank (componentRoots (rootCharHom a) i)) 2 e := by
  have hℓp : ringChar L ≠ p := ringChar_ne_of_pow_eq_one hp hap h1
  have hpL : ((p : ℕ) : L) ≠ 0 := natCast_ne_zero_of_ringChar_ne hp hℓp
  have hTp : rootDiagUnit τ a ^ p = 1 := rootDiagUnit_pow_eq_one_of_forall hap
  have hkind : twistKind S.ρ (rootCharHom a) i = .twoD := by
    unfold twistKind
    rw [if_neg hout, if_neg, if_pos ⟨by omega, hn⟩]
    rintro (⟨h6, h72⟩ | ⟨h4', -, -⟩)
    · rw [hn, h6] at h72; omega
    · omega
  have hr := compRank_le_rank (componentRoots (rootCharHom a) i)
  cases τ with
  | G2 => exact absurd (le_trans h5 hr) (by simp [Tag.rank])
  | F4 => exact absurd (le_trans h5 hr) (by simp [Tag.rank])
  | D4 => exact absurd (le_trans h5 hr) (by simp [Tag.rank])
  | E6 =>
    exact lieModel_twoD_highG_compRank (Or.inr (Or.inl rfl))
      kacE6 facts_E6 e6_tree e6_adj e6_check e6_lt e6_card e6_dcount e6_dtrees
      (fun {F} _ x y h => e6_frames x y h) S hp hpL hT hTp i h5 hn hkind (fun _ _ => True)
      (fun r _ _ e m he hm5 _ => CompsPTwoDChainO.twoDChainRecog_all he (by omega)) trivial
      (hcp := ‹CharP L 2›)
  | E7 =>
    exact lieModel_twoD_highG_compRank (Or.inr (Or.inr (Or.inl rfl)))
      kacE7 facts_E7 e7_tree e7_adj e7_check e7_lt e7_card e7_dcount e7_dtrees
      (fun {F} _ x y h => e7_frames x y h) S hp hpL hT hTp i h5 hn hkind (fun _ _ => True)
      (fun r _ _ e m he hm5 _ => CompsPTwoDChainO.twoDChainRecog_all he (by omega)) trivial
      (hcp := ‹CharP L 2›)
  | E8 =>
    exact lieModel_twoD_highG_compRank (Or.inr (Or.inr (Or.inr rfl)))
      kacE8 facts_E8 e8_tree e8_adj e8_check e8_lt e8_card e8_dcount e8_dtrees
      (fun {F} _ x y h => e8_frames x y h) S hp hpL hT hTp i h5 hn hkind (fun _ _ => True)
      (fun r _ _ e m he hm5 _ => CompsPTwoDChainO.twoDChainRecog_all he (by omega)) trivial
      (hcp := ‹CharP L 2›)

private theorem lieModel_triD4_of_mulEquiv {X Y : Type} [Group X] [Group Y] (e : X ≃* Y)
    {ℓ f : ℕ} (h : LieModel (X ⧸ Subgroup.center X) .trialityD4 0 ℓ f) :
    LieModel (Y ⧸ Subgroup.center Y) .trialityD4 0 ℓ f := by
  let e' : X ⧸ Subgroup.center X ≃* Y ⧸ Subgroup.center Y :=
    QuotientGroup.congr (Subgroup.center X) (Subgroup.center Y) e (Subgroup.map_center_eq e)
  exact h.of_mulEquiv e'

theorem lieModel_triD4_map_conj
    {G : Type} [Group G] {ℓ f : ℕ} {R : Subgroup G}
    (φ : G ≃* G) (h : LieModel (↥R ⧸ Subgroup.center ↥R) .trialityD4 0 ℓ f) :
    LieModel (↥(R.map φ.toMonoidHom) ⧸ Subgroup.center ↥(R.map φ.toMonoidHom))
      .trialityD4 0 ℓ f :=
  lieModel_triD4_of_mulEquiv (R.equivMapOfInjective φ.toMonoidHom φ.injective) h

private theorem lieModel_graphFixed_cubic
    {ℓ f' : ℕ} (hℓ : ℓ.Prime) (hf' : 1 ≤ f')
    (K : Type) [Field K] [Finite K] (hK : Nat.card K = (ℓ ^ f') ^ 3) (σ : K ≃+* K) {r : ℕ}
    (hr : r = 1 ∨ r = 2) (hσ : ∀ c, σ c = c ^ ((ℓ ^ f') ^ r)) :
    LieModel (↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom) ⧸
      Subgroup.center ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) .trialityD4 0 ℓ f' := by
  have hZ : Subgroup.center ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom) = ⊥ :=
    center_graphFixedRootGroup_eq_bot σ.surjective
  let e0 : (↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom) ⧸
      Subgroup.center ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom)) ≃*
        ↥(graphFixedRootGroup TwistTag.D4 K σ.toRingHom) :=
    (QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot
  refine (l154r4_lieModel_graphFixed_trialityD4 hℓ hf' hK σ ?_).of_mulEquiv e0.symm
  rcases hr with rfl | rfl
  · exact Or.inl fun c => by rw [hσ, pow_one]
  · exact Or.inr hσ

theorem lieModel_model_layer_triality
    {τ : Tag} [E6Sub τ] {L : Type} [Field L]
    [IsAlgClosed L] {ℓ f : ℕ} [Fact ℓ.Prime] [CharP L ℓ] {n₁ : ModGL τ L}
    {π : Equiv.Perm (Fin τ.rank)} {e : ℕ} (hf : 1 ≤ f) (hstd : StdTwist n₁ π e)
    {n h : ModGL τ L} (hh : h ∈ subsystemGroup τ L (d4Set τ))
    (hlang : ∀ g : ModGL τ L,
      n * Units.map (entrywiseHom (iterateFrobenius L ℓ f)) g * n⁻¹ = g ↔
        n₁ * Units.map (entrywiseHom (iterateFrobenius L ℓ f)) (h * g * h⁻¹) * n₁⁻¹ =
          h * g * h⁻¹)
    {P : Subgroup (ModGL τ L)}
    (hP : P = subsystemGroup τ L (d4Set τ) ⊓
      twistedFixedPoints n (Units.map (entrywiseHom (iterateFrobenius L ℓ f)))) :
    LieModel (↥P ⧸ Subgroup.center ↥P) .trialityD4 0 ℓ f := by
  obtain ⟨K, hK, hKf, σ, hKc, hσ, ⟨eP⟩⟩ := layer_graph_equiv_of_standard hf hstd hh hlang hP
  exact lieModel_triD4_of_mulEquiv eP.symm
    (lieModel_graphFixed_cubic (Fact.out : ℓ.Prime) hf K hKc σ hstd.he hσ)

theorem lieModel_trialityLayer_generic
    {τ : Tag} [E6Sub τ] {L : Type} [Field L]
    [IsAlgClosed L] {ℓ f : ℕ} [Fact ℓ.Prime] [CharP L ℓ] (hf : 1 ≤ f)
    (π : Equiv.Perm (Fin τ.rank)) (e : ℕ) (he : e = 1 ∨ e = 2)
    (hπe : ∀ k : Fin Tag.D4.rank, π (d4Id k) = d4Id (rhoE e k))
    (hπ : ∀ i ∈ d4Set τ, π i ∈ d4Set τ) (hπ' : ∀ i ∈ d4Set τ, π.symm i ∈ d4Set τ)
    (n : ModGL τ L) (hn : n ∈ monomialSubgroup τ L)
    (hact : ∃ u ∈ parabolicWeylGroup τ (d4Nodes τ), ∀ α ∈ parabolicRoots τ (d4Nodes τ),
      weylQuotientHom τ L ⟨n, hn⟩ • α = u • permLattice π α)
    (P : Subgroup (ModGL τ L)) (hP : P = rootSpan τ L (parabolicRoots τ (d4Nodes τ)) ⊓
      twistedFixedPoints n (Units.map (entrywiseHom (iterateFrobenius L ℓ f)))) :
    LieModel (↥P ⧸ Subgroup.center ↥P) .trialityD4 0 ℓ f := by
  obtain ⟨u, hu, hu'⟩ := hact
  have hact' : ∀ j ∈ d4Set τ, weylQuotientHom τ L ⟨n, hn⟩ • (Pi.single j 1 : Fin τ.rank → ℤ) =
      u • (Pi.single (π j) 1 : Fin τ.rank → ℤ) := fun j hj => by
    have := hu' _ (single_mem_parabolicRoots hj)
    rwa [permLattice_single] at this
  obtain ⟨n₁, h, hn₁, hh, hgen, hlang⟩ := exists_conj_twistedFixed hf hn hπ hπ' hu hact'
  have hstd : StdTwist n₁ π e := ⟨he, hπe, hπ, hπ', hgen⟩
  rw [← subsystemGroup_eq_rootSpan] at hP
  exact lieModel_model_layer_triality hf hstd hh hlang hP

theorem lieModel_rootSpan_inf_model_d4_of_layer_triality
    {τ : Tag} {L : Type} [Field L]
    [IsAlgClosed L] {p : ℕ} (S : LangSetup τ L p) {Fr : L →+* L}
    (hFr : ∀ c, Fr c = c ^ S.D.q) (hΦ : S.D.Φ = Units.map (entrywiseHom Fr))
    {w : WeylGroup τ} (hn : S.D.n = canonicalRep (coxeterSystem τ) L w) (v : WeylGroup τ)
    {u : WeylGroup τ} (hu : u ∈ parabolicWeylGroup τ (d4Nodes τ)) {π : Equiv.Perm (Fin τ.rank)}
    (hlayer : ∀ (ℓ f : ℕ) [Fact ℓ.Prime] [CharP L ℓ], 1 ≤ f → S.D.q = ℓ ^ f →
      ∀ (n : ModGL τ L) (hn : n ∈ monomialSubgroup τ L), n ∈ adjointGroup τ L →
      (∃ u ∈ parabolicWeylGroup τ (d4Nodes τ), ∀ α ∈ parabolicRoots τ (d4Nodes τ),
        weylQuotientHom τ L ⟨n, hn⟩ • α = u • permLattice π α) →
      LieModel (↥(rootSpan τ L (parabolicRoots τ (d4Nodes τ)) ⊓
          twistedFixedPoints n (Units.map (entrywiseHom (iterateFrobenius L ℓ f)))) ⧸
        Subgroup.center ↥(rootSpan τ L (parabolicRoots τ (d4Nodes τ)) ⊓
          twistedFixedPoints n (Units.map (entrywiseHom (iterateFrobenius L ℓ f)))))
        .trialityD4 0 ℓ f)
    (hact : ∀ α ∈ parabolicRoots τ (d4Nodes τ),
      (v⁻¹ * w * v) • α = u • permLattice π α) :
    ∃ f : ℕ, ringChar L ^ f = S.D.q ∧
      LieModel (↥(rootSpan τ L ((fun α => v • α) '' parabolicRoots τ (d4Nodes τ)) ⊓ S.D.model) ⧸
        Subgroup.center ↥(rootSpan τ L ((fun α => v • α) '' parabolicRoots τ (d4Nodes τ)) ⊓
          S.D.model)) .trialityD4 0 (ringChar L) f := by
  classical
  obtain ⟨ℓ, f, hℓ, hchar, hf, hq⟩ := S.exists_char_pow
  have : Fact ℓ.Prime := ⟨hℓ⟩
  have hring : ringChar L = ℓ := ringChar.eq L ℓ
  have hFr' : Fr = iterateFrobenius L ℓ f := by
    ext x
    rw [hFr, hq, iterateFrobenius_def]
  refine ⟨f, by rw [hring, hq], ?_⟩
  set nv := canonicalRep (coxeterSystem τ) L v with hnv
  set nw := canonicalRep (coxeterSystem τ) L w with hnw
  have hroots : ∀ α ∈ parabolicRoots τ (d4Nodes τ), IsRoot τ α := fun α hα => hα.1
  rw [l154r4_rootSpan_inf_model_eq S hFr' hΦ hn,
    rootSpan_inf_twistedFixedPoints_smul _ v nw hroots, hring]
  have hnvM := canonicalRep_mem_monomialSubgroup L v
  have hnwM := canonicalRep_mem_monomialSubgroup L w
  have hn'M : nv⁻¹ * nw * nv ∈ monomialSubgroup τ L :=
    mul_mem (mul_mem (inv_mem hnvM) hnwM) hnvM
  have hn'C : nv⁻¹ * nw * nv ∈ adjointGroup τ L :=
    mul_mem (mul_mem (inv_mem (canonicalRep_mem_adjointGroup _ L v))
      (canonicalRep_mem_adjointGroup _ L w)) (canonicalRep_mem_adjointGroup _ L v)
  have hπ : weylQuotientHom τ L ⟨nv⁻¹ * nw * nv, hn'M⟩ = v⁻¹ * w * v := by
    have e : (⟨nv⁻¹ * nw * nv, hn'M⟩ : monomialSubgroup τ L) =
        (⟨nv, hnvM⟩ : monomialSubgroup τ L)⁻¹ * ⟨nw, hnwM⟩ * ⟨nv, hnvM⟩ := rfl
    rw [e, map_mul, map_mul, map_inv, weylQuotientHom_eq (mapsRootLines_canonicalRep v),
      weylQuotientHom_eq (mapsRootLines_canonicalRep w)]
  have hP := hlayer ℓ f hf hq (nv⁻¹ * nw * nv) hn'M hn'C
    ⟨u, hu, fun α hα => by rw [hπ]; exact hact α hα⟩
  exact lieModel_triD4_map_conj (MulAut.conj nv) hP

theorem d4_action_pi_sq
    {τ : Tag} [E6Sub τ] {L : Type} [Field L] [IsAlgClosed L] {p : ℕ}
    (hsearch : D4BaseSearch τ) (S : LangSetup τ L p) {w : WeylGroup τ}
    (hρw : ∀ γ, IsRoot τ γ → S.ρ γ = w • γ)
    {a : Fin τ.rank → Lˣ} (i : KernelComponent (rootCharHom a)) (v : WeylGroup τ)
    (hΨ : componentRoots (rootCharHom a) i = (fun α => v • α) '' parabolicRoots τ (d4Nodes τ))
    (hρ : ∀ γ ∈ componentRoots (rootCharHom a) i, S.ρ γ ∈ componentRoots (rootCharHom a) i)
    (h1 : ¬ twistInner (componentRoots (rootCharHom a) i) (S.ρ : (Fin τ.rank → ℤ) → _))
    (h2 : ¬ twistInner (componentRoots (rootCharHom a) i) ((S.ρ : (Fin τ.rank → ℤ) → _)^[2])) :
    ∃ u ∈ parabolicWeylGroup τ (d4Nodes τ), ∃ π : Equiv.Perm (Fin τ.rank),
      IsD4LeafPerm π ∧ π ≠ 1 ∧ π * π ≠ 1 ∧
      (∀ α ∈ parabolicRoots τ (d4Nodes τ), (v⁻¹ * w * v) • α = u • permLattice π α) := by
  classical
  set Ψ := componentRoots (rootCharHom a) i with hΨdef
  have hw : ∀ γ ∈ Ψ, w • γ ∈ Ψ := fun γ hγ => by
    rw [← hρw γ hγ.1.1]
    exact hρ γ hγ
  have hmaps : MapsJ τ (d4Set τ) (v⁻¹ * w * v) := by
    intro α hα
    obtain ⟨β, hβ, hβe⟩ := (hΨ ▸ hw (v • α) (hΨ ▸ ⟨α, hα, rfl⟩) :
      w • v • α ∈ (fun α => v • α) '' parabolicRoots τ (d4Nodes τ))
    rw [mul_smul, mul_smul, ← hβe, inv_smul_smul]
    exact hβ
  obtain ⟨u, hu, w₀, hw₀, π, hπ, hw₀π⟩ := exists_d4_action hsearch hmaps
  have hlin0 : ∀ α ∈ parabolicRoots τ (d4Nodes τ), w₀ • α = permLattice π α := fun α hα => by
    have := smul_eq_of_simple (w := w₀) (u := 1) (π := π) (J := d4Set τ)
      (fun j hj => by rw [one_smul]; exact hw₀π j hj) hα.2
    rwa [one_smul] at this
  have hact : ∀ α ∈ parabolicRoots τ (d4Nodes τ),
      (v⁻¹ * w * v) • α = u • permLattice π α := fun α hα => by
    rw [hw₀, mul_smul, hlin0 α hα]
  have hπ1 : π ≠ 1 := by
    rintro rfl
    apply h1
    refine ⟨v * u * v⁻¹, hΨ ▸ conj_mem_closure_rootReflection v hu, ?_⟩
    rintro γ hγ
    obtain ⟨α, hα, rfl⟩ := (hΨ ▸ hγ : γ ∈ (fun α => v • α) '' parabolicRoots τ (d4Nodes τ))
    rw [hρw _ hγ.1.1]
    calc w • v • α = v • ((v⁻¹ * w * v) • α) := by
          rw [mul_smul, mul_smul, smul_inv_smul]
      _ = v • (u • α) := by rw [hact α hα]; rfl
      _ = (v * u * v⁻¹) • v • α := by rw [mul_smul, mul_smul, inv_smul_smul]
  have hπ2 : π * π ≠ 1 := by
    intro hππ
    apply h2
    have hu' : w₀ * u * w₀⁻¹ ∈ parabolicWeylGroup τ (d4Nodes τ) := by
      have hle : (parabolicWeylGroup τ (d4Nodes τ)).map (MulAut.conj w₀).toMonoidHom ≤
          parabolicWeylGroup τ (d4Nodes τ) := by
        rw [parabolicWeylGroup, MonoidHom.map_closure, Subgroup.closure_le]
        rintro _ ⟨_, ⟨j, hj, rfl⟩, rfl⟩
        refine Subgroup.subset_closure ⟨π j, hπ.mem_d4Set hj, ?_⟩
        change simple τ (π j) = w₀ * simple τ j * w₀⁻¹
        rw [← rootReflection_single, ← rootReflection_eq_conj (hw₀π j hj)]
      exact hle ⟨u, hu, rfl⟩
    refine ⟨v * (u * (w₀ * u * w₀⁻¹)) * v⁻¹,
      hΨ ▸ conj_mem_closure_rootReflection v (mul_mem hu hu'), ?_⟩
    rintro γ hγ
    obtain ⟨α, hα, rfl⟩ := (hΨ ▸ hγ : γ ∈ (fun α => v • α) '' parabolicRoots τ (d4Nodes τ))
    have hγr : IsRoot τ (v • α) := hγ.1.1
    have hw2 : w₀ • w₀ • α = α := by
      have hα' : w₀ • α ∈ parabolicRoots τ (d4Nodes τ) := by
        rw [hlin0 α hα]
        refine ⟨?_, fun k hk => ?_⟩
        · rw [← hlin0 α hα]
          exact IsRoot.smul hα.1 w₀
        · have hk' : π.symm k ∉ d4Nodes τ := fun h => hk (by
            have h' := hπ.mem_d4Set (show π.symm k ∈ d4Set τ from h)
            rw [Equiv.apply_symm_apply] at h'
            exact h')
          exact hα.2 _ hk'
      rw [hlin0 _ hα', hlin0 α hα, ← permLattice_mul, hππ]
      rfl
    rw [Function.iterate_succ_apply, Function.iterate_one, hρw _ hγr,
      hρw _ ((isRoot_smul_iff w).2 hγr)]
    calc w • w • v • α = v • ((v⁻¹ * w * v) • (v⁻¹ * w * v) • α) := by
          simp only [mul_smul, smul_inv_smul]
      _ = v • (u • w₀ • u • w₀ • α) := by rw [hw₀]; simp only [mul_smul]
      _ = v • (u • (w₀ * u * w₀⁻¹) • w₀ • w₀ • α) := by simp only [mul_smul, inv_smul_smul]
      _ = (v * (u * (w₀ * u * w₀⁻¹)) * v⁻¹) • v • α := by
          rw [hw2]
          simp only [mul_smul, inv_smul_smul]
  exact ⟨u, hu, π, hπ, hπ1, hπ2, hact⟩

theorem lieModel_rationalComponent_of_d4_triality
    {τ : Tag} [E6Sub τ] {L : Type}
    [Field L] [IsAlgClosed L] {p : ℕ} (hsearch : D4BaseSearch τ) (hL : D4TrialityLayer τ)
    (S : LangSetup τ L p) {Fr : L →+* L} (hFr : ∀ c, Fr c = c ^ S.D.q)
    (hΦ : S.D.Φ = Units.map (entrywiseHom Fr)) {w : WeylGroup τ}
    (hn : S.D.n = canonicalRep (coxeterSystem τ) L w)
    (hρw : ∀ γ, IsRoot τ γ → S.ρ γ = w • γ)
    {a : Fin τ.rank → Lˣ} (i : KernelComponent (rootCharHom a)) (v : WeylGroup τ)
    (hΨ : componentRoots (rootCharHom a) i = (fun α => v • α) '' parabolicRoots τ (d4Nodes τ))
    (hρ : ∀ γ ∈ componentRoots (rootCharHom a) i, S.ρ γ ∈ componentRoots (rootCharHom a) i)
    (h1 : ¬ twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ (componentRoots (rootCharHom a) i)]))
    (h2 : ¬ twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin τ.rank → ℤ) → _)^[2 * componentOrbitLength S.ρ
        (componentRoots (rootCharHom a) i)])) :
    ∃ f : ℕ, ringChar L ^ f = S.D.q ∧
      LieModel (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) .trialityD4 0
        (ringChar L) f := by
  classical
  have hfin : (componentRoots (rootCharHom a) i).Finite :=
    (finite_setOf_isRoot τ).subset fun γ hγ => hγ.1.1
  have h1r := h1
  have h2r := h2
  rw [componentOrbitLength_eq_one hfin hρ, Function.iterate_one] at h1r
  rw [componentOrbitLength_eq_one hfin hρ, mul_one] at h2r
  obtain ⟨u, hu, π, hπ, hπ1, hπ2, hact⟩ := d4_action_pi_sq hsearch S hρw i v hΨ hρ h1r h2r
  have hqs : CFSG.IsQuasisimple
      ↥(rootSpan τ L (componentRoots (rootCharHom a) i) ⊓ S.D.model) :=
    isQuasisimple_rootSpan_inf_model_of_d4 hsearch hL S hFr hΦ hn hρw i v hΨ hρ h1 h2
  have hπd4 : ∀ j ∈ d4Set τ, π j ∈ d4Set τ := fun j hj => hπ.mem_d4Set hj
  have hπd4' : ∀ j ∈ d4Set τ, π.symm j ∈ d4Set τ := fun j hj => hπ.inv.mem_d4Set hj
  have key : ∀ (e : ℕ) (he : e = 1 ∨ e = 2)
      (hπe : ∀ k : Fin Tag.D4.rank, π (d4Id k) = d4Id (rhoE e k)),
      ∃ f : ℕ, ringChar L ^ f = S.D.q ∧
        LieModel (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
          Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) .trialityD4 0
          (ringChar L) f := by
    intro e he hπe
    have hlayer : ∀ (ℓ f : ℕ) [Fact ℓ.Prime] [CharP L ℓ], 1 ≤ f → S.D.q = ℓ ^ f →
        ∀ (n : ModGL τ L) (hn : n ∈ monomialSubgroup τ L), n ∈ adjointGroup τ L →
        (∃ u ∈ parabolicWeylGroup τ (d4Nodes τ), ∀ α ∈ parabolicRoots τ (d4Nodes τ),
          weylQuotientHom τ L ⟨n, hn⟩ • α = u • permLattice π α) →
        LieModel (↥(rootSpan τ L (parabolicRoots τ (d4Nodes τ)) ⊓
            twistedFixedPoints n (Units.map (entrywiseHom (iterateFrobenius L ℓ f)))) ⧸
          Subgroup.center ↥(rootSpan τ L (parabolicRoots τ (d4Nodes τ)) ⊓
            twistedFixedPoints n (Units.map (entrywiseHom (iterateFrobenius L ℓ f)))))
          .trialityD4 0 ℓ f :=
      fun ℓ f _ _ hf hq n hn hC hex =>
        lieModel_trialityLayer_generic hf π e he hπe hπd4 hπd4' n hn hex _ rfl
    obtain ⟨f, hf, hmodel⟩ :=
      lieModel_rootSpan_inf_model_d4_of_layer_triality S hFr hΦ hn v hu hlayer hact
    refine ⟨f, hf, ?_⟩
    rw [rationalComponent_eq_of_layer S i hρ hqs, hΨ]
    exact hmodel
  rcases hπ.eq_cycle hπ1 hπ2 with hπe | hπe
  · subst hπe
    exact key 1 (Or.inl rfl) (by intro k; fin_cases k <;> rfl)
  · subst hπe
    exact key 2 (Or.inr rfl) (by intro k; fin_cases k <;> rfl)

private theorem lieModel_rank4_exc_all
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] [CharP L 2]
    {p₀ p : ℕ} (S : LangSetup τ L p₀) (hp : p.Prime) (hpL : ((p : ℕ) : L) ≠ 0)
    {a : Fin τ.rank → Lˣ} (hT : rootDiagUnit τ a ∈ S.D.torus) (hTp : rootDiagUnit τ a ^ p = 1)
    (ha1 : rootDiagUnit τ a ≠ 1)
    (i : KernelComponent (rootCharHom a)) (h4 : compRank (componentRoots (rootCharHom a) i) = 4)
    (hc : (componentRoots (rootCharHom a) i).ncard = 24)
    (hout : ¬ twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ (componentRoots (rootCharHom a) i)]))
    (hexc : twistKind S.ρ (rootCharHom a) i = .exc) :
    ∃ f : ℕ, 2 ^ f = S.D.q ∧
      (LieModel (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) .POmegaMinus 4 2 f ∨
      LieModel (↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) ⧸
        Subgroup.center ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) .trialityD4 0 2 f) := by
  have h2 : ¬ twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin τ.rank → ℤ) → _)^[2 * componentOrbitLength S.ρ
        (componentRoots (rootCharHom a) i)]) := by
    rcases (exc_kind hexc).2 with ⟨h6, -⟩ | ⟨-, -, h2'⟩
    · omega
    · exact h2'
  have hr := compRank_le_rank (componentRoots (rootCharHom a) i)
  cases τ with
  | G2 =>
    have hle := compRank_le_rank (componentRoots (rootCharHom a) i)
    rw [h4] at hle
    exact absurd hle (by decide)
  | F4 =>
    obtain ⟨v, μ, -, hpinned⟩ := S.exists_pinnedT_of_prime hp hpL facts_F4 hTp
    obtain ⟨x, C, -, -, -, hr', hc'⟩ := hpinned i
    exact absurd (hc' ▸ hc) (kacCount_F4_four C (hr' ▸ h4))
  | D4 => exact absurd (rootDiagUnit_eq_one_of_ncard i (by rw [hc]; rfl)) ha1
  | E6 =>
    obtain ⟨v, hv, hρ⟩ := S.d4_pinnedT_of_prime hp hpL facts_E6 kacCount_E6_four (by decide)
      (by decide)
      (fun y hy => far_d4_E6 y fun z hz => by
        have h := hy z hz
        rwa [KacData.Adj, extRoot_eq_extRootOf] at h)
      ⟨none, by decide⟩ (lt_of_eq_of_lt kacCount_far_E6 (by decide)) hT hTp i h4 hc
    have hfin : (componentRoots (rootCharHom a) i).Finite :=
      (finite_setOf_isRoot _).subset fun γ hγ => hγ.1.1
    have hs := componentOrbitLength_eq_one hfin hρ
    obtain ⟨w, hn⟩ := S.D.n_weyl
    obtain ⟨Fr, hFr, P, hP, hΦ⟩ := S.D.steinberg
    rcases hP with rfl | ⟨t, ht, rfl⟩
    · have hΦ' : S.D.Φ = Units.map (entrywiseHom Fr) := by
        ext1 g; rw [hΦ, one_mul, inv_one, mul_one]
      obtain ⟨f, hf, hmodel⟩ := lieModel_rationalComponent_of_d4_triality d4Base_E6
        d4TrialityLayer_E6 S hFr hΦ' hn (fun γ hγ => S.rho_eq_smul_of_frob hFr hΦ' hn hγ)
        i v hv hρ hout h2
      rw [ringChar.eq L 2] at hf hmodel
      exact ⟨f, hf, Or.inr hmodel⟩
    · rw [hs, Function.iterate_one] at hout
      obtain ⟨f, hf, hM⟩ := l154r4_rationalComponent_of_d4_twE6 S ⟨t, ht, Fr, hFr, hΦ⟩ i v hv hρ hout
      rw [ringChar.eq L 2] at hf hM
      exact ⟨f, hf, hM⟩
  | E7 =>
    obtain ⟨v, hv, hρ⟩ := S.d4_pinnedT_of_prime hp hpL facts_E7 kacCount_E7_four (by decide)
      (by decide)
      (fun y hy => far_d4_E7 y fun z hz => by
        have h := hy z hz
        rwa [KacData.Adj, extRoot_eq_extRootOf] at h)
      ⟨some 0, by decide⟩ (lt_of_eq_of_lt kacCount_far_E7 (by decide)) hT hTp i h4 hc
    obtain ⟨Fr, hFr, hΦ⟩ := S.D.exists_frob_of_untwisted twistTag_tag_ne_E7
    obtain ⟨w, hn⟩ := S.D.n_weyl
    obtain ⟨f, hf, hmodel⟩ := lieModel_rationalComponent_of_d4_triality d4Base_E7
      CFSG.RankThree.PartOne.KD4L.d4TrialityLayer_E7 S hFr hΦ hn
      (fun γ hγ => S.rho_eq_smul_of_frob hFr hΦ hn hγ) i v hv hρ hout h2
    rw [ringChar.eq L 2] at hf hmodel
    exact ⟨f, hf, Or.inr hmodel⟩
  | E8 =>
    obtain ⟨v, hv, hρ⟩ := S.d4_pinnedT_of_prime hp hpL facts_E8 kacCount_E8_four (by decide)
      (by decide)
      (fun y hy => far_d4_E8 y fun z hz => by
        have h := hy z hz
        rwa [KacData.Adj, extRoot_eq_extRootOf] at h)
      ⟨some 0, by decide⟩ (lt_of_eq_of_lt kacCount_far_E8 (by decide)) hT hTp i h4 hc
    obtain ⟨Fr, hFr, hΦ⟩ := S.D.exists_frob_of_untwisted twistTag_tag_ne_E8
    obtain ⟨w, hn⟩ := S.D.n_weyl
    obtain ⟨f, hf, hmodel⟩ := lieModel_rationalComponent_of_d4_triality d4Base_E8
      CFSG.RankThree.PartOne.KD4L.d4TrialityLayer_E8 S hFr hΦ hn
      (fun γ hγ => S.rho_eq_smul_of_frob hFr hΦ hn hγ) i v hv hρ hout h2
    rw [ringChar.eq L 2] at hf hmodel
    exact ⟨f, hf, Or.inr hmodel⟩

private theorem tag_eq_twD_of_markTag {lab : LargeEvenLabel}
    (h : markTag lab = .POmegaMinus) : lab.tag = .twD := by
  obtain ⟨tag, rank, n⟩ := lab
  cases tag <;> simp only [markTag] at h <;>
    first
      | rfl
      | (split_ifs at h <;> simp_all)
      | simp_all

private theorem rank_ne_of_markTag
    {lab : LargeEvenLabel}
    (h : markTag lab = .POmegaMinus) : lab.rank ≠ 2 ∧ lab.rank ≠ 3 := by
  have htag := tag_eq_twD_of_markTag h
  obtain ⟨tag, rank, n⟩ := lab
  subst htag
  simp only [markTag] at h
  have h2 : ¬ rank = 2 := by
    intro hr
    rw [if_pos hr] at h
    exact absurd h (by decide)
  have h3 : ¬ rank = 3 := by
    rw [if_neg h2] at h
    intro hr
    rw [if_pos hr] at h
    exact absurd h (by decide)
  exact ⟨h2, h3⟩

private theorem markRank_eq_self_of_markTag
    {lab : LargeEvenLabel}
    (htag : lab.tag = .twD) (hm : markTag lab = .POmegaMinus) :
    markRank lab = lab.rank := by
  obtain ⟨h2, h3⟩ := rank_ne_of_markTag hm
  obtain ⟨tag, rank, n⟩ := lab
  subst htag
  simp only [markRank]
  rw [if_neg h2, if_neg h3]

private theorem markDeg_eq_n_of_markTag {lab : LargeEvenLabel}
    (htag : lab.tag = .twD) (h2 : lab.rank ≠ 2) : markDeg lab = lab.n := by
  obtain ⟨tag, rank, n⟩ := lab
  subst htag
  simp only [markDeg]
  rw [if_neg h2]

private theorem exists_label_pOmegaMinus
    {G : Type} [Group G] {X : Subgroup G}
    (hq : CFSG.Open.IsQuasisimple ↥X) {m f : ℕ}
    (h : CFSG.Blueprint.LieModel (↥X ⧸ Subgroup.center ↥X) .POmegaMinus m 2 f) :
    ∃ lab : LargeEvenLabel, lab.tag = .twD ∧ lab.rank = m ∧ lab.n = f ∧
      LargeEvenInLambda2 lab ∧ GGHasLabel lab (↥X ⧸ Subgroup.center ↥X) := by
  have hZ := CFSG.HardMathSupport.Timmesfeld.SporadicRank.center_quotient_center_eq_bot hq
  obtain ⟨lab, hlab, htag, hrank, hchar, hdeg, hraw⟩ := exists_label_rawDatum_of_lieModel hZ h
  have htag' : lab.tag = .twD := tag_eq_twD_of_markTag htag
  obtain ⟨h2, -⟩ := rank_ne_of_markTag htag
  have hrank' : lab.rank = m := by
    rw [← markRank_eq_self_of_markTag htag' htag, hrank]
  have hn' : lab.n = f := by
    rw [← markDeg_eq_n_of_markTag htag' h2, hdeg]
  exact ⟨lab, htag', hrank', hn', hlab, hraw⟩

private theorem exists_label_triD4 {G : Type} [Group G] {X : Subgroup G}
    (hq : CFSG.Open.IsQuasisimple ↥X) {f : ℕ}
    (h : CFSG.Blueprint.LieModel (↥X ⧸ Subgroup.center ↥X) .trialityD4 0 2 f) :
    ∃ lab : LargeEvenLabel, lab.tag = .triD4 ∧ lab.n = f ∧
      LargeEvenInLambda2 lab ∧ GGHasLabel lab (↥X ⧸ Subgroup.center ↥X) := by
  have hZ := CFSG.HardMathSupport.Timmesfeld.SporadicRank.center_quotient_center_eq_bot hq
  obtain ⟨lab, hlab, htag, hrank, hchar, hdeg, hraw⟩ := exists_label_rawDatum_of_lieModel hZ h
  have htag' : lab.tag = .triD4 := by
    obtain ⟨tag, rank, n⟩ := lab
    cases tag <;> simp only [markTag] at htag <;>
      first
        | rfl
        | (split_ifs at htag <;> simp_all)
        | simp_all
  have hn' : lab.n = f := by
    rw [← hdeg]
    simp only [markDeg, htag']
  exact ⟨lab, htag', hn', hlab, hraw⟩

private theorem rationalLabel_outerD_aux
    {τ : Tag} {L : Type} [Field L] [IsAlgClosed L] [CharP L 2] {p₀ : ℕ}
    (S : LangSetup τ L p₀) {p : ℕ} (hp : p.Prime) {a : Fin τ.rank → Lˣ}
    (hT : rootDiagUnit τ a ∈ S.D.torus) (hap : ∀ i, a i ^ p = 1) (h1 : rootDiagUnit τ a ≠ 1)
    (i : KernelComponent (rootCharHom a))
    (hshape : 4 ≤ compRank (componentRoots (rootCharHom a) i) ∧
      (componentRoots (rootCharHom a) i).ncard =
        2 * compRank (componentRoots (rootCharHom a) i) * (compRank (componentRoots (rootCharHom a) i) - 1))
    (hout : ¬ twistInner (componentRoots (rootCharHom a) i)
      ((S.ρ : (Fin τ.rank → ℤ) → _)^[componentOrbitLength S.ρ (componentRoots (rootCharHom a) i)]))
    (hQS : CFSG.IsQuasisimple ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i)) :
    ∃ lab : LargeEvenLabel, 2 ^ lab.n = S.D.q ^ componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) ∧
      (twistKind S.ρ (rootCharHom a) i = .twoD → compRank (componentRoots (rootCharHom a) i) ≠ 4 →
        lab.tag = .twD ∧ lab.rank = compRank (componentRoots (rootCharHom a) i)) ∧
      (twistKind S.ρ (rootCharHom a) i = .twoD → compRank (componentRoots (rootCharHom a) i) = 4 →
        (lab.tag = .twD ∧ lab.rank = 4) ∨ lab.tag = .triD4) ∧
      (twistKind S.ρ (rootCharHom a) i = .exc → compRank (componentRoots (rootCharHom a) i) = 4 →
        (lab.tag = .twD ∧ lab.rank = 4) ∨ lab.tag = .triD4) ∧
      RationalLabelIs S i lab := by
  have hpL : ((p : ℕ) : L) ≠ 0 := natCast_ne_zero_of_ringChar_ne hp (ringChar_ne_of_pow_eq_one hp hap h1)
  have hTp : rootDiagUnit τ a ^ p = 1 := rootDiagUnit_pow_eq_one_of_forall hap
  have hQS' : CFSG.Open.IsQuasisimple ↥(rationalComponent S.ρ S.Γ (rootCharHom a) i) :=
    CFSG.HardMathSupport.Solomon.Coordinator.isQuasisimple_open hQS
  by_cases h5 : 5 ≤ compRank (componentRoots (rootCharHom a) i)
  · have hm : componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 1 :=
      S.componentOrbitLength_eq_one_of_five_leT hT i h5
    obtain ⟨e, he, hlie⟩ := lieModel_twoD_highG_compRank_all S hp hT hap h1 i h5 hshape.2 hout
    obtain ⟨lab, htag, hrank, hn, hlab, hraw⟩ := exists_label_pOmegaMinus hQS' hlie
    refine ⟨lab, ?_, ?_, ?_, ?_, ?_⟩
    · rw [hn, hm, pow_one, he]
    · intro _ _; exact ⟨htag, hrank⟩
    · intro _ h4; omega
    · intro _ h4; omega
    · exact ⟨hlab, hraw⟩
  · have h4 : compRank (componentRoots (rootCharHom a) i) = 4 := by omega
    have hc : (componentRoots (rootCharHom a) i).ncard = 24 := by rw [hshape.2, h4]
    have hs : componentOrbitLength S.ρ (componentRoots (rootCharHom a) i) = 1 := by
      have hfin : (componentRoots (rootCharHom a) i).Finite :=
        (finite_setOf_isRoot τ).subset fun γ hγ => hγ.1.1
      cases τ with
      | G2 =>
        have hle := compRank_le_rank (componentRoots (rootCharHom a) i)
        rw [h4] at hle
        exact absurd hle (by decide)
      | F4 =>
        obtain ⟨v, μ, -, hpinned⟩ := S.exists_pinnedT_of_prime hp hpL facts_F4 hTp
        obtain ⟨x, C, -, -, -, hr', hc'⟩ := hpinned i
        exact absurd (hc' ▸ hc) (kacCount_F4_four C (hr' ▸ h4))
      | D4 => exact absurd (rootDiagUnit_eq_one_of_ncard i (by rw [hc]; rfl)) h1
      | E6 =>
        obtain ⟨v, hv, hρ⟩ := S.d4_pinnedT_of_prime hp hpL facts_E6 kacCount_E6_four (by decide)
          (by decide)
          (fun y hy => far_d4_E6 y fun z hz => by
            have h := hy z hz
            rwa [KacData.Adj, extRoot_eq_extRootOf] at h)
          ⟨none, by decide⟩ (lt_of_eq_of_lt kacCount_far_E6 (by decide)) hT hTp i h4 hc
        exact componentOrbitLength_eq_one hfin hρ
      | E7 =>
        obtain ⟨v, hv, hρ⟩ := S.d4_pinnedT_of_prime hp hpL facts_E7 kacCount_E7_four (by decide)
          (by decide)
          (fun y hy => far_d4_E7 y fun z hz => by
            have h := hy z hz
            rwa [KacData.Adj, extRoot_eq_extRootOf] at h)
          ⟨some 0, by decide⟩ (lt_of_eq_of_lt kacCount_far_E7 (by decide)) hT hTp i h4 hc
        exact componentOrbitLength_eq_one hfin hρ
      | E8 =>
        obtain ⟨v, hv, hρ⟩ := S.d4_pinnedT_of_prime hp hpL facts_E8 kacCount_E8_four (by decide)
          (by decide)
          (fun y hy => far_d4_E8 y fun z hz => by
            have h := hy z hz
            rwa [KacData.Adj, extRoot_eq_extRootOf] at h)
          ⟨some 0, by decide⟩ (lt_of_eq_of_lt kacCount_far_E8 (by decide)) hT hTp i h4 hc
        exact componentOrbitLength_eq_one hfin hρ
    by_cases hexc : twistKind S.ρ (rootCharHom a) i = .exc
    · obtain ⟨f, hf, hlie⟩ := lieModel_rank4_exc_all S hp hpL hT hTp h1 i h4 hc hout hexc
      rcases hlie with hlie | hlie
      · obtain ⟨lab, htag, hrank, hn, hlab, hraw⟩ := exists_label_pOmegaMinus hQS' hlie
        refine ⟨lab, ?_, ?_, ?_, ?_, ?_⟩
        · rw [hn, hs, pow_one, hf]
        · intro htwo; exact absurd (htwo.symm.trans hexc) (by decide)
        · intro htwo; exact absurd (htwo.symm.trans hexc) (by decide)
        · intro _ _; exact Or.inl ⟨htag, hrank⟩
        · exact ⟨hlab, hraw⟩
      · obtain ⟨lab, htag, hn, hlab, hraw⟩ := exists_label_triD4 hQS' hlie
        refine ⟨lab, ?_, ?_, ?_, ?_, ?_⟩
        · rw [hn, hs, pow_one, hf]
        · intro htwo; exact absurd (htwo.symm.trans hexc) (by decide)
        · intro _ _; exact Or.inr htag
        · intro _ _; exact Or.inr htag
        · exact ⟨hlab, hraw⟩
    · obtain ⟨f, hf, hM⟩ := l154r4_of_rank_four S hp hpL hT hTp h1 i h4 hc hout
      rw [ringChar.eq L 2] at hf hM
      rcases hM with hlie | hlie
      · obtain ⟨lab, htag, hrank, hn, hlab, hraw⟩ := exists_label_pOmegaMinus hQS' hlie
        refine ⟨lab, ?_, ?_, ?_, ?_, ?_⟩
        · rw [hn, hs, pow_one, hf]
        · intro _ hne; omega
        · intro _ _; exact Or.inl ⟨htag, hrank⟩
        · intro h _; exact absurd h hexc
        · exact ⟨hlab, hraw⟩
      · obtain ⟨lab, htag, hn, hlab, hraw⟩ := exists_label_triD4 hQS' hlie
        refine ⟨lab, ?_, ?_, ?_, ?_, ?_⟩
        · rw [hn, hs, pow_one, hf]
        · intro _ hne; omega
        · intro _ _; exact Or.inr htag
        · intro h _; exact absurd h hexc
        · exact ⟨hlab, hraw⟩

end Tracked

