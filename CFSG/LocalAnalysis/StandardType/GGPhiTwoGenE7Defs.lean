namespace CFSG.StandardType.PhiTwoRootGen

open CFSG.Blueprint.Chevalley CFSG.LieType.Chevalley

@[expose] def e7D6Roots : Set (Fin Tag.E7.rank → ℤ) := {γ | IsRoot .E7 γ ∧ γ 0 = 0}

@[expose] def e7A1D6Roots : Set (Fin Tag.E7.rank → ℤ) := {γ | IsRoot .E7 γ ∧ Even (γ 0)}

@[expose] noncomputable def phiTwoA1D6Subgroup
    (L : Type) [Field L] : Subgroup (ModGL .E7 L) :=
  torusGroup .E7 L ⊔ rootSpan .E7 L e7A1D6Roots

end CFSG.StandardType.PhiTwoRootGen

