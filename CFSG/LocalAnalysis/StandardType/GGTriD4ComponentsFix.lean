@[expose] def GGTriD4FixedShape (n : ℕ) (C : Type) [Group C] : Prop :=
  (∃ (k : Type) (_ : Field k) (_ : Finite k), Nat.card k = 2 ^ n ∧
      Nonempty (C ≃* ↥(adjointGroup Tag.G2 k))) ∨
  (Even n ∧ ∃ (F : Type) (_ : Field F) (_ : Finite F), Nat.card F = 2 ^ n ∧
      Nonempty (C ≃* ↥(projImage (Sec4.glPi true 3 (2 ^ n) F)))) ∨
  (Odd n ∧ ∃ (F : Type) (_ : Field F) (_ : Finite F), Nat.card F = (2 ^ n) ^ 2 ∧
      Nonempty (C ≃* ↥(projImage (Sec4.glPi false 3 (2 ^ n) F))))

theorem GGTriD4FixedShape.of_mulEquiv {n : ℕ} {C C' : Type} [Group C] [Group C'] (e : C ≃* C')
    (h : GGTriD4FixedShape n C') : GGTriD4FixedShape n C := by
  rcases h with ⟨k, i₁, i₂, hk, ⟨E⟩⟩ | ⟨hn, F, i₁, i₂, hF, ⟨E⟩⟩ | ⟨hn, F, i₁, i₂, hF, ⟨E⟩⟩
  · exact Or.inl ⟨k, i₁, i₂, hk, ⟨e.trans E⟩⟩
  · exact Or.inr (Or.inl ⟨hn, F, i₁, i₂, hF, ⟨e.trans E⟩⟩)
  · exact Or.inr (Or.inr ⟨hn, F, i₁, i₂, hF, ⟨e.trans E⟩⟩)

theorem ggTriD4_fixedShape_Y
    {n : ℕ} (hn : 1 ≤ n) {K₃ : Type} [Field K₃] [Finite K₃]
    (hK₃ : Nat.card K₃ = (2 ^ n) ^ 3) (Fr : K₃ ≃+* K₃) (hFr : ∀ c, Fr c = c ^ 2 ^ n)
    (φ : MulAut ↥(graphFixedRootGroup TwistTag.D4 K₃ Fr.toRingHom)) (hφ3 : φ ^ 3 = 1)
    (hφ : φ ∉ (MulAut.conj : ↥(graphFixedRootGroup TwistTag.D4 K₃ Fr.toRingHom) →*
      MulAut ↥(graphFixedRootGroup TwistTag.D4 K₃ Fr.toRingHom)).range) :
    GGTriD4FixedShape n ↥(fixSubgroup φ) := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hcard : Nat.card ↥(fixSubfield Fr) = 2 ^ n :=
    CFSG.RankThree.PartOne.card_fixSubfield_cube_row Nat.prime_two hn hK₃ Fr hFr
  have hG2 : Nonempty (↥(fixSubgroup (fieldActor (t := TwistTag.D4) Fr Fr)) ≃*
      ↥(adjointGroup Tag.G2 ↥(fixSubfield Fr))) :=
    LieComp.nonempty_fixSubgroup_fieldActor_equiv_G2 (ℓ := 2) (f := n) (by norm_num) hn
      (Or.inl rfl) hK₃ Fr hFr
  by_cases hconj : ∃ β : MulAut ↥(graphFixedRootGroup TwistTag.D4 K₃ Fr.toRingHom),
      φ = β * fieldActor (t := TwistTag.D4) Fr Fr * β⁻¹ ∨
        φ = β * (fieldActor (t := TwistTag.D4) Fr Fr)⁻¹ * β⁻¹
  · obtain ⟨β, hβ | hβ⟩ := hconj
    · rw [hβ]
      exact Or.inl ⟨↥(fixSubfield Fr), inferInstance, inferInstance, hcard,
        ⟨(LieComp.fixSubgroupConjEquiv β _).symm.trans hG2.some⟩⟩
    · rw [hβ]
      exact Or.inl ⟨↥(fixSubfield Fr), inferInstance, inferInstance, hcard,
        ⟨((LieComp.fixSubgroupConjEquiv β _).symm.trans
          (MulEquiv.subgroupCongr (LieSemisimple.fixSubgroup_inv_eq _))).trans hG2.some⟩⟩
  · rcases Sec8.Item8KFacts2Proof.isStdGraphFieldConj_or_nonempty_autFix_equiv hn hK₃ hFr hφ3 hφ
      with hstd | he₂
    · exact absurd hstd hconj
    · obtain ⟨e₂⟩ := he₂
      have hfixφ : fixSubgroup φ = Sec4.autFix φ := Subgroup.ext fun _ => Iff.rfl
      let ef : ↥(fixSubgroup φ) ≃* ↥(Sec4.autFix φ) := MulEquiv.subgroupCongr hfixφ
      rcases Nat.even_or_odd n with hfe | hfo
      · obtain ⟨F, hFf, hFi, hF, ⟨e₃⟩⟩ :=
          Sec8.kF82D4SecondCentY0Even_holds n hfe hn K₃ Fr hK₃ hFr
        exact Or.inr (Or.inl ⟨hfe, F, hFf, hFi, hF, ⟨ef.trans (e₂.trans e₃)⟩⟩)
      · obtain ⟨F, hFf, hFi, hF, ⟨e₃⟩⟩ :=
          Sec8.kF82D4SecondCentY0_holds n hfo K₃ Fr hK₃ hFr
        exact Or.inr (Or.inr ⟨hfo, F, hFf, hFi, hF, ⟨ef.trans (e₂.trans e₃)⟩⟩)

theorem ggTriD4_fixedShape
    {n : ℕ} (hn : 1 ≤ n) (K : Type) [Field K] [Finite K]
    (hK : Nat.card K = (2 ^ n) ^ 3) (σ : MulAut (GGTriD4R n K)) (hσ3 : σ ^ 3 = 1)
    (hσ : σ ∉ (MulAut.conj : GGTriD4R n K →* MulAut (GGTriD4R n K)).range) :
    GGTriD4FixedShape n ↥(ggAutFixedSubgroup σ) := by
  haveI : CharP K 2 := charP_two_of_card (m := n * 3) (by rw [hK, pow_mul])
  set σ₀ := iterateFrobeniusEquiv K 2 n with hσdef
  have hσ₀ : ∀ c, σ₀ c = c ^ 2 ^ n := fun c => by
    rw [hσdef, iterateFrobeniusEquiv_apply, iterateFrobenius_def]
  obtain ⟨e⟩ := TableBExcSmallRest.nonempty_triD4_equiv hn K hK σ₀ hσ₀
  have hφ3 : (MulAut.congr e σ) ^ 3 = 1 := by rw [← map_pow, hσ3, map_one]
  have hφin : ¬ KFacts.IsInnerAut (MulAut.congr e σ) :=
    fun h => hσ ((KFacts.isInnerAut_congr e σ).mp h)
  have hfixσ : ggAutFixedSubgroup σ = fixSubgroup σ := Subgroup.ext fun _ => Iff.rfl
  exact GGTriD4FixedShape.of_mulEquiv
    ((MulEquiv.subgroupCongr hfixσ).trans (LieComp.fixSubgroupCongrEquiv e σ))
    (ggTriD4_fixedShape_Y hn hK σ₀ hσ₀ (MulAut.congr e σ) hφ3 hφin)

