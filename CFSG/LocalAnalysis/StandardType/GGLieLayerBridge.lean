theorem ggLayerLieTwo_of_lieCompsExport {p : ℕ} {Y : Type}
    [Group Y] {φ : MulAut Y} (h : LieCompsExport 2 φ) : LayerCycM.GGLayerLieTwo p φ := by
  intro _ _ hcomp
  have hcomp' : IsComponentOf (CFSG.Assembly.LargeEvenLayer (ggFix φ)) (fixSubgroup φ) :=
    CFSG.Assembly.isComponentOf_iff_open.mp hcomp
  obtain ⟨X, _, _, hX, f, hf, hfk⟩ := h.comps _ hcomp'
  obtain ⟨e⟩ := nonempty_centralQuotient_mulEquiv hX.perfect f hf hfk
  exact lieTwoModel_of_isChevSimple_two (isChevSimple_congr e hX.chev)

section ExcThree


theorem lieCompExport_exceptional_three (hres : ExcRationalLieTypes)
    (hout : TrialityOuterExport) {S : Type} [Group S] [Finite S] (hs : IsSimpleGroup S)
    (hna : ∃ a b : S, a * b ≠ b * a) (idx : TauCeti.ValidLieTypeIndex)
    (hF : lieFamily idx.1 = .exceptional) (h3 : lieIndexChar idx.1 ≠ 3)
    (he : Nonempty (S ≃* (TauCeti.CFSGIndex.lie idx).Group)) (β : MulAut S) (hβ : β ^ 3 = 1)
    (hβ1 : β ≠ 1) : LieCompExport (lieIndexChar idx.1) β := by
  classical
  obtain ⟨e⟩ := he
  have hlayer : PerfectInLayer β :=
    lieSemisimpleCentExceptional S hs hna idx hF ⟨e⟩ 3 Nat.prime_three (by norm_num)
      (fun h => h3 (by rw [← characteristic_eq_lieIndexChar]; exact h.symm)) β hβ hβ1
  have hmon : ∀ {τ : Tag}, (τ = .G2 ∨ τ = .F4 ∨ τ = .D4 ∨ τ = .E6 ∨ τ = .E7 ∨ τ = .E8) →
      MonomialToralAt τ 3 := fun hτ =>
    monomialToralAt_exc monomialToralAt_E6_five monomialToralAt_E7_five hτ Nat.prime_three
      (by norm_num)
  obtain ⟨d, hv⟩ := idx
  cases d with
  | E6 q =>
    have hq3 : 3 ≠ q.p := fun h => h3 (by simp [lieIndexChar]; exact h.symm)
    exact lieCompExport_untw hres (τ := .E6) (Or.inr (Or.inr (Or.inl rfl)))
      (c := TauCeti.LieTypeIndex.E6) CFSG.TauCetiBridge.Even.chevalleyBridgesAll.e6
      (fun q => TauCeti.LieTypeIndex.characteristic_E6 q)
      (fun q _ => TauCeti.LieTypeIndex.valid_E6 q) (fun q _ h => absurd h (by decide))
      (fun q hv => isEmpty_cat_alt6 ⟨.E6 q, hv⟩ (Or.inl rfl)) q hv hq3 e β hβ hβ1 hlayer
  | E7 q =>
    have hq3 : 3 ≠ q.p := fun h => h3 (by simp [lieIndexChar]; exact h.symm)
    exact lieCompExport_untw hres (τ := .E7) (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
      (c := TauCeti.LieTypeIndex.E7) CFSG.TauCetiBridge.Even.chevalleyBridgesAll.e7
      (fun q => TauCeti.LieTypeIndex.characteristic_E7 q)
      (fun q _ => by simp) (fun q _ h => absurd h (by decide))
      (fun q hv => isEmpty_cat_alt6 ⟨.E7 q, hv⟩ (Or.inl rfl)) q hv hq3 e β hβ hβ1 hlayer
  | E8 q =>
    have hq3 : 3 ≠ q.p := fun h => h3 (by simp [lieIndexChar]; exact h.symm)
    exact lieCompExport_untw hres (τ := .E8) (Or.inr (Or.inr (Or.inr (Or.inr rfl))))
      (c := TauCeti.LieTypeIndex.E8) CFSG.TauCetiBridge.Even.chevalleyBridgesAll.e8
      (fun q => TauCeti.LieTypeIndex.characteristic_E8 q)
      (fun q _ => by simp) (fun q _ h => absurd h (by decide))
      (fun q hv => isEmpty_cat_alt6 ⟨.E8 q, hv⟩ (Or.inl rfl)) q hv hq3 e β hβ hβ1 hlayer
  | F4 q =>
    have hq3 : 3 ≠ q.p := fun h => h3 (by simp [lieIndexChar]; exact h.symm)
    exact lieCompExport_untw hres (τ := .F4) (Or.inr (Or.inl rfl))
      (c := TauCeti.LieTypeIndex.F4) CFSG.TauCetiBridge.Even.chevalleyBridgesAll.f4
      (fun q => TauCeti.LieTypeIndex.characteristic_F4 q)
      (fun q _ => by simp) (fun q _ h => absurd h (by decide))
      (fun q hv => isEmpty_cat_alt6 ⟨.F4 q, hv⟩ (Or.inl rfl)) q hv hq3 e β hβ hβ1 hlayer
  | G2 q =>
    have hq3 : 3 ≠ q.p := fun h => h3 (by simp [lieIndexChar]; exact h.symm)
    exact lieCompExport_untw hres (τ := .G2) (Or.inl rfl)
      (c := TauCeti.LieTypeIndex.G2) CFSG.TauCetiBridge.Even.chevalleyBridgesAll.g2
      (fun q => TauCeti.LieTypeIndex.characteristic_G2 q)
      (fun q hq => by
        rw [TauCeti.LieTypeIndex.valid_iff, TauCeti.LieTypeIndex.inStandardRange_iff,
          TauCeti.LieTypeIndex.isDuplicateRepresentative_iff]
        exact ⟨hq rfl, by simp⟩)
      (fun q hv _ => (TauCeti.LieTypeIndex.inStandardRange_iff _).mp
        ((TauCeti.LieTypeIndex.valid_iff _).mp hv).1)
      (fun q hv => isEmpty_cat_alt6 ⟨.G2 q, hv⟩ (Or.inl rfl)) q hv hq3 e β hβ hβ1 hlayer
  | twistedE6 q =>
    have hq3 : 3 ≠ q.p := fun h => h3 (by simp [lieIndexChar]; exact h.symm)
    exact lieCompExport_twE6 hres
      (fun q hv => isEmpty_cat_alt6 ⟨.twistedE6 q, hv⟩ (Or.inl rfl))
      (hmon (by simp)) q hv hq3 e β hβ hβ1 hlayer
  | trialityD4 q =>
    have hq3 : 3 ≠ q.p := fun h => h3 (by simp [lieIndexChar]; exact h.symm)
    exact lieCompExport_triD4 hres hout (hmon (by simp)) q hv hq3 e β hβ hβ1 hlayer
  | _ => simp [lieFamily] at hF

end ExcThree

section Catalog


theorem lieCompsExport_two_of_catalog (hres : ExcRationalLieTypes)
    (hout : TrialityOuterExport) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {S : Type} [Group S]
    [Finite S] (hs : IsSimpleGroup S) (hna : ∃ a b : S, a * b ≠ b * a)
    (idx : TauCeti.ValidLieTypeIndex) (hc : lieIndexChar idx.1 = 2)
    (hF : lieFamily idx.1 = .exceptional ∨ ∃ m, idx.1 = .reeF4 m)
    (e : S ≃* (TauCeti.CFSGIndex.lie idx).Group) {β : MulAut S} (hβ : β ^ p = 1)
    (hβ1 : β ≠ 1) : LieCompsExport 2 β := by
  have hp3 : p = 3 ∨ 5 ≤ p := by
    have h4 : p ≠ 4 := by
      rintro rfl
      norm_num at hp
    have := hp.two_le
    omega
  rcases hp3 with rfl | hp5
  · rcases hF with hF | ⟨m, hm⟩
    · have h := lieCompExport_exceptional_three hres hout hs hna idx hF (by rw [hc]; norm_num)
        ⟨e⟩ β hβ hβ1
      rw [hc] at h
      exact h.toComps
    · obtain ⟨d, hv⟩ := idx
      change d = _ at hm
      subst hm
      exact (srtOut_reeF4_three m hv ⟨e⟩ hβ hβ1).comps
  · have h := CFSG.LocalAnalysis.GLTheoremA.lieCompsOn_holds hp hp5 (lieFamily idx.1) S hs hna
      idx rfl ⟨e⟩ β hβ hβ1 (Or.inl (by rw [hc]; omega))
    rwa [hc] at h

theorem ggLayerLieTwo_of_catEquiv (hres : ExcRationalLieTypes) (hout : TrialityOuterExport)
    {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {R : Type} [Group R]
    (idx : TauCeti.ValidLieTypeIndex) (hc : lieIndexChar idx.1 = 2)
    (hF : lieFamily idx.1 = .exceptional ∨ ∃ m, idx.1 = .reeF4 m)
    (e : R ≃* (TauCeti.CFSGIndex.lie idx).Group) (φ : MulAut R) :
    LayerCycM.GGLayerLieTwo p φ := by
  obtain ⟨hfin, hsimp⟩ := CFSG.Assembly.lie_finite_simple idx
  haveI : Finite (TauCeti.CFSGIndex.lie idx).Group := hfin
  haveI : IsSimpleGroup (TauCeti.CFSGIndex.lie idx).Group := hsimp
  haveI : Finite R := Finite.of_equiv _ e.symm.toEquiv
  haveI : IsSimpleGroup R := e.isSimpleGroup
  intro hφ1 hφp hcomp
  by_cases hna : ∃ a b : R, a * b ≠ b * a
  · exact ggLayerLieTwo_of_lieCompsExport
      (lieCompsExport_two_of_catalog hres hout hp hp2 inferInstance hna idx hc hF e hφp hφ1)
      hφ1 hφp hcomp
  · exfalso
    have hcomm : ∀ a b : R, a * b = b * a := fun a b =>
      Classical.byContradiction fun hne => hna ⟨a, b, hne⟩
    haveI : Group.IsSolvable ↥(ggFix φ) :=
      Group.isSolvable_of_comm fun a b => Subtype.ext (hcomm a b)
    exact not_isComponentOf_of_isSolvable (C := fixSubgroup φ) this
      (CFSG.Assembly.isComponentOf_iff_open.mp hcomp)

end Catalog

