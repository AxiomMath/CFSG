theorem jcoreOm_dichotomy {n p : ℕ} {F : Type} [Field F] [Finite F] [CharP F 2] (hn : 4 ≤ n)
    (hp : p.Prime) (hp2 : p ≠ 2) {u : ↥(spinGroup (quadPlus n F))} (hup : u ^ p = 1)
    {J : Subgroup ↥(spinGroup (quadPlus n F))}
    (hJ : IsComponentOf J (Subgroup.centralizer ({u} : Set ↥(spinGroup (quadPlus n F))))) :
    ∃ T : Subgroup ((Fin n ⊕ Fin n → F) ≃ₗ[F] (Fin n ⊕ Fin n → F)),
      (∀ z, z ∈ J ↔ spinAction (quadPlus n F) z ∈ T) ∧
      ((∃ h ∈ primaryFactors (spinAction (quadPlus n F) u).toLinearMap, h ≠ X - 1 ∧
          CFSG.IsQuasisimple ↥(specialBlock (quadPlus n F) (spinAction (quadPlus n F) u) h) ∧
          T = specialBlock (quadPlus n F) (spinAction (quadPlus n F) u) h) ∨
        (FixedLayerListed (quadPlus n F) (spinAction (quadPlus n F) u) ∧ CFSG.IsQuasisimple ↥T ∧
          T ≤ supportedFixedDerived (quadPlus n F) (spinAction (quadPlus n F) u) ∧
          (T.subgroupOf
            (supportedFixedDerived (quadPlus n F) (spinAction (quadPlus n F) u))).Normal)) := by
  classical
  have hQ : (QuadraticMap.polarBilin (quadPlus n F)).Nondegenerate :=
    nondegenerate_polarBilin_quadPlus n F
  have hpℓ : p ≠ ringChar F := by rw [ringChar.eq F 2]; exact hp2
  have hdim : Module.finrank F (Fin n ⊕ Fin n → F) = 2 * n := by
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_sum, Fintype.card_fin]
    ring
  have hT := LocalAnalysis.GLTheoremA.T173S.exists_finrank_three_singular hQ hdim hn
  haveI : Nonempty (Fin n) := ⟨⟨0, by omega⟩⟩
  have hrange : (spinAction (quadPlus n F)).range = orthDerived (quadPlus n F) :=
    range_spinAction_quadPlus_eq_commutator (by omega)
  let σ' : ↥(spinGroup (quadPlus n F)) →* ↥(orthDerived (quadPlus n F)) :=
    (spinAction (quadPlus n F)).codRestrict _ (fun z => hrange ▸ ⟨z, rfl⟩)
  have hσinj : Function.Injective σ' := fun a b hab =>
    RootCentOmega.spinAction_quadPlus_injective (congrArg Subtype.val hab)
  have hσsurj : Function.Surjective σ' := by
    rintro ⟨g, hg⟩
    obtain ⟨z, rfl⟩ := (hrange ▸ hg : g ∈ (spinAction (quadPlus n F)).range)
    exact ⟨z, rfl⟩
  let ρ : ↥(orthDerived (quadPlus n F)) →* ProjOrthDerived (quadPlus n F) :=
    QuotientGroup.mk' ((scalars F _).subgroupOf (orthDerived (quadPlus n F)))
  have hρinj : Function.Injective ρ := by
    rw [injective_iff_map_eq_one]
    intro g hg
    exact Subtype.ext (CFSG.RankThree.PartOne.eq_one_of_mem_scalars_of_mem_orthDerived hQ g.2
      (Subgroup.mem_subgroupOf.mp ((QuotientGroup.eq_one_iff g).mp hg)))
  have hθinj : Function.Injective (ρ.comp σ') := hρinj.comp hσinj
  have hxp : σ' u ^ p = 1 := by rw [← map_pow, hup, map_one]
  have hx := LocalAnalysis.GLTheoremA.CanonU3.OrthMinus.oddOrderIsometry_of_pow_eq_one hp hpℓ hQ
    (σ' u) hxp
  have hcent : (Subgroup.centralizer ({u} : Set ↥(spinGroup (quadPlus n F)))).map σ' =
      Subgroup.centralizer ({σ' u} : Set ↥(orthDerived (quadPlus n F))) := by
    ext y
    obtain ⟨z, rfl⟩ := hσsurj y
    rw [Subgroup.mem_map_iff_mem hσinj, Subgroup.mem_centralizer_singleton_iff,
      Subgroup.mem_centralizer_singleton_iff, ← map_mul, ← map_mul, hσinj.eq_iff]
  have hJ' : CFSG.Open.IsComponentOf (J.map (ρ.comp σ'))
      (centralizerImage (quadPlus n F) (σ' u).1) := by
    have h := CFSG.CGT.Foote82.isComponentOf_map_of_injective (ρ.comp σ') hθinj
      (isComponentOf_iff_open.mp hJ)
    rwa [← Subgroup.map_map (Subgroup.centralizer ({u} : Set _)) ρ σ', hcent,
      CFSG.RankThree.PartOne.map_centralizer_eq_centralizerImage] at h
  have hpull : ∀ S : Subgroup ((Fin n ⊕ Fin n → F) ≃ₗ[F] (Fin n ⊕ Fin n → F)),
      J.map (ρ.comp σ') = (S.subgroupOf (orthDerived (quadPlus n F))).map ρ →
        ∀ z, z ∈ J ↔ spinAction (quadPlus n F) z ∈ S := by
    intro S hS z
    rw [← Subgroup.mem_map_iff_mem hθinj, hS, MonoidHom.comp_apply,
      Subgroup.mem_map_iff_mem hρinj, Subgroup.mem_subgroupOf]
    rfl
  obtain ⟨h, hh, hne1, hq, hJeq⟩ | ⟨hL, S, hSq, hSle, hSn, hJeq⟩ :=
    LocalAnalysis.GLTheoremA.KD264Lie.exists_component_dichotomy hp hp2 hQ hT hpℓ hx _ hJ'
  · exact ⟨_, hpull _ hJeq, Or.inl ⟨h, hh, hne1, hq, rfl⟩⟩
  · exact ⟨S, hpull S hJeq, Or.inr ⟨hL, hSq, hSle, hSn⟩⟩

