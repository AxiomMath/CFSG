theorem bL_rootA :
    TriBridge.bL rootA = Pi.single (⟨0, by decide⟩ : Fin TwistTag.D4.tag.rank) 1 := by
  show TriBridge.bL0 rootA = Pi.single (0 : Fin 4) 1
  decide

theorem bL_rootC :
    TriBridge.bL rootC = Pi.single (⟨1, by decide⟩ : Fin TwistTag.D4.tag.rank) 1 := by
  show TriBridge.bL0 rootC = Pi.single (1 : Fin 4) 1
  decide

theorem bL_rootD :
    TriBridge.bL rootD = Pi.single (⟨3, by decide⟩ : Fin TwistTag.D4.tag.rank) 1 := by
  show TriBridge.bL0 rootD = Pi.single (3 : Fin 4) 1
  decide

variable [Finite K] [CharP K 2]

theorem coe_bridge_sUp
    : (TriBridge.bridge (sUp (K := K)) : ModGL TwistTag.D4.tag K) =
    xUnit Tag.D4 K ⟨0, by decide⟩ 1 * xUnit Tag.D4 K ⟨1, by decide⟩ 1 *
      xUnit Tag.D4 K ⟨3, by decide⟩ 1 := by
  rw [sUp, map_mul, map_mul, Subgroup.coe_mul, Subgroup.coe_mul, TriBridge.coe_bridge_X8 rootA_mem,
    TriBridge.coe_bridge_X8 rootC_mem, TriBridge.coe_bridge_X8 rootD_mem, bL_rootA, bL_rootC,
    bL_rootD, pinnedX_single, pinnedX_single, pinnedX_single]
  rfl

theorem coe_bridge_sLow
    : (TriBridge.bridge (sLow (K := K)) : ModGL TwistTag.D4.tag K) =
    yUnit Tag.D4 K ⟨0, by decide⟩ 1 * yUnit Tag.D4 K ⟨1, by decide⟩ 1 *
      yUnit Tag.D4 K ⟨3, by decide⟩ 1 := by
  rw [sLow, map_mul, map_mul, Subgroup.coe_mul, Subgroup.coe_mul,
    TriBridge.coe_bridge_X8 neg_rootA_mem, TriBridge.coe_bridge_X8 neg_rootC_mem,
    TriBridge.coe_bridge_X8 neg_rootD_mem, map_neg, map_neg, map_neg, bL_rootA, bL_rootC,
    bL_rootD, pinnedX_neg_single, pinnedX_neg_single, pinnedX_neg_single]
  rfl

theorem bridge_sZero
    : TriBridge.bridge (sZero (K := K)) = sl2Short K tThree := by
  apply Subtype.ext
  rw [tThree_eq, map_mul, sl2Short_apply, sl2Short_apply, sZero, map_mul, Subgroup.coe_mul,
    coe_bridge_sUp, coe_bridge_sLow]
  simp only [Subgroup.coe_mul, sl2At_uSL, sl2At_vSL]
  rfl

theorem sZero_eq_bridge_symm
    : sZero = TriBridge.bridge.symm (sl2Short K tThree) := by
  rw [← bridge_sZero, MulEquiv.symm_apply_apply]

