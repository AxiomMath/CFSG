omit [CharP K 2] in
private theorem fin_four_cases (l : Fin 4) : l = 0 ∨ l = 1 ∨ l = 2 ∨ l = 3 := by
  revert l
  decide

theorem sZero_pow_three : (sZero (K := K)) ^ 3 = 1 := by
  refine eq_one_of_act fun y => eq_of_polar_pvec fun l u => ?_
  rw [pow_succ, pow_succ, pow_one, act_mul, act_mul]
  change cd _ l u = cd y l u
  obtain rfl | rfl | rfl | rfl := fin_four_cases l <;> cases u <;>
    simp only [sZero_cd0t, sZero_cd0f, sZero_cd1t, sZero_cd1f, sZero_cd2t, sZero_cd2f, sZero_cd3t,
      sZero_cd3f] <;> grind

theorem sZero_ne_one : (sZero (K := K)) ≠ 1 := by
  intro h
  have e := sZero_cd3f (K := K) (AutOm.pvec 3 false)
  rw [h, act_one, cd_pvec, cd_pvec] at e
  simp at e

noncomputable abbrev sZeroFixOne : Fin (2 * 4) → K := AutOm.pvec 0 true + AutOm.pvec 0 false

noncomputable abbrev sZeroFixTwo : Fin (2 * 4) → K :=
  AutOm.pvec 0 false + AutOm.pvec 3 true + AutOm.pvec 3 false

theorem act_sZero_fixOne : act (sZero (K := K)) sZeroFixOne = sZeroFixOne := by
  refine eq_of_polar_pvec fun l u => ?_
  change cd _ l u = cd _ l u
  obtain rfl | rfl | rfl | rfl := fin_four_cases l <;> cases u <;>
    simp only [sZero_cd0t, sZero_cd0f, sZero_cd1t, sZero_cd1f, sZero_cd2t, sZero_cd2f, sZero_cd3t,
      sZero_cd3f] <;>
    simp only [cd, sZeroFixOne, polar_add_left, AutOm.polar_pvec] <;>
    simp [CharTwo.add_self_eq_zero]

theorem act_sZero_fixTwo : act (sZero (K := K)) sZeroFixTwo = sZeroFixTwo := by
  refine eq_of_polar_pvec fun l u => ?_
  change cd _ l u = cd _ l u
  obtain rfl | rfl | rfl | rfl := fin_four_cases l <;> cases u <;>
    simp only [sZero_cd0t, sZero_cd0f, sZero_cd1t, sZero_cd1f, sZero_cd2t, sZero_cd2f, sZero_cd3t,
      sZero_cd3f] <;>
    simp only [cd, sZeroFixTwo, polar_add_left, AutOm.polar_pvec] <;>
    simp [CharTwo.add_self_eq_zero]

theorem eq_of_act_sZero {y : Fin (2 * 4) → K} (hy : act (sZero (K := K)) y = y) :
    y = cd y 0 false • sZeroFixOne + cd y 3 true • sZeroFixTwo := by
  have e : ∀ l u, cd (act (sZero (K := K)) y) l u = cd y l u := fun l u => by rw [hy]
  have e0t := e 0 true
  have e0f := e 0 false
  have e1t := e 1 true
  have e1f := e 1 false
  have e2t := e 2 true
  have e2f := e 2 false
  have e3t := e 3 true
  have e3f := e 3 false
  rw [sZero_cd0t] at e0t
  rw [sZero_cd0f] at e0f
  rw [sZero_cd1t] at e1t
  rw [sZero_cd1f] at e1f
  rw [sZero_cd2t] at e2t
  rw [sZero_cd2f] at e2f
  rw [sZero_cd3t] at e3t
  rw [sZero_cd3f] at e3f
  refine eq_of_polar_pvec fun l u => ?_
  simp only [cd] at e0t e0f e1t e1f e2t e2f e3t e3f
  obtain rfl | rfl | rfl | rfl := fin_four_cases l <;> cases u <;>
    simp only [cd, sZeroFixOne, sZeroFixTwo, polar_add_left, polar_smul_left, AutOm.polar_pvec] <;>
    simp <;> grind

omit [CharP K 2] in
theorem linIndep_fix : LinearIndependent K ![(sZeroFixOne : Fin (2 * 4) → K), sZeroFixTwo] := by
  refine linIndep_of_dual (w := ![AutOm.pvec 0 false, AutOm.pvec 3 true]) ?_
  simp only [Fin.forall_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one, sZeroFixOne,
    sZeroFixTwo, polar_add_left, AutOm.polar_pvec]
  simp

theorem ker_sZero : LinearMap.ker (omRep (sZero (K := K)) - 1) =
    Submodule.span K (Set.range ![(sZeroFixOne : Fin (2 * 4) → K), sZeroFixTwo]) := by
  apply le_antisymm
  · intro y hy
    rw [mem_ker_iff_act] at hy
    rw [Submodule.mem_span_range_iff_exists_fun]
    refine ⟨![cd y 0 false, cd y 3 true], ?_⟩
    rw [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_zero,
      Matrix.cons_val_one]
    exact (eq_of_act_sZero hy).symm
  · rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    fin_cases i
    · exact mem_ker_iff_act.2 act_sZero_fixOne
    · exact mem_ker_iff_act.2 act_sZero_fixTwo

theorem omFixDim_sZero : omFixDim (sZero (K := K)) = 2 := by
  rw [omFixDim, fixDim, ker_sZero, finrank_span_eq_card linIndep_fix, Fintype.card_fin]

variable [Finite K]

