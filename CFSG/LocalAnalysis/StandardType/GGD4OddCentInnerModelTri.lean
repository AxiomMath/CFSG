@[expose] def tThree : Matrix.SpecialLinearGroup (Fin 2) K :=
  ⟨!![0, 1; 1, 1], by rw [Matrix.det_fin_two_of]; simp [CharTwo.neg_eq]⟩

theorem coe_tThree : ((tThree : Matrix.SpecialLinearGroup (Fin 2) K) :
    Matrix (Fin 2) (Fin 2) K) = !![0, 1; 1, 1] := rfl

theorem tThree_eq : (tThree : Matrix.SpecialLinearGroup (Fin 2) K) = uSL 1 * vSL 1 := by
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_mul, coe_tThree, coe_uSL, coe_vSL, Matrix.mul_fin_two]
  simp [CharTwo.add_self_eq_zero]

theorem tThree_pow_three : (tThree : Matrix.SpecialLinearGroup (Fin 2) K) ^ 3 = 1 := by
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_pow, Matrix.SpecialLinearGroup.coe_one, coe_tThree,
    pow_succ, pow_succ, pow_one, Matrix.mul_fin_two, Matrix.mul_fin_two, Matrix.one_fin_two]
  simp [CharTwo.add_self_eq_zero]

end SL2

theorem toStdD_neg_rootA : toStdD 4 (-rootA) = lv 1 2 false true := by decide

theorem toStdD_neg_rootC : toStdD 4 (-rootC) = lv 0 3 true false := by decide

theorem toStdD_neg_rootD : toStdD 4 (-rootD) = lv 0 3 false false := by decide

theorem neg_rootA_mem : -rootA ∈ rootsD4 :=
  mem_rootsD4_iff.2 ⟨1, 2, by decide, false, true, toStdD_neg_rootA⟩

theorem neg_rootC_mem : -rootC ∈ rootsD4 :=
  mem_rootsD4_iff.2 ⟨0, 3, by decide, true, false, toStdD_neg_rootC⟩

theorem neg_rootD_mem : -rootD ∈ rootsD4 :=
  mem_rootsD4_iff.2 ⟨0, 3, by decide, false, false, toStdD_neg_rootD⟩

theorem tri_neg_rootC : tri (-rootC) = -rootD := by rw [map_neg, tri_rootC]

theorem tri_neg_rootD : tri (-rootD) = -rootA := by rw [map_neg, tri_rootD]

@[expose] noncomputable def sUp : Om8 K := X8 rootA 1 * X8 rootC 1 * X8 rootD 1

@[expose] noncomputable def sLow : Om8 K := X8 (-rootA) 1 * X8 (-rootC) 1 * X8 (-rootD) 1

@[expose] noncomputable def sZero : Om8 K := sUp * sLow

