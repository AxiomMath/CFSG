section Generic

variable {τ : Tag} {K : Type} [Field K] [CharP K 2]

theorem pinnedX_one_mul_self (α : Fin τ.rank → ℤ) :
    pinnedX τ K α 1 * pinnedX τ K α 1 = 1 := by
  rw [← pinnedX_add, CharTwo.add_self_eq_zero, pinnedX_zero]

private theorem xUnit_yUnit_braid (i : Fin τ.rank) :
    xUnit τ K i 1 * yUnit τ K i 1 * xUnit τ K i 1 =
      yUnit τ K i 1 * xUnit τ K i 1 * yUnit τ K i 1 := by
  have h1 := weylElt_eq_xUnit_mul (τ := τ) (R := K) i 1
  have h2 := weylElt_eq_yUnit_mul (τ := τ) (K := K) i
  simp only [inv_one, Units.val_one, CharTwo.neg_eq] at h1 h2
  rw [← h1, h2]

private theorem pinnedX_braid {α : Fin τ.rank → ℤ} (hα : IsRoot τ α) :
    pinnedX τ K α 1 * pinnedX τ K (-α) 1 * pinnedX τ K α 1 =
      pinnedX τ K (-α) 1 * pinnedX τ K α 1 * pinnedX τ K (-α) 1 := by
  obtain ⟨w, j, rfl⟩ := isRoot_iff_exists_smul_single.1 hα
  set n := canonicalRep (coxeterSystem τ) K w
  have hx : pinnedX τ K (w • (Pi.single j 1 : Fin τ.rank → ℤ)) 1 = n * xUnit τ K j 1 * n⁻¹ := by
    rw [← CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.Star2313InAux.canonicalRep_conj_pinnedX_two
      w (IsRoot.basis j) 1, pinnedX_single]
  have hy : pinnedX τ K (-(w • (Pi.single j 1 : Fin τ.rank → ℤ))) 1 = n * yUnit τ K j 1 * n⁻¹ := by
    rw [← smul_neg,
      ← CFSG.HardMathSupport.Solomon.Coordinator.ChevQ.Star2313InAux.canonicalRep_conj_pinnedX_two
        w (IsRoot.neg (IsRoot.basis j)) (1 : K), pinnedX_neg_single]
  rw [hx, hy]
  have := xUnit_yUnit_braid (τ := τ) (K := K) j
  calc n * xUnit τ K j 1 * n⁻¹ * (n * yUnit τ K j 1 * n⁻¹) * (n * xUnit τ K j 1 * n⁻¹) =
        n * (xUnit τ K j 1 * yUnit τ K j 1 * xUnit τ K j 1) * n⁻¹ := by group
    _ = n * (yUnit τ K j 1 * xUnit τ K j 1 * yUnit τ K j 1) * n⁻¹ := by rw [this]
    _ = _ := by group

end Generic

section E6

variable {L : Type} [Field L] [CharP L 2]

omit [CharP L 2] in
theorem commute_pinnedX {α β : Fin TwistTag.E6.tag.rank → ℤ}
    (hα : IsRoot TwistTag.E6.tag α) (hβ : IsRoot TwistTag.E6.tag β)
    (hne : α ≠ β) (hne' : α ≠ -β) (hnr : ¬ IsRoot TwistTag.E6.tag (α + β)) (c d : L) :
    Commute (pinnedX TwistTag.E6.tag L α c) (pinnedX TwistTag.E6.tag L β d) :=
  CFSG.RankThree.PartOne.commute_pinnedX_of_not_isRoot (Or.inr (Or.inl rfl)) hα hβ hne hne' hnr c d

omit
  [CharP L 2]
  in
theorem pinnedX_mul_ne {α β : Fin TwistTag.E6.tag.rank → ℤ}
    (hα : IsRoot TwistTag.E6.tag α ∧ 0 < height α)
    (hβ : IsRoot TwistTag.E6.tag β ∧ 0 < height β) (hne : α ≠ β) :
    pinnedX TwistTag.E6.tag L α 1 * pinnedX TwistTag.E6.tag L (-β) 1 ≠
      pinnedX TwistTag.E6.tag L β 1 * pinnedX TwistTag.E6.tag L (-α) 1 := by
  intro h
  have e : (pinnedX TwistTag.E6.tag L β 1)⁻¹ * pinnedX TwistTag.E6.tag L α 1 =
      pinnedX TwistTag.E6.tag L (-α) 1 * (pinnedX TwistTag.E6.tag L (-β) 1)⁻¹ := by
    rw [inv_mul_eq_iff_eq_mul, ← mul_assoc, ← h, mul_inv_cancel_right]
  have hB : (pinnedX TwistTag.E6.tag L β 1)⁻¹ * pinnedX TwistTag.E6.tag L α 1 ∈
      borelGroup TwistTag.E6.tag L :=
    mul_mem (inv_mem (Subgroup.mem_sup_right (pinnedX_mem_rootSpan
      (S := {γ | IsRoot TwistTag.E6.tag γ ∧ 0 < height γ}) hβ 1)))
      (Subgroup.mem_sup_right (pinnedX_mem_rootSpan
      (S := {γ | IsRoot TwistTag.E6.tag γ ∧ 0 < height γ}) hα 1))
  have hU : pinnedX TwistTag.E6.tag L (-α) 1 *
      (pinnedX TwistTag.E6.tag L (-β) 1)⁻¹ ∈ negUnipotent TwistTag.E6.tag L :=
    mul_mem (pinnedX_mem_rootSpan (S := {γ | IsRoot TwistTag.E6.tag γ ∧ height γ < 0})
      ⟨IsRoot.neg hα.1, by rw [height_neg]; linarith [hα.2]⟩ 1)
      (inv_mem (pinnedX_mem_rootSpan (S := {γ | IsRoot TwistTag.E6.tag γ ∧ height γ < 0})
      ⟨IsRoot.neg hβ.1, by rw [height_neg]; linarith [hβ.2]⟩ 1))
  rw [← e] at hU
  have h1 : (pinnedX TwistTag.E6.tag L β 1)⁻¹ * pinnedX TwistTag.E6.tag L α 1 = 1 := by
    have := Subgroup.mem_inf.2 ⟨hB, hU⟩
    rwa [borelGroup_inf_negUnipotent, Subgroup.mem_bot] at this
  exact hne (CFSG.SeitzReduction.F4Pilot.eq_of_pinnedX_eq_pinnedX hα.1 hβ one_ne_zero
    (inv_mul_eq_one.1 h1).symm)

@[expose] noncomputable def nRoot (α : Fin TwistTag.E6.tag.rank → ℤ) : ModGL TwistTag.E6.tag L :=
  pinnedX TwistTag.E6.tag L α 1 * pinnedX TwistTag.E6.tag L (-α) 1 * pinnedX TwistTag.E6.tag L α 1

theorem nRoot_eq' {α : Fin TwistTag.E6.tag.rank → ℤ} (hα : IsRoot TwistTag.E6.tag α) :
    nRoot (L := L) α = pinnedX TwistTag.E6.tag L (-α) 1 * pinnedX TwistTag.E6.tag L α 1 *
      pinnedX TwistTag.E6.tag L (-α) 1 :=
  pinnedX_braid hα

theorem nRoot_mul_self {α : Fin TwistTag.E6.tag.rank → ℤ} (hα : IsRoot TwistTag.E6.tag α) :
    nRoot (L := L) α * nRoot α = 1 := by
  rw [nRoot_eq' hα]
  set x := pinnedX TwistTag.E6.tag L α 1
  set y := pinnedX TwistTag.E6.tag L (-α) 1
  have hx : x * x = 1 := pinnedX_one_mul_self _
  have hy : y * y = 1 := pinnedX_one_mul_self _
  calc (y * x * y) * (y * x * y) = y * x * (y * y) * x * y := by group
    _ = y * (x * x) * y := by rw [hy, mul_one]; group
    _ = 1 := by rw [hx, mul_one, hy]

private theorem nRoot_conj {α : Fin TwistTag.E6.tag.rank → ℤ} (hα : IsRoot TwistTag.E6.tag α) :
    nRoot (L := L) α * pinnedX TwistTag.E6.tag L α 1 * (nRoot α)⁻¹ =
      pinnedX TwistTag.E6.tag L (-α) 1 := by
  set x := pinnedX TwistTag.E6.tag L α 1
  set y := pinnedX TwistTag.E6.tag L (-α) 1
  have hx : x * x = 1 := pinnedX_one_mul_self _
  have hy : y * y = 1 := pinnedX_one_mul_self _
  have hb : x * y * x = y * x * y := pinnedX_braid hα
  have hx' : x⁻¹ = x := inv_eq_of_mul_eq_one_right hx
  have hy' : y⁻¹ = y := inv_eq_of_mul_eq_one_right hy
  have hn : nRoot (L := L) α = x * y * x := rfl
  rw [hn]
  calc (x * y * x) * x * (x * y * x)⁻¹ = x * y * (x * x) * (x⁻¹ * y⁻¹ * x⁻¹) := by group
    _ = (x * y * x) * (y * x) := by rw [hx, hx', hy']; group
    _ = (y * x * y) * (y * x) := by rw [hb]
    _ = y * x * (y * y) * x := by group
    _ = y := by rw [hy, mul_one, mul_assoc, hx, mul_one]

theorem nRoot_ne {α β : Fin TwistTag.E6.tag.rank → ℤ}
    (hα : IsRoot TwistTag.E6.tag α ∧ 0 < height α) (hβ : IsRoot TwistTag.E6.tag β)
    (hne : α ≠ β) (hne' : α ≠ -β) (hp : ¬ IsRoot TwistTag.E6.tag (α + β))
    (hm : ¬ IsRoot TwistTag.E6.tag (α + -β)) : nRoot (L := L) α ≠ nRoot β := by
  intro h
  have c1 := commute_pinnedX (L := L) hα.1 hβ hne hne' hp 1 1
  have c2 := commute_pinnedX (L := L) hα.1 (IsRoot.neg hβ) hne' (by rw [neg_neg]; exact hne) hm 1 1
  have hc : Commute (nRoot (L := L) β) (pinnedX TwistTag.E6.tag L α 1) :=
    ((c1.symm.mul_left c2.symm).mul_left c1.symm)
  have h1 := nRoot_conj (L := L) hα.1
  rw [h, hc.eq, mul_inv_cancel_right] at h1
  have h2 := CFSG.SeitzReduction.F4Pilot.eq_of_pinnedX_eq_pinnedX (IsRoot.neg hα.1) hα
    (one_ne_zero (α := L)) h1.symm
  have : height α = 0 := by
    have := congrArg height h2
    rw [height_neg] at this
    linarith
  exact absurd hα.2 (by rw [this]; exact lt_irrefl 0)

theorem diagram_conj_pinnedX {δ : Fin TwistTag.E6.tag.rank → ℤ} (hδ : IsRoot TwistTag.E6.tag δ)
    (c : L) :
    diagramMap TwistTag.E6 L * pinnedX TwistTag.E6.tag L δ c * (diagramMap TwistTag.E6 L)⁻¹ =
      pinnedX TwistTag.E6.tag L (permLattice TwistTag.E6.perm δ) c :=
  CFSG.LieType.Chevalley.E6GraphRadical.diagramMap_conj_pinnedX_of_two CharTwo.two_eq_zero hδ c

end E6

