variable {ι : Type} [Fintype ι] [DecidableEq ι] {Q : (ι → ZMod 2) → ZMod 2}

private noncomputable def orthLinHom (Q : (ι → ZMod 2) → ZMod 2) :
    ↥(isoGrp Q) →* Module.End (ZMod 2) (ι → ZMod 2) :=
  (Matrix.toLinAlgEquiv' : Matrix ι ι (ZMod 2) ≃ₐ[ZMod 2]
      Module.End (ZMod 2) (ι → ZMod 2)).toRingEquiv.toMonoidHom.comp
    ((Units.coeHom (Matrix ι ι (ZMod 2))).comp (isoGrp Q).subtype)

private theorem orthLinHom_apply (Q : (ι → ZMod 2) → ZMod 2) (g : ↥(isoGrp Q))
    (v : ι → ZMod 2) :
    orthLinHom Q g v = ((g : GL ι (ZMod 2)) : Matrix ι ι (ZMod 2)).mulVec v := by
  simp [orthLinHom, Matrix.toLinAlgEquiv'_apply]

private noncomputable def orthPolarBilin (q : QuadraticForm (ZMod 2) (ι → ZMod 2)) :
    LinearMap.BilinForm (ZMod 2) (ι → ZMod 2) :=
  @QuadraticMap.polarBilin (ZMod 2) (ι → ZMod 2) (ZMod 2)
    (inferInstance : CommRing (ZMod 2)) (inferInstance : AddCommGroup (ι → ZMod 2))
    (inferInstance : AddCommGroup (ZMod 2)) (inferInstance : Module (ZMod 2) (ι → ZMod 2))
    (inferInstance : Module (ZMod 2) (ZMod 2)) q

omit [Fintype ι] [DecidableEq ι] in
private theorem orthPolarBilin_apply (q : QuadraticForm (ZMod 2) (ι → ZMod 2))
    (x y : ι → ZMod 2) : orthPolarBilin q x y = QuadraticMap.polar q x y := rfl

private theorem orthLinHom_injective (Q : (ι → ZMod 2) → ZMod 2) :
    Function.Injective (orthLinHom Q) := by
  intro x y h
  apply Subtype.ext
  apply Units.ext
  exact (Matrix.toLinAlgEquiv' : Matrix ι ι (ZMod 2) ≃ₐ[ZMod 2]
    Module.End (ZMod 2) (ι → ZMod 2)).injective h

theorem autThreePowInner_of_goodQ (hQ : GoodQ Q) (hind : OmegaTwoAutInduced Q)
    {X : Type} [Group X] (e : X ≃* ↥(StatedOmega Q)) : AutThreePowInner X := by
  refine autThreePowInner_of_mulEquiv e fun ψ k hψ => ?_
  have hrange : ψ ∈ (kappa Q).range := (inducedByIso_iff_mem_range Q ψ).mp (hind ψ)
  obtain ⟨g, hg⟩ := MonoidHom.mem_range.mp hrange
  have hpow : ψ ^ (3 ^ k) = 1 := by
    ext x
    rw [mulAut_pow_apply_iterate, hψ, MulAut.one_apply]
  have hgpow : g ^ (3 ^ k) = 1 := by
    apply hQ.kappa_injective
    rw [map_pow, hg, hpow, map_one]
  have hidx : ((StatedOmega Q).subgroupOf (isoGrp Q)).index = 2 := hQ.relIndex_eq
  have hsq : g ^ 2 ∈ (StatedOmega Q).subgroupOf (isoGrp Q) :=
    Subgroup.sq_mem_of_index_two hidx g
  have hodd : Odd (3 ^ k) := Odd.pow (n := k) (show Odd 3 by decide)
  obtain ⟨r, hr⟩ := hodd
  have hm : 2 * ((3 ^ k + 1) / 2) = 3 ^ k + 1 := by omega
  have hgm : g = (g ^ 2) ^ ((3 ^ k + 1) / 2) * (g ^ (3 ^ k))⁻¹ := by
    rw [hgpow, inv_one, mul_one, ← pow_mul, hm, pow_succ, hgpow, one_mul]
  have hmem : g ∈ (StatedOmega Q).subgroupOf (isoGrp Q) := by
    rw [hgm]
    exact Subgroup.mul_mem _ (Subgroup.pow_mem _ hsq _)
      (Subgroup.inv_mem _ (by rw [hgpow]; exact Subgroup.one_mem _))
  have hΩ : (g : GL ι (ZMod 2)) ∈ StatedOmega Q := Subgroup.mem_subgroupOf.mp hmem
  have hinner : ψ ∈ CFSG.ComponentClassification.OuterAutomorphisms.inner ↥(StatedOmega Q) := by
    rw [← hg]
    exact (hQ.kappa_mem_inner_iff g).mpr hΩ
  obtain ⟨a, ha⟩ := MonoidHom.mem_range.mp hinner
  exact ⟨a, fun x => by rw [← ha, MulAut.conj_apply]⟩

theorem le_centralizer_of_goodQ (hQ : GoodQ Q) (hind : OmegaTwoAutInduced Q)
    (hev : Even (Fintype.card ι)) {G : Type} [Group G] [Finite G] {L E T : Subgroup G}
    (e : ↥L ≃* ↥(StatedOmega Q))
    (hZ : Subgroup.center ↥L = ⊥) (hEL : E ≤ L) (hE : IsElemAbelian 3 E)
    (hcard : 3 ^ (Fintype.card ι / 2) ≤ Nat.card E) (hT : IsPGroup 2 T)
    (hTN : T ≤ Subgroup.normalizer (L : Set G)) (hET : E ≤ Subgroup.normalizer (T : Set G)) :
    T ≤ Subgroup.centralizer (L : Set G) := by
  classical
  obtain ⟨q, hq, hnd⟩ := hQ.regular
  let N : Subgroup G := Subgroup.normalizer (L : Set G)
  let c : ↥N →* MulAut ↥L := Subgroup.normalizerMonoidHom (H := L)
  let Φ : ↥N →* ↥(isoGrp Q) :=
    (hQ.kappaEquiv hind).symm.toMonoidHom.comp ((MulAut.congr e).toMonoidHom.comp c)
  let E' : Subgroup ↥(isoGrp Q) := (E.subgroupOf N).map Φ
  let T' : Subgroup ↥(isoGrp Q) := (T.subgroupOf N).map Φ
  let ΦE : ↥(E.subgroupOf N) →* ↥(isoGrp Q) := Φ.comp (E.subgroupOf N).subtype
  have hEN : E ≤ N := hEL.trans Subgroup.le_normalizer
  have hΦE_inj : Function.Injective ΦE := by
    rw [injective_iff_map_eq_one]
    intro x hx
    have hx' : Φ x = 1 := by simpa [ΦE] using hx
    have hc : c x = 1 := by
      have h1 := congrArg (hQ.kappaEquiv hind) hx'
      have h2 : (MulAut.congr e) (c x) = 1 := by
        simpa [Φ, MonoidHom.comp_apply] using h1
      exact (MulEquiv.map_eq_one_iff (MulAut.congr e)).mp h2
    have hxcent : ((x : ↥N) : G) ∈ Subgroup.centralizer (L : Set G) := by
      have hker : (x : ↥N) ∈ c.ker := by
        rw [MonoidHom.mem_ker]
        exact hc
      change (x : ↥N) ∈ (Subgroup.normalizerMonoidHom (H := L)).ker at hker
      rw [Subgroup.normalizerMonoidHom_ker, Subgroup.mem_subgroupOf] at hker
      exact hker
    have hxE : ((x : ↥N) : G) ∈ E :=
      Subgroup.mem_subgroupOf.mp (show (x : ↥N) ∈ E.subgroupOf N from x.2)
    have hxL : ((x : ↥N) : G) ∈ L := hEL hxE
    have hxcenter : (⟨((x : ↥N) : G), hxL⟩ : ↥L) ∈ Subgroup.center ↥L := by
      rw [Subgroup.mem_center_iff]
      intro l
      exact Subtype.ext ((Subgroup.mem_centralizer_iff.mp hxcent) (l : G) l.2)
    have hx1 : (⟨((x : ↥N) : G), hxL⟩ : ↥L) = 1 := by
      have h := hxcenter
      rw [hZ] at h
      exact Subgroup.mem_bot.mp h
    have hxG : ((x : ↥N) : G) = 1 := congrArg (Subtype.val : ↥L → G) hx1
    exact Subtype.ext (Subtype.ext hxG)
  have hcardE : Nat.card E' = Nat.card ↥(E.subgroupOf N) := by
    refine (Nat.card_congr (Equiv.ofBijective (fun x : ↥(E.subgroupOf N) =>
      (⟨Φ x, Subgroup.mem_map.mpr ⟨(x : ↥N), x.2, rfl⟩⟩ : ↥E')) ⟨?_, ?_⟩)).symm
    · intro x y hxy
      exact hΦE_inj (Subtype.ext_iff.mp hxy)
    · rintro ⟨y, hy⟩
      obtain ⟨x0, hx0, hxy⟩ := Subgroup.mem_map.mp hy
      exact ⟨⟨x0, hx0⟩, Subtype.ext hxy⟩
  have hcardEsub : Nat.card ↥(E.subgroupOf N) = Nat.card E :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hEN).toEquiv
  have hcard' : 3 ^ (Module.finrank (ZMod 2) (ι → ZMod 2) / 2) ≤ Nat.card E' := by
    rw [Module.finrank_fintype_fun_eq_card, hcardE, hcardEsub]
    exact hcard
  have hcomm : ∀ a b : ↥E', a * b = b * a := by
    intro a b
    obtain ⟨a0, ha0, haeq⟩ := Subgroup.mem_map.mp a.2
    obtain ⟨b0, hb0, hbeq⟩ := Subgroup.mem_map.mp b.2
    apply Subtype.ext
    rw [Subgroup.coe_mul, Subgroup.coe_mul, ← haeq, ← hbeq, ← map_mul, ← map_mul]
    congr 1
    apply Subtype.ext
    change (a0 : G) * (b0 : G) = (b0 : G) * (a0 : G)
    exact congrArg Subtype.val (hE.1.is_comm.comm
      (⟨(a0 : G), Subgroup.mem_subgroupOf.mp ha0⟩ : ↥E)
      (⟨(b0 : G), Subgroup.mem_subgroupOf.mp hb0⟩ : ↥E))
  have hE3 : ∀ e ∈ E', e ^ 3 = 1 := by
    intro e he
    obtain ⟨e0, he0, heeq⟩ := Subgroup.mem_map.mp he
    have h0 : e0 ^ 3 = 1 := by
      apply Subtype.ext
      simpa using hE.2 (e0 : G) (Subgroup.mem_subgroupOf.mp he0)
    have heq : e ^ 3 = Φ (e0 ^ 3) := by
      apply Subtype.ext
      simp only [Subgroup.coe_pow, heeq.symm, map_pow]
    rw [heq, h0, map_one]
  have hET' : ∀ e ∈ E', ∀ t ∈ T', e * t * e⁻¹ ∈ T' := by
    intro e he t ht
    obtain ⟨e0, he0, heeq⟩ := Subgroup.mem_map.mp he
    obtain ⟨t0, ht0, hteq⟩ := Subgroup.mem_map.mp ht
    have hmem : e0 * t0 * e0⁻¹ ∈ T.subgroupOf N := by
      refine Subgroup.mem_subgroupOf.mpr ?_
      have h1 : (e0 : G) ∈ Subgroup.normalizer (T : Set G) :=
        hET (Subgroup.mem_subgroupOf.mp he0)
      have h2 : (t0 : G) ∈ T := Subgroup.mem_subgroupOf.mp ht0
      have h3 := (Subgroup.mem_normalizer_iff.mp h1 (t0 : G)).mp h2
      simpa using h3
    have heq : e * t * e⁻¹ = Φ (e0 * t0 * e0⁻¹) := by
      apply Subtype.ext
      simp only [Subgroup.coe_mul, Subgroup.coe_inv, heeq.symm, hteq.symm, map_mul, map_inv]
    rw [heq]
    exact Subgroup.mem_map.mpr ⟨e0 * t0 * e0⁻¹, hmem, rfl⟩
  have hTsub : IsPGroup 2 ↥(T.subgroupOf N) :=
    hT.of_equiv (Subgroup.subgroupOfEquivOfLe hTN).symm
  have hT' : IsPGroup 2 ↥T' := hTsub.map Φ
  have hB : (orthPolarBilin q).Nondegenerate := by
    constructor
    · intro v hv
      exact hnd v fun w => by
        have hw := hv w
        rw [orthPolarBilin_apply] at hw
        exact hw
    · intro v hv
      exact hnd v fun w => by
        have hw := hv w
        rw [orthPolarBilin_apply] at hw
        rw [QuadraticMap.polar_comm]
        exact hw
  have hrefl : (orthPolarBilin q).IsRefl := by
    intro x y hxy
    have h := hxy
    rw [orthPolarBilin_apply] at h
    rw [orthPolarBilin_apply, QuadraticMap.polar_comm]
    exact h
  have hρ : ∀ g : ↥(isoGrp Q), ∀ x y : ι → ZMod 2,
      orthPolarBilin q (orthLinHom Q g x) (orthLinHom Q g y) =
        orthPolarBilin q x y := by
    intro g x y
    have hg : ∀ v : ι → ZMod 2, q (orthLinHom Q g v) = q v := by
      intro v
      have h1 := g.2 v
      simp only [orthLinHom_apply, hq] at h1 ⊢
      exact h1
    simp only [orthPolarBilin_apply, QuadraticMap.polar]
    rw [← map_add, hg, hg, hg]
    rfl
  have heven : Even (Module.finrank (ZMod 2) (ι → ZMod 2)) := by
    rw [Module.finrank_fintype_fun_eq_card]
    exact hev
  have hbot : T' = ⊥ :=
    @CFSG.LocalAnalysis.GLTheoremA.CatB.Rank3.eq_bot_of_full (ι → ZMod 2)
      (inferInstance : AddCommGroup (ι → ZMod 2))
      (inferInstance : Module (ZMod 2) (ι → ZMod 2))
      (inferInstance : Module.Finite (ZMod 2) (ι → ZMod 2))
      (↥(isoGrp Q)) (inferInstance : Group ↥(isoGrp Q))
      (inferInstance : Finite ↥(isoGrp Q))
      (orthPolarBilin q) hB hrefl heven (orthLinHom Q) (orthLinHom_injective Q) hρ
      E' T' hcomm hE3 hT' hET' hcard'
  intro t ht
  have htN : t ∈ N := hTN ht
  have htmap : Φ ⟨t, htN⟩ = 1 := by
    have hmem : Φ ⟨t, htN⟩ ∈ T' :=
      Subgroup.mem_map.mpr ⟨⟨t, htN⟩, Subgroup.mem_subgroupOf.mpr ht, rfl⟩
    rw [hbot] at hmem
    exact Subgroup.mem_bot.mp hmem
  have hc : c ⟨t, htN⟩ = 1 := by
    have h1 := congrArg (hQ.kappaEquiv hind) htmap
    have h2 : (MulAut.congr e) (c ⟨t, htN⟩) = 1 := by
      simpa [Φ, MonoidHom.comp_apply] using h1
    exact (MulEquiv.map_eq_one_iff (MulAut.congr e)).mp h2
  have hker : (⟨t, htN⟩ : ↥N) ∈ c.ker := by
    rw [MonoidHom.mem_ker]
    exact hc
  change (⟨t, htN⟩ : ↥N) ∈ (Subgroup.normalizerMonoidHom (H := L)).ker at hker
  rw [Subgroup.normalizerMonoidHom_ker, Subgroup.mem_subgroupOf] at hker
  exact hker

end Orth

theorem nonempty_mulEquiv_omegaPlusSix_of_marking {X : Type} [Group X]
    (hm : LargeEvenMarking X (fun lab _ _ _ _ _ => lab.tag = .D ∧ lab.rank = 6 ∧ lab.n = 1))
    (hZ : Subgroup.center X = ⊥) :
    Nonempty (X ≃* ↥(StatedOmega (StatedQuadPlus 6 (ZMod 2)))) := by
  unfold CFSG.StandardType.LargeEvenMarking CFSG.Assembly.LargeEvenMarkingLegacy at hm
  obtain ⟨-, lab, -, hraw⟩ := hm
  have hFS : lab.tag = .D ∧ lab.rank = 6 ∧ lab.n = 1 := by
    obtain ⟨R, _hRg, _I, _F, hQ⟩ := largeEvenRawDatum_exists hraw
    obtain ⟨-, hFS⟩ := hQ.2.2
    exact hFS
  obtain ⟨t, r, n⟩ := lab
  dsimp only at hFS
  obtain ⟨ht, hr, hn⟩ := hFS
  subst ht
  subst hr
  subst hn
  dsimp only [CFSG.Assembly.LargeEvenRawDatumLegacy] at hraw
  obtain ⟨K, hK, hKfin, hcard, hQ⟩ := hraw
  obtain ⟨θ, -⟩ := hQ.2.2
  let : Field K := hK
  let : Finite K := hKfin
  have hK2 : Nat.card K = 2 := by rw [hcard]; norm_num
  let e0 : X ≃* X ⧸ Subgroup.center X :=
    ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm
  exact ⟨e0.trans (θ.trans (CFSG.HardMathSupport.Foote.E27.Q2.statedProjOmegaEquiv
    (StatedQuadPlus 6 K) hK2 (StatedQuadPlus 6 (ZMod 2))
    (fun v σ => CFSG.HardMathSupport.Foote.E27.Q2.quadPlus_comp 6 σ v)))⟩

theorem nonempty_mulEquiv_omegaMinus_of_marking {X : Type} [Group X] {r : ℕ} (hr : 4 ≤ r)
    (hm : LargeEvenMarking X (fun lab _ _ _ _ _ => lab.tag = .twD ∧ lab.rank = r ∧ lab.n = 1))
    (hZ : Subgroup.center X = ⊥) :
    Nonempty (X ≃* ↥(StatedOmega (StatedQuadMinus r (ZMod 2) 1 1))) := by
  unfold CFSG.StandardType.LargeEvenMarking CFSG.Assembly.LargeEvenMarkingLegacy at hm
  obtain ⟨-, lab, -, hraw⟩ := hm
  have hFS : lab.tag = .twD ∧ lab.rank = r ∧ lab.n = 1 := by
    obtain ⟨R, _hRg, _I, _F, hQ⟩ := largeEvenRawDatum_exists hraw
    obtain ⟨-, hFS⟩ := hQ.2.2
    exact hFS
  obtain ⟨t, l, n⟩ := lab
  dsimp only at hFS
  obtain ⟨ht, hl, hn⟩ := hFS
  subst ht
  subst hl
  subst hn
  dsimp only [CFSG.Assembly.LargeEvenRawDatumLegacy] at hraw
  rw [if_neg (by omega : ¬ l = 2), if_neg (by omega : ¬ l = 3)] at hraw
  obtain ⟨K, hK, hKfin, hcard, b, c, hirr, hQ⟩ := hraw
  obtain ⟨θ, -⟩ := hQ.2.2
  let : Field K := hK
  let : Finite K := hKfin
  have hK2 : Nat.card K = 2 := by rw [hcard]; norm_num
  let e0 : X ≃* X ⧸ Subgroup.center X :=
    ((QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot).symm
  refine ⟨e0.trans (θ.trans ((omegaMinusProjEquiv l b c).trans ?_))⟩
  exact CFSG.HardMathSupport.Foote.E27.Q2.statedProjOmegaEquiv
    (StatedQuadMinus l K b c) hK2 (StatedQuadMinus l (ZMod 2) 1 1)
    (fun v σ => CFSG.HardMathSupport.Foote.E27.Q2.quadMinus_comp l σ hirr v)

theorem nonempty_mulEquiv_omegaMinusSeven_of_marking {X : Type} [Group X]
    (hm : LargeEvenMarking X (fun lab _ _ _ _ _ => lab.tag = .twD ∧ lab.rank = 7 ∧ lab.n = 1))
    (hZ : Subgroup.center X = ⊥) :
    Nonempty (X ≃* ↥(StatedOmega (StatedQuadMinus 7 (ZMod 2) 1 1))) :=
  nonempty_mulEquiv_omegaMinus_of_marking (r := 7) (by norm_num) hm hZ

