module

public import CFSG.LocalAnalysis.StandardType.GGResE6DependentDualWord
import Mathlib.Tactic.FinCases

public section

namespace CFSG.StandardType.E6DependentDualSeven

open Module

abbrev U := Fin 6 → K

@[expose] def ucoord (v : V7) : U := fun i => v i.castSucc

@[expose] def tcoord (v : V7) : K := v 6

@[expose] def ofUT (u : U) (t : K) : V7 := Fin.snoc (α := fun _ => K) u t

lemma six_last : (6 : Fin 7) = Fin.last 6 := by decide

lemma snoc_six (u : Fin 6 → K) (t : K) :
    Fin.snoc (α := fun _ => K) u t (6 : Fin 7) = t := by
  rw [six_last, Fin.snoc_last]

@[simp] lemma ucoord_ofUT (u : U) (t : K) : ucoord (ofUT u t) = u := by
  funext i
  simp [ucoord, ofUT]

@[simp] lemma tcoord_ofUT (u : U) (t : K) : tcoord (ofUT u t) = t := by
  simp [tcoord, ofUT, snoc_six]

@[simp] lemma ofUT_ucoord_tcoord (v : V7) : ofUT (ucoord v) (tcoord v) = v := by
  ext i
  refine Fin.lastCases ?_ (fun j => ?_) i
  · simp [ofUT, tcoord, snoc_six]
  · simp [ofUT, ucoord]

@[expose] def axis : V7 := tU

@[simp] lemma axis_apply_last : axis (6 : Fin 7) = 1 := by
  simp [axis, tU]

@[simp] lemma axis_apply_castSucc (i : Fin 6) : axis i.castSucc = 0 := by
  have h : i.castSucc ≠ (6 : Fin 7) := by
    rw [six_last]
    exact Fin.castSucc_ne_last i
  simp [axis, tU, Pi.single_apply, h]

@[expose] def kvec : U := ![2, 0, 1, 0, 2, 1]

@[expose] def k0vec : U := ![1, 0, 2, 0, 1, 0]

@[expose] def e5vec : U := Pi.single (5 : Fin 6) 1

lemma s_apply_apply (i : Fin 6) (v : V7) (j : Fin 6) :
    (s i v) j.castSucc = v j.castSucc - v i.castSucc * (CartanMatrix.E 6 j i : K) := by
  simp [s, e6F, e6Col, coord, Module.reflection_apply, Fin.snoc]

lemma s_apply_last (i : Fin 6) (v : V7) : (s i v) (6 : Fin 7) = v 6 := by
  simp [s, e6F, e6Col, coord, Module.reflection_apply, snoc_six, sub_eq_add_neg]

@[simp] lemma s_fixes_axis (i : Fin 6) : s i axis = axis := by
  ext j
  refine Fin.lastCases ?_ (fun j => ?_) j
  · rw [← six_last, s_apply_last, axis_apply_last]
  · rw [s_apply_apply, axis_apply_castSucc, axis_apply_castSucc]
    simp

@[expose] def sU (i : Fin 6) (u : U) : U :=
  fun j => u j - u i * (CartanMatrix.E 6 j i : K)

lemma sU_apply (i : Fin 6) (u : U) (j : Fin 6) : sU i u j = u j - u i * (CartanMatrix.E 6 j i : K) := rfl

@[expose] def applyUWord (w : List (Fin 6)) (u : U) : U :=
  w.foldl (fun u i => sU i u) u

@[simp] lemma applyUWord_nil (u : U) : applyUWord [] u = u := rfl

@[simp] lemma applyUWord_cons (i : Fin 6) (w : List (Fin 6)) (u : U) :
    applyUWord (i :: w) u = applyUWord w (sU i u) := rfl

@[expose] def lwordProd (w : List (Fin 6)) : V7 ≃ₗ[K] V7 :=
  (w.reverse.map s).prod

@[simp] lemma lwordProd_nil : lwordProd [] = 1 := rfl

lemma lwordProd_cons (i : Fin 6) (w : List (Fin 6)) :
    lwordProd (i :: w) = lwordProd w * s i := by
  simp [lwordProd]

lemma lwordProd_apply (w : List (Fin 6)) (v : V7) :
    lwordProd w v = ofUT (applyUWord w (ucoord v)) (tcoord v) := by
  induction w generalizing v with
  | nil => simp
  | cons i w ih =>
      rw [lwordProd_cons, LinearEquiv.mul_apply, ih, applyUWord_cons]
      have hs : ucoord ((s i) v) = sU i (ucoord v) := by
        funext j
        simp [ucoord, sU, s_apply_apply]
      rw [hs]
      ext j
      refine Fin.lastCases ?_ (fun j => ?_) j
      · simp [ofUT, tcoord, s_apply_last, snoc_six]
      · simp [ofUT, ucoord, applyUWord, sU, s_apply_apply, sub_eq_add_neg, mul_comm]

lemma lwordProd_mem {H : Subgroup (V7 ≃ₗ[K] V7)}
    (hs : ∀ i : Fin 6, s i ∈ H) (w : List (Fin 6)) : lwordProd w ∈ H := by
  induction w with
  | nil => simp
  | cons i w ih =>
      rw [lwordProd_cons]
      exact H.mul_mem ih (hs i)

