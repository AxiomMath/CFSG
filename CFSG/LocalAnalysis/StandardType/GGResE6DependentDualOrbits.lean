@[expose] def rowDiff (r : CRow) : U := applyUWord r.word r.y - r.y

@[expose] def constraintOK (idx : Fin 8) (b : U) : Bool :=
  (constraintRows idx).all (fun r => dotU b (rowDiff r) == 0)

@[expose] def constraintRowsFix (idx : Fin 8) : Bool :=
  (constraintRows idx).all (fun r => decide (applyUWord r.word (reps idx) = reps idx))

theorem constraintRowsFix_true (idx : Fin 8) : constraintRowsFix idx = true := by
  fin_cases idx <;> decide +kernel

theorem word_fixes_rep {idx : Fin 8} {r : CRow}
    (hr : r ∈ constraintRows idx) : applyUWord r.word (reps idx) = reps idx := by
  have h := List.all_eq_true.mp (constraintRowsFix_true idx) r hr
  exact of_decide_eq_true h

@[expose] def allowed (idx : Fin 8) (b : U) : Prop :=
  match idx.val with
  | 0 => True
  | 4 => ∃ c d : K, b = c • k0vec + d • e5vec
  | _ => ∃ lam : K, b = lam • kvec

instance allowedDecidable (idx : Fin 8) (b : U) : Decidable (allowed idx b) := by
  unfold allowed
  split <;> infer_instance

theorem allowed_of_constraintOK (idx : Fin 8) :
    ∀ b : U, constraintOK idx b = true → allowed idx b := by
  fin_cases idx <;> decide +kernel

