variable {K V : Type} [Field K] [Finite K] [CharP K 2] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] {Q : QuadraticForm K V}

private theorem p9uOAut_le_normalizer :
    TauCeti.QuadraticMap.orthogonalGroup Q ≤
      Subgroup.normalizer (orthDerived Q : Set (V ≃ₗ[K] V)) := by
  intro g hg
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · intro hx
    exact CFSG.HardMathSupport.Timmesfeld.CrossChar.conj_mem_orthDerived hg hx
  · intro hx
    have h := CFSG.HardMathSupport.Timmesfeld.CrossChar.conj_mem_orthDerived (inv_mem hg) hx
    rwa [show g⁻¹ * (g * x * g⁻¹) * (g⁻¹)⁻¹ = x by group] at h

private noncomputable def p9uOAut_kappa :
    TauCeti.QuadraticMap.orthogonalGroup Q →* MulAut ↥(orthDerived Q) :=
  (orthDerived Q).normalizerMonoidHom.comp (Subgroup.inclusion p9uOAut_le_normalizer)

private theorem p9uOAut_kappa_apply_val (g : TauCeti.QuadraticMap.orthogonalGroup Q)
    (x : orthDerived Q) :
    ((p9uOAut_kappa (Q := Q) g x : orthDerived Q) : V ≃ₗ[K] V) =
      (g : V ≃ₗ[K] V) * (x : V ≃ₗ[K] V) * (g : V ≃ₗ[K] V)⁻¹ :=
  Subgroup.normalizerMonoidHom_apply_apply_coe (orthDerived Q)
    (Subgroup.inclusion p9uOAut_le_normalizer g) x

private theorem p9uOAut_kappa_eq_one (hK : Nat.card K = 2)
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate) (h5 : 5 ≤ Module.finrank K V)
    {g : TauCeti.QuadraticMap.orthogonalGroup Q} (hg : p9uOAut_kappa (Q := Q) g = 1) :
    (g : V ≃ₗ[K] V) = 1 := by
  apply CFSG.HardMathSupport.Timmesfeld.CrossChar.orth2_isometry_eq_one hK hQ h5 g.2
  intro y
  have hy := congrArg (fun φ : MulAut ↥(orthDerived Q) => (φ y : V ≃ₗ[K] V)) hg
  rw [p9uOAut_kappa_apply_val] at hy
  simpa using hy

private theorem p9uOAut_kappa_injective (hK : Nat.card K = 2)
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate) (h5 : 5 ≤ Module.finrank K V) :
    Function.Injective (p9uOAut_kappa (Q := Q)) := by
  intro g h hgh
  have h1 : (g * h⁻¹ : TauCeti.QuadraticMap.orthogonalGroup Q) = 1 := by
    apply Subtype.ext
    exact p9uOAut_kappa_eq_one hK hQ h5 (g := g * h⁻¹) (by
      rw [map_mul, hgh, map_inv, mul_inv_cancel])
  calc g = g * h⁻¹ * h := by group
    _ = 1 * h := by rw [h1]
    _ = h := by rw [one_mul]

theorem qtwoDL1_orthAut_of_equiv {K V : Type} [Field K] [Finite K] [CharP K 2] [AddCommGroup V]
    [Module K V] [FiniteDimensional K V] {Q : QuadraticForm K V} (hK : Nat.card K = 2)
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate) (h5 : 5 ≤ Module.finrank K V)
    {ι : Type} [Fintype ι] [DecidableEq ι] {Q₀ : (ι → ZMod 2) → ZMod 2}
    (e : ↥(orthDerived Q) ≃* ↥(StatedOmega Q₀)) (hQ₀ : GoodQ Q₀) (hind : OmegaTwoAutInduced Q₀)
    {s : V ≃ₗ[K] V} (hsO : s ∈ TauCeti.QuadraticMap.orthogonalGroup Q)
    (hsΩ : s ∉ omegaGroup Q hQ) :
    (∀ α : MulAut ↥(orthDerived Q), ∃ g ∈ TauCeti.QuadraticMap.orthogonalGroup Q,
      ∀ y : ↥(orthDerived Q),
        ((α y : ↥(orthDerived Q)) : V ≃ₗ[K] V) = g * (y : V ≃ₗ[K] V) * g⁻¹) ∧
    omegaGroup Q hQ = orthDerived Q := by
  classical
  haveI : Finite V := Module.finite_of_finite K
  haveI : Finite (V ≃ₗ[K] V) := Finite.of_injective (fun e : V ≃ₗ[K] V => (e : V → V))
    fun e₁ e₂ h => LinearEquiv.ext (congrFun h)
  haveI : Fintype ↥(orthDerived Q) := Fintype.ofFinite _
  haveI : Fintype (MulAut ↥(orthDerived Q)) :=
    Fintype.ofInjective
      (fun f : MulAut ↥(orthDerived Q) => (f : ↥(orthDerived Q) → ↥(orthDerived Q)))
      fun f g h => MulEquiv.ext (congrFun h)
  have hcard_aut₀ : Nat.card (MulAut ↥(StatedOmega Q₀)) = 2 * Nat.card ↥(StatedOmega Q₀) := by
    have hcard_iso : Nat.card (isoGrp Q₀) = 2 * Nat.card ↥(StatedOmega Q₀) := by
      have h := Subgroup.relIndex_mul_card (H := StatedOmega Q₀) (K := isoGrp Q₀)
      rw [hQ₀.relIndex_eq, inf_of_le_left (statedOmega_le_isoGrp Q₀)] at h
      exact h.symm
    exact (Nat.card_congr (GoodQ.kappaEquiv hQ₀ hind).toEquiv).symm.trans hcard_iso
  have hcard_aut : Nat.card (MulAut ↥(orthDerived Q)) = 2 * Nat.card ↥(orthDerived Q) :=
    card_mulAut_eq_two_mul_of_mulEquiv e hcard_aut₀
  have hκ_inj := p9uOAut_kappa_injective (Q := Q) hK hQ h5
  have hcard_range : Nat.card (p9uOAut_kappa (Q := Q)).range =
      Nat.card (TauCeti.QuadraticMap.orthogonalGroup Q) :=
    (Nat.card_congr (MonoidHom.ofInjective hκ_inj).toEquiv).symm
  have hDO : orthDerived Q ≤ TauCeti.QuadraticMap.orthogonalGroup Q :=
    Subgroup.commutator_le_self _
  have hDω : orthDerived Q ≤ omegaGroup Q hQ :=
    CFSG.RankThree.PartOne.FieldFix.orthDerived_le_omegaGroup hQ
  have hlower : 2 * Nat.card ↥(orthDerived Q) ≤
      Nat.card (TauCeti.QuadraticMap.orthogonalGroup Q) := by
    have h := Subgroup.relIndex_mul_card (H := orthDerived Q)
      (K := TauCeti.QuadraticMap.orthogonalGroup Q)
    rw [inf_of_le_left hDO] at h
    have hne : (orthDerived Q).subgroupOf (TauCeti.QuadraticMap.orthogonalGroup Q) ≠ ⊤ := by
      intro htop
      exact hsΩ (hDω ((Subgroup.subgroupOf_eq_top.mp htop) hsO))
    have hge : 1 < (orthDerived Q).relIndex (TauCeti.QuadraticMap.orthogonalGroup Q) :=
      Subgroup.one_lt_index_of_ne_top hne
    calc 2 * Nat.card ↥(orthDerived Q)
        ≤ (orthDerived Q).relIndex (TauCeti.QuadraticMap.orthogonalGroup Q) *
            Nat.card ↥(orthDerived Q) := Nat.mul_le_mul_right _ (by omega)
      _ = Nat.card (TauCeti.QuadraticMap.orthogonalGroup Q) := h
  have hle_aut : Nat.card (TauCeti.QuadraticMap.orthogonalGroup Q) ≤
      Nat.card (MulAut ↥(orthDerived Q)) := by
    rw [← hcard_range]
    exact Nat.card_le_card_of_injective _ Subtype.val_injective
  have hcard_O : Nat.card (TauCeti.QuadraticMap.orthogonalGroup Q) =
      2 * Nat.card ↥(orthDerived Q) :=
    le_antisymm (hle_aut.trans (le_of_eq hcard_aut)) hlower
  have hrange_top : (p9uOAut_kappa (Q := Q)).range = ⊤ := by
    apply Subgroup.eq_top_of_card_eq
    rw [hcard_range, hcard_O, hcard_aut]
  constructor
  · intro α
    have hmem : α ∈ (p9uOAut_kappa (Q := Q)).range := by
      rw [hrange_top]
      exact Subgroup.mem_top α
    obtain ⟨g, hg⟩ := MonoidHom.mem_range.mp hmem
    exact ⟨(g : V ≃ₗ[K] V), g.2, fun y => by
      rw [← hg]
      exact p9uOAut_kappa_apply_val g y⟩
  · have hωO : omegaGroup Q hQ ≤ TauCeti.QuadraticMap.orthogonalGroup Q :=
      CFSG.RankThree.OrthogonalInvolutions.omegaGroup_le Q hQ
    have hω_ne : (omegaGroup Q hQ).subgroupOf (TauCeti.QuadraticMap.orthogonalGroup Q) ≠ ⊤ := by
      intro htop
      exact hsΩ ((Subgroup.subgroupOf_eq_top.mp htop) hsO)
    have hrel := Subgroup.relIndex_mul_card (H := omegaGroup Q hQ)
      (K := TauCeti.QuadraticMap.orthogonalGroup Q)
    rw [inf_of_le_left hωO] at hrel
    have hge : 1 < (omegaGroup Q hQ).relIndex (TauCeti.QuadraticMap.orthogonalGroup Q) :=
      Subgroup.one_lt_index_of_ne_top hω_ne
    have hlowerω : 2 * Nat.card (omegaGroup Q hQ) ≤
        Nat.card (TauCeti.QuadraticMap.orthogonalGroup Q) :=
      calc 2 * Nat.card (omegaGroup Q hQ)
          ≤ (omegaGroup Q hQ).relIndex (TauCeti.QuadraticMap.orthogonalGroup Q) *
              Nat.card (omegaGroup Q hQ) := Nat.mul_le_mul_right _ (by omega)
        _ = Nat.card (TauCeti.QuadraticMap.orthogonalGroup Q) := hrel
    have hωcard : Nat.card (omegaGroup Q hQ) ≤ Nat.card ↥(orthDerived Q) := by
      have h2 : 2 * Nat.card (omegaGroup Q hQ) ≤ 2 * Nat.card ↥(orthDerived Q) := by
        rw [← hcard_O]
        exact hlowerω
      omega
    exact (Subgroup.eq_of_le_of_card_ge hDω hωcard).symm

end CFSG.StandardType.QTwo

