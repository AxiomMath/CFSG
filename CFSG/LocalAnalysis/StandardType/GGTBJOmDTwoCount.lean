private def tbjOmDTwoCountAux_eval (p r : ℕ) (i k : Fin r) :
    (Fin r → Multiplicative (ZMod p)) →*
      Multiplicative (ZMod p) × Multiplicative (ZMod p) :=
  (Pi.evalMonoidHom (fun _ => Multiplicative (ZMod p)) i).prod
    (Pi.evalMonoidHom (fun _ => Multiplicative (ZMod p)) k)

private def tbjOmDTwoCountAux_H₁ (p r : ℕ) (i k : Fin r) :
    Subgroup (Fin r → Multiplicative (ZMod p)) :=
  (tbjOmDTwoCountAux_eval p r i k).ker

private def tbjOmDTwoCountAux_iota (p r : ℕ) (i k : Fin r) :
    (Multiplicative (ZMod p) × Multiplicative (ZMod p)) →*
      (Fin r → Multiplicative (ZMod p)) :=
  (MonoidHom.mulSingle (fun _ => Multiplicative (ZMod p)) i).coprod
    (MonoidHom.mulSingle (fun _ => Multiplicative (ZMod p)) k)

private lemma tbjOmDTwoCountAux_mem_H₁ {p r : ℕ} {i k : Fin r}
    {f : Fin r → Multiplicative (ZMod p)} :
    f ∈ tbjOmDTwoCountAux_H₁ p r i k ↔ f i = 1 ∧ f k = 1 := by
  simp [tbjOmDTwoCountAux_H₁, tbjOmDTwoCountAux_eval, MonoidHom.mem_ker, Prod.ext_iff]

private lemma tbjOmDTwoCountAux_card_zero {p r : ℕ} {f₀ : Fin r → Multiplicative (ZMod p)}
    {i k : Fin r} (hik : i ≠ k) (hzero : ∀ j, toAdd (f₀ j) = 0 ↔ j = i ∨ j = k) :
    Nat.card {j : Fin r // toAdd (f₀ j) = 0} = 2 := by
  rw [Nat.card_eq_two_iff]
  refine ⟨⟨i, (hzero i).mpr (Or.inl rfl)⟩, ⟨k, (hzero k).mpr (Or.inr rfl)⟩, ?_, ?_⟩
  · intro h
    exact hik (congrArg Subtype.val h)
  · ext j
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_univ, iff_true]
    rcases (hzero j).mp j.2 with h | h
    · exact Or.inl (Subtype.ext h)
    · exact Or.inr (Subtype.ext h)

private lemma tbjOmDTwoCountAux_iota_apply_i {p r : ℕ} {i k : Fin r} (hik : i ≠ k)
    (t : Multiplicative (ZMod p) × Multiplicative (ZMod p)) :
    tbjOmDTwoCountAux_iota p r i k t i = t.1 := by
  simp [tbjOmDTwoCountAux_iota, MonoidHom.coprod_apply, Pi.mulSingle_eq_same,
    Pi.mulSingle_eq_of_ne hik]

private lemma tbjOmDTwoCountAux_iota_apply_k {p r : ℕ} {i k : Fin r} (hik : i ≠ k)
    (t : Multiplicative (ZMod p) × Multiplicative (ZMod p)) :
    tbjOmDTwoCountAux_iota p r i k t k = t.2 := by
  simp [tbjOmDTwoCountAux_iota, MonoidHom.coprod_apply, Pi.mulSingle_eq_same,
    Pi.mulSingle_eq_of_ne (Ne.symm hik)]

private lemma tbjOmDTwoCountAux_iota_off {p r : ℕ} {i k j : Fin r}
    (hji : j ≠ i) (hjk : j ≠ k)
    (t : Multiplicative (ZMod p) × Multiplicative (ZMod p)) :
    tbjOmDTwoCountAux_iota p r i k t j = 1 := by
  simp [tbjOmDTwoCountAux_iota, MonoidHom.coprod_apply,
    Pi.mulSingle_eq_of_ne hji, Pi.mulSingle_eq_of_ne hjk]

private lemma tbjOmDTwoCountAux_card_H₁ {p r : ℕ} {i k : Fin r}
    (hik : i ≠ k) :
    Nat.card (tbjOmDTwoCountAux_H₁ p r i k) * p ^ 2 = p ^ r := by
  let ev := tbjOmDTwoCountAux_eval p r i k
  let ι := tbjOmDTwoCountAux_iota p r i k
  have hsurj : Function.Surjective ev := by
    intro t
    refine ⟨ι t, ?_⟩
    ext <;> simp [ev, ι, tbjOmDTwoCountAux_eval, tbjOmDTwoCountAux_iota,
      MonoidHom.coprod_apply, Pi.mulSingle_eq_same, Pi.mulSingle_eq_of_ne hik,
      Pi.mulSingle_eq_of_ne hik.symm]
  have hker : ev.ker = tbjOmDTwoCountAux_H₁ p r i k := rfl
  have hcardMul : Nat.card (Multiplicative (ZMod p)) = p := by
    rw [Nat.card_congr (Multiplicative.toAdd), Nat.card_zmod]
  have hcardG : Nat.card (Fin r → Multiplicative (ZMod p)) = p ^ r := by
    rw [Nat.card_fun, hcardMul]
    simp
  have hcardT : Nat.card (Multiplicative (ZMod p) × Multiplicative (ZMod p)) = p ^ 2 := by
    rw [Nat.card_prod, hcardMul, pow_two]
  have h := Subgroup.card_eq_card_quotient_mul_card_subgroup ev.ker
  have hq : Nat.card ((Fin r → Multiplicative (ZMod p)) ⧸ ev.ker) = p ^ 2 := by
    have h1 : Nat.card ((Fin r → Multiplicative (ZMod p)) ⧸ ev.ker) = Nat.card ev.range :=
      Nat.card_congr (QuotientGroup.quotientKerEquivRange ev).toEquiv
    rw [h1, MonoidHom.range_eq_top.mpr hsurj, Subgroup.card_top, hcardT]
  rw [hq, hcardG] at h
  rw [← hker]
  rw [mul_comm, ← h]

private lemma tbjOmDTwoCountAux_card_H₁_eq {p r : ℕ} [Fact p.Prime] {i k : Fin r}
    (hik : i ≠ k) :
    Nat.card (tbjOmDTwoCountAux_H₁ p r i k) = p ^ (r - 2) := by
  have hr2 : 2 ≤ r := by
    have h : 1 < Fintype.card (Fin r) := Fintype.one_lt_card_iff.mpr ⟨i, k, hik⟩
    omega
  have hpow : p ^ r = p ^ (r - 2) * p ^ 2 := by
    conv_lhs => rw [show r = (r - 2) + 2 by omega]
    rw [pow_add]
  have h := tbjOmDTwoCountAux_card_H₁ (p := p) hik
  apply Nat.mul_right_cancel (pow_pos (Fact.out : p.Prime).pos 2)
  rw [h, hpow]

private lemma tbjOmDTwoCountAux_mul_iota_injective {p r : ℕ} {i k : Fin r} (hik : i ≠ k) :
    Function.Injective (fun q : tbjOmDTwoCountAux_H₁ p r i k ×
      (Multiplicative (ZMod p) × Multiplicative (ZMod p)) =>
      (q.1 : Fin r → Multiplicative (ZMod p)) * tbjOmDTwoCountAux_iota p r i k q.2) := by
  rintro ⟨h, t⟩ ⟨h', t'⟩ heq
  have hti : t.1 = t'.1 := by
    have h1 := congrFun heq i
    have hh : h.1 i = 1 := (tbjOmDTwoCountAux_mem_H₁.mp h.2).1
    have hh' : h'.1 i = 1 := (tbjOmDTwoCountAux_mem_H₁.mp h'.2).1
    simpa [hh, hh', tbjOmDTwoCountAux_iota_apply_i hik] using h1
  have htk : t.2 = t'.2 := by
    have h1 := congrFun heq k
    have hh : h.1 k = 1 := (tbjOmDTwoCountAux_mem_H₁.mp h.2).2
    have hh' : h'.1 k = 1 := (tbjOmDTwoCountAux_mem_H₁.mp h'.2).2
    simpa [hh, hh', tbjOmDTwoCountAux_iota_apply_k hik] using h1
  have ht : t = t' := Prod.ext hti htk
  subst ht
  have hh : h = h' := Subtype.ext (mul_right_cancel heq)
  subst hh
  rfl

private lemma tbjOmDTwoCountAux_card_T (p : ℕ) :
    Nat.card (Multiplicative (ZMod p) × Multiplicative (ZMod p)) = p ^ 2 := by
  have h : Nat.card (Multiplicative (ZMod p)) = p := by
    rw [Nat.card_congr (Multiplicative.toAdd), Nat.card_zmod]
  rw [Nat.card_prod, h, pow_two]

private lemma tbjOmDTwoCountAux_pow_eq_one
    (t : Multiplicative (ZMod p) × Multiplicative (ZMod p)) : t ^ p = 1 := by
  obtain ⟨a, b⟩ := t
  have hcard : Nat.card (Multiplicative (ZMod p)) = p := by
    rw [Nat.card_congr (Multiplicative.toAdd), Nat.card_zmod]
  have ha : a ^ p = 1 := orderOf_dvd_iff_pow_eq_one.mp (by
    simpa [hcard] using orderOf_dvd_natCard a)
  have hb : b ^ p = 1 := orderOf_dvd_iff_pow_eq_one.mp (by
    simpa [hcard] using orderOf_dvd_natCard b)
  ext <;> simp [ha, hb]

omit [Finite K] in
private lemma tbjOmDTwoCountAux_natCast_ne_zero [Fact p.Prime] (hp2 : p ≠ 2) :
    (p : K) ≠ 0 := by
  intro h
  rw [CharP.cast_eq_zero_iff K 2 p] at h
  exact ((Fact.out : p.Prime).odd_of_ne_two hp2).ne_two_of_dvd_nat h rfl

private def tbjOmDTwoCountAux_C (Δ : TBJOmData Q p A r) (J : Subgroup (V ≃ₗ[K] V)) :
    Subgroup (Fin r → Multiplicative (ZMod p)) where
  carrier := {f | ∀ j ∈ J, Δ.τ f * j = j * Δ.τ f}
  one_mem' := by intro j hj; simp
  mul_mem' := by
    intro a b ha hb j hj
    rw [map_mul]
    calc (Δ.τ a * Δ.τ b) * j = Δ.τ a * (Δ.τ b * j) := by group
      _ = Δ.τ a * (j * Δ.τ b) := by rw [hb j hj]
      _ = (Δ.τ a * j) * Δ.τ b := by group
      _ = (j * Δ.τ a) * Δ.τ b := by rw [ha j hj]
      _ = j * (Δ.τ a * Δ.τ b) := by group
  inv_mem' := by
    intro a ha j hj
    rw [map_inv]
    have h := ha j hj
    calc (Δ.τ a)⁻¹ * j = (Δ.τ a)⁻¹ * j * ((Δ.τ a) * (Δ.τ a)⁻¹) := by group
      _ = (Δ.τ a)⁻¹ * (j * (Δ.τ a)) * (Δ.τ a)⁻¹ := by group
      _ = (Δ.τ a)⁻¹ * ((Δ.τ a) * j) * (Δ.τ a)⁻¹ := by rw [← h]
      _ = j * (Δ.τ a)⁻¹ := by group

private noncomputable def tbjOmDTwoCountAux_phi [Fact p.Prime] (hp2 : p ≠ 2)
    (Δ : TBJOmData Q p A r) (hQ : (polarBilin Q).Nondegenerate)
    (hA : A ≤ orthDerived Q) (f₀ : Fin r → Multiplicative (ZMod p)) {i k : Fin r}
    (hik : i ≠ k) (h4 : finrank K (fixedSpace (Δ.τ f₀)) = 4)
    (hi : toAdd (f₀ i) = 0) (hk : toAdd (f₀ k) = 0) :
    (Multiplicative (ZMod p) × Multiplicative (ZMod p)) →*
      ↥(supportedFixedDerived Q (Δ.τ f₀)) :=
  (Δ.τ.comp (tbjOmDTwoCountAux_iota p r i k)).codRestrict
    (supportedFixedDerived Q (Δ.τ f₀)) (fun t =>
      TBJOmData.tau_mem_supportedFixedDerived_of_finrank_eq_four hp2 Δ hQ hA f₀ h4 hik
        hi hk (tbjOmDTwoCountAux_iota p r i k t)
        (fun _ hji hjk => tbjOmDTwoCountAux_iota_off hji hjk (t := t)))

omit [Finite K] [FiniteDimensional K V] in
private lemma tbjOmDTwoCountAux_ker_le
    (Δ : TBJOmData Q p A r) {i k : Fin r}
    {J : Subgroup (V ≃ₗ[K] V)} {N : Subgroup (V ≃ₗ[K] V)}
    (φ : (Multiplicative (ZMod p) × Multiplicative (ZMod p)) →* ↥N)
    (hφ : ∀ t, (φ t : V ≃ₗ[K] V) = Δ.τ (tbjOmDTwoCountAux_iota p r i k t))
    (Θ : ↥N ≃* Matrix.SpecialLinearGroup (Fin 2) K × Matrix.SpecialLinearGroup (Fin 2) K)
    (π : Matrix.SpecialLinearGroup (Fin 2) K × Matrix.SpecialLinearGroup (Fin 2) K →*
      Matrix.SpecialLinearGroup (Fin 2) K)
    (hπcomm : ∀ g : ↥N, π (Θ g) = 1 →
      ∀ j ∈ J, (g : V ≃ₗ[K] V) * j = j * (g : V ≃ₗ[K] V)) :
    ∀ t, t ∈ (π.comp (Θ.toMonoidHom.comp φ)).ker →
      tbjOmDTwoCountAux_iota p r i k t ∈ tbjOmDTwoCountAux_C Δ J := by
  intro t ht j hj
  have hπ : π (Θ (φ t)) = 1 := by simpa using ht
  have hcomm := hπcomm (φ t) hπ j hj
  simpa [hφ t] using hcomm

private lemma tbjOmDTwoCountAux_H₁_le_C [Fact p.Prime] (hp2 : p ≠ 2)
    (Δ : TBJOmData Q p A r) (hQ : (polarBilin Q).Nondegenerate) (hA : A ≤ orthDerived Q)
    (f₀ : Fin r → Multiplicative (ZMod p)) {i k : Fin r} (hik : i ≠ k)
    (hzero : ∀ j, toAdd (f₀ j) = 0 ↔ j = i ∨ j = k) {J : Subgroup (V ≃ₗ[K] V)}
    (hJ : CFSG.Assembly.IsComponentOf J (supportedFixedDerived Q (Δ.τ f₀))) :
    tbjOmDTwoCountAux_H₁ p r i k ≤ tbjOmDTwoCountAux_C Δ J := by
  intro f hf j hj
  have hfi : f i = 1 := (tbjOmDTwoCountAux_mem_H₁.mp hf).1
  have hfk : f k = 1 := (tbjOmDTwoCountAux_mem_H₁.mp hf).2
  have hf' : ∀ j, toAdd (f₀ j) = 0 → f j = 1 := by
    intro j hj'
    rcases (hzero j).mp hj' with rfl | rfl
    · exact hfi
    · exact hfk
  exact Δ.blockZ_comm hp2 hQ hA f₀ f hf' j (hJ.1 hj)

private lemma tbjOmDTwoCountAux_count [Fact p.Prime] (hp2 : p ≠ 2)
    (Δ : TBJOmData Q p A r) (hQ : (polarBilin Q).Nondegenerate)
    (hA : A ≤ orthDerived Q) (hnf : ∀ v : V, (∀ a ∈ A, a v = v) → v = 0)
    (f₀ : Fin r → Multiplicative (ZMod p)) {i k : Fin r} (hik : i ≠ k)
    (hzero : ∀ j, toAdd (f₀ j) = 0 ↔ j = i ∨ j = k) {J : Subgroup (V ≃ₗ[K] V)}
    (hJ : CFSG.Assembly.IsComponentOf J (supportedFixedDerived Q (Δ.τ f₀)))
    (Θ : ↥(supportedFixedDerived Q (Δ.τ f₀)) ≃*
      Matrix.SpecialLinearGroup (Fin 2) K × Matrix.SpecialLinearGroup (Fin 2) K)
    (π : Matrix.SpecialLinearGroup (Fin 2) K × Matrix.SpecialLinearGroup (Fin 2) K →*
      Matrix.SpecialLinearGroup (Fin 2) K)
    (hπcomm : ∀ g : ↥(supportedFixedDerived Q (Δ.τ f₀)), π (Θ g) = 1 →
      ∀ j ∈ J, (g : V ≃ₗ[K] V) * j = j * (g : V ≃ₗ[K] V)) :
    p ^ (r - 1) ≤ Nat.card {f : Fin r → Multiplicative (ZMod p) //
      ∀ j ∈ J, Δ.τ f * j = j * Δ.τ f} := by
  classical
  have h4 : finrank K (fixedSpace (Δ.τ f₀)) = 4 := by
    rw [TBJOmData.finrank_fixedSpace Δ hnf f₀, tbjOmDTwoCountAux_card_zero hik hzero]
  let T := Multiplicative (ZMod p) × Multiplicative (ZMod p)
  let ι : T →* (Fin r → Multiplicative (ZMod p)) := tbjOmDTwoCountAux_iota p r i k
  let φ : T →* ↥(supportedFixedDerived Q (Δ.τ f₀)) :=
    tbjOmDTwoCountAux_phi hp2 Δ hQ hA f₀ hik h4
      ((hzero i).mpr (Or.inl rfl)) ((hzero k).mpr (Or.inr rfl))
  let ψ : T →* Matrix.SpecialLinearGroup (Fin 2) K := π.comp (Θ.toMonoidHom.comp φ)
  have hkerC : ∀ t, t ∈ ψ.ker → ι t ∈ tbjOmDTwoCountAux_C Δ J :=
    tbjOmDTwoCountAux_ker_le Δ φ (fun _ => rfl) Θ π hπcomm
  have hcardT : Nat.card T = p ^ 2 := tbjOmDTwoCountAux_card_T p
  have hexp : ∀ t : T, t ^ p = 1 := fun t => tbjOmDTwoCountAux_pow_eq_one t
  have hpK : (p : K) ≠ 0 := tbjOmDTwoCountAux_natCast_ne_zero hp2
  have hH : ∀ F : Subgroup (Matrix.SpecialLinearGroup (Fin 2) K),
      CFSG.Open.IsElemAbelian p F → Nat.card F ≤ p :=
    fun F hF => CFSG.LieType.SeitzGeneration.ExcHigh.card_le_of_isElemAbelian_specialLinear_two
      hpK hF
  have hleker : p ≤ Nat.card ψ.ker :=
    le_card_ker_of_card_eq_sq hcardT hexp hH ψ
  let H₁ : Subgroup (Fin r → Multiplicative (ZMod p)) := tbjOmDTwoCountAux_H₁ p r i k
  have hH₁C : H₁ ≤ tbjOmDTwoCountAux_C Δ J :=
    tbjOmDTwoCountAux_H₁_le_C hp2 Δ hQ hA f₀ hik hzero hJ
  let F : H₁ × ψ.ker → tbjOmDTwoCountAux_C Δ J := fun q =>
    ⟨q.1.1 * ι q.2.1,
      (tbjOmDTwoCountAux_C Δ J).mul_mem (hH₁C q.1.2) (hkerC q.2.1 q.2.2)⟩
  have hF_inj : Function.Injective F := by
    intro q q' heq
    have h1 : q.1.1 * ι q.2.1 = q'.1.1 * ι q'.2.1 := congrArg Subtype.val heq
    have h2 : (⟨q.1, q.2.1⟩ : H₁ × T) = ⟨q'.1, q'.2.1⟩ :=
      tbjOmDTwoCountAux_mul_iota_injective hik h1
    have h3 : q.1 = q'.1 := congrArg (fun x : H₁ × T => x.1) h2
    have h4 : q.2.1 = q'.2.1 := congrArg (fun x : H₁ × T => x.2) h2
    exact Prod.ext h3 (Subtype.ext h4)
  have hcard : Nat.card H₁ * Nat.card ψ.ker ≤ Nat.card (tbjOmDTwoCountAux_C Δ J) := by
    rw [← Nat.card_prod]
    exact Nat.card_le_card_of_injective F hF_inj
  have hmain : p ^ (r - 1) ≤ Nat.card (tbjOmDTwoCountAux_C Δ J) := by
    calc p ^ (r - 1) = p ^ (r - 2) * p := by
          rw [show r - 1 = r - 2 + 1 by omega, pow_succ]
      _ ≤ Nat.card H₁ * Nat.card ψ.ker :=
          Nat.mul_le_mul (le_of_eq (tbjOmDTwoCountAux_card_H₁_eq (p := p) hik).symm) hleker
      _ ≤ Nat.card (tbjOmDTwoCountAux_C Δ J) := hcard
  exact hmain

private lemma tbjOmDTwoCountAux_commutator_eq_bot_of_card_le_one [Fact p.Prime] (hp2 : p ≠ 2)
    (Δ : TBJOmData Q p A r) (hQ : (polarBilin Q).Nondegenerate) (hA : A ≤ orthDerived Q)
    (hnf : ∀ v : V, (∀ a ∈ A, a v = v) → v = 0)
    (f₀ : Fin r → Multiplicative (ZMod p)) {J : Subgroup (V ≃ₗ[K] V)}
    (hJ : CFSG.Assembly.IsComponentOf J (supportedFixedDerived Q (Δ.τ f₀)))
    (h1 : Nat.card {i : Fin r // toAdd (f₀ i) = 0} ≤ 1) :
    ⁅J, J⁆ = ⊥ := by
  have hx : OddOrderIsometry Q p (Δ.τ f₀) := Δ.oddOrderIsometry hp2 hQ hA f₀
  have hWle : finrank K (fixedSpace (Δ.τ f₀)) ≤ 2 := by
    rw [TBJOmData.finrank_fixedSpace Δ hnf f₀]
    omega
  have hR : (Q.comp (fixedSpace (Δ.τ f₀)).subtype).polarBilin.Nondegenerate :=
    hx.polarBilin_fixed_nondegenerate
  have hcommN : ∀ a b : ↥(supportedFixedDerived Q (Δ.τ f₀)), a * b = b * a := by
    intro a b
    apply (supportedFixedDerivedEquiv hx).injective
    rw [map_mul, map_mul]
    exact Subtype.ext <|
      CFSG.HardMathSupport.Dickson.Sec6.I1431.t6orth_commute_orthDerived_of_finrank_le_two
        hR hWle (supportedFixedDerivedEquiv hx a).2 (supportedFixedDerivedEquiv hx b).2
  rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
  intro a ha
  rw [Subgroup.mem_centralizer_iff]
  intro b hb
  have h := hcommN ⟨b, hJ.1 hb⟩ ⟨a, hJ.1 ha⟩
  simpa using congrArg (fun x : ↥(supportedFixedDerived Q (Δ.τ f₀)) =>
    (x : V ≃ₗ[K] V)) h

theorem TBJOmData.pow_le_card_centralizer_of_two_zero [Fact p.Prime] (hp2 : p ≠ 2)
    (Δ : TBJOmData Q p A r) (hQ : (polarBilin Q).Nondegenerate)
    (hA : A ≤ orthDerived Q) (hnf : ∀ v : V, (∀ a ∈ A, a v = v) → v = 0)
    (f₀ : Fin r → Multiplicative (ZMod p)) {i k : Fin r} (hik : i ≠ k)
    (hzero : ∀ j, toAdd (f₀ j) = 0 ↔ j = i ∨ j = k) {J : Subgroup (V ≃ₗ[K] V)}
    (hJ : CFSG.Assembly.IsComponentOf J (supportedFixedDerived Q (Δ.τ f₀))) :
    p ^ (r - 1) ≤
      Nat.card {f : Fin r → Multiplicative (ZMod p) // ∀ j ∈ J, Δ.τ f * j = j * Δ.τ f} := by
  classical
  have hx : OddOrderIsometry Q p (Δ.τ f₀) := Δ.oddOrderIsometry hp2 hQ hA f₀
  have hWi : toAdd (f₀ i) = 0 := (hzero i).mpr (Or.inl rfl)
  have hWk : toAdd (f₀ k) = 0 := (hzero k).mpr (Or.inr rfl)
  have hcard2 : Nat.card {j : Fin r // toAdd (f₀ j) = 0} = 2 :=
    tbjOmDTwoCountAux_card_zero hik hzero
  let W : Submodule K V := fixedSpace (Δ.τ f₀)
  let R : QuadraticForm K W := Q.comp W.subtype
  have h4 : finrank K W = 4 := by
    change finrank K (fixedSpace (Δ.τ f₀)) = 4
    rw [TBJOmData.finrank_fixedSpace Δ hnf f₀, hcard2]
  have hR : R.polarBilin.Nondegenerate := hx.polarBilin_fixed_nondegenerate
  have hS : ∃ S : Submodule K W, finrank K S = 2 ∧ ∀ x ∈ S, R x = 0 :=
    TBJOmData.exists_totallySingular_of_two_zero Δ hQ f₀ hik hWi hWk
  rcases tbjOmDTwo_card_eq_two_or_four_le (k := K) with hK2 | hK4
  ·
    exfalso
    have hsolvO : Group.IsSolvable ↥(TauCeti.QuadraticMap.orthogonalGroup R) :=
      tbjQ2_isSolvable_orthogonalGroup_split_four hK2 R hR h4 hS
    have hsolvD : Group.IsSolvable ↥(orthDerived R) :=
      solvable_of_solvable_injective
        (Subgroup.inclusion_injective (orthDerived_le_orthogonalGroup (Q := R)))
    have hsolvN : Group.IsSolvable ↥(supportedFixedDerived Q (Δ.τ f₀)) :=
      solvable_of_solvable_injective (f := (supportedFixedDerivedEquiv hx).toMonoidHom)
        (supportedFixedDerivedEquiv hx).injective
    have hsolvJ : Group.IsSolvable ↥J :=
      solvable_of_solvable_injective (Subgroup.inclusion_injective hJ.1)
    haveI : Group.IsPerfect ↥J := Group.IsPerfect.mk hJ.2.2.1
    have hJne : J ≠ ⊥ := fun h => commutator_ne_bot_of_isQuasisimple hJ.2.2
      (by rw [h]; exact Subgroup.commutator_bot_left _)
    haveI : Nontrivial ↥J := (Subgroup.nontrivial_iff_ne_bot J).mpr hJne
    exact Group.IsPerfect.not_isSolvable ↥J hsolvJ
  obtain ⟨e₂⟩ :=
    nonempty_commutator_orthogonalGroup_mulEquiv_specialLinear_prod
      R hR h4 hS hK4
  let O : Subgroup (W ≃ₗ[K] W) := TauCeti.QuadraticMap.orthogonalGroup R
  let eMap : ↥(commutator O) ≃* ↥((commutator O).map O.subtype) :=
    Subgroup.equivMapOfInjective _ O.subtype O.subtype_injective
  let eCongr : ↥((commutator O).map O.subtype) ≃* ↥(orthDerived R) :=
    MulEquiv.subgroupCongr (Subgroup.map_subtype_commutator O)
  let Θ : ↥(supportedFixedDerived Q (Δ.τ f₀)) ≃*
      Matrix.SpecialLinearGroup (Fin 2) K × Matrix.SpecialLinearGroup (Fin 2) K :=
    (supportedFixedDerivedEquiv hx).trans ((eMap.trans eCongr).symm.trans e₂)
  haveI : Finite (V ≃ₗ[K] V) := by
    have : Finite V := Module.finite_of_finite K
    exact Finite.of_injective (fun e : V ≃ₗ[K] V => (e : V → V)) DFunLike.coe_injective
  rcases commute_of_isComponentOf_of_mulEquiv_prod Θ hJ
    with hcomm | hcomm
  · exact tbjOmDTwoCountAux_count hp2 Δ hQ hA hnf f₀ hik hzero hJ Θ
      (MonoidHom.fst _ _) (by simpa using hcomm)
  · exact tbjOmDTwoCountAux_count hp2 Δ hQ hA hnf f₀ hik hzero hJ Θ
      (MonoidHom.snd _ _) (by simpa using hcomm)

private lemma tbjOmDTwoCountAux_two_le_card_zero [Fact p.Prime] (hp2 : p ≠ 2)
    (Δ : TBJOmData Q p A r) (hQ : (polarBilin Q).Nondegenerate)
    (hA : A ≤ orthDerived Q) (hnf : ∀ v : V, (∀ a ∈ A, a v = v) → v = 0)
    (f₀ : Fin r → Multiplicative (ZMod p)) {J : Subgroup (V ≃ₗ[K] V)}
    (hJ : CFSG.Assembly.IsComponentOf J (supportedFixedDerived Q (Δ.τ f₀)))
    (hcount : p ^ 2 * Nat.card {f : Fin r → Multiplicative (ZMod p) //
      ∀ j ∈ J, Δ.τ f * j = j * Δ.τ f} ≤ p ^ r)
    (h2 : Nat.card {i : Fin r // toAdd (f₀ i) = 0} = 2) : False := by
  obtain ⟨⟨i, hi⟩, ⟨k, hk⟩, hik, huniv⟩ := Nat.card_eq_two_iff.mp h2
  have hik' : i ≠ k := fun h => hik (Subtype.ext h)
  have hzero : ∀ j, toAdd (f₀ j) = 0 ↔ j = i ∨ j = k := by
    intro j
    constructor
    · intro hj
      have hj' : (⟨j, hj⟩ : {j : Fin r // toAdd (f₀ j) = 0}) ∈
          ({⟨i, hi⟩, ⟨k, hk⟩} : Set {j : Fin r // toAdd (f₀ j) = 0}) := by
        rw [huniv]; trivial
      rcases hj' with h | h
      · exact Or.inl (congrArg Subtype.val h)
      · exact Or.inr (congrArg Subtype.val h)
    · intro h
      rcases h with rfl | rfl
      · exact hi
      · exact hk
  have hleC := TBJOmData.pow_le_card_centralizer_of_two_zero hp2 Δ hQ hA hnf f₀ hik'
    hzero hJ
  have hr2 : 2 ≤ r := by
    have h : 1 < Fintype.card (Fin r) := Fintype.one_lt_card_iff.mpr ⟨i, k, hik'⟩
    omega
  have hmain : p ^ (r + 1) ≤ p ^ r := by
    rw [show r + 1 = 2 + (r - 1) by omega, pow_add]
    calc p ^ 2 * p ^ (r - 1) ≤ p ^ 2 * Nat.card {f : Fin r → Multiplicative (ZMod p) //
          ∀ j ∈ J, Δ.τ f * j = j * Δ.τ f} := Nat.mul_le_mul_left _ hleC
      _ ≤ p ^ r := hcount
  have hlt : p ^ r < p ^ (r + 1) :=
    Nat.pow_lt_pow_right (Fact.out : p.Prime).one_lt (Nat.lt_succ_self r)
  omega

theorem TBJOmData.three_le_card_zero_of_isComponentOf [Fact p.Prime] (hp2 : p ≠ 2)
    (Δ : TBJOmData Q p A r) (hQ : (polarBilin Q).Nondegenerate)
    (hA : A ≤ orthDerived Q) (hnf : ∀ v : V, (∀ a ∈ A, a v = v) → v = 0)
    (f₀ : Fin r → Multiplicative (ZMod p)) {J : Subgroup (V ≃ₗ[K] V)}
    (hJ : CFSG.Assembly.IsComponentOf J (supportedFixedDerived Q (Δ.τ f₀)))
    (hcount : p ^ 2 * Nat.card {f : Fin r → Multiplicative (ZMod p) //
      ∀ j ∈ J, Δ.τ f * j = j * Δ.τ f} ≤ p ^ r) :
    3 ≤ Nat.card {i : Fin r // toAdd (f₀ i) = 0} := by
  classical
  by_contra hle
  have hn2 : Nat.card {i : Fin r // toAdd (f₀ i) = 0} ≤ 2 := by omega
  rcases lt_or_ge (Nat.card {i : Fin r // toAdd (f₀ i) = 0}) 2 with hlt | hge
  · exact (commutator_ne_bot_of_isQuasisimple hJ.2.2)
      (tbjOmDTwoCountAux_commutator_eq_bot_of_card_le_one hp2 Δ hQ hA hnf f₀ hJ (by omega))
  · have h2 : Nat.card {i : Fin r // toAdd (f₀ i) = 0} = 2 := by omega
    exact tbjOmDTwoCountAux_two_le_card_zero hp2 Δ hQ hA hnf f₀ hJ hcount h2

