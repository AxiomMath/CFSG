theorem primeFormUnitary_oneGram_eq {f : ℕ} {E : Type} [Field E] (hU : UnitaryFieldData 2 f E) :
    primeFormUnitary hU (oneGram E 3) = unitaryIsom3 hU := by
  ext M
  rw [mem_primeFormUnitary, mem_unitaryIsom3, oneGram, Units.val_one, Matrix.mul_one]

section Block

variable {F : Type} [Field F] {V : Type} [AddCommGroup V] [Module F V] {x : V ≃ₗ[F] V}
  {φ : F[X]} [Fact (Irreducible φ)]

noncomputable abbrev matAct
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (M : GL (Fin 3) (AdjoinRoot φ)) (w : primaryComponent x.toLinearMap φ) : V :=
  (((Matrix.GeneralLinearGroup.toLin' b M : LinearMap.GeneralLinearGroup (AdjoinRoot φ)
    (primaryComponent x.toLinearMap φ)) : primaryComponent x.toLinearMap φ →ₗ[AdjoinRoot φ]
      primaryComponent x.toLinearMap φ) w : V)

@[expose] noncomputable def phiRep
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ)) :
    ↥(Subgroup.centralizer ({x} : Set (V ≃ₗ[F] V))) →* GL (Fin 3) (AdjoinRoot φ) :=
  (Matrix.GeneralLinearGroup.toLin' b).symm.toMonoidHom.comp (centralizerGL x φ)

theorem toLin'_phiRep (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (g : ↥(Subgroup.centralizer ({x} : Set (V ≃ₗ[F] V)))) :
    Matrix.GeneralLinearGroup.toLin' b (phiRep b g) = centralizerGL x φ g :=
  MulEquiv.apply_symm_apply _ _

theorem matAct_phiRep (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (g : ↥(Subgroup.centralizer ({x} : Set (V ≃ₗ[F] V)))) (w : primaryComponent x.toLinearMap φ) :
    matAct b (phiRep b g) w = g.1 w := by
  rw [matAct, toLin'_phiRep]
  rfl

theorem eq_of_matAct (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    {M N : GL (Fin 3) (AdjoinRoot φ)} (h : ∀ w, matAct b M w = matAct b N w) : M = N := by
  apply (Matrix.GeneralLinearGroup.toLin' b).injective
  exact Units.ext (LinearMap.ext fun w => Subtype.ext (h w))

theorem matAct_one (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (w : primaryComponent x.toLinearMap φ) : matAct b 1 w = w := by
  rw [matAct, map_one]
  rfl

theorem matAct_scalar (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (c : (AdjoinRoot φ)ˣ) (w : primaryComponent x.toLinearMap φ) :
    matAct b (Matrix.GeneralLinearGroup.scalar (Fin 3) c) w = (((c : AdjoinRoot φ) • w :
      primaryComponent x.toLinearMap φ) : V) := by
  rw [matAct, CFSG.RankThree.CentralLift.toLin'_basis_apply, Matrix.GeneralLinearGroup.coe_scalar,
    Matrix.scalar_apply]
  have h : (Matrix.diagonal fun _ => (c : AdjoinRoot φ)).mulVec (b.equivFun w) =
      (c : AdjoinRoot φ) • b.equivFun w := by
    funext i
    rw [Matrix.mulVec_diagonal]
    rfl
  rw [h, map_smul, LinearEquiv.symm_apply_apply]

end Block

section Model

variable {F : Type} [Field F] [Finite F] [CharP F 2] {V : Type} [AddCommGroup V] [Module F V]
  [FiniteDimensional F V] {Q : QuadraticForm F V} {x : V ≃ₗ[F] V} {φ : F[X]} [Fact (Irreducible φ)]
  {f : ℕ}

omit [Finite F] [CharP F 2] [FiniteDimensional F V] [Fact (Irreducible φ)] in
theorem isometryCentralizer_le_centralizer :
    isometryCentralizer Q x ≤ Subgroup.centralizer ({x} : Set (V ≃ₗ[F] V)) :=
  fun _ hg => (Subgroup.mem_inf.mp hg).2

omit [Finite F] [CharP F 2] [FiniteDimensional F V] [Fact (Irreducible φ)] in
theorem omCent_le_centralizer :
    isometryCentralizer Q x ⊓ orthDerived Q ≤ Subgroup.centralizer ({x} : Set (V ≃ₗ[F] V)) :=
  inf_le_left.trans isometryCentralizer_le_centralizer

omit [Finite F] [CharP F 2] in
theorem phiRep_phiBlockEquiv (hx : OddOrderIsometry Q 3 x)
    (hmem : φ ∈ primaryFactors x.toLinearMap) (hU : UnitaryFieldData 2 f (AdjoinRoot φ))
    {H : primaryComponent x.toLinearMap φ →ₛₗ[hU.bar]
      primaryComponent x.toLinearMap φ →ₗ[AdjoinRoot φ] AdjoinRoot φ}
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (hb : ∀ i j, H (b i) (b j) = if i = j then 1 else 0)
    (hrange : (blockGL Q x φ).range = sesqUnitaryGroup H)
    (M : ↥(primeFormUnitary hU (oneGram (AdjoinRoot φ) 3))) :
    phiRep b ⟨(phiBlockEquiv hx hmem hU b hb hrange M : V ≃ₗ[F] V),
      supportedBlock_le_centralizer _ (phiBlockEquiv hx hmem hU b hb hrange M).2⟩ = M := by
  apply (Matrix.GeneralLinearGroup.toLin' b).injective
  rw [toLin'_phiRep, ← blockGL_phiBlockEquiv hx hmem hU b hb hrange M]
  rfl

omit [Finite F] [CharP F 2] in
theorem phiRep_mem_unitaryIsom3 (hx : OddOrderIsometry Q 3 x)
    (hmem : φ ∈ primaryFactors x.toLinearMap) (hU : UnitaryFieldData 2 f (AdjoinRoot φ))
    {H : primaryComponent x.toLinearMap φ →ₛₗ[hU.bar]
      primaryComponent x.toLinearMap φ →ₗ[AdjoinRoot φ] AdjoinRoot φ}
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (hb : ∀ i j, H (b i) (b j) = if i = j then 1 else 0)
    (hrange : (blockGL Q x φ).range = sesqUnitaryGroup H)
    {g : V ≃ₗ[F] V} (hg : g ∈ isometryCentralizer Q x) :
    phiRep b ⟨g, isometryCentralizer_le_centralizer hg⟩ ∈ unitaryIsom3 hU := by
  classical
  have hgc : g ∈ Subgroup.centralizer ({x} : Set (V ≃ₗ[F] V)) :=
    isometryCentralizer_le_centralizer hg
  set g' := CFSG.RankThree.PartOne.KCOrthogonal.blockComponent hx ⟨g, hgc⟩ φ with hg'def
  have hg' : g'.1 ∈ supportedBlock Q x φ := hx.blockComponent_mem hg hmem
  have hcent : centralizerGL x φ ⟨g, hgc⟩ = centralizerGL x φ g' := by
    refine Units.ext (LinearMap.ext fun v => Subtype.ext ?_)
    change g (v : V) = g'.1 (v : V)
    rw [hg'def, blockComponent_apply_of_mem hx _ _ hmem v.2, if_pos (Or.inl rfl)]
  set M := (phiBlockEquiv hx hmem hU b hb hrange).symm ⟨g'.1, hg'⟩ with hM
  have hgM : (phiBlockEquiv hx hmem hU b hb hrange M : V ≃ₗ[F] V) = g'.1 := by
    rw [hM, MulEquiv.apply_symm_apply]
  have h1 : phiRep b ⟨g, hgc⟩ = phiRep b ⟨(phiBlockEquiv hx hmem hU b hb hrange M : V ≃ₗ[F] V),
      supportedBlock_le_centralizer _ (phiBlockEquiv hx hmem hU b hb hrange M).2⟩ := by
    apply (Matrix.GeneralLinearGroup.toLin' b).injective
    rw [toLin'_phiRep, toLin'_phiRep, hcent]
    congr 1
    exact Subtype.ext hgM.symm
  rw [h1, phiRep_phiBlockEquiv hx hmem hU b hb hrange M, ← primeFormUnitary_oneGram_eq]
  exact M.2

omit [CharP F 2] in
theorem fixes_phi_of_mem_supportedBlock_fixed (hφ : φ = X ^ 2 + X + 1)
    (hx : OddOrderIsometry Q 3 x) (hpq : 3 ∣ Nat.card F + 1)
    (hmem : φ ∈ primaryFactors x.toLinearMap) {g : V ≃ₗ[F] V}
    (hg : g ∈ supportedBlock Q x (X - 1)) {v : V} (hv : v ∈ primaryComponent x.toLinearMap φ) :
    g v = v := by
  subst hφ
  refine (mem_supportedBlock.mp hg).2 v ?_
  rw [othersSpace_eq hx hpq hmem]
  exact hv

omit [CharP F 2] in
theorem eq_one_of_fixes (hφ : φ = X ^ 2 + X + 1) (hx : OddOrderIsometry Q 3 x)
    (hpq : 3 ∣ Nat.card F + 1) (hmem : φ ∈ primaryFactors x.toLinearMap) {g : V ≃ₗ[F] V}
    (hW : ∀ w ∈ fixedSpace x, g w = w) (hΦ : ∀ v ∈ primaryComponent x.toLinearMap φ, g v = v) :
    g = 1 := by
  subst hφ
  refine LinearEquiv.ext fun v => ?_
  obtain ⟨u, hu, r, hr, rfl⟩ :=
    CFSG.RankThree.PartOne.KCOrthogonal.exists_add_of_isCompl hx.fixed_others.1 v
  rw [othersSpace_eq hx hpq hmem] at hr
  rw [map_add, hW u hu, hΦ r hr]
  rfl

theorem mem_orthDerived_of_restrict_mem_rotGroup (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hT : ∃ U : Submodule F V, finrank F U = 3 ∧ ∀ u ∈ U, Q u = 0)
    (hx : OddOrderIsometry Q 3 x) {g : V ≃ₗ[F] V} (hg : g ∈ isometryCentralizer Q x)
    (hrot : isometryRestrictFixed Q x ⟨g, hg⟩ ∈
      rotGroup (Q.comp (fixedSpace x).subtype) hx.polarBilin_fixed_nondegenerate) :
    g ∈ orthDerived Q := by
  obtain ⟨Rep, hRep⟩ := hx.exists_orbitRepresentatives
  obtain ⟨hyO, hδ⟩ := mem_rotGroup.mp hrot
  have h2 := DFunLike.congr_fun (hx.dicksonCentralizer_eq_dicksonFixed (by decide) hQ hRep) ⟨g, hg⟩
  have h3 : dicksonHom Q hQ ⟨g, (Subgroup.mem_inf.mp hg).1⟩ = 1 := h2.trans hδ
  have h4 : (⟨g, (Subgroup.mem_inf.mp hg).1⟩ : TauCeti.QuadraticMap.orthogonalGroup Q) ∈
      (dicksonHom Q hQ).ker := h3
  rw [dicksonHom_ker, Subgroup.mem_subgroupOf] at h4
  exact CFSG.RankThree.PartOne.FieldFix.omegaGroup_le_orthDerived hQ hT h4

@[expose] noncomputable def blockHom (Q : QuadraticForm F V)
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ)) :
    ↥(isometryCentralizer Q x ⊓ orthDerived Q) →*
      (↥(fixedSpace x) ≃ₗ[F] ↥(fixedSpace x)) × GL (Fin 3) (AdjoinRoot φ) :=
  ((isometryRestrictFixed Q x).comp (Subgroup.inclusion inf_le_left)).prod
    ((phiRep b).comp (Subgroup.inclusion omCent_le_centralizer))

omit [Finite F] [CharP F 2] [FiniteDimensional F V] in
theorem blockHom_fst (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (g : ↥(isometryCentralizer Q x ⊓ orthDerived Q)) :
    (blockHom Q b g).1 = isometryRestrictFixed Q x ⟨g.1, (Subgroup.mem_inf.mp g.2).1⟩ := rfl

omit [Finite F] [CharP F 2] [FiniteDimensional F V] in
theorem blockHom_snd (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (g : ↥(isometryCentralizer Q x ⊓ orthDerived Q)) :
    (blockHom Q b g).2 = phiRep b ⟨g.1, omCent_le_centralizer g.2⟩ := rfl

omit [CharP F 2] in
theorem blockHom_fst_mem (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hx : OddOrderIsometry Q 3 x)
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (g : ↥(isometryCentralizer Q x ⊓ orthDerived Q)) :
    (blockHom Q b g).1 ∈
      rotGroup (Q.comp (fixedSpace x).subtype) hx.polarBilin_fixed_nondegenerate := by
  obtain ⟨Rep, hRep⟩ := hx.exists_orbitRepresentatives
  exact mem_rotGroup.mpr ⟨isometryRestrictFixed_mem_orthogonalGroup _,
    hx.dickson_restrict_eq_one (by decide) hQ hRep (Subgroup.mem_inf.mp g.2).1
      (Subgroup.mem_inf.mp g.2).2⟩

omit [Finite F] [CharP F 2] in
theorem blockHom_snd_mem (hx : OddOrderIsometry Q 3 x)
    (hmem : φ ∈ primaryFactors x.toLinearMap) (hU : UnitaryFieldData 2 f (AdjoinRoot φ))
    {H : primaryComponent x.toLinearMap φ →ₛₗ[hU.bar]
      primaryComponent x.toLinearMap φ →ₗ[AdjoinRoot φ] AdjoinRoot φ}
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (hb : ∀ i j, H (b i) (b j) = if i = j then 1 else 0)
    (hrange : (blockGL Q x φ).range = sesqUnitaryGroup H)
    (g : ↥(isometryCentralizer Q x ⊓ orthDerived Q)) :
    (blockHom Q b g).2 ∈ unitaryIsom3 hU :=
  phiRep_mem_unitaryIsom3 hx hmem hU b hb hrange (Subgroup.mem_inf.mp g.2).1

omit [CharP F 2] in
theorem blockHom_injective (hφ : φ = X ^ 2 + X + 1) (hx : OddOrderIsometry Q 3 x)
    (hpq : 3 ∣ Nat.card F + 1) (hmem : φ ∈ primaryFactors x.toLinearMap)
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ)) :
    Function.Injective (blockHom Q b) := by
  refine (injective_iff_map_eq_one _).mpr fun g hg => ?_
  have h1 : (blockHom Q b g).1 = 1 := by rw [hg]; rfl
  have h2 : (blockHom Q b g).2 = 1 := by rw [hg]; rfl
  refine Subtype.ext (eq_one_of_fixes hφ hx hpq hmem (fun w hw => ?_) (fun v hv => ?_))
  · have := congrArg (fun e : ↥(fixedSpace x) ≃ₗ[F] ↥(fixedSpace x) =>
      ((e ⟨w, hw⟩ : fixedSpace x) : V)) h1
    rw [blockHom_fst, coe_isometryRestrictFixed] at this
    exact this
  · have := matAct_phiRep b ⟨g.1, omCent_le_centralizer g.2⟩ ⟨v, hv⟩
    rw [← blockHom_snd, h2, matAct_one] at this
    exact this.symm

theorem exists_blockHom_eq (hφ : φ = X ^ 2 + X + 1) (hx : OddOrderIsometry Q 3 x)
    (hpq : 3 ∣ Nat.card F + 1) (hmem : φ ∈ primaryFactors x.toLinearMap)
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hT : ∃ U : Submodule F V, finrank F U = 3 ∧ ∀ u ∈ U, Q u = 0)
    (hU : UnitaryFieldData 2 f (AdjoinRoot φ))
    {H : primaryComponent x.toLinearMap φ →ₛₗ[hU.bar]
      primaryComponent x.toLinearMap φ →ₗ[AdjoinRoot φ] AdjoinRoot φ}
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (hb : ∀ i j, H (b i) (b j) = if i = j then 1 else 0)
    (hrange : (blockGL Q x φ).range = sesqUnitaryGroup H)
    (hspec : specialBlock Q x φ ≤ orthDerived Q) {α : ↥(fixedSpace x) ≃ₗ[F] ↥(fixedSpace x)}
    (hα : α ∈ rotGroup (Q.comp (fixedSpace x).subtype) hx.polarBilin_fixed_nondegenerate)
    {M : GL (Fin 3) (AdjoinRoot φ)} (hM : M ∈ unitaryIsom3 hU) :
    ∃ g, blockHom Q b g = (α, M) := by
  obtain ⟨gW, hgW⟩ := restrictFixed_surjective hx α (rotGroup_le_orthogonalGroup _ hα)
  have hgWc : gW.1 ∈ isometryCentralizer Q x := supportedBlock_le_isometryCentralizer _ gW.2
  have hgWΩ : gW.1 ∈ orthDerived Q := mem_orthDerived_of_restrict_mem_rotGroup hQ hT hx hgWc (by
    rw [isometryRestrictFixed_restrictFixed, hgW]
    exact hα)
  set M' : ↥(primeFormUnitary hU (oneGram (AdjoinRoot φ) 3)) :=
    ⟨M, by rw [primeFormUnitary_oneGram_eq]; exact hM⟩ with hM'
  set gΦ := phiBlockEquiv hx hmem hU b hb hrange M' with hgΦ
  have hgΦc : (gΦ : V ≃ₗ[F] V) ∈ isometryCentralizer Q x :=
    supportedBlock_le_isometryCentralizer _ gΦ.2
  have hgΦΩ : (gΦ : V ≃ₗ[F] V) ∈ orthDerived Q :=
    supportedBlock_le_orthDerived hQ hT hU b hb hrange hspec gΦ.2
  refine ⟨⟨gW.1 * gΦ.1, mul_mem (Subgroup.mem_inf.mpr ⟨hgWc, hgWΩ⟩)
    (Subgroup.mem_inf.mpr ⟨hgΦc, hgΦΩ⟩)⟩, Prod.ext ?_ ?_⟩
  · refine LinearEquiv.ext fun w => Subtype.ext ?_
    rw [blockHom_fst, coe_isometryRestrictFixed]
    change gW.1 (gΦ.1 w) = (α w : V)
    rw [apply_fixed_of_mem_supportedBlock hφ gΦ.2 w.2, ← hgW, coe_restrictFixed]
  · rw [blockHom_snd]
    refine eq_of_matAct b fun v => ?_
    rw [matAct_phiRep]
    change gW.1 (gΦ.1 v) = matAct b M v
    rw [hgΦ, phiBlockEquiv_apply,
      fixes_phi_of_mem_supportedBlock_fixed hφ hx hpq hmem gW.2 (Subtype.prop _)]

@[expose] noncomputable def blockEquiv (hφ : φ = X ^ 2 + X + 1) (hx : OddOrderIsometry Q 3 x)
    (hpq : 3 ∣ Nat.card F + 1) (hmem : φ ∈ primaryFactors x.toLinearMap)
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hT : ∃ U : Submodule F V, finrank F U = 3 ∧ ∀ u ∈ U, Q u = 0)
    (hU : UnitaryFieldData 2 f (AdjoinRoot φ))
    {H : primaryComponent x.toLinearMap φ →ₛₗ[hU.bar]
      primaryComponent x.toLinearMap φ →ₗ[AdjoinRoot φ] AdjoinRoot φ}
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (hb : ∀ i j, H (b i) (b j) = if i = j then 1 else 0)
    (hrange : (blockGL Q x φ).range = sesqUnitaryGroup H)
    (hspec : specialBlock Q x φ ≤ orthDerived Q) :
    ↥(isometryCentralizer Q x ⊓ orthDerived Q) ≃*
      ↥(rotGroup (Q.comp (fixedSpace x).subtype) hx.polarBilin_fixed_nondegenerate) ×
        ↥(unitaryIsom3 hU) :=
  MulEquiv.ofBijective
    ((((MonoidHom.fst _ _).comp (blockHom Q b)).codRestrict _ (blockHom_fst_mem hQ hx b)).prod
      (((MonoidHom.snd _ _).comp (blockHom Q b)).codRestrict _
        (blockHom_snd_mem hx hmem hU b hb hrange)))
    ⟨fun g g' h => blockHom_injective hφ hx hpq hmem b (Prod.ext
        (congrArg (fun p => ((p.1 : ↥(rotGroup (Q.comp (fixedSpace x).subtype)
          hx.polarBilin_fixed_nondegenerate)) : ↥(fixedSpace x) ≃ₗ[F] ↥(fixedSpace x))) h)
        (congrArg (fun p => ((p.2 : ↥(unitaryIsom3 hU)) : GL (Fin 3) (AdjoinRoot φ))) h)),
      fun p => by
        obtain ⟨g, hg⟩ := exists_blockHom_eq hφ hx hpq hmem hQ hT hU b hb hrange hspec p.1.2 p.2.2
        exact ⟨g, Prod.ext (Subtype.ext (congrArg Prod.fst hg))
          (Subtype.ext (congrArg Prod.snd hg))⟩⟩

theorem coe_blockEquiv_fst (hφ : φ = X ^ 2 + X + 1) (hx : OddOrderIsometry Q 3 x)
    (hpq : 3 ∣ Nat.card F + 1) (hmem : φ ∈ primaryFactors x.toLinearMap)
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hT : ∃ U : Submodule F V, finrank F U = 3 ∧ ∀ u ∈ U, Q u = 0)
    (hU : UnitaryFieldData 2 f (AdjoinRoot φ))
    {H : primaryComponent x.toLinearMap φ →ₛₗ[hU.bar]
      primaryComponent x.toLinearMap φ →ₗ[AdjoinRoot φ] AdjoinRoot φ}
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (hb : ∀ i j, H (b i) (b j) = if i = j then 1 else 0)
    (hrange : (blockGL Q x φ).range = sesqUnitaryGroup H)
    (hspec : specialBlock Q x φ ≤ orthDerived Q) (g : ↥(isometryCentralizer Q x ⊓ orthDerived Q)) :
    ((blockEquiv hφ hx hpq hmem hQ hT hU b hb hrange hspec g).1 :
      ↥(fixedSpace x) ≃ₗ[F] ↥(fixedSpace x)) =
      isometryRestrictFixed Q x ⟨g.1, (Subgroup.mem_inf.mp g.2).1⟩ := rfl

theorem coe_blockEquiv_snd (hφ : φ = X ^ 2 + X + 1) (hx : OddOrderIsometry Q 3 x)
    (hpq : 3 ∣ Nat.card F + 1) (hmem : φ ∈ primaryFactors x.toLinearMap)
    (hQ : (QuadraticMap.polarBilin Q).Nondegenerate)
    (hT : ∃ U : Submodule F V, finrank F U = 3 ∧ ∀ u ∈ U, Q u = 0)
    (hU : UnitaryFieldData 2 f (AdjoinRoot φ))
    {H : primaryComponent x.toLinearMap φ →ₛₗ[hU.bar]
      primaryComponent x.toLinearMap φ →ₗ[AdjoinRoot φ] AdjoinRoot φ}
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    (hb : ∀ i j, H (b i) (b j) = if i = j then 1 else 0)
    (hrange : (blockGL Q x φ).range = sesqUnitaryGroup H)
    (hspec : specialBlock Q x φ ≤ orthDerived Q) (g : ↥(isometryCentralizer Q x ⊓ orthDerived Q)) :
    ((blockEquiv hφ hx hpq hmem hQ hT hU b hb hrange hspec g).2 : GL (Fin 3) (AdjoinRoot φ)) =
      phiRep b ⟨g.1, omCent_le_centralizer g.2⟩ := rfl

theorem mem_specialBlock_iff_phiRep (hφ : φ = X ^ 2 + X + 1) (hx : OddOrderIsometry Q 3 x)
    (hpq : 3 ∣ Nat.card F + 1)
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ))
    {g : V ≃ₗ[F] V} (hg : g ∈ isometryCentralizer Q x) :
    g ∈ specialBlock Q x φ ↔ isometryRestrictFixed Q x ⟨g, hg⟩ = 1 ∧
      ((phiRep b ⟨g, isometryCentralizer_le_centralizer hg⟩ : GL (Fin 3) (AdjoinRoot φ)) :
        Matrix (Fin 3) (Fin 3) (AdjoinRoot φ)).det = 1 := by
  have hdet : ∀ hgB : g ∈ supportedBlock Q x φ, blockDet Q x φ ⟨g, hgB⟩ =
      ((phiRep b ⟨g, isometryCentralizer_le_centralizer hg⟩ : GL (Fin 3) (AdjoinRoot φ)) :
        Matrix (Fin 3) (Fin 3) (AdjoinRoot φ)).det := fun hgB => by
    rw [blockDet_apply, ← CFSG.RankThree.CentralLift.det_toLin'_basis b, toLin'_phiRep]
    rfl
  constructor
  · intro h
    obtain ⟨hgB, hd⟩ := mem_specialBlock.mp h
    refine ⟨LinearEquiv.ext fun w => Subtype.ext ?_, (hdet hgB).symm.trans hd⟩
    rw [coe_isometryRestrictFixed]
    exact apply_fixed_of_mem_supportedBlock hφ hgB w.2
  · rintro ⟨h1, h2⟩
    have hW : ∀ w ∈ fixedSpace x, g w = w := fun w hw => by
      have := congrArg (fun e : ↥(fixedSpace x) ≃ₗ[F] ↥(fixedSpace x) =>
        ((e ⟨w, hw⟩ : fixedSpace x) : V)) h1
      rw [coe_isometryRestrictFixed] at this
      exact this
    have hgB : g ∈ supportedBlock Q x φ := by
      refine mem_supportedBlock.mpr ⟨hg, fixes_othersSpace_iff.mpr fun k hk hkφ _ v hv => ?_⟩
      have hk1 : k = X - 1 := by
        by_contra hne
        exact hkφ (hφ ▸ eq_phi hx hpq hk hne)
      subst hk1
      exact hW v (by rw [fixedSpace_eq_primaryComponent]; exact hv)
    exact mem_specialBlock.mpr ⟨hgB, (hdet hgB).trans h2⟩

@[expose] noncomputable def phiRoot (hx : OddOrderIsometry Q 3 x)
    (hmem : φ ∈ primaryFactors x.toLinearMap) :
    (AdjoinRoot φ)ˣ :=
  Units.ofPowEqOne (AdjoinRoot.root φ) 3 (root_pow_eq_one (hx.dvd_X_pow_sub_one hmem)) (by norm_num)

omit [Finite F] [CharP F 2] in
theorem coe_phiRoot (hx : OddOrderIsometry Q 3 x) (hmem : φ ∈ primaryFactors x.toLinearMap) :
    (phiRoot hx hmem : AdjoinRoot φ) = AdjoinRoot.root φ := rfl

omit [Finite F] [CharP F 2] in
theorem phiRep_self (hx : OddOrderIsometry Q 3 x) (hmem : φ ∈ primaryFactors x.toLinearMap)
    (b : Module.Basis (Fin 3) (AdjoinRoot φ) (primaryComponent x.toLinearMap φ)) :
    phiRep b ⟨x, Subgroup.mem_centralizer_singleton_iff.mpr rfl⟩ =
      Matrix.GeneralLinearGroup.scalar (Fin 3) (phiRoot hx hmem) := by
  refine eq_of_matAct b fun w => ?_
  rw [matAct_phiRep, matAct_scalar, coe_phiRoot, coe_root_smul_primaryComponent]
  rfl

